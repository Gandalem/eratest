@DISH_FRESHNESS
#DIM FRESH_MESSAGE
SIF DISH_LIMIT >= DISH_MAXLIMIT
	FRESH_MESSAGE = 0
DISH_LIMIT -= LS_SPOILAGE(TIME_PROGRESS(TIME:1)) ;Custom code, alter the rate at which dishes spoil during Lunatic Survival.
SIF DISH_LIMIT <= DISH_MAXLIMIT * 4 / 5
	DISH_TASTE '= REPLACE(DISH_TASTE, "できたて\/", "")
IF DISH_LIMIT <= DISH_MAXLIMIT * -1
	CALL COLORMESSAGE(DISHNAME_TR(DISH_NAME) + " simply cannot be eaten!", C_RED, 2)
	PRINTL
	CALL COLORMESSAGE("You discard " + DISHNAME_TR(DISH_NAME) + ".", C_RED, 2)
	CALL RESET_DISH
	FRESH_MESSAGE = 0
ELSEIF DISH_LIMIT <= 0 && FRESH_MESSAGE < 2
	CALL COLORMESSAGE(DISHNAME_TR(DISH_NAME) + " started to smell bad...", C_ORANGE, 2)
	DISH_TASTE '= REPLACE(DISH_TASTE, "冷たい\/", "")
	DISH_TASTE '= REPLACE(DISH_TASTE, "温かい\/", "")
	DISH_TASTE += "劣化/" * 2
	FRESH_MESSAGE = 2
ELSEIF DISH_LIMIT <= DISH_MAXLIMIT * 1 / 2 && FRESH_MESSAGE < 1
	IF STRCOUNT(DISH_TASTE, "アイス/")
		PRINTFORMW %DISHNAME_TR(DISH_NAME)% started melting...
		DISH_TASTE '= REPLACE(DISH_TASTE, "冷たい\/", "")
	ELSEIF STRCOUNT(DISH_TASTE, "冷たい/")
		PRINTFORMW %DISHNAME_TR(DISH_NAME)% has cooled down...
		DISH_TASTE '= REPLACE(DISH_TASTE, "冷たい\/", "")
	ELSE
		PRINTFORMW %DISHNAME_TR(DISH_NAME)% became cold...
		DISH_TASTE '= REPLACE(DISH_TASTE, "温かい\/", "")
	ENDIF
	DISH_TASTE += "劣化/"
	FRESH_MESSAGE = 1
ENDIF

;addition custom code
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && STRCOUNT(DISH_TASTE, "劣化")
	PRINTFORML
	PRINTFORMW You dispose of the rotten food.
	CALL RESET_DISH
ENDIF
