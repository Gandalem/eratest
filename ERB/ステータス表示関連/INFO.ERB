	CALL COLORMESSAGE("It's about time to go home...", C_ORANGE, 2)
	TIMEUP_MESSAGE:1 = 1
ELSEIF NEMUKE() < 660
	TIMEUP_MESSAGE:1 = 0
ENDIF
IF DATE ;bugfix, account for sleep res and resend message if drugged
	IF CFLAG:DATE:神社在住
		IF INRANGE(TIME, CFLAG:DATE:就寝時間 + CFLAG:DATE:眠気覚まし - 60, CFLAG:DATE:就寝時間 + CFLAG:DATE:眠気覚まし)
			SIF !TIMEUP_MESSAGE:2
				CALL COLORMESSAGE(@"%CALLNAME:DATE% looks sleepy%COND_STR(@" as well", TIMEUP_MESSAGE:1)%.", C_ORANGE, 2)
			TIMEUP_MESSAGE:2 = 1
		ELSE
			TIMEUP_MESSAGE:2 = 0
		ENDIF
	ELSE
		IF INRANGE(TIME, CFLAG:DATE:帰宅時間 - 60, CFLAG:DATE:帰宅時間) && !TIMEUP_MESSAGE:2
			;custom code, don't show "It's about time for XXX to go home" when you're visiting their home.
