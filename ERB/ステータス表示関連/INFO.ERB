				CALL COLORMESSAGE("It's getting pretty late for a date, but it seems like you can still stay for a little while.", C_ORANGE, 2)
			ELSE
				CALL COLORMESSAGE(@"It's about time for %CALLNAME:DATE% to go home%COND_STR(@" as well", TIMEUP_MESSAGE:1)%.", C_ORANGE, 2)
			ENDIF
			TIMEUP_MESSAGE:2 = 1
		ENDIF
	ENDIF
ELSEIF !DATE
	TIMEUP_MESSAGE:2 = 0
ENDIF
IF NEMUKE() > 960 && !TIMEUP_MESSAGE:3 && !CFLAG:MASTER:うふふ
	CALL COLORMESSAGE("It's getting pretty late...", C_RED, 2)
	TIMEUP_MESSAGE:3 = 1
