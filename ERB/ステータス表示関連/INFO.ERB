@INFO_CHARA_STAIN(C_ID)
#DIM        C_ID
#DIM        BODY_PARTS
;custom code
#DIMS CONST PARTS_NAME = "Mouth", "Hands", "Ｐ", "Ｖ", "Ａ", "Ｂ", "Vaginal", "Intestinal", "Armpit", "", "", "", "Ｕ"
#DIM        TYPE_STAIN
#DIMS CONST STAIN_NAME = "Love Juice", "Penis", "Semen", "Anus", "Milk", "Mucus", "Blood", "Chocolate", "Urine", "Scat"
PRINTFORML 【%CALLNAME:C_ID%'s Dirtiness】
FOR BODY_PARTS, 0, VARSIZE("PARTS_NAME")
	;Vaginal and Intestinal stains take up stain location slots 6 and 7 so we skip them
	;Pretty sure they're just duplicates of Ｖ and Ａ respectively
	SIF GROUPMATCH(BODY_PARTS, 6, 7)
		CONTINUE
	SIF !STRLENS(PARTS_NAME:BODY_PARTS)
		CONTINUE
	SIF PARTS_NAME:BODY_PARTS == "Ｐ" && !(HAS_PENIS(C_ID))
		CONTINUE
	SIF GROUPMATCH(PARTS_NAME:BODY_PARTS, "Ｖ") && !(HAS_VAGINA(C_ID))
		CONTINUE
	SIF GROUPMATCH(PARTS_NAME:BODY_PARTS, "Ｂ") && !(IS_FEMALE(C_ID))
		CONTINUE
	PRINTFORM 　%PARTS_NAME:BODY_PARTS%：
	FOR TYPE_STAIN, 0, VARSIZE("STAIN_NAME")
		SIF GETBIT(STAIN:C_ID:BODY_PARTS, TYPE_STAIN)
			PRINTFORM <%STAIN_NAME:TYPE_STAIN%>
	NEXT
	IF GETBIT(STAIN:C_ID:BODY_PARTS, FINDELEMENT(STAIN_NAME, "Chocolate"))
		IF GETBIT(STAIN:C_ID:BODY_PARTS, FINDELEMENT(STAIN_NAME, "Milk"))
			PRINT <Chocolate milk>
		ELSE
			PRINT <Chocolate>
		ENDIF
	ENDIF
	PRINTL 
NEXT
PRINTL 



