@INFO_TIME_PASSING
#DIM MOODBREAKER
IF TFLAG:遠距離移動
	;TFLAGを戻す（遠距離移動フラグ）
	TFLAG:遠距離移動 = 0
ELSEIF TIME_PROGRESS(TIME:1)
	;キャラ移動
	CALL CHARA_MOVEMENT
	CALL ADD_BANQUET_PROGRESS() ;addition custom code
	IF TCVAR:MASTER:馴れ合い >= 1
		MOODBREAKER = IN_ROOM_MEMBER("MIN", CFLAG:MASTER:現在位置, "CFLAG", 6)
		LOCAL:2 = CFLAG:MOODBREAKER:態度
		;馴れ合い強度０以下だと空気が変わる
		IF LOCAL:2 <= 0 && MOODBREAKER > 0 && CFLAG:MOODBREAKER:現在位置 != CFLAG:MOODBREAKER:前ターン位置 && !CFLAG:MOODBREAKER:睡眠
			SIF PREVCOM != 400
				PRINTFORMW As %CALLNAME:MOODBREAKER% arrives, the atmosphere suddenly shifts...
			FOR LOCAL, 0, CHARANUM
				;同室判定前なので同室フラグは使えない
				SIF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:LOCAL:態度 >= 1 && !CFLAG:LOCAL:睡眠 && PREVCOM != 400
					CALL KOJO_MESSAGE_SEND("EVENT",5,LOCAL,MOODBREAKER)
				;イタズラOFF
				CALL SET_PRANK(0,LOCAL,2)
				;隠密中OFF
				CALL SET_SNEAK(0,LOCAL,2)
			NEXT
		ENDIF
	ENDIF
ENDIF
TIME:1 = TIME + 1440 * DAY
CALL SET_SLEEP(0,MASTER,0)



;-------------------------------------------------
;TARGET関連のキャラ変数の更新
;-------------------------------------------------
@INFO_RENEW_TARGET
CALL TARGETSET_CHACK("「同室更新無し」")
;MASTERと同室フラグ
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	;口上の基本フラグ設定
	CALL KOJO_MESSAGE_SEND("FLAGSETTING", 0, LOCAL)

	;bugfix custom code
	SIF CFLAG:LOCAL:うふふ
		GOTO SKIPGREET

	;現在位置がMASTERと同じなら同室
	;bugfix custom code, always call AFFAIR_DISCLOSURE if no greeting has occured in the current room using GREETED_NOW
	IF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
		;まだ同室フラグが立っていない(現ターンで同室化）かつ眠っていない
		SIF !TCVAR:LOCAL:GREETED_NOW && !CFLAG:LOCAL:睡眠 && !TALENT:LOCAL:NonSentient ;vehicles
			CALL AFFAIR_DISCLOSURE(LOCAL, 0)
		;情事の発覚 AFFAIR_DISCLOSURE で立ち去った場合は同室が立たない
		IF !RESULT
			CFLAG:LOCAL:同室 = 1
			IF !FLAG:70 && !CFLAG:LOCAL:睡眠
				TCVAR:LOCAL:GREETED_NOW = 1
			ENDIF
		ENDIF
	ELSE
		;相手からこちらが見えていて、相手かこちらかが移動したかこちらが押し倒した
		IF CAN_MOVE(CFLAG:LOCAL:現在位置, CFLAG:MASTER:現在位置) & 2 && !CFLAG:LOCAL:睡眠 && PREVCOM >= 0 && FLAG:70 != 1 && !TALENT:LOCAL:NonSentient ;nas customs, vehicles
			IF (CFLAG:MASTER:前ターン位置 != CFLAG:MASTER:現在位置 || CFLAG:LOCAL:前ターン位置 != CFLAG:LOCAL:現在位置 || TRAINNAME:PREVCOM == "押し倒す") && !TCVAR:LOCAL:SEEN_NOW ;qol custom code
				CALL AFFAIR_DISCLOSURE(LOCAL, 1)
				TCVAR:LOCAL:SEEN_NOW = 1 ;qol custom code
			ENDIF
		ENDIF
		;SIF !nRapeAnywhere ; thought this would do something but no
		CFLAG:LOCAL:同室 = 0
		SIF !FLAG:70 && !CFLAG:LOCAL:睡眠 ;qol custom code
			TCVAR:LOCAL:GREETED_NOW = 0
	ENDIF

	;bugfix custom code
	$SKIPGREET
	;qol custom code, ensure sex ends if player is not around
	IF CFLAG:LOCAL:うふふ && CFLAG:LOCAL:現在位置 != CFLAG:MASTER:現在位置
		DEBUGPRINTFORML Cleaning up sex state for %CALLNAME:LOCAL%.
		CALL ENDUFUFU(LOCAL)
	ENDIF

	;bugfix, failsafe to update day last met if TCVAR:今日会ったか is set outside of @FirstMeetToday
	SIF TCVAR:LOCAL:今日会ったか && CFLAG:LOCAL:最後に会った日 < TFLAG:あなた起床 % 1440
		CFLAG:LOCAL:最後に会った日 = DAY

NEXT
CFLAG:MASTER:あなた前ターン位置 = CFLAG:MASTER:現在位置

;馴れ合い強度決定
;TARGET側
FOR LOCAL, 1, GET_TARGETNUM() + 1
	;合意か弱味がないと3にならない
	IF GETBIT(CFLAG:(TARGET:LOCAL):既成事実, 0) || CFLAG:(TARGET:LOCAL):弱み握られ
		LOCAL:1 = CFLAG:(TARGET:LOCAL):態度
	ELSE
		LOCAL:1 = MIN(CFLAG:(TARGET:LOCAL):態度, 2)
	ENDIF
	TCVAR:(TARGET:LOCAL):馴れ合い = LOCAL:1
	;TARGET:2以降は、MIN(直前のTARGETのTCVAR:130,自身のCFLAG:6)
	SIF LOCAL >= 2
		TCVAR:(TARGET:LOCAL):馴れ合い = MIN(TCVAR:(TARGET:(LOCAL - 1)):馴れ合い, TCVAR:(TARGET:LOCAL):馴れ合い)
NEXT

;MASTERはTARGET:1～のCFLAG:6の最低値
TCVAR:MASTER:馴れ合い = TCVAR:(IN_ROOM_MEMBER("MIN", CFLAG:MASTER:現在位置, "TCVAR", 130)):馴れ合い

;bugfix custom code, if a character leaves in their greeting dialogue (such as Kagerou), make sure they're not set as TARGET
IF CFLAG:TARGET:現在位置 != CFLAG:MASTER:現在位置
