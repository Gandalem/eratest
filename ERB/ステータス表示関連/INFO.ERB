		CALL CHANGE_CLOTHES(LOCAL, "衣装リセット")
	ENDIF

	CALL CLOTHES_SETTING_TRAIN(LOCAL)
	
	;相合い傘フラグ（同行依存）
	;相合い傘できるのはターゲットだけ
	SIF LOCAL != 0 && !CHK_DATENOW(CFLAG:LOCAL:デート中) && (!CFLAG:LOCAL:同行 || LOCAL != TARGET)
