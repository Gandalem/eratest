		TCVAR:LOCAL:IsInBath = 1
	;addition custom code, swimming
	ELSEIF TEQUIP:LOCAL:SWIMMING && !ADD_SWIMMING_AREA(CFLAG:LOCAL:現在位置)
		CALL ADD_END_SWIMMING(LOCAL)
	;うふふ/イタズラ中は衣装リセットを抑制
