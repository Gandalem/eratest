PRINTFORM 　　　　　　　　　　　
SIF CHARA_CNT > 0 && NOW_GROUP > 1
	PRINTBUTTON "[888] - 이전 캐릭터　", "888"
PRINTFORML 
IF STRCOUNT(OP, "「情報固定」")
	PRINTFORM 　　　　　　　　　　　
ELSE
	PRINTBUTTON @"[444] - 　　%DISP_NAME:((DISP_PAGE - 1 + 5) % 5), 8%　", "444"
ENDIF
IF STRCOUNT(OP, "「条件変更」")
	PRINTBUTTON "[555] - 조건 변경　", "555"
ELSE
	PRINTFORM 　　　　　　　　　　　
ENDIF
IF STRCOUNT(OP, "「情報固定」")
	PRINTFORM 　　　　　　　　　　　
ELSE
	PRINTBUTTON @"[666] - 　　%DISP_NAME:((DISP_PAGE + 1 + 5) % 5), 8%　", "666"
ENDIF
PRINTFORML 
PRINTFORM 　　　　　　　　　　　
SIF CHARA_CNT > 0 && NOW_GROUP < LAST_GROUP
	PRINTBUTTON "[222] 다음 캐릭터　", "222"
PRINTFORML 
PRINTFORML 
PRINTBUTTON "[999] - 돌아간다　", "999"
PRINTFORML 
VARSET INPUT_STR
VARSET INPUT_INT
DO
INPUTS
INPUT_STR '= RESULTS
SIF !STRLENS(INPUT_STR)
	GOTO RETRY
IF ISNUMERIC(INPUT_STR)
	INPUT_INT = TOINT(INPUT_STR)
	SELECTCASE INPUT_INT
		;先にシステム系を処理、222なら余裕あるっしょ（Kでは使えんわな）
		CASE 888
			SIF !(CHARA_CNT > 0 && NOW_GROUP > 1)
				GOTO RETRY
			NOW_GROUP --
			RESTART
		CASE 222
			SIF !(CHARA_CNT > 0 && NOW_GROUP < LAST_GROUP)
				GOTO RETRY
			NOW_GROUP ++
			RESTART
		CASE 444
			SIF STRCOUNT(OP, "「情報固定」")
				GOTO RETRY
			DISP_TYPE '= DISP_NAME:((DISP_PAGE - 1 + 5) % 5)
			RESTART
		CASE 555
			SIF !STRCOUNT(OP, "「条件変更」")
				GOTO RETRY
			CALL CHANGE_LIST(LIST_TYPE, OP)
			GET_LIST = 1
			NOW_GROUP = 1
			RESTART
		CASE 666
			SIF STRCOUNT(OP, "「情報固定」")
				GOTO RETRY
			DISP_TYPE '= DISP_NAME:((DISP_PAGE + 1 + 5) % 5)
			RESTART
		CASE 999
			;REFで配列作れば多キャラ選択も行けそう
			;受け渡しはともかくとして表示まわりがめんどいか
			GET_LIST = 1
			NOW_GROUP = 1
			RETURN 999
		CASEELSE
			;キャラが選択された時
			IF !INRANGE(INPUT_INT, MAX(0, (NOW_GROUP - 1) * 20), MIN(CHARA_CNT - 1, NOW_GROUP * 20))
				PRINTFORMW {INPUT_INT} 범위 외
				GOTO RETRY
			ELSEIF L_CLASS_ID == -1 && !CHECK_CHARA(CHARA_LIST:INPUT_INT, LIST_TYPE)
				PRINTFORMW {INPUT_INT} 목록이 아니야
				GOTO RETRY
			ELSEIF L_CLASS_ID > 0 && !GET_INT(CHARA_LIST:INPUT_INT, "キャラリスト", L_CLASS_ID, "判定")
				PRINTFORMW {INPUT_INT} 목록에서 제외된다
				GOTO RETRY
			ENDIF
			;ここだけDO-LOOPぬけます
			BREAK
			$RETRY
			REUSELASTLINE 無効な入力です
			CONTINUE
	ENDSELECT
ELSE
	;STRで受け取った時、SORT処理なので処理が可能な場合は全てRESTART
	;妙な文字列を受け取った場合にはCONTINUE
	;DO-LOOPを脱出できるのはINTかつ、リスト上のキャラを選択した場合のみ
	SELECTCASE DISP_TYPE
		CASE "体力気力"
			FOR LOCAL:0, 0, 2
			IF INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%昇順" || INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%降順"
				SORT_TYPE '= INPUT_STR
				CALL SORT_LIST(INPUT_STR, CHARA_LIST, CHARA_CNT)
				RESTART
			ENDIF
			NEXT
			GOTO RETRY
		CASE "感度など"
			FOR LOCAL:0, 2, 11
			IF INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%昇順" || INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%降順"
				SORT_TYPE '= INPUT_STR
				CALL SORT_LIST(INPUT_STR, CHARA_LIST, CHARA_CNT)
				RESTART
			ENDIF
			NEXT
			GOTO RETRY
		CASE "性技"
			FOR LOCAL:0, 11, 17
			IF INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%昇順" || INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%降順"
				SORT_TYPE '= INPUT_STR
				CALL SORT_LIST(INPUT_STR, CHARA_LIST, CHARA_CNT)
				RESTART
			ENDIF
			NEXT
			GOTO RETRY
		CASE "刻印"
			FOR LOCAL:0, 17, 22
			IF INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%昇順" || INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%降順"
				SORT_TYPE '= INPUT_STR
				CALL SORT_LIST(INPUT_STR, CHARA_LIST, CHARA_CNT)
				RESTART
			ENDIF
			NEXT
			GOTO RETRY
		CASE "好感度"
			FOR LOCAL:0, 22, 25
			IF INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%昇順" || INPUT_STR == @"%DISP_MEMO:(LOCAL:0)%降順"
				SORT_TYPE '= INPUT_STR
				CALL SORT_LIST(INPUT_STR, CHARA_LIST, CHARA_CNT)
				RESTART
			ENDIF
			NEXT
			GOTO RETRY
		CASEELSE
			THROW 異常なDISP_TYPE　%DISP_TYPE%
	ENDSELECT
ENDIF
