@PRINT_ABILITY(C_ID, DISP_NAME, VIEW)
#DIM  C_ID
#DIMS DISP_NAME
#DIM  VIEW
#DIM CONST DISP_ID , 42 = 0,  9, 43, 0, 50, 15, 30, 1, 10, 41, 1, 54, 16, 31, 2, 11, 42, 2, 55, 17, 32, 3, 12, 40, 3, 52, 18, 33, 4, 13, 44, 4, 51,  0, 34, 5, 14, 45, 0, 53,  0, 35,
