@充填率(キャラ登録番号, 身体部位, nShooter = -1, getMax = 0)
#FUNCTION
#DIM キャラ登録番号
#DIM 身体部位
#DIM 精液量
#DIM 身体容量
#DIM nShooter
#DIM getMax
SIF nShooter == -1
	nShooter = MASTER
VARSET 精液量
;該当部位の精液量の取得
SELECTCASE 身体部位
	CASE 1
		精液量 = EX:キャラ登録番号:膣内精液
	CASE 2
		精液量 = EX:キャラ登録番号:アナル内精液
	CASE 3
		精液量 = EX:キャラ登録番号:膣内精液 + EX:キャラ登録番号:アナル内精液
	CASE 4
		精液量 = nInsemination:キャラ登録番号:nShooter
ENDSELECT
