; Modular ERB: Look.ERB

@LOOK_AT
#DIM 装備部位
#DIM 着衣状況
#DIMS 挿入状況
#DIMS 挿入状況2
#DIMS 表示内容
#DIMS HTML ;NAS HTML stuffs
VARSET HTML
;============================
CALL PRINTBUTTON_EX(TFLAG:LOOK非表示 ? "▽[＋][Look  ]" # "▼[－][Look  ]", 3003, TFLAG:LOOK非表示)
;NAS NEW LINES
SETCOLOR C_GRAY
PRINTFORM %"━"*4%
RESETCOLOR
PRINTBUTTON "[이미지 표시]", 816
SIF FLAG:画像表示設定
	SETCOLOR C_ORANGE
PRINTBUTTON "[표시 설정]", 3100
RESETCOLOR
IF CFLAG:うふふ
	IF FLAG:挿絵表示 ;bug fix - correct button code
		PRINTBUTTON "[애니메이션 ON-]", 819
	ELSE
		SETCOLOR C_L_GRAY
		PRINTBUTTON "[애니메이션-OFF-]", 819
		RESETCOLOR
	ENDIF
ENDIF
;custom code, automatically scale line for resolution
HTML_POPPRINTINGSTR
HTML_PRINT RESULTS + @"<font color='#%TO_HEX(C_GRAY)%'>%"━" * MAX((MAXWIDTH() - HTML_STRINGLEN(RESULTS))/2, 0)%</font>"
;PRINTL
IF !TFLAG:LOOK非表示
	;TARGETが大勢居るときはヒマを持て余す
	CALL ANOTHERTARGET_TALK
	CALL 情景描写
ENDIF
IF TARGET != MASTER
	IF !TFLAG:LOOK非表示
		PRINT 【상체】
		IF TEQUIP:1 == 0
			PRINT 벌거벗은
			SIF PALAM:欲情 >= PALAMLV:3
				PRINTFORM ・%HIS_HER(TARGET,1)% %NIPPLE_DESCRIPTION(TARGET)%는 발기해 있다
		ELSE
			;外側の服から表示
			FOR 装備部位, 19, 6, -1
			SIF GROUPMATCH(装備部位, 15, 12, 11)
				CONTINUE
			表示内容 '= LOOK_AT_CLOTHNAME(TARGET, 装備部位)
			SIF !STRLENS(表示内容)
				CONTINUE
			PRINTFORM %CAPITALIZE(CLOTHES_TR(表示内容))%
			BREAK
			NEXT
			VARSET LOCALS
			IF SaveIsEZB
				LOCAL = LoG_RivalTeamFromChara(TARGET)
				SIF LOCAL
					LOCALS += @"%EZB_TEAM(LOCAL)%、"
			ELSEIF nFactions
				FOR LOCAL,0,MAXFACTIONS
				SIF FactionRank:TARGET:LOCAL
					LOCALS += @"%FactionAbriv(LOCAL)%、"
				NEXT
			ENDIF
			SIF FINDELEMENT(LOCALS,"、") > -1
				PRINTFORM ・A %LIST_IN_STRING(LOCALS)% 패치가 보일 수 있다.
			IF SaveISEZB
				IF LoG_RivalWins(LoG_RivalID(TARGET)) || LoG_RivalLosses(LoG_RivalID(TARGET))
					IF LoG_RivalWins(LoG_RivalID(TARGET))
						SETCOLOR C_L_GREEN
					ELSEIF LoG_RivalLosses(LoG_RivalID(TARGET))
						SETCOLOR C_PURPLE
					ENDIF
					PRINTFORM 기록: {LoG_RivalWins(LoG_RivalID(TARGET))}-{LoG_RivalLosses(LoG_RivalID(TARGET))} (승-패)
					RESETCOLOR
				ENDIF
			ENDIF
			IF TEQUIP:上半身はだけ状態 > 0
				IF TALENT:バストサイズ == 2
					PRINTFORM ・%HIS_HER(TARGET,1)%의 %OPPAI_DESCRIPTION_TR(TARGET)%가 흘러넘치고 있다
					;PRINTFORM はち切れんばかりの胸がこぼれ出ている
				ELSEIF TALENT:バストサイズ == 1
					PRINTFORM ・%HIS_HER(TARGET,1)% %OPPAI_DESCRIPTION_TR(TARGET)%은(는) 늘어져 있었다
					;PRINTFORM 豊満な胸がこぼれ出ている
				ELSEIF TALENT:バストサイズ == 0
					PRINTFORM ・%HIS_HER(TARGET,1)%의 %OPPAI_DESCRIPTION_TR(TARGET)%가 노출되어 있다
					;PRINTFORM 形のいい胸が露わになっている
				ELSEIF TALENT:バストサイズ == -1
					PRINTFORM ・%HIS_HER(TARGET,1)%의 %OPPAI_DESCRIPTION_TR(TARGET)%가 노출되어 있다.
					;PRINTFORM 小振りな胸が露わになっている
				ELSEIF TALENT:バストサイズ == -2
					PRINTFORM ・%HIS_HER(TARGET,1)%의 %OPPAI_DESCRIPTION_TR(TARGET)%가 노출되어 있다.
					;PRINTFORM 可愛らしい乳首が露わになっている
				ENDIF
				SIF EQUIP:TARGET:ボディースーツ == 0 && PALAM:欲情 >= PALAMLV:5
					PRINTFORM ・%HIS_HER(TARGET,1)%의 %NIPPLE_DESCRIPTION(TARGET)%가 단단해졌다
			ELSE
				SIF EQUIP:TARGET:ボディースーツ == 0 && PALAM:欲情 >= PALAMLV:(4 + 2 * (GET_INT(TARGET, "上半身下着_はだけ不可", EQUIP:TARGET:上半身下着１, "生地厚さ")))
					PRINTFORM ・%HIS_HER(TARGET,1)%이(가) %HIS_HER(TARGET)%의 옷에 거칠게 %NIPPLE_DESCRIPTION(TARGET)% 문지른다
			ENDIF
		ENDIF
		IF TEQUIP:ニプルキャップ && TEQUIP:胸揉み
			PRINTFORM 유두 캡이 %HIS_HER(TARGET)%에게 달라붙어 있다 %NIPPLE_DESCRIPTION(TARGET)% 당신이 %HIS_HER(TARGET)%를 쓰다듬을 때 %OPPAI_DESCRIPTION_TR(TARGET)%.
		ELSEIF TEQUIP:乳首吸い && TEQUIP:胸揉み
			PRINTFORM ・%HIS_HER(TARGET)%을 만지면서 %HIS_HER(TARGET)%의 %OPPAI_DESCRIPTION_TR(TARGET)%을 핥는다 %NIPPLE_DESCRIPTION(TARGET)%%COND_STR(@" expertly", ABL:MASTER:舌 > UniversalRank("C"))%
		ELSEIF TEQUIP:ニプルキャップ
			PRINTFORM 유두캡이 %HIS_HER(TARGET)%의 %NIPPLE_DESCRIPTION(TARGET)%에 붙어있다.
		ELSEIF TEQUIP:搾乳機
			PRINT 우유 짜는 기계가 모유를 빨아들이고 있다.
		ELSEIF TEQUIP:乳首吸い
			PRINTFORM 당신은 %HIS_HER(TARGET)%을 핥고 있다 %NIPPLE_DESCRIPTION(TARGET)%%COND_STR(@" expertly", ABL:MASTER:舌 > UniversalRank("C"))%
		ELSEIF TEQUIP:胸揉み
			PRINTFORM 당신은 %HIS_HER(TARGET)%의 %OPPAI_DESCRIPTION_TR(TARGET)%를 만지고 있었다.
		ENDIF
		SIF CFLAG:口に精液 == 1
			PRINTFORM 정액이 %HIS_HER(TARGET)%의 입에서 똑똑 떨어졌다.
		SIF CFLAG:顔に精液 == 1
			PRINTFORM %HIS_HER(TARGET)%의 얼굴에서 정액이 흘러내린다.
		SIF CFLAG:手に精液 == 1
			PRINTFORM ・%HIS_HER(TARGET,1)%의 손이 정액으로 덮여있다.
		;custom code
		SIF CFLAG:脇に精液 == 1
			PRINTFORM 정액이 %HIS_HER(TARGET)%의 겨드랑이에서 흘러내린다.
		PRINTL
		CALL LOWER_BODY_INSPECT_NAS(TARGET)
		GOTO LOWER_BODY_REPLACE_END
		PRINT 【하체】
		;TEQUIP:下半身着衣状況 下半身着衣状況(ビット0=スカート 1=ずらし可 2=ずらし不可 3=ずらせない下半身上着)
		;	(ビットを使いたくない人用 0=なし 1=ノーパンスカート 2=パンティのみ 3=スカート+パンティ
		;	4=スパッツ(下着)もしくはノーパンズボン 5=スカート+スパッツ 6=ズボン+パンティ 7=フル装備(このバリアントでは無理)）
		;CFLAG:パンツ パンツフラグ
		;0 パンツはいている
		;1 パンツはいてない
		;下半身着衣なし、もしくはパンツはいていない
		IF TEQUIP:下半身着衣状況 == 0 || CFLAG:ノーパン > 0
			;	下半身着衣があるがノーパンである
			IF CFLAG:ノーパン && TEQUIP:下半身着衣状況 != 0
				着衣状況 = 0
				FOR 装備部位, 15, 4, -1
				SIF GROUPMATCH(装備部位, 8, 7)
					CONTINUE
				表示内容 '= LOOK_AT_CLOTHNAME(TARGET, 装備部位)
				SIF !STRLENS(表示内容)
					CONTINUE
				PRINTFORM %CAPITALIZE(表示内容)%
				BREAK
				NEXT
				;パンツははいていないが見えないので表示しない
				;PRINT （パンツはいてない）
				IF PREVCOM == 330
					IF HAS_VAGINA(TARGET) ;custom code
						IF PALAM:潤滑 >= PALAMLV:5
							PRINTFORM ・%HIS_HER(TARGET,1)%의 허벅지가 젖어있다.
						ELSEIF PALAM:潤滑 >= PALAMLV:3
							PRINTFORM 액체가 %HIS_HER(TARGET)%의 허벅지를 타고 흘러내린다.
						ENDIF
					ENDIF
					IF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
						PRINTFORM 정액이 넘치면서 시끄럽게 떨어졌다 %HIM_HER(TARGET)%
					ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
						PRINTFORM 넘치는 정액이 %HIS_HER(TARGET)%의 허벅지를 타고 흘러내린다.
					ENDIF
				ELSEIF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
					PRINTFORM ・\@ TALENT:MASTER:濃厚精液 ? 작은 산의 풀 같은 정액이 %HIS_HER(TARGET)% 발 주위에 형성되었다 # %HIS_HER(TARGET,1)% 발은 정액으로 된 작은 웅덩이에서 헤엄치고 있다 \@
				ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
					PRINTFORM ・\@ TALENT:MASTER:濃厚精液 ? 끈적한 정액이 %HIS_HER(TARGET)%의 허벅지에 달라붙는다 # 정액이 %HIS_HER(TARGET)%의 허벅지를 타고 흘러내린다 \@
				ENDIF
			ELSEIF EQUIP:下半身下着１ || EQUIP:下半身下着２
				IF EQUIP:下半身下着２
					表示内容 '= PANTSNAME(EQUIP:TARGET:下半身下着２, TARGET)
					PRINTFORM %CAPITALIZE(CLOTHES_TR(表示内容))%
					IF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
						PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%은(는) 정액으로 완전히 젖어 있었다.
					ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
						PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)%로 정액을 전부 흡수할 수 없다.
					ELSEIF CFLAG:TARGET:膣内射精 == 1 || CFLAG:TARGET:アナル射精 == 1 || (PALAM:潤滑 >= PALAMLV:3 && HAS_VAGINA(TARGET)) ;custom code
						PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%이(가) 얼룩져 있었다 
					ELSEIF PALAM:潤滑 >= PALAMLV:2 && HAS_VAGINA(TARGET) ;custom code
						PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))% 이 젖어 있다
					ENDIF
				ELSE
					表示内容 '= GET_STR(TARGET, "下半身下着_ずらし不可", EQUIP:TARGET:下半身下着１, "名前")
					PRINTFORM %CAPITALIZE(CLOTHES_TR(表示内容))%
					SELECTCASE 表示内容
						CASE "褌", "スパッツ"
							IF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%가 정액으로 완전히 젖어있다.
							ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)%로 정액을 전부 흡수할 수 없다.
							ELSEIF CFLAG:TARGET:膣内射精 == 1 || CFLAG:TARGET:アナル射精 == 1 || (PALAM:潤滑 >= PALAMLV:3 && HAS_VAGINA(TARGET)) ;custom code
								PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%이(가) 얼룩져 있었다 
							ELSEIF PALAM:潤滑 >= PALAMLV:2 && HAS_VAGINA(TARGET) ;custom code
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)% 옷(%IS_ARE_PANTIES(CLOTHES_TR(表示内容))%)이 축축하다.
							ENDIF
						CASE "前張り", "絆創膏"
							IF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%가 벗겨졌다가 다시 붙었다
							ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
								PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))% 간신히 걸쳐 있다. 
							ELSEIF CFLAG:TARGET:膣内射精 == 1 || CFLAG:TARGET:アナル射精 == 1 || (PALAM:潤滑 >= PALAMLV:5 && HAS_VAGINA(TARGET)) ;custom code
								PRINTFORM ·%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%가 벗겨지고 있다. 
							ELSEIF CFLAG:TARGET:膣内射精 == 1 || CFLAG:TARGET:アナル射精 == 1 || (PALAM:潤滑 >= PALAMLV:3 && HAS_VAGINA(TARGET)) ;custom code
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%가 더러워졌다
							ELSEIF PALAM:潤滑 >= PALAMLV:2 && HAS_VAGINA(TARGET) ;custom code
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)% 옷(%IS_ARE_PANTIES(CLOTHES_TR(表示内容))%)이 축축하다.
							ENDIF
						CASE "貞操帯", "ラビアピアス", "クリピアス"
							IF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
								IF 表示内容 == "貞操帯"
									PRINTFORM ・%HIS_HER(TARGET,1)%의 %CLOTHES_TR(表示内容)%는 정액으로 완전히 가득 차 있다.
								ELSE
									PRINTFORM  ・%HIS_HER(TARGET,1)%의 %CLOTHES_TR(表示内容)%가 정액으로 넘쳐흐르고 있다.
								ENDIF
							ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
								PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%에서 정액이 흘러내린다.
							ELSEIF CFLAG:TARGET:膣内射精 == 1 || CFLAG:TARGET:アナル射精 == 1 || (PALAM:潤滑 >= PALAMLV:3 && HAS_VAGINA(TARGET)) ;custom code
								PRINTFORM ・%HIS_HER(TARGET,1)% %CLOTHES_TR(表示内容)% %IS_ARE_PANTIES(CLOTHES_TR(表示内容))%가 흘러내린다
							ELSEIF PALAM:潤滑 >= PALAMLV:2 && HAS_VAGINA(TARGET) ;custom code
								PRINTFORM ・%HIS_HER(TARGET,1)%은(는) %CLOTHES_TR(表示内容)% 옷(%IS_ARE_PANTIES(CLOTHES_TR(表示内容))%)이 축축하다.
							ENDIF
					ENDSELECT
				ENDIF
				;下半身着衣がない
			ELSE
				PRINT 벌거벗은
				SIF TEQUIP:クリキャップ
					PRINT  음핵에 클리토리스 캡이 붙어있다.
				SIF TEQUIP:オナホール
					PRINTFORM  %HIS_HER(TARGET)%의 성기가 오나홀에 박혀있다.
				IF !CFLAG:うふふ
					IF CFLAG:TARGET:膣内射精
						IF CFLAG:TARGET:アナル射精 == 1
							IF 充填率(TARGET,1) >= 1000 || 充填率(TARGET,2) >= 1000
								PRINTFORM 정액이 %HIS_HER(TARGET)%의 양쪽 구멍에서 터져 나온다.
							ELSEIF 充填率(TARGET,1) >= 100 || 充填率(TARGET,2) >= 100
								PRINTFORM 둘 다 %HIS_HER(TARGET)%은 마치 두 폭포수처럼 정액으로 넘쳐흐른다.
							ELSEIF 充填率(TARGET,1) >= 30 || 充填率(TARGET,2) >= 30
								PRINTFORM %HIS_HER(TARGET,1)%의 질과 항문은 정액으로 넘치고 있다.
							ELSE
								PRINTFORM %HIS_HER(TARGET)%의 질과 항문에서 정액이 흘러내린다.
							ENDIF
						ELSEIF EX:処女喪失チェック
							PRINTFORM 넘쳐흐르는 정액이 %HIS_HER(TARGET)%의 처녀 피와 섞인다.
						ELSEIF PALAM:潤滑 >= PALAMLV:2 && HAS_VAGINA(TARGET) ;custom code
							PRINTFORM 정액과 그들의 체액으로 넘쳐흐른다.
						ELSE
							PRINTFORM %HIS_HER(TARGET)%의 질에서 정액이 새어 나온다.
						ENDIF
					ELSEIF CFLAG:TARGET:アナル射精 == 1
						PRINTFORM %HIS_HER(TARGET)%의 항문에서 정액이 새어 나온다
					ELSEIF PALAM:潤滑 >= PALAMLV:2 && HAS_VAGINA(TARGET) ;custom code
						IF PALAM:潤滑 >= PALAMLV:6
							PRINTFORM 성적인 체액이 %COND_STR(@" mixed with virginal blood", EX:処女喪失チェック)%로 %HIS_HER(TARGET)%의 질에서 흘러나왔다.
						ELSEIF EX:処女喪失チェック
							PRINT 질에서 처녀의 피가 흘러나온다.
						ELSEIF PALAM:潤滑 >= PALAMLV:4
							PRINTFORM 연모의 액이 %HIS_HER(TARGET)%의 허벅지를 타고 흐른다.
						ELSEIF PALAM:潤滑 >= PALAMLV:2
							PRINTFORM %HIS_HER(TARGET,1)%의 질은 연모즙으로 축축하다.
						ENDIF
					ENDIF
				ELSEIF PALAM:潤滑 >= PALAMLV:2 && !(CFLAG:TARGET:膣内射精 == 1 || TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ) && HAS_VAGINA(TARGET) ;custom code
					IF PALAM:潤滑 >= PALAMLV:4
						PRINTFORM 성적인 체액이 %COND_STR(@" mixed with virginal blood", EX:処女喪失チェック)%로 %HIS_HER(TARGET)%의 질에서 흘러나왔다.
					ELSEIF EX:処女喪失チェック
						PRINT 질에서 처녀의 피가 흐른다.
					ELSEIF PALAM:潤滑 >= PALAMLV:3
						PRINTFORM 연모의 액이 %HIS_HER(TARGET)%의 허벅지를 타고 흘러내린다.
					ELSEIF PALAM:潤滑 >= PALAMLV:2
						PRINTFORM %HIS_HER(TARGET,1)%의 질이 연모즙으로 축축하다.
					ELSEIF TALENT:処女 == 1
						PRINTFORM %HIS_HER(TARGET,1)%의 완전히 사용되지 않은 개방부가 노출되어 있다.
					ENDIF
				ENDIF
			ENDIF
			CALL LOOK_BELLY(TARGET)
			;下半身着を穿いている、かつ下着も付けている
		ELSE
			着衣状況 = 0
			;	上着が上下つなぎになっている服を着ている場合、それを表示する
			;	なければ、スカートやズボンを表示する
			;	特に凝った順番にもなってなかったのでループを統合
			FOR 装備部位, 15, 4, -1
			SIF GROUPMATCH(装備部位, 8, 7)
				CONTINUE
			表示内容 '= LOOK_AT_CLOTHNAME(TARGET, 装備部位)
			SIF !STRLENS(表示内容)
				CONTINUE
			PRINTFORM %CAPITALIZE(表示内容)%
			BREAK
			NEXT
			IF !CFLAG:うふふ
				;なんか分岐入ってたけどTEQUIP:下半身着衣状況 == 0は↑で処理されるので死に分岐
				;IF TEQUIP:下半身着衣状況 != 0
				;ENDIF
				IF HAS_VAGINA(TARGET) ;custom code
					IF PALAM:潤滑 >= PALAMLV:5
