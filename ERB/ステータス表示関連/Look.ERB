; 	CASE -4 TO -2
; 		身体容量 = 600
; 	CASE -1
; 		身体容量 = 1000
; 	CASE 0
; 		身体容量 = 1200
; 	CASE IS > 0
; 		身体容量 = 1500
; ENDSELECT
;new player guide custom code, replaced
身体容量 = CHARA_MAX_CUM(キャラ登録番号)
;子宮ならば容量半減
IF 身体部位 == 4
	身体容量 /= 2
ENDIF
;filling ratesbuff
SIF GETBIT(NASFeature,7)
	身体容量 /= 50
SIF getMax
	RETURNF 身体容量
LOCAL = 100 * 精液量 / 身体容量
IF TALENT:nShooter:AbnormalCumProduction
	RETURNF LOCAL
ELSE
	RETURNF MIN(LOCAL,3000)
ENDIF
