			CALL COLORMESSAGE(@"아무도 %HIS_HER(選択中キャラID)%의 입술을 만지지 못하게 했다.",C_YELLOW,1)
			PRINTFORML 하지만 그건 단지 %HE_SHE(選択中キャラID)%가 생각하는 바일 뿐이다.
			VARSET LOCALS
			LOCAL = STRCOUNT(CSTR:選択中キャラID:ファーストキス喪失履歴, "￥ＢＲ")
