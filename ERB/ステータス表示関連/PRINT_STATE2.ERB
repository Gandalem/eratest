			CALL COLORMESSAGE(@"누구도 %HIS_HER(選択中キャラID)%의 입술에 손을 대지 못하게 했다.",C_YELLOW,1)
		CASE 1
			CALL COLORMESSAGE(LOCALS,C_PINK,1)
