; Modular ERB: TINKO_TYPE.ERB
;-------------------------------------------------
;関数名:TINKO
;概　要:二番煎じ上等
;引　数:ARG…キャラ登録番号
;戻り値:
;備　考:文中関数
;使用例:%TINKO(PLAYER)%
;-------------------------------------------------

@TINKO(ARG)
#FUNCTIONS
;Custom code, replaced function
RETURNF TINKO_TR(ARG)
VARSET LOCALS
SIF !ARG
	ARG = MASTER
;地の文と辻褄合わせが必要なのでとりあえず汚れ描写は保留
;確率で形容詞がつく
IF !RAND:4 && ARG == MASTER && TCVAR:ARG:100 != TARGET && TCVAR:ARG:101 != TARGET
	IF BASE:ARG:勃起 > 1000
		SELECTCASE RAND:4
			CASE 0
				LOCALS += "猛々しく反り返る"
			CASE 1
				LOCALS += "先走りをダラダラと滴らせる"
			CASE 2
				LOCALS += "血管を浮かせた"
			CASE 3
				LOCALS += "濃厚な精臭を放つ"
		ENDSELECT
	ELSEIF BASE:ARG:勃起 > 500
		SELECTCASE RAND:3
			CASE 0
				LOCALS += "むくむくと頭をもたげる"
			CASE 1
				LOCALS += "固さを増しつつある"
			CASE 2
				LOCALS += "半勃ちの"
		ENDSELECT
	ELSE
		LOCALS += "まだ柔らかい"
	ENDIF
ELSEIF !RAND:3
	SELECTCASE TALENT:ARG:形状
		CASE 1
			;未熟
			SELECTCASE RAND:3
				CASE 0
					LOCALS += "可愛らしい"
				CASE 1
					LOCALS += "子供の様な"
				CASE 2
					LOCALS += "剥けきっていない"
			ENDSELECT
		CASE 2
			;粗末
			LOCALS += "貧相な"
		CASE 3
			;普通
			LOCALS += "逞しい"
		CASE 4
			;光る
			SELECTCASE RAND:3
				CASE 0
					LOCALS += "ぼんやりと光を放つ"
				CASE 1
					LOCALS += "チカチカと点滅する"
				CASE 2
					LOCALS += "まばゆく輝く"
			ENDSELECT
		CASE 5
			SELECTCASE RAND:3
				CASE 0
					LOCALS += "グロテスクな"
				CASE 1
					LOCALS += "凶悪な"
				CASE 2
					LOCALS += "イボだらけの"
			ENDSELECT
		CASE 6
			;ごんぶと
			LOCALS += "長大な"
		CASE 10
			;馬並
			LOCALS += "馬のような"
	ENDSELECT
ELSEIF ARG == MASTER && TARGET
	IF !RAND:3
		IF TALENT:TARGET:妊娠
			LOCALS += "彼女を孕ませた"
		ELSEIF STRFIND(CSTR:TARGET:処女喪失履歴, "ペニス") > 0
			LOCALS += "彼女を女にした"
		ENDIF
	ELSEIF !RAND:2 && 임신가부(TARGET) && CFLAG:TARGET:生理周期 == 7 && TEQUIP:TARGET:50 == MASTER
		LOCALS += "孕ませる気満々の"
	ENDIF
ENDIF
SELECTCASE RAND:12
	CASE 0
		LOCALS += "雄のシンボル"
	CASE 1
		LOCALS += "男根"
	CASE 2
		LOCALS += "怒張"
	CASE 3
		LOCALS += "陰茎"
	CASE 4
		LOCALS += "肉棒"
	CASE 5
		LOCALS += "剛直"
	CASEELSE
		LOCALS += "ペニス"
ENDSELECT
SIF !TALENT:ARG:2 & 2
	LOCALS = "ペニスバンド"
RETURNF LOCALS

@TINKO_DECIDE(ARG)
SIF !HAS_PENIS(ARG)
	RETURN
$LOOP
PRINTFORML 선택 \@ ARG==0 ? 당신의 # %CALLNAME:ARG%'의 \@ 페니스 유형
PRINTL [1] 미숙한
PRINTL [2] 한심한
PRINTL [3] 보통의
PRINTL [4] 발광하는
PRINTL [5] 울퉁불퉁한
PRINTL [6] 거대한
;PRINTL [7] 小ぶり
;PRINTL [8] ドリル
;PRINTL [9] パイプカット済み
INPUT
SIF !INRANGE(RESULT, 1, 6) ;custom code
	GOTO LOOP
IF RESULT == 5
	PRINTW 그걸 누군가 안에 넣는 건 그저 상처만 줄 뿐이야 - 즉각적인 아헤가오는 없어.
	PRINTW 이건 그냥 너 자신을 만족시키는 힘의 환상일 뿐인가? 동정심을 느끼는 법을 잊은 거야?
	PRINTL [0] 좋아, 바꿔라
	PRINTL [1] 네 일이나 신경 써!
	INPUT
	IF RESULT == 1
		PRINTW 너 악마로군!
		PRINTFORMW \@ ARG==0 ? 너의 # %CALLNAME:ARG%'s \@의 성기는 울퉁불퉁하며 단단한 혹들로 덮여 있다.
		TALENT:ARG:形状 = 5
	ELSE
		GOTO LOOP
	ENDIF
ELSEIF RESULT == 4
	PRINTL 그게 대체 무슨 뜻이야?
	PRINTL [0] 미안, 내가 잘못했어, 되돌려줘
	PRINTL [1] 반딧불 오징어처럼 빛날 거야 
	INPUT
	IF RESULT == 1
		PRINTW 알겠다.
		PRINTFORMW \@ ARG==0 ? 당신의 # %CALLNAME:ARG%'의 \@ 성기가 빛을 발한다.
		TALENT:ARG:形状 = 4
	ELSE
		GOTO LOOP
	ENDIF
ELSEIF RESULT == 6
	PRINTL 더 큰 것이 항상 더 좋다고 생각하십니까? 당신의 심장은 한정된 양의 피만을 펌프질할 수 있습니다. 너무 커지면 벌떡이 될 테니까요.
	PRINTL 게다가 중요한 것은 크기가 아니라 호환성입니다. 만약 사이즈가 맞지 않으면 그냥 고통스러울 뿐이죠.
	PRINTL [0] 마음을 바꿨습니다. 더 적은 노력으로 로리들에게 XXX 같은 것들을 하고 싶어요.
	PRINTL [1] 저에게 맞춰 늘어나면서 고통으로 일그러지는 처녀들의 얼굴을 보고 싶어요.
	INPUT
	IF RESULT == 1
		PRINTW 도대체 뭐야...
		PRINTFORMW \@ ARG==0 ? 당신의 # %CALLNAME:ARG%'의 \@ 성기가 크다.
		TALENT:ARG:形状 = 6
	ELSE
		GOTO LOOP
	ENDIF
ELSEIF RESULT == 3
	PRINTFORMW \@ ARG==0 ? 너의 # %CALLNAME:ARG%'s \@의 성기는 정상이다.
	TALENT:ARG:形状 = RESULT
ELSEIF RESULT == 2
	PRINTFORMW 「\@ ARG==0 ? 당신의 # %CALLNAME:ARG%의 \@ 남근은 한심하다.」
	TALENT:ARG:形状 = RESULT
ELSEIF RESULT == 1
	PRINTFORMW \@ ARG==0 ? 너의 # %CALLNAME:ARG%'s \@의 페니스는 귀여운 아이 크기다.
	TALENT:ARG:形状 = RESULT
ENDIF

@TINKO_VSOURCE(ARG)
SELECTCASE TALENT:(TEQUIP:ARG:50):形状
	CASE 5
		;イボ付き
		CUP:ARG:快Ｖ /= 4
	CASE 2
		;粗末
		CUP:ARG:快Ｖ /= 2
	CASE 10
		;馬並
		CUP:ARG:快Ｖ *= 2
ENDSELECT
SIF 挿入不可(ARG) == -1 && ABL:ARG:膣 < 2
	CUP:ARG:快Ｖ = CUP:ARG:快Ｖ * 4 / 5
SIF 挿入不可(ARG) == -2 && ABL:ARG:膣 < 3
	CUP:ARG:快Ｖ /= 2

@TINKO_ASOURCE(ARG)
SELECTCASE TALENT:(TEQUIP:ARG:51):形状
	CASE 5
		;イボ付き
		CUP:ARG:快Ａ /= 4
	CASE 2
		;粗末
		CUP:ARG:快Ａ /= 2
	CASE 10
		;馬並
		CUP:ARG:快Ａ *= 2
		SIF 挿入不可(ARG) == -1 && ABL:ARG:アナル < 2
			CUP:ARG:快Ａ = CUP:ARG:快Ｖ * 4 / 5
		SIF 挿入不可(ARG) == -2 && ABL:ARG:アナル < 3
			CUP:ARG:快Ａ /= 2
ENDSELECT

@TINKO_SIMPLE(ARG)
#FUNCTIONS
VARSET LOCALS
SELECTCASE TALENT:ARG:形状
	CASE 1
		LOCALS = childish
	CASE 2
		LOCALS = thin
	CASE 3
		LOCALS = robust
	CASE 4
		LOCALS = shining
	CASE 5
		LOCALS = fiendish
	CASE 6
		LOCALS = monstrous
	CASE 10
		LOCALS = horse-like
ENDSELECT
LOCALS += (STRLENS(LOCALS) ? " " # "") + "penis"
RETURNF LOCALS
