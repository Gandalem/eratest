; Modular ERB: EVENT_MESSAGE_COM80~.ERB
;-------------------------------------------------
;80,手淫
;-------------------------------------------------

@MESSAGE_COM80
CALL MESSAGE_COM80_TR
RETURN
VARSET LOCAL
IF MASTER_POSE(SET_V,SET_P,1)
	LOCAL = MASTER_POSE(SET_V,SET_P,1)
ELSEIF MASTER_POSE(SET_A,SET_P,1)
	LOCAL = MASTER_POSE(SET_A,SET_P,1)
ENDIF
IF FLAG:70 == 1
	IF NOWEX:MASTER:射精
		IF LOCAL == TARGET
			PRINTFORML 시간을 멈추고 범하고 있는%조사처리(CALLNAME:TARGET,"의")% \@ MASTER_POSE(SET_V,SET_P,1) ? 질 # 항문 \@에서 %TINKO(PLAYER)%를 빼내어, %조사처리(CALLNAME:TARGET,"의")% 손에 쥐여주다
		ELSEIF LOCAL
			PRINTFORML 시간을 멈추고 범하고 있는 %CALLNAME:LOCAL%로부터 %TINKO(PLAYER)%를 빼서, %조사처리(CALLNAME:TARGET,"의")% 손에 쥐게 했다.
		ELSE
			PRINTFORML 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 손에 %TINKO(PLAYER)%를 잡게 해라
		ENDIF
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 손을 사용해, 사정 직전인 %TINKO(PLAYER)%를 앞뒤로 주물렀다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 손에 %TINKO(PLAYER)%을 잡고 쓸어 올렸다...
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	IF NOWEX:MASTER:射精
		IF LOCAL == TARGET
			PRINTFORML 잠든 채 범해지고 있는 %조사처리(CALLNAME:TARGET,"의")% \@ MASTER_POSE(SET_V,SET_P,1) ? 질 # 애널 \@에서 %TINKO(PLAYER)%을 빼내, %조사처리(CALLNAME:TARGET,"의")% 손에 쥐게 한다.
		ELSEIF LOCAL
			PRINTFORML 잠든 채 범해지고 있는 %CALLNAME:LOCAL%로부터 %TINKO(PLAYER)%를 빼고, %조사처리(CALLNAME:TARGET,"의")% 손에 쥐게 하다
		ELSE
			PRINTFORML 잠든 채 범당하는 %조사처리(CALLNAME:TARGET,"의")% 손에 %TINKO(PLAYER)%를 잡게 해라
		ENDIF
		PRINTFORML 사정 직전의 %TINKO(PLAYER)%을 앞뒤로 주물렀다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 잠든 %조사처리(CALLNAME:TARGET,"의")% 손에 %TINKO(PLAYER)%를 쥐여 문질렀다.
	ENDIF
ELSE
	IF NOWEX:MASTER:射精
		IF LOCAL == TARGET
			PRINTFORML 사정 직전에 \@ MASTER_POSE(SET_V,SET_P,1) ? 질 # 항문 \@에서 %TINKO(PLAYER)%을 빼서 %CALLNAME:TARGET%에 쥐여주었다...
		ELSEIF LOCAL
			PRINTFORML 사정 직전에 %CALLNAME:LOCAL%에서 %TINKO(PLAYER)%를 빼서 %조사처리(CALLNAME:TARGET,"에게")% 쥐여줬다...
		ELSE
			PRINTFORML 사정 직전의 %TINKO(PLAYER)%을 %조사처리(CALLNAME:TARGET,"에게")% 쥐여주었다...
		ENDIF
		IF ABL:技巧 > 3
			IF ABL:精液中毒 >= 5
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 격렬하게 %TINKO(PLAYER)%를 비비면서 방울 입 앞에서 입을 벌리고 정액을 기다리고 있다...
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 능숙한 손길로 %TINKO(PLAYER)%의 민감한 부분을 찾아내 %조사처리(CALLNAME:PLAYER,"를")% 사정으로 이끌었다...
			ENDIF
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 당황하면서도 스즈구치의 부분을 가만히 바라보며, %TINKO(PLAYER)%를 앞뒤로 주무르고 있다...
		ENDIF
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
		;恋慕か親愛
		SIF TALENT:恋慕
			PRINT 사랑스럽다는 표정으로,
		;淫乱か娼婦
		SIF TALENT:淫乱
			PRINT 스스로
		SIF CFLAG:負け犬 && !TALENT:恋慕 && !TALENT:淫乱
			PRINTFORM 얼굴을 돌리면서
		PRINTFORML %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%에 손가락을 걸고 쓸어 올리고 있다...
	ENDIF
ENDIF
;-------------------------------------------------
;81,フェラチオ
;-------------------------------------------------

@MESSAGE_COM81
;Custom code, override
CALL MESSAGE_COM81_TR
RETURN
VARSET LOCAL
;お掃除用
IF TCVAR:MASTER:112 == 1
	LOCAL = MASTER_POSE(SET_V,SET_P,1)
ELSEIF TCVAR:MASTER:112 == 2
	LOCAL = MASTER_POSE(SET_A,SET_P,1)
ENDIF
IF MASTER_POSE(SET_V,SET_P,1)
	LOCAL:1 = MASTER_POSE(SET_V,SET_P,1)
ELSEIF MASTER_POSE(SET_A,SET_P,1)
	LOCAL:1 = MASTER_POSE(SET_A,SET_P,1)
ENDIF
IF FLAG:70 == 1
	;お掃除
	IF LOCAL
		PRINTFORML 시간이 멈춘 %CALLNAME:LOCAL% 안에서 잔뜩 사정하고 %TINKO(PLAYER)%를 빼낸 후,
		PRINTFORML 정액이 묻은 %TINKO(PLAYER)%를 %조사처리(CALLNAME:TARGET,"의")% 입에 밀어 넣어 %TINKO(PLAYER)%를 청소하게 했다…
	ELSEIF NOWEX:MASTER:射精
		IF LOCAL:1 == TARGET
			PRINTFORML 시간을 멈추고 범하고 있는%조사처리(CALLNAME:TARGET,"의")% \@ MASTER_POSE(SET_V,SET_P,1) ? 질 # 항문 \@에서%TINKO(PLAYER)%를 빼내, %조사처리(CALLNAME:TARGET,"의")% 입에 박아 넣는다
			;TODO reflect in translation
		ELSEIF LOCAL:1
			PRINTFORML 시간을 멈추고 범하고 있는 %CALLNAME:(LOCAL:1)%으로부터 %TINKO(PLAYER)%를 빼내, %조사처리(CALLNAME:TARGET,"의")% 입에 밀어 넣는다.
		ELSE
			PRINTFORML 시간이 멈춰 있는 %조사처리(CALLNAME:TARGET,"의")% 입에 %TINKO(PLAYER)%를 밀어 넣다
		ENDIF
		PRINTFORML 사정 직전의 %TINKO(PLAYER)%을 목구멍 깊숙이 밀어 넣었다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 입에 %TINKO(PLAYER)%을 밀어 넣고, 혀에 문지르듯이 허리를 움직였다.
	ENDIF
	SIF TALENT:キス未経験
		PRINTFORML 키스의 경험도 없는%조사처리(CALLNAME:TARGET,"의")% 가련한 입술을 더럽히고 있다는 사실이, %조사처리(CALLNAME:MASTER,"를")% 아프게 고조시킨다...
ELSEIF CFLAG:MASTER:イタズラ == 2
	;お掃除
	IF LOCAL
		PRINTFORML 잠든 채 범해진 %CALLNAME:LOCAL% 안에 가득 사정하고 나서 %TINKO(PLAYER)%를 빼고,
		PRINTFORML 정액이 묻은 %TINKO(PLAYER)%를 %조사처리(CALLNAME:TARGET,"의")% 입에 밀어 넣어 %TINKO(PLAYER)%를 청소시켰다…
	ELSEIF NOWEX:MASTER:射精
		IF LOCAL:1 == TARGET
			PRINTFORML 잠든 채 범해지고 있는 %조사처리(CALLNAME:TARGET,"의")% \@ MASTER_POSE(SET_V,SET_P,1) ? 질 # 항문 \@에서 %TINKO(PLAYER)%를 빼내고, %조사처리(CALLNAME:TARGET,"의")% 입에 밀어넣는다.
		ELSEIF LOCAL:1
			PRINTFORML 잠든 채 범해지고 있는 %CALLNAME:(LOCAL:1)%부터 %TINKO(PLAYER)%를 빼고, %조사처리(CALLNAME:TARGET,"의")% 입에 밀어 넣는다.
		ELSE
			PRINTFORML 잠든 채 범해지고 있는%조사처리(CALLNAME:TARGET,"의")% 입에%TINKO(PLAYER)%를 밀어 넣고
		ENDIF
		PRINTFORML 사정 직전의 %TINKO(PLAYER)%을 목구멍 깊숙이 밀어 넣었다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% 입에 %TINKO(PLAYER)%을 넣고, 혀에 비비듯이 허리를 움직였다...
	ENDIF
ELSE
	;お掃除
	IF LOCAL
		PRINTFORML %CALLNAME:LOCAL% 안에 가득 사정하고 %TINKO(PLAYER)%를 빼낸 후,
		PRINTFORML %TINKO(PLAYER)%T2에 붙은 정액을 %조사처리(CALLNAME:TARGET,"에게")% 핥게 했다...
		SIF TFLAG:8 && !TCVAR:TARGET:泥酔
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 요도에 남은 정액까지 남김없이 깨끗하게 한 후에 \@ ABL:精液中毒 > 4 ? 아쉬워하는 듯 #  \@%TINKO(PLAYER)%로부터 입술을 떼었다…
	ELSEIF NOWEX:MASTER:射精
		IF LOCAL:1 == TARGET
			PRINTFORML 사정 직전에 \@ MASTER_POSE(SET_V,SET_P,1) ? 질 # 항문 \@에서 %TINKO(PLAYER)%을 빼서 %조사처리(CALLNAME:TARGET,"에게")% 물게 했다...
		ELSEIF LOCAL:1
			PRINTFORML 사정 직전에 %CALLNAME:(LOCAL:1)%에서 %TINKO(PLAYER)%를 빼 %CALLNAME:TARGET%에 물게 했다...
		ELSE
			PRINTFORML 사정 직전의 %TINKO(PLAYER)%을 %조사처리(CALLNAME:TARGET,"에게")% 물게 했다...
		ENDIF
		IF ABL:舌 > 2 && !TCVAR:TARGET:泥酔
			IF ABL:精液中毒 > 4
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 입술로 귀두를 감싼 후 질척하게 혀를 움직이며 %조사처리(CALLNAME:PLAYER,"에게")% 사정을 유도하고 있다.
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %TINKO(PLAYER)%의 민감한 부분에 혀를 대고 %CALLNAME:PLAYER%에 사정을 유도하고 있다...
			ENDIF
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:PLAYER,"의")% 반응을 살피며 필사적으로 혀를 움직이고 있다...
		ENDIF
	ELSEIF TCVAR:TARGET:泥酔
		PRINTFORML 흐릿해진 %조사처리(CALLNAME:TARGET,"의")% 입에 %TINKO(PLAYER)%를 물게 했다
		PRINTFORML 하고 나서 깨달았지만 물리지 않도록…….
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%에
		;恋慕
		SIF TALENT:恋慕
			PRINT 애틋한 표정으로,
		;淫乱
		SIF TALENT:淫乱
			PRINT 스스로
		SIF CFLAG:負け犬 && !TALENT:恋慕 && !TALENT:淫乱
			PRINTFORM 눈물 가득한 눈으로
		PRINTFORML 혀를 핥고 있다...
	ENDIF
ENDIF
;-------------------------------------------------
;82,パイズリ
;-------------------------------------------------

@MESSAGE_COM82
CALL MESSAGE_COM82_TR
RETURN
IF SELECTCOM == PREVCOM
	IF FLAG:70 == 1 || CFLAG:MASTER:イタズラ == 2
		PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% \@ FLAG:70 ? 시간을 멈춘 # 자고 있는 \@%조사처리(CALLNAME:TARGET,"의")%%OPPAI_DESCRIPTION(TARGET,1)%
		IF RAND:2
			IF RAND:3 == 0
				PRINTFORM 의 유륜을 엄지손가락으로 간지럽히면서
			ELSEIF RAND:2
				PRINTFORM %NIPPLE_DESCRIPTION(TARGET,1)%을 손가락으로 만지작거리며
			ELSE
				PRINTFORM \@ TALENT:バストサイズ == -2 ? 를 손바닥 전체로 쓰다듬으면서 # 주무르면서 \@
			ENDIF
		ELSE
			PRINTFORM %TEXTR("を内側に寄せながら/を密着させながら/を締め付けながら/を圧迫しながら")%
		ENDIF
		SIF EXP:PLAYER:Ｖ性交経験 + EXP:PLAYER:Ａ性交経験 && RAND:2
			PRINTFORM %TEXTR("性交でもするかのように/乳を孕ませようと/まるで交尾をしているかの如く")%
		SIF RAND:2
			PRINTFORM 체력이 허락하는 한
		IF ABL:PLAYER:サドっ気 && RAND:3 == 0
			PRINTFORM 거칠게 허리를 움직이며
		ELSE
			PRINTFORM %TEXTR("腰を激しく動かし/腰を前後に動かし")%
		ENDIF
		IF RAND:2 == 0
			PRINTFORML 계속 저지르고 있어...
		ELSE
			PRINTFORML 계속 저질렀다...
		ENDIF
	ELSE
		;超乳
		IF TALENT:バストサイズ == 3 && RAND:3
			PRINTFORML 규격 외의 %OPPAI_DESCRIPTION(TARGET,1)%은 %조사처리(CALLNAME:PLAYER,"의")% 손가락을 삼키고, 들어 올리지 않으면 무게 때문에 축 늘어져 버린다...
			PRINTFORML 그래서 %조사처리(CALLNAME:TARGET,"는")% 몇 번이고 %OPPAI_DESCRIPTION(TARGET)%를 들어 올리며, 그 동작으로 %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%를 계속 만졌다...
			;貧乳
		ELSEIF TALENT:バストサイズ == -1
			PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%에서 필사적으로 %TINKO(PLAYER)%를 비비고 있다...
			;絶壁
		ELSEIF TALENT:バストサイズ == -2
			PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%그리고 %NIPPLE_DESCRIPTION(TARGET,1)%로 필사적으로 %TINKO(PLAYER)%를 비비고 있다...
			;巨乳
		ELSEIF TALENT:バストサイズ == 1
			PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 감싸며 계속 쓸어 올리고 있다...
			;爆乳、超乳
		ELSEIF TALENT:バストサイズ >= 2
			PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 감싸듯이 계속 문지르고 있다...
		ELSE
			PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%으로 %TINKO(PLAYER)%를 사이에 두고 계속 문지르고 있다...
		ENDIF
	ENDIF
	RETURN 0
ENDIF
IF FLAG:70 == 1
	PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈춘 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET,1)%
	;貧乳
	IF TALENT:バストサイズ == -1
		PRINTFORM 에, %TINKO(PLAYER)%을 비볐다.
		;絶壁
	ELSEIF TALENT:バストサイズ == -2
		PRINTFORM 그래서, 봉긋하게 선 %NIPPLE_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)%를 비볐다.
		;普乳以上
	ELSE
		PRINTFORM 에, %TINKO(PLAYER)%을 끼우고 쓸어 올렸다
	ENDIF
	PRINTL 타...
ELSEIF CFLAG:MASTER:イタズラ == 2
	PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% 자고 있는 %조사처리(CALLNAME:TARGET,"의")%
	;貧乳
	IF TALENT:バストサイズ == -1
		PRINTFORM %TINKO(PLAYER)%을 비볐다.
		;絶壁
	ELSEIF TALENT:バストサイズ == -2
		PRINTFORM 소생하는 %NIPPLE_DESCRIPTION(TARGET,1)%에, %TINKO(PLAYER)%를 비볐다.
		;巨乳
	ELSEIF TALENT:バストサイズ == 1
		PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%에, %TINKO(PLAYER)%를 끼우고 쓸어 올린다
		;爆乳
	ELSEIF TALENT:バストサイズ == 2
		PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%에, %TINKO(PLAYER)%를 끼우고 쓸어 올린다.
	ELSE
		PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼워 문질렀다
	ENDIF
	PRINTL 타...
ELSE
	PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
	;恋慕か親愛（愛欲の有無でちょっと分岐）
	SIF TALENT:愛欲
		PRINTFORM \@ TALENT:恋慕 ? 황홀한 # 녹아내린 \@표정을 지으며,
	SIF CFLAG:負け犬 && !TALENT:恋慕 && !TALENT:淫乱
		PRINTFORM 속 깊이 싫어하는 표정으로
	IF ABL:TARGET:胸 > 2
		;胸3以上
		;胸で分岐させてサイズはSELECTCASEで分けてみる。大きさは違ってもその先に突起はあるんだよ
		SELECTCASE TALENT:バストサイズ
			;きょにゅー以上
			CASE IS > 0
				IF RAND:2 == 0
					PRINTFORML 통통하게 채워진 살과 살, %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 농락한다.
					PRINTL 촉촉하게 감싸 안으며 부드럽지만 끝까지 단단한 육봉을 받아들인다.
					PRINTL 가라앉는 듯한 기분은 마치 살의 바다에 녹아드는 듯한 감각이다...
				ELSE
					PRINTFORML 그 %OPPAI_DESCRIPTION(TARGET,1)%을 밀어붙이고, 풍부하게 %OPPAI_DESCRIPTION(TARGET)%의 중압감을 가한 가운데,
					PRINTFORML %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%를 이끌었다.
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 살이 부드럽고 압도적인 양감으로 닿아가는 감촉에, %조사처리(CALLNAME:PLAYER,"는")% 빨려 들어간다...
				ENDIF
				PRINTL 미끌거리는 살과 살은 밀어 넣을수록 단단한 페니스를 어디까지나 받아들이고, 깊이 가라앉을수록 부드러운...
				SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
					PRINTFORML 그 안에서 복숭아빛이 도는 %OPPAI_DESCRIPTION(TARGET,1)%의 끝, %NIPPLE_DESCRIPTION(TARGET,1)%가 때때로 바늘이나 칼을 비비듯 간질인다…
				;ひんぬー以下
			CASE IS < 0
				PRINTFORML 물리적인 핸디캡을 경험과 기술로 보충하려 %OPPAI_DESCRIPTION(TARGET,1)%를 사용해 %TINKO(PLAYER)%에게 봉사하고 있다.
				SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
					PRINTFORML 상기된 가슴팍의 끝에 있는 %NIPPLE_DESCRIPTION(TARGET,1)%으로 남성기나 칼을 문지르듯이 정중하게 유도해 온다.
				;ふにゅぅ
			CASEELSE
				PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 끼고, 주무른다.
				SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
