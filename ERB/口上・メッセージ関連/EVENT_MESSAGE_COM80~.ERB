IF TALENT:バストサイズ == -1
	PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)%를 비볐다.
	;巨乳
ELSEIF TALENT:バストサイズ == 1
	PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 쓸어 올리다.
	;爆乳
ELSEIF TALENT:バストサイズ == 2
	PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 쓸어 올리다
	;超乳
ELSEIF TALENT:バストサイズ == 3
	PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)% 밀어붙여 문지른다
ELSE
	PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 문질러 올린다.
ENDIF
PRINTL 음...
PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)%
IF RAND:2
	IF RAND:3 == 0
		PRINTFORM 의 유륜을 엄지손가락으로 간지럽히면서
	ELSEIF RAND:2
		PRINTFORM %NIPPLE_DESCRIPTION(TARGET,1)%을 손가락으로 만지작거리며
	ELSE
		PRINTFORM 을 구겨가며
	ENDIF
ELSE
	IF RAND:4 == 0
		PRINTFORM 안쪽으로 모으면서
	ELSEIF RAND:3 == 0
		PRINTFORM 를 밀착시키면서
	ELSEIF RAND:2
		PRINTFORM 를 조이면서
	ELSE
		PRINTFORM 를 압박하면서
	ENDIF
ENDIF
IF EXP:PLAYER:Ｖ性交経験 + EXP:PLAYER:Ａ性交経験 && RAND:2
	IF RAND:3 == 0
		PRINT 성교라도 하는 것처럼
	ELSEIF RAND:2
		PRINTFORM 유방을 임신시키려고
	ELSE
		PRINT 마치 교미하는 것처럼
	ENDIF
ENDIF
IF ABL:PLAYER:サドっ気 && RAND:3 == 0
	PRINTFORMW 거칠게 허리를 움직였다...
ELSEIF RAND:2
	PRINTFORMW 허리를 격렬하게 움직였다...
ELSE
	PRINTFORMW 허리를 앞뒤로 움직였다...
ENDIF
IF !FLAG:70 && CFLAG:MASTER:イタズラ != 2
	PRINTFORM %조사처리(CALLNAME:TARGET,"는")%(는) 가슴골을 범당했다
	;恋慕か親愛（愛欲の有無でちょっと分岐）
	IF TALENT:愛欲
		PRINTFORML \@ TALENT:恋慕 ? 황홀하게 # 녹아내린 \@ 표정을 하고 있다…
	ELSE
		PRINTFORML 하고 있다...
	ENDIF
	IF ABL:PLAYER:技巧 > 2
		;プレイヤーの技巧3以上
		;胸で分岐させてサイズはSELECTCASEで分けてみる。大きさは違ってもその先に突起はあるんだよ
		SELECTCASE TALENT:バストサイズ
			;きょにゅー以上
			CASE IS > 0
				IF RAND:2 == 0
					PRINTFORML 통통하게 채워진 살과 살, %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 농락한다.
					PRINTL 촉촉하게 감싸 안으며 부드럽지만 끝까지 단단한 육봉을 받아들인다.
					PRINTL 가라앉는 듯한 기분은 마치 살의 바다에 녹아드는 듯한 감각이다...
				ELSE
					PRINTFORML 그 %OPPAI_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)%를 밀어붙이고, 충분히 %OPPAI_DESCRIPTION(TARGET)%의 중압을 가한 상태에서,
					PRINTFORML %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%를 쑤셔 넣는다.
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 살이 부드럽고 압도적인 양감으로 닿는 느낌에, %조사처리(CALLNAME:PLAYER,"는")% 빨려 들어간다...
				ENDIF
				PRINTL 미끌거리는 살과 살은 밀어 넣을수록 단단한 페니스를 어디까지나 받아들이고, 깊이 가라앉을수록 부드러운...
				SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
					PRINTFORML 그 안에서 복숭아빛이 도는 %OPPAI_DESCRIPTION(TARGET,1)%의 끝, %NIPPLE_DESCRIPTION(TARGET,1)%가 때때로 바늘이나 칼을 비비듯 간질인다…
				;ひんぬー以下
			CASE IS < 0
				PRINTFORML 물리적인 핸디캡을 경험과 기술로 보충하려 %OPPAI_DESCRIPTION(TARGET,1)%를 사용해 %TINKO(PLAYER)%에게 봉사하고 있다.
				SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
					PRINTFORML 상기된 가슴팍의 끝에 있는 %NIPPLE_DESCRIPTION(TARGET,1)%으로 남성기나 칼을 문지르듯이 정중하게 유도해 온다.
				;ふにゅぅ
			CASEELSE
				PRINTFORML %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 끼고, 주무른다.
				SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
					PRINTFORML 이따금 땀으로 축축해진 %OPPAI_DESCRIPTION(TARGET,1)%의 봉우리, %NIPPLE_DESCRIPTION(TARGET,1)%에 막이나 칼을 비비며 달콤한 목소리를 낸다.
		ENDSELECT
	ELSEIF ABL:PLAYER:技巧 <= 2
		;胸2以下
		;貧乳
		IF TALENT:バストサイズ == -1
			PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%로 필사적으로 %TINKO(PLAYER)%를
			;巨乳
		ELSEIF TALENT:バストサイズ == 1
			PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 감싸 안았다.
			;爆乳、超乳
		ELSEIF TALENT:バストサイズ >= 2
			PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%으로 %TINKO(PLAYER)%를 감싸듯 하여
		ELSE
			PRINTFORM %OPPAI_DESCRIPTION(TARGET,1)%으로 %TINKO(PLAYER)%를 끼우고
		ENDIF
		PRINTL 올려지고 있다...
	ELSE
	ENDIF
	;恋慕又は愛欲
	IF IS_LOVER(TARGET) && EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 30000 && RAND:3 == 0
		PRINTFORML 기분이 고양된 걸까, %조사처리(CALLNAME:TARGET,"는")% 격렬하게 몸을 흔들며,
		PRINTFORML %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%를 %OPPAI_DESCRIPTION(TARGET)%로 철저하게 다루면서, 열에 들뜬 것처럼
		PRINTFORML 자신의 파이즈리는 어때? 기분 좋아?
		PRINTFORML 또 %SAMEN_DESCRIPTION(PLAYER)%를 낼 거야? 걸 거야? 부어 넣을 거야?
		PRINTFORML 라며, 쾌락에 마음을 맡긴 매혹적인 모습으로 물어온다...
	ENDIF
ENDIF
