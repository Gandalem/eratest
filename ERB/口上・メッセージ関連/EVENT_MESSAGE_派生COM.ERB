	FOR LOCAL,17,6,-1
	IF GROUPMATCH(LOCAL, 13, 12, 11)
		CONTINUE
	ENDIF
	IF EQUIP:TARGET:LOCAL
		PRINTFORM %CLOTHNAME(LOCAL,EQUIP:TARGET:LOCAL)%위에서
		BREAK
	ENDIF
	NEXT
ENDIF
