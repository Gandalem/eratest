;3,Gスポット刺激
;-------------------------------------------------

@MESSAGE_SCOM3
CALL MESSAGE_SCOM3_TR
RETURN
IF FLAG:70 == 1
	;バイブ挿入中
	IF TEQUIP:バイブ
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 질 속에서 요염하게 꿈틀거리는 바이브를, 거친 천장을 자극하도록 움직였다.
		;欲情のPALAMLV3以上＋Ｖ感覚LV3以上
		IF PALAM:欲情 >= PALAMLV:3 && ABL:Ｖ感覚 >= 3
			PRINTFORML 꿀에 젖은 질 내부는 넣었다 빼는 바이브에 미끌미끌하게 달라붙어 온다...
			;欲情のPALAMLV3未満＋Ｖ感覚LV3以上
		ELSEIF PALAM:欲情 < PALAMLV:3 && ABL:Ｖ感覚 >= 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부는 삽입과 빼짐이 반복되는 바이브를 받아 쾌락에 떨고 있다...
			;欲情のPALAMLV3以上＋Ｖ感覚LV3未満
		ELSEIF PALAM:欲情 >= PALAMLV:3 && ABL:Ｖ感覚 < 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부는 꿀을 흘리며 바이브를 받아들이고 있다...
			;欲情のPALAMLV3未満＋Ｖ感覚LV3未満
		ELSEIF PALAM:欲情 < PALAMLV:3 && ABL:Ｖ感覚 < 3
			PRINTFORML 시간을 멈출 수 있었던 %조사처리(CALLNAME:TARGET,"는")% 저항조차 하지 못한 채, 초심한 질 내부를 유린당하고 있다...
		ENDIF
	ELSE
		IF EXP:Ｖ経験 > 80
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 질 내부의 거친 천장을, 격렬하게 문지르듯 자극했다...
			SIF EXP:Ｖ経験 > 120
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부는 파르르 떨며 손가락에 감기고, 애액을 흘리고 있다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 질 속에서 손가락을 구부려 거친 천장을 자극했다...
		ENDIF
	ENDIF
ELSE
	;バイブ挿入中
	IF TEQUIP:バイブ
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 능숙하게 바이브를 조종하며 민감한 천장을 휘저었다...
		;バイブ挿入中＋欲情のPALAMLV3以上＋Ｖ感覚LV3以上
		IF TEQUIP:バイブ && PALAM:欲情 >= PALAMLV:3 && ABL:Ｖ感覚 >= 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질은, 꿀에 젖은 바이브에 끈적하게 달라붙어 있다...
			;バイブ挿入中＋欲情のPALAMLV3未満＋Ｖ感覚LV3以上
		ELSEIF TEQUIP:バイブ && PALAM:欲情 < PALAMLV:3 && ABL:Ｖ感覚 >= 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 바이브의 자극에 몸부림치고 있다.
			;バイブ挿入中＋欲情のPALAMLV3以上＋Ｖ感覚LV3未満
		ELSEIF TEQUIP:バイブ && PALAM:欲情 >= PALAMLV:3 && ABL:Ｖ感覚 < 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 뺨을 물들이고 때때로 소리를 지르고 있다.
			;バイブ挿入中＋欲情のPALAMLV3未満＋Ｖ感覚LV3未満
		ELSEIF TEQUIP:バイブ && PALAM:欲情 < PALAMLV:3 && ABL:Ｖ感覚 < 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 약간 괴로워 보이는 표정이다.
		ENDIF
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 질 속에서 손가락을 구부려 거친 천장을 자극했다...
		;Ｖ経験が120より多い
		IF EXP:Ｖ経験 > 120
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 침을 흘리며 스스로 허리를 흔들어 쾌락을 탐하고 있다...
			;Ｖ経験が80より多い
		ELSEIF EXP:Ｖ経験 > 80
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 배 속을 휘젓는 감각에 뜨거운 한숨을 내쉬며 괴로워하고 있다...
			;Ｖ経験が50より多い
		ELSEIF EXP:Ｖ経験 > 50
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 손가락의 꿈틀거리는 감촉에 넋을 잃고 있다.
			;Ｖ経験が30より多い
		ELSEIF EXP:Ｖ経験 > 30
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 손가락의 감촉을 즐기고 있는 듯하다.
			;Ｖ経験が0より多い
		ELSEIF EXP:Ｖ経験 > 0
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 손가락의 감촉에 한숨을 쉬며 버티고 있다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 질 내부의 이물감에 떨고 있다...
		ENDIF
	ENDIF
ENDIF
