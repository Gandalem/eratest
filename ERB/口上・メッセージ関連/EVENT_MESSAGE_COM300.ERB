;会話

@MESSAGE_COM300
IF TCVAR:会話不能 && !TALENT:恋慕 && TFLAG:193 == -1 ;bug fix
	RETURN
ENDIF
;Custom code, replaced with custom function
CALL CONVERSATION()
RETURN
IF TCVAR:泥酔
	PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 말을 걸어보았지만, %조사처리(CALLNAME:TARGET,"는")% 발음이 어눌해서 무슨 말인지 알아들을 수 없었다.
	PRINTFORML 거의 대화가 되지 않았다...
ELSE
	PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"와")%
	IF CFLAG:ブチギレ > 0
		IF TALENT:恋人
			PRINTDATA
				DATAFORM 솔직해지지 못하는 태도로
				DATAFORM 다소 고집을 부리는 모습을 보이며
				DATAFORM 일부러 사죄를 미루면서
				DATAFORM 기분을 살피면서도
				DATAFORM 마음속 깊이로는 사과하면서
			ENDDATA
		ELSE
			PRINTDATA
				DATAFORM 기분을 살피면서
				DATAFORM 어색한 분위기로
				DATAFORM 뒤돌아보고 싶은 기분으로
				DATAFORM 애써 미안해하지 않고
				DATAFORM 일방적으로
			ENDDATA
		ENDIF
	ELSEIF CFLAG:TARGET:20 > 0 && CFLAG:TARGET:350 == 49
		IF TALENT:恋慕
			PRINTDATA
				DATAFORM 술을 따르며
				DATAFORM 미소를 나누며
				DATAFORM 크게 웃으며
				DATAFORM 편안한 분위기에서
				DATAFORM 다소 대담한 화제를 하며
			ENDDATA
		ELSEIF ABL:親密 >= 5
			PRINTDATA
				DATAFORM 서로 잔을 채워주면서
				DATAFORM 서로를 신경 쓰면서
				DATAFORM 농담을 주고받으며 웃으면서
				DATAFORM 편안한 분위기에서
				DATAFORM 일부러 거리를 두면서
			ENDDATA
		ELSE
			PRINTDATA
				DATAFORM 조금씩 마시면서
				DATAFORM 조금 친근하게
				DATAFORM 교우를 깊게 하기 위해
				DATAFORM 장소 분위기의 기세에 乗て
				DATAFORM 평소와는 다른 분위기로
			ENDDATA
		ENDIF
	ELSEIF CFLAG:TARGET:添い寝中
		PRINTDATA
			DATAFORM 손가락을 얽으면서
			DATAFORM 기대어
			DATAFORM 살짝 부끄러워하며
			DATAFORM 서로 껴안으면서
			DATAFORM 장난치면서
			DATAFORM 볼에 손을 대고
			DATAFORM 이불 속에서
		ENDDATA
	ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中)
		IF TALENT:恋慕
			PRINTDATA
				DATAFORM 데이트 장소에 대해
				DATAFORM 나란히 걸으면서
				DATAFORM 약간 부끄러워하며
				DATAFORM 장난치면서
				DATAFORM 미소를 나누면서
			ENDDATA
		ELSE
			PRINTDATA
				DATAFORM 세상
				DATAFORM 외출 장소에 대해서
				DATAFORM 사소한
				DATAFORM 보잘것없는
				DATAFORM 걸으면서
			ENDDATA
		ENDIF
	ELSEIF TALENT:恋慕
		PRINTDATA
			DATAFORM 손가락을 얽으면서
			DATAFORM 나란히 앉아
			DATAFORM 조금 부끄러워하며
			DATAFORM \@ TIME >= 360 && TIME <= 1080 ? 낮의 빛 속에서 # 밤의 고요함 속에서 \@
			DATAFORM 장난치면서
			DATAFORM 미소를 나누며
		ENDDATA
	ELSE
		PRINTDATA
			DATAFORM 세간
			DATAFORM 별것 없는
			DATAFORM 시시한
			DATAFORM 사소한
			DATAFORM 보잘것없는
			DATAFORM 조금
			DATAFORM 고개를 들고
		ENDDATA
	ENDIF
	PRINTFORML 이야기를 나누었다.
	IF TFLAG:193 == 1
		PRINTFORML 즐거운 시간이 흘렀다...
	ELSEIF TFLAG:193 == 2
		PRINTDATA
			;		DATAFORM 新たな異変の
			DATAFORM 과장된
			DATAFORM 전제로서의
			DATAFORM 예상치 못한
			DATAFORM 신경 쓰이던
		ENDDATA
		PRINTFORML 이야기에 %CALLNAME:TARGET%\@ GET_TARGETNUM() > 1 ? 다들 #  \@은 크게 흥분했다...
	ELSEIF TFLAG:193 == -1
		PRINTFORML 대화가 끊기자 어색한 공기가 흘렀다...
	ELSEIF TFLAG:193 == -2
		PRINTFORML 대화가 통하지 않아...
	ENDIF
ENDIF
