CFLAG:CHARA:出産経過日 = DAY - CHILD_BIRTHDAY:CHARA:CHILDNUM + 1

SELECTCASE CHILD_ACT:CHARA:CHILDNUM
CASE "睡眠"
	IF TFLAG:193 == -1
		PRINTFORML You reach out to the sleeping %子供の名前%.
		PRINTFORML But %CALLNAME:CHARA% swats your hand away...
	ELSEIF TFLAG:193 == 1
		PRINTFORML You gently brush the sleeping %子供の名前%.
		PRINTFORML %CALLNAME:CHARA% watches anxiously...
	ELSE
		IF CFLAG:CHARA:出産経過日 < CHILD_語彙
			PRINTFORML You gently brush the sleeping %子供の名前%'s cheek.
			PRINTDATA
				DATAFORM %子供の名前% is breathing quietly in %HIS_HER_CHILD(CHARA,,CHILDNUM)% sleep.
				DATAFORM %子供の名前% breathes warmly on your hand.
				DATAFORM %子供の名前% looks happy.
				DATAFORM %子供の名前%'s soft skin soothes you.
				DATAFORM %子供の名前% tries to suckle on your finger.
				DATAFORM %CALLNAME:CHARA% puts %HIS_HER(CHARA)% hand over yours and smiles.
				DATAFORM %CALLNAME:CHARA% and you share in a moment of warm love.
			ENDDATA
			PRINTL 
		ELSE
			PRINTFORML You gently brush the sleeping %子供の名前%.
			PRINTFORML %子供の名前% breathes calmly.
		ENDIF
	ENDIF
CASE "起床"
	IF CFLAG:CHARA:出産経過日 < CHILD_語彙
		IF TFLAG:193 == -1
			PRINTFORML You reach out to play with %子供の名前%.
			PRINTFORML But %CALLNAME:CHARA% swats your hand away...
		ELSEIF TFLAG:193 == 1
			PRINTFORML You cuddle with %子供の名前% who is slowly waking up.
			PRINTFORML %CALLNAME:CHARA% watches anxiously...
		ELSE
			PRINTFORML You nurse the newly awoken and crying %子供の名前%.
			PRINTDATA
				DATAFORM %子供の名前% seems hungry...
				DATAFORM %子供の名前% seems to want to breast feed...
				DATAFORM %子供の名前% seems to want %CALLNAME:CHARA%...
			ENDDATA
			PRINTL 
		ENDIF
	ELSE
		PRINTFORML You say good morning to %子供の名前%.
		IF TFLAG:193 == -1
			PRINTFORML %子供の名前% replies drowsily.
		ELSEIF TFLAG:193 == 1
			PRINTFORML %子供の名前% returns the greeting cheerfully.
		ELSE
			PRINTDATA
				DATAFORM %子供の名前% returns the greeting cheerfully.
				DATAFORM %子供の名前% leans against you.
				DATAFORM %子供の名前% replies drowsily.
				DATAFORM %子供の名前% jumps to %HIS_HER_CHILD(CHARA,,CHILDNUM)% feet and greets you back.
				DATAFORM %子供の名前% yawns and returns the greeting.
			ENDDATA
			PRINTL 
		ENDIF
	ENDIF
CASE "入浴"
	IF CFLAG:CHARA:出産経過日 < CHILD_語彙
		;このへん状況的にありえるのだろうか……？
		IF TFLAG:193 == -1
			PRINTFORML You try to wash %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% swats your hand away...
		ELSEIF TFLAG:193 == 1
			PRINTFORML You wash %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% watches anxiously...
		ELSE
			PRINTFORML You wash %子供の名前%.
			PRINTDATA
				DATAFORM %子供の名前% seems ticklish.
				DATAFORM %子供の名前% stares at you.
				DATAFORM %子供の名前% looks at %CALLNAME:CHARA% anxiously.
				DATAFORM %子供の名前% splashes with %HIS_HER_CHILD(CHARA,,CHILDNUM)% hands and feet.
				DATAFORM %子供の名前% is relaxed.
			ENDDATA
			PRINTL 
		ENDIF
	ELSE
		IF TFLAG:193 == -1
			PRINTFORML You try to wash %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% swats your hand away...
		ELSEIF TFLAG:193 == 1
			PRINTFORML You wash %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% watches anxiously...
		ELSE
			PRINTFORML You wash %子供の名前%.
			PRINTDATA
				DATAFORM %子供の名前% seems ticklish.
				DATAFORM %子供の名前% seems to be enjoying it.
				DATAFORM %子供の名前% is playing with the soap bubbles and having fun.
				DATAFORM Imitating you, %子供の名前% helps you wash off as well.
			ENDDATA
			PRINTL 
		ENDIF
	ENDIF
CASE "食事"
	IF CFLAG:CHARA:出産経過日 < CHILD_離乳
		IF TFLAG:193 == -1
			PRINTFORML You reach out to %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% hides %子供の名前% behind %HIM_HER(CHARA)%self and glares at you...
		ELSEIF TFLAG:193 == 1
			PRINTFORML You reach out to pat %子供の名前%'s head.
			PRINTFORML %CALLNAME:CHARA% looks at you sharply, hiding %子供の名前% behind %HIM_HER(CHARA)%...
		ELSE
			PRINTFORML You gently brush the suckling %子供の名前%...
			PRINTDATA
				DATAFORM %子供の名前% is deeply engrossed...
				DATAFORM %子供の名前% sucks slowly...
				DATAFORM %子供の名前% is quiet...
				DATAFORM %CALLNAME:CHARA% smiles bashfully.
				DATAFORM %CALLNAME:CHARA% holds %子供の名前% with love, cradling %HIM_HER_CHILD(CHARA,,CHILDNUM)% gently...
				DATAFORM %CALLNAME:CHARA% is radiating with motherhood...
			ENDDATA
			PRINTL 
		ENDIF
	ELSEIF CFLAG:CHARA:出産経過日 < CHILD_語彙
		IF TFLAG:193 == -1
			PRINTFORML You try to eat next to %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% looks at you sharply, hiding %子供の名前% behind %HIM_HER(CHARA)%...
		ELSEIF TFLAG:193 == 1
			PRINTFORML You eat next to %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% watches anxiously...
		ELSE
			PRINTFORML You eat with %CALLNAME:CHARA% and %子供の名前%.
			PRINTDATA
				DATAFORM %子供の名前% holds %HIS_HER_CHILD(CHARA,,CHILDNUM)% mouth open innocently as food is brought in.
				DATAFORM %子供の名前% occasionally tries eating the food from the spoon on %HIS_HER_CHILD(CHARA,,CHILDNUM)% own.
				DATAFORM %子供の名前% chews as if savoring it.
				DATAFORM %子供の名前% holds %HIS_HER_CHILD(CHARA,,CHILDNUM)% mouth open as if waiting for food.
				DATAFORM %CALLNAME:CHARA% slowly brings the food to %子供の名前%'s mouth.
				DATAFORM %CALLNAME:CHARA% goes "aahhh" as %HE_SHE(CHARA)% feeds %子供の名前%.
				DATAFORM %CALLNAME:CHARA% opens and closes her mouth to get %子供の名前% to mimic her.
			ENDDATA
			PRINTL 
		ENDIF
	ELSE
		IF TFLAG:193 == -1
			PRINTFORML You try to eat next to %子供の名前%.
			PRINTFORML %CALLNAME:CHARA% looks at you sharply, hiding %子供の名前% behind %HIM_HER(CHARA)%...
		ELSEIF TFLAG:193 == 1
			PRINTFORML You eat next to %子供の名前%.
			PRINTFORML %子供の名前% eats while looking at you curiously.
		ELSE
			PRINTFORML You eat together with %子供の名前%.
			PRINTDATA
				DATAFORM %子供の名前% stuffs %HIS_HER_CHILD(CHARA,,CHILDNUM)% face with food.
				DATAFORM %子供の名前% takes %HIS_HER_CHILD(CHARA,,CHILDNUM)% meal slowly.
				DATAFORM %子供の名前% eats everything but %HIS_HER_CHILD(CHARA,,CHILDNUM)% favorite, saving it for last.
				DATAFORM %子供の名前% tells you what %HIS_HER_CHILD(CHARA,,CHILDNUM)% favorite food is.
				DATAFORM %子供の名前% is casually trying to leave the food behind...
				DATAFORM %子供の名前% asks you what you're eating.
				DATAFORM You teach %子供の名前% some table manners.
				DATAFORM You teach %子供の名前% how to hold chopsticks.
				DATAFORM You teach %子供の名前% about different tastes.
			ENDDATA
			PRINTL 
		ENDIF
	ENDIF
CASE "玩具"
	IF CFLAG:CHARA:出産経過日 < CHILD_自立前
		IF TFLAG:193 <= 1
			PRINTFORML You and %子供の名前% play with some toys.
			PRINTFORML %子供の名前% is full of innocent joy.
		ELSE
			PRINTFORML You and %子供の名前% play with some toys.
			PRINTDATA
				DATAFORM %子供の名前% seems to be enjoying it.
				DATAFORM %子供の名前% bangs toys into each other.
				DATAFORM %子供の名前% rolls a toy around.
				DATAFORM %子供の名前% is enjoying it immensely.
				DATAFORM %子供の名前% throws a toy around.
			ENDDATA
			PRINTL 
		ENDIF
	ELSE
		IF TFLAG:193 <= 1
			PRINTFORML You have a chat with %子供の名前%.
			PRINTFORML You quickly run out of things to say...
		ELSE
			PRINTFORML You have a chat with %子供の名前%.
			PRINTFORML %子供の名前% reminisces about an old toy. 
		ENDIF
	ENDIF
