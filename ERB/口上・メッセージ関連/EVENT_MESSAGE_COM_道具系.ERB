; Modular ERB: EVENT_MESSAGE_COM_道具系.ERB
;-------------------------------------------------
;40,ローター
;-------------------------------------------------

@MESSAGE_COM40
CALL MESSAGE_COM40_TR
RETURN
IF FLAG:70 == 1
	PRINTFORM 시간이 멈춰있는 %조사처리(CALLNAME:TARGET,"의")%
	IF TEQUIP:0 & 4
		PRINTFORML 하반신에 %SHOW_BOTTOM(TARGET,3)% 위로 떨리는 로터를 밀어붙였다...
		RETURN 0
	ENDIF
	IF TEQUIP:0 & 2
		PRINTFORM %SHOW_BOTTOM(TARGET,2)%그것을 옆으로 치우고 노출시켰다.
	ELSEIF TEQUIP:0 & 1
		PRINTFORM %SHOW_BOTTOM(TARGET,1)%을 말아 올리고 노출시켰다.
	ENDIF
	;オトコ＋欲情のPALAMLV3以上
	IF !(TALENT:2 & 1) && (PALAM:欲情 >= PALAMLV:3)
		PRINTFORML 단단하게 발기된 %TINKO(TARGET)%에 떨리는 로터를 갖다 댔다...
		;オトコ
	ELSEIF !(TALENT:2 & 1)
		PRINTFORML %TINKO(TARGET)%떨리는 로터를 밀어붙였다...
		;ふたなり＋欲情のPALAMLV3以上
	ELSEIF (TALENT:2 & 3) == 3 && PALAM:欲情 >= PALAMLV:3
		PRINTL 질척한 비밀스러운 입술에 떨리는 로터를 대었다...
		;ふたなり
	ELSEIF (TALENT:2 & 3) == 3
		PRINTL 비밀스러운 입술에 떨리는 로터를 밀어붙였다...
		;欲情のPALAMLV3以上
	ELSEIF PALAM:欲情 >= PALAMLV:3
		PRINTL 단단하고 뾰족한 클리토리스에 떨리는 로터를 갖다 댔다...
	ELSE
		PRINTL 클리토리스에 떨리는 로터를 밀어붙였다...
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	PRINTFORM 자고 있는 %조사처리(CALLNAME:TARGET,"의")%
	IF TEQUIP:0 & 4
		PRINTFORML 하반신에 %SHOW_BOTTOM(TARGET,3)% 위로 떨리는 로터를 밀어붙였다...
		RETURN 0
	ENDIF
	IF TEQUIP:0 & 2
		PRINTFORM %SHOW_BOTTOM(TARGET,2)%그것을 치우고 노출시켰다.
	ELSEIF TEQUIP:0 & 1
		PRINTFORM %SHOW_BOTTOM(TARGET,1)%를 말아 올리고 노출시켰다
	ENDIF
	;オトコ＋欲情のPALAMLV3以上
	IF !(TALENT:2 & 1) && (PALAM:欲情 >= PALAMLV:3)
		PRINTFORML 단단하게 발기한 %TINKO(TARGET)%에 떨리는 로터를 밀어붙였다...
		;オトコ
	ELSEIF !(TALENT:2 & 1)
		PRINTFORML %TINKO(TARGET)%떨리는 로터를 눌러 붙였다...
		;ふたなり＋欲情のPALAMLV3以上
	ELSEIF (TALENT:2 & 3) == 3 && PALAM:欲情 >= PALAMLV:3
		PRINTL 질척한 비밀스러운 입술에 떨리는 로터를 대었다...
		;ふたなり
	ELSEIF (TALENT:2 & 3) == 3
		PRINTL 비밀스러운 입술에 떨리는 로터를 밀어붙였다...
		;欲情のPALAMLV3以上
	ELSEIF PALAM:欲情 >= PALAMLV:3
		PRINTL 단단하고 뾰족한 클리토리스에 떨리는 로터를 갖다 댔다...
	ELSE
		PRINTL 클리토리스에 떨리는 로터를 밀어붙였다...
	ENDIF
ELSE
	IF TEQUIP:0 & 4
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 하반신 위에 %SHOW_BOTTOM(TARGET,3)%의 위에서 떨리는 로터를 밀어붙였다...
		RETURN 0
	ENDIF
	IF TEQUIP:0 & 2
		IF TALENT:恋慕
			PRINTFORM 스스로 %SHOW_BOTTOM(TARGET,2)%를 치우고 준비하고 있다.
		ELSE
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고 노출시켰다.
		ENDIF
	ELSEIF TEQUIP:0 & 1
		IF TALENT:恋慕
			PRINTFORM 스스로 %SHOW_BOTTOM(TARGET,2)%를 들어 준비하고 있다.
		ELSE
			PRINTFORM %SHOW_BOTTOM(TARGET,1)%을 말아 올려 노출시켰다
		ENDIF
	ENDIF
	PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
	;オトコ＋欲情のPALAMLV3以上
	IF !(TALENT:2 & 1) && (PALAM:欲情 >= PALAMLV:3)
		PRINTFORML 단단하게 발기한 %TINKO(TARGET)%에 떨리는 로터를 밀어붙였다...
		;オトコ
	ELSEIF !(TALENT:2 & 1)
		PRINTFORML %TINKO(TARGET)%떨리는 로터를 밀어붙였다...
		;ふたなり＋欲情のPALAMLV3以上
	ELSEIF (TALENT:2 & 3) == 3 && PALAM:欲情 >= PALAMLV:3
		PRINTL 질척한 비밀스러운 입술에 떨리는 로터를 대었다...
		;ふたなり
	ELSEIF (TALENT:2 & 3) == 3
		PRINTL 비밀스러운 입술에 떨리는 로터를 밀어붙였다...
		;欲情のPALAMLV3以上
	ELSEIF PALAM:欲情 >= PALAMLV:3
		PRINTL 단단하고 뾰족한 클리토리스에 떨리는 로터를 갖다 댔다...
	ELSE
		PRINTL 클리토리스에 떨리는 로터를 밀어붙였다...
	ENDIF
ENDIF
;-------------------------------------------------
;41,Ｅマッサージャ
;-------------------------------------------------

@MESSAGE_COM41
CALL MESSAGE_COM41_TR
RETURN
IF FLAG:70 == 1
	PRINTFORML 시간을 멈춘%조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에 \@ TEQUIP:0 > 1 ? %SHOW_BOTTOM(TARGET)% 위에서 #  \@ 진동하는 전기 안마를 밀어붙였다.
	IF GETBIT(TALENT:性別,1)
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%만이 파르르 떨고 있다...
	ELSEIF NOWEX:Ｃ絶頂
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸은 꿈쩍도 하지 않으며 애액을 흩뿌리고 있다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 표정은 그대로 굳어버린 채 %조사처리(CALLNAME:MASTER,"에게")% 몸을 만지고 있다...
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	PRINTFORML 자고 있는%조사처리(CALLNAME:TARGET,"의")% 은밀한 곳을 \@ TEQUIP:0 > 1 ? %SHOW_BOTTOM(TARGET)% 위에서 #  \@ 진동하는 전기 안마기로 쓸어 올렸다.
	IF GETBIT(TALENT:性別,1)
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %TINKO(TARGET)%만이 벌벌 떨고 있다...
	ELSEIF NOWEX:Ｃ絶頂
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 애액을 흩뿌리면서 쾌락에 몸을 떨고 있다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 잠이 든 채 %조사처리(CALLNAME:MASTER,"에게")% 몸을 농락당하고 있다...
	ENDIF
ELSE
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 비밀스러운 곳에 \@ TEQUIP:0 > 1 ? %SHOW_BOTTOM(TARGET)% 위에서 #  \@ 진동하는 전기 안마기를 눌렀다
	PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
	IF GETBIT(TALENT:性別,1)
		PRINTFORM %TINKO(TARGET)%
	ELSE
		PRINTFORM 클리토리스
	ENDIF
	PRINT 느끼는 자극에,
	;Ｃ感覚LV3未満＋欲情のPALAMLV3未満
	IF ABL:Ｃ感覚 < 3 && PALAM:欲情 < PALAMLV:3
		PRINT 매우 간지러워하는 것 같다
		;Ｃ感覚LV3未満＋欲情のPALAMLV3以上
	ELSEIF ABL:Ｃ感覚 < 3 && PALAM:欲情 >= PALAMLV:3
		PRINT 아무 말도 할 수 없게 되어 있는 것 같아
		;恋慕か親愛＋Ｃ感覚LV4以上＋欲情のPALAMLV3未満
	ELSEIF TALENT:恋慕 && ABL:Ｃ感覚 >= 4 && PALAM:欲情 < PALAMLV:3
		PRINT 기다렸던 것처럼 다리를 벌리고 받아들이는 듯하다.
		;恋慕か親愛＋Ｃ感覚LV4以上＋欲情のPALAMLV3以上＋欲情のPALAMLV5未満
	ELSEIF TALENT:恋慕 && ABL:Ｃ感覚 >= 4 && PALAM:欲情 >= PALAMLV:3 && PALAM:欲情 < PALAMLV:5
		PRINTFORM 쾌락에 침을 흘리면서, 몇 번이고 %조사처리(CALLNAME:MASTER,"의")% 이름을 불렀다.
		;恋慕か親愛＋Ｃ感覚LV4以上＋欲情のPALAMLV5以上
	ELSEIF TALENT:恋慕 && ABL:Ｃ感覚 >= 4 && PALAM:欲情 >= PALAMLV:5
		PRINTFORM %조사처리(CALLNAME:MASTER,"를")% 껴안고 절정의 황홀감에 잠겨 있는 듯하다.
		;Ｃ感覚LV3以上＋欲情のPALAMLV3未満
	ELSEIF ABL:Ｃ感覚 >= 3 && PALAM:欲情 < PALAMLV:3
		PRINT 강한 쾌감에 얼굴을 붉히고 있는 듯하다.
		;Ｃ感覚LV3以上＋欲情のPALAMLV3以上＋欲情のPALAMLV5未満
	ELSEIF ABL:Ｃ感覚 >= 3 && PALAM:欲情 >= PALAMLV:3 && PALAM:欲情 < PALAMLV:5
		PRINT 흐트러진 눈으로 쾌락을 탐하는 듯하다.
		;Ｃ感覚LV3以上＋欲情のPALAMLV5以上
	ELSEIF ABL:Ｃ感覚 >= 3 && PALAM:欲情 >= PALAMLV:5
		PRINT 당장 절정에 도달할 것 같은 모습
	ENDIF
	PRINTL 다...
ENDIF
;-------------------------------------------------
;42,クリキャップ
;-------------------------------------------------

@MESSAGE_COM42
CALL MESSAGE_COM42_TR
RETURN
SIF FLAG:70 == 1
	PRINTFORM 시간이 멈춘
SIF CFLAG:MASTER:イタズラ == 2
	PRINTFORM 잠들어 있다
;解除時
IF !TEQUIP:クリキャップ
	PRINTFORML %CALLNAME:TARGET%에게서 전동 클립 캡을 벗긴다.
ELSE
	PRINTFORML %CALLNAME:TARGET%에 전동클리캡을 부착했다.
ENDIF
;-------------------------------------------------
;43,オナホール
;-------------------------------------------------

@MESSAGE_COM43
CALL MESSAGE_COM43_TR
RETURN
SIF FLAG:70 == 1
	PRINTFORM 시간이 멈춘
SIF CFLAG:MASTER:イタズラ == 2
	PRINTFORM 잠들어 있다
;解除時
IF !TEQUIP:オナホール
	PRINTFORML 오나홀을 %CALLNAME:TARGET%에서 빼냈다
ELSE
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%를 오나홀에 삽입했다.
ENDIF
;-------------------------------------------------
;44,バイブ
;-------------------------------------------------

@MESSAGE_COM44
CALL MESSAGE_COM44_TR
RETURN
IF FLAG:70 == 1
	;解除時
	IF !TEQUIP:バイブ
		PRINTFORML 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 질에서 꿈틀거리는 바이브를 천천히 빼냈다.
		PRINTFORML 바이브가 빠진 질 구멍은 입을 벌리고 폐쇄하며 상실감에 신음하고 있다...
	ELSEIF TCVAR:100 == MASTER
		PRINTFORML %CALLNAME:TARGET%에서 %TINKO(MASTER)%를 빼자 방금까지 범하고 있던 \@ TALENT:体型 < 0 ? 어린 여자 # 회음부 \@에 바이브를 대고 단번에 삽입했다
		PRINTFORML 시간을 멈춘 %조사처리(CALLNAME:TARGET,"는")% 저항하지 않고 바이브를 받아들이고 있다...
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
		;潤滑LV5以上でさらに追加
		SIF PALAM:潤滑 >= PALAMLV:5
			PRINT 듬뿍
		;潤滑LV3以上でさらに追加
		SIF PALAM:潤滑 >= PALAMLV:3
			PRINT 점액을 머금은
		;小柄体型
		IF TALENT:体型 < 0
			PRINT 어린 여자에게
		ELSE
			PRINT 틈에
		ENDIF
		PRINTL 바이브의 끝을 대고 익숙해지게 한다...
		PRINTFORM 시간을 멈출 수 있었다%CALLNAME:TARGET%
		;処女
		IF TALENT:処女 == 1
			PRINT 처녀를 무기질한 바이브로 빼앗기려 하고 있어도, 표정을 바꾸는 일은 없는 채 그대로였다.
			;Ｖ経験180以上
		ELSEIF EXP:Ｖ経験 > 180
			PRINT 개발이 완료된 질은 주어진 바이브를 삼키려고 입을 벌렸다.
			;Ｖ経験20以上
		ELSEIF EXP:Ｖ経験 > 20
			PRINT 개발된 질은 기대했던 대로 움츠러들었다.
			;それ以外
		ELSE
			PRINT 는 저항할 수 없게 되었다
		ENDIF
		PRINTL 하고 있다...
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% %SLIT(, 1)%에 바이브를 삽입했다
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	;解除時
	IF !TEQUIP:バイブ
		PRINTFORML 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% 질에서 꿈틀거리는 바이브를 천천히 빼냈다.
		PRINTFORML 바이브가 빠진 질구는 입을 열었다 닫으며 상실감에 신음하고 있다...
	ELSEIF TCVAR:100 == MASTER
		PRINTFORML %CALLNAME:TARGET%에서 %TINKO(MASTER)%를 빼내자 방금까지 범하고 있던 \@ TALENT:体型 < 0 ? 어린 여자 # 회음부 \@에 바이브를 대고 단번에 삽입했다.
		PRINTFORML 자고 있는 %조사처리(CALLNAME:TARGET,"는")% 어쩔 도리 없이 바이브를 받아들이고 있다…
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
		;潤滑LV5以上でさらに追加
		SIF PALAM:潤滑 >= PALAMLV:5
			PRINT 듬뿍
		;潤滑LV3以上でさらに追加
		SIF PALAM:潤滑 >= PALAMLV:3
			PRINT 점액을 머금은
		;小柄体型
		IF TALENT:体型 < 0
			PRINT 어린 여자에게
		ELSE
			PRINT 틈에
		ENDIF
		PRINTL 바이브의 끝을 대고 익숙해지게 한다...
		PRINTFORM 잠들어 있는 %CALLNAME:TARGET%
		;処女
		IF TALENT:処女 == 1
			PRINT 처녀를 무기질적인 바이브로 빼앗기려 하고 있어도, 잠든 채 내버려 두었다.
			;Ｖ経験180以上
		ELSEIF EXP:Ｖ経験 > 180
			PRINT 개발이 끝난 질은 주어진 바이브를 삼키려고 입을 벌렸다.
			;Ｖ経験20以上
		ELSEIF EXP:Ｖ経験 > 20
			PRINT 개발된 질은 기대한 대로 움츠러들었다.
			;それ以外
		ELSE
			PRINT 는 저항할 수 없어 마음대로 되었다.
		ENDIF
		PRINTL 하고 있다...
		PRINTFORM %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")%
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 흠뻑 젖은
		PRINTFORML 성기에 바이브를 삽입했다.
	ENDIF
ELSE
	;解除時
	IF !TEQUIP:バイブ
		PRINTFORML %CALLNAME:TARGET%에서 꿈틀거리는 바이브를 천천히 뽑았다.
		;Ｖ経験200以上＋恋慕か親愛
		IF EXP:Ｖ経験 > 200 && TALENT:恋慕
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")%, 질 안의 상실감에 견디지 못하고 눈물과 침을 흘리며
			;Ｖ経験150以上＋恋慕か親愛
		ELSEIF EXP:Ｖ経験 > 150 && TALENT:恋慕
			PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 질 내에 고여 있던 점액이 짜내지며 떨어져 물웅덩이를 만들었다.
			;Ｖ経験120以上＋恋慕か親愛
		ELSEIF EXP:Ｖ経験 > 120 && TALENT:恋慕
			PRINTFORM 바이브가 빠진 %조사처리(CALLNAME:TARGET,"의")% 살결에서 사랑액이 주르륵 떨어졌다.
			;Ｖ経験70以上＋恋慕か親愛
		ELSEIF EXP:Ｖ経験 > 70 && TALENT:恋慕
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 머뭇거리며 다리를 비비고 %CALLNAME:MASTER%쪽을 보았다.
			;Ｖ経験40以上
		ELSEIF EXP:Ｖ経験 > 40 && TALENT:恋慕
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 뜨거운 숨을 내쉬며
			;Ｖ経験20以上
		ELSEIF EXP:Ｖ経験 > 20
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 느슨해진 질 입구를 움찔거리게 한다.
			;それ以外
		ELSE
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 안도한 듯한 표정을 지었다.
		ENDIF
		PRINTL 하고 있다...
	ELSEIF TCVAR:100 == MASTER
		PRINTFORML %CALLNAME:TARGET%에서 %TINKO(MASTER)%를 빼내자 방금까지 범하고 있던 \@ TALENT:体型 < 0 ? 어린 여자 # 비밀처 \@에 바이브를 대고 한 번에 삽입했다.
		IF EXP:Ｖ経験 > 100
			IF TALENT:恋慕
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 순간 항의하는 듯한 시선을 보냈지만, 이내 바이브가 주는 쾌감에 녹아\@ TALENT:体型 < 0 ? 귀여운 # 요염한 \@ 신음을 터뜨리기 시작했다…
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 순간 안도하는 표정을 지었으나, 곧 바이브가 가져오는 쾌감에 녹아\@ TALENT:体型 < 0 ? 귀여운 # 요염한 \@신음을 내기 시작했다…
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 바이브가 가져오는 쾌감에 녹아\@ TALENT:体型 < 0 ? 귀여운 # 요염한 \@신음을 내면서도, %조사처리(CALLNAME:MASTER,"의")% 가랑이에 뜨거운 시선을 던지고 있다…
		ELSEIF EXP:Ｖ経験 > 20
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 바이브가 가져다주는 쾌감에 녹아\@ TALENT:体型 < 0 ? 귀여운 # 요염한 \@신음을 내고 있다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 익숙하지 않은 바이브의 자극에 몸을 비틀며 신음하고 있다...
		ENDIF
	ELSE
		SIF ABL:Ｖ感覚 >= 4 && TALENT:淫乱
			PRINT 허리를 들고 애원하고 있다.
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
		;潤滑LV5以上でさらに追加
		SIF PALAM:潤滑 >= PALAMLV:5
			PRINT 듬뿍
		;潤滑LV3以上でさらに追加
		SIF PALAM:潤滑 >= PALAMLV:3
			PRINT 점액을 머금은
		;小柄体型
		IF TALENT:体型 < 0
			PRINT 어린 여자에게
		ELSE
			PRINT 틈에
		ENDIF
		PRINTL 바이브의 끝을 대고 익숙해지게 해간다...
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
		;処女＋淫乱か娼婦
		IF TALENT:処女 == 1 && TALENT:淫乱
			PRINT 자신이 처녀라는 것을 잊고 있는 듯한 미소를 지었다.
			;処女＋恋慕か親愛
		ELSEIF TALENT:処女 == 1 || (TALENT:処女 == -1) && TALENT:恋慕
			PRINTFORM 조금 쓸쓸해 보이는 눈으로 %조사처리(CALLNAME:MASTER,"를")% 봤다.
			;処女＋淫乱
		ELSEIF TALENT:処女 == 1 && TALENT:淫乱
			PRINT 처녀라는 것도 상관없이, 허리를 흔들며 애원했다.
			;処女＋一線越えない
		ELSEIF TALENT:処女 == 1 || (TALENT:処女 == -1) && TALENT:一線越えない
			PRINT 무언가를 포기한 표정으로 눈에 희미하게 눈물을 머금었다.
			;処女
		ELSEIF (TALENT:処女 == 1 || TALENT:処女 == -1)
			PRINT 바들바들 떨며 상실의 공포에 떨었다
			;Ｖ経験200以上＋淫乱か娼婦
		ELSEIF EXP:Ｖ経験 > 200 && TALENT:淫乱
			PRINT 삽입에 대한 기대만으로도 가쿠가쿠 떨며 갈 것 같았다.
			;Ｖ経験150以上＋淫乱か娼婦
		ELSEIF EXP:Ｖ経験 > 150 && TALENT:淫乱
			PRINTFORM 녹아내린 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보며 스스로 음순을 비볐다.
			;Ｖ経験120以上＋淫乱か娼婦
		ELSEIF EXP:Ｖ経験 > 120 && TALENT:淫乱
			PRINT 황홀한 표정으로 기다리지 못하고 허리를 비틀었다.
			;Ｖ経験70以上＋淫乱か娼婦
		ELSEIF EXP:Ｖ経験 > 70 && TALENT:淫乱
			PRINTFORM 무언가 원하는 듯 눈을 촉촉하게 %CALLNAME:MASTER%쪽을 본다.
			;Ｖ経験40以上
		ELSEIF EXP:Ｖ経験 > 40
			PRINT 바이브가 스치는 감촉에 도취된 듯 한숨을 내쉬었다.
			;Ｖ経験20以上
		ELSEIF EXP:Ｖ経験 > 20
			PRINT 바이브가 스치는 감촉에 몸을 비틀며 애액을 배어 나왔다.
			;それ以外
		ELSE
			PRINT 바이브가 스치는 감촉에 살집을 움츠리게 했다
		ENDIF
		PRINTL 하고 있다...
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 흠뻑 젖은
		PRINTFORML 성기에 바이브를 삽입했다.
	ENDIF
ENDIF
