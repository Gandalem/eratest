;45,アナルバイブ
;-------------------------------------------------

@MESSAGE_COM45
CALL MESSAGE_COM45_TR
RETURN
IF FLAG:70 == 1
	IF !TEQUIP:アナルバイブ
		PRINTFORML 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 애널바이브를 천천히 빼냈다.
		SELECTCASE EXP:Ａ経験
			CASE IS > 180
				PRINTFORML 애널바이브를 뽑힌 항문은 움찔거리며 욕망하는 듯하다...
			CASE 20 TO 179
				PRINTFORML 애널바이브를 빼앗긴 항문은 완전히 닫히지 않고 작게 입을 벌리고 있다…
			CASEELSE
				PRINTFORML 애널바이브를 뽑힌 항문은 아프게 부어올라 있다...
		ENDSELECT
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
		PRINTFORML 국문에 애널바이브를 갖다 댔다...
		PRINTFORM 시간을 멈출 수 있었다 %CALLNAME:TARGET%
		;Ａ経験180以上
		IF EXP:Ａ経験 > 180
			PRINT 개발이 완료된 항문은, 주어진 바이브를 삼키려 했다.
			;Ａ経験20以上
		ELSEIF EXP:Ａ経験 > 20
			PRINT 개발된 항문은 기대한 대로 움찔했다.
			;それ以外
		ELSE
			PRINT 는 저항할 수 없어 마음대로 되었다.
		ENDIF
		PRINTL 하고 있다...
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORML 항문에 바이브를 삽입했다.
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	IF !TEQUIP:アナルバイブ
		PRINTFORML 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% 항문에서 애널바이브를 천천히 빼냈다.
		SELECTCASE EXP:Ａ経験
			CASE IS > 180
				PRINTFORML 애널바이브를 빼앗긴 항문은 움찔거리며 무언가를 갈망하고 있다...
			CASE 20 TO 179
				PRINTFORML 애널바이브를 빼앗긴 항문은 완전히 닫히지 않고, 작게 입을 벌리고 있다...
			CASEELSE
				PRINTFORML 애널바이브를 뽑힌 항문은 아프게 부어올라 있다...
		ENDSELECT
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
		PRINTFORML 국문에 애널바이브를 갖다 붙였다...
		PRINTFORM 자고 있는 %CALLNAME:TARGET%
		;Ａ経験180以上
		IF EXP:Ａ経験 > 180
			PRINT 개발이 완료된 항문은, 주어진 바이브를 삼키려 했다.
			;Ａ経験20以上
		ELSEIF EXP:Ａ経験 > 20
			PRINT 개발된 항문은 기대했던 대로 움찔거렸다.
			;それ以外
		ELSE
			PRINT 는 잠이 들면서 제멋대로 되었다.
		ENDIF
		PRINTL 하고 있다...
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORML 항문에 바이브를 삽입했다.
	ENDIF
ELSE
	;解除時
	IF !TEQUIP:アナルバイブ
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 항문에서 애널바이브를 빼냈다.
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
		;Ａ経験180以上＋淫乱か娼婦
		IF EXP:Ａ経験 > 180 && TALENT:淫乱
			PRINTFORM 비침과 입에서 침을 흘리며, %HIP(TARGET)%를 계속 벌리고 있어
			;Ａ経験140以上＋淫乱か娼婦
		ELSEIF EXP:Ａ経験 > 140 && TALENT:淫乱
			PRINT 촉촉한 눈으로 간청하듯이 엉덩이를 흔들었다
			;Ａ経験100以上＋淫乱か娼婦
		ELSEIF EXP:Ａ経験 > 100 && TALENT:淫乱
			PRINTFORM 아쉬운 듯이 %HIP(TARGET)%을 내밀었다.
			;Ａ経験70以上＋淫乱か娼婦
		ELSEIF EXP:Ａ経験 > 70 && TALENT:淫乱
			PRINTFORM 조금 아쉬운 듯이 %HIP(TARGET)%을 흔들며
			;Ａ経験40以上
		ELSEIF EXP:Ａ経験 > 40
			PRINT 엉덩이를 꿈틀거리면서도 어딘가 안심한 표정을 지었다.
			;Ａ経験20以上
		ELSEIF EXP:Ａ経験 > 20
			PRINT 강제적인 배출감에 홍조를 띠다
			;それ以外
		ELSE
			PRINT 자극에 괴로워하는 표정으로 견뎌
		ENDIF
		PRINTFORML 하고 있다...
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
		PRINTFORML 국문에 애널바이브를 갖다 대었다...
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
		;Ａ経験180以上＋淫乱か娼婦
		IF EXP:Ａ経験 > 180 && TALENT:淫乱
			PRINTFORM 녹아내린 표정으로, 자신의 %HIP(TARGET)%을 펼치다
			;Ａ経験140以上＋淫乱か娼婦
		ELSEIF EXP:Ａ経験 > 140 && TALENT:淫乱
			PRINT 삽입을 애타게 기다리듯이 허리를 굽히고
			;Ａ経験100以上＋淫乱か娼婦
		ELSEIF EXP:Ａ経験 > 100 && TALENT:淫乱
			PRINTFORM 뺨을 물들여, %HIP(TARGET)%를 기대에 흔들리게 했다.
			;Ａ経験70以上＋淫乱か娼婦
		ELSEIF EXP:Ａ経験 > 70 && TALENT:淫乱
			PRINT 수축하는 곳에 주어지는 바이브의 자극에 몸을 떨었다.
			;Ａ経験40以上
		ELSEIF EXP:Ａ経験 > 40
			PRINT 기대와 부정이 뒤섞인 듯한 복잡한 표정을 하고
			;Ａ経験20以上
		ELSEIF EXP:Ａ経験 > 20
			PRINT 부끄러움으로 물든 얼굴을 숙이고
			;それ以外
		ELSE
			PRINT 부정한 구멍을 침범당하는 치욕과 굴욕감에 휩싸인 표정을 하고
		ENDIF
		PRINTL 하고 있다...
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORML 항문에 바이브를 삽입했다.
	ENDIF
ENDIF
