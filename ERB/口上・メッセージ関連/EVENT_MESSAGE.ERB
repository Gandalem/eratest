	LOCALS = とても{EXP:ARG:出産経験}人産んだとは思えない
ELSEIF !RAND:5 && TALENT:ARG:バストサイズ > 0
	LOCALS = 元気な子を産んでくれそうな
ENDIF
IF TALENT:ARG:体型 == -2
	SELECTCASE RAND:2
		CASE 0
			LOCALS += "小さなすべすべのお尻"
		CASE 1
			LOCALS += "可愛らしい尻"
	ENDSELECT
ELSEIF TALENT:ARG:バストサイズ < 0
	SELECTCASE RAND:3
		CASE 0
			LOCALS += "肉付きの薄い尻"
		CASE 1
			LOCALS += "スラリとした尻"
		CASE 2
			LOCALS += "小ぶりの尻"
	ENDSELECT
ELSEIF TALENT:ARG:バストサイズ - CFLAG:ARG:乳ランクアップ > 0
	SELECTCASE RAND:5
		CASE 0
			LOCALS += "安産型の尻"
		CASE 1
			LOCALS += "肉付きのよい尻"
		CASE 2
			LOCALS += "たっぷりとした尻"
		CASE 3
			LOCALS += "むっちりとした尻"
		CASE 4
			LOCALS += "豊満な尻"
	ENDSELECT
ELSE
	SELECTCASE RAND:5
		CASE 0
			IF CFLAG:ARG:乳ランクアップ
				LOCALS += "妊娠して丸みを増した尻"
			ELSE
				LOCALS += "美しく引き締まった尻"
			ENDIF
		CASE 1
			LOCALS += "剥きたての卵のような尻"
		CASE 2
			LOCALS += "ハリのある尻"
		CASE 3
			LOCALS += "吸いつくような手触りの尻"
		CASE 4
			LOCALS += "瑞々しい尻"
	ENDSELECT
ENDIF
RETURNF LOCALS
