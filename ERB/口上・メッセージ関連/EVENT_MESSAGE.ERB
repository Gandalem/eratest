;概　要:寝起き着替え地の文
;引　数:ARG=TARGET
;戻り値:
;備　考:
;-------------------------------------------------

@寝起き着替え(ARG)
IF 睡眠時間(ARG) && !CFLAG:ARG:眠姦発覚
	IF ARG && TALENT:ARG:恋慕 && !GETBIT(CFLAG:ARG:着替え実行, 1) && CFLAG:MASTER:現在位置 == CFLAG:ARG:現在位置 && MAIN_MAP == GET_MAPID(CFLAG:MASTER:現在位置)
		PRINTFORM %CALLNAME:ARG%는 %HIS_HER(ARG)% 수면복으로 변한다.
		IF TALENT:ARG:恋人
			PRINTFORM 천천히 그리고 관능적으로 그것을 하며 보여준다.
			;気弱系
		ELSEIF CFLAG:ARG:性格傾向 == 1
			PRINTFORM  당신이 쳐다볼까 봐 걱정했다
			;強気系
		ELSEIF CFLAG:ARG:性格傾向 == 2
			PRINTFORM  자랑스럽고 위엄 있게
			;素直系
		ELSEIF CFLAG:ARG:性格傾向 == 3
			PRINTFORM  미소를 지으며
			;真面目系
		ELSEIF CFLAG:ARG:性格傾向 == 4
			PRINTFORM  당신에게서 등을 돌린 채로
			;その他
		ELSEIF CFLAG:ARG:性格傾向 == 5
			PRINTFORM  단호한 표정으로
		ENDIF
		PRINTFORML  잠자리에 들기 전에.
	ENDIF
	SETBIT CFLAG:ARG:着替え実行, 1
	CLEARBIT CFLAG:ARG:着替え実行, 0
ELSE
	IF ARG && TALENT:ARG:恋慕 && !GETBIT(CFLAG:ARG:着替え実行, 0) && CFLAG:MASTER:現在位置 == CFLAG:ARG:現在位置 && MAIN_MAP == GET_MAPID(CFLAG:MASTER:現在位置)
		PRINTFORM %CALLNAME:ARG%은/는 %HIS_HER(ARG)% 캐주얼 복장으로 바뀐다
		IF TALENT:ARG:恋人
			PRINTFORM 그것을 느리고 관능적으로 하며 자랑한다.
			;気弱系
		ELSEIF CFLAG:ARG:性格傾向 == 1
			PRINTFORM  당신이 쳐다볼까 봐 걱정했다.
			;強気系
		ELSEIF CFLAG:ARG:性格傾向 == 2
			PRINTFORM  자랑스럽고 위엄 있게
			;素直系
		ELSEIF CFLAG:ARG:性格傾向 == 3
			PRINTFORM  어색하게 미소 지으며
			;真面目系
		ELSEIF CFLAG:ARG:性格傾向 == 4
			PRINTFORM  당신에게서 등을 돌린 채로
			;その他
		ELSEIF CFLAG:ARG:性格傾向 == 5
			PRINTFORM  단호한 표정으로
		ENDIF
		PRINTFORML .
	ENDIF
	SETBIT CFLAG:ARG:着替え実行, 0
	CLEARBIT CFLAG:ARG:着替え実行, 1
ENDIF
RETURN ARG
