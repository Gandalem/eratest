@M_KOJO_JP01_EVENT_K120_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「아, %CALLNAME:MASTER%씨!」
		PRINTFORMW 아운은 당신을 보며 환하게 웃고 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「아, %CALLNAME:MASTER%씨!」
		PRINTFORMW 아운은 당신을 보며 환하게 웃고 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「아, %CALLNAME:MASTER%씨. 정말 우연이네요ー!」
		PRINTFORMW 아운은 자신의 놀라움을 과장하고 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1 ;custom code
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORMW 「아, %CALLNAME:MASTER%-상... 아.」
		PRINTFORML 「...다른 사람이 당신과 함께 있는 것 같네요.」
		PRINTFORMW Aunn은 들리지 않게 혼잣말을 중얼거렸다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;朝起きたとき（おはよう口上）
;==================================================

