@M_KOJO_JP01_MESSAGE_COM_K120_DANMAKU(ARGS, ARG)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_JP01_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1 ;custom code
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「A 단막 매치다! 그럼 내가 상대가 되어주마!」
		PRINTFORMW A운이 둘로 갈라지며 자신 주변으로 벚꽃 탄환을 난사한다.
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGET被弾、残り残機3（【洽覧深識】持ちのみ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘中" && ARG == 3
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGET被弾、残り残機2
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘中" && ARG == 2
		PRINTFORML 「후후훗, 그리고 이걸 더 넘어서 가볼 거다ー!」
		PRINTFORMW 『스트레이 독의 워크』!」
		PRINTFORMW 분홍색으로 길게 늘어진 탄환들이 당신의 사각에서 달려온다...!
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGET被弾、残り残機1
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘中" && ARG == 1
		PRINTFORML 「에이, 내 필살기야! 『웅크리고 죽어』!」
		PRINTFORML 난 이걸 시간 초과시키도록 두지 않을 거야ー!」
		PRINTFORMW 복잡하게 물결치는 레이저들이 너에게 다가온다!
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGET被弾、残り残機0
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘中" && ARG == 0
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;TARGETの残機4（【洽覧深識】持ちのみ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" && ARG == 4
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;TARGETの残機3
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" && ARG == 3
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;TARGETの残機2
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" && ARG == 2
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;TARGETの残機1
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" && ARG == 1
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;TARGETの残機0
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" && ARG == 0
	ENDIF
	;-------------------------------------------------
	;敗北後
	;TARGETの残機が2以上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "敗北後" && ARG == 0
		PRINTFORML 이번엔 이길 것 같아!
		PRINTFORML 결국 수호자 괴물이니까 당연한 거잖아ー!
		PRINTFORMW 아운이 정말 승리감에 찬 표정을 짓는다.
	ENDIF
	;-------------------------------------------------
	;敗北後
	;TARGETの残機が2以上、罵倒コメ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "罵倒コメ"
		PRINTFORML 「...안 돼, 정말 아슬아슬했어!」
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")%(는) 정말 강하네~!」
		PRINTFORMW Aunn은 별로 설득력이 없어 보인다...
	ENDIF
	;-------------------------------------------------
	;敗北後
	;TARGETの残機が1
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "敗北後" && ARG == 2
		PRINTFORML 이번엔 이길 것 같아!
		PRINTFORML 결국 수호자 괴물이니까 당연한 거잖아ー!
		PRINTFORMW 아운이 정말 승리감에 찬 표정을 짓는다.
	ENDIF
	;-------------------------------------------------
	;勝利後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "勝利後"
		PRINTFORML 「우와ー 포기할게요—!! 무슨 힘이야...」
		PRINTFORML %CALLNAME:MASTER%-상은 어쩌면 수호자 비스트가 되는 것에 관심이 있나요?」
		PRINTFORMW 아운은 당신을 존경스럽게 바라봤다.
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
