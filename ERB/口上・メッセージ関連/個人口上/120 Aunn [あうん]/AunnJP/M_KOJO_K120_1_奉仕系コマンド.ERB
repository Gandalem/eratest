;80,手淫
;==================================================

@M_KOJO_JP01_MESSAGE_COM_K120_80
CALL M_KOJO_JP01_MESSAGE_COM_K120_80_1
RETURN RESULT

@M_KOJO_JP01_MESSAGE_COM_K120_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「...내 손을 쓰길 원해?」
		PRINTFORMW 「상관없어. 만약 %CALLNAME:MASTER%님이 그렇게 하신다면, 나는 그렇게 할게.」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 당신은 원하는 만큼 얼어붙은 아운의 얼굴에 자신의 것을 비빈다...
		RETURN 1
	ELSE
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			PRINTFORML 「...」
			PRINTFORMW 아운은 사정 직전의 당신의 성기를 완전히 몰입해서 바라본다...
		ELSE
			PRINTFORML 「……아아, 무슨 말 했어?」
			PRINTFORMW 아운은 계속 당신을 만지고 있고, 그녀의 눈은 육욕적인 욕망으로 흐릿해진다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_JP01_MESSAGE_COM_K120_81
CALL M_KOJO_JP01_MESSAGE_COM_K120_81_1
RETURN RESULT

@M_KOJO_JP01_MESSAGE_COM_K120_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「...」
		PRINTFORMW 언는 반응하지 않고 대신 당신의 거친 것을 깊숙이 입에 넣는다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORML 당신은 얼어붙은 아운의 입속으로 자신의 성기를 밀어 넣는다...
		PRINTFORMW 그녀의 혀가 응답하는 것처럼 움직이는 듯한 느낌이 든다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「후루룩... 후우읍...」
		PRINTFORMW 아운은 마치 빙의라도 된 것처럼 탐욕스럽게 네 것을 빨아들인다....
		IF NOWEX:PLAYER:射精
			CALL HPH_PRINT,@"「………………………HPH」","L"
			PRINTFORMW 아운의 새까맣고 흐릿한 눈은 정복감으로 일그러진다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
