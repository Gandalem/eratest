;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K120
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;Pain Mark
;苦痛刻印
IF FLAG:70 == 1
	;
ELSE
	SELECTCASE TFLAG:22
		CASE 1
			PRINTFORML 「T-아파요, %CALLNAME:MASTER%씨...」
			PRINTFORMDW 언은 눈썹을 찌푸리며 당신에게 멈춰 달라고 애원한다...
		CASE 2
			PRINTFORML 「흐윽... 흐아앙... %CALLNAME:MASTER%-씨!!」
			PRINTFORMDW 아운은 고통에 비명을 지르며 눈가에 눈물을 글썽인다.
			PRINTFORML 「왜 나를 다치게 하는 거야? 그만해 주...」
			PRINTFORMDW 그녀는 당신에게서 몸을 피하며 격렬하게 멈춰달라고 애원한다...
		CASE 3
			PRINTFORMDW 아운은 고통으로 비명을 지르며 당신에게서 벗어나려 몸을 뒤틀었다.
			PRINTFORML 「크윽... 왜? 내가 너한테 무슨 잘못을 했는데? 멈추라고 말했었는데...」
			PRINTFORMDW 그녀는 눈가에 맺힌 눈물을 흘리며 눈을 질끈 감았다.
			PRINTFORML 「흐읍... 모르겠어... 왜... %CALLNAME:MASTER%-상?」
			IF TALENT:恋人
				PRINTFORML 「에-네가 나를 사랑한다고 말했음에도—흑—」
			ENDIF
			PRINTFORMDW 그녀의 몸은 고통과 공포로 떨리고, 그녀는 자신을 감싸 안기 위해 공처럼 웅크린다...
	ENDSELECT
ENDIF
;Rape Mark
;時姦刻印
SELECTCASE TFLAG:時姦刻印取得
	CASE 1
		;
	CASE 2
		;
	CASE 3
		;
ENDSELECT
;Pleasure Mark
;快楽刻印
IF !FLAG:70
	SELECTCASE TFLAG:23
		CASE 1
			PRINTFORML 「%MOAN(,2)%!」
			PRINTFORMDW 아운은 즐거움이 몸을 타고 흐르자 꿈틀거렸다.
			PRINTFORML 「하아... %CALLNAME:MASTER%-상...」
			PRINTFORMDW 그녀는 조심스럽게 당신을 부르며 당신의 온기를 찾았다...
		CASE 2
			PRINTFORML 「%SLUR(MOAN("m",2),-2)%!」
			PRINTFORMDW 아운은 그녀의 몸을 사로잡는 쾌감에 몸부림치며 꿈틀거린다.
			PRINTFORML 「%MOAN(,2)%... %CALLNAME:MASTER%-s..san...」
			PRINTFORMDW 그녀는 당신을 부르지만, 시선은 초점이 없고 숨소리는 거칠었다...
		CASE 3
			PRINTFORML 「%SLUR(MOAN("h",4),-2)%!!」
			PRINTFORMDW 아운은 눈을 크게 뜨고 몸속에서 들끓는 강렬한 쾌감과 씨름한다.
			PRINTFORML 「%MOAN("m",4)%... %CALLNAME:MASTER%-상~♥...」
			PRINTFORMDW 당신은 그녀의 머리를 쓰다듬어주고 쉬고 진정할 시간을 준다.
			PRINTFORMDW 휴식이 그녀에게는 좋지만, 곧 진정하는 것이 더 이상 선택지가 아님을 깨닫는다.
			PRINTFORML 「하아... 더... 더... %CALLNAME:MASTER%-상. 더~♥♥♥!」
			PRINTFORMDW 아운은 자신을 당신에게 파고들며 굶주린 짐승처럼 당신을 흘겨본다...
	ENDSELECT
ENDIF
;Lewd Mark
;11, 12, 13 = when earned through Pleasure gems
;31, 32, 33 = when earned through Loyalty and Submission gems
;不埒刻印
;快楽による刻印
;屈服、恭順による刻印
IF !FLAG:70
	SELECTCASE TFLAG:24
		CASE 11, 31
			;LV1
		CASE 12, 32
			;LV2
		CASE 13, 33
			;LV3
	ENDSELECT
ENDIF
;Hate Mark
;反発刻印
IF !FLAG:70
	SELECTCASE TFLAG:21
		CASE 1
			;
		CASE 2
			;
		CASE 3
			;
	ENDSELECT
ENDIF
