					CASE 2
						PRINTFORML 「%MOAN()%...」
						PRINTFORMDW 아운은 달콤한 숨을 내쉬며 유혹적으로 당신에게 눈짓한다...
				ENDSELECT
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
