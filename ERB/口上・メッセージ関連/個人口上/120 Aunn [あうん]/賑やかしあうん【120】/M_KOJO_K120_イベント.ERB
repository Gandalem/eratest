@M_KOJO_EVENT_K120_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「헤이, %CALLNAME:MASTER%-상!」
					PRINTFORMDW 아운은 갑자기 행동을 취하며 환하게 당신을 바라본다.
					PRINTFORML 「같이 어딘가에 가고 싶어...?」
					PRINTFORMDW 그녀는 유혹적으로 눈을 깜빡인다.
					PRINTFORML 「우리... 있잖아... 연인으로서 시간을 보내면 안 될까?」
					PRINTFORMDW 아운은 '연인'이라는 단어에 힘을 주며 얼굴을 붉히고 말을 더듬는다.
				ELSEIF TALENT:恋慕
					PRINTFORML 「아-아... %CALLNAME:MASTER%-상... 음...」
					PRINTFORMDW Aunn은 안절부절못하며 적절한 말을 찾으려 애쓰다가 결국 침묵한다.
					PRINTFORMDW ...
					PRINTFORMDW 그녀는 고개를 저으며 혼잣말을 중얼거리고 심호흡을 했다.
					PRINTFORML 「데이트 가자!」
					PRINTFORMDW 아운은 반짝이는 눈으로 당신에게 주먹을 불끈 쥐어 보인다...
				ELSE
					PRINTFORML 「이봐, 재미있는 거 하자!」
					PRINTFORMDW 아운은 발걸음에 생기를 담아 당신을 부른다.
					PRINTFORML 「나 같은 보잘것없는 코마이누를 위해 시간 좀 내줄 수 있지?」
					PRINTFORMDW 그녀는 기대감에 환하게 웃는다...
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMDW 아운은 얼굴 가득 크고 들뜬 미소를 지으며 이전보다 훨씬 더 환하게 빛난다.
					PRINTFORML 「에헤헤～... 연인들~... 데이트~...」
					PRINTFORMDW 그녀는 주도권을 잡으면서 즉시 자신만의 행복한 작은 세계로 빠져든다...
				ELSEIF TALENT:恋慕
					PRINTFORMDW 아운은 안도하며 당신을 향해 만족스럽게 고개를 끄덕인다.
					PRINTFORML 「그럼 당장 가자!」
					PRINTFORMDW 그녀는 경쾌한 미소로 신나게 앞장서 나간다...
				ELSE
					PRINTFORML 「휴, 그럼 시간 낭비하지 말자!」
					PRINTFORMDW 아운은 당신이 자신을 위해 시간을 내줄 수 있다는 사실에 안도한다...
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMDW 아운은 거절당해 마음이 아파 시선을 내린다.
					PRINTFORML 「...알겠어.」
					PRINTFORMDW 처음에는 울상을 지었지만, 금세 다시 기운을 차린다.
					PRINTFORML 「그럼, 다음엔 꼭이야! 시간이 얼마나 걸리든 계속 물어볼 거야!」
					PRINTFORMDW 그녀의 불타는 결의가 느껴진다...
				ELSEIF TALENT:恋慕
					PRINTFORMDW 아운은 어깨를 축 늘어뜨리고 땅바닥의 작은 돌을 찬다.
					PRINTFORML 「좋아... 그럼 다음엔...」
					PRINTFORMDW 그녀는 당황한 표정이었지만, 그런 태도에도 불구하고 너무 심각하게 받아들이지는 않는 듯했다...
				ELSE
					PRINTFORML 「알았어. 다음에 또 보자, 아마도.」
					PRINTFORMDL 언은 조금 실망한 표정을 짓는다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMDW 아운이 네 소매를 잡아당기며 자기 방 쪽으로 고개를 끄덕인다.
					PRINTFORML 「안에 들어가 볼래...?」
					PRINTFORMDW 그녀의 얼굴은 상기되어 있고 시선은 노골적으로 장난스럽다.
					PRINTFORML 「우리 둘만 있는 곳...?」
					PRINTFORMDW 아운이 머리카락을 만지작거리며 시선을 피한다...
				ELSE
					PRINTFORML 「내 곳으로 가자, %CALLNAME:MASTER%-상!」
					PRINTFORMDW 아운은 당신을 자신의 방 쪽으로 밀어붙인다.
					PRINTFORML 「거기에서는 방해받지 않을 테니까--」
					PRINTFORMDW 그녀는 갑자기 멈추고 얼굴이 새빨개진다.
					PRINTFORML 「아, 하지만 그건...」
					PRINTFORMDW 아운은 갈등하는 듯 보이며 당신과 문 사이를 번갈아 본다.
					PRINTFORML 「하지만, 괜찮지 않아...?」
					PRINTFORMDW 그녀는 나지막이 무언가를 중얼거린 후 다시 당신 쪽으로 돌아선다.
					PRINTFORMW 「그럼... 안으로 들어오고 싶어?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「그럼, 안으로 들어가자...」
					PRINTFORMDW 아운은 당신을 안으로 이끌고, 그녀의 홍조는 더욱 강해졌다...
				ELSE
					PRINTFORML 「오-알겠어. 그럼...」
					PRINTFORMDW 언느가 당신을 안으로 이끌고 들어간다. 그녀는 문을 등 뒤에서 닫으며 불안감을 키운다...
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「흥, 원하지 않아?」
					PRINTFORMDW 아운은 실망한 듯 한숨을 쉬지만, 크게 신경 쓰지는 않는 것 같다.
					PRINTFORMW 「뭐, 내 방이 결국 좀 지루하긴 하네.」
				ELSE
					PRINTFORML 「아... 아니, 네 말이 맞다.」
					PRINTFORMDW 아운은 불만스러워 보였지만, 그 외에는 별로 신경 쓰일 일은 없었다...
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
