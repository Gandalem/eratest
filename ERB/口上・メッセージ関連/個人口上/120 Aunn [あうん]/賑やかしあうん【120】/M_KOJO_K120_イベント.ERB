@M_KOJO_EVENT_K120_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF MARK:反発刻印
			PRINTFORMDW 아운은 당신을 알아보고 입술을 삐죽 내밀고 팔짱을 낀 채 시선을 피한다...
		ELSE
			PRINTFORML 「아, %CALLNAME:MASTER%-상!」
			PRINTFORMDW 아운이 당신을 향해 미소 짓는다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF MARK:反発刻印
			PRINTFORMDW 아운은 당신이 여기에 있다는 것을 깨닫고 몇 걸음 뒤로 물러난다.
			PRINTFORMDW 그녀는 주변을 둘러보더니 다시 떠날까 생각하는 듯하다...
		ELSE
			PRINTFORML 「아, %CALLNAME:MASTER%씨!」
			PRINTFORMDW 아운이 당신에게 가볍게 손을 흔든다.
			PRINTFORMW 「방해하고 있지 않기를 바라요.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDW 아운은 시선을 아래로 향한 채 미닫이문을 연다.
		PRINTFORML 「잠깐 몸만 담그고 나서--」
		PRINTFORMDW 아운은 시선을 들고 당신과 눈을 마주친다.
		PRINTFORML 「A-A-Ah--」
		PRINTFORMDW 그녀의 얼굴이 빨개지더니 몸이 굳는다.
		PRINTFORMDW 너는 이 시간을 이용해 그녀의 벌거벗은 몸을 넋 놓고 바라본다.
		PRINTFORML 「미-미안해요!!」
		PRINTFORMDW 운나가 큰 소리를 내며 미닫이문을 빠르게 닫았다.
		PRINTFORML 「그렇지만... 이거 괜찮지 않아요? 저는... 그리고 우리는... 그래서...」
		PRINTFORMDW 너는 문 뒤에서 그녀가 중얼거리는 것을 들을 수 있다.
		PRINTFORMDW 문이 천천히 다시 열리더니 머리 위로 김이 나는 새빨간 운나가 나타났다.
		PRINTFORML 「우리... 음... 같이 목욕할 수 있을까요?」
		PRINTFORMDW 너는 격렬하게 고개를 끄덕인다...
		;HYPERNODDERS
		;TODO check for sex stuff and have her be more assertive instead if experienced
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMDW 아운은 시선을 아래로 향한 채 미닫이문을 연다.
		PRINTFORML 「잠깐 몸만 담그고 나서--」
		PRINTFORMDW 아운은 시선을 들고 당신과 눈을 마주친다.
		PRINTFORML 「A-A-Ah--」
		PRINTFORMDW 그녀의 얼굴이 붉어지고 몸이 굳는다.
		PRINTFORMDW 당신은 이 시간을 이용해 그녀의 벌거벗은 몸을 훔쳐본다.
		PRINTFORML 「죄-죄송해요!!」
		PRINTFORMDW 아운은 큰 소리와 함께 미닫이문을 급히 닫고, 당신은 그녀가 황급히 떠나는 것을 듣는다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF MARK:反発刻印
			PRINTFORMDW 아운은 당신을 알아보고 입술을 삐죽 내밀고 팔짱을 낀 채 시선을 피한다...
		ELSE
			PRINTFORML 「아, %CALLNAME:MASTER%-님이 아니신가요!」
			PRINTFORMDW 당신은 미소 지으며 당신에게 손을 흔드는 아운을 만난다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:恋人
			PRINTFORMDW 아운은 %CALLNAME:(ARG:1)%을(를) 알아보고 얼어붙는다.
			PRINTFORMDW 그녀의 입은 크게 벌어져 있고 눈가에 눈물이 고이기 시작한다.
			PRINTFORMDW 그녀는 고개를 저으며 촉촉한 눈물을 재빨리 닦아낸다.
			PRINTFORML 「저-저...」
			PRINTFORMDW 아운은 당신에게 미소를 지어주기 위해 애쓴다.
			PRINTFORML 「그들이 아니야... 그럴 리가, 맞지?」
			PRINTFORMDW 그녀는 시선을 내리고 혼잣말을 중얼거린다...
			;TODO: make her sullen, but not mad, CFLAG:ARG:不機嫌 = 1 or however it would work
		ELSEIF TALENT:恋慕
			PRINTFORML 「Ah...」
			PRINTFORMDW 아운은 %CALLNAME:(ARG:1)%와 당신을 함께 본 후, 실망한 표정으로 당신을 바라본다.
			PRINTFORML 「%CALLNAME:MASTER%-상과 %CALLNAME:(ARG:1)%-상...」
			PRINTFORML 「즐겁게 놀아...」
			PRINTFORMDW 그녀는 가짜 미소를 지으며 소심하게 손을 흔든다...
		ELSEIF TALENT:思慕
			PRINTFORML 「아, %CALLNAME:MASTER%씨!」
			PRINTFORMDW 그녀는 당신에게 환하게 웃으며 미소를 살짝 비틀어 %CALLNAME:(ARG:1)% 쪽으로 돌아섰다.
			PRINTFORML 「그리고 %CALLNAME:(ARG:1)% 씨...」
			PRINTFORMDW 언은 눈에 보이는 혼란 속에서 가슴을 움켜쥐었다...
		ELSE
			PRINTFORMW 「아, %CALLNAME:MASTER%님-- 그리고... %CALLNAME:(ARG:1)%님!」
			PRINTFORML 「두 분 뭐 하고 계신 거예요?」
			PRINTFORMDW Aunn은 무슨 일이 벌어지고 있는지 모르는 것 같았다...
		ENDIF
	ENDIF
ENDIF
RETURN 1
