;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出される（怒り）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDW 아운은 잠에서 깨어나 단호하게 당신에게 손가락질을 한다.
		PRINTFORML 「%CALLNAME:MASTER%-씨!! 코마이누의 잠을 그렇게 함부로 방해해서는 안 돼!」
		PRINTFORMDW 그녀가 마침내 당신을 내쫓기 전, 당신은 잔소리를 듣는다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORML 「%SPLIT_M("Zzz:Suu:Snore:Suyasuya:Munya:Haa", "...: ", 3)%」
		PRINTFORMDW 아운은 얼굴에 %SPLIT_G("peacefully:happily:blissfully")%와 %SPLIT_G("big grin:amused look:massive smirk")%를 한 채 잠들어 있었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		PRINTFORMDW 아운과 %SPLIT_G("sleepily rubs her eyes:barely opens her eyes")%와 %SPLIT_G("yawns extensively:sighs sluggishly")%했다.
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「...악은 물러가라...」
				PRINTFORMDW 당신은 갑자기 정체불명의 힘에 밀려 밖으로 내몰린다...
			CASE 1
				PRINTFORML 「...%CALLNAME:MASTER%-상?」
				PRINTFORML 「죄송해요,... 하지만...후아... 내일 같이 놀 수 있어요...」
				PRINTFORMDW 아운은 다시 침대에 쓰러지고 당신은 그녀를 잠들게 내버둔다...
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される（衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
