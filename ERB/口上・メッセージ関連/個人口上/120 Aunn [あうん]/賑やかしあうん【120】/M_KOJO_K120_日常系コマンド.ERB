@M_KOJO_SUCCESS_COM_K120_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K120_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K120_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K120_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:ブチギレ || TFLAG:193 == -3 ;custom code, hate mark 3/anger
		PRINTFORMDW 아운이 이빨을 드러내며 당신에게 으르렁거렸다. 그녀는 대화할 만큼 충분히 화가 난 것 같았다...
		RETURN
	ENDIF
	;Dialogue failure
	IF TCVAR:302
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...」
				PRINTFORMDW 두 분 다 대화 주제가 떨어졌군요...
			CASE 1
				PRINTFORML 「...」
				PRINTFORMDW 아운은 대화 주제를 생각하려 애쓰며 어색하게 뺨을 긁는다.
			CASE 2
				PRINTFORML 「하...하하...」
				PRINTFORML 「...」
				PRINTFORMDW 아운은 어색하게 웃더니 곧 조용해졌다...
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Dating dialogue
	;-------------------------------------------------
	IF CHK_DATENOW(CFLAG:TARGET:デート中)
		SELECTCASE CFLAG:MASTER:現在位置
			;in transit
			;道中
			CASE ROAD_TO(CFLAG:MASTER:デート中)
				IF TALENT:恋慕
					;
				ELSE
					;
				ENDIF
				;Hakurei Shrine and surroundings
				;博麗神社
			CASE 10 TO 90
				;
				;Forest of Magic
				;魔法の森
			CASE 森の入り口, 古木の大樹, 霧雨魔法店, 人形の洋館
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「사람들이 언급할 때 "숲" 그것에 대해서만 항상 이야기하잖아, 그렇지?」
						PRINTFORMW 「왜 그래?」
						PRINTFORMDW 너는 이곳 외에는 환상향에 다른 진짜 숲은 없다고 설명한다.
						PRINTFORML 「대나무 숲은 어때?」
						PRINTFORMDW 그것은 기술적으로 "덤불" 그리고 숲이 아니라
						;Editor's note: "Bamboo Thicket" (竹林) vs. "Forest" (森).
						PRINTFORML 「그럼 요괴 산은 어때?」
						PRINTFORMW 「거기는 정말 큰 숲이 있지 않아?」
						PRINTFORMDW 당신은 비웃듯이 미소 지으며 그곳이 너무 광활해서 말 그대로 "나무의 바다"라고 그녀에게 말했다.
						;Editor's note: "Sea of Trees" (樹海) vs. "Forest" (森).
						PRINTFORML 「음...」
						PRINTFORMW 「네 말이 맞는 것 같아! 그렇다면 환상향에는 다른 숲이 없는 거겠지!」
						PRINTFORMDW 당신은 화제를 돌리려 했지만, 아운이 갑자기 생기를 되찾았다.
						PRINTFORML 「Ah!」
						PRINTFORMW 「"요괴 타누키 숲"이 있다고 들었어!」
						PRINTFORMDW 스스로 그것을 거의 잊고 응답하며 고개를 끄덕인다.
						PRINTFORMDW 그곳도 또 하나의 숲으로 간주한다.
						;Editor's note: 妖怪狸の森
						PRINTFORML 「헤헤!」
						PRINTFORMDW 아운은 자랑스럽게 가슴을 내민다.
						PRINTFORMDW 하지만 그곳은 거의 알려지지 않았기에 사람들은 여전히 마법의 숲만을 생각할 것이다.
						PRINTFORMDW 특히 인간 마을과 가까이 있기 때문이다.
						PRINTFORML 「Ah...」
						PRINTFORMW 「음...」
						PRINTFORMDW 아운은 자신의 생각 속으로 깊이 파고들며 다시 침묵한다.
						PRINTFORMDW 그녀가 다시 입을 열기까지는 오래 걸리지 않았다.
						PRINTFORMW 「나 "코마노 숲!"이라고 부를 수 있는 숲을 찾고 싶어!」
						PRINTFORMDW 당신이 그녀에게 그렇게 하라고 말하자, 그녀는 마치 무엇이 숲을 숲답게 만드는지 확인하려는 듯 나무들을 살피기 시작한다...
					CASE 1
						PRINTFORML 「이 게 숲에서 유명한 버섯 중 하나일지 모르겠네.」
						PRINTFORMDW 아운은 흰 점이 있는 노란색 버섯 작은 군집 옆에 쭈그리고 앉았다.
						PRINTFORMW 「사람들은 그걸 먹으면 환각을 본다고 들었어.」
						PRINTFORML 「하지만 마리사 씨는 이걸 마법에 사용하시잖아요, 그렇죠?」
						PRINTFORMDW 그녀는 조심스럽게 하나를 따서 살펴봤다.
						PRINTFORML 「대체 이런 것에서 어떻게 마법이 나오는 거지?」
						PRINTFORMDW 아운은 버섯을 앞으로 흔들어 보았지만, 마법은 나오지 않고 포자 몇 개만 나왔다.
						SELECTCASE TALENT:MASTER:調合Lv
							CASE 0, 1
								PRINTFORMDW 당신의 조합지식이 너무 낮으니, 그녀에게 마리사에게 직접 물어보라고 말한다.
								PRINTFORML 「오! 좋은 생각이야!」
								PRINTFORML 「그럼 언젠가 그녀에게 물어봐야겠어.」
								PRINTFORMDW 그녀는 버섯을 내려놓고 두 사람은 계속 나아간다...
							CASE 1, 2
								PRINTFORMDW 당신은 그녀에게 그것들을 말려 갈아서 약을 만들 수 있다고 말한다.
								PRINTFORMDW 하지만 당신의 조합지식은 너무 낮고 그것들로부터 마법을 추출하는 방법을 모른다.
								PRINTFORML 「그렇다면 마리사 씨에게 직접 물어봐야겠어!」
								PRINTFORMDW 그녀는 버섯을 내려놓고 두 사람은 계속한다...
							CASEELSE
								PRINTFORMDW 당신은 조합지식을 자랑하며 그들을 말려 가루로 만들어 약을 만들 수 있다고 그녀에게 말한다.
								PRINTFORMDW %BREAKENG("Additionally you can submerge them in mountain stream water, boil them or smash different kinds together to create magic reactions.")%
								PRINTFORML 「오옷... 그런 거였군요!」
								PRINTFORMDW 반응은 매우 다양하며, 가장 흔한 결과는 아무런 반응도 없는 것이다.
								PRINTFORML 「그럼 좀 어려울 것 같네요...」
								PRINTFORMDW 그녀는 버섯을 내려놓고 당신의 대답에 만족하는 듯했다...
						ENDSELECT
					CASE 2
						SELECTCASE DAY:2
							CASE 1
								;Spring
								PRINTFORMDW 당신은 하얀 등나무로 둘러싸인 공터에 도착한다.
								PRINTFORMDW 팔뚝만 한 크기의 눈처럼 흰 꽃송이들이 가지에서 늘어져 있다.
								PRINTFORML 「흰 등나무네!」
								PRINTFORMDW 아운이 나무 중 하나 쪽으로 달려간다.
								PRINTFORMW 「보통 보라색 아니었어?」
								PRINTFORMW 「그럼 이건 희귀한 건가?」
								PRINTFORMDW 그녀는 꽃송이 하나를 쿡 찌르자 꽃가루 구름이 터져 나온다.
								PRINTFORML 「으윽!」
								PRINTFORMDW 아운은 뒤로 물러나지만 이미 너무 늦었고 눈가가 촉촉해지기 시작한다.
								PRINTFORML 「아아... 아아아... 아~에취!!!」
								PRINTFORMDW 그녀는 힘차게 재채기를 한다.
								PRINTFORML 「에취!」
								PRINTFORMDW 그리고 또 한 번.
								PRINTFORML 「에-에취!!!」
								PRINTFORMDW 이 상태가 반응이 마침내 진정될 때까지 계속된다.
								PRINTFORML 「아아... 후우...」
								PRINTFORMDW 당신은 그녀를 확인하고, 코에서 콧물이 흐르는 채로 그녀는 당신에게 미소 짓는다.
								PRINTFORML 「에헤헤~ ... 드디어 그만!」
								PRINTFORMDW 당신은 손수건을 꺼내 그녀의 얼굴을 닦아준다...
							CASE 2
								;Summer
								PRINTFORML 「숲이 이렇게 멋지다니 놀랍네.」
								PRINTFORMDW 당신과 아운은 울창한 캐노피 아래에서 잠시 숨을 돌린다.
								PRINTFORMDW 시원한 바람이 당신들을 감싸고, 나뭇잎들은 햇빛을 간절히 가리며 바스락거린다.
								CALL COLORMESSAGE("「와아~ 방문객들을 찾았어!」", C_TEAL, 2)
								CALL COLORMESSAGE("「너희들 여기서 뭐 하고 있는 거냐?!」", C_ORANGE, 2)
								PRINTFORMDW 흥분한 두 요정이 당신을 발견하고 날아와 온다.
								PRINTFORMDW 한 명은 청록색 양갈래 머리를 하고 있으며 레이스 부분에 노란 마름모 무늬가 있는 흰 드레스를 입고 있다.
								PRINTFORMDW 다른 한 명은 길게 늘어지는 오렌지빛 갈색 머리를 하고 있으며, 같은 무늬가 흰색으로 들어간 연한 파란색 드레스를 입고 있다.
								IF TALENT:恋慕
									PRINTFORML 「데이트 중이야!」
									PRINTFORMDW 아운이 기쁘게 외쳤다.
								ELSEIF TALENT:思慕
									PRINTFORML 「저기... 음...」
									PRINTFORMDW 아운이 당신을 흘긋 본다.
									PRINTFORMDW 당신은 데이트 중이라고 말하고, 아운은 그에 얼굴을 붉힌다.
								ELSE
									PRINTFORML 「우리는 즐기러 왔어요!」
									CALL COLORMESSAGE("「오오~하! 재미있다!」", C_TEAL, 2)
									CALL COLORMESSAGE("「우리도 재미있게 놀고 싶어!」", C_ORANGE, 2)
									PRINTFORML 「그럼 뭐 좀 하자고!」
									PRINTFORMDW 아운은 당신을 기대하며 바라본다.
									PRINTFORML 
									CALL ASK_YN("그들을 합류한다", "거절한다")
									IF !RESULT
										PRINTFORML 
										PRINTFORMDW 여러분 네 분이 %SPLIT_G("Hide and Seek:Tic Tac Toe:Kick the Can:Hopscotch:Shrine Maiden and Youkai:Red Light, Green Light:Tag:Telephone")%을 한다...
									ELSE
										PRINTFORML 
										PRINTFORMDW 그 세 사람은 당신이 계속 휴식을 취하는 동안 %SPLIT_G("Hide and Seek:Tic Tac Toe:Kick the Can:Hopscotch:Shrine Maiden and Youkai:Red Light, Green Light:Tag:Telephone")%을 한다...
									ENDIF
								ENDIF
								IF (TALENT:恋慕 || TALENT:思慕)
									CALL COLORMESSAGE("「데이트라니... 결혼 같은 것 중 하나인가요?」", C_TEAL, 2)
									PRINTFORMW 「결혼?」
									IF TALENT:恋人
										PRINTFORML 「...그건 우리에게 주어진 문제인가요?」
										PRINTFORMDW 아운은 수줍게 당신을 바라본다.
										CALL ASK_YN("물론이지!", "No!")
										IF !RESULT
											PRINTFORMW 「우-우와...! 계획을 세워야 하나...?」
										ELSE
											PRINTFORMW 「좀 너무 갑작스러울 것 같아...」
										ENDIF
									ELSEIF TALENT:恋慕
										PRINTFORML 「저기... 그 전에 한 단계가 더 있어...」
										PRINTFORMDW 아운은 당신을 향해 눈꺼풀을 파르르 떨었다.
									ELSE
										PRINTFORMW 「두 사람이 영원히 함께 있겠다고 약속하는 그런 때가 아니었을까?」
									ENDIF
									CALL COLORMESSAGE("「어차피 상관없잖아! 결혼은 그냥 신화일 뿐이라고!」", C_ORANGE, 2)
									PRINTFORMW 「신화라고?」
									CALL COLORMESSAGE("「오오... 당신이 말하는 건 그거 맞죠?」", C_TEAL, 2)
									CALL COLORMESSAGE("「응!」", C_ORANGE, 2)
									CALL COLORMESSAGE("「어떤 인간이 들러 와서 아내가 다른 사람에게 떠났다고 말했어!」", C_ORANGE, 2)
									CALL COLORMESSAGE("「그러면서 결혼은 그저 신기루일 뿐이라고 말했다!」", C_ORANGE, 2)
									PRINTFORMW 「인간이 여기 있나?」
									CALL COLORMESSAGE("「뭐라고!」", C_TEAL, 2)
									CALL COLORMESSAGE("「이건 좀 전 일이야.」", C_TEAL, 2)
									CALL COLORMESSAGE("「저가 그 멧돼지를 잡았을지 궁금하네...」", C_ORANGE, 2)
									CALL COLORMESSAGE("「아마 아닐 거야. 우리 요정들에게도 너무 빨라!」", C_TEAL, 2)
									PRINTFORMW 「어라? 멧돼지라고?」
									CALL COLORMESSAGE("「응, 응! 그에게는 밧줄이 있었어.」", C_ORANGE, 2)
									CALL COLORMESSAGE("「그거 걸리는 거 위한 거지?」", C_ORANGE, 2)
									CALL COLORMESSAGE("「여기서 잡을 수 있는 건 오직 멧돼지뿐이다!」", C_TEAL, 2)
									PRINTFORML 「R-밧줄?!」
									PRINTFORMDW 요정들은 당신이 더 캐물을 겨를을 주지 않고 즉시 다른 화제로 넘어갔다.
									PRINTFORMDW 한참 후 그들은 당신과의 대화에 지루함을 느끼고 날아가 버렸다.
									PRINTFORMDW 마침내 둘만 남게 된 당신과 Aunn은 서로에게 시선을 교환했다.
									PRINTFORMDW 파탄 난 결혼 생활과 밧줄 외에는 아무것도 없는 숲속의 고독함.
									PRINTFORMDW 그것이 의미할 수 있는 것은 단 하나뿐이었다...
								ENDIF
							CASE 3
								;Fall
								PRINTFORMDW 당신과 아운은 커다란 낙엽 더미를 발견한다.
								PRINTFORML 「!!!」
