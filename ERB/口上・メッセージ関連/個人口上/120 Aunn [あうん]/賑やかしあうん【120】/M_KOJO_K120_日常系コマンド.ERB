LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF SHIRAHU(120) == 0
		RETURN 0
	;TARGETとデート
	IF CFLAG:同行
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「나랑 데이트하고 싶어?」
					PRINTFORML 「음!! 당장 나가자!」
					PRINTFORMDW 아운은 정말 간절해 보여...
				CASE 1
					PRINTFORML 「데이트라니! 에헤헤~!」
					PRINTFORMDW 아운이 행복하게 웃는다...
				CASE 2
					PRINTFORML 「물론이지! 나 특별한 곳에 데려갈 거지?」
					PRINTFORMDW 아운은 당신을 올려다본다...
			ENDSELECT
			;TODO: variation for yearning and less, maybe intimacy based check instead
		ENDIF
		;TARGET以外とデート
	ELSEIF CFLAG:MASTER:同行
		IF TALENT:恋慕
			PRINTFORML 「...쳇. 왜 저런 걸... 크윽...」
			PRINTFORMDW 아운은 혀를 차며 혼잣말을 중얼거리고 낮게 으르렁거렸다...
		ELSEIF TALENT:思慕
			PRINTFORML 「...어라? ...두 분 데이트 가시는 거예요? 그렇군요...」
			PRINTFORMDW 언은 눈을 마주치지 않는다...
		ELSE
			PRINTFORML 「어라? 두 분 데이트 가시는 거예요? 행운을 빌어요~!」
			PRINTFORMDW 아운이 당신에게 작별 인사를 건넨다...
		ENDIF
		;お出かけお見送り
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「에~? 혼자 외출하는 거야?」
			PRINTFORML 「아,... 그럼 조심히 다녀...」
			PRINTFORMDW 아운은 당신을 배웅하며 슬퍼 보인다...
		ELSEIF TALENT:思慕
			PRINTFORML 「혼자 외출하는 거야?」
			PRINTFORML 「아, 아니야... 별거 아니야. 조심해...」
			PRINTFORMDW 아운은 불안하게 몸을 뒤척이며 너에게 소박한 작별 인사를 건넨다...
		ELSE
			PRINTFORML 「어머? 외출해? 안전하게 다녀와~!」
			PRINTFORMDW 언은 당신에게 작별을 고한다...
		ENDIF
	ENDIF
ENDIF
RETURN 1
