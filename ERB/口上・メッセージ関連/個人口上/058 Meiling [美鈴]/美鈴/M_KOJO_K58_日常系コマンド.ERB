					PRINTFORML 「...Ahaha. Are you laughingー?」
					PRINTFORMDW The two of you keep pulling on each other's cheeks, and eventually you burst out laughing...
			ENDSELECT
		ELSEIF ABL:親密 > 5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「Mui. Moououou～」
					PRINTFORML 「Nobiru～ Nyabiru～」
					PRINTFORMDL Meiling's reactions are fun, so you keep going.
					PRINTFORML 「Muoー In-In return...」
					PRINTFORMDW Meiling mounts a counterattack, grabs both your cheeks, and begins pulling on them...
				CASEELSE
					PRINTFORML 「Funyi, ouu～...」
					PRINTFORML 「If you keep going my cheeks might fall offー... Miyuu...」
					PRINTFORMDL You play with Meiling's cheeks to the sound of her noises.
					PRINTFORMW 「Ehehe, that you like this so much...」
			ENDSELECT
		ELSEIF ABL:従順 >= 5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「Fumyu... Uhh... Ehh...」
					PRINTFORML 「...P-Pleashe shtop.」
					PRINTFORMDW Meiling doesn't know how to react, but seems to be enjoying it a bit.
				CASEELSE
					PRINTFORML 「Aauー」
					PRINTFORML 「Nyu-nyu-nyu... Shtop～」
					PRINTFORMDW Meiling says "shtop" quite a lot of times before it's over...
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「Funyugu, Stop it, Futtefua.」
					PRINTFORML 「...Muii, My cheeks aren't toys～...」
				CASEELSE
					PRINTFORML 「Muooー, Nyuni Furufu...」
					PRINTFORML 「Fumuu!... It tickles...」
					PRINTFORMDL Her cheeks have swollen up completely...
			ENDSELECT
		ENDIF
	ENDIF

ENDIF
RETURN 1
