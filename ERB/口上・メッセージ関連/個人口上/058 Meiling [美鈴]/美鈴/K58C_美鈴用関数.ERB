;****イベントファイル**********************************************************
;==================================================
;何度も書くのは地味ながらめんどいので挨拶を関数化。特筆無し
;==================================================

@K58_時間別挨拶(ARG)
#FUNCTIONS
#DIMS 挨拶
ARG = TIME:2
SELECTCASE TIME:2
	;朝
	CASE 1,2
		挨拶 = good morning
		;昼
	CASE 3,4
		挨拶 = hello
		;夜
	CASE 5,6,7
		挨拶 = good evening
ENDSELECT
RETURNF 挨拶
;==================================================
;主に起床時に呼び出し。とりあえず通常のフェラから経験のみ移植。
;==================================================

@K58_簡易フェラ
EXP:Ｍ経験 += 1
EXP:口淫経験 += 3
EXP:精飲経験 ++
IF HETEROSEX(TARGET,PLAYER)
	EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 7
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 7
ENDIF
;愛情経験
SIF TALENT:恋慕 && ASSIPLAY == 0
	EXP:愛情経験 += 1
RETURN 1
;==================================================
;寝言共通口上。
;==================================================

@K58_寝言
IF TALENT:恋慕 || TALENT:恋人
	SELECTCASE RAND:6
		CASE 0
			PRINTFORML 「zzz... 사쿠야 씨의 상반신이 근육질이야... zzz...」
			PRINTFORMDW ...사쿠야가 꿈속에서 무슨 일이 일어나고 있는 걸까...?
		CASE 1
			PRINTFORMDL 메이링은 행복한 표정으로 %HIS_HER(58)%의 얼굴을 하고 잠들어 있다...
			PRINTFORMW 「냐아... %조사처리(CALLNAME:MASTER,"와")% 함께...」
		CASE 2
			PRINTFORMDL 메일링은 잠꼬대로 무언가를 중얼거린다...
			PRINTFORMW 「...에헤헤... 정말 고마워요... 에헤헤...」
		CASE 3
			PRINTFORML 「...슈파~... 그만해... 안...%UNICODE(0x2665)%」
			PRINTFORMDW 메이링은 꿈을 즐기고 있는 것 같다...
		CASE 4
			PRINTFORMW 「무냐... 소쿠야 씨는 쓸모없어~... 그건... 아, 사실은 다짐기였어...」
		CASEELSE
			PRINTFORML 「ZZZzz...」
			PRINTFORML 「안도(Andou)는 전기 교쿠로를 얻으러 로키 산에 가는 꿈을 꾸고 있다...」
			PRINTFORML 「ZZZzz...」
			PRINTFORMDW 너는 정말로 메이링의 꿈속에서 무슨 일이 벌어지고 있는지 알고 싶구나...
	ENDSELECT
ELSEIF TALENT:思慕
	SELECTCASE RAND:5
		CASE 0 TO 1
			PRINTFORMDL 메이링은 행복한 표정으로 %HIS_HER(58)%의 얼굴로 잠들어 있다...
			PRINTFORMW 「문야... %CALLNAME:MASTER%... 에헤헤...」
		CASE 2
			PRINTFORMW 「무냐... 소쿠야 씨는 쓸모없어~... 그건 버킷 휠 굴착기라고...」
		CASE 3
			PRINTFORML 「...아아... 안나... 아...」
			PRINTFORML 「...안닌 두부...」
			PRINTFORMDW 음식을 꿈꾸는 것 같지만, 그런 모습은 아닌 듯하다... 참 이상하군...
		CASEELSE
			PRINTFORML 「음...」
			PRINTFORML 「테루요후가... 먹고 있어... 시나퍼...」
			PRINTFORML 「음...」
			PRINTFORMDW 도대체 무슨 꿈인 거야...?
	ENDSELECT
ELSE
	SELECTCASE RAND:5
		CASE 0
			PRINTFORMW 「응우~... 음야냐... 후우...」
		CASE 1
			PRINTFORMW 「무냐... 소용없어~ 사쿠야 씨... 저건 불도저라고...」
		CASE 2
			PRINTFORML 「우으... 이걸 마시면 슈퍼 메일링 신이 될 거야... 후우...」
			PRINTFORMDW ...그녀는 잠꼬대를 하는 것 같다.
		CASE 3
			PRINTFORML 「문야... 사쿠야 씨, 가슴 근육만 운동하는 건... 우구우...」
			PRINTFORMDW ...무슨 꿈이야?
		CASEELSE
			PRINTFORML 「음...」
			PRINTFORML 「태상노군의 춤을 놀리는 거야?!」
			PRINTFORML 「음...」
			PRINTFORMDW 도대체 무슨 꿈인 거지...?
	ENDSELECT
ENDIF
RETURN 1
