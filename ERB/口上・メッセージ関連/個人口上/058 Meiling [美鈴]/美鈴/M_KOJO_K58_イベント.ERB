@M_KOJO_EVENT_K58_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕 || TALENT:思慕
					PRINTDATAL
						DATAFORM 「뭐... 뭐냐...? ...진심이야?」
						DATAFORM 「후우... 이건... 나... 하아...」
						DATAFORM 「흐으음... 아, 음, 괜찮다면... 잠깐, 아니야, 내가 무슨 말을 하는 거야...?!」
						DATAFORM 「...말도 안 돼, %CALLNAME:MASTER%, 나는...」
						DATAFORM 「꺄아악?! 잠깐, 누구냐아!!! %CALLNAME:MASTER%, 여기에...?!」
					ENDDATA
					PRINTDATAL
						DATAFORM 「아바바바...! 잠시만! 잠깐만!」
						DATAFORM 「...우와아. 너무 부끄러워... 제발 쳐다보지 말아 줄래?」
						DATAFORM 「이-이건 그냥 밤에 하는 운동이야!... 안 되는 거야?」
						DATAFORM 「아ー 우아ー 아～... 나-난 잠이 안 와서, 하하하...」
					ENDDATA
					PRINTFORMDL 메이링은 당황하며 얼굴이 새빨개졌다.
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTDATAL
						DATAFORM 「...후아아%UNICODE(0x2665)% 아~~... 지금 나 훔쳐보고 있었지?」
						DATAFORM 「...아앙... %CALLNAME:MASTER%너 변태야♪」
						DATAFORM 「...! ...엿보는 건 나쁜 버릇이야, 후후후%UNICODE(0x2665)%」
						DATAFORM 「아아~~... 하지만 좀 심했잖아, 그렇지...?」
						DATAFORM 「히야! ...나 놀랐잖아, %CALLNAME:MASTER%...」
					ENDDATA
					PRINTDATAL
						DATAFORM 「그래서... 나 자위할 때 꽤 크게 신음했나 보네, 응?」
						DATAFORM 「몸의 통제력을 잃어버렸어... 네 잘못이라는 거 알잖아, 그렇지?」
						DATAFORM 「흐응... 꽤 좋았는데... 어떻게 생각해?」
						DATAFORM 「뭐, 그냥 해야만 했어...」
					ENDDATA
					PRINTFORMDL 메일링이 네가 훔쳐보는 것을 알아차리자, 그녀는 다리를 활짝 벌려 더 많이 보여준다…
				ELSE
					PRINTDATAL
						DATAFORM 「으...응? %CALLNAME:MASTER%... 언제 오신 거야...?」
						DATAFORM 「아......하아아엣?!」
						DATAFORM 「어라...? ...히야아아?!」
						DATAFORM 「......히야아아?! 에?! 와-?!」
						DATAFORM 「갸아아?! %CALLNAME:MASTER%-상, 변태――!」
					ENDDATA
					PRINTFORMDL 메일링은 감탄스러운 자신의 몸을 가리려고 서두른다. 완전히 놀라 잡혔음에도 그녀는 당황하지 않았다...
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕 || TALENT:思慕
					IF CFLAG:MASTER:初期位置 == CFLAG:初期位置
						PRINTFORML 「――~~! 그냥 자러 가렴!」
						PRINTFORMDL 그녀는 그렇게 말했지만, 그런 것을 본 후에는…
						PRINTFORMDW 둘 다 전혀 잠을 이룰 수 없다...
					ELSE
						PRINTFORML 「아아악~~! 제발 그냥 가주세요!」
						PRINTFORML 「...%조사처리(CALLNAME:MASTER,"가")% 바보 같으니...!」
						PRINTFORMDW 당신은 재빨리 자리를 떠나, 얼굴을 새빨갛게 물든 메이링을 남겼다...
					ENDIF
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORML 「...뭐-뭐라고...? 음, 알겠어...」
					PRINTFORML 「하지만 상관없으니까, 그러니까～?」
					PRINTFORMDW 약간 실망한 채, 메이링은 당신이 떠나는 뒷모습을 외롭게 응시했다...
				ELSE
					PRINTFORML (아아아, 이 모든 시간 동안 %HIS_HER(MASTER)%의 존재를 어떻게 눈치채지 못했을까...!!)
					PRINTFORMDW 메일링은 충격을 받은 채, 발각된 후 여전히 회복하려 노력하며 무슨 일이 일어날지 걱정하고 있다...
				ENDIF
				;オナバレが初めてかどうか
				;IF CFLAG:オナバレ < 1
				;	PRINTFORML
				;ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「나 자위하는 거 보고 있네, 응... 정말 변태구나... 흠...」
							PRINTFORMW 「...만 만 %CALLNAME:MASTER%라면 괜찮은 걸지도...」
						CASEELSE
							PRINTFORML 「뭐, 그게... 보고 싶다고...?」
							PRINTFORMW 「아앗! 아무것도 아니야! 아무것도 아니라고!... 아으...」
					ENDSELECT
				ELSEIF TALENT:思慕
					PRINTFORML 「...그런 걸 물어보는 게 얼마나 창피한 일인지 알아? 우웅...」
					PRINTFORMW 「좋아, 보여줄게. 하지만... 좀 어렵네...」
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「그렇게 그런 걸 좋아하는 거군. 그럼... 제 제안을 받아들이겠어%UNICODE(0x2665)%」
							PRINTFORMW 「...아아, 그렇게 나를 쳐다보는 게 나를 흥분시켜...」
						CASEELSE
							PRINTFORML 「…정말 보고 싶었던 거야?」
							PRINTFORMW 「Fufu, I guess there's this kind of play too...」
					ENDSELECT
				ELSE
					PRINTFORML 「이미 봤잖아......... 좋아... 하지만!」
					PRINTFORMW 「그냥 아무에게도 말하지 않도록 해줘...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;たぶん恋慕では引っ掛からないと思うけど念のため
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「D-바보같이 굴지 말고 그냥 가줘, 제발!」
					PRINTFORML 「널 발로 찰 거야, 농담 아니야! 아 잠깐... 아아아악!」
					PRINTFORML 「이런 상태에서 그걸 하면 다 드러날 거라고! 음, 어... 으윽...」
					PRINTFORMW 「...어쨌든, 나가! 당장!」
				ELSE
					PRINTFORML 「아하하, 뭐 마음대로 해봐, 내 구경꾼이 되든... 그래, 그럴 리가 없잖아――!!!」
					PRINTFORMW 「제발 그냥 가줘, 이 개자식아――!!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;選択肢直後、地の文の前
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF FIRSTTIME("オナバレックス初回")
					IF TALENT:恋慕
						PRINTFORML 「음... 지금 정말 하고 싶어?」
						PRINTFORML 「아니야, 그냥, 싫지는 않은데... 우웅...」
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 그런 표정을 보면 난... 너한테 화낼 수가 없어...」
						PRINTFORMDL 메이링은 부끄러움에 고개를 돌리고, 당신은 그녀가 흥건하게 젖은 허벅지를 온몸으로 볼 수 있도록 살짝 몸을 낮춘다...
					ELSEIF TALENT:思慕
						PRINTFORML 「에엣? 뭐- 뭐라고 말하는 거야... 잠시만, 이게 무슨 기운이야?!」
						PRINTFORMDL 메이링은 네가 의미하는 것을 추측한다.
						PRINTFORMDL 이전의 흥분이 공기 중에 짙게 남아 그녀의 정신을 흐리게 했다.
						PRINTL 
						PRINTFORML 「이렇게 하는 거야... 이 겁쟁이 같으니...」
						PRINTFORMDW 그녀는 중얼거렸지만, 당신의 흥분만으로도 매우 들뜬 것 같다...
					ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
						PRINTFORML 「오 마이 마이... %CALLNAME:MASTER%, 더는 참을 수 없구나, 내가 가져도 되나?」
						PRINTFORML 「누군가 자위하는 걸 훔쳐보고 그 사람을 폭행하다니... 너 정말 나쁜 사람이구나.」
						PRINTFORMDL 미소 지으며 그녀의 은밀한 곳을 살짝 만지는 메이링의 눈에는 욕망이 가득했다...
						PRINTL 
						PRINTFORML 「내 안으로 그런 나쁜 사람들을 전멸시키는 게 내 의무인가 봐... 후후후...」
					ELSE
						PRINTFORML 「에? 잠시만, 왜 가까이 오는 거야...」
						PRINTFORML 「진심이야! 지금은 나한테 가까이 오지 마...!」
						PRINTFORMDL 메일링은 당신에게서 벗어나기 위해 몸을 뒤틀었다.
						PRINTFORMDW 하지만 여성의 흥분감이 그녀의 마음을 흥분으로 뒤덮었고, 제대로 움직이는 법을 잊어 넘어지고 말았다...
					ENDIF
					PRINTL 
				ELSE
					IF TALENT:恋慕
						PRINTFORML 「와, 나를 다시 보니까 그렇게 흥분했어...?」
						PRINTFORML 「...음... 그럼 제대로 만족시켜 줘.」
						PRINTFORMDL 그런 미약한 변명을 내세웠지만, 매일링의 온몸이 움찔거린다.
						PRINTFORMDL 그녀가 천천히 자위를 계속하자 허벅지 사이에서 크고 축축한 소리가 난다.
						PRINTL 
						PRINTFORML 「이대로 같이 미쳐버리자... 서둘러줘...」
						PRINTFORMDW 그녀의 골반은 당신을 향해 통제 불가능하게 밀려오고, 그녀는 그저 신음할 뿐이다...
					ELSEIF TALENT:思慕
						PRINTFORML 「...아, 또 이렇게 되는군... 정말이지～」
						PRINTFORML 「혹은 네가 스스로 즐기기 위해 일부러 이러는 건가...?」
						PRINTFORMDL 메이링은 촉촉한 눈으로 너를 응시한다.
						PRINTFORMDL 그녀 역시 이런 것을 예상했던 것 같다.
						PRINTFORMDL 결국, 그녀는 여전히 음란하게 자위를 하고 있으며 누군가 자신을 만져주길 바라고 있다.
						PRINTFORMW 「아우, 그렇게 쳐다보지 말고 어서 해줘 제발...」
					ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
						PRINTFORML 「아, 혼자 하는 건 별로인 것 같아...」
						PRINTFORML 「여기, 깊숙한 곳이, 아아, 어서, 나 좀 도와줘, 손이 닿지 않아...」
						PRINTFORMDL 메일링은 입술을 크게 벌려 속살을 드러내며 말한다.
						PRINTFORMDL 여성의 향기가 당신에게까지 전해온다...
						PRINTFORML 
						PRINTFORML 「그곳이 인내심을 다 써버렸으니, 하아...」
						PRINTFORML 「서둘러, 네가 안에서 나를 기분 좋게 만들기를 원해...%UNICODE(0x2665)%」
						PRINTFORMDL 스스로 만지지 않아도, 꿀이 바닥으로 흘러내린다.
						PRINTFORMDW 저런 음란한 구멍은 정말 무엇인가로 채워져야만 한다...
					ELSE
						PRINTFORML 「Y-또 그러는 거야... 정말 교활하네...」
						PRINTFORML 「하지만... 우리 둘 다 기분이 좋을 거라고 어떻게 확신할 수 있어...」
						PRINTFORMDL 메일링은 얼굴을 점점 더 붉히며 당신을 수줍게 올려다보며 중얼거렸다.
						PRINTFORMDL 당신은 눈앞의 성적으로 좌절한 파트너를 괴롭하기로 결정한다...
					ENDIF
					PRINTL 
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTDATAL
					DATAFORM 「...하아, 하아, 대-대단해...」
					DATAFORM 「그-그거 위험할 정도로 좋았어...」
					DATAFORM 「하아ー 하아ー 더는 못 참겠어...」
					DATAFORM 「...%CALLNAME:MASTER%, 너 정말이지, 엄청난 야성이 있구나... 하아...」
				ENDDATA
				PRINTDATAL
					DATAFORM 「흥분하기 시작했을 때, 당신이 온갖 더러운 말들을 하기 시작했고, 나는 그저... 하아, 하아...」
					DATAFORM 「당신은 계속 어디가 가장 기분이 좋은지 물었기에, 나는 그것에 더욱 신경 쓰게 되었어... 제기랄...」
					DATAFORM 「혼자 자위하고 있을 때 이미 내 정신은 반쯤 나갔었다...」
					DATAFORM 「정말 저속한 전개지만, 그게 날 너무 흥분시키네, 하아... 나는...」
				ENDDATA
				PRINTDATADL
					DATAFORM 메일링은 자신이 기분이 좋았던 이유에 대해 변명할 말을 다 해버렸다.
					DATAFORM 메일링의 몸은 탈진과 흥분으로 쑤신다.
					DATAFORM 메일링은 그저 숨을 고르려 거칠게 몰아쉰다.
					DATAFORM 메일링은 자신이 얼마나 기분이 좋았는지에 대해 당황한다.
				ENDDATA
				PRINTDATADL
					DATAFORM 그녀의 용모는 전혀 숙녀답지 않다.
					DATAFORM 저런 모습을 보면 당신의 허리가 떨린다.
					DATAFORM 그녀는 무너진 채, 엉덩이를 공중에 두고 누워있다.
					DATAFORM 그녀가 갑자기 당신을 껴안는다.
				ENDDATA
				PRINTL 
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;恋慕且つデート中外泊になる場合。……デート中にオナバレってどうなってるんだろうねこの幻想郷……
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;その後一日一緒にイチャイチャしてセックスして過ごす場合
				IF NEMUKE() < 720
					PRINTFORML 「에헤헤, 너도 할 수 있을 줄 알았어♪」
					PRINTFORML 「...내 움직임이 벌써 느려졌으니 오늘은 같이 있자.」
					PRINTFORMDL 메일링의 진심을 깨닫고 씁쓸하게 미소 짓는다.
					PRINTFORML 「그럼, 조금 더 회복하면 두 번째 시도를 할 수 있을 거야.」
					PRINTFORML 「...후후, 나 몰래 들춰본 것에 대해 제대로 고마워해야겠네.」
					PRINTFORMDL 그녀는 행복해 보이지만, 동시에 좀 무서운 기색이 역력했다...
					;そのまますぐに寝る場合
				ELSE
					PRINTFORML 「...응응, 벌써 하루가 끝났으니 같이 자자.」
					PRINTFORML 「오늘 일들 치고는 좋은 밤을 보낼 수 있을 거야♪」
				ENDIF
				PRINTW 
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
