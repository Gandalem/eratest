					ENDIF
				ENDIF
			ENDIF
		ENDIF
		;一日3カウントまで
		IF TCVAR:K58C_時姦膣射爆上げ抑制 == 3
			RETURN 1
		ELSE
			CFLAG:K58C_時姦膣内射精回数 += 1
			TCVAR:K58C_時姦膣射爆上げ抑制 += 1
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
