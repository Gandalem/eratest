@M_KOJO_EVENT_K58_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORML 「후아아-음... 이제 잠자러 갈 시간 아닌가?」
			PRINTFORMW 「...어차피 너는 시간을 바꿀 능력이 있잖아, 그렇지 않아?」
			PRINTFORML 「우리가 함께 있을 때는 시간이 그냥 날아가 버리니까♪」
			PRINTFORMDL 메이링은 당신을 차분하게 바라본다.
			PRINTFORML 「잘 자요, %CALLNAME:MASTER%.」
			PRINTFORML 
			PRINTFORMW 「밤에 몰래 다가오지 말아줘, 알았지? 정말 안 좋을 거야.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「어? 이 시간에 무슨 일이야?」
			PRINTFORML 「(속삭임) ... 어떤 사람 때문에 시간이 좀 너무 빨리 지나가네.」
			PRINTFORMDL 메이링은 저항하지만, 극도로 피곤해 보인다.
			PRINTFORMW 「그럼, 내일 봐.」
		ELSE
			PRINTFORML 「자, 이제 잠자리에 들 시간이야.」
			PRINTFORML 「%CALLNAME:MASTER%, 너무 늦게까지 깨어있는 건 너한테 좋지 않아~」
			PRINTFORMDW 메일링은 지친 눈을 비비며 집으로 향했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「졸리지 않아... 전혀 피곤하지 않아... 음무...」
				PRINTFORMDW 조용히 잠든 메이링은 잠결에 주문처럼 무언가를 중얼거린다...
			CASE 1
				PRINTFORML 「푸와아... 미안해... 괜찮아...」
				PRINTFORMDW 메이링의 하품을 참는 능력이 한계에 다다른 것 같다.
			CASE 2
				PRINTFORML 「쿨쿨, 쿨쿨... 어라? 무슨 말 했어?」
				PRINTFORMDW 메이링은 잠이 들었다.
			CASEELSE
				PRINTFORML 「괜찮아 괜찮아, 잠을 자고 있지 않아, 전혀 피곤하지 않아...」
				PRINTFORMDW 그녀의 말더듬으로 보아 메이링은 자는 것 같다.
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;中身の文は美鈴用関数置き場に。共通なのは朝起きた時、夜寝るとき（睡眠中）、仕事中居眠り
		CALL K58_寝言
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「에헤헤... 음...」
				CASE 1
					PRINTFORMW 「음무... 뉴우...」
				CASEELSE
					PRINTFORMW 「...하아... 아, 내 가슴... 아아앙...」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「...후아아, ..., 음....」
				CASE 1
					PRINTFORMW 「무냐...아...」
				CASEELSE
					PRINTFORMW 「흐으... 응...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「으음...ㄴ...」
				CASE 1
					PRINTFORMW 「...하아...ㄴ...」
				CASEELSE
					PRINTFORMW 「...잘 자니...?」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕付き拠点内キャラがMAIN_MAPで衰弱状態になった場合か、お招き部屋で相手が衰弱した場合に発生
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「...아아~ 아... 하아... 하히...」
			PRINTFORMW 「나... 나 죽을 거야...」
			PRINTFORMDW 땀에 젖고 거친 숨을 몰아쉬는 메이링과 잠시 즐긴 후, 그녀를 침실로 보낸다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「....아, 하아아... 하아... 너무 굉장해...」
			PRINTFORMW 「그렇게 하는 건... 하아... 아아...」
			PRINTFORMDW 당신은 온몸이 분홍색으로 물든 메일링에게 어깨를 빌려준다.
		ELSE
			PRINTFORMW 「...하아.... 벌써 한계야...」
			PRINTFORMDW 당신은 헐떡이는 메이링을 잠시 지켜보다가 그녀를 배웅한다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORML 「와와! %CALLNAME:MASTER%! %CALLNAME:MASTER%!」
			PRINTFORML 「힘내라 %CALLNAME:MASTER%! 괜찮아...? 에? 그냥 피곤한 거야?」
			PRINTFORMDL 상태를 확인하며, 메이링은 안도의 한숨을 내쉬었다.
			PRINTFORML 「...너 정말 희망이 없구나.」
			PRINTFORML 「그렇게 나를 걱정하게 하지 마...」
			PRINTFORMDW 메이링은 조심스럽게 당신을 품에 안아 방으로 데려갔다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「A-괜찮아?!」
			PRINTFORML 「너무 무리하고 있어... 정말이지!」
			PRINTFORML 「네 방까지 내가 안고 가줄게, 하지만 너무 무리하지는 마.」
			PRINTFORMDW 메이링은 당신을 품에 안아 네 방까지 데려간다...
		ELSE
			PRINTFORML 「괜찮아ー?」
			PRINTFORML 「완전히 지쳤구나... 뭐 어쩔 수 없지.」
			PRINTFORMDL 메일링이 당신의 몸에 손을 대고 기운을 조금 준 뒤, 당신을 들어 올린다.
			PRINTFORMW 「몸이 버티지 못할 때까지 일해서는 안 돼...」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
