;Custom code, reenabled

@M_KOJO_EVENT_K58_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;恋慕前提
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「이봐, %CALLNAME:MASTER%, 나랑 여행 갈래?」
						PRINTFORML 「응, 데이트 신청이야♪ 그럼, 같이 가자?」
					CASE 1
						PRINTFORML 「뭔가 이유 없이 오늘 너랑 여행이라도 가고 싶어...」
						PRINTFORML 「나랑 같이 외출할래?」
					CASEELSE
						PRINTFORML 「%CALLNAME:MASTER%, 데이트하자! 데이트라고!」
						PRINTFORML 「...아니면 그건 나쁜 생각인가?」
				ENDSELECT
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「야호! 당장 떠나자!」
						PRINTFORML 「~♪ 데이트~ 데이트~♪」
						PRINTFORML 「우리는 데이트를 한다~♪」
					CASE 1
						PRINTFORML 「좋아! 가자!」
						PRINTFORML 「후후, 내가 마음속에 완벽한 장소가 있어, 환상향의 사랑스러운 문지기가 골라준 곳인데...」
						PRINTFORML 「멋질 거야~」
					CASE 2
						PRINTFORML 「정말 다행이야. 그럼 같이 가자.」
					CASEELSE
						PRINTFORML 「정말 고마워요. 자, 이제 가볼까요♪」
						PRINTFORML 「이런 손잡고 안 가면 데이트라고 할 수 없잖아!」
				ENDSELECT
				PRINTW 
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE RAND:4
					CASE 0
						IF TALENT:恋人
							PRINTFORML 「무우~ 연인의 초대를 거절하다...」
							PRINTFORML 「네가 그 이유를 토해내게 해주마, 우랴아-우랴아~」
							PRINTFORMDL 메이링은 장난스럽게 너를 팔로 조르지만, 그녀는 어쩐지 실망한 듯 보인다.
						ELSE
							PRINTFORML 「무구우, 알겠어... 뭐, 다음 기회에 보자...」
						ENDIF
					CASE 1
						PRINTFORML 「...뭐야?! 근데 왜지이이?」
						PRINTFORML 「아무튼, 시간 날 때 다시 데이트 신청할게.」
					CASE 2
						PRINTFORML 「에~?! 왜 거절하는 거야~...」
						PRINTFORML 「I want to go on a date～...date...」
					CASEELSE
						PRINTFORML 「보아... 음, 좀 실망했지만 어쩔 수 없지.」
						PRINTFORML 「지금이 아니라면 나중에 초대할게.」
				ENDSELECT
				PRINTW 
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
