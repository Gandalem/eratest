@M_KOJO_EVENT_K58_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;うふふ==2（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;MASTERを押し倒した（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF TALENT:恋人
				PRINTFORML 「하아, 하아...」
				PRINTFORML 「너는 정말 너무 심장이 없어, 정말로...」
				PRINTFORMDL 당신은 부드럽지만 즉시 넘어졌다.
				PRINTFORML 「그냥, 너무 잔인해서... 이해하지, 맞지?」
				PRINTFORMDL 메이링의 눈은 완전히 홀린 듯, 그녀는 당신의 옷을 벗기기 시작한다.
				PRINTFORML 「하아, 하아, 이 시점에서는 문제가 네가 아닌 것 같아.」
				PRINTFORMW 「내 몸은 계속 아프지만, 만약 우리가 이걸 한다면...%UNICODE(0x2665)%」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「하아... 하아...」
				PRINTFORML 「더 이상 기다릴 수 없어... 만찬을 즐길 시간이야～」
				PRINTFORMDL 당신은 순식간에 바닥으로 밀려나고, 메이링은 갈망하는 눈빛으로 당신을 응시한다.
				PRINTFORMDL 그녀는 허벅지를 비비며 당신의 목에 뜨거운 숨결을 내쉰다.
				PRINTFORMW 「네가 너무 절망적이니까 어쩔 수 없이 이렇게 하게 됐어...」
			ELSE
				PRINTFORML 「아! 이제 그만해!」
				PRINTFORMDL 메이링은 지쳐서 갑자기 속마음을 내뱉는다.
				PRINTFORMDL 그리고는 갑작스럽게 너를 밀어 넘어뜨린다.
				PRINTFORML 「미안하지만, 더는 버틸 수가 없어...!」
				PRINTFORMDL 유혹적인 신음이 그녀의 입에서 새어 나오고, 길고 붉은 머리카락이 몸을 타고 흘러내린다.
				PRINTFORMDW 그녀의 표정과 말을 보며, 앞으로 무슨 일이 일어날지 알 수 없게 된다...
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERに抱きついた（開始時）
		;抱き付きモード……女性同士限定で押し倒しより優先して判定される。抜け出すが振り払うになり100％成功する
		;全体的に百合用の為押し倒しより激しくは無さげ？でもあまり気にせず押し倒しと同じで良いかも
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋人
				PRINTFORML 「더는 참을 수 없어, %CALLNAME:MASTER%...」
				PRINTFORML 「더... 나를 더 꼭 안아줘, 제발...」
				PRINTFORMDL 메이링은 아이처럼 응석받고 싶어하며 당신에게 매달리며 간절하게 말한다.
				PRINTFORML 「후와앙, 이거 좀 너무 부드러운 거 아니야...?」
				PRINTFORMDL 그녀의 눈은 완전히 녹아내렸고, 몸을 당신에게 휘감았다.
				PRINTFORML 「당신의 손길을 더 느끼고 싶어...」
				PRINTFORMW 「기분 좋아? ...%CALLNAME:MASTER%%UNICODE(0x2665)%」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「하아... 하아...」
				PRINTFORML 「잠깐만 참아줘... 더는 못 견디겠어...」
				PRINTFORMDL 매일링은 눈에 눈물을 고한 채 당신을 올려다본다.
				PRINTFORMDL 그녀의 입술이 떨리며 당신에게 키스해달라고 애원하고, 허벅지를 비빈다...
				PRINTFORMW 「당신이 나를 이렇게 만들었잖아 %CALLNAME:MASTER%, 그러니까 괜찮은 거지...?」
			ELSE
				PRINTFORML 「%MOAN()%, 더는 못 참겠어...」
				PRINTFORMDL 메이링은 한계에 다다른 듯하다――
				PRINTFORMDL 당신이 생각하기도 전에 갑자기 안긴다.
				PRINTFORML 「더, 더, 당신의 것을 더 느끼고 싶어...」
				PRINTFORMDL 그녀의 매력적인 입술이 살짝 벌어지고, 그 안에서 그녀의 매혹적인 혀와 약간의 붉은 머리카락이 붙어 있는 것이 보인다.
				PRINTFORMDW 그녀의 얼굴을 보니 앞으로 무슨 일이 일어날지 알 수 있다...
			ENDIF
			RETURN 1
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
				;抜け出した
				IF TALENT:恋人
					PRINTFORML 「나아, 여기서 그만둘 거야...?」
					PRINTFORML 「조금만 더, 제발! 뭐든지 할게...!」
					PRINTFORMDL 메이링은 홍당무처럼 상기된 가슴을 당신에게 밀착시키며 설득하려 한다.
					PRINTFORML 「......알겠어.」
					PRINTFORMW 「다음엔... 끝날 때까지 나를 사랑해 줘, 알겠지...?」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「아니야, 그치만! 어떻게 지금 그냥 끝낼 수가 있어～...」
					PRINTFORML 「충분하지 않아. 정말 이게 전부인 거야?」
					PRINTFORML 「여전히... 안 되는 거야?」
					PRINTFORMDL 메일링은 네 사타구니를 손가락으로 위아래로 쓸어내린다.
					PRINTFORMDL 네가 그녀의 손을 잡자, 그녀는 마침내 깨닫는다.
					PRINTFORML 「아, 안 되는 거구나. 알겠어.」
					PRINTFORMW 「...다음엔 부디 충분한 ”보상”을 해줘야 해, 알았지?」
				ELSE
					PRINTFORML 「흐음... 이게... 끝인가?」
					PRINTFORML 「실례지만, 제가 거기서 저 자신을 잃은 것 같습니다.」
					PRINTFORMW 「만족스럽진 않지만... 견뎌야겠군요.」
				ENDIF
				RETURN 1
			CASE 1
				;抱き着きモード満足終了
				IF TALENT:恋慕
					PRINTFORML 「...%MOAN()%. 나를 정말 응석받이로 만들었어...」
					PRINTFORML 「정말 고마워요, %CALLNAME:MASTER%♪」
					PRINTFORMDW 메일링의 눈은 여전히 풀려 있으며, 당신이 서로에게서 떨어질 때 입맞춤을 나눈다.
				ELSE
					PRINTFORML 「...휴우. 이제 완전히 진정했어, 정말 고마워!」
					PRINTFORMW 「당신을 이렇게 안고 있는 게 꽤 좋은걸, %CALLNAME:MASTER%♪」
				ENDIF
				RETURN 1
			CASE 2
				;抱き着きモード強制終了。
				;誰かが入ってきた中断時？っぽいんだけど振り払われた時で書いてる感じの口上も有るしよく分からん
				IF TALENT:恋慕
					PRINTFORML 「...아안, 나 더 안아줬으면 좋겠어～...」
					PRINTFORML 「다음엔 제대로 하자, %CALLNAME:MASTER%... 약속해?」
					PRINTFORMDW 메이링은 약간 실망한 듯 당신을 올려다보며 손가락으로 가슴을 원을 그리듯 문지른다...
				ELSE
					PRINTFORML 「우으, 우리에게 선택권이 없다면...」
					PRINTFORMDW 메일링은 분함으로 볼을 귀에 붙인 채 당신을 올려다본다...
				ENDIF
				RETURN 1
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
				;好きにして状態から抜け出せなかった
				IF TALENT:恋慕
					PRINTFORML 「하아, 귀엽네...」
					PRINTFORML 「내 손아귀에서 벗어나려고 하다니, 아직 백 년이나 이르지...? Aann%UNICODE(0x2665)%」
					PRINTFORMDL 메이링은 당신의 탈출을 막으며 더욱 꽉 끌어안고 섬뜩하게 미소 짓는다.
					PRINTFORML 「자, 내 몸에서 벗어나고 싶다면 먼저 그것과 섹스를 해야지...%UNICODE(0x2665)%」
					PRINTFORMDW 그녀의 미소가 이내 씨익 웃는 표정으로 변하고, 당신은 도망칠 방법이 없다.
				ELSE
					PRINTFORML 「후훗, 그것만 가지고는 도망칠 수 없어～...」
					PRINTFORML 「아안, 나를 이렇게 만든 건 너잖아, 그러니까...」
					PRINTFORML 「제대로 책임져 주지 않을래...?」
					PRINTFORMDW 메이링은 도발적으로 미소 지으며, 네가 그녀의 손아귀에서 벗어날 방법은 없어...
				ENDIF
				RETURN 1
			CASE 2
				;欲求不満が高くて抜け出せなかった
				IF TALENT:恋慕
					PRINTFORML 「그건 안 돼, 아직 부족해, 하아, 하...」
					PRINTFORML 「너무 아파서 미쳐버릴 것 같아...」
					PRINTFORML 「도망치고 싶다면, 터무니없을 만큼의 사랑을 나에게 줘...!」
					PRINTFORMDW 쾌락에 빠진 메이링이 너를 제압하고, 도망칠 방법은 없다...
				ELSE
					PRINTFORML 「하아, 아직 만족스럽지 않아... 더, 더...」
					PRINTFORMW 「자, 네가 하고 싶은 대로 계속해, 괜찮아... 너무 짜릿해서 견딜 수가 없어...!」
				ENDIF
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
