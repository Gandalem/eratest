				CASEELSE
					PRINTFORML 「오늘은 이쯤 하는 걸로 하자.」
					PRINTFORMW 「집에 갈 때 조심해. 그럼...」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		PRINTFORMW 「...음음.」
