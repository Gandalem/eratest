;==================================================
;Custom code, reenabled

@M_KOJO_EVENT_K58_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;時止め中ではない
	IF !FLAG:70
		;睡眠時
		IF CFLAG:TARGET:睡眠
			PRINTDATAL
				DATAFORM 「음... 으응... 후우...」
				DATAFORM 「자... 잔다...」
				DATAFORM 「쿨쿨... 스윽... 후우...」
				DATAFORM 「음... 푸하...ㄴ...」
			ENDDATA
			RETURN 1
			;泥酔時
		ELSEIF TCVAR:TARGET:泥酔
			PRINTDATAL
				DATAFORM 「누냐? ... 간지러워... 에헤헤...」
				DATAFORM 「뭐어-? 내 옷 벗는 거 도와주는 거야? ...음, 그럼 내가 생각하기엔～ 후업~」
				DATAFORM 「...아아~ 더워ー ...후우? 우헤헤, 시원하고 상쾌해...」
				DATAFORM 「하아~ 아아~ 벗어주고 있어ー 하하, 끅...! 아하하하~」
			ENDDATA
			PRINTFORMDL 취한 메이링은 네가 그녀의 옷을 벗기는 것을 개의치 않는다.
			PRINTFORMDL 뜨거운 몸이 벗겨지자 그녀의 머리가 어지러워진다.
			RETURN 1
		ENDIF
	ENDIF
	;時間停止時かつパンツ関連以外
	IF FLAG:70 && ARG != 3
		IF OUTROOF(CFLAG:MASTER:現在位置)
			IF IN_ROOM_NUMBER(CFLAG:MASTER:現在位置) > 2
				PRINTFORMD 야외에서 그리고 모든 사람 앞에서, 당신은
			ELSE
				PRINTFORMD 야외에서, 당신은
			ENDIF
		ELSE
			IF IN_ROOM_NUMBER(CFLAG:MASTER:現在位置) > 2
				PRINTFORMD 모두 앞에서 너는
			ELSE
				PRINTFORMD 당신
			ENDIF
		ENDIF
		SELECTCASE ARG
			;全裸にする
			CASE 0
				PRINTFORMDL  방어할 수 없는 메이링의 나체 모습을 드러낸다.
				;下着姿にする
			CASE 1
				PRINTFORMDL  무방비 상태의 메이링의 속옷을 노출한다.
				;半脱ぎにする
			CASE 2
				PRINTFORMDL  무방비한 메이링의 옷을 벗긴다.
		ENDSELECT
		PRINTFORMDL 그녀를 그런 상태로 볼 수 있는 유일한 존재라는 생각이 당신 안에서 불을 지핀다.
		;天気ネタを取り敢えずここに入れてみる
		IF OUTROOF(CFLAG:MASTER:現在位置)
			SELECTCASE TIME:5
				;雨・霧雨
				CASE 4, 6
					PRINTFORMDL 시간 속에 얼어붙은 빗방울들이 보석처럼 그녀를 장식하고 있다.
					;霧
				CASE 7
					PRINTFORMDL 안개 속의 맨살이 그녀에게 비현실적인 아름다움을 선사한다.
					;大雨
				CASE 5
					PRINTFORMDL 얼어붙은 소나기가 모든 것을 조금 초현실적으로 만들었다...
					;雪・細雪・霧雪・みぞれ
				CASE 8, 10, 11, 12
					PRINTFORMDL 주변을 춤추는 하얀 눈송이가 그녀의 아름다움을 더욱 돋보이게 하지만, 꽤 추워 보인다.
					;吹雪・あられ
				CASE 9, 13
					PRINTFORMDL 이런 눈보라 속에서 이 광경을 경배할 수 있는 것은 이 능력이 있는 자들뿐이었다.
			ENDSELECT
			SIF FLAG:異常気象 == 9 || FLAG:異常気象 == 10
				PRINTFORMDL 솔직히 이 날씨에 밖에 서 있는 건 좋은 생각이 아니지만... 나쁘지도 않네.
		ENDIF
		PRINTW 
		RETURN 1
	ENDIF
	;↓ここから通常時
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;PRINTFORMW %CALLNAME:TARGET%を全裸にした	←の地の文の後に表示
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「모든 것을 벗으니... 이제 온몸으로 %조사처리(CALLNAME:MASTER,"를")% 느낄 수 있어.」
					PRINTFORML 「자, 그럼 망설이지 말고 사랑을 해보자, %CALLNAME:MASTER%%UNICODE(0x2665)%」
					PRINTFORMDW 메일링은 몸에 걸친 단 하나의 실밥도 없이 기대로 가득 찬 눈으로 당신을 바라본다...
				ELSEIF TALENT:恋慕
					PRINTFORML 「아아, 내 모든 옷이 벗겨졌어...」
					PRINTFORMDL 메일링의 곡선적이고 풍만한 몸이 당신에게 완전히 노출되어 있다.
					PRINTFORML 「내 몸은 아름다워...?」
					PRINTFORMDW 당신은 서둘러 고개를 끄덕이고, 그녀는 응답하며 미소 짓는다...
				ELSEIF TALENT:思慕
					PRINTFORML 「너무 많이 쳐다보지 말아 주세요...」
					PRINTFORML 「에... %조사처리(CALLNAME:MASTER,"가")% 저를 벌거벗은 채로 보시다니 좀 부끄럽네요...」
					PRINTFORMDW 메이링은 얼굴을 깊게 붉히며 손과 다리로 중요한 곳들을 가렸다...
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORML 「후후후, 분명 이 분위기가 더 좋아질 거야...」
					PRINTFORMDL 메이링은 매혹적인 다리를 드러내며 천천히 옷을 벗는다.
					PRINTFORMDL 결국 그녀는 옷들을 바닥에 떨어뜨리고 당신 쪽으로 돌아선다.
					PRINTFORMW 「자, 이제 %CALLNAME:MASTER%, 방해되던 옷들은 모두 사라졌어～」
				ELSE
					PRINTFORML 「우으, 전부 벗는 거 정말 부끄러워...」
					PRINTFORMDL 메이링은 옷을 벗으며 얼굴을 새빨갛게 물들인다.
					PRINTFORMW 「...있잖아, 내가 옷 벗는 게 얼마나 멋지다고 말하지 마...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;これも地の文の後に表示。時間停止中ではない場合、半脱ぎも含め地の文では自主的に脱いでる事に注意
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「음, 나를 속옷만 입은 걸 보고 싶다고...?」
					PRINTFORML 「상관없지만, 만약 옷을 다 벗으면 내 온몸으로 당신을 만질 수 있잖아―... 알지~」
					PRINTFORMDL 모든 옷을 속옷만 남기고 벗어 던진 메이링은 왜 그러냐며 웃는다.
					PRINTFORMW 「누가 알아? ...이렇게 서 있는 나를 보면 저항할 수가 없다는 거, 그렇지 않아? 후후.」
				ELSEIF TALENT:恋慕
					PRINTFORML 「속옷을 제외한 건 왜 그런 거야?」
					PRINTFORML 「...아니, 그냥 벌거벗어도 괜찮다고 생각해서...」
					PRINTFORMDL 메이링은 당신이 그녀의 머리를 쓰다듬자 사랑스럽게 얼굴을 붉힌다.
					PRINTFORMW 「...이대로 괜찮아? ...무우~」
				ELSEIF TALENT:思慕
					PRINTFORML 「속옷만 남기고 전부 벗으라고...?」
					PRINTFORML 「그냥, 그렇게 많이 벗으면 차라리...」
					PRINTFORMDL 하지만 미링을 바라보는 당신 앞에서 그녀는 얼굴이 새빨개지기 시작했다.
					PRINTFORMW 「아우~ ...내 속옷, 이상하지 않겠지...?」
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORML 「아아! 속옷 말고는 전부 벗었는데, 다음에 뭘 시킬지 궁금하네.」
					PRINTFORMDL ...스스로 벗고 싶다고 말하는군.
					PRINTFORML 「이리- 이래 하는 거 즐기니? ...조금씩 벗어보는 거?」
					PRINTFORMDW 메일링은 근육을 자랑하며, 나체일 때와는 완전히 다른 관능미를 보여준다.
					;PRINTFORMW 抱き付かれた弾みに、下着越しでも分かる柔らかい膨らみが%CALLNAME:MASTER%に押し当てられた
				ELSE
					PRINTFORML 「내가 속옷만 입은 상태에서 뭔가 할 거야...?」
					PRINTFORML 「상관 없긴 않은데... 늘어날지도 몰라...」
					PRINTFORMDW Meiling은 당신을 향해 몸을 돌리며, 무언가 해 주기를 기다리다가 얼굴을 붉혔다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「옷이 저렇게 흐트러져 있는 건 흥분되네, 응...」
					PRINTFORML 「...정말 도착적이구나, %CALLNAME:MASTER%.」
					PRINTFORMDL 가슴은 다른 사람들이 만지길 애원하는 방식으로 노출되어 있다고 말했지.
					PRINTFORML 「...그리고 내 속옷은 어때...?」
					PRINTFORMDW 메이링은 초조하게 허벅지를 비비며, 옷에 쓸리면서 그 자극을 가했다.
				ELSEIF TALENT:恋慕
					PRINTFORML 「...이거 괜찮아...?」
					PRINTFORMDL 네 요청대로 메일링의 옷은 흐트러져 있고, 상당히 야하다.
					PRINTFORMDL 그녀의 유두는 손가락 끝에 가려져 있을 뿐이고, 살짝 사이가 보인다.
					PRINTFORML 「음? 이거 충분히 에로틱해...?」
					PRINTFORMDW 대답은 말보다는 행동으로 하는 게 좋을 것 같다...
				ELSEIF TALENT:思慕
					PRINTFORML 「후아... 여기서 멈춰야 하나...?」
					PRINTFORML 「이건 벌거벗는 것보다 더 창피해, 전혀 진정할 수가 없어...」
					PRINTFORMDL 좋지 않니? 네가 묻자, 메이링의 눈은 항변했다.
					PRINTFORML 「제발... 내 가슴을 그렇게 계속 쳐다보지 말아줘...」
					PRINTFORMDW 너의 시선은 거기에 고정되어 있고, 문지기는 당황하며 몸을 뒤척였다...
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORML 「음, 반쯤 옷을 입고 하는 드레스 플레이를 원해?」
					PRINTFORMDL 메이링은 자신의 속옷을 간신히 가리며 의심스러운 표정으로 옷을 정리한다.
					PRINTFORML 「이거 꽤 에로틱하네... 하아...」
					PRINTFORML 「자, 그럼 내 거의 노출된, 부끄러운 건 어때...?」
					PRINTFORMDW 그녀의 대담한 생각에 자극받아, 너는 행동으로 답하기로 한다...
				ELSE
					PRINTFORML 「옷을 부분적으로만 벗기는 건 좀 변태적이야...」
					PRINTFORMDW 매일링은 반나체라는 것의 중요성을 배워야 할 것이다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								SELECTCASE RAND:2
									CASE 0
										PRINTFORML 「네 것을 대신 가지면 괜찮겠지.」
										PRINTFORMDL 그렇게 말하며 메이링은 네 속옷을 받고 자신의 것을 벗어던졌다.
										PRINTFORML 「좋아... 자, 이제 서로의 것이 생겼네... 응, 이거 꽤 재미있었어, 에헤헤～」
										PRINTFORMDL 말하지 않아도 그녀의 얼굴 표정에서 그것은 분명하게 드러났다.
										PRINTFORMW 「...자 그럼, 즐길 시간이야.」
									CASEELSE
										PRINTFORMDL 너와 메이링은 속옷을 벗고 서로 바꿔 입는다.
										PRINTFORML 「자! 이런 게 훨씬 더 흥분되게 해...」
										PRINTFORMDL 갑자기 그걸 벗겨지니 조금 간질거렸다.
										PRINTFORMDL 하지만 자신의 은밀한 곳을 드러내는 것이 훨씬 더 자극적이다.
										PRINTFORML 「응ー 나 벗었어ー... 이제 서로에게 아무것도 숨길 수 없어.」
										PRINTFORMDW 메이링의 다리가 마치 너를 부르는 것처럼 흥분해서 움찔거렸다.
								ENDSELECT
							ELSEIF TALENT:思慕
								PRINTFORML 「우으, 부끄러워...」
								PRINTFORML 「...나 혼자 하는 거면 진정될 수 없어, %CALLNAME:MASTER%, 당신 것도 벗어줘.」
								PRINTFORMDL 자신의 형상을 숨기며, 메이링은 당신의 속옷도 벗긴다.
								PRINTFORML 「저-저기. 이제 괜찮아.」
								PRINTFORMDW 무엇이 괜찮은 건지 확신할 수 없지만, 그녀는 만족스러워 보인다.
							ELSEIF TALENT:愛欲 || TALENT:セフレ
								PRINTFORMDL 당신과 메일링이 서로의 속옷을 벗겨낸다.
								PRINTFORMDL 하지만 당신의 손은 옷을 벗기는 것 이상의 용도로 사용된다.
								PRINTFORML 「Nbu, nnnhh～ Mu, nn, nhnhh...」
								PRINTFORMDL 당신은 그녀를 어루만지며 게이트키퍼의 엉덩이를 더듬고 쓰다듬는다.
								PRINTFORML 「Puhaa... Fuu, 당신의 냄새가 나를 현기증나게 해...」
								PRINTFORMDW 둘 다 숨을 헐떡이며 끝에 다다른다...
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕 || TALENT:思慕
								IF FIRSTTIME("パンツおくれ")
									PRINTFORML 「너를 도와줄 방법은 없어... 오늘은 예외로 해줄게, 알겠지?」
									PRINTFORMDL 그녀의 팬티에 손가락을 걸고, 당신은 천천히 허벅지를 따라 아래로 당긴다.
									PRINTFORMDL 끝내기쯤에는 얼굴이 그녀의 사타구니 바로 앞에 위치하게 되며 흥분되는 장면이다.
									PRINTL 
									PRINTFORML 「정말 음란하지만, 여전히 너무 흥분돼...」
									PRINTFORML 「아아~~! 아니야! 어쨌든, 네가 원하던 아주 소중한 팬티 여기 있어.」
									PRINTFORMDL 메이링은 음란하게 벗어둔 자신의 팬티를 건넸다.
									PRINTFORMDW 너는 그것을 부탁할 가치가 충분했음을 알았다.
								ELSE
									SELECTCASE RAND:3
										CASE 0
											PRINTFORML 「우으... 그렇게 쳐다보지 말아 줘, 부끄럽단 말이야...」
											PRINTFORMW 「...정말로 뭘 보고 이런 행동을 하는 거야...」
										CASE 1
											PRINTFORML 「언제나처럼, 난 이해가 안 가네. 그냥 옷 한 벌일 뿐이잖아?」
											PRINTFORMDL 당신이 그녀의 팬티를 벗기자 메이링은 쓴웃음을 짓는다.
											PRINTFORMDL 당신이 속옷을 강조하며 중요하다고 말하자, 그녀는 그저 어깨를 으쓱한다.
											PRINTFORML 「알겠어, 이해해... 너에게 뭔가 잘못된 게 있는 것 같아. 나에게도 마찬가지고...」
											PRINTFORMDW 그녀는 당신이 얼마나 만족하는지에 조금 놀란다...
										CASEELSE
											PRINTFORML 「어쨌든... 그들은 어떻게 하는 거야?」
											PRINTFORMDL 이것저것에, 그녀는 미소로 대답한다.
											PRINTFORML 「나, 나는 당신이 무슨 말인지 전혀 모르겠어요... 그냥 하고 싶은 대로 하세요...!」
											PRINTFORMDL 그녀는 더 이상 묻기엔 조금 부끄러워했다.
											PRINTFORMDW 너는 그것이 그녀의 반응 때문이라는 것을 언급하지 않도록 조치한다...
									ENDSELECT
								ENDIF
							ELSEIF TALENT:愛欲 || TALENT:セフレ
								PRINTFORML 「정말이지, 당신이 그들을 얼마나 소중히 여기는지 숨길 수가 없군요.」
								PRINTFORML 「좀 부끄럽네요... 나에게는 감출 게 없어요... 안...」
								PRINTFORMDL 메이링은 네 손을 잡고 그녀의 비밀스러운 곳으로 가져간다.
								PRINTFORML 「얼마나 더 따뜻하고 편안한지 느껴봐요... 후아, 그리고 속옷이 저절로 움직이지 않아요...」
								PRINTFORMDW 당신은 그녀의 민감한 살을 파고들며 팬티를 당길 때 미소 짓는다.
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕 || TALENT:思慕
								IF FIRSTTIME("パンツおくれ")
									PRINTFORML 「정말... 그런 걸 하고 싶다고...?」
									PRINTFORMDL 당신은 %PANTSNAME(EQUIP:TARGET:下半身下着２,TARGET)%를 향해 손을 뻗으며 Meiling의 %IT_THEM_PANTIES(PANTSNAME(EQUIP:TARGET:下半身下着２,TARGET))%를 자세히 응시한다.
									PRINTFORML 「아~ 아니야, 괜찮아. 아무 말도 듣고 싶지 않아. 그냥 쓸모없는 옷일 뿐이야.」
									PRINTFORMDL 그럼에도 불구하고 그녀는 꽤 흥분한 듯했다.
									PRINTFORML 「뭐라고?! 아무것도 없어! 돌려줘! 이 개자식아~돌려줘~!」
									PRINTFORMDW Meiling은 그것들을 되찾으려고 애쓰며 얼굴을 새빨갛게 물었지만, 당신은 재빨리 몸을 피한다.
								ELSE
									SELECTCASE RAND:3
										CASE 0
											PRINTFORML 「좋아. 그냥 너를 내버려 두는 게 맞겠지? ...젠장...」
											PRINTFORMDW 메이링은 당신이 자신의 %PANTSNAME(EQUIP:TARGET:下半身下着２,TARGET)%을 보는 반응에 초조하게 몸을 움직인다.
										CASE 1
											PRINTFORML 「...그렇게까지 원한다면 어쩔 수 없지, 됐어, 어쩔 수 없어.」
											PRINTFORMDL 메이링은 자신이 변태가 되지 않았음을 스스로 설득하려 변명을 늘어놓는다.
											PRINTFORMW 「~~! 내 속옷이나 가져가서... 이제 넘어가자...」
										CASEELSE
											PRINTFORML 「네가 그렇게 말해도, 이걸 누군가에게 팔려는 건 아니지? 맞지?」
											PRINTFORML 「모르는 사람이 이걸 갖게 하고 싶지 않아, 알겠지?」
											PRINTFORMDL 메이링은 진지한 어조로 당신에게 말을 걸지만, 그 모습이 사랑스럽게 들린다.
											PRINTFORMDW 당신은 그것들을 누구에게도 넘기지 않겠다고 약속한다 (인간에게는 말이다).
									ENDSELECT
									;潤滑分岐
								ENDIF
							ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
								PRINTFORML 「그렇게 열정적이고 의욕적으로 말하니, 그들을 얼마나 소중하게 생각하는 거야...?」
								PRINTFORML 「예를 들어, 바로 앞에 있는 것과 비교하면 어느 쪽이 더 나아?」
								PRINTFORMDW 메일링이 이상하게 너를 쳐다본다...
							ELSE
								PRINTFORML 「어떻게 이 변태를 그냥... 하아...」
								PRINTFORML 「...너 그 옷 안 입을 거지...?」
								PRINTFORMDW 메이링은 상황의 부조리함에 고개를 저었지만, 그것은 그녀의 마음속에 불타오르고 있었다...
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							;恋慕は貰えそうだけど一応
							IF TALENT:恋慕 || TALENT:思慕
								PRINTFORML 「내 속옷......?」
								PRINTFORML 「아니, 그건 너무... 있잖아.」
								PRINTFORMDW 어색한 긴장감이 방을 채우고, 메이링은 당신에게서 시선을 돌린다...
								;愛人愛欲は親密と従順の条件を満たしているので必要無し
							ELSEIF TALENT:セフレ || TALENT:ヤリマン
								PRINTFORML 「에르... 그걸 그냥 줄 순 없어...」
								PRINTFORML 「...팬티 대신 나한테 더 집중해 줘, 어서...」
								PRINTFORMDW 메이링은 다리를 벌리며 당신을 유혹하며 탐욕스럽게 말한다...
							ELSE
								PRINTFORML 「아니, 안 할 거야... 무슨 소리 하는 거야?」
								PRINTFORMDW 당연히 그녀는 거절한다.
							ENDIF
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
