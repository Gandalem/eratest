;Custom code, reenabled

@M_KOJO_EVENT_K58_29(ARG,ARG:1)
;口上主はTARGET
;ARGはTARGETの度胸で分岐
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;怒らせてしまった
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTDATAL
			DATAFORM 「넌 이해 못 해!」
			DATAFORM 「...당연히 화가 나지.」
			DATAFORM 「...좀 진정할 필요가 있는 것 같아.」
			DATAFORM 「조금? 이건 좀 이상한 수준이 아니라 훨씬 더 심각하지 않아?」
		ENDDATA
		IF TALENT:恋慕
			PRINTFORMDW 메이링은 아이처럼 입을 삐죽이고 있을 정도로 화가 난다...
		ELSEIF TALENT:思慕
			PRINTFORMDW 메이링이 당신을 노려본다...
		ELSE
			PRINTFORMDW 메일링이 당신에게 불쾌한 시선을 보낸다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;泣かせてしまった　[臆病]持ち
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		RETURN 1
	ENDIF
ENDIF
RETURN 1
