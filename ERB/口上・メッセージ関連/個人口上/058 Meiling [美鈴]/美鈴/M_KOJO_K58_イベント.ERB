@M_KOJO_EVENT_K58_16(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;添い寝を始めた（開始時）(存在せず
	;記入チェック
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 1
	;PRINTFORML
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;添い寝を終了した（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:TARGET:衰弱
			PRINTFORMDL 깨어나자, 당신은 메이링이 옆에서 잠든 것을 본다.
			PRINTFORMDL 평소와 다름없이, 그녀는 조용히 잠들어 있다.
			PRINTFORMDL 하지만 당신은 그녀에게 말을 걸고 싶은 기분이 전혀 들지 않는다.
			PRINTFORMDW 아름다운 그 모습을 응시하며, 당신은 천천히 일어난다.
		ELSE
			IF TALENT:恋人
				PRINTFORML 「음... 좋은 아침이야, %CALLNAME:MASTER%!」
				PRINTFORMDL 깨어나면 네 앞에 매일링이 있다.
				PRINTFORML 「음... %RANDKISS("kiss")%... 에헤헤, 기분이 정말 좋다...」
				PRINTFORMDW 둘 중 아무도 일어나지 않은 채 그녀는 미소 지으며 가볍게 입을 맞춘다.
			ELSEIF TALENT:恋慕
				PRINTFORML 「아... 깨웠니?」
				PRINTFORMDL 네가 눈을 뜨면, 메이링은 그녀의 땋은 머리를 준비하고 있었다.
				PRINTFORMDL 그녀는 그것을 하면서 살짝 몸을 구부리고 있었는데, 어린 소녀 같은 인상을 풍겼다.
				PRINTFORMW 「좋은 아침! 잘 자고 일어났니?」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;添い寝起床
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;untranslated as it's never called
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 깨어나면 메이링은 당신 옆에서 잠을 자며 숨을 쉬고 있다.
				PRINTFORML 「음무... %CALLNAME:MASTER%... 뉴우...」
				PRINTFORML 
				PRINTFORMDL 그녀가 몸을 뒤척이자, 그녀의 커다란 가슴이 거의 흘러넘칠 듯했다.
				PRINTFORMDL 당신이 곁눈질로 보니, 이번에는 그녀의 살집 있는 허벅지가 드러났다.
				PRINTFORMDL 이른 시간에 보기엔 참 견디기 힘든 광경이지만, 일단 메일링을 먼저 깨워야 했다.
				PRINTFORML 
				PRINTFORMW 「음... 5분만 더... 문야 문야...」
				PRINTFORMDL ...다시 그녀를 깨우려고 하면, 메이링은 당신 주위로 몸을 비튼다.
				PRINTFORML 「...안아줘...」
				PRINTFORMDW 그냥 그녀를 밀쳐버리는 게 최선일지도 모른다...
			CASEELSE
				PRINTFORMW 「아, 깨어 있었어?」
				PRINTFORMDL 당신은 메일링이 자신의 붉은 머리를 빗는 것을 알아차린다.
				PRINTFORMDL 그녀의 긴 머리카락은 아름답게 등 뒤로 흘러내리고, 희미한 향기가 공기를 가득 채운다.
				PRINTFORMW 「이렇게 길면 정말 신경 써야 하는데―」
		ENDSELECT
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;時止め終了時
;==================================================

@M_KOJO_EVENT_K58_17(ARG,ARG:1)
#DIM 絶頂回数カウント
#DIM 複数箇所絶頂判定
#DIM 同室者の人数
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ARG=1～3は排他
	;謎の快感		%CALLNAME:LOCAL%は、謎の快感にびくりと身を強張らせた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;絶頂回数カウント
		絶頂回数カウント = 0
		絶頂回数カウント += EX:無自覚Ｃ絶頂
		絶頂回数カウント += EX:無自覚Ｖ絶頂
		絶頂回数カウント += EX:無自覚Ａ絶頂
		絶頂回数カウント += EX:無自覚Ｂ絶頂
		絶頂回数カウント += EX:無自覚Ｍ絶頂
		;複数箇所絶頂判定
		複数箇所絶頂判定 = 0
		SIF EX:無自覚Ｃ絶頂 > 0
			複数箇所絶頂判定 += 1
		SIF EX:無自覚Ｖ絶頂 > 0
			複数箇所絶頂判定 += 1
		SIF EX:無自覚Ａ絶頂 > 0
			複数箇所絶頂判定 += 1
		SIF EX:無自覚Ｂ絶頂 > 0
			複数箇所絶頂判定 += 1
		SIF EX:無自覚Ｍ絶頂 > 0
			複数箇所絶頂判定 += 1
		IF CFLAG:K58C_謎の快感・絶頂回数 == 0
			PRINTFORML 「――――?!」
			PRINTFORML 「하아, 하아... 으윽....」
			PRINTFORMDL 메이링은 방금 자신을 공격한 사람이 누구인지 확신하지 못했다.
			PRINTFORMDL 그녀는 주변을 살폈다. 
			IF 複数箇所絶頂判定 > 1
				PRINTFORMD 즐거운 여운으로부터 머리를 비우려 애썼다.
			ELSEIF EX:無自覚Ｃ絶頂 > 0 || EX:無自覚Ｖ絶頂 > 0
				PRINTFORMD 다리 사이에서 느껴지는 이상한 쾌감에 홀렸다
			ELSEIF EX:無自覚Ａ絶頂 > 0
				PRINTFORMD 기이한 쾌감이 그녀의 항문을 공격하자 마법에 걸렸다.
			ELSEIF EX:無自覚Ｂ絶頂 > 0
				PRINTFORMD 이상한 쾌감에 가슴을 사로잡힌 채
			ELSEIF EX:無自覚Ｍ絶頂 > 0
				PRINTFORMD 기이한 쾌감에 입안이 마비되었다
			ENDIF
			PRINTFORMDW .
			;ちなみにCFLAG:ノーパンは１なら盗まれた状態、２なら本人に貰った状態
			IF CFLAG:ノーパン == 1
				;一日一回
				IF TCVAR:K58C_パンツ剥ぎ重複阻止 == 0
					IF CFLAG:K58C_パンツ剥ぎ回数 == 0
						PRINTFORML 「하?! 이게 무슨...」
						PRINTFORMDL 동시에 그녀는 자신의 속옷이 없다는 것을 알아차린다.
						PRINTFORMDW 그녀는 다른 사람들이 눈치채지 못하게 진정하려고 노력하지만, 도저히 평정을 찾을 수 없다.
					ELSEIF CFLAG:K58C_パンツ剥ぎ回数 < 10
						PRINTFORML 「...또...!」
						PRINTFORMDL 동시에 그녀는 속옷이 다시 없어졌음을 알아차린다.
						PRINTFORMDW 그녀는 스스로 진정하지만, 옷이 은밀한 곳에 스칠 때마다 얼굴을 붉힌다.
					ELSEIF CFLAG:K58C_パンツ剥ぎ回数 < 20
						PRINTFORML 「……도대체 뭐지--!」
						PRINTFORMDL 그녀는 또다시 속옷이 없다는 것을 알아차린다.
						PRINTFORMDW 용의자는 있지만, 증거가 없다.
					ELSEIF CFLAG:K58C_パンツ剥ぎ回数 == 100
						PRINTFORML 「...아이고, 그 모든 새 속옷 값 청구가 터무니없어지기 시작한다고 생각했을 때 말이야...」
						PRINTFORMDL 체념과 슬픔으로 가득 찬 눈으로, 메이링은 자신의 속옷이 또 사라진 것을 알아차린다.
						PRINTFORMDL 하지만 이번에는 즐거움도 그녀를 덮쳤다.
						PRINTFORMDW 이 일이 앞으로 몇 번이나 더 일어날까...? 그녀는 소리 내어 걱정했다.
					ENDIF
					TCVAR:K58C_パンツ剥ぎ重複阻止 = 1
					CFLAG:K58C_パンツ剥ぎ回数 += 1
					CFLAG:K58C_謎の快感・絶頂回数 += 絶頂回数カウント
					RETURN 1
				ENDIF
			ENDIF
			PRINTFORML 「뭐야, 대체...」
			PRINTFORMDW 메일링이 얼굴을 붉히며 어리둥절해하는 것을 보고 조용히 킥킥거렸다.
		ELSEIF CFLAG:K58C_謎の快感・絶頂回数 < 350
			PRINTFORML 「――――?!」
			PRINTFORML 「흐아, 하아... 또...」
			PRINTFORMDL 다시 공격을 당한 미링은 주변을 살핀다. 
			IF 複数箇所絶頂判定 > 1
				PRINTFORMD 즐거운 여운으로부터 머리를 비우려 애썼다.
			ELSEIF EX:無自覚Ｃ絶頂 > 0 || EX:無自覚Ｖ絶頂 > 0
				PRINTFORMD 다리 사이에서 느껴지는 이상한 쾌감에 홀렸다
			ELSEIF EX:無自覚Ａ絶頂 > 0
				PRINTFORMD 기이한 쾌감이 그녀의 항문을 공격하자 마법에 걸렸다.
			ELSEIF EX:無自覚Ｂ絶頂 > 0
				PRINTFORMD 이상한 쾌감에 가슴을 사로잡힌 채
			ELSEIF EX:無自覚Ｍ絶頂 > 0
				PRINTFORMD 기이한 쾌감에 입안이 마비되었다
			ENDIF
			PRINTFORMDW .
			IF CFLAG:ノーパン == 1
				;一日一回
				IF TCVAR:K58C_パンツ剥ぎ重複阻止 == 0
					IF CFLAG:K58C_パンツ剥ぎ回数 == 0
						PRINTFORML 「하?! 이게 무슨...」
						PRINTFORMDL 동시에 그녀는 자신의 속옷이 없다는 것을 알아차린다.
						PRINTFORMDW 그녀는 다른 사람들이 눈치채지 못하게 진정하려고 노력하지만, 도저히 평정을 찾을 수 없다.
					ELSEIF CFLAG:K58C_パンツ剥ぎ回数 < 10
