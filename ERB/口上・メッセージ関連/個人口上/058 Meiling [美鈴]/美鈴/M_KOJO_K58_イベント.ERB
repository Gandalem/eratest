@M_KOJO_EVENT_K58_12(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出される（怒り）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「...문지기(Gatekeeper)의 침실에 몰래 들어오는 건 담력이 필요하다고 인정해야겠어.」
		PRINTFORML 「설령 이게 오해라고 해도 성가신 일이야, 나를 화나게 하지 않도록 해, 알겠지...?」
		PRINTFORMDW 메이링은 분노로 빛을 내며 당신에게 자신에게 가까이 가는 것이 좋은 생각이 아니라고 말한다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入
	;この分岐以外は全て気付かれている状態
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		SELECTCASE RAND:3
			CASE 0 TO 1
				PRINTFORML 「음~, 음미음미...」
				PRINTFORMDL 방으로 들어서자, 메이링이 미소를 지으며 잠들어 있는 것을 본다.
				PRINTFORML 「후후후... 어때... 포기할래...」
				PRINTFORMDL 그녀는 꿈속에서 누군가를 때리는 듯했고, 가끔 몸을 뒤척였다.
				PRINTFORMDW 그녀는 나이트가운과 이불을 차버리며 가슴과 살집 있는 허벅지를 드러냈다...
			CASEELSE
				PRINTFORML 「...Nnn... \@ TALENT:恋慕 ? %CALLNAME:MASTER% # 사쿠야상 \@...」
				PRINTFORMDL 메이링은 이불을 끌어안고 잠든 채, \@ TALENT:恋慕 ? 당신의 # 사쿠야의 \@ 이름을 중얼거린다.
				PRINTFORML 「스피이ー... 스피이ー...」
				PRINTFORMDW 그녀가 잠들어 있는 모습, 무방비한 얼굴을 보며, 너는 그녀를 더욱 괴롭히고 싶어진다...
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응? 아, %CALLNAME:MASTER%구나.」
				PRINTFORML 「후와아... 무슨 일이야?」
				PRINTFORML 「...아, 나 괴롭히러 온 거야...? 캬～」
				PRINTFORMDW 메이링은 장난스럽게 미소 짓지만, 전혀 개의치 않는 것 같았다.
			CASEELSE
				PRINTFORML 「문유... 그렇게 나한테 겁주지 마세요, %CALLNAME:MASTER%.」
				PRINTFORML 「발로 날 날려버릴 뻔했다구... 후후, 보여줄까?」
				PRINTFORMDL 누워있는 그녀는 한쪽 다리를 들어 매끄러운 발목을 원을 그리며 돌린다.
				PRINTFORML 「곁에서 밤에 여자 방에 몰래 들어오다 뭘 하려고 했던 거야...?」
				PRINTFORMDW 메이링은 당신의 발로 쿡 찌르면서 미소를 짓는다.
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「Ah... %CALLNAME:MASTER%...」
				PRINTFORMDL 메일링은 당신이라는 것을 알고 안도하며 한숨을 쉬지만, 평소처럼 활기차 보이지는 않는다.
				PRINTFORML 「미안하지만 지금은 좀 쉬게 해줘...」
				PRINTFORML 「잠이 들면 바로 되살아날 텐데... 하지만...」
				PRINTFORMDW 그녀는 문장을 끝낼 새도 없이 다시 잠이 들었다.
			CASEELSE
				PRINTFORML 「음... 모두 좋은 아침이야...」
				PRINTFORMDL 무언가 잘못되었는지 물어본 후 메이링은 다시 침대에 쓰러진다.
				PRINTFORMDL 이미 지친 문지기는 베개에 머리를 대자마자 잠이 든다.
				PRINTFORMW 「...Zzz...」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		PRINTFORMDL 소리 없이 메일링의 방에 잠입하여 그녀의 침대에 다가갔다.
		PRINTFORML 「응... 뭐라고--?!」
		PRINTFORMDL 그녀는 어쩐지 너를 알아챈 것 같았다.
		PRINTFORMW 「내 침대에서 공격하려면 백 년이나 너무 이른 거야, 알잖아?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される（衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		PRINTFORML 「나 오늘 정말 피곤해.」
		PRINTFORMW 「용건이 있다면 기다려야 해... 우유우...」
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
