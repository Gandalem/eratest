@M_KOJO_EVENT_K58_24(ARG,ARG:1)
;口上主はLOCAL
;%CALLNAME:ARG%は(はにかみながら/おずおずと/困惑顔で)%CALLNAME:MASTER%の子を授かったことを報告してきた
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「음, 실례지만, %CALLNAME:MASTER%... 있잖아, 우리 %BABYCONDSTR(" a",58,1)% %BABYPLNOUN("child",58)%%COND_STR(" again",TOTAL_CONCEPTION_COUNT(58) > 1)%하게 될 것 같아.」
