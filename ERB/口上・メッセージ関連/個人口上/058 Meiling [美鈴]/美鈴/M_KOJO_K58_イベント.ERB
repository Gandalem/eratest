			ENDSELECT
		ELSEIF CFLAG:好感度 >= 1500 && CFLAG:信頼度 >= 300
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%− 아침이다ー」
