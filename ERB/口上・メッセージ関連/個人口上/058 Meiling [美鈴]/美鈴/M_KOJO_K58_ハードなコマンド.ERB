;==================================================
;144,放尿 - Urinate
;==================================================
@M_KOJO_MESSAGE_COM_K58_144
CALL M_KOJO_MESSAGE_COM_K58_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K58_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「You want me to... urinate?」
		PRINTFORMDW Meiling looks at you quizzically.
		PRINTFORMW 「Can't you just drink your own urine? Or better yet, go to Eientei?」
		PRINTFORMW 「...Oh. It's... not a medical thing. I see...」
		PRINTFORMDW Meiling, red-faced, squats down and spreads her legs.
		PRINTFORMW 「Nuuu... this is so embarrassing...」
		PRINTFORMW 「Can you... look away? At least until I start. It's hard to pee with someone watching.」
		PRINTFORMDW You avert your eyes until you hear a telltale hissing sound. You look back over to see Meiling urinating.
		PRINTFORMDW Her eyes are closed and she's breathing heavily.
		PRINTFORMDW Her urine pours out of her in a perfect arc and forms a growing puddle on the floor.
		PRINTFORMDW The flow slows to a trickle, and finally stops. Meiling opens her eyes and looks at you, beet-red.
		PRINTFORMW 「Just so you know, %CALLNAME:MASTER%... I'm not cleaning this up.」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMDW Meiling blushes as she urinates, but there's a smile on her face.
		PRINTFORML 「I'm still not quite used to doing this...」
		PRINTFORMW 「But if it makes you happy, %CALLNAME:MASTER%, I'll do it...」
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMDL Meiling sighs orgasmically as she urinates.
		PRINTFORMDW She fingers herself with one hand, not caring if she gets urine on her fingers...
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMDW Blushing, Meiling squats down and begins to urinate...
		RETURN 1
	ENDIF
ENDIF
RETURN 1

