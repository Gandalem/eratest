@M_KOJO_MESSAGE_COUNTER_K58_29
SELECTCASE TCVAR:カウンター行動の派生
	CASE 0
		PRINTFORML 「그러니까, 음... 돌아서 벽에 손을 대주세요.」
	CASE 1
		IF CFLAG:PLAYER:ローターA挿入 != 0
			;あなたがアナルにローター挿入時分岐
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 엉덩이에 로터가 박힌 것을 알고 아는 듯한 미소를 지으며 당신을 바라본다.
			IF TFLAG:パール入れた人 == TARGET
				PRINTFORML 「아... 내가 시킨 대로 정확히 따라줬구나. 감동이야.」
			ELSE
				PRINTFORML 「오, 와... 누가 너에게 이걸 하라고 했는지 모르겠지만, 딱 내가 필요했던 거야!」
			ENDIF
			PRINTL
		ELSEIF (EQUIP:MASTER:上半身上着１ || EQUIP:MASTER:上半身上着２ || EQUIP:MASTER:ワンピース || EQUIP:MASTER:着物 || EQUIP:MASTER:外衣) && EQUIP:PLAYER:下半身下着１ == 0 && EQUIP:PLAYER:下半身下着２ == 0
			;あなたがノーパンの時分岐
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신이 속옷을 입고 있지 않다는 것을 알아챈 후 미소를 지으며 당신을 바라본다.
			PRINTFORML 「오, 정말 파격적이네... 아래에 아무것도 안 입고 있다니 믿을 수가 없지만, 내 일이 더 수월해지겠어!」
			PRINTL
		ENDIF
		PRINTFORML 「알겠어, 부드럽게 하도록 노력하겠지만 아무것도 약속할 수는 없어... 아프면 말해줘.」
	CASE 2
		IF CFLAG:PLAYER:ローターA挿入 != 0
			PRINTFORML 「후욱하고 끝나버렸네... 로터가 꽤 효과적이었나 봐, 그런 걸까?」
		ELSE
			PRINTFORML 「그리고 순식간에 끝나버렸어... 조금이라도 더 버텨보는 게 좋을 것 같은데, 알잖아?」
		ENDIF
	CASE 3
		SELECTCASE BASE:PLAYER:精力
			CASE IS == 0
				;全部搾り取った
				PRINTFORML 「벌써 끝이야? 음, 계속하면 너만 아플 것 같으니 내일 이어서 하자!」
			CASE IS < MAXBASE:PLAYER:精力 /2
				;大半搾り取った
				PRINTFORML 「그게 내가 말하는 볼륨이야! 하지만 아직 여지는 더 있지, 맞지?」
			CASEELSE
				;少し搾り取った
				PRINTFORML 「꽤 많은 양을 마셨네, 잘했어! 하지만 여전히 에너지가 남아 있는 것 같아... 계속할까?」
		ENDSELECT
ENDSELECT
