@M_KOJO_SUCCESS_COM_K6_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K6_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K6_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, curiosity event.
	RESULT = 0
	TRYCALL K5_SANGETSUSEI_CURIOSITY
	SIF RESULT
		RETURN 1
	IF TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行 || CFLAG:6:1001 == 1
		IF FLAG:時間停止
		ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
			PRINTFORML 「………」
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:11
				;CASE 9
				;PRINTFORML
				;PRINTFORMW
				;CASE 8
				;PRINTFORML
				;PRINTFORMW
				;CASE 7
				;PRINTFORML
				;PRINTFORMW
				CASE 6
					PRINTFORML 「잠깐만 기다려 봐」
					PRINTFORML 루나가 딱 하고 손가락을 튕기자 주변의 소음이 사라졌다.
					PRINTFORML 「조용해져서 이야기하기 편하지?」
					PRINTFORMW 「그러니까 그…… 무슨 말을 해도 괜찮으니까……」
				CASE 5
					PRINTFORML 「그, %조사처리(CALLNAME:MASTER,"는")% 어떤 스타일의 여자가 취향이야?」
					PRINTFORMW 「…역시 어른스러운 여자가 좋은 거야……?」
				CASE 4
					PRINTFORML 「나는 %조사처리(CALLNAME:MASTER,"를")% 골탕 먹이는 걸 그만두지 않을 거야」
					PRINTFORMW 「그치만 %조사처리(CALLNAME:MASTER,"가")% 깜짝 놀라는 모습이 보고 싶은걸」
				CASE 3
					PRINTFORML 「저, 저기…… 우리 관계가 남들이 보기에는…… 어, 어떤 관계로 보일까?」
					PRINTFORML 「사이좋은 친구? ……그, 그렇네. 그렇게 보이겠지」
					PRINTFORMW 「……하아」
				CASE 2
					PRINTFORML 「스타한테서 장미를 받았는데…」
					PRINTFORML 「『루나에게는 이 장미에 가시가 없는 것처럼 보일까?』라더군」
					PRINTFORMW 「하아… 스타는 가끔 무슨 생각을 하는지 모르겠다니까」
				CASE 1
					PRINTFORML 「…저기, 뭔가 달라진 것 같다고 생각하지 않아?」
					PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 주의 깊게 살펴보니 루나는 검은 리본을 머리에 달고 있었다.
					PRINTFORMW 잘 어울린다고 %조사처리(CALLNAME:MASTER,"가")% 말하자 루나의 뺨이 발그레하게 물들었다.
				CASE 0
					PRINTFORML 「포오……」
					PRINTFORML 「…아, 미안해. 안 듣고 있었어」
					PRINTFORMW 「에또… 코이코쿠토랑 야만바 이야기였던가?」
				CASEELSE
					PRINTFORML 「요즘 %조사처리(CALLNAME:MASTER,"와")% 있으면 가슴이 두근거리는데 원인을 모르겠어…」
					PRINTFORMW 「설마 %CALLNAME:MASTER%한테 감기라도 옮은 걸까…?」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:9
				;CASE 7
				;IF DAY:2 == 3
				;PRINTFORML 「秋だったかしら。田んぼに干してあった稲わらを3人で振り回して遊んでたの」
				;PRINTFORML 「そしたらいきなり秋の神様が現れてお菓子くれたのよ。…不気味だったわ」
				;PRINTFORMW 「今でも会いに行ったらお菓子くれるのかな…」
				CASE 6
					PRINTFORML 「남자아이니까 똑바로 해야지」
					PRINTFORMW 「환상향은 여걸이 많으니까」
				CASE 5
					PRINTFORML 「어제는 두 사람 정말 너무했다니까. 나만 두고 도망쳐 버리다니」
					PRINTFORMW 「서니랑 스타, 그 정 없는 녀석들ー! ……%조사처리(CALLNAME:MASTER,"는")% 그런 짓 안 하겠지?」
				CASE 4
					PRINTFORML 「이렇게 가까이서 보니까 역시 우리랑은 다르네」
					PRINTFORMW 「키는 같아도 힘은 나보다 세고… 뭔가 옮길 때는 도와달라고 할까」
				CASE 3
					PRINTFORML 「소리를 계속 죽이기만 하면, 소리가 사라졌을 때 내가 근처에 있다는 걸 들키게 될까?」
					PRINTFORMW 「………맹점이었네」
				CASE 2
					PRINTFORML 「…%CALLNAME:MASTER%. 혹시 키가 좀 컸어?」
					PRINTFORMW 「우리 요정들은 성장 같은 건 하지 않으니까, 조금은 부러운걸」
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 유령이 무섭지 않아?」
					PRINTFORML 「나는 도대체 뭐가 무서운 건지 모르겠지만 무섭단 말이야…… 부들부들」
					PRINTFORMW 「전에는 유령 사냥을 할 정도였는데 말이야아」
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 왠지 느긋해 보이네」
					PRINTFORMW 「그러다간 텐구한테 납치당해 버린다구」
				CASEELSE
					PRINTFORML 「나랑 서니가 있으면 모습도 소리도 지울 수 있으니까」
					PRINTFORMW 「그렇게 생각해서 들킨 적이 셀 수도 없어…. 하아……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 3
					PRINTFORML 「올해는 평소보다 비가 많이 오는 것 같네에」
					PRINTFORMW 「무슨 이변이라도 일어나면 신나게 날뛸 수 있을 텐데」
				CASE 2
					PRINTFORML 「이래 보여도 %CALLNAME:MASTER%보다 훨씬 오래 살았다고」
					PRINTFORMW 「…라고 할까 봐, 할머니 취급하지 마!」	
				CASE 1
					PRINTFORML 「환상향에는 이제 좀 익숙해졌으려나」
					PRINTFORMW 「너무 익숙해져서 머리가 요괴 산의 무녀처럼 되어버려도 곤란하겠지만」
				CASE 0
					PRINTFORML 「나 말고 다른 요정을 만나보고 싶어?」
					PRINTFORML 「그렇다면 미혹의 대나무 숲이나 안개 호수에 가면 만날 수 있어」
					PRINTFORMW 「다만…… 호수의 빙정에게는 목숨이 아깝다면 가까이 가지 않는 게 신상에 좋을 거야」
				CASEELSE
					PRINTFORML 「장난치는 게 바로 요정의 사명이야」
					PRINTFORML 「라고 해도 역시 분위기 파악 정도는 할게」
					PRINTFORMW 「……내키면 말이야」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
