; Modular ERB: 個人口上/006 Luna [ルナ]/ルナチャイルド/M_KOJO_K6_依頼.ERB

@M_KOJO_IRAI_K6(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				CASE "一般依頼名"
					SELECTCASE SCENE
						CASE "依頼提示時"
							;依頼を持ちかけられる時
							PRINTFORML 「잠깐 괜찮아?」
							PRINTFORML 「그게…… 부탁하고 싶은 게 있는데 말이야.」
						CASE "依頼非受託時"
							;内容だけ見て受託しなかった時
							PRINTFORML 「그래... 뭐 어쩔 수 없나」
						CASE "依頼受託時"
							;依頼を受託した時
							PRINTFORML 「무리하지 마」
						CASE "依頼確認時"
							;[366]で依頼内容を依頼人に確認した時
							PRINTFORML 「내용을 다시 듣고 싶은 거야?」
						CASE "依頼破棄時"
							;受託した依頼を破棄する時
							PRINTFORML 「할 수 없는 건 할 수 없다고 말하는 것도 중요하네」
						CASE "依頼実行直前"
							;[367]で依頼を実行する時、実行処理の前に呼び出される
						CASE "依頼実行直後"
							;[367]で依頼を実行する時、実行処理の後に呼び出される
						CASE "成功報告時"
							;報告時（成功）
							PRINTFORML 「고마워 %CALLNAME:MASTER%님. 조금만 다시 봐봤어」
						CASE "失敗報告時"
							;報告時（失敗）
							;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
							PRINTFORML 「저기 %CALLNAME:MASTER%. 지난번에 부탁했던 거 잊어버린 거야?」
							PRINTFORML 「정말 기억 못 하는 거야?... 하아, 정말」
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		;固有依頼
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;個々の依頼名で分岐
			;SCENEのWAITに関する仕様
			;WAIT無しでよい　　　　："依頼提示時", "依頼非受託時", "依頼確認時", "依頼破棄時", "成功報告時", "失敗報告時"
			;
			;以下の2つは実際にはCARRYOUTでの地の文処理との比較検討が必要
			;WAITを入れたほうが適切："依頼実行直前", "依頼実行直後"
			CASE "固有依頼名"
				SELECTCASE SCENE
					CASE "依頼提示時"
						;依頼を持ちかけられる時
					CASE "依頼非受託時"
						;内容だけ見て受託しなかった時
					CASE "依頼受託時"
						;依頼を受託した時
					CASE "依頼確認時"
						;[366]で依頼内容を依頼人に確認した時
					CASE "依頼破棄時"
						;受託した依頼を破棄する時
					CASE "依頼実行直前"
						;[367]で依頼を実行する時、実行処理の前に呼び出される
					CASE "依頼実行直後"
						;[367]で依頼を実行する時、実行処理の後に呼び出される
					CASE "成功報告時"
						;報告時（成功）
					CASE "失敗報告時"
						;報告時（失敗）
						;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
				ENDSELECT
		ENDSELECT
	CASE "TARGET"
		;ここで表示されるSCENEは"依頼実行直前", "依頼実行直後"だけです
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
					;人物が鍵になっていた・もしくは場所にたまたま居合わせた
					SELECTCASE SCENE
						;TARGETが呼ばれるのはこのタイミングだけ
						CASE "依頼実行直前"
						CASE "依頼実行直後"
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE CSVCALLNAME(CLIENT_ID)
			;依頼者のCALLNAMEによる分岐（CSV準拠）
			CASE "依頼者"
				SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
					CASE "固有依頼名"
						SELECTCASE SCENE
							CASE "依頼実行直前"
							CASE "依頼実行直後"
						ENDSELECT
				ENDSELECT
		ENDSELECT
	CASE "NO_REPORT"
		;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
		;ここで表示されるSCENEは"依頼報告不要"だけです
		;SCENEが一つしか無いので分岐は不要
		;また、必ず依頼主の口上が呼ばれます
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
				CASE "お花に水をあげて"
					PRINTFORML 「무사히 물을 주신 것 같네. 큰일 날 뻔했어~」
					PRINTFORMW 「저거는 겉보기엔 별것 아닌 꽃이지만, 방심하면 공격해 오는 거거든」
				CASE "誰かの落とし物"
					PRINTFORML 「아무래도 가져다준 것 같네. 고마워」
					PRINTFORMW 「이걸로 %조사처리(CALLNAME:MASTER,"와")% 나는 공범이네♪」
					PRINTFORMW …저건 정말 분실물이었던 것인지 %조사처리(CALLNAME:MASTER,"는")% 불안에 떨었다.
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			CASE "固有依頼名"
		ENDSELECT
ENDSELECT
