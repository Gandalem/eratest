				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 
						PRINTFORMW 
					CASE 0
						PRINTFORML 루나는 %조사처리(CALLNAME:MASTER,"를")% 자꾸 흘깃거리며 보고 있다.
						PRINTFORMW (아아... 이상하게 자꾸 의식해 버리잖아!)
					CASEELSE
						PRINTFORML 루나는 %조사처리(CALLNAME:MASTER,"를")% 눈치채자 서둘러 머리카락을 손거울로 정리하기 시작했다.
						PRINTFORMW 
				ENDSELECT
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「있잖아 %CALLNAME:MASTER%. 오늘 아침 신문 읽었어?」
