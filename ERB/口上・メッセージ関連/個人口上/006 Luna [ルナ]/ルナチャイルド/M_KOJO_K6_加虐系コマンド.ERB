;==================================================
;102,蝋燭
;==================================================

@M_KOJO_MESSAGE_COM_K6_102
CALL M_KOJO_MESSAGE_COM_K6_102_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_102_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && CFLAG:睡眠
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 눈앞의 요정을 도망치지 못하도록 사지를 정성껏 묶는다.
		PRINTFORML 깨어난다 해도 요정이 이 구속을 풀 수는 없다.
		PRINTFORMW ……%조사처리(CALLNAME:MASTER,"가")% 무엇을 하려 해도 저항조차 할 수 없다.
		PRINTFORML 
		PRINTFORML 
		PRINTFORMW 「쿨…… 쿨……」
		PRINTFORML 
		PRINTFORMW 루나를 어떻게 농락할까 생각할 때마다, %조사처리(CALLNAME:MASTER,"의")% 천진난만한 미소가 자연스레 새어 나왔다.
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
