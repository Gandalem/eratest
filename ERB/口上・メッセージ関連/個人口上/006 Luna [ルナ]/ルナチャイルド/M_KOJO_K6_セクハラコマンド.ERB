;==================================================

@M_KOJO_SUCCESS_COM_K6_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K6_312
CALL M_KOJO_MESSAGE_COM_K6_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行 || CFLAG:6:1001 == 1
		IF FLAG:70
		ELSEIF CFLAG:睡眠
		ELSEIF TFLAG:193 == 99
			;拒絶(キス不可）
			PRINTFORML 루나에게 키스하려고 하기도 전에 뺨을 붙잡히며 거절당해 버렸다.
			PRINTFORMW 「……그렇게 아무렇지 않게 하지 마」
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「츄, 츄……」
					PRINTFORMW 「있... 있잖아, 더 안 해줄 거야?」
				CASE 0
					PRINTFORML 「키, 키스…?」
					PRINTFORML 「아, 아니잖아? 근데 부끄러…… 읏… %UNICODE(0x2665) *1%」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 루나의 말을 입술로 막았다.
				CASEELSE
					PRINTFORML 「음~… 쪽…」
					PRINTFORMW 「음무!? 푸핫! 갑자기 혀 넣지 마아~」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「응... 음으...」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 루나는 서로 서툰 키스를 주고받았다.
				CASE 0
					PRINTFORML 「음읍...」
					PRINTFORMW 「~~~~푸하! 키스가 너무 길잖아! 참기 대회도 아니라고...」
				CASEELSE
					PRINTFORML 「훗……응읏」
					PRINTFORMW 「왠지 어른 같은 느낌이 드네……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「어린아이 장난이라고 생각하면 내가 상처받을 거야……」
					PRINTFORMW 루나는 어깨를 떨면서 %조사처리(CALLNAME:MASTER,"를")% 노려보았다…….
				CASE 0
					PRINTFORML 「와, 내 입술을 감히 이래도 돼?!」
					PRINTFORMW 「이걸로는 그냥 보내주지 않을 거니까!」
				CASEELSE
					PRINTFORML 「뭐, 뭐 하는 거야 갑자기!」
					PRINTFORMW 루나는 얼굴을 새빨갛게 물들이며 %조사처리(CALLNAME:MASTER,"에게")% 달려들었다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
