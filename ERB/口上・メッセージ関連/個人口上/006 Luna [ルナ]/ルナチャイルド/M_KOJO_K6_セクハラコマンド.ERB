;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K6_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K6_310
CALL M_KOJO_MESSAGE_COM_K6_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行 || CFLAG:6:1001 == 1
		IF FLAG:70
		ELSEIF CFLAG:睡眠
		ELSEIF CFLAG:うふふ == 2
			SELECTCASE TCVAR:20
				CASE 70
					;クンニ強制
					PRINTFORML 
				CASE 35
					;スカート内見せつけ
					PRINTFORML 
				CASE 52
					;素股
					PRINTFORML 
				CASEELSE
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「야앗…… 그렇게 천천히 쓰다듬지 마……요오……」
					PRINTFORMW 루나의 민감한 부분에 가까워질 때마다 그녀의 몸이 움찔하며 부끄러운 듯 떨렸다.
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 아니었으면 걷어차고 가버렸을 텐데……응%UNICODE(0x2665) *1%」
					PRINTFORMW 루나는 뺨을 물들이며 %조사처리(CALLNAME:MASTER,"의")% 엉덩이를 쓰다듬는 손길을 받아내고 있다.
				CASEELSE
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 루나의 아담한 복숭아 엉덩이를 가리지 않고 쓰다듬고 있다.
					PRINTFORMW 「응윽… 빨리 끝내줘…… 응? %UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「당당하게 굴지 마!」
					PRINTFORMW 「그럼 살금살금 하는 건 괜찮잖아……라니, 그런 문제가 아니거든!」
				CASE 0
					PRINTFORML 「여자애한테 아무렇게나 만지면 안 돼」
					PRINTFORMW 「제대로 된 관계가 되기 전에는… 뭐라고 하게 만들려고 그래요!」
				CASEELSE
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 인사는 사람 엉덩이를 만지는 것이었나……?」
					PRINTFORMW 루나는 뺨을 끌어당기며 %조사처리(CALLNAME:MASTER,"의")% 손을 쳐냈다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「믿기지 않아……. 도대체 무슨 생각 하는 거야?」
				CASE 0
					PRINTFORML 「장난치는 걸로 생각해도 화낼 거야……!」
					PRINTFORMW 
				CASEELSE
					PRINTFORML 「무슨 생각 하는 거야 에치!」
					PRINTFORMW 
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
