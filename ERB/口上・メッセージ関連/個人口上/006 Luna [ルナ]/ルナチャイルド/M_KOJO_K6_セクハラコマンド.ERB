;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K6_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K6_311
CALL M_KOJO_MESSAGE_COM_K6_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行 || CFLAG:6:1001 == 1
		IF FLAG:70
		ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 루나에게 매달리려고 하기 전에 루나가 먼저 %조사처리(CALLNAME:MASTER,"의")% 팔에 매달려 왔다.
						PRINTFORMW 「데, 데이트잖아 그러니까 이쪽이 더 어울리잖아요?」
					CASE 0
						PRINTFORML 루나는 %조사처리(CALLNAME:MASTER,"에게")% 안기자 사랑스러워하며 뺨을 가져다댔다.
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 정말 따뜻하네」
						PRINTFORMW 「뺨이 차가운 사람은 마음이 따뜻하다고들 하지만……%조사처리(CALLNAME:MASTER,"는")% 그런 게 아닌데」
					CASEELSE
						PRINTFORML %조사처리(CALLNAME:MASTER,"와")% 루나는 밀착하듯이 껴안았다.
						PRINTFORMW 「응... 심장 소리가 들려. ...%조사처리(CALLNAME:MASTER,"를")% 느낄 수 있는 거야」
				ENDSELECT
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「이렇게 하고 있으면 연인처럼 보여요?」
						PRINTFORMW 「기왕 이렇게 된 거니까 보답으로... 에잇!」 꽉 안아온다.
					CASE 0
						PRINTFORML 「데이트의 답례라고 생각하면, 뭐 괜찮을까……」
						PRINTFORMW 루나는 조금만 기쁜 듯 %조사처리(CALLNAME:MASTER,"의")% 포옹을 받아들였다.
					CASEELSE
						PRINTFORML 「우웅……, 누군가에게 보여지면 어떻게 하려는 거야아……」
						PRINTFORMW 루나는 부끄러워하는 듯하지만
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「앗!?」 쿵!
						PRINTFORML 「갑자기 뭐 하는 거야아!」
						PRINTFORMW 루나가 놀란 반동으로 넘어뜨리고 말았다…….
					CASE 0
						PRINTFORML 「와아!…… %CALLNAME:MASTER%」
						PRINTFORML 「%CALLNAME:MASTER%…… 잠깐 저기에 앉아줘」
						PRINTFORML …%조사처리(CALLNAME:MASTER,"는")% 엄마 같은 루나에게 설교를 듣고 있다.
						PRINTFORMW 「이제…… 가벼운 마음으로도 안 안아도 돼. 깜짝 놀랄 딸도 있잖아」
					CASEELSE
						PRINTFORML 「！？」ﾄﾞﾝｯ
						PRINTFORML 루나는 %조사처리(CALLNAME:MASTER,"를")% 밀쳐버리고는, 멋쩍은 듯한 표정을 짓고 있다.
						PRINTFORMW 「아, 미안. …하지만 갑자기 껴안는 %조사처리(CALLNAME:MASTER,"가")% 잘못한 거야」
				ENDSELECT
			ENDIF
		ELSEIF CFLAG:睡眠
		ELSEIF CFLAG:うふふ == 2
			SELECTCASE TCVAR:20
				CASE 32
					;クンニ強制
					PRINTFORML 
				CASE 60
					;スカート内見せつけ
					PRINTFORML 
				CASE 73
					;素股
					PRINTFORML 
				CASE 85
					;V挿入する
					PRINTFORML 
				CASE 88
					;腰振りV
					PRINTFORML 
				CASE 86
					;だいしゅきホールド
					PRINTFORML 
				CASEELSE
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:恋慕 && BASE:MASTER:勃起 >= 1000
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「오늘은 꽤 응석을 부리네……!?」
					PRINTFORMW (아, 뭔가 단단한 게 꾸욱꾸욱 와닿아서……!)
				CASE 0
					PRINTFORML (%조사처리(CALLNAME:MASTER,"의")%, 오... 오칭칭.... 비벼지고 있어...?!)
				CASEELSE
					PRINTFORML 껴안긴 루나는 볼을 붉힌 채 시선을 돌리고 있다.
					PRINTFORMW 「저, 저기…… 그, 맞고 있는데……」
					;PRINTFORMW 当ててんのよ。
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「저도 안아봐도…… 괜찮지?」
					PRINTFORML 「응……」 꽉!
					PRINTFORMW 「……두근거리잖아. 이런 건」
				CASE 0
					PRINTFORML 「에엣, 에엣, 싫... 안 돼, 안 돼 %CALLNAME:MASTER%...!」
					PRINTFORML 「우린 아직 아이잖아, 그런 건 어른이 되어서...!」
					PRINTFORMW 루나는 어째서인지 수줍어하며 몸을 파르르 떨지만, 하는 대로 맡겨둔다.
				CASEELSE
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 루나를 공주님 안기로 보여 주었다.
					PRINTFORML 「와…… 설마 이런 일이 생길 날이 올 줄은」
					PRINTFORMW 「이대로 어딘가에 납치되어도 좋을지도……」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:4
				CASE 2
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 루나의 허리를 안아 올리고
					PRINTFORML 「에?」
					PRINTFORML 빙글빙글 휘둘러 날린다!
					PRINTFORMW 「꺄아아아악!?」
				CASE 1
					PRINTFORML 「오시키라만주우 같은 거 생각한다면 안 질 테니까」
					PRINTFORMW 「에잇 에잇!」
				CASE 0
					IF ABL:MASTER:戦闘能力 > 2
						PRINTFORML 	%조사처리(CALLNAME:MASTER,"는")% 가볍게 루나를 안아 올리는 것을 보여주었다.
						PRINTFORMW 「햐앗! %조사처리(CALLNAME:MASTER,"는")% 이렇게 힘이 센 거야……」
					ELSE
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 힘으로는 아직 무리라고……」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 루나를 들어 올리려고 하지만, 그 정도의 힘은 없다….
					ENDIF
				CASEELSE
					PRINTFORML 「저기, 부끄럽으니까 냄새 맡지 마!」
					PRINTFORMW 루나에게서 금목서 같은 달콤한 향기가 났다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 아기한테 돌아가 버렸어?」
					PRINTFORML 「하아, 아기띠도 가져올까?」
					PRINTFORMW 루나는 황당하다는 듯 한숨을 쉬었다.
				CASE 0
					PRINTFORML 「좀, 움직이기 힘들잖아요」
					PRINTFORMW 루나는 귀찮다는 듯 몸을 비틀고 있다.
				CASEELSE
					PRINTFORML 「뭐야? 재롱이라도 부리게?」
					PRINTFORML 「………」
					PRINTFORMW 「끝났어? 그럼 떨어져」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
