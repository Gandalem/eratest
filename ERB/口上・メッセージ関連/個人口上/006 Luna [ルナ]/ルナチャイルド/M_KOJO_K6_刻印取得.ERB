; Modular ERB: 個人口上/006 Luna [ルナ]/ルナチャイルド/M_KOJO_K6_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K6
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「아, 싫어…… 그만해 줘. 이런 거 하지 마…」
	ENDIF
ELSEIF TFLAG:22 == 2
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「아아아…… 죄송해요, 죄송해요……」
	ENDIF
ELSEIF TFLAG:22 == 3
	IF FLAG:時間停止
	ELSE
		PRINTFORML 「흐윽... 흐으... 아픈 거... 싫어...」
		PRINTFORMW 고통을 새긴 루나는 항상 무언가에 겁먹어 작은 몸을 떨고 있다.
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 「이거… 괜찮은… 걸까%UNICODE(0x2665) *1%」
	PRINTFORMW 루나는 갓 배운 쾌락에 당혹감을 보이고 있다.
	PRINTFORMW 황홀해하는 표정을 보니, 그것을 거부할 생각은 없는 듯하다.
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「내가 천천히 변하기 시작한 것 같아」
	PRINTFORMW 「이 기분 좋은 걸, 더 원하고 있다고 생각하니까…%UNICODE(0x2665) *1%」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORML 「빨리 날 만져줘…%UNICODE(0x2665) *1%기분 좋게 해줘…%UNICODE(0x2665) *1%」
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 따르는 건 현명한 선택일지도 몰라……」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 「점점 %조사처리(CALLNAME:MASTER,"가")% 나한테 하고 싶은 게 뭔지 알 것 같은 기분이 들어」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 죽으라고 말하면 난 죽을 거야」
	PRINTFORML 「몸도 마음도, %조사처리(CALLNAME:MASTER,"에게")% 다 바치고 싶다고 생각하니까」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 「무슨 생각 하는지는 모르겠지만, 난 %조사처리(CALLNAME:MASTER,"가")% 싫어졌으니까」
ELSEIF TFLAG:21 == 2
	PRINTFORML 「…사죄의 말은 듣지 않겠어」
	PRINTFORMW 「애초에 사과하는 정도로 끝날 일을 저질렀다고 생각하는 거야? 참 낙천적이네」
ELSEIF TFLAG:21 == 3
	PRINTFORML 「난 언제나 도망치는 게 늦지만… %CALLNAME:MASTER%로부터 도망칠 필요는 없겠네」
	PRINTFORMW 「언젠가 그 망가진 머리를 걷어차 줄게」
ENDIF
