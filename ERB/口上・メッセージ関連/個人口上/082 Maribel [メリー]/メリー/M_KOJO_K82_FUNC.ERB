;custom code

@M_KOJO_EVENT_K82_AFTERTRAIN_END(ARGS,ARG,ARG:1)
;デート後一回目
IF EXP:デート経験 > 0 && FIRSTTIME("MerryDateEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 朝食の準備をしていると彼が起きてきた。正に起き抜けといった感じの顔だ
	CALL SPTALK, [[メリー]], "笑顔", 1, "「あら、おはよう。もう少しで出来上がるから先に顔洗ってきていいわよ」", 1
	WAIT
	PRINTFORMW 彼の洗顔が終わる頃には準備は終わり二人で食卓を挟む
	PRINTFORMW 「昨日のデート、とても楽しかったわ。また行きましょうね？」
	PRINTFORMW そう言うと彼は喉にご飯を詰まらせてしまう。私が慌ててお茶を渡すとそれを一気に飲み干す
	PRINTFORMW 案の定、今度は嚥下に伴う熱に苛まれ、水を求めて走り去ってしまった
	PRINTFORMW どうやら彼にとって昨日の外出は、デートというほど意識したものではなかったらしい
	PRINTFORMW 私はその事実をほんの少しだけ残念だと思った
	PRINTFORML
	PRINTFORML
	PRINTFORML
;キス後一回目
ELSEIF EXP:キス経験 > 0 && FIRSTTIME("MerryKissEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 昨日彼とキスをした。男の人とするのは初めてだった
	PRINTFORML 蓮子とした時は、同姓だけど私達は好き合ってるんだから当然だ、といった感じだったのに
	PRINTFORMW 彼とキスをした時、私は心臓が爆発しそうな勢いだった
	PRINTFORML 彼の顔がすぐ目の前にあって、私の肩を抱いた手とか、繋がった唇から彼の温もりが感じられて
	PRINTFORMW 蓮子の唇よりもザラザラして変な感じだったけど、嫌ではない感触
	CALL SPTALK, [[メリー]], "通常", 1, "「あ、おはよう」", 1
	WAIT
	PRINTFORMW 今日は彼の方が早起きだったようだ。食卓にはいくらかの朝食が並べられている
	PRINTFORMW 彼は頬を赤らめて恥ずかしそうにそっぽを向きながら小さく『おはよう』と呟いた
	PRINTFORMW どうやら彼はそういう経験が豊富と言えるほどではないらしい
	PRINTFORMW きっと私も彼と同じような顔をしているのだろう
	PRINTFORMW だって、私もそういう意味でのキスは初めてなんだから
	PRINTFORML
	PRINTFORML
	PRINTFORML
;恋慕後一回目
ELSEIF TALENT:恋慕 && FIRSTTIME("MerryLoveEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	IF TALENT:恋人
		PRINTFORMW 最初はこんな事になるとは思わなかった
		PRINTFORMW 夢に迷い込んで彼に助けられて、何だか分からない異変に巻き込まれて
		;デート経験がある場合
		IF EXP:デート経験 >= 1
			PRINTFORMW 一緒に生活して、デートとかキスもして、いつの間にか恋人になって
		;デート経験が無い場合
		ELSE
			PRINTFORMW 一緒に生活していく内にいつの間にか恋人になって
		ENDIF
		PRINTFORMW そして今、私は本気で彼を好きなっている
		PRINTFORML ごめんなさい蓮子。私は最低の浮気者だわ
		PRINTFORMW ごめんなさい蓮子。やっぱり自分に嘘は吐けないわ
		CALL SPTALK, [[メリー]], "発情", 1, "「好きよ。大好き」", 1
		WAIT
		PRINTFORMW 彼が扉を開けると同時に言ってやった
		PRINTFORMW 何がどうなってるのか分からないという顔
		PRINTFORMW それはそうだ。朝一番に自分の部屋から出ようとしたら、目の前に私がいていきなり告白されたんだから
		PRINTFORMW 呆気に取られていた顔は見る見る内に真っ赤になっていく。湯気が出るのではというくらいだ
		PRINTFORMW その顔が余りに可愛くて、私は自分から唇を重ね抱き付いた
		PRINTFORMW どちらともなく唇が離れると彼は私を再び抱き寄せ、今度は彼から唇を奪ってくる
		PRINTFORMW そうして私達は時間を忘れるほど重なり続けた
	;恋人が無い場合
	ELSE
		PRINTFORMW 大変だ。全くもって大問題だ
		PRINTFORMW 私はきっと彼のことを本気で好きになってしまった
		PRINTFORMW ううん、きっとじゃなくて絶対に好きになった
		PRINTFORMW 彼と一緒にいる時は凄くドキドキするけど凄く安心できて、一人でいる時はいつも彼のことを考えている自分がいる
		PRINTFORMW でも私には蓮子がいる。彼女とは行き着く所まで行ってたわけじゃないけど、名実共に恋人だった
		PRINTFORMW 一緒に大学に通って、ご飯も食べて、一緒に旅行に行ったり同じベッドで寝たこともあった
		PRINTFORMW キスだって数えられないほどしたし、その……そういう事だってした
		PRINTFORMW とにかく私は蓮子が好きで、蓮子は私の一番だった
		PRINTFORMW 彼は……そう、言うなれば私は不思議の国に迷い込んだアリスで、彼は私を導く白兎
		PRINTFORMW 私がこの夢の世界で迷わないように助けてくれるパートナー
		PRINTFORMW そんな彼がいつの間にか私の一番になっていた
		PRINTFORMW 仕方ないけど諦めるしかないだろう
		PRINTFORMW いや、そんな風に言っては彼に失礼だ
		PRINTFORMW 私は彼が――%CALLNAME:MASTER%のことが好きだ
		PRINTFORMW だけど%CALLNAME:MASTER%はどうなのだろうか
		PRINTFORMW 彼の気持ちを知りたい。だけど怖くて知りたくない
		PRINTFORMW こんなのまるで三流の恋愛ドラマみたいだ
		PRINTFORML 
		PRINTFORMW いつかこの想いが伝わるだろうか
		PRINTFORMW 伝わったとしてどうにかなるのだろうか
		PRINTFORMW ただ確かな事は、例えこれが夢であったとしても私は彼が好きだということ
	ENDIF
	PRINTFORML
	PRINTFORML
	PRINTFORML
;恋慕+恋人で好感度が10000以上かつ蓮子を助手にしている
;なんつーかやっぱり蓮子を置いてけぼりにはできないんで作ってみる。
;蓮子に対する恋慕の有無を指定する文が分からないのでコメントアウト。分かれば解放する。
ELSEIF (TALENT:恋慕 && TALENT:恋人) && CFLAG:2 >= 10000 && FIRSTTIME("MerryRenkoShowdownEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 私は蓮子の部屋に来ていた
	PRINTFORMW 話したい事がある、そう言うと蓮子はまるで自分の家のように招き入れる
	;todo replace renko's speech with sptalk as well
	CALL SPTALK, [[メリー]], "通常", 1, "「急に来ちゃってごめんなさい」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『私とメリーの仲じゃない。で話ってのは彼のこと？』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「……よく分かったわね」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『そりゃあんた達の目を見れば分かるわ。目と目で通じ合ってるって感じだったよ』", "w")
	CALL SPTALK, [[メリー]], "怒り", 1, "「あのね蓮子――」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『聞きたくない』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「………」", 1
	WAIT
	PRINTFORMW 当然の言い分だ。好き合ってた人にいきなり新しい恋人が出来て乗り換えたいって言われれば、こうなるのは当たり前
	CALL CHARA_TEXT([[蓮子]], "『代わりに聞かせて欲しいんだけど、メリーはあの人をどう思ってる？』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「どう……って？」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『私とあの人、どっちを優先させるかってこと』", "w")
	PRINTFORMW 蓮子の言葉全てが重い。それでも私は自分の意思を自分の口で伝えなきゃいけない
	CALL SPTALK, [[メリー]], "発情", 1, "「私は……蓮子が好きよ。それは今でも変わらないわ」", 1
	WAIT
	;親愛または相愛を持ってる場合
	IF TALENT:妻
		CALL SPTALK, [[メリー]], "発情", 1, @"「でも彼は……%CALLNAME:MASTER%のことは、その……」/「あ……愛してるの」", 1
		WAIT
		PRINTFORMW 私の告白に蓮子は口をあんぐりとさせている
		CALL CHARA_TEXT([[蓮子]], "『なるほど……愛してるときたか……』", "w")
		PRINTFORMW 茶色の髪をがしがし掻きながら溜め息混じりに言う
		PRINTFORMW きっと呆れられてるんだろう。私のような若造が愛を語っているのだ
		PRINTFORMW しかも今まで恋人だった相手を前に言ってるのだから、殊更安っぽい言葉だ
	;親愛も相愛も付いてない場合
	ELSE
		PRINTFORMW 「でも彼はもっと好きなの。あの人を私以外の誰にも渡したくないのよ」
		CALL CHARA_TEXT([[蓮子]], "『なるほどねぇ』", "w")
		PRINTFORMW 茶色の髪をがしがし掻きながら溜め息混じりに言う
	ENDIF
	CALL CHARA_TEXT([[蓮子]], "『あーぁ、参ったわ。完敗だわ』", "w")
	PRINTFORMW 蓮子は床に寝転がり大の字になって言った
	PRINTFORMW その言葉には嫌味や刺々しいものは一切感じられない
	CALL SPTALK, [[メリー]], "通常", 1, "「蓮子……？」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], @"『まぁ%CALLNAME:MASTER%は優しいし面倒見も良いし、顔は普通だけど』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「怒ってないの？」", 1
	WAIT
	PRINTFORMW 蓮子は少し思案するように目を泳がせながら答えた
	CALL CHARA_TEXT([[蓮子]], "『そりゃ私がメリーの一番じゃなくなったのは悔しいけどさ』", "w")
	CALL CHARA_TEXT([[蓮子]], "『メリーが本気で惚れ込んだ相手なんでしょ？なら私はどうこう言わない』", "w")
	CALL CHARA_TEXT([[蓮子]], "『ちょっと嫌われるような言い方かも知れないけど、メリーが決めたことならそれで良いと思うの』", "w")
	CALL CHARA_TEXT([[蓮子]], "『だからメリーは私なんかに気を遣わないで、あの人の隣にいてあげなよ』", "w")
	CALL SPTALK, [[メリー]], "笑顔", 1, "「ありがとう……蓮子」", 1
	WAIT
	;蓮子が恋慕を持ってる場合
	IF TALENT:[[蓮子]]:恋慕
		CALL CHARA_TEXT([[蓮子]], "『でもそうなると私とメリーはライバルになるわけだ』", "w")
		CALL SPTALK, [[メリー]], "通常", 1, "「え？」", 1
		WAIT
		CALL CHARA_TEXT([[蓮子]], "『顔は普通だけど、ここぞって時に頼りになりそうだし、笑った顔が何というか……そう、母性をくすぐるのよね』", "w")
		CALL SPTALK, [[メリー]], "通常", 1, "「じゃあ、蓮子も？」", 1
		WAIT
		CALL CHARA_TEXT([[蓮子]], "『私達ってつくづく気が合うわね』", "w")
		CALL CHARA_TEXT([[蓮子]], "『いっそのこと二人で半分こしよっか！』", "w")
		CALL SPTALK, [[メリー]], "笑顔", 1, "「ふふ、それもいいかもね」", 1
		WAIT
	ENDIF
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW メリーが部屋にいなかったのでもしやと思い来てみれば、随分と仲良さそうに談笑している
	PRINTFORMW もう少し待っていても罰は当たらないだろう
ENDIF
TARGET = LOCAL

;ending
@M_KOJO_MESSAGE_ENDING_K82
CALL TRIPLEDOT("reverse:timed")
PRINTFORMW 目を覚ませばそこはいつもの風景だった
PRINTFORMW 立ち並ぶ高層ビル。遠くから聞こえるエンジンの音
CALL CHARA_TEXT([[蓮子]], "『お、起きた？』", "w")
PRINTFORMW どうやら寝てしまっていたらしい
PRINTFORMW 私は蓮子の肩に預けていた頭を戻すと、何か違和感のようなものを感じた
PRINTFORMW 今までずっと一緒だったはずなのに蓮子の温もりを懐かしく感じている
PRINTFORMW まるで蓮子の立ち位置に違う誰かが居座っていたような……
PRINTFORMW 私はそれを心地良く感じていたような……
PRINTFORMW きっと思い出せない長い夢を見ていたせいだろう
PRINTFORMW 今日も大学の講義が終わり蓮子と一緒に公園に来ていた
PRINTFORMW そしていつの間にか寝てしまっていた
PRINTFORMW 「お腹空いちゃったわ。何か食べに行きましょう」
CALL CHARA_TEXT([[蓮子]], "『いいねー。何処行こっか？』", "w")
PRINTFORMW 私と蓮子はベンチを空けて歩き始める
;ここから素質で分岐
IF TALENT:妻
	PRINTFORMW その日私は、まるで半身が無くなったような喪失感を抱きながら過ごした
	PRINTFORMW 以前蓮子としばらく会えなかった時期があったが、その時の寂しさの比ではないくらいだ
	PRINTFORMW そう、誰だか分からないけど、私には大事な人がいた気がする
	PRINTFORMW 自分よりも、蓮子よりも、世界中の何にも代え難い大事な人
	PRINTFORMW 会いたい。だけどそれが誰なのか私には思い出せない。その人が何処にいるのかも分からない
	PRINTFORMW それから私はずっと上の空で、
	CALL CHARA_TEXT([[蓮子]], "『何かあったの？　自分の僅かな余命を宣告されたような顔してるよ』", "w")
	PRINTFORMW とまで言われる始末だった
	PRINTFORMW そして今、私は自分のベッドに横たわっている
	PRINTFORMW ご飯を食べる気にもお風呂に入る気にもならない私は、服も着替えずにそのまま布団の中に潜り込む
	PRINTFORMW 半身を失った喪失感とその半身を何かと忘れた自分への苛立ちを抱えながらも、私は簡単にまどろみの中に落ちていった
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 暗闇の中で私は温もりを感じている。とても懐かしい温かさ
	PRINTFORMW 例えば、母の胎内に戻ったような……海の中に潜って何をするでもなく漂っている時のような、根本的な安心感
	PRINTFORMW 　
	PRINTFORMW 意識が覚醒すると、私は一切の衣服を脱ぎ捨てていた
	PRINTFORMW 目の前には同じく裸の男性が同じ布団で眠っている。私が失った半身がようやく戻ってきた
	PRINTFORMW 左手の薬指を優しく締め付ける感触。この感覚がこの上なく愛しい
	PRINTFORMW 私が彼の背中に腕を回すと、眠そうに目を細める。どうやら起こしてしまったようだ
	PRINTFORMW 「ううん、何でもないわ」
	PRINTFORMW どうしたのか、といった顔の彼にそう答えながらも、私は抱く力を一層強める
	PRINTFORMW 不意に私の背中に腕が回される。太くて逞しい、私の大好きな腕
	PRINTFORMW 私は彼に抱かれながら、また眠りについた
	PRINTFORMW もう喪失感も苛立ちも無い。あるのはただ、愛しい彼への愛情だけ
	PRINTFORML 
	PRINTFORML 
	PRINTFORMW 			メリーEND №1
ELSEIF TALENT:恋慕
	PRINTFORMW 結局私は違和感を拭えないまま一日を過ごした
	PRINTFORMW 蓮子と肩を並べて歩く時も、手を繋いだ時も、何処か違う誰かの存在を探している
	CALL CHARA_TEXT([[蓮子]], "『どうしたの？　キョロキョロして、探し物？』", "w")
	PRINTFORMW 「何だか大事な物を無くした気がするの。とても大事なんだけど、それが何か思い出せないのよ」
	CALL CHARA_TEXT([[蓮子]], "『また変な夢を見たせいじゃない？　あんまり気にすることも無いと思うけど』", "w")
	PRINTFORMW 「うん……」
	PRINTFORMW 蓮子にそう諭された後も私は知らない誰かを探し続けていた
	PRINTFORMW しかしその誰かは見付からず私は妙な焦燥感に駆られた
	PRINTFORMW 家に帰った後もしきりに周りを見たり、鳴りもしない電話を眺めたり
	PRINTFORMW 我ながら可笑しなものだと思う
	PRINTFORMW 時計は0時きっかり。いい加減寝なければ明日に障る
	PRINTFORMW 布団に潜り込み天井を見上げながら誰とも知らない誰かを想像した
	PRINTFORMW 「おやすみ、蓮子……おやすみ、誰かさん……」
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 緩やかに意識が覚醒していく中で、私はあることを思い出した
