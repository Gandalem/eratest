@M_KOJO_EVENT_K82_AFTERTRAIN_END(ARGS,ARG,ARG:1)
;デート後一回目
IF EXP:デート経験 > 0 && FIRSTTIME("MerryDateEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 아침 식사 준비를 하고 있자 그가 일어났다. 정말 잠에서 막 깬 듯한 얼굴이었다.
	CALL SPTALK, [[メリー]], "笑顔", 1, "「あら、おはよう。もう少しで出来上がるから先に顔洗ってきていいわよ」", 1
	WAIT
	PRINTFORMW 그가 세안을 마칠 무렵 준비는 끝났고 두 사람은 식탁을 사이에 두고 앉았다.
	PRINTFORMW 「어제 데이트, 정말 즐거웠어. 또 가자ね?」
	PRINTFORMW 그렇게 말하자 그는 목에 음식을 걸었고 내가 황급히 차를 건네자 그것을 단숨에 들이켰다.
	PRINTFORMW 예상대로 이번에는 삼키는 과정의 열기에 괴로워하며 물을 찾으러 달려가 버렸다.
	PRINTFORMW 아무래도 그에게 어제 외출은 데이트라고 생각할 정도는 아니었던 모양이다.
	PRINTFORMW 나는 그 사실이 조금 아쉽다고 생각했다.
	PRINTFORML
	PRINTFORML
	PRINTFORML
	;キス後一回目
ELSEIF EXP:キス経験 > 0 && FIRSTTIME("MerryKissEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 어제 그 남자랑 키스했어. 남자인 사람이랑 하는 건 처음이었거든.
	PRINTFORML 렌코랑 했을 때는, 동성인데 우리 서로 좋아하고 있으니까 당연하다는 느낌이었는데
	PRINTFORMW 그 남자랑 키스했을 때, 나는 심장이 폭발할 것 같은 기분이었어.
	PRINTFORML 그의 얼굴이 바로 눈앞에 있었고, 내 어깨를 감싼 손이나 맞닿은 입술에서 그의 온기가 느껴졌지.
	PRINTFORMW 렌코의 입술보다 거칠어서 이상한 느낌이었지만, 싫지는 않은 감촉이야.
	CALL SPTALK, [[メリー]], "通常", 1, "「あ、おはよう」", 1
	WAIT
	PRINTFORMW 오늘은 그쪽이 더 일찍 일어난 모양이다. 식탁에는 어느 정도 아침 식사가 차려져 있다.
	PRINTFORMW 그는 볼을 붉히며 부끄러운 듯 고개를 돌린 채 작게 「좋은 아침」이라고 중얼거렸다.
	PRINTFORMW 아무래도 그는 그런 경험이 풍부하다고 말할 정도는 아닌 것 같다.
	PRINTFORMW 분명 나도 그와 똑같은 표정을 하고 있겠지.
	PRINTFORMW 왜냐면 나 역시 그런 의미에서의 키스는 처음이니까.
	PRINTFORML
	PRINTFORML
	PRINTFORML
	;恋慕後一回目
ELSEIF TALENT:恋慕 && FIRSTTIME("MerryLoveEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	IF TALENT:恋人
		PRINTFORMW 처음에는 이런 일이 될 줄 몰랐다
		PRINTFORMW 꿈속에 빠져 그에게 도움을 받고, 어쩐지 모를 이상한 일에 휘말렸다
		;デート経験がある場合
		IF EXP:デート経験 >= 1
			PRINTFORMW 함께 생활하고, 데이트도 하고 키스도 하면서 어느새 연인이 되었다.
			;デート経験が無い場合
		ELSE
			PRINTFORMW 함께 생활하다 보니 어느새 연인이 되었다.
		ENDIF
		PRINTFORMW 그리고 지금, 나는 진심으로 그를 좋아하고 있다.
		PRINTFORML 미안해 렌코. 나는 최악의 바람둥이야.
		PRINTFORMW 미안해 렌코. 역시 나 자신에게 거짓말은 할 수 없어.
		CALL SPTALK, [[メリー]], "発情", 1, "「好きよ。大好き」", 1
		WAIT
		PRINTFORMW 그가 문을 열자마자 말해버렸다.
		PRINTFORMW 무슨 상황인지 모른다는 표정.
		PRINTFORMW 그럴 만도 하다. 아침 일찍 자기 방에서 나오려 했는데, 눈앞에 내가 있고 갑자기 고백을 받았으니까.
		PRINTFORMW 어안이 벙벙했던 얼굴은 순식간에 새빨개져 간다. 김이 날 것 같을 정도다.
		PRINTFORMW 그 얼굴이 너무 귀여워서 나는 나 스스로 입술을 포개고 달려들었다.
		PRINTFORMW 어느 쪽도 아닌 채 입술이 떨어지자 그는 나를 다시 끌어안으며, 이번에는 그가 내 입술을 빼앗는다.
		PRINTFORMW 그렇게 우리는 시간을 잊을 정도로 계속 서로에게 안겨 있었다.
		;恋人が無い場合
	ELSE
		PRINTFORMW 대단하다. 정말 큰 문제다
		PRINTFORMW 나는 분명 그를 진심으로 좋아해버렸다
		PRINTFORMW 아니, '분명'이 아니라 반드시 좋아하게 되었다
		PRINTFORMW 그와 함께 있을 때는 아주 두근거리지만 매우 안심되고, 혼자 있을 때는 언제나 그 생각을 하는 내가 있다
		PRINTFORMW 하지만 나에게는 렌코가 있었다. 그녀와 끝까지 간 건 아니었지만, 명실상부 연인이었다
		PRINTFORMW 함께 대학에 다니고, 식사도 하고, 같이 여행을 가기도 했으며 같은 침대에서 잔 적도 있었다
		PRINTFORMW 키스도 셀 수 없을 만큼 했고, 그…… 그런 일도 했다
		PRINTFORMW 어쨌든 나는 렌코를 좋아했고, 렌코는 나에게 가장 소중한 사람이었다
		PRINTFORMW 그는…… 그래, 말하자면 나는 이상한 나라에 빠진 앨리스이고, 그는 나를 이끌어주는 흰 토끼다
		PRINTFORMW 내가 이 꿈의 세계에서 길을 잃지 않도록 도와주는 파트너
		PRINTFORMW 그런 그가 어느새 나의 가장 소중한 사람이 되어 있었다
		PRINTFORMW 어쩔 수 없지만 포기해야겠지
		PRINTFORMW 아니, 그렇게 말하면 그에게 실례다
		PRINTFORMW 나는 그가――%조사처리(CALLNAME:MASTER,"를")% 좋아한다
		PRINTFORMW 하지만 %조사처리(CALLNAME:MASTER,"는")% 어떻게 될까
		PRINTFORMW 그의 마음을 알고 싶다. 하지만 두려워서 알고 싶지 않다
		PRINTFORMW 이건 마치 삼류 연애 드라마 같아
		PRINTFORML 
		PRINTFORMW 언젠가 이 마음이 전해질까
		PRINTFORMW 전해진다고 해도 어떻게 될까
		PRINTFORMW 다만 확실한 것은, 설령 이것이 꿈이라 할지라도 나는 그를 좋아한다는 것이다
	ENDIF
	PRINTFORML
	PRINTFORML
	PRINTFORML
	;恋慕+恋人で好感度が10000以上かつ蓮子を助手にしている
	;なんつーかやっぱり蓮子を置いてけぼりにはできないんで作ってみる。
	;蓮子に対する恋慕の有無を指定する文が分からないのでコメントアウト。分かれば解放する。
ELSEIF (TALENT:恋慕 && TALENT:恋人) && CFLAG:2 >= 10000 && FIRSTTIME("MerryRenkoShowdownEvent")
	CALL PRINT_FACE, [[メリー]], "笑顔", "服", "", ""
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 나는 렌코의 방에 와 있었다
	PRINTFORMW 할 말이 있다, 라고 말하자 렌코는 마치 자기 집처럼 맞이했다.
	;todo replace renko's speech with sptalk as well
	CALL SPTALK, [[メリー]], "通常", 1, "「急に来ちゃってごめんなさい」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『나랑 메리의 사이잖아. 무슨 이야기야, 그 사람 말이야?』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「……よく分かったわね」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『그건 너희들의 눈을 보면 알 수 있어. 눈과 눈이 통하고 있는 느낌이었어.』", "w")
	CALL SPTALK, [[メリー]], "怒り", 1, "「あのね蓮子――」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『듣고 싶지 않아』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「………」", 1
	WAIT
	PRINTFORMW 당연한 말이다. 사귀던 사람에게 갑자기 새로운 연인이 생겨서 옮기고 싶다고 하면, 이렇게 되는 건 당연하다.
	CALL CHARA_TEXT([[蓮子]], "『대신 들어줬으면 하는데, 메리는 그 사람을 어떻게 생각하고 있어?』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「どう……って？」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], "『나랑 그 사람, 누구를 우선시하느냐는 문제』", "w")
	PRINTFORMW 렌코의 모든 말이 무겁다. 그럼에도 나는 자신의 의지를 자신의 입으로 전해야만 한다
	CALL SPTALK, [[メリー]], "発情", 1, "「私は……蓮子が好きよ。それは今でも変わらないわ」", 1
	WAIT
	;親愛または相愛を持ってる場合
	IF TALENT:妻
		CALL SPTALK, [[メリー]], "発情", 1, @"「하지만 그는……%조사처리(CALLNAME:MASTER,"의")% 일은, 그……」/「아…… 사랑하고 있어」", 1
		WAIT
		PRINTFORMW 나의 고백에 렌코는 입을 떡 벌리고 있다.
		CALL CHARA_TEXT([[蓮子]], "『아하… 사랑하고 있었다니…』", "w")
		PRINTFORMW 갈색 머리를 쓸어 넘기며 한숨 섞인 목소리로 말한다.
		PRINTFORMW 분명 어이없어하고 있겠지. 나 같은 젊은 애가 사랑을 이야기하고 있으니.
		PRINTFORMW 게다가 지금까지 연인이었던 상대 앞에서 하는 소리니까, 유독 저렴한 말이네.
		;親愛も相愛も付いてない場合
	ELSE
		PRINTFORMW 「하지만 그는 더 좋아하는 사람이 있어. 그 사람을 나 이외의 누구에게도 주고 싶지 않은 거야」
		CALL CHARA_TEXT([[蓮子]], "『그렇구나』", "w")
		PRINTFORMW 갈색 머리를 휘저으며 한숨 섞인 목소리로 말한다.
	ENDIF
	CALL CHARA_TEXT([[蓮子]], "『아아, 지쳤네. 완패야.』", "w")
	PRINTFORMW 렌코는 바닥에 누워 대자로 말했다.
	PRINTFORMW 그 말에는 비꼼이나 날카로운 것이 전혀 느껴지지 않았다.
	CALL SPTALK, [[メリー]], "通常", 1, "「蓮子……？」", 1
	WAIT
	CALL CHARA_TEXT([[蓮子]], @"『뭐 %조사처리(CALLNAME:MASTER,"는")% 상냥하고 보살핌도 잘해주고, 외모는 보통이지만』", "w")
	CALL SPTALK, [[メリー]], "通常", 1, "「怒ってないの？」", 1
	WAIT
	PRINTFORMW 렌코는 잠시 생각하는 듯 눈을 이리저리 돌리며 대답했다.
	CALL CHARA_TEXT([[蓮子]], "『そりゃ私がメリーの一番じゃなくなったのは悔しいけどさ』", "w")
	CALL CHARA_TEXT([[蓮子]], "『메리가 진심으로 반한 상대겠지? 그렇다면 나는 아무 말 안 할 거야.』", "w")
	CALL CHARA_TEXT([[蓮子]], "『조금 싫어질지도 모르는 말투일지도 모르겠지만, 메리가 정한 거라면 그걸로 괜찮다고 생각해』", "w")
	CALL CHARA_TEXT([[蓮子]], "『그러니까 메리는 나 같은 애한테 신경 쓰지 말고, 저 사람 옆에 있어 줘.』", "w")
	CALL SPTALK, [[メリー]], "笑顔", 1, "「ありがとう……蓮子」", 1
	WAIT
	;蓮子が恋慕を持ってる場合
	IF TALENT:[[蓮子]]:恋慕
		CALL CHARA_TEXT([[蓮子]], "『하지만 그렇게 되면 나와 메리는 라이벌이 되는 거네』", "w")
		CALL SPTALK, [[メリー]], "通常", 1, "「え？」", 1
		WAIT
		CALL CHARA_TEXT([[蓮子]], "『얼굴은 평범하지만, 결정적인 순간에 의지할 수 있을 것 같고, 웃는 모습이 뭐라고... 그래, 모성애를 자극하는 거지.』", "w")
		CALL SPTALK, [[メリー]], "通常", 1, "「じゃあ、蓮子も？」", 1
		WAIT
		CALL CHARA_TEXT([[蓮子]], "『우리 정말 잘 맞는다니까』", "w")
		CALL CHARA_TEXT([[蓮子]], "『いっそのこと二人で半分こしよっか！』", "w")
		CALL SPTALK, [[メリー]], "笑顔", 1, "「ふふ、それもいいかもね」", 1
		WAIT
	ENDIF
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMW 메리가 방에 없어서 혹시나 하고 와보니, 꽤 사이좋게 담소를 나누고 있었다.
	PRINTFORMW 조금 더 기다려도 벌은 받지 않을 것이다.
ENDIF
