@M_KOJO_MESSAGE_COM_K82_65_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			;恋慕
			IF IS_FALLEN()
				PRINTFORMW 「제가 위에 올라가면 되는 거죠?」
				PRINTFORMW 메리는 %CALLNAME:MASTER%위에 걸터앉아 가슴에 손을 올린다.
				PRINTFORMW 「역시 자기 것이니까, 스스로 바쳐야 하죠」
				PRINTFORMW 「만약을 위해 묻는데, 제 첫 경험을 %조사처리(CALLNAME:MASTER,"에게")% 바쳐도 될까요?」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 자신의 가슴에 놓인 메리의 손을 부드럽게 잡았다.
				PRINTFORMW 「응, 으윽! 너무 아파... 아프지만, 역시 기뻐요...」
				PRINTFORMW 솟아오른 %조사처리(CALLNAME:MASTER,"의")% 페니스를 뿌리까지 삼킨 메리는 %조사처리(CALLNAME:MASTER,"의")% 가슴에 쓰러졌다.
				PRINTFORMW 「죄송해요, 정말 아파서 조금 더 이대로...」
			ELSE
				PRINTFORMW 「설마 이런 일이 될 줄은 몰랐어... 만약 무슨 일이라 생기면, 미안하지만 원망하게 해줘?」
				PRINTFORMW (미안해 렌코, 이제 돌아갈 수 없을 것 같아...)
				PRINTFORMW 「나의 첫 경험을 줄 테니까……」
			ENDIF
			RETURN 1
		ELSE
			PRINTFORMW 「제가 위에……」
			PRINTFORMW 「여자애한테 올라타지는 거 싫으려나?」
			PRINTFORMW 「좀, 부끄럽지만, 괜찮아……」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			IF RAND:3 == 0
				PRINTFORMW 「응읏%UNICODE(0x2665) *1% 정액 더 줘%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응읏%UNICODE(0x2665) *1% 아앗%UNICODE(0x2665) *1% 정액으로 미끌미끌해져 있어……%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「아앗 %UNICODE(0x2665) *1% 임신해 버릴지도... %UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:4 == 0
				PRINTFORMW 「응, 응! 아아! 하, 아앗!」
				PRINTFORMW 「이, 이 자세로, 내가 %조사처리(CALLNAME:MASTER,"를")%, 범하고 있는 것 같아서……」
				PRINTFORMW 「윽, 으음... 내 안이 기분 좋...은 걸까...?」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「응읏%UNICODE(0x2665) *1% 아직 세울 수 있지%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「좀 더엇%UNICODE(0x2665) *1% 좋아앗%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「아앗%UNICODE(0x2665) *1%자지읏%UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF TALENT:恋慕
			;前回のコマンドが正常位の場合
			IF TEQUIP:体位２ != TEQUIP:体位 && GROUPMATCH(TEQUIP:体位, 1)
				;なんとなくここもサドメリー
				PRINTFORMW 누워있던 메리를 안아 일으키고, 자신은 등을 대고 쓰러진다.
				PRINTFORMW 「이번엔 내가 움직이면 되는 거야? 후후, 이 체위로 한 걸 후회하게 해줄게...♪」
				PRINTFORMW 메리는 요염하게 웃으며 허리를 움직이기 시작했다.
				;前回のコマンドが後背位か背面座位の場合
			ELSEIF TEQUIP:体位２ != TEQUIP:体位 && GROUPMATCH(TEQUIP:体位, 2, 5)
				PRINTFORMW 메리의 허리를 잡고 옆으로 누운다.
				PRINTFORMW 「응아앗!? 힉, 응윽!」
				PRINTFORMW 지금까지와는 다른 갑작스러운 자극에 메리는 몸을 뒤틀었다.
				PRINTFORMW 허리를 밀어 올릴 때마다 메리의 힙이 형태를 바꾸며, %조사처리(CALLNAME:MASTER,"의")% 욕정을 더욱 부추겼다.
				;前回のコマンドが体面座位の場合
			ELSEIF TEQUIP:体位２ != TEQUIP:体位 && GROUPMATCH(TEQUIP:体位, 4)
				PRINTFORMW 메리의 포옹을 풀고 등을 대고 쓰러지자, 메리는 %조사처리(CALLNAME:MASTER,"의")% 가슴에 손을 대고 자신을 지탱한다.
				PRINTFORMW 「이거, 안쪽까지 들어오는데 %CALLNAME:MASTER%기분 좋아 보이는 모습이라 좀 좋은지도 몰라」
				PRINTFORMW 「그럼 움직이는구나... 응! 아, 음윽!」
				;それ以外
			ELSE
				IF !RAND:3
					PRINTFORMW 「이 체위, 내가 %조사처리(CALLNAME:MASTER,"를")% 범하고 있는 것 같아서 좀 흥분돼...♪」
					PRINTFORMW 메리는 요염하게 미소 지으며 질의 압박을 강하게 했다.
				ELSEIF RAND:2
					PRINTFORMW 메리는 질을 강하게 조이며 천천히 허리를 흔든다.
					PRINTFORMW 「후후, 남자아이겠지? 참아렴 ♪」
				ELSE
					PRINTFORMW 「응, 하아, 후우앗! 그렇게 아래에서 박히면...!」
					PRINTFORMW 안쪽까지, 안쪽까지 허리를 밀어붙인다.
					PRINTFORMW 질의 주름을 밀어내고 살을 헤쳐 아이를 품는 곳으로.
					PRINTFORMW 그곳에 자신의 욕망을 토해내기 위해, %조사처리(CALLNAME:MASTER,"는")% 필사적으로 메리를 탐했다.
				ENDIF
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응읏%UNICODE(0x2665) *1%자, %UNICODE(0x2665) *1%찔러줘%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「이런 걸로 나를 흥분시킬 수 있을까 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「더 큰 거 주세요%UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
