; Modular ERB: 個人口上/082 Maribel [メリー]/メリー/M_KOJO_K82_弾幕勝負.ERB
;==================================================
;弾幕勝負 custom code, added
;==================================================
;

@M_KOJO_MESSAGE_COM_K82_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;戦闘前
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		IF FIRSTTIME("MerryDanmakuDuel")
			PRINTFORML 「탄막 놀이? 그건 너희들의 장난이야?」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 메리에게 탄막 놀이의 기본적인 규칙이나 지식을 가르쳤다.
			PRINTFORML 「하지만 나는 탄막 놀이를 할 수 없잖아? 적에게 공격받았을 때는 어떻게 하면 돼?」
			PRINTFORMW 확실히 메리는 보통 사람이므로 싸우게 할 수는 없지만, 혼자서는 마음이 놓이지 않는 것도 사실이다.
			PRINTFORMW 문득 메리는 좋은 아이디어가 떠오른 듯 손뼉을 탁 쳤다.
		ENDIF
		PRINTFORMW 「그럼 제가 표적이 될 테니 당신이 적에게 공격하는 역할로 어때요」
		PRINTFORMW 그렇게 위험한 일은 할 수 없다고 했지만 메리는 끝까지 양보하지 않았고, 결국 그런 역할로 정해지고 말았다
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「당신도 꽤 싸움에 익숙해진 것 같네」
					CASE 1
						PRINTFORMW 「이 경우에는 이쪽으로 움직이는 게 패턴인데, 역시 읽혀버릴까?」
					CASE 2
						PRINTFORML 「도망치는 것도 꽤 익숙해졌네」
						PRINTFORMW 「시험 삼아 승부해 볼래?」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「이건 좋은 다이어트가 되겠지만, 맞으면 아프다는 게 문제네」
					CASE 1
						PRINTFORMW 「도망치는 것만으로도 힘들다...」
					CASE 2
						PRINTFORMW 「하아... 꽤 힘든 거네...」
				ENDSELECT
			CASE 0
		ENDSELECT
	ENDIF
	IF ARGS == "Pichun"
		;RESULT:8 for player's lives
		PRINTFORMW 「벌써 지쳤어? 자, 힘내!」
	ENDIF
	PRINTFORML
	SELECTCASE RAND:3
		CASE 0
			PRINTFORMW 「우선 스트레칭부터 하자.」
		CASE 1
			PRINTFORML 「탄막 놀이 같은 건 뭔가 스포츠 같네」
			PRINTFORMW 「나에게도 쓸 수 없는 걸까」
		CASE 2
			PRINTFORMW 「이쪽? 하지만 이쪽으로 움직이는 편이...」
	ENDSELECT
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 1 TO 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「체력도 붙었고, 나도 도움이 되고 있잖아?」
					CASE 1
						PRINTFORML 「가끔은 실전을 상정해서 연계 연습을 하고 싶네.」
						PRINTFORMW 「다음에 누군가에게 도움을 청해 볼까요.」
					CASE 2
						PRINTFORML 「행동에 변화를 주지 않으면 금방 읽혀버릴 거야」
						PRINTFORMW 「더 노력해야겠네」
				ENDSELECT
			CASE 0
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
