;==================================================
;弾幕勝負 custom code, added
;==================================================
;
@M_KOJO_MESSAGE_COM_K82_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;戦闘前
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		IF FIRSTTIME("MerryDanmakuDuel")
			PRINTFORML 「弾幕ごっこ？　それは貴方達の遊びなの？」
			PRINTFORMW %CALLNAME:MASTER%はメリーに弾幕ごっこの基本的なルールや知識を教えた
			PRINTFORML 「でも私は弾幕ごっこできないじゃない？　敵に襲われた時はどうすればいいの？」
			PRINTFORMW 確かにメリーは普通の人間だから戦わせるわけにはいかないが、自分一人では心許ないのも確かだ
			PRINTFORMW ふとメリーは名案を思い付いたように手をぽんと叩いて、
		ENDIF
		PRINTFORMW 「それじゃ私が的になるから貴方が敵に攻撃する役でどうかしら」
		PRINTFORMW そんな危険な事はできないと言ったがメリーは断固として譲らず、結果そういう役割に落ち着いてしまった
		RETURN 1
	ENDIF
	
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「貴方も随分戦い慣れてきたみたいね」
					CASE 1
						PRINTFORMW 「この場合はこっちに動くのがパターンだけど、やっぱり読まれちゃうのかしら？」
					CASE 2
						PRINTFORML 「逃げるのにも大分慣れてきたわ」
						PRINTFORMW 「試しに勝負してみる？」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「これは良いダイエットになるだろうけど、当たると痛いのが問題ね」
					CASE 1
						PRINTFORMW 「逃げるだけでも大変だわ…」
					CASE 2
						PRINTFORMW 「はぁ…中々大変なのね……」
				ENDSELECT
			CASE 0
		ENDSELECT
	ENDIF
	
	IF ARGS == "Pichun"
		;RESULT:8 for player's lives
		PRINTFORMW 「もうバテちゃったの？　ほらほら頑張って！」
	ENDIF
	
	PRINTFORML
	SELECTCASE RAND:3
		CASE 0
			PRINTFORMW 「まずは柔軟体操からね」
		CASE 1
			PRINTFORML 「弾幕ごっこってなんだかスポーツみたいね」
			PRINTFORMW 「私にも使えないのかしら」
		CASE 2
			PRINTFORMW 「こっち？　でもこっちに動いた方が……」
	ENDSELECT
	
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"

	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 1 TO 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「体力も付いてきたし、私も役に立ってるでしょ？」
					CASE 1
						PRINTFORML 「たまには実戦を想定して連携の練習をしたいわね」
						PRINTFORMW 「今度誰かに手伝ってもらいましょうか」
					CASE 2
						PRINTFORML 「挙動に緩急を付けないとすぐ読めれちゃうわ」
						PRINTFORMW 「もっと頑張らなきゃね」
				ENDSELECT
			CASE 0

		ENDSELECT
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

