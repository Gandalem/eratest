				CALL CHARA_TEXT([[紫]], "『아아, 어디선가 본 적 있는 아이인가 싶었는데... 밖에 있는 사람에게까지 손을 내미는 건 나쁜 사람이네.』", "w")
				PRINTFORMW 「(이 사람, 어딘가 본 것 같은 기분이 드네...) 당신은 누구? 왜 나를 알고 있는 거야?」
				CALL CHARA_TEXT([[紫]], "『후훗… 나는 너를 알고 있어, 너는 이제 나를 알게 될 거야. 지금은 그걸로 충분해.』", "w")
				CALL CHARA_TEXT([[紫]], @"『여기 있는 이상 당신도 나도 그저 %조사처리(CALLNAME:MASTER,"에게")% 복종하고 사랑받을 뿐이야, 당신도 알고 있겠지?』", "w")
				CALL CHARA_TEXT([[紫]], @"『그럼 시작해볼까, %CALLNAME:MASTER%』", "w")
