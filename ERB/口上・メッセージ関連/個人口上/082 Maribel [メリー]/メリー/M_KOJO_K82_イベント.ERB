			PRINTFORMW 「마음대로 말을 걸지 마. 하고 싶으면 네 마음대로 해.」
		ENDIF
		IF TALENT:恋慕
			CFLAG:82:1001 = 1
			CFLAG:82:翌日来訪 = 1
		ENDIF
	ENDIF
	IF ARG == [[紫]]
		IF GROUPMATCH(ARG:1, 2, 4) ;join in
