					CALL CHARA_TEXT([[蓮子]], "『메리한테는 미안하지만, 나도 같이 있을게.』", "w")
					PRINTFORMW 「렌코, 나는……」
					CALL CHARA_TEXT([[蓮子]], @"『됐으니까 됐다고. %조사처리(CALLNAME:MASTER,"를")% 독점하는 것이 무리라면』", "w")
					CALL CHARA_TEXT([[蓮子]], "『적어도 함께 사랑하고 사랑받는 것이 제일 좋은 거라고 생각해야지.』", "w")
				ENDIF
			ELSE
				IF RAND:3 == 0
					CALL CHARA_TEXT([[蓮子]], "『자, 시작할게... 본능대로 쾌락에 몸을 맡기고...』", "w")
					PRINTFORMW 「……? 렌코, 무슨 일이야?」
					CALL CHARA_TEXT([[蓮子]], "『또 분위기가 안 좋네. 뭐 됐어, 시작하자』", "w")
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아, 렌코... 응윽... 쪽...」
					CALL CHARA_TEXT([[蓮子]], @"『음... 큭, 안 돼 메리, %조사처리(CALLNAME:MASTER,"가")% 있는데 멋대로...』", "w")
					PRINTFORMW 「아, %CALLNAME:MASTER%, 죄송해요... 나도 모르게...」
				ELSE
					PRINTFORMW 「꿈속에서도 %조사처리(CALLNAME:MASTER,"와")% 렌코와 함께였지만... 역시 현실에서 안기고 싶어」
				ENDIF
			ENDIF
