				CALL CHARA_TEXT([[紫]], "『후후, 그렇게 딱딱해질 필요 없어~』", "w")
			ENDIF
		ELSE
			CALL CHARA_TEXT([[紫]], "『아아, 생각보다 고집이 세네. 떨어질 때까지 떨면 편해지니까~』", "w")
			PRINTFORMW 「그런……」
		ENDIF
	ENDIF
