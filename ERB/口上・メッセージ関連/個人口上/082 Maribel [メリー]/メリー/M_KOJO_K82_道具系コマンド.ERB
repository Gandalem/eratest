;45,アナルバイブ
;==================================================

@M_KOJO_MESSAGE_COM_K82_45
CALL M_KOJO_MESSAGE_COM_K82_45_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「렌코, 이거 설마...」
				CALL CHARA_TEXT([[蓮子]], "『아마 예상과는 조금 벗어난 것 같아, 이건 말이야, 여기에 넣는 거야』", "w")
				PRINTFORMW 「이쪽!? 잠, 잠깐만 기다려줘, 그건... 아직 마음의 준비가... 아! 하아...」
			ELSE
				PRINTFORMW 「그게 설마……응? 뒤에?」
				PRINTFORMW 「엣!? 엉덩이에 넣는 거야...? 우, 음... 아프지 않게 해준다고 약속해 줄래?」
				PRINTFORMW 「그럼 괜찮아... 응, 힘 빼는 거야?... 으윽!? 야, 역시 아픈 거잖아...!」
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「이걸, 뒤에? ……그렇네」
				CALL CHARA_TEXT([[蓮子]], "『괜찮아? 익숙하지 않으면 상당히 괴로울 거야.』", "w")
				PRINTFORMW 「그런 말 해도…… 싫어도 넣을 수 있는데……」
			ELSE
				PRINTFORMW 「그, 그걸 어떻게 할 거야? 아, 그만둬! 에엣!? 저쪽, 엉덩이...좋아!?」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アナルバイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				IF ABL:Ａ感覚 >= 3
					PRINTFORMW 「또 뒤예요?」
					CALL CHARA_TEXT([[蓮子]], "『혹시 기대하고 있는 거야?』", "w")
					PRINTFORMW 「흐으... 아... 저기...」
				ELSE
					PRINTFORMW 「또, 뒤야? 별로 거기 하고 싶지 않은데...」
					CALL CHARA_TEXT([[蓮子]], "『계속 하다 보면 익숙해지겠지』", "w")
				ENDIF
			ELSE
				IF !RAND:3
					IF ABL:Ａ感覚 >= 3
						PRINTFORMW 「아아앗! 으응! 엉덩이, 기분 좋아...!」
					ELSE
						PRINTFORMW 「치질이 되지 않을까 걱정이야…」
					ENDIF
				ELSEIF RAND:2
					PRINTFORMW 「또 이거…… 가능하다면, %조사처리(CALLNAME:MASTER,"가")%……」
				ELSE
					PRINTFORMW 「넣는 거야? ……응, 괜찮아」
					PRINTFORMW 「아직 아프지만, 참을 테니까……」
				ENDIF
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				IF ABL:Ａ感覚 >= 3
					PRINTFORMW 「넣는 거야? ……응, 괜찮아」
					CALL CHARA_TEXT([[蓮子]], "『이제 익숙해진 거잖아. 메리도 자기가 변태라는 걸 인정하면 어때?』", "w")
					PRINTFORMW 「그런…… 저……」
					CALL CHARA_TEXT([[蓮子]], "『미안미안, 그럼 넣을게』", "w")
				ELSE
					PRINTFORMW 「넣는 거야? 응, 아직 좀 서툴지만, 괜찮아……」
					CALL CHARA_TEXT([[蓮子]], "『계속 하다 보면 익숙해지겠지』", "w")
				ENDIF
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「또 그거? 별로 안 좋은데...」
						PRINTFORMW (엉덩이 쪽이 기분 좋아지고 있다니... 나...)
					CASE 1
						PRINTFORMW 「또 뒤에 그런 걸...」
						PRINTFORMW (싫을 터인데, 나 기대하고 있는 걸까? 말도 안 돼...)
					CASE 2
						PRINTFORMW 「그만두라고, 아플 뿐이니까……」
						PRINTFORMW 「저거, 엉덩이가 따끔거려서 싫은데, 해야 하는 거야? ……그렇지?」
				ENDSELECT
			ENDIF
		ENDIF
		;解除
	ELSE
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
		ELSEIF TALENT:恋慕
			IF ABL:Ａ感覚 >= 3
				IF RAND:2
					PRINTFORMW 「윽, ……하아, 하아……」
					PRINTFORMW 「기분 좋았지만……하지만, 저는……」
				ELSE
					PRINTFORMW 「윽, ……하아앗……」
					PRINTFORMW 「가능하다면 다음엔 %조사처리(CALLNAME:MASTER,"를")% 부탁해……」
				ENDIF
			ELSE
				IF RAND:2
					PRINTFORMW 「윽, ……하아, 하아……」
					PRINTFORMW 「……끝났어?」
				ELSE
					PRINTFORMW 「크윽... 하아, 하아... 끝나는 거구나...」
				ENDIF
				PRINTFORMW 「당신은 여러 가지 취미를 가지고 있네요…」
			ENDIF
		ELSE
			IF ABL:Ａ感覚 >= 3
				PRINTFORMW 「……윽! 하아, 벌써……그만해……」
				PRINTFORMW (기분 좋았다는 걸 알게 되면 무슨 일을 당할지……)
			ELSE
				PRINTFORMW 「하아, 하아, 하아... 드디어 끝났네...」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
