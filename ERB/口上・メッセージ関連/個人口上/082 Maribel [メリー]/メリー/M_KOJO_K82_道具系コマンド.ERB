;==================================================
;44,バイブ
;==================================================
@M_KOJO_MESSAGE_COM_K82_44
CALL M_KOJO_MESSAGE_COM_K82_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				IF IS_HERE([[蓮子]])
					IF ABL:レズ中毒 >= 3 && ABL:従順 >= 5 && MARK:反発刻印 == 0
						CALL CHARA_TEXT([[蓮子]], "『ねぇメリー……これ……なんだけど……』", "w")
						PRINTFORMW 「これって……ここってこんなものまであるの……。……蓮子？」
						CALL CHARA_TEXT([[蓮子]], "『……メリー、お願いがあるの。あなたの初めて、私が貰ってもいい？』", "w")
						PRINTFORMW 「え……。……、……うん、蓮子なら、いいわ。きて……」
						PRINTFORMW （%CALLNAME:MASTER%、ごめんなさい、でも、私……）
					ELSE
						PRINTFORMW 「これって……ちょっと待って、蓮子、まさか」
						CALL CHARA_TEXT([[蓮子]], "『その通りよメリー、あなたの初めて、私が貰うわ』", "w")
						PRINTFORMW 「う、嘘でしょ蓮子、私、初めては、%CALLNAME:MASTER%に……」
						CALL CHARA_TEXT([[蓮子]], @"『%CALLNAME:MASTER%には許可を貰ってるわ……さぁ、いくわよ』", "w")
						PRINTFORMW 「そんな、う、嘘よ……%CALLNAME:MASTER%、どうして……」
					ENDIF
					CALL COLORMESSAGE(@"Virginity Loss (%CALLNAME:TARGET%)", 0xF7ABA6, 2)
					CALL SET_HISTORY_LOST_V(TARGET, [[蓮子]], "バイブ")
				ELSE
					IF ABL:従順 >= 5
						PRINTFORMW 「えっ、それってまさか……！」
						PRINTFORMW 「……いえ、いいんです、%CALLNAME:MASTER%がそれを望むなら」
						PRINTFORMW メリーの中にバイブを入れる直前、メリーから一筋の涙が流れていった……
					ELSE
						PRINTFORMW 「えっ、それってまさか……！」
						PRINTFORMW 「%CALLNAME:MASTER%、私まだしたことがないんです、初めては、%CALLNAME:MASTER%にあげたいのに……！」
					ENDIF
					PRINTFORMW 「んんっ！　んぐ…痛いし、直接貰ってくれないし、散々だわ…」
					PRINTFORMW 「この責任はちゃんと取ってよね」
				ENDIF
			ELSE
				IF MARK:反発刻印
					PRINTFORMW 「……それは……」
					PRINTFORMW 「私の初めてを、それで奪うのね……いいわ、もう何されたって……」
					PRINTFORMW 「……今更……躊躇う人じゃないでしょ、あなたは……。するなら早くして……」
					PRINTFORMW 「…………」
				ELSE
					PRINTFORMW 「えっ、それってまさか……！」
					PRINTFORMW 「お願い、やめて、やめてっ！！ 私、まだなのに……！」
					PRINTFORMW 「痛いっ！　痛い痛い！　抜いて、抜いてぇ！」
					PRINTFORMW メリーは秘唇に挿入されたバイブの異物感と破瓜の痛みに咽び泣いた
				ENDIF
			ENDIF			
			RETURN 1
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「こんなものまであるなんて……」
				PRINTFORMW 「なんだか見覚えのある形の物ね…うぅ、あんまり痛くしないでね？」
			ELSE
				PRINTFORMW 「そ、そんな大きな物、入るわけないじゃない…わ、分かったから、そんな怖い顔しないでよ」
			ENDIF 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW 
			RETURN 1
		;恋慕
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「……またこれ？」
				CALL CHARA_TEXT([[蓮子]], "『嫌じゃないでしょ？ これ嵌めてる時のメリーって気持ちよさそうだし』", "w")
			ELSE
				IF !RAND:3
					PRINTFORMW 「またこれ？ できれば、貴方のを……」
				ELSEIF RAND:2
					PRINTFORMW 「んんっ！　ふぁぁっ！」
					PRINTFORMW メリーの秘所はバイブを根元まで飲み込み、振動に合わせて全身を震わせている
				ELSE
					PRINTFORMW 「またそれ？　本当は貴方にしてもらいたいんだけど…」
					PRINTFORMW 「分かったわよ、分かったからそんな残念そうな顔しないでよ」
				ENDIF
			ENDIF
		;その他の場合
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「これよりも私……蓮子とただ抱き合っていたいわ……」
				CALL CHARA_TEXT([[蓮子]], "『嬉しいこといってくれるわね、でも今回はこれよ』", "w")
				CALL CHARA_TEXT([[蓮子]], "『せっかくあるものだから有効に活用しないと』", "w")
			ELSEIF RAND:2
				PRINTFORMW 「またそんな物取り出して…貴方のじゃ満足できないって言われたらどうするの？」
			ELSE
				PRINTFORMW 「それ、変な気分になってあんまり好きじゃないのよね…」
			ENDIF
		ENDIF
	;解除
	ELSE
		;時姦中
		IF FLAG:70
			;PRINTFORMW 
			RETURN 1
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『メリー、抜くわよ？』", "w")
				PRINTFORMW 「う……んっ！ あ……はぁっ……」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「う……んっ！ はぁっ……」
						PRINTFORMW 「気持ちいいのは確かだけど、やっぱりこういうのは……」
					CASE 1
						PRINTFORMW 「次は、貴方ので……」
					CASE 2
						PRINTFORMW 「ん、ふぁ…終わり？　それじゃ、次は…ね？」
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「んぅ…はぁ…終わったの…？」
				CASE 1
					PRINTFORMW 「うぅ…股がひりひりする…」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1

;==================================================
;45,アナルバイブ
;==================================================
@M_KOJO_MESSAGE_COM_K82_45
CALL M_KOJO_MESSAGE_COM_K82_45_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「蓮子、これってまさか……」
				CALL CHARA_TEXT([[蓮子]], "『多分予想とは少し外れてると思うわ、これはね、こっちに入れるものなのよ』", "w")
				PRINTFORMW 「こっち！？ ちょ、ちょっと待って、それは……まだ心の準備が……あっ！ はぁっ……」
			ELSE
				PRINTFORMW 「それってまさか……え？ 後ろ？」
				PRINTFORMW 「え！？　お尻に入れるの…？　う、うーん…痛くしないって約束する？」
				PRINTFORMW 「それならいいわ…うん、力を抜くの？……んぎっ！？　や、やっぱり痛いじゃない…！」
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「これを、後ろに？ ……そう」
				CALL CHARA_TEXT([[蓮子]], "『大丈夫？ 慣れないとかなり辛いわよ』", "w")
				PRINTFORMW 「そんなこといわれても……嫌でも入れるのに……」
			ELSE
				PRINTFORMW 「そ、それをどうする気？　あ、止めて！　えっ！？　そっち、お尻…い゛ぃ！？」
			ENDIF
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アナルバイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW 
			RETURN 1
		;恋慕
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				IF ABL:Ａ感覚 >= 3
					PRINTFORMW 「また、後ろなの？」
					CALL CHARA_TEXT([[蓮子]], "『もしかして期待しちゃってる？』", "w")
					PRINTFORMW 「う……あ……えっと……その……」
				ELSE
					PRINTFORMW 「また、後ろなの？ あまりそっちはしたくないのに……」
					CALL CHARA_TEXT([[蓮子]], "『もっとして慣れればいいだけよ』", "w")
				ENDIF
			ELSE
				IF !RAND:3
					IF ABL:Ａ感覚 >= 3
						PRINTFORMW 「あぁああっ！　んんっ！　お尻、気持ち良い…！」
					ELSE
						PRINTFORMW 「痔にならないか心配だわ…」
					ENDIF
				ELSEIF RAND:2
					PRINTFORMW 「またこれ……できれば、%CALLNAME:MASTER%のが……」
				ELSE
					PRINTFORMW 「入れるの？ ……うん、いいわ」
					PRINTFORMW 「まだ痛いけど、我慢するから……」
				ENDIF
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				IF ABL:Ａ感覚 >= 3
					PRINTFORMW 「入れるの？ ……うん、いいわ」
					CALL CHARA_TEXT([[蓮子]], "『もう慣れたものよねー。 メリーも自分は変態さんだって認めちゃったら？』", "w")
					PRINTFORMW 「そんな……私……」
					CALL CHARA_TEXT([[蓮子]], "『ごめんごめん、じゃ、入れるわよ』", "w")
				ELSE
					PRINTFORMW 「入れるの？ うん、まだ、ちょっと苦手だけど、いいよ……」
					CALL CHARA_TEXT([[蓮子]], "『もっとして慣れればいいだけよ』", "w")
				ENDIF
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「またそれ？　あんまり好きじゃないんだけど…」
						PRINTFORMW （お尻の方が気持ち良くなってきてるなんて……私……）
					CASE 1
						PRINTFORMW 「また後ろにそんなの……」
						PRINTFORMW （嫌なはずなのに、私、期待しちゃってる？ そんな……）
					CASE 2
						PRINTFORMW 「やめてってば、痛いだけだから……」
						PRINTFORMW 「それ、お尻がひりひりして嫌なんだけど、やらなきゃ駄目？……よね」
				ENDSELECT
			ENDIF
		ENDIF
	;解除
	ELSE
		;時姦中
		IF FLAG:70
			;PRINTFORMW 
			RETURN 1
		ELSEIF TALENT:恋慕
			IF ABL:Ａ感覚 >= 3
				IF RAND:2
					PRINTFORMW 「っ、……はぁっ、はぁ……」
					PRINTFORMW 「気持ちよかった、けど……でも、私……」
				ELSE
					PRINTFORMW 「っ、……はぁっ……」
					PRINTFORMW 「できれば次は%CALLNAME:MASTER%のをお願い……」
				ENDIF
			ELSE
				IF RAND:2
					PRINTFORMW 「っ、……はぁっ、はぁ……」
					PRINTFORMW 「……終わったの？」
				ELSE
					PRINTFORMW 「くぅっ……はぁっ、はぁ……終わりなのね……」
				ENDIF
				PRINTFORMW 「貴方って色々な趣味してるのね…」
			ENDIF
		ELSE
			IF ABL:Ａ感覚 >= 3
				PRINTFORMW 「……っ！ はぁっ、もう……やめて……」
				PRINTFORMW （気持ち良かったことが知られたら何されるか……）
			ELSE
				PRINTFORMW 「はぁっ、はぁっ、はぁ……やっと、終わったわ……よね」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1

;==================================================
;48,搾乳機
;==================================================
@M_KOJO_MESSAGE_COM_K82_48
