RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_48_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「えっと、蓮子？ それって……」
				CALL CHARA_TEXT([[蓮子]], "『いやまぁ、せっかく出るようになったことだし？』", "w")
				PRINTFORMW 「うん……まぁ、確かに出るようになったわよ、でも……」
				CALL CHARA_TEXT([[蓮子]], "『いいからいいから、じゃ、着けるわね……こんな大きいのならたくさん出るんじゃない？』", "w")
				PRINTFORMW 「大きいからたくさん出るってわけでもないと思うけど……んっ……絞られて……くぅっ……！」
			ELSE
				PRINTFORMW 「えっと、確かに出るようになったわよ。それで……搾り取りたいの？」
				PRINTFORMW 「分かったわ、いいわよ。んっ、んくぅ！」
				PRINTFORMW 「ひっ、あぁぁっ、先っぽが、凄い、絞られてるっ！」
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「は？ 蓮子、ふざけてるの？」
				CALL CHARA_TEXT([[蓮子]], "『ふざけてないわよ。ほら、せっかく出るようになった事だし？』", "w")
				PRINTFORMW 「せっかくって何よ、私の事牛か何かと一緒にしてない？」
				CALL CHARA_TEXT([[蓮子]], "『いいから早くつける』", "w")
				PRINTFORMW 「い、いや、やめてやめて……いやぁぁっ！ 絞られてる、そんな、あぁっ！！」
			ELSE
				PRINTFORMW 「は？ ふざけてるの？」
				PRINTFORMW 「無理矢理こんな体質にさせておいて、今度はこんなもの……」
				PRINTFORMW 「いやっ、やめてやめて、そんなの……いやぁぁっ！ 絞られてる、そんな、だめぇぇー！」
			ENDIF
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:搾乳機
		;時姦中
		IF FLAG:70
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「蓮子が飲んでもいいのよ？ 何なら直接でも」
				CALL CHARA_TEXT([[蓮子]], "『さりげなく凄いこと言うわねぇ……』", "w")
			ELSE
				PRINTFORMW 「ねえ……%CALLNAME:MASTER%が直接吸うってのいうのは、駄目？」
				PRINTFORMW 「無理矢理絞ってとか売ったりとかってして欲しくないなー、って……」
				PRINTFORMW 「……そう、なら仕方ないわね……んっ、ふぁっ、あぁぁっ！」
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「蓮子が直接吸ってもいいのよ？ 無理矢理とか売ったりとかするよりそっちの方が……」
				CALL CHARA_TEXT([[蓮子]], "『んー……それもまた魅力的……だけど今回はパスね』", "w")
			ELSEIF RAND:2
				PRINTFORMW 「……家畜並みの扱いって事ね」
				PRINTFORMW 「それとも、それ以下かしら……」
			ELSE
				PRINTFORMW 「ううっ……またそれつけるの……？」
				PRINTFORMW 「人の胸をなんだと……ひっ！ やだ、もうやめてっ、あぁぁっ……！」
			ENDIF
		ENDIF
	;解除
	ELSE
		;時姦中
		IF FLAG:70
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「ところで、こんなもの誰が買うのよ」
				CALL CHARA_TEXT([[蓮子]], @"『さあ？ %CALLNAME:MASTER%がどこかの店に持っていくみたいわよ』", "w")
				PRINTFORMW 「%CALLNAME:MASTER%以外が手に入れて何の意味があるのかしら……」
			ELSE
				PRINTFORMW 「んっ、はぁっ、ねぇ……本当に売るの？」
				PRINTFORMW 「%CALLNAME:MASTER%が飲めばいいのに……」
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「ねぇ蓮子……本当に売るの？」
				CALL CHARA_TEXT([[蓮子]], "『最初から売るつもりよ』", "w")
				PRINTFORMW 「勘弁してよもう……」
			ELSE
				PRINTFORMW 「ううっ……そんなもの、誰が買うっていうのよ……」
				PRINTFORMW 「売る方も売る方だけど、買う方も買う方だわ……」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
