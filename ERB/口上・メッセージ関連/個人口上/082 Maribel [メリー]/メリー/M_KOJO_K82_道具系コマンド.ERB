;48,搾乳機
;==================================================

@M_KOJO_MESSAGE_COM_K82_48
CALL M_KOJO_MESSAGE_COM_K82_48_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_48_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「음, 렌코? 그게...」
				CALL CHARA_TEXT([[蓮子]], "『아니, 뭐 모처럼 나오게 된 거니까?』", "w")
				PRINTFORMW 「응...... 뭐, 확실히 나오게 됐지만......」
				CALL CHARA_TEXT([[蓮子]], "『됐으니까 됐다고, 그럼 달아볼게... 이렇게 큰 거라면 많이 나오지 않을까?』", "w")
				PRINTFORMW 「크기 때문에 많이 나온다고 할 수도 없겠지만... 윽... 짜여서... 크으윽...!」
			ELSE
				PRINTFORMW 「음, 확실히 나오게 됐어. 그래서…… 짜내고 싶은 거야?」
				PRINTFORMW 「알았어, 괜찮아. 응, 음쿠우!」
				PRINTFORMW 「큿, 아아앗, 끝부분이, 굉장해, 짜이고 있어!」
			ENDIF
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「뭐야? 렌코, 장난치는 거야?」
				CALL CHARA_TEXT([[蓮子]], "『장난치고 있는 거 아니야. 자, 모처럼 나오게 된 건데?』", "w")
				PRINTFORMW 「애써주는데, 나를 소나 뭐랑 똑같이 취급하는 거야?」
				CALL CHARA_TEXT([[蓮子]], "『됐으니까 빨리 붙여』", "w")
				PRINTFORMW 「이, 아니야, 그만해 제발……아앗! 짜이고 있어, 안 돼, 아앗!!」
			ELSE
				PRINTFORMW 「뭐야? 장난치는 거야?」
				PRINTFORMW 「억지로 이런 체질로 만들어 놓고, 이제는 이런 것도……」
				PRINTFORMW 「싫어, 그만해 제발, 그런 건……안 돼! 짜지고 있어, 안 돼애애!」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
