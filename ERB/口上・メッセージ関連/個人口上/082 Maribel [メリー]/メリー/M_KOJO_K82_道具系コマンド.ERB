;40,ローター
;==================================================

@M_KOJO_MESSAGE_COM_K82_40
CALL M_KOJO_MESSAGE_COM_K82_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「아, 그거 혹시...」
			CALL K82_RENKO("『ここって色々とエッチな道具があるのよね。さ、これでするわよ』", "w")
			PRINTFORMW 「역시. 이런 물건이 이곳에 존재하다니……」
		ELSE
			PRINTFORMW 「에, 그건……」
			PRINTFORMW 「아니야, 그런 곳에 밀어 넣지 마!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「진동이……응, 굉장해서……아앗, 기분, 좋아……」
				PRINTFORMW 「더, 해줘, %CALLNAME:MASTER%……」
			CASE 1
				PRINTFORMW 「윽... 으응...!」
				PRINTFORMW 메리는 몸을 떨며 참았다...
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「윽... 으응...!」
				PRINTFORMW 메리는 몸을 떨며 참았다...
			CASE 1
				PRINTFORMW 「아, 아아...... 안 돼, 나, 이상해져 버려......!」
				IF IS_HERE([[蓮子]])
					CALL CHARA_TEXT([[蓮子]], "『그렇게 많이 느끼고 있는데 멈추길 바라는 거야?』", "w")
					PRINTFORMW 「그, 그럴 수 없어...」
				ENDIF
			CASE 2
				PRINTFORMW 「으윽... 더 이상 밀어붙이지 말아줘...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
