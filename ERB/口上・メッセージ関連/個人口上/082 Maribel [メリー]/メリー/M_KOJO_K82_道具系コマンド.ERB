;41,Ｅマッサージャ
;==================================================

@M_KOJO_MESSAGE_COM_K82_41
CALL M_KOJO_MESSAGE_COM_K82_41_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_41_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「이거 마사지기, 맞죠?」
			PRINTFORMW 「그래서 뭘 하는 건가요, %CALLNAME:MASTER%? 어라, 저쪽으로요?」
			CALL K82_RENKO("『うん、まぁ、その通りだけど、これはね、こう使うの』", "w")
			PRINTFORMW 「으읍...응, 아, 하아아! 대, 대단해, 뭐, 이거...!」
		ELSE
			PRINTFORMW 「이거 마사지기, 맞죠」
			PRINTFORMW 「그래서 뭘 할 생각이야? 그냥 마사지 해주는 것…… 아니겠죠」
			PRINTFORMW 「에, 뭐를…… 큭, 히익! 아아아아아! 싫어, 그만해! 그만둬!!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%……또 이걸 말하는 거야? 이건 나한테 좀 취약해……」
				PRINTFORMW 「히끅, 아아아악! 너무 격렬해, 안 돼, 이상해져 버려!」
				CALL K82_RENKO("『メリー凄く乱れて可愛かったもの』", "w")
			CASE 1
				PRINTFORMW 「윽... 아...!」
				PRINTFORMW 메리는 필사적으로 버티고 있다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「윽... 아...!」
				PRINTFORMW 메리는 필사적으로 버티고 있다.
			CASE 1
				PRINTFORMW 「그, 그건 이제 그만해! 부서져, 나, 망가질 거야!」
				CALL K82_RENKO("『あんなに乱れまくって何言ってるのよ』", "w")
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
