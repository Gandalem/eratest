;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K82_44
CALL M_KOJO_MESSAGE_COM_K82_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				IF IS_HERE([[蓮子]])
					IF ABL:レズ中毒 >= 3 && ABL:従順 >= 5 && MARK:反発刻印 == 0
						CALL CHARA_TEXT([[蓮子]], "『있잖아 메리... 이거... 말인데...』", "w")
						PRINTFORMW 「이건…… 여기에도 이런 게 있는 거야……. ……렌코?」
						CALL CHARA_TEXT([[蓮子]], "『……메리, 부탁이 있어. 네 첫 경험, 내가 가져도 될까?』", "w")
						PRINTFORMW 「에...... ...... 응, 렌코라면 괜찮아. 와줘......」
						PRINTFORMW ( %CALLNAME:MASTER%, 미안해, 하지만 나......)
					ELSE
						PRINTFORMW 「이거... 잠깐만, 렌코, 설마」
						CALL CHARA_TEXT([[蓮子]], "『그렇지 메리, 너의 첫 경험은 내가 가져갈게』", "w")
						PRINTFORMW 「우, 거짓말이지 렌코, 나는 처음에는 %조사처리(CALLNAME:MASTER,"에게")%...」
						CALL CHARA_TEXT([[蓮子]], @"『%CALLNAME:MASTER%에게는 허락을 받았어... 자, 갈게』", "w")
						PRINTFORMW 「그런, 우, 거짓말이야... %CALLNAME:MASTER%, 왜...」
					ENDIF
					CALL COLORMESSAGE(@"처녀성 상실 (%CALLNAME:TARGET%)", 0xF7ABA6, 2)
					CALL SET_HISTORY_LOST_V(TARGET, [[蓮子]], "バイブ")
				ELSE
					IF ABL:従順 >= 5
						PRINTFORMW 「에엣, 그거 설마...!」
						PRINTFORMW 「...아뇨, 괜찮아요. %조사처리(CALLNAME:MASTER,"가")% 그것을 바란다면」
						PRINTFORMW 메리 안에 바이브를 넣기 직전, 메리에게서 한 줄기의 눈물이 흘러내렸다...
					ELSE
						PRINTFORMW 「엣, 그게 설마……!」
						PRINTFORMW 「%CALLNAME:MASTER%, 저 아직 한 적 없어요. 처음은, %조사처리(CALLNAME:MASTER,"에게")% 주고 싶은데……!」
					ENDIF
					PRINTFORMW 「응흥! 흥... 아프고, 직접 안 주고, 정말 최악이야...」
					PRINTFORMW 「이 책임은 제대로 지는 거야」
				ENDIF
			ELSE
				IF MARK:反発刻印
					PRINTFORMW 「……그건……」
					PRINTFORMW 「나의 처음을, 그걸로 빼앗는 거니…… 좋아, 이제 무슨 짓을 당해도……」
					PRINTFORMW 「……이제 와서…… 망설이는 사람이 아닐 테지, 당신은……. 한다면 빨리 해……」
					PRINTFORMW 「…………」
				ELSE
					PRINTFORMW 「엣, 그거 설마……!」
					PRINTFORMW 「부탁이야, 그만해줘, 그만해!! 나 아직인데……!」
					PRINTFORMW 「아파! 아파 아파! 빼줘, 빼달라고!」
					PRINTFORMW 메리는 비문에 삽입된 바이브의 이물감과 파각의 고통에 흐느꼈다
				ENDIF
			ENDIF
			RETURN 1
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「이런 것까지 있다니……」
				PRINTFORMW 「왠지 본 적 있는 모양의 물건이네... 으윽, 너무 아프게 하지 말아줘?」
			ELSE
				PRINTFORMW 「그, 그런 큰 물건이 들어갈 리가 없잖아... 알았으니까, 그렇게 무서운 얼굴 하지 마.」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「……또 이거?」
				CALL CHARA_TEXT([[蓮子]], "『싫지 않잖아? 이거 끼고 있을 때 메리 기분 좋아 보이잖아.』", "w")
			ELSE
				IF !RAND:3
					PRINTFORMW 「또 이거? 가능하다면, 당신의 것을……」
				ELSEIF RAND:2
					PRINTFORMW 「응응! 하아앗!」
					PRINTFORMW 메리의 비소는 바이브를 뿌리까지 삼키고, 진동에 맞춰 전신을 떨고 있다.
				ELSE
					PRINTFORMW 「또 그거? 사실은 당신에게 받고 싶은 건데…」
					PRINTFORMW 「알았어, 알았으니까 그렇게 아쉬워하는 표정 하지 마.」
				ENDIF
			ENDIF
			;その他の場合
		ELSE
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「이것보다 나... 렌코와 그저 끌어안고 싶었어...」
				CALL CHARA_TEXT([[蓮子]], "『기쁜 말을 해 주네, 하지만 이번엔 이게 전부야』", "w")
				CALL CHARA_TEXT([[蓮子]], "『가지고 있는 거니까 유효하게 활용해야지』", "w")
			ELSEIF RAND:2
				PRINTFORMW 「또 그런 걸 꺼내서... 당신으로는 만족 못 한다고 하면 어떡할 거야?」
			ELSE
				PRINTFORMW 「그거, 이상한 기분이 되어서 별로 좋아하지 않아...」
			ENDIF
		ENDIF
		;解除
	ELSE
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『메리, 빼버릴 거야?』", "w")
				PRINTFORMW 「우음... 읍! 아... 하아...」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「우음... 핫! 하아...」
						PRINTFORMW 「기분 좋은 건 확실하지만, 역시 이런 건...」
					CASE 1
						PRINTFORMW 「다음은, 당신의 것……」
					CASE 2
						PRINTFORMW 「응, 후아... 끝이야? 그럼 다음은... 응?」
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「음... 하아... 끝난 거야...?」
				CASE 1
					PRINTFORMW 「으윽... 사타구니가 저릿저릿해...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
