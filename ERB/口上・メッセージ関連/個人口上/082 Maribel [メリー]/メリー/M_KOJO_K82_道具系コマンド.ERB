RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「あ、それって、もしかして……」
			CALL K82_RENKO("『ここって色々とエッチな道具があるのよね。さ、これでするわよ』", "w")
			PRINTFORMW 「やっぱり。ここにもこんな物が存在するなんて……」
		ELSE
			PRINTFORMW 「え、それって……」
			PRINTFORMW 「いやっ、そんなとこに押し付けないでっ！」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「振動が……んっ、凄くて……ああっ、気持ち、いい……」
				PRINTFORMW 「もっと、して、%CALLNAME:MASTER%……」
			CASE 1
				PRINTFORMW 「うっ……んん……！」
				PRINTFORMW メリーは身体を震わせ堪えている……
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「うっ……んん……！」
				PRINTFORMW メリーは身体を震わせ堪えている……
			CASE 1
				PRINTFORMW 「あ、あぁ……駄目、私、おかしくなっちゃう……！」
				IF IS_HERE([[蓮子]])
					CALL CHARA_TEXT([[蓮子]], "『そんなに感じてるのに止めて欲しいの？』", "w")
					PRINTFORMW 「そ、そんな、だめぇっ……」
				ENDIF
			CASE 2
				PRINTFORMW 「うぅ……もう押し付けないで……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

