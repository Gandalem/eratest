;-------------------------------------------------
IF LOCAL && !FLAG:70
	;custom code
	IF TALENT:恋慕
		IF TALENT:MASTER:濃厚精液
			IF RAND:3 == 0 && !TALENT:妊娠
				PRINTFORMW 「아아……%UNICODE(0x2665)% %조사처리(CALLNAME:MASTER,"가")% 나의 질 안에, 가득……%UNICODE(0x2665)%」
				PRINTFORMW 「이렇게 많이 나오면, 나는……%UNICODE(0x2665)%」
			ELSEIF RAND:3 == 0 && !TALENT:妊娠
				PRINTFORMW 「하아... 아기가 생길 수 있을까...?」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORMW 「ん읏%UNICODE(0x2665) *1%幸せ……%UNICODE(0x2665) *1%」
				RETURN 1
			ELSE
				PRINTFORMW 「더어엇%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
				RETURN 1
			ENDIF
		ELSEIF NOWEX:MASTER:射精 > 1 ;big load
			IF !RAND:3
				PRINTFORMW 「파앗! 질 안에, 들어온다! 음으앗!!」
			ELSEIF RAND:2
				PRINTFORMW 「하아... 안에 가득 차있어...」
				PRINTFORMW 메리는 행복해 보이는 듯 웃으며 하복부를 쓰다듬었다.
			ELSE
				PRINTFORMW 「응아악! 안 돼, 배 터질 것 같아!!」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응읏%UNICODE(0x2665) *1% 잔뜩 사정해줘%UNICODE(0x2665) *1%」
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아핫%UNICODE(0x2665) *1% 좀 더 내줘엇%UNICODE(0x2665) *1%」
				RETURN 1
			ELSE
				PRINTFORMW 「많이 사정해줘%UNICODE(0x2665) *1%」
				RETURN 1
			ENDIF
		ENDIF
	ELSEIF 임신가부(TARGET) && CFLAG:生解禁 ;fertile, consent
		IF NOWEX:MASTER:射精 > 1 ;big load
			IF !RAND:3
				PRINTFORMW 「응! 크아악! 나와, 하아앗!!」
			ELSEIF RAND:2
				PRINTFORMW 「큭! 하아아!!」
				PRINTFORMW 메리는 질을 두드리는 사정감에 몸을 떨고 있다.
			ELSE
				PRINTFORMW 「아아... 질 안에... 잔뜩 나오고 있어...」
				PRINTFORMW 「이렇게 많이 나오다니...」
			ENDIF
		ELSE
			IF !RAND:3
				PRINTFORMW 「후우... 이렇게 많이 내는데, 아직 부족한 거야...?」
			ELSEIF RAND:2
				PRINTFORMW 「하아... 배 속이 엄청 뜨거워...」
			ELSE
				PRINTFORMW 「아... 안에 싸버렸어...」
			ENDIF
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「아아... 아니, 아니야... 이런 건...」
			CASE 1
				PRINTFORMW 「아아...... 아...... 그만해줘...... 안에 넣지 마......」
			CASE 2
				PRINTFORMW 「에... 설마, 거짓말, 그만해, 하지 마, 안에 넣지 마, 싫어, 안 돼!」
			CASE 3
				PRINTFORMW 「싫어, 흐윽, 빼줘! 내보내지 마!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
