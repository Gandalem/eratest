LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;custom code
	IF TALENT:恋慕
		IF TALENT:MASTER:濃厚精液
			IF RAND:3 == 0 && !TALENT:妊娠
				PRINTFORMW 「ああ……%UNICODE(0x2665)% %CALLNAME:MASTER%のが私の膣内に、いっぱい……%UNICODE(0x2665)%」
				PRINTFORMW 「こんなに出されたら、私……%UNICODE(0x2665)%」
			ELSEIF RAND:3 == 0 && !TALENT:妊娠
				PRINTFORMW 「はぁ…%UNICODE(0x2665)% 赤ちゃん、出来るかな…？」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「ああっ%UNICODE(0x2665) *1%んっ%UNICODE(0x2665) *1%」
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORMW 「んっ%UNICODE(0x2665) *1%幸せ……%UNICODE(0x2665) *1%」
				RETURN 1
			ELSE
				PRINTFORMW 「もっとっ%UNICODE(0x2665) *1%ああっ%UNICODE(0x2665) *1%」
				RETURN 1
			ENDIF
		ELSEIF NOWEX:MASTER:射精 > 1 ;big load
			IF !RAND:3
				PRINTFORMW 「ふぁあっ！　膣内っ、入ってくる！　んぅぁっ！！」
			ELSEIF RAND:2
				PRINTFORMW 「はぁ…中、いっぱいになってる…」
				PRINTFORMW メリーは幸せそうに笑って下腹部を撫でた
			ELSE
				PRINTFORMW 「んぁぁっ！　だめ、お腹っ破けるぅ！！」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「んっ%UNICODE(0x2665) *1%いっぱい射精してね%UNICODE(0x2665) *1%」
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORMW 「あはっ%UNICODE(0x2665) *1%もっと出してっ%UNICODE(0x2665) *1%」
				RETURN 1
			ELSE
				PRINTFORMW 「いっぱい射精してね%UNICODE(0x2665) *1%」
				RETURN 1
			ENDIF
		ENDIF
	ELSEIF 妊娠可否(TARGET) && CFLAG:生解禁 ;fertile, consent
		IF NOWEX:MASTER:射精 > 1 ;big load
			IF !RAND:3
				PRINTFORMW 「んんっ！　ぅあああっ！　出て、はぁぁっ！！」
			ELSEIF RAND:2
				PRINTFORMW 「ふぁ！　はぁぁ！！」
				PRINTFORMW メリーは膣を叩く射精感に打ち震えている
			ELSE
				PRINTFORMW 「あぁ……膣内に……いっぱい出てる……」
				PRINTFORMW 「こんなに出されたら…」
			ENDIF
		ELSE
			IF !RAND:3
				PRINTFORMW 「ふぁぁ…こんなに出して、まだ足りないの…？」
			ELSEIF RAND:2
				PRINTFORMW 「はぁ…お腹の中、凄く熱い…」
			ELSE
				PRINTFORMW 「あぁ…中に出されちゃった…」
			ENDIF
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「あぁ…いや、いやぁ…こんなの……」
			CASE 1
				PRINTFORMW 「あぁ……ぁ……もうやめて……中に出さないで……」
			CASE 2
				PRINTFORMW 「え……まさか、嘘、やめ、やめてっ、中に出さないで、嫌、いやぁっ！」
			CASE 3
				PRINTFORMW 「嫌っ、あぅっ、抜いて！ 出さないで！」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

