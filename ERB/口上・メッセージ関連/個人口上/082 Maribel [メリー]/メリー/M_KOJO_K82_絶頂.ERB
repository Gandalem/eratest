;custom code
@M_KOJO_MESSAGE_PALAMCNG_D_K82(ARG)
;-------------------------------------------------
;After reaching certain threshold for palams for the first time
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;don't show if unconscious
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 0

;-------------------------------------------------
;初めて好意がLV2超えた
;-------------------------------------------------
IF !(MARK:反発刻印 || CFLAG:ブチギレ) && PALAM:好意 + UP:好意 > PALAMLV:3 && FIRSTTIME("好意V2")
	PRINTFORML 「ふふ、貴方よくお人好しって言われない？」
	PRINTFORMW 何故笑われたのかは分からないが、ある程度心を開いてくれた証拠だろう
ENDIF

;-------------------------------------------------
;初めて優越がLV2超えた
;-------------------------------------------------
IF PALAM:優越 + UP:優越 > PALAMLV:3 && FIRSTTIME("優越V2")
	PRINTFORML 「次はどうしましょうか」
	PRINTFORMW メリーは%CALLNAME:MASTER%を引っ張るように事を進めていく
ENDIF

SIF CFLAG:うふふ != 1 ;don't show stuff below unless having sex
	RETURN 0

;-------------------------------------------------
;初めて潤滑がLV2超えた
;-------------------------------------------------
IF PALAM:潤滑 + UP:潤滑 > PALAMLV:2 && FIRSTTIME("潤滑V2")
	IF IS_SELECTCOM("ローション")
		IF TALENT:恋慕
			PRINTFORMW 「ぬるぬるするわ……次はどうするの？」
		ELSE
			PRINTFORMW 「冷たくてぬるぬるして…気持ち悪いわ」
		ENDIF
	ELSEIF TALENT:恋慕
		PRINTFORML 「わ、私だって女の子なんだから、好きな人にされればこうなるわよ」
		PRINTFORMW メリーは秘所から伝う液体を隠しながら恥ずかしそうに言った
	ELSE
		PRINTFORMW （えっ……嘘、私、濡れて……）
		PRINTFORML 「こ、これは違うの！」
		PRINTFORMW メリーは秘所から滲む愛液を必死に否定している
	ENDIF
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
IF PALAM:欲情 + UP:欲情 > PALAMLV:3 && FIRSTTIME("欲情V2")
	IF IS_SELECTCOM("媚薬")
		IF TALENT:恋慕
			PRINTFORML 「なんだか頭がふわふわする……」
			PRINTFORMW メリーの頬が紅潮し瞳も心許ない
		ELSE
			PRINTFORMW 「く、薬のせい……なんだから……」
			PRINTFORMW 「でも、……うぅっ……」
			PRINTFORMW （やだ、頭がくらくらして…体が熱くて、何も考えられなくなる……）
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「ん、はぁ……」
			PRINTFORMW メリーの吐息に艶気が増してきた
		ELSE
			PRINTFORMW （うぅ…こんな風にされたら我慢出来なくなっちゃう……）
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;初めて恥情がLV2超えた
;-------------------------------------------------
IF PALAM:恥情 + UP:恥情 > PALAMLV:3 && FIRSTTIME("恥情V2")
	IF TALENT:恋慕
		PRINTFORML 「そ、そんなに見られると恥ずかしいわ……」
		PRINTFORMW メリーは頬を赤らめて%CALLNAME:MASTER%の視線から逃げようとしている
	ELSE
		PRINTFORML 「……！」
		PRINTFORMW メリーは顔を真っ赤にしてうつむいている
	ENDIF
ENDIF

;-------------------------------------------------
;初めて恐怖がLV2超えた
;-------------------------------------------------
IF PALAM:恐怖 + UP:恐怖 > PALAMLV:3 && FIRSTTIME("恐怖V2")
	PRINTFORMW 「い……嫌……こ、来ないで……！」
	PRINTFORMW %CALLNAME:MASTER%が手を出すとメリーはびくりと身を震わせた
ENDIF
