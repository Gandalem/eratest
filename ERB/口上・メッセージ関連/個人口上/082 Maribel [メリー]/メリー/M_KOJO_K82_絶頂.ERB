					PRINTFORMW 「はぁ…%UNICODE(0x2665)% お尻ってそんなに気持ち良いの…？」
				ENDIF
				
				IF ABL:Ｖ感覚 >= 3 && ONCE("MerryCreampiePlease")
					PRINTFORML
					PRINTFORML 「ああ……後ろに、たくさん……」
					PRINTFORMW 「%CALLNAME:MASTER%、できれば、こっちにも……」
				ENDIF
			ELSEIF ABL:Ａ感覚 >= 3
				IF RAND:3 == 0
					PRINTFORMW 「ん%UNICODE(0x2665) *1%お尻気持ちよかった？」
					RETURN 1
				ELSEIF RAND:2 == 0
					PRINTFORMW 「アナルに出すなんて変態よ%UNICODE(0x2665) *1%」
					RETURN 1
				ELSE
					PRINTFORMW 「んっ%UNICODE(0x2665) *1%もっと射精してもいいわよ%UNICODE(0x2665) *1%」
					RETURN 1
				ENDIF
			ELSE
				IF !RAND:3
					PRINTFORMW 「んん…お尻に、入ってきてる…」
				ELSEIF RAND:2
					PRINTFORMW 「ふぁぁ…すっかり%CALLNAME:MASTER%専用のお尻になっちゃったわね」
				ELSE
					PRINTFORMW 「はぁ…お尻の中、凄く熱い…」
				ENDIF
			ENDIF
		ELSE
			IF NOWEX:MASTER:射精 > 1 ;big load
				IF !RAND:3
					PRINTFORMW 「はぁぁ…お尻が破けそう…」
				ELSEIF RAND:2
					PRINTFORMW 「んん、よくお尻でこんなに出るわね…」
				ELSE
					PRINTFORMW 「ぁ…」
					PRINTFORMW 腸内に吐き出された精液が卑猥な音を立てて溢れた
				ENDIF
			ELSE
				IF !RAND:3
					PRINTFORMW 「ん…お尻に、入ってきてる…」
				ELSEIF RAND:2
					PRINTFORMW 「お尻って気持ち良いの…？」
				ELSE
					PRINTFORMW 「はぁ…お尻の中、凄く熱い…」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1

