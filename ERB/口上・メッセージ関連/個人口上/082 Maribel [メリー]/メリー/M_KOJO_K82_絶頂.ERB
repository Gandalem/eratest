@M_KOJO_MESSAGE_PALAMCNG_D_K82(ARG)
;-------------------------------------------------
;After reaching certain threshold for palams for the first time
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;don't show if unconscious
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 0
;-------------------------------------------------
;初めて好意がLV2超えた
;-------------------------------------------------
IF !(MARK:反発刻印 || CFLAG:ブチギレ) && PALAM:好意 + UP:好意 > PALAMLV:3 && FIRSTTIME("好意V2")
	PRINTFORML 「후훗, 당신은 잘 착하다는 말을 듣지 못했어?」
	PRINTFORMW 왜 웃었는지는 모르겠지만, 어느 정도 마음을 열어준 증거겠지.
ENDIF
;-------------------------------------------------
;初めて優越がLV2超えた
;-------------------------------------------------
IF PALAM:優越 + UP:優越 > PALAMLV:3 && FIRSTTIME("優越V2")
	PRINTFORML 「다음은 어떻게 할까요」
	PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"를")% 끌어당기듯이 일을 진행해 나간다.
ENDIF
SIF CFLAG:うふふ != 1 ;don't show stuff below unless having sex
	RETURN 0
;-------------------------------------------------
;初めて潤滑がLV2超えた
;-------------------------------------------------
IF PALAM:潤滑 + UP:潤滑 > PALAMLV:2 && FIRSTTIME("潤滑V2")
	IF IS_SELECTCOM("ローション")
		IF TALENT:恋慕
			PRINTFORMW 「미끌거리네... 다음엔 어떻게 할 거야?」
		ELSE
			PRINTFORMW 「차가워서 미끌미끌해... 기분 나빠」
		ENDIF
	ELSEIF TALENT:恋慕
		PRINTFORML 「저, 저도 여자잖아요. 좋아하는 사람에게 사랑받으면 이렇게 되는 거예요」
		PRINTFORMW 메리는 은밀한 곳에서 전해지는 액체를 숨기며 부끄러운 듯 말했다
	ELSE
		PRINTFORMW (에엣... 거짓말, 나 축축해...)
		PRINTFORML 「이, 이건 아니야!」
		PRINTFORMW 메리는 은밀한 곳에서 새어 나오는 애액을 필사적으로 부정하고 있었다
	ENDIF
ENDIF
;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
IF PALAM:欲情 + UP:欲情 > PALAMLV:3 && FIRSTTIME("欲情V2")
	IF IS_SELECTCOM("媚薬")
		IF TALENT:恋慕
			PRINTFORML 「왠지 머리가 몽롱해지는 것 같아……」
			PRINTFORMW 메리의 뺨이 홍조를 띠고 눈동자도 불안했다.
		ELSE
			PRINTFORMW 「크, 약 때문이야...... 그러니까......」
			PRINTFORMW 「하지만, ......흐윽......」
			PRINTFORMW (싫어, 머리가 어지럽고... 몸이 뜨거워서 아무것도 생각할 수 없어......)
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「응, 하아……」
			PRINTFORMW 메리의 숨결에 색기가 더해졌다.
		ELSE
			PRINTFORMW (우으... 이런 식으로 당하면 참을 수 없게 되어버려...)
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;初めて恥情がLV2超えた
;-------------------------------------------------
IF PALAM:恥情 + UP:恥情 > PALAMLV:3 && FIRSTTIME("恥情V2")
	IF TALENT:恋慕
		PRINTFORML 「그, 그렇게 많이 보여지면 부끄럽잖아...」
		PRINTFORMW 메리는 볼을 붉히며 %조사처리(CALLNAME:MASTER,"의")% 시선에서 벗어나려고 하고 있다.
	ELSE
		PRINTFORML 「……！」
		PRINTFORMW 메리는 얼굴을 새빨갛게 하고 고개를 숙이고 있다.
	ENDIF
ENDIF
;-------------------------------------------------
;初めて恐怖がLV2超えた
;-------------------------------------------------
IF PALAM:恐怖 + UP:恐怖 > PALAMLV:3 && FIRSTTIME("恐怖V2")
	PRINTFORMW 「이... 싫어... 오, 오지 마...!」
	PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 손을 내밀자 메리는 움찔 몸을 떨었다.
ENDIF
