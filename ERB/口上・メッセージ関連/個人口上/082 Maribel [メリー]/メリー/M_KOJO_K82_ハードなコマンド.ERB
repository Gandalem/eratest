;==================================================
;100,スパンキング
;==================================================
@M_KOJO_MESSAGE_COM_K82_100
CALL M_KOJO_MESSAGE_COM_K82_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「痛っ、待って、私何か悪いことしたの、あぅっ！」
		PRINTFORMW 「お願い、痛いのは……やっ、やめっ！ 何か駄目だったら気をつけるから、これ以上は……！」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:マゾっ気 >= 3
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「はぁっ、んんっ！ れ、蓮子、私、おかしいの、叩かれてるのに、感じてる……！」
				PRINTFORMW 「蓮子、私っ、どうしてっ……！」
			ELSEIF RAND:2
				PRINTFORMW 「痛っ、あぁ……%CALLNAME:MASTER%っ、もう……私……」
			ELSE
				PRINTFORMW 「あぁっ、私っ、おか、おかしくなって……叩かれてるのに、感じてる……！」
				PRINTFORMW 「%CALLNAME:MASTER%っ、私っ、あぁっ、どうしてっ、どうしてなの……！」
			ENDIF
		ELSE
			IF RAND:2
				PRINTFORMW 「ごめんなさい、ごめんなさい……！ 痛いのは、嫌なの……」
			ELSE
				PRINTFORMW 「痛っ 痛いのは嫌……」
			ENDIF
		ENDIF
		RETURN 1
	;屈服3
	;ELSEIF MARK:不埒刻印 == 3
	;	RETURN 1
	;それ以外
	ELSE
		IF ABL:マゾっ気 >= 3
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「痛い……蓮子……」
				CALL CHARA_TEXT([[蓮子]], "『とか言いながらも……ちょっと、身体が疼いていたりしてない？』", "w")
				PRINTFORMW 「……！ そ、そんなわけ、ないわよ……」
			ELSE
				PRINTFORMW 「痛いっ、あぁ……んっ、やだ、いやぁ……」
				PRINTFORMW （どうして……叩かれてるのに、痛いのに、体が疼いてる……？）
			ENDIF
		ELSE
			PRINTFORMW 「えっ、何を……痛い、痛いっ！！」
			PRINTFORMW 「何よ、暴力で従わせようなんて……！」
			PRINTFORMW 「痛っ、叩かないで、お願いっ、やだっ……！」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;104,アイマスク
;==================================================
@M_KOJO_MESSAGE_COM_K82_104
CALL M_KOJO_MESSAGE_COM_K82_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「真っ暗……。ね……%CALLNAME:MASTER%、そばにいてね……」
		ELSE
			PRINTFORMW 「見えなくして……それで何するつもり？」
		ENDIF		
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				IF ABL:マゾっ気 >= 3
					PRINTFORMW 「見えないまま何かされる……なんて……」
					CALL CHARA_TEXT([[蓮子]], "『興奮する？ 見えないままで何をされるのかって』", "w")
					PRINTFORMW 「そ、そんなわけ……ない、わよ……」
				ELSE
					PRINTFORMW 「何も見えなくてにいつ何をされるかと思うと……」
					CALL CHARA_TEXT([[蓮子]], "『興奮する？』", "w")
					PRINTFORMW 「よく……わからないわ……。でも、メリーになら……」
				ENDIF
			ELSE
				PRINTFORMW 「何も見えないままで貴方に何をされるのかと思うと……あぁ……」
			ENDIF
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	RETURN 1
		;それ以外
		ELSE
			IF IS_HERE([[蓮子]])
				IF ABL:マゾっ気 >= 3
					PRINTFORMW 「見えないまま何かされる……なんて」
					CALL CHARA_TEXT([[蓮子]], "『見えないままで何かされることに興奮したりはしない？』", "w")
					PRINTFORMW 「そ、そんなわけ……ないわよ。ちょっと、怖いだけ……」
				ELSE
					CALL CHARA_TEXT([[蓮子]], "『真っ暗で怖いとか、そういうのは大丈夫かしら？』", "w")
					CALL CHARA_TEXT([[蓮子]], "『でも、見えないまま何かされるっていうのも興奮すると思うわよ？』", "w")
					PRINTFORMW 「……よく、わからないわ。蓮子の顔が見れないってことが一番嫌なのかも……」
				ENDIF
			ELSE
				PRINTFORMW 「真っ暗……うぅ……何するつもりよ……」
				PRINTFORMW （暗い方がかえって落ち着くわ……）
				PRINTFORMW （何されるかわからないのは怖いけど、顔を見ずにすむから）
			ENDIF
		ENDIF
	;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「ああ、やっと終わりね……。蓮子、抱きしめていい？ まだ、ちょっと怖くて……」
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%、怖かった……」
				PRINTFORMW 「お願い、次は、貴方の顔を見ながら……」
			ENDIF
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「外すの？ ……そう」
		ENDIF 
	ENDIF
ENDIF
RETURN 1

;==================================================
;105,縄
;==================================================
@M_KOJO_MESSAGE_COM_K82_105
CALL M_KOJO_MESSAGE_COM_K82_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%、縄で何を……え、縛る？ ちょっと、本格的過ぎない？」
			PRINTFORMW 「あまりきつく縛らないでね……」
		ELSE
			PRINTFORMW 「何……え、縛るって……私を？」
			PRINTFORMW 「じょ、冗談じゃ……や、やめてよ、痛っ、痛いってば、そんなきつく縛らないで！」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 3
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『濡れてる……メリー、もしかして……』", "w")
				PRINTFORMW 「ぅ……ん……わ、私……縛られて、感じちゃってる……！」
				PRINTFORMW 「お願い%CALLNAME:MASTER%、もっと私を苛めておかしくして！ 我慢できないの！」
			ELSE
				PRINTFORMW 「きつく縛られて、身動き取れなくて……何されるのかわからなくて怖いのに」
				PRINTFORMW 「痛いのが気持ちいいなんて……お願い%CALLNAME:MASTER%、もっと私をおかしくしてっ！」
			ENDIF
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「くっ……」
				CALL CHARA_TEXT([[蓮子]], "『痛い？ でも我慢してね。これくらいじゃないと調教にならないから』", "w")
				PRINTFORMW 「だ、大丈夫……我慢するわ……」
				PRINTFORMW （蓮子ってそんな趣味あったのかしら……）
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%、もう少し、緩くして……」
				PRINTFORMW 「うぅ……それにこれだと私からご奉仕できないわ……」
			ENDIF
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「ぐっ、うぅ……%CALLNAME:MASTER%、痛い……」
		;それ以外
		ELSE
			IF ABL:マゾっ気 >= 3
				PRINTFORMW 「縛るならせめてきつくしないで……痛いのは嫌……」
			ELSE
				PRINTFORMW 「くぅっ……！ そんなきつく縛らないで……逃げないわよ」
			ENDIF
		ENDIF
	;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「終わりなの蓮子？」
				CALL CHARA_TEXT([[蓮子]], "『え？ もっと続けてほしい？』", "w")
				PRINTFORMW 「動けないままっていうのはちょっとね……」
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORMW 「身動き取れないまま%CALLNAME:MASTER%から一方的にっていうのもいいけど」
				PRINTFORMW 「でも、私からもご奉仕したいのよね……」
			ELSE
				PRINTFORMW 「ああ痛かった……やっぱり、痛いのは苦手……」
			ENDIF
		;それ以外
		ELSE
			PRINTFORMW 「くっ、うぅ……痣だらけ……酷い……」
		ENDIF
	ENDIF
ENDIF
RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※
;ハードな調教コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;140,イラマチオ custom code expanded
;==================================================
@M_KOJO_MESSAGE_COM_K82_140
CALL M_KOJO_MESSAGE_COM_K82_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「んっ、んぶっ、んんー！！」
			PRINTFORMW 「ぷはっ、はぁっ、はぁっ、激しくするなら、先に言ってくれればいいのに」
			PRINTFORMW 「うん、頑張るから、続けていいわよ」
		ELSE
			PRINTFORMW 「んぐっ、んんっ、うぐぅっ、……んんーっ！」
			PRINTFORMW 「げほっ、げほっ、そんな、無理矢理……んぶっ！」
			PRINTFORMW 「うっ、うぇぇぇ……も、やっ、やめっ、んぐっ！」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
	ELSEIF TALENT:恋慕
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「また激しくするの？ いいわ、私の口、いっぱい犯して」
			PRINTFORMW 「んぐっ、んっ、じゅぷっ、……ぷはぁっ、もっと、いっぱいして……」
		ELSE
			PRINTFORMW 「また激しくするの？ いいわ、苦しいけど、我慢する」
			PRINTFORMW 「んぐっ、んっ、じゅぷっ、……ぷはぁっ、はぁっ、頑張るから、もっと……」
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		IF !RAND:3
			PRINTFORMW （苦しい……でもそのまま窒息……とはいかないわよね……）
			PRINTFORMW （ただ我慢して奉仕してれば……）
		ELSEIF RAND:2
			PRINTFORMW 「んっ、ぐっ、じゅぷっ、んんっ、うぐっ……」
			PRINTFORMW 「ぷはっ、はぁっ、はぁっ、苦しっ、あっ……んぐぅっ！」
		ELSE
			PRINTFORMW 「んぐっ、んんっ、んーっ！！ げほっ、く、苦し、はぁっ、はぁっ……」
			PRINTFORMW 「おねが、い、も、もう……んぶぅっ！ んっ、んぐーっ！」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

