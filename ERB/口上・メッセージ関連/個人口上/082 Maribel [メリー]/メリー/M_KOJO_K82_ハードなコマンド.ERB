;==================================================
;140,イラマチオ custom code expanded
;==================================================

@M_KOJO_MESSAGE_COM_K82_140
CALL M_KOJO_MESSAGE_COM_K82_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「응, 음부, 응ー!!」
			PRINTFORMW 「푸핫, 하아, 하아, 격렬하게 할 거면, 미리 말해주면 좋았을 텐데」
			PRINTFORMW 「응, 노력할 테니까, 계속 해도 좋아」
		ELSE
			PRINTFORMW 「윽, 음, 으윽, ……음ー!」
			PRINTFORMW 「콜록, 콜록, 그럴, 수 없어……음부옷!」
			PRINTFORMW 「윽, 으아앙……그, 그만둬, 으윽!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
	ELSEIF TALENT:恋慕
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「또 격하게 할 거야? 좋아, 내 입을 잔뜩 범해줘」
			PRINTFORMW 「응윽, 응윽, 츄릅, ……푸하아, 더, 많이 해줘……」
		ELSE
			PRINTFORMW 「또 격렬하게 하는 거야? 좋아, 괴롭지만 참을게」
			PRINTFORMW 「응윽, 흠, 쭉, ……푸하앗, 하아, 노력할 테니까, 더……」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF !RAND:3
			PRINTFORMW (괴롭지만 그냥 질식...하고 있지는 않을 거야...)
			PRINTFORMW (그냥 참으면서 봉사하고 있으면...)
		ELSEIF RAND:2
			PRINTFORMW 「음, 윽, 꿀꺽, 음, 으윽......」
			PRINTFORMW 「푸하, 하아, 하아, 괴롭다, 아... 응구윽!」
		ELSE
			PRINTFORMW 「으윽, 음, 음—! 콜록, 크윽, 괴로워, 하아, 하아……」
			PRINTFORMW 「부탁해, 해, 이제… 움푹! 끅, 끙!」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
