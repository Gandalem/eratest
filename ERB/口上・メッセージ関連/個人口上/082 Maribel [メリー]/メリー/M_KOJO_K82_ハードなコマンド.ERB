;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K82_100
CALL M_KOJO_MESSAGE_COM_K82_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「아파, 잠깐만, 나 뭔가 잘못한 거야, 아으윽!」
		PRINTFORMW 「부탁이야, 아픈 건... 싫어, 그만해! 무슨 일 있으면 조심할 테니까, 더 이상은...!」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:マゾっ気 >= 3
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「하아, 음윽! 레, 렌코, 나 이상해, 맞고 있는데 느끼고 있어...!」
				PRINTFORMW 「렌코, 나 왜 그래...!」
			ELSEIF RAND:2
				PRINTFORMW 「아파, 아아... %CALLNAME:MASTER%윽, 이제...」
			ELSE
				PRINTFORMW 「아앗, 나... 이상해져버렸어... 맞고 있는데, 느껴지고 있어...!」
				PRINTFORMW 「%CALLNAME:MASTER%윽, 나... 아앗, 왜 그래, 왜 이러는 거야...!」
			ENDIF
		ELSE
			IF RAND:2
				PRINTFORMW 「죄송해요, 죄송해요...! 아픈 건 싫어요...」
			ELSE
				PRINTFORMW 「아파, 아픈 건 싫어……」
			ENDIF
		ENDIF
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	RETURN 1
		;それ以外
	ELSE
		IF ABL:マゾっ気 >= 3
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「아파...렌코...」
				CALL CHARA_TEXT([[蓮子]], "『...라면서도... 몸이 좀 저릿하지 않아?』", "w")
				PRINTFORMW 「……! 그, 그럴 리가……」
			ELSE
				PRINTFORMW 「아파, 아아... 응, 싫어, 안 돼...」
				PRINTFORMW (왜... 맞고 있는데, 아픈데, 몸이 저릿한 거지...?)
			ENDIF
		ELSE
			PRINTFORMW 「엣, 뭘... 아파, 아파!!」
			PRINTFORMW 「뭐야, 폭력으로 복종시키려는 거야...!」
			PRINTFORMW 「아파, 때리지 마, 부탁이야, 싫어...!」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;104,アイマスク
;==================================================

@M_KOJO_MESSAGE_COM_K82_104
CALL M_KOJO_MESSAGE_COM_K82_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「완전히 어두워……. 있... %CALLNAME:MASTER%, 곁에 있어 줘...」
		ELSE
			PRINTFORMW 「보이지 않게 해서... 그래서 뭘 할 셈이야?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				IF ABL:マゾっ気 >= 3
					PRINTFORMW 「보이지 않은 채 무언가를 당한다니……」
					CALL CHARA_TEXT([[蓮子]], "『흥분해? 보이지 않는 채로 뭘 당하게 될지 말이야』", "w")
					PRINTFORMW 「그, 그럴 리가 없어요……」
				ELSE
					PRINTFORMW 「아무것도 보이지 않으니 언제 뭘 당할지 생각하면……」
					CALL CHARA_TEXT([[蓮子]], "『흥분해?』", "w")
					PRINTFORMW 「잘... 모르겠어.... 하지만, 메리라면...」
				ENDIF
			ELSE
				PRINTFORMW 「아무것도 볼 수 없는 상태에서 당신에게 무엇을 당하게 될지 생각하니... 아아...」
			ENDIF
			;屈服3
			;ELSEIF MARK:不埒刻印 == 3
			;	RETURN 1
			;それ以外
		ELSE
			IF IS_HERE([[蓮子]])
				IF ABL:マゾっ気 >= 3
					PRINTFORMW 「보이지 않은 채 무언가를 당하다니...」
					CALL CHARA_TEXT([[蓮子]], "『보이지 않는 채로 무언가를 당하는 것에 흥분하지 않아?』", "w")
					PRINTFORMW 「그, 그럴 리가... 그냥 조금 무서울 뿐이야...」
				ELSE
					CALL CHARA_TEXT([[蓮子]], "『완전 깜깜하고 무서운 건 괜찮을까?』", "w")
					CALL CHARA_TEXT([[蓮子]], "『でも、見えないまま何かされるっていうのも興奮すると思うわよ？』", "w")
					PRINTFORMW 「......잘 모르겠어. 렌코의 얼굴을 볼 수 없다는 게 제일 싫은 걸지도 몰라...」
				ENDIF
			ELSE
				PRINTFORMW 「완전 어두워... 으윽... 뭘 하려는 거야...」
				PRINTFORMW (어두운 쪽이 오히려 마음이 편하네...)
				PRINTFORMW (무슨 일을 당할지 모르니 무섭지만, 얼굴을 보지 않아도 되니까)
			ENDIF
		ENDIF
		;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「아, 드디어 끝났네……. 렌코, 안아도 돼? 아직, 조금 무서워서…….」
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%, 무서웠어...」
				PRINTFORMW 「부탁이야, 다음엔 당신의 얼굴을 보면서...」
			ENDIF
			;屈服3
			;ELSEIF MARK:不埒刻印 == 3
			;	RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「벗을 거야? ……그렇구나」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;105,縄
;==================================================

@M_KOJO_MESSAGE_COM_K82_105
CALL M_KOJO_MESSAGE_COM_K82_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%, 밧줄로 뭘... 에, 묶는 거야? 좀, 너무 본격적이지 않아?」
			PRINTFORMW 「너무 세게 묶지 말아줘...」
		ELSE
			PRINTFORMW 「뭐... 에, 묶는 거라고... 나를?」
			PRINTFORMW 「장, 농담이잖아... 그만해줘, 아파, 아프다고, 그렇게 세게 묶지 마!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 3
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『젖었어... 메리, 혹시...』", "w")
				PRINTFORMW 「흐으윽... 음... 저, 저는... 묶여서, 느껴버리고 있어요...!」
				PRINTFORMW 「부탁이에요%CALLNAME:MASTER%, 더 저를 괴롭혀서 미치게 해줘! 참을 수 없어요!」
			ELSE
				PRINTFORMW 「단단히 묶여서 몸을 움직일 수 없고... 무슨 일이 벌어질지 몰라서 무서워요」
				PRINTFORMW 「아픈 게 기분 좋은 거라니... 부탁이야%CALLNAME:MASTER%, 더 나를 이상하게 해줘!」
			ENDIF
		ELSEIF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「흑...」
				CALL CHARA_TEXT([[蓮子]], "『아파? 그래도 참아줘. 이 정도 아니면 교정(조교)이 안 되니까.』", "w")
				PRINTFORMW 「다, 괜찮아... 참을게...」
				PRINTFORMW (렌코는 그런 취향이 있었던 걸까...)
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%, 조금 더, 느슨하게 해줘...」
				PRINTFORMW 「으윽... 게다가 이 상태로는 나부터 봉사할 수가 없어...」
			ENDIF
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「윽, 으윽……%CALLNAME:MASTER%, 아파……」
			;それ以外
		ELSE
			IF ABL:マゾっ気 >= 3
				PRINTFORMW 「묶는 거라면 적어도 세게 하지 말아줘... 아픈 건 싫어...」
			ELSE
				PRINTFORMW 「크윽...! 그렇게 세게 묶지 말아줘... 도망가지 않을 거야」
			ENDIF
		ENDIF
		;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「끝나는 거야, 렌코?」
				CALL CHARA_TEXT([[蓮子]], "『에? 더 계속 해줬으면 좋겠어?』", "w")
				PRINTFORMW 「움직일 수 없는 상태라는 건 좀 말이야……」
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORMW 「움직일 수 없는 채 %CALLNAME:MASTER%로부터 일방적으로 하는 것도 좋지만」
				PRINTFORMW 「하지만, 저도 봉사하고 싶어요……」
			ELSE
				PRINTFORMW 「아, 아팠어... 역시, 아픈 건 못 하겠네...」
			ENDIF
			;それ以外
		ELSE
			PRINTFORMW 「커헉, 으윽... 온통 멍이야... 너무 심해...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※
