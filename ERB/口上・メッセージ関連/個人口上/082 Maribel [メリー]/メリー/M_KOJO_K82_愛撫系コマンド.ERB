			PRINTFORML 「んっ%UNICODE(0x2665) *1%どう？私の境界の味は%UNICODE(0x2665) *1%」
		ENDIF
		
		IF ABL:Ｃ感覚 >= 3
			IF !RAND:4
				PRINTFORMW 「あっ、はぁっ……気持ちいい……」
