	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_FALLEN()
			PRINTFORMW %CALLNAME:MASTER%がメリーの胸に手を添えると、メリーの体がぴくりと震えた
			PRINTFORMW 「あ、あのね…私のこと、嫌いにならないでね？」
			PRINTFORMW 突然何を言い出すのか、メリーは心配そうな顔で%CALLNAME:MASTER%を見つめている
			PRINTFORMW 「私、この胸が大きいばかりで邪魔だって思っていたの、男からも女からも変な目で見られるし」
			PRINTFORMW 「でも、%CALLNAME:MASTER%に気に入って貰えるのなら、これでいいのかなって……」
			PRINTFORMW 「あと、胸の大きな女は頭が悪いって言うじゃない？　だから、その…あっ」
			PRINTFORMW 何も言わず額に口付けをする
			PRINTFORMW それだけでメリーの体は緊張を解き%CALLNAME:MASTER%に身を委ねた
			PRINTFORMW 「ええ、いいわよ……、いっぱい揉んで……」
			PRINTFORMW 「……んんっ%UNICODE(0x2665) *1%駄目よ、もっと胸揉んで%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「む、胸を触るの？　あんまり乱暴にしないでね…？」
		ENDIF
		IF IS_HERE([[蓮子]])
			PRINTFORML
			CALL CHARA_TEXT([[蓮子]], "『はぁ……』", "w")
			PRINTFORMW 「……？ どうかしたの？」
			CALL CHARA_TEXT([[蓮子]], "『……なんでもないわよ、全く、もう、このっ！』", "w")
			PRINTFORMW 「えっ、あっ、な、何、いきなりそんな強く……っ！」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	ELSEIF IS_HERE([[蓮子]]) && ONCE("MerryRenkoBoobGrab")
		IF RAND:2
			CALL CHARA_TEXT([[蓮子]], "『あー、もう、どこをどうすればこんなに大きくなるってのよ、もうっ！』", "w")
		ELSE
			CALL CHARA_TEXT([[蓮子]], "『むー……どうしたらこうなるのよ』", "w")
			CALL CHARA_TEXT([[蓮子]], "『羨ましいったらありゃしないわもう、全く、この胸がぁ！』", "w")
			PRINTFORMW 「あっ、もう、だからって、そんなに強くはだめぇっ！」
		ENDIF
	ELSEIF IS_FALLEN() && !RAND:3
