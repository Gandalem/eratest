@M_KOJO_MESSAGE_COM_K82_0
CALL M_KOJO_MESSAGE_COM_K82_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「아, 상냥하게 해줘…?」
		PRINTFORMW 「응읏%UNICODE(0x2665) *1% 간지러워%UNICODE(0x2665) *1%」
		PRINTFORMW 「으응… 내 몸, 이상하지 않아…?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORML 「응%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「응읏%UNICODE(0x2665) *1% 좀 더 사랑해줘엇%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「아앗%UNICODE(0x2665) *1% 좀 더 만져줘엇%UNICODE(0x2665) *1%」
		ENDIF
		IF ABL:Ｃ感覚 >= 3
			IF !RAND:3
				PRINTFORML 「아앗, %CALLNAME:MASTER%……응음, 쪽……」
				PRINTFORMW 「더, 더 만져줘……」
			ELSEIF !RAND:3
				PRINTFORMW 「하아... %조사처리(CALLNAME:MASTER,"의")% 손, 따뜻해...」
			ELSEIF RAND:2
				PRINTFORML 「응, 후아! 더, 세게 해도 괜찮아...?」
				PRINTFORMW 더욱 애무를 계속하자 메리는 한층의 희열에 몸을 떨었다
			ELSE
				PRINTFORML 「응, 츄... 좋아해, 좋아해...」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"에게")% 애무를 받으며 키스를 청한다.
			ENDIF
		ELSE
			IF !RAND:3
				PRINTFORMW 「응, 흐으... 나만 기분 좋아져도... 히얏!」
			ELSEIF RAND:2
				PRINTFORMW 「이렇게 해주니 당신에게 안겨있는 것 같아서, 정말 마음이 놓여...」
			ELSE
				PRINTFORMW 「아, 응... 역시 좋아하는 사람에게 당하는 게 더 기분 좋네...」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
