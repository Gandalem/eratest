			PRINTFORML 「んあっ%UNICODE(0x2665) *1%んああっ%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「んっ%UNICODE(0x2665) *1%もっと舐めてっ%UNICODE(0x2665) *1%」
