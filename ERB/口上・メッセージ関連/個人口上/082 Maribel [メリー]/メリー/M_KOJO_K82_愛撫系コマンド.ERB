@M_KOJO_MESSAGE_COM_K82_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「히익… 그, 그런 곳을 핥는 거야…?」
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%내 경계에 관심이 있는 거구나%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORML 「응앗%UNICODE(0x2665) *1% 응아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「응읏%UNICODE(0x2665) *1% 좀 더 핥아줘엇%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「응읏%UNICODE(0x2665) *1% 어때? 내 경계의 맛은%UNICODE(0x2665) *1%」
		ENDIF
		IF ABL:Ｃ感覚 >= 3
			IF !RAND:4
				PRINTFORMW 「앗, 하아... 기분 좋아...」
				PRINTFORMW 「더, 더 해줘...」
			ELSEIF !RAND:3
				PRINTFORML 「히앗! 응, 큭!」
				PRINTFORMW 혀로 작게 클리토리스를 자극하자 메리는 몸을 뒤틀며 등을 돌렸다.
			ELSEIF RAND:2
				PRINTFORMW 「흐윽! 거긴, 따끔거려...!」
			ELSE
				PRINTFORML 「아아앗! 혀가, 들어오고 있어!」
				PRINTFORMW 은밀한 곳에 혀를 넣자 메리는 전신을 강하게 떨었다.
			ENDIF
		ELSE
			IF !RAND:4
				PRINTFORMW 「아, 역시 부끄러워...」
				PRINTFORMW 메리의 얼굴은 수치심으로 물들어 양손으로 가리고 있다.
			ELSEIF !RAND:3
				PRINTFORML 「아앗, 거기, 좋아...」
				PRINTFORMW 혀로 비핵을 굴리자 메리는 단속적으로 몸을 떨었다.
			ELSEIF RAND:2
				PRINTFORML 「아, 핥아 주는 거야...?」
				PRINTFORMW 메리는 부끄러운 듯 다리를 벌렸다
			ELSE
				PRINTFORMW 「응응, 아... 소리가 나버릴 것 같아...!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
