@M_KOJO_MESSAGE_COM_K82_3
CALL M_KOJO_MESSAGE_COM_K82_3_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_HERE([[蓮子]])
			IF ABL:Ｖ感覚 >= 3
				CALL CHARA_TEXT([[蓮子]], "『어때 메리 이 근처가 괜찮을까?』", "w")
				PRINTFORMW 「우, 응... 괜찮아, 기분 좋아... 그대로, 움직여줘...」
			ELSE
				CALL CHARA_TEXT([[蓮子]], "『메리, 어때? 이 근처 같은 곳은... 기분 좋아?』", "w")
				PRINTFORMW 「음... 조금만...」
				CALL CHARA_TEXT([[蓮子]], "『아직 별로 익숙하지 않으니까, 조금씩 익숙해지게 해 줄 테니까』", "w")
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORMW 「풀어 주는 거야? 고마워」
			PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"에게")% 등을 기대며 손가락 삽입을 받아들였다
			PRINTFORMW 「응…… 손가락, 기분 좋아……%CALLNAME:MASTER%…… 그대로 움직여 줘……」
			PRINTFORMW 「거기%UNICODE(0x2665) *1% 약해앳%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「에? 풀까? 우, 응...」
			PRINTFORMW 메리는 조금 당황한 듯 대답했다.
			PRINTFORMW (그럼 결국 본방까지 한다는 거야? 그러니까...)
		ENDIF
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;バイブの有無で分岐
	ELSEIF TEQUIP:バイブ
		IF RAND:3 == 0
			PRINTFORMW 「응앗 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 이런 건 모른단 말이야앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 바이브 굵어엇%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF !FLAG:70 && IS_VIRGIN(TARGET) && CFLAG:2 >= 1500 && FIRSTTIME("MarisaFingerPop")
			PRINTFORML
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「응, 아앗... 어? 렌코, 무슨 일이야?」
				CALL CHARA_TEXT([[蓮子]], "『메리... 좋아? 이대로, 안쪽까지...』", "w")
				PRINTFORMW 「에, 렌코……. 그건, ……」
				CALL CHARA_TEXT([[蓮子]], "『메리……. ……부탁이야, 네 첫 경험을 내가 가져도 될까?』", "w")
			ELSE
				PRINTFORMW 「손가락을 넣는 거야? 이쪽이 더 안 아픈 거야? 하지만 나는...」
				PRINTFORMW 메리는 파과(破瓜)의 고통에 대한 공포와 처녀를 바치는 행위 사이에서 갈등하고 있다.
				IF TALENT:恋慕
					PRINTFORMW 한참 생각한 후에, 메리는 작게 고개를 끄덕였다.
					PRINTFORMW 「어떤 형태라도 %조사처리(CALLNAME:MASTER,"로")% 해달라는 건 변함이 없겠지」
				ENDIF
			ENDIF
			CALL ASK_YN("그녀를 순결하지 못하게 해라!", "하지 마!")
			IF !RESULT
				IF IS_HERE([[蓮子]])
					PRINTFORMW 「……」
					PRINTFORMW 「……응, 렌코라면 괜찮아. 그대로, 안쪽까지……」
					SIF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲
						PRINTFORMW (%CALLNAME:MASTER%, 죄송해요, 하지만 저...)
				ELSEIF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲
					PRINTFORMW 크게 심호흡하고 각오를 다진다.
					PRINTFORMW 「응구우! 역시 아파……」
					PRINTFORMW 눈에 가득 고인 눈물을 머금은 채 자신의 은밀한 곳에서 흘러나오는 파경의 증거를 보자, 메리는 행복하게 웃었다.
				ELSE
					PRINTFORMW 「에!? 저, 잠깐만요... 아파아앗!」
					PRINTFORMW 갑작스러운 하복부의 통증에 메리가 놀랐고, 비음 사이에서 붉은 것이 흘러내렸다.
					PRINTFORMW 하지만 메리는 의외로 침착했고, 파과 자체에는 그다지 놀라지 않은 듯했다.
					PRINTFORMW (렌코, 미안해...)
				ENDIF
				CALL COLORMESSAGE(@"처녀성 상실 (%CALLNAME:TARGET%)", 0xF7ABA6, 2)
				CALL SET_HISTORY_LOST_V(TARGET, IS_HERE([[蓮子]]) ? [[蓮子]] # MASTER, "指")
				STAIN:Ｖ |= 64
				STAIN:MASTER:手 |= 64
				PALAM:苦痛 += 500
				IF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲 || IS_HERE([[蓮子]])
					PALAM:反感 += 300
					PALAM:抑鬱 += 300
				ELSE
					PALAM:反感 += 1000
					PALAM:抑鬱 += 1000
				ENDIF
			ELSE
				GOTO CANCEL
			ENDIF
			RETURN 1
		ENDIF
		$CANCEL
		IF TALENT:恋慕 && RAND:3
			IF RAND:2
				PRINTFORML 「응! 으아, 하아앗!」
				PRINTFORMW 메리의 질은 %조사처리(CALLNAME:MASTER,"의")% 손가락을 뿌리까지 삼키며 달라붙어 놓지 않는다.
				PRINTFORMW 「흡, 으아악! 굉장해, 더 해줘!」
			ELSE
				PRINTFORMW 「기분은 좋지만... 나만 이런 건...」
				PRINTFORMW 「%CALLNAME:MASTER%것도 갖고 싶네...」
			ENDIF
		ELSEIF RAND:5 == 0 && !IS_FALLEN()
			PRINTFORMW 「아, 아으윽, 그, 그렇게 하면 저...」
		ELSEIF RAND:4 == 0 && !IS_FALLEN()
			PRINTFORMW 「응, 후우... 응으!」
			PRINTFORMW 손가락 끝으로 작게 쓰자 메리는 움찔 몸을 떨었다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「보지 안 돼어엾%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응%UNICODE(0x2665) *1%잠깐%UNICODE(0x2665) *1%안 돼앳%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「손가락읏%UNICODE(0x2665) *1% 굵은 거읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
