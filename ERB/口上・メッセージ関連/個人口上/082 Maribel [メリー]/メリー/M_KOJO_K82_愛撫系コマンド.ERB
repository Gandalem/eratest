@M_KOJO_MESSAGE_COM_K82_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「や、優しくしてね…？」
		PRINTFORMW 「んっ%UNICODE(0x2665) *1%くすぐったいわ%UNICODE(0x2665) *1%」
		PRINTFORMW 「んん…私の体、変じゃない…？」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORML 「んっ%UNICODE(0x2665) *1%ああっ%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「んっ%UNICODE(0x2665) *1%もっと愛してっ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「あっ%UNICODE(0x2665) *1%もっと触ってっ%UNICODE(0x2665) *1%」
		ENDIF
	
		IF ABL:Ｃ感覚 >= 3
			IF !RAND:3
				PRINTFORML 「ああっ、%CALLNAME:MASTER%……んんっ、ちゅっ……」
				PRINTFORMW 「もっと、もっと触って……」
			ELSEIF !RAND:3
				PRINTFORMW 「はぁ…%CALLNAME:MASTER%の手、暖かい…」
			ELSEIF RAND:2
				PRINTFORML 「んっ、ふぁぁ！　もっと、強くしても良いのよ…？」
				PRINTFORMW 更に愛撫を続けるとメリーは一層の愉悦に身を震わせた
			ELSE
				PRINTFORML 「ん、ちゅ…好き、好き…」
				PRINTFORMW メリーは%CALLNAME:MASTER%に愛撫されながらキスをせがんでくる
			ENDIF
		ELSE
			IF !RAND:3
				PRINTFORMW 「ん、ふぁ…私だけ気持ち良くなっても…ひぁっ！」
			ELSEIF RAND:2
				PRINTFORMW 「こうされると貴方に包まれてるみたいで、凄く安心できるわ…」
			ELSE
				PRINTFORMW 「あ、んん…やっぱり好きな人にされる方が気持ち良いわね…」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
