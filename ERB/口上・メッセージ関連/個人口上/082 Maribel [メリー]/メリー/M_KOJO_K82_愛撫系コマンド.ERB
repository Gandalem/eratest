@M_KOJO_MESSAGE_COM_K82_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_HERE([[蓮子]])
			IF ABL:Ｖ感覚 >= 3
				CALL CHARA_TEXT([[蓮子]], "『どう、メリー、この辺りがいいのかしら？』", "w")
				PRINTFORMW 「う、うん……いいよ、気持ちいいわ……そのまま、動いて……」
			ELSE
				CALL CHARA_TEXT([[蓮子]], "『メリー、どうかしら？ この辺りとか……気持ちいい？』", "w")
				PRINTFORMW 「ん……少しだけ……」
				CALL CHARA_TEXT([[蓮子]], "『まだあまり慣れてないからよ、少しずつ慣らしてあげるからね』", "w")
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORMW 「解してくれるの？　ありがとう」
			PRINTFORMW メリーは%CALLNAME:MASTER%に背中を預けながら指の挿入を受け入れた
			PRINTFORMW 「ん……指、気持ちいい……%CALLNAME:MASTER%……そのまま、動いて……」
			PRINTFORMW 「そこっ%UNICODE(0x2665) *1%弱いのっ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「え？　解す？　う、うん…」
			PRINTFORMW メリーは少し戸惑った様子で答えた
			PRINTFORMW （それってつまり、本番までするってこと？　つまり……）
		ENDIF
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;バイブの有無で分岐
	ELSEIF TEQUIP:バイブ
		IF RAND:3 == 0
			PRINTFORMW 「んあっ%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「んっ%UNICODE(0x2665) *1%こんなの知らないっ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「んっ%UNICODE(0x2665) *1%バイブ太いのっ%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF !FLAG:70 && IS_VIRGIN(TARGET) && CFLAG:2 >= 1500 && FIRSTTIME("MarisaFingerPop")
			PRINTFORML
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「んっ、あぁっ……え？ 蓮子、どうかした？」
				CALL CHARA_TEXT([[蓮子]], "『メリー……いい？ このまま、奥まで……』", "w")
				PRINTFORMW 「え、蓮子……。それって、…………」
				CALL CHARA_TEXT([[蓮子]], "『メリー……。……お願い、あなたの初めて、私が貰っていい？』", "w")
			ELSE
				PRINTFORMW 「指を入れる？　こっちの方が痛くないの？　でも私…」
				PRINTFORMW メリーは破瓜の痛みへの恐怖と処女を捧げるという行為の板挟みにされている
				IF TALENT:恋慕
					PRINTFORMW 一頻り考えたあとに、メリーは小さく頷いた
					PRINTFORMW 「どんな形でも%CALLNAME:MASTER%にしてもらうことに変わりないものね」
				ENDIF
			ENDIF
			CALL ASK_YN("Deflower her!", "Don't!")
			IF !RESULT
				IF IS_HERE([[蓮子]])
					PRINTFORMW 「……」
					PRINTFORMW 「……うん、蓮子なら、いいわ。そのまま、奥まで……」
					SIF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲
						PRINTFORMW （%CALLNAME:MASTER%、ごめんなさい、でも、私……）
				ELSEIF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲
					PRINTFORMW 大きく深呼吸して覚悟を決める
					PRINTFORMW 「んぐぅ！　や、やっぱり痛いぃ……」
					PRINTFORMW 目に一杯の涙を湛えながら自分の秘所から流れる破瓜の証を見ると、メリーは幸せそうに笑った
				ELSE
					PRINTFORMW 「え！？　ちょ、ちょっと、待っ…いっ痛いぃ！」
					PRINTFORMW 突然の下腹部の痛みにメリーが驚くと、秘唇の間から赤い物が流れ落ちた
					PRINTFORMW しかしメリーは意外にも冷静で、破瓜自体にはあまり驚いていない様子だった
					PRINTFORMW （蓮子、ごめんなさい……）
				ENDIF
				CALL COLORMESSAGE(@"Virginity Loss (%CALLNAME:TARGET%)", 0xF7ABA6, 2)
				CALL SET_HISTORY_LOST_V(TARGET, IS_HERE([[蓮子]]) ? [[蓮子]] # MASTER, "指")
				STAIN:Ｖ |= 64
				STAIN:MASTER:手 |= 64
				PALAM:苦痛 += 500
				IF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲 || IS_HERE([[蓮子]])
					PALAM:反感 += 300
					PALAM:抑鬱 += 300
				ELSE
					PALAM:反感 += 1000
					PALAM:抑鬱 += 1000
				ENDIF
			ELSE
				GOTO CANCEL
			ENDIF
			RETURN 1
		ENDIF
	
		$CANCEL
		IF TALENT:恋慕 && RAND:3
			IF RAND:2
				PRINTFORML 「んん！　ふぁ、はぁぁっ！」
				PRINTFORMW メリーのヴァギナは%CALLNAME:MASTER%の指を根元まで呑み込み絡み付いて離さない
				PRINTFORMW 「ひっ、ぅああ！　凄い、もっとしてぇ！」
			ELSE
				PRINTFORMW 「気持ちいいけど……私ばかりっていうのも……」
				PRINTFORMW 「%CALLNAME:MASTER%のも欲しいな……」
			ENDIF
		ELSEIF RAND:5 == 0 && !IS_FALLEN()
			PRINTFORMW 「あ、あぅっ、そ、そんなにしたら、私……！」
		ELSEIF RAND:4 == 0 && !IS_FALLEN()
			PRINTFORMW 「ん、ふぅ…んぅ！」
			PRINTFORMW 指の腹で小さく撫でるとメリーはびくりと体を震わせた
		ELSEIF RAND:3 == 0
			PRINTFORMW 「おまんこだめぇっ%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「んっ%UNICODE(0x2665) *1%ちょっとっ%UNICODE(0x2665) *1%駄目っ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「んっ%UNICODE(0x2665) *1%」
			PRINTFORMW 「指っ%UNICODE(0x2665) *1%太いのっ%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1

