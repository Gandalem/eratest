RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_305_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「이걸로 됐지?」
		PRINTFORMW 메리는 짜증 난 듯 무릎을 내밀었다.
	ELSEIF TALENT:恋慕 && ONCE("MerryLapPillow") ;custom code
		PRINTFORMW 「여기 누워 있어. 무릎 베개 해 줄게.」
		IF !RAND:3
			PRINTFORMW 「매일 열심히 해주고 있잖아, 이 정도밖에 고맙다고 말할 수 없지만 고마워.」
		ELSEIF RAND:2
			PRINTFORMW 「후훗, 당신 얼굴이 잘 보이네요... 아, 그렇게 부끄러워할 필요 없잖아요.」
		ELSE
			PRINTFORMW 「잠자리 어때? 최고로 기분 좋아? 고마워」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「후훗, 잘했어」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「어라? 졸려졌니?」
		ELSE
			PRINTFORMW 「착하다, 쓰다듬어 줄게」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「이러면 꼭 엄마 같네, 나」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응, 어때? 기분 좋아?」
		ELSE
			PRINTFORMW 「잠자리 좋다? 실례네, 살쪘지 않아」
			PRINTFORMW 메리는 그렇게 말하면서도 상냥하게 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬고 있다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「응, 괜찮아, 익숙해지고 있지?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「너무 움직이지 말아줘, 이것도 부끄럽단 말이야」
		ELSE
			PRINTFORMW 「남자들은 이런 걸 좋아하는 거야? 아기 같네」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「조금... 무겁잖아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좋은 경치? ……최악이야……」
		ELSE
			PRINTFORMW 「이걸로 만족할까?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
