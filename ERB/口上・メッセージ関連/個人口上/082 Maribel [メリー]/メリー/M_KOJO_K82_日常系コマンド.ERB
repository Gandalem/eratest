				PRINTFORMW 「선물은 기쁘지만, 나에게 어울릴까」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「어라? 사 줄 거야? 고마워.」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「후후, 조금 마음에 들었거든,」
			ELSE
				PRINTFORMW 「고마워, 소중히 할게」
			ENDIF
			PRINTFORMW 메리는 살짝 부끄러워하는 미소를 지었다.
			;700点以上（GOOD）
		CASE 3
			IF strReaction == "身につける" ;clothes
				IF RAND:2
					PRINTFORMW 「귀여운 옷이네. 고마워」
				ELSE
					PRINTFORMW 「옷? 이쪽에는 그냥 입고 왔으니까 기뻐. 고마워」
				ENDIF
			ELSEIF nPrice >= 30000
				IF RAND:2
					PRINTFORML 「고마워. 그럼 답례로……」
					PRINTFORMW 그렇게 말하며 메리는 %조사처리(CALLNAME:MASTER,"의")% 뺨에 입을 맞췄다
				ELSE
					PRINTFORMW 「ありがとう、大事にするわ」
					PRINTFORMW 「%CALLNAME:MASTER%って思ったよりこういう物を選ぶセンスがあるのね」
					PRINTFORMW “思ったより”ということは初めはそうは思われてなかったということか
				ENDIF
			ELSE
				IF RAND:4 == 0
					PRINTFORMW 「예쁜 거네. 정말 받아도 되는 거야?」
					PRINTFORMW 「고마워, 소중히 간직할게」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「제가 원하는 것을 아시다니 대단하시네요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「고마워, 소중히 간직할게……!」
				ELSE
					PRINTFORMW 「이걸 볼 때마다 %조사처리(CALLNAME:MASTER,"를")% 생각나겠네」
				ENDIF
				PRINTFORMW 메리는 뺨을 홍조지게 하며 기뻐하고 있다.
			ENDIF
	ENDSELECT
	;daily products (unused)
	; PRINTFORMW 「あ、それ今度買い足そうと思ってたの。ありがとう」
	; ELSE
	; PRINTFORMW 「ありがとう、大事に使わせてもらうわ」
	; ENDIF
	; IF A == 0
	; PRINTFORMW 「これ丁度切れそうだったのよ。ありがとう」
	; ELSE
	; PRINTFORMW 「こういう物はいくらあっても困らないものね」
	; ENDIF
ENDIF
RETURN 1
