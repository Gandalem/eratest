;custom code

@K82_DATE_TALK
LOCAL:9 = LINECOUNT
IF CHK_DATENOW(CFLAG:TARGET:デート中)
	SELECTCASE CFLAG:現在位置
		;博麗神社
		CASE 10 TO 90
			;例大祭
			IF DAY:2 == 1 && DAY:3 == 25
				IF TALENT:恋慕
					IF !RAND:3
						PRINTFORMW 「환상향에는 이렇게 많은 사람이 있었구나」
						PRINTFORMW 「떨어지지 않도록 손을 잡을까요」
					ELSEIF RAND:2
						;talking about booths that were set up during reitaisai
						PRINTFORMW 「이렇게 가게가 많으면 고르기도 힘들다니까.」
						IF !RAND:3 && IS_HERE([[ミスティア]])
							CALL CHARA_TEXT([[ミスティア]], "『거기 가시는 두 분. 미스티아 특제 팔눈장 조림은 어때?』")
							PRINTFORMW 「그럼 두 분 거 받아 갈게요」
						ELSEIF RAND:2 && IS_HERE([[妹紅]])
							CALL CHARA_TEXT([[妹紅]], "『아, 딱 좋은 때에 와줬네... 야키토리(닭꼬치)가 안 팔려서 고민이었어. 괜찮으면 사다 줄래?』")
							PRINTFORMW 「모처럼이니까 사 가도록 할까요」
						ELSEIF IS_HERE([[てゐ]])
							CALL CHARA_TEXT([[てゐ]], "『행운의 토끼가 친 모찌야~ 복이 가득하대~』")
							PRINTFORMW 「왠지 수상하지만, 일단 하나 사 보죠.」
						ENDIF
					ELSE
						PRINTFORMW 「축제도 그 자체로 즐겁지만, %조사처리(CALLNAME:MASTER,"와")% 함께라면 훨씬 더 즐거울 거야」
						PRINTFORMW 「내년에도 또 오자? 약속이야」
					ENDIF
				ELSE
					IF !RAND:3
						;instead of 非常事, go "in a place where incidents happen regularly" or something
						PRINTFORMW 「이런 비상사태인데, 잘 축제를 열겠다고 생각하는구나.」
					ELSEIF RAND:2
						PRINTFORMW 「축제랑 평일의 차이가 굉장하네.」
						PRINTFORMW 「그만큼 여기 사람들은 축제를 좋아하는 걸까.」
						PRINTFORMW 그냥 시끄럽게 놀고 싶은 사람들이 많은 것뿐이겠지.
					ELSE
						PRINTFORMW 「뭔가 재미있는 행사라도 있는 줄 알았는데」
						PRINTFORMW 「이쪽 축제는 바깥 것하고 별 차이가 없는 모양이네.」
						PRINTFORMW 대체 무엇을 기대했던 걸까
					ENDIF
				ENDIF
			ELSE
				IF TALENT:恋慕
					IF !RAND:3 && GET_TARGETNUM() < 2
						PRINTFORMW 「여전히 사람이 없네.」
						PRINTFORMW 「하지만 지금만큼은 감사해야 할지도 모르겠어.」
					ELSEIF RAND:2
						PRINTFORMW 「여기서 연회를 열게 될까」
					ELSE
						PRINTFORMW 「여기서 부적은 팔고 있는 걸까?」
						IF IS_HERE([[霊夢]])
							CALL CHARA_TEXT([[霊夢]], "『물론 있지. 내가 정성껏 만들었으니까 효험 만점이야.』")
							CALL CHARA_TEXT([[霊夢]], "『너희들에게는... 음』", "w")
							;has children
							IF EXP:出産経験 >= 1
								CALL CHARA_TEXT([[霊夢]], "『무병장수가 최고지』", "w")
								;no children, had creampie
							ELSEIF TALENT:恋人 && EXP:膣射経験 >= 20 && EXP:出産経験 == 0
								CALL CHARA_TEXT([[霊夢]], "『산모 건강 기원 같은 건 어때』", "w")
							ELSEIF TALENT:恋人
								CALL CHARA_TEXT([[霊夢]], "『연애 성공이 좋지 않아?』", "w")
							ELSE
								CALL CHARA_TEXT([[霊夢]], "『가내안전에 적합한 곳이네』", "w")
							ENDIF
							PRINTFORMW 「그럼 하나 받아볼까.」
						ENDIF
					ENDIF
				ELSE
					IF !RAND:3
						PRINTFORMW 「그건 그렇고, 여기 신님은 무슨 은혜를 주시는 걸까?」
