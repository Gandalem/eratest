@K82_DATEPLACE ;called at "date" (405) and "explore" (604, once per location)
PRINTFORML
PRINTFORML
SELECTCASE DATENAME_PLACE(1)
	;人里でデート
	CASE "人間の里"
		IF RAND:2 && TIME:5 <= 1
			PRINTFORMW 「오늘은 날씨가 좋아서 사람이 많네.」
		ELSE
			PRINTFORMW 「최근 맛있는 다과를 파는 가게가 생겼어. 잠깐 들러 볼래?」
		ENDIF
		;博麗神社でデート
	CASE "博麗神社"
		;例大祭の時
		IF DAY:2 == 1 && DAY:3 == 25
			PRINTFORMW 「굉장한 인원이야. 놓치지 않도록 손을 꼭 잡고 있어 줘.」
		ELSE
			IF RAND:2
				PRINTFORMW 「여전히 사람이 없네.」
				PRINTFORMW 「하지만 지금은 감사해도 될까.」
			ELSE
				PRINTFORMW 「이곳에서는 언제나 연회가 열리고 있는 거야?」
				PRINTFORMW 「시간이 있다면 함께 참여하자.」
			ENDIF
		ENDIF
		;霧の湖でデート
	CASE "霧の湖～紅魔館"
		;夏
		IF DAY:2 == 2
			IF RAND:2
				PRINTFORMW 「어때? 이전 수영복이 안 맞아서 새로 사봤는데」
			ELSE
				PRINTFORMW 「바람이 기분 좋네. 자, 가자.」
			ENDIF
		ELSE
			IF RAND:2
				PRINTFORMW 「여기가 언제 와도 깨끗한 곳이네.」
			ELSE
				PRINTFORMW 「이곳은 자주 요정들이 모이는 장소인가요? 오늘은 만날 수 있을까요.」
			ENDIF
		ENDIF
		;花畑でデート
	CASE "迷いの竹林"
		IF RAND:2
			PRINTFORMW 「언제 와도 이곳은 꽃이 피어 있네. 마치 시간이 멈춘 것 같아.」
		ELSE
			PRINTFORMW 「정말 아름답네... 역시 꽃은 들꽃이 최고야」
		ENDIF
		;白玉楼
	CASE "三途の川～冥界"
		IF RAND:2
			PRINTFORMW 「예쁜 저택이네. 누가 살고 있을까?」
		ELSE
			PRINTFORMW 「한 번이라도 이런 저택에 살아보고 싶어.」
			PRINTFORMW 「당신의 집도 꽤 넓지만 말이야.」
		ENDIF
ENDSELECT
