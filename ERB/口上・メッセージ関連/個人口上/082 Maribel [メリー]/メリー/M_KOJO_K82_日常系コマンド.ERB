;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K82_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K82_302
CALL M_KOJO_MESSAGE_COM_K82_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME("MerrySkinship") ;custom code
		PRINTFORMW 「에? 손을 잡아도 괜찮냐고?」
		PRINTFORMW 「딱히 상관은 없지만, 그런 식으로 허가를 구받으면 부끄럽잖아」
		;怒り
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「징그러우니까 만지지 말아 줄래?」
	ELSEIF TFLAG:193 == -1 ;custom code
		IF GET_TARGETNUM() > 1 ;custom code
			IF CFLAG:2 >= 1000
				PRINTFORML 「아, 잠깐만, 사람들이 보고 있잖아...」
				PRINTFORMW 옆에 있던 메리의 어깨를 안자, 메리는 부끄러운 듯했지만 저항은 하지 않았다.
			ELSE
				PRINTFORML 「앗, 죄송해요」
				PRINTFORMW 어깨가 살짝 스치자, 메리는 탄 것처럼 물러났다.
			ENDIF
		ELSE
			IF CFLAG:2 >= 1000
				PRINTFORMW 「거, 거기는 만지면 안 돼!」
			ELSE
				PRINTFORMW 「친한 사이에도 예의는 있는 법이지...」
			ENDIF
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF TALENT:恋慕 && FIRSTTIME("MerryBathSkinship") ;custom code
			PRINTFORML 「여기 앉아봐. 등이 시원하게 해줄게…… 다시 보니 네 등이 크네.」
			PRINTFORMW 메리의 가느다란 손가락이 등을 더듬는다. 갑자기 옆에서 메리의 얼굴이 나왔다
			PRINTFORML 「있잖아, 지금 등에 뭐라고 적혀 있을 것 같아?」
			PRINTFORMW 등 위에 눌려오는 가슴의 감촉에 정신이 팔릴 수가 없었다
			RETURN 1
		ENDIF
		IF RAND:3 == 0
			PRINTFORMW 「후후, 자, 가려운 곳은 없어?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「벌써 벌거벗은 사이라니 부끄럽네~」
		ELSE
			PRINTFORMW 「저의 몸도 씻어 주실 수 있나요?」
		ENDIF
	ELSEIF TFLAG:193 == 1 ;custom code
		PRINTFORML 「으윽... 다리가 좀 저려버렸어... 헉!? 그만, 만지지 마... 아앗!」
		PRINTFORMW 반응이 귀여워서 나도 모르게 만져버렸다. 이건 메리의 잘못이다. 응, 분명 그래
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응, 더 %조사처리(CALLNAME:MASTER,"를")% 느끼게 해줘 ♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「안 돼, 간지러워서 곤란해♪」
		ELSE
			PRINTFORMW 「어디 만지는 거야... 벌써, 치사하잖아♪」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「사람들 앞에서 너무 하지 마, 부끄럽잖아」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응, 거기 기분 좋아……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「렌코에게 들키면 귀찮아, 너무 격렬한 건……」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「뭐야, 렌코 같네」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「너무 많이 붙어오면 좋아하게 되어 버릴 거야」
		ELSE
			PRINTFORMW 「이제, 다음엔 뭘 해줬으면 하는 거야?」
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「긴장되네, 남자랑 이런 걸 하는 건」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이걸로 괜찮아?」
		ELSE
			PRINTFORMW 「뭐, 줄어들지는 않지만……」
		ENDIF
	ELSE
		IF GET_TARGETNUM() == 1 && !RAND:3 ;custom code
			PRINTFORML 「사람 없다고 이상한 짓 하지 마?」
			PRINTFORMW 메리는 농담처럼 말했지만, 눈은 웃고 있지 않았다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「떨어져줬으면 좋겠어」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「우리가 그렇게 친한 사이였을까?」
		ELSE
			PRINTFORMW 「......뭐야?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
