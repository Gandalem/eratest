;==================================================
;626,土産物屋
;TFLAG:194(-2=ひやかし -1=見送り 1=BAD 2=NOMAL 3=GOOD)
;==================================================
@M_KOJO_MESSAGE_COM_K82_626
CALL M_KOJO_MESSAGE_COM_K82_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF !GROUPMATCH(TFLAG:194, -2, -1) && FIRSTTIME("MerryPresentGiven")
		PRINTFORMW 「プレゼント？　いいわよ、付き合うもらってるだけで有難いのに」
		PRINTFORMW 「……でも、折角用意してくれたのに受け取らないのは失礼よね。ありがとう、大事にするわ」
		RETURN 1
	ENDIF
	
	IF TFLAG:194 > 0
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 身につける
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
	ENDIF
	
	SELECTCASE TFLAG:194
	;ひやかし
	CASE -2
		;(GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
		IF RAND:3 == 0
			PRINTFORMW 「怒られてしまったわ、ひやかすからね」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「長居しすぎたようね、客の立場をわきまえないと」
		ELSE
			PRINTFORMW 「ほら、怒られちゃった」
		ENDIF
	;やっぱりやめる（見送り）
	CASE -1
		IF RAND:3 == 0
			PRINTFORMW 「見ているだけでも楽しいわね」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「ウィンドウショッピングだなんてお店に悪いわよ」
		ELSE
			PRINTFORMW 「面白い物は見つけられた？」
		ENDIF
	;400点未満（BAD）
	CASE 1
		IF RAND:3 == 0
			PRINTFORMW 「そ、そう……ありがとうね……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「女の子にあげる物じゃ無いわよ……」
		ELSE
			PRINTFORMW 「何だか気味悪いわ……」
		ENDIF
		PRINTFORMW メリーはあまり嬉しくなさそうだ……
	;400点～699点（NOMAL）
	CASE 2
		IF RAND:4 == 0
			PRINTFORMW 「プレゼントは嬉しいけど、私に似合うかしら」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「あら？買ってくれるの？ありがとうね」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「ふふ、少し気に入ってたのよ、これ」
		ELSE
			PRINTFORMW 「ありがとう、大切にするわ」
		ENDIF
		PRINTFORMW メリーは少しはにかんだ笑顔を浮かべた。
	;700点以上（GOOD）
	CASE 3
		IF strReaction == "身につける" ;clothes
			IF RAND:2
				PRINTFORMW 「可愛らしい服ね。ありがとう」
			ELSE
				PRINTFORMW 「服？　こっちには着の身着ままで来たから嬉しいわ。ありがとう」
			ENDIF
		ELSEIF nPrice >= 30000
			IF RAND:2
				PRINTFORML 「ありがとう。それじゃお返しに……」
				PRINTFORMW そう言ってメリーは%CALLNAME:MASTER%の頬に口付けをした
			ELSE
				PRINTFORMW 「ありがとう、大事にするわ」
				PRINTFORMW 「%CALLNAME:MASTER%って思ったよりこういう物を選ぶセンスがあるのね」
				PRINTFORMW “思ったより”ということは初めはそうは思われてなかったということか
			ENDIF
		ELSE
			IF RAND:4 == 0
				PRINTFORMW 「綺麗なものね。本当に貰っていいの？」
				PRINTFORMW 「ありがとう、大事にするわ」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「私の欲しいものが分かるなんて流石ね」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「ありがとう、大切にするから……！」
			ELSE
				PRINTFORMW 「これを見るたび%CALLNAME:MASTER%のことを思い出しそうね」
			ENDIF
			PRINTFORMW メリーは頬を紅潮させて嬉しそうにしている。
		ENDIF
	ENDSELECT
	
	;daily products (unused)
	; PRINTFORMW 「あ、それ今度買い足そうと思ってたの。ありがとう」
	; ELSE
		; PRINTFORMW 「ありがとう、大事に使わせてもらうわ」
	; ENDIF
	
	; IF A == 0
		; PRINTFORMW 「これ丁度切れそうだったのよ。ありがとう」
	; ELSE
		; PRINTFORMW 「こういう物はいくらあっても困らないものね」
	; ENDIF
ENDIF
RETURN 1
