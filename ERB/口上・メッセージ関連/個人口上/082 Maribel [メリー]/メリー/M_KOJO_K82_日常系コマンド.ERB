;custom code
@K82_DATE_TALK
LOCAL:9 = LINECOUNT

IF CHK_DATENOW(CFLAG:TARGET:デート中)
	SELECTCASE CFLAG:現在位置
		;博麗神社
		CASE 10 TO 90
			;例大祭
			IF DAY:2 == 1 && DAY:3 == 25
				IF TALENT:恋慕
					IF !RAND:3
						PRINTFORMW 「幻想郷ってこんなに人がいたのね」
						PRINTFORMW 「離れないように手繋ぎましょうか」
					ELSEIF RAND:2
						;talking about booths that were set up during reitaisai
						PRINTFORMW 「こう出店が多いと選ぶのも大変ね」
						IF !RAND:3 && IS_HERE([[ミスティア]])
							CALL CHARA_TEXT([[ミスティア]], "『そこ行くお二人さん。ミスティア特製八目鰻の蒲焼はいかが？』")
							PRINTFORMW 「それじゃ二人分貰っていきましょうか」
						ELSEIF RAND:2 && IS_HERE([[妹紅]])
							CALL CHARA_TEXT([[妹紅]], "『あぁいいところに……焼き鳥が売れなくて困ってるの。よければ買っていってよ』")
							PRINTFORMW 「折角だから買って行きましょうか」
						ELSEIF IS_HERE([[てゐ]])
							CALL CHARA_TEXT([[てゐ]], "『幸運の兎が搗いたお餅だよーご利益満点だよー』")
							PRINTFORMW 「なんだか怪しいけど、とりあえず一つ買ってみましょうか」
						ENDIF
					ELSE
						PRINTFORMW 「お祭りはただでも楽しいけど、%CALLNAME:MASTER%と一緒だともっと楽しいわ」
						PRINTFORMW 「来年もまた来ましょうね？　約束よ」
					ENDIF
				ELSE
					IF !RAND:3
						;instead of 非常事, go "in a place where incidents happen regularly" or something
						PRINTFORMW 「こんな非常事態なのに、よくお祭りなんてやる気になるわね」
					ELSEIF RAND:2
						PRINTFORMW 「お祭りと平日の落差が凄いわね」
						PRINTFORMW 「それだけここの人達はお祭り好きってことなのかしら」
						PRINTFORMW ただ騒ぎたい連中が多いだけだろう
					ELSE
						PRINTFORMW 「何か面白い催し物でもあるかと思ったけど」
						PRINTFORMW 「こっちのお祭りは外の物とあまり変わらないみたいね」
						PRINTFORMW 一体何を期待していたのか
					ENDIF
				ENDIF
			ELSE
				IF TALENT:恋慕
					IF !RAND:3 && GET_TARGETNUM() < 2
						PRINTFORMW 「相変わらず人がいないわね」
						PRINTFORMW 「でも今だけは感謝するべきかしら」
					ELSEIF RAND:2
						PRINTFORMW 「ここで宴会でも開かれるのだろうか」
					ELSE
						PRINTFORMW 「ここってお守りは売ってるのかしら？」
						IF IS_HERE([[霊夢]])
							CALL CHARA_TEXT([[霊夢]], "『もちろんあるわ。私が丹精込めて作ったからご利益満点よ』")
							CALL CHARA_TEXT([[霊夢]], "『あんたたちには……そうね』", "w")
							;has children
							IF EXP:出産経験 >= 1
								CALL CHARA_TEXT([[霊夢]], "『無病息災が一番ね』", "w")
							;no children, had creampie
							ELSEIF TALENT:恋人 && EXP:膣射経験 >= 20 && EXP:出産経験 == 0
								CALL CHARA_TEXT([[霊夢]], "『安産祈願なんてどうかしら』", "w")
							ELSEIF TALENT:恋人
								CALL CHARA_TEXT([[霊夢]], "『恋愛成就がいいんじゃない？』", "w")
							ELSE
								CALL CHARA_TEXT([[霊夢]], "『家内安全が妥当なところね』", "w")
							ENDIF
							PRINTFORMW 「それじゃ一つもらおうかしら」
						ENDIF
					ENDIF
				ELSE
					IF !RAND:3
						PRINTFORMW 「そういえば、ここの神様は何のご利益があるのかしら？」
					ELSEIF RAND:2 && GET_TARGETNUM() < 2
						PRINTFORMW 「神社って静かで寂しいイメージがあるわよね」
						PRINTFORMW 「でも、ここは確かに人もいないし静かだけど、不思議と寂しい雰囲気は感じられないわ」
					ELSE
						PRINTFORMW 「ここって博麗の巫女が一人で暮らしてるんでしょう？」
						PRINTFORMW 「空き巣とかに入られたら大変じゃないかしら」
						PRINTFORMW きっと空き巣が大変なことになるだろう
					ENDIF
				ENDIF
			ENDIF
		;命蓮寺、神霊廟
		CASE お地蔵通り,枝垂れ柳の下,命蓮寺境内,命蓮寺方丈,神霊廟広場,神霊廟道場
			;og dialogue lines
			IF RAND:5 == 0
				PRINTFORMW 「なんて罰当たりなのかしら……こっちの話よ」
			ELSEIF RAND:4 == 0
				PRINTFORMW 「ここでも桜が見えるといいんだけどね」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「変なものが見えちゃいそう、気味悪いわ」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「あまり長居するとこじゃないわ、行きましょう」
			ELSE
				PRINTFORMW 「このお寺、キマイラがいるんだっけ？」
			ENDIF
		;人里
		CASE 広場,商家町,呑屋小道,寺子屋,大衆浴場,長屋街,連れ込み宿
			IF TALENT:恋慕
				$RETRY
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ここはいつも賑やかでいいわね」
						PRINTFORMW 「慣れない世界に取り残されたことなんて忘れちゃいそう……」
					CASE 1
						PRINTFORMW 「周りの目からは私達はどう映ってるのかしら？」
						;相愛 marriage
						;IF TALENT:89 == 1
						;	PRINTFORML 「まぁ他人にどう見られても、私達の関係は変わらないでしょうけどね」
						;	PRINTFORMW そう言ってメリーは左手の薬指に嵌められた指輪を優しく撫でた
						IF TALENT:恋人
							PRINTFORMW 「ちゃんと恋人に見えてるといいんだけど」
						ELSE
							PRINTFORMW 「あわよくば貴方の恋人に見られてたらな、って」
						ENDIF
					CASE 2
						SIF CFLAG:現在位置 != 商家町
							GOTO RETRY
						IF ABL:料理技能 >= 3
							PRINTFORML 八百屋の前を通りかかると店主に呼び止められた
							PRINTFORMW 『やぁ奥さん、良い野菜が入ったんだけどどうだい？』
							;marriage
							;IF TALENT:89 == 1
							;	PRINTFORML 「あら、それなら少し見てみようかしら」
							;	PRINTFORMW その後30分ほどやれ美人だのやれ立派な旦那だのと二人の会話は続いた
							;ELSE
								PRINTFORML 「奥さんだなんて、まだそういうのじゃ……」
								PRINTFORMW 結局、店主の親父に見事に捕まり小一時間商談が続いた
							;ENDIF
						ELSE
							PRINTFORMW 「ついでにご飯の材料でも買いに行きましょうよ」
							PRINTFORMW 「今日は何食べたい？　私も頑張って練習するから何でも言ってね」
						ENDIF
				ENDSELECT
			ELSE
				IF !RAND:3
					PRINTFORMW 「ねえ、あそこで少し休んでいかない？」
				ELSEIF RAND:2
					PRINTFORMW 「コンクリートが一切無い風景というのは良いわね」
