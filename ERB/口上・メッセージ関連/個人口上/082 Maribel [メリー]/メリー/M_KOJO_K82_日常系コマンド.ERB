IF LOCAL
	IF FIRSTTIME("MerryCook")
		PRINTFORMW 「요리 보조? 알겠어. 일단 보통 수준으로는 할 수 있으니까 맡겨」
	ELSE
		;custom code
		IF TALENT:恋慕
			;いわゆる上級者コース
			IF ABL:料理技能 >= 4
				IF IS_HERE([[蓮子]])
					IF TALENT:[[蓮子]]:恋慕
						IF ABL:[[蓮子]]:料理技能 >= 4
							PRINTFORML 「렌코, 저기 소금 좀 가져와」
							CALL CHARA_TEXT([[蓮子]], "『응... 메리, 간은 이 정도면 괜찮아?』")
							PRINTFORML 「응, 곧 만들 수 있으니까 기다려줘」
							CALL CHARA_TEXT([[蓮子]], "『눈에 즐거움을 보여줄 테니까 기대해라.』", "w")
						ELSEIF ABL:[[蓮子]]:料理技能 >= 2
							CALL CHARA_TEXT([[蓮子]], "『메리, 맛을 봐줘』")
							PRINTFORML 「……음, 훌륭해. 이걸로 %CALLNAME:MASTER%도 맛있다고 말해줄 거야」
							CALL CHARA_TEXT([[蓮子]], @"『정말!? 후후, %조사처리(CALLNAME:MASTER,"의")% 놀라는 얼굴이 기대돼!』")
							PRINTFORMW 전부 다 들키고 있지만, 뭐 조용히 있을게
						ELSE
							CALL CHARA_TEXT([[蓮子]], @"『%조사처리(CALLNAME:MASTER,"를")% 위해서라고 생각했지만… 이건 만만치 않네』")
							PRINTFORML 「그 사람에 대한 마음이 제대로 담겨 있다면 저절로 맛있어지는 법이야.」
							CALL CHARA_TEXT([[蓮子]], "『'그렇구나, 그래서 메리의 요리는 맛있는 거네'』")
							PRINTFORMW 「그렇네... 자, 냄비가 끓고 있잖아」
						ENDIF
					ELSE
						IF ABL:[[蓮子]]:90 >= 4
							PRINTFORML 「렌코도 꽤 실력이 늘었네」
							CALL CHARA_TEXT([[蓮子]], "『응, 나 자신도 잘 하게 됐다고 실감하고 있어.』")
							PRINTFORMW 「이걸로 언제 신부로 가도 걱정 없겠네」
						ELSEIF ABL:[[蓮子]]:90 >= 2
							CALL CHARA_TEXT([[蓮子]], "『이 정도 간이 더 좋은 걸까?』")
							PRINTFORML 「조금 너무 진하지 않아? 맛도 중요하지만 영양면도 생각해야 해.」
							CALL CHARA_TEXT([[蓮子]], "『요리 하나 하는 것도 힘들구나……』", "w")
						ELSE
							PRINTFORML 「렌코, 칼 잡는 법은 이래. 그럼 손가락을 베게 될 거야.」
							CALL CHARA_TEXT([[蓮子]], "『うぅ……私って料理の才能無いのかなぁ』")
							PRINTFORMW 「렌코도 태어나자마자 말을 할 수 있었던 건 아닐 테지? 연습하면 뭐든지 될 수 있는 거야.」
						ENDIF
					ENDIF
				ELSEIF !RAND:3
					PRINTFORMW 「이렇게 나란히 서 있으니 부부 같네……」
					PRINTFORMW 「나는 '가족 놀이'라도 괜찮아. 당신의 아내가 될 테니까, 응.」
				ELSEIF RAND:2
					PRINTFORML 부엌에 칼 소리가 리드미컬하게 울렸다.
					PRINTFORMW 「채소는 썰었고, 조미료도 괜찮아. 냄비는 어때?」
					PRINTFORML 메리가 거의 혼자 요리를 하고 있었다.
					PRINTFORMW 아무래도 자신의 차례는 없는 것 같았다.
				ELSE
					;仲間が5人以上
					IF GET_TARGETNUM() >= 5
						PRINTFORMW 「사람이 이렇게 많으면 요리하는 것도 힘들겠네」
						PRINTFORMW 「누군가 도와주면 좋을 텐데」
					ELSE
						PRINTFORMW 「오늘의 메뉴는 뭘로 할까」
						PRINTFORMW 「혹시 원하는 거 있어? 뭐든지 만들어 줄게」
					ENDIF
				ENDIF
				;中級者コース
			ELSEIF ABL:料理技能 >= 2
				IF !RAND:3
					PRINTFORMW 「어때? 책에 있던 요리를 나름대로 응용해 봤는데」
				ELSEIF RAND:2
					PRINTFORMW 「음... 응, 다시도 제대로 우러나고 있어. 미소시루는 OK네」
					PRINTFORMW 「다음은 고기... 벌써 잘라 놓았어? 고마워」
				ELSE
					PRINTFORMW 「이 부엌에도 꽤 익숙해졌어.」
					PRINTFORMW 「이제 요리 실력만 남았네.」
				ENDIF
				;初心者コース
			ELSE
				IF !RAND:3
					PRINTFORMW 「똑똑, 그쪽은 상황이 어때?」
				ELSEIF RAND:2
					PRINTFORMW 「지금까지와는 방식이 다르니까 익숙해질 때까지 고생할 것 같아.」
					;お勝手だけに勝手が違うのです
				ELSE
					PRINTFORMW 「요리는 보통 수준으로 할 수 있지만, 너무 기대는 하지 말아줘?」
				ENDIF
			ENDIF
		ELSE
			IF ABL:料理技能 >= 2
				PRINTFORMW 「요즘 요리가 너무 즐거워서 어쩔 수가 없어. 뭐 만들까?」
			ELSE
				PRINTFORMW 「오늘 저녁은 뭘로 할까요? 너무 어려운 거 아니면 만들게요」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
