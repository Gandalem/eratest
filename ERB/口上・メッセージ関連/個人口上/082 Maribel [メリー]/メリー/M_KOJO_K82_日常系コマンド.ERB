							CALL CHARA_TEXT([[蓮子]], "『目に物見せてあげるから、期待してなさい』", "w")
						ELSEIF ABL:[[蓮子]]:料理技能 >= 2
							CALL CHARA_TEXT([[蓮子]], "『メリー、味を見てちょうだい』")
							PRINTFORML 「……うん、上出来よ。これなら%CALLNAME:MASTER%も美味しいって言ってくれるわ」
							CALL CHARA_TEXT([[蓮子]], @"『本当！？　うふふ、%CALLNAME:MASTER%の驚く顔が楽しみだわ！』")
							PRINTFORMW 全部筒抜けなのだが、まぁ黙っておこう
						ELSE
							CALL CHARA_TEXT([[蓮子]], @"『%CALLNAME:MASTER%のために、って思ったけど…これは中々大変ね』")
							PRINTFORML 「その人への気持ちがしっかり入っていれば自ずと美味しくなるものよ」
							CALL CHARA_TEXT([[蓮子]], "『なるほど、だからメリーの料理は美味しいのね』")
							PRINTFORMW 「そうね…ほら、お鍋沸いてるわよ」
						ENDIF
					ELSE
						IF ABL:[[蓮子]]:90 >= 4
							PRINTFORML 「蓮子も大分上達してきたわね」
							CALL CHARA_TEXT([[蓮子]], "『うん、自分でも上手になったと実感してるわ』")
							PRINTFORMW 「これでいつお嫁に行っても心配無いわね」
						ELSEIF ABL:[[蓮子]]:90 >= 2
							CALL CHARA_TEXT([[蓮子]], "『これくらいの味付けの方がいいのかな？』")
							PRINTFORML 「少し濃過ぎない？　味も大事だけど栄養面も考えないとダメよ」
							CALL CHARA_TEXT([[蓮子]], "『料理一つ取っても大変なのね……』", "w")
						ELSE
							PRINTFORML 「蓮子、包丁の持ち方はこう。それじゃ指を切ってしまうわ」
							CALL CHARA_TEXT([[蓮子]], "『うぅ……私って料理の才能無いのかなぁ』")
							PRINTFORMW 「蓮子だって産まれてすぐ言葉が使えたわけじゃないでしょう？練習すれば何とでもなるものよ」
						ENDIF
					ENDIF
				ELSEIF !RAND:3
					PRINTFORMW 「こうやって並んでると夫婦みたい……」
					PRINTFORMW 「私は“ごっこ”でも構わないわ。貴方のお嫁さんなら、ね」
				ELSEIF RAND:2
					PRINTFORML 台所に包丁の音がリズミカルに響く
					PRINTFORMW 「野菜は切ったし、調味料もオッケーね。お鍋はどうかしら？」
					PRINTFORML メリーがほとんど一人で調理をしている
					PRINTFORMW どうやら自分の出番は無いらしい
				ELSE
					;仲間が5人以上
					IF GET_TARGETNUM() >= 5
						PRINTFORMW 「これだけ人が多いとご飯を作るのも大変ね」
						PRINTFORMW 「誰か手伝ってくれるといいんだけど」
					ELSE
						PRINTFORMW 「今日の献立は何にしようかしら」
						PRINTFORMW 「何かリクエストはある？　何でも作ってあげるわよ」
					ENDIF
				ENDIF
			;中級者コース
			ELSEIF ABL:料理技能 >= 2
				IF !RAND:3
					PRINTFORMW 「どう？　本にあった料理を私なりにアレンジしてみたんだけど」
				ELSEIF RAND:2
					PRINTFORMW 「んー…うん、出汁もちゃんと取れてるわ。お味噌汁はOKね」
					PRINTFORMW 「次はお肉…もう切ってあるの？　ありがとう」
				ELSE
					PRINTFORMW 「この台所にも大分慣れてきたわ」
					PRINTFORMW 「あとは料理の腕だけね」
				ENDIF
			;初心者コース
			ELSE
				IF !RAND:3
					PRINTFORMW 「トントントン……と、そっちの具合はどう？」
				ELSEIF RAND:2
					PRINTFORMW 「今までとは勝手が違うから慣れるまでは苦労しそうだわ」
					;お勝手だけに勝手が違うのです
				ELSE
					PRINTFORMW 「料理は人並みには出来るけど、あんまり期待しないでね？」
				ENDIF
			ENDIF
		ELSE
			IF ABL:料理技能 >= 2
				PRINTFORMW 「最近料理が楽しくてしょうがないの。何か作りましょうか？」
			ELSE
				PRINTFORMW 「今日のご飯は何にしましょうか？　あまり難しい物じゃなければ作るわよ」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
