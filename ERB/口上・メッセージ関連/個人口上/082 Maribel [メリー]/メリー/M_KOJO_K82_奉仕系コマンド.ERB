;82,パイズリ
;==================================================

@M_KOJO_MESSAGE_COM_K82_82
CALL M_KOJO_MESSAGE_COM_K82_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「가슴으로 감싸 안아 달라고? 뭐, 불가능하지는 않을 거라고 생각해…」
			PRINTFORMW 「내 가슴, 쓸데없이 크니까…… 하지만 %조사처리(CALLNAME:MASTER,"에게")% 이렇게 봉사할 수 있다면, 커도 좋았을지도 모른다고 생각해서」
			PRINTFORMW 메리는 탐스럽게 익은 자신의 가슴을 들어 %조사처리(CALLNAME:MASTER,"의")% 페니스와 비교했다
			PRINTFORMW 「자, 어때… 응? 기분 좋아?」
			PRINTFORMW 「가슴 속이 뜨거워… 게다가 당신 것이 맥동하는 게 느껴져」
			PRINTFORMW 「그럼 움직여 볼게…」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「아아, 언젠가 들을 거라고 생각했어」
			PRINTFORMW 「남자들은 어째서 이렇게 가슴에만 흥미를 갖는 걸까」
			PRINTFORMW 「가슴 같은 건 아기에게 수유할 수 있으면 충분한데…」
		ELSE
			PRINTFORMW 「가슴으로 할까? 그런 걸 가슴으로 감싼다는 건...」
			PRINTFORMW (이런 가슴 큰 게 방해만 된다고 생각하는 거야...)
			PRINTFORMW (남자에게도 여자에게도 이상한 눈으로 보이고, 이런 이상한 요구를 받게 되고...)
			PRINTFORMW 「……하아, 하면 되는 거잖아, 하니까...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;胸3以上
	ELSEIF ABL:胸 > 2
		IF RAND:4 == 0
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「응, 앞쪽도 맛봐 줄게... 핥아, 쪽...」
				CASE 1
					PRINTFORMW 「음, 어때? 이런 느낌으로 괜찮아?」
					PRINTFORMW 「아, 떨고 있네……」
				CASE 2
					PRINTFORMW 「음, 음음... 이거, 내 가슴도 스치네... 기분 좋아...」
				CASE 3
					PRINTFORMW 「그렇게 내 가슴이 좋은 거야? 후후, 그렇다면 얼마든지 해줄게」
				CASE 4
					PRINTFORMW 「후후, 가슴 사이에 끼워둔 것만으로 이렇게 되다니... 귀엽네」
			ENDSELECT
		ELSEIF RAND:3 == 0
			PRINTFORMW 「자, 남자들은 이런 거 좋아하는 거야」라며 %UNICODE(0x2665) *1%
		ELSEIF RAND:2 == 0
			PRINTFORMW 「더 기분 좋게 해줄게 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 자앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「빨리 사정해앳%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:4 == 0
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「이런 느낌으로 괜찮아? ……그래, 그럼 계속할게.」
					PRINTFORMW 「나도, 뭔가 이상한 기분에……」
				CASE 1
					PRINTFORMW 「그럼 끼울게... 응, 뜨거워...」
				CASE 2
					PRINTFORMW 「어때? 기분 좋아? 라는 그 얼굴을 보면 물어볼 필요도 없겠지」
				CASE 3
					PRINTFORMW 「하아... 피곤하다.」
			ENDSELECT
		ELSEIF RAND:3 == 0
			PRINTFORMW 「렌코에게는 할 수 없겠지」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「어때? 크기는 자신 있는데」
		ELSE
			PRINTFORMW 「어때? 내 가슴 기분 좋아?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
