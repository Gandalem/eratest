	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「んんっ%UNICODE(0x2665) *1%んっ%UNICODE(0x2665) *1%ん～%UNICODE(0x2665) *1%」
		PRINTFORMW メリーは勢いよく陰茎にむしゃぶりついている。
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「ん%UNICODE(0x2665) *1%ちゅぅ%UNICODE(0x2665) *1%んんっ%UNICODE(0x2665) *1%」
			PRINTFORMW メリーは%CALLNAME:MASTER%の射精を感じ取ると喉で巧みにそれを促している。
		ELSEIF RAND:2 == 0
			PRINTFORMW 「ん%UNICODE(0x2665) *1%んんっ%UNICODE(0x2665) *1%んんんっ%UNICODE(0x2665) *1%」
			PRINTFORMW メリーは%CALLNAME:MASTER%の射精を感じ取ると喉で巧みにそれを促している。
		ELSE
			PRINTFORMW 「んちゅっ%UNICODE(0x2665) *1%ん～%UNICODE(0x2665) *1%ん～～～%UNICODE(0x2665) *1%」
			PRINTFORMW メリーは%CALLNAME:MASTER%の射精を感じ取ると喉で巧みにそれを促している。
		ENDIF
	;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「んっんっん～」
			PRINTFORMW メリーは%CALLNAME:MASTER%の陰茎にむしゃぶりついている。
		ELSEIF RAND:2 == 0
			PRINTFORMW 「んん……れろっ……」
			PRINTFORMW メリーは%CALLNAME:MASTER%の陰茎にむしゃぶりついている。
		ELSE
			PRINTFORMW 「んっ……んっ……んっ……」
			PRINTFORMW メリーは%CALLNAME:MASTER%の陰茎にむしゃぶりついている。
		ENDIF
	ENDIF
ENDIF
RETURN 1
