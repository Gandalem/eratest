;==================================================
@M_KOJO_MESSAGE_COM_K82_80
CALL M_KOJO_MESSAGE_COM_K82_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「手ですればいいの？ わかったわ、%CALLNAME:MASTER%」
			PRINTFORMW 「うふっ、シコシコしてあげるわ%UNICODE(0x2665) *1%」
			PRINTFORMW 「……いつでも出していいからね」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「えっ、手で？ それでいいのなら……」
			PRINTFORMW 「言ってくれれば何でもやるわよ」
		ELSE
			PRINTFORMW 「手で擦るの？まぁ、それくらいなら…」
			PRINTFORMW 「別に構わないけど、痛くないの？」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:4 == 0
			PRINTFORMW 「ん、んしょ…こんな感じでどう？」
			PRINTFORMW 「あっ、今ぴくってした…気持ち良いのね？　もっとしてあげるから、もっと気持ち良くなってね」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「ふふっ、びくびくしてて可愛いわね%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「情けない顔してないで、いっぱい射精していいのよ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「んー臭いカウパー溢れてきたわね%UNICODE(0x2665) *1%」
		ENDIF
	;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:4 == 0
			PRINTFORMW 「こんな感じでいいのかしら？」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「ふふっ、どうかしら%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「早く射精するとこ見せて%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「ほら、射精してもいいのよ%UNICODE(0x2665) *1%」
		ENDIF
	;それ以外
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「ん…自分ですればいいのに……」
			PRINTFORMW 「手で擦るだけでいいの？　まぁ、そう言うならいくらでもやってあげるけど」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「相変わらず…なんというか、グロテスクね」
			PRINTFORMW 「これって意外と手が疲れるわね…」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「あら？手でシコシコして欲しいのね%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「んー、ほら、くさーい精液早く出して%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「こうしていると男の人って単純ね、こっちで物考えてるのかしら？」
		ENDIF
	ENDIF
ENDIF
RETURN 1

