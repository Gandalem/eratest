			ELSE
				PRINTFORMW 「んんっ%UNICODE(0x2665) *1%早く頂戴%UNICODE(0x2665) *1%」
				PRINTFORMW メリーは%CALLNAME:MASTER%の射精を感じ取ると舌使いで巧みにそれを促している。
			ENDIF
		ENDIF
	;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「ん……%UNICODE(0x2665) *1%じゅるっ%UNICODE(0x2665) *1%」
