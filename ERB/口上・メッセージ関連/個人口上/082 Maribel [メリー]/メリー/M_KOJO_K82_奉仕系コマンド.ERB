;==================================================

@M_KOJO_MESSAGE_COM_K82_81
CALL M_KOJO_MESSAGE_COM_K82_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「이걸, 입에 넣는 건가…」
			PRINTFORMW 메리는 눈앞에 내밀어진 그것을 응시했다.
			PRINTFORMW 「이렇게 큰 게 들어갈 수 있을까… 하무, 응그…」
			PRINTFORMW 미지의 맛과 감촉에 메리의 얼굴이 일그러졌다.
			PRINTFORMW 그럼에도 %조사처리(CALLNAME:MASTER,"의")% 것을 놓지 않으려고 아래를 휘감고 왔다.
			PRINTFORMW 「응…… 쪽%UNICODE(0x2665) *1% 이런 느낌?」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「엣, 입으로? 알았어…… 뭔가 굉장한 냄새가 나지만……」
		ELSE
			PRINTFORMW 「입으로 하라니...」
			PRINTFORMW 「흐윽... 별로 잘 못할 것 같은데...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「음~ %UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 부추고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「츄릅%UNICODE(0x2665) *1% 쪽%UNICODE(0x2665) *1% 으으읏%UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 능숙하게 움직여 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「응읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%푸핫%UNICODE(0x2665) *1%」
				PRINTFORMW 메리는%조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 교묘하게 움직여 그것을 재촉하고 있다.
				PRINTFORMW 「정말, 빨리 마시게 해줘……%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:5 == 0
				PRINTFORMW 「그렇게 내 입이 좋은 거야? ……응, 괜찮다면 더 해줄게……」
			ELSEIF RAND:4 == 0
				PRINTFORML 「음, 츄... 쭈르, 주루루...」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 페니스에게 무심하게 봉사하고 있었다.
			ELSEIF RAND:3 == 0
				PRINTFORMW 「음~」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW (이렇게 빨고 있으면 행복해... %UNICODE(0x2665) *1%)
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 빨리 사정해라」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙하게 혀를 사용해 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「んん읏%UNICODE(0x2665) *1%빨리 받게 해줘%UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀 사용으로 능숙하게 그것을 재촉하고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응……%UNICODE(0x2665) *1%츄릅%UNICODE(0x2665) *1%」
				PRINTFORMW 「이거 정말 좋아……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「으응읏%UNICODE(0x2665) *1% 츄릅%UNICODE(0x2665) *1% 쪽%UNICODE(0x2665) *1%」
				PRINTFORMW 「……정액 줘읏%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「으응읏%UNICODE(0x2665) *1%츄릅%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응~ 벌써 내줘」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응... 중독될 것 같은 맛이네%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응응... 쪽 %UNICODE(0x2665) *1%」
			ENDIF
			IF !RAND:3
				PRINTFORMW 「푸아, 어때? 기분 좋아?」
			ELSEIF RAND:2
				PRINTFORMW 「이런 식으로 괜찮아? 그래……」
			ELSE
				PRINTFORMW 「응, 음... 하아, 이대로 괜찮을까?」
				PRINTFORMW 「...그래, 그럼 계속할게.」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		LOCAL = RAND:5
		IF LOCAL == 0
			PRINTFORMW 「뭐, 또 입으로 하는 거야? 그 감각에는 아직 익숙해지지 않아...」
		ELSEIF LOCAL == 1
			PRINTFORMW 「입으로 하는 거구나? 나도 열심히 할 테니, 기분 좋아져 줘」
		ELSEIF LOCAL == 2
			PRINTFORMW 「아직 미숙할지도 모르겠지만, %조사처리(CALLNAME:MASTER,"가")% 기분이라면 더 해줄게...」
		ENDIF
		IF RAND:3 == 0
			PRINTFORMW 「응…… 츄웁……%UNICODE(0x2665) *1%쪽%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……응… 쪽%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……쪽……핥……」
		ENDIF
		IF LOCAL == 3
			PRINTFORML 「그, 죄송해요, 아직 익숙하지 않아서...」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 페니스를 물고 있던 메리는 미안한 듯 말했다.
		ELSEIF LOCAL == 4
			PRINTFORMW 「응, 음윽, 콜록」
			PRINTFORMW (끔찍한 냄새... 기분 나빠...)
		ENDIF
	ENDIF
ENDIF
RETURN 1
