			PRINTFORMW 「胸の中が熱い…それに貴方のが脈打ってるのが分かるわ」
			PRINTFORMW 「それじゃ動かすわね…」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「あぁ、いつか言われると思ってたわ」
			PRINTFORMW 「男の人ってどうしてこう胸にばっかり興味を持つのかしら」
			PRINTFORMW 「胸なんて赤ん坊に授乳できれば充分なのに…」
		ELSE
			PRINTFORMW 「胸でしろ？ そんなもの、胸で挟むなんて……」
			PRINTFORMW （これだから胸が大きいのなんて邪魔なだけって思うのよね……）
			PRINTFORMW （男からも女からも変な目で見られるし、こういう変な要求されるし……）
			PRINTFORMW 「……はぁ、やればいいんでしょ、やれば……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;胸3以上
	ELSEIF ABL:胸 > 2
		IF RAND:4 == 0
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「んっ、先のほうも舐めてあげる……ぺろっ、ちゅっ……」
				CASE 1
					PRINTFORMW 「んっ、どう？ こんな感じでいいの？」
					PRINTFORMW 「あ、びくびくしてきてる……」
				CASE 2
					PRINTFORMW 「ん、んん…これ、私の胸も擦れて…気持ち良い…」
				CASE 3
					PRINTFORMW 「そんなに私の胸が良いの？　ふふ、それならいくらでもやってあげるわ」
				CASE 4
					PRINTFORMW 「ふふ、胸に挟んだだけでこんなになって…可愛いわね」
			ENDSELECT
		ELSEIF RAND:3 == 0
			PRINTFORMW 「ほら、男の人はこういうの好きだもんね%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「もっと気持ちよくしてあげる%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「んんっ%UNICODE(0x2665) *1%ほらっ%UNICODE(0x2665) *1%」
			PRINTFORMW 「早く射精してっ%UNICODE(0x2665) *1%」
		ENDIF
	;それ以外
	ELSE
		IF RAND:4 == 0
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「こんな感じでいいの？ ……そう、ならそのまま続けるわね」
					PRINTFORMW 「私も、何だか変な感じに……」
				CASE 1
					PRINTFORMW 「じゃあ挟むわね…ん、熱い…」
				CASE 2
					PRINTFORMW 「どう？　気持ち良い？　ってその顔を見れば聞くまでもないわね」
				CASE 3
					PRINTFORMW 「はぁ…疲れるわ」
			ENDSELECT
		ELSEIF RAND:3 == 0
			PRINTFORMW 「蓮子にはできないわよね」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「どうかしら？大きさは自信あるけど」
		ELSE
			PRINTFORMW 「どうかしら？私の胸気持ちいい？」
		ENDIF
	ENDIF
ENDIF
RETURN 1

