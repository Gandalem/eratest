;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K82_80
CALL M_KOJO_MESSAGE_COM_K82_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「손을 대면 되는 거야? 알았어, %CALLNAME:MASTER%」
			PRINTFORMW 「후훗, 주물러 줄게%UNICODE(0x2665) *1%」
			PRINTFORMW 「……언제든 싸도 괜찮으니까」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「엣, 손으로? 그걸로 괜찮다면……」
			PRINTFORMW 「말해주면 뭐든지 해줄 거야」
		ELSE
			PRINTFORMW 「손으로 비비는 거야? 뭐, 그 정도라면...」
			PRINTFORMW 「딱히 상관은 없는데, 아프지 않아?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:4 == 0
			PRINTFORMW 「음, 음쇼... 이런 느낌 어때?」
			PRINTFORMW 「앗, 지금 딱 깨물었어... 기분 좋지? 더 해 줄 테니까, 더 기분 좋아져 줘.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후훗, 몸을 떨고 있어서 귀엽네%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「한심한 표정 짓지 말고, 마음껏 사정해도 돼%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「음~ 냄새나는 카우퍼가 흘러 나왔네%UNICODE(0x2665) *1%」
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:4 == 0
			PRINTFORMW 「이런 느낌으로 괜찮은 걸까?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후후, 어때요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「빨리 사정하는 거 보여줘%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「자, 사정해도 돼 %UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「음... 스스로 하면 될 텐데...」
			PRINTFORMW 「손으로 문지르는 것만으로 괜찮아? 뭐, 그렇게 말한다면 얼마든지 해줄 수 있지만.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「여전하네... 뭐랄까, 그로테스크해」
			PRINTFORMW 「이거 의외로 손이 피곤하네...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「어머? 손으로 자위해줬으면 하는 거구나%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응, 자, 냄새나. 정액 빨리 내 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「이렇게 하고 있으면 남자는 단순하네, 이쪽에서 무슨 생각을 하는 걸까?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
