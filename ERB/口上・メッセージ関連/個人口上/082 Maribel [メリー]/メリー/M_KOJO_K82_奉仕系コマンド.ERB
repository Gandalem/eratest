;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:処女 && TALENT:恋慕
			PRINTFORMW 「えっ……初めてを貰ってくれるわけじゃないの……」
			PRINTFORMW 「……いえ、いいの。股ですればいいのね、わかったわ」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「股に挟むの？　確か素股ってやつよね」
			PRINTFORMW 「んんっ…これ、なんだか私も気持ち良いかも…」
		ELSEIF TALENT:処女
			PRINTFORMW 「お願い、私初めてなの、それだけはやめ……え？ 股で擦ればいいの？」
			PRINTFORMW 「それぐらいなら、まだ……いいけど……」
		ELSE
			IF IS_FALLEN()
				PRINTFORMW 「ちょ、ちょっと待って！　入れるのだけは…え？　素股？」
				PRINTFORMW 「擦るくらいなら、まぁ…」
			ELSE
				PRINTFORMW 「……股で、ねぇ。何考えてるのかよくわからないわ」
				PRINTFORMW 「中に入れられるよりは遥かにマシだけど……」
			ENDIF
		ENDIF
		SIF TALENT:恋慕
			PRINTFORMW 「んんっ%UNICODE(0x2665) *1%生殺しね%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;それ以外
	ELSE
		IF TALENT:恋慕
			IF IS_VIRGIN(TARGET) && !RAND:4
				PRINTFORMW 「はぁっ、擦れて、気持ちいい……」
				PRINTFORMW 「でも、できることなら、あぁ……」
			ELSE
				IF RAND:7 == 0
					PRINTFORMW 「ん、ふぅ…これ、私も感じちゃう…」
				ELSEIF RAND:6 == 0
					PRINTFORMW 「なんだか、股の間からひょこひょこ出てきて可愛いかも…」
				ELSEIF RAND:5 == 0
					PRINTFORMW 「はぁっ、擦れて、気持ちいい……」
					PRINTFORMW 「でも、切ないわ……%CALLNAME:MASTER%、次は、中に来て欲しい……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「ん、んん…これ、私の陰核も擦れて…気持ち良い…」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「挿入れなくていいの%UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「ふふっ%UNICODE(0x2665) *1%好きにしていいのよ%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「んんっ%UNICODE(0x2665) *1%くすぐったいわ%UNICODE(0x2665) *1%」
				ENDIF
			ENDIF
		ELSE
			IF IS_VIRGIN(TARGET) && !RAND:4
				IF RAND:2
					PRINTFORMW 「絶対に、絶対に中には入れないでよ……」
				ELSE
					PRINTFORMW 「い、いきなりずぼっていうのは無しだからね…？」
				ENDIF
			ELSE
				IF !IS_VIRGIN(TARGET) && !RAND:3
					PRINTFORMW 「んっ、擦るだけじゃ切ないわ…」
				ELSEIF RAND:2
					PRINTFORMW 「……これで、いいの？」
					PRINTFORMW 「そう、気持ちいいのなら、続けるわ……」
				ELSE
					PRINTFORMW 「擦れて変な気分になってきちゃった…」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1

