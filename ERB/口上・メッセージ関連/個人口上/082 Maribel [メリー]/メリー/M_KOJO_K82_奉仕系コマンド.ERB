;83,素股
;==================================================

@M_KOJO_MESSAGE_COM_K82_83
CALL M_KOJO_MESSAGE_COM_K82_83_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_83_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:処女 && TALENT:恋慕
			PRINTFORMW 「엣……처음(첫 경험)을 받아주지 않는 거군요……」
			PRINTFORMW 「……아뇨, 괜찮아요. 가슴이라면 되는 거네요, 알겠어요」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「가랑이에 끼우는 거야? 확실히 소모라고 하는 거 맞지?」
			PRINTFORMW 「음... 이거, 나도 뭔가 기분 좋은지도...」
		ELSEIF TALENT:処女
			PRINTFORMW 「부탁이야, 나 처음이라서 말인데, 그것만은 그만해... 응? 가랑이로 비비면 되는 거야?」
			PRINTFORMW 「그 정도라면 아직... 괜찮지만...」
		ELSE
			IF IS_FALLEN()
				PRINTFORMW 「저, 잠시만! 넣는 것만큼은... 에? 소모?」
				PRINTFORMW 「비비는 정도라면, 뭐...」
			ELSE
				PRINTFORMW 「......가랑이로, 있지. 무슨 생각을 하는 건지 잘 모르겠어」
				PRINTFORMW 「안에 들어가는 것보다는 훨씬 나으니까......」
			ENDIF
		ENDIF
		SIF TALENT:恋慕
			PRINTFORMW 「んん읏%UNICODE(0x2665) *1%生殺しね%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF TALENT:恋慕
			IF IS_VIRGIN(TARGET) && !RAND:4
				PRINTFORMW 「하아, 스치니까 기분 좋아...」
				PRINTFORMW 「하지만, 할 수 있다면, 아아...」
			ELSE
				IF RAND:7 == 0
					PRINTFORMW 「음, 후우... 나도 이 감정 느낄 수 있을 것 같아...」
				ELSEIF RAND:6 == 0
					PRINTFORMW 「왠지, 가랑이 사이로 살금살금 나와서 귀여울지도...」
				ELSEIF RAND:5 == 0
					PRINTFORMW 「하아, 스치니까 기분 좋아……」
					PRINTFORMW 「하지만 애타네…… %CALLNAME:MASTER%, 다음엔 안에 와줬으면 해……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「응, 음... 이거, 내 은핵도 스치고... 기분 좋아...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「삽입 안 해도 돼 %UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후훗%UNICODE(0x2665) *1% 마음대로 해도 돼%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「으응읏%UNICODE(0x2665) *1% 간지러워%UNICODE(0x2665) *1%」
				ENDIF
			ENDIF
		ELSE
			IF IS_VIRGIN(TARGET) && !RAND:4
				IF RAND:2
					PRINTFORMW 「절대로, 절대로 안에는 넣지 말아줘……」
				ELSE
					PRINTFORMW 「그, 갑자기 '즈보' 같은 건 안 돼...?」
				ENDIF
			ELSE
				IF !IS_VIRGIN(TARGET) && !RAND:3
					PRINTFORMW 「응, 비비는 것만으로는 애틋해...」
				ELSEIF RAND:2
					PRINTFORMW 「……이걸로, 괜찮은 거야?」
					PRINTFORMW 「그래, 기분 좋다면 계속할게……」
				ELSE
					PRINTFORMW 「스치면서 이상한 기분이 되어버렸어...」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
