@M_KOJO_MESSAGE_MARKCNG_K82
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
SIF FLAG:70
	RETURN 0
;苦痛刻印
IF TFLAG:22 == 1
	IF TALENT:恋慕
		PRINTFORMW 「으윽... 가능하다면, 아픈 건 참아줬으면 했어」
	ELSE
		PRINTFORMW 「이런 고통을 느끼고 있는데, 도무지 꿈에서 깨어날 기미가 없다는 건...」
	ENDIF
ELSEIF TFLAG:22 == 2
	PRINTFORMW 「윽……!!」
	PRINTFORMW 「부탁이야, 이제 더 이상 아픈 건 싫어...」 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 「으윽... 아무리 %CALLNAME:MASTER%라도... 아픈 건...」
	PRINTFORMW 「부탁이야, 이 이상은 용서해줘...」
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMDW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMDW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMDW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「너무 기분 좋아……. 응, 그건 안 되는데……」 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 「와, 나도 여자애니까, 그런 거 당하면 기분 좋아지기도 해」 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「후아... 방금 굉장했어... 있잖아, 지금 한 번 더 해줘~♪」
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMDW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMDW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMDW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMDW 
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMDW 
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW (안 돼... 나 이제... 견딜 수가 없어...)
	PRINTFORMW (미안해, 렌코... 이제 돌아갈 수 없을 것 같아...)
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORML 
ELSEIF TFLAG:21 == 2
	PRINTFORML 
ELSEIF TFLAG:21 == 3
	PRINTFORMW 「용서 못 해, 절대로...!」
ENDIF
