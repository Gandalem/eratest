@M_KOJO_MESSAGE_MARKCNG_K82
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
SIF FLAG:70
	RETURN 0
	
;苦痛刻印
IF TFLAG:22 == 1
	IF TALENT:恋慕
		PRINTFORMW 「ぐぅ…出来れば、痛いのは勘弁願いたかったわ」
	ELSE
		PRINTFORMW 「これほどの痛みを感じてるのに、一向に夢が醒める気配が無いなんて……」
	ENDIF 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 「ぐっ……！！」
	PRINTFORMW 「お願い、もう、痛いのはいやぁっ……」 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 「ぅぅ……いくら%CALLNAME:MASTER%でも……痛いのは……」
	PRINTFORMW 「お願い、これ以上は許して……」
ENDIF

;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMDW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMDW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMDW 
ENDIF

;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「気持ちよすぎ……んっ、そんなの駄目なのに……」 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 「わ、私だって女の子なんだから、そういう事されたら気持ち良くもなるわよ」 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「ふぁぁ…今の凄かった…ねえ、今のもう一回やって♪」
ENDIF

