		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:シャワー
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ふぁー……いい気持ちね、蓮子……」
						CALL CHARA_TEXT([[蓮子]], "『そうね……このままゆったりしててもいいんだけど……』", "w")
						CALL CHARA_TEXT([[蓮子]], "『すっきりしたところで、そろそろ、始めましょうか？』", "w")
					CASE 1
						PRINTFORMW 「いい気持ち……」
						CALL CHARA_TEXT([[蓮子]], "『そうね……』", "w")
						PRINTFORMW 「これから何されるか考えなければ、だけどね……」
					CASE 2
						PRINTFORMW 「ふぁー……いい気持ち……」
						CALL CHARA_TEXT([[蓮子]], "『そうね……』", "w")
						PRINTFORMW 「%CALLNAME:MASTER%も一緒にどう？ 3人でだとさすがに狭いかしら」
				ENDSELECT
			ELSE
				PRINTFORMW 「シャワーを浴びるの？　じゃあ一緒に洗いっこしましょう」
				PRINTFORMW 「～～～♪」
				PRINTFORMW メリーは鼻歌を歌いながらシャワーを浴びている
				PRINTFORMW 「貴方もどう？　気持ち良いわよ」
			ENDIF
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
