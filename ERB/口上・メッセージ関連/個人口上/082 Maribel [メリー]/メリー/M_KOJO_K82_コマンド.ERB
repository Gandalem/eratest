;=================================================
;特殊コマンド
;=================================================
;-------------------------------------------------
;180,ローション ;custom code
;-------------------------------------------------

@M_KOJO_MESSAGE_COM_K82_180
CALL M_KOJO_MESSAGE_COM_K82_180_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「그건…… 딱히, 그런 걸 쓰지 않아도 되는데」
		ELSE
			PRINTFORMW 「그런 건 쓰지 않아도, 나...」
			CALL K82_RENKO("『手っ取り早くやりたいだけよ』", "w")
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「또 그걸 사용할 거야? 그런 짓 안 해도……」
		PRINTFORMW 「아니면 그렇게 빨리 하고 싶은 거야?」
		IF IS_HERE([[蓮子]])
			CALL CHARA_TEXT([[蓮子]], "『온몸이 로션 범벅인 것도 뭔가 야하네~』", "w")
			PRINTFORMW 「……그런 것인가? 잘 모르겠어」
		ELSE
			PRINTFORMW 「음… 우리 색칠놀이 하자」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「이런 걸 가지고 뭘 하려는 거야?」 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「또 그거야? %SPLIT_G("ぬるぬる:ベトベト")%해서 기분 나빠...」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;181,媚薬, custom code
;==================================================

@M_KOJO_MESSAGE_COM_K82_181
CALL M_KOJO_MESSAGE_COM_K82_181_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_181_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음, 뭘 마시게 한 거야?」
		PRINTFORMW 「앗... 뭔가 이상해, ...혹시 미약? 들어본 적은 있지만 정말 있다니」
		IF TALENT:恋慕
			PRINTFORMW 「응, 하아..., 몸이 뜨거워... %CALLNAME:MASTER%, 빨리...」
		ELSE
			PRINTFORMW 「약 같은 것에, 의지하지 않아도, 나는……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「그런 것 먹이지 않아도 되는데……」
		PRINTFORMW 「응, 하아……이거 마시면 나 미쳐버릴 것 같아……」 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「우음... 아아... 저항 같은 건 안 하는데...」
		PRINTFORMW 「아니면... 억지로라도 나의 감정을 고조시키고 싶은 거야...?」 
		RETURN 1
		;それ以外
	ELSE
		IF IS_HERE([[蓮子]])
			PRINTFORMW 「또 이거 마시는 거야...?」
			CALL CHARA_TEXT([[蓮子]], "『안 마실 거면 그래도 상관없지만……응윽……』", "w")
			PRINTFORMW 「레, 렌코, 뭘... 윽, 음-! 크윽... 크윽... 푸하, 하아... 으으...」
		ELSE
			PRINTFORMW 「또 그런 걸로…… 약 같은 걸로, 억지로라니…… 응! 크윽, 우웁, 싫어!」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 입으로 강제로 미약을 메리에게 먹였다……
			PRINTFORMW 「으…… 아…… 아아……」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
