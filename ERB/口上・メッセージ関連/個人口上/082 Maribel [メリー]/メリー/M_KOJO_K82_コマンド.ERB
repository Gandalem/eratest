;==================================================
;183,ビデオカメラ, custom code (unused at the moment)
;==================================================

@M_KOJO_MESSAGE_COM_K82_183
CALL M_KOJO_MESSAGE_COM_K82_183_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_183_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「그거 비디오야? 유난히 오래된 타입 같은데」
		PRINTFORMW 「우리들이 하는 걸 촬영하는 거네. 좋아, 조금 부끄럽지만 기록으로 남겨두는 것도……」
		IF IS_HERE([[蓮子]])
			CALL CHARA_TEXT([[蓮子]], "『무슨 소리 하는 거야, 촬영해서 파는 거라고. 대단한 게 필요하다는 거지』", "w")
			PRINTFORMW 「에에!? 아무리 그래도 그건 좀..., 부끄럽잖아, 벌써...」
		ELSE
			PRINTFORMW 「에? 파는 거야? ……아무리 그래도 그건, 좀……」
		ENDIF
		CALLF SET_CEVENT("MerryVideoDone")
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:ビデオ撮影
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『비디오의 타이틀은... 음, 비봉 클럽의 비밀 회합 같은 거?』", "w")
				PRINTFORMW 「별로 센스가 좋다고는 할 수 없겠네……」
				CALL CHARA_TEXT([[蓮子]], "『음, …… 음, 그럴까……. 뭐 됐어, 어서 시작하자!』", "w")
			ELSE
				PRINTFORMW 「있잖아, 하나 정도 남기자고... 안 돼? 못된 건가...」
			ENDIF
			RETURN 1
			;屈服3
			;ELSEIF MARK:不埒刻印 == 3
			;	PRINTFORMW
			;	RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「찍어서 파는 건 상관없지만, 그게 원인이 되어 발목을 잡히고 파멸하는 생각은 없어?」
			PRINTFORMW 「아니요... 그런 생각이 있었다면 처음부터 이럴 일 없었겠죠...」
			RETURN 1
		ENDIF
		;終了
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;186,羞恥プレイ, custom code (unused at the moment)
;==================================================

@M_KOJO_MESSAGE_COM_K82_186
CALL M_KOJO_MESSAGE_COM_K82_186_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_186_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_HERE([[蓮子]])
			PRINTFORMW 「거울 앞에서 하는 거야? 또 이상한 걸 생각해내는구나……」
			PRINTFORMW 「렌코……꿈과 현실은 같은 것이지만……거울의 세계와 현실의 세계는 같은 건가요?」
			CALL CHARA_TEXT([[蓮子]], "『메리, 전에 나한테 말했었지. 꿈은 현실로 바뀐다는 거, 꿈의 세계를 현실로 만든다고 말이야.』", "w")
			CALL CHARA_TEXT([[蓮子]], "『만약 거울의 세계가 같은 것이었더라도, 비록 그것이 하나의 다른 세계라 할지라도』", "w")
			CALL CHARA_TEXT([[蓮子]], "『저쪽 세계의 두 사람에게 보여주기만 하면 되는 거야.』", "w")
		ELSE
			PRINTFORMW 「거울……네. 여기서 하다니…… 상상하는 것만으로도 굉장하네……」
			PRINTFORMW 「꿈과 현실은 같은 것…… 거울의 세계와 현실의 세계는 같을까?」
			PRINTFORMW 「단지 반대로 되어 있을 뿐인데, 다른 세계가 비치고 있는 것 같아……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:羞恥プレイ
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『거울 속의 우리도 부끄러워하고 있네... 그리고 즐거워 보여, 그치』", "w")
				CALL CHARA_TEXT([[蓮子]], "『자, 메리, 거울 너머의 우리들에게 보여주자』", "w")
			ELSE
				IF ABL:露出癖 > 3
					PRINTFORML 「또 거울 앞에서 하는 거야? 여전히 변태네」
					PRINTFORMW 그렇게 말하는 메리의 눈동자는 어딘가 촉촉한 빛을 띠었다.
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 또 거울 앞에서?」
					PRINTFORMW 「역시, 뭔가 신기한 기분이야……」
				ENDIF
			ENDIF
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「현실과 거울, 어느 쪽이 진짜이고 어느 쪽이 가짜인지」
				CALL CHARA_TEXT([[蓮子]], "『......메리?』", "w")
				PRINTFORMW 「지금의 나에게는 모르겠어……」
			ELSE
				PRINTFORMW 「우으... 또 그렇게 부끄러운 일을 시키다니...」
				PRINTFORMW 「거울 속의 나와 지금의 나, 바꿀 수 있다면 바꾸고 싶어...」
				PRINTFORMW 「둘 다 같을지도 모르지만...」
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			IF IS_HERE([[蓮子]])
				IF ABL:露出癖 >= 3
					PRINTFORMW 「부끄러워야 하는데……왠지 이상한 기분이야……」
					CALL CHARA_TEXT([[蓮子]], "『반대일 뿐인데 전혀 똑같아, 저쪽은 다른 세계 같네……』", "w")
					CALL CHARA_TEXT([[蓮子]], "『자, 메리, 시작하자』", "w")
				ELSEIF ABL:露出癖 >= 1
					CALL CHARA_TEXT([[蓮子]], "『거울 앞에서 말하는 것도 재미있잖아. 비치는 자신은 자신 같지 않은 것 같아서……. 메리, 무슨 일이야?』", "w")
					PRINTFORMW 「……아니, 아무것도 아니야.…………」
				ELSE
					PRINTFORMW 「또......인가......?」
					CALL CHARA_TEXT([[蓮子]], "『적당히 익숙해지면 될 텐데. 거울 너머의 우리에게 보여주듯이 하는 것도 좋다고.』", "w")
					PRINTFORMW 「어떤 감각을 느끼고 있는 거야, 렌코...」
				ENDIF
			ELSE
				IF ABL:露出癖 >= 3
					PRINTFORMW 「부끄러워야 하는데……왠지 이상한 기분이야……」
				ELSEIF ABL:露出癖 >= 1
					PRINTFORMW 「거울……현실의 나, 거울 속의 나…… 더러워진 나…… 저쪽 세계의 나는……」
				ELSE
					PRINTFORMW 「또... 거울 앞에서 하는 거야...」
					IF RAND:2
						PRINTFORMW 「어째서 내가 당신의 취향에 맞춰야 하는 거야…」
					ELSE
						PRINTFORMW 「나한테 보여주라고 하면서 어떡하냐고 말하는 거야……」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;終了
	ELSE
		IF TALENT:恋慕
			IF ABL:露出癖 >= 3
				PRINTFORMW 「당신의 성벽에도 곤란한 것이네」
				PRINTFORMW 말하면서도 메리는 어딘가 아쉬운 듯 보였다
			ELSE
				PRINTFORMW 「이제, 끝내도 되는 거야?」
				PRINTFORMW 메리는 서둘러 거울 앞에서 움직여 침대에 몸을 숨겼다.
			ENDIF
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「왠지 너무 피곤하다…」
		ELSE
			PRINTFORMW 「이렇게 부끄러운 일을 시키다니...」
			PRINTFORMW 메리는 눈시울이 붉어진 채 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있었다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
