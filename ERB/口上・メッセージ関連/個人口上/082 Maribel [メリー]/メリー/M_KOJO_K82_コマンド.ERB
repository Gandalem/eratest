@M_KOJO_MESSAGE_COM_K82_188_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_HERE([[蓮子]])
			PRINTFORMW 「여기는 정말 다 있네……. 샤워실까지 있다니.」
			CALL CHARA_TEXT([[蓮子]], "『정말 깜짝 놀랐지……. 자, 같이 씻자』", "w")
			PRINTFORMW 「렌코, 같이 목욕할 의미가 있는 거야?」
			CALL CHARA_TEXT([[蓮子]], "『뭐, 그냥 그런 느낌?』", "w")
		ELSE
			PRINTFORMW 「샤워? 정말 뭐든지 있네, 여기」
			PRINTFORMW 「음~……아아, 기분 좋아……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:シャワー
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「후아... 기분 좋네, 렌코...」
						CALL CHARA_TEXT([[蓮子]], "『그렇네…… 이대로 느긋하게 있어도 괜찮을지도 모르겠는데……』", "w")
						CALL CHARA_TEXT([[蓮子]], "『개운해졌으니, 이제 시작할까?』", "w")
					CASE 1
						PRINTFORMW 「기분 좋다……」
						CALL CHARA_TEXT([[蓮子]], "『그렇네…』", "w")
						PRINTFORMW 「앞으로 무슨 일을 당할지 생각해야 하지만 말이야……」
					CASE 2
						PRINTFORMW 「후아…… 기분 좋다……」
						CALL CHARA_TEXT([[蓮子]], "『그렇네…』", "w")
						PRINTFORMW 「%CALLNAME:MASTER%도 같이 어때? 셋으로 하면 아무래도 좁지 않을까」
				ENDSELECT
			ELSE
				PRINTFORMW 「샤워할 거야? 그럼 같이 몸을 씻자」
				PRINTFORMW 「～～～♪」
				PRINTFORMW 메리는 흥얼거리며 샤워를 하고 있다.
				PRINTFORMW 「당신도 어때? 기분 좋잖아.」
			ENDIF
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『기분 좋네, 메리.』", "w")
				PRINTFORMW 「……네, 그렇죠……」
				CALL CHARA_TEXT([[蓮子]], "『그대로 여유롭게 하고 싶긴 하지만, 슬슬 시작할게』", "w")
			ELSE
				PRINTFORMW 「샤워가 싫지는 않고 기분 좋긴 하지만」
				PRINTFORMW 「앞으로 무슨 짓을 당할지 생각하면, 솔직히 기뻐할 수가 없어...」 
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW (이 더러워진 몸도 같이 흘러내리면 좋을 텐데……)
			PRINTFORMW (설령 외모만 깨끗해진다 해도, 속은……)
			PRINTFORMW 「하아… 뭔가 되살아난 기분이네…」
			RETURN 1
		ENDIF
		;終了
	ELSE
		IF TALENT:恋慕
			PRINTFORMW 「자, 깨끗해졌으니 또 더러워질 거야?」
		ELSE
			PRINTFORMW 「후우... 개운해졌네.」
			PRINTFORMW 「애써 깨끗하게 됐는데, 또 하는 거야...?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
