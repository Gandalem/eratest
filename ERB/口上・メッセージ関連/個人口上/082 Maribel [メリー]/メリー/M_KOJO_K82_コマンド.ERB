	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「んっ、何を飲ませたの？」
		PRINTFORMW 「あっ……なんか変な感じ、……もしかして媚薬？ 聞いたことはあるけど本当にあるなんて」
		IF TALENT:恋慕
			PRINTFORMW 「んっ、はぁっ……、身体が熱い……%CALLNAME:MASTER%、早く……」
		ELSE
			PRINTFORMW 「薬なんかに、た、頼らなくたって、私は……」
		ENDIF
		RETURN 1
	ENDIF
