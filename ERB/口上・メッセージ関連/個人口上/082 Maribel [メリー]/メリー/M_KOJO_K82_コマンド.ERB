		ELSE
			PRINTFORMW 「そんなもの使わなくたって、私……」
			CALL K82_RENKO("『手っ取り早くやりたいだけよ』", "w")
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「またそれ使うの？ そんなことしなくても……」
		PRINTFORMW 「それともそんなに早くやりたいの？」
		IF IS_HERE([[蓮子]])
			CALL CHARA_TEXT([[蓮子]], "『全身ローションまみれっていうのもなんかエッチよね～』", "w")
			PRINTFORMW 「……そういうものなの？ よくわからないわ」
		ELSE
