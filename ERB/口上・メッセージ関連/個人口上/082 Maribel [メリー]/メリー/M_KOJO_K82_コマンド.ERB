;==================================================
;186,羞恥プレイ, custom code (unused at the moment)
;==================================================
@M_KOJO_MESSAGE_COM_K82_186
CALL M_KOJO_MESSAGE_COM_K82_186_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K82_186_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_HERE([[蓮子]])
			PRINTFORMW 「鏡の前でするの？ また変わったこと思いつくわね……」
			PRINTFORMW 「蓮子……夢と現は同じものだけど……鏡の世界と現実の世界は同じなのかしら？」
			CALL CHARA_TEXT([[蓮子]], "『メリー、前に私言ったわよね。夢は現実に変わるもの、夢の世界を現実に変えるんだって』", "w")
			CALL CHARA_TEXT([[蓮子]], "『もし鏡の世界が同じものであったとしても、たとえそれがひとつの別の世界だとしても』", "w")
			CALL CHARA_TEXT([[蓮子]], "『向こうの世界の２人に見せ付けるようにやればいいだけなのよ』", "w")
		ELSE
			PRINTFORMW 「鏡……ね。ここでするなんて……想像するだけでも凄いわね……」
			PRINTFORMW 「夢と現は同じもの……鏡の世界と現実の世界は同じなのかしら？」
			PRINTFORMW 「ただ反対になっているだけなのに、別の世界が映っているみたい……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:羞恥プレイ
		;恋慕
		IF TALENT:恋慕
			IF IS_HERE([[蓮子]])
				CALL CHARA_TEXT([[蓮子]], "『鏡の中の私達も恥ずかしがっていて……そして楽しそうよね』", "w")
				CALL CHARA_TEXT([[蓮子]], "『ほら、メリー、鏡の向こうの私達に見せ付けてあげましょう』", "w")
			ELSE
				IF ABL:露出癖 > 3
					PRINTFORML 「また鏡の前でするの？　相変わらず変態ね」
					PRINTFORMW そう言うメリーの瞳は心なしか艶を帯びた
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%、また鏡の前で？」
					PRINTFORMW 「やっぱり、何だか不思議な感じね……」
				ENDIF
			ENDIF
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			IF IS_HERE([[蓮子]])
				PRINTFORMW 「現と鏡と……どちらが真でどちらが偽か」
				CALL CHARA_TEXT([[蓮子]], "『……メリー？』", "w")
				PRINTFORMW 「今の私にはわからないわ……」
			ELSE
				PRINTFORMW 「うぅ…またそうやって恥ずかしい事させる…」
				PRINTFORMW 「鏡の中の私と現の私、交代できるものなら交代したいわ……」
				PRINTFORMW 「どちらも同じかもしれないけど……」
			ENDIF
			RETURN 1
		;それ以外
		ELSE
			IF IS_HERE([[蓮子]])
				IF ABL:露出癖 >= 3
					PRINTFORMW 「恥ずかしいはずなのに……なんだか不思議な感じ……」
					CALL CHARA_TEXT([[蓮子]], "『反対なだけで全く同じなのに、向こうは別世界のようよね……』", "w")
					CALL CHARA_TEXT([[蓮子]], "『さ、メリー、始めましょう』", "w")
				ELSEIF ABL:露出癖 >= 1
					CALL CHARA_TEXT([[蓮子]], "『鏡の前でっていうのも面白いのよ。映る自分は自分じゃないみたいだもの……ってメリー、どうかしたの？』", "w")
					PRINTFORMW 「……いえ、何でもないわ。…………」
				ELSE
					PRINTFORMW 「また……なの……？」
					CALL CHARA_TEXT([[蓮子]], "『いい加減慣れればいいのに。鏡の向こうの私達に見せ付けるようにするのもいいわよ』", "w")
					PRINTFORMW 「どういう感覚してるのよ、蓮子……」
				ENDIF
			ELSE
				IF ABL:露出癖 >= 3
					PRINTFORMW 「恥ずかしいはずなのに……なんだか不思議な感じ……」
				ELSEIF ABL:露出癖 >= 1
					PRINTFORMW 「鏡……現の世界の私、鏡の世界の私……汚れきった私……向こうの世界の私は……」
