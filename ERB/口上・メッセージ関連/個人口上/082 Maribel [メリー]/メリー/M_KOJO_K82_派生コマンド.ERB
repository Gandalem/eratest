@M_KOJO_MESSAGE_SCOM_K82_1
CALL M_KOJO_MESSAGE_SCOM_K82_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K82_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「서로를 깔보는 건 광대극이야」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응! %UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추고 있다.
				PRINTFORMW 「더 핥아봐 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응응%UNICODE(0x2665) *1%앗%UNICODE(0x2665) *1%정액 냄새 지독해앳%UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 능숙하게 재촉하고 있다.
			ELSE
				PRINTFORMW 「응읏%UNICODE(0x2665) *1%응~읏%UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 능숙하게 재촉하고 있다.
				PRINTFORMW 「아주 진한 쿠퍼액 냄새…… 좋아%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응?」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하고 혀를 사용해 능숙하게 그것을 부추고 있다.
				PRINTFORMW 「이제 나올 것 같은데 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 카우퍼가 넘치고 있어...%UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 부추기고 있다.
			ELSE
				PRINTFORMW 「응, 안 돼 %UNICODE(0x2665) *1%」
				PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용하여 능숙하게 그것을 재촉하고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응……%UNICODE(0x2665) *1%냄새나서 좋아……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응응! %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 「익숙한 거잖아 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「아앗%UNICODE(0x2665) *1% 나와랏%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~」
				PRINTFORMW 「잘했지, 혀 사용%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 어때요 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응음... 더 핥아줘 %UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음……응……%UNICODE(0x2665) *1%」
			PRINTFORMW 「서툰 건 서로 마찬가지네♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……응윽……음음윽……」
		ELSE
			PRINTFORMW 「……음… 음~」
		ENDIF
	ENDIF
ENDIF
