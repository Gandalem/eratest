;==================================================
;4,乱れ牡丹 custom code expanded
;==================================================
@M_KOJO_MESSAGE_SCOM_K82_4
CALL M_KOJO_MESSAGE_SCOM_K82_4_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K82_4_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				PRINTFORML 「確かに初めては大事だし、私もちゃんとしたいけど…」
				PRINTFORMW 「よく見えるからってこれは…」
				PRINTFORMW メリーは自分の前に置かれている大きな鏡を見た
				PRINTFORMW 「まぁ…貴方が折角気遣ってくれたんだし、ね」
				PRINTFORMW 諦めたようにそう言うとゆっくりと腰を落とす
				PRINTFORMW 「んっ！　くぅ…んんんっ！」
				PRINTFORMW 「痛いのは知ってたけど、これは想像以上というか、想像すらできないくらいだわ……」
				PRINTFORMW 痛みに瞑っていた目を開くと、鏡の中では膣口から破瓜の血を流し幸せそうに%CALLNAME:MASTER%に抱かれている自分がいた
			ELSE
				PRINTFORMW 「んんっ！　ぐ、ぁぁ…！」
				PRINTFORMW （好きでもない人に捧げなきゃいけないだなんて…この悪夢はいつ終わるの…？）
			ENDIF
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「これ、全部見えるわね…」
				PRINTFORMW メリーは露わになった自分の秘所を見て顔を真っ赤にしている
				PRINTFORMW 「わ、分かったから早く終わらせましょう？　恥ずかしくて死んじゃうわ…」
			ELSE
				PRINTFORMW 「貴方っておかしな趣味してるわね…」
				PRINTFORMW （この人に助けられたのって、やっぱり失敗だったのかしら……）
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		RETURN 1
	ELSE
		IF ABL:露出癖 >= 3 && ABL:Ｖ感覚 >= 3
			IF !RAND:3
				PRINTFORMW 「映ってる……私と、%CALLNAME:MASTER%が繋がっているところが……！」
				PRINTFORMW 「あんっ、ああっ、鏡の中の私も、凄く、いやらしい……！」
			ELSEIF RAND:2
				PRINTFORMW 「あっあぁ！　全部、見えてる…！」
				PRINTFORMW メリーは鏡に映る自分の痴態を陶然と見つめている
			ELSE
				PRINTFORML 「ひぁっ、んんっ！　んぁあっ！」
				PRINTFORMW メリーは鏡を見ないように顔を隠し声を押し殺している
			ENDIF
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「映ってる……私と、%CALLNAME:MASTER%が繋がっているところが……！」
					PRINTFORMW 「あぁっ、%CALLNAME:MASTER%、恥ずかしい、恥ずかしいのに、私、私っ……！」
				CASE 1
					PRINTFORMW 「ふぁぁ！　%CALLNAME:MASTER%のが全部入ってるの、ちゃんと見えるわ…」
				CASE 2
					PRINTFORML 「うぅ…何回やっても恥ずかしいものは恥ずかしいわよ…」
					PRINTFORMW メリーは鏡に映る自分に羞恥心を煽られている
				CASE 3
					PRINTFORMW 「こういうプレイはあんまり慣れないわ…」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
