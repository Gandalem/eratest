@M_KOJO_MESSAGE_SCOM_K82_2
CALL M_KOJO_MESSAGE_SCOM_K82_2_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K82_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「어머? 그렇게 내 곳을 핥고 싶어?」
		PRINTFORMW 「이, 이렇게 하는 거야...?」
		PRINTFORMW 「이건 아무리 그래도 부끄러워...」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:Ｃ感覚 >= 5
			IF !RAND:3
				PRINTFORML 「큭! %조사처리(CALLNAME:MASTER,"의")% 혀가 들어와 있어...!」
				PRINTFORMW 일부러 소리가 나게 애액을 빨자 메리는 더욱 애액 분비를 늘렸다.
			ELSEIF RAND:2
				PRINTFORML 「핫, 음응! 히아아!」
				PRINTFORMW 메리는 자신의 추태를 전혀 신경 쓰지 않고 완전히 도취해 있었다.
			ELSE
				PRINTFORML 「아아앗! 혀가, 들어오고 있어!」
				PRINTFORMW 은밀한 곳에 혀를 넣자 메리는 전신을 강하게 떨었다.
			ENDIF
		ELSE
			IF !RAND:3
				PRINTFORMW 「이거, 저는 기분 좋은데, %조사처리(CALLNAME:MASTER,"는")% 괴롭지 않아?」
			ELSEIF RAND:2
				PRINTFORMW 「응... 이거, 역시 부끄럽네...」
			ELSE
				PRINTFORMW 「응응, 아... 소리가 나버릴 것 같아...!」
			ENDIF
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 안 돼앳%UNICODE(0x2665) *1%」
			PRINTFORMW 「가버려엇%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 핥아줘%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%응앗%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「하아, 응! 으윽!」
		IF RAND:2
			PRINTFORMW (이렇게 부끄러운데... 기분 좋아...! )
		ELSE
			PRINTFORMW 「이런 건, 너무 부끄러워...」
		ENDIF
	ENDIF
ENDIF
