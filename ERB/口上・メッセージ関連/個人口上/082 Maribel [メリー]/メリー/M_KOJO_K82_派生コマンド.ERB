;==================================================
;2,岩清水 custom code expanded
;==================================================
@M_KOJO_MESSAGE_SCOM_K82_2
CALL M_KOJO_MESSAGE_SCOM_K82_2_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K82_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「あら？そんなに私のアソコ舐めたいの？」
		PRINTFORMW 「こ、こんな風にするものなの…？」
		PRINTFORMW 「これは流石に恥ずかしいわ…」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:Ｃ感覚 >= 5
			IF !RAND:3
				PRINTFORML 「ふぁっ！　%CALLNAME:MASTER%の舌が入ってる…！」
				PRINTFORMW わざと音が出るように愛液を啜るとメリーは更に愛液の分泌を増やした
			ELSEIF RAND:2
				PRINTFORML 「はっ、んんんっ！　ひぁあ！」
				PRINTFORMW メリーは自分の痴態を気にも留めず完全に陶酔している
			ELSE
				PRINTFORML 「あっあぁ！　舌が、入ってきてる！」
				PRINTFORMW 秘所に舌を差し込むとメリーは全身を強く跳ね上げさせた
			ENDIF
		ELSE
			IF !RAND:3
				PRINTFORMW 「これ、私は気持ち良いけど、%CALLNAME:MASTER%は苦しくないの？」
			ELSEIF RAND:2
				PRINTFORMW 「んん…これ、やっぱり恥ずかしいわ…」
			ELSE
				PRINTFORMW 「んん、やっ…声、出ちゃう…！」
			ENDIF
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「んっ%UNICODE(0x2665) *1%駄目っ%UNICODE(0x2665) *1%」
			PRINTFORMW 「イっちゃうっ%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「んっ%UNICODE(0x2665) *1%舐めてっ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「あっ%UNICODE(0x2665) *1%んっ%UNICODE(0x2665) *1%んあっ%UNICODE(0x2665) *1%」
		ENDIF 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORML 「はぁっ、んぁ！　んくぅ！」
		IF RAND:2
			PRINTFORMW （こんな恥ずかしいのに…気持ち良い…！）
		ELSE
			PRINTFORMW 「こんなの、恥ずかし過ぎるわよ…」
		ENDIF
	ENDIF
ENDIF
