@M_KOJO_MESSAGE_SCOM_K82_4
CALL M_KOJO_MESSAGE_SCOM_K82_4_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K82_4_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				PRINTFORML 「확실히 처음은 소중하고, 나도 제대로 하고 싶지만…」
				PRINTFORMW 「잘 보인다고 해서 이건…」
				PRINTFORMW 메리는 자신의 앞에 놓여 있는 커다란 거울을 봤다.
				PRINTFORMW 「뭐… 당신이 애써 배려해 준 거니까, 응」
				PRINTFORMW 포기한 듯 그렇게 말하고 천천히 주저앉았다.
				PRINTFORMW 「응읏! 크윽… 음음음!」
				PRINTFORMW 「아픈 건 알고 있었지만, 이건 상상을 초월하거나, 심지어 상상조차 할 수 없을 정도야……」
				PRINTFORMW 고통으로 감고 있던 눈을 뜨자, 거울 속에는 질 입구에서 파과(破瓜)의 피를 흘리며 행복하게 %조사처리(CALLNAME:MASTER,"에게")% 안겨 있는 자신이 있었다.
			ELSE
				PRINTFORMW 「응, 으윽! 끄, 아아...」
				PRINTFORMW (좋아하지도 않는 사람에게 바쳐야 한다니... 이 악몽은 언제 끝나는 걸까...?)
			ENDIF
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「이거, 전부 보이니까...」
				PRINTFORMW 메리는 드러난 자신의 은밀한 곳을 보고 얼굴을 새빨갛게 하고 있다.
				PRINTFORMW 「알았으니까 빨리 끝내요? 부끄러워서 죽어버릴 것 같아요...」
			ELSE
				PRINTFORMW 「당신은 이상한 취미를 가지고 있네요...」
				PRINTFORMW (이 사람에게 도움받은 건, 역시 실패였을까...)
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		RETURN 1
	ELSE
		IF ABL:露出癖 >= 3 && ABL:Ｖ感覚 >= 3
			IF !RAND:3
				PRINTFORMW 「비치고 있어... 나와, %조사처리(CALLNAME:MASTER,"가")% 연결된 부분이...!」
				PRINTFORMW 「안, 아앗, 거울 속의 나도, 정말 음란해...!」
			ELSEIF RAND:2
				PRINTFORMW 「아아! 전부, 보이고 있어...!」
				PRINTFORMW 메리는 거울에 비친 자신의 추태를 도취하며 바라보고 있다.
			ELSE
				PRINTFORML 「히얏, 음윽! 응아앗!」
				PRINTFORMW 메리는 거울을 보지 않으려고 얼굴을 가리고 소리를 참았다.
			ENDIF
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「비치고 있어... 나와, %조사처리(CALLNAME:MASTER,"가")% 연결된 부분이...!」
					PRINTFORMW 「아앗, %CALLNAME:MASTER%, 부끄러워, 부끄러운데, 나, 나는...!」
				CASE 1
					PRINTFORMW 「하아! %조사처리(CALLNAME:MASTER,"가")% 전부 들어있는 게, 제대로 보인다...」
				CASE 2
					PRINTFORML 「우으... 몇 번을 해도 부끄러운 건 부끄럽다고...」
					PRINTFORMW 메리는 거울에 비친 자신에게 수치심을 느끼고 있다
				CASE 3
					PRINTFORMW 「이런 플레이에는 별로 익숙하지 않아...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
