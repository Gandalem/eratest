LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 메리의 입술을 빼앗았다.
		PRINTFORMW 그 입술은 부드러웠고, 새콤달콤한 맛이 났다.
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K82_20_1
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「……응응」
		PRINTFORMW 메리는 키스를 받자 살짝 흐릿한 목소리를 냈다.
	ELSEIF TFLAG:193 == 99 ;custom code
		PRINTFORMW 「뭐...뭐 하는 거야!?」
		PRINTFORMW 메리는 입술을 닦으며 힘없이 노려보고 있다.
	ELSEIF FIRSTTIME("MerryKiss") ;custom code
		PRINTFORML 「응!?」
		PRINTFORMW 살짝 입술이 맞닿자 메리는 몸을 뒤로 뺐다.
		PRINTFORMW 「죄, 죄송해요, 조금 놀라서...」
		PRINTFORMW 「하지만... 고마워. 한 번만 더 해줘」
		PRINTFORMW 「응, 쪽... 후후」
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응……%UNICODE(0x2665) *1%좀 더 붙어 있고 싶어%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응... 바보 같잖아... %UNICODE(0x2665) *1%」
			PRINTFORMW 메리는 그렇게 말하면서도 %조사처리(CALLNAME:MASTER,"의")% 입술을 되찾았다.
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%%UNICODE(0x2665) *1%키스만이 아니라, 말이야%UNICODE(0x2665) *1%」
			PRINTFORMW 메리는 입술을 빼앗긴 채 상대가 하는 대로 몸을 맡기고 있다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응!」
			PRINTFORMW 「더 키스해 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
			IF RAND:2 ;custom code
				PRINTFORMW 「후후, 이런 키스라도 좋아하는 사람에게 받으면 기쁜 법이지.」
			ELSE
				PRINTFORMW 「강압적이네, 나도 좋아해 %UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			PRINTFORMW 「읏%UNICODE(0x2665) *1%続けて……%UNICODE(0x2665) *1%」
			PRINTFORMW 메리는 키스를 받자 더욱 입술을 밀어붙였다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「ん읏%UNICODE(0x2665) *1% もう、急にキスしないで……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음응%UNICODE(0x2665) *1% 쪽...」
			IF RAND:2 ;custom code
				PRINTFORMW 「아, 당신이 좋다면, 좀 더 격렬한 것도 괜찮아...」
			ELSE
				PRINTFORMW 「기분은 좋지만, 계속할 거야?」
			ENDIF
		ELSE
			PRINTFORMW 「응 %UNICODE(0x2665) *1%」
			IF RAND:2 ;custom code
				PRINTFORMW 「더 적극적이어도 괜찮은데」
			ELSE
				PRINTFORMW 「...더 해도 좋으니까」
			ENDIF
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...응, 응... 잠깐만요!」
			PRINTFORMW 메리는 %조사처리(CALLNAME:MASTER,"에게")% 입맞춤을 당해 당황하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……！」
			PRINTFORMW 「……변태」
		ELSE
			PRINTFORML 「음…」
			PRINTFORMW 키스라는 행위에는 응하지만 별로 기쁘게 생각하는 것 같지 않다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
