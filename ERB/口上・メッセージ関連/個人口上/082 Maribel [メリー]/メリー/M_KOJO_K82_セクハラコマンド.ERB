@M_KOJO_MESSAGE_COM_K82_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「……치한!」
