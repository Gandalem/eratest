;40,ローター
;==================================================

@M_KOJO_MESSAGE_COM_K71_40
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	IF TALENT:体型 == -5
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 당신은 로터를 신묘마루의 클리토스에 대고, 그로 땀이 나는 부분을 정확히 맞춰야 한다.
			CASE 1
				PRINTFORMDL 로터로 신묘마루의 클리토스를 자극한다.
				PRINTFORMDW 스윗 스팟을 보려면 그녀를 아주 가까이 당겨야 한다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
