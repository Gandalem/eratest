@M_KOJO_MESSAGE_COM_K71_49
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF TALENT:体型 == -5
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 비교적 거대한 로터를 신묘마루의 유두에 가져다 댄다.
			CASE 1
				PRINTFORMDL 당신은 로터로 신묘마루의 유두를 놀린다.
				PRINTFORMDW 달콤한 지점을 보려면 그녀를 아주 가까이 당겨야 한다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
