;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K71_44
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		IF TALENT:体型 == -5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL 당신은 진묘마루에게 바이브레이터를 살짝 밀어 넣었다.
					PRINTFORMDW 아주 깊숙이 들어간 것은 아니지만 그녀의 작은 몸에 진동이 강하게 느껴진다.
				CASE 1
					PRINTFORMDL 당신은 바이브레이터를 신묘마루에게 살짝 밀어 넣는다.
					PRINTFORMDW 그녀는 마치 몸을 통해 지진이 지나가는 것처럼 떨었다.
			ENDSELECT
		ENDIF
		;解除
	ELSE
		IF TALENT:体型 == -5
			PRINTFORMDL 당신은 신묘마루에게서 바이브레이터를 빼낸다.
			PRINTFORMDW 그녀의 몸은 아직 그것이 있는 듯 떨린다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
