@M_KOJO_MESSAGE_COM_K71_311
CALL M_KOJO_MESSAGE_COM_K71_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSE
		IF TALENT:体型 == -5 && (TALENT:思慕 || TALENT:恋慕) && !RAND:3 ;custom code, expanded
			CALL D_LINE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMDW 당신은 신묘마루를 마치 갓 태어난 새끼 고양이를 안듯이 꼭 끌어안는다.
				CASE 1
					PRINTFORMDL 당신은 신명마루를 마치 깨지기 쉬운 파버그 접시처럼 아주 조심스럽게 안는다.
					PRINTFORMW 「너-좀 더 세게 안아줄 수도 있잖아...?」
				CASE 2
					PRINTFORMDL 신묘마루가 당신의 손바닥에 자리 잡고 당신의 손가락이 그녀를 감싼다.
					PRINTFORMDL 그녀는 마치 팔걸이처럼 당신의 손가락을 붙잡고 뒤로 기대어 당신을 바라본다.
					PRINTFORMDW %TNAME(TARGET)%과 눈이 마주치자, 그녀는 사랑스러운 작은 미소를 보인다.
				CASE 3
					PRINTFORMDW 당신은 신묘마루가 온 힘을 다해 당신에게 팔을 감으려고 하자 그녀를 꼭 안는다.
				CASE 4
					PRINTFORMDW 당신은 %TNAME(TARGET)%을 안아 다정하게 감싼다.
			ENDSELECT
		ELSE
			CALL TRAIN_MESSAGE ;call standard message
			;PRINTW ぎゅうぅ…
			IF TALENT:恋人
				PRINTFORMW 「당신의 온기... 좀 더 느끼게 해줘...」
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMDW 당신에게 안긴 채로, 신묘마루는 수없이 당신에게 키스한다.
						PRINTFORMW 「응... 츄... 하... 츄...」
						PRINTL 
						PRINTFORMW 「식사 정말 고마웠어, %CALLNAME:MASTER%!」
						;thinking about just removing this line, it's out of place in English
					CASE 1
						PRINTFORMDW 신묘마루가 당신의 옷깃 사이로 기어들어 왔다.
						PRINTFORMW 「따뜻하고 좋은 냄새가 나... 잠들지도 몰라...」
				ENDSELECT
			ELSEIF TALENT:恋慕
				PRINTFORMW 「... 후후, 당신의 품에 안겨 있으니 따뜻한 기분이 들어, %CALLNAME:MASTER%.」
				IF TALENT:キス未経験
					PRINTFORMW (당신에게 이렇게 가까이 있는데도 아직 키스를 받아본 적이 없어...)
				ELSE
					PRINTFORMW 「... %CALLNAME:MASTER%, 키스하자...」
					PRINTDW	신묘마루가 그녀의 입술을 당신에게 가져간다.
					PRINTFORMW 「츄... 후후...」
				ENDIF
			ELSEIF TALENT:思慕
				PRINTW 「너무 세게 안지 마, 알았지?」
				PRINTDW 신묘마루는 조금 두려워하며 당신을 껴안는다...
			ELSE
				PRINTW 「나 좀 놔줘―! 짓눌릴 거야―!」
				PRINTDW 신묘마루가 당신의 품에서 몸부림치고 있다...
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
