@M_KOJO_MESSAGE_COM_K71_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:体型 == -5 ;custom code
		SELECTCASE RAND:3
			CASE 0
				LOCALS:0 = 
				IF EQUIP:着物
					LOCALS:0 '= @"신묘마루의 기모노 자락"
				ELSEIF EQUIP:ワンピース
					LOCALS:0 '= @"신묘마루의 드레스 자락"
				ELSE
					LOCALS:0 '= @"신묘마루의 작은 치마"
				ENDIF
				PRINTFORMDL 당신은 %LOCALS:0%을 집어 올리기 시작한다.
				PRINTFORML 「이봐!」
				PRINTFORMDL 그녀는 치마를 다시 내린다.
				PRINTFORML 「난 인형이 아니라고, 알잖아!」
				PRINTFORML 「다시는 그러지 마..!」
				PRINTFORMDW 그녀는 입술을 삐죽거리며 자신의 핀 소드를 휘두른다.
			CASE 1
				PRINTFORMD 손가락을 튕겨 올린다 
				IF EQUIP:着物
					PRINTFORMDL 신묘마루의 기모노 밑단.
				ELSEIF EQUIP:ワンピース
					PRINTFORMDL 신묘마루의 드레스.
				ELSE
					PRINTFORMDL 신묘마루의 치마.
				ENDIF
				PRINTFORML 「와!」
				PRINTFORML 「그만둬!」
				PRINTFORML 「나 여자란 걸 알아야지!」
				PRINTFORMDW 그녀는 당신을 향해 자신의 핀 소드를 휘두른다.
			CASE 2
				LOCALS:1 = 
				IF EQUIP:着物
					LOCALS:1 '= @"기모노"
				ELSEIF EQUIP:ワンピース
					LOCALS:1 '= @"드레스"
				ELSE
					LOCALS:1 '= @"치마"
				ENDIF
				PRINTFORMDL 당신은 신묘마루를 손에 잡고 인형을 가지고 놀 듯 그녀의 %LOCALS:1%을 들어 올리기 시작한다.
				PRINTFORML 「와와와와와!」
				PRINTFORML 「이봐! 그만둬!」
				PRINTFORMDL 당신은 그녀의 팬티를 잘 볼 수 있게 되자 %TNAME(TARGET,1)%가 당신의 손아귀에서 몸부림친다.
		ENDSELECT
	ENDIF
	IF FLAG:70
	ELSE
	ENDIF
ENDIF
RETURN 1
