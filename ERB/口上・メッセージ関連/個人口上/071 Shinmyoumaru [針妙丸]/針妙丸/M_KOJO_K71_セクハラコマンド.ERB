	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_312
CALL M_KOJO_MESSAGE_COM_K71_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		IF TALENT:体型 == -5 ;custom code
			PRINTFORMDL 시간이 정지된 듯, 신묘마루의 작은 입 안으로 혀를 넣는 것을 막을 것은 아무것도 없다.
			PRINTFORMDW 어린애가 전혀 저항할 수 없는 상태로, 잠시 그녀와 프랑스식 키스를 한다.
		ENDIF
	ELSEIF CFLAG:睡眠
	ELSE
		IF EXP:TARGET:キス経験 == 1
			IF TALENT:恋人
			ELSEIF TALENT:恋慕
			ELSEIF TALENT:思慕
			ELSE
			ENDIF
		ELSE
			;custom code
			IF TALENT:体型 == -5
				IF TFLAG:193 == 99
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「Ah!」
							PRINTFORML 「나를 먹으려고 하는 거야?!」
							PRINTFORML 「......」
							PRINTFORML 「오, 나한테 키스하려고 했어..?」
							PRINTFORMW 「미안해, 괜찮아, 고마워.」
						CASE 1
							PRINTFORML 「크윽!」
							PRINTFORML 「너처럼 가까이 보는 건 필요 없어!」
							PRINTFORMDL 무례하군.
							PRINTFORMDW 하지만 솔직히 말해서 너무 성급하게 시도했을지도 모르지.
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「츄~」
							PRINTFORMDW 당신은 신명마루를 입으로 가져가고, 그녀는 당신의 입술에 키스한다.
						CASE 1
							PRINTFORML 「라하...」
							PRINTFORMDL 당신은 신묘마루를 입에 넣고 부드럽게 혀를 내민다.
							PRINTFORMDW 그녀는 자기 혀로 그것의 끝을 핥는다.
					ENDSELECT
				ENDIF
			ENDIF
			IF TALENT:恋人
				SELECTCASE RAND:2
					CASE 0
					CASE 1
				ENDSELECT
			ELSEIF TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
					CASE 1
				ENDSELECT
			ELSEIF TALENT:思慕
				SELECTCASE RAND:2
					CASE 0
					CASE 1
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
					CASE 1
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
