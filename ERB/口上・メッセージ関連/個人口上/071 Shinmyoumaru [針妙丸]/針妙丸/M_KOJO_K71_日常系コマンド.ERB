;300,会話
;==================================================
@M_KOJO_MESSAGE_COM_K71_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K71_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
;初回会話
	IF FIRSTTIME(300)
		PRINTFORML 「Okay... What do you want to talk about?」
		PRINTFORMDW Shinmyoumaru is slightly nervous as she talks to you.
	ELSE
;通常会話その１　たわいもない話
		SELECTCASE RAND:6
		CASE 0
			IF TALENT:恋人
				PRINTFORML 「It's never boring with you here, %CALLNAME:MASTER%.」
				PRINTFORMDW Shinmyoumaru says with a gentle smile.
				PRINTFORMW 「I'd like to talk with you a lot more...」
			ELSEIF TALENT:恋慕
				PRINTFORML 「More... I want to listen and talk to you some more, %CALLNAME:MASTER%.」
				PRINTFORMDW It seems Shinmyoumaru wants to know more about you.
			ELSEIF TALENT:思慕
				PRINTFORML 「Oohー, Okay then, what do you want to talk about?!」
				PRINTFORMDW Shinmyoumaru seems to be interested in talking.
			ELSE
				PRINTFORML 「Eeeh... So something like that happened.」
				PRINTFORMDW Shinmyoumaru nods while listening to the story.
			ENDIF
;通常会話その２　針妙丸の事について
		CASE 1
				IF TALENT:恋人
					PRINTFORMW 「An inchling's greatest source of anxiety probably comes from the difference in their height compared to others.」
					PRINTFORMW 「Carrying this anxiety has an effect, and on top of that, I've been defeated in the past...」
					PRINTFORMDW Shinmyoumaru stares at you and continues speaking.
					PRINTFORMW 「But because you treat me like this, I'm not bothered about the differences between me and others.」
					PRINTFORMW 「Rather, I'm glad that I could meet such a wonderful person...」
					PRINTL
					PRINTFORMW 「... Having said that, there are still scary people out there.」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「"The inchlings were destroyed by the Miracle Mallet brought back by Issun-bōshi."」
					PRINTFORMW 「... Is what I said, but the truth is, greed is the only reason why I summoned the Shining Needle Castle like that.」
					PRINTFORMW 「Much of what happened in that incident was because of my own ignorance.」
					PRINTFORMW 「But now... I've found something precious, so I don't think an incident like that will happen again.」
					PRINTFORMDW Saying that, Shinmyoumaru smiles in your direction...
				ELSEIF TALENT:思慕
					PRINTFORMW 「How come you haven't seen any other inchlings in Gensokyo...?」
					PRINTFORMW 「Well, that is... T-There's a reason for that.」
					PRINTFORMW 「The reason?... I can't tell you, I'm sorry.」
				ELSE
					PRINTFORMW 「I am a proud inchling... A descendant of Issun-bōshi.」
					PRINTFORMW 「I would stab even you with this needle of mine.」
					PRINTFORMDW Shinmyoumaru raises her hand holding her needle.
					PRINTFORMW 「... S-So, don't you dare do anything weird, okay?」
				ENDIF
;時間帯による会話分岐
		CASE 2
			IF TIME:0 >= 300 && TIME:0 < 600
					IF TALENT:恋人
						PRINTFORML 「Good morning, %CALLNAME:MASTER%!」
						PRINTFORMW 「What are you going to doing today? Heading out? Idling away at home?」
						PRINTFORMDW Shinmyoumaru is looking at you with gleaming eyes.
					ELSEIF TALENT:恋慕
						PRINTFORML 「Ah, it's %CALLNAME:MASTER%. Good morningー!」
						PRINTFORMDW Shinmyoumaru greets you loudly.
					ELSE
						PRINTFORML 「Good morning, %CALLNAME:MASTER%.」
						PRINTFORMDW Shinmyoumaru bows quickly.
					ENDIF
			ELSEIF TIME:0 >= 600 && TIME:0 < 780
					PRINTFORML 「I wonder what's for lunch today～」
					PRINTFORMDW Shinmyoumaru seems to be interested in today's lunch.
			ELSEIF TIME:0 >= 780 && TIME:0 < 960
					PRINTFORML 「During this time of the of the day, all I want to do is take a nap...」
					PRINTFORMDW Shinmyoumaru yawns lightly.
			ELSEIF TIME:0 >= 960 && TIME:0 <1200
					PRINTFORML 「Dinner time～♪ Dinner time～♪ I wonder I'm going to eat at dinner time～♪」
					PRINTFORMDW While in her bowl, Shinmyoumaru does a strange dance...
			ELSEIF TIME:0 >= 1200 || TIME:0 < 300
					PRINTFORML 「The night is growing long, don't you think it's time you go to sleep, %CALLNAME:MASTER%?」
					PRINTFORMDW Shinmyoumaru also looks sleepy...
			ENDIF
;天気とかの話
		CASE 3
			SELECTCASE TIME:5
				CASE 0,1
					IF TIME:0 >= 300 && TIME:0 < 900
						PRINTFORML 「The weather is nice today～. It's days like these that I feel like going fishing.」
						IF TALENT:恋人
							PRINTFORMW 「... Let's head out together, %CALLNAME:MASTER%.」
							PRINTFORMD Shinmyoumaru is holding your 
							IF TALENT:MASTER:体型 == -5 ;if player is inchling-sized
								PRINTFORMDW hand.
							ELSE
								PRINTFORMDW finger.
							ENDIF
						ELSE
							PRINTFORMDW Shinmyoumaru is cheerfully floating on her bowl...
						ENDIF
					ELSEIF TIME:0 >= 900 && TIME:0 < 1080
						PRINTFORML 「Today's sunset is as beautiful as ever～」
						PRINTFORMDW Shinmyoumaru is gazing at the sky dyed in red.
						IF TALENT:恋人
							PRINTFORMW 「... What do you want to do after this?」
							PRINTFORMDW She looks at you with upturned eyes.
						ENDIF
					ELSEIF TIME:0 >= 1080 || TIME:0 < 300
						PRINTFORML 「The moon is beautiful today as well～」
						PRINTFORMDW Yeah, the moon is beautiful too.
						PRINTFORMW 「... %CALLNAME:MASTER%?」
					ENDIF
				CASE 2,3
						PRINTFORML 「Rondondonyoriー」
						PRINTFORMDW ... What on earth is she saying?
				CASE 4,5,6
						PRINTFORML 「On rainy days like these, the house echoes with the sound of thunder.」
						PRINTFORMDW Shinmyoumaru rests her face in her hands as she gazes out the window.
						IF TALENT:恋人
							PRINTFORMW 「... If you don't have anything to do, we can play with each other all day, you know?」
						ENDIF
;				CASE 7
;				CASE 8,10,11
;				CASE 9
;				CASE 12,13
			ENDSELECT
;季節の話
;		ELSEIF A == 4
;			SELECTCASE DAY:2
;				CASE 1
;				CASE 2
;				CASE 3
;				CASE 4
;			ENDSELECT
;神社に住む人々の話
;霊夢
;萃香
;るーこと
;カナ
;こころ
;魅魔様
;
;神社の外の話
		CASEELSE
			SELECTCASE RAND:8
;輝針城
				CASE 0
					PRINTW 「It's been a while since that incident but... What do you think about the Shining Needle Castle?」
					IF TALENT:恋人
						PRINTW 「... You want both of us to live there sooner than later?」
						PRINTW 「It's kind of too big, especially for me...」
					ENDIF
;人里
				CASE 1
					PRINTW 「I went to the Human Village recently...」
						SELECTCASE RAND:5
							CASE 0
								PRINTW 「I saw Reimu in front of the cafe with an amazing look on her face～」
								PRINTW 「When it comes to food, she has the same expression as she does when solving incidents.」
							CASE 1
								PRINTW 「Akyuu was being pranked by the fairies～」
								PRINTW 「Tehe, I've also participated sometimes in the past.」
							CASE 2
								PRINTW 「Sometimes, Kosuzu will yell out and pose weirdly.」
								PRINTW 「"Kosuzu-chance!"... Is what she usually screams out.」
							CASE 3
								PRINTW 「Kasen had showed up at the cafe.」
								PRINTW 「She yelled out "Who was the one that brought out these sweets?!"」
								PRINTW 「... It sounded more like she was extorting them than lecturing.」
							CASE 4
								PRINTW 「While I was eating at the diner,」
								PRINTW 「A gluttonous pink ghost appeared!」
								PRINTW 「The village can be a terrifying place as well, huh...」
						ENDSELECT
;命蓮寺
				CASE 2
					PRINTW 「I went to the Myouren Temple recently...」
						SELECTCASE RAND:3
							CASE 0
								PRINTW 「There I saw Ichirin and Unzan.」
								PRINTW 「... I heard them saying something about Hachishakusama.」
							CASE 1
								PRINTW 「Byakuren was running around at mach speed.」
								PRINTW 「... I was wondering if she would turn to butter by running around that fast...」
							CASE 2
								PRINTW 「Kyouko was chanting sutras with a very loud voice.」
								PRINTW 「... But were those really sutras?」
						ENDSELECT
;太子廟
				CASE 3
					PRINTW 「I went to the Divine Spirit Mausoleum recently...」
						SELECTCASE RAND:3
							CASE 0
								PRINTW 「Miko was moving around in her cloak.」
								PRINTW 「... She looked like an owl with her cape wrapped around her like that...」
							CASE 1
								PRINTW 「Futo was leaving to go fishing.」
								PRINTW 「... For some reason I felt that I didn't want to lose to her.」
							CASE 2
								PRINTW 「I met a strange ghost there.」
								PRINTW 「I don't want to see any daikon radishes for awhile...」
						ENDSELECT
;地霊殿
				CASE 4
					PRINTW 「I went to the Palace of the Earth Spirits recently...」
						SELECTCASE RAND:3
							CASE 0
								PRINTW 「I was surprised when I heard a voice come out of nowhere...」
								PRINTFORMW 「You should also be careful of what might be behind you, %CALLNAME:MASTER%.」
							CASE 1
								PRINTW 「I met a youkai named Satori.」
								IF TALENT:恋人
									PRINTW 『It seems you're filled with happiness. I'm jealous.』
									PRINTFORMW 「Is what she said. Of course being with %CALLNAME:MASTER% would fill me with happiness.」
								ELSEIF TALENT:恋慕
									PRINTW 「... Did she say anything to me? T-That's a secret!」
								ELSEIF TALENT:思慕
									PRINTW 『You have an inferiority complex, but don't be misled by it.』
									PRINTW 「Is what she said to me... Satori-Youkai are scary...」
								ELSE
									PRINTFORMW 「And how did that go, you ask?... It doesn't have anything to do with you, %CALLNAME:MASTER%.」
								ENDIF
							CASE 2
								PRINTW 「I met Yuugi there... Ah, I mean Yuugi-neesan.」
								PRINTW 「I was afraid I was going to be mistaken for a sake cup...」
						ENDSELECT
;竹林
				CASE 5
					PRINTW 「I went to the Bamboo Forest recently...」
						SELECTCASE RAND:3
							CASE 0
								PRINTW 「I almost got lost in the bamboo forest but someone called Mokou helped me.」
								PRINTW 「She was surprised and shouted "Why is an inchling here?!"」
							CASE 1
								PRINTW 「There, I found a food stand run by someone named Mystia.」
								PRINTW 「The lampreys broiled in soy sauce, the smell coming off of the charcoal fires baking the eels, moderately seasoned with her secret recipe...」
								IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
									PRINTFORMW 「Next time, let's go there and eat together, %CALLNAME:MASTER%.」
								ELSE
									PRINTW 「I want to eat there again...(drool).」
								ENDIF
							CASEELSE
								PRINTW 「I saw a rabbit wearing something like a blazer as she was shambling around.」
								PRINTW 「She seemed like she was possessed by something as she kept repeating "Quota... My quota..." over and over...」
						ENDSELECT
;魔法の森
				CASE 6
					PRINTW 「I went to the Forest of Magic recently...」
						SELECTCASE RAND:3
							CASE 0
								PRINTW 「Marisa invited me to fly on her broom together.」
								PRINTW 「... I don't want to ride it ever again.」
							CASE 1
								PRINTW 「There was a beautiful sunflower field there, so I stopped to watch them.」
								PRINTW 「After a while though, I started to get chills on my spine. I was scared, so I went back home.」
								PRINTW 「... I wonder what that was about?」
							CASEELSE
								PRINTW 「I found an old fashioned, big western-style house.」
								PRINTW 「... I didn't find any signs of people there, but it was scary hearing voices coming from the inside...」
						ENDSELECT
;外界
				CASEELSE
					PRINTFORMW 「Hey, %CALLNAME:MASTER%... Do you know about the outside world?」
					PRINTFORMW 「... I'm afraid of the people in the outside world.」
					IF TALENT:恋人
						PRINTFORMW 「... But now, I feel like I could probably get along with them.」
					ENDIF


			ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;==================================================
@M_KOJO_MESSAGE_COM_K71_301
CALL M_KOJO_MESSAGE_COM_K71_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
A = RAND:2
;初回
	IF FIRSTTIME(301)
		PRINTFORMW 「Oh, you made some tea, %CALLNAME:MASTER%?」
		PRINTFORMW 「Well then, let's try it...」
		PRINTFORMDW Shinmyoumaru starts drinking the tea that you prepared...
		IF TFLAG:193 == -1
			PRINTFORMW 「(Cough, cough)! Uuehh... I-It's bitter...」
			PRINTFORMW 「Uuuh... You need to practice more, %CALLNAME:MASTER%.」
		ELSE
			PRINTFORML (Gulp, gulp)
			PRINTFORMW 「... Yeah, you prepared it well.」
			PRINTFORMW 「You're pretty good at making tea, %CALLNAME:MASTER%.」
			PRINTFORMDW Shinmyoumaru is making affirmative noises as she admires your skill.
		ENDIF
;２回目以降
	ELSE
		IF TALENT:恋慕 && A == 0
			PRINTFORML 「... As I thought, %CALLNAME:MASTER%'s roasted tea sure is warm...」
			PRINTFORMDW Shinmyoumaru is savoring the taste of your tea as she slowly sips from the cup.
		ELSEIF TALENT:恋慕 && A == 1
			PRINTFORMW 「The tea's too hot for me to drink... So, %CALLNAME:MASTER% could you please...?」
			PRINTFORMDW Shinmyoumaru is asking you to cool down her tea.
			PRINTFORMDW ... So you start blowing on the surface.
			PRINTFORMW 「Thank you... Fufu, You're so nice, %CALLNAME:MASTER%.」
		ELSE
			IF A == 0
				PRINTFORML 「Oh, thank you.」
				PRINTFORMDW Shinmyoumaru is trying her very best to drink the tea with her small mouth...
			ELSE
				PRINTFORML 「Thank you for th——It's hot!」
				PRINTFORMDW Shinmyoumaru is blowing on the tea to cool it down. Then, she carefully tries to drink it again.
			ENDIF
		ENDIF
;ぽかぽか縁側
		IF CFLAG:300 == 10
			PRINTL 
			PRINTFORMW 「... It's nice to drink tea on the veranda...」
			PRINTL 
		ELSE
			PRINTL 
	ENDIF
ENDIF
ENDIF
RETURN 1
