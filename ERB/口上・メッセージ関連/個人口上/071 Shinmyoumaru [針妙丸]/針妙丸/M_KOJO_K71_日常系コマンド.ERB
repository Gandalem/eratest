;302,スキンシップ
;==================================================

;custom code
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_302
IF TALENT:体型 == -5 && BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_302
CALL M_KOJO_MESSAGE_COM_K71_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:体型 == -5 && BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置) ;custom code
		IF !RAND:2
			PRINTFORMDL You wash the tiny Shinmyoumaru's back and hair.
			PRINTFORMDW You have to bend over deeply to reach the delicate girl's body, but fortunately you can finish quickly.
		ELSE
			PRINTFORMDL Shinmyoumaru offers to wash your back.
			PRINTFORMDW It takes her a while to finish.
		ENDIF
	ELSEIF FIRSTTIME(302)
		IF TALENT:思慕 || TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「Hah, T-That tickles!」
			PRINTFORMW （H-He finally touched me...）
			PRINTFORMDW While blushing, Shinmyoumaru enjoys your skinship.
		ELSE
			PRINTFORML 「...!」
			PRINTFORMDW Shinmyoumaru quickly takes out her needle and points it at you.
			PRINTFORMW 「W-Wha-wha-what are you doing?! Are you trying to eat me?!」
			PRINTFORMDW You try explaining to her the misunderstanding. Slowly and with a complicated expression, she lowers her needle.
			PRINTFORMW 「I-I see... Sorry for suddenly pointing my needle at you.」
			PRINTFORMW 「But, I think it's better to be more careful about suddenly touching girls, okay?」
			PRINTFORMDW ... Let's keep that in mind.
		ENDIF
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「Ah... Right there... Ah...」
					PRINTFORMW 「... %CALLNAME:MASTER%, you're really good at massaging...」
					PRINTFORMDW Shinmyoumaru softly smiles at you.
				CASE 1
					PRINTFORMW 「Yes, please touch me more...」
					PRINTFORMW 「I want to feel %CALLNAME:MASTER%'s warmth...」
					PRINTFORMD That being said, Shinmyoumaru clings to %CALLNAME:MASTER%'s 
					IF TALENT:MASTER:体型 == -5 ;if player is inchling-sized
						PRINTFORMDW arms.
					ELSE
						PRINTFORMDW fingers.
					ENDIF
				CASE 2
					IF TALENT:MASTER:体型 == -5 ;if player is inchling-sized
						PRINTFORMW 「I'm～ gonna～ eat ya up～!」
						PRINTFORMW 「...That's just what I heard some strange girl say to me once.」
						PRINTFORMDW ...Looks like %CALLNAME:MASTER% might be the one getting eaten this time.
					ELSE
						PRINTFORMW 「Uuu... you're gonna eat me like that! Like in those Shunga woodblock prints! You know, the naughty ones!」
						PRINTFORMW 「...Well, I guess it's fine doing this once in a while.」
						PRINTFORMDW %CALLNAME:MASTER% enjoyed giving Shinmyoumaru a good rubbing.
					ENDIF
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					IF TALENT:MASTER:体型 == -5 ;if player is inchling-sized
						PRINTFORMW 「Now, it looks I'd be able to eat you instead...」
					ELSE
						PRINTFORMW 「Kyaー! Don't eat meー!」
					ENDIF
					PRINTFORMW 「... Just kidding.」
					PRINTFORMDW This time the skinship was a bit more intense than usual.
				CASE 1
					PRINTFORML 「There, just a little...more... Nnn...」
					PRINTFORMDW You scratch at Shinmyoumaru's itchy spot.
				CASE 2
					PRINTFORML 「Your hands are really warm, %CALLNAME:MASTER%....」
					PRINTFORMDW Shinmyoumaru looks entranced...
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「That tickles, %CALLNAME:MASTER%....」
					PRINTFORMDW Shinmyoumaru resists slightly.
				CASE 1
					PRINTFORML 「Uuh... I won't stab you but...」
					PRINTFORMW 「I'm a girl too so...okay?」
					PRINTFORMDW Shinmyoumaru is confused as she blushes.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「No, W-Wait! That tickles...!」
					PRINTFORMDW Shinmyoumaru has an unpleasant look on her face.
				CASE 1
					PRINTFORML 「D-Don't touch me so familiarly!」
					PRINTFORMDW Shinmyoumaru is threatening you with her needle in her upraised hand.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
