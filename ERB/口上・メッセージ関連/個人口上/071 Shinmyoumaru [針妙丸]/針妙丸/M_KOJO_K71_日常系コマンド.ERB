;ABL:親密(4以下=居心地悪げ 9以下=恥ずかしげ それ以上=幸せそう
;TIME_PROGRESS(TFLAG:膝枕した)(44以下=失敗
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_336
IF TALENT:体型 == -5
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_336
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:体型 == -5 ;can be done continuously due to small size
		IF TFLAG:193 > 0
			;寝ちゃった
			PRINTFORMDL 신묘마루는 당신의 허벅지 사이 공간에서 편안하게 쉬었다.
			PRINTFORMDW 너무 편해서 잠시 꾸벅꾸벅 졸았다.
		ELSE
			;それ以外
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL 너무 작아서, 신묘마루는 당신의 무릎에 온몸을 쉽게 펼칠 수 있다.
					PRINTFORMDL 그녀는 매우 당황했지만 불행해 보이지 않는다.
					PRINTFORMW 「이거 아마 되게 바보같이 보일 거야...」
				CASE 1
					PRINTFORMDL 당신은 신묘마루를 무릎에 올려 편하게 해준다.
					PRINTFORMDW 그녀는 처음에는 편안해지려고 몸을 펴보려 했지만, 결국 고양이처럼 웅크리기로 결정한다.
			ENDSELECT
		ENDIF
		TFLAG:膝枕した = 0
	ENDIF
ENDIF
RETURN 1
