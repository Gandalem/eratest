@M_KOJO_SUCCESS_COM_K71_305 ;custom code
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 100 ;skip the crushing check

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_305 ;custom code
IF TALENT:体型 == -5
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_305
CALL M_KOJO_MESSAGE_COM_K71_305_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_305_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:体型 == -5 ;custom code
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「A l-lap pillow? But you'd crush me?!」
				PRINTFORMDW You compromise by laying next to Shinmyoumaru as she gently rubs your head.
			CASE 1
				PRINTFORMDL You lay next to Shinmyoumaru.
				PRINTFORML 「Are you stressed?」
				PRINTFORMDW She gently rubs your temples with her small little hands
			CASE 2
				PRINTFORMDL You lay down on your side next to Shinmyoumaru.
				PRINTFORMDL She gets startled when you pick her up with your hand.
				PRINTFORMDL You place her on your cheek so she can relax with you.
				PRINTFORMDW She's a bit annoyed and embarrassed, but eventually comes around to the idea, snuggling up on the soft part of your cheek.
		ENDSELECT
	ENDIF

ENDIF
RETURN 1
