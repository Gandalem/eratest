;306,お腹を撫でる
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_306 ;custom code
RETURN 1

@M_KOJO_MESSAGE_COM_K71_306
CALL M_KOJO_MESSAGE_COM_K71_306_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_306_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:体型 == -5 && (TALENT:思慕 || TALENT:恋慕) && RAND:2 ;custom code, added content
		CALL D_LINE
		IF TALENT:TARGET:妊娠
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL You rub Shinmyoumaru's pregnant belly.
					PRINTFORMDL There is indeed a little inchling baby growing inside her.
					PRINTFORMDL It has been to be seen to be believed.
					PRINTFORMDW But until you reached out and touched it, you couldn't truly understand its significance.
				CASE 1
					PRINTFORMDL You rub Shinmyoumaru's little pregnant belly.
					PRINTFORML 「Be very careful.」
					PRINTFORMW 「Very, VERY, careful....」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL Using one finger, you caress Shinmyoumaru's tummy.
					PRINTFORML 「Oh...okay....?」
					PRINTFORMW 「Watch that your finger doesn't move too high or too low there....」
				CASE 1
					PRINTFORMDL You rub Shinmyoumaru's little belly.
					PRINTFORMDW She just looks at with you in confusion.
