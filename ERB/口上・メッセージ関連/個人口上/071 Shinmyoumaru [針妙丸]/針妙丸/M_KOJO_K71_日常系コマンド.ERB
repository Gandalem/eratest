@M_KOJO_MESSAGE_COM_K71_301
CALL M_KOJO_MESSAGE_COM_K71_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	A = RAND:2
	;初回
	IF FIRSTTIME(301)
		PRINTFORMW 「오, 차를 좀 타주신 건가요, %CALLNAME:MASTER%?」
		PRINTFORMW 「그럼 한번 마셔보죠...」
		PRINTFORMDW 신묘마루는 당신이 준비한 차를 마시기 시작했다...
		IF TFLAG:193 == -1
			PRINTFORMW 「(기침, 기침)! 크윽... 이거 써...」
			PRINTFORMW 「우으... 너는 더 연습해야 해, %CALLNAME:MASTER%.」
		ELSE
			PRINTFORML (꿀꺽, 꿀꺽)
			PRINTFORMW 「... 응, 잘 준비했네.」
			PRINTFORMW 「차 만드는 거 꽤 잘하는구나, %CALLNAME:MASTER%.」
			PRINTFORMDW 신묘마루는 당신의 실력을 감탄하며 긍정적인 소리를 냈다.
		ENDIF
		;２回目以降
	ELSE
		IF TALENT:恋慕 && A == 0
