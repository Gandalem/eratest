@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_603 ;custom code
IF TALENT:体型 == -5 && !FIRSTTIME(603, 1)
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_603
CALL M_KOJO_MESSAGE_COM_K71_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K71_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(603)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTL 「저, 우리 손이요...?」
			PRINTW 「네... 알겠어요...」
			PRINTW (드디어 손을 잡았어... 에헤헤...)
		ELSE
			PRINTL 「오, 알겠어, 이해했어.」
			PRINTDW 신묘마루는 조금 부끄러워 보인다.
		ENDIF
	ELSE
		;custom code
		IF TALENT:体型 == -5
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 당신은 걸으면서 신명마루를 두 손으로 감싸 안는다.
				CASE 1
					PRINTFORMDW 신묘마루가 당신의 어깨에 타고 있고 손으로 그녀가 떨어지지 않게 지탱하고 있다.
				CASE 2
					PRINTFORMDW 신묘마루를 상의 주머니에 넣고 그녀가 기댈 수 있도록 손을 잡아준다.
			ENDSELECT
		ENDIF
		IF TALENT:恋人
		ELSEIF TALENT:恋慕
		ELSEIF TALENT:思慕
		ELSE
		ENDIF
	ENDIF
ENDIF
RETURN 1
