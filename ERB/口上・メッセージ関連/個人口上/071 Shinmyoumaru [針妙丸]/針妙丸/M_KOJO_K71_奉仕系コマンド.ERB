@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_82
IF TALENT:体型 == -5 && !CFLAG:睡眠
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_82
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF TALENT:体型 == -5
		IF FLAG:70
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMDW 당신은 신묘마루를 아래로 누르고 당신의 성기를 그녀의 가슴에 밀어붙인다.
				CASE 0
					PRINTFORMDW 당신은 신묘마루를 아래로 누르고 당신의 %TINKO_TR(MASTER)%으로 그녀의 가슴을 밀어붙인다.
			ENDSELECT
		ELSEIF NOWEX:PLAYER:射精
			IF NOWEX:PLAYER:射精量 > 100
				PRINTFORMDL 신묘마루의 작고 귀여운 유두에 비비자, 달콤한 안도감을 향한 욕정이 한계를 넘는 것을 느낀다.
				PRINTFORMDL 그것을 참지 못하고, 두꺼운 정액을 그녀의 상반신 전체에 뿌린다.
				PRINTFORMDL %TNAME(TARGET, 1)% 그 두껍고 점성이 있는 것을 경이롭게 바라본다.
				PRINTFORMDW 그것은 고집스럽게 중력의 영향을 거부하며 대신 하얀 따뜻한 스웨터처럼 그녀에게 달라붙는다.
			ELSE
				PRINTFORMDL 신묘마루의 작고 작은 유두에 비비자, 스스로 한계에 다다르고 있음을 느낀다.
				PRINTFORMDL 당신은 그녀의 상체에 직접 사정한다.
				PRINTFORMDW %TNAME(TARGET, 1)% 그것이 천천히 몸을 타고 내려가는 느낌에 몸을 떨었다.
			ENDIF
		ELSE
			SELECTCASE IFRAND("1TO2", 1, "2", ABL:マゾっ気 > 2)
				CASE 2
					PRINTFORMDL 너는 신묘마루를 꽉 붙잡고 온몸을 사용해 자위한다.
					IF TALENT:バストサイズ > 0
						PRINTFORMDW 당신이 그녀에게 몸을 비비자, 그녀는 불균형하게 큰 가슴으로 당신의 성기를 감싸 완전히 삼킨다.
					ELSE
						PRINTFORMDW 그녀에게 몸을 비비자, 당신은 그녀의 작은 가슴에 의해 계속해서 성기가 간지러움을 느낀다.
					ENDIF
				CASE 1
					PRINTFORMDL 신명마루를 손에 들고 그녀의 가슴에 자신의 성기를 위아래로 밀어붙이기 시작한다.
					IF TALENT:バストサイズ > 0
						PRINTFORMDW 그녀의 과장된 가슴에서 오는 압박감은 엄청나다.
					ELSE
						PRINTFORMDW 그녀의 작은 가슴을 건드릴 때마다 뒤로 내려가기 시작한다.
					ENDIF
				CASE 0
					IF TALENT:バストサイズ > 0
						PRINTFORMDL 당신은 신묘마루에게 필요한 공간을 주기 위해 땅에 눕는다.
						PRINTFORMDW 그녀는 자신의 큰 가슴으로 당신의 성기를 감싸고 능숙하게 위아래로 움직이며 모든 것을 만족시킨다.
					ELSE
						PRINTFORMDL 당신은 그녀의 가슴에 거시기를 밀어붙인다.
						PRINTFORMDW 그녀의 작은 유두에 맞추기가 상당히 어렵기 때문에, 그녀는 남은 것이 갈 곳으로 향하도록 성기의 끝을 잡고 안내하며 도움을 준다.
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
