@M_KOJO_MESSAGE_COM_K71_81
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:時間停止
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	IF FLAG:70
		IF TALENT:体型 == -5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL 신묘마루의 혀를 잡아 빼내고 그녀의 몸을 붙잡은 후 당신의 성기 위로 문지른다.
					PRINTFORMDW 어떤 부분이 가장 기분 좋은지 알아내려고 그녀의 혀를 다른 부위로 움직이는 것이 거의 치료가 되는 기분이 들었다.
				CASE 1
					PRINTFORMDW 당신은 신묘마루의 혀를 잡아 자신의 분비샘 끝을 따라 움직였다.
			ENDSELECT
		ENDIF
	ELSE
		IF TALENT:体型 == -5
			IF ABL:舌 < 3 || ABL:技巧 < 5
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDL 신묘마루는 정중하게 당신의 거시기를 누르며 끝을 핥았다.
						PRINTFORMDW 당신은 거의 아무것도 느끼지 못했지만, 그렇게 작은 소녀가 당신의 것을 하고 있는 광경 자체가 꽤 흥분되었다.
					CASE 1
						PRINTFORMDL 신묘마루의 작은 혀가 좋은 곳에 걸리자, 당신은 그녀에게 거기에 집중하라고 말한다.
						PRINTFORMDW 작은 부위만 건드렸음에도 꽤 기분이 좋다. 어쩌면 충분한 훈련을 거치면 신묘마루의 블로우잡이 정말 특별한 것이 될지도 모른다?
					CASE 2
						PRINTFORMDL 신묘마루는 당신의 거시기를 핥는다.
						PRINTFORMDL 그녀가 당신의 것을 그렇게 크게 보고 그것을 핥아주는 그녀의 헌신에 대해 생각한다.
						PRINTFORMDW 실제 자극은 아쉬운 부분이 있지만, 꽤 에로틱한 경험이다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:6
					CASE 0
						PRINTFORMDL 신묘마루가 손을 뻗어 당신의 성기를 핥기 시작한다.
						PRINTFORMDW 그녀의 작은 혀 표면적이 쾌감을 매우 집중되게 만든다.
					CASE 1
						PRINTFORMDW 신묘마루가 네 성기 위에 올라타 그것을 누르며, 끝부분을 핥기 시작한다.
						PRINTFORMDW 그녀는 혀를 사용해 너를 만족시키면서 몸으로 능숙하게 균형을 잡는다.
					CASE 2
						PRINTFORMDL 신묘마루가 당신의 거기를 누르고 그것을 핥는다.
						PRINTFORMDW 그녀는 혀를 내밀고 머리를 위아래로 그리고 좌우로 움직인다.
					CASE 3
						PRINTFORMDL 신묘마루는 충분한 연습을 거쳐 이제 혀를 상당히 효과적으로 사용할 수 있게 되었다.
						PRINTFORMDL 작은 혀지만, 그녀는 다른 대부분의 소녀들보다 정확한 약점을 파악했다.
						PRINTFORMDL 당신이 알지도 못했던 숨겨진 스위트 스팟을 강하게 계속 핥고 있다.
						PRINTFORMDW 당신의 머리가 녹아내리는 것 같다...
					CASE 4
						PRINTFORMDL 신묘마루의 혀가 압박점을 거의 찌르는 듯한 정밀함 아래 당신의 몸이 무너진다.
						PRINTFORMDW 너무 작으면서도 그렇게 음란하게 기분 좋게 만드는 무언가에 입에서 즐거움의 소리가 새어 나올 때, 거의 수치심을 느낀다.
					CASE 5
						PRINTFORMDL 신묘마루는 거리낌 없이 작은 혀를 네 요도 안으로 밀어 넣기 시작한다.
						PRINTFORMDL 그러고 나서 그녀는 번개처럼 빠른 속도로 혀를 휘젓기 시작했다.
						PRINTFORMDW 쾌락의 감각이 네 뇌를 압도했고, 그녀가 그것을 하는 동안 너는 다른 생각을 할 수 없었다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
