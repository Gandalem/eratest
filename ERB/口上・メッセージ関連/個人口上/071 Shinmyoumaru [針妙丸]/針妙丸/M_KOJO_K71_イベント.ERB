			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW
				ELSEIF TALENT:恋人
					PRINTFORMW
				ELSEIF TALENT:恋慕
					PRINTFORMW
				ELSEIF TALENT:思慕
					PRINTFORMW
				ELSE
					PRINTFORMW
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW
				ELSEIF TALENT:恋人
					PRINTFORMW
				ELSEIF TALENT:恋慕
					PRINTFORMW
