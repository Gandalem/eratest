@M_KOJO_SPEVENT_K71_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「... %CALLNAME:MASTER%, 잠시만 기다려 봐.」
		PRINTFORMW 「오늘 데이트 정말 즐거웠어, 알아?... 고마워.」
		PRINTFORMW 신묘마루는 말을 하면서 고개를 떨구고 긴장한 듯했다.
		PRINTFORML 당신은 그녀에게, 혹시 무슨 고민이라도 있다면 나한테 말해줘. 라고 말했다.
		PRINTFORMW 고개를 들며, 신묘마루는 계속해서 이야기를 이어나갔다.
		PRINTFORMW 「너 정말 친절하다 %CALLNAME:MASTER%. 나 같은 작은 애에게 다가와 주다니...」
		PRINTFORMW 「생각해 봤는데... 키 차이도, 나이 차이도... 이건 정말 큰 장벽들이야.」
		PRINTFORMW 「... 하지만 너는 달라, %CALLNAME:MASTER%. 내가 생각했던 이 모든 장벽들을, 아무렇지도 않게 완전히 부숴버렸어.」
		PRINTFORMW 「있지, %CALLNAME:MASTER%? 부탁할 게 있어.」
		PRINTL
		WAIT
		PRINTFORMDW 숨을 죽인 채 그녀의 감정을 들을 준비를 한다.
		PRINTL
		PRINTFORMW 「나의 연모를 받아주겠니?」
		PRINTFORMDW 신묘마루는 아무런 움직임 없이 당신을 응시한다.
		PRINTL
		PRINTFORMW 「괜찮아...?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDW 신묘마루의 눈이 크게 떠졌다.
		PRINTFORMW 「... 정말로? 내 연모에 응답해 줄 거야..?」
		PRINTFORMDW 너는 그녀의 입술을 빼앗아 감정을 확신시키고, 그녀도 그에 보답했다.
		WAIT
		PRINTFORML 
		PRINTFORMDW 긴 키스 끝에 두 사람의 입술이 떨어졌다.
		PRINTFORMW 「... 고마워, %CALLNAME:MASTER%, 사랑해...!」
		PRINTFORMDW 눈가에 눈물을 머금은 채 그녀는 작은 몸의 모든 힘을 다해 당신을 끌어안았다.
		PRINTFORMW 「지금부터 난 당신에게 맡길게, %CALLNAME:MASTER%!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「알겠다...」
		PRINTFORMW 「하지만 그래도, 그 장벽들을 허물어줘서 고마워.」
		PRINTFORMDW 그녀는 그리고 당신보다 앞서 걸어가기 시작했다.
		PRINTFORMDW 마치 자신의 표정을 보여주지 않으려는 것처럼...
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K71_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:恋人
			PRINTFORMW 「나는 %조사처리(CALLNAME:MASTER,"와")% 함께 더 많은 곳을 여행하고 싶어.」
			PRINTFORMDW 그건 이기적이지 않아? 신묘마루를 보며 웃으면서 말한다.
			PRINTFORMW 「괜찮지 않아? 약속했잖아!」
			PRINTFORMDW 그녀는 얼굴 가득 빛으로 말했다.
			PRINTFORMW 「... 나는 %조사처리(CALLNAME:MASTER,"와")% 함께 세상에 대해 더 알고 싶어.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「오늘 많이 걸었네～」
			PRINTFORMDW 신묘마루가 당신을 보며 미소 짓는다.
			PRINTFORMW 「... 다음엔 어디로 데려갈지 궁금하다?」
		ELSE
			PRINTFORML 「오늘 즐거웠어, %CALLNAME:MASTER%.」
			PRINTFORMDW 신묘마루는 가볍게 고개를 숙이며 살짝 걸어而去한다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
