;==================================================

@M_KOJO_EVENT_K71_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		IF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%—! 방금 당신을 찾고 있었어요!」
			PRINTFORMDW 신묘마루는 당신을 보자 전속력으로 달려온다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「야아~ 나야 %CALLNAME:MASTER%~! 여기서 뭐 하고 있어?」
			PRINTFORMDW 신묘마루가 당신을 다정하게 보고 있다...
		ELSEIF TALENT:思慕
			PRINTFORML 「아... %CALLNAME:MASTER%. 무슨 일이야?」
			PRINTFORMDW 신묘마루는 무언가 생각에 잠긴 것 같다.
		ELSE
			PRINTFORMW 「아, %조사처리(CALLNAME:MASTER,"가")% 아니신가. 내가 해드릴 수 있는 일이 있나?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORML 「오, 여기 있었네, %CALLNAME:MASTER%. 너 찾고 있었어~」
		ELSEIF TALENT:恋慕
			PRINTFORML 「아, %CALLNAME:MASTER%이구나. 안녕~!」
		ELSE
			PRINTFORML 「방해해서 죄송합니다.」
		ENDIF
		PRINTFORMDW 신묘마루는 느리고 꾸준한 걸음으로 걷고 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;朝起きたとき（おはよう口上）
;==================================================

