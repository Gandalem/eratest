;RETURN -1で強制失敗、RETURN 1で強制成功

@M_KOJO_EVENT_K71_26_1(ARGS)
#DIM 補正値
IF ARGS == "どうぞそのまま"
	;peep show?
	RETURN 0
ELSEIF ARGS == "二人で"
	IF TALENT:恋慕
		PRINTFORML 「알고 있어...」
		PRINTFORML 「하지만 요즘 자꾸 보이지 않아서...」
		PRINTFORML 「그냥 부탁하기가 조금 어렵네...」
		PRINTFORML 「솔직히 말할게...」
		PRINTFORMDL 당신은 그녀에게 자신이 비이성적이라고 설명한다.
		PRINTFORML 「당신이 나타나길 바라면서 소리를 많이 냈는데...」
		PRINTFORMDL 만약 그럴 생각이 있었다면, 단지 물어보면 되었을 텐데.
		PRINTFORMDL 그리고 아무 말도 하고 싶지 않았다면, 행동하면 됐을 테니.
		PRINTFORMDL 하지만 지금 네가 여기 있으니, 그녀를 바로잡아주고 원하는 바를 들어주는 게 좋겠어.
		RETURN 1
	ELSE
		PRINTFORMDL [\@ K71_LIVES_IN_CAGE() ? 얼굴을 움직이는 것 # 가까이 걸어가는 것 \@], 너는 그녀가 느끼는 똑같은 고통을 느끼고 있음을 분명히 한다.
		PRINTFORMDL 기분이 나아질 수 있는 유일한 방법은 협력하는 것이다.
	ENDIF
	PRINTFORMDL 신묘마루는 여전히 약간 주저하는 듯하다.
	PRINTFORMDL 기적의 망치를 사용하는 것을 제안할까?
	CALL ASK_YN
	IF !RESULT
		TCVAR:390 = 1
		RETURN 0
	ELSE
		TCVAR:390 = 0
		IF TALENT:恋慕 || (ABL:マゾっ気 > 2 && EXP:Ｖ拡張経験 > 25) ;check if experienced
			RETURN 0
		ELSE
			RETURN -1 ;automatically fails
		ENDIF
	ENDIF
ENDIF
