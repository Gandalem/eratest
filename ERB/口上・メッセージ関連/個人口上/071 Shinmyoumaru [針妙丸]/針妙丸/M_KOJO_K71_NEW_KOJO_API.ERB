@KOJO_CUSTOM_TALENT_SET_K71
;Zは素質ID、0~29に対応
;この変数が0でなければ表示
CUSTOM_TALENT:0 = EXP:Ｖ拡張経験 >= 100
;素質名
IF EXP:Ｖ拡張経験 >= 200
	CUSTOM_TALENT_NAME:0 = Super Stretchy
	CUSTOM_TALENT_HTML_DESC:0 = Due to her extremely flexible body, she feels no discomfort from even the largest penises.
ELSE
	CUSTOM_TALENT_NAME:0 = Stretchy
	CUSTOM_TALENT_HTML_DESC:0 = A highly flexible body allows Shinmyoumaru to take even large penises inside of her.
ENDIF
;(省略可)カスタム素質の表示色、0/通常 1/ピンク 2/赤色+太字
CUSTOM_TALENT_COLOR:0 = 2
;(省略可)表示するカテゴリ 1/種族 2/性的特徴 3/身体的特徴 4/精神的特徴 5/技術的特徴 他は「その他」
CUSTOM_TALENT_TYPE:0 = 2

@M_KOJO_EXTRASOURCE_SCOM_K71_GENERAL
CALL M_KOJO_EXTRASOURCE_COM_K71_GENERAL

@M_KOJO_EXTRASOURCE_COM_K71_GENERAL
IF GROUPMATCH(SELECTCOM, 79, 270, 271, 272, 273, 274) && EXP:Ｖ拡張経験 >= 200
	DOWNBASE:体力 = MIN(DOWNBASE:体力, 50)
	DOWNBASE:気力 = MIN(DOWNBASE:気力, 40)
	SOURCE:PLAYER:快Ｃ += 300
	SOURCE:快Ｖ += 450
ENDIF
