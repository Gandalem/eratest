@M_KOJO_MESSAGE_CUSTOM_COM_K71_17
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	IF TALENT:体型 == -5 ;custom code
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 수박을 머리 위에 들고 있는 것처럼 신묘마루가 당신의 고환 중 하나를 전부 핥기 시작한다.
			CASE 1
				PRINTFORMDL 당신의 고환 중 하나를 붙잡고 신묘마루가 그것을 핥기 시작한다.
				PRINTFORMDW 아기 같은 포옹은 당신의 고환을 만지기에 완벽한 강도이다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
