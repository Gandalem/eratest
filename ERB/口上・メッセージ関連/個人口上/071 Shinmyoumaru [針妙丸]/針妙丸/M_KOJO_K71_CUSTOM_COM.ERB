@M_KOJO_MESSAGE_MESSAGECHECK_CUSTOM_COM_K71_16
IF TALENT:体型 == -5
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_CUSTOM_COM_K71_16
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	IF TALENT:体型 == -5 ;custom code
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDL 당신은 신묘마루의 배에 거기를 대고 앞뒤로 움직였다.
				PRINTFORMDW 놀랍게도 그녀는 마치 배를 마사지 받는 것처럼 그 경험을 편안해하는 것 같았다.
			CASE 1
				PRINTFORMDL 당신은 신묘마루의 배 위로 자신의 성기를 문지른다.
				PRINTFORMDW 그 행위는 크기의 선정적인 차이를 보게 하여 당신을 더욱 자극한다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

@M_KOJO_MESSAGE_MESSAGECHECK_CUSTOM_COM_K71_17
