	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF TALENT:体型 == -5
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDL 당신은 신묘마루가 당신의 샤프트를 작업하는 것을 더 잘 보기 위해 몸을 숙인다.
				PRINTFORMDW 그녀가 일하는 동안, 당신은 편안함을 느끼기 위해 그녀의 몸을 문지른다.
			CASE 1
				PRINTFORMDW 당신은 신묘마루의 머리카락을 쓰다듬으며 그녀가 당신의 성기를 돌보는 동안 위로를 받는다.
		ENDSELECT
	ENDIF
ENDIF
