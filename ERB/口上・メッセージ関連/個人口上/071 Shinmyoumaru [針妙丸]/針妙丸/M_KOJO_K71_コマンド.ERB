;90,アナル愛撫される
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_90
IF TALENT:体型 == -5
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_90
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	IF TALENT:体型 == -5
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 민소마루는 부끄러울 정도로 헌신적인 모습을 보이며 손으로 당신의 항문을 마사지하기 위해 불편할 정도로 가까이 다가간다.
			CASE 1
				PRINTFORMDW 신묘마루가 당신의 항문 가장자리를 마사지하기 위해 불편할 정도로 가까이 다가왔다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;91,アナル舐めされる
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K71_91
IF TALENT:体型 == -5
	DRAWLINE
	RETURN 1
ENDIF
RETURN 0

@M_KOJO_MESSAGE_COM_K71_91
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	IF TALENT:体型 == -5
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 신묘마루는 그녀의 머리 전체를 당신의 항문에 넣은 채 당신의 항문을 핥기 시작한다.
			CASE 1
				PRINTFORMDL 신묘마루가 당신의 항문 가장자리를 핥기 시작한다.
				PRINTFORMDW 그녀는 원을 그리며 시작하지만 중심을 통과하며 교차하는 움직임으로 바꾼다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
