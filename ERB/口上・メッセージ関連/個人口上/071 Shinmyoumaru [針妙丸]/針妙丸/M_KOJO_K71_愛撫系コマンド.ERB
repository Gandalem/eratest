@M_KOJO_MESSAGE_COM_K71_11
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF TALENT:体型 == -5
			IF TALENT:バストサイズ > 0
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMDL 너는 신묘마루의 큰 가슴을 빨고 있다.
						PRINTFORMDW 그녀가 이런 거대한 걸 가지고 다니는 건 정말 대단하다.
					CASE 1
						PRINTFORMDL 당신은 그녀의 큰 가슴 한 줌을 잡고 신묘마루의 유두를 빨아먹는다.
						PRINTFORMDW 그것들은 당신이 가슴 전체를 입에 넣을 수 있을 만큼 크다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMDL 신묘마루의 유두 하나씩 빨기가 힘들다는 것을 알고, 한 번에 두 개를 빨기로 결정한다.
						PRINTFORMDW 몸에서 떨어지자 방금 수행한 흡입력 때문에 가슴에 멍처럼 붉은 자국이 남아있는 것이 보인다.
					CASE 1
						PRINTFORMDL 당신은 신묘마루를 붙잡은 채 입으로 아주 작은 구멍을 만들고 그녀의 유두 중 하나를 빨았다.
						PRINTFORMDW 그녀의 얼굴에 매우 가까이 다가가니, 이 느낌이 강렬할 것이라는 것을 알 수 있었다...
					CASE 2
						PRINTFORMDL 당신은 신묘마루의 작은 유두를 핥는다. 그녀의 납작한 가슴을 핥는 것은 기분 좋은 느낌이다.
						PRINTFORMDW 이내 당신은 추가적인 보너스로 혀 위에 있는 그녀의 작고 조약돌 같은 유두들을 느끼기 시작한다.
					CASE 3
						PRINTFORMDL 신묘마루의 작은 유두를 핥기 시작한다. 그녀가 너무 작아서, 혀를 조금 이리저리 움직인다.
						PRINTFORMDW 혀를 목 쪽으로 옮기자 신묘마루가 기분 좋은 골골거림을 흘린다.
					CASE 4
						PRINTFORMDL 너는 신묘마루의 작고 작은 유두를 핥기 시작한다. 그녀가 워낙 작아서, 너는 혀를 조금 자유롭게 움직인다.
						PRINTFORMDL 너는 혀를 배꼽으로 내리고 원을 그리며 핥는다.
						PRINTFORMDW 신묘마루는 네가 그렇게 하는 것이 기분 좋고 간지럽다고 말한다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
