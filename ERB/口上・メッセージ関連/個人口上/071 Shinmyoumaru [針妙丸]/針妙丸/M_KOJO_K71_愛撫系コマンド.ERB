@M_KOJO_MESSAGE_COM_K71_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;時姦中
	IF FLAG:70
		IF TALENT:体型 == -5
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 어떤 공감도 없이 순전히 호기심만으로, 당신은 자신의 손가락이 신묘마루의 작은 구멍까지 얼마나 깊이 들어갈 수 있는지 보려고 시도한다.
				CASE 1
					PRINTFORMDL 신묘마루를 들어 올리고 그녀의 구멍을 손가락으로 건드린다.
					PRINTFORMDW 이렇게 얼어붙은 모습이면, 정말 인형 그 이상도 이하도 아닌 것 같다.
				CASE 2
					PRINTFORMDL 당신은 작은 얼어붙은 인형의 손가락을 넣는다.
					PRINTFORMDW 신묘마루는 완전히 저항할 수 없었기에, 당신은 그녀의 보지를 가지고 놀면서 거칠게 대한다.
			ENDSELECT
		ENDIF
		RETURN 1
	ELSE
		IF TALENT:体型 == -5
			IF TEQUIP:バイブ
				IF TALENT:体型 == -5
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL 당신은 진묘마루의 몸속으로 바이브레이터를 더 깊이 밀어 넣는다.
							PRINTFORMDW 그녀의 온몸이 작은 몸을 통해 전해지는 진동에 경련한다.
						CASE 1
							PRINTFORMDL 당신은 진동기를 넣었다 빼며 움직였다.
							PRINTFORMDW 그 진동이 신묘마루의 온몸을 타고 흐르며 그녀의 신음까지 영향을 미쳤다.
					ENDSELECT
				ENDIF
			ELSE
				SELECTCASE IFRAND("0TO1", EXP:Ｖ拡張経験 < 25 || GETPALAMLV(PALAM:潤滑,15) < 3 , "2TO3", EXP:Ｖ拡張経験 >= 25 && (EXP:Ｖ拡張経験 < 50 || GETPALAMLV(PALAM:潤滑,15) < 5) , "4TO8", EXP:Ｖ拡張経験 >= 50 && GETPALAMLV(PALAM:潤滑,15) >= 3)
					CASE 0
						PRINTFORMDL 놀랍지 않게도, 당신의 손가락은 그곳에 들어가기 힘들어한다...
						PRINTFORMDW 큰 인내심을 가지고, 당신은 더 깊숙이 부드럽게 밀어 넣는다.
					CASE 1
						PRINTFORMDL 신묘마루를 다치지 않게 조심하며 손가락을 천천히 그녀의 안으로 밀어 넣는다.
						PRINTFORMDW 지금은 첫 번째 손가락 마디까지만 들어갈 수 있다.
					CASE 2
						PRINTFORMDL 당신은 어린 애를 손가락으로 만지기 시작한다.
						PRINTFORMDL 그녀는 여전히 매우 타지만, 당신은 정말로 더 넓히고 싶다.
						PRINTFORMDL 두 개의 손가락으로는 너무 좁다...
						PRINTFORMDL Ah!
						PRINTFORMDL 당신은 엄지손가락으로 전환한다.
						PRINTFORMDW 갑작스러운 둘레의 증가는 신묘마루를 허를 찔렀고 그녀는 목소리를 내게 만들었다.
					CASE 3
						PRINTFORMDW 당신은 그 작은 어린아이의 구멍에 손가락을 밀어 넣고 그녀의 속을 마사지하기 시작한다.
					CASE 4
						PRINTFORMDL 당신이 그 안으로 손가락을 움직이자 작은 구멍에서 축축한 소리가 울려 퍼진다.
						PRINTFORMDW 당신은 무의식적으로 얼마나 더 깊이 들어갈 수 있는지 알아내려고 노력하기 시작한다...
					CASE 5
						PRINTFORMDW 신명마루를 손에 들고 그녀의 손가락으로 만지자 네 손바닥 위로 많은 연모즙이 흘러내리는 것을 본다.
					CASE 6
						PRINTFORMDL 당신은 신묘마루의 손가락질을 시작한다.
						PRINTFORMDW 그녀에게 그렇게 많은 네 손가락이 들어가는 것을 보는 것은 거의 충격적이다.
					CASE 7
						PRINTFORMDW 당신은 손가락으로 그 작은 구멍을 때린다. 그녀는 작을지 모르지만, 당신의 깊숙한 곳에서의 접촉을 받아들이는 데 더 능숙해졌다.
					CASE 8
						PRINTFORMDL 당신은 신묘마루의 내부에 손가락을 넣는다. 
						PRINTFORMDW 한때 완전히 임신 불가능했던 곳에, 이제 당신의 손가락은 작은 아기에게 어떤 고통도 주지 않고 편안하게 드나든다.
				ENDSELECT
				;add points to v expansion and masochism
				SIF EXP:Ｖ拡張経験 < 100
					EXP:Ｖ拡張経験 ++
				SIF ABL:マゾっ気 <= 3
					EXP:苦痛快楽経験 += 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
