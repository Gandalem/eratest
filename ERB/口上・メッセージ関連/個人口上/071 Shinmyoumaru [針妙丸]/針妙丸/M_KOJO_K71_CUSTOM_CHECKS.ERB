;determines if a specific event/command has timestop dialogue
;overrides CFLAG:時間停止口上有
@M_KOJO_K71_TIMESTOP_ALLOWED(ARGS, ARG, ARGS:1)
SELECTCASE ARGS
    CASE "COM"
        SIF GROUPMATCH(ARG, 1, 3, 79, 80, 81, 83, 85, 140, 270, 271, 273, 274, 312)
            RETURN 1
    CASE "SCOM"
    CASE "CUSTOM_COM"
    CASE "CUSTOM_SCOM"
    CASE "EVENT"
    CASE "PALAM"
    CASE "COUNTER"
    CASE "COM_ASSISTANT"
    CASE "SCOM_ASSISTANT"
    CASE "CUSTOM_COM_ASSISTANT"
    CASE "CUSTOM_SCOM_ASSISTANT"
ENDSELECT
RETURN 0
