@M_KOJO_MESSAGE_COM_K56_60
CALL M_KOJO_MESSAGE_COM_K56_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K56_60_1
;-------------------------------------------------
;立位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && TFLAG:193
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			PRINTFORMW 
			RETURN 0
		ELSE
			PRINTFORMW 
			RETURN 0
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 0
		ELSE
			PRINTFORMW 
			RETURN 0
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 0
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 0
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 0
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 0
	ENDIF
ENDIF
;-------------------------------------------------
;正常位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 미코를 정면으로 범하기 시작했다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 미코의 비부에 음경을 삽입하기 시작했다.
			;処女
		ELSEIF TCVAR:破瓜 == 1
			PRINTFORMW 「저기... 그게...」
			PRINTFORMW 「처음이니까... 모르겠지만...」
			PRINTFORMW 「상냥하게 해줘, 응...?」
			PRINTFORMDW 그렇게 말하며 미코는 몸을 맡겼다.
		ELSE
			PRINTFORMW 「음...」
			PRINTFORMW 「와줘...%CALLNAME:MASTER%...」
			PRINTFORMDW 그 은밀한 곳에 %조사처리(CALLNAME:MASTER,"의")% 음경이 천천히 삽입되어 갔다...
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			;前回射精した
		ELSEIF TCVAR:102
			IF RAND:3 == 0
				PRINTFORMW 「아...%UNICODE(0x2665) *1%」
				PRINTFORMW 「윽...앗...%UNICODE(0x2665) *1%...%CALLNAME:MASTER%...%UNICODE(0x2665) *1%」
				PRINTFORMDW 미코는 교성(嬌聲)을 내고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응읏…%UNICODE(0x2665) *1%…아앗…%UNICODE(0x2665) *1%」
				PRINTFORMW 「야한 거어…%UNICODE(0x2665) *1%…좀 더 줘…%UNICODE(0x2665) *1%」
				PRINTFORMDW 미코는 격렬한 행위에 헐떡이고 있다.
			ELSE
				PRINTFORMW 「아앗…%UNICODE(0x2665) *1%…응읏…%UNICODE(0x2665) *1%」
				PRINTFORMW 「으앗…%UNICODE(0x2665) *1%」
				PRINTFORMDW 미코는 격렬한 행위에 숨을 헐떡이고 있다.
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응읏…%UNICODE(0x2665) *1%…아앗…%UNICODE(0x2665) *1%」
				PRINTFORMW 「응앗…%UNICODE(0x2665) *1%…히앗…%UNICODE(0x2665) *1%」
				PRINTFORMDW 미코는 행위에 신음하고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「히앗…%UNICODE(0x2665) *1%…응큿…%UNICODE(0x2665) *1%」
				PRINTFORMW 「앗…%UNICODE(0x2665) *1%…또…%UNICODE(0x2665) *1%」
				PRINTFORMDW 미코는 격렬한 행위에 헐떡이고 있다.
			ELSE
				PRINTFORMW 「앗……%UNICODE(0x2665) *1%……응읏……%UNICODE(0x2665) *1%」
				PRINTFORMW 「더……%UNICODE(0x2665) *1%……많이……%UNICODE(0x2665) *1%」
				PRINTFORMDW 미코는 격렬한 행위에 신음하고 있다.
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 미코를 정면으로 범하기 시작했다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 미코의 비부에 음경을 삽입하기 시작했다.
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMDW 미코의 가느다란 팔을 붙잡고, 깔아뭉개듯 밀어붙여 삽입했다.
		PRINTFORMDW 미코는 저항하는 기색을 보이지 않고, 자신의 암구에 %조사처리(CALLNAME:MASTER,"를")% 받아들였다.
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「앗…%UNICODE(0x2665) *1%…ん…%UNICODE(0x2665) *1%」
			PRINTFORMW 「%CALLNAME:MASTER%…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽...응아...%UNICODE(0x2665) *1%」
			PRINTFORMW 「...좋아해...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아...」
			PRINTFORMW 「내놔...%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 괜찮지만...」
			PRINTFORMW 「아프게 하지 말아줘?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...와줘...」
		ELSE
			PRINTFORMW 「이거... 으음...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
