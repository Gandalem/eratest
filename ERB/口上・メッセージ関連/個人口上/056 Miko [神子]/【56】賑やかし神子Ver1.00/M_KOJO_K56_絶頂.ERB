; Modular ERB: 個人口上/056 Miko [神子]/【56】賑やかし神子Ver1.00/M_KOJO_K56_絶頂.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:Ｃ絶頂～3 CVAB絶頂
;NOWEX:Ｍ絶頂 二重絶頂
;NOWEX:二重絶頂 四重絶頂
;NOWEX:噴乳 噴乳
;NOWEX:射精 射精
;NOWEX:放尿 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K56
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 「말도 안 돼...!? 가슴이 나오고 있어%UNICODE(0x2665)%」
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		PRINTFORMW 「하으...!? 어앗 %UNICODE(0x2665)% 흡오오오오오오옷」
		PRINTFORMDW 야수 같은 비명을 지르며 절정에 이른 미코는 온갖 체액을 흘리며 무너져 내렸다.
		PRINTFORMW 「아아... %UNICODE(0x2665)% 아아... %UNICODE(0x2665)%」
		PRINTFORMDW 사고를 빼앗길 정도의 강한 쾌락을 맛보고, 반쯤 벌린 입에서는 이성을 잃은 신음소와 침이 흐트러지게 흘러내리고 있었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:四重絶頂
			;Ｃ＆Ｖ＆Ａ＆Ｂ絶頂
			CASE 1
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ａ＆Ｍ絶頂
			CASE 2
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ｂ＆Ｍ絶頂
			CASE 3
				PRINTFORMW 「야아…%UNICODE(0x2665)% 온다…온다%UNICODE(0x2665)% 아 아%UNICODE(0x2665)%」
				PRINTFORMDW 질 내에 받아들이면서 민감한 부분을 끈적하게 쓰다듬어지자, 미코는 몸을 파르르 떨었다.
				PRINTFORMW 「아히야아앗!? 큭하, 끄 아아아앙%UNICODE(0x2665)%」
				PRINTFORMDW 마지막으로 단단히 끌어안고 질 깊숙이 페니스를 힘차게 박자 결합부에서 파도가 터져 나오며 미쳐버렸다.
				RETURN 1
				;Ｃ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 4
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 5
				PRINTFORMW 
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:三重絶頂
			;Ｃ＆Ｖ＆Ａ絶頂
			CASE 1
				PRINTFORMW 
				RETURN 1
				;Ｂ＆Ｖ＆Ａ絶頂
			CASE 2
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｂ＆Ａ絶頂
			CASE 3
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ｂ絶頂
			CASE 4
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ｍ絶頂
			CASE 5
				PRINTFORMW 
				RETURN 1
				;Ｂ＆Ｖ＆Ｍ絶頂
			CASE 6
				PRINTFORMW 
				RETURN 1
				;Ａ＆Ｖ＆Ｍ絶頂
			CASE 7
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｂ＆Ｍ絶頂
			CASE 8
				PRINTFORMW 
				RETURN 1
				;Ａ＆Ｂ＆Ｍ絶頂
			CASE 9
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ａ＆Ｍ絶頂
			CASE 10
				PRINTFORMW 
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:二重絶頂
			;Ｃ＆Ｖ絶頂
			CASE 1
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ａ絶頂
			CASE 2
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ａ絶頂
			CASE 3
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｂ絶頂
			CASE 4
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ｂ絶頂
			CASE 5
				PRINTFORMW 
				RETURN 1
				;Ａ＆Ｂ絶頂
			CASE 6
				PRINTFORMW 
				RETURN 1
				;Ａ＆Ｍ絶頂
			CASE 7
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ｍ絶頂
			CASE 8
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｍ絶頂
			CASE 9
				PRINTFORMW 
				RETURN 1
				;Ｂ＆Ｍ絶頂
			CASE 10
				PRINTFORMW 
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	IF NOWEX:Ｃ絶頂
		;超強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｃ
		ELSEIF NOWEX:Ｃ絶頂 == 2
			PRINTFORMW 
			;絶頂Ｃ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;超強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｖ
		ELSEIF NOWEX:Ｖ絶頂 == 2
			PRINTFORMW 
			;絶頂Ｖ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;超強絶頂Ａ
		IF NOWEX:Ａ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ａ
		ELSEIF NOWEX:Ａ絶頂 == 2
			PRINTFORMW 
			;絶頂Ａ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;強絶頂Ｂ
		IF NOWEX:Ｂ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｂ
		ELSEIF NOWEX:Ｂ絶頂 == 2
			PRINTFORMW 
			;絶頂Ｂ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;超強絶頂Ｍ
		IF NOWEX:Ｍ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｍ
		ELSEIF NOWEX:Ｍ絶頂 == 2
			PRINTFORMW 
			;絶頂Ｍ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
ENDIF
