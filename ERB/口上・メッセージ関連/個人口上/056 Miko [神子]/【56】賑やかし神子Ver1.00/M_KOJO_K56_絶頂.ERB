	IF NOWEX:射精 && NOWEX:MASTER:11
		PRINTFORMW
		RETURN 1
		;TARGETだけ射精
	ELSEIF NOWEX:射精
		;PLAYERについてる
		IF TALENT:PLAYER & 2
			PRINTFORMW
