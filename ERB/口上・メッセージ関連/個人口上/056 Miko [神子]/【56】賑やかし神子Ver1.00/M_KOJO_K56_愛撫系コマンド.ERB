;==================================================

@M_KOJO_MESSAGE_COM_K56_0
CALL M_KOJO_MESSAGE_COM_K56_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K56_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF RAND:3 == 0
				PRINTFORML 「흐, 아아, 응, 흣……」
			ELSEIF RAND:2 == 0
				PRINTFORML 「아, 우와…… 당신 거, 움찔움찔하고 있어……」
			ELSE
				PRINTFORML 「흐으읏, 응응, 아앗, 아아…… 나와버릴 것 같아……」
			ENDIF
			PRINTFORMDW 사정의 쾌감에 몸을 맡긴 채, 가녀린 육체를 쓰다듬었다...
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「흐윽, 앙%UNICODE(0x2764)% %CALLNAME:MASTER%」
					PRINTFORMW 「기분 좋다... 더 해줘...%UNICODE(0x2764)%」
				CASE 1
					PRINTFORMW 「ん읏%UNICODE(0x2764)% あ읏%UNICODE(0x2764)% %CALLNAME:MASTER%읏、いい읏%UNICODE(0x2764)%」
					PRINTFORMW 「あん읏%UNICODE(0x2764)% %CALLNAME:MASTER%읏%UNICODE(0x2764)% しゅきぃ～읏%UNICODE(0x2764)%」
				CASE 2
					PRINTFORMW 「응읏 %UNICODE(0x2764)% 아앗 %UNICODE(0x2764)% 그만... 한꺼번에 와버릴 거야~ %UNICODE(0x2764)%」
					PRINTFORMW 「앙! %UNICODE(0x2764)% 앙! 정말 굉장해~ %UNICODE(0x2764)%」
			ENDSELECT
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 0
		ELSE
			PRINTFORMW 「아으...읏, %CALLNAME:MASTER%, 그건... 안 돼...%UNICODE(0x2764)%」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 몸을 농락당하며 간지러운 듯 몸을 비틀었다.
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 0
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 0
		;浴場
	ELSEIF BATHROOM(CFLAG:現在位置)
		IF RAND:4 == 0
			PRINTFORMDL 거품으로 미끄러지는 몸을 놓치지 않도록, 단단히 안은 채 가는 몸을 부드럽게 주무른다.
			PRINTFORMW 「햐아, 아앗! 안 돼..., 안 돼... 응응읏%UNICODE(0x2665)%」
			PRINTFORMDW 미코는 쾌감에서 벗어나려 몸을 비틀지만, 오히려 민감한 곳을 자극해 버린다.
			PRINTFORMDW 축축하고 말랑한 감촉에 흥분한 %조사처리(CALLNAME:MASTER,"는")% 그녀의 옆구리든 배든 상관없이 손으로 휘저었다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 미코와 마주 보고 서로 끌어안으며 천천히 애무한다.
			PRINTFORMDW 가느다란 몸은 젖어서 평소보다 흡착이 잘 되고, 중독되어 버린다.
			PRINTFORMW 「응...후후, 만지는 것만으로 충분해?」
			PRINTFORMDW 장난스럽게 웃는 미코의 입술을 빼앗자, 녹아내린 얼굴로 %조사처리(CALLNAME:MASTER,"의")% 가슴팍에 기대었다.
		ELSEIF RAND:2 == 0
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 미코의 몸에 거품을 잔뜩 바르고 부드럽게 주무르듯이 손을 움직였다.
			PRINTFORMW 「히으...윽, 음응, 아..., 하앗, 아아!」
			PRINTFORMDW 소리를 죽이고 신음하는 미코가 귀엽고 민감한 곳으로 손을 뻗어 집듯이 자극한다.
		ELSE
			PRINTFORMDL 미코의 등을 씻기 위해, %조사처리(CALLNAME:MASTER,"는")% 그녀의 뒤로 돌아갔다.
			PRINTFORMDW 목덜미부터 어깨, 골반부터 엉덩이까지 매끄럽게 뻗은 곡선에 무심코 시선을 빼앗긴다.
			PRINTFORMDW 느릿하게 클리터를 엉덩이골에 대면서 천천히 씻어 나간다.
			PRINTFORMDW 뜨겁게 달아오른 성기를 의식한 건지, 숨결에 열기가 실린 미코의 배를 쓰다듬으며 그 손가락을 하복부로 미끄러뜨린다...
		ENDIF
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「흐윽, 그, 그렇게 열중해서 만지다니...」
				PRINTFORMW 「앗, 잠깐만요... 속도를 조절하며 애무당하다니, 그거 약해져버릴 것 같아... 흐아앗」
			CASE 1
				PRINTFORMW 「하아... %UNICODE(0x2764)% 아앗 %UNICODE(0x2764)% %CALLNAME:MASTER%윽, 음음읏%UNICODE(0x2764)%」
				PRINTFORMDW 미코는 %조사처리(CALLNAME:MASTER,"의")% 애무에 몸을 맡겼다.
			CASE 2
				PRINTFORMW 「응! %UNICODE(0x2764)% 아앗! 그럴 수는 없어~! 한 번에 와버릴 거야~ %UNICODE(0x2764)%」
				PRINTFORMDW 히부(秘部)를 가볍게 만졌을 뿐인데 미코는 몸을 크게 뒤로 젖혔다.
		ENDSELECT
		RETURN 1
	ENDIF
	;屈服3
ELSEIF MARK:不埒刻印 == 3
	PRINTFORMW 
	RETURN 0
	;それ以外
ELSE
	PRINTFORMW 
	RETURN 0
ENDIF
RETURN 1
