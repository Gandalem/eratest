		IF FIRSTTIME("ShouForeheadKiss")
			IF TALENT:[[星]]:恋人
				PRINTFORMDW Struck by a sudden impulse, you kiss Shou's brow before she can straighten.
				PRINTFORMW 「...Mmmm.」
				PRINTFORMDW Shou lets out a hum of surprised contentment as your lips grace her brow.
				PRINTFORMDW As you straighten, she turns her eyes upward, meeting your gaze.
				PRINTFORMW 「Thank you, my love.」
				PRINTFORMDW She pushes her head upwards towards your face.
				PRINTFORMW 「Would you please kiss me again?」
			ELSE
				PRINTFORMDW Struck by a sudden impulse, you kiss Shou's brow before she can straighten.
				PRINTFORMW 「...!」
				PRINTFORMDW Shou practically jumps in place, nearly ramming her head into your chin in her haste to stand up, eyes everywhere but your own.
				PRINTFORMW 「Y-You, I-I-」
				PRINTFORMDW After a few seconds of stammering, she manages to get something out.
				PRINTFORMW 「What was that for?!」
				PRINTFORMDW You apologize for being struck by a sudden impulse.
				PRINTFORMDW She blushes.
				PRINTFORMW 「W-Well, please see to it that you restrain such impulses in the future!」
			ENDIF

		ELSE
			SELECTCASE IFRAND("0TO1", 1, "2TO3", IS_FALLEN([[星]]))
				CASE 0
					IF TALENT:[[星]]:恋人
						PRINTFORML 「...Mmm.」
						PRINTFORMDW Shou slowly pulls back from your touch, smiling at you.
					ELSE
						PRINTFORML 「...!」
						PRINTFORMDW Shou pulls back, surprised by the touch of your lips.
					ENDIF

				CASE 1
					IF TALENT:[[星]]:恋人
						PRINTFORML 「Mmmm...」
						PRINTFORMDW Shou's eyes close with pleasure at the touch of your lips on her forehead.
						PRINTFORMDW She pushes her head slightly into your mouth, a deep rumbling resounding from her chest.
						PRINTFORMW 「...」
						PRINTFORMDW When you lift your lips from her brow, her eyes meet yours, filled with love.
					ELSE
						PRINTFORML 「Mmmm!?」
						PRINTFORMDW Shou's eyes widen with shock at the touch of your lips on her forehead.
						PRINTFORMDW She pulls back quickly, face flaming.
						PRINTFORMW 「...」
						PRINTFORMDW Shou looks at you, expression unreadable.
					ENDIF

				CASE 2
					IF TALENT:[[星]]:恋人
						PRINTFORMDL Shou stiffens momentarily at the feeling of your lips on her brow.
						PRINTFORMDW After a brief moment, she butts her head up into yours, ramming sharply into your nose.
						PRINTFORMDL 
						CALL RECOVER(MASTER, -20, "体力", "Headbutt")
						CALL RECOVER(MASTER, -40, "気力", "Headbutt")
						PRINTFORMDL 
						PRINTFORMDW Ow.
						PRINTFORMDL 
						PRINTFORML 「Oh! I'm so sorry, I-」
						PRINTFORMDW Laughing, you wave your lover's concerns off while you rub your nose, reassuring her that no harm was done.
					ELSE
						PRINTFORMDL Shou freezes at the feeling of your lips on her brow.
						PRINTFORMDW She breaks contact with you quickly, head shaking off your hand like it burns.
						PRINTFORMW 「...I think that it would be best for you to not repeat that action again.」
					ENDIF


				CASE 3
					IF TALENT:[[星]]:恋人
						PRINTFORMDL Shou's eyes are lidded as she pulls back from the touch of your lips%COND_STR(", ears feathered downwards adorably", TCVAR:[[星]]:K87EGG_EARS_OUT)%.
						PRINTFORMDW The expression evident as she stares into your eyes is one of love.
						PRINTFORML 「Thank you, my love.」
						PRINTFORMDW Shou dips her head in invitation.
						PRINTFORMW 「Again?」
					ELSE
						PRINTFORMDL Shou's eyes are wide as she pulls back from the touch of your lips.
						PRINTFORMDW Despite the panic evident on her face, she doesn't flee, slap you, or otherwise react.
						PRINTFORMDL The next words she mutters are so quiet you almost don't catch them.
						PRINTFORMW 「Why did that feel good?」
						PRINTFORMDW Shou shakes herself, her eyes fixing yours with a glare.
						PRINTFORMW 「...」
						PRINTFORMDW After a few seconds of silent stares, she spins on her heel and leaves.
						CFLAG:[[星]]:現在位置 = KICKOUT()
					ENDIF

			ENDSELECT
		ENDIF
	ENDIF

ENDIF
RETURN 1
