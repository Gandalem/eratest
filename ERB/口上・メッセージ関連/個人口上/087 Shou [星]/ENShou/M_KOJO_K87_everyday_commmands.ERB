@M_KOJO_EGG_MESSAGE_COM_K87_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSE
		IF IN_SHOUS_ROOM()
			SELECTCASE IFRAND("0", TALENT:[[星]]:恋慕 || TALENT:[[星]]:恋人, "1", TALENT:[[星]]:思慕 || TALENT:[[星]]:セフレ == 2, "2", 1)
				CASE 0
					PRINTFORML 「Thank you for cleaning my room.」
					PRINTFORMW 「I will repay you for your kindness when you next ask.」
				CASE 1
					PRINTFORML 「Are you cleaning my room for me?」
					PRINTFORMW 「You do not need to pamper me if you wish for any favors, be they intimate or otherwise.」
				CASE 2
					PRINTFORML 「I do not think that you need to bother yourself with cleaning my room.」
					PRINTFORMW 「Still, thank you for your efforts.」
			ENDSELECT
		ELSE
			SELECTCASE IFRAND("0TO1", (MAIN_MAP != 1 && GROUPMATCH(CFLAG:MASTER:現在位置, 110, 120, 130, 140, 150, 160, 170)) ||(MAIN_MAP == 1 && (CFLAG:MASTER:現在位置 >= 101 && CFLAG:MASTER:現在位置 < 141)), "2", 1)
				CASE 0
					PRINTFORML 「Cleanliness is one of the most important virtues one can possess.」
					PRINTFORMDW Shou picks up a broom and starts sweeping another part of the room.
					PRINTFORMW 「And we must all do our part in keeping this temple clean.」

				CASE 1
					PRINTFORML 「Stop.」
					PRINTFORMDW At Shou's words, you freeze in place, soapy cloth rag inches from the bronze statue you were about to clean.
					PRINTFORML 「The soap we use is made of lye. If you slather bronze with lye to clean it, the bronze will corrode.」
					PRINTFORMDW Shou gently plucks the cloth from your hand.
					PRINTFORMW 「Take some of the vinegar that Hijiri-sama makes from the sake Ichirin keeps smuggling in, and use that to clean the statues instead.」

				CASE 2
					PRINTFORML 「Very good.」
					PRINTFORMDW Shou examines the \@ OUTROOF(CFLAG:MASTER:現在位置) ? area # room\@ the two of you have just cleaned, her smile satisfied.
					PRINTFORMW 「To see the fruits of your labor is a good thing, is it not?」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
