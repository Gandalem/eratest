;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSE
		IF IN_SHOUS_ROOM()
			SELECTCASE IFRAND("0", TALENT:[[星]]:恋慕 || TALENT:[[星]]:恋人, "1", TALENT:[[星]]:思慕 || TALENT:[[星]]:セフレ == 2, "2", 1)
				CASE 0
					PRINTFORML 「내 방 청소해줘서 고마워.」
					PRINTFORMW 「다음에 또 부탁하면 은혜를 갚을게.」
				CASE 1
					PRINTFORML 「나를 위해 내 방을 청소해 주는 거야?」
					PRINTFORMW 「만약 어떤 호의든 원한다면, 사적인 것이든 아니든 나를 보살필 필요는 없어.」
				CASE 2
					PRINTFORML 「내 방 청소에 신경 쓸 필요는 없다고 생각해요.」
					PRINTFORMW 「그래도 노력해줘서 고마워요.」
			ENDSELECT
		ELSE
			SELECTCASE IFRAND("0TO1", (MAIN_MAP != 1 && GROUPMATCH(CFLAG:MASTER:現在位置, 110, 120, 130, 140, 150, 160, 170)) ||(MAIN_MAP == 1 && (CFLAG:MASTER:現在位置 >= 101 && CFLAG:MASTER:現在位置 < 141)), "2", 1)
				CASE 0
					PRINTFORML 「청결함은 가질 수 있는 가장 중요한 정조 중 하나이다.」
					PRINTFORMDW 쇼는 빗자루를 집어 방의 다른 부분을 쓸기 시작한다.
					PRINTFORMW 「그리고 우리는 모두 이 성전을 깨끗하게 유지하기 위해 각자의 역할을 해야 한다.」
				CASE 1
					PRINTFORML 「멈춰라.」
					PRINTFORMDW 쇼의 말에 당신은 그 자리에 굳어버리고, 비석을 닦으려던 비석에서 비누 묻은 걸이 몇 인치 앞에 놓인 채 멈춘다.
					PRINTFORML 「우리가 쓰는 비누는 잿물로 만든 것이다. 잿물을 이용해 청동에 바르면 청동이 부식될 거다.」
					PRINTFORMDW 쇼가 당신의 손에서 걸레를 조심스럽게 빼낸다.
					PRINTFORMW 「히지리님이 술로 몰래 들여오는 식초를 좀 가져와서, 그걸로 동상을 닦는 게 어떠냐.」
				CASE 2
					PRINTFORML 「아주 좋아.」
					PRINTFORMDW 쇼는 너희 둘이 방금 청소한 \@ OUTROOF(CFLAG:MASTER:現在位置) ? 지역 # 방을 만족스러운 미소를 지으며 살폈다. \@
					PRINTFORMW 「너희 노력의 결실을 보는 것은 좋은 일이지, 그렇지 않니?」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
