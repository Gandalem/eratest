@K87_RAND_MAP
#FUNCTION
#DIM RAND_MAP
RAND_MAP = RAND:9
WHILE RAND_MAP == CFLAG:MASTER:現在位置 / 100
RAND_MAP = RAND:9
WEND
RETURNF RAND_MAP

