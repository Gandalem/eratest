@NAME_SET_K87_EGG
;/見事な響子口上の丸パクだと感心するがどこもおかしくはない
;名前を入力するループ
gLineCount = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - gLineCount > 0
	CLEARLINE LINECOUNT - gLineCount
PRINTFORMDL 당신을 지칭할 때 쇼(Shou)가 사용할 이름을 입력하세요. (입력하거나 버튼을 누르세요)
IF NAME:MASTER != "Player"
	LOCALS = %NAME:MASTER%
ELSE
	LOCALS = %CALLNAME:MASTER%
ENDIF
PRINTBUTTON @"[단지 %LOCALS%뿐이다.]", @"%LOCALS%"
PRINTL 　
INPUTS
; 行頭行尾の空白文字削除
LOCALS = %RESULTS%
REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
;10文字以上は受け付けない
IF STRLENS(LOCALS) > 16
	PRINTFORMW 「...이름이 너무 긴 것 같아. 별명이나 더 짧은 걸 사용해 줄래.」
	CONTINUE
	;空白は受け付けない
ELSEIF RESULTS == ""
	PRINTDW 이름을 입력하세요.
	CONTINUE
ELSE
	PRINTFORML 「" %RESULTS% ", 그렇게 말하는 건가?」
	CALL ASK_YN
	IF RESULT == 0
		;あなたの名前を%MASTERNAME:41%に格納
		MASTERNAME:87 = %RESULTS%
		PRINTFORMDL 
		BREAK
	ELSEIF RESULT == 1
		CONTINUE
	ENDIF
ENDIF
