RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K87_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;First time
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[星]]) && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「...너 정말 도착적이구나, \@ TALENT:[[星]]:恋人 ? 나의 연모 # %MASTERNAME:87% \@.」
		PRINTFORMDW 쇼가 당신을 향해 가로지르는 표정을 짓는다.
		PRINTFORMW 「네 성기를 내 입에 넣어 기쁨을 얻으라고?」
		PRINTFORMDW 당신은 사과를 더듬거리며 하려 하지만, 그녀는 손을 들어 당신을 제지한다.
		PRINTFORMW 「진정해, \@ TALENT:[[星]]:恋人 ? 나의 연모 # %MASTERNAME:87% \@.」
		PRINTFORMW 「이게 무슨 소용인지 모르겠지만, 딱 한 번만 실험해 볼 의향은 있어.」
		PRINTFORMDW 그러고는 그녀는 당신 앞에 무릎을 꿇고 손가락으로 당신의 바지 앞부분을 더듬었다.
		PRINTFORMDW 당신은 한숨을 쉬며 그녀를 돕기 위해 아래로 손을 뻗는다.
		PRINTFORMDW 잠시 작업 후, 쇼는 당신의 성기를 입에 넣었고, 그녀의 이가 그것에 스치자 당신은 즉시 얼굴을 찡그리는 것을 참았다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
