	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Ruukoto arrives
	;る～ことが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
