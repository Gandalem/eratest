@M_KOJO_MESSAGE_COM_K87_41
CALL M_KOJO_MESSAGE_COM_K87_41_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_41_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
			;一緒に買いに行った
		ELSEIF GETBIT(CFLAG:1003,1)
			PRINTFORML 「아... 그건 지난번 마사지기였죠!?」
			PRINTFORMW 쇼의 가랑이에 전기 안마를 밀어 넣고 스위치를 누르자 그 자극에 쇼의 목소리가 터져 나왔다.
			PRINTFORMW 「가게 분이 말씀하시던 다른 사용법이 이거였나요!?」
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에 \@ TEQUIP:0 > 1 ? %SHOW_BOTTOM(TARGET)% 위에서 #  \@ 진동하는 전기 안마기를 눌렀다
			PRINTFORMW 「후, 우앗... 쿠앗...」
			PRINTFORMW 「이런, 야릇한 도구는 어디서 가져오신 거예요...?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;なんか履いてる
		IF TEQUIP:0 > 1
			IF RAND:2 == 0
				PRINTFORML 「아아......%UNICODE(0x2665)% 위에서라면......」
				PRINTFORMW 직접적인 자극이 아닌 답답함에 쇼는 허리를 흔들며 괴로워하고 있다...
			ELSE
				PRINTFORML 쇼는 두 손을 볼에 대고 쾌락으로 몸을 떨고 있다.
				PRINTFORMW 「우아앗, 떨려, 에...%UNICODE(0x2665)%」
				;潤滑4以上
				SIF PALAM:潤滑 >= PALAMLV:4
					PRINTFORMW 천을 통해 질척질척과 애액이 뒤섞이는 소리가 들려온다...
			ENDIF
			;Ｃ感覚3未満＋欲情3未満
		ELSEIF ABL:Ｃ感覚 < 3 && PALAM:欲情 < PALAMLV:3
			PRINTFORML 「후우, 후우... 아하, 조금 간지러워요.」
			PRINTFORMW 아직 마사지기의 감각에는 익숙해지지 않은 것 같다.
			;Ｃ感覚3未満＋欲情3以上
		ELSEIF ABL:Ｃ感覚 < 3 && PALAM:欲情 >= PALAMLV:3
			PRINTFORML 「아... 쿠...」
			PRINTFORMW 은밀한 곳을 격렬하게 흔들리는 감각을 조금씩 느끼고 있는 것 같다.
			;Ｃ感覚4以上＋欲情の3未満
		ELSEIF ABL:Ｃ感覚 >= 4 && PALAM:欲情 < PALAMLV:3
			PRINTFORML 「아하핫%UNICODE(0x2665)% 굉장해...%UNICODE(0x2665)%」
			PRINTFORMW 「더, 더 야한 마사지 해주세요...」
			PRINTFORMW 쇼는 마사지기에 몸을 밀어붙이듯 허리를 내밀었다...
			;Ｃ感覚4以上＋欲情3以上＋欲情5未満
		ELSEIF ABL:Ｃ感覚 >= 4 && PALAM:欲情 >= PALAMLV:3 && PALAM:欲情 < PALAMLV:5
			IF RAND:2 == 0
				PRINTFORML 「%MASTERNAME:87%、%MASTERNAME:87%…윽 강해져, 점점 와버려…읏%UNICODE(0x2665)%」
				PRINTFORMW 다리는 흐트러지게 벌어져 때때로 떠올린 듯 경련하고 있다.
			ELSE
				PRINTFORML 「%MASTERNAME:87%… 더, 강하게 해주세요…%UNICODE(0x2665)%」
				PRINTFORMW 「아후우, 아, 안! 아아… 좋아요……%UNICODE(0x2665)%」
			ENDIF
			;Ｃ感覚4以上＋欲情5以上
		ELSEIF ABL:Ｃ感覚 >= 4 && PALAM:欲情 >= PALAMLV:5
			IF RAND:3 == 0
				PRINTFORML 「흐읍%UNICODE(0x2665)%! 지금 그렇게 밀어붙이면 안 돼요, 흐읍%UNICODE(0x2665)%!」
				PRINTFORML 가벼운 절정감을 느끼고 있는 쇼에게 기세를 더해주자 몸을 격렬하게 흔들며 반응했다.
				PRINTFORMW 분출된 애액이 마사지기의 끝에 달라붙어 있었다...
			ELSEIF RAND:2 == 0
				PRINTFORML 「앙…%UNICODE(0x2665)% \@ GETBIT(CFLAG:1003,1) ? 가게 사람들이 말했던 대로…! # 멈추지 않아욧! \@ 정말 기분 좋아요%UNICODE(0x2665)%」
				PRINTFORMW 「이 배 속까지 떨리는 듯한 느낌이에요%UNICODE(0x2665)% 중독될 것 같아요%UNICODE(0x2665)%」
			ELSE
				PRINTFORML 「후아, %MASTERNAME:87%…윽 아, 쿠아아아앗%UNICODE(0x2665)%!?」
				PRINTFORMW 무의식적으로 다리를 오므려버린 쇼는 강해지는 감각에 신음을 터뜨렸다.
				PRINTFORML 「우아아아… 움직일 수 없어, 좋아……%UNICODE(0x2665)% %UNICODE(0x2665)%」
				PRINTFORMW 놀라서 굳었는지 몸이 쾌락을 놓지 않으려고 하는 건지 쇼는 다리를 오므린 채 은밀한 곳을 계속 자극당하고 있다…
			ENDIF
			;Ｃ感覚3＋欲情3未満
		ELSEIF ABL:Ｃ感覚 == 3 && PALAM:欲情 < PALAMLV:3
			PRINTFORMW 「음후... 크, 아아... 부르르...합니다%UNICODE(0x2665)%」
			;Ｃ感覚3＋欲情3以上5未満
		ELSEIF ABL:Ｃ感覚 == 3 && PALAM:欲情 >= PALAMLV:3 && PALAM:欲情 < PALAMLV:5
			PRINTFORML 「거기가 찌릿찌릿해서... %UNICODE(0x2665)% 아아... %UNICODE(0x2665)%」
			PRINTFORMW 별의 입에서는 때때로 뜨거운 한숨이 새어 나오고 있다...
			;Ｃ感覚3＋欲情5以上
		ELSEIF ABL:Ｃ感覚 == 3 && PALAM:欲情 >= PALAMLV:5
			PRINTFORML 지금이라도 절정에 달할 것 같은 모습이야...
			PRINTFORMW 「히으윽%UNICODE(0x2665)% 저쪽의 축축함이... 점점 강해지고 싶어...윽」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		;Ｃ感覚3未満
		IF ABL:Ｃ感覚 < 3
			PRINTFORMW 「하아, 음... 으응...」
		ELSE
			PRINTFORML 「거기가 찌릿찌릿해서... %UNICODE(0x2665)% 아아... %UNICODE(0x2665)%」
			PRINTFORMW 별의 입에서는 때때로 뜨거운 한숨이 새어 나오고 있다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
