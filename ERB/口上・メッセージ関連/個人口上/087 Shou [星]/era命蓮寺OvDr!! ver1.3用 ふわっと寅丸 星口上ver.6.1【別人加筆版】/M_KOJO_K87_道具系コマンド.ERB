;42,クリキャップ
;==================================================

@M_KOJO_MESSAGE_COM_K87_42
CALL M_KOJO_MESSAGE_COM_K87_42_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_42_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
			;一緒に買いに行った
		ELSEIF GETBIT(CFLAG:1003,2)
			PRINTFORML 「아, 그거 산에서 사 왔어...」
			PRINTFORML 「에? 클리에 붙여... 후잇!?」
			PRINTFORMW 달린 클리캡의 스위치를 넣자 쇼는 곧바로 몸을 움찔했다.
			IF ABL:Ｃ感覚 >= 3
				PRINTFORML 「히, 아 %UNICODE(0x2665)% 이거 굉장해욧%UNICODE(0x2665)%」
				PRINTFORML 「다른 것도 여러 가지 있었으니까... 후아아아%UNICODE(0x2665)%」
				PRINTFORMW 다양한 타입의 클리캡이 있었다는 것을 떠올린 쇼는 기대감에 몸을 떨었다
			ENDIF
		ELSE
			PRINTFORML 「클리에 붙이는 기구라니... 누가 이런 걸 생각할 수 있는 거죠...」
			PRINTFORMW 「음... 크윽, 후흡...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:クリキャップ
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			;Ｃ感覚3以上
			IF ABL:Ｃ感覚 >= 3
				IF RAND:4 == 0
					PRINTFORML 「응, 아, 크아앗%UNICODE(0x2665)%」
					PRINTFORMW 끈 같은 파츠에 별의 음핵 끝이 몇 번이고 스치고 있었다.
					PRINTFORMW 「가장 끝부분만 문지른다니... 이런 건...윽%UNICODE(0x2665)%」
				ELSEIF RAND:3 == 0
					PRINTFORML 「히우... %UNICODE(0x2665)% 빨려... 안 돼!? 」
					PRINTFORMW 빨아올려진 클리 캡을 돌기가 있는 전동 고무 캡이 맞이해 주무른다.
					PRINTFORMW 「이렇게 작은 도구에 어떻게 이렇게 기계가 있어... 우아아악 %UNICODE(0x2665)% 」
				ELSEIF RAND:2 == 0
					PRINTFORML 「아후앗%UNICODE(0x2665)% 이거, 너무 강해……에?! %MASTERNAME:87%!?」
					PRINTFORML 전동 클리캡의 강렬한 자극에 쇼는 무심코 손을 뻗지만 당신에게 손을 잡혀 빼낼 수 없다.
					PRINTFORMW 어떻게든 쾌락을 피하려 허리를 뒤로 빼도 단단히 달라붙은 클리캡의 쾌락에서 벗어날 수는 없다…
					PRINTFORMW 「아, 안 돼, %MASTERNAME:87%, 놓아줘…윽%UNICODE(0x2665)%」
				ELSE
					PRINTFORML 클리캡에 부속된 소형 브러시가 벗겨진 무방비한 육심을 끼워 문지른다.
					PRINTFORMW 「히우웅%UNICODE(0x2665)% 클리, 갈리고 있어요%UNICODE(0x2665)%」
					PRINTFORMW 쇼는 입가에서 침을 흘리며 음핵 브러시 공격에 몸부림치고 있다.
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「우아, 가운데 움직이고 있어...」
					PRINTFORMW 클리캡이 수축하는 듯한 움직임에 쇼는 몸을 비틀었다
				ELSE
					PRINTFORML 「응... 빨리고 있어... 하앗 %UNICODE(0x2665)%」
					PRINTFORMW 피부 속에서 민감한 육아를 빨려 나가면서 쇼는 작게 신음했다.
				ENDIF
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;Ｃ感覚3以上
			IF ABL:Ｃ感覚 >= 3
				IF RAND:2 == 0
					PRINTFORML 「후, 아... 격렬해...%UNICODE(0x2665)%」
					PRINTFORML 가지고 있는 것 중 가장 진동이 강한 것을 음핵에 가져다 붙였다.
					PRINTFORMW 쇼는 얼굴을 부드럽게 하며 쾌락에 신음하고 있다...
				ELSE
					PRINTFORML 「아하아%UNICODE(0x2665)% 마음껏 빨리는 거, 기분 좋아요%UNICODE(0x2665)%」
					PRINTFORMW 쇼는 비심을 빨리는 감촉에 코를 골며 소리를 냈다.
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「쿠아, 가운데 움직이고 있어...」
					PRINTFORMW 클리캡이 수축하는 듯한 움직임에 쇼는 몸을 비틀었다.
				ELSE
					PRINTFORML 「응... 빨리고 있어... 하앗 %UNICODE(0x2665)%」
					PRINTFORMW 피부 속에서 민감한 육아를 빨려 나가면서 쇼는 작게 신음했다.
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;解除
	ELSE
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
			;Ｃ感覚3以上
		ELSEIF ABL:Ｃ感覚 >= 3
			;連続
			IF PREVCOM == SELECTCOM
				PRINTFORML 「아...음...%UNICODE(0x2665)% 어? 벌써 가져가시는 건가요...?」
				PRINTFORMW 「아뇨, 가져가는 게 싫다기보다는...」
			ELSEIF RAND:3 == 0
				PRINTFORML 「후아우!」
