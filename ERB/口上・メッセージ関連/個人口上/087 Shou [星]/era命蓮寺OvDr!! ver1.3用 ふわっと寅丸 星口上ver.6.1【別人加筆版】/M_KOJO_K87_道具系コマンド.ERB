@M_KOJO_MESSAGE_COM_K87_40
CALL M_KOJO_MESSAGE_COM_K87_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
			;一緒に買いに行った
		ELSEIF GETBIT(CFLAG:1003,0)
			PRINTFORML 「그, 지금 쓰시는 건가요」
			PRINTFORML 「응응, 크... 아앗 %UNICODE(0x2665)% 」
			PRINTFORMW 로터의 진동에 쇼는 교성(嬌聲)을 울렸다...
		ELSE
			PRINTFORML 「벌써... 언제 이런 걸 사 온 거예요...? 윽」
			PRINTFORMW 꾸짖는 듯한 말투였지만 로터를 밀어붙이자 쇼는 눈썹을 찌푸리며 숨을 참았다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;ふたなり
		IF TALENT:2 == 3
			PRINTFORML 「후아, 입구... 찌릿찌릿해...윽」
			PRINTFORMW 질 입구를 더듬듯 로터를 움직이자 쇼는 떨리는 듯한 신음소리를 흘렸다.
			PRINTFORMW 비밀스러운 입술 위에서 음경이 힘차게 맥동하고 있다...
		ELSE
			;Ｃ感覚3以上
			IF ABL:Ｃ感覚 >= 3
				IF RAND:4 == 0
					PRINTFORML 「아하... 저 얼얼한 듯 기분 좋아요...%UNICODE(0x2665)%」
					PRINTFORML 쇼는 거칠게 숨을 내쉬며 감상에 젖었다.
					PRINTFORMW 게다가 음핵을 로터와 손가락으로 끼워 주무르자 비명을 지르며 몸부림쳤다.
					PRINTFORMW 「안 돼, 클리를 망치면... 히아앗%UNICODE(0x2665)%」　
				ELSEIF RAND:3 == 0
					PRINTFORML 「후우앗, 쿠아%UNICODE(0x2665)% 클리, 떨림... 격렬해%UNICODE(0x2665)%」
					PRINTFORMW 쇼의 육아는 로터의 격렬한 진동에 휘둘리고 있었다.
					PRINTFORML 「강해... %UNICODE(0x2665)% 이 이상은 하아... %UNICODE(0x2665)%」
					PRINTFORMW 로터를 놓을 때에는 그 얼굴이 완전히 풀려 있었다...
				ELSEIF RAND:2 == 0
					PRINTFORML 「히우, 아아앗%UNICODE(0x2665)% 후아, 안쪽%UNICODE(0x2665)%」
					PRINTFORMW 연속해서 몰려오는 쾌감의 파도에 쇼는 눈물을 글썽이며 몸부림치고 있다.
				ELSE
					PRINTFORML 「아아... 으아... 안 돼요... 윽%UNICODE(0x2665)%」
					PRINTFORML 「사실은 수련에 사용하는 거예요... 야한 것에 쓰는 게 아니에요... %UNICODE(0x2665)%」
					PRINTFORMW 쇼는 무언가 호소하고 있지만 흐릿하게 녹아내린 목소치 잘 들리지 않는다.
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「응, 우아... 후, 아...%UNICODE(0x2665)%」
					PRINTFORMW 로터가 음핵의 끝에 닿기만 해도 쇼는 목소리를 떨고 있다.
				ELSE
					PRINTFORML 「야앗! 그렇게 강하게 밀어붙이면...」
					PRINTFORMW 쇼는 너무 강한 자극에 고개를 저으려 안달이 났다.
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		;Ｃ感覚3以上
		IF ABL:Ｃ感覚 >= 3
			IF RAND:2 == 0
				PRINTFORML 「후우, 음, 음~~%UNICODE(0x2665)%」
				PRINTFORMW 쇼는 다문 입술을 떨면서 눈에 물기를 띠고 있다.
				PRINTFORMW 너무 강한 쾌락에 몸을 떨고 있는 듯하다...
			ELSE
				PRINTFORML 「아하, 빨리 맞춰주세요 %UNICODE(0x2665)%」
				PRINTFORMW 쇼는 당신의 손에 들린 로터를 황홀한 눈으로 바라보고 있다…
			ENDIF
		ELSE
			PRINTFORML 「뭐, 뭐야 간지러운 것 같아……히야앗」
			PRINTFORML 쇼는 가끔 작게 상기된 목소리를 내고 있다.
			PRINTFORMW 아직 강한 쾌감을 얻지는 못한 듯하지만 느끼고 있는 것은 확실해 보인다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
