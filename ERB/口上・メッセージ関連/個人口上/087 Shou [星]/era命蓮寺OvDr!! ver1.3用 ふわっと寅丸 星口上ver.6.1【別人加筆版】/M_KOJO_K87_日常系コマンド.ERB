			ENDIF
		ELSE
			;初めて
			IF CFLAG:1603 < 1
				PRINTFORMW 「? 손을 잡을까? 잘 모르겠지만 괜찮아요」
				CFLAG:1603 = 1
			ELSE
				IF RAND:3 == 0
					;/呑気
					PRINTFORMW 「친한 사이군요♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 쇼의 손은 매우 따뜻했다.
				ELSE
					PRINTFORMW 「%MASTERNAME:87%, 가시죠」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
