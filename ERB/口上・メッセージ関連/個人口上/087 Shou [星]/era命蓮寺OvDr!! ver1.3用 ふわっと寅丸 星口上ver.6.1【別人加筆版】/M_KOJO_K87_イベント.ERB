	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;仕事開始（職場へ移動する）
	;※既に本堂にいる場合は出ない
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;※現状、このタイミングではCFLAG:うふふは使用できないらしい。
		;※IF ARG:1 == -1　でうふふに入っていたかを判定できるそうなので、暫定的にそれで代用。ただし、うふふ１かうふふ２は判別できないらしい
		;うふふを中断して向かう
		;IF CFLAG:うふふ == 1
		IF ARG:1 == -1
			IF RAND:3 == 0
				PRINTFORMW 「っは、っは、%MASTERNAME:87%、仕事の時間です、行かないとばれてしまいます…」、 
			ELSEIF RAND:2 == 0 
				PRINTFORMW 「は、ああ、駄目、時間です、私、もう行かないと…」
			ELSE
				PRINTFORMW 「はあ、はあ、もう、こんな時間、ですか…私、行かないと…」
			ENDIF
			PRINTFORML 星はフラフラと立ち上がり、後始末もそこそこに仕事場に向かった
			PRINTFORMW 全身から発情した香りを漂わせたまま――
		;ELSEIF CFLAG:うふふ == 2
		;	IF RAND:3 == 0
		;		PRINTFORMW 「っは、っは、%MASTERNAME:87%、仕事の時間です、行かないとばれてしまいます…」、 
		;	ELSEIF RAND:2 == 0 
		;		PRINTFORMW 「は、ああ、駄目、時間です、私、もう行かないと…」
		;	ELSE
		;		PRINTFORMW 「はあ、はあ、もう、こんな時間、ですか…私、行かないと…」
		;	ENDIF
		;	PRINTFORML 星はフラフラと立ち上がり、後始末もそこそこに仕事場に向かった
		;	PRINTFORMW 全身から発情した香りを漂わせたまま――
		;雨天で講堂にいない
		ELSEIF GROUPMATCH(TIME:5, 4, 5, 6) && OUTROOF(CFLAG:MASTER:現在位置) ;custom code
			PRINTFORMW 「そろそろお仕事ですけど…　この雨\@ TIME:5 <= 5 ? だと傘が必要ですね # なら走ればそんなに濡れませんかね \@」
		;浴場にいる
		ELSEIF BATHROOM()
			PRINTFORMW 「よし、お風呂に入って目も覚めましたしお仕事いってきます！」
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「さて、今日のお勤め、がんばりますか！」
			ELSE
				PRINTFORMW 「おっと、もうこんな時間ですね」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック
