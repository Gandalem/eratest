@M_KOJO_EVENT_K87_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		;恋人取得後初遭遇、一回のみ
		IF TALENT:恋人 && CFLAG:1201 < 5
			;恋慕
			IF TALENT:恋慕
				;星から告白されて恋人
				IF CFLAG:1202  ==  2
					PRINTFORMW 「아, %MASTERNAME:87%…%UNICODE(0x2665)%」
					PRINTFORMW 「저기, 말할 걸 깜빡한 게 있어서요」
					PRINTFORMW 쇼는 「콜록」 하고 기침을 한 뒤, %조사처리(CALLNAME:MASTER,"의")% 눈을 똑바로 바라보며 미소 지었다.
					PRINTFORML 
