	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF RAND:3 == 0
			PRINTFORMW 「よし、今日の分、終わり！」 
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「ふー、これでよし、っと」
		ELSE
			PRINTFORMW 「終わりましたー！」
		ENDIF
		;早く終わった
		IF TIME:0 <= 1020
			;※17時より早い=手伝った　という解釈
			;※でもコマンド実行後の時間なので直前のコマンドによる時間経過で17時超えてしまうと出ない。手伝いは一回で1時間もかかるので注意
