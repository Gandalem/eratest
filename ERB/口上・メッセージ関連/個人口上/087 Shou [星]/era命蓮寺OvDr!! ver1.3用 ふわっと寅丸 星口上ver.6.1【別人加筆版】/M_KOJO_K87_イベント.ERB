	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF TALENT:恋人
			IF RAND:2 == 0
				PRINTFORMW 「아, %MASTERNAME:87%였군요... 도둑인가 싶었잖아요.」
			ELSE
				PRINTFORMW 「누에가 또 장난치러 온 건가 했지만... %MASTERNAME:87%라면 환영해 줄게요.」
			ENDIF
			;/付き合ってもないのに恋慕相手がいきなり布団の中に入ってきたら超緊張するってレベルじゃねーだろjk
		ELSE
			IF RAND:3 == 0
				PRINTFORML (엣!? 엣!? 엣!? 이거 혹시, 밤에 몰래 들어오는 거 같은데요!?)
				PRINTFORMW (우와아, 저는, 어떻게 해야 할까요!?)
			ELSEIF RAND:2 == 0
				PRINTFORML 「음~ 헤헤, %MASTERNAME:87%랑 같이 잘 수 있다니 좋은 꿈이네요~」
				PRINTFORMW 「안아주거나 해버려도 모에헤헤... 후후... 스으...」
			ELSE
				PRINTFORML 「아, 저, 그, 안녕」
				PRINTFORMW 「어, 음, 음, 저는 잘게요!」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される（衰弱）
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
