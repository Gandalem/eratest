;※※※※※※※※※※※※※※※※※※※※※※※※※※
;Custom dialogue settings, custom code
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;made it as a way to speed up the update process and separate simple flag updates from various customization options
;note: options start from 1!
@KOJO_OPTION_K87
CALL KOJO_OPTION_ITEM(@"Change the way Shou addresses you%COND_STR(@", current: %MASTERNAME:87%", MASTERNAME:87 != "")%", 1)

;process the input portion
@KOJO_OPTION_K87_RESULT_1
MASTERNAME:87 = 
LOCAL = TARGET
TARGET = 87
PRINTFORML 「Now, I'd like to hear your name if you please.」
CALL NAME_SET_K87
TARGET = LOCAL
WAIT

;custom, moved to a function
@NAME_SET_K87
gLineCount = LINECOUNT
REDRAW 0
DO
	SIF LINECOUNT - gLineCount > 0
		CLEARLINE LINECOUNT - gLineCount
	PRINTL Input a name Shou should use when referring to you. (Type it in or press a button)
	IF NAME:MASTER != "Player"
		LOCALS = %NAME:MASTER%
	ELSE
		LOCALS = %CALLNAME:MASTER%
	ENDIF
	PRINTBUTTON @"[Just %LOCALS%]", @"%LOCALS%"
	PRINTL 　
	INPUTS
	;/見事な響子口上の丸パクだと感心するがどこもおかしくはない
	; 行頭行尾の空白文字削除
	LOCALS = %RESULTS%
	REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
	;10文字以上は受け付けない
	IF STRLENS(LOCALS) > 16
		CLEARLINE 1
		PRINTFORMW 「...That sounds a bit too long. Do you happen to have an alias or nickname?」
		CONTINUE
	;空白は受け付けない
	ELSEIF RESULTS == ""
		PRINTW Input a name.
		CONTINUE
	ELSE
		; 同姓同名
		IF FLAG:なりきり != [[星]] && CONTAINS_NAME(LOCALS, "toramaru", "shou")
			PRINTFORMW 「...Ah, you must be pulling my leg.」
			CONTINUE
		; 白蓮が主人ではなく、白蓮というフレーズが含まれている。もしくは
		; 響子が主人ではなく、幽谷もしくは響子というフレーズが含まれている
		ELSEIF FLAG:なりきり != [[白蓮]] && CONTAINS_NAME(LOCALS, "byakuren", "hijiri")
			PRINTFORMW 「...Look here, that is SO disrespectful...」
			CONTINUE
		; 命蓮寺勢はじき
		; うんそうだね多々良勝五郎とか教える人もいるかもしれないもんね
		ELSEIF (FLAG:なりきり != [[ナズーリン]] && CONTAINS_NAME(LOCALS, "nazrin") || (FLAG:なりきり != [[小傘]] && CONTAINS_NAME(LOCALS, "tatara", "kogasa")) || (FLAG:なりきり != [[一輪]] && CONTAINS_NAME(LOCALS, "kumoi", "ichirin")) || (FLAG:なりきり != [[ムラサ]] && CONTAINS_NAME(LOCALS, "minamitsu", "murasa")) || (FLAG:なりきり != [[響子]] && CONTAINS_NAME(LOCALS, "kasodani", "kyouko")))
			PRINTFORMW 「...I'm afraid that's just going to cause unnecessary confusion. Could you settle for something else?」
			CONTINUE
		ELSEIF (FLAG:なりきり != [[ぬえ]] && CONTAINS_NAME(LOCALS, "nue", "houjuu")) || (FLAG:なりきり != [[マミゾウ]] && CONTAINS_NAME(LOCALS, "futatsuiwa", "mamizou"))
			PRINTFORMW 「Wha... Is this some kind of prank, perhaps?」
			CONTINUE
		; 道教勢力はじき
		ELSEIF (FLAG:なりきり != [[芳香]] && CONTAINS_NAME(LOCALS, "miyako", "yoshika")) || (FLAG:なりきり != [[青娥]] && CONTAINS_NAME(LOCALS, "kaku", "seiga")) || (FLAG:なりきり != [[屠自古]] && CONTAINS_NAME(LOCALS, "soga", "tojiko")) || (FLAG:なりきり != [[布都]] && CONTAINS_NAME(LOCALS, "mononobe", "futo")) || (FLAG:なりきり != [[神子]] && CONTAINS_NAME(LOCALS, "toyosatomimi", "shoutoku", "taishi", "miko"))
			PRINTFORMW 「A-An intruder! Where's my pagoda...?!」
			CONTINUE
		; 博麗霊夢というフレーズが含まれてる。もしくは
		; 東風谷早苗というフレーズが含まれている
		ELSEIF CONTAINS_NAME(LOCALS, "hakurei", "kochiya")
			PRINTFORMW 「From what I see of you, you are not as brash and impetuous as she is... Is that okay with you?」
			PRINTFORML
		; 霧雨魔理沙というフレーズが含まれてる。
		ELSEIF CONTAINS_NAME(LOCALS, "kirisame")
			PRINTFORMW 「You are more of a crooked laser than a straight one, I take it? ...Are you sure?」
			PRINTFORML
		; 直接入力ならいけると思ったか？弾くぜ！
		ELSEIF ABL:親密 < 4 && STRCOUNT(LOCALS, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$")
			PRINTFORMW 「You are clearly going a little too far with this...」
			CONTINUE
		ELSEIF ABL:親密 < 7 && STRCOUNT(LOCALS, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$")
			PRINTFORMW 「You are clearly going a little too far with this...」
			CONTINUE
		ELSEIF (ABL:従順 < 7 || ABL:奉仕精神 < 7) && STRCOUNT(LOCALS, "((?i)master|lord|god)$")
			PRINTFORMW 「You are clearly going a little too far with this...」
			CONTINUE
		ELSEIF (!TALENT:恋人 || !TALENT:恋慕) && STRCOUNT(LOCALS, "(?i)(husband|dear|darling|honey|hubby)$")
			PRINTFORMW 「You are clearly going a little too far with this...」
			CONTINUE
		ELSE
			PRINTFORML 「%RESULTS%... Is that right?」
		ENDIF
		CALL ASK_YN
		IF RESULT == 0
			;あなたの名前を%MASTERNAME:87%に格納
			MASTERNAME:87 = %RESULTS%
			PRINTFORML 
			BREAK
		ELSEIF RESULT == 1
			CONTINUE
		ENDIF
	ENDIF
LOOP 1

