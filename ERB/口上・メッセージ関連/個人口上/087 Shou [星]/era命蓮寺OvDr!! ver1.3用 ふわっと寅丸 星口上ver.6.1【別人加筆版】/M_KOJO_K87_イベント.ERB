@M_KOJO_SPEVENT_K87_4(ARG,ARG:1)
;口上主はTARGET
;共通メッセージ出力
;-------------------------------------------------
;フェラ、クンニで起こされる
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 1
	IF RAND:5 == 0
		PRINTFORML 「ぷちゅ, 음, 쪽, 음무... 아, 드디어 일어나셨네요」
		PRINTFORMW 「후훗, 자고 있는 사이에 당신에게 야한 걸 하는 거, 의외로 즐겁네요... 정말 귀여우셨어요♪」
	ELSEIF RAND:4 == 0
		PRINTFORML 「음, 츄, 주루루, 응 꽉… 퍄, 안녕하세요」
		PRINTFORMW 「%MASTERNAME:87%의 이불 속, %MASTERNAME:87%의 열과 냄새로 가득해서, 아주 흥분해 버렸어요%UNICODE(0x2665)%」
	ELSEIF RAND:3 == 0
		PRINTFORML 「음후, 하아, 쭉, 음쿠, 쪽」
		PRINTFORMW 눈을 뜨자 이불 속에서 당신의 성기를 탐하면서 속옷 너머로 음핵을 당신의 다리에 비비며 자위하는 쇼의 모습이 있었다.
		PRINTFORMW 「…조금 더 계속하게 해 주세요, 조금 있으면 갈 것 같아요… 쪽, 응하앗, 음응...!」
	ELSEIF RAND:2 == 0
		PRINTFORML 「응, 으윽, 하, 아침, 아침... 아, 좋은 아침입니다.」
		PRINTFORMW 「저기, %MASTERNAME:87%를 깨우려고 했더니, %MASTERNAME:87%의 여기가 굉장히 괴로워 보여서요... 계속해도 될까요?」
	ELSE
		PRINTFORML 「츳무, 음후, 응응... 러레루, 파, 아, 그대로 있어 주세요」
		PRINTFORMW 「충분히 참아서, 아침 첫 번째 진한 걸 잔뜩 내주세요%UNICODE(0x2665)%」
	ENDIF
	RETURN 1
ENDIF
;--------------------------------------------------
;パイズリで起こされる
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 2
	;精液中毒Lv.3以上でランダム分岐1つ追加
	IF RAND:3 == 0 && ABL:精液中毒 >= 3
		PRINTFORML 「음... 후, 아, 음... 깨우고 말았나요」
		PRINTFORML 「하루가 시작되기 전에, 제 몸에 당신의 냄새를 남겨두려고... 생각해서%UNICODE(0x2665)%」
		PRINTFORMW 「변태라고 말하지 말아 주세요? 누가 저를 이렇게 만들었다고 생각하세요?」
	ELSEIF RAND:2 == 0
		PRINTFORML 「음... 츄루읏... 푸압...」
		PRINTFORMW 「%MASTERNAME:87%아, 좋은 아침입니다.」
	ELSE
		PRINTFORML 「쥬... 음, 좋은 아침입니다. 이제 일어날 시간이에요」
		PRINTFORML 「저는 벌써 한참 일어났고 잘 지내고 있는데요...%UNICODE(0x2665)%」
		PRINTFORMW 그렇게 말하자 쇼는 다시 그 가슴으로 %MASTERNAME:87%의 음경을 비비기 시작했다
	ENDIF
	RETURN 1
ENDIF
;--------------------------------------------------
;騎乗位、貝合わせ (ARG:1が１の場合、ウフフに突入するか否か回答後の口上)
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 3
	;騎乗位、貝合わせ描写
	IF ARG:1 == 0
		PRINTFORML 「하앗, 아, 안녕히 주무셨어요...윽」
		PRINTFORMW 「자고 있는%MASTERNAME:87%의 거기를 만지고 있었더니, 우응, 저 참을 수 없게 되어버렸어...」
		;そのままウフフモードに突入するか
	ELSE
		;そのまま押し倒した
		IF TFLAG:193 == 1
			PRINTFORMW  「아하핫, 아침이라고 자비는 안 쓸 거예요♪ 배가 부를 때까지 다 먹어버릴 거니까요%UNICODE(0x2665)%」
			;押しのけて朝の準備
		ELSE
			PRINTFORML 「...정말, 자기중심적이잖아」
			PRINTFORMW  투덜거리는 쇼를 어떻게든 달래고 아침 준비를 시작했다...
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
