	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;料理の直後 ※SELECTCOMかも。入ってきたでPREVCOMは無茶か？
		IF PREVCOM == 413
			PRINTFORML 딱 요리가 끝날 무렵 쇼가 부엌에 얼굴을 내밀었다.
