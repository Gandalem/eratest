;1,クンニ
;==================================================
@M_KOJO_MESSAGE_COM_K87_1
CALL M_KOJO_MESSAGE_COM_K87_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「…っ、ま、まじまじと見ないでください…恥ずかしくて、死にそうです…」
		PRINTFORMW 「あっ！？や、舐めっ…なんて、ひゃうっ…駄目、ですよお…」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORML 先ほど注ぎ込んだ精液が星の愛液と混ざって、膣口からあふれ出している…
			IF TALENT:恋人
				IF RAND:3 == 0 
					PRINTFORML 「あはっ…%UNICODE(0x2665)%　私たちのが混ざって、出てきちゃってます…」
					PRINTFORMW 「きっと、とってもえっちな味がしますよね…%UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「どうです…？私達のえっちなジュース、美味しいですか…？」
				ELSE
					PRINTFORMW 「は、あぁっ…こんなに、ナカで出されちゃったんですね…%UNICODE(0x2665)%」
				ENDIF
			ELSE
				IF RAND:3 == 0 
					PRINTFORML 「う、わぁ…」
					PRINTFORMW あまりに淫靡な光景に、星は絶句してしまった…
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「こんなに、出されちゃって、私っ…」
				ELSE
					PRINTFORMW 「や、ぁっ…見せないでください…！」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
		ELSE
			;欲情3以上　※で、地の文にクリトリス吸い上げが入る
			IF PALAM:欲情 >= PALAMLV:3
				IF RAND:3 == 0
					PRINTFORML 「あう、ん、ひゃうっ！　あそこも、お豆もすごいぃいっ%UNICODE(0x2665)%！」
					PRINTFORML 震える星の秘所にあなたのさらに容赦ない責めが続く…
					PRINTFORMW 「だめだめ駄目ですッ！　そんなことしたらもう、来ちゃ……あああぁッ%UNICODE(0x2665)%！！」
				ELSEIF RAND:2 == 0
					PRINTFORML 「ふやあぁああぁっ%UNICODE(0x2665)%　お豆、そんなに吸われたらあっ！」
					PRINTFORMW 陰核への強烈な刺激に星は両手を頬に当て激しく首を振った
				ELSE
					PRINTFORML 「あうっ、あ…ふぁあっ！　それ以上は、舌っ　だめです……っ　やああんっ%UNICODE(0x2665)%」
					PRINTFORMW  あなたの舌技にクリトリスを翻弄され星は快楽に悶えている
				ENDIF
			ELSE
				IF RAND:2 == 0 
					PRINTFORMW 「ひうっ！？今、舐め、られちゃっ…は…ゃっ…」
				ELSE
					PRINTFORML 「～～っ%UNICODE(0x2665)%！！」
					PRINTFORMW 強い快感に押された星はぱくぱくと空気を求めるように口を開閉している
				ENDIF
			ENDIF
		ENDIF
		
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;欲情3以上
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:5 == 0 
				PRINTFORML 「ひゃああん…%UNICODE(0x2665)%　そこ、吸っちゃ駄目ですぅ…」
				PRINTFORMW 「…そ、その…止めるのも駄目です…」
			ELSEIF RAND:4 == 0 
				PRINTFORML 「ひ、ひぃんっ%UNICODE(0x2665)%　%MASTERNAME:87%の舌、ざらざらって、敏感なとこ…」
				PRINTFORMW 星の甘い悲鳴を聞いて、あなたはさらに星のぷっくり膨れた淫豆を責めまくった…
				PRINTFORMW 「やあっ%UNICODE(0x2665)%　舌で押しつぶすの、びりって、きちゃいますっ…♪」
			ELSEIF RAND:3 == 0
				PRINTFORML 「あ…ふうっ…%UNICODE(0x2665)%　舐められるの、好きです…%UNICODE(0x2665)%」
				PRINTFORMW 「私を気持ちよくしたいって、%MASTERNAME:87%の気持ちが、とっても嬉しいです…♪」 
			ELSEIF RAND:2 == 0
				PRINTFORML 「や、お豆も、ですかぁ？　……っ！　ひゃああんっ%UNICODE(0x2665)%！！」
				PRINTFORMW 「あっ、お口の中で…っ　くひぃっ！　あんっ%UNICODE(0x2665)%　うぁっ、あああっ%UNICODE(0x2665)%」
				PRINTFORML 　
				PRINTFORML 「はーっ、はーっ……　お豆…吸い過ぎですよぉ……%UNICODE(0x2665)%」
				PRINTFORMW あなたの舌から解放された星の陰核はふるふると小さく震えながら反り立っている
			ELSE
				PRINTFORML 「んんっ、そこ、ちゅうってしちゃ…はぁあっ！」
				PRINTFORMW クリトリスを強く吸い上げられ、星は大きくのけぞった
			ENDIF
		ELSE
			IF RAND:5 == 0
				PRINTFORML 「あくっ、ん……あんっ…あっ、う…」
				PRINTFORMW 舌が秘唇に触れるたびに星は小さく喘ぎ声を上げる
				IF PALAM:潤滑 >= PALAMLV:2
					PRINTFORML 　
					PRINTFORML 「ふああ……　私のあそこ…%MASTERNAME:87%に舐められてとろとろになっちゃいました…ぁ」
					PRINTFORMW あなたが口を離すころにはすっかり出来上がり秘穴から蜜が溢れだしてきていた…
				ENDIF
			ELSEIF RAND:4 == 0 
				PRINTFORML 「あの…舌が、ちょっと入って……　ひゃうっ%UNICODE(0x2665)%」
				PRINTFORMW 星の膣穴からは唾液とも愛液ともつかない液が垂れ落ちている…
			ELSEIF RAND:3 == 0 
				PRINTFORMW 「あっは、ふぅんっ、あ、いい、ですっ…そこ、はうっ、気持ちいいですっ…」
			ELSEIF RAND:2 == 0 
				PRINTFORMW 「そこ、舐められると、あ、たま、ふわふわって、は、ああ…！」
			ELSE
				PRINTFORMW 「っあ、%MASTERNAME:87%の舌がっ…大事な場所、舐めちゃってますよう…」
			ENDIF		
		ENDIF
		RETURN 1
	;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:5 == 0
			PRINTFORML 「あはっ…ゆっくり…いじってくださいね……」
			PRINTFORMW くすぐるように舐められるのも好きなようだ…
		ELSEIF RAND:4 == 0 
			PRINTFORMW 「んっ、もっと舐めてもいいですよ%UNICODE(0x2665)%」
		ELSEIF RAND:3 == 0 
			PRINTFORMW 「ひうっ、あ、%MASTERNAME:87%の舌がっ…ん、んんっ」
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「や、ああ…っ、あ、あんっ、そんな、音立てないで下さい…」
		ELSE
			PRINTFORMW 舌が秘芯に触れるたびに、星の腰がびくり、びくりと浮き上がる…
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「あう……音立てないでください…」
		ELSEIF RAND:4 == 0 
			PRINTFORMW 「あの、汚くないですか……？」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「そんな、穢いところ、舐めてはいけません…」 
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「ふ、ん…っ、あ、だめですよう…」
		ELSE
			PRINTFORMW 星は目をぎゅっと瞑って羞恥に耐えている…
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
