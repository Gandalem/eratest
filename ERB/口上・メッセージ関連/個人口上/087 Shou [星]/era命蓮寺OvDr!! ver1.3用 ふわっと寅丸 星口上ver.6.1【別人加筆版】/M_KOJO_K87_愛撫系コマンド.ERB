@M_KOJO_MESSAGE_COM_K87_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;※うふふ == 2のことも考えるとこのあたりのFIRSTTIMEは難しい
	;↑ほら、相手に押し倒されたときはまた別な心境になるじゃん？
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 緊張で小刻みに震える星の全身を、解きほぐすように優しく愛撫した…
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;※どっちかに挿入、もう片方にバイブの状態で自慰や愛撫は四重絶頂狙いでよくやると思われる。留意しておきたい
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF RAND:3 == 0 
				PRINTFORML 「は、はぅ、は、は、あ…」
			ELSEIF RAND:2 == 0 
				PRINTFORML 「あ、あぅ、ふぅんっ、はぁ、っ、あぅ…」
			ELSE
				PRINTFORML 「ひぅ、んんっ、ぁ、き、きてますっ…」
			ENDIF
			PRINTFORMW ペニスが精液を吐き出す度に震える星の体を感じながら、懸命に撫で続けた…
			RETURN 1
		;これで絶頂する
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			PRINTFORMW あなたに押さえつけられ快感を逃がせなくなった星に絶頂の衝撃が襲いかかる
		ELSE
			IF RAND:3 == 0 
				PRINTFORMW 「だ、だめです、そんな、はいっ…てるのに、そんな、とこっ…はぅっ…！」
			ELSEIF RAND:2 == 0 
				PRINTFORMW 「そんな、入ったまま、されたらっ…わけわかんなく、なっちゃいますっ…」
			ELSE
				PRINTFORMW 「やぁ、今、そんなとこ、撫でられちゃっ、ああっ、は、はぁっ…」
			ENDIF
			RETURN 1
		ENDIF
	;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	;恋慕
	IF TALENT:恋慕
		;手淫してもらった直後
		IF PREVCOM == 80
			IF TALENT:恋人
				PRINTFORM お返しとばかりに、星の
				SIF PALAM:潤滑 >= PALAMLV:4
					PRINTFORM 濡れそぼった
				PRINTFORML 秘部をたっぷり愛撫した…
				IF RAND:3 == 0 
					PRINTFORMW 「あ、はっ…%UNICODE(0x2665)%　%MASTERNAME:87%もしてくれるんですね、嬉しいです…」
				ELSEIF RAND:2 == 0 
					PRINTFORML 「んふっ…♪気持ちよくするのも、気持ちよくされるのも、素敵…%UNICODE(0x2665)%」
					PRINTFORMW 「ね…次はキスして欲しいです…あの、舌を絡めるの…とっても気持ちいいんです…」
				ELSE
					PRINTFORML 「ふふっ、気持ちよくさせあいっこ、ですね…%UNICODE(0x2665)%」
					PRINTFORMW 「激しく愛してくれるのもいいけど、こういうのも大好きです…%UNICODE(0x2665)%」
				ENDIF
			;恋人なし
			;/ハイパー手抜き
			ELSE
				PRINTFORM お返しとばかりに、星の
				SIF PALAM:潤滑 >= PALAMLV:4
					PRINTFORM 濡れそぼった
				PRINTFORML 秘部をたっぷり愛撫した…
				IF RAND:3 == 0 
					PRINTFORMW 「あ、はっ…%UNICODE(0x2665)%　%MASTERNAME:87%もしてくれるんですね、嬉しいです…」
				ELSEIF RAND:2 == 0 
					PRINTFORML 「んふっ…♪気持ちよくするのも、気持ちよくされるのも、素敵…%UNICODE(0x2665)%」
					PRINTFORMW 「ね…次はキスして欲しいです…あの、舌を絡めるの…とっても気持ちいいんです…」
				ELSE
					PRINTFORMW 「ふふっ、気持ちよくさせあいっこ、ですね…%UNICODE(0x2665)%」
				ENDIF
			ENDIF
		;これで絶頂する
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			;キスもした
			IF RAND:2 == 0 && EXP_UP(27,TARGET)
				IF RAND:2 == 0
					PRINTFORML 「んむ、んっ…ちゅ、ふんんっ！　……ぷぁっ、あっはああぁっ%UNICODE(0x2665)%！」 
					PRINTFORML あなたの愛撫を受けながらも口づけを続けていた星だったが
					PRINTFORMW 襲いかかる絶頂の波に思わず唇を離し嬌声を上げた
				ELSE
					PRINTFORML 「ふぁあっ、キス、しながらがいいですっ%UNICODE(0x2665)%」
					PRINTFORMW 星はあなたの頬に手を伸ばすとより激しく口づけしてきた
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「あっ、そこっ、つままれたら、きちゃいますっ%UNICODE(0x2665)%」
					PRINTFORML 「んっ、あっあぁっ、こするのもっ、んっ、やっ、ああぁっ%UNICODE(0x2665)%」
					PRINTFORMW 絶頂が近づいているのか星の声は高く掠れるようになり、息も荒くなっていく…
				ELSE
					PRINTFORML 「あはっ、気持ちいいのがどんどん強くなって…っ%UNICODE(0x2665)%」
					PRINTFORMW 星はうっとりとした顔で高まる悦楽に感じ入っている
				ENDIF
			ENDIF
		;前のコマンドが手淫以外で絶頂もしなかった
		ELSE
			;キスもした
			IF RAND:2 == 0 && EXP_UP(27,TARGET)
				IF RAND:2 == 0
					PRINTFORML 「んんうっ%UNICODE(0x2665)%　んむ…んん……ふ、む…」
					PRINTFORMW 敏感な部分への責めに身体を震わせながも星は唇を離さない
				ELSE
					PRINTFORML 「んー、ちゅるっ……れろ……んっ」
					PRINTFORMW 愛撫に身を委ねながら星はあなたの唇を貪っている
				ENDIF
			ELSE
				IF RAND:5 == 0
					PRINTFORML 「は、あぁぁ……っ　あ、そこ…ぉ%UNICODE(0x2665)%」
					PRINTFORMW あなたの丁寧な愛撫に星は切なそうな声を上げた
				ELSEIF RAND:4 == 0 
					PRINTFORML 「優しく触られるの……すごく気持ちいいです…%UNICODE(0x2665)%」
					PRINTFORMW 星は甘えるようにあなたにしなだれかかった
				ELSEIF RAND:3 == 0
					PRINTFORMW 「ああ…%MASTERNAME:87%の手、すごくいいです…」 
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「ふあ…は、あん…ふ、ふふっ、そこ、くすぐったいです…%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「ふふっ…たくさん、たくさん触ってくださいね…%UNICODE(0x2665)%」
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:4 == 0 
			PRINTFORML 「あくっ、んぅ……っ」
			PRINTFORMW 「いいですよ…もっと強くしても……あっ」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「んっ、%MASTERNAME:87%の手、すごくやらしいですよ…」 
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「駄目ですよお…この手、気持ちよすぎます…」
		ELSE
			PRINTFORMW あなたの手が這うたびに、星は熱く甘い吐息を漏らしている…
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		IF RAND:4 == 0 
			PRINTFORML 「ん…ふっ……あははっ」
			PRINTFORMW しかし上がる声には笑い声も混じっている…くすぐったいようだ
		ELSEIF RAND:3 == 0 
			PRINTFORMW 「駄目です…こんなこと、駄目なんです…」
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「ひぅっ！？やあ…そんなとこ、触っちゃ駄目です…」
		ELSE
			PRINTFORMW 「あ、っはぅ…や、やめてください…」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
