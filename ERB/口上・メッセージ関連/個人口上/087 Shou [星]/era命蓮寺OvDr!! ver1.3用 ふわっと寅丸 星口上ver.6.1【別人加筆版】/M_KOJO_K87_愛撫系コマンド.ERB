@M_KOJO_MESSAGE_COM_K87_1
CALL M_KOJO_MESSAGE_COM_K87_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「...윽, 제, 제대로 보지 말아 주세요... 부끄러워서, 죽을 것 같아요...」
		PRINTFORMW 「앗!? 그, 음흉한... 같은 거, 히야앗... 안 돼요...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORML 방금 주입했던 정액이 별의 애액과 섞여 질구에서 흘러넘치고 있다...
			IF TALENT:恋人
				IF RAND:3 == 0
					PRINTFORML 「아하핫... 우리 것들이 섞여서 나와 버렸어요...」
					PRINTFORMW 「분명, 아주 야한 맛이 나겠지요...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「어때요...? 저희의 야한 주스, 맛있어요...?」
				ELSE
					PRINTFORMW 「하, 아앗... 이렇게 안에서 나오게 되어 버렸네요...%UNICODE(0x2665)%」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORML 「우, 와아...」
					PRINTFORMW 너무나 음란한 광경에, 쇼는 말을 잃어버렸다...
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이렇게, 내보내져 버려서, 나...」
				ELSE
					PRINTFORMW 「야, 아앗... 보여주지 말아 주세요...!」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;過激なイタズラ中
		IF CFLAG:イタズラ && CFLAG:睡眠
		ELSE
			;欲情3以上　※で、地の文にクリトリス吸い上げが入る
			IF PALAM:欲情 >= PALAMLV:3
				IF RAND:3 == 0
					PRINTFORML 「아으, 응, 햐우앗! 저쪽도, 클리도 굉장해욧%UNICODE(0x2665)%!」
					PRINTFORML 떨리는 쇼의 은밀한 곳에 당신의 더욱 가차 없는 채찍질이 이어진다…
					PRINTFORMW 「안 돼 안 돼요 절대로! 그런 짓을 하면 벌써, 와버릴 거야……아아아앗%UNICODE(0x2665)%!!」
				ELSEIF RAND:2 == 0
					PRINTFORML 「후야아아악%UNICODE(0x2665)% 클리, 그렇게 빨리면 아앗!」
					PRINTFORMW 음핵에 가해진 강렬한 자극에 쇼는 양손을 뺨에 대고 격렬하게 고개를 저었다.
				ELSE
					PRINTFORML 「아으윽, 아... 후앗! 그 이상은, 혀는 안 돼요... 큭앙%UNICODE(0x2665)%」
					PRINTFORMW  당신의 혀 기술에 클리토리스를 농락당한 쇼는 쾌락에 몸부림치고 있다.
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「히으윽!? 지금, 핥아지… 버려져… 하앗…」
				ELSE
					PRINTFORML 「～～っ%UNICODE(0x2665)%！！」
					PRINTFORMW 강한 쾌감에 몰린 쇼는 파닥파닥 공기를 찾듯이 입을 벌리고 있다.
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;欲情3以上
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:5 == 0
				PRINTFORML 「흐으응...%UNICODE(0x2665)% 거긴, 빨면 안 돼요...」
				PRINTFORMW 「...그, 그게... 멈추는 것도 안 돼요...」
			ELSEIF RAND:4 == 0
				PRINTFORML 「히, 히잉%UNICODE(0x2665)% %MASTERNAME:87%의 혀가 거칠게, 민감한 곳을...」
				PRINTFORMW 별의 달콤한 비명을 듣고 당신은 더욱 별의 통통하게 부풀어 오른 음클을 몰아붙였다...
				PRINTFORMW 「야앗%UNICODE(0x2665)% 혀로 짓뭉개는 거야, 짜릿해서, 와버려요...♪」
			ELSEIF RAND:3 == 0
				PRINTFORML 「아... 후으윽... %UNICODE(0x2665)% 빨리는 거, 좋아해요... %UNICODE(0x2665)%」
				PRINTFORMW 「나를 기분 좋게 해주고 싶다는, %MASTERNAME:87%의 마음이, 정말 기뻐요...♪」 
			ELSEIF RAND:2 == 0
				PRINTFORML 「자, 클리도, 그러시는 건가요? ……윽! 히야앙%UNICODE(0x2665)%!!」
				PRINTFORMW 「앗, 입 안에서…윽 쿠히잇! 안쪽%UNICODE(0x2665)% 와앗, 아아앗%UNICODE(0x2665)%」
				PRINTFORML 　
				PRINTFORML 「하아, 하아…… 클리… 너무 많이 빨았어요……%UNICODE(0x2665)%」
				PRINTFORMW 당신의 혀에서 풀려난 별의 음핵은 파르르 떨며 솟아 있었다
			ELSE
				PRINTFORML 「응, 거기, 키스해 버릴 거야... 하아앗!」
				PRINTFORMW 클리토리스를 세게 빨려, 쇼는 크게 뒤로 젖혀졌다.
			ENDIF
		ELSE
			IF RAND:5 == 0
				PRINTFORML 「흐윽, 응... 앙... 아, 으...」
				PRINTFORMW 혀가 비음(秘唇)에 닿을 때마다 쇼는 작게 신음했다.
				IF PALAM:潤滑 >= PALAMLV:2
					PRINTFORML 　
					PRINTFORML 「후아…… 저곳이 %MASTERNAME:87%에게 핥혀서 녹아버렸어요... 아」
					PRINTFORMW 당신이 입을 뗄 무렵에는 완전히 완성되어 비밀의 구멍에서 달콤한 액이 흘러나오고 있었다...
				ENDIF
			ELSEIF RAND:4 == 0
				PRINTFORML 「저기... 혀가, 살짝 들어와서... 히야앗%UNICODE(0x2665)%」
				PRINTFORMW 쇼의 질 구멍에서는 침인지 애액인지 모를 액이 흘러내리고 있다...
			ELSEIF RAND:3 == 0
				PRINTFORMW 「아하, 후응, 아, 좋아요... 거기, 하으윽, 기분 좋아요...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「거기, 핥히면, 아, 머리가 몽롱해져서, 하, 아아...!」
			ELSE
				PRINTFORMW 「윽, %MASTERNAME:87%의 혀가... 중요한 곳을 핥고 있어요...」
			ENDIF
		ENDIF
		RETURN 1
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:5 == 0
			PRINTFORML 「아하핫... 천천히... 만져주세요...」
			PRINTFORMW 간지럽게 핥아지는 것도 좋아하는 것 같아...
		ELSEIF RAND:4 == 0
			PRINTFORMW 「음, 더 핥아도 괜찮아요 %UNICODE(0x2665)%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「히으윽, 아, %MASTERNAME:87%의 혀가앗...응, 응응」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아, 아아...윽, 아, 응! 그런 소리 내지 말아 주세요...」
		ELSE
			PRINTFORMW 혀가 심심에 닿을 때마다, 별의 허리가 움찔, 움찔하며 들썩인다...
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「흐윽... 소리 내지 말아주세요...」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「저기, 더럽지 않나요……?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「그런, 더러운 곳은 함부로 핥아서는 안 됩니다...」 
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흐, 으음... 아, 안 돼요...」
		ELSE
			PRINTFORMW 쇼는 눈을 꾹 감고 수치심에 견디고 있다…
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
