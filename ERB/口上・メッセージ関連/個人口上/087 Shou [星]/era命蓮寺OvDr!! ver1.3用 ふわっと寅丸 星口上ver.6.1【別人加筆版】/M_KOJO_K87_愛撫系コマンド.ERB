@M_KOJO_MESSAGE_COM_K87_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;初めて
		PRINTFORMW 
		RETURN 1
	ENDIF
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
	;処女
	ELSEIF TCVAR:破瓜 == 1
		IF TALENT:恋慕
			PRINTFORML 「ん…ぅ……　ふっ……うー…」
			PRINTFORML 「だ、大丈夫ですよね？　指でなんて…なりませんよね？」
			PRINTFORMW 星は不安げに あなたを見つめている
		ELSE
			PRINTFORMW 「んく…　ら、乱暴にしないでくださいね…」
		ENDIF
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		;バイブ有り
		IF TEQUIP:バイブ
			;Ｖ感覚3以上
			IF ABL:Ｖ感覚 >= 3
				PRINTFORML 「そんなに押しこんだら…　やっ、ああっ！」
				PRINTFORMW 膣内を掻きまわす無機質な感触に星は感じ入っている
			ELSE
				PRINTFORML 「うあ、振動、きついいぃいっ」
				PRINTFORMW バイブに膣内を掻きまわされる感覚にはまだ慣れないようだ…
			ENDIF
		ELSE
			IF ABL:Ｖ感覚 >= 3
				IF RAND:2 == 0
					PRINTFORML 「あうっ、ん…もっと、奥まで……っ%UNICODE(0x2665)%」
					PRINTFORMW 星の恥肉があなたの指に絡みつく…
				ELSE
					PRINTFORML 「あは…　いっぱい掻きまわされて…熱くなっちゃいます♪」
					PRINTFORMW 星は身体を震わせながら荒く息をついている
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「あ…ぅ……　なんだかじりじりします…」
					PRINTFORMW しかしまだ違和感を感じているようだ…
				ELSE
					PRINTFORML 「ふ……んっ　…く、ぁ」
					PRINTFORMW まだ苦しさが残るのか星は時々眉をひそめている
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF ABL:Ｖ感覚 >= 3
			PRINTFORMW 「いいですよ…もう少し奥まで…」
		ELSE
			PRINTFORMW 「ん…もう少しで慣れると思いますから……」
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		IF ABL:Ｖ感覚 >= 3
			PRINTFORMW 「あっ……捏ねまわされて…」
