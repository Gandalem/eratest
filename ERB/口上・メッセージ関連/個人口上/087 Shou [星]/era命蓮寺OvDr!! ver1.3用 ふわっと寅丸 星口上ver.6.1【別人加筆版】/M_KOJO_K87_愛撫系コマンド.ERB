@M_KOJO_MESSAGE_COM_K87_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;※うふふ == 2のことも考えるとこのあたりのFIRSTTIMEは難しい
	;↑ほら、相手に押し倒されたときはまた別な心境になるじゃん？
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 긴장으로 미세하게 떨리는 쇼의 전신을, 풀어주듯이 부드럽게 애무했다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;※どっちかに挿入、もう片方にバイブの状態で自慰や愛撫は四重絶頂狙いでよくやると思われる。留意しておきたい
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF RAND:3 == 0
				PRINTFORML 「하, 하으, 하, 하아……」
			ELSEIF RAND:2 == 0
				PRINTFORML 「아, 아우, 후응, 하아, 윽, 아우……」
			ELSE
				PRINTFORML 「흐으, 응응, 아, 오고 있어요...」
			ENDIF
			PRINTFORMW 페니스가 정액을 토해낼 때마다 떨리는 쇼의 몸을 느끼며, 필사적으로 쓰다듬었다...
			RETURN 1
			;これで絶頂する
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			PRINTFORMW 당신에게 눌려 쾌감을 놓을 수 없게 된 쇼에게 절정의 충격이 덮친다.
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「아, 안 돼요, 그런, 네... 있는데, 그런 곳은... 하윽...!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「그런, 들어간 채로, 당한다면... 무슨 일인지 알 수 없게 되어버려요...」
			ELSE
				PRINTFORMW 「야아, 지금, 그런 곳을 쓰다듬어 버리네, 아앗, 하, 하아윽…」
			ENDIF
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	;恋慕
	IF TALENT:恋慕
		;手淫してもらった直後
		IF PREVCOM == 80
			IF TALENT:恋人
				PRINTFORM 보답이라며, 쇼의
				SIF PALAM:潤滑 >= PALAMLV:4
					PRINTFORM 흠뻑 젖은
				PRINTFORML 은밀한 곳을 마음껏 어루만졌다...
				IF RAND:3 == 0
					PRINTFORMW 「아, 하앗... %UNICODE(0x2665)% %MASTERNAME:87% 해주시는군요, 기뻐요...」
				ELSEIF RAND:2 == 0
					PRINTFORML 「응후…♪ 기분 좋게 해주는 것도, 기분 좋게 받는 것도, 멋져…%UNICODE(0x2665)%」
					PRINTFORMW 「저기… 다음엔 키스해줬으면 해요… 저, 혀를 섞는 거… 정말 기분이 좋아요…」
				ELSE
					PRINTFORML 「후후, 서로 기분 좋게 해주기, 그렇죠... %UNICODE(0x2665)%」
					PRINTFORMW 「격렬하게 사랑해 주는 것도 좋지만, 이런 것도 정말 좋아해요... %UNICODE(0x2665)%」
				ENDIF
				;恋人なし
				;/ハイパー手抜き
			ELSE
				PRINTFORM 보답이라며, 쇼의
				SIF PALAM:潤滑 >= PALAMLV:4
					PRINTFORM 흠뻑 젖은
				PRINTFORML 은밀한 곳을 마음껏 어루만졌다...
				IF RAND:3 == 0
					PRINTFORMW 「아, 하앗... %UNICODE(0x2665)% %MASTERNAME:87% 해주시는군요, 기뻐요...」
				ELSEIF RAND:2 == 0
					PRINTFORML 「응후…♪ 기분 좋게 해주는 것도, 기분 좋게 받는 것도, 멋져…%UNICODE(0x2665)%」
					PRINTFORMW 「저기… 다음엔 키스해줬으면 해요… 저, 혀를 섞는 거… 정말 기분이 좋아요…」
				ELSE
					PRINTFORMW 「후후, 기분 좋게 서로 애무하는 거죠... %UNICODE(0x2665)%」
				ENDIF
			ENDIF
			;これで絶頂する
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			;キスもした
			IF RAND:2 == 0 && EXP_UP(27,TARGET)
				IF RAND:2 == 0
					PRINTFORML 「음, 응... 쪽, 음! ……푸핫, 아하아앗%UNICODE(0x2665)%!」 
					PRINTFORML 당신의 애무를 받으면서도 입맞춤을 계속하고 있던 쇼였지만
					PRINTFORMW 덮쳐오는 절정의 파도에 무심코 입술을 떼고 교성을 질렀다
				ELSE
					PRINTFORML 「흐으, 키스하면서 하는 게 좋아요%UNICODE(0x2665)%」
					PRINTFORMW 쇼는 당신의 뺨으로 손을 뻗자 더욱 격렬하게 입을 맞추어 왔다
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「앗, 거기, 만지면, 와버릴 거예요%UNICODE(0x2665)%」
					PRINTFORML 「응읏, 아아핫, 비비는 것도, 응읏, 야, 아아핫%UNICODE(0x2665)%」
					PRINTFORMW 절정이 다가온 건지 호시의 목소리는 높아지고 갈라지며 숨도 거칠어간다...
				ELSE
					PRINTFORML 「아하핫, 기분 좋은 것이 점점 강해져…읏%UNICODE(0x2665)%」
					PRINTFORMW 쇼는 황홀한 얼굴로 고조되는 쾌락에 빠져 있었다.
				ENDIF
			ENDIF
			;前のコマンドが手淫以外で絶頂もしなかった
		ELSE
			;キスもした
			IF RAND:2 == 0 && EXP_UP(27,TARGET)
				IF RAND:2 == 0
					PRINTFORML 「응응, 으윽%UNICODE(0x2665)% 응음…응응……후, 음…」
					PRINTFORMW 민감한 부위를 공격당하며 몸을 떨면서도 쇼는 입술을 떼지 않았다.
				ELSE
					PRINTFORML 「음~, 촉촉해... 핥아... 응!」
					PRINTFORMW 애무에 몸을 맡기며 쇼는 당신의 입술을 탐하고 있다.
				ENDIF
			ELSE
				IF RAND:5 == 0
					PRINTFORML 「아, 아아……윽, 아, 거기…♡」
					PRINTFORMW 당신의 정성스러운 애무에 쇼는 슬픈 듯한 목소리를 냈다.
				ELSEIF RAND:4 == 0
					PRINTFORML 「상냥하게 만져지는 거... 정말 기분 좋아요...%UNICODE(0x2665)%」
					PRINTFORMW 쇼는 애원하듯 당신에게 기대어 몸을 맡겼다
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아아... %MASTERNAME:87%의 손, 정말 좋아요...」 
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후아... 하, 안... 후, 후훗, 거기, 간지러워요... %UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「후훗... 많이, 많이 만져주세요...」 %UNICODE(0x2665)%
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:4 == 0
			PRINTFORML 「아, 응...윽」
			PRINTFORMW 「좋아요... 더 세게 해도... 아앗」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응, %MASTERNAME:87%의 손이, 정말 음란해요...」 
		ELSEIF RAND:2 == 0
			PRINTFORMW 「안 돼요... 이 손, 너무 기분 좋아요...」
		ELSE
			PRINTFORMW 당신의 손이 기어 다닐 때마다, 쇼는 뜨겁고 달콤한 숨을 내쉬고 있다...
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:4 == 0
			PRINTFORML 「음... 후훗... 아하하핫」
			PRINTFORMW 하지만 올라오는 목소리에는 웃음소리도 섞여있다... 간지러운 모양이다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「안 돼요... 이런 건, 안 돼요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흐윽!? 안 돼... 그런 데 만지면 안 돼요...」
		ELSE
			PRINTFORMW 「아, 핫... 그만두세요...」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
