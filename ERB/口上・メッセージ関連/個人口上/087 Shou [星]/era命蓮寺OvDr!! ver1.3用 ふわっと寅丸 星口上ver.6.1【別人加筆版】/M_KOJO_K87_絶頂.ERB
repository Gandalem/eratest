						CFLAG:1504 ++
						CFLAG:1505 ++
						RETURN 1
					;Ｃ＆Ｖ＆Ｂ絶頂
					;背面座位/立位により使用頻度はそこそこ多いと思われ
					CASE 4
						PRINTFORML 「はあぅ、はっ、あ、だめですっ、そこつまんじゃ駄目っ…っあああぁぁっ…」
						PRINTFORMW 星の蜜壺をかき回しながら肉豆と乳首を指で押し潰すと、長い嬌声とともに星の全身が緊張し、崩れ落ちる
						PRINTFORML 「%MASTERNAME:87%のばかぁ…これされると、はぁっ、たてなくなるって、なんろもいってるひゃにゃいれすかぁ…%UNICODE(0x2665)%」
						PRINTFORMW もはや舌が回らなくなるほど星の体は弛緩しきっており、涎と愛液を垂れ流している…
						CFLAG:1502 ++
						CFLAG:1503 ++
						CFLAG:1504 ++
						RETURN 1
				ENDSELECT
			ENDIF
		ENDIF
		;-------------------------------------------------
		;二重絶頂
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF NOWEX:二重絶頂
			SELECTCASE NOWEX:二重絶頂
				;Ｃ＆Ｖ絶頂
				;対面座位/立位により使用頻度はそこそこ多いと思われ
				CASE 1
					IF RAND:3 == 0 
						PRINTFORML 「あ、これ、あそこも擦れっ…ひ、う、ううぅぅっ…」
						PRINTFORMW 「くる、両方きちゃうううぅっ%UNICODE(0x2665)%」
					ELSEIF RAND:2 == 0 
						PRINTFORML 「やぅ、そこ、擦らないで、びりってくる、きちゃううっ%UNICODE(0x2665)%」
						PRINTFORMW 星の肉壷を責めながら意識的に陰核を擦ってやると、星はいつもより早く果ててしまった…
					ELSE
						PRINTFORML 「ああっ！そこ擦っちゃだめ、すぐに、あうっ%UNICODE(0x2665)%イッちゃいますっ」
						PRINTFORMW 「だめっ、だめっ、もうっ…っああぁぁぁ～～っ…」
					ENDIF
					CFLAG:1502 ++
					CFLAG:1503 ++
					RETURN 1
				;Ｃ＆Ａ絶頂
				CASE 2
					PRINTFORMW 
					CFLAG:1502 ++
					CFLAG:1505 ++
					RETURN 1
				;Ｖ＆Ａ絶頂
				CASE 3
					PRINTFORMW 
					CFLAG:1503 ++
					CFLAG:1505 ++
					RETURN 1
				;Ｃ＆Ｂ絶頂
				CASE 4
					PRINTFORMW 
					CFLAG:1502 ++
					CFLAG:1504 ++
					RETURN 1
				;Ｖ＆Ｂ絶頂
				CASE 5
					PRINTFORMW 
					CFLAG:1503 ++
					CFLAG:1504 ++
					RETURN 1
				;Ａ＆Ｂ絶頂
				CASE 6
					PRINTFORMW 
					CFLAG:1504 ++
					CFLAG:1505 ++
					RETURN 1
			ENDSELECT
		ENDIF
		IF NOWEX:0
		;/愛撫、クンニ、クリキャップ、座＊２・背＊２、各分岐にランダム分岐を3つほど、それぞれ絶頂・強絶頂で場合分け＝42分岐＼(^o^)／
			;強絶頂Ｃ
			IF NOWEX:0 >= 2
				IF RAND:3 == 0 
					PRINTFORMW 「そこ、あっ、んまりいじっちゃ、～～～っっっ」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「うあっ、あっ、あぅ～～っ…」
				ELSE
					PRINTFORMW 「ひぁっ、そこっ、もうきちゃっ…くぅ～～っ」
				ENDIF
			;絶頂Ｃ
			ELSE
				IF RAND:3 == 0 
					PRINTFORMW 「そこ、あっ、んまりいじっちゃ、～～～っっっ」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「うあっ、あっ、あぅ～～っ…」
				ELSE
					PRINTFORMW 「ひぁっ、そこっ、もうきちゃっ…くぅ～～っ」
				ENDIF
			ENDIF
			CFLAG:1502 ++
		ENDIF
		IF NOWEX:1
		;/星ちゃんはV敏感！
		;/指挿入、バイブ、オナニー、正・騎・座＊２・背＊２、各分岐にランダム分岐を3つほど、それぞれ絶頂・強絶頂で場合分け＝54分岐＼(^o^)／
		;/あ、Gスポ責め・子宮口責めも追加で
			;強絶頂Ｖ
			IF NOWEX:1 >= 2
				IF RAND:3 == 0 
					PRINTFORMW 「んやっ、イく、はっ、イくぅぅ～～っ！」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「だめ、きちゃ、きちゃうぅ～～っ」
				ELSE
					PRINTFORMW 「や、もうきちゃいます、ぎゅってしてください、うぅぅぅ～～っ…」
				ENDIF
			;絶頂Ｖ
			ELSE
				IF RAND:3 == 0 
					PRINTFORMW 「んやっ、イく、はっ、イくぅぅ～～っ！」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「だめ、きちゃ、きちゃうぅ～～っ」
				ELSE
					PRINTFORMW 「や、もうきちゃいます、ぎゅってしてください、うぅぅぅ～～っ…」
				ENDIF
			ENDIF
			CFLAG:1503 ++
		ENDIF
		IF NOWEX:2
		;/アナル愛撫、アナルバイブ、アナルビーズ、オナニー、正・騎・座＊２・背＊２、各分岐にランダム分岐を3つほど、それぞれ絶頂・強絶頂で場合分け＝60分岐＼(^o^)／
			;強絶頂Ａ
			IF NOWEX:2 >= 2
				IF RAND:3 == 0 
					PRINTFORMW 「んやっ、お、しり、そんないじっちゃ、はっ、くぅぅ～～っ！」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「だめ、きちゃ、きちゃうぅ～～っ」
				ELSE
					PRINTFORMW 「や、こんな、こんなぁぁ～～っ」
				ENDIF
			;絶頂Ａ
			ELSE
				IF RAND:3 == 0 
					PRINTFORMW 「んやっ、お、しり、そんないじっちゃ、はっ、くぅぅ～～っ！」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「だめ、きちゃ、きちゃうぅ～～っ」
				ELSE
					PRINTFORMW 「や、こんな、こんなぁぁ～～っ」
				ENDIF
			ENDIF
			CFLAG:1505 ++
		ENDIF
		IF NOWEX:3
		;/愛撫、ニプルキャップ、自慰、背面座位（立位）、各分岐にランダム分岐を3つほど、それぞれ絶頂・強絶頂で場合分け＝24分岐　まだ何とか…
		;/さらに絶頂口上全てに恋慕・非恋慕で場合分けできるね。分岐が増えるよ、やったねたえｔ(ry
			;強絶頂Ｂ
			IF NOWEX:3 >= 2
				IF RAND:3 == 0 
					PRINTFORMW 「っあ、そ、んなに撫でられたら、あ、くぅ～～っ」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「ダメです、私、おっぱいで、っ、うああっ…！」
				ELSE
					PRINTFORMW 「や、はぅ、そんなに乳首、こねた、らぁっ、～～っ！」
				ENDIF
			;絶頂Ｂ
			ELSE
				IF RAND:3 == 0 
					PRINTFORMW 「っあ、そ、んなに撫でられたら、あ、くぅ～～っ」
				ELSEIF RAND:2 == 0 
					PRINTFORMW 「ダメです、私、おっぱいで、っ、うああっ…！」
				ELSE
					PRINTFORMW 「や、はぅ、そんなに乳首、こねた、らぁっ、～～っ！」
				ENDIF
			ENDIF
			CFLAG:1504 ++
		ENDIF
	ENDIF
ENDIF

