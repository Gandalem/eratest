@M_KOJO_MESSAGE_PALAMCNG_B_K87
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:11
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:12
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;/場合分け多すぎワロリン
;/最低でもtntn・MASTERの指や舌・オモチャ・自分の指　のどれでイッてるかを分けないとセリフと状況が一致しないおそれがある
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
			RETURN 1
	ELSE
		;-------------------------------------------------
		;/【クアドラプル・クライマックス】
		;四重絶頂
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF NOWEX:四重絶頂
			;過激なイタズラ中
			IF CFLAG:イタズラ && CFLAG:睡眠
			ELSE
				;恋慕
				IF TALENT:恋慕
					PRINTFORMW 「～～～～～っ！！？」
					PRINTFORML 一瞬その身体に訪れた衝撃が理解できなかった星だったが、
					PRINTFORMW 理解できる頃には穴という穴から体液を垂れ流し、四重絶頂の快感に打ちのめされていた
					PRINTFORML 「ひっ！？　あっ、あああぁっ%UNICODE(0x2665)% すごいっ、こんなの、こんなのおっ、だめっ%UNICODE(0x2665)%　ふあぁあっ%UNICODE(0x2665)%！！」
					PRINTFORML 体中の皮膚という皮膚を煌めくような快感に飲み込まれて、星の意識が混濁し始める
					PRINTFORML 「全部っ%UNICODE(0x2665)%、きちゃうっ！ 先っぽもお豆お尻もあそこもぐちゃぐちゃされてっ、バラバラになっちゃうっ%UNICODE(0x2665)%！
					PRINTFORML 　はあぁあぁっ　おつゆ噴いちゃいますううううぅぅ%UNICODE(0x2665)%　ふえぇえぇぇええっ%UNICODE(0x2665)%
					PRINTFORMW 　だってこんなに凄いの耐えられないぃ！　ダメになるダメになるダメになっちゃいますぅうう～～～%UNICODE(0x2665)%%UNICODE(0x2665)%！！」
					PRINTFORMW 絶頂から戻ってこれず半狂乱状態の星の液汁まみれの顔は淫らで、無様で、そして愛おしかった
				ENDIF
			ENDIF
			CFLAG:1502 ++
			CFLAG:1503 ++
			CFLAG:1504 ++
			CFLAG:1505 ++
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;三重絶頂
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF NOWEX:三重絶頂
		;過激なイタズラ中
			IF CFLAG:イタズラ && CFLAG:睡眠
			ELSE
				SELECTCASE NOWEX:三重絶頂
					;Ｃ＆Ｖ＆Ａ絶頂
					CASE 1
						PRINTFORML 「はああっ！ ああっ、はあぁあぁっ、ああ゛あぁぁあ～っ%UNICODE(0x2665)% 凄いっ、うぁっ、凄いいいぃぃっ！」
						PRINTFORMW 下半身に一度に訪れた快楽に星はなすすべもなく腰をがくがくと揺らして絶頂した
						PRINTFORML 「はあ、はあ…凄かったです…腰から下、溶けて無くなっちゃうかとおもいましたあ…」
						PRINTFORMW しばらくして快楽の波が収まってもその息は荒く、瞳は情欲に蕩けていた
						CFLAG:1502 ++
						CFLAG:1503 ++
						CFLAG:1505 ++
						RETURN 1
					;Ｂ＆Ｖ＆Ａ絶頂
					CASE 2
						PRINTFORMW 
