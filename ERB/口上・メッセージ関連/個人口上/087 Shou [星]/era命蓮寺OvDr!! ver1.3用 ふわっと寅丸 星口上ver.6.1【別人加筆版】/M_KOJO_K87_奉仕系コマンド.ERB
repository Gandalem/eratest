@M_KOJO_MESSAGE_COM_K87_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF TALENT:恋人
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;技巧3以上
			IF ABL:技巧 >= 3
