@M_KOJO_MESSAGE_MESSAGECHECK_COM_K87_81
;※MASTERが射精する時だけ元の地の文を呼ぶように変更
SIF NOWEX:MASTER:11
	RETURN 0
RETURN 1

@M_KOJO_MESSAGE_COM_K87_81
CALL M_KOJO_MESSAGE_COM_K87_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
		;お掃除フェラ
	ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
		;お掃除用のLOCAL取得
		IF TCVAR:MASTER:112 == 1
			LOCAL = MASTER_POSE(SET_V,SET_P,1)
		ELSEIF TCVAR:MASTER:112 == 2
			LOCAL = MASTER_POSE(SET_A,SET_P,1)
		ENDIF
		DRAWLINE
		PRINTFORML 뽑아낸 페니스에 붙은 정액을 %조사처리(CALLNAME:TARGET,"에게")% 핥게 했다...
		PRINTFORML 　
		;恋人
		IF TALENT:恋人
			;※EVENT_MESSAGE_ORGASM.ERBに合わせて精飲経験で分岐
			IF TCVAR:精飲経験 > 20
				IF RAND:3 == 0
					PRINTFORMW 「음... 혀로... 쪽」
					PRINTFORML 쇼는 정액이 묻은 남근을 조심스럽게 핥아 올리고, 요도에 남아있는 정액까지 깨끗하게 빨아들였다.
					PRINTFORMW 「끝났어요♪ ...청소만 했는데 또 커진 것 같네요... %UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0
					PRINTFORML 「츄...응...후우...파...」
					PRINTFORMW 쇼는 정액을 맛보면서 청소를 계속하고 있다...
					;中出しされたのはTARGET
					IF TCVAR:102 || TCVAR:104
						PRINTFORMW 「음... %MASTERNAME:87%와 나의 맛이 섞여 있어...%UNICODE(0x2665)%」
						;中出しされたのは他の人
					ELSE
						PRINTFORM 후후... %MASTERNAME:87%와 %CALLNAME:LOCAL%
						;呼称変。　響子なら「ちゃん」、マミゾウなら「さん」
						SIF NO:LOCAL == 8
							PRINT 양
						SIF NO:LOCAL == 9
							PRINT 씨
						PRINTFORMW 의 맛이 섞여...「
					ENDIF
				ELSE
					PRINTFORML 「푸아... 네, 깨끗해졌어요」
					PRINTFORMW 「어떻게 할까요? 이대로 입으로 계속할까요?」
					PRINTFORM 「아니면」
					;中出しされたのはTARGET
					IF TCVAR:102 || TCVAR:104
						PRINTFORML 또 삽입해 버릴까요…? %UNICODE(0x2665)%?”
						PRINTFORMW 쇼는 지금 흘린 정액이 떨어지는 \@ TCVAR:102 ? 은밀한 곳 # 항문 \@에 손을 뻗어 당신에게 보여주듯이 구석구석 휘젓고 있었다…
						;中出しされたのは他の人
					ELSE
						PRINTFORML 이번에는 나에게 해주는 건가...%UNICODE(0x2665)%?
						PRINTFORMW 쇼는 기대에 찬 눈으로 당신을 바라보고 있었다...
					ENDIF
				ENDIF
			ELSE
				PRINTFORML 「음... 컥, 음... 꿀꺽...」
				PRINTFORMW 아직 정액 맛에 익숙해지지 않은 쇼는 가끔 콜록거리며 청소를 계속하고 있다...
			ENDIF
			;恋慕
		ELSEIF TALENT:恋慕
			IF TCVAR:精飲経験 > 20
				PRINTFORML 「그럼, 깨끗하게 해 드릴게요...♪」
				PRINTFORMW 쇼는 정액을 맛보며 청소를 계속하고 있었다...
			ELSE
				PRINTFORMW 「응... 응... 푸핫, 깨끗하게 해드렸어요...」
				PRINTFORMW (%MASTERNAME:87%의 맛... ♪)
			ENDIF
			;その他
		ELSE
			IF TCVAR:精飲経験 > 20
				PRINTFORML 「츄...응...후우...파...」
				PRINTFORMW 쇼는 정액을 맛보면서 청소를 계속하고 있다...
			ELSE
				PRINTFORML 「음... 흐윽, 음... 혀로...」
				PRINTFORMW 아직 정액의 맛에 익숙하지 않은 쇼는 희미하게 눈물을 글썽이며 청소를 계속하고 있다...
			ENDIF
		ENDIF
		;普通のフェラ
		;恋人
	ELSEIF TALENT:恋人
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;技巧3以上
			IF ABL:技巧 >= 3
				;精液中毒3以上
				IF ABL:精液中毒 >= 3
					IF RAND:3 == 0
						PRINTFORMW 「주쥬우우~읏, 쪽, 응, 주루루우우~읏, 쪽피, 추푸, 취유우우~읏」
						PRINTFORMW 더 이상 봉사가 아닌 보상이 되어버린 페라치오를, 한 치의 흐트러짐 없이 계속하는 쇼
						PRINTFORMW 그 강렬한 쾌감에 녹아버린 쇼는, 사정을 시작한 육봉에도 신경 쓰지 않고 빨고 있다…
					ELSEIF RAND:2 == 0
						PRINTFORMW 「후아, 푸, 냠, 츄르윽, 츄우욱」
						PRINTFORML (아... 곧이네요...)
						PRINTFORML (원해... %MASTERNAME:87%의 정액을 입 가득...)
						PRINTFORMW 유난히 격렬해진 구강 성교가 당신을 사정으로 이끈다...
					ELSE
						PRINTFORMW 「줄루루, 주푸, 주우웅, 응쿠, 추프, 추프, 주푸, 음~~추우웅!」
						PRINTFORMW 당신의 한계를 깨달은 쇼가 일부러 음란한 물소리를 울리며 마지막 스퍼트를 낸다.
						PRINTFORMW 그 사정에 특화된 움직임에, 당신의 페니스는 간단히 결괴했다...
					ENDIF
				ELSE
					IF RAND:3 == 0
						PRINTFORML 「응쿠... 떨려... 응... 츄, 치로...」
						PRINTFORMW 집요하게 스즈구치(鈴口)를 혀끝으로 공격당하며 당신에게 한계가 다가온다...
					ELSEIF RAND:2 == 0
						PRINTFORMW 「후후, 마지막 일격을 가해버릴게요♪」
						PRINTFORMW 「흐으... 음냐아아아앙읏」
						PRINTFORMW 밑동부터 끝까지 한 번에 핥아 올리자 당신은 한계에 다다랐다...
					ELSE
						PRINTFORMW 「격렬하게 해 줄게요, 마음껏 터져 나올 정도로 부탁해요♪」
					ENDIF
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORML (나의, 그다지 잘하지 못하는 페라치오라도 %MASTERNAME:87%를 기쁘게 할 수 있는 것 같아)
					PRINTFORMW (하지만 좀 더 기분 좋아져 주었으면 해... 더 노력해야겠어)
				ELSEIF RAND:2 == 0
					PRINTFORML 「쭈욱, 음, 핥아, 응푸, 음... 갈 것 같으신가요?」
