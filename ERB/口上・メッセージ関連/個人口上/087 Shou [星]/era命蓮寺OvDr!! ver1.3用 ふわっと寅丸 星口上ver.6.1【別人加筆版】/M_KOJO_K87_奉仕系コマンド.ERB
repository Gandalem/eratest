;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K87_80
CALL M_KOJO_MESSAGE_COM_K87_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF TALENT:恋人
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;技巧3以上
			IF ABL:技巧 >= 3
				;精液中毒3以上
				IF ABL:精液中毒 >= 3
					IF RAND:2 == 0
						PRINTFORML 「여기예요, 전부, 혀에 올려주세요...」
						PRINTFORMW 쇼는 혀를 내밀고 그쪽으로 성기의 끝을 향했다...
					ELSE
						PRINTFORML 「아아... 빨리, 빨리 나의 입을 %MASTERNAME:87%의 씨앗으로 질척하게 해주세요%UNICODE(0x2665)%」
						PRINTFORMW 쇼는 참지 못하는 듯 손의 움직임을 빠르게 했다...
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「자, 주물러 드릴게요」
						PRINTFORMW 「%UNICODE(0x2665)% 마음껏 내도 돼요」
					ELSE
						PRINTFORMW 「격렬하게 해 줄게요, 마음껏 터져 나올 정도로 부탁해요♪」
					ENDIF
				ENDIF
			ELSE
				PRINTFORML (벌벌 떨고 있어... 나오는 거군요...)
				PRINTFORMW 사정의 조짐을 느낀 쇼는 작게 목을 울렸다...
			ENDIF
		ELSE
			DRAWLINE
			PRINTFORML 쇼는 손을 사용해 \@ PREVCOM == SELECTCOM ? 계속 봉사하고 있다 # 당신에게 봉사를 시작했다 \@...
			PRINTFORML 　
			;勃起しきっていない
			IF BASE:MASTER:勃起 < 1000
				IF RAND:2 == 0
					PRINTFORMW 「음, 아직 부드럽네요」
					PRINTFORMW 「하지만 금방 기운을 내게 해줄 테니까 %UNICODE(0x2665)%」
				ELSE
					PRINTFORML 쇼는 완전히 발기하지 않은 성기를 부드럽게 주무르고 있다.
					PRINTFORMW 「후후, 커져 왔어요♪」
					PRINTFORMW 「게다가 손가락을 튕기는 것처럼 단단해졌어…%UNICODE(0x2665)%」
				ENDIF
			ELSE
				;指のLv2以上か技巧4以上
				IF ABL:指 >= 2 || ABL:技巧 >= 4
					;※指のLv4以上で分岐追加
					SIF ABL:指 >= 4
						LOCAL:0 = 8
					SELECTCASE RAND(3 + LOCAL:0)
						;追加される分岐
						CASE 11
							PRINTFORMW 「후후, 괜찮아요... %UNICODE(0x2665)% 지금까지 사랑받은 만큼, 잔뜩 해드릴게요... %UNICODE(0x2665)%」
						CASE 10
							PRINTFORML 쇼의 뜨겁고 가는 손가락이, 당신의 \@ TALENT:PLAYER:2 == 1 ? 성기 # 음순을 \@천천히 쓸어 올린다…
							PRINTFORMW 「후후, 엄청 뜨거워지고 단단해져 있어… 이렇게 나 때문에 흥분해주고 있다니 기뻐…」
							PRINTFORMW 「크큭… 나와 같네…%UNICODE(0x2665)%」
						CASE 9
							PRINTFORMW 쇼는 당신의 \@ TALENT:PLAYER:2 == 1 ? 성기 # 음순 \@을 부드럽게 문지르며, 당신의 손을 잡고 귓가에 속삭였다…
							PRINTFORMW 「네… 저 여기에도 해줬으면 해요…」
						CASE 8
							PRINTFORMW 「아... 여기에 나에 대한 '좋아함'이 가득 담겨 있네요...♪」
							PRINTFORMW 「어디에 내고 싶으신가요...? 이대로 할까요? 입으로 말해드릴까요? 아니면...%UNICODE(0x2665)%」
						CASE 7
							PRINTFORML 「%MASTERNAME:87%의 여기... 움찔거리고 있어요...」
							PRINTFORMW 「이거 '안에 싸고, 별을 임신시키고 싶다'고 말하고 있는 거죠? 크크...♪」
							PRINTFORMW 「하지만 있잖아요... 저도 그렇게 해줬으면 좋겠다고, 그렇게 생각하고 있다고요...?」
						CASE 6
							PRINTFORML 한 손으로 성기를 자극하면서 빈 손으로 손가락의 고리를 만들고 목덜미를 비비고 있다.
							PRINTFORMW 「여기서도 민감하군요...%UNICODE(0x2665)%」
							PRINTFORML 「그럼 강하게 하는 거랑 부드럽게 하는 거, 어느 쪽이 좋아요?」
							PRINTFORMW 쇼는 능숙한 애무로 당신을 괴롭게 하면서 뜨거운 눈으로 바라본다...
						CASE 5
							PRINTFORML 「이렇게 부분만 해주는 것도 좋아하잖아?」
							PRINTFORMW 쇼는 엄지손가락의 배를 문지르듯이 귀두와 방울구만을 자극하고 있다.
							PRINTFORMW 「아하... %MASTERNAME:87%님의 정액이... 손끝에 걸쭉하게...」
						CASE 4
							PRINTFORML 「이 근처는… 엣지」
							PRINTFORMW 「후훗, 이런 줄 같은 부분을 만지면 움찔하게 되죠 %UNICODE(0x2665)%」		
							;元からの分岐
						CASE 3
							PRINTFORMW 「제 손가락, 기분 좋으세요?」
							PRINTFORMW 「히야♪ 후후, 이쪽에서 대답해 주셨네요」
							PRINTFORMW 당신의 성기가 떨리며 먼저 반응하자 쇼는 즐거운 듯 웃었다…
						CASE 2
							;MASTERが男性
							IF TALENT:PLAYER:2 == 2
								PRINTFORML 음경뿐만 아니라 음낭에도 손가락을 얽어 부드럽게 주무르고 있다...
								PRINTFORMW 「여기에 %MASTERNAME:87%의 씨앗이 들어있군요...%UNICODE(0x2665)%」
								SIF ABL:精液中毒 >= 3
									PRINTFORMW 「아하아... 어서 나에게 은혜를 베풀어 주세요... %UNICODE(0x2665)%」
								;MASTERがふたなり
							ELSE
								PRINTFORML 음경뿐만 아니라 음순에도 손을 뻗어 문지르고 있다...
								PRINTFORMW 「양쪽 모두 기분 좋게 해 드릴게요%UNICODE(0x2665)%」
							ENDIF
						CASE 1
							PRINTFORML 「아아... %MASTERNAME:87%의... 뜨거운... %UNICODE(0x2665)%」
							PRINTFORMW 「게다가... 냄새도 강해... %UNICODE(0x2665)% 손에 배어버릴 것 같아...」
						CASEELSE
							PRINTFORML 쇼는 속도 조절을 하며 성기를 쓸어 올리고 있다…
							PRINTFORMW 「자… 이번엔 빠르게 해버릴 거예요%UNICODE(0x2665)%」
							PRINTFORMW 당신의 허점을 파고나며 농락하는 것이 즐거운 듯하다
					ENDSELECT
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「양손 쪽이 좋을까...」
						PRINTFORMW 쇼는 손으로 감싸듯 페니스를 자극하기 시작했다.
						PRINTFORMW 당신의 음경이 따뜻한 감촉에 둘러진다...
					ELSE
						PRINTFORML 쇼는 열심히 손을 움직여 당신의 성기를 자극하고 있다...
						PRINTFORMW 「응, 어때요...?」
						PRINTFORMW 「아... 끝부분에서 애액이 나와... 다행이다, 기분 좋아지고 있네요%UNICODE(0x2665)%」
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
		;恋慕
		IF RAND:5 == 0
			PRINTFORML 「음... 그럼 받은 만큼, 제가 해 드릴게요...」
			PRINTFORMW 「어때요? 저 기분 좋게 하고 있나요...?」
		ELSEIF RAND:4 == 0
			PRINTFORML 쇼의 달아오른 손가락이, 당신의 \@ TALENT:PLAYER:2 == 1 ? 성기 # 음순 \@을 조심스럽게 쓸어 올린다...
			PRINTFORMW 「우와, 와... 이렇게 뜨겁고, 미끌미끌해서...」
		ELSEIF RAND:3 == 0
			PRINTFORML 쇼는 당신의 \@ TALENT:PLAYER:2 == 1 ? 성기를 # 음순을 \@ 부드럽게 문지르며 당신에게 파고든다...
			PRINTFORMW 어쩐지, 자신의 은밀한 곳을 비비고 오는 듯한 기분이 들었다...
		ELSEIF RAND:2 == 0
			PRINTFORMW (나, 지금 %MASTERNAME:87%의...를 애무해주고 있는 거네요...)
			PRINTFORMW (%MASTERNAME:87%가 해주었을 때도 이런 기분이었을까요...?)
		ELSE
			PRINTFORMW 「아... 굉장해... %MASTERNAME:87%의, 파르르 떨고 있어요...」
			PRINTFORMW (흥분하고 있을 때의 나의...와 똑같죠... 후훗♪)
		ENDIF
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「손으로, 그렇죠... 좋아요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후후, 제 차례군요」
		ELSE
			PRINTFORMW 「그럼 실례하겠습니다... 이런 느낌인가요」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「저, 제가 손으로... 말인가요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「저, 제가 하는 건가요...?」
		ELSE
			PRINTFORMW 아... 그... 저, 이런 느낌으로 괜찮을까요...?
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
