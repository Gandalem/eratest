@M_KOJO_MESSAGE_SCOM_K87_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		SIF CFLAG:1501 == 0
			DRAWLINE
		PRINTFORMW 「히앗!? 지금, 방금... 왔어요...」
		PRINTFORMW 「%MASTERNAME:87%... 뭐, 하신 거예요...?」
		RETURN 1
	ENDIF
	;基本セット
	;※CFLAG:1501 == 1でＧスポ責めしている時、0で選んだコマンドで継続して突いている時の口上
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
	ELSE
		;挿入Ｇスポ責め
		IF CFLAG:1501 == 1
			CFLAG:1501 = 0
			;Ｖ感覚1以下
			IF ABL:Ｖ感覚 <= 1
				;/Ｖ敏感！
				PRINTFORMW 「으, 아……%UNICODE(0x2665)% 이거, 안 돼요…윽」
				PRINTFORMW 「이거, 기억해버리면… 나…」
				;恋慕
			ELSEIF TALENT:恋慕
				;これでMASTERが射精
				IF NOWEX:PLAYER:11
					;これでTARGETがＶ絶頂する
					IF NOWEX:1
						PRINTFORML 「속, 꽉 조여와... 아아......%UNICODE(0x2665)% 벌써, 와버릴 것 같아...」
						PRINTFORMW 「큭!? 부풀어 올랐어...! 안 돼! 지금 거기서 나오면...!」
					ELSE
						PRINTFORML 「%MASTERNAME:87%…내보여주세요, 정말로요…」
						PRINTFORMW 「제 안으로 %MASTERNAME:87%의… 잔뜩 주세요%UNICODE(0x2665)%」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「저, 여기…… 저릿한 것처럼……%UNICODE(0x2665)%」
						PRINTFORMW 「후우……%UNICODE(0x2665)% 세게 해버릴 것 같아… 아앗…%UNICODE(0x2665)%」
					ELSE
						PRINTFORML 「우앗 %UNICODE(0x2665)%! 또, 굉장한 게 왔어요……」
						PRINTFORMW 「정말로, 버리고 말아요… 참지 못하는 아이가 되어버려요…%UNICODE(0x2665)%」
					ENDIF
				ENDIF
				;不埒3
			ELSEIF MARK:不埒刻印 == 3
				PRINTFORMW 「거기... 더 문질러 주세요...%UNICODE(0x2665)%」
				;それ以外
			ELSE
				PRINTFORMW 「응... 간지러워, 기분 좋아...」
			ENDIF
			;連続
		ELSE
			DRAWLINE
			;正常位、対面立位
			IF TEQUIP:体位 == 1
				;MASTERについている
				IF TALENT:PLAYER:2 & 2
					PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 질 내부의 감촉을 느끼며, 다시 허리를 움직이기 시작했다…
				ELSE
					PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 질 내부에서 빼지 않고, 다시 허리를 움직이기 시작했다...
				ENDIF
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_60_1
				;後背位、背面立位
			ELSEIF TEQUIP:体位 == 2
				;MASTERについている
				IF TALENT:PLAYER:2 & 2
					PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 질 내부의 감촉을 느끼며, 다시 허리를 움직이기 시작했다…
				ELSE
					PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 질 내부에서 빼지 않고, 다시 허리를 움직이기 시작했다...
				ENDIF
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_61_1
				;騎乗位
			ELSEIF TEQUIP:体位 == 3
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 삽입된 채의 페니스를 조여오며, 다시 허리를 움직이기 시작했다...
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_65_1
				;対面座位
			ELSEIF TEQUIP:体位 == 4
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) %조사처리(CALLNAME:PLAYER,"와")% 키스를 하고, 혀를 얽으면서 다시 허리를 흔들기 시작했다...
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_67_1
				;背面座位
			ELSE
				PRINTFORMW %조사처리(CALLNAME:TARGET,"를")% 등 뒤에서 껴안고, 다시 %조사처리(CALLNAME:TARGET,"의")% 몸을 흔들기 시작했다...
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_68_1
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
