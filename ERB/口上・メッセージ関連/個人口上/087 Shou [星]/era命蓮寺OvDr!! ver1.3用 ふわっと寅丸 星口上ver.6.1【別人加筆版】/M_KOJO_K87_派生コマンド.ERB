	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 『%MASTERNAME:87%… 굉장해… 점점 커져서…%UNICODE(0x2665)%』
				PRINTFORML %CALLNAME:LOCAL%의 혀끝으로 부풀어 오르는 욕망을 앞에 두고, 쇼는 감탄의 소리를 냈다.
