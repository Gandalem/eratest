				PRINTFORML 『こんな、いやらしいこと…%UNICODE(0x2665)%』
				PRINTFORMW その瞳には、羞恥よりもむしろ喜悦の色が浮かんでいた…
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1

