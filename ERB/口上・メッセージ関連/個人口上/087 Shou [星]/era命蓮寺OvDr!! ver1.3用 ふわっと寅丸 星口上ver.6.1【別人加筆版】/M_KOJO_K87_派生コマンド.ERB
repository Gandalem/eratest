;二人目口上
@M_KOJO_MESSAGE_SCOM_K87_9_2
VARSET LOCAL
;一人目
LOCAL:101 = MASTER_POSE(SET_M,SET_P)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;一人目のID＠口で,MASTERのペニスを,このターンに占有中のキャラ
	;上ですでにLOCAL:101に一人目のIDを代入してもらっているものの、
	;行儀悪いけど楽なのでLOCALに代入
	;一人目口上の後に呼び出されるため、台詞は『』でくくるようにしています
	LOCAL =  MASTER_POSE(4,1)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 『%MASTERNAME:87%…すごい…どんどん大きくなって…%UNICODE(0x2665)%』
				PRINTFORML %CALLNAME:LOCAL%の舌先で膨れ上がる欲望を前に、星は感嘆の声を上げる
				PRINTFORMW 『あむ、れる、ちゅぷ…私も一緒に舐めたら、もっと大きくなるでしょうか…？』
			CASE 1
				PRINTFORML 『根っこから行きますよ…ぺろっ…れる、れろぉ…っ%UNICODE(0x2665)%』
				PRINTFORML 星は舌先で陰嚢を撫でまわし、%CALLNAME:MASTER%と%CALLNAME:LOCAL%の姿を上目遣いに確認しながらじっくりとペニスを舐め上げた
				PRINTFORML 『こうして一緒に舐めてると、顔がすごく近くて…少し緊張しちゃいますね』
				PRINTFORMW はにかんだ笑みを浮かべながらも、星は%CALLNAME:LOCAL%とともに熱心な口淫を続けた…
			CASE 2
				PRINTFORML 『ふふ、%MASTERNAME:87%、とっても可愛い顔してますよ…』
				PRINTFORM 『%CALLNAME:LOCAL%
				;呼称変。　響子なら「ちゃん」、マミゾウなら「さん」
				;SIF GROUPMATCH(LOCAL,キャラ番号1,キャラ番号2,…)とすれば、複数キャラに適用可。
				;寺メンバー こいし:38, ナズーリン:39, 小傘:40,ぬえ:41，聖: 55, マミゾウ:69,一輪:85, ムラサ:86, 響子:88, 女苑:125
				SIF LOCAL == 88
					PRINT ちゃん
				SIF LOCAL == 69
					PRINT さん
				PRINTFORML のお口が気持ちいいんですね…%UNICODE(0x2665)%』
				PRINTFORML 『次は私のお口でも可愛がってあげます…ぁむ、かぷん、ちゅるるぅっ%UNICODE(0x2665)%』
				PRINTFORMW %CALLNAME:LOCAL%と星はかわるがわる%CALLNAME:MASTER%の陰茎を口に含んで奉仕している…
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF

