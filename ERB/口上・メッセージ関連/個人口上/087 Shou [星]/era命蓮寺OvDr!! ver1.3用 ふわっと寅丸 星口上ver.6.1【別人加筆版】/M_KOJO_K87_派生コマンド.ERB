;==================================================
;3,Gスポット刺激
;==================================================
@M_KOJO_MESSAGE_SCOM_K87_3
CALL M_KOJO_MESSAGE_SCOM_K87_3_1
RETURN RESULT
@M_KOJO_MESSAGE_SCOM_K87_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		;Ｖ経験30以下
		IF EXP:Ｖ経験 <= 30
			PRINTFORMW 「そこ、刺激…強すぎてっ……」
		ELSEIF TEQUIP:バイブ
			PRINTFORML 「いぅうっ%UNICODE(0x2665)%　だめ、それ、やめてくださひっ%UNICODE(0x2665)%」
			PRINTFORMW バイブの振動にザラつきを的確に捕らえられて揺さぶられ、星は顔を蕩けさせている…
		ELSE
			IF RAND:4 == 0
				PRINTFORML 「あうっ%UNICODE(0x2665)%　そこ、つよぃい……ひゃうっ%UNICODE(0x2665)%」
				PRINTFORMW 星は首をいやいやと左右に振りながらGスポットへの刺激に身体を震わせている
				SIF EXP:Ｖ経験 > 120
				PRINTFORMW しかし言葉とは裏腹に膣肉は貪欲に指に絡みつき、その顔は歓喜に満ちている…
			ELSEIF RAND:3 == 0
				PRINTFORMW 「あ！？、お、くっ%UNICODE(0x2665)%　ふぃいっ、ひ、ぃいっ%UNICODE(0x2665)%」
				PRINTFORMW 「そこ、ばっかりっ%UNICODE(0x2665)%！　いじめないで、くださいよぉっ%UNICODE(0x2665)%！」
				PRINTFORMW 敏感な箇所を責められ続け、星はすっかり息も絶え絶えになってしまっている
			ELSEIF RAND:2 == 0
				PRINTFORML 「あぁーっ%UNICODE(0x2665)%　そこ、押しちゃだめですっ%UNICODE(0x2665)%！」
				PRINTFORMW ザラつきを刺激するたびに星の嬌声が響きわたる…
			ELSE
				PRINTFORML 「ふああぁんっ%UNICODE(0x2665)%！　かりって、しちゃ…だ、めぇ……%UNICODE(0x2665)%」
				PRINTFORMW 傷つけないよう優しく爪で擦ってやると星は大きく身体を跳ねさせた
			ENDIF
		ENDIF
		RETURN 1
	;不埒3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K87_{SELECTCOM}_1
RETURN 1

;==================================================
;6,挿入Ｇスポ責め
;※挿入子宮口責めになるかはランダム
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K87_6
;口上分岐
IF RAND:2 == 0
	CFLAG:1501 = 1
ELSE
	CFLAG:1501 = 0
ENDIF
;※早い話が1/2でＧスポ責めの地の文を呼ばない
SIF CFLAG:1501 == 1
	RETURN 0
RETURN 1

@M_KOJO_MESSAGE_SCOM_K87_6
CALL M_KOJO_MESSAGE_SCOM_K87_6_1
RETURN RESULT
@M_KOJO_MESSAGE_SCOM_K87_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		SIF CFLAG:1501 == 0
		DRAWLINE
		PRINTFORMW 「ひぁっ！？　今、びりって…きました…」
		PRINTFORMW 「%MASTERNAME:87%…なに、したんですかぁ…？」
		RETURN 1
	ENDIF
	;基本セット
	;※CFLAG:1501 == 1でＧスポ責めしている時、0で選んだコマンドで継続して突いている時の口上
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
	ELSE
		;挿入Ｇスポ責め
		IF CFLAG:1501 == 1
			CFLAG:1501 = 0
			;Ｖ感覚1以下
			IF ABL:Ｖ感覚 <= 1
				;/Ｖ敏感！
				PRINTFORMW 「う、ぁ……%UNICODE(0x2665)%　これ、ダメです…っ」
				PRINTFORMW 「これ、覚えちゃったら…私っ……」
			;恋慕
			ELSEIF TALENT:恋慕
				;これでMASTERが射精
				IF NOWEX:PLAYER:11
					;これでTARGETがＶ絶頂する
					IF NOWEX:1
						PRINTFORML 「奥、きゅーって…あぁ……%UNICODE(0x2665)%　もう、きちゃ…」
						PRINTFORMW 「ふぁっ！？　膨らんで…！？　だめです！今そこに出されたら…っ」
					ELSE
						PRINTFORML 「%MASTERNAME:87%…出そう、なんですね…」
						PRINTFORMW 「私の中に、%MASTERNAME:87%の…いっぱい、ください%UNICODE(0x2665)%」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「そ、こ……っ　痺れてるみたいに…っ%UNICODE(0x2665)%」
						PRINTFORMW 「ふぃい…%UNICODE(0x2665)%　強くしちゃ…うぁあ…%UNICODE(0x2665)%」
					ELSE
						PRINTFORML 「うあっ%UNICODE(0x2665)%！　また、すごいのきましたぁ……」
						PRINTFORMW 「ほんとに、癖に、なっちゃいます…　我慢できない子になっちゃいますぅ…%UNICODE(0x2665)%」
					ENDIF
				ENDIF
			;不埒3
			ELSEIF MARK:不埒刻印 == 3
				PRINTFORMW 「そこ…もっと擦ってください…%UNICODE(0x2665)%」
			;それ以外
			ELSE
				PRINTFORMW 「んっ…　じりじりして、気持ちいい…」
			ENDIF
		;連続
		ELSE
			DRAWLINE
			;正常位、対面立位
			IF TEQUIP:体位 == 1
				;MASTERについている
				IF TALENT:PLAYER:2 & 2
					PRINTFORMW %CALLNAME:TARGET%の膣内の感触を味わいながら、再び腰を動かし始めた…
				ELSE
					PRINTFORMW %CALLNAME:TARGET%の膣内から抜かずに、再び腰を動かし始めた…
				ENDIF
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_60_1
			;後背位、背面立位
			ELSEIF TEQUIP:体位 == 2
				;MASTERについている
				IF TALENT:PLAYER:2 & 2
					PRINTFORMW %CALLNAME:TARGET%の膣内の感触を味わいながら、再び腰を動かし始めた…
				ELSE
					PRINTFORMW %CALLNAME:TARGET%の膣内から抜かずに、再び腰を動かし始めた…
				ENDIF
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_61_1
			;騎乗位
			ELSEIF TEQUIP:体位 == 3
				PRINTFORMW %CALLNAME:TARGET%は挿入されたままのペニスを締め付け、再び腰を動かし始めた…
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_65_1
			;対面座位
			ELSEIF TEQUIP:体位 == 4
				PRINTFORMW %CALLNAME:TARGET%は%CALLNAME:PLAYER%とキスをし、舌を絡めながら再び腰を揺すり始めた…
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_67_1
			;背面座位
			ELSE
				PRINTFORMW %CALLNAME:TARGET%を背後から抱きしめ、再び%CALLNAME:TARGET%の身体を揺らし始めた…
				PRINTFORML 　
				CALL M_KOJO_MESSAGE_COM_K87_68_1
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
