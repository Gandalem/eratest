@M_KOJO_MESSAGE_SCOM_K87_11_2
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;一人目のID＠胸で,MASTERのペニスを,このターンに占有中のキャラ
	;行儀悪いけど楽なのでLOCALに代入
	;一人目口上の後に呼び出されるため、台詞は『』でくくるようにしています
	LOCAL = MASTER_POSE(5,1)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 『%MASTERNAME:87%의 거시기, 파르르 떨리고 있어요... 후후♪』
				PRINTFORML 『사정하고 싶으세요? 하지만 아직 안 돼요?』
				PRINTFORMW 『참고 있는 %MASTERNAME:87%의 애처롭고 가여운 아주 귀여운 얼굴, 저희에게 더 보여주세요 %UNICODE(0x2665)%』
			CASE 1
				PRINTFORML 『아, 아앗%UNICODE(0x2665)%이거... 유두가, 고추에도 가슴에도 스치면서...』
				PRINTFORML 『야아앗... %MASTERNAME:87%에게 해주고 있는데, 나까지... %UNICODE(0x2665)%』
				PRINTFORMW 호시는 매혹적인 숨을 내쉬며 몸을 파르르 떨고 있다...
			CASE 2
				PRINTFORM 하, 아... 아아... %MASTERNAME:87% 것을
				;呼称変。　響子なら「ちゃん」、マミゾウなら「さん」
				;SIF GROUPMATCH(LOCAL,キャラ番号1,キャラ番号2,…)とすれば、複数キャラに適用可。
				;寺メンバー こいし:38, ナズーリン:39, 小傘:40,ぬえ:41，聖: 55, マミゾウ:69,一輪:85, ムラサ:86, 響子:88, 女苑:125
				IF LOCAL == 88
					PRINTFORM %CALLNAME:LOCAL%짱
				ELSEIF LOCAL == 69
					PRINTFORM %CALLNAME:LOCAL%님
				ELSEIF LOCAL == 55
					PRINTFORM 히지리
				ELSE
					PRINTFORM %CALLNAME:LOCAL%
				ENDIF
				PRINTFORML 함께 가슴으로 비비다니...」
				PRINTFORML 쇼는 자신의 치태를 확인하듯, 목이 올라간 목소리로 중얼거리고 있다.
				PRINTFORML 『이렇게 야한 일이라니...%UNICODE(0x2665)%』
				PRINTFORMW 그 눈동자에는 수치심보다 오히려 기쁨의 빛이 떠 있었다...
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
