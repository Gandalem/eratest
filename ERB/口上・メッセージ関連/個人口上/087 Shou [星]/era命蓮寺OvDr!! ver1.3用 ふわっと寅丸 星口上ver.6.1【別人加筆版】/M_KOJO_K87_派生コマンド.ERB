@M_KOJO_MESSAGE_SCOM_K87_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;Ｖ経験30以下
		IF EXP:Ｖ経験 <= 30
			PRINTFORMW 「거기, 자극... 너무 강해서...」
		ELSEIF TEQUIP:バイブ
			PRINTFORML 「うぅ%UNICODE(0x2665)%だめ、それやめてください읏%UNICODE(0x2665)%」
			PRINTFORMW 바이브의 진동에 거친 감촉을 정확히 파악당하며 흔들리고, 쇼는 얼굴을 녹이고 있다...
		ELSE
			IF RAND:4 == 0
				PRINTFORML 「아우윽%UNICODE(0x2665)% 거긴, 너무 세어... 히야윽%UNICODE(0x2665)%」
				PRINTFORMW 쇼는 고개를 연신 좌우로 흔들며 G스팟 자극에 몸을 떨고 있다
				SIF EXP:Ｖ経験 > 120
					PRINTFORMW 하지만 말과는 달리 질 속 살은 탐욕스럽게 손가락에 감겼고, 그 얼굴은 환희로 가득 차 있었다...
			ELSEIF RAND:3 == 0
				PRINTFORMW 「아!? 저, 윽%UNICODE(0x2665)% 후우, 하, 아앗%UNICODE(0x2665)%」
				PRINTFORMW 「거기만 계속!! 괴롭히지 말아 주세요어%UNICODE(0x2665)%!」
				PRINTFORMW 민감한 부위를 계속 공격당해, 쇼는 완전히 숨이 막혀버렸다.
			ELSEIF RAND:2 == 0
				PRINTFORML 「아아악 %UNICODE(0x2665)% 거긴, 누르시면 안 돼요읏 %UNICODE(0x2665)%!」
				PRINTFORMW 거친 감촉을 자극할 때마다 쇼의 신음소리가 울려 퍼졌다…
			ELSE
				PRINTFORML 「후아앙%UNICODE(0x2665)%! 그, 하지 말아... 안 돼...%UNICODE(0x2665)%」
				PRINTFORMW 상처 내지 않도록 부드럽게 손톱으로 문질러주자 쇼는 크게 몸을 움찔거렸다.
			ENDIF
		ENDIF
		RETURN 1
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
