;311,抱き付く
;==================================================

@M_KOJO_MESSAGE_COM_K87_311
CALL M_KOJO_MESSAGE_COM_K87_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:TARGET:睡眠
		IF ABL:親密 >= 8
			IF RAND:2 == 0
				PRINTFORMW 「응... %UNICODE(0x2665)%」
			ELSE
				PRINTFORMW 「스으... 스으......... 후훗」
			ENDIF
		ELSE
			PRINTFORMW 「음…… 음우...」
		ENDIF
		;添い寝中
	ELSEIF CFLAG:添い寝中
		IF ABL:親密 >= 8
			IF RAND:3 == 0
				PRINTFORML 「그럼 나는... 자, 이리.」
				PRINTFORML 쇼는 당신의 팔을 잡고 그 품에 안겼다.
				PRINTFORMW 「따뜻해... 이대로 잠들어 버리고 싶을 정도야...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「후후... 포근하네요%UNICODE(0x2665)%」
			ELSE
				PRINTFORMW 「에헤헤, %MASTERNAME:87%읏%UNICODE(0x2665)%」
			ENDIF
		ELSE
			PRINTFORML 「이불 속에서 서로 안고 있으면... 뭐라고 할까... 그...」
			PRINTFORMW 쇼의 뺨은 은은하게 물들어 있다.
		ENDIF
		;押し倒された
	ELSEIF CFLAG:うふふ == 2
		;カウンターキス
		IF TCVAR:20 == 30
			PRINTFORML 「응, 응!? ……음, 후훗…」
			PRINTFORML 입술을 떼려던 것을 붙잡힌 쇼는 순간 움찔했지만
			PRINTFORMW 이어지는 당신의 입맞춤에 안심한 듯 몸을 맡겼다…
			;カウンター素股
		ELSEIF TCVAR:20 == 52
			IF RAND:2 == 0
				PRINTFORML 당신이 별을 안아주자 두 사람의 은밀한 곳은 더욱 강하게 밀착되었다.
				PRINTFORMW 「아... 하읏, 스치면서... %UNICODE(0x2665)% %MASTERNAME:87%... %UNICODE(0x2665)%」
			ELSE
				PRINTFORML 「음냐……윽…아앗…뜨거워어…%UNICODE(0x2665)%」
				PRINTFORMW 쇼는 쓰러지듯 당신과 포개져 부드럽게 허리를 움직이고 있다.
			ENDIF
			;カウンターディープキス
		ELSEIF TCVAR:20 == 60
			PRINTFORML 「츄루욱…응쿠…응응, %MASTERNAME:87%…%UNICODE(0x2665)%」
			PRINTFORMW 서로를 갈구하는 당신과 쇼는 혀도 몸도 밀착하며 뒤엉켜 있다.
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「더, 더……%MASTERNAME:87%의…」
				PRINTFORMW 쇼는 조금이라도 많은 부분을 당신에게 접하게 하려고 몸을 비비고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「더 세게, 안아주세요…」
			ELSE
				PRINTFORML 「~~~~옷」
				PRINTFORMW 쇼를 끌어안자, 쇼도 온 힘을 다해 몸을 밀착시켜 왔다...
			ENDIF
		ENDIF
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:8 == 0
			PRINTFORMW 「저기, %MASTERNAME:87%」
			PRINTFORMW 「나 지금 엄청 행복해...%UNICODE(0x2665)%」
		ELSEIF RAND:7 == 0
			PRINTFORMW 「…이렇게 있는 것만으로도, 당신의 모든 것이 갖고 싶어집니다…」
			PRINTFORMW 「욕심이 많네요, 저…」
		ELSEIF RAND:6 == 0
			PRINTFORML 「음... 더...... 꽉, 안아주세요...」
			PRINTFORMW 쇼의 귀여운 부탁에 당신은 확실하게 응해 주었다.
		ELSEIF RAND:5 == 0
			PRINTFORML 「음...♪」
			PRINTFORMW 쇼도, 안아주는 당신의 몸에 얼굴을 비볐다...
		ELSEIF RAND:4 == 0
			PRINTFORMW 「저기, %MASTERNAME:87%... 그, 손이 이상한 곳을 만져서... 응!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「이렇게 있으면... 점점 이상한 기분이 들어요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「벌써, 애교쟁이시네요...%UNICODE(0x2665)%」
		ELSE
			PRINTFORML 쇼는 당신의 품에 얼굴을 파묻고 크게 숨을 들이켰다.
			PRINTFORMW 「하아… %MASTERNAME:87%의 냄새, 저 좋아요♪」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:親密 >= 8
			IF RAND:5 == 0
				PRINTFORML (이 다정한 사람에게, 내 마음을 전하고 싶어... 하지만)
				PRINTFORMW (더 이상 바란다면... 이 관계도 무너져 버릴까)
			ELSEIF RAND:4 == 0
				PRINTFORML (좋아하는 사람에게 안기니, 나는 행복한 사람이네요... 하지만)
				PRINTFORMW (언제까지 이 상황에 안주하고만 있을 수는 없죠...)
			ELSEIF RAND:3 == 0
				PRINTFORML 「음... 더...... 꽉, 안아주세요...」
				PRINTFORMW 쇼의 귀여운 부탁에 당신은 확실하게 응해 주었다.
			ELSEIF RAND:2 == 0
				PRINTFORML 쇼는 당신의 가슴에 얼굴을 묻고 크게 숨을 들이마셨다.
				PRINTFORMW 「하아... %MASTERNAME:87%의 냄새... 왠지 마음이 편안해져♪」
			ELSE
				PRINTFORML (%MASTERNAME:87%가 무엇을 생각해서 이렇게 해주는 건지는 모르겠지만)
				PRINTFORMW (계속, 이렇게 있고 싶어요... %UNICODE(0x2665)% )
			ENDIF
		ELSEIF ABL:親密 >= 4
			IF RAND:2 == 0
				PRINTFORMW 「～～～」
				PRINTFORMW 당신이 포옹하자, 쇼는 굳어버렸다...
			ELSE
				PRINTFORMW 「흐, 갑자기 그런 일 하지 마세요...」
				PRINTFORMW 「아, 아니에요, 그게... 싫지 않아요?」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「아, 안아줘...」
			ELSE
				PRINTFORMW 당신의 포옹에 쇼는 혼란스러워하고 있다.
			ENDIF
		ENDIF
	ELSE
		IF ABL:親密 >= 8
			IF RAND:3 == 0
				PRINTFORMW 「어쩌신 거예요, 벌써…」
				PRINTFORMW 쇼는 크크 웃고 있었다.
			ELSEIF RAND:2 == 0
				PRINTFORML 쇼는 당신의 가슴에 얼굴을 묻고 크게 숨을 들이마셨다.
				PRINTFORMW 「하아... %MASTERNAME:87%의 냄새... 왠지 마음이 편안해져♪」
			ELSE
				PRINTFORMW 당신의 온기에 감싸여, 쇼는 행복하게 눈을 가늘게 뜨고 있다.
			ENDIF
		ELSEIF ABL:親密 >= 4
			IF RAND:2 == 0
				PRINTFORMW 「이제... 갑자기 왜 그러시는 거예요」
			ELSE
				PRINTFORMW 「저, 잠시만요... %MASTERNAME:87%...」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「아, 안아줘...」
			ELSE
				PRINTFORMW 당신의 포옹에 쇼는 혼란스러워하고 있다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
