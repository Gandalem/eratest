@M_KOJO_MESSAGE_COM_K87_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠
	IF CFLAG:TARGET:睡眠
		IF ABL:Ｂ感覚 <= 1
			PRINTFORMW 「ん…う」
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「は…ぁ……ぁ」
			ELSE
				PRINTFORML 「んっ……はっ…んっ…」
				PRINTFORMW 胸の先端にあたりをつけて指先でかくと詰まるような喘ぎが聞こえてきた
			ENDIF
		ENDIF
	;うふふ
	;押し倒された
	ELSEIF CFLAG:うふふ == 2
		IF ABL:Ｂ感覚 <= 1
			IF RAND:2 == 0
				PRINTFORML 「ふ、やっ、あは、ひゃっ」
				PRINTFORMW 星は胸に触れられるくすぐったさにその背をぴくぴくと震わせている
			ELSE
				PRINTFORMW 「んん…やぁ……ん」
			ENDIF
		ELSE
			;カウンター胸を揉ませる
			IF TCVAR:20 == 33
				IF RAND:3 == 0
					PRINTFORML 「あっ…　%MASTERNAME:87%……　そこ、良いですっ…！」
					PRINTFORMW 星は自らも胸を揉みしだき重なる刺激に感じ入っている
				ELSEIF RAND:2 == 0
					PRINTFORMW 「ふ、ぁあ…そこ…もっと揉んでください…」
				ELSE
					PRINTFORML 「あ、くあ……はんっ…んん…」
					PRINTFORMW 星に導かれるままに胸を揉みこんでやると甘い声が上がった
				ENDIF
