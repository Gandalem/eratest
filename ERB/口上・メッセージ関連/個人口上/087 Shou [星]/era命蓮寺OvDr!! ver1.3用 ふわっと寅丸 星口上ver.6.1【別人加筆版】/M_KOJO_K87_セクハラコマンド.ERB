;310,尻を撫でる
;==================================================

@M_KOJO_MESSAGE_COM_K87_310
CALL M_KOJO_MESSAGE_COM_K87_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:TARGET:睡眠
		IF ABL:親密 > 5
			PRINTFORML 「음... 후...」
			PRINTFORMW 엉덩이를 타고 흐르는 희미한 감각에 쇼는 허리를 비틀고 있다.
		ELSE
			PRINTFORML 「………스윽」
			PRINTFORMW 엉덩이를 만지는 감촉이 사라지자 다시 쇼는 잠꼬리를 하기 시작했다.
		ENDIF
	ELSEIF CFLAG:添い寝中
		;押し倒された
	ELSEIF CFLAG:うふふ == 2
		;カウンター前から抱きつく
		IF TCVAR:20 == 32
			PRINTFORML 「앗……후, 아앗……」
			PRINTFORMW 몸을 통해 엉덩이를 주무르던 쇼는 눈을 감고 당신에게 매달리듯이 신음 소리를 냈다
			;カウンターパイズリ
		ELSEIF TCVAR:20 == 53
			;シックスナイン体勢
			IF TEQUIP:シックスナイン
				IF RAND:2 == 0
					PRINTFORML 「앙... 이제... 응... 보답이에요%UNICODE(0x2665)%」
					PRINTFORMW 쇼는 당신의 단단한 것을 감싼 채 끝에 혀를 가져다 댔다.
				ELSE
					PRINTFORMW 「안 돼... 엉덩이 만지지 말아 주세요...」
				ENDIF
			ELSE
				;※非シックスナイン時は尻は揉めるが穴は不可。　体勢は深く考えずに「尻をこちらに向けていない」程度の認識で良いか
				IF RAND:2 == 0
					PRINTFORMW 「응... 움직이지 않으면... 잘... %UNICODE(0x2665)% 할 수가 없잖아요...」
				ELSE
					PRINTFORMW 「히얏! ...그러니까 한가하다고 엉덩이로 놀지 말아 주세요...」
				ENDIF
			ENDIF
			;カウンタークンニ強制
		ELSEIF TCVAR:20 == 70
			;パンツ～ズボンを履いている
			IF TEQUIP:0 > 1
				PRINTFORMW 천을 통해라도 그녀의 엉덩이가 부드러운 느낌이 손바닥에 전해온다...
				;ノーパン～ノーパンスカート
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「히, 햐아……응…」
					PRINTFORML 비밀스러운 곳을 핥아 올린 쇼는 무의식적으로 웅크렸다
					PRINTFORMW 그렇게 내민 엉덩이를 당신은 천천히 주물러주었다
				ELSE
					PRINTFORML 「푸와앗!」
					PRINTFORMW 음순과 엉덩이 살에 대한 동시 공격에 쇼는 참지 못하고 허리를 들썩였다.
				ENDIF
			ENDIF
			;カウンターアナル奉仕
		ELSEIF TCVAR:20 == 72
			IF TEQUIP:0 > 1
				PRINTFORML 엉덩이 구멍 주변을 혀끝으로 건드리자 움찔 반응하는 것을 알았다
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「응, 하, 아아아아아아……윽」
					PRINTFORMW 항내를 오가는 축축한 열기에 쇼는 거칠게 숨을 몰아쉬고 있다
				ELSE
					PRINTFORML 항문이 움찔움찔 수축하는 것이 혀에 전해온다…
					PRINTFORMW 「히으, 아, 뜨거워, 아, 우아아」
				ENDIF
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「아, 엉덩이......가, 아앗」
			ELSEIF RAND:2 == 0
				PRINTFORMW 엉덩이 골을 따라 쓰다듬어지자 쇼는 부들부들 몸을 떨었다.
			ELSE
				PRINTFORML 「후욱, 음...」
				PRINTFORMW 쇼는 엉덩이를 내밀듯이 허리를 비틀고 있다
			ENDIF
		ENDIF
	ELSE
		IF ABL:親密 > 5
			IF RAND:3 == 0
				PRINTFORML 「야, 응...」
				PRINTFORMW 쇼는 달콤한 목소리를 내는 것을 참는 듯했다.
			ELSEIF RAND:2 == 0
				PRINTFORML 「아……, %MASTERNAME:87%… 안 돼요…」
				PRINTFORMW 별의 용서를 구하는 듯한 올려다보는 시선은 당신의 가학적인 마음을 자극할 뿐이었다...
			ELSE
				PRINTFORMW 「벌써... %MASTERNAME:87%는 야하잖아요...」
			ENDIF
		ELSEIF ABL:親密 > 2
			IF RAND:3 == 0
				PRINTFORMW 「안 돼요, 이제!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「히야앗!? 뭐, 뭘 하시는 거예요!」
			ELSE
				PRINTFORMW 하지만 부끄러운 듯 얼굴을 붉히는 쇼는 꽤 귀여웠다
			ENDIF
		ELSE
			PRINTFORMW 「너무 많이 해주면 화낼 거예요?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
