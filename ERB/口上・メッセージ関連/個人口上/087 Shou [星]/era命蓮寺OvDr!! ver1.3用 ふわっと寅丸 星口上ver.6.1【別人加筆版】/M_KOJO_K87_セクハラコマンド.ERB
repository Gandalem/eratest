;312,キスする
;==================================================

@M_KOJO_MESSAGE_COM_K87_312
CALL M_KOJO_MESSAGE_COM_K87_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;失敗
	IF TFLAG:193 == 99
		PRINTFORMW 「안녕…… 그만두세요……윽」
		;成功
	ELSE
		;睡眠
		IF CFLAG:TARGET:睡眠
			IF ABL:親密 >= 5
				PRINTFORMW 「음... 후후...」
			ELSE
				PRINTFORMW 「우으... 음...」
			ENDIF
			;ファーストキス
		ELSEIF EXP:TARGET:キス経験 == 1
			;恋慕
			IF TALENT:恋慕
				PRINTFORMW 「처음의 키스는 레몬 맛이라고 들었는데요...」
				PRINTFORMW 「레몬 같은 것보다 훨씬 더 멋졌어요%UNICODE(0x2665)%」
				PRINTFORMW 쇼는 행복하게 수줍게 웃고 있다...
			ELSEIF ABL:親密 >= 5
				PRINTFORMW 「첫 키스...」
				PRINTFORMW 「%MASTERNAME:87%가 상대라면 나쁘지 않네요♪」
				PRINTFORMW 쇼는 어딘가 기뻐 보인다
			ELSE
				PRINTFORMW 「저, 갑자기 왜 그러세요...?」
				PRINTFORMW 「누군가와 키스하는 건 처음이었으니까요... 벌써...」
			ENDIF
			;うふふ
			;押し倒された
		ELSEIF CFLAG:うふふ == 2
			;カウンターキス
			IF TCVAR:20 == 30
				IF RAND:2 == 0
					PRINTFORML 당신의 키스에 대한 보답으로 불이 붙은 쇼는 더욱 입맞춤을 원하며 다가왔다.
					PRINTFORML 「음… 츄… 읏… 츄…… 츄욱」
					PRINTFORMW 쇼와 당신은 서로의 입술 끝을 수없이 반복해서 맞댔다.
					;/ちゅっちゅ！
				ELSE
					PRINTFORML 「%MASTERNAME:87%…… 한 번만 더…」
					PRINTFORMW 쇼는 더욱더 당신의 입맞춤을 갈망했다.
				ENDIF
				;カウンター手淫
			ELSEIF TCVAR:20 == 50
				IF RAND:2 == 0
					PRINTFORML 쇼는 당신과 입을 맞춘 채 천천히 자세를 바꾸자
					PRINTFORMW 당신의 가랑이 사이에 다리를 넣고 허벅지로 당신의 은밀한 곳을 문질렀다
				ELSE
					PRINTFORML 「음푸, 아... 츄... 응!」
					PRINTFORMW 당신의 정열적인 입맞춤에 쇼도 지지 않고 손놀림을 빠르게 했다.
				ENDIF
				;カウンターディープキス
			ELSEIF TCVAR:20 == 60
				IF RAND:3 == 0
					PRINTFORML 「쮸루... 응... 푸악%UNICODE(0x2665)%」
					PRINTFORMW 정열적인 키스를 마치고 떨어뜨린 서로의 혀 사이에는 타액의 다리가 걸려있다...
				ELSEIF RAND:2 == 0
					PRINTFORML 「츄, 음... 츄루읏... 츄루... 응쿠」
					PRINTFORMW 당신의 침을 받아 삼키는 쇼의 목은 윤기나게 움직이고 있다.
				ELSE
					PRINTFORML 「...음음... 후후, ……혀를...」
					PRINTFORMW 쇼는 붙잡은 당신의 혀를 입술로 물고 그 끝을 살살 핥기 시작했다.
				ENDIF
			ELSE
				IF ABL:欲望 >= 5
					IF RAND:2 == 0
						PRINTFORML 「음... 츄... 러... 츕」
						PRINTFORMW 뒤엉킨 혀가 내는 물소리가 주변에 울리고 있었다.
					ELSE
						PRINTFORML 「쪽, 음... 해줘... 후후...♪」
						PRINTFORMW 서로 탐하듯 혀를 얽었다.
					ENDIF
				ELSEIF ABL:親密 >= 5
					IF RAND:2 == 0
						PRINTFORML 「아아... %MASTERNAME:87%...」
						PRINTFORMW 당신을 바라보는 그 눈동자는 애욕으로 촉촉해져 있다.
					ELSE
						PRINTFORML 「에헤헤... %MASTERNAME:87%...」
						PRINTFORMW 쇼는 기쁜 듯 빙긋 웃고 있다.
					ENDIF
				ELSE
					PRINTFORML 「갑자기 그러니까 놀라버렸지만...」
					PRINTFORMW 「지금은 그런 걸 하고 있는 거죠...」
				ENDIF
			ENDIF
			;押し倒した
		ELSEIF CFLAG:うふふ == 1
			IF ABL:欲望 >= 5
				IF RAND:5 == 0
					PRINTFORML 「음후... 쪽, 하아, 음응...」
					PRINTFORMW 「키스... 즐겁습니다...」 
				ELSEIF RAND:4 == 0
					PRINTFORML 「...응, 츄, 푸하, 하아, 함으윽...」
					PRINTFORMW 쇼의 욕망의 불꽃은 키스로 더욱 부추겨지고 있다...
