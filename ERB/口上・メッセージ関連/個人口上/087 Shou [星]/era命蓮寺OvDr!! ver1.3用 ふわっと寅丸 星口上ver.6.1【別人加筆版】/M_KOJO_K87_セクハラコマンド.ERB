;==================================================
;310,尻を撫でる
;==================================================
@M_KOJO_MESSAGE_COM_K87_310
CALL M_KOJO_MESSAGE_COM_K87_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:TARGET:睡眠
		IF ABL:親密 > 5
			PRINTFORML 「んん…　ふ…」
			PRINTFORMW 尻を伝うかすかな感覚に星は腰をくねらせている
		ELSE
			PRINTFORML 「………すぅ」
			PRINTFORMW 尻を触られる感触が無くなると再び星は寝息をたてはじめた
		ENDIF
	ELSEIF CFLAG:添い寝中
	;押し倒された
	ELSEIF CFLAG:うふふ == 2
		;カウンター前から抱きつく
		IF TCVAR:20 == 32
			PRINTFORML 「あっ……ふ、ぁあっ……」
			PRINTFORMW 身体越しに尻を揉みしだかれた星は目を閉じあなたにしがみつくようにしたまま喘ぎ声をあげた
		;カウンターパイズリ
		ELSEIF TCVAR:20 == 53
			;シックスナイン体勢
			IF TEQUIP:シックスナイン
				IF RAND:2 == 0
					PRINTFORML 「あんっ　もぅ…　ん…お返しです%UNICODE(0x2665)%」
					PRINTFORMW 星はあなたの怒張を挟んだまま先端に舌を這わせてきた
				ELSE
					PRINTFORMW 「やん…　お尻いじらないでください…」
				ENDIF
			ELSE
			;※非シックスナイン時は尻は揉めるが穴は不可。　体勢は深く考えずに「尻をこちらに向けていない」程度の認識で良いか
				IF RAND:2 == 0
					PRINTFORMW 「ん…っ　じっとしててくれないと…やっ…%UNICODE(0x2665)%　上手くできないじゃないですか…」
				ELSE
					PRINTFORMW 「ひゃうっ！　…もー手持無沙汰だからってお尻で遊ばないでくださいよぉ…」
				ENDIF
			ENDIF
		;カウンタークンニ強制
		ELSEIF TCVAR:20 == 70
			;パンツ～ズボンを履いている
			IF TEQUIP:0 > 1
					PRINTFORMW 布越しでも彼女の尻の柔らかさが手のひらに伝わってくる…
			;ノーパン～ノーパンスカート
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「ひ、ひゃぁ……んっ…」
					PRINTFORML 秘所を舐めあげられた星は思わずうずくまる
					PRINTFORMW そうして突き出された臀部をあなたはゆっくりと揉みほぐしていった
				ELSE
					PRINTFORML 「ふわあっ！」
					PRINTFORMW 陰唇と尻たぶへの同時攻撃に星は堪らず腰を跳ねさせた
				ENDIF
			ENDIF
		;カウンターアナル奉仕
		ELSEIF TCVAR:20 == 72
			IF TEQUIP:0 > 1
				PRINTFORML 尻穴のあたりを舌先で突くとピクリと反応するのが分かった
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「んっ、は、あぁあああぁぁ……っ」
					PRINTFORMW 肛内を行き来する湿った熱に星は荒く息をついている
				ELSE
					PRINTFORML 肛門がひくひくと収縮するのが舌に伝わってくる…
					PRINTFORMW 「ひう、あ、っつ、あ、うぁあ」
				ENDIF
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「ああ、お尻……が、あっ」
			ELSEIF RAND:2 == 0
				PRINTFORMW 尻の割れ目に沿うように撫でられると星はぶるりと身体を震わせた
			ELSE
				PRINTFORML 「ふぅっ、ん…」
				PRINTFORMW 星は尻を突き出すようにして腰をくねらせている
			ENDIF
		ENDIF
	ELSE
		IF ABL:親密 > 5
			IF RAND:3 == 0
				PRINTFORML 「や、ん…」
				PRINTFORMW 星は甘い声をあげるのを我慢しているようだ
			ELSEIF RAND:2 == 0
				PRINTFORML 「あ……、%MASTERNAME:87%…駄目ですよお…」
				PRINTFORMW 星の許しを乞うような上目づかいはあなたの嗜虐心を刺激するだけだった…
			ELSE
				PRINTFORMW 「もう…%MASTERNAME:87%はえっちなんですから…」
			ENDIF
		ELSEIF ABL:親密 > 2
			IF RAND:3 == 0
				PRINTFORMW 「駄目ですよもう！」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「ひゃわ！？　な、何するんですかっ！」
			ELSE
				PRINTFORMW だが恥ずかしげに顔を赤らめる星はなかなかに可愛らしかった
			ENDIF
		ELSE
			PRINTFORMW 「あんまりおいたが過ぎると怒りますよ？」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;==================================================
@M_KOJO_MESSAGE_COM_K87_311
CALL M_KOJO_MESSAGE_COM_K87_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:TARGET:睡眠
		IF ABL:親密 >= 8
			IF RAND:2 == 0
				PRINTFORMW 「うにゅ……%UNICODE(0x2665)%」
			ELSE
				PRINTFORMW 「すぅ…すぅ………ふふっ」
			ENDIF
		ELSE
			PRINTFORMW 「んー……むぅ…」
		ENDIF
	;添い寝中
	ELSEIF CFLAG:添い寝中
		IF ABL:親密 >= 8
			IF RAND:3 == 0
				PRINTFORML 「それじゃあ私は…よいしょっと」
				PRINTFORML 星はあなたの腕をとるとその胸に抱きこんだ
				PRINTFORMW 「あったかい…　このまま寝ちゃいたいくらい…」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「ふふ…　ぬくぬくです%UNICODE(0x2665)%」
			ELSE
				PRINTFORMW 「えへへー、%MASTERNAME:87%っ%UNICODE(0x2665)%」
			ENDIF
		ELSE
			PRINTFORML 「お布団の中で抱き合っていると…なんというか…その……」
			PRINTFORMW 星の頬はほんのりと染まっている
		ENDIF
	;押し倒された
	ELSEIF CFLAG:うふふ == 2
		;カウンターキス
		IF TCVAR:20 == 30
			PRINTFORML 「んんっ！？　……ん、ふっ…」
			PRINTFORML 唇を離そうとしたところを押さえつけられた星は一瞬びくりとしたが
			PRINTFORMW 続くあなたの口づけに安心したように身を委ねた…
		;カウンター素股
		ELSEIF TCVAR:20 == 52
			IF RAND:2 == 0
				PRINTFORML あなたが星を抱きしめることで二人の秘所はさらに強く押し付けられた
				PRINTFORMW 「あ…はっ、擦れて…%UNICODE(0x2665)%　%MASTERNAME:87%…%UNICODE(0x2665)%」
			ELSE
				PRINTFORML 「んんぅ……くっ…あぁ…熱いぃ…%UNICODE(0x2665)%」
				PRINTFORMW 星は倒れこむようにあなたと折り重なり緩やかに腰を動かしている
			ENDIF
		;カウンターディープキス
		ELSEIF TCVAR:20 == 60
			PRINTFORML 「ちゅるっ…んく…んん、%MASTERNAME:87%…%UNICODE(0x2665)%」
			PRINTFORMW 互いを求め合うあなたと星は舌も身体も押し付けあい絡めあっている
		ELSE
			IF RAND:3 == 0 
				PRINTFORML 「もっ、と……%MASTERNAME:87%の…」
				PRINTFORMW 星は少しでも多くの部分をあなたに触れさせようと身体を擦りつけている
			ELSEIF RAND:2 == 0 
				PRINTFORMW 「もっと強く、抱いてください…」
			ELSE
				PRINTFORML 「～～～っ」
				PRINTFORMW 星を抱きしめると、星も精一杯体を押し付けてきた…
			ENDIF
		ENDIF
	;恋人
	ELSEIF TALENT:恋人
		IF RAND:8 == 0 
			PRINTFORMW 「ね、%MASTERNAME:87%」
			PRINTFORMW 「私、今すごく幸せです…%UNICODE(0x2665)%」
		ELSEIF RAND:7 == 0 
			PRINTFORMW 「…こうしてるだけで、貴方の全てが欲しくなっちゃいます…」
			PRINTFORMW 「欲張りですね、私…」
		ELSEIF RAND:6 == 0 
			PRINTFORML 「ん…もっと……ぎゅって、してください…」
			PRINTFORMW 星の可愛らしいお願いにあなたはしっかりと応えてやった
		ELSEIF RAND:5 == 0 
			PRINTFORML 「ん…♪」
			PRINTFORMW 星も、抱きつくあなたの体に顔をすり寄せた…
		ELSEIF RAND:4 == 0 
			PRINTFORMW 「あの、%MASTERNAME:87%…その、手が、変なとこ触って…んんっ%UNICODE(0x2665)%」
		ELSEIF RAND:3 == 0 
			PRINTFORMW 「こうしてると…だんだん、変な気分になっちゃいますね…%UNICODE(0x2665)%」
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「もう、甘えんぼさんですね…%UNICODE(0x2665)%」
		ELSE
			PRINTFORML 星はあなたの胸に顔をうずめ大きく息を吸い込んだ
			PRINTFORMW 「はあ…　%MASTERNAME:87%の匂い、私好きです♪」
		ENDIF
	;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:親密 >= 8
			IF RAND:5 == 0 
				PRINTFORML （この優しい人に、私の気持ちを伝えたい…でも）
				PRINTFORMW （これ以上を求めたら…この関係も崩れてしまうのでしょうか）
			ELSEIF RAND:4 == 0 
				PRINTFORML （好きな人に抱きしめられて、私は幸せ者です…でも）
				PRINTFORMW （いつまでもこの立場に甘んじていては、いけませんね…）
			ELSEIF RAND:3 == 0
				PRINTFORML 「ん…もっと……ぎゅって、してください…」
				PRINTFORMW 星の可愛らしいお願いにあなたはしっかりと応えてやった
			ELSEIF RAND:2 == 0
				PRINTFORML 星はあなたの胸に顔をうずめ大きく息を吸い込んだ
				PRINTFORMW 「はあ…　%MASTERNAME:87%の匂い…何だか落ち着きます♪」
			ELSE
				PRINTFORML （%MASTERNAME:87%が何を思ってこうしてくれるのかはわかりませんが）
				PRINTFORMW （ずっと、こうしていたいです…%UNICODE(0x2665)%）
			ENDIF
		ELSEIF ABL:親密 >= 4
			IF RAND:2 == 0
				PRINTFORMW 「～～～」
				PRINTFORMW あなたが抱擁すると、星は固まってしまった…
			ELSE
				PRINTFORMW 「きゅ、急にそういう事しないでくださいよ…」
				PRINTFORMW 「あ、いえ、その…嫌ではないん、ですよ？」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「あ、あう………」
			ELSE
				PRINTFORMW あなたの抱擁に星は混乱している
			ENDIF
		ENDIF
	ELSE
		IF ABL:親密 >= 8
			IF RAND:3 == 0
				PRINTFORMW 「どうしたんですか、もう…」
				PRINTFORMW 星はクスクスと笑っている
			ELSEIF RAND:2 == 0
				PRINTFORML 星はあなたの胸に顔をうずめ大きく息を吸い込んだ
				PRINTFORMW 「はあ…　%MASTERNAME:87%の匂い…何だか落ち着きます♪」
			ELSE
				PRINTFORMW あなたの温もりに包まれ、星は幸せそうに目を細めている
			ENDIF
		ELSEIF ABL:親密 >= 4
			IF RAND:2 == 0
				PRINTFORMW 「もう…どうしたんですか急に」
			ELSE
				PRINTFORMW 「ちょ、ちょっと…%MASTERNAME:87%…」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「あ、あう………」
			ELSE
				PRINTFORMW あなたの抱擁に星は混乱している
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;==================================================
@M_KOJO_MESSAGE_COM_K87_312
CALL M_KOJO_MESSAGE_COM_K87_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K87_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;失敗
	IF TFLAG:193 == 99
		PRINTFORMW 「やあ……止めてください…っ」
	;成功
	ELSE
		;睡眠
		IF CFLAG:TARGET:睡眠
			IF ABL:親密 >= 5
				PRINTFORMW 「ん…ふふ…」
			ELSE
				PRINTFORMW 「うう……むー…」
			ENDIF
		;ファーストキス
		ELSEIF EXP:TARGET:キス経験 == 1
			;恋慕
			IF TALENT:恋慕
				PRINTFORMW 「初めてのキスはレモンの味、なんて聞きましたけど…」
				PRINTFORMW 「レモンなんかよりもずっとずっと素敵でした%UNICODE(0x2665)%」
				PRINTFORMW 星は幸せそうにはにかんでいる…
			ELSEIF ABL:親密 >= 5
				PRINTFORMW 「ファーストキス…」
				PRINTFORMW 「%MASTERNAME:87%が相手なら悪くないですね♪」
				PRINTFORMW 星はどことなく嬉しそうだ
			ELSE
				PRINTFORMW 「い、いきなり何ですかぁ…？」
				PRINTFORMW 「誰かとキスだなんて初めてだったんですからね…　もう…」
			ENDIF
		;うふふ
		;押し倒された
		ELSEIF CFLAG:うふふ == 2
			;カウンターキス
			IF TCVAR:20 == 30
				IF RAND:2 == 0
					PRINTFORML あなたのキスのお返しに火が点いた星はさらに口づけを求めてきた
					PRINTFORML 「ん…ちゅ…っ……ちゅ……ちゅうっ」
					PRINTFORMW 星とあなたはお互いの唇の先を何度も何度も押しつけ合った
					;/ちゅっちゅ！
				ELSE
					PRINTFORML 「%MASTERNAME:87%……　もう一回ぃ…」
					PRINTFORMW もっともっとと星はあなたの口づけを求めてくる
				ENDIF
			;カウンター手淫
			ELSEIF TCVAR:20 == 50
				IF RAND:2 == 0
					PRINTFORML 星はあなたと唇を合わせたままゆっくりと体勢を変えると
					PRINTFORMW あなたの股の間に足を差し込み太腿であなたの秘所を擦りあげた
				ELSE
					PRINTFORML 「んぷ、あ……ちゅ……んっ」
					PRINTFORMW あなたの情熱的な口づけに星も負けじと手の動きを速めた
				ENDIF
			;カウンターディープキス
			ELSEIF TCVAR:20 == 60
				IF RAND:3 == 0
					PRINTFORML 「じゅる……ん…　ぷぁっ%UNICODE(0x2665)%」
					PRINTFORMW 情熱的なキスを終えて離したお互いの舌の間には唾液の橋がかかっている…
				ELSEIF RAND:2 == 0
					PRINTFORML 「ちゅ、む……ちゅるっ……ちゅる………んく」
					PRINTFORMW あなたの唾液を受け取り嚥下していく星の喉は艶めかしく動いている
				ELSE
					PRINTFORML 「…んむ……ふふ、………れろ…」
					PRINTFORMW 星は捕まえたあなたの舌を唇で挟み込むとその先端をちろちろと舐め始めた
				ENDIF
			ELSE
				IF ABL:欲望 >= 5
					IF RAND:2 == 0
						PRINTFORML 「ん……りゅ…れる……ちゅ」
						PRINTFORMW 絡めあう舌が立てる水音が周りに響いている
					ELSE
						PRINTFORML 「ちゅ、む…れろ…　ふふ…♪」
						PRINTFORMW お互いに貪りあうように舌を絡めあった
					ENDIF
				ELSEIF ABL:親密 >= 5
					IF RAND:2 == 0
						PRINTFORML 「ああ…%MASTERNAME:87%…」
						PRINTFORMW あなたを見つめるその瞳は愛欲に潤んでいる
					ELSE
						PRINTFORML 「えへへ…　%MASTERNAME:87%…」
						PRINTFORMW 星は嬉しそうにほほ笑んでいる
					ENDIF
				ELSE
					PRINTFORML 「いきなりですからびっくりしちゃいましたけど…」
					PRINTFORMW 「今はそういうこと、してるんです、よね…」
				ENDIF
			ENDIF
		;押し倒した
		ELSEIF CFLAG:うふふ == 1
			IF ABL:欲望 >= 5
				IF RAND:5 == 0
					PRINTFORML 「んふ…ちゅうっ、はぁ、んんっ…」
					PRINTFORMW 「キス…愉しいです…」 
				ELSEIF RAND:4 == 0 
					PRINTFORML 「…ん、ちゅ、ぷは、はぁ、はむぅっ…」
					PRINTFORMW 星の欲望の炎はキスでさらに煽られている…
				ELSEIF RAND:3 == 0 
					PRINTFORML 「あむ、っふ、んん、っちゅ、ぷは、はぁ、はぷ…」
					PRINTFORMW 星は飽きもせずにあなたの唾液を吸い続けている…
				ELSEIF RAND:2 == 0
					PRINTFORML 「んふう…ん、ちゅう…」
					PRINTFORMW 星は負けじと舌を絡め、唾液を送り込んでくる…
				ELSE
					PRINTFORMW 「ん、にゅる、ちゅぷ、ぷぁ…%MASTERNAME:87%の味がします…」
				ENDIF
			ELSEIF ABL:親密 >= 5
				IF RAND:2 == 0
					PRINTFORMW 「ちゅ、ぁむ、んんっ、素敵です…」
				ELSE
					PRINTFORMW 「んっ…はぁっ、キスって愉しいんですね…%UNICODE(0x2665)%」
				ENDIF
			ELSE
				IF RAND:3 == 0 
					PRINTFORML 「ちゅ…ちゅ…ん、は…」
					PRINTFORMW （ここでキスは卑怯です…）
				ELSEIF RAND:2 == 0
					PRINTFORMW （駄目です…ここでキスされたら、抵抗できなくなっちゃいます…） 
				ELSE
					PRINTFORML 「ちゅ…は、あむぅっ、んんっ…」
					PRINTFORMW （ああ…頭がしびれちゃって、何にも考えられないです…）
				ENDIF
			ENDIF
		ELSE
			IF ABL:親密 >= 5
				IF RAND:4 == 0
					PRINTFORML 「はむ、ちゅ……はぁ……」
					PRINTFORMW  あなたとの口づけに星は陶酔している…
				ELSEIF RAND:3 == 0
					PRINTFORML 「はあ…ん、もっと…」
					PRINTFORMW あなたの寵愛を求め星はさらに強く唇を押しつけてきた
				ELSEIF RAND:2 == 0
					PRINTFORML 「ん…%MASTERNAME:87%……」
					PRINTFORMW 唇を離した星は目をつむりあなたの胸に額を当てた
				ELSE
					PRINTFORMW 「んん…………ふ…」
				ENDIF
			ELSE
				PRINTFORMW 「%MASTERNAME:87%……今のは、その…」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
