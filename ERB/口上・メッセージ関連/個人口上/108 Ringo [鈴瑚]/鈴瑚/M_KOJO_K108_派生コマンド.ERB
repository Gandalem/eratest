;1,シックスナイン
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K108_1
RETURN 0

@M_KOJO_MESSAGE_SCOM_K108_1
CALL M_KOJO_MESSAGE_SCOM_K108_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K108_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;舌技術３以上
	ELSEIF ABL:舌 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「쭈르륵...흡읍! 흡흡은... 큭! 쭈르륵, 쭈압! 쭈르르읏!」","L"
					PRINTFORMDL 절정에 가까워진 건지, 기분 좋게 몸을 떨고 있는 링고.
					PRINTFORMDW 되받기라도 하려는 듯, 성기에 입술을 붙이고 %조사처리(CALLNAME:MASTER,"의")% 절정을 재촉해 왔다...!
				CASE 1
					PRINTFORML 「미안해요 %CALLNAME:MASTER%...! 잠깐만 참아줘읏」
					PRINTFORMDL 말하자마자, 링고는 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 자신의 성기를 밀어붙이며 허리를 비틀었다...!
					CALL HPH_PRINT,@"「나아앗 후우, 벌써 갈 것 같으니까 같이 가고 싶어앗 후우! 같이 가고 싶어앗 후우! 후우 후우」","L"
					CALL HPH_PRINT,@"「아…… 하푸앗! 흐읍! 주보옷! 주부옷! 즈주우으으윽! 흐읍 히히히」","L"
					PRINTFORMDW 격렬한 링고의 구강성으로 %조사처리(CALLNAME:MASTER,"는")% 순식간에 절정에 달했다―
				CASE 2
					CALL RINGO_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음…… ♪응응! 후후, %조사처리(CALLNAME:MASTER,"의")% 혀가… 후후 기분 좋아……。」","L"
					PRINTFORMDL 링고가 얼굴에 달라붙는다…… %조사처리(CALLNAME:MASTER,"는")% 질내에 혀를 들이밀어 핥아댔다...!
					CALL HPH_PRINT,@"「응응! 흐아아앗, 하으윽...!」","L"
					CALL HPH_PRINT,@"「아무읏 HPH쥬, 주르륵 HPH러읏 HPH주봇 HPH주봇 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「……있잖아 HPH 둘 중 누가 먼저 가버리는지, 내기 안 할래?」","L"
					CALL HPH_PRINT,@"「아무옷 흐으윽흐으읍 후루륵후룹 쭉쭉우욱 흐으윽 흐으읍」","L"
					PRINTFORMDL 링고의 격렬한 구강 오럴에 지지 않고, %CALLNAME:MASTER%역시 질내를 핥아대며 음핵을 가볍게 당겼다...!
					CALL HPH_PRINT,@"「――아아앗 흐응흐응, 그건 안 돼읏! 금방 갈 것 같아으윽흐응흐응흐응」","W"
				CASE 2
					CALL RINGO_FELLATIO
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 하아앗, 하아앗, 가버려... 하아앗」","L"
					CALL HPH_PRINT,@"「아…… 으윽, 후우윽…… 흐응…… 하아…… 헉! 헉, 헉……」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 끝을 본 동시에, 링고의 여성 음부에서 물줄기가 터져 나왔다...!
				CASE 1
					CALL HPH_PRINT,@"「츕... 츄릅, 흐으응흐응... 응응흐읍 흐읍」","L"
					PRINTFORMDL 링고는 몸을 기분 좋게 떨면서, %조사처리(CALLNAME:MASTER,"의")% 페니스에 달라붙는다...!
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 정신없이, 링고의 질구에 빨아들이며 사정했다...!
				CASE 2
					CALL RINGO_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「저기, 그렇게 뚫어져라 쳐다보니까 부끄러운데……」
					CALL HPH_PRINT,@"「신경 쓰지 말라고…… 벌써... HPH... 쪽으로 가버려... HPH」","L"
					CALL HPH_PRINT,@"「―푸핫! 흐으윽, 아아앗! 푸핫... 혀가 들어와서 으흑! 푸핫! 푸핫!」","W"
				CASE 1
					CALL HPH_PRINT,@"「엣…… 너도 빠는 거야? …… 어서 HPH」","L"
					CALL HPH_PRINT,@"「아무우……후루룩……흐으음……♪」","L"
					PRINTFORMDW 링고의 가랑이 쪽에 얼굴을 가까이 대고, %조사처리(CALLNAME:MASTER,"는")% 질 구멍을 핥아댔다.
				CASE 2
					CALL RINGO_FELLATIO
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
