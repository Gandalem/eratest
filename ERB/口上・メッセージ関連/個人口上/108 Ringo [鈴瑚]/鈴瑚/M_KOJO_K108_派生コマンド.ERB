	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「히끅……흐으윽 흐으읏 아아아앗 흐으윽 흐으윽 흐으윽」","L"
					PRINTFORMDL 페니스로 링고의 G스팟을 자극하자, 질내에서 격렬한 경련이 시작되었다.
					PRINTFORMDW 강렬한 조임에 %조사처리(CALLNAME:MASTER,"는")% 견디지 못하고―
				CASE 1
					CALL HPH_PRINT,@"「아아앗 흐응흐응 그거! 응거기 아냐아앙흐응흐응」","L"
					CALL HPH_PRINT,@"「갈 것 같아앗 후우 후우 갈 것 같아……. 아아아아아아아앗 후후 후후 후후」","L"
					PRINTFORMDL 링고의 질 주름이 물결치듯 휘감아 페니스를 조여온다……
					PRINTFORMDW 너무나 큰 쾌감에, %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 뒤로 넘어가 절정에 달했다...!
				CASE 2
					CALL HPH_PRINT,@"「응으윽 HPH HPH %CALLNAME:MASTER%읏 HPH 그만…… 그만해 줘읏 HPH HPH」","L"
					CALL HPH_PRINT,@"「가고 있어읏! 하프 하프 나앗…… 지금 가니까 아아아아앗! 하프 하프 하프」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 삽입한 페니스를 움켜쥐고, G스팟을 집요하게 문질러 올렸다.
					CALL HPH_PRINT,@"「이... 갈 것 같아!! 하프 하프 또 갈 것 같아아아! 하프 하프 하프」","L"
					PRINTFORMDW 다시 절정에 이르는 링고. 이번에는 %CALLNAME:MASTER%도 함께―
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아앗 흐으헵 아아아아헵 흐헵 흐헵 으으읏헵 흐헵」","L"
					CALL HPH_PRINT,@"「거기! 핥짝, 핥짝, 골고리 하는 거 기분 좋아읏 핥짝, 핥짝」","L"
					PRINTFORMDW 평소의 링고에게서 상상도 못 할 정도로 큰 신음 소리가 울려 퍼진다...!
				CASE 1
					CALL HPH_PRINT,@"「아으윽! 후후후... 잠시만! %CALLNAME:MASTER%읏 후후후 잠깐만 읏 후후후」","L"
					CALL HPH_PRINT,@"「거기만 계속 만지면…… 하으윽, 갈 것 같아…… 하으윽 하으윽 하으윽」","L"
