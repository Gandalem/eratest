				CALL HPH_PRINT,@"「응읏……. %CALLNAME:MASTER%…… 갈 것 같다는 건 알았으니까, 제대로 밖에 사정해 줘...?」","L"
				CALL HPH_PRINT,@"「아앗 HPH 아우읏 HPH 격해…… HPH %CALLNAME:MASTER%읏! 듣고 있어!?」","L"
				CALL HPH_PRINT,@"「아기 있으니까!! 아우윽! 밖에 사정해 달라고오!! 아우윽! 아우윽!」","W"
			ENDIF
			;それ以外
		ELSE
			IF ABL:欲望 > 20
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 안돼읏! 더 세게 하면 아기가 생겨버릴지도 몰라아아앗! 으윽, 으윽」","L"
				PRINTFORMDL 링고는 발정 난 암컷의 얼굴을 한 채, %조사처리(CALLNAME:MASTER,"의")% 페니스를 자궁구로 물고 있다...!
				CALL HPH_PRINT,@"「아... 아냐...! 이건...... 아앗 후으윽 후으윽」","L"
				CALL HPH_PRINT,@"「키... 네가 몇 번이나 HPH HPH하게, 골리골리 해주니까잖아아앗 HPHHPH」","W"
			ELSE
				CALL HPH_PRINT,@"「윽… 아파앗...! %CALLNAME:MASTER%! 잠깐... 기다려 봐... 으응 HPH 거칠게 하지 말아줘 HPH」","L"
				CALL HPH_PRINT,@"「아기가, 으깨질 것 같아... 으깨져버릴 거야앗 HPH HPH」","L"
				PRINTFORMDW "걱정하지 않아도 건강하게 태어날 거야"라며 격려하면서, 링고의 질 깊숙한 곳을 몇 번이고 찔렀다...!
			ENDIF
		ENDIF
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아……가……흐읍 흐읍 이거……빨리, 들어가고 있어… 흐읍 흐읍」","L"
						PRINTFORMDL 절정에 달한 걸까, 자궁경부와 질 주름이 수축하는 것을 느꼈다.
						PRINTFORMDW 너무나 강렬한 조임에, %CALLNAME:MASTER%도 링고의 뒤를 따르며―
					ELSE
						CALL HPH_PRINT,@"「아우윽! 흐으읍, 깊숙이, 닿아버렸어…… 에엣! 흐으읍, 흐으읍」","L"
						PRINTFORMDW 링고의 자궁경부에 귀두를 밀착시키고 사정했다...!
					ENDIF
				CASE 1
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아아아아아아아아아아앗! 하프 하프 하프 하프」","L"
						PRINTFORMDW 쿵, 하고 호쾌하게 질 깊숙한 곳으로 밀어 넣자, 링고의 비명 같은 교성과 함께 엄청난 조임이 덮쳐왔다...!
					ELSE
						PRINTFORML 「응... 윽...! 아파아...!」
						CALL HPH_PRINT,@"「아아…… 아아앗… HPH 거시기, 배 속 깊은 곳에서… 부풀고 있어읏 HPH HPH」","W"
					ENDIF
				CASE 2
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아앗! 흐으윽! 하아, 가버릴 것 같아! 하아, 가버릴 것 같아! 하아, 하아...」","L"
						CALL HPH_PRINT,@"「하아윽, 흐으윽! 큭흐읍... 머리가 아파져 가버릴 것 같아으응! 하아흡... 하아흡...」","L"
						PRINTFORMDL 링고의 자궁구를 페니스로 뚫을 듯이 몇 번이고 자극한다……
						PRINTFORMDW 평소 그녀에게서는 상상도 할 수 없는 난폭한 모습에 %조사처리(CALLNAME:MASTER,"의")% 흥분은 더욱 고조되어―
					ELSE
						CALL HPH_PRINT,@"「이... 가아앗! 흐읍 흐읍 아아아아아아아악! 흐읍 흐읍 흐읍」","L"
						PRINTFORMDW 본능일까…… %조사처리(CALLNAME:MASTER,"는")% 무의식중에 링고의 질 깊숙한 곳까지 육봉을 한계까지 밀어 넣고 있었다...!
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아아앗 후우후우후우%CALLNAME:MASTER%후우%CALLNAME:MASTER%후우 후우」","L"
						CALL HPH_PRINT,@"「거시기 더 깊이 박아줘읏!! 내 자궁 더 세게 건드려줘읏!! 하으읍 하으읍 하으읍」","L"
						PRINTFORMDW 몇 번이나 자궁을 찔렀는지, 링고는 강렬한 쾌감을 느끼고 있는 듯하다...!
					ELSE
						CALL HPH_PRINT,@"「아으윽! 흐읍흐읍 %CALLNAME:MASTER%…… 조금만 더 천천히 해줘……!」","L"
						PRINTFORMDL 귀두에 딱딱한 감촉이 느껴져…… 아마 여기가 링고의 자궁구인 것 같다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 링고를 어루만지며, 자궁구를 페니스로 자극했다...!
					ENDIF
				CASE 1
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「응으윽... HPH구... 우으윽 HPH HPH 거시기, 사정질 당하는 거... 기분 좋아앗... HPH HPH」","L"
						PRINTFORMDW 링고는 황홀한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 피스톤을 자궁이 받아내고 있다...!
					ELSE
						CALL HPH_PRINT,@"「응으윽……푹푹, 끅...! 끝까지…… 와버릴 것 같아…… 푹푹」","L"
						PRINTFORMDW 링고의 자궁경부를 페니스로 자극했다...!
					ENDIF
				CASE 2
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아아아앗! 흐으응, 안 돼애읏! 흐으응, 흐으응」","L"
						CALL HPH_PRINT,@"「이거 금방 갈 것 같아――아아앗, 흐으윽흐읍흐읍」","L"
						PRINTFORMDW 링고는 자궁을 찔리며 몸을 파르르 떨고 있다...!
					ELSE
						PRINTFORML 「앗……. 아파…! 헤, 시……」
						PRINTFORML 「%CALLNAME:MASTER%…… 좀 더 부드럽게 해줘……!」
						PRINTFORMDW 링고는 살짝 아픈 듯 얼굴을 찡그리고 있다……
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
