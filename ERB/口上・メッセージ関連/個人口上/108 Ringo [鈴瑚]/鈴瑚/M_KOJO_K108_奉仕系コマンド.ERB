@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_80
RETURN 0

@M_KOJO_MESSAGE_COM_K108_80
CALL M_KOJO_MESSAGE_COM_K108_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧３以上
	ELSEIF ABL:技巧 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「앗…? 벌써 사정할 것 같네……. ♪」
					CALL HPH_PRINT,@"「어떻게 할래? 마실 거야? 얼굴에 뿌릴 거야? HPH」","L"
					PRINTFORMDW 링고가 매력적인 제안을 해왔지만, 선택할 여유는 없었다.
				CASE 1
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"가")% 좋아하는 타이밍에 사정해도 괜찮으니까…… HPH」","L"
					PRINTFORMDW 상냥하게 미소 지으며 페니스를 만지는 링고. 그 간극에, %조사처리(CALLNAME:MASTER,"는")% 흥분을 참지 못하고――
				CASE 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%싸고 싶어? 괜찮아♪ 참지 않아도 돼... HPH」","L"
					CALL HPH_PRINT,@"「자아 자아♪ 가버려, 가버려 HPH」","L"
					PRINTFORMDW 링고는 능숙하게 손가락을 움직여 %조사처리(CALLNAME:MASTER,"를")% 사정으로 이끌어 온다...!
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후후…… HPH 기분 좋지, %CALLNAME:MASTER%…… HPH」","L"
					CALL HPH_PRINT,@"「네 거시기 약점은 다 알고 있거든… HPH」","L"
					PRINTFORMDW 링고의 능숙한 손가락이 %조사처리(CALLNAME:MASTER,"의")% 페니스를 정확하게 자극해 온다...!
				CASE 1
					CALL HPH_PRINT,@"「이 안쪽 살 결 쪽…… 걸리는 거 좋아하잖아, 응?」","L"
					CALL HPH_PRINT,@"「자아, 해봐~ HPH, 가도 괜찮아~ HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 쾌감에 몸을 떨며 신음할 뿐이다...!
				CASE 2
					CALL HPH_PRINT,@"「이렇게 보면, 귀두가 단고 같을지도…… HPH」","L"
					PRINTFORMDW 링고는 페니스의 끝을, 손가락으로 비틀듯이 만지고 있다……
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「사정할 것 같아…? 알겠어…♪」
					PRINTFORMDW 링고는 더욱 손의 움직임을 빠르게 했다...!
				CASE 1
					CALL HPH_PRINT,@"「앗...! 굉장해...! 끝부분, 쪽쪽 해왔어... HPH」","L"
					PRINTFORMDW 사정 직전이라고 말했지만, 링고는 자위하는 데 정신이 팔려 듣지 못하는 듯하다……
				CASE 2
					PRINTFORML 「사정할 것 같은 거야...? 알겠어...♪」
					CALL HPH_PRINT,@"「그럼... 네가 가슴 보여줘…… HPH」","L"
					PRINTFORMDL 흥분한 건지, 링고의 숨소리가 거칠다……
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 밀려오는 사정감에 몸을 맡겼다―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「설마 단자를 주물러 왔던 이 손으로, 거시기 취급을 하게 될 줄은 몰랐네…… HPH」","L"
					CALL HPH_PRINT,@"「정말로, 너란 애는…… HPH」","W"
				CASE 1
					PRINTFORML (저기…… 상냥하게…. 위아래로 움직여, 읏……)
					PRINTFORMDW 링고는 익숙하지 않은 손놀림으로 %조사처리(CALLNAME:MASTER,"의")% 성기를 만지고 있다…
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%…これでいい？気持ちいい？」
					PRINTFORMDW 불안한 표정으로 물어오는 링고에게 고개를 끄덕이자, 안심한 듯한 미소를 지었다.
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
