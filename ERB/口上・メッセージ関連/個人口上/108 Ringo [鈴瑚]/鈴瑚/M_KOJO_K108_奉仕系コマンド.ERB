					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 어딘가 불안해 보이는 링고의 얼굴을 향해서―
				CASE 1
					CALL HPH_PRINT,@"「하아…… HPH 하아…… HPH 하아…… HPH」","L"
