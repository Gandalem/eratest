			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「가슴으로 가두는 건…… 응…… 흐응, 어려워...!」","L"
					PRINTFORMDW 링고는 한창 파이즈리를 해주고 있다.
				CASE 1
					CALL HPH_PRINT,@"「응읏...! 후, 응... HPH는... 하아... HPH」","L"
					CALL HPH_PRINT,@"(뭐, 뭔가…… 나도 몸이 뜨거워져 왔어…… HPH)","L"
					PRINTFORMDW 링고는 거친 숨을 몰아쉬며 파이즈리를 하고 있다……
