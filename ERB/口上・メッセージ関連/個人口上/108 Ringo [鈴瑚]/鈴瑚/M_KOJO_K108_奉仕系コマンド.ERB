	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;お掃除フェラ
	ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
		;精液中毒４以上
		IF ABL:精液中毒 > 4
			CALL HPH_PRINT,@"「자, %CALLNAME:MASTER%♪ 쉴 시간은 없어? HPH」","L"
			CALL HPH_PRINT,@"「―하읍! 후루룩! 주르륵! 흐으으윽! 하아... 하아...」","L"
			PRINTFORMDL 두 사람의 체액으로 뒤덮인 사정 직후의 페니스를, 링고는 힘차게 빨아들였다.
			PRINTFORMDL 짜릿한 쾌락에, %조사처리(CALLNAME:MASTER,"는")% 크게 몸을 뒤로 젖히며 신음한다...!
			CALL HPH_PRINT,@"「...푸핫 HPH 좋아졌네. 커졌구나 HPH」","L"
			PRINTFORMW 「자아, %CALLNAME:MASTER%♪ 다음엔 어떤 체위로 할까?」
			RETURN 1
			;精液中毒３以下
		ELSE
			CALL HPH_PRINT,@"「아……흐읍! 츄릅…… 흐으윽… 흐으읏…」","L"
			CALL HPH_PRINT,@"(아아... HPH 나와 %조사처리(CALLNAME:MASTER,"의")% 냄새가 입안에서 뒤섞여…… HPH)","L"
			PRINTFORMDW 링고는 황홀한 표정으로, %조사처리(CALLNAME:MASTER,"의")% 페니스를 빨아들이고 있다...!
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		CALL RINGO_FELLATIO
		RETURN 1
	ENDIF
ENDIF
RETURN 1
