; Modular ERB: 個人口上/108 Ringo [鈴瑚]/鈴瑚/M_KOJO_K108_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_B_K108
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_B_K108
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	CALL HPH_PRINT,@"「흐윽… 흐으윽… 젖, 엄청 많이 나와…… 흐으윽」","W"
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 「~~앗! ……부탁이야, 보지 말아줘...!」
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたしHPH
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			SELECTCASE RAND:6
				CASE 0
					CALL HPH_PRINT,@"「이크 우으으으윽 HPH HPH HPH HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「~~~~읏 흐으읍 흐으읍 흐으읍가…… 하아… 큭흐읍 흐으읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「기, 기다려 봐...! 커한 게 와버렸어――흑흐흡 큭큭 큭큭 큭큭」","W"
				CASE 3
					CALL HPH_PRINT,@"「~~~~읏 흐읍 흐읍 흐읍」","L"
					CALL HPH_PRINT,@"「하앗……HPH 하앗……HPH 잠깐만……HPH 안 돼……HPH HPH」","W"
				CASE 4
					CALL HPH_PRINT,@"「아아아아아아아아아앗! 후읍 후읍 후읍 후읍」","W"
				CASE 5
					CALL HPH_PRINT,@"「또 갈 것 같아읏 HPH 갈 것 같아읏 HPH 아아아아아—!! HPH HPH HPH」","W"
			ENDSELECT
			;弱
		CASE 1 TO 4
			SELECTCASE RAND:6
				CASE 0
					CALL HPH_PRINT,@"「아앗 후으윽! 후으윽! 아우우우우읏! 후후후후훗」","W"
				CASE 1
					CALL HPH_PRINT,@"「응응……흐으음~ 흐읍 흐읍 흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「갈 것 같아아앙~!! 히끅 히끅 히끅」","W"
				CASE 3
					CALL HPH_PRINT,@"「아아……흐으응 파아아아앗 흐읍 흐읍 흐읍」","W"
				CASE 4
					CALL HPH_PRINT,@"「아아아아아아—흑흑 흐읍... 하아... 흐읍 하아... 흐읍」","W"
				CASE 5
					CALL HPH_PRINT,@"「하아앗…… 아앗…… 헤프 머리, 빙글빙글해져……. 헤프 헤프」","W"
			ENDSELECT
	ENDSELECT
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_B2_K108
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_B2_K108
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;あなたが射精したときに関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K108_00
