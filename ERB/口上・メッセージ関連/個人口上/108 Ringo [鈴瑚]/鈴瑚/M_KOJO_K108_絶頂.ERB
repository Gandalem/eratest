;-------------------------------------------------
IF LOCAL
	;同時射精
	IF NOWEX:射精 && NOWEX:MASTER:射精
		PRINTFORMW
		RETURN 1
		;TARGETだけ射精
	ELSEIF NOWEX:射精
		;PLAYERについてる
		IF GETBIT(TALENT:PLAYER:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			PRINTFORMW
			RETURN 1
		ENDIF
		;PLAYERだけ射精
	ELSE
