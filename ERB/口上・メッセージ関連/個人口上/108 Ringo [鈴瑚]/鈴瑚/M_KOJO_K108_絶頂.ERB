		IF GETBIT(TALENT:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응윽……! 응우……읏 흐읍……응으으-흐읍 흐읍」","L"
				CASE 1
					CALL HPH_PRINT,@"「응응……헉, 흐으윽……흐으윽, 흐으윽……흐읍」","L"
				CASE 2
					CALL HPH_PRINT,@"「응읍…… 응... 큭, 큭, 끅……」","L"
			ENDSELECT
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응……후후훗♪……진하고… 맛있어…후후」","L"
					PRINTFORMDW 입에서 살짝 흘러나온 정액을 손가락으로 핥아먹으며, 링고는 요염하게 미소 지었다……
				CASE 1
					PRINTFORML 「응윽…!? 커헉! 커헉…!」
					CALL HPH_PRINT,@"「후우…… 사정 너무 많이 했네…… HPH 그렇게 기분 좋았어?」","W"
				CASE 2
					CALL HPH_PRINT,@"「후우……♪ 잘 먹었습니다... HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
