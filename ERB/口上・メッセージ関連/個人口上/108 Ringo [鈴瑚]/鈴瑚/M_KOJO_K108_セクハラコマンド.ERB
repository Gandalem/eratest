;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K108_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_311
RETURN 0

@M_KOJO_MESSAGE_COM_K108_311
CALL M_KOJO_MESSAGE_COM_K108_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 시간이 멈춘 링고를 끌어안았다.
		PRINTFORMDW ……전혀 표정이 변하지 않아서, 조금 섬뜩하다.
	ELSEIF CFLAG:睡眠
		CALL HPH_PRINT,@"「응……흐으윽……후후…♪」","W"
		RETURN 1
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;前から抱きつく
			CASE 32
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐응읏! 흐읍읏!」","L"
						PRINTFORMDW 링고에게 안겼다. 가슴이 얼굴에 닿아 숨쉬기 힘들지만, 행복하다……
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐읍…… 조금만 더, 이대로 있게 해줘…… 흐읍」","W"
					CASE 2
						CALL HPH_PRINT,@"「어때? %CALLNAME:MASTER%……후훗」","L"
						CALL HPH_PRINT,@"「나…… 두근거리고 있지...? HPH」","W"
				ENDSELECT
				;ディープキス
			CASE 60
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응~ HPH쪽 츄읍 HPH쭈릅 HPH즈주릅 HPH쥬루우 HPH」","L"
						PRINTFORMDW 서로 끌어안은 채, 링고와 진한 키스를 나누었다……
					CASE 1
						CALL HPH_PRINT,@"「응읏... 후우욱 후욱 주르륵 쪽... 흘러... ♪ 음무우욱 주르륵쪽」","L"
						CALL HPH_PRINT,@"「—푸하앗!…… 하아 HPH 하아 HPH 하아 HPH…… %CALLNAME:MASTER%…… HPH 응…… 암으읏—」","L"
						CALL HPH_PRINT,@"「응으읏흐읍 쥬읍흐읍 주르륵흐읍 지이잉…… 주르륵흐읍 흐읍」","W"
				ENDSELECT
				;ぱふぱふ
			CASE 73
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「폭신폭신…후푸후푸…후프」","L"
						PRINTFORMDW 링고의 부드러운 가슴에 얼굴을 묻고, 행복한 시간을 만끽했다……
					CASE 1
						CALL HPH_PRINT,@"「푸후푸후…… 후후푸후……」","L"
						CALL HPH_PRINT,@"「후훗 HPH 좀 부끄럽네…… HPH」","W"
				ENDSELECT
				;乳合わせ
			CASE 74
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응응! HPH 유두가 스치는 느낌……HPH 기분 좋아앗……HPH」","L"
						PRINTFORMDW 링고와 서로의 유두를 비비며 애무했다.
					CASE 1
						CALL HPH_PRINT,@"「응읏... HPH 아아... HPH %CALLNAME:MASTER%어때...? 유두, 기분 좋아...?」","L"
						PRINTFORMDW 링고와 가슴골을 비비며 쾌감을 공유했다…
				ENDSELECT
				;乳を吸わせる
			CASE 77
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응응흐으윽 HPH 더… HPH 가슴, 빨고 싶어… HPH HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……착한 아이, 착한 아이……착한 아이」","L"
						PRINTFORMDL 무의식중에 %조사처리(CALLNAME:MASTER,"는")% 링고의 유두를 빨고 있었다.
						PRINTFORMDW 어딘가 그리운 기분이 된 %조사처리(CALLNAME:MASTER,"는")%, 잠시 동안 링고에게 응석을 부렸다……
				ENDSELECT
				;85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ
			CASE 85,87,88,89
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아……흐읍 흐읍 %CALLNAME:MASTER%……흐읍 좋아욧 흐읍 더 깊숙이욧 흐읍」","L"
						PRINTFORMDW 링고를 끌어안은 채, 더욱 깊숙이 육봉을 밀어 넣는다...!
					CASE 1
						CALL HPH_PRINT,@"「아우흐윽! 하으윽! 후우... 기분 좋아읏 더... 더 원해읏 흐읍, 흐읍」","L"
						PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"에게")% 안겨서, 허리를 격렬하게 움직였다...!
				ENDSELECT
				;だいしゅきホールド
			CASE 86
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「앗 흐으흐 아아앗 흐으흐 %CALLNAME:MASTER%부탁이야 흐으흐 안에!! 안에에엣 흐으흐」","L"
						PRINTFORMDW 링고가 %조사처리(CALLNAME:MASTER,"의")% 허리에 다리를 감아온다...!
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……HPH 질내 사정 안 해주면 싫어…HPH HPH」","L"
						PRINTFORMDW 링고가 다리와 팔을 얽으며 밀착해 왔다...!
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「……후훗흐응」","L"
						PRINTFORMDW 링고에게 안기자, 조금 부끄러운 듯 되안아주었다.
					CASE 1
						CALL HPH_PRINT,@"「……맞췄잖아 HPH 말이야…… ♪」","L"
						PRINTFORMDW 링고의 가슴 감촉을 즐겼다...!
					CASE 2
						PRINTFORML 「……후후 후후」
						PRINTFORMDW 아무 말 없이 링고와 껴안고, 서로의 가슴 박동을 들으며 잠시 휴식을 취했다.
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:6
				CASE 0
					PRINTFORML 「후후…… HPH 어쩔 수 없네 HPH」
					PRINTFORMDW 링고도 되안아 주었다.
				CASE 1
					CALL HPH_PRINT,@"「응…… HPH 갑자기 왜 그래? %CALLNAME:MASTER%…… HPH」","L"
					PRINTFORMDW 링고도 만족스러워 보이고…….
				CASE 2
					PRINTFORML 「왜 그래? %CALLNAME:MASTER%」
					CALL HPH_PRINT,@"「……혹시, 하고 싶어졌나…? HPH」","L"
					PRINTFORMDW 밀착된 피부를 통해, 링고의 고동이 전해져 온다...!
				CASE 3
					PRINTFORMDL "링고, 좋아해."
					CALL HPH_PRINT,@"「나도 좋아해, %CALLNAME:MASTER%……후훗」","L"
					PRINTFORMDW 링고를 뒤에서 껴안고, 귓가에 사랑을 속삭였다.
				CASE 4
					CALL HPH_PRINT,@"「아……흐읍…응…쪽HPH」","L"
					PRINTFORMDW 링고와 껴안고 있는 사이에 눈이 마주치더니, 어느 쪽에서든 키스를 나누었다……
					CALL MUTUAL_KISS() ;custom code
				CASE 5
					CALL COLORMESSAGE("「......윽!? 콜록! 콜록...!」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 껴안는 타이밍이 나빴던 걸까, 링고가 기침을 해버렸다…….
			ENDSELECT
		ELSEIF TALENT:恋慕 || TALENT:セフレ
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「아우……흐읍…흐읍」","L"
					PRINTFORMDW 링고가 살짝 머뭇거리며 되안아온다…….
				CASE 1
					CALL HPH_PRINT,@"「……후프 후프」","L"
					PRINTFORML 「――엣!? ……네, 이제 끝이다!」
					PRINTFORMW (떠내려 갈 뻔했다……!)
				CASE 2
					PRINTFORML 「야, 그만두라고...! 부끄러우니까...」
					PRINTFORMW 「"저항해라"니... 그런 걸 할 수 있을 리가...」
				CASE 3
					CALL COLORMESSAGE("「......윽!? 콜록! 콜록...!」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 껴안는 타이밍이 나빴던 걸까, 링고가 기침을 해버렸다…….
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「?……왜 그래? 갑자기 안아와서」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 안겨도, 링고는 딱히 신경 쓰지 않는 듯했다…
				CASE 1
					PRINTFORML 「어? 갑자기 안기거나 해서, 무슨 일이야?」
					PRINTFORMW 「……두근두근? 아니, 별로……」
				CASE 2
					CALL COLORMESSAGE("「……역시 너라는 사람은, 위험한 인물일지도 몰라?」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「――그 이상 다가오면 봐주지 않아」
					PRINTFORMDW 링고가 뾰족한 꼬챙이 끝을 이쪽으로 겨누고 있다……
				CASE 1
					PRINTFORML (…지나친 스킨십. 이건, %조사처리(CALLNAME:MASTER,"는")% 정화 대상인가……)
					PRINTFORMDW 위기를 감지한 %조사처리(CALLNAME:MASTER,"는")%, 링고에게서 떨어졌다……
				CASE 2
					CALL COLORMESSAGE("「......너 덕분에 땅이 좀 싫어졌을지도 몰라」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 안기자, 링고는 싫은 표정을 짓는다……
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
