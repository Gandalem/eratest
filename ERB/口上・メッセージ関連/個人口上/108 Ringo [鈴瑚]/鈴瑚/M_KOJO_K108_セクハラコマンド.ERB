@M_KOJO_MESSAGE_COM_K108_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;鈴瑚の場合はズボンずり下げになる
	IF FLAG:70
		PRINTFORMDL 시간이 멈춘 링고의 바지를 세게 끌어내렸다.
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 커다란 엉덩이와 함께 귀여운 팬티가 모습을 드러냈다...!
			CASE 1
				PRINTFORMDW 실수로 팬티도 같이 내려버렸어...!
		ENDSELECT
	ELSEIF CFLAG:うふふ == 2
		CALL HPH_PRINT,@"「후후…… HPH 봐봐, %CALLNAME:MASTER%…… HPH」","L"
		CALL HPH_PRINT,@"「너의 거시기, 깊숙이 다 닿았어…… HPH」","L"
		PRINTFORMDW 링고가 서로의 성기가 연결되어 있는 모습을 보여준다...!
	ELSE
		SELECTCASE TFLAG:193
			;ビンタ
			CASE -5
				PRINTFORML 「――엣!?」
				PRINTFORMDW 링고의 바지를 내리려고 했는데 맞았다……
				;つねられる
			CASE -3
				PRINTFORML 「어쩜 그렇게 당당하게 그런 걸 할 수 있어」
				PRINTFORML 「어이없음을 넘어 흥미가 생기네…….」
				PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"의")% 뺨을 잡아당기며 한숨을 내쉬었다……
				;嫌がる
			CASE -1
				PRINTFORML 「――하아!? 잠시만...! 뭐 하는 거야!?」
				PRINTFORMDW 빈틈을 타 바지를 내리려 했으나, 실패했다…….
				;嫌がる（嬉しげ）
			CASE 0
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「아……!? 그, 싫어! 이런 데서는……!」
					PRINTFORMW 「……적어도, 사람이 없는 곳에서……!」
				ELSE
					PRINTFORML 「응구우~~!! 바지가 늘어나니까 놔줘~앗!」
					PRINTFORMDW 대체 그렇게 벗겨지고 싶지 않은 건가, 링고는 바지를 붙잡고 저항하고 있다……
				ENDIF
				;成功
			CASE 1
				IF ABL:露出癖 <= 2
					;穿いてる
					IF TEQUIP:0 > 1
						PRINTFORML 「알아…… 알겠다고...! 보여줄 테니까 손, 떼줘...」
						PRINTFORML 「~~읏! ......자...! 이걸로 됐지...?」
						PRINTFORMDW 링고는 바지를 내리고 팬티를 보여주었다...
						;穿いてない
					ELSE
						PRINTFORML 「지금!?…… 그럼, 눈 감고 있어……!」
						PRINTFORML 「……크으윽……~~앗...!」
						PRINTFORML 「……역시 멈춰― 아! 지금 봤어!! 잊어버려! 당장!!」
						PRINTFORMDW 아주 짧은 순간이었지만, 링고의 화원이 보였다…!
					ENDIF
				ELSEIF ABL:露出癖 <= 4
					;穿いてる
					IF TEQUIP:0 > 1
						PRINTFORML 「……말해두는데, 이런 건 너한테만 하는 거니까...!」
						PRINTFORML 「……윽!」
						PRINTFORML (%조사처리(CALLNAME:MASTER,"에게")% 보여지고 있어...! 부끄러워......!)
						PRINTFORMDW 링고의 팬티를 한참 보면서 시간을 보냈다...!
						;穿いてない
					ELSE
						PRINTFORML 「이, 지금!? 그, 그거…… 아무에게도 말하지 않을 거지?」
						PRINTFORML 「……그럼...! ……네, …네...!」
						PRINTFORML 「……큿! ……흐윽...!」
						PRINTFORMDW 링고가 얼굴을 새빨갛게 물들이며 바지를 아래로 내리자, 있어야 할 속옷은 없었다……!
					ENDIF
				ELSE
					;穿いてる
					IF TEQUIP:0 > 1
						CALL HPH_PRINT,@"「……보고 싶으면, 네가 벗겨줘…… HPH」","L"
						PRINTFORMDL 링고의 바지에 손가락을 걸고, 천천히 아래로 끌어내렸다……
						CALL HPH_PRINT,@"「……HPH…… 어때? 네가 좋아할 만한 거 입고 왔는데…… HPH」","W"
						;穿いてない
					ELSE
						CALL HPH_PRINT,@"「지금은…… 그게… 안 돼…… HPH」","L"
						CALL HPH_PRINT,@"「앗...! 아아... HPH... 안 된다고 말하고 있는데에... HPH」","L"
						PRINTFORMDL 링고의 바지에 손가락을 걸어 천천히 끌어내리는데…… 하지만 말과는 달리 저항은 없었다…….
						CALL HPH_PRINT,@"「……후후… HPH…… 들켜버렸어…… HPH」","L"
						PRINTFORMDW 바지 아래에는 팬티조차 없어서, 링고의 은밀한 곳은 실이 끊어질 정도로 흥건하게 젖어 있었다...!
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
