;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K108_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_310
RETURN 0

@M_KOJO_MESSAGE_COM_K108_310
CALL M_KOJO_MESSAGE_COM_K108_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDW 시간이 멈춘 링고의 엉덩이를 쓰다듬었다. 산후 조리용으로 딱 알맞은 크기이다.
	ELSEIF CFLAG:睡眠
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「응응... 응으...?」
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%~…! 뭐 해…… Zzz…」
				PRINTFORMDW 일어난 줄 알았는데, 수면 중의 말이었던 모양이다…
		ENDSELECT
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;クンニ強制
			CASE 70
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응응읏 HPH 지금은 엉덩이가 아니라, 보지잖아……HPH」","W"
					CASEELSE
						CALL HPH_PRINT,@"「히얏! 큭큭… 벌써, 되갚아주겠어읏」","L"
						PRINTFORMDW 링고가 조금 강하게 은밀한 곳을 밀어붙여 왔다...!
				ENDSELECT
				;アナル奉仕
			CASE 72
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「유비읏... HPH 엉덩이에... 들어와... 아아... HPH」","W"
					CASEELSE
						CALL HPH_PRINT,@"「아앗 HPH 엉덩이…… 더, 오옷 HPH」","W"
				ENDSELECT
				;スカートの中を見せる
			CASE 35
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「음응…후훗 후훗… 애태우기만 하고 있어……후훗」","W"
					CASEELSE
						CALL HPH_PRINT,@"「아... 후으음... 후으음, 엉덩이... 직접 만져지고 있어... 후으음」","W"
				ENDSELECT
				;素股
			CASE 52
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗 후후... 저는 기분 좋게 해드리지 않아도 돼용! 후후」","W"
					CASEELSE
						CALL HPH_PRINT,@"「응읏 HPH... 엉덩이, 쓰다듬지 말아줘... HPH」","W"
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗 흐응... 저는 기분 좋게 해줄 필요 없는 거야아앙!」","W"
					CASEELSE
						CALL HPH_PRINT,@"「응읏 HPH... 엉덩이, 쓰다듬지 말아줘... HPH」","W"
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%～? 대체 이 손은 어디를 만지려 했던 걸까~~?」
					PRINTFORMDW 링고에게 들켜, 손을 비틀어 올리게 되었다……
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응응... HPH %CALLNAME:MASTER%…… 흥분해 버렸나? HPH」","W"
						CASE 1
							CALL HPH_PRINT,@"「흐으윽... 후흡, 끅... 흐읍」","L"
							PRINTFORMW (%CALLNAME:MASTER%……! 설마, 이런 곳에서...!? )
						CASE 2
							CALL HPH_PRINT,@"「응응...! 응읏... 후후... 응으으... 후후」","L"
							PRINTFORMDW 민감한 꼬리를 만져지자, 링고는 필사적으로 신음을 참는다...!
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「히끅! 히응… 후후… ♪ 간, 간지러워어… 히끅」","W"
						CASE 1
							CALL HPH_PRINT,@"「응읏... 흐읍... 흐읍... 흐읍 %CALLNAME:MASTER%... 더... 더 해줘...」","L"
							PRINTFORMDW 링고는 엉덩이를 쓰다듬어지자, 흥분하기 시작한 것 같아...!
						CASE 2
							CALL HPH_PRINT,@"「흐아읍! 후후, 아앗... 꼬리야읏... 후후 후후」","L"
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏후후, 더 후후, 그거, 더 해줘으윽후후」","L"
							PRINTFORMDW 링고는 꼬리를 쓰다듬어지자 달콤한 소리를 내고 있다……
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「――앗!?……뭐 하는 거야!」
					PRINTFORMDW 링고에게 맞았다……
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「싫어……싫다고…… HPH 그만해, 제발…… HPH」","W"
						CASE 1 ;custom code
							CALL HPH_PRINT,@"「히야앗 후으읍 후으읍」","L"
							PRINTFORML 「―앗!」
							PRINTFORMDW 꼬리를 만졌더니, 링고에게 손아귀로 잡혔다…….
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「응응... 흐으윽... 저기... 아직 만져줘?」","W"
						CASE 1
							CALL HPH_PRINT,@"「흐으응읏 HPH, 꼬리야 하아앗... HPH」","L"
							CALL HPH_PRINT,@"「그, 그만해...! 아... 아앗... HPH」","L"
							PRINTFORMDW 링고는 꼬리를 쓰다듬는 것에 약한 듯하다.
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
