				ENDIF
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 몰입한 듯, 링고의 치태를 눈에 새기고 있다...!
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					CALL HPH_PRINT,@"「아앗 후으윽! 후으윽! 아우우우우읏! 후후후후훗」","L"
					CALL HPH_PRINT,@"「하아 흐으 하아 흐으 후우~……후우, 개운해졌어…♪」","L"
					PRINTFORML 「그럼, %CALLNAME:MASTER%. 이제 잘 거니까 나가줘」
					PRINTFORMDW 링고에게 방에서 쫓겨났다…….
				ELSE
					PRINTFORML 「그, 그만둬――!!」
					PRINTFORMDL 큰 소리를 지르는 링고에게 놀라 %조사처리(CALLNAME:MASTER,"는")% 황급히 방을 뛰쳐나갔다……
					PRINTFORMW (아, 정말! 왜 내가 문을 잠가두지 않았던 거지……!)
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
