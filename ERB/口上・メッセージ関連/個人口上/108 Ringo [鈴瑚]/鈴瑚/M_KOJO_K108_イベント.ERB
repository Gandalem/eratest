@M_KOJO_SPEVENT_MESSAGECHECK_K108_2
RETURN 1

@M_KOJO_SPEVENT_K108_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML 
		PRINTFORMDL 귀가하는 도중, 문득 링고가 발걸음을 멈추었다.
		PRINTFORML 「……저기 %CALLNAME:MASTER%. 아직 시간 있으니까, 잠시 거기서 쉬지 않을래?」
		PRINTFORMDL 링고가 손가락으로 가리킨 곳에는 두 사람이 나란히 앉을 만한 크기의 바위가 있었다.
		PRINTFORMDW 
		CALL COLORMESSAGE("「…………。」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		SETCOLOR 0xEE9900
		PRINTFORMDL ……링고는 한마디도 대화하지 않고, 조용히 단자를 먹는다.
		PRINTFORMDW 진전이 없자 "뭔가 하고 싶은 말이 있는 것 아니야"라고 말을 꺼냈다.
		PRINTFORML 「―!…하하읏…♪ 너에게는 이길 수 없다……」
		PRINTFORML 「……그게… 너를 지상인의 샘플로 조사해 왔는데……」
		PRINTFORMW 「%CALLNAME:MASTER%에 대해… 더 알고 싶어, 아니… 그러니까… 음…」
		PRINTFORMW 「―%CALLNAME:MASTER%! 나, 네가 좋아읏! 연인이 되고…!! …되어도… 괜찮아…?」
		PRINTFORMDL 마지막 부분은 거의 사라질 듯한 목소리였다… 링고 나름으로 용기를 낸 것이었다.
		PRINTFORMDW 링고의 고백에, %조사처리(CALLNAME:MASTER,"는")%―
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「―윽! ...정말? 거짓말... 아니야...?」
		PRINTFORMDW 힘차게 고개를 끄덕이며 "내 연인이 되어줬으면 좋겠어"라고 분명한 말로 전했다.
		PRINTFORML 「……응옷!」
		PRINTFORMDW 가슴으로 뛰어든 링고를 간신히 지탱하며, 힘껏 끌어안았다...!
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「……윽! ……그렇겠지…… 나는 토끼, 너는 지상인이니까. 종족이 다르니까……」
		PRINTFORMW 「……고마워 %CALLNAME:MASTER%♪ 뭔가 후련해졌어...!」
		PRINTFORML 「―아, 맞다! 나 잠깐 볼일이 생겼어. 미안하지만 먼저 돌아가 있어! 잘 가!</자!」
		PRINTFORMDW 일방적으로 말을 늘어놓자, 링고는 하늘로 날아가 버렸다. %조사처리(CALLNAME:MASTER,"는")% 홀로 귀가길에 올랐다…
		PRINTFORMDW 
		CALL COLORMESSAGE("「…………。」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORMW MGMG
		CALL COLORMESSAGE("「……。」", C_ORANGE, 0, 0)
		PRINTFORMW MGMG
		CALL COLORMESSAGE("「―흑...!!......우...으윽...! 큭, 크...! ...흐윽...!」", C_ORANGE, 0, 0)
		PRINTFORMW MGMG
		;レイセン口上からお借りしました告白禁止フラグ
		SETBIT CFLAG:[[鈴瑚]]:デート後イベントフラグ , 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1
