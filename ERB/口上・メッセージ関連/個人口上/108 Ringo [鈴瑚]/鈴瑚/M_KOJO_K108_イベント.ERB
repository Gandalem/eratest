							PRINTFORMW 「안 해. 농담이야, 농담。」
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
