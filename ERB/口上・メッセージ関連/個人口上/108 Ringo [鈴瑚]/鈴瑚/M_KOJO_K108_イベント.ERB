						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「전부터 생각했지만... 다른 사람이 입던 팬티 모으는 건 절대 이상해......」
							PRINTFORMDW 링고에게 가여운 물건을 보는 듯한 시선을 받아서, 팬티는 포기했다……
							RETURN 1
						ENDIF
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
