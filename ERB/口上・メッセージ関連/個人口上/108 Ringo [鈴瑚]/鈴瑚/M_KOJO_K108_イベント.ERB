					PRINTFORMDW 링고는 부끄러워하는 표정이었지만, 질 구멍을 크게 벌리며 유혹해 왔다...!
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					CALL HPH_PRINT,@"「하아 HPH 하아 HPH 하아…… HPH 후우으…… HPH」","L"
					CALL HPH_PRINT,@"(역시, %조사처리(CALLNAME:MASTER,"와")% 하는 게 더 기분 좋아……흐흣)","W"
				ELSEIF TALENT:恋慕
					CALL HPH_PRINT,@"「하아…… 하아…… %CALLNAME:MASTER%, 그게……」","L"
					CALL HPH_PRINT,@"「...기분 좋았어......후우으읍」","W"
				ELSE
					CALL HPH_PRINT,@"「하아... HPH 하아... HPH 후우으...」","L"
					CALL HPH_PRINT,@"「―에?…… 응, 기분 좋았어……. 후으으」","W"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				CALL HPH_PRINT,@"「하아 흐읍 하아 흐읍――%CALLNAME:MASTER%읏」","L"
				PRINTFORMDL 갑자기 링고에게 입술을 빼앗기고, 입으로 무언가를 마시게 됐어...!
				CALL HPH_PRINT,@"「후훗... HPH 맛있었어? 나의 특제 단고... HPH」","L"
				PRINTFORMDW 순간―%조사처리(CALLNAME:MASTER,"의")% 몸이 타오르는 듯한 열기를 띠었고, 시들었던 성기가 다시 단단함을 되찾았다...!
				PRINTFORML 「좋아 좋아 효과가 나타나기 시작했네…♪ 반으로 나누었으니 나도―」
				CALL HPH_PRINT,@"「아아앗 흐윽, 왔다아아 히히 %CALLNAME:MASTER%읏 더 해줘 히히」","L"
				PRINTFORMDW 링고가 달콤한 곳을 펼치자마자, %조사처리(CALLNAME:MASTER,"는")% 아플 정도로 발기된 성기를 삽입하고 있었다...!
				CALL HPH_PRINT,@"「아아아악! 후우후우후우, 넣기만 했는데…… 하앗!」","L"
				CALL HPH_PRINT,@"「아앗 HPH%CALLNAME:MASTER%, 세게 해줘― 후아아앗! HPH」","W"
				PRINTFORMDW …………。
				CALL HPH_PRINT,@"「하으윽! 하아앗! 흐읍! 흐읍!」","L"
				PRINTFORMDL 링고는 새빨갛게 충혈된 질구에서 엄청난 양의 정액을 흘리며 실신해 있다…….
				PRINTFORMDW 무슨 일이 있었는지 기억해내려 했으나, 격렬한 권태감에 휩싸여 %조사처리(CALLNAME:MASTER,"는")% 의식을 놓았다…….
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
