								CALL HPH_PRINT,@"「응윽!? 응으읍...! 응응... HPH... 구쿠... HPH... 구끅... HPH」","L"
								CALL HPH_PRINT,@"「―푸하앗! …하아… HPH 하아… HPH 후우… 괴로웠다… HPH」","W"
								CALL HPH_PRINT,@"「...있잖아, 그런 일 할 때는 제대로 말해줘... HPH」","L"
								PRINTFORMDW 말투는 조금 화가 나 있지만, 링고는 어딘가 기쁜 듯 미소 지었다.
								BASE:MASTER:精力 -= 200
						ENDSELECT
					CASE 1
						PRINTFORML 「아, %CALLNAME:MASTER%일어―」
						PRINTFORML 「푸핫! 아하하하하! 엄청난 잠 머리야!」
						PRINTFORMDW 링고에게 웃음을 자아내며 부끄러운 기분이 되어 세면대로 향했다……
					CASE 2
						PRINTFORMW 「아, %CALLNAME:MASTER%안녕……」
						IF TALENT:恋人
							CALL HPH_PRINT,@" 「...정말 아침부터 활기 넘치네... HPH」","L"
							PRINTFORMDW 링고가 아침에 발기한 아들을 손으로 문지르고 있다…….
						ELSE
							PRINTFORML 「...어디를 봐야 할지 모르겠으니까, "그것"을 어떻게 해줬으면 좋겠어?」
							PRINTFORMDW 링고에게 아침의 생리 현상을 들켜버렸다.
						ENDIF
					CASE 3
						PRINTFORMDL 왠지 맛있는 냄새가 나는 것 같아…… %조사처리(CALLNAME:MASTER,"는")% 눈을 떴다.
						CALL COLORMESSAGE("「안녕. 아쉽네~ 좀 더 일찍 일어나면 내 아침밥을 먹을 수 있었을 텐데」", C_ORANGE, 0, 0)
						SETCOLOR 0xFFFF00
						PRINTFORML MGMG
						PRINTFORMDW 조금 아쉬운 기분이 들면서, %조사처리(CALLNAME:MASTER,"는")% 몸을 일으켰다.
				ENDSELECT
			CASEELSE
				PRINTFORML 「%CALLNAME:MASTER%안녕」
				PRINTFORML 「...아니, 늦었나...?」
				PRINTFORMDW 아무래도 너무 잔 것 같아…….
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		CALL HPH_PRINT,@"「응…… 헤헤… %CALLNAME:MASTER%… 후후」","L"
		PRINTFORMDW 링고를 깨우지 않도록 부드럽게 머리를 쓰다듬었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORML 「좋은 아침, %CALLNAME:MASTER%……」
			PRINTFORML 「아니~ 어제는 볼만 한 모습을 보여줘서 미안했네……」
			PRINTFORMDW 링고는 민망한 듯 머리를 긁적이고 있다.
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「……안녕~ 몽롱해……」
					PRINTFORMDW 링고는 아직 졸려 보인다...
				CASE 1
					PRINTFORML 「모자~… 어라? 모자가 어디 갔지…?」
					PRINTFORMDW 링고는 모자를 쓴 채로 모자를 찾고 있다…….
				CASE 2
					CALL COLORMESSAGE("「안녕... 오늘 아침밥 뭐야?」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고는 단자를 먹으면서 아침밥을 요구해 왔다……
				CASE 3
					PRINTFORML 「%CALLNAME:MASTER%안녕~」
					CALL HPH_PRINT,@"「음… HPH 오늘도 잘 부탁해~♪」","L"
					PRINTFORMDW 링고는 가볍게 입을 맞추고 옷을 가지러 갔다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
