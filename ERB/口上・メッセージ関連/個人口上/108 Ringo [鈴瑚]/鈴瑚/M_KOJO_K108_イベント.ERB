							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋人
								CALL HPH_PRINT,@"「괜찮아 HPH 그 대신……♪」","L"
								CALL HPH_PRINT,@"(다음에 그 팬티로 자위하는 거 보여줘, HPH)","W"
							ELSEIF TALENT:恋慕
								CALL HPH_PRINT,@"「네, 여기 있어요... HPH」","L"
							ELSE
								PRINTFORML 「네~ 네~…… 정말이지, 너란 애는……♪」
							ENDIF
							PRINTFORMDW 단고처럼 말려진 링고의 팬티를 받았다.
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋人
								PRINTFORML 「모~ 그건 내가 아끼는 거니까 소중히 다뤄줘~♪」
							ELSEIF TALENT:恋慕
								PRINTFORML 「에엣……? 하, 네……」
							ELSE
								PRINTFORML 「……변태」
							ENDIF
							PRINTFORMDW 단고처럼 말려진 링고의 팬티를 받았다.
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
