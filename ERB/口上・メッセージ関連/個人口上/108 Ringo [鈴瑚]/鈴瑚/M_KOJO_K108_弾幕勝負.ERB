; Modular ERB: 個人口上/108 Ringo [鈴瑚]/鈴瑚/M_KOJO_K108_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;ブチギレ口上はナイトメアダイアリー風

@M_KOJO_MESSAGE_COM_K108_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(108) == "酔いどれ" || ALCOHOL_FACE(108) == "ぐでぐで"
			PRINTFORML 「말해두는데, 취한 정도 가지고 질 만한 상대 아니라고」
		ELSEIF TALENT:108:機嫌 == -1 || CFLAG:108:ブチギレ || MARK:108:反発刻印 >= 3
			PRINTFORML 「토부 『스트로베리 대덩고』」
			SETCOLOR 0xC07070
			PRINTFORMW 링고가 내가 경계하기도 전에 달려들었다!!
			;あなた戦闘能力1以下
		ELSEIF ABL:MASTER:戦闘能力 < 1
			PRINTFORML 「%CALLNAME:MASTER%, 내가 어떤 존재인지 알고 있는 거야?」
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「하찮다고 생각하고 방심하면 큰 코 다친다구」
				CASE 1
					PRINTFORMW 「뭐 됐어. 빨리 끝내고 쉬려고」
				CASE 2
					PRINTFORMW 「우리는 달의 토끼 조사부대 <이글라비>. 더러운 지상인들에게 지지 않아」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					;あなた戦闘能力4以上
					IF ABL:MASTER:戦闘能力 >= 4
						PRINTFORML (헤에... %조사처리(CALLNAME:MASTER,"의")% 이 강함...!?)
						PRINTFORMW 「이거 재미있겠다! 봐주지 않고 놀 수 있겠네!」
					ELSE
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 전투 능력 조사 시작!」
					ENDIF
				CASE 1
					;鈴瑚戦闘能力3以上
					IF ABL:戦闘能力 >= 3
						PRINTFORML 「%CALLNAME:MASTER%, 나에게 봐주기는 필요 없다」
						PRINTFORMW 「강해진 건 너만이 아니라는 거야!」
					ELSE
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 전투 능력 조사 시작!」
					ENDIF
				CASE 2
					PRINTFORML 「단 한 번의 피격 <미스>도 용납하지 않는, 달의 유파 <루나틱>에 기절해 보거라!」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 2
			IF TALENT:108:機嫌 == -1 || CFLAG:108:ブチギレ || MARK:108:反発刻印 >= 3
				;本当はこの時点ではまだ使えないけど
				PRINTFORML 「토부 '단고 삼자매'」
				PRINTFORMDW 이 탄막은 피할 수 없어...! 포기하려던 순간, %조사처리(CALLNAME:MASTER,"의")% 뇌리에 목소리가 울렸다...
				PRINTFORMDW ――저속 이동을 두 번 누르면 일정 거리 순간이동한다 ――
			ELSE
				;あなたの戦闘能力4以上でスペルカード増加
				IF ABL:MASTER:戦闘能力 >= 4
					CALL COLORMESSAGE("「역시 너는 강하구나... 그렇기에 쓰러뜨릴 가치가 있는 거지!」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
				ELSE
					CALL COLORMESSAGE("「할 거네... 슬슬 나도 본심을 내야 하나」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
				ENDIF
				SETCOLOR 0xEE9900
				PRINTFORMDW 링고가 손에 들고 있는 단자를 먹을 때마다, 링고의 힘이 증폭해 간다...!
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「한 방 제대로 받아라!」
						IF ABL:MASTER:戦闘能力 >= 4
							PRINTFORMW 「토부 『%TEXTR("ストロベリーダンゴ/ベリーベリーダンゴ")%』!」
						ELSE
							PRINTFORMW 「토부 '스트로베리 단고'!」
						ENDIF
					CASE 1
						PRINTFORML 「너에게 이것이 보일까?」
						PRINTFORMW 「토부 『단고 인플루언스』!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 1
			IF TALENT:108:機嫌 == -1 || CFLAG:108:ブチギレ || MARK:108:反発刻印 >= 3
				PRINTFORMW 「단고『단고 플라워』」
				PRINTFORMDL  %조사처리(CALLNAME:MASTER,"는")% 순간이동을 습득했다!
				PRINTFORMDW  링고의 탄막을 빠져나와 간신히 접근하는 데 성공했다...!
			ELSE
				;あなたの戦闘能力4以上でスペルカード増加
				SELECTCASE RAND:2
					CASE 0
						IF ABL:MASTER:戦闘能力 >= 4
							PRINTFORMW (……이제 남은 게 없네… 지금의 %조사처리(CALLNAME:MASTER,"를")% 이기려면, 비장의 수를 쓸 수밖에 없어…!)
							PRINTFORML 「스으……윽! 아아―」
							PRINTFORMDL 링고는 어디선가 대량의 단자를 꺼내, 크게 입을 벌리고 그것들을 전부 통째로 삼켰다...!
							PRINTFORMDW 단자를 삼키자마자, 링고에게서 느껴지던 힘이 방금 전과는 비교할 수 없을 정도로 강해졌다!
							PRINTFORML 「응윽… 후우…… 자! 이걸로 마지막이다!」
							PRINTFORMW 「츠키미노 사케 '루나틱 세프템버'!!」
						ELSE
							PRINTFORMW (……별로 이기지 않아도, 그렇다고 말하더라도… 지는 건 짜증나니까...! )
							PRINTFORML 「아아... 우물우물 모구모구 MGMG...」
							PRINTFORMDW 링고는 마지막 스펠카드를 선언하기 위해 손에 들고 있던 단고를 전부 해치우며 힘을 비축했다...!
							PRINTFORMW 「케훗…… 자, 간다! 달맞이 『세프템버 풀문』!」
						ENDIF
					CASE 1
						PRINTFORMW (……별로 이기지 않아도 된다고는 해도… 지는 건 싫으니까…!)
						PRINTFORML 「아아… 냠냠 모구모구 MGMG…」
						PRINTFORMDW 링고는 마지막 스펠카드를 선언하기 위해, 손에 들고 있던 단고를 전부 먹어 힘을 비축했다…!
						PRINTFORMW 「케훗…… 자 이제 간다! 달맞이 『세프템버 풀문』!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 0
			IF TALENT:108:機嫌 == -1 || CFLAG:108:ブチギレ || MARK:108:反発刻印 >= 3
				PRINTFORML  「………………。」
				PRINTFORMDW  링고의 공격이 멈추자마자 %조사처리(CALLNAME:MASTER,"는")% 의식을 잃었다…….
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「%CALLNAME:MASTER%대단하다. 강하네」
					CASE 1
						PRINTFORMW 「단고가 없어서…… 힘이 안 나……」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【残忍酷薄】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "残忍酷薄"
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【乾坤一擲】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "乾坤一擲"
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【怪力乱神】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "怪力乱神"
ENDIF
;-------------------------------------------------
;戦闘後
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後"
	PRINTFORML 
	;残り残機4が表示されうるのは【洽覧深識】持ちのみ
	;残機が1以上ならあなたの負け、0の場合はあなたの勝利
	;あなた勝利
	IF 相手残機 == 0
		IF TALENT:108:機嫌 == -1 || CFLAG:108:ブチギレ || MARK:108:反発刻印 >= 3
			PRINTFORMDL 정신을 차려보니, %조사처리(CALLNAME:MASTER,"는")% 원래 있던 장소에 있었다. 순간이동도 사용할 수 없게 되어버렸다.
			PRINTFORMDW 링고와 싸운 탓에 저런 악몽을 본 걸지도 몰라. 나중에 제대로 사과하는 게 좋을까……
		ELSE
			PRINTFORML 
			PRINTFORMDW 승부가 끝나자, 링고는 땅에 대자로 누워 버렸다.
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, 아파… 하하… 좀 너무 열중해 버렸다…」
					PRINTFORMW 「아… 손 빌려 줄래? 고마워… 너는 다정하네…♪」
					PRINTFORMW (……%조사처리(CALLNAME:MASTER,"는")% 확실히 강하지만, 달을 위협할 정도는 아니다. 경계하지 않아도 좋다……)
					PRINTFORML
					SETCOLOR 0xFFE9A9
					PRINTFORML      스테이지 클리어
					PRINTFORMDL      클리어 보너스
					PRINTFORMDL       10,000,000
					PRINTFORMDW 
				CASE 1
					;あなたが鈴瑚より格下だと台詞変化 実際に勝てるかどうかは知らん
					PRINTFORML 「이야아 놀랐네. 설마 이렇게 당할 줄은 몰랐는데……」
					IF ABL:MASTER:戦闘能力 < 1
						PRINTFORMW 「너, 보기엔 안 돼서 강하네. 장래가 촉망돼」
						PRINTFORML (정말로 이대로 힘을 키우다 보면, 달을 위협하는 존재가 될지도 모르겠어……)
					ELSE
						PRINTFORMW 「%CALLNAME:MASTER%정말 강하네. 나로는 상대가 안 돼」
						PRINTFORML (정말로... 구운 정도로는 모여도 이기지 못할 것 같아)
					ENDIF
					PRINTFORMW (…… %CALLNAME:MASTER%…… 경계해야 해, 앗……)
					PRINTFORML
					SETCOLOR 0xFFE9A9
					PRINTFORML      스테이지 클리어
					PRINTFORMDL      클리어 보너스
					PRINTFORMDL       10,000,000
					PRINTFORMDW 
			ENDSELECT
		ENDIF
		;鈴瑚勝利
	ELSE
		IF ALCOHOL_FACE(108) == "酔いどれ" || ALCOHOL_FACE(108) == "ぐでぐで"
			PRINTFORMW 「말했잖아? 취한 정도로는 지지 않는다고」
		ELSEIF TALENT:108:機嫌 == -1 || CFLAG:108:ブチギレ || MARK:108:反発刻印 >= 3
			PRINTFORMW 「………………。」
			PRINTFORMDL 링고는 %조사처리(CALLNAME:MASTER,"에게")% 눈길도 주지 않고 가버렸다.
			PRINTFORMDL 저건 정말 링고일까? 이건 내가 보고 있는 악몽이 아닐까?
			PRINTFORMDW 그런 생각을 하고 있는 사이에, %조사처리(CALLNAME:MASTER,"의")% 앞이 새카맣게 변해갔다……
		ELSE
			IF ABL:MASTER:戦闘能力 < 1
				SELECTCASE RAND:2
					CASE 0
						CALL COLORMESSAGE("「이게 진짜 식은 죽 먹기지」", C_ORANGE, 0, 0)
						SETCOLOR 0xFFFF00
						PRINTFORMW MGMG
					CASE 1
						CALL COLORMESSAGE("「상대의 실력도 가늠할 수 없다면, 너 언젠가 죽을 거야」", C_ORANGE, 0, 0)
						SETCOLOR 0xFFFF00
						PRINTFORMW MGMG
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						;あなた戦闘能力4以上
						IF ABL:MASTER:戦闘能力 >= 4
							PRINTFORMW 「%CALLNAME:MASTER%방심했네? 아니면, 일부러 진 거야?」
						ELSE
							CALL COLORMESSAGE("(들었던 정도의 강함은 아니었네...)", C_ORANGE, 0, 0)
							SETCOLOR 0xFFFF00
							PRINTFORML MGMG
						ENDIF
					CASE 1
						;鈴瑚戦闘能力3以上
						IF ABL:戦闘能力 >= 3
							CALL COLORMESSAGE("「어때? 이게 나의 능력이야. 나는 매일 진화하고 있단다」", C_ORANGE, 0, 0)
							SETCOLOR 0xFFFF00
							PRINTFORMW MGMG
						ELSE
							CALL COLORMESSAGE("「승리의 후에 먹는 단팥은 특별하네.」", C_ORANGE, 0, 0)
							SETCOLOR 0xFFFF00
							PRINTFORMW MGMG
						ENDIF
					CASE 2
						CALL COLORMESSAGE("「승리의 후에 먹는 단팥은 특별하네.」", C_ORANGE, 0, 0)
						SETCOLOR 0xFFFF00
						PRINTFORMW MGMG
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
