; Modular ERB: 個人口上/108 Ringo [鈴瑚]/鈴瑚/M_KOJO_K108_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K108
RETURN 0

@M_KOJO_MESSAGE_MARKCNG_K108
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:苦痛刻印取得 == 1
	PRINTFORML 「잠깐...! 아프다고...!」
	PRINTFORMDW 링고는 화가 난 것 같다……
ELSEIF TFLAG:苦痛刻印取得 == 2
	PRINTFORML 「아파! 제발 그만해줘!」
	PRINTFORML 「%CALLNAME:MASTER%…… 도대체, 무슨 일이야…?」
	PRINTFORMDW 링고는 공포에 질려 떨고 있다……
ELSEIF TFLAG:苦痛刻印取得 == 3
	PRINTFORML 「――큭……!」
	PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 팔을 휘두른 것만으로도, 링고는 머리를 감싸 쥐고 떨기 시작했다…….
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMDL 움직이지 않는 링고의 가슴을 주무르자, 벌써 유두가 솟아오르기 시작했다.
	PRINTFORMDW 이것도 개발 덕분일까…… "가슴 큰 여성은 느끼기 어렵다"는 이야기는 그저 소문이었던 모양이다.
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMDL 시간이 멈춘 링고의 몸을 애무하는 %조사처리(CALLNAME:MASTER,"의")% 눈에, 토끼 특유의 새하얗고 동그란 꼬리가 걸렸다.
	PRINTFORMDL 살짝 "그것"을 쓰다듬자, 링고의 몸이 순간 움찔하고 튀어 올랐다.
	PRINTFORMDW 무척 감각에 예민한 것일까, 쓰다듬거나 주무를 때마다 온몸이 파르르 떨리고 있다...!
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMDL 눈치가 빠른 링고의 일이다. 시간을 멈추고 있는 동안, %조사처리(CALLNAME:MASTER,"에게")% 몸을 개발당하고 있다는 것을 알아차리고 있을 것이다.
	PRINTFORMDL 하지만 %조사처리(CALLNAME:MASTER,"는")% 오늘도 변함없이 링고의 지체를 나른하게 애무한다.
	PRINTFORMDL "%조사처리(CALLNAME:MASTER,"를")% 제거하면, 두 번 다시 이 쾌감을 맛볼 수 없게 될 거야"
	PRINTFORMDW 링고의 진심은 그것을 원하지 않는다는 것을 알고 있기 때문이다.
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	CALL HPH_PRINT,@"「아앗 흐으응 응으으윽흐읍흐읍흐읍」","L"
	CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐읍, 방금 그거…… 더 해줘…… 흐읍」","W"
ELSEIF TFLAG:23 == 2
	CALL HPH_PRINT,@"「아앙! 흐으응! 끅흐윽! 우우우욱! 흐읍!」","L"
	CALL HPH_PRINT,@"「기분 좋아읏 HPH 이읏―아아아아~~앗 HPH HPH HPH」","L"
	PRINTFORMDW 절정에 달했는지, 링고는 몸을 파르르 떨고 있다…….
ELSEIF TFLAG:23 == 3
	CALL HPH_PRINT,@"「아아아앗 HPH HPH 하아……! HPH 아아아아아아아―――! HPH HPH HPH」","L"
	PRINTFORMDL 링고는 침을 흘리며 스스로 성감대를 만지작거리다 쾌락에 몸을 떨고 있다……
	PRINTFORMDW 평소의 모습과 다른 그녀에게 %조사처리(CALLNAME:MASTER,"는")% 가랑이를 부풀렸다...!
ENDIF
;不埒刻印
;快楽、屈服、恭順による刻印
;LV1
IF TFLAG:24 == 11 || TFLAG:24 == 31
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「하아…… HPH앗 HPH 아아…… HPH」","L"
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐응, 더 격렬하게 해줘……. 흐응」","W"
	ELSE
		PRINTFORML (...오늘은 야한 거 안 할까...)
		PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"의")% 사타구니를 가만히 응시하고 있다...
	ENDIF
	;LV2
ELSEIF TFLAG:24 == 12 || TFLAG:24 == 32
	IF CFLAG:うふふ
		PRINTFORML 「……엣? …스스로 움직이는 거야……?」
		CALL HPH_PRINT,@"「…응…!…큭흐읍! 후우읏! 응응읏! 아앗! 큭흐읍! 흐윽!」","L"
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 피스톤을 멈추어도, 링고는 스스로 허리를 움직이며 쾌락을 얻고 있다……
	ELSE
		CALL HPH_PRINT,@"「응~? 무슨 일이야, %CALLNAME:MASTER%…… HPH」","L"
		PRINTFORMDW 링고가 히죽거리며 가랑이를 주무르기 시작했다...!
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 13 || TFLAG:24 == 33
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 햣헸 더더욱! 햣는 격렬하게 해줬으면 좋겠어! 햣헸」","L"
		CALL HPH_PRINT,@"「나의 보지이이! 후후후 난장판으로 만들어버릴 거야아아아 후후후 후후후」","L"
		PRINTFORMDL 링고의 허리를 잡자, %조사처리(CALLNAME:MASTER,"는")% 자신의 허리를 격렬하게 부딪쳤다…….
		PRINTFORMDW 튀어 오르는 듯한 교성(嬌聲)을 지르며 링고는 미쳐 날뛰고 있다……!
	ELSE
		PRINTFORML 「아파앗! 그만둬요 %조사처리(CALLNAME:MASTER,"는")%! 갑자기 왜 이러는 거예요!?」
		PRINTFORMDL 링고의 양팔을 붙잡고 벽에 끼인 채 눌러 움직임을 봉했다.
		PRINTFORMDW 속옷째 바지를 끌어내며 여자 성기를 드러내자, %조사처리(CALLNAME:MASTER,"는")% 남근을 난폭하게 밀어 넣었다.
		CALL HPH_PRINT,@"「아구우으윽! 흐읍, 아파...! 빼줘어...!」","L"
		PRINTFORMDW 애무되지 않은 질 내부는 충분히 젖지 못했고, 서로 괴로워하는 신음 소리를 내며 높은 곳으로 치솟는다...!
		CALL HPH_PRINT,@"「응으윽...! 아앗 HPH는, 격렬해...! 오, 오줌... 부풀어 올라...?」","L"
		CALL HPH_PRINT,@"「그만둬! 사정할 거면 밖에 ― 안 돼에에에에에아아아! 몸이 너무 뜨거워……!! 흐으윽, 흐으윽, 흐으윽」","W"
		PRINTFORMDW 
		CALL COLORMESSAGE("(뭐 이런 일이 벌어지나 하고 말이야...♪)", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 링고가 열기 어린 눈으로 이쪽을 바라본다…….
	ENDIF
ENDIF
;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORML 「%CALLNAME:MASTER%, 적당히 안 하면 화낼 거야」
	PRINTFORMDW 링고는 목소리에 힘을 주며 경고해 왔다……
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORML 「……있잖아. 혹시 일부러 이러는 거야?」
	PRINTFORMDW 링고는 경멸하는 듯한 눈으로 노려보았다...
ELSEIF TFLAG:反発刻印取得 == 3
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「……이제 됐어, %CALLNAME:MASTER%」
	ELSE
		PRINTFORML 「……너의 조사는 이제 충분하구나」
	ENDIF
	PRINTFORML 「안녕」
	PRINTFORMDW 링고와의 관계에 큰 균열이 생긴 기분이야……
ENDIF
