	;考えうる分岐が多すぎるので地の文の大まかな分岐だけ
	;連続
	IF PREVCOM == SELECTCOM
		PRINTFORMW 
		RETURN 1
		;主人V挿入→助手A挿入
	ELSEIF TCVAR:100 == MASTER
		PRINTFORMW 
		RETURN 1
		;主人A挿入→助手V挿入
	ELSEIF TCVAR:101 == MASTER
		PRINTFORMW 
		RETURN 1
		;助手V挿入→主人A挿入
	ELSEIF TCVAR:100 == ASSI
		PRINTFORMW 
		RETURN 1
		;助手A挿入→主人V挿入
	ELSEIF TCVAR:101 == ASSI
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
