@M_KOJO_MESSAGE_COM_K108_610_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 
	;人間の里
	IF CFLAG:MASTER:現在位置 / 100 == 2
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDL 링고가 자주 이용한다고 하는 대중 식당에서 식사를 했다. 저렴하고 배부르게 먹을 수 있다는 것이 장점인 것 같다.
				PRINTFORML 「링고는 일이 끝나면 세이란이랑 자주 오는 곳이야」
				PRINTFORMW 「자～, 오늘 오늘의 특선 정식은~ 하고 있네...♪」
			CASE 1
				PRINTFORMDL 미요이가 간판 소녀로 일하는 술집 '계훈정'에서 식사를 하기로 했다.
				PRINTFORML 「술은…… 이 『고래의 숨결』로 할까」
				PRINTFORML 「그다음은…… 일단 계란말이 정도? %조사처리(CALLNAME:MASTER,"는")% 뭘 원해?」
				PRINTFORMDW 링고와 같은 것을 미요이에게 주문했다.
			CASE 2
				;清蘭口上でやりたかったけど、辛味苦手なので…
				PRINTFORMDL 링고와 산책하고 있는데, 라멘 가게를 발견했다.
				PRINTFORMDW 너무 끌리는 가게 이름이라 충동적으로 그 가게에 들어갔다.
				PRINTFORML 「"세이란 라멘"인가... 우연이라고 생각하지만...」
				PRINTFORML 「오, 왔네…… 빨갛다! 매워 보이는데~ 잘 먹겠습니다!」
				PRINTFORMDW 링고와 땀을 흘리면서 "튀긴 갈비 단단면"을 만끽했다.
			CASE 3
				PRINTFORMDL 가게에서 먹는 것만이 외식이 아니다. 오늘은 취향을 바꿔 링고와 길거리 음식을 먹기로 했다.
				CALL COLORMESSAGE("「음~ 눈이 돌아버리겠네. 다음엔 뭘 먹을까~♪」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고의 식욕에 놀라면서도, 먹방을 즐겼다.
		ENDSELECT
		;迷いの竹林
	ELSEIF CFLAG:MASTER:現在位置 / 100 == 4
		PRINTFORMDL 미스티아가 하고 있는 노점상을 발견해서, 링고와 야메우나시를 먹기로 했다.
		PRINTFORML 「%CALLNAME:MASTER%, 눈을 감아 봐」
		PRINTFORML 「저기… 향긋한 참숯과, 소스의 좋은 냄새가 나지 않아?」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 눈을 감고 야메우나시의 향을 즐겼다. 빨리 먹고 싶어...!
		;三途の川～冥界
	ELSEIF CFLAG:MASTER:現在位置 / 100 == 6
		PRINTFORMDL 우루미에게 사 온 물고기를 먹으며, 링고와 휴식을 취하기로 했다.
		PRINTFORML 「모처럼 기회니까, 저 꽃을 보면서 먹자」
		CALL COLORMESSAGE("「저승에서 꽃놀이를 하는 것도, 꽤 괜찮다고 생각하지 않아?」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 참지 못했던 걸까, 링고는 이미 물고기를 갉아먹기 시작했다……
		;地底
	ELSEIF CFLAG:MASTER:現在位置 / 100 == 9
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「우웅…… 생각했던 대로 이자카야가 많네에……」
				PRINTFORML 「마시는 건 상관없는데, 지금은 배불리 먹고 싶은 기분이야~……응!?」
				PRINTFORMDW "배고픈 당신에게! 밥 '귀' 모리 캠페인 중!"이라고 쓰인 간판이 놓인 이자카야를 발견했다.
				PRINTFORML 「―좋아! 여기다!!」
				PRINTFORMDW 엄청난 속도로 달려가는 링고를 황급히 뒤쫓았다…
			CASE 1
				PRINTFORMDL 서로 오늘 술 마시고 싶다는 기분이라, 유기의 보증을 받은 주점에 왔다.
				PRINTFORML 「그 술 좋아하는 귀신이 말하는 거니까… 정말 맛있는 술 마실 수 있겠지…♪」
				PRINTFORMDL 각자 골라 주문한 술과 요리가 날아왔다. 정말 맛있어 보인다...!
				PRINTFORMW 「좋아, 그럼… 건배♪」
			CASE 2
				PRINTFORMDL 가게에서 먹는 것만이 외식이 아니다. 오늘은 취향을 바꿔 링고와 길거리 음식을 먹기로 했다.
				CALL COLORMESSAGE("「하지만 그거 말이야. 마치 축제 같은 곳에 온 기분이야.」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고의 손에는 오징어 구이나 옥수수 등 축제의 정석이라고 할 수 있는 음식들이 들려 있다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
