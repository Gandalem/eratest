@M_KOJO_MESSAGE_COM_K108_605_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	SETCOLOR 0xEE9900
	IF CFLAG:318 == 1
		PRINTFORML 「……빨리 가자」
		PRINTFORMDW 들르자고 제안했지만, 링고에게 거절당했다...
	ELSE
		SELECTCASE RAND:4
			CASE 0
				CALL COLORMESSAGE("「밖에 먹는 단고는 특별하네...♪」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고랑 단고를 먹으며 휴식을 취했다.
			CASE 1
				PRINTFORML 「텔레파시? 나도 쓸 수 있어. 한번 해 볼까~?」
				PRINTFORMW 『여보세요♪ 세이란, 잘 지내고 있어~?』
				IF TALENT:107:恋慕 || TALENT:107:思慕
					PRINTFORML 「...아하하... 그, 수련 중이었던 것 같아...」
					PRINTFORMDW 링고는 어쩐지 얼굴을 붉히고 있다.
				ELSE
					PRINTFORML 「아하하하! 엄청 몰래 먹고 있었네! 식사 중이었나 봐?」
					PRINTFORMDW 세이란에게 나쁜 짓이라 한 건가…….
				ENDIF
			CASE 2
				PRINTFORML 「……우물? 왜 이런 곳에…?」
				PRINTFORML 「아니야… 그렇게 노골적으로 수상한 곳에 들어갈 리가 없잖아」
				PRINTFORMDW 수수께끼의 고물을 무시하고 목적지를 향해 서둘렀다.
			CASE 3
				PRINTFORMW 「윽...! 굉장한 바람이야...」
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「……휴. 모자가 날아가지 않아서 다행이야」
					CASE 1
						PRINTFORML 「――앗! 모자가!!」
						PRINTFORMDW …………
						PRINTFORML 「고마워 %CALLNAME:MASTER%…!」
						PRINTFORML 「괜찮아? 다친 데는 없어?」
						PRINTFORMDW 어떻게든 링고의 모자를 회수할 수 있었다.
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
