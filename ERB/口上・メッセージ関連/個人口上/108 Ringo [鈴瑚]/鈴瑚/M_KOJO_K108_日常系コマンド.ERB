@M_KOJO_MESSAGE_COM_K108_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		;睡眠フラグ
	ELSEIF CFLAG:睡眠
		PRINTFORML 「%CALLNAME:MASTER%…」
		PRINTFORML 「…맛있어 보인다…♪」
		PRINTFORMDW 링고는 어떤 꿈을 꾸고 있는 것일까…….
		;怒り
	ELSEIF CFLAG:318 == 1
		CALL COLORMESSAGE("「…………。」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 어색한 분위기 속에서, 링고와 함께 휴식을 취했다...
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 0
				CALL COLORMESSAGE("「…………♪」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고랑 같이 경단 먹으면서 쉬었다.
			CASE 1
				CALL HPH_PRINT,@"「그렇게…… ♪ 그렇게 상냥하게 만져줘…… HPH」","L"
				PRINTFORMDW 링고의 토끼 귀를 쓰다듬었다.
			CASE 2
				PRINTFORML 「응? ……써 볼래?」
				PRINTFORML 「후후훗…♪ 잘 어울려, 잘 어울려♪」
				PRINTFORMDW 링고의 모자를 써 보게 되었다.
			CASE 3
				PRINTFORML 「이렇게 멍하니 있으면... 나도 모르게... 꾸벅꾸벅...」
				PRINTFORML 「……Zzz」
				PRINTFORMDW 링고와 함께 잠시 눈을 붙이기로 했다...
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL COLORMESSAGE("「시간이 있네~... 재미있는 이야기 좀 해줘」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 이건 대답하기 곤란한 타입의 태도야……
			CASE 1
				CALL COLORMESSAGE("「...단고 먹고 싶다고? 그럼, 네 차랑 교환해 줄게」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고에게 차를 내려주기로 했다.
			CASE 2
				PRINTFORML 「좋네…… 이 일 전부를 버리고, 나른하게 쉬는 기분」
				PRINTFORML 「버릇이 될 것만 같아……♪」
				PRINTFORMDW 버릇이 되면 안 되는데……
		ENDSELECT
	ENDIF
ENDIF
