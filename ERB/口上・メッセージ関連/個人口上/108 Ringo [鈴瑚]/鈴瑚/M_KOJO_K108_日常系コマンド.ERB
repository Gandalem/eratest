@M_KOJO_MESSAGE_COM_K108_354_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠 || CFLAG:衰弱
		PRINTFORML 「응응……! 응으~…」
		PRINTFORMDW 지독하게 피곤한 걸까… 링고는 신음하고 있지만, 일어날 기미가 보이지 않는다…
	ELSEIF TALENT:恋人
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「괜찮아 %CALLNAME:MASTER%♪ 이리 와~ HPH」","L"
				PRINTFORMDW 허락을 받았으니, 링고의 이불에 잠시 들렀다.
			CASE 1
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%잘 자~ HPH」","L"
				PRINTFORMDW 링고가 이불 속에서 달려와 안았다.
			CASE 2
				PRINTFORML 「저기 %CALLNAME:MASTER%. "팔베개" 같은 거 해줘」
				CALL HPH_PRINT,@"「……하하앗♪ 조금 부끄럽지만, 좋은 꿈을 꿀 수 있을지도 모르겠어……후훗」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 팔 속에서, 링고는 기쁜 듯 눈을 감았다.
			CASE 3
				PRINTFORML 「…………。」
				PRINTFORML 「%CALLNAME:MASTER%빨리 자야지. 잠든 얼굴 못 보잖아」
				PRINTFORMDW 조금만 더 깨 있어 줄게……
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……괜찮지만, 이상한 거 하지 마아...?」
				PRINTFORMDW 링고에게 함께 자기 허락을 받았기에 이불 속으로 파고들었다.
			CASE 1
				PRINTFORML 「……%CALLNAME:MASTER%? 벌써 잠들어 버렸나?」
				PRINTFORML 「그게… 잠이 안 와서, 잠깐이라도 이야기하고 싶어서…」
				PRINTFORMDW 링고가 잠들 때까지 대화에 응하기로 했다.
			CASE 2
				PRINTFORML 「…………。」
				PRINTFORML (어떡하지…… 두근두근해서 잠이 안 와……!)
				PRINTFORMDW 링고는 이쪽으로 등을 돌리고 있다……
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...뭐야? 사람의 온기라도 그리워졌나?」
				PRINTFORMDW 링고는 깔깔 웃으며 이불 속으로 초대했다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%~……좁으니까, 더 저쪽으로 가줘」
				PRINTFORMDW 링고와 이불 속에서의 공방을 즐겼다.
			CASE 2
				PRINTFORML 「자아… 설마 공짜로 내 이불에서 잘 수 있다고 생각하는 건 아니겠지?」
				PRINTFORML 「이야~ 내일 단고 판매량이 기대된다~♪」
				PRINTFORMDW 내일은 링고 가게에 갈 수밖에 없을 것 같다……
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
