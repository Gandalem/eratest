;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 6
			;大成功（酔い）
			PRINTFORML 「나도 말이야~ 노력하고 있단말이야~! 경단만 먹고 있는 거 아니거든~……」
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 제대로 이해해 줄 거지……?」
			PRINTFORMDW 촉촉하게 눈을 맞추며 자신을 바라보는 링고에게 고개를 끄덕여 보였다.
		CASE 5
			;成功（酔い）
			PRINTFORML 「……정말 말이야~… 모두들 내 기분 같은 건 모르면서 말이지~! 나도 있단 말이야...!」
			PRINTFORML 「……미안, 투덜거렸네…… 술을 좀 너무 마셨나 봐……」
			PRINTFORMDW 조금 숙취가 가신 것인지, 링고는 제정신으로 돌아온 듯했다……
		CASE 4
			;失敗（酔い）
			PRINTFORML 「―그러니까 말이야...! 모두 내 노력을 모르고 "단지 먹기만 한다"느니 "월급 너무 많다"느니, 그런 소리밖에...」
			PRINTFORML 「……%CALLNAME:MASTER%! 사람이 진지하게 이야기하고 있을 때 어디 보고 있는 거야!」
			PRINTFORMDW 취했는지, 링고는 반복해서 같은 이야기를 하고 있다...
		CASE 3
			;大成功
			PRINTFORML 「……후우… 뭔가 여러 가지 얘기하니까 후련해졌어」
			PRINTFORML 「투덜거려줘서 고마워, %CALLNAME:MASTER%. 이건 감사하는 마음이야」
			PRINTFORMDW 링고에게 꼬치구이 하나를 받았다.
		CASE 2
			;成功
			CALL COLORMESSAGE("「…오늘은 무슨 단고를 먹는 거야…… 하아~……」", C_ORANGE, 0, 0)
			SETCOLOR 0xFFFF00
			PRINTFORML MGMG
			SETCOLOR 0xEE9900
			PRINTFORML 「후훗... 이제 됐어. 너랑 이야기하고 있자니, 고민하는 게 바보같이 느껴져 버렸어……」
			PRINTFORMDW 링고는 어이없다는 듯 웃고 있다.
		CASE 1
			;失敗
			CALL COLORMESSAGE("「응? ……걱정하지 않아도 괜찮아.」", C_ORANGE, 0, 0)
			SETCOLOR 0xFFFF00
			PRINTFORML MGMG
			CALL COLORMESSAGE("「이렇게 경단 많이 먹으면 스트레스 풀 수 있으니까.」", C_ORANGE, 0, 0)
			SETCOLOR 0xFFFF00
			PRINTFORML MGMG
			PRINTFORMDW 도대체 스트레스가 얼마나 쌓였길래, 먹는 양이 전혀 줄지 않는 걸까…….
	ENDSELECT
ENDIF
RETURN 1
