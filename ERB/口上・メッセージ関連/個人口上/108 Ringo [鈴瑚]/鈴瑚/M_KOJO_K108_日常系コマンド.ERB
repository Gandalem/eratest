@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_332
RETURN 0

@M_KOJO_MESSAGE_COM_K108_332
CALL M_KOJO_MESSAGE_COM_K108_332_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「헤에…… 이 술을 %조사처리(CALLNAME:MASTER,"가")%?」
		PRINTFORML 「그럼, 실력 한번 보자…♪」
		PRINTFORMDW 링고와 건배했다.
		IF ALCOHOL_TASTE(TFLAG:194) >= 15
			PRINTFORML 「―!…엄청 맛있다!」
			PRINTFORML 「가게에서 파는 것보다 더 맛있을지도……♪」
			PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"의")% 술을 마음에 들어 한 듯하다.
		ELSEIF ALCOHOL_TASTE(TFLAG:194) < 10
			PRINTFORML 「……뭐, 앞으로의 기대라는 걸로…」
			PRINTFORMDW 링고에게는 맞지 않았던 모양이다…
		ELSE
			PRINTFORML 「……이거, 괜찮네」
			PRINTFORMW 「수제도 의외로 만만치 않네요」
		ENDIF
		;酔ってる強
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 6
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……모~ 상관없어! 갈 수 있는 데까지 가자아~♪」
			CASE 1
				PRINTFORML 「...안 마신다고... 괜찮으니까~」
				PRINTFORML 「자, 리필해 줘~! ...!」
				PRINTFORMDW 말하는 대로, 링고의 잔에 술을 따랐다……
			CASE 2
				PRINTFORML 「……? 이제 없어…… 새로운 거 가져와줘」
				PRINTFORMDW 비틀거리면서도, 링고는 스스로 술을 따라주고 있다……
		ENDSELECT
		IF ALCOHOL_TASTE(TFLAG:194) >= 15
			PRINTFORMW 「아~!! 맛있다~♪ 최고야~♪」
		ELSEIF ALCOHOL_TASTE(TFLAG:194) < 10
			PRINTFORML 「――한 모금!」
			PRINTFORMDW 조금 취기가 가신 것 같다……
		ELSE
			PRINTFORML 「…………。」
			PRINTFORMDW 링고는 말없이 술을 마시고 있다……
		ENDIF
		;酔ってる弱
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 3
		SELECTCASE TIME:2
			;朝
			CASE 1,2
				PRINTFORML 「이야~… 아침부터 마시는 술이라니, 죄의 맛이네...!」
				PRINTFORMDW 다시 두 사람의 손이 술병을 향해 뻗어간다……
				;昼
			CASE 3,4
				PRINTFORML 「대낮부터 마시는 술이라니, 어째 이렇게 맛있는 걸까……」
				PRINTFORML 「%CALLNAME:MASTER%…… 저, 한 잔만 더 주세요...!」
				PRINTFORMDW 링고가 내민 그릇에 술을 따라주었다.
				;夜
			CASE 5,6,7
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「%CALLNAME:MASTER%, 페이스 빠르지 않아?」
						PRINTFORML 「천천히 가자… 밤은 길 테니까…♪」
						PRINTFORMDW 링고의 잔에 새로운 술을 따라주었다.
					CASE 1
						PRINTFORML 「―그래서 말이야, 그때 세이란이…… 어라? 벌써 없어졌네」
						PRINTFORML 「%CALLNAME:MASTER%, 더 받을래?」
						PRINTFORMDW 비어버린 링고의 잔에 새로운 술을 따라주었다.
					CASE 2
						PRINTFORML 「나는 아직 마실 수 있는데, 너는?」
						PRINTFORMDW "물론이다"라고 대답하고 새로운 술을 꺼냈다.
				ENDSELECT
		ENDSELECT
		IF ALCOHOL_TASTE(TFLAG:194) >= 15
			PRINTFORML 「……음~♪ 맛있다♪」
			PRINTFORMDW 링고는 기쁜 듯 미소 짓는다.
		ELSEIF ALCOHOL_TASTE(TFLAG:194) < 10
			PRINTFORML 「……별로였나」
			PRINTFORMDW 링고의 입맛에는 맞지 않았던 모양이다…
		ELSE
			PRINTFORML 「보통」
			PRINTFORMDW 링고는 무표정해졌다.
		ENDIF
		;素面
	ELSE
		SELECTCASE TIME:2
			;朝
			CASE 1,2
				PRINTFORML 「아침부터 마시다니, 꽤나 나쁜 버릇이네 %CALLNAME:MASTER%」
				PRINTFORML 「요리히메님께 들키면 우리 혼날 거야…… 건배♪」
				PRINTFORMDW 이루 말할 수 없는 금단의 기분이 술의 맛을 더욱 끌어올린다…
				;昼
			CASE 3,4
				PRINTFORML 「에~…좀 성급한 거 아니야? 아직 점심인데?」
				PRINTFORML 「어쩔 수 없겠네... 한 잔만 같이 하자」
				PRINTFORMDW 링고에게 잔을 건네며 술을 따라주었다.
				;夜
			CASE 5,6,7
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「오늘은 내가 따라줄게. 자, 잔 내봐」
						PRINTFORMDW 말씀에 응해, 링고에게 술을 따라주었다.
					CASE 1
						PRINTFORML 「...오늘 좀 기분 나쁜 일이 있어서 말이야...」
						PRINTFORML 「너한테 잔뜩 푸념하게 될지도 몰라... 농담이야♪」
						PRINTFORMDW "얼마든지 불평해 보라고" 말하며, 링고의 잔에 술을 따랐다.
					CASE 2
						PRINTFORML 「%CALLNAME:MASTER%。이번 일은 어떠한가?」
						PRINTFORMDW "만족스러운 성과다"라고 답하고, 링고의 잔에 술을 따랐다.
				ENDSELECT
				PRINTFORMW 「%TEXTR("今日も一日お疲れ様/よし、それじゃ/今夜は楽しくなりそう/さーて、お味はどうかな")%…건배♪」
		ENDSELECT
		IF ALCOHOL_TASTE(TFLAG:194) >= 15
			PRINTFORML 「……음~♪ 맛있다♪」
			PRINTFORMDW 링고는 기쁜 듯 미소 짓는다.
		ELSEIF ALCOHOL_TASTE(TFLAG:194) < 10
			PRINTFORML 「……별로였나」
			PRINTFORMDW 링고의 입맛에는 맞지 않았던 모양이다…
		ELSE
			PRINTFORML 「보통」
			PRINTFORMDW 링고는 무표정해졌다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
