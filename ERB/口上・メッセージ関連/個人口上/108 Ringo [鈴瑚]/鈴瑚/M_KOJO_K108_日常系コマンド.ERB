@M_KOJO_MESSAGE_SCOM_K108_63
CALL M_KOJO_MESSAGE_SCOM_K108_63_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K108_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 시간이 멈춘 채인 링고에게 키스를 했다.
		PRINTFORMDW 단자를 먹었는지 입안이 은은하게 달콤하다...
	ENDIF
	IF TALENT:恋人
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「응아... HPH 음, 레이무...읏, 쪽... HPH」","L"
				PRINTFORMDW 링고와 혀를 얽으며 깊은 키스를 했다……
			CASE 1
				CALL HPH_PRINT,@"「음므... 음츄... HPH 아무, 음츄... HPH, %CALLNAME:MASTER%... HPH 더... HPH」","L"
				CALL HPH_PRINT,@"「츄릅... HPH 할래... HPH, 음음... 음무우... HPH 쪽... HPH」","L"
				PRINTFORMDW 링고와의 달콤한 키스를 만끽했다……
			CASE 2
				CALL HPH_PRINT,@"「응응... 핥짝 후우... 츄릅 쭈르륵... 쫩... 푹 빠져버렸어」","L"
				PRINTFORML 「하아... 하아... 하아... 하아... 잠깐, 숨이 좀 가빴네...♪」
				PRINTFORMDW 숨 쉬는 것도 잊을 정도로, 링고와 키스에 몰두했다...
			CASE 3
				CALL HPH_PRINT,@"「응... 흐읍 음...흐읍 흐으...흐읍 질퍽흐읍 질척질척흐읍 쭉우웅흐읍」","L"
				PRINTFORMDW 링고와 서로 침을 교환했다. 들려오는 음탕한 물소리가 두 사람의 감정을 고조시킨다...
			CASE 4
				CALL HPH_PRINT,@"「음... 후후, 츄... 후후 응으윽... 음후... 후후 쮸읍 후후 냠... 후후」","L"
				CALL HPH_PRINT,@"「응응……HPH쥬우……HPH, 푸핫…후훗♪…%CALLNAME:MASTER%……좋아해……HPH」","L"
				PRINTFORMDW 키스를 하면서, 링고와 사랑을 속삭였다……
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「츄우……후으읍… 응… 하아… 후으읍」","L"
				PRINTFORMDW 링고는 뺨을 홍조로 물들이며, 촉촉해진 눈동자로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다...
			CASE 1
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐으응... 츄... 흐으응」","L"
				CALL HPH_PRINT,@"「―응!? ……응…푹츄……푹…츄, 푹…푹」","L"
				PRINTFORMDW 과감하게 혀를 넣자, 조심스럽게나 받아들여 주었다.
			CASE 2
				CALL HPH_PRINT,@"「음무… 응츄… HPH 아무… 음응읏… HPH」","L"
				PRINTFORMDW 링고는 필사적으로 깊은 키스를 해주고 있다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「―응, 읍!? 응응...! ...잠깐! 뭐 해―응~」
				PRINTFORMDW 조금 강제로 링고의 입술을 빼앗았다.
			CASE 1
				PRINTFORML 「응응...! 그만해...! 응으윽... 응응...!」
				PRINTFORML 「―...!! 하아...! 하아...! ...다시는 이런 일 하지 마...!」
				PRINTFORMDW 링고에게 밀쳐졌다...
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
