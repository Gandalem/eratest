@M_KOJO_MESSAGE_COM_K108_431_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:5
		CASE 0
			CALL HPH_PRINT,@"「후우……♪ 기분 좋아……흐으응」","L"
			PRINTFORMDW 링고와 어깨까지 물에 잠긴 채 휴식을 취했다.
		CASE 1
			PRINTFORML 「……음~♪ 변변♪ 후~은♪」
			PRINTFORML 「―앗...! ...좋잖아! 가끔은……!」
			PRINTFORMDW 링고는 흥얼거리는 소리를 듣고 부끄러워한다.
		CASE 2
			PRINTFORML (%CALLNAME:MASTER%……♪틈이 생겼다!)
			PRINTFORMDW 링고의 손에서 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 향해 세차게 물총이 발사되었다!
			;あなたの戦闘能力で分岐
			IF ABL:MASTER:戦闘能力 >= 5
				PRINTFORMDL 하지만 %조사처리(CALLNAME:MASTER,"는")% 눈 깜짝할 새에 물총을 발사하여 링고의 물총을 상쇄했다!
				PRINTFORML 「―으아앗!?」
				PRINTFORMDW 링고는 눈을 크게 뜨고 놀라고 있다.
			ELSEIF ABL:MASTER:戦闘能力 <= 1
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 얼굴에 물총이 정통으로 명중하여 코로 물이 들어가 버렸다...
				PRINTFORML 「아하하하! 미안미안! 그렇게 예쁘게 맞을 줄은 몰랐어…♪」
				PRINTFORMDW 링고는 배를 잡고 크게 웃고 있다...
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아슬아슬하게 물총을 피했다.
				PRINTFORML 「후후…♪ 잘 피했네, %CALLNAME:MASTER%」
				PRINTFORMDW 링고는 어딘가 즐거워 보인다.
			ENDIF
		CASE 3
			CALL HPH_PRINT,@"「목욕 후에 먹는 단고……! 이게 또 최고인걸…… HPH」","L"
			PRINTFORMDW 링고는 기쁜 듯 얼굴을 환하게 만들고 있다.
		CASE 4
			CALL HPH_PRINT,@"「음~읏...! 후우~... 목욕은 역시 최고다네... HPH」","L"
			PRINTFORMDL 링고는 기지개를 켜며 목욕을 즐기고 있다.
			PRINTFORMDW ……수면에 떠 있는 동그란 과일을 반사적으로 보고 말아, 황급히 시선을 돌렸다.
			IF TALENT:恋人
				PRINTFORML 「... %CALLNAME:MASTER%~♪ 지금 어디 보고 있었을까~?」
				PRINTFORMDW 링고는 히죽 웃고 있다. 들킨 모양이다...
			ELSE
				PRINTFORML (%CALLNAME:MASTER%… 지금, 분명 내 가슴 보고 있었지……)
				PRINTFORMDW 의식하면 할수록, 어색해져 오는 기분이야……
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
