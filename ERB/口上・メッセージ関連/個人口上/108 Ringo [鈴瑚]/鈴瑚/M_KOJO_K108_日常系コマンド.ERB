@M_KOJO_SUCCESS_COM_K108_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_301
RETURN 0

@M_KOJO_MESSAGE_COM_K108_301
CALL M_KOJO_MESSAGE_COM_K108_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「……응? 차를 주는 거야?... 고마워♪ 그럼 사양 안 할게…」
		PRINTFORML (일단, 독 같은 건 들어있지 않은 것 같네……)
		PRINTFORMDW 약간 경계하면서도 링고는 차를 마셔 주었다.
	ELSEIF CFLAG:318 == 1
		PRINTFORML 「……고마워」
		PRINTFORMDW 링고는 짧게 감사를 표한 후, 차를 단숨에 들이켰다…
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「오, 차밭이다! 행운이야! 좋은 일 생길 것 같아 ♪」
				PRINTFORMW 「……아아, 맛있다……♪」
			CASE 1
				CALL COLORMESSAGE("「역시, 너는 알고 있네...! 역시 단고에는 녹차가 최고지~♪」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고는 차와 단자에 감탄하며 맛보고 있다.
			CASE 2
				CALL COLORMESSAGE("「아주 맛있는 차네...! 경단이랑도 잘 어울리고...」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				SETCOLOR 0xEE9900
				PRINTFORML 「…%CALLNAME:MASTER%. 이 차, 링고야 내 가게에서 대접해 주지 않을래?」
				PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"가")% 마시는 차를 마음에 들어 한 모양이다.
			CASE 3
				PRINTFORML 「맛있는 차다... 피로도 싹 날아버릴 것 같아...♪」
				PRINTFORMDW 링고의 얼굴에서 피로한 기색이 사라진 듯하다.
			CASE 4
				IF TALENT:恋慕 || TALENT:思慕
					CALL HPH_PRINT,@"「언제나 맛있는 차 고마워~♪ %CALLNAME:MASTER%읏」","L"
					PRINTFORMDW 링고의 웃는 얼굴을 보고, %CALLNAME:MASTER%도 기뻐졌다.
				ELSE
					PRINTFORML 「맛있었어. 잘 먹었어」
					PRINTFORMDW 링고는 차를 전부 마셔 주었다.
				ENDIF
		ENDSELECT
	ELSEIF TFLAG:193 == 0
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「차주는... 없다. 오늘도 평범한 하루가 될 것 같다。」
				PRINTFORMW 「즈즈... 맛있다.」
			CASE 1
				PRINTFORML 「―응그옷!?……크윽…!」
				PRINTFORMDL 링고는 경단(団子)을 목에 걸린 듯했다... %조사처리(CALLNAME:MASTER,"의")% 손에서 차를 빼앗아 단숨에 들이켰다.
				PRINTFORMW 「%TEXTR("ふぅ～…死ぬかと思った…/ごくっ…ふぅ、今のは危なかったね…/いや～…ありがと、助かったよ/")%」
			CASE 2
				PRINTFORML 「응, 맛있다. 꽤 정성스럽네」
				PRINTFORML 「...라고들 하는 거야? 지상의 "차도"라는 게 말이야」
				PRINTFORMDW 링고는 지상의 식문화에 대해 잘 아는 듯하다.
			CASE 3
				PRINTFORML 「……!… %CALLNAME:MASTER%, 이 차는…」
				PRINTFORML 「― 내 가게에서 한번 마셔보지 않을래?」
