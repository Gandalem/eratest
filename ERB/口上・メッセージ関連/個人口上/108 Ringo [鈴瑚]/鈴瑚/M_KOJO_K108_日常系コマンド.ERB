; Modular ERB: 個人口上/108 Ringo [鈴瑚]/鈴瑚/M_KOJO_K108_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K108_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_300
RETURN 0

@M_KOJO_MESSAGE_COM_K108_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K108_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初回会話
	IF FIRSTTIME(SELECTCOM)
		CALL COLORMESSAGE("「음~♪ 오늘 경단도 맛있다! 행복하네~...」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		CALL COLORMESSAGE("「―뭐야? 계속 쳐다보네... 설마 너도 먹고 싶어?」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		SETCOLOR 0xEE9900
		PRINTFORMDW 링고는 항상...이라고 말하기보다는, 늘 경단을 먹고 있다. 몸이 망가질까 걱정이다...
		PRINTFORML 「괜찮아 괜찮아♪ 이 정도 가지고 부서지다니, 나는 약하지 않아.」
		PRINTFORMW 「"게다가... 이게 나의 '능력'이니까."」
		PRINTFORMW 「"%조사처리(CALLNAME:MASTER,"에게")% 알려줄게. 나의 능력은 '경단을 먹은 만큼 강해지는 정도의 능력'이야."」
		PRINTFORMDW 농담 같은 능력 내용에, %조사처리(CALLNAME:MASTER,"는")% 나도 모르게 웃음을 터뜨렸다.
		PRINTFORML 「정말이지... 너는 내 능력의 무서움에 눈치채지 못한 모양이네.」
		PRINTFORMW 「"'경단을 먹은 만큼'... 즉, 이 능력에는 상한선이 없는 거지..."」
		CALL COLORMESSAGE("「언젠가는 나는 이 환상향에서 최강의 존재가 될 것이다」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 링고는 보고만 있어도 배가 터질 듯한 양의 단자를 새로 꺼내 먹기 시작했다……
		;怒り
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		CALL COLORMESSAGE("「…………。」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 자신을 시야에 들이고 싶지 않은 걸까, 링고는 모레 방향을 바라보며 단자를 먹고 있다……
		;喋りすぎ
	ELSEIF TCVAR:302
		SELECTCASE RAND:3
			CASE 0
				IF TALENT:恋慕 || TALENT:思慕
					CALL COLORMESSAGE("「...아, 미안. 무슨 얘기였지?」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 방금 한 이야기는 흥미가 없었던 모양이야……
				ELSE
					CALL COLORMESSAGE("「조용히 해. 지금은 경단을 음미하는 데 집중하고 있어.」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고에게 말을 끊겼다……
				ENDIF
			CASE 1
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「……배도 고픈데 어딘가 나가볼까. 기분 전환도 겸해서 말이야」
					PRINTFORMDW 링고는, 수다 떠는 것에 질린 모양이다……
				ELSE
					CALL COLORMESSAGE("「그렇구나, 그렇구나. 그거 정말 힘들었겠네.」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고는 적당히 대답을 하면서 경단을 먹고 있다……
				ENDIF
			CASE 2
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「%CALLNAME:MASTER%너무 많이 말했어. 이것이라도 먹고 진정해라」
					PRINTFORMDW 입에 단자를 욱여넣었다……
				ELSE
					CALL COLORMESSAGE("「왜 경단은 이렇게 맛있는 걸까?」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"와")%의 이야기에 흥미를 잃은 것 같아……
				ENDIF
		ENDSELECT
		;酔っ払い時会話
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「모~...! 너랑 단둘이 마시면, 늘 너무 많이 마셔버리는 거야!」
					PRINTFORMW 「전에는 이렇지 않았는데…… 정말, 너라는 사람은…!」
					CALL HPH_PRINT,@"「……정말 좋아, HPH」","W"
				CASE 1
					CALL COLORMESSAGE("「음... 안주가 없어 버렸네... 아! 맞다.」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					SETCOLOR 0xEE9900
					PRINTFORML 「대신에 %CALLNAME:MASTER%응큼하게 해줄게~♪… 꾸욱~……」
					PRINTFORML 「아하하하! 아주 잘 늘어나네~♪」
					PRINTFORMDW 잘 모르겠지만, %조사처리(CALLNAME:MASTER,"의")% 뺨을 잡아당기는 링고는 무척 즐거워 보인다……
				CASE 2
					PRINTFORML 「"위스키봉봉"처럼, 술은 간식 같은 단고가 좋다고 생각한다니까.」
					PRINTFORMDW 링고는 눈이 풀려있다…….
				CASE 3
					PRINTFORML 「……%조사처리(CALLNAME:MASTER,"는")% 자세히 보면 맛있어 보인다……」
					PRINTFORML 「조금 맛봐도 괜찮을까?」
					PRINTFORMDW 링고는 상당히 취한 모양이다.
				CASE 4
					PRINTFORML 「이상한 때도 그랬는데 말이야! 모두 나한테, 내가 얼마나 노력하고 있는지 모른단 말이야!」
					CALL HPH_PRINT,@"「……%조사처리(CALLNAME:MASTER,"는")% 이해해 줄 거야? 그러니까 좋아 HPH」","L"
					PRINTFORMDW 링고는 상당히 스트레스가 쌓여 있는 것 같아…….
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「노, 너무 많이 마셔버렸어아~! 잠깐 쉬고 싶어……」
					PRINTFORMDW 링고는 그 자리에 쓰러졌다…
				CASE 1
					PRINTFORML 「...응? 술 없어졌네...」
					PRINTFORML 「소독용 알코올은 있는데, 마실래?」
					PRINTFORMDW 그건 안 될 거야……
				CASE 2
					PRINTFORML 「보고 싶어…. 빙글빙글 도는 기분이야……」
					PRINTFORMDW 링고는 상당히 취해버린 듯하다……
				CASE 3
					PRINTFORML 「……Zzz」
					PRINTFORMW 「―하앗! …거기서 그만둘 뻔했어…」
				CASE 4
					PRINTFORML 「아니야... 리필은 됐어. 그보다 물을...」
					PRINTFORMDW 링고에게 물을 마시게 하자, 조금 기분이 나아진 듯했다.
			ENDSELECT
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「후후……♪ 있잖아…… 오늘은 너랑 아침까지 마시고 싶어…… HPH」","L"
					PRINTFORMDW 링고가 촉촉하게 빛나는 눈으로 바라본다……
				CASE 1
					PRINTFORML 「응읏――……후우... 맛있어...♪」
					PRINTFORMDW 술에 젖은 링고의 입술이 묘하게 윤기 있게 보인다...
				CASE 2
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 술은 맛있어서 금방 없어버려요…♪」
					PRINTFORMDW "술 더 마시고 싶으면 있어"라고 말하자, 링고는 기쁜 듯 고개를 끄덕였다.
				CASE 3
					CALL HPH_PRINT,@"「응? 괜찮아…… HPH 아직 취 안 했어… HPH」","L"
					PRINTFORMDW 링고는 얼굴을 붉히고 있다……
				CASE 4
					PRINTFORMDL 문득 링고 쪽을 바라보니 눈이 마주쳤다.
					PRINTFORML 「...? ...후후♪ 뭐야 %CALLNAME:MASTER%?」
					PRINTFORMDW 뺨을 상기시키며, 링고는 살짝 미소 지었다...
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「기분 좋게…… 취기가 돌기 시작했네애…♪」
					PRINTFORMDW 링고는 흔들리고 있다.
				CASE 1
					PRINTFORML 「이 술 맛있다. %CALLNAME:MASTER%, 더 마실래?」
					PRINTFORMDW 링고는 %조사처리(CALLNAME:MASTER,"가")% 가져온 술을 마음에 들어 한 듯하다.
				CASE 2
					PRINTFORML 「술은 마셔도 안 마시게 해줘. 괜찮아, 나는 아직 버틸 수 있어」
					PRINTFORMDW 링고는 자신의 한계를 어느 정도 이해하고 있는 듯하다.
				CASE 3
					CALL COLORMESSAGE("「다른 것들도 술이랑 잘 어울린다.」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고는 경단(다니고)을 집어 술을 마시고 있다...
				CASE 4
					PRINTFORML 「음……. %조사처리(CALLNAME:MASTER,"는")%, 잔이 줄지 않았잖아」
					PRINTFORML 「―아! 혹시, 나를 취하게 해서 음흉한 짓을 하려는 거야?」
					PRINTFORMDW 오해를 풀기 위해서도, %조사처리(CALLNAME:MASTER,"는")% 잔 속의 술을 단숨에 마셨다…….
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋人
		IF FLAG:デート相手 == 108
			SELECTCASE RAND:2
				CASE 0
					CALL RINGO_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL RINGO_KOIBITO
						CASE 1
							CALL RINGO_OTENKI
						CASE 2
							CALL RINGO_SEASON
						CASE 3
							CALL RINGO_GENSAKU
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					CALL RINGO_GENSAKU
				CASE 1
					CALL RINGO_KOIBITO
				CASE 2
					CALL RINGO_SEASON
				CASE 3
					CALL RINGO_OTENKI
				CASE 4
					PRINTFORML 「%CALLNAME:MASTER%…… 오늘은, 데이트 안 해줄 거야?」
					PRINTFORMDW 링고를 데리고 어디론가 나가 볼까…….
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		IF FLAG:デート相手 == 108
			SELECTCASE RAND:2
				CASE 0
					CALL RINGO_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL RINGO_RENBO
						CASE 1
							CALL RINGO_OTENKI
						CASE 2
							CALL RINGO_SEASON
						CASE 3
							CALL RINGO_GENSAKU
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE CFLAG:現在位置
				;人間の里
				CASE 201,202,203,204,205,206,230,240,210,220,230,240,250,270
					CALL RINGO_ODANGO
				CASEELSE
					SELECTCASE RAND:5
						CASE 0
							CALL RINGO_GENSAKU
						CASE 1
							CALL RINGO_RENBO
						CASE 2
							CALL RINGO_SEASON
						CASE 3
							CALL RINGO_OTENKI
						CASE 4
							PRINTFORML 「%CALLNAME:MASTER%…… 오늘은, 데이트 안 해줄 거야?」
							PRINTFORMDW 링고를 데리고 어디론가 나가 볼까…….
					ENDSELECT
			ENDSELECT
		ENDIF
	ELSEIF TALENT:思慕
		IF FLAG:デート相手 == 108
			SELECTCASE RAND:2
				CASE 0
					CALL RINGO_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL RINGO_SHIBO
						CASE 1
							CALL RINGO_OTENKI
						CASE 2
							CALL RINGO_SEASON
						CASE 3
							CALL RINGO_GENSAKU
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE CFLAG:現在位置
				;人間の里
				CASE 201,202,203,204,205,206,230,240,210,220,230,240,250,270
					CALL RINGO_ODANGO
				CASEELSE
					SELECTCASE RAND:5
						CASE 0
							CALL RINGO_GENSAKU
						CASE 1
							CALL RINGO_SHIBO
						CASE 2
							CALL RINGO_SEASON
						CASE 3
							CALL RINGO_OTENKI
						CASE 4
							PRINTFORML 「있잖아... 심심하니까, 어디 놀러 갈까」
							PRINTFORMDW 링고를 데리고 어디 외출해 볼까……
					ENDSELECT
			ENDSELECT
		ENDIF
	ELSE
		IF FLAG:デート相手 == 108
			SELECTCASE RAND:2
				CASE 0
					CALL RINGO_NORMAL
				CASE 1
					CALL RINGO_OTENKI
			ENDSELECT
		ELSE
			SELECTCASE CFLAG:現在位置
				;人間の里
				CASE 201,202,203,204,205,206,230,240,210,220,230,240,250,270
					CALL RINGO_ODANGO
				CASEELSE
					SELECTCASE RAND:2
						CASE 0
							CALL RINGO_NORMAL
						CASE 1
							CALL RINGO_OTENKI
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
