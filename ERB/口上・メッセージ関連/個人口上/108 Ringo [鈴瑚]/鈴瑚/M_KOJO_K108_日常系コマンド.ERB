@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_402
RETURN 0

@M_KOJO_MESSAGE_COM_K108_402
;就寝にTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K108_402_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR 0xEE9900
	IF CFLAG:睡眠
		PRINTFORML 「%CALLNAME:MASTER%~…… 먹어버릴 거야~…… 꾸벅꾸벅……」
		PRINTFORMDW ……자고 있는 사이에 먹혀 버리진 않을까?
	ELSEIF CFLAG:MASTER:初期位置 == CFLAG:108:初期位置 && CFLAG:MASTER:現在位置 == CFLAG:108:初期位置
		;川の字で寝る
		IF TFLAG:193 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CHILDNAME:108:(TALENT:108:育児中)%는 그렇게 말썽 부렸는데 벌써 잠들어 버렸네」
					PRINTFORMDL 링고의 옆에서 %CHILDNAME:108:(TALENT:108:育児中)%는 행복해 보이는 얼굴로 잠들어 있다.
					CALL HPH_PRINT,@"「후후♪ 귀여운 HPH…… 자, 우리도 잘까 %CALLNAME:MASTER%」","W"
				CASE 1
					PRINTFORML 「%CHILDNAME:108:(TALENT:108:育児中)%～…… 이리 와~……♪」
					PRINTFORMDL 꿈속에서 놀고 있는 걸까… 링고와 %CHILDNAME:108:(TALENT:108:育児中)%가 행복해 보이는 얼굴로 잠들어 있다.
					PRINTFORMDW 자신도 같은 꿈을 꾸고 싶다…… 그런 생각을 안은 채 눈을 감았다.
				CASE 2
					PRINTFORML 「……후후♪ 둘 다 잘 자고 있네……♪」
					CALL HPH_PRINT,@"「잘 자…… HPH…… %CHILDNAME:108:(TALENT:108:育児中)% , %CALLNAME:MASTER% HPH」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					IF TALENT:恋人
						PRINTFORML 「…%CALLNAME:MASTER%…HPH…스윽…스윽…」
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 팔베개에서 행복해 보이는 얼굴로 잠든 링고를 바라보며, 나도 잠이 들었다.
					ELSEIF TALENT:恋慕
						PRINTFORML 「같이 자는 건… 조금 두근거릴지도 모르겠다…」
						PRINTFORML 「―뭐 그런 거야♪ 잘 자, %CALLNAME:MASTER%」
						PRINTFORMDW 세이란은 이불을 뒤집어쓰고 잠이 들었다.
					ELSE
						PRINTFORML 「……만약 나한테 장난치면…… 알고 있지, %CALLNAME:MASTER%?」
						PRINTFORMDW 조용히 잠들기로 했다……
					ENDIF
				CASE 1
					PRINTFORML 「―그래서 말이야…… 어라? %CALLNAME:MASTER%잠들어 버렸네…」
					PRINTFORMW 「후후……♪ %CALLNAME:MASTER%잘 자~……」
				CASE 2
					PRINTFORML 「…………。」
					PRINTFORMDW 링고는 잠들어 버린 것 같다. 조금 장난쳐 볼까…….
					PRINTFORML 「……%CALLNAME:MASTER%～? 이 손은 뭘까~?」
					PRINTFORMDW 역시, 조용히 자게 해 주자…….
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%졸려 보여? 무리하지 말고 자는 게 좋을 거야~」
				PRINTFORML 「또 내일 만나면 되니까…♪」
				PRINTFORMDW 링고의 말에 응해, 오늘은 잠자리에 들기로 했다.
			CASE 1
				PRINTFORML 「……%CALLNAME:MASTER%? 어~이」
				PRINTFORML 「앉은 채로 자고 있어… 어쩔 수 없네」
				PRINTFORMW 「음... %조사처리(CALLNAME:MASTER,"의")% 이불은, 분명 여기였는데……」
			CASE 2
				PRINTFORML 「아…… %CALLNAME:MASTER%, 잘 거야? 그럼, 안녕」
				PRINTFORMDL 조금 쓸쓸해 보이는 링고는 돌아갔다…
				PRINTFORMDL ―라고 생각했을 때, 현관 앞에서 멈춰 서서 뒤돌아보았다.
				CALL HPH_PRINT,@"「……내일도 만나자? 토끼는 외로워서 죽어버릴 테니까……히피」","W"
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「양치하고 자야지? 잘 자~」
			CASE 1
				PRINTFORMW 「잘 자 %CALLNAME:MASTER%. 또 내일 봐」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
