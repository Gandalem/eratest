@M_KOJO_MESSAGE_COM_K108_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			IF TFLAG:193 == -1
				PRINTFORMW 「음~? 별로 아무것도 없는데?」
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「새로운 단자를 생각해 봤는데…… 아무것도 떠오르질 않네……」
						PRINTFORMDW 링고는 한숨을 내쉬었다.
					CASE 1
						PRINTFORML 「지난주 저녁 식사, 뭘 먹었는지 기억이 안 나네……」
						PRINTFORMDW 기억하고 있는 편이 오히려 희귀할걸……
					CASE 2
						IF TALENT:恋人
							CALL HPH_PRINT,@" 「%조사처리(CALLNAME:MASTER,"의")% 걸 당연하잖아 HPH」","W"
						ELSEIF TALENT:恋慕
							PRINTFORML 「%CALLNAME:MASTER%일은……」
							PRINTFORMW 「―뭐 그런 거야♪」
						ELSE
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 어느 부위가 가장 맛있는지 생각하고 있었던 것이다」
							PRINTFORMDW 잘못 들었을까?
						ENDIF
					CASE 3
						CALL COLORMESSAGE("「오늘은 뭘 먹을까~ 아, 이 단고는 빼자.」", C_ORANGE, 0, 0)
						SETCOLOR 0xFFFF00
						PRINTFORMW MGMG
					CASE 4
						PRINTFORML 「아무 생각도 안 했어. 멍 때리고 있었을 뿐이야」
						PRINTFORMDW 정말로 아무 생각도 하지 않고 있던 것 같았다……
				ENDSELECT
			ENDIF
		CASE 1
			;▼遊ぶ［一緒に遊ぶ］
			;※[幼稚]持ちのみ
			;TFLAG:193,1=大いに盛り上がる,-1=あまり盛り上がらない
			;PRINTFORMW
		CASE 2
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			IF TFLAG:193 == -1
				PRINTFORML 「……뭔가 맛없어 보이는 표정 하고 있네」
				PRINTFORMW 「"배 안 고파?" 그건 미안했네」
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「어때? 맛있지?」
					CASE 1
						PRINTFORMW 「잘 먹는구나 %CALLNAME:MASTER%」
				ENDSELECT
			ENDIF
		CASE 3
			;▼つまみ食い［一緒につまみ食い］
			;※[妖精]持ちとルーミア、こいし、幽々子、紫苑のみ
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			;PRINTFORMW
		CASE 4
			;▼掃除［掃除を手伝う］
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「도와 줄 거야? 그럼 저쪽을 맡길게」
				CASE 1
					PRINTFORML (후다닥 끝내고 경단 먹어야 하는데……!)
					PRINTFORMDW 링고는 분주하게 청소를 하고 있다……
				CASE 2
					PRINTFORML 「도와줘서 고마워, %CALLNAME:MASTER%」
					PRINTFORMW 「역시 이런 일은 여러 명이 하는 게 효율이 좋거든」
			ENDSELECT
		CASE 5
			;▼運動［一緒に運動する］
			;※[音楽知識]持ちは除く（演奏になる）
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「%CALLNAME:MASTER%. 토끼뛰기는 무릎에 안 좋아, 그만두는 게 좋을 거야」
				CASE 1
					PRINTFORML 「이렇게……! 운동하면...!」
					PRINTFORML 「더 맛있게……! 단고를 먹을 수 있다는 거야...!」
					PRINTFORMDW 링고와 몸을 움직이며 허기를 달랬다.
				CASE 2
					PRINTFORML 「하아… 하아… 그, 휴식……!」
					PRINTFORML 「―앗!? 단고 돌려줘~!」
					PRINTFORMDW 마음을 먹었다. 운동이 끝날 때까지 단고를 맡기로 했다.
			ENDSELECT
		CASE 6
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			IF TFLAG:193 == -1
				PRINTFORML 「%TEXTR("んー…/うん…/そうね…")%」
				PRINTFORMDW 독서에 집중하고 있는 건지, 링고는 생으로 응답하고 있다…….
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「이거 재밌었어. %CALLNAME:MASTER%도 한번 읽어볼래?」
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%, 이거 보고 싶어?」
						PRINTFORMW 「이글라비에서 유행하는 건데... 저는 별로였어요」
				ENDSELECT
			ENDIF
		CASE 7
			;▼料理［料理を手伝う］→［料理を分けてもらう］
			;TFLAG:193,2=料理を手伝う,0=作った料理を食べる,-1==MASTERはお腹が空いてなかった（食べる時）
			IF TFLAG:193 == 2
				;酔っ払い時
				IF ALCOHOL_FACE(108) == "酔いどれ" || ALCOHOL_FACE(108) == "ぐでぐで"
					PRINTFORML 「맛있는 안주를 대접해 줄게 %CALLNAME:MASTER%」
					PRINTFORMDW 만취한 채 요리를 시작한 링고를 지켜보기로 했다……
				ELSE
					PRINTFORML 「단고를 만들어보고 싶다고? 그럼 같이 해보자」
					PRINTFORMDW 링고와 단고를 만드는 것으로 결정했다.
					PRINTFORMDW …………。
					IF ABL:MASTER:料理技能 >= 5
						PRINTFORMDL 링고랑 같이 경단(団子)을 만들었어. 나 스스로 보기에도 괜찮은데...!
						PRINTFORMW 「좋아, %CALLNAME:MASTER%. 내일부터 링고야에서 일해 줄래?」
						PRINTFORMW 「……하하하! 농담이야♪ 진심인 줄 알았어?」
					ELSEIF ABL:MASTER:料理技能 >= 2
						PRINTFORMDL 경단이 완성됐어. 링고만큼은 아니지만, 잘 만들어졌어.
						PRINTFORML 「%CALLNAME:MASTER%, 서툴러요」
						PRINTFORMW 「다음엔 링고 가게의 경단 만드는 거 도와달라고 해볼까…… 뭐 그런 거지♪」
					ELSEIF ABL:MASTER:料理技能 >= 1
						PRINTFORMDL 경단이 완성됐어……. 하지만 링고랑 비교하면 맛없어 보이네……
						PRINTFORMW 「그렇게 생각해? 나는 맛있을 것 같은데?」
					ELSEIF ABL:MASTER:料理技能 == 0
						PRINTFORMDL 아무리 좋다고 해도 먹고 싶다 말할 수 없는 외모네……
						PRINTFORMW 「아하하하! 괜찮아 %CALLNAME:MASTER%♪ 누구나 처음엔 초보니까」
					ENDIF
				ENDIF
			ELSEIF TFLAG:193 == 0
				;酔っ払い時
				IF ALCOHOL_FACE(108) == "酔いどれ" || ALCOHOL_FACE(108) == "ぐでぐで"
					CALL HPH_PRINT,@" 「괜찮아 HPH땅이랑 같이 먹을게♪」","L"
					PRINTFORMDW 링고가 만들어준 안주를 나눠 먹었어. 정말 맛있었어.
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「%CALLNAME:MASTER%, 그렇게 배고팠어?」
						CASE 1
							PRINTFORMW 「어쩔 수 없네…… 좋아~♪」
						CASE 2
							PRINTFORMW 「좋아. 그럼 같이 먹자」
					ENDSELECT
				ENDIF
			ELSEIF TFLAG:193 == -1;腹いっぱい
				;酔っ払い時
				IF ALCOHOL_FACE(108) == "酔いどれ" || ALCOHOL_FACE(108) == "ぐでぐで"
					PRINTFORML 「... 어라? 맛있지 않았나~?」
					PRINTFORMDW 배가 불러서 많이 못 먹었어…….
				ELSE
					CALL COLORMESSAGE("「뭐야, 배 부른 거야? 그럼 나머지는 나 혼자 먹을게」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORMW MGMG
				ENDIF
			ENDIF
		CASE 8
			;▼演奏［セッションする］or［伴奏する］
			;※[音楽知識]持ちのみ（TALENT:音楽知識で変化）
			;TALENT:音楽知識,1=演奏してる,2=歌ってる,3=踊ってる
			;TFLAG:193,1=ノリノリ,0=成功,-1=失敗,-2=楽器がなくて見てるだけ
			;PRINTFORMW
		CASE 9
			;▼採集［採集を手伝う］
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")%! 딸기 찾았다고!?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 부르자, 링고가 이쪽으로 달려왔다.
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「...뭐야, 딸기잖아……이거 흐물흐물해서 맛없단 말이야」
							PRINTFORMDW 마치 먹어본 적이 있는 듯한 말투다...
						CASE 1
							PRINTFORML 「오오...! 멋진 나무딸기! 대단하네 %CALLNAME:MASTER%♪」
							CALL COLORMESSAGE("「……맛도 흠잡을 데 없네. 좀 받아 가야겠어♪」", C_ORANGE, 0, 0)
							SETCOLOR 0xFFFF00
							PRINTFORML MGMG
							PRINTFORMDW 링고와 나무딸기를 채집했다.
						CASE 2
							PRINTFORML 「……어디? 아무것도 없는 것 같은데?」
							PRINTFORMDL 당당한 나무딸기가 자라고 있었을 터인데, 흔적도 없이 사라져 버렸다……
							PRINTFORMW 「%CALLNAME:MASTER%, 너 여우나 뭐 그런 걸로 속은 거 아니야?」
					ENDSELECT
				CASE 1
					PRINTFORML 「도와줄 거야? 그럼 부탁할게」
					PRINTFORML 「～～♪」
					PRINTFORMDW 채집을 돕는 와중에도, 살랑거리는 엉덩이를 뒤에서 감상했다.
				CASE 2
					;シレンの忌火起草
					PRINTFORML 「...그러고 보니 지인 타마우사가 "떨어져 있는 풀을 마시면 도구가 전부 못 쓰게 된다"고 했었지...」
					PRINTFORML 「분명 "...이마비키소우"라던가 하는 이름이었나」
					PRINTFORMDW 잘 모르겠지만, 조심하자...
				CASE 3
					PRINTFORML 「오옷, 좋은 거 찾았네」
					PRINTFORMW 「이런 약의 재료는 야이님께서 사 주실 테니까~♪」
				CASE 4
					PRINTFORMDL 갈색으로 크고, 표고버섯과 닮은 버섯이 자라고 있다. 맛있어 보여…….
					PRINTFORMW 「그거 독버섯이야」
			ENDSELECT
		CASE 10
			;▼釣り［一緒に釣りをする］
			;TFLAG:193,-1=釣り竿がなくて見てるだけ
			;PRINTFORMW
		CASE 11
			;▼実験［実験を手伝う］
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「지금 말이야, %조사처리(CALLNAME:MASTER,"의")% 신체 능력을 대폭 강화하는 단자를 개발하고 있거든」
					PRINTFORML 「완성되면 먹여줄 테니까…… 우락우락 근육질이 될 수 있을 거야. 분명히」
					PRINTFORMDW 나 자신은 어떻게 되어버릴까…….
				CASE 1
					;サクマドロップスのフレーバー
					PRINTFORML 「이거? 향료 만들고 있는 거야. 맡아보고 싶어?」
					PRINTFORMDW %TEXTR("イチゴ/パイナップル/オレンジ/レモン/リンゴ/メロン/スモモ/ハッカ/チョコレート/")%의 좋은 향기가 났다.
				CASE 2
					PRINTFORML 「아차~… 실패해 버렸어…」
					PRINTFORML 「역시 하치이님처럼 잘 되지는 않나 봐……」
					PRINTFORMDW 링고는, 보글보글 거품을 내며 떠오르는 정체불명의 액체를 밖에 버리러 갔다……
				CASE 3
					PRINTFORML 「...%CALLNAME:MASTER%. 새로운 단고 만들었는데... 먹을래?」
					PRINTFORMDW 링고의 손에 있는 하얀 단고(?)가 꿈틀거리며 울음소리 같은 소리를 내고 있다...!
			ENDSELECT
		CASE 12
			;▼のんびり［一緒にのんびりする］
			SELECTCASE RAND:3
				CASE 0
					CALL COLORMESSAGE("「…………♪」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 기분 좋은 정적 속에서 링고와 단고를 먹었다.
				CASE 1
					PRINTFORML 「아아~~... 좋아~ 이 시간을 낭비하고 있는 느낌... ♪」
					PRINTFORMDW 특별히 아무것도 하지 않고, 링고와 빈둥거리며 보냈다.
				CASE 2
					PRINTFORML 「즈즈... 후우...」
					CALL COLORMESSAGE("「역시 너의 차는, 경단이랑 잘 어울린다구나...♪」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고와 차를 마시며 보냈다.
			ENDSELECT
		CASE 13
			;▼晩酌［晩酌に付き合う］
			;※酒耐性0以上のみ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「어때? 맛있어?」
					PRINTFORMW 「많으니까, 마구마구 마셔줘~♪」
				CASE 1
					PRINTFORML 「...에? 술이 안 들어가고 있다는 거야?」
					PRINTFORMW 「나는 천천히 마시는 걸 좋아하거든」
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%, 리필 필요해?」
					PRINTFORMDW 모처럼이니 받기로 했다.
			ENDSELECT
		CASE 14
			;▼買い物［買い物を手伝う］
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이야~ 덕분에 살았어 %CALLNAME:MASTER%」
					PRINTFORML 「너 덕분에 잔뜩 사서 돌아갈 수 있을 것 같아...♪」
					PRINTFORMDW 이미 양팔이 무겁지만, 아직 더 살 생각인 걸까...
				CASE 1
					PRINTFORML 「음~… 당근은 이쪽이 더 신선하네…」
					PRINTFORMDW 링고는 열성적으로 채소를 맛보고 있다.
				CASE 2
					PRINTFORML 「어땠어 %CALLNAME:MASTER%? 살 수 있었어?」
					PRINTFORML 「오~ 역시, 믿음직하네~♪」
					PRINTFORMDW 비틀거리면서, 링고에게 타임 세일의 전리품을 건넸다…
			ENDSELECT
		CASE 15
			;▼説教［様子をうかがう］
			;※神霊・蓬莱人は除く
			;TFLAG:193,-1
			;PRINTFORMW
		CASE 16
			;▼落とし穴［いたずらに付き合う］or［様子をうかがう］
			;※三月精・チルノ・クラウンピースのみ
			;それ以外は落ちる側
			;PRINTFORMW
		CASE 17
			;▼雪だるま作り［一緒に雪作り］
			;※冬の月のみ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「히이~!! 차가워!」
					PRINTFORML 「역시 맨손으로 하는 건 무리였나……?」
					PRINTFORMDW 그럴 만도 하지…….
				CASE 1
					PRINTFORML 「응? %CALLNAME:MASTER%, 눈 토끼 만들었어」
					PRINTFORML 「그 귀가 축 늘어져 있는 거, 혹시 나야? 아하하! 똑같이 생겼네♪」
					PRINTFORMDW 링고는 기쁜 듯 웃고 있다.
				CASE 2
					PRINTFORML 「우응……」
					PRINTFORMDL 링고와 눈사람을 만들었는데, 마음에 들지 않는 걸까?
					PRINTFORMW 「어떻게든 하나 더 위에 올려서, 꼬치구이처럼 못 만들까?」
			ENDSELECT
		CASE 18
			;▼炬燵でのんびり［炬燵でくつろぐ］
			;※冬の月のみ
			SELECTCASE RAND:3
				CASE 0
					CALL COLORMESSAGE("「역시 온돌 하면, 이거지」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고랑 둘이서 귤을 먹었다.
				CASE 1
					PRINTFORML 「……♪」
					PRINTFORMDW 링고가 발로 능숙하게 간지럽혀 온다...!
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%…… 온돌에서 자면 안 돼…… 감기 걸릴 거야……」
					PRINTFORMDW 링고는 공허한 눈으로 꾸벅꾸벅 졸고 있다……
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
