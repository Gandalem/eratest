				PRINTFORML MGMG
				SETCOLOR 0xEE9900
				PRINTFORML 「―아프다! 젠장, 한 번에 너무 많이 먹었다...!」
				PRINTFORMDW 링고가 빙수를 먹었다.
				;秋＆冬
			ELSE
				CALL COLORMESSAGE("「후우 후우... 뜨거워...! 달콤해...♪」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				CALL COLORMESSAGE("「이거 얼마든지 먹을 수 있을 것 같네…♪」", C_ORANGE, 0, 0)
				PRINTFORML MGMG
				PRINTFORMDW 링고랑 군고구마를 먹었다.
			ENDIF
	ENDSELECT
ENDIF
