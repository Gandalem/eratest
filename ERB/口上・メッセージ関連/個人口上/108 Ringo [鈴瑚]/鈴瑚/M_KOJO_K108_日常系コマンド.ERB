RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		CALL COLORMESSAGE("「…………。」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 링고에게 차가운 눈으로 노려졌다...
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@" 「자, 가보자... %CALLNAME:MASTER%읏」","L"
				PRINTFORMDW 링고와 팔짱을 끼고 걷기 시작했다.
			CASE 1
				CALL HPH_PRINT,@" 「후훗... HPH 이거 좋아해... HPH」","L"
				PRINTFORMDW 링고와 서로의 손가락을 깍지 끼며 손을 잡았다. 소위, "연인들의 손잡기"다.
			CASE 2
				CALL HPH_PRINT,@" 「%CALLNAME:MASTER%…HPH」","L"
				PRINTFORMDW 링고의 손을 잡자, 꽉 다시 잡아주었다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%……저기, 그게… 손을……」
				CALL HPH_PRINT,@" 「아앗……흐윽」","L"
				PRINTFORMDW 링고와 손을 잡았다. 왠지 조금 기뻐 보인다.
			CASE 1
				PRINTFORML 「―앗!?」
				PRINTFORMDL 링고와 손을 잡자, 놀란 듯 벌떡 일어났다……
				PRINTFORMW 「그, 갑자기 손잡지 마요...! 깜짝 놀라잖...!」
			CASE 2
				PRINTFORML (……내 손, 더러워지지 않았지…? 좋아, 괜찮아)
				PRINTFORML 「아…! 기다리게 했어 %CALLNAME:MASTER%...! 자♪」
				PRINTFORMDW 잠시 무언가 갈등이 있었던 듯했지만, 링고와 손을 잡았다.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응. 잠깐만 기다려봐… 자♪」
				PRINTFORMDW 링고는 꼬치구이던 손을 바꿔 %조사처리(CALLNAME:MASTER,"와")% 손을 잡았다.
			CASE 1
				PRINTFORML 「후훗...♪ 조금 부끄럽네...」
				PRINTFORMDW 링고는 살짝 부끄러운 듯 손을 잡아왔다.
			CASE 2
				PRINTFORML 「그럼 가볼까 %CALLNAME:MASTER%♪」
				PRINTFORMDW 링고의 손을 꼭 잡았다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL COLORMESSAGE("「손잡고 싶은 거야?... 뭐, 괜찮지만」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW 링고와 손을 잡았다.
			CASE 1
				PRINTFORML 「그렇게 손을 잡고 싶은 거야?... 어쩔 수 없네」
				PRINTFORMDW 한숨 쉬듯 내민 링고의 손을 잡았다.
			CASE 2
				PRINTFORML 「음~ 너 손, 꽤 크다 응」
				PRINTFORMDW 링고와 손을 잡았다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
