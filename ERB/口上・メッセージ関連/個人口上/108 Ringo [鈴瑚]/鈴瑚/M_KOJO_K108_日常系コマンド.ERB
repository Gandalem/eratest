;410,掃除
;FLAG:70(1=時間停止中
;TFLAG:193(0=見てるだけ 1=一緒に掃除)
;TFLAG:194(3=汚れ高 2=汚れ中 1=汚れ低 0=汚れ最小
;OUTROOF(CFLAG:現在位置)(野外掃除（冬は雪かき
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_410
RETURN 0

@M_KOJO_MESSAGE_COM_K108_410
CALL M_KOJO_MESSAGE_COM_K108_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		PRINTFORMDL 약간 쓰레기가 신경이 가서 청소를 하기로 했다.
		PRINTFORMDW 링고는 피곤한지, 어느 정도 소리가 나도 일어날 기미가 보이지 않았다.
	ELSEIF FLAG:時間停止
		PRINTFORMDW 정지된 시간 속에서 청소를 했다. 능력의 유효 활용이라는 것이지.
	ELSEIF CFLAG:108:うふふ
		PRINTFORML (어차피 더러워질 거니까, 끝난 다음에 하면 되는 건데…)
		PRINTFORMDW 링고는 불만스러운 표정을 하고 있다.
		;一緒に掃除
	ELSEIF TFLAG:193 == 1
		;ブチギレ
		IF CFLAG:318 == 1
			PRINTFORML 「…………。」
			PRINTFORMDW 링고와 한마디도 대화하지 않고 청소를 했다……
			;汚れ高
			IF TFLAG:194 >= 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「우웩…… 너무 더럽잖아… 나도 정말 해야 하는 거야?」
						PRINTFORML 「……알았어. 하면 되는 거겠지, 하면 돼」
						PRINTFORMDW 링고는 마지못해 청소를 도와주었다.
					CASE 1
						PRINTFORML 「이거 심하네. 더러움이 잔뜩 쌓여 있는 것 같아」
						PRINTFORML 「……그럼 %CALLNAME:MASTER%, 힘내―」
						PRINTFORMDW 도망치려는 링고의 어깨를 붙잡고, 청소를 도와달라고 부탁했다.
					CASE 2
						PRINTFORML 「……어쩔 수 없네, 나도 도와줄게」
						PRINTFORMW 「이렇게 더러우면 단어도 맛없어지잖아」
				ENDSELECT
			ENDIF
			;汚れ中以下
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%~!! 이제 이 정도면 됐잖아?」
					PRINTFORMDW 링고는 빨리 청소를 끝내고 싶어 하는 듯하다...
				CASE 1
					CALL COLORMESSAGE("「...앗」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					SETCOLOR 0xEE9900
					PRINTFORML 「아니~ 쉬고 있었을 뿐이야? 이거 먹으면 다시 시작할 거니까……」
					PRINTFORMDW 눈을 돌린 사이, 링고는 단자를 먹고 있었다…
				CASE 2
					PRINTFORML 「이것도 경단 맛있게 먹기 위해서…… 참아봐야지, 참아야 해……」
					PRINTFORMDW 링고에게 청소하는 것을 도와달라고 했다.
			ENDSELECT
		ENDIF
		;見てるだけ
	ELSE
		IF CFLAG:318 == 1
			CALL COLORMESSAGE("「…………。」", C_ORANGE, 0, 0)
			SETCOLOR 0xFFFF00
			PRINTFORML MGMG
			PRINTFORMDW 링고는 단자를 먹으면서 멀리서 이쪽을 보고 있다...
			;汚れ高
			IF TFLAG:194 >= 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「나도 도와주는 거야? 이야아~……그건 좀……. 손이 더러워지잖아……」
						PRINTFORML 「우……! ……아, 알겠어! 하면 되는 거잖아!」
						PRINTFORMDW 링고는 무너진 건지, 청소를 도와주게 되었다.
					CASE 1
						PRINTFORML 「아무래도... 보통 이렇게 더러워지는 건가?」
						PRINTFORML 「평소에는 세이란 같은 애들이 청소해 주고 있었을 텐데……」
						PRINTFORMDW 링고는 신음하며 생각을 정리하고 있다. 부디 도와줬으면…….
					CASE 2
						PRINTFORML (너무 더러워서 가까이 가는 것도 싫을 정도인데…… 정말 대단하다, %CALLNAME:MASTER%……)
						CALL COLORMESSAGE("(끝나면 경단이라도 사주자...)", C_ORANGE, 0, 0)
						SETCOLOR 0xFFFF00
						PRINTFORML MGMG
						PRINTFORMDW 링고는 가만히 이쪽을 바라보고 있다.
				ENDSELECT
			ENDIF
			;汚れ中以下
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「뭐든지 네가 스스로 청소하지 않아도……」
					PRINTFORMDW 링고는 청소하는 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
				CASE 1
					CALL COLORMESSAGE("「단고는 흘릴 게 없으니까, 안심하고 먹을 수 있네.」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					CALL COLORMESSAGE("「괜찮아. 네 청소 방해 안 할게」", C_ORANGE, 0, 0)
					PRINTFORML MGMG
					PRINTFORMDW 차라리 도와줬으면 해……
				CASE 2
					PRINTFORML 「스스로 청소라니 대단하네, %CALLNAME:MASTER%」
					PRINTFORMW 「……혹시 청소가 취미 같은 거야?」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
