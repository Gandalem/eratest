@M_KOJO_MESSAGE_SCOM_K108_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 0
		CALL COLORMESSAGE("「...아파, 놓아줘...!」", C_ORANGE, 0, 0)
		SETCOLOR 0xFFFF00
		PRINTFORML MGMG
		PRINTFORMDW 손을 놓으려 하자, 링고에게 노려졌다……
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「모~...! 그렇게 서두지 않아도 되는데...」
				PRINTFORML 「...나는 너랑 느긋하게 걷고 싶은데...」
				PRINTFORMDW 링고는 살짝 토라졌지만, 걸음의 속도를 높여주었다.
			CASE 1
				PRINTFORML 「자, %CALLNAME:MASTER%읏! 빨리빨리♪」
				PRINTFORMDW 드물게 손을 뿌리며 재촉해 온다. 무척 데이트가 기대되었던 걸까.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「자, %CALLNAME:MASTER%! 서둘러, 서둘러!」
				PRINTFORMW 「수량 한정 디저트가 팔려버릴 거야!」
			CASE 1
				PRINTFORML 「키... 오늘은 또, 상당히 빠른 속도네...!」
				PRINTFORMDL 링고가 옆구리를 부여잡으면서도 필사적으로 따라오고 있다……
				PRINTFORMDW 빨리 목적지에 도착하고 싶었지만, 링고의 몸을 염려하여 걷는 속도를 늦췄다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「에~…… 좀 더 천천히 가자고…」
				PRINTFORMDW 아야에게 불평하는 링고의 손을 잡아끌고 목적지로 서둘렀다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%…… 잠깐만 기다려봐…!」
				PRINTFORML 「갑자기 움직이니 옆구리가…… 아, 아파아……!」
				PRINTFORMDW 링고는 괴로워 보인다… 링고의 몸을 염려하여 천천히 걷기로 했다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
