;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があってもムードが足りぬ　100=合意はあるが口上内特殊判定によって失敗）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先にキスぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外 98=口上内特殊判定による失敗 99=口上内特殊判定による成功
;口上内特殊判定は該当するCFLAGが0だと無効
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_350
RETURN 0

@M_KOJO_MESSAGE_COM_K108_350
CALL M_KOJO_MESSAGE_COM_K108_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR 0xEE9900
	IF FLAG:時間停止
		PRINTFORMDW 시간을 멈추고, 완전히 저항력을 잃은 링고를 욕망대로 유린해 주기로 했다.
	ELSEIF TFLAG:194
		SELECTCASE TFLAG:194
			;人目がある
			CASE 1
				IF TALENT:恋人
					PRINTFORML 「……%조사처리(CALLNAME:MASTER,"는")%, 나의 벌거벗은 모습을 누군가 봐도 괜찮은 거야?」
					PRINTFORMDW 링고가 슬픈 눈으로 바라본다…….
				ELSE
					PRINTFORML 「이야~... 이런 공공장소에서 하는 건 좀...」
					PRINTFORMDW 링고에게 거절당해버렸다...
				ENDIF
				;野外は嫌でござりまする
			CASE 2
				IF TALENT:恋人
					PRINTFORML 「집이나 호텔에서, 남의 눈치 안 보고 하고 싶다 나는」
					PRINTFORMDW "보일지도 모른다는 스릴이 참을 수 없다"고 힘주어 말했다. 하지만 결국 거절당했다...
				ELSE
					PRINTFORML 「...여기서 하는 거야? 누가 오면 큰일 나는데...」
					PRINTFORMDW 링고는 별로 의욕이 없는 듯하다...
				ENDIF
				;多人数プレイは勘弁
			CASE 3
				CALL COLORMESSAGE("「정떨어진다. 한동안 나한테 말 걸지 마.」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				PRINTFORMDW "난잡하게 해보고 싶다"라고 말하자, 경멸하는 듯한 눈빛으로 노려졌다.
				;合意があってもムードが足りぬ
			CASE 4
				IF TALENT:恋人 || TALENT:恋慕
					CALL COLORMESSAGE("「...좀 더 분위기를 소중히 해줬으면 좋겠어」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고에게 밀려버렸다…….
				ELSE
					CALL COLORMESSAGE("「놔줘. 오늘은 단고 먹고 싶단 말이야」", C_ORANGE, 0, 0)
					SETCOLOR 0xFFFF00
					PRINTFORML MGMG
					PRINTFORMDW 링고는 기분이 안 좋은 모양이다……
				ENDIF
		ENDSELECT
	ELSEIF TCVAR:抱き寄せ初回
		SELECTCASE TCVAR:抱き寄せ初回
			;普通に合意ゲット
			CASE 1
				PRINTFORML 「앗……!」
				PRINTFORMDW 링고는 순간 몸을 경직시켰지만, 이윽고 자신에게 몸을 기댔다……
				;先にキスぐらいしろよ
			CASE 2
				PRINTFORML 「……안 돼 %CALLNAME:MASTER%. 이런 건, 정말 사랑하는 사람하고――」
				CALL HPH_PRINT,@"「―응무읏!? ……응…후헵」","L"
				PRINTFORMDW 링고에 대한 사랑이 진심이라는 것을, %조사처리(CALLNAME:MASTER,"는")% "행동"으로 보여주었다.
				;媚薬or発情には勝てなかったよお…
			CASE 3
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%……HPH 안돼……HPH 안 돼, 이런 거……HPH HPH」","L"
				CALL HPH_PRINT,@"「이런... HPH 강제로 같은 느낌의... HPH 아... 안 된다고 했잖아... HPH」","L"
				PRINTFORMDW 말과는 달리, 링고의 저항은 약하다…….
				;悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
			CASE 4
				PRINTFORML (이런... 무리하게라니...... 거절해야 해...!)
				CALL HPH_PRINT,@"「괜찮아... HPH 부드럽게 해줘... HPH」","W"
				PRINTFORMW (……어라? 나 지금 무슨 말을 하고 있었지――)
				;強引に迫られると断れぬ(素質臆病持ち専用)
			CASE 5
				;まんざらでもない
			CASE 6
				PRINTFORML 「미안해. 한심한 이야기지만, 아직 무서워서……」
				PRINTFORML 「조금만 더 기다려줘……」
				PRINTFORMDW 무리하게 강요하는 건 좋지 않다… %조사처리(CALLNAME:MASTER,"는")% 물러나기로 했다.
				;駄目
			CASE 7
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「안 돼, %CALLNAME:MASTER%……」
					PRINTFORML 「나한테 손대면 후회하게 될 거야」
					PRINTFORMDW 잘 모르겠지만, 링고는 안 안기는 게 싫은 모양이다……
				ELSE
					PRINTFORML 「너는 어디까지나 조사 대상. 그 이상의 관계가 될 생각은 없어」
					PRINTFORML 「자…… 알았으면 어서 떨어져」
					PRINTFORMDW 링고에게 단호하게 거절당했다…….
				ENDIF
				;論外
			CASE 8
				PRINTFORML 「―이걸로 확신했어. 너는 내 몸만 노리고 있었구나」
				PRINTFORML 「너, 항상 내 가슴만 보고 있잖아? 모를 거라고 생각했어?」
				PRINTFORMDW 링고의 말에서는 자신을 거부하는 듯한 의지가 느껴진다……
		ENDSELECT
	ELSEIF TALENT:妊娠
		SELECTCASE RAND:3
			CASE 0
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「배에 아기가 있는데, 하고 싶어졌어?」
					CALL HPH_PRINT,@"「정말…… 어쩔 수 없는 아빠네…… HPH」","W"
				ELSE
					PRINTFORML 「아직 좀 괴로우니까…… 다정하게 해줘……?」
					PRINTFORMDW 링고는 배 속의 아이를 걱정하는 듯, 부드럽게 쓰다듬으며 몸을 맡겼다.
				ENDIF
			CASE 1
				PRINTFORML 「저기... 너무 격하게는 그만해 줄래...?」
				PRINTFORMDW 링고를 걱정하는 듯, 조심스럽게 몸을 옆으로 눕혔다.
			CASE 2
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「네 네... 어차피 안 된다고 해도 할 거잖아... ♪」
					CALL HPH_PRINT,@"「……상냥하게 해줘 HPH」","W"
				ELSE
					PRINTFORML (……%조사처리(CALLNAME:MASTER,"와")% 있으면, 조금은 기분 전환이 될지도 모르겠네……)
					PRINTFORMW 「알았어… 부드럽게 해줘……♪」
				ENDIF
		ENDSELECT
	ELSEIF TALENT:恋人
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「후훗 HPH단지가 아니라 나를 먹을 생각이야?」","L"
				PRINTFORMDW 링고를 맛있게 먹기로 했다.
			CASE 1
				CALL HPH_PRINT,@"「…………괜찮아 HPH」","L"
				CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 정액으로…… 배 가득 채워줘 HPH」","L"
				PRINTFORMDW 링고에게 귓가에 속삭여져, 흥분을 가누지 못하겠어...!
			CASE 2
				CALL HPH_PRINT,@"「후훗... HPH네... HPH 오늘은 어떤 체위로 할 거야?」","L"
				PRINTFORMDW 링고는 볼이 발그레해지며 웃어 보였다.
			CASE 3
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 HPH아무 HPH츄릅 HPH줄루 HPH쭈르륵 HPH」","L"
				PRINTFORMDW 갑자기 덮쳐져도, 링고는 동요하는 기색 없이 혀를 얽어왔다...!
			CASE 4
				PRINTFORML 「%CALLNAME:MASTER%~……에치 하기 전에 할 일이 있잖아?」
				CALL HPH_PRINT,@"「응... 흐읍... 츄읍흐읍 응응... 흐읍 흐읍」","L"
				PRINTFORMDW 링고의 애원에 응하며 입술을 포개었다.
		ENDSELECT
	ELSEIF TALENT:恋慕 || TALENT:セフレ
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응…… 괜찮아… HPH」","L"
				PRINTFORMDW 링고는 고개를 끄덕이고는 살며 몸을 맡겼다.
			CASE 1
				CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"가")%... 나를 원하고 있어... HPH)","L"
				CALL HPH_PRINT,@"「상냥하게 해줘……후훗」","W"
			CASE 2
				PRINTFORML (%CALLNAME:MASTER%…… 지금은, 나만 봐줘…!)
				PRINTFORMDW 밀치던 링고가 꽉 끌어안아 온다……
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「에휴…… 어쩔 수 없네, 너는」
				PRINTFORMDW 링고는 체념하는 듯하면서도 %조사처리(CALLNAME:MASTER,"를")% 받아들일 자세를 취했다.
			CASE 1
				PRINTFORML 「……사실은, 내 몸만 노리는 거 아니야~?」
				PRINTFORMDW 링고의 발언을 부정하면서 천천히 밀쳐 넘어뜨렸다.
			CASE 2
				PRINTFORML 「아야아… 엉덩이 때려버렸잖아...!」
				PRINTFORML 「정말이지...! 좀 더 다정하게 해줘……」
				PRINTFORMDW 볼을 부풀리고 있는 링고에게 사과하고, 그녀의 몸을 부드럽게 안았다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;351,連れ出す
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_351
RETURN 0

@M_KOJO_MESSAGE_COM_K108_351
;連れ出しにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K108_351_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_351_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;酔っぱらってる状態で連れ出す
	IF ALCOHOL_FACE(108) == "酔いどれ" || ALCOHOL_FACE(108) == "ぐでぐで"
		PRINTFORML 「%CALLNAME:MASTER%……미안한데, 잠깐 어깨 좀 빌려줄 수 있어?」
		PRINTFORML 「한심한 이야기지만, 너무 많이 마셔서 제대로 걷지를 못하겠어…… 히히…」
		PRINTFORMDW 링고에게 어깨를 빌리고 데려나왔다.
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				CALL COLORMESSAGE("「음, 잠깐 기다리고 있어. 이거 다 먹어버릴 거니까……」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORML MGMG
				SETCOLOR 0xEE9900
				PRINTFORMW 「기다리게 했네. 가자 %CALLNAME:MASTER%」
			CASE 1
				PRINTFORML 「자아 %CALLNAME:MASTER%♪ 어디 놀러 갈까... 아니, 조사하러 가볼까?」
				PRINTFORMDW 링고와 놀러 가는 대신, 조사를 하기로 했다.
			CASE 2
				PRINTFORMW 「잊은 건……없어! 가볼까 %CALLNAME:MASTER%♪」
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML (이거 혹시 데이트인가……)
				CALL COLORMESSAGE("「……그런 일은 없을 리가 있지」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORMW MGMG
			CASE 1
				PRINTFORML 「아……응! 같이 가자……♪」
				PRINTFORMDW 링고는 기쁜 듯 따라왔다.
			CASE 2
				PRINTFORMW 「너랑 맛있는 거라도 먹으러 가고 싶다…… 같은 걸 말이야」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL COLORMESSAGE("「괜찮아. 나도 마침 한가했거든.」", C_ORANGE, 0, 0)
				SETCOLOR 0xFFFF00
				PRINTFORMW MGMG
			CASE 1
				PRINTFORMW 「맛있는 거라도 먹으러 갈래?」
			CASE 2
				PRINTFORMW 「오? 혹시 데이트 신청이야?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;352,告白する
;FLAG:甲斐性無(1=失敗)
;TFLAG:193 (1=成功 0=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K108_352
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_352
RETURN 0

@M_KOJO_MESSAGE_COM_K108_352
CALL M_KOJO_MESSAGE_COM_K108_352_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_352_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;はたて口上を参考に、振られたかどうかで会話が一部変化
IF LOCAL
	SETCOLOR 0xEE9900
	IF TFLAG:193 == 1
		IF TALENT:恋慕
			PRINTFORML 「……%CALLNAME:MASTER%, 지금 무슨 소리야?」
			PRINTFORMW 「나를 "좋아해"라고...?」
			PRINTFORMDW 링고의 눈을 똑바로 응시하며 고개를 끄덕이자, 링고는 주르륵 눈물을 흘리기 시작했다……
			PRINTFORML 「아... 미안해...? 아니야, 이건... 기뻐서...!」
			PRINTFORMW 「사실 나도... 너를 좋아했어...!」
			IF CFLAG:1007 >= 1
				PRINTFORML 「하지만... 나로는 분명 어울리지 않을 거라 생각해서...」
				PRINTFORMW 「나 이외의 누군가와 함께하는 편이, 당신도 행복할 거라고 생각하니... 두려웠어...!」
			ELSE
				PRINTFORMW 「"하지만... %조사처리(CALLNAME:MASTER,"가")% 그렇지 않았다면 "내 착각이었나" 하고 생각하면... 무서웠어...!"」
			ENDIF
			PRINTFORMW 「……%CALLNAME:MASTER%… 정말, 저 같은 걸로―」
			PRINTFORMW 「―앗…!」
			PRINTFORMDW 대답을 하는 대신, 링고를 세게 끌어안으며 키스했다……!
			PRINTFORMW 「응… 고마워… %CALLNAME:MASTER%…!」
			CALL HPH_PRINT,@"「나도…… %조사처리(CALLNAME:MASTER,"가")% 좋아…… HPH」","W"
		ELSE
			IF CFLAG:1007 >= 1
				PRINTFORML 「……하아…… 너 같은 애는 정말 포기가 없구나……」
				PRINTFORMW 「……이런 졸개 토끼 따위의 어디가 좋다는 거야……♪」
				PRINTFORMDW 자조적으로 웃는 링고에게, "연인이 되어줬으면 해"라며 다시 고백했다.
				PRINTFORMW 「응… 알았어 %CALLNAME:MASTER%…… 음 그게…」
				PRINTFORMW 「앞으로도 잘 부탁해……?」
				PRINTFORML 「……푸퉤! 아하하하하하!!」
				PRINTFORMDW 링고의 대답이 웃겨서, 둘은 함께 웃었다……
			ELSE
				PRINTFORMW 「에? ……%CALLNAME:MASTER%, 지금 뭐라고 했어?」
				PRINTFORMDW 멍한 표정의 링고에게 다시 한번, "연인이 되어줬으면 좋겠어"라고 고백했다.
				PRINTFORML 「아, 하하하…… 그게…… 있잖아……」
				PRINTFORMW 「나…… 태어나서 연애 같은 건 해본 적이 없어서…… 어떻게 대답해야 할지 모르겠어……」
				PRINTFORMDW "링고의 마음을 듣고 싶어"라고 말하며, %조사처리(CALLNAME:MASTER,"는")% 그녀의 대답을 기다렸다……
				PRINTFORMW 「……알았어, %CALLNAME:MASTER%…… 음……」
				PRINTFORMW 「앞으로 잘 부탁해……?」
				PRINTFORML 「……푸큭! 아하하하하!!」
				PRINTFORMDW 링고의 대답이 우스워서 둘은 함께 웃었다……
			ENDIF
		ENDIF
		;振られた
	ELSE
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「%CALLNAME:MASTER%… 뭔가 착각하고 있는 것 같은데…」
			PRINTFORML 「나는 조사 대상으로서 너에게 접촉하고 있을 뿐이고, 연애 감정 같은 건 없어」
			PRINTFORMDW 링고에게 거절당해 버렸어……
			CFLAG:1007 += 1
		ELSE
			PRINTFORML 「아이고... 너 정말 포기할 줄 모르네」
			PRINTFORML 「전에 말했지만, 너는 어디까지나 조사 대상이다. 그 이상의 감정은 없다고 말했잖아」
			PRINTFORML 「...너에게 여자 지인이 많으니, 다른 사람을 만나렴」
			PRINTFORMDW 링고는 모자를 깊게 눌러쓰고 더 이상 아무 말도 하지 않았다……
		ENDIF
	ENDIF
ENDIF
RETURN 1
