						PRINTFORMDW 비명에 가까운 신음과 함께, 강렬한 조임이 덮쳐왔다--
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아아아아앗! 흐읍, 안돼앳! 금방 갈 것 같으니까 아으윽! 흐읍」","L"
						PRINTFORMDW 피스톤하는 도중에, 링고의 음핵을 손가락으로 건드렸다.
					CASE 1
						CALL HPH_PRINT,@"「좋아아앗 HPH HPH 지금, 클리토리스 자극받으면 안 돼애엣 HPH HPH」","L"
						PRINTFORMDW 클리토리스를 손가락으로 주무르자, 질 안이 더욱 조여왔다...!
					CASE 2
						CALL HPH_PRINT,@"「아앗 흐읍 흐읍 %CALLNAME:MASTER%읏 흐윽 더... 으으...」","L"
						CALL HPH_PRINT,@"「거기도 세게 해줘읏, HPH HPH」","L"
						PRINTFORMDW 링고는 완전히 쾌락의 노예가 되어 버렸다...!
				ENDSELECT
				RETURN 1
			ENDIF
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 저... 벌써, 갈 것 같아요...!」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 페니스를 꾹꾹 누르며 질 깊숙이 밀어 넣자, 링고의 음핵을 세게 움켜쥐었다...!
					CASE 1
						CALL HPH_PRINT,@"「하아앗 HPH 하아앗 HPH 머리가... 몽롱해져 버릴 것 같아엣…… HPH」","L"
						PRINTFORMDL 링고는 절정에 다다른 것 같다. %조사처리(CALLNAME:MASTER,"는")% 페니스를 질 안에 삽입한 채, 그녀의 음핵을 집었다.
						CALL HPH_PRINT,@"「앗!? 아아... 큭! 아아앙~~ 큭 큭」","W"
					CASE 2
						PRINTFORMDL 서로 절정에 가까워졌음을 느낀 %조사처리(CALLNAME:MASTER,"는")%, 삽입하면서 링고의 음핵을 자극했다.
						CALL HPH_PRINT,@"「큭흐으 변응응응응우~~읏HPH HPH HPH」","L"
						PRINTFORMDW 링고는 황급히 입을 막고 신음소리를 삼켰지만, 질 안의 조임까지는 막지 못했다―
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「하아앗 HPH 하아 HPH 하앗 HPH」","L"
						PRINTFORMDL 링고의 허리를 잡고 삽입하고 있자, 발기한 음핵이 눈에 들어왔다…….
						CALL HPH_PRINT,@"「앗!? 아아아앗! 흐읍 흐읍 안 돼, 지금 절정하면 안 되는데 흐읍 흐읍」","W"
					CASE 1
						CALL HPH_PRINT,@"「응으으윽! 흐읍 흐읍해, 안 돼……!」","L"
						CALL HPH_PRINT,@"「너무 기분 좋아서…… 이상해질 것 같아읏 HPH」","L"
						PRINTFORMDW 클리토리스를 손가락으로 주무르자, 질 안이 더욱 조여왔다...!
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「흐으윽! 흐읍, 흐응... 아아...! 흐읍」","L"
				PRINTFORMDW 발달한 음핵을 자극당하자, 링고는 저속한 신음 소리를 내고 있다...!
			CASE 1
				CALL HPH_PRINT,@"「아……헉! 흐윽... 으응! 흐윽, 흐윽」","L"
				CALL HPH_PRINT,@"「클리…… 더, 흐으윽 더 만져줘애엣흐읍 흐읍」","L"
				PRINTFORMDW 음핵을 자극받아, 링고는 침을 흘리며 기뻐하고 있다...!
			CASE 2
				CALL HPH_PRINT,@"「하아……후으 아앗 후우 후우 클리……후우 정말 기분 좋아…….후우」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%…흐으윽…더, 해줘……흐으윽」","L"
				PRINTFORMDW 링고가 황홀한 표정으로 바라보고 있어……!
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「~~~~앗! 핥짝 핥짝」","L"
				PRINTFORMDL 목소리가 들리는 게 부끄러운 건지, 링고는 손으로 입을 막고 있다…….
				PRINTFORMDW 어떻게든 신음을 자아내게 하려고, %조사처리(CALLNAME:MASTER,"는")% 끈질기게 음핵을 계속 만졌다……
			CASE 1
				CALL HPH_PRINT,@"「우아앗 히으햔 거기, 거긴 예민하니까 너무 만지지 말아줘……」","L"
				CALL HPH_PRINT,@"「응응읏 후으... %CALLNAME:MASTER%, 듣고 있어!?」","W"
			CASE 2
				CALL HPH_PRINT,@"「하앗, 핥짝, 아아앗! 클리... 느껴져...! 아아앗」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
