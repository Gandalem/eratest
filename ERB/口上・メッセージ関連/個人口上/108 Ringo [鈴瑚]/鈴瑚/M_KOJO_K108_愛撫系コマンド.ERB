@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_0
RETURN 0

@M_KOJO_MESSAGE_COM_K108_0
CALL M_KOJO_MESSAGE_COM_K108_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｃ＆Ｂ感覚が一定以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				CALL RINGO_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앗, 흐응! 응읏... 아아우윽! 그만해... 너무 기분 좋아서 안 돼애...!」","L"
						CALL HPH_PRINT,@"「움직이면서 하는 거야……흐읍, 흐읍 반칙이야읏 흐읍 흐읍」","L"
						PRINTFORMDW 안팎에서 동시에 몰아치자, 링고는 몸을 부르르 떨기 시작한다...!
					CASE 1
						PRINTFORML 「에……앗! 안돼! 지금 만지면―」
						CALL HPH_PRINT,@"「아아아아~~흣! 흣흣 으응흣흐응으으~~흣! 흣흣」","L"
						PRINTFORMDW 링고의 질벽이 경련하며 조여온다...!
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……후우 그……귓가에――」","L"
						CALL HPH_PRINT,@"「후아아~큭큭 후훗 귀가 만져지는 거, 좋아읏 큭큭」","W"
				ENDSELECT
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				CALL RINGO_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「후아앗 HPH 아앗 HPH 잠깐...! 지금은 안 된다고오……읏 HPH」","L"
						PRINTFORMDW 삽입하면서 링고의 몸을 애무했다.
					CASE 1
						CALL HPH_PRINT,@"「흐윽... 하프후우... 앗, 아응... 하프」","L"
						CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 숨결이……. 귓가에 스치네… 읏 HPH)","W"
					CASE 2
						CALL HPH_PRINT,@"「응으윽... 흐읍! 만지면서 하는 거, 좋아할지도 몰라... 흐읍」","W"
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚・Ｂ感覚が５以上
	ELSEIF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「응읏 HPH 아앗 HPH 하아앗…… %CALLNAME:MASTER%……읏 HPH」","L"
				PRINTFORMDL 링고의 옆구리나 허벅지를 톡... 하고 손가락으로 쓸며 애무한다.
				PRINTFORMDL 거듭된 애무 덕분인지, 링고는 이전보다 달콤한 목소리를 내게 되었다.
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%……그게……나도……HPH」","L"
				PRINTFORMDW 링고는 %TEXTR("陰核/乳房/膣穴/")%를 만져줬으면 하는 것 같다.
			CASE 1
				CALL HPH_PRINT,@"「아아앗 후후, 귀야 안 돼읏 후후, 거기! 거기는 약한 곳이라고옷 후후」","L"
				PRINTFORMDL 후루룩, 하고 링고의 토끼 귀를 살짝 깨물었다. 링고는 정말 기분 좋아 보여……
				PRINTFORMDL 더 큰 반응을 보려고, %조사처리(CALLNAME:MASTER,"는")% 귀구멍을 파듯이 혀로 핥았다.
				CALL HPH_PRINT,@"「히아아아앗! 흥분돼어으윽... 으응흐읍...」","W"
			CASE 2
				CALL HPH_PRINT,@"「응응…흐읍 응…아앗 흐읍 응우욱 흐읍」","L"
				CALL HPH_PRINT,@"「...나도... 후후 후후」","L"
				PRINTFORMDW 링고와 서로의 몸을 애무했다.
			CASE 3
				CALL HPH_PRINT,@"「아앗 흐으응흐응, 꼬리! 꼬리 만져줘 흐응, 부럽다아 흐응」","L"
				CALL HPH_PRINT,@"「흐으윽! 흐읍... 흐읍... 더, 더 애무해줘, 더오옷... 흐읍 흐읍」","L"
				PRINTFORMDW 꼬리를 애무하는 요령이 조금은 알 것 같은 기분이 들어…….
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「응읏! ……후훗♪ 조금… 간지러워라니까~♪」
				PRINTFORMDW 링고는 몸을 비틀며 애무를 받아들인다……
			CASE 1
				CALL HPH_PRINT,@"「하앙! 흐읍 흐읍…… 으응~!」","L"
				PRINTFORML (흐, 이상한 소리가 나버렸네……)
				PRINTFORMDW 링고는 토끼 귀를 핥아지고, 부끄러운 듯 얼굴을 숙였다.
			CASE 2
				PRINTFORML 「응응……! 기분 좋은 걸까?」
				PRINTFORML 「간지러워한다고 해야 하나……. 미안, 잘 모르겠어……」
				PRINTFORMDW 링고는 타인에게 애무받는 것에 아직 익숙하지 않은 듯하다.
			CASE 3
				CALL HPH_PRINT,@"「흐아앗! 후후, 꼬리는 예민하니까 만지지 마아...!」","L"
				CALL HPH_PRINT,@"「아응! 흐읍 흐읍 잠깐...! %CALLNAME:MASTER%, 들어봐... 응응! 흐읍 흐읍」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
