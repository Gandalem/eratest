@M_KOJO_MESSAGE_MESSAGECHECK_COM_K108_1
RETURN 0

@M_KOJO_MESSAGE_COM_K108_1
CALL M_KOJO_MESSAGE_COM_K108_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K108_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			;時姦中
			IF FLAG:70
				PRINTFORMW 
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「흐읍! 하아... 안 돼에... 흐으윽...」","L"
						CALL HPH_PRINT,@"「방금 했더니 엄청 민감해졌으니까아HPH HPH」","L"
						PRINTFORMDW 링고의 질구에서 흘러나오는 정액을 빨아들였다……
					CASE 1
						PRINTFORML 「엣!? %CALLNAME:MASTER%, 설마 핥아――」
						CALL HPH_PRINT,@"「우아아아앗 흐읍 흐읍 아흣 아아아아아아악흐읍 흐읍 흐읍 흐읍」","L"
						PRINTFORMDW 질내 사정 직후의 자신의 정액을, 소리를 내며 빨아들였다...!
					CASE 2
						CALL HPH_PRINT,@"「음응… HPH 너… 자기 정액을 잘도 빨아 먹는구나……」","L"
						CALL HPH_PRINT,@"「……후후, 나에게도……후후」","L"
						CALL HPH_PRINT,@"「아……흐읍……음읏……꿀꺽……」","L"
						PRINTFORMDW 링고에게도 조금 "나눠줬다".
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;Ｃ感覚５以上
		IF ABL:Ｃ感覚 >= 5
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「하아—후우, 하아—후우…… %CALLNAME:MASTER%, 미안해읏」","L"
					PRINTFORMDL "뭐가"라고 물으려던 순간― 링고에게 뒷머리를 잡히고 얼굴을 하체에 밀어붙여졌다...!
					CALL HPH_PRINT,@"「조금만 더 가면 될 것 같으니까... HPH 잔뜩 핥아줘 HPH 부탁해 HPH」","L"
					PRINTFORMDW 넘쳐흐르는 애액에 빠질 듯 하면서도, %조사처리(CALLNAME:MASTER,"는")% 필사적으로 계속 핥는다―
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 후으... 더, 더 하고 싶어... 곧 갈 것 같아...!」","L"
					PRINTFORMDL "알았다"고 한마디 말하고, %조사처리(CALLNAME:MASTER,"는")% 음핵을 물었다.
					PRINTFORMDL 링고는 뒤로 넘어가며 커다란 신음소리를 내뱉었다……!
				CASE 2
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 혀가 핥짝 핥짝 안에서 움직여서 핥짝 기분 좋아 핥짝 핥짝」","L"
					CALL HPH_PRINT,@"「아앗 흐으읍흐으아아 흐으읍흐으 갈 것 같아아 흐으읍」","L"
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%마셔줘읏 HPH 내 음료 마셔줘애애 HPH HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 여성의 음부에 달려들어, 소리를 내며 빨아들였다―
				CASE 3
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 HPH 더 핥아줘 HPH 기분 좋게, 해주고 싶어 HPH」","L"
					PRINTFORMDL 링고도 그럴 기분이 된 모양이다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 그녀의 허리를 단단히 붙잡고, 더욱 질내를 격렬하게 핥아댔다...!
					CALL HPH_PRINT,@"「흐으아아앙! 하프 하프 그거 좋아!! 기분 좋아!! 하프 하프」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%……! 그만, 이제 그 정도면 됐단 말이야……!」
					CALL HPH_PRINT,@"「더 이상 하면――아아앗 HPH로, 나와버릴 거야! 나와버리니까 아아앗 HPH HPH」","L"
					PRINTFORMDW 링고의 말을 무시하고, 정신없이 질내를 계속 핥았다...!
				CASE 1
					PRINTFORMDL 절정에 다다른 걸까, 링고의 질벽이 경련하기 시작했다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 숨을 크게 들이마셔 암컷의 체취를 만끽한 뒤, 다시 핥기 시작했다...!
					CALL HPH_PRINT,@"「아아앗 큭... 이제 안 돼읏! 오는 거야...! 크으윽, 큰 거 와... 큭! 큭」","W"
				CASE 2
					CALL HPH_PRINT,@"「하앗 하프 아프하 안흣 아아앗 하프 하프」","L"
					PRINTFORMDL 링고가 격렬하게 신음할 때마다, 질내에서 움찔움찔 떨린다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 혀를 빼내 클리토리스를 빨아들였다...!
				CASE 3
					CALL HPH_PRINT,@"「응읏! 흐읍... 후우윽...! %CALLNAME:MASTER%......」","L"
					PRINTFORMDL 링고가 애타는 목소리를 내며 바라보고 있다……
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 혀를 격렬하게 움직이며 링고를 절정에 이르게 했다……!
					CALL HPH_PRINT,@"「아앗! 하으윽, 그게... 안 돼... 갈 것 같아...! 흐읍... 흐응...」","W"
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「응응! 흐으... 오, 맛있다...? 내 보지... 흐으」","L"
				CALL HPH_PRINT,@"「아앗 HPH HPH, 입맞춤한 채로 말하지 마아애 HPH HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「하아앗 HPH 아아 HPH 아앗 HPH 기분 좋아읏 HPH HPH」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 HPH 더 해줘 HPH 더 오만코 핥아줬으면 좋겠어 HPH HPH」","L"
				PRINTFORMDW 링고의 갈라진 곳에 혀를 갖다 대고, 넘쳐흐르는 애액을 핥아먹었다...!
			CASE 2
				CALL HPH_PRINT,@"「아앗!? 파앗 HPH 아아앙! 오만코, 깨물지 말아줘애 HPH HPH」","L"
				PRINTFORMDW 링고의 은밀한 곳을 살짝 깨물었다. 희미하게 새겨진 자신의 이빨 자국을 보며, 형용할 수 없는 정복감을 얻었다...!
			CASE 3
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%……HPH 오만코뿐이 아니라…… HPH」","L"
				CALL HPH_PRINT,@"「파아아아앗 흐으읍 흐으읍 크헉흐윽 왔어아아악 흐으읍 흐으읍」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 더욱 강하게 여성의 음부를 빨아들이자, 링고는 기쁜 듯한 신음을 토해냈다.
			CASE 4
				CALL HPH_PRINT,@"「응으읏 흐읍...흐읍 ...후훗♪」","L"
				CALL HPH_PRINT,@"(%CALLNAME:MASTER%, 열심히 보지 핥아주고 있어……. HPH)","W"
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:5 ;custom code
			CASE 0
				CALL HPH_PRINT,@"「큭… HPH 헉…… 아아앗… HPH 혀가, 안에서 움직여… 으으윽 HPH」","L"
				PRINTFORMDW 링고의 질내를 핥아댔다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%……거기는, 그렇게 함부로 하지 않는 게――」
				CALL HPH_PRINT,@"「아아아앗 후후 후후, 안 돼……! 더러우니까…… 아앗 후후」","W"
			CASE 2
				CALL HPH_PRINT,@"「아앗! 흐윽, 거긴……. 흐읍, 간지러워, 그래서 아앗! 흐윽흐윽」","L"
				PRINTFORMDW 음핵을 핥아지며 링고는 몸을 떨고 있다...!
			CASE 3
				CALL HPH_PRINT,@"「아아...큭! 흐읍 흐읍, 아, 안돼... 그만해줘... 부끄러워...! 응응 큭」","L"
				PRINTFORMDW 링고는 소리를 듣고 싶지 않은 건지, 은밀한 곳을 핥아지는 와중에도 귀를 막고 있다…….
			CASE 4
				CALL HPH_PRINT,@"「응으… 흐읍! 응흐윽... 으응... 하아앗...」","L"
				PRINTFORML (보지라는 거, 그렇게 침 흘리고 싶을 정도의 물건이야?)
				CALL HPH_PRINT,@"(……하지만, 이렇게 열심히 핥아주는 건 기쁠지도…… 후훗)","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
