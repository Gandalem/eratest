	IF LOCAL:1 && SHIRAHU([[百々世]])
		IF FIRSTTIME(SELECTCOM)
			PRINTFORMW 「음... 이게 얼마나 잘 될지는 모르겠어.」
			PRINTFORMW 「내가 주로 후각으로 길을 찾는 거 알잖아?」
			PRINTFORMDW 당신은 %CALLNAME:[[百々世]]%에게 미소 지으며 지난번에 산 코 막개를 %HIM_HER([[百々世]])%에게 보여준다.
			PRINTFORMDW %HE_SHE([[百々世]],1)%도 당신에게 웃어 보인다.
			PRINTFORMW 「젠장, 정말 모든 걸 다 생각하는구나, 응?」
			RETURN 1
		ELSE
			IF TEQUIP:アイマスク
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「이거 훈련에 정말 좋을 것 같아!」
						PRINTFORML 「진동만으로 적의 위치를 파악하는 연습을 할 수 있어! 그리고 난- 히야?!」
						PRINTFORMDW 당신은 참지 못했다. 당신은 \@ HAS_PENIS([[百々世]]) ? %HIS_HER([[百々世]])% 거시기 머리에 # %HIS_HER([[百々世]])% 클리토리스에 로터를 누른다. \@
						PRINTFORMDL %CALLNAME:[[百々世]]%가 웃었다.
						PRINTFORMW 「그런 종류의 진동이 아니야, 이 바보야!」
						PRINTFORMDW %HE_SHE([[百々世]],1)%가 당신을 장난스럽게 밀쳤다.
					CASE 1
						PRINTFORMW 「내가 온몸에서 나오는 열을 집중하면 네 출신이 아직도 느껴진다.」
						PRINTFORMDW %CALLNAME:[[百々世]]%가 비웃는다.
						PRINTFORMW 「그렇게 안 하는 게 더 재밌지 않니?」
					CASE 2
						PRINTFORMDW 한 번 %CALLNAME:[[百々世]]%이 눈가리개를 쓰면, 당신은 %HIS_HER([[百々世]])%의 목에 키스를 한다. 그리고 %HIS_HER([[百々世]])%의 유두 중 하나에 키스를 한다.
						PRINTFORMDW 그리고 %HIS_HER([[百々世]])%의 안쪽 허벅지, 그다음 %HIS_HER([[百々世]])%의 쇄골로...
						PRINTFORMDW 때로는 다음 키스가 당신의 마지막 키스 직후에 오기도 하고, 다른 때는 최대 열 번까지 기다린다.
						PRINTFORMDW 당신이 %CALLNAME:[[百々世]]%을 놀리는 것을 끝낼 때쯤이면, %HE_SHE([[百々世]])%의 \@ HAS_PENIS([[百々世]]) ? 단단하게 서 있다 # 축축하게 젖어있다 \@.
						SIF HAS_PENIS([[百々世]]) && BASE:[[百々世]]:勃起 < 1000
							BASE:MASTER:勃起 = 1000
						SIF HAS_VAGINA([[百々世]]) && PALAM:[[百々世]]:潤滑 < PALAMLV:3
							PALAM:[[百々世]]:潤滑 = PALAMLV:3
				ENDSELECT
			ELSE
				IF FIRSTTIME("MomoyoBlindfoldRemove", 1)
					PRINTFORMW 「와, 농담이 아니었어... 상대방이 뭘 할지 모를 때 섹스가 정말 더 격렬하네!」
					PRINTFORMDW %CALLNAME:[[百々世]]% 깊게 숨을 들이마셨다.
					CALL PRINT_STRL, @"「강렬한 것에 대해 말하자면, 네 향기가 지금 정말 강해졌어. 아니면 네가 ITALIC정말로 흥분했거나...」"
					CALL HPH_PRINT, @"「어느 쪽이든, 그 일은 기꺼이 도와주고 싶어 HPH.」", "W"
					CALLF FIRSTTIME("MomoyoBlindfoldRemove")
					RETURN 1
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW %CALLNAME:[[百々世]]% 벗자마자 한 번 응시한다 미소가 입가에 떠오른다 %HIS_HER([[百々世]])% 입가에 미소가 걸린다.
							PRINTFORMW 「젠장, %CALLNAME:MASTER%내가 그거 하고 있는 동안 변신했어? 역대급으로 섹시해졌네!」
						CASE 1
							PRINTFORML 「아, 당신의 \@ IS_MALE(MASTER) ? 잘생긴 # 아름다운 \@ 얼굴을 다시 보니 정말 좋네요.」
							PRINTFORMW 「특히 당신의 입술이요...」
							PRINTFORMDW %CALLNAME:[[百々世]]% 자신의 입술을 핥고 다문다.
						CASE 2
							PRINTFORMW 「이걸 충분히 하면 내가 정신 감응 능력을 발달시킬 수 있을 거라고 생각하는 거야?」
							PRINTFORMW 「그렇다면 좋겠네. 타마트즈쿠리를 더 쉽게 피할 수 있겠지.」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
