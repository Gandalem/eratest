@M_KOJO_MESSAGE_COM_K142_82
CALL M_KOJO_MESSAGE_COM_K142_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K142_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[百々世]])
		IF FIRSTTIME(SELECTCOM)
			SELECTCASE TALENT:[[百々世]]:バストサイズ
				;Mystifying
				CASE 4
					PRINTFORMW 「야, 이 년들은 네 몸 전체를 그 사이에 넣을 수 있을 만큼 크다고.」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 당신을 위한 공간을 만들기 위해 %HIS_HER([[百々世]])%의 거대한 가슴을 조절한다.
					PRINTFORMW 「끼면 말해줘, 알았지?」
					;Gigantic
				CASE 3
					PRINTFORMW 「우선 우리가 이걸 어떻게 할지 알아내야 해.」
					PRINTFORMW 「난 내 가슴을 네 무릎 위에 올리고 싶지 않아... 뭔가를 부술 수도 있잖아.」
					PRINTFORMW 「내가 옆으로 누우면 네가 그곳에 박아줄 수 있을까?」
					;Huge
				CASE 2
					PRINTFORMW 「정말? 그 사이에서 길을 잃을지도 몰라...」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 웃으며 %HE_SHE([[百々世]])%가 거대한 가슴 %HIS_HER([[百々世]])%를 들어 당신의 무릎 위에 내려놓는다.
					;Big
				CASE 1
					PRINTFORMW 「내 가슴 사이에 넣고 싶어, 응?」
					PRINTFORMDW %CALLNAME:[[百々世]]%이(가) 네 발기된 성기의 양쪽에 큰 가슴을 배치한다.
					PRINTFORMW 「너무 세게 조이면 말해줘, 알았지? 여기에서 '남성 샌드위치' 만들려고 하는 거 아니니까.」
					;Normal
				CASE 0
					PRINTFORMW 「좋아.」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) %HIS_HER([[百々世]])%의 가슴을 당신의 무릎 위에 놓고 그 사이로 당신의 성기를 움켜쥔다.
					PRINTFORMW 「위에서 아래로, 혹은 옆으로 비벼볼까...?」
					PRINTFORMDW %HIS_HER([[百々世]],1)%의 미소가 넓어진다.
					PRINTFORMW 「아니면 그냥 여러 가지 다른 걸 시도해보고 당신이 뭘 가장 좋아하는지 볼지도 모르겠네.」
					PRINTFORMW 「"새로운 것을 시도하는 것을 두려워하지 마", 그게 내 모토야.」
					;Small
				CASE -1
					PRINTFORMW 「이게 얼마나 잘 될지 모르겠네... 내 애들은 좀 작은 편이라.」
					PRINTFORMW 「젠장, 내 가슴 근육 쪽이 더 클지도...」
					PRINTFORMW 「하지만 최선을 다할 거야. 오오무카데는 도전을 거부하지 않아!」
					PRINTFORMDW 음... 어쩌면 %HIM_HER([[百々世]])%에게 다른, 좀 더 기묘한 것들을 시도해 볼 수도 있겠네...
					;Flat
				CASE -2
					PRINTFORMDW %CALLNAME:[[百々世]]%는 미간을 찌푸린다.
					PRINTFORMW 「농담하는 거지?」
					PRINTFORMDW %HE_SHE([[百々世]],1)%가 %HIS_HER([[百々世]])% 평평한 가슴을 내민다.
					PRINTFORMW 「나 좀 봐! 내 가슴은 곡괭이 손잡이보다 매끈하단 말이야!」
					PRINTFORMW 「뭐 할 거야, 내 유두에 네 거 비빌 거야?」
					PRINTFORMDW 사실...
					PRINTFORMDW %CALLNAME:[[百々世]]%가 코웃음 친다.
					PRINTFORMW 「내가 농담한 거 알잖아, 그렇지?」
					PRINTFORMDW %HE_SHE([[百々世]],1)%가 %HIS_HER([[百々世]])% 팔짱을 낀다.
					PRINTFORMW 「정말 괜찮아?」
					PRINTFORMDW 당신은 고개를 끄덕인다.
					PRINTFORMW 「좋아, 알았어. 하지만 네가 사정 안 하면 나 경고했잖아라고 하지 마.」
			ENDSELECT
		ELSE
			SELECTCASE TALENT:TARGET:バストサイズ
				;Mystifying
				CASE 4
					IF ABL:TARGET:胸 >= 5
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
					ELSEIF ABL:TARGET:胸 >= 3
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
					ELSEIF ABL:TARGET:胸 >= 1
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMDW %CALLNAME:[[百々世]]% 그저 당신이 %HIS_HER([[百々世]])% 거대한 가슴속으로 파고들 때 어색하게 서 있을 뿐이다.
								CASE 1
									PRINTFORMW 「안에 괜찮아? 끼인 거 아니지?」
									PRINTFORMDW %CALLNAME:[[百々世]]%의 괴물 같은 가슴골에서 손을 뻗어 엄지손가락을 치켜세운다.
									PRINTFORMW 「좋네. 내가 경험상 동굴 탐험하다가 빠지는 게 얼마나 쉬운 건지 알거든..」
								CASE 2
									PRINTFORMW 「거기서 멋진 거라도 찾을 수 있겠어? 나는 가슴골에 늘 물건들을 잃어버리거든.」
							ENDSELECT
						ENDIF
					ENDIF
					;Gigantic
				CASE 3
					IF ABL:TARGET:胸 >= 5
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
					ELSEIF ABL:TARGET:胸 >= 3
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
					ELSEIF ABL:TARGET:胸 >= 1
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
					ENDIF
					;Big/Huge
				CASE 1, 2
					IF ABL:TARGET:胸 >= 5
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
					ELSEIF ABL:TARGET:胸 >= 3
						IF NOWEX:MASTER:射精
						ELSE
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						ENDIF
