@M_KOJO_MESSAGE_COM_K142_81
CALL M_KOJO_MESSAGE_COM_K142_81_1
CALL K142_SALIVA_NUMBING(5)
RETURN RESULT

@M_KOJO_MESSAGE_COM_K142_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;First time
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[百々世]])
		IF FIRSTTIME(SELECTCOM)
			PRINTFORMW 「으음... 이거 잘 모르겠어, %CALLNAME:MASTER%.」
			PRINTFORMW 「내 독이 네 피부에 상처를 내지 않더라도... 이 송곳니들 보여?」
			PRINTFORMDW %CALLNAME:[[百々世]]%는 강조하기 위해 %HIS_HER([[百々世]])%의 이를 드러낸다.
			PRINTFORMW 「피부를 벗겨버릴지도 몰라. 아니면 더 나쁜 걸...」
			PRINTFORMW 「...좋아, 알겠어. 네가 거절을 받아들이지 않는 것 같네.」
			PRINTFORMW 「그럼 정말 조심해야겠구나...」
		ELSE
			IF ABL:[[百々世]]:Ｍ感覚 >= 5
				IF NOWEX:MASTER:射精
					PRINTFORML 「Mm?」
					PRINTFORMDW %CALLNAME:[[百々世]]%이(가) %HIS_HER([[百々世]])%의 머리를 뒤로 당긴다.
					PRINTFORMW 「뭔가 짜다. 사정할 거냐?」
					PRINTFORMDL %HE_SHE([[百々世]],1)%이(가) 미소 짓는다.
					PRINTFORMW 「대망의 피날레 시간이다...」
					PRINTFORMDL %CALLNAME:[[百々世]]%이(가) 당신의 성기를 %HIS_HER([[百々世]])%의 입에 넣고 %HIS_HER([[百々世]])%의 머리를 원을 그리며 움직이기 시작한다.
					PRINTFORMDW %HIS_HER([[百々世]],1)%의 혀가 %HE_SHE([[百々世]])%가 움직이는 동안 당신의 성기 밑면을 스친다.
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW %CALLNAME:[[百々世]]%은 옆으로 몸을 옮겨 당신의 온몸을 애무하며 성기 끝을 핥는다.
						CASE 1
							PRINTFORMDL %CALLNAME:[[百々世]]%은 네 사타구니를 어루만지며 네 성기 머리를 핥는다.
							PRINTFORMDW 먼저 네 고환을, 그리고 %HE_SHE([[百々世]])%는 네 성기로 위로 이동하여 %HE_SHE([[百々世]])%가 %HIS_HER([[百々世]])%까지 올라갈 때 앞뒤로 비빈다.
						CASE 2
							PRINTFORMDL %CALLNAME:[[百々世]]% 구부리며 %HIS_HER([[百々世]])% 입술을 올리며 %HIS_HER([[百々世]])% 이빨 위로 입술을 구기며 네 거에 위아래로 흔들기 시작한다.
							PRINTFORMDW %HE_SHE([[百々世]],1)% 천천히 움직이며 당신을 긁지 않도록 주의하고 당신의 거시기를 핥아대며 %HIS_HER([[百々世]])% 혀로 %HE_SHE([[百々世]])% 위아래로 움직인다.
					ENDSELECT
				ENDIF
			ELSEIF ABL:[[百々世]]:Ｍ感覚 >= 5
				IF NOWEX:MASTER:射精
					PRINTFORML 「Mm?」
					PRINTFORMDW %CALLNAME:[[百々世]]%이(가) %HIS_HER([[百々世]])%의 머리를 뒤로 잡아당긴다.
					PRINTFORMW 「뭔가 짜다. 사정할 거냐?」
					PRINTFORMDL %HE_SHE([[百々世]],1)%이(가) 미소 짓는다.
					PRINTFORMW 「좋군. 내 안전한 블로우잡 방법들이 통했나 보네.」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「%CALLNAME:[[百々世]]%이 당신을 %HIS_HER([[百々世]])%의 입속으로 데려가고, %HIS_HER([[百々世]])%의 입술을 %HIS_HER([[百々世]])%의 이 위로 말아 올리며, 조심스럽게 당신의 성기 머리를 빨기 시작한다.」
						CASE 1
							PRINTFORMDL %CALLNAME:[[百々世]]%은(는) %HIS_HER([[百々世]])%의 머리를 네 성기 높이에 맞출 때까지 숙인다.
							PRINTFORMDW 그런 다음 %HE_SHE([[百々世]])%이 밑부분부터 끝까지 천천히 핥기 시작한다.
							PRINTFORMDW %HE_SHE([[百々世]],1)%는 아래에서 내려다보며 네 성기 머리 주위를 %HIS_HER([[百々世]])%의 혀로 돌리는 것을 확실히 한다.
						CASE 2
							PRINTFORMDW 너는 %CALLNAME:[[百々世]]%이 네 거시기 샤프트를 비비며 그 머리를 핥는다.
					ENDSELECT
				ENDIF
			ELSE
				IF NOWEX:MASTER:射精
					PRINTFORMW (이제 그만 끝내고 다른 걸 하자.)
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW %CALLNAME:[[百々世]]%가 어색하게 네 성기 끝을 핥는다.
						CASE 1
							PRINTFORMW (이빨에 크라운을 씌워야 할지 궁금하다. 그러면 바로 %HIM_HER(MASTER)%를 빨 수 있을 텐데...)
						CASE 2
							PRINTFORML 「대신 나한테 자위하게 해달라는 거야?」
							SIF TALENT:[[百々世]]:バストサイズ > -2
								PRINTFORMW 「아니면 내 가슴을 써도 돼. 뭐, 상관없어.」
							PRINTFORMW 「이거 안 되는 것 같은데....」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
