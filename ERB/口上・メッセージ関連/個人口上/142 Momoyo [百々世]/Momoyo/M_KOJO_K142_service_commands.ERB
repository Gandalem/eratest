@M_KOJO_MESSAGE_COM_K142_80
CALL M_KOJO_MESSAGE_COM_K142_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K142_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[百々世]])
		IF FIRSTTIME(SELECTCOM)
			PRINTFORMDW %CALLNAME:[[百々世]]% 당신의 페니스를 %HIS_HER([[百々世]])% 손에 넣고 몇 번 문지른다.
			PRINTFORMW 「어때? 너무 세게 조이지는 않지, 그렇지?」
			PRINTFORMW 「나는 피크를 잡는 게 더 익숙해서...」
		ELSE
			IF ABL:[[百々世]]:指 >= 5
				IF NOWEX:MASTER:射精
					PRINTFORMDW %CALLNAME:[[百々世]]% 그녀가 당신의 샤프트를 한 번 세게 움켜쥐고 %HE_SHE([[百々世]])% 프리컴이 ~에 분출되는 것을 느끼다 %HIS_HER([[百々世]])% 손에
					PRINTFORML 「미안하지만 %CALLNAME:MASTER%하지만 아직 너 오게 안 놔줄 거야.」
					PRINTFORML 「계속 박을 거야 네가 화산 폭발이 일어날 때까지!」
					PRINTFORMW 「그러고 나서는 그것으로 내 얼굴을 칠 수 있는지 보고 싶어~」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW %CALLNAME:[[百々世]]%은 당신의 고환을 부드럽게 어루만지는 동안 %HE_SHE([[百々世]])%는 당신의 성기를 가지고 논다.
							PRINTFORMW 「좋아해? 그렇게 하면 기분이 좋다고 들었어」
						CASE 1
							PRINTFORMDL %CALLNAME:[[百々世]]% 네 거시기 머리를 비비면서 %HE_SHE([[百々世]])% 너를 자극한다 %HIS_HER([[百々世]])% 다른 손으로
							PRINTFORMW 「그 느낌 어때?」
						CASE 2
							PRINTFORML 「거의 다 왔어? 갈 때 알려줘, 알겠지?」
							PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 입술을 %HIS_HER([[百々世]])%핥는다.
							CALL HPH_PRINT, @"「네 것의 한 방울도 놓치고 싶지 않아... HPH」", "W"
					ENDSELECT
				ENDIF
			ELSEIF ABL:[[百々世]]:指 >= 3
				IF NOWEX:MASTER:射精
					PRINTFORMDW %CALLNAME:[[百々世]]%이 조금 빨라진다 %HE_SHE([[百々世]])%가 정액이 %HIS_HER([[百々世]])%의 손에 튀는 것을 느끼면서.
					PRINTFORML 「걱정 마, 그냥 살짝 놀려줄 뿐이야.」
					PRINTFORMW 「게다가, 네가 가능한 한 세게 사정하길 바라...」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「음... 윤활제가 좀 더 있으면 좋을 텐데.」
							PRINTFORMDL %CALLNAME:[[百々世]]%은(는) %HIS_HER([[百々世]])%의 손을 내민다.
							PRINTFORMW 「나한테 침이라도 뿌려줄래? 독액 쓰는 건 싫거든.」
						CASE 1
							PRINTFORMDW %CALLNAME:[[百々世]]% 비튼다 %HIS_HER([[百々世]])% 손을 당신의 샤프트를 감싸며 %HE_SHE([[百々世]])% 그것을 비비며
						CASE 2
							PRINTFORMDL %CALLNAME:[[百々世]]%이 속도를 변화시키기 시작한다.
							PRINTFORMDW %HE_SHE([[百々世]],1)%가 당신의 반응을 보기 위해 얼굴을 지켜본다.
					ENDSELECT
				ENDIF
			ELSE
				IF NOWEX:MASTER:射精
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) %HE_SHE([[百々世]])%가 %HIS_HER([[百々世]])%의 손에 약간의 전립액이 튀자 빨라진다.
					PRINTFORMW 「거의 다 왔어? 좋아, 전력을 다할 시간이야!」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDL %CALLNAME:[[百々世]]%은 천천히 너의 거시기를 쓸어내린다.
							PRINTFORMDW %HES_SHES([[百々世]],1)%이 그것을 너무 느슨하게 들고 있다.
						CASE 1
							PRINTFORMW 「내가 이거 제대로 하고 있는 건가?」
						CASE 2
							PRINTFORMW 「내 손이 너무 거칠지는 않기를...」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
