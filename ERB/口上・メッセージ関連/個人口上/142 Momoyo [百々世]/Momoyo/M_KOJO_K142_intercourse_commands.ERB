	CALL K142_AMAZON_PRESS_CHOICE()
	IF CFLAG:[[百々世]]:K142EN_AMAZON_PRESS_ON
		IF ABL:[[百々世]]:腰 >= 5
			IF NOWEX:MASTER:射精
				PRINTFORML 「오? 절정에 이를 거니?」
				PRINTFORMDW %CALLNAME:[[百々世]]%이(가) %HIS_HER([[百々世]])%의 허리를 한 번 더 들어 올린다.
				CALL HPH_PRINT, @"「그럼 준비해. 내가 이 골반을 다시 내릴 때, 네가 다 비울 때까지 멈추지 않을 테니까 HPH」", "W"
			ELSE
				SELECTCASE RAND:3
					CASE 0
					CASE 1
					CASE 2
				ENDSELECT
			ENDIF
		ELSEIF ABL:[[百々世]]:腰 >= 3
			IF NOWEX:MASTER:射精
			ELSE
				SELECTCASE RAND:3
					CASE 0
					CASE 1
					CASE 2
				ENDSELECT
			ENDIF
