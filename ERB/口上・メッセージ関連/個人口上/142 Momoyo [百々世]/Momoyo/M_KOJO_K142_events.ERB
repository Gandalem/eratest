				ENDIF
				PRINTFORMDW %CALLNAME:139%이 숨을 헐떡이며 %HIS_HER(139)%의 손으로 %HIS_HER(139)%의 입을 막는다.
				IF TALENT:[[百々世]]:恋人
					CALL CHARA_TEXT(139,@"「%CALLNAME:[[百々世]]%-도노! 내가 당신의 %PRINT_MALE("boy", MASTER)% 친구를 빼앗으려 한다는 뜻인가?!」", "l")
					CALL CHARA_TEXT(139,@"「절대 안 돼! 나를 믿지 못한다는 거야, 네 직장 동료로서?」", "w")
