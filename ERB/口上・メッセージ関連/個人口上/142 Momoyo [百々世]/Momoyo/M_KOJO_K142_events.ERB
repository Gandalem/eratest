@M_KOJO_SPEVENT_K142_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;Confession
	;After this dialogue is displayed, the player will have a choice to become the character's lover or turn them down.
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF FIRSTTIME("MomoyoConfesses")
			PRINTFORMW 「이봐, %CALLNAME:MASTER%? 저 나무 옆에 서 줄 수 있어? 아니, 등을 돌린 채로... 응, 완벽해.」
			PRINTFORMDW %CALLNAME:[[百々世]]%는 뭘 하고 있는 거야?
			PRINTFORMDW %HIS_HER([[百々世]],1)%평소의 거만한 미소가 사라졌다. 너를 처음 만난 이후로 %HIM_HER([[百々世]])%, %HE_SHE([[百々世]])%가 긴장한 것처럼 보인다.
			PRINTFORMDW 더 최악의 추파 시도를 예상하며 몸을 단단히 한다.
			PRINTFORMDW 하지만 그녀는 아무 말도 하지 않고, 아무것도 하지 않는다. 그저 거칠게 숨을 몰아쉬며 서 있을 뿐이다.
			PRINTFORMDW 데이트 후 집으로 돌아가려던 참에...
			PRINTFORMDW 퍼덕!
			PRINTFORMDW %CALLNAME:[[百々世]]%는 나무로 다가가 %HIS_HER([[百々世]])%의 손바닥을 그 나무에 내리쳤다. %HE_SHE([[百々世]],1)%는 너무 세게 때려서 나무 전체가 흔들릴 정도였다.
			SIF IS_FEMALE([[百々世]])
				PRINTFORMW 「아주 아가씨답지는 않겠지만... 난 별로 아가씨 같은 편이 아니잖아?」
			PRINTFORMDW %CALLNAME:[[百々世]]% 삼킨다. %HE_SHE([[百々世]],1)%충분히 가까워서 느낄 수 있는 %HIS_HER([[百々世]])% 얼굴에 닿는 뜨거운 숨결을.
			PRINTFORMW 「%CALLNAME:MASTER%... 내가 너 좋아하게 된 이후로 계속 너한테 들이고 있었어.」
			PRINTFORMW 「나는 네가 나를 좋아한다면 알아채고 나에게 맞춰주길 바랐어.」
			PRINTFORMW 「하지만 어떤 이유에서인지, 너는 나에게 혼란스러운 메시지들을 계속 주었어.」
			PRINTFORMW 「내가 너한테 작업 걸고 있었던 건 눈치채지 못한 것 같아, 그런데 계속 나랑 데이트를 하고 그랬잖아...」
			PRINTFORMDW 너는 침묵을 지킨다. 분위기를 망치고 %HIM_HER([[百々世]])% 그녀의 플러팅 시도가 얼마나 오글거렸는지
			PRINTFORMDW 특히 ~일 때 %HES_SHES([[百々世]])% 너에게 고백하는 도중에
			PRINTFORMW 「하지만 상관없어. 그냥 나가서 말해버릴 거야.」
			PRINTFORMDW %HE_SHE([[百々世]],1)%은 %HE_SHE([[百々世]])%가 말을 이어가기 전에 초조하게 미소 짓는다.
			PRINTFORMW 「%CALLNAME:MASTER%... 너는 나의 첫 번째... 모든 것이었다.」
			PRINTFORMW 「내가 데이트했던 첫 번째 사람. 내가 키스한 첫 번째 사람이었다.」
			SIF CFLAG:[[百々世]]:既成事実 & 合意_うふふ && CFLAG:[[百々世]]:K142EN_STARTING_VIRGINITY && !THINKS_IS_VIRGIN([[百々世]])
				PRINTFORMW 「그리고 응, 내가 처음으로 섹스한 사람이.」
			PRINTFORMW 「So, %CALLNAME:MASTER%...」
			PRINTFORMDW %CALLNAME:[[百々世]]%은 깊게 숨을 들이마시고 내쉰다. %HE_SHE([[百々世]],1)%는 지금 미친 듯이 얼굴을 붉히고 있다.
			PRINTFORMW 「너는 ... 나의 첫 번째 %PRINT_MALE("boy", MASTER)%친구도 되어줄래?」
		ELSE
			PRINTFORMW 「있잖아, 음... 난 아직 너 좋아해, 알지.」
			PRINTFORMW 「그리고 나 이제 화장 진짜 잘하게 됐어!」
			PRINTFORMDW %CALLNAME:[[百々世]]%이(가) 당신에게 속눈썹을 떨었다 %HIS_HER([[百々世]])%.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Confession accepted (player and character become lovers)
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDW %CALLNAME:[[百々世]]%은 잠시 너를 응시한다.
		PRINTFORMDW 그러자 %HE_SHE([[百々世]])% 웃음을 터뜨리고 앞으로 나서서 당신을 껴안는다.
		PRINTFORMW 「%CALLNAME:MASTER%...」
		PRINTFORMDW 볼에 무언가 축축한 것이 느껴진다. %HE_SHE([[百々世]])%이 울고 있는 걸까?
		PRINTFORMDW %HE_SHE([[百々世]],1)%은(는) 당신을 놓아주고, %HIM_HER([[百々世]])%의 눈물을 닦으며 미소 짓는다.
		PRINTFORMW 「오만, 내가 이 세계에서 가장 행복한 오무카데일지도 몰라...」
		PRINTFORMDW %HE_SHE([[百々世]],1)%은(는) 당신의 손을 잡고 꽉 쥔다.
		PRINTFORMW 「그럼... 내 집으로 돌아갈래?」
		PRINTFORMW 「특별한 날을 위해 아껴뒀던 최고급 사케가 있는데, 이보다 더 특별한 건 생각나지 않아!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Confession rejected
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「...Oh.」
		PRINTFORMDW %CALLNAME:[[百々世]]%의 표정이 어두워진다.
		PRINTFORMW (화장하는 법을 배워둘 걸...)
		PRINTFORMDW %HE_SHE([[百々世]],1)%는 당신에게서 물러나 %HIS_HER([[百々世]])% 시선을 피한다.
		PRINTFORMDW 어색한 침묵 끝에, 당신은 집으로 향하기 시작한다.
		PRINTFORMDW %CALLNAME:[[百々世]]%는 생각에 잠긴 듯 보이지만, %HE_SHE([[百々世]])%가 당신이 사라진 것을 알아채자, %HE_SHE([[百々世]])%는 당신을 따라 달려온다.
		PRINTFORMDW 돌아오는 길에 작은 대화를 시도하지만, %CALLNAME:[[百々世]]%는 한 단어나 침묵으로만 응답한다.
		PRINTFORMDW %HE_SHE([[百々世]],1)%는 생각에 잠긴 듯하다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;Returning home from a date
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K142_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;Standard dialogue
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:[[百々世]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「나의 멋진 %PRINT_MALE("boy", MASTER)%친구와 또 다른 멋진 데이트를 했다.」
					PRINTFORMDW %CALLNAME:[[百々世]]%는 웃으며 당신의 등을 토닥인다.
				CASE 1
					PRINTFORML 「헤이, 나한테 잘 자는 키스 해줄 거 아니야?」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) %HIS_HER([[百々世]])% 입술을 핥는다.
				CASE 2
					PRINTFORML 「헤이... 돌아가기 전에, 우리 집에 와서 사케 한 병 같이 마실래?」
					CALL HPH_PRINT, @"「어쩌면 다른 것도 좀 할 수도 있어 「HPH」」", "W"
			ENDSELECT
		ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「젠장, 벌써 끝이야?」
					PRINTFORMW 「너랑 같이 있으면 시간 정말 빨리 가네.」
				CASE 1
					IF TALENT:[[百々世]]:恋慕
						PRINTFORML 「있잖아, 돌아가기 전에 너 혹시-」
						PRINTFORMW 「...됐어. 나중에 봐!」
					ELSE
						PRINTFORML 「헤이, 돌아가기 전에 잠깐 시간 있는 것 같아.」
						PRINTFORMW 「할래?」
					ENDIF
				CASE 2
					PRINTFORML 「정말 즐거웠어! 다음에 또 같이 하자.」
					PRINTFORMW 「그리고 뭐, 끝나고 뭔가 좀 더 할까~?」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 눈을 찡긋하며 너에게 손가락 총을 한다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「정말 재미있었어!」
					PRINTFORMW 「넌 정말 %PRINT_MALE("guy", TARGET)%에게 즐거운 시간을 보내는 법을 잘 아네.」
					PRINTFORMDW %CALLNAME:[[百々世]]%가 윙크한다.
				CASE 1
					PRINTFORML 「젠장... 너무 재미있어서 얼마나 늦었는지 몰랐네.」
					PRINTFORMDW %CALLNAME:[[百々世]]% 미간을 찌푸렸다.
					PRINTFORML 「빨리 잠 좀 자야겠어.」
				CASE 2
					PRINTFORML 「이제 너를 어딘가 데려다줘야겠어. 안 해주는 건 불명예지.」
					PRINTFORMW 「세입자... 요괴산에 정말 좋은 레스토랑이 있는데, 아니면 %CALLNAME:57%-씨 공연을 보러 갈 수도 있고...」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Hate Mark 1 removed
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「음, 네가 잘 행동했으니 용서해 줄게.」
		PRINTFORMW 「하지만 다시는 그러지 마! 내 어머니의 무덤에 맹세하건대, 다음엔 내가 너한테 기분 나빠지는 일 있으면 오오무카데 방식으로 끝장낼 테니까!」
		PRINTFORMDW %CALLNAME:[[百々世]]%은 주먹을 쥐고 강조하며 %HIS_HER([[百々世]])%의 손바닥을 때린다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Hate Mark 2 removed (changes to Hate Mark 1)
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「조금 더 아첨했어야 했는데... 하지만 충분히 존중을 보여준 것 같네.」
		PRINTFORMW 「그래도 아직 완전히 용서한 건 아니지만.」
		PRINTFORMW 「또 다른 오우무카데(oomukade)가 아닌 게 다행이야. 내 명예를 되갚으려면 이빨 몇 개를 부러뜨려야 했을 테니.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Hate Mark 3 removed (changes to Hate Mark 2)
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「흥.」
		PRINTFORMDW %CALLNAME:[[百々世]]% 당신을 노려본다.
		PRINTFORMW 「이제 가볍게 때리는 건 봐줄 수 있겠지.」
		PRINTFORMW 「어떤 팔(혹은 사지)을 부러뜨리지 않기를 원하는 거지?」
