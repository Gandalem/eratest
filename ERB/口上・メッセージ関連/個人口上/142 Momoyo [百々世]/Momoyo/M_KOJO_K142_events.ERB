			CALL CHARA_TEXT(139,@"「%CALLNAME:MASTER%-씨, 산 주변을 걸으러 가지 않을래요? 그때쯤이면 %CALLNAME:[[百々世]]%-님은 일을 끝냈을 거예요.」", "w")
			CALL CHARA_TEXT(139,@"「만약 %HE_SHE([[百々世]])%이 아니라면, 우리가 방문할 수 있는 멋진 바가 있잖아.」", "w")
