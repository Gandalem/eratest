					PRINTFORMDL %CALLNAME:[[百々世]]%은 또 다른 최악의 멘트를 생각해내려고 노력하는 듯하다.
					PRINTFORMDW 다행히 너는 ~하기 전에 %HE_SHE([[百々世]])% 하나를 생각해내기 전에
				CASE 1
					CALL PRINT_STRW, @"「네가 떠나는 걸 지켜보는 게 싫지만, 나는 네가 가는 걸 ITALIC사랑한다~」"
					PRINTFORMW 「...아니면 그 반대였던 걸까?」
				CASE 2
					PRINTFORMW 「헤이 거기~」
					PRINTFORMDW %CALLNAME:[[百々世]]%가 유혹적으로 눈을 윙크한다.
				CASE 3
					PRINTFORMW 「저기, 가기 전에... 너 줄 꽃 좀 가져왔어!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW %CALLNAME:[[百々世]]%가 너에게 손을 흔든다.
				CASE 1
					PRINTFORMW 「나중에 봐, %CALLNAME:MASTER%!」
				CASE 2
					PRINTFORMW 「그래서 어디로 갔던 거야?」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Ignore and keep moving
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF IN_HEAT([[百々世]])
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「흐, 저 좀 봐줘...!」
				CASE 1
					PRINTFORMDW 당신이 지나간 후 %CALLNAME:[[百々世]]%이 걷기 시작하고... 그러자 %HE_SHE([[百々世]])%가 고개를 흔들며 돌아간다 %HIS_HER([[百々世]])%.
				CASE 2
					PRINTFORMW (%HE_SHE(MASTER)%은 내가 발정 중인 걸 못 맡을까?!)
			ENDSELECT
		ELSEIF MARK:[[百々世]]:反発刻印 > 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「너도 똑같이 당해라, 친구야!」
				CASE 1
					PRINTFORMW 「%CALLNAME:[[百々世]]%은(는) 당신을 노려보며 %HIS_HER([[百々世]])% 속으로 무언가 중얼거린다.」
				CASE 2
					PRINTFORMW 「난 아직 사과를 기다리고 있어!」
			ENDSELECT
		ELSEIF TALENT:[[百々世]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW (내가 %HIM_HER(MASTER)%을 짜증나게 한 건가?)
				CASE 1
					PRINTFORML 「이봐, 나 여기 있어! 있잖아, 나 말이야?」
					PRINTFORMW 「%CALLNAME:[[百々世]]%? 너의 %PRINT_MALE("boy", [[百々世]])% 친구?」
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%? 나한테 화났으면 그냥 말해줘!」
					PRINTFORMW 「날 무시하지 마...」
			ENDSELECT
		ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「아니야, %CALLNAME:MASTER%, 그러지 마...」
				CASE 1
					PRINTFORMW (화장을 더 했어야 했는데...)
				CASE 2
					PRINTFORMW 「있잖아, 나 여기 있잖아?」
			ENDSELECT
		ELSEIF TALENT:[[百々世]]:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「뭐야, 인사도 안 해 줄 거야? 무례하네!」
				CASE 1
					PRINTFORMW 「어떤 친구로군...」
				CASE 2
					PRINTFORMW 「이봐! 나 무시하지 마!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「%CALLNAME:[[百々世]]%이(가)%HIS_HER([[百々世]])%을 지나쳐 걸어가자 %HIM_HER([[百々世]])%가 목을 가다듬는다.」
				CASE 1
					PRINTFORMW 「어... 나 여기 있어...」
				CASE 2
					CALL PRINT_STRW, @"(ITALIC에게 무슨 문제라도 있나?)"
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
