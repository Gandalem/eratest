@M_KOJO_MESSAGE_COUNTER_K142_1
CALL M_KOJO_MESSAGE_COUNTER_K142_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K142_1_1
IF TALENT:[[百々世]]:恋人
	SELECTCASE RAND:3
		CASE 0
			CALL HPH_PRINT, @"「흐음 흐음... 가까이서 보니 더 귀엽군, HPH」", "L"
		CASE 1
			PRINTFORML 「내 시야가 제일 좋지 않아서 너를 더 잘 보고 싶었어.」
			PRINTFORML 「그리고 아마 네 엉덩이를 좀 잡고 싶을지도 모르지...」
		CASE 2
			PRINTFORML 「있잖아, 자기들 파트너한테 물어서 소유권을 알리는 상처를 남기는 거야.」
			PRINTFORML 「어쩌면 내가 너한테 입맞춤을 해주거나-」
			PRINTFORML 「알았어, 진정해! 대신 키스 자국을 남겨줄게!」
	ENDSELECT
ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 조금만 더 가까이 다가오면 더 잘 맡을 수 있겠어...
		CASE 1
			PRINTFORML 「잘 보이지 않으니까, 네 모습을 제대로 보려면 가까이 가야겠다.」
			PRINTFORMDL %CALLNAME:[[百々世]]% "우연히" 스친다 %HIS_HER([[百々世]])% 엉덩이에 손이 스치다.
		CASE 2
			PRINTFORML 「겐소쿄는 위험한 곳이야, 알지!」
			CALL HPH_PRINT, @"「그리고 난 나 자신을 더럽히면서 너 같은 귀여운 애가 다치게 할 위험을 감수하지 않을 거야 HPH」", "L"
	ENDSELECT
ELSE
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML (가까워질수록 내 얼굴은 더 붉어진다...)
			PRINTFORML (%PRINT_MALE("guy", MASTER)%이 뭐야?)
		CASE 1
			PRINTFORML 「어? 너무 가까워?」
			PRINTFORML 「미안해.」
			PRINTFORMDL %CALLNAME:[[百々世]]% 너에게서 멀어진다. %HE_SHE([[百々世]],1)% 약간 당황한 듯 보인다.
		CASE 2
			PRINTFORML (젠장, %HES_SHES(MASTER)%은 근육이 좀 있네.)
			PRINTFORML (%HE_SHE(MASTER)%랑 스파링하면 재밌을 것 같아...)
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;Gaze ("You can feel CHARACTER's glances...")
;チラ見
;==================================================

@M_KOJO_MESSAGE_COUNTER_K142_2
CALL M_KOJO_MESSAGE_COUNTER_K142_2_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K142_2_1
IF TALENT:[[百々世]]:恋人
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「너를 바라보고 동시에 냄새 맡는 게 정말 이상해.」
			PRINTFORML 「마치 한 번에 너의 두 버전을 맡고 있는 것 같아...」
		CASE 1
			PRINTFORML 「음... 정말이야?」
			PRINTFORMDL %CALLNAME:[[百々世]]%은 네 말을 듣는 척하면서 %HE_SHE([[百々世]])%는 네 입술을 응시한다.
		CASE 2
			PRINTFORML 「젠장, %CALLNAME:MASTER%… 네 향보다 더 멋있을지도 모르겠어.」
			PRINTFORML 「그건 뭔가 대단하다는 뜻이지.」
	ENDSELECT
ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「젠장, 너를 더 잘 볼 수 있도록 시력이 좋았으면 좋겠군.」
			PRINTFORML 「안경이 도움이 될 것 같아?」
		CASE 1
			PRINTFORMDL %CALLNAME:[[百々世]]%이 너를 강렬하게 응시하고 있다. 좀 소름 끼친다.
			PRINTFORMDL 그리고 %HIS_HER([[百々世]])%의 게으른 미소가 도움이 되지 않는다...
		CASE 2
			PRINTFORML (%HE_SHE([[百々世]])%은(는) 홍조를 띠고 있나? %HE_SHE(MASTER,1)%에게서 특별한 냄새도 나지 않는군...)
			PRINTFORML (어쩌면 또 다른 작업 걸 말을 던져야 할지도 모르겠어.)
	ENDSELECT
ELSE
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML (젠장, 이 시점에서는 %HIM_HER(MASTER)%을 보기만 해도 알 수 있을 것 같다.)
			PRINTFORML (%HIM_HER(MASTER)%의 냄새를 맡을 필요도 없다.)
			PRINTFORML (어쨌든 이 %PRINT_MALE("guy", MASTER)%에 내가 그렇게 매료된 이유는 뭘까?)
		CASE 1
			PRINTFORML (젠장, 저건 정말 예쁜 입술이군.)
			PRINTFORML (나는 \@ CFLAG:[[百々世]]:既成事実 & 合意_キス ? 다른 걸 # 무엇을 \@ %HE_SHE(MASTER)%로 할 수 있을지 궁금하다...)
		CASE 2
			PRINTFORML 「나, 너 쳐다보고 있었던 거 아니야! 그냥... 쳐다봤을 뿐이라고!」
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;Chat ("CHARACTER tells you a story/talks with you for a while")
;おはなし
;==================================================

@M_KOJO_MESSAGE_COUNTER_K142_3
CALL M_KOJO_MESSAGE_COUNTER_K142_3_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K142_3_1
IF TALENT:[[百々世]]:恋人
	SELECTCASE RAND:3
		CASE 0
			PRINTFORMDL %CALLNAME:[[百々世]]%은 배를 잡고 웃으며 너의 등을 툭 친다.
			PRINTFORML 「나도 알지, 안 그래?」
			PRINTFORML 「나는 다른 누구에게도 말한 적이 없는데... 만약 너의 %PRINT_MALE("boy", MASTER)%친구에게조차 말할 수 없다면, 누구에게 말할 수 있겠니?」
		CASE 1
			PRINTFORML 「...그 이야기는 히메무시 가문 대대로 내려온 지... 오, 몇십만 년이나 됐다고?」
			PRINTFORMDL %CALLNAME:[[百々世]]% 빙긋 웃었다.
			PRINTFORML 「언젠가 우리 아이들에게 물려줄지도 모르지...」
		CASE 2
			PRINTFORMDL 나는 언제나 당신이 바깥세상에 대해 이야기하는 것을 듣는 것이 연모다.
			PRINTFORMDL 언젠가 우리를 데리고 여행을 가도록 야쿠모에게 뇌물을 줄 수 있을지 궁금하다?
	ENDSELECT
ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「...내가 말했듯이 동굴은 잔인하다, %CALLNAME:MASTER%.」
			PRINTFORML 「하지만 나는 미니(Minin)를 사랑한다.」
		CASE 1
			PRINTFORML 「...착지할 때 거리를 잘못 판단해서 두 다리 모두 부러뜨렸다.」
			PRINTFORML 「발버둥쳐서 빠져나와야 했다.」
			PRINTFORMDL %CALLNAME:[[百々世]]%은(는) 한숨을 쉰다.
			PRINTFORML 「다음엔 그냥 날아서 나갈 수 있었다는 것만 기억난다...」
		CASE 2
			PRINTFORML 「농담하는 거야!」
			PRINTFORMDL %CALLNAME:[[百々世]]%이 웃었다.
			PRINTFORML 「헤이안 시대 이후로 바깥세상이 정말 많이 변했지, 응?」
	ENDSELECT
ELSE
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML 「...모든 것을 이상한 뒤뚱거리는 머리로 보기 시작하기까지 한 시간이 걸렸어.」
			PRINTFORML 「그래서 아무리 배가 고파도 동굴 버섯은 먹지 않는 거야...」
		CASE 1
			PRINTFORML 「...그래서 절대 똑바로 아래로 파면 안 된다는 거야.」
			PRINTFORML 「그냥 날아나올 수 있다는 걸 기억했더라면 좋았을 텐데, 계속...」
		CASE 2
			PRINTFORML 「...어딘가 이상한 기계가 똑같은 16개의 음을 계속 연주하고 있었다.」
			PRINTFORML 「나는 그것이 사방에 있던 그 이상한 붉은 먼지로 동력이 공급되었던 것 같다.」
			PRINTFORML 「누가 이걸 만들었는지 왜 만든 건지는 모르겠지만, 그냥 내버려 두었다.」
			PRINTFORML 「이즈나마루는 내가 이상한 것들을 만지도록 돈을 주지 않으니까...」
		CASE 3
			PRINTFORML 「...빌어먹을 일이야. 내가 보니까 내 마차는 거기에 없었는데, 분명히 있었던 게 분명해!」
			PRINTFORML 「최신 모델들은 하루 동안 손대지 않으면 자동으로 시작 지점으로 돌아가지만, 이건 구형 중 하나였어.」
			PRINTFORML 「왠지 안 좋은 예감이 들어서 터널을 폐쇄하고 결국 이즈나마루에게 보고했지.」
			PRINTFORML 「"직감에 따라 행동해", 그게...」
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;Fragrance ("CHARACTER wears a pleasant fragrance...")
;いい匂い
;==================================================

@M_KOJO_MESSAGE_COUNTER_K142_4
CALL M_KOJO_MESSAGE_COUNTER_K142_4_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K142_4_1
IF TALENT:[[百々世]]:恋人
	$LOVER_FRAGRANCE
	SELECTCASE RAND:4
		CASE 0
			IF FIRSTTIME("TewiPranksMomoyo")
				PRINTFORML 「냄새가 마음에 드는군, 응?」
				PRINTFORMDL %CALLNAME:[[百々世]]%의 미소가 더 넓어진다.
				PRINTFORML 「혹시... 흥분하게 해? 어쩌면?」
				PRINTFORMDL 별로. 그냥 좋은 냄새야.
				PRINTFORMDL %HIS_HER([[百々世]],1)%의 미소가 사라진다.
				PRINTFORML 「젠장, 저 토끼! 그 인간 페로몬이 토끼 오줌 냄새가 날 줄은 몰랐어...」
				PRINTFORML 「다음에 %HIM_HER(53)% 만나면 산 채로 가죽을 벗겨버릴 거야!」
			ELSE
				GOTO LOVER_FRAGRANCE
			ENDIF
		CASE 1
			PRINTFORML 「너한테 좋은 냄새 나지?」
			PRINTFORML 「좋은 냄새가 나는 것 같지만, 나는 훨씬 더 예민한 후각을 가졌어.」
		CASE 2
			PRINTFORML 「사실 향수 같은 건 하나도 안 뿌렸어.」
			PRINTFORMDL %CALLNAME:[[百々世]]%이 다가와 네 귀에 속삭였다.
			CALL HPH_PRINT, @"「너는 너무 지독하게 섹시해서 번식 페로몬을 분비하고 있어HPH」", "L"
		CASE 3
			PRINTFORML 「너희가 왜 썩은 나뭇잎 냄새를 싫어하는지 도저히 이해할 수가 없어.」
			PRINTFORML 「나는 마지막 월급 전부를 인간 친화적인 향수에 썼는데...」
			PRINTFORML 「하지만 괜찮아. 나의 멋진 %PRINT_MALE("boy", MASTER)% 친구를 행복하게 해주는 건 환상의 모든 돈보다 가치 있으니까.」
			PRINTFORMDL %CALLNAME:[[百々世]]%가 네 뺨을 비빈다.
	ENDSELECT
ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「오, 마음에 들어?」
			PRINTFORML (헤이, 히토미짱이 나를 실망시키지 않을 줄 알았어.)
			PRINTFORML (그녀가 내가 인간들이 좋아하는 향을 찾아다녔다는 걸 아무에게도 말해주지 않기를 바랄 뿐이야.)
			PRINTFORML (내가 가장 원치 않는 건 치시마루나 히메카이도가 그걸 알아서 내 비밀 %COND_STR("human ", !IS_NONHUMAN(MASTER))%연인에 대해 기사를 쓰는 거야.)
		CASE 1
			PRINTFORML 「마음에 들어 하는 거지? 난 네가 그렇게 해주길 바랐는데.」
			PRINTFORML 「전 이 근교에서 제일 섹시한 %PRINT_MALE("guy", MASTER)%에게 안 좋은 냄새 나고 싶지 않아~」
		CASE 2
			PRINTFORML 「"너무 많이 뿌리진 않았어. 난, 어... 인간들은 너무 좋은 냄새를 맡을 수 없다는 걸 '잊고' 있었지."」
			PRINTFORML 「그럼 나한테 좀 더 가까이 와서 한 번 맡아보는 게 어때?」
			PRINTFORMDL %CALLNAME:[[百々世]]%은 장난기 어린 윙크를 날린다.
	ENDSELECT
ELSE
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「오, 좋아해?」
			PRINTFORML (후우. 다른 사람들이 뭘 좋아하는지 도저히 기억할 수가 없어...)
		CASE 1
			PRINTFORML 「인간 마을에서 이것을 샀다.」
			PRINTFORML 「"사람들이 좋아하는 향..."을 부탁했을 때 거의 들킬 뻔했다.」
		CASE 2
			PRINTFORML (나는 방금 이즈나마루에게 %HE_SHE(140)%이 무엇을 입었는지 물어보고 그것들을 좀 사 왔다.)
			PRINTFORML (%조사처리(CALLNAME:MASTER,"가")% 그걸 좋아했으면 좋겠다...)
	ENDSELECT
ENDIF
RETURN 1
