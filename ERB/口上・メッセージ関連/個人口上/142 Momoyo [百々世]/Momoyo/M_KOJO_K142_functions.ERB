ENDIF
IF ARG == 0
	IF IN_HEAT([[百々世]])
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT, @"「너 오늘 입술이 유난히 키스하고 싶어 보인다」", "W"
				IF !(TALENT:[[百々世]]:恋人 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲 || TALENT:[[百々世]]:恋慕)
					PRINTFORMW 「아이고, 나 방금 그거 소리 질러버렸나?」
					PRINTFORMW 「미안해, %CALLNAME:MASTER%. 오늘 좀 이상한 기분이야.」
				ENDIF
			CASE 1
				IF CFLAG:[[百々世]]:既成事実 & 合意_うふふ
					PRINTFORMW 「좋아, 그냥 나가서 말할 거야.」
					PRINTFORMW 「%CALLNAME:MASTER%, 무슨 이유에서인지 정말 흥분했어. 섹스할래?」
				ELSE
					PRINTFORMDW %CALLNAME:[[百々世]]%이(가) 무언가 말하려고 %HIS_HER([[百々世]])%의 입을 열었다... 그러고는 그것을 다물고 %HIS_HER([[百々世]])%의 이마에서 흘리는 땀을 닦았다.
				ENDIF
			CASE 2
				PRINTFORMW (아이고, 정말로 %HIM_HER(MASTER)% 일곱 번 반 정도 몸을 감싸고 싶어...)
		ENDSELECT
	ELSEIF MARK:[[百々世]]:反発刻印 > 0
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW %CALLNAME:[[百々世]]% 너에게 더러운 눈빛을 준다.
			CASE 1
				PRINTFORMW 「그럼 이제 사과할 거야, 아니면...?」
			CASE 2
				PRINTFORMW 「난 아직도 너한테 화가 난 거 알잖아.」
		ENDSELECT
	ELSEIF TALENT:[[百々世]]:恋人
		$MOMOYO_LOVER_ENCOUNTER
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「흐흐흐... 뭐가 이렇게 좋은 냄새가 나는지 궁금했거든.」
			CASE 1
				PRINTFORMDL 모모요가 당신에게 깊이 고개를 숙인다.
				PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%. 어떻게 지내세요?」
				PRINTFORMW 「...됐어, 격식 차는 건 그만하자. 뭐 좀 할래?」
			CASE 2
				PRINTFORML 「며칠 전에 예쁜 보석을 좀 캐왔는데, 당신한테 정말 잘 어울 거예요!」
				PRINTFORMW 「보고 싶어?」
			CASE 3
				;I'll be surprised if anyone actually sees these lines
				IF TIME > CLOCK_TO_TIME(0, 00) && TIME <= CLOCK_TO_TIME(0, 30)
					PRINTFORMW 「헤이, 너무 가까이 오지 마... 나 방금 퇴근해서 아직 목욕할 시간도 없었어.」
					PRINTFORMW 「나랑 공중목욕탕 갈래? 아니면 개인실이라도 빌릴까...?」
				ELSE
					GOTO MOMOYO_LOVER_ENCOUNTER
				ENDIF
			CASE 4
				IF !RAND:20
					PRINTFORML 「뭐야?」
					PRINTFORMDW %CALLNAME:[[百々世]]%이 미소를 지으며 너의 엉덩이를 장난스럽게 한 대 친다.
				ELSE
					GOTO MOMOYO_LOVER_ENCOUNTER
				ENDIF
		ENDSELECT
	ELSEIF TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「헉!」
				PRINTFORMDW %CALLNAME:[[百々世]]%이(가) %HIS_HER([[百々世]])%의 얼굴을 가린다.
				PRINTFORMW 「나 눈 멀 것 같아! 네 뜨거움이 내 눈을 태우고 있어!」
			CASE 1
				PRINTFORMW 「이야이야, 이 몸이 바로 환상향 최고의 %PRINT_MALE("guy", MASTER)%라니.」
			CASE 2
				PRINTFORML 「안녕~」
				PRINTFORMW 「지금 뭐 해? 안 하면... 나랑 할래?」
		ENDSELECT
	ELSEIF TALENT:[[百々世]]:愛欲
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「젠장, %PRINT_MALE("dude:girl", MASTER)%... 천장에서 떨어질 때 아팠어?」
				PRINTFORMW 「그때 신분증 가지고 있었으면 좋겠네. 왜냐면 다들 너무 많거든.」
			CASE 1
				PRINTFORMW 「만약 내가 한자 사전 배열을 바꿀 수 있다면... "너"와 "나"를 붙일 거야.」
				PRINTFORMW 「이미 그렇게 되어 있지 않을까? 그들은 어떻게 한자를 분류하는지 모르겠어.」
				PRINTFORMW 「...그리고 만약 그렇다면, 서로 겹칠 정도로 가깝게 놓을 거야!」
			CASE 2
				PRINTFORMW 「오늘 밤 달이 아름답지 않니?」
				SIF TIME:2 > 7
					PRINTFORMDW 하지만 대낮인데...
			CASE 3
				PRINTFORMW 「그래서, %CALLNAME:MASTER%... 혈액형이 뭐야?」
			CASE 4
				PRINTFORMW 「그래서 다음 시험은 언제야? 공부했지, 그렇지?」
				PRINTFORMW 「잠깐, 아니, 그게... 일! 일은 어떻게 되어가고 있어?」
				PRINTFORMW (젠장! 뭘 물어봐야 할지 도통 기억이 안 나!)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%! 잘 지내?」
			CASE 1
				PRINTFORML 「야! 시간 좀 있어?」
				PRINTFORMW 「팔씨름 좀 하고 싶은 기분이야.」
			CASE 2
				PRINTFORMW 「당신은... %CALLNAME:MASTER%, 맞죠?」
				PRINTFORMW 「헤에, 당신의 향기가 기억난 걸 알고 있었어요.」
		ENDSELECT
	ENDIF
ENDIF

@K142_GET_FAMILY_NAME(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 10 ;Suika
		RETURNF "Ibuki"
	CASE 32 ;Kanako
		RETURNF "Yasaka"
	CASE 33 ;Suwako
		RETURNF "Moriya"
	CASE 34 ;Tenshi
		RETURNF "Hinanawi"
	CASE 35 ;Iku
		RETURNF "Nagae"
	CASE 64 ;Yuugi
		RETURNF "Hoshiguma"
	CASE 69 ;Mamizou
		RETURNF "Futatsuiwa"
	CASE 129 ;Kutaka
		RETURNF "Niwatari"
	CASE 133 ;Saki
		RETURNF "Kurokoma"
	CASEELSE
		RETURNF @"%CALLNAME:ARG%에 가족 이름이 기재되어 있지 않다! 이것을 보고하라!"
ENDSELECT

