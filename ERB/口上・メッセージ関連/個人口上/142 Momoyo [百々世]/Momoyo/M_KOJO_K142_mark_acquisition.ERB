; Modular ERB: 個人口上/142 Momoyo [百々世]/Momoyo/M_KOJO_K142_mark_acquisition.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K142
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;Pain Mark
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORML 「Ow!」
	PRINTFORMDW %CALLNAME:[[百々世]]%이 당신을 노려본다.
	PRINTFORMW 「이게 뭔데, 단막(탄막) 매치라고 생각하는 거야?!」
ELSEIF TFLAG:22 == 2
	PRINTFORMW 「Kh!」
	PRINTFORMDW %CALLNAME:[[百々世]]%는(은) %HIS_HER([[百々世]])%를 간다.
	PRINTFORML 「봐, 요괴라고 해서 고통을 못 느끼는 건 아니야.」
	PRINTFORMW 「그러니까 내가 너한테 되갚아주기 전에 그만두는 게 좋을 거야.」
ELSEIF TFLAG:22 == 3
	PRINTFORMDW %CALLNAME:[[百々世]]%은 고통으로 비명을 지른다.
	PRINTFORMW 「왜?! 어떻게?!」
	PRINTFORMDW 그녀는 당신에게서 살금살금 물러난다. %HIS_HER([[百々世]],1)% 눈은 공포와 충격으로 커지고 눈물은 흘러내리고 있다 %HIS_HER([[百々世]])% 얼굴에
	PRINTFORML 「봐, 네가 이걸 어떻게 하는 건지, 내가 뭘 해서 너를 화나게 했는지 모르겠어...」
	PRINTFORMW 「하지만 미안해, 알았지?! 그냥 나를 괴롭히는 걸 멈춰줘!」
	PRINTFORMW 「제발...」
	PRINTFORMW %HE_SHE([[百々世]],1)%은 %HIS_HER([[百々世]])%의 무릎을 %HIS_HER([[百々世]])%의 가슴 쪽으로 끌어안고 당신을 애처롭게 바라본다.
ENDIF
;Rape Mark
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;Pleasure Mark
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;Lewd Mark
;First three cases are for when earned through Pleasure gems
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 
ENDIF
;Hate Mark
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 「야! 그만해!」
ELSEIF TFLAG:21 == 2
	PRINTFORML 「이봐, 친구, 너 정말 나 짜증나게 하기 시작했어.」
	PRINTFORMW 「내가 너한테 한 덩이 빼기 전에 몸 조심하는 게 좋을 거야.」
ELSEIF TFLAG:21 == 3
	IF TEQUIP:[[百々世]]:縄
		PRINTFORMDW %CALLNAME:[[百々世]]%은 모든 %HIS_HER([[百々世]])%의 힘으로 발버둥 치지만, %HE_SHE([[百々世]])%는 밧줄을 끊지 못한다.
		PRINTFORMW 「젠장...」
		PRINTFORMW 「이 밧줄에서 벗어나면 네 몸의 뼈 하나하나를 부숴주겠어!」
	ELSE
		PRINTFORMW 「좋아, 끝이다! 네놈을 박살 내주마!」
		PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 스트레칭을 하고, 옆으로 %HIS_HER([[百々世]])%의 목을 돌린 뒤 너를 붙잡는다.
		PRINTFORMDW 한순간에 바닥에 쓰러지고, 다음 순간 공중에서 빙글빙글 도다가... 결국 머리부터 땅에 처박힌다.
		CALL RECOVER(MASTER, -3000, "体力", "회전하는 파이프 드라이버")
		CALL PRINT_STRW, @"「내가 경고했어. 내가 진짜 너를 망치기 전에 당장 내 주변에서 사라져 봐.」"
	ENDIF
ENDIF
