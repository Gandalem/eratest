RETURN RESULT

@M_KOJO_MESSAGE_COM_K142_416_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 1
			IF TALENT:[[百々世]]:恋人
				PRINTFORMDW 모모요가 경이로운 듯 당신을 바라본다.
				PRINTFORMW 「그건... 아름다웠어...」
				PRINTFORMDW 그녀는 눈에서 눈물을 닦는다.
			ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
				PRINTFORMDW 모모요가 열렬하게 박수를 친다.
				CALL HPH_PRINT, @"「만약 이미 내 마음을 훔치지 않았다면, 분명 그렇게 했을 텐데HPH」", "W"
			ELSE
				PRINTFORMW 「핫 댐, 정말 중독성 있는 곡이네!」
				PRINTFORMW 「얼마나 연주해왔어? 너 정말 재능 있구나.」
			ENDIF
		CASE 0
			IF TALENT:[[百々世]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW 모모요는 눈을 감고 미소 지으며 비트에 맞춰 고개를 흔든다.
					CASE 1
						PRINTFORMW 「나는 네가 연주하는 것을 듣는 것이 항상 좋아.」
						CALL HPH_PRINT, @"「그것이 나를 또 당신에게 빠지게 만든다HPH」", "W"
					CASE 2
						PRINTFORMDW 모모요는 너무 세고 빠르게 박수를 치서 손이 번진다.
						PRINTFORMW 「앵콜! 앵콜! 앵콜! 앵콜!」
				ENDSELECT
			ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「밤중에 내 창밖으로 그걸 듣는 건 기쁘지 않을 거야...」
					CASE 1
						PRINTFORMW 그럼 이제 내 속옷을 %HIM_HER(MASTER)%에게 던져야 하나?
					CASE 2
						CALL HPH_PRINT, @"「귀엽고 재능이 있다고? 그게 바로 내 취향이야HPH」", "W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW 모모요가 당신의 노래를 끝내자 공손하게 박수를 친다.
					CASE 1
						PRINTFORMW 「조금 더 크게 연주해 줄 수 있니? 내 청력이 그렇게 좋지 않아.」
					CASE 2
						PRINTFORMW 「헤이, 꽤 잘하네.」
						PRINTFORMW 「근데 그 곡은 몰랐어. 이름이 뭐야?」
				ENDSELECT
			ENDIF
		CASE -1
			IF TALENT:[[百々世]]:恋人
				PRINTFORMDW 모모요는 손을 귀에 대고 있다.
				IF ABL:MASTER:音楽技能 < 3
					PRINTFORMW 「...노래를 불러보는 게 좋을지도 몰라.」
				ELSE
					PRINTFORMW 「무슨 일이야, %CALLNAME:MASTER%? 너 그거보다 더 잘 할 수 있다는 걸 알아!」
				ENDIF
			ELSEIF TALENT:[[百々世]]:恋慕 || TALENT:[[百々世]]:セフレ || TALENT:[[百々世]]:愛欲
				PRINTFORML 「멈춰! 멈춰!」
				PRINTFORMDW 모모요는 손으로 귀를 막는다.
				PRINTFORMW 「그 손들로 다른 걸 좀 해보는 건 어때?」
			ELSE
				PRINTFORMW 「야! 그만둬!」
				PRINTFORMW 「날 못 듣게 만들려고 하냐?!」
				PRINTFORMDW 모모요는 너를 노려본다.
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
