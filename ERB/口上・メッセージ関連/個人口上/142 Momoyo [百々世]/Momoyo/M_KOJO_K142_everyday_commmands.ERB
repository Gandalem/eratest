;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K142_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K142_302
CALL M_KOJO_MESSAGE_COM_K142_302_1
CALL K142_ERECTION_RESPONSE()
RETURN RESULT

@M_KOJO_MESSAGE_COM_K142_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF BATHROOM()
		IF TALENT:[[百々世]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 모모요가 당신의 등을 거품으로 문지를 때마다, 그녀는 그 거품에 한자 하나를 쓰고 그것이 무엇인지 맞추게 한다.
					PRINTFORMDW 쉽지 않다. 특히 그녀는 획순을 절대로 제대로 알지 못하기 때문이다.
				CASE 1
					PRINTFORMDW 모모요는 당신의 머리를 감겨주면서 두피 마사지를 해준다.
					PRINTFORMW 「여기쯤에 압통점이 있을지도... 아니면 여기?」
