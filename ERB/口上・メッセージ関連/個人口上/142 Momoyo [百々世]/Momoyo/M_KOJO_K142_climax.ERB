@M_KOJO_MESSAGE_PALAMCNG_A_K142_5(ARG)
;-------------------------------------------------
;パイズリ
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TALENT:TARGET:バストサイズ
		;Mystifying
		CASE 4
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「오, 거기 계셨군요!」
					PRINTFORMW 「혹시 막히신 건 아닌가 궁금했어요.」
				CASE 1
					PRINTFORML 「야, 그거 주워서 나올 때 가져다줄 수 있어?」
					PRINTFORMW 「완벽한 정액을 낭비할 이유가 없잖아, 알지?」
				CASE 2
					PRINTFORML 「네가 정말로 만족할 수 있었다니 믿을 수가 없어...」
					PRINTFORMW 「난 항상 그게 너무 크고 역겨워서 아무도 좋아하지 않을 거라고 생각했거든.」
			ENDSELECT
			;Gigantic
		CASE 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「멋지네, 네 거 아직 작동하네. 골반은 어때? 부러진 데 없어?」
					CALL PRINT_STRW, @"「좋다.」"
					PRINTFORMDW %CALLNAME:[[百々世]]%은 상어 같은 미소를 짓는다.
				CASE 1
					PRINTFORML 「그것보다 더 격렬하게 해줘야 할 거야! 아무것도 못 느꼈어!」
					PRINTFORMW 「내 얼굴을 때려야 한다고 말하는 건 아니지만, 적어도 절반 이상은 해주길 바라!」
				CASE 2
					PRINTFORMDL %CALLNAME:[[百々世]]% 나른하게 손가락을 미끄러뜨린다 %HIS_HER([[百々世]])% 거대한 가슴 사이로 손가락을 미끄러뜨리며 더 만져본다.
					PRINTFORMDW 그것은 너의 %SEMEN()%로 미끄럽게 돌아온다.
					PRINTFORMDW %HE_SHE([[百々世]],1)%이 그것을 %HIS_HER([[百々世]])%의 입에 넣고 네 정액을 빨아들인다.
					PRINTFORMW 「뭐? 그거 버리고 싶지 않아.」
			ENDSELECT
			;Big/Huge
		CASE 1, 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「난 늘 이런 것들이 그냥 방해만 된다고 생각했어...」
					PRINTFORMW 「네가 이걸 좋아한다는 걸 알게 되니 기분이 좋다.」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 너에게 미소 짓는다.
				CASE 1
					PRINTFORMDL %CALLNAME:[[百々世]]%이 %HIS_HER([[百々世]])%의 가슴을 한 번 더 쥐어짠다. 당신의 %SEMEN()% 중 일부가 그 사이에서 흘러나온다.
					PRINTFORMW 「나쁘지 않은 양이야 계속해서 더 만들 수 있는지 해볼래?」
				CASE 2
					PRINTFORML 「오 좋네! 이거 좋은 윤활제가 되겠군.」
					PRINTFORMW 「And there's so much, I can afford to taste a little...」
			ENDSELECT
			;Normal
		CASE 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL %CALLNAME:[[百々世]]%은(는) 기대하며 입을 벌리지만 네 정액이 그것에 도달하지 못한다.
					PRINTFORMW 「아...」
				CASE 1
					PRINTFORMW 「좋아, 움직이지 마. 네 더러운 걸 치울게.」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 고개를 숙이고 당신의 %FSYN("penis")% 끝을 핥기 시작한다.
				CASE 2
					PRINTFORML 「와, 목에 좀 묻었네...」
					PRINTFORMW 「도대체 매번 어떻게 그렇게 많이 사정하는 거야?」
			ENDSELECT
			;Small
		CASE -1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「온 얼굴에 다 묻었어...」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 당신의 %SEMEN()%를 게걸스럽게 핥는다.
				CASE 1
					PRINTFORMDL %CALLNAME:[[百々世]]%이 당신의 %SEMEN()%를 조금 떠서 자랑스럽게 웃는다.
					PRINTFORMW 「"크기보다 재능이 언제나 더 중요해", 그게 나의 모토야.」
				CASE 2
					PRINTFORML 「너무 세게 조인 거 아니었어?」
