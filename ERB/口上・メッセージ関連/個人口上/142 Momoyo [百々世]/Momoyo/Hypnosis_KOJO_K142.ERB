; Modular ERB: 個人口上/142 Momoyo [百々世]/Momoyo/Hypnosis_KOJO_K142.ERB
;==================================================
;催眠口上
;XX　　　　　　Chara ID
;ARG　　　　　Hypnosis Type
;ARG:1　　　Hypnosis Result
;==================================================

@M_KOJO_EVENT_K142_666(ARG, ARG:1)
;口上主はTARGET
;ARGは催眠タイプ（0催眠キャンセル、1反発抑制、2合意誤認、3発情抑制/発情促進、4常識改変）
;ARG:1は催眠結果（-3大失敗、-2大失敗、-1失敗、0キャンセル、1成功、2大成功、3大成功）
;臨時素質（TALENT:反発抑制、TALENT:合意誤認、FLAG:催眠強度）
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF 顔絵付きメッセージ && ARG != 0 && ARG:1 > 0
		PRINTL 
	;催眠タイプ
	SELECTCASE ARG
		;催眠キャンセル　　Hypnosis Cancel
		CASE 0
			;催眠結果　　必ず0である　　そして記入を推奨しない
			PRINTFORMW 「흐음... 머리가 다 몽롱하다...」
			PRINTFORMDW %CALLNAME:[[百々世]]%이 %HIS_HER([[百々世]])%의 이마를 문지른다.
			PRINTFORMW 「나는 또 에너지 드링크가 필요하다.」
			;反発抑制　　Resistance Weakened
		CASE 1
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「그게 사과하는 방법이 아니야, 친구. 다시 해봐.」
						CASE 1
							PRINTFORMW 「머리 아프게 하네. 그만해.」
						CASE 2
							PRINTFORML 「그냥 네가 하고 있는 거 그만두고 진심으로 사과해 줄래?」
							PRINTFORMW 「"미안해요, %CALLNAME:[[百々世]]%-상." 세 마디. 그거 그렇게 어려운 일 아니잖아.」
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMDL %CALLNAME:[[百々世]]%은(는) 고개를 흔든다.
					PRINTFORMW 「아, 이게 무슨 일이지. "분노를 내일로 미루지 말라"가 나의 좌우명이다.」
					PRINTFORMW 「용서해 줄게. 다시는 그러지 마, 알았지?」
					;Great Success
				CASE 2, 3
					PRINTFORML 「잠깐만... 도대체 내가 왜 너한테 화를 냈던 거지?」
					PRINTFORMDW %CALLNAME:[[百々世]]% 집중한다.
					PRINTFORMW 「기억조차 안 나네. 그럼 별일 아니었던 모양이지.」
					PRINTFORMW 「용서해 줄게... 뭐였든 말이야.」
			ENDSELECT
			;合意誤認　　Make Sex Acceptable
		CASE 2
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「나를 네 취향에 빠지게 하려고 최면 걸려는 거야?」
							PRINTFORMW 「그거 안 먹히는 거 알잖아, 그렇지? 그냥 너를 거대한 이상한 사람처럼 보이게 만들 뿐이야.」
						CASE 1
							PRINTFORMW 「이봐, %CALLNAME:[[百々世]]%는 걸레가 아니야. 날 원한다면 노력해야지.」
							SIF TALENT:[[百々世]]:ヤリマン
								PRINTFORMDW (%HIS_HER([[百々世]])%의 능력치 페이지에는 그렇게 나와 있지 않다...)
						CASE 2
							PRINTFORML 「그거에 시간 낭비할 바엔, 근력 운동이나 해보는 건 어때?」
							PRINTFORMW 「나를 믿어봐, 사람들을 최면 걸지 못하는 것보다 훨씬 재미있을 거야.」
							PRINTFORMW 「뒤지는 일도 훨씬 적을 테니까.」
					ENDSELECT
					;成功　　Success
				CASE 1
					IF TALENT:[[百々世]]:恋人
						PRINTFORMW (%조사처리(CALLNAME:MASTER,"와")% 아직 관계를 발전시키지 않은 이유가 대체 뭐야?)
						PRINTFORMW 우리는 사귀고 있어. 결혼하기엔 꽤 가까워졌거든.
					ELSEIF TALENT:[[百々世]]:恋慕
						PRINTFORMW (나는 천 년 이상 되었고, 이렇게 느끼게 해주는 다른 사람은 만나본 적이 없어.)
						PRINTFORMW (%HES_SHES(MASTER,1)% 바로 그 사람. 지금 %HIM_HER(MASTER)%에 내 주장을 세우지 않으면, 누군가 그 자리를 차지할 거야.)
					ELSE
						PRINTFORMW (Gh...)
						PRINTFORMW 나는 그냥 내 순결을 버리고 싶지 않아 어떤 %PRINT_MALE("guy", MASTER)% 거의 모르는
						PRINTFORMW 하지만 「1」에 대해서는 뭔가 %HIM_HER(MASTER)% 나를 미치게 만드는 게 있어 만약 내가 섹스하지 않으면 %HIM_HER(MASTER)%미쳐버릴 거야)
						PRINTFORMW 침실에서 할 수 있는 것이 오직 하나뿐인 건 아니다.
						PRINTFORMW 만약 %HE_SHE(MASTER)% \@ HAS_VAGINA([[百々世]]) ? 나를 입으로 해준다 # 나를 빨아먹는다 \@, 난 여전히 기술적으로 처녀인 거지?
					ENDIF
					$NUDE_WRESTLING_OFFER
					PRINTFORMDL 
					PRINTFORMDL %CALLNAME:[[百々世]]% 너를 똑바로 쳐다보며 씨익 웃는다.
					PRINTFORMW 「%CALLNAME:MASTER%아... 레슬링 할래?」
					PRINTFORMW 「벌거벗은 채 내 침대에서?」
					;Great Success
				CASE 2, 3
					PRINTFORMW 「Gh-!」
					PRINTFORMDW %CALLNAME:[[百々世]]%은 식은땀을 흘리기 시작하고, %HIS_HER([[百々世]])%의 페로몬 냄새가 공기를 가득 채운다.
					PRINTFORMW (나한테 무슨 일이지? 이유도 모르겠는데, 너무 흥분돼...)
					PRINTFORMW (%조사처리(CALLNAME:MASTER,"를")% 볼 때만 더 심해진다.)
					PRINTFORMW (뭔가 %HIS_HER(MASTER)%의 머리를 박살 내야 한다는 생각이 든다. 뭔지는 모르겠지만...)
					PRINTFORMW ("직감에 몸을 맡겨라", 그게 나의 모토이다.)
					GOTO NUDE_WRESTLING_OFFER
			ENDSELECT
			;発情抑制/発情促進　　Estrus Control
		CASE 3
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「음... 네가 뭘 하고 있다고 생각하는지는 모르겠지만, 그건 매력적이지 않아, 거부감이 들 뿐이야.」
						CASE 1
							IF CFLAG:[[百々世]]:K142ENC_SETTING_SALIVA == 1 && !IS_NONHUMAN(MASTER) && CFLAG:[[百々世]]:既成事実 & 合意_うふふ
								PRINTFORMW 「나를 흥분시키고 싶다면 그냥 키스해 주면 돼.」
							ELSE
								PRINTFORMW 「왜 그러는지 모르겠지만, 정말 짜증나게 하네. 그만둬.」
							ENDIF
						CASE 2
							PRINTFORML 「그런 쓸데없는 소리 그만둬.」
							PRINTFORMDW %CALLNAME:[[百々世]]% 너를 노려본다.
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMW (Gh!)
					PRINTFORMDW %CALLNAME:[[百々世]]%이 떨리는 손으로 %HIS_HER(TARGET)%의 이마를 닦는다.
					PRINTFORMW (왜 갑자기 이렇게 미치도록 흥분한 거지?!)
					PRINTFORMW (벌써 발정기인가? 젠장...)
					PRINTFORMW 이건 정상이 아니다. 진정해야 한다...
					PRINTFORMDW %CALLNAME:[[百々世]]%은 숨을 들이쉬고 내쉬며 %HIMSELF_HERSELF(TARGET)%를 진정시키려 하지만, 오히려 %HIM_HER(TARGET)%를 더 흥분시킨다.
					PRINTFORMW (크윽...)
					PRINTFORMDW %HIS_HER(TARGET,1)%의 손이 %HIS_HER(TARGET)%의 사타구니 위에 떠 있다.
					PRINTFORMDW 그것은 떨린다 %HE_SHE(TARGET)% 필사적으로 막으려고 노력한다 %HIMSELF_HERSELF(TARGET)% 앞에서 자위하는 것을 막으려 애쓰다 \@ NUMBER_OF_PEOPLE() > 1 ? 모든 사람 # 너 \@.
					PRINTFORMDL 넌 공허하게 궁금해하지 %HIM_HER(TARGET)% 어딘가에 넣고 아래로 밀까 %HIM_HER(TARGET)% 아래로...
					PRINTFORMDW 아니면 그냥 계속 지켜봐 %HE_SHE(TARGET)% 더 이상 자위 충동을 참지 못하다.
				CASE 2,3
					PRINTFORMW (Gh!)
					PRINTFORMDW %CALLNAME:[[百々世]]%은 떨리는 손으로 %HIS_HER(TARGET)%의 이마를 닦았다.
					PRINTFORMW (왜 갑자기 이렇게 흥분한 거지?!)
					PRINTFORMW (벌써 번식기인가? 제기랄...)
					IF TALENT:MASTER:恋人
						PRINTFORMW (나에게 이런 뜨거운 %PRINT_MALE("boy", MASTER)% 친구가 있어서 다행이야～)
					ELSEIF CFLAG:[[百々世]]:既成事実 & 合意_うふふ
						PRINTFORMW (내가 여기 %조사처리(CALLNAME:MASTER,"를")% 얻어 도움을 받을 수 있다니 다행이야~)
					ELSEIF THINKS_IS_VIRGIN(142)
						PRINTFORMW (%조사처리(CALLNAME:MASTER,"가")%(가) 있지만, 내가 첫 경험을 %HIM_HER(MASTER)%에게 주고 싶은 걸까?)
						SIF IS_FALLEN(142)
							PRINTFORMW 「(%HIM_HER(MASTER)%을 정말 좋아하는데, 하지만...)
						PRINTFORMW (그냥 내가 끝까지 가지 않아도 %HIM_HER(MASTER)%이 나한테 해줄 수 있을 것 같아.)
					ELSEIF IS_FALLEN(142)
						PRINTFORMW (%조사처리(CALLNAME:MASTER,"가")% 나에게 도움을 줄 의향이 있을까?)
					ENDIF
					$SEDUCED
					PRINTFORMDW %CALLNAME:[[百々世]]% 핥는다 %HIS_HER(TARGET)% 입술을 핥고 당신에게 미소 짓는다.
					IF SHOW_TOP(142,1) != ""
						PRINTFORMDW %HIS_HER(TARGET,1)% 단단한 유두가 뚫고 있다 %HIS_HER(TARGET)% %SHOW_TOP(142,1)%...
					ELSE
						PRINTFORMDW %HIS_HER(TARGET,1)%유두가 돌처럼 딱딱하다...
					ENDIF
			ENDSELECT
			;常識改変　　Common-Sense Control
		CASE 4
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「안 될까?」
						CASE 1
							PRINTFORMW 「더 나은 생각이 있어. 상식 좀 주입해 줄까?」
						CASE 2
							PRINTFORMW 「네가 나를 얼마나 세뇌시키고 싶어 하든 상관없어. 일어날 리 없어.」
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMDW %CALLNAME:[[百々世]]%의 눈에 초점이 풀리기 시작한다.
					PRINTFORMW (기분이 이상해...)
					PRINTFORMW (머릿속에 돌을 잔뜩 채운 기분이다...)
					PRINTFORMW 이거 정상 아니야 %조사처리(CALLNAME:MASTER,"가")% 나를 마법에 걸었거나 뭐 그런 거야 나는...
					PRINTFORMDW %HES_SHES(MASTER,1)% 그것을 싸우며 당신은 깊이 응시한다 %CALLNAME:[[百々世]]%의 눈을 깊이 응시하며 당신의 제안을 반복한다.
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 나의 \@ IS_MALE(MASTER) ? %CALLNAME:MASTER% # 여주인 \@이다.」
					PRINTFORMW 「나는 ~가 시키는 대로 할 것이다 \@ IS_MALE(MASTER) ? 마스터 # 마님 \@ 말한다...」
					PRINTFORMW 「\@ IS_MALE(MASTER) ? 마스터 # 마님 \@의 명령에 복종하면 기분이 좋아진다.」
					PRINTFORMW 「내가 불복종하면 복종하고 싶은 충동이 강해지고 더 강해져서 저항할 수 없을 때까지...」
					PRINTFORMDW %CALLNAME:[[百々世]]%은 단조로운 목소리로 당신의 지시를 반복한다.
					PRINTFORMDW %HIS_HER([[百々世]],1)%의 눈은 완전히 공허하다. %HES_SHES([[百々世]],1)%는 이제 완전히 복종한다.
					PRINTFORMDW %BREAKENG(@"You tell %HIM_HER([[百々世]])% that %HE_SHE([[百々世]])% won't remember being hypnotized, and on the count of three, %HE_SHE([[百々世]])%'ll come out of %HIS_HER([[百々世]])% trance, ready to obey your orders.")%
					PRINTFORMDW 당신은 세까지 센다, 그리고 %CALLNAME:[[百々世]]% 깜빡인다.
					PRINTFORMW 「응? 잠시 졸았던 것 같아. 비상 에너지 드링크부터 찾아야겠어...」
					PRINTFORMDW %CALLNAME:[[百々世]]% ...안에서 뒤지기 시작하다 %HIS_HER([[百々世]])% 주머니에서, 그리고 당신은 명령한다 %HIM_HER([[百々世]])% 멈추라고 주문한다.
					PRINTFORMDW %HE_SHE([[百々世]],1)% 즉시 멈춘다. 좋다.
					PRINTFORMDW 다음으로 너는 명령한다 %HIM_HER([[百々世]])% 에 올라가기 위해 %HIS_HER([[百々世]])% 네 발로 기며 늑대처럼 울어라. %HE_SHE([[百々世]],1)% 한다.
					PRINTFORMDW 마침내... 당신은 명령한다 %HIM_HER([[百々世]])% 들어 올리기 위해 %HIS_HER([[百々世]])% 치마를 들고 당신에게 보여주다 %HIS_HER([[百々世]])% 속옷
					PRINTFORMDW %HE_SHE([[百々世]],1)%은 한순간의 망설임도 없이 그것을 해낸다.
					PRINTFORMW 「나한테 더 원하는 거 있어 \@ IS_MALE(MASTER) ?마스터#마스터 혹은 미스께 원하는 것이 더 있나?\@?」
					PRINTFORMDW 너는 씩 웃고 싶은 충동을 거부하고 고개를 젓는다.
					PRINTFORMW 「좋아. 마음이 바뀌면 나에게 알려줘.」
					PRINTFORMW 「그래서 지금 뭐 해? 난 \@ WORKING([[百々世]]) ? 여기서 끝내고 조깅하러 갈 생각이다 # 조깅하러 가려고 한다. \@하고 싶으면 나랑 같이 해도 돼.」
				CASE 2
					PRINTFORMW 「당신을 따르라고?」
					PRINTFORMDW %CALLNAME:[[百々世]]%이 %HIS_HER([[百々世]])%의 머리를 긁는다.
					PRINTFORMW 「난 이미 당신을 따르고 있었잖아, 안 그래? 난 내 \@ IS_MALE(MASTER) ? 마스터 # 미스처를 불순종하지 않을 거야.」 \@
					PRINTFORMW 「"어떤 상황에서 \@ IS_MALE(MASTER) ? 마스터 # 미스처가 '뛰어'라고 말하면, 나는 '얼마나 높이?'라고 묻는다", 그게 나의 모토야.」\@
					PRINTFORMW 「그래서 뭐가 필요한데?」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
