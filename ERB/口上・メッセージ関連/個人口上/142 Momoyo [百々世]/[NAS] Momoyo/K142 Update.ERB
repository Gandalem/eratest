@K142_CONFIGURE
#DIM nLineCnt_Head
;FOR LOCAL, 0, 100
;PRINTL
;NEXT
LOADGLOBAL
IF CFLAG:142:1145 == 1
	RETURN 0
ENDIF
PRINTFORMDW 「%nameArray:142:na_LastName%-씨?」
CALL SET_KOJO_COLOR(142)
PRINTFORMW 「응, 나야.」
PRINTFORMDW %CALLNAME:142% 긴 표정으로 초조해 보이는 텐구에게 웃는다.
PRINTFORMW 「뭐가 필요해?」
PRINTFORMDW 「%nameArray:140:na_LastName%님이 이걸 당신에게 주라고 했다.」
PRINTFORMDW 텐구는 건넨다 %CALLNAME:142% 종이를 건네고 절을 하며 날아간다.
PRINTFORMDW %CALLNAME:142%은 종이를 가늘게 응시한다.
CALL SET_KOJO_COLOR(142)
PRINTFORMW 「세입자... "새로운 정책"... "직원 숙소"... "급에서 공제된다"... "의무적"이라고?!」
PRINTFORMDW %HE_SHE(TARGET,1)%이 한숨을 내쉰다.
PRINTFORMW 「능력 카드 건이 다 망치고 이제 그녀의 새로운 돈벌이 수법인가?」
PRINTFORMW 「그리고 내가 곡괭이 수리비로 나한테 청구하는 게 심하다고 생각했는데...」
PRINTFORMW 「뭐 상관없어. 내가 월급 받아서 생활하는 것도 아니니까.」
nLineCnt_Head = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
CALL K142_CONFIGURE_STATE
SELECTCASE RESULT
	CASE 9999
		;Results
		SAVEGLOBAL
		PRINTFORMDL 정보 공개
		DRAWLINE
		PRINTFORMDL 나는 나의 치료 제공자들에게 위에 기재된 나의 장애에 관하여 적절하고 합리적인 고용 수정을 결정할 목적으로 요괴 산 텐구 감독관들에게 정보를 공개하고 필요한 경우 대화하도록 권한을 부여한다.
		PRINTFORMDL 이 양식을 당신의 감독관에게 제출하시겠습니까? [Ends UPDATE]
		CALL ASK_YN()
		SIF RESULT
			CONTINUE
		CLEARLINE 4
		PRINTFORMDL 직원 이름: %NAME:142%
		PRINTFORMDL 날짜: %PRINT_DATE_F(DAY,1)%
		WAIT
		DRAWLINE
		;submission
		PRINTFORMDL EAc 편의 요청서 (의료 제공자가 작성해야 함)
		PRINTFORMDL 직원 이름: %NAME:142% 생년월일: [REDACTED]
		PRINTFORMDL 위에서 언급된 요괴 산악 텐구 직원은 조직이 2022년 산성 방위군 긴급 편의법(EAC)에 따른 합리적인 편의를 제공해 줄 것을 요청했다.
		PRINTFORMDL EAc에 따르면 장애가 있는 개인은 호흡, 식사, 수면, 보행, 대화, 시각 등 주요 생활 활동 중 하나 이상을 실질적으로 제한하는 신체적 또는 정신적 결함을 가진 사람이다.
		PRINTFORMDL 그러한 요청을 하는 직원은 조직에 현재의 장애 관련 서류를 제공해야 한다.
		PRINTFORMDL 귀하에게는 이 양식의 모든 항목을 완전히 작성하여 직원으로부터 서류를 제출해 달라는 요청이 들어왔다.
		PRINTFORMDL 이러한 질문들은 1) 직원이 장애가 있는지, 2) 편의가 필요한지, 그리고 3) 효과적이고 합리적인 편의에 해당하는 어떤 선택지가 있을 수 있는지를 판단하는 데 도움이 될 것이다.
		PRINTFORMDW 또한, 직원들의 편의 요청을 검토하는 데 도움이 된다고 생각되는 보충 자료를 제공해 주시기 바란다.
		PRINTL
		PRINTFORMDL 이 개인의 신체적 또는 정신적 장애를 식별해 주십시오:
		CALL SET_KOJO_COLOR(72)
		SELECTCASE K142_UPDATE:0-3
			CASE -3
				PRINTFORML 가슴 없음
				IF VINUM_OMOGATARI_FEATURE_CHECK()
					TALENT:TARGET:105 = -3
				ELSE
					TALENT:TARGET:105 = -2
				ENDIF
			CASE -2
				TALENT:TARGET:105 = -2
			CASE 0
				TALENT:TARGET:105 = 0
			CASE 1
				TALENT:TARGET:105 = 1
			CASE 2
				PRINTFORML "거대한" 가슴
				TALENT:TARGET:105 = 2
			CASE 3
				PRINTFORML 비정상적인 가슴사이즈
				TALENT:TARGET:105 = 3
			CASE 4
				PRINTFORML 극도로 비정상적인 가슴사이즈
				TALENT:TARGET:105 = 4
		ENDSELECT
		SELECTCASE K142_UPDATE:1
			CASE 0
				PRINTFORML ・부득이한 모유 분비
			CASE 1
		ENDSELECT
		SELECTCASE K142_UPDATE:2
			CASE 0
			CASE 1
				PRINTFORML 극도의 리베로
		ENDSELECT
		SELECTCASE K142_UPDATE:3
			CASE 0
				PRINTFORML 비정상적인 음모 성장
			CASE 1
		ENDSELECT
		IF GETBIT(VINUM_OMOGATARI_FEATURE_CHECK("pee"),1) || GETBIT(VINUM_OMOGATARI_FEATURE_CHECK("scat"),2) || FLAG:おもらし有効
			SELECTCASE K142_UPDATE:4
				CASE 0
					TRYCALLF GAMANME(142,6,1)
				CASE 1
					TRYCALLF GAMANME(142,5,1)
				CASE 2
					TRYCALLF GAMANME(142,3,3)
				CASE 3
					PRINTFORML 스스로 설명하는 배뇨 문제
					TRYCALLF GAMANME(142,0,1)
				CASE 4
					LOCALS =
					SIF VINUM_OMOGATARI_FEATURE_CHECK("pee") || FLAG:おもらし有効
						LOCALS += "urine、"
					SIF VINUM_OMOGATARI_FEATURE_CHECK("scat")
						LOCALS += "bowel、"
					PRINTFORML ・중간 정도의 %LIST_IN_STRING(LOCALS)% 누수
					IF VINUM_OMOGATARI_FEATURE_CHECK()
						TRYCALLF GAMANME(142,-3,3)
					ELSE
						TALENT:142:57 = -3
					ENDIF
				CASE 5
					LOCALS =
					SIF VINUM_OMOGATARI_FEATURE_CHECK("pee") || FLAG:おもらし有効
						LOCALS += "urine、"
					SIF VINUM_OMOGATARI_FEATURE_CHECK("scat")
						LOCALS += "fecal、"
					PRINTFORML ・심한 %LIST_IN_STRING(LOCALS)% 누수
					TRYCALLF GAMANME(142,-4,1)
				CASE 6
					LOCALS =
					SIF VINUM_OMOGATARI_FEATURE_CHECK("pee") || FLAG:おもらし有効
						LOCALS += "urinary、"
					SIF VINUM_OMOGATARI_FEATURE_CHECK("scat")
						LOCALS += "bowel、"
					PRINTFORML ・%CAPITALIZE(LIST_IN_STRING(LOCALS))% 실금
					TRYCALLF GAMANME(142,-5,1)
				CASE 7
					IF VINUM_OMOGATARI_FEATURE_CHECK("scat")
						PRINTFORML 분변 실금
					ELSE
					ENDIF
			ENDSELECT
		ENDIF
		WAIT
		;
		PRINTFORMDL [문서의 여러 부분이 삭제되었다]
		WAIT
		PRINTFORMDL 직원이 필수적인 책임을 수행할 수 있도록 가능한 편의 제공 방안에 대한 제안을 해주세요.
		SELECTCASE K142_UPDATE:0-3
			CASE 2
				PRINTFORML 플러스 사이즈 브라를 착용한다.
			CASE 3, 4
				PRINTFORML · 플러스 사이즈 브라 착용하기
				PRINTFORML · 에스퍼: 비행이 주어질 것이다
				SETBIT TALENT:142:59, 1
		ENDSELECT
		SELECTCASE K142_UPDATE:1
			CASE 0
				PRINTFORML 모유 패드는 사람에게 착용한다.
			CASE 1
		ENDSELECT
		SELECTCASE K142_UPDATE:2
			CASE 0
			CASE 1
				PRINTFORML 요청받은 대로 응급 항-아프로디지액 임플란트를 제공한다.
		ENDSELECT
		SELECTCASE K142_UPDATE:3
			CASE 0
				PRINTFORML 면도날은 사흘마다 사용한다.
			CASE 1
		ENDSELECT
		IF GETBIT(VINUM_OMOGATARI_FEATURE_CHECK("pee"),1) || GETBIT(VINUM_OMOGATARI_FEATURE_CHECK("scat"),2) || FLAG:おもらし有効
			SELECTCASE K142_UPDATE:4
				CASE 3
					PRINTFORML 작업장 주변에 화장실을 건설한다.
				CASE 4
					PRINTFORML 직장 주변에 화장실을 지을 것
					PRINTFORML 사람에게 가벼운 실금 방지용 것을 착용할 것
				CASE 5
					IF VINUM_OMOGATARI_FEATURE_CHECK("omutsu")
						PRINTFORML 착용할 기저귀.
					ELSE
						PRINTFORML 기저귀가 제안되었으나 메타 월드 제재 2325에 의해 금지되었다.
						PRINTFORML 대신 카테터와 같은 대체 배뇨 보조 장치를 사용할 것.
					ENDIF
				CASE 6
					IF VINUM_OMOGATARI_FEATURE_CHECK("omutsu")
						PRINTFORML 개인에게 착용되며 제3자에 의해 정기적으로 확인되어야 하는 기저귀.
					ELSE
						PRINTFORML 기저귀가 제안되었으나 메타 월드 제재 2325에 의해 금지되었다.
						PRINTFORML 대신 카테터와 같은 대체 배뇨 보조 장치를 사용할 것.
					ENDIF
				CASE 7
					IF VINUM_OMOGATARI_FEATURE_CHECK("scat")
						IF VINUM_OMOGATARI_FEATURE_CHECK("omutsu")
							PRINTFORML 착용할 기저귀, 플러그, 장루 시스템 또는 기타 대변 포함 장치.
						ELSE
							PRINTFORML 기저귀가 제안되었으나 메타 월드 제재 2325에 의해 금지되었다.
							PRINTFORML 사람에게 착용하는 플러그와 같은 대체 배변 보조 기구.
						ENDIF
					ELSE
					ENDIF
			ENDSELECT
		ENDIF
		WAIT
		RESETCOLOR
		DRAWLINE
		PRINTFORMDL 제공자 이름: %NAME:72%
		PRINTFORMDL 날짜: %PRINT_DATE_F(DAY,1)%
		PRINTFORMDL 제공자 주소: 401 %STR_TR(6045)%, %GET_MAPNAME(4)%, 이상향, 일본
		WAIT
		CALL SET_KOJO_COLOR(142)
		RETURN
	CASEELSE
ENDSELECT
LOOP 1

@K142_CONFIGURE_STATE
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "INTRO", "BUST_SIZE", "LACTATION", "IN_HEAT", "PUBES", "CONTINENCE"
;
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
CALL SET_KOJO_COLOR(142)
IF !K142_UPDATE:9
	K142_UPDATE:9 = 1
	CALL K142_DEFAULTS
ENDIF
RESETCOLOR
DRAWLINE
;CALL SET_KOJO_COLOR(142)
PRINTFORMDL 요괴 산 텐구
PRINTFORMDL 직원들을 위한 합리적 편의 제공 요청서
DRAWLINE
TRYCALLFORM K142_SETTING_%DISP_NAME:PAGE%
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
PRINTBUTTON CAP_PROCESS(TOLOWER(REPLACE(DISP_NAME:LOCAL,"_"," ")),5), LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML
PRINTL
PRINTBUTTON "[9999] 반환 ", 9999
PRINTBUTTON "[9998] 기본값", 9998
DO
INPUT
SELECTCASE RESULT
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE 9998
		CALL K142_DEFAULTS
	CASE 9999 ;custom code
		RETURN 9999
	CASEELSE
		$RETRY
		TRYCALLFORM K142_SETTING_RESULT(RESULT)
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

@K142_SETTING_INTRO
#DIM nHome
SIF CFLAG:142:311 == SUKIMA()
	nHome = CSVCFLAG(142, 311)
PRINTFORMDL 지시 사항:
PRINTFORMDL %BREAKENG("Individuals who are employed at Youkai Mountain Tengu are given this form under the 2022 Mountain Defense Force Emergency Accommodations Act (EAc) are required to complete this form in its entirety. These employee accommodations will be deducted from your pay.")%
PRINTFORMDL %BREAKENG("Failure to do so will result in termination of your work contract.")%
PRINTFORMDL %BREAKENG("Please list each disability on a separate page.")%
PRINTDL
PRINTFORMDL 지원자 이름: %nameArray:142:na_LastName%, %nameArray:142:na_FirstName%
PRINTFORMDL 직업명: 광부
PRINTFORMDL 소속: 요괴 산 방어군
PRINTFORMDL 날짜: %PRINT_DATE_F(DAY,1)%
PRINTL
PRINTFORMDL 근무지 주소: {855} %STR_TR(855+8000)%, %GET_MAPNAME(855/100)%, 이상향(Gensokyo), 일본
PRINTFORMDL 자택 주소: {nHome} %STR_TR(nHome+8000)%, %GET_MAPNAME(nHome/100)%, 이상향(Gensokyo), 일본
PRINTL
PRINTFORMDL 감독관: %nameArray:140:na_LastName%, %nameArray:140:na_FirstName%

