;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K23_302
CALL M_KOJO_MESSAGE_COM_K23_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K23_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		PRINTDATA
			DATALIST
				DATAFORM 
			ENDLIST
			DATALIST
				DATAFORM 
			ENDLIST
		ENDDATA
		WAIT
		RETURN 1
	ELSEIF TALENT:恋慕
		PRINTDATA
			DATALIST
				DATAFORM 
			ENDLIST
			DATALIST
				DATAFORM 
			ENDLIST
			DATALIST
				DATAFORM 
			ENDLIST
		ENDDATA
		WAIT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「절대 반유령을 그렇게 세게 안지 마!」
				PRINTFORML 「...에? 좋은 바디필로우가 될 거라고 생각해?」
				PRINTFORML 「진심으로, 너 대체 뭐가 문제인 거야...」
				PRINTFORML 「묘온!!! 어디를 만지고 있는 건 줄 알아?!」
			CASE 1
				PRINTFORML 「그렇다, 나의 유령 반이 느끼는 것은 나의 인간 반도 느낄 수 있다.」
				PRINTFORMDL 유무의 말을 듣고, 당신은 유무 옆에 있는 작은 정령을 간지럽히기 시작한다.
				PRINTFORML 「야, 그만해!」
				PRINTFORML 「장난감이 아니라고.」
				PRINTFORML 
				;CASEELSE
				;PRINTFORML
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「우-음... 머리를 쓰다듬는 게 부끄럽네...」
				PRINTFORML 「나 더 이상 애 아니거든! 우으...」
				PRINTFORMDL 유무는 얼굴을 붉히며 항의하지만, 당신의 손을 뿌리지는 않는다.
			CASE 1
				PRINTFORML 「――아아, 바로 그곳이야... 기분 좋아...」
				PRINTFORML 「미안하지만, 어깨를 계속 주물러 줄 수 있을까.」
				PRINTFORML 「열심히 일하니까 가끔 어깨가 뻐근해져서 말이야.」
				PRINTFORMDL 유무는 네가 그녀의 어깨를 마사지해주자 미소를 지으며 긴장을 풀었다.
			CASE 2
				PRINTFORML 「묘언!」
				PRINTFORMDL 당신이 옆에 떠 있는 작은 정령을 어루만지자 유무는 귀여운 비명을 지른다.
				PRINTFORML 「내 환영 반쪽을 가지고 놀지 마세요!」
				PRINTFORML 「――아, 만질 수 없어!」
			CASEELSE
				PRINTFORML 「내 손을 보는 게 재미있니?」
				PRINTFORML 「검으로 할 수 있는 모든 일들을 상상하기는 어렵네, 꽤 여성적이잖아...」
				PRINTFORML 「――에? 아름다운 손이 노력의 증거라고 생각하는 거야?」
				PRINTFORML 「후후, 그렇게 말해주는 건 처음이네요.」
				PRINTFORMDL 유무가 당신의 말을 듣고 미소 짓는다.
		ENDSELECT
	ENDIF
	PRINTFORMW 
ENDIF
RETURN 1
