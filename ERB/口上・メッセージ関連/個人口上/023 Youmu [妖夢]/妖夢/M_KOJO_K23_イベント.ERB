	IF LOCAL:1 && ARG == 1
		;絶頂回数カウント
		LOCAL:4 = 0
		LOCAL:4 += EX:23:50
		LOCAL:4 += EX:23:51
		LOCAL:4 += EX:23:52
		LOCAL:4 += EX:23:53
		;絶頂箇所判定
		LOCAL:5 = 0
		SIF EX:23:50 > 0
			LOCAL:5 += 1
		SIF EX:23:51 > 0
			LOCAL:5 += 1
		SIF EX:23:52 > 0
			LOCAL:5 += 1
		SIF EX:23:53 > 0
			LOCAL:5 += 1
		IF CFLAG:23:1002 == 0
			PRINTFORML 「――묘온?!」
			LOCALS:0 = 
			IF LOCAL:5 > 1
				LOCALS:0 '= @"그녀의 얼굴이 붉어진다."
			ELSEIF EX:23:50 > 0 || EX:23:51 > 0
				LOCALS:0 '= @"그녀는 마치 쾌락을 견디려는 듯 자신의 사타구니를 움켜쥐고 있다."
			ELSEIF EX:23:52 > 0
				LOCALS:0 '= @"그녀는 즐거움을 참으려는 듯 엉덩이를 가린다."
			ELSEIF EX:23:53 > 0
				LOCALS:0 '= @"그녀는 기쁨을 견디려는 듯 팔로 가슴을 감싸 안는다."
			ENDIF
			PRINTFORMDW 유무가 높은 신음을 내자, %LOCALS:0%는 주변을 둘러본다.
			IF CFLAG:291 == 1
				;一日一回
				IF TCVAR:23:350 == 0
					IF CFLAG:23:1001 == 0
						PRINTFORML 「――에? 뭐라고?! 그럴 리가...」
						PRINTFORMDL 그녀의 속옷이 허공으로 사라지자 유무는 놀랐다.
						PRINTFORMDW 그녀의 어깨는 수치심으로 떨렸지만, 아무도 알아채지 못하도록 서둘러 평정을 되찾으려 노력했다.
					ELSEIF CFLAG:23:1001 < 10
						PRINTFORML 「......쿠우, 또 아니야!」
						PRINTFORMDL 유무는 입고 있던 속옷이 다시 사라진 것에 깜짝 놀란다.
						PRINTFORMDW 그녀는 검을 잡고 주위를 살피려 하지만 다리가 떨리는 것을 멈출 수 없다.
					ELSEIF CFLAG:23:1001 < 20
						PRINTFORML 「......또?! ――겁쟁이!! 모습을 보여라!!」
						PRINTFORMDL 유무는 대중의 주목 따위 신경 쓰지 않고 루칸켄을 뽑으며 소리쳤다.
						PRINTFORMDW 그녀는 속옷을 또 한 번 잃은 것에 대해 부끄러움과 분노를 동시에 느꼈다.
					ELSEIF CFLAG:23:1001 == 100
						PRINTFORML 「――칫!」
						PRINTFORMDL 평소처럼 그녀의 속옷은 허공으로 사라졌고, 유무는 조용히 자신의 록관켄과 하쿠로켄을 모두 뽑았다.
