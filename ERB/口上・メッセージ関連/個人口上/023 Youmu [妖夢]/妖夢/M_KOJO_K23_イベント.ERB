@M_KOJO_EVENT_K23_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF !CFLAG:TARGET:ブチギレ
			PRINTFORML 「%CALLNAME:MASTER%, 뭐 필요한 거 있어?」
			SIF TALENT:思慕 || TALENT:恋慕
				PRINTFORML 「음, 시간이 남는다면...」
			IF TALENT:セフレ || TALENT:愛欲
				PRINTFORML 「음, 당신이 괜찮다면...」
			ENDIF
			SIF TALENT:恋人
				PRINTFORMDL 유무는 무의식적으로 당신의 소매를 잡는다.
			;時姦刻印があるとき時姦刻印/5で
			IF MARK:時姦刻印 > 0 && RAND:5 < MARK:時姦刻印
				PRINTFORMDL 유무는 자신을 통제하는 데 어려움을 겪고 있다.
				SIF MARK:時姦刻印 > 1
					PRINTFORMDL 그녀의 작은 몸이 떨린다.
				SIF MARK:時姦刻印 > 2
					PRINTFORMDL 그녀의 은밀한 곳은 완전히 젖어 있다.
			ENDIF
			PRINTFORMDW 유무가 당신을 보며 미소 짓는다.
		ELSE
			PRINTFORMDW 유무는 소리 없이 검을 뽑고 날카로운 휘두르기를 한다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF !CFLAG:ブチギレ
			PRINTFORM 「%CALLNAME:MASTER%
			SIF TALENT:思慕 || TALENT:恋慕
				PRINTFORM 실례지만, 저는 가봐야겠어요.
			PRINTFORML 「무슨 일 있어?」
			SIF TALENT:セフレ || TALENT:愛欲
				PRINTFORMDL 유무가 당신을 옆에서 부드럽게 감싼다.
			SIF TALENT:恋人
				PRINTFORMDL 유무는 자연스럽게 당신의 손가락과 자신의 손가락을 얽는다.
			;時姦刻印があるとき時姦刻印/5の確率で
			IF MARK:時姦刻印 > 0 && RAND:5 < MARK:時姦刻印
				PRINTFORMDL 유무는 자신을 통제하는 데 어려움을 겪고 있다.
				SIF MARK:時姦刻印 > 1
					PRINTFORMD 그녀의 작은 몸이 기대감으로 떨린다.
				SIF MARK:時姦刻印 > 2
					PRINTFORMD 그녀가 깨닫기 전에, 은밀한 곳은 완전히 젖어 있었다.
			ENDIF
			PRINTFORMDW 유무가 당신을 향해 시선을 돌린다.
		ELSE
			PRINTFORMDW 네가 들어왔을 때, 유무의 손은 검자루에 얹혀 있었고 그녀는 심각한 표정을 짓고 있었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;TARGETが恋慕を持っている時のみ ＝ 思慕、愛欲、セフレはない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORML 「당신의 등을 씻겨 드릴게요.」
			PRINTFORML 「다른 곳을 씻기고 싶다면 주저하지 말고 말해 주세요.」
			PRINTFORMDL 유무가 당신에게 가까이 다가서며 부드러운 피부를 드러냈다.
			SIF MARK:時姦刻印 && RAND:5 < MARK:時姦刻印-1
				PRINTFORMDW 유무의 단단해진 유두를 그의 등에 느낄 수 있다.
		ELSE
			PRINTFORML 「――츠, 실례합니다.」
			PRINTFORMDL 유무는 재빨리 목욕 타월로 몸을 가린다.
			PRINTFORML 「보-보지 마세요!」
			PRINTFORMDW 얼굴이 붉어진 채, 유무는 당신의 등을 열심히 씻긴다.
			SIF MARK:時姦刻印 && RAND:5 < MARK:時姦刻印
				PRINTFORMDW 유무의 뜨거운 숨결이 당신의 목덜미에 느껴진다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;通常はこちら
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「M-미온!」
		PRINTFORMDL 유무가 당신을 벌거벗은 채로 본다, 당신은 몸을 가리는 것을 잊었다..
		PRINTFORML 「아-앗,――죄송해요!!」
		PRINTFORMDW 정신을 차렸을 때, 그녀가 자신을 벌거벗은 채로 봤다는 것을 깨닫고 수치심을 느낀다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;TARGETが自分の弱みを握る異性のときのみ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「나가라! 안 그러면 네 몸을 자르겠다!!」
		PRINTFORMDW 유무가 자신의 무기를 찾기 시작하고, 당신은 벌거벗은 몸을 가린 채 욕실에서 도망친다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF CFLAG:ブチギレ
			PRINTFORML 「――칫!」
			PRINTFORMDL 유무는 당신을 보자 불안감을 느낀다.
			PRINTFORMDW 그녀는 무의식적으로 검에 손을 뻗는다…
		ELSEIF TALENT:恋人
			PRINTFORML 「――아, %CALLNAME:MASTER%-상!」
			PRINTFORMDL 유무가 신나게 당신에게 가까이 다가온다.
			PRINTFORML 「음, 원하시면 이 후에 우리가――」
			PRINTFORMDW 유무는 팔을 붙잡고 행복한 표정으로 당신에게 말을 걸며 놓아줄 의도가 전혀 없다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「――아, %CALLNAME:MASTER%-님!」
			PRINTFORMDL 유무는 당신에게 흥분하며 가까이 다가온다...
			PRINTFORML 「음, 괜찮으시다면...」
			PRINTFORMDW 유무는 긴장한 채 옆에서 당신의 팔을 잡는다.
		ELSEIF TALENT:思慕
			PRINTFORML 「――아, %CALLNAME:MASTER%-님!」
			PRINTFORMDW 유무가 당신에게 즐겁게 말을 건다.
		ELSEIF TALENT:愛欲
			PRINTFORML 「%CALLNAME:MASTER%-씨, 지금 시간 있으신가요?」
			PRINTFORMDL 유무는 예상치 못하게 옆에서 나타나 품위 없게 자신의 몸을 당신에게 밀어붙인다.
			PRINTFORML 「시간이 되신다면, 당신과 저......%UNICODE(0x2665)%」
			PRINTFORMDL 홍조를 띤 유무는 거친 숨을 몰아쉬며 당신의 팔을 긁는다.
			PRINTFORML 「――저와 함께 해주실 수 있나요?」
			PRINTFORMDW 유무가 자신의 은밀한 곳에 손을 대자, 당신의 손에 특정한 따스함이 느껴진다.
		ELSEIF TALENT:セフレ
			PRINTFORML 「――아, %CALLNAME:MASTER%-상!」
			PRINTFORMDL 유무가 당신과 즐겁게 이야기한다.
			PRINTFORMDW 하지만 그녀는 매우 가볍게 당신을 바라보고 만지는데, 그 행동은 선을 넘고 있다.
		ELSE
			PRINTFORMDW 유무가 당신을 알아차리고 작은 목례를 했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;恋人
		IF TALENT:恋人
			PRINTFORML 「......재미있어 보인다.」
			PRINTFORML 「――다른 기회에 너와 데이트하는 것도 기대하고 있어.」
			PRINTFORMDW 유무는 당신에게 미소 지었지만, 그녀의 눈에는 약간의 질투가 느껴졌다.
			CFLAG:不機嫌 = 3
			CFLAG:ブチギレ = 1
			TALENT:機嫌 = -1
			SELECTCASE MARK:反発刻印
				CASE 0
					SOURCE:反感 = 500
				CASE 1
					SOURCE:反感 = 1000
				CASEELSE
					SOURCE:反感 = 2000
			ENDSELECT
			SOURCE:反感 *= 4
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORML 「이런 곳에서 만나다니, 정말 우연이네요.」
			PRINTFORMDW 유무는 침착한 척하지만, 몸짓은 어색하다.
			;思慕
		ELSEIF TALENT:思慕
			PRINTFORML 「두 분이 함께 외출하시는 건가요?」
			PRINTFORML 「좋네요...」
			PRINTFORMDW 유무는 %CALLNAME:(ARG:1)%를 바라보며 혼잣말을 중얼거린다.
			;愛欲
		ELSEIF TALENT:愛欲
			PRINTFORMW 「나도 초대해 줘%UNICODE(0x2665)%」
			PRINTFORMDL 유무는 %CALLNAME:(ARG:1)%을 부러운 듯 바라본다.
			PRINTFORMDL 유무의 중얼거림이 들린다.
			;セフレ
		ELSEIF TALENT:セフレ
			PRINTFORMDW 유무는 %CALLNAME:(ARG:1)%을 부러운 듯 바라본다.
		ELSE
			PRINTFORMDW 유무가 당신을 알아보고 %CALLNAME:(ARG:1)%를 보면 작은 목례를 한다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
