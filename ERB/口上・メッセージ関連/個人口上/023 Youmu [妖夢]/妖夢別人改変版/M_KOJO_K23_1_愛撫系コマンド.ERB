			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「츄, 응, 주르륵, 꿀꺽, 쭈욱우으흐읍…… 후흡, 음, 깊숙이…… 으응…… 흐읍」","L"
					PRINTFORML 혀를 얽고 서로의 구강을 탐한다.
					PRINTFORMW 뒤섞인 침이 혀를 타고 흘러들자, 요우무는 그것을 황홀하게 목구멍으로 넘겼다.
				CASE 1
					CALL HPH_PRINT,@"「후, 음음, 흠… 아무 HPH 츄르륵, 주르륵… HPH」","L"
					PRINTFORMW 입술에 닿은 %조사처리(CALLNAME:MASTER,"의")% 혀끝을 요우무가 먹듯이 물고, 자신의 구강 속으로 이끌었다.
				CASE 2
					CALL HPH_PRINT,@"「츄, 후윽, 음, 쥬루헵ㅍ 주우웅, 음무, 흐읍, 아아……헵ㅍ」","L"
					CALL HPH_PRINT,@"「하아, 아직……흐읍! 아……음, 응응흐으읍!」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아무, 쪽, 응! 푸핫 HPH 음으……헉, 음므 HPH」","L"
					PRINTFORMW 요우무는 %조사처리(CALLNAME:MASTER,"의")% 쪼아대는 듯한 입맞춤에 정신을 빼앗긴 채 응하고 있다.
				CASE 1
					CALL HPH_PRINT,@"「응응, 흐읍, 츄읍후우, 쪽, 응, 으으……후우」","L"
					PRINTFORML 키스를 나누며 욕망스럽게 벌어진 입술 사이를 혀끝으로 더듬는다.
					PRINTFORMW 애태우는 듯한 움직임에 요우무는 간지럽다는 듯 몸을 비틀었다.
				CASE 2
					CALL HPH_PRINT,@"「후우, 음음……흡읍 응, 후우……아, 하윽 흡읍」","L"
					CALL HPH_PRINT,@"「상냥한 키스, 좋아해요……후우앗, 응응, 후아, 으응후우앗」","W"
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		PRINTDATAW
			DATAFORM 「음, 읍…… 우우……읏」
			DATAFORM 「무, 끄윽…… 후우, 우……」
			DATAFORM 「크윽, 또…… 음ん……읏」
		ENDDATA
	ENDIF
ENDIF
RETURN 1
