RETURN RESULT

@M_KOJO_別人版_MESSAGE_COM_K23_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW
		RETURN 1
		;泥酔
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「야응 HPH 엉덩이인가요…… 응?」","L"
			CALL HPH_PRINT,@"「앗! 아, 저기, %CALLNAME:MASTER%씨, 거기――흐으윽 흐아앙ㅎㅍㅎ」","W"
		ELSE
			PRINTFORML 「……응? 말……」
			PRINTFORMW 「크윽! 어, 이상한 곳에――이, 괜찮아!?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「헉, 네!? %CALLNAME:MASTER%씨, 그건……!」
			PRINTFORMW 항문을 쓰다듬는 손가락에 놀랐는지 요우무의 손이 반사적으로 %조사처리(CALLNAME:MASTER,"의")% 손끝을 제지했다.
			PRINTFORML
			PRINTFORMW 「저, 저기요. 엉덩이의…… 어, 잘못된 건가요……?」
			PRINTFORML 「느끼게 된다니…… 도, 도대체 어떻게 생각해도 무리예요오……」
			PRINTFORMW 소질은 있는 듯하나 확실히 요우무의 항문은 아직 단단하여 무언가를 삽입하는 것은 도저히 바라볼 수 없을 것이다.
			PRINTFORMW 인내심을 가지고 풀어갈 수밖에 없을 것 같다……
		ELSE
			PRINTFORML 「응!? 뭐, 뭘…… 그만둬……앗」
			PRINTFORMW 항문을 밀어 넣는 손가락에 놀랐는지 요우무의 손이 반사적으로 %조사처리(CALLNAME:MASTER,"의")% 팔을 쳐냈다.
			PRINTFORML
			PRINTFORML 「아, 있을 수 없습니다! 그런 곳까지 침범하다니...!」
			PRINTFORMW 여지만큼 굴욕적이었는지, 요우무는 눈에 눈물이 고인 채 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
			PRINTFORMW 접촉은 잠시뿐이었지만, 앞으로 시간을 들여 풀어 나가면 될 것이다...
		ENDIF
		RETURN 1
	ENDIF
	;アナルバイブ
	IF TEQUIP:アナルバイブ
		;「小刻みに震えるアナルバイブを前後に抜き差しした…」
		IF TALENT:恋慕
			IF ABL:Ａ感覚 > 4
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아, 아아앗! 후르르 떨리고 있어, 안쪽이…… 큭, 하윽, 아아앗! 후으읍」","L"
