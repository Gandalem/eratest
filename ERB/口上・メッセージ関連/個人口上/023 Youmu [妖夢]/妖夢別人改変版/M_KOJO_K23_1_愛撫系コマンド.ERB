LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW
		RETURN 1
		;泥酔
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「응... 후아, 아햣」","L"
			CALL HPH_PRINT,@"「그렇게 가슴을... 이제... HPH」","W"
