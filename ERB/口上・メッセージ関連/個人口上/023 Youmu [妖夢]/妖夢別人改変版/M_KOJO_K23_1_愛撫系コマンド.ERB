			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;VA挿入
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「음으, 츄, 하, 아…… HPH 음읍…… 흘러, 읏, 암HPH」","L"
						PRINTFORMW 격렬한 키스에 %조사처리(CALLNAME:MASTER,"의")% 한계를 느낀 요우무는 놓지 않겠다는 듯 혀를 얽어 되받아온다.
					CASE 1
