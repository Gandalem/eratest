RETURN RESULT

@M_KOJO_別人版_MESSAGE_COM_K23_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW
		RETURN 1
		;泥酔
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「……헤헤 후후 %CALLNAME:MASTER%씨의 손이……」","L"
			CALL HPH_PRINT,@"「몽롱해요…… 더, 더… 큭」","W"
		ELSE
			PRINTFORML 「으음…… 뭘……?」
			PRINTFORMW 「쓰려면, 등이… 안돼, 그런 곳은…」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「으응... 으윽... 흐읍」","W"
			PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 요우무의 가슴에 쓸듯이 손을 갖다 대자, 간지러운 듯 숨소리가 새어 나왔다.
			PRINTFORMW 닿은 손바닥으로 그녀의 심장이 울리는 소리가 전해져 왔다.
			PRINTFORML
			PRINTFORMW 「아하하…… 얼마나 긴장하고 있는지, 알 수 있어요……」
			PRINTFORMW 부끄러운 듯하면서도 시선을 피하지 않고 요우무는 %조사처리(CALLNAME:MASTER,"의")% 손 위에 자신의 손을 조용히 포갰다.
			PRINTFORML
			PRINTFORMW 「내 마음, 제대로 전해지고 있나요……? 아앗…… 응……」
			PRINTFORMW 빈 손으로 요우무를 끌어당겨 입맞춤한다.
			PRINTFORMW 스칠 정도의 얕은 키스를 계속하자, 끝날 무렵 그녀의 몸에서 긴장감은 풀려 있었다.
			PRINTFORML
			PRINTFORMW 「후우, 하아…… 상냥하시네요」
			PRINTFORMW 「%CALLNAME:MASTER%씨, 계속해 주세요…… 저라면 이제 괜찮으니까」
		ELSE
			PRINTFORMW 「응…… 으음, 으읍……」
			PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 요우무의 작은 가슴에 손을 가져가자, 간지러운 듯 몸을 비틀었다.
			PRINTFORMW 닿아있는 손끝에서 그녀의 긴장감이 역력하게 느껴졌다.
			PRINTFORML
			PRINTFORMW 「뭐예요…… 저 긴장하고 있다고요, 이런 경험 없으니까……」
			PRINTFORMW 홍조를 띤 요우무가 %CALLNAME:MASTER%에게서 휙 고개를 돌렸다.
			PRINTFORML
			PRINTFORMW 「야, 안…… 히아앗...!?」
			PRINTFORMW 요우무의 가녀린 몸에 정성스럽게 손가락을 미끄러뜨린다.
			PRINTFORMW 애무를 계속하며 반응을 살피자, 끝날 무렵에는 그녀의 숨이 크게 흐트러져 있었다.
			PRINTFORML
			PRINTFORMW 「하아, 하아…… 크으윽……!」
			PRINTFORMW 힘없이 노려오는 요우무에게, 아직 여유가 있을 것 같다고 %조사처리(CALLNAME:MASTER,"는")% 속으로 쾌재를 불렀다……
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;VA挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF TALENT:恋慕
				;V挿入ならV感覚5以上、A挿入ならA感覚5以上
				IF (TEQUIP:50 == PLAYER && ABL:Ｖ感覚 > 4) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 > 4)
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「흐, 아, 하으, 응아아……! 다 어디든 기분 좋아…… 오오오 HPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「후우, 햐앙, 하앗……흐으흑 아아…… 전부, 비벼보고 싶어 흐으흑」","L"
					ENDSELECT
					PRINTFORML 개발된 요우무의 육아구는 이제 허리를 움직이지 않아도 성기에 달라붙는다.
					PRINTFORMW 온몸을 농락당하며 흐트러지는 요우무의 치태가 욕정을 부추기고, %조사처리(CALLNAME:MASTER,"는")% 사정의 순간 단단함을 깊숙한 곳으로 밀어 넣었다.
				ELSE
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「후아, 응, 좋아……. 하프 아아, 안에……하프」","L"
						CASE 1
							CALL HPH_PRINT,@"「아, 쿠우흐으으... 손도, 안쪽도... 전부... 흐읍」","L"
					ENDSELECT
					PRINTFORML 조여오는 요우무의 육구멍은 삽입만 되어 있어도 기분이 좋다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 애무를 계속하며, 차오르는 사정감에 몸을 맡겼다.
				ENDIF
			ELSE
				PRINTDATAW
					DATAFORM 「하아, 아…… 조금은, 참아줘……. 어? 안, 안에서……!?」
					DATAFORM 「후우…… 크윽, 응...? 뭔가, 부풀어 오른 것 같아……」
				ENDDATA
			ENDIF
		ELSE
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아, 하윽…… 후우, 아으…… 응으…… HPH」","L"
						PRINTFORML 허리의 움직임을 느슨하게 하고 잠시 애무에 몰두한다.
						PRINTFORMW 은은하게 홍조를 띤 부드러운 살갗을 손바닥이 쓸어내릴 때마다, 음밀한 곳이 단단함을 더욱 삼키려 꿈틀거렸다.
					CASE 1
						CALL HPH_PRINT,@"「우아, 아아……윽! 안, 안돼요, %CALLNAME:MASTER%씨……흐흑」","L"
						CALL HPH_PRINT,@"「한 번에 당하면 너무 좋아서 HPH 어디까지가…… 나인 거야아, 히야아아HPH」","L"
						PRINTFORMW 쾌락으로 이완된 요우무의 표정에는 평소의 기개는 조금도 남아있지 않다.
					CASEELSE
						CALL HPH_PRINT,@"「히윽, 안 돼 HPH 그렇게 손가락으로... 잠깐, 잠깐만... 우아아앙 HPH」","L"
						PRINTFORML 강직하게 관통당한 희고, 유연한 암컷의 몸이 팔 안에서 관능적으로 떨린다.
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 손가락이 요우무에게 선사하는 쾌감을, 부풀어 오른 살들이 생생하게 전달해 온다.
				ENDSELECT
			ELSE
				PRINTFORML 「이, 아아…… 그만, 손, 멈추라고……읏!」
				PRINTFORMW 요우무는 힘없이 늘어진 손으로 필사적으로 %조사처리(CALLNAME:MASTER,"의")% 팔을 피하려 하고 있다……
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:6
			CASE 0
				CALL HPH_PRINT,@"「앗, 하으윽…… 응읏…… 파아흐햌」","L"
				CALL HPH_PRINT,@"「더…… 더 만져주세요…… HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「캬우우! 하아, %CALLNAME:MASTER%씨, 대단해요…… HPH」","L"
				PRINTFORMW 「당신 손, 기분 좋아서, 계속……힉아앙!」
			CASE 2
				CALL HPH_PRINT,@"「하아, 후아아…… 그런 곳만 만지면…… HPH」","L"
				PRINTFORMW 요우무의 적당히 탄력 있는 엉덩이살을 천천히 애무하며, 빨아들이는 듯한 감촉을 만끽했다.
			CASE 3
				CALL HPH_PRINT,@"「히야…… 웃, 간지러워요…… 안아앗」","L"
				PRINTFORMW 요우무의 목덜미를 휘감아 어깨 뒤로 얼굴을 묻고, 몇 번이고 입술을 떨어뜨린다…….
			CASE 4
				CALL HPH_PRINT,@"「츄……응!? 퍄앗…… 그, 그렇게 만져지니까……. HPH」","L"
				PRINTFORMW 입맞춤을 나누며 안쪽 허벅지에서 사타구니 쪽으로 쓸어 올리자, 무심코 입술을 뗀 요우무에게서 정욕이 가득한 숨결이 새어 나왔다.
			CASE 5
				PRINTFORML 「앗, 거기, 또, 좋아……응으음읏!」
				PRINTFORMW 민감한 부위에 %조사처리(CALLNAME:MASTER,"의")% 손이 닿을 때마다 요우무는 몸을 작게 떨고 있다.
		ENDSELECT
		;それ以外
	ELSE
		PRINTDATAW
			DATAFORM 「후읍…… 윽, 참는 건…….」
			DATAFORM 「응아, 우…… 느끼고 같은 건……윽」
			DATAFORM 「힉…… 와, 타인의 몸을, 뭐라고 말하는 거지……」
		ENDDATA
	ENDIF
ENDIF
RETURN 1
