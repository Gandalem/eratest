			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 절벽에서는 이렇게 가보지 못할 것이라 강하게 요우무의 가슴을 주물렀다
		ENDIF
		RETURN 1
	ENDIF
	;VA挿入
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF TALENT:恋慕
				;B感覚5以上、且つV挿入ならV感覚5以上、A挿入ならA感覚5以上
				IF ABL:Ｂ感覚 > 4 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 > 4) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 > 4)) && RAND:2 == 0
