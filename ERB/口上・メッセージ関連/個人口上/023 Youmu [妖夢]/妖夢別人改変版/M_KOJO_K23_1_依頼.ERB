;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「언제부터인가 떨어뜨려 버린 것 같아서……」
		IF TALENT:恋慕
			PRINTFORMW 「부디, 수색에 힘을 빌려 주실 수 없을까요……?」
		ELSE
			PRINTFORMW 「저도 찾고는 있지만, 하루라도 빨리 찾고 싶어요...!」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋慕
			PRINTFORMW 「우…… 혹시 스케줄에 여유가 생기시면, 한번 고려해 주시면 감사하겠습니다……」
		ELSE
			PRINTFORMW 「그, 그런가요…… 조금 더 혼자 찾아보겠습니다……」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:恋慕
			PRINTFORML 「아, 감사합니다!」
		ELSE
			PRINTFORML 「도, 도움 됐어요!」
		ENDIF
		PRINTFORMW 「그렇다고 명확한 단서를 드리지 못하기에, 어려운 의뢰가 될지도 모른다」
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		IF TALENT:恋慕
			PRINTFORML 「에, 아……. 사정이 좋지 않다면 어쩔 수 없다. 원래는 나의 실책이니…….」
			PRINTFORMW (저런 자의 단서로는 무리한 요구일 뿐인가……)
		ELSE
			PRINTFORMW 「그, 그렇습니까…… 잠시 혼자 찾아보겠습니다……」
		ENDIF
		RETURN 1
	CASE "依頼実行直前"
		;【◆口上】
		;【W あたりを探していた［あなた］はついに探していた落とし物を発見した】
		;【▼そのまま下の口上へ】
		IF ROLE == "CLIENT"
			;依頼主である口上主と一緒に発見した場合
			IF TALENT:恋慕
				PRINTFORMW 「여기서 발견해 주면 좋을 텐데요…… 아앗, 그건!?」
			ELSE
				PRINTFORMW 「여기는 한 번 찾아봤는데……엣!?」
			ENDIF
			PRINTFORML
			RETURN 1
		ELSEIF ROLE == "TARGET"
			;発見した時、依頼主ではない口上主がTARGETの場合
			IF TALENT:恋慕
				PRINTFORML 「? %CALLNAME:MASTER%씨, 뭔가 찾고 있는 건가요...?」
			ELSE
				PRINTFORML 「어라, 그런 곳에서 뭘……?」
			ENDIF
			PRINTFORMW 「……그렇군요, 의뢰로 분실물을. 그런 일이라면 미약하지만 저도 힘이 되어 드릴게요!」
			PRINTFORML
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF ROLE == "CLIENT"
			;依頼主である口上主と一緒に発見した場合
			IF TALENT:恋慕
				PRINTFORMW 「분명 제가 떨어뜨린 거예요!」
			ELSE
				PRINTFORMW 「그런 곳에 있었다니……!」
			ENDIF
			RETURN 1
		ELSEIF ROLE == "TARGET"
			;発見した時、依頼主ではない口上主がTARGETの場合
			IF TALENT:恋慕
				PRINTFORMW 「오오…… 역시 %CALLNAME:MASTER%씨, 제 손은 필요 없으셨군요」
			ELSE
				PRINTFORMW 「엣, 벌써 찾아내셨어요? 대단한 손놀림이네요……」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：上級素材2つ
		PRINTFORML 「%CALLNAME:MASTER%씨, 정말 감사했습니다!」
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORMW 「또 뭔가 떨어뜨리면…… 아우, 이건 안 좋은 방심이네요……」
		ELSE
			PRINTFORMW 「다음에도…… 아니, 다음엔 없을 것처럼 조심할게요……」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		PRINTFORM 못 찾으셨나요……
		IF TALENT:恋慕
			PRINTFORML 애초에 자업자득이니, 부디 신경 쓰지 마세요.
			PRINTFORMW (반대로 생각해 보자... %CALLNAME:MASTER%씨가 찾을 수 없다면, 저 가게 주인으로는 도저히 찾을 수 없을 거야)
		ELSE
			PRINTFORML 자업자득이라고는 하지만, 유감이다…….
			PRINTFORMW (......다음엔 고철 나르기인가......)
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
