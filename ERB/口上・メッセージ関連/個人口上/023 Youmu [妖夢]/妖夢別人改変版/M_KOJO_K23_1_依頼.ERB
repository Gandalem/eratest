;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_別人版_IRAI_6_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORML 「알고 싶은 게 있는데요, 저 혼자 찾아봐도 잘……」
			PRINTFORMW 「%CALLNAME:MASTER%라면 정확히 알고 계시지 않을까 해서요」
		ELSE
			PRINTFORMW 「정말 궁금한 게 있어서……. %CALLNAME:MASTER%씨, 알고 계신가요?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORML 「모처럼 왔는데, 같이 찾아보는 게 효율이 좋잖아요」
					PRINTFORMW 「뭔가 단서 같은 거라도 발견했으면 좋겠는데요……」
					PRINTFORML
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				IF TALENT:恋慕
					PRINTFORMW 「%TEXTR("흠흠/호오호오/")%……이렇게나 자세히 설명해 주시다니, 역시 %CALLNAME:MASTER% 씨께 여쭤보길 잘했어요」
				ELSE
					PRINTFORMW 「오, 그런 거였군요…… 박식하시네요……」
				ENDIF
				PRINTFORML
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				IF TALENT:恋慕
					PRINTFORML 「……응? 어라…… 그, 그랬었나아?」
					PRINTFORMW (%CALLNAME:MASTER%씨의 설명이 갑자기 흐트러지기 시작했다...!? )
				ELSE
					PRINTFORMW 「응? 그럼 뭔가 말이 안 되는데……?」
				ENDIF
				PRINTFORML
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		PRINTFORML 「폐를 끼치게 해버려서 죄송해요……」
		IF TALENT:恋慕
			PRINTFORMW (%CALLNAME:MASTER%님이라도 어렵다고 하니, 이건 골치 아파질 것 같아……)
		ELSE
			PRINTFORMW 「한 번 더 스스로 다시 조사해 볼게요」
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
