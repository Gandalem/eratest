;依頼口上・一般依頼07：大掃除が終わらない
;==================================================

@M_KOJO_別人版_IRAI_7_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋慕
			IF MAIN_MAP == 6 && INRANGE(CFLAG:MASTER:初期位置, 623, 625)
				PRINTFORML 「%CALLNAME:MASTER%씨, 저택 대청소할 때예요!」
			ELSE
				PRINTFORML 「%CALLNAME:MASTER%씨, 올해도 대청소의 시기가 왔어요!」
			ENDIF
			PRINTFORMW 「어디서부터 해야 할지 고민하고 있었는데, 가장 먼저 눈에 들어온 곳이 제 방이라……」
		ELSE
			PRINTFORMW 「이 행사를 끝내지 않고는 해를 넘길 수 없어요!」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋慕
			PRINTFORMW 「흐으…… 뭐, 청소는 원래 제 일이고, 그게 제 방이라면 더더욱이니까…… 신경 쓰지 말아 주세요」
		ELSE
			PRINTFORMW 「우…… 서둘러 정리하고 싶었는데, 무리하게 할 수는 없겠네요……」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:恋慕
			IF MAIN_MAP == 6 && INRANGE(CFLAG:MASTER:初期位置, 623, 625)
				PRINTFORMW 「감사합니다. 그럼 서둘러 마무리하고 다른 곳 청소하러 가야겠어요!」
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%님이랑이라면 금방 치울 수 있을 것 같아요, 겸사겸사 저택 대청소도……」
			ENDIF
		ELSE
			PRINTFORMW 「받아주실 수 있나요? 조금이라도 인력이 필요해서 정말 도움이 됐어요……」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			PRINTFORMW 「어라? 깨끗해졌네……」
			PRINTFORML
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して徹底的に部屋を掃除した】
			;【▼そのまま下の口上へ】
			IF TALENT:恋慕
				PRINTFORML 「평소에는 신경 쓰기 힘든 곳을 의식하고 싶네요. 예를 들면 이런 곳 같은 거……」
				PRINTFORM 요우무는 반령으로
				PRINTDATAW
					DATAFORM 능숙하게 천장에 걸린 걸 쓸면서, 떨어져 내려온 먼지를 쓸어 모으고 있다…….
					DATAFORM 머리 속 공간을 확인하고 있다. 저쪽은 상당히 비좁아 보인다…….
					DATAFORM 아래 주머니 안쪽을 확인하고 있다. 저쪽은 조금 비좁아 보인다…….
				ENDDATA
			ELSE
				PRINTFORMW 「좋은 기회니까, 힘내서 해보자고!」
			ENDIF
			PRINTFORML
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\1500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		PRINTFORMW 「도와주셔서 정말 감사해요!」
		IF TALENT:恋慕
			IF MAIN_MAP == 6 && INRANGE(CFLAG:MASTER:初期位置, 623, 625)
				PRINTFORML 「저도 확인은 할게요, 혹시 저택 안에서 더 더러워진 곳을 발견하시면 청소해 주시면 감사하겠습니다」
				PRINTFORMW 「저택의 유령들에게는 기대할 수 없으니까……」
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%님이 계신 곳에서 대청소할 때 사람이 부족하면, 저도 도와드리고 싶어요!」
			ENDIF
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%씨도 새해를 맞이하기 전에 한 번, 방을 구석구석 청소해보는 건 어때?」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
