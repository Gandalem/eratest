; Modular ERB: 個人口上/023 Youmu [妖夢]/妖夢別人改変版/M_KOJO_K23_1_依頼.ERB
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_別人版_IRAI_K23(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_別人版_IRAI_%IRAI_NAME%_K23(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_別人版_IRAI_{CHK_ID}_K23(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		IF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%씨, 혹시 시간 괜찮으시면 부탁드리고 싶은 게 있는데요……」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%씨, 잠시 괜찮으세요?」
		ENDIF
	CASE "依頼非受託時"
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
		IF TALENT:恋慕
			PRINTFORMW 「갑자기 이러시면 약속 잡기도 어렵잖아요…… 죄송했어요」
		ELSE
			PRINTFORMW 「그렇군요…… 갑자기 부탁받아도 곤란하죠」
		ENDIF
	CASE "依頼受託時"
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORMW 「감사합니다! 그럼 잘 부탁드려요」
		ELSE
			PRINTFORMW 「받아주실 수 있으세요? 정말 감사합니다!」
		ENDIF
	CASE "依頼確認時"
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORMW 「확인은 중요하죠. 저도 장 볼 때 신경 쓰고 있어요」
		ELSE
			PRINTFORMW 「확인인가요? 애매하게 둘 수는 없으니까 말이에요」
		ENDIF
	CASE "依頼破棄時"
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		IF TALENT:恋慕
			PRINTFORMW 「혹시 다른 약속이 있으신가요...? 그렇다면 주저 말고 그쪽을 우선해 주세요」
		ELSE
			PRINTFORMW 「일정이 맞지 않으셨나요…… 아니에요, 신경 쓰지 말아 주세요」
		ENDIF
	CASE "依頼実行直前"
		;●[367]で依頼を実行する時、実行処理の前に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【◆口上】
		;【実行時の地の文・ソース等】
		;【▼下の口上に続く】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		ENDIF
	CASE "依頼実行直後"
		;●[367]で依頼を実行する時、実行処理の後に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【▲上の口上から続き】
		;【◆口上】
		;【達成時・CLIENT：▼下の口上に続く】
		;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ENDIF
	CASE "成功報告時"
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		PRINTFORML 「감사했습니다!」
		IF TALENT:恋慕
			PRINTFORMW 「감사 인사를 전하기엔 보잘것없지만…… 부디 받아주세요」
		ELSE
			PRINTFORMW 「소박한 감사 표시이긴 하지만……」
		ENDIF
	CASE "失敗報告時"
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
		PRINTFORML 「%CALLNAME:MASTER%씨, 의뢰했던 건 말인데……」
		IF TALENT:恋慕
			PRINTFORMW 「에…… 그, 그랬군요. 다음에는 그런 점을 알려주시면 하고 싶어서요……」
		ELSE
			PRINTFORMW 「에, 잊고 있었다니…… 거긴 적당히 하는 게 좋지 않겠어요」
		ENDIF
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
ENDSELECT
RETURN 1
;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================

@M_KOJO_別人版_IRAI_1_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋慕
			PRINTFORMW 「부끄럽지만 혼자서는 꽤 시간이 걸릴 것 같아서, 도움을 주시면 좋겠어요……」
		ELSE
			PRINTFORMW 「제 방 청소에 애를 먹고 있어서, 손을 빌릴 수 있을까 해서요……」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:恋慕
			PRINTFORMW 「감사합니다! %CALLNAME:MASTER%님과 둘이시면 분명 금방 처리할 수 있을 거예요」
		ELSE
			PRINTFORMW 「원래는 혼자 처리해야 하는데…… 체면이 없네요」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			PRINTFORMW 「어라? 깨끗해졌네……」
			PRINTFORML
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			IF TALENT:恋慕
				PRINTFORMW 「저기요…… 그 부분은 제가 할 테니, 다른 곳 위주로 부탁드려도 될까요?」
				PRINTFORML
			ELSE
				PRINTFORMW 「개인 물품은 적은 편이니, 부담 없이 부탁드려요!」
				PRINTFORML
			ENDIF
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:恋慕
			PRINTFORML 「예뻐지셨군요, 감사했습니다!」
			PRINTFORMW 「에엣... 별, 특별한 건 없어요. 아무것도 없습니다.」
		ELSE
			PRINTFORMW 「이런 곳일까요? 고마웠어요」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		PRINTFORML
		PRINTFORML 「게다가, 이런 물건이 대체 언제 스며든 걸까요...?」
		PRINTFORMW 「관심이 있으신가요? 그렇다면 부담 없이 가져가세요. 저로서는 활용할 수 없을 것 같아서요.」
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼02：お花に水をあげて
;==================================================

@M_KOJO_別人版_IRAI_2_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「어제 물 주기를 깜빡하고 말았어요……」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		PRINTFORML 「이런 사소한 일을 맡겨버려서 죄송해요……」
		IF TALENT:恋慕
			PRINTFORML 「아마 흙이 말았으니까, 어느 화분인지는 금방 알 수 있을 거예요」
			PRINTFORMW 「불안하시다면 제가 다시 확인해 드릴 테니, 필요할 때 말씀해주세요」
		ELSE
			PRINTFORMW 「흙이 말라 있어서 어느 화분인지 금방 알 수 있을 거예요」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;【◆口上】
		;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
		;【▼そのまま下の口上へ】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			;この場合はそのまま下の口上へ続きます
			SELECTCASE RAND:(TALENT:恋慕 ? 5 # 3)
				CASE 0
					PRINTFORML 「이 화분은 본래 그렇게 물을 많이 주지 않아도 되고, 손질도 간단하답니다」
					PRINTFORMW 「장식용으로는 모범생이라고 평가받을 수 있을 거예요」
				CASE 1
					PRINTFORML 「이건 영 까다로운 화분인데…… 시들지 않아서 다행이야」
					PRINTFORMW 「정성 들여 키운 풀과 나무는 언제 봐도 아름다운 법이지」
				CASE 2
					PRINTFORML 「당연히, 식물마다 적합한 흙의 습도는 다양하다」
					PRINTFORMW 「이 화분은……아, 이것은 대충 해도 괜찮겠네요」
				CASE 3
					PRINTFORML 「물이 필요한 건…… 이 화분하고 저 화분하고 그리고 저쪽 화분까지――」
					PRINTFORMW 「이, 이 쪽 화분도요. 제가 너무 소홀히 했네요……」
				CASE 4
					PRINTFORML 「응응…… 정말 잘하시네요, %CALLNAME:MASTER%씨」
					PRINTFORMW 「의외로 신경 쓰이는 작업이거든요. 너무 과하면 뿌리가 썩는 원인이 될 수도 있어요」
			ENDSELECT
			RETURN 1
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			PRINTFORML 「어라, %조사처리(CALLNAME:MASTER,"가")% 물을 주는 거야?」
			IF MAIN_MAP == 6 && CFLAG:MASTER:現在位置 == 623
				PRINTFORMW 「……과연, 유유코님으로부터. 일을 대신 맡아버렸네요, 감사합니다」
			ELSE
				PRINTFORMW 「……과연, 부탁받은 거군요. 수고하셨습니다」
				SELECTCASE RAND:5
					CASE 0, 1
						PRINTFORMW 「그래도 이 화분을 정말 잘 관리하고 계시네요, 소중하게 키우고 있는 것 같아요」
					CASE 2, 3
						PRINTFORMW 「그래도 이 화분은…… 집주인이 꽤 희귀한 걸 키우는 것 같아」
					CASE 4
						PRINTFORMW 「하지만, 이건 대체 뭐야...? 저, 이런 식물은 나도 본 적이...」
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
