;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_別人版_IRAI_12_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「이런 일은 스스로 나서는 게 도리이긴 한데, 저택 일이 밀려서……」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労中（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			;ブチギレ
			IF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
				PRINTFORML 「……나를 혼내주러 온 거야?」
				PRINTFORMW 「……」
				PRINTFORMW 「의뢰인에게는 감사드려야겠네요」
			ELSE
				PRINTFORML 「하아, 대리해서 저를 혼내주러 오신 건가요」
				PRINTFORMW 「의뢰인께는 외출할 수 없는 급한 용무라도 있었던 걸까요……?」
				IF TALENT:恋慕
					PRINTFORMW 「어쨌든, 상대가 %CALLNAME:MASTER%씨라 할지라도 봐주진 않을 거예요!」
				ELSE
					PRINTFORMW 「아무튼 단련의 기회가 늘었다고 생각하고 있겠어요!」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				IF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
					PRINTFORMW 「어느 정도는 속이 시원해지겠나 하고 기대했는데……」
				ELSE
					PRINTFORML 「의뢰인에게 전해 주세요」
					PRINTFORMW 「다음부터는 직접 나오도록 하고라고요」
				ENDIF
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
				PRINTFORMW 「흡…… 제가 졌어요」
			ELSE
				PRINTFORML 「도착하지 않았나요…… 전력을 다해 도전한 이상, 변명은 하지 않을 거예요」
				PRINTFORMW 「뭔가 증거가 될 만한 걸…… 저기, 반령은 가지고 가면 안 돼요!?」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
