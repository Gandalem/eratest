;依頼口上・一般依頼04：料理上手になりたい
;==================================================

@M_KOJO_別人版_IRAI_4_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「부디, %CALLNAME:MASTER%씨의 기술을 조금이라도 배우고 싶어서요」
		IF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%님과 유유코님, 두 분 모두 만족하실 만한 요리를 만들고 싶으니까요!」
		ELSE
			PRINTFORMW 「유유코님께 만족시켜 드릴 수 있도록, 아직 수행은 게을리할 수 없어요!」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋慕
			PRINTFORMW 「에…… 저, 혹시 이미 약속 있으세요? 그렇다면 다른 날 다시 오겠습니다……」
		ELSE
			PRINTFORMW 「에…… 그, 그러시죠. %CALLNAME:MASTER%님도 약속이 있으실 테니까……」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		IF TALENT:恋慕
			PRINTFORMW 「에…… 혹시, 사정이 안 좋으셨던 건가요? 그렇다면 다른 기회에 다시 오겠습니다……」
		ELSE
			PRINTFORMW 「에……. 그, 그렇죠. %CALLNAME:MASTER%씨에게도 사정이 있으시니까……」
		ENDIF
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		IF TALENT:恋慕
			PRINTFORML 「준비해 온 건 맞지만, 재료는 저희가 준비했으니」
			PRINTFORMW 「이걸로 뭐가 만들어질지 포함해서 지도 부탁드려요네」
		ELSE
			PRINTFORML 「그럼, 지도 부탁드려요」
			PRINTFORMW 「뭘 만들지도 %CALLNAME:MASTER%씨에게 맡길게요」
		ENDIF
		PRINTFORML
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:恋慕
			PRINTFORML 「넋 놓고 바라보게 되는 솜씨였어요, %CALLNAME:MASTER%씨!」
			PRINTDATAW
				DATAFORM 「가르쳐 주신 건 나중에 글로 적어 두지 않으면 안 되는데……」
				DATAFORM 「추가 요금이라도 한 가지 더 가르쳐 주시거나…… 아, 안 되는 거죠?」
			ENDDATA
		ELSE
			PRINTFORML 「이걸로 완성입니다.」
			PRINTFORMW 「음... 훌륭한 솜씨였습니다.」
		ENDIF
		PRINTFORML
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		IF TALENT:恋慕
			PRINTFORML 「이 요리가 보상이라니…… 조금 동경해 버리겠어요」
			PRINTFORMW 「설마, %CALLNAME:MASTER%앞에서는 그런 큰소리는 못 내잖아요」
		ELSE
			PRINTFORML 「감사했습니다! 그럼 답례를……」
			PRINTFORMW 「엣, 이걸로 괜찮으세요? 저, 뭔가 몸 둘 바가 없네요……」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
