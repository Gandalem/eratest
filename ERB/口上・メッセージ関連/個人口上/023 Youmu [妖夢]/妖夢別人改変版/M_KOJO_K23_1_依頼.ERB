;依頼口上・一般依頼16：お悩み相談
;==================================================

@M_KOJO_別人版_IRAI_16_K23(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORMW 「고민하고 계신다고 할 만큼 대단한 일은 아니지만, %CALLNAME:MASTER%님의 의견을 여쭤보려고 해요……」
		ELSE
			PRINTFORMW 「사소한 일인데요, 어떻게든 저 스스로는 결정하기가 어려워서요……」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		PRINTFORMW 「정말 중요한 건 아니니까, 그렇게 경계하지 않아도 되는데……」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「에, 에에? 하아, 알았어요……」
		PRINTFORMW (그렇게 힘든 부탁이었나……?)
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		IF TFLAG:193 == 1
			;正解の選択肢
			PRINTFORML 「흠, 그렇군……」
			PRINTFORMW 「확실히 말씀하신 대로입니다. 통찰력이 있으시군요」
		ELSEIF TFLAG:193 == 2
			;ハズレの選択肢だったが逆に正解
			PRINTFORML 「에엣, 그건 아무리 그래도……」
			PRINTFORMW 「하지만 다시 들으니, 그것도 나쁘지 않을지도 모른다는 생각이 드네요……」
		ELSEIF TFLAG:193 == -1
			;ハズレの選択肢
			PRINTFORMW 「음…… 그건 영 마음에 안 드네요……」
		ELSEIF TFLAG:193 == -2
			;正解の選択肢だったが逆にハズレ
			PRINTFORMW 「저도 처음에는 그렇게 생각했었는데, 점점 납득이 안 가고 있어서……」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：野菜か果物
		RETURN 0
	CASE "失敗報告時"
		PRINTFORMW 「시간을 들게 해서 죄송했어요……」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "口上委託率"
		;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
		RESULT:100 = 0
		;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
		;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
		;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
		;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
		RESULT:1 = 0
		RESULT:2 = 0
		RETURN 1
	CASE "口上専用"
		;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
		;16,お悩み相談 の場合
		;RESULT        発生判定,0だと発生しません
		;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
		;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
		;RESULTS:0     お悩み文章（自動で『』で囲まれます）
		;RESULTS:1～3  選択肢１～３
		;何も発生しない状態になると無限ループになるので注意してください
		;●追記メモ
		;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
		;RESULT:1を7にするとどれも正解になります
		;RESULT:1を8にするとどれもハズレになります
		;1～3以外の場合は逆張り判定が自動で無くなります
		RESULT = 0
		;▼サンプル
		SIF !RESULT
			RESTART
		RETURN 1
ENDSELECT
