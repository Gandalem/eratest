@M_KOJO_別人版_MESSAGE_MESSAGECHECK_COM_K23_40
RETURN 0

@M_KOJO_別人版_MESSAGE_COM_K23_40
CALL M_KOJO_別人版_MESSAGE_COM_K23_40_1
RETURN RESULT

@M_KOJO_別人版_MESSAGE_COM_K23_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW
		RETURN 1
		;泥酔
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕
			PRINTFORML 「으음... %CALLNAME:MASTER%씨, 그건...」
			CALL HPH_PRINT,@"「대단한 소리네요~, 뭐에――엣!? 후오오오HPH」","W"
		ELSE
			PRINTFORML 「음, 으... 이게 무슨 소리야...」
			PRINTFORMW 「...? 그런 게 뭘 위해--아, 아아악!?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF CFLAG:23:2004 == 0
			IF TALENT:恋慕
				PRINTFORML 「어라? 그거......」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 꺼낸 로터에 요우무가 이상하다는 듯 고개를 갸웃거렸다.
				PRINTFORML
				PRINTFORML 「생물...이잖아요? 어째서 그런 걸...?」
				PRINTFORMW 아무래도 요우무는 곳곳에서 보는 로터를 정말 생물이라고 오해하고 있는 듯하다.
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 그녀에게 이 도구의 정체와 용도를 제대로 설명했다...
				PRINTFORML
				PRINTFORMW 「뭐라고? ……?? ……에엣!? 이거 그런 장난감이었나요!?」
				PRINTFORML 「아니, 왜냐하면…… 평범하게 풀숲 같은 곳에 있는데, 게다가 잡혔다니……!」
				PRINTFORMW 「……？　…………？？？」
				PRINTFORML
				PRINTFORML 너무 충격적이었는지, 당황하는 요우무는 기억과 정보의 정합성을 맞추지 못하고 주저앉아 있다.
				PRINTFORMW 정신을 차릴 때까지 지켜보는 것도 재미있겠지만, %조사처리(CALLNAME:MASTER,"는")% 감각을 익히기 위해 로터 사용법을 실습하기로 했다.
				PRINTFORML
				PRINTFORMW 「츠모가미의 일종... 응? 이 소리는...」
				CALL HPH_PRINT,@"「흐으윽!? 아, 저, 저렇게 떨고 있는 걸, 억지로 밀어붙이는 건... 하아아 HPH」","W"
			ELSE
				PRINTFORML 「……그것은……」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 꺼낸 로터에 요우무가 의심스러운 듯 눈을 가늘게 뜬다.
				PRINTFORML
				PRINTFORML 「어째서 그런 생물을……?」
				PRINTFORMW 아무래도 요우무는 곳곳에서 보는 로터를 정말 생물이라고 오해하고 있는 것 같다.
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 그녀에게 이 도구의 정체와 용도를 설명했다……
				PRINTFORML
				PRINTFORMW 「뭐라고? ……?? ……에엣!? 이거 그런 장난감이었나요!?」
				PRINTFORML 「아니, 왜냐하면…… 평범하게 풀숲 같은 곳에 있는데, 게다가 잡혔다니……!」
				PRINTFORMW 「……？　…………？？？」
				PRINTFORML
				PRINTFORML 아무래도 충격적이었는지, 당황하는 요우무는 기억과 정보의 정합성을 맞추지 못해 낙담하고 있다.
				PRINTFORMW 정신을 차릴 때까지 지켜보는 것도 시간 낭비이므로, %조사처리(CALLNAME:MASTER,"는")% 알아두기 위해서 로터 사용법을 실천하기로 했다.
				PRINTFORML
				PRINTFORMW 「그런 말도 안 되는 일이……응? 이 소리는……」
				PRINTFORMW 「우아악!? 그, 나, 이렇게 떨리다니! 들어줘, 싫어!?」
			ENDIF
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「그, 그건...!」
				PRINTFORML 「...%CALLNAME:MASTER%씨 덕분에 이것이 손으로 가지고 노는 장난감인 건 이해했습니다만」
				PRINTFORMW 「오히려 이게 환상향에 평범하게 생존하고 있는 게 불가해해서요... 아, 아니에요, 천연인지 양식인지는 별로...」
				CALL HPH_PRINT,@"「저기, 그럼 가슴에--엣!? 에, 와, 그쪽에는 자극이... 으아, 아아아아 HPH」","W"
			ELSE
				PRINTFORMW 「흐, 그건……」
				PRINTFORML 「본래의 용도를 알려주신 점은 감사합니다. 이 자리 외에서 망신을 당하지 않았으니.」
				PRINTFORMW 「하지만……부속(付喪)도 아닌 도구들이 산하를 떠돌고 있다니, 역시 이상이라고밖에」
				PRINTFORMW 「새로운 이변의 조짐이 아닐까—윽!? 저, 저쪽은 달라, 윽, 으아아악!」
			ENDIF
		ENDIF
		CFLAG:23:2004 = 1
		RETURN 1
	ENDIF
	;VA挿入
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			;C感覚5以上、且つV挿入ならV感覚5以上、A挿入ならA感覚5以上
			IF ABL:Ｃ感覚 > 4 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 > 4) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 > 4))
				IF TALENT:恋慕
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「에헤, 에헤헤... HPH 같이 뒤섞이게 되니, 응옷... 아, 머리 쪽이, 으응HPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「히끅, 아아아, 으아아 HPH 하, 하하윽, 이상해... 응우, 즈우웅 HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「응, 아아, 어디로든 해줘 HPH 이기, 후아, 아앗... 아아아HPH」","L"
					ENDSELECT
					PRINTFORML 개발된 육아구가 로터에 괴롭힘당하는 음핵에 동조하여, 애욕의 살을 떨며 씨앗을 갈망하고 있다.
					PRINTFORMW 마음껏 쾌락을 누리며 미쳐버린 요우무처럼 열정을 부추겨, %조사처리(CALLNAME:MASTER,"는")% 절정의 순간 로터와 손가락으로 가둔 클리토리스를 움켜쥐었다.
				ELSE
					PRINTDATAL
						DATAFORM 「헉, 아아아...... 그만, 제발어엉!」
						DATAFORM 「윽, 음으... 어, 왜 나한테... 윽, 아아, 아아아악!」
					ENDDATA
					PRINTFORML 이미 내리꽂히는 쾌락에 저항하는 것을 그만둔 육구와 음핵에 본인의 의사가 개입할 여지는 없다.
					PRINTFORMW 괴로워하는 듯한 숨소리 속에 잠긴 색정을 확실히 느낀 %조사처리(CALLNAME:MASTER,"는")% 절정의 순간 클리토리스를 짓누르듯 로터를 밀어붙였다.
				ENDIF
			ELSE
				IF TALENT:恋慕
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「응, 으윽, 이, 이게 둘 다면, 꽤나…… 으으…… HPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「아, %CALLNAME:MASTER%씨, 도구는 일단…… 앗, 그런 곳은……! HPH」","L"
					ENDSELECT
					PRINTFORML 서서히 격렬해지는 허리 사용과 무기질적인 진동을 동시에 받아들이기에는 아직 약간 여유가 부족한 모양이다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 음핵에 로터를 대는 각도를 바꾸면서 사정을 유도하려는 매혹적인 육체의 봉사에 몸을 맡겼다.
				ELSE
					PRINTDATAL
						DATAFORM 「윽, 으윽, 으음... 그만해줘...!」
						DATAFORM 「흐읍, 안 돼... 이대로는...」
					ENDDATA
					PRINTFORML 동시에 공격당하고 있는 상황에서, 요우무에게 로터로부터의 자극은 아직 과도한 기색이 있었다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 마지못해 로터를 밀어붙이는 힘을 풀고, 겨우 적절해진 육구의 조임으로 사정을 했다.
				ENDIF
			ENDIF
		ELSE
			IF ABL:Ｃ感覚 > 4 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 > 4) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 > 4))
				IF TALENT:恋慕
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「윽, 음으... 히이이 HPH 기분 좋아지고, 받고 있나요, 응우우 HPH」","L"
							PRINTFORML 로터의 진동이 부드러운 살을 통해 안쪽까지 전달되는 흥분감까지 전해져 온다.
							PRINTFORMW 음핵에 가해지는 끊임없는 자극으로 파르르 떨고 있는 \@ TEQUIP:50 == PLAYER ? 살결 # 장벽 \@이 정확한 봉사를 계속하고 있다.
						CASE 1
							CALL HPH_PRINT,@"「흐윽, 후우, 아아앙 HPH, 그, 그렇게 하면... 크윽, 좋아 HPH」","L"
							PRINTFORMW 발기한 음핵이 로터에 괴롭힘당하고, 육봉을 감싼 부드러운 살들이 파르르 떨리고 있다.
						CASE 2
							CALL HPH_PRINT,@"「하아, 하아... 하아아 HPH 넣어주시면서 하는 건 혼자서는 할 수 없으니까요... HPH」","L"
							CALL HPH_PRINT,@"「아아, 이, 기이... 이 느낌이... 컥, 아아앙아앙」","W"
					ENDSELECT
				ELSE
					PRINTDATAL
						DATAFORM 「크, 앗, 저... 그런 물건을...!」
						DATAFORM 「윽, 음... 제발, 놓아줘... 엣」
					ENDDATA
					PRINTFORML 요우무가 얼마나 느끼고 있는지는 \@ TEQUIP:50 == PLAYER ? 몸을 휘감는 살결 # 꿈틀거리는 장벽 \@이 대신 말해주고 있다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 음핵에 대한 자극으로 작게 경련하는 요우무의 육구멍을 천천히 즐겼다.
				ENDIF
			ELSE
				IF TALENT:恋慕
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「응으, 윽...... HPH 이거, 뭐라고 해야 할지......?」","L"
						CASE 1
							CALL HPH_PRINT,@"「윽, 우아......! HPH, 진동이...... 좀 너무 강한 거 아닐까요......」","L"
					ENDSELECT
					PRINTFORML 어느 쪽도 아닌 상황에 익숙하지 않은지, 요우무의 모습에서는 당혹감이 느껴진다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 움직임을 늦추고, 주위를 배회하는 몸에 조금씩 쾌감을 심어주기로 했다.
				ELSE
					PRINTDATAL
						DATAFORM 「크윽, 아...... 하나, 세...!」
						DATAFORM (흡, 으윽...... 빼내지 않으면......!)
					ENDDATA
					PRINTFORMW 로터로부터의 진동에 몸을 비트는 요우무의 움직임이 예상치 못한 쾌감을 전해온다……
				ENDIF
			ENDIF
		ENDIF
		;基本セット
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:Ｃ感覚 > 4
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음으, 아앗, 히잉 HPH 코, 이거... 자기 손가락보다 더 좋아요오 우우HPH」","L"
					PRINTFORMW 로터가 발산하는 가차 없는 진동의 전부가 쾌감이 되어, 요우무의 음핵을 기계적으로 몰아붙인다.
				CASE 1
					CALL HPH_PRINT,@"「아하핫, 대단해, 좋아... 주물러지니까 기분이 좋아서... 큭, 아아앙」","L"
					PRINTFORML 강하게 음핵에 밀착된 로터로 넘쳐흐른 애액이 침처럼 히비너를 적신다.
					PRINTFORMW 비천한 점액이 수지 재질의 무기적인 광택마저 장식하고, 지극히 관능적인 양상을 만들어내고 있다……
				CASE 2
					PRINTFORML 「에... 에에!? 그, 그것이 천연인지 양식인지 말입니까...?」
					CALL HPH_PRINT,@"「……모습이 다르다니――우아악!? HPH 저, 이러면 집중 같은 건, 무리야아아앙HPH」","L"
					PRINTFORMW 사실 %CALLNAME:MASTER%에게도 그 차이는 모르지만, 끊임없는 괴롭힘에 노출되면서도 요우무는 성실하게 생각하는 것 같다.
			ENDSELECT
		ELSEIF ABL:Ｃ感覚 > 2
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「응응, 아아, 이건... 오, 생각보다, 좋겠어... HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「조금 격렬하다고 생각하긴 하지만... 앗, 저는 이렇게는... 갈 수 없거든요 하아흣」","L"
			ENDSELECT
			PRINTFORMW 요우무는 자신의 손으로는 이룰 수 없는 규칙적인 진동에서 쾌감을 느끼기 시작한 것 같다.
		ELSE
			PRINTDATAL
				DATAFORM 「으윽, 끅... 좀 더 약하게는, 해 주실 수 없나요...?」
				DATAFORM 「힉, 저기... 좀 너무 강한 거 아닌가요...!?」
			ENDDATA
			PRINTFORMW 아직 감각에 익숙하지 않은 음핵에게는 로터의 무기질적인 진동이 다소 강한 자극인 것 같다...
		ENDIF
		;それ以外
	ELSE
		IF ABL:Ｃ感覚 > 4
			PRINTDATAW
				DATAFORM 「윽, 음음, 그... 그것을, 멈춰줘...!」
				DATAFORM 「크, 아앗... 이 이상은, 세게는 안 돼, 으응, 음ㅁ마아...!」
				DATAFORM 「이, 싫어... 우와... 느끼고 싶지 않아...!」
			ENDDATA
		ELSE
			PRINTDATAW
				DATAFORM 「그, 그런 걸 사용한다면, 적어도 약하게……윽, 아, 크으윽……!」
				DATAFORM 「힉……그런 곳에 밀어붙이다니, 야, 안 돼, 우아……!」
			ENDDATA
		ENDIF
	ENDIF
	CFLAG:23:2004 = 1
ENDIF
RETURN 1
