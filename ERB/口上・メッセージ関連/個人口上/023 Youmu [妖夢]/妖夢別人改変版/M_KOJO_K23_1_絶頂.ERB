						CALL HPH_PRINT,@"「아우윽, 큭…… 그래도 아직, 더 원해…… HPH」","W"
					ELSE
						CALL HPH_PRINT,@"「후우, 안쪽이 뜨거운 게…… 차올라…… 하헵」","L"
						CALL HPH_PRINT,@"「아하…… %CALLNAME:MASTER%님, 아직 더 들어갈 것 같아요……? HPH」","L"
					ENDIF
				CASE 5
					CALL HPH_PRINT,@"「아아앗, 이거……HPH 세이키, 더…… HPH」","L"
					IF EX:膣内精液 >= 1200
						PRINTFORML 이미 자궁에 다 자리 잡지 않았음에도 요우무는 여전히 정액을 강요해 온다.
						PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 감탄하며 허리를 밀어넣고, 더욱 깊숙이 정액을 채워주었다.
					ELSE
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 단단한 것이 맥동하며 사정할 때마다 요우무의 몸이 환희에 떨고 있다.
					ENDIF
				CASE 6
					CALL HPH_PRINT,@"「후우, 하아…… 대단해…… 나오고 있어…… HPH」","L"
					CALL HPH_PRINT,@"「더 써줘요, %CALLNAME:MASTER%씨 취향으로 만들어 주세요…… HPH」","W"
				CASE 7
					CALL HPH_PRINT,@"「하아, 하아…… 아, 응…… HPH 신기하죠……」","L"
					CALL HPH_PRINT,@"「이렇게 해주시면, 확실히 '맛있다'고 느껴져요…… HPH」","L"
					PRINTFORMW 요우무는 결합부에서 \@ EX:膣内精液 >= 1200 ? 흘러넘치는 # 새어 나온 \@자세를 손가락으로 떠서, 눈을 가늘게 뜨고 혀로 핥아먹었다……
			ENDSELECT
		ELSEIF ABL:膣射中毒 > 0
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아아…… 이 뜨거움이 점점 기억나기 시작했어요…… HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「흐응…… %CALLNAME:MASTER%님이 스며들어서…… 흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「후아……HPH 배 속이 더 뜨거워졌으면 좋겠어……HPH」","W"
			ENDSELECT
		ELSE
			PRINTDATAW
				DATAFORM 「음음…… 이상한 느낌이네요……」
				DATAFORM 「앗…… 지금, 나오고 있어요……」
			ENDDATA
		ENDIF
	ELSE
		IF ABL:膣射中毒 > 3 && RAND:2 == 0
			PRINTDATAW
				DATAFORM 「아, 크윽…… 왜 이렇게 뜨거워……읏」
				DATAFORM 「후우, 하아…… 아직, 나오고 있어……」
			ENDDATA
		ELSE
			PRINTDATAW
				DATAFORM 「우와…… 기분 나쁘다……」
				DATAFORM 「크, 흐윽…… 이런 건 이상하다……!」
			ENDDATA
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
