;7,挿入子宮口責め
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_別人版_MESSAGE_MESSAGECHECK_SCOM_K23_7
RETURN 0

@M_KOJO_別人版_MESSAGE_SCOM_K23_7
CALL M_KOJO_別人版_MESSAGE_SCOM_K23_7_1
RETURN 1

@M_KOJO_別人版_MESSAGE_SCOM_K23_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW
		RETURN 1
		;泥酔
	ELSEIF TCVAR:泥酔 == 1
		PRINTFORMW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORML 「큭, 아윽!? 어, 그렇게 당하면…… 부, 부서져버릴 것 같아……앗」
			PRINTFORMW 자궁 속까지 관통할 듯 비집고 들어오는 거대한 이물감에 요우무는 눈을 휘둥그레 뜨고 있다.
		ELSE
			PRINTFORML 「윽……기!? 그, 그렇게 깊숙이까지는…… 도저히……읏!」
			PRINTFORMW 자궁 내부까지 범하려 밀고 들어온 격렬함이 가져오는 이질감에 요우무는 당황하고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	IF EXP:子宮口開発経験 > 50
		IF TALENT:恋慕
			;種付けプレス
			IF TEQUIP:TARGET:体位 == 1 && (BEDROOM(CFLAG:PLAYER:現在位置) || (BATHROOM() && ITEM:20))
				;精液量1200以上
				IF EX:膣内精液 >= 1200
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「오, 아…… 크윽 HPH 모처럼 사정해 주셨는데에…… 흐으, 윽 아아아아HPH」","L"
							PRINTFORML 가득 주입되어 부풀어 오른 하복부가 %조사처리(CALLNAME:PLAYER,"의")% 몸으로 짓눌리고, 피스톤을 칠 때마다 질벽 사이의 틈에서 정액이 분출한다.
							PRINTFORMW 역류하는 점액과 가장 깊은 곳을 자극하는 강직한 감각에 압도된 요우무가 입가를 더럽히는 침조차 신경 쓰지 않고 비명 같은 교성을 질렀다.
						CASE 1
							CALL HPH_PRINT,@"「흐응흐응 아아앙 흐으음 더……더, 깊숙이잉 흐읍……앗, 히기읏 흐읍」","L"
							PRINTFORML 이미 임신한 것처럼 배를 부풀리고 있음에도, 쾌락의 포로가 된 소녀는 탐욕스럽게 %조사처리(CALLNAME:PLAYER,"를")% 계속 원하고 있다.
							PRINTFORMW 태가 자손으로 가득 차 있음에도 자궁구가 귀두에 매달려 있고, 삽입할 때마다 요우무의 허리가 들썩이고 있다……
						CASE 2
							CALL HPH_PRINT,@"「큭, 하앗…… 크윽…… HPH 해줘, 으응, 끄윽…… 으읏 HPH」","L"
							PRINTFORML 부풀어 오른 하복부째 몸을 짓눌리며, 폭력적일 정도의 관능에 노출된 요우무는 반쯤 질식한 듯하다.
							PRINTFORMW 그럼에도 %조사처리(CALLNAME:PLAYER,"의")% 등에 감긴 팔이 느슨해지는 법이 없고, 희미해진 이성을 떨쳐낸 본능이 끝없이 쾌락을 갈구한다.
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「아우, 카핫……흐으윽 이렇게, 격렬하게…… 기분 좋아, 으응, 아아아아앙 흐으윽」","L"
							PRINTFORML %조사처리(CALLNAME:PLAYER,"에게")% 압박당하며 괴로운 숨을 내쉬고 있지만, 요우무는 도취된 표정으로 이 상황을 받아들이고 있다.
							PRINTFORMW 자궁을 부술 듯한 가혹한 공격에 그저 환희하며, 밀려오는 관능의 흐름에 신음을 터뜨린다.
						CASE 1
							CALL HPH_PRINT,@"「오…… 오우흐으! 안쪽까지, 와버렸어…… 응그, 헉, 히익 흐으윽」","L"
							PRINTFORML 안쪽 깊숙한 곳까지 관통하려는 부풀어 오른 것을 뿌리까지 아무 힘들이지 않고 밀어 넣자, 열린 자궁구가 귀두를 삼키며 탐욕스럽게 물고 달려든다.
							PRINTFORMW 아주 조금의 이별도 아쉬운 듯 질벽이 강렬하게 빨아들이고, 삽입에 맞춰 요우무의 허리가 살짝 들려 있다…….
						CASE 2
							CALL HPH_PRINT,@"「아, %CALLNAME:PLAYER%씨, 이거…… HPH 기가…… 윽, 하앗, 히, 아…… 윽 HPH」","L"
							PRINTFORML 허벅지를 단단히 붙잡혀 반쯤 짓눌리는 형국임에도 불구하고, 요우무의 호흡을 방해하는 것은 고통보다는 쾌락이 우세한 듯하다.
							PRINTFORMW %조사처리(CALLNAME:PLAYER,"의")% 등에 단단히 팔을 감고 매달리며, 가차 없는 박자에 황홀하게 몸을 떨었다.
					ENDSELECT
				ENDIF
				;種付け交尾（立位除く）
			ELSEIF TEQUIP:TARGET:体位 == 2 && (INROOM(CFLAG:PLAYER:現在位置) || (BATHROOM() && ITEM:20))
				;精液量1200以上
				IF EX:膣内精液 >= 1200
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「큭, 아우…… 좋아아 HPH 이제, 무리야…… 에헤, 에헤헤 HPH」","L"
							PRINTFORML 드디어 제대로 가누지 못하던 요우무의 사지가 자중을 지탱하지 못하고, 엎드린 채 %조사처리(CALLNAME:PLAYER,"에게")% 깔려져 그저 자궁 쪽으로 부풀어 오름이 밀어 넣어진다.
							PRINTFORMW %조사처리(CALLNAME:PLAYER,"와")% 바닥에 끼여 압박당하는 요우무의 비틈에서는 소리를 내며 백탁액이 분출되어 정액이 고여 있다……
						CASE 1
							CALL HPH_PRINT,@"「아, 아윽…… 으윽, 좋아! 이렇게나 세게 찔리면…… 어, 안 돼읏, 앗아아악 HPH」","L"
							PRINTFORML 정상적이지 않은 양의 씨앗을 태심 깊숙이 내뿜히면서도 육욕에 빠져 거느라, 이제는 짐승조차 눈을 부릅뜰 정도이다.
							PRINTFORMW 팔로 상체를 지탱하지 못하고 거의 무너져 있는 요우무의 흐트러진 입가에서는 박힐 때마다 침이 흘러내리고 있다……
						CASE 2
							CALL HPH_PRINT,@"「아, 까, 흐으…… 이런 건…… 바보가 되어버릴 것 같아요우웅」","L"
							PRINTFORML 넘쳐흐르는 씨앗만으로는 부족하다며 자궁구가 미끄러지듯 귀두를 삼키고, 더욱 깊은 곳에서 삽입을 만끽하려 기쁨에 태내마저 바친다.
							PRINTFORMW 뇌수까지 울릴 듯한 희열을 안 요우무는 몸을 경련시키며 때로 의식을 잃을 지경이다……
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「하으, 힛, 아아아아 HPH 타, 쓰러져버릴 것 같아…… 안 돼, 히이인! HPH」","L"
							PRINTFORML 뒤에서 관통당하며 자궁까지 파고드는 격렬한 공격에 요우무는 가늘게 떨리는 사지로 간신히 몸을 지탱하고 있다.
							PRINTFORMW 쾌락에 무너져 내리면서도 필사적으로 %조사처리(CALLNAME:PLAYER,"를")% 받아들이는 모습에 가학심이 고개를 들고, 허리 움직임을 더욱 가속시킨다……
						CASE 1
							CALL HPH_PRINT,@"「응우으, 아아! HPH 이러면 정말로…… HPH 읏, 우아, 하앗…… 에HPH」","L"
							PRINTFORML 아주 작은 틈조차 아까워하며 서로의 몸을 밀착시키고 정욕에 잠기는 모습은 이미 짐승들의 교미 그 자체이다.
							PRINTFORMW 흥분에 맡긴 삽입의 여파로 입가에서 살짝 드러난 요우무의 혀끝에서 침 한 줄기가 길게 늘어지며 떨어져 내린다……
						CASE 2
							CALL HPH_PRINT,@"「잇, 윽, 아아앙…… 앗!? 안, 안에까지……. 헉, 흣…… 으응」","L"
							PRINTFORML 자궁째 몸을 꿰뚫는 듯한 강렬한 일격으로 귀두가 태내에 너무나 쉽게 미끄러져 들어가, 기세 그대로 밀착된 엉덩이 살이 충격을 말하는 소리를 내지른다.
							PRINTFORMW 머리 꼭대기까지 관통할 것 같은 쾌락을 안 요우무는 어떻게든 의식을 붙이려 얕은 호흡을 반복한다……
					ENDSELECT
				ENDIF
				;それ以外
			ELSE
				;精液量1200以上
				IF EX:膣内精液 >= 1200
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「오구, 카훗, 어…… 아하핫 HPH %CALLNAME:PLAYER%씨 거, 벌써 이렇게…… HPH」","L"
							PRINTFORML 태내에서 저릿하게 울리는 엄청난 양의 정액이 가져오는 압박감조차, 요우무에게는 관능을 부추기는 데 도움이 되는 것에 불과한 듯하다.
							PRINTFORMW %CALLNAME:PLAYER%로부터 하사받은 자손의 무게에 취해, 소녀는 희열에 떨며 색욕에서 비롯된 교미음을 연주한다.
						CASE 1
							CALL HPH_PRINT,@"「오옷, 고우……아으윽 후후. 와…… 기분 좋아……. 코토밖에…… 아하읏, 에헤…… 후후」","L"
							PRINTFORML 오래된 정액을 짜내고 새로운 씨앗을 심으려 하는 야수 같은 삽입이 요우무의 오감을 순식간에 쾌락으로 물들인다.
							PRINTFORMW %조사처리(CALLNAME:PLAYER,"에게")% 봉사하는 것을 지상 최대의 기쁨이라 여기는 암구멍이 부풀어 오른 곳을 조여오고, 허기진 자궁구가 탐욕스럽게 달려든다……
						CASE 2
							CALL HPH_PRINT,@"「아아아 흐으윽 %CALLNAME:PLAYER%님, 저 아직... 갈 수 있어요 HPH 더... 더요 HPH」","L"
							PRINTFORML 그 자체로 의지를 가진 듯 꿈틀거리는 음밀한 살결이 부풀어 오르며, 매번의 삽입이 자궁구를 관통하는 형태로 되어 있다.
							PRINTFORMW 이성을 놓을 지경인 요우무는 찔릴 때마다 은밀한 곳에서 백탁을 분출하며, %조사처리(CALLNAME:PLAYER,"에게")% 주어지는 관능을 정신없이 향유하고 있다.
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「아앗, 후우하, 크윽! 굉장해…… %CALLNAME:PLAYER%씨 게, 깊숙한 곳까지…….」","L"
							PRINTFORML 정성스럽게 익혀져 성감대로 길들여진 자궁구는, 파고드는 듯한 삽입조차 쉽게 쾌락으로 치환한다.
							PRINTFORMW %조사처리(CALLNAME:PLAYER,"에게")% 남김없이 성기를 사용당하고 있는 다행에, 요우무는 환희에 몸을 떨며 신음소리를 내고 있다.
						CASE 1
							CALL HPH_PRINT,@"「응응, 으윽... 아우 HPH 우으... 괴로운데... 기분 좋아아 HPH」","L"
							PRINTFORML 질내의 살들을 헤치며 자궁을 부숴버릴 듯한 격렬한 피스톤이, 고통을 능가하는 감각을 선명하게 요우무에게 새긴다.
							PRINTFORMW 그 보답이라도 하듯 질벽이 끊임없이 단단함을 어루만지고, 씨앗을 갈망하는 자궁구가 강렬하게 빨아들인다……
						CASE 2
							CALL HPH_PRINT,@"「응우으 HPH 아, %CALLNAME:PLAYER%씨, 그렇게까지 하면 HPH 저도……. 히이잉 HPH」","L"
							PRINTFORML 편안한 질 속으로 더욱 깊이 거침을 밀어 넣으려는 욕망이 %조사처리(CALLNAME:PLAYER,"의")% 허리 움직임을 격렬하게 몰아붙인다.
							PRINTFORMW 자궁구를 거칠게 농락당하며 욕정을 불태운 요우무는, %조사처리(CALLNAME:PLAYER,"에게")% 맞춰 허리를 움직이며 더욱 정기에 몸을 태우고 있다.
					ENDSELECT
				ENDIF
			ENDIF
			;今射精した
			IF NOWEX:PLAYER:11
				PRINTFORML
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「오, 아아…… 좋아, 좋아요읏 HPH 그대로, 그대로 가장 깊은 곳에서애……! HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「크윽, 우으아…… 아……! HPH가, 참지 마세요…… 괜찮아요 HPH」","W"
					CASE 2
						PRINTFORMW 한계까지 치솟은 사정감에 몸을 맡기고, %조사처리(CALLNAME:PLAYER,"는")% 절정의 순간 온 힘을 다해 요우무의 자궁을 관통했다.
				ENDSELECT
			ENDIF
		ELSE
			PRINTDATAL
				DATAFORM 「뭐, 뭐야……. 싫어……. 괴로울 뿐이야……. 우윽, 아아앗!」
				DATAFORM 「응, 응으윽! ……에…… 치, 달라구, 내 몸인데 말이야…… 앗!」
			ENDDATA
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML %CALLNAME:PLAYER%에 의해 개발되어 끝을 본 자궁구는 격렬한 삽입 따위는 두려워하지 않고 충격을 어렵지 않게 관능으로 변환한다.
					PRINTFORMW 그 과정에 본인의 의사가 개입할 여지는 없으며, 요우무는 원치 않는 쾌락에 그저 몸을 움츠리고 있을 뿐이다……
				CASE 1
					PRINTFORML 꿰뚫리는 단단한 자궁을 짓누르려는 감촉에, 요우무는 고통과 함께 명확한 쾌감을 느끼고 있는 듯하다.
					PRINTFORMW 확실히 열을 머금은 소녀의 숨결에 득실거리며, %조사처리(CALLNAME:PLAYER,"는")% 더욱 깊은 곳까지 자신의 흔적을 새겨 나간다.
			ENDSELECT
		ENDIF
	ELSEIF EXP:子宮口開発経験 >= 25
		IF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「으, 윽…… 아…… 괴로운데, 왠지…… 좋아아읏」","L"
				CASE 1
					CALL HPH_PRINT,@"「윽, 그, 그렇게 깊숙이 박아버리면…… 터져버릴 거예요 HPH」","L"
			ENDSELECT
			PRINTFORMW 시간을 들여 %조사처리(CALLNAME:PLAYER,"에게")% 익숙해진 자궁구가 받는 자극을 쾌락으로 치환하기 시작한 듯하다.
		ELSE
			PRINTDATAL
				DATAFORM 「끄윽……으으……이, 이런 건…… 고통일 뿐인 터인데……읏」
				DATAFORM 「끽……우, 응으……에……나, 왜……?」
			ENDDATA
			PRINTFORMW %조사처리(CALLNAME:PLAYER,"에게")% 집요하게 공격당했던 자궁구가 요우무에게 고통 외의 감각을 전달하기 시작한다.
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTDATAL
				DATAFORM 「우윽, 음…… 설마, 역시, 조금…… 괴롭습니다……」
				DATAFORM 「하, 하앗…… 의심할 리는 없지만…… 이거 정말 괜찮을까요…… 쿠, 아아…… 윽」
			ENDDATA
			PRINTFORMW 아직 유연성이 부족한 자궁경부에서 쾌감을 얻는 것은 어려울 것이다, 오래도록 개발해 나갈 수밖에 없을 것 같다.
		ELSE
			PRINTDATAL
				DATAFORM 「윽……크윽……이, 이쪽 일도 생각해 줘……!」
				DATAFORM 「헉……하……어째서 이런 일을 당하는 거지……!」
			ENDDATA
			PRINTFORMW 요우무는 고통밖에 느끼지 못하는 듯하지만, 저항을 약화시킨다는 측면에서는 오히려 환영할 일이다
		ENDIF
	ENDIF
ENDIF
