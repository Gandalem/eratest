;デート帰り
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_別人版_SPEVENT_MESSAGECHECK_K23_3
RETURN 0

@M_KOJO_別人版_SPEVENT_K23_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TCVAR:泥酔 == 1
			PRINTFORML
		ELSEIF CFLAG:318 == 1
			PRINTFORML 「…………」
			PRINTFORMW 요우무는 아무 말도 하지 않고 서둘러 %CALLNAME:MASTER%에게서 떨어져 갔다…….
		ELSEIF (MARK:23:反発刻印 == 1 && RAND:2 == 0) || MARK:23:反発刻印 > 1
			PRINTFORML 「……그럼」
			PRINTFORMW 요우무는 그렇게만 말하고 조용히 %CALLNAME:MASTER%에게서 멀어져 갔다……
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%씨, 오늘은 정말 감사했어요」
					;振られている状態
					IF CFLAG:23:2001 == 1
						PRINTFORMW 「……또, 저는 유혹해 주실 수 있나요?」
					ELSE
						PRINTFORMW 「후훗…… 다음 기회가 벌써 기다려져 버리네요」
					ENDIF
				CASE 1
					IF CFLAG:23:2001 == 1
						PRINTFORML 「……%CALLNAME:MASTER%씨, 정말 감사했어요. 소중한 시간을 내주신 것만으로도 저는 기뻐요」
					ELSE
						PRINTFORML 「즐거운 시간은 눈 깜짝할 새에 지나가 버렸네요…… 아쉽지만……」
					ENDIF
					PRINTFORMW 요우무는 %조사처리(CALLNAME:MASTER,"의")% 손바닥 위에 소중하게 올려두었던 \@ CFLAG:23:2001 == 1 ? 손가락 # 손 \@을 천천히 놓았다
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%씨는 오늘의 데이트 어땠어요?」
					IF CFLAG:23:2001 == 1
						PRINTFORML 「……저는, 계속 행복했어요. 이 시간이 끝나버릴까 봐 무서울 정도로」
						PRINTFORMW 아련하게 미소 지은 요우무는 %CALLNAME:MASTER%에게서 한 걸음 물러나 조용히 고개를 숙였다
					ELSE
						PRINTFORML 「에, 저는…… 어, 아마 얼굴에 드러나고 있는 것 같아요」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 들여다보자 요우무는 얼굴을 새빨갛게 물들이고 살짝 벌어졌던 입가를 가려버렸다.
					ENDIF
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「이런 기회도 좋은 것이었다. 감사했다.」
					PRINTFORMW 「……다시 함께할 수 있다면 기쁘겠다.」
				CASE 1
					PRINTFORML 「기분 전환이 되었습니다, 감사합니다」
					PRINTFORMW (%CALLNAME:MASTER%씨도 즐거워하셨을까……?)
			ENDSELECT
		ELSE
			PRINTFORML 「저기…… 고마웠어요……?」
			PRINTFORMW (결국, 잘 모른 채 따라가 버렸네……)
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「……그렇네요, %CALLNAME:MASTER%씨의 사과는 전해졌어요」
		PRINTFORML 요우무는 표정에서 날카로움을 거두고 작게 한숨을 내쉬었다.
		PRINTFORMW 「앞으로는 너무 놀리지 말아 주세요?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「……일단 사죄의 의사는 있는 거군요」
		PRINTFORML (하지만 방심하면 또 무슨 일을 당할지……)
		PRINTFORMW 아직 요우무에게서 나를 경계하는 기척을 느낀다……
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「――윽」
		PRINTFORMW 날카로운 바람 가르는 소리가 %조사처리(CALLNAME:MASTER,"의")% 고막을 떨게 한다.
		PRINTFORMW 잠시 후 칼을 칼집에 넣은 요우무를 보고, %조사처리(CALLNAME:MASTER,"는")% 자신의 귓가에 백금(흰 칼날)이 스쳤다는 것을 깨달았다.
		PRINTFORML 「이 정도는 해야 배 속의 벌레가 진정되니까요」
		PRINTFORMW 「…… 정말 조금 머리가 식었네요」
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
