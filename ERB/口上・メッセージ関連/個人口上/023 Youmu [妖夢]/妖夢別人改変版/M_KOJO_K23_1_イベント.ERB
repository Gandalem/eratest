@M_KOJO_別人版_EVENT_K23_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		$YOMU_ENCOUNTER
		;既に会っている場合は非表示
		IF !TCVAR:23:今日会ったか
			IF TCVAR:泥酔 == 1
				PRINTFORML
				;ブチギレ
			ELSEIF CFLAG:318 == 1
				PRINTFORML
				PRINTFORML 「…………」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"를")% 시야에 인정한 요우무는 말없이 입술을 깨물었다…….
				;反発刻印有　1で2分の1、2以上で確定
			ELSEIF (MARK:23:反発刻印 == 1 && RAND:2 == 0) || MARK:23:反発刻印 > 1
				PRINTFORML
				PRINTFORML 「…………」
				PRINTFORMW 요우무는 %조사처리(CALLNAME:MASTER,"에게")% 조용히 목례를 했다.
				;正月、ハロウィン、バレンタイン
			ELSEIF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000)
				CALL SPECIALDAY_EVENT_K23
				;台風
			ELSEIF FLAG:異常気象 == 9
				PRINTFORML
				PRINTFORML 「우으, 살벌한 바람이야…… 반령이 날아가 버릴 것 같아……」
				PRINTFORMW 「%CALLNAME:MASTER%씨, 이런 날씨에는 멀리 나가는 건 삼가시는 게……」
				;猛吹雪
			ELSEIF FLAG:異常気象 == 10
				PRINTFORML
				PRINTFORML 「이렇게 심한 눈보라는 그날의 일을 떠올리게 하네요……」
				PRINTFORMW 「%CALLNAME:MASTER%님, 이런 날에는 무언가를 잃지 않도록 방에서 조용히 계시는 게 좋아요!」
				;不機嫌
			ELSEIF TALENT:機嫌 == -1
				PRINTFORML
				IF TALENT:恋慕
					PRINTFORML 「아…… %조사처리(CALLNAME:MASTER,"를")%」
					PRINTFORMW 심각한 표정을 짓고 있던 요우무는 %조사처리(CALLNAME:MASTER,"를")% 발견하자 살짝 표정이 누그러졌다.
				ELSE
					PRINTFORML 「……도우모」
					PRINTFORMW 근엄한 표정을 짓고 있는 요우무는 %조사처리(CALLNAME:MASTER,"에게")% 조심스럽게 목례를 했다.
				ENDIF
				;通常
			ELSE
				SELECTCASE TIME:2
					;朝
					CASE 1,2
						PRINTFORML
						PRINTFORML 「안녕하세요, %CALLNAME:MASTER%씨」
						IF TALENT:恋慕
							SELECTCASE RAND:3
								CASE 0, 1
									PRINTFORMW 요우무는 %조사처리(CALLNAME:MASTER,"를")% 향해 %TEXTR("楽しげに/嬉しげに/微笑んで/")% 가볍게 목례했다.
									PRINTDATAW
										DATAFORM 「오늘의 예정은 정해졌나요?」
										DATAFORM 「――기쁘다는 듯한 건가? 응, 방금 기쁜 일이 생겼거든」
									ENDDATA
								CASE 2
									PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 가볍게 목례를 한 요우무의 옆에는 노를 젓는 것처럼 흔들리는 반령이 떠 있었다.
									PRINTFORMW 「? ……엣!? 그, 사실 아직 좀 졸려서……」
							ENDSELECT
						ELSEIF TALENT:思慕
							PRINTFORMW 요우무는 %조사처리(CALLNAME:MASTER,"를")% 향해 정중히 목례했다.
						ELSE
							PRINTFORMW 요우무는 %조사처리(CALLNAME:MASTER,"에게")% 가볍게 목례했다
						ENDIF
