	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	IF TALENT:恋慕
		PRINTFORML 「후훗, %CALLNAME:MASTER%님께서 주신 선물이라니……」
		PRINTFORML 「……저에겐 평범한 기념품처럼 보이지만요」
		PRINTFORMW 「오늘이라는 날을 형상화한 것이라고 생각하면, 왠지 엄청나게 가치 있는 것 같아요」
		PRINTFORMW 「잃어버리지 않도록 잘 간직해 두어야겠어요……」
	ELSE
		PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")% 받은 기념품……」
		PRINTFORML 「아마 좋은 물건일 거라고 생각하는데」
		PRINTFORMW 「제가 가치에 밝았다면, 이것이 의미하는 바를 이유 없이 알아차릴 수 있었을까요?」
		PRINTFORMW 「……우선 잘 간직해 둘게요」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	IF TALENT:恋慕
		PRINTFORMW 「……안, 안 돼요」
		PRINTFORML 「제 방에서는 장식으로 두든 몸에 달아두든 눈에 너무 확 띄어서……」
		PRINTFORMW 「그렇다고 소지하고 있다기도 그렇고……」
		PRINTFORML
		PRINTFORML 「우으…… 죄송합니다, %CALLNAME:MASTER%님.」
		PRINTFORMW 「이것은 저에게 너무 과분한 것 같습니다……」
	ELSE
		PRINTFORML 「그때부터 필사적으로 쓸 방법을 생각해 봤는데……」
		PRINTFORML 「……도 전혀 생각이 안 나네」
		PRINTFORMW 「…………」
		PRINTFORMW 「저장함의 거름으로 써버리기보다는, 다음 장을 보러 갈 때라도……」
	ENDIF
	RETURN 1
ENDIF
RETURN 1
;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================

@M_KOJO_別人版_MESSAGE_COM_K23_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「あ、ある意味精鋭揃いですよ！」
				CASE 1
					RESULTS = 「生き残っていたのは運だけではない筈……！」
				CASE 2
					RESULTS = 「うぅ……あまり自信はありませんが……」
			ENDSELECT
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE ARG
				CASE 3
					SELECTCASE RAND:2
						CASE 0
							RESULTS = 「先鋒は任せましたよ！」
						CASE 1
							RESULTS = 「頼みます、%MUSHI_NAME%！」
					ENDSELECT
				CASE 2
					SELECTCASE RAND:2
						CASE 0
							RESULTS = 「次はこっちです、%MUSHI_NAME%！」
						CASE 1
							RESULTS = 「見極めればまだ勝機はあります……！」
					ENDSELECT
				CASE 1
					SELECTCASE RAND:2
						CASE 0
							RESULTS = 「好機とは窮地の中に見出すもの……！　決着は預けますよ！」
						CASE 1
							RESULTS = 「踏ん張りどころです……！　%MUSHI_NAME%、意地を見せて下さい！」
					ENDSELECT
			ENDSELECT
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「玉砕覚悟なら！」
				CASE 1
					RESULTS = 「捨て身で挑めば！」
				CASE 2
					RESULTS = 「全力で頼みますよ！」
			ENDSELECT
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE ARG
				CASE 2
					SELECTCASE RAND:2
						CASE 0
							RESULTS = 「あっ！？　……ま、まだ戦える虫は控えています！」
						CASE 1
							RESULTS = 「うっ！？　……これで終わりではありません！」
					ENDSELECT
				CASE 1
					SELECTCASE RAND:2
						CASE 0
							RESULTS = 「ぐっ……土壇場でなら、或いは……！」
						CASE 1
							RESULTS = 「こ、このままでは……何か活路がある筈……！」
					ENDSELECT
			ENDSELECT
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「そんな！？　こうもあっさりと……」
				CASE 1
					RESULTS = 「えぇ！？　……よ、良かった、生きてはいますね……」
				CASE 2
					RESULTS = 「あぁ……高すぎる壁でしたか……」
			ENDSELECT
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「勝てた……し、信じられません」
				CASE 1
					RESULTS = 「……あ、いえ、私も驚いてしまって」
			ENDSELECT
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「次の剪定の生き残りに期待ですね……」
				CASE 1
					RESULTS = 「負けは負けです……お見事でした」
			ENDSELECT
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「勝てた……？　し、信じられません」
				CASE 1
					RESULTS = 「漁夫の利であろうと勝ちは勝ちです！」
			ENDSELECT
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「鍛えて強くなるなら幾らでも鍛えてあげるんですけどね……」
				CASE 1
					RESULTS = 「生き残るだけならと思ったのですが……」
			ENDSELECT
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「勝てたとはいえ、任せきりになってしまってすみません……」
				CASE 1
					RESULTS = 「……よ、陽動くらいにはなったでしょうか？」
			ENDSELECT
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「私が足を引っ張ってしまいましたね、申し訳ありません……」
				CASE 1
					RESULTS = 「……明らかに私一人の敗北です、気になさらないで下さい」
			ENDSELECT
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1
