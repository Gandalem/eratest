				CALL HPH_PRINT,@"(%CALLNAME:MASTER%님에게 미치지는 못하지만, 꽤나……후우……아, 그러고 보니)","L"
				PRINTFORMW (이걸 살 때, 분명 다른 괴상한 모양의 물건들도 있었는데……. 저런 걸 누가 사겠어……?)
			ELSE
				PRINTFORML (카톳에게 떠넘겨져서, 나도 모르게 손을 대고 말았지만……)
				CALL HPH_PRINT,@"(보관하는 것도 힘들고, 좀 더 생각하고 사야 했는데... 또 살 것 같아... HPH)","W"
			ENDIF
		ELSE
			PRINTFORML (음, 푹... 반쯤 밀쳐진 상태라고 해도, 이런 것을 사다니 부끄럽지도 않네...)
			PRINTFORMW 「절대로, 으윽... 누군가에게 들키지 않도록, 해야 해... 우아...!」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;我慢
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:恋慕
			PRINTFORML (......으윽, 아려온다... 스스로 해결해 버려도 괜찮겠지만)
			CALL HPH_PRINT,@"(지금 참아두면, 내일 더 기분 좋게 해드릴 수 있을지도 몰라……. HPH)","W"
		ELSE
			PRINTFORMW (윽...... 수련이라고 하면 이 정도의 저릿함 따위는......!)
		ENDIF
		RETURN 1
	ENDIF
	;その他
	;上の分岐を一切書かずに、ここに書くことで自慰の共通口上を表示することが出来ます
	PRINTFORML  
	RETURN 1
ENDIF
RETURN 1
