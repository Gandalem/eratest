@M_KOJO_別人版_EVENT_K23_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「%CALLNAME:MASTER%씨, 이 후에 약속 있으신가요?」
					;振られている状態
					IF CFLAG:23:2001 == 1
						PRINTFORMW 「지장 없으시다면, 저에게 시간을 내주실 수 없을까요……」
					ELSE
						PRINTFORMW 「저기, 괜찮으시다면 같이 외출하고 싶다든지…… 같은 건데……」
					ENDIF
				ELSEIF TALENT:思慕
					PRINTFORMW 「만약 %CALLNAME:MASTER%님도 참가하신다면, 모처럼이니까 함께하고 싶어서……」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					IF CFLAG:23:2001 == 1
						PRINTFORML 「사귈 수 있나요? ……상냥하시네요, 감사합니다」
						PRINTFORMW (……그것이 가엾게 여겨지는 것이라 해도…… 상관없어)
					ELSE
						PRINTFORML 「감사합니다! 그럼 바로 가보죠」
						PRINTFORMW 떠 있는 반령을 보니 상당히 기뻐해 주는 듯하다
					ENDIF
				ELSEIF TALENT:思慕
					PRINTFORML 「자, 그럼 시작할 때까지 시간을 보내볼까요」
					PRINTFORMW (스스로도 대담하네…… 대담해…….?)
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					IF CFLAG:23:2001 == 1
						PRINTFORML 「……그렇죠. 주제넘은 부탁이었습니다, 죄송해요」
						PRINTFORMW 요우무는 눈을 내리더니 한 걸음 %CALLNAME:MASTER%에게서 거리를 두었다…….
					ELSE
						PRINTFORML 「우…… 너무 갑작스러웠죠, 부디 신경 쓰지 말아 주세요」
						PRINTFORMW (조금…… 아니, 상당히 정신이 팔려버렸다……)
					ENDIF
				ELSEIF TALENT:思慕
					PRINTFORML 「아, 아아……. 갈 때도 시작하고 나서 해도 괜찮잖아요……」
					PRINTFORMW (익숙하지 않은 일은 하지 말았어야 했을지도……)
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;合意有、且つ欲求不満が高い場合に発生だろうか？
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					IF CFLAG:23:2001 == 1
						PRINTFORML 「%CALLNAME:MASTER%씨, 제 방에 와주지 않으실래요?」
						PRINTFORMW 「초라한 방이긴 하지만, 원하시는 대로 사용하셔도 괜찮으니까……」
					ELSE
						PRINTFORML 「아아, 저기…… 제 방에 와보시지 않겠어요?」
						PRINTFORMW 「별 볼 일 없는 방이긴 하지만, 그렇기에 오히려 여유롭게 이야기 나눌 수 있지 않을까 해서……」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					IF CFLAG:23:2001 == 1
						PRINTFORML 「와 주신다니 영광이다」
						PRINTFORMW 「……응. 마음대로 사용해라」
					ELSE
						PRINTFORML 「다행이네요…… 다과 정도는 준비할 수 있으니, 편안하게 계세요」
						PRINTFORMW (방에 도착하기 전에 머릿속을 정리해야 해……)
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					IF CFLAG:23:2001 == 1
						PRINTFORML 「……그렇습니까」
						PRINTFORMW 「경솔한 제안이었습니다. 부디 용서해 주십시오」
					ELSE
						PRINTFORML 「우……네, 알겠어요」
						PRINTFORMW 「아, 아니에요. 저야말로 더 가실 만한 곳으로 모셔 드려야 했는데……」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
