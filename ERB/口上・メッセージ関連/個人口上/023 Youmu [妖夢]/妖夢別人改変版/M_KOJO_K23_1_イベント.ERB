	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「거창한 환대는 못 하지만, 편하게 머물러 주세요」
		CALL HPH_PRINT,@"「그럼 이불을 준비할 테니…… HPH」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;部屋に来ないか→「やめとく」を選択（～は心なしか寂しそうだ……）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
