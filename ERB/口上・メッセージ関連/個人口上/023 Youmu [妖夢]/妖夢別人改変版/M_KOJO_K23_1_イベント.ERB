@M_KOJO_別人版_EVENT_K23_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕
					IF TALENT:処女
						PRINTFORMW 「――아, 네. 잠시만 기다려 주세요」
						PRINTFORMW (믿을 수 없을 만큼 부끄럽지만, %CALLNAME:MASTER%님이라면……)
						PRINTFORMW 어색한 동작으로 요우무가 탈의를 마치자, 희미하게 홍조를 띤 하얀 몸이 %CALLNAME:MASTER%앞에 드러났다.
					ELSEIF OUTROOF(CFLAG:現在位置)
						PRINTFORML 「에엣!? 그, 확실히 땀이나 기타 여러 가지를 신경 쓸 필요는 없어지겠지만……」
						PRINTFORMW (그것과는 또 다른 염려가 있어… 누군가 오면 어떡하지…!?)
					ELSE
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「망설임 없이 나에게 몸을 맡기는 나를 옛날 자신이 본다면, 가짜라고 단정하고 베어버릴지도 모르겠네요.」
								CALL HPH_PRINT,@"「하지만, 이런 상황일 때는 아무것도 안 입은 쪽이 편리하니까……. HPH」","W"
							CASE 1
								PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 뜻대로 요우무가 몸에 걸친 천을 능숙하게 벗어 나간다.
								PRINTFORMW 눈앞에 드러난 백자 같은 피부에 무심코 뻗은 손가락이 닿자, 작게 신음하며 부끄러운 듯 몸을 비트는 요우무가 있었다.
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「......벗을 테니, 그 시선을 어떻게 해주지 않겠어?」
					PRINTFORMW (무슨 생각을 하면 저런 눈이 생기는 걸까... 알고 싶지도 않아)
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕
					IF TALENT:処女
						PRINTFORMW 「――에? 속옷은 그 상태로? 알, 알겠습니다」
						PRINTFORMW (이래도 부끄럽지만, 전라가 아닌 덕분에 아직 간신히 안심할 수 있어……)
					ELSEIF OUTROOF(CFLAG:現在位置)
						PRINTFORML 「에!? 아... 그, 그렇겠네요. 여기서 전라로 있는 건 곤란하니까요」
						PRINTFORMW (속옷이 있다면 아직 누가 와도 어떻게든 체면을 세울 수 있겠지... 아니 무모한 걸까...?)
					ELSE
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「아아…… 속옷에는 특별히 신경 쓰지 않아서. 보기 싫어지지 않으면 좋겠는데……」
								PRINTFORMW (왠지 움직이기 편한 쪽으로 기울어버리고 말았네……. 주변 사람들은 어떻게 하고 있을까?)
							CASE 1
								PRINTFORML 「…………」
								PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 요청대로 속옷 차림이 된 요우무는 자신의 몸을 말없이 내려다보고 있었다...
								PRINTDATAW
									DATAFORM (스스로 말하는 것도 좀 그렇지만…… 색기가 부족해……!)
									DATAFORM (왜, 지금…… 유유코님이 가지고 계신 굉장한 속옷들을 떠올리고 있는 걸까……)
								ENDDATA
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「……꽤나 취향이 좋으시네요? 흥……」
					PRINTFORMW (온정이라고 생각하나?... 있을 수 없는 일인가)
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕
					IF TALENT:処女
						PRINTFORMW 「――조금은 벗겨지는 정도에서? 음... 이 정도로 괜찮을까요?」
						PRINTFORMW (배려해 주신 걸까...? 그렇다면 이번 기회에 나도 조금은 진정해야겠어...)
					ELSEIF OUTROOF(CFLAG:現在位置)
						PRINTFORML 「흐음… 뭐, 이 정도라면 거의 입고 있다고 해도 이상하지 않을지도 모르겠네요…」
						PRINTFORMW (헝클어진 부분은 엉켜서 넘어졌다고 하면… 발견되어도 얼버릴 수 있을지도)
					ELSE
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「조금 어렵다는 느낌은 부정할 수 없지만... 빠르게 원래 모습으로 돌아갈 수 있다는 건 좋은 점이죠.」
								CALL HPH_PRINT,@"「그냥 너무 격렬하게 당하면, 뭘 하고 있었는지 들켜버릴지도 몰라... HPH」","W"
							CASE 1
								PRINTFORML 「음... 어느 정도까지 벗어야 할지, 스스로는 상당히 고민되는 부분이야」
								PRINTFORMW 「――이, 이렇게 하면 삼분의 %TEXTR("一/二/")% 벗기? 역시 어렵네 이거...」
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「...그렇게 더럽히지 말아주세요」
					PRINTFORMW (더럽혀지는 것보다는 전라 상태가 낫겠네...)
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								PRINTFORML 「......그, 그렇다면 저도 %CALLNAME:MASTER%님의 속옷이 갖고 싶었다든지......」
								PRINTFORML 「아, 아니에요! 특별히 받으신 후의 일은 생각하고 있지 않지만, 모처럼이니까......」
								PRINTFORMW 「――그, 맞아요! 이런 비밀은 공유하는 편이 더 친밀해질 수 있다고 생각하지 않으세요!?」
							ELSE
								PRINTFORML 「…………음」
								PRINTFORML 「상관없어요. 그쪽 속옷과 교환이라면, 하지만」
								PRINTFORMW (……조금은 나의 굴욕을 맛보게 해줘야지)
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								SELECTCASE RAND:2
									CASE 0
										PRINTFORML 「네, 알겠습니다. ……아, 그런데」
										PRINTFORML 「어차피 건네줄 거라면, 역시 깨끗하게 세탁해 둔 속옷이 좋겠죠. 다음은……」
										PRINTFORMW 「――입었던 것이 아니면? 아, 네…… 그런 거였군요……」
									CASE 1
										PRINTFORML 「양보해 드리는 것에 이의는 없는데... 제 속옷 같은 걸 대체 어디에 쓰실 거예요?」
										PRINTFORML 「사람 눈에 띄지 않게 보관하는 것도 힘들 테고, 손봐서 다른 물건으로 만든다 해도...」
										PRINTFORMW 진정한 용도를 알려줘도 그 자체로 혼란스러워할 것 같았다...
								ENDSELECT
							ELSE
								PRINTFORML 「…………하아」
								PRINTFORML 「물러설 생각이 없다는 건 알고 있어요. 그럼 이 질문은 빨리 끝내도록 하죠. 마음대로 하세요」
								PRINTFORMW (광인의 사고를 이해하려는 건 소용없다)
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								PRINTFORML 「……에? 어, 음……」
								PRINTFORML 「……%CALLNAME:MASTER%님이 원하신다면……부, 부디」
								PRINTFORMW (저도 모르게 건네버렸는데, 이 후에 어떻게 해야 하지……)
							ELSE
								PRINTFORML 「…………뭐야?」
								PRINTFORML 「…………물러날 생각도 없는 것 같네요, 뭐가 좋은 건지……」
								PRINTFORMW (지금 당장 이 시간이 끝나준다면 기꺼이 양보해 주겠지만)
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								PRINTFORML 「......? ......엣」
								PRINTFORMW 「아니에요, 그건 좀... 신을 게 없어지니까, 거긴 그냥 넘어가 주시면...」
							ELSE
								PRINTFORML 「……하아?」
								PRINTFORMW 「자제라는 단어를 기억해 보는 건 어떨까요. 아니면 너무 창피해서 뭐가 부끄러운지도 모르게 되어버린 걸까요?」
							ENDIF
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
