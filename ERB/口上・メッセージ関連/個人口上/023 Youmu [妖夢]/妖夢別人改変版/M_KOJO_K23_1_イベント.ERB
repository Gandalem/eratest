		IF TCVAR:23:手伝った量
			;ブチギレ
			IF CFLAG:318 == 1
				PRINTFORML 「…………」
				;反発刻印有
			ELSEIF (MARK:23:反発刻印 == 1 && RAND:2 == 0) || MARK:23:反発刻印 > 1
				PRINTFORML 「……감사했습니다」
