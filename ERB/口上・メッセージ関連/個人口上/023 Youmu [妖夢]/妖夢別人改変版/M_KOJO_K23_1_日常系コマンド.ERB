@M_KOJO_別人版_MESSAGE_COM_K23_333_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 6
			;大成功（酔い）
			IF TALENT:恋慕
				PRINTFORML 「에헤헤, 그런 거예요~♪」
				CALL HPH_PRINT,@"「역시, %CALLNAME:MASTER%씨는 말이 통하는 멋진 분이시네요 헤헤」","W"
			ELSE
				PRINTFORML 「아하하! 그 말이 맞아요!」
				PRINTFORMW 「역시 %CALLNAME:MASTER%님은 대단한 분이라고 생각하고 있었어요~♪」
			ENDIF
		CASE 5
			;成功（酔い）
			IF TALENT:恋慕
				PRINTFORML 「에헤헤, 그럴 리가 없죠~♪」
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%라면 제대로 들어줄 거라고 믿고 있었단 말이야아 HPH」","W"
			ELSE
				PRINTFORML 「그쵸……. 그렇게 생각하시죠」
				PRINTFORMW 「%CALLNAME:MASTER%님은 참 이해심 깊으시네요♪」
			ENDIF
		CASE 4
			;失敗（酔い）
			IF TALENT:恋慕
				PRINTFORML 「――%CALLNAME:MASTER%님까지 그런 말씀을 하시는 거예요」
			ELSE
				PRINTFORML 「――내 얘기, 안 들어줬지?」
			ENDIF
			PRINTFORMW 갑자기 진지해진 요우무가 칼에 손을 대려 하는 것을 %조사처리(CALLNAME:MASTER,"는")% 이미 제지했다…….
		CASE 3
			;大成功
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「저 저택의 유령들은 나한테만 일을 떠넘긴다고!」
					IF TALENT:恋慕
						PRINTFORML 「――푸훗, 아하하! 그거 좋은 협박 문구네요」
						PRINTDATAW
							DATAFORM 「『%CALLNAME:MASTER%님께 재료로 해달라니』라니, 분명 온몸을 떨면서 일할 거예요」
							DATAFORM 「다음 게으름 피우는 유령을 보면 바로 시험해 볼게요. 좋은 아이디어 고마워요」
						ENDDATA
					ELSE
						PRINTFORML 「――아아, 연마님께」
						PRINTFORMW 「확실히 부탁하면 꾸중을 들을 수 있을 것 같지만, 틀림없이 저도 휘말리겠죠……」
					ENDIF
				CASE 1
					PRINTFORMW 「다들 나를 반쯤 인간 같다고 놀려!」
					IF TALENT:恋慕
						PRINTFORML 「――――엣……아……」
						PRINTFORMW 「아, 아우…… %CALLNAME:MASTER%님이 그렇게 말씀하신다면, 당분간은 반인반마 상태로 있어도 괜찮을지도……」
					ELSE
						PRINTFORML 「――그렇습니다, 그 말씀이 맞아요!」
						PRINTFORMW 「지금 반쯤 어른이라면 더 성장할 여지가 있는데, %CALLNAME:MASTER%님께서 그걸 알아주시다니!」
					ENDIF
			ENDSELECT
		CASE 2
			;成功
			PRINTDATAW
				DATAFORM 「저 저택의 유령들은 나한테만 일을 떠넘기잖아!」
				DATAFORM 「모두 나를 반인반마처럼 우습게 봐버리고!」
			ENDDATA
			IF TALENT:恋慕
				PRINTFORML 「――아앗, 죄, 죄송해요. 이런 시시한 이야기를 해서」
				PRINTFORMW 「진지하게 들어주시니까 나도 모르게 길게 말해버렸네요…… 시간 내주셔서 정말 감사했어요」
			ELSE
				PRINTFORML 「――――아, 죄, 죄송합니다. 길게 이야기해 버려서」
				PRINTFORMW 「농담하지 않고 들어주시니 저도 모르게……덕분에 기분이 나아졌습니다」
			ENDIF
		CASE 1
			;失敗
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「저 저택의 유령들은 나한테만 일을 떠넘기잖아!」
					PRINTFORML 「적어도 청소나 장보기 정도는 해줘야 하는 거 아니야…… 가마보노 요정조차 최소한의 일은 하고 있는데」
					PRINTFORMW 「아, 부럽다…… 부러워……!!」
				CASE 1
					PRINTFORMW 「다들 나를 반인반마처럼 취급하고 바보 취급해줘!」
					PRINTFORML 「그런 일은 나 자신이 가장 잘 알고 있는데, 거듭해서……」
					PRINTFORMW 「우으~…… 떠올리면 또……!」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
