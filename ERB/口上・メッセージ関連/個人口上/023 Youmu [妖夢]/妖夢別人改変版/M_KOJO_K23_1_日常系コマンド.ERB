				ENDIF
			CASE 2
				IF TALENT:恋慕
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 원해 주신다니 기뻐요?」
					PRINTFORMW 「하지만, 그게…… 먼저, 키스를……」
					PRINTFORMW 「……사, 사치였을까요?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「이런 일에는 순서가 더 있어야 하는 거 아니야...!」
					PRINTFORMW (세, 세상에서는 키스도 안 하고 그러는 게 보통인데...?!)
				ELSE
					PRINTFORMW 「뭐, 뭐를…… 하려는 거야……?」
					PRINTFORMW 요우무가 눈을 동그랗게 뜨고 있는 사이, %조사처리(CALLNAME:MASTER,"는")% 일이 벌어지기 시작했다……
				ENDIF
			CASE 3
				IF TALENT:恋慕
					PRINTFORMW 「……지금, 이상한 기분이에요」
					PRINTFORMW 「몸 깊은 곳이 저릿하고, 옷이 스쳐서 애틋해요……」
					CALL HPH_PRINT,@"「아아, %CALLNAME:MASTER%님이 잠재워 주시는 건가요…… HPH」","W"
				ELSEIF TALENT:思慕
					PRINTFORMW 「하아, 아…… 한때의 색욕에 현혹되다니」
					PRINTFORMW 「있어서는 안 될 일인데……」
					CALL HPH_PRINT,@"(......뭐, %CALLNAME:MASTER%라면 나쁘지 않을지도…… 후후)","W"
				ELSE
					PRINTFORMW 「안 돼, 싫어……!」
					PRINTFORMW  내면의 정동에 사로잡힌 요우무의 저항은 너무나도 미약했다……
				ENDIF
			CASE 4
				IF TALENT:恋慕
					PRINTFORMW 「……나, 이상해져 버렸어요」
					PRINTFORMW 「%CALLNAME:MASTER%님을 볼 때마다 좋지 않은 망상이 연달아 떠올라서……」
					PRINTFORMW 「……이거 혹시」
					CALL HPH_PRINT,@"「분명 당신에게 안기는 걸 기다리고 있었다는 거겠죠…… HPH」","W"
				ELSEIF TALENT:思慕
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 일은, 그게…… 미워할 수 없다고 생각하고 있어요」
					PRINTFORMW 「하지만 그런 불순한……」
					PRINTFORMW (……뭐지? 몸속에 모르는 감각이……)
					PRINTFORMW (거절할 수가 없어……)
				ELSE
					PRINTFORMW 「하, 하아? 그렇게 쉽게 몸을 허락한다고……. 히이야!?」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 손이 닿자마자 요우무는 평소보다 훨씬 크게 몸을 떨며 힘없이 주저앉았다……
					PRINTFORMW (왜…… 힘이, 들어가지 않는 걸까……?)
				ENDIF
			CASE 5
			CASE 6
				IF TALENT:恋慕
					PRINTFORMW 「저, 저기요, %CALLNAME:MASTER%씨, 기다려 주세요!」
					PRINTFORMW 「결코 불쾌하다거나 그런 건 아니에요…… 단지 저의 각오의 문제라서요」
					PRINTFORMW 「어느 정도 유예를 주신다면……」
				ELSEIF TALENT:思慕
					PRINTFORMW 「…………」
					PRINTFORMW 「……무슨 소리냐」
					PRINTFORMW 「우리들, 그런 관계가 아니지 않느냐」
				ELSE
					PRINTFORMW 「…………」
					PRINTFORMW 「그만둬 주십시오」
					PRINTFORMW (…당장 거절했어야 했는데, 어째서?)
				ENDIF
			CASE 7
				IF TALENT:恋慕
					PRINTFORMW 「……서로 더 알아가기 전이라도 늦지 않을 거라고 생각해요」
					PRINTFORMW 「저는 또 한 가지, %CALLNAME:MASTER%님이 이해가 안 가는 부분이 생겼으니까요」
				ELSEIF TALENT:思慕
					PRINTFORMW 「……그건 넘으면 안 되는 선이라는 것도 나도 알고 있어요」
					PRINTFORMW 「부디 다시 생각해 주세요」
				ELSE
					PRINTFORMW 「……농담이라도 웃을 수가 없어요」
				ENDIF
			CASE 8
				IF TALENT:恋慕
					PRINTFORMW 「……설령 %CALLNAME:MASTER%씨라도 그렇게까지 들어오게 할 생각은 없어요」
					PRINTFORMW 「놔 주세요」
				ELSE
					PRINTFORML 「그렇게 무시당하고 있었다니, 실망을 넘어 놀랍네요」
					PRINTFORMW 「제가 검사라는 걸 다시 한번 가르쳐 드려야 하나요?」
					PRINTFORMW 요우무는 지금 당장이라도 칼을 뽑아버릴 것 같은 기세다……
				ENDIF
		ENDSELECT
	ELSE
		IF TALENT:恋慕
			IF OUTROOF(CFLAG:現在位置)
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「뭐, 뭐라고!? 여기서 하는 겁니까...!?」
						CALL HPH_PRINT,@"「혹시라도 해서, 적어도 그림자 뒤에... 아... 응... HPH」","W"
					CASE 1
						PRINTFORML 「어...? 저기, 그게... 밖에 있어요...?」
						CALL HPH_PRINT,@"「언제 누가 올지 모르고, 장소를... 윽, 그렇게... 아우우 HPH」","W"
				ENDSELECT
			ELSEIF BATHROOM(CFLAG:現在位置)
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「%TEXTR("히얏/왓/")%!? 아, %CALLNAME:MASTER%씨……?」
						CALL HPH_PRINT,@"「그, 확실히…… 여러 가지 흘리기엔 편리하지만, 좀 더 숨겨야 하지 않을까아……! HPH」","W"
					CASE 1
						PRINTFORML 「%TEXTR("히얏/왓/")%!? 이, 지금은…… 부디 일단, 일단 진정해……!」
						CALL HPH_PRINT,@"「이대로 있으면 누가 들어왔을 때 한눈에, 아, 아아악 HPH」","W"
				ENDSELECT
				;振られた状態＆2分の1
			ELSEIF CFLAG:23:2001 == 1 && RAND:2 == 0
				PRINTFORMW 「몸이라도 원해 주시는 건, 행복이라고 생각해 버려요」
				PRINTFORMW 「……당신의 품 안에서, 모든 걸 잊게 해 주세요」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「……사랑하고 있어요, %CALLNAME:MASTER%씨」
						PRINTFORMW 「몇 번을 말해도 부족할 정도예요」
					CASE 1
						PRINTFORML 「당신에게 사랑받고 있다고 실감할 수 있다면, 색정에 빠져보는 것도 나쁘지 않을까 하고……」
						CALL HPH_PRINT,@"「그러니까, 또 새겨 주세요…… HPH」","W"
					CASE 2
						PRINTFORML 「처음은 아니지만, 아직 조금 긴장돼 버려요……」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 상냥하게 안아주자 요우무는 안심한 듯 몸의 힘을 풀었다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕
			PRINTDATAL
				DATAFORM 「……연인 사이도 아닌데, 절대 이상한데」
				DATAFORM 「……하실 거라면, 적어도 서둘러 주세요」
			ENDDATA
			PRINTFORMW (한 번 용서해 버리고 나서는, 저도 선을 긋는 것이 모호해져 버렸나 봐...)
		ELSE
			PRINTDATAL
				DATAFORM 「왜 이런 일이……?」
				DATAFORM 「나, 그런 뜻은 없었는데……」
			ENDDATA
			PRINTFORMW 「……알겠어」
		ENDIF
	ENDIF
ENDIF
