@M_KOJO_別人版_MESSAGE_COM_K23_336_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:泥酔 == 1
	ELSEIF CFLAG:318 == 1 || (MARK:23:反発刻印 == 1 && RAND:2 == 0) || MARK:23:反発刻印 > 1
		PRINTFORML 「……무릎 베개를 하고 싶다면, 무릎만 있으면 충분하겠죠?」
		PRINTFORMW 위태로운 분위기를 감지한 %조사처리(CALLNAME:MASTER,"는")% 황급히 요우무를 일으켜 세웠다……
	ELSEIF TFLAG:193 > 0
		;寝ちゃった
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORMW 「……스으……」
			PRINTFORML 안심한 듯 무방비하게 자고 있는 요우무의 표정은 더할 나위 없이 평온했다.
			PRINTFORMW 주어진 신뢰를 기쁘게 느끼며, %조사처리(CALLNAME:MASTER,"는")% 요우무가 깨어나기를 느긋하게 기다렸다.
		ELSE
			PRINTFORML 「응... 응? 나, 언제부터... 하앗」
			PRINTFORMW 「저, 실례했습니다! 길게 무릎을 빌려버려서」
			IF TALENT:恋慕
				PRINTFORMW 「방해되신다면 깨워주셔도 되는데요--후후, 다정하시네요. 그럼 잠시 당신의 말에 기대도록 할게요?」
			ELSEIF TALENT:思慕
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 있으면 괜히 마음이 느슨해져 버려서... 뭐, 무슨 말을 하고 있는 걸까, 나는...」
			ELSE
				PRINTFORMW 「스스로 인지하는 것 이상으로 지쳐버린 모양이네요... 이런 일은 안 되죠.」
			ENDIF
		ENDIF
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「후아…… 아, 죄송해요, 너무 편해서 저도 모르게……」
				PRINTFORMW 「갑작스러운 제안에 조금 당황했지만, 일단 무릎을 빌리니 사소한 것들은 신경 쓰이지 않네요」
				PRINTFORMW 「음…… 실례가 안 된다면, 이대로 좀 더 있어 주시면……」
			CASE 1
				PRINTFORML 「――저, 편안하신가요? 네, 음... 괜찮습니다, 네」
				PRINTFORMW (사실은 두근거려서 신경 쓸 여유가 없지만, 그것과는 별개로 이 시간이 더 길어졌으면 좋겠다...!)
				PRINTFORMW ((...앗! %CALLNAME:MASTER%님과 눈이 마주쳤어... 나 이상한 표정 하고 있으면 어떡하지...!?)
			CASEELSE
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 눈앞에서 요우무와 반령이 심상치 않은 분위기로 얼굴(?)을 맞대고 있다...
				PRINTFORML
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「……후훗」
						PRINTFORMW 잠시 후, 의기양양하게 코를 킁킁거리던 요우무가 반령을 밀쳐내고 %조사처리(CALLNAME:MASTER,"의")% 무릎에 머리를 기댔다.
					CASE 1
						PRINTFORML 「……윽……!」
						PRINTFORMW 잠시 후, 분한 듯 고개를 돌린 요우무를 뒤로하고 반령이 당당하게 %조사처리(CALLNAME:MASTER,"의")% 무릎 위로 안겼다.
				ENDSELECT
		ENDSELECT
	ELSEIF ABL:親密 > 4
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「이, 이건 꽤…… 부끄럽네요」
				PRINTFORMW 「싫어…… 같지는 않다고 생각해요, 아마……」
				IF TALENT:思慕
					PRINTFORMW (이 기분... 가려움을 느끼지만 나쁘진 않을지도)
				ELSE
					PRINTFORMW (......자신의 기분이, 모르겠다)
				ENDIF
			CASE 1
				PRINTFORML 「우으…… 생각보다 마음의 준비가 필요하네요, 이건……」
				PRINTFORMW (하지만 이미 앉아서 준비되어 있는 %CALLNAME:MASTER%씨를 팔로 감싸는 것도………… 그래!)
				PRINTFORMW 깜짝 놀라 얼굴을 들었던 요우무는 비어있는 %조사처리(CALLNAME:MASTER,"의")% 무릎에, \@ TALENT:思慕 ? 안절부절못하는 # 불만스러운 \@반령을 살며 올려놓았다……
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「…………」
				PRINTFORML (......왠지 흐름에 따라 무릎베개를 하고 있지만)
				PRINTFORMW (엄청 숨이 막힌다......)
			CASE 1
				PRINTFORML 「……이런 일은 좀 더 가까운 사이에서 하는 것이 아닐까」
				PRINTFORML 「오히려 진정되지 않아요, 이거……」
				PRINTFORMW 어색함 때문인지 옆의 반령이 부산스럽다……
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
