;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;TARGET連れ出し
	IF CFLAG:同行 == 60
		;酔っぱらっている
		IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
			PRINTFORML 「아, 어? ……조금…… 감기 걸리고 싶어요……」
			PRINTFORMW 상황을 보셨다고 생각했는지, 요우무는 망설임 없이 %조사처리(CALLNAME:MASTER,"의")% 손을 잡았다.
			;ブチギレ、または反発刻印2以上
		ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
			PRINTFORML 「…………」
			PRINTFORMW 일단 따라와 주기로 한 모양이야……
			;恋慕
		ELSEIF TALENT:恋慕
			IF BATHROOM(CFLAG:現在位置)
				PRINTFORMW 「저, 잠시만 기다려 주세요. 바로 몸을 씻겨 드릴 테니...!」
			ELSEIF CAN_IRAI_CHARA_GO_TOGATHER(TARGET)
				PRINTFORMW 「바로 들어주시는 거예요? 다행이에요!」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「어디로 가세요? 제가 함께 갈게요!」
					CASE 1
						PRINTFORMW 「나로 힘이 되어 줄 수 있다면」
					CASE 2
						PRINTFORMW 「세 걸음 뒤라니…… 좀 아깝네요」
				ENDSELECT
			ENDIF
		ELSE
			IF BATHROOM(CFLAG:現在位置)
				PRINTFORMW 「......목욕 중에 있는데요」
			ELSEIF CAN_IRAI_CHARA_GO_TOGATHER(TARGET)
				PRINTFORMW 「아, 그게…… 여기서는 어려울 것 같아요」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「저에게 용무가 있으신가요?」
					CASE 1
						PRINTFORMW 「네, 무슨 일이세요?」
					CASE 2
						PRINTFORMW 「상관없지만…… 어디로 갈까?」
				ENDSELECT
			ENDIF
		ENDIF
		;TARGET以外連れ出し(TARGET同行中のみ
	ELSE
	ENDIF
ENDIF
RETURN 1
