@M_KOJO_別人版_MESSAGE_COM_K23_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠 || FLAG:70 || TCVAR:泥酔 == 1
		RETURN 1
		;ブチギレ
	ELSEIF CFLAG:318 == 1
		PRINTFORML 「…………」
		PRINTFORMW 요우무는 한마디도 하지 않고 담담하게 조리를 마쳤다……
		;反発
	ELSEIF (MARK:23:反発刻印 == 1 && RAND:2 == 0) || MARK:23:反発刻印 > 1
		PRINTFORML 「……도와드리긴 할게요」
		PRINTFORMW 어색한 공기 속에서, %조사처리(CALLNAME:MASTER,"는")% 요우무와 함께 요리에 힘썼다…….
	ELSE
		SELECTCASE DISHNAME
			CASE "漬物"
				PRINTFORMW 「음음…… 장아찌인가요」
				PRINTFORML 「저희 집에서 제가 담그면 전혀 맛있게 안 되거든요」
				PRINTFORMW 「이 짧은 시간에 제대로 절여진 것 같아요…… 어떤 비법인지 알려주세요?」
			CASE "焼きいも"
				SELECTCASE DAY:2
					CASE 1
						PRINTFORMW 「군고구마를 만들어 주시는 건가요? 그렇다면 저는 불 준비를 하고 있어요」
						PRINTFORML 「……흠…… 벚꽃에, 군고구마……」
						PRINTFORMW (그런 조합도 가능할까……?)
					CASEELSE
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「이렇게 주방에서 예의 바르게 하는 것도 좋지만, 모처럼 고구마를 만드는 거라면 밖에서 굽는 것도 분명 재미있을 거라고 생각하거든요」
								PRINTFORMW 「낙엽을 모으고, 모닥불을 만들고…… 뭐, 만일의 사태를 고려하면 저택 정원에서는 절대로 할 수 없겠지만요」
								PRINTFORMW 「장작이나 고구마를 감싸는 데 쓸 종이는 텐구가 뿌려두고 있으니까 준비 자체는 비교적 쉽게 끝날 거예요……」
							CASE 1
								PRINTFORML 「보관에 신경을 쓰면 고구마는 오래 보존할 수 있는 식재료이고, 식탁에서 볼 기회가 많지 않을까요?」
								PRINTFORMW 「군고구마로 만들려면 종류에 따라 맛은 물론, 특히 완성된 식감에는 차이가 있으니 취향에 맞는 것을 선택하고 싶습니다.」
						ENDSELECT
				ENDSELECT
			CASE "義大莉而鳥苗鳥肉"
				PRINTFORMW 「이이다아...... 뭐, 뭐라고 하셨어요? 재료는 새고기랑... 헉!? 벌레잖아요...!?」
				PRINTFORML 「식용이라든지 그 이전의 문제예요... 이걸로는 안 됩니다!」
				PRINTFORMW 「저 같은 요리를 맡은 자가 조리 앞에 식재에 주눅이 들다니 한심하군... 순서 지시를 부탁드립니다!」
			CASE "おせち料理"
				IF DAY:2 == 1 && DAY:3 <= 3
					PRINTFORML 「단고말, 가마보코, 코하쿠나마스에 구리킨톤... 오세치 요리는 정월에 어울리는 화려함이 있습니다」
					PRINTFORMW 「각각 복을 기원하는 상징적인 역할도 있으니, 부족한 품목 중에서 만들 수 있는 것은 얼른 준비해 버립시다」
					PRINTFORMW 「주박스에 담는 방법도 확실히 알고 있으니, 그 부분은 저에게 맡겨 주세요!」
				ELSEIF DAY:2 == 2 && DAY:3 == 14
					PRINTFORMW 「뭐라고? ...!? 아니, 확실히 관용구로 그렇게 쓰이는 건 사실이지만!」
					PRINTFORML 「그렇다고 오늘 오세치 요리를 만든다고 해서 새해가 온 건...!」
					PRINTFORMW (엄청난 양의 재료와 화려한 식기라니... 어떡하지, %CALLNAME:MASTER%님의 눈빛이 진심이야...)
				ELSEIF DAY:2 == 4 && DAY:3 >= 29
					PRINTFORMW 「오세치 준비를? 미리 어느 정도 준비해 두지 않으면 정월에 맞지 않으니까요」
					PRINTFORML 「그럼 무엇부터 만들까요, 보관이 되는 것들로는――에엣!? 전부……!?」
					PRINTFORMW (대단한 의욕이시네요... 하지만 전부 준비해도 괜찮을까요...?)
				ELSE
					PRINTFORML 「오, 오세치? 아아...... 뭐, 연습에 한 가지 정도 만든다면... 응?」
					PRINTFORMW (주단지에 긴 접시, 옻칠 그릇까지... 설마, 다 해버리는 건가...?)
				ENDIF
			CASE "恵方巻"
				IF DAY:2 == 4 && DAY:3 == 3
					PRINTFORML 「오늘은 절분이니까, 계절 행사는 걸맞은 길조물로 색을 더합시다!」
					PRINTFORMW 「모처럼이니 한눈에 평범한 김말이가 아니라고 알 수 있을 정도로 호화롭게 만들고 싶습니다.」
					PRINTFORMW 「...오오, 저렇게 긴 말는 장식이 있네요. 기합이 들어가겠어요...!」
				ELSE
					PRINTFORML 「흠흠... 이 재료는 김말이를 만드시는 거군요, 저도 도와드릴-」
					PRINTFORM 「엣, 혜방만...? 그냥 평범한 김말로 괜찮지 않을까요...」
					IF TALENT:思慕 || TALENT:恋慕
						PRINTFORMW 네, 알겠습니다...
						PRINTFORMW (다음 세츠분(절춘)을 바라보고 있는 걸까...?)
					ELSE
						PRINTFORMW 아, 알겠습니다…….
						PRINTFORMW (이상한 곳에 집착하는 사람이네……)
					ENDIF
				ENDIF
			CASE "白玉みつまめ"
				IF FIRSTTIME("妖夢固有料理")
					PRINTFORML 「나에게 레시피를 배우고 싶다고……. 오히려 내가 가르쳐주고 싶은데」
					PRINTFORMW 「음……」
					PRINTFORML 「……맞아!」
					PRINTFORMW
					PRINTFORML 「전에 반쯤 영령을 의식해서 백옥을 늘린 미츠마메를 만들어봤어요」
					PRINTFORML 「이게 꽤 괜찮게 완성돼서, 저 스스로도 빼어나다고 자부하고 있답니다」
					;夏
					SELECTCASE DAY:2
						CASE 2
							PRINTFORML 「모습도 시원해 보여서 요즘 계절에 딱인 것 같아요」
							;それ以外の季節
						CASEELSE
							PRINTFORML 「뭐랄까, 지금 계절에 먹고 싶다고 하면 좀 의아할지도 모르겠지만……」
					ENDSELECT
					PRINTFORMW
					PRINTFORML 「……흥미가 있으신가요! 그렇다면 바로 만들어 볼게요」
					PRINTFORMW 「우선 백옥 준비부터――」
					PRINTFORML 「우히야!? 왜 갑자기 반령을 따서……」
					PRINTFORML 「그, 그러니까! 어디까지는 의식하고 있을 뿐, 실물을 사용하는 건 아니에요!」
					PRINTFORMW
					PRINTFORML 이후에는 진지하게 요우무에게 지도를 받았다……
					PRINTFORMW 「네, 완성이에요! 거듭 말씀드리지만, 백옥의 삶기 정도에는 주의하셔야 해요?」
				ELSEIF STRCOUNT(DISH_TASTE, "練習")
					PRINTFORML 「무슨 일이든 반복하지 않으면 몸에 배지 않으니까요」
					PRINTFORMW 「%CALLNAME:MASTER%님이 납득하실 때까지 가르쳐 드릴게요!」
					PRINTFORML 「……반령은 쓰지 말고!」
					PRINTFORMW 미리 강조되어 버렸다…….
				ELSE
					PRINTFORML 「마음에 드셨나요? 그럼 기쁠 거예요!」
					PRINTFORMW
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「……아까부터 계속 보고 있었는데」
							PRINTFORMW 「만약 반령이 같은 크기의 하쿠타마라면, %CALLNAME:MASTER%씨는 다 드실 수 있겠어요?」
						CASE 1
							SELECTCASE DAY:2
								CASE 2
									PRINTFORML 「차가운 단맛이라 이 계절에는 감사할 일이죠」
									PRINTFORMW 「혹시 그중에서 일부러 골라주신 거라면, 왠지 기분이 좋네요」
								CASEELSE
									PRINTFORML 「……이라고는 말씀드렸지만, 시기상조라는 느낌은 부정할 수 없다……」
									PRINTFORMW 「그럼에도 먹고 싶다고 생각해주신 거라면, 그것으로도 기쁘다만」
							ENDSELECT
					ENDSELECT
				ENDIF
			CASE "桜餅"
				SELECTCASE DAY:2
					CASE 3
						PRINTFORMW 「……뭐라고? 자, 벚꽃잎떡을? 그것도 지금부터……?」
						PRINTFORML 「벚꽃잎은…… 준비할 수 있다고? 그렇다면 그쪽에게 부탁하지만……」
						PRINTFORMW (이 시기에 구할 수 있을까……?)
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「桜餅とはまた繊細な物をご所望ですね。作り方は……な읏、유유코님께 배웠어요...!?」
								PRINTFORMW 「ど、どうやてつまみ食い以外で유유코님を厨に? しかも料理まで教えていただけるなんて……」
								IF TALENT:66:恋慕
									PRINTFORMW (......아니, %조사처리(CALLNAME:MASTER,"에게")% 부탁받았다면 순순히 가르쳐 줄 것 같네...)
								ELSE
									PRINTFORMW (유유코님, 생각보다 %CALLNAME:MASTER%씨를 마음에 들어 하는 것 같아...)
								ENDIF
							CASEELSE
								PRINTFORMW 「벚꽃떡을 만들어 주시는군요. 반죽은 밀가루인가 도메지코 가루, 어느 것을 사용하실 건가요?」
								PRINTFORML 「저는 어느 쪽이든 괜찮으니, \@ TALENT:恋慕 ? %CALLNAME:MASTER%님 # 그쪽 \@의 취향에 맡길게요」
								PRINTFORMW 능숙하게 준비를 진행하는 요우무는 어딘가 기분이 좋아 보인다.
						ENDSELECT
				ENDSELECT
			CASEELSE
				IF STRCOUNT(DISH_TASTE, "グロテスク") || STRCOUNT(DISH_TASTE, "謎料理")
					PRINTFORMW 「윽……!?」
					PRINTFORML 「나도 도와줬는데, 대체 이 요리는……?」
					PRINTFORMW 「……저, 저는 사양하고 싶습니다……」
				ELSEIF TALENT:恋慕
					PRINTFORML 「요리군요, 그럼 같이 만들어 봐요!」
					PRINTFORMW
					SELECTCASE RAND:5
						CASE 0
							IF ABL:MASTER:料理技能 > 4
								PRINTFORML 「와, 굉장한 솜씨……」
								PRINTFORMW 「옆에서 보니 제 실력은 아직 갈 길이 멀다는 걸 절실히 깨닫게 되네요」
								PRINTFORMW 「그러니까 또 가르쳐 주세요♪」
							ELSEIF ABL:MASTER:料理技能 > 1
								PRINTFORML 「이렇게 둘이서 요리하다 보면 깨닫게 되는 부분이 많네요」
								PRINTFORML 「그걸 과제로 삼는다면, 다시 와보면 다음엔 분명」
								PRINTFORMW 「더 맛있게 만들 수 있을 거예요!」
							ELSE
								PRINTFORML 「앗, %CALLNAME:MASTER%씨 그거 아직……!」
								PRINTFORMW 「아, 아니에요. 제가 어떻게 해볼게요!」
							ENDIF
						CASE 1
							PRINTFORML 「사랑은 최고의 조미료라고들 하잖아요」
							PRINTFORMW 「그게 사실인지 아닌지는…… 이 요리를 먹고 알려주세요」
						CASE 2
							PRINTFORML 「이것에만 국한된 이야기는 아니지만」
							PRINTFORML 「제가 만들면 어쩐지 등골이 살짝 오싹해지는 맛의 요리가 만들어져 버리거든요……」
							PRINTFORMW 「이상한 건 넣지도 않는데, 대체 왜……?」
						CASE 3
							PRINTFORML 「둘이서 만들면 왠지 기분도 들뜨네요」
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 매 끼니 함께 주방에 서 준다면……」
							PRINTFORMW 요우무는 먼 눈으로 허공을 응시하고 있다……
						CASE 4
							PRINTFORML 「플레이팅은 이렇게 해서…… 완성이에요!」
							PRINTFORMW 「어때요? 비주얼도 중요하니까요」
					ENDSELECT
				ELSE
					PRINTFORML 「요리예요? 저도 도와드릴게요!」
					PRINTFORMW
					SELECTCASE RAND:4
						CASE 0
							IF ABL:MASTER:料理技能 > 4
								PRINTFORML 「스, 대단하다……」
								PRINTFORMW 「어디서 그러한 기량을? 부디 저에게도 가르쳐 주시면 좋겠소……」
							ELSEIF ABL:MASTER:料理技能 > 1
								PRINTFORML 「옆에 자신을 알아주는 사람이 있다는 건 솔직히 대단하네요」
								PRINTFORMW 「%CALLNAME:MASTER%씨, 요리하는 일에는 관심 없으세요?」
							ELSE
								PRINTFORML 「엣, 그거 방금 넣었던 것 같은데……」
								IF TALENT:思慕
									PRINTFORMW 「자, 아직 어떻게든 될 거예요. 포기하면 끝이에요!」
								ELSE
									PRINTFORMW (저, 어떡하지……. 먹을 수는 있을 것 같은데……)
								ENDIF
							ENDIF
						CASE 1
							PRINTFORML 「저택에는 제대로 살림 담당 유령도 있답니다」
							PRINTFORMW 「그 와중에 제가 그 정도 지식까지 갖추고 있는지는…… 헤아려 주시겠어요」
						CASE 2
							PRINTFORMW 「여기만 알고 있어, 백옥루의 지출의 아홉 할은 식비야」
							PRINTFORML 「……농담이야?」
							PRINTFORMW 요우무는 공허한 눈을 하고 있다……
						CASE 3
							PRINTFORML 「빠르게, 싸게, 맛있게. 식의 도달점 중 하나라고 생각한다」
							PRINTFORMW 「나도 그 길을 연마할 수 있다면……」
					ENDSELECT
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
