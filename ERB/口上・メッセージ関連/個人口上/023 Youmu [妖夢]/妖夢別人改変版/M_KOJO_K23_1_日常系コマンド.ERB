		ENDSELECT
		;TARGETが釣った
	ELSEIF TFLAG:194 >= 1000
		SELECTCASE COM_STR
			CASE "紙切れ"
				PRINTFORML 「종이 조각? ……산 신사의 소행인가요」
				PRINTDATAW
					DATAFORM 「손의 넓이만큼은 솔직히 감탄하게 된다」
					DATAFORM 「모아서 가져가면 복권 당첨된 것 같지만……조과에 포함하고 싶지는 않다」
				ENDDATA
			CASE "木片"
				PRINTFORML 「어라? 그, 분명 입질은 왔었는데……」
				PRINTFORMW 「……근이 잡히지 않았을 뿐이라 생각하시겠습니까」
			CASE "ローター"
				IF CFLAG:23:2004 == 1
					PRINTFORML 「우윽!? 코, 이것은...」
					PRINTFORML 「...어째서 이런 물건이 평범하게 호수나 강에 존재하고 있는 걸까요? 도저히 수생 환경에 적합해 보이지 않는데요」
					PRINTFORMW 「낚아버린 이상은—어, %CALLNAME:MASTER%님이? 다행이에요...!」
				ELSE
					PRINTFORML 「이건 정말 대체 뭔 거죠…… 생명체라고 인정하고 싶지는 않지만」
					PRINTFORML 「가끔 산이나 들에서도 보이고, 유난히 시끄럽기도 하고요…… 분명 신종 해수겠죠」
					PRINTFORMW 「밖에서 너무 많이 박혀서 이쪽으로 온 건가요? 그 근처에 대해 %CALLNAME:MASTER%님은 아는 거 있으세요?」
				ENDIF
			CASE "氷の鱗", "龍の爪", "龍涎香"
				PRINTFORML 「오오…… 뭔가 희귀해 보이는 게 잡혔네요」
				PRINTFORMW 「저로서는 못 쓰겠으니까, %CALLNAME:MASTER%씨께 드릴게요」
			CASE "カエル"
				PRINTFORML 「어라, 개구리였나. 물고기는 아니고, 어떡하지…….」
				PRINTFORMW 「에? 하아……. 원하신다면 넘겨드리겠지만……?」
			CASEELSE
				PRINTDATAW
					DATAFORM 「――앗, 지금이에요!」
					DATAFORM 「도망치지 못하게 할 거예요!」
					DATAFORM 「후후, 어느 정도는 알고 있으니까요」
				ENDDATA
		ENDSELECT
		;MASTERが釣った
	ELSE
		SELECTCASE COM_STR
			CASE "紙切れ"
				PRINTFORML 「종이 조각? ……산 신사의 소행이군요」
				PRINTDATAW
					DATAFORM 「손의 넓이만은 솔직히 감탄하게 된다」
					DATAFORM 「모아서 가져가면 행운을 끌 수 있을 것 같지만, 이것이 잡힌 시점부터 불운을 안고 있는 것이겠지……」
				ENDDATA
			CASE "木片"
				PRINTFORML 「어라? 나무에 걸려 있었던 것 같네요」
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「……우으, 이건 귀찮은 방식으로 진행하고 있어요. 바늘을 상하게 하지 않도록 서두르지 말고 신중하게……」
					CASE 1, 2
						PRINTFORMW 「하지만 이거라면 쉽게 풀 수 있을 것 같아요. 이상하게 걸려 있으면 귀찮고 귀찮아서……」
				ENDSELECT
			CASE "ローター"
				IF CFLAG:23:2004 == 1
					PRINTFORML 「뭐라고!? 저, 저건...」
					PRINTFORML 「...어째서 그런 물건이 평범하게 호수나 강에 존재할 수 있는 걸까요? 설마 누군가 불법 투기한 건 아닐까요」
					PRINTFORMW 「잡아버린 이상, 쓰레기는 확실히 가져가야겠네요...」
				ELSE
					PRINTFORML 「그건 정말 대체 정체가 뭔 거죠…… 생물이라고 인정하고 싶지는 않지만」
					PRINTFORML 「가끔 산이나 들에서도 보이던걸요, 되게 시끄럽기도 하고…… 분명 새로운 종류의 해수일 거예요」
					PRINTFORMW 「밖에 너무 많이 제거되다가 이곳으로 왔을까요? 그쪽 일은 %CALLNAME:MASTER%씨는 아시는 게 있으신가요?」
				ENDIF
			CASE "氷の鱗", "龍の爪", "龍涎香"
				PRINTFORML 「오오…… 뭔가 희귀해 보이는 게 잡혔네요」
				PRINTFORMW 「물고기는 아니지만 가치가 있을 것 같으니, 충분히 조과로 셀 수 있어요!」
			CASE "カエル"
				PRINTFORML 「어라, 개구리였네요. 물고기는 아니지만 어떻게 해드릴까요?」
				PRINTFORMW 「……긴, 비상시 철분 보충용으로요? 어떤 상황에서 쓰시는 거예요……」
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「훌륭해요, %CALLNAME:MASTER%씨!」
						IF TALENT:MASTER:釣りLv >= 3 && RAND:2 == 0
							PRINTFORMW 「그 능숙한 낚싯대 다루는 솜씨, 저도 꼭 배워보고 싶어요」
						ELSE
							PRINTFORMW 「낚시는 순탄하지 않지만, 애써 낚아 올렸을 때의 기쁨은 이루 말할 수 없어요」
						ENDIF
					CASE 1
						PRINTFORMW 「화려한 솜씨예요, 저도 지고 있을 순 없죠!」
					CASE 2
						PRINTFORML 「낚은 걸로 어떤 요리를 만들 수 있을지 생각하는 것도 재미있잖아요」
						PRINTFORMW 「물고기 종류에 따라 손질이 힘들기도 하니까, 의외로 중요한 단계일지도 모르죠?」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
