@M_KOJO_別人版_MESSAGE_COM_K23_626_1
;下記の2行を忘れると定義できなかった
#DIMS 品名
#DIMS 属性
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;贈っていたら本体名と属性を取得しておく
	IF TFLAG:194 > 0
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:23:今日の贈り物, "本体"))
		品名 = %RESULTS%
		IF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				属性 = 身につける
			属性 = 握る
		ELSEIF STRFIND(RESULTS:1, "抱く") >= 0
			属性 = 抱く
		ELSEIF STRFIND(RESULTS:1, "身につける") >= 0
			属性 = 身につける
		ELSE
			属性 = 眺める
		ENDIF
	ENDIF
	SIF TCVAR:泥酔 == 1
		RETURN 1
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			;香霖堂内を定義したい
			IF MAIN_MAP != 5 && CFLAG:MASTER:現在位置 == 520
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「크윽, 저 가게 주인……!」
						PRINTFORMW 「……아니, 이번에 예의를 갖추지 못한 건 저 쪽인가요. 누르지 않으면……」
					CASE 1
						PRINTFORML 「저희에게도 잘못은 있지만, 저 가게도 그 가게잖아요!」
						PRINTFORMW 「한정판이 너무 많다고요!」
				ENDSELECT
			ELSEIF TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아하하…… 너무 빠져버렸어요」
						PRINTFORMW 「가게 분께도 폐를 끼쳐 버렸네요……」
					CASE 1
						PRINTFORML 「아앗, 시간을 잊고 있었어요……」
						PRINTFORMW 「저도 고르는 데 집중해 버려서……앗, 그, 신경 쓰지 말아 주세요」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「좀 너무 고민하셨네요……」
						PRINTFORMW 「계획하는 것도 중요하지만, 가게 사정도 생각해야죠.」
					CASE 1
						PRINTFORML 「시간을 너무 많이 썼나……」
						PRINTFORMW 「꽤 몰두했던 것 같은데, 도대체 무엇을 찾고 있는 거지?」
				ENDSELECT
			ENDIF
			;やっぱりやめる（見送り）
		CASE -1
			IF MAIN_MAP != 5 && CFLAG:MASTER:現在位置 == 520
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「상식적인 판단이네요, %CALLNAME:MASTER%씨」
						PRINTFORMW 「어차피 여기엔 고물밖에 없으니까요」
					CASE 1
						PRINTFORML 「도대체 뭔지 모르는 물건들만 잔뜩 있고, 저 가게 주인한테 자세한 걸 묻는 건 성급하잖아요」
						PRINTFORMW 「게다가 도저히 이해할 수 없는 억지 논리로 귀한 시간을 낭비하게 되니까요」
				ENDSELECT
			ELSEIF TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「가게 분께는 죄송하지만, 상품을 둘 뿐만으로도 즐겁지 않은가요」
						PRINTFORMW 「%CALLNAME:MASTER%님은 눈에 띄는 물건이 있었습니까?」
					CASE 1
						PRINTFORML 「검이나 칼을 보면 나도 모르게 눈길이 가버려요」
						PRINTFORMW 「반령을 사용하면 사도까지는 어렵지 않게 휘두를 수 있으니까, 언젠가 다른 무기로 해보고 싶네요……」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「어라, 괜찮으신가요?」
						PRINTFORMW 「뭐, 상황이 되어 사서 손에 들고 남기에는 아깝잖아요.」
					CASE 1
						PRINTFORML 「뭐 찾으시는 게 있다면 저도 도와드려야죠」
						PRINTFORMW 「이런 안목에는 그렇게 자신은 없지만……」
				ENDSELECT
			ENDIF
			;400点未満（BAD）
		CASE 1
			PRINTDATAL
				DATAFORM 「그, 그건 저에게 주는 건가요...? 아, 아니, 그러니까……」
				DATAFORM 「%CALLNAME:MASTER%님의 취미는 그런 종류의…… 네? 저한테요?」
				DATAFORM 「응응...? 이걸 제가……?」
			ENDDATA
			PRINTFORML 「아, 감사합니다……」
			IF TALENT:恋慕
				PRINTFORMW 요우무는 미소로 선물을 받았지만, 입가에 약간 경련이 일고 있다……
				IF MAIN_MAP != 5 && CFLAG:MASTER:現在位置 == 520
					PRINTFORML (%조사처리(CALLNAME:MASTER,"에게")% 이런 잡화를 팔다니……읏)
					PRINTFORMW (……안, 안 돼. %CALLNAME:MASTER%앞에서 약한 모습을 보일 순 없어)
				ELSE
					PRINTFORMW (어, 어떡하지……. 내 취향으로 %조사처리(CALLNAME:MASTER,"에게")% 망신을 줄 수는 없는데……)
				ENDIF
			ELSE
				PRINTFORMW 너무 취향에서 벗어난 선물에 요우무는 당황한 듯하다…….
				IF MAIN_MAP != 5 && CFLAG:MASTER:現在位置 == 520
					PRINTFORMW (이 고물 창고에 조금이라도 기대를 했던 내가 바보였어……!)
				ELSE
					PRINTFORMW (혹시 이건 기념품이 아니라, 뭔가 중대한 의도가 숨겨져 있는 건 아닐까……?)
				ENDIF
			ENDIF
			;400点～699点（NOMAL）
		CASE 2
			PRINTDATAL
				DATAFORM 「이건 방금 사신 거였는데... 제가 받아도 괜찮을까요?」
				DATAFORM 「조금 관심 있던 물건이었는데, 이렇게 얻게 되다니……」
				DATAFORM 「와아, 영 송구하네요... 아니에요, 이럴 때는 다르죠」
			ENDDATA
			PRINTFORML 「고마워요, %CALLNAME:MASTER%씨」
