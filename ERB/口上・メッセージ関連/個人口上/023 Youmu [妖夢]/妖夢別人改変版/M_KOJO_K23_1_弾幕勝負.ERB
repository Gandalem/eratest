; Modular ERB: 個人口上/023 Youmu [妖夢]/妖夢別人改変版/M_KOJO_K23_1_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_別人版_MESSAGE_COM_K23_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_別人版_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;泥酔
		IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
			PRINTFORML 「그, 검사라면 어떤 상황에서도……」
			PRINTFORMW 비틀거리며 칼을 뽑은 요우무는 누가 봐도 발이 붙지 않는다…….
			;ブチギレor反発刻印2以上
		ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
			PRINTFORML 「베어보면 알겠지…… 다시는 없는 기회야」
			PRINTFORMW 쌍검을 뽑아든 요우무는 로칸켄의 칼끝에 %조사처리(CALLNAME:MASTER,"를")% 포착했다…….
			;MASTERの方が強い
		ELSEIF ABL:MASTER:戦闘能力 > ABL:戦闘能力
			PRINTDATAL
				DATAFORM 「전력으로 할게요...!」
				DATAFORM 「%CALLNAME:MASTER%님, 힘을 빌려주세요!」
				DATAFORM 「스스로를 가늠하기에 딱 좋은 상대입니다...!」
			ENDDATA
			PRINTFORMW 두 자루의 칼을 뽑아든 요우무는 빈틈없이 자세를 잡고 %조사처리(CALLNAME:MASTER,"를")% 응시했다.
			;MASTERと互角
		ELSEIF ABL:MASTER:戦闘能力 == ABL:戦闘能力
			PRINTDATAL
				DATAFORM 「승부욕이 넘치네요!」
				DATAFORM 「자, 정식으로 시작하죠!」
				DATAFORM 「거의 호각…… 각오해라!」
			ENDDATA
			PRINTFORMW 양도를 뽑아든 요우무는 여유롭게 자세를 잡고 %조사처리(CALLNAME:MASTER,"와")% 대치했다.
			;MASTERの方が弱い
		ELSE
			PRINTDATAL
				DATAFORM 「서비스로 칼을…… 역시 사양하겠습니다」
				DATAFORM 「단련의 일환인가요? 그렇다면 상대해 드리겠습니다」
				DATAFORM 「성과를 얻고 싶은 심정은 이해할 수 없지는 않지만……」
			ENDDATA
			PRINTFORMW 요우무는 도관검만을 뽑은 채 정면을 응시하며 %조사처리(CALLNAME:MASTER,"의")% 선수를 기다리고 있다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML
			CASE 2
				IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
					PRINTFORML 「부, 분신……! 언제부터 그런 짓을……!?」
					PRINTFORMW 아무래도 요우무에게는 %조사처리(CALLNAME:MASTER,"가")% 여러 명으로 보이고 있는 것 같다…….
				ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
					PRINTFORML 「큭」
					PRINTFORMW 피격당한 요우무는 즉시 자세를 바로잡고, 다시 %조사처리(CALLNAME:MASTER,"에게")% 달려들었다…….
				ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML (……강해!)
							PRINTFORMW 「역시 부족함은 없습니다!」
						CASE 1
							PRINTFORML 「……역시!」
							PRINTFORMW 「하지만 승부는 여기서부터예요!」
						CASE 2
							PRINTFORML 「――앗!」
							PRINTFORMW (밀리고 있어…!)
					ENDSELECT
				ELSE
					PRINTDATAL
						DATAFORM 「아, 저거...?」
						DATAFORM 「와아...! 」
					ENDDATA
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 공격에 피격한 요우무는 주춤거리면서 칼을 다시 들었다.
				ENDIF
			CASE 1
				IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
					PRINTFORML 「하지만, 어째서……? 이번엔 어떤 술법을!」
					PRINTFORMW 요우무는 드디어 취기를 감추지 못하게 된 것 같다……
				ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
					PRINTFORML 「크,윽――앗」
					PRINTFORMW 피격도 꺼리지 않는 요우무의 칼날이 %조사처리(CALLNAME:MASTER,"의")% 턱을 집요하게 노린다……
				ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML (한 번 냉정해지지 않으면……!)
							PRINTFORMW 자세가 무너진 요우무는 다시 흐름을 잡기 위해 %조사처리(CALLNAME:MASTER,"와")% 크게 거리를 두었다.
						CASE 1
							PRINTFORML 「……아직, 끝나지 않았어요!」
							PRINTFORMW 요우무가 칼로 정면을 크게 베자, 그 궤적에서 더욱 많은 탄막이 발사되었다.
						CASE 2
							PRINTFORML 「크윽…… 이거 피할 수 있을까요!?」
							PRINTFORMW 더욱 속도와 밀도를 높인 검섬이 %조사처리(CALLNAME:MASTER,"에게")% 다가온다.
					ENDSELECT
				ELSE
					PRINTDATAL
						DATAFORM (아, 큰일 날지도……)
						DATAFORM (저런 곳에 안전지대가……!?)
					ENDDATA
					PRINTFORMW 궁지에 몰린 요우무는 드디어 백루검에 손을 댔다.
				ENDIF
			CASE 0
				IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
					PRINTFORML 「꺅아아아악!?」
					PRINTFORMW 완전히 취해버린 요우무는 엉뚱한 곳으로 돌진해서 자멸하고 말았다……
				ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
					PRINTFORML 「아……」
					PRINTFORMW 허세 부리지 않겠다고 달려들던 요우무는 결국 무릎을 꿇었다……
				ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「으윽……」
							PRINTFORMW 「저, 여기까지예요……」
						CASE 1
							PRINTFORML 「아우……!?」
							PRINTFORMW 「저, 무릎을 꿇었습니다……」
						CASE 2
							PRINTFORML 「그런……!?」
							PRINTFORMW 「오, 오묘하십니다……」
					ENDSELECT
				ELSE
					PRINTFORMW 「응!?」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
			PRINTDATAL
				DATAFORM 「자, 삼혼, 구하쿠……?」
				DATAFORM 「잔기…… 아니, 자츠넨……?」
				DATAFORM 「정원의 벚꽃을 전지참~!!」
			ENDDATA
			PRINTFORMW 취해버린 요우무가 내뿜는 탄막은, 이제 더 이상 스펠카드의 형태를 하고 있지 않아!
		ELSE
			SELECTCASE RAND:5
				CASE 0
					IF ABL:戦闘能力 > 4
						PRINTFORML 「인귀『미래영겁참』!!」
						PRINTFORMW 불가능한 속도에서 발사되는 수많은 참격이 공간을 가득 채운다!
					ELSE
						PRINTFORML 「인부 '현세참'!」
						PRINTFORMW 신속한 돌진에서 나온 일격이 %조사처리(CALLNAME:MASTER,"에게")% 육박한다!
					ENDIF
				CASE 1
					IF ABL:戦闘能力 > 4
						PRINTFORML 「단미검 '미츠지호항참'!」
						PRINTFORMW 요력으로 이루어진 거대한 푸른 칼날이 %조사처리(CALLNAME:MASTER,"를")% 향해 내리쳐진다!
					ELSE
						PRINTFORML 「단명검 『명상참』!」
						PRINTFORMW 요력으로 이루어진 장대한 녹색 칼날이 %조사처리(CALLNAME:MASTER,"에게")% 내리쳐졌다!
					ENDIF
				CASE 2
					IF ABL:戦闘能力 > 4
						PRINTFORML 「천신검 『삼혼칠백』!」
						PRINTFORMW 오색의 탄막과 동시에 날아간 검섬이 %조사처리(CALLNAME:MASTER,"에게")% 쇄도한다!
					ELSE
						PRINTFORML 「천상검 『천인의 오쇠』!」
						PRINTFORMW 요우무가 발사한 다섯 가지 색의 탄막이 %조사처리(CALLNAME:MASTER,"에게")% 쏟아진다!
					ENDIF
				CASE 3
					PRINTFORML 「육도검 『일념무량겁』!」
					PRINTFORMW 참격으로 그려진 팔각성에서 탄막이 연달아 쏟아져 나온다!
				CASE 4
					PRINTFORML 「벚꽃검 『섬섬산화』!」
					PRINTFORMW 요우무의 모습이 사라지자, 분홍빛 참격이 사방으로 난무하기 시작했다!
			ENDSELECT
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;MASTER勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
				PRINTFORML 「역시 히쿄예요! 술 마시지 않을 때도 한 번 더요!!」
				PRINTFORMW 바닥에 주저앉은 요우무는 잠시 동안 그 자리에서 칭얼거렸다……
			ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
				PRINTFORML 「……왜, 서……읏」
				PRINTFORMW 애써 내뱉듯 중얼거린 요우무는 더 이상 아무 말도 하지 않았다…….
			ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「적은 없었나요……」
						PRINTFORMW 「좋은 경험이 되었어요. 괜찮다면 또 상대해 주실 수 있나요?」
					CASE 1
						PRINTFORML 「조금 더 받아낼 수 있을 줄 알았다만…….」
						PRINTFORMW 「전망의 허점까지 포함해, 아직 길은 멀어 보인다…….」
					CASE 2
						PRINTFORML 「아파…… 아니, 괜찮아요」
						PRINTFORMW 「……저, 죄송해요. 그래도 도움을 청해도……?」
				ENDSELECT
			ELSE
				PRINTDATAL
					DATAFORM 「……이것도 나 자신의 미숙함 때문이야」
					DATAFORM 「자만심…… 아니, 기만인가요」
				ENDDATA
				PRINTFORMW 「%CALLNAME:MASTER%씨, 배우게 해주셔서 감사해요……」
			ENDIF
			;妖夢勝利
		ELSE
			IF ALCOHOL_FACE(23) == "酔いどれ" || ALCOHOL_FACE(23) == "ぐでぐで"
				PRINTFORML 「어때요! 술 때문에 검술이 무뎌지다니……. 윽」
				PRINTFORMW 「죄, 죄송해요. 잠시만 쉬게 해 주세요……」
			ELSEIF CFLAG:318 == 1 || MARK:23:反発刻印 > 1
				PRINTFORML 「……죽이지는 않아요, 약속이니까」
				PRINTFORMW 칼을 칼집에 넣은 요우무는 조용히 몸을 돌렸다……
			ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
				SELECTCASE 相手残機
					CASE 4
						PRINTFORML
					CASE 3
						PRINTDATAL
							DATAFORM 「혹시, 어디 컨디션이……?」
							DATAFORM 「……%CALLNAME:MASTER%씨, 살살 해줄래요?」
							DATAFORM (……뭔가, 다르다)
						ENDDATA
						PRINTFORMW 요우무는 완승이라는 결과에 납득하지 못하는 것 같다…….
					CASE 2
						PRINTDATAL
							DATAFORM 「후우…… 이번엔 제 승리네요」
							DATAFORM 「열심히 하면 탄막도 벨 수 있답니다」
							DATAFORM 「스스로 아는 것보다, 저의 실력이 위일지도 모르겠어요」
						ENDDATA
						PRINTFORMW 칼을 칼집에 넣은 요우무는 조용히 숨을 내뱉었다.
					CASE 1
						PRINTDATAL
							DATAFORM 「크윽, 이겼다……!!」
							DATAFORM 「……망설인다면 패배합니다」
							DATAFORM (조금이라도 붙잡을 수 있었어……)
						ENDDATA
						PRINTFORMW 한순간의 승부를 결정지은 요우무는 확실한 손맛을 느낀 듯했다.
					CASE 0
						PRINTFORMW 「에엑!? 여기는 보여주면 안 돼요!」
				ENDSELECT
			ELSE
				PRINTFORML 「또…… 시시한 걸 베어버리고 말았네」
				SELECTCASE 相手残機
					CASE 4
						PRINTFORMW
					CASE 3
						PRINTFORMW
					CASE 2
						PRINTFORMW (조금 방심했나……)
					CASE 1
						PRINTFORMW (앗, 위험한 곳이었어...!)
					CASE 0
						PRINTFORMW (그러니까 표시하면 안 된다고 했잖아요!)
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
