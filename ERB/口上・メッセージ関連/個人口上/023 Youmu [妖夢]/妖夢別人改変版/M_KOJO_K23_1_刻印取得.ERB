; Modular ERB: 個人口上/023 Youmu [妖夢]/妖夢別人改変版/M_KOJO_K23_1_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_別人版_MESSAGE_MARKCNG_MESSAGECHECK_K23
RETURN 0

@M_KOJO_別人版_MESSAGE_MARKCNG_K23
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
SIF FLAG:時間停止 ;custom code
	RETURN 0
;快楽刻印
IF CFLAG:MASTER:イタズラ == 2
	PRINTL
ELSEIF TFLAG:23 == 1
	PRINTFORML 「응읏, 응으으……! ……뭐야, 이거」
	PRINTFORMW (몸이 뜨거워져…… 나, 너무 흘러가고 있는 걸까……)
ELSEIF TFLAG:23 == 2
	PRINTFORML 「우아, 하앗…… 이, 이런 감각을 알게 되면……」
	IF TALENT:恋慕
		CALL HPH_PRINT,@"(거짓말, 뭐인 거지…… 내 몸 같지 않아…… HPH)","W"
	ELSE
		PRINTFORMW (거짓말, 거짓말…… 점점 몸이 이상하게……)
	ENDIF
ELSEIF TFLAG:23 == 3
	IF TALENT:恋慕
		CALL HPH_PRINT,@"「앗, 안, 돼…… 에헤헵 하핫, 이거…… 대단한 거야…… 하프」","L"
		PRINTFORMW 스스로 암컷이라는 사실 외에 모든 것을 상실한 채, 흐트러진 입은 먹이를 찾는 새끼 새와도 같았다.
		PRINTFORMW 순수하고 강인한 소녀의 몸은 이 순간 %조사처리(CALLNAME:MASTER,"가")% 가져다주는 쾌락에 완전히 물들어 있었다.
	ELSE
		PRINTFORML 「이, 이럴 수가…… 나, 이제 더는…… 참을 수 없어……」
		PRINTFORMW 자신의 암컷이라는 사실을 깨닫고 호흡을 가다듬으려 얕은 숨을 반복하는 모습은 익사한 듯했다.
		PRINTFORMW 순수하고 솔직한 소녀의 몸은, 바로 지금 %조사처리(CALLNAME:MASTER,"가")% 주는 희열에 잠겨 있었다.
	ENDIF
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORML (……지금의, 내가……?)
	PRINTFORMW 요우무는 자신의 입에서 새어 나온 목소리에 당황하고 있는 듯하다……
	;LV2
ELSEIF TFLAG:24 == 12
	IF TALENT:恋慕
		CALL HPH_PRINT,@"「윽……아, %CALLNAME:MASTER%씨, 다른 하고 싶은 건…… HPH」","L"
		PRINTFORMW 자제를 상실한 요우무가 던지는 시선은 다음 쾌락에 대한 기대감으로 가득 차 있다.
	ELSE
		PRINTFORML (흡…… 이, 이런 색욕에 빠져서는……)
		PRINTFORMW 자제와 정욕이 충돌하고 있었지만, 요우무의 눈동자에는 다음 쾌락에 대한 기대가 어려 있었다…….
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 13
	IF TALENT:恋慕
		CALL HPH_PRINT,@"「아아, 아아…… HPH %CALLNAME:MASTER%씨…… 제 몸으로 만족시켜 드릴 수 있다면」","L"
		CALL HPH_PRINT,@"「더, 더…… 써 주세요…… HPH」","W"
		PRINTFORMW 관능으로 먹여 살진 욕망이 소녀의 주종이라는 정의마저 지워버리려 하고 있다.
	ELSE
		PRINTFORML 「하아, 하아…………흐윽, 부탁드려요…… 아직, 참을 수가 없어요……」
		PRINTFORMW (이제…… 스스로는, 더 이상 참을 수 없어……!)
		PRINTFORMW 정성스럽게 관능으로 부풀어 오른 열정이 무겁게 짓누르자, 마침내 소녀는 무릎을 꿇었다.
	ENDIF
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORML 「읏!? 아…… 아무것도 아니에요……」
	PRINTFORMW (나, 뭐 하고 있는 거야……?)
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 「……특별히 다른 뜻은 없는데요」
	PRINTFORMW 「%CALLNAME:MASTER%님은 저에게 이런 걸 원하신 적이 있거나……」
	IF TALENT:恋慕
		PRINTFORMW (유유코님 이외의 분들에게 이렇게까지 다 해주고 싶어져 버리다니…… 신기해……)
	ELSE
		PRINTFORMW (……나의 주인은 사이코지 유유코님. 그건 알아두지 않으면……)
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML (니키미에게 복종하지 않겠어……)
	IF TALENT:恋慕
		PRINTFORMW (섬겨야 할 주인이 두 명이나 있다니 멋진 일이어야 하는데, 어째서?)
	ELSE
		PRINTFORMW (......뭐, 뭐 유유코님의 차선이라면 간신히 괜찮을지도......)
	ENDIF
	PRINTFORMW 요우무가 %조사처리(CALLNAME:MASTER,"를")% 바라보는 눈에는 본래의 주에게 향하는 그것과 다르지 않은 신뢰가 서 있었다.
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORML 「……상대를 불쾌하게 만든 시점부터 농담은 농담이 아니게 됩니다」
	PRINTFORMW 「아니면, 저를 진심으로 화나게 하고 싶으신 건가요?」
ELSEIF TFLAG:21 == 2
	IF TALENT:恋慕
		PRINTFORML 「……아무리 %CALLNAME:MASTER%님이 하시는 일이라 해도 한계가 있어요」
		PRINTFORMW 「저에게 이런 무의미한 일을 시키지 말아 주세요」
	ELSE
		PRINTFORML 「……나는 언제부터 당신과 이렇게 무례한 사이가 된 걸까요?」
		PRINTFORMW 「아니면, 나에게 베이고 싶은 건가요?」
	ENDIF
ELSEIF TFLAG:21 == 3
	IF TALENT:恋慕
		PRINTFORML 「…… %CALLNAME:MASTER%씨에게 당하는 시련이라고 해도, 잘 견디고 있는 나 자신을 칭찬한다고 해서 벌이 내려지지는 않겠지」
	ELSE
		PRINTFORML 「남의 손에 당하는 일에도 잘 버티고 있다고, 자신을 칭찬한다고 해서 벌이 내려지진 않을 거예요」
	ENDIF
	PRINTFORMW 「하지만 그것도 이제 끝이에요……」
	PRINTFORML 「당신이 유령으로서 백옥루의 문턱을 넘는 날을 진심으로 기다리고 있어요」
	PRINTFORMW 로칸켄의 코이구치를 끊은 요우무의 눈동자에는 분명한 살의가 서려 있었다……
ENDIF
