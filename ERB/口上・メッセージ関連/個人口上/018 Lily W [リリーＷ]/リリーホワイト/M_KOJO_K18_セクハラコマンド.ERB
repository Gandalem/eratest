;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K18_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_312
CALL M_KOJO_MESSAGE_COM_K18_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF TFLAG:193 == 99
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3 ;custom code
			CASE 1
				PRINTFORML 「응~~ 푸핫!」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 가진 모든 봄을 선물해 버렸어요~♪」
			CASE 0
				PRINTFORML 「응응, 쪽……」
				PRINTFORMW 「더 해도…… 괜찮아요~」
			CASEELSE
				PRINTFORML 「음무윽……응으」
				PRINTFORMW 「……키스하고 있으니까 몸이 괜히 뜨거워졌어요……」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3 ;custom code
			CASE 1
				PRINTFORML 「음...」
				PRINTFORMW 「이거 간단하게 해도 되는 것인가요...?」
			CASE 0
				PRINTFORML 「응... 쪽...」
				PRINTFORMW 「방금 키스, 조금이라 마음이 봄이 되어버렸어요...」
			CASEELSE
				PRINTFORML 「음~……」
				PRINTFORMW 「보답이야~ 쪽♪」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3 ;custom code
			CASE 1
				PRINTFORML 「우으~ 키스라는 건 별로 먹고 싶지 않은 맛이야아……」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「방금 건 키스……이었나요~?」 
				PRINTFORMW 「레몬 맛 같은 거 안 났는데요~」
			CASEELSE
				PRINTFORML 「에…… 에…… 아, 저기이……?」
				PRINTFORMW 리리는 갑작스러운 상황에 멍하니 입을 벌리고 있다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
