;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K18_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_310
CALL M_KOJO_MESSAGE_COM_K18_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			CASE 70
				;クンニ強制
				PRINTFORML 
			CASE 35
				;スカート内見せつけ
				PRINTFORML 
			CASE 52
				;素股
				PRINTFORML 
			CASEELSE
				PRINTFORML 
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응읏... 간지러워요오...」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「캬... 그렇게 만지는 거 즐거워요~?」
				PRINTFORMW 「그렇다면... 더 해도 괜찮아요 %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「그렇게 음미하듯이 쓰다듬지 말아주세요……」
				PRINTFORMW 「봄의 기분이 되어버릴 것 같아요… %UNICODE(0x2665) *1%」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			CASE 0
				PRINTFORML 「안…… 안돼요오……」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「히얏!? 어, 에치이이!」
				PRINTFORMW 
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「옷에 붙은 벌레가 있었습니까?」
				PRINTFORML 「무슨 일인가, 잡아주려고 해 준 것이군요!」
				PRINTFORML 「……정말입니까?」
			CASE 0
				PRINTFORML 「봄이 되면 이런 사람이 나오는 건 좀 힘드네요……」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「머리만 부드러운 건 싫어요~」
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K18_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_311
CALL M_KOJO_MESSAGE_COM_K18_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			CASE 32
				;クンニ強制
				PRINTFORML 
			CASE 60
				;スカート内見せつけ
				PRINTFORML 
			CASE 73
				;素股
				PRINTFORML 
			CASE 85
				;V挿入する
				PRINTFORML 
			CASE 88
				;腰振りV
				PRINTFORML 
			CASE 86
				;だいしゅきホールド
				PRINTFORML 
			CASEELSE
				PRINTFORML 
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%에게서 봄 냄새가 나요~♪」
				PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"의")% 가슴팍에 볼을 비비고 있다.
			CASE 0
				PRINTFORML 「음으……」
				PRINTFORML 리리는 %조사처리(CALLNAME:MASTER,"의")% 품 안에서 몸을 꿈틀거리고 있다.
				PRINTFORMW 「……아, 저기…저기, 아무것도 아니에요~!」
			CASEELSE
				PRINTFORML 「더 세게 안아줘도 괜찮……다구~♪」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「포옹이야~」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 안아주자 리리도 마주 껴안아 주었다.
			CASE 0
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 작은 리리를 가볍게 안아 올렸다.
				PRINTFORMW 「멀리도 보인대요~! %조사처리(CALLNAME:MASTER,"는")% 힘이 세다니~」
			CASEELSE
				PRINTFORML 「음후후~ 봄의 향기가 난다.」
				PRINTFORMW 리리에게서는 벚꽃의 달콤한 향기가 느껴졌다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응응-!」
				PRINTFORMW 릴리는 허둥지둥 몸부림치고 있다.
			CASE 0
				PRINTFORML 「음무~ 움직이기 힘드실 거예요오~」
				PRINTFORMW 「빨리 놓아주셨으면 좋겠어요~!」
			CASEELSE
				PRINTFORML 「와아!」
				PRINTFORML 「……무슨 일이에요?」
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
