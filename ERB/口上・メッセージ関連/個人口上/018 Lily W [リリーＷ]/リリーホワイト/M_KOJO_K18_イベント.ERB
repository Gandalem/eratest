							PRINTFORMW 「이제 그런 일은 더는 원치 않는다... 부르르」
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF DAY:2 == 1  || TALENT:恋慕
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 바쁘세요~? 아쉽네요~…」
				ELSE
					SELECTCASE DAY:2
						;夏
						CASE 2
							PRINTFORML 「이대로 요정의 말린 생선이 되라는 거예요~? 살생이라고요...」
							PRINTFORMW 
							;秋
						CASE 3
							PRINTFORML 「아우욱……」
							PRINTFORMW 리리는 터덜터덜 걸음을 옮기기 시작했다.
							;冬
						CASE 4
							PRINTFORML 「요정은 죽지 않으니까 괜찮아? 그럴 리가……」
							PRINTFORMW 
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 
