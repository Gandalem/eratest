;==================================================
;621,釣りをする
;TFLAG:193(0=釣れない 1～4=魚 11～15=うまい魚 610=木材 131=守矢の守札 21=ローター 609=氷の鱗 606=龍の爪)
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================

@M_KOJO_MESSAGE_COM_K18_621
CALL M_KOJO_MESSAGE_COM_K18_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORML 
	ELSEIF DAY:2 == 1  || TALENT:恋慕
		;春
		IF TFLAG:194 > 1000
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「잡았다아앗!!」
					PRINTFORMW 리리는 이마에 땀을 흘리며 잡은 성과를 %조사처리(CALLNAME:MASTER,"에게")% 보여주었다.
				CASE 0
					PRINTFORML 「피쉬!!」
					PRINTFORMW 리리는 소년 같은 미소로 낚싯대를 화려하게 휘두르며 물고기를 낚았다.
				CASEELSE
					PRINTFORML 「아와와...! 부, 도와줬으면 좋겠어요~」
					PRINTFORML 낚싯대째 끌려갈 듯한 리리를 황급히 안는다.
					PRINTFORML 「고마워요~ %조사처리(CALLNAME:MASTER,"가")% 함께라면... 음응!」
					PRINTFORMW 리리와 두 사람의 힘을 합쳐 먹이를 낚아 올렸다.
			ENDSELECT
		ELSEIF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:6 ;custom code
				CASE 4
					PRINTFORML 릴리는 낚시하는 %조사처리(CALLNAME:MASTER,"의")% 등 뒤에 기대어 흥얼거리고 있다.
					PRINTFORMW 「후훗후훗 후프~♪ 봄이네요~♪」
				CASE 3
					PRINTFORML 「물고기 씨가 잡히면 오늘 밤은 구이로 먹을 거예요~?」
					PRINTFORMW 「회는 배가 아파지니까 안 돼요~」
				CASE 2
					PRINTFORML 「음냐... 왠지 졸려졌어요~...」
					PRINTFORMW 긴 시간에 질렸는지, 릴리는 졸린 듯 눈을 비비고 있다.
				CASE 1
					PRINTFORML 「에잇! …아, 먹었어요~!」
					PRINTFORML 「다음엔 도토리 같은 거 먹을지도 모르겠어요」
					PRINTFORMW 리리는 주변에 떨어져 있는 도토리나 벌레를 집어 연못에 던지고 있다.
				CASE 0
					PRINTFORML 「파샤파샤」
					PRINTFORML 「아, 물고기 씨가 지나갔어요~」
					PRINTFORMW 릴리는 물가에 손을 넣고 물놀이를 하고 있다.
				CASEELSE
					PRINTFORML 리리는 물고기가 도망가지 않도록 입에 양손을 대고 조용히 수면을 들여다보고 있다.
					PRINTFORML 「………」
					PRINTFORML 「……봄이네~ (작게)」
					PRINTFORMW 
			ENDSELECT
		ELSE
			PRINTFORML 「물고기 씨~! 봄이에요~」
			PRINTFORMW 리리는 연못으로 크게 외치며 봄을 알리지만, 물고기가 도망가지 않을까 약간 걱정한다.
		ENDIF
	ELSE
		SELECTCASE DAY:2
			CASE 2
				;夏
				IF TALENT:思慕 && TFLAG:194 > 1000
					PRINTFORML 「큥……」
					PRINTFORMW 릴리는 자신이 낚은 것 아래에 깔려 있다.
				ELSE
					PRINTFORML 「하아~ 시원해요오~」
					PRINTFORML 리리는 기분 좋게 물가에 발을 담그고 더위를 식히고 있다.
					PRINTFORMW 「물고기 잔뜩 잡으면 좋겠네요~」
				ENDIF
			CASE 3
				;秋
				IF TALENT:思慕 && TFLAG:194 > 1000
					PRINTFORML 「%CALLNAME:MASTER%―… 잡았어요―…」
					PRINTFORML 리리는 잡은 물고기를 눈앞에서 추처럼 흔들고 있다.
					PRINTFORMW 「물고기도 먹어야 더 잘 잡을 수 있겠네―…」
				ELSE
					PRINTFORML 「떠내려가고 있어요...」
					PRINTFORML 「저 멀리까지ー...」
					PRINTFORMW 리리는 연못에 떠다니는 나뭇잎의 행방을 멍하니 눈으로 쫓고 있는 듯하다.
				ENDIF
			CASE 4
				;冬
				IF TALENT:思慕 && TFLAG:194 > 1000
					PRINTFORML 「%CALLNAME:MASTER%—…차갑고 만질 수가 없어요오……」
					PRINTFORML 리리는 낚은 상태 그대로 %CALLNAME:MASTER%쪽으로 다가왔다.
					PRINTFORMW 「이거 구우면 먹을 수 있는 거예요?」
				ELSE
					PRINTFORML 「겨울에 낚시 같은 거 하면 얼어버릴 거예요~ 부르르」
					PRINTFORMW 릴리는 떨면서 멀리서 몸을 웅크리고 있다.
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
