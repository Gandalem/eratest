;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K18_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_302
CALL M_KOJO_MESSAGE_COM_K18_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
	ELSEIF DAY:2 == 1  || TALENT:恋慕
		;春
		IF TALENT:恋慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORMW 리리의 부드러운 향이 나는 금발을 빗으로 빗겨주었다.
					PRINTFORML 「응후♪」
					PRINTFORML 매우 만족한 듯 입가에 웃음을 흘리며 머리를 빗기고 있다.
				CASE 0
					PRINTFORML 「여기가 봄이다~♪」
					PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"에게")% 안겨, 기쁨을 얼굴에 띄우고 있다.
				CASEELSE
					PRINTFORML 「얼굴이 가까워요~……」
					PRINTFORMW 공주님 안아주자 리리는 부끄러운 듯 볼을 감싸며 수줍게 웃었다.
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「봄이에요~! 봄이에요~」
					PRINTFORMW 리리는 파타파타 %CALLNAME:MASTER%주위를 돌고 있다.
				CASE 0
					PRINTFORML 「봄이랍니다... 헤헤」
					PRINTFORML 리리의 머리를 쓰다듬자 고양이처럼 손에 머리를 비빈다.
					PRINTFORMW 「더 쓰다듬어 주길 원해요!」
				CASEELSE
					PRINTFORML 「봄이야아~!」
					PRINTFORML 「야호오!」
					PRINTFORMW 리리와 하이파이브를 하며 봄의 도래를 기뻐했다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「자, 힘내...」
					PRINTFORML 릴리는 %조사처리(CALLNAME:MASTER,"의")% 등에 올라 등반을 시작한 모양이다.
					PRINTFORMW 「하나, 둘... 봄이에요오!!」
					PRINTFORML %CALLNAME:MASTER%산 정상에 도착한 릴리의 메아리는 %조사처리(CALLNAME:MASTER,"의")% 귓가에 아플 정도로 울렸다.
				CASE 0
					PRINTFORML 「아와와와와…!」
					PRINTFORMW 리리의 머리를 쓱싹거리며 쓰다듬었다.
					PRINTFORML 「무우우웅!」
					PRINTFORML 푸욱 하고 풍선처럼 볼을 부풀리며 화를 내버렸다.
				CASEELSE
					PRINTFORML 「봄이에요오~……꺅」
					PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 리리의 어깨를 주물러주었다. 리리의 어깨는 말랑말랑하고 부드럽다.
					PRINTFORML 『……？」
					PRINTFORMW 리리는 이상하다는 듯 눈을 깜빡이며 %조사처리(CALLNAME:MASTER,"를")% 올려다보고 있다.
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE DAY:2
			CASE 2
				IF TALENT:思慕
					PRINTFORML 「봄이 보고 싶어애… 히읏!?」
					PRINTFORML 봄 기분을 느끼게 해주려고 리리를 간지럽혀 보았다.
					PRINTFORML 「아하하하!! 하하하하! ……그만해줘!」
					PRINTFORMW 리리에게 눈물 가득한 채 뺨을 맞고 말았다
				ELSE
					PRINTFORML 「더워요오옷……」
					PRINTFORMW 뻗었던 손은 리리에 귀찮다는 듯이 쳐졌다.
				ENDIF
			CASE 3
				IF TALENT:思慕
					PRINTFORML 「봄이 멀었어… 음니…」
					PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"가")% 뺨을 만져도, 그저 시키는 대로 멍하니 %조사처리(CALLNAME:MASTER,"를")% 올려다보고 있다. 
				ELSE
					PRINTFORML 「쓰다듬어져도…… 봄은 너무나 멀어써……」
					PRINTFORMW 「잡혀져도…… 봄은 정말정말 멀어써……」
				ENDIF
			CASE 4
				IF TALENT:思慕
					PRINTFORML 「아, 봄은 아직 없나요……?」
					PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 품에 몸을 말고 웅크린 채, 릴리는 추위를 피하고 있다.
					PRINTFORMW 「입춘인데… 봄은 오지 않았어요~ 부들부들」
				ELSE
					PRINTFORML 「덜덜덜덜덜……」
					PRINTFORML 추위에 떨고 있는 리리를 안아 올리자, 얼음처럼 차가운 감촉에 손을 휙 떼버렸다.
					PRINTFORML 「제발, 추우니까 떨어지지 마아……」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 살을 에는 듯한 차가움 그 자체인 리리의 온기가 되어 버렸다.
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
