;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K18_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K18_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 
	ELSEIF DAY:2 == 1  || TALENT:恋慕
		;春
		IF TALENT:恋慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 이야기하고 있으면 영원히 봄이네~」
					PRINTFORMW 
				CASE 0
					PRINTFORML 「지난번에 봄이 정말 봄 같았단 거야」
					PRINTFORMW 리리와 봄으로 가득 찬 이야기로 크게 즐거웠다.
				CASEELSE
					PRINTFORML 「역시 봄이네요~♪」
					PRINTFORMW  리리는 파타파타 두 손을 흔들며 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「♪～」
					PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"의")% 어깨에 매달리면서 이야기를 듣고 있다.
				CASE 0
					PRINTFORML 「봄인가~」
					PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"의")% 작은 이야기를 열성적으로 듣고 있다.
				CASEELSE
					PRINTFORML 「봄이 가까워졌네요~」
					PRINTFORMW 리리와 멍하니 두서없는 이야기를 이어갔다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「봄이 왔어요~?」
					PRINTFORMW 릴리는 고개를 갸웃하며 %조사처리(CALLNAME:MASTER,"의")% 대화를 듣고 있다.
				CASE 0
					PRINTFORML 「그렇네요!!」
					PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"의")% 대화에 빙긋 웃으며 맞장구를 치고 있다.
				CASEELSE
					PRINTFORML 「하루루웅」
					PRINTFORMW 리리는 %CALLNAME:MASTER%주위를 휘청이며 떠다니고 있다.
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE DAY:2
			CASE 2
				IF TALENT:思慕
					PRINTFORML 「봄이 지나버렸어요~」
					PRINTFORMW 「더워……」
				ELSE
					PRINTFORML 리리는 %조사처리(CALLNAME:MASTER,"의")% 이야기를 비틀거리며 듣고 있다.
					PRINTFORMW 「…………」
				ENDIF
			CASE 3
				IF TALENT:思慕
					PRINTFORML 「봄은 아직 안 온 건가요~?」
					PRINTFORML 「아직인가아……」
					PRINTFORMW 리리는 날개를 축 처지게 한 채 어깨를 축 늘어뜨렸다.
				ELSE
					PRINTFORML 「가을은 봄으로부터 가장 먼 계절이다…」
					PRINTFORMW 「봄이 그립다요…」
				ENDIF
			CASE 4
				IF TALENT:思慕
					SELECTCASE RAND:3 ;custom code
						CASE 1
							PRINTFORML 「계속되는 겨울은 없다. 반드시 봄이 온다。」
							PRINTFORMW 「그러니 가만히 참는다. 부들부들...」
						CASE 0
							PRINTFORML 「겨울이 있으니까 봄이 정말 기분 좋은 계절이 되는 거예요……」
							PRINTFORMW 「추워서 힘든 계절이 있기 때문에 따뜻한 계절이 왔다는 게 기쁜 거잖아요~」
						CASEELSE
							PRINTFORML 「벌써 몇 개나 자면 후후들거린다… 봄이다」
							PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 매달리며 리리는 부르르 떨고 있다.
					ENDSELECT
				ELSE
					PRINTFORML 「겨울이잖아요~ 쿠슌옷!」
					PRINTFORMW 「입춘이긴 한데~ 추워요~」
				ENDIF
			CASEELSE
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K18_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_301
CALL M_KOJO_MESSAGE_COM_K18_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORML 
	ELSEIF DAY:2 == 1  || TALENT:恋慕
		;春
		IF TALENT:恋慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「벚꽃떡 맛있다구~」
					PRINTFORMW 리리는 다과로 나온 벚꽃떡을 행복한 듯 먹으며, 볼이 처지지 않도록 손으로 받치고 있다.
				CASE 0
					PRINTFORML 리리는 %조사처리(CALLNAME:MASTER,"에게")% 기대어 차를 마시고 있다.
					PRINTFORMW 「후와아…… 마음도 몸도 봄이 왔어요~!」
				CASEELSE
					PRINTFORML 공예차를 대접하자, 릴리는 눈을 동그랗게 뜨고 주전자를 들여다보고 있다.
					PRINTFORMW 「후와아…… 차 속에 봄이 있어요오~!」
					PRINTFORML 릴리는 눈을 반짝이며 꽃이 피는 모습을 까르르 웃으며 바라보고 있었다.
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「봄에는 녹차가 맛있다!」
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 리리에게 홍차를 건넸다.
					PRINTFORMW 「봄에도 홍차는 맛있다!」
				CASE 0
					PRINTFORML 「새 차가 맛있어요~!」
					PRINTFORML 「음~ 봄의 향기네~」
					PRINTFORMW 리리와 차의 향을 만끽하며 잠시 쉬었다.
				CASEELSE
					PRINTFORML 호호케쿄옷
					PRINTFORML 「꾀꼬리도 울고 있어요~」
					PRINTFORMW 「앗, 벚꽃잎이 차 위에…… 봄이네요~」
					PRINTFORMW 느긋하게 리리와 봄을 만끽했다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「봄이에요, 뜨거워!」
					PRINTFORMW 「흐으윽... 혀만 여름이네에...」
				CASE 0
					PRINTFORML 「따뜻해아~」
					PRINTFORMW 리리와 차를 마시며 안도의 한숨을 내쉬었다.
				CASEELSE
					PRINTFORML 「날씨도 배도 봄이잖아요~!」
					PRINTFORML 「즈즈… 하아후우…」
					PRINTFORMW 리리는 눈이 녹는 듯한 나른한 얼굴로 차를 만끽하고 있다.
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE DAY:2
			CASE 2
				IF TALENT:思慕
					PRINTFORMW 리리에게 차가운 보리차를 건넸다.
					PRINTFORML 「차갑잖아아…」
					PRINTFORMW 「살아나네에…」
					PRINTFORML 새빨갛게 달아올랐던 리리의 볼은 봄빛으로 돌아온 듯했다.
				ELSE
					PRINTFORML 릴리에게 뜨거운 차를 내밀었다.
					PRINTFORML 「……장난인가요?」
					PRINTFORMW 여름인데도 차가운 시선을 받아버렸다.
				ENDIF
			CASE 3
				IF TALENT:思慕
					PRINTFORML 「차 따뜻해서 봄처럼 포근해요~」
					PRINTFORMW 「하지만 다 마시면…… 또 가을이 되어버릴 거예요…… 후우」
				ELSE
					PRINTFORML 「따뜻한 게 스며들어요...」
					PRINTFORML 리리는 애틋하게 차를 마시고 있다.
					PRINTFORML 아련하게 먼 곳을 바라보는 모습은 고향에 대한 그리움으로 가득 찬 듯하다.
					PRINTFORMW 「후우...」
				ENDIF
			CASE 4
				IF TALENT:思慕
					PRINTFORML 「여기만 봄이랍니다~」
					PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"의")% 품에 파고들며 차를 홀짝이고 있다.
					PRINTFORML 「포근하잖아요~」
				ELSE
					PRINTFORML 「후우……」
					PRINTFORML 「배에서 봄이 오고 있어요……」
					PRINTFORMW 리리는 따뜻한 차를 마시며 안도의 한숨을 내쉬었다.
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
