;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K18_303
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K18_303
CALL M_KOJO_MESSAGE_COM_K18_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0,1,2
			IF DAY:2 == 1  || TALENT:恋慕
				;春
				IF TALENT:恋慕
					PRINTFORML 「이제 이런 거 하지 말아줬으면 좋겠어……」
					PRINTFORMW 리리는 반쯤 울먹이며 %조사처리(CALLNAME:MASTER,"에게")% 달려와 안겼다.
				ELSEIF TALENT:思慕
					PRINTFORML 「봄이 돌아왔어요……」
					PRINTFORMW 
				ELSE
					PRINTFORML 「음... 용서해 주겠다.」
					PRINTFORMW 환하게 웃는 리리는 %조사처리(CALLNAME:MASTER,"의")% 머리를 톡톡 두드렸다.
				ENDIF
			ELSE
				;それ以外の季節
				IF TALENT:思慕
					PRINTFORML 「...이제 괴롭히지 않을게?」
					PRINTFORMW 그림자 속에서 입술을 삐죽 내밀고 이쪽을 응시하는 리리에 손을 모아 고개를 숙였다.
					PRINTFORMW 「후우…… 이번 한 번뿐이니까~ 에잇!」
					PRINTFORMW 깊은 한숨을 쉬는 와중에, 속죄의 의미로 데코핀(콕 찍기) 한 방을 받았다.
				ELSE
					PRINTFORML 「……용서해 줄게~」
					PRINTFORMW 리리는 마음을 가라앉힌 듯 마지못해 %조사처리(CALLNAME:MASTER,"의")% 사죄를 받아들였다.
				ENDIF
			ENDIF
		CASEELSE
			IF DAY:2 == 1  || TALENT:恋慕
				;春
				IF TALENT:恋慕
					PRINTFORML 「봄은 첫눈에 날아가 버렸다. 푸읏」
					PRINTFORMW 리리는 부푼 표정으로 %조사처리(CALLNAME:MASTER,"에게")% 등을 돌리고 있다.
				ELSEIF TALENT:思慕
					PRINTFORML 「음… 안 돼!」
					PRINTFORMW 리리는 손가락으로 막대를 만들어 %조사처리(CALLNAME:MASTER,"에게")% 거절의 제스처를 취했다.
				ELSE
					PRINTFORML 「싫어!」
