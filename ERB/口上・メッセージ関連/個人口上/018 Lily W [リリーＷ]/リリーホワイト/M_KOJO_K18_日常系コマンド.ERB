;660,読書 custom code edited
;TFLAG:193(選択肢文学(1=忍殺(文学？) 2=失敗 3=文学),選択肢実用書(4=失敗 5=実用書),選択肢エッチな本(6=薄い高い本 7=保健体育 8=カーマスートラ))
;==================================================

@M_KOJO_MESSAGE_COM_K18_436
CALL M_KOJO_MESSAGE_COM_K18_436_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K18_436_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORML 
	ELSEIF DAY:2 == 1  || TALENT:恋慕
		;春
		IF TALENT:恋慕
			SELECTCASE TFLAG:193
				CASE 1
					;忍殺
					PRINTFORML 「도모, %CALLNAME:MASTER%상, 릴리 화이트입니다」
					PRINTFORMW 릴리카와이이야앗!
				CASE 2
					;文学失敗
					PRINTFORML 「잘 모르겠어서 머릿속이 너무 복잡하다...」
					PRINTFORMW 리리는 책을 보고 있는 사이 눈앞이 빙빙 돌았다.
				CASE 3
					;文学成功
					PRINTFORML 「왠지 봄에 대해 좀 알게 된 기분이랄까아~」
					PRINTFORMW 「봄잠, 새벽을 깨닫지 않고! 봄날 저녁 식사 후 삼리!」
				CASE 4
					;実用書失敗
					PRINTFORML 「………」
					PRINTFORML 리리는 %조사처리(CALLNAME:MASTER,"의")% 무릎 위에서 조용히 있다.
					PRINTFORMW ……지식량에 감당하지 못하고 기절해 있는 것 같다….
				CASE 5
					;実用書成功
					PRINTFORML 「따뜻해, 봄! spring! весна! 봄이잖아~」
					PRINTFORMW 리리는 조금 똑똑해진 것 같다.
				CASE 6
					;薄い高い本
					PRINTFORML 「...이런 거 하고 싶은 거예요...?」
					PRINTFORMW 리리는 얼굴을 붉히며, 조심스럽게 %조사처리(CALLNAME:MASTER,"의")% 가랑이에 손끝을 움직였다.
				CASE 7
					;保健体育
					PRINTFORML 「꽃은 수술이랑 암술이……」
					PRINTFORMW 
				CASE 8
					;カーマスートラ
					PRINTFORML 「후우읏%UNICODE(0x2665) *1%후우읏%UNICODE(0x2665) *1%」
					PRINTFORML 「？？？」
					PRINTFORMW 리리는 자신이 왜 흥분했는지 도무지 알 수 없어 당황하며 허벅지를 비비고 있다.
				CASEELSE
					PRINTFORML 「크으… 크으…」
					PRINTFORMW 리리는 독서하는 %조사처리(CALLNAME:MASTER,"의")% 가슴을 베개 삼아 잠꼬리를 하고 있다.
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3 ;custom code
				CASE 1
					PRINTFORML 「그렇구나… 봄이란… 환상향이란… 진리란!」
					PRINTFORMW 어려운 책을 읽고 있던 리리는 깨달은 표정을 지었으나 1분 만에 예전 모습으로 돌아왔다.
				CASE 0
					PRINTFORML 「음…… %조사처리(CALLNAME:MASTER,"가")% 읽는 책이 너무 어려워서 잘 모르겠어요~」
					PRINTFORMW 
				CASEELSE
					PRINTFORML 「%CALLNAME:MASTER%－하루모토라는 거 발견했어요~」
					PRINTFORML 「분명 봄이 잔뜩 그려져 있을 거예요...!?」
					PRINTFORML 「……흐으윽」
					PRINTFORMW 리리는 얼굴을 붉히며 하루모토를 선반에 돌려놓았다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				;CASE 1
				;PRINTFORML
				;PRINTFORMW
				CASE 0
					PRINTFORML 「여기에도 봄을 불러올게요~. 자, 하나 둘... 꽉 껴안아!」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 봄을 알리려는 리리를 황급히 제지했다.
				CASEELSE
					PRINTFORML 「밖에서 봄을 찾아 나서자!」
					PRINTFORMW 「책들을 버려라! 마을로 나가라!」
			ENDSELECT
		ENDIF
	ELSE
		IF TALENT:思慕
			PRINTFORML 「우웅... 봄이 기다려진다.」
			PRINTFORMW 리리는 봄을 주제로 한 화집을 쓸쓸하게 들여다보고 있다.
		ELSE
			PRINTFORML 「여기서 봄의 향기가 나요~」
			PRINTFORMW 릴리는 봄 꽃으로 만든 책을 펼쳐 들여다보고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
