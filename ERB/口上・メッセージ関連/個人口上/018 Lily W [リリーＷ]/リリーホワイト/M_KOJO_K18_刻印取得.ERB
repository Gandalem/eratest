; Modular ERB: 個人口上/018 Lily W [リリーＷ]/リリーホワイト/M_KOJO_K18_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K18
RETURN 1

@M_KOJO_MESSAGE_MARKCNG_K18
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「히으…… 아냐…… 아파……」
	ENDIF
ELSEIF TFLAG:22 == 2
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「이제 건드리지 말아 주면…… 용서해줬으면 좋겠어요~」
	ENDIF
ELSEIF TFLAG:22 == 3
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「흐읍... 으윽... 흐윽...」
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「이렇게 봄이 가득해질 줄은 몰랐어…… %UNICODE(0x2665) *1%」
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 「하, 하루우~ %UNICODE(0x2665) *1%」
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「이렇게 기분 좋은 일이 있었군요~ %UNICODE(0x2665) *1%」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 「머리가 봄이 되어버릴 것 같아읏%UNICODE(0x2665) *1%」
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 같이 있어야 해요……」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「봄이라든 봄이 아니더라도, 제가 열심히 할게요~」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「%CALLNAME:MASTER%만 있으면 되는 걸까…… 이제는」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 「그런 거 하지 마아앗!」
ELSEIF TFLAG:21 == 2
	PRINTFORMW 「%CALLNAME:MASTER%도 저를 잡고 괴롭히는 거예요……」
ELSEIF TFLAG:21 == 3
	PRINTFORMW 「……용서 못 해애……」
ENDIF
