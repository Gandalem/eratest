		ELSEIF TALENT:恋慕
			PRINTFORM %조사처리(CALLNAME:MASTER,"를")% 보고 인사를 건넨다
		ELSEIF GETBIT(CFLAG:1,0)
			PRINTFORM %CALLNAME:MASTER%쪽을 향해 희미하게 웃었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;轻轻地会釈して街道過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORML 
