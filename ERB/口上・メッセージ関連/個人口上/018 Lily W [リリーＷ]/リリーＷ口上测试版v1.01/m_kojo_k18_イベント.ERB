@M_KOJO_tokicoli_EVENT_K18_11(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:思慕
			PRINTDATA
				DATALIST
					DATAFORM 「흥음음♪~흥음음♪~응흥흥~~~」
					DATAFORM 「흥음음♪~흥음음♪~흥음흥응응~~~」;하늘의 꽃 도시
					DATAFORM  릴리 화이트는 %조사처리(CALLNAME:MASTER,"에게")% 등을 보인 채 목욕을 하며 노래를 흥얼거렸고, 자신의 음악에 깊이 빠져 있어 %조사처리(CALLNAME:MASTER,"를")% 눈치채지 못했다.
					DATAFORM  갑자기 릴리 화이트가 몸을 돌려 %조사처리(CALLNAME:MASTER,"를")% 보고는 멈칫했다.
				ENDLIST
				DATALIST
					DATAFORM 릴리 화이트는 목욕을 하다가 %조사처리(CALLNAME:MASTER,"를")% 보고 멈칫했다
				ENDLIST
			ENDDATA
			PRINTFORML 「꺄아! %CALLNAME:MASTER%당신, 당신, 어떻게 여기에요」
			PRINTFORMDL 릴리 화이트는 당황하여 %조사처리(CALLNAME:MASTER,"를")% 바라보며, 허둥지둥 자신을 가렸다.
			PRINTFORML 「빨리 나가요, 빨리 나가달라구요!」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 나가지 않는 것을 본 릴리 화이트는 다시 %조사처리(CALLNAME:MASTER,"에게")% 물을 뿌렸다.
			PRINTFORMW 「%CALLNAME:MASTER%빨리 나가요! 릴리 화이트가 목욕 중이잖아요……」
			PRINTFORMDW  %조사처리(CALLNAME:MASTER,"는")% 물보라가 흩날리는 가운데 나갔다.
		ELSE
			PRINTFORML 「………엣!?」
			PRINTFORMDL 릴리 화이트는 %조사처리(CALLNAME:MASTER,"를")% 보고 순간 당황했다.
			PRINTFORML 「릴리 화이트가 샤워 중이야, 빨리 나가.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目が合った（追い出されない）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORML 
			PRINTFORML 「……응? 네, %CALLNAME:MASTER%잖아!」
			PRINTFORML 「들어와서 같이 목욕할래?」
			PRINTFORMDL 릴리 화이트는 %조사처리(CALLNAME:MASTER,"가")% 들어오는 것을 보고 말했다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 욕탕에 들어서자마자, 릴리 화이트가 안아왔다.
			PRINTFORMW 「릴리 화이트가 네 등 씻겨줄게. 깨끗하고 상쾌하게 말이야」
			PRINTFORMDW 그렇게 말하며 릴리 화이트는 %조사처리(CALLNAME:MASTER,"의")% 등 부위를 문지르기 시작했는데, 사용하는 것이 스펀지보다 훨씬 부드러워 보였다.
		ELSEIF TALENT:恋慕
			PRINTFORML  「에? %CALLNAME:MASTER%도 같이 목욕하고 싶어?」
			PRINTFORML  「그, 그럼, 같이 씻자……」
			PRINTFORMDL 릴리 화이트가 말하며 일어나 자리를 비켜주었다.
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 욕조에 몸을 담그자, 릴리 화이트는 %조사처리(CALLNAME:MASTER,"를")% 바라보며 얼굴이 서서히 붉어졌다.
			PRINTFORMDW 그리고는 릴리 화이트가 수줍은 듯 천천히 %CALLNAME:MASTER%에게서 멀어졌다.
		ELSEIF TALENT:思慕
			PRINTFORML 
			PRINTFORML 「……아……%CALLNAME:MASTER%님……」
			PRINTFORMDL 릴리 화이트가 당신을 보고 얼굴이 약간 붉어졌다.
			PRINTFORML 「아! 같이 들어와서 목욕하고 싶어!?」
			PRINTFORMDL 설마, 안 되는 거야?
			PRINTFORML 「아, 그게…… 안 돼, 는 아니잖아……」
			PRINTFORMDL  %조사처리(CALLNAME:MASTER,"가")% 욕조로 들어간 후, 릴리 화이트의 얼굴은 더욱 붉어졌다.
		ELSE
			PRINTFORML 
			PRINTFORML 「……아!? %CALLNAME:MASTER%……」
			PRINTFORMDL 릴리 화이트는 %조사처리(CALLNAME:MASTER,"를")% 보고 조금 놀란다.
			PRINTFORML 「……같이 목욕하는 거 같은 건…… 괜찮아……」
			PRINTFORMDL 릴리 화이트는 매우 조심스럽고 불안해 보인다.
		ENDIF
		RETURN 1
	ENDIF
	;其他
	PRINTFORMDL  
ENDIF
RETURN 1
