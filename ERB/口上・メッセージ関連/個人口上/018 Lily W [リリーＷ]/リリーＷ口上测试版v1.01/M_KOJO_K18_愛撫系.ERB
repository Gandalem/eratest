IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORMDL 
			PRINTFORMW 
		ELSEIF TALENT:恋慕
			PRINTFORMW 「릴리 화이트의 여기를…… 스스로 벌려서 보여줄까? 부끄럽긴 하지만…… %CALLNAME:MASTER%라서 가능한 거야?」
			PRINTFORMDW 릴리 화이트는 수줍어서 얼굴이 새빨개진 채, %CALLNAME:MASTER%앞에서 천천히 다리를 벌리며 소녀의 가장 소중한 부분을 완전히 노출했다.
			PRINTFORMDW 연약하고 하얀 은밀한 곳은 매우 매끄러웠고, 릴리 화이트의 가녀린 손가락이 살짝 음순 위에 놓였다. 부드럽게 심호흡을 한 뒤, 천천히 자신의 두 입술을 벌렸다.
			PRINTFORMDW 분홍빛으로 발갛게 물든淫肉(음육)에서는 남성을 유혹하듯 달콤한 애액이 줄줄 흘러나오고 있었다.
			PRINTFORMDW 얼굴을 강타하는 향기와 여성의 정취, 그리고 미세하게 꿈틀거리는 질 입구가 %조사처리(CALLNAME:MASTER,"의")% 욕구를 격발시켰다.
			PRINTFORMDW 어린 요정이 보여주는 광경은 지극히 퇴폐적이고 불륜스러웠으며, %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 침을 삼켰다.
			PRINTFORMDW 끈적한 애액이 음육에 요염한 색채를 물들였고, 빛을 받아 더욱 선정적으로 보였다.
			PRINTFORMW 「%CALLNAME:MASTER%라서, 릴리 화이트의 이곳은 %조사처리(CALLNAME:MASTER,"가")% 아무렇게나 사용해도 괜찮아%UNICODE(0x2764)%」
			PRINTFORMW 「……왜냐면, 릴리 화이트의 마음은 이미 %조사처리(CALLNAME:MASTER,"를")% 사랑하고 있으니까%UNICODE(0x2764)%…」
		ELSE
			;加判断
			PRINTFORMW 「에헤헤!? 흐윽, 이렇게 하니까 너무 부끄럽잖아…… 그래도, 잠깐만 볼 수 있어? 약속했지?」
			PRINTFORMDW 릴리 화이트는 매우 부끄러워했지만, 마지못해 천천히 다리를 벌리고 자신의 음순을 천천히 벌렸다.
			PRINTFORMDW 릴리 화이트의 하얀 은밀한 곳이 살짝 벌어지고, 예쁜 분홍색 질 입구가 노출되었으며 수줍음에 미세하게 꿈틀거린다.
			PRINTFORMW 「시간 다 됐어…… 여기서 끝이야! 이제 그만이야!」
			PRINTFORMDW 좀 더 자세히 감상하고 싶을 때 릴리 화이트는 얼굴을 홍조로 물들이며 다리를 꼭 오므렸다, 정말 아쉽다.
			PRINTFORMW 「아직 만족 못 했어… 뭐야! 릴리 화이트가 이렇게 부끄러워하는데…… %조사처리(CALLNAME:MASTER,"가")% 너무 욕심부리면 릴리 화이트 진짜 화낼 거야!」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 난감하게 한숨을 내쉬며, 나중에 감상을 부탁해야 할 것 같다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMDW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF NOWEX:Ｃ絶頂
			IF EX:膣内精液 >= 500
				PRINTFORMW 「응응%UNICODE(0x2764)%…릴리 화이트의 그곳을… 잘 지켜봐야 한다%UNICODE(0x2764)%」
				PRINTFORMDW 릴리 화이트는 침대 위에서 자신의 음순을 살짝 벌려 보였다. 걸쭉한 정액이 질 속으로 주르륵 흘러나와 매우 야했다.
				PRINTFORMDW 하지만 %조사처리(CALLNAME:MASTER,"는")% 이미 발기하여 단단해진 릴리 화이트의 작은 클리토리스에 시선을 고정하고, 흐르는 정액을 바라보며 황홀경에 빠진 그녀의 클리토리스를 손가락으로 가볍게 만지작했다.
				PRINTFORMW 「하아!?%UNICODE(0x2764)% 안 돼… 릴리 화이트 지금…%UNICODE(0x2764)% 안 돼욧%UNICODE(0x2764)% 서 있을 수가 없어%UNICODE(0x2764)%」
				PRINTFORMDW 쪼그린 자세를 지탱하던 두 다리가 격렬하게 떨리기 시작했고, 갑작스러운 쾌감에 몸을 움츠린 릴리 화이트에게 %조사처리(CALLNAME:MASTER,"는")% 더욱 강한 공세를 퍼부었고, 그녀는 연신 신음을 흘리며 절정에 이르렀다.
				PRINTFORMW 「기분 좋아욧%UNICODE(0x2764)% 안 돼욧%UNICODE(0x2764)%릴리 화이트%UNICODE(0x2764)% 야한 소리를 내고 있어욧%UNICODE(0x2764)% 안 돼요%UNICODE(0x2764)% 울부짖는 정액이 될 것 같아욧%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMDW 결국 릴리 화이트의 작은 몸은 침대에 쓰러졌고, 따뜻하고 달콤한 액체가 공중으로 분사되어 다시 떨어지며 마치 천녀가 꽃을 뿌리는 듯 두 사람과 시트 위로 흩뿌려졌다.
				PRINTFORMDW 격렬하게 절정한 후 소녀는 온몸이 힘없이 침대에 누워 쾌감의 여운에 잠겼고, 방 전체에는 취할 듯한 향기가 가득했다.
			ELSE
				PRINTFORMW 「아응……%CALLNAME:MASTER%, 지금 가지고 놀면%UNICODE(0x2764)% 안 돼%UNICODE(0x2764)% 이러다가는%UNICODE(0x2764)%」
				PRINTFORMDW 릴리 화이트는 M자 개각 자세로 음순을 드러내고 있었고, 정욕을 참지 못한 %조사처리(CALLNAME:MASTER,"가")% 얼굴을 가까이 대고 손가락으로 음핵을 부드럽게 애무하자, 호흡과 손가락의 이중 자극에 소녀의 교성은 점점 높아졌다.
				PRINTFORMDW 쾌락에 빠져든 릴리 화이트는 무의식적으로 자신의 손가락을 음핵 위에 대고 문지르기 시작했고, 릴리 화이트가 절정에 다다르려는 것을 알아챈 %조사처리(CALLNAME:MASTER,"가")% 갑자기 손가락으로 음핵을 꽉 쥐자, 소녀는 높은 비명을 지르며 그대로 절정에 도달했다.
				PRINTFORMW 「기분 좋아%UNICODE(0x2764)%…%CALLNAME:MASTER%, 릴리 화이트%UNICODE(0x2764)% 갈 것 같아%UNICODE(0x2764)% 가버려%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMDW 투명하고 달콤한 액체가 릴리 화이트의 하체에서 끊임없이 뿜어져 나와 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 완전히 적셨고, 소녀는 온몸에 힘이 풀린 채 침대에 누워 쾌감의 여운에 잠겼으며, 방 안에는 사람을 매료시키는 향기가 가득 찼다…
			ENDIF
		ELSE
			SELECTCASE RAND:5 ;custom code
				CASE 0
					IF EX:膣内精液 >= 500
						PRINTFORMW 「헤헤헤…… %조사처리(CALLNAME:MASTER,"가")% 릴리 화이트 몸 안에 사정하고 남은 게 이렇게 넘쳐 나왔네%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 침대에 앉아 두 다리를 벌리고, 양손으로 손가락을 이용해 입술을 벌리자 이전에 안에 사정했던 걸 끈적한 정액이 소녀의 신음 소리와 함께 꾸르륵 흘러나왔다.
						PRINTFORMDW 구멍은 파르르 떨리며 끊임없이 정액을 토해냈고, 애액과 섞여 음탕한 기운을 풍겼으며, 이 음란한 광경은 그녀의 작은 몸을 더욱 유혹적으로 만들었다.
						PRINTFORMW 「아응%UNICODE(0x2764)% 이렇게 많이 흘리니까 좀 아깝잖아…… %CALLNAME:MASTER%%UNICODE(0x2764)% 계속 릴리 화이트 몸 안에 가득 사정해 주는 것도 괜찮을 거야?%UNICODE(0x2764)%」
					ELSE
						PRINTFORMW 「헤헤헤, 릴리 화이트가 원하잖아~ 여기, 커다란 고기가 너무 갖고 싶어~ %UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 침대 위에 앉아 다리를 벌리고, 두 손으로 입술을 벌려 분홍빛의 구멍을 %조사처리(CALLNAME:MASTER,"에게")% 숨김없이 보여준다.
						PRINTFORMDW 구멍 안은 파르르 떨며 꿈틀거렸고, 마치 고기의 삽입을 갈망하는 듯, 그 안에서 흘러나온 투명하고 음란한 광택이 도는 애액 덕분에 그녀의 온 몸이 매우 요염해 보였다.
						PRINTFORMW 「가만히 보고만 있지 말고, %CALLNAME:MASTER%어서 와줘, 릴리 화이트 여기 준비 다 됐어~ %UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 그렇게 말하며 음탕하게 웃었고, 마치 초대하듯 달콤한 진액이 넘치는 질 입구를 더욱 벌렸다.
					ENDIF
				CASE 1
					IF EX:膣内精液 >= 500
						PRINTFORMW 「지금 열면, 음음%UNICODE(0x2764)%아, 다 흘러버리잖아… 아깝네…」
						PRINTFORMDW 릴리 화이트가 음탕하게 웃으며 두 손가락으로 자신의 음순을 살짝 벌리고는, 가냘픈 신음을 내며 걸쭉한 흰 액체가 작은 질 입구에서 분출된다.
						PRINTFORMDW 꾸르륵거리는 음란한 소리와 함께, 안에 주입되었던 정액이 열기와 함께 서서히 흘러나오는데, 매우 음탕하다.
						PRINTFORMDW 릴리 화이트는 몸을 살짝 떨며 흐르는 정액을 희미하게 바라보고는, 갈망하는 시선으로 이쪽을 향한다.
						PRINTFORMW 「지금 열면, 음음%UNICODE(0x2764)%아, 다 흘러버리잖아… 아깝네…」
						PRINTFORMW 「%CALLNAME:MASTER%%UNICODE(0x2764)%가 흘려버린 부분은 %조사처리(CALLNAME:MASTER,"가")%…… 다시 주입해 주는 거야, 응%UNICODE(0x2764)%?」
					ELSE
						PRINTFORMW 「에헤헤, 지금부터 전시를 시작할 거야, %CALLNAME:MASTER%~ 잘 지켜봐 주렴%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 음란하게 웃으며 말했고, 두 손가락이 삽입되자 소녀는 신음했으며 달콤한 애액이 어린 질 속에서 서서히 흘러나왔다.
						PRINTFORMW 「응응%UNICODE(0x2764)%… 이야%UNICODE(0x2764)%……하응%UNICODE(0x2764)% 릴리 화이트의 그곳이 완전히 노출되었어%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 애액으로 젖은 밀항을 벌렸으며, 로리 요정이기 때문인지 분홍빛 살결, 심지어 소녀에게 가장 중요한 자궁구까지 선명하게 보였다.
						PRINTFORMDW 작고 섬세한 자궁구는 마치 갈망하듯 천천히 열리고 닫혔으며, 관음당하는 흥분감으로 애액이 서서히 흘러나왔다. %조사처리(CALLNAME:MASTER,"가")% 이 아름다운 봄을 마음껏 감상했다.
					ENDIF
				CASE 2
					IF EX:膣内精液 >= 500
						PRINTFORMW 「응야%UNICODE(0x2764)% 생각지도 못하게, 이렇게 많은%UNICODE(0x2764)%……릴리 화이트가 마음껏 사랑받았네%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 도취된 듯 자신의 음순을 벌려 이전에 주입되었던 정액이 끊임없이 흘러넘치는 밀한 구멍을 보여주었다.
						PRINTFORMDW 질의 진액과 정액이 섞인 액체가 릴리 화이트의 비명 소리와 함께 소녀의 음순 사이로 분출되었다.
						PRINTFORMDW 한꺼번에 벌어지자, 혼합액은 제방이 무너지듯 걸쭉하게 넘쳐 나와 소녀의 은밀한 곳을 더럽혔고, 교합의 증거로서 음란한 기운을 계속해서 풍겼다.
					ELSE
						PRINTFORML 「빨리… %조사처리(CALLNAME:MASTER,"의")% 육봉을, 릴리 화이트의 이곳에서 마음껏 휘저어줘%UNICODE(0x2764)% 괴롭혀줘%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 달콤한 애액이 맺힌 자신의 꿀단지를 벌리고 %조사처리(CALLNAME:MASTER,"의")% 육봉이 삽입되기를 기다린다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 침을 삼키며 얼굴을 가까이 가져가 릴리 화이트의 비처를 자세히 살폈고, 호흡도 저절로 가빠졌다.
						PRINTFORMDW 벌어진 음순에서는 매혹적인 살결 위로 끈적한 애액의 은실이 보이며, %조사처리(CALLNAME:MASTER,"의")% 정욕 어린 숨결이 비처에 닿을 때마다 소녀의 몸은 미세하게 떨린다.
						PRINTFORMDW 끊임없이 자극받는 릴리 화이트의 표정에는 완전히 정욕이 드리워져, 마치 봄에 발정 난 암컷 짐승처럼 씨를 뿌려달라고 애원한다.
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 숨결, 닿았어%UNICODE(0x2764)% 너무 간지럽고 갖고 싶어%UNICODE(0x2764)% 있잖아, 여기서 %조사처리(CALLNAME:MASTER,"의")% 하얀 것을%UNICODE(0x2764)% 마음껏 주입해줘%UNICODE(0x2764)% 부탁이야%UNICODE(0x2764)%」
					ENDIF
				CASE 3
					IF EX:膣内精液 >= 500
						PRINTFORMW 「아우우……릴리 화이트 안이, 가득 채워진 충만함 같은 느낌이에요…… %CALLNAME:MASTER%%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 일렁이는 표정으로 %조사처리(CALLNAME:MASTER,"의")% 이름을 부르며 자신의 음순을 벌리고, 이전에 주입된 정액과 애액이 함께 천천히 흘러내려 매우 음란하다.
						PRINTFORMW 「싫어…… 새어 나올 것 같아……」
						PRINTFORMDW 소녀는 아쉬운 듯 중얼거렸으나, 잠시 후 다시 기쁜 표정으로 %조사처리(CALLNAME:MASTER,"를")% 바라본다.
						PRINTFORMW 「하지만 괜찮아요…… 릴리 화이트를 사랑하는 %CALLNAME:MASTER%, 몇 번이든 릴리 화이트를 가득 채워줄 테니까……」
						PRINTFORMW 「릴리 화이트는…… 정말 행복해요……%UNICODE(0x2764)%」
					ELSE
						PRINTFORML 「흐응, 이렇게 릴리 화이트를 초조하게 만들지 마요%UNICODE(0x2764)%」
						PRINTFORML 「부디 릴리 화이트의 안에서 %조사처리(CALLNAME:MASTER,"의")% 거시기로 마음껏 휘저어 주세요%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 욕망으로 가득 찬 표정으로 어린 비밀의 틈을 벌려 애액으로 질 입구가 미끌미끌하게 젖은 채 삽입되기를 간청했다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 일부러 그녀의 질 안쪽에 숨을 불어넣자, 릴리 화이트는 갑작스러운 자극에 몸을 떨었다.
						PRINTFORML 「싫어요, 더 이상 도발하지 말아 주세요%UNICODE(0x2764)% %조사처리(CALLNAME:MASTER,"를")% 원해요… 릴리 화이트, 이제 견딜 수가 없어요%UNICODE(0x2764)%」
					ENDIF
				CASE 4
					IF EX:膣内精液 >= 500
						PRINTFORML 「응... 아... 이렇게나 많은……」
						PRINTFORMDL 질액과 정액이 섞인 혼합물이 소녀의 음순 사이에서 넘쳐 흘러 나왔다.
						PRINTFORMDW 한꺼번에 벌리자, 그 혼합물은 제방이 무너지듯 진득하게 범람하며 허벅지 뿌리를 타고 흘러내렸다. 실로 야릇했다.
						PRINTFORMW 「릴리 화이트... 정말 %조사처리(CALLNAME:MASTER,"에게")% 잘 채워졌구나... 아래가 아주 꽉 차서, 릴리 화이트는 행복하네...」
					ELSE
						PRINTFORML 「저기, 이렇게 릴리 화이트를 초조하게 만들지 말아줘%UNICODE(0x2764)%」
						PRINTFORML 「빨리 %조사처리(CALLNAME:MASTER,"의")% 커다란 거시기(肉棒)로 릴리 화이트의 이곳을 유린하고 괴롭혀 줘%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 괴로운 표정으로 자신의 은밀한 곳을 벌려 애액으로 촉촉하게 젖은 질 입구를 보여주며 삽입되기를 간청했다.
						PRINTFORMW 「제발 좀 빨리 해줘…… 릴리 화이트, 머릿속에 봄 말고는 아무것도 생각할 수 없어……」
					ENDIF
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		IF EX:膣内精液 >= 500
			PRINTFORMW 「흐응%UNICODE(0x2764)%……싫어, 이상한 소리…… 나올 것 같아…%UNICODE(0x2764)%」
			PRINTFORMDW 릴리 화이트는 작은 신음과 함께 음도에서 정액이 천천히 흘러나오는 느낌을 받으며 두 손으로 조심스럽게 음순을 벌려 %조사처리(CALLNAME:MASTER,"에게")% 보여준다.
			PRINTFORMDW 아마 요정의 어린 질에게는 너무 많은 양인 듯, 오랫동안 흘러내리고 있음에도 정액은 전혀 멈출 기미가 보이지 않았고 릴리 화이트 아래에 작은 정액 웅덩이가 고여 있었다.
			PRINTFORMW 「싫어…… 이렇게 많이 사정하면 릴리 화이트 여기가 또 뜨겁고 가려워…… 오늘 밤, 제대로 잠 못 잘 것 같아… 응아%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「아아… 이렇듯, 벌린다면…… 안 돼, 그렇게 가까이서 보지 마……」
			PRINTFORMDW 릴리 화이트는 매우 꺼리는 듯 다리를 벌려 질 입구를 보여주었고, %조사처리(CALLNAME:MASTER,"는")% 거친 숨을 몰아쉬며 얼굴을 가까이 대고 감상했다.
			PRINTFORMDW 거칠게 내뱉는 호흡 소리가 끊임없이 불어왔고, 매번 릴리 화이트의 은밀한 곳을 타격할 때 소녀의 몸은 미세하게 떨렸다.
			PRINTFORMW 「너무 간지러워…… 뭔가 이상해, 안 돼… 벌써 끝났잖아, 더 보지 마……」
			PRINTFORMDW 릴리 화이트는 얼굴을 붉히며 자신의 은밀한 곳을 필사적으로 가렸고, %조사처리(CALLNAME:MASTER,"는")% 아쉬움을 뒤로하며 얼굴을 돌렸다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
