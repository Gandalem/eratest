RETURN RESULT

@M_KOJO_tokicoli_MESSAGE_COM_K18_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMDW 
		ELSEIF TALENT:恋慕
			CALL K18_FIRSTSEEJB
			PRINTFORMW 「헤헤헤… %조사처리(CALLNAME:MASTER,"의")% 거시기, 릴리 화이트 손으로 기분 좋게 해드릴까요? 릴리 화이트가 아주 부드럽게 해드릴게요~」
			PRINTFORMDW 릴리 화이트의 보들보들한 작은 손이 거시기를 가볍게 감싸 쥐고 어설프게 위아래로 움직인다. 비록 부드러운 촉감은 좋았지만, 느껴지는 쾌감은 결국 한계가 있었다.
			PRINTFORMW 「이렇게 가까이서 보면 정말 크고 뜨거워요… 냄새도 신기하고, 심장도 두근거리고… %CALLNAME:MASTER%께서 시키는 대로 하면 되나요?」
			PRINTFORMW 「응응… 그런 거구나? 응응, 거시기의 뒷부분을 혀로 핥다가 살짝 빨아들이는 거지… 쪽, 음…」
			PRINTFORMDW 릴리 화이트는 천천히 얼굴을 거시기에 가까이 대고 호기심 가득 관찰하며 %조사처리(CALLNAME:MASTER,"의")% 인도에 따라 부드럽게 애무하기 시작한다.
			PRINTFORMDW 때로는 단단하게 움켜쥐고, 때로는 이끌어주고, 때로는 살짝 핥아주며 거시기는 릴리 화이트의 연약하고 가느다란 손길로 만져져 한 손으로는 도저히 감당할 수 없을 정도로 부풀어 올랐다.
			PRINTFORMW 「와와와! 이렇게 크면 릴리 화이트 혼자서는 못 잡겠어요… 두 손으로 하면 %조사처리(CALLNAME:MASTER,"는")% 더 기분 좋을까요…? 음슉…」
			PRINTFORMDW 두 배로 증폭된 부드러움과 쾌감이 남성기에서 전해져 오는 것을 느낀 %조사처리(CALLNAME:MASTER,"는")% 멍한 표정을 지었다. 이 모습을 알아챈 릴리 화이트는 기쁘게 웃으며 노력하는 두 손으로 봉사했다.
			PRINTFORMW 「%CALLNAME:MASTER%께서 아주 편안해 보이세요? 릴리 화이트가 %CALLNAME:MASTER%께 배운 대로 더 열심히 해드릴게요~ 힘차게~ 힘차게~」
		ELSE
			PRINTFORMW 「저기……%조사처리(CALLNAME:MASTER,"의")% 이 꿈틀거리는 건…… 성기라고 부르는 거야, 릴리 화이트가 손으로 잡아야 해?」
			PRINTFORMW 「이 냄새가 너무 이상하고 지독해. 릴리 화이트의 손으로는 아마 못 잡을 것 같아… 아앗, 뜨거워, 아직 서서 점점 더 커지는 것 같은데? 헤에~!」
			PRINTFORMDW 릴리 화이트는 반은 두렵고 반은 호기심이 나서 남근을 움켜쥐었다. 부드러운 작은 손이 갑자기 힘을 주자…….
			PRINTFORMW 「앗?! 미, 미안해! 못 봤어…… 분명 아팠겠지……」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 통증으로 괴로워하는 하반신 위에서 릴리 화이트에게 어떻게 해야 하는지 설명했다…….
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		;恋慕
	ELSEIF TALENT:恋慕
		;出す直前
		;这之后射精(射精之前的描写)
		IF NOWEX:PLAYER:射精
			PRINTFORMW 「이렇게 커졌네에… 에헤헤~ %조사처리(CALLNAME:MASTER,"의")% 거시기, 계속 떨리고 있어… 곧 나올 것 같아?」
			PRINTFORMDW 릴리 화이트는 기분 좋게 웃으며 부드러운 작은 두 손으로 터지기 직전의 성기를 위아래로 움직인다.
			PRINTFORMW 「괜찮아 %UNICODE(0x2764)%… 많이 괴롭구나, 릴리 화이트가 %조사처리(CALLNAME:MASTER,"를")% 편안하게 해줄게… 응읏…」
			PRINTFORMDW 사정하기 직전이 되자 시중드는 방식을 바꾸고, 릴리 화이트는 한 손으로 요도구를 문지르고 다른 한 손으로는 성기를 움직이며 열심히 모시고 있다.
			PRINTFORMDW 양쪽의 자극에 %조사처리(CALLNAME:MASTER,"의")% 몸이 떨리기 시작하고, 곧 폭발할 듯하다.
			PRINTFORMW 「그냥 그렇게 싸버려 %UNICODE(0x2764)%… 그렇게, 릴리 화이트의 손으로 %UNICODE(0x2764)% 부비부비하게 싸줘 %UNICODE(0x2764)%%UNICODE(0x2764)%」
		ELSE
			IF RAND:4 == 0
				PRINTFORMW 「후후… 여기, 꽤 민감한 것 같네%UNICODE(0x2764)% 봐봐, 움찔움찔거리고 있어%UNICODE(0x2764)%」
				PRINTFORMDW 옥처럼 하얗고 가느다란 손가락이 요도를 만지작거리자, 이미 흥분한 성기는 유혹적인 애무에 움찔거리며 떨려온다
				PRINTFORMDW 투명한 액체가 요도구에서 끊임없이 흘러나와 그녀의 작은 손바닥을 가득 적시며, 무척이나 음란한 모습을 보인다
				PRINTFORMDW 릴리 화이트는 부드러운 작은 손으로 성기를 전방위적으로 애무하며, 때때로 혀를 내밀어 귀두를 핥으며 %조사처리(CALLNAME:MASTER,"의")% 욕정을 자극한다
			ELSEIF RAND:3 == 0
				PRINTFORMW 「음슈……헤이슈, 에? 원하는 건가… 릴리 화이트의 머리카락으로 같이 해달라는 거야? 우응……」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 릴리 화이트의 부드러운 금발로 성기를 감싸서 문지르길 원하자, 릴리 화이트는 작은 손으로 금빛 긴 머리를 만지며 잠시 생각한 후 곧 고개를 끄덕이며 승낙했다.
				PRINTFORMW 「응응, 괜찮아…… 릴리 화이트의 머리카락은 %조사처리(CALLNAME:MASTER,"를")% 위해 매일 관리하는 거니까! 이래도 %조사처리(CALLNAME:MASTER,"를")% 위한 거야~」
				PRINTFORMDW 릴리 화이트는 기쁜 미소를 지으며 고개를 숙여 부드러운 금발을 성기에 감고, 두 손으로 자신의 머리카락과 %TINKO(PLAYER)%를 부드럽게 어루만졌다.
				PRINTFORMDW 금빛 긴 머리에서 풍겨 나오는 과일 향을 맡고 만지작거리자 %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 깊은 숨을 들이켰다. 릴리 화이트의 아름다운 머리카락을 더럽힐 것이라는 부덕한 감각에 성기가 커져갔다.
				PRINTFORMW 「그렇게 말하는 건… 릴리 화이트의 긴 머리가 %조사처리(CALLNAME:MASTER,"를")% 기쁘게 해주는 거구나! 릴리 화이트는 정말 행복해, 열심히 할게…… 음슈…… %CALLNAME:MASTER%, 이대로 편해?」
				PRINTFORMDW 릴리 화이트가 고개를 들어 %조사처리(CALLNAME:MASTER,"를")% 올려다보는 모습에 %조사처리(CALLNAME:MASTER,"는")% 매우 만족감을 느꼈고, 부드러운 머리카락의 감촉을 느끼며 릴리 화이트는 계속해서 움직였다.
				PRINTFORMW 「헤이슈…… 음슈, 미끌미끌한 액체가 새어 나왔네…… 이거, 머리카락에 더러워질지도 몰라…… 헤이슈……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「상냥한 봉사와 강렬한 자극 모두 중요하단 거지? 그럼 이렇게 해야 하는 거야……」
				PRINTFORMDW 두 손으로 거친 것을 애써 만지고 있던 릴리 화이트가 요도구 쪽으로 가볍게 숨을 불어넣자, 그곳이 미세하게 떨리기 시작했다.
				PRINTFORMW 「후후, 정말 귀엽다 귀여워%UNICODE(0x2764)% %조사처리(CALLNAME:MASTER,"의")% 반응~ 후, 하아, 헤으윽……」
				PRINTFORMDW 애써 봉사하던 릴리 화이트가 두 손으로 잠시 지친 듯 크게 숨을 몰아쉬자, %조사처리(CALLNAME:MASTER,"는")% 그녀에게 휴식이 필요한지 걱정스럽게 물었다.
				PRINTFORMW 「릴리 화이트 괜찮아요…… 조금 힘들긴 하지만 계속 할 수 있어요, %조사처리(CALLNAME:MASTER,"는")% 그냥 즐겨주세요! 음읏, 후하…… 헤헤, 릴리 화이트 노력할게요!」
				PRINTFORMDW 소녀의 애쓰는 모습에 %조사처리(CALLNAME:MASTER,"의")% 마음속에 따스한 물결이 일었고, 그녀의 머리를 부드럽게 쓰다듬으며 봉사를 만끽했다.
			ELSE
				PRINTFORMW 「손으로 계속 만지고 있으니 너무 힘들어, 이럴 땐 %조사처리(CALLNAME:MASTER,"가")% 말해준 기술적인 봉사를 해봐야겠어... 어떻게 하는 거지?」
				PRINTFORMDW  릴리 화이트는 고개를 기울이고 잠시 생각한 뒤, %조사처리(CALLNAME:MASTER,"의")% 지시에 따라 그다지 힘들지 않은 봉사를 시작했다.
				PRINTFORMW 「우선 손끝으로 자극하듯이 %TINKO(PLAYER)%의 끝 부분을 간질여주는 거야... 끝 부분이 약점이라 효과가 두 배로 좋아%UNICODE(0x2764)%」
				PRINTFORMDW 단단한 성기가 부드럽고 가느다란 손끝에 가지고 이리저리 놀아지며 꿈틀거렸고, 릴리 화이트는 그 모습을 보며 즐겁게 웃었다.
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 기분 좋아 보이네...? 그리고 손바닥으로 끝 부분을 감싸서 주무르는 거야... 헤헤, 아주 편안해 보이는 표정이야%UNICODE(0x2764)% 릴리 화이트도 정말 기쁘다~♪」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「이렇게 가까이서 보면 정말 크고, 뜨거워…… 냄새도 아주 기묘하고, 또 계속 꿈틀대고 있어…… %조사처리(CALLNAME:MASTER,"가")% 시키는 대로 하면 되는 거야?」
			PRINTFORMDW 릴리 화이트는 천천히 얼굴을 남근에 가까이 가져다 대고, 홍조를 띠며 호기심 가득 관찰하다가 %조사처리(CALLNAME:MASTER,"의")% 유도에 따라 서서히 애무하기 시작했다.
			PRINTFORMDW 때로는 꽉 움켜쥐고, 때로는 이끌면서 남근은 릴리 화이트의 부드럽고 가느다란 손에 놀아나며 이미 한 손으로는 도저히 잡을 수 없을 정도로 커져 있었다.
			PRINTFORMW 「우와와! 이렇게까지 커질 수 있다니, 정말 믿기지 않아……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이렇게 열심히 움직이고 있어도, 결국은 금방 지게 될 거야…」
			PRINTFORMDW 릴리 화이트의 가녀린 손이 노력하며 위아래로 %조사처리(CALLNAME:MASTER,"를")% 움직였지만, 잠시 후 손목에 통증이 느껴져 충분한 쾌감을 줄 힘이 없어졌다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 릴리 화이트가 체력을 회복하기를 기다리지 않고, 거칠게 양손으로 릴리 화이트의 손목을 붙잡고 부드러운 작은 손으로 강제로 남성의 성기를 쓰다듬기 시작했다.
			PRINTFORMW 「아파!? 잠깐… %CALLNAME:MASTER%, 그렇게 거칠게 하지 마, 릴리 화이트의 손목이 부서질 것 같아!」
			PRINTFORMDW 울면서 빨개진 손목을 신경 쓰지 않은 채, %조사처리(CALLNAME:MASTER,"는")% 쾌감을 위해 강제로 릴리 화이트의 작은 손으로 남성의 성기를 움직이기 시작했다.
		ELSE
			PRINTFORMW 「뿌리부터 귀두까지 제대로 해줄 거야? 우우... 너무 어려울 것 같아」
			PRINTFORMDW 릴리 화이트는 %조사처리(CALLNAME:MASTER,"의")% 말대로 열심히 자위하고 있었지만, 남성의 체취와 특유의 감촉 때문에 제대로 봉사할 수가 없었다.
			PRINTFORMW 「아직, 안 했어?」
			PRINTFORMW 「앗, 빨리 사정해 주는 거... 손이 너무 피곤해!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
