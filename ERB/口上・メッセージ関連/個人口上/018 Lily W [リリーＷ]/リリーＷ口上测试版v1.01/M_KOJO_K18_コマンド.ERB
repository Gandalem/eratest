@M_KOJO_tokicoli_MESSAGE_COM_K18_351
;連れ出しにはTRAIN_MESSAGEが無い
CALL M_KOJO_tokicoli_MESSAGE_COM_K18_351_1
RETURN RESULT

@M_KOJO_tokicoli_MESSAGE_COM_K18_351_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「청소든 요리든 무엇이든 릴리 화이트는 도우러 올 것이다. 신부 수련의 일부이기 때문이다!」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 함께라면 무엇을 하든 즐겁다. 가능하다면 릴리 화이트네 집에도 한번 와보렴?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「혼자보다는 두 사람이 함께할 때 행복이 두 배가 된다. 그렇다면 세 명이 되면 행복은 세 배가 될 것이다! 가능하다면, 코로도 데려와 줄 수 있어...」
			PRINTFORMDW ...%조사처리(CALLNAME:MASTER,"는")% 수라장이 될 것 같아서 서둘러 제지했다.
			PRINTFORMW 「우... 코로가 정말 이래 싫어하는구나... 그렇다면 두 사람은 무엇을 해야 할까?」
		ELSE
			PRINTFORMW 「오늘은 어디에 갈 거예요? 어디를 가든 릴리 화이트는 당신을 따라갈 거예요!」
			PRINTFORMDW 릴리 화이트는 당연하다는 듯 %조사처리(CALLNAME:MASTER,"의")% 팔에 바짝 달라붙었다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMDW  릴리 화이트는 잠시 망설이다가, 결국 %조사처리(CALLNAME:MASTER,"가")% 내민 손을 잡았다.
			PRINTFORMW 「같이 나가자……아, 괜찮아……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「같이… 나가려는 거야, 먼저 릴리 화이트가 준비할게……」
			PRINTFORMDW 릴리 화이트는 자신의 것을 확인하는 듯하다.
			PRINTFORMDW (너무 흥분하면 안 돼… 이 사랑은 결코 결과가 있을 수 없어, 이 감정을 눌러야 해… 푸하)
			PRINTFORMW 「릴리 화이트 준비됐어, 출발하자……」
		ELSE
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 도움 덕분에 환상향 밖의 곳에도 가봤네……」
			PRINTFORMW 「세상은 정말 광활한 것이구나.」
			PRINTFORMDW (하지만 이렇게 넓은 세상이라도, 요정과 함께 행복할 수 있는 장소는 없는 것 같아……)
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「오늘은 릴리 화이트를 어디에 데려갈까? 재미있는 곳이야?」
			PRINTFORMDW 릴리 화이트는 기쁜 듯 %조사처리(CALLNAME:MASTER,"의")% 뒤를 따랐다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 릴리 화이트 데리고 나가 줄 거야? 괜찮아욧!」
			PRINTFORMW 「재미있는 걸 볼 수 있으면 좋겠네!」
		ELSE
			PRINTFORMW 「왜인지 모르겠는데, 릴리 화이트랑 %조사처리(CALLNAME:MASTER,"가")% 같이 있을 때 기분이 정말 좋아지는걸!」
			PRINTFORMW 「두 사람이 함께하면 행복이 두 배인 느낌? 그런 느낌일까?」
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「릴리 화이트가 너를 따라도 괜찮아?」
			PRINTFORMW 「응, 좋아욧!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「릴리 화이트를 어디 데려가려는 거야?」
			PRINTFORMW 「무서운 곳은 아니겠지?」
		ELSE
			PRINTFORMW 「예전에는 봄이 아니면 별로 밖에 안 나왔는데.」
			PRINTFORMW 「왠지 기분이 좋아진 것 같아!」
		ENDIF
	ELSE
		PRINTFORMW 「와, 어디로 가는 거예요?」
		PRINTFORMDW 릴리 화이트는 비틀거리며 %조사처리(CALLNAME:MASTER,"의")% 뒤를 따르고 있다.
		PRINTFORMDW 가끔 고개를 돌려 당신을 바라보는데, 아직은 영 믿음이 가지 않는 듯하다.
	ENDIF
ENDIF
RETURN 1
