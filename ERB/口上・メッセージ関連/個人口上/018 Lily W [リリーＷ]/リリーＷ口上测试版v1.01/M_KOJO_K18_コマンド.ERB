@M_KOJO_tokicoli_MESSAGE_COM_K18_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示,1, 表示）
LOCAL = 1
;-------------------------------------------------
IF FLAG:時間停止
	RETURN 0
ELSEIF CFLAG:TARGET:睡眠
	RETURN 0
ELSEIF CFLAG:うふふ
	IF TALENT:恋人
		PRINTFORML 
		PRINTFORMW 「%CALLNAME:MASTER%――바닥이나 깨끗하게 쓸지 말고, 어서 릴리 화이트 여기부터 청소해줘!」
		PRINTFORMDW 주변이 조금 더러운 것을 보며, 깨끗한 환경에서 해야 한다고 생각하며 계속해서 쓸어 나갔다.
		PRINTFORMW 「흐윽…… 괴롭히기야, 벌써 릴리 화이트가 기대하는 달콤한 체액이 흥건하게 흘러넘치는데 말이야, %CALLNAME:MASTER%어서 와줘――」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 스스로의 미끌거리는 작은 구멍을 살짝 벌리고 있는 릴리 화이트를 바라보았지만, 욕망이 자극되었음에도 청소를 계속했다.
		PRINTFORMW 「%CALLNAME:MASTER%――어서 와줘, 이렇게 기다리는 플레이 정말 괴롭잖아…」
	ELSEIF TALENT:恋慕
		PRINTFORML 
		PRINTFORMW 「――%CALLNAME:MASTER%? 왜, 에헤……?」
		PRINTFORMDW 릴리 화이트는 당황한 표정으로 물으며, %조사처리(CALLNAME:MASTER,"는")% 더러운 환경을 방치하지 않고 청소를 계속하고 있다고 답한다.
		PRINTFORMW 「싫어……. 안 돼……. 빨리 데려와 줘, 릴리 화이트가 원하잖아……」
		PRINTFORMDW (이렇게 가다가는…… 이렇게 가다가는 정신이 번쩍 들어버릴 것 같아, 릴리 화이트는 분명 H에 잠겨 고민을 잊고 싶었는데……)
	ELSE
		PRINTFORML 
		PRINTFORMW 「――에헤, 왜 청소하고 있는 거야?」
		PRINTFORMDW 릴리 화이트는 당황한 표정으로 물었다. `%CALLNAME:MASTER%`는 더러운 환경을 방치할 수 없다고 대답하며 계속해서 청소를 진행했다.
		PRINTFORMW 「음, 릴리 화이트가 아무것도 하지 않는 건… 이 기분이 정말 이상해… 빨리 돌아와 줘!」
		PRINTFORMDW 금방 다 할 거야, 조금만 더 기다려 줘.
		PRINTFORMW 「우와, 어째서 이러는 거야, 정말이지... 빨리 돌아와 줘...」
	ENDIF
ELSEIF TALENT:恋人
	IF OUTROOF(CFLAG:現在位置)
		;在室外
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 500
			GOTO SAOCU1
		ELSE
			GOTO SAOCU2
		ENDIF
	ELSE
		;在室内
		IF CFLAG:18:溜まってる度 > 800
			SELECTCASE RAND:5
				CASE 0
					;擦玻璃
					PRINTFORMW 「응... 유리 닦을 때는, 릴리 화이트가 날아다니면 더 좋을 것이다...」
					PRINTFORMDW 얼굴이 붉어진 릴리 화이트는 비틀거리며 날아올라 유리를 닦았으나, 크게 숨을 몰아쉬며 내뱉은 숨이 금세 유리를 지워버렸다.
					PRINTFORMDW 계속 몸을 비트는 릴리 화이트의 하체는 아무런 방비가 없었고, 어쩌면 릴리 화이트가 풍기는 암컷 호르몬의 기운에 이끌린 %조사처리(CALLNAME:MASTER,"가")% 저절로 릴리 화이트의 치마 밑으로 다가갔다.
					IF CFLAG:ノーパン
						PRINTFORMDW 방금 치마 밑에 얼굴을 가까이 대자 물방울이 떨어지는 것을 느꼈다. 이게 뭔지 생각하며 고개를 들었는데, 릴리 화이트의 티 없이 하얀 은밀한 곳에서 달콤한 진액이 천천히 흘러나오고 있었다.
						PRINTFORMDW 코끝은 농후한 단 향으로 가득 차며, %조사처리(CALLNAME:MASTER,"의")% 이성은 점차 무너져 거칠게 숨을 몰아쉬기 시작했다…
						PRINTFORMW 「%CALLNAME:MASTER%…… 지금 릴리 화이트 치마 밑에 있지? 그렇다면 %CALLNAME:MASTER%도 릴리 화이트가 원하는 게 뭔지 알겠지%UNICODE(0x2764)%」
						PRINTFORMDW 아마도 %조사처리(CALLNAME:MASTER,"의")% 숨소리를 느낀 릴리 화이트는 이곳에서 무슨 일이 벌어지고 있는지 알아차렸다. 막 설명하려던 순간, 릴리 화이트의 웃음소리가 들렸고, 이내 은밀한 곳이 얼굴 위로 푹 쏟아졌다.
						PRINTFORMW 「헤헤♪ 릴리 화이트 거%UNICODE(0x2764)%는 사랑받고 싶어해%UNICODE(0x2764)% 어서 해줘, 릴리 화이트 기분 좋게 해줘야지%UNICODE(0x2764)%」
						PRINTFORMDW 진한 단 향이 얼굴을 강타하며 %조사처리(CALLNAME:MASTER,"의")% 이성은 완전히 붕괴했고, 작은 엉덩이를 필사적으로 붙잡고 릴리 화이트의 달콤한 액체를 빨기 시작했다.
						PRINTFORMW 「아우욱%UNICODE(0x2764)% 클리클%UNICODE(0x2764)%도 맛보게 해줘%UNICODE(0x2764)% 잉잉%UNICODE(0x2764)% 기분 좋아%UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트는 유리 위에 엎드려 발각될 가능성은 아랑곳하지 않고 계속 빨리고 있었고, 내쉬는 열기로 유리는 뿌옇게 변해갔다…
					ELSE
						PRINTFORMDW 얼굴을 치마 밑으로 가져가자 유혹적인 달콤한 향이 풍겼다… 고개를 들자, 애액에 흠뻑 젖은 %PANTSNAME(EQUIP:下半身下着２, TARGET)%가 보였다.
						PRINTFORMDW 채워지지 않는 욕망 때문에 흘러넘친 애액이 지금도 릴리 화이트의 허벅지를 따라 천천히 흘러내리고 있었으며, 그 모습은 매우 유혹적이었다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 눈앞에 펼쳐진 봄의 정경에 자신도 모르게 달콤한 숨을 크게 들이마셨다.
						PRINTFORMW 「%CALLNAME:MASTER%… 지금 릴리 화이트의 치마 밑에 있지? 그렇다면 %CALLNAME:MASTER%도 릴리 화이트가 원하는 게… 무엇인지 알겠지%UNICODE(0x2764)%」
						PRINTFORMDW 어쩌면 %조사처리(CALLNAME:MASTER,"의")% 숨결을 느꼈는지, 릴리 화이트는 이곳에서 무슨 짓을 하고 있는지 알아차렸다. 막 해명하려던 순간, 릴리 화이트의 웃음소리가 들렸고 이어서 릴리 화이트의 손가락이 팬티 위로 향했다.
						PRINTFORMDW 소녀의 신음과 함께 젖혀진 팬티 안에서 애액이 가득 흘러넘치며 진한 달콤한 향을 풍기고, %조사처리(CALLNAME:MASTER,"의")% 욕망을 자극한다.
						PRINTFORMW 「릴리 화이트의 그곳%UNICODE(0x2764)% 벌써 원해서 견딜 수 없단 말이야%UNICODE(0x2764)% 그러니까%UNICODE(0x2764)% 어서 빨리%UNICODE(0x2764)% 와서 릴리 화이트를 만족시켜 줘%UNICODE(0x2764)%%UNICODE(0x2764)%」
					ENDIF
				CASE 2
					;擦地板等
					PRINTFORMW 「응응, 그럼 릴리 화이트가 바닥을 닦을게요… 영차%UNICODE(0x2764)% 영차%UNICODE(0x2764)%」
					PRINTFORMDW 전념해서 청소하고 싶지만, 릴리 화이트가 유혹하듯 계속해서 달콤한 소리를 내는 바람에 %조사처리(CALLNAME:MASTER,"는")% 청소에 집중할 수가 없다.
					PRINTFORMDW 시선을 릴리 화이트에게 돌리자, 릴리 화이트가 등을 돌린 채 일부러 그러는 듯 가냘픈 엉덩이를 계속 흔들며 유혹하고 있었고, %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 침을 삼켰다.
					PRINTFORMDW 이런 식으로는 도저히 청소에 집중할 수 없다. %조사처리(CALLNAME:MASTER,"의")% 시선을 눈치챈 릴리 화이트가 요염하게 웃으며 치마를 걷어 올렸다.
					IF CFLAG:ノーパン
						PRINTFORMW 「릴리 화이트는 이곳이 벌써 이렇게 축축해졌어%UNICODE(0x2764)% 게다가 지금%UNICODE(0x2764)% 계속 흘러내리고 있어%UNICODE(0x2764)% 그냥 이대로 바로 박아 넣어줘도%UNICODE(0x2764)% 괜찮을 거야%UNICODE(0x2764)%?」
						PRINTFORMDW 눈앞에는 달콤한 애액에 젖어 음란한 광택이 감도는 릴리 화이트의 은밀한 곳과, 작게 오므라든 소음순이 보이며 봄날의 풍경은 매우 유혹적이다.
						PRINTFORMDW 소녀의 신음소리와 함께 은밀한 구멍이 소녀의 가느다란 손가락에 벌어지며 애액이 넘쳐 치마와 바닥을 적신다.
						PRINTFORMW 「릴리 화이트는 지금%UNICODE(0x2764)% 그저 발정 난 요정일 뿐이야%UNICODE(0x2764)% 그러니 그냥 이대로%UNICODE(0x2764)% 교미하듯이%UNICODE(0x2764)% 바로 릴리 화이트의 몸속에 박아 넣어줘%UNICODE(0x2764)%%UNICODE(0x2764)%」
					ELSE
						PRINTFORMW 「야♪ 릴리 화이트 거 다 보여버렸네%UNICODE(0x2764)%」
						PRINTFORMDW 눈앞에는 애액에 젖은 %PANTSNAME(EQUIP:下半身下着２, TARGET)%가 있고, 애액이 허벅지를 따라 끊임없이 흘러내려 매우 야하다.
						PRINTFORMW 「릴리 화이트 거%UNICODE(0x2764)% 언제든 박아도 괜찮을 거야%UNICODE(0x2764)% 어차피 릴리 화이트는 벌써 욕망으로 불타오르고 있잖아%UNICODE(0x2764)%」
						PRINTFORMDW 소녀는 자신의 연분홍빛 작고 예쁜 엉덩이를 흔들며 유혹하고, 때때로 일부러 가쁜 숨을 내어 %조사처리(CALLNAME:MASTER,"의")% 욕구를 자극한다.
						PRINTFORMW 「거 벌써 축축하게 준비 다 됐는데%UNICODE(0x2764)% 릴리 화이트 몸이 너무 뜨거우니까 서두르지 말아줘%UNICODE(0x2764)% 안 그러면 릴리 화이트가 먼저 %조사처리(CALLNAME:MASTER,"를")% 먹어버릴지도 몰라%UNICODE(0x2764)%」
					ENDIF
				CASE 3
					;清理高处
					PRINTFORMW 「어라, 릴리 화이트가 그곳의 먼지를 치고 싶은데, %조사처리(CALLNAME:MASTER,"가")% 릴리 화이트를 안아주세요%UNICODE(0x2764)%」
					PRINTFORMDW 얼굴을 붉힌 릴리 화이트가 그렇게 청하며, 지금의 릴리 화이트는 유혹적인 향기를 풍기는 듯하다. %조사처리(CALLNAME:MASTER,"의")% 선택은…
					CALL ASK_M("작은 장난",1,"평범하게 높이 들었다",1)
					IF RESULT==0
						PRINTFORMW 「응야?! %CALLNAME:MASTER%, 정말이지%UNICODE(0x2764)% H%UNICODE(0x2764)%」
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 왼손으로 릴리 화이트의 작고 귀여운 엉덩이를 받치고 오른손으로는 은밀한 곳을 주무르며 색정적인 방식으로 릴리 화이트를 들어 올렸고, 릴리 화이트는 앙탈스럽게 당신을 한 번 노려본 후 먼지를 털기 시작한다.
						PRINTFORMDW 요정이라 몸이 가볍기는 하지만 중력의 작용으로 은밀한 곳이 손에 단단히 눌렸고, 옷을 입고 있어도 릴리 화이트의 은밀한 곳의 모양과 부드러움… 그리고 축축해진 감촉까지 느껴진다.
						PRINTFORMDW 릴리 화이트는 일부러 엉덩이를 계속 흔들며 자신의 은밀한 곳이 손가락의 접촉을 느끼게 하고, 때때로 미세한 가냘픈 신음을 흘린다. %CALLNAME:MASTER%역시 그녀에게 맞춰 애무하기 시작한다.
						PRINTFORMW 「이야%UNICODE(0x2764)% 응응%UNICODE(0x2764)% 거긴%UNICODE(0x2764)% 제대로 청소하지 않으면 안 돼%UNICODE(0x2764)%」
						PRINTFORMDW 릴리 화이트의 달콤한 목소리의 유혹에 %조사처리(CALLNAME:MASTER,"의")% 행동도 대담해지기 시작하고, 왼손은 거리낌 없이 작고 부드러운 엉덩이를 주무르며 오른손은 옷 위로 음핵과 은밀한 곳을 만진다.
						PRINTFORMW 「우응%UNICODE(0x2764)% 안 돼%UNICODE(0x2764)% 혹시라도 들키면 어떡해%UNICODE(0x2764)% 아아%UNICODE(0x2764)% 방에 가서 하자%UNICODE(0x2764)%」
						PRINTFORMDW 입으로는 그렇게 말하고 있지만, 봉긋하게 솟은 유두와 음핵은 솔직하다. 게다가 은밀한 곳은 손가락을 놓아주지 않고 빨아들이고 있다.
						PRINTFORMW 「싫어%UNICODE(0x2764)% 괴롭히기야%UNICODE(0x2764)% 릴리 화이트는 원해%UNICODE(0x2764)% 이렇게 건드리는 것%UNICODE(0x2764)%을 원해%UNICODE(0x2764)% 하고 싶어%UNICODE(0x2764)%」
					ELSE
						PRINTFORMW 「%CALLNAME:MASTER%……불, 릴리 화이트는 아무것도 말 안 했어… 음…」
						PRINTFORMDW 잔뜩 화가 난 듯한 릴리 화이트는 얼굴을 돌리고 허리를 잡힌 채 찬장 높은 곳의 먼지를 청소하기 시작한다. 릴리 화이트는 마치 뜨거운 것처럼 몸을 끊임없이 비튼다…
						PRINTFORMDW 릴리 화이트에게서 풍겨오는 달콤한 향기를 맡으며 %조사처리(CALLNAME:MASTER,"는")% 욕망이 점차 타오르는 것을 느낀다…
						PRINTFORMDW 두 손은 자신도 모르게 릴리 화이트의 가녀린 허리를 더욱 단단히 감싸 안는다. 릴리 화이트의 작고 부드러운 엉덩이의 촉감이 느껴진다…
						PRINTFORMDW 두 사람은 이렇게 향긋한 분위기 속에서 먼지 제거를 마쳤다
					ENDIF
				CASEELSE
					;擦桌子
					PRINTFORMW 「그럼, 릴리 화이트가 테이블을 닦아야겠네…… 음읏%UNICODE(0x2764)% 아아%UNICODE(0x2764)% %CALLNAME:MASTER%%UNICODE(0x2764)%」
					PRINTFORMDW 릴리 화이트는 이상한 자세로 테이블 위에 엎드려 걸레를 들고 테이블을 청소하기 시작하지만, 종종 나긋한 신음을 흘린다.
					PRINTFORMDW 자세히 보니 릴리 화이트는 테이블 모서리를 자위하면서 동시에 테이블을 닦고 있었는데, 이 광경을 본 %조사처리(CALLNAME:MASTER,"는")% 결심한다…
					CALL ASK_M("릴리 화이트의 비밀스러운 곳도 깨끗하게 청소했다",1,"방 청소를 안 해줘",1)
					IF RESULT==0
