;311,擁抱（拥抱）
;==================================================

@M_KOJO_tokicoli_MESSAGE_COM_K18_311
CALL M_KOJO_tokicoli_MESSAGE_COM_K18_311_1
RETURN RESULT

@M_KOJO_tokicoli_MESSAGE_COM_K18_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMDW 정지된 시간 동안 릴리 화이트의 몸이 주는 부드러움을 느낀다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그녀에게 상처를 주지 않을 정도의 힘으로 릴리 화이트를 끌어안았다.
	ELSEIF CFLAG:TARGET:睡眠
		PRINTFORMW 「코쿠로… 이렇게 안고 있으면 더 뜨거워져…」
		PRINTFORMDW 릴리 화이트는 말다툼하는 듯한 모습을 하고 있다.
		PRINTFORMDW 정신이 들었을 때보다 더 따뜻한 체온을 느낀다.
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「...꾸윽」
		PRINTFORMDW 릴리 화이트가 얼굴을 돌려 %조사처리(CALLNAME:MASTER,"를")% 밀쳐냈다.
	ELSEIF TALENT:恋人
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 500
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「에헤헤…… 너무 뜨거워…… 음으…」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 안고 있는 릴리 화이트는 사과처럼 얼굴을 붉히며, 안고 있으면서 자신의 은밀한 곳으로 %조사처리(CALLNAME:MASTER,"의")% 무릎을 계속 비볐다.
					PRINTFORMW 「왜인지 모르겠어…… 원래도 더운데, 이렇게 안고 있으면 더 뜨거워지잖아… 음으… 릴리 화이트에게 키스해 주면 안 될까? 아니면 %UNICODE(0x2665)%……」
					PRINTFORMDW 고개를 들어 %조사처리(CALLNAME:MASTER,"를")% 바라보는 릴리 화이트가 웃었다. 순수했던 미소에 지금은 약간의 색기가 더해져 있었다.
					PRINTFORMW 「릴리 화이트는 %조사처리(CALLNAME:MASTER,"의")% 사랑이 필요해…… 분명 릴리 화이트는 이미 만족하고 있는데, 몸은 이렇게 %조사처리(CALLNAME:MASTER,"를")% 갈망하고 있거든…… %UNICODE(0x2665)%」
					PRINTFORMDW 이 봄빛에 감염된 듯, %조사처리(CALLNAME:MASTER,"의")% 손도 불안하게 움직이며 릴리 화이트의 몸을 쓰다듬기 시작했다.
				CASE 2
					PRINTFORMW 「%CALLNAME:MASTER%……좋아해, 좋아해애……헤헤……」
					PRINTFORMDW 릴리 화이트는 %조사처리(CALLNAME:MASTER,"에게")% 안긴 채 행복한 표정을 짓고 있었지만, 평소보다 숨이 훨씬 가빠졌고 볼은 홍조로 물들어 있었다.
					PRINTFORMDW '나도 좋아해'라고 답하자 소녀는 기분 좋게 눈을 감고 서로를 끌어안는 순간을 만끽했다.
					PRINTFORMW 「그럼……%CALLNAME:MASTER%……릴리 화이트를 범해도 될까? 릴리 화이트 몸이 너무 뜨거워서 더는 참을 수가 없어 %UNICODE(0x2665)% 이대로 계속 있으면 머릿속이 온통 봄으로 가득 차버릴 것 같아……%UNICODE(0x2665)%」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 달아오른 릴리 화이트의 봄 같은 숨결을 느끼며 고개를 끄덕였다.
					PRINTFORMW 「정말 기뻐요 %UNICODE(0x2665)%…… 그 후에는 %조사처리(CALLNAME:MASTER,"가")% 좋아하는 대로 릴리 화이트를 범해줘? 그렇지 않으면 릴리 화이트 정말 온통 봄 생각만 하는 요정이 되어버릴 거야……」
				CASEELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 릴리 화이트를 좀 더 높이 안아줘? 헤헤... 이대로, 츄릅... 하무... %UNICODE(0x2665)%」
					PRINTFORMDW 릴리 화이트가 갑자기 키스해왔고, 혀가 탐욕스럽게 갈망하며 두 사람은 그렇게 한참 동안 혀를 얽은 후에야 입술을 떼었다.
					PRINTFORMW 「푸하... 하아, 정말 맛있어 %CALLNAME:MASTER%. 지금 릴리 화이트의 기분이 잘 전달되었어?」
					PRINTFORMDW 릴리 화이트의 얼굴에 떠오른 홍조를 바라보고 그녀의 뜨거운 숨결을 느끼며, %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕였다.
					PRINTFORMW 「역시 %조사처리(CALLNAME:MASTER,"는")% 릴리 화이트를 이해해 주시는구나... 그럼, 이제부터 릴리 화이트를 잘 아껴줄게? %UNICODE(0x2665)%」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「릴리 화이트는 안아주고 싶어…… 헤헤, %CALLNAME:MASTER%~」
					PRINTFORMDW 릴리 화이트가 부드럽게 %조사처리(CALLNAME:MASTER,"의")% 목을 감싸 안고, %조사처리(CALLNAME:MASTER,"의")% 귓가에 나지막하게 속삭인다.
					PRINTFORMW 「릴리 화이트는 어디 가지 않을 거야…… %조사처리(CALLNAME:MASTER,"는")% 오직 릴리 화이트만의 봄이니까, 릴리 화이트는 언제나 %조사처리(CALLNAME:MASTER,"와")% 함께 할 거야…」
					PRINTFORMW 「영원히…… 둘이 같이 있을래. 영원히…」
					PRINTFORMW 「릴리 화이트의 사랑은 자연이 완전히 시들어 죽을 때까지 끝나지 않을 거야… 서로를 그리워하고 사랑하는 두 사람은 영원히 함께 할 테니까…」
				CASE 2
					PRINTFORMDW 릴리 화이트에게 로맨틱한 공주 안기를 해주었지만, 릴리 화이트는 너무 작아서 겨우 공주 안기 같은 자세를 취할 수 있었다.
					PRINTFORMW 「앗… 아, 이래서 그래! 릴리 화이트가 그림책에서 본 포즈거든!」
					PRINTFORMW 「그런데 있잖아, 그 그림책 속의 공주는…… 정략결혼을 위해 희생된 거였대.」
					PRINTFORMDW 대체 어떤 이상한 그림책에 이런 기묘한 스토리가 있는 거야?!
					PRINTFORMW 「하지만 릴리 화이트는 그 공주랑은 달라… %조사처리(CALLNAME:MASTER,"가")% 언제나 소중하게 대해줄 테니까!」
					PRINTFORMDW 릴리 화이트는 미소 지으며 손을 %조사처리(CALLNAME:MASTER,"의")% 뺨에 올리고 애틋하게 바라보았다.
				CASE 3
					PRINTFORMW 「%CALLNAME:MASTER%, 릴리 화이트를 더 높이 안아줘! 하야... 에헤헤... 이렇게 하면 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 볼 수 있겠지~ 쪽~」
					PRINTFORMDW 높이 안긴 릴리 화이트는 기쁘게 %조사처리(CALLNAME:MASTER,"의")% 뺨에 입을 맞춘 뒤, 행복하게 웃음을 터뜨렸다.
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 정말로 릴리 화이트를 소중히 여겨주는 게 느껴져... 릴리 화이트는 아주 기뻐요, 사랑하는 사람과 함께 있는 이 느낌이 바로 이런 거겠죠」
					PRINTFORMDW 릴리 화이트는 작은 손으로 %조사처리(CALLNAME:MASTER,"의")% 목을 꼭 감싸 안으며 행복하게 기대왔다.
				CASEELSE
					PRINTFORMDW 릴리 화이트는 안아주면서 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 입을 맞추었다.
					PRINTFORMW 「헤헤헤, %CALLNAME:MASTER%…… 제일 좋아해……」
					PRINTFORMW 「게다가 릴리 화이트가 작하니까 %조사처리(CALLNAME:MASTER,"는")% 안고 걸어 다닐 수 있잖아!」
					PRINTFORMW 「흥흥흥, 다른 여자애들은 할 수 있을까! 이건 가볍고 작은 요정의 특권이야!」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 다른 어린 소녀들도 그럴 수 있지 않을까 생각했지만, 그래도 릴리 화이트의 말에 동조했다.
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……뜨거우니까 잠깐만 할 수 있어?」
			PRINTFORMDW 릴리 화이트는 %조사처리(CALLNAME:MASTER,"에게")% 잠시 안겨 있었다.
			PRINTFORMW 「시간 다 됐어… 이제 그만해야지!」
			PRINTFORMDW 릴리 화이트는 %조사처리(CALLNAME:MASTER,"의")% 머리를 두드리며 손을 놓아달라고 한다.
			PRINTFORMDW (분명 전에는 아무 느낌도 없었는데…… 왜 지금 릴리 화이트 마음속 감정이 이렇게 격렬하게 샘솟고 있는 걸까……)
		ELSEIF RAND:2 == 0
			PRINTFORMDW 릴리 화이트는 귀를 %조사처리(CALLNAME:MASTER,"의")% 가슴에 기대고 눈을 감았다.
			PRINTFORMW 「……%CALLNAME:MASTER%심장 소리가 들려요. 두근두근 뛰는 게。」
			PRINTFORMW 「릴리 화이트랑 똑같은 소리인데…… 왜 듣고 있으면 마음이 점점 더 초조해지는 걸까…?」
		ELSE
			PRINTFORMW 「어라, 이런 방식으로는 안 된다... 놓아줘!」
			PRINTFORMDW 방금 릴리 화이트를 잠시 안았더니, 릴리 화이트가 날갯짓으로 항의했고 당신은 결국 손을 놓았다.
			PRINTFORMDW (야... 잠깐 안았을 뿐인데, 왜 릴리 화이트는 이상함을 느끼는 걸까...)
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「제대로 안아줘야 해, 릴리 화이트 날개까지 같이 안 들지 마... 부러질지도 몰라!」
			PRINTFORMDW 릴리 화이트는 솔직하게 당신의 포옹을 받아들인다.
			PRINTFORMW 「정말 따뜻해... 게다가 몸이 엄청 크고, 마치 난 단디에 있는 것 같은 기분이야...」
		ELSEIF RAND:2 == 0
			PRINTFORMDW 너는 살며시 릴리 화이트를 끌어안았다. 부드러운 몸의 감촉과 온기, 그리고 두 사람의 숨소리가 희미하게 느껴졌다.
			PRINTFORMDW 이렇게 릴리 화이트의 작은 가슴을 즐기는 것도 나쁘지 않다.
			PRINTFORMW 「그, 그게 무슨 일이야~? 이제 놓아줄 수 있어~?」
		ELSE
			PRINTFORMW 「꺄아...!」
			PRINTFORMDW 릴리 화이트의 몸은 매우 가늘어서 마치 연약한 꽃다발을 안고 있는 듯, 조금만 힘을 주어도 그 꽃다발이 부러질 것 같았다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 아주 약한 힘으로 상냥하게 릴리 화이트를 끌어안았다.
			PRINTFORMW 「이렇게 있으니…… 릴리 화이트 별로 싫지 않네…….」
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「저, 저기…… 뭔가 작은 검한테 안겼을 때랑은 다르게 기분이 이상해……」
			PRINTFORMW 「그냥 놓는 게 좋을 거야…… 우리 아직 그렇게 가깝지도 않은데, 이래서 너무 이상하잖아……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「우으...!」
			PRINTFORMDW 릴리 화이트는 힘들어하며 %조사처리(CALLNAME:MASTER,"를")% 저항하고 있다.
			PRINTFORMW 「저기... 우리 요정들은 너무 연약해서 그렇게 세게 안으면 안 되는데...!」
			PRINTFORMW 「그러니까, 부드럽게 안아줘야 해...」
		ELSE
			PRINTFORMW 「안 돼욧! 갑자기 안는 건 싫어요!」
			PRINTFORMDW 릴리 화이트가 두 손을 뻗어 %조사처리(CALLNAME:MASTER,"를")% 애써 밀어냈다.
			PRINTFORMW 「허락도 없이 이러면, 정말 화날 거예요!」
		ENDIF
	ELSE
		PRINTFORMW 「으읍... 제발 놓아줘... 부서질 것 같아...」
		PRINTFORMDW 릴리 화이트는 고통에 몸부림치며 %조사처리(CALLNAME:MASTER,"를")% 밀어낸다.
	ENDIF
ENDIF
RETURN 1
