@M_KOJO_tokicoli_MESSAGE_COM_K18_65
CALL M_KOJO_tokicoli_MESSAGE_COM_K18_65_1
RETURN RESULT

@M_KOJO_tokicoli_MESSAGE_COM_K18_65_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:100 == PLAYER;挿入継続
		;時姦中
		IF FLAG:70
			PRINTFORMDW
		ELSEIF NOWEX:PLAYER:11
			;今射精した现在就要射精了
		ELSEIF TCVAR:102
			;前回射精刚刚射精完毕继续插入
			IF TALENT:恋慕
				SELECTCASE RAND:2
					CASE 1
						SELECTCASE EXP:TARGET:子宮口開発経験
							CASE IS > 50;被完全開发了
								PRINTFORMDW   마치 주입되는 정액을 전부 자궁 속으로 밀어 넣으려는 듯 멈추지 않고 위로 박아 올리며, 릴리 화이트는 침을 흘리고 가쁜 숨을 몰아쉬며 허리를 비틀어 당신의 동작에 맞춘다.
								PRINTFORMDW   전에는 자궁구가 건드려질까 봐 많이 무서워했는데, 지금은 완전히 그 기쁨을 만끽하고 있네.
								CALL HPH_PRINT("「응 아아 후후, 안쪽이 마치 전골처럼 뜨거워, 하지만 너무 좋아, 정말 기분 좋아 아아아 후후」", "W")
