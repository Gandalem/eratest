;====================================================================

@M_KOJO_tokicoli_MESSAGE_COM_K18_64
CALL M_KOJO_tokicoli_MESSAGE_COM_K18_64_1
RETURN RESULT

@M_KOJO_tokicoli_MESSAGE_COM_K18_64_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;調教者が処女
		IF TCVAR:PLAYER:破瓜 == 1
			PRINTFORMDW 
			CALL K18_FIRSTSEEJB
			RETURN 1
		ELSE
			PRINTFORMDW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:PLAYER:100 == TARGET
		;前回射精した
		IF TCVAR:PLAYER:102
			PRINTFORMDW 
			RETURN 1
		ELSE
			PRINTFORMDW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMDW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMDW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMDW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
