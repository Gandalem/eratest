@M_KOJO_tokicoli_MESSAGE_SCOM_K18_6_1
;custom code, moved from M_KOJO_tokicoli_MESSAGE_COM_K18_72
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;说明，在特定体位下莉莉白会喊痛哭起来，而在某些体位则会很舒服，会感到痛的是正常位和背面座位
	IF TALENT:18:恋慕
		IF PREVCOM == 67
			IF !RAND:2
				CALL HPH_PRINT("「으응 HPH 거기가 너무 기분 좋아 HPH%CALLNAME:MASTER%HPH 아아 정말 최고야 HPH 응 아아 HPH 릴리 화이트 바보가 될 것 같아 HPH 음 우우」", "W")
				PRINTFORMDW   민감한 G포인트가 단단한 귀두에 끊임없이 자극당하자 미숙하고 서툰 몸이 파르르 떨리고, 질 내부는 희미하게 경련하며 절정에 이르는 듯한 릴리 화이트.
				PRINTFORMDW   얼굴은 홍조를 띠고 행복한 표정으로 눈물을 흘리는 그녀는 입가에 침을 흘리며 살짝 혀를 내밀었는데, 그 모습이 너무나 색기 넘치게 귀여워 %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 그녀의 달콤한 입술에 입 맞추었다.
				CALL HPH_PRINT("「음찍 후루프후우 음으후루프후우」", "W")
				PRINTFORMDW   릴리 화이트는 아무런 저항 없이 %조사처리(CALLNAME:MASTER,"의")% 혀에 유린당했고, 꽃꿀 같은 타액은 그녀의 부드러운 분홍빛 입술을 놓기 싫게 만들었다.
				PRINTFORMDW   %조사처리(CALLNAME:MASTER,"의")% 혀가 소녀의 작은 향긋한 혀를 감싸 가지고 놀며, 탐욕스럽게 꽃꿀을 빨아들이는 동시에 아래쪽 작은 입안의 진액을 휘저었다.
				CALL HPH_PRINT("「츄릅 HPH즈 츄릅루 HPH푸쯧 HPH 우하, %CALLNAME:MASTER%, 릴리 화이트도 목마르다, 츄릅 HPH퉤 HPH츄릅루 HPH」", "W")
				PRINTFORMDW   지금 릴리 화이트는 마치 설탕 인간처럼 온몸에서 음란한 향기가 풍겼고, 그 달콤한 향은 %조사처리(CALLNAME:MASTER,"가")% 그녀를 더욱 격렬하게 아끼도록 자극했다.
				PRINTFORMDW   탐욕스러운 두 사람은 서로의 타액을 빨아들이며 쾌락을 갈망하는 교합을 이어갔다.
			ELSE
				PRINTFORMDW   파도 같은 쾌감 속에 정신을 놓은 채, 작고 귀가 뾰족한 릴리 화이트는 욕정에 붉게 물들어 끊임없이 달콤한 신음 소리를 내고 있다.
				PRINTFORMDW   푸르고 아름다운 눈에는 즐거움이 가득한 눈물이 고여 있고, 소녀의 몸은 거친 움직임에 따라 계속해서 오르내리며, 매끄러운 살결은 갓 구워낸 하얀 만두처럼 뜨겁고 달콤한 열기를 내뿜는다.
				CALL HPH_PRINT("「응 응 HPH 나니 HPH 좋아 부스러져서 HPH %CALLNAME:MASTER% HPH 너무 좋다 아아 HPH 응 하 HPH 뒤집혀 HPH %CALLNAME:MASTER% HPH 이야아아아 HPH」", "W")
				PRINTFORMDW   꿀 같은 구멍은 녹아내리는 치즈처럼 미끌미끌한 릴리 화이트, 입으로는 발음이 불분명하지만 사랑으로 가득 찬 즐거운 신음을 끊임없이 내뱉었다.
				PRINTFORMDW   내부의 구불구불하게 솟아오른 살점들은 본래 매우 탄력 있고 아름다웠으며, 게다가 매번 자극받을 때 약점이 경련을 일으키며 소녀의 봄 노래는 끝이 없었다.
				PRINTFORMDW   뒤바뀐 부부처럼 서로에게 황홀한 기쁨을 나누고, 아름다운 시간을 함께하며 서로의 사랑을 다 고백하기 전까지 결코 멈추지 않을 것이다.
			ENDIF
		ELSEIF PREVCOM == 60 || PREVCOM == 68
			PRINTFORMW 「아우욱… 아파, 하지만 기분 좋아…… 음하, 우엑…… 싫어, 여전히 너무 아파…… 으윽… %CALLNAME:MASTER%……」
			PRINTFORMDW   약점이 자극당하고 있음에도 날개가 압박되는 통증에 릴리 화이트가 고통스러운 신음을 내뱉는다.
			PRINTFORMW 「이야아… 기분 좋지만, 날개가 너무 아파…… 싫어…… 이런 느낌은, 이상해…… 우아아아! 잠시만요……」
			PRINTFORMDW   눈에는 통증으로 가득 찬 눈물이 고여 있지만 입으로는 계속 뜨거운 숨을 내쉬며 애원하고 있다.
			PRINTFORMW 「싫어…… 음아, 우아, %CALLNAME:MASTER%…… 싫어…… 흐윽… 너무 아파, 싫어…… 응응…… 역시 여전히 너무 아파…… 으윽…」
		ELSE
			;後背位和騎乗位，对面立位和背面立位
			IF !RAND:2
				CALL HPH_PRINT("「하응 흐으 파아 하 응 그곳이 너무 편해 %조사처리(CALLNAME:MASTER,\"가\")% 계속 그곳을 찔러주니까 정말 대단해 아아아 릴리 화이트 너무 좋아아 아아아」", "W")
				PRINTFORMDW   봄의 정열로 들뜬 소녀가 거리낌 없이 애처롭게 울부짖는 소리는 마치 불타오르는 욕망에 기름을 끼얹는 듯, 이 요염한 말들은 활대 운동을 더욱 격렬하게 만들었다.
				CALL HPH_PRINT("「꺄아아흐으!! 흐윽, 이렇게 빨리 하면 안 돼읏, 머리가 어지러워…… 미야오, 더 해줘! 아아앗!」", "W")
				PRINTFORMDW   부드러운 살결의 몸이 박히면서 흔들리고, 달콤한 땀과 진액, 그리고 선액이 뒤섞인 액체가 끊임없이 분수처럼 흩뿌려지며 시트 위에 얼룩을 만들었다.
				CALL HPH_PRINT("「이야아아아앙! 흐응, 아아아... 너무 격렬한데... 하지만 기분 좋아... 이야아아... 좋아, 좋아해 %CALLNAME:MASTER%! %CALLNAME:MASTER%어!!」", "W")
				PRINTFORMDW   서로 몸을 단단히 맞댄 두 사람은 이미 넋을 놓은 경지에 빠져, 그저 본능에 이끌려 육체의 쾌락을 탐하고 있다.
			ELSE
				SETCOLOR C_RED
				PRINTFORMW 「…」
				RESETCOLOR
				PRINTFORMDW   
				PRINTFORMDW   
				PRINTFORMDW   
				PRINTFORMDW   
				PRINTFORMDW   
			ENDIF
		ENDIF
	ELSE
		;思慕及以下
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「싫어… 왜, 하기 싫은데, 응아, 그런데 거기, 너무 기분 좋아, 우아아!」
				PRINTFORMDW   귀두를 릴리 화이트의 민감한 G포인트에 대고 거칠게 휘저었다. 만 번이라도 싫다고 해도 몸은 솔직하니까.
				PRINTFORMW 「우, 릴리 화이트… 전혀 기분 좋은 것 같은 게 아니야… 응아, 하아, 왜… 으응, 그만해줘, 멈춰줘아아」
				PRINTFORMDW   릴리 화이트가 당황한 틈을 타 약점을 거칠게 자극하자 저항하던 릴리 화이트도 즐거움을 느끼며 나지막이 신음하기 시작했다.
				PRINTFORMW 「릴리 화이트, 난 봄의 정령 같은 게 아니라고… 우이… 분명 네가 무슨 짓을 한 거야… 야아, 싫어, 거기 더 이상 하지 마, 아아아」
				PRINTFORMDW   릴리 화이트의 애원에도 아랑곳하지 않고 %조사처리(CALLNAME:MASTER,"는")% G포인트를 계속 농락하며 암컷의 쾌감을 조금씩 릴리 화이트의 몸에 새겼다.
			CASE 1
				PRINTFORMW 「우아… 거긴 안 돼, 이야아, 멈춰, 그만둬… 응아, 릴리 화이트, 이상해지고 있어, 멈춰, 제발 멈춰요…」
				PRINTFORMDW   성교에 여전히 저항하던 릴리 화이트가 약점을 건드려 무너지자, 결국 행복을 거부하지 못하는 듯하다.
				PRINTFORMW 「말도 안 돼, 릴리 화이트는 본능적으로 좋아해야 하는 거야… 아니야, 아응, 이런 걸 싫어해, 후아, 멈춰, 릴리 화이트, 응아, 원치 않아!」
				PRINTFORMDW   분명 봄을 부르는 정령임에도 입만 번지르르한 %조사처리(CALLNAME:MASTER,"가")% G 포인트를 세게 자극하자 릴리 화이트는 더 이상 반박할 말을 찾지 못한다.
				PRINTFORMW 「릴리, 응… 아니야, 이야아… 좋아해… 응아… 안이야, 아아아!」
				PRINTFORMDW   소리 내어 저항조차 하지 못하는 릴리 화이트는 그저 울면서 행복에 몸을 맡기고 조금씩 여성으로서의 본능이 발굴된다.
			CASE 0
				PRINTFORMW 「나쁜 사람, 그만둬… 응하아악, 거기가 왜…… 으윽, 싫어, 거기 만지지 마, 왜 이래, 분명 정말 싫다고 했는데, 아아아악!」
				PRINTFORMDW   비록 입으로는 싫다고 하지만, 만져지는 곳에서 즐거움을 느끼며 신음하는 모습은 역시 매춘부답다.
				PRINTFORMW 「릴리 화이트, 응하… 아니야, 무슨 매춘이라고, 아아아악, 그만해, 그만해, 싫어, 원치 않아!」
				PRINTFORMDW   필사적으로 저항하고 있음에도 취약한 부위에서 느끼는 즐거움은 몸이 솔직하게 신음을 터뜨리게 만든다.
				PRINTFORMW 「흐윽… 응하, 왜… 응하, 아응, 싫어… 흐윽, 싫어… 응하, 아아아악」
				PRINTFORMDW   울고 있는 릴리 화이트는 강제로 소녀의 쾌락을 경험하고 있으며, 그 눈물은 곧 황홀경의 눈물이 될 것이다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
