@M_KOJO_MESSAGE_COUNTER_MESSAGECHECK_K49_1
RETURN 1

@M_KOJO_MESSAGE_COUNTER_K49_1
SIF GETBIT (CFLAG:1490,0) && !TALENT:恋慕 && !TALENT:恋人
	RETURN 0
IF SELECTCOM == 312 && GET_TARGETNUM() == 1
	CALL UFUFUTO49(1)
ELSE
	CALL EVENT_COUNTER_MESSAGE
	CALL 発情地の文(1)
	CALL M_KOJO_MESSAGE_COUNTER_K49_1_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K49_1_1
IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
	CALL DRUNKER49(300)
ELSEIF GROUPMATCH(SELECTCOM,310,311,313,314,315,316,330) && GET_TARGETNUM() == 1
	CALL UFUFUTO49(1)
ELSEIF 陥落状態() >= 4
	IF 陥落状態() == 5
		PRINTFORML 「주님, 주님, 정말 좋아해요~ 정말 좋아해요~」
		PRINTFORML 「『기뻐 보이세요』? 아니에요, 기쁘답니다~」
		PRINTFORMW 「『그에 비해 멀다니』? 후후, 가끔은 주님의 고귀한 얼굴을 보고 싶으니까요~」
	ELSE
		PRINTFORML 「후후, 주님 좋아해요」
		PRINTFORML 「『가깝지 않나』? 후후, 가끔은 괜찮지 않습니까?」
		PRINTFORMW 「아니면 꼭 붙어 있는 편이 좋은가요?」
	ENDIF
ELSEIF 陥落状態() == 3
	PRINTFORML 「『미묘한 거리네』? 후후, 글쎄 어떨지 모르겠네요」
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 그렇게 생각한다면 그런 것일지도 모르겠지만」
ELSEIF 陥落状態() == 1
	PRINTFORMW 「후후, 뭐, 가끔은 이렇게 하는 것도 좋잖아?」
ELSE
	PRINTFORMW 「아아, 신경 쓰지 말아 주세요. %CALLNAME:MASTER%풍으로 말하자면, 그저 변덕일 뿐이니까」
ENDIF
RETURN 1
