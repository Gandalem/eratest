;-------------------------------------------

@陥落状態(ARG)
#FUNCTION
SIF !ARG
	ARG = TARGET
IF TALENT:ARG:恋人
	;さとり甘えんぼモードor咲夜少女恋人モード
	IF CFLAG:ARG:清い交際 && ((ARG == 49 && (GETBIT (CFLAG:ARG:1490,6))) || (ARG == 15 && CFLAG:ARG:口上セレクタ == 1 && !CFLAG:ARG:1151) || (ARG != 49 && (ARG != 15 || (ARG == 15 && CFLAG:ARG:口上セレクタ != 1))))
		RETURNF 5
		;通常恋人
	ELSE
		RETURNF 4
	ENDIF
	;恋慕orセフレor愛人or咲夜時姦バレ＋思慕
ELSEIF TALENT:ARG:恋慕 || TALENT:ARG:184 || TALENT:ARG:185 || (ARG == 15 && CFLAG:ARG:口上セレクタ == 1 && GETBIT(CFLAG:ARG:1151,0) && TALENT:ARG:思慕)
	RETURNF 3
	;妹紅合意orさとり家族時姦
ELSEIF (ARG == 49 && GETBIT (CFLAG:ARG:1490,0)) || (ARG == 61 && GETBIT (CFLAG:ARG:1 ,1))
	RETURNF 2
	;通常思慕or妹紅以外合意or咲夜時姦バレorさとり思慕＆時姦なし
ELSEIF ((GETBIT (CFLAG:ARG:1 ,1) && ARG != 61) || (ARG == 15 && CFLAG:ARG:口上セレクタ == 1 && GETBIT(CFLAG:ARG:1151,0)) || TALENT:ARG:思慕) && ((!GETBIT (CFLAG:ARG:1490,1) && ARG == 49) || ARG != 49)
	RETURNF 1
ENDIF
