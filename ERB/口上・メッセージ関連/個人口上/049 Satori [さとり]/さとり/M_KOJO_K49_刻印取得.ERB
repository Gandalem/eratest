; Modular ERB: 個人口上/049 Satori [さとり]/さとり/M_KOJO_K49_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K49
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
IF !FLAG:70
	;苦痛刻印
	IF TFLAG:22 == 1
		PRINTFORMW 「……'괴롭기 힘들겠지'? 그렇게 괴롭히는 게 즐거우신가요」
	ELSEIF TFLAG:22 == 2
		PRINTFORMW 「크윽…… 이, …… 아파아……」
	ELSEIF TFLAG:22 == 3
		PRINTFORMW 「헉! 아니, 이제 싫어요……」
	ENDIF
	;快楽刻印
	IF TFLAG:23 == 1
		IF 陥落状態() == 3 || 陥落状態() == 1
			PRINTFORMW 「야, 이런 거, 부끄러워…… 음크으……」
		ELSE
			PRINTFORMW 「흐읍! 그, 그게, 이런 걸 기분 좋게 한다니……」
		ENDIF
	ELSEIF TFLAG:23 == 2
		IF 陥落状態() == 3 || 陥落状態() == 1
			PRINTFORMW 「응!? 아, 저기 그, 기분 좋아요」
		ELSE
			PRINTFORMW 「아흣, 음큐우…… '기분 좋아 보여'? 그, 그렇지 않을까요...」
		ENDIF
	ELSEIF TFLAG:23 == 3
		PRINTFORMW 「흐윽! 아, 하아앗! 좋아, 기분 좋아요읏!!」
	ENDIF
	;不埒刻印
	;快楽による刻印
	;LV1
	IF TFLAG:24 == 11
		PRINTFORMW 「캬앙…… 『귀여운 목소리네』…… 조용히 해주세요」
		;LV2
	ELSEIF TFLAG:24 == 12
		PRINTFORMW 「힉, ……『더 원하는 건가』? 그, 그런 건……」
		;LV3
	ELSEIF TFLAG:24 == 13
		PRINTFORMW 「응쿠우…… 모, 더, 더 갖고 싶어요…」
		;屈服、恭順による刻印
		;LV1
	ELSEIF TFLAG:24 == 31
		PRINTFORMW 「……이건, 기척의 착각, 망설임이었으니까」
		;LV2
	ELSEIF TFLAG:24 == 32
		PRINTFORMW 「……이런, 육욕의 화신에게 이런 감정을 품고 있다니」
		;LV3
	ELSEIF TFLAG:24 == 33
		PRINTFORMW 「……후후, 이제 안 돼버렸네. 이런 기분이 들다니」
	ENDIF
	;反発刻印
	IF TFLAG:21 == 1
		PRINTFORMDW 차가운 눈의 사토리에게, %조사처리(CALLNAME:MASTER,"의")% 이마에 식은땀이 흘렀다.
	ELSEIF TFLAG:21 == 2
		PRINTFORMDW 엄청난 압박감을 내뿜는 사토리에게, %조사처리(CALLNAME:MASTER,"는")% 등줄기에 식은땀을 흘린다.
	ELSEIF TFLAG:21 == 3
		PRINTFORMDW 사토리의 얼음장 같은 표정에, 총털이 설 정도의 공포를 느끼는 %CALLNAME:MASTER%였다.
	ENDIF
ENDIF
