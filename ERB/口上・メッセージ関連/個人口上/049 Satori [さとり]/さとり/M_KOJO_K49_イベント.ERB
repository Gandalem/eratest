	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
			CALL DRUNKER49(41)
		ELSEIF GETBIT (CFLAG:1491,1) || GETBIT (CFLAG:1491,0)
			IF 陥落状態() >= 4
				PRINTFORML 「아, 잠시만요 주님, 말씀이」
				PRINTFORMDL 말을 걸어오는 사토리에게, %조사처리(CALLNAME:MASTER,"는")% 다시 나중에 말하겠다고 하면서 걸어간다.
			ELSE
				PRINTFORML 「기다려 봐, 할 말이 있어」
				PRINTFORMDL 차가운 눈으로 자신을 응시하는 사토리를 향해, %조사처리(CALLNAME:MASTER,"는")% 등을 돌렸다.
			ENDIF
		ELSEIF 陥落状態() >= 4
			IF 陥落状態() == 5
				PRINTFORML 「아, 주님. 가버릴 것 같아요」
				PRINTFORMDL 말하기도 전에 사토리가 꽉 안고 얼굴을 파묻는다
				PRINTFORML 「저보다 중요한 일이라니, 세상 어디 찾아봐도 없잖아요?」
				PRINTFORMDL 사토리의 말에, 중요한 일은 없지만 필요한 일은 있다고 대답하는 %CALLNAME:MASTER%
				PRINTFORML 「음~ 주님의 나쁜 마음」
				PRINTFORMDL 입술을 삐죽 내민 사토리의 머리를 부드럽게 쓰다듬으며 구속에서 벗어났다
			ELSE
				PRINTFORML 「아, 주님. ……유감입니다. 저보다 목적지로 가는 것이 더 소중한가요」
				PRINTFORMDL 그런 때도 있다고 대답하기 전에, 사토리가 스르륵 몸을 바짝 붙인다
				PRINTFORML 「정말 유감이에요. 그러니 조금만 맛보겠습니다」
				PRINTFORMDL 말을 마치기도 전에 입술이 겹쳐왔다
				PRINTFORML 「……만지는 것만으로는 부족해? 그렇게 만든 건 주님이잖아요」
				PRINTFORMDL 그 속삭임에 흥분한 것을 느낀 %CALLNAME:MASTER%였지만, 마지못해 자리를 떠났다
			ENDIF
		ELSEIF 陥落状態() == 3
			PRINTFORML 「아아, 급한 용무인가요. 어쩔 수 없겠네요」
			PRINTFORMDL 쿨쿨 웃으며 사토리가 치마 끝을 집어 살짝 위로 들어 올렸다
			PRINTFORML 「후후, 다녀오세요. 저는 언제든지 괜찮으니까요」
			PRINTFORMDL 언뜻언뜻, 들어 올린 치마 자락 사이로 보이는 그것에 욕정을 느꼈다
		ELSEIF 陥落状態() == 2
			PRINTFORML 「…………변」
			PRINTFORMDL 불쾌한 표정의 사토리가 시선을 돌린다.
			PRINTFORML 「뭘 보고 있는 거예요? 어서 가시면 안 돼요?」
			PRINTFORMDL 시간을 멈추고 괴롭히려고 생각했던 것을 읽혔는지, 식은땀을 흘리며 %조사처리(CALLNAME:MASTER,"는")% 걸음을 옮겼다.
		ELSEIF 陥落状態() == 1
			PRINTFORML 「안녕하세요, 조심해서 다녀오세요」
			PRINTFORMDL 상냥하게 웃는 사토리를 향해 고개를 숙이고 %조사처리(CALLNAME:MASTER,"는")% 걸음을 옮겼다.
		ELSE
			PRINTFORML 「…………」
			PRINTFORMDL 내가 목례를 해도 사토리의 차가운 표정에는 변화가 없었다.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SIF FLAG:時間停止 ;fix
			RETURN 1
