; Modular ERB: 個人口上/049 Satori [さとり]/さとり/M_KOJO_K49_依頼.ERB

@M_KOJO_IRAI_K49(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS BOOK_NAME;本の名称
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				CASE "一般依頼名"
					SELECTCASE SCENE
						CASE "依頼提示時"
							;依頼を持ちかけられる時
						CASE "依頼非受託時"
							;内容だけ見て受託しなかった時
						CASE "依頼受託時"
							;依頼を受託した時
						CASE "依頼確認時"
							;[366]で依頼内容を依頼人に確認した時
						CASE "依頼破棄時"
							;受託した依頼を破棄する時
						CASE "依頼実行直前"
							;[367]で依頼を実行する時、実行処理の前に呼び出される
						CASE "依頼実行直後"
							;[367]で依頼を実行する時、実行処理の後に呼び出される
						CASE "成功報告時"
							;報告時（成功）
						CASE "失敗報告時"
							;報告時（失敗）
							;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		;固有依頼
		;個々の依頼名で分岐
		;SCENEのWAITに関する仕様
		;WAIT無しでよい　　　　："依頼提示時", "依頼非受託時", "依頼確認時", "依頼破棄時", "成功報告時", "失敗報告時"
		;
		;以下の2つは実際にはCARRYOUTでの地の文処理との比較検討が必要
		;WAITを入れたほうが適切："依頼実行直前", "依頼実行直後"
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			CASE "参考文献"
				SELECTCASE SCENE
					;依頼を持ちかけられる時
					CASE "依頼提示時"
						SIF BOOK_NAME == ""
							BOOK_NAME = %BOOKSNAME_49()%
						IF 陥落状態() >= 4
							PRINTFORML 「주인님, 저 조금 부탁드려도 될까요?」
							PRINTFORML 「%BOOK_NAME%를 찾아서 빌려다 주실 수 있나요?」
							PRINTFORML 「이전에 환상향에도 들어왔다고 들었으니까요.」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「……아, 딱 잘됐네요. %CALLNAME:MASTER%라면 %BOOK_NAME%를 찾아낼 수 있겠죠」
							PRINTFORML 「'모르겠다'? 겸손 같은 건, %조사처리(CALLNAME:MASTER,"에게")% 어울리지 않습니다」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「이쪽 상황, 등을 돌릴 수 없는 일이네요」
							PRINTFORML 「…… %BOOK_NAME%를 찾아와 주셨으면 해요」
						ELSE
							PRINTFORML 「저기요, %BOOK_NAME%를 찾아다 주실 수 있나요?」
						ENDIF
						;内容だけ見て受託しなかった時
					CASE "依頼非受託時"
						IF 陥落状態() >= 4
							PRINTFORML 「주인님도 바쁘시니까, 어쩔 수 없죠」
							PRINTFORML 「……주인님도 바쁘시고」
							PRINTFORML 「『뭐라고 하고 싶은 건데』? 아니에요, 딱히 할 말은 없어요」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「『찾을 자신이 없어』? 그렇다면 어쩔 수 없네요」
							PRINTFORML 「%CALLNAME:MASTER%라면, 하고 생각했는데」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「이 정도의 일이 무리인가? 후훗, 결국 비겁한 자인 모양이군요.」
							PRINTFORML 「『그 비겁자에게 의지하려 했다니』? 일부러 일을 마련해 준 것뿐입니다.」
						ELSE
							PRINTFORML 「그렇군요, 그럼 어쩔 수 없네요」
						ENDIF
						;依頼を受託した時
					CASE "依頼受託時"
						IF 陥落状態() >= 4
							PRINTFORML 「다행이다, 감사합니다 주님」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「감사합니다, 부탁드릴게요」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「변, 이 정도는 즉시 끝낼 수 있겠지」
						ELSE
							PRINTFORML 「잘 부탁드립니다」
						ENDIF
						;[366]で依頼内容を依頼人に確認した時
					CASE "依頼確認時"
						IF 陥落状態() >= 4
							PRINTFORML 「찾아줬으면 하는 건, %BOOK_NAME%예요. 주님, 잊지 말아 주세요네」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「%BOOK_NAME%를 부탁해요. 다른 책을 가져오면 곤란하니까」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「%BOOK_NAME%라고 말했잖아요. 그 귀는 장식이에요?」
						ELSE
							PRINTFORML 「%BOOK_NAME%를 찾아주세요. 부탁이에요」
						ENDIF
						;受託した依頼を破棄する時
					CASE "依頼破棄時"
						IF 陥落状態() >= 4
							PRINTFORML 「……주님이라도, 못 하는 일 같은 게 있었네요」
							PRINTFORML 「『그냥 변덕』? 기대하고 있었는데 말이야」
							PRINTFORML 「기대했는데」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「『찾지 못했다』? 찾으려고 하지 않았던 게 잘못 아닐까?」
							PRINTFORML 「하지만 뭐, 어쩔 수 없죠. …… 오린을 달릴까요」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「『やる気が起きない』？　たんに見つけられない無能の言い訳でしょう」
							PRINTFORML 「まあ、%CALLNAME:MASTER%のような無能に頼んだ私がバカでした」
						ELSE
							PRINTFORML 「'이번엔 포기해라'? ……뭐, 어쩔 수 없네요」
						ENDIF
						;[367]で依頼を実行する時、実行処理の前に呼び出される
					CASE "依頼実行直前"
						IF 陥落状態() >= 4
							PRINTFORML 「『여기까지 왔다면 스스로 얻는 게 빠르지 않을까』? 그 말이 맞지만 말이죠」
							PRINTFORML 「그래도, 주님께 받는 게 즐거우니까요」
							PRINTFORML 「게다가, 주님에게도 이득이 될 테고요?」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「『왜 스스로 빌리지 않느냐』? 그것은 변덕이기 때문이다.」
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 행동을 보는 것이 재미있기 때문이다.」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「‘이 지경까지 왔으면 스스로 해’라고, 당신이 사람을 끌어들인 주제에!」
							PRINTFORML 「윽! 정말이지, 못하는 거라면 처음부터 받지 말아 주세요」
							PRINTFORML 「‘당신이라니’? ……그 점은 실례했습니다」
						ELSE
							PRINTFORML 「굳이 여기까지 끌고 오다니, %조사처리(CALLNAME:MASTER,"는")% 비뚤어졌네요. 하지만 빌리는 건 %조사처리(CALLNAME:MASTER,"의")% 일이니까요」
						ENDIF
						;[367]で依頼を実行する時、実行処理の後に呼び出される
					CASE "依頼実行直後"
						IF 陥落状態() >= 4
							PRINTFORML 「감사합니다, 주인님. 덕분에 %BOOK_NAME%를 읽을 수 있게 됐어요」
							PRINTFORML 「……하지만, 굳이 저를 여기까지 끌고 오지 않아도 괜찮았을 텐데」
							PRINTFORML 「『그저 변덕』이라고요? 정말이지 주인님이라는 분은」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「고마워요. 그보다, 밖에 나가는 게 싫어서 %조사처리(CALLNAME:MASTER,"에게")% 부탁한 건데」
							PRINTFORML 「『가끔은 괜찮겠지』? 가끔이요. 그래도 %BOOK_NAME%를 읽을 수 있어서 기뻐요」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「정말…… 부탁한 건 가져와 달라는 거지, 눈앞에서 하라고 한 게 아니에요」
							PRINTFORML 「『가끔은 운동해』? 사람은 아니니까 살도 안 찌고 빠지지도 않아요」
						ELSE
							PRINTFORML 「%BOOK_NAME%를 손에 넣게 된 것은 감사하지만, 다음부터는 혼자 움직여 주세요네」
						ENDIF
						BOOK_NAME =
						;報告時（成功）
					CASE "成功報告時"
						IF BOOK_NAME == ""
							IF 陥落状態() == 2
								PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")% 부탁하는 건 시간과 돈 낭비였네요」
							ELSE
								PRINTFORML 「감사했습니다」
							ENDIF
						ELSEIF 陥落状態() >= 4
							PRINTFORML 「주인님, 제대로 가져와 주셔서 감사합니다」
							PRINTFORML 「%BOOK_NAME%, 두면 잘 보관하는 곳이 있군요」
							PRINTFORML 「이걸로 일이 잘 풀리겠네요…… '그것'이라니? 아뇨아뇨, 아무것도 아니에요」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「감사합니다. ……%BOOK_NAME%가 정말 손에 들어오다니」
							PRINTFORML 「『있을지 없을지 모르는 것을 찾게 한 건가』? 아, 아니 그 자체는 알고 있었습니다만」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「느려. %조사처리(CALLNAME:MASTER,"의")% 능력은 장식품인가요?」
							PRINTFORML 「『가져다 주었잖아』? 받아들인 것을 하는 건 당연한 거 아닐까요」
						ELSE
							PRINTFORML 「감사합니다, 덕분에 살았어요」
						ENDIF
						BOOK_NAME =
						;報告時（失敗）
						;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					CASE "失敗報告時"
						IF 陥落状態() >= 4
							PRINTFORML 「……주님? 제가 부탁드린 건 잊으셔도 상관없는 사소한 일인가요?」
							PRINTFORML 「『그렇지 않아』? 실제로는 가져오지 않으셨잖아요」
							PRINTFORML 「하아…… 주님은 바보시네」
						ELSEIF 陥落状態() == 3
							PRINTFORML 「……약속 정도는 지켜 주시면 안 될까요?」
							PRINTFORML 「『가끔은 잊을 일도 있겠지』? ……하아, 이제 됐습니다.」
						ELSEIF 陥落状態() == 2
							PRINTFORML 「역시 쓸모가 없었네. 제대로 일도 못 하는 주제에, 그걸로 어떻게 살아가는 거지」
							PRINTFORML 「『때를 가르쳐주지』? 마음대로 해 보시지. 그저 짜증을 푸는 데 성교라니 바보에게도 정도가 있긴 하다만」
						ELSE
							PRINTFORML 「못 할 거면 처음부터 받지 마세요」
						ENDIF
						BOOK_NAME =
				ENDSELECT
			CASE "図書の返却（人里）","図書の返却（紅魔館）"
				SELECTCASE SCENE
					;依頼を持ちかけられる時
					CASE "依頼提示時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;内容だけ見て受託しなかった時
					CASE "依頼非受託時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;依頼を受託した時
					CASE "依頼受託時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;[366]で依頼内容を依頼人に確認した時
					CASE "依頼確認時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;受託した依頼を破棄する時
					CASE "依頼破棄時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;[367]で依頼を実行する時、実行処理の前に呼び出される
					CASE "依頼実行直前"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;[367]で依頼を実行する時、実行処理の後に呼び出される
					CASE "依頼実行直後"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;報告時（成功）
					CASE "成功報告時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
						;報告時（失敗）
						;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					CASE "失敗報告時"
						IF 陥落状態() >= 4
							IF 陥落状態() == 5
							ELSE
							ENDIF
						ELSEIF 陥落状態() == 3
						ELSEIF 陥落状態() == 2
						ELSEIF 陥落状態() == 1
						ELSE
						ENDIF
				ENDSELECT
		ENDSELECT
	CASE "TARGET"
		;ここで表示されるSCENEは"依頼実行直前", "依頼実行直後"だけです
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
					;人物が鍵になっていた・もしくは場所にたまたま居合わせた
					SELECTCASE SCENE
						;TARGETが呼ばれるのはこのタイミングだけ
						CASE "依頼実行直前"
						CASE "依頼実行直後"
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE CSVCALLNAME(CLIENT_ID)
			;依頼者のCALLNAMEによる分岐（CSV準拠）
			CASE "依頼者"
				SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
					CASE "固有依頼名"
						SELECTCASE SCENE
							CASE "依頼実行直前"
							CASE "依頼実行直後"
						ENDSELECT
				ENDSELECT
		ENDSELECT
	CASE "NO_REPORT"
		;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
		;ここで表示されるSCENEは"依頼報告不要"だけです
		;SCENEが一つしか無いので分岐は不要
		;また、必ず依頼主の口上が呼ばれます
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
				CASE "お花に水をあげて"
				CASE "誰かの落とし物"
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			CASE "固有依頼名"
		ENDSELECT
ENDSELECT

@BOOKSNAME_49()
#FUNCTIONS
#DIMS BOOK_NAME
#DIM LOOPCOUNT
#DIM BOOK_NAME_NO
#DIM BOOK_GENRE
SELECTCASE RAND:3
	;文系
	CASE 0
		SELECTCASE RAND:21
			CASE 0
				RETURNF "推理小説四十年史"
			CASE 1
				RETURNF "版画絵贋殺事件"
			CASE 2
				RETURNF "幽霊塔"
			CASE 3
				RETURNF "赤き拇指紋"
			CASE 4
				RETURNF "莫切自根金生木"
			CASE 5
				RETURNF "そしてだれもいなくなるのかー？"
			CASE 6
				RETURNF "画本虫撰"
			CASE 7
				RETURNF "守貞漫稿"
			CASE 8
				RETURNF "荀子"
			CASE 9
				RETURNF "孟子"
			CASE 10
				RETURNF "資治通鑑"
			CASE 11
				RETURNF "塩鉄論"
			CASE 12
				RETURNF "吾妻鏡"
			CASE 13
				RETURNF "類聚国史"
			CASE 14
				RETURNF "医心方"
			CASE 15
				RETURNF "ゴルギアス"
			CASE 16
				RETURNF "縛られたプロメテウス"
			CASE 17
				RETURNF "アンティゴネ（ソポクレス）"
			CASE 18
