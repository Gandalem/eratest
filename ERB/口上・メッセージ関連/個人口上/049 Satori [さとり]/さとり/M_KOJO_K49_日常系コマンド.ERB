@M_KOJO_MESSAGE_COM_K49_309
IF CFLAG:1496 == 2 && !RAND:2
	CALL PET49()
ELSEIF CFLAG:1496 == 1 && !RAND:2
	CALL ONRYO49()
ENDIF
SIF 陥落状態() != 2 || FLAG:70 || CFLAG:TARGET:睡眠 || (BASE:酒気 < (MAXBASE:酒気 / 10) * 4)
	CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K49_309_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K49_309_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		CALL STOP49
	ELSEIF CFLAG:TARGET:睡眠
		SIF 陥落状態() == 2
			CALL TRAIN_MESSAGE
		CALL SLEEP49
	ELSE
		IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
			RESETCOLOR ;custom code
			DRAWLINE
			SIF FLAG:口上色
				CALLFORM M_KOJO_COLOR_K49
			CALL DRUNKER49()
		ELSEIF 陥落状態() >= 4
			IF 陥落状態() == 5
				IF TFLAG:193 == 1
					PRINTFORML 「음~ 주인님, 주인님……」
					PRINTFORMDL 머리를 쓰다듬자마자 꼭 안겨오는 사토리가
					PRINTFORMW 「그만둬주세요, 더 해주세요」
					PRINTFORMDL 잠시 손을 멈췄을 뿐인데 던져진 애원에 자연스럽게 손이 움직인다.
					PRINTFORML 「하아…… 이거, 멋지다…… 응으읏」
					PRINTFORMDW 골골거리는 듯한 소리가 나는 것이 아닌가 착각할 정도로 사토리가 기분 좋게 웃고 있다.
				ELSE
					PRINTFORML 「주님, 이거 정말 멋져요」
					PRINTFORMDL 만족스러운 사토리를 보며 쓴웃음을 짓고, 부드러운 머릿결의 감촉을 즐긴다.
					PRINTFORMW 「『어째서 이렇게 윤기가 나는 걸까』? 후후, 주님을 위해 갈아왔으니까요」
					PRINTFORMDL 승리감에 찬 표정의 사토리가 가볍게 몸을 숙여 스스로 머리를 밀어붙인다.
					PRINTFORML 「저기 주님, 더 해주세요, 부탁이에요」
					PRINTFORMDW 거리낌 없이 애원하는 모습에, 쓴웃음을 지으며 %조사처리(CALLNAME:MASTER,"는")% 사토리의 머리를 쓰다듬었다.
				ENDIF
			ELSE
				IF TFLAG:193 == 1
					PRINTFORML 「주님아, 더 해줬으면 좋겠어요~」
					PRINTFORMDL 멍해진 눈빛으로 입가를 흐트러뜨린 사토리가 재촉한다.
					PRINTFORMW 「『부끄러운 얼굴이야』? 후후, 주님이 그렇게 만들고 계시잖아요, 우후후후후후」
					PRINTFORMDL 그렇게 말하며 몸을 바짝 붙여 재촉해오는 사토리에게. 쓴웃음을 지으며 계속 손을 움직인다.
					PRINTFORML 「후후, 이거 정말 행복한 기분이 들어서 기뻐요」
					PRINTFORMDW 그 기쁜 미소에 어쩐지 묘한 심경이 되어버렸다.
				ELSE
					PRINTFORML 「후후, 주인의 손길에 쓰다듬어지니 마음이 따뜻해진다」
					PRINTFORMDL 그저 변덕으로 그런 말을 들으니 시선을 돌린다.
					PRINTFORMW 「아아, 주인이 부끄러워하다니 드문 일이군. 후후, 쓰다듬어지는 것도 좋은 것이지요」
					PRINTFORMDL 그렇게 말하면서도 살짝 볼에 홍조를 띠고 있는 사토리를 보며 쓴웃음이 떠오른다.
					PRINTFORML 「'너도 부끄러운데'? 후후, 확실히 부끄럽긴 하지만 기쁘니까」
					PRINTFORMDW 수줍게 웃는 사토리에게 아무 말 없이 계속 머리를 쓰다듬었다.
				ENDIF
			ENDIF
		ELSEIF 陥落状態() == 3
			IF TFLAG:193 == 1
				PRINTFORML 「……아」
				PRINTFORMDW 사토리의 머리카락 감촉을 만끽하던 %조사처리(CALLNAME:MASTER,"는")% 움직이려던 팔을 붙잡히고는 몸을 움직일 수 없게 된다.
				PRINTFORML 「저기, 그…… 저기, 조금만 더, 계속 해줬으면 해요」
				PRINTFORMDW 얼굴을 새빨갛게 물들이며 시선만 피하는 사토리의 머리를 마음껏 쓰다듬었다.
			ELSE
				PRINTFORML 「후후, 이런 건 좀 서툴러요」
				PRINTFORMDW 어딘가 즐거운 듯 웃으며 머리를 쓰다듬는 사토리
				PRINTFORML 「하지만 %CALLNAME:MASTER%는답지 않네요. 역시 시간 정지로는 재미없나요?」
				PRINTFORMDW 모든 것을 알고 있다는 듯 암시하는 사토리에게, 여전히 변덕스럽다고 %조사처리(CALLNAME:MASTER,"는")% 대답했다
			ENDIF
		ELSEIF 陥落状態() == 2
			RESETCOLOR ;custom code
			DRAWLINE
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 사토리의 머리를 가볍게 쓰다듬었다.
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 사토리는 무언가 하고 싶은 말이 있는 듯한 표정으로 응시해 온다……
				CASE 0
					IF ABL:親密 > 5
						PRINTFORML 사토리는 불쾌한 표정을 짓고 있지만, 가만히 %조사처리(CALLNAME:MASTER,"에게")% 쓰다듬어지고 있다...
					ELSE
						PRINTFORML 사토리는 싫다는 듯 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다...
					ENDIF
				CASE -1
					PRINTFORML ……힘껏 손을 뿌리쳐졌다
			ENDSELECT
			PRINTL
			SIF FLAG:口上色
				CALLFORM M_KOJO_COLOR_K49
			IF TFLAG:193 == 1
				PRINTFORML 「…………하아, 뭐예요?」
				PRINTFORMDW 깊게 한숨을 내쉰 사토리가 저항하지 않는 것을 좋은 기회로 더욱 힘주어 머리를 쓰다듬는다.
				PRINTFORML 「응…… 언제까지 할 생각이에요……」
				PRINTFORMDW 아주 조금, 입가와 눈가를 부드럽게 만든 사토리에게 그저 미소 지었다.
			ELSEIF TFLAG:193 == -1
				PRINTFORML 「『아프다』? 유감스럽게도 부서지지는 않았나」
				PRINTFORMDW 차가운 눈으로 중얼거리는 사토리에게 식은땀이 흘렀다.
				PRINTFORML 「그것을 명심하고, 만지지 말아 주십시오」
				PRINTFORMDW 그럴 리 없다고 속으로 투덜거리자, 날카로운 시선으로 노려졌다.
			ELSE
				IF ABL:親密 > 5
					PRINTFORML 「……불쾌해요, 어서 손 치워주세요」
					PRINTFORMDW 불평을 하면서도 뿌리치려 하지 않고 벗어나려 하지 않는 사토리를 보며苦笑が浮かぶ
					PRINTFORML 「『그만두는 건 아깝잖아』…… 하아, 정말로, 정말정말로 바보시네요」
					PRINTFORMDW 귀찮다는 투의 말투와는 대조적으로, 사토리의 입가에 미소가 번지고 있다.
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%를에게는 만져지고 싶지 않아요」
					PRINTFORMDW 손을 뿌리쳐진 통증에 얼굴을 찡그리는 %조사처리(CALLNAME:MASTER,"를")%, 사토리가 노려본다.
					PRINTFORML 「『시간 정지로 해볼까』? ……바보예요?」
					PRINTFORMDW 어이없다는 표정을 짓는 사토리에게, 그저 히죽 웃어 보였다.
				ENDIF
			ENDIF
			RESETCOLOR
		ELSEIF 陥落状態() == 1
			IF TFLAG:193 == 1
				PRINTFORML 「이제, 어쩔 수 없는 분이시군요, %조사처리(CALLNAME:MASTER,"는")%」
				PRINTFORMDW 불만을 토로하면서도 기쁜 듯 웃는 사토리에게 손의 움직임은 멈추지 않았다.
			ELSEIF TFLAG:193 == -1
				PRINTFORML 「……슬슬 그만둬 주셔야 해요, 정말로 화낼 거예요?」
				PRINTFORMDW 미소를 띠고 묘한 기세를 보여오는 사토리에게, 마지못해 손을 뗐다.
			ELSE
				IF ABL:親密 > 5
					PRINTFORML 「응……, 싫다기보다는, 조금 부끄럽네요」
					PRINTFORMDW 뺨을 살짝 붉힌 사토리가 그래도 순순히 머리를 쓰다듬어지고 있다.
				ELSE
					PRINTFORML 「가까운 사이에도 예의는 있답니다」
					PRINTFORMDW 부드러운 미소를 짓고 있는 사토리에게 안겨 손을 늘어뜨리고 흔드는 %CALLNAME:MASTER%였다.
				ENDIF
			ENDIF
		ELSE
			IF TFLAG:193 == 1
				PRINTFORML 「……이런 거 해서 뭐가 재미있어요」
				PRINTFORMDW 사토리가 신기하다는 듯 물어오지만, 드물게 즐거워 보이는 미소를 짓고 있다.
			ELSEIF TFLAG:193 == -1
				PRINTFORML 「친하지도 않은 상대의 머리에, 멋대로 손대는 것은 어떠한지 의문이다」
				PRINTFORMDW 탁 소리를 내며 손을 거두자, %조사처리(CALLNAME:MASTER,"는")% 사토리에게서 마지못해 떨어졌다
			ELSE
				IF ABL:親密 > 5
					PRINTFORML 「여성의 머리를 가볍게 여기지 말아주었으면 한다」
					PRINTFORMDW 입으로는 그렇게 말하면서도, 더 해달라고 말하듯 조금 몸을 앞으로 내밀었다.
				ELSE
					PRINTFORML 「그렇게 가볍게 만지지 말아 주세요」
					PRINTFORMDW 뺨을 붉게 물들이며 손을 뿌리치는 사토리를 보며, 어쩔 수 없다고 체념하는 %CALLNAME:MASTER%였다.
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
