			ENDSELECT
		ENDIF
	ELSEIF 陥落状態() == 3
		SELECTCASE TFLAG:193
			CASE 2
				PRINTFORML 「……뭐, %CALLNAME:MASTER%도 불평의 원인 중 하나이긴 하지만」
