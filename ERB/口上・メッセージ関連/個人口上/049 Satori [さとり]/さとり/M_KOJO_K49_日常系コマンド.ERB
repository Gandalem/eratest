@M_KOJO_MESSAGE_COM_K49_331_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:媚薬 == 210
		LOCALS '= @"미약"
	ELSEIF TCVAR:利尿剤 == 210
		LOCALS '= @"이뇨제"
	ELSEIF TCVAR:惚れ薬 == 210
		LOCALS '= @"춘약"
	ELSEIF TCVAR:睡眠薬お茶使用
		LOCALS '= @"수면제"
	ELSE
		LOCALS '= @"약"
	ENDIF
	IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		IF TALENT:恋慕
			IF 陥落状態() == 5
				PRINTFORML 「주님은 정말 변태시네요~」
				PRINTFORMDL 크크 웃으며 내민 차에 입을 대는 사토리
				PRINTFORML 「%LOCALS%를 마시게 하고 싶다면, 직접 사용하면 되잖아요」
				PRINTFORMDL 그것도 풍정이 없다고 대답하는 %CALLNAME:MASTER%
				PRINTFORML 「뭐, 제가 제일 좋아하는 주님의 장난이니까 기꺼이 마실게요」
				PRINTFORMDL 얼굴 가득 미소를 지으며 사토리가 목울림을 하고 차를 단숨에 마셔버렸다
			ELSE
				PRINTFORML 「……정말, 주님에게도 골치 아픈 분이시네요」
				PRINTFORMDL 깊게 한숨을 내쉰 사토리가 이쪽에서 건넨 차를 응시하고 있다.
				PRINTFORMW 「%LOCALS% 같은 걸 마시게 하고, 심술궂게 하고 싶다니」
				PRINTFORMDL 그렇게 말하면서도, 눈에 물기가 고인 채로 사토리가 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있었다.
				LOCALS:1 = 
				IF TCVAR:媚薬 == 210
					LOCALS:1 '= @"욕정이 밀려와서"
				ELSEIF TCVAR:利尿剤 == 210
					LOCALS:1 '= @"실수를 하다"
				ELSEIF TCVAR:惚れ薬 == 210
					LOCALS:1 '= @"발정하고"
				ELSEIF TCVAR:睡眠薬強度 >= 1
					LOCALS:1 '= @"잠들래"
				ENDIF
				PRINTFORML 「제대로 %LOCALS:1% 해줘도, 상대해 주세요」
				PRINTFORMDW 그렇게 말하며 찻잔을 기울이고, 꿀꺽 하고 목구멍을 울리며 다 마셔버렸다
			ENDIF
			;恋慕も持たずに恋人とな？
		ELSE
			PRINTFORML 「……아무리 주님이라 해도, 이것은 부디 받아들이기 어렵습니다」
			PRINTFORMDL 애써 준비한 차를 거절당하고는 일부러 과장된 한숨을 내쉰다.
			PRINTFORMW 「그, 교감하는 자리라면 약에 취해 추태를 보이는 것도 주저하지 않을 수 있습니다」
			PRINTFORMDL 그렇게 말하면서도 어딘가 슬프게 이쪽을 응시하고 있는 사토리.
			PRINTFORML 「하지만 역시 사람들이 보는 곳에서는 삼가주시길 바랍니다」
			PRINTFORMDW 살짝 눈가가 붉어진 사토리를 향해 한숨을 쉬며 거절당한 차를 받아들인다.
		ENDIF
	ELSEIF 陥落状態() == 3
		PRINTFORML 「변태에도 정도가 있어요. %LOCALS% 넣은 차 같은 거」
		PRINTFORMDL 투덜거리면서도 사토리가 손에 들고 있던 찻잔을 입가로 가져간다
		PRINTFORML 「정말 어쩔 수 없는 사람이네요」
		PRINTFORMDW 어딘가 즐거운 듯 중얼거리고, 그 안의 내용물을 천천히 삼켰다
	ELSEIF 陥落状態() == 2
		PRINTFORML 「이, 비열하고 천박하며 잔인하고 거만하기까지 한 것. 약을 섞다니」
		PRINTFORMDL 입매를 굳히고 강렬한 시선을 보내는 사토리
		PRINTFORML 「이런 걸 누가 기뻐하겠어요」
		PRINTFORMDW 분노마저 드러내며 속내를 %조사처리(CALLNAME:MASTER,"에게")% 쏟아냈다.
	ELSEIF 陥落状態() == 1
		PRINTFORML 「하아……, 아무리 그래도 이건 사양하겠습니다」
		PRINTFORMDW 싫다는 듯 중얼거린 사토리가 정성스레 우려낸 차를 밀어냈다.
	ELSE
		PRINTFORML 「……최악이네」
		PRINTFORMDW 내민 차는 무시당했다
	ENDIF
	SETBIT CFLAG:1490,3
ENDIF
RETURN 1
