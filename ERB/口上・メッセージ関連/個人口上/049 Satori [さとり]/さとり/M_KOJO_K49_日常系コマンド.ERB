@M_KOJO_MESSAGE_COM_K49_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		IF 陥落状態() == 5
			IF ALCOHOL_TASTE(TFLAG:194) <10
				PRINTFORML 「음~ 이 술, 별로 맛있지 않아요. ……아, 이렇게 하면 맛있어지죠」
				PRINTFORMDL 환하게 웃는 사토리가 %ITEMNAME:(TFLAG:194)%를 입에 머금고 키스해왔다.
				PRINTFORMW 「음, 레로츄루…… 푸하…… 어때요 주인님?」
				PRINTFORMDL 확실히 이 마시는 방법이 좋다고 속으로 생각하며, 이번에는 자신이 %ITEMNAME:(TFLAG:194)%를 입에 머금는다.
				PRINTFORML 「아, 쭈압, 쪽…… 꿀꺽………… 하아, 맛있어요」
				PRINTFORMDW 몽롱한 표정의 사토리에게 그대로 마시기를 이어가는 %CALLNAME:MASTER%였다.
			ELSE
				PRINTFORMDL 꿀꺽, 하고 \@ TFLAG:194 == 58 ? 잔 # 잔 \@을 기울인 사토리가 얼굴을 가까이 가져온다.
				PRINTFORMDL 그대로 입술을 포개고, 사토리의 달콤함이 실린 %ITEMNAME:(TFLAG:194)%
				PRINTFORMW 「……푸핫, 맛있으세요, 주님?」
				PRINTFORMDL 환한 미소를 짓는 사토리에게 고개를 끄덕이며 이번에는 자신이 똑같이 잔을 채워준다.
				PRINTFORML 「응, 쭉…… 꿀꺽…… 쪽…… 푸핫」
				PRINTFORMW 「주님, 더 갖고 싶어요, 주인님아」
			ENDIF
			;さすがに思慕無しで恋人はつかないでしょ
		ELSE
			IF ALCOHOL_TASTE(TFLAG:194) <10
				PRINTFORML 「……별로 제 입맛에 안 맞네요」
				PRINTFORMDL 애써 꺼낸 %ITEMNAME:(TFLAG:194)%에 대해 그런 말을 듣자, %조사처리(CALLNAME:MASTER,"는")% 한숨을 내쉰다.
				PRINTFORMW 「거짓말하는 편이 나았나요?」
				PRINTFORMDL 사토리의 물음에 고개를 가로저으며 어깨를 살짝 으쓱해 보인다.
				PRINTFORML 「……하지만 뭐, 주님께 받은 것이니까요」
				PRINTFORMDW 기쁜 듯 웃으며, 사토리가 \@ TFLAG:194 == 58 ? 잔 # 잔 \@을 비웠다.
			ELSE
				PRINTFORML 「아, 맛있다. 후후, 감사합니다 주님」
				PRINTFORMDL 그렇게 말하며, \@ TFLAG:194 == 58 ? 잔 # 컵 \@에 입술을 가져다 대는 사토리
				PRINTFORMW 「『취한 모습이 보고 싶으시다구요』? ……하아, 그런 추태는 별로 보여드리고 싶지 않은데요」
				PRINTFORMDL 추태라는 표현에서 술에 취했을 때의 기억이 있는지 의문을 품는 %CALLNAME:MASTER%
				PRINTFORML 「……안개가 낀 듯한 희미한 기억이에요만」
				PRINTFORMDW 부끄러워하는 표정의 사토리를 보며 자연스럽게 쓴웃음이 떠올랐다
			ENDIF
		ENDIF
	ELSEIF 陥落状態() == 3
		IF ALCOHOL_TASTE(TFLAG:194) <10
			PRINTFORML 「……할 수 있다면, 맛있는 술을 내주셨으면 해요」
			PRINTFORMDL 씁쓸하게 웃으며, 사토리가 홀짝홀짝 %ITEMNAME:(TFLAG:194)%를 마시고 있다.
			PRINTFORML 「『전에는 한 번에 들이키곤 했지』? 뭐, 예전은 예전이고, 지금은 지금이죠」
			PRINTFORMDW 쿠스쿠스 웃으면서도 즐거워 보이는 사토리에게 나도 미소가 떠올랐다.
		ELSE
			PRINTFORML 「후우, 맛있네요, 이거」
			PRINTFORMDL 황홀한 표정으로, 손에 들고 있던 \@ TFLAG:194 == 58 ? 잔 # 술잔 \@을 비워나가는 사토리가
			PRINTFORML 「『마음에 들었니』? 자, 어떤가요. 하지만 맛있어요」
			PRINTFORMDW 그렇게 말하며 뺨을 붉게 물들이고 있는 사토리에게, %조사처리(CALLNAME:MASTER,"는")% 빠져버렸다
		ENDIF
		;酔わない
	ELSEIF 陥落状態() == 2
		PRINTFORML 「……맛없네요. %조사처리(CALLNAME:MASTER,"의")% 얼굴을 보면서 마시는 술은 특히」
		PRINTFORMDL 그렇게 말하면서, 마치 물이라도 되는 양 태연하게 단숨에 들이켜는 사토리
		PRINTFORML 「『색기 없는 마시방식』? %조사처리(CALLNAME:MASTER,"에게")% 색기를 보여줄 생각은 없으니까요」
		PRINTFORMDW 술을 망쳤다고 속으로 한탄하면서도, 어째선지 입가를 느슨하게 만드는 사토리를 바라보았다
	ELSEIF 陥落状態() == 1
		PRINTFORM 갑자기 술을 내는 건 좀 그렇다고 생각하는데…….
		IF ALCOHOL_TASTE(TFLAG:194) <10
			PRINTFORML 「오, 맛있어요, 네」
			PRINTFORMDW 입가를 떨고 있는 사토리를 보며, 솔직하게 말하면 좋을 텐데 하고 생각하는 %CALLNAME:MASTER%였다.
		ELSE
			PRINTFORML 「아, 맛있다」
			PRINTFORMDW 수상한 표정으로 잔을 받은 사토리는 마시자마자 얼굴에 미소를 지었다.
		ENDIF
		;酔わない
	ELSE
		PRINTFORML 「그렇게 친하지도 않은 상대에게 술을 권하는 것은 어떻다고 생각한다」
		PRINTFORMDW 어이없다는 표정의 사토리가 태연하게 다 마셨다
	ENDIF
ENDIF
RETURN 1
