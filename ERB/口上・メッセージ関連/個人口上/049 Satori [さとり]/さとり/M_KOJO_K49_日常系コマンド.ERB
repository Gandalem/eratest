@M_KOJO_MESSAGE_COM_K49_306_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;custom code
	SIF !RAND:5
		CALL FONT_AA_49(306)
	IF FLAG:70
		CALL STOP49
	ELSEIF CFLAG:TARGET:睡眠
		CALL SLEEP49
	ELSEIF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		RESETCOLOR ;custom code
		DRAWLINE
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		IF 陥落状態() == 5
			IF RAND:110 <= 9
				PRINTFORML 「ふにゃぁ, 기분 좋으다아~」
				PRINTFORMDL 황홀한 표정으로, 마음껏 허리를 내미는 사토리.
				PRINTFORMW 「『음란』? 응, 음란해도 괜찮아요, 사랑하는 주님께 되고 있으니까아~」
				PRINTFORMDL 골골거릴 정도로 기분 좋은 표정을 짓고 있는 사토리.
				PRINTFORML 「마음도 몸도 기분 좋으다구. 주님은 정말 멋져요~」
				PRINTFORMDW 몸을 바짝 밀착해 오는 사토리의 애원에, 마음껏 쓰다듬어 주었다.
				TFLAG:97 += 3
			ELSE
				PRINTFORML 「음~ 주인님은 즐거우세요?」
				PRINTFORMDL 사토리의 말에, 속으로는 즐겁다고 답하면서 부드러운 하복부를 쓰다듬는다.
				PRINTFORMW 「어차피 그렇다면, 이대로 H하고 싶어요」
				PRINTFORMDL 위를 올려 바라보는 애원에는 기분에 따라 대답하는 %CALLNAME:MASTER%
				PRINTFORML 「주인님의 변덕에도 곤란하네요」
				PRINTFORMDW 쿠스쿠스 즐거운 듯 웃으며, 사토리가 몸을 바짝 밀착해 왔다.
			ENDIF
		ELSE
			IF RAND:110 <= 9
				PRINTFORML 「응, 하아…… 주님, 아무리 그래도, 응, 거기를 만지는 건」
				PRINTFORMDL 볼이 상기된 사토리가 눈가를 촉촉하게 만들며 바라본다.
				PRINTFORMW 「『싫었어』? 아니, 그게 아니라…… 기분 좋았으니까」
				PRINTFORMDL 그 말에, 입가에 희미한 미소를 지으며 더욱 쓰다듬는다.
				PRINTFORML 「흐윽, 아흑…… 그러니까, 그만해 달라고」
				PRINTFORMDW 입으로는 투덜거리면서도 잡고 있는 이쪽 손을 뿌리치려 하지는 않는다.
				TFLAG:97 += 3
			ELSE
				PRINTFORML 「이제, 뭘 하고 싶은 거예요, 주인님」
				PRINTFORMDL 어이없다는 듯한 표정으로 사토리가 이곳을 바라본다.
				PRINTFORMW 「애틋하게 교감하는 중도 아닌데, 여자의 그곳을 쓰다듬는 건, 음윽」
				PRINTFORMDL 그런 잔소리를 흘려들으며 더욱 깊은 곳에 손을 움직이려 했으나, 몸이 움직이지 않게 되었다.
				PRINTFORML 「주인님, 적당히 안 하시면 화낼 거예요?」
				PRINTFORMDW 그렇게 말한 후 입가를 올린 사토리가 이쪽의 몸에 감긴 서드아이의 촉수를 풀어주었다.
			ENDIF
		ENDIF
	ELSEIF 陥落状態() == 3
		IF RAND:110 <= 9
			PRINTFORML 「んく읏……、はぁ、これ、恥ずかしいです」
			PRINTFORMDW 그렇게 말하면서도 어딘가 기쁜 듯 자신의 그것을 이쪽 손 위에 포개는 사토리
			PRINTFORML 「『恥ずかしいだけか』？　ふふ、そう、ですね。多少は気持ちよくもあります」
			PRINTFORMDW 쿠스쿠스 웃는 사토리가 이쪽 손을 사용하여 자신의 배를 쓰다듬기 시작했다
			TFLAG:97 += 3
		ELSE
			PRINTFORML 「응읏, 벌써 이런 거 뭐가 즐겁다는 거예요」
			PRINTFORMDW 당황한 듯 사토리가 이쪽을 바라본다.
			PRINTFORML 「『볼치오는 어때』? ……변태네요」
			PRINTFORMDW 어이없다는 듯 시선을 보내면서도, 입가를 부드럽게 풀고 있는 사토리였다.
		ENDIF
	ELSEIF 陥落状態() == 2
		RESETCOLOR ;custom code
		DRAWLINE
		IF TFLAG:193 == 1
			PRINTFORML 사토리는 %조사처리(CALLNAME:MASTER,"의")% 손을 무리하게 쳐냈다.
		ELSEIF RAND:110 <= 9
			PRINTFORML 사토리는 %조사처리(CALLNAME:MASTER,"의")% 손길에 몸을 떨고 있다.
		ELSEIF TFLAG:193 == -1
			PRINTFORML 사토리는 %조사처리(CALLNAME:MASTER,"의")% 손을 세게 뿌리쳤다
		ELSE
			PRINTFORML 사토리는 %조사처리(CALLNAME:MASTER,"의")% 손길에 입술을 깨물고 있다.
		ENDIF
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		IF TFLAG:193 == 1
			PRINTFORML 「……만지지 말아 주세요, 이 아이가 더러워져요」
			PRINTFORMDW 자신의 배를 감싸 안고 자신을 노려보는 사토리에게, %조사처리(CALLNAME:MASTER,"는")% 아버지에 대한 심한 말투라고 말했다.
			PRINTFORML 「피보다 더 진한 정이 있기에 부모와 자식이 있는 겁니다. 정 따위 없는 당신은 그저 피의 원천일 뿐이에요」
			PRINTFORMDW 느릿하게 자신을 노려보는 사토리가, 애틋하게 자신의 복부를 쓰다듬고 있다.
		ELSEIF RAND:110 <= 9
			PRINTFORML 「큭, 윽…… 이런 걸 뭘 즐기고 계신 거예요」
			PRINTFORMDW 부드러움을 만끽하고 있는 사토리가 쾌감에 반응하며 둘 다 즐겁다고 중얼거리는 %CALLNAME:MASTER%
			PRINTFORML 「이 변태, 큭, 으윽…… 그러니까, 만지지 말아 주세요」
			PRINTFORMDW 입으로는 불만을 토로하면서도 사토리는 도망치려 하지 않았다
			TFLAG:97 += 3
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「그만두세요읏!」
			PRINTFORMDW 가볍게 쓰다듬자마자 손을 뿌리치고, 의아해하며 사토리를 바라본다.
			PRINTFORML 「『이 정도 가지고 그만둘 수 있어』? 불쾌할 뿐이라고욧!!」
			PRINTFORMDW 그렇게 말하면서도 어째선지 볼이 붉어진 사토리가 노려왔다.
		ELSE
			PRINTFORML 「『저항하지 않을 건가』? 할수록 소용없는 일은, 해도 소용없으니까」
			PRINTFORMDW 깊게 한숨을 쉬는 사토리를 향해, 씨익 웃으며 부드럽게 쓰다듬어 나간다.
			PRINTFORML 「……응으윽………… 아직, 하실 생각인가요」
			PRINTFORMDW 숨을 조금 빠르게 쉬기 시작한 사토리에게 대답하지 않고, 마음껏 쓰다듬었다.
		ENDIF
		RESETCOLOR
	ELSEIF 陥落状態() == 1
		IF RAND:110 <= 9
			PRINTFORML 「『매끄럽다』? ……뭐, 불필요한 살이 붙지 않도록 절제하고는 있어요」
			PRINTFORMDW 그렇게 중얼거리며, 어딘가 기쁜 듯 사토리가 미소 짓는다.
			TFLAG:97 += 3
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「……여성의 하복부를 쓰다듬는 건, 좀 그렇다고 생각하지만」
			PRINTFORMDW 살짝 얼굴을 찡그린 사토리에게 손등을 깨물었다
		ELSE
			PRINTFORML 「저기, 가능하다면 거긴 만지지 말아줬으면 하는데요」
			PRINTFORMDW 그렇게 말하면서 사토리가 당신의 손을 살며 밀쳐냈다.
		ENDIF
	ELSE
		IF RAND:110 <= 9
			PRINTFORML 「어디를 만지고 있는 거예요, 상식 없으시네요」
			PRINTFORMDW 어이없다는 듯 중얼거린 사토리지만, 다시 겹쳐 온 손을 멈추려 하지 않는다.
			TFLAG:97 += 3
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「……적당히 해 주세요」
			PRINTFORMDW 불쾌하다는 듯 노려보자 마지못해 손을 놓았다.
		ELSE
			PRINTFORML 「뭐가 재미있다는 거예요? 바보 같잖아요」
			PRINTFORMDW 차가운 시선을 보내는 사토리에게, 마지못해 손을 거두었다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
