@M_KOJO_SUCCESS_COM_K49_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K49_301
IF CFLAG:1496 == 2 && !RAND:2
	CALL PET49()
ELSEIF CFLAG:1496 == 1 && !RAND:2
	CALL ONRYO49()
ENDIF
CALL M_KOJO_MESSAGE_COM_K49_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K49_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		IF GETBIT (CFLAG:1490,3)
			IF TALENT:恋慕
				IF 陥落状態() == 5
					PRINTFORML 「주님, 오늘은 약은 없습니까? 아쉽네요」
					PRINTFORMDL 넣어줬으면 좋겠다고 언외에 고백하는 사토리에게 쓴웃음이 떠오른다.
					PRINTFORMW 「왜냐하면 주님께서 약을 넣어주실 때는 H를 할 때니까요」
					PRINTFORMDL 얼굴 가득 미소를 띠고 중얼거리는 사토리.
					PRINTFORML 「들어 있지 않은 차도 맛있으니까 좋아하지만요」
					PRINTFORMDW 그렇게 말하며 차에 입을 댔다.
				ELSE
					PRINTFORML 「주인님, 약은 넣지 않으시는 건가요?」
					PRINTFORMDL 넣어줬으면 좋겠나? 라고 물은 %조사처리(CALLNAME:MASTER,"에게")% 사토리는 쓴웃음을 짓는다.
					PRINTFORMW 「가능하다면 사양하고 싶지만, 주인님께서 원하신다면 괜찮아요」
					PRINTFORMDL 지금은 그런 기분이 아니라고 생각하여
					PRINTFORML 「후후, 그렇게 말씀하시는 주인님의 변덕은 싫지 않아요」
					PRINTFORMDW 중얼거린 사토리가 차에 입을 댔다.
				ENDIF
				;恋慕も持たずに恋人とな？
			ELSE
				PRINTFORML 「다행이네요, 약은 넣지 않았군요」
				PRINTFORMDL 넣어도 마시지 않을 것을, 그렇게 생각하자 사토리가 입가에 미소를 띠었다.
				PRINTFORMW 「당연하죠. 아무리 연인 사이라 해도, 해서 좋은 일과 나쁜 일이 있는 법이니까요」
				PRINTFORML 「격정적인 순간이라면 몰라도, 남들에게 들킬 만한 일은 해줬으면 안 돼요」
				PRINTFORMDL 그 말에 응답하지 않고, %조사처리(CALLNAME:MASTER,"는")% 비장의 간식을 슬쩍 꺼낸다.
				PRINTFORMDW 기쁜 표정을 지으며 사토리가 그것을 받았다.
			ENDIF
		ELSE
			IF 陥落状態() == 5
				PRINTFORML 「후후후, 주님께서 타주시는 차가 맛있으니까 좋아요」
				PRINTFORMDL 환한 미소로 그렇게 말하는 %CALLNAME:MASTER%도 나쁠 것 없이 기분이 좋았다.
				PRINTFORML 「솔직히 기쁘다고는 생각 못 하시는 건가요?」
				PRINTFORMDL 사토리의 말에, 마음을 알 수 없는 이상 아첨이라고 받아들이는 것이 낫겠다고 답했다.
				PRINTFORML 「그런 주님은 싫어요」
				PRINTFORMDL 입술을 삐죽 내민 사토리를 보며, 쓴웃음을 지으며 그 머리를 쓰다듬어 주었다.
			ELSE
				PRINTFORML 「주님, 감사합니다. 기뻐요」
				PRINTFORMDL 받은 차와 다과를 행복하게 바라보는 사토리
				PRINTFORMW 「『단순한 변덕』? 후후, 변덕이라도 주님이 해주는 게 기쁜 거예요」
				PRINTFORMDL 쿠스쿠스 웃으며, 사토리가 차와 다과에 입을 댄다.
				PRINTFORML 「저 애들이 내려주는 거랑은 또 다른 기쁨이랄까요」
				PRINTFORMDW 사토리의 말에, 괴롭힐 생각이었던 말이 사라졌다.
			ENDIF
		ENDIF
	ELSEIF 陥落状態() == 3 || TALENT:184 || TALENT:185
		IF GETBIT (CFLAG:1490,3)
			PRINTFORML 「아라, 약은 타주지 않으실 건가요?」
			PRINTFORMDL 쿠스쿠스 웃으며 사토리가 중얼거린다.
			PRINTFORML 「『지금은 필요 없어』? 후후, 후후후후, %조사처리(CALLNAME:MASTER,"는")% 정말 변덕스러우시네요」
			PRINTFORMDW 뭐가 즐거운 건지, 쿠스쿠스 웃으며 사토리는 손에 들린 차를 입에 댔다.
		ELSE
			PRINTFORML 「맛있네요. %조사처리(CALLNAME:MASTER,"가")% 내려주니까 그런 걸까요」
			PRINTFORMDL 누가 내려도 변함없다고 중얼거린 순간, 사토리가 쓴웃음으로 웃음을 바꾼다
			PRINTFORML 「아뇨, 저희 집 아이들도 오린은 잘하지만, 쿠우는 서툴러서요」
			PRINTFORMDW 저 두 사람이라면 그럴 법하다, 속으로 생각하는 동시에 사토리는 씁쓸하게 웃으며 고개를 끄덕였다.
		ENDIF
	ELSEIF 陥落状態() == 2
		IF GETBIT (CFLAG:1490,3)
			PRINTFORML 「『약은 넣지 않았어』……, 넣을 수 없는 게 당연하지」
			PRINTFORMDL 차가운 눈으로 노려오는 사토리.
			PRINTFORML 「이번엔 꼭? 유감이지만, 소용없다네」
			PRINTFORMDW 깊게 한숨을 내쉰 사토리가 어이없다는 듯한 표정을 짓고 있다.
		ELSE
			PRINTFORML 「차를 우린 정도 가지고 포섭할 수 있을 거라고 생각하지 마세요」
			PRINTFORMDL 불쾌한 듯 중얼거리면서도, 내민 차와 다과를 손에 넣은 사토리.
			PRINTFORML 「……뭔가?」
			PRINTFORMDW 살짝 즐거운 듯 차를 음미하는 사토리를 보며 그저 히죽 웃었다.
		ENDIF
	ELSEIF 陥落状態() == 1
		IF GETBIT (CFLAG:1490,3)
			PRINTFORML 「다행이야, 오늘은 약은 들어있지 않네」
			PRINTFORMDW 미소 지으며 말하는 사토리에게 대답을 얼버렸다.
		ELSEIF TFLAG:193 == 1
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 차를 우리는 것이 능숙하네요」
			PRINTFORMDW 즐거운 미소를 짓고 있는 사토리에게, 미소로 화답하는 %CALLNAME:MASTER%였다
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「……저기, 감사하지만 이건 좀」
			PRINTFORMDW 당황하는 사토리를 보며 고개를 갸웃하고 맛을 본 %조사처리(CALLNAME:MASTER,"는")% 너무나 역겨운 맛에 얼어붙었다.
		ELSE
			PRINTFORML 「후후, 감사합니다」
			PRINTFORMDW 입가에 미소를 머금고 사토리가 차를 마시고 있다
		ENDIF
	ELSE
		IF GETBIT (CFLAG:1490,3)
			PRINTFORML 「앞으로도 약은 섞지 말아 주세요」
			PRINTFORMDW 불쾌한 듯 중얼거리며, 사토리가 차를 손에 들었다.
		ELSEIF TFLAG:193 == 1
			PRINTFORML 「감사합니다…… 맛있어요」
			PRINTFORMDW 사토리가, 드물게 조금 즐거워 보이는 듯 입가에 미소를 지었다.
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「……고마워」
			PRINTFORMDW 한 모금 마신 순간, 사토리가 말하기 힘든 표정을 지었다.
		ELSE
			PRINTFORML 「감사합니다」
			PRINTFORMDW 평소와 다름 없는 표정으로 받고 사토리가 차를 마시고 있다.
		ENDIF
	ENDIF
	CLEARBIT CFLAG:1490,3
ENDIF
RETURN 1
