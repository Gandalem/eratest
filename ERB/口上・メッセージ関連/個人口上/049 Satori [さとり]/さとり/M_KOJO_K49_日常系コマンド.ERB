; Modular ERB: 個人口上/049 Satori [さとり]/さとり/M_KOJO_K49_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K49_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K49_300
RETURN 1

@M_KOJO_MESSAGE_COM_K49_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
IF CFLAG:1496 == 2 && !RAND:2
	CALL PET49()
ELSEIF CFLAG:1496 == 1 && !RAND:2
	CALL ONRYO49()
ENDIF
SIF 陥落状態() < 3 && !TCVAR:302 && (BASE:酒気 < (MAXBASE:酒気 / 10) * 4)
	CALL TRAIN_MESSAGE
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K49_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K49_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;custom code
	CALL FONT_AA_49(0)
	IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		RESETCOLOR ;custom code
		DRAWLINE
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		CALL DRUNKER49()
	ELSEIF TCVAR:302
		RESETCOLOR ;custom code
		DRAWLINE
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		IF 陥落状態() >= 4
			IF 陥落状態() == 5
				PRINTFORML 「주인님의 목소리도 듣기 좋지만, 가끔은 느긋하게 쉬어요?」
				PRINTFORML 「『지루하겠지』라고요? 주인님이 곁에 계신 것만으로도 기쁘니까요」
				PRINTFORML 「『귀여운 애』라니…… 주인님이 멋있으니까 그래요」
			ELSE
				PRINTFORML 「주인님, 억지로 말을 하려고 애쓰지 않아도 괜찮아요」
				PRINTFORML 「후후, 그렇게 화제를 찾아 헤매는 모습도 멋있으니까요」
				PRINTFORML 「게다가, 마음을 보여 주시는 것도 기쁜 일이니까요」
			ENDIF
		ELSEIF 陥落状態() == 3
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 목소리는 좋아하지만, 마음을 보는 것도 좋아요」
			PRINTFORML 「억지로 대화를 하려고 애쓰지 않아도 괜찮은 거 아닐까요」
		ELSEIF 陥落状態() == 2
			PRINTFORML 「할 말이 없다면 조용히 있어 주세요」
		ELSEIF 陥落状態() == 1
			PRINTFORML 「입이 움직이지 않는다면, 억지로 말하지 않아도 괜찮아요」
		ELSE
			PRINTFORML 「왜 말도 안 하는데 입을 움직이려고 하는 거예요?」
		ENDIF
		PRINTL
		RESETCOLOR
	ELSEIF 陥落状態() >= 4
		IF 陥落状態() == 5
			RESETCOLOR ;custom code
			DRAWLINE
			PRINTFORM %조사처리(CALLNAME:MASTER,"의")% 말에,
			IF CFLAG:TARGET:添い寝中
				PRINTFORML 녹아내린 표정으로 꽉 안겨오는 사토리가 자신을 바라본다.
			ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中)
				PRINTFORML 자신의 손가락을 감싼 사토리가 해바라기 같은 미소를 띠고 있다.
			ELSE
				PRINTFORML 사토리가 얼굴 가득 미소를 지으며 꽉 안겨왔다
			ENDIF
			PRINTL
			SIF FLAG:口上色
				CALLFORM M_KOJO_COLOR_K49
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 「그래서 어떻게 된 거예요?」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 이야기에, 사토리가 눈을 빛내며 계속하게 재촉한다.
					PRINTFORML 「'질리지 않냐고요'? 아니에요~ 주인님의 목소리랑 '그것'이 같으니까요」
					PRINTFORMDL 그렇게 말하며 환한 미소를 짓는 사토리.
					PRINTFORML 「정말로 주인님은 멋져요」
					PRINTFORMDL 꾸밈없는 호의로 가득 찬 그 말에, 어쩐지 쑥스러움을 느꼈다.
				CASE 0
					PRINTFORML 「주님은 정말 이상한 이야기를 알고 계시네요」
					PRINTFORMDL 신기하다는 듯 그런 말을 하면서 사토리가 다가온다.
					PRINTFORML 「『아는 이야기지』? 지식으로서 알고 있지만, 경험한 사람의 이야기는 다른 거니까」
					PRINTFORMDL 무엇이 기쁜 건지 미소 짓는 사토리.
					PRINTFORML 「게다가, 가장 좋아하는 주님의 목소리를 들을 수 있다는 것도 기쁘니까」
					PRINTFORMDL 그런 사토리의 미소에, 나도 모르게 입꼬리가 살짝 풀려버렸다.
			ENDSELECT
		ELSE
			RESETCOLOR ;custom code
			DRAWLINE
			PRINTFORM %조사처리(CALLNAME:MASTER,"의")% 말에,
			IF CFLAG:TARGET:添い寝中
				PRINTFORML 황홀한 표정으로 밀착해 있는 사토리가 바라본다
			ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中)
				PRINTFORML 자신의 손가락을 얽은 사토리가 녹아내릴 듯한 미소를 향해 다가온다
			ELSE
				PRINTFORML 사토리가 미소를 지으며 팔을 감고 몸을 맡겨왔다.
			ENDIF
			PRINTL
			SIF FLAG:口上色
				CALLFORM M_KOJO_COLOR_K49
			SELECTCASE RAND:3
				CASE 2
					PRINTFORML 「주인님의 목소리는, 정말 듣기 좋네요」
					PRINTFORMDL 처음 만났을 때의 차가움은 조금도 없는 말에 저절로 미소가 떠오른다.
					PRINTFORMW 「……그때는 아직 가족 이외의 타인에게 마음을 줄 생각이 없었으니까요」
					PRINTFORMDL 지금부터 배신하는 것도 재미있을 것 같다, 그렇게 생각하자 사토리가 부끄러운 듯 뺨을 물들인다.
					PRINTFORML 「시간 정지만으로는 얻을 수 없는, 봉사받는 쾌락을 포기해도 괜찮다고요?」
					PRINTFORMDW 지금 당장 봉사를 시작하고 싶어 하는 것이겠지, 눈가가 촉촉해진 사토리에게 그저 미소를 보냈다.
				CASE 1
					PRINTFORML 「주님은 그렇게 말씀하시는 걸 정말 좋아하시네요」
					PRINTFORMDL 미소를 띤 사토리의 말에 자연스레 쓴웃음이 떠오른다.
					PRINTFORMW 「『그렇다고 단정할 수 없다』? 후후, 주님은 거짓말을 하지 않으시니까 잘 알아요」
					PRINTFORMDL 거짓말이라면 산더미처럼 하고 있다고 대답하려던 순간
					PRINTFORML 「주님은 자신의 생각과 반대되는 말은 입에 담지 않으세요. 그렇다면 저에게 거짓말을 하신 것이 되지 않을 거예요」
					PRINTFORMDW 그렇게 말하는 사토리의 수줍은 홍조를 보며, 아무 말 없이 그저 끌어안았다.
				CASE 0
					PRINTFORML 「주님과의 대화는, 정말 즐거워요」
					PRINTFORMDL 즐겁게 해줄 의리는 없어, 그런 생각을 하는 동시에 사토리가 미소를 깊게 지었다.
					PRINTFORMW 「후후, 그렇다면 왜 대화를 나누시는 건가요?」
					PRINTFORMDL 단순한 변덕이라고 속으로 답하는 %CALLNAME:MASTER%
					PRINTFORML 「후후후, 그렇게 해두도록 하죠」
					PRINTFORMDW 기뻐하는 그 말에 이전과는 다른, 어쩐지 즐거움을 느끼게 되었다.
			ENDSELECT
		ENDIF
		RESETCOLOR
	ELSEIF 陥落状態() == 3
		RESETCOLOR ;custom code
		DRAWLINE
		IF CFLAG:TARGET:添い寝中
			PRINTFORML 체온을 느낄 수 있을 만큼 가까운 거리에서, 미소를 짓고 있는 사토리에게 말을 건다.
		ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中)
			PRINTFORML 기쁜 듯한 미소로 다가오는 사토리에게 말을 걸었다.
		ELSE
			PRINTFORML 즐거운 듯한 미소를 짓고 있는 사토리에게 말을 걸었다.
		ENDIF
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		SELECTCASE RAND:3
			CASE 2
				PRINTFORML 「……후후, %조사처리(CALLNAME:MASTER,"의")% 목소리를 들을 수 있다는 것은 멋지다」
				PRINTFORMDL 대화 내용이 어떻든 상관없다는 듯, 되묻기보다 빠르게
				PRINTFORML 「생각과 목소리가 같다는 것이 기분 좋은 것이다」
				PRINTFORMDW 그렇게 말하며 웃는 사토리에 돌아갈 말이 나오지 않았다
			CASE 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 말한다면 그럴 리가 없겠지」
				PRINTFORMDL 기쁘게 웃는 사토리를 보며, 사실은 어떤 건지 모르겠지만 속으로 중얼거린다.
				PRINTFORML 「후후, 그런 점까지 포함해서 그렇다고 생각하고 있는데요」
				PRINTFORMDW 괴롭히려던 것이 가볍게 무시당하자, 씁쓸한 미소밖에 되돌려 줄 수 없다.
			CASE 0
				PRINTFORML 「과연, %CALLNAME:MASTER%는다운 이야기네요」
				PRINTFORMDL 감탄한 듯 고개를 끄덕이는 사토리에게, 이 정도라면 쉽게 거짓말을 할 수 있을 거라 생각하는 %조사처리(CALLNAME:MASTER,"는")%
				PRINTFORML 「……사랑은 눈이 멀게 한다고들 하지만, 거짓을 간파할 만큼 제 '눈'은 흐려지지 않아요」
				PRINTFORMDW 크크 웃으며 내뱉은 말에, 대답 대신 %조사처리(CALLNAME:MASTER,"는")% 한숨을 내쉬었다
		ENDSELECT
		RESETCOLOR
	ELSEIF 陥落状態() == 2
		PRINTFORML 「……물러가라, 하찮은 것」
		PRINTFORMDL 첫마디부터 그런 말을 내뱉는 사토리에 니야니야가 멈추지 않는다.
		PRINTFORML 「『그렇게 가족을 소중히 여기나』? ……천박하고 비루하며 더러운 자들에게 말할 의리는 없습니다만」
		PRINTFORMDW 그 차가운 눈빛과 억누른 분노, 떨리는 입술에 %조사처리(CALLNAME:MASTER,"는")% 미소를 감추지 못한다.
	ELSEIF 陥落状態() == 1
		SELECTCASE RAND:3
			CASE 2
				PRINTFORML 「그렇군요, 그런 일도 있는 거네요」
				PRINTFORMDW 부드러운 표정의 사토리를 보며 자연스럽게 미소가 떠진다.
			CASE 1
				PRINTFORML 「뭐, %CALLNAME:MASTER%답지 않은 실수를 하셨네요」
				PRINTFORMDW 어딘가 즐거워 보이는 사토리에게는 쓴웃음밖에 되돌려 줄 수 없었다.
			CASE 0
				PRINTFORML 「정말, 볼만했겠네요」
				PRINTFORMDW 그렇게 말한 사토리가 드물게 입가에 미소를 띠고 있다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 2
				PRINTFORML 「……딱히 말할 필요는 없을 것 같은데?」
				PRINTFORMDW 그저 변덕이라고 속으로 중얼거리며, 차갑게 식은 표정의 사토리를 바라보았다.
			CASE 1
				PRINTFORML 「네, 듣고 있어요. '눈'으로 보는 게 빠르긴 하지만」
				PRINTFORMDW 그렇게 말하는 사토리였지만, 그럼에도 무시하지 않는 모습에서 특유의 느낌을 받았다
			CASE 0
				PRINTFORML 「재미없는 이야기네요, 그것뿐인가요?」
				PRINTFORMDW 말과는 달리, 계속 듣고 싶다는 분위기를 풍기고 있다.
		ENDSELECT
	ENDIF
	PRINTFORMW 
ENDIF
RETURN 1
