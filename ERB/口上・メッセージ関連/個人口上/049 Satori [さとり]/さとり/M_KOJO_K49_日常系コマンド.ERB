	CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K49_305_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K49_305_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		RESETCOLOR ;custom code
		DRAWLINE
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		IF 陥落状態() == 5
			PRINTFORML 「주인님, 귀여워요, 후후, 착하다 착해」
			PRINTFORMDL 그렇게 말하며 머리를 쓰다듬는 감촉에, 편안함과 어색함이 동시에 밀려온다.
			PRINTFORMW 「『부끄러워』? 후후, 지금은 그런 거 신경 안 하셔도 괜찮아요」
			PRINTFORMDL 환한 미소를 지으며 사토리가 이쪽을 바라본다.
			PRINTFORML 「천천히 해요, 그렇죠」
			PRINTFORMDW 그 후에 보상 같은 것이 갖고 싶다는 시선에 쓴웃음이 떠올랐다.
		ELSE
			PRINTFORML 「주님, 저도 기분이 좋아요」
			PRINTFORMDL 무릎베개를 하면서 중얼거리는 사토리에게 자연스럽게 미소가 새어나온다.
			PRINTFORMW 「『별로 편하지 않아』? 후후, 그렇게 심술 부리는 게 즐거우신가요?」
			PRINTFORMDL 사토리가 어쩔 줄 모르는 듯한 표정을 짓는 것을 보는 것이 즐겁다고 마음속으로 중얼거리는 %CALLNAME:MASTER%
			PRINTFORML 「후후, 하지만 평소의 미소보다는, 절정에 달했을 때의 녹아내리는 얼굴을 보는 게 더 즐거운걸」
			PRINTFORMDW 쿠스쿠스 웃는 사토리의 말에 대답하지 않고 눈을 감았다.
		ENDIF
	ELSEIF 陥落状態() == 3
		PRINTFORML 「……후후, 이게 좋은 건가요?」
		PRINTFORMDW 뒷머리에 느껴지는 허벅지의 부드러움과 머리를 쓰다듬는 감촉에, 기분 좋음이 퍼져간다.
		PRINTFORML 「『가끔은 이런 것도 괜찮아』? 그렇네요, 저도 같은 기분이에요」
		PRINTFORMDW 어딘가 즐거워 보이는 사토리에게 그대로 몸을 맡겼다.
	ELSEIF 陥落状態() == 2
		RESETCOLOR ;custom code
		DRAWLINE
		IF ABL:TARGET:親密 > 5
			PRINTFORML 사토리는 어이없다는 듯 한숨을 내쉬며, %조사처리(CALLNAME:MASTER,"의")% 목에 손을 뻗는다.
		ELSEIF ABL:TARGET:親密 > 2
			PRINTFORML 사토리는 %조사처리(CALLNAME:MASTER,"를")% 보며 깊은 한숨을 쉬고 있다.
		ELSE
			PRINTFORML 사토리는 불쾌하다는 표정 그대로 가만히 있다……
		ENDIF
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		IF ABL:TARGET:親密 > 5
			PRINTFORML 「…………바보시네요, %조사처리(CALLNAME:MASTER,"는")%」
			PRINTFORMDW 뻗은 손으로 목을 붙잡고 살짝 힘을 주며 다가온다.
			PRINTFORML 「……왜 도망치지 않는 거예요? 『허벅지가 기분 좋다고』? ……정말 바보시네요」
			PRINTFORMDW 어이없다는 듯 말하면서도, 왠지 사토리는 더 이상 불평을 입에 담지 않고 있다.
		ELSEIF ABL:TARGET:親密 > 2
			PRINTFORML 「정말, 바보 같은 사람. 이렇게 무방비한 상태를 드러내다니. 이대로 죽여버릴까요?」
			PRINTFORMDW 그렇게 말하며, %조사처리(CALLNAME:MASTER,"의")% 목덜미를 양손으로 움켜쥐는 사토리
			PRINTFORML 「『못하면서』………………, 못하는 게 아니라 안 하는 것뿐이잖아요」
			PRINTFORMDW 강한 척을 하던 사토리가 그럼에도 불구하고 목덜미에서 손을 뗐다
		ENDIF
		RESETCOLOR
	ELSEIF 陥落状態() == 1
		IF ABL:TARGET:親密 > 5
			PRINTFORML 「후후, 이런 것이 좋다고 하다니, 특이하군요」
			PRINTFORMDW 이상하다는 듯 움직이는 사토리의 손에 안도감이 차오른다.
		ELSEIF ABL:TARGET:親密 > 2
			PRINTFORML 「……뭐가 재미있다는 거예요, 이런 거」
			PRINTFORMDW 어이없다는 표정으로 중얼거리면서도 손은 멈추지 않는 사토리를 보며 자연스럽게 미소가 떠진다.
		ENDIF
	ELSE
		PRINTFORML 「…………이런 게 기쁜 거예요? 이해가 안 돼요」
		IF ABL:TARGET:親密 > 2
			PRINTFORMDW 중얼거리면서도, %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬는 손은 멈추지 않는다.
		ELSE
			PRINTFORMDW 중얼거리며 %조사처리(CALLNAME:MASTER,"를")% 가만히 바라본다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
