@M_KOJO_SUCCESS_COM_K49_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K49_310
RETURN 1

@M_KOJO_MESSAGE_COM_K49_310
IF CFLAG:1496 == 2 && !RAND:2
	CALL PET49(1)
ELSEIF CFLAG:1496 == 1 && !RAND:2
	CALL ONRYO49()
ENDIF
IF 陥落状態() < 4 && 陥落状態() != 2 && (FLAG:70 || CFLAG:TARGET:睡眠 || CFLAG:うふふ == 2 || (BASE:酒気 < (MAXBASE:酒気 / 10) * 4))
	CALL TRAIN_MESSAGE
ELSE
	RESETCOLOR ;custom code
	DRAWLINE
ENDIF
CALL M_KOJO_MESSAGE_COM_K49_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K49_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;custom code
	SIF !RAND:10
		CALL FONT_AA_49(310)
	IF FLAG:70
		CALL STOP49
	ELSEIF CFLAG:睡眠
		SIF 陥落状態() >= 4 || TALENT:キス魔 || 陥落状態() == 2
			CALL TRAIN_MESSAGE
		CALL SLEEP49
	ELSEIF CFLAG:うふふ == 2
		SIF 陥落状態() >= 4 || TALENT:キス魔 || 陥落状態() == 2
			CALL TRAIN_MESSAGE
		CALL UFUFUTO49()
	ELSEIF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		IF PREVCOM == 305
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 무릎에 엎드린 채 사토리의 %HIP(TARGET)%에게 손을 뻗었다.
		ELSE
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 뒤에서 사토리의 %HIP(TARGET)%에 손을 뻗었다
		ENDIF
		PRINTFORML 사토리는 황홀한 표정으로, 스스로 엉덩이를 내밀며 애원해 왔다.
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		IF 陥落状態() == 5
			PRINTFORML 「하아, 하아, 응읏, 하후…… 기분 좋아……. 더, 주님 더요」
			PRINTFORMDL 녹아내린 미소를 지으며 엉덩이를 흔들며 재촉하는 사토리
			PRINTFORML 「더 꽉 안아주세요…… 사랑받는 사람에게 만져지는 거, 기뻐요」
			PRINTFORMDL 엉덩이를 흔들며 필사적으로 애원하는 사토리에, 이상한 심경이 들면서 단단하게 주무른다.
			PRINTFORML 「하후, 응읏, 엉덩이만 만져지는 건데, 안이 뜨거워지기 시작했어요」
			PRINTFORMDL 달콤한 목소리의 속삭임은 정욕을 불러일으키기에 충분했다.
		ELSE
			PRINTFORML 「후후, 우후후후, 기분이 좋습니다. 주님, 더 엉덩이 만져주세요」
			PRINTFORMDL 그렇게나 기분 좋은 걸까 하고 속으로 생각하는 동시에 사토리가 부끄러운 듯 미소를 지었다
			PRINTFORMW 「그게, 몸도 기분 좋지만, 아후…… 응, 해주고 있다는 것을 안다는 것이 좋습니다」
			PRINTFORMDL 그 말에 고개를 살짝 기울이며 부드럽게 엉덩이를 쓰다듬는다
			PRINTFORML 「응, 시간 정지 없이 예뻐해 주고 있다는 것이 기쁩니다」
			PRINTFORMDW 귀여운 말을 사랑스러운 미소로 들으며 더욱 단단하게 주무르기 시작했다
		ENDIF
		RESETCOLOR
	ELSEIF 陥落状態() == 3
		PRINTFORML 「하아…… 응, 기분 좋아……て, 이런 건 그 교감할 때 하는 거야」
		PRINTFORMDW 지금도 서로 교감하고 있는데, 그렇게 생각한 순간 얼굴을 붉힌 사토리에 이마를 찰싹 맞았다
		PRINTFORML 「교감의 의미를, 일부러 오해하지 말아 주세요, 응읏!」
		PRINTFORMDW 미안하다고 사과하면서도 더욱 꽉 쥐어 주었다
	ELSEIF 陥落状態() == 2
		RESETCOLOR ;custom code
		DRAWLINE
		IF PREVCOM == 305
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 무릎을 꿇은 채 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%에 손을 뻗었다.
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 뒤에서 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%에 손을 뻗었다.
		ENDIF
		PRINT 사토리는
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 짜증 난 듯이 %조사처리(CALLNAME:MASTER,"의")% 손등을 꼬집어 올렸다
			CASE 2,3
				PRINTFORML 불쾌하다는 듯 얼굴을 찌푸리며 %조사처리(CALLNAME:MASTER,"의")% 손을 세게 뿌리쳤다
			CASE 4
				PRINTFORML 불쾌한 표정을 지으면서도 %조사처리(CALLNAME:MASTER,"가")% 당하는 대로 되어버렸다...
		ENDSELECT
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		IF ABL:親密 >= 10
			PRINTFORML 「……그러니까…… 하아…… 바보에게 무슨 말을 해도 소용없어요」
			PRINTFORMDW 용서가 떨어졌으니, 마음껏 사토리의 엉덩이 살의 부드러움을 만끽한다.
			PRINTFORML 「응읏, 후우…… 아후…… '야한 목소리'? ……착각이에요」
			PRINTFORMDW 입술을 붉히는 사토리는 살짝 엉덩이를 빼낸다
		ELSEIF ABL:親密 > 5
			PRINTFORML 「그러니까, 만지지 말라고 말씀드렸잖아요」
			PRINTFORMDW 세게 뿌려진 손의 통증에, 어쩐지 쓴웃음이 떠오른다.
			PRINTFORML 「……아픈 걸 즐기는, 변태에게도 정도가 있네요」
			PRINTFORMDW 그렇게 중얼거리는 사토리의 뺨이, 어째선지 살짝 붉어져 있다.
		ELSE
			PRINTFORML 「이 변태, 어서 이 손을 놓으세요」
			PRINTFORMDW 격렬한 고통에 마지못해 사토리의 엉덩이에서 손을 뗀 %CALLNAME:MASTER%
			PRINTFORML 「이걸 계책 삼아 다시는 이러지 말아 주세요」
			PRINTFORMDW 이번에는 시간을 멈추려 했다는 것을 눈치챘는지, 분노를 담은 사토리가 노려왔다.
		ENDIF
		RESETCOLOR
	ELSEIF 陥落状態() == 1
		IF ABL:親密 >= 10
			PRINTFORML 「후후, H라는 거니까. 음, 이런 것이 좋다고 하다니, 우후후후」
			PRINTFORMDW 어딘가 기쁜 듯한 미소를 지으며 사토리가 허리를 뒤로 빼고 다가온다
		ELSEIF ABL:親密 > 5
			IF !(TALENT:PLAYER:2 & 1)
				PRINTFORML 「그만해 주세요, 이런 것은 부적절하다고 생각합니다」
				PRINTFORMDW 약간 겁먹은 듯한 표정으로 자신을 바라보는 사토리에게, 되받아칠 말이 떠오르지 않는다.
			ELSE
				PRINTFORML 「정말, 이런 건 좀 아닌 것 같아요」
				PRINTFORMDW 난감한 표정의 사토리가 조심스럽게 이쪽 손을 밀쳐냈다.
			ENDIF
		ELSE
			PRINTFORML 「아무리 그런 관계라도, 해도 되는 것과 안 되는 것이 있다!」
			PRINTFORMDW 입술을 깨문 사토리에 강하게 손을 뿌리쳐졌다
		ENDIF
	ELSE
		IF ABL:親密 > 5
			IF !(TALENT:PLAYER:2 & 1)
				PRINTFORML 「꺅! 도, 어디를 만지고 계세요오옷!」
				PRINTFORMDW 드물게 귀여운 비명을 지르며 사토리가 노려본다.
			ELSE
				PRINTFORML 「그런 곳은, 만지지 말아 주십시오」
				PRINTFORMDW 입술을 날카롭게 만든 사토리에 가볍게 손을 뿌려졌다.
			ENDIF
		ELSE
			PRINTFORML 「어디를 만지고 있는 거예요!」
			PRINTFORMDW 꾸짖는 소리와 함께 손을 세게 뿌려졌다
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K49_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K49_311
RETURN 1

@M_KOJO_MESSAGE_COM_K49_311
IF CFLAG:1496 == 2 && !RAND:2
	CALL PET49(1)
ELSEIF CFLAG:1496 == 1 && !RAND:2
	CALL ONRYO49()
ENDIF
SIF 陥落状態() < 4 && 陥落状態() != 2 && (FLAG:70 || CFLAG:TARGET:睡眠 || CFLAG:うふふ == 2 || (BASE:酒気 < (MAXBASE:酒気 / 10) * 4))
	CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K49_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K49_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		CALL STOP49
	ELSEIF CFLAG:TARGET:睡眠
		SIF 陥落状態() >= 4 || TALENT:キス魔 || 陥落状態() == 2
			CALL TRAIN_MESSAGE
		CALL SLEEP49
	ELSEIF CFLAG:うふふ == 2
		SIF 陥落状態() >= 4 || TALENT:キス魔 || 陥落状態() == 2
			CALL TRAIN_MESSAGE
		CALL UFUFUTO49()
	ELSEIF (BASE:酒気 > (MAXBASE:酒気 / 10) * 4)
		RESETCOLOR ;custom code
		DRAWLINE
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		CALL DRUNKER49()
	ELSEIF 陥落状態() >= 4
		RESETCOLOR ;custom code
		DRAWLINE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% \@ CFLAG:TARGET:添い寝中 ? 함께 잠드는 #  \@사토리에 꽉 안겼다
		PRINTFORML 사토리는 황홀한 표정을 지으며 스스로도 손을 뻗어 단단히 껴안아 왔다
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		IF 陥落状態() == 5
			PRINTFORML 「주님께 안기면, 마음이 뜨거워져요」
			PRINTFORMDL 자신의 가슴팍에 머리를 기댄 채, 사토리가 달콤한 목소리로 속삭인다
			PRINTFORML 「『몸만이 아니란 건가』? 후후, 물론 몸도 마찬가지지만요」
			PRINTFORMDL 그렇게 말하며 가슴을 비비고 오는 사토리
			PRINTFORML 「이대로 할래요? 저는 대환영이에요」
			PRINTFORMDL 녹아내릴 듯한 미소로 중얼거리는 사토리를, 애매하게 대답하면서 끌어안은 팔에 힘을 주었다.
		ELSE
			PRINTFORML 「하아, 주님께 안겨 있다는 걸 생각하니 가슴이 뜨거워져요」
			PRINTFORMDL 꼭 안겨오는 사토리의 심장 소리에 마음이 평온해진다.
			PRINTFORMW 「후후, 주인님도 저한테 이렇게 해주시는 게 기쁘시죠」
			PRINTFORMDL 딱히 기쁘다고는 말하지 않고 그렇게 대답한 뒤, 사토리가 황홀하게 웃는 모습에 '했구나'라고 중얼거린다.
			PRINTFORML 「어머, 주님께서 거짓말을 하시다니 드물네요. 후후, 부끄러우신가 봐요」
			PRINTFORMDW 승리감에 도취된 사토리를 향해 한숨을 쉬며 더욱 강하게 끌어안았다.
		ENDIF
		RESETCOLOR
	ELSEIF 陥落状態() == 3
		PRINTFORML 「후후, 이렇게 해달라고 하다니, 귀여운 면도 있네요」
		PRINTFORMDW 그저 변덕이라고 답하면서도, 그럼에도 안아준 사토리를 놓지 않는 %CALLNAME:MASTER%
		PRINTFORML 「뭐, 저도 기쁘니까 상관없지만요. 후후, 정말 좋은 기분입니다」
		PRINTFORMDW 그렇게 말하며, 더욱 강하게 자신을 끌어안는 사토리에게 되돌려 할 말이 없었다
	ELSEIF 陥落状態() == 2
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 사토리의 등 뒤에서 꽉 껴안았다.
		PRINTFORML 사토리는 %조사처리(CALLNAME:MASTER,"의")% 옆구리에 팔꿈치로 치고 들어왔다.
		PRINTL
		SIF FLAG:口上色
			CALLFORM M_KOJO_COLOR_K49
		PRINTFORML 「아파? 그럼 어서 떨어져 줘」
		PRINTFORMDW 잠시 떨어졌다가 다음 순간, 이번에는 양팔을 움직일 수 없도록 단단하게 끌어안았다.
		PRINTFORML 「그러니까 놓으라고 말하고 있잖아요! 이 색골 변태 음란마 같아!」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 사토리의 몸이 가진 부드러움과 향을 만끽했다.
		RESETCOLOR
	ELSEIF 陥落状態() == 1
		PRINTFORML 「타인에게 허락 없이 안기는 것은 좀 그렇다고 생각한다만」
		PRINTFORMDW 입가에 부드러운 미소를 짓는 사토리를 보며, 기쁘다면서 속으로 중얼거리고 지긋이 응시되었다.
	ELSE
		PRINTFORML 「……무슨 하시는 거예요, 갑자기」
		PRINTFORMDW 얼굴을 붉히며 입술을 삐죽 내민 사토리를 잠시 안아주었다.
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K49_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K49_312
RETURN 1

@M_KOJO_MESSAGE_COM_K49_312
IF CFLAG:1496 == 2 && !RAND:2
	CALL PET49(1)
ELSEIF CFLAG:1496 == 1 && !RAND:2
	CALL ONRYO49()
ENDIF
SIF 陥落状態() < 4 && !TALENT:キス魔 && 陥落状態() != 2 && (TALENT:恋慕 || TALENT:184 || TALENT:185  || FLAG:70 || CFLAG:TARGET:睡眠 || CFLAG:うふふ == 2 || (BASE:酒気 < (MAXBASE:酒気 / 10) * 4) || EXP:TARGET:キス経験 > 1)
	CALL TRAIN_MESSAGE
IF 陥落状態() >= 4 || TALENT:キス魔 || 陥落状態() == 2
	RESETCOLOR ;custom code
	DRAWLINE
ENDIF
IF EXP:TARGET:キス経験 == 1
	PRINTFORML 얼굴을 가까이 한 %조사처리(CALLNAME:MASTER,"에게")%, 사토리는 순간 몸을 경직시킨다.
	PRINTFORML 하지만 도망치려 하지 않고 눈을 감은 채, 살짝 입술을 내밀어 왔다.
	PRINTFORML 잠시 후, 사토리에게 처음으로 키스를 나누었다.
	PRINTL
	SIF FLAG:口上色
		CALLFORM M_KOJO_COLOR_K49
ENDIF
