	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「정말 즐거운 시간을 보내는 것 같네.」
			PRINTFORMW 「내 생각엔 이게 좀 불공평하잖아...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「헤이, 그렇게 골반 흔들지 마!」
			PRINTFORMW 「문질리네... 그리고 이상한 기분이 들어...%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「네가 여자 가슴을 네 즐거움을 위한 장난감처럼 다루고 있다니...」
			PRINTFORMW 「조금 더 부드럽게 해줄래...%UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
