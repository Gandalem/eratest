;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K106_80
CALL M_KOJO_MESSAGE_COM_K106_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K106_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「나를 위해 하나를 문 것...?」
			PRINTFORMW 「...음, 알겠어.」
			PRINTFORMDW 스미레코는 어색하게 손을 당신의 성기 위아래로 움직인다.
			PRINTFORMW 「우으... 꽤... 단단한 편이네... %UNICODE(0x2764)%」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「더 힘을 좀 줄까?」
			PRINTFORMW 「이건 어때... 아파, %CALLNAME:MASTER%아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「있잖아, 나 아이디어 생각해 봤어 - 심령 직업이야!」
			PRINTFORMW 「뭐야, 원하지 않아? 뭐, 그럴 줄 알았지.」
		ELSE
			PRINTFORMW 「이거 좀 좋아지기 시작한 것 같아...」
			PRINTFORMW 「잘하고 있어, 버텨봐! %UNICODE(0x2764)% 할 수 있어! %UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
