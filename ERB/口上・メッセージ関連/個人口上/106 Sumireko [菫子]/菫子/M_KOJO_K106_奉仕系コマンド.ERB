;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K106_81
CALL M_KOJO_MESSAGE_COM_K106_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K106_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「다시 말해? 내... 입으로 하길 원한다고?」
			PRINTFORMW 「내 말은... 그런 게 있다는 건 알고 있었지만...」
			PRINTFORMW 「.........」
			PRINTFORMW 「아-알았어, 해줄게! 그냥 끝내버려야지, 휴...」
			PRINTFORMDW 스미레코는 수줍게 네 거기를 그녀의 입속으로 인도한다.
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「%RANDLIPS(,"suck")%...」
			PRINTFORMW 「흐읍?! 아앗, 그 시시한 칭찬은 이제 그만해, 난 이게 전혀 서툴러...%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「오르기 직전에 나한테 알려주는 게 좋을 거야...」
			PRINTFORMW 「정액은 상당히 역겨우니까 알아둬.」
		ELSE
			PRINTFORMW 「%RANDLIPS(,"suck")%...!」
			PRINTFORMW 「%FSYN("lips_over")%... 음-음? 만족했니, 응?%UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
