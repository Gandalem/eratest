@M_KOJO_MESSAGE_COM_K106_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
	CASE 1
		IF TALENT:恋人
			PRINTFORMW 「Yup-yup, just what I needed! Delish!」
			PRINTFORMW 「Just can't miss drinking your tea whenever \@ CFLAG:106:K106_STRANGERS ?I#you\@ arrive at Gensokyo, you know.」
			PRINTFORMDW Sumireko is happily sipping your tea.
			PRINTFORMDW ...Shall I brew it for you every morning, then?
			PRINTFORMW 「Th——That's, well.. Uuuu...」
			PRINTFORMDW Sumireko's cheeks turn bright red...
		ELSEIF TALENT:思慕 || TALENT:恋慕
			PRINTFORMW 「Yes, yes! Thaat's what I wanted!」
			;original line was the same as above, I think it's a good replacement
			PRINTFORMW 「\@ CFLAG:106:K106_STRANGERS ?I wish I could drink your tea in real life, too.#I ought to drink your tea in real life sometimes.\@」
			PRINTFORMDW Sumireko happily sips your tea.
		ELSE
			PRINTFORMW 「Huuuh... You have so much talent for this, apparently.」
			PRINTFORMW 「I can't deny that it's a bit plain, though.」
			PRINTFORMDW Sumireko giggles while sipping your tea.
		ENDIF
	CASE 0
		IF TALENT:恋人
			PRINTFORMW 「They say women who drink Japanese tea have healthier babies.」
			PRINTFORMW 「...Don't overthink it though, I d-didn't mean anything by that!」
			PRINTFORMDW Sumireko continues sipping your tea with a blush on her cheeks.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Apparently, Japanese tea is good for your beauty and health.」
			PRINTFORMW 「Does that mean you want me to stay beautiful and healthy forever?」
			PRINTFORMDW Sumireko continues sipping your tea with a blush on her cheeks.
		ELSEIF TALENT:思慕
			PRINTFORMW 「Drinking tea in a dream is kind of weird.」
			PRINTFORMDW Sumireko continues sipping your tea...
		ELSE
			PRINTFORMW 「A plastic bottle of some Japanese tea is more than enough for me though.」
			PRINTFORMDW Then you don't really have to drink this, right?
			PRINTFORMW 「I'll take what I'm offered.」
			PRINTFORMDW Sumireko continues sipping your tea...
		ENDIF
	CASEELSE
		IF TALENT:恋人
			PRINTFORMW 「A-Are you sure you used high-quality leaves for this?」
			PRINTFORMW 「I mean the taste is kinda strange... Err, I mean, it's *unique*.」
			PRINTFORMDW You stop Sumireko from forcing herself to drink it.
		ELSEIF TALENT:思慕 || TALENT:恋慕
			PRINTFORMW 「Let's see, is there any psychic power that would make this tea palatable...」
			PRINTFORMW 「...Guess not.」
			PRINTFORMDW Sumireko barely takes a sip before stopping...
		ELSE
			PRINTFORMW 「Eww, yuck... It's terrible!」
			PRINTFORMDW Sumireko frowns as soon as she takes the sip...
		ENDIF
	ENDSELECT
ENDIF
RETURN 1
