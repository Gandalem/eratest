	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORMDW You approach the oblivious Sumireko from behind...
			PRINTFORMDW And gently hug her.
			PRINTFORMW 「Hyah～?! %CALLNAME:MASTER%?!」
