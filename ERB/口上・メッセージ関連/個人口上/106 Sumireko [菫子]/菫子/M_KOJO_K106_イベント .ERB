	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「Alright, that's enough. I forgive ya.」
		PRINTFORMW 「\@ CFLAG:106:K106_STRANGERS ?But be more careful, all right?#Although, wouldn't it be more appropriate if you apologized in real life?\@」
		PRINTFORMDW Sumireko looks at you in dismay.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「Okay, okay, I won't kill you.」
		PRINTFORMDW But you already tried to...!
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「Do you really think you'd be forgiven that easily?」
		PRINTFORMW 「You better watch out for when you're alone at night.」
		PRINTFORMDW Sumireko's hatred has not subsided.
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
