			ELSE
				PRINTFORMW 「..."You're actually wearing clothes, huh"? Hey, w-what are you saying?!」
				PRINTFORMW 「Uuh, it's times like these I wish you didn't see me...」
				PRINTFORMDL You wonder if she's remembering the "alone time" you shared with her before going to sleep?
				PRINTFORMDW Sumireko's face is flushed red...
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
			PRINTFORMW 「I-It's not like I wanted to see you or anything...」
			PRINTFORMDW Sumireko's face is slightly red.
		ELSEIF TALENT:思慕
			PRINTFORMW 「Oh, %CALLNAME:MASTER%.」
			PRINTFORMW 「\@ CFLAG:106:K106_STRANGERS ?You still stick out like a sore thumb, huh?#You fell asleep in class today.\@」
			PRINTFORMDW You didn't want to hear that from Sumireko...
		ELSE
			PRINTFORMW 「Oh, %CALLNAME:MASTER%.」
			PRINTFORMW 「\@ CFLAG:106:K106_STRANGERS ?Your face looks kinda dumb right now.#You look like an even bigger idiot in my dream.\@」
			PRINTFORMDW Sumireko seems to be ill-tempered.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
