@M_KOJO_EVENT_K106_21(ARG,ARG:1)
;口上主はARG
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW (이건 나쁘다... 내가 감히 이런 짓을 하다니--)
		PRINTFORMDW 스미레코는 홀로 크게 당혹스러운 표정을 짓고 있다.
		PRINTFORMW (요즘 나는 \@ CFLAG:106:K106_STRANGERS ? 평소보다 더 꿈을 꾸고 있다. # 학교에 가는 것 \@를 고대해 왔다.)
		PRINTFORMW (아니 정확히 그 \@ CFLAG:106:K106_STRANGERS ? 꿈 # 학교 \@ 자체는 아니지만...)
		PRINTFORMW (%CALLNAME:MASTER%곁에 있는 게 너무 즐거워서 믿기지 않는다!)
		PRINTFORMDW 현실에서, 그리고 이상향인 윤색쿄에서도, 심지어 그녀의 환상 속에서도...
		PRINTFORMDW 스미레코는 자꾸 당신 생각을 하게 된다.
		PRINTFORMW (이것은 내가 사랑하는 것처럼 들리게 해 %HIM_HER(MASTER)%...!)
		PRINTFORMW (하지만 우리에게는 기묘한 연결고리가 있다.)
		PRINTFORMW (...) 그리고 우리는 로맨스 만화 속 커플처럼 비밀을 공유한다...
		PRINTFORMW (어쩌면 운명이 우리를 이어주는 것일지도 몰라...!)
		PRINTFORMDW 스미레코는 그렇게 소녀다운 결론에 도달한 자신을 거의 스스로 때릴 지경이다.
		PRINTFORMDW 그녀는 당신에 대해 몇 시간 동안 계속 떠들다가 잠이 든다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW (요즘 잠드는 것을 고대하고 있는 것만 같다.)
		PRINTFORMDW 깨어있음과 수면 사이에서... 스미레코는 꿈결 같은 생각에 잠긴 채 고민한다.
		PRINTFORMW (현실은 여전히 지루했고, 그보다는 환상계의 레이무치 일행을 만나는 것이 더 흥미로웠다.)
		PRINTFORMW (매일 잠드는 것을 갈망하고 있었다...)
		PRINTFORMW (하지만 이번엔 느낌이 다르다...)
		PRINTFORMDW 스미레코는 그 이유를 알 수 없었다.
		PRINTFORMW (\@ CFLAG:106:K106_STRANGERS ? 나는 항상 생각했지, 정말 특별한 사람을 만날 수 있다면 어떨까 # 환상계에서 너를 보게 될 거라고는 상상도 못 했어 \@...)
		PRINTFORMW (%조사처리(CALLNAME:MASTER,"를")% 꿈에서 보기 시작한 이후로 점점 더 생각해왔다...)	
		PRINTFORMW (설마... 내가 %HIM_HER(MASTER)%를 보는 것을 고대하고 있다고?! )
		PRINTFORMW (...말도 안 돼. 그러니까, %HE_SHE(MASTER)%가 그렇게 평범한 주제에 친구처럼 계속 말을 걸어주니까...)
		PRINTFORMW (%HIM_HER(MASTER)%에서 도대체 뭘 볼 수 있겠어? 분명 내 상상일 거야... 그냥 잠 좀 자야지...)
		PRINTFORMDW 스미레코는 심호흡을 하며 스스로를 진정시키려 노력한다.
		PRINTFORMDW ...하지만 당신의 모습이 머릿속에 떠나지 않아 그럴 수 없었다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛欲取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛人取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;セフレ取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
