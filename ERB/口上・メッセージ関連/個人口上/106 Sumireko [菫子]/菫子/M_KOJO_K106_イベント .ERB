LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「Oh, %CALLNAME:MASTER%!」
			IF CFLAG:106:K106_STRANGERS
				PRINTFORMW 「같이 무언가 하고 싶어?」
			ELSE
				PRINTFORMW 「..."옷을 입고 있네, 응"? 이봐, 뭐-무슨 소리 하는 거야?!」
				PRINTFORMW 「흐음, 이런 때엔 네가 나를 보지 않았으면 좋겠어...」
				PRINTFORMDL 당신은 그녀가 기억하는지 궁금하다 "혼자만의 시간" 잠들기 전에 그녀와 함께 했던
				PRINTFORMDW 스미레코의 얼굴이 새빨갛게 달아오른다.
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
			PRINTFORMW 「이-너를 보려고 했던 건 아니야, 뭐 그런 거...」
			PRINTFORMDW 스미레코의 얼굴이 살짝 붉어진다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「Oh, %CALLNAME:MASTER%.」
			PRINTFORMW 「\@ CFLAG:106:K106_STRANGERS ?너 아직도 눈에 확 띄는구나, 응?#오늘 수업 중에 잠들었어.\@」
			PRINTFORMDW 스미레코에게서 그런 말을 듣고 싶지 않았는데...
		ELSE
			PRINTFORMW 「Oh, %CALLNAME:MASTER%.」
			PRINTFORMW 「\@ CFLAG:106:K106_STRANGERS ? 지금 네 얼굴은 좀 바보 같아. # 내 꿈속에선 더 큰 바보처럼 보여. \@」
			PRINTFORMDW 스미레코는 심술이 난 것 같다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「어이, 저기 %CALLNAME:MASTER%아니야?」
			PRINTFORMW 「널 보게 되다니 정말 기쁘다 \@ CFLAG:106:K106_STRANGERS ? in # 심지어 내 꿈에서도.」 \@
			PRINTFORMDW 스미레코가 당신에게로 걸어온다...
		ELSEIF TALENT:恋慕
			PRINTFORMW 「이봐, 무슨 일로 여기 왔어, %CALLNAME:MASTER%?」
