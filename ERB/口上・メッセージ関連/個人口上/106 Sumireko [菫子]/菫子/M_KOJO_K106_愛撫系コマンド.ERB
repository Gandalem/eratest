;1,クンニ
;==================================================

@M_KOJO_MESSAGE_COM_K106_1
CALL M_KOJO_MESSAGE_COM_K106_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K106_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「잠깐, 뭐--?! 설마 나한테... 핥으려고 하는 거야?」
			PRINTFORMDW 당신은 스미레코의 다리를 벌리고 천천히 그녀의 은밀한 곳 쪽으로 혀를 움직인다.
			PRINTFORMW 「음... 더러운 곳이 아니길 바라는데...」
			PRINTFORMW 「더럽지 않은 곳은 단 하나도 없다니, 그렇게 말하는 거냐? 젠장...」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「으음... 크흠...」
			PRINTFORMW 「%MOAN()%%UNICODE(0x2764)% %MOAN()%%UNICODE(0x2764)% %MOAN("m")%!%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「네 혀가 거기서 미쳐 날뛰고 있구나...」
			PRINTFORMW 「네가 이렇게 키스 실력이 좋은 것도 당연하네...」
		ELSE
			PRINTFORMW 「더 축축해지고 있어...?」
			PRINTFORMW 「제발, 그런 말 하지 마... 창피하잖아...」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
