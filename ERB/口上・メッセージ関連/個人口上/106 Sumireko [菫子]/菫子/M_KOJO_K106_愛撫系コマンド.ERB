;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「나를 꼭 안아주고 키스해줘, 어서...」
			PRINTFORMW 「음... 추우네...」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「키스하는 법을 정말 잘 알다... 혹시 다른 사람과 연습하고 있는 거야?」
			PRINTFORMW 「후후, 농담이야...%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「계속될 수 있다면 좋을 텐데.」
			PRINTFORMW 「하지만 그건 너에게 너무 과할지도 몰라...」
			PRINTFORMW 「...음, 나도 버티지 못할 것 같아%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「네가 마시게 해줄 거야... 내 침을...%UNICODE(0x2764)%」
			PRINTFORMW 「%FSYN("lips_muffle")%, %TOLOWER(FSYN("lips_muffle"))%...- %RANDKISS("kiss")%!%UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
