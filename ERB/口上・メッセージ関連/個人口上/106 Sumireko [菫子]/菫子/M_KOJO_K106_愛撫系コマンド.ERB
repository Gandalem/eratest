@M_KOJO_MESSAGE_COM_K106_0
CALL M_KOJO_MESSAGE_COM_K106_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K106_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「나를 만지고 싶다는 거구나... 좋아, 마음대로 해...」
			PRINTFORMDW 당신은 스미레코의 몸을 더듬는다... 그녀의 비단 같은 피부는 베개처럼 부드럽고 따뜻하다.
			PRINTFORMDW 당신은 스미레코의 온기를 최대한 즐긴다...
			PRINTFORMW 「오-오옷...」
			PRINTFORMW 「만져줘... 더 만져줘...%UNICODE(0x2764)%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「음... 흐으...」
			PRINTFORMW 「나를 놀리려는 거야...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「나에게 좀 더 만져줘...」
			PRINTFORMW 「하안! 응, 그만둬 %UNICODE(0x2764)% 딱 그렇게」
		ELSE
			PRINTFORMW 「당신이 나를 만지는 방식은... 정말 부드럽네, 응...」
			PRINTFORMW 「하지만 괜찮아... 당신이 조금 더 세게 해줘도 %UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
