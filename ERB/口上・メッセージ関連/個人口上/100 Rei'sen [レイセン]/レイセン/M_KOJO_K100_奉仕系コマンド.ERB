@REISEN_FELLATIO
;舌技術２以上
IF ABL:舌 >= 2
	;今射精した
	IF NOWEX:PLAYER:11
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「즈즈…… 쭉……읏 HPH 이대로, 입에…… HPH 스르륵……읏 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 목구멍 깊숙이 페니스를 물고, 그대로 사정하도록 재촉해 온다.
				CALL HPH_PRINT,@"「~~~큭흑, 후우, 흐윽흐윽후우... 응으... 읏」","W"
			CASE 1
				CALL HPH_PRINT,@"「츄……럴래……HPH 사정하고 싶어\@ TALENT:恋慕 ? 의……? 좋아 # 뭐예요...? 좋아요 \@……HPH」","L"
				PRINTFORMDL 끈적한 %조사처리(CALLNAME:TARGET,"의")% 공격에 굴복한 페니스는 자비를 구하듯 끝에서부터 앞서 흘리는 눈물을 흘리고 있다.
				PRINTFORMDW 결정타로 민감한 등줄기를 혀로 간지럽히자, %조사처리(CALLNAME:MASTER,"는")% 더 이상 참을 수 없었다.
			CASE 2
				CALL HPH_PRINT,@"「큭…… 츄릅…… 읏 HPH 움찔움찔하면서…… 빨아들여…… HPH 응쥬…… 읏 HPH」","L"
				PRINTFORMDL 사정이 임박했음을 감지한 %조사처리(CALLNAME:TARGET,"는")%, %조사처리(CALLNAME:MASTER,"의")% 허리에 손을 둘 뿐, 페니스에 격렬하게 빨아들였다.
				PRINTFORMDW 입가에서 침이 흘러내리는 것도 개의치 않는 열성적인 봉사에, %조사처리(CALLNAME:MASTER,"는")% 희열 속에 몸을 들썩이며 본능적으로 사정했다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「그읍…… 응……큭 HPH 후윽…… 쭉 늘어……큭 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 사랑스러운 듯 눈을 가늘게 뜨고, 천천히 음미하듯 페니스를 핥아 빨고 있다.
				PRINTFORMDW 익숙해진 봉사로 %조사처리(CALLNAME:MASTER,"를")% 기쁘게 하는 그 표정에서는 여유조차 느낄 수 있었다.
			CASE 1
				CALL HPH_PRINT,@"「여기, 약한 곳이네 \@ TALENT:恋慕 ? 이쪽이야 # 저쪽이야 \@그렇지……? HPH ぺ차……츄……읏HPH」","L"
				PRINTFORMDL 당신의 약점을 다 알고 있다는 듯, %조사처리(CALLNAME:TARGET,"는")% 페니스에 혀를 갖다 대고 넘쳐흐르는 선주를 빨아들이고 있다.
				CALL HPH_PRINT,@"「후후, 거시기 기분 좋아 보이네……. 귀여워……. HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「핥짝……츄……읏 HPH 아무읏……주르륵……읏 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 사타구니에 얼굴을 파묻고, 정신없이 페니스를 빨아들이는 %CALLNAME:TARGET%
				CALL HPH_PRINT,@"「음크…… 조금만 더…… 큭, 하아후…… 쪽…… 큭, 하아후」","W"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 입안에 고인 쿠퍼액을 소리 내며 삼키더니, 다시 봉사를 재개했다…….
		ENDSELECT
	ENDIF
	;それ以外
ELSE
	;今射精した
	IF NOWEX:PLAYER:11
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「쿠프…… 후우…… 읏, 쥬루…… 쥬포…… 읏」
				PRINTFORMDL 사정이 가까워졌음을 느꼈는지, 아니면 빨리 끝나길 바랐는지, %조사처리(CALLNAME:TARGET,"의")% 구강 성교가 점차 격렬해져 간다……
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 머리를 쓰다듬으며 사정을 예고하자, 그녀는 결심한 듯 목구멍 깊숙이 페니스를 물어넣었다.
				PRINTFORMW 「응, 응응…… 윽! 구부…… 우! 크윽…… 고쿠…… 읏」
			CASE 1
				PRINTFORML 「\@ TALENT:恋慕 ? 더……. ? 응……. 해볼게 # 더 깊숙이요...? 네 \@……응, 크큿……윽」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 요구에 응하여, %조사처리(CALLNAME:TARGET,"는")% 천천히 조심스럽게 페니스를 삼켜 나간다.
				PRINTFORMDL 마침내 성기 전체가 삼켜진 곳에서, %조사처리(CALLNAME:MASTER,"는")% 폭발적으로 정액을 분출했다.
				PRINTFORMW 「윽! 그, 으읍……후우응……. 츄릅……읏, 후」
			CASE 2
				PRINTFORML 「흡…… 으응…… 츄릅…… 음, 크윽……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 때때로 메스꺼워하면서도, %조사처리(CALLNAME:MASTER,"의")% 페니스를 물고 필사적으로 혀를 움직이고 있다.
				PRINTFORML 「하아앗…… 언제든, 가셔도 좋아요 \@ !TALENT:恋慕 ? 입니다 #  \@부터…… 하푸읏, 으응」
				PRINTFORMDW 이윽고 %조사처리(CALLNAME:MASTER,"가")% 절정에 다다르더라도, 사정의 맥동이 잦아들 때까지 %조사처리(CALLNAME:TARGET,"의")% 봉사는 멈추지 않았다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응, 쿠프…… 후우…… 츄릅……앗」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 하는 대로 혀를 움직여 봉사하고 있다.
				PRINTFORMW 「될까…… 츄…… 하아…… 하아…… \@ TALENT:恋慕 ? 기분 좋으세요 # 제대로 하고 있나요 \@……?」
			CASE 1
				PRINTFORML 「츄…… 츄풉……읏, 응…… 후우…… 앗」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 성기의 끝을 입에 머금고, 그 촉촉한 입술로 귀두를 부드럽게 다루고 있다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 봉사를 칭찬하자, %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 눈을 가늘게 뜨며 미소 지었다.
			CASE 2
				PRINTFORML 「핥아... 먹을 수 있어...읏, \@ TALENT:恋慕 ? 조금만 짜서... 쓰네 # 조금만, 시큼하네요 \@……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 의사와 관계없이 흘러나오는 쿠퍼액을 핥아먹고 있다.
				PRINTFORMW 「하지만…… \@ TALENT:恋慕 ? 중독되는 맛 # 싫지 않아요 \@……츄... 먹어줘...읏」
		ENDSELECT
	ENDIF
ENDIF
