@M_KOJO_MESSAGE_COM_K100_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;お掃除フェラ
	ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
		;精液中毒４以上
		IF ABL:精液中毒 > 4
			CALL HPH_PRINT,@"「많이 나와욧\@ !TALENT:恋慕 ? 좋아 #  \@씨……후으읍……츄릅……읏HPH」","L"
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 목구멍 깊숙이 페니스를 물고, 구강 전체를 사용해 페니스를 매만지고 있다.
			PRINTFORMDL 천박하게 얼굴을 일그러뜨리며 열성적으로 청소하는 그녀의 머리를, %조사처리(CALLNAME:MASTER,"는")% 부드럽게 계속 쓰다듬어 주었다.
			CALL HPH_PRINT,@"「츄…… 하아……읏 HPH \@ TALENT:恋慕 ? 또 커졌네 # 예뻐졌어 \@…… HPH」","L"
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 요도에 남은 정액까지 빨아올리더니, 겨우 입을 뗐다……
			RETURN 1
			;精液中毒３以下
		ELSE
			PRINTFORML 「청소해 줄게 \@ TALENT:恋慕 ? 해줄게 # 할게 \@네……아무……츄릅……읏」
			PRINTFORMDL 정사의 흔적을 아직 농후하게 남긴 페니스에 %조사처리(CALLNAME:TARGET,"는")% 공손히 혀를 움직인다
			PRINTFORMDW 부착된 체액 전부를 핥아먹을 무렵, %조사처리(CALLNAME:MASTER,"의")% 것은 다시 임전태세를 갖추고 있었다
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		CALL REISEN_FELLATIO
		RETURN 1
	ENDIF
ENDIF
RETURN 1
