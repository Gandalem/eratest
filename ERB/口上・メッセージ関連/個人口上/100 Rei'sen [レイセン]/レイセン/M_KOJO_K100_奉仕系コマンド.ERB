@M_KOJO_MESSAGE_COM_K100_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧３以上
	ELSEIF ABL:技巧 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「더 강하게 해 줄게\@ TALENT:恋慕 ? 할게 # 하네 \@……후헵」","L"
					PRINTFORMDL 평소라면 고통으로 느껴졌을 만한 취급조차도, 사정 직전의 페니스는 그것들을 모두 쾌감으로 바꾸고 있었다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 황홀한 듯 %조사처리(CALLNAME:MASTER,"를")% 바라보며 절정의 순간까지 봉사의 손길을 늦추지 않았다.
				CASE 1
					CALL HPH_PRINT,@"「흐읍! HPH 아, 하아…… 굉장해, 가득…… HPH」","L"
					PRINTFORMDL 마침내 한계에 다다른 %조사처리(CALLNAME:MASTER,"의")% 페니스에서, 대량의 정액이 분출해 나간다…….
					CALL HPH_PRINT,@"「\@ TALENT:恋慕 ? 봐, 봤어? 이렇게 많이 나왔잖아...? # 전부…… 나한테 걸어줘…… \@HPH」","W"
				CASE 2
					CALL HPH_PRINT,@"「빨리 사정하고 싶다고, 거기가 꿈틀거리고 있어…… HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 손바닥으로 귀두 전체를 감싸고, 민감한 부위를 주무르고 있다.
					CALL HPH_PRINT,@"「그렇게 내 손을 임신시키고 싶다니, \@ TALENT:恋慕 ? の # んですか \@? なんて、후훗 HPH」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「후후, 허리가 들썩이\@ TALENT:恋慕 ? 하고 있네 # 하고 있어 \@?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 천천히 자극을 주며 손가락 끝으로 음부를 꾸욱꾸욱 파고든다.
					PRINTFORMDW 너무 기분 좋은 나머지 %조사처리(CALLNAME:MASTER,"가")% 한심한 소리를 내자, %조사처리(CALLNAME:TARGET,"가")% 즐거운 듯 웃었다.
				CASE 1
					IF TALENT:恋慕
						CALL HPH_PRINT,@"「야한 진액이 넘쳐서 멈추질 않아……? HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 페니스를 만지면서, 귀에 대고 그렇게 속삭인다.
						CALL HPH_PRINT,@"「아, 또 커졌네…… 이런 게 좋아하는구나…… HPH」","W"
					ELSE
						PRINTFORML 「여기부터 아기의 정액이 나오죠……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 막을 다루면서, 앞서 나간 방울 입구를 응시하고 있다.
						PRINTFORMW 「……이대로, 사정해도 괜찮은 건가요?」
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「좀 더 기분 좋게 해 줄게 \@ TALENT:恋慕 ? 응 # 할게 \@부터…… HPH」","L"
					PRINTFORMDL 능숙한 봉사로 %조사처리(CALLNAME:MASTER,"를")% 기쁘게 하는 %조사처리(CALLNAME:TARGET,"의")% 모습은 숙련된 창녀 그 자체이다.
					PRINTFORMDW 당연히, 그 움직임 또한 %조사처리(CALLNAME:MASTER,"가")% 꾸민 것이며, 정확하게 쾌감을 느끼는 부위를 몰아붙인다...
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「\@ TALENT:恋慕 ? 벌써 사정할 것 같아? 응, 괜찮아 # 사정할 것인가? 하, 네엣 \@」
					PRINTFORMDL 끊임없이 넘쳐흐르는 선행이 자루를 타고 %조사처리(CALLNAME:TARGET,"의")% 손을 더럽힌다.
					PRINTFORMDW 쭈욱거리는 자루를 다루는 소리가 빨라지더니 최고조에 달했을 때 %조사처리(CALLNAME:MASTER,"는")% 허리를 떨며 사정했다.
				CASE 1
					PRINTFORML 「언제든지 사정해도 괜찮아 \@ TALENT:恋慕 ? 부터야 # 그렇기 때문에…… \@」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 서투르지만 열심인 봉사로 %조사처리(CALLNAME:MASTER,"를")% 사정으로 이끌려고 하고 있다.
					PRINTFORMW 「아, 거시기 부풀어 오르고……큭!? 굉장해, 이렇게……!」
				CASE 2
					PRINTFORML 「앗, 벌벌 떨면서……햐응!?」
					PRINTFORMDL 불현듯 %조사처리(CALLNAME:TARGET,"가")% 자극을 강하게 잡자, 멈출 새도 없이 폭발해 버렸다.
					PRINTFORMW 「응응…… 굉장한 냄새야 \@ !TALENT:恋慕 ? 이예요 #  \@……」
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「\@ TALENT:恋慕 ? 음…… 이렇게 할까? # ……어때요? 기분 좋게 되고 있어요 \@……?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 서투른 손길로 %조사처리(CALLNAME:MASTER,"의")% 페니스를 만지고 있다.
					PRINTFORMW 「흡, 흡…… 아, 움찔하고 몸이 떨렸어…… 후후, 기분 좋았지? \@ TALENT:恋慕 ? 그렇지? # 그렇네 \@」
				CASE 1
					PRINTFORML 「엄청 뜨겁고…… 움찔움찔 떨리네…… 마치 다른 생물 같아……」
					PRINTFORMDL 새빨갛게 충혈되어 뒤로 젖혀진 페니스를 %조사처리(CALLNAME:TARGET,"는")% 몰두한 듯 바라보고 있다……
					PRINTFORMW 「이렇게 부어올랐는데…… \@ TALENT:恋慕 ? 지금 시원하게 해줄 테니까…… # , 괴롭지 않으세요……? \@」
				CASE 2
					PRINTFORML 「\@ TALENT:恋慕 ? 끝부분에서, 야한 액체가 잔뜩 나오고 있어 # 아, 끝부분에서 무언가 흘러 나왔어요 \@……?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 넘쳐흐르는 선행을 손가락으로 떠서, 기둥 전체에 발라버렸다.
					PRINTFORMW 「후후, \@ TALENT:恋慕 ? 기분 좋아 보이는 얼굴 하고 있네♪ # 이렇게 하면 손이 움직이기 편하네요 \@」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
