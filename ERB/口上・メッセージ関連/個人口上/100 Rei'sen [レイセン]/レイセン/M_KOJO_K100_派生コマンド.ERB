		;Ｖ感覚５以上
	ELSEIF ABL:Ｖ感覚 >= 5
		;バイブ装着中
		IF TEQUIP:バイブ
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「또... 후우후우 또, 보송보송해읏 후우후우 후우후우」","L"
					CALL HPH_PRINT,@"「토니, 해버릴 것 같아앗! 후아아앗! 후후 후후 후후」","L"
					PRINTFORMDL 푸슉, 푸샤, 하고 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에서 간헐적으로 파도가 분출한다.
					PRINTFORMDW 삽입된 바이브는 그럼에도 멈추지 않고 일정한 진동으로 그녀의 G스팟을 계속 자극하고 있다……
				CASE 1
					CALL HPH_PRINT,@"「흐윽, 하아앗! 너무 세잖아읏!」","L"
					CALL HPH_PRINT,@"「좋아읏 후으응! 아앗!! 아아아앗! 흐읍 흐읍 흐읍」","L"
					PRINTFORMDL 진동을 최강으로 설정하고, 꾸욱 질 안의 약한 곳에 밀어 넣는다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 침을 흘리면서 바이브와 섹스라도 하는 것처럼 허리를 흔들고 있다……
				CASE 2
					CALL HPH_PRINT,@"「아쿠읏! 저, 거기...! 가버릴 것 같아...」","L"
					CALL HPH_PRINT,@"「응읏! 하아, 갈 것 같아! 응, 크으윽! 흐읍 흐읍 흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 질 안에서 바이브를 단단히 물고,
					PRINTFORMDW 몇 번이고 절정을 반복하며, 그럴 때마다 은밀한 곳에서 파도처럼 분출했다……
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「히익! 흐응... 아, 터질 것 같아읏」","L"
					CALL HPH_PRINT,@"「흐아앗 HPH ――아, 하아앗 HPH 하아앗 HPH」","L"
					PRINTFORMDL 개발된 G스팟을 손가락으로 토닥여 주자,
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에서 푸욱 하고 물이 뿜어져 나왔다……
				CASE 1
					CALL HPH_PRINT,@"「아, 거기가…… 기분 좋은 곳……읏!!」","L"
					CALL HPH_PRINT,@"「하아, 아앗 흐읍흐응 흐으윽」","L"
					PRINTFORMDL 삽입한 중지를 구부려 그녀가 말하는 '기분 좋은 곳'을 자극한다.
					PRINTFORMDL 성의 쾌감을 가르쳐진 %조사처리(CALLNAME:TARGET,"의")% 몸은,
					PRINTFORMDW 질의 조임을 세게 하면서도 결코 %조사처리(CALLNAME:MASTER,"의")% 손가락을 거부하려 하지 않았다……
				CASE 2
