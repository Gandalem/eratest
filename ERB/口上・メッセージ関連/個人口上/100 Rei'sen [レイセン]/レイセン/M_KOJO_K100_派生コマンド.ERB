					CALL HPH_PRINT,@"「가버릴 것 같아! HPH 가버려 \@ TALENT:恋慕 ? 우 # 있어요 \@부터아악HPH」","L"
					PRINTFORMDL 혼자서는 무서워서 만질 수 없는 곳에서 전해지는, 문자 그대로 허리가 빠질 듯한 황홀감
					PRINTFORMDW 조금 더 강하게 문지른다…… 그 자체만으로 %조사처리(CALLNAME:TARGET,"는")% 격렬하게 몸을 뒤틀게 만들었다
				CASE 2
					CALL HPH_PRINT,@"「야아…… 그거, 안돼읏 후우크으윽, 아아아앗후우크으악」","L"
					PRINTFORMDL 삽입한 바이브를 G스팟에 밀착시키고, 스위치를 약에서 강으로 전환한다.
					PRINTFORMDW 기계적인 진동이 성감대를 통해 %조사처리(CALLNAME:TARGET,"에게")% 폭력적인 쾌락을 안겨주었다……
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「히얏! HPH 음음... 으응...! HPH」","L"
					CALL HPH_PRINT,@"「소리, 나버릴 것 같아……. 부끄러워…… 으응읏 HPH」","L"
					PRINTFORMDL 매우 민감한 %CALLNAME:TARGET%부위를, 원을 그리듯 손가락으로 마사지한다.
					PRINTFORMDW 서두르지 않고, 천천히……%조사처리(CALLNAME:MASTER,"는")% 미숙한 질에 성적인 쾌감을 가르쳤다.
				CASE 1
					CALL HPH_PRINT,@"「왜, 약한 데만 건드려읏 HPH」","L"
					CALL HPH_PRINT,@"「흐응앗 HPH 우으윽 HPH 항아앙 HPH」","L"
					PRINTFORMDL 질내에 삽입한 손가락을 가볍게 구부려 G스팟이라고 불리는 부분을 꾸욱꾸욱 밀어 올린다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 발끝을 꽉 오므리고, 너무 강한 쾌락을 어떻게든 피하려 하고 있다……
				CASE 2
					CALL HPH_PRINT,@"「――후우읏 흐으읍 흐응흐으윽 흐음읏」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 질의 까끌까끌한 부분을 손가락 끝으로 토닥토닥 두드린다.
					PRINTFORMDW 무심코 터져 나온 신음소에 %조사처리(CALLNAME:TARGET,"는")% 황급히 입을 막지만, 이미 늦었다……
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
