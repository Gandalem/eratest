@M_KOJO_MESSAGE_SCOM_K100_6
CALL M_KOJO_MESSAGE_SCOM_K100_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K100_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;膣技術３以上
	ELSEIF ABL:膣 >= 3
		;今射精した
		IF NOWEX:MASTER:射精
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「또, 갈 것 같아앗 HPH 가버릴 것 같아 HPH 가버려애」","L"
					CALL HPH_PRINT,@"「가아앗! 흐으, 윽흐으~~~읏!! 하프하프하프」","L"
					PRINTFORMDL 푸슉하고 파도를 일으키며 %조사처리(CALLNAME:TARGET,"가")% 강렬한 절정에 도달한다.
					PRINTFORMDW 짜내는 듯한 질의 움직임에 %CALLNAME:MASTER%참지 못하고 사정했다.
				CASE 1
					CALL HPH_PRINT,@"「흐읍! 큭, 후우... 음냐아아앗!」","L"
					CALL HPH_PRINT,@"「빼내줘읏 HPH 기분 좋은 곳, 쭉쭉 빨아줘읏 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 사정이 임박했음을 느꼈는지,
					PRINTFORMDW 필사적으로 질을 조이면서 몇 번이고 정액 주입을 졸랐다……
				CASE 2
					CALL HPH_PRINT,@"「흐윽! 흐응! 굉장해! 엄청나아앗!」","L"
					CALL HPH_PRINT,@"「아무것도 HPH 생각할 수 없었어, 아앙 HPH 아앗 HPH」","L"
					PRINTFORMDL 울상이 된 표정으로 가쁘게 숨 쉬는 %조사처리(CALLNAME:TARGET,"의")% 귓가에 '괜찮아'라고 속삭이며,
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 미세하게 허리를 움직여 그녀를 더욱 깊은 쾌락의 늪으로 몰아넣었다.
			ENDSELECT
			RETURN 1
			;前回射精した
		ELSEIF TCVAR:102
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%MASTERNAME:100%의 정액으로, 배가 커져버렸어\@ TALENT:恋慕 ? 읏 # 있었어 \@……HPH」","L"
					CALL HPH_PRINT,@"「응아앗 HPH 한 번 더 \@ TALENT:恋慕 ? 할 거예요 # 아니에요 \@……? HPH 응크, 아앗 HPH」","L"
					PRINTFORMDL 사정 직후인데 %조사처리(CALLNAME:MASTER,"의")% 페니스는 경도를 잃지 않는다.
					PRINTFORMDW 강인한 그 존재에 여자의 약점이 건드려지고, %조사처리(CALLNAME:TARGET,"의")% 몸도 금세 준비를 마쳤다.
				CASE 1
					CALL HPH_PRINT,@"「응아…… 응응…… HPH 아기 방, 따뜻해…… HPH」","L"
					CALL HPH_PRINT,@"「아우윽 HPH 빼지 말아줘\@ !TALENT:恋慕 ? 입니다 #  \@……HPH 저, 아직……HPH」","L"
					PRINTFORMDL 완전히 스위치가 들어버린 %조사처리(CALLNAME:TARGET,"는")% 질을 조이며 교미의 계속을 애원하고 있다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 다시 허리를 움직이자, %조사처리(CALLNAME:TARGET,"는")% 등을 활처럼 휘며 달콤한 신음소리를 냈다.
				CASE 2
					CALL HPH_PRINT,@"「흐응! 방금 했잖아아! 흐응!」","L"
					CALL HPH_PRINT,@"「아직, 건강해읏 HPH 응응읏 HPH」","L"
					PRINTFORMDL 긴 스트로크로 G스팟을 지긋이 쓸어 올리며 %조사처리(CALLNAME:TARGET,"의")% 발정을 촉진한다.
					PRINTFORMDW 그러자 신선한 자손을 내려달라고 그녀의 자궁이 더 낮은 위치로 내려왔다.
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「흐윽! 후응! 아아앗! 가버릴 것 같아...!」","L"
					CALL HPH_PRINT,@"「우으윽 HPH ～～～읏 HPH 후읍 HPH 응으윽 HPH」","L"
					PRINTFORMDL 절정에 다다른 듯 질이 %조사처리(CALLNAME:MASTER,"의")% 페니스를 뜨겁고 정열적으로 끌어안는다.
					PRINTFORMDW 피스톤에 의해 분비된 무겁고 끈적한 본능의 액이 흘러나와 결합부를 축축하게 적셔간다……
				CASE 1
					CALL HPH_PRINT,@"「아앗! 후으읍... 하아응...! 후우음읏...」","L"
					CALL HPH_PRINT,@"「히야아앗! 흐으윽! 안 돼읏, 아앙큿! 히아앙읏!」","L"
					PRINTFORMDL 거친 천장을 스칠 때마다 애액이 기뻐 꿈틀대며 삽입된 페니스에 점막을 달라붙게 한다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 허리 움직임을 멈춰 %조사처리(CALLNAME:TARGET,"에게")% 숨 돌릴 틈을 주려 하자,
					PRINTFORMDW 그녀의 질은 「왜 움직여주지 않아?」라고 항의라도 하듯 자극을 세게 조여왔다.
				CASE 2
					CALL HPH_PRINT,@"「흐응! 흐읍! 응응! 거그...」","L"
					CALL HPH_PRINT,@"「흐으, 흐으읏! HPH 히익 HPH 응햐앗 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 능숙하게 허리를 움직여 질의 가장 약한 부분을 몰아붙였다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 머리카락을 휘날리며 침을 흘리고 거친 신음을 연발하고 있다……
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:MASTER:射精
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「안 돼읏 HPH 큭! HPH 아우윽 HPH 아아앗 HPH」","L"
					PRINTFORMDL G스팟을 문지를 때마다 질이 수축하며 페니스를 아플 정도로 조여왔다.
					PRINTFORMDW 그것이 오히려 강한 마찰을 일으키며 %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 허리가 빠질 듯한 황홀경을 맛보았다.
				CASE 1
					CALL HPH_PRINT,@"「응우, 아앗 HPH 하앗 HPH 잠깐만으읏 HPH」","L"
					CALL HPH_PRINT,@"(배가 꽉 조여와서 헉... 너무 기분 좋아욧! 헉)","L"
					PRINTFORMDL 원래 민감한 %조사처리(CALLNAME:TARGET,"의")% 질보다 더 민감한 곳을 집요하게 비비면서
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그녀에게 씨를 심기 위해 허리를 계속 흔들었다……
				CASE 2
					CALL HPH_PRINT,@"「앗! 하으윽! 거기 그만해아앗!」","L"
					PRINTFORMDL 너무 강한 쾌락에 날뛰는 %조사처리(CALLNAME:TARGET,"를")% 단단히 붙잡은 채,
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 작게 허리를 움직이며 그녀의 가장 약한 부분을 계속 자극했다……
			ENDSELECT
			RETURN 1
			;前回射精した
		ELSEIF TCVAR:102
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아…… 후우…… 하헵 앙! 하헵 이, 지금은 하앗! 하헵」","L"
					PRINTFORMDL 정액을 받아들이며 수축하는 질을 다시 %조사처리(CALLNAME:MASTER,"의")% 페니스가 왕복한다.
					PRINTFORMDW 거친 천장을 세게 밀자, %조사처리(CALLNAME:TARGET,"는")%(1)는 몇 번이고 허리를 들었다.
				CASE 1
					CALL HPH_PRINT,@"「캬아앙! 흐읍! 응응! 크으으윽!」","L"
					CALL HPH_PRINT,@"「기분 좋은 곳이야! 후후, 축축해, 안 돼앗!」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 질내에 가득 사정된 정액을 G스팟에 바르듯이 하면서,
					PRINTFORMDW 절정의 여운이 완전히 가시지 않은 %조사처리(CALLNAME:TARGET,"를")% 다시 범하기 시작했다...
				CASE 2
					CALL HPH_PRINT,@"「아기 방…… 데일 것 같아…… 흐으읍」","L"
					CALL HPH_PRINT,@"「흡, 흐윽흐읍 HPH 아, 또! HPH 앗! HPH」","L"
					PRINTFORMDL 페니스가 힘을 잃기 전에 거친 천장을 가늘게 쓸어 올리며 단단함을 되찾는다.
					PRINTFORMDW 다음으로 깊숙이 삽입하자, 그것을 환영하듯 내려온 자궁이 육봉 끝에 입을 붙였다.
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「힉! 으윽! 응응읏!」","L"
					PRINTFORMDL 허리를 움직이며 거친 부분을 쓸어 올리자 %조사처리(CALLNAME:TARGET,"의")% 반응이 변했다
					CALL HPH_PRINT,@"「라메……햐메……읏 HPH 거기, 세다읏 HPH 히으윽 HPH」","L"
					PRINTFORMDW 가늘게 그곳을 자극한다. 큥큥하고 질이 조여오며 다량의 애액이 결합부 틈새로 흘러나왔다
				CASE 1
					CALL HPH_PRINT,@"「천, 천천히…… 천천히\@ TALENT:恋慕 ? 깊숙이 # 해요 \@……? HPH」","L"
					CALL HPH_PRINT,@"「앗, 후헵 후으읏 후응~~헵」","L"
					PRINTFORMDL 짜릿…… 소녀의 가장 민감한 천장을 %조사처리(CALLNAME:MASTER,"의")% 페니스가 스치고 있다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 너무나 큰 쾌감에 손으로 입을 막고, 비명을 지르려다 필사적으로 참아내고 있다……
				CASE 2
					CALL HPH_PRINT,@"「하아앗 HPH 하아앗 HPH 아아…… 으윽… HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 일단 움직임을 멈추고 %조사처리(CALLNAME:TARGET,"의")% 모습을 보았다.
					PRINTFORMDL 너무 기분이 좋아서 숨을 쉴 수 없었을 것이다. 산소를 찾아 크게 숨을 들이쉬고 있다.
					CALL HPH_PRINT,@"「이제 끝……아앗! 후우윽, 흐으윽, 큭…」","W"
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
