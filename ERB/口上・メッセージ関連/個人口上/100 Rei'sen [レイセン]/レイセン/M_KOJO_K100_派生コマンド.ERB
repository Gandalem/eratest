@M_KOJO_MESSAGE_SCOM_K100_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;子宮におちんちん挿入っちゃったイベント
	ELSEIF EXP:子宮口開発経験 >= 50 && !CFLAG:100:1005
		PRINTFORMDW 푹...
		CALL HPH_PRINT,@"「아아아악! 흐으윽」","W"
		PRINTFORMDW 집요한 자궁 조교로 개발되어 다 써버린 %조사처리(CALLNAME:TARGET,"의")% 자궁은……
		PRINTFORMDW 마침내 닫고 있던 문을 열고, %조사처리(CALLNAME:MASTER,"의")% 페니스를 성역까지 받아들여 버렸다
		CALL HPH_PRINT,@"「헉, 헉…… 설마…… 거시기…… 들어와...? HPH」","W"
		CALL HPH_PRINT,@"「――힉! 흐으윽 흐아앙 싫어어어억! 아앗 하아악」","W"
		PRINTFORMDW 자궁을 관통당한 채 허리를 흔들리며, 미친 듯이 신음하는 %CALLNAME:TARGET%
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 더는 멈추지 않을 것처럼 그녀의 자궁을 계속 범했다
		CFLAG:100:1005 = 1
		;子宮陥落
	ELSEIF EXP:子宮口開発経験 > 50
		;今射精した
		IF NOWEX:MASTER:射精
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「오, 아아앗! HPH 커서 정말 기분 좋아읏 HPH」","L"
					CALL HPH_PRINT,@"「나의, 아기 방이 HPH에게 오염되고 있어욧 HPH HPH HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 아이를 가질 생각밖에 없는 표정에 단단함이 더해졌다.
					PRINTFORMDW 임신시키려는 기세로 피스톤에 자궁째 범해지는 즐거움에 %조사처리(CALLNAME:TARGET,"는")% 완전히 미쳐버렸다.
				CASE 1
					CALL HPH_PRINT,@"「흐응! 흐으, 이거! 거시기! 깊숙이윽!」","L"
					CALL HPH_PRINT,@"「오옷! 으윽, 크윽... 왔다아앗! 하프 하프 하프」","L"
					PRINTFORMDL 완벽하게 만들어진 자궁을 찔리고, 그리고 씨를 뿌려지는 환희에 %조사처리(CALLNAME:TARGET,"는")% 눈물을 흘리며 신음하고 있다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 절정에 달하며 자궁에 정액이 쏟아지자, 동시에 그녀 또한 절정에 이르러 은밀한 곳에서 다량의 애액을 뿜어냈다.
				CASE 2
					CALL HPH_PRINT,@"「하앗 HPH 아앗 HPH 더 깊이 HPH 끝까지 HPH」","L"
					CALL HPH_PRINT,@"「응으응읏 하아아아앗! 응응응응」","L"
					PRINTFORMDL 깊숙이 허리를 밀어 넣어 페니스로 자궁을 밀어 올리자,
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 짐승 같은 비명을 지르며 삽입된 페니스를 꽉 조였다.
			ENDSELECT
			RETURN 1
			;前回射精した
		ELSEIF TCVAR:102
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「배가 가득해……흐응……읏……큭」","L"
					PRINTFORMDL 눈 깜짝할 사이에 경도를 되찾은 %조사처리(CALLNAME:MASTER,"의")% 페니스가 %조사처리(CALLNAME:TARGET,"의")% 자궁을 꾹 밀어 올린다.
					PRINTFORMDW 안에 사정된 직후 민감해진 질은 교미 재개를 기뻐하며 받아들였다.
				CASE 1
					CALL HPH_PRINT,@"「흐응! HPH 벌써 커졌네……HPH」","L"
					CALL HPH_PRINT,@"「……자식 만들기, 하고 싶습니까 \@ TALENT:恋慕 ? 의 # 인가요 \@? HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"의")% 질이 꽉 조여왔다...
				CASE 2
					CALL HPH_PRINT,@"「아우욱……응응……흐으윽 기분 좋아, 멈출 수가 없어……흐으윽」","L"
					PRINTFORMDL 자궁 안에서 출렁이는 정액의 열기에 %조사처리(CALLNAME:TARGET,"는")% 달콤한 신음을 반복하고 있다…….
					CALL HPH_PRINT,@"「흐읍, 응! HPH 아기 방이잖아! 흔들지 마아읏 HPH」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「흐으응! 윽, 억지로, 울퉁불퉁하면 아앗!」","L"
					CALL HPH_PRINT,@"「\@ TALENT:恋慕 ? %MASTERNAME:100%의 #  \@あかちゃんHPH うめなくなちゃ\@ TALENT:恋慕 ? 우 # 있어 \@よぉHPH」","L"
					PRINTFORMDL 자궁을 짓누르는 듯한 격렬한 피스톤에 소녀의 작은 몸이 흔들린다.
