						PRINTFORMDW 스르륵 레이센의 질에서 페니스를 빼내자, 이번에는 토요히메의 질에 페니스를 삽입했다
						RESETCOLOR
					CASE 2
						CALL SET_KOJO_COLOR([[豊姫]]) ;custom code
						CALL HPH_PRINT,@"「――앗 아앙! 큭, 아직 끝나지 않은 것 같네……. 큭」","L"
						CALL M_KOJO_COLOR_K100
						CALL HPH_PRINT,@"「네…… 그런 것 같네요…… HPH 응! 아으HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 레이센과 토요히메에게 덮치자,
						PRINTFORMDW 숨 돌릴 새도 없이 다시 허리를 움직이기 시작했다…….
						RESETCOLOR
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL SET_KOJO_COLOR([[豊姫]]) ;custom code
						CALL HPH_PRINT,@"「응응…… 하아……! 하프 저랑, 레이센……! 하프」","L"
						CALL HPH_PRINT,@"「어느 쪽이 더 기분 좋아……? HPH 앙! HPH」","L"
						PRINTFORMDL 토요히메의 질에서 페니스를 빼내고 비교를 위해 이번에는 레이센의 질에 박아넣었다.
						CALL M_KOJO_COLOR_K100
						CALL HPH_PRINT,@"「응 아으윽 HPH 갑자기, 하앗 HPH 음음읏 HPH」","L"
						PRINTFORMDL 부드럽게 감싸 안아오는 토요히메의 질과, 조임이 강한 레이센의 질……
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 고민하는 듯한 모습을 보이며 양쪽의 질을 번갈아 범하고 계속했다
						RESETCOLOR
					CASE 1
						CALL M_KOJO_COLOR_K100
						CALL HPH_PRINT,@"「하아우! HPH 음... 크, 응읏! HPH」","L"
						CALL SET_KOJO_COLOR([[豊姫]]) ;custom code
						CALL HPH_PRINT,@"「깊숙이, 느껴져……읏 HPH 하아, 응읏 HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 위풍당당한 박아넣음에 두 사람은 허리를 비틀며 표정을 녹이고 있다……
						RESETCOLOR
					CASE 2
						CALL SET_KOJO_COLOR([[豊姫]]) ;custom code
						CALL HPH_PRINT,@"「응, 후우읏 HPH 방금 거, 너무 좋았어……읏 HPH」","L"
						CALL M_KOJO_COLOR_K100
						CALL HPH_PRINT,@"「토요히메님…… 기분 좋아 보여…… HPH 히아, 응! HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 부드럽게 허리를 움직이며 토요히메의 질 감촉을 음미하면서,
						PRINTFORMDW 욕망스럽게 하고 있는 레이센의 질에 손가락을 삽입하고, 쿠츄쿠츄 소리를 내며 안을 휘저었다……
						RESETCOLOR
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
