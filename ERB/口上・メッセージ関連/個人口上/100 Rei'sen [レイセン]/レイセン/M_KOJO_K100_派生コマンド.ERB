					CALL HPH_PRINT,@"「흐응! 흐으윽! 하아앗! 아아앗!」","L"
					PRINTFORMDL 손가락의 살로 문지르듯이 %조사처리(CALLNAME:TARGET,"의")% 민감한 부분을 몰아붙인다.
					PRINTFORMDW 분출되는 애액이 물보라처럼 사방으로 튀어, %조사처리(CALLNAME:MASTER,"의")% 손을 흥건하게 적신다.
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;バイブ装着中
		IF TEQUIP:バイブ
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응으읏 흐읍! 후우읏 하아, 응응읏흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 어린 모습을 간직한 질을 웅장한 형태의 바이브가 왕복한다.
					PRINTFORMDL 스위치를 켠 채 천장 부분에 소름 끼치게 쓸어내리듯 장난감을 움직이자,
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 아까와는 달리 매혹적인 신음소리를 내며 몸을 뒤틀었다.
				CASE 1
