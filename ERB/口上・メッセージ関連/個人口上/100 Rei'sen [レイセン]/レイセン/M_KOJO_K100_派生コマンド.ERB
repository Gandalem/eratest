							CALL HPH_PRINT,@"「야, 아앗 HPH 터져버렸어, 으윽, 으으으읍! HPH」","L"
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 파르르 떨며 %조사처리(CALLNAME:MASTER,"의")% 입안에 사정한다.
							CALL HPH_PRINT,@"「하아…… 하아앗……큭 HPH \@ TALENT:恋慕 ? 응으…… 음응 # 미안해, 나…… HPH」 \@","L"
							PRINTFORMDW 목적을 이루고 시들어가는 페니스에서 입을 떼자, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 「잘 먹었다」라고 속삭였다.
						CASE 1
							CALL HPH_PRINT,@"「흡흐읍, 쪽, 응! 아앗, 흐윽! 음, 후으읏!」","L"
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 책임을 견디며 필사적으로 봉사를 계속하고 있다.
							PRINTFORMDW 용서를 구하듯 경련하는 페니스를, %조사처리(CALLNAME:MASTER,"는")% 혀로 부드럽게, 스윽스윽 쓸어 올렸다……
						CASE 2
							CALL HPH_PRINT,@"「안돼, 나... 벌써! 하으윽, 흣...!」","L"
							PRINTFORMDL 「해도 괜찮아」라며 %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 페니스를 목구멍 깊숙이 물어넣는다.
							PRINTFORMDW 목으로 끝을 조르면서 입술과 혀를 이용해 애무하자, %조사처리(CALLNAME:TARGET,"는")% 몇 초도 걸리지 않아 절정에 도달했다.
					ENDSELECT
					RETURN 1
					;それ以外
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「츄……음……! 하아……. 응으, 으윽…! 하아…….」","L"
							PRINTFORMDL 식스나인 자세로 필사적으로 봉사하는 %조사처리(CALLNAME:TARGET,"의")% 페니스를 입에 물고
							PRINTFORMDL 귀두부를 혀로 굴리며, 쪽쪽 소리를 내어 기둥을 핥아 빨아주자
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 한심한 신음을 흘리며, 부들부들 허리를 떨었다.
						CASE 1
							CALL HPH_PRINT,@"「아, 으윽... HPH 고추, 그렇게 HPH 안 돼 HPH」","L"
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 때를 모르는 분홍색 귀두에 끈적하게 혀를 가져간다.
							PRINTFORMDW 픽쿤, 픽쿤 하고 페니스가 꿈틀거릴 때마다 녹아내리는 선행이 물구멍에서 새어 나온다……
						CASE 2
							CALL HPH_PRINT,@"「츄릅……응……후우……윽 HPH 쿠프……츄……윽 HPH」","L"
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 금방이라도 갈 것 같은 성기에 몇 번이고 입을 맞춘다.
							PRINTFORMDW 다만 그것만으로, %조사처리(CALLNAME:TARGET,"는")% 평범한 수준 이상으로 먼저 사정을 해버렸다.
					ENDSELECT
					RETURN 1
				ENDIF
				;どっちにも無し
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「ぺ챠……츄……읏 HPH 응…… 후……읏 HPH」","L"
						PRINTFORMDL 서로의 성기를 핥으며, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 『기분 좋네』라고 말을 걸었다
						CALL HPH_PRINT,@"「츄파……읏 HPH 저도…… 기분 좋아요 \@ TALENT:恋慕 ? 좋아 # 입니다 \@……HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「흐윽…… 흐윽…… 헉! 하아후…… 지금…… 헉!」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 애틋하게 %조사처리(CALLNAME:MASTER,"의")% 은밀한 곳에 혀를 갖다 대고 있다.
						PRINTFORMDW 그저 핥기만 하는 것 같지만, 그럼에도 충분히 기분 좋다고 느꼈다.
					CASE 2
						CALL HPH_PRINT,@"「흐아, 아앗 HPH 그거, 안돼, 으윽... HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 부정적인 말을 내뱉으며 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 은밀한 곳을 밀어붙이고 있다.
						PRINTFORMDW 움찔거리며 수축하는 질구가 삽입된 혀를 적당히 조여온다……
				ENDSELECT
				RETURN 1
			ENDIF
			;あなたが男
		ELSE
			;レイセンにペニスあり
			IF HAS_PENIS(TARGET)
				GOTO REISEN_SIXTY_NINE_1
				;それ以外
			ELSE
				;あなたが射精した
				IF NOWEX:MASTER:射精
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「하아…… 하아…… 윽 후후… 아무…… 추우…… 윽 후후」","L"
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 은밀한 곳에서 입을 떼고, 곧 절정에 이를 것 같다는 것을 %조사처리(CALLNAME:TARGET,"에게")% 전했다.
							CALL HPH_PRINT,@"「\@ TALENT:恋慕 ? 응 # 파이 \@……흐으읍 음푸……크큭, 응……윽 HPH」","L"
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 대답을 하자, 다시 얼굴을 흔들기 시작했다……
						CASE 1
							CALL HPH_PRINT,@"(거시기, 괴로워 보여…… 시원하게 해줘야겠네……읏 HPH)","L"
							CALL HPH_PRINT,@"「하, 흡…… 음후우……읏ㅎㅍㅎ 츄르……츄……읏ㅎㅍㅎ」","L"
							PRINTFORMDL 탐욕스럽게 구는 입질에 %조사처리(CALLNAME:TARGET,"는")% 숨이 끊어질 듯하면서도,
							PRINTFORMDW 어떻게든 %조사처리(CALLNAME:MASTER,"를")% 절정에 이르게 하려고 필사적으로 봉사를 계속했다……
						CASE 2
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 열성적인 봉사에 패배한 %조사처리(CALLNAME:MASTER,"는")% 허리를 떨며 사정했다.
							CALL HPH_PRINT,@"「응흐윽…… 응, 으윽…… 큭! 하아앗」","L"
							CALL HPH_PRINT,@"「커헉…… 커헉…… 크윽……! 후우」","L"
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 정액을 삼킬 때마다, 질이 움찔거리며 수축하고 혀를 조여온다……
					ENDSELECT
					RETURN 1
					;それ以外
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「후아, 음……츄릅……HPH 츄……응으……읏 HPH」","L"
							PRINTFORMDL 챱, 축, 하고 서로의 성기를 핥는 소리가 울린다.
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 봉사는 서툴지만, %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해주고 싶다는 마음은 전해온다……
						CASE 1
							CALL HPH_PRINT,@"「하으윽…… 응응……! 하아 안 돼, 안 될 것 같아…… 앗! 하아」","L"
							PRINTFORMDL 무의식적으로 도망치려 하는 %조사처리(CALLNAME:TARGET,"를")% 단단히 붙잡고, 녹아내릴 듯한 은밀한 곳을 핥아대는 행동.
							PRINTFORMDW 질구에 혀를 넣어 점막을 자극하자, %조사처리(CALLNAME:TARGET,"는")% 벌벌 떨며 허리를 들었다.
						CASE 2
							CALL HPH_PRINT,@"「하무……츄……쿠프……읏 HPH 히얏 HPH」","L"
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 페니스에서 입을 떼고 귀여운 신음을 낸다.
							PRINTFORMDW 질 안에 혀가 침입한 것에 놀란 듯하다….
					ENDSELECT
					RETURN 1
				ENDIF
			ENDIF
		ENDIF
	ENDIF
