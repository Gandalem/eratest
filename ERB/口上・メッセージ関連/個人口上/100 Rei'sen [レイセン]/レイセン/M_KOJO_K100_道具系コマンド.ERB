@M_KOJO_MESSAGE_COM_K100_41
CALL M_KOJO_MESSAGE_COM_K100_41_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_41_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「허리, 움직이고 있다니까, 그치! HPH」","L"
				CALL HPH_PRINT,@"「느낌, 너무 좋아서읏 HPH 히안읏HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 장난감이 주는 쾌감에 완전히 휘둘리고 있어…….
			CASE 1
				CALL HPH_PRINT,@"「흐응! 으윽 HPH 응! HPH 음으으읏 HPH」","L"
				CALL HPH_PRINT,@"(기분 좋아…… 기분 좋아…… 큭!)","L"
				PRINTFORMDW 너무 기분 좋아서, %조사처리(CALLNAME:TARGET,"는")% 힘없이 허리를 흔들며 신음하고 있다……
			CASE 2
				CALL HPH_PRINT,@"「라메읏! 아햣! 야햣! 라메읏!」","L"
				PRINTFORMDL 진동하는 마사지기를 은밀한 곳에 밀어붙인 %조사처리(CALLNAME:TARGET,"는")%,
				PRINTFORMDW 느끼고 있는 것을 숨기려 하지도 않고, 엄청난 신음 소리를 내며 있다…….
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「캬우앗 HPH 힛 HPH 우으읏 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 쾌락을 놓치지 않으려는 듯 꽉 %조사처리(CALLNAME:MASTER,"의")% 팔을 잡고 있다.
				CALL HPH_PRINT,@"「안, 돼읏 HPH 이거――읏, 안돼앳 HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「히익 HPH 아, 야아앗 HPH」","L"
				PRINTFORMDL 전마가 닿는 순간, 도망치려는 허리를 단단히 붙잡는다.
				PRINTFORMDW 주어지는 무자비한 쾌락에 %조사처리(CALLNAME:TARGET,"는")% 머릿속이 뒤죽박죽이 되었다.
			CASE 2
				CALL HPH_PRINT,@"「――아큭 흐읍 후우읏 후으, 응응후우」","L"
				PRINTFORMDL 쾌락에서 벗어나려고 다리를 오므리는 %CALLNAME:TARGET%은이지만, 그것 때문에 오히려 전동 마사지기를 밀어붙이게 된다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 스위치를 꺼주자, %조사처리(CALLNAME:TARGET,"는")% 힘없이 풀리며 젖은 은밀한 곳을 드러낸 채 헉헉거리며 숨을 내쉬었다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
