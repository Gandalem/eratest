;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K100_44
CALL M_KOJO_MESSAGE_COM_K100_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:破瓜 == 1
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;Ｖ感覚５以上
		ELSEIF ABL:Ｖ感覚 >= 5
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「네에엣――앗, 왔다아……윽! HPH」","L"
					PRINTFORMDL 사랑스러운 것을 삽입당하고, %조사처리(CALLNAME:TARGET,"의")% 질이 황홀함에 떨린다.
					PRINTFORMDW 시험 삼아 가볍게 앞뒤로 움직여 보니, 그것만으로도 끈적한 애액이 질 속에서 흘러나왔다.
				CASE 1
					CALL HPH_PRINT,@"「크으응! HPH 응아, 하아아…… HPH」","L"
					PRINTFORMDL 개발된 %조사처리(CALLNAME:TARGET,"의")% 질은 두꺼운 바이브도 어렵지 않게 삼켜버린다.
					PRINTFORMDW 살짝 절정에 도달해 버린 걸까. 때때로 %조사처리(CALLNAME:TARGET,"의")% 허리가 움찔 떨리고 있다……
				CASE 2
					CALL HPH_PRINT,@"「끝까지……. 헉! 들어가 버렸어 \@ TALENT:恋慕 ? 앗 # 있었어... 헉」 \@","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 대음순을 벌리고, 바이브를 물어 넣은 질 입구를 %조사처리(CALLNAME:MASTER,"에게")% 보여주고 있다
					CALL HPH_PRINT,@"「움직여줘…… \@ TALENT:恋慕 ? 괜찮아 # 해줘 \@……흐으읍」","L"
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이, 이거…… 좀 너무 두꺼운 것 같아……」
					PRINTFORMDL 약간 겁을 먹은 듯한 %조사처리(CALLNAME:TARGET,"를")% 진정시키자,
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 %조사처리(CALLNAME:TARGET,"의")% 질 내부에 바이브를 밀어 넣었다……
				CASE 1
					PRINTFORML 「느, 천천히 \@ !TALENT:恋慕 ? 부탁해 #  \@……으, 응……응응……읏」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 작은 질은 간신히 바이브를 삼켰다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 괴로워하며 숨을 내쉬는 %조사처리(CALLNAME:TARGET,"에게")% 진정할 때까지, 바이브를 움직이지 않았다.
