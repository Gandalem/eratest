;42,クリキャップ
;==================================================

@M_KOJO_MESSAGE_COM_K100_42
CALL M_KOJO_MESSAGE_COM_K100_42_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_42_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:クリキャップ
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;Ｃ感覚５以上
		ELSEIF ABL:Ｃ感覚 >= 5
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 착용된 캡이 빠지지 않는지 확인하기 위해 집요하게 손가락으로 건드렸다.
					CALL HPH_PRINT,@"「피, 찡! HPH 찡해서 안 돼 \@ TALENT:恋慕 ? 다 # 입니다 \@요오옷HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 느끼면서 허리를 들썩이고 있다……
				CASE 1
					CALL HPH_PRINT,@"「이거…… 쪽쪽 빨리고…… 히아우읏 HPH」","L"
					PRINTFORMDL 그 외에도 민감한 부위에 진동을 주는 기능이 있다.
					PRINTFORMDW 그 기능은 %조사처리(CALLNAME:TARGET,"가")% 가장 좋아하는 것이었다.
				CASE 2
					CALL HPH_PRINT,@"「이거 착용한다는 건…… '굉장한 거' 하는 거야 \@ TALENT:恋慕 ? 맞지 # 아니야 \@ TALENT:연모 ? HPH」","L"
					PRINTFORMDL 다중 절정의 쾌락을 상상하며 %조사처리(CALLNAME:TARGET,"의")% 얼굴이 스르륵 풀린다.
					PRINTFORMDW 그런 %조사처리(CALLNAME:TARGET,"를")% 보며, 애태워 보는 것도 재미있을지도%조사처리(CALLNAME:MASTER,"는")% 생각했다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「뭐, 뭔가…… 이상해, 아앗! 흐으읍」","L"
					PRINTFORMDL 클리에 달라붙은 캡을 흔들어 주자,
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 전기가 흐른 것처럼 움찔 몸을 떨었다.
				CASE 1
					CALL HPH_PRINT,@"「응으읏 HPH 쪽쪽~……히아앗 HPH」","L"
					PRINTFORMDL 장착한 캡은 단단히 클리에 달라붙어 %조사처리(CALLNAME:TARGET,"에게")% 쾌감을 주고 있다.
					PRINTFORMDW 이대로 %조사처리(CALLNAME:TARGET,"를")% 방치하고 있어도, 분명 사정해버릴 거야……
				CASE 2
					PRINTFORMDL 장착한 캡이 빠지지 않는지 확인도 겸해 손가락으로 톡 건다.
					CALL HPH_PRINT,@"「아, 야앗 흐으윽! 찌릿해져 버렸어흐응! 하으읏흐으윽!」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 반응이 좋아서, 어느새 그쪽이 메인이 되어버렸다
			ENDSELECT
		ENDIF
		;解除
	ELSE
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;Ｃ感覚５以上
		ELSEIF ABL:Ｃ感覚 >= 5
			CALL HPH_PRINT,@"「흐응! 흐읍」","L"
			PRINTFORMDW 클리캡이 벗겨지고 드러난 %조사처리(CALLNAME:TARGET,"의")% 음핵은 단단하게 발기해 있다……
			;それ以外
		ELSE
			CALL HPH_PRINT,@"「흐윽……헉큭」","L"
			PRINTFORMDW 클리캡을 벗겨주자, 붉게 충혈된 음핵이 드러났다…….
		ENDIF
	ENDIF
ENDIF
RETURN 1
