;40,ローター
;==================================================

@M_KOJO_MESSAGE_COM_K100_40
CALL M_KOJO_MESSAGE_COM_K100_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「윽 흐응 크으, 응응 흐응 하아, 앙흐응」","L"
				PRINTFORMDL 부웅 소리를 내는 로터가 %조사처리(CALLNAME:TARGET,"의")% 민감한 곳을 자극한다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 입가에서 침을 흘리며 쾌락을 만끽하고 있다……
			CASE 1
				CALL HPH_PRINT,@"「아……그거……읏흐으윽」","L"
				PRINTFORMDL 로터를 보여주자 %조사처리(CALLNAME:TARGET,"의")% 뺨이 풀린다.
				PRINTFORMDW 은밀한 곳에 밀어 넣고 스위치를 켜자, %조사처리(CALLNAME:TARGET,"는")% 위아래 입으로 침을 흘렸다.
			CASE 2
				CALL HPH_PRINT,@"「하아…… 하아…… 핥짝! 으응, 핥짝」","L"
				PRINTFORMDL 진동하는 로터를 천천히 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에 가져간다.
				PRINTFORMDW 단단하게 발기한 음핵에 순간 닿자, 움찔하며 %조사처리(CALLNAME:TARGET,"의")% 허리가 솟구쳤다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응, 응읏 HPH 응하아, 야앗 HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 싫다고 고개를 저으며 너무 강한 쾌락을 참아내고 있다……
			CASE 1
				CALL HPH_PRINT,@"「응으읍! 흐읍! 응? 흐읍! 음음! 흐읍!」","L"
				PRINTFORMDL 쾌락으로부터 도망치려 하는 %조사처리(CALLNAME:TARGET,"를")% 안는다.
				PRINTFORMDW 그리고 스위치를 손에 들자, 진동 단계를 하나 올렸다.
			CASE 2
				CALL HPH_PRINT,@"「이, 이거……! 허리, 멋대로……!」","L"
				CALL HPH_PRINT,@"「아, 안돼읏 HPH 세게 해버릴 거야앗 HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 비틀비틀 허리를 들썩이며 신음하고 있다……
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
