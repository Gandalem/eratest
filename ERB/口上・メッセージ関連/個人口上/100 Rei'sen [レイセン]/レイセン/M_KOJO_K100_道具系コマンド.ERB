	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「착용시켜 줄게…… HPH 응, 음…… HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 가랑이에 얼굴을 묻고,
				PRINTFORMDW 입을 사용하여 익숙한 모습으로 고무를 착용했다……
			CASE 1
				PRINTFORML 「만약 %MASTERNAME:100%가 좋다면……」
				PRINTFORML 「……아, 역시 아무것도 아니야……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 얼굴을 붉히며 어쩔 줄 몰라 하고 있다……
			CASE 2
				PRINTFORML 「앗, 벌써 끼고 있었네」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 마술이라도 본 듯한 반응이다.
				PRINTFORMW 「전혀 눈치 못 챘으니까, 조금 깜짝 놀랐어」
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아…… 제대로 착용해 주는 거군요……」
				PRINTFORMDL 『날것 쪽이 좋았어?』%조사처리(CALLNAME:MASTER,"가")% 그렇게 말하자,
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 얼굴을 새빨갛게 물들이며 눈에 띄게 당황했다
			CASE 1
				PRINTFORML 「그렇게 착용하는 거군요……」
				PRINTFORML 「아, 아니에요, 특별한 의미는 없는데요……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 콘돔을 착용하는 %조사처리(CALLNAME:MASTER,"를")% 가만히 보고 있다……
			CASE 2
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 콘돔을 착용하자, 「준비는 됐어?」라며 %CALLNAME:TARGET%에게로 몸을 돌렸다.
				PRINTFORML 「네, 네. 저는 언제든지……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 긴장하고 있는 듯하다…….
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
