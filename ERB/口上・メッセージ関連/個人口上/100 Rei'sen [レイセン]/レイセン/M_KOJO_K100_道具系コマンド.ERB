		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;Ｃ感覚５以上
		ELSEIF ABL:Ｃ感覚 >= 5
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「그, 그거…… 사용하는 \@ TALENT:恋慕 ? 의 # 인가 \@……? HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 페니스는 이미 단단하게 솟아올라 있다.
					PRINTFORMDW 오나홀을 손으로 주무르며 꾸덕꾸덕 소리를 내자, 기대감 때문인지 %조사처리(CALLNAME:TARGET,"의")% 페니스 끝에서 걸쭉한 선행 액이 흘러 나왔다.
				CASE 1
					CALL HPH_PRINT,@"「크윽…… 음후우…… 큭흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 오나홀의 감촉에 황홀하게 숨을 내쉬고 있다.
					CALL HPH_PRINT,@"「너무 기분 좋아서…… 금방 나올 것 같아\@ !TALENT:恋慕 ? 이예요 #  \@……후후」","W"
				CASE 2
					CALL HPH_PRINT,@"「아후윽 HPH 후아……HPH」","L"
					PRINTFORMDL 로션을 충분히 바른 오나홀에 %조사처리(CALLNAME:TARGET,"의")% 페니스가 쏙 가려진다.
					PRINTFORMDW 제대로 체온으로 데워 두었기에, %조사처리(CALLNAME:TARGET,"는")% 매우 기분 좋아 보이고 있다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아앗 흐읍 하아, 하아아……흐읍」","L"
					PRINTFORMDL 꾸욱…… 하고 소리를 내며, %조사처리(CALLNAME:TARGET,"의")% 페니스가 오나홀에 빨려 들어간다.
					PRINTFORMDW 꽉 오나홀을 움켜쥐자, 안에서 %조사처리(CALLNAME:TARGET,"의")% 페니스가 파르르 떨고 있는 것이 느껴졌다.
				CASE 1
					CALL HPH_PRINT,@"「히읏! HPH 안쪽이 거칠어서……윽! HPH」","L"
					PRINTFORMDL 『기분 좋아?』 %조사처리(CALLNAME:MASTER,"가")% 그렇게 묻자, %조사처리(CALLNAME:TARGET,"가")% 거침없이 몇 번이고 고개를 끄덕인다.
					PRINTFORMDW 그 반응이 사랑스러워서, %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 괴롭히고 싶은 마음이 들었다.
				CASE 2
					CALL HPH_PRINT,@"「이, 이런 거 어디서 파는 건지 \@ TALENT:恋慕 ? 의 # 거예요 \@……? HPH」","L"
					CALL HPH_PRINT,@"「아, 그게 아냐…… 딱히 흥미가 있다기보다는 말이야\@ TALENT:恋慕 ? 해서 # 같은 건데 \@……HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 얼굴을 붉히고, 오나홀에 로션을 발라주는 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다……
			ENDSELECT
		ENDIF
		;解除
	ELSE
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;Ｃ感覚５以上
		ELSEIF ABL:Ｃ感覚 >= 5
			CALL HPH_PRINT,@"「굉장해…… 꽉 조여와…… 으응흐으윽」","L"
			PRINTFORMDL 축뽁, 하고 소리를 내며 오나홀에서 페니스가 빠져나온다.
			PRINTFORMDW 공기에 노출된 페니스는 쾌락의 여운으로 움찔, 움찔 떨고 있다……
			;それ以外
		ELSE
			CALL HPH_PRINT,@"「응……윽 흐으」","L"
			PRINTFORMDW 오나홀을 들어 올리자, 로션에 발린 %조사처리(CALLNAME:TARGET,"의")% 페니스가 드러났다……
		ENDIF
	ENDIF
ENDIF
RETURN 1
