						CALL HPH_PRINT,@"「나, 이제, 참을 수 없어 \@ !TALENT:恋慕 ? 의에요 #  \@읏흐읍」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며, %조사처리(CALLNAME:MASTER,"의")% 허리를 붙잡고 야수 본능대로 자궁을 향해 페니스를 박아 넣었다.
						CALL HPH_PRINT,@"「미안해읏 HPH 미안, 해에…… 아아앗 HPH」","W"
					CASE 2
