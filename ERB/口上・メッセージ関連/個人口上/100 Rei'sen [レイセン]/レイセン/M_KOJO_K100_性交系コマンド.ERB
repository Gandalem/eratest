			ELSEIF TCVAR:PLAYER:102
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「지금, 예민해읏 HPH 히얀읏 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 허리를 갈아 넣으며 사정 직후의 민감한 페니스를 철저하게 괴롭힌다.
