LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORML 
		RETURN 1
		;押し倒され
	ELSEIF CFLAG:うふふ == 2
		PRINTFORML
		CALL AUTO_AEGI
		RETURN 1
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「응…… 파아…… 흐읍」","L"
			PRINTFORMDL 곤히 잠든 %조사처리(CALLNAME:TARGET,"의")% 머리를 쓰다듬으며, 살며시 입술을 맞댄다.
			PRINTFORMDW 좋은 꿈이라도 꾸고 있는 걸까. 그 잠든 얼굴은 평온하다……
		ELSE
			PRINTFORML 「……음응」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 깨지 않을까 조마조마해 했지만, 괜한 걱정이었던 것 같다……
		ENDIF
	ELSEIF CFLAG:添い寝中
		CALL HPH_PRINT,@"「츄……흐으윽」","L"
