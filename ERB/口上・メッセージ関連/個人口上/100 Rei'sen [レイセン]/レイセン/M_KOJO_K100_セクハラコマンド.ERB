;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K100_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K100_310
CALL M_KOJO_MESSAGE_COM_K100_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORML 
		RETURN 1
		;押し倒され
	ELSEIF CFLAG:うふふ == 2
		PRINTFORML
		CALL AUTO_AEGI
		RETURN 1
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「응으…… 하아…… 흐읍」","L"
			PRINTFORMDL 자고 있음에도 엉덩이를 쓰다듬어지는 %조사처리(CALLNAME:TARGET,"는")% 뺨을 상기시키며 요염하게 허리를 비튼다.
			PRINTFORMDW 「……정말 깨어있나?」%조사처리(CALLNAME:MASTER,"가")% 귓가에 그렇게 속삭이자, %조사처리(CALLNAME:TARGET,"의")% 몸이 움찔 떨렸다…….
		ELSE
			PRINTFORML 「……응응」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 잠 못 이루는 듯하다……
		ENDIF
		;合意無し
	ELSEIF !CFLAG:既成事実
		IF TALENT:恋慕
			PRINTFORML 「응... 안 돼, 이런 건...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 저항하지 않는 것을 기회 삼아, 그 부드러움을 마음껏 만끽했다……
			PRINTFORMW (하지만……%MASTERNAME:100%가 되면……)
		ELSEIF TALENT:思慕
			PRINTFORML 「야아... 안 돼,요...」
			PRINTFORMDL 입으로는 그렇게 말하지만, %조사처리(CALLNAME:TARGET,"는")% 저항할 기색조차 보이지 않는다.
			PRINTFORMW 「제 엉덩이... 그 정도로 좋아하시는 건가요...?」
		ELSE
			PRINTFORML 「햐앗!?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 귀여운 엉덩이에 손을 뻗어, 꽉 움켜쥐어주겠다
			PRINTFORMDL 갑작스러운 일에 %조사처리(CALLNAME:TARGET,"는")% 경직되어, 이대로 당하고 있는……
			PRINTFORMW 「윽, 으으…… 그만해 주세요……」
		ENDIF
		;通常
	ELSE
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「야, 아…… 꼬리는, 안돼…… HPH」","L"
					PRINTFORMDL 엉덩이와 꼬리를 동시에 쓰다듬히자, %조사처리(CALLNAME:TARGET,"는")% 고민하는 듯 허리를 비튼다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%, 「왜?」라며 귓가에 속삭여 보았다.
					CALL HPH_PRINT,@"「그게, 그게…… 기분 좋아져 버릴 것 같아서…… 흐으읍」","W"
				CASE 1
					CALL HPH_PRINT,@"「앗…… %MASTERNAME:100%……흐응」","L"
					CALL HPH_PRINT,@"「응, 응……큭! 야한 만짐은 하지 마……큭」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 성희롱당해서 되게 기뻐 보여…….
				CASE 2
					PRINTFORML 「히얀♪ 이제, 어쩔 수 없네……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 곤란하다는 듯, 하지만 조금만 기쁜 듯 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다.
					PRINTFORMW 「이런 거… 나 이외의 다른 사람한테 하면 안 돼?」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아앗…… 만지고 싶어졌어요……?」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"는")% 볼을 붉히며 뒤를 내밀었다.
					PRINTFORMW 「……조금만이라면…… 괜찮아요」
				CASE 1
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 치한처럼, 손등으로 스르륵 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 쓰다듬었다……
					PRINTFORMW 「만지는 방식이…… 응읏, 야해요……」
				CASE 2
					PRINTFORML 「햣!? 우으……또 그러시는 건가요...?」
					PRINTFORML 「그, 그게... 말해주신다면 만져도 괜찮으니까...」
					PRINTFORMW 「그러니까, 갑자기 하는 건 안 돼요... 놀라버리잖아요...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음... %MASTERNAME:100%, 치한 같아...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 조금 싫어하는 듯하다...
				CASE 1
					PRINTFORML 「히익!? 우으…… 그, 갑자기 그러면 깜짝 놀라버려요……」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 사랑스러운 비명이 들리자, %조사처리(CALLNAME:MASTER,"는")% 만족했다.
				CASE 2
					PRINTFORML 「내 엉덩이 따위, 만져도 즐겁지 않아……?」
					PRINTFORMDL 집요하게 엉덩이를 쓰다듬으려는 %조사처리(CALLNAME:MASTER,"를")% %조사처리(CALLNAME:TARGET,"는")% 당황한 표정으로 바라보고 있다.
					PRINTFORMW 「아니, 그만두라고……응, 크윽……윽」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
