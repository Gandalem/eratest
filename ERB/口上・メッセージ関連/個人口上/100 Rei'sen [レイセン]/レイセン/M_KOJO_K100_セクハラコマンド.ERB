	ELSE
		IF ABL:露出癖 <= 2
			PRINTFORML 「\@ TALENT:恋慕 ? 누군가 보게 될지도 모르니까, 조금만 할게……? # 아, 역시 부끄러워요오……읏 \@」
			;穿いてる
			IF TEQUIP:0 > 1
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 흥분을 가라앉히며 %조사처리(CALLNAME:TARGET,"의")% 귀여운 속옷을 자세히 감상했다.
				;穿いてない
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 치마를 걷어 올리자, 놀랍게도 %조사처리(CALLNAME:TARGET,"는")% 속옷을 입고 있지 않았다.
				PRINTFORMDW 「입지 않았어」%조사처리(CALLNAME:MASTER,"가")% 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% 얼굴을 새빨갛게 물리고 말을 더듬었다.
			ENDIF
		ELSEIF ABL:露出癖 <= 4
			PRINTFORML 「흐윽...」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 부탁받아%조사처리(CALLNAME:TARGET,"는")% 미세하게 손을 떨면서 스스로 치마 속을 드러냈다
			;穿いてる
			IF TEQUIP:0 > 1
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 몸을 숙이고, %조사처리(CALLNAME:TARGET,"의")% 귀여운 속옷을 마음껏 시간했다…….
				;穿いてない
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 『팬티 입고 안 왔어요』라며 놀리자, %조사처리(CALLNAME:TARGET,"는")% 부끄러움에 고개를 떨구었다.
			ENDIF
			PRINTFORMW 「이러면 나…… 그냥 변태잖아……」
		ELSE
			CALL HPH_PRINT,@"「하아…… 하아…… 흐읍」","L"
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 명령을 받자, %조사처리(CALLNAME:TARGET,"는")% 거친 숨을 몰아쉬며 스스로 치마를 들춰 올렸다.
			;穿いてる
			IF TEQUIP:0 > 1
				PRINTFORMDL 노출에 흥분했는지, \@ HAS_PENIS(TARGET) ? 단단하게 발기한 페니스가 속옷에서 흘러넘치고 끝부분에서는 앞서 나가는 침이 떨어지고 # 드러난 속옷의 클로치 부분에는 애액 자국이 생겨 있다 \@……
				;穿いてない
			ELSE
				PRINTFORMDL \@ HAS_PENIS(TARGET) ? 노출의 흥분에 %조사처리(CALLNAME:TARGET,"의")% 페니스는 치마를 들어 올릴 정도로 발기해 있다 # 속옷도 안 입고 있는데, %조사처리(CALLNAME:TARGET,"는")% 부끄러워하기는커녕 보여지는 것에 흥분해서 다리를 적시고 있다 \@……
			ENDIF
			CALL HPH_PRINT,@"「나…… 보여져서 흥분해 버렸어…… 후후」","W"
			PALAM:潤滑 += 500
		ENDIF
	ENDIF
ENDIF
RETURN 1
