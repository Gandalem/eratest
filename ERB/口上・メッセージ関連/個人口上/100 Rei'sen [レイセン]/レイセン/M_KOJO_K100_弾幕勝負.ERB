; Modular ERB: 個人口上/100 Rei'sen [レイセン]/レイセン/M_KOJO_K100_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K100_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF TALENT:妊娠
			PRINTFORML 「정, 정말로 할 거예요\@ TALENT:恋慕 ? 의 # 아니에요 \@……?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 배 속의 아이가 걱정스러운 듯하다.
			PRINTFORMW 「……부디 살살 해줘\@ TALENT:恋慕 ? ……알았지? # 부탁해요\@」
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「저도 어쨌든 군인이니까…… 할 수 있을 거예요, 분명히!」
				CASE 1
					PRINTFORML 「싸움은 별로 자신 없는데……읏」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 눈빛이 변했다...!
				CASE 2
					PRINTFORML 「토끼도 7일 놀면 물지 않는다는 속담…… 알고 있나요? \@ TALENT:恋慕 ? 알아요 # 몰라요 \@?」
					PRINTFORMDW 괴롭힘당하는 게 전제인 걸까……
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 「흐으윽…… 강해……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 약해지고 있다.
			CASE 1
				PRINTFORML 「윽…… 역시 나는 안 되는 걸까……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 마음이 부서져 가고 있다.
			CASE 0
				PRINTFORML 「아파아…… 끅……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 마음이 부서졌다
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 「\@ TALENT:恋慕 ? 미, 미안해…… 좀 과하게 해버린 것 같아 # 괜찮으세요? \@」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 상처를 치료해 주었다.
			CASE 2
				PRINTFORML 「후우…… 제대로 연습해서 다행이야……」
				PRINTFORMDW 군인에게는 이길 수 없었어…….
			CASE 1
				PRINTFORML 「하아…… 다행이야……」
				PRINTFORMDW 기운이 빠졌는지, %조사처리(CALLNAME:TARGET,"는")% 주저앉듯 바닥에 주저앉았다.
				;あなたが男
				SIF TALENT:MASTER:性別 == 2
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 땅에 쓰러진 채, 스커트 속에 펼쳐진 꽃밭을 가득 시간했다.
			CASE 0
				PRINTFORML 「하아…… 지고 말았어……」
				PRINTFORMDW 장난으로 하는 게 아니잖아
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
