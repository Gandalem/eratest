;411,戦闘訓練
;TFLAG:194(3=夏の昼間 2=ヤバい天気 1=悪天候 0=屋内or通常天気
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K100_411
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K100_411
CALL M_KOJO_MESSAGE_COM_K100_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_411_1
#DIM 正解
#DIM 経験値
#DIM 制限時間
#DIM 倍率
#DIM FEINT
#DIM イカサマ
VARSET LOCAL
イカサマ = 0
制限時間 = 2000 - (ABL:100:戦闘能力 - ABL:MASTER:戦闘能力) * 100
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;３分の１の確率で特別な稽古
	IF !RAND:3
		;特訓デイリーからお借りしました
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 전장에서 살아남기 위한 수련을 하기로 했다.
		PRINTFORML 「에엣, 쏴 보라고……. 그건 위험하잖아요\@ !TALENT:恋慕 ? 이예요 #  \@……」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 별로 의욕이 없는 것 같지만……
		RESETCOLOR
		PRINTFORML 
		CALL ASK_YN("상관없어! 해.","역시 멈춰")
		IF RESULT
			CALL M_KOJO_COLOR_K100
			PRINTFORML 「휴……」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 위험한 것을 멈춰준 덕분에 %조사처리(CALLNAME:TARGET,"는")% 안심하고 있다
			RESETCOLOR
		ELSE
			正解 = RAND:4
			経験値 = MIN(ABL:100:戦闘能力 * 5, 5)
			SELECTCASE RAND:20
				;漢字
				CASE IS <= 11
					LOCALS:0 = 上
					LOCALS:1 = 右
					LOCALS:2 = 左
					LOCALS:3 = 下
					倍率 = 100
					;ひらがな
				CASE 12 TO 15
					LOCALS:0 = うえ
					LOCALS:1 = みぎ
					LOCALS:2 = ひだり
					LOCALS:3 = した
					倍率 = 100
					;カタカナ
				CASE 16,17,18
					LOCALS:0 = ウエ
					LOCALS:1 = ミギ
					LOCALS:2 = ヒダリ
					LOCALS:3 = シタ
					倍率 = 100
					;スワヒリ語
				CASE 19
					LOCALS:0 = juu
					LOCALS:1 = kulia
					LOCALS:2 = kushoto
					LOCALS:3 = chini
					倍率 = 320
			ENDSELECT
			;あなたの戦闘能力が高いと５分の一の確率でフェイントをかけてくる
			IF ABL:MASTER:戦闘能力 >= 5 && !RAND:5
				FEINT = 1
				制限時間 += 400
				倍率 += 80
			ELSE
				FEINT = 0
			ENDIF
			CALL FISHER_YATES_SHAFFLE(4)
			PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 공격을 피한다 (클릭으로 시작)
			PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
			SETCOLOR C_YELLOW
			IF FEINT
				PRINTFORM %LOCALS:(RAND:4)%
				RESETCOLOR
				PRINTFORM 하고 보이면서 %LOCALS:(3 - 正解)%
			ELSE
				PRINTFORM %LOCALS:(3 - 正解)%
				RESETCOLOR
			ENDIF
			PRINTFORML 저쪽에서 총격이!
			$LOOP_IKASAMA
			FOR LOCAL:10,0,4
			LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
			PRINTFORML [{LOCAL}] ｛로컬｝ - %LOCALS:LOCAL%에게 피한다
			NEXT
			SIF !イカサマ && BASE:MASTER:TSP > 500
				PRINTFORML [{4}] - 시간 정지
			TINPUT 制限時間, -1, 1
			IF RESULT == 正解
				CALL M_KOJO_COLOR_K100
				IF イカサマ
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 속여서 공격을 회피했다
				ELSE
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 총격을 회피했다!
				ENDIF
				PRINTFORML 「스, 굉장해…… 정말 맞힐 생각으로 쐈는데」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 지극히 위험한 말을 하고 있다.
				PRINTFORMDW ……혹시 미움받고 있는 것일까
				RESETCOLOR
				BASE:MASTER:体力 -= 200 * (1 + ABL:100:戦闘能力)
				経験値 = 経験値 * 倍率 / 100
				EXP:MASTER:戦闘経験 += 経験値
				EXP:100:戦闘経験 += 経験値 * 2
				CFLAG:100:好感度 += 経験値 * 2
				CFLAG:100:信頼度 += 経験値 * 2
				PRINTFORML 전투 경험 + {経験値}(%CALLNAME:MASTER%)
				PRINTFORML 전투 경험 + {経験値 * 2}(%CALLNAME:TARGET%)
				PRINTFORML 호감도 + {経験値 * 2}(%CALLNAME:TARGET%)
				PRINTFORML 신뢰도 + {経験値 * 2}(%CALLNAME:TARGET%)
			ELSEIF RESULT == 4 && !イカサマ && BASE:MASTER:TSP > 500
				イカサマ = 1
				倍率 /= 5
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 시간 정지 능력으로 사선을 간파했다!
				GOTO LOOP_IKASAMA
			ELSE
				SETCOLOR C_RED
				FONTBOLD
				PRINTFORML 
				PRINTFORML 파앙
				PRINTFORMW 
				FONTREGULAR
				RESETCOLOR
				CALL M_KOJO_COLOR_K100
				PRINTFORML 「에에에에에엣!?」
				PRINTFORMDL %CALLNAME:TARGET%은로부터의 공격을 피할 수 없었다
				PRINTFORMDL 타오르는 듯한 고통에 %조사처리(CALLNAME:MASTER,"는")% 일어나는 것조차 힘들어졌다…… 두통이 온다…… 아…… 메스꺼움도……
				PRINTFORML 「피, 피가! 어, 응급처치를 해!」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 생명을 구하려 필사적으로 처치하고 있다
				PRINTFORMDW 나머지는 그녀에게 맡기자. %조사처리(CALLNAME:MASTER,"는")% 눈을 감고 그대로 의식을 잃었다……
				RESETCOLOR
				BASE:MASTER:体力 -= 1000 * (1 + ABL:100:戦闘能力)
				PRINTFORML 전투 경험 + {経験値}(%CALLNAME:TARGET%)
				EXP:100:戦闘経験 += 経験値
				CFLAG:100:好感度 += 経験値 / 2
				CFLAG:100:信頼度 += 経験値 / 2
				PRINTFORML 호감도 + {経験値}(%CALLNAME:TARGET%)
				PRINTFORML 신뢰도 + {経験値}(%CALLNAME:TARGET%)
			ENDIF
		ENDIF
		;通常
	ELSE
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 수련에 함께하기로 했다.
		PRINTFORMDW ………
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「헉, 하아, 이제 한계야~~!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"와")% 달리기를 했다
			CASE 1
				PRINTFORML 「야아아」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 기술을 겨루었다.
				PRINTFORMDW 어딘가에 구호가 대충 하는 것 같다는 건 내 기분 탓일까……
			CASE 2
				PRINTFORML 「팔이 구부러지지 않는다고……. 우으윽……. 이 이상은……. 큭」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 팔굽혀펴기를 하고 있다.
			CASE 3
				;Q-E SPAM
				PRINTFORML 「음, 적이랑 격투할 때는 상체를 좌우로 움직이면서……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 뭔가 수상한 움직임을 보이고 있다.
			CASE 4
				PRINTFORML 「%TEXTR("やった！当たった！/ぁぅ……外れたぁ……/")%」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 사격 훈련을 지켜보았다
		ENDSELECT
		RESETCOLOR
	ENDIF
ENDIF
RETURN 1
