@M_KOJO_MESSAGE_COM_K100_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;恋人
	IF TALENT:恋人
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「더 꽉 잡아도 돼?」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"가")% 손가락을 얽어왔다.
			PRINTFORMW 「이렇게 하는 게 연인 같아 보이지 않아?」
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「저번에 말이야, %MASTERNAME:100%랑 손잡고 있는 걸 아는 사람이 봤던 것 같아서……」
			PRINTFORML 「『보호자 분이랑 같이 다니네』라며 놀림을 받았어」
			PRINTFORMW 「……나, 그렇게 어린애처럼 보이나」
			;成功
		ELSE
			PRINTFORML 「저쪽 도착하면 어떡하지」
			PRINTFORMW 「나는 %MASTERNAME:100%랑 함께라면 뭐든지 괜찮아」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「～～♪ ～～♪」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 손잡고 길을 나아갔다
			PRINTFORMW 「저쪽 도착하면 뭐 할까아」
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML (%MASTERNAME:100%의 손, 땀으로 흥건해……)
			PRINTFORMW 「……그, 엄청난 손바닥에 땀이 나는데…… 괜찮아?」
			;成功
		ELSE
			PRINTFORML 「이렇게 손을 잡고 걸으면, 데이트 같은 기분이 들지 않아?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 맞잡은 손을 기쁘다는 듯 흔들고 있다.
			PRINTFORMW 「후훗, %MASTERNAME:100%도 그렇게 생각해?」
		ENDIF
		;思慕
	ELSEIF TALENT:思慕
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「%MASTERNAME:100%의 손, 따뜻해요」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 손가락을 얽자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯하면서도 맞잡아 주었다.
			PRINTFORMW 「……이렇게 하고 있으면, 왠지 연인 같네요」
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「앗……」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"의")% 손을 잡자, 그 손은 축 땀으로 젖어 있었다.
			PRINTFORMW 「그, 긴장해서요... 바로 닦을게요」
			;成功
		ELSE
			PRINTFORML 「이렇게 손잡고 걸으면, 사이좋은 커플 같아서 좋네요」
			PRINTFORMW 「저쪽 도착하면 뭘 할까요」
		ENDIF
		;それ以外
	ELSE
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「데이트……이니까 그렇죠」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 손을 다시 잡아주며 어딘가 기쁜 듯 옆에 나란히 섰다.
			PRINTFORMW 「저쪽에서 뭘 할까요」
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「아……앗」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 손을 잡자, %조사처리(CALLNAME:TARGET,"는")% 놀란 듯 몸을 경직시켰다.
			PRINTFORMW 「갑자기라…… 조금 깜짝 놀랐어요」
			;成功
		ELSE
			PRINTFORML 「그, 땀이 나면 죄송해요...」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 그런 것은 신경 쓰지 않겠다는 듯 잡는 손에 힘을 준다.
			PRINTFORMW (%MASTERNAME:100%의 손, 따뜻하네...)
		ENDIF
	ENDIF
ENDIF
RETURN 1
