@M_KOJO_MESSAGE_COM_K100_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:睡眠
		PRINTFORML 
		RETURN 1
		;固有料理
	ELSEIF DISHNAME == "にんじんしりしり"
