				PRINTFORMDW 깊이 잠든 %조사처리(CALLNAME:TARGET,"를")% 가끔 흘겨보며, %조사처리(CALLNAME:MASTER,"는")% 공부에 힘썼다.
		ENDSELECT
		;怒り
	ELSEIF CFLAG:318
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「음…… 우으응…… 뭐였더라……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 공부에 집중하고 있지 못한 것 같다……
			CASE 1
				PRINTFORML 「음……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 공부에 도저히 집중하지 못하고 있다.
		ENDSELECT
		;通常
	ELSE
		;恋人
		IF TALENT:恋人
			SELECTCASE RAND:3
