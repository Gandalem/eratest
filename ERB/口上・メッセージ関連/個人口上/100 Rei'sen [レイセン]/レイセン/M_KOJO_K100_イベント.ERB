@M_KOJO_EVENT_K100_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	IF !TCVAR:100:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			$REISEN_ENCOUNTER
			IF TALENT:恋慕
				IF !RAND:5
					PRINTFORMDL 아무래도……%조사처리(CALLNAME:TARGET,"는")% 아직 이쪽을 눈치채지 못한 것 같다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 조용히 뒤에서 다가가, %TEXTR(" 레이센을 꽉 끌어안았다/목덜미에 숨을 불어넣었다/'앗' 하고 큰 소리로 놀라게 했다/")%.
					PRINTFORML 「히야아앗?!! 아, %MASTERNAME:100%……?」 
					PRINTFORML 「정말! 갑자기 놀라다니 너무해!」 
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% '미안 미안'이라며 사과하면서, 다음엔 언제 장난을 쳐볼까 생각에 잠겼다.
				ELSE
					PRINTFORML 「아, %MASTERNAME:100%!」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 눈치채고는, 볼을 물들인 채 기쁘게 달려왔다.
					PRINTFORMDL 그 모습이 너무나 사랑스러웠기에, %조사처리(CALLNAME:MASTER,"는")% 애완동물처럼 상냥하게 머리를 쓰다듬어 주었다.
					PRINTFORMW 「흐응… 간지러워……」 
				ENDIF
			ELSEIF TALENT:思慕
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아, %MASTERNAME:100%. 잘 지내세요?」
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 본 %조사처리(CALLNAME:TARGET,"가")% 반갑게 인사해 왔다
					CASE 1
						PRINTFORML 「%MASTERNAME:100%, 와 주셨나요?」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%%조사처리(CALLNAME:MASTER,"를")% 응시하자, 얼굴이 환해졌다
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 『그렇게 보고 싶었어?』라며 그녀를 놀렸다...
						PRINTFORMW 「그, 그런 건 아니지만... 그래도 기뻐요.」 
				ENDSELECT
			ELSE
				PRINTFORM 「아, %MASTERNAME:100%……」
				;TIME:2で朝昼晩を選択
				SELECTCASE TIME:2
					;朝
					CASE 1,2
						PRINTFORML 「좋은 아침이에요」
						;昼
					CASE 3,4
						PRINTFORML 「안녕하세요」
						;夜
					CASE 5,6,7
						PRINTFORML 안녕
				ENDSELECT
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 이쪽을 알아차리자, 꾸벅 고개를 숙여 왔다.
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			GOTO REISEN_ENCOUNTER
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF TALENT:恋慕
				PRINTFORML 「아, %MASTERNAME:100%. 목욕하고 있었어?」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 욕조에서 쉬고 있을 때, %조사처리(CALLNAME:TARGET,"가")% 들어왔다.
				PRINTFORMDL 「바로 나올 테니까」 %조사처리(CALLNAME:MASTER,"는")% 그렇게 말하며 일어나려 하지만……
				PRINTFORML 「등을 씻겨 줄게♪」
				PRINTFORMDW 결국, 둘이 함께 들어가게 되었다.
			ELSE
				PRINTFORML 「저기…… 같이 들어가도, 괜찮을까요?」
				PRINTFORMDL 설마 %조사처리(CALLNAME:TARGET,"가")% 그런 말을 할 줄이야……
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 의외라는 표정을 지으면서도, 그녀를 위해 자리를 비워주었다.
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			PRINTFORML 「꺄앗!? 저, 죄송해요!」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 부르기 전에 %조사처리(CALLNAME:TARGET,"는")% 방문을 닫아버렸다.
			PRINTFORMDW ……누군가 목욕 중인 것을 눈치채지 못하다니, 꽤나 지쳐 있었던 걸까
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			PRINTFORML 「아, 저기이……」
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 목욕을 하며 편하게 쉬고 있을 때, 문 너머로 %조사처리(CALLNAME:TARGET,"의")% 목소리가 들려왔다.
			PRINTFORML 「뒤가 막히는 것 같아서…… 그게, 일찍 부탁드려요」
			PRINTFORMDW 아무래도 기다리게 해버린 모양이다. 어쩔 수 없이, %조사처리(CALLNAME:MASTER,"는")% 서둘러 욕실에서 나오기로 했다.
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			GOTO REISEN_ENCOUNTER
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			PRINTFORML 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MAIN_MAP上で一日最初の挨拶
		;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 8
			PRINTFORML 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で一日最初の挨拶
		;ARG:1にデート相手、ARG:1が0の場合は非デート
		;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 9
			;ARG:1とデート中
			IF ARG:1
				;一人で外出
			ELSE
			ENDIF
			PRINTFORML 
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
