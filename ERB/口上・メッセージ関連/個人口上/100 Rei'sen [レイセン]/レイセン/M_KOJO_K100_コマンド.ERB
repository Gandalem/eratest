;==================================================
;90,アナル愛撫される
;==================================================

@M_KOJO_MESSAGE_COM_K100_90
CALL M_KOJO_MESSAGE_COM_K100_90_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;あなたのＡ感覚５以上
	IF ABL:MASTER:Ａ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「후후, 엄청난 소리가 나오잖아\@ TALENT:恋慕 ? ~해 # ~해요 \@? HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 즐거운 듯이 %조사처리(CALLNAME:MASTER,"의")% 항문을 파고 있다.
				PRINTFORMDW 그 표정에는 어딘가 가학적인 기색마저 역력하다……
			CASE 1
				CALL HPH_PRINT,@"「나도 만져줘읏 \@ TALENT:恋慕 ? 하고 싶어 # 마음에 들어 \@ 응…… HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 항문에 손가락을 넣었다 빼기를 반복하며,
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% \@ HAS_PENIS(MASTER) ? 페니스를 손으로 문지르며 애무했다 # 질에 손가락을 삽입하고 약한 부분을 자극했다 \@
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 침을 흘리며 신음하고 있다……
			CASE 2
				CALL HPH_PRINT,@"「똥구멍을 만지는 것, 기분 좋은 것인가 \@ TALENT:恋慕 ? 의 # 이입니까 \@?HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 허리를 떨면서, %조사처리(CALLNAME:TARGET,"에게")% 몇 번이고 고개를 끄덕인다……
				CALL HPH_PRINT,@"「……크흡HPH 조금 즐거워지기 시작한 것 같아 HPH」","W"
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「저기, 이런 느낌일까? \@ TALENT:恋慕 ? 그렇겠지 # 그럴까요 \@……?」
				PRINTFORMDL 변태적인 요구에도 불구하고 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해주려고 노력하고 있다.
				PRINTFORMW 「다음은 안에 손가락을? 이렇게 하면 될까……?」
			CASE 1
				PRINTFORML (%MASTERNAME:100%의 엉덩이가 움찔거리고 있어...)
				PRINTFORML (이런 게 기분 좋은 거구나...)
				PRINTFORMDW 항문을 헤집히며 하아하아 하고 숨을 몰아쉬는 %조사처리(CALLNAME:MASTER,"를")% 보고, %조사처리(CALLNAME:TARGET,"는")% 소름 끼치는 것을 느꼈다...
			CASE 2
				PRINTFORML 「앗, 아팠나요\@ !TALENT:恋慕 ? 인가 #  \@……?」
				PRINTFORML 「음……. 흘려……. 이걸로……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 손가락에 타액을 떨어뜨리고, 항문 쪽의 애무를 재개했다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;91,アナル舐めされる
;==================================================

@M_KOJO_MESSAGE_COM_K100_91
CALL M_KOJO_MESSAGE_COM_K100_91_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_91_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「――에? 엉덩이 구멍을……?」
		PRINTFORML 「……………………」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 잠시 망설인 뒤……
		PRINTFORML 「우……응……핥짝……읏」
		PRINTFORMDW 결심을 하고, 항문에 대한 봉사를 시작했다……
		RETURN 1
	ENDIF
	;基本セット
	;あなたのＡ感覚５以上で１０回以上舐めさせた
	IF ABL:MASTER:Ａ感覚 >= 5 && CFLAG:100:1006 >= 10
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 핥으라고 명령하자,
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 망설임도 없이 얼굴을 파묻고 심지어 혀까지 밀어 넣었다.
				CALL HPH_PRINT,@"「츄……응르……앗 HPH 응, 큭……HPH」","L"
				CALL HPH_PRINT,@"(쓰고, 맛은 없는데…… 중독될 것 같아…… HPH)","W"
			CASE 1
				CALL HPH_PRINT,@"「음무……츄……읏흐으……응……읏흐으」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 멍한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 항문을 핥고 있다.
				PRINTFORMDW 「맛있어?」 %조사처리(CALLNAME:MASTER,"가")% 그렇게 말하자, %조사처리(CALLNAME:TARGET,"는")% 표정을 부드럽게 한 채 고개를 끄덕였다……
			CASE 2
				CALL HPH_PRINT,@"「깨끗하게 해줄게 \@ TALENT:恋慕 ? 하고 있어 # 할게 \@네…… HPH」","L"
				PRINTFORMDL 벌어진 엉덩이 사이의 틈에 얼굴을 묻고, 끈적하게 항문을 핥는 %CALLNAME:TARGET%
				PRINTFORMDW 조여진 주름 하나하나를 세는 듯한 혀놀림에, %조사처리(CALLNAME:MASTER,"는")% 황홀함으로 내쉬는 숨을 떨었다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「핥짝... 핥짝... 응, 츄...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 혀끝으로 치로치로 항문을 핥고 있다.
				PRINTFORMDW 아직 저항이 남아있는 것인지, 그 봉사는 서툴렀다.
			CASE 1
				PRINTFORML 「질척…… 핥아져 버릴 것 같아……윽」
				PRINTFORMDL 엉덩이 구멍에 혀를 갖다 대며, 이따금 무언가를 참는 듯 신음하는 %조사처리(CALLNAME:TARGET,"는")%……
				PRINTFORML (위험했어…… 조금만 더 있으면 나……. )
				PRINTFORMDW 하지만 그건 안 돼. %조사처리(CALLNAME:TARGET,"는")% 호흡을 가다듬고 다시 %조사처리(CALLNAME:MASTER,"의")% 항문에 혀를 뻗었다
			CASE 2
				PRINTFORML 「쪽…… 쪽…… 후우…… 츄……」
				PRINTFORML (이런 곳까지 보여주면, 정말 와타츠키님에게 버려질지도……)
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈물을 글썽이며 %조사처리(CALLNAME:MASTER,"의")% 항문을 혀로 닦고 있다……
		ENDSELECT
		CFLAG:100:1006 += 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1
