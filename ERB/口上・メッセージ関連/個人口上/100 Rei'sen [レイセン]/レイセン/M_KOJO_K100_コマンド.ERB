;92,Ａ正常位される
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K100_92
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K100_92
CALL M_KOJO_MESSAGE_COM_K100_92_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_92_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;アナル処女喪失
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:PLAYER:Ａ破瓜
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 뒤에서 처음을 바쳤다……
		PRINTFORMDW 
		CALL HPH_PRINT,@"「아아…… 정말로 삽입해버렸어…… HPH」","W"
		PRINTFORMW 「음……안 아프지? \@ TALENT:恋慕 ? 그렇구나 # 그런 건가 \@……?」
		CALL HPH_PRINT,@"「……다행이다…… 저기, 그럼…… HPH」","W"
		PRINTFORMDW 「움직여도 돼」 %조사처리(CALLNAME:MASTER,"가")% 그렇게 말하자, %조사처리(CALLNAME:TARGET,"는")% 천천히 허리를 움직이기 시작했다
		CALL HPH_PRINT,@"「응읏…… 응읏…… 숨이 차면 말해줘 \@ !TALENT:恋慕 ? 주세요 #  \@네……숨차면」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:PLAYER:101 == TARGET
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 더 움직이도록 요구했다……
		PRINTFORMDW 
		;恋慕
		IF TALENT:恋慕
			;今射精した
			IF NOWEX:100:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「큭흐윽... 흐읍... 후우…… 흐읍...」","L"
						PRINTFORMDL 격렬하게 허리를 움직이고 있던 %조사처리(CALLNAME:TARGET,"가")% 동작을 멈춘다.
						PRINTFORMDL 그대로 벌벌 떨며 허리를 떨던 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 향해 쓰러졌다.
						CALL HPH_PRINT,@"「아, 헤헤……HPH 기분 좋아서…… 다 나와버렸어…… HPH」","L"
						PRINTFORMDL 쾌락과 행복이 뒤섞인, 나른한 얼굴을 드러내는 %CALLNAME:TARGET%
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그런 그녀의 머리를 부드럽게 여러 번 쓰다듬어 주었다.
					CASE 1
						CALL HPH_PRINT,@"「하아앗! 후우읍! 더...!! 흐으윽! 하아, 하아……」","L"
						PRINTFORMDL 즈욱 허리를 밀어넣자 %조사처리(CALLNAME:TARGET,"가")% 사정한다.
						PRINTFORMDL 쉭쉭거리는 소리가 들릴 듯한 양의 정액이, %조사처리(CALLNAME:MASTER,"의")% 안을 하얗게 더럽힌다……
						CALL HPH_PRINT,@"「아우으…… HPH 안 돼, 멈추지 않아…… HPH」","L"
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 배…… 탱탱해져 버릴 거야…… HPH」","L"
						PRINTFORMDL 황홀한 표정으로 사정의 쾌락에 취해 있는 %조사처리(CALLNAME:TARGET,"가")%……
						PRINTFORMDL 몇 분에 걸쳐 씨를 뿌리는 것을 마친 %조사처리(CALLNAME:TARGET,"가")% 페니스를 빼자,
						PRINTFORMDW 역류한 정액이 고포옷 소리를 내며 항문에서 흘러나왔다
					CASE 2
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 허리를 박아대는 %조사처리(CALLNAME:TARGET,"의")% 움직임이 점점 빨라진다…….
						CALL HPH_PRINT,@"(엉덩이로 교미하는 거 너무 HPH 기분 좋아서 어쩔 줄 몰라아)","L"
						CALL HPH_PRINT,@"「크윽! 후우... 아으, 우으읍! 흐응 흐응 흐응」","L"
						PRINTFORMDL 부르륵, 부르르륵, 덥석, 꿀꺽……
						CALL HPH_PRINT,@"「흐으윽…… 어떡해…… HPH 거시기, 바보가 되어버렸어…… HPH」","L"
						PRINTFORMDL 정액으로 완전히 가득 찬 %조사처리(CALLNAME:MASTER,"의")% 장 속에서 %조사처리(CALLNAME:TARGET,"의")% 페니스가 몇 번이고 튕긴다.
						PRINTFORMDW 이만큼 사정했는데도 삽입된 페니스는 여전히 단단함을 유지하고 있었다.
				ENDSELECT
				RETURN 1
				;挿入継続
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「후우읍! 헉 후우읍! 음, 크으윽!」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 덮쳐져, 탱탱하게 허리를 때리는 %CALLNAME:TARGET%
						PRINTFORMDW 두 사람이 결합한 부분에서는 구부글과 같은 음탕한 소리가 울리고 있다……
					CASE 1
						CALL HPH_PRINT,@"「더, 격렬하게, 좋지…? 후으응」","L"
						CALL HPH_PRINT,@"「아기, 못 만들 거니까……읏 HPH」","L"
						PRINTFORMDL 참지 못하는 건가, %조사처리(CALLNAME:TARGET,"는")% 느릿한 움직임을 멈추고 격렬하게 페니스를 밀어 넣었다.
						PRINTFORMDW 발정 난 짐승 같은 허리짓이 %조사처리(CALLNAME:MASTER,"를")% 점점 암컷으로 만들어 간다……
					CASE 2
						CALL HPH_PRINT,@"「흐윽 HPH 그것! HPH 기분, 으윽 HPH」","L"
						PRINTFORMDL 큐읏하고 조여오는 항문에 %조사처리(CALLNAME:TARGET,"가")% 입꼬리부터 침을 흘린다.
						PRINTFORMDW 그대로 앞뒤로 허리를 흔들어 주자, 삽입된 페니스가 %조사처리(CALLNAME:MASTER,"의")% 안에서 몇 번이고 튕겼다.
				ENDSELECT
				RETURN 1
			ENDIF
			;それ以外
		ELSE
			;今射精した
			IF NOWEX:100:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「갈 것 같아, 아앗……! 후우욱 빼지 않으면……윽!」","L"
						CALL HPH_PRINT,@"「나와버려……. 흐윽! 엉덩이에, 나올 것 같아흐읍! 흐으윽!」","L"
						PRINTFORMDL 머리로는 알고 있어도 야수의 본능이 그것을 허락하지 않는다.
						PRINTFORMDL 한계에 다다른 %조사처리(CALLNAME:TARGET,"는")% 뿌리까지 페니스를 밀어 넣고,
						PRINTFORMDW 참아왔던 모든 것을 %조사처리(CALLNAME:MASTER,"의")% 안에 풀어놓았다.
					CASE 1
						CALL HPH_PRINT,@"「하아앗 HPH 하아앗 HPH 다, 흐윽 HPH」","L"
						CALL HPH_PRINT,@"「나, 벌써 HPH 해버릴 것 같아읏 HPH」","L"
						PRINTFORMDL 그렇게 말하면서도 허리를 움직이는 것을 멈추지 않는 %조사처리(CALLNAME:TARGET,"는")%,
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 안쪽을 조여주자,
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 비틀거리며 몸을 떨면서 짐승의 본능대로 대량의 정액을 %조사처리(CALLNAME:MASTER,"의")% 안에 쏟아냈다.
					CASE 2
						CALL HPH_PRINT,@"(기분 좋아…… 기분 좋아…… 큭!)","L"
						CALL HPH_PRINT,@"(%MASTERNAME:100%의 엉덩이, 너무 기분 좋아서…… 앗, 온다아 HPH)","L"
						PRINTFORMDL 짜릿하게 %조사처리(CALLNAME:TARGET,"가")% 몸을 떨게 한다.
						PRINTFORMDL 거친 숨소리와 배의 따뜻한 감촉…… 아무래도 절정에 다다른 모양이다.
						CALL HPH_PRINT,@"「하아…… 아아…… HPH 저, 저…… HPH」","L"
						PRINTFORMDW 「괜찮아」%조사처리(CALLNAME:MASTER,"가")% 머리를 쓰다듬자, %조사처리(CALLNAME:TARGET,"는")% 안심한 듯 눈을 가늘게 떴다……
				ENDSELECT
				RETURN 1
				;挿入継続
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응, 후우…… 하아…… 큭흐읍」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 천천히 %조사처리(CALLNAME:MASTER,"의")% 항문에 페니스를 넣었다 빼기를 반복하고 있다……
						CALL HPH_PRINT,@"「어때요……? HPH 으앗 HPH」","L"
						PRINTFORMDW 대답이라며 항문을 조이자, 삽입된 페니스가 %조사처리(CALLNAME:MASTER,"의")% 안에서 파르르 떨렸다.
					CASE 1
						CALL HPH_PRINT,@"「후우…… 후우…… 큭! 응응 큭」","L"
						CALL HPH_PRINT,@"「그렇게, 꽉 조이면 헉... 금방 가버릴 것 같아……헉」","L"
						PRINTFORMDL 허리 움직임을 멈추고 %조사처리(CALLNAME:TARGET,"에게")% 힘을 빼라고 말하는 %CALLNAME:MASTER%
						PRINTFORMDW 기분 좋아 보이게 골반을 흔드는 %조사처리(CALLNAME:TARGET,"를")% 보고 있으면, 나도 모르게 심술 부리고 싶어져 버린다……
					CASE 2
						CALL HPH_PRINT,@"(사실은 이런 거 안 돼……. 하으윽)","L"
