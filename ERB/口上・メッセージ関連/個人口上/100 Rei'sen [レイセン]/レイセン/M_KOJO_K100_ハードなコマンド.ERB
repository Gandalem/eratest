;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K100_140
CALL M_KOJO_MESSAGE_COM_K100_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;舌技術５以上
	IF ABL:舌 >= 5
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 예고도 없이, %조사처리(CALLNAME:TARGET,"의")% 목구멍 깊은 곳에서 사정했다
					CALL HPH_PRINT,@"「끄윽, 응! 하햣... 하아... 읏하햣」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 트롱하고 얼굴을 녹이며, 흘러들어 오는 정액을 위로 받아들이고 있다……
				CASE 1
					CALL HPH_PRINT,@"「큭, 푸흡 HPH 주푸흡 HPH 구포흡 HPH」","L"
					PRINTFORMDL 후배위로 범할 때처럼, %조사처리(CALLNAME:TARGET,"의")% 얼굴을 움켜쥐고 허리를 찍어 박는다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 아무런 불평도 하지 않고 그 행위를 받아들이고 있다……
				CASE 2
					CALL HPH_PRINT,@"「끄읍, 후흣흐윽 에읍 흐으응읏」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 목구멍 깊숙한 곳으로, 다량의 뜨거운 정액이 뚝뚝 쏟아져 들어간다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 허리에 단단히 손을 감고, 한 방울도 흘리지 않고 그것을 마시고 있다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후으윽 HPH 후으윽 HPH 응, 음응! HPH」","L"
					PRINTFORMDL 어느 정도 거칠게 다뤄도 부서지지 않는 점이 %조사처리(CALLNAME:TARGET,"의")% 좋은 점이다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 욕망대로, %조사처리(CALLNAME:TARGET,"의")% 목을 '사용했다'.
				CASE 1
					CALL HPH_PRINT,@"「읏, 케폿……하아……하아……큭」","L"
					PRINTFORMDL 눈물과 코물, 그리고 침으로 얼굴을 범벅으로 만들면서도, 나에게 미소 짓는 %CALLNAME:TARGET%
					PRINTFORMDW 만약 그녀를 노예로 팔았다면, 분명 상당한 금액이 될 테지……
				CASE 2
					CALL HPH_PRINT,@"「음후우, 쭉 혓바닥이 닿아 HPH 후우, 꾸욱 HPH」","L"
					PRINTFORMDL 난폭하게 목을 범당하면서도, %조사처리(CALLNAME:TARGET,"는")% 봉사를 잊지 않는다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 기분 좋아질 수 있도록, 최대한의 기술로 페니스를 대접했다.
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「엣!? 아, 응, 크윽...!」
					PRINTFORMDL 목구멍 깊은 곳에서 페니스가 경련하며 정액을 직접 식도로 쏟아붓는다.
					PRINTFORMDW 산소 부족으로 축 늘어진 %조사처리(CALLNAME:TARGET,"를")%, %조사처리(CALLNAME:MASTER,"는")% 오나홀처럼 다루었다.
				CASE 1
					PRINTFORML 「후붓! 응읏! 음음읏! ――윽!!!」
					PRINTFORMDL 그저 자신이 기분 좋아지기 위해서, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 목을 강간한다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 체념한 듯, 그저 끝이 나기를 기다리고 있다……
				CASE 2
					PRINTFORMDL 한계가 온 %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 머리를 끌어당기더니, 그대로 목구멍 깊숙한 곳에서 사정했다.
					PRINTFORML 「흡, 윽! 응, 크윽, 컥! 컥!」
					PRINTFORMDW 페니스를 빼내자, %조사처리(CALLNAME:TARGET,"는")% 코로 정액을 흘리며 격렬하게 기침했다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「응, 읍!? 컥! 흐으윽!?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리를 단단히 붙잡고 부담을 생각하지 않은 채 허리를 밀어 넣는다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 완전히 혼란에 빠져 눈이 동그래져 있다……
				CASE 1
					PRINTFORML 「오, 아앗!? 아우윽! 우으읏!」
					PRINTFORMDL 괴로워하며 다리를 차는 %조사처리(CALLNAME:TARGET,"를")% 무시하고 욕망대로 허리를 흔든다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈물과 콧물로 얼굴이 범벅이 되어 있다...
				CASE 2
					PRINTFORML 「큭, 큭, 컥! 흡! 하아... 하아...」
					PRINTFORML 「어, 어째서…… 이런…… 컥…」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 학대당한 애완동물처럼 %조사처리(CALLNAME:MASTER,"를")% 올려다보고 있다…….
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
