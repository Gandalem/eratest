; Modular ERB: 個人口上/100 Rei'sen [レイセン]/レイセン/M_KOJO_K100_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K100
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF !FLAG:70 && !CFLAG:MASTER:イタズラ
	IF TFLAG:22 == 1
		PRINTFORML 「흐윽…… 으, 으응……읏」
		PRINTFORMDL 너무나도 큰 고통에 %조사처리(CALLNAME:TARGET,"는")% 벌벌 떨며 몸을 떨고 있다.
		PRINTFORMW 「아, 아파…… 아프다 아프다 아파……읏!」
	ELSEIF TFLAG:22 == 2
		PRINTFORML 「윽…… 아, 하……앗」
		PRINTFORMDL 몸이 갈기갈기 찢기는 듯한 격통에 %조사처리(CALLNAME:TARGET,"는")% 숨 쉬는 것조차 힘들어 하는 듯하다.
		PRINTFORMDW 잠시 상황을 지켜보았더니 그대로 실신해 버렸기에, %조사처리(CALLNAME:MASTER,"는")% 뺨을 때려 억지로 의식을 깨웠다.
	ELSEIF TFLAG:22 == 3
		PRINTFORML 「나…… 죽을……?」
		PRINTFORML 「크윽, 죽이지 말아주세요…… 뭐든지 할게요…… 아, 할 테니까, 죽이지 말아주세요...!」
		PRINTFORMDL 허용 범위를 넘어선 고통에 %조사처리(CALLNAME:TARGET,"는")% 그저 자비를 구하기만 한다
		PRINTFORMDW 그런 애처로운 모습이 다시 %조사처리(CALLNAME:MASTER,"의")% 흥분을 부추겼다
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORML 멈춰진 시간 속에서 괴롭힘당하던 %조사처리(CALLNAME:TARGET,"의")% 육체가 마침내 절정에 도달한다.
	PRINTFORML 일정한 간격으로 수축하는 밀봉구에서 스며 나오는 애액이 걸쭉하게 실타래를 만들며 발밑에 송골송골 떨어져 나간다.
	PRINTFORMW 그 물방울을 손가락으로 떠서 음핵에 문질러 주자, 시간을 멈췄던 그녀의 치밀막은 두 번째 절정에 도달했다.
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORML 한바탕 %조사처리(CALLNAME:TARGET,"를")% 능욕한 %조사처리(CALLNAME:MASTER,"는")% 그녀에게서 떨어져 그 몸을 찬찬히 시시간한다.
	PRINTFORML 단단하게 솟은 유두, 발기한 음핵, 질척질척 많은 애액을 흘리는 밀봉, 움찔움찔 떨리는 항문
	PRINTFORMW 그 모든 것이 순조롭게 개발이 진행되고 있음을 보여주고 있었다
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORML 쾌락을 주입당해 완전히 복종한 %조사처리(CALLNAME:TARGET,"의")% 육체는 연약하게 애액을 흘리며 더욱 심한 모욕을 기대하고 있다.
	PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 질 안에 얕게 손가락을 삽입하자, 시간이 멈춘 본인의 의지를 대변하듯 촉촉한 점막이 '츄츳' 하고 달라붙어 왔다.
	PRINTFORMW 완전히 순종하게 된 보상으로 그녀를 절정에 이르게 해 주자, 개발된 밀봉구는 눈 깜짝할 새에 도달하여 많은 물을 분출했다.
ENDIF
;快楽刻印
IF !CFLAG:MASTER:イタズラ
	IF TFLAG:23 == 1
		CALL HPH_PRINT,@"「히얏! 흐으윽, 아...흐읍...흐읍」","L"
		PRINTFORMDL 스스로를 위로하는 것만으로는 절대 얻을 수 없는 너무나 강렬한 쾌락.
		PRINTFORMDW 그것을 선사해 주는 %CALLNAME:MASTER%라는 존재가, %조사처리(CALLNAME:TARGET,"의")% 마음에 새겨져 갔다……
	ELSEIF TFLAG:23 == 2
		CALL HPH_PRINT,@"「하아…… 하아……읏 흐응, 기분 좋아……흐응」","L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 녹아내린 표정을 숨기려 하지도 않고 더 큰 쾌락을 찾아 %조사처리(CALLNAME:MASTER,"에게")% 매달린다.
		PRINTFORMDW 한 번 알게 된 이상, 이제 돌아갈 수는 없을 것이다.
	ELSEIF TFLAG:23 == 3
		CALL HPH_PRINT,@"「더, 만져줘……읏 HPH 더럽혀 줘……\@ TALENT:恋慕 ? 부탁해 # 해 주세요 \@……읏 HPH」","L"
		PRINTFORMDL 너무 강한 쾌락은 소심한 소녀를 암컷으로 만들어 버린다.
		PRINTFORMDW 마음으로도, 몸으로도 %조사처리(CALLNAME:MASTER,"에게")% 완전히 의존하는 %조사처리(CALLNAME:TARGET,"는")% 흡사 중독 환자 같다.
	ENDIF
ENDIF
;不埒刻印
;快楽による刻印 ＆ 屈服、恭順による刻印
;LV1
IF TFLAG:24 == 11 || TFLAG:24 == 31
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「힉읏 HPH 아앗…… 으윽…… 힉HPH」","L"
		PRINTFORMDL 너무 부끄러운 나머지 %조사처리(CALLNAME:TARGET,"는")% 시선을 돌린 채 이쪽을 보려 하지 않는다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 말을 이어갈 수 있는지 묻자, 그녀는 잠시 망설이다가 고개를 끄덕였다.
	ELSE
		PRINTFORML (이건 뭘까, 이 기분…… 가슴이 두근거려서……)
		PRINTFORML 「……에헤헤♪」
		PRINTFORMDW 애교 부리듯 다가오는 %CALLNAME:TARGET%씨. 그녀 안에서 무언가가 변한 모양이다
	ENDIF
	;LV2
ELSEIF TFLAG:24 == 12 || TFLAG:24 == 32
	IF CFLAG:うふふ
		PRINTFORML 「もっと……触って\@ TALENT:恋慕 ? いいんだよ……？ # 欲しい……です \@」
		PRINTFORMDL 수치심보다 쾌락이 이긴 것인지, %조사처리(CALLNAME:TARGET,"는")% 갈라지는 듯한 작은 목소리로 애원해 왔다.
		PRINTFORMDW 그 변화에 %조사처리(CALLNAME:MASTER,"는")% 확실한 감촉을 느끼고, 더욱더 애무하는 손길을 강하게 가져갔다……
	ELSE
		PRINTFORML 「\@ TALENT:恋慕 ? 하고 싶은 것이 있다면, 무엇이든 말해줘 # 나에게 할 수 있는 일이 있다면, 무엇이든 말해달라 \@」
		PRINTFORMDL %CALLNAME:TARGET%속에서, %CALLNAME:MASTER%라는 존재가 날마다 커져간다……
		PRINTFORMW 「%MASTERNAME:100%를 위해서라면, 나……」
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 13 || TFLAG:24 == 33
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「내 몸, 이 정도로는……읏 HPH 아아……. 이것으론 부족해욧……HPH」","L"
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 주어지는 쾌락에 완전히 중독되어 버렸어…….
		CALL HPH_PRINT,@"「뭐든지…… 뭐든지 할 테니까……읏후훗 부탁……부탁해요……읏후훗」","L"
		PRINTFORMDL 이 몸의 저림을 진정시킬 수 있는 것은 %CALLNAME:MASTER%밖에 없다.
		PRINTFORMDW 그것을 이해하고 있던 %조사처리(CALLNAME:TARGET,"는")%, %조사처리(CALLNAME:MASTER,"가")% 멈출 때까지 그저 애완동물처럼 비굴하게 구는 것이었다.
		CALL COLORMESSAGE(@"%조사처리(CALLNAME:TARGET,"가")% 쾌감에 솔직해졌다",C_YELLOW,1,2)
		TALENT:100:快感応答 = 1
	ELSE
		CALL HPH_PRINT,@"「………HPH」","L"
		PRINTFORMDL 넋을 잃고 %조사처리(CALLNAME:MASTER,"를")% 바라보는 %조사처리(CALLNAME:TARGET,"의")% 시선에서는 억누를 수 없는 호의를 느꼈다.
		PRINTFORMDW 그것이 애완동물이 주인에게 아첨할 때 보내는 것인지, 아니면 사랑에 빠진 소녀가 연인에게 보내는 것인지, %조사처리(CALLNAME:MASTER,"는")% 알 수 없었다.
	ENDIF
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORML 「왜…… 이런 걸……」
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 뺨을 한 줄기 눈물이 흘러내린다.
	PRINTFORMDW ……조금 너무 들떠버린 것 같다…….
ELSEIF TFLAG:21 == 2
	PRINTFORML 「너무해…… 흐윽……읏」
	PRINTFORMDL 잠에서 막 깨 울고 있는 %조사처리(CALLNAME:TARGET,"에게")% 손을 뻗으려던 손이 뿌리쳐진다.
	PRINTFORMDW 두 사람 사이에 어색한 공기가 감돌았다.
ELSEIF TFLAG:21 == 3
	PRINTFORML 「싫다고……으윽, 갔는데…… 몇 번이나, 몇 번이나 갔는데……!」
	PRINTFORMDL 얼굴을 구겨서 우는 %조사처리(CALLNAME:TARGET,"에게")% %조사처리(CALLNAME:MASTER,"는")% 건넬 말이 없었다.
	PRINTFORMW 「싫어…… 이제 싫단 말이야……!」
ENDIF
