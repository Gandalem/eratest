@M_KOJO_MESSAGE_COM_K100_1
CALL M_KOJO_MESSAGE_COM_K100_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응앗! 흐으윽! 이거, 안 돼읏」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 젖은 은밀한 곳에서 흘러넘치는 애액을 혀로 핥아 올린다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 혀놀림에 %조사처리(CALLNAME:TARGET,"의")% 질은 파르르 떨고 있다.
				CALL HPH_PRINT,@"「으응! 흐읍... 기분 좋아용... 큭흐윽」","W"
			CASE 1
				CALL HPH_PRINT,@"「흐으…… 아아아……큭 흐읍 후우…… 하아……큭 흐읍」","L"
				PRINTFORMDL 질구 입구를 혀끝으로 파헤치면서 허벅지를 쓰다듬자, %조사처리(CALLNAME:TARGET,"가")% 녹아내릴 듯한 교성(嬌聲)을 내뱉었다.
				CALL HPH_PRINT,@"「지금의…… 굉장해, 느껴버렸어\@ TALENT:恋慕 ? 앗 # 있었어 \@……HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「부탁이야……\@ TALENT:恋慕 ? 빨리 # 할게 \@……HPH」","L"
				PRINTFORMDL 스스로 음순을 벌리고, 정욕적인 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보는 %CALLNAME:TARGET%
				PRINTFORMDW 분홍색 점막은 이미 축축하게 젖어 있으며, 농밀한 암컷의 향기를 풍기고 있다……
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「거기…… 안 돼……읏 후우……앗」","L"
				PRINTFORMDL 움찔거리며 떨고 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 단단히 붙잡고 소녀의 달콤한 맛을 만끽한다.
				CALL HPH_PRINT,@"「더러워, \@ TALENT:恋慕 ? 에서 # 이래요 \@……읏 HPH 아, 히얏! HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「응…… 하아……윽 HPH 후우…… 음음……윽 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 무의식적으로 은밀한 곳을 밀어붙여 주어지는 쾌락을 즐기려 하고 있다.
				PRINTFORMDW 그것을 지적하자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 손으로 은밀한 곳을 가리려고 했다.
			CASE 2
				CALL HPH_PRINT,@"「혀가 오싹해서…… 아우윽 HPH 이상한 느낌이야 \@ !TALENT:恋慕 ? 그렇다 #  \@……읏 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 다리 사이에 얼굴을 묻고 있는 %CALLNAME:MASTER%에게서 눈을 떼지 못하는 듯하다.
				CALL HPH_PRINT,@"「얏HPH 맛있다니…… 그럴 리가, 응으읏HPH」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
