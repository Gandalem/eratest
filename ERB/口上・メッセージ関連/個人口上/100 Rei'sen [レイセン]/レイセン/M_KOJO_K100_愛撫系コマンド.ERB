	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응, 하으윽! 후우, 으응읏!」","L"
				PRINTFORMDL 클리토리스 주변을 애태우듯 쓰다듬으며, 쾌락에 신음하는 소녀의 반응을 즐긴다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 무의식적으로 허리를 비틀며, %조사처리(CALLNAME:MASTER,"의")% 손가락에 클리를 문지르려 하고 있다……
			CASE 1
				CALL HPH_PRINT,@"「히아, 아앗 HPH 으윽 HPH 크, 응읏 HPH」","L"
				PRINTFORMDL 팽팽하게 자기 주장을 하는 클리토리스를 손가락으로 꽉 집고, 문지르며, 주무른다.
				PRINTFORMDW 밀려오는 쾌감의 물결에 %조사처리(CALLNAME:TARGET,"는")% 움찔거리며 허리를 흔들고, 녹아내린 표정을 짓고 있다……
			CASE 2
				CALL HPH_PRINT,@"「히으읏! 하햣하햣하햣, 허리... 떠버릴 것 같아앗」","L"
				PRINTFORMDL 넘쳐흐르는 애액을 손가락으로 떠서 음핵에 발라댄다. 그 동작을 반복한다.
				PRINTFORMDW 그럼에도 쾌락을 주기에는 충분했고, 정신 차려보니 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳은 흘러넘치는 애액으로 흥건하게 녹아내리고 있었다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「히얏! 흐으윽, 후우욱」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 살며 음핵에 닿자, %조사처리(CALLNAME:TARGET,"의")% 몸이 움찔 떨었다.
				CALL HPH_PRINT,@"「거기……민감해\@ TALENT:恋慕 ? 그러니까 # 이래서 \@……상냥하게, 응읏 HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「하, 으윽 흐응…… 하아……읏흐음」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 반응을 살피며 %조사처리(CALLNAME:MASTER,"는")% 그녀의 음핵을 부드럽게 주무른다.
				PRINTFORMDW 사소한 자극에도 민감하게 반응하며 움찔거리며 치솟는 허리가 무척 관능적이다……
			CASE 2
				CALL HPH_PRINT,@"「흐, 윽…… 아아, 으읍… 큭」","L"
				PRINTFORMDL 여자의 약점을 집요하게 자극당하고, %조사처리(CALLNAME:TARGET,"는")% 괴로울 듯 허리를 비틀고 있다……
				CALL HPH_PRINT,@"「그렇게 만지면…… 응, 음음…… 큭흐윽」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
