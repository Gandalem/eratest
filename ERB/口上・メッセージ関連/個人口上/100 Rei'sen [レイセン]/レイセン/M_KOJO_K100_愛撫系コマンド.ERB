;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;キス系関数
;共通化することで作業量を減らす作戦
;==================================================

@REISEN_KISS
;恋慕
IF TALENT:恋慕
	;挿入中分岐
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「더…… 응! 후루룩 HPH 큭! 후얏 HPH」","L"
				PRINTFORMDL 진한 키스에 %조사처리(CALLNAME:TARGET,"는")% 스스로 허리를 흔들며 %조사처리(CALLNAME:MASTER,"의")% 입술을 갈구해 온다.
				CALL HPH_PRINT,@"「거기…… 점점 커지고 있어…… 후우 파아앗 후우」","W"
			CASE 1
				CALL HPH_PRINT,@"「쪽! 후읍! 응, 후우읏!」","L"
				PRINTFORMDL 깊숙이 연결된 채 이어지는 입맞춤에서 %조사처리(CALLNAME:TARGET,"는")% 쾌락을 느끼고 있는 듯하다.
				PRINTFORMDL 완전히 녹아내린 그 표정은 %조사처리(CALLNAME:MASTER,"의")% 흥분을 더욱 부추긴다.
				CALL HPH_PRINT,@"「움직여도 돼…… HPH 응아앗 HPH 아앗 HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「흐으, 아아……후푸 주루……르로……읏 후푸」","L"
				PRINTFORMDL 혀를 빨아 올리며 허리를 흔들자 %조사처리(CALLNAME:TARGET,"의")% 안쪽이 꽉 조여온다.
				PRINTFORMDW 정액을 갈망하는 듯한 그 점막의 움직임에, %조사처리(CALLNAME:MASTER,"의")% 성기는 파르르 떨렸다……
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응읏흐읍 츄릅……들려……읏흐읍 응아……흐읍」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 혀를 넣자 %CALLNAME:TARGET%도 기쁜 듯 자신의 것을 얽어왔다.
				CALL HPH_PRINT,@"「츄릅 HPH 푸하앗 HPH %MASTERNAME:100%…… 정말 좋아해…… HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「파아…… 쪽……읏 HPH 음크…… 쪽……읏 HPH」","L"
				PRINTFORMDL 애교 부리듯 매달려 오는 %조사처리(CALLNAME:TARGET,"를")% 단단히 끌어안고 입술을 포개다.
				PRINTFORMDW 혀를 얽으며 침을 흘려 넣자, 조용한 공간에 꿀꺽 삼키는 소리가 울렸다.
			CASE 2
				CALL HPH_PRINT,@"「더, 키스……HPH 츄……응, 츄풉……읏 HPH」","L"
				PRINTFORMDL 적극적으로 키스를 청해오는 %조사처리(CALLNAME:TARGET,"를")% %조사처리(CALLNAME:MASTER,"는")% 단단히 끌어안았다.
				PRINTFORMDW 서로 녹아드는 듯한 감각을 느끼며, 둘은 키스에 몰두하고 있었다.
		ENDSELECT
	ENDIF
	;それ以外
ELSE
	;挿入中分岐
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「아…… 쪽……읏 HPH 음…… 후우…… 읏 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 연결된 채 입술을 탐하자, 그녀도 적극적으로 자신의 것을 맞대 왔다.
				CALL HPH_PRINT,@"「왠지 나…… 이상한 기분이야…… 후으윽」","W"
			CASE 1
				CALL HPH_PRINT,@"「흐으……응……읏 HPH 츄……응……읏 HPH」","L"
				PRINTFORMDL 서로 사랑하는 연인처럼 입술을 포개자 %조사처리(CALLNAME:TARGET,"의")% 어깨에서 힘이 서서히 풀려간다.
				PRINTFORMDW 그와 동시에 속은 더욱 강하게 조여오며 강렬한 쾌락을 %조사처리(CALLNAME:MASTER,"에게")% 선사했다.
			CASE 2
				CALL HPH_PRINT,@"「흐으윽... 후읍, 축, 흐읍... 하아앗!」","L"
				PRINTFORMDL 근본까지 남근을 삽입하며 신음하는 %조사처리(CALLNAME:TARGET,"의")% 입술을 빼앗는다.
				PRINTFORMDW 질척하게 혀를 얽자 육구멍이 단단히 조여와, %조사처리(CALLNAME:MASTER,"는")% 나도 모르게 신음을 터뜨렸다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「츄……응, 러……후, 음……응응……읏」
				PRINTFORMDL 혀를 얽히게 하는 정열적인 키스에 %조사처리(CALLNAME:TARGET,"는")% 괴로울 듯 어깨를 두드려온다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그것을 신경 쓰지 않고, 오히려 더욱 격렬하게 구강 내를 탐했다.
			CASE 1
				PRINTFORML 「츄릅…… 파아…… 응, 쭈르륵……읏」
				PRINTFORMDL 입가에서 침이 새는 것도 아랑곳하지 않고, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 입술을 찾아 나선다.
				PRINTFORMDW 만족한 %조사처리(CALLNAME:MASTER,"가")% 입술을 떼자, %조사처리(CALLNAME:TARGET,"의")% 표정은 완전히 멍해져 있었다.
			CASE 2
				PRINTFORML 「햣……응……읏, 후우……츄……앗」
				PRINTFORMDL 입술에만 머무르지 않고 볼이나 코끝, 눈꺼풀에 이르기까지 %조사처리(CALLNAME:TARGET,"의")% 얼굴 전체에 키스의 비를 내린다.
				PRINTFORMW 「이거…… 엄청 부끄러워요……」
		ENDSELECT
	ENDIF
ENDIF
