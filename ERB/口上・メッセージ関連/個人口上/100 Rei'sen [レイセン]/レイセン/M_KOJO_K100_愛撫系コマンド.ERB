@M_KOJO_MESSAGE_COM_K100_0
CALL M_KOJO_MESSAGE_COM_K100_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｃ＆Ｂ感覚が一定以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚５以上
		IF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 5))
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「앙! 후우욱... 응응! %MASTERNAME:100%의 손, 다정해서 좋아\@ !TALENT:恋慕 ? 이에요 #  \@……후우욱」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 하나가 되면서 그녀의 전신을 세심하게 애무한다.
					PRINTFORMDW 수축하는 점막은 사랑스럽게 성기를 조여오며, 육체의 쾌락을 호소해 온다……
				CASE 1
					CALL HPH_PRINT,@"「아, 흐윽! 하으윽! 안쪽을... 해주고 있어욧!」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 깊은 곳까지 육봉을 삽입한 후, 허리를 갈아 정복하듯 질내를 휘저었다.
					PRINTFORMDL 넘쳐흐르는 꿀로 진흙탕이 된 육구는 탐욕스럽게 자루에 달라붙어 사랑하는 %조사처리(CALLNAME:MASTER,"에게")% 씨앗을 내려달라고 꿈틀거린다.
					PRINTFORMDL 그렇게 애써 민감해진 몸을 부드럽게 애무당하자, %조사처리(CALLNAME:TARGET,"는")% 미친 듯이 몸부림칠 수밖에 없었다.
					CALL HPH_PRINT,@"「좋아읏! 기분 좋아읏! 응아앗!」","W"
				CASE 2
					CALL HPH_PRINT,@"「\@ TALENT:恋慕 ? 햐앙! 큭, 으응! 가슴도 만져주세요 # 부탁드려요……여기 좀, 만져주세요 \@……큭」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 원해져, %조사처리(CALLNAME:MASTER,"는")% 그녀의 민감한 부위를 집중적으로 애무해주었다.
					PRINTFORMDW 연결된 채로 이어지는 애무에 %조사처리(CALLNAME:TARGET,"는")% 황홀한 신음소리를 내며 쾌락을 탐하고 있다……
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「야, 아앗 HPH 같이 하는 건, 안 돼……읏 HPH」","L"
					PRINTFORMDL 안과 바깥을 동시에 몰아붙여져, %조사처리(CALLNAME:TARGET,"는")% 쾌락에서 벗어나려 몸부림치고 있다.
					CALL HPH_PRINT,@"「아으윽 후우읍 후우읍 ~후우읍」","W"
				CASE 1
					CALL HPH_PRINT,@"「응읏흐으윽 하프하프 후우……응……읏하프」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 허리 움직임을 멈추고 전신에 대한 애무를 시작했다.
					PRINTFORMDW 만질 때마다 큥큥하고 육구가 수축하며, %조사처리(CALLNAME:TARGET,"가")% 쾌감을 느끼고 있는 것이 손에 잡힐 듯 느껴진다…….
				CASE 2
					CALL HPH_PRINT,@"「흐읍, 박으면서읏! 가슴이, 앗, 아아앗! 흐읍」","L"
					PRINTFORMDL 허리를 밀어 넣을 때마다 출렁이는 가슴에 %조사처리(CALLNAME:MASTER,"는")% 손을 뻗는다.
					PRINTFORMDW 꽉 움켜쥐며 피스톤하면, %조사처리(CALLNAME:TARGET,"의")% 조임이 좋아진 기분이 들었다.
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚・Ｂ感覚が５以上
	ELSEIF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아…… 앙…… 큭! 거기로… 더…… 큭!」","L"
				PRINTFORMDL 완전히 발달된 %조사처리(CALLNAME:TARGET,"의")% 육체는 만지기만 해도 민감하게 반응을 되돌려준다.
				CALL HPH_PRINT,@"「하후읏 HPH %MASTERNAME:100%에게 만져보면…… 간질간질해서, 기분 좋은 \@ TALENT:恋慕 ? 게 # 이예요 \@……HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「음무…… 후우…… 큭, 츄…… 주루…… 큭」","L"
				PRINTFORMDL 단단하게 솟아오른 유두를 손가락으로 주무르면서, 남은 손으로 부드럽게 쓰다듬듯이 은밀한 곳을 애무한다.
				PRINTFORMDW 그대로 농밀한 키스를 나누고 작은 혀를 빨아주자, %조사처리(CALLNAME:TARGET,"의")% 목구멍 깊은 곳에서 참을 수 없는 여자의 신음이 새어 나왔다.
			CASE 2
				PRINTFORMDL 축축하게 땀에 젖은 목덜미에 키스하며 %조사처리(CALLNAME:TARGET,"의")% 음탕한 모습을 귓가에 속삭인다.
				CALL HPH_PRINT,@"「아, 아앗 HPH 하지 말라고 \@ !TALENT:恋慕 ? 주세요 #  \@……HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 얼굴을 새빨갛게 물들이며 부정의 말을 내뱉는다.
				PRINTFORMDW 하지만 흥분한 것은 명백했으며, 은밀한 곳에 시선을 두자 흘러나온 애액으로 축축하게 젖어 있었다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%TEXTR("ひゃんっ……ぁっ……んん/ふぁ……ん、ぅ/っふ、ぅ……ん……はぁ/")%……っ♪」
				PRINTFORMDL 천천히 어루만지듯 %조사처리(CALLNAME:TARGET,"의")% 민감한 부위를 애무한다.
				PRINTFORMDW 쾌감보다 긴장감이 더 강한 것인지, 그 몸은 경직되어 있다.
			CASE 1
				PRINTFORML 「거기……앗……\@ TALENT:恋慕 ? 기분, 좋을지도 몰라 # 안돼요 \@……읏♪」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 정성스러운 애무에 %조사처리(CALLNAME:TARGET,"의")% 숨결이 점차 뜨거워져 간다……
				PRINTFORMW 「히아……응ぅ……읏♪ 하, 아아……읏♪」
			CASE 2
				PRINTFORML 「\@ TALENT:恋慕 ? 손을 잡아줘...? # 이렇게 하고 있으면, 조금 안심한다... \@」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 잠시 애무하는 손을 멈추고, %조사처리(CALLNAME:TARGET,"와")% 연인처럼 손을 맞잡은 채 가만히 서로를 바라본다.
				PRINTFORMW 「――쪽... 에헤헤...」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
