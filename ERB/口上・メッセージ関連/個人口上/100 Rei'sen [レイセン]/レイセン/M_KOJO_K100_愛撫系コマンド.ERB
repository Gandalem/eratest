@M_KOJO_MESSAGE_COM_K100_2
CALL M_KOJO_MESSAGE_COM_K100_2_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K100_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「거기, 더럽잖아…… 아앗 HPH」","L"
		PRINTFORMDL 평소에는 가죽을 뒤집어쓰고 있을 터인 %조사처리(CALLNAME:TARGET,"의")% 페니스 끝은 풋풋한 분홍색을 하고 있어 보기만 해도 자극에 약해 보인다.
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 부드럽게 미소를 지으며, %조사처리(CALLNAME:TARGET,"에게")% 눈을 떼지 않도록 명령한 뒤 천천히 그 것을 입속에 넣기 시작했다.
		CALL HPH_PRINT,@"(아아아…… 내 거... %MASTERNAME:100%에게 먹히고 있어…… 큭흐흑)","W"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		;レイセンが射精した
		IF NOWEX:100:射精
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%MASTERNAME:100%……나, 이제 곧……읏흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 페니스를 빨면서, 위를 올려다보며 그녀를 본다.
					CALL HPH_PRINT,@"「응…… 이해하고 있어 \@ TALENT:恋慕 ? 하고 있어 # 할게 \@……흐읍」","L"
					CALL HPH_PRINT,@"「이대로 입속에…… \@ TALENT:恋慕 ? 다 # 입니다 \@겠지 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「도, 괜찮은 거지……읏 HPH」","L"
					CALL HPH_PRINT,@"「이대로…… 아아아아앗 후으으으읍 후으으으읍 후으으으읍」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이기도 전에, 목구멍 깊숙한 곳에 농후한 %조사처리(CALLNAME:TARGET,"의")% 씨앗이 박혔다…
				CASE 2
					CALL HPH_PRINT,@"「응응! 하아... 갈 것 같아... 으윽!」","L"
					PRINTFORMDL 오르가즘에 도달하고 사정의 순간까지 마약 같은 쾌락.
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 맥없이 볼을 느슨하게 풀고, 거기에 완전히 빠져버린 것 같다……
					CALL HPH_PRINT,@"「아, 나와버릴 것 같아! 아기 엄마에게, 나올 것 같아! 후후 후후 후후」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%MASTERNAME:100%의 혀가, 짜릿해읏 흐읍! 아흐으윽!」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 자반 전체를 닦아주듯이, 정성스럽게 혀를 움직인다……
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 기분이 너무 좋아서 견딜 수가 없는지, 아까부터 계속 신음을 흘리고 있다.
					CALL HPH_PRINT,@"「더, 그쪽이! 히아우읏 HPH 아, 크으윽 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「흐읍! 큭, 거긴……읏!」","L"
					PRINTFORMDL 아무래도 %조사처리(CALLNAME:TARGET,"는")% 등줄기를 핥아지는 걸 좋아하는 것 같아.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 성기를 손으로 지탱하고, 민감한 그곳을 아래에서 위로 질척하게 핥아 올렸다……
					CALL HPH_PRINT,@"「아, 아아아아앗! 후우큭! 하으앗! 후우큭」","L"
				CASE 2
					CALL HPH_PRINT,@"「응, 크윽! 끝부분을 만지작거려줘읏! 아우윽!」","L"
					PRINTFORMDL 아무래도 %조사처리(CALLNAME:TARGET,"는")% 구멍을 뚫리는 걸 정말 좋아하는 것 같아.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 집중적으로 몰아붙여 주자, %조사처리(CALLNAME:TARGET,"는")% 부르르 떨며 허리를 흔들고 쾌락에 머리털을 휘날렸어……
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;レイセンが射精した
		IF NOWEX:100:射精
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「힉! 하아... 이, 이거... 할 것 같아읏」","L"
					PRINTFORMDL 사정 직전의 성기는 %조사처리(CALLNAME:MASTER,"의")% 입 안에서 한계까지 부풀어 오르며 불수의적으로 경련하고 있다.
					PRINTFORMDL 생각할 여유도 없어진 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 머리를 무의식적으로 잡더니, 본능대로 사정했다.
					CALL HPH_PRINT,@"「아…… 하아아…… 큭, 기분… 좋았어…… 큭」","W"
				CASE 1
					CALL HPH_PRINT,@"「%MASTERNAME:100%읏…… 이대로 가면…… 큭흐윽」","L"
