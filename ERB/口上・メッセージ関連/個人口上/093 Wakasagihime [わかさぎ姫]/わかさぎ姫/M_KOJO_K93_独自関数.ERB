@WAKASAGIHIME_CHAYEZHISHI
CFLAG:93:1018 += 1
IF CFLAG:93:1018 == 1
	SELECTCASE RESULT
		CASE 0
			PRINTL 녹차
		CASE 1
			PRINTL 홍차
		CASE 2
			PRINTL 우롱차
		CASE 3
			PRINTL 백차
		CASE 4
			PRINTL 황차
		CASE 5
			PRINTL 꽃차
		CASE 6
			PRINTL 과차
		CASE 7
			PRINTL 철관음
		CASE 8
			PRINTL 녹차
		CASE 9
			PRINTL 푸얼
	ENDSELECT
ENDIF
