@M_KOJO_SUCCESS_COM_K93_416
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K93_416
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K93_416_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K93_416_1
CALLFORM M_KOJO_COLOR_K93
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:1:現在位置 == CFLAG:93:現在位置
		LOCAL:2 = RAND:20
		SELECTCASE LOCAL:2
			CASE 0
				PRINTFORML 있잖아, 왜 울고 있는 거야?
				PRINTFORMW '왜 우는지 말이야?'
				PRINTFORML 뭐가 슬퍼서 울고 있는 거야?
				PRINTFORMW '어떤 슬픔 때문에 울고 있는 걸까?'
				PRINTFORML 거짓말을 듣고, 상처를 받아서.
				PRINTFORMW '타인의 거짓말로 상처를 받아'
				PRINTFORML 흐느끼면서 울고 있는 거야?
				PRINTFORMW '그래서 이렇게 목 놓아 우는 거니?'
				PRINTFORMW 	【거짓말의 권유】
			CASE 1
				PRINTFORML 저기, 나에게도 어쩔 도리가 없었어.
				PRINTFORMW '아니, 사실 나는 나도 어쩔 수 없었다'
				PRINTFORML 울고 싶을 때도 있었으니까.
				PRINTFORMW '울어버리고 싶었던 순간들 말이야'
				PRINTFORML 하지만 나는 스스로 결정해서,
				PRINTFORMW '하지만 나는 스스로에게 다짐했어'
				PRINTFORML 「눈물 많은 아이」는 그만뒀어.
				PRINTFORMW ''울보'' 같은 건 안 되도록 말이야'
				PRINTFORML 분명 나도, 그리고 너도.
				PRINTFORMW '분명 괜찮아, 우리 둘 다'
				PRINTFORML 셀 수 없이 많은 거짓말 중 하나에 걸렸을 뿐이야.
				PRINTFORMW '셀 수 없는 거짓말들을 하나씩 지나왔을 뿐이야'
				PRINTFORMW 【거짓말의 권유】
			CASE 2
				PRINTFORML 저기, 거짓말은 나쁜 게 아니야.
				PRINTFORMW '거짓말이라도 사실은 나쁘지 않은 거야'
				PRINTFORML 자신을 지키기 위한 수단이니까.
				PRINTFORMW '그저 자신을 보호하기 위해 취하는 방법일 뿐이야'
				PRINTFORML 사람들을 행복하게 만들 수도 있으니까.
				PRINTFORMW '만약 다른 사람을 행복하게 해줄 수 있다면'
				PRINTFORML 설령 거짓말이라도, 웃어줘.
				PRINTFORMW '거짓말일지라도 미소 지으며 맞서 봐'
				PRINTFORML 자신을 위해, 거짓말을 하면서,
				PRINTFORMW '나 자신을 위해서 살아갈 수 있다면'
				PRINTFORML 살아가자?
				PRINTFORMW '이번 한 번만 거짓말해 보자?'
				PRINTFORMW 【거짓의 권유】
			CASE 3
				PRINTFORML 자신에게 소중한 무언가를, 상처받으며 살아가는 것보다
				PRINTFORMW ‘차라리 살기 위해 스스로 소중하게 여기는 것을 계속해서 해를 입히는 것’
				PRINTFORML 그 몸의 한계까지, 힘의 한계까지, 최선을 다해 저항하려고,
				PRINTFORMW ‘몸과 힘의 전부를 걸고, 노력하며 맞서려고’
				PRINTFORML 거짓을 만들어내고, 속이는 것. (사실을 내맡기고, 속였다고 해도)
				PRINTFORMW ‘거짓된 것을 만들고, 그것이 곧 기만이다 (사실을 왜곡하고, 기만하는 것)’
				PRINTFORML 그것을 누가, 어째서, 폄하할 수 있을까.
				PRINTFORMW ‘누구든, 무엇 때문에라도 불명예스럽다고 여길 것이다’
				PRINTFORML 그러니,
				PRINTFORMW ‘그러니까’
				PRINTFORML 아무 말도 하지 마. 슬픈 눈을 떨구고.
				PRINTFORMW ‘아무것도 말하지 말고, 눈 속의 슬픔을 지워줘’
				PRINTFORML 울지 마, 응.
				PRINTFORMW ‘제발 더 울지 마, 알겠어’
				PRINTFORML 내일을 향해, 다시 걸어가기 위해
				PRINTFORMW ‘내일을 향해 계속 나아가기 위해서’
				PRINTFORML 응, 웃어줘.
				PRINTFORMW ‘응, 한번 웃어줄래’
				PRINTFORMW 【거짓의 권유】
			CASE 4
				PRINTFORML 있잖아, 거짓말은 나쁜 게 아니야
				PRINTFORMW '네, 거짓말은 사실 좋지 않은 것이 아니에요'
				PRINTFORML 행복해지기 위한 수단이니까.
				PRINTFORMW '그저 행복을 얻기 위해 사용하는 수단일 뿐이에요'
				PRINTFORML 거짓말로 행복해질 수 있을 테니까.
				PRINTFORMW '거짓으로도 행복을 찾을 수 있다면'
				PRINTFORML 설령 거짓이라 해도, 웃어줘.
				PRINTFORMW '비록 거짓이라 할지라도, 미소 지으며 맞서 줘'
				PRINTFORMW 【거짓의 추천】
			CASE 5
				PRINTFORML 내일을 위해, 거짓말을 하고,
				PRINTFORMW '내일로 나아가기 위해서'
				PRINTFORML 있잖아, 웃어줘.
				PRINTFORMW '자, 한번 웃어줄래?'
				PRINTFORML 있잖아, 거짓말은, 나쁜 일이 아니야.
				PRINTFORMW '거짓말도 사실 좋지 않은 건 아니니까'
				PRINTFORML 행복해지기 위한 수단이니까.
				PRINTFORMW '그냥 행복을 얻기 위해 사용하는 수단일 뿐이야'
				PRINTFORML 거짓말로 행복해질 수 있으니까.
				PRINTFORMW '거짓말에 의지해서 행복을 얻을 수 있다면'
				PRINTFORML 비록 거짓말이라도, 웃어줘.
				PRINTFORMW '설령 거짓일지라도, 미소 지으며 마주하자'
				PRINTFORMW 【거짓말의 권유】
			CASE 6
				PRINTFORML 내일을 위해, 거짓말을 하고,
				PRINTFORMW '내일을 향해 나아가기 위해서'
				PRINTFORML 나아가 보자?
				PRINTFORMW '이번 한 번만 거짓말하자?'
				PRINTFORML —나는 그저 맡은 바 임무를 다했을 뿐인데.
				PRINTFORMW '—나는 분명 그저 내 의무를 다했을 뿐이야'
				PRINTFORML 좋은 일을 했을 텐데.
				PRINTFORMW '분명 선한 일을 하려고 했는데'
				PRINTFORML —어째서.
				PRINTFORMW '—도대체 왜'
				PRINTFORML 저 사람들의 시선은, 나를, 두려워하고 있었다.
				PRINTFORMW '그들의 시선은, 나를 경계하며 바라보았다'
				PRINTFORML 저 사람들의 말은, 나를, 소외시키고 있었다.
				PRINTFORMW 그들의 말들은, 나를 멀리했다
				PRINTFORML 사람이 아닌 것을 보는 것처럼.
				PRINTFORMW 마치 나를 인간으로 보지 않는 것처럼.
				PRINTFORMW 【거짓말의 권유】
			CASE 7
				PRINTFORML 너도 하면 돼.
				PRINTFORMW '그럼 너도 그렇게 해 봐'
				PRINTFORML 마음껏 거짓말을 하면 돼.
				PRINTFORMW '거짓말하고 싶다면, 마음껏 말해 줘'
				PRINTFORML 그러니까 이제 울지 마, 울지 마...
				PRINTFORMW '그러니 부디 더 이상 울지 마, 울지 마...'
				PRINTFORML 아무 말도 하지 말고. 슬픈 눈을 감고 있어.
				PRINTFORMW '아무것도 말하지 말고, 다만 눈 속의 슬픔을 지워버려'
				PRINTFORML 울지 마, 응?
				PRINTFORMW '부디 더 이상 울지 말아 줘, 알겠어?'
				PRINTFORML 네가 울고 있으면 나도 울고 싶어지니까.
				PRINTFORMW '네가 계속 우면, 나조차 같이 울게 될 테니'
				PRINTFORML 있잖아, 웃어 줘.
				PRINTFORMW '그러니 한 번 웃어 주겠니?'
				PRINTFORMW 【거짓말의 권유】
			CASE 8
