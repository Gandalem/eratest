		IF FIRSTTIME("WaggyAfterglow", 0 , 93)
			CALL K93_E_FIRSTAFTERGLOW
			RETURN 1
		ENDIF
		PRINTFORML 「후우... 이번엔 좀 너무 심하게 갔던 것 같아...」
		PRINTFORMDL 눈에 띄게 지친 %K93NICK()%은(는) %HIS_HER(93, 0)% 몸을 당신 옆으로 부드럽게 기댄다.
		PRINTFORML 「%K93_HONORIFIC(MASTER)%, 무리한 부탁이라면 죄송하지만, 조금 더 있어 줄 수 있겠어요?」
		PRINTFORMW 「그냥... 지금은 그저 당신의 동행이 필요할 뿐이에요, 다른 건 아무것도 없어요.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;Slip out
		;満足して解放
		IF FIRSTTIME("WaggyAfterglow", 0 , 93)
			CALL K93_E_FIRSTAFTERGLOW
			CALL K93_SEXVALRESET
			RETURN 1
		ENDIF
		PRINTFORML 「후와아... 고맙습니다, %K93_HONORIFIC(MASTER)%... 정말 필요했어요.」
		IF TCVAR:93:K93EN_PLAYERCAME
			PRINTFORMDL %K93NICK()%이/가 당신 곁에 앉는다. 만족스러운 미소가 %HIS_HER(93, 0)%의 입술 위에 걸려 있다.
			PRINTFORMW 「하지만 네가 그걸 얼마나 즐겼는지 생각하면, 나에게 고마움을 표현해 주는 것도 좋겠어～」
		ELSE
			PRINTFORMDL %K93NICK()%은(는) 걱정이 가득한 %HIS_HER(93, 0)% 눈으로 당신을 바라보며 앉는다.
			PRINTFORML 「하지만 말해봐, 만족했니...? 조금이라도?」
			PRINTFORMW 「우리의 작은 "만남"을 내가 즐겼던 만큼 네가 즐겼는지는 잘 모르겠어...」
		ENDIF
		CALL K93_SEXVALRESET
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;It's not over yet!
		;満足したところを押し倒された
		PRINTFORML 「오-오 마이! %K93_HONORIFIC(MASTER)%님, 정말 그게 부족했나요?」
		IF TCVAR:93:K93EN_PLAYERCAME >= 8
			PRINTFORML 「당신을 만족시켜 주는 게 싫은 건 아니지만, 쉬어야 하지 않을까요?」
			PRINTFORMW 「이미 너무 많이 절정에 달했잖아요...」
		ELSE
			PRINTFORMW 「그럼, 내가 최선을 다해 당신을 만족시켜야겠지...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;More please
		;壊れるまでしてあげる
		PRINTFORML 「%K93_HONORIFIC(MASTER)%님, 제가 계속 가길 바라신다는 건가요... 저에게 멈추라고 말씀하시더라도?」
		IF IN_HEAT(93)
			CALL HPH_PRINT,@"「후후후후... 그 결정에 후회하지 않기를 바란다, %K93_HONORIFIC(MASTER)%(이름)...」","W"
		ELSE
			PRINTFORMW 「음, 그것이 당신이 바라는 것이라면, 내가 정확히 그것을 주겠소...」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
