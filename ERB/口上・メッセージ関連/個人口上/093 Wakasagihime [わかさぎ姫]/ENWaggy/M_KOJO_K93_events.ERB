;==================================================
;Confessing on the way home from a date
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EN_SPEVENT_MESSAGECHECK_K93_2
RETURN 0

@M_KOJO_EN_SPEVENT_K93_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;Confession
	;After this dialogue is displayed, the player will have a choice to become the character's lover or turn them down.
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF FIRSTTIME("WaggyDateConfession", 0, 93)
			PRINTFORMW 「%K93_HONORIFIC(MASTER)%, before you go... there is something... I need to tell you.」
			PRINTFORMDW Whatever that is, it seems pretty serious. You stop in your tracks, turning to face %HIM_HER(93, 0)%.
			PRINTFORML 「I had so much fun today... But to put it shortly... none of it would have been the same without you.」
			PRINTFORMDW %K93NICK()%'s eyes dart around as %K93NICK()% is almost unable to put %HIS_HER(93, 0)% feelings into words.
			IF !FIRSTTIME("WaggyFauxConfession", 1, 93)
				PRINTFORMW 「And I know we already went through this once, but... I don't feel satisfied.」
				PRINTFORMW 「I have hope that things might have changed, that there is space for me in your heart...」
			ELSE
				PRINTFORMW 「Truth is... I love you... and I want to be something more to you.」
			ENDIF
			PRINTFORMDL %HE_SHE(93, 1)% clasps %HIS_HER(93, 0)% hands together, looking up at you.
			IF K93_ROMANTIC() ;FINALLY a use for these functions
				PRINTFORMW 「Every ounce of affection you have given me... I want more of it.」
			ELSEIF K93_EROTIC()
				PRINTFORMW 「Even if our relationship... our love... is as obscene as it is.」
			ENDIF
			PRINTFORMW 「I want to... be your %PRINT_MALE("man", 93)%, %K93_HONORIFIC(MASTER)%.」
			IF CFLAG:93:K93EN_SEEWORLD >= 9
				PRINTFORMW 「I want to see... to share even more of this world with you.」
				PRINTFORMW 「This world is only made better by your presence, by having you by my side...」
			ELSE
				PRINTFORML 「I want to be with you, no matter where or even when...」
				PRINTFORMW 「For the world around me isn't that scary when you're by my side.」
			ENDIF
			PRINTFORMDL Tears start to drip down %HIS_HER(93, 0)% cheeks as %HIS_HER(93, 0)% voice begins to waver.
			SIF K93_UNREQUITED()
				PRINTFORMW 「And it's okay if you have someone else... as long as you also love me, I won't care!」
			SIF MARK:93:反発取得履歴 ;old hate marks
				PRINTFORMW 「Even if you have hurt me before, that is in the past.」
			PRINTFORMW 「And even though there are so many other better choices than me, a mermaid...」
			PRINTFORMW 「I don't care for any of that, all that I want is to be yours!」
			PRINTFORMDL %K93NICK()% looks down, sighing deeply.
			PRINTFORMW 「Fwuuuh... I just want to be your %K93NICK()%, now and forever.」
			PRINTFORMW 「So I ask of you, let my feelings reach you, and may you accept them.」
		ELSE
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, I've been thinking about us, and our love...」
			PRINTFORMDW %K93NICK()% locks %HIS_HER(93, 0)% eyes with yours.
			PRINTFORMW 「Has anything... changed between us? Am I... still not good enough for you?」
			PRINTFORMW 「I'm afraid I already know the answer, but I want to try, I truly do.」
			PRINTFORMDW %HE_SHE(93, 1)% straightens %HIS_HER(93, 0)% back, trying %HIS_HER(93, 0)% best to maintain composure.
			PRINTFORMW 「Have my feelings reached you, and have you accepted them yet?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Confession accepted (player and character become lovers)
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL %K93NICK()% completely freezes over your response.
		PRINTFORMDW You wave at %K93NICK()%, trying to bring %HIM_HER(93, 0)% back to the world of the living.
		PRINTFORML 「Oh! Uhmm... I... I don't really know what I'm supposed to do next...」
		PRINTFORMDW %HE_SHE(93, 1)% slowly begins to smile as %HIS_HER(93, 0)% evolve into a full fledged torrent.
		PRINTFORMW 「%K93_HONORIFIC(MASTER)%, I'm just so happy... I don't know what to do!」
		PRINTFORMW 「I have anticipated this moment for so long, and hearing your words, it doesn't even feel real!」
		PRINTFORMDW Words not being necessary any longer, you pull %K93NICK()%'s trembling body closer for a loving embrace.
		PRINTFORMDL %K93NICK()% tightly wraps %HIS_HER(93, 0)% arms around your torso, deeply burying %HIS_HER(93, 0)% face in your chest.
		PRINTFORMDW And as if that was not enough, you also gently being to play with %HIS_HER(93, 0)% silky, deep blue colored hair.
		PRINTFORMDW You remain glued to %HIM_HER(93, 0)% for a good while, basking in each other's love.
		CALL K93_TIMEPASSDOTS(5, "w")
		PRINTFORML 「I dedicate all of this... all of myself to you, %K93_HONORIFIC(MASTER)%.」
		PRINTFORMW 「Your %K93NICK()%, your %PRINT_MALE("man", 93)%, your %PRINT_MALE("prince:princess", 93)% wakasagi...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Confession rejected
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF FIRSTTIME("WaggyDateConfessionRejection")
			PRINTFORMDW You solemnly reject %K93NICK()%'s confession.
			PRINTFORML 「No? Is that what you just said, is that...!」
			PRINTFORMDL You have never seen %HIM_HER(93, 0)% this dejected, with a frown this heavy.
			PRINTFORML 「A-am I not good enough... good enough for you?」
			PRINTFORML 「I understand, I really do... and I can't really fault you for that...」
			PRINTFORMDL %HE_SHE(93, 1)% suddenly throws %HIM_HER(93, 0)%self at your arms and buries %HIS_HER(93, 0)% face into your chest.
			PRINTFORMW 「But as long as you... keep coming to see me... you keep giving me your affection... I will be just fine.」
			PRINTFORML 「So thank you for... everything you have given me, %K93_HONORIFIC(MASTER)%.」
			PRINTFORMW 「And sorry... for bothering you with all of this...」
			CALL K93_TIMEPASSDOTS(5, "w")
			PRINTFORMDL %K93NICK()% takes a long, deep breath and lets go of you after a few minutes of silence.
			PRINTFORMDW A warm smile colors %HIS_HER(93, 0)% face, a dried up river of tears on %HIS_HER(93, 0)% cheeks.
			PRINTFORML 「I've been meaning to tell you that for a... long, long time now.」
			PRINTFORMW 「It's such a huge load off my chest, to at least be able to tell you about my love for you.」
			PRINTFORMDL %HE_SHE(93, 1)% looks away from you, sighing once more.
			PRINTFORMW 「Fwuuuh... We can go now, I feel much better already!」
		ELSE
			PRINTFORMDW You reject %HIS_HER(93, 0)% attempt at a confession, again.
			PRINTFORMW 「Fwuuuh... It's okay, I don't have any tears to shed. Not anymore, not for this.」
			PRINTFORMDL %K93NICK()% strain %HIS_HER(93, 0)% lips, attempting to maintain a smile.
			PRINTFORMW 「And besides, you will keep coming to see me, won't you? So I'm... satisfied.」
		ENDIF
		RETURN 1
	ENDIF

ENDIF
RETURN 1

