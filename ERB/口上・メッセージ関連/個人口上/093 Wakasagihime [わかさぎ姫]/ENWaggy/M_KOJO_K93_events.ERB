;オナバレックス判定用関数
;RETURN -1で強制失敗、RETURN 1で強制成功

@M_KOJO_EN_EVENT_K93_26_1(ARGS)
#DIM 補正値
IF ARGS == "どうぞそのまま"
	SIF K93_LOVE_LUST_LOVER()
		RETURN 1 ;always succeed
	RETURN 0 ;leave it to the game otherwise
