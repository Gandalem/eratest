@M_KOJO_EN_EVENT_K93_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点		  The gift's score (1-999).
;GIFT_NAME   The name of the gift.
;SENSE       The attributes of the gift. STRCOUNT(DISH_TASTE, "foobar/") can be used to determine them.
;GIFT_ID     The ID of the gift. You can pass this to GET_GIFTDATA() to get info about the gift.
;　GET_GIFTDATA(GIFT_ID, "回数")    The number of times the player gave the gift to the character.
;　GET_GIFTDATA(GIFT_ID, "得点")    The gift's score (1-999).
;　GET_GIFTDATA(GIFT_ID, "日付")    The date that the player gave the gift to the character (1-9999).
;　GET_GIFTDATA(GIFT_ID, "場所")    The location that the gift was bought at.
;　GET_GIFTDATA(GIFT_ID, "形容詞")  The associated adjectives (see 贈り物_形容詞.erb)
;　GET_GIFTDATA(GIFT_ID, "本体")    The price of the gift (see 贈り物_本体.erb)
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;Dialogue for giving the player a gift on the way home from a date. This can happen at Intimacy 5 or higher, regardless of date score or any other factor.
;The gift will be something that the character would score from 701-999 if the player gave it to them.
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	IF K93_LOVE_LUST_LOVER()
		IF !RAND:4 && !FIRSTTIME("WaggyFirstKiss", 1, 93)
			PRINTFORMW 「아, 깜빡할 뻔했네... %K93_HONORIFIC(MASTER)%, 이쪽 좀 봐!」
			PRINTFORMDW 당신이 %K93NICK()%를 바라보면, 살짝 입술을 오므리고 있는 %HIM_HER(93, 0)%가 보인다.
			PRINTFORMW 「너에게 줄 작은 게 하나 있는데, 그런데 궁금해서 말이야...」
			PRINTFORML 「그게 뭔지 맞춰볼래～?」
			PRINTL
			CALL ASK_YN(@"이건 명백한 키스니까, 다가가서 %HIM_HER(93, 0)%에게 입맞춤한다.", "그것은 선물이다, 물리적인 물건이다.")
			IF !RESULT
				PRINTFORMDL 당신은 고개를 끄덕이며 몸을 숙이고, 가볍게 입술을 %HIS_HERS(93, 0)%에 대면서 %K93NICK()%을 깜짝 놀라게 한다.
				CALL MUTUAL_KISS(93)
				PRINTFORMDW %HE_SHE(93, 1)%은 뒤로 기대며 짧았던 키스를 소리 내어 끊는다.
				PRINTFORMW 「후후후... 좋은 추측이었지만, 내가 생각했던 건 전혀 그게 아니야～」
				PRINTFORML 「아니, 내가 생각했던 건 이 작은 선물을 산 거야...」
			ELSE
				PRINTFORMDW 당신은 고개를 끄덕이며 %K93NICK()%에게 %HIM_HER(93, 0)%로부터 선물을 기대한다고 말한다.
				PRINTFORMDW %HE_SHE(93, 1)%는 잠시 멈추었다가 미소를 지으며 당신의 대답에 고개를 끄덕인다.
				PRINTFORMW 「맞아, 돈을 모아서 너에게 줄 선물을 샀어.」
				PRINTFORML 「자, 이걸 즐겼으면 좋겠어...」
			ENDIF
			PRINTFORMDW %HE_SHE(93, 1)%이 화려해 보이는 파란 리본으로 포장된 상자를 너에게 건넨다.
			PRINTFORMDW 너는 상자를 풀고 열어 그 안에 들어있는 %GIFT_NAME%를 발견한다.
			PRINTFORML 「그래서, 어떻게 생각해? 마음에 들어?」
			IF CFLAG:93:貰った贈り物 ;has a favorite gift
				CALL GIFTNAME(CFLAG:93:貰った贈り物, 93)
				PRINTFORMW 「%RESULTS%」가 나에게 준 선물만큼 내가 좋아하는 것처럼 당신도 그렇게 해주길 바랄게!
			ELSEIF CFLAG:93:贈り物ストック ;has gift
				PRINTFORMW 「네가 그렇게 해주길 바래, 네가 나에게 준 모든 멋진 선물들을 고려하면!」
			ENDIF
		ELSE
			PRINTFORML 「오, %K93_HONORIFIC(MASTER)%님! 잊기 전에, 오늘 당신을 위해 선물을 준비했어요!」
			PRINTFORMDW %K93NICK()%은/는 화색하며, %HE_SHE(93, 0)%이 고급스러운 파란 리본으로 포장된 상자를 당신에게 건넨다.
			PRINTFORML 「자, 지금 바로 열어봐도 돼요...」
			PRINTFORMDW %HE_SHE(93, 1)%은/는 걱정스러운 듯 당신을 바라보며 말한다.
			PRINTFORMDW 당신은 상자를 풀고 열었지만, 안에는 %GIFT_NAME%이 들어있었다.
			PRINTFORMW 「고르기가 좀 힘들었는데, 제가 고른 게 마음에 드시나요?」
			PRINTFORMDW 당신은 %HIS_HER(93, 0)%의 질문에 고개를 끄덕이며, %HIS_HER(93, 0)%의 선물에 만족한다.
			PRINTFORML 「다행이에요! 당신이 싫어하게 될 만한 것을 그냥 주는 건 정말 싫으니까.」
			IF CFLAG:93:貰った贈り物 && !K93_COHABITATION() && RAND:2
				CALL GIFTNAME(CFLAG:93:貰った贈り物, 93)
				PRINTFORMW 「사실, 내가 이 %RESULTS%가 준 것을 좋아하듯이 당신도 이것을 좋아해 주었으면 좋겠어!」
				PRINTFORMW 「후후후... 내 돌 모으기 중에 아직 가지고 있거든~?」
			ELSE
				PRINTFORMW 「결국 내 사랑스러운 %K93_HONORIFIC(MASTER)%는 최고만을 받아야 해~!」
			ENDIF
		ENDIF
	ELSEIF K93_YEARNING_SEXFRIEND()
		PRINTFORMDW 갑자기 소매에 가벼운 당김을 느낀다.
		PRINTFORMDL 시선을 %K93NICK()%에게 돌리자, %HE_SHE(93, 0)%이 %HIS_HER(93, 0)%의 손에 무언가를 들고 있는 것이 보인다.
		PRINTFORMW 「음... 너에게 주고 싶은 게 있어.」
		PRINTFORMDL %HE_SHE(93, 1)%는 %HE_SHE(93, 0)%가 파란 리본으로 깔끔하게 포장된 %GIFT_NAME%를 건네자 시선을 돌린다.
		PRINTFORMW 「돈이 조금 있어서 이걸 사 왔어... 물론 %K93_HONORIFIC(73)%의 도움을 받아서 말이야.」
		IF CFLAG:93:貰った贈り物 ;has a favorite gift
			CALL GIFTNAME(CFLAG:93:貰った贈り物, 93)
			PRINTFORMW 「아 물론, 당신이 나에게 선물해 준 %RESULTS%에 대한 보답으로 무언가를 주지 않는 건 공평하지 않으니까!」
		ELSEIF CFLAG:93:贈り物ストック ;has gift
			PRINTFORMW 「그리고 물론, 당신이 내게 준 모든 선물에 보답하지 않는 것은 공평하지 않을 테니까.」
		ELSE
			PRINTFORMW 「그리고 나를 이렇게 멋진 데 데이트에 데려다줬으니, 그에 대한 보답으로 무언가를 주는 게 공평하다고 생각해.」
		ENDIF
		PRINTFORMDW %HE_SHE(93, 1)%은 잠시 멈추고 수줍게 미소 지으며 다시 당신을 바라본다.
		PRINTFORMW 「어느 쪽이든, 이 선물을 좋아해 주었으면 좋겠어요, %K93_HONORIFIC(MASTER)%씨.」
	ELSE
		PRINTFORML 「오, %K93_HONORIFIC(MASTER)%님! 이거 드리는 것 깜빡할 뻔했어요...」
		PRINTFORMDW %K93NICK()%은(는) 수수한 파란 리본으로 포장된 %GIFT_NAME%을 당신에게 건넨다.
		PRINTFORMW 「조금 돈을 아껴서, 선물을 드리기로 했어요.」
		PRINTFORMW 「별거 아니지만 마음에 들었으면 좋겠어요!」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;End of day event: the character cherishes the gift they received from the player (occurs if the gift had a score of 700 or more)
	;一日の終わりに今日貰った贈り物を大事にする（700点以上）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	IF K93_LOVE_LUST_LOVER()
		PRINTFORML 「%K93_HONORIFIC(MASTER)%께서는 제가 무엇을 가장 좋아하시는지 항상 아시죠, 그렇죠 %HE_SHE(MASTER, 0)%?」
		PRINTFORMW 「후후후... 아마 %HIM_HER(MASTER, 0)%에게 뭔가 좋은 것을 되돌려 드려야 할지도 모르겠네...」
	ELSEIF K93_YEARNING_SEXFRIEND(1)
		PRINTFORMW 「%K93_HONORIFIC(MASTER)%이 나에게 이렇게 좋은 것을 선물해 주다니...」
		PRINTFORMW 「나는 %HE_SHE(MASTER, 0)%가 내가 %HIM_HER(MASTER, 0)%를 좋아하는 만큼 나를 좋아할지 궁금하다?」
		PRINTFORMDL %K93NICK()%은/는 그 생각을 떨쳐내려고 재빨리 %HIS_HER(93, 0)%을 흔든다.
		PRINTFORMW 「아니야, 이건 그냥... 친구 사이의 좋은 선물일 뿐이야, 다른 건 없어.」
	ELSE
		PRINTFORML 「후훗~! 정말 멋진 작은 선물이 되었네~!」
		PRINTFORMW 「%K93_HONORIFIC(MASTER)%께 나중에 감사 인사를 해야겠어.」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;End of day event: the gift the character received from the player becomes their favorite (displayed after the "cherish" lines,
	; occurs if the gift had a score of 700 or more and it has the highest score of any gift the character has received)
	;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	IF STRCOUNT(SENSE, "身につける/") ;wearable
		PRINTFORML 「흠... 하지만 어떻게 착용해야 할지 모르겠네?」
		IF IS_FALLEN(93)
			PRINTFORMW 「이걸 항상 차고 싶었는데... 후후후!」
		ELSE
			PRINTFORMW 「아마 아주 특별한 날을 위한 무언가일지도...」
		ENDIF
	ELSE
		PRINTFORML 「하지만 이제 나는 어디에 이걸 진열해야 할지 궁금해.」
		IF IS_FALLEN(93)
			PRINTFORMW 「아름다운 돌들 컬렉션 바로 옆에 있는 것이 이렇게 소중한 것에 딱 어울리는군...」
		ELSE
			PRINTFORMW 「내 돌 컬렉션 바로 옆이 어떤 곳만큼 좋은 장소인 것 같군...」
		ENDIF
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;End of day event: the character keeps the gift they received from the player (occurs if the gift had a score of 400-699)
	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	PRINTFORMW 「오, 이건 오늘 일찍 나에게 주신 선물이에요.%K93_HONORIFIC(MASTER)%께서 준 걸요.」
	IF CFLAG:93:貰った贈り物 ;has favorite gift
		CALL GIFTNAME(CFLAG:93:貰った贈り物, 93)
		PRINTFORMW 「그것은 %RESULTS%이 나에게 주었던 그것과는 거리가 멀다...」
		PRINTFORML 「하지만 나쁘지는 않으니, 이걸로 뭘 해야 할지 모르겠네?」
	ELSE
		PRINTFORML 「음... 이걸로 뭘 해야 할지 모르겠군?」
	ENDIF
	PRINTFORMDW %K93NICK()%은(는) 결론을 내리기 전에 %HIS_HER(93, 0)%의 턱을 두드렸다.
	PRINTFORMW 「내 서랍에 넣어도 괜찮을 것 같아요!」
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;End of day event: the character quietly pawns the gift they received from the player (occurs if the gift had a score less than 400)
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	PRINTFORML 「이게 %K93_HONORIFIC(MASTER)%이 준 건 정말 별로구나...」
	PRINTFORMDW %K93NICK()%는 자신의 선물을 어떻게 할지 고민하며, 죄책감이 %HIS_HER(93, 0)%의 마음에 무겁게 자리한다.
	PRINTFORML 「그냥... %K93_HONORIFIC(73)%에게 주어서 %HE_SHE(73, 0)%가 팔 수 있게 해야겠어.」
	PRINTFORMW 「나는 돈을 가지고 %HIM_HER(MASTER, 0)%에게 좋은 걸 사기만 하면 괜찮을 거야!」
	RETURN 1
ENDIF
RETURN 1
;==================================================
;Egg gift, added
;Called when an egg-laying character gives unfertilized egg(s) as a gift after a date.
;==================================================

@M_KOJO_EN_EVENT_K93_EGG_GIFT(ARGS,ARG,ARG:1)
;ARG:1 is the number of eggs being given.
;--------------------------------------------------
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;The character has Love
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「여기, %K93_HONORIFIC(MASTER)%. 당신이... 이것들을 즐기기를 바라요.」
		PRINTFORML 「후후후... 좀 민망하지만, 이 걸 당신에게 준 것을 후회하지 않아요, 조금도요.」
		PRINTFORMDW %K93NICK()%가 %HIS_HER(93, 0)%의 입을 가리며 %HE_SHE(93, 0)%는 부끄럽게 웃는다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character has Lust
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「여기 드려요, %K93_HONORIFIC(MASTER)%님. 이건 당신을 위해 정성을 다해 만든 거예요.」
		PRINTFORML 「어차피 먹어도 상관없어요... 전에 당신 입이 제 "아래쪽"에 있었으니까~!」
		PRINTFORMDW %K93NICK()%은 장난스럽게 웃었고, %HIS_HER(93, 0)%의 뺨은 새빨갛게 달아올랐다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character has neither Love nor Lust
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「이-여기 있습니다, %K93_HONORIFIC(MASTER)%, 이것들이 상당히 가치가 높다고 들었습니다.」
		PRINTFORMW 「저는 이걸 ... 안개 호수에서, 어떤 물고기에게서 얻었어요!」
		PRINTFORMDL %K93NICK()%은(는) 한숨을 쉬며 %HE_SHE(93, 0)%가 재빨리 다른 곳을 바라본다.
		PRINTFORMW 「후우... 이건 제가 당신에게 준 가장 사적인 것도 아니에요...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;Bug Battle
;Bug Battle dialogue is a bit special, and you shouldn't use PRINT statements.
;Only one line of dialogue is required in the RESULTS field.
;%MUSHI_NAME% will display the name of the bug the character is using.
;The longest bug names are 30 characters (Alexandra Trivanel Swallowtail and Orthetrum Albistylum Speciosum are tied).
;Make sure the text doesn't overflow!
;ARG lists either the number of bugs remaining or their rank, depending on the subsection.
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================

@M_KOJO_EN_MESSAGE_COM_K93_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;The battle begins
		;ARG is not accessible
		;No more than 50 characters per line
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「우리 둘 다 재미있었으면 좋겠어!」
				DATAFORM 「이 시합에서 행운을 빌게, %K93_HONORIFIC(MASTER)% 씨.」
				DATAFORM 「나는 이런 거 별로 잘 못하지만, 우리 즐겁기만 하면 괜찮아!」
				DATAFORM 「이건 일종의 장난치는 싸움 같은 거 맞지? 그럼, 나도 참가하고 싶어!」
			ENDDATA
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;Immediately after "CHARACTER sent out BUG!"
		;No more than 40 characters per line
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			IF MUSHI_NAME == "スカイフィッシュ" ;skyFISH (need to make sure she can even use this bug, can't really find the data for it)
				STRDATA RESULTS
					DATAFORM 「"%MUSHI_NAME_TR(MUSHI_NAME)%"… 너는 그렇게 생기지 않았는데도 여전히 귀엽구나!」
					DATAFORM 「"%MUSHI_NAME_TR(MUSHI_NAME)%"… 궁금하네, 왜 그런 이름이 붙은 걸까?」
					DATAFORM 「정말로 여기에 있는 건가? 거의 보이지 않는데…」
				ENDDATA
			ELSE
				STRDATA RESULTS
					DATAFORM 「이 버그를 며칠 전에 발견했지. 꽤 귀여운 작은 것이잖아?」
					DATAFORM 「이 벌레는 귀여워 보이니, 내보내는 게 당연하지!」
					DATAFORM 「최선을 다해라, %MUSHI_NAME_TR(MUSHI_NAME)%!(!)」
					DATAFORM 「나는 너를 믿는다, %MUSHI_NAME_TR(MUSHI_NAME)%!(!)」
					DATAFORM 「너는 할 수 있어, %MUSHI_NAME_TR(MUSHI_NAME)%!(!)」
				ENDDATA
			ENDIF
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;Immediately before "CHARACTER's BUG uses SKILL!"
		;No more than 40 characters per line
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			IF MUSHI_NAME == "スカイフィッシュ" ;skyfish
				STRDATA RESULTS
					DATAFORM 「%MUSHI_NAME_TR(MUSHI_NAME)%, 세상에 모습을 드러내라!」
					DATAFORM 「우리 모두에게 보여져라, %MUSHI_NAME_TR(MUSHI_NAME)%!」
					;jojo reference number 4!
					DATAFORM 「내가 너를 이겨줄 거야! 내 마음은 마치 그... 음... "일레븐" thing again, %K93_HONORIFIC(MASTER)%?」
				ENDDATA
			ELSE
				STRDATA RESULTS
					DATAFORM 「할 수 있어, %MUSHI_NAME_TR(MUSHI_NAME)%!」
					DATAFORM 「지금은 망설이지 마, %MUSHI_NAME_TR(MUSHI_NAME)%!」
					DATAFORM 「%MUSHI_NAME_TR(MUSHI_NAME)%, 네 목소리를 들려줘!」
				ENDDATA
			ENDIF
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;Immediately after "CHARACTER's BUG faints!!"
		;No more than 40 characters per line
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「잘 해줬어, %MUSHI_NAME_TR(MUSHI_NAME)%아.」
				DATAFORM 「너무 무리하게 밀어붙였다면 미안해...」
				DATAFORM 「최선을 다했어, %MUSHI_NAME_TR(MUSHI_NAME)%아. 그걸 알면 편히 쉬렴!」
			ENDDATA
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;Immediately after "CHARACTER is eliminated!!"
		;No more than 40 characters per line
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「오, 이게 정말 끝인가?」
				DATAFORM 「더 이상 버틸 수 없을 것 같다...」
				DATAFORM 「우리가 뭘 더 잘할 수 있었을지 궁금하다...」
			ENDDATA
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;One-on-one battle: the character came in first
		;No more than 20 characters per line
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「어떻게든 이겼나 보네! 모두 수고했어!」
				DATAFORM 「우리는 최선을 다했고, 그리고 이겼어!」
				DATAFORM 「%K93_HONORIFIC(MASTER)%님, 정말 재미있었어요! 다시 당신과 함께 놀 날을 손꼽아 기다릴게요.」
				DATAFORM 「나... 나 진짜 이긴 거야? 믿기지가 않아!」
			ENDDATA
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;One-on-one battle: the character came in second
		;No more than 20 characters per line
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「우리는 정말 최선을 다했어, 슬퍼할 이유 없어!」
				DATAFORM 「이건 즐거웠어, %K93_HONORIFIC(MASTER)%님, 비록 내가 이기진 못했지만...」
				DATAFORM 「승리하는 건 기분 좋지 않아?」
				DATAFORM 「후와아... 너무 강하시다!, 승리를 축하드립니다.」
			ENDDATA
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;Battle Royale: the character came in first
		;No more than 30 characters per line
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「이렇게 많은 이들을 상대로 승리하다니...! 정말 벌어지고 있는 일인가?」
				DATAFORM 「모두 정말 잘 싸웠다!」
				DATAFORM 「이게 재미있는 시합이었어, 모두!」
				DATAFORM 「후와아... 조금 부끄러운 기분이 드네...」
			ENDDATA
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;Battle Royale: the character came in 2nd, 3rd, or 4th
		;No more than 30 characters per line
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「너무 많은 사람들과 경쟁하면서... 내가 두드러질 방법은 없었다...」
				DATAFORM 「후후후... 괜찮을 거라고 확신해. 모두 즐거웠어.」
				DATAFORM 「내 수치심이 나를 이기게 만든 걸까?」
				DATAFORM 「이렇게 많은 사람들이 주변에 있어서... 재미있었어.」
			ENDDATA
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;Team battle: the character's partner was eliminated, but their team still came in first
		;No more than 32 characters per line
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「저것 보셨어요, %K93_HONORIFIC(MASTER)%? 제가 어떻게든 저희를 승리로 이끌었어요!」
				DATAFORM 「이 상황이 어떤 특정 인물을 떠올리게 하네요...」
				DATAFORM 「당신 없이는 해낼 수 없었다고 확신해요, 그러니 당신도 웃어야죠!」
				DATAFORM 「곁에서 싸우는 건 즐거웠어요. 다시... 함께 할 수 있기를 바라요.」
			ENDDATA
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;Team battle: the character's team came in second
		;No more than 32 characters per line
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			STRDATA RESULTS
				DATAFORM 「그게 다 내 잘못이었을까?」
				DATAFORM 「이렇게 모두에게 실망시킨 것에 대해... 미안해.」
				DATAFORM 「모두가 즐거웠으면 좋겠어...」
				DATAFORM 「후와아... 이기지 못했어도 괜찮아, 우리 모두가 즐거웠다면 모든 게 괜찮으니까!」
			ENDDATA
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1
;==================================================
;Gravity operation
;TCVAR: If you put a location ID in the gravitation point, the character will be pulled to that point
;Only works on the same base map as the location ID (the character won't go to the Hakurei Shrine Outskirts if they aren't at the Hakurei Shrine).
;Note that if you don't set any conditions, they will be pulled to the location permanently.
;CFLAG:今日の運勢 contains random numbers (0-999) for that day, so you use this instead of RAND, I think
;which i have tested, and there seems to be no problem with using RAND
;what did they mean by this?
;引力操作
;TCVAR:引力点に場所IDを入れるとその地点に引っ張られていきます
;場所IDと同じ拠点マップでしか効果はありません（博麗神社の境内なら拠点が博麗神社のときだけ）
;条件を付けないと永久に引っ張られ続けるので注意
;RANDは基本的に使えません。CFLAG:今日の運勢 にその日のランダム数値（0～999）が入っているのでこれを使うと良いです
;==================================================

@M_KOJO_EN_EVENT_K93_GRAVITY(ARG)
;this is also horrible but it just works (or does it? need to test it better)
IF !RAND:6 && K93_FRIENDSHIP() && INRANGE(TIME:2, 2, 4) && CFLAG:93:現在位置 == P348霧の湖・湖底 && CFLAG:MASTER:現在位置 == P347霧の湖 ;makes waggy more likely to surface if the player is around + the weather and time are favorable
	TCVAR:93:引力点 = P347霧の湖
ELSEIF GETBIT(FLAG:プール, 3) && GET_MAPID(CFLAG:93:初期位置) != 2 ;has mystery bubbles and not currently in the human village
	TCVAR:93:引力点 = 0 ;let the game handle it, pretty sure it's set to let her move around
ELSEIF !GROUPMATCH(CFLAG:93:現在位置, P347霧の湖, P348霧の湖・湖底, SUMIKOMI_ROOM, CFLAG:93:初期位置) && !CFLAG:93:同行 ;if not anywhere in the lake or not in her room and not accompanying
	IF K93_LIVINGINMISTYLAKE()
		TCVAR:93:引力点 = P347霧の湖 ;make her gravitate to the misty lake shore
	ELSE
		TCVAR:93:引力点 = CFLAG:93:初期位置 ;make her stay at home
	ENDIF
ELSE
	TCVAR:93:引力点 = 0 ;let the game do its thing
ENDIF
SIF GET_MAPID(TCVAR:93:引力点) != GET_MAPID(CFLAG:93:現在位置) ;failsafe, make sure the place we're gravitating her to is here at all, otherwise we get a crash
	TCVAR:93:引力点 = 0
;==================================================
;Watermelon Splitting
;Watermelon Splitting dialogue works like Bug Battle dialogue. Don't use PRINT statements, and only assign one line to the RESULTS field.
;Brackets are automatically added.
;Only "collision" and "result" are automatically colored.
;Lines can be no more than 26 characters except for "collision" and "result". Please be careful not to overflow!
;If you have several patterns, you can use %TEXTR( / )% to get more atmosphere.
;スイカ割り
;スイカ割りの口上はムシバトル同様、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;カギ括弧は自動で付きます
;"衝突","結果"のみ、口上色が自動で付きます
;"衝突","結果"以外は半角26文字（全角13文字）までの文字数制限があります。はみ出ないように気をつけてください
;数パターンあると雰囲気が出ます（%TEXTR( / )%を使うと良い）
;==================================================

@M_KOJO_EN_MESSAGE_COM_K93_SUIKA(ARGS, ARG)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1
	SELECTCASE ARGS
		CASE "衝突"
			;-------------------------------------------------
			;Lines for stumbling out of the field and bumping into a character
			;No character limit, and there's no generic dialogue for this.
			;場外に出てあなたがキャラと衝突した際の台詞
			;文字数制限はありません,汎用台詞もありません
			;-------------------------------------------------
			RESULTS = Fweeeh! Be more careful!
			;There!
		CASE "そこだ！"
			RESULTS = %TEXTR(@"거기다! 해라, %K93_HONORIFIC(MASTER)%!!")%
			;Near
		CASE "近い"
			RESULTS = %TEXTR(@"조금만 더!/거의 다 왔어!/정말 정말 가까이 왔어!")%
			;Far
		CASE "遠い"
			RESULTS = %TEXTR(@"아직 조금 멀었어! / 갈 길이 멀다구, %K93_HONORIFIC(MASTER)%이야!")%
			;Very far
		CASE "かなり遠い"
			RESULTS = %TEXTR(@"당신이 얼마나 멀리 있는지 전혀 모르는군.../%K93_HONORIFIC(MASTER)%! 너무 멀어서 겨우 보일 지경이야!")%
			;In front
		CASE "前"
			RESULTS = %TEXTR(@"조금만 더, %K93_HONORIFIC(MASTER)%! 바로 앞에 있어, 조금만 더...! / 그렇게 계속 해봐!")%
			;A little further ahead
		CASE "少し前"
			RESULTS = %TEXTR(@"딱 한 걸음만 더, 제발! / 바로 눈앞이야, 딱 한 걸음만 더! / 이제 거의 다 왔어...")%
			;Behind
		CASE "後ろ"
			RESULTS = %TEXTR(@"안 돼, 거기 아니야! 반대쪽이야! / 당신 뒤에 있어요, %K93_HONORIFIC(MASTER)%로! / 거기에 없어, 돌아봐!")%
			;A little further back
		CASE "少し後ろ"
			RESULTS = %TEXTR(@"바로 뒤에, %K93_HONORIFIC(MASTER)%이 있다! / 돌아보면 바로 거기에 있어! / 지금 한 걸음만 뒤로 물러나면 돼...")%
			;Right
		CASE "右"
			RESULTS = %TEXTR(@"당신의 오른쪽으로, %K93_HONORIFIC(MASTER)%! / 오른쪽으로, 오른쪽! / 더 오른쪽으로!")%
			;A little further right
		CASE "少し右"
			RESULTS = %TEXTR(@"바로 오른쪽으로 한 팔 길이예요! / 맞아요, 아주 가까워요!")%
			;Left
		CASE "左"
			RESULTS = %TEXTR(@"당신의 왼쪽으로, %K93_HONORIFIC(MASTER)%!(가라)! / 왼쪽에, 더 왼쪽으로! / 왼쪽으로, 더 왼쪽으로!")%
			;A little further left
		CASE "少し左"
			RESULTS = %TEXTR(@"당신의 왼쪽으로 팔 길이만큼…/왼쪽이야, 아주 가까워!")%
		CASE "結果"
			;-------------------------------------------------
			;After the game ends
			;You can only have one line per case, but they can be as long as you want(?)
			;TFLAG:193,
			;   -1=Failure
			;    0=Success
			;    1=Great Success
			;    2=Great Success with a wooden sword (bonus points)
			;ARG
			;    0=Honest person
			;    1=Liar
			;終了後の一言
			;文字数制限はありません,汎用台詞もありません
			;TFLAG:193,
			;   -1=失敗
			;    0=成功
			;    1=大成功
			;    2=木刀で大成功（ボーナス点）
			;ARG
			;    0=正直者
			;    1=ウソつき
			;-------------------------------------------------
			IF ARG == 1 ;liar
				SELECTCASE TFLAG:193
					CASE -1
						RESULTS = Fufufu... Sorry, I just had to do it～!
					CASE 0
						RESULTS = Lying a little is part of the game, isn't it?
					CASE 1
						RESULTS = Impressive, you did even though I was lying.
					CASE 2
						RESULTS = To do it with a wooden sword even while being fooled...
				ENDSELECT
			ELSE
				SELECTCASE TFLAG:193
					CASE -1
						RESULTS = It's okay, there is always next time.
					CASE 0
						RESULTS = Fwaaah! You did it!
					CASE 1
						RESULTS = Fwaaaah! Such a clean cut!
					CASE 2
						RESULTS = To do it with a wooden sword! You're amazing!
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
