;================================
;custom com
;y is the id of the button, range from 0 to 29
;カスタムコマンド、0~29まで設定可能
;使用する際はSKIPSTART~SKIPENDを外してください。
;================================

;コマンド名
@KOJO_EN_COM_NAME_K93_0
RESULTS = Change Carry

;judge
;judge the button can be shown, if return 1, it will show
;コマンド使用条件、通常のCOM_ABLE関数と同じくRETURN 1すれば実行可能としてコマンドが表示される
@KOJO_EN_COM_ABLE_K93_0
SIF FLAG:70
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF GLOBAL_COMABLE(351)
	RETURN RESULT
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
SIF IS_FALLEN(93)
	RETURN 1
SIF COM_351_CONDITION(TARGET) == 0
	RETURN 0
SIF LS_ACTIVE() == "Scarlet"
	RETURN 0
RETURN 1

;================================
;実行可能判定に係る部分、通常は書かなくてよい
@KOJO_EN_COM_K93_0
CALL K93_CarryWaggy()

