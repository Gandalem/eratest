@K93_ALT_MESSAGE_SCOM7
#DIM NAMED
VARSET NAMED
;CALL エロAA(1)
IF FLAG:70 == 1
	IF EXP:MASTER:時姦経験 >= EXP:TARGET:愛情経験 + 50
		;---------------------------------
		;時間停止・鬼畜
		;---------------------------------
		IF TALENT:体型 <= -1 ;if target is small
			;---------------------------------
			;小柄体型以下
			;---------------------------------
			IF EXP:TARGET:子宮口開発経験 >= 50
				PRINTFORMD %ONGOING_NAME(MASTER)% 
				;正常位
				IF TEQUIP:体位２ == 1
					IF TFLAG:193 ;not in a bedroom
						PRINTFORMDL %ONGOING_P(TARGET)%을 위아래로 움직이며, %HIS_HER(TARGET)%의 작은 몸을 오나홀로 사용하고 시간이 멈춘 동안 당신의 %TINKO(PLAYER)%를 %HIM_HER(TARGET)%에 격렬하게 박는다.
						PRINTFORMDL 너는 %HIS_HER(TARGET)%의 자궁경부를 지나 결국 %HIS_HER(TARGET)%의 자궁 뒤쪽까지 도달한다.
						PRINTFORMDL 당신이 %조사처리(CALLNAME:TARGET,"를")% 관통하자 %조사처리(CALLNAME:TARGET,"의")% 복부에 돌출부가 생긴다.
						PRINTDL 
						PRINTFORMDL 당신은 %HIS_HER(TARGET)%의 날렵한 몸을 따라 %TINKO(PLAYER)%를 밀어 넣었고, 자궁경부는 머리를 잡고 더 깊숙이 인도하는 듯했다.
						PRINTFORMDL 쾌락에 대한 눈먼 갈증 속에서, 당신은 %조사처리(CALLNAME:TARGET,"의")% 유치한 몸을 붙잡고 거칠게 몰아붙였다...
					ELSE
						PRINTFORMDL 침범하다 %ONGOING_P(TARGET)% 작은 몸을 밀어 넣으며 당신의 %TINKO(PLAYER)% 안으로 %HIS_HER(TARGET)% 시간이 멈춘 동안 전력을 다해 작은 구멍에 밀어 넣으며
						PRINTFORMDL 너는 %HIS_HER(TARGET)%의 자궁경부를 지나 결국 %HIS_HER(TARGET)%의 자궁 뒤쪽까지 도달한다.
						PRINTFORMDL 한 불룩함이 형성된다 %조사처리(CALLNAME:TARGET,"의")% 배에 구멍이 생기면서 %HIM_HER(TARGET)%...
						PRINTDL 
						PRINTFORMDL 당신은 %HIS_HER(TARGET)%의 자궁경부가 당신의 %TINKO(PLAYER)%를 붙잡고, 그 길이가 마사지되면서 머리를 자궁 안에 가두고 있음을 깨닫는다.
						PRINTFORMDL 쾌락에 대한 맹목적인 갈증 속에서, 당신은 %조사처리(CALLNAME:TARGET,"의")% 유치한 몸을 잡고 거칠게 몰아붙인다...
					ENDIF
					;後背位
				ELSEIF TEQUIP:体位２ == 2
					IF TFLAG:193 ;not in a bedroom
						PRINTFORMDL %HE_SHE(TARGET)%가 공중에서 여전히 얼어붙은 동안 %ONGOING_G(TARGET)% %HIP_TR(TARGET)%를 붙잡고 당신의 %TINKO(PLAYER)%을 기저부로 밀어 넣는다.
						PRINTFORMDL 당신은 %HIS_HER(TARGET)%의 자궁경부를 지나 그 몸 뒤쪽의 %HIS_HER(TARGET)%의 자궁에 도달한다...
						PRINTDL 
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 타이트하고 좁은 벽과 자궁이 당신의 %TINKO(PLAYER)%를 움켜쥔다, 당신이 골반을 밀어 넣으면서.
						PRINTFORMDL 당신은 만족할 때까지 %조사처리(CALLNAME:TARGET,"의")% 미숙한 자궁을 탐한다...
					ELSE
						PRINTFORMDL %ONGOING_G(TARGET)%의 꼬리를 잡고 %HE_SHE(TARGET)%가 배를 대고 누워 당신의 %TINKO(PLAYER)%을 기저부까지 밀어 넣는다.
						PRINTFORMDL 당신의 %TINKO(PLAYER)%이 %HIS_HER(TARGET)%의 자궁경부를 지나 %HIS_HER(TARGET)% 자궁 뒤쪽까지 도달한다...
						PRINTDL 
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 타이트하고 좁은 벽과 자궁이 당신의 %TINKO(PLAYER)%를 움켜쥔다, 당신이 골반을 밀어 넣으면서.
						PRINTFORMDL 당신은 만족할 때까지 %조사처리(CALLNAME:TARGET,"의")% 미숙한 자궁을 탐한다...
					ENDIF
					;騎乗位
				ELSEIF TEQUIP:体位２ == 3
