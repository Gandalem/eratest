;*********************************************************************************
;these are good for increasing the readability of variable, instead of using
;numbered CFLAGs. please be aware, do NOT override id numbers already used by
;the game or by your dialogue, remember to use these by using "CFLAG:" or "TCVAR:"
;*********************************************************************************
;[CFLAG名] (character variables)
;*********************************************************************************
;i finally fucking did it, i understand these
;this one stores the version number on every update, you don't touch this one here
#DIM CONST  K93EN_FLAG_VER                                          = 1090
;this one is the current version number, to be bumped manually here, cflag below checks against this one to see if there was an update
#DIM CONST  K93EN_VER                                               = 001
;but i don't think we use that update system anymore, so i guess it's kinda useless to know now

;used to check if you said that you don't want to change the waggie's saggies anymore
#DIM CONST K93EN_BREASTSIZE_UPD                                     = 1003

;used to check if you said that you don't want to change affinities again
#DIM CONST K93EN_AFFINITY_UPD                                       = 1012

;used to check if the bubble and harness refund options has been accepted or rejected this playthrough
#DIM SAVEDATA K93EN_BUBBLEREFUND                                    = 1004
#DIM SAVEDATA K93EN_HARNESSREFUND                                   = 1005

;count for wholesome/lewd tsp actions, might use it for something
#DIM SAVEDATA K93EN_WHOLESOMETSP                                    = 1006
#DIM SAVEDATA K93EN_RAPESOMETSP                                     = 1007

;for her personal event line, increases on every relevant event
#DIM SAVEDATA K93EN_SEEWORLD                                        = 1008
;it starts at 0 but should max out at 9
;0 to denote not started, 1 denotes start, 2 to 8 count locations, 8 to mark location completion and 9 to mark complete completion (seen outro)

#DIM SAVEDATA WaggySeenWorld, 7
;7 arrays, 7 locations
;玄武の沢 genbu ravine (0)
;地獄の深道 deep road to hell (1)
;三途の川 sanzu river (2)
;大蝦蟇の池 giant toad pond (3)
;山の湖 mountain lake (4)
;静かの海 sea of tranquility (5)
;九天の滝 waterfall of nine heavens (6)

;nickname stuff
#DIM SAVEDATA K93EN_NICKNAME                                        = 1016
#DIM CONST K93EN_NICKNAMEREJECT                                     = 1009

;total money you have given waggy in fishing bribes
#DIM SAVEDATA K93EN_WAGGYBRIBE                                      = 1010

;waggy carry choice
#DIM SAVEDATA K93EN_WAGGYCARRY                                      = 1011

;for tsp awareness
#DIM SAVEDATA K93EN_TSPSUSPICION                                    = 1013

;set at character introduction
#DIM SAVEDATA K93EN_PASTLOVER                                       = 1014
#DIM SAVEDATA K93EN_BORNTOFUTA                                      = 1015

;feet! or in this case fin
#DIM SAVEDATA K93EN_FINJOBEXP                                       = 1017

;desires pregnancy talent gets cleared when she gets pregnant while i want to carry it a bit further, to birth
#DIM SAVEDATA K93EN_DESIRESPREGGO                                   = 1018

;little thing for a child raising event, done on a whim
#DIM SAVEDATA K93EN_WAGGYHARDNAME                                   = 1019

;for tracking if the player is starting this dialogue from the beginning
#DIM SAVEDATA K93EN_WAGGYRESET                                      = 1020

