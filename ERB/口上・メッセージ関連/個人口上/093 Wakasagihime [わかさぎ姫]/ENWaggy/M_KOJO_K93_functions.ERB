@K93_CARRYEFFECTS(ARG, ARG:1) ;applies effects, arg and arg:1 are for use in game files
;there are LOCALs in use where this function is summoned and i have heard enough horror stories about LOCALs so i will use DIMs for once
;ARG is only ever to be filled if it's used in the game's files for distance processing, ARG:1 is for distance traveled
#DIM K93_RELATIONSHIP_GAIN
#DIM K93_STA_DECREASE
SIF !ARG:1 ;if there's no distance traveled, default to 1 for the sake of multiplications
	ARG:1 = 1
SELECTCASE K93_CARRYSTATUS()
CASE 0 ;CARRY
	IF SHIRAHU(93)
		K93_RELATIONSHIP_GAIN = MIN(5, CFLAG:93:好感度 / 200)
		CFLAG:93:好感度 += K93_RELATIONSHIP_GAIN * 5
		CFLAG:93:信頼度 += K93_RELATIONSHIP_GAIN
		PALAM:93:好意 += K93_RELATIONSHIP_GAIN * 10
	ENDIF

	SIF TALENT:MASTER:力持ち && ABL:MASTER:戦闘能力 <= 3 ;having [strong mooscles] but not high combat lets you skip a bit of effort
		GOTO MOOSCLES_STAMINA

	SELECTCASE ABL:MASTER:戦闘能力
	CASE IS <= 0
		K93_STA_DECREASE = 240
	CASE 1
		K93_STA_DECREASE = 130
	CASE 2
		K93_STA_DECREASE = 70
	CASE 3
		K93_STA_DECREASE = 50
	CASE 4
		$MOOSCLES_STAMINA
		K93_STA_DECREASE = 30
	CASE 5
		K93_STA_DECREASE = 20
	CASE IS >= 6
		K93_STA_DECREASE = 10
	ENDSELECT
	
	SIF TALENT:MASTER:力持ち && ABL:MASTER:戦闘能力 <= 3
		GOTO MOOSCLES_TIME
	
	IF ARG
		LOCAL:9 = MIN(K93_STA_DECREASE * ARG:1, 750) ;scales with steps walked, caps at 750 because i'm a good guy
		[IF_DEBUG]
			PRINTFORMDW CARRYING WAGGY, STAMINA DECREASING BY {LOCAL:9}
		[ENDIF]
		BASE:MASTER:体力 -= LOCAL:9
		SELECTCASE ABL:MASTER:戦闘能力
		CASE IS <= 1
			TIME += 3 * ARG:1
		CASE 2 TO 3
			TIME += 2 * ARG:1
		CASE IS >= 4
			$MOOSCLES_TIME
			;no time changes, full throttle despite the added 200lb of fish pussy and ass
		ENDSELECT
	ELSE
		CALL RECOVER(MASTER, -K93_STA_DECREASE,"体力", @"Carrying %CALLNAME:93%")
	ENDIF
CASE 1 ;CHAIR
		SIF ABL:MASTER:戦闘能力 <= 1 && !TALENT:PLAYER:力持ち && ARG ;would basing this on terrain roughness be too much?
			TIME += 2 * ARG:1
CASE 2 ;BUBBLE
	IF SHIRAHU(93)
		K93_RELATIONSHIP_GAIN = MIN(3, CFLAG:93:好感度 / 500)
		CFLAG:93:好感度 += K93_RELATIONSHIP_GAIN * 5
		CFLAG:93:信頼度 += K93_RELATIONSHIP_GAIN
		PALAM:93:好意 += K93_RELATIONSHIP_GAIN * 10
	ENDIF
ENDSELECT

