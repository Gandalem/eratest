@K93_DAYANDNIGHT(ARGS, ARG = 0) ;prints some stuff sensitive to daytime
#FUNCTIONS
ARGS = %TOLOWER(ARGS)%
SELECTCASE ARGS
CASE "today", "tonight"
	IF TIME:2 >= 5 ;evening, night, late night
		LOCALS = tonight
	ELSE
		LOCALS = today
	ENDIF
CASE "morning", "day", "evening", "night"
	SELECTCASE TIME:2
	CASE 1 TO 2 ;early morning and before noon
		LOCALS = morning
	CASE 3 ;noon and afternoon
		LOCALS = day
	CASE 4 ;evening
		LOCALS = evening
	CASEELSE
		LOCALS = night
	ENDSELECT
CASEELSE
	LOCALS = INVALID PLEASE REPORT
	RETURNF LOCALS
ENDSELECT
SIF ARG ;if arg, capitalize
	LOCALS '= @"%CAPITALIZE(LOCALS)%"
RETURNF LOCALS

