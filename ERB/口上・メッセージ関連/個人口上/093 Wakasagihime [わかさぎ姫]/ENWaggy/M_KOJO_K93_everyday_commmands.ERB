;615,お弁当を食べる
;Eat Lunchbox (in dates and stuff)
;実行可能場所　お地蔵通り,枝垂れ柳の下,霧の湖,玄武の沢,大蝦蟇の池,絶景の丘,山の湖,天界
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;ABL:料理技能(2未満=微妙な出来 4未満=そこそこ美味しい 4以上=絶品)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EN_MESSAGE_MESSAGECHECK_COM_K93_615
RETURN 0

@M_KOJO_EN_MESSAGE_COM_K93_615
CALL M_KOJO_EN_MESSAGE_COM_K93_615_1
RETURN RESULT

@M_KOJO_EN_MESSAGE_COM_K93_615_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K93_MAD()
		PRINTFORMDW %K93NICK()% sets a lunchbox in front of you with a blank expression.
		PRINTFORML 「I made this for us, %K93_HONORIFIC(MASTER)%.」
		PRINTFORMDL %HE_SHE(93, 1)% starts eating, but stops once %HE_SHE(93, 0)% sees you sitting still.
		PRINTFORMW 「Is something wrong? I promise I still put some care into it.」
		PRINTFORMW 「...I just hope that you're not thinking that I'm the kind of person that would ever poison you.」
		PRINTFORMDW You resign, and start eating from the lunchbox %HE_SHE(93, 0)% prepared.
		CALL K93_TIMEPASSDOTS(, "w")
		IF TFLAG:193 >= 0 ;success and great success
			PRINTFORMDL It tastes good, despite %K93NICK()%'s cold treatment!
			PRINTFORMDW And there is no poison to speak of, either.
		ELSE
			PRINTFORMDW It doesn't taste that good, but at least %HE_SHE(93, 0)% wasn't lying about the poison.
		ENDIF
		RETURN 1
	ENDIF
	PRINTFORMDL You set a picnic blanket down on a nice spot for both you and %K93NICK()%.
	PRINTFORMDW %HE_SHE(93, 1)% sits on it and sets down a lunchbox between you both.
	IF TALENT:93:恋人
		PRINTFORML 「To have such a nice picnic with the %PRINT_MALE("man", MASTER)% I have sworn my heart to...」
		PRINTFORMW 「It's so romantic, it almost sounds like something you would see in a fairy tale～!」
		PRINTFORMDL %HE_SHE(93, 1)% illuminates you with a bright grin as %HE_SHE(93, 0)% opens the lunchbox.
		PRINTFORMW 「Go ahead, %K93_HONORIFIC(MASTER)%. I have prepared this for you with all of my love.」
		PRINTFORMDW %HE_SHE(93, 1)% excitedly watches as you begin to eat the meal %HE_SHE(93, 0)% made for you.
	ELSEIF K93_LOVE_LUST_LOVER()
		PRINTFORMW 「Here, I have prepared this just for you.」
		PRINTFORMW 「It might not seem like much, but I can assure you it's was made with lots of love!」
		PRINTFORMDL %HE_SHE(93, 1)% watches closely as you start to eat from the lunchbox.
		PRINTFORMW 「Do tell me what you think of it, %K93_HONORIFIC(MASTER)%.」
	ELSEIF K93_YEARNING_SEXFRIEND(1)
		PRINTFORMW 「Uhmmm... I have made this just for you, %K93_HONORIFIC(MASTER)%.」
		PRINTFORMW 「I'm not really used to cooking for others, so I hope it turned out well...」
		PRINTFORMDL %HE_SHE(93, 1)% brings %HIS_HER(93, 0)% hands to %HIS_HER(93, 0)% chest, anxiously waiting for you to start eating.
		PRINTFORMW 「D-do tell me what you think... I can't wait to hear your opinions on it.」
	ELSE
		PRINTFORMW 「Here, %K93_HONORIFIC(MASTER)%. I made this in case we got hungry.」
		PRINTFORMW 「I don't cook that often, so it might not have turned out that well.」
		PRINTFORMDL %HE_SHE(93, 1)% smiles as you start eating from the lunchbox.
		PRINTFORMW 「Either way, do tell me what you think of it!」
	ENDIF
	CALL K93_TIMEPASSDOTS(, "w")
	SELECTCASE TFLAG:193
	CASE 1 ;great success
		PRINTFORMDW This is spectacularly, mouth-watering good!
		PRINTFORMDW You continue to eat, too busy to tell %K93NICK()% how much you like this.
		PRINTFORMW 「...Don't you think you should slow down a little?」
		IF ABL:93:料理技能 >= 3 ;cooking ability
			PRINTFORMW 「I know I've been getting better and better at cooking, but your reaction is a bit...」
			PRINTFORMW 「Fwuuuh... I suppose I'll just have to try it out myself.」
		ELSE
			PRINTFORMW 「Surely this can't be that good... can it?」
		ENDIF
		PRINTFORMDW %HE_SHE(93, 1)% starts to eat with you, a bright grin dawning on %HIS_HER(93, 0)% face as soon as %HE_SHE(93, 0)% swallows the first bite.
		PRINTFORMW 「This is good! Very good! Your reaction is not an exaggeration at all!」
		PRINTFORML 「Please, leave no leftovers, let us make sure to enjoy this～...」
		PRINTFORMDW There is barely time for talking as you both continue to delight yourself in %HIS_HER(93, 0)% heavenly cooking.
	CASE 0 ;success
		PRINTFORMDW You smile, and tell %K93NICK()% that it's quite delicious.
		PRINTFORML 「Fufufu! Thank you, hearing that makes me very happy!」
		IF ABL:93:料理技能 >= 3 ;cooking ability
			PRINTFORMW 「It's very good to know that I've getting better and better at cooking.」
		ELSE
			PRINTFORMW 「But I'm sure that there is still a lot to improve, so I will keep practicing.」
		ENDIF
		PRINTL
		PRINTFORML 「Now, if you excuse me...」
		PRINTFORMDW %K93NICK()% smiles as %HE_SHE(93, 0)% eats with you, proud of %HIS_HER(93, 0)% own culinary skill.
	CASE -1 ;failure
		PRINTFORMDW You frown, and tell %K93NICK()% that there is a lot to improve on.
		IF ABL:93:料理技能 >= 3 ;cooking ability
			PRINTFORMW 「I understand. Maybe I missed a step, or maybe I let it cook for too long...」
		ELSE
			PRINTFORML 「Fwuuuh... That is a bit saddening to hear, but thank you for being honest.」
			PRINTFORMW 「I will make sure to practice some more so this doesn't happen again...」
		ENDIF
		PRINTL
		PRINTFORML 「N-no matter, I'm sure this is still edible enough.」
		PRINTFORMDW %K93NICK()% still holds a smile on %HIS_HER(93, 0)% face as %HE_SHE(93, 0)% eats with you.
	ENDSELECT
ENDIF
RETURN 1
