		PRINTFORMDL Defeated, %K93NICK()% looks down for a few seconds, only to soon pick up %HIS_HER(93, 0)% smile again.
		PRINTFORMW 「Then I suppose I will just have to buy more, won't I～?」
		PRINTL
		PRINTFORML 「But %K93_HONORIFIC(MASTER)%, before I do that...」
		PRINTFORMDL %K93NICK()% looks at you and points to %HIS_HER(93, 0)% mouth.
		PRINTFORMW 「What do I do with the gum? Am I suppose to swallow or to spit it?」
		PRINTFORMW 「Something tells me I should spit, but that feels like something rude to do...」
	ELSEIF TCVAR:93:泥酔
		PRINTFORMDL %K93NICK()% holds a small, triangle-shaped chocolate up against the light.
		PRINTFORML 「%K93_HONORIFIC(MASTER)%... Do you think they ever make... these, but of alcohol?」
		PRINTFORMW 「Fufufu...! I would love to eat those all night with you!」
	ELSEIF IN_HEAT(93) && K93_LOVE_LUST_LOVER() && !FIRSTTIME("WaggyFirstKiss", 1, 93)
		PRINTFORMW 「Say %K93_HONORIFIC(MASTER)%! I think I might have an idea...」
		PRINTFORMDL %K93NICK()% looks at you with a sultry gaze before speaking again.
		CALL HPH_PRINT,@"「Wouldn't it be... niceHPH, if we used our tongues to pass candy into one other's mouthsHPH?」","W"
		PRINTFORMW 「I think we would both enjoy that a lot～!」
	ELSE
		IF ONCE("WaggyBuysYouThings") ;gives player a piece of candy
			PRINTFORMDW %K93NICK()% eyes a small chocolate stand, and then proceeds to shift %HIS_HER(93, 0)% gaze towards you.
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, would you like if I bought you one of these?」
			PRINTFORMW 「%SPLIT_G("It's the least I could do, with you're treating me to candy:I'm afraid I can't buy anything too expensive, but I still want to show you my gratitude")%...」
			LOCAL:1 = 0
			IF TALENT:93:恋人 ;lover
				LOCAL:1 += 10
				PRINTFORMDL %HE_SHE(93, 1)% chuckles, and warmly wraps one of %HIS_HER(93, 0)% hand around yours.
				PRINTFORMW 「Fufufu... And It's my duty as your %PRINT_MALE("man", 93)% to pamper you like this, isn't it not?」
			ELSEIF K93_LOVE_LUST_LOVER()
				LOCAL:1 += 4
				PRINTFORMDL %HE_SHE(93, 1)% leans %HIS_HER(93, 0)% head on your shoulder.
				PRINTFORMW 「And even then, you deserve this and much more, for everything else you have given me～!」
			ELSEIF K93_YEARNING_SEXFRIEND(1)
				LOCAL:1 += 2
				PRINTFORMDL %HE_SHE(93, 1)% blushes and shines you a nervous grin.
				PRINTFORMW 「W-well, it's just the considerate thing to do... I think.」
			ELSE
				PRINTFORMDL %HE_SHE(93, 1)% beams you a happy little grin.
				PRINTFORMW 「And of course, you're such a good friend as well!」
				PRINTFORMW 「It's only fair that I give some of it back to you.」
			ENDIF
			PRINTL
			SELECTCASE RAND:10 + LOCAL:1
			CASE 0 TO 5 ;5 black thunder, most common
				CALL COLORMESSAGE(@"%CALLNAME:TARGET% spends ¥150...", C_YELLOW, 1)
				CALL GET_ITEM("ブラックサンダー", 1, 2)
			CASE 6 TO 8 ;3 regular chocolate, more common
				CALL COLORMESSAGE(@"%CALLNAME:TARGET% spends ¥1,000...", C_YELLOW, 1)
				CALL GET_ITEM("チョコレート", 1, 2)
			CASEELSE ;fine chocolate, rare
				CALL COLORMESSAGE(@"%CALLNAME:TARGET% spends ¥3,000...", C_YELLOW, 1)
				CALL GET_ITEM("高級チョコ", 1, 2)
			ENDSELECT
		ELSE ;tries random candy, randomized taste
			PRINTFORMDW %K93NICK()% grabs a %SPLIT_G("tablet of chewing gum:ball-shaped candy:small chocolate chip")% and delicately puts it in %HIS_HER(93, 0)% mouth...
			IF TFLAG:193 == 1
				PRINTFORML 「Mgmgumhmm～! It tastes %SPLIT_G("a bit shour, but the good kind of shour:shooth-meltingly shweet:sho good")%!」
				PRINTFORMDW %HIS_HER(93, 1)% cheeks move as %HE_SHE(93, 0)% chews the candy, %HIS_HER(93, 0)% eyes closed in a delighted grin.
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMDL %K93NICK()% grabs another one, and guides the candy into your mouth.
					PRINTFORMW 「Say aaahhn～! You just have to try this, %K93_HONORIFIC(MASTER)%!」
				ENDIF
			ELSE
				PRINTFORMDW %HE_SHE(93, 1)% finishes chewing before speaking again.
				PRINTFORML 「Mgmgmm... %SPLIT_G("A bit too sour for my taste:Could be sweeter:A bit too hard")%, but it's still good.」
				PRINTFORMW 「Go on %K93_HONORIFIC(MASTER)%, try it! I want to see what you think of it!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
