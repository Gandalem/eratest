@M_KOJO_EN_MESSAGE_COM_K93_365_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME("WaggySellForage")
		PRINTFORML 「You wish to buy forage that I gather myself, is that it?」
		PRINTFORMDW %K93NICK()% rests a finger over %HIS_HER(93, 0)% lips.
		PRINTFORMW 「That doesn't sound like a bad idea, I do like collecting things...」
		PRINTFORML 「I like the idea, %K93_HONORIFIC(MASTER)%!」
		PRINTFORMDW %HE_SHE(93, 1)% happily claps in agreement.
		PRINTFORMW 「As long you don't need anything from my stone collection, then we should be fine.」
		PRINTL
		PRINTFORMW 「But here, let me show you what I have on me!」
	ELSE
		PRINTFORML 「Buying forage again? Here, let me show you what I got.」
	ENDIF
	PRINTFORMDL %K93NICK()% happily looks for things to sell you.
	CALL K93_TIMEPASSDOTS(, "w")
	IF TFLAG:193 == -1
		PRINTFORML 「No... I'd to keep this little stone... And this is for %K93_HONORIFIC(63)%.」
		PRINTFORML 「Sorry, %K93_HONORIFIC(MASTER)%, but I don't have anything for you today.」
		PRINTFORMW 「But maybe we will have more luck next time?」
	ELSE
		PRINTFORML 「Ah, I found this earlier today!」
		PRINTFORMW 「I do hope it suits your needs well, %K93_HONORIFIC(MASTER)%.」
	ENDIF
ENDIF
RETURN 1
