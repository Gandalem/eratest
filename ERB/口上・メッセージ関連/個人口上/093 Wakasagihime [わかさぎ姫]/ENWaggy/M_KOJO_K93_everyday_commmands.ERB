			ELSE
				IF TALENT:93:恋人
					PRINTFORMW 「What a good %PRINT_MALE("husband", MASTER)% you are, cooking for me like this～!」
					PRINTFORML 「Fufufu... I can't wait to partake on this meal, %K93_HONORIFIC(MASTER)%.」
					PRINTFORMDW %K93NICK()% giggles and looks at you with a lovingly bright grin.
				ELSEIF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「Oh, Is this for me? How nice of you, %K93_HONORIFIC(MASTER)%!」
					PRINTFORMDL %K93NICK()% leans in and gives your cheek a warm but brief kiss.
					PRINTFORMW 「Chuuu～... There, consider yourself thanked.」
					PRINTFORMW 「Now, if may eat this delicious meal of yours...」
				ELSE
					PRINTFORMW 「Is this really for me, %K93_HONORIFIC(MASTER)%?」
					PRINTFORML 「Thank you. It looks quite tasty!」
					PRINTFORMDW %K93NICK()% shifts %HIS_HER(93, 0)% gaze towards the plate.
					PRINTFORMW 「Now, if you excuse me...」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	CALL K93_TIMEPASSDOTS(, "w")
	IF TFLAG:193 == 1
		PRINTFORMW 「Fhaaah! That %SPLIT_G("was delicious:tasted so nice:was quite a good meal")%!」
		IF TALENT:93:恋人 && RAND:2
			PRINTFORMW 「I am truly blessed for having such a good cook as my %PRINT_MALE("man", MASTER)%.」
		ELSEIF DISH_ASSI == 93
			PRINTFORMW 「It makes me happy that we were able to cook something this good.」
			PRINTFORMW 「Please, let me know when you want me to assist you again!」
		ELSE
			IF ABL:MASTER:料理技能 >= 4
				IF K93_UNREQUITED(1)
					PRINTFORMW 「Your partner must feel very lucky for having a good cook like you as %HIS_HER(TALENT:MASTER:恋人, 0)% %PRINT_MALE("husband", MASTER)%.」
					PRINTFORMW 「I can only imagine how it is to wake up to a tasty dish like this every day...」
				ELSE
					PRINTFORMW 「I'm lucky to have an excellent cook such as yourself around.」
					PRINTFORMW 「Do know that I wouldn't mind eating something like this every day...」
				ENDIF
			ELSE
				PRINTFORMW 「I always knew you could cook up a tasty dish like this.」
				PRINTFORMW 「So please, I ask that you continue to hone your culinary skills.」
				PRINTFORML 「If you improve even more, I'm sure you will be able to cook like this every day!」
				PRINTFORMDW %HE_SHE(93, 1)% smiles, talking to you with an encouraging tone.
			ENDIF
		ENDIF
	ELSEIF TFLAG:193 == 0
		PRINTFORMW 「This %SPLIT_G("tasted good:one was quite satisfactory")%.」
		IF DISH_ASSI == 93
			PRINTFORML 「I was actually a bit worried that we got we followed the recipe wrong...」
			PRINTFORMW 「But it's good to know that wasn't the case!」
		ELSE
			IF ABL:MASTER:料理技能 >= 4
				PRINTFORMW 「Yes, even though this dish wasn't exactly to my tastes.」
				PRINTFORML 「You have quite a lot of talent, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMDW %HE_SHE(93, 1)% gives you a round of cheerful little claps.
			ELSE
				PRINTFORML 「Of course, there is always something to improve...」
				PRINTFORMW 「But I suppose that comes with time and practice!」
				PRINTFORMDL %HE_SHE(93, 1)% looks at you with a bright smile.
				PRINTFORMW 「So please, don't let yourself be discouraged, %K93_HONORIFIC(MASTER)%.」
			ENDIF
		ENDIF
	ELSEIF TFLAG:193 == -1
		PRINTFORMW 「%SPLIT_G("This doesn't taste that good:This could have used some more work:I don't think I like this one")%...」
		IF DISH_ASSI == 93
			PRINTFORML 「Fwuuuh... I wonder if it was my fault?」
			PRINTFORMDW %HE_SHE(93, 1)% whispers to %HIM_HER(93, 0)%self with downcast eyes.
		ELSE
			PRINTFORML 「But please, don't let that discourage you!」
			PRINTFORMDW %HE_SHE(93, 1)% radiates you with a bright, reassuring grin.
			PRINTFORMW 「I'm still grateful that you cooked this for me.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
