;621,釣りをする
;Fishing
;COM_STR（釣れたもの　"釣れない","ローター","木片","紙切れ", またはアイテム名、魚の種類）
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EN_MESSAGE_MESSAGECHECK_COM_K93_621
RETURN 0

@M_KOJO_EN_MESSAGE_COM_K93_621
CALL M_KOJO_EN_MESSAGE_COM_K93_621_1
RETURN RESULT

@M_KOJO_EN_MESSAGE_COM_K93_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF !(TALENT:93:恋慕 || TALENT:93:愛欲) ;since she will only ever do this at love or lust, lets add this failsafe
		RETURN 1
	
	SIF K93_MAD()
		RETURN 1

	IF !TFLAG:193 ;no catch
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「Oh, did it slip away, even with my help?」
			PRINTFORML 「It's okay, we can just try again!」
			PRINTFORMW 「We just have to be patient, rushing will do us no good.」
		CASE 1
			PRINTFORML 「It's okay if we don't catch anything right now.」
			PRINTFORMW 「After all, isn't fishing supposed to be relaxing activity?」
		CASE 2
			PRINTFORMW 「It seems like the fish here are doing their best avoiding your hook.」
			PRINTFORML 「Fufufu... Maybe they know you're already taken～?」
			PRINTFORMDW %K93NICK()% playfully claims, looking at you with a sly smile.
		ENDSELECT
		RETURN 1
	ELSEIF TFLAG:194 >= 1000 ;means that waggy caught it instead of the player
		IF RAND:2
			PRINTFORML 「Here, %K93_HONORIFIC(MASTER)%, I got something for you.」
		ELSE
			PRINTFORML 「Look, I caught this one myself. And without a rod, too!」
		ENDIF
		PRINTFORMDW %K93NICK()% hands you a %ITEMNAME_TR(TFLAG:193)% %HE_SHE(93, 0)% caught with %HIS_HER(93, 0)% own hands.
	ELSE
		IF RAND:2
			PRINTFORML 「Oh, did you catch something? Let me see it!」
			PRINTFORMDW %K93NICK()% eyes sparkle with curiosity as you raise your fishing rod.
		ELSE
			PRINTFORML 「Hmmm? Oh, good job on your catch, %K93_HONORIFIC(MASTER)%.」
			PRINTFORMW 「Now, let's see what it is...」
		ENDIF
	ENDIF
	PRINTL
	SELECTCASE TFLAG:193
	CASE 8 ;piranha
		PRINTFORML 「Oh my! Look at all these teeth, it makes it look so aggressive!」
		PRINTFORMW 「It looks so scary, too. Are you really going to eat this?」
	CASE 12 ;wakasagi
		IF !RAND:5
			PRINTFORMDL %K93NICK()% lets out a sigh as %HE_SHE(93, 0)% looks at the wakasagi.
			PRINTFORMW 「Fwuuuh... We're not the same thing at all, are we?」
			PRINTFORMW 「Still, make sure that you... treat it well, %K93_HONORIFIC(MASTER)%.」
		ELSE
			PRINTFORMDW %K93NICK()% silently looks at the wakasagi with a pained expression.
			PRINTFORMDW However, %HE_SHE(93, 0)% sighs and looks away after a few seconds.
		ENDIF
	CASE 18 ;catfish
		IF !RAND:5
			PRINTFORML 「You're asking if I've seen one of those, but way bigger?」
			PRINTFORMW 「I'm afraid not. Or at least, I don't think it was a catfish.」
		ELSE
			PRINTFORML 「Aside from the whiskers, it doesn't look like a cat at all...」
			PRINTFORMW 「But I still think it would make for a good pet.」
		ENDIF
	CASE 21 ;rotor
		PRINTFORML 「Oh my! It moves, but it's not a fish at all...」
		IF TALENT:93:愛欲
			CALL HPH_PRINT,@"「I hope you make good use of this, %K93_HONORIFIC(MASTER)%HPH～」","W"
		ELSE
			PRINTFORMW 「I will... trust that you know what to do with this, %K93_HONORIFIC(MASTER)%.」
		ENDIF
	CASE 31 ;takitaro
		PRINTFORML 「It's Takitaro-san! I haven't seen him in so long!」
		PRINTFORMW 「Make sure you treat him with respect, %K93_HONORIFIC(MASTER)%.」
	CASE 131 ;moriya lottery
		PRINTFORM 「Moriya Shrine...? Isn't that all the way
		IF K93_ISINMISTYLAKE()
			PRINTFORML  over there, on top of the mountain?」
			PRINTFORMDW %K93NICK()% asks while pointing %HIS_HER(93, 0)% finger up the Youkai Mountain.
			PRINTFORMW 「It seems that it floated all the way downriver until it got to the lake.」
			PRINTFORMW 「Fwuuuh... Sure this might be useful for you, but I wish they would stop littering.」
		ELSE
			PRINTFORMW  all the way up the Youkai Mountain?」
			PRINTFORML 「I don't have much of an idea of how it ended here, but it should be useful to you.」
			PRINTFORMW 「And do tell me if you get anything good out of it!」
		ENDIF
	CASE 497 ;hina doll, hopefully this is the right ID
		PRINTFORML 「It's one of those well-dressed dolls again.」
		IF DAY:2 == 1 && DAY:3 == 3 && !FIRSTTIME("WaggyExplainHinamatsuri", 1, 93) ;if it's hinamatsuri and player has explained what it is
			PRINTFORMW 「It does makes sense for them to be here, it's Girl's Day today!」
		ELSEIF !FIRSTTIME("WaggyExplainHinamatsuri", 1, 93)
			PRINTFORMW 「Aren't these Hina Dolls, for that festival you told me about?」
			PRINTFORMW 「I wonder what they're doing here at this time of the year...」
		ELSE
			PRINTFORMW 「They float downriver to the lake sometimes, and I'm not really sure why.」
		ENDIF
	CASE 606, 609, 643 ;a few valuable forage materials (dragons claw, ice scale, ryuukotu respectively)
		PRINTFORMW 「There's always something of value under all water, you just have to look for it!」
		IF !RAND:5
			PRINTFORML 「Wouldn't you agree, having caught quite the underwater treasure yourself～?」
			PRINTFORMDW %K93NICK()% says, proceeding to flash you a charmingly playful grin.
		ELSE
			PRINTFORML 「I suppose you could trade it for some money, there's nothing wrong that.」
			PRINTFORMW 「After all, humans do seem to have quite a lot of uses for those.」
		ENDIF
	CASE 610 ;wood
		PRINTFORML 「Uhmm... It's just a piece of wood, I'm sorry to say.」
		PRINTFORMW 「But I'm sure you can still find a good use for it!」
	CASE 706 ;frog
		PRINTFORML 「It's a frog, and this one is not frozen!」
		IF K93_ISINMISTYLAKE()
			PRINTFORML 「Believe it or not, that's a bit of a rare sight around here.」
		ELSE
			PRINTFORML 「I suppose there's no one going around freezing them around here...」
		ENDIF
		PRINTFORMDW %K93NICK()%'s words strike you with confusion, but you decide not to say anything.
	CASEELSE ;everything else should be fish?
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「So, are you going to eat it, or maybe just sell it?」
			PRINTFORMW 「It's up to you, I promise... I won't offended by your decision.」
		CASE 1
			PRINTFORMW 「I hope I was able to be of help, %K93_HONORIFIC(MASTER)%.」
		CASE 2
			PRINTFORML 「It's a nice looking %ITEMNAME_TR(TFLAG:193)%, isn't it?」
			PRINTFORMW 「I hope it serves you well.」
		ENDSELECT
	ENDSELECT
ENDIF
RETURN 1

