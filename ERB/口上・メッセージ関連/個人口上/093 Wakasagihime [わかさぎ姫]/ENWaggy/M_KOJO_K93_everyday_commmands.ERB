		PRINTFORML 「%K93_HONORIFIC(MASTER)%, do we really need to be here?」
	ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置, 1) ;current location is a library, permission to read(?)
		IF FIRSTTIME("WaggyLibraryExplore", 0, 93)
			PRINTFORML 「Fwaaah, so many books in one place!」
			PRINTFORMDW %HE_SHE(93, 1)% is utterly entranced by the concept of a library.
			PRINTFORMW 「%K93_HONORIFIC(MASTER)%, would you mind reading with me?」
			PRINTFORMDW You jokingly question %K93NICK()%'s capability to read.
			PRINTFORMW 「Of course I know how to read!」
			IF K93_LOVE_LUST_LOVER()
				PRINTFORMW 「I just wish to share a good book with someone I love.」
				PRINTFORMW 「Is that too much to ask for, I wonder～?」
			ELSEIF K93_YEARNING_SEXFRIEND()
				PRINTFORMW 「It's just that... reading a good book alongside you would be nice...」
				PRINTFORMW 「T-there's nothing wrong with that, is there?」
			ELSE
				PRINTFORMW 「Reading a good book together is just something that friends do.」
				PRINTFORMW 「And you're someone I can call a friend, are you not?」
			ENDIF
			PRINTFORMDW Saying that, %HE_SHE(93, 0)% scans the bookshelves for something to read.
			PRINTFORMW 「Fweeeh... So many! I don't even know where to start.」
		ELSE
			PRINTFORML 「A library is always a good place for a date!」
			PRINTFORML 「What title do you have in mind for us to read, I wonder?」
		ENDIF
	ELSE ;nothing much
		PRINTDATAL
			DATAFORM 「Hmmhmmm... this place is fairly nice.」
			DATAFORM 「Can we stop here, %K93_HONORIFIC(MASTER)%?」
			DATAFORM 「Resting here would be nice...」
		ENDDATA
	ENDIF

	$SKIPEND

	SELECTCASE K93_CARRYSTATUS() ;put this in a function as well if need arises
	CASE 0
		PRINTFORMDW You carefully sit %K93NICK()% by your side.
	CASE 1
		PRINTFORMDW You sit down, face to face with %K93NICK()%.
	CASE 2
		PRINTFORMDW You help %K93NICK()% with sitting by your side.
	ENDSELECT

	CALL K93_CARRYEFFECTS()
ENDIF
RETURN 1
