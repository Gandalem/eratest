LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF K93_MAD() ;maybedo, find the willpower to write here
		RETURN 1

	IF !ACCOMPANY_ABLE(93) ;not accompanying player
		SELECTCASE TFLAG:193
