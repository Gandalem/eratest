		CALL HPH_PRINT,@"「우리 서로에게 사탕을 입으로 건네주기 위해 혀를 사용한다면... 좋지 않을까 HPH?」","W"
		PRINTFORMW 「우리 둘 다 정말 즐거울 것 같아~!」
	ELSE
		IF ONCE("WaggyBuysYouThings") ;gives player a piece of candy
			PRINTFORMDW %K93NICK()%은 작은 초콜릿 가게를 눈으로 훑어본 뒤, %HIS_HER(93, 0)%의 시선을 당신에게로 돌린다.
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 제가 이것들 중 하나를 사 드릴까요?」
			PRINTFORMW 「%SPLIT_G("네가 나한테 사탕을 사주니, 내가 해줄 수 있는 최소한의 일이야: 너무 비싼 건 못 사지만 그래도 감사함을 표현하고 싶어.")%...」
			LOCAL:1 = 0
			IF TALENT:93:恋人 ;lover
				LOCAL:1 += 10
				PRINTFORMDL %HE_SHE(93, 1)%은 웃으며, %HIS_HER(93, 0)%의 손 하나를 따뜻하게 당신의 팔에 두었다.
				PRINTFORMW 「후후후... 그리고 당신을 이렇게 보살피는 것이 나의 %PRINT_MALE("man", 93)%으로서의 의무 아니겠어?」
			ELSEIF K93_LOVE_LUST_LOVER()
				LOCAL:1 += 4
				PRINTFORMDL %HE_SHE(93, 1)%은 당신의 어깨에 고개를 기댄다.
				PRINTFORMW 「그리고 그럼에도 불구하고, 당신은 나에게 준 모든 것에 대해 이것과 그 이상의 것을 받을 자격이 있어～!」
			ELSEIF K93_YEARNING_SEXFRIEND(1)
				LOCAL:1 += 2
				PRINTFORMDL %HE_SHE(93, 1)%은 얼굴을 붉히며 긴장된 미소를 지어 보인다.
				PRINTFORMW 「그냥 배려해 주는 것뿐이야... 아마도.」
			ELSE
				PRINTFORMDL %HE_SHE(93, 1)%은(는) 너에게 행복한 작은 미소를 지어 보인다.
				PRINTFORMW 「그리고 물론, 너도 정말 좋은 친구니까!」
				PRINTFORMW 「내가 이 중 일부를 너에게 돌려주는 게 공평하지 않을까 생각했어.」
			ENDIF
			PRINTL
			SELECTCASE RAND:10 + LOCAL:1
				CASE 0 TO 5 ;5 black thunder, most common
					CALL COLORMESSAGE(@"%조사처리(CALLNAME:TARGET,"는")%(는) 150엔을 사용한다...", C_YELLOW, 1)
					CALL GET_ITEM("ブラックサンダー", 1, 2)
				CASE 6 TO 8 ;3 regular chocolate, more common
					CALL COLORMESSAGE(@"%조사처리(CALLNAME:TARGET,"는")%(는) 1,000엔을 사용한다...", C_YELLOW, 1)
					CALL GET_ITEM("チョコレート", 1, 2)
				CASEELSE
					CALL COLORMESSAGE(@"%조사처리(CALLNAME:TARGET,"는")%(는) 3,000엔을 사용한다.", C_YELLOW, 1)
					CALL GET_ITEM("高級チョコ", 1, 2)
			ENDSELECT
		ELSE
			PRINTFORMDW %K93NICK()%는 %SPLIT_G("tablet of chewing gum:ball-shaped candy:small chocolate chip")%를 집어 조심스럽게 %HIS_HER(93, 0)%의 입에 넣었다.
			IF TFLAG:193 == 1
				PRINTFORML 「음냠음～! 맛있다 %SPLIT_G("a bit shour, but the good kind of shour:shooth-meltingly shweet:sho good")%!」
				PRINTFORMDW %HIS_HER(93, 1)%는 사탕을 씹으며 볼이 움직이고, 행복한 미소로 눈을 감는다.
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMDL %K93NICK()%은(는) 다른 하나를 집어 당신의 입안으로 사탕을 인도한다.
					PRINTFORMW 「'아~'라고 말해봐~! 이거 한번 해봐, %K93_HONORIFIC(MASTER)%!」
				ENDIF
			ELSE
				PRINTFORMDW %HE_SHE(93, 1)%은 다시 말하기 전에 씹는 것을 마친다.
				PRINTFORML 「음... %SPLIT_G("A bit too sour for my taste:Could be sweeter:A bit too hard")%, 하지만 여전히 맛있어.」
				PRINTFORMW 「계속해 봐 %K93_HONORIFIC(MASTER)%, 먹어봐! 네 생각이 어떤지 보고 싶어!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
