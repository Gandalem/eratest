RETURN RESULT

@M_KOJO_EN_MESSAGE_COM_K93_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL K93_E_SEEWORLD_EVENTS
	SIF RESULT ;if above returns anything, lets cut it conversation here
		RETURN 1

	CALL K93_EVENTCALL(1)
	SIF RESULT ;same idea here
		RETURN 1

	IF TFLAG:193 == -3 ;hate mark 3
		CALL K93EN_HateMark_COM300
	ELSEIF CFLAG:93:ブチギレ ;bukigire, they are mad at you but not necessarily hatemark 3
		CALL K93EN_Bukigire_COM300
	ELSEIF TCVAR:93:泥酔 ;drunk, more specifically wasted
		CALL K93EN_Drunk_COM300
	ELSEIF IN_HEAT(93) ;in heat or under aphrodisiacs
		CALL K93EN_Horny_COM300
	ELSEIF BATHROOM() ;bathing
		CALL K93EN_Bath_COM300
	ELSEIF CFLAG:93:添い寝中 ;in bed together (but not sleeping, you can't do that convo in that anyway)
		CALL K93EN_Sleep_COM300
	ELSEIF TFLAG:193 <= -1 ;failure and great failure
		CALL K93EN_Bored_COM300
	ELSEIF CHK_DATENOW(CFLAG:93:デート中) ;dating now
		CALL K93EN_Date_COM300
	ELSEIF K93_FRIENDSHIP() ;intimacy or desire 2 (or bigger), opens up dialogue
		CALL K93EN_AllConvo_COM300
	ELSE ;none of the options above, you probably just met her and she's shy
		CALL K93EN_Reserved_COM300
	ENDIF
ENDIF
RETURN 1

