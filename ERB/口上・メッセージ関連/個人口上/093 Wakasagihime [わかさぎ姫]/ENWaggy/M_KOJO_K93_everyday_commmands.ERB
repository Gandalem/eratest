			PRINTFORML 「That's okay, I'm sure you'll get it next time!」
			PRINTFORMDW %K93NICK()%'s eyes shine as %HE_SHE(93, 0)% attempts to cheer you up.
		ELSE
			PRINTFORML 「...May I suggest bringing %K93_HONORIFIC(63)% along with you next time?」
			PRINTFORML 「%HE_SHE(63, 1)% has a very good nose for hunting, being a wolf woman and all.」
			PRINTFORMW 「But not only that, %HE_SHE(63, 0)% also always has something to say about the animals!」
		ENDIF
	CASE 0 ;trap set
		PRINTFORML 「Is there anything I can help with, %K93_HONORIFIC(MASTER)%?」
		PRINTFORMW 「I'm not very good at things like this, but surely there is something I can do...」
	CASE 1 ;prey caught!
		SELECTCASE TFLAG:194 ;specific creature caught
		CASE 18 ;monkey
			PRINTFORML 「Are you really going to... eat that one, %K93_HONORIFIC(MASTER)%?」
			PRINTFORML 「I mean no offense, but you it kind of looks like you...」
			SIF !IS_NONHUMAN(MASTER)
				PRINTFORMW 「Although, I suppose your similarities don't go any deeper other than that.」
			WAIT
		CASE 25 ;slime
			PRINTFORML 「It's like water, but it's moving... it's alive!」
			IF GETBIT(FLAG:プール, 3) && RAND:2
				PRINTFORMW 「Doesn't it remind you of the [Mystery Bubbles] you gave me?」
			ELSE
				PRINTFORMW 「Do you think I could swim in it, %K93_HONORIFIC(MASTER)%?」
			ENDIF
		CASE 31 ;rotor
			PRINTFORML 「Is this thing... Is it a... %K93_HONORIFIC(MASTER)%, do you think it's alive?」
			PRINTFORML 「How did it even end up caught in your trap, anyway...」
			PRINTFORMDW %K93NICK()% tilts %HIS_HER(93, 0)% head in utter confusion as %HE_SHE(93, 0)% looks at the rotor.
		CASEELSE ;anything non specific
			PRINTFORML 「Oh, that seems like a good catch, %K93_HONORIFIC(MASTER)%!」
			IF RAND:2
				PRINTFORMW 「I wonder if \@ K93_COHABITATION() ? we # you \@ could keep it as a pet...」
			ELSE
				PRINTFORMW 「It looks so cute! Are you sure you want to eat it?」
			ENDIF
		ENDSELECT
	CASE 10 ;insect trap set
		PRINTFORML 「A trap so small, it makes me wonder what you're planning to catch...」
		PRINTFORMDW %K93NICK()% scratches %HIS_HER(93, 0)% chin while inquisitively looking at your trap.
	CASE 11 ;insect trap broken
		PRINTFORML 「It was such a small trap, maybe something stepped on it without noticing?」
		PRINTFORMW 「Maybe you should try to put a sign, or paint an arrow next to it...」
	CASE 12 ;insect caught
		PRINTFORML 「Hoooah! It looks so cute, %K93_HONORIFIC(MASTER)%!」
		PRINTFORMW 「Are you going to give it a name?」
	ENDSELECT
ENDIF
RETURN 1
