	IF !ACCOMPANY_ABLE(93) ;not accompanying player
		SELECTCASE TFLAG:193
			CASE -1 ;failure
				IF FIRSTTIME("WaggyMusicalPerformanceFailure", 0, 93)
					PRINTFORMW 「음... 무례하게 말하고 싶지는 않지만... 개선할 점이 많다는 거 알고 있지?」
					PRINTFORML 「부디 내 말이 너를 낙담시키는 일이 되지 않기를, 그게 내 의도가 아니니까!」
					PRINTFORMDW %K93NICK()%은 부드러운 미소를 지으며, %HIS_HER(93, 0)%는 가슴에 두 손을 모은다.
					PRINTFORMW 「대신 계속 연습하고, 음악의 기술에서 더 나아지도록 해.」
					PRINTFORMW 「많지는 않겠지만, 나는 그 모든 과정을 듣고 지지해 줄게.」
				ELSE
					PRINTFORMW 「아직 많이 개선할 점이 있다고 생각하지만, 점점 나아지고 있어!」
					PRINTFORML 「여기, 내가 아는 것들을 좀 공유해 줄게, 도움이 될지도...」
					PRINTFORMDW %K93NICK()%은(는) 다음 몇 분 동안 당신에게 %HIS_HER(93, 0)%의 음악적 지식을 나누어 준다.
					SIF !RAND:4
						PRINTFORMDW %HE_SHE(93, 0)%은 그것을 알아듣지 못하지만, %HE_SHE(93, 0)%은 음악에 상당히 재능이 있다.
					EXP:MASTER:演奏経験 += 2 ;simple verbal tutoring, a little extra musical exp
				ENDIF
			CASE 0 ;success
				PRINTFORMDL 당신의 노래가 끝나자마자 미소로 %K93NICK()%께 감사하다고 말했다.
				PRINTFORMW 「정말 멋진 공연이었어요, %K93_HONORIFIC(MASTER)%씨.」
				PRINTFORMW 「다시 듣는 것을 정말 좋아하니 주저하지 말아 주세요.」
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「하지만 이미 알고 있겠지~?」
				ELSEIF K93_YEARNING_SEXFRIEND(1)
					PRINTFORMW 「아니, 어쨌든 나는 누가 부르건 좋은 음악을 즐기니까...」
				ELSE
					PRINTFORMW 「결국 좋은 음악은 항상 연주되고 즐겨져야 한다.」
				ENDIF
			CASE 1 ;great success
				PRINTFORMDL %K93NICK()%은 환한 미소와 부드러운 박수를 치며 당신을 축하해 주었다.
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「후훗! 나에게 바친 그런 로맨틱한 노래라니, %K93_HONORIFIC(MASTER)%!」
					PRINTFORMW 「맹세컨대, 그것은 나를 완전히 사로잡기에 충분했고～」
					PRINTFORMW 「하지만 언젠가 당신을 위해 응답으로 세레나데라도 불러야 할지도 모르겠네...」
				ELSE
					PRINTFORMW 「후아! 당신은 정말 재능 있는 음악가예요, 알고 있죠?」
					PRINTFORMW 「들으니 아주 멋진 공연이었습니다.」
					PRINTFORMW 「다음에 또 당신의 연주를 들을 수 있어 문제가 되지 않기를 바랍니다.」
				ENDIF
		ENDSELECT
	ELSEIF FIRSTTIME("WaggySingingSeen", 0, 93)
		PRINTFORMW 「음... %K93_HONORIFIC(MASTER)%님, 저와 노래를 함께 부르고 싶으신가요?」
		IF K93_LOVE_LUST_LOVER()
			PRINTFORMW 「부끄러워서가 아니라, 당신이 내가 노래하는 걸 본 적이 없을 거라고 생각해서 그래!」
			PRINTFORMW 「우리가 얼마나 가까운데... 좀 이상하네...」
			PRINTFORMDL %K93NICK()%은(는) 미소를 지으며 작고 짧게 웃는다.
			PRINTFORMW 「후후... 괜찮아, 준비가 되면 언제든지 말해줘.」
		ELSE
			PRINTFORML 「음... 다른 사람과 함께 노래할 기회가 자주 생기는 건 아니지만...」
			PRINTFORMDW %K93NICK()%은(는) 말을 흐리다가 금세 %HIS_HER(93, 0)%의 고개를 오른쪽으로 흔든다.
			PRINTFORML 「그건 신경 쓰지 마, 당신의 멋진 제안을 받아들일게!」
			PRINTFORMW 「시작할 준비가 되면 알려줘.」
		ENDIF
		PRINTL
		CALL K93_GENERICSINGING(1)
		CALL K93_TIMEPASSDOTS(, "w")
		SELECTCASE TFLAG:193
			CASE -1 ;failure
				PRINTFORMDL 노래가 끝나자마자 %K93NICK()%은 걱정스러운 표정으로 당신을 바라보고 있다.
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%님... 음악 연주를 하신 지 얼마 안 되셨죠?」
				PRINTFORMW 「아-아니, 못한다고 생각하는 건 아니에요, 다만... 개선할 점이 많아서요...」
				PRINTFORMDW %HE_SHE(93, 1)%은 %HIS_HER(93, 0)%의 머릿속에 아이디어가 떠오르며 잠시 멈춘다.
				PRINTFORML 「음, 저도 아주 잘하는 건 아니지만, 제가 아는 걸 가르쳐 드리는 건 괜찮아요.」
				PRINTFORMW 「연습하고 싶을 때 말만 해주세요. 뭐든지 함께 해 드릴게요.」
			CASE 0 ;success
				PRINTFORMDL %K93NICK()%은(는) 노래가 끝나자마자 밝게 웃으며 당신을 바라본다.
				PRINTFORMW 「정말 좋았어요! 감명받았습니다, %K93_HONORIFIC(MASTER)%님!」
				PRINTFORMW 「저도 당신의 눈에 잘 비쳤으면 좋겠네요.」
				PRINTFORMDW %HIS_HER(93, 1)%의 미소는 천천히 사라지고 %HE_SHE(93, 0)%은 당신에게서 시선을 돌린다.
				PRINTFORML 「언제든지 저와 함께 다른 노래를 부르고 싶을 때 알려주세요.」
				PRINTFORMW 「다시 음악으로 당신을 동행해 드릴 수 있다면 더 기쁠 거예요.」
			CASE 1 ;great success
				PRINTFORMDL 노래를 마치자마자 빠르지만 부드러운 박수 소리가 당신의 귀에 울린다.
				PRINTFORMDW %K93NICK()%은(는) 빛나는 미소로 축하하며 그런 즐거운 박수의 원천이다.
				PRINTFORML 「후우! 대단했어! 정말 멋지다!」
				PRINTFORMW 「언젠가 당신만큼 실력이 되기를 바랄 뿐이야.」
				PRINTFORMDW %HE_SHE(93, 0)%이(가) %HIS_HER(93, 0)%의 팔을 내리자 %HIS_HER(93, 0)% 입가의 미소가 천천히 사라진다.
				PRINTFORMW 「다음에 또 함께 공연하고 싶을 때 알려줘, 기꺼이 함께 하고 싶어.」
		ENDSELECT
	ELSEIF GET_TARGETNUM() >= 4 ;group playing or playing to a lot of people
		IF ONCE("WaggyGroupPerformance", 0, 93) ;don't want to spam this, but tempted to make it a firsttime only thing
			PRINTFORMDW %K93NICK()%는 주변의 모든 사람들을 바라보며 초조하게 %HIS_HER(93, 0)% 손가락을 만지고 있다.
			PRINTFORML 「저를 위해 한 번에 이렇게 많은 사람들에게 노래를 부르다니!」
			PRINTFORMW 「좀 버겁게 느껴져서, 내가... 그렇게 생각하기 시작했어...」
			IF CFLAG:93:K93EN_SEEWORLD >= 9
				PRINTFORMDL %HE_SHE(93, 1)%은/는 멈춰 서서 깊게 숨을 들이마시고 미소를 지으며 당신을 바라본다.
				PRINTFORMW 「후우! 아니야, 내가 부끄러워할 이유도 없어, 더 이상 나만의 구석에 숨을 필요가 없으니까!」
				PRINTFORMW 「이런 기회를 더는 놓치지 않겠다고 스스로 약속했어.」
			ELSE
				PRINTFORMDW %HE_SHE(93, 1)%은(는) 멈춰서 %HIS_HER(93, 0)%의 눈을 감고 몇 초 후에야 다시 뜬다.
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「아니, 당신이 나와 함께 있는 한 나는 괜찮을 거예요.」
					PRINTFORMDL %HE_SHE(93, 1)%은/는 차분한 눈과 부드러운 미소로 당신을 바라본다.
					PRINTFORMW 「당신이 나와 함께 있다면... 예전처럼 수줍어할 이유가 없어요.」
				ELSE
					PRINTFORMW 「아니, 할 수 있을 거야, 조금 진정하기만 하면 돼.」
					PRINTFORMW 「게다가 결국 혼자 하는 것도 아니잖아.」
				ENDIF
			ENDIF
			PRINTFORMDW %HE_SHE(93, 1)%은 다시 잠시 멈추고 고개를 끄덕인다. 거의 %HIM_HER(93, 0)% 자신을 안심시키려는 듯이.
			PRINTFORMW 「%K93_HONORIFIC(MASTER)%님께서 준비되시면 저는 언제든 준비되어 있습니다!」
		ELSE
			PRINTFORMW 「또 이렇게 많은 사람 앞에서 공연을 하다니...」
			PRINTFORMDL %K93NICK()%은(는) 천천히 %HIS_HER(93, 0)% 눈을 깜빡이며 깊게 숨을 들이마신다.
			PRINTFORMW 「후우... 당신이 준비되면 저도 준비됐어요, %K93_HONORIFIC(MASTER)%.」
		ENDIF
		PRINTL
		CALL K93_GENERICSINGING(1)
		CALL K93_TIMEPASSDOTS(, "w")
		SELECTCASE TFLAG:193
			CASE -1 ;failure
				IF RAND:2
					PRINTFORML 「좀 더 잘 됐을 수도 있었는데...」
					PRINTFORML 「너도 너무 긴장했니?」
					PRINTFORMDW %K93NICK()%이(가) %HIS_HER(93, 0)%의 목소리에 걱정을 담아 묻는다.
				ELSE
					PRINTFORML 「좀 떨지 않았더라면, 어쩌면 좀 더 나았을지도 모르는데.」
					PRINTFORML 「후우... 괜찮아, 다음엔 더 잘하면 돼.」
					PRINTFORMDW %K93NICK()%은(는) %HIS_HER(93, 0)%의 침울한 표정에도 미소를 지으려고 노력한다.
				ENDIF
			CASE 0 ;success
				IF RAND:2
					PRINTFORML 「후와아...! 예상보다 더 잘 됐네!」
					PRINTFORMW 「스스로를 너무 많이 의심했던 게 틀렸다는 걸 알게 되어 다행이야.」
				ELSE
					PRINTFORMW 「%K93_HONORIFIC(MASTER)%님... 우리 잘 해냈네요, 그렇죠?」
					PRINTFORMW 「다행이지만, 당신 없이는 못 했을 거라고 생각해요.」
				ENDIF
			CASE 1 ;great success
				IF RAND:2
					PRINTFORMW 「%K93_HONORIFIC(MASTER)%, 보세요! 모두가 우리의 노래를 즐긴 것 같아요!」
					PRINTFORML 「후후후... 이렇게 많은 관심에 뭘 해야 할지 모르겠네요...」
					PRINTFORMDW %K93NICK()%은/는 군중에게서 시선을 돌리고, %HIS_HER(93, 0)%은 금세 얼굴이 붉어진다.
					PRINTFORMW 「하지만 어쩌면 그냥... 어떻게든 즐겨야겠네요.」
				ELSE
					PRINTFORML 「우리 정말 잘 해냈지, 안 그래?」
					PRINTFORMW 「어쩌면 우리 더 자주 같이 하는 게 좋을 것 같아, 난 괜찮을 것 같은데.」
				ENDIF
		ENDSELECT
	ELSE
		IF K93_LOVE_LUST_LOVER()
			IF RAND:2
				PRINTFORML 「제가 너무나 사랑하는 %PRINT_MALE("man", MASTER)%과 함께 듀엣을 한다...」
				PRINTFORMW 「후훗... 이것보다 더 로맨틱한 것은 없을 거야.」
			ELSE
				PRINTFORML 「물론 당신과 노래하고 싶어, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMW 「그런 걸 함께 하는 건 나를 당신에게 더 연결된 기분이 들게 해.」
				PRINTFORMW 「...그건 전혀 이상한 말을 하는 게 아니지, 그렇지?」
			ENDIF
		ELSEIF K93_YEARNING_SEXFRIEND(1)
			PRINTFORML 「음... 물론 너랑 노래 부르는 거 상관없어.」
			PRINTFORMW 「그냥... 친구들이 함께 즐기려고 하는 거지, 안 그래?」
		ELSEIF K93_FRIENDSHIP()
			PRINTFORML 「물론 당신과 함께 노래하는 거 상관없어요, 친구들과 함께 하는 정말 재미있는 일이잖아요!」
			PRINTFORMW 「준비되면 언제든지 말해주세요, %K93_HONORIFIC(MASTER)%님.」
		ELSE
			PRINTFORML 「나랑 같이 노래를 듣고 싶다는 거야...? 그런 거지?」
			PRINTFORMW 「물-물론이지, 정말 좋겠어! 언제 시작할 준비가 되었는지 말해줘.」
		ENDIF
		PRINTL
		CALL K93_GENERICSINGING(1)
		CALL K93_TIMEPASSDOTS(, "w")
		SELECTCASE TFLAG:193
			CASE -1 ;failure
				PRINTFORMDL 노래가 끝나자마자 %K93NICK()% 쪽으로 몸을 돌렸지만, %HE_SHE(93, 0)%이 걱정스러운 눈빛으로 자신을 보고 있는 것을 알아차린다.
				PRINTFORMW 「불쾌하게 하려는 건 아니지만, 확실히 개선할 수 있는 몇 가지가 있어요.」
				IF K93_LOVE_LUST_LOVER()
					PRINTFORML 「여기, 가만히 있어, 내가 더 가까이 이끌어주는 게 좋을 거야...」
					PRINTFORMDW %HE_SHE(93, 1)%은(는) %HIS_HER(93, 0)%에게 팔을 감고 %HIS_HER(93, 0)%의 손을 너의 손 위에 올린다.
					LOCALS:0 = 
					SELECTCASE TFLAG:使用楽器
						CASE 1, 2 ;keyboard and piano, keys
							LOCALS:0 = 키
						CASE 3, 5 ;guitar and violin, strings
							LOCALS:0 = 현악기
						CASE 4 ;trumpet, finger buttons
							LOCALS:0 = 버튼
					ENDSELECT
					PRINTFORMDW %HE_SHE(93, 1)%은 다음 몇 분 동안 당신의 %K93_PRINT_INSTRUMENT()% 위에서 당신의 손가락이 %LOCALS:0%을 움직이는 것을 안내했다.
					EXP:MASTER:演奏経験 += 5 ;hands on teaching, extra musical exp
				ELSE
					PRINTFORMW 「%K93_PRINT_INSTRUMENT()%」를 나에게 건네줄 수 있겠어? 곧 돌려주겠다고 약속할게.
					IF TFLAG:使用楽器 == 2 ;piano, you can't just hand that over to her
						PRINTFORMDW 당신은 일어나서 %HIM_HER(93, 0)%이 피아노 앞에 앉도록 했다.
					ELSE
						PRINTFORMDW 당신은 고개를 끄덕이고 %HIM_HER(93, 0)%을 당신의 %K93_PRINT_INSTRUMENT()%에 넘긴다.
					ENDIF
					PRINTFORMDW %HE_SHE(93, 1)%은 잠시 후 몇 분 동안 그것을 당신 앞에서 가지고 놀면서 여기저기 몇 가지 팁을 준다.
					EXP:MASTER:演奏経験 += 3 ;personal teaching, slightly less extra musical exp
				ENDIF
			CASE 0 ;success
				PRINTFORMDL %K93NICK()%은(는) 노래가 끝나자 공손하게 목례하며 축하한다.
				IF K93_LOVE_LUST_LOVER()
					PRINTFORML 「언제나처럼 당신과 함께한 것은 기쁨이었다, %K93_HONORIFIC(MASTER)%!」
					PRINTFORMW 「다시 듀엣을 하고 싶어질 때 나에게 알려줘, 그러면 기쁘게 응할게.」
				ELSE
					PRINTFORML 「정말 재미있었어요, %K93_HONORIFIC(MASTER)%씨.」
					PRINTFORMW 「%SPLIT_G("너랑 다시 노래 불러도 상관없어. 다시 하고 싶으면 알려줘.")%.」
				ENDIF
			CASE 1 ;great success
				PRINTFORMDL %K93NICK()%은 노래가 끝나자마자 부드러운 박수로 당신을 때린다.
				IF TALENT:93:恋人
					PRINTFORMW 「후후훗~! 나 같은 %PRINT_MALE("husband", MASTER)%에게 그렇게 재능 있는 %K93_PRINT_INSTRUMENT()% 플레이어가 생기다니~」
					PRINTFORMW 「그리고 당신 곁에서 노래할 기회까지 얻게 되다니...」
					PRINTFORML 「나는 정말로 이 환상향 최고의 %PRINT_MALE("man", 93)%일지도 몰라.」
					PRINTFORMDW %HE_SHE(93, 1)%는 열정으로 가득 찬 눈빛으로 당신을 바라보며 말한다.
				ELSEIF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「정말 굉장했어, %K93_HONORIFIC(MASTER)%! 너는 비범한 음악가야!」
					PRINTFORMW 「그리고 덧붙이자면, 너는 놀라운 %PRINT_MALE("man", MASTER)%이기도 해.」
					PRINTFORMW 「후후후... 네 곁에서 노래할 수 있다니, 정말 축복받았어.」
				ELSE
					PRINTFORMW 「당신은 아주 재능 있는 음악가예요, %K93_HONORIFIC(MASTER)%!」
					PRINTFORMW 「저는 저렇게 %K93_PRINT_INSTRUMENT()%를 연주할 수 있을 것 같지 않아요...」
					PRINTFORMDL %HE_SHE(93, 1)%은 잠시 멈추고 당신에게서 시선을 돌린다.
					PRINTFORMW 「다시 함께 공연하게 된다면 문제가 되지 않았으면 좋겠어요.」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
