;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_EN_SUCCESS_COM_K93_417
IF K93_MAD()
	TFLAG:193 = -1 ;doesn't show any train message descriptions
	TFLAG:192 = -1 ;removes any gem gains, i'm pretty sure
ELSEIF TFLAG:193 == 5 && !K93_ISLEWD() ;makes it so the rubbing the player's crotch description doesn't happen unless certain conditions are met
	TFLAG:193 = 3
ELSEIF K93_LOVE_LUST_LOVER() && GROUPMATCH(TIME:5, 4, 5, 6, 14)
	TFLAG:193 = -1 ;we have our own description for this
ENDIF

@M_KOJO_EN_MESSAGE_MESSAGECHECK_COM_K93_417
SIF (!K93_LOVE_LUST_LOVER() && !GROUPMATCH(TIME:5, 4, 5, 6, 14)) || !K93_MAD() ;if she's not at love lover or lust and it's not raining, or she is not mad, call training message as usual
	RETURN 0
RETURN 1

@M_KOJO_EN_MESSAGE_COM_K93_417
CALL M_KOJO_EN_MESSAGE_COM_K93_417_1
RETURN RESULT

@M_KOJO_EN_MESSAGE_COM_K93_417_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K93_MAD()
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 낙담한 시선을 느끼며 눈을 뜬다.
		PRINTFORMDL %HE_SHE(TARGET, 1)%는 아무 말도 하지 않기로 결정하고 다른 곳을 바라본다.
		PRINTW
		RETURN 1
	ENDIF
	IF CFLAG:93:添い寝中 ;co-sleeping together when you wake up
		PRINTFORMDW 당신은 %K93NICK()%'의 머리카락을 향해 손을 뻗고, %HIM_HER(93, 0)%를 깨우지 않도록 조심하며 부드럽게 손가락으로 쓸어 넘긴다.
		PRINTFORMDL %HIS_HER(93, 0)%의 윤기 나는 파란 머리카락 가닥들이 당신의 손가락 사이로 스치자 %K93NICK()%'의 입가에 미소가 번진다.
		PRINTFORMW 「음... 후후... %K93_HONORIFIC(MASTER)%...」
		PRINTFORMDW ...단추처럼 귀엽다!
		RETURN 1
	ENDIF
	IF K93_LOVE_LUST_LOVER() && GROUPMATCH(TIME:5, 4, 5, 6, 14) ;if she's at love lover or lust and it's raining, then we do our special rain cuddle thing
		IF CFLAG:93:添い寝中 ;she's sleeping
			PRINTFORMDL 당신은 바깥 흙에 부딪히는 비 소리의 진정되는 소리에 눈을 뜬다.
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 비가 떨어지는 소리에 분명 달래진 듯 평화롭게 당신 옆에서 잠들어 있다.
			PRINTW
			PRINTFORMDW %K93NICK()%을(를) 당신에게 더 가까이 안고 다시 잠들고 싶은 충동이 들 정도다...
		ELSE
			PRINTFORMDL 당신은 눈을 뜬다. 가슴 위에 머리를 두고 몸을 감싸 안으며 두꺼운 비늘 달린 꼬리가 다리 위로 놓인 것을 느낀다.
			PRINTFORMDL 아래를 내려보니 %조사처리(CALLNAME:TARGET,"가")% 당신을 향해 미소 짓고 있고, 두 사람 모두 두꺼운 이불로 덮여 있었다.
			PRINTFORMDL 비는 바깥의 흙과 머리 위의 지붕 위로 부드럽게 떨어지고 있었다...
			PRINTW
			PRINTFORMW 「드디어 깨셨군요 %K93_HONORIFIC(MASTER)%!」
			PRINTFORML 「오늘 낮잠을 잘 계획은 없었는데, 비가 내리기 시작했네...」
			PRINTFORMDL %K93NICK()% 조여들다 %HIS_HER(93, 0)% 포옹하며 꽉 조여 %HIS_HER(93, 0)% %OPPAI_DESCRIPTION_TR(93)% 당에게 바싹 붙여
			PRINTFORMW 「너를 그렇게 평화롭게 자는 것을 보니, 더 이상 잠들 수 없었어~!」
			PRINTFORMDL %HE_SHE(93, 1)% 감는다 %HIS_HER(93, 0)% 눈이, 입꼬리가 %HIS_HER(93, 0)% 입꼬리가 살짝 올라갔다.
			PRINTFORML 「근데 있잖아, 우리 이렇게 좀 더 있어도 괜찮을까?」
			PRINTFORMW 「지금 당장은 당신을 놓아주고 싶지 않아요, 적어도 밖에 비가 내리는 동안은...」
		ENDIF
	ENDIF
	SELECTCASE TFLAG:193
		CASE 0 ;still sleeping, using your arm as a pillow
			IF RAND:2
				PRINTFORMDL %K93NICK()%, 여전히 잠이 들었고 당신의 베개를 끌어안고 %HIS_HER(93, 0)% 가슴에 단단히 밀착시킨다.
				PRINTFORMDW %HIS_HER(93, 0)% 입가에 걸린 미소는 방금 사용한 베개만으로도 당신을 대신할 수 있음을 알려준다.
			ELSE
				PRINTFORMDL 약간 죄책감을 느끼며, 당신은 잠시 입술을 %K93NICK()%의 이마에 대기 위해 몸을 돌린다.
