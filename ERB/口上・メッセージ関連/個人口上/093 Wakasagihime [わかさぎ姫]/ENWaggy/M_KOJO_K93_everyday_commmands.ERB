				PRINTFORMW 「But I suppose you already know that, don't you～?」
			ELSEIF K93_YEARNING_SEXFRIEND(1)
				PRINTFORMW 「A-after all, I do enjoy some good music, no matter from who it is...」
			ELSE
				PRINTFORMW 「After all, good music should always be played and enjoyed.」
			ENDIF
		CASE 1 ;great success
			PRINTFORMDL %K93NICK()% congratulates you with a bright grin and a round of soft sounding applause.
			IF K93_LOVE_LUST_LOVER()
				PRINTFORMW 「Fufufu! Such a romantic song you have dedicated to me, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMW 「I swear, it was way more than enough to sweep me off my feet～」
				PRINTFORMW 「But maybe I should sing a serenade for you in return, one of those days...」
			ELSE
				PRINTFORMW 「Hooah! You're such a talented musician, you know that?」
				PRINTFORMW 「That was a very nice performance to listen to.」
				PRINTFORMW 「I hope it's not a problem for you to grace me with your music again.」
			ENDIF
		ENDSELECT
	ELSEIF FIRSTTIME("WaggySingingSeen", 0, 93)
		PRINTFORMW 「Uhmm... %K93_HONORIFIC(MASTER)%, y-you wish to perform a song with me?」
		IF K93_LOVE_LUST_LOVER()
			PRINTFORMW 「It's not that I'm shy about it, it's just that I don't think you ever saw me sing!」
			PRINTFORMW 「Which is a bit strange, considering how close we are to one another...」
			PRINTFORMDL %K93NICK()% smiles and lets out a quiet, short chuckle.
			PRINTFORMW 「Fufu... It's okay, just tell me when you're ready to start.」
		ELSE
			PRINTFORML 「W-well, it's not very often that I get to sing with someone else, but...」
			PRINTFORMDW %K93NICK()% trails off, but quickly shakes %HIS_HER(93, 0)% head right after.
			PRINTFORML 「Never mind that, I accept your wonderful proposal!」
			PRINTFORMW 「Just let me know when you're ready to start.」
		ENDIF
		PRINTL
		CALL K93_GENERICSINGING(1)
		CALL K93_TIMEPASSDOTS(, "w")
		SELECTCASE TFLAG:193
		CASE -1 ;failure
			PRINTFORMDL As soon as the song ends, you find %K93NICK()% looking at you with a concerned expression.
			PRINTFORMW 「%K93_HONORIFIC(MASTER)%... you're fairly new to playing music, aren't you?」
			PRINTFORMW 「I-It's not that I think you're bad, it's just... that there is a lot to improve...」
			PRINTFORMDW %HE_SHE(93, 1)% pauses as an idea flares up in %HIS_HER(93, 0)% mind.
			PRINTFORML 「Say, while I'm not that good at it myself, I wouldn't mind teaching you what I know.」
			PRINTFORMW 「Just tell me when you want to practice and I will accompany you, no matter what.」
		CASE 0 ;success
			PRINTFORMDL %K93NICK()% looks at you with a bright smile as soon as the song ends.
			PRINTFORMW 「That was very good! I'm impressed, %K93_HONORIFIC(MASTER)%!」
			PRINTFORMW 「I do hope that I did good in your eyes, too.」
			PRINTFORMDW %HIS_HER(93, 1)% grin slowly fades away as %HE_SHE(93, 0)% looks away from you.
			PRINTFORML 「Just do let me know whenever you want to play another tune with me.」
			PRINTFORMW 「I would be more than happy to accompany you in song again.」
		CASE 1 ;great success
			PRINTFORMDL A burst of quickly paced yet gentle clapping hits your ears as soon as you finish the song.
			PRINTFORMDW %K93NICK()% is the source of such cheerful applause, congratulating you with a shining grin.
			PRINTFORML 「Hoooah! That was impressive! Simply marvelous!」
			PRINTFORMW 「I can only hope to be even remotely as skilled as you are, someday.」
			PRINTFORMDW The smile on %HIS_HER(93, 0)% lips slowly wane as %HE_SHE(93, 0)% lowers %HIS_HER(93, 0)% arms.
			PRINTFORMW 「Do let me know when you want me to perform with you again, I will love to accompany you.」
		ENDSELECT
	ELSEIF GET_TARGETNUM() >= 4 ;group playing or playing to a lot of people
		IF ONCE("WaggyGroupPerformance", 0, 93) ;don't want to spam this, but tempted to make it a firsttime only thing
			PRINTFORMDW %K93NICK()% nervously fiddles with %HIS_HER(93, 0)% fingers while looking at everyone around.
			PRINTFORML 「F-for me to perform a song to so many people at once!」
			PRINTFORMW 「It feels a tad bit overwhelming, I'm starting to think that I...」
			IF CFLAG:93:K93EN_SEEWORLD >= 9
				PRINTFORMDL %HE_SHE(93, 1)% stops, takes a deep breath, and looks at you with a smile.
				PRINTFORMW 「Fwuuuh! No, there is no reason for me to be shy, I have no reason hide in my own corner anymore!」
				PRINTFORMW 「I promised myself I won't let opportunities like this pass me by anymore.」
			ELSE
				PRINTFORMDW %HE_SHE(93, 1)% stops and closes %HIS_HER(93, 0)% eyes, only opening them again after a few seconds.
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「No, I will be okay as long as I have you with me.」
					PRINTFORMDL %HE_SHE(93, 1)% looks at you with calm eyes and a gentle smile.
					PRINTFORMW 「As long as you're with me... I have no reason to be so shy, as I once was.」
				ELSE
					PRINTFORMW 「N-no, I should be able to do it, I just need to calm down a little.」
					PRINTFORMW 「And after all, it's not like I will be doing this alone.」
				ENDIF
			ENDIF
			PRINTFORMDW %HE_SHE(93, 1)% pauses again and nods, almost as if to reassure %HIM_HER(93, 0)%self.
			PRINTFORMW 「I'm ready when you are, %K93_HONORIFIC(MASTER)%!」
		ELSE
			PRINTFORMW 「Performing in front of so many people again...」
			PRINTFORMDL %K93NICK()% slowly blinks %HIS_HER(93, 0)% eyes and takes a deep breath.
			PRINTFORMW 「Fwuuuh... I'm ready when you are, %K93_HONORIFIC(MASTER)%.」
		ENDIF
		PRINTL
		CALL K93_GENERICSINGING(1)
		CALL K93_TIMEPASSDOTS(, "w")
		SELECTCASE TFLAG:193
		CASE -1 ;failure
			IF RAND:2
				PRINTFORML 「T-that could have gone a bit better...」
				PRINTFORML 「Did you get too nervous as well?」
				PRINTFORMDW %K93NICK()% asks, concern present in %HIS_HER(93, 0)% voice.
			ELSE
				PRINTFORML 「If only I hadn't gotten so nervous, maybe that could have gone a bit better.」
				PRINTFORML 「Fwuuuh... That's okay, we'll just have to try better next time.」
				PRINTFORMDW %K93NICK()% tries to conjure a smile despite %HIS_HER(93, 0)% downcast expression.
			ENDIF
		CASE 0 ;success
			IF RAND:2
				PRINTFORML 「Fwaaah...! That went better than I expected!」
				PRINTFORMW 「It's good to know that I was wrong in doubting myself so much.」
			ELSE
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%... We did well, didn't we?」
				PRINTFORMW 「That's a relief, but I don't think I could have done it without you.」
			ENDIF
		CASE 1 ;great success
			IF RAND:2
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%, look! It seems that everyone enjoyed our song!」
				PRINTFORML 「Fufufu... I almost don't know what to do with so much attention...」
				PRINTFORMDW %K93NICK()% looks away from the crowd, %HIS_HER(93, 0)% quickly becoming red.
				PRINTFORMW 「But I suppose I will just have to... enjoy it, somehow.」
			ELSE
				PRINTFORML 「We performed really well together, didn't we?」
				PRINTFORMW 「Maybe we should do it together more often, I don't think I would mind it.」
			ENDIF
		ENDSELECT
	ELSE
		IF K93_LOVE_LUST_LOVER()
			IF RAND:2
				PRINTFORML 「Performing a duet with the %PRINT_MALE("man", MASTER)% I love so much...」
				PRINTFORMW 「Fufufu... I don't think there's anything more romantic than this.」
			ELSE
				PRINTFORML 「Of course I want to sing a song with you, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMW 「Doing something like that together makes me feel more connected with you.」
				PRINTFORMW 「...That's not a strange thing to say at all, is it?」
			ENDIF
		ELSEIF K93_YEARNING_SEXFRIEND(1)
			PRINTFORML 「Uhmm... Of course I don't mind playing a song with you.」
			PRINTFORMW 「It's just something that... friends do to have fun together, isn't it?」
		ELSEIF K93_FRIENDSHIP()
			PRINTFORML 「Of course I don't mind singing a song with you, it's such a fun thing to do with friends!」
			PRINTFORMW 「Just tell me when you are ready to start, %K93_HONORIFIC(MASTER)%.」
		ELSE
			PRINTFORML 「You want me to play a song together with you... is that it?」
			PRINTFORMW 「S-sure, I'd love to! Just tell me when you're ready to begin.」
		ENDIF
		PRINTL
		CALL K93_GENERICSINGING(1)
		CALL K93_TIMEPASSDOTS(, "w")
		SELECTCASE TFLAG:193
		CASE -1 ;failure
			PRINTFORMDL You turn towards %K93NICK()% as soon as the song ends, only to notice that %HE_SHE(93, 0)% is looking at you with concern.
			PRINTFORMW 「I don't mean any offense, but there are a few things you can definitely improve.」
			IF K93_LOVE_LUST_LOVER()
				PRINTFORML 「Here, sit still, it's better if I guide you more closely...」
				PRINTFORMDW %HE_SHE(93, 1)% wraps %HIS_HER(93, 0)% arms around you and rests %HIS_HER(93, 0)% hands over yours.
				PRINTFORMD %HE_SHE(93, 1)% then spends the next few minutes guiding the movement of your fingers over the
				SELECTCASE TFLAG:使用楽器
				CASE 1, 2 ;keyboard and piano, keys
					PRINTFORMD  keys
				CASE 3, 5 ;guitar and violin, strings
					PRINTFORMD  strings
				CASE 4 ;trumpet, finger buttons
					PRINTFORMD  buttons
				ENDSELECT
				PRINTFORMDW  of your %K93_PRINT_INSTRUMENT()%.
				EXP:MASTER:演奏経験 += 5 ;hands on teaching, extra musical exp
			ELSE
				PRINTFORMW 「Mind handing me that %K93_PRINT_INSTRUMENT()% of yours? I promise I will give it back soon.」
				IF TFLAG:使用楽器 == 2 ;piano, you can't just hand that over to her
					PRINTFORMDW You get up, allowing %HIM_HER(93, 0)% to sit in front of the piano.
				ELSE
					PRINTFORMDW You nod and hand %HIM_HER(93, 0)% over your %K93_PRINT_INSTRUMENT()%.
				ENDIF
				PRINTFORMDW %HE_SHE(93, 1)% then spends the next few minutes playing it in front of you, while giving you a few tips here and there.
				EXP:MASTER:演奏経験 += 3 ;personal teaching, slightly less extra musical exp
			ENDIF
		CASE 0 ;success
			PRINTFORMDL %K93NICK()% congratulates you with a polite bow as soon as the song is over.
			IF K93_LOVE_LUST_LOVER()
				PRINTFORML 「Playing with you was a joy like always, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMW 「Do let me know when you want to perform a duet again, and I will happily oblige.」
			ELSE
				PRINTFORML 「That was a lot of fun, %K93_HONORIFIC(MASTER)%.」
				PRINTFORMW 「%SPLIT_G("I wouldn't mind singing with you again:Do let me know if you want to do it again")%.」
			ENDIF
		CASE 1 ;great success
			PRINTFORMDL %K93NICK()% hits you with a salvo of gentle handclaps as soon as the song is finished.
			IF TALENT:93:恋人
				PRINTFORMW 「Fufufu～! To have such a talented %K93_PRINT_INSTRUMENT()% player as my %PRINT_MALE("husband", MASTER)%～!」
				PRINTFORMW 「And to be blessed with the opportunity to sing by your side, too...」
				PRINTFORML 「I might just be the luckiest %PRINT_MALE("man", 93)% in all of Gensokyo.」
				PRINTFORMDW %HE_SHE(93, 1)% says, looking at you with eyes full of passion.
			ELSEIF K93_LOVE_LUST_LOVER()
				PRINTFORMW 「That was incredible, %K93_HONORIFIC(MASTER)%! You are a brilliant musician!」
				PRINTFORMW 「And if I add, you are an incredible %PRINT_MALE("man", MASTER)% as well.」
				PRINTFORMW 「Fufufu... I'm truly blessed, to be able to sing by your side.」
			ELSE
				PRINTFORMW 「You're a very talented musician, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMW 「I don't think I would ever be able to play the %K93_PRINT_INSTRUMENT()% like that...」
				PRINTFORMDL %HE_SHE(93, 1)% pauses and looks away from you.
				PRINTFORMW 「I just hope it wouldn't be a problem if we were to... perform together again.」
			ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
