@M_KOJO_EN_MESSAGE_COM_K93_414_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF STRCOUNT(DISH_TASTE, "魚料理") ;fish dish
		IF K93_MAD()
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, have you lost your mind?」
			PRINTFORMW 「As if hurting me wasn't enough, you now offer me... this.」
			PRINTFORMDL %K93NICK()% shakes %HIS_HER(93, 0)% head and looks at you with tears in %HIS_HER(93, 0)% eyes.
			PRINTFORMW 「Please, try and be more considerate next time.」
		ELSE
			PRINTFORMW 「I'm sorry %K93_HONORIFIC(MASTER)%, but there is no way I can accept this.」
			PRINTFORML 「And I'm sure I don't need to explain why...」
			PRINTFORMDW %K93NICK()% says, lowering %HIS_HER(93, 0)% gaze towards %HIS_HER(93, 0)% fish tail.
		ENDIF
		RETURN 1
	ELSEIF K93_MAD()
		PRINTFORML 「Is this really for me, %K93_HONORIFIC(MASTER)%?」
		PRINTFORMDW %K93NICK()% looks at %HIS_HER(93, 0)% plate in silence for a few seconds.
		PRINTFORML 「Maybe I shouldn't, but I will trust you this time.」
		PRINTFORMW 「Now, if you excuse me...」
		CALL K93_TIMEPASSDOTS(, "w")
		IF TFLAG:193 == 1
			PRINTFORMW 「If I'm being completely honest, this is quite good.」
			PRINTFORMDL %HE_SHE(93, 1)% looks up at you with gentle eyes.
			PRINTFORMW 「Thank you for the meal, I liked it.」
		ELSEIF TFLAG:193 == 0
			PRINTFORMW 「Ah, it's good to know I wasn't wrong in trusting you.」
			PRINTFORML 「It would also be unpolite to thank you for this, so...」
			PRINTFORMW 「Thank you for the meal, %K93_HONORIFIC(MASTER)%.」
		ELSE
			PRINTFORML 「That was filling.」
			PRINTFORMDW %HE_SHE(93, 1)% unceremoniously passes you the plate back.
		ENDIF
		RETURN 1
	ELSEIF SELECTCOM == 415 && RAND:2 ;this is called under [Serve a Meal] as well, so we'll add a 50/50 chance if your currently select command is that
		PRINTFORML 「Are you sure you don't want me to share it with you, %K93_HONORIFIC(MASTER)%?」
		PRINTFORMDW %K93NICK()% tilts %HIS_HER(93, 0)% head to the side and looks at you with an inquisitive gaze.
		IF DISH_ASSI == 93
			PRINTFORMW 「I've had a hand in this dish, so I think it's under my authority to say you should eat it, too.」
		ELSEIF K93_LOVE_LUST_LOVER()
			PRINTFORMW 「I'm not sure if this delicious dish will taste the same without you eating it by my side!」
		ELSE
			PRINTFORMW 「You know I'm a light eater, I'm not even sure if I can eat all of this alone.」
		ENDIF
		PRINTFORMDL %HE_SHE(93, 1)% looks at you for a few seconds before letting out a defeated sigh.
		PRINTFORMW 「Fwuuuh... It doesn't seem like I can convince you, so if you can excuse me...」
	ELSEIF DISH_ASSI == 93
		IF DISHNAME == "マーメイドパフェ" ;mermaid parfait
			PRINTFORMW 「Oh, I see we are having the parfait we both worked on together!」
			IF GET_TARGETNUM() > 3
				PRINTFORML 「While I'm glad that you are sharing it with me...」
				PRINTFORMDW %K93NICK()% anxiously looks at everyone waiting for their plates to be served.
				PRINTFORMW 「I'm also a tiny bit nervous, having all these people taste our dish.」
				IF CFLAG:93:K93EN_SEEWORLD >= 9
					PRINTFORMW 「But there is no reason to worry, I'm sure they will love it!」
				ELSE
					PRINTFORMW 「Fwuuuh... I just hope it turned out good at the very least.」
				ENDIF
			ELSE
				PRINTFORMW 「Thank you for sharing it with me, %K93_HONORIFIC(MASTER)%.」
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「I'm sure that our love will make this taste all the better～!」
					PRINTFORMDL %K93NICK()% covers %HIS_HER(93, 0)% lips and lets out a chuckle.
					PRINTFORMW 「Fufu... I apologize, I couldn't stop myself from saying that.」
				ELSEIF K93_YEARNING_SEXFRIEND(1)
					PRINTFORMDL %K93NICK()% looks at %HIS_HER(93, 0)% plate and whispers.
					PRINTFORMW 「I'm sure it's bound to taste even nicer, since I'm eating it with you...」
				ELSE
					PRINTFORMDL %K93NICK()% clasps %HIS_HER(93, 0)% hands and looks at you with a grin.
					PRINTFORMW 「Now, shall we eat it? I can barely wait to taste it!」
				ENDIF
			ENDIF
		ELSE
			PRINTFORMW 「Oh, are we having our meal right now?」
			IF GET_TARGETNUM() > 3
				PRINTFORML 「Fwaaah... It's not often that I eat with so many others around!」
				PRINTFORMDW %K93NICK()% looks around with a shy smile.
				PRINTFORMW 「Especially something that I myself helped cook.」
