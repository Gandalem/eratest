	SELECTCASE IFRAND("0TO2", 1, "3", K93_LOVE_LUST_LOVER())
		CASE 0
			IF YOGORE:(CFLAG:MASTER:現在位置) < 1000 ;clean
				PRINTFORML 「후와아... 당신의 방은 정말 좋은 향기가 나네!」
				PRINTFORMW 「당신은 이렇게 침실을 깔끔하게 유지하는 것이 아주 잘 되어 있군요, %K93_HONORIFIC(MASTER)%씨.」
			ELSE
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%님, 정리하는 거 도와드릴까요?」
				PRINTFORMW 「정말 돕고 싶어요, 그냥 말씀만 하세요.」
			ENDIF
		CASE 1
			PRINTFORMW 「흠... 이 장소는 좀 더 여성적인 손길이 필요할 것 같아.」
			IF IS_MALE(MASTER)
				PRINTFORML 「어쩌면 식물들이나 더 장식된 커튼 같은 걸 말하는 건가요.」
				PRINTFORMW 「어떻게 생각하세요, %K93_HONORIFIC(MASTER)%?」
			ELSE
				PRINTFORML 「네가 어떤 면에서 여성적이지 않다는 뜻이 아니야!」
				PRINTFORMW 「그냥 무언가 추가되는 건 언제나 좋으니까.」
			ENDIF
		CASE 2
			PRINTFORMW 「%K93_HONORIFIC(MASTER)%, 물 좀 가져다 주시겠어요?」
			PRINTFORMDW 당신은 마실 수 있는 물을 평범한 유리컵에 따서 %K93NICK()%에게 건넨다.
			PRINTFORMW 「이거 정말 맛있어 보인다! 자, 잘 먹겠습니다～!」
			PRINTFORMDL %K93NICK()%은(는) 두 손으로 컵을 잡고 몇 모금 만에 전부 들이킨다.
			PRINTFORMW 「꿀꺽... 글룹... 꿀꺽! 후아, 정말 맛있다...」
			PRINTFORMW 「고마워요, 계속 이야기하느라 목이 말랐어요.」
		CASE 3
			IF K93_UNREQUITED(1)
				PRINTFORML 「%K93_HONORIFIC(MASTER)%님, 저와 함께 움직일 수 있을 거라고 생각하세요?」
				PRINTFORMW 「하지만 어떻게든 당신의 연인이 그것을 허락해 줄지는 의심되네요...」
			ELSE
				PRINTFORML 「요즘 뭔가 생각하고 있었어...」
				PRINTFORMDW %K93NICK()%은(는) 행복하게 %HIS_HER(93, 0)%의 두 손을 맞잡는다.
				PRINTFORMW 「너와 함께 이사한다면 어떨까? 별 문제는 없을 거라고 확신해!」
				SIF TALENT:93:恋人
					PRINTFORMW 「함께 사는 것은 결국 커플들이 하는 일이니까.」
			ENDIF
	ENDSELECT
	RETURN 1
ELSEIF K93_YOUVISITWAGGY() ;you visit her bedroom, variations for if she still lives in the lake included
	SELECTCASE IFRAND("0TO1", 1, "2", K93_EROTIC(), "3", !K93_COHABITATION())
		CASE 0
			IF YOGORE:(CFLAG:MASTER:現在位置) < 1000
				PRINTFORML 「음~ 제대로 정리된 침실보다 더 좋은 건 없어.」
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%님, 편하게 해.」
			ELSE
				PRINTFORML 「%K93_HONORIFIC(MASTER)%, 나 좀 정리하는 것 도와줄 수 있겠어요?」
				PRINTFORMW 「제가 게으름을 이기지 못했던 것 같아요.」
			ENDIF
		CASE 1
			PRINTFORML 「%K93_HONORIFIC(MASTER)%께」 필요한 거 있니?
			PRINTFORMW 「많지는 않지만, 당신을 위해 요리해 줄 수 있을 거야!」
		CASE 2
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 생각해보니 말이야...」
			PRINTFORMW 「나랑 같이 사는 건 어때?」
			IF K93_UNREQUITED(1)
				PRINTFORML 「생각해 보니 좋은 생각은 아닐 것 같아.」
				PRINTFORMW 「너는 벌써 집에서 기다리는 사람이 있잖아?」
			ELSE
				PRINTFORMW 「전혀 나쁜 생각은 아닐 것 같은데, 그렇지 않아?」
			ENDIF
		CASE 3
			IF K93_LIVINGINMISTYLAKE()
				PRINTFORML 「여기서, %K93_HONORIFIC(MASTER)%, 잠시 둘러줄게!」
				PRINTFORMDW %K93NICK()%가 네 허리를 감싸 안으며 수영을 도와준다.
				PRINTFORMW 「여기에 볼 건 별로 없어, 작은 난파선이랑 바위들, 그리고 몇몇 물고기들뿐이야.」
				PRINTFORMDL %HIS_HER(93, 0)%의 말대로 지금 눈에 띄는 흥미로운 것들은 이끼와 세월에 뒤덮인 낡은 노젓는 배들뿐이다.
				PRINTFORMDW 어쩌면 여기서 좀 더 시간을 보낸다면 볼 만한 흥미로운 것들을 찾을 수도 있을 거야.
				PRINTFORMDW 그럼에도 불구하고, 이곳에는 특유의 조용하면서도 평온한 분위기가 있다.
				PRINTFORMW 「하지만 솔직히 내가 여기 말고 더 가고 싶은 곳이 떠오르지 않아.」
			ELSE
				PRINTFORML 「땅 위에서 사는 걸 좋아하지만, 내 이동 능력은 이제 심하게 저하되었다고 인정해야겠어...」
				PRINTFORMW 「하지만 네가 이렇게 가까운 곳에 살아서 언제든 도움을 청할 수 있다는 건 다행이야!」
				PRINTFORMW 「그러니 너도 필요할 때 언제든지 나를 불러줘, %K93_HONORIFIC(MASTER)%.」
				PRINTFORMDL %K93NICK()%은(는) 밝고 따뜻한 미소를 지어 보인다.
				PRINTFORMW 「네가 무엇을 필요로 하든, 나는 항상 네 곁에서 도울 거야.」
			ENDIF
	ENDSELECT
	RETURN 1
ELSEIF K93_COHABITATION(1) ;you live in the same room, currently in it, variations for if she still lives underwater included
	SELECTCASE RAND:4
		CASE 0
			IF YOGORE:(CFLAG:MASTER:現在位置) < 1000
				PRINTFORML 「음냐음냐, 나 이렇게 깨끗한 내 방을 가져본 적이 없는 것 같아!」
				PRINTFORMW 「정말 좋은 집이네%PRINT_MALE("husband:wife", MASTER)%, %K93_HONORIFIC(MASTER)%～」
			ELSE
				PRINTFORML 「%K93_HONORIFIC(MASTER)%님, 이곳은 좀 청소가 필요할 것 같아요.」
				PRINTFORMW 「청소 임무를 나누는 게 공평하겠죠, 그러니 시작할 준비가 되면 알려주세요.」
			ENDIF
		CASE 1
			IF K93_LIVINGINMISTYLAKE()
				PRINTFORML 「여기서 헤엄치는 것에 더 익숙해진 걸 보니 기쁘네요.」
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%님, 하지만 필요한 게 있다면 꼭 말해주세요.」
			ELSE
				PRINTFORMW 「미스티 호수 외의 어딘가에서 살게 될 줄은 상상도 못 했어!」
				PRINTFORML 「완전히 익숙해지긴 힘들 것 같아...」
				PRINTFORMDL %K93NICK()%이 웃는 동안 %HE_SHE(93, 1)%는 말을 흐린다.
				PRINTFORMW 「네가 나에게 준 모든 것에 영원히 감사할게, %K93_HONORIFIC(MASTER)%.」
			ENDIF
		CASE 2
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 우리 장 좀 사다 줄 수 있겠어?」
			PRINTFORMW 「지금 당장 할 필요는 없어, 다음에 나갈 때 하면 돼.」
		CASE 3
			PRINTFORMDL %K93NICK()%은(는) 게으르게 기지개를 켜며 %HIS_HER(93, 0)%의 머리를 당신의 어깨에 기대게 한다.
			PRINTFORMW 「푸와아, 사랑하는 사람과 집에 있는 건 정말 최고야...」
	ENDSELECT
	RETURN 1
ENDIF
