				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「So first we cooked together, and now we are eating together...」
					PRINTFORMDL %K93NICK()% pauses and looks at you with a sly grin.
					PRINTFORMW 「Don't you agree it's something very romantic to do, %K93_HONORIFIC(MASTER)%～?」
				ELSE
					PRINTFORMW 「Thank you, %K93_HONORIFIC(MASTER)%.」
					PRINTFORML 「Both for helping me and... for eating by my side as well.」
					PRINTFORMDW %K93NICK()% cheeks blush as %HE_SHE(93, 0)% looks at %HIS_HER(93, 0)% plate.
				ENDIF
			ELSE
				PRINTFORMW 「Eating the food that you yourself made always makes it taste better!」
				PRINTFORMDL %K93NICK()% clasps %HIS_HER(93, 0)% hands and looks at the dish apprehensively.
				PRINTFORMW 「Let us just hope that we did a good job in general...」
			ENDIF
		ENDIF
	ELSE
		IF DISHNAME == "マーメイドパフェ" ;mermaid parfait
			PRINTFORMW 「Hoooh, I see you're trying your own hand at a Mermaid Parfait!」
			IF ABL:MASTER:料理技能 >= 4
				PRINTFORMW 「Considering your skills, I have great faith that it turned out well!」
				PRINTFORML 「I more than look forward to trying it, %K93_HONORIFIC(MASTER)%.」
				PRINTFORMDW %K93NICK()% looks at %HIS_HER(93, 0)% plate with glistening eyes.
			ELSE
				PRINTFORMW 「I wonder if you learned the recipe from me properly...」
				PRINTFORML 「But I suppose there is only one way to find out.」
				PRINTFORMDW %K93NICK()% looks at %HIS_HER(93, 0)% plate, eyes full of apprehension.
			ENDIF
		ELSE
			IF GET_TARGETNUM() > 3
				PRINTFORMW 「How nice of you to prepare a meal for all of us, %K93_HONORIFIC(MASTER)%.」
				IF CFLAG:93:K93EN_SEEWORLD >= 9
					PRINTFORMW 「I seldom get the opportunity to eat with so many people.」
					PRINTFORMDL %K93NICK()% looks at everyone around %HIM_HER(93, 0)% with a smile.
					PRINTFORMW 「But now, it doesn't seem that bad!」
				ELSE
					PRINTFORML 「Although, I'm not really used to eating with so many people around...」
					PRINTFORMDW %K93NICK()% looks at %HIS_HER(93, 0)% plate, trying to avoid looking at everyone around %HIM_HER(93, 0)%.
