			CASE 3
				PRINTFORML 「Hoooah...! %K93_HONORIFIC(MASTER)%, %SPLIT_G("what purpose does this one serve:what is the name of this:what is this made of:what is this")%?」
				PRINTFORMDW Curiosity sparkles in %K93NICK()%'s eyes as %HE_SHE(93, 0)% points at an object on sale.
			ENDSELECT
		ENDIF
