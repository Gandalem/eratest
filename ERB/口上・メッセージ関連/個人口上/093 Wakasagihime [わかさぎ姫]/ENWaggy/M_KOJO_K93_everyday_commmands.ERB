	IF TCVAR:93:泥酔 ;drunk
		IF ALCOHOL_TASTE(TFLAG:194) >= 15 ;like
			PRINTFORML 「후아앗... 이거 정말 달고 좋다!」
			IF IS_FALLEN(93)
				PRINTFORMW 「나는 항상... 네가 내 마음을 알아주리라 기대해왔어...」
				PRINTFORMDL %K93NICK()%은(는) 눈을 반쯤 감고 너를 바라본다.
				PRINTFORMW 「지금 내가 뭘 원하는지... 맞춰줄 수 있겠니~~?」
			ELSE
				PRINTFORMW 「%K93_HONORIFIC(MASTER)%님! 당신에게는... 더 있는 거 아니겠죠?」
				PRINTFORML 「더 주실 수 있나요... 예쁜 기쁨을요?」
				PRINTFORMDW %K93NICK()%은/는 간절한 눈으로 당신을 바라본다.
			ENDIF
		ELSEIF ALCOHOL_TASTE(TFLAG:194) <= 9 ;no like
			PRINTFORML 「음... 안 돼... 이거 맛이 별로네.」
			IF IS_FALLEN(93)
				PRINTFORMW 「그리고 지금 내 입안에 이런... 이상한 맛이 나네...」
				PRINTFORMDL %K93NICK()%은(는) 당신을 %HIS_HER(93, 0)% 살짝 오므린 입술로 바라본다.
				PRINTFORMW 「혹시 그걸 도와줄 만한 무언가나 누군가가... 주변에 있는 걸까～?」
			ELSE
				PRINTFORMW 「한 잔만 더 마시게 해줘... 한번 해보자고, 어쩌면 내 마음이 바뀔지도 몰라~!」
			ENDIF
		ELSE
			PRINTFORML 「이건... 맛없진 않은데, 잘 모르겠어...」
			PRINTFORMW 「자, 한 모금 더 주시지... %K93_HONORIFIC(MASTER)%님!」
			PRINTFORMDL %K93NICK()%은(는) 장난기 가득하고 술에 취한 미소를 지었다.
			PRINTFORMW 「어쩌면... 어쩌면 그때쯤 결정을 내릴 수 있을지도 몰라.」
		ENDIF
	ELSE
		IF COM_STR == "甘酒" ;sweet sake
			PRINTFORML 「아, 달콤한 술! 이거 내가 제일 좋아하는 것 중 하나야.」
			PRINTFORMW 「맛도 나쁘지 않고, 상당히 달기도 해...」
			IF K93_LOVE_LUST_LOVER() && !RAND:4
				PRINTFORMDL %K93NICK()%는(은) 그릇을 휘저으며 만족스러운 미소로 당신을 바라본다.
				PRINTFORMW 「하지만 말해두겠어, 스위트 사케가 네 키스만큼 달진 않다고～!」
				PRINTFORMW 「후후후... 미안해, 그냥 참을 수가 없었어.」
			ELSE
				PRINTFORMDW %K93NICK()%은(는) 미소를 지으며 %HIS_HER(93, 0)% 잔들을 빙글빙글 돌린다.
			ENDIF
		ELSEIF COM_STR == "フルーツワイン" ;fruit wine, game says that it's raspberry so it should be very sweet
			PRINTFORMW 「후우... 이건 달콤한 사케와는 다르지만, 여전히 달콤해!」
			PRINTFORML 「색깔도 정말 좋다. 당신의 이 와인 정말 마음에 들어.」
			PRINTFORMDW %K93NICK()%은(는) %HE_SHE(93, 0)%가 %HIS_HER(93, 0)%를 마시는 것을 보고 볼이 붉어진다.
		ELSEIF COM_STR == "ミード" ;mead
			PRINTFORML 「후와아, 이거 마음에 들어! 맥주처럼 살짝 탄산이 있지만, 그래도 달콤한 맛이 나네.」
			PRINTFORMW 「하지만 내가 제일 좋아하는 건 아니라고 해야 할까... 그냥 마음에 드는 것 중 하나지.」
		ELSE
			IF ALCOHOL_TASTE(TFLAG:194) >= 15 ;like
				PRINTFORMW 「후와아! 이것은 별로 잘 모르겠지만 정말 맛있다!」
				IF RAND:2 && K93_LOVE_LUST_LOVER()
					PRINTFORML 「좋은 사람들과 함께 좋은 술을 마시는 것보다 더 좋을 순 없지.」
					PRINTFORMDW %K93NICK()%이 잠시 멈추더니 환한 미소로 당신을 바라본다.
					PRINTFORMW 「그렇게 생각하지 않으신가요, %K93_HONORIFIC(MASTER)%～?」
				ELSE
					PRINTFORML 「실례지만, 당신은 더 가지고 있나요?」
					PRINTFORMW 「더 마시고 싶어요...」
				ENDIF
			ELSEIF ALCOHOL_TASTE(TFLAG:194) <= 9 ;no like
				PRINTFORMW 「후우... 유감이지만, 이건 별로 마음에 들지 않는군.」
				IF RAND:2
					PRINTFORML 「어쩌면 %K93_HONORIFIC(73)%이 이것을 감상할 수 있을지도 모르지?」
					PRINTFORMDW %K93NICK()%는 %HE_SHE(93, 0)%가 천천히 내용물을 휘젓는 동안 잔 안을 들여다본다.
				ELSE
					PRINTFORMW 「죄송하지만, 좀 더 달콤한 건 없나요?」
				ENDIF
			ELSE
				PRINTFORML 「흠... 이걸 어떻게 생각해야 할지 모르겠네...」
				PRINTFORMW 「나쁘진 않고, 취하기엔 괜찮을 것 같아.」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
