		ENDSELECT
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		SELECTCASE ABL:93:料理技能
			CASE IS >= 4
				PRINTFORML 「후후후! 정말 멋지게 나왔지 않니?」
