;==================================================
;Common Request Dialogue
;依頼口上・各依頼で共通の口上
;==================================================
@M_KOJO_EN_IRAI_K93(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
		;The character making the request
#DIMS SCENE    ;セリフの表示されるタイミング
		;When the dialogue appears
#DIM  IRAI_ID  ;依頼自体のID
		;The request ID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
		;The requestee's ID
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
		;The request type ID (cut some wood, water my flowers, etc.)
#DIMS IRAI_NAME;依頼名
		;The name of the request
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_EN_IRAI_%IRAI_NAME%_K93(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_EN_IRAI_{CHK_ID}_K93(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;Here is the common opening statement for each request.
;If you display the common comments for each request, the common comments will not be displayed.
;The items circled by [ ] are the background sentences before and after the opening remarks and the processing that takes place.
;Please use this as a guideline for whether to WAIT or not (L and W stand for PRINTFORML and PRINTFORMW, respectively).
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
; ●When a request is made to you.
; [w It seems that [she] has a favor to ask of [you].
;-◆Dialogue
; [Request Data Display].
; [INPUT (Do you accept the request? Y/N)].
;●依頼を持ちかけられる時
;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
;【◆口上】
;【依頼データ表示】
;【INPUT（受託するかY/N）】
	IF K93_LOVE_LUST_LOVER()
		PRINTFORML 「%K93_HONORIFIC(MASTER)%, I need your help for something.」
		PRINTFORML 「Would you mind lending me a hand?」
	ELSEIF K93_YEARNING_SEXFRIEND()
		PRINTFORML 「Oh! Uhmm... %K93_HONORIFIC(MASTER)%, would you mind helping me for a little?」
	ELSE
		PRINTFORML 「%K93_HONORIFIC(MASTER)%, I hope it's not a problem, but there is something I need your help with...」
	ENDIF
;●[366] When doing "Listen to Request" after accepting the request
;◆Dialogue
;-[Request Data Display].
;[INPUT (Discard or Y/N)].
CASE "依頼非受託時"
;●When you saw only the contents and did not accept the request.
;- [L [you] politely declined
;-◆Dialogue
;W She looks disappointed.
;●内容だけ見て受託しなかった時
;【L ［あなた］は丁重にお断りした】
;【◆口上】
;【W ［彼女］は残念そうな顔をしている】
	IF K93_LOVE_LUST_LOVER()
		PRINTFORML 「That's okay, no need to worry about it.」
		PRINTFORML 「I can just ask %K93_HONORIFIC(63)% instead.」
	ELSE
		PRINTFORML 「Ah... I understand, and sorry for taking up your time with something like that.」
	ENDIF
CASE "依頼受託時"
;●When [you] accepted [her] request
;W [you] accepted [her] request
;- [◆Dialogue
;●依頼を受託した時
;【W ［あなた］は［彼女］の依頼を受けた】
;【◆口上】
	IF K93_LOVE_LUST_LOVER()
		PRINTFORML 「Fufufu! What a reliable %PRINT_MALE("man", MASTER)% you are!」
		PRINTFORML 「I'll make sure to reward you well. With material goods, of course.」
	ELSEIF K93_YEARNING_SEXFRIEND()
		PRINTFORML 「R-really? Thank you very much!」
		PRINTFORML 「I will make sure to have a reward ready for you.」
	ELSEIF K93_FRIENDSHIP()
		PRINTFORML 「Thank you, hearing you say that is a relief.」
		PRINTFORML 「I will be sure to reward you, even if we are friends.」
	ELSE
		PRINTFORML 「Thank you very much!」
		PRINTFORML 「I don't have much, but I will prepare a reward for you.」
	ENDIF
CASE "依頼確認時"
;●[366] When doing "Listen to Request" after accepting the request
;◆Dialogue
;-[Request Data Display].
;[INPUT (Discard or Y/N)].
;●[366]で依頼内容を依頼人に確認した時
;【◆口上】
;【依頼データ表示】
;【INPUT（破棄するかY/N）】
	PRINTFORML 「Are you having difficulties to complete what I asked?」
	PRINTFORML 「If you want, I wouldn't mind reminding you of what you're supposed to do.」
	SIF K93_LOVE_LUST_LOVER()
		PRINTFORML 「After all, that just means I get to see you more often... Fufufu～!」
CASE "依頼破棄時"
;When you cancel a request you have been entrusted with.
; [◆Dialogue].
; W I have discarded the request.
;●受託した依頼を破棄する時
;【◆口上】
;【W 依頼を破棄しました。】
	PRINTFORML 「That's okay, %K93_HONORIFIC(MASTER)%. I can just ask %K93_HONORIFIC(63)% instead.」
	IF RAND:2
		PRINTFORML 「If anything, I must thank you for telling me instead of just letting me wait until the deadline.」
	ELSE
		PRINTFORML 「If anything, I apologize for asking you something like that...」
	ENDIF
[SKIPSTART]
CASE "依頼実行直前"
;Threw this at deepl, and it's apparently deprecated?
;●[367]で依頼を実行する時、実行処理の前に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【◆口上】
;【実行時の地の文・ソース等】
;【▼下の口上に続く】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		
	ENDIF
CASE "依頼実行直後"
;So is this.
;●[367]で依頼を実行する時、実行処理の後に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【▲上の口上から続き】
;【◆口上】
;【達成時・CLIENT：▼下の口上に続く】
;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ENDIF
[SKIPEND]
CASE "成功報告時"
;Success
;When the request is completed and reported: Continued from the above dialogue.
;[◆Dialogue]
; [Obtaining a source, obtaining a reward such as an item, etc.].
;●報告時（成功）
;【依頼実行と報告が同時の時：▲上の口上から続き】
;【◆口上】
;【ソースの入手・アイテム等の報酬獲得】
	PRINTFORML 「Hoooah! Thank you so much, %K93_HONORIFIC(MASTER)%!」
	IF K93_LOVE_LUST_LOVER()
		PRINTFORML 「Here, I know what I said about a reward, but I think you deserve this, as well...」
		PRINTFORMDL %K93NICK()% wraps %HIS_HER(93, 0)% arms around your neck and plants a warm kiss on your cheek.
		PRINTFORML 「Chuuu～! There, I hope that was enough for you.」
		PRINTFORML 「...Unless you want one on the lips as well? Fufufu!」
	ELSE
		PRINTFORML 「Here is your reward, as promised. It's not much, but I hope it's enough.」
	ENDIF
CASE "失敗報告時"
;When a report is forgotten or expired, it is called up at the end of the encounter.
;(During the encounter) [Greetings, etc.] → [Good or Bad Mood] → [Detection of Inferiority] → [Holiday Event] → [◆Coco! (In addition, the date invitation will not occur if the request is judged to have failed.)
;◆Dialogue
;(If the request is judged as a failure, a date invitation will not occur)
; ○ Change of mood, additional penalties, etc. should be handled by the dialogue.
;○直接失敗報告は現在「06_誰か教えて！」のみ
;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
;【◆口上】
;○機嫌の変化や追加のペナルティ等は口上側で処理してください

;I don't think this is used anymore
CASE "依頼報告不要"
;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
;○地の文はありません
;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
	PRINTFORML 「You forgot about what I asked completely, haven't you?」
	IF K93_LOVE_LUST_LOVER()
		PRINTFORML 「Fwuuuh... I won't lie to you, that is quite the disappointment.」
		PRINTFORML 「But it's okay, I'm sure you will make up for it.」
		PRINTFORMDL %K93NICK()% says and flashes you a small, sincere smile.
	ELSE
		PRINTFORML 「Fwuuuh... It's okay, that's not a problem at all.」
		PRINTFORMDL %K93NICK()% says, looking visibly upset despite %HIS_HER(93, 0)% words.
	ENDIF
ENDSELECT
RETURN 1

;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;Help with cleaning
;==================================================
@M_KOJO_EN_IRAI_1_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時" ;when it's displayed
	IF K93_COHABITATION()
		PRINTFORML 「Our room could use a bit of a cleanup, don't you think?」
		PRINTFORML 「So not only do you will get a cleaner place, you also get a reward for it!」
	ELSEIF K93_YOUVISITWAGGY()
		PRINTFORML 「As you can see, my room is a bit of a mess.」
		PRINTFORML 「I would really appreciate if you helped me clean it...」
	ELSEIF K93_LIVINGINMISTYLAKE()
		PRINTFORML 「You see, I could use with a bit of help with cleaning my room.」
		PRINTFORML 「The lake is a bit too large, so having your help would be greatly appreciated.」
	ELSE
		PRINTFORML 「You see, there are quite a few places I can't reach with my body.」
		PRINTFORML 「And I could use a lot of help with cleaning out my water basin, too.」
	ENDIF
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時" ;when it's accepted
	IF !ITEM:避水の玉 && K93_LIVINGINMISTYLAKE() ;no water sphere and waggy still lives in the misty lake
		CALL K93_E_WATERSPHERERECEIVE(3)
		PRINTL
	ENDIF
	PRINTFORML 「Thank you. Shall we \@ K93_YOUVISITWAGGY() || K93_COHABITATION(1) ? begin # go \@ now? We have a lot of cleaning ahead of us.」
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
	IF YOGORE:(GET_CHARAHOME(93)) < 1000
	;先に掃除してしまっていた場合
	;【◆口上】
	;【W ［彼女］の部屋は十分にきれいだ】
	;【▼そのまま下の口上へ】
		PRINTFORML 「Oh! Did you clean it up already, by chance?」
		RETURN 1
	ELSE
	;一緒に掃除する場合
	;【◆口上】
	;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
	;【▼そのまま下の口上へ】
		IF K93_LIVINGINMISTYLAKE()
			PRINTFORML 「Dust isn't really a problem underwater.」
			PRINTFORML 「But I can assure you, it still gets dirty with other things.」
		ELSE
			IF RAND:2
				PRINTFORML 「Can you reach over that cupboard for me, %K93_HONORIFIC(MASTER)%?」
				PRINTFORML 「It must have gotten so dusty by now...」
			ELSE
				PRINTFORML 「I'm going to need you to swap the water in my basin.」
				PRINTFORML 「It's not that different from changing out bedsheets, now that I think about it.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	
	RETURN 0
CASE "成功報告時"
;報酬：低級素材
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	
	RETURN 0
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

