;依頼口上・一般依頼06：誰か教えて！
;Answer my question
;==================================================

@M_KOJO_EN_IRAI_6_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF CFLAG:93:K93EN_SEEWORLD >= 9
			PRINTFORML 「나를 온갖 곳에 데려다줬는데도 아직 모르는 게 꽤 많네.」
			PRINTFORML 「오히려 그렇게 많은 새로운 것들을 본 덕분에 더 궁금해졌어.」
			PRINTFORML 「그래서, 혹시 괜찮다면 내 질문 몇 가지에 답해줄 수 있을까?」
		ELSE
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 나는 세상에 대해 여러 가지 의문을 가져왔는데...」
			PRINTFORML 「그리고 그 점을 물어볼 만한 사람 중 당신이 내가 아는 최고의 인물일지도 모른다고 생각합니다!」
			PRINTFORML 「그래서, 제가 가진 이 질문에 대답해 주실 수 있을까요?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			PRINTFORML 「한 곳에 이렇게 많은 지식이 있다니...!」
			PRINTFORML 「정보를 찾기에 더 좋은 곳은 없군.」
			RETURN 1
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			PRINTFORML 「오, 음... 정말 그런 걸 묻는 건가요?」
			PRINTFORML 「이런 것을 나에게 기대한다는 것은 조금 영광적이네요...」
			PRINTFORML 「실망시키지 않도록 최선을 다하겠습니다, %K93_HONORIFIC(MASTER)%님!」
			PRINTFORMDL %K93NICK()%'의 눈에 결의가 빛났다.
			RETURN 1
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORML 「그래서, 뭐라도 찾았어?」
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					PRINTFORML 「그것이 당신에게 도움이 되었기를 진심으로 바랍니다.」
					RETURN 1
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				PRINTFORML 「%K93_HONORIFIC(MASTER)%님, 정말 그게 답인가요?」
				PRINTFORML 「후아아...! 제가 그걸 얻을 수 있을 거라고는 상상도 못 했어요!」
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				PRINTFORML 「미안하게도, 그게 정답인 것 같지는 않네요...」
				PRINTFORML 「하지만 괜찮아, 아무도 모든 걸 다 알 수는 없잖아!」
				PRINTFORML 「그리고 게다가, 내가 가장 예상치 못할 때 답이 떠오리리라 확신해.」
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
