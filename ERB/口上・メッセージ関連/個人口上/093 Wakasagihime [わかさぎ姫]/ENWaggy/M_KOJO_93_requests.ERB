CASE "依頼非受託時"

	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	PRINTFORML 「Someone asked you to defeat me in a danmaku duel, is that it?」
;○この依頼では討伐される側の口上です
	IF CANNOT_DANMAKU() == 1
	;屋内のとき（勝負できない）
	;【◆口上】
	;【W 屋外で挑もう…】
		PRINTFORML 「Then... aren't things like that done outside?」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 2
	;仕事中（勝負できない）
	;【◆口上】
	;【W お取り込み中だ…】
		;waggy can't work
		RETURN 0
	ELSEIF GROUPMATCH(CANNOT_DANMAKU(), 3, 5)
	;あなたが疲労中（勝負できない）
	;【◆口上】
	;【W 今は疲れている…】
		PRINTFORML 「%K93_HONORIFIC(MASTER)%, I understand that you have a job to do, but you should rest first...」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 4
	;口上主が疲労竜（勝負できない）
	;【◆口上】
	;【W 今挑むのはフェアじゃない…】
		PRINTFORML 「Fwuuuh... I understand that you have a job to do, but I'm a bit tired.」
		PRINTFORML 「Could we just leave this to another time?」
		RETURN 1
	;ELSEIF CANNOT_DANMAKU() == 5 ;merged with 3
	;既に今日一度弾幕勝負をしている（勝負できない）
	;【◆口上】
	;【W 今日はもう挑めない…】
		;RETURN 0
	ELSE
	;【◆口上】
	;【W 勝負開始！！】
	;【以降はそのまま弾幕口上が呼ばれます】
		PRINTFORML 「Fwuuuh... I somehow don't understand why someone would do that.」
		IF ABL:93:戦闘能力 >= 4 ;combat ability
			PRINTFORML 「But if there is no way around it then, it's better that we put on a good show.」
			PRINTFORML 「I have learned quite a lot from you, %K93_HONORIFIC(MASTER)%!」
		ELSE
			PRINTFORML 「Are you sure we can't just talk it over some tea?」
			PRINTFORML 「If I could, I would just surrender so you can complete your job...」
			PRINTFORML 「But if there is no other way to do it, then let do our best.」
		ENDIF
		CALLF FIRSTTIME("WaggyDanmakuDuel")
		RETURN 1
	ENDIF
	;【▼そのまま下の口上へ】
CASE "依頼実行直後"
;○この依頼では討伐される側の口上です
	IF CFLAG:CLIENT_ID:依頼状況 == 2
		IF CANNOT_DANMAKU() == 0
			;負け犬
			;【▲上の口上から続き】
			;【L ［彼女］の討伐に失敗した……】
			;【W ……こうなったら後日出直すしかない】
			;【◆口上】
			PRINTFORML 「%K93_HONORIFIC(MASTER)%! Are you okay?!」
			PRINTFORML 「Oh my, I didn't expect to win that at all...」
			PRINTL
			PRINTFORMDL %K93NICK()% lets out a sigh of relief when you get up.
			RETURN 1
		ELSE
			;挑めなかった場合
			;【▲上の口上から続き】
			;【◆口上】
			RETURN 0
		ENDIF
	ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
	;勝利
	;【▲上の口上から続き】
	;【W ［彼女］を懲らしめた！】
	;【◆口上】
		PRINTFORML 「%K93_HONORIFIC(MASTER)%... were you going easy on me?」
		PRINTFORML 「No, don't answer that. Go and get your reward, I will be fine.」
		RETURN 1
	ENDIF
CASE "成功報告時"
;報酬：賞金（時価）
	
	RETURN 0
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

