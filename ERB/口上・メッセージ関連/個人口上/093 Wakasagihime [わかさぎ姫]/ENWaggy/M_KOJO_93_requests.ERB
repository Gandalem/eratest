SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		PRINTFORML 「누군가 나를 단막(弾幕) 결투로 쓰러뜨리라고 부탁했나?」
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			PRINTFORML 「그럼... 그런 일은 밖에 하는 거 아니었어?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			;waggy can't work
			RETURN 0
		ELSEIF GROUPMATCH(CANNOT_DANMAKU(), 3, 5)
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 하실 일이 있으신 건 알겠지만 먼저 좀 쉬시는 게 좋을 겁니다...」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			PRINTFORML 「후우... 할 일이 있다는 건 알겠는데, 좀 피곤하네요.」
			PRINTFORML 「다음에 하는 게 어떨까요?」
			RETURN 1
			;ELSEIF CANNOT_DANMAKU() == 5 ;merged with 3
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			;RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			PRINTFORML 「후우... 대체 누가 그런 짓을 할지 이해가 안 간다.」
			IF ABL:93:戦闘能力 >= 4 ;combat ability
				PRINTFORML 「하지만 방법이 없다면 좋은 볼거리를 보여주는 게 나을 거야.」
				PRINTFORML 「당신에게서 많은 것을 배웠어, %K93_HONORIFIC(MASTER)%!」
			ELSE
				PRINTFORML 「차 한 잔 하면서 이야기하는 건 안 될까요?」
				PRINTFORML 「그럴 수 있다면, 당신이 임무를 완수하도록 그냥 항복할 텐데...」
				PRINTFORML 「하지만 달리 방법이 없다면, 최선을 다합시다.」
			ENDIF
			CALLF FIRSTTIME("WaggyDanmakuDuel")
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORML 「%K93_HONORIFIC(MASTER)%님! 괜찮으세요?!」
				PRINTFORML 「오호라, 전혀 이길 줄 몰랐는데...」
				PRINTL
				PRINTFORMDL %K93NICK()%은(는) 당신이 일어났을 때 안도의 한숨을 내쉰다.
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			PRINTFORML 「%K93_HONORIFIC(MASTER)%님... 나한테 봐준 거야?」
			PRINTFORML 「아니, 그건 대답하지 마. 가서 보상을 받아, 난 괜찮으니까.」
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
