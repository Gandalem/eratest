; Modular ERB: 個人口上/093 Wakasagihime [わかさぎ姫]/ENWaggy/M_KOJO_93_requests.ERB
;==================================================
;Common Request Dialogue
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_EN_IRAI_K93(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
;The character making the request
#DIMS SCENE    ;セリフの表示されるタイミング
;When the dialogue appears
#DIM  IRAI_ID  ;依頼自体のID
;The request ID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;The requestee's ID
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
;The request type ID (cut some wood, water my flowers, etc.)
#DIMS IRAI_NAME;依頼名
;The name of the request
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_EN_IRAI_%IRAI_NAME%_K93(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_EN_IRAI_{CHK_ID}_K93(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;Here is the common opening statement for each request.
;If you display the common comments for each request, the common comments will not be displayed.
;The items circled by [ ] are the background sentences before and after the opening remarks and the processing that takes place.
;Please use this as a guideline for whether to WAIT or not (L and W stand for PRINTFORML and PRINTFORMW, respectively).
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		; ●When a request is made to you.
		; [w It seems that [she] has a favor to ask of [you].
		;-◆Dialogue
		; [Request Data Display].
		; [INPUT (Do you accept the request? Y/N)].
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「%K93_HONORIFIC(MASTER)%님, 저에게 부탁드릴 것이 있습니다.」
			PRINTFORML 「도와주시겠어요?」
		ELSEIF K93_YEARNING_SEXFRIEND()
			PRINTFORML 「오! 음... %K93_HONORIFIC(MASTER)%님, 저 좀 도와주시겠어요?」
		ELSE
			PRINTFORML 「%K93_HONORIFIC(MASTER)%님, 폐가 될지 모르겠습니다만, 도움을 청하고 싶은 일이 있습니다...」
		ENDIF
		;●[366] When doing "Listen to Request" after accepting the request
		;◆Dialogue
		;-[Request Data Display].
		;[INPUT (Discard or Y/N)].
	CASE "依頼非受託時"
		;●When you saw only the contents and did not accept the request.
		;- [L [you] politely declined
		;-◆Dialogue
		;W She looks disappointed.
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「괜찮아, 걱정할 필요 없어.」
			PRINTFORML 「대신 %K93_HONORIFIC(63)%에게 물어볼게.」
		ELSE
			PRINTFORML 「아... 이해했습니다. 그리고 그런 일로 시간을 내게 해 드려 죄송합니다.」
		ENDIF
	CASE "依頼受託時"
		;●When [you] accepted [her] request
		;W [you] accepted [her] request
		;- [◆Dialogue
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「후후후! 정말 믿음직한 %PRINT_MALE("man", MASTER)%로군!」
			PRINTFORML 「잘 보답해 주도록 할게. 물론 물건으로 말이야.」
		ELSEIF K93_YEARNING_SEXFRIEND()
			PRINTFORML 「정말? 정말 고마워요!」
			PRINTFORML 「보상 준비해 둘게요.」
		ELSEIF K93_FRIENDSHIP()
			PRINTFORML 「그렇게 말해줘서 고맙다. 마음이 놓인다.」
			PRINTFORML 「친구 사이일지라도 반드시 보답할 것이다.」
		ELSE
			PRINTFORML 「정말 감사합니다!」
			PRINTFORML 「많은 건 없지만 보상을 준비하겠어요.」
		ENDIF
	CASE "依頼確認時"
		;●[366] When doing "Listen to Request" after accepting the request
		;◆Dialogue
		;-[Request Data Display].
		;[INPUT (Discard or Y/N)].
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		PRINTFORML 「내가 부탁한 것을 완료하는 데 어려움이 있나?」
		PRINTFORML 「원한다면, 네가 해야 할 일을 상기시켜 줄 수도 있어.」
		SIF K93_LOVE_LUST_LOVER()
			PRINTFORML 「결국 그건 내가 당신을 더 자주 볼 수 있다는 뜻이니까... 후후후~!」
	CASE "依頼破棄時"
		;When you cancel a request you have been entrusted with.
		; [◆Dialogue].
		; W I have discarded the request.
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		PRINTFORML 「괜찮아요, %K93_HONORIFIC(MASTER)%님. 대신 %K93_HONORIFIC(63)%께 부탁드려도 돼요.」
		IF RAND:2
			PRINTFORML 「차라리 마감일까지 기다리게 두는 것보다는 나에게 알려줘서 고맙다고 해야겠어.」
		ELSE
			PRINTFORML 「차라리 제가 그런 것을 여쭤본 점 사과드립니다...」
		ENDIF
	CASE "成功報告時"
		;Success
		;When the request is completed and reported: Continued from the above dialogue.
		;[◆Dialogue]
		; [Obtaining a source, obtaining a reward such as an item, etc.].
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		PRINTFORML 「후우하! 정말 감사합니다, %K93_HONORIFIC(MASTER)%!」
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「여기, 보상에 대해 내가 했던 말을 알고 있지만, 당신도 이것을 받을 자격이 있다고 생각해요...」
			PRINTFORMDL %K93NICK()%은(는) %HIS_HER(93, 0)%의 팔로 당신의 목을 감싸고 당신의 뺨에 따뜻한 키스를 남긴다.
			PRINTFORML 「츄우~! 자, 이걸로 충분했으면 좋겠네요.」
			PRINTFORML 「...혹은 입술에도 하나 원하세요? 후후후!」
		ELSE
			PRINTFORML 「약속한 보상이다. 별거 아니지만 충분하길 바란다.」
		ENDIF
	CASE "失敗報告時"
		;When a report is forgotten or expired, it is called up at the end of the encounter.
		;(During the encounter) [Greetings, etc.] → [Good or Bad Mood] → [Detection of Inferiority] → [Holiday Event] → [◆Coco! (In addition, the date invitation will not occur if the request is judged to have failed.)
		;◆Dialogue
		;(If the request is judged as a failure, a date invitation will not occur)
		; ○ Change of mood, additional penalties, etc. should be handled by the dialogue.
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
		;I don't think this is used anymore
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
		PRINTFORML 「내가 부탁한 걸 완전히 잊어버렸지, 그렇지 않아?」
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「후우... 거짓말은 안 하겠어, 그거 정말 실망이네.」
			PRINTFORML 「하지만 괜찮아, 분명 만회할 수 있을 거야.」
			PRINTFORMDL %K93NICK()%이/가 말하며 작고 진심 어린 미소를 너에게 보여준다.
		ELSE
			PRINTFORML 「후우... 괜찮아, 전혀 문제 아니야.」
			PRINTFORMDL %K93NICK()%은(는) %HIS_HER(93, 0)%의 말에도 눈에 띄게 상심한 표정으로 말한다.
		ENDIF
ENDSELECT
RETURN 1
;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;Help with cleaning
;==================================================

@M_KOJO_EN_IRAI_1_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時" ;when it's displayed
		IF K93_COHABITATION()
			PRINTFORML 「우리 방 좀 청소해야 할 것 같지 않아?」
			PRINTFORML 「그러니까 더 깨끗한 곳을 얻을 뿐만 아니라 그에 대한 보상도 받을 수 있어!」
		ELSEIF K93_YOUVISITWAGGY()
			PRINTFORML 「보시다시피, 제 방은 좀 어수선하네요.」
			PRINTFORML 「제가 청소하는 것을 도와주신다면 정말 감사하겠습니다...」
		ELSEIF K93_LIVINGINMISTYLAKE()
			PRINTFORML 「보시다시피, 방 청소에 약간의 도움이 필요해요.」
			PRINTFORML 「호수가 좀 너무 넓어서 당신의 도움을 받으면 정말 감사하겠습니다.」
		ELSE
			PRINTFORML 「보시다시피, 제 몸으로는 도달할 수 없는 곳이 꽤 있습니다.」
			PRINTFORML 「그리고 물그릇을 비우는 데도 많은 도움이 필요합니다.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時" ;when it's accepted
		IF !ITEM:避水の玉 && K93_LIVINGINMISTYLAKE() ;no water sphere and waggy still lives in the misty lake
			CALL K93_E_WATERSPHERERECEIVE(3)
			PRINTL
		ENDIF
		PRINTFORML 「감사합니다. 이제 시작할까요? \@ K93_YOUVISITWAGGY() || K93_COHABITATION(1) ? 시작할까 # 가자 \@ 이제 시작할까요 우리가 할 청소가 많아요」
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(93)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			PRINTFORML 「어머! 혹시 이미 치워 놓았니?」
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			IF K93_LIVINGINMISTYLAKE()
				PRINTFORML 「먼지는 물속에서는 정말 문제가 되지 않아.」
				PRINTFORML 「하지만 다른 것들로도 여전히 더러워질 수 있다고 확신할 수 있어.」
			ELSE
				IF RAND:2
					PRINTFORML 「저 찬장 위로 좀 꺼내 줄 수 있겠어, %K93_HONORIFIC(MASTER)%?」
					PRINTFORML 「벌써 그렇게 먼지가 쌓였을 거야...」
				ELSE
					PRINTFORML 「내 대야의 물을 갈아줘야 할 것 같아.」
					PRINTFORML 「생각해보니 침대 시를 갈아주는 거랑 별반 다르지 않네.」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼02：お花に水をあげて
;Watering flowers
;==================================================

@M_KOJO_EN_IRAI_2_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF K93_LIVINGINMISTYLAKE()
			PRINTFORML 「"물 주기"가 이 상황에 맞는 단어는 아닐지도 모르겠지만, 그래도 말이야.」
			PRINTFORML 「호수에 있는 몇 가지 수중 식물을 돌려 주었으면 해.」
		ELSE
			PRINTFORML 「나 자신처럼 물을 주어야 살아남는 식물들이 몇 가지 있어.」
			PRINTFORML 「너에게는 충분히 쉬운 일일 거야...」
		ENDIF
		PRINTFORML 「나를 위해 그것을 해 줄 수 있겠어?」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;【◆口上】
		;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
		;【▼そのまま下の口上へ】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			;この場合はそのまま下の口上へ続きます
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
