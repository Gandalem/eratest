@M_KOJO_EN_IRAI_8_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM RECIPIENT
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;LOCAL = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容)) ;careful where you put this, game only generates a target after you accept a request, no target when you use this = crash
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「%K93_HONORIFIC(MASTER)%께, 부탁 하나 드려도 될까요...」
		PRINTFORML 「이 편지를 대신 전달해 주시겠어요?」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORML 「후우... 그냥 %K93_HONORIFIC(K93_RANDVAL(63, 73))%에게 부탁해야겠어...」
		RETURN 1
	CASE "依頼受託時"
		RECIPIENT = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		PRINTFORML 「정말? 정말 고마워, %K93_HONORIFIC(MASTER)%!」
		IF IS_HERE(RECIPIENT)
			PRINTFORML 「%HE_SHE(RECIPIENT, 0)%가 바로 저기 있다는 건 알지만, 편지를 쓰는 데는 다른 점이 있거든.」
		ELSEIF GROUPMATCH(RECIPIENT, 63, 73) ;seki or kagerou
			PRINTFORML 「%HIM_HER(RECIPIENT, 0)%에게 그냥 말할 수도 있었지만, 이번에는 편지를 써보고 싶었다.」
		ELSEIF K93_WAGGYKNOWS(RECIPIENT)
			PRINTFORML 「%HE_SHE(RECIPIENT, 0)%가 잘 지내는지 궁금했어...」
			PRINTFORML 「그걸 알기엔 편지 말고 뭐가 더 좋을까?」
		ELSE
			PRINTFORML 「이게 누군가와 우정을 쌓기 위해 시도해 볼 만한 좋은 방법일지도 모른다고 생각해.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		PRINTFORML 「괜찮아, 내가 방법을 찾아야 할 것 같아.」
		PRINTFORML 「하지만 그전에 내 편지를 돌려받아야 하니, 실례가 안 된다면...」
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼では手紙を渡される側の口上です
		;【◆口上】
		;【W ［あなた］は［彼女］に預かっていた手紙を渡した】
		;【▼そのまま下の口上へ】
		PRINTFORML 「이것은 %K93_HONORIFIC(CLIENT_ID)%로부터 온 편지라고, 말인가?」
		IF IS_HERE(RECIPIENT)
			PRINTFORMDL %K93NICK()%이(가) %CALLNAME:CLIENT_ID%에게 짧게 미소를 짓는다.
		ELSE
			PRINTFORMDL %K93NICK()%은(는) 웃으며 %HE_SHE(93, 0)%이 편지를 연다.
		ENDIF
		PRINTFORML 「이것에 감사드립니다, %K93_HONORIFIC(MASTER)%.」
		PRINTFORML 「다음에 보실 때 %HIM_HER(CLIENT_ID, 0)%에게 제 안부를 전해주세요.」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		RETURN 0
	CASE "成功報告時"
		;報酬：素材4つ
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
