;==================================================
;依頼口上・一般依頼04：料理上手になりたい
;Teach me how to cook
;==================================================
@M_KOJO_EN_IRAI_4_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「What I want to do is... I want to learn how to cook better.」
	IF ABL:MASTER:料理技能 >= 4
		PRINTFORML 「And I really can't think of anyone better to teach me!」
	ELSE
		PRINTFORML 「You are a better cook than me, so I was wondering if you could teach me what you know.」
	ENDIF
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	PRINTFORML 「Thank you, %K93_HONORIFIC(MASTER)%. Maybe you will get to eat whatever we cook together.」
	IF KITCHEN(CFLAG:MASTER:現在位置)
		PRINTFORML 「Now, shall we begin? I suppose that stove will do just fine.」
	ELSE
		PRINTFORML 「But for now, we need to find a stove that we can use...」
	ENDIF
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
;【◆口上】
;【L ［あなた］は［彼女］と一緒に料理をした】
;【W ［料理名］を作ります】
;【▼そのまま下の口上へ】
	SELECTCASE ABL:93:料理技能
	CASE IS >= 4
		PRINTFORML 「I have been getting better and better at this, haven't I?」
		PRINTFORML 「Fufufu... I think we will be done in no time, %K93_HONORIFIC(MASTER)%.」
	CASE IS  >= 2
		PRINTFORML 「There still so much to learn, and so much to cook...」
		PRINTFORML 「But I have been feeling myself getting better and better!」
	CASEELSE
		PRINTFORML 「O-oh, is this not how you're supposed to do that?」
		PRINTFORML 「Fwuuuh... Hopefully we can still fix it.」
	ENDSELECT
	RETURN 1
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	SELECTCASE ABL:93:料理技能
	CASE IS >= 4
		PRINTFORML 「Fufufu! It came out looking great, didn't it?」
		PRINTFORML 「Please, go ahead and take a bite.」
		PRINTFORML 「This would not have been possible without your help, so you deserve it!」
	CASE IS  >= 2
		PRINTFORML 「There still a lot to improve, but our dish came out looking good!」
		PRINTFORML 「Feel free to grab a bite if you want.」
	CASEELSE
		PRINTFORML 「It came out looking just fine, but I'm not really sure...」
		PRINTFORML 「I wouldn't blame you for not wanting to eat this.」
	ENDSELECT
	PRINTL
	RETURN 1
CASE "成功報告時"
;報酬：\500
