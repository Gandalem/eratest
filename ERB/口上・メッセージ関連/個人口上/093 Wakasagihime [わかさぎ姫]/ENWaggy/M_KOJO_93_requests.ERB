;==================================================
;依頼口上・一般依頼15_あなたに抱かれたい
;Have sex with me, can she even get this? maybedo come back to this
;==================================================
@M_KOJO_EN_IRAI_15_93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「%K93_HONORIFIC(MASTER)%, I need you to... I need... something from you.」
	PRINTFORMDL %K93NICK()% goes silent for a few seconds before taking a deep breath.
	PRINTFORML 「Fwuuuh...! I want to... I need to have s-sex with you!」
	PRINTFORML 「I know that you might not want it, so I saved a bit of money for this.」
	PRINTFORML 「This is something that people do for these things, after all...」
	PRINTFORML 「B-but please, don't feel pressured... If you don't want to do it, I can make do just fine.」
	RETURN 1
CASE "依頼非受託時"
	PRINTFORML 「That's okay, it's your decision to make.」
	PRINTFORML 「And... I apologize for even making such an offer.」
	PRINTFORMDL %K93NICK()% whispers, %HIS_HER(93, 0)% voice overcast with sadness.
	RETURN 1
CASE "依頼受託時"
	PRINTFORMDL %K93NICK()% closes %HIS_HER(93, 0)% eyes and takes a deep breath.
	PRINTFORML 「Fwuuuh... Thank you, %K93_HONORIFIC(MASTER)%.」
	PRINTFORML 「W-we should get on with it, before I regret this...」
	RETURN 1
CASE "依頼確認時"
	PRINTFORML 「I think I'm ready to start now.」
	PRINTFORML 「J-just please, be gentle with me...」
	RETURN 1
CASE "依頼破棄時"
	PRINTFORML 「Oh, you want to... give up on it?」
	PRINTFORML 「That's okay, I was just thinking of doing the same myself...」
	PRINTFORMDL %K93NICK()% lets out a deep sigh of relief.
	RETURN 1
CASE "依頼実行直前"
	LOCAL:99 = IS_DOUTEI(MASTER)
	RETURN 1
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	
	RETURN 1
CASE "成功報告時"
;報酬：低級素材
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	PRINTFORML 「That was... nice, wasn't it?」
	IF LOCAL:99
		PRINTFORML 「Although, I must apologize for taking your first time like this...」
	ELSE
		PRINTFORML 「M-maybe we could do this again some other time?」
	ENDIF
	RETURN 1
CASE "失敗報告時"
	PRINTFORML 「W-when we were about to do the thing, did you just run away?」
	PRINTFORML 「To be completely honest, I was just about to do the same, too...」
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼16：お悩み相談
;Listen to me vent
;==================================================
@M_KOJO_EN_IRAI_16_K93(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「I've been thinking about a few things... but no matter what, I can't come to a conclusion!」
	PRINTFORML 「So would it be a problem for you to give me your opinion?」
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	
	RETURN 0
CASE "依頼実行直後"
	IF TFLAG:193 == 1
		;正解の選択肢
		PRINTFORML 「Fwaaah... That is a weight off my mind!」
		PRINTFORML 「Thank you, %K93_HONORIFIC(MASTER)%.」
	ELSEIF TFLAG:193 == 2
		;ハズレの選択肢だったが逆に正解
		PRINTFORML 「You know, I was really close to throwing out that option altogether...」
		PRINTFORML 「But I will trust you on this one, %K93_HONORIFIC(MASTER)%!」
	ELSEIF TFLAG:193 == -1
		;ハズレの選択肢
		PRINTFORML 「No, I don't think that's quite it...」
		PRINTFORML 「Back to thinking it over I go, I suppose.」
	ELSEIF TFLAG:193 == -2
		;正解の選択肢だったが逆にハズレ
		PRINTFORML 「Fwuuuh... Somehow, that only made me even more indecisive.」
	ENDIF
	RETURN 1
CASE "成功報告時"
;報酬：野菜か果物
	PRINTFORML 「Here, you can have this for being such a good listener.」
	RETURN 1
CASE "失敗報告時"
	PRINTFORML 「...But thank you for at least trying to help, %K93_HONORIFIC(MASTER)%.」
	PRINTFORMDL %K93NICK()% seems to be a bit upset, despite %HIS_HER(93, 0)% words of gratitude.
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
CASE "口上委託率"
;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
	RESULT:100 = 0

;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
	RESULT:1 = 0
	RESULT:2 = 0
	RETURN 1
CASE "口上専用"
;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
;16,お悩み相談 の場合
;RESULT        発生判定,0だと発生しません
;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
;RESULTS:0     お悩み文章（自動で『』で囲まれます）
;RESULTS:1～3  選択肢１～３
;何も発生しない状態になると無限ループになるので注意してください
;●追記メモ
;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
;RESULT:1を7にするとどれも正解になります
;RESULT:1を8にするとどれもハズレになります
;1～3以外の場合は逆張り判定が自動で無くなります
	RESULT = 0

;▼サンプル
[SKIPSTART]
	SELECTCASE RAND:5
	CASE 0
		;このお悩みは、恋慕で発生し、親密によって正解が変わります
		SIF TALENT:恋慕
			RESULT = 1
		RESULTS:0 = 赤ちゃん作るなら何人がいいかな？
		RESULTS:1 = ５人でバスケチームを作ろう
		RESULTS:2 = ９人で野球チームを作ろう
		RESULTS:3 = １１人でサッカーチームを作ろう
		IF ABL:親密 >= 100
			RESULT:1 = 3
		ELSEIF ABL:親密 >= 20
			RESULT:1 = 2
		ELSE
			RESULT:1 = 1
		ENDIF
	CASE 1
		;このお悩みは、無条件で発生し、正解は絶対に2番で固定化されます
		SIF 1
			RESULT = 1
		RESULTS:0 = どのジョブがいいかな？
		RESULTS:1 = かっこいしナイト
		RESULTS:2 = シーフが便利だよ
		RESULTS:3 = 青魔道士最強！
		RESULT:1 = 2
		RESULT:2 = 1
	CASE 2
		;このお悩みは、夏の月に発生し、正解がランダムで変わります
		SIF DAY:2 == 2
			RESULT = 1
		RESULTS:0 = どの水着を買おうかな？
		RESULTS:1 = かわいいワンピース
		RESULTS:2 = クールなセパレート
		RESULTS:3 = 色っぽいビキニ
		RESULT:1 = RAND:3 + 1
	CASE 3
		;このお悩みは、無条件で発生し、1番と3番が正解になります（5 - 3 = 2番がハズレになります）
		SIF 1
			RESULT = 1
		RESULTS:0 = ワンちゃんの名前は何にしよう？
		RESULTS:1 = ボロンゴ
		RESULTS:2 = ゲレゲレ
		RESULTS:3 = プックル
		RESULT:1 = 5
	CASE 4
		;このお悩みは、無条件で発生し、どれを選んでも正解になります
		SIF 1
			RESULT = 1
		RESULTS:0 = 夕飯は何がいい？
		RESULTS:1 = 肉じゃが
		RESULTS:2 = コロッケ
		RESULTS:3 = 焼き魚
		RESULT:1 = 7
	ENDSELECT
[SKIPEND]

	SIF !RESULT
		RESTART
	RETURN 1
ENDSELECT

