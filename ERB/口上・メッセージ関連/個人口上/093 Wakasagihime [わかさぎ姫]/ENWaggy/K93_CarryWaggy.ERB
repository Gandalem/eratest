@K93_CarryWaggy
CALL M_KOJO_EN_COLOR_K93

IF !SHIRAHU(93)
	PRINTFORMDL You look at %K93NICK()%, and start to think on how you should carry %HIM_HER(93, 0)% around.
	IF K93_MAD()
		PRINTFORMDW But you don't think %HE_SHE(93, 0)% would accept whatever you have in mind...
		RETURN 1
	ENDIF

	IF FIRSTTIME("WaggyCarrySet", 0, 93)
		PRINTL
		CALL K93_CarryExplanation
		PRINTW
	ENDIF

	CALL K93_CarryChoice
	SELECTCASE RESULT
	CASE 0
		IF GET_MAPID(CFLAG:MASTER:現在位置) == 2
			PRINTFORMDW Carrying %HIM_HER(93, 0)% in the open while in the Human Village might not be a good idea...
		ELSE
			CFLAG:93:K93EN_WAGGYCARRY = 0
			PRINTFORMDW You decide to carry %HIM_HER(93, 0)% in your arms. 
		ENDIF
	CASE 1
		CFLAG:93:K93EN_WAGGYCARRY = 1
		PRINTFORMDW You decide to push %HIM_HER(93, 0)% around in a wheelchair.
	CASE 2
		IF GET_MAPID(CFLAG:MASTER:現在位置) == 2
			PRINTFORMDW Having %HIM_HER(93, 0)% openly use %HIS_HER(93, 0)% [Mystery Bubbles] while in the Human Village might not be a good idea...
		ELSE
			PRINTFORMDW You decide to let %HIM_HER(93, 0)% use %HIS_HER(93, 0)% [Mystery Bubbles] to move by your side.
		ENDIF
	CASE 3
		PRINTFORMDW You decide that things are fine as they are.
	ENDSELECT
ELSE
	IF K93_MAD()
		PRINTFORML 「You want to lead me around in a different manner? I must refuse.」
		PRINTFORM 「I would rather
		IF GETBIT(FLAG:プール, 3) && GET_MAPID(CFLAG:MASTER:現在位置) != 2
			PRINTFORMW  make use of the [Mystery Bubbles], they're more trustworthy.」
		ELSE
			PRINTFORMW  roll myself around, and not rely on you again.」
		ENDIF
		RETURN 1
	ENDIF

	[SKIPSTART]
	IF GET_MAPID(CFLAG:MASTER:現在位置) == 2 && CFLAG:93:K93EN_WAGGYCARRY != 1
		PRINTFORML 「You wish to carry me around?」
		PRINTFORML 「I don't think doing that in the Human Village would be a good idea...」
		PRINTFORMW 「But I appreciate your intent, %K93_HONORIFIC(MASTER)%.」
		RETURN 1
	ENDIF
	[SKIPEND]

	IF FIRSTTIME("WaggyCarrySet", 0, 93)
		PRINTFORML 「You wish to take me somewhere, is that it?」
		PRINTFORMW 「I wouldn't mind that at all, %K93_HONORIFIC(MASTER)%!」
		PRINTFORMW 「There's a wheelchair that %K93_HONORIFIC(63)% uses to push me around.」
		IF GETBIT(FLAG:プール, 3) ;has bubble
			PRINTFORMW 「But thanks to the gift you have given me, I can walk by your side on my own!」
			PRINTFORMDL %K93NICK()% blushes profusely, looking away before speaking again.
			PRINTFORMW 「Yet, I also wouldn't mind if you were to still carry me in your arms...」
		ELSE
			PRINTFORML 「But if you wouldn't mind the weight...」
			;there used to be a slight fall state variation here, it's gone now
			PRINTFORMDL %K93NICK()% blushes profusely, looking away before speaking again.
			PRINTFORMW 「Then you may carry me in your arms, if you wish to do so.」
		ENDIF
		PRINTL
		PRINTFORMW 「At the end of the day, it's up to you.」
		PRINTFORML 「So... what will it be?」
		PRINTL
		CALL K93_CarryExplanation
		WAIT
	ELSE
		PRINTFORML 「You wish to lead me around in a different %SPLIT_G("way:manner")%?」
		PRINTDATAL
			DATAFORM 「It's not because I have gotten heavier, is it?」
			DATAFORM 「Then, what do you have in mind?」
			DATAFORM 「That's okay for me, %K93_HONORIFIC(MASTER)%.」
		ENDDATA
	ENDIF
	PRINTL
	CALL K93_CarryChoice
	SELECTCASE RESULT
	CASE 0
		CFLAG:93:K93EN_WAGGYCARRY = 0
		SIF GET_MAPID(CFLAG:MASTER:現在位置) == 2
			GOTO CARRYBUBBLEREJECT
		IF K93_LOVE_LUST_LOVER()
			PRINTFORMW 「Fufufu... having you carry me around makes me feel like a proper princess～!」
		ELSE
			PRINTFORML 「Having you carry me around like that is a bit intimate.」
			PRINTFORMW 「But pay me no mind, that's fine with me as well.」
		ENDIF
	CASE 1
		CFLAG:93:K93EN_WAGGYCARRY = 1
		SIF GETBIT(FLAG:プール, 3)
			PRINTFORMW 「Even though I can move on my own accord?」
		IF K93_LOVE_LUST_LOVER()
			IF !RAND:20 && GETBIT(FLAG:プール, 3) ;very small chance
				PRINTFORMDL %K93NICK()% eyes you with a playful, yet mischievous smile.
				PRINTFORMW 「Fuhuhu... If I didn't know you any better, I would think you have a thing for wheelchairs～」
			ELSE
				PRINTFORMW 「It's fine with me, having you push me around is kind of romantic as well.」
			ENDIF
		ELSE
			PRINTFORMW 「The wheelchair? I don't see a problem in that, %K93_HONORIFIC(MASTER)%.」
		ENDIF
	CASE 2
		CFLAG:93:K93EN_WAGGYCARRY = 2
		SIF GET_MAPID(CFLAG:MASTER:現在位置) == 2
			GOTO CARRYBUBBLEREJECT
		PRINTFORML 「Walking by your side makes me feel like I am truly an equal to you...」
		IF K93_LOVE_LUST_LOVER()
			PRINTFORMW 「Just as two people madly in love with each other should.」
		ELSE
			PRINTFORMW 「Just as friends should be with one another.」
		ENDIF
	CASE 3
		PRINTFORML 「Hmmmm? You changed your mind?」
		PRINTFORMW 「That's okay, I'm fine with things as they are.」
	ENDSELECT
ENDIF
RETURN 1

$CARRYBUBBLEREJECT
IF CFLAG:93:K93EN_WAGGYCARRY == 0
	PRINTFORML 「You wish to carry me around?」
ELSE
	PRINTFORML 「You wish for me to use the [Mystery Bubbles]?」
ENDIF
PRINTFORMW 「I don't think doing that in the Human Village would be a good idea...」
PRINTFORML 「But I appreciate your intent, %K93_HONORIFIC(MASTER)%.」
PRINTFORMW 「Maybe we can do that when we are no longer here.」
RETURN 1

@K93_CarryExplanation
IF VAR_OR_DEFAULT("nSpoilerMode")
	PRINTFORMDL ※ [Princess Carry] will earn you extra Favor and Trust during dates at a slight [Sta] cost.
	PRINTFORMDL ※ [Wheelchair Pushing] will not earn any extra Favor or Trust, but will cost you no extra [Sta].
	PRINTFORMDL ※ [Mystery Bubbles] will earn you slightly less extra Favor and Trust but at no extra [Sta] cost.
ELSE
	PRINTFORMDL ※ Carrying %HIM_HER(93, 0)% in your arms will make her like your more, but it will make you tired.
	PRINTFORMDL ※ Pushing %HIM_HER(93, 0)% on a wheelchair will be just like usual, and it won't make you tired.
	PRINTFORMDL ※ Leading %HIM_HER(93, 0)% around on top of the [Mystery Bubbles] will make %HIM_HER(93, 0)% like you more, but won't tire you out.
ENDIF

@K93_CarryChoice
PRINTFORMD Current choice:
SIF CFLAG:93:K93EN_WAGGYCARRY == 0
	PRINTFORMDL  Princess Carry
SIF CFLAG:93:K93EN_WAGGYCARRY == 1
	PRINTFORMDL  Wheelchair
SIF CFLAG:93:K93EN_WAGGYCARRY == 2
	PRINTFORMDL  Bubbles
SIF GET_MAPID(CFLAG:93:現在位置) == 2
	PRINTFORMDL (Using the wheelchair for the sake of %K93NICK()%'s disguise)
CALL ASK_M("Princess Carry", 1, "Wheelchair Pushing", 1, "Mystery Bubbles", GETBIT(FLAG:プール, 3), "Return", 1)
RETURN RESULT