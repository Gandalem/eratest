; Modular ERB: 個人口上/093 Wakasagihime [わかさぎ姫]/ENWaggy/K93_CarryWaggy.ERB

@K93_CarryWaggy
CALL M_KOJO_EN_COLOR_K93
IF !SHIRAHU(93)
	PRINTFORMDL 당신은 %K93NICK()%을 바라보며, 어떻게 %HIM_HER(93, 0)%을 데리고 다녀야 할지 생각하기 시작한다.
	IF K93_MAD()
		PRINTFORMDW 하지만 당신은 그게 마음속에 있는 것이 무엇이든 %HE_SHE(93, 0)%가 받아들일 거라고 생각하지 않을 것이다...
		RETURN 1
	ENDIF
	IF FIRSTTIME("WaggyCarrySet", 0, 93)
		PRINTL
		CALL K93_CarryExplanation
		PRINTW
	ENDIF
	CALL K93_CarryChoice
	SELECTCASE RESULT
		CASE 0
			IF GET_MAPID(CFLAG:MASTER:現在位置) == 2
				PRINTFORMDW 인간 마을에 있는 동안 벌거벗은 채로 %HIM_HER(93, 0)%을 들고 다니는 것은 좋은 생각이 아닐지도 모른다...
			ELSE
				CFLAG:93:K93EN_WAGGYCARRY = 0
				PRINTFORMDW 당신은 %HIM_HER(93, 0)%을 팔에 안기로 결정했다. 
			ENDIF
		CASE 1
			CFLAG:93:K93EN_WAGGYCARRY = 1
			PRINTFORMDW 당신은 %HIM_HER(93, 0)%를 휠체어로 밀기로 결정한다.
		CASE 2
			IF GET_MAPID(CFLAG:MASTER:現在位置) == 2
				PRINTFORMDW 인간 마을에 있으면서 %HIM_HER(93, 0)%이 %HIS_HER(93, 0)%의 [미스터리 버블]을 공개적으로 사용하는 것은 좋은 생각이 아닐지도 모른다...
			ELSE
				PRINTFORMDW 당신은 %HIM_HER(93, 0)%가 옆에서 움직이기 위해 %HIS_HER(93, 0)%의 [미스터 버블]을 사용하도록 허락하기로 결정했다.
			ENDIF
		CASE 3
			PRINTFORMDW 당신은 현재 상태가 괜찮다고 결정한다.
	ENDSELECT
ELSE
	IF K93_MAD()
		PRINTFORML 「나를 다른 방식으로 이끌고 싶다고? 거절해야겠어.」
		PRINTFORM 「차라리 나는」
		IF GETBIT(FLAG:プール, 3) && GET_MAPID(CFLAG:MASTER:現在位置) != 2
			PRINTFORMW  「미스터리 버블들을 활용해라, 그들이 더 믿을 만하다.」
		ELSE
			PRINTFORMW  나 자신을 구르고, 다시는 당신에게 의지하지 않겠다.
		ENDIF
		RETURN 1
	ENDIF
	IF FIRSTTIME("WaggyCarrySet", 0, 93)
		PRINTFORML 「어디론가 나를 데려가고 싶으신 건가요?」
		PRINTFORMW 「전 전혀 상관없어요, %K93_HONORIFIC(MASTER)%님!」
		PRINTFORMW 「%K93_HONORIFIC(63)%님이 저를 밀어주기 위해 사용하는 휠체어가 있어요.」
		IF GETBIT(FLAG:プール, 3) ;has bubble
			PRINTFORMW 「하지만 당신이 나에게 준 선물을 덕분에 스스로 당신 곁을 걸을 수 있게 되었어!」
			PRINTFORMDL %K93NICK()%은(는) 얼굴을 심하게 붉히며, 다시 말하기 전에 시선을 돌린다.
			PRINTFORMW 「그래도, 여전히 내 품에 안겨 준다면 나쁘지 않을 것 같아...」
		ELSE
			PRINTFORML 「하지만 무게가 부담된다면...」
			;there used to be a slight fall state variation here, it's gone now
			PRINTFORMDL %K93NICK()%얼굴이 새빨개지며, 다시 말하기 전에 시선을 돌렸다.
			PRINTFORMW 「원하신다면 제게 안아주셔도 좋습니다.」
		ENDIF
		PRINTL
		PRINTFORMW 「결국은 너에게 달린 문제야.」
		PRINTFORML 「그래서... 뭘 할 거야?」
		PRINTL
		CALL K93_CarryExplanation
		WAIT
	ELSE
		PRINTFORML 「나를 다른 %SPLIT_G("way:manner")%로 이끌려고 하는 건가?」
		PRINTDATAL
			DATAFORM 「내가 살이 찐 게 원인이 아니겠지?」
			DATAFORM 「그럼 무슨 생각을 하고 있는 거야?」
			DATAFORM 「나한테는 괜찮아, %K93_HONORIFIC(MASTER)%에게는.」
		ENDDATA
	ENDIF
	PRINTL
	CALL K93_CarryChoice
	SELECTCASE RESULT
		CASE 0
			CFLAG:93:K93EN_WAGGYCARRY = 0
			SIF GET_MAPID(CFLAG:MASTER:現在位置) == 2
				GOTO CARRYBUBBLEREJECT
			IF K93_LOVE_LUST_LOVER()
				PRINTFORMW 「후후후... 나를 태우고 다니는 게 꼭 제대로 된 공주가 된 기분이 드네~!」
			ELSE
				PRINTFORML 「나를 그렇게 들쳐 메다니 좀 친밀하네.」
				PRINTFORMW 「하지만 신경 쓰지 마, 나도 괜찮으니까.」
			ENDIF
		CASE 1
			CFLAG:93:K93EN_WAGGYCARRY = 1
			SIF GETBIT(FLAG:プール, 3)
				PRINTFORMW 「스스로 움직일 수 있는데도 말이야?」
			IF K93_LOVE_LUST_LOVER()
				IF !RAND:20 && GETBIT(FLAG:プール, 3) ;very small chance
					PRINTFORMDL %K93NICK()%은(는) 장난기 있으면서도 짓궂은 미소로 당신을 바라본다.
					PRINTFORMW 「후후후... 내가 당신을 좀 더 잘 몰랐다면, 당신이 휠체어에 관심이 있는 줄 알았을 거야~」
				ELSE
					PRINTFORMW 「당신이 나를 휘두르는 것도 일종의 로맨틱함으로 느껴져서 괜찮아.」
				ENDIF
			ELSE
				PRINTFORMW 「휠체어라? 나는 문제없다고 본다, %K93_HONORIFIC(MASTER)% 씨.」
			ENDIF
		CASE 2
			CFLAG:93:K93EN_WAGGYCARRY = 2
			SIF GET_MAPID(CFLAG:MASTER:現在位置) == 2
				GOTO CARRYBUBBLEREJECT
			PRINTFORML 「당신의 옆을 걸으면 내가 진정으로 당신과 동등한 존재인 것만 같아...」
			IF K93_LOVE_LUST_LOVER()
				PRINTFORMW 「서로를 미치도록 사랑하는 두 사람이라면 그래야 한다.」
			ELSE
				PRINTFORMW 「친구라면 서로에게 있어야 하는 것처럼.」
			ENDIF
		CASE 3
			PRINTFORML 「음…? 마음이 바뀌었어?」
			PRINTFORMW 「That's okay, I'm fine with things as they are.」
	ENDSELECT
ENDIF
RETURN 1
$CARRYBUBBLEREJECT
IF CFLAG:93:K93EN_WAGGYCARRY == 0
	PRINTFORML 「나를 등에 업고 다니길 원해?」
ELSE
	PRINTFORML 「나에게 [미스터 버블]을 사용해 주길 바라나요?」
ENDIF
PRINTFORMW 「인간 마을에서 그런 것을 하는 건 좋은 생각이 아닐 것 같은데...」
PRINTFORML 「%K93_HONORIFIC(MASTER)%님의 의도는 감사히 받겠습니다.」
PRINTFORMW 「우리가 더 이상 여기에 없을 때 그렇게 할 수 있을지도 모르죠.」
RETURN 1

@K93_CarryExplanation
IF VAR_OR_DEFAULT("nSpoilerMode")
	PRINTFORMDL ※ [공주 안기]는 데이트 중 추가 호감도와 신뢰를 얻지만 약간의 [체력]을 소모한다.
	PRINTFORMDL ※ [휠체어 밀기]는 추가 호감도나 신뢰를 얻지 못하지만, 추가적인 [체력]을 소모하지 않는다.
	PRINTFORMDL ※ [신비한 거품]은 추가 호감도와 신뢰를 약간 적게 얻지만, 추가 [체력]을 소모하지 않는다.
ELSE
	PRINTFORMDL 당신의 팔에 %HIM_HER(93, 0)%을 안고 다니면 그녀가 당신을 더 좋아하게 되지만 지치게 될 것이다.
	PRINTFORMDL 전동식 휠체어에 %HIM_HER(93, 0)%을 태우는 것은 평소와 같을 것이며, 당신을 지치게 하지 않을 것이다.
	PRINTFORMDL [Mystery Bubbles] 위에서 %HIM_HER(93, 0)%을 데리고 다니면 그녀가 당신을 더 좋아하게 되지만 당신을 지치게 하지는 않는다.
ENDIF

@K93_CarryChoice
PRINTFORMD 현재 선택:
SIF CFLAG:93:K93EN_WAGGYCARRY == 0
	PRINTFORMDL  공주 안기
SIF CFLAG:93:K93EN_WAGGYCARRY == 1
	PRINTFORMDL  휠체어
SIF CFLAG:93:K93EN_WAGGYCARRY == 2
	PRINTFORMDL  거품
SIF GET_MAPID(CFLAG:93:現在位置) == 2
	PRINTFORMDL (%K93NICK()%의 위장이라는 명목으로 휠체어를 사용한다)
CALL ASK_M("공주 안기", 1, "휠체어 밀기", 1, "미스터 버블스", GETBIT(FLAG:プール, 3), "반환", 1)
RETURN RESULT
