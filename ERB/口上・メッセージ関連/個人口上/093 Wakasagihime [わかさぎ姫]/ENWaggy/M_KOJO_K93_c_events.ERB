@K93_E_WATERSPHERERECEIVE(ARG)
SELECTCASE ARG
CASE 0 ;daily greeting
	PRINTFORMW 「%K93_DAYGREET()%, %K93_HONORIFIC(MASTER)%!」
	PRINTFORML 「It's good that you're here, for I just happen to have a gift for you.」
	PRINTFORMW 「First, would you mind leaning in a bit closer?」
