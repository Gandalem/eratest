@M_KOJO_EN_MESSAGE_CUSTOM_COM_K93_1
IF !VAR_OR_DEFAULT("TEQUIP:MASTER:SWIMMING") ;stop swimming
	TRYCALLF ADD_WEATHER_HARSHNESS(CFLAG:MASTER:現在位置)
	SELECTCASE RESULT
		CASE 0 ;nice, relaxing swim
			IF RAND:2
				PRINTFORML 「수영을 그만두고 싶어? 나한테는 괜찮아.」
				IF K93_LOVE_LUST_LOVER()
					PRINTFORMW 「당신이 곁에 있다면 육지에서도 괜찮을 거야~」
				ELSE
					PRINTFORMW 「하지만... 이제 어떻게 해야 하지?」
				ENDIF
			ELSE
				PRINTFORML 「벌써 충분해졌니, %K93_HONORIFIC(MASTER)%?」
				PRINTFORMW 「후후후... 수영은 결코 질리지 않을 것 같아.」
			ENDIF
		CASE 1 ;rough waves
			PRINTFORML 「피곤한 거 아니야, %K93_HONORIFIC(MASTER)%?」
			PRINTFORMW 「언제 멈춰야 하는지 아는 건 좋은 일이지.」
			IF K93_LOVE_LUST_LOVER()
				PRINTFORML 「자, 이리 와서 내 곁에서 쉬어줘...」
				PRINTFORMDW %K93NICK()%은 %HIM_HER(93, 0)% 옆의 땅을 쓰다듬으며, %HIS_HER(93, 0)% 얼굴에 밝은 미소를 띠었다.
			ENDIF
		CASE 2 ;harsh weather
			PRINTFORML 「아, 해변에 오기로 결정해 주어서 다행이군요!」
			PRINTFORMW 「당신이 감기에 걸리는 걸 보고 싶지 않아요.」
		CASE 3 ;extremely dangerous weather
			PRINTFORML 「하아... 무사히 돌아온 걸 보니 다행이다.」
			IF K93_LOVE_LUST_LOVER()
				CALL HPH_PRINT,@"「자, 이리 와서 모두 몸을 좀 녹여줘~...」","W"
			ELSE
				PRINTFORMW 「하지만 몸을 따뜻하게 하는 것을 확실히 해야 합니다, %K93_HONORIFIC(MASTER)%께.」
			ENDIF
	ENDSELECT
ELSE
	TRYCALLF ADD_WEATHER_HARSHNESS(CFLAG:MASTER:現在位置)
	SELECTCASE RESULT
		CASE 0 ;nice, relaxing swim
			IF RAND:2
				PRINTFORML 「수영할 계획이야? 그거 좋네!」
				PRINTFORMW 「%K93_DAYANDNIGHT("day")% 시점의 물은 꽤 즐거울 거야.」
			ELSE
				PRINTFORML 「후후후... 수영은 정말 좋지, 안 그래?」
				PRINTFORMW 「특히 물이 이렇게 온통 잔잔할 때 말이야.」
			ENDIF
		CASE 1 ;rough waves
			PRINTFORMW 「파도가 좀 잠잠해질 때까지 기다리고 싶지 않은 거 확실해?」
		CASE 2 ;harsh weather
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 지금 바로 수영하고 싶으신가요?」
			PRINTFORMW 「후우... 감기 걸리지 않게 조심하세요.」
		CASE 3 ;extremely dangerous weather
			PRINTFORML 「%K93_HONORIFIC(MASTER)%, 지금 물에 들어가는 건 정말 안 된다고 생각해.」
			PRINTFORML 「제발, 그냥 내 옆에 있어 줄 수는 없어?」
			PRINTFORMDW %K93NICK()%는 걱정스러운 목소리로 당신을 설득하려고 최선을 다한다.
	ENDSELECT
ENDIF
RETURN 1
