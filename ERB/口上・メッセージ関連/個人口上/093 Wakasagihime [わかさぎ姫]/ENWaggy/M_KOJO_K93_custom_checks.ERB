@M_KOJO_EN_CHECK_K93_CHARADATA(ARGS,ARG,ARG:1)
SELECTCASE ARGS
    CASE "SPECIAL_MENU"
        DISH_NAME = Special character dish
        RESULTS = 主食
        CALL 材料設定("汎用")
        DISH_TASTE = 和食/饅頭/甘い/上品/祝福/エンチャント/加護/
        DISH_COMMENT = A special dish that supersedes a regular dish.
        RETURN 1
    CASE "MOVE"
        SELECTCASE ARG
            CASE 1
                ;attached to other character, and will move to the same location as them
                ;if a valid character is returned, will attach to that character
                ;if 0 is returned, will use the default CHARADATA MOVE 1 values
                ;if -1 is returned, the default CHARADATA MOVE 1 will be ignored
                ;if RESULT:1-3 is set, and RESULT isn't set, it will attach to one of these three characters
                ;this is not a random choice, but it will prioritize the first character in the list that has Love, then the first with Yearning, then the first
                IF DAY:2 == 1 ;attach to one of these characters in spring
                    RESULT:1 = [[霊夢]]
                    RESULT:2 = [[る～こと]]
                    RESULT:3 = [[カナ]]
                ELSEIF DAY:2 == 2 ;attach to youmu in summer
                    RETURN [[妖夢]]
                ELSEIF DAY:2 == 3 ;attach to nobody in fall and ignore the default CHARADATA
                    RETURN -1
                ELSE ;attach to nobody, but use the default CHARADATA, if available
                    RETURN 0
                ENDIF
            CASE 3
                ;adjust waking, sleep times
                IF DAY:2 == 3 ;earlier in fall
                    CFLAG:生活時間補正 = -120
                ELSEIF DAY:2 == 4 ;later in winter
                    CFLAG:生活時間補正 = 60
                ELSE ;normal
                    CFLAG:生活時間補正 = 0
                ENDIF
                RETURN 1 ;don't use regular CHARADATA
            CASE 4
                ;movement patterns on MAIN_MAP
                SELECTCASE ARG:1
                    ;avoid eientei
                    CASE P401永遠亭入口 TO P430地下室
                        RESULT:1 = -100
                    ;eagerly explore mugenkan
                    CASE P450玄関 TO P466庭
                        RESULT:1 = 100
                    CASE P447竹林入口 ;deprioritize entrance 
                        RESULT:1 = -5
                ENDSELECT
                RETURN 1 ;override defaults
            CASE 7
                ;areas on not MAIN_MAP this character can visit (CASE 1 supersedes this)
                SELECTCASE ARG:1
                    ;commonly visits the moon
                    CASE 桃林～砂浜, 静かの海
                        RESULT:1 = 1
                    ;seen in hakugyokurou
                    CASE 白玉楼庭, 白玉楼
                        RESULT:1 = 1
                ENDSELECT
                RETURN 1 ;override defaults
            CASE 8
                ;characters with this value set will always try to move to this location on the MAIN_MAP
                SIF DAY:3 == 18 ;on the 18th, will try to visit mugenkan's living room at all costs
                    TCVAR:引力点 = P461リビング
                RETURN 1 ;override defaults
        ENDSELECT
ENDSELECT
