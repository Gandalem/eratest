; Modular ERB: 個人口上/093 Wakasagihime [わかさぎ姫]/ENWaggy/M_KOJO_K93_custom_checks.ERB
;determines if a specific event/command has timestop dialogue
;overrides CFLAG:時間停止口上有

@M_KOJO_EN_K93_TIMESTOP_ALLOWED(ARGS, ARG, ARGS:1)
SELECTCASE ARGS
	;use these as needed
	CASE "COM"
		SIF GROUPMATCH(ARG, 64)
			RETURN -1
	CASE "SCOM"
	CASE "CUSTOM_COM"
	CASE "CUSTOM_SCOM"
	CASE "EVENT"
	CASE "PALAM"
	CASE "COUNTER"
	CASE "COM_ASSISTANT"
	CASE "SCOM_ASSISTANT"
	CASE "CUSTOM_COM_ASSISTANT"
	CASE "CUSTOM_SCOM_ASSISTANT"
ENDSELECT
;todo properly check out the things above, they seem interesting
;handle with care, do not block critical commands like MOVE or go out

@M_KOJO_EN_CHECK_K93_COM_BLOCKED(ARGS,ARG,ARG:1)
SIF GROUPMATCH(ARG, 62, 67, 68, 69, 70) ;commands you want blocked
	RETURN 1
;Allows a dialogue to use add parameters (such as time passed and stamina consumption) to movement when they are accompanying the player

@M_KOJO_EN_CHECK_K93_CUSTOM_MOVEMENT(ARGS,ARG,ARG:1)
;ARG carries movements made, only there for the 400 Move command
;Careful with assigning negative values to TIME, we don't want to create time travelers
CALL K93_CARRYEFFECTS(1, ARG)
RETURN 1
