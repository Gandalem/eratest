@M_KOJO_EN_EVENT_K93_CHILD_RAISING_TOY(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
;SIF !CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中
;	RETURN
IF ARGS == "幼児期" ;early childhood
	IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;fish doll
		PRINTFORMW 「후후... 그 물고기 인형을 아주 좋아하는구나.」
		PRINTFORMDW 하지만 %K93NICK()%이 말했듯이, %SHOW_CHILDNAME(93)%가 작은 피규어를 씹기 시작했다.
		PRINTFORMW 「아, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%! 그렇게 하면 안 돼! 물고기는 먹는 게 아니야!」
		PRINTFORMW 「장난감들도 마찬가지지, 지금 생각해보니...」
	ELSE
		PRINTFORML 「후후후... 그 작은 "자동차" 같은 걸 아주 좋아하네, 그렇지?」
		PRINTFORMW 「%K93_HONORIFIC(MASTER)%는 이 세상 바깥의 남자들이 저런 것들을 많이 좋아한다고 했지...」
		PRINTFORMDW %SHOW_CHILDNAME(93)%가 미소를 지으며 나무 장난감 자동차를 씹기 시작했다.
		PRINTFORMW 「...하지만 내가 알기로 %HE_SHE(MASTER, 0)%는 그것들을 먹는 것에 대해서는 아무 말도 안 했어!」
	ENDIF
ELSEIF ARGS == "幼少期" ;childhood
	IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;fish doll
		PRINTFORMDL %SHOW_CHILDNAME(93)% 옷을 입히다 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% 드레스 중 하나를 입은 물고기 인형 %K93NICK()% 그것을 위해 만들어진
		CALL COLORMESSAGE(@"「엄마, 봐요... 이 드레스 입은 피시가 엄마랑 똑같이 생겼어!」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMW 「후후후! 거의 동의하는 것 같지만, 나는 그녀보다 약간 더 귀여워 보인다고 생각하는데...」
	ELSE
		PRINTFORMDL %SHOW_CHILDNAME(93)%은(는) %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% 장난감 자동차를 굴리며, %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% 입으로 기계음 같은 소리를 흉내 냈다.
		CALL COLORMESSAGE(@"「부루웅... 부우움브루움... 스키이익!」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMW 「"차"가 움직일 때 내는 소리가 정말 그거야?」
		PRINTFORMW 「그리고 그건 어디서 배운 거야, %K93_HONORIFIC(MASTER)%님이 가르쳐 주신 거야?」
		PRINTFORMDL %K93NICK()%은/는 뒤로 기대어, 미소 지으며 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)%이 노는 것을 본다.
		PRINTFORMW 「후후후... 이상한 소리지만 뭐, 틀린 건 없을 거라고 생각해.」
	ENDIF
ELSE
	IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
		PRINTFORMDW 당신은 %SHOW_CHILDNAME(93)%이/가 당신이 만든 오래된 \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? 물고기 인형 # 장난감 자동차 \@ 를 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%를 위해 자세히 살펴보고 있는 것을 본다.
		PRINTFORMDW %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%의 애정은 거의 느껴질 정도로 여전히 남아있다...
		IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;fish doll
			CALL COLORMESSAGE(@"「한동안 인형이란 어린 여자아이들만 즐길 수 있는 것이라고 생각했었는데...」", K93_CHILDCOLOR(), 1, 0)
			CALL COLORMESSAGE(@"「하지만 이제 좀 나이가 들었더니, 이런 것들에도 여전히... 감사할 만한 것이 있는 것 같아.」", K93_CHILDCOLOR(), 2, 0)
		ELSE
			CALL COLORMESSAGE(@"「이제 좀 나이가 들었으니 말하는데, 이건 꽤 잘 만들어졌네...」", K93_CHILDCOLOR(), 1, 0)
			CALL COLORMESSAGE(@"「하지만 동시에... 도대체 이 \"차\" thing, 어쨌든?」", K93_CHILDCOLOR(), 2, 0)
		ENDIF
		PRINTFORMDL %HE_SHE_CHILD(93, 1, TALENT:93:育児中)%이 짧게 웃으며 따뜻한 미소로 당신을 바라본다.
		CALL COLORMESSAGE(@"「헤헤... 나중에 이 거들 가지고 놀아도 괜찮을까.」", K93_CHILDCOLOR(), 2, 0)
	ELSE
		PRINTFORMDL 당신은 %SHOW_CHILDNAME(93)%이(가) \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? 물고기 인형 # 장난감 자동차 \@ 아주 오래전에 당신이 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%를 위해 만들어 준 것을 들여다보고 있는 것을 본다.
		PRINTFORMDW 단지 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%가 그 장난감을 다시 내려놓을 뿐, 두 번 생각조차 하지 않았다.
	ENDIF
ENDIF
;-------------------------------------------------
;育児イベントその他。一番よく表示される。
;Other events, displayed more often
;-------------------------------------------------

@M_KOJO_EN_EVENT_K93_CHILD_RAISING_OTHER(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "幼児期" ;early childhood
	IF IS_HERE(63, 73) && RAND:2 ;sekibanki and kagerou are there
		PRINTFORMDL 당신은 %CALLNAME:63%과 %CALLNAME:73%가 %SHOW_CHILDNAME(93)%을 가지고 노는 것을 본다.
		PRINTL
		SELECTCASE RAND:3
			CASE 0
				CALL CHARA_TEXT(63, @"「에헤헤... 아기들은 정말 귀엽지 않아?」","W")
				CALL CHARA_TEXT(73, @"「괜찮다고 생각한다, 그 이상은 없다.」","W")
				IF !CFLAG:73:子供人数 && !TALENT:73:妊娠 ;no child count and no pregnancy for sekibanki
					CALL CHARA_TEXT(63, @"「정말로? %SHOW_CHILDNAME(93)%를 바라보는 눈빛은 오히려 네가 자기 자식에게 그러고 싶은 것 같아～...」","W")
					PRINTFORMDL %CALLNAME:73%은(는) 재빨리 시선을 돌렸고, %HIS_HER(73, 0)%의 얼굴에 분홍빛 홍조가 빠르게 번졌다.
					CALL CHARA_TEXT(73, @"「뭐-뭐라고!? 아-아니, 그게... %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%을 보고 있는 거야.」","W")
				ELSE
					CALL CHARA_TEXT(63, @"「네가 \@ CFLAG:73:子供人数 ? 이미 # 곧 \@ 엄마라는 걸 생각하면, 정말 나한테 진실을 말하고 있는 거야～?」","W")
					CALL CHARA_TEXT(63, @"「솔직히 말해, 너도 나만큼 아기들을 좋아하지.」","W")
					PRINTFORMDL %CALLNAME:73%은(는) 몸을 돌려 %HIS_HER(73, 0)%의 숨결 아래 속삭였다.
					CALL CHARA_TEXT(73, @"「하아... 괜찮아, 조금만...」","W")
				ENDIF
