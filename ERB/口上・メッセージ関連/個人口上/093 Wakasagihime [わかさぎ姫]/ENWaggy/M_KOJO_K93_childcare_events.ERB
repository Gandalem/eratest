;-------------------------------------------------
;育児イベント玩具
;Playing with toys
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_TOY(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
;SIF !CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中
;	RETURN
IF ARGS == "幼児期" ;early childhood
	IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;fish doll
		PRINTFORMW 「Fufu... You seem to like that fish doll a lot.」
		PRINTFORMDW But just as %K93NICK()% says that, %SHOW_CHILDNAME(93)% starts chewing on the small figurine.
		PRINTFORMW 「Ah, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%! You shouldn't do that! Fish are not for eating!」
		PRINTFORMW 「And neither are toys, now that I think about it...」
	ELSE ;car
		PRINTFORML 「Fufufu... You seem to enjoy that little "car" thing a lot, don't you?」
		PRINTFORMW 「%K93_HONORIFIC(MASTER)% did say boys in the world outside like these a lot...」
		PRINTFORMDW %SHOW_CHILDNAME(93)% grins, and starts to chew on the wooden toy car.
		PRINTFORMW 「...But I don't think %HE_SHE(MASTER, 0)% said anything about eating them!」
	ENDIF
ELSEIF ARGS == "幼少期" ;childhood
	IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;fish doll
		PRINTFORMDL %SHOW_CHILDNAME(93)% dresses up %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% fish doll with one of the dresses %K93NICK()% made for it.
		CALL COLORMESSAGE(@"「Mommy, look... Ms. Fishy looks just like you with this dress!」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMW 「Fufufu! I almost agree, although I think I look slightly cuter than her...」
	ELSE ;car
		PRINTFORMDL %SHOW_CHILDNAME(93)% rolls %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% toy car around, mimicking mechanical sounds with %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mouth.
		CALL COLORMESSAGE(@"「Vrooom... Bruuumvruum... Skreeeek!」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMW 「Is that really the sound that "cars" make when they move?」
		PRINTFORMW 「And where did you even learn that, did %K93_HONORIFIC(MASTER)% teach you?」
		PRINTFORMDL %K93NICK()% leans back, watching %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% play with a smile.
		PRINTFORMW 「Fufufu... It's a strange sound, but I suppose there is nothing wrong with it.」
	ENDIF
ELSE ;older
	IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
		PRINTFORMDW You see %SHOW_CHILDNAME(93)% closely examining the old \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? fish doll # toy car \@ you made for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%.
		PRINTFORMDW The affection %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% still holds for it is almost palpable...
		IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;fish doll
			CALL COLORMESSAGE(@"「For some time I thought dolls were something only little girls could enjoy...」", K93_CHILDCOLOR(), 1, 0)
			CALL COLORMESSAGE(@"「But now that I'm a bit older, I think there's still... something, to be appreciated with these things.」", K93_CHILDCOLOR(), 2, 0)
		ELSE ;car
			CALL COLORMESSAGE(@"「Now that I'm a bit older, I got to say this is some good craftsmanship...」", K93_CHILDCOLOR(), 1, 0)
			CALL COLORMESSAGE(@"「But at the same time... just what is this \"car\" thing, anyway?」", K93_CHILDCOLOR(), 2, 0)
		ENDIF
		PRINTFORMDL %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% lets out a short giggle looks at you with a warm smile.
		CALL COLORMESSAGE(@"「Heheh... I hope you don't mind if I take these with me when I'm older.」", K93_CHILDCOLOR(), 2, 0)
	ELSE
		PRINTFORMDL You see %SHOW_CHILDNAME(93)% examining the \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? fish doll # toy car \@ you made for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% a long time ago...
		PRINTFORMDW Only for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to set the toy back down, not giving it a second thought.
	ENDIF
ENDIF

;-------------------------------------------------
;育児イベントその他。一番よく表示される。
;Other events, displayed more often
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_OTHER(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "幼児期" ;early childhood
	IF IS_HERE(63, 73) && RAND:2 ;sekibanki and kagerou are there
		PRINTFORMDL You see both %CALLNAME:63% and %CALLNAME:73% playing with %SHOW_CHILDNAME(93)%.
		PRINTL
		SELECTCASE RAND:3
		CASE 0
			CALL CHARA_TEXT(63, @"「Eheheh... Babies are so cute, aren't they?」","W")
			CALL CHARA_TEXT(73, @"「I think they're alright, nothing more than that.」","W")
			IF !CFLAG:73:子供人数 && !TALENT:73:妊娠 ;no child count and no pregnancy for sekibanki
				CALL CHARA_TEXT(63, @"「Really? The way you're looking at %SHOW_CHILDNAME(93)%, it looks more like you want one to call your own～...」","W")
				PRINTFORMDL %CALLNAME:73% quickly looks away, a pink blush rapidly spreading through %HIS_HER(73, 0)% face.
				CALL CHARA_TEXT(73, @"「W-what!? N-No, It's that... looking at %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% of something.」","W")
			ELSE
				CALL CHARA_TEXT(63, @"「Are you really telling me the truth, considering that you are \@ CFLAG:73:子供人数 ? a # soon to be \@ a mother～?」","W")
				CALL CHARA_TEXT(63, @"「Admit it, you like babies just as much as I do.」","W")
				PRINTFORMDL %CALLNAME:73% looks away, whispering under %HIS_HER(73, 0)% breath.
				CALL CHARA_TEXT(73, @"「Haaah... Fine, maybe just a little...」","W")
			ENDIF
		CASE 1
			CALL CHARA_TEXT(73, @"「You seem to be enjoying your time with Hime's %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)% a lot, %CALLNAME:63%.」","W")
			CALL CHARA_TEXT(63, @"「What can I say, %SHOW_CHILDNAME(93)% is just so cute!」","W")
			IF !CFLAG:63:子供人数 && !TALENT:63:妊娠 ;same thing but for kagerou
				CALL CHARA_TEXT(73, @"「Really? From where I'm standing, it looks more like you want a litter of your own.」","W")
				PRINTFORMDL %CALLNAME:63% crosses %HIS_HER(63, 0)% arms and looks away, hiding the blush that is quickly taking over %HIS_HER(63, 0)% face.
				CALL CHARA_TEXT(63, @"「T-that's...! Just... not something you say out loud, Banki-chan...」","W")
			ELSE
				CALL CHARA_TEXT(73, @"「Maybe you think that of every child, considering that \@ CFLAG:63:子供人数 ? you are a mother # soon to be a mother \@...」","W")
				PRINTFORMDL %CALLNAME:63% shakes %HIS_HER(63, 0)% head and looks towards %HIS_HER(63, 0)% friend with a sincere smile.
				CALL CHARA_TEXT(63, @"「Maybe I do, and there is absolutely nothing wrong with that.」","W")
			ENDIF
		CASE 2
			CALL CHARA_TEXT(73, @"「This is fun and all, but I think I'm starting to get tired...」","W")
			CALL CHARA_TEXT(63, @"「Eheheh... That just means that there's more %SHOW_CHILDNAME(93)% for me to play with!」","W")
			PRINTFORMDL %CALLNAME:73% sighs, but continues playing with the %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)% anyway.
		ENDSELECT
		RETURN
	ENDIF

	SELECTCASE RAND:3
	CASE 0
		PRINTFORMDL %SHOW_CHILDNAME(93)% looks at you for a few seconds before happily giggling.
		PRINTFORMDW You notice that %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% fin ears wiggle when %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% is happy...
	CASE 1
		PRINTFORMDL On a whim, you slowly reach a finger towards %SHOW_CHILDNAME(93)%.
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% grabs on to it with %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% smalls hands, examining it carefully...
		PRINTFORMDW Before unceremoniously bringing it to %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mouth and suckling on it.
	CASE 2
		PRINTFORMDL You decide to hold %SHOW_CHILDNAME(93)% in your arms and close to your chest for a while.
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% seems to enjoy it, calmly resting %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% head against you.
	ENDSELECT
ELSEIF ARGS == "幼少期" ;childhood
	PRINTFORMDL You calmly observe %CALLNAME:63% and %CALLNAME:73% as they watch over %SHOW_CHILDNAME(93)%.
	PRINTL
	IF IS_HERE(63, 73) && RAND:2
		SELECTCASE RAND:3
		CASE 0
			CALL CHARA_TEXT(73, @"「Doesn't %SHOW_CHILDNAME(93)% remind you of Hime?」","L")
			CALL CHARA_TEXT(73, @"「Always smiling, always poking at everything, asking about everything...」","W")
			CALL CHARA_TEXT(63, @"「It's like they always say, \"like mother like %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%\"!」","W")
			CALL CHARA_TEXT(73, @"「Yeah, but it's a bit uncanny if you ask me.」","W")
		CASE 1
			CALL CHARA_TEXT(63, @"「%SHOW_CHILDNAME(93)% looks a bit bored. Any idea of what we should do with %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%?」","W")
			CALL CHARA_TEXT(73, @"「Huh, why do you expect me to have an answer to that?」","W")
			PRINTFORMDW %CALLNAME:63% silently stares at %CALLNAME:73% until %HE_SHE(73, 0)% finally concedes.
			CALL CHARA_TEXT(73, @"「...Fine, I guess we can have %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% chase one of my heads around.」","W")
		CASE 2
			PRINTFORMD Suddenly, %SHOW_CHILDNAME(93)% approaches
			IF RAND:2 ;aunt sekibanki
				PRINTFORMDL  %CALLNAME:73%, interest shining in %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% eyes.
				CALL COLORMESSAGE(@"「Auntie %CALLNAME:73%, can I wear your cape for a little? It looks so cool...」", K93_CHILDCOLOR(), 2, 0)
				CALL CHARA_TEXT(73, @"「D-did you just call me... I mean, of course you can.」","L")
				PRINTFORMDW %CALLNAME:73% quickly takes off %HIS_HER(73, 0)% red cape and hands it over to %SHOW_CHILDNAME(93)%.
				PRINTFORMDW Meanwhile, %CALLNAME:63% silently smirks at the Rokurokubi, barely able to contain %HIS_HER(73, 0)% pride.
			ELSE ;aunt kagerou
				PRINTFORMDL  %CALLNAME:63%, seemingly interested in %HIM_HER(63, 0)%.
				CALL COLORMESSAGE(@"「Auntie %CALLNAME:63%... c-can I touch your paw? Just for a little?」", K93_CHILDCOLOR(), 2, 0)
				CALL CHARA_TEXT(63, @"「Oh, did Waggy tell you about that? Well, It's not like I mind it.」","W")
				PRINTFORMDL %CALLNAME:63% hides %HIS_HER(63, 0)% left hand on %HIS_HER(63, 0)% right sleeve.
				PRINTFORMDW When %HE_SHE(63, 0)% pulls it out again, it's transformed into the a paw of a wolf.
				CALL COLORMESSAGE(@"「Hoooah! It looks just like a puppy's paw!」", K93_CHILDCOLOR(), 2, 0)
				CALL CHARA_TEXT(63, @"「Heheh, feel free to touch it. But I must warn you, it's not soft at all...」","W")
			ENDIF
		ENDSELECT
		RETURN
	ENDIF

	SELECTCASE RAND:6
	CASE 0,1 ;shorter, more common
		CALL COLORMESSAGE(@"「%PRINT_MALE(@"Dad:%CALLNAME:MASTER%-san", MASTER)%, %SPLIT_G("I saw this thing the other day, and:there is something I want to ask you:there's something I'm curious about")%...」", K93_CHILDCOLOR(), 1, 0)
		IF !RAND:5
			PRINTFORMDW %SHOW_CHILDNAME(93)% innocently asks about something improper for %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% age.
			PRINTFORMDW For now, you try your best to give %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% a vague answer.
		ELSEIF (RAND:3 + ABL:MASTER:教養) >= 3
			PRINTFORMDW %SHOW_CHILDNAME(93)% asks about something not even you have an answer for.
			PRINTFORMDW You try your best to come up with a satisfactory answer.
		ELSE
			PRINTFORMDW %SHOW_CHILDNAME(93)% asks about something mundane that only a child would not know about.
			PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% listens carefully as you answer %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% question.
		ENDIF
	CASE 2, 3 ;also shorter, so also more common
		PRINTFORMDW You decide sit by %K93NICK()%'s side and watch %SHOW_CHILDNAME(93)% playing alone by %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%self.
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% runs around, inquisitively probing at anything %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% can find.
		PRINTFORML 「Fufufu... I wonder where our %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% got all that curiosity from?」
		PRINTFORMW 「I'm just happy that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% gets to quench that thirst with %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% own two legs...」
	CASE 4
		CALL COLORMESSAGE(@"「%PRINT_MALE(@"Dad:%CALLNAME:MASTER%-san", MASTER)%, can you please give me a piggyback ride?」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMDW You smile and crouch down, unable to find it in you to deny %SHOW_CHILDNAME(93)%'s request.
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% climbs on your shoulder with no hesitation, holding %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%self firmly to your head.
		PRINTFORMDW You carefully stand up, and start trotting around with your %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)% on your shoulders.
		CALL COLORMESSAGE(@"「Eheheh～! Faster %PRINT_MALE(@"Daddy:%CALLNAME:MASTER%-san", MASTER)%, faster～!」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMDW %SHOW_CHILDNAME(93)% exclaims, having the time of %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% life while holding tightly on to you.
		IF CFLAG:MASTER:現在位置 == CFLAG:93:現在位置
			PRINTFORMDW Meanwhile, %K93NICK()% watches you both with a bright smile shining from %HIS_HER(93, 0)% lips.
			PRINTFORML 「Fufufu... Don't tire %HIM_HER(MASTER, 0)% out too much, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%!」
			IF TALENT:93:愛欲 ;lust
				CALL HPH_PRINT,@"「I might want to have a bit of fun with %HIM_HER(MASTER, 0)% as wellHPH...」","W"
			ELSE
				PRINTFORMW 「Or else %HE_SHE(MASTER, 0)% won't have any energy left to carry me in %HIS_HER(MASTER, 0)% arms later...」
			ENDIF
		ELSE
			PRINTL
			PRINTFORMDW You continue running around until you can't take it anymore, at which point %SHOW_CHILDNAME(93)% lets out a satisfied sigh.
			CALL COLORMESSAGE(@"「Feeeh... That was a lot of fun, %PRINT_MALE(@"Daddy:%CALLNAME:MASTER%-san", MASTER)%...」", K93_CHILDCOLOR(), 2, 0)
		ENDIF
	CASE 5
		CALL COLORMESSAGE(@"「%PRINT_MALE(@"Dad:%CALLNAME:MASTER%-san", MASTER)%, look... do you think mom would like this one?」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMDW %SHOW_CHILDNAME(93)% comes running towards you with a pretty stone on %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% palm.
		PRINTFORMDW You nod, and tell %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to give it to %K93NICK()%.
		PRINTFORMDL %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% cheerfully runs towards %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother, handing %HIM_HER(MASTER, 0)% the small stone.
		CALL COLORMESSAGE(@"「Mommy... %PRINT_MALE(@"Dad:%CALLNAME:MASTER%-san", MASTER)% told me to give you this.」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMDL %K93NICK()% takes the stone with a bright grin, proceeding to ruffle %HIS_HER(93, 0)% %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%'s hair.
		PRINTFORMW 「This is a very good one, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%. I'll make sure to add it to my collection!」
		PRINTFORMDL %HE_SHE(93, 1)% shifts %HIS_HER(93, 0)% gaze towards you with a warm smile.
		PRINTFORMW 「And thanks to you as well, %K93_HONORIFIC(MASTER)%. You deserve it as much as %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%.」
	ENDSELECT
ELSE ;older
	IF IS_HERE(63, 73) && RAND:2
		PRINTFORMDL While spending some time with %SHOW_CHILDNAME(93)%, you overhear %CALLNAME:63% and %CALLNAME:73% talking about %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%.
		PRINTL
		IF RAND:2 ;ack couldn't think of anything else
			CALL CHARA_TEXT(73, @"「I've been thinking, Hime's %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)% is about to be old enough to get a job, yeah?」","W")
			CALL CHARA_TEXT(73, @"「Do you think I should maybe... you know, try to land %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% a position or something?」","W")
			PRINTFORMDL %CALLNAME:63% turns to looks at %HIS_HER(63, 0)% Rokurokubi friend with a smug smile.
			CALL CHARA_TEXT(63, @"「Mfufu～... That is true. But Banki-chan, are you worried for %SHOW_CHILDNAME(93)% or something?」","W")
			CALL CHARA_TEXT(73, @"「W-well, not really, it's just that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% is our friend's child, and I work in a restaurant, and...」","W")
			IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
				PRINTFORMDL %CALLNAME:63% smiles as %HE_SHE(63, 0)% puts a hand on %CALLNAME:73%'s shoulder, speaking with a reassuring tone.
				CALL CHARA_TEXT(63, @"「I know, I get it, but I'm sure %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% will be just fine.」","W")
				CALL CHARA_TEXT(63, @"「%HE_SHE_CHILD(93, 1, TALENT:93:育児中)%'s %CALLNAME:MASTER%'s and Waggy's %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%, after all.」","W")
			ELSE
				PRINTFORMDL %CALLNAME:73% stops, looking away as %HE_SHE(73, 0)% lets out a defeated sigh.
				CALL CHARA_TEXT(73, @"「Yeah, maybe I am just a tiny little bit worried from %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%.」","W")
			ENDIF
		ELSE
			CALL CHARA_TEXT(63, @"「Our %SHOW_CHILDNAME(93)% grew up so fast, didn't %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%?」","W")
			CALL CHARA_TEXT(73, @"「Wait, \"our\"? Don't say it like the child is ours, it's Wakasagihime's %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%!」","W")
			CALL CHARA_TEXT(63, @"「Yeah, but we had our hand in raising that %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)%, even if it was just a little.」","W")
			IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
				PRINTFORMDL %CALLNAME:73% lets a small smile escape from %HIS_HER(73, 0)% lips, but looks away before %CALLNAME:63% can notice it.
				CALL CHARA_TEXT(73, @"「...I will concede this time, maybe it's something that we should be proud of.」","W")
			ELSE
				PRINTFORMDL %CALLNAME:73% stares at %SHOW_CHILDNAME(93)%, before looking away while trying %HIS_HER(73, 0)% best to maintain a neutral expression.
				CALL CHARA_TEXT(73, @"「Well, while I don't disagree, I do wonder if we could have done better...」","W")
			ENDIF
		ENDIF
		RETURN
	ENDIF

	IF RAND:2 ;COULDN'T THINK OF ANYTHING ELSE HERE EITHER!
		PRINTFORMDL %SHOW_CHILDNAME(93)% approaches you and %K93NICK()% with something to say at the tip of %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% tongue.
		CALL COLORMESSAGE(@"「%PRINT_MALE(@"Dad:%CALLNAME:MASTER%-san", MASTER)%, Mom. There is something I want to know...」", K93_CHILDCOLOR(), 2, 0)
		IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
			PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% proceeds to ask and discuss about a few important things relating to %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% future.
			PRINTFORMDW The confidence and maturity present in %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% voice almost makes it feel like you're talking to a full fledged adult...
			CALL COLORMESSAGE(@"「...But that's all that I wanted to talk about.」", K93_CHILDCOLOR(), 2, 0)
			PRINTFORMW 「Mhmhmm, I understand. Please, don't be afraid to ask us for any help if you ever need it.」
			PRINTL
			PRINTFORMDL As %SHOW_CHILDNAME(93)% walks away, %K93NICK()% leans in close to your ear and playfully whispers.
			PRINTFORMW 「Fufufu～... Our "little" %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% grew up so fast, didn't %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%?」
		ELSE
			PRINTFORMDW It seems like %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% only had a few simple things to ask you both.
			PRINTFORMDW And with %K93NICK()%'s help, you are able to give %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% a satisfactory answer.
			PRINTFORML 「And that's how that works. But... anything else you want to ask, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%?」
			CALL COLORMESSAGE(@"「No, I think that was it. Thank you for helping me out, you two.」", K93_CHILDCOLOR(), 2, 0)
		ENDIF
	ELSE
		IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
			CALL COLORMESSAGE(@"「Hey, Mom, do you need help with anything?」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORML 「Mhmhmm! I would be really really grateful if you helped me with this...」
			PRINTFORMDW You observe as %SHOW_CHILDNAME(93)% dutifully helps %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother with a few chores.
		ELSE
			PRINTFORMW 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, would you mind lending me a hand with something for a little bit?」
			CALL COLORMESSAGE(@"「Mooooom... Can you really not do that with without me?」", K93_CHILDCOLOR(), 2, 0)
			PRINTFORMDW %K93NICK()% stares at %SHOW_CHILDNAME(93)% in silence, until %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% throws %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% arms up in surrender.
			CALL COLORMESSAGE(@"「Ugh, fine! I'll do it, just this once...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% helps %K93NICK()% with chores with a heavy frown on %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% face.
		ENDIF
	ENDIF
ENDIF


;-------------------------------------------------
;口上専用手紙イベント。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;専用イベントを作りたい場合は上下のSKIPSTART~SKIPENDを外してください。
;手紙イベント時に1/2の確率でこちらが発生します。
;ARG 子供の番号（例：子供の名前は『%CHILDNAME:X:ARG%』）
;Use ARG to refer to child number, like "%CHILDNAME:X:ARG%"
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_DAIRY_口上手紙(ARG)
;Receiving letter from adult child, generic
;-------------------------------------------------
PRINTFORML 「%K93_HONORIFIC(MASTER)%, look! It seems like %K93_CHILDHONORIFIC(93, ARG)% sent us a letter!」
PRINTFORMDW %K93NICK()% leans closer to you with the letter open in %HIS_HER(93, 0)% hands, reading it alongside you.
SELECTCASE RAND:3
CASE 0
	IF CHILD_LOVE:93:ARG >= 200
		PRINTFORML 「It says here that %HIM_HER_CHILD(93, 0, ARG)% marriage is doing very well...」
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「And that the love between you and me inspires %HIM_HER_CHILD(93, 0, ARG)% to be a good %K93_PRINT_CHILDSEX("husband", 93, ARG)%!」
		ELSE
			PRINTFORML 「And that %HE_SHE_CHILD(93, 0, ARG)% is very happy to have someone to give %HIS_HER_CHILD(93, 0, ARG)% love to!」
		ENDIF
		PRINTFORMW 「Fufufu... Do you think they will be giving us grandchildren any time soon～?」
	ELSE
		PRINTFORMW 「Oh, it says here that their marriage with "%ランダムキャラ_命名()%" hasn't been doing very well...」
		PRINTFORMW 「That's strange, didn't %HIS_HER_CHILD(93, 0, ARG)% %K93_PRINT_CHILDSEX("wife_:husband", 93, ARG)% have a different name before?」
		PRINTFORMDL %HIS_HER(93, 1)% hands faintly tremble as %HE_SHE(93, 0)% lets out a downhearted sigh.
		PRINTFORMW 「Fwuuuh... I just hope everything resolves itself, and that they end up together again.」
	ENDIF
CASE 1
	IF CHILD_LOVE:93:ARG >= 200
		PRINTFORMW 「It says here that %HE_SHE_CHILD(93, 0, ARG)% is doing very well in %HIS_HER_CHILD(93, 0, ARG)% job!」
		PRINTFORMW 「And that %HE_SHE_CHILD(93, 0, ARG)% might be paid even more in the future.」
		PRINTFORMW 「Fufufu... I will admit that this makes me feel a bit ashamed, since I never had a "job" of my own...」
		PRINTFORMDL %HE_SHE(93, 1)% softly shakes %HIS_HER(93, 0)% head from side to side.
		PRINTFORMW 「No, I shouldn't think about that. Instead, I should be proud that our %K93_PRINT_CHILDSEX("son", 93, ARG)% is doing well out there.」
	ELSE
		PRINTFORML 「It says here that %HE_SHE_CHILD(93, 0, ARG)% is having problems with keeping a job.」
		PRINTFORMW 「And that %HE_SHE_CHILD(93, 0, ARG)% asks if we know someone who would hire them...」
		PRINTFORMDL %HE_SHE(93, 1)% lets out an unsteady sigh, turning %HIS_HER(93, 0)% sight away from the letter.
		PRINTFORMW 「Fwuuuh... I wonder if there is any other way to help our little %K93_CHILDHONORIFIC(93, ARG)%?」
		PRINTFORMW 「I wouldn't be opposed to letting %HIM_HER_CHILD(93, 0, ARG)% move back in with us, that wouldn't feel right...」
	ENDIF
CASE 2
	PRINTFORMW 「It says here that everything is doing well for \@ CHILD_LOVE:93:ARG >= 200 ? %HIM_HER_CHILD(93, 0, ARG)% # once \@.」
	PRINTFORMW 「%HE_SHE_CHILD(93, 1, ARG)% asks we are we doing, and if we need any help.」
	PRINTFORMDL A smile quickly dawns on %HIS_HER(93, 0)% lips as %HE_SHE(93, 0)% continues to read the letter.
	PRINTFORMW 「And %HE_SHE_CHILD(93, 0, ARG)% is also asking for recipe of the parfait I make for them as a child...」
	PRINTFORMW 「Fufufu! I will be sure to write back to %HIM_HER_CHILD(93, 0, ARG)% as soon as I can.」
ENDSELECT
;-------------------------------------------------


;-------------------------------------------------
;手紙イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;ARG is once again used to refer to child
;ARG	子供の番号（例：子供の名前は『%CHILDNAME:X:ARG%』）
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_DAIRY_共通手紙(ARG, ARGS)
;Receiving letter from adult child but with specific stuff
;-------------------------------------------------
IF ARGS == "すけこまし" ;child saw you being a manwhore, sad!
	PRINTFORMW 「%K93_HONORIFIC(MASTER)%, look! %K93_CHILDHONORIFIC(93, ARG)% sent us a letter!」
	PRINTFORMW 「It's mostly saying that %HE_SHE_CHILD(93, 0, ARG)% is doing well, but there's also a part just for you...」
	PRINTFORMW 「I'm left a bit confused by it, so it's better that you give it a look yourself.」
	PRINTFORMDW %K93NICK()% smiles as %HE_SHE(93, 0)% holds the letter open for you with both hands.
	PRINTL
	CALL D_LINE
	CALL COLORMESSAGE(@"    Mother, make absolute sure that %CALLNAME:MASTER%-san reads this.", K93_CHILDCOLOR(ARG), 1, 2)
	PRINTL
	CALL COLORMESSAGE(@"            To %CALLNAME:MASTER%", K93_CHILDCOLOR(ARG), 1, 2)
	CALL COLORMESSAGE(@"            I know what you did.", C_RED, 1, 1)
	PRINTL
	PRINTL
	CALL COLORMESSAGE(@"                                  -Your beloved %K93_PRINT_CHILDSEX("son", 93, ARG)%, %CHILDNAME:93:ARG%", K93_CHILDCOLOR(ARG), 1, 2)
	CALL D_LINE
	PRINTW
	PRINTFORMDW ...Oh.
	PRINTFORMDL %HE_SHE(93, 1)% leans into your view, looking at you with eyes full of innocence.
	PRINTFORMW 「So, do tell me, what does %HE_SHE_CHILD(93, 0, ARG)% know that I don't know?」
ELSEIF ARGS == "金の無心" ;child needs money
	PRINTFORML 「%K93_HONORIFIC(MASTER)%, %K93_CHILDHONORIFIC(93, ARG)% sent us a request for help...」
	PRINTFORMDW %K93NICK()%'s hands tremble as %HE_SHE(93, 0)% shows you an already opened letter.
	PRINTFORMW 「It seems like %HE_SHE_CHILD(93, 0, ARG)% came across some difficulties, and is in dire need of some money.」
	IF CHILD_LOVE:93:ARG >= 200
		PRINTFORML 「Well, I suppose that this what parents are for, isn't it?」
		PRINTFORMW 「To be there for their children, even after they're all grown up!」
		PRINTFORMW 「We should definitely send %HIM_HER_CHILD(93, 0, ARG)% money, %K93_HONORIFIC(MASTER)%.」
		PRINTFORMW 「I'm sure %HE_SHE_CHILD(93, 0, ARG)% can turn %HIS_HER_CHILD(93, 0, ARG)% situation around with some help.」
	ELSE
		PRINTFORML 「Fwuuuh... Something tells me that this is something of %HIS_HER_CHILD(93, 0, ARG)% own doing.」
		PRINTFORMW 「But at the same time, this is what parents are for, isn't it?」
		PRINTFORMW 「I suppose we should send %HIM_HER_CHILD(93, 0, ARG)% money, even if it isn't much...」
	ENDIF
ELSEIF ARGS == "仕送り" ;child gives you money
	PRINTFORML 「%K93_HONORIFIC(MASTER)%, look! %K93_CHILDHONORIFIC(93, ARG)% sent us a gift!」
	PRINTFORMDW %K93NICK()% waves an already opened letter at you with a few yen bills attached.
	IF CHILD_LOVE:93:ARG >= 200
		PRINTFORMW 「%HE_SHE_CHILD(93, 1, ARG)% made some surplus money recently, so %HE_SHE_CHILD(93, 0, ARG)% decided to send us some of it.」
		PRINTFORMW 「I'm just happy that %HE_SHE_CHILD(93, 0, ARG)% is doing well, to be honest.」
	ELSE
		PRINTFORML 「It seems like %HIS_HER_CHILD(93, 0, ARG)% life has finally started turn around...」
		PRINTFORMW 「So %HE_SHE_CHILD(93, 0, ARG)% decided to send us both %HIS_HER_CHILD(93, 0, ARG)% gratitude and some money!」
		PRINTFORMW 「Fufufu... Doesn't this make you feel happy as well, %K93_HONORIFIC(MASTER)%?」
	ENDIF
ENDIF
;-------------------------------------------------


;-------------------------------------------------
;Daily events at school
;ARG is once again used to refer to child
;デイリーイベント：子供が寺子屋で
;ARG	子供の番号（例：子供の名前は『%CHILDNAME:X:ARG%』）
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_DAIRY_寺子屋(ARGS,ARG,ARG:1)
IF ARGS == "怪我させた" ;hit someone, little shit
	PRINTFORMW 「It seems that %K93_CHILDHONORIFIC(93, ARG)% was being picked on, and %HE_SHE_CHILD(93, 0, ARG)% simply decided to fight back.」
	PRINTFORMW 「But even though it was in self defense, %HE_SHE_CHILD(93, 0, ARG)% clearly went a bit too far.」
	PRINTFORMDL %K93NICK()% lets out a sigh, growing agitated as %HE_SHE(93, 0)% continues to speak.
	PRINTFORMW 「Fwuuuh... The teacher told me %HE_SHE_CHILD(93, 0, ARG)% used quite a few cusses!」
	PRINTFORMW 「I have no idea where %HE_SHE_CHILD(93, 0, ARG)% learned any of that, or from where all that aggression comes from, but...」
	PRINTFORMDL %HE_SHE(93, 1)% turns %HIS_HER(93, 0)% saddened gaze towards you.
	PRINTFORMW 「%K93_HONORIFIC(MASTER)%, I ask that you have a serious talk with %K93_CHILDHONORIFIC(93, ARG)%.」
	PRINTFORMW 「This requires both strength and tact, things that I don't believe I have.」
ELSEIF ARGS == "褒められた" ;behaved well, good job
	PRINTFORMW 「Our little %K93_CHILDHONORIFIC(93, ARG)% has been doing very well at school!」
	PRINTFORMW 「Apparently, %HE_SHE_CHILD(93, 0, ARG)% is always paying attention to classes and is frequently asking question.」
	PRINTFORMDL %K93NICK()% pauses, still smiling as %HE_SHE(93, 0)% tilts %HIS_HER(93, 0)% head to the side in confusion.
	PRINTFORMW 「...Which isn't it what children are supposed to do when learning, anyway?」
	PRINTFORMW 「Well, maybe %HE_SHE_CHILD(93, 0, ARG)% does it more than anyone else in %HIS_HER_CHILD(93, 0, ARG)% class...」
	PRINTFORMDL %HE_SHE(93, 1)% starts to trail off, but quickly shakes %HIS_HER(93, 0)% head and gets back on track.
	PRINTFORMW 「Either way, I think it's only fair that %HE_SHE_CHILD(93, 0, ARG)% gets something nice for it!」
	PRINTFORMW 「Maybe we should give %HIM_HER_CHILD(93, 0, ARG)% gift, or maybe you could take %HIM_HER_CHILD(93, 0, ARG)% out to somewhere nice!」
ENDIF
