;-------------------------------------------------
;手紙イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;ARG is once again used to refer to child
;ARG	子供の番号（例：子供の名前は『%CHILDNAME:X:ARG%』）
;-------------------------------------------------

@M_KOJO_EN_EVENT_K93_CHILD_DAIRY_共通手紙(ARG, ARGS)
;Receiving letter from adult child but with specific stuff
;-------------------------------------------------
IF ARGS == "すけこまし" ;child saw you being a manwhore, sad!
	PRINTFORMW 「%K93_HONORIFIC(MASTER)%, 봐! %K93_CHILDHONORIFIC(93, ARG)%가 우리에게 편지를 보냈어!」
	PRINTFORMW 「주로 %HE_SHE_CHILD(93, 0, ARG)%가 잘 지낸다는 내용인데, 당신만을 위한 부분도 있네...」
	PRINTFORMW 「내가 좀 헷갈려서 말이야, 직접 한번 봐주는 게 좋을 것 같아.」
	PRINTFORMDW %K93NICK()%은(는) 두 손으로 편지를 펼쳐 들고 있는 %HE_SHE(93, 0)%를 보며 미소를 지었다.
	PRINTL
	CALL D_LINE
	CALL COLORMESSAGE(@"    어머니, %CALLNAME:MASTER%님이 이것을 꼭 읽도록 해 주세요.", K93_CHILDCOLOR(ARG), 1, 2)
	PRINTL
	CALL COLORMESSAGE(@"            To %CALLNAME:MASTER%", K93_CHILDCOLOR(ARG), 1, 2)
	CALL COLORMESSAGE(@"            네가 무슨 짓을 했는지 알고 있어.", C_RED, 1, 1)
	PRINTL
	PRINTL
	CALL COLORMESSAGE(@"                                  당신의 사랑하는 %K93_PRINT_CHILDSEX("son", 93, ARG)%, %CHILDNAME:93:ARG%", K93_CHILDCOLOR(ARG), 1, 2)
	CALL D_LINE
	PRINTW
	PRINTFORMDW ...Oh.
	PRINTFORMDL %HE_SHE(93, 1)%는 순수함으로 가득 찬 눈빛으로 당신을 바라보며 당신에게 기댄다.
	PRINTFORMW 「그러니 말해줘, %HE_SHE_CHILD(93, 0, ARG)%는 내가 모르는 것을 뭘 알고 있니?」
ELSEIF ARGS == "金の無心" ;child needs money
	PRINTFORML 「%K93_HONORIFIC(MASTER)%, %K93_CHILDHONORIFIC(93, ARG)%가 도움을 청하는 편지를 보냈다...」
	PRINTFORMDW %K93NICK()%'의 손이 떨리면서 %HE_SHE(93, 0)%가 이미 열린 편지를 보여준다.
	PRINTFORMW 「%HE_SHE_CHILD(93, 0, ARG)%가 어떤 어려움을 겪고 있는 것 같으며, 돈이 절실한 상태인 듯하다.」
	IF CHILD_LOVE:93:ARG >= 200
		PRINTFORML 「음, 부모란 이런 거겠지, 그렇지 않아?」
		PRINTFORMW 「다 자란 아이들에게도 곁에 있어 주는 거지!」
		PRINTFORMW 「우리는 %HIM_HER_CHILD(93, 0, ARG)%에게 돈을 보내야 해, %K93_HONORIFIC(MASTER)%. 」
		PRINTFORMW 「%HE_SHE_CHILD(93, 0, ARG)%가 약간의 도움으로 %HIS_HER_CHILD(93, 0, ARG)%의 상황을 바꿀 수 있을 거라고 확신해.」
	ELSE
		PRINTFORML 「후우... 이거 뭔가 %HIS_HER_CHILD(93, 0, ARG)%가 저지른 일 같군.」
		PRINTFORMW 「하지만 동시에 부모란 그런 거 아니겠어?」
		PRINTFORMW 「별거 아니더라도 %HIM_HER_CHILD(93, 0, ARG)%에게 돈을 보내야 할 것 같다...」
	ENDIF
ELSEIF ARGS == "仕送り" ;child gives you money
	PRINTFORML 「%K93_HONORIFIC(MASTER)%, 봐! %K93_CHILDHONORIFIC(93, ARG)%가 우리에게 선물을 보냈어!」
	PRINTFORMDW %K93NICK()%은(는) 이미 열린 편지에 몇 장의 엔화 지폐를 붙여서 당신을 향해 흔든다.
	IF CHILD_LOVE:93:ARG >= 200
		PRINTFORMW 「%HE_SHE_CHILD(93, 1, ARG)%가 최근에 여윳돈을 좀 벌게 되어서 %HE_SHE_CHILD(93, 0, ARG)%는 우리에게 일부를 보내기로 결정했어.」
		PRINTFORMW 「솔직히 말해서 %HE_SHE_CHILD(93, 0, ARG)%가 잘 지내고 있다는 게 그냥 기쁘네.」
	ELSE
		PRINTFORML 「%HIS_HER_CHILD(93, 0, ARG)%의 삶이 드디어 전환점을 맞은 것 같아...」
		PRINTFORMW 「그래서 %HE_SHE_CHILD(93, 0, ARG)%가 우리 둘에게 %HIS_HER_CHILD(93, 0, ARG)%의 감사와 약간의 돈을 보내기로 결정했어!」
		PRINTFORMW 「후후후... 당신도 기분이 좋아지지 않니, %K93_HONORIFIC(MASTER)%?」
	ENDIF
ENDIF
