IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) != TALENT:93:育児中
	PRINTDATADL
		DATAFORM %SHOW_CHILDNAME(93)% starts to talk a bit more coherently %SPLIT_G(@"as well:soon after")%.
		DATAFORM %SHOW_CHILDNAME(93)% starting to speak, but it sounds more like singing at times...
		DATAFORM %SHOW_CHILDNAME(93)% is starting speak, but %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% voice is so soft that you almost can't hear it.
		DATAFORM %SHOW_CHILDNAME(93)% recently started to speak, and %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% is quite chatty...
		DATAFORM %SHOW_CHILDNAME(93)% starts to speak. A bit later than usual, but everyone has their time.
	ENDDATA
ELSE
	PRINTFORMDL Suddenly, %SHOW_CHILDNAME(93)% starts to babble while pointing at %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother.
	CALL COLORMESSAGE(@"「Dabuhbah... mabahda... madama...」", K93_CHILDCOLOR(), 2, 0)
	PRINTFORMW 「Look! It seems like our little %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% is trying to say something!」
	PRINTFORMW 「Slowly now, take as long as you need to...」
	CALL COLORMESSAGE(@"「Dah... Mama! Mmmmama～!」", K93_CHILDCOLOR(), 1, 0)
	PRINTFORMDL %K93NICK()% immediately perks up, looking at you and then at %SHOW_CHILDNAME(93)% again.
	PRINTFORMW 「%K93_HONORIFIC(MASTER)%, did you hear that just now!?」
	PRINTFORMW 「Our little %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)% just called me "mama"!」
	CALL COLORMESSAGE(@"「Mama, mama! M～aaama!」", K93_CHILDCOLOR(), 2, 0)
	PRINTFORMW 「Fufufu! That's so nice to hear, isn't it?」
	PRINTL
	PRINTFORMDW %K93NICK()% then points a finger at you, with %SHOW_CHILDNAME(93)%'s gaze following shortly after.
	PRINTFORMW 「Now, do you know who that is? Repeat with me... "papa"!」
	PRINTFORMDL %SHOW_CHILDNAME(93)% stares at you for a few seconds before finally opening %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mouth.
	IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200 ;child affection bigger or equal than 200
		CALL COLORMESSAGE(@"「Pahdah... Dadah... Papa!」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMDW %HIS_HER_CHILD(93, 1, TALENT:93:育児中)% words are immediately met by a flurry of applause from %K93NICK()%.
		PRINTFORMW 「Correct! %K93_HONORIFIC(MASTER)% is your papa, and I am your mother!」
		PRINTFORMW 「Fufufu... Our %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% learns so fast, doesn't %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%?」
	ELSE
		CALL COLORMESSAGE(@"「Pahmah... Ma... Mamama?」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMDL %K93NICK()%'s smile slowly wanes, a defeated sigh leaving %HIS_HER(93, 0)% mouth.
		PRINTFORMW 「Fwuuuh... I suppose %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% will get there someday.」
	ENDIF
ENDIF
