;from here on out, repeatable little events
;-------------------------------------------------
;育児イベント登下校時の地の文。
;Going to school
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_登下校(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中 || CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) == TALENT:93:育児中 ;only play for first and last
	IF !ARG ;going to school
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, come closer! I need to make sure everything is okay with you...」
			CALL COLORMESSAGE(@"「Wait, again? Mom... didn't we already do that?」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMDW %K93NICK()% spends a few minutes preening %SHOW_CHILDNAME(93)% before sending %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% off.
		CASE 1
			CALL COLORMESSAGE(@"「Mommy, before I go... I'll be coming home earlier today.」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORML 「Oh, that's okay. I shall be waiting for you here like always.」
			PRINTFORMW 「Now go out there and make both your mom and %PRINT_MALE(@"your father:%K93_HONORIFIC(MASTER)%", MASTER)% proud!」
		CASE 2
			PRINTFORML 「Make sure you have a good day at school today, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
			CALL COLORMESSAGE(@"「Mhmm! I'll try my best, mom!」", K93_CHILDCOLOR(), 2, 0)
		ENDSELECT
	ELSE ;coming back from school
		SELECTCASE RAND:3
		CASE 0
			CALL COLORMESSAGE(@"「Mom, I'm home!」", K93_CHILDCOLOR(), 2, 0)
			PRINTFORMDL %SHOW_CHILDNAME(93)% stops and looks around.
			CALL COLORMESSAGE(@"「...Is %PRINT_MALE(@"dad:%CALLNAME:MASTER%-san", MASTER)% here?」", K93_CHILDCOLOR(), 2, 0)
			IF CFLAG:MASTER:現在位置 == CFLAG:93:現在位置 ;player is there (actually, don't these require you to be there anyway? why did i do this?)
				PRINTFORMW 「Hmmm? Oh, %HE_SHE(MASTER, 0)% is right over there. Why do you ask?」
			ELSE
				PRINTFORMW 「%HE_SHE(MASTER, 1)% is not here right now. Why do you ask?」
			ENDIF
			CALL COLORMESSAGE(@"「Oh, uhhh... I was just wondering, that's all.」", K93_CHILDCOLOR(), 2, 0)
		CASE 1
			PRINTFORMDW %K93NICK()% perks up as soon as %SHOW_CHILDNAME(93)% walks through the door.
			PRINTFORMW 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, you're home! Come here your mom a hug～!」
			CALL COLORMESSAGE(@"「Can't it wait? I'm so tired...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMDW Despite %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% words, %SHOW_CHILDNAME(93)% envelops %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother in a warm embrace.
			PRINTFORML 「Fufufu... That wasn't hard now, was it?」
			PRINTFORMW 「I'm not sure why, but I missed you a lot today...」
		CASE 2
			PRINTFORMW 「Oh, you're here! Welcome home, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
			PRINTFORMDL %K93NICK()% looks at %HIS_HER(93, 0)% %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)% with curiosity painted in %HIS_HER(93, 0)% eyes.
			PRINTFORMW 「So... what things did you learn at school today?」
			CALL COLORMESSAGE(@"「%SPLIT_G("Nothing much, just the usual:Some interesting stuff, actually:Something very boring, but")%...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMDW %SHOW_CHILDNAME(93)% spends a few minutes talking with %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother.
		ENDSELECT
	ENDIF

	IF CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) == TALENT:93:育児中 && CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 4 ;don't play this if it's less than quadruplets
		PRINTL
		PRINTFORMDL %K93NICK()% lets out a tired sigh as soon as %SHOW_CHILDNAME(93)% walks out of view.
		IF !ARG ;going
			PRINTFORML 「Faaah... That is all of them, I'm pretty sure!」
			PRINTFORMW 「Sometimes I worry if their teacher can handle all those children or not...」
		ELSE ;coming
			PRINTFORML 「Faaah...! All accounted for and safe, good!」
			SIF !RAND:5 ;don't play this shitty joke all the time
				PRINTFORML 「That's quite a... school of fish we have for ourselves now～」
			WAIT
		ENDIF
	ENDIF
ELSE
	PRINTFORMD %K93NICK()%
	IF !ARG ;going
		PRINTDATAD
			DATAFORM  waves %SHOW_CHILDNAME(93)% away to school
			DATAFORM  gives %SHOW_CHILDNAME(93)% a pat on the back as %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% walks by
			DATAFORM  stops %SHOW_CHILDNAME(93)% for a cheek kiss before letting %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% go
			DATAFORM  tells %SHOW_CHILDNAME(93)% to behave as %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% walks by
		ENDDATA
	ELSE ;coming
		PRINTDATAD
			DATAFORM  welcomes %SHOW_CHILDNAME(93)% back home with a warm smile
			DATAFORM  smiles as %SHOW_CHILDNAME(93)% gives %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother a polite bow before entering home
			DATAFORM  asks %SHOW_CHILDNAME(93)% if %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% had a good day
			DATAFORM  stops %SHOW_CHILDNAME(93)% and gives %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% a warm, motherly hug
		ENDDATA
	ENDIF
	PRINTFORMDL ...
ENDIF

;-------------------------------------------------
;育児イベント食事時。
;Feeding
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "授乳" ;breastfeeding
	IF !RAND:3 && EXP:93:噴乳経験 >= 50 && K93_LOVE_LUST_LOVER()
		PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%～! Please, leave some for %K93_HONORIFIC(MASTER)%～!」
		PRINTFORMW 「Fufufu... Like %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%, like %PRINT_MALE(@"father_:mother", MASTER)%...」
	ELSE
		PRINTDATAW
			DATAFORM 「Drink as much as you need to, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%...」
			DATAFORM 「There, there... You were hungry, weren't you?」\n「That's okay, I would be crying if I were hungry too.」
			DATAFORM 「Fwaaah... You seem to be enjoying this a lot, aren't you?」\n「That's good, seeing you happy makes me happy as well...」
		ENDDATA
	ENDIF
ELSEIF ARGS == "離乳食" ;baby food
	PRINTDATAW
		DATAFORM 「This is the last spoonful for now... and there!」\n「You made way less of a mess this time, good job!」
		DATAFORM 「Good job, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%! You ate almost everything!」\n「Now, to clean up all of this mess...」
		DATAFORM 「Here %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, open wide...」\n「There, there, good %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)%.」
	ENDDATA
ELSEIF ARGS == "幼少期" ;as a child
	SELECTCASE RAND:3
	CASE 0
		PRINTFORMDL %K93NICK()% looks at %SHOW_CHILDNAME(93)% with a smile as %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% guides food to %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% own mouth.
		CALL COLORMESSAGE(@"「Mommy... Why are you looking at me like that?」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMW 「Fufufu... I just like to look at you while you eat, is all!」
	CASE 1
		CALL COLORMESSAGE(@"「Mommy... I don' think I wanna eat this anymore...」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORML 「Come on, there's just a little bit left, you have to push through!」
		PRINTFORMW 「If you eat it, I promise to give you some of my Mermaid Parfait for dessert.」
	CASE 2
		CALL COLORMESSAGE(@"「Fahaah...! Mommy, it's too hot!」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMW 「Oh dear, I'm so sorry! Give it here, I'll cool it down for you...」
	ENDSELECT
ELSE ;older
	SELECTCASE RAND:3
	CASE 0
		CALL COLORMESSAGE(@"「Phew! Thanks a lot mom, that was very good meal.」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORML 「Really? Then maybe I should teach you how to cook like me!」
		PRINTFORMW 「I may not be the best cook around, but I'm sure I can show you a thing or two.」
	CASE 1
		PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, while it's a good thing that you are not picky, I have to ask...」
		PRINTFORMW 「Is there not any sort of food you don't like eating? At all?」
		CALL COLORMESSAGE(@"「Actually, there is something I don't like. It's fish.」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMDL %K93NICK()% closes %HIS_HER(93, 0)% eyes, letting out a sigh of relief.
		PRINTFORMW 「That's good to hear... No, you have no idea how relieved I am to hear that.」
	CASE 2
		PRINTFORML 「Say, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%... is there anything you would like to eat?」
		PRINTFORML 「You can ask for anything you want, and I will try to make it.」
		CALL COLORMESSAGE(@"「For real? Kind of hard to decide on just one thing, but...」", K93_CHILDCOLOR(), 2, 0)
	ENDSELECT
ENDIF

;-------------------------------------------------
;育児イベント入浴
;Bathing
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_BATH(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "幼児期" ;early childhood
	PRINTFORML 「Fufufu.... Look at that beautiful smile of yours!」
	PRINTFORMW 「It's good that you enjoy water as much as I do, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
ELSEIF ARGS == "幼少期" ;childhood
	CALL COLORMESSAGE(@"「Mommy... Do we reaaa～lly have to leave the water now?」", K93_CHILDCOLOR(), 1, 0)
	PRINTFORML 「I guess there is no problem if we stay here a little longer so I can give you a proper wash...」
	PRINTFORMW 「Now, close your eyes! You wouldn't want this getting anywhere near them.」
ELSE ;older
	IF !RAND:5
		PRINTFORMW 「Say, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%... why do you always take so long in the bath?」
		PRINTFORMW 「The only times you finish bathing quickly is when we do it together, and I'm not sure why.」
		PRINTFORMDL %SHOW_CHILDNAME(93)% freezes up and looks away from %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother.
		CALL COLORMESSAGE(@"「W-well... That's uhmm... Hahaha... Yeah that is...」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMDW Noticing %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% obvious discomfort, you interject and tell %K93NICK()% to leave it alone.
		IF TALENT:93:愛欲
			PRINTFORMW 「Fufufu! That was an innocent question to ask, so there is no reason for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to get flustered～!」
		ELSE
			PRINTFORML 「Oh, did I say something that I shouldn't have?」
			PRINTFORMW 「Then I'm sorry, I will try to be more careful next time...」
		ENDIF
	ELSE
		PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, there is nothing wrong with bathing with your parents.」
		PRINTFORML 「Come on, no need be shy, we used to see you naked all the time!」
		CALL COLORMESSAGE(@"「W-well yeah, but that was a different thing entirely...」", K93_CHILDCOLOR(), 2, 0)
	ENDIF
ENDIF

;-------------------------------------------------
;育児イベント就寝
;Bedtime
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_SLEEPING(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "幼児期"
	IF RAND:2
		PRINTFORML 「Fwaaaah... It took a little while, but you finally fell asleep.」
		PRINTFORMW 「I hope that you continue like this all the way into the morning...」
	ELSE
		PRINTFORML 「Fufufu... That's good, you fell asleep to easily today!」
		PRINTFORMW 「But seeing you with your eyes closed like that is making me sleepy...」
	ENDIF
	PRINTFORMDL %K93NICK()% %SPLIT_G(@"leans in and deliver a soft kiss to %HIS_HER(93, 0)% %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%'s forehead:gently ruffles %HIS_HER(93, 0)% %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%'s hair")%.
	PRINTFORMW 「Sleep tight, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
ELSEIF ARGS == "幼少期"
	SELECTCASE RAND:4
	CASE 0 TO 1 ;more common
		PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, what do we say to someone when you are about to go to sleep?」
		CALL COLORMESSAGE(@"「Oh... Uhmm... It's... Good night, mommy...」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMW 「Correct, just like that. Good night, my dear %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
	CASE 2
		CALL COLORMESSAGE(@"「Mommy... Can you stay here with me? Just for a little bit, I swear...」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORML 「Oh, of course! If it's just for a few minutes, then it shouldn't be a problem.」
		PRINTFORMDW %K93NICK()% sits at the edge of %SHOW_CHILDNAME(93)%'s bed, keeping %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% company until %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% falls asleep.
	CASE 3
		CALL COLORMESSAGE(@"「Mommy... Can you... sing me a song? Just until I sleep...」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORML 「Oh, I'd love to! Close your eyes and focus on my voice, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%...」
		PRINTFORMDW %K93NICK()% sits near %SHOW_CHILDNAME(93)%, gently humming a tune until %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% falls asleep.
	ENDSELECT
ELSE
	CALL COLORMESSAGE(@"「I'm going to bed now... Good night, mom. Sleep well, %PRINT_MALE(@"dad:%CALLNAME:MASTER%-san", MASTER)%.」", K93_CHILDCOLOR(), 1, 0)
	PRINTFORMW 「Hmhmm. Good night, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%. %SPLIT_G("And don't let the bedbugs bite!:Have nice dreams...")%」
ENDIF

;-------------------------------------------------
;育児イベント川の字でおやすみ
;Player, mother and child sleeping together
;-------------------------------------------------
;@M_KOJO_EN_EVENT_K93_CHILD_RAISING_OYASUMI(ARGS,ARG,ARG:1)
;PRINTFORML
;already covered under 402,就寝(?)
