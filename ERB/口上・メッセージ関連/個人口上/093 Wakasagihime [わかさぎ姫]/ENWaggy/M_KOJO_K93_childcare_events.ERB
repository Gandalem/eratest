;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_離乳
;Weaning (you know, getting the baby accustomed to actual food)
;-------------------------------------------------
CALL SET_KOJO_COLOR(93)
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) != TALENT:93:育児中
	PRINTDATADL
		DATAFORM %SHOW_CHILDNAME(93)% starts weaning just like %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% %COND_STR(@"s", CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 3)%.
		DATAFORM %SHOW_CHILDNAME(93)% stops drinking from %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother's breasts as well, slowly %SPLIT_G(@"transitioning to:moving to:eating")% solid foods instead.
		DATAFORM %K93NICK()% starts to feed %SHOW_CHILDNAME(93)% solid food, %SPLIT_G(@"moving:changing")% %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% diet away from breast milk.
	ENDDATA
ELSE
	PRINTFORMW 「%SPLIT_G(@"Tasty, isn't it? Good, because here comes more:Come on, open wide now:Here it comes, say \"aaahn\" for mama")%～...」
	PRINTFORMDL %K93NICK()% smiles as %HE_SHE(93, 0)% carefully guides a spoon of homemade baby food into %SHOW_CHILDNAME(93)%'s mouth.
	PRINTFORMDW Despite its unappealing appearance, %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% puts almost no resistance to %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother's feeding.
	CALL K93_TIMEPASSDOTS(, "w")
	PRINTFORMDL After a while, %SHOW_CHILDNAME(93)% turns %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% face away from the spoon.
	PRINTFORMW 「Ah, I assume that means you had enough already.」
	PRINTFORMDW %K93NICK()% puts both the plate and the spoon down before turning towards you with a grin.
	PRINTFORMW 「You missed %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% feeding just by a little, %K93_HONORIFIC(MASTER)%.」
	IF CFLAG:93:BirthEventsCount == 1
		PRINTFORML 「But it's okay, I received some good advice and even some help from my friends.」
		PRINTFORMW 「%K93_HONORIFIC(63)% suggested giving %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% meat, but %K93_HONORIFIC(73)% said that mashed up fruits and vegetables are better for now.」
		PRINTFORML 「In fact, it was %K93_HONORIFIC(73)% that helped me cook this mixture I have here, and %HE_SHE(73, 0)% even gave me a few tips on what to do.」
		PRINTFORMW 「I suppose %HE_SHE(73, 0)% must have read about that in a book, but it was interesting seeing %HIM_HER(73, 0)% talk about those things.」
		IF TALENT:93:母乳体質 == 2
			PRINTFORMDL %HE_SHE(93, 1)% leans %HIS_HER(93, 0)% head to the side, bringing a hand to %HIS_HER(93, 0)% chin.
			PRINTFORMW 「But what is strange is that the milk from my... breasts is still flowing.」
			PRINTFORMW 「Shouldn't they stop now that our %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% is eating food?」
			PRINTFORMW 「Maybe it takes a while for it stop, but I'm not really sure...」
		ELSE
			PRINTFORMDL %HE_SHE(93, 1)% looks at %SHOW_CHILDNAME(93)%, letting out a sigh of relief.
			PRINTFORMW 「Fwuuuh... I'm just happy that our %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% is not a picky eater.」
			PRINTFORMW 「But somehow, I feel like I'll miss having %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% drinking my milk.」
			PRINTFORMW 「%HE_SHE_CHILD(93, 1, TALENT:93:育児中)% always looked so cute while doing it, to...」
		ENDIF
	ELSE
		PRINTFORMW 「But that's okay, I'm sure you'll be here for the next time.」
		IF TALENT:93:母乳体質 == 2 ;permanent lactation
			PRINTFORML 「And I will probably continue to produce a lot maternal milk after this...」
			IF K93_LOVE_LUST_LOVER()
				PRINTFORMW 「And since %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% won't be drinking it anymore, that means there's more for you～!」
				PRINTFORMW 「Fufufu... I apologize sorry, I couldn't resist saying something like that.」
			ELSE
				PRINTFORMW 「Fwuuuh... Looks like I will have to find another way to drain it.」
			ENDIF
		ELSE
			PRINTFORML 「Especially since %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% won't be drinking my milk anymore...」
			IF EXP:93:噴乳経験 >= 50 && K93_LOVE_LUST_LOVER() ;lactation exp and love lust or lover
				PRINTFORMW 「Which means that there won't be any milk for you, either.」
				PRINTFORMW 「B-but it's okay, I'm sure you can manage to be like this for a while!」
			ELSE
				PRINTFORMW 「But say, isn't it strange how my breasts stops lactating at just the right time?」
				PRINTFORMW 「Fufufu... I didn't even know my body could adapt to things like that...」
			ENDIF
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------


;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_玩具
;Giving a toy
;-------------------------------------------------
CALL SET_KOJO_COLOR(93)
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中 ;first child of the batch
	PRINTFORML 「%K93_HONORIFIC(MASTER)%, I have a small favor to ask of you.」
	PRINTFORMW 「Would you mind making a toy for our little %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%?」
	PRINTFORMW 「Something simple, sturdy, and that can survive being underwater.」
	PRINTFORMDW You nod to %K93NICK()%'s request, and set off to fashion a wooden toy for your child.
	PRINTFORMDW Japanese cedar proves to be a solid choice due to its red color, smell and resistance to water rot.
	PRINTL
	IF CHILD_SEX:93:(TALENT:93:育児中) == 1 ;girl
		PRINTFORMDL At first, you try to make a small doll with arms, legs, a head and even some hair.
		PRINTFORMDW But that proves to be difficult, so you settle for a simple fish with both scales and a charming smile carved onto it.
		CALL K93_TIMEPASSDOTS(, "w")
		PRINTFORMDW %K93NICK()% looks at the toy fish with a skeptical smile playing on %HIS_HER(93, 0)% lips.
		PRINTFORMDW Meanwhile, %SHOW_CHILDNAME(93)% curiously examines it, turning it to the sides and upside down...
		PRINTFORMDW Only for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to suddenly let out a cheerful giggle and softly bite down on it.
		PRINTFORML 「Fwuuuh... It's good that our child enjoys your gift, despite how strange it looks.」
		PRINTFORMDW The Mermaid Mother lets out a relieved sign, %HIS_HER(93, 0)% smile quickly softening.
		PRINTFORMW 「If it's supposed to be a doll, maybe I could sew up a dress for it, from the same cloth as my kimono...」
		PRINTFORMW 「Either way, I'm grateful for it, %K93_HONORIFIC(MASTER)%. I really like the smile it has.」
	ELSE ;boy
		PRINTFORMDL On a whim, you decide to make a small toy car, like the ones people in the Outside World use.
		PRINTFORMDW You even manage to make a set of four functioning wheels for it!
		CALL K93_TIMEPASSDOTS(, "w")
		PRINTFORMDL %K93NICK()% leans %HIS_HER(93, 0)% head to the side while looking at the toy car, unsure of its function.
		PRINTFORMW 「Mhmmm... What a peculiar shape it has... and the wheels, too...」
		PRINTFORMDW Meanwhile, %SHOW_CHILDNAME(93)% looks at it closely, fidgeting with the wheels and lightly flailing it around.
		PRINTFORMDW Only for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to suddenly let out a cheerful giggle, a sign of %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% approval.
		PRINTFORMDL %K93NICK()% lets a warm smile form on %HIS_HER(93, 0)% lips as %HE_SHE(93, 0)% turns your attention towards you.
		PRINTFORMW 「That's good, it seems that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% enjoys your "car" toy quite a lot!」
		PRINTFORMW 「Thank you, %K93_HONORIFIC(MASTER)%. You did an excellent job today as well.」
	ENDIF
	SELECTCASE CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中)
	CASE 2 ;twins
		PRINTL
		PRINTFORML 「But say... would you mind doing one more toy like that?」
		PRINTFORML 「We wouldn't want our other little one to get jealous, after all!」
		PRINTFORMDW You nod, and start to happily carve yet another toy for your children.
	CASE 3 ;triplets
		PRINTFORML 「But as much as I do not wish to burden you... could you make two more toys like that?」
		PRINTFORML 「I don't think we can have one toy shared between three children, after all.」
		PRINTFORMDW You sigh and nod, proceeding to carve two more toys for your family.
	CASE IS >= 4 ;child support nightmare
		PRINTL
		PRINTFORMW 「But... Uhmm... %K93_HONORIFIC(MASTER)%, d-did you only make that one?」
		PRINTFORMW 「We have a lot more than just one child, you know.」
		PRINTFORMDL You sigh, trying to steel yourself to the Herculean toy-making task that awaits you.
		PRINTFORMDW Then, you start to carve one toy after the other...
	ENDSELECT
ELSEIF CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) == TALENT:93:育児中 ;last child of the batch
	SELECTCASE CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中)
	CASE 2, 3 ;twins and triplets
		PRINTFORMDL You take a deep breath, and give the last \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? fish-shaped doll # toy car \@ to %SHOW_CHILDNAME(93)%.
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% looks at it \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? bites it # flails it around \@, not unlike %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% sibling%COND_STR(@"s", CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 3)%.
		PRINTFORMDW You smile, satisfied as you watch your offspring playing with their new toys.
	CASE IS >= 4 ;child support nightmare
		PRINTFORMDL After what feels like days, you finally finish carving a small army of wooden toys.
		PRINTFORMDW You take a deep breath as you hand over the last \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? fish-shaped doll # toy car \@ to %SHOW_CHILDNAME(93)%.
		PRINTFORMDW %HIS_HER_CHILD(93, 1, TALENT:93:育児中)% appreciation makes everything worth it.
	ENDSELECT
ELSE ;everything in between
	IF CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) >= 4
		PRINTFORMDL You %SPLIT_G("hand over:give:entrust")% %SHOW_CHILDNAME(93)% %SPLIT_G("yet another:another:one more:a new")% \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? fish-shaped doll # toy car \@.
		PRINTFORMDW %HIS_HER_CHILD(93, 1, TALENT:93:育児中)% %SPLIT_G("gratitude:curiosity:smile")% drives you to keep moving forward...
	ELSE
		PRINTFORMDW You hand a \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? fish-shaped doll # toy car \@ over to %SHOW_CHILDNAME(93)%.
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% grins and \@ CHILD_SEX:93:(TALENT:93:育児中) == 1 ? bites it # flails it around \@, a sign of appreciation.
		PRINTFORMDW With a %PRINT_MALE("father", MASTER)%ly smile on your face, you start to carve the last toy.
	ENDIF
ENDIF
;-------------------------------------------------


