;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_自立
;Sending them off as adults
;-------------------------------------------------
CALL SET_KOJO_COLOR(93)
IF CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) != TALENT:93:育児中
	IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
		PRINTDATADL
			DATAFORM %SHOW_CHILDNAME(93)% cries, but %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% swears those are tears of happiness. 
			DATAFORM %SHOW_CHILDNAME(93)% promises to send you letters, and says that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% will try to visit as often as possible.
			DATAFORM %SHOW_CHILDNAME(93)% gives you and %K93NICK()% a long hug, almost as if stalling for time.
			DATAFORM %SHOW_CHILDNAME(93)% gives a long winded speech, saying how grateful %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% is for having wonderful parents.
			DATAFORM %SHOW_CHILDNAME(93)% sings a song that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% composed for you and %K93NICK()% before walking off into adulthood.
			DATAFORM %SHOW_CHILDNAME(93)% gifts you and %K93NICK()% a precious little stone to remember %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% by.
		ENDDATA
	ELSE
		PRINTDATADL
			DATAFORM %SHOW_CHILDNAME(93)%'s farewell is quite cold. You wonder if %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% likes you at all...
			DATAFORM %SHOW_CHILDNAME(93)% seems very ill-prepared for adulthood. You start to feel a bit guilty.
			DATAFORM As you wave %SHOW_CHILDNAME(93)% away, you wonder if you could have been a better parent...
			DATAFORM %SHOW_CHILDNAME(93)% tightly hugs %K93NICK()%, but you only get a short nod and a rather dry farewell.
			DATAFORM %SHOW_CHILDNAME(93)% barely said anything, deciding to simply walk out of your sight and out of your life.
		ENDDATA
	ENDIF
ELSE
	IF CHILD_LOVE:93:(TALENT:93:育児中) >= 200
		CALL COLORMESSAGE(@"「Mom... It's all good, I promise you I'll be fine.」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMW 「I know, I just don't think I want to let you go yet...」
		PRINTFORMDW %K93NICK()% holds both you and %SHOW_CHILDNAME(93)% in a tight group hug.
		PRINTFORMDW You only manage to convince %HIM_HER(93, 0)% to let you both go after a good while.
		PRINTL
		PRINTFORMDW %K93NICK()% and %SHOW_CHILDNAME(93)% wave each other warm goodbyes with bright smiles on their faces.
		PRINTFORMDW Soon enough, your %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)% is nothing but a silhouette getting further and further away from you.
		PRINTFORMW 「Fwaaaah... We were good parents, don't you think?」
		PRINTFORMW 「It makes me so proud, seeing our child all grown up and ready to see all that the world has to offer!」
		PRINTFORMW 「I just hope that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% comes to visit us once in a while...」
	ELSE
		CALL COLORMESSAGE(@"「I guess this is it. Goodbye mother, goodbye%PRINT_MALE(" father_:... uhhh... other mother", MASTER)%.」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMW 「Goodbye, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%. Please, take care of yourself.」
		PRINTFORMDW %SHOW_CHILDNAME(93)% half-heartedly waves both %K93NICK()% and you a farewell as %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% walks away into the distance.
		PRINTL
		PRINTFORMDL %K93NICK()% lets out a long sigh, a saddened look in %HIS_HER(93, 0)% eyes.
		PRINTFORMW 「Fwuuuh... We could have done way better as parents, couldn't we?」
		PRINTFORMW 「But there is no point in thinking about that, all we can do is hope that %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% does well in life.」
		PRINTFORMW 「And I'm sure %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% will still write us letters, and maybe even visit us...」
	ENDIF
ENDIF
