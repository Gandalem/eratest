@M_KOJO_EN_EVENT_K93_CHILD_RAISING_語彙
;Talking properly
;-------------------------------------------------
CALL SET_KOJO_COLOR(93)
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中
	PRINTFORMDL Lately, %K93NICK()% has been trying to teach %SHOW_CHILDNAME(93)% a few new words.
	PRINTFORMDW You decide to stop by and observe one of those many attempts at enriching %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% vocabulary.
ELSE
	PRINTDATADW
		DATAFORM %K93NICK()% started teaching %SHOW_CHILDNAME(93)% some new words as well, so you decide to stay and watch.
		DATAFORM You stop by, only to see %SHOW_CHILDNAME(93)% being taught a few new words by %K93NICK()%.
		DATAFORM %SHOW_CHILDNAME(93)% starts learning new words, just like %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% sibling%COND_STR(@"s", CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 3)%.
	ENDDATA
ENDIF
PRINTL
SELECTCASE RAND:3
CASE 0
	PRINTFORMW 「You're doing very well so far! But here, why don't you try saying my name?」
	PRINTFORMW 「Repeat after me... "Waka-sagi-hime".」
	PRINTFORMDL %SHOW_CHILDNAME(93)% scratches %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% head before trying to speak again.
	CALL COLORMESSAGE(@"「Is it... Sagi... W-Wakagisami... Wakahimemama?」", K93_CHILDCOLOR(), 2, 0)
	PRINTFORMDL %K93NICK()% lets out a warm laugh in response to the child's earnest attempt.
	IF CFLAG:93:K93EN_WAGGYHARDNAME
		PRINTFORMW 「Fufufu! Oh my, you're getting close already!」
		PRINTFORMW 「Don't worry, even your %PRINT_MALE("father_:other mother", MASTER)% had difficulty pronouncing my name when we first met.」
		PRINTFORMDL %HE_SHE(93, 1)% turns towards you, a smile still plastered over %HIS_HER(93, 0)% lips.
		PRINTFORMW 「Isn't that right, %K93_HONORIFIC(MASTER)%? I hope you still remember it.」
	ELSE
		PRINTFORMW 「Fufufu! Close, but not there just yet～!」
		PRINTFORML 「Here, the trick to it is separating my name in three parts...」
		PRINTFORMDW %HE_SHE(93, 1)% continues to patiently teach %SHOW_CHILDNAME(93)%.
	ENDIF
CASE 1
	PRINTFORMDW %K93NICK()% looks at you, and then back at %SHOW_CHILDNAME(93)% with a soft smile.
	PRINTFORMW 「Say, why don't you try to pronounce your %PRINT_MALE("father_:other mother", MASTER)%'s name?」
	PRINTFORMW 「It's easy, just listen and repeat with me... "%K93_HONORIFIC(MASTER)%"!」
	PRINTFORMDL %SHOW_CHILDNAME(93)% looks at you and leans %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% head to the side.
	CALL COLORMESSAGE(@"「That is... %STUTTER(K93_HONORIFIC(MASTER), "nospecial")%?」", K93_CHILDCOLOR(), 1, 0)
	PRINTFORMDW Such success is met by a cheerful yet gentle round of applause from %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother.
	PRINTFORMW 「That's correct! Don't you agree that it's a nice sounding name～?」
CASE 2
	PRINTFORMDW %K93NICK()% points at a few objects around the room, slowly saying their names out loud.
	PRINTFORMW 「That right there is a window. "Win-dow", repeat with me.」
	CALL COLORMESSAGE(@"「That... rite there is... a windoe!」", K93_CHILDCOLOR(), 2, 0)
	PRINTFORMDW %HE_SHE(93, 1)% smiles upon hearing %HIS_HER(93, 0)% %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%'s words.
	PRINTFORMW 「Very good! I promise I will give you some candy after we're done with this!」
	PRINTFORMW 「But now, that... right there in the corner, that's a table. "Ta-ble", repeat with me.」
	CALL COLORMESSAGE(@"「The corner... that a table～w!」", K93_CHILDCOLOR(), 2, 0)
	PRINTFORMDW %K93NICK()% continues to tutor %SHOW_CHILDNAME(93)% for a good while...
	PRINTFORMDW And just as promised, %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% gets rewarded with some candy!
ENDSELECT
