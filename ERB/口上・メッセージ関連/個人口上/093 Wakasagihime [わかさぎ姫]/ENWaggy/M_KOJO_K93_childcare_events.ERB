;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;置き換えではありません。必要な場合は上下のSKIPSTART~SKIPENDを外してください。
;-------------------------------------------------
@M_KOJO_EN_EVENT_K93_CHILD_RAISING_回復
;Recovery
;-------------------------------------------------
CALL SET_KOJO_COLOR(93)
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中 ;only play this out first child of the batch
	PRINTFORMDW You walk into %SHOW_CHILDNAME(93)% resting in the warmth of %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother's arms, looking at you with curiosity.
	IF CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 3
		PRINTFORMDW Your other offspring lie nearby, neatly wrapped in blankets.
	ELSEIF CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) == 2
		PRINTFORMDW %CHILDNAME:93:(CHILD_MULTIPLE_LAST(93, TALENT:93:育児中))% lies nearby, neatly wrapped in a blanket.
	ENDIF
	PRINTFORMW 「Oh, %K93_HONORIFIC(MASTER)%! It's good that you are here to see us.」
	PRINTFORML 「We have been doing well, and our little %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% hasn't been giving me any problems so far...」
	IF CFLAG:93:BirthEventsCount == 1 ;first child
		IF CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 2
			PRINTFORMW 「Even though I never expected to take care of \@ CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 3 ? this many # two at the same time \@, I'm sure I can manage it!」
		ELSE
			PRINTFORMW 「I think it's fair to say that I'm getting used to being a mother rather quickly～!」
		ENDIF
	ELSE
		PRINTFORMW 「I think I have gotten better at raising children, but there's always room to improve.」
	ENDIF
	PRINTL
	PRINTFORMDW You smile, and slowly approach your index finger to %SHOW_CHILDNAME(93)%...
	IF K93_LOVE_LUST_LOVER()
		PRINTFORMDW %HE_SHE_CHILD(93, 1, TALENT:93:育児中)% lets out a little laugh, reaching for and wrapping your finger with both hands.
		PRINTFORMW 「Fufufu... It seems like %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% likes you already!」
		IF CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 2
			PRINTFORML 「But say, why don't you try your luck with the other%COND_STR(@"s", CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 3)% as well?」
			PRINTFORMW 「It's only fair that %PLNOUN(HE_SHE_CHILD(93, 0, TALENT:93:育児中),CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中)-1)% also get%COND_STR(@"s", CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) == 2)% to enjoy the hold of %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% %PRINT_MALE("father_:other mother", MASTER)%...」
		ELSE
			PRINTFORMDL %K93NICK()% brightly smiles as %HE_SHE(93, 0)% faintly raises the baby towards you.
			PRINTFORMW 「Here, would you like to hold %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% for a little bit?」
			PRINTFORMW 「It's only fair that our child gets to enjoy the hold of %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% %PRINT_MALE("father_:other mother", MASTER)% as well...」
		ENDIF
	ELSE
		PRINTFORMDW Only for %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to suddenly open %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mouth to loudly cry.
		PRINTFORMDL %K93NICK()% brings the crying child closer, whispering gentle words in an attempt to calm %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% down.
		PRINTFORMW 「Shh... No... There, it's fine... %HE_SHE(MASTER, 1)% is a good %PRINT_MALE("man", MASTER)%...」
		PRINTL
		PRINTFORMDL %K93NICK()% looks up at you again once %HE_SHE(93, 0)% manages to calm %SHOW_CHILDNAME(93)% down.
		PRINTFORMW 「Fwuuuh... You shouldn't let that upset you, %K93_HONORIFIC(MASTER)%.」
		PRINTFORMW 「If it's of any comfort, I'm happy that you are taking... some responsibility.」
		PRINTFORMW 「And I'm sure %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% will warm up to you with time...」
	ENDIF
ENDIF
;-------------------------------------------------


