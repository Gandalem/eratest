;from here on out, repeatable little events
;-------------------------------------------------
;育児イベント登下校時の地の文。
;Going to school
;-------------------------------------------------

@M_KOJO_EN_EVENT_K93_CHILD_RAISING_登下校(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) == TALENT:93:育児中 || CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) == TALENT:93:育児中 ;only play for first and last
	IF !ARG ;going to school
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, 이리 와보렴! 네 모든 것이 괜찮은지 확인해야겠어...」
				CALL COLORMESSAGE(@"「잠깐만, 또? 엄마... 그거 이미 한 거 아니었어?」", K93_CHILDCOLOR(), 1, 0)
				PRINTFORMDW %K93NICK()%은 잠시 %SHOW_CHILDNAME(93)%를 단장한 후 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%을 보내고 떠난다.
			CASE 1
				CALL COLORMESSAGE(@"「엄마, 가기 전에... 오늘 좀 일찍 집에 갈게.」", K93_CHILDCOLOR(), 1, 0)
				PRINTFORML 「아, 괜찮단다. 언제나처럼 여기서 기다리고 있을게.」
				PRINTFORMW 「이제 나가서 엄마랑 %PRINT_MALE(@"당신 아버님:%K93_HONORIFIC(MASTER)%", MASTER)% 모두를 자랑스럽게 만들어 봐!」
			CASE 2
				PRINTFORML 「오늘 학교에서 좋은 하루 보내렴, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
				CALL COLORMESSAGE(@"「음~ 최선을 다할게요, 엄마!」", K93_CHILDCOLOR(), 2, 0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL COLORMESSAGE(@"「엄마, 나 왔어!」", K93_CHILDCOLOR(), 2, 0)
				PRINTFORMDL %SHOW_CHILDNAME(93)%이/가 멈춰 서서 주변을 둘 뿐이다.
				CALL COLORMESSAGE(@"「...%PRINT_MALE(@"dad:%CALLNAME:MASTER%-san", MASTER)%가 여기 있나요?」", K93_CHILDCOLOR(), 2, 0)
				IF CFLAG:MASTER:現在位置 == CFLAG:93:現在位置 ;player is there (actually, don't these require you to be there anyway? why did i do this?)
					PRINTFORMW 「음? 오, %HE_SHE(MASTER, 0)%은 저쪽에 있네. 왜 물어보지?」
				ELSE
					PRINTFORMW 「%HE_SHE(MASTER, 1)% 지금 여기에 없다. 왜 묻는 거지?」
				ENDIF
				CALL COLORMESSAGE(@"「아, 음... 그냥 궁금해서 그랬어요, 그게 다예요.」", K93_CHILDCOLOR(), 2, 0)
			CASE 1
				PRINTFORMDW %K93NICK()%은(는) %SHOW_CHILDNAME(93)%가 문을 열고 들어서자마자 기운을 차린다.
				PRINTFORMW 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, 집에 왔구나! 이리 와 엄마한테 안기렴～!」
				CALL COLORMESSAGE(@"「기다릴 수 없나요? 너무 피곤해요...」", K93_CHILDCOLOR(), 1, 0)
				PRINTFORMDW %HIS_HER_CHILD(93, 0, TALENT:93:育児中)%의 말에도 불구하고, %SHOW_CHILDNAME(93)%는 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% 어머니를 따뜻하게 안아준다.
				PRINTFORML 「후훗… 지금은 어렵지 않았잖아?」
				PRINTFORMW 「왜 그런 건지는 모르겠지만, 오늘 많이 보고 싶었어...」
			CASE 2
				PRINTFORMW 「오, 왔구나! 집에 온 걸 환영해, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
				PRINTFORMDL %K93NICK()%는 %HIS_HER(93, 0)%의 눈에 그려진 호기심으로 %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%를 바라봤다.
				PRINTFORMW 「그래서... 오늘 학교에서 뭘 배웠니?」
				CALL COLORMESSAGE(@"「%SPLIT_G("Nothing much, just the usual:Some interesting stuff, actually:Something very boring, but")%...」", K93_CHILDCOLOR(), 1, 0)
				PRINTFORMDW %SHOW_CHILDNAME(93)%은 잠시 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)%의 어머니와 이야기했다.
		ENDSELECT
	ENDIF
	IF CHILD_MULTIPLE_LAST(93, TALENT:93:育児中) == TALENT:93:育児中 && CHILD_MULTIPLE_COUNT(93, TALENT:93:育児中) >= 4 ;don't play this if it's less than quadruplets
		PRINTL
		PRINTFORMDL %K93NICK()%은(는) %SHOW_CHILDNAME(93)%가 시야에서 사라지자 지친 한숨을 내쉰다.
		IF !ARG ;going
			PRINTFORML 「후우... 전부 다인 것 같아, 확실해!」
			PRINTFORMW 「가끔 그 선생님이 저 아이들 모두를 감당할 수 있을지 걱정돼...」
		ELSE
			PRINTFORML 「아아... 모두 무사하고 안전하군, 다행이야!」
			SIF !RAND:5 ;don't play this shitty joke all the time
				PRINTFORML 「우리가 이제 우리만의 '어떤...' 물고기 학교를 갖게 되었네~」
			WAIT
		ENDIF
	ENDIF
ELSE
	PRINTFORMD %K93NICK()%
	IF !ARG ;going
		PRINTDATAD
			DATAFORM  너는 %SHOW_CHILDNAME(93)%에게 학교에 가라고 손을 흔든다.
			DATAFORM  %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%가 지나갈 때 %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%의 등에 손을 올려준다.
			DATAFORM  멈춘다 %SHOW_CHILDNAME(93)% 뺨에 입 맞추고 놓아주기 전에 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% 놓다
			DATAFORM  %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%가 지나갈 때 %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%에게 예의를 갖추라고 말한다.
		ENDDATA
	ELSE
		PRINTDATAD
			DATAFORM  따뜻한 미소로 %SHOW_CHILDNAME(93)%를 집으로 맞이한다.
			DATAFORM  %SHOW_CHILDNAME(93)%가 집에 들어서기 전, %HIS_HER_CHILD(93, 0, TALENT:93:育児中)%에게 정중하게 인사하자 미소를 짓는다.
			DATAFORM  %SHOW_CHILDNAME(93)%에게 %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%가 하루를 잘 보냈는지 묻는다.
			DATAFORM  %SHOW_CHILDNAME(93)%를 붙잡고 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%에게 따뜻하고 어머니 같은 포옹을 건넨다.
		ENDDATA
	ENDIF
	PRINTFORMDL ...
ENDIF
;-------------------------------------------------
;育児イベント食事時。
;Feeding
;-------------------------------------------------

@M_KOJO_EN_EVENT_K93_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "授乳" ;breastfeeding
	IF !RAND:3 && EXP:93:噴乳経験 >= 50 && K93_LOVE_LUST_LOVER()
		PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%～! 부디 %K93_HONORIFIC(MASTER)%께도 좀 남겨주세요~!」
		PRINTFORMW 「후후후... 마치 %SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%, 혹은 %PRINT_MALE(@"아버지_:어머니", MASTER)%처럼 말이에요...」
	ELSE
		PRINTDATAW
			DATAFORM 「필요한 만큼 마음껏 마셔도 돼, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%...」
			DATAFORM 「자, 자... 배고팠지?」\n「괜찮아. 나도 배고프면 울지도 모르잖아.」
			DATAFORM 「흐으읍... 아주 즐기고 있는 것 같네, 그렇지?」\n「좋다, 네가 행복해 보여서 나도 기쁘니까...」
		ENDDATA
	ENDIF
ELSEIF ARGS == "離乳食" ;baby food
	PRINTDATAW
		DATAFORM 「일단 이것으로 오늘은 여기까지야... 자!」\n「이번엔 어지럽게 안 했네, 잘했어!」
		DATAFORM 「잘했어, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%! 거의 다 먹었구나!」\n「이제 이 난장판을 치우러 가자...」
		DATAFORM 「자, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, 입 크게 벌려봐...」\n「거기, 거기, 착하다 %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)%.」
	ENDDATA
ELSEIF ARGS == "幼少期" ;as a child
	SELECTCASE RAND:3
		CASE 0
			PRINTFORMDL %K93NICK()%은(는) 웃으며 %SHOW_CHILDNAME(93)%를 바라보고, %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%이 음식을 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% 자신의 입으로 가져다준다.
			CALL COLORMESSAGE(@"「엄마... 왜 나를 그런 눈으로 봐요?」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMW 「후훗... 그냥 네가 먹는 걸 보고 있는 게 좋아서 그래!」
		CASE 1
			CALL COLORMESSAGE(@"「엄마... 이거 더는 먹고 싶지 않아...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORML 「자, 조금만 더 남았어, 이겨내야 해!」
			PRINTFORMW 「이거 먹으면 디저트로 내 인어 파르페 좀 줄게.」
		CASE 2
			CALL COLORMESSAGE(@"「파하아... 엄마, 너무 더워요!」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMW 「아이고, 정말 미안해! 여기 줘, 내가 식혀줄게...」
	ENDSELECT
ELSE
	SELECTCASE RAND:3
		CASE 0
			CALL COLORMESSAGE(@"「휴! 엄마 정말 고마워, 정말 맛있는 식사였어.」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORML 「정말? 그럼 나처럼 요리하는 법을 가르쳐 줄게!」
			PRINTFORMW 「내가 이 근처에서 최고의 요리사는 아닐지도 모르지만, 분명 너에게 이것저것 보여줄 수 있을 거야.」
		CASE 1
			PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, 잘 안 가리는 건 다행이지만 여쭤봐야 할 게 있어요...」
			PRINTFORMW 「혹시 전혀 먹지 않는 음식이 있나요? 정말로요?」
			CALL COLORMESSAGE(@"「사실, 내가 싫어하는 게 있어. 생선이야.」", K93_CHILDCOLOR(), 2, 0)
			PRINTFORMDL %K93NICK()%은(는) 안도의 한숨을 내쉬며 %HIS_HER(93, 0)%의 눈을 감는다.
			PRINTFORMW 「그 소리를 들으니 다행이네요... 아니에요, 그 말을 듣고 제가 얼마나 안심했는지 당신은 상상도 못 할 거예요.」
		CASE 2
			PRINTFORML 「저기, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%... 먹고 싶은 거 있니?」
			PRINTFORML 「원하는 건 뭐든지 말해봐. 내가 해줄 수 있게 노력할게.」
			CALL COLORMESSAGE(@"「진짜? 딱 한 가지만 정하기는 좀 어렵지만...」", K93_CHILDCOLOR(), 2, 0)
	ENDSELECT
ENDIF
;-------------------------------------------------
;育児イベント入浴
;Bathing
;-------------------------------------------------

@M_KOJO_EN_EVENT_K93_CHILD_RAISING_BATH(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "幼児期" ;early childhood
	PRINTFORML 「후후후.... 네 그 아름다운 미소를 봐!」
	PRINTFORMW 「네가 나처럼 물을 즐겨줘서 다행이야, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
ELSEIF ARGS == "幼少期" ;childhood
	CALL COLORMESSAGE(@"「엄마... 이제 정말 물에서 나와야 해?」", K93_CHILDCOLOR(), 1, 0)
	PRINTFORML 「여기 좀 더 머물러서 제대로 목욕시켜 줄 수 있을 것 같아...」
	PRINTFORMW 「자, 눈 감아! 이건 저들에게 가까이 가서는 안 되니까.」
ELSE
	IF !RAND:5
		PRINTFORMW 「있잖아, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%... 왜 목욕하는 데 항상 그렇게 오래 걸리는 거야?」
		PRINTFORMW 「네가 목욕을 빨리 끝내는 건 우리가 같이 할 때뿐인데, 이유를 모르겠어.」
		PRINTFORMDL %SHOW_CHILDNAME(93)%는 얼어붙어 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)%의 엄마에게서 시선을 돌린다.
		CALL COLORMESSAGE(@"「음... 그게 어... 하하하... 네, 그렇습니다...」", K93_CHILDCOLOR(), 2, 0)
		PRINTFORMDW 육아 중인 %HIS_HER_CHILD(93, 0, TALENT:93:育児中)%가 명백하게 불편함을 느끼는 것을 알아차리고, 당신은 개입하여 %K93NICK()%에게 그만두라고 말한다.
		IF TALENT:93:愛欲
			PRINTFORMW 「후후후! 그런 순진한 질문을 하다니, %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%가 당황할 이유 따윈 없어~!」
		ELSE
			PRINTFORML 「아, 내가 말하면 안 되는 말을 했나?」
			PRINTFORMW 「그렇다면 미안해, 다음부터는 더 조심하도록 할게...」
		ENDIF
	ELSE
		PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, 부모님과 함께 목욕하는 것은 아무 문제 없어.」
		PRINTFORML 「자, 부끄러워할 것 없어, 우리는 항상 너를 벌거벗은 채로 봤잖아!」
		CALL COLORMESSAGE(@"「음-뭐, 하지만 그건 완전히 다른 문제였어...」", K93_CHILDCOLOR(), 2, 0)
	ENDIF
ENDIF
;-------------------------------------------------
;育児イベント就寝
;Bedtime
;-------------------------------------------------

@M_KOJO_EN_EVENT_K93_CHILD_RAISING_SLEEPING(ARGS,ARG,ARG:1)
SIF !SHIRAHU(93)
	RETURN
IF ARGS == "幼児期"
	IF RAND:2
		PRINTFORML 「흐아암... 조금 걸렸지만, 드디어 잠들었구나.」
		PRINTFORMW 「이대로 아침까지 계속 자주면 좋겠어...」
	ELSE
		PRINTFORML 「후후후... 오늘은 쉽게 잠들었구나!」
		PRINTFORMW 「하지만 그렇게 눈을 감고 있는 모습을 보니 나도 졸려지네...」
	ENDIF
	PRINTFORMDL %K93NICK()% %SPLIT_G(@"몸을 숙여 %HIS_HER(93, 0)%%SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%의 이마에 부드러운 키스를 하고: %HIS_HER(93, 0)%%SON_DAUGHTER_CHILD(93, 0, TALENT:93:育児中)%의 머리를 부드럽게 쓸어넘긴다.")%.
	PRINTFORMW 「잘 자렴, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%.」
ELSEIF ARGS == "幼少期"
	SELECTCASE RAND:4
		CASE 0 TO 1 ;more common
			PRINTFORML 「%K93_CHILDHONORIFIC(93, TALENT:93:育児中)%, 잠자리에 들기 직전에 누군가에게 뭐라고 말해줄까?」
			CALL COLORMESSAGE(@"「오... 음... 잘 자요, 엄마...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORMW 「맞아, 바로 그거야. 잘 자렴, 나의 소중한 %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%아.」
		CASE 2
			CALL COLORMESSAGE(@"「엄마... 여기서 나랑 같이 있어 줄 수 있어? 잠깐만이라도, 정말이야...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORML 「오, 물론이지! 잠깐이라면 문제없을 거야.」
			PRINTFORMDW %K93NICK()%은(는) %SHOW_CHILDNAME(93)%의 침대 가장자리에 앉아 %HIM_HER_CHILD(93, 0, TALENT:93:育児中)%가 잠들 때까지 %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%과 시간을 보낸다.
		CASE 3
			CALL COLORMESSAGE(@"「엄마... 노래 불러줄 수 있어...? 잠들 때까지...」", K93_CHILDCOLOR(), 1, 0)
			PRINTFORML 「오, 정말 좋겠어! 눈을 감고 내 목소리에 집중해, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%...」
			PRINTFORMDW %K93NICK()%는 %SHOW_CHILDNAME(93)% 근처에 앉아 %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%가 잠들 때까지 부드럽게 노래를 흥얼거린다.
	ENDSELECT
ELSE
	CALL COLORMESSAGE(@"「나 이제 잘 거야... 안녕, 엄마. 잘 자, %PRINT_MALE(@"dad:%CALLNAME:MASTER%-san", MASTER)%아.」", K93_CHILDCOLOR(), 1, 0)
	PRINTFORMW 「음. 잘 자렴, %K93_CHILDHONORIFIC(93, TALENT:93:育児中)%. %SPLIT_G("그리고 침대 진드기한테 물리지 않게 조심해! 좋은 꿈 꾸길...")%」
ENDIF
