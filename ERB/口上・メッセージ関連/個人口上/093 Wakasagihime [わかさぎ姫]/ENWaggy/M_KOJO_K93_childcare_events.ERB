@M_KOJO_EN_EVENT_K93_CHILD_RAISING_就学
;Sending off to school
;-------------------------------------------------
CALL SET_KOJO_COLOR(93)
IF CHILD_MULTIPLE_FIRST(93, TALENT:93:育児中) != TALENT:93:育児中
	PRINTDATADL
		DATAFORM %SHOW_CHILDNAME(93)% happily hops off to school for the first time, curious to see what the world has to offer...
		DATAFORM %SHOW_CHILDNAME(93)% is hesitant to go to school, but is easily convinced by %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% mother.
		DATAFORM It takes a while, but you finally convince %SHOW_CHILDNAME(93)% to go to school.
		DATAFORM %SHOW_CHILDNAME(93)% cries, sobs and bawls, but you still manage to send %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% to school. Poor little thing...
		DATAFORM %SHOW_CHILDNAME(93)% is easily convinced to go to school with some Mermaid Parfait.
		DATAFORM %SHOW_CHILDNAME(93)% becomes interested in going to school once you mention music classes.
	ENDDATA
ELSE
	IF RAND:2
		CALL COLORMESSAGE(@"「Sob... Mommy... I d-don't want to go to school...」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMDW %SHOW_CHILDNAME(93)% whispers, %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% arms tightly wrapped around %K93NICK()%.
		PRINTFORMW 「Shhh... It's okay, \@ K93_COHABITATION() ? both me and your %PRINT_MALE("father_:mother", MASTER)% # I \@ will be here when you come back」
		PRINTFORML 「And I know that you are strong enough to go out there, learn and make a lot of friends!」
		PRINTFORMDW %HE_SHE(93, 1)% responds in kind with a warm hug, trying %HIS_HER(93, 0)% best to encourage %SHOW_CHILDNAME(93)%...
		CALL K93_TIMEPASSDOTS(, "w")
		PRINTFORMDW %K93NICK()% manages to calm down the sobbing %SHOW_CHILDNAME(93)% after a while.
	ELSE
		CALL COLORMESSAGE(@"「Mommy, daddy! It's my first day of school, come on!」", K93_CHILDCOLOR(), 1, 0)
		PRINTFORMDW %SHOW_CHILDNAME(93)% hollers, barely able to contain %HIS_HER_CHILD(93, 0, TALENT:93:育児中)% excitement.
		PRINTFORMW 「Fufufu... Calm down my dear, your school isn't going anywhere～!」
		PRINTFORMW 「You will have plenty of time to learn and make a lot of friends over there...」
		CALL K93_TIMEPASSDOTS(, "w")
		PRINTFORMDW After a while, %K93NICK()% manages to calm %SHOW_CHILDNAME(93)%'s spirits.
	ENDIF
	PRINTFORMDW You both wave %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% away as %HE_SHE_CHILD(93, 0, TALENT:93:育児中)% walks to school for the first time.
	IF CFLAG:93:BirthEventsCount == 1 ;first child
		PRINTFORMW 「Our little %K93_CHILDHONORIFIC(93, TALENT:93:育児中)% grew up so fast, didn't %HE_SHE_CHILD(93, 0, TALENT:93:育児中)%?」
		PRINTFORMW 「I never expected that the day we sent %HIM_HER_CHILD(93, 0, TALENT:93:育児中)% off to school would come so fast!」
		PRINTFORMDL Tears start to slowly form in %HIS_HER(93, 0)% eyes, %HIS_HER(93, 0)% voice overflowing with emotion.
		PRINTFORMW 「It almost makes me fear that one day I will blink, and our %BOY_GIRL_CHILD(93, 0, TALENT:93:育児中)% will have grown into an adult...」
	ELSE
		IF !RAND:3
			PRINTFORMW 「Say, do you think it would be possible for me to go school as well?」
			PRINTFORMW 「It seems to be a good place to learn about new things, get to know people...」
			PRINTFORMDL %HE_SHE(93, 1)% stops and turns towards you with a bright smile.
			PRINTFORMW 「A perfect place for someone like me, don't you agree?」
			PRINTFORMDL %HE_SHE(93, 1)% looks elsewhere, letting %HIS_HER(93, 0)% thoughts wander away.
			PRINTFORMW 「But if the classroom is to be filled with children... then surely I would stand out...」
		ELSE
			PRINTFORMW 「I don't think I will ever get tired of sending our children to school for their first time.」
			PRINTFORML 「To see them learn about the world, to make friends, to grow up healthy...」
			PRINTFORMDW %HE_SHE(93, 1)% stops, takes a deep breath and looks at you with a bright grin.
			PRINTFORMW 「Doesn't it fill you with pride as well, %K93_HONORIFIC(MASTER)%?」
		ENDIF
	ENDIF
ENDIF

