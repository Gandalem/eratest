; Modular ERB: 個人口上/093 Wakasagihime [わかさぎ姫]/ENWaggy/M_KOJO_K93_danmaku_match.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_EN_MESSAGE_COM_K93_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_EN_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	LOCAL:9 = 0
	SIF K93_ISSWIM() ;small handicap for fighting in a place she can swim in
		LOCAL:9 += 100
	SIF GROUPMATCH(TIME:5, 4, 5, 6, 14) ;smaller handicap on top for rain, heavy rain, drizzle and rainstorm
		LOCAL:9 += 50
	SIF ABL:93:戦闘能力 >= 1 ;handicap scales with her combat level, no multiplying by 0 or negative numbers in this household
		LOCAL:9 = LOCAL:9 * ABL:93:戦闘能力
	;these numbers might be ridiculous at combat Ex, ought to test and rebalance
	HANDICAP_FIXED = 0
	HANDICAP_RAND = LOCAL:9
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「나에게 단마쿠 결투에 도전하고 싶다는 거냐?」
		IF K93_MAD()
			WAIT
			PRINTFORMW 「후우... 그 생각은 아예 품지 않는 게 좋을 것 같군.」
			PRINTFORMW 「이게 나를 좀 더 기분 좋게 만들지는 않겠지만, 그래도 그렇게 할 생각이야.」
			PRINTFORMDW %K93NICK()%는 멈춰 서서 길고 깊게 숨을 들이마신 후 다시 말을 꺼낸다.
			PRINTFORMW 「준비되면 말해줘, %K93_HONORIFIC(MASTER)% 씨.」
			RETURN 0
		ELSEIF FIRSTTIME("WaggyDanmakuDuel")
			WAIT
			PRINTFORML 「저-음, 그런 건 아주 오랜만에 해보는 거라...」
			PRINTFORMDW %K93NICK()%은(는) 부끄러운 듯 다른 곳을 바라보며 과거를 회상한다.
			PRINTFORMW 「있잖아, 나는 친선 결투 같은 것에도 그다지 싸우는 걸 좋아하지 않거든.」
			PRINTFORMDL %HE_SHE(93, 1)%은(는) %HIS_HER(93, 0)%의 시선을 다시 당신에게로 돌린다.
			PRINTFORMW 「하지만 거절하는 건 무례하니까, 받아들이겠어.」
			PRINTFORMW 「게다가, 어쩌면 나에게도 꽤 재미있을지도 모르잖아.」
		ELSE
			IF K93_LOVE_LUST_LOVER()
				PRINTFORML 「당신이라면 거절할 이유가 없어요.」
				PRINTFORMW 「결국 당신과 함께라면 "싸우는 것"조차 즐거워지니까요.」
			ELSEIF K93_YEARNING_SEXFRIEND(1)
				PRINTFORMW 「물론이지, 전혀 상관없어...」
			ELSEIF K93_FRIENDSHIP()
				PRINTFORMW 「...친구들 사이에서 재미있는 활동이 될 거라고 확신해.」
			ELSE
				PRINTFORMW 「...좋아, 네 손님을 대접해주지 뭐.」
			ENDIF
		ENDIF
		PRINTL
		IF K93_ISSWIM() && GROUPMATCH(TIME:5, 4, 5, 6, 14)
			PRINTFORMW 「나를 돌아다닐 물이 풍부할 뿐만 아니라 비도 오고 있어.」
			PRINTFORMW 「후와아... 이보다 더 좋을 순 없을 것 같아!」
			PRINTFORMDL %K93NICK()%은(는) 물과 비 속에서 즐겁게 헤엄치며 미소 짓는다.
			PRINTFORMDW 마치 %HE_SHE(93, 0)%가 싸우기 전에 자랑하는 것만 같다.
		ELSEIF K93_ISSWIM()
			PRINTFORMW 「좋아, 여기서 자유롭게 돌아다니기엔 물이 충분하군.」
			PRINTFORMW 「수영할 곳 없는 곳에서 싸워야 한다면 정말 아쉽겠어!」
			PRINTFORMDW %K93NICK()%은(는) 짧게 다이빙한 후, 곧 미소를 지으며 수면 위로 떠올랐다.
		ELSEIF GROUPMATCH(TIME:5, 4, 5, 6, 14)
			PRINTFORMW 「나 여기 돌아다닐 호수도 강도 없어...」
			PRINTFORMW 「하지만 괜찮아, 봐! 빗물로 수영하는 것도 충분히 가능하잖아!」
			PRINTFORMDL %K93NICK()%은 갑자기 떠서 빗물 속에서 우아하게 날기 시작한다.
			PRINTFORMDW 아니, 오히려 %HIS_HER(93, 0)%의 움직임은 "비 속에서 수영하는 것"이라고 표현하는 게 더 적절하다.
		ELSE
			PRINTFORMW 「내가 수영할 물도 없고, 비도 오지 않는데...」
			PRINTFORMW 「후우... 그래도 할 수는 있지만, 많은 건 기대하지 마.」
			PRINTFORMDL %K93NICK()%은(는) %HIS_HER(93, 0)%의 눈을 감고 심호흡을 한 뒤 몇 초 후에 다시 뜬다.
		ENDIF
		PRINTFORMW 「당신이 준비되면 저는 준비됐어요, %K93_HONORIFIC(MASTER)% 씨.」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't show if the character's handicap is 0)
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;No need to fill this out if character doesn't have handicap
		IF K93_ISSWIM() && GROUPMATCH(TIME:5, 4, 5, 6, 14)
			PRINTFORMDL %K93NICK()%은(는) 물속에서 수영하거나 비 속을 날아다니기를 끊임없이 반복한다.
		ELSEIF K93_ISSWIM()
			PRINTFORMDL %K93NICK()%은(는) 속도와 우아함, 민첩성으로 헤엄친다.
		ELSEIF GROUPMATCH(TIME:5, 4, 5, 6, 14)
			PRINTFORMDL %K93NICK()%은 비 속에서 우아하게 헤엄치고 있다, 마치 %HE_SHE(93, 0)%가 호수에서 그러하듯이.
		ENDIF
		PRINTFORMDW %HE_SHE(93, 1)%은 평소보다 더 활기찬 것 같다...
		[IF_DEBUG]
		PRINTFORMDW 현재 핸디캡_랜드 값은 {HANDICAP_RAND}이다.
		[ENDIF]
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;CASE 3 ;only available to those with [Deep Knowledge of Life]
			CASE 2
				PRINTFORML 「좋은 타격이었어. 수고했어, %K93_HONORIFIC(MASTER)%!」
				IF ABL:93:戦闘能力 >= 5
					PRINTFORMW 「자, 내가 연습해 온 것이 있다...」
					PRINTL
					PRINTFORMDW ※워터 사인「광란의 붉은 슬랩」
					PRINTFORMDW %K93NICK()%는 푸른 비늘의 나선 형태를 발사한 뒤, 더 조밀하고 공격적인 붉은 비늘의 나선을 이어진다.
					PRINTFORMDW 파란 비늘들은 수가 늘었음에도 통과할 수 있는 많은 공간을 남긴다.
					PRINTFORMDW 하지만 붉은 비늘들은 훨씬 더 빽빽하게 밀집되어 있어 그러한 자비를 베풀지 않는다.
					PRINTFORMDW 대신 가까이 다가가 붉은 나선을 "서핑"하는 편이 생존 확률이 더 높을지도 모른다.
				ELSE
					PRINTFORML 「준비됐나? 또 하나 온다...」
					PRINTL
					PRINTFORMDW 물의 기호「꼬리 지느러미 후려치기」
					PRINTFORMDW %K93NICK()%은(는) 수많은 푸른 비늘로 이루어진 나선형 파동을 발사한다.
					PRINTFORMDW 그것들이 가까이 오자, 당신이 통과할 많은 빈 공간을 남긴다.
					PRINTFORMDW 어쩌면 %HE_SHE(93, 0)%이 그것들을 쏠 때 그 소용돌이를 "서핑" 할 수도 있을지도 모른다.
				ENDIF
			CASE 1
				PRINTFORML 「잘하고 있어, 이게 나의 마지막 스펠 카드야.」
				IF ABL:93:戦闘能力 >= 5 && RAND:2
					PRINTFORMW 「처음에는 불가능해 보일지도 몰라. 하지만 이건 피할 수 있다고 장담하겠어…」
					PRINTL
					PRINTFORMDW ※Tide Sign 「호수의 파도」
					PRINTFORMDW %K93NICK()%이 느리게 움직이는 비늘의 파도를 보낸다. 그 비늘들은 가까이 오면 혼란스러운 반짝이는 구체로 부서진다.
					PRINTFORMDW 첫눈에는 비늘들이 너무 단단하게 붙어 통과할 수 없어 보인다.
					PRINTFORMDW 하지만 더 자세히 들여다보면, 빠져나갈 수 있는 거의 보이지 않는 틈이 눈에 들어온다.
					PRINTFORMDW 그렇지 않다면, 예측 불가능한 패턴의 구체들을 피하며 움직이는 것이 좋은 생각일지도 모른다.
				ELSEIF ABL:93:戦闘能力 >= 3
					PRINTFORMW 「이것은 어려워 보일지도 모르지만, 네가 피할 수 있다고 자신 있어...」
					PRINTL
					PRINTFORMDW ※스케일 사인「뒤집힌 스케일의 거대한 분노의 파도」
					PRINTFORMDW %K93NICK()%은(는) 푸른색, 청록색, 녹색, 보라색 등 많은 비늘들의 여러 파도를 빠르게 발사한다.
					PRINTFORMDW 그 양은 압도적이고 패턴은 혼란스러우며 서로 겹치는 경우가 매우 잦다.
					PRINTFORMDW 통과할 수 있는 틈을 찾는 것은 어렵지만 가능하다.
					PRINTFORMDW 하지만 당신에게 다가오는 무자비한 속도는 숨 돌릴 틈을 거의 남기지 않는다.
				ELSE
					PRINTFORMW 「준비하고 침착해라. 이걸 피할 수 있을 거다...」
					PRINTL
					PRINTFORMDW ※스케일 사인「Scale Wave」
					PRINTFORMDW %K93NICK()%은(는) 녹색과 파란색의 비늘 물결을 사방으로 하나씩 내보낸다.
					PRINTFORMDW 많고 자주 겹치지만, 피하는 것은 매우 쉽다.
				ENDIF
			CASE 0
				IF K93_MAD()
					PRINTFORML 「좋아, 지금은 이만 그만두자.」
					PRINTFORMDW %K93NICK()%이(가) %HIS_HER(93, 0)%의 양손을 번쩍 들었다.
				ELSE
					PRINTFORML 「좋아, 그걸로 충분해, 나 잡았어!」
					PRINTFORMDW %K93NICK()%은/는 미소 지으며 %HE_SHE(93, 0)%이 두 손을 들었다.
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;[Merciless] activates
	;waggy doesn't have this, so...
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;[All-in] activates
	;Waggy doesn't have this either
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;[DEADLY ANOMALIES, DANGEROUS MUTANTS, ANARCHISTS AND BANDITS]
	;I mean, [Anomalies, Strength, Disorder, and Spirits] activates
	;you guessed it, waggy doesn't get this
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;After the fight
	;The case statement is for the number of lives the character has remaining
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTL
		;Case 4 only applies to hus with【Deep Knowledge Of Life】
		;Cases 3-1 are for when you lose, Case 0 is for when you win
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF K93_MAD()
			IF 相手残機 ;lose
				PRINTFORML 「괜찮으세요, %K93_HONORIFIC(MASTER)%?」
				PRINTFORMDW %K93NICK()%이 걱정스러운 표정으로 당신에게 몸을 숙인다.
				PRINTFORMDL 하지만 %HE_SHE(93, 0)%가 당신이 다치지 않았다는 것을 보자, %HE_SHE(93, 0)%는 안도의 한숨을 내쉰다.
				PRINTFORMW 「후우... 다행이다, 내가 그걸로 당신을 다치게 했다면 싫었을 거야.」
				PRINTFORMW 「충분히 쉬었으면 좋겠고, 다른 일을 하러 가줬으면 해.」
			ELSE
				PRINTFORMW 「승리에 만족하는가, %K93_HONORIFIC(MASTER)%?」
				PRINTFORMW 「바란다, 무언가를 얻는 것은 좋은 기분이니까...」
				PRINTFORMDW %K93NICK()%은(는) %HIM_HER(93, 0)% 자신을 멈추고 정중하게 목례를 한다.
				PRINTFORMW 「이제 더 필요한 것이 없다면, 부디 나를 내버려 두어 주기를 청한다.」
			ENDIF
			RESETCOLOR
			RETURN 1
		ENDIF
		IF FIRSTTIME("WaggyDDCAftermath", 0, 93) && K93_LOVE_LUST_LOVER()
			PRINTFORMDW 싸움 후에 %K93NICK()% 바닥을 내려다보며 %HIS_HER(93, 0)% 턱을 기댄 채 %HIS_HER(93, 0)% 손에
			PRINTFORMDW %HE_SHE(93, 1)%은 생각에 잠겨 있는 것 같아서, 너는 그 이유를 묻기로 한다.
			PRINTFORMW 「흠? 아, 아무것도 아니야. 그냥 우리의 싸움이 무언가를 떠올리게 했을 뿐이야.」
			PRINTFORMW 「아마 이미 알고 있을지도 모르지... 하지만 얼마 전 순한 요괴 한 마리가 약간 난동을 부렸거든.」
			PRINTFORMDW %HE_SHE(93, 1)%은 멈춰 서서 깊게 숨을 들이마신 후 너를 응시한다.
			PRINTFORMW 「...그리고 그 안에는 나도 포함되어 있었는데 요괴들이 우리가 품고 있는 공포를 재확인해야 한다고 떠들면서 "우리가 품고 있는 공포를 재확인해야 한다".」
			PRINTFORML 「후후, 그건 나답지 않게 들리지 않니?」
			PRINTFORMW 「그건... 우리가 진정한 우리 자신이 아니었던 것 같아, 거의 다른 무언가였거든.」
			PRINTFORMW 「하지만 동시에, 보이지 않는 것에 지치고 그걸 바꾸고 싶다는 생각이 든다.」
			PRINTFORMDW %HE_SHE(93, 1)%이 잠시 말을 잇지 못하고, %HIS_HER(93, 0)%의 표정이 고통으로 변한다.
			PRINTFORMW 「내가 바라는 것에서 그렇게 동떨어져 보이지 않는다는 것이 문제다.」
			PRINTFORML 「그리고 가끔은 일어났던 모든 일들에 대해 계속 생각하고 나 자신에게 끊임없이 질문하게 된다.」
			PRINTFORMW 「혹시 그것이 나를 보이게 하고 더 이상 무시당하지 않기 위해 내가 해야 할 일이라면?」
			PRINTFORMW 「물론 대답은 아니지만, 그래도 가끔 그걸 생각하는 걸 멈출 수가 없다.」
			PRINTFORML 「하지만 이제 네가 나에게 그렇게 많은 관심을 주니 이미 원하던 것을 얻은 것 같아 처음부터 말이야.」
			PRINTFORMDW %HIS_HER(93, 0)%의 입가에 작지만 밝은 미소가 떠오르기 시작한다.
			PRINTFORMW 「그러니 고마워, %K93_HONORIFIC(MASTER)%나를 위해 여기에 있어 주고 나에게 귀 기울여 주고 네가 하는 것처럼 나를 바라봐 줘서 고마워.」
			PRINTL
			PRINTFORMW 「하지만 그만두고, 우리 다른 것 같이 하자.」
			PRINTFORMW 「...가급적이라 싸우거나 경쟁하는 일은 피하고 싶어.」
			PRINTFORMW 「혹시 저런 일들 끝난 후에 음악을 들으면 마음이 진정될까?」
			PRINTFORMW 「네가 하고 싶은 일이 있으면 나에게 알려줘, 기꺼이 응할게.」
			RESETCOLOR
			RETURN 1
		ENDIF
		SELECTCASE 相手残機
			;CASE 4 ;no sir, doesn't have that one
			CASE 3 ;loss, not a single hit
				IF ABL:MASTER:戦闘能力 >= 5
					PRINTFORML 「%K93_HONORIFIC(MASTER)%나한테 봐주지 않았기를 바라 \@ TALENT:93:恋人 ? 그냥 내가 네 %PRINT_MALE("man", 93)% # 동정심 때문이 아니라고. \@.」
					PRINTFORMDW %K93NICK()% 기울인다 %HIS_HER(93, 0)% 옆으로 고개를 기울이며 희미하게 미간을 찌푸린 채 %HIS_HER(93, 0)% 눈썹에
					PRINTFORMW 「너처럼 강한 사람이 나한테 단 한 대도 안 치고 지다니...」
					IF ABL:93:戦闘能力 >= 4
						PRINTFORML 「비록 그렇지만, 어쩌면 내가 단마쿠에 훨씬 강해졌다는 뜻일지도!」
						PRINTFORMDW %HIS_HER(93, 1)%은/는 밝게 미소 짓는다.
					ELSE
						PRINTFORMW 「어떻게 된 일인지, 그럴 가능성이 매우 낮다고 생각한다.」
					ENDIF
				ELSEIF ABL:MASTER:戦闘能力 >= ABL:93:戦闘能力
					PRINTFORMW 「나-내가 정말 이긴 걸까? 전혀 예상 못 했어...」
					PRINTFORML 「게다가 그렇게 완벽하게 해내다니!」
					PRINTFORMDW %K93NICK()%은(는) 자존심으로 눈이 빛나는 %HIS_HER(93, 0)%을(를) 보며 미소 짓는다.
					PRINTFORMW 「감사합니다 %K93_HONORIFIC(MASTER)%, 묘하게 즐거웠어요.」
				ELSE
					PRINTFORML 「%K93_HONORIFIC(MASTER)%! 나는 너를 다치게 하지 않았지?」
					PRINTFORMDW %K93NICK()%는 %HIS_HER(93, 0)%의 눈에 걱정을 담고 당신에게 몸을 숙인다.
					PRINTFORMDW 당신은 고개를 저으며, 부러진 것도 없고 피 흘리는 곳도 없는 것 같다.
					PRINTFORML 「다행이다, 잠시 너무 심하게 대했던 건 아닌지 생각했어.」
					PRINTFORMW 「네가 나한테 한 방도 못 먹고 그렇게 진 걸 보니...」
					PRINTFORMW 「아, 미안해, 널 쓰러뜨리려던 게 아니었어, 정말 걱정됐거든.」
					PRINTFORMW 「오히려 네 마법 카드는 보기에도 아주 예뻤단다!」
				ENDIF
			CASE 2
				PRINTFORML 「잘 싸웠다, %K93_HONORIFIC(MASTER)%씨.」
				PRINTFORMDW %K93NICK()%은 미소 지으며 %HE_SHE(93, 0)%가 잠시 정중하게 목례를 한다.
				PRINTFORMW 「승패와 상관없이 재미있었으면 좋겠다.」
				PRINTFORMW 「결국 가장 중요한 건 스스로 즐기는 것이 아닌가?」
			CASE 1
				PRINTFORMDL %K93NICK()%은(는) 눈을 감고 깊게 숨을 들이마신다.
				PRINTFORMW 「후우... 아주 아슬아슬한 싸움이었지, 그렇지?」
				PRINTFORMW 「네가 나를 한 번 더 맞혔다면, 결과는 많이 달랐을 거야.」
				PRINTFORMDL %HE_SHE(93, 1)%은(는) 다시 눈을 뜨고, 이번에는 %HIS_HER(93, 0)%의 입가에 희미한 미소를 띤다.
				PRINTFORMW 「하지만 사람들은 이런 싸움이나 결투에서 느껴지는 스릴 때문에 즐기는 거 맞지?」
				PRINTFORMW 「후후후... 그런 건 나한테는 좀 스트레스인 것 같아.」
				SIF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMW 「비록 당신처럼 강한 상대에게 이기는 것이 이상하게 기분 좋지만...」
			CASE 0 ;win
				PRINTFORML 「정말 멋지게 싸웠다, %K93_HONORIFIC(MASTER)%!」
				PRINTFORMDW %K93NICK()%가 박수를 주며 축하해 주는 모습에 미소를 짓는다.
				IF ABL:MASTER:戦闘能力 >= 5
					PRINTFORMW 「당신처럼 강력한 사람에게 기대했던 대로군요.」
				ELSE
					PRINTFORMW 「당신의 단마쿠는 아름다웠어, 재능이 많다는 게 분명해.」
				ENDIF
				PRINTFORMW 「그리고 이런 종류의 일은 나 스스로 즐기지 않지만 재미있었다고 말해야겠어.」
		ENDSELECT
		PRINTL
		IF K93_LOVE_LUST_LOVER()
			PRINTFORML 「이제 싸우는 것의 정반대를 해보는 건 어때?」
			PRINTFORMW 「그 모든 일 후에 너랑 좋은 시간을 보내도 상관없을 것 같은데～!」
		ELSEIF K93_YEARNING_SEXFRIEND(1)
			PRINTFORML 「이제... 더 하고 싶은 건 없어?」
			PRINTFORMW 「네가 원한다면 네가 정착하는 걸 도와주는 것도 나쁘지 않을 거야.」
		ELSE
			PRINTFORML 「하지만 그걸 해결했으니, 마음을 가라앉힐 차 한 잔은 어때?」
			PRINTFORMW 「그게 아니라면 그냥 주변에 머물면서 이야기하는 것도 괜찮아.」
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
