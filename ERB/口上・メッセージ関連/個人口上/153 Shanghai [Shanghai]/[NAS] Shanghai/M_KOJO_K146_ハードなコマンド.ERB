@M_KOJO_MESSAGE_COM_K162_164
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K162_164_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K162_164_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「%CALLNAME:MASTER%, 저게 뭐야?」
		PRINTFORMDW 당신은 %HIM_HER([[Shanghai]])%에게 그것이 클리토럴 전극이라고 말한다.
		PRINTFORML 「클리토럴 전극? 정말 멋지다! 나도 해보고 싶어.」
		PRINTFORMDW 이 신비로운 성인 용품에 흥미를 느낀 %CALLNAME:[[Shanghai]]%은 %HIS_HER([[Shanghai]])%의 대음순을 벌리고 걸레처럼 애원한다.
		CALL HPH_PRINT(@"「그것을 %CALLNAME:MASTER% HPH에 넣어줘 나를 통해 감각을 느끼고 싶어 HPH」","L")
		PRINTFORMDL 당신은 제어 상자에 전극을 연결하기 전에 %CALLNAME:[[Shanghai]]%의 음핵에 전극을 놓는다.
		PRINTFORMDW 당신은 %CALLNAME:[[Shanghai]]%의 전극이 올바르게 위치했는지 확인한 후, 전기로 놀기 시작한다.
		CALL HPH_PRINT(@"「아하 아파 몸이 간질간질해」","L")
		CALL HPH_PRINT(@"「HPH가 충격을 주는 것 같은 기분이 들지만 HPH, 너무 좋다 HPH」","L")
		PRINTFORMDW 그리고 그렇게 전류를 증가시킨다.
		CALL HPH_PRINT(@"「아하하하하하 하프흐프ㅎ」","L")
		CALL HPH_PRINT(@"「내 몸의 HPH가 이 HPHHPH를 감당할 수 없어. 하지만 HPH 이건... HPH 너무 HPH 가- HPH」","L")
		CALL HPH_PRINT(@"「아아아아아아 후우후우후우후우후우후우후」","L")
		PRINTFORMDL 전기적으로 유도된 오르가즘이 %CALLNAME:[[Shanghai]]%의 몸을 관통하고, 만족스러운 표정이 %HIS_HER([[Shanghai]])%의 얼굴에 남는다.
		PRINTFORMDW %CALLNAME:[[Shanghai]]%은 히스테리로 지쳐 바닥에 쓰러진다.
		NOWEX:[[Shanghai]]:0 += 3
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		CALL HPH_PRINT(@"「HPH 충격을 느낄 때마다 나는 언제나 당신을 생각한다 HPH」","L")
		CALL HPH_PRINT(@"「그리고 그것은 여전히 나를 HPH 너무 세게 오르게 해 HPH」","L")
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		CALL HPH_PRINT(@"「이 전기라는 게 너무 음란하다 하후후후」","L")
		CALL HPH_PRINT(@"「아아하 하프 기분이 너무 이상해 하프 하지만 나 엄청 많이 해 하프」","L")
		CALL HPH_PRINT(@"「심장이 너무 빨리 뛰는 바람에 그것을 제대로 볼 수가 없어」","L")
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「그거 진짜 재미있는 클리티 전기 같은 거야!」
		PRINTFORMW 「넣어봐!」		
		RETURN 1
	ENDIF
ENDIF
RETURN 1
