@M_KOJO_MESSAGE_COM_K162_141
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K162_141_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K162_141_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMDW 네가 %CALLNAME:[[Shanghai]]%의 질에 주먹을 대자, %HE_SHE([[Shanghai]])%는 %HIS_HER([[Shanghai]])%의 눈에서 공포를 느끼기 시작한다.
		PRINTFORML 「%STUTTER("Are","ss")% 너 나한테 그거 %STUTTER("inside","ss")% 해줄 거야?」
		PRINTFORMW 「충분한 윤활제를 챙기고 천천히 해봐-아아아아악~」
		PRINTFORMDL 너는 대화 도중 %CALLNAME:[[Shanghai]]%의 질 속으로 팔을 천천히 넣는다.
		PRINTFORMDL 그것이 팔 크기로 천천히 확장되면서 %HIS_HER([[Shanghai]])% 질이 통제 불가능하게 박동하고 떨린다.
		PRINTFORMDW 쾌락의 파도가 밀려오다 %CALLNAME:[[Shanghai]]% ~하면서 %HE_SHE([[Shanghai]])% 끊임없이 그리고 무의식적으로 매우 크게 신음한다.
		CALL HPH_PRINT(@"「오우 구우웅 후후 힘들다아아아 후후후후」","L")
		CALL HPH_PRINT(@"「응으으으으아아아~~ 흐읍흐읍흐읍흐읍흐읍흐읍」","W")
		IF PeeHold:[[Shanghai]]:0 <= -2
			CALL HPH_PRINT(@"「아아아악, 나-나 나오고 있어 흐으흐햣」","L")
			PRINTFORMDL 당신의 팔에서 가해지는 압력으로 %CALLNAME:[[Shanghai]]%의 방광 내용물이 분출된다.
			PRINTFORMDW %CALLNAME:[[Shanghai]]%은(는) 당신의 팔에 채워지는 것에 너무 정신이 팔려 %HIS_HER([[Shanghai]])%의 사고조차 알아채지 못한다.
			TRYCALL OMORASHI_END([[Shanghai]],1)
		ENDIF
		PRINTFORMDL 삽입을 끝내야 비로소 %HE_SHE([[Shanghai]])%은(는) %HIS_HER([[Shanghai]])% 감각들을 되찾기 시작한다.
		CALL HPH_PRINT(@"「너무 커서 후후후 뭐라도 하려고 하면 압도될 것 같아 후후후후」","L")
		SIF PeeHold:[[Shanghai]]:0 <= -2
			CALL HPH_PRINT(@"「나도 사고가 있었어. HPH 네가 아마 그 추가적인 윤활이 필요했을 거라고 추측해, HPH」","L")
		WAIT
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
