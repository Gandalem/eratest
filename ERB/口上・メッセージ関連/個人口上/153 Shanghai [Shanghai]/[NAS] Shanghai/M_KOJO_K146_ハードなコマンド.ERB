;==================================================
;144,放尿
;==================================================

@M_KOJO_MESSAGE_COM_K162_144
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K162_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K162_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT(@"「나에게 ~을 해달란 거야... %STUTTER("pee","ss")% HPH」","W")
		SELECTCASE K162_UPDATE:3
			CASE 0
				PRINTFORML 「나는 그런 일을 해낼 수 있는 유형이 아니야.」
				PRINTFORML 「보통 %CALLNAME:17%은 %HIS_HER(17)%의 인형들이 용변을 보지 않아도 되게 해주거든.」 
				PRINTFORMW 「특히 내가 항상 %CALLNAME:17% 곁에 있을 때라면 더욱 그렇고.」
				SIF !K162_UPDATE:4
					PRINTFORML 「그냥 편해서 기저귀를 차는 거야. 필요해서가 아니라고!」
				PRINTFORMW 「소변을 보고 싶어도 볼 수가 없다.」
			CASE 1
				CALL HPH_PRINT(@"「더럽네, HPH」","L")
				PRINTFORMW 「나는 대단한 %PRINT_MALE("boy",[[Shanghai]])%야, 나 바지 안 적셔!」
				IF !K162_UPDATE:4
					PRINTFORMDW 당신이 %HIS_HER([[Shanghai]])% 치마 아래 기저귀를 볼 수 있다는 사실은 다른 것을 말해준다.
					CALL HPH_PRINT(@"「와, 나는 기저귀를 차는 것 외에는 아무것도 안 해. 왜냐하면 그게 나를 안전하게 느끼게 해주거든.」","W")
				ENDIF
				PRINTFORMW 「몇 달 동안 사고를 치지 않았어.」
				CALL HPH_PRINT(@"「그리고 내가 %CALLNAME:17%과 함께 있지 않으니, 이건 인정 안 될 거야.」","W")
			CASE 2
				CALL HPH_PRINT(@"「좀...지저분하지 않아, 지저분해」","L")
				CALL HPH_PRINT(@"「화장실이 아닌 곳에서 소변 볼 때 장난치는 기분이 들어 HPH」","L")
				IF !K162_UPDATE:4
					CALL HPH_PRINT(@"「특히 내 기저귀에 있으면 말이야, HPH.」","W")
					CALL HPH_PRINT(@"「나한테는 좋지 않지만, 그냥... 화장실 가야 할 때 한 번에 볼 수 있어서 너무 기분이 좋아 HPH.」","W")
				ENDIF
				CALL HPH_PRINT(@"「나를 얼굴이 붉어지고 너무 작게 느끼게 한다, 흐읍흐읍.」","W")
			CASE 3
				CALL HPH_PRINT(@"「오줌 참기가 힘드네요, HPH」","L")
				IF !K162_UPDATE:4
					CALL HPH_PRINT(@"「나는 필요성을 느끼기 시작했지만 몇 분 후에 내 기저귀에 끝이 난다.」","L")
					PRINTFORM 「그러고 나서 %CALLNAME:17%은 몇 분 후에 내 기저귀를 확인하고 「이런」 같은 반응을 보였다.」
					CALL M_KOJO_COLOR_K17
					PRINTFORML 「어떡해 %CALLNAME:[[Shanghai]]%! 큰 %PRINT_MALE("boy",[[Shanghai]])%가 되기엔 부족했던 것 같아.」
				ELSE
					CALL HPH_PRINT(@"「갈 것 같은 느낌이 들었는데 몇 분 뒤에 내 팬티에서 끝난다 HPH」","L")
					CALL HPH_PRINT(@"「대부분의 경우 큰 고인물도 만들거나 심한 냄새가 나기도 한다 \@ GETBIT(nScat,2) ? 혹은 「흐으헵」 #  \@」","L")
					PRINTFORM 「그리고 나서 %CALLNAME:17%은 정말정말 화를 내고 이런 식으로 소리를 지르곤 했다:」
					CALL M_KOJO_COLOR_K17
					PRINTFORML 「%CALLNAME:[[Shanghai]]%!! 나는 네가 큰 %PRINT_MALE("boy",[[Shanghai]])% 바를 원한다고 생각했는데. 큰 %PRINT_MALE("boy",[[Shanghai]])%라면 그런 행동을 하지 않을 거야!」
					PRINTFORML 「다시 한번 그렇게 하면 기저귀를 입힐 거야.」
				ENDIF
				CALL M_KOJO_COLOR_K162
				CALL HPH_PRINT(@"「그리고 그것은 나를 정말 작게 느끼게 한다 헤에헤」","W")
				CALL HPH_PRINT(@"「당신이 주변에 있는 한, 내가 원하는 만큼 작아질 수 있을 것 같아 HPHHPHHPH.」","L")
				CALL HPH_PRINT(@"「바지에서 실수를 하는 거야, HPH 아니면 바닥에 하는 거야, HPH?」","L")
				CALL HPH_PRINT(@"「너에게도 그럴지도」","W")
			CASE 4
				PRINTFORM 「정말 통제할 수가 없어」
				FONTBOLD
				PRINTFORM ~할 때 
				FONTREGULAR
				PRINTFORML 「나 화장실 가야 해.」
				PRINTFORMW 「그냥 하는 거야. 그리고 항상 내 \@ K162_UPDATE:4 ? 팬티에 하게 돼. 그러면 %CALLNAME:17%이 정말 화를 내고, 내가 한 번 더 실수하면 나에게 배변 훈련을 시작하겠다고 위협해! # 기저귀~. 그러더니 %CALLNAME:17%은 멋있지 못하고, 새거나 지저분한 건 없는지 확인해야 해. \@ 」
				SIF PeeHold:17:2 <= -2 && !K162_UPDATE:4
					PRINTFORML 「그녀가 기저귀를 차고 있을 때조차 내가 내 것을 볼일 보는 것에 화를 낸다는 게 꽤 아이러니하다.」
				PRINTFORMDW 당신은 %HIM_HER([[Shanghai]])%에게 물을 좀 마시면 된다고 말한다.
				CALL HPH_PRINT(@"「물을 마시면 항상 나를 지나쳐 소변으로 변하는 것 같다 HPH」","L")
				CALL HPH_PRINT(@"「이 상황에는 편리하지만, 네게 부탁해서 갈아줘야 할 때는 그렇게 편리하지 않네...」","L")
				CALL HPH_PRINT(@"「내가 어디서 소변을 볼지 누가 알겠어, HPH」","W")
		ENDSELECT
		;this is first time text is getting too long
		;SELECTCASE TFLAG:144
		;ENDSELECT
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
