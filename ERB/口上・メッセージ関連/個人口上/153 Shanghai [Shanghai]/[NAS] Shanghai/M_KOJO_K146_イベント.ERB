				;（仕掛け人（失敗時）,誰も引っかからないので～は飽きてしまったようだ…）
				;（落ちた側（戦闘能力2～4）,～はすぐに穴から飛び出して周りをキョロキョロ見回している…）
				PRINTFORML 
			ENDIF
		CASE 17
			;▼雪だるま作り
			IF !ARG:1
				;行動中
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORML 
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
