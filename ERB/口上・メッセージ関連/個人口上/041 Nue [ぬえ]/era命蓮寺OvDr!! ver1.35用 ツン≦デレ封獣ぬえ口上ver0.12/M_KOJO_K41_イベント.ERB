	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
		;誘い文句
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 「Hey, what's up? Whatcha doin'?」
			PRINTFORML 「Hmm? Just chillin'?」
			PRINTFORML 「The heck... That's called being an idler, y'know?」
			PRINTFORML 「Alriiight, I guess I'll help you out then. I'm gonna graciously keep company to a loner like you!」
			PRINTFORMW 「Yup, we're going on a date now, that's what it means! Of course, you'll be paying for everything though, kuku...」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 1
		;受けた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 「Yay! Oh, um, I mean, yup! There's no way you won't accept my offer after all!」
			PRINTFORMW 「Well then, off we go! Let's have a lot of fun, shall we?」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 2
		;断った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 「Booo～ I know I look aloof myself, but... I wanna be let in on the fun too, alright?!」
			PRINTFORMDW Nue keeps grumbling something under her nose...
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 3
		;部屋に誘われた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 「Hey, %MASTERNAME:41%... Can you step inside my room for a sec?」
			PRINTFORML 「Don't worry, I'll keep you safe from the unknown lurking inside there, so it's totally safe. Kuku...」
			PRINTFORMDW Nue says with coy giggle as she starts pulling your arm.
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 4
		;部屋に誘われたのを受けた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 「Thaaat's the spirit♪ I knew you wouldn't let me down!」
			PRINTFORMDW Nue gets behind you and starts pushing on your back, in case you change your mind or something...
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 5
		;部屋に誘われたのを断った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 「Huh, you that busy? Sheesh...」
			PRINTFORML 「I can't believe you just refused to take a break and chill with Nue-chan together in her room...」
			PRINTFORMDW Nue's expression darkens as she starts to walk off to somewhere...
			RETURN 1
		ENDIF
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;相手が押し倒しを解除
;==================================================
@M_KOJO_EVENT_K41_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;modded
	IF K41_FudeOroshi == 3 && ARG < 3
		CALL K41_DOUTEI("end")
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
	;疲れた
		PRINTFORML 「Whoa, hhaaa, haha...」
		PRINTFORML 「I didn't think I'd get tired first from doing this...」
		PRINTFORML 「Seriously, %MASTERNAME:41%, are you sure you're not a youkai?」
		PRINTFORMDW Nue asks suspiciously while trying to catch her breath.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
	;満足して解放
		PRINTFORML 「...Phewww, I'm full♪」
		PRINTFORML 「That was quite the fine dish, thanks for letting me have it, %MASTERNAME:41%～」
		PRINTFORMDW Nue pats her belly with a happy smile after thoroughly having her way with you...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
	;満足したところを押し倒された
		PRINTFORML 「Kyaaahn! No, wait, %MASTERNAME:41%...!」
		PRINTFORML 「I'm supposed to be the one preying on you, not the other way around!!!」
		PRINTFORMDW Ignoring Nue's complaints, you keep her pinned as you start thinking about what you're going to do with her...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
	;壊れるまでしてあげる
		PRINTFORML 「Oh, did I hear that right? "Please Nue-sama, keep going until you break me", is that what you just said?」
		PRINTFORML 「Ku-ku-ku... HAHAHAHA!!! So be it then, %MASTERNAME:41%!」
		PRINTFORML 「I will instill soooo much fear of the unknown into you, you'll forever stay at home after this!」
		PRINTFORMDW Sticking out her tongue, Nue licks her lips as she gazes down on you with a malevolent grin...
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;一日の終了時(AFTERTRAニーの前)、面識がなければ呼び出されない
;==================================================
@M_KOJO_EVENT_K41_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		RETURN 1
	ENDIF
	
	IF TALENT:恋慕 && TALENT:恋人 && CFLAG:1091 && FIRSTTIME("NueChange") ;mod
		PRINTL
		CALL PRINT_FACE, 41, "笑顔", "服"
		PRINTFORMW 「I need to try to become the woman %MASTERNAME:41% wants me to be...」
		PRINTFORMW 「So that %HE_SHE(MASTER)%'d always choose me!」
		CALL COLORMESSAGE(@"Nue lost %GET_TALENTNAME_TR(13, 1)%!",C_YELLOW,2,1)
		CALL COLORMESSAGE(@"Nue acquired %GET_TALENTNAME_TR(50, 1)%!",C_YELLOW,2,1)
		CALL COLORMESSAGE(@"Nue acquired %GET_TALENTNAME_TR(62, 1)%!",C_YELLOW,2,1)
		TALENT:プライド = 0
		TALENT:習得速度 = 1
		TALENT:献身的 = 1
	ENDIF
ENDIF
RETURN 1

