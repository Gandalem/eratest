;/見事な響子口上の丸パクだと感心するがどこもおかしくはない
;名前を入力するループ
gLineCount = LINECOUNT
REDRAW 0
DO
	SIF LINECOUNT - gLineCount > 0
		CLEARLINE LINECOUNT - gLineCount
	PRINTFORMDL Input a name Nue should use when referring to you. (Type it in or press a button)
	IF NAME:MASTER != "Player"
		LOCALS = %NAME:MASTER%
	ELSE
		LOCALS = %CALLNAME:MASTER%
	ENDIF
	PRINTBUTTON @"[Just %LOCALS%]", @"%LOCALS%"
	PRINTL 　
	INPUTS
	; 行頭行尾の空白文字削除
	LOCALS = %RESULTS%
	REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
	;10文字以上は受け付けない
	IF STRLENS(LOCALS) > 16
		PRINTFORMW 「...Isn't that a tad long? Just gimme something shorter, like a nickname.」
		CONTINUE
	;空白は受け付けない
	ELSEIF RESULTS == ""
		PRINTDW Input a name.
		CONTINUE
	ELSE
		; Same name
		; we skip some name matches because either they're so short or not so unique, so we check them by their surname instead which should be a right pointer
		IF FLAG:なりきり != [[ぬえ]] && CONTAINS_NAME(LOCALS, "nue", "houjuu")
			PRINTFORMW 「Liar. You sure are unidentifiable, my ass.」
			CONTINUE
		; 白蓮が主人ではなく、白蓮というフレーズが含まれている。もしくは
		; 星が主人ではなく、寅丸もしくは星というフレーズが含まれている
		ELSEIF (FLAG:なりきり != [[白蓮]] && CONTAINS_NAME(LOCALS, "byakuren", "hijiri")) || (FLAG:なりきり != [[星]] && CONTAINS_NAME(LOCALS, "toramaru", "shou"))
			PRINTFORMW 「Yeah yeah, quit fooling around.」
			CONTINUE
		; 命蓮寺勢はじき
		; うんそうだね多々良勝五郎とか教える人もいるかもしれないもんね
		ELSEIF (FLAG:なりきり != [[ナズーリン]] && CONTAINS_NAME(LOCALS, "nazrin")) || (FLAG:なりきり != [[小傘]] && CONTAINS_NAME(LOCALS, "tatara", "kogasa")) || (FLAG:なりきり != [[一輪]] && CONTAINS_NAME(LOCALS, "kumoi", "ichirin")) || (FLAG:なりきり != [[ムラサ]] && CONTAINS_NAME(LOCALS, "minamitsu", "murasa")) || (FLAG:なりきり != [[響子]] && CONTAINS_NAME(LOCALS, "kasodani", "kyouko"))
			PRINTFORMW 「There's already a person with this name. Can't you give me a nickname instead?」
			CONTINUE
		ELSEIF FLAG:なりきり != [[マミゾウ]] && CONTAINS_NAME(LOCALS, "futatsuiwa", "mamizou")
			PRINTFORMW 「Mamizou, huh? Since when did you become so young?」
			CONTINUE
		; 道教勢力はじき
		ELSEIF (FLAG:なりきり != [[芳香]] && CONTAINS_NAME(LOCALS, "miyako", "yoshika")) || (FLAG:なりきり != [[青娥]] && CONTAINS_NAME(LOCALS, "kaku", "seiga")) || (FLAG:なりきり != [[屠自古]] && CONTAINS_NAME(LOCALS, "soga", "tojiko")) || (FLAG:なりきり != [[布都]] && CONTAINS_NAME(LOCALS, "mononobe", "futo")) || (FLAG:なりきり != [[神子]] && CONTAINS_NAME(LOCALS, "toyosatomimi", "shoutoku", "taishi", "miko"))
			PRINTFORMW 「Geh, can't you come up with something better?」
			CONTINUE
		; 博麗霊夢というフレーズが含まれてる。もしくは
		; 東風谷早苗というフレーズが含まれている
		ELSEIF CONTAINS_NAME(LOCALS, "hakurei", "kochiya")
			PRINTFORML 「Huh, are you that shrine maiden's relative or something? Why are you even here?」
			PRINTFORML 「...Well, whatever. None of my business, I guess.」
			PRINTFORML
		; 霧雨魔理沙というフレーズが含まれてる。
		ELSEIF CONTAINS_NAME(LOCALS, "kirisame")
			PRINTFORML 「Huh, are you that magician's relative or something? Why are you even associating with Buddhists?」
			PRINTFORML 「...Well, whatever. None of my business, I guess.」
			PRINTFORML
		; 直接入力ならいけると思ったか？弾くぜ！
		;just checking FIRSTTIME("U41-1") invalidates it for repeated checks, so removed
		;any kinds of niichan/niisan will be matched (so onisan, oniichan, etc)
		ELSEIF ABL:親密 < 4 && STRCOUNT(LOCALS, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$")
			PRINTFORMW 「Can't you take it a little more seriously?」
			CONTINUE
		ELSEIF ABL:親密 < 7 && STRCOUNT(LOCALS, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$")
			PRINTFORMW 「Can't you take it a little more seriously?」
			CONTINUE
		ELSEIF (ABL:従順 < 7 || ABL:奉仕精神 < 7) && STRCOUNT(LOCALS, "((?i)master|lord|god)$")
			PRINTFORMW 「Can't you take it a little more seriously?」
			CONTINUE
		ELSEIF (!TALENT:恋人 || !TALENT:恋慕) && STRCOUNT(LOCALS, "(?i)(husband|dear|darling|honey|hubby)$")
			PRINTFORMW 「Can't you take it a little more seriously?」
			CONTINUE
		ENDIF
		
		PRINTFORML 「So "%RESULTS%", right?」
		CALL ASK_YN
		IF RESULT == 0
			;あなたの名前を%MASTERNAME:41%に格納
			MASTERNAME:41 = %RESULTS%
			PRINTFORMDL 
			BREAK
		ELSEIF RESULT == 1
			CONTINUE
		ENDIF
	ENDIF
LOOP 1
