; Modular ERB: 個人口上/041 Nue [ぬえ]/era命蓮寺OvDr!! ver1.35用 ツン≦デレ封獣ぬえ口上ver0.12/M_KOJO_K41_弾幕勝負.ERB
;==================================================
;弾幕勝負 added
;==================================================
;

@M_KOJO_MESSAGE_COM_K41_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;戦闘前
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		PRINTFORMW 「쿠크크크... 나랑 결투라도 하고 싶나?」
		PRINTFORMW 「하지만 이건 네가 감당하기엔 좀 버거울지도 몰라.」
		PRINTFORMW 「내가 너를 박살 내고 나서 울면서 찾아오진 마!」
		PRINTFORMDW 누에가 만족스럽게 비웃으며 하늘 높이 날아올라 손에 든 삼지창을 휘둘렀다!
		PRINTL
		IF RAND:3 == 0
			PRINTFORMW 「밤의 공포를 잊은 너 인간!」
			PRINTFORMW 「이 미확인 비행 물체의 공포로 죽어라!!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「상식을 지식으로 포기한 인간이여!」
			PRINTFORMW 「정체불명의 비행 물체의 공포 속에서 죽어라!!」
		ELSE
			PRINTFORMW 「호기심으로 행동하는 어린애 같으니!」
			PRINTFORMW 「이 미확인 비행 물체가 너를 죽을 때까지 춤추게 만들 것이다!!」
		ENDIF
		PRINTDATADW
			DATAFORM ――불길한 구름 "헤이안의 어두운 구름"!!!
			DATAFORM ――미확인된 "분노의 붉은 UFO 침공"!!!
			DATAFORM ――누에 사인 "신비한 뱀 쇼"!!!
			DATAFORM ――미확인된 "슬픔의 푸른 UFO 침공"!!!
			DATAFORM ――미확인된 "화장실의 하나코 양"!!!
			DATAFORM ――미상 "미지의 형상을 지닌 하늘물고기"!!!
			DATAFORM ――미상 "알 수 없는 기믹을 가진 요괴 구체"!!!
		ENDDATA
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				IF RAND:3 == 0
					PRINTFORMW 「흥, 겁먹지 않은 것 같네.」
					PRINTFORMW 「하지만 네가 두렵지 않다면 내 마음은 메말라 버릴 거야.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「시작 라운드를 통과한 것 같아!」
					PRINTFORMW 「%MASTERNAME:41% 잘 했지만, 이건 시작에 불과해!」
				ELSE
					PRINTFORMW 「나를 진지하게 만들고 있어... 나중에 후회할지도 몰라.」
					PRINTFORMW 「하지만 지금 너한테는 끝이야!」
				ENDIF
				PRINTDATADW
					DATAFORM ――Nue Sign "탄막 키메라"!!!
					DATAFORM ――미확인 "정의를 향한 녹색 UFO 침공"!!!
					DATAFORM ――Nue Sign "정의되지 않은 어둠"!!!
					DATAFORM ――미확인 "공포를 향한 무지개 UFO 침공"!!!
					DATAFORM ――미확인 "보라색 거울"!!!
					DATAFORM ――미확인 "붉은 망토, 푸른 망토"!!!
					DATAFORM ――"방랑하는 별에서 온 탄막 X"!!!
					DATAFORM ――알 수 없는 "미지의 궤도를 도는 불빛들"!!!
				ENDDATA
			CASE 1
				IF RAND:2 == 0
					PRINTFORMW 「아우으!!! 드디어 해냈군!」
					PRINTFORMW 「내가 EX 보스인 게 헛된 게 아니야! 한 번이 아니라 두 번이나 말이지!」
					PRINTFORMW 「대부분은 내가 가장 쉽다고들 주장하지만...」
					PRINTFORMW 「거짓말이야! 그저 결코 진심으로 임하지 않았을 뿐이라고! 하지만 지금은... 망설이지 않아!」
					PRINTFORMW 「네 약점을 폭로하고, 네 본모습을 드러내고, 너를 복종시킬 테니...」
					PRINTFORMW 「그 알려지지 않고 식별할 수 없는 공포의 허무함에 복종해라, 그리고 죽어라아아아아!!!」
					PRINTFORMDW ――원한 활 "겐잔미 요리마사의 활"!!!
					PRINTL
					PRINTFORMDW 갑자기 UFO들이 사방에서 빠르게 몰려오는 것이 보인다!
					PRINTFORMDW 어떤 것들은 실제 단막탄을 숨기고, 어떤 것들은 그냥 허상이다...
					PRINTFORMDW 하지만 상황이 정말 순식간에 혼란스러워진다!
					PRINTFORMDW 심지어 일부는 완전히 다른 형태로 모습을 바꾸며 당신을 당황하게 만든다!
					PRINTFORMDW 누(Nue)는 점점 어려워지는 패턴 속에서 힘겹게 버티는 당신을 비웃으며 웃는다...
				ELSE
					PRINTFORMW 「오우-오우-오우... 이제 네가 해버렸구나, 인간!!」
					PRINTFORMW 「나 같은 고대의 요괴를 아무런 대가 없이 마음대로 쓰러뜨릴 수는 없어!」
					PRINTFORMW 「네가 나를 건 그날을 후회하게 해주마... 죽음조차 너의 구원이 되지 못할 거다!」
					PRINTFORMDW 허, 저 대사... 어디선가 들었던 것 같군.
					PRINTFORMW 「닥-닥쳐!!! 진정한 나를 봤으니, 널 땅속에 묻어버릴 수밖에 없어!」
					PRINTL
					PRINTFORMW 「그럼 참을 필요가 없겠군!」
					PRINTFORMW 「이것을 봐라, 명백한 궁극의 미지수(UNKNOWN)를!」
					PRINTFORMDW ――"헤이안쿄의 악몽"이다!!!
					PRINTFORMDW 갑자기 전체 필드가 사각형으로 나뉘더니, 바둑판처럼 비슷한 사각형 패턴들로 서로 바뀌었다!
					PRINTFORMDW 어렵긴 하지만, 정말 치명적인 건 아니다... 어쩐지 그게 사람을 끌어당기는 것 같다.
				ENDIF
				LOCAL = 200
				HANDICAP_FIXED += LOCAL
				HANDICAP_RAND += LOCAL * ABL:戦闘能力
			CASE 0
				PRINTFORMDW 누아가 패배하여 땅에 쓰러지며 날카로운 비명을 지른다...
				PRINTFORMW 「누우우우우우우우~엔느으으...!!!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		IF RAND:3 == 0
			PRINTFORMW 「그렇다, 너는 곧 끝을 맞이할 것이다!」
			PRINTFORMW 「피할 수 없는 것을 받아들이고 죽어라아아아!!!」
		ELSEIF RAND:2 == 0
			PRINTFORMDW 누에가 장난치며 즐기는 것처럼 보일지 모르지만... 그녀는 만만해서 되는 게 아니야!
			PRINTFORMW 「크크크! 나는 최고의 스승에게 훈련받았다는 걸 모르는 건가! 자, 이거랑 저기 받아라!」
		ELSE
			PRINTFORMW 「꽤 죽고 싶어 하는군, %MASTERNAME:41%...」
			PRINTFORMW 「네가 그 이상으로 좀 더 발버둥 쳐줄 줄 알았는데!」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 1 TO 3
				IF ABL:MASTER:戦闘能力 < 3
					PRINTFORMW 「크크크... 예측 가능한 결과로군!」
					PRINTFORMW 「%MASTERNAME:41%, 네가 몇 번을 시도하든 이대로 나를 이길 수는 없을 거야.」
				ELSE
					PRINTFORMW 「...후우! 솔직히 이걸 이겼다는 게 놀랍네.」
					PRINTFORMW 「내 마지막 속임수가 당신을 조금 흔들었나, 응 %MASTERNAME:41%?」
				ENDIF
				PRINTFORMW 「음, 재미있었어. 나에 도전할 수 있다고 생각하면 또 연락해...」
				PRINTFORMW 「후회하지 않게 해줄 테니까♪」
			CASE 0
				IF !CFLAG:弾幕勝負勝利
					PRINTFORMW 「우으... 지고 말았어...! 그렇게 젊은 인간에게 또 깔리다니 믿을 수가 없어!」
					PRINTFORMW 「이건 고통스러운 기억들을 떠올리게 하네...」
					PRINTFORMW 「인간들에게 패배하는 건... 결코 좋지 않았지...」
					PRINTFORMDW 사람들을 골탕 치고 장난치는 걸 좋아하는 소녀, 후쥬우 누에...
					PRINTFORMDW 너에게 완전히 박살 났어! 축하해!
					PRINTFORMW 「우으... 그만둬... 나를 어떤 악당처럼 보이게 하지 마... 우우...」
				ELSE
					IF ABL:MASTER:戦闘能力 < 3
						PRINTFORMW 「T-이건 그냥 초보자의 행운일 뿐이야! 오늘은 준비가 안 됐어!」
						PRINTFORMW 「핑계를 대는 거야?! 아, 조용히 해, 너...!」
						PRINTFORMW 「하지만... 내가 양보할게, %MASTERNAME:41%. 너 정정당당하게 이겼잖아.」
						PRINTFORMW 「여기 오려고 속임수 쓰지 않았지, 안 그래...?」
						PRINTFORMDW 어색하게 고개를 끄덕인다.
						PRINTFORMW 「흥, 뭐 상관없어. 하지만 너무 자랑하지는 마, 내 평판 망칠 테니까.」
						PRINTFORMW 「만약 그렇게 한다면, 네 인생이 위험에 처할지도 몰라, 쿠쿠쿠...」
					ELSE
						PRINTFORMW 「우웅, 정말 너무 못됐어, %MASTERNAME:41%...」
						PRINTFORMW 「적어도 가끔은 나도 이기게 해줘!」
						PRINTFORMW 「아, 알고 있어! 이건 완전히 망했으니까 옷 갈아입는 거 내가 시킬게...」
						PRINTFORMDW 어라...?
					ENDIF
				ENDIF
				IF TALENT:恋人
					PRINTL
					PRINTFORMDW 당신은 다가가 누에를 부축하며 머리를 쓰다듬고 그녀를 진정시키려 한다.
					PRINTFORMW 「나... 결국엔 이걸 잘하게 될 거야! 열심히 훈련하고, 그리고...」
					PRINTFORMW 「우리가 끝내겠어, %MASTERNAME:41%!」
					PRINTFORMDW 물론이지...
					PRINTFORMW 「...그리고 무슨 일이 있어도 침대 위에서는 너에게 지지 않을 거야! 그걸 기대해!!!」
					PRINTFORMDW ...꿀꺽!
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
