@M_KOJO_MESSAGE_COM_K41_312
CALL M_KOJO_MESSAGE_COM_K41_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K41_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		IF ABL:親密 >= 5
			PRINTFORMW 「%RANDKISS("kiss")%... 제발, 안 된다는 거 알잖아...」
		ELSE
			PRINTFORMW 「%RANDKISS("kiss")%... %FSYN("lips_over")%, %TOLOWER(FSYN("lips_muffle"))%...」
		ENDIF
	ELSEIF TALENT:キス未経験 && TFLAG:193 != 99
		CALL K41_KISS
	ELSEIF CFLAG:うふふ
		PRINTFORML 「%RANDLIPS()%...」
		PRINTFORML 「더... 좀 더 키스하자...♪」
	ELSEIF TFLAG:193 == 99 ;added, since this is a flat out rejection, moved the og line to the bad reaction
		PRINTFORMW 「응? 뭘 하려고 키스하는 거야?」
		PRINTFORMW 「죽고 싶어? 말해봐, 못 듣겠으니까!」
	ELSEIF TFLAG:193 == -1 ;modded
		PRINTFORMW 「제발, 이 첫 번째 일에 대해 기분 같은 걸 고려해 봐야지!」
	ELSE
		;added
		LOCAL = 0
		IF ABL:欲望 >= 8 && RAND:2
			CALL HPH_PRINT(@"「%RANDLIPS()%...!HPH」", "L")
			LOCAL = 1
		ELSEIF ABL:親密 >= 5
			PRINTFORML 「%RANDKISS("kiss")%! %RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%...」
		ELSE
			PRINTFORML 「%FSYN("lips_muffle")%...?! %FSYN("lips_over")%...」
		ENDIF
		IF LOCAL ;modded
			PRINTFORMW 「후후, 이 키스만으로는 만족할 수 없는 것 같아.」
			PRINTFORMW 「더 강렬한 걸 해보자, 하나가 되자...♪」
		ELSEIF ABL:親密 >= 5
			PRINTFORMW 「후훗, 키스만으로 왜 이렇게 기분이 좋은지 모르겠어...」
			PRINTFORMDW 그녀가 말하는 와중에도 누에(Nue)는 당신과 계속 입을 맞춘다.
		ELSE
			PRINTFORMW 「쳇, 그렇게 창피한 짓을 하다니...」
			PRINTFORMW 「그럼 키스해야 하나?... 어쩌면 다른 때에.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
