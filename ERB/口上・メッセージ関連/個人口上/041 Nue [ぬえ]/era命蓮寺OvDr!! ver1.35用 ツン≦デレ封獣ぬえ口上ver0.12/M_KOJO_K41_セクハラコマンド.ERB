;313,胸愛撫
;==================================================

@M_KOJO_MESSAGE_COM_K41_313
CALL M_KOJO_MESSAGE_COM_K41_313_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K41_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		PRINTFORMW 「%MOAN("m")%... %MOAN()%, 아우우흐...」
	ELSE
		IF TFLAG:193 == -1 ;added
			PRINTFORMW 「뭐...뭐야?! 어?! 어디를 만지고 있는 건지 알고 있어?!」
			PRINTFORMW 「그걸로 팔을 그냥 뽑아버리지 않을 거라고 생각하는 거야?!」
			RETURN 1
		ENDIF
		;added section
		IF TALENT:バストサイズ >= 0 && CFLAG:うふふ != 2 && FIRSTTIME("NueTouchBoobie")
			PRINTFORMW 「음, 얘네? 정말 만져보고 싶어?」
			PRINTFORMDW 누에가 드레스 위로 가슴을 다소 의심스럽게 들어 올리자, 그녀의 큰 봉우리가 당신의 시선을 확실히 끌었다.
			PRINTFORMW 「뭐, 네가 원한다면 이리 와봐!」
			PRINTFORMDW 다음 순간, 그녀는 갑자기 당신의 손을 부드럽고 말랑한 가슴 위에 올려 그것을 움켜쥐게 만들었다.
			PRINTFORMDW 그렇게 하자 브라 안에서 그녀의 가슴이 움직이는 말랑한 소리마저 들린다...
			PRINTFORMW 「계속 필사적으로 만지고 있네... 즐거운 거야?」
			PRINTFORMW 「생각해보니, 인간 남자는 네가 가슴을 만지게 해주면 뭐든지 해줄 거라고 듣곤 했어.」
			PRINTFORMW 「이런 일이 벌어질 줄은 상상도 못 했어, 쿠쿠쿠... 앞으로 참고 둘게♪」
			RETURN 1
		ENDIF
		IF TALENT:恋人
			IF ABL:Ｂ感覚 >= 7
				PRINTFORMW 「%MOAN("m",,2)%... 흐으, 아 예, 바로 거기! 너무 좋아...!」
				PRINTFORMW 「좀 더 세게 쥐어도 돼, 있잖아...?」
			ELSEIF ABL:Ｂ感覚 >= 3
				PRINTFORMW 「%MOAN()%, 더, 이렇게 계속 만져줘...」
				PRINTFORMW 「%MOAN("m")%... %MOAN()%, 이거 사실 좀 기분 좋을지도 모르겠어...♪」
			ELSE
				PRINTFORMW 「%MOAN()%...! 간지러워...」
				PRINTFORMW 「좀 더 만져줘... 부드럽게...」
			ENDIF
		ELSE
			IF ABL:Ｂ感覚 >= 7
				PRINTFORMW 「그만해, 내 %FSYN("chest")%을 그렇게 만지지 마...!」
				PRINTFORMW 「%MOAN(,,2)%, 너무 좋다... %MOAN("l:m",,2)%!!!」
			ELSEIF ABL:Ｂ感覚 >= 3 ;modded
				PRINTFORMW 「「%MOAN()%, 크으... %MOAN("m")%, %MOAN(,1)%...!!!」
				PRINTFORMW (우응, 신음이 새어 나왔다...)
			ELSE
				PRINTFORMW 「자, 여기 네가 원하던 게 있어, 나의 %FSYN("chest")%!」
				PRINTFORMW 「%MOAN()%... 자, 그렇게 들뜨지 말아줘...♪」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
