LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;added
	IF ABL:サドっ気 >= 5 && !RAND:3
		PRINTFORMW 「음? 왜 갑자기 멈췄지? 그건 말이야...」
		PRINTFORMW 「%MASTERNAME:41%, 네 따위에게 내 발조차 너무 아깝단다! 그러니 여기...」
