; Modular ERB: 個人口上/041 Nue [ぬえ]/era命蓮寺OvDr!! ver1.35用 ツン≦デレ封獣ぬえ口上ver0.12/M_KOJO_K41_依頼.ERB
;added, original content
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K41(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME '= STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K41
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K41(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K41(ROLE, SCENE, CLIENT_ID)
ENDIF
RESETCOLOR
SIF RESULT
	RETURN 1
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K41
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			;SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;CASE "一般依頼名"
			SELECTCASE SCENE
				CASE "依頼提示時"
					;依頼を持ちかけられる時
					IF TALENT:恋人
						PRINTFORML 「집안일 하는 거 익숙하잖아, 그렇지 %MASTERNAME:41%?」
						PRINTFORML 「응, 음, 여기서 나 좀 도와줬으면 하는데...」
						PRINTFORML 「하지만 말이야, 제대로 로맨틱하게 보답해 줄게... 내 말 알아주면♪」
					ELSEIF TALENT:恋慕
						PRINTFORML 「음, %MASTERNAME:41%... 귀찮게 해서 죄송하지만, 제가 도움을 받고 싶은 것이 있어요...」
						PRINTFORML 「이거 저를 위해 해줄 수 있나요, 음, 부... 부탁이에요?」
					ELSE
						PRINTFORML 「별일 없어, %MASTERNAME:41%? 바빠? 아니야?」
						PRINTFORML 「있잖아, 나를 위해 작은 부탁 하나 들어줄래? 후하게 보상해 줄게, 쿠쿠!」
					ENDIF
				CASE "依頼非受託時"
					;内容だけ見て受託しなかった時
					IF TALENT:恋人
						PRINTFORML 「아유, 정말이지... 정말로, %MASTERNAME:41%?」
						PRINTFORML 「연인들은 서로 도와야 한다고 생각했는데, 흐윽...」
						PRINTFORML 「아니거든, 난 그냥 장난치는 거야. 원하지 않으면 괜찮아! 그래도 난 널 사랑해!」
					ELSEIF TALENT:恋慕
						PRINTFORML 「아, 그렇군요... 뭐, 다음 기회에 해야겠어요?」
					ELSE
						PRINTFORML 「쳇, 이런.」
						PRINTFORML 「너는 교코가 아니구나, 알겠어. 네가 거절할 수 있다는 걸 누가 알았겠니?」
					ENDIF
				CASE "依頼受託時"
					;依頼を受託した時
					IF TALENT:恋人
						PRINTFORML 「잘했네, %MASTERNAME:41%!」
						PRINTFORML 「하지만 당장 시작하는 게 좋겠어! 혹시 아직 궁금한 점 있으면 나한테 연락해 줘.」
					ELSEIF TALENT:恋慕
						PRINTFORML 「정말 고마워요! 저, 음... 결과가 기대되네요.」
					ELSE
						PRINTFORML 「좋아, 네가 믿을 수 있다고 생각했어.」
						PRINTFORML 「하지만 시간 제한 조심해, 그리고 있잖아? 행운을 빌게, 쿠쿠쿠...」
					ENDIF
				CASE "依頼確認時"
					;[366]で依頼内容を依頼人に確認した時
					PRINTFORML 「자, 해야 할 일은 이거야...」
				CASE "依頼破棄時"
					;受託した依頼を破棄する時
					IF TALENT:恋人
						PRINTFORML 「안 되겠네, 응?」
						PRINTFORML 「여전히 실망스럽긴 하지만, 뭐 적어도 실패하진 않았잖아.」
					ELSEIF TALENT:恋慕
						PRINTFORML 「오-아... 괜찮아요, 알려줘서 고마워요. 다른 걸 생각할게요, 괜찮아요.」
					ELSE
						PRINTFORML 「뭐-뭐라고?!」
						PRINTFORML 「벌써 네가 그걸 하고 있을 거라고 예상하고 있었는데, 이런!」
						PRINTFORML 「언젠가는 나한테 그에 대한 보상을 받아내야겠어...」
					ENDIF
				CASE "依頼実行直前"
					;[367]で依頼を実行する時、実行処理の前に呼び出される
					PRINTFORML 「좋아, 여기서 뭘 할 수 있는지 보자...」
				CASE "依頼実行直後"
					;[367]で依頼を実行する時、実行処理の後に呼び出される
					PRINTFORML 「...음, 어디 보자...」
				CASE "成功報告時"
					;報告時（成功）
					IF TALENT:恋人
						PRINTFORMDL 잠시 후, 뉴는 만족스러운 미소를 지으며 당신을 맞이한다. 그녀는 분명 당신을 보고 기뻐하고 있다.
						PRINTFORML 「내 %MASTERNAME:41%가 왔군... 이리 와봐.」
						PRINTFORMD 당신은 순종적으로 뉴에게 다가간다. 
						IF RAND:2 && !(TALENT:キス未経験 + TALENT:MASTER:キス未経験)
							PRINTFORMDW 아주 열정적인 키스를 해준다. 숨이 넘어갈 정도로 오래 지속되는 키스였다.
							PRINTFORML 「후후... 더 원하면 다시 와줘, 알았지?」
							CALL MUTUAL_KISS
						ELSE
							PRINTFORMDW 당신을 꼭 안고 귀에 달콤한 말을 속삭이며 어루만진다.
							PRINTFORMDL 당신은 그녀의 가슴팍에 얼굴을 묻고 머리를 쓰다듬는 그녀를 느끼며 평온함을 느낀다...
							PRINTFORML 「거기 있지, 괜찮아... 착하다 %PRINT_MALE("boy", MASTER)%, 착하다 %PRINT_MALE("boy", MASTER)%...♪」
							PRINTFORMW 「얼굴이 좀 빨개졌네, 에헤헤～」
						ENDIF
						BASE:ムード = 1000 ;mood up
						BASE:理性 = 0 ;reason down
						CFLAG:ディレイ = 30 ;set delay so you don't get pushed down immediately
						PALAM:好意 += 3000
					ELSEIF TALENT:恋慕
						PRINTFORML 「멋지다! 너는 절대 실망시키지 않아, %MASTERNAME:41%!」
						PRINTFORML 「아, 하지만 이렇게 흥분해서는 안 되는 것 같아...」
					ELSE
						PRINTFORML 「음, 마땅히 인정해야 할 부분은 인정해줘야겠지.」
						PRINTFORML 「전반적으로 정말 잘했어, %MASTERNAME:41%. 앞으로 너한테 더 의지하게 될 것 같아, 후후...」
					ENDIF
				CASE "失敗報告時"
					;報告時（失敗）
					;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					IF TALENT:恋人
						PRINTFORML 「아이고, 안됐네. 다음엔 꼭 성공할 수 있을 거야 %MASTERNAME:41%, 걱정 마.」
						PRINTFORML 「기운 북돋아 줄 작은 선물이 여기 있어...」
						PRINTFORMDW 누에가 다가와 당신의 뺨에 입을 맞춘 후, 손으로 당신의 목을 감싸고 눈을 바라보았다.
						PRINTFORML 「에헤헤~ 힘내, 나의 사랑. 절대로 포기하지 마, 알았지? 언제나 다음 기회는 있는 거야.」
						PRINTFORMDW 실패했음에도 불구하고, 당신은 활력을 되찾으며 그녀의 말에 고개를 끄덕이고 다음번엔 더 잘하겠다고 다짐했다.
					ELSEIF TALENT:恋慕
						PRINTFORML 「기다려, 사과할 필요 없어... 괜찮아, %MASTERNAME:41%...」
						PRINTFORML 「애초에 이걸로 당신을 귀찮게 했어야 했는데. 뭐, 이미 바쁘시잖아요...」
						PRINTFORML 「응, 그냥 없었던 일로 해...」
					ELSE
						PRINTFORML 「아이고, 정말 난장판이군.」
						PRINTFORML 「솔직히 이쯤 왔으면 내가 직접 했어야 했는데!」
						PRINTFORML 「%MASTERNAME:41%에게 맡긴 건 내가 바보였어...」
						PRINTFORMDW 누(Nue)는 계속 잔소리를 할수록 점점 더 심술을 부리는 듯 보인다...
					ENDIF
			ENDSELECT
			;ENDSELECT
			RETURN 1
		ENDIF
ENDSELECT
RESETCOLOR
