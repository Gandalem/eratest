@M_KOJO_MESSAGE_COM_K41_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「후후, 원한다면 나를 더 만져도 돼...♪」
		PRINTFORMDW 누에가 당신의 주무름에 키스로 응답했다.
		PRINTFORMW 「푸하아... 아타%PRINT_MALE("boy", MASTER)%, %MASTERNAME:41%... 바로 거기, 아주 잘하고 있어...!」
		PRINTFORMDW 당신이 부드럽게 누에의 가슴과 사지를 어루만질 때마다 조용한 신음이 새어 나왔다.
		PRINTFORMDW 그녀의 신음은 점점 커졌고, 가장 흥분해 가는 듯 눈이 초점을 잃기 시작했다.
		PRINTFORMW 「나하아... 야안, 아주 조금이라도 기분이 들기 시작하는 것 같아...♪」
		PRINTFORMDW 누에가 열이 오르는 표정으로 속삭였다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMDW 
			RETURN 1
		ELSE
			PRINTFORMDW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMDW 
			RETURN 1
		ELSE
			PRINTFORMDW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「%MOAN()%... 부디 더 만져줘, %MASTERNAME:41%...」
		PRINTFORMDW 가슴이나 은밀한 곳을 어루만지는 손길이 닿을 때마다 누에(Nue)는 당황하며 몸을 움츠린다.
		RETURN 1
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「헤에이, 여기도 나 만져봐. 응, 여기, 이 부분이 정말 좋아...」
		PRINTFORMDW 누에가 당신의 손을 잡았는데, 당신은 주로 그녀의 가슴을 쓰다듬는 데 집중하고 있었다. 그리고 그 손을 그녀의 음부 쪽으로 이끌었다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「쿠쿠...! 이 지경까지 완전히 나에게 빠졌구나, 응? 내 몸을 그렇게 많이 연모하는 거야?」
		PRINTFORMDW 누에가 지배적인 태도로 묻자, 너는 더욱 철저한 애무로 응답했다...
		RETURN 1
	ENDIF
ENDIF
RETURN 1
