@M_KOJO_MESSAGE_COM_K41_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_VIRGIN(TARGET)
			PRINTFORMW 「기-기다려, 너 뭐야... 어디에 얼굴을 박고 있는 거야?! 너... 발 연인! 변태!!!」
			PRINTFORMW 「에? 그게 아니라고...?―――히아, 푸아아아안?!?!」
			PRINTFORMW 「아-아니, 하지 마, 멈춰! 그 부위는 더러워... 만지는 건 괜찮지만 핥는 건...」
			PRINTFORMW 「뭐, 뭐라고 하는 거야... 아래쪽이 그렇게 귀엽고 맛있다니... 말도 안 돼!」
			PRINTFORMW 「아아, 흐응!!!」
			PRINTFORMDW 네가 늘 Nue의 클리토리스에 혀를 갖다댈 때마다 그녀의 몸은 위아래로 움찔거린다...
		ELSE
			PRINTFORMW 「...그런 자세는 뭐야? 내 앞에서 네 발로 기기까지 해, 나한테 밟히고 싶어? 쿠쿠쿠...」
			PRINTFORMW 「응? 잠깐, 너 지금 뭐 하는 거야... 끼야아악?!」
			PRINTFORMW 「오, %MASTERNAME:41%... 네가 이렇게 간절하게 내 밑으로 들어올 줄은 몰랐어!」
			PRINTFORMW 「하지만 이 느낌... 완전히 불쾌하지는 않아. 계속해봐...♪」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 「어머나... 우리가 연결되어 있던 이 자리가 아직도 네 물건들로 가득하네.」
			PRINTFORMW 「그거 핥을 거야? 하지만 더럽잖아, 알잖아... 뭐, 난 너 못 하게 안 할게♪」
			RETURN 1
		ENDIF
	ENDIF
	IF IS_VIRGIN(TARGET)
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「응우, 더는 안 돼... 내 꿀을 네 얼굴에 전부 뿌려줄 거야...!」
				PRINTFORMDW 누아가 흘러넘치는 그녀의 진액을 마시며 말한다.
				PRINTFORMW 「안 돼! 그렇게 시끄럽게 소리 내지 마, 정말 역겨워...!」
			CASE 1
				PRINTFORMW 「%MOAN("l:m",,3)%...!」
				PRINTFORMDW 당신이 혀로 누에의 슬릿을 자극하자 그녀는 신음하며 클리토리스를 부드럽게 벗긴다.
				PRINTFORMW 「%FSYN("hii")%――! 그곳...! 정말 민감해, 나... 안 돼, 하지 마 %MOAN(,1,2)%!!!」
				PRINTFORMDW 귀여운 클리토리스가 노출되자마자 누에의 연모액이 그녀의 보지에서 분수처럼 뿜어져 나온다.
			CASE 2
				PRINTFORMW 「%MOAN(,,2,"dot")%!!!」
				PRINTFORMDW 당신은 올라가는 길에 혀로 그녀의 클리토스를 만지면서 누에의 보지 입술을 핥는 것을 즐긴다.
				PRINTFORMW 「%MOAN()%, 그만둬, 그러지 마--... %FSYN("hii")%! %MOAN()%... %MOAN()%!!!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「%MOAN()%... 푸아하핫...!」
				PRINTFORMDW 너는 평소보다 훨씬 절제된 방식으로 Nue를 자극해서, Nue가 경계심을 풀게 만든다...
				PRINTFORMW 「무슨 일이야, %MASTERNAME:41%? 오늘은 영 미지근하잖아―――%MOAN("m")%!」
				PRINTFORMDW 그녀는 갑작스러운 흐름의 변화에 놀란 기색을 숨기지 못한다.
				PRINTFORMW 「%MOAN()%...! %FSYN("hii")%...! %MOAN(,,3)%, 그렇게 세게 하지 마아...!」
				PRINTFORMW 「아, 안 돼, 거기 물지 마--... %MOAN("h")%!!!」
			CASE 1
				PRINTFORMW 「――――――!!! 당신의 혀가 내 안을 미끄러지는 게 느껴져, %MASTERNAME:41%...!」
				PRINTFORMDW 네루는 네 혀가 그녀의 틈 안으로 미끄러져 들어와 닿을 수 있는 모든 구석구석을 핥을 때 그렇게 말한다.
				PRINTFORMW 「%MOAN("m",,3)%...! 더, 원하는 만큼 계속 핥아줘...♪」
			CASE 2
				PRINTFORMW 「후우... 흥! 너는 마치 나를 온몸으로 졸졸 따라다니는 강아지 같구나, 정말 어리네――%MOAN()%!」
				PRINTFORMDW %BREAKENG(@"누에는 당신이 입으로 그녀의 클리토스를 비비기 시작하고 머리를 잡아 그녀의 사타구니에 짓누르자 갑자기 움찔했다.")%
				PRINTFORMW 「%MOAN()%, 나, 내가 철회할게... 너 정말 잘하고 있어, 그 느낌이 %SPLIT_G("so good:awesome:not bad at all")%이야...」
				CALL HPH_PRINT(@"「마음껏... %MOAN()%! ...더 깊숙이 밀어 넣어봐...HPH」", "W")
			CASE 3
				PRINTFORMW 「쿠쿠... 아래쪽의 미지의 맛을 즐기고 있니?」
				PRINTFORMW 「좋아, 아주 잘하고 있어 %MASTERNAME:41%... 네가 원하는 만큼 마음껏 나를 핥게 해줄 테니까!♪」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
