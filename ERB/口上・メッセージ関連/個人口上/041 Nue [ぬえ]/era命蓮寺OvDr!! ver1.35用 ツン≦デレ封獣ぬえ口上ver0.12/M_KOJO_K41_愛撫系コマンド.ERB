@M_KOJO_MESSAGE_COM_K41_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_VIRGIN(TARGET)
			PRINTFORMW 「우와 거기, %MASTERNAME:41%... 잠시만 기다려 봐!」
			PRINTFORMW 「너... 손가락을 안에 넣으려고 하는 거야?」
			PRINTFORMW 「아니, 안 된다고 말하는 건 아니고, 그냥... 내가 좀 준비할 시간을 갖게 해 줘.」
			PRINTFORMW 「저기... 부드럽게 해 줘, 알았지?」
			PRINTFORMDW 너는 고개를 끄덕이고, 누가 움찔거리는 것을 보며 조심스럽게 손가락을 안으로 밀어 넣는다.
			PRINTFORMDW 그녀가 감각에 익숙해지도록 한 뒤, 너는 또 다른 손가락을, 그리고 그다음 손가락을...
			PRINTFORMDW %BREAKENG(@"그녀의 처녀막이 손상되지 않도록 조심스럽게 앞뒤로 움직이며, 그 안쪽의 꽉 찬 느낌과 따뜻함을 즐긴다.")%
		ELSE
			PRINTFORMW 「음~ 하아... 가끔 전희 정도는 괜찮겠지.」
			PRINTFORMW 「응, 난 괜찮아. 그냥... 다른 건 몰라 네 거 안에 있는 게 더 좋은 것 같아, 정말로♪」
			PRINTFORMW 「뭐 어쨌든... 누에님의 특별한 곳의 낯선 감각을 꼭 기억해줘, 쿠쿠!」
		ENDIF
		PRINTFORMDW %BREAKENG(@"뻔뻔한 외모에도 불구하고 누에의 보지는 따뜻하고 매혹적이었고, 네 손가락 위를 부드럽게 조이며 엄청나게 침을 흘렸다...")%
		RETURN 1
	ENDIF
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「아하앙...! 이 지경에 네 손가락 같은 시시한 걸로 내 가려운 곳을 긁어줄 수 있을 거라고 생각 안 해...!」
		PRINTFORMW 「정말 내 안에 들어오길 원해, 알잖아... 너의 그거 말이야... %MOAN()%!」
		RETURN 1
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「%MOAN()%... 음음! 오-오, 그럭저럭 괜찮네...」
		CALL PRINT_DIALOGUE, @"그냥 조심해줘서 나를 긁지 않도록 해... 이 보지가 너랑 이것 말고 더 많은 장난을 치길 원하니까, 알잖아♪", "w"
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「%MOAN(,,3)%... %GROAN()%! %FSYN("hii")%!」
		PRINTFORMW 「이건 여전히 나한테 좀 이상하고 좀 역겨워... 이 모든 더러운 소리들 때문에...」
		PRINTFORMW 「이게 정말 나라고...? 언제 이렇게 음란해진 거지... %MOAN("m")%!」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
