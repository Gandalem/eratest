@M_KOJO_MESSAGE_COM_K41_405
;デートにTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K41_405_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K41_405_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:同行
		IF TALENT:恋人
			PRINTFORMW 「후훗, 어디로 데려가 줄 거예요?」
			PRINTFORMW 「어쨌든, 당신과 함께라면 어디든 행복할 것 같아요...」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「뭐야-- 데이트라니...?」
			PRINTFORMW 「아냐, 그러니까... 딱히... 상관없다고...」
		ELSE
			PRINTFORMW 「음? 나랑 데이트하고 싶어?」
			PRINTFORMW 「글쎄, 지금 좀 심심해서 네 옆에 있어 줄게.」
		ENDIF
		PRINTFORML
		;(moved from event 19) use by name check, from hatate's dialogue
		SELECTCASE DATENAME_PLACE(1)
			CASE "命蓮寺" ;added
				PRINTFORML 「음, 내 절에 한번 가보는 거야?」
				PRINTFORMW 「글쎄, 아마도... 좋아. 우리를 함께 보는 그들의 표정이 벌써 기대되네!」
				PRINTFORML 「쿠쿠쿠...」
				PRINTFORMDW 누에가 이미 어떤 장난을 꾸미고 있는 것 같다.
				;人間の里
			CASE "人間の里"
				IF RAND:3 == 0 && TALENT:恋人
					PRINTFORML 「후훗! 이럴 때 우리 좀 더 친밀해져야 한다고 생각해!」
					PRINTFORMW 「우리가 얼마나 가까운지 모두에게 보여주자♪」
				ELSEIF RAND:2 == 0
					PRINTFORML 「있잖아, 나는 보통 명련사 경내에서 벗어나지 않거든.」
					PRINTFORMW 「그래서 이 마을의 지리에 대해서는 잘 몰라.」
				ELSE
					PRINTFORML 「쿠쿠, 마을은 놀릴 가치가 있는 사람들로 가득할 거야!」
					PRINTFORMW 「있잖아, 절 학교의 그 선생님이나 그 아큐우 부인 같은 사람들이 말이야.」
					;added
					PRINTFORMW 「심지어 코스즈의 작은 서점에서도!」
				ENDIF
				;博麗神社
			CASE "博麗神社"
				IF RAND:3 == 0 && TALENT:恋人
					PRINTFORML 「후후, 안전한 출산을 위해 기도라도 해볼까요?」
					PRINTFORMW 「가끔은 그 신사도 쓸모를 증명해야 한다고 생각해요.」
				ELSEIF RAND:2 == 0
					PRINTFORML 「이 신사가 요즘 꽤 잘하고 있다고 들었는데...」
					PRINTFORMW 「하지만 왜 이렇게까지 계속 거절하는지 궁금하네.」
				ELSE
					PRINTFORML 「우리가 박력 신사에 갈 거야?」
					PRINTFORMW 「하지만 나랑 거기 가면 무시당할걸, 알잖아 %MASTERNAME:41%?」
					PRINTFORMW 「차라리 그녀의 적 중 하나가 되는 편이 낫겠어...」
				ENDIF
				;迷いの竹林
			CASE "迷いの竹林"
				IF RAND:3 == 0 && TALENT:恋人
					PRINTFORML 「대나무 숲에서의 데이트라니 꽤 고풍스럽지 않나요?」
					PRINTFORMW 「솔직히 당신은 취향이 아주 좋네요, %MASTERNAME:41%!」
				ELSEIF RAND:3 == 0 ;added
					PRINTFORML 「거기에 길을 잃으면 항상 돌아가도록 도와주는 아주 이상한 인간이 산다고 들었어.」
					PRINTFORMW 「그녀는 영원히 그곳에 있었고, 이 모든 시간 동안 조금도 늙지 않았어.」
					PRINTFORMW 「...유령일지도 몰라?! 나-나는 안 무서워, 그냥... 나 없이 도망가지 마, 알았지?」
				ELSEIF RAND:2 == 0
					PRINTFORML 「우리가 길을 잃으면 여기서 나가기가 그렇게 쉽지 않을 거야.」
					PRINTFORMW 「...무슨 일이 있어도 나를 뒤에 두고 가지 마, 알았지?」
