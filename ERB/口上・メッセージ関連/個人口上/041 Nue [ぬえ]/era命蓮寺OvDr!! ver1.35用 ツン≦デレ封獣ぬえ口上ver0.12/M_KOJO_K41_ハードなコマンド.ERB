@M_KOJO_MESSAGE_COM_K41_104
CALL M_KOJO_MESSAGE_COM_K41_104_1
RETURN RESULT

@M_KOJO_EXTRASOURCE_COM_K41_104
SOURCE:反感 = 0 ;added
SOURCE:恐怖 = 0 ;added

@M_KOJO_MESSAGE_COM_K41_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		;moved from buying stuff
		PRINTFORMW 「음? 그게 뭐지? 내가 요즘 잠자리에 어려움을 겪었다고 생각하나?」
		SIF TALENT:恋人
			PRINTFORMW 「네가 원한다면 매일 너와 함께 잠들 수 있어!」
		;解除
	ELSE
		PRINTFORMDW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
