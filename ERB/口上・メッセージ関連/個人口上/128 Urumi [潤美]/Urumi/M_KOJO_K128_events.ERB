	PRINTDL 무언가를 입력해야 한다.
	GOTO INPUT_LOOP_ONAMAE
ELSE
	PRINTFORML 이름은 %RESULTS%로 설정될 예정인데, 확인하시겠습니까?
	CALL ASK_YN
	IF RESULT == 0
		;あなたの名前を%MASTERNAME:64%に格納
		MASTERNAME:128 = %RESULTS%
		PRINTFORML 
	ELSE
		PRINTDL 이름을 입력하세요.
		GOTO INPUT_LOOP_ONAMAE
	ENDIF
ENDIF
