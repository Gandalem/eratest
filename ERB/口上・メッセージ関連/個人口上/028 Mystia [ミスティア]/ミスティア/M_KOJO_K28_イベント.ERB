@M_KOJO_EVENT_K28_13(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;仕事開始（職場へ移動する）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;恋慕
		IF TALENT:恋慕
			PRINTFORML 「음, 이제 그 시간이 된 것 같네. 일하러 갈게.」
			PRINTFORML 「왜 그렇게 쓸쓸한 표정이야? 내 직장 언제든지 들러도 돼, 알았지?」
			;恋慕で無い
		ELSE
			PRINTFORML 「자, 이제 내 음식 카트를 열러 가야지♪」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			IF RAND:2
				PRINTFORML 「아아, 드디어 오셨군요♪ 기뻐요%UNICODE(0x2665)%」
				PRINTFORML 「그저 소박한 음식 노점일 뿐이지만 편하게 계세요♪」
			ELSE
				PRINTFORML 「어서 와, 어서. 이렇게 들른 건 네가 결심했구나%UNICODE(0x2665)%」
				PRINTFORML 「혹시 나한테 애정을 받고 싶어서 온 거야? 아니면 정말로 나를 도와주러 온 거야?」
			ENDIF
		ELSEIF TALENT:恋慕
			IF RAND:2
				PRINTFORML 「좋은 저녁이에요♪ 딱 맞춰 오셨네요, 곧 그릴을 달궈볼 거예요%UNICODE(0x2665)%」
				PRINTFORML 「최선을 다할게요, %CALLNAME:MASTER%♪」
				PRINTFORML 「아하, 하지만 여기 와서 도와주신다면 제 최선보다 더 잘 해드릴 수 있어요%UNICODE(0x2665)%」
			ELSE
				PRINTFORML 「%CALLNAME:MASTER%♪ 왔구나~, 술 한 잔 하겠니?」
				PRINTFORML 「아니면 용돈을 좀 벌 필요가 있니? 지금 정말 바쁘거든~」
			ENDIF
		ELSE
			IF RAND:2
				PRINTFORML 「밤눈 어두워지는 건 비타민 A로 물리쳐야 해~♪ 매일 장어 한 마리씩 먹으면 비타민 A가 채워진단다～♪」
				PRINTFORML 「아아, %CALLNAME:MASTER%, 나는 \@ IS_MALE(MASTER) ? 남자 점원 # 여자 점원을 필요로 해... 이 일을 맡을 자신 있어?」\@
			ELSE
				PRINTFORML 「오, 좋은 저녁입니다♪ 식사하실 것 주문하시겠어요?」
				PRINTFORML 「아, 지금 인력이 좀 부족해서 파트타임으로 일해 주신다면 제가 돈을 드릴게요.」
			ENDIF
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;
	;ミスティアの屋台業の場合、手伝ったからと言って早く終わる類のものではないと思われる
	;手伝ったからといって客が捌けたというのもなんだかさびしいし、どう解釈しようか……うむむ
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;定時より早く終わった
		IF TIME:0 > (60 * 16) && TIME:0 < (60 * 24)
			PRINTFORML 「세상에, 어떻게 재료가 다 떨어졌지... 심지어 여유 있게 비축까지 해뒀는데...」
			PRINTFORML 「%CALLNAME:MASTER%♪ 덕분이야.」
			PRINTFORML 「오늘은 이익을 많이 남겼으니 음식 주문은 받지 않고 술을 서비스로 제공하자!」
		ELSEIF RAND:2
			PRINTFORML 「휴~, 녹초가 됐어! 오늘은 가게 문을 닫는다! 수고했고, 고생 많았어!」
		ELSE
			PRINTFORML 「음, 퇴근 시간이야. 오늘 열심히 일했어!」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;食事系
;==================================================

@M_KOJO_EVENT_K28_14(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;持っていた食物を食べられた
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;IF TALENT:恋人 ;custom code, why empty wtf
		IF TALENT:恋慕
			IF RAND:3 == 0
				PRINTFORML 「음, 맛있는 냄새가 나네... 이건 %조사처리(CALLNAME:MASTER,"가")% 요리한 거구나♪」
				PRINTFORML 「먹어도 괜찮을까? 창피할까?」
				PRINTFORML 「걱정 마, 네가 만든 건데, %CALLNAME:MASTER%, 분명 맛있겠어.」
				PRINTFORML 「그럼 더 이상 망설이지 않고 먹어야겠다... 냠, 아삭... 음, 정말 맛있다!」
			ELSEIF RAND:2
				PRINTFORML 「아, 정말 좋은 냄새가 나네... 한 입이라도 맛보게 해줄까...」
				PRINTFORML 「강요하려는 건 아닌데, 요리 실력을 향상시키는 가장 좋은 방법은 다른 사람이 당신의 요리를 맛보게 하는 거야...」
				PRINTFORML 「게다가 요리는 단순히 맛에 관한 것만이 아니라 즐거움도 포함하는 거잖아♪ 음~」
				PRINTFORML 「냠... 씹... (꿀꺽)... 꽤 괜찮았어, 내 생각엔...」
			ELSE
				PRINTFORML 「음~ 음, 맛있어 보이는 음식들이 있네♪」
				PRINTFORML 「자신이 없으신가? 걱정 마. 이런 것들은 맛뿐만 아니라 재미도 중요하거든.」
				PRINTFORML 「그럼 한두 입 먹어봐야겠군... 냠, 씹어...」
				PRINTFORML 「응, 재미있는 풍미가 있네... 아니, 맛있다고 해야 하나~」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「네가 들고 있는 그 요리 되게 맛있어 보이는데, %조사처리(CALLNAME:MASTER,"가")% 만든 거야?」
				PRINTFORML 「부끄러워하지 말고, 나도 맛 좀 보게 해줘... 알겠지?」
				PRINTFORML 「걱정 마, 요리의 비결은 얼마나 숙련되었느냐가 아니라 즐기는 데 있어... 음!」
				PRINTFORML 「아삭아삭... 꿀꺽. 음, 이 맛은 부끄러워할 게 아니야.」
			ELSEIF RAND:2
				PRINTFORML 「오, %CALLNAME:MASTER%... 무언가 요리한 것 같네♪」
				PRINTFORML 「기다려 봐, 나도 좀 맛보게 해줘... 부끄러워하지 마♪」
				PRINTFORML 「모두 초심자에서 시작하는 거야～ 다른 사람들에게 네 요리를 시켜보고 피드백을 받는 게 가장 좋아.」
				PRINTFORML 「오물 오물... 음, 정말 맛있네!」
			ELSE
				PRINTFORML 「주변에 음식 냄새가 나네... 내 코 속이는 건 못 하잖아～」
				PRINTFORML 「아, 역시! 뭐 요리했지, 그렇지 %CALLNAME:MASTER%?」
				PRINTFORML 「음, 안에 닭고기는 안 보이는데... 좋아, 좀 먹어보자...」
				PRINTFORML 「아삭아삭... 응, 나쁘지 않네.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
