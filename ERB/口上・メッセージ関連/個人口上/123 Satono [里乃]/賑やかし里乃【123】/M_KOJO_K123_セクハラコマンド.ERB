LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「후훗 %UNICODE(0x2764)% 따뜻해서, 행복한 기분이 들 수 있네~ %UNICODE(0x2764)%」
					PRINTFORMW 사토노는 %조사처리(CALLNAME:MASTER,"의")% 품에 부비며 애정을 나눈다.
				CASE 1
					PRINTFORML 「꽉~ %UNICODE(0x2764)% 우후후, %CALLNAME:MASTER%도 더 안아줘? %UNICODE(0x2764)%」
					PRINTFORMW 사토노는 행복해 보이며, %조사처리(CALLNAME:MASTER,"에게")% 기대고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「이렇게 하고 있자, 뭔가 안심이 될지도 몰라♪」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 안겨서, 사토노는 빙긋 웃었다.
				CASE 1
					PRINTFORML 「마이와도 자주 이렇게 하는 거야~♪」
					PRINTFORMW %CALLNAME:MASTER%하고 포옹을 나누며, 사토노는 기분 좋게 웃었다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
