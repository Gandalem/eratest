;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K123_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K123_310
CALL M_KOJO_MESSAGE_COM_K123_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF TALENT:狂気
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「윽! 만지지 마!」
					PRINTFORMW 사토노는 탁 소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다.
					;恥ずかしがる
				CASE 2,3
					PRINTFORML 「응… 이제 그만해줘 %UNICODE(0x2764)%」
					PRINTFORMW 그렇게 말하며, 사토노는 익숙한 듯 %조사처리(CALLNAME:MASTER,"의")% 손에서 벗어났다.
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「당신도 그 동네 변태 할아버지랑 똑같네요?」
							PRINTFORMW 사토노는 어이없다는 듯 웃으며 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
						CASE 1
							PRINTFORML 「모두, 이 정도에서 끝내줄 수 있다면 좋겠는데 말이야~」
							PRINTFORMW 사토노는 싫은 기억을 떠올리며 건조한 웃음소리를 냈다.
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「꺅!? 이제 그만해라고 했잖아!」
					PRINTFORML 「그 이상 하면, 경찰에 신고할 거야~?」
					PRINTFORMW 사토노는 뚱한 표정으로 %조사처리(CALLNAME:MASTER,"에게")% 항의하고 있다.
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「엉덩이 같은 걸 만지는 게, 즐거운 거야……?」
							PRINTFORMW 사토노는 부끄러워하며 %조사처리(CALLNAME:MASTER,"의")% 손으로부터 벗어나려 한다.
						CASEELSE
							PRINTFORML 「뭐 생각하고 있는 거야아……」
							PRINTFORMW 사토노는 부끄러워하며, %조사처리(CALLNAME:MASTER,"의")% 손으로부터 벗어나려고 한다.
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「%CALLNAME:MASTER%에게만은, 용서해 줄게」
						CASEELSE
							PRINTFORML 「정말, 그렇게 내 엉덩이를 좋아하는 거야?」
							PRINTFORMW 「어쩔 수 없지, 더 만져보게 해 줄게♪」
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「싫어! 만지지 마아!」
					PRINTFORMW 사토노는 화끈하게 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다.
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「싫어, 이제...」
							PRINTFORMW 사토노는 불편한 듯 몸을 뒤척인다.
						CASEELSE
							PRINTFORMW 「손길이 너무 역겨운데……」
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「속셈이 완전히 드러나 있네~」
							PRINTFORMW 사토노는 꼼짝 않고 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
						CASEELSE
							PRINTFORMW 「자, 이제 충분히 만졌잖아~?」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
