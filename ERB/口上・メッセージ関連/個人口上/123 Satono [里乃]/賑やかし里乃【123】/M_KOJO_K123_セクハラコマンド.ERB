			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「쪽...」
					PRINTFORMW 「후훗, 이 이상은 안 돼~?」
				CASE 1
					PRINTFORML 「츄릅... 쩝...」
