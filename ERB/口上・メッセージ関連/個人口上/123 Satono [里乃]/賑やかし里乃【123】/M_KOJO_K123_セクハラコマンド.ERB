;330,スカートめくり
;TFLAG:193(-5=拒絶（ビンタ） -3=拒絶（つねり） -1=いやがる 0=いやがる（嬉しげ） 1=受け入れ)
;TFLAG:193=1&&ABL:露出癖(5以上=人目のある場所で、自らスカートをまくり上げる 4以下=人目のある場所でめくられるさいに弱い抵抗 3以上=人目のない場所で自らスカートをまくり上げる 3未満=弱い抵抗)
;TFLAG:400(1=デート先or地底のモブが反応する)
;後ろからピラリ、ではなく、前からペラって感じ（そうじゃなかったら、めくり上げようとするのを止めて即座にビンタとか無理、めくり上げられた後にしかならないしその状況ならビンタ食らうより普通に弾幕で一発ＫＯにならないほうがおかしい
;==================================================

@M_KOJO_MESSAGE_COM_K123_330
CALL M_KOJO_MESSAGE_COM_K123_330_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSE
		SELECTCASE TFLAG:193
			;ビンタ
			CASE -5
				PRINTFORML 「꺅!? 에, 변태!」
				PRINTFORMW 치마를 들춰진 사토노는 %조사처리(CALLNAME:MASTER,"에게")% 힘껏 뺨을 때렸다.
				;つねられる
			CASE -3
				PRINTFORML 「어라? 이 손은 어떻게 된 걸까?%UNICODE(0x2764)%」
				PRINTFORMW 사토노는 방긋 웃으며, 꽉%CALLNAME:MASTER%손을 꼬집었다.
				;嫌がる
			CASE -1
				IF TALENT:狂気
					PRINTFORML 「………………」
					PRINTFORMW 사토노는 차가운 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「기분 나쁘네……」
							PRINTFORMW 사토노는 진심으로 경멸하는 듯 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
						CASEELSE
							PRINTFORML 「야, 하지 마! 치안!」
							PRINTFORMW 치마를 움켜쥔 사토노는 얼굴을 새빨갛게 물리고 항의하고 있다.
					ENDSELECT
				ENDIF
				;嫌がる（嬉しげ）
			CASE 0
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「치마 들추기, 반대!」
						PRINTFORMW 사토노는 약간 웃으며 항의했다.
					CASEELSE
						PRINTFORML 「흥, %CALLNAME:MASTER%하면, 로리콘이잖아-」
						PRINTFORMW 사토노는 치마를 누르며 살짝 웃으며 항의했다.
				ENDSELECT
				;成功
			CASE 1
				IF GET_TARGETNUM() == 1 && !DATE_HITOGOMI(CFLAG:PLAYER:現在位置) && !WITH_MOB()
					IF ABL:露出癖 > 3
						PRINTFORML 「……그렇게 보고 싶다면, 어서요?」
						PRINTFORMW 사토노는 살짝 홍조를 띠며 도발하는 듯한 미소를 지으며 자신의 치마를 들었다.
					ELSE
						PRINTFORML 「자, 자꾸 쳐다보지 마-」
						PRINTFORMW 사토노는 부끄러운 듯 볼을 붉히며 불편한 듯 몸을 움츠리고 있다.
					ENDIF
				ELSE
					IF ABL:露出癖 > 5
						PRINTFORML 「……그렇게 보고 싶다면, 어서요?」
						PRINTFORMW 사토노는 살짝 홍조를 띠며 도발하는 듯한 미소를 지으며 자신의 치마를 들었다.
					ELSE
						PRINTFORML 「자, 자꾸 쳐다보지 마-」
						PRINTFORMW 사토노는 부끄러운 듯 볼을 붉히며 불편한 듯 몸을 움츠리고 있다.
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
