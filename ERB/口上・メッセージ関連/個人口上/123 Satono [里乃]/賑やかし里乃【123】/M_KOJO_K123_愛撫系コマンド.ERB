RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_19_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:狂気
		IF TALENT:恋人
			PRINTFORML 「음, 쪽......」 %UNICODE(0x2764)%
			PRINTFORMW 사토노는 뺨을 물들이고 황홀한 표정으로 %조사처리(CALLNAME:MASTER,"와")% 입맞추고 있다.
		ELSE
			PRINTFORML 「음……」
			PRINTFORMW 「푸하……」
		ENDIF
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「츄......츄우...읏%UNICODE(0x2764)%」
				PRINTFORMW 「푸하아%UNICODE(0x2764)% 후후, 더 해버릴까?%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「음, 쪽......」 %UNICODE(0x2764)%
				PRINTFORMW 사토노는 뺨을 물들이고 황홀한 표정으로 %조사처리(CALLNAME:MASTER,"와")% 입맞추고 있다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「쪽...」
				PRINTFORMW 「후훗, 이 이상은 안 돼~?」
			CASE 1
				PRINTFORML 「츄릅... 쩝...」
				PRINTFORML 「.........푸하. 후후후, 뭔가 어른이 된 기분이네?」
				PRINTFORMW 입술을 떼자, 부끄러워하는 미소를 짓는 사토노가 눈에 들어왔다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
