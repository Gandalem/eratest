@M_KOJO_MESSAGE_COM_K123_11
CALL M_KOJO_MESSAGE_COM_K123_11_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_11_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:狂気
		IF TALENT:恋人
			PRINTFORML 「후훗 %UNICODE(0x2764)% %CALLNAME:MASTER%, 아기 같아서 귀여워~ %UNICODE(0x2764)%」
			PRINTFORMW 사토노는 모성애를 자극받았는지, 상냥하게 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬기 시작했다.
		ELSE
			PRINTFORML 「…………하아」
			PRINTFORMW 사토노는 어딘가 먼 곳을 응시한 채, 한숨을 내쉬었다.
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORML 「후훗 %UNICODE(0x2764)% %CALLNAME:MASTER%, 아기 같아서 귀여워~ %UNICODE(0x2764)%」
		PRINTFORMW 사토노는 모성애를 자극받았는지, 상냥하게 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬기 시작했다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「쪽쪽 빨아줘, 아기 같네♪」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 모습을 보고 사토노는 쿠스쿠스 웃고 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
