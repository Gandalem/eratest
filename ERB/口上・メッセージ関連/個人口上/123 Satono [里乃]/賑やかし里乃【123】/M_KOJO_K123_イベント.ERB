@M_KOJO_SPEVENT_K123_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML 「오늘 외출, 즐거웠어~♪」
		PRINTFORMW 사토노는 옆에서 걷고 있던 %조사처리(CALLNAME:MASTER,"에게")% 환하고 가련한 미소를 보여준다.
		PRINTFORML 
		PRINTFORML 「후훗, 정말 멋진 데이트였으니까…… 특별히 지금 여기에서만 할 이야기를 해볼까?」
		PRINTFORMW 딱, 하고 걸음을 멈춘 사토노는 진지한 표정으로 똑바로 %조사처리(CALLNAME:MASTER,"의")% 눈을 바라본다.
		PRINTFORMW 마찬가지로 발걸음을 멈춘 %조사처리(CALLNAME:MASTER,"는")% 그녀의 그 모습에 약간의 긴장감을 느꼈다.
		PRINTFORML 
		PRINTFORML 「사실은……」
		PRINTFORMW 「나, %조사처리(CALLNAME:MASTER,"를")% 좋아해」
		PRINTFORML 
		PRINTFORML 「……후훗, 놀랐어? 정말이야~? 거짓말 아니야♪」
		IF TALENT:狂気
			PRINTFORMW 사토노는 입가에 손을 대고 즐거운 듯 쿠스쿠스와 웃는다.
			PRINTFORML 
			PRINTFORMW 하지만, 이윽고 그 표정은 사라지고, %조사처리(CALLNAME:MASTER,"에게")% 일절 감정이 없는 얼굴이 향했다.
			PRINTFORMW 「그리고, 한 가지 더 말해두고 싶은 게 있어. 나의 "일"에 대해서 말이야.」
			PRINTFORML 「………나는 마타라 신을 위해 매춘을 하며 사람들에게 신앙을 받고 있어.」
			PRINTFORMW 「나는 벌써 완전히 더러워졌어. 육체도, 정신도……」
			PRINTFORML 
			PRINTFORMW 「이걸 바탕으로, 당신에게 묻고 싶은 게 있는데…」
			PRINTFORMW 「내 연인이 되어주지 않을래…? 」
			PRINTFORML 
		ELSE
			PRINTFORMW 「그러니까, 나의 연인이 되어주지 않을래~?」
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:狂気
			PRINTFORML 
			PRINTFORML 「고마워. 정말 기뻐……」
			PRINTFORMW 사토노는 얼굴을 환하게 피우며 행복한 듯 유카리의 눈을 가늘게 뜨었다.
			PRINTFORML 
			PRINTFORML 「그럼, 오늘부터 우리는 연인이야.」
			PRINTFORMW 「……앞으로 잘 부탁해. %CALLNAME:MASTER%%UNICODE(0x2764)%」
			PRINTFORML 
			PRINTFORML 볼이 홍조로 물든 사토노는 자신의 손가락을 %조사처리(CALLNAME:MASTER,"의")% 손가락에 살며 얽어 잡는다.
			PRINTFORMW 손바닥에서 전해지는 그녀의 체온은 잊을 수 없을 만큼 부드럽고 따뜻한 것이었다.
		ELSE
			PRINTFORML 「후훗, 고마워. 정말 기뻐♪」
			PRINTFORMW 사토노는 얼굴을 환하게 피우며 행복하게 유카리의 눈을 가늘게 떴다.
			PRINTFORML 
			PRINTFORML 「그럼 오늘부터 우리는 연인 사이네!」
			PRINTFORMW 「앞으로 잘 부탁해. %CALLNAME:MASTER%%UNICODE(0x2764)%」
			PRINTFORML 
			PRINTFORML 볼이 홍조로 물든 사토노는 자신의 손가락을 %조사처리(CALLNAME:MASTER,"의")% 손가락에 살며 얽어 잡는다.
			PRINTFORMW 손바닥에서 전해지는 그녀의 체온은 잊을 수 없을 만큼 부드럽고 따뜻한 것이었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:狂気
			PRINTFORML 
			PRINTFORMW 「……그렇겠지. 내가 당신의 입장이라도 분명 거절할 거야.」
			PRINTFORML 
			PRINTFORML 「……미안해, 이상한 이야기 해버려서」
			PRINTFORML 「그럼, 돌아갈까……」
			PRINTFORMW 사토노는 슬픈 듯 눈을 내리깔고 걸음을 옮긴다.
			PRINTFORML 
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 죄책감을 느끼면서도, 조용히 그녀를 뒤따랐다...
			PRINTFORML 
		ELSE
			PRINTFORML 「………그렇구나」
			PRINTFORML 「하아, 아쉽네. 될 줄 알았는데……」
			PRINTFORMW 사토노는 순간 슬픈 표정을 보였지만, 그 얼굴도 금세 평소의 미소로 돌아왔다.
			PRINTFORML 
			PRINTFORMW 「그럼, 돌아갈까~♪」
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
