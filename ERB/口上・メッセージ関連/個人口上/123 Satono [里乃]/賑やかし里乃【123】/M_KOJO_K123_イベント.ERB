@M_KOJO_EVENT_K123_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:狂気
			PRINTFORML 「……아, %CALLNAME:MASTER%. 잘 지냈어?」
			PRINTFORMW 허공을 응시하고 있던 사토노의 눈에 빛이 돌아왔다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「아, %CALLNAME:MASTER%. 좋은 하루야~♪」
			PRINTFORMW 사토노는 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들고, 싱글벙글 웃으며 다가왔다.
		ELSE
			PRINTFORML 「아, %조사처리(CALLNAME:MASTER,"가")% 있네~」
			PRINTFORMW 사토노는 %조사처리(CALLNAME:MASTER,"를")% 발견하자 인사 삼아 손에 들고 있던 미나리(茗荷)를 가볍게 흔들었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%ー♪」
			PRINTFORML 등 뒤에서 누군가 갑자기 말을 걸었다.
			PRINTFORMW 「후후, 놀라게 했어? 안녕, 사토노야~%UNICODE(0x2764)%」
		ELSE
			PRINTFORML 「실례하겠습니다 %UNICODE(0x2764)%」
			PRINTFORMW 등 뒤의 문에서 갑자기 사토노가 나타났다…….
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
