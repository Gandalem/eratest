@M_KOJO_MESSAGE_COM_K123_80
CALL M_KOJO_MESSAGE_COM_K123_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:狂気
			PRINTFORML 「……응, 응하겠어요……………」
			PRINTFORMW 사토노는 어떤 감정도 없이 기계적으로 %조사처리(CALLNAME:MASTER,"에게")% 봉사하고 있다…….
		ELSE
			PRINTFORML 「정말 뜨겁네, %조사처리(CALLNAME:MASTER,"의")%……」
			PRINTFORMW 사토노는 손안에서 느껴지는 맥동에 부끄러워 볼을 붉히고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF TALENT:狂気
			PRINTFORML 「………………」
			PRINTFORMW 사토노는 기계적인 봉사를 계속하고 있다…….
		ELSE
			PRINTFORML 「후훗, 어때? 잘하고 있나~?」
			PRINTFORMW 사토노는 도발적인 미소를 지으며 열성적으로 위아래로 손을 움직이고 있다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
