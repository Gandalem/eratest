;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K123_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K123_302
CALL M_KOJO_MESSAGE_COM_K123_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:狂気
		IF TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「왜 그래, %CALLNAME:MASTER%. 흥분해 버렸어...? %UNICODE(0x2764)%」
					PRINTFORMW 사토노는 %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 자신의 가슴에 만지게 했다...
				CASE 1
					PRINTFORML 「......헤에.........」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 손길에, 사토노가 히죽 웃으며 입가를 일그러뜨렸다…….
				CASE 2
					PRINTFORML 「음? 나는 괜찮으니까 신경 쓰지 마 %UNICODE(0x2764)%」
					PRINTFORMW 사토노는 %CALLNAME:MASTER%에 자신의 가슴을 밀어붙였다…….
				CASE 3
					PRINTFORML 「이제, 역겨운 손길이군...」
					PRINTFORMW 사토노는 의미심장한 미소를 지으며 %조사처리(CALLNAME:MASTER,"의")% 손을 바라보고 있다.
				CASE 4
					PRINTFORML 「후후후, %조사처리(CALLNAME:MASTER,"는")%… 변태 씨네? %UNICODE(0x2764)%」
					PRINTFORMW 사토노는 입가에 미소를 띠고, %조사처리(CALLNAME:MASTER,"의")% 손을 받아들이고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「더 이상은, 만지지 말아줘...」
					PRINTFORMW 사토노는 %조사처리(CALLNAME:MASTER,"의")% 손을 가볍게 제지했다.
				CASE 1
					PRINTFORML 「헤에」
					PRINTFORMW 사토노는 %조사처리(CALLNAME:MASTER,"의")% 손을 차가운 눈으로 바라보고 있다.
				CASE 2
					PRINTFORML 「그렇게 만지는 게 그렇게 재미있어~?」
					PRINTFORMW 사토노는 희미하게 미소를 짓고 있다.
				CASE 3
					PRINTFORML 「본방 없으면? 그럼 만져도 돼~」
					PRINTFORMW 사토노는 의미심장한 미소를 지으며, %조사처리(CALLNAME:MASTER,"의")% 손을 바라보고 있다.
				CASE 4
					PRINTFORML 「하아……%조사처리(CALLNAME:MASTER,"의")% 변태~」
					PRINTFORMW 사토노는 애써 웃으며 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:5
