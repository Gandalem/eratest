@M_KOJO_SUCCESS_COM_K123_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K123_301
CALL M_KOJO_MESSAGE_COM_K123_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K123_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == 1
		IF TALENT:恋慕
			PRINTFORML 「후훗! 고마워, %CALLNAME:MASTER%%UNICODE(0x2764)%」
			PRINTFORML 「즈즈즈……푸하아! 당신이 내려준 덕분일까? 정말 맛있다♪」
			PRINTFORMW 사토노는 기분이 좋아 보이며 차를 마시고 있다.
		ELSE
			PRINTFORML 「아, 고치예요 %UNICODE(0x2764)%」 
			PRINTFORMW 「즈즈즈……헤에, 맛있잖아. 차 잎은 어디서 산 거예요?」
		ENDIF
	ELSEIF TFLAG:193 == 0
		IF TALENT:恋慕
			PRINTFORML 「후훗! 차 고마워, %CALLNAME:MASTER%%UNICODE(0x2764)%」
			PRINTFORML 「꿀꺽……푸하아! 꽤 맛있다네~」
			PRINTFORMW 사토노는 잘 먹었다고 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다.
		ELSE
			PRINTFORML 「아, 고치예요%UNICODE(0x2764)%」 
			PRINTFORML 「즈즈즈……푸하. 왠지 안심이 되는걸~」
			PRINTFORMW 사토노는 차를 마시며 한숨을 돌렸다…….
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「후훗! 차 고마워, %CALLNAME:MASTER%%UNICODE(0x2764)%」
			PRINTFORML 「즈즈즈……………잘 먹었습니다……」
			PRINTFORMW 쓰기 힘들었을까. 찻잔에서 입술을 뗀 사토노는 살짝 얼굴이 일그러져 있다….
		ELSE
			PRINTFORML 「아라, 고마워~」
			PRINTFORML 「우에엣... 이거 좀 너무 괴로운데...」
			PRINTFORMW 사토노는 시무룩한 표정을 짓고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
