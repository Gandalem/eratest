		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「아~하아. 어차피 놀 거라면, %TEXTR("ピース/純狐")%랑 함께였으면 좋았을 텐데」
		PRINTFORMDW 헤카티아가 한숨 섞인 목소리로 중얼거렸다……
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「……그래도 당신, 잘 돌아왔네읏」
		PRINTFORML 「저기서 죽는 게 나았을지도 모르는데……」
		PRINTFORMDW 헤카티아의 표정에는 예전 같은 미소가 없었고, 매우 차갑다…….
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
