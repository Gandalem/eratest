@KOJO_SF_CONTRACT_EVENT_K113(ARGS)
SELECTCASE ARGS
	CASE "導入"
		IF TALENT:111:恋人 || TALENT:112:恋人
			PRINTFORMW 「……그렇게 멋진 연인이 있는데, 당당하게 바람을 선언하다니 말이야……?」
		ELSE
			PRINTFORMW 「……지옥의 여신인 나를, 섹스 파트너로 하고 싶다고?」
		ENDIF
	CASE "補正"
		;PRINTFORML （サクッとヤりたいなあ）
		;RETURN -1000
	CASE "成功"
		IF TALENT:111:恋人 || TALENT:112:恋人
			PRINTFORML (거절해야 하는 걸까……)
			CALL HPH_PRINT,@"「비밀스러운 관계라는 것도 나쁘지 않네…… HPH」","L"
			PRINTFORMDW 헤카티아는 요염한 미소를 지으며, %조사처리(CALLNAME:MASTER,"의")% 가랑이를 문질러 왔다...!
		ELSE
			PRINTFORML 「원래라면 영혼까지 부서질 정도의 고통을 주고 싶지만……」
			CALL HPH_PRINT,@"「당신이랑이라면, 몸만 엮이는 관계도 나쁘지 않을지도 모르겠네 HPH」","L"
			PRINTFORMDW 헤카티아로부터 승낙을 얻었어...!
		ENDIF
	CASE "失敗"
		IF TALENT:111:恋人 || TALENT:112:恋人
			PRINTFORML 「어때? 마음을 바꿀 생각은 들었어?」
			PRINTFORML 「…좋아 좋아♪ 그럼 아까 했던 말들은 못 들은 걸로 해줄게」
		ELSE
			PRINTFORML 「정말, 나도 만만하게 봤던 거였나 봐…….」
		ENDIF
		PRINTFORMDW 헤카티아에게서 얻은 것은 승낙이 아니라 벌이었다…….
ENDSELECT
