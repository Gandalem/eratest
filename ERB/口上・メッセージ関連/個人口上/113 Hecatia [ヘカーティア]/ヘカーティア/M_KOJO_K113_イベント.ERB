@M_KOJO_SPEVENT_K113_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML 
		;初回
		IF FIRSTTIME("告白")
			PRINTFORML 「결심했어, %조사처리(CALLNAME:MASTER,"는")%」
			PRINTFORMDW 데이트를 마치고 돌아오는 길. 문득 헤카티아가 이쪽을 응시하며 그렇게 말했다.
			PRINTFORML 「당신을, 지옥의 여신인 나의 반려로 만들 거예요」
			PRINTFORMW 「말해두지만, 이건 농담이 아니야. 나는 진심이야」
			PRINTFORMDW 평소와 달리 진지한 표정의 그녀에게, %조사처리(CALLNAME:MASTER,"는")%……
			;二回目以降
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%. 그 후로 마음은 변했으려나?」
			PRINTFORML 「후후후…… 모르는 척해도♪ 당신도 사실 알고 있잖아요?」
			PRINTFORMDW 헤카티아는 아직 %조사처리(CALLNAME:MASTER,"를")% 포기하지 못한 것 같다……
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「후후후……♪ 기쁘긴 하지만, 말만으로는 부족하네」
		PRINTFORMDL 그렇게 말하며, 헤카티아는 눈을 감았다.
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 서로의 숨결이 느껴질 거리에 가까이 다가가 조용히 입술을 포갰다……
		CALL HPH_PRINT,@"「응…… HPH로 이제 당신은 몸도 마음도 내 거야…… HPH」","L"
		CALL HPH_PRINT,@"「나의 지옥에 온 걸 환영해 HPH」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「……그래. 뭐 됐겠지」
		PRINTFORMW 「네가 "응"이라고 말할 때까지, 나는 포기하지 않을 거야~♪」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
