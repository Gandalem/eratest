@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K113_1
RETURN 0

@M_KOJO_MESSAGE_SCOM_K113_1
CALL M_KOJO_MESSAGE_SCOM_K113_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K113_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:時間停止 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;舌技術３以上
	ELSEIF ABL:舌 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「응으읏 하프 응읏 하프 응… 후읍 하프 철륵 하프 줄륵 하프 주보읏 하프 주보오 하프 하프」","L"
					PRINTFORMDW 헤카티아와 서로의 성기를 핥으며, 함께 절정으로 향해간다―
				CASE 1
					CALL HPH_PRINT,@"「후아앗 흐읍! 흐읍! 흐으응... 우우으윽흐흑 히끅 히끅」","L"
					PRINTFORMDW 헤카티아의 정액을 얼굴에 받으면서, %조사처리(CALLNAME:MASTER,"는")% 그녀의 구강 속으로 정액을 사정했다...!
				CASE 2
					CALL HPH_PRINT,@"「응응! 흐읍... 후으... 츄릅... 응응... 흐으... 츄릅... 응응...」","L"
					PRINTFORMDL 절정에 다다른 건지, 헤카티아가 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 가슴을 강하게 밀착해 온다.
					PRINTFORMDW 숨 쉬기 위해 산소를 마실 때마다 암컷의 체취가 코끝으로 파고들고, 가랑이가 터질 듯 부풀어 오른다―
				CASE 3
					CALL HECA_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"(야, 대단하네…… %CALLNAME:MASTER%…… ♪ 슬슬 나도 진심을 내볼까아? HPH)","L"
					CALL HPH_PRINT,@"「크으... 퍽... 흡! 후우욱으윽! 흐읍 흐읍 흐읍」","L"
					PRINTFORMDW 헤카티아의 백덤페라에 의한 강렬한 자극에, 무심코 혀를 멈추고 말았어...!
				CASE 1
					CALL HPH_PRINT,@"「후후후…… HPH 주인님보다 먼저 가면 벌이야…… HPH」","L"
					CALL HPH_PRINT,@"「아아... 함읏 흐으음흐읍! 주르륵! 응, 응응... 흐읍! 후우...! 하아... 하아...」","L"
					PRINTFORMDW 헤카티아에게 지지 않으려는 듯, %조사처리(CALLNAME:MASTER,"는")% 눈앞의 암구에 혀를 들이밀었다...!
				CASE 2
					CALL HPH_PRINT,@"「응응읏 흐읍! 츄릅! 주부우 응읏 흐으윽! 츄릅! 흐으윽!」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 헤카티아의 가랑이에 얼굴을 묻고 눈앞의 은밀한 곳을 핥아댔다.
					PRINTFORMDW %CALLNAME:MASTER%로부터 격렬한 공격을 받으면서도, 헤카티아는 페라치오를 계속하고 있다...!
				CASE 3
					CALL HECA_FELLATIO
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응읏... 흐읍... 응으응흐읍... 응응~ 흐읍 흐읍」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 사정하는 것과 동시에, 헤카티아의 비열에서 물이 뿜어져 나왔다...!
				CASE 1
					CALL HPH_PRINT,@"「응으……흐읍! 아앗, 흐읍! 벌써 갈 것 같아……흐읍」","L"
					CALL HPH_PRINT,@"「아……흐읍! 흐으윽! 쪽! 쭉쭉... 후우우... 하앗... 하앗...」","L"
					PRINTFORMDW 질 안의 경련이 강해지는 동시에, 헤카티아의 구강 성교도 격렬해져 가고――
				CASE 2
					CALL HECA_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아앗 후후후, 그 곳…… 더, 더 핥아줬으면 좋겠어…후후」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 음핵을 핥자, 헤카티아는 크게 뒤로 젖혀지며 페니스에서 입을 떼었다.
				CASE 1
					CALL HPH_PRINT,@"「응훗 흐으읍 츄릅흐으읍 츄폿흐음 응흐 흐음응흐 흐음흐」","L"
					PRINTFORMDW 첨벙첨벙 소리를 내며, 헤카티아와 성기를 핥고 또 핥았다...!
				CASE 2
					CALL HECA_FELLATIO
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
