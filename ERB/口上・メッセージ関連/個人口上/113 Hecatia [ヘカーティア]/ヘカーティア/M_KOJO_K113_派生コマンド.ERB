						CALL HPH_PRINT,@"「응응읏... HPH 아아앗 HPH 이거... 윽... HPH 보지가 떨려... 으윽 HPH」","L"
				ENDSELECT
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 바이브를 사용해 헤카티아의 질내를 범했다.
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;Ｖ感覚５以上
			IF ABL:Ｖ感覚 >= 5
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 흐으읍흐으읍%CALLNAME:MASTER%읏 흐으읍 거기이흐윽 더, 으윽흐으읍 흐으읍」","L"
					CASE 1
						CALL HPH_PRINT,@"「아앗! 흐응... 하으윽...! 갈 것 같아... 하으윽! 하으윽」","L"
					CASE 2
						CALL HPH_PRINT,@"「앙! 흐으응! 흐으응...!! 왜, 거기만 계속...! 흐으응! 흐으응」","L"
				ENDSELECT
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% G스팟을 비빌 때마다 헤카티아는 몸을 크게 뒤로 젖혔다...!
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앗, 큭, 끄히이... 손가락으로 하는 이 좋은 곳을 건드리고 있어애...!」","L"
					CASE 1
						CALL HPH_PRINT,@"「아앗 흐읍흐읍 거긴 민감하니까, 좀 더 상냥하게... 크윽!? 흐읍흐읍」","L"
					CASE 2
						CALL HPH_PRINT,@"「응읏 후우... 쿠으... 언제까지 만들 거야아... 큭, 큭」","L"
				ENDSELECT
				PRINTFORMDW 헤카티아는 이곳을 자극받는 것이 약한 모양이다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
