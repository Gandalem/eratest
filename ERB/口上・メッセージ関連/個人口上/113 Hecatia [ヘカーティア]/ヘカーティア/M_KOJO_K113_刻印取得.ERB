; Modular ERB: 個人口上/113 Hecatia [ヘカーティア]/ヘカーティア/M_KOJO_K113_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K113
RETURN 0

@M_KOJO_MESSAGE_MARKCNG_K113
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;CALL MARK_MESSAGE
;苦痛刻印
;恐怖するようなタイプとは思えないので趣向を変えてみた
IF !FLAG:70 && !CFLAG:MASTER:イタズラ
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORML 「아프다니까! 뭘 하는 거야!」
		PRINTFORMDW 헤카티아에게 꾸중을 들었다.
	ELSEIF TFLAG:苦痛刻印取得 == 2
		CALL HPH_PRINT,@"「아앗! HPH라니, 그만둬...!」","L"
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 맞고, 헤카티아는 요염한 목소리를 냈다……
	ELSEIF TFLAG:苦痛刻印取得 == 3
		CALL HPH_PRINT,@"「아앗 HPH 아히이 HPH 히기이잇 HPH」","L"
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%……더 해줘……더 해줘」","L"
		PRINTFORMDW 헤카티아 안에 있는, 나쁜 문을 열어버린 것 같다...!
		;PRINTFORMW ヘカーティアはマゾになった
		;TALENT:113:マゾ = 1
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMDL 헤카티의 신체를 마음껏 농락하는 %조사처리(CALLNAME:MASTER,"는")%.
	PRINTFORMDL 지옥을 지배하는 여신이라 할지언정, 시간을 멈추고 움직임을 봉인한다면 그저 여자에 지나지 않는다.
	PRINTFORMDW 평소 그녀에게 휘둘리던 울분을 풀기 위해, %조사처리(CALLNAME:MASTER,"는")% 두 손에 힘을 주어 가슴을 움켜쥐었다...!
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMDL 시간이 멈춘 세계 속에서, %조사처리(CALLNAME:MASTER,"는")% 한숨을 돌린다.
	PRINTFORMDL 방금 전까지 애무받았던 유두와 음핵은, 시간이 멈춰 있음에도 불구하고 터질 듯이 발기해 있다.
	PRINTFORMDL "얼마나 음란한 여신님인가" %조사처리(CALLNAME:MASTER,"는")% 아무렇지 않게 중얼거렸다.
	CALL HPH_PRINT,@"(……흡!)","L"
	PRINTFORMDW 아주 짧은 순간…… 헤카티아의 몸이 마치 절정에 이른 것처럼 파르르 떨리는 것이 보였다...!
ELSEIF TFLAG:時姦刻印取得 == 3
	CALL HPH_PRINT,@"(하아앗, 흐으윽... %CALLNAME:MASTER%같은 애한테 제멋대로 당하고 있어읏)","L"
	CALL HPH_PRINT,@"(이... 이래버릴 것 같아앗 흐으응 시간 멈춰버렸어, 몸을 움직일 수 없는 채로... 여기저기 만져지는데엣 흐으응 흐으응)","L"
	CALL HPH_PRINT,@"(아…… HPH 이거 온다 HPH 온다 HPH 큰 거――)","W"
	PRINTFORML (……뭐야? 저기...! 왜 멈춰... 어, "부탁"?!)
	CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 그거...! 입을 움직일 수 없는 거 알고 있는데... 크으윽... HPH)","W"
	PRINTFORMDL 표정은 변하지 않았지만, 아마 헤카티아는 시간이 멈춰 있다는 것을 인지하고 있을 것이다.
	PRINTFORMDL 역시 지옥의 여신이라고 말해버리고 싶지만……
	PRINTFORMDL 의식이 있어도 움직일 수 없다면, 그것은 시관을 더욱 즐기기 위한 양념에 불과하다.
	IF TALENT:恋慕 || TALENT:思慕
		PRINTFORMDW 시간이 멈춘 %조사처리(CALLNAME:MASTER,"의")% 세계에서는 주종 관계가 역전된다.
	ELSE
		PRINTFORMDW 평소에는 제멋대로 구는 여신에게, 조금 가르쳐 주도록 하지.
	ENDIF
	PRINTFORMDW 다시 시간이 움직이기 시작하고 그녀에게 처벌받을 때까지…….
ENDIF
SIF FLAG:時間停止 || CFLAG:睡眠 ;just to be safe
	RETURN 0
;快楽刻印
IF TFLAG:23 == 1
	CALL HPH_PRINT,@"「응으윽 큭흐읍...! 음음... 큭흐읍 큭흐읍」","L"
	PRINTFORMDW 절정에 달했나. 헤카티아는 몸을 파르르 떨고 있다……
ELSEIF TFLAG:23 == 2
	CALL HPH_PRINT,@"「아아아앗! 하프 하프 가버릴 것 같아 하프 가버려우우욱 하프 하프 하프」","L"
	PRINTFORMDW 헤카티아가 커다란 신음을 내며 절정에 달했다...!
ELSEIF TFLAG:23 == 3
	CALL HPH_PRINT,@"「아아앗흐읍 흐읍 흐읍」","L"
	CALL HPH_PRINT,@"「아하……HPH 좋아, %CALLNAME:MASTER%……HPH 더 격렬하게 박아줘… HPH」","L"
	PRINTFORMDW 헤카티아는 은밀한 곳에서 애액을 흘리며, 황홀한 표정으로 몸을 떨고 있다...!
ENDIF
;不埒刻印
;快楽、屈服、恭順による刻印
;LV1
IF TFLAG:24 == 11 || TFLAG:24 == 31
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「아아…… HPH응……♪ 어, 기분 좋아……. HPH 깊숙이…… HPH」","L"
		CALL HPH_PRINT,@"(벌써…… 손가락만으로는 만족할 수 없어…… HPH)","W"
	ELSE
		PRINTFORML 「…………♪」
		PRINTFORMDL 헤카티아가 티셔츠의 옷깃을 아래로 내리고 있다. 조금만 더 하면 유두가 보일 듯하다….
		PRINTFORMDL 악의적인 미소를 짓는 그녀를 보고 의도를 파악한 %조사처리(CALLNAME:MASTER,"는")%, 시선을 돌려 보지 않기로 결정했다….
		CALL HPH_PRINT,@"(응, 벌써…… %CALLNAME:MASTER%란 애는 필사적으로 눈을 피하고 있잖아…… 귀엽단 말이야 HPH)","W"
		PRINTFORMW (다음엔 무슨 걸 해 괴롭혀 볼까나아……♪)
	ENDIF
	;LV2
ELSEIF TFLAG:24 == 12 || TFLAG:24 == 32
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「하아…… HPH 하아... HPH…… %CALLNAME:MASTER%...!」","L"
		CALL HPH_PRINT,@"「더 격렬하게…… 해줘…… 후후」","L"
		PRINTFORMDW 헤카티아는 눈을 촉촉하게 적시고, 뜨거운 숨을 내쉬었다...!
	ELSE
		PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%. 잠깐 눈 감고 있어줘♪」
		PRINTFORMDL 이번엔 또 무슨 꿍꿍이인지――아주 작은 기대와 함께――의심하며 %조사처리(CALLNAME:MASTER,"는")% 눈을 감는다.
		PRINTFORMDW 그러자 헤카티아가 재빠르게 뒤로 돌아와―
		CALL HPH_PRINT,@"「음후후……♪ 아아…… HPH핥짝... HPH흐으윽…… HPH츄... HPH르오오오…… HPH」","L"
		CALL HPH_PRINT,@"「아앙…… 안 돼, 열지 마……♪ 내가 괜찮다고 말할 때까지 눈 감고 있어……. HPH」","W"
		CALL HPH_PRINT,@"「후후…… 그래그래…… ♪응…… HPH주……HPH」","L"
		CALL HPH_PRINT,@"「변해버렸네…… HPH 시파이를 부숴 버려, 모두가 보게 될 거야…… HPH 변, 풀려라…… HPH」","L"
		;こうやって……視界を塞がれたまま、耳舐められるの……興奮、するでしょ
		PRINTFORMDW 혀의 생(콘돔없이) 따뜻한 감촉과 달콤한 속삭임에, %조사처리(CALLNAME:MASTER,"는")% 이성이 날아갈 것 같았다……!
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 13 || TFLAG:24 == 33
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「아아앗 후후 후후 이거! 좋아요! 좋아욧 후후 후후」","L"
		CALL HPH_PRINT,@"「거시기 HPH%조사처리(CALLNAME:MASTER,"의")% HPH%CALLNAME:MASTER%거시기가 더 깊숙이 들어왔으면 좋겠어읏 HPH HPH HPH」","L"
		PRINTFORMDW 평소의 헤카티아로서는 상상도 할 수 없는 난폭함에, %조사처리(CALLNAME:MASTER,"는")% 오싹하게 몸을 떨었다…….!
	ELSE
		CALL HPH_PRINT,@"「……읏……HPH는……! 응응……읏 HPH후……응우……HPH」","L"
		PRINTFORML 「응읏……? 무슨 일이야 %조사처리(CALLNAME:MASTER,"가")%? 가랑이 같은 데 누르지 마……♪」
		PRINTFORMDL 헤카티아는 %조사처리(CALLNAME:MASTER,"가")% 옆에 있어도 신경 쓰지 않고 자위하고 있었다…….
		PRINTFORMDW 마치 자랑이라도 하듯이 벌려진 두 손가락에는 걸쭉하고 진한 애액이 실처럼 늘어져 있었다……!
		CALL HPH_PRINT,@"(흐응 모~...! %CALLNAME:MASTER%란, 애태워 주는구나…… HPH)","L"
		PRINTFORMW (하지만 참아야 해…… 오늘의 플레이는, "짐승이 된 %조사처리(CALLNAME:MASTER,"에게")% 범해지는 것"이라고 정했으니까…… ♪)
	ENDIF
ENDIF
;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORML 「%CALLNAME:MASTER%ー, 너무 아프잖아아~」
	PRINTFORMDW 헤카티에게 뺨을 잡아당겨졌다. 정말 아파……!
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORMDL 갑자기 헤카티아에게 가슴팍을 붙잡혔다...!
	IF TALENT:111:恋慕 || TALENT:111:思慕
		PRINTFORML 「당신은 피스 친구니까, 어느 정도는 너그럽게 봐왔지만……」
	ELSEIF TALENT:112:恋慕 || TALENT:112:思慕
		PRINTFORML 「당신은 순호의 아끼는 존재니까, 어느 정도는 눈 감아줬지만……」
	ELSE
		PRINTFORML 「……%CALLNAME:MASTER%. 나는 당신을 조금 너무 달래준 것 같아」
	ENDIF
	PRINTFORML 「이제 슬슬, 어느 쪽이 우위에 있는지 똑똑히 알려줄 필요가 있겠네...!」
	PRINTFORMDW 헤카티아에게서 살갗이 아플 정도의 살기를 느낀다……!
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORMDW …………。
	IF TALENT:111:恋慕 || TALENT:111:思慕
		PRINTFORML 「%CALLNAME:MASTER%, 피스에게 하고 싶은 말이라도 있는 거야?」
		PRINTFORMW 「괜찮아~ 피스는 똑똑하니까, 당신이 나를 화나게 했다고만 하면 납득해 줄 테니까♪」
	ELSEIF TALENT:112:恋慕 || TALENT:112:思慕
		PRINTFORML 「%CALLNAME:MASTER%, 순호에게 뭔가 남길 말은 있어?」
		PRINTFORMW 「덧붙이자면…… 순호도 이 일은 알고 있어. 그러니 도와주러 오지는 않을 거야」
	ELSE
		PRINTFORML 「%CALLNAME:MASTER%, 마지막으로 하고 싶은 말은 없어?」
		PRINTFORMW 「구조는 오지 않아. 만약 온다 해도, 내가 되받아 줄 테니까」
	ENDIF
	PRINTFORMDL 헤카티아에게 엄청난 힘으로 목이 졸려, %조사처리(CALLNAME:MASTER,"는")% 몸을 움직일 수가 없다……
	PRINTFORMDW 게다가 발밑에는 끝을 알 수 없을 정도로 깊은 구멍이 파여 있었고, 그녀가 이대로 손을 놓으면 돌이킬 수 없는 지경이다...!
	PRINTFORML 「저 구멍은 지옥과 연결되어 있어. 거기서 머리를 식혀 보렴」
	PRINTFORMW 「……살아서 돌아오면 좋겠네~♪」
	PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 마지막으로 본 것은, 싸늘한 듯한 헤카티아의 미소였다……
ENDIF
