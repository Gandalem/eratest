@M_KOJO_MESSAGE_COM_K113_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:時間停止 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「……%CALLNAME:MASTER%, 아직 안 갈 거야?」
		CALL HPH_PRINT,@"「빨리 정액 싸는 거 보고 싶다…… HPH」","L"
		PRINTFORMDW 조금 서투른 헤카티아의 자위는, 이루 말할 수 없는 쾌감을 가져다주고 있어...!
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧３以上
	ELSEIF ABL:技巧 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「뭐야~ 더 자극이 필요하다고 하는 얼굴네……♪」
					PRINTFORML 「그럼……♪ 이런 건 어때용?」
					CALL HPH_PRINT,@"「――에잇! 후우윽」","L"
					PRINTFORMDW 헤카티아는 검지손가락을 음구에 가볍게 밀어 넣었다. 강렬한 자극에 %조사처리(CALLNAME:MASTER,"는")% 나도 모르게 신음하고 말았다―
				CASE 1
					CALL HPH_PRINT,@"「자자…… HPH 벌써 사정할 것 같지 않아?」","L"
					CALL HPH_PRINT,@"「빨리 사정해서 편해지도록 해라 HPH」","L"
					PRINTFORMDL 이미 헤카티아는 손으로 정액을 받을 준비를 하고 있다.
					PRINTFORMDW 그녀의 깨끗한 손바닥에, %조사처리(CALLNAME:MASTER,"는")% 마음껏 정액을 쏟아냈다―
				CASE 2
					CALL HPH_PRINT,@"「후후후……♪ 효과가 있겠지? 이거…… HPH」","L"
					CALL HPH_PRINT,@"「지금 사정하면 분명 허리가 빠질 정도로 기분 좋을 거야~ 후후 후후」","L"
					PRINTFORMDL 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 페니스를 움켜쥐면서, 비어 있는 다른 한 손으로 고환을 주무르기 시작한다.
					PRINTFORMDW 단 한 방울도 남김없이 짜내려 하는 탐욕스러운 손놀림에, %조사처리(CALLNAME:MASTER,"는")% 결국 절정에 이른다―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 평소에 무슨 걸 장난감으로 하고 있는 거야?」
					CALL HPH_PRINT,@"「안 말하면 여기에 손가락 넣을 거야~? 후후」","L"
					PRINTFORMDW 헤카티아의 손가락이, 음부를 자극해 온다...!
				CASE 1
					CALL HPH_PRINT,@"「후후후…… 하헵 즐겁네에…… 하헵」","L"
					PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 표정을 살피며 페니스를 다루고 있다.
				CASE 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……후후, 여기 만져지는 거 좋아하잖아? 후후」","L"
					CALL HPH_PRINT,@"「숨겨도 안 돼~ 주인님한테 다 보인단 말이야 HPH」","L"
					PRINTFORMDW 헤카티아가 %조사처리(CALLNAME:MASTER,"의")% 약한 곳을 정확하게 공격해 오고 있어...!
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후후후……♪ 벌벌 떨기 시작했네에…… HPH」","L"
					CALL HPH_PRINT,@"「얼마나 사정하는지, 아주 자세히 보여줘 봐……. HPH」","L"
					PRINTFORMDW 헤카티아는 손의 움직임을 더욱 가속시켰다...!
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… 벌써 가겠지…? HPH 잔뜩 사정해 봐라…… HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 절정이 가까워졌음을 감지한 헤카티아는, 더욱 거칠게 손을 움직였다...!
				CASE 2
					CALL HPH_PRINT,@"「아아아 흐응, 사정하는 거야? 흐응, 사정하는 거네 흐응 흐응」","L"
					CALL HPH_PRINT,@"「이 거시기 안에, 얼마나 정액 고여있을까? 후훗 기대돼 후훗 후훗」","L"
					PRINTFORMDL 헤카티아는 더욱 격렬하게 %조사처리(CALLNAME:MASTER,"의")% 페니스를 다루기 시작했다...!
					PRINTFORMDW 자신의 때와는 전혀 다른 힘 조절에, %조사처리(CALLNAME:MASTER,"는")% 버티지 못하고―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「역시 크네애…… HPH」","L"
					PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 페니스를 흥미로운 듯 관찰하며 다루고 있다...!
				CASE 1
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")%, 언제나 이렇게 자위하고 있는 거야……? HPH」","L"
					PRINTFORMDW 자신의 페이스와 다른 헤카티아의 자위 행위에, %조사처리(CALLNAME:MASTER,"는")% 쾌감을 느끼고 있다…….
				CASE 2
					CALL HPH_PRINT,@"「흐으음... %조사처리(CALLNAME:MASTER,"의")% 주인은 나인데... 후후」","L"
					PRINTFORMDL 자신의 손으로 %조사처리(CALLNAME:MASTER,"의")% 페니스를 "봉사"하는 헤카티아.
					PRINTFORMDW 입으로는 불평하고 있지만, 그녀의 표정은 어딘가 즐거워 보인다……
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
