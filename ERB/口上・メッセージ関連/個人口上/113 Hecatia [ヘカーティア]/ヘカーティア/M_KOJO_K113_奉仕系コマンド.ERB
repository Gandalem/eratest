@M_KOJO_MESSAGE_COM_K113_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:時間停止 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;胸技術２以上
	ELSEIF ABL:胸 >= 2
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아라…… 벌써 가려고? 어쩔 수 없잖아…… ♪」
					PRINTFORMDW 헤카티아는 더욱 가슴의 움직임을 격렬하게 했다...!
				CASE 1
					CALL HPH_PRINT,@"「오늘은 특별히 내 얼굴에 뿌려도 좋다고 허락해 줄게……후훗」","L"
					CALL HPH_PRINT,@"「――라고 하면 어쩔 건데? %CALLNAME:MASTER%읏」","L"
					PRINTFORMDW 그런 말을 들으니 사정을 참을 리가 없었다―
				CASE 2
					CALL HPH_PRINT,@"「아하하하! 앞부분이 쪽쪽 빨고 있네 HPH」","L"
					CALL HPH_PRINT,@"「좆이라니 정말 재미있네 헤헤」","L"
					PRINTFORMDW 즐거운 듯 파이즈리를 계속하는 헤카티아. 격렬한 공격에 사정을 참지 못하고―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후후후…… HPH 어때? %CALLNAME:MASTER% HPH」","L"
					CALL HPH_PRINT,@"「주인님의 파이즈리, 기분 좋지? HPH」","L"
					PRINTFORMDW 헤카티아의 능숙한 파이즈리 덕분에 벌써 사정감이 밀려온다...!
				CASE 1
					PRINTFORML 「가슴으로 감싸는 것만으로 기분이 좋아진다는 거, %CALLNAME:MASTER%참 단순하네……. ♪」
					PRINTFORMDW 반론하고 싶었지만, 방심하면 금세 끝을 보게 될 것만 같다……!
				CASE 2
					CALL HPH_PRINT,@"「후후후……HPH 이런 건 어때? HPH」","L"
					CALL HPH_PRINT,@"「아~ HPH 반응 좋다♪ %CALLNAME:MASTER%정말 귀엽네 HPH」","L"
					PRINTFORMDW 유두로 귀두를 자극당하고, %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 뒤로 고꾸라졌다...!
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아…… 거시기 떨리고 있어…… HPH 사정하는 거야? HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, 헤카티아는 더욱 격렬하게 페니스를 몰아붙였다...!
				CASE 1
					CALL HPH_PRINT,@"「사정하는 건 괜찮지만…… 내 얼굴에 뿌리면 벌이야? HPH」","L"
					PRINTFORMDW 어떻게 해야 할지 잠시 망설였지만, %조사처리(CALLNAME:MASTER,"는")% 참지 못하고―
				CASE 2
					CALL HPH_PRINT,@"「응? 갈 것 같아...? 그렇게 주인님의 가슴이 좋았나 보네? HPH」","L"
					PRINTFORMDW 어딘가 기뻐 보이는 헤카티아는 더욱 가슴을 격렬하게 움직였다...!
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응읏…후후, 후후 당신은 정말 가슴 좋아하네……후후」","L"
					PRINTFORMDW 헤카티아도 흥분한 건가, 뺨이 살짝 상기되어 있어……
				CASE 1
					CALL HPH_PRINT,@"「앙! 흐으윽... 당신 말이야...!」","L"
					PRINTFORML 「가슴에 장난을 치려면, 이제 안 해줄 거야」
					PRINTFORMDW 살짝 욕심이 나서 가슴을 만졌더니 혼났어……
				CASE 2
					PRINTFORML 「응읏…… 후우……! 응응…윽…! …큭……!」
					PRINTFORMDW 헤카티아는 파이즈리에 집중하는지, 숨소리만이 들려온다……!
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
