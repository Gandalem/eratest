@M_KOJO_MESSAGE_COM_K113_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:時間停止 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;お掃除フェラ
	ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「츄읍……♪ 츄브…… HPH쥬루륵… HPH」","L"
				CALL HPH_PRINT,@"「응읏... 꿀꺽 HPH... 아아~ ... HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 페니스에 붙어 있던 정액은, 헤카티아에게 한 방울도 남기지 않고 핥아 먹혔다...!
			CASE 1
				CALL HPH_PRINT,@"「주인님한테 거시기 깨끗하게 해달라고 할 수 있다니, 당신은 행복한 사람이네 HPH」","L"
				CALL HPH_PRINT,@"「아……흐읍 흐읍 주르륵 흘러내려와…… 후우우욱! 흐읍 흐읍」","L"
				PRINTFORMDW 서로의 체액으로 뒤덮인 페니스를, 헤카티아는 기색 하나 없이 입에 넣었다...!
			CASE 2
				CALL HPH_PRINT,@"「쭈읍... 하으윽... 흡, 큭... 헉... 헉」","L"
				CALL HPH_PRINT,@"「어때 %CALLNAME:MASTER%? 여신한테 거시기 깨끗하게 해달라고 받은 감상은 HPH」","L"
				PRINTFORMDW 눈앞의 그녀가 지옥의 여신이었다는 것을 새삼 떠올리며, 금단의 감정에 몸을 떨었다...!
		ENDSELECT
		;それ以外
	ELSE
		CALL HECA_FELLATIO
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF ABL:舌 >= 2
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「오늘도 입으로 구멍을 잔뜩 짜내 줄 거야…… HPH」","L"
				CALL HPH_PRINT,@"「아아—음윽 HPH주우욱—HPH HPH」","L"
				PRINTFORMDW 헤카티아에게 육봉을 빨려, %조사처리(CALLNAME:MASTER,"는")% 벌써 사정감이 밀려왔다...!
			CASE 1
				CALL HPH_PRINT,@"「주인님의 입으로…… 상쾌하게 해드릴게요~ HPH」","L"
				CALL HPH_PRINT,@"「아아~응……핥짝, 츄릅...읏, 주르륵」","L"
				PRINTFORMDW 헤카티아의 따뜻한 혀가, 질척하게 페니스에 감긴다...!
			CASE 2
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%……HPH 주인님의 페라 얼굴…… 똑똑히 눈에 새겨 놓을 거야용…… HPH」","L"
				CALL HPH_PRINT,@"「응읏……흐읍아―주루루읏흐읍주붓흐읍르르륵……흐읍츄우욱흐읍 흐읍」","L"
				PRINTFORMDW 천박한 얼굴로 육봉을 머금고 있는 헤카티아에게, %조사처리(CALLNAME:MASTER,"는")% 눈을 뗄 수 없다...!
			CASE 3
				CALL HPH_PRINT,@"「흐으윽…… HPH레이무우…… HPH레이루…… HPH」","L"
				CALL HPH_PRINT,@"「후후후……♪ 핥는 것만으론 부족하다는 얼굴이네…… 하아, 아아―」","L"
				PRINTFORMDW 헤카티아가 육봉을 입에 머금은 순간, 끈적한 혀가 뒤엉켜 왔다...!
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「정말이지, 이 나에게 봉사시키다니……」
				CALL HPH_PRINT,@"「나중에 벌 받을 거야……. HPH」","L"
				PRINTFORMDW 그렇게 말하면서도, 헤카티아는 어딘가 기쁜 듯 %조사처리(CALLNAME:MASTER,"의")% 페니스에 입을 댔다...!
			CASE 1
				CALL HPH_PRINT,@"「입으로 기분 좋게…… 해 줄게에… HPH」","L"
				CALL HPH_PRINT,@"「응읏……흐읍……흐으윽……흐읍」","L"
				PRINTFORMDW 헤카티아는 사랑스러운 듯 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥기 시작했다...!
			CASE 2 ;custom code
				PRINTFORML 「%CALLNAME:MASTER%…… 매일 목욕하고 있어?」
				PRINTFORML 「응…… 그럼 됐어…… ♪ 아…… 하무읏―」
				PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 페니스를 입에 물었다...!
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
