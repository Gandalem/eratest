; Modular ERB: 個人口上/113 Hecatia [ヘカーティア]/ヘカーティア/M_KOJO_K113_加虐系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;加虐系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;100,スパンキング
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K113_100
RETURN 0

@M_KOJO_MESSAGE_COM_K113_100
CALL M_KOJO_MESSAGE_COM_K113_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:時間停止 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「아앙! 후후 후후 후후」","L"
		PRINTFORML 「……뭐, 뭐 하는 거야! 이상한 소리가 나버렸잖아……!」
		PRINTFORMDL 엉덩이를 맞고 있다는 굴욕감에 헤카티아는 분노하고 있다.
		PRINTFORMDW 하지만 지금의 반응을 보면, 전혀 싫지 않은 걸지도 모른다…….
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:TARGET:マゾ == 1 || ABL:TARGET:マゾっ気 >= 2
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「히익! 헉 헉 그만해줘... 아아앗! 헉 헉」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%……주인님의 엉덩이를 뭐라니이이익 HPH HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 맞을 때마다, 헤카티아는 음란하게 신음소리를 내고 있다...!
			CASE 1
				CALL HPH_PRINT,@"「히으윽! 후헵 후헵 좋아아!! 아앗! 후헵 후헵」","L"
				CALL HPH_PRINT,@"「이, 이럴 수가...! 지옥의 여신이, 당신 같은 사람에게라니! 후후후」","L"
				PRINTFORMDW 헤카티아는 엉덩이를 맞고, 분함과 황홀감이 뒤섞인 표정을 지어온다...!
			CASE 2
				CALL HPH_PRINT,@"「아히잇 HPH HPH%CALLNAME:MASTER%읏 HPH HPH 더, 더오옷HPH」","L"
				PRINTFORML 「아... 아냐, 아무것도 아니야. 잊었―」
				CALL HPH_PRINT,@"「테엣 흐으읍! 아흣흐윽 히이익!! 흐읍 흐읍」","L"
				PRINTFORMDW 나도 헤카티아도, 돌이킬 수 없는 지경까지 와버린 걸지도 몰라…….!
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「아기읏! 후후 후후 아앗! 후후 후후 %CALLNAME:MASTER%...! 나중에 꼭 기억해둬―」","L"
				CALL HPH_PRINT,@"「아앗! 후후, 잠깐...! 그만해줘으윽! 히익! 후후」","L"
				PRINTFORMDW 어차피 나중에 벌을 받게 될 테니…… 때릴 수 있을 때 다 때려 버리자.
			CASE 1
				CALL HPH_PRINT,@"「하히읏! 후후, 응으응으으윽! 후프 프프프」","L"
				PRINTFORMDW 일정한 리듬을 새기듯이, 연속으로 헤카티아의 엉덩이를 때렸다.
			CASE 2
				CALL HPH_PRINT,@"「아히익! 후후후」","L"
				PRINTFORML 「아, 당신이네...! 누구한테 이런 걸 ―」
				CALL HPH_PRINT,@"「아아앙! 후우헵 후우헵」","L"
				PRINTFORMDW 말을 끊듯이, %조사처리(CALLNAME:MASTER,"는")% 헤카티아의 엉덩이를 때렸다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
