;==================================================
;140,イラマチオ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K113_140
RETURN 0

@M_KOJO_MESSAGE_COM_K113_140
CALL M_KOJO_MESSAGE_COM_K113_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
		ELSE
			CALL HPH_PRINT,@"「후훗... HPH 단단하고, 맛있어 보이는 거시기…… HPH」","L"
			CALL HPH_PRINT,@"「그럼 받아볼게……HPH 아아……♪」","L"
			PRINTFORMDL "―지금이다"
			PRINTFORMDL 입을 연 순간, 헤카티아의 뒷머리를 잡고 힘껏 사타구니 쪽으로 밀어붙인다.
			PRINTFORML 「응부읏!? ...잠깐...! 아파...윽...!」
			PRINTFORMDW 갑작스러운 상황에 눈이 동그래진 헤카티아를 무시하고, 쾌락 그대로 허리를 움직였다...!
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「응! 응!! 크윽! 으악! 끄아앙!!」
					PRINTFORMDL 헤카티아가 항의하는 듯한 소리를 내지만, %조사처리(CALLNAME:MASTER,"는")% 무시하고 페니스를 목구멍 깊숙이 밀어 넣는다.
					PRINTFORMDW 이윽고 밀려오는 사정감에, %조사처리(CALLNAME:MASTER,"는")% 몸을 맡겼다...!
				CASE 1
					PRINTFORML 「응으읍...! 퍽! 즈쥬윽! 주붓! 주보옷!」
					PRINTFORMDL 격렬하게 목구멍 깊숙이 삽입되자, 헤카티아의 입가는 침으로 질척거린다.
					PRINTFORMDW 입가에 음모를 붙인 채 %조사처리(CALLNAME:MASTER,"를")% 날카롭게 노려보는 그녀를 보며 흥분은 더욱 고조되어―
				CASE 2
					PRINTFORML 「응읍…… 응……! 음으으윽!」
					PRINTFORMDL 사정 직전임을 깨달았는지, 헤카티아는 머리를 휘날리며 날뛰기 시작했다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 그녀의 머리를 확 끌어당겨 목구멍 깊숙한 곳으로 페니스를 밀어 넣었다.
					PRINTFORML 「―컥!? ……으윽……!」
					PRINTFORMDW 헤카티아의 안구가 빙글 돌며 흰자위가 드러나고, 목이 페니스를 꽉 조여 온다...!
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「응응……윽! 응……! 흑…… 크윽...! 우으윽...!」
					PRINTFORML (%CALLNAME:MASTER%그 자식...! 나를 이런… 온나호처럼……!)
					PRINTFORMDL 메스꺼움 때문인지, 혹은 %조사처리(CALLNAME:MASTER,"에게")% 마음대로 당하고 있다는 무력감 때문인지…
					PRINTFORMDW 헤카티아는 눈가에 눈물을 글썽이고 있다...!
				CASE 1
					PRINTFORML 「음부윽! 음응…! 부읏! 우으읍!!」
					PRINTFORMDW 페니스로 볼이 부풀어 오른 추악한 얼굴로, 헤카티아는 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다……!
				CASE 2
					PRINTFORML 「우윽...! 음앗...! 엣, 헉! 컥! 우으윽! 으윽!」
					PRINTFORMDW 목구멍 깊은 곳을 귀두로 난폭하게 찔리자, 헤카티아는 구토를 하고 있다……
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
