				CASE 1
					CALL HPH_PRINT,@"「응읏……흐읍 흐읍 후우……아아……흐읍 흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「응응읏 흐읍 흐읍 흐읍」","W"
				CASE 3
					CALL HPH_PRINT,@"「아앗…… 후후, 아아……읏…… 후후」","W"
				CASE 4
					CALL HPH_PRINT,@"「크으……흐응……윽… 흐읍 흐읍」","W"
				CASE 5
