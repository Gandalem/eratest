			CASE 1
				CALL HPH_PRINT,@"「응, 벌써…… HPH를 애태우지 마아…… HPH」","L"
				PRINTFORMDW 겨드랑이나 허벅지 등을 살며시 쓰다듬듯이 애무했다.
			CASE 2
				CALL HPH_PRINT,@"「아앗 흐으... 기분 좋아……흐으」","L"
				CALL HPH_PRINT,@"「더…… HPH 더 많이 만져줬으면 좋겠어…… HPH」","W"
			CASE 3
				CALL HPH_PRINT,@"「후우~읏... 핥짝, 쪽... 혀로... 으응... 낼름낼름... 핥짝」","L"
				PRINTFORMDW 헤카티아의 혀가 귀구멍으로 들어왔다...!
			CASE 4
				CALL HPH_PRINT,@"「응읏... 하으... 하으하아... 응응읏... 하으」","L"
				PRINTFORMDW 평소와는 다른, 매혹적인 목소리가 헤카티아의 입에서 흘러나왔다...!
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「응읏……후으아……♪응응……윽…후으아」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 몸을 쓰다듬히며, 헤카티아는 달콤한 목소리를 흘렸다...!
			CASE 1
				CALL HPH_PRINT,@"「하아... HPH 하아... HPH %CALLNAME:MASTER%... HPH」","L"
				CALL HPH_PRINT,@"「더…… 나한테 만져줘…… HPH」","L"
				PRINTFORMDW 흥분해 온 건가, 헤카티아의 눈동자가 조금 촉촉하다…….
			CASE 2
				CALL HPH_PRINT,@"「하뭇! HPH」","L"
				CALL HPH_PRINT,@"「후후후……♪ 기분 좋지? HPH」","L"
				PRINTFORMDW 헤카티아에게 귀밑을 살짝 물렸어...!
			CASE 3
				CALL HPH_PRINT,@"「응읏 HPH 후후후……♪ 간지러워……. HPH」","W"
			CASE 4
				CALL HPH_PRINT,@"「응읏... 하으... 하으하아... 응응읏... 하으」","L"
				PRINTFORMDW 평소와는 다른, 매혹적인 목소리가 헤카티아의 입에서 흘러나왔다...!
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
