		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		;射精した
		IF NOWEX:113:射精
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 HPH 벌써 한계야읏 HPH」","L"
					CALL HPH_PRINT,@"「정액 마시고 HPH 전부, 다 마셔…… 에에엣… HPH HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 머리를 잡고 사타구니에 밀어 넣은 채, 페니스를 한계까지 목구멍 깊숙이 밀어넣는 헤카티아.
