					CALL HPH_PRINT,@"「보지가 더러워져버렸어…… HPH, 이제 어떡하면 좋을지 알겠지…? HPH」","L"
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%. 주인님의 구멍, 깨끗하게 해줘」
					CALL HPH_PRINT,@"「알고 있겠지만, 티슈로 닦는 건 용서 못 해읏... HPH」","L"
				CASE 2
					PRINTFORML 「절반은 당신 거니까, 괜찮잖아?」
					CALL HPH_PRINT,@"「자아…… HPH 빨리해봐…… HPH」","L"
			ENDSELECT
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")%, 정액이 흘러나오고 있는 헤카티아의 질구에 입술을 가까이 가져갔다...!
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;Ｃ感覚５以上
		IF ABL:Ｃ感覚 >= 5
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「아아앗 흐으흐... 후우, 시끄러워 읏 흐으흐」","L"
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 잠깐만...!! 아아아아앗! 후우 후우 후우」","L"
					PRINTFORMDW 헤카티아를 절정에 이르게 하려고, %조사처리(CALLNAME:MASTER,"는")% 더욱 격렬하게 혀를 움직였다...!
				CASE 1
					CALL HPH_PRINT,@"「응응! 흐읍... 히이익! 흐읍 흐읍」","L"
					CALL HPH_PRINT,@"「가버릴 것 같아앗! 흐으윽흐읍 흐읍 흐읍 흐읍」","L"
					PRINTFORMDW 질벽의 경련이, 혀를 통해 전해져 와……!
				CASE 2
					CALL HPH_PRINT,@"「야바아...! 이거, 너무 기분 좋아읏 HPH HPH」","L"
					CALL HPH_PRINT,@"「나... 후후, 주인님인데... %조사처리(CALLNAME:MASTER,"에게")% 가버려... 흐으읍... 하아... 하아...」","L"
					PRINTFORMDW 헤카티아는 몸을 크게 뒤로 젖히며―
				CASE 3
					CALL HPH_PRINT,@"「아아아앗 흐으흐읍 흐으흡 굉장해애!! 나, 또 갈 것 같아아큭! 흐으윽 흐으흡」","L"
					PRINTFORMDL 부끄러움도 체면도 없이, 헤카티아는 음란하게 신음하며 계속해서 울부짖는다.
					PRINTFORMDW 흥분한 %조사처리(CALLNAME:MASTER,"는")%, 더욱 격렬하게 질내를 핥아댔다...!
				CASE 4
					CALL HPH_PRINT,@"「하아앗 HPH 하아앗 HPH 하아앗 HPH HPH」","L"
					PRINTFORMDL 헤카티아가 거친 숨을 몰아쉬며 기대하는 듯한 눈으로 %조사처리(CALLNAME:MASTER,"는")% 응시한다.
					PRINTFORMDW "주인님의 요청이라면"이라며, %조사처리(CALLNAME:MASTER,"는")% 발기한 음핵에 입을 맞추었다―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「하아앗 하햣 하아앗 하햣, 아아앗 하햣 하햣」","L"
					PRINTFORMDW 헤카티아의 숨소리가 거칠어졌다. 그것에 화답하듯, 질 내부의 경련 또한 격렬함을 더하며―
				CASE 1
					CALL HPH_PRINT,@"「앗 하응흐으읏 하응 그 느낌이야…… %CALLNAME:MASTER%하아」","L"
					CALL HPH_PRINT,@"「나……후으읍 후우읍 아아아――후으읍 후우읍」","W"
				CASE 2
					CALL HPH_PRINT,@"(아……후헵 이거……갈 것 같아……후헵)","L"
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……읏! 더, 거칠게 해줘읏! 후후」","L"
					PRINTFORMDW 헤카티아의 지시대로, 혀를 더욱 격렬하게 움직였다...!
				CASE 3
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"가")% 열심히 해줘서, 벌써 갈 것 같아…… HPH」","L"
					CALL HPH_PRINT,@"「응응! 후후후, 보상…… 줄게에…… 엣!」","L"
					PRINTFORMDL 헤카티아가 훅, 하고 %조사처리(CALLNAME:MASTER,"의")% 머리를 항문 쪽으로 밀어붙인다.
					PRINTFORMDW 주인님의 보상을 받기 위해 %조사처리(CALLNAME:MASTER,"는")% 여성의 음부를 덮을 듯 입을 크게 벌렸다...!
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「그렇게 세게 하지 않아도, 이 몸은 도망가지 않는데에엣 HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「응응! 흐읍! 응! 아우윽! 응!」","L"
				CALL HPH_PRINT,@"「혀가 안에서 훅훅 하고 울려대고 있어읏 후후 후후」","L"
				PRINTFORMDW 헤카티아의 질벽을 격렬하게 핥아댔다...!
			CASE 2
				CALL HPH_PRINT,@"「하아앗 하프하아앗 하프하앙! 쿠앗 하프하아앗 아하프하우으읏 하프하프」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 격렬한 쿠니로, 헤카티아는 몸을 비틀고 있다...!
			CASE 3
				CALL HPH_PRINT,@"「응읏……흐으윽……%CALLNAME:MASTER%……클리(Cl)는 어때?」","L"
				CALL HPH_PRINT,@"「―카하앗 흐으읍흐으읍~흐으읍흐으읍흐으읍」","L"
				PRINTFORMDW 오랫동안 기다려온 음핵에 대한 자극에, 헤카티아는 몸을 크게 뒤로 젖혔다...!
			CASE 4
				CALL HPH_PRINT,@"「빨리 주인님 오만코…… HPH 기분 좋게 해줘……? HPH」","L"
				PRINTFORMDW 주인님의 기대에 부응하고자, %조사처리(CALLNAME:MASTER,"는")% 벌려진 질 구멍에 얼굴을 가까이 대고 핥아댔다...!
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「보지뿐만이 아니라 클리도 핥아먹는 거야, 응? HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「응으읏 HPH응읏 HPH아앗 HPH 기분 좋아, %CALLNAME:MASTER%……HPH」","L"
				PRINTFORMDW 헤카티아의 질벽이 %조사처리(CALLNAME:MASTER,"의")% 혀를 조여온다...!
			CASE 2
				CALL HPH_PRINT,@"「응응… HPH 어때? %CALLNAME:MASTER%…… HPH」","L"
				CALL HPH_PRINT,@"「주인님의 진액은 맛있죠? HPH」","L"
				PRINTFORMDW 헤카티아의 질내를 핥을수록 애액이 흘러나온다...!
			CASE 3
				CALL HPH_PRINT,@"「후후후…… HPH 잘하네, %CALLNAME:MASTER%…… HPH」","L"
				PRINTFORMDW 헤카티아는, 쿠니를 하고 있는 %조사처리(CALLNAME:MASTER,"의")% 머리를 부드럽게 쓰다듬었다.
			CASE 4
				CALL HPH_PRINT,@"「주인님 몸에서 나는 냄새, 똑똑히 기억할 거야…… HPH」","L"
				CALL HPH_PRINT,@"(응읏 후후 코가 간지러워서, 소름이 돋아버려…… 후후)","L"
