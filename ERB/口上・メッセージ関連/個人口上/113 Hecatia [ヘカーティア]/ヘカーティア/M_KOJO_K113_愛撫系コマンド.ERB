				;それ以外
			ELSE
				CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 거시기보다, 기분 좋을지도 몰라……후으」","L"
				CALL HPH_PRINT,@"「뭐야~ 농담이잖아앙 HPH」","L"
				PRINTFORMDW 헤카티아가 도발적인 미소를 지으며 자위를 보여주고 있어...!
			ENDIF
			;それ以外
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 >= 3
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH, 주인님 자위하는 거 더 보고 싶어…… HPH」","L"
				PRINTFORMDW 헤카티아는 황홀한 표정으로, 바이브를 격렬하게 움직이고 있다...!
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「응으읍... HPH 그, 그렇게 신경 쓰이나...? HPH」","L"
				PRINTFORMDW 헤카티아는 질구에 삽입된 바이브로 자위하고 있다...!
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;アナルバイブ自慰
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TEQUIP:アナルバイブ
		;Ａ感覚４以上
		IF ABL:Ａ感覚 >= 4
			;自慰中毒１０以上かつ調教自慰経験１００以上
			IF ABL:自慰中毒 >= 10 && EXP:調教自慰経験 >= 100
				CALL HPH_PRINT,@"「아앗 흐으햣흐으아아앗 흐으햣흐으 %CALLNAME:MASTER%읏흐으햣흐으 제대로, 보는 거라구욧!」","L"
				CALL HPH_PRINT,@"「주인님, 엉덩이 구멍 절정할 때 히으윽! 히으윽」","L"
				PRINTFORMDW 헤카티아의 격렬한 항문 자극에서 눈을 뗄 수 없어...!
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「흐으윽! 후후, 뒤쪽이 후후 기분 너무 좋아읏 후후 후후」","L"
				PRINTFORMDW 헤카티아는 엉덩이의 바이브를 격렬하게 삽입하고 있다...!
			ENDIF
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 >= 3
				CALL HPH_PRINT,@"「하아앗... HPH 하아앗... HPH」","L"
				CALL HPH_PRINT,@"「엉덩이…… 떨리고 있어…… HPH」","L"
				PRINTFORMDW 헤카티아는 숨을 거칠게 몰아쉬며, 뒤쪽 바이브를 삽입하고 있다...!
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「흐으윽…… HPH 너무 많이 보지 마, 안 돼앳...!」","L"
				PRINTFORMDW 헤카티아는 익숙하지 않은 손길로, 항문의 바이브를 삽입하고 있다...!
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;挿入中分岐
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		;自慰中毒１０以上
		IF ABL:自慰中毒 >= 10
			CALL HPH_PRINT,@"「응! 하아... 정말이지... 주인님께 이런 걸 시키다니, 엣하아...」","L"
			CALL HPH_PRINT,@"「%CALLNAME:MASTER%……나중에, 벌이야아앙 HPH HPH」","L"
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 피스톤을 멈추고도, 헤카티아는 스스로 허리를 움직이며 쾌락을 얻고 있다……!
			;それ以外
		ELSE
			CALL HPH_PRINT,@"「응응읏! 하으윽, 왜 내가 이런 걸…… 어앗, 하아윽」","L"
			CALL HPH_PRINT,@"「나…… 당신의 주인님이란 말인데용……읏 HPH」","L"
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 피스톤을 멈추자, 헤카티아가 스스로 허리를 움직이기 시작했다...!
		ENDIF
		;それ以外
	ELSE
		;自慰中毒３以上
		IF ABL:自慰中毒 >= 3
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「오카즈?……글쎄? 뭐라고 생각해? HPH」","L"
					CALL HPH_PRINT,@"「매일 밤 당신으로 자위하고 있어……이라고 말하면, 흥분할까? HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「응읏……후후후……♪ 더 가까이서 봐도 돼~? 후훗」","L"
				CASE 2
					CALL HPH_PRINT,@"「아앗 흐으흐 %CALLNAME:MASTER%읏 흐으흐」","L"
					CALL HPH_PRINT,@"「더욱이요, 하프 주인님의 오만코를 범하고 싶어요! 하프 하프 하프」","L"
				CASE 3
					CALL HPH_PRINT,@"「저기 %CALLNAME:MASTER%…… 시선 돌리면 안 돼읏…… HPH」","L"
					CALL HPH_PRINT,@"「주인님이 갈 때…… 응읏, HPH쨩이랑 같이 봐줘어…… HPH HPH」","L"
			ENDSELECT
			PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"에게")% 보여주듯이 자위하고 있다……!
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응읏...! 아흐읍... 음ㅁ... 으윽... 흐읍」","L"
					CALL HPH_PRINT,@"「흐읍, 평소에 할 리가 없잖아요!? 당신이랑…… 하는 건, 아아앗 HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「크으윽……! HPH 너무…… 그렇게 뚫어져라 보지 마아...!」","L"
				CASE 2
					CALL HPH_PRINT,@"「응! 하으윽! 아, 아아앗! 흐읍... 흐으으읍...」","L"
					CALL HPH_PRINT,@"(%CALLNAME:MASTER%한테 보여지는 것만으로도 평소보다 더 느껴져……. 큭)","L"
			ENDSELECT
			PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"에게")% 보인 채 자위하고 있다...!
		ENDIF
	ENDIF
ENDIF
RETURN 1
