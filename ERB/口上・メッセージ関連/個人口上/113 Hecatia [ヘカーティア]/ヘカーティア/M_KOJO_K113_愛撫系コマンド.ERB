			CASE 2
				CALL HPH_PRINT,@"「응우읏 후후 후후」","L"
				PRINTFORML 「빨아도 아무것도 안 나오잖아……」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 애교를 부리듯 헤카티아의 유두에 입을 붙였다...!
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
