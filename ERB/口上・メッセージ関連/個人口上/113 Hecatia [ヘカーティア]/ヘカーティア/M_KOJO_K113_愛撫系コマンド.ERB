@M_KOJO_MESSAGE_COM_K113_11_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:時間停止 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1 ;custom code
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｂ感覚が５以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 HPH 안에 부풀어 올랐어 HPH 좋아해 %CALLNAME:MASTER%읏」","L"
						CALL HPH_PRINT,@"「앗――응으으으윽 흐읍 흐읍 흐읍」","L"
						PRINTFORMDW 헤카티아의 유두를 물자, 엄청난 기세로 페니스가 조여왔다...!
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 흐으응 흐으응 후우윽!! 흐으응 흐으응」","L"
						CALL HPH_PRINT,@"「아앗 흐읍 흐읍 아아아아앗 흐읍 흐읍 흐읍」","L"
						PRINTFORMDW 허리를 비비며 눈앞의 유두를 빨아들였다...!
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……HPH 주인님과 함께, 가버릴 거야…… HPH」","L"
						PRINTFORMDL 헤카티아를 꽉 껴안고, 젖꼭지를 빨아들인다.
						PRINTFORMDW 날카로운 신음 소리를 들으며, %조사처리(CALLNAME:MASTER,"는")% 절정에 다다랐―
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:4
					CASE 0
						CALL HPH_PRINT,@"「응응! 흐으윽! 하아앗! 흐읍!」","L"
						CALL HPH_PRINT,@"「더욱음! 후후, 가슴을 세게 빨아줘 후후 후후」","L"
					CASE 1
						CALL HPH_PRINT,@"「아앗! 큭큭, 이봐! 가슴에 자국 남으면 어쩔 거야? 큭큭」","L"
					CASE 2
						CALL HPH_PRINT,@"「자자~ HPH를 좋아하는 주인님의 가슴이야♪ 기쁘지? HPH HPH」","L"
					CASE 3
						CALL HPH_PRINT,@"「응응! 흐읍흐읍 그래읏! 흐읍흐읍」","L"
						CALL HPH_PRINT,@"「보지뿐만 아니라 가슴도 기분 좋게 해줘…… HPH」","L"
				ENDSELECT
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 헤카티아의 가슴에 얼굴을 파묻힌 채, 무아지경으로 애무를 했다...!
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗 흐으윽 안돼읏 흐으윽」","L"
						CALL HPH_PRINT,@"「~~~~읏 흐읍 흐읍 흐읍」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 유두에 깨물자, 헤카티아가 절정에 이르렀다...!
					CASE 1
						CALL HPH_PRINT,@"「큭흐으윽! 아아앗, 흐읍... 끅, 으쌰...! 흐읍...」","L"
						CALL HPH_PRINT,@"「앗!? 유두―흐으읍 흐아아아아아아악 흐으읍 흐읍 흐읍」","L"
						PRINTFORMDW 헤카티아가 신음소와 동시에 페니스가 조여왔다...!
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏…… 잘, 움직이면서……. HPH 가슴 빨 수 있네에……」","L"
					CASE 1
						CALL HPH_PRINT,@"「응읏 흐으아앗 히히, 응응흐으윽」","L"
						CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 이빨이……유두에 닿아버렸어앗 HPH)","L"
					CASE 2
						CALL HPH_PRINT,@"「흐응... HPH 가슴이 끈적거려 죽겠어…… HPH」","L"
				ENDSELECT
				PRINTFORMDW 헤카티아의 유두를 입으로 애무하며, 허리를 움직였다...!
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:母乳体質
