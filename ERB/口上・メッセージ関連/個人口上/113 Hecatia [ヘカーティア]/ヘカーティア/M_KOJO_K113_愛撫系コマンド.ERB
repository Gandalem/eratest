		IF ABL:Ｖ感覚 >= 5 && ABL:Ａ感覚 >= 4
			;自慰中毒１０以上かつ調教自慰経験１００以上
			IF ABL:自慰中毒 >= 10 && EXP:調教自慰経験 >= 100
				CALL HPH_PRINT,@"「아앗 후후후 아앗 후후후 후후」","L"
				CALL HPH_PRINT,@"「하, 아앗! 흐으윽... 흐읍흐읍, 오오오옷...! 흐읍흐읍 흐읍흐읍 흐읍」","L"
				PRINTFORMDL 평소의 여유로운 태도는 어디로 간 거지……
				PRINTFORMDW 헤카티아는 두 개의 바이브를 앞뒤 구멍에 찔러 넣고 격렬하게 자위하고 있다……!
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「끅 히으읍, 우우윽 히으읍 히으읍」","L"
				CALL HPH_PRINT,@"「이거…… 너무 기분 좋아, 으응흐읍! 흐윽 흐읍」","L"
				PRINTFORMDW 헤카티아는 앞뒤의 암구에 바이브를 찔러 자위하고 있다...!
			ENDIF
			;それ以外
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 >= 3
				CALL HPH_PRINT,@"「당신한테 보여주면서 하는 거야…… 흐읍, 흥분돼버릴 것 같아……흐읍」","L"
				PRINTFORMDW 헤카티아는 황홀한 표정으로, 바이브를 격렬하게 움직이고 있다...!
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「자, 아무래도…… 두 개는 좀 과했나아아앗! 아아아큭! 큭큭」","L"
				PRINTFORMDW 강렬한 쾌감에 헤카티아는 몸을 떨고 있다...!
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;バイブ自慰
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TEQUIP:バイブ
		;Ｖ感覚５以上
		IF ABL:Ｖ感覚 >= 5
			;自慰中毒１０以上かつ調教自慰経験１００以上
			IF ABL:自慰中毒 >= 10 && EXP:調教自慰経験 >= 100
				CALL HPH_PRINT,@"「아아아앗 HPH 아앗 HPH 기분, 좋아읏 HPH」","L"
				CALL HPH_PRINT,@"「오오옷 흐읍 흐읍앗 흐아아아읏 흐읍 흐읍 흐읍」","L"
