	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｃ＆Ｂ感覚が一定以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				CALL HECA_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앙! 후으... 뭐야? 주인님 거 말고 다른 것도 만족 못 하는 거야? 후으」","L"
					CASE 1
						CALL HPH_PRINT,@"「앗 흐응, 아아흐으으읍」","L"
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 후후 기분 좋아~ 후후 그것! 더 해줘~ 후후 후후」","L"
					CASE 2
						CALL HPH_PRINT,@"「아앗 흐으응! %CALLNAME:MASTER%흐으응!」","L"
						CALL HPH_PRINT,@"「더 HPH 더 주인님께 만져주세용 HPH」","L"
				ENDSELECT
				PRINTFORMDW 헤카티아의 몸에 닿을 때마다 질 안의 조임이 더 강해진다...!
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				CALL HECA_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 HPH치, 잠깐만요오옷 HPH」","L"
						CALL HPH_PRINT,@"「만져도 된다니…… 말 안 했잖아아……읏ㅎㅍㅎ」","L"
					CASE 1
						CALL HPH_PRINT,@"「이... 이거...!! 너무 민감해져서, 너무 느껴져버릴 것 같아앗!! 하프 하프」","L"
					CASE 2
						CALL HPH_PRINT,@"「응으윽...흐읍 안읏 흐읍, 그만둬...흐읍」","L"
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")%……흐응, 허리 움직이는 데 집중하고 있으면 되잖아아앗흐응」","L"
				ENDSELECT
				PRINTFORMDW 헤카티아의 몸에 닿을 때마다 질 안의 조임이 더 강해진다...!
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚・Ｂ感覚が５以上
	ELSEIF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5
		SELECTCASE RAND:5
