	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「자아, %CALLNAME:MASTER%…… HPH」","L"
		CALL HPH_PRINT,@"「주인님의 거시기…… 잔뜩 봉사해 드릴게요 HPH」","L"
		PRINTFORMDL 헤카티아의 사타구니에는 우람한 크기의 페니스가 서 있다.
		PRINTFORMDW 정신을 차려보니 %조사처리(CALLNAME:MASTER,"는")% 마치 끌리듯 페니스 쪽으로 얼굴을 가까이 하고 있었다...!
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
