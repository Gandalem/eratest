@M_KOJO_SUCCESS_COM_K113_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K113_310
RETURN 0

@M_KOJO_MESSAGE_COM_K113_310
CALL M_KOJO_MESSAGE_COM_K113_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 카티아의 엉덩이를 쓰다듬었다.
		PRINTFORMDW 균형 잡힌, 적당한 크기이다.
	ELSEIF CFLAG:睡眠
		CALL HPH_PRINT,@"「응응... 큭... 흐으음... 후우... 응읏... 흐으음」","W"
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;クンニ強制
			CASE 70
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「앗! 흐으읏! 잠깐만, 어? 엉덩이 만져주지 않을 거야? 큭... 하아...」","W"
					CASE 1
						CALL HPH_PRINT,@"「앙! 후후, 거기는 보지(몸)가 아니라고오옷! 후후 후후」","W"
				ENDSELECT
				;アナル奉仕
			CASE 72
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응읏... 아아앗 HPH 그래... HPH 그 느낌이야... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「후후후... HPH 주인님의 엉덩이, 마음에 들었어? HPH」","W"
				ENDSELECT
				;スカートの中を見せる
			CASE 35
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗 HPH 잠깐, 엉덩이 만지지 마아 HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「응응…… HPH, 당신은 엉덩이가 더 좋은 건가아...? HPH」","W"
				ENDSELECT
				;素股
			CASE 52
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「앙! 흐으윽... 잠깐만, 방해하지 마아……흐읍」","W"
					CASE 1
						PRINTFORMW 「자, 가만히 있어 봐~♪」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응응…… HPH, 당신은 엉덩이가 더 좋은 건가아...? HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「후후후... HPH 주인님의 엉덩이, 마음에 들었어? HPH」","W"
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%~♪ 이 손은 뭘까?」
					PRINTFORMDW 헤카티에게 들켜서, 손이 뒤집혔다…….
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「앗 후후, 방까지 참을 수 없어?」","W"
						CASE 1
							CALL HPH_PRINT,@"「아앙! 히히, 엉덩이 만져주지 않아? 히히」","W"
						CASE 2
							CALL HPH_PRINT,@"「아앗... 흐응, 이 변태……흐으응」","W"
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「앙! 후후 더 부드럽게 만져줘…… 후후」","W"
						CASE 1
							CALL HPH_PRINT,@"「응읏…흐윽, 하아…응읏 흐읍…흐으음…아…흐윽」","L"
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 쓰다듬히며, 헤카티아는 애처로운 소리를 흘리고 있다...!
						CASE 2
							CALL HPH_PRINT,@"「후후후…… HPH 너의 엉덩이도 나쁘지 않아…… HPH」","L"
							PRINTFORMDW 헤카티아의 손이 %조사처리(CALLNAME:MASTER,"의")% 엉덩이에 닿아 있어...!
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%~♪ 이 손은 뭘까?」
					PRINTFORMDW 헤카티에게 들켜서, 손이 뒤집혔다…….
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「응응읏… 후후, 잠깐만...! 그만해, 제발... 아아앗! 후후」","L"
						CASE 1
							CALL HPH_PRINT,@"「응읏… HPH쿠… 윽…! 응응… HPH 당신… 적당히 해줘… 윽… HPH」","L"
					ENDSELECT
					PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 바디 터치를 받아들이고 있어...!
					;されるがまま
				CASE 4
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「후회할 일 없도록, 마음껏 즐기세요♪」
							PRINTFORMDW 헤카티아의 미소가 무섭다…….
						CASE 1
							IF TALENT:111:恋慕 || TALENT:111:思慕
								PRINTFORML (참아... 참아야 해, 헤카티아...!?)
								PRINTFORML (이런 걸로도 일단은, 피스의 친구니까...!)
								PRINTFORMDW 헤카티아는 미간에 힘줄을 세우면서 %조사처리(CALLNAME:MASTER,"의")% 성추행을 받아들이고 있다……
							ELSE
								PRINTFORML 「후회할 일 없도록, 마음껏 즐기세요♪」
								PRINTFORMDW 헤카티아의 미소가 무섭다…….
							ENDIF
						CASE 2
							IF TALENT:112:恋慕 || TALENT:112:思慕
								PRINTFORML (참아… 참아야 해, 헤카티아…!)
								PRINTFORML (이 애를 상처 입히면 분명 순호가 슬퍼할 거야…!)
								PRINTFORMDW 헤카티아는 미간에 힘줄을 세우면서 %조사처리(CALLNAME:MASTER,"의")% 성희롱을 받아들이고 있다……
							ELSE
								PRINTFORML 「후회할 일 없도록, 마음껏 즐기세요♪」
								PRINTFORMDW 헤카티아의 미소가 무섭다…….
							ENDIF
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K113_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K113_311
RETURN 0

@M_KOJO_MESSAGE_COM_K113_311
CALL M_KOJO_MESSAGE_COM_K113_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 시간을 멈춘 채, 헤카티에게 안겼다.
		PRINTFORMDW 대담하게 노출된 어깨나 쇄골을 가까이에서 천천히 만끽했다.
	ELSEIF CFLAG:睡眠
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「응... 후으읍」","W"
			CASE 1
				PRINTFORML 「응응~...!」
				PRINTFORMDW 잠이 오지 않는 듯 얼굴을 찡그리고 있다……
		ENDSELECT
		RETURN 1
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;前から抱きつく
			CASE 32
				CALL HPH_PRINT,@"「후후후……♪ 지금만은, 나에게 기대는 걸 허락해 줄게…… HPH」","L"
				PRINTFORMDW 헤카티에게 안겨서 머리를 쓰다듬는 걸 받았어……
				;ディープキス
			CASE 60
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응읏 후후, 쪽쪽 츄릅 츄우하아, 푸르륵 츄우욱」","L"
						PRINTFORMDW 헤카티와 서로 껴안고 밀착한 채 키스를 나누었다...!
					CASE 1
						CALL HPH_PRINT,@"「음흡! 흐읍흐읍츄릅! 앙므으흐읏크츄읍츄르륵! 흐읍흐읍」","L"
						PRINTFORMDL 헤카티와 격렬한 키스를 나누었다.
						PRINTFORMDW 뒷머리에 손을 감싸지고, %조사처리(CALLNAME:MASTER,"는")% 할 수 없이 당하고 있다...!
				ENDSELECT
				;ぱふぱふ
			CASE 73
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「후후후…… HPH 너 정말 이거 좋아하는구나…… HPH」","L"
					CASE 1
						CALL HPH_PRINT,@"「이런 거…… 나 말고 다른 데 기대지 말라고, 응…… HPH」","L"
				ENDSELECT
				PRINTFORMDW 헤카티한테 포근하게 안아줬다...!
				;乳合わせ
			CASE 74
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응으윽 HPH 잠깐만, %CALLNAME:MASTER%……♪」","L"
						CALL HPH_PRINT,@"「그렇게 움직이면, 젖꼭지가 아파……흐으응」","L"
					CASE 1
						CALL HPH_PRINT,@"「후후후♪응……흐으, 당신은 유두도 약하네에 HPH」","L"
				ENDSELECT
				PRINTFORMDW 헤카티와 밀착하며 유두를 비볐다...!
				;乳を吸わせる
			CASE 77
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응앗! 하햣! 잠시만, 너무 세게 빨고 있잖아... 하햣」","L"
					CASE 1
						CALL HPH_PRINT,@"「후후후……♪ 지금만은, 나에게 기대는 걸 허락해 줄게…… HPH」","L"
				ENDSELECT
				PRINTFORMDW 어린아이의 마음으로 돌아가, 헤카티아의 젖꼭지에 입을 붙였다...!
				;85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ
			CASE 85,87,88,89
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗 HPH%CALLNAME:MASTER%읏 HPH 더오오 HPH 더 오만코 만지고 싶어엣 HPH」","L"
						PRINTFORMDW 헤카티아를 끌어안은 채, 허리를 격렬하게 흔들었다...!
					CASE 1
						CALL HPH_PRINT,@"「하앗 HPH 하앗 HPH %CALLNAME:MASTER%……♪」","L"
						CALL HPH_PRINT,@"「내 심장 소리…… 들리고 있나아...? HPH」","L"
						PRINTFORMDW 헤커티아의 몸을 끌어안고 강하게 밀착했다...!
				ENDSELECT
				;だいしゅきホールド
			CASE 86
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗 흐으흐흣 아아앙 흐읍 흐윽」","L"
						CALL HPH_PRINT,@"「응음! 후루룩! 후루룩! 아앗! 후루룩! 핥아라앗!」","L"
					CASE 1
						CALL HPH_PRINT,@"「응읏흐읍후으윽츄읍응읏아앗츄우아아아앗 흐읍흐읍」","L"
				ENDSELECT
				PRINTFORMDW 헤카티와 밀착하며 유두를 비볐다...!
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「후후후……♪ 지금만은, 나에게 기대는 걸 허락해 줄게…… HPH」","L"
						PRINTFORMDW 헤카티에게 안겨서 머리를 쓰다듬는 걸 받았어……
					CASE 1
						CALL HPH_PRINT,@"「주인님한테 더 응석 부려도 되잖아아앙 HPH」","L"
						PRINTFORMDW 안기자, 헤카티아는 미소를 지으며 다가왔다...!
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……♪ 내 심장 박동…… 느껴지고 있니…? HPH」","L"
						PRINTFORMDW 헤커티아의 몸을 끌어안고 강하게 밀착했다...!
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:(TALENT:恋人 ? 5 # 3)
				CASE 0
					CALL HPH_PRINT,@"「왜 그래? 주인님한테 응석 부리고 싶어졌어? HPH」","W"
				CASE 1
					PRINTFORML 「자, 어서 와~♪」
					SETCOLOR 0x2459F0
					PRINTFORML 「자, 어서 와~♪」
					SETCOLOR 0xF0D124
					PRINTFORML 「자, 어서 와~♪」
					PRINTFORMDW どのへカーティアに抱きつくか悩んだが、%TEXTR("異界/地球/月")%のへカーティアにした。
				CASE 2
					PRINTFORML 「뭐야… 가끔은 괜찮지…♪」
					PRINTFORMDW 헤르티아에게 안겼다. 기분이 좋은 건지, 화를 내지는 않는 듯하다……
					;以下恋人のみ
				CASE 3
					CALL HPH_PRINT,@"「응읏 HPH… 사랑해, %CALLNAME:MASTER%… HPH」","L"
					PRINTFORMDW 입맞춤과 함께 헤카티아의 사랑을 받았어...!
				CASE 4
					CALL HPH_PRINT,@"「……HPH」","L"
					PRINTFORMDW 카르티아와 말없이 서로를 껴안는다. 두 사람 사이에는 말이 필요 없다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「그렇게까지 용서한 기억은 없다」
					PRINTFORMDW 얼굴에 아이언클로를 당했다.
				CASE 1
					CALL HPH_PRINT,@"「야~ㄴ HPH 변태아♪」","L"
					PRINTFORMDW 정수리에 쿵 하고 주먹을 짓눌렸다……
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
