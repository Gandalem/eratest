;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K113_330
RETURN 0

@M_KOJO_MESSAGE_COM_K113_330
CALL M_KOJO_MESSAGE_COM_K113_330_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 시간을 멈추고 있기 때문에, 헤카티아는 전혀 몸을 움직일 수 없다.
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 여유롭게 눈에 아픈 색감의 치마를 들춰보니 그곳에는…!?
		;穿いてる
		IF TEQUIP:0 > 1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDW 헤르티아치로서는 드물게 수수한 색감의 팬티가 있었다……
				CASE 1
					PRINTFORMDW "GoToHell"이라고 적힌 이상한 팬티가 있었다...
			ENDSELECT
			;穿いてない
		ELSE
			PRINTFORMDL 있어야 할 팬티는 없고, 헤카티아는 노팬이었다.
			PRINTFORMDW 길이가 짧은 치마로, 저렇게 태연할 수 있는 거겠지……
		ENDIF
	ELSEIF CFLAG:睡眠 ;custom code
	ELSEIF CFLAG:うふふ == 2
		CALL HPH_PRINT,@"「후후후…… HPH 어때?」","L"
		CALL HPH_PRINT,@"「당신 거…… 전부 박혀있다고오~ HPH」","L"
		PRINTFORMDW 헤카티아는 치마를 들어 올리고, 맞닿은 서로의 성기를 보여주었다...!
	ELSE
		;初回
		IF FIRSTTIME(SELECTCOM)
			PRINTFORMDL "잠깐 눈을 감아줬으면 해"
			PRINTFORML 「?…이걸로 괜찮아?」
			PRINTFORML (후후후……♪혹시 서프라이즈인가?)
			PRINTFORMDW 헤카티아가 눈을 감은 사이에, %조사처리(CALLNAME:MASTER,"는")% 치맛자락을 들추었다!
			PRINTFORML 「앗!?―읏!!」
			;穿いてる
			IF TEQUIP:0 > 1
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMDW 주먹뼈를 물고 기절하기까지의 순간에, 순백의 팬티를 눈에 각인시켰다...!
					CASE 1
						PRINTFORMDL 주먹뼈를 맞고 정신을 잃기 직전, "GoToHell"이라고 적힌 이상한 팬티가 보였다.
						PRINTFORMDW 이런 걸 보기 위해 리스크를 감수한 것을, %조사처리(CALLNAME:MASTER,"는")% 진심으로 후회했다...
				ENDSELECT
				;穿いてない
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 시야에 들어온 것은 비밀의 화원이었다.
				PRINTFORMDW 좋은 것을 보여준 것에 대한 감사로, 헤카티아에게 강력한 벌을 받기로 했다……
			ENDIF
			SELECTCASE TFLAG:193
				;ビンタ
				CASE -5
					PRINTFORML 「몸과 헤어지지 않았다는 것만으로도 감사히 여겨야 해」
					PRINTFORMDW 목이 비틀릴 듯한 기세로 뺨을 붙잡혔다……
					;つねられる
				CASE -3
					PRINTFORML 「아얏, 아프게 하는 나쁜 손은 이 손일까~?」
					PRINTFORMDW 헤카티아에게 손가락을 집혔다. 엄청 아파……
					;嫌がる
				CASE -1
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL "잠깐 눈을..."
							PRINTFORMW 「이제 그 손에는 걸리지 않아.」
						CASE 1
							PRINTFORML 「잠깐!? 뭐 하는 거야!」
							PRINTFORMDW 헤카티의 치마를 들추려 했지만, 발각되어 버렸다...
					ENDSELECT
					;嫌がる（嬉しげ）
				CASE 0
					CALL HPH_PRINT,@"「얀~♪ %CALLNAME:MASTER%씨의 에치~ HPH」","L"
					PRINTFORMDW 가벼운 말투지만, 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 다리를 강하게 짓밟고 있다……
					;成功
				CASE 1
					IF ABL:露出癖 <= 2
						PRINTFORMDL "아! %TEXTR("純狐が知らないおじさんに首輪付けて散歩させてる!/クラウンピースが玉乗りしながら松明をジャグリングしてる!/映姫が地獄Tシャツ着てハイグレ踊りしてる!")%"
						PRINTFORML 「%TEXTR("何ですって/嘘っ/えっ")%！？」
						PRINTFORMDW 헤카티아의 주의가 한순간 벗어난 틈을 타, %조사처리(CALLNAME:MASTER,"는")% 치마를 걷어 올렸다!
						PRINTFORML 「앗!?―읏!!」
						;穿いてる
						IF TEQUIP:0 > 1
							SELECTCASE RAND:2
								CASE 0
									PRINTFORMDW 주먹뼈를 물고 기절하기까지의 순간에, 순백의 팬티를 눈에 각인시켰다...!
								CASE 1
									PRINTFORMDL 주먹뼈를 맞고 정신을 잃기 직전, "GoToHell"이라고 적힌 이상한 팬티가 보였다.
									PRINTFORMDW 이런 걸 보기 위해 리스크를 감수한 것을, %조사처리(CALLNAME:MASTER,"는")% 진심으로 후회했다...
							ENDSELECT
							;穿いてない
						ELSE
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 시야에 들어온 것은 비밀의 화원이었다.
							PRINTFORMDW 좋은 것을 보여준 것에 대한 감사로, 헤카티아에게 강력한 벌을 받기로 했다……
						ENDIF
					ELSEIF ABL:露出癖 <= 4
						PRINTFORML 「……보여진 건 어쩔 수 없네에」
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%~ HPH 뭔가 해둘 말 있어?」","L"
						;穿いてる
						IF TEQUIP:0 > 1
							SELECTCASE RAND:2
								CASE 0
									PRINTFORMDW "귀여운 속옷이었어"라고 칭찬해 보았지만, 돌아온 것은 뺨 세례였다…
								CASE 1
									PRINTFORMDL 어차피 고통을 볼 것이라면, 솔직한 감상을 말하겠다...
									PRINTFORMDW "그 팬티는, 좀 별로인 것 같다"
							ENDSELECT
							;穿いてない
						ELSE
							PRINTFORMDW "귀여운 엉덩이였다"라고 말하자, 헤카티아의 주먹에 단단함이 실린 듯한 기분이 들었다……
						ENDIF
					ELSE
						CALL HPH_PRINT,@"「아앗! HPH 안돼, 이런 곳에서 사정하면…… HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 치마를 들춰지는 헤카티아는 어딘가 기뻐 보인다...
						;穿いてる
						IF TEQUIP:0 > 1
							SELECTCASE RAND:2
								CASE 0
									PRINTFORMDL 마이치에게는 소박한 속옷이었다.
									PRINTFORMW (뭔가, 반응이 별로네……)
								CASE 1
									PRINTFORMDL "GoToHell"이라고 적힌 이상한 팬티야.
									PRINTFORMW 「나의 승부팬티란 걸~♪」
							ENDSELECT
							;穿いてない
						ELSE
							PRINTFORMDL 헤카티아는 팬티를 입고 있지 않았고, 가랑이 부분이 희미하게 젖어 있었다...!
							CALL HPH_PRINT,@"「후후후……♪ 들켜버렸네에…… 후훗」","L"
							CALL HPH_PRINT,@"「어때? 흥분했어...? HPH」","W"
						ENDIF
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
