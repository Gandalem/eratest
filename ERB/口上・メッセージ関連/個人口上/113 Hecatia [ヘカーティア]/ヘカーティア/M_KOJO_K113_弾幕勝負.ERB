; Modular ERB: 個人口上/113 Hecatia [ヘカーティア]/ヘカーティア/M_KOJO_K113_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;二回目以降かつ勝利済みだと純狐とピース参戦
;口上色はそのまま拝借
;共闘してる感出したかったので台詞勝手に書いてますが、ご容赦ください　問題ならOFF予定

@M_KOJO_MESSAGE_COM_K113_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;初回のみ
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「나랑 승부라고? ……후응, 한번 보자……」
			PRINTFORMDW 헤카티는 %조사처리(CALLNAME:MASTER,"를")% 품평하듯 관찰하고 있다……
			;あなた戦闘能力Ex
			IF ABL:MASTER:戦闘能力 == 6
				PRINTFORMW 「좋아라~ 상대해 줄게 %CALLNAME:MASTER%♪」
			ELSE
				PRINTFORML 「후고오카! 당신의 강함은 아직 나랑 싸울 정도는 아니야」
				PRINTFORMW 「……뭐, 팔린 시합은 사주도록 하지」
			ENDIF
			PRINTFORMDW 헤카티아가 찰칵 하고 손가락을 튕기자, 주변의 풍경이 악몽 같은 세계로 순식간에 변했다.
			PRINTFORML 「여기라면 주위를 신경 쓰지 않고 마음껏 싸울 수 있겠지?」
			PRINTFORMW 「너도…… 그리고―」
			SETCOLOR 0x2459F0
			PRINTFORML 「우리"들"도…… 라니 말이야♪」
			SETCOLOR 0xF0D124
			PRINTFORML 「드디어 %조사처리(CALLNAME:MASTER,"와")% 승부할 수 있구나. 팔이 근질거려~♪」
			PRINTFORMDW 어디선가 지구와 달을 향해 커티어도 모습을 드러냈다.
			SETCOLOR 0xC90B39
			PRINTFORMW 「……그런 거야, %CALLNAME:MASTER%. 당신에게 즐거운 선택지를 주도록 하지」
			PRINTFORMW 「이계, 지구, 달…… 죽고 싶은 몸을 스스로 골라봐!」
		ELSE
			;勝利済み
			IF CFLAG:113:弾幕勝負勝利
				PRINTFORML 「또 나랑 승부하는 거야? 너도 참 좋아라……♪」
				PRINTFORMW 「전과 똑같으면 재미없으니, 규칙을 조금 바꿔볼까~♪」
				PRINTFORMDL 헤카티어가 '파친' 하고 손가락을 튕기자 주변 풍경이 악몽 같은 세계로 바뀌었다.
				PRINTFORMDW 이전과는 달리 어째선지 순호와 클라운피스도 함께 있다……
				PRINTFORML 「어때? 관객이 있으면 기분도 한껏 달아오르잖아?」
				PRINTFORMW 「―참고로, 너희 둘도 승부에 참가할 테니 각오해」
				PRINTFORML 「이계『%TEXTR("逢魔ガ刻/地獄のノンイデアル弾幕")%』!」
				PRINTFORMDW 잘못 들은 걸까? 확인하기도 전에 헤카티어의 공격이 날아왔다!
				;まだ勝ってない
			ELSE
				PRINTFORML 「나한테 리벤지라고?」
				PRINTFORML 「그 기세 좋구만! 상대해 주도록 하지♪」
				PRINTFORMDL 헤카티아가 '파친' 하고 손가락을 튕기자, 주변의 풍경이 악몽 같은 세계로 바뀌었다.
				PRINTFORMDL 이전과 마찬가지로 지구와 달에 있는 헤카티아도 존재한다.
				PRINTFORML 「길고 장황한 서론은 생략하고……」
				PRINTFORMW 「이계, 지구, 달…… 죽고 싶은 몸을 스스로 골라봐!」
			ENDIF
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 테스트
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				IF CFLAG:113:弾幕勝負勝利
					SETCOLOR 0x2459F0
					PRINTFORML 「다음엔 지구의 내가 상대해 줄게~♪」
					PRINTFORML 「지구 『'%TEXTR("邪穢在身/地獄に降る雨")%'』!」
				ELSE
					PRINTFORML 「몸도 따뜻해졌으니…… 슬슬 "그것" 해버릴까요♪」
					PRINTFORMW 「이계 『逢魔의 순간』!」
				ENDIF
			CASE 2
				IF CFLAG:113:弾幕勝負勝利
					SETCOLOR 0xF0D124
					PRINTFORML 「네에~! 달의 나, 한 방 날려볼게~♪」
					PRINTFORML 「달 『%TEXTR("アポロ反射鏡/ルナティックインパクト")%』!」
				ELSE
					PRINTFORML 「헤에…… 그렇다면 다음은――」
					PRINTFORMW 「이계 『지옥의 논아이디얼 탄막』!」
				ENDIF
			CASE 1
				IF CFLAG:113:弾幕勝負勝利
					PRINTFORML 「%CALLNAME:MASTER%…… 마지막으로 재미있는 거 보여줄게」
					PRINTFORML 「순호~! 오랜만에 "그거" 하자♪」
					CALL M_KOJO_COLOR_K112
					PRINTFORML 「응, "그것" 말이지.」
					PRINTFORMDW 순호는 고개를 끄덕이고 헤카티어의 옆으로 이동했다.
					CALL M_KOJO_COLOR_K111
					PRINTFORML 「이, 이건 설마……!」
					PRINTFORML 「주인님과 친구님이 보여주는, 금단의...!?」
					PRINTFORMDW 두 사람의 손으로부터 클라운피스조차 떨 정도로 엄청난 에너지가 넘쳐흐르기 시작한다...!
					CALL M_KOJO_COLOR_K112
					PRINTFORML 「헤카티아, 언제라도 괜찮아」
					CALL M_KOJO_COLOR_K113
					PRINTFORMW 「오케이♪ 그럼......」
					PRINTFORML 「『최초이자 마지막 무명의 탄막』」
					CALL M_KOJO_COLOR_K112
					PRINTFORMW 「『최초이자 마지막 무명의 탄막』」
				ELSE
					PRINTFORML 「아하하하! 생각보다 대단하네, %CALLNAME:MASTER%」
					PRINTFORML 「여기서는 분위기를 좀 바꿔서…… '트리니탈리안 라프소디'」
					PRINTFORMDL 스펠카드를 선언하는 동시에 헤카티의 모습이 사라졌다...!
					PRINTFORMW 「지금부터 90초, 이 공격에서 벗어나 보란 말이야」
				ENDIF
			CASE 0
				IF CFLAG:113:弾幕勝負勝利
					PRINTFORMW 「아하하하! 당했다 당했어, 항복이야♪」
				ELSE
					PRINTFORMW 「놀랐어…… 네가 이 정도까지 할 줄은 몰랐네~♪」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【残忍酷薄】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "残忍酷薄"
	IF CFLAG:113:弾幕勝負勝利
		IF 相手残機 == 1
			CALL M_KOJO_COLOR_K111
			PRINTFORML 「내가 친구분의 몫까지 해내야지!」
			PRINTFORML 「지옥 '스트라이프 도비즈'!」
			PRINTFORMDW 클라운피스의 레이저 공격을, 순간적으로 보무를 사용해 회피했다...!
		ELSE
			SELECTCASE RAND:2
				CASE 0
					CALL M_KOJO_COLOR_K111
					PRINTFORML 「%CALLNAME:MASTER%받아라ー!」
					PRINTFORML 「지옥 『스트라이프 도버니스』!」
					PRINTFORMDL 클라운피스의 레이저 공격을, 순간적으로 봄을 사용해 회피했다...!
					CALL M_KOJO_COLOR_K113
					PRINTFORMW 「피스. 기습할 거면 조용히 해줘」
				CASE 1
					CALL M_KOJO_COLOR_K112
					PRINTFORML 「『%TEXTR("袋の鼠を追い詰める為の単純な弾幕/人を殺める為の純粋な弾幕")%』」
					PRINTFORMDL 갑자기 날아온 순호의 탄막을, 보무를 사용해서 간신히 피했어...!
					PRINTFORML 「그 상황에서 피하다니…… 대단하네 %CALLNAME:MASTER%」
					CALL M_KOJO_COLOR_K113
					PRINTFORMW (순호, 즐거워 보인다~♪)
			ENDSELECT
		ENDIF
	ELSE
		SETCOLOR 0x2459F0
		PRINTFORML 「%CALLNAME:MASTER%、%TEXTR("背中がお留守よん♪/油断したわねぇ？")%」
		PRINTFORML 「지구『%TEXTR("邪穢在身/地獄に降る雨")%』!」
		PRINTFORMDW 지구의 헤카티아의 공격을, 순간적으로 봄을 사용해 회피했다...!
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【乾坤一擲】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "乾坤一擲"
	IF CFLAG:113:弾幕勝負勝利
		IF 相手残機 == 1
			CALL M_KOJO_COLOR_K111
			PRINTFORML 「주인님! 저도 도울게요!」
			PRINTFORML 「옥부 『스타 앤 스트라이프』!」
			PRINTFORMDW 클라운피스의 스페셜 카드에 의한 격렬한 레이저 공격이다!
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「피스, 해치고 끝이야♪」
					CALL M_KOJO_COLOR_K111
					PRINTFORML 「%TEXTR("はっ！/はいっ！/がってん！")%」
					PRINTFORML 「옥부 '플래시앤스트라이프'!!」
					PRINTFORMDW 클라운피스의 스페어 카드에 의한 레이저 공격이다!
				CASE 1
					CALL M_KOJO_COLOR_K112
					PRINTFORML 「헤카티아, 나도 괜찮을까?」
					CALL M_KOJO_COLOR_K113
					PRINTFORML 「물론♪ 부탁할게 순호」
					CALL M_KOJO_COLOR_K112
					PRINTFORML 「『%TEXTR("掌の純光/純粋なる狂気/殺意の百合")%』」
					PRINTFORMDW 순호의 스페르카드로 인한 추격이 %조사처리(CALLNAME:MASTER,"를")% 덮친다!
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE RAND:2
			CASE 0
				SETCOLOR 0x2459F0
				PRINTFORML 「%TEXTR("それ、もう一丁！/私も忘れてもらっちゃ困るわよん♪/私も混ぜて頂戴な♪")%」
				PRINTFORML 「지구「'%TEXTR("邪穢在身/地獄に降る雨")%'」!」
				PRINTFORMDW 지구의 헤카티아가 추격해 왔다!
			CASE 1
				SETCOLOR 0xF0D124
				PRINTFORML 「%TEXTR("それ、もう一丁！/私も忘れてもらっちゃ困るわよん♪/私も混ぜて頂戴な♪")%」
				PRINTFORML 「달 『%TEXTR("アポロ反射鏡/ルナティックインパクト")%』!」
				PRINTFORMDW 달의 헤카티아가 추격해 왔다!
		ENDSELECT
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【怪力乱神】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "怪力乱神"
	IF CFLAG:113:弾幕勝負勝利
		IF 相手残機 == 1
			CALL M_KOJO_COLOR_K111
			PRINTFORML 「내가 주인님들을 지켜야 해!」
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「%TEXTR("獄符『地獄の蝕』/『アポロ捏造説』")%！」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 공격은 클라운피스가 불러낸 거대한 달에 가려졌다!
				CASE 1
					PRINTFORML 「옥염 『스치기의 고의』!」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 공격은 거대한 불꽃 벽에 의해 막혔다!
			ENDSELECT
			CALL M_KOJO_COLOR_K113
			PRINTFORMW 「커졌네 파이팅! 나중에 보상 줄게~♪」
		ELSE
			SELECTCASE RAND:2
				CASE 0
					CALL M_KOJO_COLOR_K111
					PRINTFORML 「주인님은 내가 지켜!」
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「%TEXTR("獄符『ヘルエクリプス』/『フェイクアポロ』")%！」
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 공격은 클라운피스가 불러낸 달에 가려버렸다!
						CASE 1
							PRINTFORML 「옥염 '그레이즈 인페르노'!」
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 공격은, 불꽃의 벽에 의해 막혔다!
					ENDSELECT
					CALL M_KOJO_COLOR_K113
					PRINTFORMW 「잘했어! 다음에도 그 기세로 부탁해~♪」
				CASE 1
					CALL M_KOJO_COLOR_K112
					PRINTFORML 「헤카르티아를 상처 입게 하진 않을 거야」
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「『원시의 신령계』」
							PRINTFORMDL 고밀도의 불꽃 탄막에 공격이 헤카티아에게 닿지 않는다!
						CASE 1
							PRINTFORML 「『떨리고 얼어붙은 별』」
							PRINTFORMDL 엄청난 탄막에 막혀 %조사처리(CALLNAME:MASTER,"의")% 공격이 닿지 않는다!
					ENDSELECT
					CALL M_KOJO_COLOR_K113
					CALL HPH_PRINT,@"「꺄아! 순호 멋져애~ HPH」","W"
			ENDSELECT
		ENDIF
	ELSE
		SETCOLOR 0xF0D124
		PRINTFORML 「%TEXTR("私がいるのを忘れてないかしら？♪/はい、残念～♪")%」
		PRINTFORML 「달『%TEXTR("アポロ反射鏡/ルナティックインパクト")%』!」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 공격은 달 쪽 캐릭터에 막혀버렸다……
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘後
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後"
	PRINTFORML 
	;残り残機4が表示されうるのは【洽覧深識】持ちのみ
	;残機が1以上ならあなたの負け、0の場合はあなたの勝利
	IF CFLAG:113:弾幕勝負勝利
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 4
				PRINTFORMW 「아하하하! 미안미안, 잠깐 놀아본 것뿐이야~」
			CASE 3
				SETCOLOR 0x2459F0
				PRINTFORMW 「저 상황에서 한 방 맞춘 것만으로도 충분하지 않아? %CALLNAME:MASTER%♪」
			CASE 2
				SETCOLOR 0xF0D124
				PRINTFORMW 「역시 3대 1…… 아니, 5대 1은 힘들었을까?」
			CASE 1
				PRINTFORML 「어때? 우리 컨비네이션 정말 멋졌지?」
				PRINTFORMW 「……있잖아, 왜 그렇게 무서운 얼굴 해. 그냥 농담이었는데♪」
			CASE 0
				;あなた勝利
				PRINTFORML 「이야아……. 저런 상황에서 이길 수 있었네, %조사처리(CALLNAME:MASTER,"는")%」
				PRINTFORML 「…안녕. 무서운 표정 지으면 안 돼. 그냥 좀 놀아봤을 뿐이야♪」
				PRINTFORMDW 지쳐버린 %조사처리(CALLNAME:MASTER,"는")%, 잠시 그 자리에서 휴식을 취했다……
		ENDSELECT
	ELSE
		SELECTCASE 相手残機
			CASE 4
				PRINTFORMW 「당신 말이야…… 적어도 한 방쯤 맞춰보라고」
			CASE 3,2
				PRINTFORMW 「방금 일은 없었던 걸로 해드려야 해요…… 안 돼읏♪」
			CASE 1
				PRINTFORMW 「아하하하! 아깝네~♪」
			CASE 0
				PRINTFORML 「내가 졌네. 축하해 %CALLNAME:MASTER%」
				IF ABL:MASTER:戦闘能力 <= 5
					;ズルい事したら反応する奴　自力で倒せた人はゴメンナサイ
					PRINTFORML (……뭔가 납득이 안 가긴 하지만, 지는 건 지는 거니까 어쩔 수 없네……)
