						CALL HPH_PRINT,@"「응구으……! 나, 여신인데...! %조사처리(CALLNAME:MASTER,"의")% 주인님인데 말이야... 큭」","L"
						PRINTFORMDW 이 체위에서는 헤카티아의 표정은 알 수 없지만, 오히려 상상하게 되어서 흥분한다...!
					CASE 1
						CALL HPH_PRINT,@"「응읏...! 아...앗...흐으윽..! 이...아! 아아...앗...흐으윽」","L"
						PRINTFORMDW 엉덩이 깊숙한 곳을 쿵쿵 밀어 올리자, 헤카티아의 목소리에 색기가 섞이기 시작했다...!
					CASE 2
						CALL HECA_SEX
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ａ感覚４以上
	ELSEIF ABL:Ａ感覚 >= 4
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「그렇게 주인님의 엉덩이 구멍이 마음에 들었어?…… 어쩔 수 없네에……. HPH」","L"
				CALL HPH_PRINT,@"「응...윽...흐읍...! 아...아아...큭」","L"
				PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"에게")% 안긴 채 허리를 숙이고, 항문으로 페니스를 집어삼켰다...!
			CASE 1
				CALL HPH_PRINT,@"「봐…… 더 단단하게 나를 안아줘…… 흐으응」","L"
				CALL HPH_PRINT,@"「응읏...♪ 그럼... 후... 아앗, 하으읍... 하으읍, 거시기... 하으읍, 안 돼야 할 곳에이윽... 하으읍 하으읍」","L"
				PRINTFORMDW 헤카티아와 평소보다 더 밀착한 채, 질구보다 뒤쪽 구멍으로 삽입했다...!
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「저기 말이야...! 내 엉덩이를 뭘로...」
				CALL HPH_PRINT,@"「잠깐!? 그만해애애아아앙! 히끅 히끅 히끅」","L"
				PRINTFORMDW 비명과도 같은 엄청난 신음을 들으며, 헤카티아의 항문에 삽입했다...!
			CASE 1
				PRINTFORML 「크으윽...! 왜 내가 이런 곳에……」
				CALL HPH_PRINT,@"「헉...! 아, 큭... 하프 후우으윽... 헉 헉」","L"
				PRINTFORMDW 헤카티아는 천천히 숨을 내쉬며 허리를 숙이고, 자신의 항문에 페니스를 삽입했다...!
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
