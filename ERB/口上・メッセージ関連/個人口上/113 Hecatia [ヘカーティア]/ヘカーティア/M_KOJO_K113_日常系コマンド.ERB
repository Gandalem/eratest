@M_KOJO_MESSAGE_COM_K113_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR 0xC90B39
	IF CFLAG:睡眠
		PRINTFORML 「그으음…… Zzz……」
		PRINTFORMDW 헤카티아를 깨우지 않도록 조용히 그녀의 방을 뒤로 했다……
	ELSEIF CFLAG:MASTER:初期位置 == CFLAG:113:初期位置 && CFLAG:MASTER:現在位置 == CFLAG:113:初期位置
		;川の字で寝る
		IF TFLAG:193 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「자자…… 어서 자야지, %CHILDNAME:113:(TALENT:113:育児中)%……♪」
					PRINTFORMDL %CHILDNAME:113:(TALENT:113:育児中)%를 사이에 두고 헤카티와 침대에 들었다.
					PRINTFORMDW 좌우에서 머리를 쓰다듬어지자, %CHILDNAME:113:(TALENT:113:育児中)%는 기분 좋게 눈을 감고 잠들었다……
				CASE 1
					CALL HPH_PRINT,@"「후후……♪%CHILDNAME:113:(TALENT:113:育児中)%……흐읍」","L"
					PRINTFORMDL 카르티아는 %CHILDNAME:113:(TALENT:113:育児中)%를 안고 행복해 보이는 잠든 얼굴을 하고 있다.
					PRINTFORMDW 한편 %CHILDNAME:113:(TALENT:113:育児中)%는, 조금 잠들기 힘들어 보인다……
				CASE 2
					PRINTFORML 「아라? …… 아빠, 잠들어 버렸네……♪」
					PRINTFORML 「……있잖아 %CHILDNAME:113:(TALENT:113:育児中)% , 아빠 좋아해?」
					CALL HPH_PRINT,@"「그래요…… ♪ 엄마도 아빠가 제일 좋아 HPH」","W"
			ENDSELECT
		ELSEIF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후후후……♪ 오늘 밤은 재워주지 않을 거야, %CALLNAME:MASTER%……HPH」","L"
					PRINTFORML 「오늘 밤은 아침까지 마음껏……」
					PRINTFORML 「꾸우~……Zzz……」
					PRINTFORMDW 헤카티어는 잠들어 버렸다.
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%, 침대 정리 다 했어?」
					PRINTFORML 「……오케이, 아주 훌륭해! 그럼 자자♪」
					PRINTFORMDW 폰폰 하고 자신의 옆을 두드리는 헤카티의 말에 응하여 함께 잠들기로 했다.
				CASE 2
					PRINTFORML 「있지? %CALLNAME:MASTER%. 주인님을 제대로 재워야 해~♪」
					PRINTFORMDW 헤카티아 옆에 누워, 잠이 올 때까지 이야기를 나누었다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%, 나의 곁에서 잠들 수 있는 것을 영광으로 여겨라♪」
					PRINTFORMDW 오늘 밤은 헤카티아와 함께 자기로 했다.
				CASE 1
					PRINTFORML 「응우…… 크으~……♪」
					PRINTFORMDW 몸을 뒤척인 カーティアの裏拳が腹に直撃した……
				CASE 2
					PRINTFORML 「나를 도중에 깨우면 용서 안 해…… 그럼, 잘 자」
					PRINTFORMDW 헤카티아는 눈을 감고 잠꼬대를 하기 시작했다.
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE RAND:3
			CASE 0
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「주인님보다 먼저 잠들다니, 감동이 없네…….」
					PRINTFORMW 「……뭐, 오늘은 용서해 주도록 할게요. 잘 자요♪」
				ELSE
					PRINTFORML 「벌써 자는 거야? 시시하네에……」
					PRINTFORMDW 헤카티아는 돌아갔다.
				ENDIF
			CASE 1
				PRINTFORML 「잘 자, %CALLNAME:MASTER%」
				PRINTFORMW 「내일도 즐거운 거 해요~♪」
			CASE 2
				PRINTFORML 「그렇단 말이야 %CALLNAME:MASTER%, 우리 자장가를 불러줄게~♪」
				SETCOLOR 0x2459F0
				PRINTFORML 「다행이네~ 자장가 삼중주라니, 그렇게 쉽게 들을 수 있는 건 아닐 텐데?」
				SETCOLOR 0xF0D124
				CALL HPH_PRINT,@"「오늘 밤은 푹 잘 수 있겠네, %CALLNAME:MASTER%읏」","L"
				PRINTFORMDW 이 후, %조사처리(CALLNAME:MASTER,"는")% 악몽에 시달렸다……
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
