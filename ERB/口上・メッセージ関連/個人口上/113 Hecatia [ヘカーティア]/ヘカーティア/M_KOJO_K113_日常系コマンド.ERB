@M_KOJO_MESSAGE_COM_K113_301
CALL M_KOJO_MESSAGE_COM_K113_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		PRINTFORML 「흠~…… 뭐, 받아두도록 하지」
		PRINTFORMDW 헤카티아는 의심스러운 표정으로 차를 받았다.
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:3
			CASE 0
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「싫어, 맛있다~♪」
						PRINTFORML 「%CALLNAME:MASTER%! 리필 준비해 줘」
					CASE 1
						PRINTFORML 「온도, 향, 맛……」
						PRINTFORML 「어느 것을 따도 훌륭한, 좋은 차네요... ♪」
					CASE 2
						PRINTFORML 「후우…… 마음이 놓인다아……♪」
					CASE 3
						PRINTFORML 「잘 먹었어. 다음에도 기대하고 있을게~♪」
				ENDSELECT
				PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 차를 아주 마음에 들어 한 것 같아.
			CASE 1
				PRINTFORML 「%TEXTR("ズズ/ごくっ/ずずーっ")%……」
				SETCOLOR 0x2459F0
				PRINTFORML 「%TEXTR("ズズ/ごくっ/ずずーっ")%……」
				SETCOLOR 0xF0D124
				PRINTFORML 「%TEXTR("ズズ/ごくっ/ずずーっ")%……」
				SETCOLOR 0xC90B39
				PRINTFORML 「맛있어~♪」
				SETCOLOR 0x2459F0
				PRINTFORML 「있잖아♪ 마음이 놓인다」
				SETCOLOR 0xF0D124
				PRINTFORML 「%CALLNAME:MASTER%! 리필~♪」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 차는 헤카티아 일행에게 호평을 받았다.
			CASE 2
				PRINTFORML 「그럼 시작할게…… 하나 둘 셋―」
				PRINTFORML 「%TEXTR("あー…何も無いわねぇ/あったわ茶柱♪")%」
				SETCOLOR 0x2459F0
				PRINTFORML 「%TEXTR("ざーんねん、何も無かったわ……/あら茶柱だわ♪")%」
				SETCOLOR 0xF0D124
				PRINTFORML 「%TEXTR("んもう、茶柱が無いじゃない/茶柱あったわよん♪")%」
				PRINTFORMDW 헤카티아 일행은 차 씨의 유무에 일희일비하고 있다... 정말 즐거워 보인다.
		ENDSELECT
	ELSEIF TFLAG:193 == 0
		SELECTCASE RAND:2
			CASE 0
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「음~ 좋은 향이네♪ 제법 괜찮은 차 잎을 쓰는 건가 봐?」
					CASE 1
						PRINTFORML 「고오카쿠! 정말 맛있는 차네~ ♪」
					CASE 2
						PRINTFORML 「하아~…… ♪ 안심되는 맛이네…… ♪」
					CASE 3
						PRINTFORML 「맛있다~ 더 먹을 수 있어?」
				ENDSELECT
				PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 차를 마음에 들어 한 모양이다.
			CASE 1
				PRINTFORML 「%TEXTR("ズズ/ごくっ/ずずーっ")%……」
				SETCOLOR 0x2459F0
				PRINTFORML 「%TEXTR("ズズ/ごくっ/ずずーっ")%……」
				SETCOLOR 0xF0D124
				PRINTFORML 「%TEXTR("ズズ/ごくっ/ずずーっ")%……」
				SETCOLOR 0xC90B39
				PRINTFORML 「음…… 어때?」
				SETCOLOR 0x2459F0
				PRINTFORML 「뭐랄까, 그런 느낌이랄까」
				SETCOLOR 0xF0D124
				PRINTFORML 「합격점이라는 건 어디쯤일까나……」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 차는 헤카티아 일행으로부터 적지 않은 평가를 받았다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「밍밍한 차네……. 좀 더 뜨거운 게 마시고 싶어」
					CASE 1
						PRINTFORML 「음~ ……이건 안 맞네」
						PRINTFORML 「다음부터는 다른 걸 해줘얨」
					CASE 2
						PRINTFORML 「후르륵―캬아악」
				ENDSELECT
				PRINTFORMDW 헤카티아는 차를 마음에 들어 하지 않은 모양이네…….
			CASE 1
				PRINTFORML 「맞아, 맞아♪ 나는 이렇게 불타는 지옥처럼 뜨거운 게 취향이라서……」
				PRINTFORML 「― 정도라는 걸 모르는 걸까? 당신은」
