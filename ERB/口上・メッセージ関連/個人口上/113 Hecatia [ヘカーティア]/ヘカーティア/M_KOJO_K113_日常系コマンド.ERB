;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K113_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K113_300
RETURN 0

@M_KOJO_MESSAGE_COM_K113_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K113_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K113_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初回会話
	IF FIRSTTIME(SELECTCOM)
		SETCOLOR 0xF0D124
		PRINTFORML 「자아, 오늘은 뭘 하면서 놀까~」
		PRINTFORMDL 빨간색이었던 헤카티의 머리카락이 어느새 금색으로 변해 있었다.
		PRINTFORMDW 이것이 헤카티의 능력인 걸까……?
		SETCOLOR 0xC90B39
		PRINTFORML 「뭐야 %CALLNAME:MASTER%? 혹시 나한테 반했던 거야?」
		SETCOLOR 0x2459F0
		PRINTFORML 「뭐嬉しい♪ 용모를 칭찬받는 건 나쁘지 않네에」
		PRINTFORMDL 아는 얼굴의 붉은 머리 헤카티와, 새로 등장한 푸른 머리의 헤카티도 나타났다.
		PRINTFORMDW 상황을 이해하지 못하고 혼란스러워하는 %조사처리(CALLNAME:MASTER,"에게")%, 헤카티는 손가락을 들고 설명을 시작했다.
		SETCOLOR 0xC90B39
		PRINTFORMW 「나는 이계, 지구, 달... 세 세계의 지옥을 관리하기 위해 각 세계에 육체를 가지고 있다」
		PRINTFORML 「당신과 처음 만난 내가, "이계"... 즉 환상향의 나이다」
		SETCOLOR 0x2459F0
		PRINTFORML 「만나는 건 처음이었다. 나는 "지구"의 헤카티아이다」
		SETCOLOR 0xF0D124
		PRINTFORMW 「그리고... 당신의 눈앞에 있는 것이 "달"의 나이다」
		PRINTFORMW 「평소라면 이런 식으로...」
		SETCOLOR 0xC90B39
		PRINTFORMW 「머릿속을 바꿔봐」
		SETCOLOR 0x2459F0
		PRINTFORMW 「육체를 바꾸는 거지만……」
		SETCOLOR 0xC90B39
		PRINTFORML 「그럴 마음이 있다면……」
		SETCOLOR 0x2459F0
		PRINTFORML 「세 명 동시에」
		SETCOLOR 0xF0D124
		PRINTFORML 「나도 나올 수 있다구~♪」
		PRINTFORMDW 복장에 뒤지지 않을 정도로 특이한 능력이다…….
		;教養足りない
	ELSEIF TFLAG:193 == -2
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")% 부족한 거?」
				PRINTFORML 「음, 그렇네. 굳이 말하자면……」
				PRINTFORMDW 헤카티아에게 머리를 톡 두드려졌다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%。당신의 이야기는, 재미없다는 것 이전에 의미가 파악되지 않는다」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 교양이 부족하여, 대화가 통하지 않는다.
			CASE 2
				PRINTFORML 「제 머리에 있는 이게 뭔지, 라고요?」
				PRINTFORML 「그것부터는 우선 우주의 탄생부터 설명해야겠네. 지금부터 약――」
				PRINTFORMDW 교양이 부족한 %조사처리(CALLNAME:MASTER,"는")% 헤카르티아의 이야기를 전혀 이해하지 못했다……
		ENDSELECT
		;怒り
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「...뭔가 말했나? 못 들었네」
		PRINTFORMDW 헤카티아는 기분이 안 좋은 듯하다……
		;喋りすぎ
	ELSEIF TCVAR:302
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「아~... 너무 많이 말해서 목이 마르네...」
				PRINTFORMDW 헤카티아에게 차라도 내려볼까...
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%. 나는 지금, 아주 지루해하고 있어」
				PRINTFORML 「뭐라도 재미있는 거 해줘 봐~」
				PRINTFORMDW 헤카티아에게 무리한 부탁을 받았다……
			CASE 2
				PRINTFORML 「...자. 슬슬 외출이라도 할까요」
				PRINTFORMDW 헤카티아는 어딘가에 가고 싶은 모양이다……
			CASE 3
				PRINTFORML 「하아후……응, 듣고 있어~」
				PRINTFORMDW 수다 떨기에 질렀는지 헤카티아는 하품을 하고 있다……
		ENDSELECT
		;酔っ払い時会話
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%~HPH 이쪽으로 와서, 주인님을 즐겁게 해드려야지이용~HPH HPH」","L"
					PRINTFORMDW 헤르티아가, 살랑거리며 손짓하고 있어……
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%~♪ 마셔주는 거야??」
					PRINTFORMDW 헤카티아는 비틀거리고 있다……
				CASE 2
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%……오늘은 속풀이 시간이야」
					PRINTFORML 「쌓여 있는 푸념 같은 거, 전부 다 토해버려 봐♪」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 웃으며 얼버렸다……
				CASE 3
					CALL HPH_PRINT,@"「순호아, 사랑해에~ HPH 쓰담쓰담이~ HPH」","L"
					PRINTFORML 「……어라? 뭔가, 가슴 축 늘어지지 않았어?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 순호로 착각하고 있는 모양이네……
				CASE 4
					PRINTFORML 「피스우~…… 볼이 평소보다 단단하잖아용……?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 클라운피스로 착각하고 있는 것 같다……
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「시끄럽네에~, 안 됐잖아읏♪」
					PRINTFORMDW 취기가 오른 건지 헤카티아의 얼굴이 새빨갛게 물들어 있다……
				CASE 1
					PRINTFORML 「아하하하하하하♪」
					PRINTFORMDW 헤카티아가 갑자기 웃기 시작했다……
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%~……적당히 하지 않으면, 순호에게 꾸중을 들 거야~……」
					PRINTFORMDW 상당히 취한 모양이다……
				CASE 3
					CALL HPH_PRINT,@"「순호옷~ 더 마시자구우~ HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 순호로 착각하고 있는 것 같아……
				CASE 4
					CALL HPH_PRINT,@"「피스~♪ 주인님께 춤 보여주고 싶다아♡」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 클라운피스로 착각하고 있는 것 같아…….
			ENDSELECT
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%~, 얼굴이 빨개졌잖아~♪」
					PRINTFORML 「벌써 취하다니, 아직 순진하네~♪」
					PRINTFORMDW 그렇게 말하는 헤카티아도 볼이 상기되어 있다.
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%, 안주 없어?」
					PRINTFORML 「흥, 눈치 없네에……」
					PRINTFORMDW 어째선지 혼나버렸다……
				CASE 2
					PRINTFORML 「이 정도로는, 마신 사람들의 영역에 못 들어와요」
					PRINTFORML 「%CALLNAME:MASTER%―! 한 잔 더~♪」
					PRINTFORMDW 헤카티아는 아직 술을 더 마시고 싶어 하는 것 같다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「언젠가 이 술을, 승리의 미주로 만들고 싶네……♪」
				CASE 1
					PRINTFORML 「……당신, 술이 들어가면 조용해지는구나아」
					PRINTFORML 「모처럼 같이 마시고 있는 거니까, 좀 더 수다 떨어요옹」
				CASE 2
					PRINTFORML 「헤에…… 당신, 제법 잘 맞는 구멍이네~♪」
			ENDSELECT
			PRINTFORMDW 헤카티아와 술을 마시며 이야기를 나누었다.
		ENDIF
	ELSEIF TALENT:恋人
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL HECA_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL HECA_KOIBITO
						CASE 1
							CALL HECA_OTENKI
						CASE 2
							CALL HECA_SEASON
						CASE 3
							CALL HECA_FREETALK
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:7
				CASE 0
					CALL HECA_FREETALK
				CASE 1
					CALL HECA_KOIBITO
				CASE 2
					CALL HECA_SEASON
				CASE 3
					CALL HECA_OTENKI
				CASE 4
					CALL HECA_CP_TALK
				CASE 5
					CALL HECA_JUNKO_TALK
				CASE 6
					PRINTFORML 「%CALLNAME:MASTER%―, 주인님 심심해~」
					PRINTFORMDW 헤카티아를 데리고 어디론가 나가 볼까…….
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL HECA_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL HECA_RENBO
						CASE 1
							CALL HECA_OTENKI
						CASE 2
							CALL HECA_SEASON
						CASE 3
							CALL HECA_FREETALK
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:7
				CASE 0
					CALL HECA_FREETALK
				CASE 1
					CALL HECA_RENBO
				CASE 2
					CALL HECA_SEASON
				CASE 3
					CALL HECA_OTENKI
				CASE 4
					CALL HECA_CP_TALK
				CASE 5
					CALL HECA_JUNKO_TALK
				CASE 6
					PRINTFORML 「%CALLNAME:MASTER%―, 주인님 심심해~」
					PRINTFORMDW 헤카티아를 데리고 어디론가 나가 볼까…….
			ENDSELECT
		ENDIF
	ELSEIF TALENT:思慕
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL HECA_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL HECA_SHIBO
						CASE 1
							CALL HECA_OTENKI
						CASE 2
							CALL HECA_SEASON
						CASE 3
							CALL HECA_FREETALK
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:7
				CASE 0
					CALL HECA_FREETALK
				CASE 1
					CALL HECA_SHIBO
				CASE 2
					CALL HECA_SEASON
				CASE 3
					CALL HECA_OTENKI
				CASE 4
					CALL HECA_CP_TALK
				CASE 5
					CALL HECA_JUNKO_TALK
				CASE 6
					PRINTFORML 「%CALLNAME:MASTER%―, 주인님 심심해~」
					PRINTFORMDW 헤카티아를 데리고 어디론가 나가 볼까…….
			ENDSELECT
		ENDIF
	ELSE
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL HECA_NORMAL
				CASE 1
					CALL HECA_OTENKI
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					CALL HECA_NORMAL
				CASE 1
					CALL HECA_OTENKI
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
