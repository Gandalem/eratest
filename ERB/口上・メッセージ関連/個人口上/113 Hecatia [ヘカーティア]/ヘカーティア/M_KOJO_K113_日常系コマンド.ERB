LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠フラグ
	IF CFLAG:睡眠
		PRINTFORML
		RETURN 1
	ELSEIF CFLAG:TARGET:添い寝中
		CALL HPH_PRINT,@"「충분히 귀여워해 줄게…… %CALLNAME:MASTER%……후훗」","L"
		PRINTFORMDW 정말로 자고 있는 걸까……?
	ELSE
		SELECTCASE TFLAG:193
			CASE 0
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 눈을 뜨자, 헤카티에게 안겨 있었다.
				IF TALENT:恋慕 || TALENT:思慕
					CALL HPH_PRINT,@"「안녕 HPH」","L"
					CALL HPH_PRINT,@"「후훗……♪ 주인님 옆에서 낮잠 자는 기분은 어떠신가요…… HPH」","W"
				ELSE
					PRINTFORML 「어머, 일어났어? 안녕♪」
					PRINTFORMW 「피스 정도는 아니지만, 나쁘지 않은 포옹이었어~♪」
				ENDIF
			CASE 1
				PRINTFORMDL 다리에 이상한 무게감을 느끼고 눈을 떴다……
				PRINTFORMDL 압박감의 정체는 %조사처리(CALLNAME:MASTER,"의")% 무릎을 베고 있는 헤카티아인 듯하다.
				PRINTFORML 「%CALLNAME:MASTER%, 이렇게 딱딱한 무릎으로는 잠을 잘 수가 없어. 어떻게 좀 해줘」
				PRINTFORMDW 잠에서 깨자마자 부당한 요구를 받아 우울한 기분이 되었다……
			CASE 2
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORMDL 입술에 무언가 부드러운 것이 닿는 감각으로 눈을 떴다.
					CALL HPH_PRINT,@"「잘 자요. 키스야 HPH 눈이 떠졌을까?」","W"
				ELSE
					PRINTFORMDL 볼에 무언가 부드러운 것이 닿는 느낌으로 눈을 떴다.
					PRINTFORML 「아라, 일어났어? 안녕」
					PRINTFORMW 「…………♪」
				ENDIF
			CASE 3
				PRINTFORMDL 어느새 잠들어 있었던 모양이다……. %조사처리(CALLNAME:MASTER,"는")% 천천히 눈을 뜨고―
				PRINTFORML 「오 하요우♪」
				PRINTFORML 「아하하하하! 좋은 반응이네~♪」
				PRINTFORMDW 밀착 직전까지 다가온 헤커티아의 얼굴에 놀라 나도 모르게 비명을 질렀다……
			CASE 4
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「안녕~♪」
					CALL HPH_PRINT,@"「주인님한테 무릎 베개로 누워 있다니, 당신은 행복한 사람이네…… 후후」","W"
				ELSE
					PRINTFORML 「고오~... 요~... 사앙...」
					PRINTFORMDL 어느새 잠들어 있었던 모양이다......
					PRINTFORMDL 후두부에 부드러운 감촉을 느끼며, %조사처리(CALLNAME:MASTER,"는")% 천천히 눈을 뜨는데―
					PRINTFORML 「니이... 이치...」
					PRINTFORMW 「아라, 아쉽네♪ 조금만 더 있었으면 당신 얼굴에 %TEXTR("地球/月")%를 떨어뜨릴 수 있었을 텐데……」
				ENDIF
			CASE 5
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORMDL 뭔가 사타구니가 간지러워……. %조사처리(CALLNAME:MASTER,"는")% 천천히 눈을 떴다.
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……좋은 아침 HPH」","L"
					CALL HPH_PRINT,@"「일단…… 잠에서 깨자마자 한 방, 갈까? HPH」","L"
					PRINTFORMDW 헤카티아는 %조사처리(CALLNAME:MASTER,"의")% 사타구니를 손가락으로 쓸어내리며, 요염한 미소를 짓고 있다...!
				ELSE
					PRINTFORMDL 언제 잠이 들었는지, %조사처리(CALLNAME:MASTER,"는")% 천천히 눈을 떴다.
					PRINTFORML 「아라, %CALLNAME:MASTER%. 일어……」
					PRINTFORML 「―훗…… 젊으시네에……♪」
					PRINTFORMDW 헤카티에게 "잠에서 깬 생리 현상"을 들켜버렸다…….
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
