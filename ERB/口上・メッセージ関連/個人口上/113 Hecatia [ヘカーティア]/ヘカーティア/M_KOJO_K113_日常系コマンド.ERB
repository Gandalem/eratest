;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		;睡眠フラグ
	ELSEIF CFLAG:睡眠
		PRINTFORMDL 
		PRINTFORMDW 헤카티아를 깨우지 않도록, %조사처리(CALLNAME:MASTER,"는")% 조용히 독서를 했다.
		;ブチギレ
	ELSEIF CFLAG:318 == 1
		PRINTFORMDW 견딜 수 없게 된 %조사처리(CALLNAME:MASTER,"는")%, 독서를 하며 마음을 달래기로 했다……
	ELSEIF TFLAG:193
		SELECTCASE TFLAG:193
			CASE 6,7,8;エッチな本
				PRINTFORMDL 헤르티아는 수상한 책을 읽고 있는 듯하다.
				PRINTFORMDW …궁금해진 %조사처리(CALLNAME:MASTER,"는")% 몰래 내용을 엿보기로 했다.
				SELECTCASE RAND:6
					CASE 0
						PRINTFORML (BL이라 꽤 재미있네에……♪)
						PRINTFORMDW 근육질 남성으로 변해버린 %조사처리(CALLNAME:MASTER,"가")%, 린노스케와 장미꽃을 피우고 있었다……
					CASE 1
						PRINTFORML (왜 나한테 이런 게 있는 걸까……?)
						PRINTFORMDW 건장한 음경을 만들어낸 헤카티아가 레이무 일행을 덮치고 있었다……
					CASE 2
						PRINTFORML (보잘것없는 순호네…… 진짜 발밑에도 미치지 못하는구나)
						PRINTFORMDW 순호라고 생각되는 여성이 가슴을 만지고 있었다……
					CASE 3
						PRINTFORML (현실에서는 클라운피스에게 못 이기니까, 적어도 만화 속에서는 그렇겠지……)
						PRINTFORMDW 클라운피스가 수많은 남성들에게 둘러싸여 괴롭힘을 당하고 있었다……
					CASE 4
						PRINTFORML (이건 해석의 차이야. 저 아이는 틀림없이 M이라고)
						PRINTFORMDW 에이키가 남성의 가랑이를 짓밟으며, 경멸하는 듯한 눈으로 욕설을 내뱉고 있었다……
					CASE 5
						PRINTFORML 「……뭐야? 훔쳐보는 거, 취미 없어」
						PRINTFORMDW 헤카티아와 눈이 마주쳤다……
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:7
					CASE 0
						PRINTFORML 「푸흡...! 크크...」
						PRINTFORMDW 헤카티아는 웃음을 참으며 만화책을 읽고 있다.
					CASE 1
						PRINTFORML (이거 맛있겠다아…… 다음에 순호한테 만들어 달라고 해야겠네)
						PRINTFORMDL 헤카티아는 요리책을 읽고 있다.
						PRINTFORMDW 페이지를 넘기는 속도로 보아, 아마 사진만 보고 있을 것이다…….
					CASE 2
						PRINTFORML (지옥 티셔츠의 시대는 언제 오는 걸까……)
						PRINTFORMDW 헤카티아는 패션 잡지를 읽으며 한숨을 쉬고 있다…….
					CASE 3
						PRINTFORML (거짓말을 하면 염라대왕님께 혀를 뽑히는 건가……)
						PRINTFORML (에이키, 야만적이야~♪)
						PRINTFORMDW 헤카티아는 아이들을 위한 그림책을 읽고 있다.
					CASE 4
						PRINTFORML (여신 헤카테에게 랜파스인가……)
						PRINTFORML (왠지 남의 기분이 아닌 것 같네……♪)
						PRINTFORMDW 헤카티아는 그리스 신화 사전(典)을 읽고 있다.
					CASE 5
						PRINTFORML 「%CALLNAME:MASTER%. 그런 책보다 이거 읽으세요」
						PRINTFORML 「이 만화에 나오는 클라운피스, 엄청 귀엽지 않아?」
						PRINTFORMDW 헤카티어가 보여준 만화에는 클라운피스와 서니밀크 일행의 활약이 그려져 있었다.
					CASE 6
						PRINTFORML 「……뭐야? 훔쳐보는 거, 취미 없어」
						PRINTFORMDW 헤카티아와 눈이 마주쳤다……
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
