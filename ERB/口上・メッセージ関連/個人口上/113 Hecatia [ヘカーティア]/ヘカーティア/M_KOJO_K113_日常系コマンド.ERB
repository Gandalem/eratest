@M_KOJO_MESSAGE_COM_K113_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		PRINTFORMDW 헤카티아를 깨우지 않도록 조용히 청소를 했다.
	ELSEIF FLAG:時間停止
		PRINTFORMDW 정지된 시간 속에서 청소를 했다. 능력의 유효 활용이라는 것이지.
	ELSEIF CFLAG:113:うふふ
		PRINTFORMW 「……당신, 혹시 강박증이야?」
		;一緒に掃除
	ELSEIF TFLAG:193 == 1
		;ブチギレ
		IF CFLAG:318 == 1
			PRINTFORML 「네, 나중에 잘 부탁드려요」
			PRINTFORMDW 헤카티아는 서둘러 청소를 마쳤다.
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「정말, 왜 내가 이런 걸……」
					PRINTFORMDW 불평을 하면서도 아야는 청소를 도와주었다.
				CASE 1
					PRINTFORML 「나한테 노동을 시키다니……」
					PRINTFORML 「%CALLNAME:MASTER%, 나중에 후회해라……」
					PRINTFORMDW 헤카티에게 노려지는 가운데, 함께 청소를 했다.
				CASE 2
					PRINTFORML 「에에! 저도 할 거예요!?」
					PRINTFORML 「……흥, 알았다고……」
					PRINTFORMDW 헤카티와 함께 청소를 했다.
			ENDSELECT
		ENDIF
		;見てるだけ
	ELSE
		IF CFLAG:318 == 1
			PRINTFORML 「%CALLNAME:MASTER%, 손이 멈춰있잖아」
			PRINTFORMDW 기분이 안 좋은 헤카티아에게 지켜보히며 청소를 했다…….
			;汚れ高
			IF TFLAG:194 >= 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「정말, 누가 청소할 거라고 생각하는 거야……. 응? %CALLNAME:MASTER%?」
					CASE 1
						PRINTFORML 「더럽네에…… 지옥이라도 여기만큼은 아니야」
					CASE 2
						PRINTFORML 「더러워! 발 디딜 곳도 없잖아!」
						PRINTFORML 「%CALLNAME:MASTER%, 어서 치우고 정리해 봐」
				ENDSELECT
				PRINTFORMDW 헤카티이에게 지켜받으며 청소를 했다.
			ENDIF
			;汚れ中以下
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이봐 %CALLNAME:MASTER%! 거기에도 쓰레기 떨어져 있어」
				CASE 1
					PRINTFORML 「오~ 점점 깨끗해지고 있네……♪」
				CASE 2
					PRINTFORML 「그만하고, 어서 놀러 가자♪」
			ENDSELECT
			PRINTFORMDW 헤카티이에게 지켜받으며 청소를 했다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
