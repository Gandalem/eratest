@M_KOJO_MESSAGE_COM_K113_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			IF TFLAG:193 == -1
				PRINTFORML 「후후후……♪ 뭘 생각하는 거야?」
				PRINTFORMDW 의미심장한 미소를 지으면서도, 얼버무려졌다…….
			ELSE
				SELECTCASE RAND:6
					CASE 0
						PRINTFORML 「…………♪」
						PRINTFORMDL 카티아가 가만히 이곳을 응시하며 웃고 있다.
						PRINTFORMDW 무언가 말할 수 없는 공포를 느낀 %조사처리(CALLNAME:MASTER,"는")%, 경련하는 듯한 作り笑いを 되돌려주었다.
					CASE 1
						PRINTFORML 「항아에게 어떤 고문을 해줄까 생각하고 있었어」
						PRINTFORML 「꼬챙이에 꿰뚫기, 채찍질…… 불에 지지거나 물로 괴롭히는 것도 좋겠네♪」
						PRINTFORMDW 침착한 얼굴로 무서운 것을 생각하고 있었다…….
					CASE 2
						PRINTFORML 「새로운 티셔츠 디자인이야♪」
						PRINTFORML 「일단 세 개 정도 생각해 봤는데, 어떤 게 좋을까?」
						PRINTFORMDW 내민 종이에 그려진 티셔츠 그림을 보았다. 전부 이상한 디자인이다……
					CASE 3
						PRINTFORML 「물론 당신을 말하는 거야?」
						PRINTFORML 「오늘은 어떤 걸 하며 놀아줄까……♪」
						PRINTFORMDW 특별히 대단한 건 생각하고 있지 않았던 것 같다……
					CASE 4
						PRINTFORML 「순호의 별명을 생각하고 있었어」
						PRINTFORML 「그 아이만 아무것도 없는 건, 뭔가 외롭잖아」
						PRINTFORMDW %CALLNAME:MASTER%도 함께 생각하기로 했다.
					CASE 5
						PRINTFORML 「피스의 새로운 안무를 생각하고 있었거든」
						PRINTFORML 「%CALLNAME:MASTER%, 한번 해봐」
						PRINTFORMDW 엄청 부끄러운 춤을 추게 됐어……
				ENDSELECT
			ENDIF
		CASE 1
			;▼遊ぶ［一緒に遊ぶ］
			;※[幼稚]持ちのみ
			;TFLAG:193,1=大いに盛り上がる,-1=あまり盛り上がらない
			;PRINTFORMW
		CASE 2
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			IF TFLAG:193 == -1
				PRINTFORML 「그렇게 망설이지 않아도 돼♪」
				PRINTFORMDW 음식을 입에 밀어 넣었다…….
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「잘 먹네, 너」
					CASE 1
						PRINTFORMW 「그렇게까지 말한다면 나눠 줄게」
				ENDSELECT
			ENDIF
		CASE 3
			;▼つまみ食い［一緒につまみ食い］
			;※[妖精]持ちとルーミア、こいし、幽々子、紫苑のみ
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			;PRINTFORMW
		CASE 4
			;▼掃除［掃除を手伝う］
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			PRINTFORML 「%TEXTR("はい、頑張って～♪/ほら、そこにゴミ落ちてるわよ/はーい！きびきび動く！")%」
			PRINTFORMDW 헤카티아는 아무것도 하고 있지 않아……
		CASE 5
			;▼運動［一緒に運動する］
			;※[音楽知識]持ちは除く（演奏になる）
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「내가 고안한 "헤카티아즈 부트캠프"는 어때?」
					PRINTFORMDW 힘들어……
				CASE 1
					PRINTFORML 「벌써 질렸어? 흐물흐물하네……」
					PRINTFORMDW 헤카티아는 아무렇지도 않아 보인다……
				CASE 2
					PRINTFORML 「후우~! 시원한 땀 흘렸네~♪」
					PRINTFORMDW 검은색 지옥 티셔츠는 땀으로 젖어도 비치지 않는다……
			ENDSELECT
		CASE 6
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			IF TFLAG:193 == -1
				PRINTFORML 「조용히 해! 지금 중요한 순간이잖아」
				PRINTFORMDW 헤카티아는 독서에 열중하고 있다……
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「이거 재미있으니까, %CALLNAME:MASTER%도 읽어봐」
						PRINTFORMDW 헤카티아에게 만화를 빌렸다.
					CASE 1
						PRINTFORML 「책에서 지식을 얻는 건 중요한 일이야 %CALLNAME:MASTER%」
						PRINTFORMDW 만화밖에 안 읽은 것 같은데……
				ENDSELECT
			ENDIF
		CASE 7
			;▼料理［料理を手伝う］→［料理を分けてもらう］
			;TFLAG:193,2=料理を手伝う,0=作った料理を食べる,-1==MASTERはお腹が空いてなかった（食べる時）
			IF TFLAG:193 == 2
				;酔っ払い時
				IF ALCOHOL_FACE(113) == "酔いどれ" || ALCOHOL_FACE(113) == "ぐでぐで"
					PRINTFORML 「내 사랑을 가득 담아 줄게용♪」
					PRINTFORMDW 별로 좋은 예감밖에 안 드니까 도와주기로 했어……
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「...큰술? 작은술?」
							PRINTFORML 「잘 모르니까 아무거나 넣어요」
						CASE 1
							PRINTFORML 「버터를 넣으면 맛있어진다고 순호가 말해줬는데~♪」
						CASE 2
							PRINTFORML 「어라? 뭔가 빠뜨린 것 같은 기분이야...」
							PRINTFORML 「—뭐, 괜찮겠지♪」
					ENDSELECT
					PRINTFORMDW 완성된 헤카티아의 요리는 굉장한 비주얼을 하고 있다……
				ENDIF
			ELSEIF TFLAG:193 == 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「%CALLNAME:MASTER%, 먹여 줄게요」
						PRINTFORMW 「괜찮아? 망설이지 않아도 돼♪」
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%어때? 맛있지~♪」
						PRINTFORMW 「……어머? 기절해 버렸네에」
					CASE 2
						PRINTFORML 「완식하다니, 그렇게 맛있었구나~♪」
						PRINTFORMDW 몸 상태가 안 좋아지고 있어……
				ENDSELECT
			ELSEIF TFLAG:193 == -1;腹いっぱい
				PRINTFORML 「사양 안 해도 돼, 잔뜩 있으니까 괜찮아♪」
				PRINTFORMDW 음식을 입에 강제로 밀어 넣었다…….
			ENDIF
		CASE 8
			;▼演奏［セッションする］or［伴奏する］
			;※[音楽知識]持ちのみ（TALENT:音楽知識で変化）
			;TALENT:音楽知識,1=演奏してる,2=歌ってる,3=踊ってる
			;TFLAG:193,1=ノリノリ,0=成功,-1=失敗,-2=楽器がなくて見てるだけ
			;PRINTFORMW
		CASE 9
			;▼採集［採集を手伝う］
		CASE 10
			;▼釣り［一緒に釣りをする］
			;TFLAG:193,-1=釣り竿がなくて見てるだけ
			;PRINTFORMW
		CASE 11
			;▼実験［実験を手伝う］
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「상아가 10억 번은 죽는 독약을 만들고 있단 말이야」
					PRINTFORMDW 굉장한 자극적인 냄새가 난다…….
				CASE 1
					PRINTFORML 「아앙, 정말! 또 실패해버렸어」
					PRINTFORML 「응? 실험? 순호에게 배운 과자를 만들고 있었는데……」
					PRINTFORMDW 실험이 아니라 요리였던 모양이다…….
				CASE 2
					PRINTFORML 「당신에게 마시게 할 굉장한 약을 만들고 있단다」
					PRINTFORML 「마시게 하면 당신이 둘, 넷으로 배틀 게임처럼 늘어나 버려♪」
					PRINTFORMDW 어디선가 들어본 듯한 효과네……
				CASE 3
					PRINTFORML 「이거? 마시면 잠 안 자고 일할 수 있게 되는 "비타민제"야♪」
					PRINTFORMDW "헤카티아, 거짓말하지 마앗"
			ENDSELECT
		CASE 12
			;▼のんびり［一緒にのんびりする］
			SELECTCASE RAND:4
				CASE 0
					IF TALENT:恋人
						CALL HPH_PRINT,@"「자, %CALLNAME:MASTER%……♪ 더 이쪽으로 와줘요… 후헵」","L"
						PRINTFORMDW 카티아와 몸을 맞대고 시간을 보냈다.
					ELSEIF TALENT:恋慕 || TALENT:思慕
						PRINTFORML 「지루해……」
						PRINTFORML 「%CALLNAME:MASTER%, 재미있는 거 좀 해 봐. 주인님의 명령이야~」
						PRINTFORMDW 무리한 부탁이잖아……
					ELSE
						PRINTFORML 「지루해…….」
						PRINTFORMW 「%CALLNAME:MASTER%, 재미있는 이야기 없어?」
					ENDIF
				CASE 1
					PRINTFORML 「후와아……. 심심하네…….」
					PRINTFORMDL 뺨을 괴고 누운 자세로 뒤척이며 하품을 하는 헤카티어.
					PRINTFORMDW 지옥의 지배자라고는 조금도 느껴지지 않는다…….
				CASE 2
					PRINTFORML 「아! %CALLNAME:MASTER%, 그거 놔줘」
					SETCOLOR 0x2459F0
					PRINTFORML 「자아, 이제 뒤는 없어?」
					SETCOLOR 0xF0D124
					PRINTFORML 「몸부터 다 벗겨서 전라로 만들어 줄게♪」
					PRINTFORMDW 헤카티아와 실질적으로 3대 1의 마작을 하며 시간을 보냈다……
				CASE 3
					PRINTFORML 「후우」
					SETCOLOR 0x2459F0
					PRINTFORML 「후우」
					SETCOLOR 0xF0D124
					PRINTFORML 「후우」
					PRINTFORMDL 暇を持て余したへカーティアが、自身の三つの天体でお手玉をしている。
					PRINTFORMDW 目まぐるしく変化する彼女の髪色を眺めて過ごした。
			ENDSELECT
		CASE 13
			;▼晩酌［晩酌に付き合う］
			;※酒耐性0以上のみ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「%CALLNAME:MASTER%, 부어주세요」
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%페이스가 빠르잖아」
					PRINTFORML 「그런 거 싫지 않아♪」
					PRINTFORMDW 비워진 잔에, 헤카티아가 새로운 술을 따라주었다.
				CASE 2
					PRINTFORML 「건배♪」
					PRINTFORMDW 잔끼리 부딪히며 경쾌한 소리가 울렸다.
			ENDSELECT
		CASE 14
			;▼買い物［買い物を手伝う］
			SELECTCASE RAND:2
				;多分使わない
				CASE 0
					PRINTFORML 「저기…… 순호에게 부탁받은 건 전부 샀네」
					PRINTFORML 「아, 피스 간식 사는 거 깜빡했네」
					PRINTFORMDW 많은 봉투를 들고 헤카티아의 뒤를 따랐다……
				CASE 1
					PRINTFORML 「음~…… 가쓰오부시와 콘소메, 어느 쪽이 좋을까……」
					PRINTFORMDW 둘 다 상관없으니까 빨리 정해줬으면 좋겠어……
			ENDSELECT
		CASE 15
			;▼説教［様子をうかがう］
			;※神霊・蓬莱人は除く
			;TFLAG:193,-1
			;PRINTFORMW
		CASE 16
			;▼落とし穴［いたずらに付き合う］or［様子をうかがう］
			;※三月精・チルノ・クラウンピースのみ
			;それ以外は落ちる側
			;PRINTFORMW
		CASE 17
			;▼雪だるま作り［一緒に雪作り］
			;※冬の月のみ
		CASE 18
			;▼炬燵でのんびり［炬燵でくつろぐ］
			;※冬の月のみ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「그으읍~… Zzzz~……」
					PRINTFORMDW 화로 옆에서 잠든 헤카티아에게 담요를 덮어주었다.
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%~ 빨리 귤 까줘봐」
					SETCOLOR 0x2459F0
					PRINTFORML 「후우…… 추운 날에는 따뜻한 차가 최고네~♪」
					SETCOLOR 0xF0D124
					PRINTFORML 「순호우… 달콤한 거 먹고 싶다아…… 음냐……」
					PRINTFORMDW 헤카티아 일행은 화로 옆에서 각자 편하게 쉬고 있다.
				CASE 2
					CALL HPH_PRINT,@"「하아~! 따뜻해~ HPH」","L"
					PRINTFORMDW 헤카티아는 온돌을 마음에 들어 한 듯하다.
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
