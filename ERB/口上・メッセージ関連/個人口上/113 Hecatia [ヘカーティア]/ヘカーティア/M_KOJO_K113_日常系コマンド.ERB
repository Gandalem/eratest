						CALL HPH_PRINT,@"「아앗 흐윽 거기... 더 손가락으로 긁어줘흐윽」","L"
				ENDSELECT
				PRINTFORMDW 헤카티아의 은밀한 곳에 손가락을 넣고 애무했다...!
			ENDIF
			;乳を吸わせる
		CASE 77
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응읏……♪ 내가 말하기 전에 빨아버리다니, 대단해 %CALLNAME:MASTER%……후우큭」","L"
				CASE 1
					CALL HPH_PRINT,@"「빨리 가슴 빨아봐……♪ 아기처럼 말이야…… HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「자…… HPH 너 제일 좋아하는 가슴이야, HPH」","L"
			ENDSELECT
			PRINTFORMDW 입가로 다가온 헤카티아의 유두에, 반사적으로 물었다...!
			;85=Ｖ挿入する
		CASE 85
			IF TCVAR:破瓜 == 1
				CALL HECA_SEX
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응! HPH 뜨거워…… ♪ 벌써 완전히 딱딱해졌네…… HPH」","L"
						CALL HPH_PRINT,@"「그럼……♪응…….!!――아아앗 HPH HPH HPH」","L"
						PRINTFORMDW 헤카티아가 허리를 내리치는 순간, 강렬한 쾌감이 밀려왔다...!
					CASE 1
						PRINTFORML 「있잖아 %CALLNAME:MASTER%……♪ 이거, 어떻게 해줬으면 좋겠어?」
						CALL HPH_PRINT,@"「제대로 자기 입으로, 주인님께 애원해 봐요…… HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 큰 목소리로, 자신의 욕망을 헤카티아에게 전했다...!
						CALL HPH_PRINT,@"「……흐읍…좋아…….응응읏 흐읍 흐읍 흐읍」","W"
					CASE 2
						CALL HPH_PRINT,@"「자, 보세요 %CALLNAME:MASTER%……큭큭」","L"
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 거시기(또는 성기)가, 주인님의 구멍에 빨려 들어가고 있어…… HPH」","L"
						PRINTFORMDW 천천히 헤카티아의 질 내에 파묻혀 가는 자신의 성기를, %조사처리(CALLNAME:MASTER,"는")% 몰입한 듯 응시했다……!
				ENDSELECT
			ENDIF
			;だいしゅきホールド
		CASE 86
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 어서 주인을 임신시켜 봐라 HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「당신의 정액…… 자궁에서 전부 짜내 줄게 HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「……좋아할 거야 HPH 너, 좋아하니까 말이야 HPH」","L"
					CALL HPH_PRINT,@"「나・카・다・시……흐으윽」","L"
			ENDSELECT
			PRINTFORMDW 헤카티아가 다리를 얽으며 밀착한 채 속삭였다...!
			;87=Ａ挿入する
		CASE 87
			IF TCVAR:Ａ破瓜
				CALL HECA_SEX
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「변태인 %조사처리(CALLNAME:MASTER,"는")%, 보지가 아니라…… 이쪽이 더 좋잖아……? HPH」","L"
					CASE 1
						CALL HPH_PRINT,@"「당신의 정액, 엉덩이 구멍으로 짜내 드릴게요... HPH」","L"
					CASE 2
						CALL HPH_PRINT,@"「후우……읏! 응... 흠응~ 헉 헉」","L"
						CALL HPH_PRINT,@"「아... ♪... 하하... HPH 엉덩이로 거칠게 범해 버렸네... HPH」","L"
				ENDSELECT
				PRINTFORMDW 헤카티아의 항문은 %조사처리(CALLNAME:MASTER,"의")% 페니스를 저항 없이 삼켜버렸다...!
			ENDIF
			;88=腰振りＶ 89=腰振りＡ
		CASE 88, 89
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아앗 후으응! 아앗 후으응! 하아아…… 후우후우」","L"
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%윽 빨리, 빨리 자멘 줘아앙! HPH HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「응, 흐윽, 굉장해... 아직, 크다... 으윽」","L"
			ENDSELECT
			PRINTFORMDW 헤카티아의 격렬한 피스톤에, %조사처리(CALLNAME:MASTER,"는")% 이를 악물고 사정을 참았다...!
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「자아…… 뭘 하면서 놀까…… HPH」","L"
					PRINTFORMDW 헤카티아는 %CALLNAME:MASTER%위에 걸터앉으며, 요염하게 미소 짓고 있다……
				CASE 1
					CALL HPH_PRINT,@"「아우윽 HPH 안돼요 %CALLNAME:MASTER%♪ 그런 눈으로 쳐다보면……」","L"
					CALL HPH_PRINT,@"「점점 더 괴롭히고 싶어지잖아…… HPH」","W"
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
