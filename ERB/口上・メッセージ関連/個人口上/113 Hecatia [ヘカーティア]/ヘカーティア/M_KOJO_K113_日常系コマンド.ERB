			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「―윽! 만지지 마아!!」
					PRINTFORMDW 배를 만지려고 하자, 손에 맞았다……
				CASE 1
					PRINTFORML 「……"살쪘다"? 그럴 리가 없다」
					PRINTFORMDW 헤카티아는 배를 쓰다듬으며 시선을 돌렸다.
				CASE 2
					PRINTFORML 「……%TEXTR("早く産まれないかしら/大丈夫よ……産まれがどうであれ、この子は女神の子")%……」
					PRINTFORMDW 헤카티아는 자기 배를 쓰다듬으며 혼잣말을 하고 있다……
			ENDSELECT
		ENDIF
	ELSEIF EX:膣内精液 >= 1000
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「배…… 엄청 만져지고 있어…… HPH」","W"
