; Modular ERB: 個人口上/113 Hecatia [ヘカーティア]/Hecatia/M_KOJO_K113_CUSTOM_CHECKS.ERB
;ARG = original value for join in check
;ARG:1 = newly joining in character (for "CURRENT")
;returns 0=apply normal check, 1=walk away, 2=end sex, 3=join in (consensual), 4=join in (manipulated), 5=ask to join

@M_KOJO_TRIVIA_CHECK_K113_JOIN_SEX(ARGS,ARG,ARG:1)
IF ARGS == "JOINING"
	IF GROUPMATCH(ARG, 2, 3, 5) && CFLAG:[[純狐]]:うふふ ;if junko's having a good time, hecatia won't force her way in
		IF TALENT:恋慕 || TALENT:愛欲 ;intimate relationship with player, can ask to join
			RETURN 5
		ELSE
			RETURN 1
		ENDIF
	ELSEIF CFLAG:[[依姫]]:うふふ || CFLAG:[[豊姫]]:うふふ || CFLAG:[[サグメ]]:うふふ ;moonies only with high intimacy
		IF ABL:親密 < 20
			RETURN 2
		ENDIF
	ELSEIF ARG == 2 && !CFLAG:ブチギレ ;doesn't break up sex under normal circumstances unless angry
		RETURN 1
	ENDIF
	RETURN 0
ELSEIF ARGS == "CURRENT"
	IF GROUPMATCH(ARG, 1, 3, 4, 5) && GROUPMATCH(ARG:1, [[依姫]], [[豊姫]], [[サグメ]]) ;no moonies except with high intimacy
		IF ABL:親密 < 20
			RETURN 6
		ENDIF
	ELSEIF ARG == 5 ;anyone on the fence will be invited by her and join in without prompting
		RETURN 3
	ENDIF
	RETURN 0
ENDIF
