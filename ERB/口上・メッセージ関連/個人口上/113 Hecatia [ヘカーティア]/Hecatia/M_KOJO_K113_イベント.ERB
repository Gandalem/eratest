@M_KOJO_TRIVIA_FLAGSETTING_K113
;基本フラグ設定はここで行ってください
;共通の口上フラグは必要な箇所のコメントアウトを外してご利用ください
;口上専用フラグはご自由に
;Xにはキャラ番号を入れてください
;眠姦口上有、時間停止口上有、なりきりに1を入れると、それぞれ時間停止時、眠姦時、なりきり時にコマンド口上が読み込まれるように
;入れないと時間停止時、眠姦時、なりきり時は一切喋りません
;CFLAG:X:眠姦口上有 = 0
;CFLAG:X:時間停止口上有 = 0
;CFLAG:X:なりきり口上有 = 0
;破瓜キャンセル口上有に1を入れると、@M_KOJO_EVENT_KX_LOST_VIRGIN_STOPでキャンセルの成否を操作できます
;CFLAG:X:破瓜キャンセル口上有 = 0
;口上内抱き寄せ判定_初回と口上内抱き寄せ判定_通常に1を入れると、M_KOJO_EVENT_KX_PERMISSIONで押し倒しの成否を操作できます
;CFLAG:X:口上内抱き寄せ判定_初回 = 0
;CFLAG:X:口上内抱き寄せ判定_通常 = 0
;押し倒し禁止に1を入れると、自分から押し倒してこなくなります
;以下は恋慕かセフレがつくまで押し倒してこなくなる使用例
;IF !TALENT:X:恋慕 && !TALENT:X:セフレ
;	CFLAG:X:押し倒し禁止 = 1
;ELSE
;	CFLAG:X:押し倒し禁止 = 0
;ENDIF
;来訪不能に1を入れると、来訪してこなくなります
;以下は面識があるまで来訪してこなくなる使用例
;IF !CFLAG:X:面識
;	CFLAG:X:来訪不能 = 1
;ELSE
;	CFLAG:X:来訪不能 = 0
;ENDIF

@M_KOJO_TRIVIA_COLOR_K113
CALL K113_Color

@M_KOJO_TRIVIA_EVENT_K113_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-----
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「이만하면 충분히 봤다고 생각한다. 너희들 전부 그냥 꺼져라.」
			PRINTFORMDL 헤카티아는 누군가의 얼굴에 주먹을 날리지 않으려고 간신히 참는 듯하다.
			PRINTFORMDW 너희들은 명백하게 이대로 계속할 수 없다.
		ELSE
			PRINTFORML 「응, 지금은 기분이 아니야. 너희들 다른 데 가보는 게 어때.」
			PRINTFORMDW 짜증 난 헤카티아가 당신 위로 드리워져 있어 더는 계속할 수 없다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;負けじと参加（馴れ合い度:高）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「%CALLNAME:ARG%와 %조사처리(CALLNAME:MASTER,"가")% 즐거운 시간을 보내는 것 같군요.」
			PRINTFORML 「하지만 그녀처럼 잘난 체하는 애가 당신을 진정으로 만족시킬 수 있을지는 의문이네요.」
			PRINTFORMW 「오세요, 달의 사람들에게 쾌락의 진정한 의미를 보여줍시다.」
		ELSE
			PRINTFORML 「오호, 여기서 즐거운 시간을 보내고 있는 것 같네.」
			PRINTFORMW 「나도 같이 끼게 해줘. 사람이 많을수록 더 재미있잖아, 안 그래?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		IF CFLAG:[[純狐]]:うふふ
			PRINTFORMDW 헤카티아가 당신과 즐거운 시간을 보내는 준코를 보았을 때, 그녀는 당신에게 미소를 지으며 정중하게 손을 흔든 후 걸어가 버린다.
		ELSEIF ARG == [[依姫]]
			;a crudeness only expressed when interacting with lunarians
			PRINTFORML 「도대체 여기서 무슨 일이 있었던 거지? %조사처리(CALLNAME:MASTER,"를")% 네 조카인 요리히메로 착각했니?」
			PRINTFORML 「아니면 너는 어떤 남자든 상관없는 그런 천박한 년이니?」
			PRINTFORMW 「뭐, 어쨌든. 즐겁게 보내길 바라.」
		ELSEIF GROUPMATCH(ARG, [[豊姫]], [[サグメ]])
			PRINTFORML 「당신이 이렇게 형편없는 취향을 가졌는지 몰랐어요, %CALLNAME:MASTER%.」
			PRINTFORMW 「흥, 뭐 상관없어. 즐겁게 놀아보시길 바랄 뿐이야.」
		ELSE
			PRINTFORML 「오, 여기서 재미있어 보인네.」
			PRINTFORML 「나 이만 가볼게. 너희들 즐겁게 놀아.」
			PRINTFORMDW 헤카티아는 떠나면서 혼자 웃었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて参加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		IF CFLAG:[[純狐]]:うふふ
			PRINTFORML 「정말로 괜찮은 거야, 준코?」
			PRINTFORML 「요즘 정말 행복해 보여서, 여기서 분위기를 망치고 싶지 않아.」
			PRINTFORMDW 준코의 재촉에 평소 주저하던 헤카티아가 합류를 결정했고, 두 여성 모두 당신을 함께 기쁘게 해주려 했다.
		ELSEIF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「오, 이건 놀랍네.」
			PRINTFORMW 「음, 좋아. 하루 정도는 원한을 접어둘 수 있겠지.」
		ELSE
			PRINTFORML 「좋아, 네 제안을 받아들이지.」
			PRINTFORMW 「이리 와, %CALLNAME:ARG%. 우리 같이 즐겁게 놀자.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Rejected by one of the existing participants
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 90
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「나를 여기 원하지 않아, %CALLNAME:ARG%?」
			PRINTFORMW 「좋아. 어차피 너랑 같은 방에 있고 싶지도 않으니까.」
		ELSE
			PRINTFORML 「나랑 같이 할 기분이 아닌가?」
			PRINTFORMW 「알겠다. 다음에 하는 건 어떨까.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;One of the existing participants breaks it up
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 91
		PRINTFORML 「좀 과민하게 반응하는 거 아니야, %CALLNAME:ARG%?」
		PRINTFORMW 「뭐 어때. 그런 식으로 행동하는 이상한 사람들은 언제나 있는 법이지.」
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
RETURN 1
;==================================================
;情事を見られた
;==================================================

@M_KOJO_TRIVIA_EVENT_K113_7(ARG,ARG:1)
;口上主はTARGET
;ARGに目撃者
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を見られた（目撃者の馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORMW 「좋아, 뭐. 너희 같은 년들 중에 한 명이랑 즐길 일은 절대 없어.」
		ELSE
			PRINTFORML 「아마 더 나은 장소를 골랐어야 했어, %CALLNAME:MASTER%.」
			PRINTFORML 「뭐, 별일 아니야. 나중에 만회하면 돼.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が負けじと参加（目撃者の馴れ合い度:高）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「오, 너도 함께 하고 싶으냐, %CALLNAME:ARG%?」
			PRINTFORML 「"불순함"에 더럽혀질까 두렵지 않느냐?」
			PRINTFORMW 「음, 그게 네 얼굴을 쾌락으로 멍하게 만드는 걸 의미한다면, 너희가 우리와 함께 하는 건 괜찮다고 생각한다.」
		ELSE
			PRINTFORML 「너 같은 귀여운 애가 우리에게 합류하면 훨씬 더 재미있을 거야, %CALLNAME:ARG%.」
			PRINTFORML 「이리 와, 준비하도록 하자.」
			PRINTFORMDW 헤카티아는 %CALLNAME:ARG%를 열렬히 맞이했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「그래, 그냥 여기서 나가. 여긴 네가 있을 곳이 아니야.」
			PRINTFORMW 「자, %CALLNAME:MASTER%. 그녀는 잊고 우리 즐기러 돌아오지 그래.」
		ELSE
			PRINTFORML 「아, %HE_SHE(ARG)%는 아직 너무 수줍음이 많아서 함께하지 못하는 것 같네.」
			PRINTFORML 「조만간 %HIM_HER(ARG)%를 부드럽게 마음을 열게 해줘야 할지도 모르겠어.」
			PRINTFORMDW 헤카티아의 입가에 약간 사악한 미소가 떠오르며, 너와 함께할 즐거운 시간을 상상했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて目撃者も参加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		;can only happen with moonies
		PRINTFORML 「좋아, 네가 그렇게 원한다면 말이야, %CALLNAME:MASTER%.」
		PRINTFORMW 「하지만 왜 굳이 애쓰는지 모르겠네.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Prevents someone from joining in
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 90
		IF GROUPMATCH(ARG, [[依姫]], [[豊姫]], [[サグメ]])
			PRINTFORML 「여기서 나가. 이건 %조사처리(CALLNAME:MASTER,"의")% 거고 난 나눠줄 생각 없어.」
			PRINTFORML 「아니면 나랑 %HIM_HER(MASTER)% 때문에 싸우고 싶어?」
			PRINTFORMDL 헤카티아가 %CALLNAME:ARG%를 노려보자, 그 여자는 재빨리 물러섰다.
			PRINTFORML 「그래, 그럴 줄 알았지.」
			PRINTFORMW 「이봐, %CALLNAME:MASTER%, 그냥 그녀는 잊어버려. 이보다 훨씬 더 좋은 여자들이 있잖아.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Character throws a fit and breaks it up
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 91
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
RETURN 1
;==================================================
;調教終了時に自慰
;==================================================

@M_KOJO_TRIVIA_EVENT_K113_22(ARG,ARG:1)
#DIM SELFCEST
SELFCEST = PERCENT(LIMIT(ABL:レズっ気 * 10 + TALENT:自慰狂い * 10, 20, 60 + TALENT:自慰狂い * 10))
;口上主はARG
;ARG:0に自慰状況
;ARG:1に自慰種類
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;通常自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF SELFCEST
			PRINTFORML 「%MOAN("m:l",,6)%...」
			PRINTFORMD 어두운 밤에 평소처럼 
			IF GET_MAPID(GET_CHARAHOME(TARGET)) == MAP月
				PRINTFORMDL 달의 고요함은 표면을 가로지르는 큰 신음 소리로 방해받는다.
			ELSE
				PRINTFORMDL 자연의 소리는 그 지역 전체에 울려 퍼지는 큰 신음소리에 묻혔다.
			ENDIF
			SIF CFLAG:神社在住 && MAP_AREASELECT(MAIN_MAP, CFLAG:神社在住) == MAP_AREASELECT(MAIN_MAP, GET_CHARAHOME(MASTER))
				PRINTFORMDL 너무 시끄러워서 자기 방에서도 들릴 정도다.
			PRINTFORMDW 스스로 만족을 찾지 못하자 헤카티아는 다른 두 자아를 불러 자신과 함께 자위를 한다.
			PRINTFORML 「%MOAN()%... 제발, 더 세게 해줘...」
			PRINTFORMDL 헤카티아는 다른 자아들에게 애무당하며 쾌락 속에 자신을 잃는다.
			PRINTFORMDL 그녀에게 키스하고, 가슴을 만지고, 음핵을 비비고, 손가락으로 애무한다; 헤카티아들은 그녀의 몸 모든 부위를 공격한다.
			PRINTFORML 「%MOAN("l",,2)%... %SLUR("HARDER")%! %MOAN("l",,1)% %SLUR("HARDER",-3)%!...」
			PRINTFORMDW 다른 자아들이 주는 쾌락에 자신을 맡긴 헤카티아는 다가올 오르가슴 생각만 할 수 있었다.
			PRINTFORML 「안나앙그구우우으아아아아아아아아아아!」
			PRINTFORMDW 그녀는 주변 전체에 들릴 정도로 크게 소리치며 강력한 오르가슴을 터뜨렸다.
			PRINTFORML 「아아... 하흡.... 하아...」
			PRINTFORML 「후, 훨씬 나아졌어. 고마워, 얘들아. 정말 엄청 쌓여 있었거든.」
			SIF GETBIT(CFLAG:既成事実,1)
				PRINTFORML 「하지만 우리 정말로 언젠가 %조사처리(CALLNAME:MASTER,"랑")% 한번 놀아야 해. %HIM_HER(MASTER)%가 함께하면 훨씬 더 재미있으니까.」
			PRINTFORML 「자, 이제 자리를 바꾸고 내가 호의를 갚도록 하지...」
			PRINTFORMDW 헤카티아스는 위치를 바꾸어 밤새 서로에게 쾌락을 선사한다...
		ELSE
			PRINTFORML 「%MOAN("l",,3)%...」
			PRINTFORML 「아, 바로 그곳이야.」
			PRINTFORMDL 헤카티아는 손가락을 몸 위에서 능숙하게 움직이며 자신이 가장 좋아하는 모든 곳을 자극했다.
			PRINTFORML 「큭. 기분 좋아.」
			PRINTFORMDL 헤카티아는 절정에 가까워지면서 움직임을 더욱 빠르게 했다.
			IF TALENT:恋人
				PRINTFORML 「%CALLNAME:MASTER%, 가까이 와봐. 네 온기를 느끼게 해줘.」
				PRINTFORML 「사랑해, 사랑해, 사랑해.」
				PRINTFORML 「어서, 나에게 키스해줘.」
				PRINTFORML 「아아아아아아아아아앙그으윽!」
				PRINTFORMDW 헤카티아는 상상 속의 너에게 자신의 사랑을 표현하며 강력하게 절정에 도달한다.
				PRINTFORML 「하아, %조사처리(CALLNAME:MASTER,"가")% 없으니 같지 않아.」
				PRINTFORMW 「%HE_SHE(MASTER)%가 원하는 대로 할 자유가 있다는 건 알아, 하지만 %HIS_HER(MASTER)% 연인에게 좀 더 배려심을 가져주면 좋겠어.」
				CFLAG:翌日来訪 = 1
			ELSEIF TALENT:恋慕
				PRINTFORML 「%CALLNAME:MASTER%...」
				PRINTFORML 「그래, 바로 거기야. 주저하지 마.」
				PRINTFORML 「아아아앙!」
				PRINTFORMDW 헤카티아는 당신이 그녀와 사랑을 나누는 상상을 하면서 강렬하게 절정에 이른다.
				PRINTFORML 「아, 굉장했어.」
				PRINTFORML 「그래도 난 %조사처리(CALLNAME:MASTER,"랑")% 하는 게 더 좋을 것 같아.」
				PRINTFORMW 「내일 %HIM_HER(MASTER)%를 보러 가야겠어. 분명 %HE_SHE(MASTER)%도 작은 재미에 응할 거야.」
				CFLAG:翌日来訪 = 1
			ELSEIF TALENT:セフレ || TALENT:愛欲
				PRINTFORML 「%CALLNAME:MASTER%... %CALLNAME:MASTER%...」
