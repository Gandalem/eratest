;ARG=banquet_id
;ARGS=scene
@M_KOJO_TRIVIA_EVENT_K113_BANQUET(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIMS TERM
#DIM BANQUET_ID
#DIM PRESENT
RESULT = 0
PRESENT = IS_HERE(TARGET)

TRYCALLFORM M_KOJO_TRIVIA_EVENT_K113_BANQUET_{BANQUET_ID}(SCENE,ARG)
SIF RESULT
    RETURN 1

TERM '= TOUPPER(GET_STR(0, "ADD_BANQUET", BANQUET_ID, "CATEGORY"))
TRYCALLFORM M_KOJO_TRIVIA_EVENT_K113_BANQUET_TYPE_%TERM%(SCENE,BANQUET_ID,ARG)
SIF RESULT
    RETURN 1

;generic, use with care
SELECTCASE SCENE
    CASE "BANQUET_START"
    CASE "MEET_PLAYER"
    CASE "CHARA_LEAVES"
    CASE "BANQUET_END"
    CASE "IDLE"
ENDSELECT
RETURN 1

;reimu spontaneous party
@M_KOJO_TRIVIA_EVENT_K113_BANQUET_1(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
            PRINTFORML 「Thanks for having me, Reimu. I love a good party.」
            IF CFLAG:好感度 >= 1000
                PRINTFORMW 「C'mon, %CALLNAME:MASTER%. Let's find a good spot before they're all taken.」
            ELSE
                PRINTFORMW 「Hope you don't mind if things get a little rowdy, though.」
            ENDIF
            PRINTFORMDW Hecatia cheerily walks in as she joins the banquet.
        ENDIF
        RETURN 1
    CASE "MEET_PLAYER"
        IF PRESENT && CFLAG:好感度 >= 1000
            PRINTFORML 「%SLUR(TOUPPER(K113_GREET()), 8)%, %SLUR(TOUPPER(CALLNAME:MASTER))%. C'mon, sit with me.」
            PRINTFORMDW Hecatia beckons you over while yelling loud enough for all the other guests to hear.
        ENDIF
        RETURN 1
    CASE "CHARA_LEAVES"
    CASE "BANQUET_END"
    CASE "IDLE"
ENDSELECT

;lake party
@M_KOJO_TRIVIA_EVENT_K113_BANQUET_22(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
#DIMS SWIMWEAR_NAME
SWIMWEAR_NAME '= TOLOWER(LISTING_TR(GET_STR(TARGET, "衣装セット", CFLAG:基本服装セット, "名前")))
SWIMWEAR_NAME '= REPLACE(SWIMWEAR_NAME, " set", "")

PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
            PRINTFORML 「Woohoo! I love summer!」
        ENDIF
        RETURN 1
    CASE "MEET_PLAYER"
        IF PRESENT && CFLAG:好感度 >= 1000
            PRINTFORML 「Hey there, %CALLNAME:MASTER%. Like what you see?」
            PRINTFORMDL Hecatia eagerly flaunts her %SWIMWEAR_NAME% to you.
            SELECTCASE K113_BODY(TARGET)
                CASE 3 ;earth hecatia is an enthusiastic swimmer
                    PRINTFORML 「Come on, let's do a couple laps across the lake.」
                    PRINTFORMW 「Do you think you can keep up with me?」
                CASEELSE
                    PRINTFORMW 「Let's go play in the water, %CALLNAME:MASTER%. It's summer, after all.」
            ENDSELECT
        ENDIF
        RETURN 1
    CASE "CHARA_LEAVES"
        PRINTFORMW 「That was fun, but that's enough for me.」
        RETURN 1
    CASE "BANQUET_END"
        PRINTFORMW 「Guess everyone's leaving already.」
        RETURN 1
    CASE "IDLE"
ENDSELECT

@M_KOJO_TRIVIA_EVENT_K113_BANQUET_TYPE_BANQUET(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
            PRINTFORML 「Hey hey, Heca's here. Let's get this party started.」
            PRINTFORMDW Hecatia cheerily walks in as she joins the banquet.
        ENDIF
    CASE "MEET_PLAYER"
        IF PRESENT && CFLAG:好感度 >= 1000
            PRINTFORMW 「Alriiiight, %CALLNAME:MASTER%'s here. Now it's really a party.」
        ENDIF
    CASE "CHARA_LEAVES"
        IF PRESENT
            PRINTFORML 「That's enough for me, I suppose. Hope to see you guys next time.」
            PRINTFORMDW Satisfied, Hecatia returns home.
        ENDIF
    CASE "BANQUET_END"
        IF PRESENT
            PRINTFORML 「Is it over already?」
            PRINTFORMDW Oh well, I'll just have to wait for the next party, then.
        ENDIF
    CASE "IDLE"
        IF PRESENT && !RAND:2
            PRINTDATAL
                DATAFORM 「So then Piece said...」
                DATAFORM 「Well, in that case, I would...」
                DATAFORM 「The thing about Lunarians is...」
                DATAFORM 「So like I said before...」
                DATAFORM 「Sometimes you really just oughta just cut loose and have a little fun, ya know?」
                DATAFORM 「So do you have any suggestions for Hell's revitalization project? I'm always open to new ideas.」
                DATALIST
                    DATAFORM 「That lazy shinigami is fun and all, but I really think %K113_NICKNAME([[映姫]])% can do better than her.」
                    DATAFORM 「I don't think that she understands there's a time to play and a time to work.」
                ENDLIST
                DATAFORM 「They sure know how to throw a party in Gensokyo, don't they?」
            ENDDATA
            PRINTFORMDW Hecatia eagerly chats with the other participants.
        ENDIF
ENDSELECT
RETURN 1

@M_KOJO_TRIVIA_EVENT_K113_BANQUET_TYPE_CONCERT(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
#DIMS BAND_NAME
PRESENT = IS_HERE(TARGET)
SELECTCASE BANQUET_ID
    CASE 11
        BAND_NAME = Choujuu Gigaku
    CASEELSE
        BAND_NAME = these girls
ENDSELECT
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
            PRINTFORML 「I've been looking forward to this. I love %BAND_NAME%!」
            PRINTFORMW 「Are you a fan too, %CALLNAME:MASTER%?」
        ENDIF
        TALENT:機嫌 = 1
    CASE "MEET_PLAYER"
        IF PRESENT
            PRINTFORML 「You're late, %CALLNAME:MASTER%! %CAPITALIZE(BAND_NAME)% already started.」
        ENDIF
    CASE "CHARA_LEAVES", "BANQUET_END"
        IF PRESENT
            PRINTFORMW 「That was fun. I look forward to next time.」
        ENDIF
    CASE "IDLE"
        IF PRESENT && !RAND:5
            PRINTDATAL
                DATAFORM 「Woooooooooo!」
                DATAFORM 「Louder! Louder!」
                DATAFORM 「Encore! Encore!」
                DATAFORM 「I love this song!」
            ENDDATA
            PRINTFORMW Hecatia seems to be in high spirits.
        ENDIF
ENDSELECT
RETURN 1
