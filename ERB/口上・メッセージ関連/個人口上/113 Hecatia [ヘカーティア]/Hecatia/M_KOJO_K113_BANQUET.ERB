; Modular ERB: 個人口上/113 Hecatia [ヘカーティア]/Hecatia/M_KOJO_K113_BANQUET.ERB
;ARG=banquet_id
;ARGS=scene

@M_KOJO_TRIVIA_EVENT_K113_BANQUET(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIMS TERM
#DIM BANQUET_ID
#DIM PRESENT
RESULT = 0
PRESENT = IS_HERE(TARGET)
TRYCALLFORM M_KOJO_TRIVIA_EVENT_K113_BANQUET_{BANQUET_ID}(SCENE,ARG)
SIF RESULT
	RETURN 1
TERM '= TOUPPER(GET_STR(0, "ADD_BANQUET", BANQUET_ID, "CATEGORY"))
TRYCALLFORM M_KOJO_TRIVIA_EVENT_K113_BANQUET_TYPE_%TERM%(SCENE,BANQUET_ID,ARG)
SIF RESULT
	RETURN 1
;generic, use with care
SELECTCASE SCENE
	CASE "BANQUET_START"
	CASE "MEET_PLAYER"
	CASE "CHARA_LEAVES"
	CASE "BANQUET_END"
	CASE "IDLE"
ENDSELECT
RETURN 1
;reimu spontaneous party

@M_KOJO_TRIVIA_EVENT_K113_BANQUET_1(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
	CASE "BANQUET_START"
		IF PRESENT
			PRINTFORML 「초대해줘서 고마워, 레이무. 나는 좋은 파티를 좋아해.」
			IF CFLAG:好感度 >= 1000
				PRINTFORMW 「이봐, %CALLNAME:MASTER%. 다 차지 전에 좋은 장소를 찾자.」
			ELSE
				PRINTFORMW 「좀 시끄러워지면 괜찮으시겠죠.」
			ENDIF
			PRINTFORMDW 헤카티아는 즐겁게 걸어 들어와 만찬에 합류한다.
		ENDIF
		RETURN 1
	CASE "MEET_PLAYER"
		IF PRESENT && CFLAG:好感度 >= 1000
			PRINTFORML 「%SLUR(TOUPPER(K113_GREET()), 8)%, %SLUR(TOUPPER(CALLNAME:MASTER))%. 이리 와서 나랑 앉아.」
			PRINTFORMDW 헤카티아는 다른 손님들 모두가 들을 수 있을 만큼 크게 소리치며 당신을 불러낸다.
		ENDIF
		RETURN 1
	CASE "CHARA_LEAVES"
	CASE "BANQUET_END"
	CASE "IDLE"
ENDSELECT
;lake party

@M_KOJO_TRIVIA_EVENT_K113_BANQUET_22(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
#DIMS SWIMWEAR_NAME
SWIMWEAR_NAME '= TOLOWER(LISTING_TR(GET_STR(TARGET, "衣装セット", CFLAG:基本服装セット, "名前")))
SWIMWEAR_NAME '= REPLACE(SWIMWEAR_NAME, " set", "")
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
	CASE "BANQUET_START"
		IF PRESENT
			PRINTFORML 「우후! 여름이 좋아!」
		ENDIF
		RETURN 1
	CASE "MEET_PLAYER"
		IF PRESENT && CFLAG:好感度 >= 1000
			PRINTFORML 「안녕, %CALLNAME:MASTER%. 보이는 것들 같아?」
			PRINTFORMDL 헤카티아는 당신에게 자신의 %SWIMWEAR_NAME%를 열렬하게 자랑한다.
			SELECTCASE K113_BODY(TARGET)
				CASE 3 ;earth hecatia is an enthusiastic swimmer
					PRINTFORML 「자, 호수 반대편으로 몇 번 돌아보자.」
					PRINTFORMW 「나를 따라올 수 있을 것 같아?」
				CASEELSE
					PRINTFORMW 「물놀이하러 가자, %CALLNAME:MASTER%님. 어차피 여름이니까.」
			ENDSELECT
		ENDIF
		RETURN 1
	CASE "CHARA_LEAVES"
		PRINTFORMW 「재미있었지만, 난 이쯤에서 그만할게.」
		RETURN 1
	CASE "BANQUET_END"
		PRINTFORMW 「다들 벌써 떠나는 건가 봐.」
		RETURN 1
	CASE "IDLE"
ENDSELECT

@M_KOJO_TRIVIA_EVENT_K113_BANQUET_TYPE_BANQUET(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
	CASE "BANQUET_START"
		IF PRESENT
			PRINTFORML 「헤이 헤이, 헤카가 왔어. 파티를 시작해 보자.」
			PRINTFORMDW 헤카티아는 즐겁게 걸어 들어와 연회에 합류했다.
		ENDIF
	CASE "MEET_PLAYER"
		IF PRESENT && CFLAG:好感度 >= 1000
			PRINTFORMW 「알겠어, %조사처리(CALLNAME:MASTER,"가")% 왔으니 이제 정말 파티구나.」
		ENDIF
	CASE "CHARA_LEAVES"
		IF PRESENT
			PRINTFORML 「이 정도면 됐겠지. 다음에 또 보자.」
			PRINTFORMDW 만족한 헤카티아는 집으로 돌아간다.
		ENDIF
	CASE "BANQUET_END"
		IF PRESENT
			PRINTFORML 「벌써 끝이야?」
			PRINTFORMDW 뭐, 다음 파티를 기다려야겠지.
		ENDIF
	CASE "IDLE"
		IF PRESENT && !RAND:2
			PRINTDATAL
				DATAFORM 「그래서 피스가 말했지...」
				DATAFORM 「음, 그렇다면 나는...」
				DATAFORM 「루나리안들의 특징은...」
				DATAFORM 「전에 말했던 것처럼...」
				DATAFORM 「가끔은 그냥 마음 놓고 좀 재미있게 놀아야 하잖아, 알지?」
				DATAFORM 「지옥 재활성화 프로젝트에 대한 제안 있으신가요? 저는 언제나 새로운 아이디어를 환영해요.」
				DATALIST
					DATAFORM 「저 게으른 신사(死神)도 재미있긴 하지만, %K113_NICKNAME([[映姫]])%는 그녀보다 더 잘할 수 있다고 생각한다.」
					DATAFORM 「그녀가 놀 시간과 일할 시간이 있다는 걸 이해하지 못하는 것 같다.」
				ENDLIST
				DATAFORM 「그들은 정말로 환상향에서 파티를 잘 여는 것 같아, 그렇지 않아?」
			ENDDATA
			PRINTFORMDW 헤카티아는 다른 참가자들과 열렬하게 대화한다.
		ENDIF
ENDSELECT
RETURN 1

@M_KOJO_TRIVIA_EVENT_K113_BANQUET_TYPE_CONCERT(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
#DIMS BAND_NAME
PRESENT = IS_HERE(TARGET)
SELECTCASE BANQUET_ID
	CASE 11
		BAND_NAME = 추주 기악
	CASEELSE
		BAND_NAME = 이 여자들
ENDSELECT
SELECTCASE SCENE
	CASE "BANQUET_START"
		IF PRESENT
			PRINTFORML 「기대하고 있었어요. 저는 %BAND_NAME%를 사랑해요!」
			PRINTFORMW 「%CALLNAME:MASTER%도 팬인가요?」
		ENDIF
		TALENT:機嫌 = 1
	CASE "MEET_PLAYER"
		IF PRESENT
			PRINTFORML 「늦었어요, %CALLNAME:MASTER%! %CAPITALIZE(BAND_NAME)%은 벌써 시작했어요.」
		ENDIF
	CASE "CHARA_LEAVES", "BANQUET_END"
		IF PRESENT
			PRINTFORMW 「재미있었어. 다음을 기대할게.」
		ENDIF
	CASE "IDLE"
		IF PRESENT && !RAND:5
			PRINTDATAL
				DATAFORM 「와아아아아!」
				DATAFORM 「더 크게! 더 크게!」
				DATAFORM 「앵콜! 앵콜!」
				DATAFORM 「이 노래 정말 좋아!」
			ENDDATA
			PRINTFORMW 헤카티아는 기분이 좋아 보인다.
		ENDIF
ENDSELECT
RETURN 1
