;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K125_80
CALL M_KOJO_MESSAGE_COM_K125_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K125_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「내 손을 써?」
			PRINTFORMW 「저-나에게 맡겨줘.」
			PRINTFORMDW 준은 어색하게 그녀의 %TINKO(PLAYER)%에 두 손을 댄다.
			PRINTFORMW 「우와... 정말 어려워...%UNICODE(0x2764)%」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음, 이렇게 해야 할지 모르겠네...」
			PRINTFORMW 「어-어때? 기분 좋지?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이건 안에 들어갈 수 있어...」
			PRINTFORMW 「나, 아무것도 상상한 게 아니었어!」
		ELSE
			PRINTFORMW 「아와와... 움찔거리고 있어...」
			PRINTFORMW 「나, 나 무서워하지 않아!」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
