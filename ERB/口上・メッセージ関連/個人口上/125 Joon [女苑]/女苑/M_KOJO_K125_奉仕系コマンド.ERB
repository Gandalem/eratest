	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「정말 이만큼 기분이 좋아지는 걸까?」
			PRINTFORMW 「...음, 그런 것 같네.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「하! 하! 어때?」
			PRINTFORMW 「...지, 좀 피곤하네...」
		ELSE
			PRINTFORMW 「허리를 떨고 있는 게 정말 기분이 좋다~.」
			PRINTFORMW 「너 정말 바보 같아...」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
