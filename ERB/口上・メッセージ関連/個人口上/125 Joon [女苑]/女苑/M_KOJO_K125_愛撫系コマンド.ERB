@M_KOJO_MESSAGE_COM_K125_23
CALL M_KOJO_MESSAGE_COM_K125_23_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K125_23_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;失敗
	IF TFLAG:193
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「하아...%UNICODE(0x2764)% 하아...%UNICODE(0x2764)%」
				PRINTFORMDW 그녀는 수차례 절정에 이른 후 완전히 지친 준을 부드럽게 안았다. 두 사람의 몸에서 나온 체액으로 그녀의 나체 몸이 빛나고 있었다.
				PRINTFORMW 「음...%UNICODE(0x2764)% 읏...%UNICODE(0x2764)%」
				PRINTFORMDW 준의 부탁에 당신은 그녀에게 입을 맞추었다. 녹아내릴 듯 달콤했던 순간 후, 당신은 천천히 입술을 열었다...
				PRINTFORMW 「%CALLNAME:MASTER%... 더 줄 수 있어?%UNICODE(0x2764)%」
			CASE 0
				PRINTFORMDW 격렬한 섹스 세션 후에, 당신은 자신을 사랑스럽게 감고 있는 준의 몸을 부드럽게 어루만진다.
				PRINTFORMDW 그녀의 뺨에서부터 목덜미를 거쳐 등 전체를 따라 손가락으로 더듬다가 마침내 그녀의 작은 엉덩이를 문지르기 시작하자—준이 유혹적인 신음을 흘린다.
				PRINTFORMDW 공기 중에 퍼진 음란한 체액의 악취와 습기 속에서, 준은 당신의 %FSYN("penis")%이 활력을 되찾았다는 것을 알아차린다.
				PRINTFORMDW 그녀는 다시 한번 아랫입술을 벌리며 당신을 유혹하려 한다...
		ENDSELECT
		RETURN 1
		;思慕
	ELSEIF TALENT:思慕
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
