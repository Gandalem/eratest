@M_KOJO_MESSAGE_COM_K125_1
CALL M_KOJO_MESSAGE_COM_K125_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K125_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「흐읍?! 너는 대체 뭐야...?」
			PRINTFORMDW 그녀를 무시한 채, 당신은 그녀의 비밀스러운 곳에 키스하고, 당신의 혀가 그것을 핥는다.
			PRINTFORMW 「아-안 돼, 놓아줘...」
			PRINTFORMW 「싫어, 안 돼안돼안돼%UNICODE(0x2764)%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「으음, 군...」
			PRINTFORMW 「아%UNICODE(0x2764)%, 아%UNICODE(0x2764)%, 아아%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「나를 그렇게 많이 핥는구나...」
			PRINTFORMW 「언제까지 그럴 거야, 변태 같으니라고...%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「흐읍... 나, 나 이제...」
			PRINTFORMW 「...말하겠다고, 바보야!」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
