@M_KOJO_MESSAGE_COM_K125_0
CALL M_KOJO_MESSAGE_COM_K125_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K125_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「아- 이거에서 기분 좋아져야 하는 거야?」
			PRINTFORMW 「너 여자 상대하는 거 익숙하지 않구나, 못하네.」
			PRINTFORMDW 그녀의 시무룩한 말을 듣고, 너는 애무를 조금 더 거칠게 했다.
			PRINTFORMW 「푸와?! 저기...」
			PRINTFORMW 「잠깐만... 진정해%UNICODE(0x2764)%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「우으...」
			PRINTFORMW 「나를 놀리려는 거야...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「M-손을 더 움직여줘.」
			PRINTFORMW 「Kyaan%UNICODE(0x2764)%, 그렇게 갑자기 움직이지 마%UNICODE(0x2764)%.」
		ELSE
			PRINTFORMW 「음... 이렇게 내 몸을 가지고 노는 건...」
			PRINTFORMW 「영광으로 여겨줘, %CALLNAME:MASTER%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
