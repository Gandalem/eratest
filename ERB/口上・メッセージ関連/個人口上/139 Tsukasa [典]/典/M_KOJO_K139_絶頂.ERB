								CALL HPH_PRINT,@"「아응흐읍! 안전일이 아닌데 말이에요! 안에 사정당해버렸어요! 흐읍...」","L"
							CASE 5
								CALL HPH_PRINT,@"「%CALLNAME:MASTER%전부 다 츠카사에게 주세요읏 HPH 어우욱 HPH」","L"
							CASE 6
								IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
									CALL HPH_PRINT,@"「싸줘! HPH, 애기 만들자읏 HPH, 언니의 질 안에 더 넣어줘 HPH」","L"
								ELSE
									CALL HPH_PRINT,@"「네읏 HPH, 츠카사의 자궁은 HPH, %CALLNAME:MASTER%전용 정자 주머니니까아읏 HPH」","L"
								ENDIF
						ENDSELECT
					ELSE
						SELECTCASE RAND:5
							CASE 0
								CALL HPH_PRINT,@"「아앙 HPH 이렇게 질내에 싸버려도 괜찮은 건가아앗 HPH」","L"
								CALL HPH_PRINT,@"「아기 생길지도 모를 텐데읏, 응응! HPH」","L"
							CASE 1
								CALL HPH_PRINT,@"「앙! HPH 츠카사의 자궁읏 HPH 사정 주머니로 만들어졌어요읏 HPH」","L"
							CASE 2
								CALL HPH_PRINT,@"(오늘 괜찮았었나…… 뭐, 기분 좋으니까 됐겠지…… HPH)","L"
							CASE 3
								CALL HPH_PRINT,@"(후훗, 안에 싸는 건 용서해 준 적은 없지만, 날것으로 가게 두면 저렇게 되죠 HPH)","L"
							CASE 4
								CALL HPH_PRINT,@"「앗 HPH 뜨거워어욧 HPH 엄청 나오고 있어요읏 HPH \@ (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行) ? 누나 # 츠카사 \@의 질 안에욧 HPH」","L"
								CALL HPH_PRINT,@"(아앗 후후, 생살로 안에 싸버리는 거 좋아읏)","L"
						ENDSELECT
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
