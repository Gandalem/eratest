		BASE:勃起 = 1000
	ELSE
		CALL HPH_PRINT,@"「아아, %CALLNAME:MASTER%어디, 빨리 안 오는 건가…… HPH 혼자 자위만 하고 있는 것으론 부족해……. HPH」","L"
		PRINTFORML 츠카사는 옷 속으로 손을 집어넣고, 질을 손가락으로 주무르며 %조사처리(CALLNAME:MASTER,"의")% 방문을 기다리고 있다……
	ENDIF
	PALAM:潤滑 = 5000
ELSEIF TALENT:セフレ
	PALAM:潤滑 = 2500
ENDIF
