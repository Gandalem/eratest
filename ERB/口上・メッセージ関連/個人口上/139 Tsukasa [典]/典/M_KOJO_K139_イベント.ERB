					LOCALS:0 = 
					IF TALENT:140:恋人 == 1
						LOCALS:0 '= @"메구무 언니"
					ELSEIF TALENT:29:恋人 == 1
						LOCALS:0 '= @"아야 언니"
					ELSEIF TALENT:42:恋人 == 1
						LOCALS:0 '= @"하타테 언니"
					ELSEIF TALENT:65:恋人 == 1
						LOCALS:0 '= @"모미지 언니"
					ELSE
						LOCALS:0 '= @"연인의 언니"
					ENDIF
					PRINTFORMW 「하지만, %LOCALS:0%가 아니어도 괜찮아요? 누나는 별로 상관없지만…」
					CALL HPH_PRINT,@"「물론, 비밀로 해 줄게요 HPH 둘만의, 비・밀・츠 HPH」","L"
					PRINTW 
				ENDIF
			ELSE
				PRINTFORML 「섹스 파트너, 이신가요?」
				PRINTFORML 「아라아라, 어머님 같으시네요…♪ 어디서 그런 말을 배우셨을까요」
				PRINTW 
				IF TALENT:MASTER:恋人 && !TALENT:恋人
					PRINTFORML 「정말로, 누나로 괜찮을까?」
					LOCALS:1 = 
					IF TALENT:140:恋人 == 1
						LOCALS:1 '= @"메구무 언니"
					ELSEIF TALENT:29:恋人 == 1
						LOCALS:1 '= @"아야 언니"
					ELSEIF TALENT:42:恋人 == 1
						LOCALS:1 '= @"하타테 언니"
					ELSEIF TALENT:65:恋人 == 1
						LOCALS:1 '= @"모미지 언니"
					ELSE
						LOCALS:1 '= @"연인의 언니"
					ENDIF
					PRINTFORML 「하지만, %LOCALS:1%이/가 있어야 하는데...」
					CALL HPH_PRINT,@"「가장 좋아하는 사람보다, 언니랑 하는 걸 우선해버리는 거야…… HPH 정말 나쁜 아이네요…… HPH」","L"
				ENDIF
			ENDIF
		ELSE
			PRINTFORML 「섹스 파트너, 이신가요?」
			PRINTFORML 「죄송합니다. 섹스 파트너라는 것이 애초에 어떤 것인지…」
			PRINTL 
			PRINTFORML 「! 호오, 그렇군, 그렇구나……」
			PRINTFORML 「섹스 프렌드라니. 즉, 서로 하고 싶을 때 하는, 육체적인 관계라는 거군요……」
			PRINTW 
			IF TALENT:MASTER:恋人 && !TALENT:恋人
				IF TALENT:140:恋人 == 1
					PRINTFORM 「이즈나마루 님」
				ELSEIF TALENT:29:恋人 == 1
					PRINTFORM 「이노우마루 어디의」
				ELSEIF TALENT:42:恋人 == 1
					PRINTFORM 「히메카이도노」
				ELSEIF TALENT:65:恋人 == 1
					PRINTFORM 「개주루 씨」
				ELSE
					PRINTFORM 「연인님」
				ENDIF
				PRINTFORMW 「오시면서, 대단한 배짱을 가지셨네요」
				IF TALENT:140:恋人 == 1
					PRINTL 
					PRINTFORML 「제가 이이즈미마루님의 부하라는 건 알고 계시잖아요?」
					PRINTFORML 「그런데 저랑 육체적인 관계를 가지고 싶다니…… 정말, 최악이에요」
					PRINTFORML 「들키게 되면 당신은 물론 저까지 파멸하게 되니까요」
					PRINTW 
				ENDIF
				CALL PRINT_FACE, [[典]], "通常", "裸", "", ""
				CALL HPH_PRINT,@"「……하지만 싫지 않아요, 그런 거 HPH」","L"
				PRINTW 
			ENDIF
		ENDIF
	CASE "補正"
		;ショタと大人では評価が逆転
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			CALL HPH_PRINT,@"(뭐 이쪽 입장에서도, 이 아이를 마음대로 먹을 수 있다는 건 편한 거지만... HPH)","L"
			RETURN -500
