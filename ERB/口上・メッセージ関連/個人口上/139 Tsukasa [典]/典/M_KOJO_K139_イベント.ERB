;30日以上ほったらかしにすると典が狩人モードに（翌日来訪）
IF CFLAG:1042 == 1
	CFLAG:139:翌日来訪 = 1
	SIF TCVAR:139:発情 == 0
		TCVAR:139:発情 = 1
	PALAM:潤滑 = 5000
ENDIF
;冬の１～７日は典が必ず発情する
IF DAY:2 == 4 && GROUPMATCH(DAY:3,1,2,3,4,5,6,7)
	SIF TCVAR:139:発情 == 0
		TCVAR:139:発情 = 1
ENDIF
IF TALENT:妊娠願望
	;妊娠周期が排卵未満なら排卵誘発剤を飲む
	IF ESTRUS_CYCLE(TARGET) < 100
		IF FLAG:生理周期可視化 == 1
			PRINTFORML 츠카사는 %조사처리(CALLNAME:MASTER,"와")% 만나기 전에 배란유발제를 먹은 모양이야...
		ENDIF
		PRINTW 
		TCVAR:強制排卵 = 180
	ENDIF
ENDIF
;セフレ、愛欲なら一日の開始からすでに膣が濡れている
IF TALENT:愛欲
	IF TALENT:性別 == 2 || TALENT:性別 == 3
		CALL HPH_PRINT,@"「아아, %CALLNAME:MASTER%어디, 빨리 안 오는 건가…… HPH 혼자 자위만 하고 있는 것으론 부족해……. HPH」","L"
