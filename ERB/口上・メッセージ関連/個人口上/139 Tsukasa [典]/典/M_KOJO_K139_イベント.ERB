;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================

@M_KOJO_MESSAGE_COM_K139_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「ふふっ、お手柔らかに」
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE 残りムシ数
				CASE 3
					RESULTS = 「ふぅむ、ここは%MUSHI_NAME%にしましょうか」
				CASE 2
					RESULTS = 「…次、%MUSHI_NAME%（手を誤った？）」
				CASE 1
					RESULTS = 「…ええい、%MUSHI_NAME%！（こんなはずじゃ…私が負けるはずない！）」
			ENDSELECT
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「横から来ますよ、気を付けてくださいね」
				CASE 1
					RESULTS = 「上から来ますよ、気を付けてくださいね」
				CASE 2
					RESULTS = 「ふふふ、%MUSHI_NAME%は遠距離戦が得意ですよ。いや、近距離戦だったかな？」
			ENDSELECT
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE 残りムシ数
				CASE 2
					RESULTS = 「ふむ、倒されてしまいましたか」
				CASE 1
					RESULTS = 「そんなっ！？」
			ENDSELECT
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「私のささやき戦術が通用しないとは…」
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋慕 || TALENT:恋人
				RESULTS = 「遊戯とはいえ真剣勝負ですからねぇ」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						RESULTS = 「ざこ%UNICODE(0x2665) *1%　ざぁこ%UNICODE(0x2665) *1%」
					CASE 1
						RESULTS = 「手加減してくださってありがとうございます♪」
					CASE 2
						RESULTS = 「言葉に惑わされて、勝手に自滅してくれたわね♪」
				ENDSELECT
			ENDIF
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「いやあ、%CALLNAME:MASTER%どの、お強い」
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			;		RESULTS = 「やったー！」
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			;		RESULTS = 「くやし～！」
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			;		RESULTS = 「私のおかげね！」
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「あなたが気に病むことではありません。あなたの虫が弱かっただけなのです」
				CASE 1
					RESULTS = 「いやはや、私の虫たちは申し分なかったのですが…」
				CASE 2
					RESULTS = 「私は気にしていませんよ。あなたもお気になさらずに」
			ENDSELECT
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1
;==================================================
;引力操作
;TCVAR:引力点に場所IDを入れるとその地点に引っ張られていきます
;場所IDと同じ拠点マップでしか効果はありません（博麗神社の境内なら拠点が博麗神社のときだけ）
;条件を付けないと永久に引っ張られ続けるので注意
;RANDは基本的に使えません。CFLAG:今日の運勢にその日のランダム数値（0～999）が入っているのでこれを使うと良いです
;==================================================

@M_KOJO_EVENT_K139_GRAVITY(ARG)
;IF TCVAR:374 >= 500 || TCVAR:利尿剤 || (CFLAG:MASTER:現在位置 == 14 || CFLAG:MASTER:現在位置 == 236 || CFLAG:MASTER:現在位置 == 316 || CFLAG:MASTER:現在位置 == 322 || CFLAG:MASTER:現在位置 == 824)
IF TCVAR:374 >= 500 || TCVAR:利尿剤 || IN_TOILET(CFLAG:MASTER:現在位置)
	;神社在住
	IF MAIN_MAP == 0
		TCVAR:引力点 = 14
		;人里在住
	ELSEIF MAIN_MAP == 2
		TCVAR:引力点 = 236
		;紅魔館在住
	ELSEIF MAIN_MAP == 3
		TCVAR:引力点 = 316
		;		TCVAR:引力点 = 322
		;※改変注：２つは指定できません
		;山頂在住
	ELSEIF MAIN_MAP == 8
		TCVAR:引力点 = 824
	ENDIF
ELSE
	SIF CFLAG:1042 == 1
		TCVAR:引力点 = CFLAG:MASTER:現在位置
ENDIF
;※改変注：IN_TOILET(CFLAG:MASTER:現在位置)←これでMASTERがトイレにいるときとして使えます
;==================================================
;セフレ契約用
;==================================================
;"補正"でRETURNした数値が理性判定に加算されるので、
;簡単にセフレにしたいならマイナス、難易度を上げたかったり実質不可能にしたいならプラスすべし

@KOJO_SF_CONTRACT_EVENT_K139(ARGS)
SELECTCASE ARGS
	CASE "導入"
		;PRINTFORML 「セフレって、ええー」
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			IF TALENT:MASTER:SexKnow == -1
				PRINTFORML 「무슨 일이야? 누나에게 하고 싶은 말이 있니?」
				PRINTFORML 「……, ……! 어라어라, 뭐 뭐…♪」
				PRINTW 
				CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")%, 언니랑 가랑이 비비기 놀이, 더 하고 싶단 말이야... 흣」","L"
				CALL HPH_PRINT,@"「그렇네요 HPH. 부대끼는 거, 기분 좋잖아요 HPH」","L"
				PRINTW 
