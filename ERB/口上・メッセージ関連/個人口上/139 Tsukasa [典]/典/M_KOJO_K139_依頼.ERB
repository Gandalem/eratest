			;水やりした時、依頼主である口上主がTARGETの場合
			;この場合はそのまま下の口上へ続きます
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
