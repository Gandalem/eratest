		ELSEIF TFLAG:193 == -1
			;ハズレの選択肢
		ELSEIF TFLAG:193 == -2
			;正解の選択肢だったが逆にハズレ
		ENDIF
		RETURN 0
	CASE "成功報告時"
		;報酬：野菜か果物
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
