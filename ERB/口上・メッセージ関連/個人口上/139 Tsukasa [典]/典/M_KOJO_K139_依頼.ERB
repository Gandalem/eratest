	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;【◆口上】
		;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
