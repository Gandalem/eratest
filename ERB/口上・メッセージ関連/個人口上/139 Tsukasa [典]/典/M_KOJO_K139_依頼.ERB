		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			IF CFLAG:1020 == 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%……♪ 언니랑 또 '좋은 일' 하자고……♪」
				PRINTFORML 츠카사가 자신의 아랫배를 쓸어내리며 유혹해 왔다.
				PRINTW 
			ELSE
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"를")% 어떤 어른이랑 '좋은 거' 하지 않을래요……♪」
				PRINTFORML 츠카사는 %조사처리(CALLNAME:MASTER,"를")% 뒤에서 안고 말을 건넸다
				PRINTW 
				PRINTFORML 「어려운 거 아니에요. 언니를 기분 좋게 해주면 그걸로 괜찮아요...♪」
				IF TALENT:MASTER:SexKnow == -1
					PRINTFORML 「……아우, 정말 뭘 하면 좋을지 모르는 표정이네요…」
					PRINTFORML 「어려운 일 아니에요. 누나의 지시대로 몸을 쓰다듬거나, 풀어주기만 해주면 돼요♪」
					PRINTFORML 「열심히 해준다면, 잔뜩 용돈도 줄게요♪」
				ELSE
					IF TALENT:MASTER:非童貞 == 0
						PRINTFORML 「경험은 없어도 알 수 있지요? 언니의 엉덩이 같은 걸 자꾸 흘긋흘긋 보고 있어요♪」
						PRINTFORML 츠카사는 씨익 웃으며, 귓가에 살짝 속삭인다.
						SETCOLOR 0xFF69B4
						CALL HPH_PRINT,@"「언니랑 섹스하자…… HPH」","L"
						RESETCOLOR
					ELSE
						CALL HPH_PRINT,@"「그렇죠. 언니랑 섹스해 주면 되잖아요…… HPH」","L"
						CALL HPH_PRINT,@"「언니를 많이 기분 좋게 해준다면 용돈도 줄게요 HPH」","L"
						PRINTW 
						PRINTFORML 그렇게 말하며, 츠카사는 이마를 내밀었다.
						CALL HPH_PRINT,@"「어때요? 나쁜 조건은 아닐 거라고 생각하는데…… HPH」","L"
						PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 배를 쓰다듬으면서, 츠카사는 대답을 기다리고 있다.
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:1020 == 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%……♪ 또 \@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 거시기 # 몸을 \@ 빌려주시면 안 될까요♪」
				PRINTFORML 츠카사가 %조사처리(CALLNAME:MASTER,"의")% 하복부를 쓰다듬으며 유혹해 왔다
				PRINTW 
				CALL HPH_PRINT,@"「\@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 안에 다 해줘도 좋아 HPH #  \@ 마음껏 범해도 좋은 여자 여우 몸의 아픔을 진정시켜 주세요…HPH」","L"
				PRINTW 
