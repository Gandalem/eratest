								PRINTL 
								CALL HPH_PRINT,@"뿌루루읏 햣ㅍㅎ","L"
								CALL HPH_PRINT,@"　　부쿠부쿠읏 HPH","L"
								PRINTL 
								CALL HPH_PRINT,@"『!! 응응 큭! 응응~~~~~ 큭』","L"
								SELECTCASE RAND:2
									CASE 0
