										CALL HPH_PRINT,@"「후후, 입안이 아이 씨로 가득해 HPH 좋아요. 꿀꺽 삼켜버려요 HPH」","L"
										PRINTL 
										CALL HPH_PRINT,@"『응끅, 응끅, 컥흡... HPH를 마셨어요... HPH』","L"
										CALL HPH_PRINT,@"「잘 해줬어요, %CHILDNAME:139:(TALENT:139:育児中)%HPH」","L"
