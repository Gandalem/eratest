@M_KOJO_EVENT_K139_CHILD_RAISING_TOY(ARGS,ARG,ARG:1)
IF ARGS == "幼児期"
	SELECTCASE RAND:2
		CASE 0
			IF ITEM:ローター
				PRINTFORML %CHILDNAME:139:(TALENT:139:育児中)%는 부들부들 떨리는 분홍색 물체를 보며 깔깔 웃고 있다...
			ELSEIF ITEM:バイブ || ITEM:アナルバイブ
				PRINTFORML %CHILDNAME:139:(TALENT:139:育児中)%는 시끄러운 진동음을 내는 바이브를 격자창에 박고 천진난만하게 놀고 있다…
			ELSEIF ITEM:Ｅマッサージャ
				PRINTFORML %CHILDNAME:139:(TALENT:139:育児中)%는 요란한 소리를 내는 전기 마사지기를 바닥에 대고, 기묘한 소리가 날 때마다 깔깔 웃고 있다…
			ELSEIF ITEM:オナホール
				PRINTFORML %CHILDNAME:139:(TALENT:139:育児中)%는 오나홀에 물을 채우고, 물총처럼 푸슉푸슉 하고 물을 쏘며 놀고 있다…
			ELSEIF ITEM:コンドーム
				PRINTFORML %CHILDNAME:139:(TALENT:139:育児中)%는 콘돔을 풍선으로 착각하고 부풀리고 있다……
			ELSEIF ITEM:クリキャップ
				PRINTFORML %CHILDNAME:139:(TALENT:139:育児中)%는 클리캡을 손가락 끝에 붙이고, 꽉 조여질 때마다 「오옷? 오옷?」하며 놀라고 있다.
			ENDIF
		CASE 1
			PRINTDATAL
				DATAFORM %CHILDNAME:139:(TALENT:139:育児中)%은 달마 떨구기에서 몸통을 너무 세게 날려 버려 찻잔을 깨뜨리고 허둥대고 있다…
				DATAFORM %CHILDNAME:139:(TALENT:139:育児中)%은 「초~전기 팽이앗!」이라고 외치며 굵은 나무에 팽이를 부딪치면서 놀고 있다…
				DATAFORM %CHILDNAME:139:(TALENT:139:育児中)%는 블록으로 네오 암스트롱 사이클론 제트 암스트롱 포를 재현하고 있다… 완성도 높네, 이 녀석아
				DATAFORM %CHILDNAME:139:(TALENT:139:育児中)%는 커다란 잎사귀 위에 진흙 경단을 올리고, 장난감 컵에 물을 부은 다음 그 근처에 나뭇가지 두 개를 놓고 있다…
				DATAFORM %CHILDNAME:139:(TALENT:139:育児中)%이 찬 공은 %TEXTR("崖下に吸い込まれて行ってしまった…/木に跳ね返り、%CHILDNAME:139:(TALENT:139:育児中)%を直撃した/あらぬ方向へ飛んでいった…/上手にまっすぐ飛んでいった")%
				DATAFORM %CHILDNAME:139:(TALENT:139:育児中)%은 나무로 만든 동물 퍼즐%TEXTR("のピースを楽々とはめている/に苦戦している/に飽きて動物同士を戦わせている")%
			ENDDATA
	ENDSELECT
ELSEIF ARGS == "幼少期"
	PRINTFORML 『토토님, 장난감으로 놀아요~』
ELSE
	PRINTFORML 
ENDIF
