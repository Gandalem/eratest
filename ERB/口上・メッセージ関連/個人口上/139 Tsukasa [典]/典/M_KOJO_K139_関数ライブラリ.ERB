@K139_OPTION
#DIM 娘の悪戯設定
PRINTFORML [0] 자위 지원 현재 설정: {CFLAG:1008}
PRINTFORML [1] 딸의 장난 설정 현재 설정: {CFLAG:1997}
PRINTFORML [2] 모브 텐구 이벤트 설정 현재 설정: {CFLAG:1045}
PRINTFORML [3] 모브 카프카 이벤트 설정 현재 설정: {CFLAG:1046}
PRINTFORML [4] 게센나키츠네 이벤트 설정 현재 설정: {CFLAG:1047}
PRINTFORML [999] 설정 완료
$INPUT_LOOP
INPUT
IF RESULT == 0
	IF CFLAG:1008 == 2
		PRINTFORML 「후후, 또 나한테 자위하는 거 도와달라고 하고 싶어졌나요?」
		CALL ASK_M("재개해 달라고 부탁한다.", 1,"보류", 1,"완전히 끊는다", 1)
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「알겠습니다. 그렇다면, 그 때가 왔을 때 다시 도와드리겠습니다.」
				PRINTFORML 플래그가 온(1)이 되었다
				CFLAG:1008 = 1
			CASE 1
				PRINTFORML 「그렇습니까. 필요하시면 다시 불러주세요」
				PRINTFORML 플래그가 보류(2) 상태로 변경되었습니다.
			CASE 2
				PRINTFORML 「아라, 그거 아쉽네요. 마음에 들지 않으셨나요?」
				PRINTFORML 「억지로 시킬 수는 없으니까요. 그럼 계약은 종료로……」
				PRINTFORML 「지금까지 잘 봐주셔서 정말 감사했습니다」
				PRINTFORML 플래그가 완전히 정지(3) 상태가 되었다
				CFLAG:1008 = 3
		ENDSELECT
	ENDIF
	RESTART
ELSEIF RESULT == 1
	;娘があなたにいけない悪戯してくるフラグ
	IF (CFLAG:139:1997 > 0)
		PRINTFORML 딸의 장난은……
		CALL ASK_M("당신 ON", 1,"묘사 OFF", 1,"당신/학생 ON", 1,"당신과 선을 넘는 ON・학생 OFF", 1,"당신과 선을 넘는 · 학생 ON", 1)
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 유년기 이후부터 당신에게 성적인 접촉을 하는 묘사를 켜겠다(1).
				CFLAG:139:1997 = 1
			CASE 1
				PRINTFORML 유년기 이후, 당신과 서당 학생들에게 성적인 접촉을 하는 묘사를 꺼서 설정합니다.
				CFLAG:139:1997 = 2
			CASE 2
				PRINTFORML 유년기 이후, 당신과 서당의 학생들에게 성적인 접촉을 하는 묘사를 온(3)으로 설정합니다.
				CFLAG:139:1997 = 3
			CASE 3
				PRINTFORML 유년기 이후부터 당신에게 생으로 하는 묘사를 온, 학생 묘사를 오프(4)로 설정합니다
				CFLAG:139:1997 = 4
			CASE 4
				PRINTFORML 유년기 이후부터 당신에게 성교하는 묘사/생물 묘사를 켬(5)으로 설정한다
				CFLAG:139:1997 = 5
		ENDSELECT
	ENDIF
	RESTART
ELSEIF RESULT == 2
	PRINTL 모브 텐구 이벤트 「부슉부슉이크 신문」을……
	CALL ASK_M("이벤트를 꺼라", 1,"이벤트를 온", 1)
	SELECTCASE RESULT
		CASE 0
			PRINTL 이벤트를 꺼요 (-1)로 합니다
			CFLAG:1045 = -1
		CASE 1
			PRINTL 이벤트를 꺼(0)로 설정한다
			CFLAG:1045 = 0
	ENDSELECT
	RESTART
ELSEIF RESULT == 3
	PRINTL 모브 카라파 이벤트 「절정해서 쑤셔대는 카라파」를……
	CALL ASK_M("이벤트를 꺼라", 1,"이벤트를 온", 1)
	SELECTCASE RESULT
		CASE 0
			PRINTL 이벤트를 꺼요 (-1)로 합니다
			CFLAG:1046 = -1
		CASE 1
			PRINTL 이벤트를 꺼(0)로 설정한다
			CFLAG:1046 = 0
	ENDSELECT
	RESTART
ELSEIF RESULT == 4
	PRINTL 이벤트 「게센나키츠네는 성욕을 감당하지 못한다」의 체력 등 감소를……
	CALL ASK_M("감소를 해제한다", 1,"감소를 켜기(기존 상태 그대로)", 1)
	SELECTCASE RESULT
		CASE 0
			PRINTL 감소를 해제(-1)로 설정한다.
			CFLAG:1047 = -1
		CASE 1
			PRINTL 감소를 꺼라(0)
			CFLAG:1046 = 0
	ENDSELECT
	RESTART
ELSEIF RESULT == 999
	RETURN 1
ELSE
	GOTO INPUT_LOOP
ENDIF
