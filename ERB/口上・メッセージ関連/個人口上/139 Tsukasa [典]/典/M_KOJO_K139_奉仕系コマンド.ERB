						CALL HPH_PRINT,@"「네, 네. HPH라면, 그 소원 들어 드릴게요, HPH」","L"
						CALL HPH_PRINT,@"「그러니까, %CALLNAME:MASTER%어떤 초라한 모습이든, 츠카사에게 전부 보여주세요... HPH」","L"
						PRINTW 
