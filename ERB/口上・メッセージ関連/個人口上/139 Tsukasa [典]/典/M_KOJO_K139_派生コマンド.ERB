									CALL HPH_PRINT,@"「주기적으로 짜지 않으면 금방 딱딱해져서…… 다행이에요 HPH」","L"
									CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 곳도, 주기적으로 짜주는 게 좋을 것 같은데요…… HPH」","L"
									PRINTW 
