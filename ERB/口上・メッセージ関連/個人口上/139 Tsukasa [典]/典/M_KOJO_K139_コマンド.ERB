@M_KOJO_MESSAGE_COM_K139_189_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;服を着てない（ノーブラ・パンツありはブラを自由に変更できないので多分できない）
		IF TEQUIP:5 && TEQUIP:0 & 0
			PRINTFORML 「이게 소문으로 듣던 '나체 에이프런'이라는 건가요……」
			;下着あり
			IF EQUIP:下半身下着１ || EQUIP:下半身下着２
				PRINTFORML 「뭐, 일단 속옷은 입고는 있어요」
				PRINTFORML 「아니면, 속옷도 벗어버리는 게 좋을까요? 아・나・타%UNICODE(0x2665) *1%」
				PRINTW 
			ELSE
				PRINTFORML 「왠지 서늘해서 마음이 놓이지 않네요...」
				PRINTFORML 「혹시, 이 모습으로 집안일을 하라는 건가요?」
				CALL HPH_PRINT,@"「안 돼요, 이런 옷차림으로 청소 같은 거 하면, 중요한 부분이 다 보일지도 몰라요……후훗」","L"
				CALL HPH_PRINT,@"「그리고, 흥분한 %조사처리(CALLNAME:MASTER,"에게")% 습격당할지도 몰라요…… HPH」","L"
				CALL HPH_PRINT,@"「만약 그렇게 된다면... 츠카사는 저항하지 못하고 제압당해 버릴지도 몰라요... HPH」","L"
				PRINTW 
			ENDIF
		ELSE
			PRINTFORML 「오오, 이거 신선하네요~」
			PRINTFORML 「저는 오히려 가풍옷 쪽이 취향이라서요」
			PRINTFORML 「쪽이 확실히 새신부 느낌은 나네요%UNICODE(0x2665) *1%」
			PRINTW 
			PRINTFORML 「그럼, 정석적인 거 한번 해볼까요?」
			CALL ASK_YN("제일 좋은 걸 부탁해.","괜찮아, 문제 없어.")
			IF !RESULT
				PRINTFORMW 「알겠습니다♪」
				PRINTFORML 「당신, 오늘도 수고했어요%UNICODE(0x2665) *1%」
				PRINTFORML 「밥 드실래요? 목욕하실래요? 아니면, 저랑요?」
				PRINTW 
			ELSE
				PRINTFORML 「아앙, 못된 거야」
				PRINTFORML 츠카사는 가슴 앞에서 손을 모으고 몸을 꿈틀거리고 있다.
				PRINTW 
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:新妻プレイ
		PRINTFORML 「후후, 또 이러시는 거예요?」
		IF TEQUIP:5 && TEQUIP:0 & 0
			IF DAY:2 == 4
				PRINTFORML 「추워! 추워요옷!」
				PRINTFORML 츠카사는 몸을 끌어안고 부르르 떨고 있다.
				PRINTW 
				;下着あり
			ELSEIF EQUIP:下半身下着１ || EQUIP:下半身下着２
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「속옷을 벗기지 않는 건, 뭔가 마니아적이라네요~」
					CASE 1
						PRINTFORML 「속옷을 벗기지 않는 건, 뭔가 고집이 있으신 걸까요?」
						PRINTFORML 「츠카사는 %조사처리(CALLNAME:MASTER,"가")% 어떤 게 기뻐하시든 뭐든지 괜찮아요」
				ENDSELECT
				PRINTW 
			ELSE
				SELECTCASE RAND:3
					CASE 0
						IF TALENT:TARGET:バストサイズ >= 0
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 츠카사의 벌거벗은 에이프런을 어떠세요?」
									PRINTFORML 츠카사는 가슴을 강조하듯 앞으로 몸을 숙이고 있다.
								CASE 1
									PRINTFORML 「에이프런에서 가슴이 흘러넘칠 것 같다.」
									PRINTFORML 「많이 숨기지 못하고 있군.」
								CASE 2
									SELECTCASE RAND:2
										CASE 0
											PRINTFORML 가슴이 없어서, 살구색 돌기가 자꾸 언뜻 비쳐 보여……
											PRINTFORML 「가슴이 쓸려서…… 좀 이상한 기분이야……%UNICODE(0x2665) *1%」
										CASE 1
											PRINTFORML 「후후, 옆에서 보이는 가슴이라는 것도 나름 멋진 거겠죠~♪」
									ENDSELECT
							ENDSELECT
						ELSE
							PRINTFORML 「나에게 더 큰 가슴이 있다면, %조사처리(CALLNAME:MASTER,"를")% 어떻게 유혹할 수 있을까…」
							PRINTFORML 틈새로 보이는 작은 가슴과 분홍빛 봉긋함이 지고함을 최고의 존재라 일깨워 주었다.
							CALL HPH_PRINT,@"「이제…… %조사처리(CALLNAME:MASTER,"는")%, 에치…… HPH」","L"
						ENDIF
						PRINTW 
					CASE 1
						PRINTFORML 「후후, 엉덩이는 보여주지 않을 거야 %UNICODE(0x2665) *1%」
						PRINTFORML 츠카사는 일부러 애태우듯, 꼬리로 엉덩이를 가리고 있다.
					CASE 2
						PRINTFORML 「청소하고 있을 때, 뒤에서 훔쳐보면 안 돼요?」
				ENDSELECT
				PRINTW 
			ENDIF
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「굳이 이걸로 갈아입고 이런 걸 하다니……」
					PRINTFORML 「이게 '시추에이션 플레이'라는 건가요?」
				CASE 1
					PRINTFORML 「당신, 오늘 많이 해줘요……%UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORML 「이걸 하고 있으면 %조사처리(CALLNAME:MASTER,"는")% 어떤 신부처럼 보일까요…%UNICODE(0x2665) *1%」
			ENDSELECT
			PRINTW 
			RETURN 1
		ENDIF
		;終了
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「안 돼, 안 뺄 거야」
				PRINTFORML 벗으라고 말하자, 츠카사로부터 예상치 못한 저항이 있었다.
			CASE 1
				PRINTFORML 「에엥~ 벗겨버리실 거예요?」
			CASE 2
				PRINTFORML 「더 입고 싶었는데……」
		ENDSELECT
		PRINTW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
