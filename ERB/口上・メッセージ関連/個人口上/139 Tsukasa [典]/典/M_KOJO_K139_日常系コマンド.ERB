;626,土産屋
;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================

@M_KOJO_MESSAGE_COM_K139_626
CALL M_KOJO_MESSAGE_COM_K139_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K139_626_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
		SELECTCASE TFLAG:194
			;ひやかし
			CASE -2
				PRINTFORML 「저 가게 주인, 화가 나 있었다.」
				PRINTFORML 「다음에는 무언가를 사 주자.」
				PRINTW 
				;やっぱりやめる（見送り）
			CASE -1
				PRINTFORML 「이런 거 같은 건 없었나요?」
				PRINTFORML 「언니도 오늘은 괜찮을까아」
				PRINTW 
				;400点未満（BAD）
			CASE 1
				PRINTFORML 「음음음, 음~~~, 음음~……」
				PRINTFORML 「아, 고마워…… 언니, 기쁜 걸까...? 기쁠지도...」
				PRINTFORML 츠카사가 서투른 거짓말을 할 정도였던 믿기 힘든 선물이었을지도 모른다...
				;400点～699点（NOMAL）
			CASE 2
				PRINTFORML 「응~ ♪ 누나, 기뻐요♪」
				IF TALENT:恋人
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 열심히 고민하고, 언니가 기뻐해 줄까 골라준 선물인걸요」
					PRINTFORML 「금전적인 가치가 있다면 확실히 의미 있다고 할 수 있지만… 그것만이 가치관은 아니에요」
					PRINTFORML 「복잡하게 말했지만, 언니한테는 이 선물이 최고라는 거예요♪」
					PRINTW 
				ELSE
					PRINTFORML 「뭘 드리고 싶은지도 중요하지만… 그쪽이 뭘 받으면 기뻐할지, 생각을 짜보는 것도 중요한 거예요」
					PRINTFORML 「아무리 비싼 것이라도 흥미가 없다면 그분에게는 고철이나 쓰레기에 불과하니까요」
					PRINTFORML 「좋아하는 사람이 생기면, 그 점에 신경 쓰는 거예요」
					SIF TALENT:恋慕
						PRINTFORML (만약 나를 좋아해 준다면……아니, 없을까요)
					PRINTW 
				ENDIF
				;700点以上（GOOD）
			CASE 3
				IF TALENT:恋人
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"를")% 어디… 이거…」
					PRINTFORML 「기뻐…… 언니, 계속 소중히 간직할게요……%UNICODE(0x2665) *1%」
					PRINTFORML 평소의 장난치는 듯한 모습이 아니라, 츠카사는 조용히 %조사처리(CALLNAME:MASTER,"를")% 안아왔다
					PRINTW 
				ELSE
					PRINTFORML 「벌써… 이렇게 멋진 걸 선물 받으면…… %조사처리(CALLNAME:MASTER,"는")% 점점 더 좋아하게 되잖아요…%UNICODE(0x2665) *1%」
					PRINTFORML 「누나, 농담하는 것처럼 보이나요?」
					PRINTFORML 「고마워요, %CALLNAME:MASTER%님. 누나가 계속 소중히 간직할게요」
					PRINTW 
				ENDIF
		ENDSELECT
	ELSE
		SELECTCASE TFLAG:194
			;ひやかし
			CASE -2
				PRINTFORML 「저 가게 주인분, 화나셨었네에」
				PRINTFORML 「너무 가볍게 구시면 안 돼요?」
				PRINTFORML 그렇게 말하면서도 잔뜩 물건에 대한 질문을 퍼붓고 있던 건 츠카사였던 것 같지만……
				PRINTW 
				;やっぱりやめる（見送り）
			CASE -1
				PRINTFORML 「이런 기념품 같은 건 없었나요?」
				PRINTFORML 「저도 눈에 띄는 것은…… 아쉽네요」
				PRINTW 
				;400点未満（BAD）
			CASE 1
				PRINTFORML 「아니, 아니야…… %조사처리(CALLNAME:MASTER,"는")% 도대체…」
				PRINTFORML 「선물을 할 생각이 있다면, 좀 더 생각해 주세요…」
				PRINTFORML 「뭐든지 주면 여자가 기뻐할 거라고 생각하는 건 큰 착각이에요」
				PRINTW 
				;400点～699点（NOMAL）
			CASE 2
				PRINTFORML 「감사합니다. 후후, 감사히 받겠습니다네」
				PRINTW 
				;700点以上（GOOD）
			CASE 3
				PRINTFORML 「이걸, 저한테…?」
				PRINTFORML 「……아니에요, 감사합니다. 소중히 간직할게요」
				PRINTFORML 츠카사는 장난치는 기색 없이 선물을 조심스럽게 가슴에 품고 얼굴을 붉혔다
				PRINTW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
