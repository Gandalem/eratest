;449,虫捕り
;TFLAG:193,
;   -2=殺してでもうばいとる（取っ組み合いの末逃がす）
;   -1=ゆずってくれ！→拒否
;    0=捕獲失敗
;    1=MASTERが捕まえた
;    2=キャラが捕まえたのをMASTERが褒めた
;    3=ゆずってくれ！→渋々オッケー
;    4=ゆずってくれ！→オールオッケー
;TRAINMESSAGEを省略する場合は虫カゴに入れる処理を忘れないように
;ムシの名前は MUSHI_NAME で表示したり判別したりできます
;==================================================

@M_KOJO_MESSAGE_COM_K139_449
CALL M_KOJO_MESSAGE_COM_K139_449_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K139_449_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		;殺してでも　うばいとる！
		CASE -2
			PRINTFORML 「뭐, 뭐 하시는 거예요, %CALLNAME:MASTER%어디-!」
			;ゆずってくれ　たのむ！→拒否
			;ABL:CHARA:従順 < 6 || ABL:CHARA:親密 < 6 || MARK:CHARA:反発刻印 || TALENT:CHARA:機嫌 < 0
		CASE -1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「죄송하지만, 이건 이이즈모마루님께 바치는 거라서요……」
				CASE 1
					PRINTFORML 「죄송해요. 이건 중요한 용도가 있으니까……」
			ENDSELECT
			IF (TALENT:愛欲 || TALENT:セフレ) && TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3
				PRINTFORML 대신 이 희귀한 벌레를 만지게 해 주겠다고, %조사처리(CALLNAME:MASTER,"는")% %TINKO(PLAYER)%를 노출시켰다.
				IF CFLAG:TARGET:溜まってる度 >= 500
					PRINTFORMW 「！」
					PRINTFORML 「안 돼…… 안 돼요…… %조사처리(CALLNAME:MASTER,"의")% 부탁이라 해도, 이 벌레를 넘겨드릴 수는……」
					PRINTW 
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 말없이 츠카사의 코끝에 %TINKO(PLAYER)%를 가까이 가져간다.
					CALL HPH_PRINT,@"「오, 오, 오옷... HPH의 거친 냄새를 맡아봐도 안 되는 건, 안 돼요... HPH」","L"
					PRINTW 
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %TINKO(PLAYER)%로 노리의 뺨을 때리거나, 코 구멍에 밀착시키기도 했다.
					CALL HPH_PRINT,@"「으응... HPH, 거시기 냄새 나잖아... HPH, 안 된단 말이야아... HPH」","L"
					PRINTL 
					PRINTFORML 츠카사는 벌레를 양보하는 것은 거절했지만, 성기의 유혹에 욕구불만을 쌓은 듯하다...
					CFLAG:TARGET:溜まってる度 += 200
				ELSE
					PRINTFORML 「정말이지... 뭘 하고 계신 거예요. 아무리 \@ (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行) ? 언니 # 츠카사 \@라도, 그 손에는 오르지 않을 거예요」
					PRINTFORML 그렇게 말하면서도, 츠카사의 시선은 %조사처리(CALLNAME:MASTER,"의")% %TINKO(PLAYER)%에 한 점 집중되어 있었다...
				ENDIF
			ENDIF
		CASE 0
			PRINTFORML 「안, 아쉽네요……」
		CASE 1
			IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「훌륭해! %조사처리(CALLNAME:MASTER,"는")% 벌레잡기 명수시네요♪」
					CASE 1
						PRINTFORML 츠카사가 「오오~」라며 %조사처리(CALLNAME:MASTER,"에게")% 박수를 보내고 있다.
					CASE 2
						PRINTFORML 「대단해 대단해♪ %조사처리(CALLNAME:MASTER,"는")% 어떤 벌레를 잡는 게 특기시네요♪」
						PRINTFORML 츠카사는 %조사처리(CALLNAME:MASTER,"의")% 머리를 부드럽게 쓰다듬었다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「대단하시네요. 어릴 때부터 잘하셨던 건가요?」
						PRINTFORML 오히려 지금도 현역이라고 대답하자 츠카사는 미묘한 표정을 지었다.
					CASE 1
						PRINTFORML 「훌륭하셨어요, %CALLNAME:MASTER%님♪」
				ENDSELECT
			ENDIF
		CASE 2
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「후후후, 요괴의 산 벌레잡기 퀸이란 바로 이 \@ (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行) ? 언니 # 츠카사 \@를 말하는 거예요♪」
				CASE 1
					PRINTFORML 츠카사가 무언가 말해 주길 바라는 듯 슬쩍 이곳을 바라보는 바람에, 「그 벌레 정말 대단하네요」라며 칭찬해주었다.
					PRINTFORML 「후후후, 그 정도는 아니지만…… 있답니다!」
					PRINTFORML 체면치란 기색 없이 거만한 표정을 지어 보이는 츠카사.
			ENDSELECT
			;ゆずってくれ　たのむ！→渋々
			;IF ABL:CHARA:従順 < 8 || ABL:CHARA:親密 < 8
		CASE 3
			IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
				PRINTFORML 「어쩔 수 없죠. %조사처리(CALLNAME:MASTER,"가")% 무슨 부탁을 하시면, 누나는 거절 못하잖아요」
				PRINTFORML 츠카사는 겉으로는 마지못해 하면서도, %조사처리(CALLNAME:MASTER,"가")% 기뻐하는 모습을 보고 다정한 미소를 짓고 있다
			ELSE
				PRINTFORML 「어쩔 수 없네요. 이번만 특별히 해드릴게요」
				PRINTFORML 벌레를 받고 기뻐하는 %조사처리(CALLNAME:MASTER,"를")% 보며, 츠카사는 쓴웃음을 지었다.
			ENDIF
			;ゆずってくれ　たのむ！→オッケー
		CASE 4
			PRINTFORML 「물론, 괜찮지만……」
			IF TALENT:MASTER:性別 == 2
				IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
					PRINTFORML 「남자애들은 벌레가 제일 좋네요~」
				ELSE
					PRINTFORML 「남자분들은 몇 살이 지나도 벌레를 정말 좋아하시는군요」
				ENDIF
			ELSE
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 인간의 여성인데, 벌레를 좋아하는군요네에」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
