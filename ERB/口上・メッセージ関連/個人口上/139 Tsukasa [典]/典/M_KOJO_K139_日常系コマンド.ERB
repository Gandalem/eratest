						ENDIF
						;発情してない・年齢分岐おわり
					ENDIF
					;発情分岐・おわり
				ENDIF
				;温泉イベントを見ない
			ELSE
				;温泉イベント分岐・おわり
			ENDIF
			;地獄の温泉・一緒に入っていない
		ELSEIF CFLAG:MASTER:現在位置 == 940 && CFLAG:TARGET:6 < 1
