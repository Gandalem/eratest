@M_KOJO_MESSAGE_COUNTER_K139_4
CALL M_KOJO_MESSAGE_COUNTER_K139_4_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K139_4_1
IF TCVAR:発情
	PRINTFORML 체취라고 부르기엔 어딘가 달콤하고, 향수향이라고 하기엔 어딘가 끈적이는 듯한,
	PRINTFORML 불쾌하지는 않지만 %조사처리(CALLNAME:MASTER,"를")% 현혹하는 냄새를 츠카사는 풍기고 있다…
	PRINTL 
	SETCOLOR 0xFF69B4
	SELECTCASE RAND:3
		CASE 0
			CALL HPH_PRINT,@"「후후, 무슨 일 있으세요…… HPH」","L"
		CASE 1
			CALL HPH_PRINT,@"「그렇게 냄새를 맡아지면…… 부끄러워져 버려요 HPH」","L"
		CASE 2
			CALL HPH_PRINT,@"「여자의 냄새를 함부로 맡아서 안 돼요…… HPH」","L"
	ENDSELECT
	RESETCOLOR
	PRINTL 
ELSE
	IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응, 왜 그래?」
				PRINTFORML 「아아, 혹시 언니 향을 맡았거나 그런 적은 없어?」
				PRINTL 
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")%, 에치……%UNICODE(0x2665) *1%」
				PRINTL 
			CASE 1
				PRINTFORML 「에, 좋은 냄새가 나?」
				PRINTFORML 「이제, 언니의 냄새 같은 거 맡고 %CALLNAME:MASTER%어디든 에로…%UNICODE(0x2665) *1%」
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 츠카사는 뒷머리를 쓸어 넘기며 목덜미를 드러낸다.
						PRINTFORML 「이렇게 하면, 더 좋은 냄새가 나나요...? %UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORML 츠카사는 살며 %조사처리(CALLNAME:MASTER,"를")% 품에 안고 가슴팍에 얼굴을 묻게 한다.
						PRINTFORML 「자, 이렇게 하면 더 알 수 있지 않아요……%UNICODE(0x2665) *1%」
						PRINTFORML 「야~앙, 부끄러지네, 귀엽잖아요 %UNICODE(0x2665) *1%」
				ENDSELECT
				PRINTL 
		ENDSELECT
	ELSE
		IF TALENT:恋慕 || TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아, 눈치채신 건가요? 은은하게 향수를 뿌려보았는데요…」
					PRINTFORML 「역시 %CALLNAME:MASTER%님이시네요 %UNICODE(0x2665) *1% 그런 점이 좋습니다 %UNICODE(0x2665) *1%」
					PRINTL 
				CASE 1
					PRINTFORML 「아, 그, 그렇군요... 아니이야, 하하하...」
					PRINTFORML 「사랑하는 사람에게 좋은 냄새라고 들으니, 의외로 부끄러운 거였네요... %UNICODE(0x2665) *1%」
					PRINTL 
				CASE 2
					PRINTFORML 「후후, 당연하잖아요, 그렇죠♪」
					PRINTFORML 「이 츠카사가 %조사처리(CALLNAME:MASTER,"를")% 위해서 밤낮으로 여자를 갈고닦고 있으니까요♪」
					PRINTL 
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「사람을 상대로 그런 짓을 한다면 범죄이다... %UNICODE(0x2665) *1%」
					PRINTFORML 「츠카사가 요괴라서 다행이네요♪」
					PRINTL 
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 소위……[냄새 페티시] 같은 걸 말씀하시는 건가요?」
					PRINTFORML 「좋은 냄새라고 해줘서 그렇게까지 나쁘진 않아요… 하지만 너무 열렬하게 맡아주시면 부끄럽잖아요… %UNICODE(0x2665) *1%」
					PRINTL 
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
