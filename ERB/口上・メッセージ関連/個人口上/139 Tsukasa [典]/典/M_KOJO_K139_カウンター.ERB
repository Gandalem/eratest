RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K139_24_1
IF TCVAR:発情
	IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
		SETCOLOR 0xFF69B4
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「어라, 도망가지 않네요…… HPH 아니면, 몸이 움직일 수 없게 되어버린 건가요...? HPH」","L"
				PRINTFORML 츠카사는 %조사처리(CALLNAME:MASTER,"의")% 손 위에 자신의 손을 포개고, 얼굴을 가까이 가져왔다……
			CASE 1
				CALL HPH_PRINT,@"「무슨 일이야? 얼굴이랑 귀가 새빨갛잖아……후훗」","L"
			CASE 2
				CALL HPH_PRINT,@"「누나, %조사처리(CALLNAME:MASTER,"가")% 너무 좋아서, 나도 모르게 장난치고 싶어져 버려요... 후후」","L"
				PRINTFORML 츠카사가 귓가에서 속삭일 때마다 뜨거운 숨결이 귓불에 닿아 몸을 떨었다...
				PRINTL 
		ENDSELECT
		RESETCOLOR
		PRINTL 
	ELSE
		SETCOLOR 0xFF69B4
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")%, 츠카사가 지금 어떤 기분인지 맞춰 주실 수 있나요... HPH」","L"
				RESETCOLOR
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 츠카사가 %조사처리(CALLNAME:MASTER,"의")% 손등에 노노자 모양을 그리고 있다……
					CASE 1
						PRINTFORML 츠카사는 %조사처리(CALLNAME:MASTER,"의")% 하복부를 바스락바스락 손가락으로 긁고 있다...
				ENDSELECT
			CASE 1
				CALL HPH_PRINT,@"「짜릿했나요? HPH 츠카사에게, 복수해도 괜찮아요…HPH」","L"
			CASE 2
				CALL HPH_PRINT,@"「있잖아, %CALLNAME:MASTER%어디, 해볼까……후훗」","L"
				RESETCOLOR
				PRINTFORML 츠카사가 귓가에서 속삭일 때마다 관능적인 떨림이 전신을 휘젓는다...
		ENDSELECT
		RESETCOLOR
		PRINTL 
	ENDIF
ELSE
	IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「우후후♪ 귀엽다♪」
				PRINTFORML 「언니에게 복수하고 싶습니까? 후후... 네, 어서 하세요♪」
				PRINTL 
			CASE 1
				PRINTFORML 「우후후♪ 그 반응, 순진해서 좋네요♪」
				PRINTL 
		ENDSELECT
	ELSE
		PRINTFORML 「%CALLNAME:MASTER%님, 잠깐만요, 작은 귀에 속삭이고 싶은 게…」
		PRINTFORML 「후우우우~~~~~!!%UNICODE(0x2665) *1%」
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「야호~ 걸렸네~ 아아, 아파! 아프다아 머리 비비지 말라고오옷」
				PRINTL 
			CASE 1
				PRINTFORML 「이야♪ 걸렸네, 어라, 귀 만지지 마아! 히야아아악 %UNICODE(0x2665) *1%」
				PRINTL 
			CASE 2
				PRINTFORML 「무슨 일이야? 얼굴이 새빨갛잖아~♪」
				PRINTL 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
