;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K139_50
CALL M_KOJO_MESSAGE_COM_K139_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K139_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕 || TALENT:恋人
		IF TCVAR:発情
			SETCOLOR 0xFF69B4
			CALL HPH_PRINT,@"「에엥~ HPH, 이쪽은 임신시키고 싶다구요 HPH. 생으로 해요오 HPHHPH」","L"
			RESETCOLOR
		ELSE
			IF TALENT:妊娠願望
				PRINTFORML 「에엣~, 우리 둘이 아이 만들기로 정했잖아요」
			ELSE
				IF TALENT:MASTER:万能孕ませ || TALENT:MASTER:妖怪孕ませ
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 어떤 씨든, 츠카사 같은 애들은 한 방에 임신해 버릴 거예요... HPH」","L"
					SIF TALENT:MASTER:濃厚精液
						CALL HPH_PRINT,@"「하지만, 콘돔이 터져 버리면 어떡하지, 츠카사 걱정돼…… HPH」","L"
				ELSE
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「아이를 가지는 건 하지 않고, 순수하게 섹스를 즐기고 싶으신 거군요... HPH」","L"
							CALL HPH_PRINT,@"「후후, 한 상자 다 쓸 정도로 많이 하자 HPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「츠카사는 %조사처리(CALLNAME:MASTER,"가")% 어떤 아이를 임신해도 상관없지만…… HPH」","L"
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 그럴 리가 없잖아요」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
		PRINTW 
		RETURN 1
		;それ以外
	ELSE
		IF TEQUIP:PLAYER:コンドーム
			IF ESTRUS_CYCLE(TARGET) == 15
				PRINTFORML 「오늘은 생으로 해도 괜찮은데…… 임신이 걱정돼?」
			ELSE
				CALL HPH_PRINT,@"「후후, 나 콘돔 붙이고 하는 것도 싫지 않아요 HPH」","L"
				CALL HPH_PRINT,@"「굳이 콘돔을 쓴다는 건, 아이를 만들 목적이 아니라 섹스가 목적인 거잖아요 HPH」","L"
				CALL HPH_PRINT,@"「아아, 이분은 저를 범하고 싶어서 참을 수가 없구나 하고 상상해 버리면 젖어버려요…… HPH」","L"
			ENDIF
		ELSE
			CALL HPH_PRINT,@"「역시, 생으로 하고 싶으시죠... HPH」","L"
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
