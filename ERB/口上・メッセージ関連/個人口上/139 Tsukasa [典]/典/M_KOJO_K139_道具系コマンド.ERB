							CASE 3
								CALL HPH_PRINT,@"「더!! HPH 더!! HPH 오망코옷 HPH 밀어붙여줘읏 HPHHPH」","L"
							CASE 4
								CALL HPH_PRINT,@"「전마앗, 야바아 HPH 응오옷HPH 어옷HPH 어옷HPH 응오오옷HPH」","L"
						ENDSELECT
					CASE IS >= 2
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「흐, 으윽, 어앗!? HPH 이거 좋다 HPH」","L"
							CASE 1
								CALL HPH_PRINT,@"「앗, 후우... 앗, 거기... 기분 좋아읏, 아아...」","L"
							CASE 2
								CALL HPH_PRINT,@"「오옷! 으윽! 장난감, 보지 안에 들어와 버려... 으응응읏! 흐으읍흐으으윽!」","L"
						ENDSELECT
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「응우욱 흐읍! 이거... 대박이야...! 더... 더 해줘...!」","L"
							CASE 1
								CALL HPH_PRINT,@"「아, 아, 앗 HPH 클리읏HPH 부들부들 굉장해읏HPH」","L"
							CASE 2
								CALL HPH_PRINT,@"「흐윽!? HPH, 그, 그렇게 세게 밀착하면 안 돼요…… HPH」","L"
						ENDSELECT
				ENDSELECT
			ENDIF
		ELSE
			IF PALAM:潤滑 >= 10000 && !TALENT:処女
				CALL HPH_PRINT,@"「후우욱! 흐으응... 흐읍...」","L"
				PRINTFORML 강렬한 쾌감으로 애액이 흘러 미끌미끈해진 츠카사의 질에, 전동 마사지가 스르륵 파고들어 버렸다.
