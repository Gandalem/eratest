@M_KOJO_MESSAGE_COM_K139_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			CALL HPH_PRINT,@"「아라라 HPH, 어디서 그런 걸 손에 넣은 거야 HPH」","L"
			CALL HPH_PRINT,@"「그건, 아이가 가지고 있어서 안 되는 장난감인데…… HPH 야한 거잖아 HPH」","L"
			PRINTL 
			CALL HPH_PRINT,@"「사용법, 알고 있어요...? 응, 언니의 클에게... 후우읏 HPH」","L"
			CALL HPH_PRINT,@"「아아……응 HPH %조사처리(CALLNAME:MASTER,"의")% 손길이 더 기분 좋은지도 모르겠어… HPH」","W"
		ELSE
			CALL HPH_PRINT,@"「후후 후훗. 도구 같은 거 꺼내다니…… 후훗」","L"
			CALL HPH_PRINT,@"「도구의 힘에 의지하지 않으면 여자 혼자 만족시킬 수 없나요 HPH」","L"
			PRINTL 
			CALL HPH_PRINT,@"「후으윽 하아... 크으으~ 하아...」","L"
			CALL HPH_PRINT,@"「……아, 아하읏... HPH %CALLNAME:MASTER%손가락보다, 더 좋을지도... HPH」","W"
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			IF ITEM:ローター >= 3 && !TALENT:処女 && !RAND:2
				CALL HPH_PRINT,@"「아앙! HPH 오만코에 넣으면 안 돼읏 HPH」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%어디야, 설마, 그것도 HPH라니. 이리 와봐, 응응, 으으윽 HPH」","L"
				CALL HPH_PRINT,@"(질 안에서, 로터가 떨리며 HPH 자극!! 강해!! HPH)","L"
				CALL HPH_PRINT,@"「잠깐, 그 이상은! 아, 안돼앳 흐으윽흐흣」","L"
				PRINTFORML 츠카사는 질내에 로터 {ITEM:ローター}개를 삽입당하고, 눈을 동그랗게 뜨고 있다……
			ELSE
				SELECTCASE ABL:Ｃ感覚
					CASE IS >= 5
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「끅…… 흐으, 기분 좋아! 흐으헵흐으」","L"
							CASE 1
								CALL HPH_PRINT,@"「응! 흐으윽, 아앗! 언니의 클리읏, 더 괴롭혀줘엣! 흐으윽흐으윽」","L"
							CASE 2
								CALL HPH_PRINT,@"「언니이잇! 클리 좋당! 클리 좋아하는 거야앗!」","L"
						ENDSELECT
					CASE IS >= 2
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「언니이이익 HPH 기분 좋아져 버릴 것 같아아 HPH 아앙! HPHHPH」","L"
							CASE 1
								CALL HPH_PRINT,@"「응? 으윽 HPH 장난감, 엄청나아 HPH」","L"
							CASE 2
								CALL HPH_PRINT,@"「오오옷 흐읍, 장난감, 보지에 넣으면 안 된다고오오옷 흐읍흐읍... 응응읏 흐으으읍흐읍」","L"
						ENDSELECT
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「응읏… HPH 또, 클한테 장난치고 싶어… HPH」","L"
							CASE 1
								CALL HPH_PRINT,@"「앙! 후후, 언니의 클리 괴롭히면 안 돼요 어잇... 후후」","L"
							CASE 2
								CALL HPH_PRINT,@"「응우…… 그렇게 세게 밀어붙이면 안 돼……흐윽」","L"
						ENDSELECT
				ENDSELECT
			ENDIF
		ELSE
			IF ITEM:ローター >= 3 && !TALENT:処女 && !RAND:2
				CALL HPH_PRINT,@"「말, 말도 안 돼, 전부 다!? 저, 잠시만, 으윽! 흐읍흐읍」","L"
				CALL HPH_PRINT,@"(배가, 무거워읏 HPH 하지만 HPH 너무 기분 좋아읏 HPHHPH)","L"
				CALL HPH_PRINT,@"「아기이읏 HPHHPH 대단해욧 HPH 와요옷 HPH 응으오옷 호오HPH」","L"
				PRINTFORML 츠카사는 클리토리스를 자극받으며 질내에 로터 {ITEM:ローター -1}개를 삽입당하고, 허리를 비틀며 신음하고 있다…
			ELSE
				SELECTCASE ABL:Ｃ感覚
					CASE IS >= 5
						SELECTCASE RAND:5
							CASE 0
								CALL HPH_PRINT,@"「그렇게 안 돼읏 HPH 안에...으응!! HPHHPH옷 HPH」","L"
							CASE 1
								CALL HPH_PRINT,@"「아앗흐흑 HPH 응응 HPH 직진 HPH 하아앗! HPHHPH」","L"
							CASE 2
								CALL HPH_PRINT,@"「힉! 헉... 하아, 그래요... 끼워줘... 아악으윽!!」","L"
							CASE 3
								CALL HPH_PRINT,@"「흐으윽 아흑 아아앗 아앗읏」","L"
							CASE 4
								CALL HPH_PRINT,@"「아아아~~ HPH 기다려 HPHHPH 이그 HPH 바로 가버릴 것 같아 HPHHPH」","L"
						ENDSELECT
					CASE IS >= 2
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「흐으응! HPH 그렇게 밀어붙여지면…… HPH」","L"
							CASE 1
								CALL HPH_PRINT,@"「아아... HPH 후우읏 HPH 음응읏 HPH 후훗... %CALLNAME:MASTER%어느 누구의 손가락보다 즐겁게 해주고 있어요... HPH」","L"
							CASE 2
								CALL HPH_PRINT,@"「안 돼, 애타게 클 주변만…… 후우, 아아…… 후우」","L"
						ENDSELECT
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「응읏... HPH 같은 거에 의지하지 마시고, 스스로 애무해 주시면……」","L"
							CASE 1
								CALL HPH_PRINT,@"「아아… HPH, 그렇게 애태우듯이…… HPH」","L"
							CASE 2
								CALL HPH_PRINT,@"「아아~~... HPH 그 약한 힘으로 계속 맞을 수 있다니... 좋아... HPH」","L"
						ENDSELECT
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
