; Modular ERB: 個人口上/139 Tsukasa [典]/典/M_KOJO_K139_娘性格傾向.ERB
;-------------------------------------------------
;娘の性格傾向を決める関数
;eramegatenのEVENT_K3501「あなたの娘」の「@MUSUME_SEIKAKU_KETTEI」をベースにさせていただいております
;作者様に感謝を
;処理の順番の関係上、男の子でも出てしまう
;-------------------------------------------------

@K139_PERSONALITY
PRINTFORML  %조사처리(CALLNAME:MASTER,"와")% 츠카사의 아이가 무사히 태어났습니다.
PRINTL 딸의 성격은……
CALL ASK_M("기본 인사말을 사용한다", 1,"무작위로 결정", 1,"랜덤으로 결정한다(당신의 소질이 영향을 준다)", 1)
SELECTCASE RESULT
	CASE 0
		PRINTL 기본 인사말입니다.
		PRINTL 성격이 「보통」으로 설정됩니다.
		CFLAG:1983 = 1
	CASE 1
		PRINTL 무작위로 결정합니다...
		SELECTCASE RAND:4
			CASE 0
				PRINTL 성격이 「보통」으로 변경됩니다.
				CFLAG:1983 = 1
			CASE 1
				PRINTL 성격이 「천진난만」해집니다
				CFLAG:1983 = 2
			CASE 2
				PRINTL 성격이 「조용한 타입」으로 변경된다.
				CFLAG:1983 = 3
			CASE 3
				PRINTL 성격이 「메스가키」가 됩니다
				CFLAG:1983 = 4
		ENDSELECT
	CASE 2
		PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 소질을 바탕으로, 무작위로 성격을 결정한다.
		;性格：普通
		;お母さんと一緒。エッチは好きだけど割とノーマル
		;────────────────
		SIF TALENT:MASTER:態度 == -1
			LOCAL:1 += 1
		SIF TALENT:MASTER:性的興味 == 1
			LOCAL:1 += 2
		SIF TALENT:MASTER:貞操 == -1
			LOCAL:1 += 1
		SIF TALENT:MASTER:痛覚 == 1
			LOCAL:1 += 1
		SIF TALENT:MASTER:習得速度 == 1
			LOCAL:1 += 1
		SIF TALENT:MASTER:献身的
			LOCAL:1 += 2
		SIF TALENT:MASTER:小悪魔
			LOCAL:1 += 3
		SIF TALENT:MASTER:妖狐
			LOCAL:1 += 1
		SIF TALENT:MASTER:魅惑
			LOCAL:1 += 1
		SIF TALENT:MASTER:鼓舞
			LOCAL:1 += 1
		;性格：無邪気
		;子どもっぽい性格だけどエッチのときは一番恥じらう。甘々寄り
		;────────────────
		SIF TALENT:MASTER:態度 == -1
			LOCAL:2 += 3
		SIF TALENT:MASTER:応答 == 1
			LOCAL:2 += 1
		SIF TALENT:MASTER:陽気／陰気 == 1
			LOCAL:2 += 2
		SIF TALENT:MASTER:無知
			LOCAL:2 += 2
		SIF TALENT:MASTER:貞操 == -1
			LOCAL:2 += 1
		SIF TALENT:MASTER:羞恥心 == 1
			LOCAL:2 += 1
		SIF TALENT:MASTER:鼓舞
			LOCAL:2 += 1
		SIF TALENT:MASTER:幼稚
			LOCAL:2 += 1
		;性格：大人しい
		;心優しいけどムッツリスケベ。エッチなことなら何でも好き
		;────────────────
		SIF TALENT:MASTER:度胸 == -1
			LOCAL:3 += 1
		SIF TALENT:MASTER:応答 == -1
			LOCAL:3 += 1
		SIF TALENT:MASTER:性的興味 == 1
			LOCAL:3 += 3
		SIF TALENT:MASTER:陽気／陰気 == -1
			LOCAL:3 += 1
		SIF TALENT:MASTER:自己愛 == -1
			LOCAL:3 += 2
		SIF TALENT:MASTER:羞恥心 == -1
			LOCAL:3 += 1
		SIF TALENT:MASTER:献身的
			LOCAL:3 += 1
		SIF TALENT:MASTER:中毒しやすい
			LOCAL:3 += 2
		;性格：メスガキ
		;分からせなきゃ…（使命感）一見口は悪いですがパパ大好き
		;────────────────
		SIF TALENT:MASTER:態度 == -1
			LOCAL:4 += 1
		SIF TALENT:MASTER:応答 == -1
			LOCAL:4 += 2
		SIF TALENT:MASTER:ツンデレ
			LOCAL:4 += 3
		SIF TALENT:MASTER:気分屋
			LOCAL:4 += 1
		SIF TALENT:MASTER:自己愛 == 1
			LOCAL:4 += 1
		SIF TALENT:MASTER:献身的
			LOCAL:4 += 1
		SIF TALENT:MASTER:即落ち
			LOCAL:4 += 1
		SIF TALENT:MASTER:小悪魔
			LOCAL:4 += 2
		;繰り返し1～4
		FOR LOCAL, 1, 5
		;おっきければ
		IF LOCAL:5 < LOCAL:LOCAL
			;それに合わせます
			LOCAL:5 = LOCAL:LOCAL
			;暫定一位
			CFLAG:1983 = LOCAL
			;以上ではなくより大きいなので1から優先されるはず　はず
		ENDIF
		NEXT
		;どのLOCALも合計が3に達しなければ性格が1になる
		;LOCAL:5は1～4の中での最大値
		SIF LOCAL:5 < 2
			CFLAG:1983 = 1
ENDSELECT
LOCALS:0 = 
SELECTCASE CFLAG:1983
	CASE 1
		LOCALS:0 = 솔직해 보이지만 츠카사에게 닮아 야하다
	CASE 2
		LOCALS:0 = 활기찬
	CASE 3
		LOCALS:0 = 상냥해 보이지만 소심한
	CASE 4
		LOCALS:0 = 자아코%UNICODE(0x2665) *1% 자아코%UNICODE(0x2665) *1% 라고 아버지를 욕할 것 같은
ENDSELECT
PRINTFORML 이 아이는 장래에 %LOCALS:0%의 자식이 될지도 모른다는 생각이 들었다.
