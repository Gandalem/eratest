					CALL HPH_PRINT,@"「언니랑 하는 거, 그렇게 기분 좋았어요? HPH」","L"
					CALL HPH_PRINT,@"「후후, 언니도 같은 기분이에요... HPH」","L"
				CASE 2
					IF TALENT:バストサイズ >= 1
						CALL HPH_PRINT,@"「누나의 가슴, 따뜻하고 부드러워서 좋아해 주나요……흐응」","L"
						CALL HPH_PRINT,@"「후후, 좋아하는 만큼 언니의 폭신폭신한 가슴에 기대도 된단 말이야 HPH」","L"
					ELSEIF TALENT:TARGET:バストサイズ <= -1
						PRINTFORML 「누나의 가슴, 작아서 재미없지~?」
						PRINTFORML 「그런 거 아니에요? 정말요~? 벌써 귀여운 소리 하네요 %UNICODE(0x2665) *1%」
					ELSE
						CALL HPH_PRINT,@"「누나의 가슴, 따뜻하고 부드러워서 좋아해 주나요……흐응」","L"
						CALL HPH_PRINT,@"「사실은 큰 가슴이 좋아하는 거잖아요~? HPH」","L"
						CALL HPH_PRINT,@"「'누나 가슴이니까 괜찮아?' 라니…… 그, 그런 건가요…… 후후」","L"
					ENDIF
				CASE 3
					CALL HPH_PRINT,@"「뭐야, %조사처리(CALLNAME:MASTER,"는")% 정말 대단하시잖아 HPH」","L"
				CASE 4
					IF TCVAR:Ｖ絶頂経験 > 0
						IF TCVAR:Ａ絶頂経験 > 0 && TCVAR:Ｃ絶頂経験 > 0 && TCVAR:Ｂ絶頂経験 > 0 && TCVAR:Ｍ絶頂経験
							CALL HPH_PRINT,@"「언니, 온몸이 말랑말랑해요……히피」","L"
						ELSE
							CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")% 정말 능숙하시네요... HPH 멋졌어요 HPH」","L"
						ENDIF
					ELSE
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"가")% 만져주시면, 언니는 엄청 행복해지거든요...후훗」","L"
					ENDIF
			ENDSELECT
			PRINTW 
		ELSE
			SELECTCASE RAND:3
				CASE 0
					IF TCVAR:Ｖ絶頂経験 > 0
						SELECTCASE TCVAR:Ｖ絶頂経験
							CASE IS > 10
								CALL HPH_PRINT,@"「정말 %조사처리(CALLNAME:MASTER,"는")% 정말 잘하시네요 후후」","L"
								CALL HPH_PRINT,@"「츠카사는 벌써 몇 번이나 해줬는지 기억 못 하겠어요 HPH」","L"
								CALL HPH_PRINT,@"「정말로 %조사처리(CALLNAME:MASTER,"는")%, 여자들 울게 만드는 분이시네요... HPH」","L"
							CASE IS > 0
								PRINTFORML 「좋아하는 체위이신가요...?」
								CALL HPH_PRINT,@"「그렇네요…… 정상위로 안겨 있으면서 하는 것도 좋아하고 HPH」","L"
								CALL HPH_PRINT,@"「뒤에서 짐승처럼 격렬하게 박아주는 것도 최고예요 HPH」","L"
								CALL HPH_PRINT,@"「정면에서 당신에게 매달리면서 골반을 흔드는 것도 좋아, HPH」","L"
								CALL HPH_PRINT,@"「당신 위에 올라타서 짜내는 것도 좋아하고…… HPH」","L"
								CALL HPH_PRINT,@"「등을 맡기고, 결합 부위를 보여주는 것도 좋아해 HPH」","L"
								PRINTL 
								CALL HPH_PRINT,@"「%CALLNAME:MASTER%께서 어떤 자세든 해주시겠다면, 모든 체위가 좋다고 말하는 게 답일까요... HPH」","L"
						ENDSELECT
					ELSE
						IF TCVAR:Ａ絶頂経験 > 0 && TCVAR:Ｃ絶頂経験 > 0 && TCVAR:Ｂ絶頂経験 > 0 && TCVAR:Ｍ絶頂経験
							CALL HPH_PRINT,@"「하아... 천국에 오른 듯한 기분이야... HPH」","L"
							CALL HPH_PRINT,@"「당신에게 사랑받고 있다는 걸 강하게 실감해요... HPH」","L"
						ELSE
							CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")%…… 좀 더, 츠카사에게 만져주시면 안 돼요…… HPH」","L"
							CALL HPH_PRINT,@"「그것만으로도, 츠카사는 절정에 이르는 기분이 드는 거예요... HPH」","L"
						ENDIF
					ENDIF
				CASE 1
					CALL HPH_PRINT,@"「혼자서도 하는 건가 하고? 아, 그런 걸 물어보시면 어떡해요…… 조평 HPH」","L"
					IF EXP:自慰経験 == 0
						CALL HPH_PRINT,@"「사실…… 츠카사한테 혼자 있었던 적은 없어요 HPH」","L"
						CALL HPH_PRINT,@"「아~ 의심하고 계시네요? 정말이에요, 말라니까아 HPH」","L"
						CALL HPH_PRINT,@"「왜냐면, 그런 거 안 해도 기분 좋아질 수 있는 걸요…… 그렇죠? HPH」","L"
					ELSE
						CALL HPH_PRINT,@"「뭐…… 츠카사는 성욕이 강한 편이라고 생각해요, 가끔은……. HPH」","L"
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 얼굴을 떠올리면서, 유두를 손가락으로 만지작거리거나 클리토리스를 가지고 놀고 있네… 후후」","L"
						CALL HPH_PRINT,@"「이제, 본인 앞에서 부끄러운 말 하게 하지 마세요 HPH」","L"
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")% 말이야, 아래쪽에 털이 있는 쪽을 더 좋아해? 없는 쪽을 좋아하는 거야? HPH」","L"
					PRINTL 
					CALL ASK_M("매끈매끈", 1,"손질 완료", 1,"자연스러운", 1,"손질 같은 건 말할 것도 없다", 1)
					PRINTL 
					SELECTCASE RESULT
						CASE 0
							PRINTFORML 「그런 분들은 많다고 들었어요」
							CALL HPH_PRINT,@"「깔끔한 느낌이 있다거나, 거기가 다 보이게 되니까 좋다거나 HPH」","L"
							SIF TALENT:MASTER:妖精孕ませ || GROUPMATCH(EXP:出産経験, [[サニー]], [[ルナ]], [[スター]], [[大妖精]], [[チルノ]], [[クラウンピース]], [[萃香]], [[ルーミア]], [[レミリア]], [[リリーＷ]], [[こいし]], [[橙]], [[フラン]], [[てゐ]], [[メディスン]],[[ラルバ]])
								CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 경우, 다른 이유도 있을 것 같지만…… HPH」","L"
						CASE 1
							PRINTFORML 「관리 안 해주면 신경 쓰여요?」
							CALL HPH_PRINT,@"「참고로 어떤 형태로 정돈하는 걸 좋아하시는지, 참고 삼아…… HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「과연, 함부로 가지고 놀지 않는 편이 좋다는 거구나... 후훗」","L"
							CALL HPH_PRINT,@"「있는 그대로를 사랑해 주신다는 것도 멋진 이야기네요 HPH」","L"
						CASE 3
							CALL HPH_PRINT,@"「음~ 일부러 다 늘려놓는 걸 좋아하신다고…… 후후」","L"
							CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")% 어떤 게 좋아요, 속옷에서 흘러넘칠 정도가 더 흥분되는 타입이에요... HPH」","L"
					ENDSELECT
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
