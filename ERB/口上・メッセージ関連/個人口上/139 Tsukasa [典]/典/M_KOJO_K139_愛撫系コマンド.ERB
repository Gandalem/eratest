@M_KOJO_MESSAGE_COM_K139_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:4 ;custom code
				CASE 0
					CALL HPH_PRINT,@"「후우우욱 HPH 푹 HPH 쿠우욱 HPHHPH」","L"
					PRINTFORML 음핵을 두 손가락으로 감싸듯 쓸어 올리며 츠카사의 질 깊은 곳을 휘젓는다.
				CASE 1
					CALL HPH_PRINT,@"「이대로엣 HPH 제일 깊숙한 데까지 HPH」","L"
					PRINTFORML 츠카사를 끌어안은 팔에 힘이 들어가자, 츠카사도 강하게 되안아 왔다.
				CASE 2
					CALL HPH_PRINT,@"「후기유우욱! 너무 세세요읏!!」","L"
					PRINTFORML 츠카사의 엉덩이 살을 움켜쥔 채, 페니스를 츠카사의 질 깊숙한 곳까지 밀어 넣었다...
				CASE 3
					CALL HPH_PRINT,@"「아햣ㅎㅍㅎ 아햣ㅎㅍㅎ ㅎㅍㅎ ㅎㅍㅎ」","L"
					PRINTFORML 츠카사의 꼬리 밑동을 페니스처럼 주무르며, 츠카사의 질 안에서 정액을 사정했다...
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「앗 후후, 귀는 안 돼요읏 후후」","L"
				CASE 1
					CALL HPH_PRINT,@"「안아주세요읏, 세게엣 HPH」","L"
			ENDSELECT
			PRINTW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
