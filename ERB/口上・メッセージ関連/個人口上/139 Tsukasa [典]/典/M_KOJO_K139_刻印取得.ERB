; Modular ERB: 個人口上/139 Tsukasa [典]/典/M_KOJO_K139_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K139
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K139
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORML 「츠카사는 %CALLNAME:MASTER%님의 도움이 되고 싶습니다」
	PRINTFORML 「명령만 있으시다면, 무엇이든요」
	PRINTFORML (흠, 이분은 신뢰할 만한 인물일지도 모르겠네요)
	PRINTW 
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 「%CALLNAME:MASTER%라면, 손해 볼 일 없이 기꺼이 명령을 받아 드리겠어요」
	PRINTFORML 「아아~ 믿지 못하시나 보네요? 정말이에요」
	PRINTFORML (신기한 것이라. 이이즈모마루님 외에 그렇게 생각하는 분들이 있을 줄은)
	PRINTW 
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML (충신은 두 분께 봉사하지 않는다 말씀하시지만……)
	PRINTFORML (이분의 곁에 있는 것으로, 이이지나마루님께도 도움이 될지도 모르겠네요.)
	PRINTW 
	IF TALENT:140:恋慕 && (!TALENT:139:恋慕 && !TALENT:139:恋人)
		PRINTFORML (게다가, 이이즈나마루님은 아무래도 %CALLNAME:MASTER%께 매우 간절한 모양이다.
		PRINTFORML (중재하는 것도 종자로서의 임무라고 할 수 있겠지)
		PRINTW 
	ENDIF
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%」
	PRINTFORML 「아무리 저라도, 화낼 때가 있답니다?」
	PRINTW 
ELSEIF TFLAG:21 == 2
	PRINTFORML 「………………」
	PRINTFORML 츠카사는 입가에 미소를 띠고 있지만, 눈은 전혀 웃고 있지 않다.
	PRINTW 
ELSEIF TFLAG:21 == 3
	IF TALENT:恋慕 || TALENT:恋人
		PRINTFORML 「지금까지는 당신이 하는 일이니까 하고 응석을 받아왔지만……」
		PRINTFORML 「%CALLNAME:MASTER%라도 더는 참을 수 없게 됐어요」
		PRINTFORML 「후회해도 이미 늦었어요, 아시겠어요?」
		PRINTFORML 담담한 츠카사의 말투가 분노를 여실히 드러내고 있었다……
		PRINTW 
	ELSE
		PRINTFORML 「지금까지는 상황이 좋아서 응석을 받아왔지만…….」
		PRINTFORML 「이번만큼은 인내심의 한계가 무너졌습니다」
		PRINTFORML 「후회하셔도, 이미 너무 늦었어요?」
		PRINTFORML 담담한 츠카사의 말투가 분노를 여실히 드러내고 있었다…….
		PRINTW 
	ENDIF
ENDIF
