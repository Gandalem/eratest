;睡眠姦共通喘ぎ
;==================================================

@K139_SLEEPING_ASSALT
SELECTCASE TCVAR:TARGET:睡眠深度
	;睡眠深度: 今にも起きそうだ
	CASE 0 TO 500
		IF ABL:Ｖ感覚 >= 5
			SELECTCASE RAND:5 ;custom code
				CASE 0
					CALL HPH_PRINT,@"「아앗... 후우... 하으... 응...?」","L"
				CASE 1
					CALL HPH_PRINT,@"「응! 흐읍! 아아...흐으윽」","L"
				CASE 2
					CALL HPH_PRINT,@"「응으윽 HPH 응으윽 HPH 으으윽... HPH」","L"
				CASE 3
					CALL HPH_PRINT,@"「오옷! 흐으읍, 오옷! 흐으읍, 음... 오옷! 흐으읍」","L"
				CASE 4
					CALL HPH_PRINT,@"「아앗 흐읍 아앗 흐읍 아앗 흐읍 아앗 흐읍」","L"
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「하아읏, 하아읏, 하아읏……」
				CASE 1
					CALL HPH_PRINT,@"「응읏, 응읏, 응읏, 응읏흐읍」","L"
			ENDSELECT
		ENDIF
		;睡眠深度: 寝苦しそうにしている
	CASE 501 TO 1500
		IF ABL:Ｖ感覚 >= 5
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「음윽… HPH 아앗… HPH 아앙… HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「후으읏 HPH 후으읏 HPH 후우읏 HPH 후우읏 HPH」","L"
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아…… 응…… 아, 하아……」
				CASE 1
					PRINTFORML 「우응읏, 응읏, 응읏……」
			ENDSELECT
		ENDIF
		;睡眠深度: 眠っている～すやすやと眠っている
	CASE 1501 TO 5000
		IF ABL:Ｖ感覚 >= 5
			CALL HPH_PRINT,@"「아... 흐읍... 흐읍」","L"
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아…… 응……」
				CASE 1
					PRINTFORML 「응읏, 응읏……」
					CALL HPH_PRINT,@"「응읏, 응읏……」","L"
			ENDSELECT
		ENDIF
		;睡眠深度: ぐっすりと眠っている
	CASE IS > 5000
		IF ABL:Ｖ感覚 >= 5
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「응... 후으읍」","L"
				CASE 1
					CALL HPH_PRINT,@"「……앗 흐으윽」","L"
			ENDSELECT
		ELSE
			PRINTFORML 「응……」
		ENDIF
ENDSELECT
