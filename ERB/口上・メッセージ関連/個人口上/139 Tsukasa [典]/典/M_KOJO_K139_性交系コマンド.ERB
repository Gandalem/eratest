			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		CFLAG:1019 = 1
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		CFLAG:1019 = 1
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
