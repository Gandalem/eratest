; Modular ERB: 個人口上/139 Tsukasa [典]/典/M_KOJO_K139_加虐系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;加虐系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K139_100
CALL M_KOJO_MESSAGE_COM_K139_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K139_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:発情
			IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
				SETCOLOR 0xFF69B4
				CALL HPH_PRINT,@"「응! 후헵」","L"
				CALL HPH_PRINT,@"「안돼읏 HPH 언니 엉덩이 때리지 마아읏 HPH」","L"
				RESETCOLOR
				PRINTL 
				PRINTFORML 짝! 짝! 파앙!
				SETCOLOR 0xFF69B4
				CALL HPH_PRINT,@"「히잉! 흐읍! 히이익! 흐으윽!」","L"
				CALL HPH_PRINT,@"「잔혹해…… HPH 언니를, 괴롭히지 마아…… HPH」","L"
				PRINTL 
				RESETCOLOR
				PRINTFORML 발정으로 극에 달한 감각을 지닌 츠카사의 몸은, 고통마저 강제로 쾌락으로 뒤덮어 간다.
				PRINTFORML 엉덩이를 맞는 충격은 쾌락의 파동으로서 자궁까지 도달하고 있었다.
				PRINTW 
			ELSE
				SETCOLOR 0xFF69B4
				CALL HPH_PRINT,@"「히잉! 흐으윽! 응읏! 하아앗!」","L"
				RESETCOLOR
				PRINTFORML 착! 착 하고 건조한 소리가 울릴 때마다, 츠카사의 신음이 울려 퍼진다.
				PRINTW 
				SETCOLOR 0xFF69B4
				CALL HPH_PRINT,@"「아파쩌 어떡해 HPH 아파도 기분 좋아요 HPH 왜 그래 HPH」","L"
				RESETCOLOR
				PRINTFORML 발정으로 극에 달한 감각을 지닌 츠카사의 몸은, 고통마저 강제로 쾌락으로 뒤덮어 간다.
				PRINTFORML 엉덩이를 맞는 충격은 쾌락의 파동으로서 자궁까지 도달하고 있었다.
				PRINTW 
				SETCOLOR 0xFF69B4
				CALL HPH_PRINT,@"「안돼읏 HPH 때리지 마읏 HPH 아파읏 HPH 윽! HPH 아아~읏 HPH 아아~읏」","L"
				RESETCOLOR
				PRINTW 
			ENDIF
		ELSE
			IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
				IF ABL:マゾっ気 >= 2
					CALL HPH_PRINT,@"「꼬오응! HPH」","W"
					PRINTFORML 「아, 방금 건…… 아니야…… 언니, 별로 기분 좋았던 거 아냐……」
					PRINTW 
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 아무 말 없이 손을 내리쳤다.
					CALL HPH_PRINT,@"「히이익흐윽! HPH」","W"
					CALL HPH_PRINT,@"「안, 안돼읏 HPH 아파서 그만해앳, 그만해라아앗, 히잉! HPH」","L"
					PRINTW 
				ELSE
					PRINTFORML 「콩!!?」
					PRINTFORML 「저, 잠깐만... 엉덩이를 때기는... 콩!!」
					PRINTFORML 「누나, 화내요오옷!」
					PRINTFORML 「아파, 아프니까 그만때, 앗!」
					PRINTW 
				ENDIF
			ELSE
				IF ABL:マゾっ気 >= 2
					CALL HPH_PRINT,@"「꼬오응! HPH」","W"
					PRINTFORML 「아, 지금 건 달라요, 기분 좋아서, 뭔가 크으윽!!?」
					PRINTW 
					PRINTFORML 두 대, 세 대와 같이 츠카사의 엉덩이를 때릴 때마다 동그란 엉덩이에 붉은 자국이 여러 개 떠오른다.
					CALL HPH_PRINT,@"「안돼읏 HPH 엉덩이 때리는 거 안돼읏 HPH 아파요오옷!!」","L"
					PRINTW 
				ELSE
					PRINTFORML 「콘!??」
					IF GROUPMATCH(TALENT:MASTER:体型,2,3)
						PRINTFORML (아파 아파 아파읏!!? 정말로 아파읏!!!)
						PRINTW 
						PRINTFORML 파바아앙!
						PRINTFORML 「이, 이기이이!!?」
						PRINTW 
						PRINTFORML 「아, 아우……%조사처리(CALLNAME:MASTER,"가")%, 그만해 주세요……」
						PRINTFORML 츠카사는 눈가에 눈물을 고하고 진심으로 벌벌 떨고 있다.
						PRINTW 
					ELSE
						PRINTFORML 「저, 저기……엉덩이 때리는 건……끄응!!」
						PRINTFORML 「아파요, 그만해 주세요, 안 돼, 끄응!」
						PRINTW 
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			IF ABL:マゾっ気 >= 2
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응읏! 더 해줘아아아!!」","L"
						CALL HPH_PRINT,@"「누나…… 너무 맞아서, 정신이 들었나 봐…… 큭훗」","L"
						PRINTW 
					CASE 1
						CALL HPH_PRINT,@"「응! 큭흐윽」","L"
						PRINTFORML 「저기, 저기야아... 언니 엉덩이 때리면 안 돼에...」
						PRINTL 
						PRINTFORML 파앙!
						CALL HPH_PRINT,@"「코오응! 흐읍!」","L"
						PRINTL 
						PRINTFORML 「오, 언니의……」
						PRINTL 
						PRINTFORML 파앙!
						CALL HPH_PRINT,@"「엉덩이 찰싹! 어라아앗!」","L"
						PRINTL 
						PRINTFORML 파앙!
						CALL HPH_PRINT,@"「놀아줘 HPH 야앗 HPH」","L"
						PRINTW 
				ENDSELECT
			ELSE
				PRINTFORML 파앙!
				SELECTCASE RAND:6
					CASE 0
						PRINTFORML 「언니, 아파! 정말로, 아프단 말이야앗」
					CASE 1
						PRINTFORML 「지금이라면 용서해 드릴 테니까, 그만둬읏, 콩!」
					CASE 2
						PRINTFORML 「이, 이봐요! 언니의 엉덩이를 북처럼 두드리지 마세요!」
					CASE 3
						PRINTFORML 「앗, 나중에 기억해둬, 공!」
					CASE 4
						PRINTFORML 「그, 그만 안 하면 정말 화 날 거예요!」
					CASE 5
						IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
							PRINTFORML 「이, 이 개자식! 나중에 후회해라읏! 엉엉!」
						ELSE
							PRINTFORML 「뭐, 뭐야! 그런 짓 하는 애가 아니잖아요!? 아아앙!」
						ENDIF
				ENDSELECT
				PRINTW 
			ENDIF
		ELSE
			IF ABL:マゾっ気 >= 2
				CALL HPH_PRINT,@"「응! 큭흐윽」","L"
				PRINTFORML 「아, 방금 건, 달라구요... 기분 좋다는 게 아니에요...」
				PRINTL 
				PRINTFORML 파앙!
				CALL HPH_PRINT,@"「코오응! 흐읍!」","L"
				PRINTFORML 분명 고통과는 다른 음색이 비명과 뒤섞여 있다.
				PRINTFORML 그리고 무엇보다, 은밀한 곳에서 흘러나오는 애액의 양이 늘어나고 있다는 것이 여실히 말해주고 있다.
				PRINTW 
			ELSE
				PRINTFORML 파앙!
				PRINTFORML 「코오응!?」
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「나한테 이런 걸 하다니, 힉!? 아, 아파아앗!」
						PRINTW 
					CASE 1
						PRINTFORML 「아우윽! 아, 아프다고 말하고 있잖아……」
						PRINTW 
					CASE 2
						PRINTFORML 「앗, 아파아! 아파!! 그만해 주세요읏!」
						PRINTW 
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
