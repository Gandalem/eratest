;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K139_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 누나한테 부탁하고 싶은 게 있거든요」
			PRINTFORML 「봐요, %CALLNAME:MASTER%님은 정말 강하시잖아요」
			PRINTFORML 「일방적인 승부가 되어버리면 재미없고, %CALLNAME:MASTER%님은 약한 사람 괴롭히는 거 안 하죠?」
			PRINTFORML 「그래서 누나한테 조금만 봐주면 안 될까요...♪」
			CALL ASK_YN("괜찮아","안 돼")
			IF !RESULT
				HANDICAP_FIXED += ABL:MASTER:戦闘能力 * 50
			ELSE
				PRINTFORMW 「후미유…… %조사처리(CALLNAME:MASTER,"는")%, 나쁜 사람이야……」
			ENDIF
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%님. 저는 소위 시시한 관지(管狐)에 불과해요」
			PRINTFORML 「그런 약한 상대에게 전력을 다하시려는 건가요?」
			PRINTFORML 「약한 상대를 가지고 노는 것은 %CALLNAME:MASTER%님의 전적을 더럽히게 됩니다」
			PRINTFORML 「어떠세요? 여기 조금 손을 봐 주시면 안 될까요?」
			PRINTW 
			CALL ASK_YN("괜찮아","아니. 완벽하게 박살 내 버린다")
			IF !RESULT
				HANDICAP_FIXED += ABL:MASTER:戦闘能力 * 50
			ELSE
				PRINTFORMW 「흐, 흐으응……」
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			PRINTFORML 「기뻐요♪ %조사처리(CALLNAME:MASTER,"는")% 어떤 언니에게나 다 친절하시네요♪」
			IF ABL:MASTER:戦闘能力 >= 3
				PRINTFORML (\@ ABL:MASTER:戦闘能力 > 4 ? 이이츠나마루님 # 나 \@보다 강한 아이에게 진심을 내 보인다면 한 방에 무너질 테니까요……)
			ELSE
				PRINTFORML (잘 됐어요……♪)
				;生意気か反抗的持ち
				IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
					PRINTFORML (핸디가 있다면, 솔직하지 않은 이 아이를 이해시켜 줄 수 있을 것 같다...♪)
					PRINTFORML (튕겨내는 것도 그 나름 귀엽지만, 가끔은 언니 말도 들어야 한다...)
				ELSE
					PRINTFORML (지배한 뒤에는 말로 몰아붙여 자존심을 산산조각 내고, 녹아내릴 때 달콤하게 보듬어 줄 거예요……♪)
					PRINTFORML (그리고 저에게 의존하게 만드는 작전…… 완벽해요♪)
				ENDIF
			ENDIF
		ELSE
			PRINTFORML 「역시 %CALLNAME:MASTER%시군요. 진정 강한 자는 과시하지 않는 법이지요」
			PRINTFORML (쉬워요~ 다루기 편해서 정말 도움이 돼요♪)
			PRINTW 
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 「음음음, 역시 %CALLNAME:MASTER%시네요」
				PRINTW 
			CASE 1
				PRINTFORML 「이건 강하시네요. 츠카사님은, 이미 바람 앞의 등불이에요」
				IF HANDICAP_FIXED > 0
					PRINTFORML (이상해, 확실히 %조사처리(CALLNAME:MASTER,"는")% 손을 대고 있는데)
					PRINTFORML (내가 밀리고 있는 건가)
				ELSE
					IF ABL:戦闘能力 > ABL:MASTER:戦闘能力
						PRINTFORML (거짓말!? 나 쪽이 상급인데, 능력을 오판한 거야!?)
					ELSE
						PRINTFORML (아아, 정말이지. 눈대중대로라고는 해도, 이렇게 당하다니!)
					ENDIF
				ENDIF
			CASE 0
				IF HANDICAP_FIXED > 0
					PRINTFORML 「졌다고!? 말도 안 돼……」
					PRINTFORML (이런, 이럴 리가 없는데!?)
					PRINTFORML (살아주고 있음에도 힘의 차이가 너무 명백했다는 거야!?)
					PRINTW 
				ELSE
					IF ABL:MASTER:戦闘能力 > 2
						PRINTFORML 「완패로 되었습니다. 굉장하시네요」
						IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML 「하지만, %조사처리(CALLNAME:MASTER,"의")% 그 강함은……」
								IF FLAG:周回数
									PRINTFORML (뭐랄까... 이 아이의 영혼... 영격은 보통 아이들과는 비교가 안 되네요)
									PRINTFORML (설마, 윤회 전생을 반복하고 있는 건가?)
									PRINTFORML (그럴 리가 없지. 능력을 유지한 채로 환생하다니, 대중을 위한 연극이 아니니까)
									PRINTFORML 「아뇨, 아무것도 아니에요. 누나의 혼잣말이에요」
								ELSE
									IF TALENT:MASTER:動物耳
										IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
											PRINTFORML 「실은…… 야쿠모의 구미님과 혈연이 있거나……」
										ELSE
											PRINTFORML 「나처럼 짐승의 귀도 돋아 있고…… 의외로 이름 있는 요괴의 피가 흐르는 건가……」
											PRINTFORML 「뭐, 나 같은 관호는 아닐 테지만 말이야」
											PRINTW 
											PRINTFORML (아, 하지만…)
											PRINTFORML (각지에 75마리의 권속을 거느리고, 달라붙는 것에는 비할 데 없는 '동족'이 있었네요… 기억하기로는… 이름은…)
										ENDIF
									ELSE
										IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
											PRINTFORML 「분명 요괴의 피가 섞여 있다. 그것도 강력한 것이」
											PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 눈을 들여다보며 츠카사가 말했다.
											PRINTFORML 얼굴이 가깝다고 항의하자, 「또 부끄러지네~♪」라며 안겨버렸다…
										ELSE
											PRINTFORM 어디에서 어떻게 봐도
											IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
												PRINTFORML 생기 넘치는 인간의 아이입니다만.
												PRINTFORML 대담함에 틈타 매달리려는 자에게 항의한다.
												PRINTFORML 「좋지 않습니까~♪ \@ TALENT:恋人 ? 연인 사이잖아요~♪ # 좋아하는 사람에게 매달리는 정도는~ \@」
												PRINTW 
											ELSE
												PRINTFORML 귀여운 아이인데 말이야.
												PRINTFORML 안기자 부끄럽다며 항의한다.
												PRINTFORML 「좋잖아~♪ \@ TALENT:恋人 ? 연인끼리잖아요~♪ # 좋아하는 사람에게 매달릴 정도라고~ \@」
												PRINTW 
											ENDIF
										ENDIF
									ENDIF
								ENDIF
								;ショタ恋慕・恋人なし
							ELSE
								PRINTFORML 「도대체 이 작은 몸에 이런 힘이……」
								IF TALENT:MASTER:動物耳
									IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
										PRINTFORML 「실은…… 야쿠모의 구미님과 혈연이 있거나……」
									ELSE
										PRINTFORML 「나처럼 짐승의 귀도 나고 있고…… 의외로 이름 있는 요괴의 피가 흐르고 있나……」
									ENDIF
								ELSE
									IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
										PRINTFORML 「분명 요괴의 피가 섞여 있다. 그것도 강력한 것이」
										PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 눈을 들여다보며 츠카사가 말했다.
										PRINTFORML 얼굴이 가깝다고 항의하자, 「또 부끄러지네~♪」라며 안겨버렸다…
									ELSE
										PRINTFORM 어디에서 어떻게 봐도
										IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
											PRINTFORML 생기 넘치는 인간의 아이인데 말이죠.
											PRINTFORML 혼란을 틈타 달라붙지 않으려 항의한다.
											PRINTFORML 「괜찮잖아요~♪ 언니, 녹초가 돼서 무언가에 기대지 않으면 힘드니까요~」
											PRINTW 
										ELSE
											PRINTFORML 귀여운 아이인데 말이야.
											PRINTFORML 안기자 부끄럽다며 항의한다.
											PRINTFORML 「좋지 않아요~♪ 언니, 녹초가 돼서 무언가에 기대지 않으면 힘들단 말이에요~」
											PRINTW 
										ENDIF
									ENDIF
								ENDIF
							ENDIF
							;大人・戦闘能力3以上
						ELSE
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML (강한 쪽은... 좋아요 %UNICODE(0x2665) *1%)
								PRINTW 
								PRINTFORML 「이제 저로는 승부 볼 수 없으니, 강함을 극복하고 싶으시다면 비슷한 수준의 상대를 상대하시는 게 좋겠어요」
								PRINTFORML 「%CALLNAME:MASTER%님의 경우에는…… 그렇네요……」
								SELECTCASE ABL:MASTER:戦闘能力
									CASE 6
										PRINTFORML 「지옥의 여신인 헤카티아님, 신령을 몸에 내릴 수 있다는 월인의 요리히메님… 이 두 분일까요」
										PRINTFORML 「이 두 분에게 이기면, 명실상으로 %조사처리(CALLNAME:MASTER,"가")% 환상향에서 최강이겠죠」
										PRINTFORML 「……사실은 환상향 따위의 문제가 아닐 거라고 생각하지만」
									CASE 5
										PRINTFORML 「환상향의 염마님이신 에이키님, 지옥에 사는 귀신의 사천왕 중 한 분인 쇼구마 유기님 등등……」
										PRINTFORML 「말 그대로 '신에게 시비를 거는' 수준이네요. 천상인의 싸움 같은 건, 츠카사로서는 이제 도저히 감도 안 가요」
										PRINTFORML 「메즈노마루님의 친구분이신 모모요님도 이 근처일 거예요. 그분은 이름 있는 대요니까」
										PRINTFORML 「게다가 이보다 상위 차원의 싸움이 있다고 들었는데……이야하네요」
									CASE 4
										PRINTFORML 「저의 주인인 이츠나마루님, 예전에 이상한 일로 저희와 협력해주셨던 치마타님, 마유즈미 신사의 신님 등등……」
										PRINTFORML 「점점 상대가 인간 수준을 벗어나고 있네요. 뭐 당연하지만요」
										PRINTFORML 「%CALLNAME:MASTER%께서 원하신다면, 이츠나마루님께 수련을 받으실 수 있도록 제가 주선해 드릴까요?」
									CASE 3
										PRINTFORML 「샤메마루 공주님, 카데하 공주님, 이누바시 공주님, 모야의 미도리피마…… 콜록, 무녀님 쪽이 적임일까요」
										PRINTFORML 「그렇다고는, 텐구들은 개성이 강해 보이지만…… 무녀님 쪽도 아직 밑바닥을 알 수 없고요」
										PRINTFORML 「우선은 진지한 이누바시 공주님과 먼저 대전해보시는 건 어떨까요?」
								ENDSELECT
								PRINTW 
							ELSE
								PRINTFORML (크윽, 역시 전력 차이는 명백했군요)
								PRINTW 
								PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 저 같은 하급 요괴보다는, 좀 더 격이 있는 상대를 상대해 보시는 건 어때요?」
								PRINTFORML 「그야말로 저희 주인님이나 모모요 님 같은……」
								SIF CFLAG:140:弾幕勝負勝利 == 1
									PRINTFORML 「……그러고 보니, 주인님은 벌써 승리하셨었네요」
								SIF CFLAG:142:弾幕勝負勝利 == 1
									PRINTFORML 「……아아, 모모요 님도 그러셨군요」
								IF CFLAG:98:弾幕勝負勝利 == 1 && CFLAG:113:弾幕勝負勝利 == 1
									PRINTFORML 「음~ 그럼, 환상향에서도 최강이라 불리는 헤카티아님이나 요리히메님에게도 이기고 있잖아요~! 싫어어어!」
									PRINTFORML 「왠지 허무해져 왔어요…」
									PRINTFORML 「그만두는 건 어때요? 미친 개처럼 탄막 승부를 거는 건」
								ENDIF
								PRINTFORML 「이렇게 강하신 분이 왜 츠카사를 상대하시는지 이해가 안 가요……」
							ENDIF
							PRINTW 
						ENDIF
						PRINTW 
						;あなたの戦闘能力2以下
					ELSE
						PRINTFORML 「아니, 정말 멋진 싸움이었어요」
						IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML 「역시 언니가 눈여겨본 %조사처리(CALLNAME:MASTER,"는")% 대단해읏♪」
								PRINTFORML 「이렇게 강해져 주셔서, 언니 기쁘다구요♪ 음츄옷♪」
								PRINTFORM 갑작스럽게 츠카사에게 키스를 당하고 나서,
								IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
									PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 얼음처럼 굳어버렸다.
								ELSE
									PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 뺨을 붉혔다.
								ENDIF
								PRINTW 
							ELSE
								IF TALENT:MASTER:性別 == 2
									PRINTFORML 「『남자끼리 사흘을 만나지 않으면 눈이 멀 것이다』라고는 하지만……」
									PRINTFORML 「강해졌네요. 이제 언니에게는 못 이길지도 몰라요」
									PRINTFORM 츠카사에게 부드럽게 머리를 쓰다듬어지고
									IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
										PRINTFORML 하지만 %조사처리(CALLNAME:MASTER,"는")% 그 손을 뿌리치지 않았다
									ELSE
										PRINTFORML ,%조사처리(CALLNAME:MASTER,"는")% 부끄러워하는 듯한 미소를 지었다
									ENDIF
								ELSE
									PRINTFORML 「나 정도의 요괴라면, 방심하지 않으면 이미 지지 않는다」
									PRINTFORML 「하지만 강함뿐만이 아니라 교활한 요괴도 있으니, 아직 언니의 지도가 필요하다」
								ENDIF
								PRINTW 
							ENDIF
						ELSE
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML (역시 내가 반한 상대라…… %UNICODE(0x2665) *1%)
								PRINTW 
								PRINTFORML 「하지만, 방심은 하지 말아 주세요」
								PRINTFORML 「츠카사의 힘은 요괴 중에서는 최하위예요. 아래에서부터 세는 게 더 빠를 정도랍니다」
