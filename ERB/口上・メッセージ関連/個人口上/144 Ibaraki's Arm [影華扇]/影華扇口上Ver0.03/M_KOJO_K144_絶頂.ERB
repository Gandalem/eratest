@M_KOJO_MESSAGE_PALAMCNG_A_K144_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF !TALENT:妊娠 && !TCVAR:ピル && CFLAG:生解禁 == 2
		PRINTFORML 
		PRINTFORML 「앗, 응 아아핫…… 안에, 뜨거워……」
		PRINTFORML (사양 없이 내보내 버리다니…… 정말 임신할지도 모르겠네……%UNICODE(0x2665) *1%)
		PRINTFORMDL 두근두근 맥동하면서, %조사처리(CALLNAME:MASTER,"의")% %TINKO(MASTER)%은 %조사처리(CALLNAME:TARGET,"의")% 자궁에 밀어붙여져 있다.
		PRINTFORMDW 거기서 한꺼번에 흘러들어 오는 정액의 뜨거움으로부터, %조사처리(CALLNAME:TARGET,"는")% 자신을 임신시키려는 의지를 느끼고 있었다.
		PRINTFORML 
	ELSEIF CFLAG:900 <= 2 || TCVAR:ピル
		PRINTFORML 
		PRINTFORML 「우으윽…… 끝난 건가……」
		PRINTFORML 「크큭, 내 안이 그렇게 좋았나?……」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 정액을, %조사처리(CALLNAME:TARGET,"는")% 자궁에서 받아들였다.
		PRINTFORML  
	ELSEIF CFLAG:生解禁 == 1
		PRINTFORML 「음, 망설임 없이, 내뱉어 버리다니……」
		PRINTFORML (설마, 진심으로 나를 임신시키려는 건가……?)
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% %TINKO(MASTER)%에서 토해진 정액은 남김없이 %CALLNAME:TARGET%자궁에 쏟아지고 있다.
	ELSE
		PRINTFORML 
		PRINTFORML 「내 안에서 내게 해봐... 임신하면 어쩔 거야?」 
		PRINTFORMDW 자궁 속의 열을 느끼며, %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 노려보았다.
		PRINTFORML 
	ENDIF
	RETURN 1
ENDIF
RETURN 1
