RETURN RESULT

@M_KOJO_MESSAGE_COM_K144_309_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		;睡眠中
	ELSEIF CFLAG:睡眠
		;通常
	ELSE
		IF TFLAG:193 == 1
			PRINTFORML 
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 불평하는 표정으로 %조사처리(CALLNAME:MASTER,"에게")% 쓰다듬어지는 대로 있다.
			PRINTFORML (의외로 나쁘지 않아, 응)
			PRINTFORMDW ――라고 생각했지만, 잘 살펴보니 입꼬리가 살짝 올라와 있었다.
			PRINTFORML 
		ELSEIF TFLAG:193 == 0
			IF ABL:親密 > 5
				PRINTFORML 
				PRINTFORML 「오니의 머리를 쓰다듬다니, 이상한 녀석이군……」
				PRINTFORML 「뿔에는 만지지 마라」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 들은 대로, 뿔에 닿지 않도록 조심하며 쓰다듬었다.
				PRINTFORML 
			ELSE
				PRINTFORML 
				PRINTFORML 「자, 이제 끝이야」
				PRINTFORMW 「언제까지 내 머리를 쓰다듬고 있을 거야」
				PRINTFORML 
			ENDIF
		ELSE
			PRINTFORML 
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리로 손을 뻗자, 휙 피했다.
			PRINTFORMDW 아무래도 머리를 쓰다듬는 건 안 되는 모양이다.
			PRINTFORML 
		ENDIF
	ENDIF
ENDIF
RETURN 1
