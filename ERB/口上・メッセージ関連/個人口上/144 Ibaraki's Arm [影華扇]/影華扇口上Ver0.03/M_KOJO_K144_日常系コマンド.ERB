;==================================================
;411,戦闘訓練
;TFLAG:194(3=夏の昼間 2=ヤバい天気 1=悪天候 0=屋内or通常天気
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K144_411
RETURN 0

@M_KOJO_MESSAGE_COM_K144_411
CALL M_KOJO_MESSAGE_COM_K144_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K144_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 탄막 특훈을 하고 있자, %조사처리(CALLNAME:TARGET,"가")% 다가왔다.
	PRINTFORML 「뭐야, 특훈하고 있는 거야?」
	SIF TFLAG:194 > 0
		PRINTFORML 「이런 날씨에 안 해도 되잖아……」
	PRINTFORMW
	IF ABL:MASTER:戦闘能力 > ABL:TARGET:戦闘能力
		PRINTFORML 「이 귀신 같은 나를 능가할 정도로 강하다고 하면서, 그래도 아직 단련하려는 건가.」
		PRINTFORML 「별난 녀석이지만, 그렇게 힘에 탐욕스러운 녀석은 싫지 않아.」
		PRINTFORMW 「모처럼이니 상대해 주도록 하지.」
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 강력한 탄막을 퍼부었다.
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 잘 대응하며 버텼지만, 마지막에는 피격을 당해 무릎을 꿇었다.
		PRINTFORML 
	ELSEIF ABL:MASTER:戦闘能力 == ABL:TARGET:戦闘能力
		PRINTFORML 「나와 동등한 실력임에도 불구하고, 더 높은 곳을 목표로 하는 건가」
		PRINTFORML 「좋다, 그렇다면 내가 상대해 주마.」
		PRINTFORMW 「특훈은 혼자 하기보다는 강자와 함께 하는 편이 성장하는 법이지?」 
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"와")% 격렬하게 탄막을 주고받았다.
		PRINTFORMDW 서로 양보하지 않는, 진전과 후퇴가 반복되는 공방이 길게 이어졌다……
		PRINTFORML 
	ELSE
		IF ABL:MASTER:戦闘能力 < ABL:TARGET:戦闘能力 && ABL:MASTER:戦闘能力 > 2
			PRINTFORML 「나에게는 뒤떨어지지만, 환상향에서도 상위권에 드는 실력이지... 만족하고 있지는 않은 모양이네.」
			PRINTFORML 「그렇겠군. 잠시 놀아주도록 하지.」
			PRINTFORMW 「오니 상대 특훈이다. 무언가로 만들 수 있다면, 너의 양분이 되겠지. 할 수 있으면 말이야.」
		ELSE
			PRINTFORML 「뭐, 그 강사로는 말이야. 자기 방어조차 제대로 못 하는 거 아닐까?」
			PRINTFORML 「자, 좀 가지고 놀아주면서 특훈을 도와주도록 하지.」
			PRINTFORMW 「사양할 필요 없어, 싫다고 해도 내가 먼저 갈 테니까. 어찌 됐든 귀신이니까 말이야.」
		ENDIF
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 탄막을 피하는 것이 손이 가득해서, 반격할 수 없었다.
		PRINTFORMDW 특훈의 마지막에는, %조사처리(CALLNAME:MASTER,"는")% 너덜너덜해져 있었다.
		PRINTFORML 
	ENDIF
ENDIF
RETURN 1
