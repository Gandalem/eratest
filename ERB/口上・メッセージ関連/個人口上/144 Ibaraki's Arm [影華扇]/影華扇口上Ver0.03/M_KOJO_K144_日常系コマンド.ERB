;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K144_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K144_300
RETURN 0

@M_KOJO_MESSAGE_COM_K144_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K144_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K144_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 >= 0
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
					PRINTFORML 「그렇게 멀리 떨어져서 어떡해, %CALLNAME:MASTER%」
					PRINTFORML 「자, 좀 더 이쪽으로 와」
					PRINTFORML 「이제 와서 망설일 일도 없잖아」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그 오른손으로 %조사처리(CALLNAME:MASTER,"를")% 가볍게 끌어당겼다.
					PRINTFORML 
				CASE 1
					PRINTFORML 
					PRINTFORML 「외도(外道)인 귀신인 나를 이런 감정으로 만들다니」
					PRINTFORML 「정말로 너는 신기한 인간이야, %CALLNAME:MASTER%」
					PRINTFORMW 「하지만 그렇겠지――의외로 나쁘지 않군」
					PRINTFORML 
				CASE 2
					PRINTFORML 
					PRINTFORML 「자, 뭐 재미있는 거라도 얘기해 봐.」
					PRINTFORML 「맞아, 재미있는 이야기 같은 건 없어?」
					PRINTFORML 「무슨 소리야. %조사처리(CALLNAME:MASTER,"의")% 이야기는 무엇이든 재미있을 거야.」
					PRINTFORMW 「어차피 이렇게 즐거운 걸.」
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:思慕 || TALENT:セフレ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 있으면 심심할 일이 없겠네」
					PRINTFORML 「시간 때우려고 날뛸 필요도 없고, 무녀들에게 눈에 띄지도 않아」
					PRINTFORMW 「저거랑 노는 것도 일종의 흥미이긴 하지만 말이야」
					PRINTFORML 
				CASE 1
					PRINTFORML 
					PRINTFORML 「그래, 술이라도 한잔 할까?」
					PRINTFORML 「뭐? 내가 술을 마신다고?」
					PRINTFORMW 「오니인 것이다. 술을 좋아하는 건 당연하지 않겠어.」
					PRINTFORML 
				CASE 2
					PRINTFORML 
					PRINTFORML 「아, %CALLNAME:MASTER%인가, 딱 좋네」
					PRINTFORML 「너를 먹어서, 나의 나에게 더해 주마――농담이다」
					PRINTFORMDW 그렇게 말하며 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 놀렸다.
					PRINTFORML 
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
					PRINTFORML 「이상한 인간이다, 귀신이라는 걸 알고 말을 거는 건……」
					PRINTFORMW 「보통의 인간은 관여하려 하지 않을 텐데?」
					PRINTFORML 
				CASE 1
					PRINTFORML 
					PRINTFORML 「나에게 겁먹지 않는 건가」
					PRINTFORMW 「아무리 말을 주고받는다 해도, 나의 본질은 변하지 않는다.」
					PRINTFORML 
				CASE 2
					PRINTFORML 
					PRINTFORML 「인간, 너도 괴짜로군」
					PRINTFORMW 「내가 언제 기분 내서 너를 먹을지 모른다?」
					PRINTFORML 
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
				PRINTFORMW 「그 이야기는 방금도 들었다.」
				PRINTFORML 
			CASE 1
				PRINTFORML 
				PRINTFORMW 「응? 뭐라 했어?」
				PRINTFORML 
			CASE 2
				PRINTFORML 
				PRINTFORMW 「지루하다, 다른 걸 말해라」
				PRINTFORML 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
