;墓場プレイとか作ってみる、趣味です
;==================================================
;CFLAG:1201	墓場プレイ経験回数
;TCVAR:351	墓場プレイカウント
;TCVAR:352	墓場プレイ進行度
;--------------------------------------------------

@GRAVE_PLAY_K86
;墓地で二人きり
IF GROUPMATCH(CFLAG:現在位置, P121墓地, 墓地) && GET_TARGETNUM() == 1 ;custom code
	DRAWLINE
	PRINTL
	;進行度0、開始カウント中
	IF TCVAR:352 == 0
		PRINTFORML 인기 없는 묘지에 교성이 울려 퍼진다...
		PRINTL
		;カウント+1
		TCVAR:351 ++
		;初回はカウント10でプレイ開始
		IF CFLAG:1201 == 0 && TCVAR:351 == 10
			;進行度1へ
			TCVAR:352 = 1
			;二回目はカウント5でプレイ開始
		ELSEIF CFLAG:1201 == 1 && TCVAR:351 == 5
			;進行度1へ
			TCVAR:352 = 1
			;三回目以降はカウント0でプレイ開始
		ELSEIF CFLAG:1201 >= 2
			;進行度1へ
			TCVAR:352 = 1
		ENDIF
		;進行度1、プレイ開始
	ELSEIF TCVAR:352 == 1
		;プレイ初回
		IF CFLAG:1201 == 0
			PRINTFORML %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"가")% 정사에 몰두하고 있을 때 무덤 밑에서 유령들이 솟아나왔다...
			PRINTFORML 유령들은 %CALLNAME:MASTER%들의 모습을 살피듯 주위를 아른거리며 떠다니고 있었다...
			PRINTW
			PRINTFORMW 「흐윽... 그, 역시 그만두죠? 이런 곳에서...」
			PRINTL
			PRINTFORML 말이 없는 유령이 상대라고는 해도, 치태를 구경당한 %조사처리(CALLNAME:TARGET,"의")% 얼굴은 불이 붙은 것처럼 붉어져 있었다.
			PRINTFORMW 그 모습을 보고 %조사처리(CALLNAME:MASTER,"의")% 마음에 작은 가학심이 싹텄다...
			PRINTL
			PRINTFORML 　...보여주면 돼, 유령들도 계속 무덤에만 있으면 지루하겠지
			PRINTW
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 그렇게 말하고 다시 %조사처리(CALLNAME:TARGET,"를")% 끌어안았다…
			PRINTW
			;進行度2へ
			TCVAR:352 = 2
			;カウント0
			TCVAR:351 = 0
			;二回目
		ELSEIF CFLAG:1201 == 1
			PRINTFORML %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"가")% 정사에 몰두하고 있을 때 무덤 아래에서 유령들이 솟아 나왔다...
			PRINTFORML 유령들은 다시 %CALLNAME:MASTER%들을 에워싸지만, 그 수는 전보다 많아진 듯한 기분이 들었다...
			PRINTL
			PRINTFORML 「하아... 아... 후후... 인간이란... 죽어도 평평해, 그렇지...?」
			PRINTW
			;進行度2へ
			TCVAR:352 = 2
			;カウント5
			TCVAR:351 = 5
			;三回目
		ELSEIF CFLAG:1201 == 2
			PRINTFORML %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"가")% 은밀한 만남을 시작하자, 기다렸던 듯 유령들이 쏟아져 나왔다...
			PRINTFORML 유령들은 %CALLNAME:MASTER%일행을 에워싸고, 흥겹게 주변을 날아다닌다...
			PRINTW
			PRINTFORMW 「...후후...읏... 완전히 인기인이 되어버렸네...」
			PRINTFORMW 「이 사람들... 분명 이제 성불 못 할 거야...? 어떻게 책임질 셈인 걸까...」
			PRINTL
			PRINTFORML 　……신경 쓸 것 없어, 이곳은 극락보다 훨씬 즐거운 곳이겠지.
			PRINTW
			PRINTFORMW 「그거... %조사처리(CALLNAME:MASTER,"가")% 계속, 계속... 즐겁게 해줄 거라는 것, 말이지...?」
			PRINTFORMW 「후후... 좋네, 그게 좋아... 그게...」
			;進行度3へ
			TCVAR:352 = 3
			;四回目以降
		ELSE
			PRINTFORML %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"가")% 은밀한 만남을 시작하자, 기다렸던 듯 유령들이 쏟아져 나왔다...
			PRINTFORML 유령들은 %CALLNAME:MASTER%일행을 에워싸고, 흥겹게 주변을 날아다닌다...
			PRINTL
			PRINTFORML 「…후후…윽… 오늘도… 만원 감사, 응…」
			PRINTFORML 「자… 제대로 즐겁게 해줘야지, 안 돼…?」
			PRINTW
			;進行度3へ
			TCVAR:352 = 3
		ENDIF
