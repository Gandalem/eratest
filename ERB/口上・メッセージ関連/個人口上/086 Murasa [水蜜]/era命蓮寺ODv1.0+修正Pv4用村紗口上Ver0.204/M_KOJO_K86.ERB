@M_KOJO_MESSAGE_COM_K86_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;情景テキスト改変
	;-------------------------------------------------
	;押し倒され時
	IF CFLAG:うふふ
		DRAWLINE
		;ぱふはぷ
		IF TCVAR:20 == 73
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 안겨 얼굴에 닿는 부드러운 감촉을 만끽했다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 다정하게 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬는다...
			PRINTW
			PRINTFORMW 「이렇게 있으면 애 같네, 후후후...」
			;乳合わせ
		ELSEIF TCVAR:20 == 74
			PRINTFORM %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 살며시 끌어안았다.
			;マスターが巨乳か爆乳
			IF TALENT:MASTER:バストサイズ > 0
				PRINTFORML 그 풍만한 가슴에 안겼다...
				PRINTW
				PRINTFORML 「……후훗」
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 아이 같은 미소를 지으며 %조사처리(CALLNAME:MASTER,"에게")% 응석을 부린다...
				;マスターが貧乳か絶壁
			ELSEIF TALENT:MASTER:バストサイズ < 0
				PRINTFORML 그 따뜻한 풍만함에 몸을 맡겼다...
				PRINTW
				PRINTFORMW 「후후... %조사처리(CALLNAME:MASTER,"는")% 응, 애교 많은 분이네...??」
				;マスターが並乳
			ELSE
				PRINTFORML 서로의 온기를 느꼈다...
				PRINTW
				PRINTFORMW 「후훗... 조금만, 이대로 있어도 될까...?」
			ENDIF
			;挿入される（MASTER受け）
		ELSEIF TCVAR:20 == 80
			IF ABL:MASTER:Ｖ感覚 >= 3
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 허리에 다리를 감고 그 어깨에 매달리며, 움직임에 맞춰 스스로도 허리를 흔든다...
				PRINTW
			ELSEIF ABL:MASTER:Ｖ感覚 >= 2
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 허리의 움직임을 빠르게 하는%조사처리(CALLNAME:TARGET,"에게")% 매달리며, 울음소리인지 신음소리인지 모를 목소리를 냈다...
				PRINTW
			ELSEIF ABL:MASTER:Ｖ感覚 >= 1
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 수치심에 물든 얼굴을 보이지 않으려고 %조사처리(CALLNAME:TARGET,"의")% 어깨에 매달렸다.
				PRINTW
			ELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %CALLNAME:TARGET%에 이끌린 채 작게 몸을 비틀자, 그 몸에 꼭 안겼다...
				PRINTW
				PRINTFORML 「음… 역시 마음이 안 놓여?」
				PRINTFORMW 「……이 상태에서 진정할 리 없다는 거야? 후후, 그렇겠지. 미안해」
				PRINTL
				PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며 웃으며%조사처리(CALLNAME:MASTER,"의")%
				IF BEDROOM(CFLAG:現在位置)
					PRINTFORMW 머리를 부드럽게 쓰다듬었다...
				ELSE
					PRINTFORMW 등을 부드럽게 쓰다듬었다...
				ENDIF
			ENDIF
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"를")% 강하게 껴안았다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 뜨거운 숨을 내쉬며 %조사처리(CALLNAME:TARGET,"의")% 목덜미에 입맞춤했다...
			PRINTW
		ENDIF
		;ムラサが布団に潜っている
	ELSEIF CFLAG:添い寝中 && !CFLAG:睡眠 && TCVAR:353 == 1
		DRAWLINE
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 자신도 이불 속에 파고들어 %조사처리(CALLNAME:TARGET,"를")% 꽉 껴안았다.
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 매우 놀란 것 같다...
		PRINTW
		PRINTFORMW 「흐읍... 정말이지, %CALLNAME:MASTER%라니」
		PRINTL
		PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 웃으면서 이불 속에서 장난을 쳤다...
		TCVAR:353 = 0
		;-------------------------------------------------
		;通常情景テキスト
		;-------------------------------------------------
	ELSE
		CALL TRAIN_MESSAGE
		IF CFLAG:睡眠
			PRINTFORMW 「음... 후후...」
		ELSEIF CFLAG:添い寝中
			PRINTFORMW 「...이대로, 둘이 녹아버릴 수 있다면 좋을 텐데 말이야」
		ELSEIF TALENT:恋慕 || ABL:親密 >= 8
			PRINTFORMW 「후훗... 있잖아, 좀 더 세게 안아줘...?」
			;身長差分岐、流石にマスターが小人や巨人だと違和感が出るかも
			;イメージ的に立って過ごしてそうな場所
			IF CFLAG:現在位置 == INROOM()
				;マスターがオトコ
				IF !(TALENT:MASTER:2 & 1)
					;マスターが普通体型以上
					IF TALENT:MASTER:100 > -1
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"를")% 안자, %조사처리(CALLNAME:TARGET,"의")% 부드러운 머리카락이 %조사처리(CALLNAME:MASTER,"의")% 코끝을 간지럽혔다...
						;マスターが幼児体型以下
					ELSEIF TALENT:MASTER:100 < -1
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"의")% 가슴에 얼굴을 기하자, %조사처리(CALLNAME:TARGET,"의")% 고동이 열과 함께 전해져 온다...
						;マスターが小柄体型
					ELSE
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"를")% 껴안자, %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"의")% 뺨이 맞닿았다...
					ENDIF
					;マスターが女かふたなり
				ELSE
					;マスターが長身以上
					IF TALENT:MASTER:100 > 0
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"를")% 안자, %조사처리(CALLNAME:TARGET,"의")% 부드러운 머리카락이 %조사처리(CALLNAME:MASTER,"의")% 코끝을 간지럽혔다...
						;マスターが小柄体型以下
					ELSEIF TALENT:MASTER:100 < 0
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"의")% 가슴에 얼굴을 기하자, %조사처리(CALLNAME:TARGET,"의")% 고동이 열과 함께 전해져 온다...
						;マスターが普通体型
					ELSE
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"를")% 껴안자, %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"의")% 뺨이 맞닿았다...
					ENDIF
				ENDIF
			ENDIF
		ELSEIF ABL:親密 >= 4
			PRINTFORMW 「흐음... 역시 조금 부끄럽네」
		ELSE
			PRINTFORMW 「저, 저기... 부끄럽다, 나, 말이야...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
