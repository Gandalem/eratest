		;カウント10で進行度3へ
		IF TCVAR:351 == 10
			PRINTFORML %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"의")% 치정에 이끌리듯 더욱 유령들이 모여왔다…
			PRINTFORML 유령들은 %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"의")% 정사를 부추기듯 주위를 날아다니고 있다…
			PRINTL
			;初回
			IF CFLAG:1201 == 1
				PRINTFORML 「……아…윽… 늘…가…왔어……읏」
				PRINTW
			ENDIF
			TCVAR:352 = 3
		ELSE
			PRINTFORML 유령들은 %조사처리(CALLNAME:MASTER,"와")% %CALLNAME:TARGET%주위를 둥실둥실 떠다니고 있다...
			PRINTL
			;カウント+1
			TCVAR:351 ++
		ENDIF
		;進行度3
	ELSEIF TCVAR:352 == 3
		PRINTFORML 유령들은 %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"의")% 정사를 부추기듯 주위를 날아다니고 있다...
		IF RAND:4 == 0
			;上半身裸
			IF TEQUIP:1 == 0
				PRINTFORML 망자의 시선에 노출된 채 %조사처리(CALLNAME:TARGET,"의")% 땀에 젖은 하얀 몸이 꿈틀거린다...
			ELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 상의를 벗기고, 브래지어를 풀고, 그 살을 망자들에게 노출시킨다...
				;ターゲット上半身脱衣
				EQUIP:上半身上着１ = 0
				EQUIP:上半身上着２ = 0
				EQUIP:ボディースーツ = 0
				EQUIP:ワンピース = 0
				EQUIP:着物 = 0
				EQUIP:レオタード = 0
				EQUIP:上半身下着１ = 0
				EQUIP:上半身下着２ = 0
				CALL CLOTHES_SETTING_TRAIN(TARGET)
			ENDIF
		ELSEIF RAND:3 == 0
			PRINTFORML 멀리에서는 원에 들지 못한 유령들이 이곳을 응시하고 있다...
		ELSEIF RAND:2 == 0
			PRINTFORML 몇몇 영혼들이 %CALLNAME:MASTER%들의 피부에 달라붙듯이 달라붙어 왔다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"가")% 비명을 지를 때마다 유령들이 소리 없이 술렁이는 것을 느꼈다...
		ENDIF
		PRINTL
	ENDIF
ENDIF
