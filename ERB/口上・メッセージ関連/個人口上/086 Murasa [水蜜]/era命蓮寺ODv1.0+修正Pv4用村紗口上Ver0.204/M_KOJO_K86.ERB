			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"와")% 혀를 얽자, %조사처리(CALLNAME:TARGET,"에게")% 삽입된 채인 손가락이 꽉 조여지는 것을 느꼈다…
			CALL MUTUAL_KISS
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF TALENT:処女
			PRINTFORMW 「...윽, 아, 이상한 느낌...」
		ELSE
			PRINTFORMW 「……윽 ……아, 흐윽」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
