				PRINTL 
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 마음을…
				PRINTL [0] 받아들인다
				PRINTL [1] 그것은 할 수 없다
				$INPUT_LV_K86
				INPUT
				IF RESULT == 0
					PRINTFORMW ……%조사처리(CALLNAME:MASTER,"는")%, %조사처리(CALLNAME:TARGET,"의")% 마음을 받아들이기로 했다
