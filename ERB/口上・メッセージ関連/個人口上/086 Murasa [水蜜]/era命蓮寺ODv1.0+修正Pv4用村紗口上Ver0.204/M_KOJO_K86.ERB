	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		;白蓮が居ない
		IF CFLAG:MASTER:現在位置 != CFLAG:55:現在位置
			PRINTFORMW 「…즐거운 모양이네?」
			PRINTL
			PRINTFORMW %CALLNAME:ARG%의 어깨에 뒤에서 조용히 하얀 손이 감겼다.
			PRINTL
			PRINTFORML 「후후... 그렇게 놀란 표정 안 지어도, 귀여운 목소리가 울리고 있었어?」
			PRINTFORML 「정말 기분 좋아 보이는... 달콤하고 애틋한 목소리. 그런 걸 들으면 나까지 무너질 거야」
			PRINTFORMW 「그러니까, 나도 함께 해 주지 않을래? 응 %CALLNAME:MASTER%...」
			PRINTL
			PRINTFORMW 그렇게 말하며 %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:ARG%의 어깨 너머로 %조사처리(CALLNAME:MASTER,"에게")% 요염하게 미소 지었다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORML 「……실례한 것 같네?」
		PRINTFORMW 「그렇지, 나는 실례할 테니 편하게 즐겨줘...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて参加
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		;白蓮が居る
		IF CFLAG:MASTER:現在位置 == CFLAG:55:現在位置
			;ムラサが恋人
			IF TALENT:TARGET:恋人
				PRINTFORML 「후후... 함께하게 되어 영광입니다, 히지리...」
				PRINTL
				PRINTFORMW 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% 뱌쿠렌의 손등에 입을 맞췄다...
			ELSE
				PRINTFORMW 「나도 같이...?」
				PRINTL
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 당혹스러운 표정으로 백련을 본다.
				PRINTL
				PRINTFORMW 「히지리는... 괜찮으신가요?」
				PRINTL
				PRINTFORML 「……그렇습니까, 그렇다면 기꺼이요」
				PRINTFORMW 「함께할 수 있어서 영광입니다. 왜냐하면 뭔가 이상하잖아요」
				PRINTL
				PRINTFORMW 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 미소지었다...
			ENDIF
		ELSE
			PRINTFORML 「애정받은 것 같네, %CALLNAME:ARG%? 독차지라니 치사해.」
			PRINTFORMW 「후후... 그렇게 부풀어 오르진 말고, 함께 즐기자?」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML 
ENDIF
RETURN 1
