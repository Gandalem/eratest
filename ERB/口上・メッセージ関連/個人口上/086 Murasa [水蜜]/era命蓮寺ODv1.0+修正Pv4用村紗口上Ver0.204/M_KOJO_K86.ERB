@M_KOJO_EVENT_K86_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF TCVAR:353 == 1
		TCVAR:353 = 0
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみの筈
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF CFLAG:MASTER:添い寝中
				PRINTFORML 「...응...... 하아...윽...」
				PRINTFORMW 「아...... 안녕%CALLNAME:MASTER%, 후훗」
				;ムラサ私室以外の部屋を私室に設定している(条件的に有り得ず
				;SIF CFLAG:MASTER:311 != 14
				;PRINTFORMW 「%CALLNAME:MASTER%が来てたのなら… もう少し早く起きていれば良かったかな」
				PRINTL
				PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 온기를 아쉬워하며 이불을 빠져나왔다...
			ENDIF
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF CFLAG:MASTER:添い寝中
				PRINTFORML 「...응...... 하아...윽...」
				PRINTFORMW 「아...... 안녕%CALLNAME:MASTER%, 후훗」
				;ムラサ私室以外の部屋を私室に設定している(条件的に有り得ず
				;SIF CFLAG:MASTER:311 != 14
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 와 있었다면... 조금 더 일찍 일어나고 있었으면 좋았을까」
				PRINTL
				PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 온기를 아쉬워하며 이불을 빠져나왔다...
			ENDIF
			PRINTFORMW 
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;夜寝るとき（おやすみ口上）
;==================================================

@M_KOJO_EVENT_K86_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF BASE:TARGET:体力 <= 500
			IF CFLAG:うふふ
				PRINTFORML 「하아... 하아... 이제, 안 돼...」
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 힘없이%CALLNAME:MASTER%에 기대어 축 늘어져 있고, 거친 호흡과 함께 어깨를 위아래로 움직이고 있다...
				PRINTL
				PRINTFORML 「내가 먼저 지쳐버리다니, 있잖아... 후훗... 다행이었어, %CALLNAME:MASTER%」
				PRINTFORMW 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 입술에 부드럽게 닿을 정도의 키스를 한다...
				PRINTL
			ELSE
				PRINTFORMW 「음... 역시 아직 피곤한 것 같아.」
			ENDIF
			PRINTFORMW 「... 나는 방으로 돌아가 쉴게, 안녕히 주무세요」
		ELSE
			PRINTFORMW 「음… 벌써 이런 시간. 나는 먼저 쉬도록 할게네」
			PRINTFORMW 「%CALLNAME:MASTER%도 너무 밤늦게 깨어 있으면 안 돼? 후훗, 잘 자」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:添い寝中
			PRINTL
			PRINTL
			PRINTFORMW 「후훗...」
		ELSE
			PRINTFORMW 「음... 하아... 아...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTL
		PRINTFORMW 「스으... 스으... 음...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「음... 으음...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕時、部屋まで運ぶ）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:うふふ
			PRINTFORMW 「하아... 하아... 이제, 안 돼...」
			PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 힘없이%CALLNAME:MASTER%에 기대어 축 늘어져 있고, 거친 호흡과 함께 어깨를 위아래로 움직이고 있다...
			PRINTL
			PRINTFORMW 「후훗... 정말, 좋았어. %조사처리(CALLNAME:MASTER,"의")% 것을 많이 느낄 수 있어서 행복해」
			PRINTFORMW 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 입술에 부드럽게 닿을 정도의 키스를 한다...
			PRINTFORMW 그러고 잠시 연인의 여운을 즐긴 후, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 방까지 배웅했다...
		ELSE
			PRINTFORMW 「음... 역시 아직 피곤한 것 같아」
			PRINTFORMW 「......태워다 줄 거야? 후훗... 고마워」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW 「아아... 벌써 주무시는 건가요」
		PRINTFORMW 「어쩔 수 없네요, 방까지 에스코트해 드릴게요」
		PRINTFORMW 그렇게 말하며 %조사처리(CALLNAME:TARGET,"는")% 후라당 %조사처리(CALLNAME:MASTER,"를")% 안아 올렸다...
		PRINTL
		PRINTFORMW 「후후... 놀랐어? 보기보다 나 꽤 힘이 세거든?」
		PRINTFORMW 「...그럼, 안녕. 좋은 꿈 꿔.」
		PRINTW
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
