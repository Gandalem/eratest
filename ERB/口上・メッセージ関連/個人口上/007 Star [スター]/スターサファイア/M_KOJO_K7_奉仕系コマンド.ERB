@M_KOJO_MESSAGE_COM_K7_83_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「그래. 이 정도부터 차근차근 익숙하게 해 나가는 게 좋아」
		PRINTFORML 스타는 %CALLNAME:MASTER% 위에 올라타 발기한 남근 앞에 허리를 내려앉힌다.
		PRINTFORML 촉촉한 허벅지로 끼워 넣고, 스륵스륵 문질러 올린다.
		PRINTFORML 「응…… 후후, 커……%UNICODE(0x2665) *1%」
		PRINTFORML 소악마 같은 미소를 띠고는, 서서히 허리를 움직여 여성의 골로 다가갔다.
		PRINTFORML 「앗, 단단해%UNICODE(0x2665) *1%…… 아, 아앗……%UNICODE(0x2665) *1%」
		PRINTFORML 부드러운 음부에 푹 닿자 스타는 작게 교성을 흘렸고, 여성기에서 흘러나온 꿀이 남근과 허벅지를 적셨다.
		PRINTFORMW 「이대로…… 좀 더 빠르게 할 테니까…… 응읏%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 클리토리스와 남근이 서로 비벼지며 거친 숨을 몰아쉬고 쾌락을 만끽했다.
				PRINTFORMW 「아아 %UNICODE(0x2665) *1%くり%UNICODE(0x2665) *1%こすれて%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 스타는 남근이 원하는 듯 연약한 곳에 그것을 끼워 주무른다.
				PRINTFORMW 「넣고 싶다면 언제든 괜찮아... %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 투명한 수액과 암컷의 액이 뒤섞이며 음란한 기운이 주위를 지배한다.
				PRINTFORMW 「더… 더오 %UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스타는 붉게 달아오른 클리토리스를 육봉에 문지르더니, 거칠게 허리를 밀어붙여 왔다.
				PRINTFORMW 「히야, 아, 아앗%UNICODE(0x2665) *1% 그거, 좋아%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 「아아앗%UNICODE(0x2665) *1% 하아아%UNICODE(0x2665) *1%」
				PRINTFORMW 남근을 삽입하기라도 할 듯한 기세로 스타가 뛰어오르자, 찰박찰박 음란한 물소리가 울려 퍼졌다.
			CASEELSE
				PRINTFORML 「흥...%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 춤을 추듯 허리를 들썩이며 달콤함을 뿌리면서 여성기를 움직여 남근에 물게 한다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「……아……, 아」
				PRINTFORMW 스타의 허벅지가 맞닿고, 작은 몸을 상하로 흔든다.
				PRINTFORML 부드러운 압박감에 부풀어 오른 남근을 받고, 스타는 허리를 벌벌 떨었다.
			CASE 0
				PRINTFORML 질척하게 흘러넘치는 미끈거림을 빌려, 남근이 음부와 부드러운 허벅지를 왕복시킨다.
				PRINTFORMW 「……후우…윽%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「아... 하아... 이렇게 단단하게 해버려서... %UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 남근을 움켜쥐고 적극적으로 허리를 밀어붙이며 쾌감을 갈망하고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
