@M_KOJO_MESSAGE_COM_K7_80
CALL M_KOJO_MESSAGE_COM_K7_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K7_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「벌써 기다려왔다는 느낌이야」
		PRINTFORML 터질 듯한 남근을 앞에 두고, 스타는 풋 웃는다.
		PRINTFORML 「오늘만 특별히, 그 큰 데쿠의 막대기로 놀아줄게」
		PRINTFORML 스타는 %CALLNAME:MASTER% 앞에 몸을 숙이고, 매끄러운 손으로 육봉 표면을 문지르기 시작한다.
		PRINTFORMW 등줄기와 귀두를 그녀의 가느다란 손가락으로 더듬자, 형언할 수 없는 쾌감이 %조사처리(CALLNAME:MASTER,"를")% 감싼다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스즈구치에서 새어 나오는 선행의 액체가 스타의 손에 축축하고 음란한 소리를 내고 있다.
				PRINTFORMW 「자, 더 기분 좋아질 수 있잖아…」
				PRINTFORML 남근이 움찔거릴 때마다 스타는 괴롭히는 아이처럼 히죽거리며 속도를 높인다.
			CASE 0
				PRINTFORML 귀두부터 뿌리까지 정성스럽게 애무당하자 남근이 부들부들 떨린다.
				PRINTFORML 「……하아, 하아%UNICODE(0x2665) *1%」
				PRINTFORMW 스타 자신도 알아차리지 못하는 사이에 숨소리가 거칠어지고 있다.
			CASEELSE
				PRINTFORML 「푸슉, 푸욱 하고 내고 싶구나. 이렇게 크게 만들었으니까 %UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 남근 끝에서 흘러나온 액을 손가락에 묻힌 채, 자신의 몸 전체에 발라 익숙해지게 한다.
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「봐앗%UNICODE(0x2665) *1%봐앗%UNICODE(0x2665) *1%」
				PRINTFORMW 금방이라도 달려들어 빨아댈 듯한 음란한 표정으로 얼굴을 가까이 들이대고 남근을 손으로 문지르고 있다.
			CASE 0
				PRINTFORML 때로는 끌어안고, 때로는 손가락 끝으로만 애를 쓰며 남근을 가지고 논다.
				PRINTFORMW 「후후... %CALLNAME:MASTER%라면 정말 기분 좋아 보이는 표정을 하고 있네... %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「후우…%UNICODE(0x2665) *1%」
				PRINTFORML 스타에게 귀에 속삭여지는 듯한 것이 등줄기를 타고 말로 표현할 수 없는 짜릿한 감각을 불러일으킨다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 스타는 사무적인 움직임으로 %조사처리(CALLNAME:MASTER,"의")% 남근을 문지르고 있다.
				PRINTFORML 「빨리 사정해 줘. 손이 피곤해질 것 같아.」
			CASE 0
				PRINTFORMW 스타는 손가락 하나만을 움직여 더듬듯이 두... 하고 남근을 문지르기 시작한다.
				PRINTFORML 「%CALLNAME:MASTER%같은 손가락 하나로 충분하지 않을까요?」 
			CASEELSE
				PRINTFORMW 「음, 피곤해졌어~」
				PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 남근이 기분 좋음에 맥동하는 타이밍에 일부러 스타는 손을 쉬게 해온다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
