@M_KOJO_MESSAGE_COM_K7_85_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「이거 나 마음에 드네」
		PRINTFORML 「남자의 소중한 부분을 짓밟고 휘두르는 감각...」
		PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 생사여탈권을 완전히 장악하고 마음대로 할 수 있다니」
		PRINTFORML 「굴욕적이라도 쾌감에 몸을 떨며 괴로워하는 %조사처리(CALLNAME:MASTER,"의")% 얼굴」
		PRINTFORML 「...견딜 수가 없어」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스타는 양다리를 능숙하게 사용하여 나의 페니스를 부드럽게 감싸며 쓰다듬는다.
				PRINTFORMW 「어때? 기분 좋지?」
			CASE 0
				PRINTFORML 「쓱...쓱...쓱쓱...자아%UNICODE(0x2665) *1%」
				PRINTFORMW 작은 다리를 능숙하게 움직여, %조사처리(CALLNAME:MASTER,"의")% 가랑이를 부드럽게 밟는다.
			CASEELSE
				PRINTFORMW 「정말 어리둥절한 표정을 짓고 있네. ……귀여운 사람%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「자아앗%UNICODE(0x2665) *1% 어때?%UNICODE(0x2665) *1% 변태 씨%UNICODE(0x2665) *1%」
				PRINTFORMW 몇 번이고 몇 번이고 페니스를 밟아 짓누르는 스타의 표정은 더할 나위 없는 기쁨으로 가득 차 있었다.
			CASE 0
				PRINTFORML 「모든 게 망치더라도… 모르겠어%UNICODE(0x2665) *1%」
				PRINTFORMW 스타의 발끝이 귀두를 튕긴다. 날카로운 통증과 자극에 %조사처리(CALLNAME:MASTER,"는")% 고통스러운 신음을 흘린다.
			CASEELSE
				PRINTFORML 「이런 모습을 남에게 보이면... %조사처리(CALLNAME:MASTER,"는")% 아주 실망할지도 몰라... %UNICODE(0x2665) *1%」
				PRINTFORMW 꽉, 가차 없이 짓밟을 때마다 통증과 쾌락이 뒤섞여 %조사처리(CALLNAME:MASTER,"의")% 뇌를 지배해 간다….
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「부숴버렸다면 미안해%UNICODE(0x2665) *1%」
				PRINTFORMW 음낭부터 성기 부분까지 남김없이 짓밟고 가지고 놀며 %조사처리(CALLNAME:MASTER,"의")% 표정을 즐기고 있는 듯하다.
			CASE 0
				PRINTFORML 「변태, 변태, 변태%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 히죽거리며%CALLNAME:MASTER% 내려다보면서 욕설을 퍼붓는다.
			CASEELSE
				PRINTFORML 「그냥 만져주는 것만 감사히 해줬으면 좋겠어... 자.」
				PRINTFORMW 스타는 발 엄지발가락 주변을 전체적으로 부드럽게 주물러주었다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
