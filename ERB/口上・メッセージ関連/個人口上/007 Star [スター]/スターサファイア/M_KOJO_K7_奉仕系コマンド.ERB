@M_KOJO_MESSAGE_COM_K7_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「빨아도 돼? 그건 안 돼?」
		PRINTFORML 스타는 남근을 손에 들고 입 쪽으로 가져간다.
		PRINTFORML 코에 스며드는 숨 막히는 남성의 냄새에 살짝 얼굴을 찡그린다.
		PRINTFORML 「입에 넣으라고 하다니 %CALLNAME:MASTER%도 특이한 취미를 가지고 있네」
		PRINTFORML 「하지만, 하면 한다고 했으니까 해줄게...」
		PRINTFORML 스타의 통통한 입술이 벌어지고, 남근을 입속에 넣는다.
		PRINTFORML 「음... 음...」
		PRINTFORML 단조로운 입으로 하는 애무. 맞닿는 치아의 감촉에 %조사처리(CALLNAME:MASTER,"는")% 움찔 떨게 된다.
		PRINTFORMW 「응... 츄...」
		PRINTFORML 익숙해지자 입안의 혀끝이 부드럽게 움직이며, 남근을 사탕처럼 다 빨아들인다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「츄루, 아하... %UNICODE(0x2665) *1%츄츄츄츄」
				PRINTFORMW 스타는 질척하게 혀를 내밀어 칼리에게 감싸고 사정에 이르게 하려 한다.
			CASE 0
				PRINTFORML 빨아 물고 있던 귀두에 그대로 끈적하게 혀를 놀리며, 달라붙은 액체를 핥아내듯 빨아올린다.
				PRINTFORMW 「츄릅, 쮸웁%UNICODE(0x2665) *1%츄우우%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「...푸하앗! 하아, 핫... 후우읏」
				PRINTFORML 「숨 쉬는 것도 잊고 있었으니까, 죽을까 하고 생각했어...%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「츄폿%UNICODE(0x2665) *1%츄폿%UNICODE(0x2665) *1%츄폿%UNICODE(0x2665) *1%츄폿%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 정액을 빨리 맛보고 싶다는 듯 입으로 기둥 부분을 꼼꼼하게 쓸어 올린다.
			CASE 0
				PRINTFORML 스타는 저속한 소리를 내며 남근을 탐한다.
				PRINTFORMW 「쥬, 취, 추우%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「주르륵, 르록, 츄파앗...%UNICODE(0x2665) *1%」
				PRINTFORMW 「쯧, 쯧, 주포옷%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「퍄하후, 하히하하히호헤에…」
				PRINTFORMW 「츄읍...응...츄%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 「츄... 함... 레로...」
				PRINTFORMW 스타는 올려다보는 시선으로 %조사처리(CALLNAME:MASTER,"의")% 모습을 보며 남근을 핥는다.
			CASEELSE
				PRINTFORML 「레로... 입에 넣기만 하면 턱이 피곤해져...」
				PRINTFORMW 스타는 부드럽게 혀를 안쪽 결을 따라 움직이며 봉사하고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
