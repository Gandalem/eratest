@M_KOJO_MESSAGE_COM_K7_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;スターが貧乳
	IF TALENT:5:105 == -1
		IF LOCAL:1 && FIRSTTIME(SELECTCOM)
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 냄새가 가슴에 와닿아버려」
			PRINTFORML 「굉장한 냄새, 머리가 어지러울 것 같아. 하지만...」
			PRINTFORML 「싫지는 않아...%UNICODE(0x2665) *1%
			PRINTFORMW 스타의 희고 가는 피부를 더럽히듯, %조사처리(CALLNAME:MASTER,"는")% 남근을 문질렀다.
			RETURN 1
		ENDIF
		;基本セット
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「응, 거시기 따뜻해...」
					PRINTFORMW 부드러움 뒤에 찾아오는 가슴의 확실한 감촉을 느끼고 귀두가 움찔 떨렸다.
				CASE 0
					PRINTFORML 「이렇게 부끄러운 짓은, %조사처리(CALLNAME:MASTER,"가")% 아니면 용서 못 할 거야.」
					PRINTFORMW 스타는 눈썹을 꾹 누르며 웃어 보였다.
				CASEELSE
					PRINTFORML 스타는 유두를 주무르며 남성 성기에 비비듯이 자극해왔다.
					PRINTFORML 「앗, 이거… 저도 느껴버렸나… 후으윽..! 아 %UNICODE(0x2665) *1%」
					PRINTFORMW 스타에게도 쾌감이 밀려오고 달콤한 목소리가 새어 나온다.
			ENDSELECT
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 가슴이 아니라 유두를 %조사처리(CALLNAME:MASTER,"의")% 남근에 비빈다.
					PRINTFORML 단단하게 발기한 작은 유두는, 까끌까끌한 감촉을 성기에게 전달하며 파이즈리과는 다른 쾌감을 선사한다.
					PRINTFORML 「가슴은 없지만 이런 재주는 정도는 할 수 있거든...」
				CASE 0
					PRINTFORML 스타는 남근을 가슴에 대면서 애처롭게 %조사처리(CALLNAME:MASTER,"를")% 향해 시선을 보내고 있다.
					PRINTFORMW 「음... 거기가 여기에 있는데 삽입하지 않는 건 생살이잖아...」
					PRINTFORML 「있지 빨리... %UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 「자, 이렇게 조금만 해도 느끼다니 절개(節操)가 없네%UNICODE(0x2665) *1%」
					PRINTFORMW 스타는 다가가 준 골짜기에서 정성껏 남근을 말랑말랑하게 문질렀다.
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「하아... 왜 이렇게 공허한 걸...」
					PRINTFORML 스타는 한숨을 쉬지만 성실하게 남성의 성기에 가슴을 비빈다.
					PRINTFORMW 희고 옅은 계곡에 투명한 땀과 쿠퍼액이 섞여, 미끌거리며 남성의 성기를 지나간다.
				CASE 0
					PRINTFORML 「……재미도 없고 별로군」
					PRINTFORMW 스타는 눈앞의 귀두가 앞뒤로 움직이는 모습을 재미없다는 듯 내려다보고 있었다.
				CASEELSE
					PRINTFORML 「응... 응...」
					PRINTFORML 촉촉하고 매끄러우며 달라붙는 듯한 윤기를 머금은 가슴팍을 비비자
					PRINTFORMW 스타는 작지만 뜨거운 목소리를 흘렸다.
			ENDSELECT
			RETURN 1
		ENDIF
		;スターが普乳以上
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
