@M_KOJO_EVENT_K7_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORML 「더 하고 싶은데…… 벌써 한계야……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		PRINTFORML 「～♪」
		PRINTFORMW 스타는 만족했는지 기분이 좋아져서 %CALLNAME:MASTER%에서 떨어졌다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORML 「그럼 다음은 내 차례네」
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 만족해보고 싶지만, 나는 아직 %조사처리(CALLNAME:MASTER,"를")% 탐하고 싶은 거야」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORML 「스위치를 넣은 건... %CALLNAME:MASTER%이니까 말이야」
		PRINTFORMW 「몸도 마음도 쾌락에 잠겨, 바닥까지 가보자... %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
