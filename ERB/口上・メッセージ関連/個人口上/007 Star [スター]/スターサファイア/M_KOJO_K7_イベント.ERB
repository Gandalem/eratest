					PRINTFORMW 「%CALLNAME:MASTER%앞뿐이야? 아무것도 안 입은 나를 보여주다니... %UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORML 「어린 속옷이라고 생각하잖아?」
					PRINTFORML 「서니나 루나가 더 어린아이들이지.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORML 「전부 벗지 않는 게 나을까? 그래...?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「후후... 내 속옷으로 변태 씨는 무슨 짓을 할 생각일까요?」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「...이상한 용도로 쓰지 말아줘?」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「안 돼♪」
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
