				ELSE
					PRINTFORML 「잠깐, 무슨 생각 하는 거야...?」
					PRINTFORMW 「싫어, 그만해...!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
