				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 아무 말 없이 스타를 끌어안고 침대로 밀치며 눕힌다.
