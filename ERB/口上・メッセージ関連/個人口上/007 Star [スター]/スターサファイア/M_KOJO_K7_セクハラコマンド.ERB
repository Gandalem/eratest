@M_KOJO_MESSAGE_COM_K7_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			CASE 32
				;前から抱きつく
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 스타의 작은 몸을 탐하듯 온몸으로 세게 끌어안는다.
				PRINTFORML 가녀린 작은 몸이 조여지며, '꺅' 하고 작은 비명을 지른다.
				PRINTFORML 「응... 그렇게 거칠게 안으면 부서져 버릴 거야」
				PRINTFORMW 「있잖아, 좀 더 다정하게 안아줘...%UNICODE(0x2665) *1%」
			CASE 60
				;ディープキス
				PRINTFORML 서로의 정기를 빨아들이듯 입술과 입술, 몸과 몸을 깊게 포개었다.
				PRINTFORML 「응, 후우……츄, 응! %UNICODE(0x2665) *1%」
				PRINTFORML 스타도 눈앞의 %조사처리(CALLNAME:MASTER,"에게")% 꿈에 빠져 혀와 팔을 얽히게 하며 하나가 되려 한다.
				PRINTFORMW 「아으윽… 내가… 내가 녹아서 사라져 버릴 것 같아… %UNICODE(0x2665) *1%」
			CASE 85
				;V挿入する
				PRINTFORML 스타의 작은 몸을 꽉 끌어안고, 작은 틈을 남근 쪽으로 끌어당겼다.
				PRINTFORML 축축하게 젖은 뜨거운 질에 삼켜지며, 남근은 스타의 질 안으로 빨려 들어간다…
				PRINTFORMW 「후읏…%UNICODE(0x2665) *1%아아아아… 커어…%UNICODE(0x2665) *1%」
			CASE 88
				;腰振りV
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 스타를 껴안고, 스타의 몸을 오나홀처럼 움직이기 시작했다.
				PRINTFORMW 「아아…%UNICODE(0x2665) *1%그런…%UNICODE(0x2665) *1%난폭하게…%UNICODE(0x2665) *1%」
			CASE 86
				;だいしゅきホールド
				PRINTFORML 온몸에 퍼지는 쾌락의 물결에 떨리는 몸을, 스타는 다리를 얽어 맞이한다.
				PRINTFORML 「있잖아... 임신시켜줘」
				PRINTFORML 스타가 달콤한 목소리로 %조사처리(CALLNAME:MASTER,"의")% 귓가에 속삭인다.
				PRINTFORML 「나에게... %조사처리(CALLNAME:MASTER,"의")% 아기를 낳게 해줘...」
				PRINTFORMW 정액을 원하는 듯 파르르 떨리는 미숙한 질이, 남근을 뜨거운 맥동으로 조여왔다.
			CASEELSE
				PRINTFORML 
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「벌써 이렇게 %조사처리(CALLNAME:MASTER,"가")% 가까이 있으면 제가 부끄럽네요」
				PRINTFORMW 스타는 %조사처리(CALLNAME:MASTER,"에게")% 안겨 행복하게 수줍은 듯 미소 짓는다.
			CASE 0
				PRINTFORML 「있잖아, 내 어디가 좋아?」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 안긴 채로, 스타는 장난기 어린 미소로 %조사처리(CALLNAME:MASTER,"를")% 올려다본다.
				PRINTFORML 「……응, 전부 다. 그래서 지금 나는 안겨 있잖아. 후훗」
			CASEELSE
				PRINTFORML 스타는 %조사처리(CALLNAME:MASTER,"의")% 가슴에 귀를 대고 희미한 미소를 머금는다.
				PRINTFORML 「음... %조사처리(CALLNAME:MASTER,"의")% 소리가 들려.」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 여기에 있다는 걸 알겠어...」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			CASE 0
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 외국인이야?」
				PRINTFORMW 스타는 안기며 이상하다는 듯 고개를 기울인다.
			CASEELSE
				PRINTFORML 팔에 안긴 스타에게서 민트처럼 맑은 향기가 풍겨왔다.
				PRINTFORMW 「사람의 체온이 그립나? 애교쟁이네.」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			CASE 0
				PRINTFORML 「자, 여기 있어요%UNICODE(0x2665) *1%」
				PRINTFORML 방비도 하지 않은 채 손을 벌리고%조사처리(CALLNAME:MASTER,"를")% 유혹하는 스타를 거리낌 없이 끌어안는다.
				PRINTFORML 감촉은 하얗고 폭신하고 이상하게 짐승 냄새가 나서…………?
				PRINTFORMW 「껴안고 있는 거, 그냥 털 뭉치야」
			CASEELSE
				PRINTFORML 스타를 안으려던 팔이 무정하게 허공을 가른다.
				PRINTFORML 「그 손놀림, 속셈이 있는 거 아니야?」
				PRINTFORMW 우츠호를 날아오르며 %조사처리(CALLNAME:MASTER,"를")% 내려다보는 스타의 시선에는 경계심이 드러난다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
