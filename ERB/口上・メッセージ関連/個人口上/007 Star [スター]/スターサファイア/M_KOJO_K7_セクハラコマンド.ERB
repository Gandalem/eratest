@M_KOJO_SUCCESS_COM_K7_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K7_310
CALL M_KOJO_MESSAGE_COM_K7_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K7_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「...하고 싶어?」
				PRINTFORML 스타는 %조사처리(CALLNAME:MASTER,"의")% 손에 조심스럽게 손을 포갠다.
				PRINTFORMW 「이런 일을 당하면, 참을 수 없게 되어 버리잖아...」
			CASE 0
				PRINTFORML 스타의 아담하고 부드러운 엉덩이를 쓰다듬으며 그녀를 끌어안았다.
				PRINTFORMW 「아… 앗%UNICODE(0x2665) *1% 그렇게 만지면 안 돼%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 스타의 복숭아처럼 부드러운 엉덩이를 쓰다듬자, 그녀는 몸을 떨며 %조사처리(CALLNAME:MASTER,"의")% 손끝 감촉을 기뻐하는 듯하다.
				PRINTFORMW 「아... 그런 곳만 만지면 안 돼. ...이상한 기분이 되어버릴 것 같아」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「아직 만지게 해줄 수 없어...%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 눈을 가늘게 뜨며%조사처리(CALLNAME:MASTER,"의")% 손을 잡는다.
			CASE 0
				PRINTFORML 「엉덩이를 만지고 싶은 거야? 응」
				PRINTFORML 스타가 먹던 사리모찌를 반으로 나누어 받았다.
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 금화 모양 다이후쿠의 말랑한 감촉을 즐겼다.
			CASEELSE
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 만지고 싶은 건 이거겠지?」
				PRINTFORMW 스타에게 내밀어진 엉덩이 같은 복숭아를 %조사처리(CALLNAME:MASTER,"는")% 홀로 쓸쓸하게 가지고 논다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			CASE 0
				PRINTFORML 스타의 모습이 보이지 않는다…. 어딘가에 숨어 있는 것 같다.
				PRINTFORMW 「사악한 기척이 느껴진다면 숨는 것이 가장 좋지」
			CASEELSE
				PRINTFORML 「그 뻗은 손은 어디로 가는 걸까아~?」
				PRINTFORMW 갑자기 경쾌하게 스킵을 해보이는 스타에게 %조사처리(CALLNAME:MASTER,"의")% 손은 한 발짝 남겨두고 허공에서 끊긴다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
