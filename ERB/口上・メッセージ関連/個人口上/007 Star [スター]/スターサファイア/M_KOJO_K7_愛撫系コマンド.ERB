@M_KOJO_MESSAGE_COM_K7_0
CALL M_KOJO_MESSAGE_COM_K7_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K7_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「음... 후훗...」
		PRINTFORML 「아... 야해라...」
		PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 손가락이 스타의 탄력 있는 복숭아색 피부를 스친다.
		PRINTFORML 일부러 중심을 벗어나 비틀면서 스타의 민감한 하복부를 향해 다가가고 있다.
		PRINTFORML 「심술궂은 사람. 저런 식으로 애태우다니」
		PRINTFORML 스타의 열기로 가득 찬 목소리. 두근두근하고 어린 심장은 작게 맥박을 치며 %조사처리(CALLNAME:MASTER,"의")% 애무에 몸이 달아오른다.
		PRINTFORML 「더 이대로, 나를 흥분시켜줘... %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「――응, 응응! 으윽~~%UNICODE(0x2665) *1%」
					PRINTFORMW 스타의 질 속으로 희뿌연 액이 쏟아지자, 터져 나온 열기에 스타가 움찔 떨었다.
					PRINTFORML 그런 그녀를 위로하듯, 정액으로 가득 찬 자궁구를 위에서 부드럽게 쓸어내렸다. 
				CASE 0
					PRINTFORML 「앗, 하아……%UNICODE(0x2665) *1%」
					PRINTFORMW 흘려진 정액이 스타의 몸을 더럽히고, 황홀한 표정으로 스타는 하늘을 우러렀다.
					PRINTFORML 그런 그녀를 되돌리려는 듯, 스타의 전신을 세심하게 쓰다듬으며 애무를 계속했다.
				CASEELSE
					PRINTFORML 「이렇게 작은 아이에게… 자비가 없구나…%UNICODE(0x2665) *1%」
					PRINTFORMW 안듯이 스타의 몸을 밀착시키며 몸을 앞뒤로 움직인다.
					PRINTFORML 정액이 분출될 때마다 미끈거리는 감촉이 두 사람을 더럽혔다.
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「흐으... 아앗... 응」
					PRINTFORMW 스타의 하복부를 마사지하듯 달래자, 작은 몸이 움찔하며 뒤로 젖혀졌다.
					PRINTFORML 쿠욱쿠욱 어린 질구가 조여오자, 남근의 단단함에 스타는 후 하고 한숨을 내쉬었다.
				CASE 0
					PRINTFORML 스타를 달래듯 등을 쓸어내린다.
					PRINTFORML 간지러움 속에 뒤섞이는 기분 좋음, 스타가 몸을 비틀면 그에 맞춰 허리를 흔든다.
					PRINTFORML 「응… 크으…. 아앗… 하아아아…」
					PRINTFORMW 「거기, 쓰지 말아줘ッ…%UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 스타의 작은 가슴을 %조사처리(CALLNAME:MASTER,"의")% 손끝이 늘어난다.
					PRINTFORML 「큭... %UNICODE(0x2665) *1%」
					PRINTFORML 작지만 민감한 유두를 손가락으로 만질 때마다, 지체 없이 남성기를 자궁구로 밀어붙인다.
					PRINTFORMW 「그렇게 난폭하게 하면 안 돼... 야 %UNICODE(0x2665) *1%」
			ENDSELECT
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「후아아아아…%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 물웅덩이를 어루만지는 듯한 소리가 방에 울린다.
				PRINTFORML %조사처리(CALLNAME:MASTER,"에게")% 닿는 것만으로도 스타는 환희로 넘쳐 몸을 움찔 떨었다.
			CASE 0
				PRINTFORML 스타의 우유 같은 피부를 부드럽게 쓰다듬는다.
				PRINTFORML 가늘게 애태우는 듯한 감촉에 닿은 %조사처리(CALLNAME:MASTER,"의")% 사타구니가 흥분한다.
				PRINTFORML 「음후…… 더럽혀지자%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 어린 요정의 가랑이와 엉덩이, 가슴을 빠짐없이 맛보듯 쓰다듬는다.
				PRINTFORML 민감한 곳에 손가락이 스칠 때마다 스타는 황홀한 눈으로 %조사처리(CALLNAME:MASTER,"의")% 애무를 받아들인다.
				PRINTFORMW 「그런 민감한 곳만 만지면 안 돼... %UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 일부러 음핵이나 밀소에는 손대지 않고, 그 주위를 조심스럽게 쓰다듬는 것으로 그쳤다.
				PRINTFORML 그럼에도 불구하고 축축하게 젖은 것이 흘러넘치고, 스타는 벌벌 떨며 몸을 떨었다.
				PRINTFORML 「흐으, 아, 후, 아앗 %UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 서로의 깊은 곳을 찾는 듯 팔… 몸… 다리 등 맞닿는 부위가 많아진다.
				PRINTFORML 「……아앗, 기분 좋아서… 따뜻해%UNICODE(0x2665) *1%」
				PRINTFORMW 스타의 달콤한 냄새가 코 가득 퍼지며 더욱 %조사처리(CALLNAME:MASTER,"의")% 남근을 단단하게 만든다.
			CASEELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"에게")% 애무를 받아 스타의 충분히 개발된 무르익은 육체는
				PRINTFORML 쾌감으로 승화되는 열기에서 도망치고 싶어도 움직이는 것조차 뜻대로 되지 않아, 질에서 꿀을 흘리는 일밖에 할 수 없다.
				PRINTFORML 「아앗%UNICODE(0x2665) *1%그만해…! 자…%UNICODE(0x2665) *1%후우…응읏%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「천천히 익숙해지게 해줘...%UNICODE(0x2665) *1%」
				PRINTFORMW 마시멜로처럼 희고 부드러운 피부의 감촉을 쓰다듬으며 즐긴다.
				PRINTFORML 스타도 %조사처리(CALLNAME:MASTER,"의")% 손에 기대어 자신의 기분 좋은 곳으로 유도당하며 쾌감을 받아들인다.
			CASE 0
				PRINTFORML 만지는 것을 망설이는 듯한 아름다운 피부를, %조사처리(CALLNAME:MASTER,"의")% 손가락이 스친다.
				PRINTFORML 「거칠게 하면 안 돼. 인형을 다루듯이 상냥하게 해줘...?」
				PRINTFORMW 스타도 긴장하고 있는지, 목소리에 약간의 떨림이 느껴진다.
			CASEELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 애무하는 손에 스타의 어깨가 움찔 떨렸다.
				PRINTFORML 살짝 홍조를 띤 얼굴은 부끄러운지 %조사처리(CALLNAME:MASTER,"의")% 눈을 피했다.
				PRINTFORML 「음... %UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
