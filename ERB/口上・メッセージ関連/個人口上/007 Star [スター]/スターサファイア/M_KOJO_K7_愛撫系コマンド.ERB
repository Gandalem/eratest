	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「……응」
		PRINTFORML 스타는 미세하게 표정을 굳히며 고개를 돌린다.
		PRINTFORML 스타의 머리를 쓰다듬어 주자, 스타는 안심한 듯 희미하게 눈을 가늘게 뜨고 미소 짓는다.
		PRINTFORML 손바닥으로 스타의 어린 봉오리(蕾)를 세심히 주무른다.
		PRINTFORML 「응읏, 후우……」
		PRINTFORML 약한 자극에 노출되자 스타의 질에서 조금씩이지만, 걸쭉하게 애액이 배어 나오기 시작한다.
		PRINTFORML 「이제 괜찮을 거야……이라고 생각해. …와줘」
		PRINTFORMW 스타를 아프게 하지 않도록, 애액을 새끼손가락에 바르고 천천히 입구를 따라 쓸듯이 침입시켰다.
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스타의 반응을 살피며 조금씩 느끼는 곳을 찾아가듯 손가락으로 어린 질을 후빈다.
				PRINTFORMW 「아앗…%UNICODE(0x2665) *1% 약한 곳만 건드리면 안 돼애…%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 애액으로 흥건하게 젖은 성기를 손가락으로 비비며 스타에게 달콤한 말을 속삭인다.
				PRINTFORMW 「그런 말 들으면... 응응 %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「앗... 아아 %UNICODE(0x2665) *1%%조사처리(CALLNAME:MASTER,"가")% 들어와서... %UNICODE(0x2665) *1%」
				PRINTFORML 스타의 봉오리는 마찰로 가열되어 이대로 녹아내릴 듯 흥건하게 젖어 있다.
				PRINTFORMW 「――응, 응응! 응응~~」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 손가락에 부드럽게 닿기만 해도 스타의 몸은 점점 뜨거워져 갔다.
				PRINTFORML 「응흐… 전희가 필요 없을 정도네…」
				PRINTFORML 이대로 녹여 버리겠다는 듯 %조사처리(CALLNAME:MASTER,"는")% 흠뻑 젖은 질 깊숙한 곳을 손가락으로 휘저었다.
				PRINTFORMW 「야앗%UNICODE(0x2665) *1% 녹아버려어…%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 스타는 두 손가락을 쉽게 받아들이고 조교된 듯 윤활유를 짜내 %조사처리(CALLNAME:MASTER,"의")% 침입을 유도했다.
				PRINTFORML 「아... 점점 깊숙이 들어와버려...」 %UNICODE(0x2665) *1%
				PRINTFORMW 스타의 가장 안쪽까지 마사지하며 질을 부드럽게 어루만졌다.
			CASEELSE
				PRINTFORMW 「후, 아……%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「……에, 안 돼, 뭐야… 윽!」
				PRINTFORML 새끼손가락을 질 깊숙이 넣으려 하자, 익숙하지 않은 이물감에 스타의 작은 몸이 움찔거린다.
				PRINTFORMW 주사를 기다리는 아이처럼, 스타는 꽉 입술을 깨물고 %조사처리(CALLNAME:MASTER,"를")% 받아들이려는 모습이 가련하다.
			CASE 0
				PRINTFORML 새끼손가락의 손바닥으로 스타의 질벽을 쓸자, 따뜻한 애액이 졸졸 흘러 손가락을 적신다.
				PRINTFORMW 「응, ...크윽...%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 스타의 질 내부는 새끼손가락 하나로도 큐우쿠우 하고 조여오며, %조사처리(CALLNAME:MASTER,"의")% 손가락을 거부한다.
				PRINTFORMW 「흐읍, 안 돼…읏」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
