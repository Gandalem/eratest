@M_KOJO_MESSAGE_COM_K7_1
CALL M_KOJO_MESSAGE_COM_K7_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K7_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「물어버리면 안 돼. 여자에게 소중한 곳이니까…」
		PRINTFORML 스타는 볼을 붉히면서도 %조사처리(CALLNAME:MASTER,"에게")% 무릎을 꿇고, 자신의 화원을 열었다.
		PRINTFORML 「음……」
		PRINTFORML 혀를 사용해 스타의 미성숙한 질에 혀를 넣고 애무한다.
		PRINTFORML 살살 핥자 구강 내로 침입하는 애액의 맛이 퍼지고, 더욱 깊숙이 강하게 빨아들인다.
		PRINTFORML 「아, 안… 잠깐만… 세게 빨면… 안 돼 %UNICODE(0x2665) *1%」
		PRINTFORML 손과는 다른 육체가 빨려 들어가는 감각에, 스타는 촉촉한 눈으로 %조사처리(CALLNAME:MASTER,"에게")% 호소한다.
		PRINTFORMW 그럼에도 멈추지 않고 %조사처리(CALLNAME:MASTER,"가")% 단내 나는 곳을 핥는 소리가 겹치며, 더욱 음란한 물소리가 울려 퍼진다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「아... 야루시이...%UNICODE(0x2665) *1%」
				CASE 0
					PRINTFORML 「ちゃんとキレイにしてね。%CALLNAME:MASTER%が汚したんだから…%UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 「음... 따스함이 사라져버려...」 %UNICODE(0x2665) *1%
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스타의 민감한 부위를 노리듯 혀를 내밀어, 애액이 흐르는 질벽을 핥는다.
				PRINTFORML 「이제 나의 약점만 계속 공격하네, 치사해... 아앗 %UNICODE(0x2665) *1%」
				PRINTFORMW 볼을 장밋빛으로 물들이며, 스타는 쾌락을 갈망하며 허리를 밀어붙인다.
			CASE 0
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 스타의 부드러운 엉덩이를 움켜쥐고, 정신없이 핥아댄다.
				PRINTFORML 「아앗… 안 돼앳%UNICODE(0x2665) *1% 햐, 아아아%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 도망치려 해도 도망칠 수 없었고, 교성을 내지르며 황홀하게 녹아든 표정으로 쾌락을 받아들였다.
			CASEELSE
				PRINTFORMW 「아! 아... 아아... 으윽... 크으-」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스타의 축축하게 풀린 어린 질을 정성껏 우적우적 먹고, 핥고, 다 빨아들인다.
				PRINTFORMW 「히으... 벌써 저렇게 해버리면... 아우 %UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 스타의 꽉 다물려 있던 음순은 핥아 다 녹아내리고, 연분홍 꽃잎을 파르르 떨고 있다.
				PRINTFORML 「아, 후, 아앗%UNICODE(0x2665) *1% 아앗, 하아%UNICODE(0x2665) *1%」
				PRINTFORMW 입과 질을 체액으로 흠뻑 적신 채 흐트러진 스타는, 이대로 흐물흐물 녹아버릴 것만 같다.
			CASEELSE
				PRINTFORML 「아앗… 하아…%UNICODE(0x2665) *1%눈앞이 번쩍번쩍 빛나서…%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「앗... 응, 거기, 더 빨아줘...%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 허리를 들고%조사처리(CALLNAME:MASTER,"의")% 머리에 손을 대고 눌러왔다.
			CASE 0
				PRINTFORML 「야우! 벌써 이상한 목소리가 새어 나오잖아...」
				PRINTFORML 「하아... 그러니까 거긴 안 돼! 또 소리를 내게 될 거야... %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「음... 으윽... 으윽 %UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 익숙하지 않은 감각에 눈을 감고, 그저 쾌락을 받아들이고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
