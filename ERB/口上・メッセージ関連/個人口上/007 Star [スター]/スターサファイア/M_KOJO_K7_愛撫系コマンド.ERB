@M_KOJO_MESSAGE_COM_K7_2
CALL M_KOJO_MESSAGE_COM_K7_2_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K7_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「음... 제대로 깨끗하게 하고 있네」
		PRINTFORML 스타는 %조사처리(CALLNAME:MASTER,"의")% 남근에 후우... 하고 숨을 불어넣는다.
		PRINTFORML 그 행위만으로 움찔 반응해버리자, 푸스스하고 스타에게 웃음을 자아낸다.
		PRINTFORML 「참지 못하는 아이네. ...응」
		PRINTFORML 스타가 흘린 타액이 귀두에 떨어지고 질척하고 따뜻한 점액이 자루에 스며들 듯 주물러진다.
		PRINTFORML 생사조차 모를 듯한 시간, 한심한 표정을 짓는 %조사처리(CALLNAME:MASTER,"에게")%, 스타는 만족스럽게 웃는다.
		PRINTFORML 「초조해하면 안 돼... %UNICODE(0x2665) *1% 지금 기분 좋게 해줄 테니까...」
		PRINTFORMW 그렇게 말하며 스타는 작은 입을 열고, %조사처리(CALLNAME:MASTER,"의")% 남근을 구강 안으로 침입시키기 시작한다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 스타의 입안에서 전해지는 따스함이 그대로 느껴져, 안개에 휩싸인 듯 윤곽이 녹아내릴 것만 같다.
				PRINTFORML 흥분한 것인지 핥을 때마다 따스해지며 은은한 쾌감을 안겨 준다.
				PRINTFORMW 「츄우~%UNICODE(0x2665) *1%쭉쭉%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 「이것이 나의 질 안에…. 제대로 깨끗하게 해드릴게요네%UNICODE(0x2665) *1%」
				PRINTFORMW 스타는 정성스럽게 기둥과 칼날을 핥아먹으며, %조사처리(CALLNAME:MASTER,"의")% 아들에게 봉사하고 있다.
			CASEELSE
				PRINTFORML 「으응... 쭉쪽쯧%UNICODE(0x2665) *1%」
				PRINTFORMW 핥듯이 혀로 점막을 쓸어 올린다.
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「쭈르... 쭈루루룻%UNICODE(0x2665) *1%」
				PRINTFORML 스타의 혀가 %조사처리(CALLNAME:MASTER,"의")% 성기에 감긴다.
				PRINTFORMW 혀끝으로 칼 모양 돌출부 뒤에 남은 쿠퍼액을 핥아 빨아들인다.
			CASE 0
