; Modular ERB: 個人口上/007 Star [スター]/スターサファイア/M_KOJO_K7_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K7
RETURN 1

@M_KOJO_MESSAGE_MARKCNG_K7
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「...윽, ...나쁜 사람. 무슨 짓을 해주는 걸까」
	ENDIF
ELSEIF TFLAG:22 == 2
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「아니, 싫어... 미안해. 이제 싫어...」
	ENDIF
ELSEIF TFLAG:22 == 3
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「아파... 아파... 이런 건 싫어...」
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 「으윽...응...%UNICODE(0x2665) *1%」
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「이런 것을 알아버리면 헤어질 수 없잖아...」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORML 「빨리... 기분 좋은 거 하자...」
	PRINTFORMW 「사람들 눈 같은 건 상관없어. %조사처리(CALLNAME:MASTER,"랑")% 기분 좋아지기만 하면 돼 %UNICODE(0x2665) *1%」
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「지금만은 %조사처리(CALLNAME:MASTER,"의")% 말을 들어주겠다」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 「주인님...이라고 불러도 괜찮을까요」
	PRINTFORMW 「스스로도 이렇게 순종하게 될 줄은 몰랐어요」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 원한다면 죽어줄게」
	PRINTFORML 「이 몸조차 마음대로 해도 좋으니까!」
	PRINTFORMW 「그러니까 부탁이야, 나에게서 떨어지지 말아줘...!」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 스타의 모습이 보이지 않는다. %조사처리(CALLNAME:MASTER,"를")% 만나는 것도 싫은 걸지도 모른다….
ELSEIF TFLAG:21 == 2
	PRINTFORML 「복수심은 제4의 욕망」
	PRINTFORMW 「잠을 자도 먹어도 성적인 것을 채워도, %CALLNAME:MASTER%에 대한 분노는 끝나지 않아...」
ELSEIF TFLAG:21 == 3
	PRINTFORML 「나 같은 요정을 마음대로 하고 있으면 되지 않아」
	PRINTFORML 「대신 %조사처리(CALLNAME:MASTER,"는")% 더 이상 우아하게 낮잠을 자는 것조차 불가능해질 테니까」
	PRINTFORMW 「나는 이제 어디에 있든 %조사처리(CALLNAME:MASTER,"를")% 잊지 않을 거야... 절대로」
ENDIF
