@M_KOJO_SUCCESS_COM_K7_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K7_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K7_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K7_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, curiosity event.
	RESULT = 0
	TRYCALL K5_SANGETSUSEI_CURIOSITY
	SIF RESULT
		RETURN 1
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「휴... 지루하네」
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 2
				PRINTFORML 「후후, 그런 것이 있다니 환상향은 신비로 가득하네」
				PRINTFORMW 스타는 빙긋 웃으며 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
			CASE 1
				PRINTFORML 「장난의 극의를 가르쳐 줄게. 그것은 타협해서는 안 돼」
				PRINTFORMW 「상대가 장난이 끝났다고 생각했을 때, 더 꾸며서 놀라게 하는 거야!」
			CASE 0
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 와주면 질리지 않아」
				PRINTFORMW 「언제나 즐거운 이야기를 들려주고 게다가...」
			CASEELSE
				PRINTFORML 「%CALLNAME:MASTER%도 버섯 분재 해볼래?」
				PRINTFORMW 「나무 분재와는 다른 와비사비를 느낄 수 있어서 즐거워」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「루나는 좀 둔하네」
				PRINTFORMW 「소리를 없애버리니까 주변의 이상에 눈치채기 어려울지도 몰라.」
			CASE 0
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 기척은 조금 독특한 걸까?」
				PRINTFORMW 「왜냐면 다가오면 바로 알 수 있는 거니까」
			CASEELSE
				PRINTFORML 「%CALLNAME:MASTER%도 장난꾸러기야?」
				PRINTFORMW 「잘 맞네! 다음에 학령 신사에 장난치러 가자.」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「너무 돌아다니다가 다른 요정에게 습격당할지도 몰라?」
				PRINTFORMW 「그것도 나름 재미있을 것 같네.」
			CASE 0
				PRINTFORMW 「장난의 실험체가 되어 줄래?」
				PRINTFORML 「우후후, 농담이야」
			CASEELSE
				PRINTFORML 「요정에게 말을 거는 건 정말 별난 사람이네」
				PRINTFORML 「그렇게 장난치길 바라는 거야?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
