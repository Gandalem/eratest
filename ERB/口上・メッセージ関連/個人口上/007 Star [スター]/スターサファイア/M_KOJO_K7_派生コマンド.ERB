; Modular ERB: 個人口上/007 Star [スター]/スターサファイア/M_KOJO_K7_派生コマンド.ERB
;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K7_6
CALL M_KOJO_MESSAGE_SCOM_K7_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K7_6_1
;custom code, moved from M_KOJO_MESSAGE_COM_K7_72_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「더, 더 %조사처리(CALLNAME:MASTER,"를")% 새겨줘읏%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「사양하면 안 돼%UNICODE(0x2665) *1% 그, 그래, 더%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「야아앗%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「앗… 거기읏, 좋아%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「더 후벼 팔 때까지 찔러줘앗…%UNICODE(0x2665) *1% 아, 하아아%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「응읏%UNICODE(0x2665) *1%터져 흩어져 버릴 것 같아…%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「꺄악! 으응으읏%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「아우…… 거기만 계속 괴롭히면 어떡해애%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「응읏… 조금 너무 강해읏…!」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
