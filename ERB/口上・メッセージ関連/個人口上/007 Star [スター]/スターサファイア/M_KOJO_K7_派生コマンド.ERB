@M_KOJO_MESSAGE_SCOM_K7_7_1
;custom code, moved from M_KOJO_MESSAGE_COM_K7_73_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「내 배, %조사처리(CALLNAME:MASTER,"의")% 모양이 되어버릴 것 같아……%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「이제 막다른 곳이야아…… 아핫%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「싫어! 그만둬… 라고 말해도 그만두지 말아줘%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「아하앗%UNICODE(0x2665) *1% 그렇게나 나를 임신시키고 싶어?… 꺄앗%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 게 나를 절대 임신시키고 싶다고 말하고 있어…%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「후우~…%UNICODE(0x2665) *1%으아, 크으으…%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「아앗 아앗%UNICODE(0x2665) *1%뱃속이 엉망진창으로……%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「히야, 주, 죽어버려어…%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「응읏…… 응읏… 응응읏!」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
