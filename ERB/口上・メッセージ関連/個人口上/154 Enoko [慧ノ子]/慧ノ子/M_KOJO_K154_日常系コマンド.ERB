@M_KOJO_MESSAGE_MESSAGECHECK_COM_K154_301
RETURN 0

@M_KOJO_MESSAGE_COM_K154_301
CALL M_KOJO_MESSAGE_COM_K154_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K154_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「맛없어!」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「......응, 다음에는 마리사에게 차 타는 법을 배우려고 해!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「윽... 꽤나 정성스러운 대접이네...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「……이번엔 내가 내려 줄게~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「마법의 숲의 차잎이 더 맛있을지도 모르겠어... 나루미에게 물어볼게~」
		ELSE
			PRINTFORMW 「별로 맛있지가 않아!」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「응! 차를 우려보자~!! 좋은 기운이네~!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「좋은 찻잎 쓰고 있네~ 다음에 알려줘~」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「마리사보다 잘할지도!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음~ 맛있는 차네~」
		ELSE
			PRINTFORMW 「살아있어서 다행이라고 생각할 수 있는 차네.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K154_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K154_302
RETURN 0

@M_KOJO_MESSAGE_COM_K154_302
CALL M_KOJO_MESSAGE_COM_K154_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K154_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「그만둬!」
			PRINTFORMW 에노코는 스킨십에 대해 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「적당히 안 하면 물어버릴 거야!」
			PRINTFORMW 에노코는 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「뭐 하는 거야!」
			PRINTFORMW 에노코는 화난 표정으로 항의한다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「자, 빨래하자~!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그렇게 부끄러워할 필요 없는데~」
			PRINTFORMW 에노코는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 몸에 밀착해 있다.
			PRINTFORMW 「나랑 너 사이잖아~」
		ELSE
			PRINTFORMW 「꼬리도 씻어줬으면 좋겠네~ 라니 말이야~」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「음~ %조사처리(CALLNAME:MASTER,"에게")% 만져지는 거 좋아~ %UNICODE(0x2665) *1%」
			PRINTFORMW 에노코는 그렇게 말하면서도 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 즐기고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「어쩔 수 없이 들떠버렸지만 괜찮지~」
			PRINTFORMW 에노코는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 기대고 있다.
		ELSE
			PRINTFORMW 「음~ 손 잡는 건 좀 곤란해~」
			PRINTFORMW 에노코는 그렇게 말하며 안아왔다.
			PRINTFORMW 「이렇게 안아주는 게 더 좋은 걸까……」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음~ 사람의 체온을 느낄 수 있는 거리감이라 좋다~」
			PRINTFORMW 그렇게 말하며 에노코는 %조사처리(CALLNAME:MASTER,"에게")% 어깨를 기댔다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 무슨 일이야? 손이라도 마사지 해줄까?」
			PRINTFORMW 에노코는 얼굴을 붉히며 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 취하고 있다.
		ELSE
			PRINTFORMW 「……응」
			PRINTFORMW 에노코는 얼굴을 붉히며 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 하고 있다.
			PRINTFORMW 「뭐 하든 괜찮아, 물지 않을 테니까」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「마리사에게 들키면 소문날지도 몰라~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「멍멍 같네~」
			PRINTFORMW 「...너 쪽이 개 같을지도...」
		ELSE
			PRINTFORMW 「응?」
			PRINTFORMW 「손을 잡는 건 괜찮지만 물어버릴지도 몰라~」
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「음~ 좀 가까이 온 것 같아~」
			PRINTFORMW 「누구에게나 하는 거야? 인기가 많겠네~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「거시기? ……성희롱이야 그거」
			PRINTFORMW 에노코는 %조사처리(CALLNAME:MASTER,"와")%의 스킨십에 기뻐하면서도 당황하고 있다.
		ELSE
			PRINTFORMW 「사키님에게는 잔뜩 쓰다듬어 받았지만 인간 상대라면 좀 곤란하네~」
			PRINTFORMW 에노코는 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 조금씩 받아들이고 있다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「뭔가? 손? ……실례야, 너.」
			PRINTFORMW 에노코는 싫어하는 것 같지는 않지만 당황하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「와아 격렬하네~!」
			PRINTFORMW 에노코는 약간 당황하며 스킨십을 취하고 있다.
		ELSE
			PRINTFORMW 「이런 건 친한 사람한테 해야지?」
			PRINTFORMW 에노코는 조금 어이없다는 듯 스킨십을 취했다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
