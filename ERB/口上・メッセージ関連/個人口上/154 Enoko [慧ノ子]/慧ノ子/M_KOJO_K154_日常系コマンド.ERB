			;PRINTFORMW
		CASE 11
			;▼実験［実験を手伝う］
			;PRINTFORMW
		CASE 12
			;▼のんびり［一緒にのんびりする］
			;PRINTFORMW
		CASE 13
			;▼晩酌［晩酌に付き合う］
			;※酒耐性0以上のみ
			;PRINTFORMW
		CASE 14
			;▼買い物［買い物を手伝う］
			;PRINTFORMW
		CASE 15
			;▼説教［様子をうかがう］
			;※神霊・蓬莱人は除く
			;TFLAG:193,-1
			;PRINTFORMW
		CASE 16
