; Modular ERB: 個人口上/154 Enoko [慧ノ子]/慧ノ子/M_KOJO_K154_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K154_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K154_300
RETURN 0

@M_KOJO_MESSAGE_COM_K154_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K154_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K154_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「흥! 말 걸지 마세요!」
		;会話不能
	ELSEIF TCVAR:302
		IF RAND:5 == 0
			PRINTFORMW 「에- 그렇구나-」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「멍」
			PRINTFORMW 에노코는 입을 벌리고 당황하고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「더 이야기하자~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「할머니는 젊은이들의 화제 같은 건 모르겠어서...」
		ELSE
			PRINTFORMW (좀 더 재미있는 이야기는 없을까~)
		ENDIF
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「우와아! 냠냠 해버릴 거야~?」
			PRINTFORMW 에노코는 취한 채로 달라붙는다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 할머니 취해버렸어……%UNICODE(0x2665) *1%
			PRINTFORMW 에노코는 취해서 달라붙는다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「야타가라스는 취해서 퇴치당했지만 케르베로스는 어떨까?」
			PRINTFORMW 에노코는 얼굴을 상기시키며 말을 건다.
			PRINTFORMW 「뭐 상관없어! %CALLNAME:MASTER%라면…… 응 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%CALLNAME:MASTER%……에헤헤헤~ッ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%……좋은 냄새가 나네, 먹어버리고 싶어%UNICODE(0x2665) *1%」
		ENDIF
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「음~ 술에 잘 취하지 않는 체질이긴 하지만 말이야~」
			PRINTFORMW 「나이가 들면 알코올의 효과도 떨어지는 걸까~?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 말이야, 죽고 싶다고 생각한 적 있어?」
			PRINTFORMW 에노코는 취해서 말을 건다.
			PRINTFORMW 「나는 있어, 하지만 지금은――없을지도 모르겠어」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「……응?」
			PRINTFORMW 「어디 보고 있었을까~ 야한 거라니~ %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%CALLNAME:MASTER%~불렀을 뿐이야~%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「후후후후~ 취하기에 좋은 날이네 %UNICODE(0x2665) *1%」
		ENDIF
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「술은 맛있진 않지~ %CALLNAME:MASTER%쪽이 더 맛있는지도 몰라」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「만일의 때는 간호해 줘~」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「음... 술은 취약할지도...」
			PRINTFORMW 「취기가 돌아서 물병에 걸리면 괴로우니까~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음~ 취한 기분 같은 거?」
		ELSE
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 것도 더 들려줘~~~」
		ENDIF
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「마리사는 말이야~ 자주 울곤 했어~」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「그 아이도 훌륭하게 자라서 나도 감동했어~」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「술은 맛있지만 너무 많이 마셔서 죽지 않도록 해~ 나는 죽지 않을 테니까.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「대나무 숲의 늑대 분도 좋은 털을 가지고 계실 것 같아요~」
		ELSE
			PRINTFORMW 「사키님은 말이야! 엄청 강하고 멋있다고~~~!!!」
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「나는 이제 빨리 달릴 수 없으니까.」
			PRINTFORMW 「사키님이 잔뜩 뛰는 걸 보면 기뻐져요!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「우으... 술에 익숙하지 않아...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「이렇게 사람들과 마시는 건 신기한 느낌이야~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「트라바사미는 바깥세상이라고 금지라고? 뭔가 슬프네~」
		ELSE
			PRINTFORMW 「꽤 많이 마셨네~ 즐거워지기 시작했어!」
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「잠깐~ 어디 보고 있는 거야~?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「와아! 케르베로스잖아~!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「지옥의 파수견이라면 최선을 다해 파수꾼을 해야겠어~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아, 죽고 싶어지기 시작한 것 같아」
		ELSE
			PRINTFORMW 「옛날 일 같은 건 기억 못 하니까 술에 취하는 걸까?」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「제대로 목욕 안 하면 냄새 나니까~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「모처럼이니까 목욕하자~?」
		ELSE
			PRINTFORMW 「꼬리가 세 개나 있으면 씻기도 힘들다~」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「봄이라 그런가~ 포근하네~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「벚꽃도 질 거라고 생각했는데 질리지가 않네~」
					ELSE
						PRINTFORMW 「봄이 되면 좀 더워지기 시작하잖아~」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「덥네~ 나는 시원한 옷을 입고 있는데 말이야~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「여름에는 물놀이하고 싶네~ 강아지 목욕은 잘할 수 있어~」
					ELSE
						PRINTFORMW 「여름은 개방적이 되잖아~ 원래부터 개방적이야? ......야하다!」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「단풍을 보니 감상에 잠기네~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「가을의 맛도 잔뜩 먹고 싶네~」
					ELSE
						PRINTFORMW 「예술의 가을이니까 함을 놓는 거지~」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「으음... 추워졌네... 그런 차림이라서? 그럴지도 모르겠어~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「사키님과 전골 먹고 싶네~」
					ELSE
						PRINTFORMW 「마법의 숲에 있는 지장보살님은 잘 지내고 있을까나아」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						PRINTFORMW 「너에게는 죽어도 좋을지도 몰라, 뭐~」 %UNICODE(0x2665) *1%
					ELSEIF RAND:4 == 0
						PRINTFORMW 「많이 먹고 커져야 해, 그러면 내가 먹여 줄 테니까~ %UNICODE(0x2665) *1%」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「%CALLNAME:MASTER%도 내 고기 먹으면 불로불사가 될까」
						PRINTFORMW 「시험해 볼래? 괜찮아, 줄어드는 거 아니거든~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이렇게 연인처럼 이야기하게 될 줄은 상상도 못 했네~」
					ELSE
						PRINTFORMW 「마치 꿈만 같아」
						PRINTFORMW 「좋아하는 사람이랑 이렇게 이야기하다니~ 행복하네~」
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 먹고 싶은 거 같은 거 있어? 잔무님 고기는 추천 안 해~」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「마리사에게 들키면 놀림당할지도 몰라~」
						PRINTFORMW 「……그 아이, 이런 거 좋아하는구나」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「좋은 윤기가 나네? 부끄러워지잖아, 그런 말 하면... %UNICODE(0x2665) *1%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「사키님 고기도 맛있어 보이네~ 좀 나눠주면 안 될까?」
					ELSE
						PRINTFORMW 「너한테 목걸이 걸린 기분이야~ 너무 세게 잡아당기면 안 돼?」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「음음, 그 옷 추우지 않아?」
						PRINTFORMW 「...좀 성희롱이야~」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「사키님은 발이 빨라서 따라잡기가 힘들어요~」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「평소에는 느긋하게 지내지만 이렇게 사람들과 이야기하는 것도 즐거울지도 모르겠네~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「너는 여러 가지 이야기를 알고 있구나~ 나도 많이 듣고 싶어~」
					ELSE
						PRINTFORMW 「옛날 일은 별로 기억나지 않으니까 너랑 이야기하는 게 즐거워~」
					ENDIF
				ELSEIF CFLAG:2 >= 500
					IF RAND:5 == 0
						PRINTFORMW 「너의 고기? 맛있지 않을 것 같아~」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「이 보옥? 너무 만지지 않는 게 좋아~」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「좋아하는 고기 이야기? ……사실 채식주의자라고 말하면 믿어줄까?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「지옥은 번견이니까 토리 씨와 동료가 될까? 아, 하지만 우리들의 적일지도?」
					ELSE
						PRINTFORMW 「잔무님의 생각은 어렵지~」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「너무 시끄럽게 하면 물어버릴 거야~」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「모두 수다스럽네~」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「여러 가지 재미있는 이야기 가지고 있네~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「아하하, 재미있네~」
					ELSE
						PRINTFORMW 「마리사처럼 수다스럽네~」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
