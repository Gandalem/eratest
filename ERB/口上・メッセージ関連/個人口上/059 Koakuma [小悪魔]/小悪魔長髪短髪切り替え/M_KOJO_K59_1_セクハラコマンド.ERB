@M_KOJO_長短髪_MESSAGE_COM_K59_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
			PRINTFORML 
			PRINTFORMW 
		ELSE
			PRINTFORML 
			PRINTFORMW 
		ENDIF
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「저... %MASTERNAME:59%...?」
		IF TALENT:恋慕
			PRINTFORML 「이런 것에는, 티비오 같은 게 있거든요. 뭔가 지금은 그런 느낌이 아니잖아요」
			PRINTFORMW %NICKNAME:59%는 진지한 표정으로, %조사처리(CALLNAME:MASTER,"에게")% 주의를 준다
		ELSE
			PRINTFORMW 소악마는, 말을 끝내기 전에, %조사처리(CALLNAME:MASTER,"에게")% 뺨을 때린다.
			;体力マイナス50ぐらい。かなり加減した一撃
			PRINTFORMW 「뭐랄까! 소녀의 마음이라니! 그런 문제가 아니잖아요!? 반성하세요!」
			PRINTFORMW 상당히, 화가 난 것 같다...
			BASE:MASTER:体力 -= 50
		ENDIF
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 
				PRINTFORMW 
				PRINTFORMW 
				PRINTFORMW 
			CASE 0
				PRINTFORML 
				PRINTFORMW 
				PRINTFORMW 
			CASEELSE
				PRINTFORMW 
				PRINTFORMW 
		ENDSELECT
	ELSEIF TFLAG:SELECTCOMの分岐 == 99 || TFLAG:192 == -2
		PRINTFORMW 「...무언가 하려고 했던 건가요?」
		PRINTFORMW 어느새 소악마는 크게 거리를 두었다.
	ELSEIF TALENT:思慕
		PRINTFORML 
		PRINTFORMW 
	ELSE
		PRINTFORML 
		PRINTFORMW 
	ENDIF
ENDIF
RETURN 1
