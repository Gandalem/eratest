;依頼口上・一般依頼02：お花に水をあげて
;==================================================

@M_KOJO_長短髪_IRAI_2_K59(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「조금 꽃을 키우고 있는데, 한번 보러 오지 않겠어요?」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORMW 「흥미가 없었나요?」
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「평범한 꽃인데요, 예쁘죠-」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORMW 「방의 꽃을 봐 줄 거지?」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORMW 「꽃 같은 기분은 아니었나요? 그러고 보니 배가 고파지기도 하네요」
		RETURN 1
	CASE "依頼実行直前"
		;【◆口上】
		;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
		;【▼そのまま下の口上へ】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			PRINTFORMW 「예쁜 꽃이죠? 자, 실은 여기가 이런 느낌이라...」
			RETURN 1
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			PRINTFORMW 「오호, 물 주기 대행이라니. 대단하시네요.」
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			;この場合はそのまま下の口上へ続きます
			PRINTFORMW (뭐, 나의 아름다움에는 아니겠지만 말이야)
			RETURN 1
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：\500
		PRINTFORMW 「꽃에 대해 이야기 나눌 수 있어서 즐거웠어요. 또 이야기해요.」
		;初回の時だけ言わせたい
		;PRINTFORMW 「そういえば知ってます?とあるマンションで伝わっている話によると、お花にお水をあげると、お花がお礼をくれるそうです」
		;PRINTFORMW 「もしかしたら、%MASTERNAME:59%の元にも、お礼が来てたりするかもしれませんね?」
		;小悪魔からすれば花を見せただけなんだから、報酬を支払う理由がないのです
		PRINTFORMW 그렇게 말한 %NICKNAME:59%은 꽃처럼 아름다운 미소를 지었다.
		RETURN 1
	CASE "失敗報告時"
		PRINTFORMW 「제 방에 있는 꽃, 보러 가자고 말했었죠...?」
		RETURN 1
	CASE "依頼報告不要"
		PRINTFORMW 같이 꽃을 보고, 그리고 이야기 나누려고 했는데 말이야... 뭐, 괜찮겠지
		RETURN 1
ENDSELECT
