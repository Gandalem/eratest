;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_長短髪_IRAI_6_K59(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「저는 나름대로 지식에는 자신이 있지만, 그래도 모르는 것이 있는 거군요」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORMW 「이런 때, 누군가 가르쳐 줄 현명한 분이 계시다면 존경하게 되죠. 라고 생각하거든요」
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「엣? 그 모르는 걸 가르쳐 주시는 건가요!? 그런 의도는 아니지만... 아니, 부탁드릴게요!」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORMW 「나도 모르는 것을, 가르쳐 주시기로 했잖아요?」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORMW 「어머, 잘 가르쳐 드릴 수 있을지 자신 없어졌나요? 아아, 뭐... 어쩔 수 없죠」
		RETURN 1
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			PRINTFORMW 「이거라면, 뭔가 알 수 있을지도...?」
			RETURN 1
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			PRINTFORMW 「어라? 뭔가 조사하고 계신가요? 저도 %MASTERNAME:59%을 따라야 할까요.」
			RETURN 1
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			PRINTFORML 「과연...」
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORMW 「과연... 그런 것이라면... 혹은...」
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					PRINTFORMW 「괜찮다면 협력할까요? 혼자 하는 것보다 두 명이 더 빨리 끝날 거예요. 이렇게 단순하지만 옳은 말이라는 생각도 들어요.」
					RETURN 1
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				PRINTFORMW 「정말 알기 쉽고, 참고가 됐어요!」
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				PRINTFORMW 「...전혀 모르겠어요!」
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		PRINTFORMW 「저도 더 공부해야겠네요!」
		RETURN 1
	CASE "失敗報告時"
		;全く決めてないが、"日数の経過"と"単純に失敗"で、反応が変えられるなら変えたい
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
