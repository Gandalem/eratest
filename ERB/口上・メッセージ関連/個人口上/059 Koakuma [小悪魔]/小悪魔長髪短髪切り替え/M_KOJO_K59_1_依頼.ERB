;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_長短髪_IRAI_12_K59(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「잠깐 탄막 놀이에 대해 연구하고 있는 것이 있어서요」
		PRINTFORMW 「그 증명을 위해, 어떤 분과 싸워오셨으면 해요」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORMW 「응, 탄막 게임이라고 해도 맞으면 아프고 위험하니까요.」
		PRINTFORMW 「그런 거 하는 거 싫죠. 알아요, 알아요」
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「감사합니다」
		PRINTFORMW 「아, 빼먹을 뻔했는데, 승리 정보가 가장 중요하니까요」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORMW 「어떤 분과의 탄막 대결 전투 기록을 보고해 주십시오」
		PRINTFORMW 「패배로부터의 정보도 궁금하지만, 승리의 정보를 부탁드립니다」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORMW 「뭐, 아픈 건 싫겠죠」
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			PRINTFORMW 「뭐인지는 모르겠지만, 어쩔 수 없지. 할까?」
			PRINTFORMW 「...라니, 실내에서는 위험하다고? 무녀가 쳐들어 왔을 때는 아무렇지도 않게 했는데?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			PRINTFORMW 「탄막 승부? 지금은... 보고 알 수 없나요?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			PRINTFORMW 「%MASTERNAME:59%... 당신은 어디서 보아도 지쳐 보여요」
			;関係性次第で、「貴方…あなた～」というセリフになるが気にしてはいけない
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			PRINTFORMW 「응? 탄막 승부? 아니, 나의 지금 모습, 잘 봐주세요...」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			PRINTFORMW 「계속 해도 의욕이 생기지 않아.」
			RETURN 1
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			PRINTFORMW 「탄막 승부? 뿐인 분 대신? 왜지?」
			PRINTFORMW 「...뭐 괜찮아요, 상대할게요」
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORMW 「두 시간 전에 다시 나가세요!」
				PRINTFORMW 「...말해보고 싶었던 거예요, 이거」
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				PRINTFORMW 「나중에 하죠. 나중에.」
				RETURN 1
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			PRINTFORMW 「크윽!」
			PRINTFORMW 「...%MASTERNAME:59%에게 건네준 사람에게는 '소악마는 아름답게 쓰러졌다'고 전해 주세요.」
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		PRINTFORMW 「과연... 그랬군요」
		PRINTFORMW 「이것은 참고가 될 것 같습니다. 감사합니다!」
		RETURN 1
	CASE "失敗報告時"
		PRINTFORMW 「결과는 얻지 못하셨나요... 유감입니다」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
