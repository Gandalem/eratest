;==================================================
;82,パイズリ
;==================================================

@M_KOJO_長短髪_MESSAGE_COM_K59_82
CALL M_KOJO_長短髪_MESSAGE_COM_K59_82_1
RETURN RESULT

@M_KOJO_長短髪_MESSAGE_COM_K59_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「가슴으로 거시기, 꽉 조여줬으면 하는 건가? 후훗, 가슴 좋아하는구나」
		PRINTFORM %NICKNAME:59%는, %조사처리(CALLNAME:MASTER,"의")%
		SIF TALENT:MASTER:形状 <= 2
			PRINTFORM 작은
		PRINTFORMW 페니스를 큰 가슴으로 감싸다
		PRINTFORML
		SIF TALENT:MASTER:形状 <= 2
			PRINTFORMW 「어머, %MASTERNAME:59%는 부끄럼쟁이군요♡ 가슴에 숨어버리고♡」
		PRINTFORMW 「그럼, 가슴으로 성기를 꽉 잡아드릴게요♡」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 
				PRINTFORMW 
			CASE 0
				IF TALENT:MASTER:形状 <= 2 && RAND:2
					PRINTFORML 
					PRINTFORMW 
					PRINTFORMW 
					SIF NOWEX:PLAYER:射精
						PRINTFORMW 
				ELSE
					PRINTFORML 「」
					PRINTFORMW 
					SIF NOWEX:PLAYER:射精
						PRINTFORMW 
				ENDIF
			CASEELSE
				;かわいいおちんちん＆半分の確率
				IF TALENT:MASTER:形状 <= 2 && RAND:2
					PRINTFORML 「%MASTERNAME:59%의 거시기, %NICKNAME:59%의 가슴으로 숨바꼭질하는 걸 제일 좋아하네요♡」
					PRINTFORMW 「후훗♪ 어디에 있는 걸까~? 숨지 말고 나와도 괜찮아요~♡」
					PRINTFORMW %NICKNAME:59%는 그렇게 말하며, %조사처리(CALLNAME:MASTER,"의")% 페니스를 가슴으로 주무른다.
					SIF NOWEX:PLAYER:射精
						PRINTFORMW 「...어라? 나오려고 하는 건가요? 부끄러워하시지만 외로운 걸 좋아하시는군요 ♡」
				ELSE
					PRINTFORML 「음, 가슴으로 꽉 안기는 거 어때요?」
					PRINTFORMW 「%MASTERNAME:59%, %NICKNAME:59%의 가슴이 기분 좋다면, 주저하지 말고 말해 주세요♡」
					SIF NOWEX:PLAYER:射精
						PRINTFORMW 「...덜덜 떨고, 알기 쉬워 ♡」
				ENDIF
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
