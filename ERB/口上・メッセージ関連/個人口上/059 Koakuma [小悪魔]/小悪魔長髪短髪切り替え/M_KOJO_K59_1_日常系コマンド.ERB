;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
	ELSEIF TALENT:恋人
		;------------------------------------------------------------------
		;条件を満たしている場合1/4で表示
		;------------------------------------------------------------------
		IF ABL:精液中毒 >= 5 && !RAND:4
			PRINTFORML 「이렇게 때 하나 없이 깨끗해져도, 또 더럽혀지는 거죠...♡」
			PRINTFORMW %NICKNAME:59%은 %조사처리(CALLNAME:MASTER,"를")% 향해 시선을 주며 뭔가 의미심장한 말을 했다.
			;------------------------------------------------------------------
			;RETURN 1するとそこで関数を抜けるので、いちいちELSEIFを繋げなくて済む
			;------------------------------------------------------------------
			RETURN 1
		ENDIF
		;------------------------------------------------------------------
		;上記の分岐に引っかからなかった場合ここで3択
		;------------------------------------------------------------------
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML (하아...%MASTERNAME:59%...♡)
				PRINTFORMW %NICKNAME:59%는%조사처리(CALLNAME:MASTER,"를")% 바라보면서도 정확하게 청소하고 있었다.
			CASE 0
				PRINTFORML 「이렇게 아름답게 해도, 제 발밑에도 미치지 못해요. 아름다움이란 죄인 거죠.」
				PRINTFORMW 「...어라, 이런 말을 하고 있는 걸 죄인을 심판하는 입장의 사람에게 들키면 큰일이에요!」
			CASEELSE
				PRINTFORML 「솔직히 청소는 귀찮죠~」
				PRINTFORMW 「하지만 깨끗해졌을 때 기분이 좋아지는 것도 사실이잖아요~」
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML (%MASTERNAME:59%…)
				PRINTFORMW %NICKNAME:59%는 %조사처리(CALLNAME:MASTER,"에게")% 시선을 향하고 있음에도 정확하게 청소하고 있다.
			CASE 0
				PRINTFORML 「이렇게 아름답게 해도, 제 발밑에도 미치지 못해요. 아름다움이란 죄인 거죠.」
				PRINTFORMW 「...어라, 이런 말을 하고 있는 걸 죄인을 심판하는 입장의 사람에게 들키면 큰일이에요!」
			CASEELSE
				PRINTFORML 「솔직히 청소는 귀찮죠~」
				PRINTFORMW 「하지만 깨끗해졌을 때 기분이 좋아지는 것도 사실이잖아요~」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「좋아! 틀림없이 예뻐졌네요! 자, %MASTERNAME:59%도 확인, 확실하게 하고 있나요?」
				PRINTFORMW 소악마는 청소한 장소의 체크를 철저히 하고 있다.
			CASE 0
				PRINTFORML 「음, 아무리 청소해서 깨끗하게 해도 나보다 예뻐질 일은 없죠. 곤란해져 버려요♪」
				PRINTFORMW 소악마는 %조사처리(CALLNAME:MASTER,"와")% 함께 청소한 장소를 바라보며 그런 말을 중얼거렸다
			CASEELSE
				PRINTFORMW 「아랫사람들에 대한 지도도 하고 있으니까, 같이 청소하는 건 자신 있어요.」
				PRINTFORMW 「아랫사람이라니요? 요정 메이드 같은 거... 저보다 조금 낮은 악마 말인가요?」
		ENDSELECT
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「청소인가요. 저도 도와드릴게요」
				PRINTFORML (하아. 저도 청소를 더 잘하고 싶네요)
				PRINTFORMW 소악마는 %조사처리(CALLNAME:MASTER,"를")% 바라보며 그런 생각을 했다
			CASE 0
				PRINTFORMW 「예쁜 곳이 좋죠. 잘 알겠어요.」
			CASEELSE
				PRINTFORML 「음... 이 시간에... 이 장소를 청소했다. 음.」
				PRINTFORMW 소악마는 청소한 장소에 대한 메모를 작성하고 있다.
				;他拠点だと不自然な気もするけど、どういう掃除をしたか、それをどう活かすかのメモみたいな感じ?
		ENDSELECT
	ELSE
		PRINTFORMW 「청소인가요. 깨끗한 쪽이 마음이 편하죠」
		SIF CFLAG:MASTER:現在位置 >= 301 && CFLAG:MASTER:現在位置 <= 333
			PRINTFORMW 「응응, 잘하고 있다고 모두에게 제대로 전하지 않으면 안 되겠네요」
	ENDIF
ENDIF
RETURN 1
