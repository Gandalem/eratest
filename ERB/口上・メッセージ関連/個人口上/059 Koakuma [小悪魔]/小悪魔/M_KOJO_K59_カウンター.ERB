;-------------------------------------------------
;Modded 29 prostate milking
;-------------------------------------------------

@M_KOJO_MESSAGE_COUNTER_K59_29
SELECTCASE TCVAR:カウンター行動の派生
	CASE 0
		PRINTDATAL
			DATAFORM 「친절하게 벽에 손을 대주시겠어요, 어떠세요?」
			DATAFORM 「돌아봐 주시겠어요? 그리고 그동안 계속 벽에 손을 대고 계시면 좋겠습니다.」
			DATAFORM 「제발 벽에 손을 대 주세요. 저항해 봤자 아무 소용 없을 테니 싸우려고 하지 마세요, 알겠죠?」
		ENDDATA
	CASE 1
		IF CFLAG:PLAYER:ローターA挿入 != 0
			;あなたがアナルにローター挿入時分岐
			PRINTFORMDL 너는 로터가 네 뒤에 박힌 것을 알고 %조사처리(CALLNAME:TARGET,"가")% 음흉한 미소를 지으며 너를 바라본다.
			IF TFLAG:パール入れた人 == TARGET
				PRINTDATAL
					DATAFORM 「오호... 누가 당신에게 그런 걸 하라고 제안했는지 궁금하네... 아, 맞다! 나였지, 그렇지?」
					DATAFORM 「당신은 내가 명령한 바로 그것을 하고 있군! 잘했어, 감명받았다고!」
					DATAFORM 「후후후! 혹시 거기에 취한 건가?」
				ENDDATA
			ELSE
				PRINTDATAL
					DATAFORM 「오 마이... 누가 그런 걸 제안했는지 궁금하네... 하지만 정말 편리하긴 하군!」
					DATAFORM 「나 없이 이걸 네게 할 사람이 있을 리가 없잖아? 후후, 꽤 변태적인 사람들이겠지, 안 그래?」
					DATAFORM 「혹시 너도 이런 종류의 것을 좋아하나, 음?」
				ENDDATA
			ENDIF
			PRINTL
		ELSEIF (EQUIP:MASTER:上半身上着１ || EQUIP:MASTER:上半身上着２ || EQUIP:MASTER:ワンピース || EQUIP:MASTER:着物 || EQUIP:MASTER:外衣) && EQUIP:PLAYER:下半身下着１ == 0 && EQUIP:PLAYER:下半身下着２ == 0
			;あなたがノーパンの時分岐
			PRINTFORMDL %CALLNAME:TARGET%속옷을 입지 않은 것을 알아챈 후 그녀는 수줍게 웃으며 당신을 바라본다.
			PRINTDATAL
				DATAFORM 「오 나의 사랑스러운 아가씨... 허리 아래가 벌거벗고, 그냥 이렇게 말이야... 후후후, 너 요즘 상당히 변태적으로 변했구나.」
				DATAFORM 「후후후! 아무것도 모르는 사람들에게는 아주 절묘한 속옷 선택이군, 안 그래?」
				DATAFORM 「네가 이런 종류의 것을 좋아한다는 걸 알겠어... 후후후, 잘 메모해 두지!」
			ENDDATA
			PRINTL
		ENDIF
		CALL PRINT_DIALOGUE, @"후후후! 이제 패치풀 사마에게서 홈런 연구를 위해 신선한 정액을 짜내라는 명령이 내려왔는데, 마침 자네가 근처에 있었으니..."
	CASE 2
		IF IS_DOUTEI(PLAYER) && RAND:3
			PRINTFORML 「후후후... 당신이 처녀라는 게 너무 티 나서 거의 너무 쉬워 보여.」
			PRINTFORML 「정액을 그렇게 쉽게 내어주다니... 좀 더 소중히 여겨야지, 알잖아?」
		ELSEIF RAND:2
			PRINTFORML 「흐음? 벌써 끝내버린 건가, 이렇게 쉽게?」
			PRINTFORML 「정말 빠르네. 처녀와 다를 바 없군.」
			SIF IS_DOUTEI(PLAYER)
				PRINTFORML 「아, 맞다, 당신은 처녀였군요. 사과드립니다~」
		ELSE
			IF CFLAG:PLAYER:ローターA挿入 != 0
				PRINTFORML 「정말 빨랐어!!! 로터 씨답네, 대단한 실력이야!」
			ELSE
				PRINTFORML 「그거 빠르네!!! 어쩌면 뒷문 플레이를 더 선호하는 건가, 그런 거야?」
			ENDIF
		ENDIF
	CASE 3
		SELECTCASE BASE:PLAYER:精力
			CASE IS == 0
				;全部搾り取った
				PRINTDATAL
					DATAFORM 「다 됐어? 이건 마지막 방울일 거야. 음, 오늘은 이 정도 짜는 걸로 충분하겠지.」
					DATAFORM 「후후후, 벌써 완전히 바싹 말라버린 것 같네.」
					DATAFORM 「후후후, 단 한 방울도 없었나 보네?」
				ENDDATA
				PRINTFORML 「정말 고마워~!」
			CASE IS < MAXBASE:PLAYER:精力 /2
				;大半搾り取った
				PRINTDATAL
					DATAFORM 「음~ 꽤 상당한 양이었지. 하지만 나에게 나눠줄 여유는 아직 충분히 남아있다고 생각해, 그렇지 않아?」
					DATAFORM 「후후, 꽤 잘 나왔어. 그래도 너는 계속할 수 있는 상태잖아, 안 그래?」
					DATAFORM 「아마 할 일이 아직 많이 남았겠지...」
				ENDDATA
			CASEELSE
				;少し搾り取った
				PRINTDATAL
					DATAFORM 「분명 생기가 넘치시는군요, 정말이지. 보시죠? 이 풍성한 분출량이 거짓말을 하지 않아요!」
					DATAFORM 「후후, 요즘 꽤나 쌓여 있었던 것 같네요. 이제 끝난 것에 기쁘지 않으신가요?」
					DATAFORM 「후후! 굉장한 양이군... 정말 괜찮은 양이야.」
				ENDDATA
		ENDSELECT
ENDSELECT
