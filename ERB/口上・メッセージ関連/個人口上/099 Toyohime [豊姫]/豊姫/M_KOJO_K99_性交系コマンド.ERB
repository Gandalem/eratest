							PRINTFORMDL 시나달이 걸려온 %조사처리(CALLNAME:TARGET,"가")% 무언가를 기대하는 듯 이곳을 바라본다.
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 키스를 하려고 얼굴을 가까이 가져가자, %CALLNAME:TARGET%쪽에서 입술을 맞대어 왔다.
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「좋아해... 큭 하아, %CALLNAME:MASTER%... 큭」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 사랑을 나누는 도중, 흥분한 %조사처리(CALLNAME:MASTER,"는")% 진주 같은 땀을 흘리는 %조사처리(CALLNAME:TARGET,"의")% 목덜미에 입술을 붙였다.
						CALL HPH_PRINT,@"「흐윽, 응! 하아, 으응! 하아」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW 흔적이 남도록 격렬하고 정열적으로. %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 몸에 자신의 소유물이라는 증거를 새겼다...
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精 && !TEQUIP:MASTER:コンドーム
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아아, 응! 흥! 그렇게 꽉 조이면... 윽! 흥!」","L"
						CALL HPH_PRINT,@"「괴롭다... 윽 흐읍 아아... 윽」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"를")% 꽉 안은 채 그녀의 태내에 정액을 방출한다.
							PRINTFORMDW 두근두근하고 밀려오는 열기에 %조사처리(CALLNAME:TARGET,"는")% 숨을 떨었다.
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「응앗 하아... 더러움이, 내 안에... 윽 하아」","L"
						CALL HPH_PRINT,@"「……후우. 후훗, 기분 좋았어……? HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 흘러내리며, 황홀한 표정으로 속삭인다.
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 입가를 부드럽게 풀었다.
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「흐, 응! 그래, 거기야... 흐윽」","L"
						CALL HPH_PRINT,@"「자, 슉슉 소리 내줘... HPH 응응HPH 잘했어... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 허리를 밀어 올리고 방울 입구와 자궁구를 밀착시킨 채 사정한다.
							PRINTFORMDW 마약 같은 쾌감에 %조사처리(CALLNAME:MASTER,"가")% 떨리는 목소리로 외치자, %조사처리(CALLNAME:TARGET,"는")% 희미하게 미소 지었다.
						ENDIF
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「이 모습... 감싸여 있는 것 같아서 안심돼요... HPH」","L"
						CALL HPH_PRINT,@"「있잖아, 더 격렬하게 해도 괜찮으니까... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 이쪽으로 돌아와 격렬한 섹스를 요구한다.
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 쿵 하고 허리를 밀어 올리자, %조사처리(CALLNAME:TARGET,"는")% 환희의 신음을 터뜨렸다.
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「아, 큭! 거기, 안 돼...!」","L"
						CALL HPH_PRINT,@"「음, 으윽 흐읍, 후우... 윽」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 허리의 움직임을 멈추고, 뒤에서 %조사처리(CALLNAME:TARGET,"의")% 가슴을 애무한다.
							PRINTFORMDW 발기한 유두를 손가락으로 까닥거리며 만지자, %조사처리(CALLNAME:TARGET,"의")% 질이 간헐적으로 조여왔다.
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「응, 후후, 가슴이 신경 쓰이나...? 후후」","L"
						CALL HPH_PRINT,@"「좋아... HPH 자, 만져봐... HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 가슴을 들고, 그 크기를 과시해 온다.
						CALL HPH_PRINT,@"「하지만, 이쪽도 잊지 말아줘... HPH 응으윽 HPH 그래 HPH 밀어 올려줘... 큭 HPH」","W"
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「저기, 알겠어...? HPH」","L"
			CALL HPH_PRINT,@"「여기에 당신의 거시기 전부 박혀 있어... HPH」","L"
			IF !CFLAG:99:1998
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 자신의 아랫배를 쓰게 한다.
				PRINTFORMDW 마치 익숙하다는 듯, %조사처리(CALLNAME:MASTER,"의")% 페니스는 %조사처리(CALLNAME:TARGET,"의")% 질에 딱 맞게 들어 있었다.
			ENDIF
			;それ以外
		ELSE
			CALL HPH_PRINT,@"「괜찮아... 움직여... HPH」","L"
			CALL HPH_PRINT,@"「음... 후... 헉 HPH 하으... 음ん... 헉 HPH」","L"
			IF !CFLAG:99:1998
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 허리를 흔들 때마다 %조사처리(CALLNAME:TARGET,"의")% 가슴이 무겁게 흔들린다.
				PRINTFORMDW 손에서 떨어질 듯한 그것을 움켜쥐자, %조사처리(CALLNAME:MASTER,"는")% 조금씩 허리 움직임을 리듬감 있게 해나갔다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
