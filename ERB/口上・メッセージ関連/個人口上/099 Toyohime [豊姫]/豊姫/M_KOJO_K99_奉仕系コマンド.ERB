@M_KOJO_MESSAGE_COM_K99_80
CALL M_KOJO_MESSAGE_COM_K99_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「후훗 HPH 벌써 갈 것 같아...? HPH」","L"
						CALL HPH_PRINT,@"「괜찮아... 참지 않아도 돼... HPH」","L"
						CALL HPH_PRINT,@"「내가 전부 받아줄 테니까... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 성기를 취하는 속도가 서서히 격해져 갔다.
							PRINTFORMDL 당연히 %조사처리(CALLNAME:MASTER,"는")% 그것을 견딜 수 없었다.
							PRINTFORMDW 입을 벌리고 기다리는 %조사처리(CALLNAME:TARGET,"의")% 얼굴에 정액을 뿌리게 되었다…….
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「음... 조금 아깝기도 하지만... HPH」","L"
						CALL HPH_PRINT,@"「하지만, 당신이 그렇게 하고 싶다면…… HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW 마지막은 질 안에서. 그렇게 생각하고 있던 %조사처리(CALLNAME:TARGET,"는")% 조금 아쉬운 듯했다…….
					CASE 2
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 능숙한 자위로 %조사처리(CALLNAME:MASTER,"는")% 순식간에 사정에 이르렀다.
						CALL HPH_PRINT,@"「아……큭 굉장한 양이야……큭」","L"
						CALL HPH_PRINT,@"「게다가, 이 냄새…… 하아아…… HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 손바닥에 끈적하게 붙어있는 정액에 얼굴을 가까이 대자
							PRINTFORMDW 한계까지 심호흡하며 농후한 더러움의 냄새를 폐 속에 담았다……
						ENDIF
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 거시기 만지고 있으니까……HPH」","L"
						CALL HPH_PRINT,@"「나도... 흥분해 오고 있어... HPH」","L"
						CALL HPH_PRINT,@"「아아, 안 돼... 참을 수가 없어... 큭흐으」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 한 손으로 자극을 주면서 빈 손으로 자신을 만족시키는 %조사처리(CALLNAME:TARGET,"는")%
							PRINTFORMDW 그 광경은, 보고만 있어도 사정해버릴 것만큼 음란했다……
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「더러움이 쌓여 있는 건 여기일까...? HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 부드럽게 음낭을 주무르며 규칙적으로 성기를 쓸어 올리고 있다.
						CALL HPH_PRINT,@"「안 돼... 이렇게 쌓여버리다니... HPH」","L"
						CALL HPH_PRINT,@"「내가 시원하게 해 줄 테니까……HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「있잖아, 들리지...? HPH」","L"
						CALL HPH_PRINT,@"「니차니차 에치한 소리 하고 있네... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 성급함으로 범벅이 된 손가락을 막에 감아, 부드럽게 상하로 움직여졌다.
							PRINTFORMDW 직접적인 쾌락에 시각과 소리가 어우러지며, %조사처리(CALLNAME:MASTER,"는")% 가고 싶지 않아 참기가 간신히 가능했다……
						ENDIF
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「벌써 갈 것 같아……?」
						PRINTFORML 「괜찮아…… 마음껏 사정해 봐……♪」
						SIF !CFLAG:99:1998
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 민감한 부분을 집중적으로 쓸어 올리며 사정에 이르게 했다……
					CASE 1
						PRINTFORML 「이렇게 하면 기분 좋겠지……?」
						PRINTFORML 「사정할 것 같으면 언제든지……꺅」
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 말을 끝내기도 전에 %조사처리(CALLNAME:MASTER,"는")% 폭발적으로 정액을 뿜어낸다.
						PRINTFORML 「……후훗, 고생했어. 많이 나왔네」
						SIF !CFLAG:99:1998
							PRINTFORMDW 얼굴에 묻은 정액을 닦으면서, %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다...
					CASE 2
						PRINTFORML 「지금은 그저 기분 좋아지는 것만 생각하면 되는 거야...」
						PRINTFORML 「그러니까 참지 마... 나에게 몸을 맡겨줘...」
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 그 말에 %조사처리(CALLNAME:MASTER,"는")% 무의식적으로 사정을 참고 있었다는 것을 깨달았다.
							PRINTFORMDL 그녀가 말한 대로 온몸의 힘을 빼고 쾌락에 몸을 맡기자, 순식간에 사정에 이르고 말았다……
						ENDIF
						PRINTFORMW 「……응♪ 수고했어. 대단해」
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「자, 어깨의 힘을 빼고......」
						PRINTFORML 「내가 기분 좋게 해줄 테니까......」
						SIF !CFLAG:99:1998
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 윤활제 대신 침을 흘리더니, 천천히 자지(竿)를 만지기 시작했다...
					CASE 1
						PRINTFORML 「당신 거, 아주 뜨거워지고 있어……」
						PRINTFORML 「이런 게 내 안에 삽입되면……앗」
						PRINTFORMW 「지금 움찔했어…… 나와 섹스하는 상을 상상해 버렸니...?」
					CASE 2
						PRINTFORML 「있지... 더 보여줘...?」
						PRINTFORML 「당신의 기분 좋은 표정... ♪」
						SIF !CFLAG:99:1998
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 쾌락에 일그러진 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 응시하며 막을 다루고 있다...
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
