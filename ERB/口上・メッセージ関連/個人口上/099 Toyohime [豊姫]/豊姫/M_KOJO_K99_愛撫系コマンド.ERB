@M_KOJO_MESSAGE_COM_K99_11_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
		;母乳体質
	ELSEIF TALENT:母乳体質
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「자, 이쪽을 보고 있어... HPH」","L"
					CALL HPH_PRINT,@"「저도 먹게 해주세요... HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 입안에 모유를 머금은 채 %조사처리(CALLNAME:TARGET,"에게")% 입맞춤했다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 꾸르륵 소리를 내며, 입으로 건네진 모유를 마시고 있다……
					ENDIF
				CASE 1
					CALL HPH_PRINT,@"「후훗 HPH 맛있다? HPH」","L"
					CALL HPH_PRINT,@"「아직 더 나올 테니까, 마음껏 마셔 HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 양쪽 가슴을 우적우적 빨며, 넘쳐흐르는 모유로 목을 축였다.
						PRINTFORMDW 마음껏, 배가 부를 때까지 마셔도 %조사처리(CALLNAME:TARGET,"의")% 모유는 바닥나지 않았다.
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「아앗 그거 HPH 세다 HPH 응으읏 아앗 HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 한계까지 젖을 빨아들이고…… 쪽 하고 입을 뗀다.
						PRINTFORMDW 출렁이며 날뛰는 가슴에서 다량의 모유가 뿌려져 주변을 새하얗게 물들였다.
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아라아라, 큰 아기구나……HPH」","L"
					CALL HPH_PRINT,@"「그렇게 가슴이 원했어...? HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 달콤한 향기에 싸여 아기처럼 가슴을 빨았다.
						PRINTFORMDW 지금까지 마셨던 어떤 것보다 %조사처리(CALLNAME:TARGET,"의")% 모유는 맛있게 느껴졌다.
					ENDIF
				CASE 1
					CALL HPH_PRINT,@"「후후훗 HPH 어렸을 때 요리히메랑 숨바꼭질했던 거 생각나버렸다…… HPH」","L"
					CALL HPH_PRINT,@"「그때는 아이였으니까 나오지 않았는데, 지금은……윽 응 HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 말을 가로막듯 유두를 달콤하게 깨물고, 희미하게 남은 자국을 혀끝으로 살살 핥는다.
						PRINTFORMDW 자극에 민감한 %조사처리(CALLNAME:TARGET,"의")% 가슴에서는 침처럼 모유가 흘러내리고 있다……
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「자, 모유를 마셔라...... HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 거친 숨을 몰아쉬며 모유를 탐닉하는 %조사처리(CALLNAME:MASTER,"의")% 머리를 부드럽게 쓰다듬고 있다.
						PRINTFORMDW 이렇게 행복해도 괜찮은 걸까…….
					ENDIF
			ENDSELECT
		ENDIF
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응윽... 큭, 아아앗 큭」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 통통하게 부풀어 오른 유두를 입에 물고, 혀로 굴리며 애무한다.
						PRINTFORMDW 감도가 높아졌을 때 살짝 깨물어주자, %조사처리(CALLNAME:TARGET,"는")% 등을 뒤로 젖히며 기쁨의 신음을 흘렸다……
					ENDIF
				CASE 1
					CALL HPH_PRINT,@"「응으윽 HPH 그래 HPH 더...HPH」","L"
					CALL HPH_PRINT,@"「더, 세게, 으윽 HPH 히안! HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 더 큰 자극을 원하며 %조사처리(CALLNAME:TARGET,"의")% 가슴에 얼굴을 묻고, 그 끝의 돌출부를 허겁지겁 물어뜯는다.
						PRINTFORMDW 신음하는 %조사처리(CALLNAME:TARGET,"를")% 끌어안으면서, %조사처리(CALLNAME:MASTER,"는")% 그녀의 몸을 계속 탐했다……
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「그런... 동시에라니... HPH」","L"
					CALL HPH_PRINT,@"「너무 느껴져 버리니까......흐읍」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 너무 많이 느껴도 좋다. %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 가슴을 끌어올리고
						PRINTFORMDL 끝에 있는 두 개의 유두를 입에 넣고, 아기처럼 빨아먹었다……
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후훗 HPH 응석받이였구나... HPH」","L"
					CALL HPH_PRINT,@"「더……좀 더, 응석 부려도 돼...? HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL ……왠지 어린아이 취급을 받는 것 같아 조금 부끄러워진 %조사처리(CALLNAME:MASTER,"는")%
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 가슴에 얼굴을 묻고, 격렬하게 유두를 빨아 그것을 모면했다……
					ENDIF
				CASE 1
					SIF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 머리를 끌어안고 자신의 풍만한 가슴 쪽으로 밀착했다.
					CALL HPH_PRINT,@"「마음껏 마셔도 괜찮아...? HPH」","L"
					CALL HPH_PRINT,@"「나의 가슴은, 지금 이 순간만큼은 당신의 것이니까……HPH」","W"
				CASE 2
					CALL HPH_PRINT,@"「좋아 좋아... 쭈욱 마셔줘... HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 모성(母性)의 상징에 얼굴을 묻고 아기처럼 유두를 빨아들이는 %CALLNAME:MASTER%
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 자기 아이인 양 %조사처리(CALLNAME:MASTER,"의")% 머리를 부드럽게 쓰다듬고 있다……
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
