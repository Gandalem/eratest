; Modular ERB: 個人口上/099 Toyohime [豊姫]/豊姫/M_KOJO_K99_愛撫系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;愛撫系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;0,愛撫
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_0
RETURN 0

@M_KOJO_MESSAGE_COM_K99_0
CALL M_KOJO_MESSAGE_COM_K99_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中かつあなたが射精したと同時に絶頂
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:MASTER:射精 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER) && (NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ｍ絶頂)
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「흐읍, 하아 HPH 이대로……읏 HPH」","L"
					CALL HPH_PRINT,@"「아앗 흐으응! 이대로 사정해버릴 거야... 큭!」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 초라하게 자손을 원하며 찾아오는 %조사처리(CALLNAME:TARGET,"의")% 허리를 붙잡고 몇 번이고 몰아붙이면서
						PRINTFORMDL 비어있는 손으로 한심하게 상하로 흔들리는 %조사처리(CALLNAME:TARGET,"의")% 가슴을 움켜쥐었다.
					ENDIF
					CALL HPH_PRINT,@"「흐응! 큭, 으윽! 흐음! 흐음! 흐음!」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW 마지막에 밑바닥까지 페니스를 밀어 넣고 사정하자, %CALLNAME:TARGET%도 등을 뒤로 젖히며 동시에 절정에 이르렀다.
				CASE 1
					CALL HPH_PRINT,@"「응, 아앗 하프 좋으세요! 하프 %CALLNAME:MASTER%! 하프」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 애무하며 격렬한 피스톤으로%조사처리(CALLNAME:TARGET,"의")%\@ TEQUIP:50 == PLAYER ? 질 내 # 장내 \@을 휘저으면서
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 몇 번째 절정에 도달한 %조사처리(CALLNAME:TARGET,"의")% 귓가에서 %조사처리(CALLNAME:MASTER,"는")% 사정을 예고했다.
					ENDIF
					CALL HPH_PRINT,@"「흐윽, 응! 쏟아줘... 흐읍」","L"
					CALL HPH_PRINT,@"「당신의 정액, 나에게 주셔도 되나요... 큭흐」","W"
				CASE 2
					CALL HPH_PRINT,@"「흐윽! 하아... 아아, 저 이제... 흐윽!」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 머리를 휘날리며 신음하는 %조사처리(CALLNAME:TARGET,"의")% 몸을 애무하면서
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 허리를 움직이며 그녀의 약점을 집요하게 자극한다.
					ENDIF
					CALL HPH_PRINT,@"「이제, 안 돼, 에엣흐읍 파아, 아, 아아---큿! 흐읍 흐읍 흐읍」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 그리고 사정 직전, %조사처리(CALLNAME:MASTER,"가")% 깊고 근본까지 페니스를 밀어넣자,
						PRINTFORMDW %CALLNAME:TARGET%도 마치 산소 부족으로 신음하듯 삽입된 성기를 조이면서 깊은 절정에 도달했다……
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응, 흐으읍 거기, 좋아......!」","L"
					CALL HPH_PRINT,@"「더 만져줘... 박아줘... 큭흐윽」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 약한 곳을 집요하게 자극하면서 %조사처리(CALLNAME:MASTER,"는")% 사정에 이르기 위해 허리 움직임을 가속시켜 나간다...
					CALL HPH_PRINT,@"「아앙! 하프 저도, 이제……윽! 하프」","L"
					CALL HPH_PRINT,@"「안 돼……윽 HPH 아, 아앗 HPH 아아앗 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……함께……HPH」","L"
					CALL HPH_PRINT,@"「같이 가요...?」 HPH","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 동시 절정을 원하며 %조사처리(CALLNAME:TARGET,"를")% 껴안고,
						PRINTFORMDL 그녀의 민감한 부분을 애무하면서 격렬하게 허리를 박아넣었다……
					ENDIF
					CALL HPH_PRINT,@"「아, 아앗 후후 흥, 큭 후후 ～～～윽 후후」","W"
				CASE 2
					CALL HPH_PRINT,@"「당신의 거시기, 안에서 커져서... HPH」","L"
					CALL HPH_PRINT,@"「벌써 사정할 것 같아...? HPH 아, 응앗HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 이대로 사정해도 좋지만, 어차피 함께 기분 좋아지는 게 옳다
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")%%조사처리(CALLNAME:TARGET,"의")% 몸을 애무하면서, 서서히 허리 움직임을 빨라갔다……
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「……응! 흐으, 아니야…… 좀 더 아래로……흐으」","L"
					CALL HPH_PRINT,@"「응! HPH 거긴 너무 과해... HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%%조사처리(CALLNAME:TARGET,"와")% 장난치면서
						PRINTFORMDW 그녀의 몸을 정성껏, 시간을 들여 애무했다...
					ENDIF
				CASE 1
					CALL HPH_PRINT,@"「아... 응...윽 하프 아... 아아... 윽 하프」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 일부러 %조사처리(CALLNAME:TARGET,"의")% 민감한 곳에는 손을 대지 않고 몸을 애무해 나간다.
						PRINTFORMDL 목에 키스도 해보고, 흐르는 땀을 혀로 핥아보기도 한다...
						PRINTFORMDL 은밀한 곳을 핥는 척하며 허벅지에 혀를 기어 올라가 보거나...
						PRINTFORMDL 그리고 그녀가 애태울 지경이 되기 직전에 유두를 부드럽게 깨물어 주기도 하고
						PRINTFORMDW 여유를 가지고 시간을 들여, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 몸을 풀어주었다...
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「당신이 만진 곳이 점점 뜨거워져서... HPH」","L"
					CALL HPH_PRINT,@"「몸이, 저릿해서... 견딜 수가 없어... 큭흐」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 매달리면서 강한 쾌락을 원하고 있다.
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 자극에 민감한 부분을 손가락으로 애무해주자
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 기쁨의 소리를 내며 음란하게 몸을 뒤틀었다……
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응...윽 후후 간지러워...후후」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDL 목덜미부터 쇄골, 그리고 가슴으로 키스하는 위치를 낮추며 %조사처리(CALLNAME:TARGET,"의")% 몸을 애무한다.
					CALL HPH_PRINT,@"「아앗 후헵, 응, 아아……후헵 거기, 좋아……후헵」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW 민감한 부위에 손가락이 닿자, %조사처리(CALLNAME:TARGET,"의")% 몸은 순순히 반응을 보였다.
				CASE 1
					CALL HPH_PRINT,@"「흐읍, 아앗 후후 거기, 약하니까...」","L"
					CALL HPH_PRINT,@"「부드럽게 만져줘... 그래, 잘한다... 큭」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 자신의 약한 부분을 모두 드러내고, %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡기고 있다...
				CASE 2
					CALL HPH_PRINT,@"「제대로 기분 좋게 하고 있네... HPH」","L"
					CALL HPH_PRINT,@"「그대로, 계속해 주세요... HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 입술을 맞추면서, 그녀의 풍만한 가슴을 주무르듯이 쓰다듬었다.
						PRINTFORMDW 마시멜로처럼 부드럽다고. 언제까지나 만지고 싶다고 %조사처리(CALLNAME:MASTER,"에게")% 느끼게 했다.
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;1,クンニ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_1
RETURN 0

@M_KOJO_MESSAGE_COM_K99_1
CALL M_KOJO_MESSAGE_COM_K99_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			;恋慕
			IF TALENT:恋慕
				CALL HPH_PRINT,@"「하아... 하아... 흐읍 이렇게 많이...」","L"
				CALL HPH_PRINT,@"「자... 깨끗하게 해줘... HPH 제대로 안쪽도...? HPH」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 혀를 사용해 깨끗하게 해달라고 요구하는 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에 달려들자,
					PRINTFORMDW 질 내에 남아있는 정액과 애액의 혼합물을 혀로 끄집어내 입안에 고인 것을 소리 내어 삼켰다.
				ENDIF
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「깨끗하게 만든다고……아, 잠시만……핫!후!」","L"
				CALL HPH_PRINT,@"「응, 응으음! 부끄러워......!」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳에 혀를 가져가면서
					PRINTFORMDW 질 입구에서 흘러나오는 정액을 세심하게 핥아 올렸다……
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아아... 응... 큭 아아... 큭」","L"
					CALL HPH_PRINT,@"「당신에게 함부로 해도 되는 거야... 정말, 좋아...! HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 끈적한 혀놀림으로 애무하고 넘치는 꿀을 질 내에 밀어 넣는다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 기분 좋은지, 허리를 들어 올려 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 젖은 은밀한 곳을 대고 있다……
					ENDIF
				CASE 1
					CALL HPH_PRINT,@"「아......하아......! 후,우......!」","L"
					CALL HPH_PRINT,@"「그런, 소리 내면……! 큭! 팬!」","L"
					CALL HPH_PRINT,@"「안 돼 HPH 거기, 느끼는 곳……HPH 으응HPH」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL 민감한 클리토리스를 빨아들여, %조사처리(CALLNAME:TARGET,"는")% 허리를 들썩이며 신음하고 있다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그런 모습을 눈에 새기며, %조사처리(CALLNAME:TARGET,"에게")% 봉사를 계속했다……
					ENDIF
				CASE 2
					IF !CFLAG:99:1998
						PRINTFORMDL 잘 익은 암구는 끊임없이 애액을 흘리며 수컷을 유혹하고 있다.
						PRINTFORMDL 그것에 이끌리듯 %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳을 탐했다.
						PRINTFORMDL 주르륵하며 음란한 소리를 내며 달콤한 꿀을 빨아들였다.
					ENDIF
					CALL HPH_PRINT,@"「음... 후우...윽 HPH 내 거, 맛있는...? HPH」","L"
					CALL HPH_PRINT,@"「많이 빨아줘... 기분 좋게 해줘... HPH 아HPH」","W"
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아큭 하, 하아아……큭」","L"
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 혀를 사용해 봉사하고 있자, %조사처리(CALLNAME:TARGET,"가")% 허벅지로 얼굴을 꽉 감싸 안았다.
						PRINTFORMDL 조금 숨이 막히지만, %조사처리(CALLNAME:MASTER,"는")% 그 상태로 계속 봉사를 이어갔다……
					ENDIF
					CALL HPH_PRINT,@"「기분, 좋아......흐읍 하아......응으......흐읍」","W"
				CASE 1
					SIF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳을 손가락으로 벌리자, 공기 중에 노출되어 떨리는 질 입구에 천천히 혀를 밀어 넣었다.
					CALL HPH_PRINT,@"「음...큭 HPH 내 안에... HPH」","L"
					CALL HPH_PRINT,@"「당신의 혀, 삽입이라니...윽 HPH 앗, 아아앗 HPH」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW 한 번 더 민감한 질 속을 혀로 파고드는 쾌락에, %조사처리(CALLNAME:TARGET,"는")% 허리를 들고 신음하고 있다…….
				CASE 2
					CALL HPH_PRINT,@"「많이 적셔줘... HPH」","L"
					CALL HPH_PRINT,@"「그렇게 하는 편이, 분명 당신도 기분 좋을 테니까……HPH」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 가랑이에 얼굴을 묻고 개처럼 은밀한 곳을 핥으며 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬고 있다……
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
