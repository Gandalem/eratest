		;Ｖ感覚とＡ感覚が５以上
		IF ABL:Ｖ感覚 > 4 && ABL:Ａ感覚 > 4
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「모두에게는……응! HPH 비밀이야……? HPH」","L"
				CALL HPH_PRINT,@"「내가... 아응! HPH 양쪽 구멍을 다 쓰는 변태라는 거야... 큭!」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL 천천히 바이브를 빼내고, 그리고 다시 깊숙한 곳까지 밀어 넣는다.
					PRINTFORMDW 감촉을 확인하듯... %조사처리(CALLNAME:TARGET,"는")% 완전히 쾌락의 노예가 되어 있었다
				ENDIF
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「더 가까이 보고 싶지...? HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %조사처리(CALLNAME:MASTER,"를")% 덮치고 얼굴 위에 올라탄다.
				CALL HPH_PRINT,@"「어때...? HPH 보여...? HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 바이브를 움직인다. 뚝뚝, %조사처리(CALLNAME:MASTER,"의")% 얼굴에 애액이 떨어졌다
			ENDIF
			;それ以外
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「――어떤……응! HPH 느낌이라고……? HPH」","L"
				CALL HPH_PRINT,@"「당신도... 아하아... 큭 HPH 해보면 알게 될 거야... HPH」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 허리를 들어 바이브를 물고 두 개의 구멍을 보여준다.
					PRINTFORMDW 흥미가 없다고 하면 거짓말이겠지만, 스스로 시도하는 것은 그만두도록 하자...
				ENDIF
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「하아……크으……윽 HPH 음후, 응……윽 HPH」","L"
				CALL HPH_PRINT,@"「괴롭고, 기분 좋은 것이 함께 오네... 조금 괜찮을지도... 윽 HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 천천히, 번갈아 바이브를 넣었다 빼고 있다...
			ENDIF
		ENDIF
		;バイブ
	ELSEIF TEQUIP:バイブ
		;Ｖ感覚５以上
		IF ABL:Ｖ感覚 > 4
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「아, 조금만 더...윽 하으」","L"
				CALL HPH_PRINT,@"「한 번만 더 가버리면 그만둘 테니까... 윽 HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 그만두라고 말해도, %조사처리(CALLNAME:TARGET,"는")% 바이브를 움직이는 손을 멈추지 않는다...
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「나중에 당신에게도 삽입하게 해 줄 테니까... 큭흐으」","L"
				CALL HPH_PRINT,@"「지금은…… 보고 있을 뿐이야…… 큭 흐응」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW 기분 좋은 곳에 스쳤는지, %조사처리(CALLNAME:TARGET,"의")% 허리가 움찔 떨렸다...
			ENDIF
			;それ以外
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「이거... 길이도 단단함도 딱 좋아서... 큭흐읍」","L"
				CALL HPH_PRINT,@"「하아......읏 HPH 좋아해버리잖아......읏 HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 구츄구츄하고 바이브를 격렬하게 앞뒤로 움직이고 있다......
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「아, 후후――응, 기분 좋아 보이잖아...? 후후」","L"
				CALL HPH_PRINT,@"「후훗 HPH라면 당신도 넣어보는 건 어때...? HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 천천히 바이브를 빼낸다. 그리고 움찔거리는 질 입구를 %조사처리(CALLNAME:MASTER,"에게")% 보여주었다.
			ENDIF
		ENDIF
		;アナルバイブ
	ELSEIF TEQUIP:アナルバイブ
		;Ａ感覚５以上
		IF ABL:Ａ感覚 > 4
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「저기, 이상한 소리가 날지도 모르겠지만……훗후」","L"
				CALL HPH_PRINT,@"「음후... 후우... 윽 HPH 하앗 HPH 음응 HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하고는, 아무 망설임 없이 바이브를 넣고 빼기 시작했다...
				;それ以外
			ELSE
				SIF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 힘을 준다. 짜내진 바이브가 퐁 하고 소리를 내며 빠져나갔다
				CALL HPH_PRINT,@"「응응! 하으... 잠깐만, 기다려줘... 다시 넣을 테니까... 윽! 하으...」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 바이브를 잡고, 다시 이완된 항문에 대고 밀어 넣었다...
			ENDIF
			;それ以外
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「솔직히…… 별로 기분 좋진 않지만……윽 HPH」","L"
				CALL HPH_PRINT,@"「하지만... 조금, 버릇이 되어 온 것 같아... 큭흐」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 항문의 쾌락에 눈을 뜨고 있는 것 같다...
				;それ以外
			ELSE
				PRINTFORML 「당신이 말하니까 하고 있지만……윽」
				PRINTFORML 「이거……응쿠……꽤 힘든 거잖아……윽」
				IF !CFLAG:99:1998
					PRINTFORMDL 항문에 이물감이 느껴져 %조사처리(CALLNAME:TARGET,"는")% 얼굴을 찡그리고 있다.
					PRINTFORMDW 바이브를 움직이는 손도, 어딘가 매우 어색하다.
				ENDIF
			ENDIF
		ENDIF
		;玩具無し
	ELSE
		;ＶまたはＡに挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「당신은... 응! 움직이지 않아도 괜찮아...」","L"
				CALL HPH_PRINT,@"「멋대로……. 흠! HPH 사용하게 해줘……윽 HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 바이브 대신 삼아 자위에 빠져있다...
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「그럼... 당신의 거시기, 사용하게 해 줄게... HPH」","L"
				CALL HPH_PRINT,@"「음……음……큭! 하프하프 역시, 진짜는 다르다……큭!」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 스스로의 몸을 애무하면서 삽입된 성기의 감촉을 즐기고 있다...
			ENDIF
			;それ以外
		ELSE
			;自慰中毒３以上
			IF ABL:自慰中毒 > 2
				CALL HPH_PRINT,@"「당신의 거시기... 더 잘 보여줘... HPH」","L"
				CALL HPH_PRINT,@"「그걸 거름 삼아... 나도 기분 좋아지니까... 큭흐」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕이고, %조사처리(CALLNAME:TARGET,"에게")% 보여주듯이 성기를 손으로 만졌다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 넋을 잃은 얼굴로, 한 치의 흐트러짐 없이 은밀한 곳을 손가락으로 문지르고 있다……
				ENDIF
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「봐... 더 잘 봐... HPH」","L"
				CALL HPH_PRINT,@"「내가... 당신을 오락거리로 자위하고 있는 곳... HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 자랑하듯 자신의 몸을 달래고 있다...
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
