;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;基本セット
	;開始
	IF TEQUIP:新妻プレイ
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이건 그저 놀이지만, 진정한 아내가 되어줘도 괜찮아?」
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 말하는 게 사실인지 농담인지 모르겠다.
						PRINTFORMDW 하지만 결혼을 청하면 순조롭게 일이 진행될 것 같은 예감이 든다……
					ENDIF
				CASE 1
					PRINTFORML 「졸렬한 새아내이지만, 잘 부탁드립니다」
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 세 손가락을 펴고 고개를 숙인다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"와")% 결혼하면, 매일 이렇게 마중 나와 줄까
					ENDIF
				CASE 2
					PRINTFORML 「당신, 어서 오세요」
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 그렇게 말하며 달려와 안겼다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 일에서 돌아온 듯한 연기를 하며 「다녀왔어」라고 %조사처리(CALLNAME:TARGET,"를")% 쓰다듬었다.
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「밥 먹을래? 목욕할래?」
					PRINTFORML 「아니면... 뭐랄까~」
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 새신부 플레이를 즐기고 있다...
				CASE 1
					PRINTFORML 「이 에이프런, 프릴 달려서 귀엽네」
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 에이프런을 입혔다.
						PRINTFORMDW 천의 면적이 작아서인지, 에이프런에서 가슴이 삐져나올 것 같다…….
					ENDIF
				CASE 2
					PRINTFORML 「당신을 뭐라고 불러야 할까요?」
					PRINTFORML 「이름으로요? 당신? 역시 남편분?」
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 꽤 들떠 있네...
			ENDSELECT
		ENDIF
		;終了
	ELSE
		PRINTFORML 「실가에 돌아가겠습니다」
		IF !CFLAG:99:1998
			PRINTFORMDL 그렇게 말하며 에이프런을 벗어 접는 %CALLNAME:TARGET%
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 새 아내에서 전 부인으로 클래스 체인지했다...
		ENDIF
	ENDIF
ENDIF
RETURN 1
