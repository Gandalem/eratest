;=================================================
;特殊コマンド
;=================================================
;-------------------------------------------------
;180,ローション
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_180
RETURN 0

@M_KOJO_MESSAGE_COM_K99_180
CALL M_KOJO_MESSAGE_COM_K99_180_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「그런 입구뿐이라, 애틋하네……HPH」","L"
				CALL HPH_PRINT,@"「칠해줘... 안쪽도... HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 음순을 가른다. 그곳은 이미 로션을 바를 필요가 없을 정도로 축축하게 젖어 있었다
			CASE 1
				CALL HPH_PRINT,@"「후훗, HPH 해 드릴까요...? HPH」","L"
				CALL HPH_PRINT,@"「이렇게…… 목욕탕에서 하는 것처럼…… HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 안기자, 로션이 발린 몸을 비비며 달려들었다...
			CASE 2
				CALL HPH_PRINT,@"「미끌미끌, 습관이 되어버린지도 몰라……후후」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 편안한 모습으로 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡기고 있다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 병 하나 전체를 사용해서, %조사처리(CALLNAME:TARGET,"의")% 전신에 골고루 로션을 발랐다.
				ENDIF
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응♪ 미끌미끌하게 되어버렸어……♪」
				IF !CFLAG:99:1998
					PRINTFORMDL 로션을 바른 %조사처리(CALLNAME:TARGET,"의")% 피부가 요염하게 젖어 빛난다.
					PRINTFORMDW 도발적인 광경에, %조사처리(CALLNAME:MASTER,"는")% 당장이라도 %조사처리(CALLNAME:TARGET,"를")% 안고 싶다는 충동에 사로잡혔다.
				ENDIF
			CASE 1
				PRINTFORML 「나뿐만이 아니라, 당신 것도……♪」
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 손바닥에 로션을 듬뿍 떨어뜨리고,
					PRINTFORMDW 즐거운 듯 %조사처리(CALLNAME:MASTER,"의")% 몸에 로션을 발랐다...
				ENDIF
			CASE 2
				PRINTFORML 「있잖아... %CALLNAME:MASTER%...」
				PRINTFORML 「여기도, 칠해줄래...?」
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 다리를 벌린다. %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕이고, 그 음란한 비밀에 잔뜩 로션을 발랐다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;181,媚薬,
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_181
RETURN 0

@M_KOJO_MESSAGE_COM_K99_181
CALL M_KOJO_MESSAGE_COM_K99_181_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_181_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「봐줘... 여기, 이렇게나... HPH」","L"
				CALL HPH_PRINT,@"「있잖아…… 약 때문이라고만 생각하는 거야...? HPH」","L"
				SIF !CFLAG:99:1998
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 다리를 벌리고 %조사처리(CALLNAME:MASTER,"를")% 유혹하고 있다……
			CASE 1
				CALL HPH_PRINT,@"「먹게 해 줄게요... HPH 음... HPH」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL 미약을 입에 머금은 %조사처리(CALLNAME:TARGET,"가")% 키스해 온다.
					PRINTFORMDW 천천히 흘러들어 오는 그것을, %조사처리(CALLNAME:MASTER,"는")% 순순히 삼켰다.
				ENDIF
			CASE 2
				CALL HPH_PRINT,@"「효과가 나타날 때까지, 이렇게 해줘... HPH」","L"
				IF !CFLAG:99:1998
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %조사처리(CALLNAME:MASTER,"를")% 끌어안고, 등 뒤로 손을 감쌌다.
					PRINTFORMDW 점점 빨라지는 그녀의 고동을, %조사처리(CALLNAME:MASTER,"는")% 조용히 느끼고 있었다.
				ENDIF
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「괜찮아? 이런 걸 먹이다니......」
				IF !CFLAG:99:1998
					PRINTFORMDL 그건 무슨... 이라고 말하려던 %조사처리(CALLNAME:MASTER,"를")% %조사처리(CALLNAME:TARGET,"가")% 덮쳤다.
					PRINTFORMDW 그리고 입술을 빼앗으며, 「이런 거구나」라고 귓가에 속삭였다.
				ENDIF
			CASE 1
				PRINTFORML 「하아... 조금, 효과가 나타나기 시작한지도...」
				IF !CFLAG:99:1998
					PRINTFORMDL 홍조가 비친 %조사처리(CALLNAME:TARGET,"가")% %조사처리(CALLNAME:MASTER,"에게")% 기대어 다가온다.
					PRINTFORMDW 모지... 하고 %조사처리(CALLNAME:TARGET,"가")% 허벅지를 스치자, 발정의 축축한 소리가 다리 사이에서 미세하게 울렸다.
				ENDIF
			CASE 2
				PRINTFORML 「음... 기대해도 괜찮은 거야...?」
				IF !CFLAG:99:1998
					PRINTFORMDL 이런 약을 먹였으니라고, %조사처리(CALLNAME:TARGET,"가")% 그렇게 말하는 것처럼 바라본다.
					PRINTFORMDW 어딘가 초점이 없는 눈동자는, %조사처리(CALLNAME:TARGET,"가")% 완전히 발정하고 있음을 나타낸다……
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
