;==================================================
;188,シャワー
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_188
RETURN 0

@M_KOJO_MESSAGE_COM_K99_188
CALL M_KOJO_MESSAGE_COM_K99_188_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_188_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:シャワー
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「그거라♪ 후후훗♪」
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %조사처리(CALLNAME:MASTER,"에게")% 샤워를 시키며 농담을 건다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 장난스러운 말투로 %조사처리(CALLNAME:TARGET,"를")% 꾸짖었다.
					ENDIF
				CASE 1
					PRINTFORML 「이걸로 큰 소리가 나도 안심이야」
					CALL HPH_PRINT,@"「――예를 들자면? 예를 들어……. 아, HPH」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW 꾸욱. 하고 손가락을 삽입하자, %조사처리(CALLNAME:TARGET,"는")% 기분 좋게 소리를 질렀다.
				CASE 2
					PRINTFORML 「그럴 바에, 몸이라도 좀 씻을래?」
					CALL HPH_PRINT,@"「물론, 당신이 원한다면……HPH」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 안기자, 풍만한 가슴을 밀착시켰다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「당신도 같이 몸을 담그죠♪」
					IF !CFLAG:99:1998
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 손을 이끌려 %CALLNAME:MASTER%도 함께 샤워를 한다.
						PRINTFORMDW 따뜻하고, 매우 기분이 좋다.
					ENDIF
				CASE 1
					PRINTFORML 「자, 당신도」
					PRINTFORML 「따뜻하고 기분 좋잖아?」
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕이고, %CALLNAME:TARGET%옆에 나란히 서서 함께 샤워했다.
				CASE 2
					PRINTFORML 「이렇게 하면, 누구에게도 들리지 않겠네.」
					IF !CFLAG:99:1998
						PRINTFORMDL 피부가 부딪히는 소리도, 휘젓는 애액의 소리도, 전부 샤워가 지워준다.
						PRINTFORMDW 그래서 상관없이 들어오는 자들은 있지만…….
					ENDIF
			ENDSELECT
		ENDIF
		;終了
	ELSE
		PRINTFORML 「음... 이제 됐어?」
		IF !CFLAG:99:1998
			PRINTFORMDL 톡 하고 샤워기의 마개가 닫히는 소리가 욕실에 울렸다.
			PRINTFORMDW 젖은 %조사처리(CALLNAME:TARGET,"의")% 머리에서 물이 똑똑하고 떨어지고 있다…….
		ENDIF
	ENDIF
ENDIF
RETURN 1
