;==================================================
;1,シックスナイン
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K99_1
RETURN 0

@M_KOJO_MESSAGE_SCOM_K99_1
CALL M_KOJO_MESSAGE_SCOM_K99_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K99_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「흐으윽... 흐윽 흐으읍... 크흡... 큭」","L"
						CALL HPH_PRINT,@"「응, 응... 키스... 음프... 큭」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 혀를 능숙하게 사용해 귀두를 핥아대고, %조사처리(CALLNAME:MASTER,"가")% 싱숭생숭해하면 깊숙이 자루를 물어넣는다.
							PRINTFORMDW 그저 몸을 맡기는 것밖에 할 수 없다. %조사처리(CALLNAME:MASTER,"는")% 봉사하는 것도 잊고, 그 쾌락에 입가에서 침을 흘렸다.
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「음후... 후우... 큭, 흡... 주푸... 큭」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDL 얼굴을 흔들며 페니스를 빨고, 입안에 고인 선행 사정을 삼키며 그 맛에 질 입구를 움찔거리게 한다.
						CALL HPH_PRINT,@"「흐읍...응...핫하아...음...핫하아」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW 장사꾼처럼, %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해주는 데 전력을 다하고 있다……
					CASE 2
						CALL HPH_PRINT,@"「츄... 츄푸... 윽 HPH 응루... 레로... 윽 HPH」","L"
						CALL HPH_PRINT,@"「함께... 응! 기분 좋아지자...!」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 때 격렬하게, 때 조절하면서...
							PRINTFORMDW 두 사람은 동시에 절정에 이르렀기에, 서로의 성기를 핥았다...
						ENDIF
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응, 흐읍... 후우... 큭」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 물러진 단내 나는 구멍에 혀를 밀어 넣어, 질퍽한 점막을 쓸어 올렸다.
							PRINTFORMDW 다음으로 입을 대고 「줄」 하고 빨아들이자, %조사처리(CALLNAME:TARGET,"는")% 작게 허리를 들었다.
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「그럼, 시작할게……HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 얼굴 위로 올라가 맛있게 페니스를 빨기 시작했다.
							PRINTFORMDW 분명 천박한 표정을 짓고 있을 것이다. 나에게 보이지 않는 것이 조금 아쉬웠다.
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「응앗! 하아, 그래……윽」","L"
						CALL HPH_PRINT,@"「더 혀로, 맛봐줘... 윽 HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 서로의 성기를 탐하고, 넘쳐흐르는 꿀로 목을 적셨다…….
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「쿠푸윽... 쿠후풉... 큭!」","L"
						CALL HPH_PRINT,@"「음흡... 후우... 음크... 큭흐윽」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 눈을 감고 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥는 것에 집중하고 있다.
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 몸의 힘을 빼자 사정에 의식을 집중시켰다.
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「후우……츄르……윽 HPH 응……윽 HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 열심으로 페니스를 빨고 있는 %조사처리(CALLNAME:TARGET,"에게")% 사정을 예고한다.
							PRINTFORMDW 그러자 %조사처리(CALLNAME:TARGET,"는")% 입을 떼지 않고 더욱 깊은 곳까지 육봉을 삼켰다.
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「크윽, 쪽... 갈 것 같아...? HPH」","L"
						CALL HPH_PRINT,@"「좋아, 이대로……. 응, 쪽핥쪽핥」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 페니스를 입에 문 채 가늘게 얼굴을 흔드는 %CALLNAME:TARGET%
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 사정하자 %조사처리(CALLNAME:TARGET,"는")% 움직임을 멈추고, 토해지는 정액을 입안에서 받아냈다
						ENDIF
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「자, 말이 멈췄잖아...? HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에 올라탄 %조사처리(CALLNAME:TARGET,"가")%, 허리를 움직여 은밀한 곳을 입에 비비고 온다…….
						CALL HPH_PRINT,@"「서로 기분 좋게……. 응 HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「후훗, 여기가 약점이었군…… HPH」","L"
						CALL HPH_PRINT,@"「흐으윽... 츄... 큭, 흐르륵... 큭」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 원을 그리듯이 혀를 움직여 귀두 중심을 몰아붙이는 %CALLNAME:TARGET%
							PRINTFORMDW %CALLNAME:MASTER%도 지지 않고 혀를 움직였지만, 주도권은 완전히 %조사처리(CALLNAME:TARGET,"에게")% 잡혀 있었다
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「잘했어... HPH지만, 아직 멀었어... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 「지켜보라」라고 말하듯 자리에 앉아, %조사처리(CALLNAME:MASTER,"의")% 봉사를 멈추게 한다.
							PRINTFORMDL 다음으로 %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 페니스를 밑동까지 삼키고……
						ENDIF
						CALL HPH_PRINT,@"「음……음……윽 HPH 음푸……구포……윽 HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW 목을 졸 듯, 천천히 얼굴을 흔들기 시작했다...
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
