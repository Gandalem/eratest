					CALL HPH_PRINT,@"「다른 애들에게는, 이런 거 하면 안 돼...? HPH」","W"
			ENDSELECT
			;思慕
		ELSEIF TALENT:思慕
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% \@ PREVCOM == 305 ? 무릎에 누운 채 # 뒤에서 \@%조사처리(CALLNAME:TARGET,"의")% 엉덩이로 손을 뻗었다
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"에게")% 받는 성희롱을 즐기고 있는 듯하다……
