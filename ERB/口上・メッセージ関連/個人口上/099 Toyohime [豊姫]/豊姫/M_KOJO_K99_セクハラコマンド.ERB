;ABL:Ｂ感覚(2未満=性的には感じてない 5未満=多少感じてる 5以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;乳のサイズでも変わる場合があるので、地の文EVENT_MESSAGE_COM_セクハラ.ERB参照
;==================================================

@M_KOJO_SUCCESS_COM_K99_313
;成否判定
;TFLAG:192(-1＝強制失敗
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_313
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K99_313
CALL M_KOJO_MESSAGE_COM_K99_313_1
RETURN RESULT
;フラグがONの場合コマンド実行による反感を減少

@M_KOJO_EXTRASOURCE_COM_K99_313
IF CFLAG:99:1000 == 1
	SOURCE:反感 = SOURCE:反感 / 5
ENDIF

@M_KOJO_MESSAGE_COM_K99_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:時間停止
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 풍만한 가슴을 주물러댔다
		PRINTFORMDW 시간을 멈추고 있는 %조사처리(CALLNAME:TARGET,"는")% 무저항 상태로 %OPPAI_DESCRIPTION(TARGET)%를 계속 만지고 있다……
		;睡眠中
	ELSEIF CFLAG:睡眠
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 잠든 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)%를 %SHOW_TOP(TARGET)% 위에서 천천히 주무르기 시작했다.
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 뺨을 상기시키고%CALLNAME:MASTER%되는 대로 되어가고 있다
		;押し倒され
	ELSEIF CFLAG:うふふ == 2
		;どのカウンターに対して実行したかで分岐
		SELECTCASE TCVAR:20
			;谷間を見せる
			CASE 27
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「더 봐줘... 만져도 돼... HPH」","L"
						CALL HPH_PRINT,@"「자…… 이런 식으로…… HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 손을 잡고, 자신의 풍만한 가슴으로 부드럽게 이끌었다.
							PRINTFORMDW 손바닥 너머로 전해지는 부드러움과 온기를 느끼며, %조사처리(CALLNAME:MASTER,"는")% 그녀의 가슴을 꼼꼼하게 주무르기 시작했다……
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「크흡... 만지고 싶은 거야...? HPH」","L"
						CALL HPH_PRINT,@"「괜찮아... 자... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 가볍게 가슴을 들어 올리자, 원래도 큰 그녀의 가슴이 더욱 크게 보였다.
							PRINTFORMDW 통통하게 부풀어 오른 끝을 손가락으로 집자, %조사처리(CALLNAME:TARGET,"는")% 움찔 몸을 떨었다…….
						ENDIF
					CASE 2
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 골짜기에 손을 넣어, 골짜기를 문지르듯 애무했다.
						CALL HPH_PRINT,@"「있잖아... 당신의 성기... HPH」","L"
						CALL HPH_PRINT,@"「이렇게, 기분 좋게 해 드릴까요...? HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 가슴을 치켜들자, %조사처리(CALLNAME:MASTER,"의")% 손을 페니스로 삼아 파이즈리 흉내를 내기 시작했다……
				ENDSELECT
				;胸を揉ませる
			CASE 33
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「나의 고동... 당신에게 전해질까...? HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 톡, 톡, 손끝으로 전해져 오는 심장 박동
							PRINTFORMDL 이런 행위를 하고 있는데도, 매우 차분했다
						ENDIF
						CALL HPH_PRINT,@"「자아... 나를 기분 좋게 해줘... HPH」","W"
					CASE 1
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 지지 않고 손을 움직여, %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)%를 주무르기 시작했다…….
						CALL HPH_PRINT,@"「후훗... 서두를 필요 없어... HPH」","L"
						CALL HPH_PRINT,@"「천천히, 시간을 들여 즐겨줘... HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「잘한다……흐응 아, 응……읏 흐응」","L"
						CALL HPH_PRINT,@"「더욱... 세게 해도 좋아... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 손바닥에서 전해지는 심장 박동이 조금씩 빨라진다.
							PRINTFORMDW %CALLNAME:TARGET%도 흥분하고 있다. 그렇게 생각하니 %조사처리(CALLNAME:MASTER,"는")% 기쁜 마음이 되었다.
						ENDIF
				ENDSELECT
				;パイズリ
			CASE 53
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「당신의 거시기, 아주 괴로워 보이네... HPH」","L"
						CALL HPH_PRINT,@"「내 가슴으로, 지금 편하게 해 줄게……. HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그 풍만한 가슴을 사용해서, %조사처리(CALLNAME:MASTER,"의")% 페니스를 부드럽게 쓸어 올리고 있다.
							PRINTFORMDW %CALLNAME:MASTER%손을 사용해서, 그녀의 가슴을 부드럽게 애무해 주었다...
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「당신 거시기... 뜨거워... HPH」","L"
						CALL HPH_PRINT,@"「가슴... 데어버릴 것 같아... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 봉사에 맞춰 %CALLNAME:MASTER%도 부드럽게 허리를 움직인다.
							PRINTFORMDW 유두 안에 고인 선행이 공기와 섞여 질척질척한 음을 연주했다.
						ENDIF
					CASE 2
						SIF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% %NIPPLE_DESCRIPTION(TARGET)%을 꽉 집어 올렸다
						CALL HPH_PRINT,@"「앙! 후후, %조사처리(CALLNAME:MASTER,"는")% 정말이지...... 후후」","L"
						CALL HPH_PRINT,@"「나쁜 아이에게는, 혼내줘야 하나……. HPH」","L"
						SIF !CFLAG:99:1998
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 살짝 미소 짓더니, 가슴을 감싸 안는 듯 페니스를 끼우고 두드리듯 위아래로 문지르기 시작했다...
				ENDSELECT
				;ぱふぱふ
			CASE 73
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「네, 당신이 제일 좋아하는 가슴이에요... HPH」","L"
						CALL HPH_PRINT,@"「듬뿍, 만끽해줘... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 가슴을 양손으로 주무르며, 골짜기에 얼굴을 묻고 후- 하고 깊게 숨을 들이마신다.
							PRINTFORMDW 여성 특유의 달콤한 향기를 폐가 가득 찰 때까지 들이마시자, %조사처리(CALLNAME:MASTER,"의")% 남근은 더욱 단단해졌다.
						ENDIF
					CASE 1
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)% 끝의 돌기에 주위 연육까지 빨아들였다.
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 신음하며 %조사처리(CALLNAME:MASTER,"의")% 머리를 세게 끌어안았다……
						ENDIF
						CALL HPH_PRINT,@"「흐아... 하아...윽 후후 좋다... 더... 후후」","L"
						CALL HPH_PRINT,@"「쪽쪽, 아기처럼 빨아줘... HPH」","W"
					CASE 2
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)%을 양쪽에서 손으로 감싸 강하게 얼굴에 밀어붙였다.
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 미소 지으며, 부드럽게 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬고 있었다……
						ENDIF
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")% 완전히 빠져버려서... HPH」","L"
						CALL HPH_PRINT,@"「착하다 착하다... 좋은 아이야... HPH」","W"
				ENDSELECT
				;乳合わせ
			CASE 74
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「정말 좋아해... 당신을... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 몸을 비비며 애교를 부리는 %조사처리(CALLNAME:TARGET,"를")% 꽉 껴안는다
							PRINTFORMDW 풍만한 가슴이 %조사처리(CALLNAME:MASTER,"의")% 가슴팍에 밀착되어, 말랑하게 형태를 바꾸었다
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「당신의 여기, 단단해졌어... HPH」","L"
						CALL HPH_PRINT,@"「콕콕 찔러지는 거, 좋아하는구나……후후」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 풍만한 가슴을 밀착시키며, %조사처리(CALLNAME:MASTER,"의")% 유두를 손가락으로 가지고 논다.
							PRINTFORMDW %CALLNAME:MASTER%지지 않고 손을 움직여, 그녀의 부드러운 가슴을 주무르고 있었다.
						ENDIF
					CASE 2
						SIF !CFLAG:99:1998
							PRINTFORMDL  %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)%를 가슴팍에 밀어붙이게 했다…….
						CALL HPH_PRINT,@"「음... 이렇게 붙으면... 후훗」","L"
						CALL HPH_PRINT,@"「당신의 강인함... 느껴져요... HPH」","W"
				ENDSELECT
				;乳を吸わせる
			CASE 77
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「후훗... 잘했어, 응석 부리고 싶었구나... HPH」","L"
						CALL HPH_PRINT,@"「언니한테, 마음껏 기대도 돼... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 애무한다는 목적도 잊고, %조사처리(CALLNAME:MASTER,"는")% 열중해서 유두를 입에 물었다.
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어린 동생을 달래듯이, 가슴에 달라붙은 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬고 있었다.
						ENDIF
					CASE 1
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% %NIPPLE_DESCRIPTION(TARGET)%를 혀로 핥고, 입술로 물고, 이로 살짝 깨물었다.
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 간헐적인 자극에 반응하며 몇 번이고 신음했다...
						ENDIF
						CALL HPH_PRINT,@"「하아...읏 HPH 아, 하아...읏 HPH」","L"
						CALL HPH_PRINT,@"「더, 세게……윽 HPH 음, 응…… 윽 HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「자, 가슴 시간이야... HPH」","L"
						CALL HPH_PRINT,@"「잔뜩 마시고, 키워야 해... HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 「커지게 해줘」가 아니라 「크게 만들어라」
							PRINTFORMDW 그것이 무엇을 지칭하는지는 말하지 않아도 알 수 있었다
						ENDIF
				ENDSELECT
				;85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ
			CASE 85,87,88,89
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「있잖아... 가슴이 흔들려서 아파...」 HPH","L"
						CALL HPH_PRINT,@"「이렇게, 지탱해 줄 수 있을까...? HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 손을 잡고, 허리의 움직임에 맞춰 흔들리는 자신의 풍만한 가슴으로 이끌었다.
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 손바닥으로 가슴을 움켜쥐자, %조사처리(CALLNAME:TARGET,"는")% 다시 허리를 움직이기 시작했다...
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「더 만져줘... 흐응... 그래...」","L"
						CALL HPH_PRINT,@"「끝도 잊지 말아줘... 흐읍 아......앗흐읍」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 달라붙는 듯한 피부의 감촉, 그리고 어디까지나 깊이 가라앉을 것 같은 부드러움을 만끽한다.
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 애무에 몸을 맡긴 채, 나른하게 허리를 움직이고 있다……
						ENDIF
					CASE 2
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 탱글탱글하게 흔들리는 %OPPAI_DESCRIPTION(TARGET)%에게 손을 뻗어, 움켜쥐고 흔들었다…….
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 음란하게 미소 지으며, 허리를 계속 움직이고 있었다…….
						ENDIF
						CALL HPH_PRINT,@"「후훗…… 나에게도 기분 좋게 해주는 거네…… HPH」","L"
						CALL HPH_PRINT,@"「좋아... HPH 같이 기분 좋아지자... HPH」","W"
				ENDSELECT
				;だいしゅきホールド
			CASE 86
				SELECTCASE RAND:3
					CASE 0
						IF !CFLAG:99:1998
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"와")% 껴안은 채 %OPPAI_DESCRIPTION(TARGET)%를 애무했다.
							PRINTFORMDL 가슴을 자극할 때마다 %조사처리(CALLNAME:TARGET,"의")% 질벽은 %조사처리(CALLNAME:MASTER,"의")% 페니스를 조여왔다……
						ENDIF
						CALL HPH_PRINT,@"「하아...... HPH 당신과 이렇게 있다니...... HPH」","L"
						CALL HPH_PRINT,@"「내 심장이... 두근두근해버릴 것 같아... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「사정하고 싶어지면, 언제든지 사정해라... HPH」","L"
						CALL HPH_PRINT,@"「전부, 받아 줄 테니까…… HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 가슴을 애무하는 %조사처리(CALLNAME:MASTER,"의")% 귓가에 얼굴을 가까이 대고, %조사처리(CALLNAME:TARGET,"가")% 그렇게 속삭인다.
							PRINTFORMDW 수정(종자)를 의식시키는 듯 꽉 질려, %조사처리(CALLNAME:MASTER,"는")% 나도 모르게 신음소리를 내었다.
						ENDIF
					CASE 2
						CALL HPH_PRINT,@"「응음... 흐읍 HPH 더 움직여줘... 흐읍 HPH」","L"
						CALL HPH_PRINT,@"「내 안에…… 당신의 더러움을, 받겠어……윽 HPH」","L"
						IF !CFLAG:99:1998
							PRINTFORMDL 부드럽게 감싸오는 질의 감촉에 허리가 빠질 듯하면서도, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 기쁘게 하기 위해 계속 골반을 움직인다.
							PRINTFORMDL 부르르 떨리는 풍만한 가슴을 두 손으로 주무르자 %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 신음을 터뜨렸고,
							PRINTFORMDW 사정 직전의 페니스를 꽉 조여오기 시작했다...
						ENDIF
				ENDSELECT
				;それ以外
			CASEELSE
				;愛撫系コマンドの胸愛撫を読み込む
				CALL M_KOJO_MESSAGE_COM_K99_6_1
		ENDSELECT
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 풍만한 가슴을 뒤에서 천천히 주무르며 애썼다.
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 하아하아 하고 숨을 몰아쉬면서, %조사처리(CALLNAME:MASTER,"의")% 애무에 몸을 맡기고 있다……
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
