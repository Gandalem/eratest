			;永琳とデート
			IF FLAG:デート相手 == 72
				PRINTFORML 「……하이토님도 의외로……」
				PRINTFORML 「아, 아니에요! 아무것도 아닙니다」
				PRINTFORML 「그럼, 잘 다녀오세요」
				;依姫とデート
			ELSEIF FLAG:デート相手 == 98
				PRINTFORML 「아아, 아가씨도 구석에 있을 수 없군요.」
				PRINTFORML 「후후후, 부끄러워하지 않아도 괜찮아요.」
				PRINTFORML 「그럼, 제 여동생을 잘 부탁드립니다.」
				;鈴仙orレイセンとデート
			ELSEIF FLAG:デート相手 == 52 || FLAG:デート相手 == 100
				PRINTFORML 「\@ FLAG:デート相手 == 52 ? 레이센 # 레이센 \@, 실수를 하지 않도록 말이야」
				PRINTFORML 「무슨 일이 생기면, 당신이 그를 지키는 거야?」
				PRINTFORML 「후훗, 좋은 대답이네. 그럼 잘 다녀와」
				;それ以外
			ELSE
				PRINTFORML 「어라, 데이트?」
				PRINTFORML 「후훗, 즐기고 와」
			ENDIF
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 작게 손을 흔들며 데이트 중인 두 사람을 배웅했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
