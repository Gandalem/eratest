		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 태어난 지 얼마 안 된 자신의 아이에게 모유를 먹이고 있었다
		PRINTFORMDW 누구를 닮았는지, 식욕이 매우 왕성하다
		PRINTFORMW 「저기, %CALLNAME:MASTER%. 이 아이의 이름을 정해 줄까요?」
		PRINTFORMDL 자신이 정해도 좋지만, %조사처리(CALLNAME:TARGET,"의")% 생각도 듣고 싶다
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 그렇게 말하자, %조사처리(CALLNAME:TARGET,"는")% 「그렇네」라며 잠시 생각한 후 몇 가지 후보를 들었다
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		GOTO TOYOHIME_CHILDBIRTH
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		GOTO TOYOHIME_CHILDBIRTH
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
