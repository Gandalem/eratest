						;夜
					CASE 6,7
						PRINTFORML 「하아~……어머, %CALLNAME:MASTER%」
						PRINTFORML 「밤늦게 안 깨고, 제대로 자야 해?」
						PRINTFORMDW 입을 크게 벌리고 하품하는 %조사처리(CALLNAME:TARGET,"는")%, 정말 달의 공주라고 생각되지 않는다…….
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
