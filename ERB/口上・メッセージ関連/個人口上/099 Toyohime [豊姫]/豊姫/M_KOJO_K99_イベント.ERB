				PRINTFORMDW 각오를 다진 %조사처리(CALLNAME:MASTER,"는")% 기대어 있는 토요히메의 어깨를 안았다
				PRINTFORMW 「흡, 그럼……」
				CALL HPH_PRINT,@"「여기서는 어른들의 데이트를 즐겨볼까요... HPH」","W"
				PRINTFORMDL ……………
				PRINTFORMDL ………
				PRINTFORMDW …
				IF !TALENT:MASTER:非童貞
					FONTBOLD
					SETCOLOR 255,100,255
					PRINTFORMW 동정 상실
					FONTREGULAR
					RESETCOLOR
					TALENT:MASTER:非童貞 = 1
				ENDIF
				PRINTFORML 
				CALL COLORMESSAGE(@"토요히메의 합의를 얻었다.",C_PINK,0,1)
				PRINTFORMW 
				SETBIT CFLAG:99:既成事実 , 1
				EXP:99:絶頂経験 += 1
				EXP:99:Ｖ性交経験 += 3
				EXP:MASTER:射精経験 += 1
				EXP:MASTER:挿入経験 += 3
				CALL MUTUAL_KISS(TARGET, 5)
				TIME += 240
		ENDSELECT
	ENDIF
