IF LOCAL
	;豊姫とデート中限定
	IF FLAG:デート相手 == 99
		PRINTFORML 
		SELECTCASE CFLAG:MASTER:現在位置
			CASE 連れ込み宿
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「……후훗」
						PRINTFORML 「그렇네. 잠시 쉬어가는 게 어떨까」
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 팔짱을 낀 채 연례 숙소로 들어갔다……
					CASE 1
						PRINTFORML 「이 방 같네」
						PRINTFORMDL 열쇠에 쓰인 번호와 대조해 본다. 확실히 이 방 같다
						PRINTFORMDW 열쇠를 열고 방에 들어가니, 간소한 방에 이불이 깔려 있었다……
					CASE 2
