				CASE 2
					PRINTFORML 「아이고, 입술이라도 좋으면서 ♪」
					CALL HPH_PRINT,@"「자... 여기... HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"를")% 유혹하듯이 입술을 토닥거리고 있다.
			ENDSELECT
			;セフレ
		ELSEIF TALENT:セフレ
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「다음엔 이쪽으로 해줄까?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 소악마처럼 웃으며, 토닥토닥 자신의 입술을 가리키고 있다.
					PRINTFORMDW 그 몸짓에, 장난을 건 쪽의 %조사처리(CALLNAME:MASTER,"가")% 가슴이 두근거렸다.
				CASE 1
					PRINTFORML 「이마에 키스하고... 끝이야?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 기대감으로 가득 찬 눈으로 %조사처리(CALLNAME:MASTER,"를")% 보고 있다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 얼굴을 가까이 하자, %조사처리(CALLNAME:TARGET,"는")% 살짝 몸을 숙이며 눈을 감았다.
					EXP:99:キス経験 ++
					EXP:MASTER:キス経験 ++
				CASE 2
					PRINTFORML 「음, 이쪽도 좋아하지만……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 애쓰며 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗았다.
					PRINTFORMW 「후우……역시, 여기 아니면 안 돼……그렇지?」
					EXP:99:キス経験 ++
					EXP:MASTER:キス経験 ++
			ENDSELECT
			;思慕
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 머리를 끌어당겨 그녀의 이마에 키스했다.
					PRINTFORML 「아……」
					PRINTFORML (……입술이라도 좋았을 텐데……)
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어딘가 불만스러운 듯 %조사처리(CALLNAME:MASTER,"를")% 보고 있다…….
				CASE 1
					PRINTFORML 「저기, 조금 숙여줄래?」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 말한 대로 몸을 숙이자, 이마에 따뜻한 것이 닿았다.
					PRINTFORML 「……이거, 답례야」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 키스당했다는 것을 깨닫자
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 어쩐지 민망한 기분이 되었다…….
				CASE 2
					PRINTFORML 「자, 당신도 이마를 내밀어 볼래?」
					PRINTFORML 「……응.」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 살짝 몸을 일으켜 %조사처리(CALLNAME:MASTER,"의")% 이마에 살짝 입 맞췄다.
					PRINTFORML 「어머, 무슨 일이야? 얼굴이 빨개졌네.」
					PRINTFORML 「당신이 한 걸 나도 했을 뿐인데.」
					PRINTFORMW 「응? 나도 빨개져 있어? 음~ 그럼 비겼네.」
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음... 뭔가 부끄럽네」
					PRINTFORML 「이런 건, 당신에게만 당해봤으니까...」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 애정 표현에 %조사처리(CALLNAME:TARGET,"는")% 부끄러워하고 있다
				CASE 1
					PRINTFORML 「에? 저도요?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 잠시 침묵한 뒤, 살짝 몸을 일으키며……
					PRINTFORML 「……아니, 역시 안 돼요. 부끄러워요」
					PRINTFORMDW 얼굴을 붉히고 %CALLNAME:MASTER%에게서 떨어졌다
				CASE 2
					PRINTFORML 「나니까 다행이지만……」
					PRINTFORML 「이런 건 다른 여자애한테 하면 안 돼?」
					PRINTFORMDW 그렇게 말하는 %조사처리(CALLNAME:TARGET,"의")% 얼굴은 만족스럽지 않은 것 같았다……
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
