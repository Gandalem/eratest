; Modular ERB: 個人口上/099 Toyohime [豊姫]/豊姫/M_KOJO_K99_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K99_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_300
RETURN 0

@M_KOJO_MESSAGE_COM_K99_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K99_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初回会話
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「이렇게 지상의 사람과 이야기하는 건 꽤 오랜만이야.」
		PRINTFORML 「지금부터 천오백 년 이상 전... 아마 그의 이름은 미즈에우라시마코였던 것 같아.」
		PRINTFORMW 「아, 우라시마 타로라고 하는 게 더 이해하기 쉬울까?」
		;怒り
	ELSEIF CFLAG:ブチギレ > 0  || MARK:反発刻印 >= 3
		PRINTFORML 「……………」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부채로 입가를 가린 채 %조사처리(CALLNAME:MASTER,"를")% 가만히 응시하고 있다.
		;会話不能
	ELSEIF TCVAR:302
		;恋慕
		IF TALENT:恋慕
			PRINTFORML 「………」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 미소를 지으며 조용히 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
			;それ以外
		ELSE
			PRINTFORML 「뭐, 뭐 그렇게 딱딱하게 굴지 마.」
			PRINTFORMW 「좀 더 편하게 이야기하지 않을래?」
		ENDIF
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:10
				CASE 0
					;１５分の１の確率でフェムトファイバーについて語る
					IF !RAND:15
						PRINTFORML 「슬슬 페므토 파이버가 무엇인지 잊어버린 건 아닐까?」
						PRINTFORMW 「어때? 여기서 다시 한번 복습해 보는 건」
						PRINTFORML 
						;選択肢
						CALL ASK_YN("네","아니")
						;判定
						SELECTCASE RESULT
							;はい
							CASE 0
								GOTO FEMTOFIBER
								;いいえ
							CASE 1
								PRINTFORMW 「그렇게 말할 거라고 생각하고 있었어」
								GOTO FEMTOFIBER
						ENDSELECT
						;通常
					ELSE
						PRINTFORMDL 대화가 한차례 마무리되고 두 사람은 나란히 숨을 골랐다.
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 살며시 어깨를 감싸 안으며 달콤한 말을 속삭이자
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 부끄러움에 홍조를 띠면서도 기쁜 듯 미소 지었다.
						PRINTFORMW 「……후후, 나도 정말 좋아해. %CALLNAME:MASTER%♪」
					ENDIF
				CASE 1
					PRINTFORML 「언젠가 당신도......」
					PRINTFORML 「......아니야, 아무것도 아니야」
					PRINTFORMW 「자, 더 당신 이야기를 들려줘?」
				CASE 2
					PRINTFORML 「어라? 어라아~? 어디를 보고 있는 걸까~?」
					PRINTFORML 「사람과 이야기할 때는 제대로 상대방의 눈을 보고 말해야 해...♪」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 블라우스의 단추를 풀고, 가슴을 치켜들며 골짜기를 보여주었다...
				CASE 3
					PRINTFORML 「……푸훗, 후후」
					PRINTFORML 「아하하, 죄송해요」
					PRINTFORMW 「당신의 이야기가 이상해서, 무심코」
				CASE 4
					PRINTFORML 「그 이야기는 아직 계속되는 건가요?」
					PRINTFORML 「자, 자, 더 들려줘요~♪」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 즐겁게 웃고 있다.
				CASE 5
					PRINTFORML 「당신은 들어본 적 있니?」
					PRINTFORML 「어떤 달의 민족과 지상의 민족에 관한 소문을……」
					PRINTFORML 「사람들의 소문도 일흔다섯 날이라고는 하지만, 벌써 꽤 지났는데 좀처럼 사라지지 않는구나」
					PRINTFORMW 「후후후, 대체 누구와 누구의 이야기일까~」
				CASE 6
					PRINTFORML 「언젠가 당신과 함께 여행을 떠나고 싶다고 생각하고 있어」
					PRINTFORML 「아무도 우리를 모르는 곳에 가서, 거기서……」
					PRINTFORML 「……둘만의 작은 결혼식을 올리거나」
					PRINTFORML 「아아, 하지만 요리히메는 초대해주고 싶을지도…… 그리고 하치이님도……」
					PRINTFORMDW 왠지 갑자기 이야기가 비약한 기분이 들어…….
				CASE 7
					PRINTFORML 「응? 내 이야기를 듣고 싶어?」
					PRINTFORML 「음... 그러면...」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% %CALLNAME:TARGET%에게서 %TEXTR("気の遠くなるような昔の出来事/依姫との思い出/面白い話/")%를 들었다.
				CASE 8
					CALL HPH_PRINT,@"「………HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 말에 귀를 기울이면서 뜨거운 시선을 계속 보내고 있다.
					PRINTFORML 「아아, 괜찮아. 계속해?」
					PRINTFORMW 「당신의 이야기는 제대로 듣고 있으니까」
				CASE 9
					PRINTFORML 「있잖아... 나를 '토요네'라고 불러줄 수 없어?」
					PRINTFORML 「.........아앗♪」
					PRINTFORMW 「방금의... 정말 짜릿했어...♪」
			ENDSELECT
			;セフレ
		ELSEIF TALENT:セフレ
			SELECTCASE RAND:10
				CASE 0
					PRINTFORML 「있으면 즐거워?」
					PRINTFORML 「……아, 아니. 그냥 들어보려고 한 거야」
					PRINTFORMW 「아무것도 아니야. 정말이야?」
				CASE 1
					PRINTFORML 「믿을 만한 언니가 될 수 있다면 하고 생각했어」
					PRINTFORML 「하지만 현실은 계속 의지할 뿐이야. 요리히메에게도, 당신에게도」
					PRINTFORMW 「――왜 그런 이야기를 한다고? 후후, 당신이라면 괜찮겠다고 생각했을 뿐이야」
				CASE 2
					PRINTFORML 「그건 그렇고... 요리히메에 대해서는 어떻게 생각하고 있어?」
					PRINTFORML 「봐, 그 아이는 그런 타입이라 남자다움 같은 건 전혀 없어.」
					PRINTFORML 「당신이라면 믿을 수 있고, 맡겨도 괜찮을 거라고 생각해서.」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 요리히메와 자신을 이어주고 싶어하는 것 같아...
				CASE 3
					;豊姫が兎たちに向ける優しさは池の鯉に向けるものと同程度、という考察
					PRINTFORML 「만약 당신을 공격하는 토끼가 있다면 되갚아줘도 괜찮으니까」
					PRINTFORML 「죽어도 대체할 수 있으니까…… 뭐, 죽지 않는 게 좋지만」
					PRINTFORMDW 여동생과는 다르게, %조사처리(CALLNAME:TARGET,"는")% 개개인의 토끼에게 별로 애착이 없는 것 같다…….
				CASE 4
					PRINTFORML 「어머, 또 하고 싶어졌니?」
					PRINTFORML 「그렇네... 어떡하지...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 일부러 고민하는 모습을 보이고 있다...
				CASE 5
					PRINTFORML 「당신은 의외로 육식계네」
					PRINTFORML 「후후, 어쩐지 친근감이 느껴져서 말이야」
					PRINTFORMDW 무슨 의미냐고 %조사처리(CALLNAME:MASTER,"는")% 물었지만, %조사처리(CALLNAME:TARGET,"는")% 웃으며 얼버렸다……
				CASE 6
					PRINTFORML 「당신의 더러움을 계속 받아들인다면, 나도 야이님의 모습이 될 수 있을까」
					PRINTFORML 「만약 그렇다면, 타락하는 곳까지 떨어져 보는 것도 나쁘지 않을지도 몰라」
					PRINTFORMDW 농담이라도 그런 말을 해도 괜찮을까. %조사처리(CALLNAME:MASTER,"는")% 조금 걱정이 되었다
				CASE 7
					PRINTFORML 「――레이센을 어떻게 생각하는지?」
					PRINTFORML 「둔하고 느린 아이. 전보다 쓸모없고, 또 도망가지 않을까 생각하고 있어」
					PRINTFORML 「그래서 눈을 뗄 수가 없어. 그 아이는 애완동물 취급이겠지」
					PRINTFORMDW 일단 다른 수많은 토끼들보다는 소중히 여겨지고 있다. %조사처리(CALLNAME:MASTER,"는")% 그렇게 해석했다
				CASE 8
					PRINTFORML 「――어머, 나에게 상담할 일이 있니?」
					PRINTFORML 「후훗, 언니에게 맡겨줘♪」
					PRINTFORMDW 이런 관계이기 때문에 이야기할 수 있는 것도 있다. %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 고민을 상담했다
				CASE 9
					PRINTFORML 「――섹스는 좋아해?」
					PRINTFORML 「엄청 좋아해. 왜냐면, 당신과 이어질 수 있으니까」
					PRINTFORMDW 태연하게 %조사처리(CALLNAME:TARGET,"는")% 그렇게 말했다
			ENDSELECT
			;思慕
		ELSEIF TALENT:思慕
			SELECTCASE RAND:10
				CASE 0
					PRINTFORML 「요리히메랑 사이좋게 지내고 있어?」
					PRINTFORML 「그 아이를 부담 없이 '욧짱'이라고 불러도 돼.」
					PRINTFORMW 「괜찮아. 처음엔 부끄러해하겠지만 금세 익숙해질 테니까.」
				CASE 1
					PRINTFORML 「토끼들 사이에서도 당신 얘기로 떠들썩하단다」
					PRINTFORML 「응? 어떻게 소문이 나고 있냐고?」
					PRINTFORML 「……………」
					PRINTFORMW 「뭐, 뭐... 그 이야기는 나중에 하자.」
				CASE 2
					PRINTFORML 「일 안 해도 되는 거야?」
					PRINTFORML 「어머, 당신에게는 그렇게 보이는 거야?」
					PRINTFORMW 「이래도 꽤 바쁘다구? 책을 읽거나, 복숭아를 먹거나……」
				CASE 3
					PRINTFORML 「복숭아의 칼로리는 100g당 40kcal야」
					PRINTFORML 「그러니까, 저칼로리라서 살찌기 어렵다는 거지」
					PRINTFORML 「그래서 아무리 먹어도 괜찮다는 거네」
					PRINTFORML 「그런데……하아, 요리히메는」
					PRINTFORML 「그 아이가 내가 복숭아를 먹고 있으면 폭식이라고 말해버려」
					PRINTFORMW 「살 안 찐다고 해도 들어주질 않아서……」
				CASE 4
					PRINTFORML 「하아... 어쩐지 배가 고파지네」
					PRINTFORML 「맞아, 슬슬 좋은 때의 복숭아가 있단다. 같이 따러 갈래?」
					PRINTFORMW 「...아, 요리히메에게는 비밀이야? 잔소리가 시작될 테니까」
				CASE 5
					PRINTFORML 「당신을 어떻게 생각하고 있는지?」
					PRINTFORML 「음... 믿어지는 동생...? 그런가?」
					PRINTFORMDW 손이 많이 가는 누나를 둔 요리히메는 힘들어 보인다.
				CASE 6
					PRINTFORML 「길은 가까이에 있는데 그것을 멀리서 찾는다는 것」
					PRINTFORML 「돌아가는 것이 항상 옳은 것은 아니라는 것」
					PRINTFORMW 「아, 이거 야이님의 버릇이네」
				CASE 7
					PRINTFORML 「옛날이야기? 그래...」
					PRINTFORMW 「그건 지금으로부터 삼십육만... 아니, 일만 사천 년 전이었을지도 몰라」
				CASE 8
					PRINTFORML 「그러고 보니... 나, 보고 말았어」
					PRINTFORML 「요리히메가 거울 앞에서 멋진 옷을 입고 포즈를 취하는 걸」
					PRINTFORML 「물론 그건 우연히 들고 있던 카메라로 녹화해 두긴 했는데」
					PRINTFORMW 「보고 싶어? 후후훗, 그럼 다음에 둘만 있자♪」
				CASE 9
					PRINTFORML 「잠깐의 마음의 흔들림... 설령 그렇다고 해도」
					PRINTFORML 「%CALLNAME:MASTER%라는 더러움을 받아들이는 것도, 나쁘지 않을지도 라고 생각해서...」
					PRINTFORMW 「...이런 말을 하면 여동생에게 혼날 것 같아.」
			ENDSELECT
			;それ以外
		ELSE
			$TOYOHIME_KAIWA
			SELECTCASE RAND:10
				CASE 0
					;５分の１の確率でフェムトファイバーについて語る
					IF !RAND:5
						PRINTFORMW 「펨토파이버이 무엇인지 알고 있나?」
						;選択肢
						CALL ASK_YN("네","아니")
						;判定
						SELECTCASE RESULT
							;はい
							CASE 0
								PRINTFORML 「펨토, 쉽게 말하자면... 응? 이미 알고 있어?」
								PRINTFORMW 「그래... 유감이다.」
								RETURN 1
								;いいえ
							CASE 1
								GOTO FEMTOFIBER
						ENDSELECT
						$FEMTOFIBER
						PRINTFORMW 「펨토... 쉽게 말하면 잠깐의 시간이야.」
						PRINTFORMW 「잠깐이란 생물이 인식할 수 없는 아주 짧은 시간의 일이야.」
						PRINTFORMW 「시간이란... 인식할 수 없는 순간들이 무수하게 쌓여 만들어진 것이지.」
						PRINTFORMW 「시간의 최소 단위인 잠깐이 인식되지 않기에 시간은 연속적으로 보이지만...」
						PRINTFORMW 「사실 짧은 시간들이 합쳐져 만들어지고 있는 거야.」
						PRINTFORMW 「땋은 실도 한 가닥의 줄처럼 보이지만, 사실은 가는 실들이 엮여 있는 것이지.」
						PRINTFORMW 「인식할 수 없는 가느다란 섬유로 짠 땋은 실은 끝없이 연속된 물질처럼 보이겠지.」
						PRINTFORMW 「그때, 줄에서 불필요한 것들이 사라지고 가장 강한 강도를 자랑하게 돼.」
						PRINTFORMW 「게다가 쓸데없는 더러움도 달라지지 않는 거야.」
						PRINTFORMW 「이 실을 더욱 엮어 두꺼운 밧줄로 만들면, 결코 썩지 않는 밧줄이 만들어져.」
						PRINTFORMW 「그 밧줄은 아주 오래전부터 불결한 자들의 출입을 막기 위해 사용되어 왔단다.」
						PRINTFORMW 「그것이 펨토파이버. 이해했니?」
						PRINTFORML 
						EXP:MASTER:学習経験 ++
						TCVAR:99:350 += 1
						;選択肢
						CALL ASK_M("네", 1, "아니", TCVAR:99:350 < 3)
						;判定
						SELECTCASE RESULT
							;はい
							CASE 0
								CALL M_KOJO_COLOR_K99
								PRINTFORMW 「다행이야♪ 또 듣고 싶을 때 언제든지 말해줘」
								RESETCOLOR
								TCVAR:99:350 = 0
								;いいえ
							CASE 1
								PRINTFORML 「어머, 지상의 민족들에게는 조금 어려웠을까?」
								PRINTFORMW 「그렇다면 다시 한번 설명해 줄게.」
								TIME += 10
								GOTO FEMTOFIBER
						ENDSELECT
						;それ以外の場合は会話再抽選
					ELSE
						GOTO TOYOHIME_KAIWA
					ENDIF
				CASE 1
					;依姫と面識が無い
