					PRINTFORML 「후훗, 개줘서 다행이야」
					PRINTFORMW 「그럼, 데이트를 계속할까요♪」
					;晴れて虹になる
					TIME:5 = 0
					TIME:7 = 1
					;１時間経過
					TIME += 60
			ENDSELECT
