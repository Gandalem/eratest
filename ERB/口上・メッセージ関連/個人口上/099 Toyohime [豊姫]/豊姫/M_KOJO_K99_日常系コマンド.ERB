@M_KOJO_MESSAGE_SCOM_K99_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:時間停止
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %CALLNAME:TARGET%공주 입을 자신의 입으로 더 막았다……
		PRINTFORMDW 시간을 멈춘 %조사처리(CALLNAME:TARGET,"는")% 무저항의 채 키스당하고 있다……
	ELSEIF CFLAG:睡眠
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% 입을 자신의 입으로 더 막았다…….
		PRINTFORMDW 천천히 혀를 넣어 구강 내부를 핥자, %조사처리(CALLNAME:TARGET,"는")% 무의식적으로 혀를 얽어왔다…….
		;押し倒され
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K99_312_1
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 입을 자신의 입으로 더욱 막았다…….
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 요구받는 것에 %조사처리(CALLNAME:TARGET,"는")% 행복감을 느끼고 있다…….
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응응......읍 흐응... 할 수 있어......읍 흐응」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리카락을 휘감듯이 끌어당겨 진한 입맞춤을 나누었다.
					PRINTFORMDL 입가에서 침이 흘러내리는 것도 개의치 않고
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"와")% 열정적으로 혀를 얽게 했다……
					CALL HPH_PRINT,@"「흐,으음... 하아...! 큭, 더 해요...? 큭」","W"
				CASE 1
					CALL HPH_PRINT,@"「음므... 츄... 르륵... 헉」","L"
					CALL HPH_PRINT,@"「푸하... 하아... 아아... HPH」","L"
					CALL HPH_PRINT,@"「머리가... 멍해진다...」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 상기된 뺨을 %조사처리(CALLNAME:MASTER,"의")% 가슴께에 비비며 애원하고 있다...
				CASE 2
					CALL HPH_PRINT,@"「하아... 하아... HPH 당신의 키스, 격렬해서... HPH」","L"
					CALL HPH_PRINT,@"「나... 야한 기분이 되어버렸어... HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 자신의 가슴으로 이끈다.
					PRINTFORMDW 발기한 그녀의 유두는, 옷 위로도 알 수 있을 정도로 존재감을 주장하고 있다……
			ENDSELECT
			;セフレ
		ELSEIF TALENT:セフレ
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"와")% 서로를 갈망하듯 입술을 포개었다.
			PRINTFORMDL 누군가 볼지도 모른다는 걱정 따위, 두 사람에게는 사소한 일이었다……
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후우……츄……흣, 하아……흣」","L"
					PRINTFORMDL 마치 범하듯이 혀를 비틀며, %조사처리(CALLNAME:TARGET,"의")% 구강 내부를 구석구석 맛본다.
					PRINTFORMDW 만족한 %조사처리(CALLNAME:MASTER,"가")% 입술을 떼자, 이번에는 %CALLNAME:TARGET%쪽에서 먼저 입술을 포개왔다.
				CASE 1
					CALL HPH_PRINT,@"「음후... 음... HPH 응... 코쿠... 윽HPH」","L"
					PRINTFORMDL 흘러 들어온 %조사처리(CALLNAME:MASTER,"의")% 타액을 아무 망설임 없이 삼키는 %CALLNAME:TARGET%
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 머리를 쓰다듬어 주자, %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 몸을 바짝 붙였다
				CASE 2
					CALL HPH_PRINT,@"「아... 응! 흐읍... 쪽...! 흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 몸을 눌러 입맞춤하고, 몸을 더 만진다.
					PRINTFORMDW 흐트러진 암컷 같은 소리를 내는 %조사처리(CALLNAME:TARGET,"의")% 표정은 완전히 지상에 물들어 있었다.
			ENDSELECT
			;それ以外
		ELSE
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 입을 자신의 입으로 더 막았다…….
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 볼을 붉히면서도 %조사처리(CALLNAME:MASTER,"를")% 받아들이고 있다…….
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「움직이지 마……」
					PRINTFORML 「나 쪽에서 해줄 테니까……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 살짝 몸을 숙여, %조사처리(CALLNAME:MASTER,"의")% 입술에 자신의 것을 포갰다.
					PRINTFORMDW 그녀의 부드러운 입술의 감촉에 %조사처리(CALLNAME:MASTER,"의")% 흥분이 어쩔 수 없이 고조되어 갔다……
				CASE 1
					PRINTFORML 「음……응……윽」
					PRINTFORML 「%CALLNAME:MASTER%, 잠깐만……아, 음무……츄루……윽」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 정열적인 입맞춤에 %조사처리(CALLNAME:TARGET,"는")% 흘러가는 대로 했다.
					PRINTFORMDW 침을 교환하고, 혀를 얽히게 하며, 서로의 구강 내를 탐했다…….
				CASE 2
					PRINTFORML 「하아... 하아...」
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 너무 격렬해...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 가슴에 얼굴을 묻고, 키스의 여운에 잠겨 있다...
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
