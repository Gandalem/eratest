				;トランペット
			CASE 4
				PRINTFORML 「에? 나도 불어봐, 라고?」
				PRINTFORML (이거 간접 키스... 맞지?)
				PRINTFORML (후훗, 왠지 두근두근해져 버려...)
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 살짝 볼을 붉히며 마우스피스에 입술을 갖다 댔다
				EXP:99:演奏経験 += 2
				;ヴァイオリン
			CASE 5
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 연주를 마치고 %조사처리(CALLNAME:TARGET,"에게")% 바이올린을 들게 해보았다.
				PRINTFORML 「음... 이렇게?」
				PRINTFORMW 「어울려? 그, 그래...?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
