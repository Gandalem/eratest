@M_KOJO_EXTRASOURCE_COM_K99_603
IF CFLAG:99:1000 == 1
	SOURCE:反感 = SOURCE:反感 / 5
ENDIF

@M_KOJO_MESSAGE_COM_K99_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「오늘 하루, 계속 손을 잡고 있을까요」
				PRINTFORML 「...에? 목욕이나 화장실은 어떻게 하자는 거야?」
				PRINTFORML 「당신이 좋다면 잡은 채로 있어도 상관없지만... 정말 그걸로 괜찮아?」
				PRINTFORML 「...크큭, 알고 있어. 농담이라는 거 정도는.」
				PRINTFORMW 「하지만 목욕이나 화장실에서 손을 잡고 있는 것도... 그것 나름으로 즐거울 것 같네」
			CASE 1
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 팔을 껴안고 손을 잡고 있다.
				PRINTFORML 「걷기 힘들어? 뭐, 괜찮잖아」
				PRINTFORMW 「모처럼 데이트인데 말이야. 응?」
			CASE 2
				PRINTFORML 「응? 손을 잡고 싶은 거야?」
				PRINTFORML 「후후, 괜찮아. 자」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 손가락을 얽자, %CALLNAME:TARGET%도 부드럽게 맞잡았다
		ENDSELECT
		;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「데이트니까, 그런 손잡는 방식은 안 돼」
				PRINTFORML 「이렇게... 손가락을 깍지 끼듯이 해야지」
				PRINTFORMW 「그치? 이쪽이 데이트답고 좋잖아?」
			CASE 1
				PRINTFORML 「이렇게 하고 있으면 연인처럼 보일까」
				PRINTFORML 「어라? 왜 그래? 부끄러워?」
				PRINTFORMW 「괜찮잖아, 보여져도」
			CASE 2
				PRINTFORML 「모처럼 데이트인데 손이라도 잡아야지」
				PRINTFORML 「자, 더 꽉 잡아봐♪」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 손을 잡더니 적극적으로 손가락을 얽어왔다
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 조심스럽게 손을 잡자, %CALLNAME:TARGET%도 부드럽게 잡아주었다.
				PRINTFORML 「자, 좀 더 어깨의 힘을 빼고」
				PRINTFORMW 「산책이라고 생각하고 편하게 즐기지 않을래?」
			CASE 1
				PRINTFORML 「이렇게 하고 있으면 요리히메가 어렸을 때를 떠올린다」
				PRINTFORML 「그 아이는 어디에 가든 내 손을 잡았었어?」
				PRINTFORMDW 솔직히 상상조차 가지 않는다...
			CASE 2
				PRINTFORML 「저쪽으로 도착하면 뭘 할까요」
				PRINTFORML 「뭔가 재미있는 거라도 있으면 좋겠는데」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 긴장하고 있는 %조사처리(CALLNAME:MASTER,"를")% 안심시키려고 노력한다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
