		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SETCOLOR C_YELLOW
		IF FEINT
			PRINTFORM %LOCALS:(RAND:4)%
			RESETCOLOR
			PRINTFORM 하고 보이면서 %LOCALS:(3 - 正解)%
		ELSE
			PRINTFORM %LOCALS:(3 - 正解)%
			RESETCOLOR
		ENDIF
		PRINTFORML 저쪽으로부터의 공격!
		$LOOP_IKASAMA
		FOR LOCAL:10,0,4
		LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
		PRINTFORML [{LOCAL}] ｛로컬｝ - %LOCALS:LOCAL%에게 피한다
		NEXT
		SIF !イカサマ && BASE:MASTER:TSP > 500
			PRINTFORML [{4}] - 시간 정지
		TINPUT 制限時間, -1, 1
		IF RESULT == 正解
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 공격을 회피했다!
			CALL M_KOJO_COLOR_K99
			IF !イカサマ
				PRINTFORMDL ……………
				PRINTFORMDL ………
				PRINTFORMDW …
				PRINTFORML 「후우…… 이런 곳인가」
				PRINTFORMDL 완전히 숨을 몰아쉬고 있는 %조사처리(CALLNAME:MASTER,"에게")%, %조사처리(CALLNAME:TARGET,"는")% 태연했다.
