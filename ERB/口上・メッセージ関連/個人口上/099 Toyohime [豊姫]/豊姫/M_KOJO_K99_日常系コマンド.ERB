@M_KOJO_MESSAGE_COM_K99_436_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;判定
	SELECTCASE TFLAG:193
		;文学
		CASE 1,3
			;恋慕
			IF TALENT:恋慕
				PRINTFORML 「나의 추천 도서?」
				PRINTFORML 「음... 이거 어때?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 건네온 책 표지에는 %TEXTR("마법탐정 마리사/동방박월조/상어영화사전/")%라고 쓰여 있다.
				PRINTFORMW 「꽤 재미있으니까, 분명 당신도 마음에 들 거라고 생각해.」
				;それ以外
			ELSE
				PRINTFORML 「어머, 독서?」
				PRINTFORML 「나도 방해해도 될까」
				PRINTFORMDL 『부디』라고 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"는")% 맞은편 자리에 앉지 않고
				PRINTFORMDL 어째선지 %조사처리(CALLNAME:MASTER,"의")% 옆자리에 앉아 독서를 시작했다
				PRINTFORMDW 뭐랄까 거리가 가깝다…….
			ENDIF
			;実用書
		CASE 5
			;恋慕
			IF TALENT:恋慕
				PRINTFORML 「그런 책을 읽는 것보다 좋은 스승을 찾는 게 더 좋을 거라고 생각해.」
				PRINTFORML 「예를 들면? 음, 그렇네... 야이님은 어떠신가?」
				PRINTFORML 「달의 두뇌라고 불리는 그분께 가르침을 받는다면 틀릴 리 없어.」
				PRINTFORMW 「그것은 제 제자인 제가 보장하겠습니다.」
				;それ以外
			ELSE
				PRINTFORML 「지상의 기술도 제법 발전했나 보네……」
				PRINTFORML 「아무리 그래도 달의 기술에는 아직 멀었어.」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며 실용서를 탁 덮었다.
			ENDIF
			;薄い高い本
		CASE 6
			;恋慕
			IF TALENT:恋慕
				PRINTFORML 「시간을 멈추고 여자아이에게 그런 것들을…」
				PRINTFORMDL 놀란 %조사처리(CALLNAME:MASTER,"가")% 돌아보니
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 방긋 웃으며 자신을 보고 있었다
				PRINTFORML 「헤에, 당신은 그런 걸 좋아하는 거네」
				PRINTFORML 「다음에 시간 정지 놀이 같은 거 해볼래?」
				PRINTFORMDL 아무래도 능력을 들킨 건 아닌 것 같다
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 속으로 안도의 한숨을 내쉬었다……
				;それ以外
			ELSE
				PRINTFORML 「음... 이 책은 전에 읽었으니까...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 문학 작품들이 모여 있는 책장에 눈을 돌리고 있었다.
				PRINTFORMDW 지금 안에 몰래 읽어 버리자...
			ENDIF
			;保健体育
		CASE 7
			;恋慕
			IF TALENT:恋慕
				PRINTFORML 「크흡, 여자 몸이 신경 쓰이나?」
				PRINTFORML 「내가 손잡고, 원투원(one-to-one)으로 가르쳐 줄까?」
				PRINTFORMDW 귓가에서 그렇게 속삭여지자, %조사처리(CALLNAME:MASTER,"는")% 무심코 침을 삼켜버렸다……
				;それ以外
			ELSE
				PRINTFORML 「헤에, 여러 가지가 적혀 있네……」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 체육 교과서를 들고 있을 때
				PRINTFORMDL 어느새 %조사처리(CALLNAME:TARGET,"가")% 뒤에서 엿보고 있었다……
				PRINTFORML 「우후후, 부끄러워할 필요 없는데.」
				PRINTFORMW 「여자에게 흥미를 느끼는 건 남자라면 당연한 일이니까.」
			ENDIF
			;カーマスートラ
		CASE 8
			;恋慕
			IF TALENT:恋慕
				PRINTFORML 「당신이 바란다면, 이 책에 쓰여 있는 것들……」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 속삭인 %조사처리(CALLNAME:TARGET,"가")% 천천히 귓가로 입을 가져온다.
				CALL HPH_PRINT,@"「전부 해줘도 되지만... HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 유혹해 오는 바람에, %조사처리(CALLNAME:MASTER,"는")% 독서에 집중할 수 없었다……
				;それ以外
			ELSE
				PRINTFORML 「뭐랄까…… 이런 체위도 있는 거네」
				PRINTFORML 「이쪽 체위는…… 음, 허리를 다치게 될 것 같아……」
				PRINTFORML 「……아, 봐. 이거라면 할 수 있겠지?」
				PRINTFORMDW %CALLNAME:MASTER%옆에서 책을 엿보고 있는 %조사처리(CALLNAME:TARGET,"는")% 어쩐지 즐거워 보인다
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
