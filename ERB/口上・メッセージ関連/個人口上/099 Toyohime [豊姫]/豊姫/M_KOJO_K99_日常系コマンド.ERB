@M_KOJO_MESSAGE_COM_K99_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		PRINTFORML 
		RETURN 1
	ELSEIF FLAG:時間停止
		PRINTFORML 
		RETURN 1
	ELSEIF CFLAG:うふふ && SHIRAHU(TARGET)
		PRINTFORML 
		RETURN 1
		;通常
	ELSE
		;判定
		SELECTCASE TFLAG:193
			;見てるだけ
			CASE 0
				;汚れ高
				IF TFLAG:194 >= 3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「어떻게 이 정도로……」
							PRINTFORML 「여긴 이제 안 되겠네…… 정화해 버리자」
							PRINTFORMDW 주변 일대를 『정화』하려는 %조사처리(CALLNAME:TARGET,"를")% %조사처리(CALLNAME:MASTER,"는")% 황급히 막았다
						CASE 1
							PRINTFORML 「으윽... 컥, 컥」
							PRINTFORML 「미안해, 저쪽으로 가고 있어」
							PRINTFORMDW 피어오르는 더러운 냄새에 %조사처리(CALLNAME:TARGET,"는")% 목을 막은 것 같다.
						CASE 2
							PRINTFORML 「음... 기분이 좀...」
							PRINTFORML 「미안하지만, 나머지는 부탁할게.」
							PRINTFORMDW 먼지 냄새가 싫은 건지, %조사처리(CALLNAME:TARGET,"는")% 멀어져 갔다.
					ENDSELECT
					;汚れ中以下
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「사람이 부족하면 말해줘.」
							PRINTFORML 「한가해 보이는 토끼를 불러올 테니까.」
							PRINTFORMDW 아무래도 %조사처리(CALLNAME:TARGET,"는")% 도울 생각이 없는 것 같다.
						CASE 1
							PRINTFORML 「그럼大変でしょう? 자, 이걸 사용해」
							PRINTFORML 「이것은 달의 최신형 청소 도구야. 버튼을 누르는 것만으로 쓰레기를 빨아들여 준단다」
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 빌린 진공청소기 같은 것을 사용해 쓰레기를 빨아들였다
						CASE 2
							PRINTFORML 「정신이 드는군네」
							PRINTFORML 「지치면 여기에 앉아서 같이 복숭아라도 먹자」
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 태평하게 %조사처리(CALLNAME:MASTER,"의")% 청소를 보고 있다
					ENDSELECT
				ENDIF
				;一緒に掃除
			CASE 1
				;汚れ高
				IF TFLAG:194 >= 3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「이 부채는 숲을 순식간에 입자 수준으로 정화하는 바람을 일으킨다」
							PRINTFORML 「그런 달의 최신 병기를 상대로 당신은 무엇을 할 수 있지?」
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부채를 펼치면서 압도적인 양의 쓰레드에 말을 걸고 있다
						CASE 1
							PRINTFORML 「이렇게 더럽게 되어 있으면 수명이 줄어들 것 같아」
							PRINTFORML 「끝나면 목욕을 해서 몸을 정화해야지」
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 배려하면서 많은 쓰레기를 치웠다
						CASE 2
							PRINTFORML 「흐읍... 하아아...」
							PRINTFORML 「.........에취!」
							PRINTFORMDW 재채기만 해서 청소가 안 되니, %조사처리(CALLNAME:TARGET,"에게")% 쓰레기 배출을 부탁했다.
					ENDSELECT
					;汚れ中以下
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「달의 기술로라면, 이 정도는 아무것도 아니지」
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 달의 최신 청소 도구를 사용해 쓰레기를 빨아들이고 있다
						CASE 1
							PRINTFORML 「평소에는 토끼들에게 맡기고 있었지만……」
							PRINTFORMW 「가끔은 스스로 청소하는 것도 좋은 운동이 되겠네」
							PRINTFORMW
							PRINTFORMW 「후우...... 이런 건가.」
						CASE 2
							PRINTFORML 「자, 이제……아야야앗」
							PRINTFORML 「하아…… 익숙하지 않은 일을 했더니 허리가……」
							PRINTFORMW 「뭐, 아직 익숙하지 않을 뿐이야? 노인 취급 하지 말아줘?」
					ENDSELECT
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
