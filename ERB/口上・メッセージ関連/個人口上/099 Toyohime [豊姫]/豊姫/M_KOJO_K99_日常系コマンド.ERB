						PRINTFORMDL ………
						PRINTFORMDW …
						CALL ADD_SAMEN_V(99, 200)
						EXP:99:キス経験 += 3
						EXP:99:Ｃ経験 += 3
						EXP:99:Ｂ経験 += 3
						EXP:99:Ｖ経験 += 3
						EXP:99:Ｍ経験 += 3
						EXP:99:Ｖ性交経験 += 3
						EXP:99:絶頂経験 += 2
						EXP:99:精液経験 += 1
						EXP:99:膣射経験 += 1
					CASE 1
						PRINTFORML 「잘 자, %CHILDNAME:99:(TALENT:99:育児中)%」
						PRINTFORML 「후훗, %CALLNAME:MASTER%도 말이야」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 두 사람에게 잘 자는 키스를 하고 방의 불을 껐다
					CASE 2
						PRINTFORML 「스르륵…… 스르륵……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %CHILDNAME:99:(TALENT:99:育児中)%와 함께 평온한 숨을 쉬고 있다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 두 사람을 깨우지 않으려고 이불에서 빠져나와 방의 불을 껐다.
				ENDSELECT
		ENDSELECT
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음... 정말 이제 좋은 시간이네」
					PRINTFORMW 「잘 자요. %CALLNAME:MASTER%」
				CASE 1
					PRINTFORML 「벌써 잠들어 버릴 거야?」
					PRINTFORML 「……잠깐만 당신 곁에 있어도 괜찮아?」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"가")% 기쁜 듯 이불 속으로 파고들었다.
					PRINTFORML 「제대로 방에 돌아가서 자라고?」
					PRINTFORMW 「괜찮아~ 조금 있으면 제대로 돌아갈 테니까…… 아마도」
				CASE 2
					PRINTFORML 「잘 자요, %CALLNAME:MASTER%」
					PRINTFORML 「...또 내일 봐」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 불을 끄고 %조사처리(CALLNAME:MASTER,"의")% 방을 나섰다
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「벌써 주무실 거예요?」
					PRINTFORMW 「그럼, 저는 돌아갈게요.」
				CASE 1
					PRINTFORML 「자기 전에 꼭 양치하렴」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어머니 같은 말을 하고 돌아갔다
				CASE 2
					PRINTFORML 「그렇네, 나도 슬슬 자야겠어.」
					PRINTFORMW 「그럼 잘 자.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
