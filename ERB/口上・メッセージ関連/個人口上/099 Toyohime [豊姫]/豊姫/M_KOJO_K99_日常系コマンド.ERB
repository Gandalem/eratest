		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「음... 조용히 해... HPH」","L"
				CALL HPH_PRINT,@"「누군가에게 목소리가 들릴 테니까... HPH」","W"
			CASE 1
