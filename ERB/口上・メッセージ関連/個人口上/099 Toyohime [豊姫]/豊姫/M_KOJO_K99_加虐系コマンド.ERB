	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMDL 
		RETURN 1
		;通常
	ELSE
		;縛った時
		IF TEQUIP:縄
			;恋慕
			IF TALENT:恋慕
				;マゾっ気で分岐
				SELECTCASE ABL:マゾっ気
					;マゾっ気２以上
					CASE IS > 1
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「더 세게……응크윽 HPH 더 세게엣 HPH」","L"
								IF !CFLAG:99:1998
									PRINTFORMDL 더 세게 조이면 멍이 생겨버린다.
									PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 그렇게 말해도, %조사처리(CALLNAME:TARGET,"는")% 더욱한 고통을 원해왔다……
								ENDIF
							CASE 1
								CALL HPH_PRINT,@"「이제부터 무슨 일이 벌어질지 모르겠네……후후」","L"
								CALL HPH_PRINT,@"「억지로, 당신에게 더럽혀져... 하읍 HPH」","L"
								IF !CFLAG:99:1998
									PRINTFORMDL 「묶을 수 있게 되었어」라고 %조사처리(CALLNAME:MASTER,"가")% 엉덩이를 때리자
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 벌벌 떨며 몸을 떨었고, 가랑이에서 음액을 흘렸다……
								ENDIF
							CASE 2
								IF !CFLAG:99:1998
									PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 모범이 되는 거북이 묶기로 %조사처리(CALLNAME:TARGET,"를")% 묶어 올리고
									PRINTFORMDL 가랑이에 파고든 밧줄을 잡아당기며, 묶인 상태를 확인했다……
								ENDIF
								CALL HPH_PRINT,@"「윽, 으응 괜찮아... 아프지 않아...」","L"
								CALL HPH_PRINT,@"「저기... 다음엔 어떻게 할 거야...? HPH」","W"
						ENDSELECT
						;マゾっ気２未満
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「아파... 이런 건 자국이 남을 거야...」
								IF !CFLAG:99:1998
									PRINTFORMDL 신조차 빠져나올 수 없는 페무트 파이버의 밧줄로
									PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 단단히 묶었다.
								ENDIF
							CASE 1
								PRINTFORML 「저기, 저기... 역시 그만두죠...?」
								PRINTFORML 「뭐든지 해줄 테니까... 응?」
								IF !CFLAG:99:1998
									PRINTFORMDL 이런 일에 익숙하지 않은 %조사처리(CALLNAME:TARGET,"의")% 몸은 긴장으로 굳어있다.
									PRINTFORMDW 『상냥하게 해줄게』라고 말하면서 %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 밧줄로 묶었다.
								ENDIF
							CASE 2
								PRINTFORML 「이것도 귀중한 경험이야……」
								PRINTFORML 「응, 윽……이건, 뭘까……」
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 밧줄에 묶이는 쪽의 입장을 몸소 느끼고 있다.
						ENDSELECT
				ENDSELECT
				;それ以外
			ELSE
				;マゾっ気で分岐
				SELECTCASE ABL:マゾっ気
					;マゾっ気２以上
					CASE IS > 1
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「응흥 HPH 하아... 괜찮아... HPH」","L"
								CALL HPH_PRINT,@"「좀, 세게 잡았던 것뿐이니까... HPH」","L"
								IF !CFLAG:99:1998
									PRINTFORMDL 피부에 파고드는 밧줄의 통증에 %조사처리(CALLNAME:TARGET,"는")% 몸을 떨며 뜨거운 숨을 내쉬었다.
									PRINTFORMDW 불결한 자들의 출입을 막기 위한 밧줄은, 쾌락을 느끼기 위한 도구로 변해 있었다.
								ENDIF
							CASE 1
								CALL HPH_PRINT,@"「이거... 분명 멍이 생길 거야... HPH」","L"
								CALL HPH_PRINT,@"「아아... 요리히메에게 뭐라고 설명해야 할지... HPH」","L"
								IF !CFLAG:99:1998
									PRINTFORMDL 욕망을 위해 스스로 원해서 밧줄에 묶였다고 설명했을 때, 사랑하는 여동자에게 받는 차가운 시선…….
									PRINTFORMDL 경멸당할까. 모욕당할까. 입도 열어주지 않게 될까
									PRINTFORMDW 어느 쪽으로 돌아가든, 지금의 %CALLNAME:TARGET%에게는 보상일 뿐이었다
								ENDIF
							CASE 2
								CALL HPH_PRINT,@"「이것도, 하나의 사랑의 방식이구나... HPH」","L"
								IF !CFLAG:99:1998
									PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 묶여, 굴려진 %조사처리(CALLNAME:TARGET,"는")%
									PRINTFORMDW 무언가를 기대하는 듯 이곳을 바라보고 있다…….
								ENDIF
						ENDSELECT
						;マゾっ気２未満
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「누군가에게 묶이는 걸 보는 건 좋아하지만…….」
								PRINTFORML 「자신이 묶이는 건…… 좀……」
								IF !CFLAG:99:1998
									PRINTFORMDL 속박당하는 쪽의 기분을 알아주게 하겠다.
									PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 괴로운 듯이 %조사처리(CALLNAME:TARGET,"를")% 밧줄로 묶었다.
								ENDIF
							CASE 1
								PRINTFORML 「아, 윽... 밧줄이 파고들어...」
								IF !CFLAG:99:1998
									PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 움직이지 못하도록 단단히 구속하고 앉힌다.
									PRINTFORMDW 속박에 익숙하지 않은지, 몸은 경직되어 있었다.
								ENDIF
							CASE 2
								PRINTFORML 「더, 좀 더 느슨하게 할 수 없을까……?」
								PRINTFORML 「그게, 자국이 남을 테니까……」
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 별로 흥미가 없는 것 같다……
						ENDSELECT
				ENDSELECT
			ENDIF
			;解いた時
		ELSE
			;マゾっ気で分岐
			SELECTCASE ABL:マゾっ気
				;マゾっ気２以上
				CASE IS > 1
					CALL HPH_PRINT,@"「다음엔 당신도 묶어 드릴까요...? HPH」","L"
					CALL HPH_PRINT,@"「자... 사양하지 마세요... HPH」","L"
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 순수한 선의로 %조사처리(CALLNAME:MASTER,"를")% 묶으려고 하고 있다. 정중히 거절했다.
					;マゾっ気２未満
				CASEELSE
					PRINTFORML 「하아... 이 흔적, 사라질까...」
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 피부에 남은 밧줄 자국을 손으로 문지고 있다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
