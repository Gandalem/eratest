; Modular ERB: 個人口上/099 Toyohime [豊姫]/豊姫/M_KOJO_K99_加虐系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;加虐系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;100,スパンキング
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_100
RETURN 0

@M_KOJO_MESSAGE_COM_K99_100
CALL M_KOJO_MESSAGE_COM_K99_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMDL 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			;マゾっ気で分岐
			SELECTCASE ABL:マゾっ気
				;マゾっ気２以上
				CASE IS > 1
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「쿠운! 흐읍 하아!」","L"
							IF !CFLAG:99:1998
								PRINTFORMDL 찰싹, 하고 엉덩이를 때릴 때마다 %조사처리(CALLNAME:TARGET,"가")% 달콤한 신음을 흘린다.
								PRINTFORMDW 학대의 희열에 눈을 뜬 %조사처리(CALLNAME:TARGET,"의")% 몸은 고통을 기분 좋은 것으로 인식하고 있었다……
							ENDIF
						CASE 1
							CALL HPH_PRINT,@"「응, 윽 HPH 더, 때려줘... 윽 HPH」","L"
							CALL HPH_PRINT,@"「기분 풀릴 때까지, 더......! 후헵 우앗후헵」","L"
							IF !CFLAG:99:1998
								PRINTFORMDL 몇 번이고 얻어맞고, 부어오른 부분에서 새어 나오는 타는 듯한 고통
								PRINTFORMDW 이 고통이야말로 %조사처리(CALLNAME:TARGET,"가")% 원했던 것이었어……
							ENDIF
						CASE 2
							CALL HPH_PRINT,@"「안, 안 돼... HPH 그렇게 크게 휘두르면...」","L"
							CALL HPH_PRINT,@"「제 엉덩이... 부서져, 우응응ㅎㅍㅎ ㅎㅍㅎ」","L"
							SIF !CFLAG:99:1998
								PRINTFORMDL 팔을 채찍처럼 휘게 하여, 전신의 힘으로 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 내리친다.
							CALL HPH_PRINT,@"「하아... 하아...윽 HPH 아... 아아...윽 HPH」","L"
							SIF !CFLAG:99:1998
								PRINTFORMDW 하얀 피부와 붉은 멍의 대비는 마치 복숭아처럼 아름답다…….
					ENDSELECT
					;マゾっ気２未満
				CASEELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「크윽! 아프지만……!」
							PRINTFORML 「괜찮아…… 계속해줘…… 응응!」
							SIF !CFLAG:99:1998
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈에 눈물을 글썽이면서도, %조사처리(CALLNAME:MASTER,"의")% 행위를 받아들이고 있다...
						CASE 1
							PRINTFORML 「괜찮아…… 망설이지 않아도 돼……」
							PRINTFORML 「응윽! 응, 더…… 으응!」
							IF !CFLAG:99:1998
								PRINTFORMDL 당당하게 행동하는 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 %조사처리(CALLNAME:MASTER,"는")% 가차 없이 계속 때렸다.
								PRINTFORMDW 보는 이를 매료시키는 모양 좋은 복숭아 같은 엉덩이는, 아프게 부풀어 올라있다……
							ENDIF
						CASE 2
							PRINTFORML 「하아... 하아...」
							PRINTFORML 「이제... 괜찮은 거야...?」
							SIF !CFLAG:99:1998
								PRINTFORMDW 아프게 부어오른 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를, %조사처리(CALLNAME:MASTER,"는")% 상냥하게 쓰다듬어 주었다...
					ENDSELECT
			ENDSELECT
			;それ以外
		ELSE
			;マゾっ気で分岐
			SELECTCASE ABL:マゾっ気
				;マゾっ気２以上
				CASE IS > 1
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응응! 더, 세게……윽!」","L"
							CALL HPH_PRINT,@"「나를... 아프게 해줘... 윽, 끅」","L"
							IF !CFLAG:99:1998
								PRINTFORMDL 완전히 이런 것이 너무 좋아져 버린 %조사처리(CALLNAME:TARGET,"의")% 요구에 따라
								PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그녀의 엉덩이를, 그녀가 만족할 때까지 계속 때려주었다……
							ENDIF
						CASE 1
							CALL HPH_PRINT,@"「크윽! 후우! 음으!」","L"
							IF !CFLAG:99:1998
								PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 맞을 때마다, %조사처리(CALLNAME:TARGET,"는")% 기분 좋아 보이는 소리를 내고 있다.
								PRINTFORMDW 원래 재능이 있었던 걸까. %조사처리(CALLNAME:TARGET,"의")% 몸은 순순히 고통을 받아들이게 되어 있었다.
							ENDIF
						CASE 2
							CALL HPH_PRINT,@"「안 돼... 부드럽게 해주지 마세요... 큭!」","L"
							CALL HPH_PRINT,@"「아프지 않으면 기분 좋아질 수 없어... 큭흐」","L"
							IF !CFLAG:99:1998
								PRINTFORMDL 엉덩이가 빨개질 때까지 때려줬는데, 아직 부족하다고 %조사처리(CALLNAME:TARGET,"가")% 말한다.
								PRINTFORMDW 그렇다면 봐줄 필요는 없다고, %조사처리(CALLNAME:MASTER,"는")% 온 힘을 다해 그녀의 엉덩이를 내리쳤다.
							ENDIF
					ENDSELECT
					;マゾっ気２未満
				CASEELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「흐윽...... 으으......」
							PRINTFORML 「너무하잖아... 갑자기 때기라니...」
							SIF !CFLAG:99:1998
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 엉덩이에는, %조사처리(CALLNAME:MASTER,"의")% 손자국이 선명하게 남아있다…….
						CASE 1
							PRINTFORML 「야이님께도 맞은 적 없는데...... 으응!」
							IF !CFLAG:99:1998
								PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 엉덩이를 때릴 때마다 건조한 소리가 주변에 울린다.
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 입술을 꾹 깨물며 고통을 참는다……
							ENDIF
						CASE 2
							PRINTFORML 「아파... 으윽! 끅! 아앗!」
							IF !CFLAG:99:1998
								PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"가")% 도망가지 못하도록 허리를 잡자
								PRINTFORMDW 그녀의 엉덩이를 가차 없이 여러 번 때렸다...
							ENDIF
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
