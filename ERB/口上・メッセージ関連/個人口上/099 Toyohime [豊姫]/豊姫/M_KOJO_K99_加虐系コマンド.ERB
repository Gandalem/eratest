;==================================================
;104,アイマスク
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K99_104
RETURN 0

@M_KOJO_MESSAGE_COM_K99_104
CALL M_KOJO_MESSAGE_COM_K99_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K99_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMDL 
		RETURN 1
		;通常
	ELSE
		;装着
		IF TEQUIP:アイマスク
			;恋慕
			IF TALENT:恋慕
				;マゾっ気で分岐
				SELECTCASE ABL:マゾっ気
					;マゾっ気２以上
					CASE IS > 1
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「아... 잠깐, 말하지 마요... HPH」","L"
								CALL HPH_PRINT,@"「무엇을 당할지 모르는 쪽이 두근거리니까…… HPH」","L"
								SIF !CFLAG:99:1998
									PRINTFORMDW 자발적으로 아이마스크를 착용한 %조사처리(CALLNAME:TARGET,"는")% 흥분한 모습으로 다음에 행해질 행위를 기다리고 있다…….
							CASE 1
								CALL HPH_PRINT,@"「이거... 아무것도 보이지 않아서... 흐읍」","L"
								CALL HPH_PRINT,@"「정말... 흥분해버려... HPH」","L"
								IF !CFLAG:99:1998
									PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 무슨 일이 일어날지 모른다는 공포에 거친 숨을 몰아쉬고 있다.
									PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 귓가에서 일부러 큰 소리를 내며 위협하면
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 움찔 몸을 떨며, 가랑이에서 흥분의 달콤한 액체를 흘렸다……
								ENDIF
							CASE 2
								SIF !CFLAG:99:1998
									PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아이마스크를 착용한%조사처리(CALLNAME:TARGET,"를")% 끌어안고, 그녀의 목덜미를 질척하게 핥았다.
								CALL HPH_PRINT,@"「흐읍! HPH 음... 후우... 윽 HPH」","L"
								CALL HPH_PRINT,@"「보이지 않으니까... 감각이 예민해져서... HPH」","L"
								CALL HPH_PRINT,@"「하아... HPH 이상해질 것 같아... HPH」","W"
						ENDSELECT
						;マゾっ気２未満
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「나는... 당신의 얼굴을 보면서 하는 편이 더 좋은 것 같아...」
								SIF !CFLAG:99:1998
									PRINTFORMDW 눈가리개를 착용한 %조사처리(CALLNAME:TARGET,"는")% 조금 불만스러운 듯하다.
							CASE 1
								PRINTFORML 「......저기, 역시 벗어도 괜찮을까?」
								PRINTFORML 「당신의 얼굴이 보이지 않는 건...... 조금 무서워.」
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 겁을 먹고 있다. 그 모습이 %조사처리(CALLNAME:MASTER,"의")% 가학심을 부추겼다.
							CASE 2
								PRINTFORML 「이걸로 괜찮은 거지. %CALLNAME:MASTER%」
								PRINTFORML 「……%CALLNAME:MASTER%？」
								PRINTFORML 「있잖아, 왜 말 없는 거야?」
								SIF !CFLAG:99:1998
									PRINTFORMDW 잠시 동안 침묵하며 상황을 지켜보고 있었지만, %조사처리(CALLNAME:TARGET,"는")% 정말 자극적인 반응을 보여주었다.
						ENDSELECT
				ENDSELECT
				;それ以外
			ELSE
				;マゾっ気で分岐
				SELECTCASE ABL:マゾっ気
					;マゾっ気２以上
					CASE IS > 1
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@"「눈가리개를 벗고, 만약 당신이 사라졌다면... HPH」","L"
								CALL HPH_PRINT,@"「……아앗 HPH 그거 정말 흥분하게 해버려……HPH」","L"
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 망상을 부리며 가슴을 적시고 있다. 정말로 방치해 줄까...
							CASE 1
								CALL HPH_PRINT,@"「자, 다음엔 뭘 해주실지 모르겠네... HPH」","L"
								CALL HPH_PRINT,@"「우후훗 흥분된다……흥」","L"
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 다음에 행해질 행위에 기대를 부풀리고 있다……
							CASE 2
								CALL HPH_PRINT,@"「음... 잠깐 기다려줘... HPH」","L"
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 눈가리개를 쓰도록 지시하자, %조사처리(CALLNAME:TARGET,"는")% 순순히 따랐다.
						ENDSELECT
						;マゾっ気２未満
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「이걸 쓰면 되는 거야?」
								PRINTFORML 「……응, 깜깜해서 아무것도 안 보여」
								PRINTFORMW 「있어, 아직 거기 있어?」
							CASE 1
								PRINTFORML 「후후, 깜깜하네. 어릴 적 요리히메와 탐험했던 날이 생각나.」
								PRINTFORML 「캄캄한 방에 갇혀서... 그 아이 울었나?」
								SIF !CFLAG:99:1998
									PRINTFORMDW 추억 이야기도 적당히 하고, %조사처리(CALLNAME:MASTER,"는")% 행위를 재개했다.
							CASE 2
								PRINTFORML 「이걸 쓰면 잠들 것 같아……」
								PRINTFORML 「하아…… 혹시 잠들어 버리면 깨워줘……」
								SIF !CFLAG:99:1998
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 이미 졸린 듯하고 있다.
						ENDSELECT
				ENDSELECT
			ENDIF
			;解除
		ELSE
			;マゾっ気で分岐
			SELECTCASE ABL:マゾっ気
				;マゾっ気２以上
				CASE IS > 1
					CALL HPH_PRINT,@"「얼굴을 보면서 하는 것도 좋지만... HPH」","L"
					CALL HPH_PRINT,@"「가끔은 이런 것도 나쁘지 않네…… HPH」","W"
					;マゾっ気２未満
				CASEELSE
					PRINTFORML 「응, 눈부시다……」
					SIF !CFLAG:99:1998
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈을 깜빡이고 있다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
