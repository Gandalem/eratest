@M_KOJO_MESSAGE_PALAMCNG_A_K99_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;挿入時射精のみ表示
	IF TCVAR:MASTER:12 == 1 || TCVAR:MASTER:12 == 2
		PRINTL 
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「엄청난 사정이야... HPH」","L"
					CALL HPH_PRINT,@"「그렇게 기분 좋았어...? HPH」","L"
					PRINTFORMDW 허리가 빠질 듯이. 그렇게 말하고, %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 키스했다
				CASE 1
					CALL HPH_PRINT,@"「이렇게 사정했는데, 당신의 거시기(오친칭)는 아직 건강해 보이네... HPH」","L"
					CALL HPH_PRINT,@"「저기…… 한 번 더 해요……? HPH」","L"
					PRINTFORMDW 그렇게 말하는 %CALLNAME:TARGET%도, 아직은 건강해 보인다…….
				CASE 2
					CALL HPH_PRINT,@"「당신이 너무 대단해서... 고무하던 것도 잊고 있었어... HPH」","L"
					PRINTFORMDL 빵빵하게 부풀어 오른 콘돔을 손가락으로 건드리는 %CALLNAME:TARGET%
					PRINTFORMDW 「한 번 더 할까?」라고 말하자, %조사처리(CALLNAME:TARGET,"는")% 미소 지으며 다리를 벌렸다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아…… 하아…… 흐읍」","L"
					CALL HPH_PRINT,@"「이렇게 많이…… HPH」","L"
					PRINTFORMDW 가득 정액이 찬 콘돔을 보이며, %조사처리(CALLNAME:TARGET,"는")% 만족스러운 듯 미소 지었다.
				CASE 1
					CALL HPH_PRINT,@"「응으음……읏큭」","L"
					PRINTFORMDL 방금까지 페니스를 박고 있던 살구멍을 자세히 관찰한다.
					PRINTFORMDW 충분히 부어줄 수 있을 줄 알았는데. 그렇게 항의하듯이, 그곳은 움찔움찔 떨리고 있었다.
				CASE 2
					PRINTFORMDL 정액이 찬 콘돔을 %조사처리(CALLNAME:TARGET,"의")% 손바닥 위에 올려 놓는다.
					CALL HPH_PRINT,@"「후훗, 아직 따뜻해... HPH」","L"
					PRINTFORMDW 그것을 보는 %조사처리(CALLNAME:TARGET,"의")% 표정은, 어쩐지 기뻐 보인다……
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
