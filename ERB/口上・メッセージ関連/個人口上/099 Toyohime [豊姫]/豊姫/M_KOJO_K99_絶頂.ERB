				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 입가에 %조사처리(CALLNAME:MASTER,"의")% 음모를 끼운 채, 평소처럼 미소 지었다.
			CASE 2
				CALL HPH_PRINT,@"「큭... 후후... HPH」","L"
				CALL HPH_PRINT,@"「죄송해요. 나도 모르게... HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 정액의 냄새가 나는 트림을 하자 부끄러운 듯 웃었다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「음윽……하아……잘 먹었습니다……♪」
				PRINTFORMDL 입을 열고, 전부 마셨다는 것을 어필하는 %CALLNAME:TARGET%
				PRINTFORMDW 분명 지금쯤 그녀의 위 속에서는 삼킨 정액이 소화되기 시작하고 있을 것이다……
			CASE 1
				PRINTFORML 「――음, 맛은 어때?」
