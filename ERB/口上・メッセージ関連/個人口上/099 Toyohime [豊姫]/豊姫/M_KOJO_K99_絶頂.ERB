LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTL 
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「안 돼, 이제...윽 HPH」","L"
				PRINTFORMDL 한 번 더를 원하며 무의식적으로 몸에 뻗는 손
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그것을 가져, 귀 옆에서 참으라는 듯 속삭였다.
			CASE 1
				CALL HPH_PRINT,@"「흥분해버렸어...흐읍 아, 에...?」","L"
				PRINTFORMDW 「どうして?」と言いたげに、%조사처리(CALLNAME:TARGET,"는")% 눈을 촉촉하게 적시고 있다……
			CASE 2
				CALL HPH_PRINT,@"「부탁이야...... 가게 해줘......! HPH」","L"
				CALL HPH_PRINT,@"「나... 이제 한계야...윽 HPH」","W"
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「아아... 이제... 끅 HPH」","L"
				CALL HPH_PRINT,@"「아직 조금 남았었는데......큭」","W"
			CASE 1
				CALL HPH_PRINT,@"「야... 재촉하지 마... 헉」","L"
				CALL HPH_PRINT,@"「조금만 더… 조금만 더… 흐읍」","W"
			CASE 2
				CALL HPH_PRINT,@"「저, 여기... 벌써 갈 것 같으니까... 큭흐」","L"
				CALL HPH_PRINT,@"「같이 기분 좋아지자...? HPH 하지...?」","W"
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
