; Modular ERB: 個人口上/099 Toyohime [豊姫]/豊姫/M_KOJO_K99_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K99_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「가끔은 운동해야지.」
			CASE 1
				PRINTFORMW 「이게 끝나면 간식 먹을까요?」
			CASE 2
				PRINTFORMW 「얕은 것들이여. 나와 한판 겨루겠느냐」
		ENDSELECT
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		;豊姫の残機で分岐
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 「꺄악!?」
				PRINTFORMDW 피격당한 %조사처리(CALLNAME:TARGET,"의")% 옷이 조금 찢어졌다
			CASE 2
				PRINTFORML 「이런 일이라니……」
				PRINTFORMDW 피격한 %조사처리(CALLNAME:TARGET,"의")% 옷이 더 찢어졌다.
			CASE 1
				PRINTFORML 「설마, 그럴 리가……!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 말이 줄어들었다. 옷도 상당히 찢어져 왔다
			CASE 0
				PRINTFORML 「캬후욱!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 직격한 탄환이 그녀의 옷을 대대적으로 갈가리 찢었다...!
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;あなたが被弾から復帰時にボムをマイナスする効果
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		;豊姫の残機で分岐
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 「지상에 살고, 숨 쉬고, 죽는 것」
				PRINTFORMW 「그것만으로 죄인인 것입니다」
			CASE 3
				PRINTFORML 「자만심을 부풀리는 것」
				PRINTFORMW 「교만해 있으면 큰 망신을 당하게 되니 조심하라는 것이다.」
			CASE 2
				PRINTFORMW 「이런 때, 야쿠시님이라면 즉단으로...」
			CASE 1
				PRINTFORMW 「………」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;豊姫が一定確率でボムを使った時の効果
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		;豊姫の残機で分岐
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 「저도 지상의 인간을 따라 해 볼까요」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 포켓에서 스페루카드를 꺼내 %조사처리(CALLNAME:MASTER,"에게")% 내밀었다
			CASE 3
				PRINTFORML 「즐겁네. 탄막 놀이 같은 거.」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 스펠카드를 발동하자, 대량의 탄막이 전개되었다...!
			CASE 2
				PRINTFORML 「자, 어떻게 될까요!」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 탄막과 %조사처리(CALLNAME:TARGET,"의")% 탄막이 부딪친다...!
			CASE 1
				PRINTFORML 「………윽」
				PRINTFORMDW 궁지에 몰린 %조사처리(CALLNAME:TARGET,"는")% 망설임 없이 스펠카드를 발동했다.
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ダイス差が一定以下の時に被弾を防ぐ効果
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		;豊姫の残機で分岐
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 「이 부채는 탄막을 순식간에 기본 입자 수준에서 정화하는 바람을 일으킨다」
				PRINTFORMW 「그런 달의 최신 병기에 맞서 당신은 무엇을 할 수 있겠어?」
			CASE 3
				PRINTFORML 「하아!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 부채로 부치자, %조사처리(CALLNAME:MASTER,"의")% 탄막이 흔적도 없이 소멸했다.
			CASE 2
				PRINTFORMW 「후우... 탄막만을 정화하는 건 힘들다니까.」
			CASE 1
				PRINTFORMW 「……자, 다시 시작해볼까」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;豊姫の残機で分岐
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 「어라, 벌써 끝난 거야?」
				PRINTFORMDW 눈 깜짝할 사이에 승부가 나버렸다. 이렇게 차이가 날 줄은 몰랐다...
			CASE 3
				PRINTFORML 「괜찮아? 다친 데는 없어?」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 강한 척을 하자, %조사처리(CALLNAME:TARGET,"의")% 표정이 스르르 부드러워졌다.
				PRINTFORMW 「...후훗, 강하구나.」
			CASE 2
				PRINTFORML 「하아... 이렇게 운동한 건... 하아... 오랜만이야...」
				PRINTFORMW 「에? 한 번 더? 으윽... 다음으로 미루는 건 어때?」
			CASE 1
				PRINTFORML 「……죄송해요. 좀 유치했나요?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 두들겨 맞고 말았어요. 더 강해져야 하는데……
			CASE 0
				PRINTFORML 「이런 모습, 요리히메에게는 보여줄 수 없어...」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 통통하게 나온 가슴을 손으로 가리고 있다.
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
