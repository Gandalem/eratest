;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K134_150
CALL M_KOJO_MESSAGE_COM_K134_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K134_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「저기, 갑자기 박는 건 안 돼요 HPH」","L"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「가슴에 잔뜩 안에 싸줘~ HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「가슴이 오나홀에 흥분해버린 거예요 HPH 점점 커지고 있어요오 HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「이제! 너무 거칠잖아요 HPH」","L"
		ENDIF
		;胸3以上
	ELSEIF ABL:胸 > 2
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「미요이의 가슴으로 기분 좋아져 주세요네에 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응 후훗 가슴 기분 좋아용? 후훗」","L"
		ELSE
			CALL HPH_PRINT,@"「마음껏 사정해 주세요 HPH」","L"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응응 흐으 기분 좋아용? 흐으」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「가슴 많이 범해 주세요 HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「너무 거칠게 하지 말아 주세요 HPH」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
