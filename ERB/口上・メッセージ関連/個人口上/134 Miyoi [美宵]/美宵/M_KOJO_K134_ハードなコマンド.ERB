;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K134_140
CALL M_KOJO_MESSAGE_COM_K134_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K134_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「응! 응으음~~!」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응응흐으읍」","L"
			PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"에게")% 성기를 박히며 신음하고 있다.
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응 흐으읍흐읍」","L"
			PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"에게")% 성기를 박히며 신음하고 있다.
		ELSE
			CALL HPH_PRINT,@"「응응! 흐으응! 응응! 흐으응!」","L"
			PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"에게")% 성기를 박히며 신음하고 있다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응으~!!」
			PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 찔리며 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응~~!!!」
			PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 박히며 신음하고 있다.
		ELSE
			PRINTFORMW 「응!!!」
			PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 박히고 신음하고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
