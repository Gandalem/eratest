	;ハロウィン
ELSEIF DAY:2 == 3 && DAY:3 == 30
	IF TALENT:恋人
		PRINTFORMW 「%CALLNAME:MASTER%씨, 트릭 오어 트리트!」
		PRINTFORMDW 미요이가 %조사처리(CALLNAME:MASTER,"에게")% 말을 건다.
		CALL HPH_PRINT,@"「오늘은 어떤 장난을 쳐볼까요 HPH」","L"
	ELSEIF TALENT:恋慕
		PRINTFORMW 「트릭 오어 트릿♪」
		PRINTFORMDW 미요이는 그렇게 말하며 말을 걸어왔다.
		PRINTFORMW 「%CALLNAME:MASTER%님, 장난칠 거예요♪」
	ELSEIF TALENT:思慕
		PRINTFORMW 「트릭 오어 트릿♪」
		PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 어깨에 손을 두른 채 중얼거렸다.
		PRINTFORMW 「%CALLNAME:MASTER%씨, 장난칠 거예요~♪」
	ELSE
		PRINTFORMW 「트릭 오어 트릿♪」
		PRINTFORMDW 미요이가 그렇게 말하며 위협해 왔다.
		PRINTFORMW 「오늘은 어떤 장난을 쳐볼까아~♪」
	ENDIF
	;クリスマス
ELSEIF DAY:2 == 4 && DAY:3 == 25
	IF TALENT:恋人
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%씨, 메리 크리스마스 HPH」","L"
