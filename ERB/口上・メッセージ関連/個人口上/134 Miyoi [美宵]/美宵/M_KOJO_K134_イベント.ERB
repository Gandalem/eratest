@M_KOJO_SPEVENT_K134_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
CALL M_KOJO_COLOR_K134
IF LOCAL
	PRINTFORMW 「%CALLNAME:MASTER%씨, 정말 즐거운 하루였어요」
	PRINTFORMDW 미요이는 그렇게 말하며 뒤돌아 자신을 향해 돌아섰다.
	PRINTFORMW 「……하나만 더 부탁해도 될까요?」
	PRINTFORMDW 이내 미요이는 고개를 들고 %조사처리(CALLNAME:MASTER,"에게")% 입을 맞추었다.
	PRINTFORMW 「응읏……」
	PRINTFORMW 「……오늘 일, 잊지 말아 주세요」
	PRINTFORMDW 그녀는 그렇게 말하고 작별을 고했다.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K134_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1130)
			PRINTFORMW 「%CALLNAME:MASTER%씨, 드릴 말씀이 있는데요」
			PRINTFORMDW 미요이는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 말을 걸어왔다.
			PRINTFORMW 「저, 좋아하는 사람이 생겼어요!」
			PRINTFORMW 「그 사람은 정말 다정하고 따뜻해서, 함께 있으면 즐거웠거든요」
			PRINTFORMW 「게다가 어딘가 저를 신경 써주는 특별한 사람이랄까요」
			PRINTFORMW 「그래서 저는 그 사람과 사귀고 싶다는 생각이 들었어요」
			PRINTFORMW 「%CALLNAME:MASTER%씨, 저랑 연인이 되어주실 수 없을까요?」
			PRINTFORMW 「저, %CALLNAME:MASTER%씨랑 함께 있을 수만 있다면 뭐든지 할 거예요!」
			PRINTFORMW 「……그러니까 부디, 평생 저를 잊지 말아 주세요……?」
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 저에게 부끄러운 일 시키지 말아 주세요」
			PRINTFORMDW 미요이는 가슴에 손을 대고 각오를 다진 듯 말을 이었다.
			PRINTFORMW 「사랑하고 있어요……저와 사귀어 주시겠어요?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「후후, 긴장되는 것들이네요, 이런 건」
		PRINTFORMDW 미요이는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 목에 손을 감고 안기는 자세가 되었다.
		PRINTFORMW 「응……」
		PRINTFORMDW 그대로 %조사처리(CALLNAME:MASTER,"의")% 입술에 키스를 하고
		PRINTFORMW 「맹세의 키스예요, 배신하지 말아 주세요, %CALLNAME:MASTER%」
		PRINTFORMDW 그렇게 요염하게 미소 지었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……후회하게 될 거예요, %CALLNAME:MASTER%」
		PRINTFORMDW 미요이는 살짝 어두운 미소를 띠고 있다.
		PRINTFORMW (내 뜻대로 되지 않으니까, 좋아져서 흥분하는 걸까?)
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K134_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……」
			PRINTFORMDW 미요이는 아무 말 없이 분노하며 돌아갔다.
		ELSEIF TALENT:恋人
			CALL HPH_PRINT,@"「내일도 또 만나자, HPH」","L"
			CALL HPH_PRINT,@"「약속, 잊지 말아줘 HPH」","L"
		ELSEIF TALENT:恋慕
			CALL HPH_PRINT,@"「내일 또 데이트하자 HPH」","L"
		ELSEIF TALENT:思慕
			CALL HPH_PRINT,@"「오늘은 즐거운 하루였네요 HPH」","L"
		ELSE
			PRINTFORMW 「내일 또 만날 수 있으면 좋겠네요」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K134_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	IF FIRSTTIME("遭遇") && CFLAG:1134 == 1
		PRINTFORMW 「아, 당신은 분명……」
		PRINTFORMDW	갑작스럽게 분홍 머리의 소녀가 말을 걸어왔다.
		PRINTFORMW 「기억났어요! 예전에 가게에 와주셨던 분이시죠?」
		PRINTFORMW 「저는 오쿠노다 미요이라고 해요, '계룡정'의 간판 소녀예요」
		PRINTFORMW 「꼭 기억해 주세요, 약속이에요?」
		;今日会ってない。
	ELSEIF !TCVAR:134:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:134:今日会ったか && (DAY - CFLAG:134:最後に会った日 >= 7) && CFLAG:好感度 >= 1500 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「앗 %CALLNAME:MASTER%씨! 어서 오세요~」
				CALL HPH_PRINT,@"「모-! 미요이 일 저한테 잊으신 건가 했거든요 HPH」","L"
				CFLAG:134:1002 = 1
			ELSEIF CFLAG:行動 == 5 && !TCVAR:134:今日会ったか && CFLAG:好感度 >= 1500 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「어서 오세요~! 아앗 %CALLNAME:MASTER%씨! 오늘도 와 주셨네요♪」
			ELSEIF CFLAG:行動 == 5 && !TCVAR:134:今日会ったか && (DAY - CFLAG:134:最後に会った日 >= 7) && CFLAG:好感度 >= 500 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「앗 %CALLNAME:MASTER%씨! 오랜만이에요! 잘 지내셨어요?」
				CFLAG:134:1002 = 1
			ELSEIF CFLAG:行動 == 5 && !TCVAR:134:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「어서 오세요~! 주문은 정하셨나요~?」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K134
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「……가까이 오지 말아 줄래요?」
					;屋外かつ満月
				ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					PRINTFORMW 「달이 참 예쁜 밤이네요……」
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%씨, 저를 잊지 말아 줘……」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「……방금 한 얘기는, 잊어주세요」
					ENDIF
					;台風
				ELSEIF FLAG:異常気象 == 9
					PRINTFORMW 「%CALLNAME:MASTER%씨, 오늘은 태풍이 오고 있어요」
					IF TALENT:恋人
						CALL HPH_PRINT,@"「그러니까 둘이서 느긋하게 보내자구 HPH」","L"
					ENDIF
					;猛吹雪
				ELSEIF FLAG:異常気象 == 10
					PRINTFORMW 「%CALLNAME:MASTER%씨, 오늘은 눈보라가 치네요」
					IF TALENT:恋人
						CALL HPH_PRINT,@"「내가 제대로 따뜻하게 해 줄 테니까 안심해 줘 HPH」","L"
					ELSEIF TALENT:恋慕
						CALL HPH_PRINT,@"「그러니까 같이 몸 녹이자 HPH」","L"
					ENDIF
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「아, 안녕, %CALLNAME:MASTER%씨」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%님」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%씨」
					ENDIF
					IF (DAY - CFLAG:134:最後に会った日 >= 7)
						IF TALENT:恋人
							PRINTFORMW 「이제! 미요이를 잊어버린 건가 싶었어요 HPH」
							PRINTFORMDW 미요이는 작게 양손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
							CFLAG:134:1002 = 1
						ELSEIF TALENT:恋慕
							PRINTFORMW 「계속 보고 싶었단 말이에요 HPH」
							PRINTFORMDW 미요이는 작게 양손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
							CFLAG:134:1002 = 1
						ELSEIF TALENT:思慕
							PRINTFORMW 「오랜만이네요, 잘 지내셨어요?」
							CFLAG:134:1002 = 1
						ENDIF
					ELSE
						IF TALENT:恋人
							CALL HPH_PRINT,@"「오늘도 좋은 하루로 만들어요, HPH」","L"
							PRINTFORMDW 미요이는 작게 두 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
						ELSEIF TALENT:恋慕
							CALL HPH_PRINT,@"「오늘도 좋은 하루였으면 좋겠네요 HPH」","L"
							PRINTFORMDW 미요이는 작게 두 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
						ELSEIF TALENT:思慕
							PRINTFORMW 「뭔가 용무 있으신가요?」
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
