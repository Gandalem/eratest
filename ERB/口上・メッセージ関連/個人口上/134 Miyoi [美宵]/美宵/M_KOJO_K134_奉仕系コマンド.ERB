;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K134_80
CALL M_KOJO_MESSAGE_COM_K134_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K134_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「미요이가 잔뜩 기분 좋게 해 드릴 테니까 말이야 HPH」","L"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「거시기 씨 기분 좋아져도 괜찮아요 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「야한 술 잔뜩 내주세요~ HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「벌써 손으로 사정할 것 같으신 거예요? 참을 수 없는 나쁜 거시기네요 HPH」","L"
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「의외로 나, 손으로 하는 거 잘할지도 몰라 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응읏... 흐으, 이럴 때가 좋아요...?」","L"
		ELSE
			CALL HPH_PRINT,@"「참지 않아도 괜찮으니까 HPH 마음껏 뿌려주세요, HPH」","L"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「이런 식으로 비벼주면 돼? 기분 좋아?」
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「평소에는 혼자 자위하고 계셨어요? 그럼 오늘은 미요이가 자위 서비스 해 드릴게요 HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「지금 손으로 깨끗하게 기분 좋게 해 드릴게요, HPH」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
