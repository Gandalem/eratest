@M_KOJO_MESSAGE_SCOM_K134_1
CALL M_KOJO_MESSAGE_SCOM_K134_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K134_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		CALL HPH_PRINT,@"「누가 먼저 절정에 도달할 수 있는지 내기하자, HPH」","L"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「응? 음ㅁ~ 하으읍」","L"
				PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 부추기고 있다.
				CALL HPH_PRINT,@"(조금만 더 있으면 맛있는 탱글탱글한 정액이 잔뜩 나올 것 같아……후훗)","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「응흐읍헵츄윽헵」","L"
				CALL HPH_PRINT,@"「참을 수 없는 탱글탱글한 거시기에서 나오는 정액, 미요이 입안에 가득 사정해 주세요 HPH」","L"
				PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 부추기고 있다.
			ELSE
				CALL HPH_PRINT,@"「응응! HPH 거시기 단단하게 굳어오고 있어요, HPH」","L"
				PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 부추기고 있다.
				CALL HPH_PRINT,@"(진한 정액을 빨리 마시고 싶네 HPH)","L"
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응응」
				PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하자 능숙한 혀놀림으로 그것을 재촉하고 있다.
				CALL HPH_PRINT,@"「벌써 사정할 것 같을 정도로 딱딱해졌네요 HPH」","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「응응흐으읍흐으읍」","L"
				PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 부추기고 있다.
			ELSE
				CALL HPH_PRINT,@"「응응! 흐읍, 벌써 나오려 하나아앙?」","L"
				PRINTFORMDW 미요이는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 부추기고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「응응 흐읍 응응흐읍」","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「응응 흐으읍 흐으읍」","L"
				CALL HPH_PRINT,@"「크고 단단하고 건장한 거네요, 먹는 것도 힘들 거예요 HPH」","L"
			ELSE
				CALL HPH_PRINT,@"「응츄우헵헤로읏헵」","L"
			ENDIF
		ELSE
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「응~흐읍」","L"
				CALL HPH_PRINT,@"「미요이 입은 기분 좋으세요~ HPH 더 기분 좋게 해 드릴 테니까~ HPH」","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「응응 HPH 미요이에게 맡겨 주세요네 HPH」","L"
			ELSE
				CALL HPH_PRINT,@"「응응! HPH 거시기 많이 기분 좋게 해줄 테니까 말이야 HPH」","L"
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응흐으읍츄릅흐으읍」","L"
			CALL HPH_PRINT,@"「이렇게 거시기 떨게 만들어서 귀엽네요 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「으읍흐응흐읍」","L"
		ELSE
			CALL HPH_PRINT,@"「응응……흐읍」","L"
			PRINTFORMDW 미요이는 어딘가 서툴게 성기를 입에 물었다.
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K134_{SELECTCOM}_1
RETURN 1
