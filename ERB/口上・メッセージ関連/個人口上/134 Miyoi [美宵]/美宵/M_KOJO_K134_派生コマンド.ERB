		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「안돼읏 HPH 거기읏 HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「응읏! HPH 느낌 와버려요 HPH」","L"
