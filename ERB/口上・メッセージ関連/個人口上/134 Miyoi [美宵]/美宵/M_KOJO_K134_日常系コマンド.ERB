;626,土産物屋
;TFLAG:194(-2=ひやかし -1=見送り 1=BAD 2=NOMAL 3=GOOD)
;==================================================

@M_KOJO_MESSAGE_COM_K134_626
CALL M_KOJO_MESSAGE_COM_K134_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K134_626_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			;(GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
			IF RAND:3 == 0
				PRINTFORMW 「장난치는 걸로 보였나…….」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아아…… 출입 금지자가 되어버리네……」
			ELSE
				PRINTFORMW 「계룡점의 간판 아가씨가 혼나다니 책임져 주세요~」
			ENDIF
			;やっぱりやめる（見送り）
		CASE -1
			IF RAND:3 == 0
				PRINTFORMW 「음~ 탐나는 건 없었네」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「계룡전에는 어울리지 않는 물건들만 있네」
			ELSE
				PRINTFORMW 「다음에 또 오자요, 다음엔 뭔가 있으면 좋겠네요」
			ENDIF
			;400点未満（BAD）
		CASE 1
			IF RAND:3 == 0
				PRINTFORMW 「네에…… 받을게요……」
				PRINTFORMDW 미요이는 별로 기뻐 보이지 않는다……
			ELSEIF RAND:2 == 0
				PRINTFORMW 「……가게에 두겠습니다」
				PRINTFORMDW 미요이는 별로 기뻐 보이지 않는다……
			ELSE
				PRINTFORMW 「음…… 일단 받겠어」
				PRINTFORMDW 미요이는 별로 기뻐 보이지 않는다.
			ENDIF
			;400点～699点（NOMAL）
		CASE 2
			IF RAND:3 == 0
				PRINTFORMW 「미요이에게 주시는 건가요? 감사합니다!」
				PRINTFORMDW 미요이는 살짝 부끄러워하는 듯한 미소를 지었다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「와아! 기뻐요!」
				PRINTFORMDW 미요이가 살짝 부끄러운 듯한 미소를 지었다.
			ELSE
				CALL HPH_PRINT,@"「선물? 고마워 HPH」","L"
				PRINTFORMDW 미요이는 살짝 수줍은 듯한 미소를 지었다.
			ENDIF
			;700点以上（GOOD）
		CASE 3
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「후훗 미요이가 원하는 걸 알다니 역시 %CALLNAME:MASTER%씨네 HPH」","L"
				PRINTFORMDW 미요이는 볼을 붉히며 기뻐하고 있다.
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「와! 기뻐! 손님한테 자랑해 버리자, HPH」","L"
				PRINTFORMDW 미요이는 볼을 붉히며 기뻐하고 있다.
			ELSE
				PRINTFORMW 「이거 갖고 싶었어! 소중히 간직할게!」
				PRINTFORMDW 미요이는 받은 것을 품에 안고, 얼굴을 상기시키며 기뻐하고 있다.
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
