@M_KOJO_MESSAGE_COM_K134_0
CALL M_KOJO_MESSAGE_COM_K134_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K134_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「손길이 야하단 말이에요~ HPH」","L"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응읏 하으읍 응읏 하으읍」","L"
			CALL HPH_PRINT,@"「흐윽, 그렇게 구석구석까지……후으읍」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응읏 하으읍 응읏 하으읍」","L"
		ELSE
			CALL HPH_PRINT,@"「앗 흐으응흐읍흐읍」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
