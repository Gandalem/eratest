		PRINTFORMDW 미요이는 '짝' 소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 뺨을 때렸다.
	ELSEIF CFLAG:行動 == 5 && CFLAG:好感度 >= 3000 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「나중에 계산할 거니까…… HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"(안 돼…… 흥분해버릴 것 같아…… 흐으흣)","L"
		ELSE
			CALL HPH_PRINT,@"(나중에 얼마든지 만지게 해 줄 테니까…… 응? HPH)","L"
		ENDIF
		CFLAG:TARGET:溜まってる度 += 100
	ELSEIF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		IF RAND:3 == 0
			PRINTFORMW 「손님~ 제 엉덩이는 팔려고 내놓는 물건 아니거든요~?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아까 건 못 본 걸로 해주겠지만, 다음엔 안 돼요~」
		ELSE
			PRINTFORMW 「변태 씨, 들키지 않을 거라고 생각하는 거야~?」
		ENDIF
		CFLAG:TARGET:溜まってる度 += 50
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응! 흐읍」","L"
			CALL HPH_PRINT,@"「부끄럽단 말이야, 이히힝」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「앗, 후후... 뭔가 %CALLNAME:MASTER%씨의 것이 된 것 같네 후후」","L"
		ELSE
			CALL HPH_PRINT,@"「응 후훗 조금 기분 좋았을지도 몰라아 후후」","L"
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응응!? 벌써! %CALLNAME:MASTER%씨 이외의 사람이라면 돈을 가져가요?」
			PRINTFORMDW 미요이는 얼굴을 새빨갛게 물들이며 그렇게 항의하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응!?」
			PRINTFORMDW 「갑자기 엉덩이 만지면 흥분해버리잖아요!」
		ELSE
			CALL HPH_PRINT,@"「응응흐으읍」","L"
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「……곤란해요, 이런 건 사람들 앞에서」
			PRINTFORMDW 미요이는 조금 곤란한 듯 인적이 없는 곳으로 유도해 왔다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좀 그만해 주시면 안 될까요?」
		ELSE
			PRINTFORMW 「별로 좋은 취향은 아니시네요」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「변태!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「난 이런 거 불편해읏」
		ELSE
			PRINTFORMW 「그만둬!」
			PRINTFORMDW 미요이는 자신의 엉덩이를 주무르는 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
