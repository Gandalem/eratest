@M_KOJO_MESSAGE_COM_K134_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K134
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K134_5_1
	ELSEIF CFLAG:318 == 1
