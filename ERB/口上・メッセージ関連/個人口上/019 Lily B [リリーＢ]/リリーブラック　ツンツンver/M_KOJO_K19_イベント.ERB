@M_KOJO_SPEVENT_K19_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORML
			;ELSEIF TALENT:恋慕
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「아아. 벌써 끝이야?」
					PRINTFORMW 「또 불러줘. 꼭 부탁이니까」
				CASE 0
					PRINTFORML 「오늘 간 곳, 언니도 마음에 들어 할 것 같아」
					PRINTFORMW 「알려줘서 고마워 %CALLNAME:MASTER%. 잘 가」
				CASEELSE
					PRINTFORML 「재미없지는 않았어. 하지만 오해하지 마」
					PRINTFORMW 「오늘은 내 기분 좋아서 데이트시켜 준 것뿐이니까!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「이제 용건은 끝난 거잖아? 그럼」
					PRINTFORMW 
				CASE 0
					PRINTFORML 「릴리 화이트가 걱정하고 있잖아. 빨리 돌아가야 해……」
					PRINTFORMW 
				CASEELSE
					PRINTFORML 「아아 피곤하다. 빨리 집에 가서 자야겠어」
					PRINTFORMW 
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「…일단 한 번 만하게 해줘」
		PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 손등이 꽉 비틀린다….
		PRINTFORML 「후우, 시원하다」
		PRINTFORMW 「이걸 계기로 다음엔 절대 이런 일 없을 거야. 알겠지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「…일단 한 방은 날려줘」
		PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 뺨에 가볍게 손바닥으로 내리치는 소리가 들린다….
		PRINTFORML 「…응, 아직 기분이 풀리지 않았어」
		PRINTFORMW 「적어도 백 번은 해야 속이 시원하겠지만, 오늘 데이트를 봐서 용서해 줄게」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「……일단 한 대 때리게 해줘」
		PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 복부에 무거운 주먹이 미시리 하고 박힌다….
		PRINTFORML 「……응, 전혀 후련하지 않아」
		PRINTFORMW 「그때 일에 대해 사과할 생각이 있다면 이 이상의 고통쯤은 감당해. 알겠어?」
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
