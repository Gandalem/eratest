@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K19_63
RETURN 1

@M_KOJO_MESSAGE_SCOM_K19_63
CALL M_KOJO_MESSAGE_SCOM_K19_63_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K19_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			;CASE 0
			;PRINTFORML
			;PRINTFORMW
			CASEELSE
				PRINTFORML 「응... 쪽...! 푸하앗! 이렇게 되면 어쩔 수 없잖아!」
				PRINTFORMW 「쭈우... 응윽...!」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			;CASE 0
			;PRINTFORML
			;PRINTFORMW
			CASEELSE
				PRINTFORML 「응...! 응...!」
				PRINTFORMW (숨이 막힌다고...!)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			;CASE 1
			;PRINTFORML
			;PRINTFORMW
			;CASE 0
			;PRINTFORML
			;PRINTFORMW
			CASEELSE
				PRINTFORML ｶﾞﾘｯ
				PRINTFORML ……%조사처리(CALLNAME:MASTER,"는")% 리리에 혀를 물려버렸다.
				PRINTFORMW 「하앗... 하앗... 무슨 생각 하는 거야 당신은」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;80,手を引く
;デート出発後目的地に着くまでの間
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_SCOM_K19_80
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_SCOM_K19_80
CALL M_KOJO_MESSAGE_SCOM_K19_80_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K19_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
	ELSEIF TALENT:恋慕
		SELECTCASE TFLAG:193
			CASE 1
				;大成功
				PRINTFORML 「걷고 있는 시간이 아깝잖아」
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")%의 데이트…… 놀 시간이 줄어버리잖아!」
				PRINTFORMW 리리는 %조사처리(CALLNAME:MASTER,"를")% 끌어당기며 목적지까지 서둘렀다
			CASE 0
				;成功
				PRINTFORML (……나랑 %조사처리(CALLNAME:MASTER,"의")% 손이)
				PRINTFORMW 리리는 놓치지 않으려고 꽉 %조사처리(CALLNAME:MASTER,"의")% 손을 쥐었다.
			CASEELSE
				;失敗
				PRINTFORML 리리의 손을 잡으려고 하자, 그녀는 양손으로 %조사처리(CALLNAME:MASTER,"의")% 손을 감쌌다.
				PRINTFORML 「기, 기왕이면 천천히 가지 않을래?」
				PRINTFORMW 「도중에 풍경이 예쁜데 아깝잖아」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE TFLAG:193
			CASE 1
				;大成功
				PRINTFORML 「%CALLNAME:MASTER%쪽이 발이 빠르다고?」
				PRINTFORML 「말했었지…」
				PRINTFORMW 리리와 %조사처리(CALLNAME:MASTER,"는")% 도전적인 미소를 지으며 목적지까지 달려 나갔다.
			CASE 0
				;成功
				PRINTFORML 「서두르라니 오히려 천천히 하고 싶어져 버렸네……」
				PRINTFORMW 
			CASEELSE
				;失敗
				PRINTFORML 「캬앗!」
				PRINTFORML 리리는 갑자기 손을 놓치게 되면서 넘어져 버렸다.
				PRINTFORML 눈에 눈물을 고한 채 엉덩이를 문지르며 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
				PRINTFORMW 「아파아! %조사처리(CALLNAME:MASTER,"가")% 갑자기 잡아당기니까 말이야!」
		ENDSELECT
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				;大成功
				PRINTFORML 「앗...!」
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 비틀거리는 리리의 손을 잡고 그녀를 끌어당겼다.
				PRINTFORML 「... 내가 넘어질 것 같았다는 걸 알아줬네. 대단하잖아」
			CASE 0
				;成功
				PRINTFORML 「잠, 잠깐만! 그렇게 급한 일이야?」
				PRINTFORMW 
			CASEELSE
				;失敗
				PRINTFORML 「아얏! 멋대로 손 잡아당기지 마세요!」
				PRINTFORML 리리의 손은 무리하게 당긴 탓에 빨갛게 되어버렸다.
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
