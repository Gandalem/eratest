@M_KOJO_SUCCESS_COM_K19_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K19_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K19_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K19_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「………」
		PRINTFORMW 
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「헤에... 그런 게 있었구나...」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")%」 박식하네
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%도 운이 없네. 나 같은 요정한테 달라붙어서」
				PRINTFORMW 「...뭐야, 히죽거리는 거야! 내가 부끄럽잖아!」
			CASEELSE
				PRINTFORML 「나는 딱히 %CALLNAME:MASTER%이야기라면 뭐든지……」
				PRINTFORMW 「뭐, 무슨 소리 하는 거야!!」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:4
			CASE 2
				PRINTFORML 「바람을 가르며 날아다니는 건 기분이 좋다」
				PRINTFORMW 「텐구에는 물론 발밑에도 미치지 못하지만, 뺨을 스치는 바람과 공기를 베는 소리가 최고다!」
			CASE 1
				PRINTFORML 「릴리 화이트랑 릴리 블랙은 원래 한 명의 요정이었다고. ……근데」
				PRINTFORML 「어느 날, 에이키님께 흰색과 검은색을 확실히 정해져 둘로 나뉘게 된 거야」
				PRINTFORMW 「……라던데, 어디까지가 사실인지 모르겠네」
			CASE 0
				PRINTFORML 「사실 이 의상, 에이키님 코스프레 하려고 만든 건데…… 알겠어?」
				PRINTFORMW 「봐, 이 검은 치마 같은 것도 에이키님 치마를 생각해서 한 거야」
			CASEELSE
				PRINTFORML 「언니도 봄밖에 없을 때는 나랑 똑같아」
				PRINTFORMW 「명랑했던 만큼, 봄이 지나서 오는 가을은 유난히 음침하잖아……」
		ENDSELECT
	ELSEIF DAY:2 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「봄을 전해달라고 한다면 누나……릴리 화이트에게 말을 걸어 보렴」
				PRINTFORMW 「나는 할 생각 없어!」
			CASE 0
				PRINTFORML 「언니 같다고 봄이라 뭔가 하려는 생각은 없어」
				PRINTFORMW 「봄 같은 건 이변이라면 몰라도 언제나 멋대로 오잖아」
			CASEELSE
				PRINTFORML 「응, 지금은 봄이네」
				PRINTFORMW 「……그래서?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「난 릴리 화이트가 아닌데?」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「나랑 얘기하고 싶어? 이상한 거 아냐, 너」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「……뭔가 용무라도?」
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
