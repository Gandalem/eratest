LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW 
	ELSEIF CFLAG:TARGET:睡眠
		PRINTFORMW 「……응……앗……응읏」
		PRINTFORMDW 코코로는 푹 자고 있다
		PRINTFORMDW 그 입술을 음미하듯 키스를 이어갔다
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「……무우」
		PRINTFORMDW 코코로는 불만스러운 듯 입을 삐죽 내밀고 있다.
	ELSEIF TALENT:恋人
		IF RAND:6 == 0
			PRINTFORMW 「…앗%UNICODE(0x2764)%　……츄욱%UNICODE(0x2764)%」
			PRINTFORMW 「…츄릅%UNICODE(0x2764)%　응%UNICODE(0x2764)%　쪽%UNICODE(0x2764)%　아후%UNICODE(0x2764)%」
		ELSEIF RAND:5 == 0
			PRINTFORMW 「……읏%UNICODE(0x2764)% 더%UNICODE(0x2764)%」
			PRINTFORMW 「……츄%UNICODE(0x2764)%……응%UNICODE(0x2764)%……쭈욱%UNICODE(0x2764)% 츄읍%UNICODE(0x2764)%」
			PRINTFORMDW 코코로는 %조사처리(CALLNAME:MASTER,"의")% 입술을 찾는 듯 목에 팔을 감고 있다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 「……파앗……%UNICODE(0x2764)% 응%UNICODE(0x2764)%」
			PRINTFORMDW 코코로는 긴 키스를 마친 뒤, 꿈을 꾸는 듯한 모습으로 표정을 나른하게 만들고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「……쪽%UNICODE(0x2764)%」
			PRINTFORMW 「아무우윽…… 쪽…응 쪽%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음뇸…… 쪽%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「……윽%UNICODE(0x2764)%」
			PRINTFORMW 「아후……%UNICODE(0x2764)% 아직, 이걸로 끝나지 않았잖아?」
			PRINTFORMDW 코코로는 그렇게 말하며 다시 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗았다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……쪽%UNICODE(0x2764)%」
			PRINTFORMW 「아무우윽…… 쪽…응 쪽%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음뇸…… 쪽%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「……윽%UNICODE(0x2764)%」
			PRINTFORMW 「아후……%UNICODE(0x2764)% 아직, 이걸로 끝나지 않았잖아?」
			PRINTFORMDW 코코로는 그렇게 말하며 다시 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗았다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「…앙!%UNICODE(0x2764)%　츄%UNICODE(0x2764)%」
			PRINTFORMW 「…하으%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…아무읏%UNICODE(0x2764)% 추읍%UNICODE(0x2764)% 음음%UNICODE(0x2764)%」
			PRINTFORMDW 코코로는 내버려진 채 당하고 있다.
		ELSE
			PRINTFORMW 「……대단했어……%UNICODE(0x2764)%」
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「...뭐!? ...응으윽!」
			PRINTFORMDW 코코로는 입술을 빼앗기며 몸부림친다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……엣!?」
			PRINTFORMW 「……이제, 그만해……라고, 바앗!」
		ELSE
			PRINTFORMW 「응으!? ……또, 그만둬!?」
		ENDIF
	ELSE
		PRINTFORMW 「……히야!? 응응읏」
	ENDIF
ENDIF
RETURN 1
