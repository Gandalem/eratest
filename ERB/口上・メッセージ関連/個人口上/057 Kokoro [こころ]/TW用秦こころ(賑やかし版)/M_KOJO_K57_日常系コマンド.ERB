;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗するのはTARGET
;==================================================

@M_KOJO_MESSAGE_SCOM_K57_60
CALL M_KOJO_MESSAGE_SCOM_K57_60_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K57_60_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		PRINTFORMW 「자, 무릎 위에 머리를 올려봐」
		PRINTFORMW 「연인끼리인데, 이제 와서 주저하지 마」
	ELSEIF TALENT:恋慕
		PRINTFORMW 「응, 자꾸 움직이면 안 돼읏」
	ELSEIF TALENT:思慕
		PRINTFORMW 「음~ 조금 익숙해진 걸까」
	ELSEIF CFLAG:2 >= 500
		PRINTFORMW 「괜찮아? 아프면 바로 말해줬으면 좋겠어」
	ELSE
		PRINTFORMW 「음~, 이렇게 할까?」
		PRINTFORMDW 코코로는 서툰 모습으로 %조사처리(CALLNAME:MASTER,"의")% 귀를 청소하고 있다.
	ENDIF
ENDIF
RETURN 1
