						CALL HPH_PRINT,@"「하아 HPH 하아 HPH 응 HPH ……기분 좋아 보이는 얼굴로 질을 내지 말아줘, %CALLNAME:MASTER%……HPH」","L"
						CALL HPH_PRINT,@"「나도 말이야... 이렇게 연인처럼 손을 맞잡고, 몸을 포개고... 정액을 받아내면서…… HPH」","L"
						CALL HPH_PRINT,@"「행복한 감정이 나를 감싸고 있어……후우」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「크으아! 후읍... 후읍... 후읍. 지금, 진득한 게 세게 안쪽으로 박혀버렸어... 후읍」","L"
						PRINTFORMW 
					ENDIF
				CASE 11
					IF TEQUIP:体位 == 1;正常位
						CALL HPH_PRINT,@"「응응—흐윽, 응응 하아... 흐으 하앗... 흐으 흐으 흐으」","L"
						CALL HPH_PRINT,@"「대단해…… 꾸덕꾸덕한 정액이 부어져 와서…… 머리가 새하얘졌어…… 후후 후후 후후」","L"
						PRINTFORMDL 코코로는 %조사처리(CALLNAME:MASTER,"의")% 목에 팔을 감은 채, 나지막이 중얼거리고 있다.
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「후와아 흐응흐응 농후한 거, 뜨거운 거 잔뜩…… 흐응」","L"
						PRINTFORMW 
					ENDIF
				CASE 12
					IF TEQUIP:体位 == 2;後背位
						CALL HPH_PRINT,@"「하아……후우음……후우 음, 대단해…… 진한 걸 깊숙이 잔뜩 받고 있어…… 후우 음」","L"
						CALL HPH_PRINT,@"「이런, 교미 같은 자세로... 기분이 좋아져서... 안에 정액을 채워줘... 하으윽」","L"
						CALL HPH_PRINT,@"「몸도 마음도…… 네 것만 되어가는 걸 느끼고 있어……. HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「크으아 흐읍 응윽 아츠이…… 몸속 깊은 곳에, 진득한 게 채워져 와서... 찌릿하게 저려와요……」","L"
						PRINTFORMW 
					ENDIF
				CASE 13
					IF TEQUIP:体位 == 2;後背位
						CALL HPH_PRINT,@"「후우…… HPH 후우…… HPH 사람 팔을 가죽끈처럼 잡고 있네…. 부러질까 생각했어」","L"
						CALL HPH_PRINT,@"「응……HPH 정액……깊숙한 곳까지 꾸덕꾸덕 흘러들어 오는 게 느껴져 버려……」","L"
						CALL HPH_PRINT,@"「……기분 좋아…… 마음이 채워져 가는 것 같아……후훗」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「응 흐읍 크으, 진한 정액이… 나의, 태의 깊은 곳에……흐읍」","L"
						PRINTFORMW 
					ENDIF
				CASE 14
					IF TEQUIP:体位 == 3;騎乗位
						CALL HPH_PRINT,@"「하아…… HPH 하아…… HPH 꽤나…… 진한 걸 사정했네 HPH」","L"
						PRINTFORML 「나의 죄는 그렇게 기분 좋았느냐?」
						PRINTFORML 「……그렇다면 한 번 더……아, 잠깐… 나도 버티기 힘들지도 모르겠어……」
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「오, 오옷…… HPH 자궁을 거시기(진보)로 밀어 올리면서 박히고 있어…… HPH」","L"
						CALL HPH_PRINT,@"「응흐읍... 응흐읍. 그, 그렇게 밀어 넣듯이……. 응응흐읍」","L"
						PRINTFORMW 
					ENDIF
				CASE 15
					IF TEQUIP:体位 == 3;騎乗位
						CALL HPH_PRINT,@"「하아…… HPH 하아…… HPH 음… HPH 어때, 내 허리 쓰는 건?」","L"
						CALL HPH_PRINT,@"「후, 후후…… 느껴져……. 네 진한 정액이 내 자궁을 가득 채워가는 걸…… HPH」","L"
						CALL HPH_PRINT,@"「이번엔 내 승리네... %CALLNAME:MASTER%... HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「하아…… HPH 하아…… HPH 내 속을 %조사처리(CALLNAME:MASTER,"의")% 정액이 적셔 들어가는 걸 느껴…… HPH」","L"
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 정액을 자궁에 부을 때마다... 나의 태는 네 정액의 맛을 기억하며 두근두근 아파와…… HPH」","L"
						CALL HPH_PRINT,@"「이게, 네 것이 된다는 건가…… HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 16
					IF TALENT:妊娠
						CALL HPH_PRINT,@"「하앙 HPH 아, 아아... HPH 기분 좋지만 HPH」","L"
						PRINTFORML 「이렇게 진한 정액이 주입되면…… 배 속의 아기가 깜짝 놀랄까……」
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「응… HPH 오늘은 평소보다 훨씬 진해…… HPH」","L"
						CALL HPH_PRINT,@"「두근두근... 두근두근하고 있어... 기분 좋은 HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 17
					IF TALENT:妊娠
						CALL HPH_PRINT,@"「...응, 후우...... HPH ......너, 평소보다 많이 내는 거 아니야?」","L"
						PRINTFORML 「게다가, 평소보다 정액이 훨씬 진한 것 같아……」
						PRINTFORML 「……임신한 사람한테 흥분하기 너무 심해…… 바보」
						PRINTFORMW 
					ELSEIF TALENT:57:無知
						CALL HPH_PRINT,@"「응... HPH 이거, %조사처리(CALLNAME:MASTER,"의")% 정액......」","L"
						CALL HPH_PRINT,@"「남의 진득한 체액을 안에 채워지는 게 이렇게 기분 좋을 줄은 몰랐어……. 후우」","L"
						CALL HPH_PRINT,@"「더 나한테, 네가 알고 있는 기분 좋은 걸 가르쳐줬으면 해 HPH」","L"
						PRINTFORMW
					ELSE
						CALL HPH_PRINT,@"「하……HPH 하앗……HPH 느껴져……HPH 정액이 진한 거야……자궁 깊숙한 곳에서 HPH」","L"
						PRINTFORML 「음……%조사처리(CALLNAME:MASTER,"와")%의{EXP:出産経験 + 1}번째 아기가 생길지도…….」
						PRINTFORMW 
					ENDIF
				CASE 18
					CALL HPH_PRINT,@"「이게… 질내 사정되는 감각…… HPH」","L"
					CALL HPH_PRINT,@"「너한테 깔려서, 마음대로 범해지다니…… 하지만 어쩔 수 없나 HPH」","L"
					CALL HPH_PRINT,@"「있잖아, 이 안에서 퍼져나가는 열의 따뜻함이... 도저히 참을 수 없이 기분이 좋단 말이야 HPH」","L"
					PRINTFORMW 
				CASE 19
					CALL HPH_PRINT,@"「...응응 후으헵 크윽후으헵 엄청난 기세로.... 응응 후으헵」","L"
					CALL HPH_PRINT,@"「……아아, 내 자궁…… 네 정액 맛을 기억해버릴 거야 HPH」","L"
					PRINTFORMW 
				CASEELSE
					CALL HPH_PRINT,@"「응 흐읍, 주르륵… 주르륵… 하고 무겁고 진한 정액이 흘러들어와 있어 흐읍」","L"
					CALL HPH_PRINT,@"「후후…… 얼마나 쌓아뒀던 거야…… 너 HPH」","L"
					CALL HPH_PRINT,@"「……괜찮아 HPH 그 고인 정액 전부 내가 받아줄게 HPH」","L"
					PRINTFORMW 
			ENDSELECT
		ELSE
			SELECTCASE RAND:11 ;custom code
				CASE 1
					IF EX:膣内精液 >= 1200
						CALL HPH_PRINT,@"「하아...응 흐으 배가... 정액으로 부풀어서... 흐으」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「응…… 두근두근해, 정액이 흘러들어와……. HPH」","L"
						CALL HPH_PRINT,@"「하아…… HPH 뜨거운 게 퍼져가고 있어…… 기분 좋아…… HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 2
					CALL HPH_PRINT,@"「아아 HPH %조사처리(CALLNAME:MASTER,"의")% 정액이 내 안에…… HPH」","L"
					CALL HPH_PRINT,@"「응 HPH 야아…… HPH가 부르르 떨면서… 굉장한 기세로… 자궁 깊은 곳을 두드리고 있어 HPH」","L"
					PRINTFORMW 
				CASE 3
					IF TEQUIP:体位 == 1;正常位
						CALL HPH_PRINT,@"「하아…… HPH 하아…… HPH 응 HPH 이 체위에서는, 네가 즐거워하는 표정을 볼 수 있어서…… 나쁘지 않아 HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「크으읍 흐응 흐응 굉장해... 뜨거워... 흐응」","L"
						PRINTFORMW 
					ENDIF
				CASE 4
					IF TEQUIP:体位 == 1;正常位
						CALL HPH_PRINT,@"「응 후우... 하아... 이대로, 안아줘... 응」","L"
						CALL HPH_PRINT,@"「안쪽도 바깥쪽도, 네 열기를 느끼고 싶단 말이야... HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「앙 흐으응흐응 후우... 응, 네 정액이 안에서 터져서... 대단하다아... 흐응」","L"
						PRINTFORMW 
					ENDIF
				CASE 5
					IF TEQUIP:体位 == 2;後背位
						CALL HPH_PRINT,@"「응으 HPH 응HPH 핫……HPH 이런, 교미 같은 자세로… 안쪽 가득……HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「아아... HPH 속을, 밀려오면서... 잔뜩 나와 있는 HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 6 ;custom code
					IF TEQUIP:体位 == 2;後背位
						CALL HPH_PRINT,@"「흣……후우 후우... 뒤에서 범해지면서 사정당하고 있네……. 후우」","L"
						CALL HPH_PRINT,@"「아앗... 열이 퍼져가네... 굉장해... 이건... HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「응…… 끝까지, 뜨거워……. 잔뜩……. HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 7 ;custom code
					IF TEQUIP:体位 == 3;騎乗位
						CALL HPH_PRINT,@"「응…… HPH 아랫배에 뜨거운 게 차오르는 느낌…… 나쁘지 않아」","L"
						PRINTFORML 「너를 내 허리놀이로 기분 좋게 해줬다는 거니까 말이야」
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「아응흐으 응응흐으 는…… 흐으는…… 흐으 이거, 기분 좋아……흐으」","L"
						PRINTFORMW 
					ENDIF
				CASE 8 ;custom code
					IF TEQUIP:体位 == 3;騎乗位
						CALL HPH_PRINT,@"「무슨 일이야? 벌써 항복하는 거야 %CALLNAME:MASTER%……흐으흣」","L"
						CALL HPH_PRINT,@"「응…… HPH 안에 두근두근 사정해줘… HPH 아직 더 할 수 있을 것 같아, 응? HPH」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「응... HPH 아아... 좋아 HPH 뜨거운 게 안에 채워지고 있어... HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 9 ;custom code
					IF TALENT:妊娠
						CALL HPH_PRINT,@"「하아... 하아... HPH 배에, 아기가... 있는데... HPH」","L"
						CALL HPH_PRINT,@"「아기, 놀라게 해버렸을까……」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「하아……HPH 하아……HPH 정액……. 퍼져가네……HPH」","L"
						CALL HPH_PRINT,@"「이거, 좋아…… HPH」","L"
						PRINTFORMW 
					ENDIF
				CASE 10 ;custom code
					IF TALENT:妊娠
						CALL HPH_PRINT,@"「응응, 흐으... 헉... 흐윽... 저, 이런 곳에 아기가... 있는 건데... 흐읍」","L"
						PRINTFORMW 
					ELSE
						CALL HPH_PRINT,@"「응 흐윽 배 속이…… %조사처리(CALLNAME:MASTER,"의")% 정액이…… 채워지고 있어……흐윽」","L"
						PRINTFORMW 
					ENDIF
				CASEELSE
					CALL HPH_PRINT,@"「아, 하아... HPH 응...... HPH 단단히 고정되어 있고, 정액이 주르륵 나와서... HPH」","L"
					CALL HPH_PRINT,@"「……아아…… 자궁이, 네 아이의 씨앗으로 채워져 가네…… HPH」","L"
					PRINTFORMDL 코코로는 녹아내린 듯한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 사정을 받아들이고 있다.
					PRINTFORMW 
			ENDSELECT
		ENDIF
	ELSE
		IF TALENT:MASTER:濃厚精液
			IF RAND:3 == 0
				PRINTFORML 「아, ……안에……이렇게……」
				PRINTFORMW 
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORML 「하아…… 이게, 정액…….」
				PRINTFORMW 
				RETURN 1
			ELSE
				PRINTFORML 「아…… 아아…… 이거, 대단한 걸지도……」
				PRINTFORMW 
				RETURN 1
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「아, 하아…… 배가 뜨거워……」
				PRINTFORML 「……이게 정액의 감각……」
				PRINTFORMW 
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORML 「하아…… 아, 이래도…… 안 돼, 그런데……」
				PRINTFORMW 
				RETURN 1
			ELSE
				PRINTFORML 「하윽... 하윽... 응... 흐읍...」
				PRINTFORML 「아직, 사정하고 있어... 배가... 아파와서...」
				PRINTFORMW 
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
