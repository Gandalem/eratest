							CALL HPH_PRINT,@"「……괜찮아 HPH 와서 HPH 더, %조사처리(CALLNAME:MASTER,"의")% 정액을 쏟아줘 HPH」","L"
							CALL HPH_PRINT,@"「아이 만들어주는 교미로, 내 위험일 자궁에 마음껏 씨를 심어줘 HPH HPH HPH」","W"
						ELSE
							CALL KOKORO_SEX
						ENDIF
					CASE 2
						CALL KOKORO_SEX
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앙! 후우흐... 여전히 이 체위에서는 늘 격렬해... 으응! 후우흐...」","L"
						CALL HPH_PRINT,@"「얏 HPH 아아 HPH 정말 야수 같아…… 후아아 HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「아앗 흐응……! 응, 더 깊이 박아줘읏, 더!!」","L"
						CALL HPH_PRINT,@"「하앗 HPH 아앗 HPH 뒤에서 당하는 거... 싫지, 않아... 아아 HPH」","W"
					CASE 2
						CALL KOKORO_SEX
				ENDSELECT
				RETURN 1
			ENDIF
		ELSE
			;今射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「크으윽…… 아우욱…… 흐읍! 이렇게 격렬하게…… 으응! 흐읍!」","L"
						CALL HPH_PRINT,@"「야, 안! 응... 나도... 배가 아파와……안!」","W"
					CASE 1
						CALL HPH_PRINT,@"「응흐으응, 아앗 흐윽 움직임이 격렬해졌어... 나올 것 같아?」","L"
						CALL HPH_PRINT,@"「괜찮아 HPH 나는 언제든지... 앗 HPH 크으윽 HPH」","W"
					CASE 2
						CALL KOKORO_SEX
				ENDSELECT
				RETURN 1
				;前回射精した
			ELSEIF TCVAR:102
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응, 후우……! 하아앗! ……음! 아직 사정 안 했어?」","W"
					CASE 1
						CALL HPH_PRINT,@"「아아흐읍 잠깐만 흐으읍 조금 쉬게 해줘……응응흐읍」","W"
						CALL HPH_PRINT,@"「흐으읍, 배가…… 탱탱한 느낌이 들어서…… 이상해…… 흐으읍」","W"
					CASE 2
						CALL KOKORO_SEX
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 흐읍… 으응읏흐읍」","W"
					CASE 1
						CALL HPH_PRINT,@"「……응흐읍……앙! 흐으윽」","W"
					CASE 2
						CALL KOKORO_SEX
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF ABL:膣 >= 3
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응읏... HPH 역시, 이 강아지 같은 자세로 하는 건가……」","L"
				CALL HPH_PRINT,@"「부끄럽지만... 딱히 싫지는 않아……흐응」","W"
			CASE 1
				CALL HPH_PRINT,@"「응읏, 아아...윽 HPH 거시기... 깊숙이, 들어왔어... HPH」","L"
				CALL HPH_PRINT,@"「이렇게 너한테 깔려서 범해지는 거…… 기분 좋아서 중독될 것 같아 HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「이봐... 그런 엉덩이에 거칠게 박지 마아 HPH 응...읏HPH 못됐잖아...HPH」","L"
				CALL HPH_PRINT,@"「후우…… 응! 하아…하아 %조사처리(CALLNAME:MASTER,"의")% 거시기… 깊숙이 들어와 와, 하아」","L"
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「아, 응! 후우... 안에, 닿았어... 이상한 느낌이야...」","W"
			CASE 1
				CALL HPH_PRINT,@"「흐으윽... 큭... 큭... 이 모습, 부끄러워……」","W"
			CASE 2
				CALL HPH_PRINT,@"「…윽, 으으…흐읍… 크고…한 거 삽입해…… 오고 있어…읏」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
