@M_KOJO_MESSAGE_COM_K9_310_1
;-------------------------------------------------
;キャラ固有口上処理部分
;記入チェック（=0, 非表示、1, 表示）
;-------------------------------------------------
LOCAL = 1
IF LOCAL
	IF FLAG:70
		;時間停止中
		PRINTFORMDW 시간이 멈춘 채로, 당신은 마음껏 유메미의 엉덩이를 손으로 문지른다.
		PRINTFORMDW 정말 멋진 감촉이다. 도저히 질릴 수가 없다.
		PRINTFORMDW 하지만 물론, 멈춘 시간 속에서 유메미는 어떠한 응답의 기색도 보이지 않는다.
		PRINTFORMDW 당신은 그러한 것들이 정상적인 시간에만 경험할 수 있는 의미를 지니고 있음을 느낀다.
	ELSEIF CFLAG:313
		;睡眠中
		PRINTFORML 「으음... 누가 엉덩이 마사지기를 켰지...」
		PRINTFORMDW 유메미는 잠꼬대로 중얼거린다. 당신이 그녀의 엉덩이를 쓰다듬자... 잠깐, 엉덩이 마사지기?
	ELSEIF CFLAG:317 == 2
		;うふふ中のおしりなでなで
		SELECTCASE TCVAR:20
			CASE 35
				;スカート内アッピル
				CALL HPH_PRINT,@"「음... 뭐가, 여기...? 다른 곳에 집중해야 하지 않을까...?」","L"
				PRINTFORMDW 물론, 당신은 전체적인 모습도 즐기고 있지만 동시에 그녀의 엉덩이도 즐기고 싶어하는 것이다.
				PRINTFORMDW 당신은 그녀의 엉덩이를 손으로 문지르면서 이런 생각을 한다.
			CASE 52
				;素股
				CALL HPH_PRINT,@"「아앙, 지금 정말 거기 만져야 하는 곳이야...흐으」","L"
				PRINTFORMDW 당신의 %FSYN("penis")%이 그녀의 %FSYN("labia")%를 자극하자 유메미가 살짝 떨었다.
				CALL HPH_PRINT,@"「아, 하지만 내 엉덩이에서 느껴지는 이 다른 감각이라니...후훗」","L"
				PRINTFORML 「이것도 나름 괜찮을지도……\/\/\/」
			CASE 70
				;まんこなめさせ
				CALL HPH_PRINT,@"「아아, 응, 정말 좋다... 더 핥아줘, 아, 아, 지금 내 엉덩이를 만져야 해...? HPH」","L"
				PRINTFORMDW 그녀의 연모즙을 음미하며 그녀의 %FSYN("crotch")%에 얼굴을 댄 채로, 당신은 손을 그녀의 엉덩이로 가져간다.
				CALL HPH_PRINT,@"「아안, 이봐, 내 보지 무시하지 마... 알겠어? HPH 아아HPH」","L"
				PRINTFORMDL 그게 가능할 리가 없다는 듯.
			CASE 72
				;ケツ舐めさせ
				PRINTFORMDW 당신이 그녀의 매우 민감한 %FSYN("anus")%을 탐험하면서, 주변의 볼을 따라 그녀의 손을 미끄러뜨린다.
				PRINTFORML 「아으음, 헤이... 음... 이제 기분이 좋아지기 시작했으니 그 부분은 걱정하지 마...」
				PRINTFORMDW "내 앞에 있는 이 놀라운 엉덩이를 가진 상태에서, 나는 단지 구멍만으로는 만족할 수 없을 거야."
				CALL HPH_PRINT,@"「하아, 바보 같아... 그럼, 적어도... 아으응흐프... 계속, 계속 네 혀를 움직여봐... 흐프」","L"
		ENDSELECT
	ELSE
		;通常のおしりなでなで
		SELECTCASE TFLAG:193
			CASE 1
				;拒絶
				PRINTFORML 「히익?! 어디를 만지고 있다고 생각하는 거야, 변태 같아!」
			CASE 4
				;されるがまま
				IF TALENT:恋慕
					PRINTFORML 「응... 아아... 안 돼, 잠깐만... \/\/\/\/」
					PRINTFORML 「난 그렇게까지 사랑하는 사람을 좋아하게 될 줄은 몰랐어… \/\/\/」
					PRINTFORMDW 유메미는 살짝 떨며 얼굴을 붉힌 채 너를 바라본다.
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					CALL HPH_PRINT,@"「아앙... 그렇게 만지면... 흥분해버릴 것 같아... 흐읍」","L"
					PRINTFORML 「괜찮다면... 마음껏 즐겨줘...」
					PRINTFORMDW "그게 요점이지"라고 말하며 다시 힘을 실어 그녀의 엉덩이를 쓰다듬는다., you say as you caress her ass with renewed vigor.
				ELSEIF TALENT:思慕
					PRINTFORML 「뭐야 %CALLNAME:MASTER%... 변태\/\/\/」
					PRINTFORMDW 유메미는 네가 그녀의 엉덩이를 쓰다듬자 이리저리 안절부절못한다.
				ELSE
					PRINTFORML 「뭐야, 어디 만지고 있는 거야... 너...\/\/\/」
				ENDIF
			CASEELSE
				;恥ずかしがる
				IF TALENT:恋慕
					PRINTFORML 「아아... 이봐 %CALLNAME:MASTER%... 여기 작은 게 있어...」
					PRINTFORMDW "너 별로 속상해 보이지 않아."
					PRINTFORML 「야안, 그건... 요점과는 상관없어... \/\/\/\/」
					PRINTFORML 「바보 같긴...\/\/\/」
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					CALL HPH_PRINT,@"「응...흐읍 이런 곳에서 내 엉덩이를 만지다니, 뭐 하는 거야...흐읍」","L"
					PRINTFORMDW 유메미는 장난스럽게 웃으며 부끄러워한다.
					CALL HPH_PRINT,@"「내가 흥분하면 책임질 거지…? HPH」","L"
					PRINTFORMDW 유메미의 미소에 갑자기 음란함이 가득해졌다.
				ELSEIF TALENT:思慕
					PRINTFORML 「야, 그만해... 이럴 때 내 엉덩이를 갑자기 만지다니... \/\/\/」
					PRINTFORMDW 유메미는 주변을 둘으며 당황한 표정을 지었다.
				ELSE
					PRINTFORML 「뭐야, 그만해... 바보 같아... 우린 지금 어디에 있는지 생각해 봐야 해...\/\/\/」
					PRINTFORMDW 유메미는 주변을 둘며 부끄러워한다.
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
