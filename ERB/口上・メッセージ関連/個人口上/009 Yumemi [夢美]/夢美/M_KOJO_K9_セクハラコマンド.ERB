@M_KOJO_MESSAGE_COM_K9_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;-------------------------------------------------
LOCAL = 1
IF LOCAL
	IF FLAG:70
		;時間停止中
		PRINTFORMDW 당신은 시간이 멈춘 채 유메미를 품는다.
		PRINTFORMDW 응답이 없는 것은 다소 따뜻한 마네킹에게 매달리는 것과 비슷하다.
		PRINTFORMDW 그것 또한 안아주는 베개 같지만, 지금 잠들 의도는 없다.
		PRINTFORMDW 당신은 소중한 멈춘 시간을 조금 낭비한 기분이 든다...
		;デート中
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
		IF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0 ;custom code
					PRINTFORML 「%CALLNAME:MASTER%… 후후, 들킨 모양이네요.」
					PRINTFORML 「응… 이대로 좀 더 있을 수 없을까요…」
					PRINTFORMDW 당신은 그녀를 다시 끌어안으며 머리를 쓰다듬기 시작한다.
					CALL HPH_PRINT,@"「응, 저기... 어디를 만지고 있는 거야, 바보야... 사랑해... %CALLNAME:MASTER%HPH」","L"
				CASE 1 ;custom code
					PRINTFORML 「후후, 이런 것도 데이트 중에는 좋네.」
					CALL HPH_PRINT,@"「에이, 규우~ HPH」","L"
					PRINTFORMDW 유메미가 갑자기 상황을 뒤집고 대신 당신을 끌어안는다.
					CALL HPH_PRINT,@"「사랑해, %CALLNAME:MASTER%HPH」","L"
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORML 「저기, 결국 우리 데이트 중이구나... 응, 음...\/\/\/\/」
			PRINTFORMDW 상황이 낯선 유메미는 당신에게 안기며 얼굴을 붉히고 중얼거린다.
			PRINTFORML (흐읍... 왜 이렇게 흥분하는 거지?!)
		ELSE
			PRINTFORML 「%FSYN("hii")%?! 자-잠깐만, 같이 나와 있다고 해서……」
			PRINTFORML 「갑-갑자기 이런 짓 하지 마……\/\/\/」
		ENDIF
		;睡眠中
	ELSEIF CFLAG:313
		PRINTFORML 「응, 음...?」
		PRINTFORMDW 잠든 유메미를 안고 있는 그녀는 살짝 불편한 표정을 짓는다.
		;押し倒されてる
	ELSEIF CFLAG:317 == 2
		SELECTCASE CFLAG:317
			CASE 32
				;前から抱きつかれ
				PRINTFORML 「%CALLNAME:MASTER%, 재료 좀 보충해 둘게.」
				CALL HPH_PRINT,@"「음~ 후우, 다 가득해~」","L"
				PRINTFORMDW "대체 무슨 재료야! 너 연구원이어야지!"
				PRINTFORML 「음... 그건 별개의 문제야, 알잖아?」
			CASE 60
				;ディープキスされた
				PRINTFORML 「%RANDLIPS(0,"kiss")%... %CALLNAME:MASTER%... %KISS("kiss")%...」
			CASE 73
				;ぱふぱふ
				PRINTFORML 「여-여기... 내 가슴에 얼굴을 묻게 해 줄게... 어때...?」
				IF TALENT:バストサイズ < 0
					PRINTFORMDW 그녀의 체온은 느낄 수 있지만, 안타깝게 즐길 만한 부드러움은 별로 없다.
					PRINTFORML 「결국 그 정도는 아닌가 봐...」
				ELSEIF TALENT:バストサイズ >= 1
					PRINTFORMDW 당신은 유메미의 풍만한 %FSYN("chest")%에게 기쁘게 몸을 맡기며 부드러운 감각을 음미한다...
					PRINTFORML 「후후... 정말 행복해 보인다...」
				ELSE
					PRINTFORMDW 당신은 그 감각을 음미하며 그녀의 잘 만들어진 %FSYN("chest")%에 기댄다...
					PRINTFORML 「기분 좋니...?」
				ENDIF
			CASE 74
				;乳合わせされた
				CALL HPH_PRINT,@"「음... 응, 네 가슴을 내게 밀착시켜 봐... 이렇게... 아아헵」","L"
				CALL HPH_PRINT,@"「아아흐헵 네... 음... 그렇게, %CALLNAME:MASTER%... 유두를 서로 비벼봐...헵」","L"
			CASE 77
				;乳を吸わされてる
				CALL HPH_PRINT,@"「여기서, %CALLNAME:MASTER%, 내 유두 빨아줄 수 있어...? HPH NnnHPH」","L"
				CALL HPH_PRINT,@"「응, 바로 그렇게...흐읍 아아... 더, 나한테 더 느껴지게 해줘...흐읍」","L"
				CALL HPH_PRINT,@"「우유가 조금 나올지도 몰라... HPH」","L"
			CASE 85
				;INSERT V
				CALL HPH_PRINT,@"「후후후... 이번엔 안 돼, %CALLNAME:MASTER%... 이번엔 내가 넣어줄게...HPH」","L"
				PRINTFORMDW 그렇게 말하며, 유메미는 망설임 없이 당신의 %FSYN("penis")% 위로 몸을 겹치고 한 번의 부드러운 동작으로 허리를 낮춘다.
				CALL HPH_PRINT,@"「음... 안에서야HPH」","L"
			CASE 87
				;INSERT A
				CALL HPH_PRINT,@"「후후후... %CALLNAME:MASTER%... 이번에는 이 구멍을 써보자 HPH」","L"
				PRINTFORMDW 그렇게 말하며, 유메미는 주저 없이 자신의 항문을 당신의 %FSYN("penis")% 위에 놓고 한 번에 부드럽게 골반을 낮춘다.
				CALL HPH_PRINT,@"「응으으음, 안에 있어... 응으으음, 내 뒤에 있어... 응으으음」","L"
			CASE 88
				;腰ふりV
				CALL HPH_PRINT,@"「아아악, 그래, %CALLNAME:MASTER%더 세게, 더 깊숙이 박아 넣어 HPH」","L"
				CALL HPH_PRINT,@"「내 보지가 너무 좋아, 정말 좋아 HPH 멈출 수가 없어 내 골반을 HPH」","L"
				CALL HPH_PRINT,@"「후아아, 그래, 더 깊이! 정말 좋아아아아HPH」","L"
			CASE 89
				;腰ふりA
				CALL HPH_PRINT,@"「응아아앙, 더 깊이, 내 속을 파내줘 HPH 오, 오 예스, 아아아앙 HPH」","L"
			CASE 86
				;らいひゅき
				CALL HPH_PRINT,@"「아, 아하PH %CALLNAME:MASTER%, 너... 곧 사정할 거야?」","L"
				CALL HPH_PRINT,@"「이런 식으로 안에 싸줘HPH 전부 안에 해줘HPH」","L"
		ENDSELECT
		;通常時
	ELSE
		IF TALENT:恋慕
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 「음... 이렇게 있는 우리 모습이 정말 좋아.」
					PRINTFORML 「참 따뜻하고 마음이 편안해...」
				CASE 0
					PRINTFORML 「뭐야, %CALLNAME:MASTER%～\/\/\/」
					PRINTFORML 「네가 그렇게 느끼고 있다니 정말 기쁘지만... 우리가 지금 어디에 있는지 좀 생각해 봐야 해, 알겠지?」
				CASEELSE
					;恋慕ついて抱きつけないってのは、まあなさそうだけど……
					PRINTFORML 「저기, 잠깐, 지금은 좀...」
			ENDSELECT
		ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:142
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 「후후... %CALLNAME:MASTER%... 나 더 세게 안아줘, 알겠지...?」
					PRINTFORML 「그래야 내 몸의 열기를 느낄 수 있으니까...」
				CASE 0
					PRINTFORML 「아흠... 무슨 일이야? 갑자기 내 몸에 홀린 거야?」
				CASEELSE
					PRINTFORML 「미안하지만 지금은 안 될까?」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 「조금만 더... 이렇게 있을 수 있을까... 조금만 더?」 %CALLNAME:MASTER%...\/\/\/
					PRINTFORML (왜 그럴까... 정말 행복하다...)
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%, 아무에게나 이렇게 해줄 거야...?」
					PRINTFORML (그렇다면, 조금 서운할 것 같아... 아주 조금만.)
				CASEELSE
					PRINTFORML 「미안해... 지금은 안 돼.」
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 「아흠, %CALLNAME:MASTER%～...\/\/\/」
