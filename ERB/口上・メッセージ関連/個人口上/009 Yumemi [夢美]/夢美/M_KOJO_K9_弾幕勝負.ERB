; Modular ERB: 個人口上/009 Yumemi [夢美]/夢美/M_KOJO_K9_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K9_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「음? 나랑 단마쿠 대결을 하고 싶다고?」
		PRINTFORML 「흥... 받아주지. 아, 알아두는데, 난 절대로 봐줄 생각 없어, 알겠지?」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 「아직 끝나지 않았어, 이걸 어때?」
			CASE 2
				PRINTFORML 「아, 맞았다고?! 하지만 아직 끝나지 않았어!」
			CASE 1
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「젠장!! 이게 끝인가?!」
					CASE 1
						PRINTFORML 「아아앗, 이제 안 돼!! ……일지도\/\/\/」
					CASE 2
						PRINTFORML 「아직이야, 아직 끝나지 않았어, %CALLNAME:MASTER%!!」
					CASEELSE
						PRINTFORML 「뭐라고?! 불가능해! 몰렸다고?!」
				ENDSELECT
			CASE 0
				PRINTFORML 「뭐라고?! 내가 졌다고?」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		PRINTFORML 「나는 치유리가 나를 때릴 때보다 더 세게 너에게 온다...!」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		PRINTFORML 「이걸 한 방으로 끝내겠다!」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORML 「『딸기 위기 파워』… 발동!」
		PRINTFORMDW 아, 제발...! 변신 시퀀스가 눈 깜짝할 새에 끝났어!
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 「아직 갈 길이 멀군... 나중에 다시 시도해 봐.」
			CASE 2
				PRINTFORML 「나에게 단 한 번이라도 명중시키려 하다니... 너도 꽤 괜찮구나, 다음에 또 대결하자.」
			CASE 1
				PRINTFORML 「휴~... 조금만 더 버텼으면 끝났을 텐데.」
				PRINTFORML 「다음에 이길지도 몰라, 알잖아?」
			CASE 0
				PRINTFORML 「졌을 줄은 몰랐어... 나도 꽤 자신 있었는데...」
				PRINTFORML 「좋은 시합이었어, 다음에 또 하자.」
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
