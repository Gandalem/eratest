@M_KOJO_EVENT_K9_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;追い出される以外の遭遇を統合
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;★トイレを入れたい(典口上のネタ),拠点_大家を使えばトイレの場所をある程度制御出来るかも(要実験)？複数トイレが同一大家である時は今日の運勢を使うか
		;オナバレ／前夜オナニーしたかどうかを最初の遭遇時点で処理
		IF (CFLAG:1000 != 0 || CFLAG:41 != 0)
			CALL M_KOJO_EVENT_K9_ENCOUNT_AFTER_ONA
		ENDIF
		IF TALENT:恋慕
			PRINTFORML 「헤이 %CALLNAME:MASTER%, 나 보러 왔어?」
		ELSEIF TALENT:愛欲 || TALENT:セフレ
			PRINTFORML 「오, 당신이군, 나와 재미있게 놀러 온 거야?」
			PRINTFORMDW "아니. 아니, 안 왔어."
			PRINTFORML 「흥, 당신은 재미가 없네. 뭐... 마음 바뀌면 언제든지 알려줘, 알았지?」
		ELSEIF TALENT:8
			PRINTFORML 「아, %CALLNAME:MASTER%. 오늘 뭐 하고 있어?」
		ELSE
			PRINTFORML 「아라, %CALLNAME:MASTER%. 뭔가 필요한 거 있니?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;★トイレを入れたい(典口上のネタ)
		;オナバレ／前夜オナニーしたかどうかを最初の遭遇時点で処理
		IF (CFLAG:1000 != 0 || CFLAG:41 != 0)
			CALL M_KOJO_EVENT_K9_ENCOUNT_AFTER_ONA
		ENDIF
		;(拠点MAPで)遭った
		IF TALENT:恋慕
			PRINTFORML 「오, %CALLNAME:MASTER%. 만나서 반갑다.」
		ELSEIF TALENT:愛欲 || TALENT:セフレ
			PRINTFORML 「아아, %CALLNAME:MASTER%, 그래서 네가 여기에 있었구나. 특별히 너를 찾고 있던 건 아니었어, 뭐 그런 거 말고.」
			CALL HPH_PRINT,@"「오늘 사정했어? 안 했으면 내가 도와줄 수 있는데 HPH」","W"
		ELSEIF TALENT:思慕
			PRINTFORML 「아, %CALLNAME:MASTER%, 여기도 있구나.」
		ELSE
			PRINTFORML 「아, 실례합니다.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;★排水口に出す、を入れたい
		;オナバレ／前夜オナニーしたかどうかを最初の遭遇時点で処理
		IF (CFLAG:1000 != 0 || CFLAG:41 != 0)
			CALL M_KOJO_EVENT_K9_ENCOUNT_AFTER_ONA
		ENDIF
		IF TALENT:恋慕
			PRINTFORML 「아라, 너도 목욕하고 있었구나. 나도 같이 할게.」
			PRINTFORMDW 당신이 대답하기를 기다리지 않고, 유메미가 당신에게 다가간다.
		ELSEIF TALENT:愛欲 || TALENT:セフレ
			CALL HPH_PRINT,@"「흠...후후 오늘, 목욕탕에서 만나게 되겠군... 그것도 나쁘지 않은 것 같아 후후」","W"
			PRINTFORMDW 유메미는 이미 섹스할 기분인 것 같다.
		ELSE
			PRINTFORML 「아, 너도 목욕 중이었구나... 뭐, 상관없어. 나도 들어갈게.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋慕
			PRINTFORML 「아… 미-미안해\/\/\/ 벌써 여기 있는 줄 몰랐어…\/\/\/」
			PRINTFORML 「아, 나중에 올게! 편하게 있어! 안녕!」
		ELSEIF TALENT:愛欲 || TALENT:セフレ == 1 || (TALENT:思慕 && TALENT:セフレ == 2)
			CALL HPH_PRINT,@"「아, 실례합니다. 여기에 계신 걸 못 봤네요.」","W"
			CALL HPH_PRINT,@"「나 그냥 거기 몸 구겨 넣을 수도 있겠지...흐음 뭐, 다음 기회에.」","W"
		ELSEIF TALENT:思慕
			PRINTFORML 「아… 미-미안해\/\/\/ 이미 와 있었는지 몰랐어…\/\/\/」
		ELSE
			PRINTFORML 「아… 이미 계셨던 걸까요… 실례했습니다…」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋慕
			PRINTFORML 「아, %CALLNAME:MASTER%… 저-저 정말 죄송하지만, 나중에 다시 와서 해 주시면 안 될까요?」
			PRINTFORMDW 당신은 함께 보낸 모든 시간을 근거로 그녀를 설득해 머물게 하려 하지만, 그녀는 거절한다.
			PRINTFORML 「알아요, 알아요, 하지만 오늘 정말 혼자 목욕을 즐기고 싶어요. 죄송해요.」
			PRINTFORMDW 뭐, 누구나 그런 날이 있는 법이지… 당신은 욕실을 나서는 것을 결정한다.
		ELSEIF TALENT:愛欲 || TALENT:セフレ == 1 || (TALENT:思慕 && TALENT:セフレ == 2)
			PRINTFORML 「오, %CALLNAME:MASTER%, 여기서 지금 바로 할까?」
			CALL HPH_PRINT,@"「---말하고 싶은 게 있지만... 오늘 혼자 목욕하고 싶어, 알겠지?」","W"
			PRINTFORMDW 그녀가 이 오랜 시간 동안 무엇 때문에 그렇게 자제하는지 확신할 수 없지만, 당신은 목욕탕을 나선다.
		ELSEIF TALENT:思慕
			PRINTFORML 「아, %CALLNAME:MASTER%…… 저, 정말 죄송하지만 나중에 다시 와 주시겠어요?」
			PRINTFORMDW 당신은 그녀가 함께 있어도 괜찮다고 말했으나, 그녀는 거절한다.
			PRINTFORML 「그, 그럴 리가! 우리는 아직 그렇게 친하지 않잖아요?! \/\/\/」
			PRINTFORMDW 얼마나 아쉬운지…… 결국 목욕탕을 나선다.
		ELSE
			PRINTFORML 「나 지금 들어갈 거니까 나가줄래?」
			PRINTFORMDW 모든 폭정에 항의하며, 당신은 재빨리 쫓겨난다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋慕
			PRINTFORML 「아라 %CALLNAME:MASTER%, 여기서 만나서 정말 반가워요.」
		ELSEIF TALENT:愛欲 || TALENT:セフレ == 1 || (TALENT:思慕 && TALENT:セフレ == 2)
			PRINTFORML 「아라, 혹시 %CALLNAME:MASTER% 아닐까요. 섹스할 사람 찾으시는 건가요?」
			PRINTFORMDW 당신은 그녀에게 그것이 외출하는 "유일한" 이유가 아니라고 설명하려 노력한다.
			CALL HPH_PRINT,@"「흠, 정말로? 음, 기분이 괜찮다면 그냥 나를 찾아와도 돼, 알겠지? HPH」","W"
			PRINTFORMDW 유메미는 도발적인 미소를 지으며 당신의 귓가에 속삭인다.
		ELSEIF TALENT:思慕
			PRINTFORML 「오, %CALLNAME:MASTER%, 우-우연이네, 여기서 너를 만나다니.」
		ELSE
			PRINTFORML 「안녕, %CALLNAME:MASTER%.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:恋慕
			;る～こと or ちゆりは特別メッセージあり
			IF ARG:1 == 2
				PRINTFORML 「루코토? 너 %조사처리(CALLNAME:MASTER,"로")% 뭘 하고 있는 거야?」
				PRINTFORML 「에? 데이트...? 크윽.... 그렇다면, 나랑도 데이트해 줄래?」
			ELSEIF ARG:1 == 8
				PRINTFORML 「치유리와의 데이트라고? 잠시라도 두 사람에게서 눈을 뗄 수가 없네...」
				PRINTFORML 「그렇다면, 나와도 데이트를 해줄래?」
			ELSE
				PRINTFORML 「아라, 데이트 중인 것 같네. 끼어도 될까?」
			ENDIF
			PRINTFORMDW "아... 더블 데이트라고?!"
			PRINTFORML 「하하, 농담이었어, 즐거운 시간 보내길 바라.」
		ELSEIF TALENT:愛欲 || TALENT:セフレ == 1 || (TALENT:思慕 && TALENT:セフレ == 2)
			;る～こと or ちゆりは特別メッセージあり
			IF ARG:1 == 2
				PRINTFORML 「루코토랑 오늘 즐거운 시간 보냈어? 네가 그렇게...개방적일 줄은 몰랐네.」
			ELSEIF ARG:1 == 8
				PRINTFORML 「오늘 치유리와 즐거운 시간을 보내고 있나? 네 타격 범위가 꽤 넓잖아?」
			ELSE
				PRINTFORML 「오, 오늘 눈여겨본 사람이 이 분인가?」
			ENDIF
			PRINTFORMDW "그렇게 말하지 않았으면 좋겠어!"
			PRINTFORML 「아, 내가 틀렸나 보네? 뭐, 두 분 즐거운 시간 보내세요.」
		ELSE
			PRINTFORML 「아, %CALLNAME:MASTER%님이 아니신가.」
			;る～こと or ちゆりは特別メッセージあり
			IF ARG:1 == 2
				PRINTFORML 「루코토랑 뭐 하고 있는 거야? 청소? 응? 데이트?」
				PRINTFORML (누군가랑 데이트라니... 정말 대단한 걸 만들어냈구나...)
			ELSEIF ARG:1 == 8
				PRINTFORML 「치유리를 가지고 뭘 하는 거야? 현장 조사? 하하? 데이트라니...?」
				PRINTFORML (치유리?! 데이트라고?! 예상외로 어른스러운 거네... 아니면 그녀가 %조사처리(CALLNAME:MASTER,"의")% 취향인가?)
			ELSE
				PRINTFORML 「여자랑 같이 뭐 하는 거야, 궁금하네?」
				PRINTFORML 「음? 데이트? 방해하는 것 같군, 미안해.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 8
	;2022/08/15 ARG=9から6,7を呼び出した後に8が表示されたので制御変更
	;デフォルトで神社に住んでなく且つ野良でないキャラの場合、住み込み考慮して(MAIN_MAP == 0 || MAIN_MAP == [n])が適切？
	IF LOCAL:1 && ARG == 8 && MAIN_MAP == 0
		;オナバレ／前夜オナニーしたかどうかを最初の遭遇時点で処理
		IF (CFLAG:1000 != 0 || CFLAG:41 != 0)
			CALL M_KOJO_EVENT_K9_ENCOUNT_AFTER_ONA
		ENDIF
		IF TALENT:恋慕
			PRINTFORML 「아라 %CALLNAME:MASTER%, 여기서 만나서 정말 반가워요.」
		ELSEIF TALENT:思慕
			PRINTFORML 「아라 %CALLNAME:MASTER%, 어, 우연이네, 여기에서 만나다니.」
		ELSEIF TALENT:愛欲 || TALENT:セフレ
			PRINTFORML 「아라, 혹시 %CALLNAME:MASTER%아니신가요. 섹스할 사람 찾으시는 건가요?」
			PRINTFORMDW 당신은 그녀에게 그것이 외출하는 "유일한" 이유가 아니라고 설명하려 노력한다.
		ELSE
			PRINTFORML 「안녕, %CALLNAME:MASTER%.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;ARG:1とデート中
	IF LOCAL:1 && ARG == 9
		;オナバレ／前夜オナニーしたかどうかを最初の遭遇時点で処理
		IF (CFLAG:1000 != 0 || CFLAG:41 != 0)
			CALL M_KOJO_EVENT_K9_ENCOUNT_AFTER_ONA
		ENDIF
		IF ARG:1
			IF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「아라? 저기 있는 두 사람...」
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				PRINTFORML 「아, 저 두 명은...」
			ELSE
				PRINTFORML 「음, 저 두 명은...」
			ENDIF
			;一人で外出
		ELSE
			IF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「어라? 저기... 설마 그게...」
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				PRINTFORML 「오? 내가 아는 사람이 있네...」
			ELSE
				PRINTFORML 「음, 저기 있는 사람이...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
