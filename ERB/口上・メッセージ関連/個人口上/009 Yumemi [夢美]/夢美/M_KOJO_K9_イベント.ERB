						;-------------------------------------------------
					CASE 3
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						IF LOCAL:1
							IF PALAM:潤滑 >= 5000
								PRINTFORML 「……어라, 내 팬티...? 너…… 그걸 갖고 싶다고?」
