;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	;PRINTFORMW 「I'll give you this %GIFT_NAME%, so please treat it well.」
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物を大事にする（700点以上）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	;IF STRCOUNT(SENSE, "かわいい/")
	;	PRINTFORMW 「I got such a cute present.」
	;ELSEIF 評価点 >= 800
	;	PRINTFORMW 「I got such a wonderful present.」
	;ELSE
	;	PRINTFORMW 「I got a nice present.」
	;ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	;IF STRCOUNT(SENSE, "身につける/")
	;	PRINTFORMW 「Maybe I'll start wearing this from tomorrow.」
	;ELSE
	;	PRINTFORMW 「Maybe I'll start carrying this from tomorrow.」
	;ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	;PRINTFORMW 「Let's put this on display.」
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	;PRINTFORMW 「I don't really like this～」
	RETURN 1
ENDIF
RETURN 1


;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================
;生○科学研究所ですって？私のログには何もないな(ADD 2022/01/23)
@M_KOJO_MESSAGE_COM_K9_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:4
				CASE 0
					RESULTS = 「Ara, good day. To challenge me to a bug fight, you're quite the diligent student.」
				CASE 1
					RESULTS = 「You're a new challenger (specimen), huh?」
				CASE 2
					RESULTS = 「It's not like I like (dueling) or anything!」
				CASE 3
					RESULTS = 「Took you long enough! Let's get this duel started.」
			ENDSELECT
	;		RESULTS = 「I'll clean the floor with you!」
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「Take a look at my %MUSHI_NAME%!」
	;		RESULTS = 「%MUSHI_NAME%! I choose you!」
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「This is the power of research!」
	;		RESULTS = 「Knock them out! %MUSHI_NAME%!」
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「How could this happen... Did I make a mistake?」
	;		RESULTS = 「Ahh! My %MUSHI_NAME%!」
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「I just wanted to know the taste of victory...」
				CASE 1
					RESULTS = 「Don't look at me with those eyes!」
				CASE 2
					RESULTS = 「Noooooo～～～...!」
			ENDSELECT
	;		RESULTS = 「All of my bugs were wiped out...」
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「This is what happens when you challenge me.」
				CASE 1
					RESULTS = 「Let's duel again, if we have the chance.」
				CASE 2
					RESULTS = 「This is the power of research!」
			ENDSELECT
	;		RESULTS = 「You're so weaaak～!」
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:6
				CASE 0
					RESULTS = 「Not bad, %CALLNAME:MASTER%.」
				CASE 1
					RESULTS = 「Gah, I lost. I'll win next time, though.」
				CASE 2
					RESULTS = 「Hmm, I guess this kind of thing happens sometimes.」
				CASE 3
					;汎用性高杉問題
					RESULTS = 「How could this happen... Did I make a mistake?」
				CASE 4
					;クワドロプルインセクティサァイド (略)[4]
					RESULTS = 「Maybe I should develop some specialized bug weapons...?」
				CASE 5
					;(略) オブガルガンチュア
					RESULTS = 「Maybe I should research some special bug armor...?」
			ENDSELECT
	;		RESULTS = 「You're too strooong～!」
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「I won!」
	;		RESULTS = 「I did it～！」
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「How could this happen... Did I make a mistake?」
				CASE 1
					RESULTS = 「While I still have reason... I won't lose next time!」
			ENDSELECT
	;		RESULTS = 「Noo～！」
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「This is only natural when you're with me.」
				CASE 1
					RESULTS = 「My victory is decided. I'll also pray for your success...」
			ENDSELECT
	;		RESULTS = 「It's all thanks to me!」
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:2
				CASE 0
					RESULTS = 「I just want to go home...and revise my battle strategy.」
				CASE 1
					RESULTS = 「How could this happen... Did I make a mistake?」
			ENDSELECT
	;		RESULTS = 「You guys are so weak!!」
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1

;==================================================
;スイカ割り
;スイカ割りの口上はムシバトル同様、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;カギ括弧は自動で付きます
;"衝突","結果"のみ、口上色が自動で付きます
;"衝突","結果"以外は半角26文字（全角13文字）までの文字数制限があります。はみ出ないように気をつけてください
;数パターンあると雰囲気が出ます（%TEXTR( / )%を使うと良い）
;==================================================
@M_KOJO_MESSAGE_COM_K9_SUIKA(ARGS, ARG)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1
	SELECTCASE ARGS
	CASE "衝突"
		;-------------------------------------------------
		;場外に出てあなたがキャラと衝突した際の台詞
		;文字数制限はありません,汎用台詞もありません
		;-------------------------------------------------
		RESULTS = Ouch! Hey, watch it!
	CASE "そこだ！"
		RESULTS = %TEXTR("There!/Now!")%
	CASE "近い"
		RESULTS = %TEXTR("Close! You're close!/You're getting closer!/Just a little more!")%
	CASE "遠い"
		RESULTS = %TEXTR("You're still far away./Still a long ways to go～")%
	CASE "かなり遠い"
		RESULTS = %TEXTR("You're nowhere closeー/You're still way offー")%
	CASE "前"
		RESULTS = %TEXTR("In front of you./Keep going that way./Over there.")%
	CASE "少し前"
		RESULTS = %TEXTR("Just a little forward!/A liiiittle forward./Just one more step!")%
	CASE "後ろ"
		RESULTS = %TEXTR("Behind you!/The other way!/Not that wayー")%
	CASE "少し後ろ"
		RESULTS = %TEXTR("Just behind you!/A liiiittle behind./Just one step back!")%
	CASE "右"
		RESULTS = %TEXTR("To your right./Right, right./More to the right.")%
	CASE "少し右"
		RESULTS = %TEXTR("A little to your right./A little more to the right.")%
	CASE "左"
		RESULTS = %TEXTR("To your left./Left, left./More to the left.")%
	CASE "少し左"
		RESULTS = %TEXTR("A little to your left./A little more to the left.")%
	CASE "結果"
		;-------------------------------------------------
		;終了後の一言
		;文字数制限はありません,汎用台詞もありません
		;TFLAG:193,
		;   -1=失敗
		;    0=成功
		;    1=大成功
		;    2=木刀で大成功（ボーナス点）
		;ARG
		;    0=正直者
		;    1=ウソつき
		;-------------------------------------------------
		SELECTCASE TFLAG:193
		CASE -1
			RESULTS = Too bad～
		CASE 0
			RESULTS = Nice going!
		CASE 1
			RESULTS = Wowー!
		CASE 2
			RESULTS = What a clean strike!
		ENDSELECT
	ENDSELECT
ENDIF

