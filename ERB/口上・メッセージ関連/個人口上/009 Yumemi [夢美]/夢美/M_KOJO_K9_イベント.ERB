@M_KOJO_SPEVENT_K9_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
IF LOCAL
	PRINTFORML 「헤이 %CALLNAME:MASTER%, 잠시만 눈을 감아줄래?」
	PRINTFORMDW 네가 동의하고 눈을 감자, 코끝에 갑자기 가볍고 기분 좋은 향기가 밀려온다.
	PRINTFORMDW 무언가 부드러운 것이 입술에 닿는 것을 느낀다.
	PRINTFORMDW 놀라서 눈을 뜨니, 유메미가 얼굴을 붉힌 채 네 앞에 서 있다.
	PRINTFORML 「후후, 그게 내 첫 키스였어, 알지?」
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K9_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF FIRSTTIME("告白")
			;初回
			PRINTFORMDW 유메미는 당신이 손을 흔들며 등을 돌리는 것을 지켜본다.
			PRINTFORML (어떻게 해야 할까... 말해야 할까? 만약 말한다면 되돌릴 수 있을까?)
			PRINTFORML (모르겠어. 아무리 생각해도 알 수가 없어.)
			PRINTFORML (그렇다면 생각할 의미가 없지. 말하는 것 외에는 다른 선택지가 없어.)
			PRINTFORML (%조사처리(CALLNAME:MASTER,"에게")% %HIM_HER(MASTER,,1)%를 좋아한다고 말해야 한다면...)
			PRINTFORML 「...만약 %HIM_HER(MASTER,,1)%에게 말한다면...」
			PRINTFORML (준비가 되었는지 모르겠지만... 지금이 유일한 기회야.)
			PRINTFORMDW 결심을 다지며, 그녀는 당신을 부른다.
			PRINTFORML 「잠깐만요.」
			PRINTFORMDW 막 떠나려 할 때, 뒤에서 유메미의 목소리가 들린다.
			PRINTFORMDW 당신은 돌아보며 그녀가 무슨 생각을 하는지 묻는다.
			PRINTFORMDW 유메미는 심각한 표정으로 당신을 바라보고 있으며, 얼굴이 살짝 붉어져 있다.
			PRINTFORML 「제가 할 말이 있어요... 말해야겠어요.」
			PRINTFORMDW 그녀는 심호흡을 하고 말을 한다.
			PRINTFORML 「사랑해요.」
			PRINTFORMDW 당신은 멍한 표정으로 그녀를 바라본다.
			PRINTFORML 「저, 오카자키 유메미가 당신을 사랑하게 됐어요. 그래서... 그러니까...」
			PRINTFORML 「제 여자친구가 되어 주세요!」
			PRINTFORMDW 농담의 기색은 전혀 없다. 그녀는 완전히 진지하다.
			PRINTFORMDW 그녀가 이런 일에 대해 농담할 법한 사람이 아니다.
			PRINTFORMDW 당신은 그녀에 대해 충분히 알 만큼 알고 있다.
			PRINTFORMDW 유메미는 당신에게 자신의 진심을 고백하고 있었다.
		ELSE
			;2回目以降
			PRINTFORML 「지난번에 나 거절했었지...하지만 너에 대한 내 감정은 변하지 않았어.」
			PRINTFORML 「난 여전히 너를 사랑해.」
			PRINTFORMDW 유메미는 네가 지난번 거절했던 일이 없었던 것처럼 미소를 짓는다.
			PRINTFORML 「그 이후로 좀 더 생각해 봤어?」
			PRINTFORML 「다시 물어볼게.」
			PRINTFORML 「나... 너의 여자친구가 되어 줄래?\/\/\/」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:1101 == 0
			PRINTFORML 「정말...? 정말 나한테 괜찮은 거야...? 말도 안 돼, 믿을 수가 없어... 우우... 아... %CALLNAME:MASTER%!」
			PRINTFORMDW 유메미가 달려와 당신의 가슴팍으로 곧 뛰어든다.
			PRINTFORML 「...너무 행복해... 만약 거절했더라면, 난 어떻게 해야 할지 몰랐을 거야...! 우아아...!」
			PRINTFORMDW 눈물을 흘리며 당신에게 매달리는 그녀를 보며, 고백하기까지 얼마나 큰 담력을 가졌을지 상상할 수밖에 없다.
			PRINTFORMDW 깨닫기도 전에, 당신은 부드럽게 그녀의 머리를 쓰다듬는다.
			PRINTFORML 「응... 후후, 너무 행복해... 계속 내 머리 쓰다듬어 줄래?」
			PRINTFORMDW 옷이 눈물로 얼룩진 채, 유메미가 당신을 바라본다.
			PRINTFORMDW 당신은 유메미에게 이전에 느껴보지 못한 더 강한 연모의 감정을 느낀다.
			PRINTFORMDW 견딜 수 없어, 당신은 입술을 유메미의 입술로 가져간다.
			PRINTFORMDW 긴 키스를 나눈 후, 두 사람은 입술을 떼고 유메미는 미소를 지으며 말한다.
			PRINTFORML 「이제부터 나는 당신의 보살핌을 받을 거야... 나의 사랑하는 %CALLNAME:MASTER%.」
		ELSE
			PRINTFORML 「나, 나 드디어 해냈어~~... 내가 얼마나 기다렸는지 상상도 못 할 거야...」
			PRINTFORML 「이건... 우우... 긴 여정이었어... 와... 훌쩍...」
			PRINTFORMDW 그녀에게 왜 우는 건지 묻는다.
			PRINTFORML 「아니! 나 울지 않아...! 우웅~...!」
			PRINTFORMDW 그녀의 부인에도 불구하고, 얼굴은 점점 더 엉망이 되어간다.
			PRINTFORML 「아아악~! 정말 기뻐! 이 바보야~!」
			PRINTFORMDW 유메미가 당신의 팔로 뛰어들어 가슴을 주먹으로 치기 시작한다.
			PRINTFORML 「이제 절대로 너를 놓아줄 리 없어... 후후.」
			PRINTFORMDW 유메미는 만족스러운 미소를 지어 보인다.
			PRINTFORMDW 정말 무서운 여자다... 그녀 주변에서는 경계를 늦추지 않는 편이 좋겠다.
			;断られフラグをOFF
			CFLAG:1101 = 0
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:1101 == 0
			PRINTFORML 「...음, 음~~... 아, 알겠어... 아니, 응...」
			PRINTFORML 「우으... 난, 안... 후읍... 울고 있어...!」
			PRINTFORML 「나 안 울어, 안 울어...! 바보 같아...」
			PRINTFORMDW 너는 그녀의 마음을 받아들일 수 없었지만...
			PRINTFORMDW 너 또한 그녀가 이렇게 있는 것을 볼 수도 없다.
			PRINTFORMDW 너는 유메미를 부드럽게 껴안고, 그녀의 눈물이 멎을 때까지 인내심 있게 붙잡아준다.
			PRINTFORML 「...바보 같아, 왜 그렇게 잘해주는 거야... 전혀 모르겠어.」
			PRINTFORMDW "그냥 너를 내버려 둘 수는 없었거든."
			PRINTFORML 「...네가 방금 나를 거절했음에도 불구하고...」
			PRINTFORMDW "뭐, 그건 별개의 문제야――"
			PRINTFORML 「이렇게 다정하게 대해주니... 포기하고 싶지 않게 되잖아, 있잖아...?」
			PRINTFORMDW ――Eh?
			PRINTFORML 「그렇게 말했으니, 나는 당신을 포기하지 않을 거야!」
			PRINTFORMDW 설마?!
			PRINTFORML 「나는 이미 충분히 귀하다고 생각했는데, 앞으로 갈 길이 멀어 보이는구나. 그래서...」
			PRINTFORML 「나는 훨씬 더 귀여워질 테니까, 심지어 당신도 나를 보는 것조차 힘들 정도가 될 거야!」
			;断られフラグをON
			CFLAG:1101 = 1
		ELSE
			PRINTFORML 「음~ 아무래도 아직 안 되는 건가...」
			PRINTFORML 「나를 그렇게 여러 번 거절하는 걸 보니 이미 다른 사람에게 마음을 정한 것 같아.」
			PRINTFORMDW 무언가를 중얼거리며 화제를 피하려 했다.
			PRINTFORML 「아라 아라? 내가 제대로 맞췄어?～」
			PRINTFORML 「...음, 그렇다면 그냥 말해줘, 그럼 착한 여자애처럼 포기할게.」
			PRINTFORML 「하지만 그때까지는 나를 떨쳐내지 못했잖아!」
			PRINTFORML 「그럼 다음에 보자, %CALLNAME:MASTER%.」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
