		CASE "衝突"
			;-------------------------------------------------
			;場外に出てあなたがキャラと衝突した際の台詞
			;文字数制限はありません,汎用台詞もありません
			;-------------------------------------------------
			RESULTS = Ouch! Hey, watch it!
		CASE "そこだ！"
			RESULTS = %TEXTR("There!/Now!")%
		CASE "近い"
			RESULTS = %TEXTR("Close! You're close!/You're getting closer!/Just a little more!")%
		CASE "遠い"
			RESULTS = %TEXTR("You're still far away./Still a long ways to go～")%
		CASE "かなり遠い"
			RESULTS = %TEXTR("You're nowhere closeー/You're still way offー")%
		CASE "前"
			RESULTS = %TEXTR("In front of you./Keep going that way./Over there.")%
		CASE "少し前"
			RESULTS = %TEXTR("Just a little forward!/A liiiittle forward./Just one more step!")%
		CASE "後ろ"
			RESULTS = %TEXTR("Behind you!/The other way!/Not that wayー")%
		CASE "少し後ろ"
			RESULTS = %TEXTR("Just behind you!/A liiiittle behind./Just one step back!")%
		CASE "右"
			RESULTS = %TEXTR("To your right./Right, right./More to the right.")%
		CASE "少し右"
			RESULTS = %TEXTR("A little to your right./A little more to the right.")%
		CASE "左"
			RESULTS = %TEXTR("To your left./Left, left./More to the left.")%
		CASE "少し左"
			RESULTS = %TEXTR("A little to your left./A little more to the left.")%
		CASE "結果"
			;-------------------------------------------------
			;終了後の一言
			;文字数制限はありません,汎用台詞もありません
			;TFLAG:193,
			;   -1=失敗
			;    0=成功
			;    1=大成功
			;    2=木刀で大成功（ボーナス点）
			;ARG
			;    0=正直者
			;    1=ウソつき
			;-------------------------------------------------
			SELECTCASE TFLAG:193
				CASE -1
					RESULTS = Too bad～
				CASE 0
					RESULTS = Nice going!
				CASE 1
					RESULTS = Wowー!
				CASE 2
					RESULTS = What a clean strike!
			ENDSELECT
	ENDSELECT
ENDIF
