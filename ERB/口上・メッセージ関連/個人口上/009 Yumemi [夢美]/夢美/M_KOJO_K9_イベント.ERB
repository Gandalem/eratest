@M_KOJO_SPEVENT_K9_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML 「재미있었어, %CALLNAME:MASTER%. 다음에 또 데이트 신청해줘.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「오늘 나랑 데이트해줘서 고마워, %CALLNAME:MASTER%.」
		PRINTFORML 「정말 즐거웠어... 그래서 음, 다음에 또 같이 나가면 기쁠 것 같아.」
		PRINTFORML 「예전 일은 다 털었으니까... 그냥 잊고 앞으로 가자, 알겠지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「...오늘도 고마워...」
		PRINTFORML 「오늘만큼 재미있다면, 또 데이트해도 상관없을 것 같아...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「...흥.」
		PRINTFORML (아직 기분이 안 좋지만... 그래도 %HE_SHE(MASTER)% 나쁘지 않은 것 같아.)
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
