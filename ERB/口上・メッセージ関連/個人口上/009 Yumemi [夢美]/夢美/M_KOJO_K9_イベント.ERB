					;-------------------------------------------------
					CASE 0
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						IF LOCAL:1
							PRINTFORML 「음, 괜찮긴 하지만……」
							PRINTFORML 「당신 것 좀 가져가도 될까요?」
