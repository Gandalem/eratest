@M_KOJO_EVENT_K9_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「아라, %CALLNAME:MASTER%, 지금 시간 돼?」
					PRINTFORML 「같이 데이트할래?」
				ELSEIF TALENT:思慕
					PRINTFORML 「아, %CALLNAME:MASTER%…… 저, 저기…… 괜찮다면……」
					PRINTFORML 「데, 데이트…… 하러 가지 않을래?\/\/\/」
				ELSEIF TALENT:愛欲
					PRINTFORML 「오, %CALLNAME:MASTER%, 타이밍이 좋네. 지금 한가하지, 그렇지?」
					PRINTFORML 「사랑에 빠질... 같이 데이트할래?」
					PRINTFORMDW 수상한 걸 들었을 거라고 확신하지만, 그냥 넘어가 주었다.
				ELSE
					;セフレとか無印で誘われるのかという疑問はあれど
					PRINTFORML 「그냥 나랑 같이 어디 놀 사람을 찾고 있었어.」
					PRINTFORML 「같이 갈래?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「야호! 결정됐네. 가자!」
					PRINTFORMDW 유메미는 귀가 입꼬리까지 올라간 채 미소 지으며 당신을 바라본다.
				ELSEIF TALENT:思慕
					PRINTFORML 「에, 정말이야? 괜찮아?」
					PRINTFORML 「음... 고-고마워...\/\/\/」
				ELSEIF TALENT:愛欲
					PRINTFORML 「후훗, 기뻐요.」
					PRINTFORML 「그럼 바로 가자고요.」
				ELSE
					;セフレとか無印で誘われるのかという疑問はあれど
					PRINTFORML 「그럼 가자.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「아라, 그거 안됐네. 오늘 너한테 좋은 날은 아니었나 봐?」
				ELSEIF TALENT:思慕
					PRINTFORML 「아... 오, 알겠어...」
					PRINTFORML (다른 기회도 있겠지... 그렇지?)
				ELSE
					;セフレとか無印で誘われるのかという疑問はあれど
					PRINTFORML 「아, 알겠군.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;流石にセフレのみとか無印は部屋に呼ばれやすまいよ
				IF TALENT:恋慕
					PRINTFORML 「밖에 나가는 것보다 내 방에서 함께 시간을 보내는 게 어때?」
				ELSEIF TALENT:思慕
					PRINTFORML 「야, %CALLNAME:MASTER%... 오늘 내 방에 올래?」
				ELSEIF TALENT:愛欲
					CALL HPH_PRINT,@"「내 방에 들어오고 싶지 않아...? HPH」","L"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「고마워. 그럼 가자.」
				ELSEIF TALENT:思慕
					PRINTFORML 「좋아... 그럼 갈까?」
					PRINTFORML (나... 나 정리했지...? 내 옷이랑 속옷이 널려있지는 않기를...)
				ELSEIF TALENT:愛欲
					CALL HPH_PRINT,@"「후훗, 그럼... 갈까?」","L"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;Case 2に統合しても良いかもね
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「아라, 그거 안됐네. 오늘 너한테 좋은 날은 아니었나 봐?」
				ELSEIF TALENT:思慕
					PRINTFORML 「아... 어, 알겠어...」
					PRINTFORML (너무 강압적이었을까...? %HE_SHE(MASTER)%이 이상하게 생각하지 않았으면 좋겠다...)
				ELSE
					;セフレとか無印で誘われるのかという疑問はあれど
					PRINTFORML 「아, 알겠군.」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
