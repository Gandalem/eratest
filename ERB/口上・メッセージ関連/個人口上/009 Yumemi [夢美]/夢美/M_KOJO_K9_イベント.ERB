					IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
						CALL HPH_PRINT,@"「더 이상 참을 수가 없어... 바로 시작할까?HPH」","L"
					ELSE
						PRINTFORML 「그렇게 자세히 보지 마... 민망하잖아.」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
			;下着姿にする
			;-------------------------------------------------
		CASE 1
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			IF LOCAL:1
				;時間停止時
