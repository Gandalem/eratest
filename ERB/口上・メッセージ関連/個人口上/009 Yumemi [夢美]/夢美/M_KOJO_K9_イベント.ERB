@M_KOJO_EVENT_K9_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「하아... 하아... %CALLNAME:MASTER%...」
					CALL HPH_PRINT,@"「이렇게 나를 흥분시키고 있네... 음... 후후 그리고 내가 너를 필요로 할 때 네가 여기에 없다는 게... 바보 같아.」","L"
					CALL HPH_PRINT,@"「아... 우우... 음... 흐읍」","L"
					PRINTFORML 「다음에 너 만날 때 나랑 엄청 많이 해줄게... 그러니까 지금은... 이걸로 만족해줘...\/\/\/」
					CALL HPH_PRINT,@"「흐으으 나 갈 것 같아...후읍... 응? %CALLNAME:MASTER%...?」","L"
				ELSEIF TALENT:愛欲
					CALL HPH_PRINT,@"「흐음... 아아헵 하아헵... %CALLNAME:MASTER%...헵」","L"
					CALL HPH_PRINT,@"「저기... 좋다 HPH 더 HPH 후아아, 아아 HPH 나, 갈 것 같아... 온다 HPH」","L"
					CALL HPH_PRINT,@"「나아아흐프 아아아흐프 절정하는 프하 저는 사정하고 있어요 %CALLNAME:MASTER%프하」","L"
					CALL HPH_PRINT,@"「아아, 나 사정하고 있어HPH 아, 아, 에, %CALLNAME:MASTER%? 뭐야...\/\/\/」","L"
				ELSEIF TALENT:思慕 || (TALENT:思慕 && TALENT:セフレ == 2)
					CALL HPH_PRINT,@"「음... 아... 음... 흐읍」","L"
					CALL HPH_PRINT,@"「하아... 으음... 좋다... 하프」","L"
					PRINTFORML (왜 지금이야... 왜 나는 %CALLNAME:MASTER%에 대해 생각하고 있는 거지...)
					PRINTFORML 「응 응... 나 이제... %CALLNAME:MASTER%... 어라, 응...?」
				ELSE
					CALL HPH_PRINT,@"「음... 음... 응, 거기... 하프 조금만 더... 하프」","L"
					CALL HPH_PRINT,@"「아흐읍, 그거 좋네. 흐으읍, 응... 어?」","L"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「나-너랑 섹스하고 싶어서 그런 것도 아니고, 네가 안 하니까 이러는 것도 아니야... 응?」
					PRINTFORML 「뭐야, 어디 가는 거야?! 정말 아무것도 못 본 척 할 작정이야?」
					PRINTFORMDW 유메미와 계속 있고 싶은 마음이 간절함에도, 세상의 욕망들을 머릿속에서 몰아내고 방을 나간다...
					PRINTFORML 「나중에 기분이 들면 울면서 찾아오지 마!」
				ELSEIF TALENT:愛欲 || TALENT:セフレ == 1
					CALL HPH_PRINT,@"「아라... %CALLNAME:MASTER%...후우, 기다리고 있었어...후우」","L"
					PRINTFORML 「너랑 하고 싶어서 나 혼자 손가락으로 애들 만지고 있었어... 그리고 네가 드디어 왔구나.」
					PRINTFORML 「나랑 섹스해 줄 거지~ ... 잠깐, 너 떠나는 거야? 농담이지?!」
					PRINTFORML 「저기, 잠깐만?! 더는 참을 수가 없어!」
					PRINTFORML 「이 바보야! 내가 꼭 널 나한테 박게 만들 거야!」
				ELSEIF TALENT:思慕 || (TALENT:思慕 && TALENT:セフレ == 2)
					PRINTFORML 「어... 음... 결국 나도 인간이니까 가끔 기분이 좋아지기도 해...」
					PRINTFORML 「네 이름을 부른 이유에 대해서는... 뭐, 애초에 네가 왜 여기에 있는지는 모르겠네...」
					PRINTFORMDW 유메미가 변명하듯 중얼거리지만, 당신은 그냥 몸을 돌려 방을 나간다...
					PRINTFORML 「그래서, 음, 있잖아... 잠깐, %HE_SHE(MASTER)%이 사라졌어... %HIM_HER(MASTER,,1)%는 뭐야...」
				ELSE
					PRINTFORML 「하하, 내가 이런 걸 하는 걸 봤나 보네...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					PRINTFORML 「그럼 계속할게……으음읏……\/\/\/」
					CALL HPH_PRINT,@"「봐 %CALLNAME:MASTER%, 너 생각하니까 벌써 이렇게 흥분했어...후후 알고 있었어?」","L"
					CALL HPH_PRINT,@"「외로울 때... 항상 나 자신을 만지곤 해, 이렇게... 아아흐헵」","L"
					CALL HPH_PRINT,@"「사실은, 후아아, 지금 너랑 섹스하고 싶어...흐프 하지만 일단은, 냐아, 이것만...\/\/\/」","L"
				ELSEIF TALENT:愛欲 || TALENT:セフレ == 1
					CALL HPH_PRINT,@"「하아...흐읍 당신은 나에게 계속하게 하려는 거야...? 흐읍... 정말 변태구나... 흐읍」","L"
					PRINTFORMDW "물론이야"라고 그녀에게 말한다., you tell her.
					CALL HPH_PRINT,@"「그런가요...후후. 그럼 내가 기분 좋게 만드는 걸 잘 지켜봐야 할 거예요... 알겠죠? 후후」","L"
					CALL HPH_PRINT,@"「당신이 모든 것을 보는 동안 스스로를 애무하는 것, 정말 굉장해」","L"
					CALL HPH_PRINT,@"「이거 하면 안 되는데 HPH 푸아아 HPH 중독될 거야 HPH」","L"
				ELSEIF TALENT:思慕 || (TALENT:思慕 && TALENT:セフレ == 2)
					PRINTFORML 「음... 나 혼자 하는 거 보는 걸 원해...?」
					PRINTFORML 「굉장히 창피한 소리지만, 당신이라면 괜찮을 것 같아...」
					PRINTFORML (왜 이럴까... %CALLNAME:MASTER%이라면 오히려 보고 싶어지는 기분이야...)
					CALL HPH_PRINT,@"「그럼... 시작할 거야... 음흐읍 %CALLNAME:MASTER%... 푸아... 음흐읍」","L"
					CALL HPH_PRINT,@"「평소보다 더 축축해지고 있어... 아아ㅎㅍ 평소랑 너무 달라... 아아... 네가 바로 여기 있는데도」","L"
				ELSE
					;ここに入ることはあるのか
					PRINTFORML 「에헤... 다른 사람이 자기 몸을 만지는 걸 보고 싶다니, 정말 이상하다...」
					PRINTFORML (.... 그냥 보는 거라면 괜찮겠지... 어쨌든 기분은 좋을 테니까.)
					PRINTFORML 「음, 뭐, 그렇겠지. 이번 한 번만 특별히 예외를 두어서 네가 보게 해줄게.」
					CALL HPH_PRINT,@"「하지만 내가 끝내면 바로 가줘, 알겠지...? 흐으흣」","L"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「뭐야…… 여기서 나가! 바보 같긴!」
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:処女
					PRINTFORML 「기, 그러니까... 처음이에요...」
					PRINTFORML 「이런 걸 하는 게 제... 첫 경험이라서...」
					PRINTFORML 「부드럽게 해 주세요, 알겠죠?」
				ELSEIF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ == 1 || (TALENT:思慕 && TALENT:セフレ == 2)
					CALL HPH_PRINT,@"「...HPH 나를 손가락으로 만질 거야?HPH... 그럼 이리 와, %CALLNAME:MASTER%HPH」","L"
					PRINTFORMDW 유메미가 당신 쪽으로 돌아보며 그녀의 움찔거리는 모습을 %FSYN("wet")% %FSYN("vagina")%로 드러낸다.
					CALL HPH_PRINT,@"「나의 %FSYN("vagina")%은 이렇게 되었어, 너를 기다리면서...HPH」","L"
					CALL HPH_PRINT,@"「나한테 정말 기분 좋게 해줘...HPH」","L"
				ELSEIF TALENT:思慕
					PRINTFORML 「%CALLNAME:MASTER%…… 나와 함께 그것을 하고 싶어?」
					PRINTFORMDW 그녀에게 네라고 말한다.
					PRINTFORML 「정말 창피한 기분이 들지만, 당신이라면 괜찮을지도 몰라……」
					PRINTFORML (왜 그럴까…… %CALLNAME:MASTER%이라면 정말 하고 싶다는 생각이 들어……)
					CALL HPH_PRINT,@"「그러면... 하자... 더 가까이 와, %CALLNAME:MASTER%...HPH」","L"
				ELSE
					;ここに入ることはあるのか
					PRINTFORML 「……나랑 하고 싶어?」
					PRINTFORML (음, %HE_SHE(MASTER)%이 나를 기분 좋게 해준다면 괜찮을지도……?)
					PRINTFORML 「좋아, 할 수 있게 해줄게. 어차피 기분 좋아지고 싶었으니까.」
					CALL HPH_PRINT,@"「하지만 우리가 끝나는 대로 떠줘... 푸아아흐프」","L"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					CALL HPH_PRINT,@"「하아, 하아... 굉장했어 HPH」","L"
					CALL HPH_PRINT,@"「나 왔어, 너무...흐읍」","L"
					PRINTFORMDW 유메미는 숨을 조절하려 애쓰며 당신을 바라본다.
				ELSEIF TALENT:愛欲 || TALENT:セフレ == 1 || (TALENT:思慕 && TALENT:セフレ == 2)
					CALL HPH_PRINT,@"「하아, 하아... 굉장했어 HPH」","W"
					CALL HPH_PRINT,@"「이렇게 느껴지니 너무 좋아...흐읍 흥분돼버렸어...흐읍」","W"
					PRINTFORMDW 유메미는 황홀한 상태로 당신을 바라본다.
				ELSEIF TALENT:思慕
					PRINTFORML 「하아, 하아...」
					PRINTFORML 「나의 그런 부끄러운 모습을 봤구나...」
					PRINTFORML (하지만... 만약 %CALLNAME:MASTER%이라면... 괜찮아...)
				ELSE
					PRINTFORML 「하아…… 하아…… 생각보다 훨씬 좋았어……\/\/\/」
					CALL HPH_PRINT,@"「다음에 다시 전화할지도 모르겠어HPH」","L"
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕 || TALENT:愛欲
					CALL HPH_PRINT,@"「하룻밤 머물고 싶다고? 물론이지 HPH」","L"
					CALL HPH_PRINT,@"「후훗, 오늘 밤을 마음껏 즐겨 볼까? %CALLNAME:MASTER%...후훗」","L"
				ELSE
					PRINTFORML 「응? 여기서 자고 싶다고? 그럼 당연하지...」
					PRINTFORML 「여분 침대가 있었던 건가...」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
