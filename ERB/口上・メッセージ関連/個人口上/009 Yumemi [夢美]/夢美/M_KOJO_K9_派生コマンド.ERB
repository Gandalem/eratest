@M_KOJO_MESSAGE_SCOM_K9_14_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「무슨 일이야...? 갑자기 내 뒤에서 멈추다니...」
		PRINTFORMDL 유메미는 움직임이 갑자기 멎은 것에 당황한 기색을 보였으나, 당신은 그저 그녀의 안쪽을 더욱 깊숙이 파고들 준비를 하고 있었을 뿐이다.
		CALL HPH_PRINT,@"「오고호~ 허프... 와... 소, 깊이, 안쪽으로...」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;時姦中
		IF FLAG:70
			;前回射精した
		ELSEIF TCVAR:104
			;尻穴狂いあり
			IF TALENT:75 == 1
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「너무 뜨거워 HPH 네 정액 HPH 그것이 흘러내리고 있어 HPH 너무 깊숙이 안에 HPH」","W"
						CALL HPH_PRINT,@"「더 많이, 더 세게 HPH 내 구멍을 절정으로 이끌어줘, 더 깊숙이 HPHHPHHPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「하아흐프 정액, 내 뒤에 프ㅎ 너무 뜨거워」","W"
						CALL HPH_PRINT,@"「너는 내 뒤에 원하는 만큼 싸도 돼HPH 더 깊이 채워줘HPHHPHHPH」","W"
				ENDSELECT
				;A感5以上
			ELSEIF ABL:2 >= 5
				CALL HPH_PRINT,@"「아하햬 너무 축축해, 내 안이햬 깊숙이, 내 뒤에 네 거햬」","W"
				CALL HPH_PRINT,@"「괜찮아 HPH 기분이 좋아 너무 깊어 HPH 나 더 박아줘 HPH」","W"
				;A感2以上
			ELSEIF ABL:2 >= 2
				CALL HPH_PRINT,@"「아, 안 돼, 오 안 돼, 내 항문 안에 정액이 들어와서, 기분이 좋아, 하아」","W"
				;それ以外
			ELSE
				PRINTFORML 「큭, 잠깐만…… 뜨, 뜨거워…… 안쪽으로, 얼마나 깊이 흘러들어오는 거야……\/\/\/」
			ENDIF
			RETURN 1
		ELSE
			;尻穴狂いあり
			IF TALENT:75 == 1
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아~하아헵 난 연모해헵 내 뒤꽁무니-보지헵 박히는헵」","W"
						CALL HPH_PRINT,@"「더한 HPH 내 도착적인 뒤에 박아줘 더 깊이 HPHHPHHPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「하아헵 네 거헵 너무 뜨거워 내 뒤에헵」","W"
						CALL HPH_PRINT,@"「연모해줘 HPH 너무 깊어 HPH 신경 안 써 HPH 얼마나 도착적인지 이대로 HPH 나 더 박아줘 HPH 더 세게 HPHHPHHPH」","W"
				ENDSELECT
				;A感5以上
			ELSEIF ABL:2 >= 5
				CALL HPH_PRINT,@"「안에 있네요 HPH 당신의 거, 아주 깊이 HPH 네, 바로 거기에 HPH」","W"
				CALL HPH_PRINT,@"「여기서 박히는 게, 느껴져, 너무 좋아, 이제 HPH 더 깊게HPH」","W"
				;A感2以上
			ELSEIF ABL:2 >= 2
				CALL HPH_PRINT,@"「으윽 허어 안 돼 내 목소리 흑 설령 안에 있어도 엉덩이에」","W"
				;それ以外
			ELSE
				PRINTFORML 「크윽... 아... 너무 깊숙이 밀어 넣지 마, 갑자기......\/\/\/」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
