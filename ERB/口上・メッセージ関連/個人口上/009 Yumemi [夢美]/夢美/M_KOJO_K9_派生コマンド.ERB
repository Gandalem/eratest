;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K9_6
CALL M_KOJO_MESSAGE_SCOM_K9_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K9_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「...무슨 일이야? 우리... 그만두는 거야?」
		PRINTFORMDW 유메미가 당신이 움직임을 멈추자 의문을 제기한다.
		PRINTFORMDW 물론 끝나지 않았다. 당신은 골반 각도를 조금 조절했다.
		PRINTFORMDW 그러고 나서 그녀의 G스팟을 겨냥하며 다시 박기 시작한다.
		CALL HPH_PRINT,@"「흐으으~ HPH?! 아, 안 돼, 정말 굉장해 HPH?!」","L"
		PRINTFORMDW 유메미는 낯선 쾌감에 격렬하게 몸을 떨었다.
		RETURN 1
	ENDIF
	;基本セット
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			;恋慕
			IF TALENT:恋慕 || TALENT:恋人
				CALL HPH_PRINT,@"「아, 그래, 더 채워줘 HPH」","L"
				CALL HPH_PRINT,@"「나를 만들어줘, 당신의 여자여, 내 몸속에 새겨줘 HPH」","L"
				RETURN 1
				;愛欲Orセフレ
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아하아흐 네, 거기, 더 채워줘 흐윽」","L"
						CALL HPH_PRINT,@"「마치 네 전용 구멍인 것처럼」","L"
					CASE 1
						CALL HPH_PRINT,@"「노호피 너 그럴 필요 없어, 내 보지 표시해줘, 그렇게... 호피」","L"
						CALL HPH_PRINT,@"「내 보지, 하아, 어디로도 안 가네 HPH」","L"
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				CALL HPH_PRINT,@"「음, 비록, 아아, 방금, 왔지만」","L"
				PRINTFORMDW 당신은 정액으로 유메미의 질 벽에 영구적인 흔적을 남기려는 듯 골반을 밀어붙였다.
				CALL HPH_PRINT,@"「흐응, 잠깐, 아, 어디서 오고 있다고 생각하는 거야, 아...하프」","L"
				RETURN 1
			ENDIF
		ELSE
			IF TALENT:恋慕
				CALL HPH_PRINT,@"「니히, 연모, 난 그것이 좋아 HPH 난 그것이 좋아, 거기 HPH」","L"
				CALL HPH_PRINT,@"「더 해줘, %CALLNAME:MASTER%, 더 많이 HPH해줘」","L"
				RETURN 1
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아하후 후훗, 그래, 더 문질러줘 후훗」","L"
						CALL HPH_PRINT,@"「너무 좋아, 여기 HPH 중독될 것 같아 HPH」","L"
					CASE 1
						CALL HPH_PRINT,@"「NoHPH 없다HPH 바로 사정할 테니까HPH」","L"
						PRINTFORMDW "아, 알겠다". 당신은 잠시 멈추고, 유메미의 진심이 빠르게 드러난다.
						CALL HPH_PRINT,@"「노후 후회한다. 멈추지 마, 나를 절정에 이르게 해줘」","L"
				ENDSELECT
				RETURN 1
			ELSE
				PRINTFORML 「아하아! 아니, 거기 너무 민감해!!\/\/\/」
				CALL HPH_PRINT,@"「오직 거기서만 하면 나도 금방 싸버릴 거야, 아아아큭」","L"
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;時姦中
	;IF FLAG:70
	;	PRINTFORMW
	;	RETURN 1
	;恋慕
	;ELSEIF TALENT:恋慕
	;	PRINTFORMW
	;	RETURN 1
	;屈服3
	;ELSEIF MARK:不埒刻印 == 3
	;	PRINTFORMW
	;	RETURN 1
	;それ以外
	;ELSE
	;	PRINTFORMW
	;	RETURN 1
	;ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K9_{SELECTCOM}_1
RETURN 1
