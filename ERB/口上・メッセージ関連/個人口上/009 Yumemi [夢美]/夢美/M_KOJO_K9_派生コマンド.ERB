; 子宮口関数
;==================================================

@M_KOJO_MESSAGE_SIKYUKO_K9()
;ポルチオ性感持ち(EXP:57 > 50)か,綻び状態(EXP:57 > 25)か、それ以外か
IF TALENT:78 == 1
	SELECTCASE RAND:4
		CASE 0
			CALL HPH_PRINT,@"「아, 괜찮아, 괜찮아 HPH 난 정말 좋아 HPH」","L"
		CASE 1
			CALL HPH_PRINT,@"「망치여, 나의 자궁이여, 더 강하게, 더욱 단단하게 HPH」","L"
		CASE 2
			CALL HPH_PRINT,@"「아하하호오 거기, 나의 자궁이 너무 행복해호오」","L"
		CASE 3
			CALL HPH_PRINT,@"「아히이ㅎ 정신을 잃어가고 있어ㅎ 치는 것, 나의 자궁ㅎ」","L"
	ENDSELECT
ELSEIF EXP:57 < 50 && EXP:57 > 25
	CALL HPH_PRINT,@"「아하, 아앗?! 말도 안 돼, 기분이 좋다HPH」","L"
	CALL HPH_PRINT,@"「아니, 그만둬, 더는... 그러면 난 미쳐버릴 거야HPH」","L"
ELSE
	PRINTFORML 「%GROAN()%... 아... 그곳... 아... 아파...」
ENDIF
