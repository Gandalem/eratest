@M_KOJO_MESSAGE_SCOM_K9_7
CALL M_KOJO_MESSAGE_SCOM_K9_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K9_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		CALL HPH_PRINT,@"「...무슨 일이야? 멈추는 것 같아...아아아악하으윽」","L"
		PRINTFORML 「우와, 박히는 것 같아... 더 깊이?!」
		RETURN 1
	ENDIF
	;基本セット
	;あまりにもピュアに恋慕付けたりすると展開が変かも。ちゃんと適度に【are】して進展シような！
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;前回射精した
		ELSEIF TCVAR:102
			;子作りOKしているか(CFLAG:14==2),危険日以外OKか(CFLAG:14==1),ピル服用済か(TCVAR:109),それ以外
			IF CFLAG:14 == 2
				CALL HPH_PRINT,@"「안에 사정해 HPH 나를 더 깊이 흔들어 줘 HPH」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
				IF CFLAG:900 == 7 && CFLAG:902 == 0
					CALL HPH_PRINT,@"「나를 임신시켜줘~ 네 정액으로~ HPH」","L"
				ENDIF
			ELSEIF CFLAG:14 == 1
				CALL HPH_PRINT,@"「아하후후 나의 뜨거운 씨앗으로 나를 가득 채워줘, 더 깊은 곳에~후후」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ELSEIF TCVAR:109
				CALL HPH_PRINT,@"「아아, 으응, 안쪽 끝까지 들어와 있어…… 흐읏, 내 안을 가득 채우고 있어……\/\/\/」","W"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ELSE
				CALL HPH_PRINT,@"「쿠... 갑자기 안에서부터 흘러나와 버리다니, 이 대담한...! HPH」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ENDIF
			RETURN 1
		ELSE
			;子作りOKしているか(CFLAG:14==2),危険日以外OKか(CFLAG:14==1),ピル服用済か(TCVAR:109),それ以外
			IF CFLAG:14 == 2
				CALL HPH_PRINT,@"「후아아, 내 자궁까지 가득 채워지고 있어」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ELSEIF CFLAG:14 == 1
				CALL HPH_PRINT,@"「아아, 괜찮아. 오늘 안전해...」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ELSEIF TCVAR:109 == 1
				CALL HPH_PRINT,@"「흐응, 비록 내가 알약을 먹었지만, 아?!HPH」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ELSE
				CALL HPH_PRINT,@"「우와아, 잠깐, 어디 있어, 사정하는 HPH」","L"
				CALL M_KOJO_MESSAGE_SIKYUKO_K9
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;時姦中
	;IF FLAG:70
	;	PRINTFORMW
	;	RETURN 1
	;恋慕
	;ELSEIF TALENT:恋慕
	;	PRINTFORMW
	;	RETURN 1
	;屈服3
	;ELSEIF MARK:不埒刻印 == 3
	;	PRINTFORMW
	;	RETURN 1
	;それ以外
	;ELSE
	;	PRINTFORMW
	;	RETURN 1
	;ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K9_{SELECTCOM}_1
RETURN 1
