					CALL HPH_PRINT,@"「후아아, 아하...? 내 뒤에 뜨거운 것이 있어...흐읍」","L"
				CASEELSE
					CALL HPH_PRINT,@"「으음, 정말 좋다, 아아, 내 엉덩이... 내 엉덩이에 박히고 있어... 큭」","L"
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
