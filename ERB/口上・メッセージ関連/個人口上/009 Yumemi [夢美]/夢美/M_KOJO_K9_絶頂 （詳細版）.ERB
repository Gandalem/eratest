; Modular ERB: 個人口上/009 Yumemi [夢美]/夢美/M_KOJO_K9_絶頂 （詳細版）.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K9
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORML 「흐응, 새고 있어... 나 사정할 때 가슴에서 흘러내리고 있어... \/\/\/」
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORML 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	IF TALENT:57
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「아아... 후우 아... 나 소변 봤어... 기분이 너무 좋아... 후우」","L"
				PRINTFORMDW 절정에 이르는 쾌감이 해소되는 감각과 뒤섞이자 유메미의 얼굴에 황홀한 표정이 떠올랐다.
			CASE 1
				CALL HPH_PRINT,@"「흐으음... 히이... 이이히피 멈추질 않아...HPH 내 방광이 미쳐가는 것 같아...HPH」","L"
				PRINTFORMDW 유메미는 절정에서 소변을 본 것 같다.
			CASE 2
				CALL HPH_PRINT,@"「아하하하 새고 있어... 하프 이건 최고의 거야~... 하프」","L"
				PRINTFORMDW 유메미가 절정으로 몸을 떨자, 그녀는 황홀한 표정으로 소변을 본다.
			CASE 3
				CALL HPH_PRINT,@"「하아...흡 하아...흡」","L"
				PRINTFORMDW 유메미가 오르가즘의 쾌감으로 알아들을 수 없게 헐떡이자, 그녀의 요도에서 힘찬 소변줄이 분수처럼 뿜어져 나온다.
		ENDSELECT
	ELSEIF ABL:14 > 4
		CALL HPH_PRINT,@"「아하, 하아... HPH 봐... HPH 나-나 오줌 싸고 있어, 하면서 사정하고 있어...\/\/\/」","L"
		PRINTFORMDW 유메미는 절정 중에 소변을 보며 홍당무처럼 빨개지고, 당신에게 보여지는 즐거움에 자신을 맡긴다...
	ELSE
		PRINTFORML 「아니야, 보지 마, 보지 마~...!」
		PRINTFORMDW 유메미는 절정에 이르면서 소변을 보기 시작하자 얼굴이 새빨개진다.
	ENDIF
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		;Prints some Cherokee characters to mimic the original Japanese nonsense text
		CALL HPH_PRINT,@"「～～～Nnhaa%UNICODE(0x13CA)%%UNICODE(0x13C5)%%UNICODE(0x13AF)%%UNICODE(0x13B9)%aghggh%UNICODE(0x13E4)%%UNICODE(0x13EF)%%UNICODE(0x13DB)%～HPHHPHHPHHPHHPH」","L"
		PRINTFORMDW 유메미는 정신을 파괴하는 듯한 오르가슴으로 온몸이 허우적거리는 가운데 알아들을 수 없는 외계의 무언가를 토해낸다.
		CALL HPH_PRINT,@"「우와아... 하이... 히... 아, 하아... 대단해... 호프」","L"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		PRINTFORML 「안 돼! 더는 못 해! 너무 과해, 못 견디겠어!」
		PRINTFORMDW 강력한 절정에 다가가면서 유메미는 고개를 저으며 본능적으로 벗어나려 한다.
		CALL HPH_PRINT,@"「내가 절정에 이르면, 정신을 잃고, 부서질 것 같아! 아, 아히이이이이이이이잉」","L"
		PRINTFORMDW 강렬한 오르가즘이 유메미의 몸을 휩쓸고 지나갔고, 그 황홀한 물결은 그녀를 미친 듯이 몸부림치게 했다.
		CALL HPH_PRINT,@"「하아... 하아... 대단해... 후우」","L"
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:四重絶頂
			;Ｃ＆Ｖ＆Ａ＆Ｂ絶頂
			CASE 1
				PRINTFORMW 「음핵과 보지에서 흘러나와... 후아아... 심지어 내 항문과 가슴에서도...」
				RETURN 1
				;Ｃ＆Ｖ＆Ａ＆Ｍ絶頂
			CASE 2
				PRINTFORMW 「클리토리스와 보지에서부터... 그리고 엉덩이와 키스에서까지, 한꺼번에...」
				RETURN 1
				;Ｃ＆Ｖ＆Ｂ＆Ｍ絶頂
			CASE 3
				PRINTFORMW 「클리토리스와 보지에서부터, 가슴과 키스하는 것까지... 이렇게 격렬하게 절정에 이르고 있어...」
				RETURN 1
				;Ｃ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 4
				PRINTFORMW 「한꺼번에, 내 엉덩이랑 클리토리스랑 가슴에서부터... 심지어 키스에서도...」
				RETURN 1
				;Ｖ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 5
				PRINTFORMW 「내 보지와 항문, 그리고 가슴에서부터, 심지어 키스에서도 흘러 나오는...」
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;暫定追加
		PRINTFORML 「세 군데에서 한꺼번에 사정하는 건 너무 과해!」
		PRINTFORMDW 유메미는 모든 다른 방향에서 오는 강렬한 쾌감으로부터 힘없이 벗어나려 한다.
		CALL HPH_PRINT,@"「하아아프 내가 오고 있어, 너무 아파~ 하아아멈출 수가 없어 하아아프ㅎ」","L"
		CALL HPH_PRINT,@"「아, 히이, 오르네, 부서져, 멈출 수 없어, 오르네, 우우---흐프헵」","L"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;とりあえず暫定で
		CALL HPH_PRINT,@"「후아아, 나 갈 것 같아, 두 번 HPH 동시에 두 번 오는 거 HPH」","L"
		CALL HPH_PRINT,@"「절정에 다다르네, 너무 강렬해, 아아~큭큭」","L"
		PRINTFORML 「커밍... 아, 하아아～!」
		PRINTFORMDW 유메미는 여러 곳에서 오는 쾌락에 의해 공격받으면서 평소보다 강한 절정에 도달한다.
		RETURN 1
	ENDIF
	IF NOWEX:Ｃ絶頂
		;超強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 == 3
			CALL HPH_PRINT,@"「놀랍다, 나 참 못 참겠어」","L"
			CALL HPH_PRINT,@"「절정할 거야, 너무 세게, 내 클리토스에서. 멈추지 마.」","L"
			CALL HPH_PRINT,@"「아, 아아, 사정해, 나 사정하고 있어... 아아~―――――!흐읍흐읍흐읍」","L"
			;強絶頂Ｃ
		ELSEIF NOWEX:Ｃ絶頂 == 2
			PRINTFORML 「응, 좋아, 내 클리토리스 너무 기분 좋아! 더 강하게 해줘, 더 기분 좋게 해줘!」
			PRINTFORMDW 그녀는 쾌감으로 정신을 잃어가며, 유메미가 더욱 많은 것을 애원했다.
			CALL HPH_PRINT,@"「후아아아흐응, 평소보다 더 절정에 달할 것 같아 흐윽흐응」","L"
			;絶頂Ｃ
		ELSE
			PRINTFORMW 「아, 안 돼, 거기 그렇게 많이 문지르지 마! 너무 심해!」
			PRINTFORMDW 유메미가 한계에 다다르고 있음을 감지하고, 당신은 그녀의 음핵을 더욱 자극하기 시작한다.
			PRINTFORML 「안 돼, 못 하겠어, 나 오고 있어, 내 음핵에서...! ...후아아!」
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;超強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 == 3
			CALL HPH_PRINT,@"「우와아! 히이, 아, 으윽! 굉장해 HPH 내 보지가 정말 기분 좋아 HPH」","L"
			PRINTFORMDW 유메미의 얼굴은 그녀가 자신의 %FSYN("vagina")%에서 얻는 쾌감에 취해 욕망으로 녹는다.
			CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 제발 더 세게 해줘. 나 갈 것 같아」","L"
			CALL HPH_PRINT,@"「아아 정액이 나와, 나 정액 흘리고 있어! 멈출 수가 없어, 내 보지가 흘러내려, 아아아아아아아아-흐읍프흐읍프」","L"
			;強絶頂Ｖ
		ELSEIF NOWEX:Ｖ絶頂 == 2
			PRINTFORML 「아아, 안 돼, 내 보지가 너무 좋아!」
			PRINTFORML 「%CALLNAME:MASTER%, 제발 더 세게 해줘, 나 갈 것 같아, 그 어느 때보다 더 강하게!」
			CALL HPH_PRINT,@"「후아아, 아아, 안 돼, 멈출 수가 없어, 나 절정이야, 아아아아아아아아아-흐으읍프프프」","L"
			;絶頂Ｖ
		ELSE
			PRINTFORML 「아, 아, 아! 사정하고 있어, %CALLNAME:MASTER%, 나 사정할 것 같아...!」
			PRINTFORMDW 유메미는 오르가슴 직전인 것 같다.
			PRINTFORML 「아, 안 돼, 못 참겠어!」
			CALL HPH_PRINT,@"「아, 안 돼, 사정해, 나 사정하고 있어~ 후와아아흐프」","L"
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;超強絶頂Ａ
		IF NOWEX:Ａ絶頂 == 3
			IF TALENT:75 == 1
				CALL HPH_PRINT,@"「아, 나 갈 거야 HPH 더! 내 엉덩이 더 파줘 HPHHPHHPH」","L"
				PRINTFORMDW 그녀의 항문에서 오는 쾌락에 잠긴 유메미는 저속한 표현들로 더 많은 것을 애원한다.
				CALL HPH_PRINT,@"「예스 HPH 거기 바로 거기HPH 아아, 내 엉덩이가 싸고 있어HPH」","L"
				CALL HPH_PRINT,@"「아, 나 사정해, 내 뒤에서 하아아아아아아아아아아아아아아아」","L"
			ELSE
				PRINTFORML 「아히, 안 돼, 그만해! 내 엉덩이, 더는 못 참겠어! 나 갈 거야!」
				PRINTFORMDW 그녀의 말에도 불구하고 유메미의 엉덩이는 계속 꿈틀거리며 더 많은 것을 애원했다.
				CALL HPH_PRINT,@"「히이익, 안 돼, 나올 것 같아... 멈출 수가 없어... 아아아악~~!!HPH」","L"
			ENDIF
			;強絶頂Ａ
		ELSEIF NOWEX:Ａ絶頂 == 2
			CALL HPH_PRINT,@"「크윽, 안녕, 우와아, 내 엉덩이가 정말 기분 좋다 HPH」","L"
			PRINTFORMDW 발달한 항문에서 오는 쾌감에 익숙해진 유메미는 그 감각을 음미하며 엉덩이를 흔든다.
			CALL HPH_PRINT,@"「아아, 절정에 이르는 게 너무 좋아 HPH 절정~~HPHHPH」","L"
			;絶頂Ａ
		ELSE
			PRINTFORML 「크윽, 아아, 안 돼, 내 항문, 우와, 나 사정해, 내 항문에서...\/\/\/」
			PRINTFORMDW 그녀는 여전히 자신의 항문에서 사정을 하는 것에 저항했지만, 치정과 예상치 못한 쾌감의 혼합을 표현했다.
			PRINTFORML 「푸아, 아아, 안 돼, 안 돼, 사정하겠어!」
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;強絶頂Ｂ
		IF NOWEX:Ｂ絶頂 == 3
			CALL HPH_PRINT,@"「아니, 내 가슴들, 굉장한 HPH 슈가 좋아, 아, 우와아----HPHHPH」","L"
			PRINTFORMDW 유메미는 가슴에서 오는 강렬한 쾌감으로 절정에 이르며 등을 아치형으로 휘었다.
			CALL HPH_PRINT,@"「우와아... 내 가슴... 굉장해...흐읍」","L"
			;強絶頂Ｂ
		ELSEIF NOWEX:Ｂ絶頂 == 2
			PRINTFORML 「아아, 안 돼, 그만해, 내 가슴을 그렇게 놀리면 안 돼! 나도 갈 것 같아, 너무 세게!」
			PRINTFORMDW 유메미의 신음이 더 커지며 강력한 절정으로 달려간다.
			CALL HPH_PRINT,@"「아, 아아아아아아아아아아아아아아아아아아악」","L"
			;絶頂Ｂ
		ELSE
			PRINTFORML 「아, 아, 말도 안 돼, 내 가슴에서, 절정...? 우와아? 아아!」
			PRINTFORMDW 유메미는 그녀의 가슴을 덮치는 쾌락으로 절정에 이른다.
			PRINTFORML 「우... 음... 하아... 하아...」
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;超強絶頂Ｍ
		IF NOWEX:Ｍ絶頂 == 3
			CALL HPH_PRINT,@"「나아아앙~?!흐으흣흐으흣」","L"
			PRINTFORMDW 당신이 그녀의 입술을 깊은 키스로 막자, 유메미는 믿을 수 없을 만큼 강력한 오르가즘을 경험한다.
			CALL HPH_PRINT,@"「음... 그 키스... 정말 굉장했어...흐읍」","L"
			;強絶頂Ｍ
		ELSEIF NOWEX:Ｍ絶頂 == 2
			PRINTFORML 「%RANDLIPS(,"kiss")%! 나 갈 것 같아, 세게 해줘!」
			PRINTFORMDW 유메미는 특히 강력한 오르가즘을 향해 가면서 키스를 격렬하게 한다.
			CALL HPH_PRINT,@"「응무... 안 돼! 못하겠어, 꿀꺽, 사정해버렸어, 아아악!큭큭」","L"
			CALL HPH_PRINT,@"「%FSYN("lips_over")%... 아... 하아ー... 하아...흐읍」","L"
			;絶頂Ｍ
		ELSE
			PRINTFORML 「음, 음무! %FSYN("lips_over")%, 아니야, 나 오고 있어, 키스에서... 음무우!」
			PRINTFORMDW 당신이 또 다른 키스를 훔치자 유메미가 절정에 이른다.
			CALL HPH_PRINT,@"「%FSYN("lips_over")%... Ah... Aa...HPH」","L"
		ENDIF
	ENDIF
ENDIF
