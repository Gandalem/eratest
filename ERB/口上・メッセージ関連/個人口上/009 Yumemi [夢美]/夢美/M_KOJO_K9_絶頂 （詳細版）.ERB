;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF !FLAG:70
		IF TALENT:74 == 1
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아아~ HPH 안에 사정되는 게 너무 기분 좋아 HPH 내 자궁이 가득 차는 것 같아 HPH」","L"
					CALL HPH_PRINT,@"「너무 뜨거워... 더, 나를 더 채워줘... HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「히이프 놀랍다, 네 정액은 정말 뜨겁구나 히이프 안에서 불타고 있어 히이프」","L"
					CALL HPH_PRINT,@"「우와아... 크림파이, 너무 기분 좋아...큭큭」","L"
				CASEELSE
					CALL HPH_PRINT,@"「아하아...흐으 네 거 피가 내 보지를 채우고 있어 흐으」","L"
					CALL HPH_PRINT,@"「아아... 너무 뜨거워...후후 굉장해...후후」","L"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아, 아으, 나-나한테 박히는 거야...\/\/\/」
				CASE 1
					CALL HPH_PRINT,@"「푸아아아, 아으...? 내 보지에 뜨거운 게 있어...흐읍」","L"
				CASEELSE
					CALL HPH_PRINT,@"「응, 정말 좋다, 아아, 내 보지... 내 보지 안으로 쏴지고 있어... HPH」","L"
			ENDSELECT
		ENDIF
		;危険日か,且つピルを飲ませていない(ゴム有りは別処理なので考慮しない)
		IF CFLAG:900 == 7 && TCVAR:109 == 0
			IF TALENT:恋慕
				PRINTFORML 「이렇게나 많이 내 안에 사정하면…… 임신해 버릴지도……\/\/\/」
			ELSE
				PRINTFORML (%HE_SHE(MASTER,1)%이 들어왔어... 아마 괜찮겠지...? )
			ENDIF
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
