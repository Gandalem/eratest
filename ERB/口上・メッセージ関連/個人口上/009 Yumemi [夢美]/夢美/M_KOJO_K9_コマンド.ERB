;TFLAG:8 (1=TARGETがお掃除 2=ASSIがお掃除 3=TARGETとASSIがお掃除)
;-------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_C_K9 ;custom code, fix
;処女喪失
IF TCVAR:破瓜
	;正真正銘処女喪失
	IF TCVAR:破瓜 == 1
		;再生処女喪失
	ELSEIF TCVAR:破瓜 == 2
		;無自覚非処女喪失
	ELSEIF TCVAR:破瓜 == -1
	ENDIF
ENDIF
;Ａ処女喪失
IF TCVAR:Ａ破瓜
	;正真正銘Ａ処女喪失
	IF TCVAR:Ａ破瓜 == 1
		;無自覚Ａ処女喪失
	ELSEIF TCVAR:Ａ破瓜 == -1
	ENDIF
ENDIF
