;==================================================
;120,クンニ強制
;==================================================

@M_KOJO_MESSAGE_COM_K9_120
CALL M_KOJO_MESSAGE_COM_K9_120_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_120_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕 || (TALENT:思慕 && TALENT:セフレ == 0)
			PRINTFORML 「%CALLNAME:MASTER%... 너, 음... 내 입으로 해달라는 거야?」
			PRINTFORMDW 너는 열렬하게 고개를 끄덕인다.
			PRINTFORML 「그-그럼 한번 시도해 볼게...잘 못할지도 모르겠지만...」
			PRINTFORMDW 살짝 떨면서 유메미가 당신에게 얼굴을 가까이 가져간다 %FSYN("vagina")%.
			PRINTFORML 「저, 좀 부끄러워요... \/ \/ \/」
			PRINTFORMDW 그녀의 긴장된 당혹감은 너를 더욱 흥분시킨다.
		ELSEIF TALENT:愛欲 || TALENT:セフレ
			PRINTFORML 「후후, 내 보지를 핥으라고?」
			PRINTFORMDW 유메미는 장난스럽게 웃으며 네 요청에 응한다.
			PRINTFORML 「물론이지, 그럼 이리 와...」
			PRINTFORMDW 너는 그녀가 자신을 향해 손짓하자 유메미에게 가까이 다가간다.
		ELSE
			PRINTFORMW 「에...? 내 입을 사용하라고...? 그러니까... 그 아래쪽 말이야?」
			PRINTFORML 「...음... 그런 종류의 걸 말하는 거야?」
			PRINTFORMDW 당신은 그녀에게 네, 그런 종류의 것을 말한다.
			PRINTFORML 「뭐-좋아 그럼... 선택의 여지가 없는 모양이네...」
			PRINTFORMDW 유메미는 마지못해 얼굴을 당신의 %FSYN("vagina")%에 더 가까이 움직인다.
		ENDIF
		RETURN 1
	ENDIF
	;2回目以降
	;恋慕
	IF TALENT:恋慕
		PRINTFORMDL 유메미가 열정적으로 당신에게 혀로 봉사한다.
		PRINTFORMW 「%RANDLIPS(0,"suck")%... %CALLNAME:MASTER%, 기분이 좋아?」
		PRINTFORMDW 당신이 굉장하다고 말하자, 유메미는 얼굴에 황홀한 표정을 짓는다.
		PRINTFORML 「후후, 그럼 계속할게.」
		PRINTFORMDW 그녀가 그렇게 말하며, 유메미는 더욱 큰 정성과 헌신으로 당신에게 봉사하기 시작한다.
		PRINTFORMDW 그 쾌감에 당신은 무의식적으로 %FSYN("vagina")%를 유메미의 입 안에서 비틀고 갈게 된다.
		RETURN 1
		;愛欲
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		CALL HPH_PRINT,@"「음... 파아, 츄우... 슬럽...햔」","L"
		PRINTFORMDW 유메미는 숙련된 혀로 당신의 %FSYN("vagina")%을 능숙하게 애무했다.
		PRINTFORMDW 그녀의 혀 움직임에 반응하여, 당신의 골반은 떨리고 %FSYN("vagina")%이 %FSYN("juice")% 흘렸다.
		CALL HPH_PRINT,@"「...후훗, 네 체액이 계속 나오는구나... 응, 맛있다...흐흣」","L"
		PRINTFORMDW 유메미는 당신이 넘치는 %FSYN("juice")%를 후루룩 마시며 음란하게 미소 짓는다.
		RETURN 1
		;思慕
	ELSEIF TALENT:思慕
		PRINTFORML 「어때...? 기분 좋아?」
		PRINTFORMDW 유메미가 얼마나 기분이 좋은지 확인하자 그녀의 얼굴에 안도감이 퍼졌다.
		PRINTFORML 「그럼 이대로 계속할게... 꿀꺽...」
		PRINTFORMDW 유메미는 네 %FSYN("vagina")% 위로 혀를 계속 미끄러뜨렸다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「%RANDLIPS(0,"suck")%... 어때? 기분 좋아?」
		PRINTFORMDW 당신은 가끔 달콤한 신음이 새어 나오며 아주 좋다고 대답한다.
		PRINTFORML 「좋아... 그럼 계속하자.」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「%FSYN("lips_muffle")%... 꿀꺽... 왜 내가 해야 하는 거야...」
		PRINTFORMDW 유메미는 마지못해 당신의 %FSYN("vagina")%를 입으로 봉사한다.
		PRINTFORMDW 그녀는 당신이 쾌감에 움찔거리고 떨리는 것을 지켜보며 중얼거린다.
		PRINTFORML 「준비가 되면 어서 올라와서 사정해.」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;121,貝あわせ
;==================================================

@M_KOJO_MESSAGE_COM_K9_121
CALL M_KOJO_MESSAGE_COM_K9_121_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_121_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「에... 뭐라고... 너랑 나, 거기서 서로 부비는 거 말이야?」
		PRINTFORMDW 그녀의 질문에 고개를 끄덕이며 그것이 굉장할 거라고 덧붙인다.
		PRINTFORML 「나-좋을 것 같아...라고 말하는 거야... 나는, 난 정신적으로 준비해야 할 것 같아...\/\/\/」
		PRINTFORMDW 담력 있는 여자는 무엇이든 시도할 준비가 되어 있다고 그녀에게 말하자,
		PRINTFORMDW 당신은 유메미의 다리 중 하나를 공중으로 들어 올리고 자신의 골반을 그녀 쪽으로 밀어 민감한 부위를 맞춘다.
		CALL HPH_PRINT,@"「어이, 뭐, 아니, 잠깐만... 후아악!흐읍」","L"
		PRINTFORMDW 유메미의 말은 당신의 음핵이 그녀의 것에 스치면서 격렬한 쾌감이 그녀의 몸을 통해 파도치게 되자 중간에 끊겼다.
		RETURN 1
	ENDIF
	;2回目以降
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「하아, 연모, 아하, 당신을 사랑해요, %CALLNAME:MASTER%! 더 움직여요, 당신의 골반을, 더 세게!」
		PRINTFORMDW 당신의 아래쪽 부위는 격렬하게 골반을 흔들며 흘러넘치는 애정 액체로 서로 맞닿아 있다.
		PRINTFORMDW 당신이 연결된 성기에서 나오는 연모 액체가 야만적인 열정의 생생한 증거처럼 사방에 뿌려진다.
		PRINTFORMDW 격렬한 쾌락에 몸을 떨며, 당신의 음핵이 유메미의 것과 비비고 어루만지자 달콤한 신음이 함께 울린다.
		PRINTFORML 「네, 아아, 굉장해... %CALLNAME:MASTER%, 우리 같이 갈까요, 이렇게...!」
		RETURN 1
		;愛欲
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		PRINTFORML 「아아, 너무 좋아, 굉장해! 우리 클리토리스들이 키스하고 있어... 정말 대단해...!」
		PRINTFORML 「%CALLNAME:MASTER%, 더, 더... 세게!」
		PRINTFORMDW 유메미의 얼굴은 음란함으로 녹았고 그녀는 움직임을 격렬하게 했으며, %FSYN("juice")% 그녀의 엉덩이가 당신과 부딪치면서 사방에 분출했다.
		PRINTFORMDW 당신은 불룩하게 발기된 클리토리스가 그녀의 것 위를 강하게 문지르자 크게 신음한다.
		CALL HPH_PRINT,@"「후후... 아하... %FSYN("lips_muffle")%... 이렇게, 이대로 같이 갈까... HPH」","L"
		RETURN 1
		;思慕
	ELSEIF TALENT:思慕
		PRINTFORML 「아, 아아, 음... %조사처리(CALLNAME:MASTER,"의")% 클리토리스가 내 것에 닿고 있어... 느껴져...」
		PRINTFORMDW 유메미는 당신의 골반이 서로 부딪히자 달콤한 신음을 흘린다.
		PRINTFORML 「하, 하아, 이봐, %CALLNAME:MASTER%, 너도 기분 좋아?」
		PRINTFORMDW 얼굴에 황홀함을 띠고 대답하자, 당신은 그녀에게 더 깊숙이 골반을 밀어붙인다.
		PRINTFORML 「후아아, %CALLNAME:MASTER%, 그렇게 갑자기 그러면... 나, 나 갈 거야...!」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「하아, 하아, 이거... 정말 좋아...!」
		CALL HPH_PRINT,@"「이 느낌, 우리 클리토리스가 맞닿을 때 느껴지는 이 짜릿함, 너무 좋아...HPH」","L"
		PRINTFORMDW 당신은 더 많은 쾌감을 찾으며 골반을 더욱 격렬하게 움직인다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「응... 아아... 으으으...여\/\/\/ 나, 나 이상해지는 것 같아...」
		PRINTFORML 「아래쪽이 서로 이어진 채로... 기분 좋아...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
