;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF CFLAG:睡眠
		RETURN 0
	IF FLAG:70
	ELSE
		SELECTCASE TFLAG:193
			CASE 0
				PRINTFORML 「Ara, you're cleaning up around here for me? Thanks, I'll leave it to you then.」
			CASEELSE
				SELECTCASE TFLAG:194
					CASE 3
						PRINTFORML 「Bweh, no way...since when did this much trash pile up...I don't understand...」
						CALL HPH_PRINT,@"「Hey, I don't suppose I could leave this all to youHPH」","L"
						PRINTFORMDW "No."
						PRINTFORML 「I figured as much...」
						IF (TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン) && CFLAG:溜まってる度 > 500
							PRINTFORML 「By the way, this is unrelated, but I'm super horny right now.」
							PRINTFORMDW "Please don't suddenly say such things, Professor."
							PRINTFORML 「Then let's do it tons afterwards, okay?」
							PRINTFORMDW "Yes, yes, but only once we're done cleaning, okay?"
						ENDIF
					CASE 2
						PRINTFORML 「Mmm...the trash around here has accumulated quite a bit...well, let's just get through it.」
						IF (TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン) && CFLAG:溜まってる度 > 500
							PRINTFORML 「By the way, my horniness has also accumulated quite a bit...」
							PRINTFORMDW "Please don't suddenly say such things, Professor."
							PRINTFORML 「Then let's do it afterwards, okay?」
							PRINTFORMDW "Yes, yes, but only once we're done cleaning, okay?"
						ENDIF
					CASEELSE
						PRINTFORML 「This level of trash is a piece of cake, let's clean it up quickly.」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
