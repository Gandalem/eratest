; Modular ERB: 個人口上/009 Yumemi [夢美]/夢美/M_KOJO_K9_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K9_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K9_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;ここに口上書いて下さい
	;通常会話
	IF TALENT:恋慕
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 「후후, 당신과 이야기하는 건 정말 기분 좋아...」
				PRINTFORML 「앞으로도 계속 이렇게 많이 이야기하고 싶어.」
			CASE 0
				;今後もうちょっとレパートリー増やしたいなあ
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「연구소 요즘 좀 비좁게 느껴지는데, 어떻게든 확장할 수 없어?」
						PRINTFORMDW "미안해, 그럴 수는 없어."
						PRINTFORML 「부우～」
						PRINTFORMDW 유메미는 토라진 표정을 짓는다.
					CASE 1
						PRINTFORML 「저랑 같이 연구원이 되어 주시겠어요?」
						PRINTFORML 「그리고 말이에요... 어쩌면 우리 함께 살 수도 있을까요?」
						PRINTFORMDW "그건 상당히 어려울 것 같은데요..."
						PRINTFORML 「에헤~ 자, 왜 안 돼~ 치유리를 보너스로 끼워줄게요! 어때요?」
						PRINTFORMDW "네 조수님을 그렇게 쉽게 팔아넘기지 마세요."
					CASE 2
						PRINTFORML 「딸기 쇼트케이크가 먹고 싶어...」
						PRINTFORMDW 갑자기 그런 주문을 하다니.
						PRINTFORML 「음, 문득 먹고 싶어졌어. 혹시 만들 줄 알아?」
						PRINTFORMDW "글쎄, 가끔은" 하고 대답한다., you answer.
						PRINTFORML 「기대하고 있을게.」
				ENDSELECT
			CASE -1
				PRINTFORML 「굳이 대화하려고 애쓸 필요는 없잖아.」
		ENDSELECT
	ELSEIF TALENT:愛欲
		;愛欲
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 「후후, 네 머릿속엔 더러운 생각밖에 없다고 생각했는데...」
				PRINTFORML 「별것 아닌 평범한 얘기도 할 수 있는 거네. 너에 대한 내 생각이 바뀌었어.」
				PRINTFORMDW "무례하군."
				PRINTFORML 「미안 미안, 기분 나쁘게 말하려던 건 아니야.」
				PRINTFORML 「음... 네가 여기 있으니 어차피 섹스를 하고 싶어졌어.」
			CASE 0
				SELECTCASE RAND:6
					CASE 0
						PRINTFORML 「누구나 너에 대해 음란한 꿈을 꾸게 해주는 베개는 어때?」
						PRINTFORMDW "누가 그런 걸 원하겠어?"
						PRINTFORML 「음, 적어도 나는 갖고 싶네.」
						PRINTFORML 「하지만... 만약 내가 그런 종류의 꿈을 꾼다면... 아침에는 내 보지가 흥건하게 젖어 있을 거야\/\/\/」
					CASE 1
						PRINTFORML 「내 세상에서는 수면 학습이 어떻게 작동하는지 거의 다 배웠다.」
						PRINTFORML 「그것으로 나의 성 테크닉을 향상시킬 수 있을지 궁금하다...」
						PRINTFORMDW "진짜 세상에서의 실습이 더 중요하다고 생각한다."
						PRINTFORML 「그건 사실이다. 손 테크닉, 입 테크닉, 삽입 테크닉 같은 것들이 있다...」
					CASE 2
						PRINTFORML 「이 세계에서는 저 카파들이 흥미로운 것들을 만들 수 있는 것 같아.」
						PRINTFORML 「어쩌면 나도 경쟁 상점을 열고 대통일 물리학의 세계에서 성인용품을 팔아야 할지도 모르겠어.」
						PRINTFORMDW "그게 어떤 종류의 것들을 포함하는지 궁금하네."
						PRINTFORML 「직접 가서 확인해 봐야 알 수 있을 거야.」
					CASE 3
						PRINTFORML 「너 가끔 너무 세게 섹스하고 싶을 때 있어?」
						PRINTFORMDW "안 된다고는 못 하겠지, 뭐."
						PRINTFORML 「응, 나도. 그런 기분일 때는 어떻게 해?」
						PRINTFORMDW "음, 난... 다시 생각해보니 말하기 좀 부끄럽네"라며 중얼거린다., you mumble.
						PRINTFORML 「가끔 연구실에서 자위해, 이렇게, 펜이나 시험관으로 내 보지를 비비면서...」
						PRINTFORMDW 그녀가 그렇게 말하자, 유메미는 치마를 들고 삽입하는 동작을 취한다.
						IF FLAG:1030 != 8
							PRINTFORML 「평범한 자위보다 훨씬 기분 좋아...\/\/\/ 아직 치유리한테 들키진 않은 것 같아.」
							IF ABL:14 > 5
								CALL HPH_PRINT,@"「들킬 위험이라니... 그게 나를 더 흥분시켜HPH.」","L"
								PRINTFORML 「그녀가 뭐라고 생각할지, 혹은 할지를 생각하면... 후후!」
								PRINTFORML 「그녀와 내가 서로를 함께 만족시켜 줄 수 있다면 좋을 텐데...\/\/\/」
								PRINTFORMDW 당신은 그런 장면 전체를 보는 것을 정말로 원하고 있다고 생각한다.
							ENDIF
						ENDIF
					CASE 4
						PRINTFORML 「헤이 %CALLNAME:MASTER%, 내 방에 카메라를 설치하는 게 좋을까?」
						PRINTFORMDW "보안을 위해서?"
						PRINTFORML 「아니, 아니. 네가 내 일상을 그 영광스러운 모습 그대로 볼 수 있을 거라고 생각했어.」
						PRINTFORML 「네가 원할 때 옷 갈아입는 모습이나 자위하는 모습을 모두 볼 수 있게 말이야.」
						PRINTFORML 「좀 부끄럽긴 하지만... 어쩌면 목욕 중이거나 변기 속에서도 말이지...\/\/\/」
						PRINTFORMDW 너는 그런 것들을 간절히 보고 싶지만, 영웅적으로 욕망을 거부한다.
					CASE 5
						PRINTFORML 「빨간 팬티를 살 수 있을지 궁금해졌어.」
						PRINTFORMDW "갑자기 이게 뭐야?"
						PRINTFORML 「음, 내 다른 모든 건 빨갛지만, 팬티만 하얗거든.」
						PRINTFORMDW 빨간 것도 좋을 수도 있지만 흰 팬티에 아무 문제 없다고 스스로 생각한다.
				ENDSELECT
			CASE -1
				PRINTFORML 「말을 나누는 것보다 몸으로 이어지는 게 소통하기 더 쉽지 않아?」
		ENDSELECT
	ELSEIF TALENT:思慕
		;思慕、追々追加予定
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 「그 대화는 좋았어. 더 많이 이야기하고 싶게 만들어.」
				PRINTFORML 「우리 할 수 있는 다른 이야기는 없어?」
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「저기, %CALLNAME:MASTER%... 혹시 마음에 드는 사람 있어...?」
						PRINTFORMDW 유메미가 자꾸 당신을 흘긋거리며 말한다.
					CASE 1
						PRINTFORML 「요즘 매일 너무 즐겁게 지내. 아마 다 너 덕분인 것 같아.」
						PRINTFORMDW 유메미는 그렇게 말하며 당신을 향해 미소 짓는다.
					CASE 2
						PRINTFORML 「아마 내가 해왔던 게 연구뿐이었기 때문일지도 모른다.」
						PRINTFORML 「하지만 이 세계에 온 이후로, 아직 내가 하지 못한 즐거운 일들이 많이 남아있다고 생각하게 되었다.」
				ENDSELECT
			CASE -1
				PRINTFORML 「...어, 음, 있잖아...」
				PRINTFORMDW 유메미는 어색한 표정으로 서 있다.
		ENDSELECT
	ELSEIF TALENT:セフレ
		;セフレ(一部通常時を流用)
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 「흥미롭네. 좀 더 자세히 말해 줄래?」
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아, 그런가요.」
						PRINTFORMDW 유메미는 별 관심 없이 듣는다.
					CASE 1
						PRINTFORML 「헤이, 오늘 하는 거 원하지 않아?」
						PRINTFORMDW 유메미는 너와 이야기하는 것보다 너와 섹스하는 것에 더 관심 있는 듯하다.
					CASE 2
						PRINTFORML 「그냥 기분 될 때 만나서 섹스하는 거지...」
						PRINTFORML 「왠지 이 관계가 그렇게 나쁘게 느껴지지 않아.」
				ENDSELECT
			CASE -1
				PRINTFORML 「…우리 얘기 끝난 거야? 섹스 안 할 거면 그냥 집에 갈래.」
				PRINTFORMDW 유메미는 지루해 보인다…
		ENDSELECT
	ELSE
		;通常時
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 「흥미롭네요. 더 자세히 말해 줄 수 있나요?」
			CASE 0
				PRINTFORML 「아, 그런가요.」
				PRINTFORMDW 유메미는 별 관심 없이 듣는다.
			CASE -1
				PRINTFORML 「이 이야기 벌써 들어본 것 같은 기분이 드네...」
				PRINTFORMDW 유메미는 정말 지루해 보인다...
			CASE -2
				PRINTFORML 「...음...?」
				PRINTFORMDW 유메미는 이해하지 못하는 듯 고개를 갸웃거린다. 나중에 다시 시도해보는 게 좋을지도 모르겠다...
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K9_301
CALL M_KOJO_MESSAGE_COM_K9_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == 1
		IF TALENT:恋慕
			PRINTFORML 「오, 오늘 차가 유난히 맛있네. 혹시 만드는 비결 같은 게 있니?」
			PRINTFORMDW "그게... 음, 뭐랄까... 알잖아..."
			CALL HPH_PRINT,@"「단지 \"비밀 재료는 연모다\" 같은 것인 건 말하지 말아줘...?」","L"
			PRINTFORMDW "안타깝게도, 그건 목표에서 크게 벗어나지 않아."
		ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
			PRINTFORML 「와, 이거 정말 좋다. 아, 그런데 %조사처리(CALLNAME:MASTER,"는")%?」
			PRINTFORMDW "뭔데?"
			PRINTFORML 「창녀의 정액으로 우려낸 차가 맛있을 거라고 생각해?」
			PRINTFORMDW "갑자기 왜 그래, 괜찮아?"
			PRINTFORML 「에헤~ 그냥 문득 떠올랐지. 아, 한번 해봐야 하나...?」
			PRINTFORMDW 솔직히 말하자면, 너라면 시도해보고 싶어 할 거야.
		ELSE
			PRINTFORML 「아아, 이거 꽤 좋네. 치유리에게 당신의 방법을 가르쳐 줄 수 있나요?」
			PRINTFORML 「에? 안 돼? 아쉽네... 항상 이렇게 괜찮으면 독차지하고 싶어지잖아.」
		ENDIF
	ELSEIF TFLAG:193 == 0
		IF TALENT:恋慕
			PRINTFORML 「아, 오늘 차가 유난히 맛있네. 혹시 특별한 비법이라도 있는 거야?」
			PRINTFORMDW "그게... 음, 뭐랄까... 있잖아..."
			CALL HPH_PRINT,@"「단지 \"비밀 재료는 연모다\" 같은 것인 건 말하지 말아줘...?」","L"
			PRINTFORMDW "안타깝게도, 그건 목표에서 크게 벗어나지 않아."
		ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
			PRINTFORML 「아아, 고마워요. 아, 그런데 %CALLNAME:MASTER%은요?」
			PRINTFORMDW "무슨 일이야?"
			PRINTFORML 「모유차는 유행이 지난 걸까요?」
			PRINTFORMDW "여전히 꽤 흔하다고 생각하는데."
			PRINTFORML 「그렇군요. 혹시 좋은 건지 궁금하네요... 만약 임신하게 되면 한번 만들어 봐야겠어요...」
			PRINTFORMDW "좋게 들리네."
		ELSE
			PRINTFORML 「음, 차라고? 고맙네. 괜찮다면 마셔도 돼.」
			PRINTFORML 「내 보좌관이 이렇게 배려심 깊었으면 좋겠는데... 그나저나 이 차는 도대체 어디서 온 거야?」
			PRINTFORMDW "그건 영업 비밀이야, 부인."
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「우으...! 도대체 이 맛은 뭐지...?」
			PRINTFORMDW "무슨 일이야...?"
			PRINTFORML 「음 어...이상한 거 넣은 건 아니지 생각하면서 "이게 맛을 더 좋게 만들 거야"아니 뭐 그런 거라도?」
			PRINTFORMDW "그렇게 생각 안 해...미안해..."
		ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
			PRINTFORML 「이상한 거 넣진 않았지? 약 같은 거?」
			PRINTFORMDW "내가 그렇게 하길 원했어?"
			PRINTFORML 「내 말은, 그게 나중에 섹스할 수도 있고, 네가 맛을 약 탓으로 돌릴 수 있게 되니까.」
			PRINTFORMDW 첫 번째 건 네 말이 맞는 것 같아.
			PRINTFORML 「음... 왜 이렇게 이상한 맛이 나는 거지...」
			PRINTFORMDW "미안해, 그냥 솔직하게 실패했을 뿐이야."
		ELSE
			PRINTFORML 「...야, 너... 뭐 망친 거 아니지?」
			PRINTFORMDW 유메미가 시큼한 표정으로 당신에게 질문한다.
			PRINTFORMDW 당신은 실수를 한 건 아닌지 궁금해진다... 이번에 무언가를 추가했는지 기억해 본다...
		ENDIF
	ENDIF
	;尿意追加を入れたい、利尿剤効果中＆おもらし癖があるとブーストある感じで
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K9_302
CALL M_KOJO_MESSAGE_COM_K9_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;もうちょいパターンがあるといいなあ
	IF TALENT:恋慕
		PRINTFORML 「아하하, 이봐, %CALLNAME:MASTER%, 그만둬.」
	ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
		CALL HPH_PRINT,@"「이봐, 이리 와봐... HPH 섹스할 기분 됐어?」","L"
	ELSEIF TALENT:思慕
		PRINTFORML 「너한테 무슨 일이야? 갑자기 나한테 그렇게 매달리다니.」
	ELSE
		PRINTFORML 「뭐 하는 거야? 이상한 사람 같아.」
	ENDIF
ENDIF
RETURN 1
;==================================================
;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K9_303
CALL M_KOJO_MESSAGE_COM_K9_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 2
			PRINTFORML 「이번 한 번은 그냥 넘어가 주지. 하지만 다시는 그러지 마, 알았지?」
		CASE 1
			PRINTFORML 「좋아, 하지만 다시는 그러지 마, 알겠지?」
		CASE 0
			PRINTFORML 「좋아, 좋아, 알겠어... 이번 한 번만 봐줄게.」
		CASEELSE
			PRINTFORML 「미안하지만 아직 너를 용서할 준비가 안 됐어. 나중에 다시 와줘.」
	ENDSELECT
