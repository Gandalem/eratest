;368,自由行動に付き合う
;技能系の行動は技能レベルが1以上なら発生
;==================================================

@M_KOJO_MESSAGE_COM_K9_368
CALL M_KOJO_MESSAGE_COM_K9_368_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			IF TFLAG:193 == -1
				IF TALENT:恋人
					PRINTFORML 「음... 연인에게조차 사적인 게 있는 건 있어.」
					PRINTFORML 「그렇다고 해서 네가 걱정할 일은 아니야.」
				ELSEIF TALENT:恋慕
					PRINTFORML 「아니야, 아무것도 아니야, 정말 아무것도 아니라고.」
					PRINTFORML 「네 도움이 필요할 만큼 큰일은 아니니까 걱정하지 마.」
				ELSEIF TALENT:思慕
					PRINTFORML 「아-아무것도 아니야, 걱정 마――」
					PRINTFORML (내가 %조사처리(CALLNAME:MASTER,"에게")% 직접 물어볼 수 있는 게 아닌 것 같아. 만약 %HE_SHE(MASTER)%가 누군가를 좋아한다면...)
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					PRINTFORML 「음~? 아무것도 아니야, 걱정하지 마.」
				ELSE
					PRINTFORML 「너와 관련된 일은 별로 생각하고 있지 않아.」
				ENDIF
			ELSE
				IF TALENT:恋人
					PRINTFORML 「음... 내가 너와 얼마나 머물 수 있을지 궁금했을 뿐이야.」
					PRINTFORML 「나는 생명체의 수명에 대해 전문가가 아니라, 명확한 생각이 없어.」
				ELSEIF TALENT:恋慕
					PRINTFORML 「음, 매일이 이렇게 충만할 수 있을 줄은 상상도 못 했어.」
					PRINTFORML 「분명 전부 당신 덕분이야.」
				ELSEIF TALENT:思慕
					PRINTFORML 「아-아아... 혹시, 음, 아하... 좋아하는 음식이 있는지 궁금했어\/\/\/」
					PRINTFORML (만약 %HE_SHE(MASTER)%에게 누군가를 좋아한다면 %조사처리(CALLNAME:MASTER,"는")% 직접 할 수 없을 것 같아...)
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					PRINTFORML 「음~? 오늘 섹스할 수 있을까 해서 말이야, 그게 다야.」
					PRINTFORML 「에? 안 되면 나중에 손가락으로라도 할게.」
				ELSE
					PRINTFORML 「음, 다음 연구 프로젝트에 대해서 생각해 보고 있었어.」
				ENDIF
			ENDIF
			;PRINTFORMW
		CASE 1
			;▼遊ぶ［一緒に遊ぶ］
			;※[幼稚]持ちのみ
			;TFLAG:193,1=大いに盛り上がる,-1=あまり盛り上がらない
			;PRINTFORMW
		CASE 2
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			IF TFLAG:193 == -1
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「배가 안 고프면 억지로 먹을 필요 없어, 알잖아?」
					PRINTFORML 「나 어디 가지 않을 테니, 다음에 정말 식욕이 생길 때 다시 와.」
				ELSEIF (TALENT:思慕 == 1 && TALENT:セフレ == 2) || TALENT:思慕
					;愛人/思慕
					PRINTFORML 「헤이, 배가 안 고프면 억지로 먹지 마...」
					PRINTFORML (정말 그렇게 먹고 싶다고 말하면... 나 스스로 신경 쓰게 될 거야...)
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					PRINTFORML 「헤이, 너무 많이 먹을 필요는 없어... 그러니까 기운을 유지하는 건 중요하지만...」
					PRINTFORML 「배탈 나면 소용없잖아.」
				ELSE
					PRINTFORML 「이봐, %CALLNAME:MASTER%, 억지로 먹으려고 하지 마.」
					PRINTFORML 「네가 몸을 상하게 해서 누군가 돌봐줘야 하게 되면 귀찮잖아.」
				ENDIF
			ELSE
				IF TALENT:恋人 || TALENT:恋慕
					IF ABL:MASTER:料理技能 > ABL:料理技能
						PRINTFORML 「너랑 같이 식탁에 앉게 되어서 기쁜데...」
						PRINTFORML 「나보다 요리를 더 잘하잖아, 그치? 내 요리 경험 부족한 걸 알아챌까 생각하면 좀 민망해져서...\/\/\/」
						PRINTFORMDL 당신은 그녀에게 그런 종류의 일에 대해 별로 걱정 안 한다고 안심시킨다.
						PRINTFORML 「그렇구나? 음, 고마워... 노력해서 실력을 늘릴게\/\/\/」
					ELSE
						PRINTFORML 「음~♪ 어때? 꽤 괜찮지?」
						PRINTFORMDL 정말로, 유메미의 요리가 당신 것보다 더 나은 것 같다.
						PRINTFORML 「이봐, 이제 식기 전에 먹어.」
						PRINTFORMDL 두 사람은 함께 식사를 즐긴다.
					ENDIF
				ELSEIF (TALENT:思慕 == 1 && TALENT:セフレ == 2) || TALENT:思慕
					;愛人/思慕
					IF ABL:MASTER:料理技能 > ABL:料理技能
						PRINTFORML 「어? 너도 좀 먹고 싶어? 아, 뭐, 그럴 수도 있지...\/\/\/」
						PRINTFORML 「너 요리 실력이 나보다 낫잖아? 네가 왜 굳이 그렇게까지 할지는 모르겠지만……」
						PRINTFORMDL 그건 서로 아무 상관도 없는 일이라고 유메미에게 말한다.
						PRINTFORML 「아, 아아, 그렇지! 그, 그, 그럼 먹자!\/\/\/」
						PRINTFORML (난 항상 %HIS_HER(MASTER)%의 페이스에 휘말려 버려……\/\/\/)
					ELSE
						PRINTFORML 「뭐 좀 먹고 싶어...? 내 소박한 요리가 괜찮다면 말이야...」
						PRINTFORMDL 당신은 자신이 요리 실력이 그다지 뛰어나지 않다고 그녀에게 안심시킨다.
						PRINTFORML 「그렇구나... 그럼, 먹자.」
					ENDIF
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					IF ABL:MASTER:料理技能 > ABL:料理技能
						PRINTFORML 「음? 먹고 싶어? 오히려... 네가 요리하는 게 낫지 않을까? 나보다 잘하니까.」
						CALL HPH_PRINT,@"「그리고 네가 가진 것들에 더 좋을 거라고 확신해... \"체력\"...HPH 에이? 내가 만든 걸 낭비하고 싶지 않아?」","W"
						PRINTFORML 「아~... 네 말이 맞겠지. 그럼 이미 다 됐으니 먹자.」
					ELSE
						PRINTFORML 「음? 먹고 싶어? 물론이지, 어쨌든 네가 "체력"을 유지해야 하니까.」
						PRINTFORML 「그럼 먹자.」
					ENDIF
				ELSE
					IF ABL:MASTER:料理技能 > ABL:料理技能
						PRINTFORML 「에... 먹고 싶어...? 네 눈빛에는 더 잘할 수 있을 거라고 아는 듯한 표정이 있어...」
						PRINTFORML 「뭐 어때ー... 네가 괜찮다면 좀 먹어도 돼.」
					ELSE
						PRINTFORML 「고작 아는 사이인데 같이 식사를 하다니...?」
						PRINTFORML 「음, 뭐, 그래... 여기에 있을게.」
					ENDIF
				ENDIF
			ENDIF
			;PRINTFORMW
		CASE 3
			;▼つまみ食い［一緒につまみ食い］
			;※[妖精]持ちとルーミア、こいし、幽々子、紫苑のみ
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			;PRINTFORMW
		CASE 4
			;▼掃除［掃除を手伝う］
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			;PRINTFORMW
		CASE 5
			;▼運動［一緒に運動する］
			;※[音楽知識]持ちは除く（演奏になる）
			IF TALENT:愛欲 || (TALENT:思慕 && TALENT:セフレ) || TALENT:セフレ
				PRINTFORML 「저... 저 좀 골반 말고 움직여야 할 것 같아, 가끔은...」
				IF TALENT:バストサイズ > 0
					PRINTFORMDL 유메미의 움직임에 맞춰 흔들리고 출렁이는 가슴을 훔쳐보지 않을 수 없다.
					CALL HPH_PRINT,@"「오호~? 어디를 보고 있다고 생각하는 거야, %CALLNAME:MASTER%?」","W"
					CALL HPH_PRINT,@"「후후, 네가 보지 못한다고 말한 적은 없는데」","W"
				ENDIF
			ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「음~... 가끔은 가벼운 운동을 하는 것도 좋지.」
				IF TALENT:バストサイズ > 0
					PRINTFORMDL 네 시선은 유메미의 움직임에 맞춰 흔들리고 출렁이는 가슴에서 벗어날 수가 없다.
					PRINTFORMDL 그녀는 당신이 자신을 훔쳐보는 것을 금세 알아차린다...
					PRINTFORML 「야... 어디를 보고 있다고 생각하는 거야...\/\/\/」
				ENDIF
			ELSE
				PRINTFORML 「하나, 둘~, 셋, 포... 하아~, 몸이 너무 뻣뻣해...」
				PRINTFORML 「가끔은 이런 매듭들을 풀어줘야 하는 거야...!」
				IF TALENT:バストサイズ > 0
					PRINTFORMDL 움직임에 맞춰 가슴이 출렁이는 것이 느껴진다.
					PRINTFORML 「%CALLNAME:MASTER%...? 대체 어디를 보고 있는 거지...?」
					PRINTFORMDL 유메미는 당신에게 경멸 어린 눈빛을 보낸다.
				ENDIF
			ENDIF
			;PRINTFORMW
		CASE 6
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			IF TFLAG:193 == -1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「음~~? 아~... 응응~, 나중에 말해줄게~」
					CASE 1
						PRINTFORML 「아~? 아~... 응응, 나중에~」
					CASE 2
						PRINTFORML 「음~, 뭔데~? 아, 내 의견? 아~ 응, 나중에 할까~」
				ENDSELECT
			ELSE
				PRINTFORML 「내가 읽고 있는 책은 어때?」라고 묻는다.
				IF ABL:MASTER:教養 == 0
					PRINTFORMDL 유메미에게 책에 대해 어떻게 생각하는지 묻지만, 그녀의 말을 전혀 이해할 수 없다...
					PRINTFORML 「아~... 네 얼굴엔 멍한 표정이 떠 있네... 시간 낭비였나 봐...」
				ELSEIF ABL:MASTER:教養 >= 4
					PRINTFORMDL 당신은 유메미에게 그 책에 대해 어떻게 생각하는지 묻고, 그녀의 대답을 곱씹은 후 신중한 응답을 건넨다.
					PRINTFORML 「그리고... 이건 마치... 그래서 그렇게 된 거야.」
					PRINTFORMDL 두 사람은 잠시 동안 의견을 나눈다.
				ELSE
					PRINTFORML 「이것은... 그리고 그게 내가 생각했던 바였다. 그래서 이 부분은...」
					PRINTFORMDL 그녀가 하는 모든 말을 완전히 이해할 수는 없지만, 한동안 대화를 따라갈 수 있다.
				ENDIF
			ENDIF
			;PRINTFORMW
		CASE 7
			;▼料理［料理を手伝う］→［料理を分けてもらう］
			;TFLAG:193,2=料理を手伝う,0=作った料理を食べる,-1==MASTERはお腹が空いてなかった（食べる時）
			;【Memo】食べるときは「一緒に食事する」を流用しています
			IF TFLAG:193 == 2
				IF (ABL:MASTER:料理技能 >= 3 && (ABL:MASTER:料理技能 > ABL:料理技能))
					;MASTERのが夢美よりけっこうな料理上手
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「도와줄 거야? 요리를 정말 잘하니까 그러고 싶어～」
						IF TALENT:恋人
							PRINTFORML 「당신은 훌륭한 주부(가정 전담)가 될 거라고 장담해...」
							SIF ABL:MASTER:清掃技能 >= 3
								PRINTFORML 「너 청소 잘한다...」
							SIF ABL:MASTER:話術技能 >= 3
								PRINTFORML 「당신은 말하는 게 능하군요...」
							SIF ABL:MASTER:教養 >= 3
								PRINTFORML 「연구하는 것까지 도와줄 수도 있겠네...」
						ELSE
							PRINTFORML (만약 %HE_SHE(MASTER)%이 나의 %PRINT_MALE("boy", MASTER)% 친구였다면—%HE_SHE(MASTER)%은 흥미를 느낄까~)
						ENDIF
						PRINTFORMDL 유메미가 생각에 잠겨 있는 동안, 당신은 재빨리 재료를 준비하기 시작한다.
					ELSEIF (TALENT:思慕 && TALENT:セフレ == 2) || TALENT:思慕
						PRINTFORML (아, 정말... %조사처리(CALLNAME:MASTER,"는")% 굉장한 요리사야... 꿈만 같아...)
						PRINTFORML 「...하?! 아, 아니야, 아무것도 아니야!」
						PRINTFORML (제발 유메미, 지금이 환상을 펼칠 때가 아니잖아!\/\/\/)
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						PRINTFORML 「오~... 네 손가락은 "그것" 이상도 할 수 있는 것 같네, 음...」
						PRINTFORML 「그런 요리 실력으로 얼마나 많은 여자를 매료시켰을지 궁금하네?」
						PRINTFORMDL 당신은 서둘러 그 주장을 부인했다.
						PRINTFORML 「그냥 농담이야, 너무 흥분하지 마~ 네가 요리를 얼마나 잘하는지에 놀랐을 뿐이야.」
					ELSE
						PRINTFORML 「...」
						PRINTFORMDL 유메미는 당신의 숙련된 작품을 넋 놓고 바라보지만, 그녀의 시선을 알아차리자 재빨리 고개를 돌린다.
						PRINTFORML 「아, 아니야, 그냥... 이 패배감이 뭐야... 요리 정말 잘하네...」
					ENDIF
				ELSEIF ABL:MASTER:料理技能 < ABL:料理技能
					;夢美のほうが上手(デフォルト0なのでデータ弄らないと発生しないと思うが)
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「도와 줄 거야? 고마워, 정말 고맙다.」
						PRINTFORML 「그렇다면 먼저……」
					ELSEIF (TALENT:思慕 && TALENT:セフレ == 2) || TALENT:思慕
						PRINTFORML 「도와주고 싶은 거니? 음, 그렇다면…」
						PRINTFORML (왜 %HE_SHE(MASTER)%이 도와주려 하는 건지 모르겠네... 혹시 나를 알아본 걸까...? 아아, 지금은 그럴 때가 아니야!)
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						PRINTFORML 「도와주고 싶어? 너는 항상 "그거"를 도와주니까, 억지로 할 필요는 없어...」
						PRINTFORML 「음, 그래도 고집을 부린다면, 한번 보자...」
					ELSE
						PRINTFORML 「응? 도와주겠다는 거야?」
						PRINTFORML 「There's not much to do, but let's see, hmm...」
					ENDIF
					PRINTFORMDL 유메미의 지시에 따라 재료를 준비한다.
				ELSE
					;どっこいどっこい
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「도와줄래? 고마워, 그렇게 해주고 싶어.」
						PRINTFORML 「우리 같이 멋진 거 만들자!」
					ELSEIF (TALENT:思慕 && TALENT:セフレ == 2) || TALENT:思慕
						PRINTFORML 「도와줄 거야? 고마워, 정말 고맙게 생각해.」
						PRINTFORML 「... 잘 됐으면 좋겠어.」
						PRINTFORML (같이 하니까 거의... 사랑하는 것 같아... 아, 지금 그런 얘기 할 때가 아니야!\/\/\/)
