; Modular ERB: 個人口上/009 Yumemi [夢美]/夢美/M_KOJO_K9_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K9
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORML (어라, 뭐야? 무슨 일이야...?)
ELSEIF TFLAG:時姦刻印取得 == 2
	CALL HPH_PRINT,@"(뭐지, 이 느낌은... 내 몸이... 무언가를 갈망하는 것 같아... HPH)","L"
ELSEIF TFLAG:時姦刻印取得 == 3
	CALL HPH_PRINT,@"(이게 뭐야, 왜 갑자기 이렇게 기분이 좋아HPHHPHHPH)","L"
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	CALL HPH_PRINT,@"「Nnnnnn～～～HPH」","L"
	PRINTFORML (와, 방금... 정말 굉장했어...)
ELSEIF TFLAG:23 == 2
	CALL HPH_PRINT,@"「...푸아아...호프」","L"
	CALL HPH_PRINT,@"(머리가 하얘진다... 이 쾌감 때문에... 미쳐가고 있다... HPH)","L"
ELSEIF TFLAG:23 == 3
	CALL HPH_PRINT,@"「아아~...흐읍 하아~흐읍 하아흐읍」","L"
	CALL HPH_PRINT,@"(섹스가 이렇게 좋을 줄은 몰랐어...HPH 내 온몸이 이 감각을 배운다면...HPH)","L"
	CALL HPH_PRINT,@"(나는 분명 섹스에 중독될 거야...후후후후)","L"
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORML (방금 그건 뭐였지... 기분 좋았나...?)
	PRINTFORML 「야, 조금만 더 할 수 있을까?」
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORML (이건 확실히 기분 좋다... 이제 확신했다.)
	PRINTFORML 「더... 이렇게 더 느끼고 싶어... 당신과 함께.」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORML (... 더 이상 참을 필요는 없겠지... 이렇게 기분 좋은 것에 대해서...)
	CALL HPH_PRINT,@"「%CALLNAME:MASTER%... 계속 해볼까...?HPH」","L"
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORML (%HIM_HER(MASTER,,1)%과 함께라면... 이렇게 조금 하는 건 괜찮겠지...? )
	PRINTFORML 「아니, 아무것도 아니야. 응.」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML (어쩐지... 이 일들을 %HIM_HER(MASTER,,1)%과 계속 하고 싶은 기분이 드네...)
	PRINTFORML 「왜 그렇게 조용하냐고? 아니, 아니야. 화난 것도 아니고, 괜찮아.」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML (응, 만약 그것이 %HIM_HER(MASTER,,1)%과 함께라면... 더 많은 것들을 하고 싶어...)
	PRINTFORML 「뭔가 있냐고? 아, 아무것도 아니야, %CALLNAME:MASTER%♪」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 
ELSEIF TFLAG:21 == 2
	PRINTFORMW 
ELSEIF TFLAG:21 == 3
	PRINTFORMW 
ENDIF
