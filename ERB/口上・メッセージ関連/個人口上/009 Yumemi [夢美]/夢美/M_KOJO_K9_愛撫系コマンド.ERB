@M_KOJO_MESSAGE_COM_K9_9
CALL M_KOJO_MESSAGE_COM_K9_9_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		; オナニーを覗いたことがあったらちょっとMSG変わるよ
		IF CFLAG:11 == 1
			PRINTFORML 「뭐…… 어, 보, 보고 싶다고……? 전에도 이미 내가 하는 거 봤잖아……? 그걸로 부족했어……?」
			PRINTFORML 「게다가, 어…… 이런 건 보는 게 별로 좋지 않은데…… 다시 생각해 보면 안 될까? ㅋㅋㅋ\/\/\/」
			PRINTFORML 「어, 그런 걸 보기 때문에 더 보고 싶은 거야?」
			PRINTFORML 「정말 네 나사가 몇 개 빠진 것 같다고 생각해……」
			PRINTFORML 「하아…… 뭐, 괜찮겠지……」
			PRINTFORMDW 유메미는 답답한 듯 한숨을 내쉬며 저항하듯 손가락을 가슴에서 %FSYN("vagina")%하고, 천천히 가슴을 어루만지기 시작한다.
			PRINTFORML 「으으…… 응…… 하아……ㅋㅋㅋ\/\/\/」
			PRINTFORMDW 천천히 몰입하기 시작하자, 쾌락을 찾는 듯 움직임이 더욱 격렬해진다.
			PRINTFORML (%조사처리(CALLNAME:MASTER,"가")% 보고 있어…… 꼭 저렇게 가까이서 봐야 하는 걸까……?)
			PRINTFORMDW 하지만 유메미는 네가 지켜보는 것만으로도 상당히 흥분한 모양이다.
			PRINTFORML 「아, 응…… 아후…… 왜, 왜 이렇게 더 좋은 거야…… 그렇게 가까이서 보지 마……ㅋㅋㅋ\/\/\/」
		ELSE
			PRINTFORML 「안녕?! 뭐, 진심이야?!」
			PRINTFORMDW "난・항상・진심이라고!"
			PRINTFORML 「그, 그게 자위...? 남들이 볼 만한 게 아니잖아...\/\/\/」
			PRINTFORMDW 당신은 그녀가 실제로 해본 적이 없는지 묻는다.
			PRINTFORML 「뭐야...! 당연히 했지! 몇 번이나 자위를 했어! ...아...\/\/\/」
			PRINTFORML 「아, 아아ーー... 했어, 했어! 하지만! 남들이 볼 만한 게 아니라고 했잖아!\/\/\/」
			PRINTFORMDW 당신은 그것이 바로 당신이 보고 싶었던 이유라고 말한다.
			PRINTFORML 「~~~~... 정말 모르겠어...\/\/\/」
			PRINTFORML 「좋아, 할게...!\/\/\/」
			PRINTFORMDW 얼굴을 새빨갛게 물린 유메미는 어색한 움직임으로 자위를 시작한다.
		ENDIF
		RETURN 1
	ENDIF
	;通常の処理
	;ここには各ステータスの状態に応じた口上を表示
	IF TALENT:73 == 1
		;[自慰狂い]を持っている場合(TALENT:73 == 1)
		CALL HPH_PRINT,@"「에? 저, 저에게 스스로 손가락을 대라고...? 큭큭큭」","L"
		PRINTFORMDW 욕망에 찬 눈빛으로, 유메미는 자신의 몸을 가지고 놀기 시작한다.
		PRINTFORMDW 그녀의 %FSYN("vagina")%이 음란한 물보라 소리를 낸다.
		CALL HPH_PRINT,@"「아아, 굉장해 HPH 기분 좋아 HPH 나 스스로 손가락으로 만지는 게 정말 좋아 HPH」","L"
		CALL HPH_PRINT,@"「나는 매일 이것을 한다. 완전히 젖을 때까지. 그만둘 수 없다. 계속 하고 있다.」","L"
		CALL HPH_PRINT,@"「자, 내가 스스로 손가락으로 자위하는 걸 봐... 사정할 때까지 HPHHPHHPH」","L"
		CALL M_KOJO_MESSAGE_MASTERBATION_K9
	ELSEIF ABL:14 >= 6 && ABL:30 >= 4
		;露出癖と自慰中毒が高い(Lv>=6 & Lv>=4)場合
		PRINTFORMDW 자신의 행동을 선명하게 볼 수 있도록 위치를 잡은 유메미는 자위에 몰두하기 시작한다.
		PRINTFORMDW 그녀의 손길 아래에서 지켜지고 있다는 감각이 즐거움에 녹아내리게 한다.
		CALL HPH_PRINT,@"「하아후 후후, 그래, 굉장해, %CALLNAME:MASTER%!후후」","L"
		CALL HPH_PRINT,@"「있지, 아아, 너 보고 있니, 음, 보고 있어? 그것이 보이니? 이 HPH에 대해 어떻게 생각해」","L"
		CALL HPH_PRINT,@"「아, 안 돼, 너무 좋아, 손가락을 멈출 수가 없어 HPH %CALLNAME:MASTER%HPH」","L"
		CALL M_KOJO_MESSAGE_MASTERBATION_K9
	ELSEIF ABL:30 >= 4
		;自慰中毒のみ高めの(Lv>=4)場合
		CALL HPH_PRINT,@"「하아, 응, 기분 좋다! 지켜보고 있는데도 HPH」","L"
		PRINTFORMDW 당신에게 보이고 있음에도, 유메미는 쾌락 속에서 자신을 잃고 있다.
		PRINTFORMDW 그녀는 양손으로 격렬하게 자위를 한다.
		PRINTFORMDW 그녀의 연모즙이 사방에 뿌려지고, 그녀의 %FSYN("vagina")%은 음탕한 물 튀기는 소리를 낸다.
		CALL HPH_PRINT,@"「아아, 아아, 아, 못 참겠어, 너무 좋아, 참을 수가 없어HPH」","L"
		CALL M_KOJO_MESSAGE_MASTERBATION_K9
	ELSE
		;その他
		PRINTFORML 「또, 또...? 정말 믿을 수가 없어... 으응...\/\/\/」
		PRINTFORMDW 유메미는 부끄러워하면서도 결국 자위를 시작한다. 얼마 지나지 않아 달콤하게 신음하기 시작한다.
		PRINTFORML 「아, 아앗, 아으응, 우우... 아후... 왜...」
		PRINTFORML (보고 있는데도... 이렇게 부끄러운 짓을 하는데... 평소보다 더 좋아\/\/\/)
		PRINTFORMDW 유메미는 무의식적으로 손을 더욱 격렬하게 움직이기 시작한다.
		CALL M_KOJO_MESSAGE_MASTERBATION_K9
	ENDIF
ENDIF
RETURN 1
;==================================================
; 自慰口上関数(自慰コマンドサブ関数:その1)
; ここには各プレイ別の口上を表示,キス有無はとりあえず無視
;==================================================

@M_KOJO_MESSAGE_MASTERBATION_K9
IF TEQUIP:32
	;シャワー使用時分岐
	IF TEQUIP:13 && TEQUIP:14
		;シャワー2穴バイブオナニー
		CALL HPH_PRINT,@"「구우, 히이, 우와아, 예스, 예스 HPH 굉장해~!!HPHHPHHPH」","L"
		PRINTFORMDW 유메미의 %FSYN("vagina")%과 항문에 진동기가 삽입되어 있다.
		PRINTFORMDW 샤워수가 그녀의 가슴과 음핵을 적시는 동안, 유메미는 쾌감에 취한 얼굴로 진동기를 넣었다 빼기를 반복한다.
		CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
	ELSEIF TEQUIP:13
		;シャワー1穴(V)オナニー
		CALL HPH_PRINT,@"「아하, 그래, 샤워하고 내 보지 문지르는 거 HPH」","L"
		PRINTFORMDW 샤워가 그녀의 유두와 음핵을 때리는 동안, 유메미는 진동기를 자신의 %FSYN("vagina")%에 넣었다 빼며 쾌락을 만끽한다.
		CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
	ELSEIF TEQUIP:14
		;シャワー1穴(A)オナニー
		CALL HPH_PRINT,@"「――아, 우와, 네, 네, 샤워하면서, 게임을 하면서, 내 뒤쪽으로, 기분 좋아HPH」","L"
		PRINTFORMDW 샤워 물이 그녀의 가슴을 타고 흘러내리고 %FSYN("vagina")%, 유메미는 진동기를 항문에 넣었다가 빼기를 반복한다.
		CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
	ELSE
		;シャワーオナニー
		CALL HPH_PRINT,@"「아... 냐아, 아으, 이거, 기분 좋다... 끼아헵」","L"
		PRINTFORMDW 유메미가 자신의 %FSYN("vagina")%을 활짝 벌리고 샤워기를 그것에 대자, 그녀의 몸이 쾌감으로 떨린다.
		CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
	ENDIF
ELSEIF TEQUIP:13 && TEQUIP:14
	;2穴バイブオナニー
	CALL HPH_PRINT,@"「아히, 놀라워 HPH 동시에 내 보지와 항문에 밀어 넣는 게 HPH」","L"
	PRINTFORMDW 유메미는 자신의 질과 항문에 진동기를 넣었다 빼며 탐욕스럽게 쾌락을 만끽했다.
	CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
ELSEIF TEQUIP:13
	;1穴バイブ(V)オナニー
	CALL HPH_PRINT,@"「네, 굉장해 HPH 내 보지에 밀어넣고 있어 HPH」","L"
	PRINTFORMDW 유메미는 진동기를 자신의 %FSYN("vagina")%에 넣었다가 빼면서 가슴과 음핵을 어루만졌다.
	CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
ELSEIF TEQUIP:14
	;1穴バイブ(A)オナニー
	CALL HPH_PRINT,@"「아, 기분 좋아, 비록 내 뒤에 넣고 있는 게 놀랍지만네」","L"
	PRINTFORMDW 유메미는 진동기를 항문에 넣었다 빼며 가슴과 음핵을 애무했고, 그 쾌락 속에서 자신을 잃는다.
	CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
ELSE
	;通常のオナニー
	PRINTFORML 「아, 내 가슴이랑 클리토리스가 기분 좋아...」
	PRINTFORMDW 능숙한 동작으로 유메미는 손가락을 가슴 위로 미끄러뜨리고 %FSYN("vagina")%하며 그 쾌감을 음미했다.
	CALL M_KOJO_MESSAGE_ORGAZM_ONA_K9
ENDIF
;==========================================================
; 自慰絶頂口上関数(自慰コマンドサブ関数:その2)
; 絶頂部分を更に切り出し、絶頂口上とそれなりにつながりが整合するように
; (間に計算結果とかが出るけども)
;==========================================================

@M_KOJO_MESSAGE_ORGAZM_ONA_K9
;-----------
;五重絶頂
;-----------
IF NOWEX:9
	PRINTFORMDW 당신은 유메미가 자위로 자신을 잃는 동안 그녀의 입술에 키스를 하고, 그녀의 몸이 즐거움으로 꿈틀거리고 떨었다.
	CALL HPH_PRINT,@"「%FSYN("lips_over")%! 더는 못 하겠어! 나 사정할 것 같아, 너무 많이, 부서질 것 같아 HPH」","L"
	PRINTFORMDW 그녀의 몸이 절정에 치닫자, 당신은 다시 한번 그녀의 입술을 자신의 것으로 덮는다.
	CALL HPH_PRINT,@"「흐윽, 흐읍, 하아하아하아아아아」","L"
ELSEIF NOWEX:8
	;----------
	;四重絶頂
	;----------
	SELECTCASE NOWEX:8
		CASE 1
			;CVAB
			CALL HPH_PRINT,@"「우와아! 안 돼, 너무 많이 HPH 이건, 너무 굉장해...HPH 미쳐버릴 것 같아 HPH 정신을 잃고 있어!HPH」","L"
			PRINTFORMDW 그녀가 거칠게 자신을 탐닉하자, 유메미는 격렬한 절정을 대비한다.
		CASE 2
			;CVAM
			CALL HPH_PRINT,@"「음우, 우우흐프 쿰, 커밍ㅎ프 내 클리트, 그리고 아쉽ㅎ프 내 푸쉬ㅎ프」","L"
			PRINTFORMDW 그녀의 민감한 질과 항문이 반복적으로 관통당하자, 유메미는 당신의 입안으로 혀를 얽는다. 그녀의 클리토스도 절정에 다가간다.
		CASE 3
			;CVBM
			CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%느낌 좋다 HPH 내 보지랑 가슴 HPH」","L"
			PRINTFORMDW 유메미는 키스 사이에서 달콤하게 한숨을 쉬며 자위한다. 그녀의 숨소리는 거칠고 얼굴은 쾌감에 취해 있다.
		CASE 4
			;CABM
			CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%흐으 내 엉덩이, 기분 좋아 흐으 난 못하겠어 흐으 내 가슴들 흐으」","L"
			PRINTFORMDW 유메미는 음란한 목소리로 말을 더듬는다. 자위에서 오는 쾌감이 그녀의 생각을 압도하는 듯하다.
		CASEELSE
			;VABM
			CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%흐응 못해 흐응 내 보지랑 항문을 같이 해줘 흐응」","L"
			PRINTFORMDW 평소의 우아함이라곤 전혀 없는 그녀의 욕망 가득한 헐떡임으로, 그녀는 자위에 빠지면서 탐욕스럽게 당신의 입술을 집어삼킨다.
	ENDSELECT
ELSEIF NOWEX:7
	;---------------
	;三重絶頂(5C3)
	;---------------
	SELECTCASE NOWEX:7
		CASE 1
			;CVA
			CALL HPH_PRINT,@"「아, 히이, 놀라운 HPH 내 하체 전체가 사정하고 있어 HPH」","L"
			PRINTFORMDW 음핵, 질, 항문에서 절정에 다다르기 직전인 유메미는 자위하는 데 몰두한다.
		CASE 2
			;VAB
			CALL HPH_PRINT,@"「우와아, 히이, 가슴에서부터, 내 보지랑 엉덩이에서도 HPH」","L"
			PRINTFORMDW 그녀가 자신의 구멍들을 헤집고 유두를 애무하자, 유메미는 빠르게 절정에 다가간다.
		CASE 3
			;CAB
			CALL HPH_PRINT,@"「아하후크 오르가슴이 와, 내 가슴이랑 클리토리스, 그리고 항문에서 나오고 있어 후크」","L"
			PRINTFORMDW 그녀는 자신의 %FSYN("vagina")%과 항문을 손가락으로 주무르며 유두를 자극하고, 유메미는 절정에 다가간다.
		CASE 4
			;CVB
			CALL HPH_PRINT,@"「내 보지가 사정하고 있고 가슴과 클리토스도 그래」","L"
			PRINTFORMDW 유메미는 자신의 질에 삽입하고 가슴과 음핵을 만지며 달콤하게 신음했고, 그녀는 빠르게 절정에 다가갔다.
		CASE 5
			;CVM
			CALL HPH_PRINT,@"「음, 내 보지랑 클리토리스에 %FSYN("lips_over")%, 아아 터져버릴 것 같아!」","L"
			PRINTFORMDW 유메미는 당신과 키스하고 그녀의 가랑이를 손가락으로 만지는 두 가지 즐거움에서 빠르게 절정에 이른다.
		CASE 6
			;VBM
			CALL HPH_PRINT,@"「흐으, 내 가슴이 %FSYN("lips_over")%... 더 많이, 내 보지가 흘려내고 있어」","L"
			PRINTFORMDW 유메미는 당신에게 키스하며 가슴과 보지를 만지다가 말을 더듬으며 절정에 이른다.
		CASE 7
			;VAM
			CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%... 내 보지랑 엉덩이랑 키스, 아아아아아흐으으윽」","L"
			PRINTFORMDW 그녀가 당신과 깊은 키스를 나누며 자신의 모든 곳을 파헤치는 동안, 유메미는 쾌락에 잠긴다.
		CASE 8
			;CBM
			CALL HPH_PRINT,@"「난, %TOLOWER(FSYN("lips_over"))%, 아니, 네 입술에 키스하는 중에도 사정하고 있어」","L"
			CALL HPH_PRINT,@"「가슴과 클리토스에 만지는 것만으로도 멈출 수 없이 사정한다」","L"
			PRINTFORMDW 유메미는 당신에게 키스하며 격렬하게 자위하는 동안 강렬한 클라이맥스로 빠르게 다가갔고 손을 더 빨리 움직이기 시작했다.
		CASE 9
			;ABM
			CALL HPH_PRINT,@"「응음, 응, 안 돼, 내 항문 아아, 좋아해」","L"
			PRINTFORMDW 그녀가 자신의 항문을 파내고 유두를 만지는 동안, 유메미는 당신과 키스를 나누며 절정에 이른다.
		CASEELSE
			;CAM
			CALL HPH_PRINT,@"「%FSYN("lips_over")%HPH %CALLNAME:MASTER%, 나 더 키스해줘HPH」","L"
			PRINTFORMDW 유메미는 음핵을 가지고 놀며 항문에 박으면서 너에게 탐욕스럽게 키스하고, 그녀의 온몸이 통제할 수 없이 떨린다.
	ENDSELECT
ELSEIF NOWEX:6
	;---------------
	;二重絶頂(5C2)
	;---------------
	SELECTCASE NOWEX:6
		CASE 1
			;CV
			CALL HPH_PRINT,@"「하아, 아, 응 HPH 내 클리토리스와 보지가 함께 오고 있어, 나도 오고 있어 HPH」","L"
			PRINTFORMDW 유메미가 그녀의 %FSYN("vagina")%과 음핵을 함께 만지자, 절정에 이르며 달콤한 신음을 터뜨린다.
		CASE 2
			;CA
			CALL HPH_PRINT,@"「아아, 그래, 거기 HPH 내 뒤를 더 파헤쳐 봐! 나 갈 것 같아 HPH」","L"
			PRINTFORMDW 유메미는 항문과 음핵을 손가락으로 만지고, 절정에 다다르면서 몸을 떨었다.
		CASE 3
			;VA
			CALL HPH_PRINT,@"「안녕, 하아, %CALLNAME:MASTER%, 봐, 나 뒤랑 보추에서 동시에 사정하고 있어 HPH」","L"
			PRINTFORMDW 그녀의 두 구멍을 가지고 놀면서, 유메미는 임박한 절정으로 인해 황홀감에 취한다.
		CASE 4
			;CB
			CALL HPH_PRINT,@"「아, 아, 보고 있는데 나 사정하고 있어, 스스로 만지니까 HPH」","L"
			PRINTFORMDW 당신이 지켜보는 가운데 유메미는 그녀의 %FSYN("vagina")%과 가슴에서 동시에 절정에 이른다.
		CASE 5
			;VB
			CALL HPH_PRINT,@"「아, 하아, 사정해, 아, 아... 내 가슴이랑 보지HPH」","L"
			PRINTFORMDW 그녀의 가슴을 만지며 손가락으로 자신의 %FSYN("vagina")%에 넣자, 유메미는 절정에 이르러 몸을 떨었다.
		CASE 6
			;AB
			CALL HPH_PRINT,@"「흡, 아, 안 돼, 내 가슴이랑 엉덩이가, 사정하고 있어, 나도 사정하는 중이야HPH」","L"
			PRINTFORMDW 유메미는 그녀의 가슴을 만지면서 손가락을 그녀의 엉덩이에 넣고 빠르게 절정에 이른다.
		CASE 7
			;AM
			CALL HPH_PRINT,@"「음, 아아, 사정한다, 내 항문에서 사정하고 있어, 더 세게 HPH」","L"
			PRINTFORMDW 그녀가 당신과 깊은 키스를 나누면서 자신의 항문을 손가락으로 만지자, 유메미는 강력한 절정에 도달한다.
		CASE 8
			;VM
			CALL HPH_PRINT,@"「응, 내 보지를 손가락으로 만지면서 오르려고 해 HPH 더 키스해줘 HPH」","L"
			PRINTFORMDW 당신은 유메미와 깊은 키스를 나누고 그녀는 자신의 가장 안쪽을 손가락으로 더듬으며 강력한 절정에 도달한다.
		CASE 9
			;CM
			CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%, 내 클리토리스에서 사정하고 있어, %조사처리(CALLNAME:MASTER,"를")% 키스하는 동안」","L"
			PRINTFORMDW 유메미는 당신과 열정적인 키스를 나누며 클리토리스를 거칠게 문지르고, 입가에서 침이 떨어지는 가운데 절정에 이른다.
		CASEELSE
			;BM
			CALL HPH_PRINT,@"「하아, 아, 음, 으음, %TOLOWER(FSYN("lips_over"))%, 못 참겠어 HPH 내 가슴과 키스 HPH」","L"
			PRINTFORMDW 그녀가 당신과 깊은 키스를 나누며 가슴을 만지는 동안, 유메미는 절정에 이른다.
	ENDSELECT
	;---------
	;単絶頂
	;---------
ELSEIF NOWEX:0
	;C
	PRINTFORML 「아, 아, 절정에 다다르고 있어, 나 절정이야, 내 음핵이 절정이야～!」
	PRINTFORMDW 유메미는 매우 민감한 자신의 음핵을 비비는 데 완전히 몰입하고, 오르가슴에 도달하며 달콤하게 숨을 들이켰다.
ELSEIF NOWEX:1
	;V
	CALL HPH_PRINT,@"「우와아, 하아, 사정해 HPH 내 보지가 사정하고 있어!」","L"
	PRINTFORMDW 절정에 도달하기 위해 스스로를 몰아붙이며, 유메미는 자신의 손가락 쪽으로 음란하게 허리를 비튼다.
ELSEIF NOWEX:2
	;A
	CALL HPH_PRINT,@"「흐으응, 아아, 하아, 안 돼, 나 가고 있어, 내 항문을 손가락으로 만지면서 가고 있어...흣」","L"
	PRINTFORMDW 유메미는 자신의 손가락을 항문에 더 깊이 박으며 골반을 비비고 절정에 이른다.
ELSEIF NOWEX:3
	;B
	PRINTFORML 「하아, 하아, 아, 나올 것 같아, 나 나오고 있어, 내 가슴에서...!」
	PRINTFORMDW 유메미는 가슴을 만지며 유두를 애무하자 절정에 이른다.
ELSEIF NOWEX:4
	;M
	CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%, %TOLOWER(FSYN("lips_over"))%... 아, 키스만으로 사정하다... 후우헵」","L"
	PRINTFORMDW 당신은 그녀의 입안을 당신의 혀로 침범하고, 마치 그녀가 깊은 키스에 자위하는 것처럼 유메미는 오르가슴에 이른다.
ELSE
	;イかない
	PRINTFORML 「아아, 아, 하아... 으응... 아, 아...!」
	PRINTFORMDW 유메미가 점차 절정에 다다르면서 그녀의 표정이 즐거움으로 녹기 시작한다.
ENDIF
