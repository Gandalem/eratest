@M_KOJO_MESSAGE_COM_K9_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「에...? 그-그게... 나를 핥아달라는 거야...?」
		PRINTFORMDW 당신은 고개를 끄덕인다.
		PRINTFORML 「잠-잠깐만! 난 아직 준비가 안 됐어――푸아아?!」
		PRINTFORMDW 유메미의 망설임을 무시하고, 당신은 자신의 입을 유메미의 질에 가져간다.
		CALL HPH_PRINT,@"「나아, 나... 기다려 달라고 했잖아!」","L"
		PRINTFORMDW 유메미의 음모가 당신의 얼굴에 스치는 것을 느끼며, 당신은 그녀의 음핵 위로 혀를 움직여 그녀를 핥는다 %FSYN("labia")%.
		PRINTFORMDW 유메미의 저항은 서서히 사라지고, 그녀는 달콤하게 신음하기 시작한다.
		CALL HPH_PRINT,@"「아아, 아, 흐으... 하프 뭐, 이거... 이 느낌...」","L"
		PRINTFORML (이것은...기쁨인가...?)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			IF TALENT:恋慕 || TALENT:愛欲
				CALL HPH_PRINT,@"「아아...흣 지금 거기 혀로 핥으면... 하아, 다시 흘러나올 거야...」","L"
				CALL HPH_PRINT,@"「정말 아깝다... 게다가 말이야, 나아아, 네 자신의 정액을 맛보고 싶다고...? HPH」","L"
				CALL HPH_PRINT,@"「아아, 정말 기분이 좋아... 그렇다면 핥아줘, 더, 응, 거기, 아히이후프」","L"
			ELSE
				PRINTFORML 「음, 아, 지금 거길 핥아주면... \/\/\/」
				PRINTFORML 「그게 새어 나가고... 아하 \/\/\/.」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		IF ABL:0 > 5
			IF TALENT:73 == 1
				CALL HPH_PRINT,@"「아하핫 네네 나는 곧 갈 거야」","L"
				CALL HPH_PRINT,@"「네, 더요, 핥아봐, 더요 HPH 아, 아, 아, 아...」","L"
				CALL HPH_PRINT,@"「나 가고 있어, 가고 있어, 아, 가고 있어가고 있어, 아, 아아~~~~~~HPH」","L"
			ELSE
				CALL HPH_PRINT,@"「하아, 정말 좋다 HPH %CALLNAME:MASTER%, 아아 HPH」","L"
				CALL HPH_PRINT,@"「곧 갈 것 같아HPH」","L"
				CALL HPH_PRINT,@"「그래서, 하아, 더, 나를 더핥아줘HPH」","L"
			ENDIF
		ELSE
			PRINTFORML 「아, 아, 안 돼, 그만둬, 계속 나를 핥으면! 사정할 거야, 사정할 거라고!」
			PRINTFORML 「아, 안 돼, 사정하고 있어, 사정해, 아, 아, 사정, 사정 중이야!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 시간이 멈춘 채, 당신은 유메미의 %FSYN("vagina")%에 입을 맞댄다.
		PRINTFORMDW 유메미의 음모가 당신의 얼굴을 간지럽히고, 그녀는 연모즙으로 넘치지만 조금도 움직이지 않는다.
		PRINTFORMDW 당신은 시간이 다시 흐르기 시작할 때 그녀의 반응을 기대하며 계속해서 그녀의 질을 핥는다.
		RETURN 1
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「아히이, 아으, 그럴 필요 없어... 그렇게 시끄러울 필요 없잖아...\/\/\/」
				PRINTFORMDW %BREAKENG(@"Seeing the mismatch between her words and the love juice overflowing from Yumemi's %FSYN("질")%, you begin slurping even louder as you keep servicing her.")%
				CALL HPH_PRINT,@"「햐아, 아니, 시끄럽게 하지 말라고 했잖아HPH」","L"
			CASE 1
				PRINTFORMDW 너는 그녀의 연모액을 핥아먹으며 일부러 큰 소리를 낸다.
				PRINTFORML 「푸아아, 아, 기분 좋아, 하지만... 그렇게 시끄럽게 하지 마...\/\/\/」
				PRINTFORML (너무 창피해... 하지만 내 보지가 더 꿈틀거리고 있어...)
			CASE 2
				PRINTFORMDW 너는 유메미의 %FSYN("labia")%을 벌리고 혀로 침범하기 시작한다.
				PRINTFORML 「야아아, 아하! 네가 그렇게 열면...\/\/\/」
				PRINTFORMDW 유메미의 %FSYN("labia")%이 그녀를 계속 봉사하는 동안 너의 혀 주위로 뒤틀린다.
				PRINTFORMDW 리듬을 타며 혀를 되돌리자, 유메미의 몸이 경련하고 떨린다.
				CALL HPH_PRINT,@"「아아아악! 그래, 거기! 안 돼, 아, 너무 많이 문지르지 마아」","L"
			CASE 3
				PRINTFORMDW 당신은 일부러 유메미의 %FSYN("vagina")%를 핥는 것을 피하고, 대신 그녀의 음부에 입을 맞춘다.
				PRINTFORML 「뭐... 왜 거기(그곳)를 핥고 있어...」
				PRINTFORMDW 기대했던 쾌락이 거부된 %FSYN("vagina")% 때문에, 유메미는 참지 못하고 골반을 비틀기 시작한다.
				PRINTFORMDW 한동안 그녀의 음모 맛을 음미한 후, 당신은 탐욕스럽게 그녀의 %FSYN("wet")% %FSYN("vagina")%를 먹어치기 시작한다.
				CALL HPH_PRINT,@"「아?! 아아아아악-흐읍」","L"
			CASEELSE
				PRINTFORML 「아아, 안 돼, 내 음핵을 그렇게 많이 핥을 순 없어...\/\/\/」
				PRINTFORMDW 그녀는 거부했지만, 네가 그녀의 클리토리스를 자극하자 몸을 떨며 사랑의 액체를 쏟아낸다.
				CALL HPH_PRINT,@"「히야아아헵 하지 마, 당기지 마, 열어...! 안쪽이 민감해, 아...」","L"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
