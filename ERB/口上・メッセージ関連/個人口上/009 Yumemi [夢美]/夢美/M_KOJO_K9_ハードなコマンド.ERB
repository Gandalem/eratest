;==================================================
;144,放尿
;==================================================

@M_KOJO_MESSAGE_COM_K9_144
CALL M_KOJO_MESSAGE_COM_K9_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K9_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「히이?! 나-나-나-나-나-나-나-나 너 날 보는 걸 원해... 소변 보는 거?!」
		PRINTFORML 「글쎄, 그런 건 모르겠는데...」
		PRINTFORMDW 하지만 당신이 과장된 실망의 표정을 짓자, 유메미의 의지가 흔들리기 시작한다.
		PRINTFORML 「나-너 그렇게 실망할 필요 없어... 그러니까, 이건 배설물 배출일 뿐이고, 정말 볼 만한 건 아니잖아, 그렇지?」
		PRINTFORMDW "난 꼭 보고 싶어~ 내 인생의 소원이야~ 누군가 나에게 보여주면 얼마나 좋을까~"
		PRINTFORML 「아, 좋아, 알겠어! 볼 수 있게 해줄게! 다만 그렇게 가련한 표정 짓지는 말아줘!」
		PRINTFORML 「너 정말 변태 같아...」
		;洋式トイレかそうでないかでMSG分岐するよ
		; WC(14, 40, 236, 316, 322, 406, 418, 824, 906, 917)
		;洋式そうなところ(40,316,322,406,418,824,906,917)
		IF CFLAG:MASTER == 40 || CFLAG:MASTER == 316 || CFLAG:MASTER == 322 || CFLAG:MASTER == 406 || CFLAG:MASTER == 418 || CFLAG:MASTER == 824 || CFLAG:MASTER == 906 || CFLAG:MASTER == 917
			PRINTFORMDW 유메미는 변기에 앉아 소변을 볼 준비를 한다.
			PRINTFORMDW 당신이 그녀 앞에 서서 유메미를 응시하자, 그녀의 사타구니 이미지가 시야에 각인된다.
		ELSE
			PRINTFORMDW 유메미는 쪼그리고 앉아 소변을 볼 준비를 한다...
			PRINTFORMDW 당신의 시선은 그녀의 사타구니와 살짝 움찔거리는 항문에 고정된다...
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 「나-나 시작할게, 그럼...\/\/\/\/」
		PRINTFORMDW 유메미는 소변을 보기 시작하며 얼굴을 붉힌다.
		PRINTFORML 「응... 아, 나 소변 보고 있는데 %CALLNAME:MASTER%지켜보면서...\/\/\/」
		PRINTFORMDW 그녀의 얼굴은 당황함으로 붉게 물들고, 격렬한 소변줄이 요도를 통해 뿜어져 나온다.
		CALL HPH_PRINT,@"「푸아아...흐읍」","L"
		;トイレなら水に当たってじょぼじょぼ音が出るからね。なに？ぼっとん？そんなものはない（
		;custom code, toilet check
		IF IN_TOILET(CFLAG:MASTER:現在位置)
			PRINTFORMDW 그녀의 소변이 변기 물에 부딪히는 소리가 방 전체에 울려 퍼진다.
			PRINTFORMDW 그녀가 계속해서 소변을 볼수록, 소리는 점차 약해지다가 물방울 떨어지는 소리로 끝난다.
		ELSE
			PRINTFORMDW 그녀의 아래에 소변이 고여 바닥을 때리는 부드러운 소리가 들린다.
		ENDIF
		PRINTFORML 「너무 자세히 보지 마……　\/\/\/」
		PRINTFORMDW 유메미는 부끄러운 목소리로 너에게 애원하지만, 너는 그녀가 소변을 보는 동안 계속해서 뚫어져라 응시한다.
		PRINTFORMDW 자세히 들여다보니 그녀의 음모가 튀는 소변 때문에 조금 축축하다.
		CALL HPH_PRINT,@"「음... 하아... 후우. 됐어... 만족해...?」","L"
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「그럼…… 시작할 거야…… \/\/\/」
		PRINTFORML 「음…… 음……」
		PRINTFORMDW 그녀의 요도에서 힘찬 소변 줄기가 뿜어져 나온다.
		;トイレなら水に当たってじょぼじょぼ音が出るからね
		;custom code, toilet check
		IF IN_TOILET(CFLAG:MASTER:現在位置)
			PRINTFORMDW 그녀의 소변이 변기 물에 부딪히는 소리가 방 전체에 울려 퍼진다.
			PRINTFORMDW 그녀가 계속해서 소변을 볼수록, 소리는 점차 약해지다가 물방울 떨어지는 소리로 끝난다.
		ELSE
			PRINTFORMDW 그녀의 아래에 소변이 고여 바닥을 때리는 부드러운 소리가 들린다.
		ENDIF
		PRINTFORML 「그렇게 가까이서 보지 마……　\/\/\/」
		PRINTFORMDW 유메미는 마침내 소변을 다 보고 뜨거운 숨을 내뱉으며, 몸을 살짝 떤다.
		PRINTFORMDW 자세히 보면, 튄 소변 때문에 음모가 조금 젖어 있는 것이 보인다.
		PRINTFORML 「응…… 후우……　\/\/\/」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「...Nn!!!」
		PRINTFORMDW 그녀의 요도에서 힘찬 소변 줄기가 뿜어져 나온다.
		;トイレなら水に当たってじょぼじょぼ音が出るからね
		;custom code, toilet check
		IF IN_TOILET(CFLAG:MASTER:現在位置)
			PRINTFORMDW 그녀의 소변이 변기 물에 부딪히는 소리가 방 전체에 울려 퍼진다.
			PRINTFORMDW 그녀가 계속해서 소변을 볼수록, 소리는 점차 약해지다가 물방울 떨어지는 소리로 끝난다.
		ELSE
			PRINTFORMDW 그녀의 아래에 소변이 고여 바닥을 때리는 부드러운 소리가 들린다.
		ENDIF
		PRINTFORML 「너무 자세히 보지 마……　\/\/\/」
		PRINTFORMDW 유메미는 비로소 소변을 다 보고 뜨거운 숨을 내뱉으며 몸을 살짝 떤다.
		PRINTFORMDW 자세히 보면, 분수처럼 튀어 나온 소변 때문에 그녀의 음모가 조금 젖어 있는 것이 보인다.
		PRINTFORML 「음…… 후우.」
		RETURN 1
	ENDIF
	;この見せたがりめ！
	IF ABL:露出癖 > 5
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%... 소변 보는 걸 감시당하다니, 이거 중독될지도 모르겠어...HPH」","W"
		PRINTFORMDW 당신이 그녀를 변태라고 부르자, 유메미는 지독하게 희열에 찬 표정으로 몸을 떨며 응답했다.
		CALL HPH_PRINT,@"「아니, 그런 소리 하지 마...흐읍」","W"
	ENDIF
ENDIF
RETURN 1
