@M_KOJO_MESSAGE_COM_K65_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「히우우... 안 돼... 그곳은...」","L"
		IF TCVAR:発情
			PRINTFORMDL 모미지의 골반이 무의식적으로 들썩이고, 당신은 그녀의 은밀한 곳에서 얼굴을 거둔다...
			PRINTFORMW
			PRINTFORMDL 하지만 그녀는 네 머리에 손을 얹고 너를 자신의 축축한 보짓 쪽으로 이끈다.
			CALL HPH_PRINT,@"「너무 좋아... 더 해줘...HPH」","L"
		ELSE
			PRINTFORMDL 모미지의 골반이 저절로 들썩이고, 당신은 그녀의 비밀스러운 곳에서 얼굴을 뗀다.
			PRINTFORMW
			PRINTFORML 「...음, 있잖아... 그곳은, 음-깨끗하지 않아, 그렇게 핥지 마...」
			PRINTFORML 「...에? 아, 아니... 기분 좋지 않아서가 아니라, 하지만... 음～...」
			PRINTFORML 「왠지 정말 창피해, 이상한 소리를 내버릴 것 같아...」
			PRINTFORMW 
			PRINTFORML 「...우웅～...」
			PRINTFORML 「%CALLNAME:MASTER%-씨, 변태 같아. 하고 싶은 대로 해, 그리고...」
			PRINTFORMDL 모미지는 얼굴을 돌려 발그레해진 뺨을 숨기려고 했다.
		ENDIF
		PRINTFORMDW …아무래도 이런 종류의 언어 고문이 그녀의 취향인 모양이다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMDW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		IF TCVAR:発情
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「히운HPH 그렇게 계속 핥으면 바로 갈 거야... 아아안HPH」","L"
					PRINTFORMDL 모미지의 배가 매혹적으로 긴장하며 꿈틀거리고, 그녀의 %FSYN("slit")%에서 시럽 같은 꿀이 넘쳐흐른다.
					CALL HPH_PRINT,@"「「%MOAN("l:m")%HPH %MOAN("l:m",,2)%HPH... 사정할 거야, 사정할 거야, 너무 세게 사정하고 있어 HPHHPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「아아앙흐프 아아~~ㅎ프 나 가고 있어 흐프 오르가즘 해!!ㅎ프」","L"
					PRINTFORMDL 모미지는 등을 아치형으로 만들고 즐거움의 파도 속에서 몸을 맡긴다.
					PRINTFORMDW 그녀는 요염하게 엉덩이를 흔들며 당신의 혀에 자신의 가랑이를 비빈다...
					IF RAND:3 == 0 && !TALENT:ヤリマン
						PRINTFORML
						PRINTFORMDL 평소 진지한 모미지의 이 야생적인 면을 아는 유일한 사람이 너라는 사실이 자랑스럽다...
						PRINTFORMDW 그녀의 욕정에 대한 독점적 지위를 이용해, 너는 모미지를 절정으로 이끈다...
					ENDIF
			ENDSELECT
			;非発情
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「히우... 더는 못 버티겠어... 갈 것 같아...」
					PRINTFORMDL %BREAKENG(@"너는 모미지를 고조되는 성적 감정의 자비 아래 몸을 비틀고 신음하는 광란 속으로 더 몰아넣기 위해 최선을 다한다.")%
					PRINTFORMDW 당신은 번갈아 그녀의 연모를 빨아들이고, 클리토리스를 핥고, 그 주름을 깨물며 내내 역겨운 소리를 낸다...
				CASE 1
					CALL HPH_PRINT,@"「%MOAN("l:m",,2,"dot")%, %TOLOWER(FSYN("lips_muffle"))%HPH」","L"
					PRINTFORMDW 모미지는 이제 신음하고 투정 부리는 것 외에는 아무것도 할 수 없게 되었고, 곧 황홀경의 절정에 이른다...
				CASE 2
					PRINTFORML 「아-안 돼애... %CALLNAME:MASTER%님, 나 갈 것 같아...!」
					PRINTFORML 「더 이상 핥지 말아주세요... 부디...!」
					PRINTFORMDW 당신이 그녀의 민감한 음부를 자연스럽게 괴롭히자, 모미지가 몸을 비틀며 골반을 들썩이고 한계에 다다랐다고 외친다...
					IF ABL:Ｃ感覚 > 5 && RAND:2
						PRINTFORML 
						PRINTFORML 「...아... ...응?」
						PRINTFORMDL %BREAKENG(@"그녀가 시키는 대로, 너는 그녀의 슬릿에서 혀를 빼내자 거품 나는 점액이 네 입과 그녀의 은밀한 곳을 연결하는 흔적을 남긴다.")%
						PRINTFORMDL 중력에 이끌리면서도 여전히 완강하게 매달린 채, 그것은 당신 사이에 점액의 아치를 형성한다.
						PRINTFORMW 「음, %CALLNAME:MASTER%-씨... 우으...」
						PRINTFORML 
						PRINTFORMDL 당신을 위해 주저하며 촉촉한 입술을 적시던 모미지가 마침내 결심한다.
						PRINTFORML 「계속해줘... 내 보지와 클리토스를 핥아줘...」
						PRINTFORMW 「부탁이야... 네 혀로 나를 절정에 이르게 해줘, %CALLNAME:MASTER%-씨...」
						PRINTFORML
						CALL HPH_PRINT,@"「캬우우... 네-네, 바로 거기... 너무 좋아...하프 저는 %CALLNAME:MASTER%-상이 저를 절정에 이르게 할 때가 정말 좋아요 하프 정말 너무너무 좋아요 하프」","L"
						PRINTFORMDW 모미지의 수치심에 일그러진 표정이 황홀경으로 바뀌고, 그녀의 입이 벌어지며 기쁨을 흘린다... 
					ELSE
						PRINTFORML 
						PRINTFORMDW %BREAKENG(@"너는 여우 소녀의 외침에 귀 기울이지 않고, 그녀의 주름에서 끝없이 흘러넘치는 꿀을 그냥 핥아먹는다...")%
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
		;発情中
	ELSEIF TCVAR:発情
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「「%MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH... 더 많이, 계속 핥아줘 HPH」","L"
				PRINTFORMDW 모미지는 자신의 %FSYN("labia/slit")%을 퍼뜨리며 당신이 계속 나아가도록 유혹한다...
			CASE 1
				CALL HPH_PRINT,@"「하아앙흐읍 거기 바로, 더 세게 빨아봐... 끼야아아~흐읍」","L"
				PRINTFORMDW 모미지는 네가 주는 쾌감에 너무 황홀해서 기쁨으로 비명을 지르며 꼬리를 사납게 흔든다...
		ENDSELECT
		;非発情
	ELSE
		IF ABL:Ｃ感覚 >= 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아우우... 더 이상 핥지 마, 그만해...」
					CALL HPH_PRINT,@"「아, 히이ㅍㅎ... 안 빨아도 되는데... 야안~히ㅍ」","L"
					PRINTFORMDW 엄마지 말과는 달리 골반을 들고 떨리는 아랫입술을 당신에게 내밀고 있다...
				CASE 1
					CALL HPH_PRINT,@"「%MOAN(,,2,"dot")%, %TOLOWER(FSYN("lips_muffle"))%―... %MOAN()%HPH... %CALLNAME:MASTER%-상...」","L"
					PRINTFORMDL 당신이 모미지의 윙크하는 질 입구 위로 혀를 가져갈 때마다, 약간 신성 점액이 엄청난 양으로 흘러나온다.
					PRINTFORMW 「너무 부끄러워... 하지만... 정말 기분 좋아...」
				CASE 2
					PRINTFORML 「...음, 이거 좀 민망하네요...」
					PRINTFORML 「평소보다 더 깨끗하게 청소하려고 노력했으니까, 거기부터 나를 핥아주세요, %CALLNAME:MASTER%-씨...」
					CALL HPH_PRINT,@"「나하프 야우~하프 누후프 갑자기 그렇게 세게 하면 이상한 노오... 만들 거거든-이세에에핫아아하프」","L"
					PRINTFORMDW 연모스러운 모미지를 숭배하는 것처럼, 당신은 천천히 그녀의 음핵을 핥고 그녀의 사랑즙을 마셨다.
			ENDSELECT
		ELSE
			PRINTFORML 「음... 응, 너무 이상해...!」
			PRINTFORMDW 모미지는 이러한 종류의 자극에 아직 익숙하지 않아 당신이 그녀를 핥자 유혹적으로 꿈틀거린다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
