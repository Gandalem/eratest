;9,自慰
;道具有無とかまで分岐しようとするとえらいことになりそう
;少なくとも挿入中分岐は欲しいなぁ
;==================================================

@M_KOJO_MESSAGE_COM_K65_9
CALL M_KOJO_MESSAGE_COM_K65_9_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:発情
			CALL HPH_PRINT,@"「흐응... 우리 둘뿐인데, 나 혼자 하는 걸 구경하고 싶어...?」","L"
			CALL HPH_PRINT,@"「너 좀 도착적이네, 그렇지, %CALLNAME:MASTER%-상♪」","L"
			CALL HPH_PRINT,@"「좋아, 나 혼자 기분 좋아지기 시작할 거야... 지금은 아무것도 나쁜 짓 하지 마, 들었지? %CALLNAME:MASTER%-산HPH」","L"
			PRINTFORMDW 입가에 유혹적인 미소를 띤 모미지는 다리를 넓게 벌리고 당신의 눈앞에서 반짝이는 그곳을 과시한다...
		ELSE
			PRINTFORML 「뭐...!?」
			PRINTFORML 「보면서 그런 걸 하다니, 음... 그게 좀...」
			PRINTFORMW 「우으~...」
			PRINTFORML
			PRINTFORML 「...음, 당신이 행복하다면, %CALLNAME:MASTER%-씨, 어쩔 수 없겠네요...」
			CALL HPH_PRINT,@"「%MOAN("l:m")%... 우으, 읏, 너무 부끄러워...」","L"
			PRINTFORMDW 모미지는 눈앞에서 천천히 자신의 허니팟을 일으키며 얼굴을 새빨갛게 물들이고 귀여운 숨을 내쉰다...
		ENDIF
		RETURN 1
	ENDIF
	;自慰中毒高い
	IF ABL:自慰中毒 >= 5 && RAND:3 > 0
		;挿入中
		IF TEQUIP:50 == PLAYER
			IF TCVAR:発情
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%MOAN("l:m",,2,"dot")%… 나에게 박아줄 때 정말 흥분돼요, %CALLNAME:MASTER%-상…」","L"
						CALL HPH_PRINT,@"「나 스스로 만질 거야HPH 흐아안HPH 나를 만져줘, 안아줘, 더, 그리고 더HPH 정말 좋아HPH 음, 그래...HPH」","L"
						CALL HPH_PRINT,@"「흐으우흑, 아아...히 나는 정말 못된 아이야, 미안해애...히」","W"
					CASE 1
						CALL HPH_PRINT,@"「아하하한... %CALLNAME:MASTER%씨, 당신의 거시기는 굉장해... %MOAN("l:m",,3,"dot")%」","L"
						;後背位、背面座位でない
						IF !GROUPMATCH(TEQUIP:体位２,2,5)
							CALL HPH_PRINT,@"「네가 부탁한 대로, 음음히 나는 나의 장난스러운 핥는 것으로 내가 얼마나 못된 소녀인지 보여줄게」","L"
							CALL HPH_PRINT,@"「네 것을 더욱 단단하고 더 단단하게 만들어줘, 그리고 더욱 좋고 더욱 좋게 느껴봐... HPH」","L"
							;後背位、背面座位
						ELSE
							CALL HPH_PRINT,@"「아아~~...흐햣, 격렬하게 범해지면서 자위를 하고 있어...흐햣, 평소의 자위보다 훨씬 기분이 좋아...흐햣」","L"
							CALL HPH_PRINT,@"「이거 너무 강렬해...!HPH %MOAN("m",,2,"dot")%... 자, 이제 이걸 경험했으니 맹세컨대...」","L"
							CALL HPH_PRINT,@"「혼자서 다 하는 건 나를 영원히 만족시킬 수 없을 거야아아-흐읍!흐읍!」","L"
						ENDIF
						PRINTFORMDW 당신이 그녀를 거듭 범할수록, 모미지는 그녀의 비밀 버튼과 유두를 주무르고 꼬집으며 방종한 신음을 내뱉는다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「벌써 섹스 중인데, %MOAN("l",1,2,"dot")%... 나까지 자위하길 원하다니 믿을 수가 없어...」","L"
						PRINTFORMDL 모미지는 치정이 너무 커서 감당하기 힘든 듯 고개를 저었다. 
						PRINTFORMDL 하지만 그녀의 손은 망설이지 않고, 조용히 은밀한 곳을 향해 다가갔다...
						CALL HPH_PRINT,@"「보지 마세요, 제발요, %CALLNAME:MASTER%-상... %MOAN("m",,2,"dot")%... 흐으으앙흐읍」","L"
						PRINTFORMDW 그녀의 수줍은 말과는 대조적으로, 뜨거운 질 주름들이 당신을 향해 간절하게 감기고 물결치며 강렬한 쾌감을 선사한다...
					CASE 1
						;騎乗位
						IF TEQUIP:体位２ == 3
							CALL HPH_PRINT,@"「...우와아앙... %MOAN("l:m",,2,"dot")%...」","L"
							CALL HPH_PRINT,@"(혼자서 %CALLNAME:MASTER%-씨의 거시기를 타고, 동시에 내 가슴과 보지를 만지며...)","L"
							CALL HPH_PRINT,@"(정말 역겹고 창피해야 하는데, 왜 이렇게 황홀한 기분이지...? HPH)","W"
							;それ以外
						ELSE
							CALL HPH_PRINT,@"「%MOAN("l:m")%... 하아아-, 하아아-... 응...?」","L"
							PRINTFORMDL 당신은 잠시 골반 움직임을 멈추고 그녀에게 질문을 던졌다.
							PRINTFORMW 「...에헤... 그런 걸 하는 건 좀 부끄러울 것 같아, 있잖아...」
							PRINTFORML
							CALL HPH_PRINT,@"「후우우우으흐헵 히우우흐헵 나아앙흐헵 해버릴 거야! 좋아, 내가 할게헵」","L"
							CALL HPH_PRINT,@"「혼자 있을 때 혼자 있지만 HPH 참을 수 없어 HPH 계속 당신 생각하고 있어, %CALLNAME:MASTER%-상!HPH」","L"
							CALL HPH_PRINT,@"「정말 좋다... 너무 기분 좋아 HPH 진짜야, %CALLNAME:MASTER%-상의 거 HPH 정말 굉장해 HPH 너무 많이 사랑해...HPH」","W"
						ENDIF
				ENDSELECT
			ENDIF
			;おなかたぷたぷ
		ELSEIF 充填率(65,1) >= 30 && ABL:膣射中毒 > 4 && RAND:2
			IF TCVAR:発情
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「하후, 음... 내 배가 너무 뜨거워... HPH」","L"
						PRINTFORMDL 모미지는 자신의 욱신거리는 슬릿을 손가락으로 위아래로 더듬으며, 가득 찬 보지에서 흘러넘치는 흐린 정액을 가지고 놀았다...
						CALL HPH_PRINT,@"「에헤헤, 당신은 정말 많은 걸 뿌렸네요, %CALLNAME:MASTER%-씨HPH」","L"
						PRINTFORMW 「... \@ !CFLAG:70:無自覚妊娠 && (TALENT:70:育児中 || TALENT:70:妊娠) ? 지난번에 이 걸로 나를 임신시킨 게 이렇게 된 거네 # 정말 그렇게까지 날 임신시키고 싶었어, 응 \@...♪」
					CASE 1
						PRINTFORML 「맹세컨대... 여자에게 네가 그녀에게 뿌린 정액으로 놀아달라고 하다니, 부끄심이 없으신 거야? 이거 정말 도착적이네...」
						PRINTFORMDL 모미지가 당신의 어깨에 팔을 두르고 뒤에서 장난스럽게 꾸짖으며 귀에 속삭인다.
						CALL HPH_PRINT,@"「그러니까... 보지 않는 게 좋을 거야, 알잖아?」","W"
						PRINTFORML
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%-상, 이 못된 %PRINT_MALE("boy", MASTER)%, %MOAN("m",1,2,"dot")%... 너무 많은 정액이 내 보지에 가득해... 음음흐프」","L"
						CALL HPH_PRINT,@"「나 혼자 온몸에 바르고 있어... 내가 이렇게 못된 아이일 때 뒤돌아보며 날 쳐다보면 안 돼 HPH.」","L"
						PRINTFORMDW 당신은 어머니의 흥분이 점차 고조됨에 따라 그녀의 한숨과 신음 소리를 듣는다. 그녀는 이 "변태적인 놀이"를 매우 즐기는 것 같다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%MOAN()%... 정말 굉장한 질척이는 소리를 내고 있어...후후」","L"
						PRINTFORMDW 모미지는 무의식적으로 \@ TEQUIP:バイブ ? 그녀의 손가락을 자신의 보지 안팎으로 넣으며, 사정을 다시 안으로 밀어 넣으려고 노력했다. #  \@
						PRINTFORMDW 보아하니 그녀는 크림을 받는 것에 취한 것 같았다...
					CASE 1
						PRINTFORML 「음, 아아... 전부 끈적해...」
						PRINTFORMDL 네 몸의 체액들이 너의 살덩이에 의해 완전히 뒤섞여 모미지의 손가락들과 엉키며 거품을 일으킨다.
						CALL HPH_PRINT,@"(안쪽이 너무 축축해서 몸이 지금부터 %CALLNAME:MASTER%님과 성관계를 가지려 애쓰고 있어.)","L"
						PRINTFORMDW 모미지는 당신의 최근 장난을 되새기는 듯하고, 손가락으로 자신의 클리토리스를 쓸어내리며 마법에 걸린 듯한 표정으로 눈이 녹는다...
				ENDSELECT
			ENDIF
			;自慰中毒高い
		ELSE
			IF TCVAR:発情
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「나를 하는 걸 보고 싶다고 말하네... 솔직히.」
						PRINTFORML 「음, 알겠어, 그럼 잠시 네 팔 좀 빌릴게, %CALLNAME:MASTER%-씨...」
						PRINTFORMDL 모미지는 자신의 치골을 당신의 팔뚝에 대고 음란하게 골반을 흔들며 "자위"를 위해 당신을 사용하기 시작한다...
						CALL HPH_PRINT,@"「음, 후우... 아하안히이 %CALLNAME:MASTER%-씨, 나의 자위 도구로 쓰이는 기분이 어때?」","W"
						PRINTFORML
						CALL HPH_PRINT,@"「음냐아아... 후프 네 손가락 끝이 방금 안으로 들어갔어...」","L"
						CALL HPH_PRINT,@"「꽉 조이고 움켜쥐는 느낌이 어떤지 느껴져? HPH」","L"
						CALL HPH_PRINT,@"「있잖아, 손가락 대신 거기를 넣으면 훨씬 기분이 좋을 거라고 확신해...HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
						CALL HPH_PRINT,@"「음...흐읍 모든 것이 준비되었고 언제든 넣을 수 있어...」","L"
						PRINTFORMDW 모미지는 외롭고 침 흘리는 갈라진 곳을 과시하며 다리를 활짝 벌리고 계속해서 도발적으로 자위한다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%MOAN("m",,2,"dot")%우리 정말 친해진 뒤로, 나 자위하는 게 더 자주 생겼어, 있잖아...」","L"
						CALL HPH_PRINT,@"「그리고 내가 할 때도, %MOAN("m",1,2,"dot")%...HPH 당신이 나를 만졌던 모든 순간들이 기억나, %CALLNAME:MASTER%-상...」","L"
						PRINTFORMDL 모미지는 당신의 요청을 간절히 들어주며, 관능적인 움직임으로 자신의 가슴을 움켜쥐고 가슴을 만진다.
						PRINTFORMDW 그녀의 골반은 밀려오는 쾌감과 수치심에 무의식적으로 들썩이며, 당신의 시선 앞에 비밀스러운 꿀단지를 내민다...
					CASE 1
						CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
						CALL HPH_PRINT,@"(이래 하는 걸 %CALLNAME:MASTER%-상에게 보인다는 게 너무 부끄럽다...)","L"
						CALL HPH_PRINT,@"(하지만 내 손가락을 멈출 수가 없어... 너무 기분이 좋아...HPH)","W"
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		;挿入中
		IF TEQUIP:50 == PLAYER && RAND:2
			IF TCVAR:発情
				;SELECTCASE RAND:2
				;	CASE 0
				CALL HPH_PRINT,@"「아아안, 으음...흐읍」","L"
				CALL HPH_PRINT,@"「더... 더 많이 찔리고 싶어 HPH」","L"
				PRINTFORMDW 모미지는 당신과 성관계를 하는 쾌락에 완전히 빠져 있고, 황홀한 상태에서 제 가슴을 탐욕스럽게 더 만지고 있다...
				;	CASE 1
				;ENDSELECT
			ELSE
				;SELECTCASE RAND:2
				;	CASE 0
				CALL HPH_PRINT,@"「아, 음... 우으음, 오오오~...흐읍」","L"
				PRINTFORML (하얀 늑대 텐구가 이런 식으로 자위하는 건 너무 외설적이지만... 뭔가 최면 상태에 빠진 것만 같다...)
				CALL HPH_PRINT,@"「%MOAN()%HPH」","W"
				;	CASE 1
				;ENDSELECT
			ENDIF
			RETURN 1
		ELSE
			IF TCVAR:発情
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
						CALL HPH_PRINT,@"「음, 후우... 들려? 이 꾸욱꾸욱 소리들... 흥분되지 않아...? HPH」","L"
						PRINTFORMDW 모미지가 위아래로 열리는 것을 더듬자, 끊임없이 액체들이 흘러나오고 그녀의 귀는 행복하게 움찔거렸다...
					CASE 1
						CALL HPH_PRINT,@"「와아아아, 아앙, 아아~흐으흣」","L"
						IF TEQUIP:50 == PLAYER
							CALL HPH_PRINT,@"「지금... 지금 넣어도 돼, 우으... 아아아흐읍」","L"
						ELSE
							PRINTFORML 「봐, 봐, 아아... 아아한... 그냥 보는 걸로 정말 괜찮은 거야, 음흠...?」
						ENDIF
						CALL HPH_PRINT,@"「이 열기 때문에 내 보지가 완전히 흥건해지고 유두가 너무 단단하게 솟아올라 HPH.」","L"
						CALL HPH_PRINT,@"「나와 함께라면 모든 것, 무엇이든 할 수 있어... 네가 원하는 건 다 괜찮아... HPH」","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORM 「부-부디 그렇게 자세히 보지 말아줘... 부끄러워...」
						IF ABL:自慰中毒 > 2
							PRINTFORML
							PRINTFORMD 몸은 불안하게 떨리고 있지만, 모미지는 스스로를 만지는 것을 멈추지 않고 은밀한 부위를 더듬는 것에서 즐거움을 느끼는 듯하다...
						ENDIF
						PRINTFORMW
					CASE 1
						PRINTFORML 「음... 우리 함께 있는데, 어떻게 나한테 자위하라고 할 수 있어... 기분이 좋지 않아...」
						PRINTFORMD 그럼에도 불구하고 모미지는 그녀의 장난스러운 분비물을 떠서 손가락으로 자신의 유두에 모두 문지르며 스스로 만족하기 위해 최선을 다했다.
						IF ABL:膣射中毒 > 4 || ABL:肛射中毒 > 4
							PRINTFORML
							SIF BASE:MASTER:勃起 > 999
								PRINTFORML (%CALLNAME:MASTER%-씨도 그렇게 흥분했고, %HIS_HER(MASTER)% 것이 너무 커졌다...)
							CALL HPH_PRINT,@"(서둘러! 네 것이 너무 간절해...)"
						ENDIF
						PRINTFORMW
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
