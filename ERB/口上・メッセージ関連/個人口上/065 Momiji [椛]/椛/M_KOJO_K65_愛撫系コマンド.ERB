@M_KOJO_MESSAGE_COM_K65_11_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
		;発情
	ELSEIF TCVAR:発情
		;Ｖ挿入中　他の分岐よりちょっと優先
		IF TEQUIP:50 == PLAYER && RAND:3 > 0
			SELECTCASE RAND:3
