					ENDIF
				CASE 1
					PRINTFORML 「와아앙... 음, 크윽....~~!」
					PRINTFORMDL 당신이 그녀의 곧게 선 유두를 손가락으로 문지르자 모미지는 목을 조르는 듯한 신음을 내며 골반을 흔든다.
					PRINTFORML 「안-안 돼, 내 유두, 그만해... 히유우, 우아, 아응...!」
					PRINTFORMDW %BREAKENG(@"당신은 가슴을 괴롭히는 고문에서 여우 소녀가 도망치는 것을 막으려는 듯, 그녀의 타이트한 질 안에서 펌핑과 허리치기를 더욱 거세했다.")%
			ENDSELECT
		ENDIF
		RETURN 1
		;通常
	ELSE
		IF TCVAR:発情
			IF TALENT:恋慕 && RAND:2
				SELECTCASE RAND:2
					;セルフ乳首舐めってえっちいですよね。
					CASE 0
						PRINTFORMDL 모미지는 평소보다 더 민감해 보이는 그녀의 유두를 빨자 행복하게 미소지었다.
						CALL HPH_PRINT,@"「안에 입술 빠는 느낌 너무 좋아...HPH」","L"
						CALL HPH_PRINT,@"「음, 후우, 크, 아하아... 이거도...」","L"
						IF TALENT:バストサイズ > 0 && RAND:2
							PRINTFORMDL 모미지는 비어있는 가슴을 들어 스스로 유두 위를 혀로 훑기 시작하는데, 눈에는 음란한 표정이 서 있었다...
							CALL HPH_PRINT,@"「후우, 음...흐읍 추우, %TOLOWER(RANDKISS("kiss"))%, 핥아핥, %TOLOWER(RANDKISS("suck"))%...흐읍 음, 후우―흐읍」","W"
						ELSE
							PRINTFORMDL 모미지는 비어있는 가슴을 더듬으며 음란한 눈빛으로 자신의 유두를 만지기 시작한다...
							CALL HPH_PRINT,@"「음, 후후...흐읍 하아, 음ㅁ, 아하... 흠, 아, 히아우...흐읍」","W"
						ENDIF
						;ぱふぱふはカウンターにしかないのか！
					CASE 1
						CALL HPH_PRINT,@"「...HPH」","L"
						PRINTFORMDL 모미지는 당신의 머리를 가슴에 안고 부드러운 가슴을 얼굴에 밀어붙이기 위해 등을 아치형으로 만든다.
						PRINTFORMDL 늑대 소녀의 복숭아 같은 살결이 당신의 얼굴에 달라붙어 주위를 짓누르고, 달콤한 향기가 이성을 침범한다...
						CALL HPH_PRINT,@"「아아...후프 %CALLNAME:MASTER%님...후프」","L"
						PRINTFORMDL 그녀의 심장 박동과 당신의 심장이 귀에서 울리고, 발정 난 암컷의 향기에 맞춰 두 마음이 하나로 더 빠르게 고동친다...
						PRINTFORMDW 모미지는 열정 속에서 가슴을 당신에게 비비며 쾌감에 소리를 지른다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「와아, 아, 끼야우운~흐읍」","L"
						CALL HPH_PRINT,@"「오오, 내 가슴이 너무 기분 좋아...후훗」","W"
					CASE 1
						CALL HPH_PRINT,@"「음음... 더, 날 더 떨게 해줘...흐읍」","L"
						PRINTFORMDW 모미지가 당신이 그녀의 가슴을 만지자 욕망에 찬 한숨을 내쉰다...
					CASE 2
						CALL HPH_PRINT,@"「아아... 좀 더 부드럽게... 후아우~ HPH %CALLNAME:MASTER%-씨, 잘한다...HPH」","W"
				ENDSELECT
			ENDIF
		ELSE
			IF TALENT:恋慕 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「후우, 음... %CALLNAME:MASTER%-상...」
