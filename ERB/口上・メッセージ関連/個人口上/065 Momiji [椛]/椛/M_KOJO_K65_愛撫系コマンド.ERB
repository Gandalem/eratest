					CASE 1
						CALL HPH_PRINT,@"「와아, 음... %RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%, %TOLOWER(FSYN("lips_muffle"))%후훗」","L"
						PRINTFORMDL 당신은 허리를 숙여 어머니가 자신을 향해 돌리는 얼굴에 맞춰 몸을 낮춘다...
						PRINTFORMDL 두 사람은 그녀의 조이는 질을 자극하며 서로 키스한다...
						CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH %RANDKISS("kiss")%HPH... %MOAN(,,2)%HPH %FSYN("lips_muffle")%ー」","L"
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
		;通常
	ELSE
		IF TCVAR:発情
			IF TALENT:恋慕 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%HPH」","L"
						PRINTFORMDL 모미지는 양손으로 당신의 뺨을 잡고 온 힘을 다해 입안에서 혀를 돌린다...
						CALL HPH_PRINT,@"「누무, 후우-... %CALLNAME:MASTER%-상... HPH %MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %RANDKISS("kiss")%HPH」","W"
						PRINTFORMDL 네가 벗어나려 해도, 갇힌 뺨에 느껴지는 꾸르륵한 압력이 움직임을 제어한다.
						PRINTFORMDL 이것은 더 이상 키스라기보다는 포식에 가깝다.
						CALL HPH_PRINT,@"「...%RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%... 음프흐프... %MOAN("l:m")%ㅎㅍ %RANDKISS("kiss")%～」","W"
					CASE 1
						CALL HPH_PRINT,@"「「%RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%... 후우ー흐읍... %FSYN("lips_muffle")%흡 %RANDKISS("kiss")%흡」","L"
						PRINTFORMDL 모미지는 당신의 입안에 뜨거운 한숨을 내쉬며 당신의 침을 갈망한다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%HPH」", "W"
					CASE 1
						CALL HPH_PRINT,@"「음, 츄우... %MOAN()%, %TOLOWER(FSYN("lips_muffle"))%후후... %RANDKISS("kiss")%...%RANDKISS("kiss")%후후」","L"
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%-상, 더...HPH %MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %FSYN("lips_muffle")%...HPH %RANDKISS("kiss")%!」","W"
				ENDSELECT
			ENDIF
		ELSE
			IF TALENT:恋慕 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %MOAN("l:m")%...HPH」", "L"
						PRINTFORML 「음... 저를 너무 많이 보지 말아 주세요...」
						PRINTFORMW 「지금 정말 지저분해 보이겠죠...」
					CASE 1
						CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%HPH」", "L"
						PRINTFORML 「후후. 우린 이미 키스한 적이 있어 \@ EXP:キス経験>20 ? 반복해서 # 몇 번이나 \@ 하지만 나는 항상 설레...」
						CALL HPH_PRINT,@"「...지금이야. 한 번만 더... 음, %TOLOWER(FSYN("lips_muffle"))%HPH... %RANDKISS("kiss")%!」","L"
						PRINTFORMDW 당신과 모미지가 서로 껴안고 천천히 입을 맞추며 서로의 심장 박동을 느낀다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%HPH」", "W"
					CASE 1
						CALL HPH_PRINT,@"「%RANDKISS("kiss")%, %MOAN(,1)%, %TOLOWER(FSYN("lips_muffle"))%후우... 음...」", "L"
						PRINTFORMDW %BREAKENG(@"네가 입술로 그녀에게 키스하는 동안 손가락으로 그녀의 머리를 쓰다듬자, 모미지는 \@ TALENT:恋慕 && RAND:2 ? 갈망 어린 눈으로 너를 응시한다 # 행복하게 미소 짓는다 \@.")%
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
