			;人目がある時は現状Ｃ,Ａ,Ｖのどこで絶頂しても同じ口上になっちゃってます。正直手抜きです。
			;加筆・改変してくださるととても嬉しいです。
			IF LOCAL:1 > 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「~~~~므프! 음, 무픔...흐헵」","L"
						PRINTFORMDL 모미지는 관심을 끌까 두려워 재빨리 입을 막았다.
						PRINTFORMDW 하지만 즐거움이 너무 강해서 참지 못하고 비명을 질렀다...
					CASE 1
						PRINTFORML 「아!! 쿠, 으응~~!!」
						PRINTFORMDW 당신은 격렬한 오르가슴으로 거의 쓰러지는 모미지를 안고 있다.
						PRINTFORML
						PRINTFORML 「하아, 하아—. 우으. 누군가 그걸 눈치챘을 거라고 확신해...」
						PRINTFORMDW 모미지의 어깨가 떨리고 그녀는 당황해서 몸을 꿈틀거린다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「스토, -프... 이거 너무 강해, 음, 후아아악!HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「~~~~ㅁㄴㅎㅍ 후, 아아안~...ㅎㅍ」","L"
						PRINTFORMDW 그 쾌감은 너무 강렬해서 모미지를 얼어붙게 하고, 그녀의 온몸이 떨린다...
				ENDSELECT
			ENDIF
			;絶頂Ｃ
		ELSE
			;人目がある
			IF LOCAL:1 > 0
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「～～～Mn!」
						PRINTFORMDW 보이기 싫어 걱정하는 모미지는 오르가슴을 느끼며 목소리를 참았다.
					CASE 1
						PRINTFORML 「크으, 우우, 음음~...!」
						PRINTFORMDW %BREAKENG(@"잠재적인 구경꾼들이 있다는 사실을 고통스럽게 느끼며, 모미지는 입술을 깨물고 절정을 견디려 애한다...")%
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「아, 정액, 사정... 음음음~~」
					CASE 1
						PRINTFORMW 「히아~ 히아안...~~~~」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;MASTERと同時絶頂時の分岐は作りたい気もします。
		;発情
		IF TCVAR:発情
			;イキすぎ
			;IF EX:Ｖ絶頂 > 15 && BASE:体力 < MAXBASE:体力/2 && BASE:気力 <= 0 && CFLAG:うふふ == 1
			;ELSEIF NOWEX:Ｖ絶頂 >= 2
			;強絶頂Ｖ
			IF NOWEX:Ｖ絶頂 >= 2
				;恋慕
				IF TALENT:恋慕 && RAND:3 == 0
					CALL HPH_PRINT,@"「후우~ 하아, 하아하헵 %CALLNAME:MASTER%-사, 음음ㅁ~혓격」","L"
					CALL HPH_PRINT,@"「사랑해요! 연모, 연모, 오오오오브~HPH」","W"
					RETURN 1
				ENDIF
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「하아-아헵 음~헵 %CALLNAME:MASTER%씨, 아헵 사정하는 중이야...헵」","L"
						PRINTFORMD 엄마지(Momiji)의 질 주름은 발정기에 도달하여 절정에 이르면서 움켜쥐고 조인다. 
						;おちんちん
						IF TEQUIP:Ｖ接触部位 == 1
							PRINTFORMDW 네 거에서 정액을 짜내려고 애쓰고 있어...
							;ゆび
						ELSEIF TEQUIP:Ｖ接触部位 == 3
							PRINTFORMDW 손가락 끝을 꽉 쥐면서...
							;バイブ？
						ELSE
							PRINTFORMDW 황홀하고 꿈틀거리는 섹스 토이에 몰두하며 자신들을 혹사시킨다...
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「아아아흐흑 내 보지... 내 보지가 절정에 달할 거야~ 흐으윽 오르기 시작해~ 아아흐흑 하안~ 흐으윽」","L"
						PRINTFORMDW 모미지의 눈이 황홀경으로 떨리고 그녀의 몸은 그것을 통해 꿈틀거리며 뒤틀린다.
				ENDSELECT
				;絶頂Ｖ
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아아악 흐으으 흐흐흑 나 갈 것 같아!! 하앙 하아앙」","W"
					CASE 1
						CALL HPH_PRINT,@"「하아, %CALLNAME:MASTER%-상, 너무 좋다아아흐으헵 사정했다아아헵 사정한다!!헵」","W"
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
		;Ｖ絶頂　非発情
		;イキすぎ
		;IF EX:Ｖ絶頂 > 15 && BASE:体力 < MAXBASE:体力/2 && BASE:気力 <= 0 && CFLAG:うふふ == 1
		;ELSEIF NOWEX:Ｖ絶頂 >= 2
		;強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 >= 2
			;人目がある
			IF LOCAL:1 > 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「~~~~! 흥...큭」","L"
						PRINTFORMDL 모미지는 공공장소에 있는 것을 신경 쓰기 때문에 입을 다물고 있다.
						PRINTFORMDW 하지만 쾌락이 너무 커서 그녀는 무너지고 신음을 내뱉는다...
					CASE 1
						PRINTFORML 「...!! 쿠우~~!!」
						PRINTFORMDW 모미지는 절정에 다다르며 오르가슴을 느낄 때 당신을 붙잡는다.
						PRINTFORML 「하아, 하아... 이번에는 누군가가 알아챘음에 틀림없어...」
						PRINTFORMDW 모미지의 어깨가 떨리고, 그녀는 당황하여 몸을 비튼다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「흐아아!! 아아... 아아~~~~~!!」
						CALL HPH_PRINT,@"「하아...흐읍」","L"
						PRINTFORMDW 모미지의 온몸이 떨리고, 그녀의 눈은 쾌락으로 녹아내린다...
					CASE 1
						CALL HPH_PRINT,@"「야- 아, %CALLNAME:MASTER%씨, %CALLNAME:MASTER%씨... 아아~~흐으흣」","W"
				ENDSELECT
			ENDIF
			;絶頂Ｖ
		ELSE
			;人目がある
			IF LOCAL:1 > 0
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「～～～!」
						PRINTFORMDW 들키는 것이 걱정되어 모미지는 절정에 다다르며 신음을 참는다.
					CASE 1
						PRINTFORMDW 주변 사람들의 시선을 느끼며 모미지는 입술을 깨물고 오르가슴을 견딘다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「하아...! 나- 아! 나 사정해!」
					CASE 1
						PRINTFORMW 「아, 정액이… 흘러나온다…~~~~!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;発情
		;記入時はコメントアウトを外してください。
		;IF TCVAR:発情
		;	;強絶頂Ａ
		;	IF NOWEX:Ａ絶頂 >= 2
		;		PRINTFORMDW
		;	;絶頂Ａ
		;	ELSE
		;		PRINTFORMDW
		;	ENDIF
		;RETURN 1
		;ENDIF
		;強絶頂Ａ
		IF NOWEX:Ａ絶頂 >= 2
			;人目がある
			IF LOCAL:1 > 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「~~~~므프! 음, 무픔...흐헵」","L"
						PRINTFORMDL 모미지는 관심을 끌까 두려워 재빨리 입을 막았다.
						PRINTFORMDW 하지만 즐거움이 너무 강해서 참지 못하고 비명을 질렀다...
					CASE 1
						PRINTFORML 「아!! 쿠, 우우~~!!」
						PRINTFORMDW 강렬한 오르가슴으로 거의 쓰러질 듯한 모미지를 안고 있다.
						PRINTFORML
						PRINTFORML 「하아, 하아—. 우우. 누가 그걸 알아챘을 거라고 확신해...」
						PRINTFORMDW 모미지의 어깨가 떨리고 그녀는 당황하며 몸을 비튼다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%MOAN("l:m")%흐읍, 우우웅~~!!」","L"
						PRINTFORMDL 그녀의 더러운 구멍이 미친 듯이 움찔거리며, 얼마나 철저하게 성감대로 발달했는지를 보여준다.
						PRINTFORMDW 그토록 강렬한 쾌락 앞에서 통제력을 유지할 수 없게 되자, 모미지는 참을 수 없이 믿기 힘들 정도로 저속한 신음을 내뱉는다...
