	LOCAL:1 = 0
	IF !CFLAG:うふふ
		FOR LOCAL,1,CHARANUM
		SIF LOCAL != 65 && CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
			LOCAL:1 ++
		SIF (CAN_MOVE(CFLAG:MASTER:現在位置, CFLAG:LOCAL:現在位置) & 2) && !FLAG:70 == 1
			LOCAL:1 ++
		NEXT
		SIF DATE_HITOGOMI()
			LOCAL:1 ++
	ENDIF
	;周りにバレないように声を押し殺してイクってシチュエーション、萌えません？
	IF NOWEX:Ｃ絶頂
		;クンニ、素股絶頂時の分岐は作りたい気もします。
		;記入時はコメントアウトを外してください。
		;IF TCVAR:発情
		;	;強絶頂Ｃ
		;	IF NOWEX:Ｃ絶頂 >= 2
		;		PRINTFORMDW
		;	;絶頂Ｃ
		;	ELSE
		;		PRINTFORMDW
		;	ENDIF
		;RETURN 1
		;ENDIF
		;非発情
