@M_KOJO_MESSAGE_PALAMCNG_B_K65
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMDW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMDW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMDW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:四重絶頂 && LOCAL:1
		SELECTCASE NOWEX:四重絶頂
			;Ｃ＆Ｖ＆Ａ＆Ｂ絶頂
			CASE 1
				PRINTFORMDW 
				RETURN 1
				;Ｍ絶頂あり
			CASEELSE
				;おしゃぶり中
				IF TEQUIP:65:口接触部位 == 1
					PRINTFORMDW 
				ELSE
					PRINTFORMDW 
				ENDIF
				RETURN 1
		ENDSELECT
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂 && LOCAL:1
		;Ｍ絶頂あり
		IF NOWEX:Ｍ絶頂
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「무프음...흐프 푸아! 하아, 아아아아~~ㅎ프」","L"
					PRINTFORMDW 격렬한 절정에 참지 못하고, 모미지는 입술이 벌어지며 쾌감의 외침을 내뱉는다...
				CASE 1
					CALL HPH_PRINT,@"「무구... 음, 으음!? 므ㅁㅁ마아아ㅏㅎㅍㅎ」","L"
					LOCALS = 모미지의 머리를 잡고 그녀가 강렬한 쾌감에 움츠러드는 동안 당신은
					;キス中
					IF EXP_UP(27,TARGET)
						PRINTFORMDW %BREAKENG(@"%LOCALS%입술을 더 세게 다물어 봐...")%
					ELSE
						PRINTFORMDW %BREAKENG(@"%LOCALS%그녀의 목구멍 안쪽으로 네 거시기를 밀어 넣어라...")%
					ENDIF
			ENDSELECT
			RETURN 1
			;Ｖ or Ａセックス中
		ELSEIF TEQUIP:Ｖセックス == PLAYER || TEQUIP:Ａセックス == PLAYER
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아니, 제발요! 그걸 그 안에서... 하면 안 돼요...」
					CALL HPH_PRINT,@"「응~~흐으흣 히아아, 으윽, 아, 아아하아아악...!!」","L"
					PRINTFORMDL %BREAKENG(@"모미지의 몸이 격렬한 절정에 맞춰 나무처럼 굳었다가, 이윽고 가라앉으면서 축 늘어졌다.")%
					PRINTFORMW 「하아... 너무 굉장했어, 민... 돌아오지 못할 줄 알았는데...」
				CASE 1
					CALL HPH_PRINT,@"「이거, 너무... 너무 많아~...」","L"
					CALL HPH_PRINT,@"「하아, 미쳐버릴 것 같아, 갈 것 같아~!! 아... 아, 아아아아아아아~~~~흐읍」","W"
			ENDSELECT
			RETURN 1
		ELSE
			CALL HPH_PRINT,@"「히우~... 아뇨, 한 번에 다는 안 돼요, 안ㅎㅍ」","L"
			CALL HPH_PRINT,@"「안 돼~ HPH 나 갈 것 같아, 가고 있어... 가고 있어~~ HPH」","W"
			RETURN 1
		ENDIF
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂 && LOCAL:1
		;Ｍ絶頂あり
		IF NOWEX:Ｍ絶頂
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「음...흐으... 음~~~~...흐으」","L"
					PRINTFORMDW 격렬한 클라이맥스를 견디려 모미지는 당신의 \@ EXP_UP(27,TARGET) ? 머리 # 허리를 꽉 붙잡는다 \@...
				CASE 1
					CALL HPH_PRINT,@"「무구... 음, 므음~~~흐읍」","L"
					PRINTFORMD 엄마지(Momiji)가 격렬한 쾌감에 몸부림치는 동안 그녀의 머리를 잡고 당신은 
					;キス中
					IF EXP_UP(27,TARGET)
						PRINTFORMDW 입술을 더 꽉 다물어 봐...
					ELSE
						PRINTFORMDW 그녀 목구멍 쪽으로 네 거시기(dick)를 밀어 넣어라...
					ENDIF
			ENDSELECT
			RETURN 1
			;Ｖ or Ａセックス中
		ELSEIF TEQUIP:Ｖセックス == PLAYER || TEQUIP:Ａセックス == PLAYER
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아니, 제발요! 그걸 그 안에서... 하면 안 돼요...」
					CALL HPH_PRINT,@"「아니, 그만해... 아, 사정할 것 같아~~흐으큭」","W"
				CASE 1
					CALL HPH_PRINT,@"「이건, 아아... 하윽, 못 견디겠어... 하윽」","L"
					CALL HPH_PRINT,@"「하아아, 오르네, 오르네 쇼 하아앗...~~~~~큭」","W"
			ENDSELECT
			RETURN 1
		ELSE
			CALL HPH_PRINT,@"「히우... 이건 공평하지 않아, 아니야, 안ㅎㅍ」","L"
			CALL HPH_PRINT,@"「노~ HPH 나 갈 것 같아, 가고 있어... 가아아아아~~ HPH」","W"
			RETURN 1
		ENDIF
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
