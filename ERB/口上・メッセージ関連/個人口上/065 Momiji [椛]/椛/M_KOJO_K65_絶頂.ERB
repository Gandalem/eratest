@M_KOJO_MESSAGE_PALAMCNG_A_K65_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMDL
	;MASTERの射精回数を加算
	SIF !CFLAG:睡眠 && !FLAG:70
		TCVAR:350 += NOWEX:MASTER:射精
	;イキすぎ
	IF EX:Ｖ絶頂 > 15 && BASE:体力 < MAXBASE:体力/2 && BASE:気力 <= 0 && CFLAG:うふふ == 1
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아...! 우우, 아아...! 나가는 게... 하프」","L"
				PRINTFORMDW 격렬한 사랑을 나눈 후, 당신과 모미지 모두 동시에 절정에 도달한다.
				PRINTFORML
				PRINTFORMDL 네 물건은 여자를 타락시키는 기쁨으로 떨리며 그녀 깊숙한 곳에 정액을 흘리기 시작한다.
				PRINTFORMDW 그것은 계속해서 질척거리는 아기 반죽을 울프걸에게 주입하며 그녀의 자궁을 하얗게 물들인다...
				PRINTFORML
				SIF ABL:65:膣射中毒 > 3
					PRINTFORML (%CALLNAME:MASTER%-씨의 온기가 내 배 깊숙이 천천히 퍼지는 게 느껴져... 어쩐지 기분이 좋아져...)
				PRINTFORMW (당신 없이는 살 수 없어, %CALLNAME:MASTER%-상...)
			CASE 1
				PRINTFORML 「쿠우, 아아아악...!!」
				PRINTFORMDL 모미지가 절정으로 등을 휘자, 미끄러운 질 벽이 당신의 성기 주위를 리듬에 맞춰 꿈틀거린다.
				PRINTFORMDW %BREAKENG(@"그녀의 황홀한 보지 마사지에 굴복하며, 너는 네 귀두를 그녀의 자궁 입구로 밀어 넣고 첫 사정을 직접 안쪽에 뿌린다.")%
				PRINTFORML
				PRINTFORML 「아아~~!! ...뜨거워~...! 히이, 아쿠우, 하아안~!!」
				PRINTFORMDL 네가 절정에 달하는 와중에도 계속 골반을 앞으로 밀어 넣으며 모미지의 보지 구석구석과 틈새마다 정액을 퍼뜨린다.
				CALL HPH_PRINT,@"「아우오오오... 들뜨고 있어... 히유우, 우아아, 안~...호프」","W"
			CASE 2
				CALL HPH_PRINT,@"「히아아아아앗...! 너무 뜨거워...흐읍」","L"
				PRINTFORMDW 반복된 절정에도 불구하고, 당신은 가차 없이 더 뜨겁고 끈적한 점액을 모미지의 자궁에 쏟아붓는다.
				PRINTFORML
				CALL HPH_PRINT,@"「하아, 하아, 하아—후우」","L"
				PRINTFORMD 모미지는 숨이 차지만 배를 쓰다듬으며 행복해 보인다.
				SIF EQUIP:上半身上着１ || EQUIP:上半身上着２
					PRINTFORMD  그녀의 옷을 통해 
				PRINTFORMDW , \@ ABL:65:膣射中毒 > 3 ? 초점이 풀린 눈으로... # 만족스럽게 한숨을 쉬며... \@
		ENDSELECT
	ELSEIF TALENT:恋慕
		;恋慕かつ発情
		IF TCVAR:発情
			;何度も射精
			IF TCVAR:350 > 3 && RAND:2 == 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「～～～～～MmHPH」","L"
						CALL HPH_PRINT,@"「더~... HPH 제발, 더 싸줘~... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「또 왔네~...HPH」","L"
						PRINTFORM 전부 내 배에 부어 넣어줘, 전부 내 배에 부어 넣어줘
						SIF !TCVAR:ピル && !TALENT:妊娠
							PRINTFORM  그리고 나를 임신시켜라
						CALL HPH_PRINT,@"～～...HPH」","W"
				ENDSELECT
				;キスもしてる
			ELSEIF CUP:TARGET:快Ｍ > 0 && RAND:2 == 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%TEXTR("Cummiiii～ing/Haah, hiii～/")%...HPH %CALLNAME:MASTER%씨...!」","L"
						PRINTFORMDL %BREAKENG(@"절정에 달했을 때, 모미지는 네가 물어뜯을 것만 같을 정도로 세게 키스하고, 그녀의 혀는 미친 듯이 네 입술 주위를 핥는다.")%
						CALL HPH_PRINT,@"「%TEXTR("Smooch/Nmuu/")%... %MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %MOAN("l:m")%... 푸, 으음~HPH」","L"
						PRINTFORMDW 모미지는 당신의 구름처럼 맥동하는 흐름이 그녀에게 부어지는 것을 눈으로 따라가며 계속해서 열정적으로 당신에게 입맞춤한다.
					CASE 1
						CALL HPH_PRINT,@"「아-아아아흐, 아, 아아아아흐~~~~~흐프ㅎㅍ」","L"
						PRINTFORMDL %BREAKENG(@"네가 주는 뜨겁고 끈적한 정액을 받자, 그 자극이 모미지를 한계로 몰아세우고 그녀는 몸을 움츠리며 경련한다...")%
						PRINTFORMW
						SIF ABL:膣射中毒 > 3
							CALL HPH_PRINT,@"「와, 아아...HPH %CALLNAME:MASTER%-님은 내 배를 채우고 있어... 정말 행복해...HPH」","L"
						PRINTFORML 「음... %FSYN("lips_muffle")%, %TOLOWER(RANDKISS("kiss"))%... %RANDKISS("kiss")%, 크으～...」
						;custom code
						PRINTFORMDW %BREAKENG(@"거의 광적인 표정으로, 모미지는 \@ !POSE_BEHIND(TEQUIP:体位２) ? 네 머리를 끌어안거나 # 너를 탐욕스럽게 바라보며 \@ 키스를 애원한다...")%
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아하아... HPH %CALLNAME:MASTER%-상의 정액이 따뜻해... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「음... 후후, 내 배에서 그것이 분출되는 걸 느낄 수 있어...」","L"
						CALL HPH_PRINT,@"「에헤헤, 기분 좋게 해줬어? %CALLNAME:MASTER%-씨...HPH」","W"
				ENDSELECT
			ENDIF
			;恋慕かつ非発情
		ELSE
			;何度も射精
			IF TCVAR:350 > 3 && RAND:2 == 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「～～～～～MmHPH」","L"
						CALL HPH_PRINT,@"「놀랍다, 그건... 아직도 너무 많아... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「또 온다, 또...」","L"
						PRINTFORMW 「이건... 정말 커질 거야...」
				ENDSELECT
				;キスもしてる
			ELSEIF CUP:TARGET:快Ｍ > 0 && RAND:2 == 0
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%TEXTR("Smooch/Nmu/")%... 음, 음음~흐읍」","L"
						PRINTFORMDL 당신은 모미지(Momiji)의 작은 몸을 끌어안고 그녀의 체리색 입술에 달라붙는다.
						PRINTFORMDL 골반의 움직임이 갑자기 멈추고, 마지막 순간이 찾아온다.
						CALL HPH_PRINT,@"「음, 후우... %MOAN("l:m")%큭 %MOAN("l:m",,2)%큭... 푸하...큭」","L"
						PRINTFORMDW %BREAKENG(@"그녀의 안쪽에 아기 반죽을 후하게 부은 후 입술을 뒤로 당길 때, 너의 입술이 잠시 은색 실로 연결된다...")%
					CASE 1
						CALL HPH_PRINT,@"「흐으윽...! %MOAN("m:h",,2)%큭」","L"
						PRINTFORML (키스로 뒤덮인 채로, 내 배는 가득 넘치도록 채워졌다...)
						CALL HPH_PRINT,@"(맹세컨대, 지금 내가 생각할 수 있는 유일한 것은 %CALLNAME:MASTER%-상뿐이다)","L"
						PRINTFORMDW 모미지, 사랑하는 이의 포옹 속에 안긴 채 황홀한 표정으로 당신의 정액을 그녀의 보지에 받아들인다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「후우... 안이 정말 따뜻해...」
					CASE 1
						PRINTFORMW 「하아... 아... %CALLNAME:MASTER%-상, 당신을 연모합니다...」
				ENDSELECT
			ENDIF
		ENDIF
	ELSE
		PRINTFORMW 「아, 안쪽으로…」
	ENDIF
	RETURN 1
	;IF 充填率
ENDIF
RETURN 1
