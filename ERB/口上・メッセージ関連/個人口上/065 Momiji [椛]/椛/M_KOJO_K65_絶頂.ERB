					IF ABL:膣射中毒 > 3 && RAND:2
						CALL HPH_PRINT,@"「후후, 계속할 수 있어...? 다음엔 여기에서 해봐 HPH 오카아이 HPH」","L"
						PRINTFORMDW 모미지는 음탕하게 미소 지으며 손가락 끝의 마지막 흰 점액을 자신의 대음순에 문지른다...
					ELSE
						CALL HPH_PRINT,@"「흥, 다음엔 내 입에 똑바로 넣어줘~ HPH」","L"
						PRINTFORMDW 모미지는 음란하게 미소 지으며 부드럽게 당신의 고환을 쓰다듬는다...
					ENDIF
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아하, 엄청나게 '삐용삐용'거리네, 굉장해... HPH」","L"
					CALL HPH_PRINT,@"「네가 전부 나올 때까지 계속 짜 줄 거야... HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「아우우, 너무 뜨거워...헉헉」","L"
					CALL HPH_PRINT,@"「음...하아, 너무 음란한 냄새가 나네...」","L"
					CALL HPH_PRINT,@"「머리가 어지럽고 심장이 너무 세게 뛰어서...하아」","W"
				CASE 2
					CALL HPH_PRINT,@"「와, 너무 끈적해...흡」","L"
					PRINTFORMDL 모미지는 당신의 정액을 손가락 전체에 묻히고 그 흔적을 가지고 놀았다...
					CALL HPH_PRINT,@"「냄새가 너무 좋다... 이걸 내 안에 넣으면 무슨 일이 일어날지 궁금하네... HPH」","W"
			ENDSELECT
		ENDIF
		;非発情
	ELSE
		IF ABL:精液中毒 >= 3 && RAND:2
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「우으, 너무 뜨거워... 음, %TOLOWER(RANDKISS("suck"))%, 츄우... 하아...흐읍」","L"
					PRINTFORMDW 숨을 헐떡이며, 늑대 소녀는 손에 묻은 걸쭉한 점액을 핥는다...
					PRINTFORML
					CALL HPH_PRINT,@"「음... 이제 네 거시기 안에 남은 걸 짜내자... HPH」","L"
					PRINTFORMDL 그녀의 섬세한 손가락이 뿌리부터 끝까지 당신의 성기를 사랑스럽게 더듬으며, 그 형상과 무게를 경건하게 기억한다.
					PRINTFORMDW 늑대 소녀는 당신의 정액에 완전히 취한 듯하다...
				CASE 1
					PRINTFORML 「음... 후후, 많이 나왔네...」
					PRINTFORMDL 만족스러운 미소를 지으며 임무를 잘 수행한 모미지의 머리를 쓰다듬고 그녀에게 말을 건넨다...
					IF ABL:膣射中毒 > 3 && RAND:2
						PRINTFORML 「내 질에서 "다음에"...라고? 우우, %CALLNAME:MASTER%-씨, 매번 그럴 필요는 없잖아요...」
					ELSE
						PRINTFORML 「"다음엔 내 입으로..."라니...? 음... %CALLNAME:MASTER%님, 딱 그럴 거라고 예상하고 있었던 건 아니에요...」
					ENDIF
					PRINTFORMDW 모미지는 얼굴을 새빨갛게 물들이고 당신에게서 시선을 돌리지만, 그녀의 꼬리는 격렬하게 흔들며 그녀를 배신한다...
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「와, 와, 굉장해... 전부 하얗네...」
					PRINTFORMDW 모미지는 손바닥을 물들이는 구름 같은 액체를 감상하며 흥분한 비명을 질렀다...
				CASE 1
					PRINTFORMW 「아, 음... 뜨거워... 그리고, 정말 좋은 냄새가 나네...」
				CASE 2
					PRINTFORML 「아우... 너무 끈적하네...」
					PRINTFORMDL 모미지는 손가락으로 튀긴 슬라임을 만지고, 거품이 이는 액체가 음탕한 질퍽거리는 소리를 낸다.
					PRINTFORMW 「...기분 좋았어? 후후, 다행이다.」
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
