;==================================================
;181,媚薬,
;危ない日じゃなくても発情させられちゃうぞ！
;==================================================

@M_KOJO_MESSAGE_COM_K65_181
CALL M_KOJO_MESSAGE_COM_K65_181_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_181_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;発情モードON
	TCVAR:発情 = 1
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMDL 의 수상한 병을 꺼내자, 모미지는 당신을 의심스럽게 바라본다.
		PRINTFORML 「저 위험해 보이는 건 뭐야...」
		PRINTFORMW 「애정제--... 뭐?! ...에?! 애정제라고?!」
		PRINTFORML
		PRINTFORML 「아니, 소문은 들었지만 그건 정말 눈썹을 치켜올릴 만하네...」
		PRINTFORML 「...정말로 나에게 이걸 마시라고 하는 거야?」
		PRINTFORMW 「...흐읍, 그렇게 쳐다보지 마.」
		SIF TALENT:恋慕
			PRINTFORMW (%HIM_HER(MASTER,,1)%에게 거절할 수 없을 만큼 너무 큰 연모를 느끼고 있어... 난 곤란해...)
		PRINTFORML
		PRINTFORML 「...대접 고마워요!」
		PRINTFORMDW 결의에 찬 표정으로 모미지는 병 속 내용물을 한 번에 마신다.
		PRINTFORML
		PRINTFORML 「...아, 이게 뭐야...」
		PRINTFORMDL 갑자기 모미지의 숨소리가 거칠어지고 눈에 신비로운 빛이 감돈다...
		SIF CFLAG:生理周期 != 7
			PRINTFORML (오늘은 위험한 날이 아니어야 할 텐데, 적어도...)
		PRINTFORMW 「글쎄, 정말 효과가 있나 보네...」
		PRINTFORML
		PRINTFORMDW 모미지가 최음제의 효과로 인해 [발정]한 것 같다.
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 「우으... 또...?」
		PRINTFORML 「애정제(aphrodisiac)를 먹으면... 머리가 온통 몽글몽글해지고 평소보다 훨씬 대담해져버려... 창피해.」
		PRINTFORMW 「입으로 옮기다니... 흥. 맹세하건대... 이건 불공평해...」
		PRINTFORML 
		PRINTFORML 「응, %TOLOWER(RANDKISS("kiss"))%... %RANDKISS("kiss")%, 꿀꺽—... %RANDKISS("kiss")%...」
		CALL HPH_PRINT,@"「「%MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH... 아아... 내 열이 올라오는 게 느껴져... 준비됐어, %CALLNAME:MASTER%-상?HPH」","W"
		PRINTFORML
		PRINTFORMDW 모미지가 최음제의 효과로 인해 [발정]한 것 같다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML
		PRINTFORMDW 모미지가 최음제의 효과로 인해 [발정]한 것 같다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
