	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
		;二人目がはたて
	ELSEIF (LOCAL:101) == 42
		;はたて口上のほうで掛け合いを書いてもらってるので、こっちではとりあえずしゃべらせない方向で
		RETURN 1
		;汎用
	ELSE
		;とりあえず改行
		PRINTFORMDL
		;IF TCVAR:発情
		;発情時口上の置き場
		;ELSE
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;慣れてない
			IF EXP:精飲経験 < 20
				;I had trouble figuring out if these lines were Momiji's or the BJ partners', but I think they're Momiji's.
				PRINTFORML 『코, 나오는 거야?』
				PRINTFORML 『와, 와아...!』
				IF ABL:(LOCAL:101):精液中毒 >= 3
					PRINTFORMDW %CALLNAME:(LOCAL:101)%은 당신의 절정을 예상하고 더 빠르게 움직이고 있고, 모미지는 자신의 놀라움을 숨기지 못하는 것 같다.
				ELSE
					PRINTFORMDW
					RETURN 1
				ENDIF
				;精液中毒高め
			ELSEIF ABL:精液中毒 > 3 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 『...!!』
						CALL HPH_PRINT,@"『%RANDLIPS(,"suck")%HPH %RANDKISS("suck")%HPH』","L"
						PRINTFORMDW 당신의 절정이 가까워지는 것을 감지하고, 모미지는 더욱 열정적으로 당신을 섬기기 시작한다...
					CASE 1
						CALL HPH_PRINT,@"『%RANDKISS("suck")%HPH %RANDKISS("kiss")%... %CALLNAME:MASTER%-씨, 미쳐가는 것 같아...HPH』","L"
