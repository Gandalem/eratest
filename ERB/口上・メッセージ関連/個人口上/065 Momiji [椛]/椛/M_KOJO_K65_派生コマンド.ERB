						CASE 1
							PRINTFORML 『%CALLNAME:(LOCAL:101)%님이 헤드 주는 걸 너무 잘해서, %CALLNAME:MASTER%님은 마치 「%HE_SHE(MASTER)%」의 즐거운 시간을 보내는 것 같아...』
							CALL HPH_PRINT,@"『우리 둘 다 한 번에 %HIM_HER(MASTER,,1)%을 핥으면 무슨 일이 일어날지 궁금하다... %RANDLIPS(,"suck")%HPH』","W"
					ENDSELECT
					;椛はまだまだ
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDW 모미지는 당신을 섬기려고 최선을 다하지만, 한편은 %CALLNAME:(LOCAL:101)%의 음탕함을 옆눈으로 흘긴다.
						CASE 1
							PRINTFORMDW 모미지의 얼굴은 새빨개졌고 그녀의 혀가 네 거시기 전체를 기어다녔다...
					ENDSELECT
				ENDIF
				;精液中毒高め
			ELSEIF ABL:精液中毒 > 3 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"『음... HPH %CALLNAME:MASTER%-씨, 정말 단단하시네요...HPH %RANDLIPS(,"suck")%HPH』","L"
						CALL HPH_PRINT,@"『푸아...HPH %CALLNAME:MASTER%-씨, 평소보다 더 움찔거리고 있네. 후후, 귀엽네~』","L"
						CALL HPH_PRINT,@"『%CALLNAME:(LOCAL:101)%-씨도 여기 있으니, 더 기분 좋게 해줄 수 있어HPH』","W"
					CASE 1
						CALL HPH_PRINT,@"『%RANDLIPS(,"suck")%HPH, %TOLOWER(RANDKISS("suck"))%HPH』","L"
						PRINTFORML 『응츄, 푸아~... 아와. 우리 둘의 침이 네 거시기를 그렇게 끈적하게 만들었어...』
						CALL HPH_PRINT,@"『더 많이 핥아주고 더 침을 흘리게 해줄 거야... HPH』","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 『뿌리부터 끝까지 둘 다 핥아보는 건 어때?』
						PRINTFORMW 『이런 걸 할 거면, 오직 두 사람만이 해줄 수 있는 방식으로 대접하는 게 어떻겠어?』
					CASE 1
						PRINTFORML 『음... 평소보다 더 크지 않아...?』
						CALL HPH_PRINT,@"『%RANDKISS("suck")%HPH %RANDKISS("suck")%, %TOLOWER(FSYN("lips_over"))%... 음, %CALLNAME:MASTER%-씨가 그걸로 만족한다면 괜찮아...』","W"
