						IF TCVAR:発情 && ABL:LOCAL:精液中毒 > 3 && RAND:2
							PRINTFORML 『%CALLNAME:(LOCAL:101)%-씨, 그리고 저도... %CALLNAME:MASTER%-씨의 정액이 너무나 원해요...』
						ELSE
							PRINTFORML 『%CALLNAME:(LOCAL:101)%-씨, 그리고 나는... %CALLNAME:MASTER%-씨의 거기가 너무 갖고 있어서 심장이 멈추지 않아...』
						ENDIF
						CALL HPH_PRINT,@"『우리 둘 다를 위해서 많은~ 액을 사정해줘HPH』","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALLFORM M_KOJO_MESSAGE_COM_K65_{SELECTCOM}_1
					CASE 1
						CALL HPH_PRINT,@"『%RANDKISS("suck")%HPH %RANDKISS("kiss")%... %CALLNAME:MASTER%-상, 괜찮아...』","L"
						PRINTFORMW 『이런 식으로 우리에게 주세요...』
				ENDSELECT
			ENDIF
		ELSE
			;相手の技巧が高い、または技巧差あり
			IF (ABL:(LOCAL:101):舌 > 3 || ((ABL:(LOCAL:101):舌 - ABL:65:舌) > 1 && ABL:(LOCAL:101):舌 > 2)) && RAND:3 == 0
