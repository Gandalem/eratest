			SELECTCASE RAND:4
				CASE 0
					CALLFORM M_KOJO_MESSAGE_COM_K65_82_1
				CASE 1
					CALL HPH_PRINT,@"「%RANDLIPS(,"suck")%HPH %RANDKISS("kiss")%HPH」","L"
					PRINTFORMW (%CALLNAME:MASTER%씨, 즐기고 있는 것 같군요...)
					;[献身的]だからね。セフレだろうともっと気持ちよくなってほしいはずだよね。
					SIF RAND:2
						CALL HPH_PRINT,@"(더, 당신이 더 큰 쾌감을 느끼길 원해...HPH)","W"
				CASE 2
					CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH %FSYN("lips_muffle")%HPH %RANDKISS("kiss")%HPH %RANDKISS("suck")%HPH」","L"
					PRINTFORMDW 모미지는 당신의 귀두에 음란한 소리를 내며 키스하고, 그녀의 가슴골에서 살짝 보이는 당신의 성기에 맞춰 좋은 리듬으로 반복한다...
				CASE 3
					CALL HPH_PRINT,@"「와, 아아... 가슴 사이에 꿈틀거리고 있어... 음무... %RANDKISS("kiss")%...%FSYN("lips_muffle")%HPH %RANDKISS("suck")%HPH」","L"
					PRINTFORMDL 모미지가 당신의 출렁이는 페니스의 끝을 입으로 잡고, 가슴으로 당신의 메이트 폴을 조심스럽게 위아래로 빨아 올린다...
					CALL HPH_PRINT,@"(우으... 매번 쓰다듬을 때마다, %CALLNAME:MASTER%-씨의 냄새가 강해진다... 이상한 기분이 들어...흐읍)","W"
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
