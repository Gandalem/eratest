;7,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K65_7
CALL M_KOJO_MESSAGE_SCOM_K65_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K65_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF EXP:子宮口開発経験 > 50
			CALL HPH_PRINT,@"「아으응흐으윽...?!」","L"
			CALL HPH_PRINT,@"「히이익, 응아아아ㅎ피 %CALLNAME:MASTER%-상, 기다려... 응아아아아안ㅎ피」","L"
			PRINTFORMDL 이 순간을 위해 모미지의 자궁경부를 철저히 단련시킨 후, 당신은 마침내 금지된 구멍을 관통한다.
			PRINTFORMDW 그녀의 눈은 가장 깊숙한 곳이 정복당하는 엄청난 쾌감에 놀라 커진다...
		ELSE
			PRINTFORML 「으윽, 으응...」
			PRINTFORML 「%CALLNAME:MASTER%-상, 잠시만요, 왜 그렇게 깊숙이 들어가는 거예요, 뭔가에 부딪히는 것 같아요...!」
			PRINTFORMDW 모미지는 당신이 그녀의 자궁경부로 밀고 들어오자 다소 고통스러운 숨을 내뱉었다...
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
	ELSE
		SELECTCASE EXP:子宮口開発経験
			;気持ちいい
			CASE IS > 50
				IF TALENT:恋慕 && RAND:2 == 0
					IF TCVAR:発情
						SELECTCASE RAND:2
							CASE 0
								CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
								PRINTFORMDL \@ TEQUIP:65:口接触部位 == 4 ? 모미지가 당신을 삼키려는 듯 입술을 공격한다 # 모미지의 표정은 가장 깊은 곳을 들뜨게 하고 싶어 하는 듯 황홀하게 변했다 \@...
								PRINTFORMDL 주도권을 잡고, 그녀는 너무나 강하게 골반을 아래로 내리꽂아 단숨에 자궁경부가 당신의 귀두에 입을 맞췄다.
								CALL HPH_PRINT,@"「흐으으하아... 흐읍 당신의 거시기 정말 박히는 느낌이야, %CALLNAME:MASTER%-씨... 흐읍 우리 이렇게 계속 연결된 채로 영원히 함께하고 싶어... 흐읍」","L"
								PRINTFORMDW 그녀의 부드럽고 처진 몸에서 느껴지는 온기, 달콤한 숨결, 관능적인 목소리가 모두 당신의 흥분을 최고조로 이끈다...
							CASE 1
								CALL HPH_PRINT,@"「아마, 찌릿... 흐으윽 나 완전히 무너질 것 같아... 흐으윽 쇼 구우드 흐으윽 %CALLNAME:MASTER%-상 흐으윽 오오옹흐으윽」","L"
								PRINTFORMDL 몽롱한 상태에서 모미지는 당신의 강력한 추삽질로 그녀의 자궁 입구를 벌리면서 더 큰 쾌락을 애원한다...
								IF TALENT:妊娠
									CALL HPH_PRINT,@"「나 약속해, \@ BABYMULTIAWARE(65) ? 아기들이 벌써 있어 # 이미 아기가 안에 있어 \@ 하지만 더, 내 안에 더 많은 것이 들어오길 원해HPH 히잉HPH」","W"
								ELSE
									CALL HPH_PRINT,@"「오 예 HPH 우웅 HPH 바로 그렇게 HPH 으응 HPH 터뜨려 줘, 내 깊숙한 곳에 HPH 나 임신시켜 줘!!! HPH」","W"
								ENDIF
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 0
								;騎乗位
								IF TEQUIP:体位２ == 3
									CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
									PRINTFORML (내 골반이 저절로 움직인다, \@ TEQUIP:65:口接触部位 == 4 ? 그리고 우리가 키스하는 방식이 마치 내가 더 많은 연모를 애원하는 것 같아 # 마치 그들이 %HIM_HER(MASTER)%을 훨씬 더 깊숙이 취하기 위해 애원하는 것처럼 \@...)
									PRINTFORML (내가 언제 이렇게 못된 아이가 되었지...)
								ELSE
									CALL HPH_PRINT,@"「%CALLNAME:MASTER%-상, %CALLNAME:MASTER%-산ㄴㄴㅎㅍㅎ 아아nnnnㅎㅍㅎ... 응, 우아아앙ㅎㅍㅎ」","L"
									PRINTFORML (내 자궁이 전부 축축하고 흠뻑 젖어, \@ TEQUIP:乳首吸い ? 그리고 내 가슴이 빨리고 # 나는 발정 난 짐승처럼 더러운 울음을 터뜨린다 \@...)
								ENDIF
								CALL HPH_PRINT,@"(하지만 너무 황홀하다...HPH 이것은 진짜 아기 만드는 섹스야, 절대 포기할 수 없어...HPH)","W"
							CASE 1
								CALL HPH_PRINT,@"「후아아안ㅎㅍㅎ 아아ㅎㄴㅎㅍㅎ 안응ㅎㅍ 아아아하~~ㅎㅍ」","L"
								PRINTFORMDL 모미지는 자신의 가장 깊은 곳이 완전히 난폭하게 탐해진 황홀경 속에서 몸을 떨며 미친 듯한 비명을 지른다...
								CALL HPH_PRINT,@"(나의 사랑하는 %CALLNAME:MASTER%-상에게 그렇게 격렬하게 연모받고 있다...)","L"
								CALL HPH_PRINT,@"(이것은 황홀함이야... HPH)","W"
						ENDSELECT
					ENDIF
				ELSE
					IF TCVAR:発情
						SELECTCASE RAND:2
							CASE 0
								CALL HPH_PRINT,@"「하아앙흐프 아아아우후프 안, 푸우웅흐...프 구, 아아앙하아...프」","L"
								PRINTFORMDL %BREAKENG(@"\@ 充填率(TARGET,1) >= 100 ? 정액으로 가득 차서 배가 임신한 여자처럼 부풀어 오르며, # 네 고기 막대가 그녀의 자궁을 흔들며 안으로 밀고 들어올 때, \@ 모미지는 압도적인 쾌감 때문에 통제할 수 없는 비명을 지른다...")%
								CALL HPH_PRINT,@"「%MOAN()%흐으음... 쇼, 좋아...흐으음」","W"
							CASE 1
								CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
								PRINTFORML 「푸아아앙ㅎ흐ㅍ 우운~ㅎㅍ 우운ㅎㅇ~ㅎㅍ」
								PRINTFORMDW 발정으로 뜨겁고 염증 난 그녀의 질 벽은 매번 밀어붙일 때마다 열렬히 조이며, 당신의 페니스가 더 깊이 들어가도록 유혹하려 한다...
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 0
								CALL HPH_PRINT,@"「아항흐프 아하안ㅎ프 %MOAN()%ㅎ프」","L"
								PRINTFORMDL %BREAKENG(@"\@ TEQUIP:体位２ == 3 ? 모미지가 당신 위에 올라타 격렬한 힘으로 골반을 떨거나, # 모미지가 당신의 밀어넣기에 맞춰 골반을 흔들며 더 강한 쾌감을 찾기 위해 자궁경부를 당신의 성기 머리에 비비려고 애쓴다... \@")%
								CALL HPH_PRINT,@"「오, 응흐읍... %MOAN("m:h",,2)%흐으음... 쇼 고오드흐으음」","W"
							CASE 1
								CALL HPH_PRINT,@"「%MOAN("l:m",,2,"dot")%... 흐으으읍 안 돼, 히이익 그만둬...! 제발 그만해애애!!!」","L"
								PRINTFORMW 「흥, 하아... 흐으윽, 계속 그렇게 세게 그곳 깊숙한 곳을 두드리면...」
								PRINTFORML
								PRINTFORML 「정신이 나가겠어, %CALLNAME:MASTER%-씨의 거친 것 외에는 아무것도 생각할 수 없을 거야...」
								CALL HPH_PRINT,@"「앙하아안ㅎㅍㅎ 아항ㅎㅍㅎ 아아응ㅎㅍㅎ 히구우ㅎㅍㅎ 노오, 스톱빗ㅎㅍ」","L"
								IF RAND:5 == 1
									CALL HPH_PRINT,@"「이-마치 '안으로 들어와라'고 말하는 것 같아, 내 몸은 어떻게 이럴 수가 HPH 아하아아앙그HPH」","W"
								ELSE
									PRINTFORMDW 모미지의 말은 무심코 정반대의 효과를 내고, 당신의 부풀어 오른 욕정에 이끌려 당신은 그곳을 더욱 깊숙이 밀어 넣는다...
								ENDIF
						ENDSELECT
					ENDIF
				ENDIF
				;ほぐれかけ
			CASE IS > 25
				IF TCVAR:発情
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「흐으응우웅, 우응, 오오~~후프」","L"
							CALL HPH_PRINT,@"「흐으-이게, 아아아앙...후우 후우 이거에 빠지고 있어...후우 하아앙후우」","L"
							PRINTFORMDW 모미지의 몸이 뛰어오르고 경련하며, 그녀의 꼬리가 자궁경부가 파헤쳐지는 쾌감에 흔들린다...
						CASE 1
							CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
							PRINTFORMDL 모미지는 격렬한 열기 때문에 과민해져서 자신의 가장 깊은 곳이 자극받는 황홀경 속에서 골반을 흔든다...
							CALL HPH_PRINT,@"「히이으응... 너무 깊숙한 곳에, 짓눌리고 있어...흐읍」","W"
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「하으응흐읍...아앙흐읍...흐으으...뭐지, 이게...흐으으」","L"
							PRINTFORMDL 당신이 그녀의 가장 깊은 부분을 건드릴 때마다 모미지에게 날카로운 쾌감이 스쳐 지나간다. 그것은 천천히 성감대로 발달한다.
							PRINTFORMDW 울프걸의 눈이 커진다. 그녀는 이전에 상상조차 할 수 없었던 감각을 느끼기 시작했기 때문이다...
						CASE 1
							CALL HPH_PRINT,@"「%MOAN()%HPH」","L"
							CALL HPH_PRINT,@"「S-스토빗HPH %CALLNAME:MASTER%-씨... 이-이렇게 계속하면...!HPH」","L"
							CALL HPH_PRINT,@"(이렇게 기분 좋게 느끼는 섹스를 경험한다면, 완전히 중독될 거야 HPH 벌써 이 쾌감에 빠지고 있어...!HPH)","W"
					ENDSELECT
				ENDIF
				;きつい 発情中でも思わず素面に
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「우으, 으응... 너는... 너무 깊숙이 박고 있어...」
						PRINTFORMDW 모미지는 고통과 쾌감 사이에서 웅얼거리는 신음을 흘린다...
					CASE 1
						PRINTFORML 「하아, 하아아... 너 너무 욕심 부리는 거야...」
						PRINTFORMW 「%CALLNAME:MASTER%-씨... 음, 아파요, 조금...」
				ENDSELECT
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
