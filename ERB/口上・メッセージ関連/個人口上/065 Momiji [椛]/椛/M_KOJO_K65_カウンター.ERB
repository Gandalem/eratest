@M_KOJO_MESSAGE_COUNTER_K65_33
CALL M_KOJO_MESSAGE_COUNTER_K65_33_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K65_33_1
IF TCVAR:発情
	;きょにゅー以上
	IF TALENT:バストサイズ > 0
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「안~...흐으 내 유두가 기분 좋아...흐으」", "L"
			CASE 1
				CALL HPH_PRINT,@"「음... %CALLNAME:MASTER%-씨, 더 만져주세요...HPH」", "L"
				PRINTFORMDL 당신이 그녀의 큰 가슴을 더듬자 모미지가 당신의 등에 손을 올린다.
				PRINTFORMDL 당신은 번갈아 그녀의 부드러운 유두를 쥐고, 잡아당기고, 쓰다듬는다... 그것들은 그녀의 작은 체구에 비해 너무 커서 균형이 맞지 않았다.
			CASE 2
				CALL HPH_PRINT,@"「후와, 하안, 아아... 흐프 에헤, 흥분했나...?」", "L"
				CALL HPH_PRINT,@"「너무 흥분돼...후훗」", "L"
		ENDSELECT
	ELSEIF TALENT:バストサイズ == 0
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「아은~... 흐응 내 유두가 기분 좋아...흐응」", "L"
			CASE 1
				CALL HPH_PRINT,@"「음... 더, 세게 만져줘...흐응」", "L"
				PRINTFORMDL 모미지는 당신이 손바닥으로 그녀의 단단하고 뾰족한 유두를 강하게 누르는 동안 뜨거운 한숨을 흘린다...
			CASE 2
				CALL HPH_PRINT,@"「아후~HPH 하아HPH 에헤... %CALLNAME:MASTER%-씨도 흥분하고 있어...?HPH」", "L"
		ENDSELECT
		;ひんにゅー以下
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「안~...흐으 내 유두가 기분 좋아...흐으」", "L"
			CASE 1
				CALL HPH_PRINT,@"「음... 더, 더 만져줘...흐읍」", "L"
				PRINTFORMDL 모미지는 당신이 손바닥으로 그녀의 단단하고 뾰족한 유두를 강하게 누르는 동안 뜨거운 한숨을 흘린다...
			CASE 2
				CALL HPH_PRINT,@"「후와~ 음...흐햣 %조사처리(CALLNAME:MASTER,"의")% 손이... 아아...흐햣」", "L"
				PRINTFORMDL 모미지는 등을 아치형으로 휘고 당신의 손에 모기 물린 자국들을 문지르며, 거의 당신을 자위하기쉬움 도구처럼 사용한다.
		ENDSELECT
	ENDIF
ELSE
	;きょにゅー以上
	IF TALENT:バストサイズ > 0
		SELECTCASE RAND:3 ;custom code
			CASE 0
				PRINTFORML 「부드럽고 예쁜가요? 음, 만약 %CALLNAME:MASTER%-님이 그것들을 좋아한다면 저는 기뻐질 거예요...」
			CASE 1
				CALL HPH_PRINT,@"「음... 더, 세게 만져줘...흐응」", "L"
				PRINTFORMDL 당신이 그것들을 철저하게 마사지하자, 당신의 손가락은 그녀의 상당한 가슴 속으로 파고들었다—그렇게 작은 소녀에게는 놀라울 정도로 큰 것이었다.
			CASE 2
				CALL HPH_PRINT,@"「후우~음...흐읍, 크네?」", "L"
		ENDSELECT
	ELSEIF TALENT:バストサイズ == 0
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「후후, %CALLNAME:MASTER%-씨, 당신의 기교가 마음에 드네요...큭」", "L"
			CASE 1
				CALL HPH_PRINT,@"「음... 더, 더 만져줘...흐읍」", "L"
				PRINTFORMDL 모미지의 가슴 위에 있는 통통한 사과들은 당신이 마음껏 가지고 놀 때 당신의 손길에 따라 찌그러지고 늘어난다.
			CASE 2
				CALL HPH_PRINT,@"「음흠~흐응 그렇게 살살 만지면 기회를 놓치게 될 거야, 안 그래...?」", "L"
		ENDSELECT
		;ひんにゅー以下
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「내 가슴에 대해서는 그렇게 자신감이 없어...」
				PRINTFORML 「하지만 그래도 당신이 나를 만져줬으면 좋겠어, %CALLNAME:MASTER%-씨...」
			CASE 1
				CALL HPH_PRINT,@"「음~... 제 작고 예쁜 가슴에 많은 연모를 보여주세요...흐흑」", "L"
			CASE 2
				PRINTFORMDL 당신의 손바닥에 눌려 있는 수줍은 가슴 뒤로, 모미지의 심장이 북처럼 요란하게 뛰는 것을 느낄 수 있다...
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
