			CASE 2
				PRINTFORMDL 모미지는 더 많은 쾌락을 갈망하며, 마치 먹잇감을 재는 짐승처럼 당신을 노려보며 당신에게 올라탄다...
				CALL HPH_PRINT,@"「%MOAN("m:h",,2)%흐으, 기분 좋다... 너무~ 좋다...흐으」","L"
			CASE 3
				PRINTFORMDL 모미지가 음란하게 골반을 흔들 때마다 방 안으로 진주 같은 땀방울을 뿌린다... 
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「%MOAN(,,2,"dot")%, %TOLOWER(FSYN("lips_muffle"))%ー... %MOAN()%HPH」","L"
			CASE 1
				CALL HPH_PRINT,@"「%MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %MOAN("l:m")%...HPH」","L"
				PRINTFORML 「어때...? 기분이 좋아?」
				PRINTFORMDL 네가 정말 최고라고 대답하면 모미지의 귀가 행복하게 파닥거린다.
				CALL HPH_PRINT,@"「%MOAN("l:m",,2)%HPH ...나도 그래... %MOAN("l:m",,2)%HPH ...기분 좋아...HPH」","L"
			CASE 2
				PRINTFORML 「음... %CALLNAME:MASTER%씨...」
				PRINTFORMDL 모미지가 당신의 손을 잡고 손가락을 얽는다.
				CALL HPH_PRINT,@"「후후~... %CALLNAME:MASTER%님의 손이 따뜻해...」","L"
				PRINTFORMDL 손을 꽉 쥐자 연인이 당신의 성 위에서 다시 몸을 흔들며 방탕한 신음을 토해냈다. 
				CALL HPH_PRINT,@"「%MOAN("l:m",,2,"dot")%, %TOLOWER(FSYN("lips_muffle"))%HPH」","L"
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
