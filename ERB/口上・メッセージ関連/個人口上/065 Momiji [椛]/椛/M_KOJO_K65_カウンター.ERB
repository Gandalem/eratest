RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K65_30_1
IF TCVAR:発情
	SELECTCASE RAND:3
		CASE 0
			CALL HPH_PRINT,@"「응, 응... 음, %TOLOWER(RANDKISS("kiss"))%...후우」", "L"
		CASE 1
			CALL HPH_PRINT,@"「%FSYN("lips_gulp")%, %TOLOWER(RANDKISS("suck"))%, 핥아봐... %CALLNAME:MASTER%씨의 혀가 맛있어...HPH」", "L"
		CASE 2
			CALL HPH_PRINT,@"「%RANDLIPS(,"kiss")%～...HPH」", "L"
			PRINTFORMDL 발정 난 그녀에게서 취한 어머니는 당신의 양쪽 뺨을 잡고 열성적으로 당신의 입안에 혀를 넣는다...
	ENDSELECT
ELSE
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「Mn... %RANDKISS("kiss")%～...」
		CASE 1
			PRINTFORML 「「%RANDKISS("kiss")%, 하안~ 음, %TOLOWER(RANDKISS("kiss"))%...」
		CASE 2
			PRINTFORML 「%RANDLIPS(,"kiss")%, 메뉴(mnu), 쪽쪽~...」
			PRINTFORMDL 모미지가 연달아 키스를 퍼부으며 당신의 입술을 콕콕 건드린다...
	ENDSELECT
ENDIF
RETURN 1
