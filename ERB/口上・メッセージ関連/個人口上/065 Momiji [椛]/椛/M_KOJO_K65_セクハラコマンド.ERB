; Modular ERB: 個人口上/065 Momiji [椛]/椛/M_KOJO_K65_セクハラコマンド.ERB
;
;セクハラ系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K65_310
CALL M_KOJO_MESSAGE_COM_K65_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF TCVAR:発情
			IF CFLAG:既成事実 & 合意_うふふ
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「안~ 쯧...」
						PRINTFORMDW 모미지는 욕망으로 눈이 풀린 채 당신을 응시한다...
					CASE 1
						PRINTFORML 「하아, 후우~ 음...」
						PRINTFORMDW 모미지가 너에게 그녀의 작은 엉덩이를 쓰다듬자 뜨거운 한숨을 내쉰다.
					CASE 2
						CALL HPH_PRINT,@"「쿠우~ 음... %CALLNAME:MASTER%-상...흐읍」","L"
						PRINTFORMDW 모미지가 당신에게 기대어 몸을 비비고 당신이 그녀를 더 만진다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「안 돼, 그만해...」
						PRINTFORMDW 엄마지(Momiji)는 당신의 뒤쪽을 더듬는 손가락을 견디며 눈에 눈물을 가득 담았다...
					CASE 1
						PRINTFORML 「푸아아아...!」
						PRINTFORMDW 발정기에 깊이 빠진 모미지는 자신의 엉덩이를 기어다니는 소름 끼치는 쾌감을 견딜 수 없어 비명을 지른다...
				ENDSELECT
			ENDIF
			;膝枕直後
		ELSEIF PREVCOM == 305
			PRINTFORMW 「안녕...! 그런 행동은 그만해 주겠니...?」
		ELSEIF TALENT:恋慕 && RAND:4 > 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「큐～! 갑자기 그런 걸 하고 싶어?」
					PRINTFORML 「에... 싫지는 않은 것 같아... 와...! %FSYN("lips_muffle")%, 음... 정말이지...」
					PRINTFORMDW 당신은 마음껏 모미지의 탄력 있는 엉덩이를 만지는 것을 완전히 즐겼다.
				CASE 1
					PRINTFORML 「하아~ %FSYN("lips_muffle")%, 음...」
					PRINTFORMDW 당신이 그녀의 작은 엉덩이를 쓰다듬자 모미지가 뜨거운 한숨을 내뱉는다.
				CASE 2
					PRINTFORML 「그런 종류의 장난은 그만두렴.」
					PRINTFORMDW 모미지는 수줍게 주위를 두리번거리지만, 당신의 애정 표현으로부터 결코 벗어나지 않는다...
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「그만해 주세요!」
					PRINTFORMDW 모미지는 당신의 손을 쳐낸다.
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「흐으음... 그저...」
						CASE 1
							PRINTFORMW 「그, 이건 창피하니까...」
					ENDSELECT
					;されるがまま
				CASE 4
					PRINTFORML 「Ku, %TOLOWER(FSYN("lips_muffle"))%...」
					PRINTFORMDW 모미지가 살짝 몸을 돌려 당신을 응시하며 사과를 기다리는 듯하다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K65_311
CALL M_KOJO_MESSAGE_COM_K65_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSE
		IF CFLAG:うふふ == 2
			SELECTCASE TCVAR:20
				;ディープキス
				CASE 60
					PRINTFORMDL 당신은 두 사람이 어설프게 키스하는 동안 모미지를 꽉 껴안고, 그녀는 기쁘게 당신의 포옹에 응한다... 
					CALL HPH_PRINT,@"「후후, %RANDLIPS(,"kiss")%, 푸아아~... 음, 한 번 더... 음음, 추우~...흐읍」","W"
					;だいしゅきホールド
				CASE 86
					CALL HPH_PRINT,@"「응! 후후 아! 후후 더! 후후 더~! 후후」","L"
					PRINTFORMDW 당신이 그녀를 세게 끌어안고 단단한 곳에 몸을 부딪치자, 모미지는 흥분해서 비명을 지르며 당신의 리듬에 맞춰 자신의 골반을 움직인다.
				CASEELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「하아... %CALLNAME:MASTER%씨는 따뜻하다...」
						CASE 1
							PRINTFORMW 「더 세게 안아줘, 부탁이야...」
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:恋人 && RAND:2
			IF TCVAR:発情
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %FSYN("lips_muffle")%HPH... 음, %CALLNAME:MASTER%-씨...HPH」","L"
						PRINTFORMDW 그녀를 안고 있는 동안 모미지가 당신의 품에서 꿈틀거리며 다리를 애타게 비빈다...
					CASE 1
						CALL HPH_PRINT,@"「「%MOAN()%...%FSYN("lips_muffle")%HPH %FSYN("lips_muffle")%HPH... 하아~...HPH」","L"
						PRINTFORMDW 당신이 안아주자, 모미지가 부드러운 손으로 등을 쓰다듬는다...
						SIF RAND:3 == 0
							PRINTFORMDW 모미지가 당신에게 몸을 비벼대는데, 마치 자신의 향으로 당신을 표시하려는 것처럼 보인다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「Nn...HPH」","L"
						PRINTFORMW 「이거 계속 하고 싶어...」
					CASE 1
						PRINTFORML 「Un～♪」
						CALL HPH_PRINT,@"「나를 안아줘... 점점 더...HPH」","W"
				ENDSELECT
			ENDIF
		ELSEIF TALENT:恋慕
			IF TCVAR:発情
				IF BASE:MASTER:勃起 > 999 && CFLAG:既成事実 > 0 && RAND:2 == 0
					PRINTFORML 「아하, %CALLNAME:MASTER%-씨, 당신의 작은 것이 이렇게 되었군요...」
					PRINTFORMDL 당신이 발기한 것을 알아차린 모미지는 애타게 당신에게 기대어 장난스럽게 가슴을 쓰다듬는다.
					CALL HPH_PRINT,@"「어이, 좀 더... 사적인 곳에 갈래...? HPH」","W"
				ELSE
					PRINTFORML (그렇게 안겨만 있어도 속이 뒤집히는 기분이야...)
					PRINTFORMW (... %CALLNAME:MASTER%-씨가 원하고 있고, 온몸이 아파와...)
				ENDIF
			ELSE
				IF BASE:MASTER:勃起 > 999 && CFLAG:既成事実 > 0 && RAND:2 == 0
					PRINTFORMW 「음, %CALLNAME:MASTER%씨... 뭔가 딱딱한 것이 나를 찌르고 있어...」
					PRINTFORMDW 모미지는 당신의 발기된 성기를 느끼며 안절부절못하고 옷을 만지기 시작했다...
					SIF PALAM:欲情 >= PALAMLV:4
						PRINTFORMW (우으... 나도 이상한 기분이야...)
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「Nn... HPH」","L"
							PRINTFORMW 「%CALLNAME:MASTER%-씨, 좋은 냄새가 나네...」
						CASE 1
							PRINTFORMW 「에헤헤, %CALLNAME:MASTER%-씨, 따뜻하네...」
						CASE 2
							PRINTFORML 「%CALLNAME:MASTER%-상...」
							PRINTFORMDW 모미지가 당신의 가슴에 머리를 파묻는다...
					ENDSELECT
				ENDIF
			ENDIF
		ELSEIF TALENT:思慕
			IF TCVAR:発情
				PRINTFORML 「어, 음...」
				PRINTFORMDW 모미지가 허벅지를 비비며 몸을 꿈틀거렸다...
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「Uu...」
						PRINTFORMDW 모미지는 얼굴을 붉히지만 아무런 행동도 하지 않는다.
					CASE 1
						PRINTFORMDW 모미지가 천천히 팔을 당신 주위에 두며 가볍게 당신의 포옹에 화답했다...
				ENDSELECT
			ENDIF
			;・非陥落時
			;親密>5 突然の事に驚いたのかじたばたと身体を揺らしている…
		ELSEIF ABL:親密 > 5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「뭐, 갑자기 뭘 하는 거야...?」
					PRINTFORMDW 모미지는 예고 없이 느껴진 당신의 포옹에 당황한다.
				CASE 1
					PRINTFORML 「Uu...」
					PRINTFORMDW 모미지는 어떻게 반응해야 할지 고민하는 듯하지만 도망치지는 않는다.
			ENDSELECT
			;親密<=5 大声を上げて%CALLNAME:MASTER%を突き飛ばした
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「꺅?! 그, 그렇게 깜짝 놀라게 하지 마요!」
				CASE 1
					PRINTFORML 「꺄아?!」
					PRINTFORMDL 뒤에서 갑자기 안기자 놀란 모미지가 깔끔하게 배를 팔꿈치로 때린다...
					PRINTFORMW 「괜찮니?!」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K65_312
CALL M_KOJO_MESSAGE_COM_K65_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:TARGET:添い寝中
		PRINTFORML 「Nn...」
		CALL HPH_PRINT,@"「에헤헤...흐으응」","W"
		;拒絶
	ELSEIF TFLAG:193 == 99
		PRINTFORML 「아-너무 가까워지는 거 아니야?」
		PRINTFORMDW 모미지가 한 걸음 뒤로 물러서며 당신을 의심스럽게 바라본다...
	ELSE
		;初めて
		IF FIRSTTIME(SELECTCOM)
			;デートキスイベント済み
			IF EXP:TARGET:キス経験 > 1
				PRINTFORML 「Nn...」
				PRINTFORML 「...이것은 %CALLNAME:MASTER%-상과의 나의 첫 키스이야...」
				PRINTFORMW 「에헤헤, 나 기뻐져!」
			ELSE
				PRINTFORML 「Nn..?!」
				PRINTFORML 「토-갑자기 그냥...?!」
				PRINTFORML (아, 이게 나의 첫 키스였나...?)
				PRINTFORMDW 모미지는 멍한 표정으로 자신의 입술을 만지며 앉았다.
			ENDIF
		ELSEIF CFLAG:うふふ == 2
			SELECTCASE TCVAR:20
				;だいしゅきホールド
				CASE 86
					CALL HPH_PRINT,@"「흠?! %RANDKISS("kiss")%... %RANDKISS("kiss")%, 츄우~후프」","L"
					PRINTFORMDL 그녀의 강렬한 포옹에 응답하여 그녀에게 키스할 때, 
					PRINTFORMDW 모미지는 숨을 참고 당신의 입술에 자신의 입술을 달라붙이며 당신의 입안을 간절히 탐색한다...
					;キス
				CASE 60
					CALL HPH_PRINT,@"「음, 냠냠, 후후... 츄우, %TOLOWER(RANDKISS("kiss"))%쪽 %RANDKISS("kiss")%, 핥아 핥아... 쪽」","L"
					PRINTFORMDW 당신이 키스에 반응하면, 모미지가 자신의 혀를 당신의 입안으로 밀어 넣는다...
				CASEELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「%RANDKISS("kiss")%, 키스, %TOLOWER(RANDKISS("kiss"))%...」
							PRINTFORMDW 모미지는 당신에게 입맞춤하는 데 황홀해한다.
						CASE 1
							CALL HPH_PRINT,@"「음, 후아... 키스하는 게 너무 좋아... HPH %RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%...」","W"
					ENDSELECT
			ENDSELECT
		ELSEIF TCVAR:発情
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「하아, %CALLNAME:MASTER%-상, %TOLOWER(RANDKISS("kiss"))%, %TOLOWER(RANDKISS("kiss"))%...흐읍」","L"
					PRINTFORMDW 모미지는 당신의 혀 주위로 몸을 감으며 키스를 음미하듯 자신의 혀를 당신의 입 안으로 밀어 넣는다.
				CASE 1
					CALL HPH_PRINT,@"「츄우, %TOLOWER(RANDKISS("kiss"))%, %TOLOWER(RANDKISS("kiss"))%...후후」","L"
					PRINTFORMW (%CALLNAME:MASTER%-님의 키스는 정말 좋다...)
					SIF CFLAG:既成事実 & 合意_うふふ
						PRINTFORMW (하지만, 더 이상 견딜 수가 없어...)
			ENDSELECT
		ELSEIF ABL:親密 >= 5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「음, 쪽...」
					PRINTFORMD 모미지 
					SIF TALENT:MASTER:体型 > TALENT:65:体型
						PRINTFORMD 그녀는 발끝으로 서 있다 
					PRINTFORMDW 당신과 키스하는 것을 즐긴다...
				CASE 1
					PRINTFORML 「츄우... 에헤헤...」
					PRINTFORMDW 모미지는 살짝 홍조를 띠며 미소 짓는다.
			ENDSELECT
		ELSE
			PRINTFORMW 「음...?! ...푸아!」
			PRINTFORMW 「음, 방금 그건 뭐였지...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;313,胸愛撫
;CFLAG:うふふ==2&&TCVAR:20(27=谷間を見せる 33=胸を揉ませる 53=パイズリ(小分岐は地の文EVENT_MESSAGE_COM_セクハラ.ERB参照) 73=ぱふぱふ 77=乳を吸わせる 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;ABL:Ｂ感覚(2未満=性的には感じてない 5未満=多少感じてる 5以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;乳のサイズでも変わる場合があるので、地の文EVENT_MESSAGE_COM_セクハラ.ERB参照
;台詞＋胸サイズごとのフレーバーテキストって形式が無難かしらね
;==================================================

@M_KOJO_MESSAGE_COM_K65_313
CALL M_KOJO_MESSAGE_COM_K65_313_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		IF TCVAR:発情
			SELECTCASE TCVAR:20
				;胸を揉ませる
				CASE 33
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「후아, 아... 아아~ 후프」","L"
							PRINTFORMDW 눈을 반짝이며 모미지가 당신의 손을 가슴에 더 세게 누른다...
						CASE 1
							;きょにゅー以上
							IF TALENT:バストサイズ > 0
								PRINTFORML 「에헤, 내 가슴엔 꽤 자신 있어...」
								PRINTFORMDL 모미지는 당신의 손을 이끌어 그녀의 거대하고 폭신한 봉우리를 주무르게 한다...
								PRINTFORMDW 그녀는 행복한 표정으로 살짝 침을 흘린다...
								;ひんにゅー以下
							ELSEIF TALENT:バストサイズ < 0
								CALL HPH_PRINT,@"「하아... 후후 음-내 가슴이 정말 기분이 좋아... 후후」","L"
								PRINTFORMDW 그녀의 관능적으로 솟아오른 유두를 주무르며, 모미지는 당신의 손바닥을 자신의 가슴에 대도록 한다...
								;ふにゅー
							ELSE
								CALL HPH_PRINT,@"「%CALLNAME:MASTER%-씨, 더 많이 해줘...큭큭큭」","L"
								PRINTFORMDW 그녀의 간청에 당신이 그녀의 작은 가슴을 더 세게 마사지하자, 모미지는 즐거움으로 떨었다.
							ENDIF
						CASE 2 ;custom code
							CALL HPH_PRINT,@"「하아흐햬 내 유두, 내 유두들~ 하햬」","L"
							PRINTFORMDW 너는 손톱으로 모미지의 단단한 유두를 부드럽게 긁고, 그녀는 쾌감에 비명을 질렀다...
					ENDSELECT
					;パイズリ
				CASE 53
					SELECTCASE RAND:3
						CASE 0
