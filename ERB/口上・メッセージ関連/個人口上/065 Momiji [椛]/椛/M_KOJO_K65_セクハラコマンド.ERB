							PRINTFORMDW 모미지는 당신이 그녀의 비밀스러운 곳을 침범하는 동안 당신의 손가락 끝을 숨기려 다리를 단단히 오므렸다.
							PRINTFORML
							CALL HPH_PRINT,@"「%MOAN()%...%FSYN("lips_muffle")%HPH %MOAN()%, %TOLOWER(FSYN("lips_muffle"))%...HPH」","L"
							PRINTFORMDL 하지만 그녀는 당신을 실제로 막을 의도가 없는 것 같다.
							PRINTFORMDW 당신은 그녀의 미끄러운 보지를 파헤치면서 그저 그녀 허벅지의 부드러운 온기를 즐긴다...
						ELSE
							PRINTFORMDL %BREAKENG(@"네 손가락 끝으로 그녀의 부드러운 주름을 조일 때마다 모미지의 몸은 떨리고 입에서는 뜨거운 신음이 새어 나왔다.")%
							CALL HPH_PRINT,@"「그만해~... 더 하고 싶게 만들 거야... HPH」","W"
						ENDIF
					CASE 1
						CALL HPH_PRINT,@"「%MOAN(,,2)%...아아흑 안돼 그만둬 제발...흐읍」","L"
						CALL HPH_PRINT,@"「...내 골반이, 제어가 안 돼요... HPH %MOAN("m:h",,2,"dot")%HPH %MOAN("m:h")%HPH」","W"
				ENDSELECT
				;ちょっと気持ちいい
			ELSEIF ABL:Ｖ感覚 > 1
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%MOAN("l:m")%HPH %MOAN("l:m",,2)%HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「아, 음...흠. 안 되겠다, 그 '스윽-스윽' 소리가 나네... 아앙~흠.」","L"
						PRINTFORMDW 모미지는 당신의 손가락을 비틀고 몸부림치며 받아들이고, 음란한 소리가 그녀의 가랑이에서 울려 퍼진다...
					CASE 2
						CALL HPH_PRINT,@"「%MOAN()%, %TOLOWER(FSYN("lips_muffle"))%HPH %FSYN("lips_muffle")%...HPH」","L"
						;人目がある
						IF EYEWITNESS()
							PRINTFORMDL 모미지는 늑대 귀가 작은 레이더 접시처럼 사방으로 돌아가는 동안 불안하게 주변을 둘 뿐이다...
							PRINTFORMW 「끔찍해... 와! 아우우... 누군가 눈치채면... 으윽! 우리 어떡하지...」
						ELSE
							PRINTFORMDL 모미지는 눈을 질끈 감고 자신의 은밀한 곳에 선사되는 쾌감에 집중한다...
							PRINTFORMW 「태풍처럼 나를 휘젓는군요, %CALLNAME:MASTER%-상... 하아~... 기분이... 굉장해요...」
						ENDIF
				ENDSELECT
				;こなれてない
			ELSE
				PRINTFORML 「크으, 음흠...」
				PRINTFORMDW 엄마지(Momiji)는 코로 한숨을 쉬지만, 네가 바라던 만큼 아직 즐기고 있지는 않은 것 같아...
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
