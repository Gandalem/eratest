;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があってもムードが足りぬ）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先にキスぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外
;==================================================

@M_KOJO_MESSAGE_COM_K65_350
CALL M_KOJO_MESSAGE_COM_K65_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		;初回
	ELSEIF TCVAR:抱き寄せ初回
		SELECTCASE TCVAR:抱き寄せ初回
			;1=普通に合意
			;%CALLNAME:TARGET%は覚悟を決めたような目で%CALLNAME:MASTER%を見つめている…
			;%CALLNAME:TARGET%は不安と期待が入り混じったような表情を浮かべている…
			CASE 1
				IF TALENT:恋慕
					PRINTFORMDL 
				ELSEIF TALENT:思慕
					PRINTFORMDW
				ELSE
					PRINTFORMDW
				ENDIF
				;2=先にキスぐらいしろよ
				;%CALLNAME:TARGET%は受け入れてくれたがどこか不満そうだ
				;…そういえばキスもまだだった
			CASE 2
				IF TALENT:思慕 || TALENT:恋慕
					PRINTFORML 「큐?!」
					PRINTFORMDW 제압당한 모미지는 당신의 얼굴을 응시하며 숨을 들이켰다.
					PRINTFORML 「Ah......」
					PRINTFORMDW 하지만 곧 그녀가 시선을 내리자 수치심이 얼굴에 드리우기 시작했다.
					PRINTFORML 「어... 이거는 안 될 것 같아...」
					PRINTFORMW 「우리 아직 키도 해보지 않았는데...」
				ELSE
					PRINTFORMDW 제압당한 모미지는 무언가 말하려 한다.
					PRINTFORML 「음... 글쎄...」
				ENDIF
				;3=媚薬or発情には勝てなかったよお…
				;%CALLNAME:TARGET%は体の疼きを抑えきれず、%CALLNAME:MASTER%に体を許してしまった…
			CASE 3
				PRINTFORMDL 고정된 모미지는 미동도 하지 않은 채 당신의 얼굴을 바라본다.
				PRINTFORMDL 흥분으로 거칠게 숨을 몰아쉬며, 당신은 그녀의 반응이 수용이라 말할 수도, 거부라 말할 수도 없는 것을 견딜 수 없다.
				PRINTFORMDW 심장이 빠르게 뛰는 것을 느끼며, 당신은 모미지의 작은 몸을 단단히 끌어안는다...
				PRINTFORML 
				PRINTFORML (이건 못 하겠어... 하지만 내 몸이 움직여주지 않아...)
				PRINTFORMDL 흰 늑대 텐구는 발정으로 후각, 청각, 촉각이 모두 예민해져 있다.
				PRINTFORMDL 그녀는 당신에게서 뿜어져 나오는 커지는 %PRINT_MALE("male", MASTER)% 욕망의 불꽃에 노출되어 방어할 수 없는 상태이다.
				PRINTFORMDW 당신의 흥분에 응답하여 모미지의 욕망에 찬 몸은 점점 더 짜릿해진다.
				PRINTFORML 
				PRINTFORML 「...괜찮아...」
				PRINTFORMDW 온몸을 감싸는 달콤한 마비에 견딜 수 없어 그녀는 마침내 동의를 중얼거린다...
				PRINTFORML
				IF TALENT:処女
					PRINTFORML 「하지만, 음... 진짜 행동은 하지 말아줘...」
					PRINTFORM 그 외에는, 
				ELSE
					PRINTFORML 「하지만 적절한 피임법을 사용해 주세요...」
					SIF CFLAG:生理周期 == 7
						PRINTFORML 「오늘은 정말 최악의 날이야...」
					PRINTFORM 네가 그렇게 하는 한, 
				ENDIF
				PRINTFORMW 원하는 대로 다 해줄게…」
				IF TALENT:思慕
					PRINTFORML
					PRINTFORMW (…음, 혹시 %CALLNAME:MASTER%-씨라면…)
				ELSEIF CFLAG:65:信頼度 > 99
					PRINTFORML
					PRINTFORMW (%CALLNAME:MASTER%-상은 믿을 만한 사람이다...)
				ENDIF
				;4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
				;止まった時の中で開発された%CALLNAME:TARGET%の体は、本人の意志と拘わりなく%CALLNAME:MASTER%を求めてしまう…
				;%CALLNAME:TARGET%はわけもわからぬまま、%CALLNAME:MASTER%を受け入れてしまった…
			CASE 4
				PRINTFORML 「...우! 놓아줘!!」
				PRINTFORMDW 모미지가 당신의 손아귀에서 벗어나려 시도하는 순간...
				PRINTFORMW 「응...?」
				PRINTFORMDW 다소 향수를 불러일으키면서도 흥분되는 그 향기에 모미지의 심장이 두근거렸다.
				PRINTFORML 「제발... 이러지 말아줘... 그만해달라고 부탁할게...」
				PRINTFORMDW 그녀의 몸은 자신도 모르게 완전히 발달하여, 이제 당신의 접근을 거부하기 위해 조금이라도 힘을 주지 못하는 듯했다...
				;6=まんざらでもない
				;%CALLNAME:TARGET%に拒まれてしまった…
				;しかし%CALLNAME:TARGET%はまんざらでもなさそうだ
			CASE 6
				;7=駄目
				;%CALLNAME:TARGET%に拒まれてしまった…
			CASE 7
				;8=論外
				;%CALLNAME:TARGET%は%CALLNAME:MASTER%をにべもなく撥ね付けた
		ENDSELECT
		;通常
	ELSE
		SELECTCASE TFLAG:194
			;0=成功
			CASE 0
				;押し倒し返し
				;押し倒す成功時にうふふ=1が代入されるようなので下記の場合分けでは上手くいかないよーで
				IF CFLAG:うふふ == 2
					IF TCVAR:発情
						PRINTFORML 「...헤에, 그런 기분이 드는군, 응?」
						CALL HPH_PRINT,@"「괜찮아... 기분 좋아지는 것들을 많이 하자...HPH」","W"
					ELSE
						PRINTFORMDW 
					ENDIF
					;椛以外に恋人がいる
				ELSEIF !TALENT:恋人 && TALENT:MASTER:恋人 && RAND:4 == 0
					PRINTFORML 「...%CALLNAME:MASTER%-씨, 두 얼굴의 사람이네.」
					PRINTFORML 「당신에게 연인이 있다는 것과, 그녀와 나를 가지고 바람을 피우고 있었다는 것을 알고 있어.」
					PRINTFORMDW 모미지는 좌절감에 입술을 삐죽 내밀었지만 당신의 팔에서 벗어나려 하지 않았다.
					PRINTFORML 
					IF TALENT:恋慕 && RAND:3 == 0
						;プレイヤーさんの良心に訴えるのもアリかなと思いましたが、せっかくなら都合よく気分よく抜いていただきたいものです
						;PRINTFORMW 「…私の気持ちだって、とっくに知ってるのに。本当に、ひどい人…」
						PRINTFORMW 「...제발 나만 생각해줘... 적어도 이 순간만큼은...」
					ELSEIF TALENT:セフレ||TALENT:愛欲 && RAND:3 == 0
						PRINTFORML 「...후후, 내가 알고 있었다니 놀랐어?」
						IF TCVAR:発情
							CALL HPH_PRINT,@"「지금은 그런 건 다 잊고 그냥 남녀로 지내자...HPH」","L"
							CALL HPH_PRINT,@"「잔뜩 하고 놀자~ 섹스 잔뜩 하자, 음... HPH」","W"
						ELSE
							PRINTFORML 「하지만 나도 당신만큼 죄가 있어, %CALLNAME:MASTER%-상... 연인이 있다는 걸 알면서 나를 안게 해준 것에 대해.」
							PRINTFORMW 「그러니 우리 함께 나쁜 사람이 되자고, 어때?」
						ENDIF
					ELSEIF ABL:欲望 >= 6 && RAND:2 == 0
						PRINTFORML 「그리고 당신은 내 몸을 그렇게 부끄럼 없게 훈련시켰군요...」
						PRINTFORMDW 모미지는 그녀의 떨리는 어깨를 부드럽게 안고, 고개를 살짝 저은 뒤, 당신의 가슴에 얼굴을 파묻는다...
					ELSE
						PRINTFORML (거절할 수 있을 만큼 강해져야 해...)
						PRINTFORMW (소용없어, 난 그럴 수 없어...)
					ENDIF
					;椛の住まい
				ELSEIF CFLAG:現在位置 == OMANEKIBEYA() || CFLAG:現在位置 == CFLAG:65:311
					IF TCVAR:発情
						IF ABL:欲望 > 9
							CALL HPH_PRINT,@"「아...흐으읍」","L"
							PRINTFORMDW 당신이 자신을 안자 모미지가 한숨을 내쉰다.
							PRINTFORML
							PRINTFORML 「음, %CALLNAME:MASTER%-씨...」
							PRINTFORML 「방에 들어온 뒤로 언제 나한테 달려들지 궁금했어...」
							PRINTFORMW 「당장이라도 일어날 거라고 바라고 있었는데...」
							PRINTFORML
							PRINTFORML 「다 네 잘못이야, 내가 이렇게 못된 아이가 된 건...」
							CALL HPH_PRINT,@"「부탁이야, 책임져 줄래? %CALLNAME:MASTER%-상HPH」","W"
						ELSE
							CALL HPH_PRINT,@"「괜찮아... 어서 와, 여기로 와... %CALLNAME:MASTER%-상...」","L"
							PRINTFORMDW 모미지가 양팔을 벌려 당신을 끌어안으며 재촉한다...
						ENDIF
					ELSE
						PRINTFORML 「음, %CALLNAME:MASTER%-씨... 내가 이불을 깔 테니 잠시만 기다려줘...」
						PRINTFORMW 「흠... 그렇게 하면 청소할 게 별로 없겠네...」
					ENDIF
				ELSE
					IF TCVAR:発情
						IF CFLAG:65:溜まってる度 >= 550 && RAND:2
							CALL HPH_PRINT,@"「Mn...HPH」","L"
							PRINTFORMW 「%CALLNAME:MASTER%-상, 인내심이 다 떨어졌나요...?」
							PRINTFORML
							CALL HPH_PRINT,@"「...응, 나도 그래... 당신이랑 하고 싶었어, %CALLNAME:MASTER%-상...HPH」","L"
							PRINTFORMDL 모미지는 그녀의 성기를 당신의 옷 위로 \@ EQUIP:MASTER:下半身下着１ || EQUIP:MASTER:下半身下着２ ? 스치거나 # 맨살 위로 훑는다 \@.
							CALL HPH_PRINT,@"「...아하하, 준비됐어...?」","W"
							PRINTFORML
							CALL HPH_PRINT,@"「나쁜 짓 많이 하자... HPH」","W"
						ELSE
							CALL HPH_PRINT,@"「아하, %CALLNAME:MASTER%-상...후후 음, 후우...」","L"
							PRINTFORMDW 당신이 그녀를 제압하자 모미지가 자신의 온몸을 당신에게 비비며 발정기의 향으로 당신을 흥분시키려 한다.
						ENDIF
					ELSE
						IF TALENT:恋慕 && RAND:3
							PRINTFORML 「%CALLNAME:MASTER%-상...」
							PRINTFORMDL 어깨에 손을 올린 채, 모미지는 고개를 당신의 가슴 쪽으로 숙인다.
							PRINTFORMDW 그녀의 은백색 머리카락이 부드럽게 흔들리고, 희미하게 달콤한 향기가 코를 간지럽힌다.
						ELSE
							PRINTFORML 「...다시 하고 싶니?」
							IF CFLAG:65:溜まってる度 >= 700 && RAND:2
								PRINTFORMW 「...음, 있잖아... 너도 그렇게 해주길 좀 바랐는데...」
							ELSE
								PRINTFORMW 「...%CALLNAME:MASTER%-씨, 변태야~」
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				;1=人目がある
				;ここでは人目がある……
			CASE 1
				IF TCVAR:発情
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「혹시 당신은 과시욕이 강한 사람인가요, %CALLNAME:MASTER%-씨...?」
						CASE 1
							PRINTFORML 「우으... 정말 이걸 하고 싶다면, 나를 조용한 곳으로 데려가 줘...」
							IF TALENT:恋慕
								PRINTFORMW 「나의 가장 음란한 모습을 보는 건 오직 %CALLNAME:MASTER%-씨뿐이었으면 해...」
							ELSE
								PRINTFORMW 「당신 외에 누가 내가 발정했을 때 저런 천박한 표정을 짓는 걸 본다면 창피해서 죽을 거야…」
							ENDIF
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「이런 곳에서 그걸 한다면, 우리는 완전히 노출될 거야...」
						CASE 1
							PRINTFORMW 「적어도 나를 조용한 곳으로 데려가줘...」
					ENDSELECT
				ENDIF
				;2=野外は嫌でござりまする
				;%CALLNAME:TARGET%に拒絶された
				;流石に野外では抵抗があるようだ
			CASE 2
				;未実装
				;3=多人数プレイは勘弁
				;PRINTFORMDL %CALLNAME:TARGET%達を抱き寄せたかったが、乱交までは許してくれなさそうだ…
			CASE 3
				;未実装
				;4=合意があってもムードが足りぬ
				;%CALLNAME:TARGET%を抱き寄せようとしたが、そんな気分じゃないと拒まれてしまった
			CASE 4
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
