;==================================================
;621,釣りをする
;TFLAG:193(0=釣れない 1～4=魚 11～15=うまい魚 610=木材 131=守矢の守札 21=ローター 609=氷の鱗 606=龍の爪)
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================

@M_KOJO_MESSAGE_COM_K65_621
CALL M_KOJO_MESSAGE_COM_K65_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;釣れなかった
	IF TFLAG:193 == 0
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「음, 이런 때도 있는 법이지.」
				PRINTFORMW 「인내심을 가지자, %CALLNAME:MASTER%-씨.」
			CASE 1
				PRINTFORML 「음, 바람이 좀 불기 시작하는군...」
				PRINTFORML 「...이렇게 가만히 앉아 찌가 움직이는 걸 보는 것도 좋네.」
				PRINTFORMDW 당신과 모미지는 낚싯대를 세우고 물소리를 들으며 휴식을 취한다.
			CASE 2
				PRINTFORMDL 「.........」
				PRINTFORMDL 「......」
				;I have no idea if this is supposed to be the sound of Momiji casting a line
				PRINTFORMDL 「...Zzz.」
				PRINTFORMDW 모미지는 노를 저으면서 동시에 낚싯대를 던지고 있다. 그녀는 손재주가 좋은 아이였다.
			CASE 3
				;椛の初期能力は教養1
				PRINTFORML 「아주 옛날에 물고기를 무척 좋아했던 위대한 군사 전략가가 있었다.」
				PRINTFORMW 「이렇게 낚싯줄을 던진다면, 좋은 장기 수를 생각해 낼 수 있을 거라고 확신해. 후후～」
		ENDSELECT
		;椛が釣った
	ELSEIF TFLAG:194 >= 1000
		SELECTCASE TFLAG:193
			;木材
			CASE 610
				PRINTFORMW 「음... 이걸 잘 다룰 수 있을 거라고 생각했는데...」
				;守矢の守札
			CASE 131
				PRINTFORML 「모리야 신사의 수호자 태그인 것 같아...」
				SELECTCASE RAND:3 ;custom code
					CASE 0
						PRINTFORMW 「...근데 왜 여기에 있는 거지?」
					CASE 1
						PRINTFORML 「몇 개나 모으면 복불복을 할 수 있다고 들었어...」
						PRINTFORMW 「%CALLNAME:MASTER%-씨는 그런 적 있어?」
					CASE 2
						PRINTFORML 「한 번에 3000엔이라니...」
						PRINTFORMDW 모미지는 먼 곳을 바라보며 중얼거린다.
				ENDSELECT
				;ローター
			CASE 21
				PRINTFORML 「이건 뭐야, 이 분홍색...」
				PRINTFORML 「뭐야?!~~!!」
				PRINTFORMDL 모미지는 얼굴을 새빨게 물리고 로터를 던져버린다.
				PRINTFORMDW ...귀한 자원의 낭비이니 조용히 그것을 집어든다.
				;素材
			CASE 609,606
				PRINTFORMW 「와, 아름다운 걸 잡았어!」
				;その他の魚
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「뭔가 잡았어! 바로 여기 있어!」
					CASE 1
						PRINTFORMW 「아하~ 해냈어!」
					CASE 2
						PRINTFORMW 「나에게서 벗어날 수 있을 거라고 생각하지 마라!」
				ENDSELECT
		ENDSELECT
		;あなたが釣った
	ELSE
		SELECTCASE TFLAG:193
			;木材
			CASE 610
				PRINTFORMW 「아하하... 그런 때도 있는 거지. 그렇지?」
				;守矢の守札
			CASE 131
				PRINTFORML 「모리야 신사의 수호자 태그인 것 같다...」
				SELECTCASE RAND:3 ;custom code
					CASE 0
						PRINTFORMW 「...근데 왜 여기에 있는 거지?」
					CASE 1
						PRINTFORML 「몇 개나 모으면 복불복을 할 수 있다고 들었어...」
						PRINTFORMW 「%CALLNAME:MASTER%-씨는 그런 적 있어?」
					CASE 2
						PRINTFORMW 「...그 복권에 걸렸던 테누가 있었다고 들었어..」
				ENDSELECT
				;ローター
			CASE 21
				PRINTFORML 「뭘 잡았어? 보여줘...!」
				PRINTFORMDW 모미지는 당신의 손바닥에 있는 타원형 공을 보면 얼굴이 새빨개지며 시선을 돌린다.
				;素材
			CASE 609,606
				PRINTFORML 「와, 거기서 아름다운 것을 잡았네...」
				PRINTFORMW 「이게 무슨 용도로 쓸 수 있을지 궁금하네...」
				;その他の魚
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「와아~ ... 해냈어! %CALLNAME:MASTER%-씨!」
					CASE 1
						PRINTFORMW 「잘했어, %CALLNAME:MASTER%-씨!」
					CASE 2
						PRINTFORML 「오~ 멋진 물고기다!」
						PRINTFORMW 「먹을 거라면, 신선할 때 요리하는 게 어때? 내가 술 가져올게!」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
