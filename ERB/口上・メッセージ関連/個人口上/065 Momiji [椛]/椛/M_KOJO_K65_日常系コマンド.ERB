				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「음... 후아... %CALLNAME:MASTER%씨... %RANDKISS("kiss")%...」
					CASE 1
						PRINTFORMW 「음... 추루... 하아...」
						IF TALENT:恋慕 && RAND:2 == 0
							PRINTFORMW 「나는 %CALLNAME:MASTER%님에게 키스하는 것을 사랑해... %RANDKISS("kiss")%...」
						ELSE
							PRINTFORMW 「키스하는 %CALLNAME:MASTER%-산은 정말 기분 좋아... %RANDKISS("kiss")%...」
						ENDIF
				ENDSELECT
			ENDIF
			;35=スカートの中を見せる
