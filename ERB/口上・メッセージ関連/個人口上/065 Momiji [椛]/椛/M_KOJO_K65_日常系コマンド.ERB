@M_KOJO_MESSAGE_COM_K65_352_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMDL 당신은 마음을 열어 %조사처리(CALLNAME:TARGET,"에게")% 감정을 표현한다.
	PRINTFORML 
	IF TFLAG:193 == 1
		IF TALENT:恋慕
			PRINTFORMW 「...Eh?」
			PRINTFORML
			PRINTFORML 「음, 어, 그게, 저 음...」
			CALL ASK_YN("네가 그녀를 좋아한다고 말해라","그녀를 사랑한다고 말해라")
			PRINTFORML 
			PRINTFORMW 「.........」
			PRINTFORML
			PRINTFORMDL 충격에 빠진 모미지의 크게 뜬 눈에서 한 줄기 눈물이 흘러내렸다.
			PRINTFORMW 「어, 아하, 흠... 왜 그래, %CALLNAME:MASTER%-씨, 잠시만, 미안해...」
			PRINTFORML 
			PRINTFORMDL ...그녀의 마음을 아프게 한 거야...?
			PRINTFORMDL 당신이 거리를 두려고 하자, 모미지가 당신을 꼭 안는다.
			PRINTFORMW 「싫어, 가지 마...!!」
			PRINTFORML
			PRINTFORML 「%CALLNAME:MASTER%-상, 저도 당신을 좋아해요!!
			PRINTFORMW 　정말 많이 좋아해요!! 사랑해요옷!!」
			PRINTFORML 
			PRINTFORMDL 모미지는 거의 고백을 외치듯 하고, 그것이 공기 중에 울린다.
			PRINTFORMDW %BREAKENG(@"어느 정도 떨어진 곳에서, \@ OUTROOF(CFLAG:現在位置) ? 하늘을 날던 텐구가 공중에서 멈추거나 # 길을 지나가던 텐구가 발걸음을 멈춘다 \@ 그리고 두 사람에게 놀란 표정을 지어준다.")%
			PRINTFORML 
			;他に恋慕キャラがいる
			IF CMATCH(TALENT:恋慕,1)+CMATCH(TALENT:恋慕,2)-1 > 0
				PRINTFORML 「나 말고 너를 좋아하는 다른 사람들도 많이 있어, %CALLNAME:MASTER%씨.」
			ELSE
				PRINTFORML 「...나는 천이지만, 별로 중요하지 않아, 오히려 가장 밑바닥이지...」
			ENDIF
			PRINTFORMW 「...그래도 나를 선택해 줄 거야?」
			PRINTFORML
			PRINTFORMDL 모미지가 불안하게 당신을 바라보는 가운데, 당신은 그녀의 뺨에 손을 대고 부드럽게 입 맞춘다.
			PRINTFORML 「음...!!」
			PRINTFORMW 「...응, 하아... 믿을 수가 없어... 꿈만 같아... 정말 행복해, %CALLNAME:MASTER%-상...!」
			PRINTFORML 
			PRINTFORMDL 모미지가 눈에서 흐르는 눈물을 닦는 순간, 환호성이 터져 나왔다.
			PRINTFORML 「에? ...응? 아아?! 카에데 씨? 츠바키 씨? 아... 히이라기 씨도?!」
			PRINTFORMDW 정신을 차려보니 당신과 모미지는 온갖 텐구들에게 둘러싸여 있었다.
			PRINTFORML
			PRINTFORMDL 목소리 하나가 모미지를 축하하며 "잘 됐다!"라고 말한다.
			PRINTFORMDL 강한 손이 당신의 등을 툭 치며, 엄격한 어조로 "그녀를 행복하게 해라"고 말한다.
			PRINTFORMDL %BREAKENG(@"두 사람이 공개적인 의식을 치러야 할지 아니면 텐구 의식을 해야 할지에 대해 활기찬 논쟁이 벌어지고, 그 외의 중요하지 않은 문제들도 있었다.")%
			PRINTFORMDW 결국 누군가 갑자기 나타난 사케 통에 나무 망치를 내리쳤고, 소란에 우렁찬 '쾅' 소리를 더했다.
			PRINTFORML  
			PRINTFORML 「아, 아하하... 정말 축제 같은 기분인데, 좀 과하다...」
			PRINTFORMDW 귀빈들 없이 파티를 시작한 텐구들을 흘겨보며, 당신과 모미지는 조용히 그 자리를 떠난다...
			PRINTFORML 
			PRINTFORML 「왠지, 무시당하는 기분이 들었어.」
			PRINTFORML 「나... 정말 행복해. 당신과 함께라면, %CALLNAME:MASTER%-상, 분명 더 행복할 거야.」
			PRINTFORMW 「...아니야, 우리 모두 행복해야 해! 함께!」
		ELSE
			PRINTFORMW 「...Eh?」
			PRINTFORML
			PRINTFORML 「에, 아하하...」
			PRINTFORMDL 모미지의 표정이 충격으로 굳고 말을 더듬는다.
			PRINTFORMDW 그녀는 내면의 소용돌이치는 감정들을 정리하는 데 어려움을 겪는 듯하다...
			PRINTFORML
			PRINTFORML 「아, 음... 정말 기뻐!!」
			PRINTFORMW 「미안해, 그게 그냥, 음.... 이게 꿈이 아니라는 걸 아직 믿기 힘드네...」
			PRINTFORML
			PRINTFORMDL 모미지가 불안하게 당신을 바라보는 가운데, 당신은 그녀의 뺨에 손을 대고 부드럽게 키스했다.
			PRINTFORMW 「음...!」
			PRINTFORML
			PRINTFORML 「음, 후우... 에헤헤. 나도... 당신을 좋아해요, %CALLNAME:MASTER%-상.」
			PRINTFORMW 「후후, 계속 잘 대해줘야 할 거예요, %CALLNAME:MASTER%-상♪」
		ENDIF
	ELSE
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 너에게 회의적인 시선을 준다.
		PRINTFORML
	ENDIF
ENDIF
RETURN 1
