						CASE 1
							PRINTFORML 「아... %CALLNAME:MASTER%님의 주스가 내 가슴을 미끄럽게 만들고 있어...」
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%-님의 향기에 얼룩이 지면 어떡하지... HPH」","W"
					ENDSELECT
				ENDIF
			ELSE
				;手抜き、なんだ。すまないね。
				IF TALENT:バストサイズ > 0
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「하아, 음, 으음... %CALLNAME:MASTER%씨, 기분 좋아...?」
						CASE 1
							CALL HPH_PRINT,@"「후아, 음... %CALLNAME:MASTER%-상의 거기가 다 떨리고 있네...」","L"
							PRINTFORMW 「음... 내 가슴이 이상해지기 시작했어...」
					ENDSELECT
				ELSEIF TALENT:バストサイズ < 0
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「하아, 음, 으음... %CALLNAME:MASTER%씨, 기분 좋아...?」
						CASE 1
							CALL HPH_PRINT,@"「후아, 음... %CALLNAME:MASTER%-상의 거기가 다 떨리고 있네...」","L"
							PRINTFORMW 「음... 내 가슴이 이상해지기 시작했어...」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「하아, 음, 으음... %CALLNAME:MASTER%씨, 기분 좋아...?」
						CASE 1
							CALL HPH_PRINT,@"「후아, 음... %CALLNAME:MASTER%-상의 거기가 다 떨리고 있네...」","L"
							PRINTFORMW 「음... 내 가슴이 이상해지기 시작했어...」
					ENDSELECT
				ENDIF
			ENDIF
			;60=ディープキス
		CASE 60
			IF TCVAR:発情
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH %RANDKISS("kiss")%HPH 추우프니무프」","L"
						PRINTFORMDL 모미지가 작은 혀를 네 입속에 넣으며 숨을 내쉰다.
						PRINTFORMDW 너희 혀끝이 서로 얽히고 상대방의 입안을 침범한다...
					CASE 1
						CALL HPH_PRINT,@"「음...후후 후우, 핥아줘 후후 후우 %RANDKISS("kiss")%...」","L"
						PRINTFORMDW 모미지가 당신을 붙잡고 있는 동안, 그녀는 당신의 입안을 철저히 핥았다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「음... %RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%...후우, %TOLOWER(RANDKISS("kiss"))%...」
						PRINTFORMW 「하아... %CALLNAME:MASTER%-씨... 더... 음, 후우... %RANDKISS("kiss")%～...」
					CASE 1
						PRINTFORML 「음... 후우... 음, %TOLOWER(RANDKISS("kiss"))%... %RANDKISS("kiss")%, %TOLOWER(RANDKISS("kiss"))%, %TOLOWER(RANDKISS("kiss"))%...」
						PRINTFORML 「헤이... %CALLNAME:MASTER%-상, 침 좀 더 줘, 응... 츄, %TOLOWER(RANDKISS("kiss"))%...」
						PRINTFORMDW 모미지가 너를 제압하며 입안을 철저하게 핥았다.
				ENDSELECT
			ENDIF
			;73=ぱふぱふ
			;CASE 73
			;まだ
			;77=乳を吸わせる
			;CASE 77
			;まだ
			;85=Ｖ挿入する
			;87=Ａ挿入する
			;88=腰振りＶ
			;89=腰振りＡ
		CASE 85, 87 TO 89
			IF TCVAR:発情
				;射精直前に挿入
				IF NOWEX:MASTER:射精
					CALL HPH_PRINT,@"「아...흐응. 당신의 거시기(cock)가 꿈틀거리고 있어... 곧 사정할 거야...?」","L"
					CALL HPH_PRINT,@"「하아핫 좋아... 내 배 속에서 네가 절정에 이르도록 해줄게...핫」","L"
					PRINTFORMDW %BREAKENG(@"네가 절정에 이를 것임을 눈치채고, 모미지는 네 격렬한 성기를 그녀의 \@ TEQUIP:Ｖセックス != -1 ? 보지 # 입술을 깨물어 \@ 안으로 밀어 넣고 골반을 움직여 너를 결승선까지 몰아붙인다...")%
					;MASTERが何度も射精
				ELSEIF TCVAR:350 > 3 && RAND:2 == 0
					CALL HPH_PRINT,@"「하아~ 하프 아직도 이렇게 단단해질 수 있다니 믿을 수가 없어... 하프」","L"
					PRINTFORMW 「%CALLNAME:MASTER%-씨, 정말 최고예요...」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「후우...흐으응 흐으응 아아앙」","L"
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%-씨의 거시기, 정말 좋다...HPH %MOAN()%～HPH」","W"
						CASE 1
							CALL HPH_PRINT,@"「하아, 음음... 후우안~...흐읍」","L"
							CALL HPH_PRINT,@"「아... 으윽, 내 허리가 멈추질 않아... 아앙흐프」","L"
							PRINTFORMDW 모미지는 발정으로 정신을 잃고 고개를 흔들며 당신의 'meat stick'를 애원한다...
						CASE 2
							PRINTFORML 「...나에게 맡긴다고?」
							CALL HPH_PRINT,@"「에헤, 좋아... 그럼 내가 마음대로 너를 탐할게, %CALLNAME:MASTER%-상...흐흣」","W"
					ENDSELECT
				ENDIF
			ELSE
				;MASTERが何度も射精
				IF TCVAR:350 > 3 && RAND:2 == 0
					PRINTFORML 「%CALLNAME:MASTER%-상... 제 배 속이 점점 더 기분 좋아지도록 만들어 주세요...」
				ELSE
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「후우~... 음, 아아항」","L"
							PRINTFORML 「%CALLNAME:MASTER%-상, 내 배가... 음음... 기분 좋아...?」
							PRINTFORMDW 모미지는 당신의 시선을 바라보며 당신의 성기에 골반을 움직인다...
						CASE 1
							PRINTFORML 「걱정 마, 계속 나아가. 내가 처리할 테니까...」
							PRINTFORMW 「많이 움직여 봐, 기분 좋게 만들어 줄게, %CALLNAME:MASTER%씨...」
					ENDSELECT
				ENDIF
			ENDIF
			;86=だいしゅきホールド
		CASE 86
			IF TCVAR:発情
				CALL HPH_PRINT,@"「나에게 와줘... HPH 제발, 내 가장 깊고 조이는 곳까지 전부 채워줘야 해... HPH」","W"
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%-산... 거기서, 내 배 속에서 해줘...!」
			ENDIF
		CASEELSE
			IF TCVAR:発情
				IF BASE:MASTER:気力 <= 0
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「아하, 너무 지쳐서 움직일 수가 있는 건가...?」
							CALL HPH_PRINT,@"「에헤헤... 그럼 움직일 수 없는 바보 같은 %CALLNAME:MASTER%-씨를 공격해 주지...후후」","W"
						CASE 1
							PRINTFORML 「아하, 지쳤나 보네...」
							CALL HPH_PRINT,@"「걱정 마, 내가 마음껏 너를 범해 줄게, %CALLNAME:MASTER%-상...HPH」","W"
					ENDSELECT
				ELSE
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%-씨, 더...HPH」","W"
				ENDIF
			ELSE
				IF BASE:MASTER:気力 <= 0
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「아하, 너무 지쳐서 움직일 수가 없구나...?」
							PRINTFORMW 「후후, 괜찮아. 내가 돌봐줄게...」
						CASE 1
							PRINTFORML 「피곤하다면 움직일 필요 없어...」
							PRINTFORMW 「기분 좋게 해줄게, %CALLNAME:MASTER%-상...」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「%CALLNAME:MASTER%-씨, 기분 좋아...?」
						CASE 1
							PRINTFORMW 「%CALLNAME:MASTER%-씨... 너무 많이 움직이지 마요...」
					ENDSELECT
				ENDIF
			ENDIF
	ENDSELECT
	;恋慕、思慕などで口上を変化させたい場合は↓のコメントアウトを外してください。
	;ENDIF
ENDIF
RETURN 1
