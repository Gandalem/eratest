@M_KOJO_MESSAGE_COM_K65_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:ブチギレ > 0
		PRINTFORML 「...고마워.」
