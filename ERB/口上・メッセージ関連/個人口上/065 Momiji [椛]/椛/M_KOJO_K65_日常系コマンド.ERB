; Modular ERB: 個人口上/065 Momiji [椛]/椛/M_KOJO_K65_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K65_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K65_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:ブチギレ > 0 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「...」
		PRINTFORML 「그런가 보군.」
		PRINTFORMDW 모미지는 얼굴을 돌렸다.
		;荒天かつ屋外
		;この分岐が活きるタイミングってほぼほぼないんじゃなかろうか
	ELSEIF GROUPMATCH(TIME:5,5,9,13) && OUTROOF(CFLAG:MASTER:現在位置)
		PRINTFORMW 「이런 날 밖에 나와서 나랑 얘기할 필요 없어!」
		;発情
	ELSEIF TCVAR:発情
		IF CFLAG:既成事実 & 合意_うふふ
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「에, 글쎄...」
					PRINTFORMDW 모미지가 당신을 향해 돌아섰고, 그녀의 눈빛은 무언가를 원하고 있음을 말해주었다.
				CASE 1
					PRINTFORML 「... 아-... 뭐, 뭐라고 했지?」
					PRINTFORMDL 모미지는 네 이야기를 멍하니 듣는다...
					PRINTFORMDW ...가끔 그녀가 네 사타구니 쪽을 흘겨보는 것 같다. 그저 상상일지도 모른다.
			ENDSELECT
			;ELSEIF CFLAG:65:好感度 >= 1500
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「음...」
					PRINTFORMDW 모미지는 꽤 괴로워 보인다...
				CASE 1
					PRINTFORML 「... 아-... 뭐, 뭐라고 했지?」
					PRINTFORMDW 모미지는 당신의 이야기를 멍하니 듣는다...
			ENDSELECT
		ENDIF
		;添い寝中
		;ELSEIF CFLAG:添い寝中
		;デート中
		;大成功
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「그래서 그런 거였구나...」
				PRINTFORMDW 모미지의 꼬리가 대화에 즐거워하며 앞뒤로 흔들린다.
			CASE 1
				PRINTFORML 「아하하하♪」
				PRINTFORMW 「그 농담, 다음엔 내가 써도 돼?」
		ENDSELECT
		;会話累積値が閾値を超えての失敗
	ELSEIF TCVAR:302
		PRINTFORML 「...오우 와 정말 그래?」
		PRINTFORMDW 엄마지(Momiji)는 같은 농담을 너무 많이 들으니 지루해지기 시작한다...
		;失敗
	ELSEIF TFLAG:193 < 0
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「아하하.」
				PRINTFORMDW 모미지는 형식적으로 웃는다.
			CASE 1
				PRINTFORML 「...아, 어, 음...」
				PRINTFORMDW 모미지가 화제를 찾으려고 노력하고 있다...
		ENDSELECT
		;お仕事中 (1/2で普通のトークへ逃がす)
	ELSEIF CFLAG:行動 == 5 && RAND:2 == 0 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		;おなかたぷたぷ
		IF EX:膣内精液 + EX:アナル内精液 >= 100
			CALL PRINT_IMAGE("65_精液垂れ0")
			CALL PRINT_IMAGE("65_精液垂れ1")
			CALL PRINT_IMAGE_ANIMATION("65_精液垂れ",2,3,1,0)
			CALL PRINT_IMAGE("65_精液垂れ5")
			WAIT
			;自覚あり
			IF TCVAR:350
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML (내 배 안에... 아직 뜨거워...)
						PRINTFORMDW ...모미지는 어쩔 줄 모르는 듯 그 자리에 서 있었다.
					CASE 1
						PRINTFORML (평소보다 사람들이 나를 보는 시선이 더 걱정돼...)
						PRINTFORMDL 모미지는 자신의 내부에 부어진 정액의 냄새가 분명히 걱정된다.
						PRINTFORMDW 그녀는 당신과 이야기하는 동안 계속 주위를 두리번거린다...
					CASE 2
						PRINTFORML 「...정말 최악이야. 나 오늘 일해야 했는데...」
						PRINTFORMDL 모미지가 당신을 향해 원망 가득한 시선을 보낸다.
						PRINTFORMDW ...당신이 그녀에게 눈짓하자, 그녀는 얼굴을 붉히며 시선을 돌린다.
				ENDSELECT
				;自覚なし
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「...」
						PRINTFORMDW 모미지는 주변을 매우 경계하는 것 같다...
					CASE 1
						PRINTFORML 「...평소보다 더 격렬하신 건가요...? 저에게요, 나리?」
						PRINTFORMW 「...죄송해요, 그게... 음... 저를 괴롭히는 무언가가 있어서...」
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「오늘도 이상한 일은 없군...」
				CASE 1
					PRINTFORML 「순찰 돌 때 솔직히 할 게 별로 없네요.」
					PRINTFORMW 「이런 시간에 이야기 나눌 사람이 있다는 건 감사한 일이에요.」
				CASE 2
					PRINTFORML 「순찰 중에 테레노시스로 보지 말아야 할 것들을 본 적이 있나...?」
					PRINTFORMW 「아, 아뇨! 아니에요!」
				CASE 3
					PRINTFORMW 「사실 말하자면, 악한 의도를 가지고 산에 오는 사람은 아주 드물다…」
				CASE 4
					PRINTFORMW 「%CALLNAME:MASTER%-씨, 등산 좋아해요?」
			ENDSELECT
		ENDIF
		;RANDで並列にする普通のトーク
		;5.お酒が入っていい気分トーク
	ELSEIF BASE:酒気 >= 400 && RAND:5 == 0
		IF CFLAG:既成事実 & 合意_うふふ && EXP:精液経験 >= 20 && RAND:2
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, 그건 그렇고, 예전에 퇴근하고 술자리에서 당신 이름이 나왔었어...」
					PRINTFORMW 「...Ah.」
					PRINTFORML 「......」
					PRINTFORML 「음... 내 동료 백호 테누가 너에게 아무런 문제도 일으키지 않았기를 바라! 아하하...」
					PRINTFORMDL 모미지는 다소 어색하게 미소 짓는다.
					PRINTFORMDW ...어쨌든 그들이 너에 대해 뭐라고 말하고 있었던 거지...
				CASE 1
					PRINTFORML 「후우, 나 좀 취한 것 같아...」
					PRINTFORML 「너랑 함께 있으면, %CALLNAME:MASTER%-씨, 긴장이 풀리는 걸 어쩔 수가 없어...」
					IF TALENT:恋人 && RAND:2
						PRINTFORMDW 그녀도 자신만의 방식으로 힘든 시간을 보내고 있겠지... 당신은 부드럽게 그녀의 머리를 쓰다듬는다.
						CALL HPH_PRINT,@"「음, 음... 후우... 후후. 기분 좋다...」","L"
						PRINTFORMW 「좀 더 나를 망쳐도 괜찮지...??」
					ELSE
						PRINTFORMDW 모미지는 상기된 뺨으로 당신을 향해 환하게 미소 지었다.
					ENDIF
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「후후, 기분이 상당히 좋아지기 시작했어...」
					PRINTFORMDW 술에 살짝 취해 얼굴이 붉어졌지만, 모미지는 분명 좋은 기분이다.
				CASE 1
					;晴れた夜
					IF GROUPMATCH(TIME:5,0,1) && TIME:2 >= 5 && TIME:2 <= 7
						PRINTFORMW 「달을 보기엔 상쾌한 밤이지, 그렇지 않아?」
					ELSEIF GROUPMATCH(TIME:5,8,10,11)
						PRINTFORMW 「음, 눈을 보면서 술 마시니 좋네...」
					ELSE
						PRINTFORMW 「당신과 이야기하면서 술을 마시니 좋네요, %CALLNAME:MASTER%-상...」
					ENDIF
			ENDSELECT
		ENDIF
		;4.お天気トーク
	ELSEIF RAND:4 == 0
		SELECTCASE TIME:5
			;晴れ,快晴
			CASE 0,1
				SELECTCASE RAND:2
					CASE 0
						IF TIME:2 >= 5 && TIME:2 <= 7
							PRINTFORMW 「별이 빛나는 하늘을 올려다보는 것이 좋아...」
						ELSE
							PRINTFORMW 「날씨가 좋을 때 기분이 좋네...」
						ENDIF
					CASE 1
						PRINTFORML 「후아...」
						PRINTFORMDL 모미지는 입을 틀어막고 귀여운 하품을 했다.
						PRINTFORMW 「아, 미안해, 날씨가 좋을 때 그렇게 해버리곤 해서.」
				ENDSELECT
				;薄曇り
			CASE 2
				IF TIME:2 >= 5 && TIME:2 <= 7
					PRINTFORMW 「달이 구름 바다에 떠 있어, 정말 좋다...」
					SIF CFLAG:2 >= 1000
						PRINTFORMW 「이게 달을 감상하기에 완벽한 순간이 아닐까?」
				ELSE
					PRINTFORMW 「날씨가 좀 흐렇네...」
				ENDIF
				;曇り
			CASE 3
				SELECTCASE RAND:2
					CASE 0
						IF TIME:2 >= 5 && TIME:2 <= 7
							PRINTFORMW 「이 구름들 때문에 밤하늘을 볼 수가 없어...」
						ELSE
							PRINTFORMW 「이 흐린 날씨는 정말 따분하군...」
						ENDIF
					CASE 1
						PRINTFORML 「비가 오지 않았으면 좋겠어...」
						PRINTFORMDW 모미지는 흐린 하늘을 올려다봤다.
				ENDSELECT
				;雨、大雨、霧雨
			CASE 4,5,6
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「비가 상당히 많이 오네...」
					CASE 1
						PRINTFORMW 「비가 오네, 밖에 나가는 게 귀찮겠어...」
					CASE 2
						IF DAY:5 == 5
							PRINTFORMW 「정말이지, 이 비는 뒤집어진 빨래통 같아...」
						ELSE
							PRINTFORMW 「이 습기 때문에 내 꼬리가 풍성해지겠어...」
						ENDIF
				ENDSELECT
				;霧
			CASE 7
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「이 안개는 상당히 짙다.」
						PRINTFORMW 「발 디딜 곳을 조심해 주세요, %CALLNAME:MASTER%-씨.」
					CASE 1
						PRINTFORML 「나? 이 정도 안개는 문제없어.」
						PRINTFORML 「백설의 텐구의 텔레그노시스는 보여주기 위한 게 아니야!」
						PRINTFORMD 모미지가 부풀린다 
						SIF TALENT:バストサイズ > 0
							PRINTFORMD 불균형적으로 큰 가슴
						SIF TALENT:バストサイズ < 0
							PRINTFORMD 어울리는 크기의 가슴
						SIF TALENT:バストサイズ == 0
							PRINTFORMD 비교적 큰 가슴
						PRINTFORMDW  자존심 속에서.
				ENDSELECT
				;雪、細雪、霧雪
			CASE 8,10,11
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「눈이 올 때마다 심장이 뛰는 것을 느껴요!」
						PRINTFORMW 「…왜 그런지 모르겠어요?」
					CASE 1
						PRINTFORML 「이 속도라면 눈을 엄청나게 치워야 할 것 같아!」
						PRINTFORMDW 모미지가 어쩐지 빛난다...
				ENDSELECT
				;吹雪
			CASE 9
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「눈이 올 때마다 심장이 뛰는 것을 느껴요!」
						PRINTFORMW 「…왜 그런지 모르겠어요?」
					CASE 1
						PRINTFORML 「눈보라네...」
						PRINTFORMW 「아무도 길을 잃지 않았으면 좋겠어!」
				ENDSELECT
				;みぞれ
			CASE 12
				PRINTFORML 「눈이 비랑 섞였네, 응.」
				PRINTFORMW 「Can't it just turn to snow for a moment...」
				;あられ
			CASE 13
				PRINTFORML 「우와아, 우박이 내리고 있어...」
				PRINTFORMW 「Do not go outside now, okay?」
		ENDSELECT
		;3.季節トーク
	ELSEIF RAND:3 == 0
		SELECTCASE DAY:2
			;春
			CASE 1
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「봄이 오면 산을 따라 다양한 꽃들이 피기 시작한다.」
						PRINTFORML 「같은 종류의 꽃이라도 위치에 따라 다른 시기에 피어난다.」
						PRINTFORMW 「순찰하는 동안 즐길 만한 것이다.」
					CASE 1
						PRINTFORMW 「날씨가 덥지도 않고 춥지도 않을 때 좋네요.」
				ENDSELECT
				;夏
			CASE 2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「때로는 산 아래의 카파가 우리에게 오이를 준다.」
						PRINTFORMW 「산에서 시원해진 그 오이들은 일품이다.」
					CASE 1
						PRINTFORML 「덥네...」
						PRINTFORMDW 모미지의 꼬리가 축 늘어져 있다.
				ENDSELECT
				;秋
			CASE 3
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「산이 붉고 주황빛으로 물들면서, 점점 가을처럼 느껴진다.」
						PRINTFORMW 「순찰하면서 풍경을 둘러보는 건... 내가 하는 행동이 아니야! 절대로 안 해!」
					CASE 1
						PRINTFORML 「가을이 좋다. 조용하고 좋고 무엇보다 음식이 맛있다.」
						PRINTFORMW 「후후, 오늘 저녁 반찬은 뭘로 만들어야 할까...」
				ENDSELECT
				;冬
			CASE 4
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「순찰하는 데 익숙해졌지만, 추위는 별로 안 좋아...」
					CASE 1
						PRINTFORMW 「이렇게 건조하면 내 꼬리에 정전기가 쌓여...」
				ENDSELECT
		ENDSELECT
		;2.親密トーク
	ELSEIF RAND:2 == 0 && CFLAG:2 >=1000
		SELECTCASE RAND:5
			CASE 0
				IF BASE:MASTER:TSP >= 1000
					PRINTFORML 「그건 그렇고, 당신이 순간 이동하는 걸 본 것 같은데, 혹시...?」
					PRINTFORML 「어떤 특별한 기교인가요?」
					PRINTFORMDW ...이렇게 많은 질문을 받으니 적절한 거짓말을 생각해 내기가 어렵다.
				ELSE
					PRINTFORMW 「솔직히 이 모든 순찰을 돌다 보니 다른 일 할 시간이 별로 없네...」
				ENDIF
			CASE 1
				PRINTFORML 「솔직히 이 모든 순찰을 돌다 보니 다른 일 할 시간이 거의 없네...」
				PRINTFORMW 「가끔 나랑 더 이야기해 줄 수 있어?」
			CASE 2
				PRINTFORML 「아야 씨? 음... 뭐... 어...」
				PRINTFORMDW 모미지는 명확한 대답을 하지 않는다.
			CASE 3
				PRINTFORML 「니토리 씨? 네, 저희는 아주 잘 지내요.」
				PRINTFORMW 「비록 가끔 저는 어떻게든 터무니없는 발명품 테스트에 휘말리곤 하지만...」
			CASE 4
				PRINTFORML 「하타테 씨? 음, 뭐라고 해야 할지...」
				PRINTFORMDW 모미지는 명확한 대답을 하지 않는다.
		ENDSELECT
		;1.通常トーク
	ELSE
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「아! 잠시만요.」
				PRINTFORMDL 모미지가 공책을 꺼내 미친 듯이 무언가를 쓰기 시작한다.
				PRINTFORMW 「음, 쇼기를 위한 새로운 규칙을 생각해냈어요.」
			CASE 1
				PRINTFORML 「카파는 종종 장기를 두었다.」
				PRINTFORMW 「재미를 연장하기 위해 몇 가지 특별한 규칙이 만들어졌다.」
			CASE 2
				PRINTFORMW 「좋은 코와 텔레노시스 둘 다 순찰에 도움이 되니까, 하얀 늑대 텐구에게 딱 어울리는 것 같아.」
			CASE 3
				PRINTFORMW 「나는 텐구다! 다른 요괴들과 비교해서 먼지에 남지 않을 것이다!」
			CASE 4
				PRINTFORMW 「최근에 이곳에서는 아무런 사건도 없었고, 꽤 평화롭다.」
			CASE 5
				PRINTFORMW 「아까 산에서 큰 사고가 있었어...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
