			ENDIF
			;53=パイズリ
		CASE 53
			IF TCVAR:発情
				IF TALENT:バストサイズ > 0
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「아하... HPH %CALLNAME:MASTER%-씨, 나를 기분 좋게 만드는 데 능하시네... HPH」","L"
							CALL HPH_PRINT,@"「그럼, 나도 보답으로 당신을 더 기분 좋게 해 줄게요... HPH」","L"
							PRINTFORMDW 모미지가 미소 지으며 자신의 티티퍽 속도를 높인다...
						CASE 1
							CALL HPH_PRINT,@"「에헤헤... 내 가슴으로 네 거를 난장판으로 만들어 줄 테니까 움직이지 마...큭」","W"
						CASE 2
							PRINTFORML 「아... %CALLNAME:MASTER%-상의 액체들이 내 가슴을 너무 미끌미끌하게 만들고 있어...」
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%-님의 향기에 얼룩이 지면 어떡하지... HPH」","W"
					ENDSELECT
				ELSEIF TALENT:バストサイズ < 0
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「아하... 정말 나랑 그런 걸 하고 싶어 하는구나, 기쁘네... HPH」","L"
							PRINTFORML 「혹시, %CALLNAME:MASTER%-씨는 가슴이 작은 어린 여자애들을 좋아해요?」
						CASE 1
							CALL HPH_PRINT,@"「후우, 음...흐응 이렇게 가슴을 쥐면 네 뜨거운 거랑 부딪혀...」","L"
							CALL HPH_PRINT,@"「나도 기분이 좋아져... 하아헵 음므응...헵」","W"
							PRINTFORMDW 모미지는 순진한 얼굴에 욕망스러운 기색을 띠고 위를 올려다본다...
						CASE 2
							PRINTFORML 「아... %CALLNAME:MASTER%님의 주스가 내 가슴을 미끄럽게 만들고 있어...」
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%-님의 향기에 얼룩이 지면 어떡하지... HPH」","W"
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「후우, 음...흐응 이렇게 가슴을 쥐면 네 뜨거운 거랑 부딪혀...」","L"
