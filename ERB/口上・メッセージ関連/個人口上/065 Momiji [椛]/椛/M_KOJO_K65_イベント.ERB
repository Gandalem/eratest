@M_KOJO_EVENT_K65_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORMDL
		IF TCVAR:発情
			PRINTFORML 「하아ー... 하아ー... 우우～...」
			PRINTFORMDL 숨을 헐떡이며 모미지는 당신의 가슴에 기대어 볼을 들고 쓰러졌다.
			PRINTFORMDW 그녀의 몸은 여전히 욕망으로 불타고 있지만, 평소의 기운이 없어 보인다...
		ELSE
			PRINTFORML 「음... 제가 먼저 말을 걸었다가 이런 말을 하게 되니 좀 무례할지도 모르겠네요...」
			PRINTFORMW 「그냥... 조금 피곤해서요...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		PRINTFORMDL
		IF TCVAR:発情
			PRINTFORML 「하아... 하아... 그게 기분 좋았어...」
			PRINTFORML 「...다시 할까?」
			PRINTFORMDL 모미지가 미소를 지으며 뺨에 보조개를 만든다.
			PRINTFORMDW ...과연, 네 낮은 뇌로부터 어떤 거부감도 없는 것 같았다.
		ELSE
			PRINTFORML 「푸아아...」
			PRINTFORM 「...아앗!! 죄송해요! 정말 죄송해요!! 무슨 생각이 들었는지 모르겠어요...」
			SIF ABL:欲望 > 3
				PRINTFORM  하지만... 다시 하고 싶어...?
			PRINTFORMW 」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORMDL
		IF TCVAR:発情
			PRINTFORML 「갸아...?!」
			PRINTFORMDL 모미지는 갑작스러운 이벤트에 놀랐지만, 침착함을 되찾고 아무 문제 없다고 안심시키듯 미소 짓는다.
			PRINTFORML 「그 모든 일 끝에, 아직 만족하지 못했어...?」
			CALL HPH_PRINT,@"「...맹세컨대. %CALLNAME:MASTER%-씨, 당신은 야수예요...HPH」", "L"
			PRINTFORMDW 그녀의 눈에서 유혹적인 빛이 번지며 당신에게 향하는 갈망을 소리치고 있었다...
		ELSE
			PRINTFORMDL 엄마지가 만족스러워 보임에도 불구하고 당신은 그녀를 밀어붙인다!
			PRINTFORML 「꺄아...?!」
			PRINTFORMDL 엄마지는 갑작스러운 사건에 놀라움을 감출 수 없었지만, 평정심을 되찾고 괜찮다고 안심시키듯 미소 짓는다.
			PRINTFORML 「그 모든 것 후에, 아직 만족하지 못한 건가...?」
			CALL HPH_PRINT,@"(오~ %CALLNAME:MASTER%-상은 대단해...후훗)", "W"
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORMDL
		IF TCVAR:発情
			PRINTFORML 「에... 아직 계속하고 싶어?」
			PRINTFORMDL Momiji의 눈 속에는 당신을 내려다보는 잔혹한 빛이 머물러 있었다.
			PRINTFORML 「맹세컨대, %CALLNAME:MASTER%-씨는 정말 변태야...」
			PRINTFORML 「알겠다. %CALLNAME:MASTER%-씨의 거시기(dick)가 작동을 멈추고 부서질 때까지,
			CALL HPH_PRINT,@" 모든 것을 짜낼 거야...HPH」", "W"
		ELSE
			PRINTFORML 「어... 아직 더 계속하고 싶어?」
			PRINTFORMDL 모미지의 눈이 놀라움으로 커지며 당신을 내려다본다.
			PRINTFORML 「...정말 그렇게 기분이 좋았어?」
			PRINTFORMDL 당신이 고개를 끄덕이자, 모미지의 뺨은 선명한 분홍빛으로 물든다.
			PRINTFORML 「맹세컨대, 너 정말 변태구나, %CALLNAME:MASTER%-상...」
			PRINTFORMW (어떻게 된 건지, 이게 나를 정말 행복하게 해...)
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
