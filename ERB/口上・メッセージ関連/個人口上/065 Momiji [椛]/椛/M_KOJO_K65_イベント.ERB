@M_KOJO_EVENT_K65_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人 && RAND:2
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「%CALLNAME:MASTER%-상, 저랑 데이트하실래요?」
							PRINTFORML 「있잖아, 내가 가보고 싶은 곳이 있는데...」
							PRINTFORMDW 모미지는 당신의 얼굴을 기대하며 바라보았고, 그녀의 꼬리는 뒤에서 안절부절못하며 앞뒤로 흔들렸다.
						CASE 1
							PRINTFORML 「%CALLNAME:MASTER%-상 %CALLNAME:MASTER%-상! 같이 외출하자～!」
							PRINTFORMW 「그리고, 연인처럼 손잡고 그런 것도 하자...」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「음... %CALLNAME:MASTER%씨, 잠시 나가서 놀래?」
							PRINTFORMDW 모미지는 조금 부끄러워 보이지만, 당신에게 물으면서 꼬리를 흔든다...
						CASE 1
							PRINTFORML 「괜찮다면... 잠시 나랑 같이 있어 줄래?」
							PRINTFORMDW 모미지가 고개를 살짝 기울이고 귀를 쫑긋 세우며 당신을 바라본다...
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人 && RAND:2
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「에헤헤～」
							PRINTFORML 「그럼 가자!」
							PRINTFORMDW 모미지는 즉시 당신의 팔에 매달려 얼굴 표정을 살피며 걸어갔다.
						CASE 1
							PRINTFORML 「정말 고마워요!」
							PRINTFORML 「저희 데이트 정말 기대하고 있을게요, %CALLNAME:MASTER%-상!」
							PRINTFORMDW 모미지가 당신에게 큰 포옹을 해주고 꼬리를 너무 세게 흔들어 마치 날아갈 것만 하는 것 같다...
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「정말 고마워요.」
							PRINTFORML 「음, 그럼 몇 시간 정도 빌릴게요, 아무래도.」
							PRINTFORMDW 모미지는 당신에게 최대한 가까이 걸어오며, 꼬리를 신나게 좌우로 흔든다.
						CASE 1
							PRINTFORML 「후후~ 자, 가자!」
							PRINTFORMDW 모미지는 당신에게 은밀하게 다가오고, 두 사람은 함께 길을 떠난다.
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아, 당신 바쁘시겠네요...」
						PRINTFORML 「다음에 기회가 되면 다시 물어보도록 할게요.」
						PRINTFORMDW 모미지의 꼬리가 슬프게 축 처진다...
					CASE 1
						PRINTFORML 「보인다... 안됐네.」
						PRINTFORMDW 모미지의 얼굴이 바닥을 내려다보며 어두워지고, 심지어 그녀의 늑대 귀마저 실망감에 축 처지는 듯했다.
				ENDSELECT
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:発情
					PRINTFORML 「음... %CALLNAME:MASTER%-씨, 실례가 안 된다면, 아, 뭐라고 해야 할지...」
					PRINTFORML 「얘기하고 싶었던 게 있는데, 잠시 제 방에서 이야기 나누고 싶어요...」
					PRINTFORMDW 볼이 선명한 진홍색으로 물든 채, 모미지는 당신에게 부탁을 조심스럽게 한다...
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%-상, 어, 음...」
					PRINTFORML 「저의 방에 와주실 수 있으신가요?」
					PRINTFORMW 「그게 말이죠... 단둘이 함께 시간을 보내고 싶어서요.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「정-정말 고마워...!」
				PRINTFORML 「음, 그럼 서둘러야겠어... 아무도 우리 같이 들어가는 거 못 보게 빨리...」
				PRINTFORMDW 모미지는 당신의 손을 잡고 빠른 속도로 걸음을 옮겼다...
				SIF TCVAR:発情 && RAND:2
					PRINTFORMDW 어떤 이유에서인지 그녀의 악력이 믿을 수 없을 정도로 강하다...
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「아... 알겠어. 그럼 다음에 봐...」
				PRINTFORMDW 거의 적대적으로 당신에게서 거리를 둔 후, 모미지는 가볍게 고개를 까딱하며 떠난다...
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
