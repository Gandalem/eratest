@M_KOJO_EVENT_K65_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;うふふ==2（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;MASTERを押し倒した（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMDL
			IF TCVAR:発情
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「...정말이지, 인내심이 바닥났어.」
						PRINTFORML 「여기랑 아래가 짜릿하고 가려운 게 느껴진다는 거 알잖아...」
						CALL HPH_PRINT,@"「책임져줘, 제발...」 HPH", "W"
					CASE 1
						CALL HPH_PRINT,@"「흐읍- 흐읍-... %CALLNAME:MASTER%-상...큭」", "L"
						PRINTFORMDL 상상할 수 없는 힘에 의해 그렇게 작은 몸이 눌려 있어, 한 치도 움직일 수가 없다.
						CALL HPH_PRINT,@"「해볼까...? 이봐...HPH」", "L"
						PRINTFORMDL 모미지는 귀여운 고양이 같은 목소리로 당신의 관심을 갈구하지만, 그녀의 강철 같은 시선은 어떤 반대도 용납하지 않는다...
						PRINTFORMDW ...당신에게는 그녀를 거부할 권리가 없는 것 같다.
					CASE 2
						PRINTFORML 「내가 이렇게 너를 밀어붙일 거라고 예상했나?」
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%-씨, 너무 도착적이네...HPH」", "W"
				ENDSELECT
			ELSE
				;IF GROUPMATCH(PREVCOM, 310, 313, 314, 315,316)
				;	PRINTFORML 「%CALLNAME:MASTER%さんはひどい人です」
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「...그게 전부야.」
						PRINTFORML 「여기저기 계속 만지면...」
						PRINTFORMW 「나조차 영원히 견딜 수 없으니까...」
					CASE 1
						PRINTFORML 「우으...」
						PRINTFORML 「그렇게 나를 흥분시키고는 그냥 멈출 수는 없잖아...」
						PRINTFORMW 「%CALLNAME:MASTER%-씨, 잠시 연기 좀 해줄래?」
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERに抱きついた（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMDL
			RETURN 1
		ENDIF
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;-------------------------------------------------
		;抜け出した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMDL
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード満足終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMDL
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード強制終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORMDL
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;好きにして状態から抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMDL
			IF TCVAR:発情
				PRINTFORML 「쳇. 도망치려고 하는 거니, 응~? 그렇지 않아?」
				CALL HPH_PRINT,@"「네가 내 페니스에 박히기 전까지는 용서 못 한다고 말했잖아 %CALLNAME:MASTER%-씨」", "W"
			ELSE
				PRINTFORML 「맹세하건대... 드디어 조금 겁을 먹는 건가?」
				CALL HPH_PRINT,@"「소용없어. 네 행동을 완전히 반성할 때까지 많이 혼내줄 테니, %CALLNAME:MASTER%-씨... HPH」", "W"
			ENDIF
			RETURN 1
		ENDIF
