	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDL
		RETURN 1
	ENDIF
	PRINTFORMDL
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;特殊イベント以外はワンクリックで終わるように
;==================================================

@M_KOJO_EVENT_K65_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 2) ;custom code, match second case too for the time being
		IF CFLAG:ブチギレ
			PRINTFORMDW 모미지는 귀를 홱 흔들더니 당신을 돌아보지도 않고 걸어가 버렸다.
			;発情おしらせ
		ELSEIF CFLAG:生理周期 == 7 && CFLAG:既成事実 & 合意_うふふ && ABL:欲望 > 3 && !TCVAR:353
			IF !CFLAG:MASTER:同行
				PRINTFORML 「아아......」
				PRINTFORML 「안녕하세요, %CALLNAME:MASTER%-상...」
				PRINTFORMW 
				PRINTFORML 「음... 오늘은 진정하기가 힘들어서 말이야...」
				PRINTFORML 「%CALLNAME:MASTER%-씨가 시간을 내서 나와 함께 있어 주면 정말 좋을 텐데...」
				PRINTFORMDL 그렇게 말하자, 모미지는 수줍게 고개를 돌리며 옆눈으로 당신을 유혹하는 시선을 보냈다.
				PRINTFORMW
				PRINTFORML 「......Mn!」
				PRINTFORML 「미안해, %CALLNAME:MASTER%-상... 그냥 좀 정신이 없어.」
				PRINTFORMDW 모미지는 당신에게서 떨어져 살짝 땀에 젖은 목덜미의 은백색 머리카락을 쓸어 올렸다.
				PRINTFORML
				PRINTFORMW 「...기다리고 있을게...」
				TCVAR:353 = 1
			ELSEIF CFLAG:MASTER:同行 && CFLAG:溜まってる度 >= 700
				PRINTFORML 「실례합니다, %CALLNAME:MASTER%-씨?」
				PRINTFORMDL 모미지가 당신을 향해 조금은 조급하게 부른다.
				PRINTFORMDW 평소와 다른 분위기를 눈치챈 당신은 동행에게 한마디 건네며 모미지를 옆으로 데리고 간다.
				PRINTFORML 
				PRINTFORML 「음, 오늘은 내가 자제하기 어려운 날이야...」
				PRINTFORMW 「좋다면, %CALLNAME:MASTER%-씨, 나중에 좀 관심을 가져줘...」
				PRINTFORML 
				PRINTFORMDL 모미지가 할 말을 마치면, 그녀는 재빨리 절하고 떠난다.
				PRINTFORMW (만약 %CALLNAME:MASTER%-상에게 더 말을 건다면, 나 자신을 제어할 수 없을 거야...)
				TCVAR:353 = 1
			ELSE
				PRINTFORML 「아아...」
				PRINTFORMDW 모미지가 몸을 꿈틀거리며 당신이 하루 일과를 보내는 것을 들으며 안절부절못한다...
			ENDIF
		ELSEIF BASE:MASTER:体力 <= 800
			PRINTFORML 「우아...」
			PRINTFORMW 「발걸음이 조금 불안해 보인다... %CALLNAME:MASTER%-씨, 괜찮은 거야...?」
		ELSEIF BASE:MASTER:気力 <= 0
			PRINTFORMW 「정말 피곤해 보이는데... 곧 쉬어야 하지 않을까?」
			;発情
		ELSEIF TCVAR:発情
			;合意あり
			IF CFLAG:既成事実 & 合意_うふふ && ABL:欲望 > 3
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「...아, %CALLNAME:MASTER%씨...」
						PRINTFORMDW 모미지는 약간 열이 오른 듯한 표정으로 당신을 바라보며 미소 지었다.
					CASE 1
						PRINTFORMDL 모미지는 아무렇지도 않게 당신 옆에 기대고 있다...
						IF EYEWITNESS()
							PRINTFORML 「...저기, %CALLNAME:MASTER%씨. 다른 곳에서 이야기하고 싶으세요?」
							PRINTFORMW 「...물론이죠, 우리 둘만?」
						ELSE
							PRINTFORML 「%CALLNAME:MASTER%-산... 나와 함께 좀 편하게 있어 주지 않을래 \@ OUTROOF(CFLAG:TARGET:現在位置) || (OPENPLACE(CFLAG:TARGET:現在位置) >= 2) ? 좀 더 사적인 곳에서 # 여기서 \@?」
							PRINTFORMDW 조용한 순간을 이용해, 모미지는 당신에게 파고들며 부드러운 팔로 당신을 감싼다...
						ENDIF
				ENDSELECT
				;合意なし
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「우아, 우와...!」
						PRINTFORML 「어, 음... 안녕!!」
						PRINTFORMDW 모미지가 무슨 이유에선지 당신에게 인사하며 홍당무처럼 빨개진다...
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%-상, 안녕...」
						PRINTFORMDL 모미지가 너에게 인사한다.
						PRINTFORMDW ...분명 부끄러워하며.
				ENDSELECT
			ENDIF
			;仕事中
		ELSEIF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「만나서 반갑습니다.」
					PRINTFORMDW 모미지는 등을 곧게 편 채 정중하게 인사했다.
				CASE 1
					PRINTFORMDW 모미지는 위엄 있는 고개를 끄덕인 뒤 순찰을 계속한다.
				CASE 2
					;荒天
					IF GROUPMATCH(TIME:5,5,9,13) && OUTROOF(CFLAG:MASTER:現在位置)
						PRINTFORMW 「날씨가 꽤 안 좋네... 너무 오래 밖에 있지 마, 알겠지?」
					ELSE
						PRINTFORML 「안녕하세요, %CALLNAME:MASTER%-씨.」
						PRINTFORMW 「오늘은 산이 조용하네요.」
					ENDIF
				CASE 3
					PRINTFORML 「우리가 테누로 지켜보고 있지만, 야생 요괴는 여전히 산에서 발견될 수 있다.」
					PRINTFORM 「안전하게 하고 너무 멀리 돌아다니지 마라, 알았지?」
					;親密高い
					IF CFLAG:2 >=1000
						PRINTFORML
						PRINTFORMW 「만약 당신에게 무슨 일이 생긴다면, %CALLNAME:MASTER%-씨는 매우 억울할 거예요... 여기서 안전하게 지내세요.」
					ELSE
						PRINTFORMDW
					ENDIF
			ENDSELECT
			;恋人の時1/2で
		ELSEIF TALENT:恋人 && RAND:2 == 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 모미지(Momiji)는 기쁘게 미소 지으며 당신에게 손을 흔든다.
				CASE 1
					PRINTFORMDL 모미지는 얼굴에 명랑한 표정을 띠고 당신을 향해 미소 짓는다.
					PRINTFORMDW 그녀의 꼬리는 뒤에서 힘차게 흔들리고 있다.
				CASE 2
					PRINTFORML 「아, %CALLNAME:MASTER%-씨, 당신을 보길 바랐어요♪」
					PRINTFORMDW 모미지가 발걸음에 활기를 띠고 다가오는데, 그녀의 귀가 걸음걸이에 따라 흔들리는 것이 눈에 들어온다.
			ENDSELECT
			;恋慕の時3/5で
		ELSEIF TALENT:恋慕 && RAND:5 < 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%-상!」
					PRINTFORMDW 그녀가 당신을 알아차리면, 모미지가 밝은 표정으로 당신에게 다가온다.
				CASE 1
					PRINTFORML 「안, %CALLNAME:MASTER%-상, 안녕하세요...」
					PRINTFORMDL 모미지는 다소 부끄러워하며 당신에게 손을 흔든다.
					PRINTFORMDW 그녀의 꼬리는 손짓과 완벽하게 일치하며 흔들린다... 정말 놀라울 정도로 귀엽다.
				CASE 2
					PRINTFORML 「이 발소리들... 후후, 혹시 %CALLNAME:MASTER%인가?」
					PRINTFORMDW 모미지는 당신을 향해 돌아보며 행복하게 미소 짓는다.
			ENDSELECT
			;思慕の時1/2で
		ELSEIF TALENT:思慕 && RAND:2 == 0
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL 모미지가 당신을 보면 부드러운 미소로 고개를 숙인다.
					PRINTFORMDW 처음 만났을 때보다 그녀의 어깨가 조금 더 편안해 보이는 듯, 두 사람 사이에 더 안락한 분위기가 감돈다.
				CASE 1
					PRINTFORML 「안녕하세요, %CALLNAME:MASTER%-씨.」
					PRINTFORMW 「If you like, why don't we chat a little?」
			ENDSELECT
			;愛欲の時1/2で、愛人の時2/3
		ELSEIF TALENT:愛欲 && RAND:(1+TALENT:セフレ) < TALENT:セフレ
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, %CALLNAME:MASTER%-상...」
					IF CFLAG:溜まってる度 >=700
						PRINTFORML 「괜찮다면, 음... 잠깐 얘기 좀 할래?」
						PRINTFORMW 「...둘만?」
					ELSE
						PRINTFORMDW 모미지는 몇 초 동안 너를 강렬하게 바라본 후 고개를 숙인다.
					ENDIF
				CASE 1
					PRINTFORMDW 모미지는 눈으로 당신의 체형을 쫓는다. 그녀는 얼굴에 뜨거운 표정을 짓고 있다...
			ENDSELECT
			;セフレの時1/2、愛人の時2/3で
		ELSEIF TALENT:セフレ && RAND:(1+TALENT:セフレ) < TALENT:セフレ
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아아~...」
					PRINTFORMDW 모미지의 눈은 마치 세상을 여행하듯 당신을 둘러본다... 그러고는 건성으로 고개를 숙인다.
				CASE 1
					PRINTFORMW 「\@ TIME:2 >= 5 && TIME:2 <= 7 ? 좋은 저녁이에요 # 좋은 아침이에요 \@, %CALLNAME:MASTER%-씨.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					;住み込みフラグが立っておらず、妖怪の山でない。または%CALLNAME:MASTER%の自室
					IF (FLAG:住み込みキャラ != 65 && MAIN_MAP != 8) || CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置
						PRINTFORML 「아, 길을 막아서 죄송합니다.」
						PRINTFORMDW 모미지가 당신에게 고개를 숙인다.
					ELSE
						PRINTFORMDW 모미지는 너에게 가볍게 고개를 끄덕인다.
					ENDIF
				CASE 1
					PRINTFORMW 「\@ TIME:2 >= 5 && TIME:2 <= 7 ? 좋은 저녁이에요 # 좋은 아침이에요 \@, %CALLNAME:MASTER%-씨.」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMDL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;仕事中
		IF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom codes
			;山頂
		ELSEIF CFLAG:現在位置/100 == 8
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「\@ TIME:2 >= 5 ? 좋은 저녁입니다 # 좋은 하루입니다 \@, %CALLNAME:MASTER%-상.」
					PRINTFORMW 「산악 등반을 하러 오셨나요?」
				CASE 1
					PRINTFORMDW 모미지는 당신을 보자 공손하게 고개를 숙인다.
			ENDSELECT
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;[思慕]以上なら千里眼でMASTERをチラ見するくらいはしてるだろうし
		;MASTERとデート相手がシてるかどうかってくらいなら視ちゃってるんじゃないかな…
		IF (CFLAG:(ARG:1):既成事実 & 合意_うふふ) && (TALENT:思慕||TALENT:恋慕||TALENT:セフレ||TALENT:愛欲)
			IF TALENT:恋人
				PRINTFORML 「좋은 하루예요, %CALLNAME:MASTER%-씨.」
				PRINTFORML 「내가 항상 당신을 지켜보고 있다는 거 알잖아요, 그렇죠?」
				PRINTFORMDW 모미지가 미소 짓지만 눈빛은 공허하다.
				;BASE:怒り +=
			ELSE
				PRINTFORML 「Ah...」
				PRINTFORMDW 모미지가 당신에게 인사하고 %CALLNAME:(ARG:1)% 한 뒤 급히 떠난다...
				IF RAND:2
					PRINTFORML (그 두 사람, 저런 관계를 가지고 있구나...)
					PRINTFORMW (...어떤 상황이든, 그들이 그런 곳에서 그것을 하는 모습을 보니 나는...)
				ENDIF
			ENDIF
		ELSE
			PRINTFORMDW 모미지가 당신에게 인사하고 %CALLNAME:(ARG:1)%, 늑대처럼 웃으며 떠난다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;朝起きたとき（おはよう口上）
;==================================================

@M_KOJO_EVENT_K65_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMDW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMDW 
			RETURN 1
		ENDIF
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMDW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMDW 
			RETURN 1
		ENDIF
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
RETURN 1
;==================================================
;夜寝るとき（おやすみ口上）
;==================================================

@M_KOJO_EVENT_K65_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
