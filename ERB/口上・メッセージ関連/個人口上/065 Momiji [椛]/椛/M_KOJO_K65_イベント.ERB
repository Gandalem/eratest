@M_KOJO_EVENT_K65_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:ブチギレ
			PRINTFORMDW 모미지는 뚱한 얼굴로 당신의 인사에 응답한다.
			;発情おしらせ
		ELSEIF CFLAG:生理周期 == 7 && CFLAG:既成事実 & 合意_うふふ && ABL:欲望 > 3 && !TCVAR:353
			IF !CFLAG:MASTER:同行
				PRINTFORML 「아아~...」
				PRINTFORMDL 당신을 본 모미지는 얼굴을 붉히며 당신을 향해 손짓한다.
				PRINTFORMDW 그녀의 부름에 응해 가까이 다가갈수록, 당신은 그림자 속에서 모미지가 몸을 뒤틀고 있음을 알아차린다.
				PRINTFORML 
				PRINTFORML 「음, %CALLNAME:MASTER%-상...」
				PRINTFORML 「음... 오늘은 내가 흥분하는 날 중 하나야...」
				PRINTFORMW 「...만약 좋아한다면 나중에 나를 진정시키는 것을 도와주러 와준다면 기쁠 거야.」
				PRINTFORML 
				PRINTFORMDW 모미지가 관능적인 미소를 지어 보인 뒤, 인사하고 떠났다.
				TCVAR:353 = 1
			ELSEIF CFLAG:MASTER:同行 && CFLAG:溜まってる度 >= 700
				PRINTFORML 「실례합니다, %CALLNAME:MASTER%-씨?」
				PRINTFORMDL 모미지가 참지 못하고 당신을 부른다.
				PRINTFORMDW 평소와 다른 분위기를 눈치챈 당신은 동료에게 한 마디를 건네며 모미지를 옆으로 데리고 간다.
				PRINTFORML 
				PRINTFORML 「음, 오늘은 내가 자제하기 힘든 날이야...」
				PRINTFORMW 「만약 괜찮다면, %CALLNAME:MASTER%-씨, 나중에 좀 관심을 가져줘...」
				PRINTFORML 
				PRINTFORMDL 모미지가 할 말을 마치면, 그녀는 재빨리 절하고 떠난다.
				PRINTFORMW (만약 %CALLNAME:MASTER%-상에게 더 말을 건다면, 나 자신을 제어할 수 없을 거야...)
				TCVAR:353 = 1
			ELSE
				PRINTFORML 「아아...」
				PRINTFORMDW 모미지가 몸을 꿈틀거리며 당신이 하루 일과를 보내는 것을 들으며 안절부절못한다...
			ENDIF
			;仕事中
		ELSEIF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 모미지는(는) \@ CFLAG:2 >=1000 && RAND:2 ? 기쁘게 미소 짓는다 # 몸을 바로잡고 \@ 당신의 인사에 응답한다.
				CASE 1
					PRINTFORMDW 당신이 그녀의 노력을 칭찬하면, 모미지는 행복하게 꼬리를 흔들며 당신에게 고개를 숙인다.
				CASE 2
					PRINTFORMDW 엄마지가 위엄 있는 표정으로 당신에게 정중하게 고개를 숙인다.
			ENDSELECT
			;恋人の時1/2で
		ELSEIF TALENT:恋人 && RAND:2 == 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 모미지가 기쁘게 웃으며 당신에게 손을 흔든다.
				CASE 1
					PRINTFORMDL 모미지는 즐거운 표정으로 당신을 향해 미소 지었다.
					PRINTFORMDW ...그녀의 꼬리는 뒤에서 힘차게 흔들리고 있었다.
				CASE 2
					PRINTFORML 「후훗, 나중에 좀 신경 써주지, 응?」
					PRINTFORMDW 모미지는 떠나기 전에 부드럽게 당신의 어깨를 스친다.
			ENDSELECT
			;恋慕の時3/5で
		ELSEIF TALENT:恋慕 && RAND:5 < 3
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMDW 당신을 본 후, 모미지는 활기찬 대답으로 당신의 인사에 응한다.
				CASE 1
					PRINTFORMDW 모미지는 당신을 인사하며 희미하게 홍조를 띤다.
				CASE 2
					PRINTFORML 「안녕, %CALLNAME:MASTER%-씨...」
					PRINTFORMDL 모미지가 약간 수줍게 당신에게 손을 흔든다.
					PRINTFORMDW 그녀의 꼬리는 손의 움직임과 완벽하게 일치하며 흔들린다... 정말 충격적일 정도로 귀엽다.
				CASE 3
					PRINTFORML 「이 발소리들... 후후, 혹시 %CALLNAME:MASTER%-씨인가요?」
					PRINTFORMDW 모미지는 당신을 향해 돌아보며 행복하게 미소 짓는다.
				CASE 4
					PRINTFORML 「Ah...」
					PRINTFORMDW 당신의 고개를 끄덕인 후, 모미지는 다소 쓸쓸한 표정으로 당신이 떠나는 것을 지켜본다.
			ENDSELECT
			;思慕の時1/2で
		ELSEIF TALENT:思慕 && RAND:2 == 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 모미지가 당신을 보면 부드러운 미소와 함께 고개를 숙인다.
					PRINTFORMDW 당신은 그녀가 처음 만났을 때보다 어깨가 조금 더 편안해진 것처럼, 둘 사이에 더욱 안락한 분위기를 느낀다.
				CASE 1
					PRINTFORML 「...후후.」
					PRINTFORMDW 모미지는 당신의 목례에 응하며 부드러운 미소로 당신이 걸어가는 뒷모습을 바라본다.
				CASE 2
					PRINTFORML 「아, %CALLNAME:MASTER%씨, 어디 가세요?」
					PRINTFORMW 「...바쁘신 것 같네요. 방해해서 죄송해요.」
			ENDSELECT
			;愛欲の時1/2で、愛人の時2/3
		ELSEIF TALENT:愛欲 && RAND:(1+TALENT:セフレ) < TALENT:セフレ
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, %CALLNAME:MASTER%-상...」
					IF CFLAG:溜まってる度 >=700
						PRINTFORMW 「음... 나중에 나 보러 와 줄 수 있어?」
					ELSE
						PRINTFORMDW 모미지는 몇 초 동안 너를 강렬하게 바라본 후 고개를 숙인다.
					ENDIF
				CASE 1
					PRINTFORMDW 얼굴에 뜨거운 표정을 띤 모미지가 당신의 체형을 눈으로 쫓는다...
			ENDSELECT
			;セフレの時1/2、愛人の時2/3で
		ELSEIF TALENT:セフレ && RAND:(1+TALENT:セフレ) < TALENT:セフレ
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아아~...」
					PRINTFORMDW 모미지의 눈은 마치 고기를 감정하듯 당신을 둘러본다... 그러고는 건성으로 목례를 한다.
				CASE 1
					PRINTFORMDW 모미지는 당신에게 인사하며 살짝 홍당무가 된다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「안녕하세요, %CALLNAME:MASTER%-씨.」
					PRINTFORMDW 모미지가 당신에게 정중하게 인사한다.
				CASE 1
					PRINTFORMDW 모미지가 그녀의 늑대 귀를 펄럭이며 당신의 인사에 응답한다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDL
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
RETURN 1
