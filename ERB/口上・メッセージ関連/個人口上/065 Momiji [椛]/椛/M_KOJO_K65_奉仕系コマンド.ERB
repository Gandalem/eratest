; Modular ERB: 個人口上/065 Momiji [椛]/椛/M_KOJO_K65_奉仕系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;奉仕系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K65_80
CALL M_KOJO_MESSAGE_COM_K65_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「아, 너무 뜨거워...」
		PRINTFORMDW 모미지의 눈이 놀라움으로 커지며 그녀는 부드럽게 당신의 거시기 위에 손을 올린다.
		PRINTFORML 
		PRINTFORML 「음... 위아래로 비벼야겠지, 그치?」
		PRINTFORMW 「음... 좀 더 세게 잡아야 할까? 얼마나 강하게 쥐어야 할지 모르겠네...」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
		;発情
	ELSEIF TCVAR:発情
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「음... 곧 터질 거야?」
					PRINTFORMDL 모미지의 눈이 당신을 올려다보더니 입을 벌리고 간절하게 혀를 내밀었다...
					CALL HPH_PRINT,@"「흐으... 흐응... 여기 왔어... 후우」","W"
					PRINTFORML
					CALL HPH_PRINT,@"「쉐멤, 로쉬-, 나한테 로쉬 좀 줘」","L"
					PRINTFORMDW 모미지는 당신의 정액을 갈구하며 혀를 내밀고 과시적으로 공중을 핥는다...
				CASE 1
					PRINTFORML 「아앙... 몸이 떨리고 있어... 갈 거야...?」
					CALL HPH_PRINT,@"「좀 낭비되는 거지만... 내 손에 그냥 뿌려줘도 괜찮아... HPH」", "L"
					PRINTFORMDW 모미지가 애무 속도를 높이며 당신이 사정하도록 부추긴다...
			ENDSELECT
		ELSEIF ABL:精液中毒 > 3 && RAND:2
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「킁킁, 하아암...햣후. 너 엄청 좋은 냄새 나, %CALLNAME:MASTER%-상햣후」","L"
					PRINTFORMDL 모미지는 당신의 성기를 들어 애정 어린 표정으로 그것에 볼을 비빈다...
					CALL HPH_PRINT,@"「후후, 언제라도 사정할 것 같지? HPH」","L"
					CALL HPH_PRINT,@"「네가 나를 그것으로 뒤덮을 때도 좋지만, 네가 내가 그것을 마시게 할 때도 좋아...HPH」","W"
				CASE 1
					PRINTFORMDL 모미지는 부드러운 손가락으로 당신의 성기를 만지며 가슴에 머리를 기대고 있다...
					CALL HPH_PRINT,@"「꽉 누르고, 쓸어내리고... 후후, 다음, 당신의 끝부분... 간지러워~ 후후」","L"
					PRINTFORMDL 그녀는 마치 탐험하듯이 손바닥으로 당신의 귀두를 쓸어내리면서, 손가락 끝으로 당신의 포피를 부드럽게 자극한다.
					PRINTFORMDW 울프걸은 당신의 성을 가지고 장난치며 스스로 흥얼거리고, 당신에게 정밀하게 조율된 일련의 쾌감을 선사한다...
					PRINTFORML
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%-상, 기분 좋아...? ...아하하헵 굉장하지 않아~헵」","L"
					CALL HPH_PRINT,@"「사실 %CALLNAME:MASTER%-상, 내가 너를 자위하면서 네 체취도 맡고 심장 박동도 느낄 수 있어...」","L"
					CALL HPH_PRINT,@"「내가 너에게 기분 좋은 접촉을 해줄 때마다, 네 온몸이 그것에 민감하게 반응한다 HPH」","L"
					CALL HPH_PRINT,@"「그리고 %CALLNAME:MASTER%-씨가 이렇게 흥분하면, 나도 어쩔 수 없이 들뜨게 돼... 응, 후후후... 흐으프」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「이것은 \@ TALENT:MASTER:形状 >= 3 ? 뜨겁고 강한 # 뜨거운 \@ 것인데, 그냥 들고만 있어도 심장이 두근거려...」","L"
					PRINTFORMDW 모미지는 당신의 맥동하는 것을 문지르며 안절부절못해 몸을 비틀고 다리를 조절한다.
				CASE 1
					CALL HPH_PRINT,@"「루브루브, 루브루브하프 아, 점점 더 단단해져 가네...하프」","L"
					PRINTFORMDL 모미지는 당신에게 바싹 다가와 당신의 거시기(cock)를 계속 만지면서 귀에 속삭인다.
					CALL HPH_PRINT,@"「당신의 거시기... 더 세게 해줘-HPH 제발 더 강하게...HPH」","W"
			ENDSELECT
		ENDIF
		RETURN 1
		;非発情
	ELSE
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			IF ABL:精液中毒 > 3 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아... 사정할 것 같네...」
						PRINTFORML 「그럼 끝을 간지럽혀줄게... 많이, 아주 많이 싸줘...」
						PRINTFORMDL 모미지는 네 성기를 괴롭히며 기대감에 눈을 들어 너를 올려다본다.
						PRINTFORMDW 그녀는 끊임없이 약점을 압박하지만 결코 너무 거칠지 않으며 쉽게 너를 절정에 이르게 한다...
					CASE 1
						PRINTFORML 「아하, 곧 사정할 것 같네...」
						PRINTFORMDL 모미지는 당신 앞에 무릎을 꿇고 양손으로 당신의 성기를 감싸며 간절하게 자극하기 시작했다.
						PRINTFORML 「모든 것을, 전부 받을게요... %CALLNAME:MASTER%-님, 제 몸에 당신의 향기로 채워주세요...」
						PRINTFORMDW 그녀의 음란한 애원은 당신이 그녀에게 사정하여 자신의 소유임을 표시하고 싶게 만들었다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「엣? 곧 절정에 이를 거야...?」
						IF EXP:精液経験 < 20
							PRINTFORML 「이렇게 문질러도 될까?」
							PRINTFORMW 「좋아. 내 손이 너를 기분 좋게 해 주도록 해줘...」
						ELSE
							PRINTFORML 「좋아, 그냥 계속 이렇게 문질러 줄게.」
							PRINTFORMW 「후후, 내 손을 즐겨줘, 그리고 많이 흘려내 줘~」
						ENDIF
						IF ABL:膣射中毒 > 2 && RAND:3 == 0
							PRINTFORML
							PRINTFORML (나는 정말로 내 보지에 %HIM_HER(MASTER,,1)%가 사정하기를 바랐지만...)
							PRINTFORMW (%CALLNAME:MASTER%-님에게 그렇게 기쁨을 주고 있다면, 아마 이게 최선이겠지...)
						ENDIF
					CASE 1
						PRINTFORML 「아, 아아... 너무 많이 부어오르고 있어...」
						PRINTFORMDW 사정 직전 미세하게 떨기 시작하자 모미지는 당신을 바라보며 감탄한다.
				ENDSELECT
			ENDIF
		ELSEIF ABL:精液中毒 > 3 && RAND:2
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"(내가 만질 때마다 그 냄새가 더 강해진다...)","L"
					CALL HPH_PRINT,@"(어지러워지는 것 같아...HPH)","L"
					PRINTFORMDW 모미지는 거의 무의식적으로 코를 네 귀두에 더 가까이 가져가고, 네 냄새가 그녀의 콧속을 침범하자 얼굴이 흐트러진다.
				CASE 1
					CALL HPH_PRINT,@"「하아, 하아... 흠...흐읍」","L"
					PRINTFORMDL 모미지의 꼬리가 흥분하며 당신의 성기를 체계적으로 조이고, 그녀의 작은 엉덩이도 안팎으로 불안하게 흔들린다.
					PRINTFORMDW 그녀의 거친 숨결이 아픈 남근을 어루만지며 짜릿한 소름이 등줄기를 타고 흐르게 한다...
					PRINTFORML
					IF RAND:3 == 0
						CALL HPH_PRINT,@"「에헤... 내 손으로 자극만 했는데 벌써 이렇게 흥분하는 건가...」","L"
						CALL HPH_PRINT,@"「음, 그래... 하지만 나는 너에게 무엇을 할지도 그리고 네가 나에게 무엇을 해줄지 생각하고 있어...」","L"
						CALL HPH_PRINT,@"「...어쩌면 다음에 일어날 여러 가지 일들에 흥분하고 있는 건지도 모르겠네HPH」","W"
					ELSE
						PRINTFORMDL 네 거름 맛을 반복해서 보게 된 모미지는 이제 네 것을 만지는 것만으로 흥분하는 모양이다.
						CALL HPH_PRINT,@"「음... 에헤헤, %CALLNAME:MASTER%-씨...」","L"
						PRINTFORMDW 당신은 그녀의 머리를 부드럽게 쓰다듬고, 모미지는 행복하게 눈을 가늘게 뜨며 응답하여 서빙하는 손의 속도를 높인다...
					ENDIF
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「응슈, 후우... %CALLNAME:MASTER%-씨, 기분이 어때?」
					PRINTFORMDW 모미지는 천천히 손을 올려 당신의 샤프트 위에서 움직이며, 당신의 반응을 주의 깊게 지켜본다...
				CASE 1
					PRINTFORML 「음, 더워... %CALLNAME:MASTER%-상...」
					PRINTFORMDW 모미지는 부드러운 손가락으로 당신의 성기를 만지며 당신에게 파고든다...
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K65_81
CALL M_KOJO_MESSAGE_COM_K65_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K65_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(81)
		IF TCVAR:発情
			PRINTFORML 「펠라치오...?」
			PRINTFORML 「내 걸 빨아주길 원해?」
			PRINTFORML 「알았어, 알겠어. 그럼 나한테 꺼내줘...」
			PRINTFORMDL 깔깔 웃으며 모미지는 당신의 아랫배 쪽으로 얼굴을 가까이 가져갔다.
			CALL HPH_PRINT,@"「킁킁... 후후, 정말 좋은 냄새야... 나도 흥분해지기 시작했어~ HPH」", "L"
			PRINTFORMDW 그녀는 당신의 페니스를 가볍게 키스한 후, 혀를 내밀고 조심스럽게 당신의 귀두를 핥기 시작한다...
		ELSE
			PRINTFORML 「후...?!」
			PRINTFORML 「...음, 내가 핥아야 할까...?」
			PRINTFORMDL %BREAKENG(@"모미지는 네 단단한 성기를 응시하며 침을 삼키고, 구강 서비스에 대한 기대감으로 떨었다.")%
			PRINTFORMDL 보아하니 그녀는 꽤 긴장했지만, 거절할 생각은 없다.
			PRINTFORML 「음, 실례합니다, 그렇죠...」
			PRINTFORML (와, 이 굉장한 냄새... 이건 %CALLNAME:MASTER%-씨의...)
			PRINTFORMDW 모미지는 혀를 내밀고 당신의 페니스의 끝을 조심스럽게 핥기 시작한다...
		ENDIF
		RETURN 1
	ENDIF
	;初めてのびゅう
	IF NOWEX:MASTER:11 && (EXP:精飲経験 == 0 || TCVAR:精飲経験 == 0)
		PRINTFORML 「음음?! 푸아...!」
		PRINTFORMDL %BREAKENG(@"아마 그녀는 절정에 대한 기대감에 네 성기가 떨리는 것에 놀랐겠지만, 모미지는 빨기를 멈추고 그것을 입에서 뱉어냈다…")%
		PRINTFORMDW 그 자극이 마지막 한 방이 되고, 당신의 성기 끝에서 정액이 격렬하게 뿜어져 나온다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
	ELSEIF STAIN:MASTER:Ｐ & 4 && !NOWEX:MASTER:11
		PRINTFORMW 「내가 치울게...」
		RETURN 1
		;発情中
	ELSEIF TCVAR:発情
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;慣れてない
			IF EXP:精飲経験 < 20
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「응, 음, 흐읍... 나올 것 같아...?」
						CALL HPH_PRINT,@"「괜찮아, 그냥 내 입에 넣어줘...후훗」", "W"
					CASE 1
						CALL HPH_PRINT,@"「츄, 핥아줘... 제발 내 입안에서 해줘...흐읍」", "L"
						CALL HPH_PRINT,@"「잘 마시도록 노력할게, 그러니까... HPH」", "W"
				ENDSELECT
				;精液中毒高め
			ELSEIF ABL:精液中毒 > 3 && RAND:2
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「...!! %RANDKISS("suck")%, %TOLOWER(RANDKISS("suck"))%～～～HPH」", "L"
						PRINTFORMDL %BREAKENG(@"사정의 기미를 느끼고 모미지는 네 허리에 몸을 밀착시키며 네 거시기를 목구멍 깊숙이 박아 넣는다.")%
						CALL HPH_PRINT,@"(기미HPH 기미HPH 쉐멤, 끼클리!HPH)", "L"
						PRINTFORMDL 모미지는 당신의 거친 곳에서 정액을 애원하며, 기대감에 그녀의 붉은 눈이 위를 향해 빛난다...
						PRINTFORMDW 그녀의 귀엽고 음란한 얼굴이 당신을 극한으로 몰아넣었고, 당신은 뜨거운 욕망의 줄들을 그녀의 목구멍으로 쏟아낸다...
					CASE 1
						CALL HPH_PRINT,@"(우웁... 네 고환이 올라가고 있어...후후. 너 곧 장난스러운~ 걸 뿜을 것 같아...후후)", "L"
						CALL HPH_PRINT,@"「%RANDKISS("suck")%HPH %RANDKISS("suck")%HPH %RANDKISS("suck")%HPH %RANDKISS("suck")%～HPH」", "L"
						PRINTFORMDL 모미지는 네 성기를 꾸짖은 후, 그것을 벌주며 아주 음란한 소리를 내기 시작한다...
						PRINTFORMDL 그녀의 작은 머리가 격렬하게 앞뒤로 움직일 때마다, 아름다운 은백색 머리카락이 휘날리며 반짝인다.
						CALL HPH_PRINT,@"(%CALLNAME:MASTER%-상의 정액이~ HPH 곧... HPH)", "L"
						PRINTFORMDW 당신의 아랫배에서부터 피어오르는 달콤한 감각이 마침내 정점에 도달하고, 단단해진 거시기가 사정한다...
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「음음 괜찮아... 그냥 해줘, 내 입에...흐으응」", "L"
						PRINTFORMDL 모미지가 당신의 사정이 임박했음을 감지하자 그녀는 당신의 성기를 향해 입술을 바짝 다문다.
						CALL HPH_PRINT,@"「%RANDLIPS(,"suck")%～～～～HPH」", "W"
					CASE 1
						CALL HPH_PRINT,@"(부풀어 오르는 것 같다... HPH...)","L"
						PRINTFORMDW %BREAKENG(@"모미지가 네 떨리는 거시기를 입 깊숙이 빨아들이고 음란한 소리를 내며 그 위를 가글한다. 그것은 너를 절정에 이르게 한다...")%
				ENDSELECT
			ENDIF
			;技術不足
			;ELSEIF ABL:舌技術 < 2
			;何度も射精した
		ELSEIF TCVAR:350 > 3 && RAND:2
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「...와...흐읍 점점 힘들어져... 또...흐읍」","L"
					PRINTFORMDL 모미지는 계속 기절해도 다시 일어나는 당신의 성기를 감탄하며 한숨을 내쉰다...
					CALL HPH_PRINT,@"「후후, 더 꽉 조여줄 테니, %CALLNAME:MASTER%-씨, 다시는 피유~ 피유~ 해줘...큭」","L"
					PRINTFORMDW 모미지는 사악한 미소를 지으며 당신의 길이 위아래로 천천히 핥는다...
				CASE 1
					;ふたなりMASTERでここを踏んじゃった場合、「私玉無しふたなり派なんですが…」ってなる人がいたら申し訳ないっすね。
					PRINTFORML 「정말 많아... 그걸 어디에 저장하는 거야? 여기에, 흐음?」
