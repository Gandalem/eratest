;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K129_5_1
	ELSEIF CFLAG:318 == 1
