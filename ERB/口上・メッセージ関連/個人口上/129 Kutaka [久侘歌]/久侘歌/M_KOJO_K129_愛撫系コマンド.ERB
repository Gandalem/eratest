	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음~~!」
		PRINTFORMW 「...정말 좋아해요! %CALLNAME:MASTER%님!」
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응……%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「좀 더……%CALLNAME:MASTER% 씨의 입술을……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음~~ %UNICODE(0x2665) *1%」
			PRINTFORMW (더 이어지고 싶어요...!)
		ELSE
			PRINTFORMW 「응!?」
			PRINTFORMW 쿠타카는 입술을 빼앗기자 그대로 깊게 이어지려 했다.
			PRINTFORMW 「에헤헤……%CALLNAME:MASTER%씨와의 키스는 정말 기분 좋아요!」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응~ 더 많이...」
		ELSE
			PRINTFORMW 「응응……」
		ENDIF
	ENDIF
ENDIF
RETURN 1
