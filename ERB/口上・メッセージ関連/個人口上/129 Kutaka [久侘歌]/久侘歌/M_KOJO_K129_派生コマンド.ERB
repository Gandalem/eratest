;==================================================
;12,パイズリフェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K129_12
CALL M_KOJO_MESSAGE_SCOM_K129_12_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K129_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「으응... 남자의 맛이군요%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;胸3以上
	ELSEIF ABL:胸 > 2
		IF RAND:3 == 0
			PRINTFORMW 「음~ 쪽 %UNICODE(0x2665) *1%」
			PRINTFORMW 「많이 내주세요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 진한 남자의 체취입니다...」 %UNICODE(0x2665) *1%
		ELSE
			PRINTFORMW 「끝에서 육즙이 흘러나왔네요」
			PRINTFORMW 「참지 마시고 저를 당신의 정액으로 마킹해 주세요♪」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 어렵네요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「오친포님이 가슴속에서 움찔거리고 있어……」
		ELSE
			PRINTFORMW 「……음음…… 기분 좋으세요?」
		ENDIF
	ENDIF
ENDIF
