@M_KOJO_MESSAGE_SCOM_K129_1
CALL M_KOJO_MESSAGE_SCOM_K129_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K129_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「음... 입으로 봉사해 드리겠습니다♪」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응음~~ %UNICODE(0x2665) *1%」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW 「빨리 거시기 물을 내 주세요 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「으응……%UNICODE(0x2665) *1%……쪽%UNICODE(0x2665) *1%……내주세요%UNICODE(0x2665) *1%」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 교묘하게 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「응, 응 %UNICODE(0x2665) *1%」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙하게 혀를 사용해 그것을 재촉한다.
				PRINTFORMW 「입안에 %조사처리(CALLNAME:MASTER,"의")% 정액으로 채워주세요... %UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음～」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀 사용으로 능숙하게 그것을 부추기고 있었다.
				PRINTFORMW 「좀 더 기분 좋게 해 드릴게요」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음음……」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀 사용으로 능숙하게 그것을 촉진하고 있다.
			ELSE
				PRINTFORMW 「음음읏」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 이용해 능숙하게 그것을 부추기고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「음……%UNICODE(0x2665) *1%……れろ……%UNICODE(0x2665) *1%」
				PRINTFORMW 「……맛있다……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응응……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 「……거시기(좆) 나오는 거 많이 내줘 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「츄릅%UNICODE(0x2665) *1% 낼름%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음～」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀 사용으로 능숙하게 그것을 부추기고 있었다.
				PRINTFORMW 「좀 더 기분 좋게 해 드릴게요」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음음……」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀 사용으로 능숙하게 그것을 촉진하고 있다.
			ELSE
				PRINTFORMW 「음음읏」
				PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 이용해 능숙하게 그것을 부추기고 있다.
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음……츄루루……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……이런 느낌인가요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……으윽……이상한 맛입니다……」
		ELSE
			PRINTFORMW 「……음음……」
			PRINTFORMW 쿠타카는 어딘가 서툴게 성기를 입에 물었다.
		ENDIF
	ENDIF
ENDIF
