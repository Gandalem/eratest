@M_KOJO_SUCCESS_COM_K129_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K129_301
CALL M_KOJO_MESSAGE_COM_K129_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「왜 당신의 차를 마셔야 하는 거죠……」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「아...... 그다지 맛있지는 않네요......」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「묵직하네……」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「마실 수 없어요……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「독특한 맛이네요……」
		ELSE
			PRINTFORMW 「……맛있지 않네요」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「쭉... 꽤나 대단하시군요...」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「좋은 차잎이네요...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「%CALLNAME:MASTER%님과 함께 마시니까 맛있는 걸까요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「차의 예법은 잘 모르지만...」
		ELSE
			PRINTFORMW 「아... 맛있어요...!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
