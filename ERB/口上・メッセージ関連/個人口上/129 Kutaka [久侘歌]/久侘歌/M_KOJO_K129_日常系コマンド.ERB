;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K129_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K129_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K129_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「말 걸지 말아 주세요!」
		;会話不能
	ELSEIF TCVAR:302
		IF RAND:5 == 0
			PRINTFORMW (흐으윽... 어색하네요...)
		ELSEIF RAND:4 == 0
			PRINTFORMW (......더 얘기하고 싶은데요......)
		ELSEIF RAND:3 == 0
			PRINTFORMW (어떻게 하면 좋을까요...)
		ELSEIF RAND:2 == 0
			PRINTFORMW (으음... 어색해요...)
		ELSE
			PRINTFORMW (무언가... 이야기하지 않으면...)
		ENDIF
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")%~ 누가 좋아하시는 건가요~?」
			PRINTFORMW 쿠타카는 취한 채로 말을 걸어온다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 「있잖아 %CALLNAME:MASTER%씨……」
			PRINTFORMW 쿠타카는 취해서 달라붙는다.
			PRINTFORMW 「정말 좋아해요~?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「%CALLNAME:MASTER%씨!」
			PRINTFORMW 쿠타카는 얼굴을 상기시키며 부른다.
			PRINTFORMW 「오늘 술 마시자... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%CALLNAME:MASTER%씨...... %CALLNAME:MASTER%......」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%씨……」
			PRINTFORMW 「좋은 이름이네요……♪」
		ENDIF
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「%CALLNAME:MASTER%씨……」
			PRINTFORMW 「……왠지 취해버린 것 같아요~」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%CALLNAME:MASTER%ー」
			PRINTFORMW 쿠타카는 취한 채로 달라붙는다.
			PRINTFORMW 「……당신은 조금 너무 야합니다! ……염라님의 모조, 닮았나요?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「......뭔가요-?」
			PRINTFORMW 「혹시 저 말인가? 꺄아♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……%CALLNAME:MASTER%씨……그냥 불러본 것뿐이에요 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「흐아... 아...」
			PRINTFORMW 「%CALLNAME:MASTER%님은 안 드시나요...?」
		ENDIF
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「음... 기분 좋네요... ♪」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「......%CALLNAME:MASTER%님은 저랑 술 마시는 거 싫으세요?」
			PRINTFORMW 「저는 좋아요~ 헤헤~」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「음... 음음...」
			PRINTFORMW 「무슨 일이세요~ %CALLNAME:MASTER%님~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「에헤헤~ 뭔가 즐거워요!」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%씨……에헤헤……」
		ENDIF
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「음~ 여러분 너무 제멋대로 하잖아요!」
			PRINTFORMW 「저도 제 마음대로 하고 싶단 말이에요!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%CALLNAME:MASTER%씨는 술 드세요ー?」
			PRINTFORMW 쿠타카는 상당히 취한 채로 말을 건다.
			PRINTFORMW 「잔뜩 마시고 예의는 잠시 접어둡시다!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「왠지 취해버렸어요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「염마님은 일 너무 많이 하세요! 정말 걱정돼서요...」
		ELSE
			PRINTFORMW 「지금은 일에 대한 것은 잊어버리자!」
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「……음응…」
			PRINTFORMW 「좀…… 너무 많이 마셨을지도 모르겠네요……」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「음......」
			PRINTFORMW 「물을... 한 잔...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「너무 많이 마시는 건 좋지 않네요……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……맛있는 술이었네요……」
		ELSE
			PRINTFORMW 「우으... 세계가 돌아가고 있습니다...」
			PRINTFORMW 쿠타카는 약간 착란한 채로 말을 내뱉었다.
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「응?」
			PRINTFORMW 「...무슨 일이 있으셨나요?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「～♪～～♪」
			PRINTFORMW 쿠타카는 흥얼거리고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「왠지 기분이 좋네요♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「뭔가 안주가 당기네요」
		ELSE
			PRINTFORMW 「음, 좋은 술이었네요……」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「후우~♪ 좋은 온수네요...♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......토리시로유? 무엇인가요?」
		ELSE
			PRINTFORMW 「평소의 피로가 풀리네요♪」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「후아아... 봄은 여명이라 해도 어쩐지 졸려져 버리네요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이런 화창한 날에는 햇볕 아래에서 보내는 게 최고예요!」
					ELSE
						PRINTFORMW 「슬슬 이불을 치워야 하지 않을까요」
						PRINTFORMW 「지모요? 무슨 말씀이신가요?」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 더우면 익어버릴 것 같아요... 삼도의 강에서 물놀이 하고 싶네요...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「여름에도 힘차게 꼬끼오 하고 우는 것이 임무입니다! 아마 그럴 거예요!」
					ELSE
						PRINTFORMW 「날 날개 관리도 안 하면 땀 냄새가 나버릴 거예요...」
						PRINTFORMW 「좋은 냄새? 변태시네요!... 그래도 별로 나쁘진 않지만」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「날씨가 선선해졌으니 건강에 유의하세요?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「긴 가을밤에 긴 울음을 하고 싶은데요... 폐가 될지도 모르겠어요...」
					ELSE
						PRINTFORMW 「조금 추워졌으니까 나한테 더 가까이 와도 돼? 이렇게 보여도 따뜻하니까!」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 추우니 깃털이 있어서 다행이라고 생각해요... 더 가까이 와도 돼요?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「뜨거운 전골을 먹고 싶네요... 코마치 씨도 초대하면 올까요?」
					ELSE
						PRINTFORMW 「우으... 밖은 추워서 갈 수 없어...」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						PRINTFORMW 「가끔은 둘만 느긋하게 보내는 것도 나쁘지 않다고 생각해요 %UNICODE(0x2665) *1%」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「에헤헤... 뭔가 이렇게 하고 있는 것만으로도 행복해요♪」
						PRINTFORMW 쿠타카는 그렇게 말하며 미소를 지으며 대화를 시작했다.
					ELSEIF RAND:3 == 0
						PRINTFORMW 「엣!? %CALLNAME:MASTER%님은 설마 닭을 키우고 계신 건 아니죠?」
						PRINTFORMW 「...만약 키우고 계시다면 저에게 참아주실 수 없을까요...?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「오늘은 무엇을 할까요? %CALLNAME:MASTER%님과라면 무엇이든 즐거울 것 같지만」
					ELSE
						PRINTFORMW 「저승의 가게에서 데이트를 하는 것도 나쁘지 않겠네요...」
						PRINTFORMW 「아, 특별히 식탐이 생겼다는 건 아니니까요! 정말이에요?」
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「음... 이렇게 이야기하고 있으면 뭔가 즐거워져 버려요♪」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「%CALLNAME:MASTER%님은 평소에 무엇을 하고 계신가요?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「코마치 씨는 게으름을 피우는 편이라 연옥의 주인님도 골머리를 앓고 있는 것 같습니다...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CALLNAME:MASTER%님은 저를... 아니, 아무것도 아닙니다!」
					ELSE
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 환상향에 가고 싶은 곳 같은 건 있나요?」
						PRINTFORMW 「저는... 함께라면 어디든 갈 수 있어요...」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「머리 위의? 아아, 피요쨩 말인가?」
						PRINTFORMW 「귀엽지? 나의 자랑인 아이란다!」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「음음... 무슨 이상한 생각을 하고 있는 건가요?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「%CALLNAME:MASTER%님은 사람이 막고 있는데 강행 돌파해서는 안 돼요!」
						PRINTFORMW 「......전에 심한 일을 당했었기 때문에... 경고예요!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「……음음……특기 요리인가요?」
						PRINTFORMW 「계란말이……아니랍니다! ……계란 요리는 전부 할 수 있지만……」
					ELSE
						PRINTFORMW 「……달걀을 달라는 건가요?」
						PRINTFORMW 「성희롱이에요... 그런 거!」
					ENDIF
				ELSEIF CFLAG:2 >= 500
					IF RAND:5 == 0
						PRINTFORMW 「최근엔 별일 없이 평화롭네요……」
						PRINTFORMW 「……뭐, 무슨 일이 생기면 좋다는 건 아니지만요」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「……음, 뭘 하려고 했던 걸까요……?」
						PRINTFORMW 「요즘 자꾸 건망해지곤 해요……」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「닭들을 위해 제가 할 수 있는 일은 무엇일까요...?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「저... 저도 신이니까 여러분 조금 더 존경해 주시면 안 될까요...」
					ELSE
						PRINTFORMW 「매일 아침 울리는 것도 힘들어요?」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「무슨 용무이신가요?」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「무슨 일이 있으신가요?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「몸 조심해 주세요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「음음... 저에게 용무라도 있으신가요?」
					ELSE
						PRINTFORMW 「재미있는 일이라도 있었나요?」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
