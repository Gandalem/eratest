@M_KOJO_SUCCESS_COM_K129_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K129_302
CALL M_KOJO_MESSAGE_COM_K129_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「만지지 마세요!」
			PRINTFORMW 쿠타카는 스킨십에 대해 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......변태......!」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「그만두세요!」
			PRINTFORMW 쿠타카는 화난 표정으로 항의한다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「후훗, 등, 크네요♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「제가 등을 밀어 드릴 테니까요!」
		ELSE
			PRINTFORMW 「음, 의외로 근육이 붙어 있네요... 깨끗하게 해드리죠!」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「뭐예요, 정말~♪」
			PRINTFORMW 쿠타카는 그렇게 말하면서도 날개를 파닥거리며 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 즐기고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 기분 좋아요...」
			PRINTFORMW 쿠타카는 그렇게 말하며 %CALLNAME:MASTER%에 기대고 있다.
		ELSE
			PRINTFORMW 「후훗, 더 가까이 다가와도 되는데요?」
			PRINTFORMW 쿠타카는 그렇게 말하며 안아왔다.
			PRINTFORMW 「저는 %CALLNAME:MASTER%씨의 것이니까요!」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「그런 거 할 거라면 나도 더 만지게 해줘요! 에이!」
			PRINTFORMW 그렇게 말하며 쿠타카는 %조사처리(CALLNAME:MASTER,"에게")% 안겼다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 거...... 좋아해요......♪」
