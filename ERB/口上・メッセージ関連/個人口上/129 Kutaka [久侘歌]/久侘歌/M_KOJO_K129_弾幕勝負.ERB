; Modular ERB: 個人口上/129 Kutaka [久侘歌]/久侘歌/M_KOJO_K129_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K129_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「네놈에게도 지옥을 보여주마!!!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「나의 시련을 받고 싶으신가요? 좋아요!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「지옥에 가기 전에 지옥을 보여주마!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「자! 지옥을 마음껏 즐겨주세요!」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%씨! 승부다!」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「음음... 해주시는군요!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아파요!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「......잘하시네요!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「역시 그렇군요!」
				ELSE
					PRINTFORMW 「실력은 충분하다는 쪽이네요……」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...너무하네요!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「역시 강하시네요」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아직부터 시작입니다!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「궁지에 몰렸지만 아직 지지 않았어요!」
				ELSE
					PRINTFORMW 「조금만 봐주면 안 될까……」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...바보냐!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「신님인데……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「오, 대단하시군요……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「우으, 너무하네……」
				ELSE
					PRINTFORMW 「죽었어ー!」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...어리석군요」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「컨디션이 안 좋았던 걸까요?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「너무 무리하지 말아 주세요?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「몸은 괜찮으세요?」
				ELSE
					PRINTFORMW 「부상 같은 건 없으신가요?」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「별일 없었습니다.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「당신이라면 지옥에 가도 순식간에 죽지는 않을 거예요.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「상당한 분이시네요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「잘 하시네요! %CALLNAME:MASTER%씨!」
				ELSE
					PRINTFORMW 「단련이 부족해요~」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...... 귀찮게 해줬군요!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「정말, 정말 인간이신가요?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「역시 강하시네요……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%씨라면 지옥에 가도 싸울 수 있을지도 모르겠네요」
				ELSE
					PRINTFORMW 「내 시련을 견딜 수 없다면 안 되죠?」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……분하다」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「저, 항복합니다...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「그 정도 실력이면 지옥의 귀신에게도 상대가 될지도 모르겠네요.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아얏... 강하시네요...」
				ELSE
					PRINTFORMW 「……졌습니다」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
