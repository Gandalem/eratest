; Modular ERB: 個人口上/129 Kutaka [久侘歌]/久侘歌/M_KOJO_K129_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K129
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
	ELSE
		PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		PRINTFORMW 「가슴에서 모유가 나왔어요 %UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSE
			PRINTFORMW 「음~~~~! %UNICODE(0x2665) *1%」
			PRINTFORMW 쿠타카는 목소리조차 나오지 않는 신음을 내며 엄청난 쾌감에 몸을 떨고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 안돼앳%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「으응읏%UNICODE(0x2665) *1% 앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응 아앗 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%응응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 안 돼애 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「으응%UNICODE(0x2665) *1%읏%UNICODE(0x2665)*1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%읏읏읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아아%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%가버려요옷%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「싫어앗%UNICODE(0x2665) *1% 머리가 바보가 되어버려요앗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「으응%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%좀 더 주세요앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「으앗%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「좀 더어%UNICODE(0x2665) *1% 해주세요읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1% 가버려앗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｃ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응앗 %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「야앗%UNICODE(0x2665) *1% 민감하단 말이에요……%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「으응읏%UNICODE(0x2665) *1%안 돼앳%UNICODE(0x2665)*1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
			PRINTFORMW (가버립니다 %UNICODE(0x2665) *1%)
		ELSE
			PRINTFORMW 「후앗%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 엉덩이읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「엉덩이 구멍에서 바보가 되어버릴 거예요 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「좀 더엇%UNICODE(0x2665) *1% 엉덩이를 만져 주세요읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「윽%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%가슴은 민감하단 말이에요읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「가슴 안 돼 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「더엇%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 쿠타카는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW (입으로 해버렸어...... %UNICODE(0x2665) *1%)
		ELSEIF RAND:4 == 0
			PRINTFORMW 「음! %UNICODE(0x2665) *1%입안이 기분 좋아요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「음~~~앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「～～～っ%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「더욱 입까지 %CALLNAME:MASTER%님의 것이 되게…….」
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K129
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;あなたが射精したときに関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K129_00
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K129_00(ARG)
;-------------------------------------------------
;TARGETの手による射精で、射精対象が非TARGET
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF RAND:3 == 0
		PRINTFORMW 「손으로 해버렸네요 %UNICODE(0x2665) *1%」
		RETURN 1
	ELSEIF RAND:2 == 0
		PRINTFORMW 「후훗, 손이 축축해져 버렸어요%UNICODE(0x2665) *1%」
		RETURN 1
	ELSE
		PRINTFORMW 「내 손, 기분 좋았나요?」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K129_0
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K129_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
