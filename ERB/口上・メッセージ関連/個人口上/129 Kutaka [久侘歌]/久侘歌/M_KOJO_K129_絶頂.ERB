	IF RAND:3 == 0
		PRINTFORMW 「음……고무 한 잔 주세요……%UNICODE(0x2665) *1%」
		RETURN 1
	ELSEIF RAND:2 == 0
		PRINTFORMW 「고무가 빵빵합니다%UNICODE(0x2665) *1%」
		RETURN 1
	ELSE
		PRINTFORMW 「……이런 걸 생으로 받으면 임신해 버릴 거예요♪」
		RETURN 1
	ENDIF
