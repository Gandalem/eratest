@M_KOJO_SPEVENT_K129_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
IF LOCAL
	PRINTFORMW 「%CALLNAME:MASTER%씨, 오늘은 정말 즐거웠어요!」
	PRINTFORMW 쿠타카는 그렇게 말하며 %CALLNAME:MASTER%앞을 걸었다.
	PRINTFORMW 「그래서 말이죠... 저... %조사처리(CALLNAME:MASTER,"에게")%―――」
	PRINTFORMW 조심스럽게 말을 꺼낸 쿠타카는 %CALLNAME:MASTER%쪽으로 돌아보며 살짝 몸을 숙여 입맞춤을 나눴다.
	PRINTFORMW 「음응... 오늘의... 감사예요... 정말, 제 입술 같은 건 아무 가치가 없을지도 모르지만」
	PRINTFORMW 「이것이 저의 최선이에요... 그럼, 오늘은 여기서 헤어져야겠어요」
	PRINTFORMW 그녀는 그렇게 말하며 작별을 고했다.
	PRINTFORMW (이번에는 키스가 아니라...)
	PRINTFORMW 가슴께에 손을 댄 그녀는 조금 용기를 얻은 듯했다.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K129_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1129)
			PRINTFORMW 「%CALLNAME:MASTER%, 저의 이야기를 들어주지 않겠어요?」
			PRINTFORMW 쿠타카는 평소와 달리 긴장한 말투로 말을 걸어왔다.
			PRINTFORMW 「저... 지금, 행복해요!」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 함께 보내는 매일이 정말 즐거워요!」
			PRINTFORMW 「그래서... 그래서 하나만 더 부탁을 들어주지 않겠어요...?」
			PRINTFORMW 그녀는 가슴을 꽉 누르며 말을 짜냈다.
			PRINTFORMW 「저, 저는, 저를―――」
			PRINTFORMW 
			PRINTFORMW 「―――%조사처리(CALLNAME:MASTER,"의")% 연인이 되어 주지 않겠습니까」
			PRINTFORMW 
			PRINTFORMW 「나, %조사처리(CALLNAME:MASTER,"랑")% 앞으로도……」
			PRINTFORMW 「앞으로도 함께 여러 곳에 가고 데이트하고 그리고……!」
			PRINTFORMW 그렇게 말하며 얼굴을 붉히고 고개를 숙였다가, 얼굴을 들자
			PRINTFORMW 「나로는 안 될까요? 저도 %조사처리(CALLNAME:MASTER,"를")% 행복하게 해드릴게요! 약속해요!」
			PRINTFORMW 「그러니까……저랑 연인이 되어 주세요!」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 가슴팍에 필사적으로 매달렸다.
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 한 번 더 말할게요」
			PRINTFORMW 쿠타카는 가슴에 손을 얹고 각오를 다진 듯 말을 이었다.
			PRINTFORMW 「정말 좋아해요, 사랑해요, 그러니까…… 사귀어 주지 않겠어요?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「......정말로, 저와 연인이 되어 주시는 건가요......?」
		PRINTFORMW 쿠타카는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 안겨온다.
		PRINTFORMW 「네! 쿠타카는 세계 최고의 행복한 사람이에요!」
		PRINTFORMW 그리고 그녀는 %조사처리(CALLNAME:MASTER,"의")% 입술에 자신의 입술을 포개어왔다......
		PRINTFORMW 「이것은......행복의 나눔이에요 %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……그렇습니까…… 폐가 되죠……」
		PRINTFORMW 쿠타카는 슬픈 듯 고개를 떨구었다.
		PRINTFORMW 「죄송해요…… 하지만……」
		PRINTFORMW 말은 이어지지 못했고, 그녀는 %CALLNAME:MASTER%로부터 멀어져 갔다.
		PRINTFORMW (나 같은 존재는…… 어울리지 않는 걸까……)
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K129_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……안녕이세요!」
			PRINTFORMW 쿠타카는 통통 화를 내며 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「오늘은 이제 끝인가요……」
			PRINTFORMW 「내일 또…… 데이트해 주세요…… 약속이에요?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「또... 데이트해 주세요」
		ELSEIF TALENT:思慕
			PRINTFORMW 「오늘은 정말 즐거운 날이었어요!」
		ELSE
			PRINTFORMW 「오늘은 정말 감사했어요, 또 데이트해요」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
