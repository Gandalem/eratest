@M_KOJO_EVENT_K129_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;今日会ってない。
	IF !TCVAR:129:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:129:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「안녕하세요, 무슨 용건이신가요?」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K129
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「......무슨 용무세요!? 오지 마세요!」
					;屋外かつ満月
				ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					PRINTFORMW 「오늘은 정말, 달이 아름답네요……」
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%님, 저랑 앞으로도 계속 함께 있어 주세요…………약속이에요?」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「……방금 일은 못 들은 걸로 해주세요! 절대로예요!」
					ENDIF
					;台風
				ELSEIF FLAG:異常気象 == 9
					PRINTFORMW 「%CALLNAME:MASTER%씨! 오늘은 위험하니까... 방에서 조용히 있자!」
					IF TALENT:恋人
						PRINTFORMW 「...이왕 이렇게 된 거... 둘만이라서... 말이야%UNICODE(0x2665) *1%」
					ENDIF
					;猛吹雪
				ELSEIF FLAG:異常気象 == 10
					PRINTFORMW 「%CALLNAME:MASTER%씨! 오늘은 눈보라가 치고 있으니... 방에서 따뜻하게 지내요!」
					IF TALENT:恋人
						PRINTFORMW 「제가 따뜻하게 해 드릴 테니, 안심해 주세요%UNICODE(0x2665) *1%」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「자랑은 아니지만 저는 사람을 따뜻하게 해주는 게 자신 있어요!」
						PRINTFORMW 「그래서... 그게... 추워지면 가까이 와 주세요...♪」
					ENDIF
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕하세요!」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요!」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요!」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%씨, 오늘도 멋진 하루를 보내요♪」
						PRINTFORMW 쿠타카는 작게 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
					ELSEIF TALENT:恋慕
						PRINTFORMW 「%CALLNAME:MASTER%님, 오늘도 행복한 하루가 되면 좋겠네요♪」
						PRINTFORMW 쿠타카는 작게 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
					ELSEIF TALENT:思慕
						PRINTFORMW 「%CALLNAME:MASTER%씨, 이런 곳에 무슨 용무 있으신가요?」
					ELSE
						PRINTFORMW 「%CALLNAME:MASTER%씨, 오늘도 하루 힘내요!」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:129:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「안녕하세요, 무슨 용건이신가요?」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K129
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「......이런 곳에 계셨나요, 최악이네요」
					;屋外かつ満月
				ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					PRINTFORMW 「오늘은 정말, 달이 아름답네요……」
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%씨, 저랑 앞으로도 계속 함께 있어 주세요... 약속이에요?」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「……방금 일은 못 들은 걸로 해주세요! 절대로예요!」
					ENDIF
					;台風
				ELSEIF FLAG:異常気象 == 9
					PRINTFORMW 「%CALLNAME:MASTER%씨! 오늘은 위험하니까... 방에서 조용히 있자!」
					IF TALENT:恋人
						PRINTFORMW 「...이왕 이렇게 된 거... 둘만이라서... 말이야%UNICODE(0x2665) *1%」
					ENDIF
					;猛吹雪
				ELSEIF FLAG:異常気象 == 10
