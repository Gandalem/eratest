;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K129_150
CALL M_KOJO_MESSAGE_COM_K129_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「으, 억지로 가슴에...!?」
		RETURN 1
	ENDIF
	;基本セット
	;胸3以上
	IF ABL:胸 > 2
		IF RAND:3 == 0
			PRINTFORMW 「가슴을 범당했어요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW (억지로 당하는 것도 어쩐지 느껴져 버립니다... %UNICODE(0x2665) *1%)
		ELSE
			PRINTFORMW 「음... 이렇게 가슴으로 비벼지는 걸 좋아하다니, 정말 굉장한 가슴의 별인 당신이네요♪」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「박동하고 있어서 뜨거워요... %CALLNAME:MASTER%님을 느낍니다...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아, 너무 무리하게는…!」
		ELSE
			PRINTFORMW 「응... 조금 아파요...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
