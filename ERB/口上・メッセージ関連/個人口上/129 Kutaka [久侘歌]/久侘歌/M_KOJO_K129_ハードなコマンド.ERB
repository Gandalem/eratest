;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K129_140
CALL M_KOJO_MESSAGE_COM_K129_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「응...! 응으~~~!」
		PRINTFORMW 「억지로... 거기를 밀어 넣지 말아 주세요... %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「음~%UNICODE(0x2665) *1%」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목으로 능숙하게 그것을 재촉한다.
			PRINTFORMW (빨리 %CALLNAME:MASTER%씨의 정자로 채워지고 싶어...%UNICODE(0x2665) *1%)
		ELSEIF RAND:2 == 0
			PRINTFORMW 「ん%UNICODE(0x2665) *1%ん%UNICODE(0x2665) *1%」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목으로 능숙하게 그것을 부추고 있다.
		ELSE
			PRINTFORMW 「んん읏%UNICODE(0x2665) *1%ん%UNICODE(0x2665) *1%」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목으로 능숙하게 그것을 재촉했다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음음~!」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"에게")% 성기를 박히고 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응음... 음~~~~!!!」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"에게")% 성기를 박히고 신음하고 있다.
		ELSE
			PRINTFORMW 「음~!!!」
			PRINTFORMW 쿠타카는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 박히고 신음하고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
