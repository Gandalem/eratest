@M_KOJO_MESSAGE_COM_K129_40
CALL M_KOJO_MESSAGE_COM_K129_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음... 간지러워요」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응%UNICODE(0x2665) *1%앗%UNICODE(0x2665) *1%민감하단 말이에요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「거기... 야앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「더 맞춰주세요 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
