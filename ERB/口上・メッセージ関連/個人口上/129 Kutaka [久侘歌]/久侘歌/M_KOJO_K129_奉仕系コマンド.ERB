	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「음……%UNICODE(0x2665) *1%……れろ……%UNICODE(0x2665) *1%」
				PRINTFORMW 「……맛있다……%UNICODE(0x2665) *1%」
