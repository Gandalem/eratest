;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K129_80
CALL M_KOJO_MESSAGE_COM_K129_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K129_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「저기... 잘 할 수 있을지 모르겠지만...」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「많이 내주세요... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후훗 벌써 나올 것 같나요?」
		ELSE
			PRINTFORMW 「거기 떨리고 있잖아... 참아야 해요 %UNICODE(0x2665) *1%」
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:3 == 0
			PRINTFORMW 「참을 수 없는 나쁜 거시기에게 이렇게 드리겠습니다%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 잔뜩 기분 좋아져 주세요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「지금 기분 좋게 해드리니까요%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「손으로 문지르면 되는 건가요...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「으윽... 그다지 자신은 없지만...」
		ELSE
			PRINTFORMW 「어떠세요...?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
