			ELSEIF RAND:2 == 0
				PRINTFORMW 「음...%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응응」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음……츄루루……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……이런 느낌인가요?」
		ELSEIF RAND:2 == 0
