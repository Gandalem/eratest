;育児イベント食事時。
;-------------------------------------------------

@M_KOJO_EVENT_K42_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
IF ARGS == "授乳"
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「많이 마시는구나아. 잘한다아. 계속 먹어~♪」
			PRINTFORML %CHILDNAME:42:(TALENT:TARGET:育児中)%는 열심히 하타테의 젖을 빨고 있다.
			PRINTW 
		CASE 1
			PRINTFORML 「뭐야? %MASTERNAME:42%도 가슴 원하는 거야?」
			PRINTFORML 「하지만 지금은 이 아이 밥이니까 안 돼~♪」
			PRINTW 
		CASE 2
			PRINTFORML 「아, 어느 쪽이 아기인지 모르겠네…… 읏…… %UNICODE(0x2665) *1%」
			PRINTFORML 하타테는 한쪽 가슴을 %CHILDNAME:42:(TALENT:TARGET:育児中)%에게, 다른 쪽 가슴을 %조사처리(CALLNAME:MASTER,"에게")% 빨리고 있다.
	ENDSELECT
ELSEIF ARGS == "離乳食"
	SELECTCASE RAND:5
		CASE 0
			PRINTFORML 「네, 아—앙♪」
			PRINTFORML 「야옹~, 작은 입으로 오물오물하는 거야~ 귀여워~♪」
			PRINTW 
			PRINTFORML 하타테는 모구모구 입을 움직이는 %CHILDNAME:42:(TALENT:TARGET:育児中)%에게 완전히 빠진 듯하다.
			PRINTFORML 
		CASE 1
			PRINTFORML 「에부우……」
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아아, 토해버렸다. 맛있지 않았나 봐~」
					PRINTW 
					PRINTFORML 육아서에 따르면, 맛뿐만 아니라 식감이 마음에 들지 않아도 토해버린다고 한다.
					PRINTFORML 하타테와, 더 걸쭉하게 해야 할지, 단맛이 있는 채소로 바꾸는 편이 좋지 않을까 하며 두 사람이 상의했다...
					PRINTW 
				CASE 1
					PRINTFORML 「또 토하게 했어~ 이제 싫어~~~~!」
					PRINTFORML 하타테는 애써 만든 이유식을 몇 번이고 토하게 당하고, 마침내 소리를 내고 말았다.
					PRINTW 
					PRINTFORML 시쿠시쿠 울고 있는 하타테를 안아 달래고 있자니, 이번에는 %CHILDNAME:42:(TALENT:TARGET:育児中)%까지도 울기 시작했다.
					PRINTFORML 한 손에는 하타테를, 다른 손에는 %CHILDNAME:42:(TALENT:TARGET:育児中)%를 안고, 어찌할 바를 몰라 막막해졌다...
					PRINTW 
			ENDSELECT
		CASE 2
			PRINTFORML 「배부르게 먹었지~♪ 자, 트림하자♪」
			PRINTFORML 하타테는 %CHILDNAME:42:(TALENT:TARGET:育児中)%를 안아 올리며, 등을 톡톡 두드렸다
			PRINTW 
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 크어억!
					PRINTFORML 「푸슉, 크크큭, 아하하하하핫! 뭐야 방금 그거, 아저씨 냄새 나잖아! 개웃겨어~!」
					PRINTFORML %CHILDNAME:42:(TALENT:TARGET:育児中)%가 성대한 트림을 한 것이 유독 웃겼는지, 하타테는 배를 잡고 크게 웃고 있다.
					PRINTW 
				CASE 1
					PRINTFORML 꾸역!
					PRINTFORML 「와, 와아... %CHILDNAME:42:(TALENT:TARGET:育児中)%가 토했어!? 병이야!? 어, 어떻게 해...!?」
					PRINTW 
					PRINTFORML 그러나, %CHILDNAME:42:(TALENT:TARGET:育児中)%는 생기가 넘치고 안색도 좋다.
					PRINTFORML 아마도 이유식을 너무 많이 먹다가 토해낸 것 같다.
					PRINTW 
					PRINTFORML 「그, 그런가…… 깜짝 놀랐어…… 자꾸 너무 많이 먹으니까…… 조심해야겠다」
					PRINTFORML %CHILDNAME:42:(TALENT:TARGET:育児中)%의 토사물을 처리하면서, 두 사람이 함께 생각해보자고 고개를 끄덕였다.
					PRINTW 
				CASE 2
					PRINTFORML 커훕
					PRINTFORML 「응후훗♪ 아, 정말 왜 트림까지 귀여운 거야, 너는—♪」
					PRINTFORML 하타테는 완전히 %CHILDNAME:42:(TALENT:TARGET:育児中)%에게 홀린 듯하다.
			ENDSELECT
		CASE 3
			PRINTFORML 「아빠, 밥 주는 거 정말 잘한다~... 어라, 왜 그래요?」
			PRINTFORML 「많이 안 먹은 거예요? 병원인가~... 그래도 이 아이 얼굴색도 좋고 기분도 좋아 보여요?」
			PRINTW 
			PRINTFORML 「……단순히 그런 기분이 아닌가?」
			PRINTFORML 그런 일도 있는 건가! 눈이 번쩍 떠지는 기분이야.
			PRINTFORML 「뭐, 나를 보고 있으면 그렇게 생각할 만도 하지~♪ 이 아이, 나랑은 다르게 입맛이 까다로운 건가 봐.」
			PRINTW 
		CASE 4
			PRINTFORML 「아빠~, %CHILDNAME:42:(TALENT:TARGET:育児中)%가 먹고 있어...? 응, 그 모습으로는 안 될 것 같네~」
			PRINTFORML 곤란해진 자신의 모습을 보고, 하타테가 쓴웃음을 짓는다.
			PRINTW 
			PRINTFORML 「그런 때는, 먹는 방식에 놀이를 넣어보는 건 어때?」
			PRINTFORML 놀이요?
			PRINTW 
			PRINTFORML 「잠깐 빌려봐도 돼? 입을~~~ 아아앙♪」
			PRINTFORML 하타테는 이유식이 담긴 숟가락을 %CHILDNAME:42:(TALENT:TARGET:育児中)% 앞에서 수평으로 돌리며, 스윽 입 앞으로 가져갔다.
			PRINTFORML 그러자, 방금까지 완고했던 %CHILDNAME:42:(TALENT:TARGET:育児中)%의 입이 아아앙 하고 벌어졌다.
			PRINTW 
			PRINTFORML 「자, 힘내라♪ 잘 먹었네~ 대단하다~♪」
			PRINTFORML 자신이 필요했을 때는 먹어주지 않았는데! 충격이다...
			PRINTW 
			PRINTFORML 「이리 봐, 슬퍼하지 마♪ 아기는 나보다도 기분 변화가 심하잖아~♪」
			PRINTFORML 「내가 같이 있어 주잖아, 해도 괜찮은 실수라면 마음껏 해 봐? 그거면 충분하잖아~♪」
			PRINTW 
			PRINTFORML 하타테에게 격려받아 다시 힘내야겠다는 기분이 들었다. 자, 아앙…
			PRINTFORML 하타테는 옆에서 방긋거리며 지켜봐 주고 있었다…
			PRINTW 
	ENDSELECT
ELSEIF ARGS == "幼児期"
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「밥 먹는 것 잘하게 됐네~♪」
			PRINTFORML 지금까지 손으로 먹던 %CHILDNAME:42:(TALENT:TARGET:育児中)%가 스푼을 능숙하게 사용하며 먹고 있다
			PRINTW 
		CASE 1
			PRINTFORML 「야~ 그런 말 하지 마, 아까운 요정이 나타난단 말이야~」
			PRINTFORML 음식을 가리는 %CHILDNAME:42:(TALENT:TARGET:育児中)%에게 하타테는 온갖 방법을 동원해 먹이려고 애쓰고 있다
			PRINTW 
		CASE 2
			PRINTFORML 질척
			PRINTFORML 「아아아, 접시 안에 얼굴을 파묻어 버리고……」
			PRINTFORML 배가 뭉개져 잠들어 버린 %CHILDNAME:42:(TALENT:TARGET:育児中)%를 보고 하타테는 쓴웃음을 짓는다.
			PRINTW 
	ENDSELECT
ELSEIF ARGS == "幼少期"
	IF SELECTCOM == 617
		PRINTFORML 「달콤한 것, 맛있어~♪」
		PRINTFORML 하타테와 %CHILDNAME:42:(TALENT:TARGET:育児中)%는 달콤한 것을 맛보며 환하게 웃고 있다.
		PRINTW 
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML '아빠에게도 줘'라며 %CHILDNAME:42:(TALENT:TARGET:育児中)%에게 조르자,
				PRINTFORML 「야—!」라며 거절당해 버렸다. 슬프다….
				PRINTFORML 하타테는 그 모습을 보며 깔깔거리고 웃고 있다
				PRINTW 
			CASE 1
				PRINTFORML 두 사람의 모습을 따뜻하게 지켜보고 있자니,
				PRINTFORML %CHILDNAME:42:(TALENT:TARGET:育児中)%가 「아빠에게도!」라며 미소로 숟가락을 내밀어 왔다.
				PRINTW 
			CASE 2
				PRINTFORML 아빠 것도 한입 주려고 %CHILDNAME:42:(TALENT:TARGET:育児中)%에게 건네자,
				PRINTFORML 대부분을 먹혀서, 하타테에게 웃음을 당해버렸다...
				PRINTFORML 「커다란 한 입이네애」
		ENDSELECT
	ELSEIF SELECTCOM == 610
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「밖에 먹는 밥도 맛있네~♪」
				PRINTFORML 「응?♪」
				PRINTFORML 하타테와 %CHILDNAME:42:(TALENT:TARGET:育児中)%는 행복함이 가득한 표정으로 밥을 먹고 있다.
				PRINTW 
			CASE 1
				PRINTFORML 「엄마 것 이거랑, %CHILDNAME:42:(TALENT:TARGET:育児中)% 거 저거, 바꿔줬으면 좋겠다아~♪」
				PRINTFORML 하타테는 교환하는 모습을 보이면서, %CHILDNAME:42:(TALENT:TARGET:育児中)%에게 좋아하는 음식을 주고 있다
				PRINTW 
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「자, 두 손을 모아주시겠어요~!」
				PRINTFORML %CHILDNAME:42:(TALENT:TARGET:育児中)%는 맛있게 하타테 손요리를 먹고 있다
				PRINTW 
			CASE 1
				PRINTFORML 「아~, 채소 남겼어~ 제대로 안 먹으면 병 걸린다고~」
				PRINTFORML 채소를 먹이고 싶은 하타테와 먹고 싶지 않은 %CHILDNAME:42:(TALENT:TARGET:育児中)%가 공방을 벌이고 있다...
				PRINTW 
			CASE 2
				PRINTFORML 「오늘은 어떤 거 하면서 놀았어? 후음, 즐거웠어? 그래, 좋았구나~♪」
				PRINTFORML 오늘 있었던 일을 보고하는 %CHILDNAME:42:(TALENT:TARGET:育児中)%를, 하타테는 상냥한 눈빛으로 바라보고 있다.
				PRINTW 
		ENDSELECT
	ENDIF
ELSEIF ARGS == "就学"
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 하타테는 능글거리며 %CHILDNAME:42:(TALENT:TARGET:育児中)%를 보고 있다
			PRINTW 
			PRINTFORML 「음...? 너도 채소 가리지 않고 먹게 된 거구나아……」
			PRINTFORML 「나에게는 %CHILDNAME:42:(TALENT:TARGET:育児中)%는 언제나 나의 아이야. 지금까지도, 앞으로도 말이야」
			PRINTFORML 하타테의 말에 아무 말 없이 고개를 끄덕였다.
			PRINTW 
		CASE 1
			PRINTFORML 「다이어트~? 밥 줄이는 것보다는 제대로 먹고 제대로 운동하렴.」
			PRINTFORML 「대체 너는 성장기잖아. 밥 같은 걸 거르면 몸에 안 좋아지니까.」
			PRINTW 
			LOCALS:0 = 
			IF CHILD_SEX:42:(TALENT:42:育児中) == 1
				LOCALS:0 '= @"남자아이"
			ELSE
				LOCALS:0 '= @"소녀"
			ENDIF
			PRINTFORML 「아~, 너 혹시 좋아하는 %LOCALS:0%라도 생긴 거야~?」
			PRINTFORML 「뭐야- 그런 일 있을 리가 없잖아♪ 있잖아, 어떤 애인데? 엄마한테 알려줘?」
			PRINTW 
		CASE 2
			IF ABL:料理技能 >= 2
				PRINTFORML 「『엄마 요리는 항상 맛있어』? 우후후, 고맙다%UNICODE(0x2665) *1%」
				PRINTFORML 「%CHILDNAME:42:(TALENT:TARGET:育児中)%들이 맛있다 맛있다라고 말해주니까, 매일 밥 만들기 열심히 할 수 있는 거야」
				PRINTW 
			ELSEIF ABL:料理技能 >= 1
				PRINTFORML 「『같은 요리에는 질렸어...』라니, 불평하지 마!」
				PRINTFORML 「식단을 짜는 것도 꽤 힘든 일이니까. 불만이라면 매일 세 끼 우동으로 해줄 거야!」
				PRINTFORML 싫지는 않지만, 그건 아무리 그래도…
				PRINTW 
			ELSE
				PRINTFORML 「『언제까지 요리가 늘지 않아……』라니, 너마저 아빠 같은 소리 하네! 우와앙!」
				PRINTW 
			ENDIF
	ENDSELECT
ELSEIF ARGS == "自立前"
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「너랑 이렇게 같이 밥 먹는 것도, 얼마 안 남았네에」
			PRINTFORML 「혼자 살게 돼도, 밥은 제대로 먹어야 해」
			PRINTW 
		CASE 1
			PRINTFORML 「무슨 일이야, 갑자기. '엄마 손맛 요리가 먹고 싶다'라니?」
			PRINTFORML 「그런 부탁 안 해도, 언제든지 만들어 줄게. 나는 너의 부모잖아.」
			PRINTW 
		CASE 2
			IF ABL:料理技能 >= 3
				PRINTFORML 「혼자 살게 됐다고, 돌아오는 게 안 된다는 규칙 같은 건 없어~」
				PRINTFORML 「엄마 요리가 먹고 싶어지면, 언제든지 돌아오렴. 여긴 네 집이니까」
				PRINTFORML 「그때는, 네가 제일 좋아하는 것들 잔뜩 차려줄게♪」
				PRINTW 
			ELSEIF ABL:料理技能 >= 1
				PRINTFORML 「돈이 궁해지면, 일단 콩나물을 사 두는 게 좋아」
				PRINTFORML 「콩나물은 뭐든지 활용할 수 있으니까 편리하거든. 대신 자라는 속도가 빠르니까 조심해야 돼」
				PRINTW 
			ELSE
				PRINTFORML 「『엄마의 맛없는 요리로부터 드디어 해방된다……』라니, 너 정말 무례한 소리 하는구나」
				PRINTW 
			ENDIF
	ENDSELECT
ENDIF
