;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K42_100
CALL M_KOJO_MESSAGE_COM_K42_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 파앙!
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「아파아! %MASTERNAME:42%, 뭐 하는 거야아~~」
			PRINTW 
			PRINTFORML 너무 예쁜 엉덩이라서, 나도 모르게……
			PRINTFORML 「여자애 엉덩이 때리는 거, %MASTERNAME:42%, 너무하잖아!」
			PRINTW 
		ELSE
			PRINTFORML 「앗! 뭐 하는 거야...!」
			PRINTW 
			PRINTFORML 좋은 엉덩이라서, 나도 모르게….
			PRINTFORML 「자꾸만이라니! 장난치지 말라고 했잖아!」
			PRINTW 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		IF TALENT:TARGET:マゾ == 1 || ABL:TARGET:マゾっ気 >= 2
			IF TEQUIP:Ｖセックス
				PRINTFORML 「앗%UNICODE(0x2665) *1% 하아앗%UNICODE(0x2665) *1% 좋아앗%UNICODE(0x2665) *1% 더읏%UNICODE(0x2665) *1%」
				PRINTFORML 하타테가 섹스에 취한 틈을 타, 무의식적으로 그녀의 엉덩이를 주무르고 있었다.
				PRINTW 
				PRINTFORML 무엇이라고 할 수 없는 기분 좋은 감촉이다. 몸매가 좋구나…
				PRINTFORML 거의 무의식적으로 하타테의 엉덩이를 손바닥으로 때린다. 파앙 하는 듣기 좋은 소리가 울려 퍼졌다.
				PRINTW 
				PRINTFORML 「캬응읏%UNICODE(0x2665) *1%」
				PRINTFORML 「아... 나, 아냐. 지금 건, 넣어지는 게 기분 좋아서...」
				PRINTW 
				PRINTFORML 하타테는 그렇게 변명했지만, 명백히 추삽과는 다른 타이밍에서의 신음소였다.
				PRINTFORML 아무래도 하타테는 맞으면서 기뻐하는 변태인 것 같다.
				PRINTW 
			ELSEIF TEQUIP:Ａセックス
			ELSE
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 짝!
					PRINTFORML 「아얏. 잠깐, 여자애 엉덩이를 함부로 때리지 마아~」
					PRINTW 
				CASE 1
					PRINTFORML 파앙!
					PRINTFORML 「아얏! 뭐야애!」
					PRINTW 
					PRINTFORML 퍽!
					PRINTFORML 「아파...! 그러니까, 그만……」
					PRINTW 
					PRINTFORML 파앙! 파앙!
					PRINTFORML 「꺅!? 아앗!? 너, 적당히 안 하면……」
					PRINTW 
					PRINTFORML 파팟!
					PRINTFORML 「제발 그만해, 이 바보!!!!」
					PRINTW 
					PRINTFORML 바시이이잉!
					PRINTFORML 하타테에게 세게 카운터를 받았다
			ENDSELECT
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
