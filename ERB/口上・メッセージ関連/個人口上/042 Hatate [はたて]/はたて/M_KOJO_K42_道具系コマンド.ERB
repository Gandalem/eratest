;46,アナルビーズ
;==================================================

@M_KOJO_MESSAGE_COM_K42_46
CALL M_KOJO_MESSAGE_COM_K42_46_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_46_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORML 「싫어읏, 그런 거 넣지 않아도 돼읏 그만해읏」
			PRINTFORML 「안돼앳! 아, 하, 들어오지 마... 흐윽, 으응」
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アナルビーズ
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF ABL:Ａ感覚 >= 5
		ELSEIF ABL:Ａ感覚 >= 2
		ELSE
			PRINTFORML 「싫어읏, 빼지 마, 엉덩이 뒤집어져 버릴 거야! 안돼, 안돼 안돼안돼!!」
			PRINTFORMW 「아」
			PRINTFORMW 「아아, 아...」
			PRINTFORMW 「아아아아아아~~~~~~~~!!」
			PRINTW 
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;47,ニプルキャップ
;==================================================

@M_KOJO_MESSAGE_COM_K42_47
CALL M_KOJO_MESSAGE_COM_K42_47_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_47_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORML 「뭐야? 젖병의 젖꼭기? 그런 게 왜 여기 있는 거야?」
			PRINTFORML 「야, 그거 왜 나한테 가까이 가져오는 거야... 엣? 엣?」
			PRINTW 
			PRINTFORML 「아파읏! 아타타타타탓! 젖꼭지 뜯겨버릴 것 같아!!」
			PRINTFORML 처음이라 그런지, 아직 기분 좋지는 않은 듯하다.
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:ニプルキャップ
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
		ELSE
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「안 좋은 건 아닌데…… 그거, 정말로 유두에 붙이는 게 아니지…?」
				PRINTFORML 「우으윽, 유두가 쪼여와……」
				PRINTW 
				RETURN 1
			ELSE
				PRINTFORML 「또 그 이상한 거 다는 거야……『가슴이 커진다』? 될 리 없잖아! 바보!」
				PRINTFORML 「흐으응, 젖꼭지, 떨어진다아읏」
				PRINTW 
				RETURN 1
			ENDIF
		ENDIF
		;解除
	ELSE
		IF ABL:Ｂ感覚 >= 3
			PRINTFORML 「아응, 해버릴 것 같잖아…… 아냐, 지금 건 아무것도 아니야!」
			PRINTW 
		ELSE
			PRINTFORML 「겨우 벗겨줬어~. 아, 이상한 거 붙이지 마라……」
			PRINTW 
		ENDIF
	ENDIF
ENDIF
RETURN 1
