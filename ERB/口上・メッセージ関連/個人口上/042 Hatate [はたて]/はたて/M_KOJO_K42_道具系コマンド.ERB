;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K42_50
CALL M_KOJO_MESSAGE_COM_K42_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF !TEQUIP:PLAYER:コンドーム ;for equip only
		RETURN 0
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORML 「이런 걸로 피임할 수 있는 거야? 엄청 얇잖아……」
			PRINTFORML 「인간의 기술이라는 게, 정말 대단하네……」
			PRINTW 
			PRINTFORML 「헤에... 그렇게 붙이는 거야~」
			PRINTFORML 하타테는 흥미진진한 모습으로 착용하는 모습을 지켜보고 있다.
			PRINTFORML ……조금 부끄러워.
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕 && TALENT:恋人
		IF TALENT:妊娠願望
			PRINTFORML 「에에~~, 붙여버리는 거야아~?」
			PRINTFORML 「자식(후손), 갖고 싶은데... %MASTERNAME:42%의 아기, 낳는 것 같은...」
			SIF ESTRUS_CYCLE(TARGET) == 150
				PRINTFORML 「하타테가 준비된 아기의 방에, 많이 채워줬으면 좋겠어...」
			PRINTW 
		ELSE
			IF ESTRUS_CYCLE(TARGET) == 15
				PRINTFORML 「오늘, 안전일이었는데도 제대로 착용해 주는구나」
				PRINTFORML 「%MASTERNAME:42%는 정말 든든하다니까♪」
				PRINTW 
			ELSEIF ESTRUS_CYCLE(TARGET) == 150
				IF CFLAG:TARGET:生解禁 == 2
					PRINTFORML 「에엣, 붙이는 거예요~?」
					PRINTFORML 「생쪽이 더 기분 좋잖아~? %MASTERNAME:42%는 하아, 하타테에게 씨를 뿌리고 싶지 않아~?」
					PRINTFORML 하타테가 가슴팍에 여덟 팔자 모양을 그리며 유혹해 왔다...
					PRINTW 
				ELSE
					PRINTFORML 「아, 제대로 착용해 주는구나~♪」
					PRINTFORML 「아기가 생기면 큰일나잖아. 거기는 제대로 해야지」
					PRINTW 
				ENDIF
			ELSE
				PRINTFORML 「안 끼면 뭔가 해버릴지도 모른단 말이야~♪」
				PRINTW 
			ENDIF
		ENDIF
	ELSEIF TALENT:恋慕 || TALENT:恋人
		IF TALENT:妊娠願望
			PRINTFORML 「에에~~, 붙여버리는 거야아~?」
			PRINTFORML 「자식(후손), 갖고 싶은데... %MASTERNAME:42%의 아기, 낳는 것 같은...」
			PRINTW 
		ELSEIF ESTRUS_CYCLE(TARGET) == 15
			PRINTFORML 「오늘, 안전일이었는데도 제대로 착용해 주는구나」
			PRINTFORML 「%MASTERNAME:42%는 정말 든든하다니까♪」
			PRINTW 
		ELSEIF ESTRUS_CYCLE(TARGET) == 150
			IF CFLAG:TARGET:生解禁 == 2
				PRINTFORML 「에엣, 붙이려고 하는 거예요…?」
				PRINTFORML 하타테는 불만인 듯했다…
				PRINTW 
			ELSE
				PRINTFORML 「아, 제대로 착용해 주는구나~♪」
				PRINTFORML 「아기가 생기면 큰일나잖아. 거기는 제대로 해야지」
				PRINTW 
			ENDIF
		ELSE
			PRINTFORML 「안 끼면 뭔가 해버릴지도 모른단 말이야~♪」
			PRINTW 
		ENDIF
		RETURN 1
	ELSEIF TALENT:思慕
		IF ESTRUS_CYCLE(TARGET) == 15
			PRINTFORML 「오늘 안전일이었는데, 제대로 착용해 주는구나」
			PRINTFORML 「%MASTERNAME:42%는 의외로 꼼꼼하게 해주는구나♪」
			PRINTW 
		ELSEIF ESTRUS_CYCLE(TARGET) == 150
			PRINTFORML 「아, 제대로 끼워주는구나~♪」
			PRINTFORML 「그런 부분들이 포인트가 높다구~♪」
			PRINTW 
		ELSE
			PRINTFORML 「안전일 외에는 제대로 착용해야지」
			PRINTFORML 「사실은 안전일에도 끼는 게 안 돼?」
			PRINTW 
		ENDIF
		RETURN 1
	ELSE
		RETURN 1
	ENDIF
ENDIF
RETURN 1
