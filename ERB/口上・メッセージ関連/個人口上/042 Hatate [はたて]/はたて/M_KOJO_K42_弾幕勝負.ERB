;

@M_KOJO_MESSAGE_COM_K42_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;判定値 -= (HANDICAP_FIXED + RAND:(HANDICAP_RAND))
	;戦闘前
	IF ABL:MASTER:戦闘能力 == 6
		HANDICAP_FIXED = 150
	ELSEIF ABL:MASTER:戦闘能力 == 5
		HANDICAP_FIXED = 100
	ELSEIF ABL:MASTER:戦闘能力 == 4
		HANDICAP_FIXED = 50
	ELSEIF ABL:MASTER:戦闘能力 == 2
		HANDICAP_FIXED = -50
	ELSEIF ABL:MASTER:戦闘能力 == 1
		HANDICAP_FIXED = -100
	ELSEIF ABL:MASTER:戦闘能力 == 0
		HANDICAP_FIXED = -200
	ENDIF
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「후응, 나랑 탄막 승부하고 싶구나」
		PRINTFORML 「나, 아야나 모미지처럼 거친 일에는 익숙하지 않은데…….」
		PRINTFORML 「뭐 그래도, 탄막 취재 연습에는 좋을지도 모르겠네.」
		PRINTW 
		PRINTFORML 「그렇지~ 그냥 하는 것만으론 재미없으니까~」
		PRINTFORML 「좋아, 나한테 이기면 특별히 하나 해줄게♪」
		PRINTFORML 「대신에-, 내가 이기면 부탁 하나 들어줘~♪」
		PRINTW 
		IF ABL:MASTER:戦闘能力 > 3
			LOCALS:0 = 
			IF TALENT:恋慕 || TALENT:恋人 || TALENT:思慕 || CFLAG:好感度 >= 500
				LOCALS:0 = %MASTERNAME:42%
			ELSE
				LOCALS:0 = 「너」
			ENDIF
			PRINTFORML 「잠깐만. 평범하게 하면 아마 %LOCALS:0%가 이길 거라고 생각해」
			PRINTFORML 「그럼 도박이 안 되겠네. 그래서 말이지. 짜잔!」
			PRINTW 
			PRINTFORML 하타테는 구속구 같은 것을 꺼내왔다. 어디에 숨겨 가지고 있었던 걸까.
			PRINTFORML 「이거? 모미지한테 빌렸는데 '슈터 교정 부고'라는 거야」
			PRINTFORML 에, '슈터 생성 부고'였나? 아무튼 뭐든 간에.
			PRINTW 
			PRINTFORML 「이거 입고 싸우면, 입은 사람의 힘을 제한할 수 있어서, 실력 차이를 메울 수 있대」
			PRINTFORML 「그래서, 이거 입고 승부해 줘~」
			PRINTW 
			PRINTFORML 「아, 일단 나도 모미지도 착용한 적이 있으니까 괜찮아, 괜찮아」
			PRINTFORML 「다만, 저기 손잡이를 너무 돌리면 큰일 날 거니까 조심하라고는 듣긴 했는데」
			PRINTFORML 「눈금은…… 응, 이 정도인가 봐. 어때? 움직일 수 있어? 오케이♪」
			PRINTW 
		ELSEIF ABL:MASTER:戦闘能力 < 3
			LOCALS:1 = 
			IF TALENT:恋慕 || TALENT:恋人 || TALENT:思慕 || CFLAG:好感度 >= 500
				LOCALS:1 = %MASTERNAME:42%
			ELSE
				LOCALS:1 = 「너」
			ENDIF
			PRINTFORML 「잠깐만. 평소대로 하면 아마 %LOCALS:1% 지게 될 것 같아」
			PRINTFORML 「그럼 내기할 것도 없잖아. 그래서 말이야. 짜잔!」
			PRINTW 
			PRINTFORML 하타테는 구속구 같은 것을 꺼내왔다. 어디에 숨겨 가지고 있었던 걸까.
			PRINTFORML 「이거? 모미지한테 빌렸는데 '슈터 교정 부고'라는 거야」
			PRINTFORML 에, '슈터 생성 부고'였나? 아무튼 뭐든 간에.
			PRINTW 
			PRINTFORML 「이거 입고 싸우면, 착용한 사람의 힘을 제한할 수 있어서, 실력 차를 메울 수 있다고 해」
			PRINTFORML 「그래서, 내가 이걸 입고 승부를 걸게」
			PRINTW 
			PRINTFORML 「아, 일단 나도 모미지도 착용한 적 있으니까 괜찮아 괜찮아」
			PRINTFORML 「다만, 거기 손잡이를 너무 돌리면 큰일 난다고 조심하라고 듣긴 했지만」
			PRINTFORML 「눈금은… 응, 이 정도인가 봐. 자, 해볼까♪」
			PRINTW 
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;運命のダイスロール！部分
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		IF HANDICAP_FIXED > 0
			PRINTFORML 어떤 원리인지는 모르겠지만, 하타테가 말한 대로 이 석고는 착용자의 능력에 제한을 거는 것 같다.
			PRINTFORML 사지에 추를 단 것 같은, 그런 느낌이다.
			PRINTW 
			PRINTFORML 그렇다고 해서 하타테에게 손발이 움직일 수 없는 듯한 제약이 걸리는 것도 아니다.
			PRINTFORML 과연, 그녀가 말한 것이 진실인 것 같다.
			PRINTW 
		ELSEIF HANDICAP_FIXED < 0
			PRINTFORML 평소 같으면 눈으로 쫓을 수 없는 하타테의 움직임도, 지금이라면 어떻게든 따라잡을 수 있다.
			PRINTFORML 아무래도 그녀가 말한 것은 사실인 것 같다.
			PRINTW 
			PRINTFORML 하지만, 그럴 마음만 먹으면 거짓말을 해서 속이는 것도 할 수 있었을 텐데
			PRINTFORML 의외로 열혈한 타입인 걸까. 정말 그녀는 가라스텐구치고는 변칙적인 존재인 것 같다
			PRINTW 
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「흠, 잘하네~. 하지만 아직 멀었다고!」
						PRINTW 
					CASE 1
						PRINTFORML 「아직이야~♪ 이 정도로는 쓰러지게 해줄 수 없잖아~」
						PRINTW 
					CASE 2
						PRINTFORML 「와아, 잘하잖아. 하지만 지면 안 되니까앗!」
						PRINTW 
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「와아아악, 이거 위험한 거 아냐?」
						PRINTW 
					CASE 1
						PRINTFORML 「야... 야바타니엔...」
						PRINTFORML 하타테의 표정에서 여유가 없어지고 있다. 앞으로 한 번 더 밀어붙일 것 같다.
						PRINTW 
					CASE 2
						PRINTFORML 「모~무리! 무리잖아읏!」
						PRINTW 
				ENDSELECT
			CASE 0
				SELECTCASE RAND:2
					CASE 0
						IF TALENT:恋慕 || TALENT:恋人 || TALENT:思慕
							PRINTFORML 「음~ 역시 %MASTERNAME:42%답네♪ 항복한 사무라이!」
							PRINTFORML 하타테는 만세하며, 항복의 의사를 보였다.
							PRINTW 
						ELSE
							PRINTFORML 「설마아...! 너 정말 강하네...」
							PRINTFORML 하타테는 눈을 동그랗게 뜨고 있다.
							PRINTW 
						ENDIF
					CASE 1
						PRINTFORML 「아앙, 지고 말았어—」
						PRINTFORML 하타테는 엉덩이를 바닥에 착 붙이고 어깨를 축 늘어뜨리고 있다
						PRINTW 
				ENDSELECT
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 「자아안네ㄴ♪ 하타테쨩의 압승이에요~♪」
				PRINTFORML 바닥에 대자로 누워 있는 자신을, 도야가오의 하타테가 위에서 들여다보았다.
				PRINTW 
				PRINTFORML ……%PANTSNAME(EQUIP:TARGET:下半身下着２, TARGET)%인가
				PRINTFORML 이쪽에서 완전히 보이는 것은 일부러 침묵한다
				PRINTW 
				IF MONEY > 1000
					PRINTFORML 「에헤헤~ 그럼 인간의 마을에서 맛있는 거 잔뜩 사줘!」
					PRINTFORML 「좋은 운동도 됐으니까, 많이 먹을 거야아~」
					PRINTW 
					PRINTFORML 이따가, 엄청나게 사줬어……
					PRINTFORML 지갑은 아팠지만, 하타테의 행복해 보이는 표정을 볼 수 있었으니까 아무 일 없었던 걸로 하자
					PRINTW 
					PRINTFORML 소지금이 %金額表示(500)% 줄었네...
					MONEY -= 500
				ELSE
					PRINTFORML 「%MASTERNAME:42% 돈이 부족하단 말이야... 아무래도 안 될까나~」
					PRINTFORML 「그럼 다음에 돈 있을 때 사줘. 약속♪」
					PRINTW 
				ENDIF
			CASE 2
				PRINTFORML 「꽤 재미있는 승부였지 않아?」
				PRINTW 
				IF MONEY > 1000
					PRINTFORML 「에헤헤~ 그럼 인간의 마을에서 맛있는 거 잔뜩 사줘!」
					PRINTFORML 「좋은 운동도 됐으니까, 많이 먹을 거야아~」
					PRINTW 
					PRINTFORML 이따가, 엄청나게 사줬어……
					PRINTFORML 지갑은 아팠지만, 하타테의 행복해 보이는 표정을 볼 수 있었으니까 아무 일 없었던 걸로 하자
					PRINTW 
					PRINTFORML 소지금이 %金額表示(500)% 줄었네...
					MONEY -= 500
				ELSE
					PRINTFORML 「%MASTERNAME:42% 돈이 부족하단 말이야... 아무래도 안 될까나~」
					PRINTFORML 「그럼 다음에 돈 있을 때 사줘. 약속♪」
					PRINTW 
				ENDIF
			CASE 1
				IF TALENT:恋慕 || TALENT:恋人 || TALENT:思慕
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「이번에는 내 승리였지만 말이야. 다음은 모를지도 몰라~」
							PRINTW 
						CASE 1
							PRINTFORML 「%MASTERNAME:42%, 세구나~. 쉽게 이기게 안 해주는구나」
							PRINTW 
					ENDSELECT
				ELSE
					PRINTFORML 「아, 안 됐네애…. 생각했던 것보다 잘하잖아, 너. 나 발전했거든♪」
					PRINTW 
				ENDIF
				IF MONEY > 1000
					PRINTFORML 「에헤헤~ 그럼 인간의 마을에서 맛있는 거 잔뜩 사줘!」
					PRINTFORML 「좋은 운동도 됐으니까, 많이 먹을 거야아~」
					PRINTW 
					PRINTFORML 이따가, 엄청나게 사줬어……
					PRINTFORML 지갑은 아팠지만, 하타테의 행복해 보이는 표정을 볼 수 있었으니까 아무 일 없었던 걸로 하자
					PRINTW 
					PRINTFORML 소지금이 %金額表示(500)% 줄었네...
					MONEY -= 500
				ELSE
					PRINTFORML 「돈이 없단 말이야... 아무래도 좀 나쁜가 봐~」
					PRINTFORML 「그럼 다음에 돈 있을 때 사줘. 약속해!♪」
					PRINTW 
				ENDIF
			CASE 0
				PRINTFORML 「아앙, 지고 말았어……」
				PRINTFORML 하타테는 푹 바닥에 주저앉았다
				PRINTW 
				PRINTFORML 「우……약속이었잖아. 이렇게 보여도 약속은 지키는 타입이거든」
				PRINTFORML 「뭐, 지킬 수 없는 약속은 애초에 안 하긴 하는데」
				PRINTW 
				PRINTFORML 「그럼 가만히 있어 줘. 움직이면 안 돼」
				PRINTFORML 하타테는 이쪽으로 다가와 옆에 감기더니 뺨에 살짝 입맞춤을 했다
				PRINTW 
				PRINTFORML 「에헤헤—. 하타테쨩으로부터 승자에게 축복의 키스예요♪」
				PRINTFORML 하타테의 뺨은 빨갛다. 의외로 수줍어하는 듯했다.
				PRINTW 
				CALL ASK_M("입에 넣어주지 않을 거야?", 1,"더 좋은 것이 갖고 싶다" , 1,"성의는 키스가 아니라 금액이다." , 1)
				SELECTCASE RESULT
					CASE 0
						IF TALENT:キス未経験
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML 「에엣!? 아, 싫다는 게 아니야, 당연히...」
								PRINTFORML 「뭐랄까, 마음의 준비가...라기보다는, 당신 쪽에서 가져간 것 같다고 할까...?」
								PRINTW 
								PRINTFORML 「우우... 부끄러워애... 자, 가만히 있어 줄래?」
								PRINTFORML 하타테는 몇 번이고 시선을 이리저리 돌렸지만, 결심했는지 이곳을 바라보았다.
								PRINTW 
								PRINTFORML 「눈, 눈은 감아. 그대로야? …………응읏」
								PRINTFORML 하타테의 말에 따라 눈을 감자, 입술에 부드러운 감촉이 닿았다
								PRINTW 
								CALL AddEXP("キス経験", MASTER, 1)
								CALL AddEXP("キス経験", TARGET, 1)
								IF TALENT:MASTER:キス未経験
									CALL SET_FIRSTKISS(MASTER, 42, 0)
								ENDIF
								IF TALENT:42:キス未経験
									CALL SET_FIRSTKISS(42, MASTER, 0)
								ENDIF
								PRINTFORML 눈을 뜨자, 얼굴이 새빨개진 하타테가 곤란한 듯 분노한 듯, 뭐라고 할 수 없는 표정으로 자신을 바라보고 있었다
								PRINTFORML 「……어땠어? 내 첫 키스」
								PRINTW 
								CALL ASK_YN("하타테 정말 좋아","잘 몰랐으니까 다시 한번")
								IF !RESULT
									PRINTFORML 「! 에헤헤, 저도 %MASTERNAME:42%가 너무 좋아%UNICODE(0x2665) *1%」
									PRINTFORML 하타테는 만면의 미소를 띄웠다.
									PRINTW 
								ELSE
									PRINTFORML 「에, 에에~~~, 무슨 의미야아~」
									PRINTFORML 「……그, 그래도 잘 몰랐다면, 어쩔 수 없네…」
									PRINTW 
									PRINTFORML 「모, 한 번만 더 할 수 있어? 이번엔 제대로 확인해 줄래?」
									PRINTFORML 다시 하타테의 얼굴이 가까워져 왔다…
									PRINTW 
									CALL AddEXP("キス経験", MASTER, 1)
									CALL AddEXP("キス経験", TARGET, 1)
								ENDIF
							ELSEIF TALENT:思慕
								PRINTFORML 「우읏!? 키스라니... 저, 뺨에 키스하는 것도 처음이었는데요!」
								PRINTFORML 「그, 그리고 저희 연인 사이도 아닌데요……」
								PRINTW 
								PRINTFORML 입으로는 거부하는 것처럼 보이지만, 분명히 그렇지 않은 것을 보니 별로 싫어하지 않는 것 같다.
								PRINTFORML 생각했던 것보다 하타테는 자신을 호의적으로 봐주고 있었던 것 같다.
