@M_KOJO_EVENT_K42_20(ARG,ARG:1)
;口上主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「우우, 아쉽지만 슬슬 돌아가야 할 것 같아……」
			PRINTW 
		ELSEIF TALENT:思慕
		ELSE
			PRINTFORML 「그럼, 이제 슬슬 돌아갈게. 바~이♪」
			PRINTW 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート中帰宅
	;クラウンピース口上を参考にしました
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:42:現在位置 == OMANEKIBEYA()
			IF CFLAG:42:うふふ
				;邪魔にならないよう表示しない
				RETURN 1
			ELSE
				PRINTFORMW 「후와…… 아, 벌써 이런 시간이네」
				PRINTFORMW 「헤어질 시간이야, %MASTERNAME:42%」
