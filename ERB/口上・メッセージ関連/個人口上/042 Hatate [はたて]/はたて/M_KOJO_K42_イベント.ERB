					PRINTFORML そう言いながらも、はたては自分の上で腰を振るのをやめようとしない
				ENDSELECT
			ENDIF
		ELSEIF INRANGE(TIME, 690, 780)
			CALL HPH_PRINT,@"「もう、お昼だよ…そろそろ、ご飯にしよ…HPH」","L"
			CALL HPH_PRINT,@"「こらぁっ、ご飯、作るのぉっHPH」","L"
			PRINTW 
		ELSEIF INRANGE(TIME, 1080, 1200)
			PRINTFORML 「もう、夕方だよ…」
			PRINTFORML 「お腹、空いちゃった…ご飯食べてからにしよ」
		ELSEIF INRANGE(TIME, 60, 119)
			CALL HPH_PRINT,@"「もう寝る時間だってばぁ…HPH」","L"
			CALL HPH_PRINT,@"「寝かさないつもりなのぉ…HPH」","L"
			PRINTW 
		ELSEIF INRANGE(TIME, 120, 239)
			CALL HPH_PRINT,@"「今、何時…？HPH　意識、トビそ…」","L"
		ELSEIF INRANGE(TIME, 240, 360)
			PRINTFORML 「朝、きちゃったね…」
			IF STAIN:TARGET:Ｖ && STAIN:TARGET:Ａ && STAIN:TARGET:Ｂ && STAIN:TARGET:口 && STAIN:TARGET:手
				CALL HPH_PRINT,@"「あは…全身、どろどろ…HPH」","L"
			ENDIF

			IF TCVAR:410 >= 20
				CALL HPH_PRINT,@"「もう、あそこに力はいんないよぉ…HPH」","L"
				IF 充填率(TARGET,1) >= 100
					PRINTFORML はたての膣からぶぴっ、ぶぷっ、と精液と一緒に空気の漏れる音が聞こえる
					CALL HPH_PRINT,@"「やだぁっ、恥ずかしい…HPH」","L"
				ENDIF
			ENDIF
		ENDIF
	ENDIF

	SELECTCASE RAND:5
	CASE 0
		IF CFLAG:1020 == 2
			PRINTFORML 以前、はたてにあげたものが箪笥の上に飾られている…
		ELSE
			PRINTFORML 二人で買い出しに行った雑貨が目に入った
		ENDIF
	CASE 1
		PRINTFORML 本棚にはファッション雑誌や新聞のバックナンバーが収納されている
	CASE 2
		PRINTFORML 可愛らしい小物が並んでいる
	CASE 3
		PRINTFORML デートした時の写真が飾られている。はたてが念写で撮影したものだ
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML 写真の中の自分は、はたてに抱きつかれて少し照れ臭そうだ
		CASE 1
			PRINTFORML はたては美味しそうにケーキを頬張っている
		CASE 2
			PRINTFORML 自分とはたてがキスをしている写真だ
		ENDSELECT
	CASE 4
		PRINTFORML 二人で撮った写真を収めたアルバムが本棚にある。結構な数になったものだ
	ENDSELECT
ELSEIF TALENT:愛欲 || TALENT:セフレ
	SELECTCASE RAND:4
	CASE 0
		PRINTFORML えっちな下着が室内で干されている
	CASE 1
		PRINTFORML アダルトグッズが物陰からはみ出ている…
	CASE 2
		PRINTFORML 性風俗に関する資料が本棚に大量に収められている
	CASE 3
		PRINTFORML カラスのぬいぐるみがたくさん飾られている
	ENDSELECT
ELSEIF TALENT:思慕
	SELECTCASE RAND:4
	CASE 0
		PRINTFORML 可愛らしい小物が棚に並んでいる
	CASE 1
		PRINTFORML 射命丸文の新聞とはたての新聞が並べて張られている
	CASE 2
		PRINTFORML 新聞のバックナンバーや資料が床の上に積み上げられている
	CASE 3
		PRINTFORML 撮影した風景などの写真が壁に張られている
	ENDSELECT
ENDIF
