;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================
@M_KOJO_MESSAGE_COM_K42_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
CASE "試合前"
	;-------------------------------------------------
	;キャラセレクト時,ARGは使えません
	;全角50文字くらいまで
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		SELECTCASE RAND:12
		CASE 0
			RESULTS = 「はたて！　いっきまーす！」
		CASE 1
			RESULTS = 「がんばるわよ！」
		CASE 2
			RESULTS = 「さあ、始めるわよ！」
		CASE 3
			RESULTS = 「すぐ楽にしてあげるわっ！」
		CASE 4
			RESULTS = 「どーしても、闘わないといけないのね…！」
		CASE 5
			RESULTS = 「お願いしまーす！」
		CASE 6
			RESULTS = 「いくわよ！」
		CASE 7
			RESULTS = 「かかってきなさい！」
		CASE 8
			RESULTS = 「準備はできてるー？」
		CASE 9
			RESULTS = 「行くわよ！」
		CASE 10
			RESULTS = 「とっととかかってきなさい！」
		CASE 11
			RESULTS = 「軽くいきましょ♪」
		ENDSELECT
;		RESULTS = 「ぶっとばしてさしあげますわ！」
	ENDIF
CASE "戦場に出した"
	;-------------------------------------------------
	;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
	;全角40文字まで（カギカッコ含む）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	残りムシ数 = ARG
	;-------------------------------------------------
	IF LOCAL:1
		SELECTCASE RAND:12
		CASE 0
			RESULTS = 「%MUSHI_NAME%、あなたに決めたわよ！」
		CASE 1
			RESULTS = 「レオパ…%MUSHI_NAME%、出なさいっ！」
		CASE 2
			RESULTS = 「えへへ、私の%MUSHI_NAME%は強いわよ！」
		CASE 3
			RESULTS = 「やっちゃえ%MUSHI_NAME%！」
		CASE 4
			RESULTS = 「この子に勝てる？」
		CASE 5
			RESULTS = 「頑張れ%MUSHI_NAME%！」
		CASE 6
			RESULTS = 「いけ、%MUSHI_NAME%！　ジャリガールたちをぶっとばせー！」
		CASE 7
			RESULTS = 「ククク…この%MUSHI_NAME%は私の闘昆三銃士の中でも最強…！」
		CASE 8
			RESULTS = 「準備はできてるー？」
		CASE 9
			RESULTS = 「行くわよ！　相棒！」
		CASE 10
			RESULTS = 「とっととかかってきなさい！」
		CASE 11
			RESULTS = 「軽くいきましょ♪」
		ENDSELECT
		;RESULTS = 「すぐ楽にしてあげる♪」
	ENDIF
CASE "攻撃時"
	;-------------------------------------------------
	;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
	;全角40文字まで（カギカッコ含む）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	残りムシ数 = ARG
	;MUSHI_DATA.ERBに名称
	;-------------------------------------------------
	IF LOCAL:1
		IF GROUPMATCH(MUSHI_NAME, "モンシロチョウ","モンキチョウ","アゲハチョウ","カラスアゲハ","アオスジアゲハ","オオゴマダラ","オオムラサキ","アオバセセリ",)
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　眠りの鱗粉よ！」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　はばたいて！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "モルフォチョウ","アレキサンドラトリバネアゲハ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　眠りの鱗粉よ！」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　バタフライエフェクト！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "ミイロタテハ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　眠りの鱗粉よ！」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　もっと速く！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "チャドクガ","クジャクヤママユ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「毒攻撃、当たると痛いわよ！」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　はばたいて！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "オオミズアオ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　動きを止めなさい！」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　はばたいて！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "スズメガ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　今よ！」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　はばたいて！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "ヨナグニサン")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%の支配攻撃、防げる？」
			CASE 1
				RESULTS = 「%MUSHI_NAME%！　はばたいて！」
			ENDSELECT
		;バッタ
		ELSEIF GROUPMATCH(MUSHI_NAME, "ショウリョウバッタ","トノサマバッタ","オンブバッタ","イナゴ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　ライジングインパクト！」
			CASE 1
				RESULTS = 「跳べ、%MUSHI_NAME%！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "キリギリス","クツワムシ","エンマコオロギ","スズムシ","マツムシ","ウマオイ")
			SELECTCASE RAND:2
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　ライジングインパクト！」
			CASE 1
				RESULTS = 「跳べ、%MUSHI_NAME%！」
			ENDSELECT
		;リオック
		ELSEIF GROUPMATCH(MUSHI_NAME, "リオック")
			SELECTCASE RAND:3
			CASE 0
				RESULTS = 「%MUSHI_NAME%！　ライジングインパクト！」
			CASE 1
				RESULTS = 「跳べ、%MUSHI_NAME%！」
			CASE 2
				RESULTS = 「喰らい尽くせ、%MUSHI_NAME%！」
			ENDSELECT
		ELSEIF GROUPMATCH(MUSHI_NAME, "コカマキリ","オオカマキリ")
			SELECTCASE RAND:3
			CASE 0
