				SIF !TCVAR:(CFLAG:MASTER:お招き):連泊禁止 && NEMUKE() < 720
					PRINTFORMW 「……역시, 아침까지 같이 있고 싶네」
			ENDIF
		ELSE
			PRINTFORML 「앗, 벌써 이렇게 시간이 됐잖아」
			IF CFLAG:K42C_結婚 >= 1
				PRINTFORML 「달링이랑 데이트해서 오늘은 기뻤어~」
				PRINTFORML 「다음에 또 데이트하자. 약속이야♪ 츄읔%UNICODE(0x2665) *1%」
				PRINTW 
			ELSEIF TALENT:恋人
				PRINTFORML 「우웅~, 사실은 집에 가기 싫은데~ 미안해, %MASTERNAME:42%」
				PRINTFORML 「다음에 또 데이트하자. 약속이야♪ 쪽%UNICODE(0x2665) *1%」
				PRINTW 
			ELSEIF TALENT:恋慕
				PRINTFORML 「우웅~ 미안, 더 같이 있고 싶은데, 이대로는 폐가 될 것 같으니까……」
				PRINTFORML 「다시 데이트하자. 약속이야♪ 쪽%UNICODE(0x2665) *1%」
				PRINTW 
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				PRINTFORML 「%MASTERNAME:42%랑 기분 좋은 거 하는 것도 좋아하지만, 데이트하는 것도 재미있지~」
				PRINTFORML 「다음에 또 불러줘. 그럼 안녕~ ♪」
				PRINTW 
			ELSEIF TALENT:思慕
				PRINTFORML 「음……」
				PRINTFORML 「응, 그냥 돌아가는 게 아쉽다고만 생각한 거야」
				PRINTFORML 「다음에도 또 불러줘. 알았지? 안녕~♪」
				PRINTW 
			ELSE
				IF BASE:42:ムード == MAXBASE:42:ムード
					PRINTFORML 「%MASTERNAME:42%랑 같이 노는 거, 진짜 재미있었어~♪」
					PRINTFORML 「다음에도 불러주면 좋겠다~ 잘가, 다음에 또 놀러 오자~♪」
					PRINTW 
					;合意時にうふふできるくらいのムード
				ELSEIF BASE:42:ムード >= 300
					PRINTFORML 「졸리지 않았다면, %MASTERNAME:42%랑 더 놀고 싶었을텐데 말이야~」
					PRINTFORML 「그럼 안녕. 다음에 또 놀러 가자~♪」
					PRINTW 
					;デート中ムードを上げなかったか遅い時間にデートに行ったか
				ELSEIF BASE:42:ムード > 0
					PRINTFORML 「다음엔 시간도 좀 더 갖고, 이것저것 하며 즐겁게 해줘~」
					PRINTFORML 「잘 가~」
					PRINTW 
					;何をしに行ったのだ
				ELSEIF BASE:42:ムード == 0
					PRINTFORML 「뭔가 데리고 돌아다녔을 뿐이잖아…… 사이아쿠」
					PRINTFORML 「흥~」
					PRINTW 
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;玄関先でお見送り
	;映姫様口上を参考にしました
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:K42C_結婚 >= 1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「우리 집에 살아주면 매일 만날 수 있을텐데~」
					PRINTFORML 「뭐, 적당한 거리감도 오래가는 비결이라고 하긴 하지만」
					PRINTW 
				CASE 1
					PRINTFORML 「통이 맞는 아내라는 것도 싫지 않지만, 차라리 그냥 같이 살고 싶다아~」
			ENDSELECT
			IF MAIN_MAP == 8
				PRINTFORML 「『가까우니까 금방 만날 수 있잖아?』 그런 문제 아니야~」
			ENDIF
			PRINTFORML 「또 상황을 보러 올게. %MASTERNAME:42%, 사랑해%UNICODE(0x2665) *1%」
			PRINTW 
		ELSEIF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「오늘 고마웠어. 이제 슬슬 돌아갈게」
			PRINTFORML 「헤헤, %MASTERNAME:42%랑 집 데이트 해버렸어……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「데려다줘서 고마워」
			PRINTFORMW 「여기까지만 괜찮아. 그럼 안녕」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
