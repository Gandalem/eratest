; Modular ERB: 個人口上/042 Hatate [はたて]/はたて/M_KOJO_K42_派生コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;派生コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;1,シックスナイン
;==================================================

@M_KOJO_MESSAGE_SCOM_K42_1
CALL M_KOJO_MESSAGE_SCOM_K42_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K42_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		;クンニ強制←→クンニはシックスナイン対象外らしい
		;クンニ強制←→フェラするも×
		;フェラする←→フェラチオはＯＫ
		;はたてふたなり
		IF HAS_PENIS(TARGET) == 1
			;あなたもちんこついてる（男またはふたなり）
			IF HAS_PENIS(MASTER) == 1
				IF PREVCOM == 1;クンニ
					;はたてフェラ中
					IF TEQUIP:TARGET:口接触部位 == 1
						PRINTFORML 「흐읏!? 아, 이봐, 지금 핥으면 안 된다니까……」
						PRINTFORML 페니스의 뿌리부터 개미가 건너는 곳까지, 혀로 한 번에 따라 하자, 하타테는 움찔하며 엉덩이를 떨었다
						PRINTW 
						;はたてクンニ中
					ELSE
						PRINTFORML 눈앞에서 파르르 떨리며 벌어지는 음부에 유혹되어, 살짝 입을 맞추었다.
						PRINTFORML 「파앙!%UNICODE(0x2665) *1% 잠깐만, 지금은 내 차례라고오……%UNICODE(0x2665) *1%」
						PRINTW 
					ENDIF
				ELSEIF PREVCOM == 2;フェラする
					;はたてフェラ中
					IF TEQUIP:TARGET:口接触部位 == 1
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「햐우읏!?」
								PRINTFORML 눈앞에 매달린 하타테의 페니스를 물자, 입안에서 파르르 떨렸다.
								PRINTW 
							CASE 1
								LOCALS:0 = 
								SELECTCASE TALENT:TARGET:形状
									CASE 6,10;巨根、馬並み
										LOCALS:0 = 그곳에 있기엔 어울리지 않을 정도로, 인간의 손목만 한 굵기가 있나 하는 생각이 들었다.
									CASE 1,2;粗チン
										LOCALS:0 = 어쩜 이렇게 귀여울까
									CASE 5;イボ付き
										LOCALS:0 = 소유자와는 정반대인 흉악한 형태의
									CASEELSE
										LOCALS:0 = 외모와는 달리 단단하다
								ENDSELECT
								PRINTFORML 하타테의 페라 테크닉에 휘둘리는 와중에, 눈앞에 %LOCALS:0%의 페니스가 시야에 들어왔다.
								PRINTW 
								PRINTFORML 핥짝...
								PRINTFORML 「엣!? 잠깐, 너 뭐 하는 거야, 으응!! %UNICODE(0x2665) *1%」
								PRINTW 
								PRINTFORML 「어, 어느 쪽이 먼저 가게 할지 승부하자고...? 괜찮잖아」
								PRINTFORML 「나도 지지 않을 거거든……%UNICODE(0x2665) *1% 함윽, 뿍, 뿍...%UNICODE(0x2665) *1%」
								PRINTW 
						ENDSELECT
						;はたてクンニ中
					ELSE
						LOCALS:1 = 
						SELECTCASE TALENT:TARGET:形状
							CASE 6,10;巨根、馬並み
								LOCALS:1 = 그곳에 있기엔 어울리지 않을 정도로, 인간의 손목만 한 굵기가 있나 하는 생각이 들었다.
							CASE 1,2;粗チン
								LOCALS:1 = 어쩜 이렇게 귀여울까
							CASE 5;イボ付き
								LOCALS:1 = 소유자와는 정반대인 흉악한 형태의
							CASEELSE
								LOCALS:1 = 외모와는 달리 단단하다
						ENDSELECT
						PRINTFORML 하타테에게 암구멍을 애무당하는 와중에, 눈앞에 %LOCALS:1% 페니스가 시야에 들어왔다.
						PRINTW 
						PRINTFORML 핥짝…
						PRINTFORML 「햐앗!? 저, 잠깐만요, 끝부분이 약하잖아요, 으히익%UNICODE(0x2665) *1%」
						PRINTFORML 「싫어, 기분 좋아지잖아%UNICODE(0x2665) *1% 그렇게 츄릅거리면 안 돼…%UNICODE(0x2665) *1%」
						PRINTW 
					ENDIF
				ELSEIF PREVCOM == 81;フェラチオ
					IF TEQUIP:MASTER:口接触部位 == 1
						PRINTFORML 「네 것도, 핥게 해줘……%UNICODE(0x2665) *1% 흡!%UNICODE(0x2665) *1%」
					ELSEIF TEQUIP:MASTER:口接触部位 == 6
						PRINTFORML 「그렇게나, 거긴만 핥지 마……%UNICODE(0x2665) *1%」
						PRINTFORML 「나도, 할 거니까……%UNICODE(0x2665) *1% 하무! %UNICODE(0x2665) *1%」
					ENDIF
					PRINTFORML 「응흣, 응흣, 응흣……%UNICODE(0x2665) *1% 단단해서, 맛있어……%UNICODE(0x2665) *1%」
					PRINTW 
				ELSE
				ENDIF
				;あなたは女。対応コマンドがないよ！
			ELSE
			ENDIF
			;はたて女
		ELSE
			IF PREVCOM == 1;クンニ
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「앗, 정말, 지금은 내가 너를 기분 좋게 해주고 있는 거니까… 아앗%UNICODE(0x2665) *1% 으응%UNICODE(0x2665) *1%」
						PRINTFORML 「츄릅%UNICODE(0x2665) *1% 하앗%UNICODE(0x2665) *1% 아아앗%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						PRINTW 
					CASE 1
						PRINTFORML 츄릅, 쪽, 쥬루륵……
						PRINTFORML 「응읏%UNICODE(0x2665) *1% 후읏%UNICODE(0x2665) *1% 후읏%UNICODE(0x2665) *1% 후~~~~읏%UNICODE(0x2665) *1%」
						PRINTW 
					CASE 2
						PRINTFORML 「앗, 그렇게 하니까, 너무 기분 좋아져 버릴 것 같은데……%UNICODE(0x2665) *1%」
						PRINTW 
					CASE 3
						PRINTFORML 「앗, 그런 곳을, 넓히지 마아!」
						PRINTFORML (싫어… %MASTERNAME:42%에게 전부 보여지고 있어… %UNICODE(0x2665) *1%)
						PRINTW 
						PRINTFORML 「입이 놀고 있다니, 당신이 자꾸 그런 짓을 하니까아… 응읏%UNICODE(0x2665) *1% 응응읏%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						PRINTFORML 「축축하다느니, 그런 말 안 해도 돼앳… 바보 %MASTERNAME:42%…%UNICODE(0x2665) *1%」
						PRINTW 
					CASE 4
						PRINTFORML 눈앞에서, 하타테의 통통한 엉덩이가 흔들리고 있다...
						PRINTFORML 그 중앙에는 하타테의 음란한 만코가 암컷 냄새를 풍기며 움찔거리듯, 욕망하는 것처럼 열렸다 닫히고 있다.
						PRINTW 
						PRINTFORML 「응응!? 아, 바보야, 손가락으로, 열지 마, 질내를 보면 안 돼읏」
						PRINTFORML 양손으로 음순을 벌리자, '니치' 하는 점액질 소리와 함께 질구가 노출되었다.
						PRINTFORML 하타테는 구강 봉사를 중단하고, 황급히 항의한다.
						PRINTW 
						PRINTFORML '멈추라'고 해도 '알겠습니다'라고 응할 리가 없다. 항의를 무시하고, 질구에 혀끝을 비틀어 넣었다
						PRINTFORML 「햐앗%UNICODE(0x2665) *1% 혀가, 들어왔어~~~%UNICODE(0x2665) *1%」
						PRINTW 
						PRINTFORML 「질내 핥아버릴 거야~%UNICODE(0x2665) *1% 거시기, 핥을 수 없어! 아앗%UNICODE(0x2665) *1% 야앗%UNICODE(0x2665) *1%」
						PRINTFORML 「코, 코오오…하무읏%UNICODE(0x2665) *1% 우부읏, 오부읏%UNICODE(0x2665) *1% 츄ㅂ옷, 츄ㅂ옷, 츄ㅂ옷%UNICODE(0x2665) *1%」
						PRINTFORML 대항의식을 불태웠는지, 하타테가 이전보다 열정적인 혀놀림으로 구강애무를 재개했다.
						PRINTW 
						PRINTFORML 이건, 빨리 가게 만들지 않으면, 이쪽이 먼저 싸버릴 것 같다…
						PRINTFORML (빨리 가, 가버려어%UNICODE(0x2665) *1%　정말, 가버릴 것 같아아%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%)
						PRINTW 
				ENDSELECT
			ELSEIF PREVCOM == 81;フェラチオ
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「계속 당하기만 하면 너무하니까, 되갚아줄게…%UNICODE(0x2665) *1% 음푸읏…%UNICODE(0x2665) *1%」
						PRINTFORML 「하, 응%UNICODE(0x2665) *1% 쮸풉, 쮸풉…%UNICODE(0x2665) *1%」　
					CASE 1
						PRINTFORML 츄릅, 쪽, 쥬루륵……
						PRINTFORML 「응읏%UNICODE(0x2665) *1% 후읏%UNICODE(0x2665) *1% 후읏%UNICODE(0x2665) *1% 후~~~~읏%UNICODE(0x2665) *1%」
						PRINTW 
					CASE 2
						PRINTFORML 「헉, 헉…%UNICODE(0x2665) *1% 응... 너 엄청 힘들겠다... 하무앗%UNICODE(0x2665) *1%」
						PRINTFORML 
						PRINTW 
					CASE 3
						PRINTFORML 「하앗%UNICODE(0x2665) *1%　아앗%UNICODE(0x2665) *1%」
						PRINTFORML 「치사해, %MASTERNAME:42%만… 앙%UNICODE(0x2665) *1%」
						PRINTFORML 「응읏%UNICODE(0x2665) *1%　후우읏%UNICODE(0x2665) *1%　으으응읏%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						PRINTW 
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
