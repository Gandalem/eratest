@M_KOJO_MESSAGE_SCOM_K42_3
CALL M_KOJO_MESSAGE_SCOM_K42_3_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K42_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORML 「──흣, 뭐... 뭐야...!」
			PRINTFORML 「거기, 토닥토닥 하지 마! 이상하게 될 거잖아아...」
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORML 손가락으로 질벽 상부를 톡톡 자극하자, 질구와 질 주름이 꿈틀거린다.
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 하타테의 질은 민감하여, 반응이 좋은 것을 즐길 수 있다.
			PRINTW 
		ELSE
			PRINTFORML 평소에는 그런 것에 서툴지만, 몸은 실로 정직하다
			PRINTW 
		ENDIF
		PRINTW 
		RETURN 1
	ELSE
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「아앗%UNICODE(0x2665) *1% 거긴, 거기 대단해욧%UNICODE(0x2665) *1%」
			PRINTFORML 「몽글몽글해져요, 하타테, 몽글몽글해지잖아앗! 아아앗%UNICODE(0x2665) *1%」
			PRINTW 
			RETURN 1
		ELSEIF TALENT:愛欲 || TALENT:セフレ
			IF ABL:Ｖ感覚 > 3
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「얀... 응...! %UNICODE(0x2665) *1% 엄지... %UNICODE(0x2665) *1%」
						PRINTFORML 손가락으로 질 주름을 헤쳐나가자, 통통하게 부풀어 오른 부분이 있었다
						PRINTW 
						PRINTFORML 「앗!?%UNICODE(0x2665) *1% 흐윽!?%UNICODE(0x2665) *1%」
						PRINTFORML 손가락 패드로 가볍게 눌러주자, 하타테의 반응이 이전과 확연히 달라졌다.
						PRINTW 
						PRINTFORML 「그거 안 돼 %UNICODE(0x2665) *1% 해버릴 것 같아 %UNICODE(0x2665) *1% %UNICODE(0x2665) *1%」
						PRINTFORML 계속 손가락으로 꾹 누르자, 하타테는 몸을 경련시키며 푸슈아 하고 물을 분출했다.
						PRINTW 
					CASE 1
						PRINTFORML 「오옷!? %UNICODE(0x2665) *1%　앗%UNICODE(0x2665) *1%　거기 안 돼애앳%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						PRINTFORML 질 벽의 까칠까칠한 부분을 손가락으로 톡톡 자극할 때마다, 하타테는 푸슉, 푸슉 하며 애액을 뿜어냈다.
						PRINTW 
				ENDSELECT
			ELSE
				PRINTFORML 「응윽!! 야아... 거기, 안돼요……앗 아아아앗%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORML 민감한 하타테의 질벽은 까슬까슬한 부분을 손가락에 자극받아, 꾸욱꾸욱과 함께 급격히 수축을 반복하고 있다.
				PRINTW 
			ENDIF
			RETURN 1
		ELSE
			PRINTFORML 「안돼앳, 바아…… 거긴, 손가락, 넣지 말아줘……」
			PRINTFORML 「그렇게, 상냥하게 해주면…… 으응…… %UNICODE(0x2665) *1%」
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
ENDIF
