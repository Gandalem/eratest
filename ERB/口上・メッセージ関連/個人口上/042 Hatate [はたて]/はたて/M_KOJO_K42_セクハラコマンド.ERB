;抱き付くは情愛、歓楽のSOURCEが大幅増

@M_KOJO_EXTRASOURCE_COM_K42_311
IF CFLAG:K42C_結婚 >= 1 || (TALENT:恋慕 || TALENT:恋人 && EXP:愛情経験 >= 500 && CFLAG:信頼度 >= 5000)
	SOURCE:反感 = 0
	SOURCE:情愛 = 480
	SOURCE:歓楽 = 360
	CALL AddEXP("愛情経験", TARGET, 1)
	IF BASE:42:怒り >= MAXBASE:42:怒り / 2
		BASE:42:怒り = BASE:42:怒り / 2
	ENDIF
	;女の子だと陥落前でも情愛、歓楽アップ。反感減少
ELSEIF TALENT:MASTER:性別 == 1 || TALENT:MASTER:性別 == 3
	SOURCE:反感 = SOURCE:反感 / 5
	SOURCE:情愛 = SOURCE:情愛 * 12 / 10
	SOURCE:歓楽 = SOURCE:歓楽 * 12 / 10
ENDIF
;キスする
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;旦那のキスで恐怖する妻ってのも嫌なので。キスがもっと気持ちよい行為に

@M_KOJO_EXTRASOURCE_COM_K42_312
IF CFLAG:K42C_結婚 >= 1 || ((TALENT:恋慕 || TALENT:恋人) && EXP:愛情経験 >= 500 && CFLAG:信頼度 >= 5000)
	SOURCE:反感 = 0
	SOURCE:恐怖 = 0
	SOURCE:情愛 = 450
	SOURCE:歓楽 = 450
	SOURCE:快Ｍ = ABL:PLAYER:舌 * 40 + 10
	CALL AddEXP("愛情経験", TARGET, 1)
	IF BASE:42:怒り >= MAXBASE:42:怒り / 2
		BASE:42:怒り = BASE:42:怒り / 2
	ENDIF
ELSEIF TALENT:MASTER:性別 == 1 || TALENT:MASTER:性別 == 3
	SOURCE:反感 = SOURCE:反感 / 5
	SOURCE:情愛 = SOURCE:情愛 * 12 / 10
	SOURCE:歓楽 = SOURCE:歓楽 * 12 / 10
	SOURCE:快Ｍ = ABL:PLAYER:舌 * 30 + 50
ENDIF
;胸愛撫
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

@M_KOJO_EXTRASOURCE_COM_K42_313
IF CFLAG:K42C_結婚 >= 1 || ((TALENT:恋慕 || TALENT:恋人) && EXP:愛情経験 >= 500 && CFLAG:信頼度 >= 5000)
	SOURCE:反感 = 0
	SOURCE:快Ｂ = 240
	SOURCE:歓楽 = 300
	SOURCE:快Ｍ = ABL:PLAYER:舌 * 4 + 10
	CALL AddEXP("愛情経験", TARGET, 1)
	IF BASE:42:怒り >= MAXBASE:42:怒り / 2
		BASE:42:怒り = BASE:42:怒り / 2
	ENDIF
ELSEIF TALENT:MASTER:性別 == 1 || TALENT:MASTER:性別 == 3
	IF TALENT:TARGET:バストサイズ >= TALENT:MASTER:バストサイズ
		SOURCE:反感 = SOURCE:反感 / 5
		SOURCE:快Ｂ = SOURCE:快Ｂ * 12 / 10
		SOURCE:歓楽 = SOURCE:歓楽 * 12 / 10
		SOURCE:征服 = SOURCE:征服 * 12 / 10
		;あなたがはたてよりおっぱい大きいと怒る
	ELSE
		SOURCE:反感 = SOURCE:反感 * 11 / 10
		SOURCE:屈従 = SOURCE:屈従 * 15 / 10
	ENDIF
ENDIF
;アナル愛撫
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;アナル愛撫は苦痛半減

@M_KOJO_EXTRASOURCE_COM_K42_314
IF CFLAG:K42C_結婚 >= 1 || ((TALENT:恋慕 || TALENT:恋人) && EXP:愛情経験 >= 500 && CFLAG:信頼度 >= 5000)
	SOURCE:反感 = 0
	SOURCE:苦痛 = 25
	SOURCE:快Ａ = 240
	SOURCE:歓楽 = 150
	SOURCE:快Ａ += ABL:PLAYER:指 * 30
	CALL AddEXP("愛情経験", TARGET, 1)
	IF BASE:42:怒り >= MAXBASE:42:怒り / 2
		BASE:42:怒り = BASE:42:怒り / 2
	ENDIF
ENDIF
;クリ愛撫
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ふたなり
IF TALENT:性別 == 3
	;無知な幼女相手におちんちん触られるといろいろ大幅プラス
	IF (TALENT:MASTER:年齢 < 1 && TALENT:MASTER:幼児／幼児退行)
		IF TALENT:MASTER:無知 == 1
			SOURCE:反感 = 0
			SOURCE:快Ｃ = 360
			SOURCE:歓楽 = 300
			SOURCE:欲情 = 300
			SOURCE:逸脱 = 300
			SOURCE:快Ｃ += ABL:PLAYER:指 * 50
			BASE:射精 += 500
			IF BASE:42:怒り >= MAXBASE:42:怒り / 2
				BASE:42:怒り = BASE:42:怒り / 2
			ENDIF
		ELSE
			SOURCE:反感 = 0
			SOURCE:快Ｃ = 240
			SOURCE:歓楽 = 200
			SOURCE:欲情 = 200
			SOURCE:逸脱 = 150
			SOURCE:快Ｃ += ABL:PLAYER:指 * 30
			IF BASE:42:怒り >= MAXBASE:42:怒り / 2
				BASE:42:怒り = BASE:42:怒り / 2
			ENDIF
		ENDIF
		;あなたが大人の女性なら反感減少
	ELSE
		SOURCE:反感 = SOURCE:反感 / 5
	ENDIF
	;ふたなし
ELSE
	;陥落＆高ステータスなら反感なし
	IF CFLAG:K42C_結婚 >= 1 || ((TALENT:恋慕 || TALENT:恋人) && EXP:愛情経験 >= 500 && CFLAG:信頼度 >= 5000)
		SOURCE:反感 = 0
		SOURCE:快Ｃ = 240
		SOURCE:歓楽 = 150
		SOURCE:快Ｃ += ABL:PLAYER:指 * 30
		CALL AddEXP("愛情経験", TARGET, 1)
		IF BASE:42:怒り >= MAXBASE:42:怒り / 2
			BASE:42:怒り = BASE:42:怒り / 2
		ENDIF
	ENDIF
ENDIF
