; Modular ERB: 個人口上/042 Hatate [はたて]/はたて/M_KOJO_K42_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K42
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 「흐윽%UNICODE(0x2665) *1% 가슴에서, 흘러나오고 있어...%UNICODE(0x2665) *1%」
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	IF TALENT:恋慕 || TALENT:恋人
		IF TEQUIP:MASTER:50 == TARGET
			PRINTFORML 「이상해진다앗%UNICODE(0x2665) *1% 거시기, 이상해져 온다앗%UNICODE(0x2665) *1%」
			PRINTFORML 「%MASTERNAME:42%의 질내 기분 좋아앗%UNICODE(0x2665) *1% 사정, 멈출 수가 없어에~%UNICODE(0x2665) *1%」
		ELSEIF TEQUIP:MASTER:51 == TARGET
			PRINTFORML 「안 돼앗 %UNICODE(0x2665) *1% 엉덩이, 조이지 말아앗 %UNICODE(0x2665) *1%」
			PRINTFORML 「사정, 멈추지 않을 거야앗 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「앗, 아%UNICODE(0x2665) *1% 안 돼앳%UNICODE(0x2665) *1% 갈 것 같아!%UNICODE(0x2665) *1% 흘러나올 것 같아...!%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		IF TEQUIP:MASTER:50 == TARGET
			PRINTFORML 「아앗%UNICODE(0x2665) *1% 기분 좋아읏%UNICODE(0x2665) *1%」
			PRINTFORML 「%MASTERNAME:42%의 질내에 사정하는 거 기분 좋아읏%UNICODE(0x2665) *1%」
		ELSEIF TEQUIP:MASTER:51 == TARGET
			PRINTFORML 「아아~~ 아아아~~~%UNICODE(0x2665) *1% 나, 싸버렸어……%UNICODE(0x2665) *1%」
			PRINTFORML 「%MASTERNAME:42%의 엉덩이 속에, 사정해버렸어……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「앗, 갈 것 같아! %UNICODE(0x2665) *1% 거시기 사정할 것 같아읏%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:思慕
		PRINTFORML 「안돼앳%UNICODE(0x2665) *1% 나올 것 같아읏%UNICODE(0x2665) *1%」
		PRINTFORML 「거시기에서 하얀 게 나올 것 같아읏%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「앗%UNICODE(0x2665) *1% 싫어읏%UNICODE(0x2665) *1% 무서워읏%UNICODE(0x2665) *1%」
		PRINTFORML 「뭔가 나올 것 같아읏%UNICODE(0x2665) *1% 흘러내릴 것 같아읏%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「앗, 아아아아아~~~~~~…」
			PRINTFORML (새어버렸어... 하면 안 되는데, 기분 좋아... 왜...? )
			PRINTW 
		CASE 1
			PRINTFORML 「아, 아아아아앗, 오줌 싸버렸어어…\/\/\/」
			PRINTW 
		CASE 2
			PRINTFORML 「싫어어, 멈춰줘%UNICODE(0x2665) *1% 멈춰줘어~~ %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
			PRINTW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	IF FLAG:70
	ELSE
		SELECTCASE NOWEX:TotalEX
			;強
			CASE 5 TO 15
				PRINTFORMW 「야랏메읏%UNICODE(0x2665) *1% 망가져버릴 것 같아앗%UNICODE(0x2665) *1%」
				;中
			CASE 2 TO 4
				PRINTFORMW 「아앗 %UNICODE(0x2665) *1% 하앗 %UNICODE(0x2665) *1% 안 돼, 안 돼, 안 돼 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				;弱
			CASE 1
				PRINTFORMW 「싫어읏, 이거 싫어읏, 무서워읏, 떨어질 것 같아애!!」
				PRINTW 
		ENDSELECT
		IF NOWEX:Ｃ絶頂
			;ローター
			SIF SELECTCOM == 40 && CFLAG:K42C_はたてと通販 != 2
				CFLAG:K42C_はたてと通販 = 1
			;Eマッサージャー
			SIF SELECTCOM == 41 && CFLAG:K42C_はたてと通販その２ != 2
				CFLAG:K42C_はたてと通販その２ = 1
			SIF TEQUIP:クリキャップ && CFLAG:K42C_はたてと通販その３ != 2
				CFLAG:K42C_はたてと通販その３ = 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아아아아앗!? 가버려%UNICODE(0x2665) *1%가버려 가버려 가버려 가버려어어엇%UNICODE(0x2665) *1%」
					PRINTW 
				CASE 1
					PRINTFORML 「아%UNICODE(0x2665) *1% 응%UNICODE(0x2665) *1% 갈 것 같아, 갈 것 같아…%UNICODE(0x2665) *1%」
					PRINTW 
				CASE 2
					PRINTFORML 「응...! 아앗!? 응아아앗%UNICODE(0x2665) *1%」
					PRINTFORML (나... 가버렸어... 나, 와버린 거야...)
					PRINTW 
			ENDSELECT
		ENDIF
		;はたてはＶ敏感持ち
		IF NOWEX:Ｖ絶頂
			SIF TEQUIP:バイブ && CFLAG:K42C_はたてと通販その４ != 2
				CFLAG:K42C_はたてと通販その４ = 1
			SELECTCASE RAND:6
				CASE 0
					PRINTFORML 「흐윽... 크으으윽%UNICODE(0x2665) *1% 아아~~%UNICODE(0x2665) *1% 아아아~~~!!!%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORML 「가버렷%UNICODE(0x2665) *1% 가버려어%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
					PRINTFORML 「보지이이%UNICODE(0x2665) *1% 보지예요오%UNICODE(0x2665) *1% 하타테의 보지이%UNICODE(0x2665) *1%」
					IF CFLAG:K42C_結婚 >= 1
						PRINTFORM 「달링의...」
					ELSE
						PRINTFORM 「%MASTERNAME:42%의」
					ENDIF
					;おちんちん
					IF TEQUIP:Ｖ接触部位 == 1
						PRINTFORM 자지로
						;指
					ELSEIF TEQUIP:Ｖ接触部位 == 3
						PRINTFORM 손가락으로
						;バイブ？
					ELSEIF TEQUIP:バイブ
						PRINTFORM 장난감으로
					ELSEIF TEQUIP:Ｖ接触部位 == 3
						PRINTFORML 손가락으로
					ELSEIF TEQUIP:Ｖ接触部位 == 4
						PRINTFORML 혀로
					ENDIF
					PRINTFORML 「하타테의 오만코에 싸게 해줘...! %UNICODE(0x2665) *1%」
					PRINTFORML 「하타테읏%UNICODE(0x2665) *1%　오만코로, 싸는 거야!%UNICODE(0x2665) *1%　오%UNICODE(0x2665) *1%　오옷%UNICODE(0x2665) *1%　쌌다아%UNICODE(0x2665) *1%　오만코, 또 싼다...!%UNICODE(0x2665) *1%」
					PRINTW 
				CASE 2
					PRINTFORML 「터질 것 같아%UNICODE(0x2665) *1% 오만코%UNICODE(0x2665) *1% 너무 기분 좋아서 터져버릴 것 같아%UNICODE(0x2665) *1%」
					PRINTW 
				CASE 3
					PRINTFORML 「기분 좋아읏%UNICODE(0x2665) *1% 가버릴 것 같아... 아앗%UNICODE(0x2665) *1%」
					PRINTFORML 「갈 거야아아아앗%UNICODE(0x2665) *1%」
				CASE 4
					PRINTFORML 「나 갈 것 같읏%UNICODE(0x2665) *1% 하타테의 몸이, 갈 것 같아요옷%UNICODE(0x2665) *1%」
					PRINTW 
				CASE 5
					PRINTFORML 「앗, 이거 뭐야!? 몰라, 이런 건, 모른다고%UNICODE(0x2665) *1%」
					PRINTW 
			ENDSELECT
		ENDIF
		IF NOWEX:Ｂ絶頂
			SIF TEQUIP:ニプルキャップ && CFLAG:K42C_はたてと通販その５ != 2
				CFLAG:K42C_はたてと通販その５ = 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「지금, 가슴은 안 돼읏%UNICODE(0x2665) *1% 가버려어%UNICODE(0x2665) *1% 가슴 때문에 가버려어엇%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORML 「앗, 싫어…… 가슴...! 흐윽%UNICODE(0x2665) *1% 흐으윽!%UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORML 「～～～～～～～읏%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%　으응%UNICODE(0x2665) *1%　응%UNICODE(0x2665) *1%」
					PRINTW 
			ENDSELECT
		ENDIF
		;はたてはＡ敏感持ち
		IF NOWEX:Ａ絶頂
			;アナルビーズ
			SIF SELECTCOM:46 && CFLAG:K42C_はたてと通販その６ != 2
				CFLAG:K42C_はたてと通販その６ = 1
			SIF TEQUIP:アナルバイブ && CFLAG:K42C_はたてと通販その７ != 2
				CFLAG:K42C_はたてと通販その７ = 1
			SELECTCASE RAND:3
				CASE 0
					SELECTCASE RAND:4 ;custom code
						CASE 0
							PRINTFORML 「아아앗%UNICODE(0x2665) *1%　아아아아~~앗%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%　앗%UNICODE(0x2665) *1%　으읏%UNICODE(0x2665) *1%　아앗%UNICODE(0x2665) *1%」
							PRINTW 
						CASE 1
							PRINTFORML 「하%UNICODE(0x2665) *1% 아아앗%UNICODE(0x2665) *1% 응앗%UNICODE(0x2665) *1% 아%UNICODE(0x2665) *1%」
							PRINTW 
						CASE 2
							PRINTFORML 「오히리읏%UNICODE(0x2665) *1% 부서질 것 같아읏%UNICODE(0x2665) *1%」
							PRINTFORML 「바보가 됐어%UNICODE(0x2665) *1% 오히리읏%UNICODE(0x2665) *1% 바보가 돼버렸잖아아%UNICODE(0x2665) *1%」
							PRINTW 
						CASE 3
							PRINTFORML 「응아아아앗%UNICODE(0x2665) *1%　안 돼, 안 돼애%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							PRINTFORML 「나, 엉덩이%UNICODE(0x2665) *1%　약하단 말이야아앗%UNICODE(0x2665) *1%」
							PRINTW 
					ENDSELECT
				CASE 1
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「앗, 안 돼, 여기서, 가버리고 싶지 않아앗%UNICODE(0x2665) *1% 가, 가버려어%UNICODE(0x2665) *1% 가버려어어어어어억%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							PRINTW 
						CASE 1
							PRINTFORML 「아냐앗%UNICODE(0x2665) *1% 안돼읏%UNICODE(0x2665) *1% 엉덩이, 안돼에%UNICODE(0x2665) *1%」
							PRINTW 
					ENDSELECT
				CASE 2
					PRINTFORML 「싫어, 엉덩이, 엉덩이야! 가버릴 거야!? 아, 안돼 %UNICODE(0x2665) *1% 갈 거야 %UNICODE(0x2665) *1%」
					PRINTW 
			ENDSELECT
		ENDIF
		IF NOWEX:Ｍ絶頂
			SELECTCASE RAND:3
				CASE 0
					IF TEQUIP:TARGET:口接触部位 == 1
						;口内射精されて絶頂
						IF GETBIT(TFLAG:1,4)
							PRINTFORML 「응윽%UNICODE(0x2665) *1% 으응구우~~~~~읏%UNICODE(0x2665) *1% 아아, 우우, 앗%UNICODE(0x2665) *1%」
							PRINTFORML (안돼, 사정하면, 흘러내리면, 바보가 돼버릴 거야%UNICODE(0x2665) *1%)
							PRINTFORML (목 안을, 안에 싸버리면%UNICODE(0x2665) *1%)
							PRINTW 
							;フェラ絶頂
						ELSE
							PRINTFORML 「흐읍%UNICODE(0x2665) *1%　으윽, 응윽%UNICODE(0x2665) *1%」
						ENDIF
						;キスで絶頂
					ELSEIF TEQUIP:TARGET:口接触部位 == 4
						PRINTFORML 「응흣, 응응읏, 응응~~~~~~%UNICODE(0x2665) *1%　%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						IF TALENT:MASTER:性別 == 2
							PRINTFORML (조금 거칠하면서도, 부드럽고, 따뜻하다)
							PRINTFORML (너무나 좋아하는 %MASTERNAME:42%의 입술. %MASTERNAME:42%의 키스)
							PRINTFORML (더 받고 싶어 %UNICODE(0x2665) *1%. 더 키스해줘… %UNICODE(0x2665) *1%)
							PRINTW 
						ELSE
							PRINTFORML (%MASTERNAME:42%의 입술, 부드럽다… %UNICODE(0x2665) *1%)
							PRINTFORML (동성 간의 키스는 이렇게나 상냥한 것이구나… %UNICODE(0x2665) *1%)
							PRINTFORML (머리가 몽글몽글해져서 아무 생각도 할 수 없게 된다… %UNICODE(0x2665) *1%)
							PRINTW 
						ENDIF
					ENDIF
				CASE 1
					IF TEQUIP:TARGET:口接触部位 == 1
						;口内射精されて絶頂
						IF GETBIT(TFLAG:1,4) || TCVAR:MASTER:12 == 4
							SELECTCASE RAND:2
								CASE 0
									PRINTFORML 「음무우우우읏, 응읏, 음보오옷, 으에… 하, 아…%UNICODE(0x2665) *1%」
									PRINTFORML (지독한 정액 냄새가 입안 가득 퍼져서, 기분이 나빠요…)
									PRINTFORML (그런데 왜죠, 머리가 멍해지고, 아무것도 이해할 수 없게 되는 거야…%UNICODE(0x2665) *1%)
									PRINTW 
								CASE 1
									PRINTFORML 「음우우우웃, 윽, 음우우웃%UNICODE(0x2665) *1%」
									PRINTFORML (아, 또 이 냄새)
									PRINTFORML (세키, 내 머릿속을 엉망진창으로 만들어 버리네...%UNICODE(0x2665) *1%)
							ENDSELECT
							;フェラ絶頂
						ELSE
							PRINTFORML 「응무우우욱, 응윽, 응무읏%UNICODE(0x2665) *1%」
							PRINTFORML (아, 또 이 냄새)
							PRINTFORML (수컷의 냄새. 나를 망가뜨리는 냄새. 가장 좋아하는, 맛과 향...%UNICODE(0x2665) *1%)
							PRINTW 
						ENDIF
						;キスで絶頂
					ELSEIF TEQUIP:TARGET:口接触部位 == 4
						PRINTFORML 「응후흣, 응읏, 으응읏%UNICODE(0x2665) *1%」
						PRINTFORML (두근거림이 멈추지 않아, %MASTERNAME:42%에게 심장 소리가 들킬 것만 같다……%UNICODE(0x2665) *1%)
						PRINTFORML (더, 더 키스해 줘. 내 가슴 속을 %MASTERNAME:42%로 가득 채워줘%UNICODE(0x2665) *1%)
						PRINTW 
					ENDIF
				CASE 2
					;ちんぽねじ込まれて絶頂
					IF TEQUIP:TARGET:口接触部位 == 1
						;口内射精されて絶頂
						IF GETBIT(TFLAG:1,4) || TCVAR:MASTER:12 == 4
							IF TALENT:精愛味覚
								PRINTFORML 「응무우우우읏, 응읏, 응무우읏%UNICODE(0x2665) *1% 앙고옷%UNICODE(0x2665) *1%」
								PRINTFORML (정액이, 냄새나고 진한 게 흘러나왔어읏%UNICODE(0x2665) *1%)
								PRINTFORML (더, 더 마시고 싶어읏%UNICODE(0x2665) *1% 더 흘려넣어줘%UNICODE(0x2665) *1%)
								PRINTW 
							ELSE
								PRINTFORML 「응무우웅, 읍, 응무우웅, 고흡!? 아, 앗」
								PRINTFORML (정액, 쓰다, 냄새나, 기분 나빠)
								PRINTFORML (왜, 기분 나쁜데도, 기분 좋다, 이유 모르겠어...)
								PRINTW 
							ENDIF
							;フェラ絶頂
						ELSE
							PRINTFORML 「어엣, 으윽, 아우읏」
							PRINTFORML (내 몸이 대체 어떻게 되어버린 걸까)
							PRINTFORML (남자 성기는 이상한 맛에 냄새가 나는데도, 입에 넣는 것만으로 머리가 멍해져 버려……)
							PRINTW 
						ENDIF
						;キスで絶頂
					ELSEIF TEQUIP:TARGET:口接触部位 == 4
						PRINTFORML 「응훗, 응응앗, 응응~~~~읏」
						PRINTFORML (상냥한 키스… 뭔가, 머리가 몽롱해져 버려…)
						PRINTW 
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K42
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
