@M_KOJO_MESSAGE_COM_K42_180
CALL M_KOJO_MESSAGE_COM_K42_180_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			PRINTFORML 하타테가 움직이지 않는 것을 틈타, 사타구니를 중심으로 로션을 정성껏 발랐다
			PRINTW 
			RETURN 1
		ELSE
			PRINTFORML 「우와, 이거 뭐야...? 질척거려...」
			PRINTFORML 하타테는 처음 만지는 로션의 감촉에 눈썹을 찌푸리고 있다.
			PRINTW 
			PRINTFORML 「이걸 온몸에 바르고, 몸끼리 비비는 건가? 흐음……」
			PRINTFORML 「의외로, 재미있을지도 모를 것 같은데. 한번 해보자아♪」
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:K42C_結婚 >= 1
		PRINTFORML 「처음에는 이상한 감촉이었는데, %MASTERNAME:42%랑 딱 붙어 지낼 수 있어서 좋아하게 돼버렸어%UNICODE(0x2665) *1%」
		PRINTFORML 「다시 비비면서 노는 거, 하자……%UNICODE(0x2665) *1%」
		PRINTW 
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:恋人
		PRINTFORML 「에헤헤, 미끈미끈해~」
		PRINTFORML 「하지만, 하타테를 제대로 사랑해주지 않으면 안 돼. 너무 급격하면 아프니까?」
		PRINTW 
		RETURN 1
		;セフレ
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		PRINTFORML 「손님~ 지금 따뜻하게 해드릴게요~♪」
		PRINTFORML 하타테가 로션을 체온만큼 따뜻하게 해주고 있다.
		PRINTFORML 누가 손님이라니, 하고 이마를 두드리자, 「앗따」하고 소리를 질렀다.
		PRINTW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
