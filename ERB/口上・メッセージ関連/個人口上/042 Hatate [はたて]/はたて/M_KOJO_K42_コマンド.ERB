					CALL HPH_PRINT,@"「아하핫, 아파읏 HPH. 이리 와, 힘 빼야 안 끊어져 버려욧 HPH」","L"
					CALL HPH_PRINT,@"「조금만 더 HPH, 조금만 더…… 들어와아 HPHHPHH」","L"
