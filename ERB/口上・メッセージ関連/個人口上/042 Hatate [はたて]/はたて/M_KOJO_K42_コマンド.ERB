;==================================================
;189,新妻プレイ
;==================================================

@M_KOJO_MESSAGE_COM_K42_189
CALL M_KOJO_MESSAGE_COM_K42_189_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_189_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			RETURN 1
		ELSE
			;恋慕時のみ可能
			PRINTFORML 「에, 이걸 달아주길 바라는 거야...?」
			PRINTFORML 「이, 이런 느낌으로 괜찮을까, 어울려...?」
			PRINTW 
			PRINTFORML 「정말? 후후, 고마워, 아・나・타%UNICODE(0x2665) *1%」
			PRINTFORML 「꺄아, 말해버렸어~%UNICODE(0x2665) *1%」
			PRINTFORML 하타테는 안돼, 안돼라며 고개를 젓고 있다.
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:新妻プレイ
		IF CFLAG:K42C_結婚 >= 1
			IF TEQUIP:0 == 0 && TEQUIP:1 == 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「에헤헤... 어때, 달링%UNICODE(0x2665) *1%」
						PRINTFORM 에이프런 사이로 고개를 내민다
						IF TALENT:TARGET:バストサイズ > 0
							PRINTFORML 터질 듯 풍만한 가슴에, 시선이 못을 박은 듯 고정된다….
						ELSEIF TALENT:TARGET:バストサイズ == -1
							PRINTFORML 사랑스러우면서도 볼륨감 있는 가슴이 자꾸만 언뜻 보이다가 감추는 듯하여 두근거린다…
						ELSEIF TALENT:TARGET:バストサイズ == -2
							PRINTFORML 가슴골은 슬플 정도의 깊이였지만, 젖꼭지가 보이기도 숨겨지기도 하는 모습이 무척이나 야했다.
						ELSE
							PRINTFORML 모양 좋은 가슴에, 시선이 못 박힌다…
						ENDIF
						PRINTW 
						PRINTFORML 「아— 가슴만 보고. 야한 거 하잖아……%UNICODE(0x2665) *1%」
						PRINTFORML 하타테가 화난 척하며 이마를 톡톡 건드려 왔다
						PRINTW 
					CASE 1
						PRINTFORML 「이런 게 기분 좋잖아…%UNICODE(0x2665) *1%」
						PRINTFORML 나체 에이프런 차림의 하타테는, 이쪽으로 엉덩이를 내밀어 보여주고 있다...
						PRINTW 
					CASE 2
						PRINTFORML 「이, 이 같은 차림으로 하면 되는 거야...?」
						PRINTFORML 하타테는 쭈뼛거리며 부끄러워하고 있다.
						PRINTW 
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「자기야, 어서 오세요%UNICODE(0x2665) *1%」
						PRINTFORML 「밥 먹을래? 목욕할래? 아니면, 나……?」
						PRINTW 
						PRINTFORML 「스스로 말해놓고는 말이야, 이거 엄청 부끄럽잖아……」
						PRINTFORML 「야, 옷 벗으면서 뛰어들면 안 돼%UNICODE(0x2665) *1%」
						PRINTW 
					CASE 1
						PRINTFORML 「저기~ 잘 어울릴까...?」
						CALL ASK_YN("정말 잘 어울린다","하타테쨩 최고로 귀엽다 역시 아내")
						IF !RESULT
							PRINTFORML 「정말요? 기뻐~%UNICODE(0x2665) *1%」
							PRINTFORML 하타테가 웃는 얼굴로 껴안아 왔다
							PRINTW 
						ELSE
							PRINTFORML 「も、も～～、褒めすぎだってばぁ…\/\/\/」
							PRINTFORML 하타테는 부끄러운지 어눌하게 웃었다.
							PRINTW 
						ENDIF
					CASE 2
						PRINTFORML 「에헤헤, 이제 신혼놀이가 아니라, 제대로 결혼한 거잖아……♪」
						PRINTFORML 「행복해, 아・나・타%UNICODE(0x2665) *1%」
						PRINTW 
				ENDSELECT
			ENDIF
			RETURN 1
		ELSE
			IF TEQUIP:0 == 0 && TEQUIP:1 == 0
				SELECTCASE RAND:3 ;custom code
					CASE 0
						PRINTFORML 「냉정하게 생각하면, 나체에 에이프런만 입고 요리하는 건 위험하겠지?」
						PRINTFORML 「나는 요괴니까 기름이 튄 정도로는 심한 부상 같은 건 안 당하지만 말이야~」
						PRINTW 
					CASE 1
						PRINTFORML 「나체에 에이프런이라니…… 왠지 부끄러워…….」
						PRINTFORML 「하지만, %MASTERNAME:42%, 왠지 기뻐 보이는데요…….♪」
						PRINTW 
					CASE 2
						PRINTFORML 「앗, 나 이런 책에서 본 적 있어읏」
						PRINTFORML 「나체 에이프런으로 요리하는 아내를, 남편이 뒤에서 껴안고……야하게 해버리는 거잖아…? %UNICODE(0x2665) *1%」
						PRINTW 
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「에헤헤, 뭔가 이거 하고 있으니까 정말 새 아내 된 기분이야…%UNICODE(0x2665) *1%」
						PRINTFORML 「어, 음, 있잖아, 웃지 마... 당신」
						PRINTFORML 「…………꺄아악, 정말 부끄러워! 당신도 말이야! 싫어ー\/\/\/」
						PRINTFORML 혼자 들떠서 혼자 부끄러워하는 하타테는 보고 있어 질리지 않았다
						PRINTW 
					CASE 1
						PRINTFORML 「에헤헤, 뭔가, 이런 거 좋다……%UNICODE(0x2665) *1%」
						PRINTFORML 하타테는 에이프런에 손을 대고, 감회 깊은 표정을 지었다
						PRINTW 
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
		RETURN 1
		;終了
	ELSE
		PRINTFORML 「아앙, 아~ 조금만 더 입고 있었으면 좋았을까나~」
		PRINTW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
