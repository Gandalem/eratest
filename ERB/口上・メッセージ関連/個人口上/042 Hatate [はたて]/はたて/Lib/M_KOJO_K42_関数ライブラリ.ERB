;==================================================
;スカートめくりで画像を表示
;290スレの>>728さんが作成してくださったものを使用しています
;==================================================

@K42_すかーとめくり
#DIMS RESOURCE_NAME
#DIMS PANTS_NAME
#DIM おぱんつ種類
#DIM 画像情報保存１
#DIM 画像情報保存２
#DIM 画像情報保存３
;基本IMAGE.ERBで表情作るときと一緒です
;わかりやすさ重点で分岐はなるべくIF文にしました
;顔絵表示と関数共用のため、先にサイズ情報を保持
画像情報保存１ = FLAG:マルチサイズ
画像情報保存２ = デフォルトキャラ画像横幅
画像情報保存３ = キャラ画像表示サイズ比
;はたての画像を大きく表示するように変数書き換え
FLAG:マルチサイズ = 1
デフォルトキャラ画像横幅 = 300
;サイズ変更は300*300を基準値100として、ここの数字10刻みで変えてください
キャラ画像表示サイズ比 = 100
;INPUT
;EQUIP:42:下半身下着２ =RESULT
;素体を決める
;分岐の組み合わせで呼び出すリソース名を作成します
;条件合うタグを後ろに付け足していくイメージ
RESOURCE_NAME = 42_
;バストサイズみる
SIF TALENT:42:バストサイズ > 0
	RESOURCE_NAME += "巨"
;表情変化の条件みる
IF TALENT:42:機嫌 == -1
	RESOURCE_NAME += "怒り"
ELSEIF TCVAR:42:発情 == 1
	RESOURCE_NAME += "発情"
ELSEIF TALENT:42:機嫌 == 1 || TCVAR:42:発情 == 1
	RESOURCE_NAME += "笑顔"
ELSE
	RESOURCE_NAME += "通常"
ENDIF
;恋慕表情の条件見る
SIF TALENT:恋慕 || TALENT:恋人 || TALENT:愛欲 || TALENT:セフレ
	RESOURCE_NAME += "恋"
;レイヤーセット関数に素体を送る,一番下のレイヤーに自動でセットされる
CALL IMAGE_SET(RESOURCE_NAME, 0, 0, キャラ画像表示サイズ比, 0)
;ぱんつ画像を決める
;ノーパンならぱんつ処理キャンセル→ノーパンで表示される
IF EQUIP:42:下半身下着２
	;EQUIP:下半身下着２から下着のID取得
	おぱんつ種類 = EQUIP:42:下半身下着２
	;リソース名は変数に対応した番号振ると処理が楽できます
	PANTS_NAME = 42_P{おぱんつ種類}
	;"42_P〇〇"の画像があるか判定、あったらそれを重ねる
	;画像作ってないのはノーパン扱い
	SIF SPRITECREATED(PANTS_NAME)
		CALL IMAGE_SET(PANTS_NAME, 0, 0, キャラ画像表示サイズ比, 1)
ENDIF
;重ねた画像を呼び出す
CALL SIMULTANEOUS_IMAGE_DISPLAY("LEFT", 0, 1, -1)
;顔絵表示サイズ用変数を元に戻す
FLAG:マルチサイズ = 画像情報保存１
デフォルトキャラ画像横幅 = 画像情報保存２
キャラ画像表示サイズ比 = 画像情報保存３
RETURN
