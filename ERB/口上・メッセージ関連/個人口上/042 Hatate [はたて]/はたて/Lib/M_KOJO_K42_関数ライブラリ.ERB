@NAME_SET_K42
gLineCount = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - gLineCount > 0
	CLEARLINE LINECOUNT - gLineCount
PRINTDL 당신을 지칭할 때 하타테가 사용할 이름을 입력하세요. (입력하거나 버튼을 누르세요)
IF NAME:MASTER != "Player"
	LOCALS = %NAME:MASTER%
ELSE
	LOCALS = %CALLNAME:MASTER%
ENDIF
PRINTBUTTON @"[단지 %LOCALS%뿐이다.]", @"%LOCALS%"
PRINTL 　
INPUTS
; 行頭行尾の空白文字削除
LOCALS = %RESULTS%
REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
;10文字以上は受け付けない
IF STRLENS(LOCALS) > 16
	CLEARLINE 1
	PRINTFORMW 「있잖아, 그거 정말 네 이름이야? 솔직히 말해봐? 야, 여전히 너무 길잖아~!」
	CONTINUE
	;空白は受け付けない
ELSEIF RESULTS == ""
	PRINTDW 이름을 입력하세요.
	CONTINUE
ELSE
	; 同姓同名
	IF FLAG:なりきり != [[はたて]] && STRCOUNT(LOCALS, "(?i)himekaidou|hatate")
		CLEARLINE 1
		PRINTFORMW 「엣, 우리 이름이 같다는 거야? 말도 안 돼! 그럴 리가 없어.」
		CONTINUE
		; うんそうだね多々良勝五郎とか教える人もいるかもしれないもんね
	ELSEIF (FLAG:なりきり != [[文]] && STRCOUNT(LOCALS, "(?i)shameimaru|(?i)aya")) || (FLAG:なりきり != [[にとり]] && STRCOUNT(LOCALS, "(?i)kawashiro|(?i)nitori")) || (FLAG:なりきり != [[椛]] && STRCOUNT(LOCALS, "(?i)inubashiri|(?i)momiji"))
		CLEARLINE 1
		PRINTFORMW 「엣? 너 인간인 줄 알았는데 사실은 요괴라고? 말도 안 돼, 그런 일이 일어날 리가 없잖아!」
		CONTINUE
		; 直接入力ならいけると思ったか？弾くぜ！
	ELSEIF ABL:親密 < 4 && STRCOUNT(LOCALS, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$")
		CLEARLINE 1
		PRINTFORMW 「꿈속에서 만나.」
		CONTINUE
	ELSEIF ABL:親密 < 7 && STRCOUNT(LOCALS, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$")
		CLEARLINE 1
		PRINTFORMW 「실례지만?」
		CONTINUE
	ELSEIF (ABL:従順 < 7 || ABL:奉仕精神 < 7) && STRCOUNT(LOCALS, "((?i)master|lord|god)$")
		CLEARLINE 1
		PRINTFORMW 「저기요? 무슨 소름 끼치는 역할극이에요?」
		CONTINUE
	ELSEIF (!TALENT:恋人 || !TALENT:恋慕) && STRCOUNT(LOCALS, "(?i)(husband|dear|darling|honey|hubby)$")
		CLEARLINE 1
		PRINTFORMW 「저기요? 이 역겨운 망상이 어디서 나오는 겁니까?! 당신 같은 변태 같으니라고!」
		CONTINUE
	ELSE
		PRINTFORML 「%RESULTS%... 그래?」
	ENDIF
	CALL ASK_YN
	IF RESULT == 0
		;あなたの名前を%MASTERNAME:42%に格納
		MASTERNAME:42 = %RESULTS%
		PRINTFORML 
		BREAK
	ELSEIF RESULT == 1
		CONTINUE
	ENDIF
ENDIF
LOOP 1
