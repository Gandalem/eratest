; Modular ERB: 個人口上/042 Hatate [はたて]/はたて/K42_固有カウンター2_膣内撮影.ERB
;固有カウンター可否

@UNIQUE_COUNTER2_ABLE_K42
SIF ABL:[[はたて]]:露出癖 < 5
	RETURN 0
SIF TEQUIP:[[はたて]]:50 == MASTER || TEQUIP:[[はたて]]:51 == MASTER
	RETURN 1
;固有カウンターの種別と頻度

@UNIQUE_COUNTER2_FREQUENCY_K42
;ソフト/ベリーソフト/コミュ/着衣/脱衣愛撫/脱衣強要/抱き着き/性交/責め/おねだりの中なら選ぶべし
;タイプによって発生しない状況があるので注意
RESULTS = 脱衣愛撫
;発生率、基本値(10)にこの数値を足す
;通常のカウンターはプラマイ5以下なので、テストプレイ以外であんまり極端な数字を入れない方がいい
RETURN 10 + MAX((ABL:[[はたて]]:露出癖 + ABL:[[はたて]]:欲望) / 2, 10)
;テキスト

@UNIQUE_COUNTER2_MESSAGE_K42
PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 염사진을 찍고, 카메라 화면을 이쪽으로 향하자 %조사처리(CALLNAME:MASTER,"의")% %TEXTR("おちんぽ/ペニス/肉棒/男根")%가
IF TEQUIP:[[はたて]]:50 == MASTER
	PRINTFORML  %TEXTR("膣襞/媚肉/雌穴/おまんこ/膣内")%를 헤집고 들어가는 모습을 적나라하게 보여주었다…
	SELECTCASE RAND:5
		CASE 0
			IF TEQUIP:子宮
				PRINTFORML 「보이나? %MASTERNAME:42%의 거시기랑, 하타테의 자궁이 키스하고 있는 곳...%UNICODE(0x2665) *1%」
				IF TALENT:妊娠願望 == 1
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「아하… 하타테가 아기를 갖고 싶어 하는 게 티 나네…%UNICODE(0x2665) *1%」
							PRINTFORML 「자궁 입구가 이렇게나 열려 있다니…%UNICODE(0x2665) *1%」
						CASE 1
							PRINTFORML 「입구도 파닥파닥 벌어지고…… 아기 젖 원해, 원해 하면서 애원하고 있는 거야……%UNICODE(0x2665) *1%」
					ENDSELECT
				ENDIF
			ELSE
				PRINTFORML 「와, 굉장해...읏%UNICODE(0x2665) *1% 거시기, 이렇게 깊숙이 들어오고 있어...%UNICODE(0x2665) *1%」
			ENDIF
		CASE 1
			PRINTFORML 「대단하다……%UNICODE(0x2665) *1% 나오고 들어가는 게 이런 느낌이구나……%UNICODE(0x2665) *1%」
		CASE 2
			PRINTFORML 「봐줘…… %UNICODE(0x2665) *1% 하타테 속에, %MASTERNAME:42%로 가득 차 있어…… %UNICODE(0x2665) *1%」
		CASE 3
			PRINTFORML 「%MASTERNAME:42%에게 하타테의 가장 중요한 곳이 보여버렸네...%UNICODE(0x2665) *1% 큰일 날지도...%UNICODE(0x2665) *1%」
		CASE 4
			PRINTFORML 「지금, 나의 질내는 이렇게 되어버린 거야...%UNICODE(0x2665) *1%」
	ENDSELECT
	PRINTL 
ELSEIF TEQUIP:[[はたて]]:51 == MASTER
	PRINTFORML %TEXTR("腸内/ケツマンコ/尻穴の中/")%를 구포구포 파헤치는 모습을 적나라하게 보여주었다…
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML 「엉덩이 구멍 속을 보여주는 건, 엄청 창피해……%MASTERNAME:42%에게만 말이야, 보여줄게…%UNICODE(0x2665) *1%」
		CASE 1
			PRINTFORML 「엉덩이 구멍의 이런 곳까지, 거기가 들어와 버렸어... 큰일이다%UNICODE(0x2665) *1%」
		CASE 2
			PRINTFORML 「보여져도 괜찮게, 신경 써서 예쁘게 해 두었잖아……%UNICODE(0x2665) *1%」
		CASE 3
			PRINTFORML 「엉덩이로 섹스할 때는, 속이 이런 느낌인 거구나...%UNICODE(0x2665) *1% 정말 야한 기분이야...%UNICODE(0x2665) *1%」
	ENDSELECT
	PRINTL 
ENDIF
PRINTW 
