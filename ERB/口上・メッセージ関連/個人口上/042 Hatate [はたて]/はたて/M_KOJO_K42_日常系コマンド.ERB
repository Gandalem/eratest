;TFLAG:211(4=地底の温泉で番台妖怪を怒らせている 1=温泉に入った
;TFLAG:194(1=連続入浴不可(表示しない可能性あり？
;==================================================

@M_KOJO_MESSAGE_COM_K42_431
CALL M_KOJO_MESSAGE_COM_K42_431_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_431_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF BATHCHECK(CFLAG:MASTER:現在位置)
		IF TFLAG:209 == 1
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「음~~~~♪ 살아나잖아%UNICODE(0x2665) *1%」
					PRINTFORML 하타테는 크게 기지개를 켜고, 커다란 욕조에 몸을 담그고 있다
					PRINTW 
				CASE 2
					PRINTFORML 「아~♪ 여기에 술이라도 있으면 정말 완벽한데 말이지」
					PRINTFORML 「뭐, 호사스러운 건 말할 수 없잖아~♪」
					PRINTW 
				CASEELSE
					PRINTFORMW 「아~~ 극락이다아♪」
					PRINTFORML 「집에는 목욕탕이 없어서, 이렇게 온천에 들어오면 설레는 거야~」
					PRINTW 
			ENDSELECT
		ELSEIF TFLAG:211 == 1
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「응~~~~~♪ 살아나네%UNICODE(0x2665) *1%」
					PRINTFORML 하타테는 크게 기지개를 켜고, 온천을 만끽하고 있다.
					PRINTW 
				CASE 2
					PRINTFORML 「후후♪ 뭔가, 피부가 매끈매끈해진 것 같아」
					PRINTFORML 하타테는 팔을 쓰다듬으며, 온천의 효능을 확인하고 있다.
					PRINTW 
				CASEELSE
					PRINTFORML 「응, 후우~~~♪ 온천에서 마시는 술은 정말 특별하네~%UNICODE(0x2665) *1%」
					PRINTFORML 하타테는 온천에 술을 가져와, 사발로 홀짝거리며 맛보고 있다
					PRINTW 
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
