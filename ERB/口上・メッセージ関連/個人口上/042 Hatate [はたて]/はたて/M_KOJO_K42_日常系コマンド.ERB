;449,虫捕り
;TFLAG:193,
;   -2=殺してでもうばいとる（取っ組み合いの末逃がす）
;   -1=ゆずってくれ！→拒否
;    0=捕獲失敗
;    1=MASTERが捕まえた
;    2=キャラが捕まえたのをMASTERが褒めた
;    3=ゆずってくれ！→渋々オッケー
;    4=ゆずってくれ！→オールオッケー
;TRAINMESSAGEを省略する場合は虫カゴに入れる処理を忘れないように
;ムシの名前は MUSHI_NAME で表示したり判別したりできます
;==================================================

@M_KOJO_MESSAGE_COM_K42_449
CALL M_KOJO_MESSAGE_COM_K42_449_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_449_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE -2
			IF TALENT:恋慕 || TALENT:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「설령 %MASTERNAME:42%일지라도, 포기할 수 없는 것이 있어...」
						PRINTFORML 「%MUSHI_NAME%는, 내 거야!」
						PRINTW 
					CASE 1
						PRINTFORML 「어느 쪽이 %MUSHI_NAME%의 소유자에게 어울리는지, 끝을 볼 수밖에 없네!」
						PRINTW 
					CASE 2
						PRINTFORML 「아—, 나를 이길 수 있다고 착각하고 있어~」
						PRINTFORML 「%MASTERNAME:42%는 좋아하지만, 그것과 이것은 별개의 문제잖아!」
						PRINTW 
				ENDSELECT
			ELSE
				SELECTCASE IFRAND("0TO2", 1, "3", TALENT:MASTER:年齢 == -1 && (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1))
					CASE 0
						PRINTFORML 「무슨 짓이야, 이 자식아!」
					CASE 1
						PRINTFORML 「뭐야! %MASTERNAME:42% 주제에 실력이 형편없잖아! 해버릴 거야~」
						PRINTW 
					CASE 2
						PRINTFORML 「후후후…… 괜찮겠다. %MASTERNAME:42%와는 한번 결판을 내고 싶었거든……」
						PRINTFORML 양손을 안절부절못하며, 느릿느릿 기어오는 하타테.
						PRINTFORML 함께, 죽을 때까지 싸우자...!
						PRINTFORML 
						PRINTFORML 『우와아아아아아아아아!!!!』
						PRINTFORML 
						PRINTFORML 
						PRINTFORML 하타테의 새로운 활약을 기대해 주세요!
						PRINTFORML 
						PRINTFORML 
						PRINTW 
					CASE 3; && TALENT:MASTER:年齢 == -1 && (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1) ;custom code
						PRINTFORML 「우와. 더러운 것, 역겨워!」
						PRINTFORML 「빼앗을 수 있는 거라면 한번 빼앗아 봐라니까!」
						PRINTW 
				ENDSELECT
