;448,罠を仕掛ける／虫トラップ
;TFLAG:193,
;   -1=罠が壊れた
;    0=罠を仕掛けた
;    1=獲物が得られた
;   10=虫トラップを仕掛けた
;   11=虫トラップを破棄した
;   12=ムシを捕まえた
;FLAG:194,獲物の番号
;ムシの名前は MUSHI_NAME で表示したり判別したりできます
;==================================================

@M_KOJO_MESSAGE_COM_K42_448
CALL M_KOJO_MESSAGE_COM_K42_448_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_448_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
		RETURN 0
	SELECTCASE TFLAG:193
		;罠が壊れた
		CASE -1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「와, 엉망진창이잖아」
					PRINTW 
				CASE 1
					PRINTFORML 「앗차, 대물이 걸려버린 건가」
					PRINTW 
				CASE 2
					PRINTFORML 「아앙, 애써 설치했는데~」
					PRINTW 
			ENDSELECT
			;罠を仕掛けた
		CASE 0
			IF TALENT:恋慕 || TALENT:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「이걸로, 됐어」
						PRINTW 
					CASE 1
						PRINTFORML 「도대체 뭐가 잡힐까나~♪」
						PRINTW 
					CASE 2
						PRINTFORML 「잘 걸렸으면 좋겠다~」
						PRINTW 
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「이걸로 괜찮아? 진짜 잡히는 거야?」
						PRINTW 
					CASE 1
						PRINTFORML 「잡히면 나한테 줘야지. 에~, 싫어?」
						PRINTW 
					CASE 2
						PRINTFORML 「앗! 걸렸어!」
						PRINTW 
				ENDSELECT
			ENDIF
			;獲物が得られた
		CASE 1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「야호~♪ 걸렸어~♪」
					PRINTW 
				CASE 1
					PRINTFORML 「봐 봐, %MASTERNAME:42%. 뭔가 있어」
					PRINTW 
				CASE 2
					PRINTFORML 「앗! 걸렸어!」
					PRINTW 
				CASE 3
					PRINTFORML 「%CritterName%가 걸렸네」
					PRINTW 
			ENDSELECT
			;虫トラップを仕掛けた
		CASE 10
			IF TALENT:TARGET:育児中
				PRINTFORML 「잡히면, %CHILDNAME:42:(TALENT:TARGET:育児中)%가 기뻐할 거야♪」
				PRINTW 
			ELSEIF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「내일이 기대된다~, %MASTERNAME:42%」
				PRINTW 
			ELSE
				PRINTFORML 「무슨 함정을 놓아볼까나~♪」
				PRINTW 
			ENDIF
			;虫トラップを破棄した
		CASE 11
			PRINTFORML 「여기 함정, 풀어볼까? 괜찮지~」
			PRINTW 
			;虫を捕まえた
		CASE 12
			PRINTFORML 「어, %MUSHI_NAME%다아」
			PRINTW 
	ENDSELECT
ENDIF
RETURN 1
