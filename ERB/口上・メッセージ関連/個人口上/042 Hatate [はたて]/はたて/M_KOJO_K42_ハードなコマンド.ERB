;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K42_140
CALL M_KOJO_MESSAGE_COM_K42_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K42_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORML 「크윽…… 아앗, 끅, 으윽...!」
			PRINTFORML 「콜록, 크헉, 게에윽……」
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「하아, 하아... 있잖아, 무리하게는 그만해줘...!」
				PRINTFORML 「입으로는 해줄 테니까...」
				PRINTW 
			ELSE
				PRINTFORML 「좀, 거친 건 그만해…!」
				PRINTW 
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF TALENT:恋慕 || TALENT:恋人
			IF ABL:Ｍ感覚 >= 5
				PRINTFORML 쥬뿝! 츄븝! 부븝! 구븝! 퍽! 퍽!
				PRINTFORML 「%UNICODE(0x2665) *1%%UNICODE(0x2665) *1% 으으읏%UNICODE(0x2665) *1% 으으읏%UNICODE(0x2665) *1%」
				PRINTFORML 하타테는 목구멍 깊숙한 곳을 퍽퍽 찔리면서도, 행복한 듯이 육봉에 매달려 빨아대고 있다.
				PRINTW 
			ELSEIF ABL:Ｍ感覚 >= 2
				PRINTFORML 츄릅! 철퍽! 꾸욱! 우읏!
				PRINTFORML 「어윽%UNICODE(0x2665) *1% 고윽%UNICODE(0x2665) *1%」
				PRINTFORML (난폭한데도, 괴로운데도, 기분 좋은데도%UNICODE(0x2665) *1% 어째서...!)
				PRINTW 
			ELSE
				PRINTFORML 축팟! 푸슉! 꾸벅! 퍽!
				PRINTFORML 「어? 헉!? 아앗!? 아앗!! 어으윽!」
				PRINTFORML 하타테가 허벅지를 두드리며 항의했지만, 이를 무시하고 목구멍 깊숙한 곳까지 박아 넣었다.
				PRINTW 
			ENDIF
			RETURN 1
		ELSEIF TALENT:思慕
			IF ABL:Ｍ感覚 >= 5
				PRINTFORML 쭉! 츄압! 푹! 구욱! 퍽! 퍽!
				PRINTFORML 「오옷, 구욱, 후—%UNICODE(0x2665) *1% 후—%UNICODE(0x2665) *1%」
				PRINTFORML 하타테는 고통과 쾌락이 뒤섞인 표정으로 육봉에 빨려 붙어 있다.
				PRINTW 
			ELSEIF ABL:Ｍ感覚 >= 2
				PRINTFORML 쥬폿! 부츄읏! 부보읏! 구폿!
				PRINTFORML 「어윽, 으음, 음붓, 음붓」
				PRINTFORML 하타테는 고통에 얼굴을 일그러뜨리면서도, 뺨을 희미하게 상기시키고 있다.
				PRINTW 
			ELSE
				PRINTFORML 축팟! 푸슉! 꾸벅! 퍽!
				PRINTFORML 「어? 헉!? 아앗!? 아앗!! 어으윽!」
				PRINTFORML 하타테가 허벅지를 두드리며 항의했지만, 이를 무시하고 목구멍 깊숙한 곳까지 박아 넣었다.
				PRINTW 
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
