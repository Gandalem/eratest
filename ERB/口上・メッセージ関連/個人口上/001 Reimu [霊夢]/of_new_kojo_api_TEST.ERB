;general version of EXTRASOURCE
;EXTRASOURCEの汎用版
@M_KOJO_無個性_EXTRASOURCE_SCOM_K1_GENERAL
@M_KOJO_無個性_EXTRASOURCE_COM_K1_GENERAL

;custom shop button
;カスタムSHOPボタン
;y is the id of the button, range from 0 to 9
;yはボタンのID、0~9に対応

@KOJO_無個性_CUSTOM_BUTTON_CONDITION_K1_0
custom_button_name:1:0 = Switch Dialogue
custom_talent:1:0 = 1
custom_talent_name:1:0 = No PC Response
;judge the button can be shown, if return 1, it will show
;これをRETURN 1するとボタンが表示される
RETURN 0 ;dialogues are merged into 1 for Reimu on our side

;when the button is clicked
;ボタンがクリックされた場合
@KOJO_無個性_CUSTOM_BUTTON_K1_0
CFLAG:1:口上セレクタ = !CFLAG:1:口上セレクタ
custom_talent_name:1:0 = Default
PRINTFORML 「Set to %custom_talent_name:1:0%.」

@KOJO_無個性_CUSTOM_BUTTON_CONDITION_K1_1
custom_button_name:1:1 = テスト
;judge the button can be shown, if return 1, it will show
;これをRETURN 1するとボタンが表示される
RETURN 0

;when the button is clicked
;ボタンがクリックされた場合
@KOJO_無個性_CUSTOM_BUTTON_K1_1
PRINTFORML 「テスト」

@KOJO_CUSTOM_BUTTON_CONDITION_K1_0
custom_button_name:1:0 = Switch Dialogue
custom_talent:1:0 = 0
custom_talent_name:1:0 = Default
RETURN 0

@KOJO_CUSTOM_BUTTON_K1_0
CFLAG:1:口上セレクタ = !CFLAG:1:口上セレクタ
custom_talent_name:1:0 = No PC Response
PRINTFORML 「Set to %custom_talent_name:1:0%.」

;custom talent(copy form ckr)
;カスタム素質
;xx is the id of the talent, range from 0 to 29
;xxは素質ID、0~29に対応
;if this variable != 0, it will show
;この変数が0でなければ表示

;custom com
;y is the id of the button, range from 0 to 29
@KOJO_COM_NAME_K1_0
	RESULTS = Donate
;judge
;judge the button can be shown, if return 1, it will show
@KOJO_COM_ABLE_K1_0
SIF CFLAG:1:うふふ ;Custom code, not in sex.
	RETURN 0
SIF SHIRAHU(TARGET) ;custom code
	RETURN 1

;judge body, you can refer to other com
;such as @COM9
@KOJO_COM_K1_0
CALL SET_KOJO_COLOR() ;custom code
PRINTFORML 「What is it? Are you here to donate?」
CALL ASK_M(@"Yes (%金額表示(1000)%, Favor＋1)",MONEY >= 1000,"No",1,)
SELECTCASE RESULT
	CASE 0
		CALL PAY_MONEY_YEN(1000, 1)
		PRINTFORML 「Thanks!」
		CALL CHANGE_CFLAG(2,1,1)
	CASE 1
		PRINTFORML 「Pish, you miser!」
ENDSELECT
RETURN 1

