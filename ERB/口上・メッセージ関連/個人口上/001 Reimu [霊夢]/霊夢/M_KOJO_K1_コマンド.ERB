;=================================================
;特殊コマンド
;=================================================
;-------------------------------------------------
;180,ローション
;-------------------------------------------------

@M_KOJO_MESSAGE_COM_K1_180
CALL M_KOJO_MESSAGE_COM_K1_180_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;CFLAG:1500 = 0 ;custom code, don't reset this each time
	;0.イベントがオフだよ　選択肢が出るよ　　初期値の事情だよ
	;1.イベントがオンだよ　選択肢が出るよ
	;2.イベントがオフだよ　選択肢を出さないよ
	;3.イベントがオンだよ　選択肢を出さないよ
	;4.イベントがオフだよ　選択肢が出るよ　　bit2が真だよ
	;1=オン（bit0）　2=選択肢を出さないよ（bit1）
	;4=簡単に条件を付け足せるよ（bit2）
	;GETBIT (CFLAG:1500,1)　ここの1は二進数の二桁目の事　間違いやすいよ
	;(CFLAG:1500,1)の数値真(0以外主に1)偽(0)を見るよ
	;SETBIT STAIN:1,7　二進数の八桁目を真(主に1)にするよ
	;十進数で言えば　+128されていない場合+128するよ
	;CLEARBIT STAIN:1,7　二進数の八桁目を偽(0)にするよ
	;十進数で言えば　既に+128されている場合に限り-128するよ
	;INVATEBIT STAIN:1,7　二進数の八桁目を反転させるよ
	;十進数で言えば　+128されていない場合+128　既に+128されている場合-128するよ
	;時間停止フラグがかつ参照する事のbit1(選択肢を出さないよ)が偽なら選択肢が出る
	SIF !FLAG:70 && !GETBIT(CFLAG:1500,1)
		CALL KOJO_OPTION_K1_RESULT_2() ;custom code, rewritten menu
	;テンプレ作者様に心からの感謝を。
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF FLAG:時間停止
			IF FIRSTTIME("LotionTS") ;custom code - separated first time sections for each
				;todo - test if chocolate play lines even show up as intended
				;時間稼働中に始動している場合の矛盾解消
				;チョコ分岐
				IF GETBIT(STAIN:1,7)
					PRINTFORML 
					PRINTFORMDW 당신은 레이무의 몸 전체에 초콜릿을 뿌린다.
					PRINTFORMDW 그녀의 향과 초콜릿의 향이 섞인다.
					PRINTFORMDW 당신은 깊게 숨을 들이마시며 그 달콤한 향을 즐긴다...
					;それ以外　時間停止ローション
					;時間停止塗り塗り分岐は無い　きっとそれが正義
				ELSE
					PRINTFORML 
					PRINTFORMDW 당신은 한 움큼의 로션을 떠 올린다.
					PRINTFORMDW 손을 비비며, 당신은 로션을 레이무의 피부에 떨어뜨린다.
					PRINTFORMDW 로션이 흐르면서 물줄기를 형성한다.
					PRINTFORMDW 거기서부터, 당신은 그 물줄기를 그녀의 사타구니와 가슴 쪽으로 집중시키기 시작한다.
					PRINTFORMDW 그녀의 몸에 로션 때문에 광택이 돈다...
				ENDIF
				RETURN 1
			ENDIF
			;以降!FLAG:時間停止　「発言」は概ねここから
			;分岐条件　チョコ塗れの手ペロペロ分岐
			;足の汚れは無いので手を手足として代用
			;別の形でチョコを塗った時もここに来るので一応イベントフラグも条件に追加
		ELSEIF GETBIT(STAIN:1,7) && GETBIT(CFLAG:1500,0) && FIRSTTIME("Lotion_1")
			PRINTFORML 
			PRINTFORMDW 당신은 혀로 레이무의 발을 핥는다.
			PRINTFORMW 「끄으윽... 그만둬, 내 발 아니야...」
			PRINTFORMDW 레이무는 당신의 손길에 간지러움을 느끼며 비명을 지른다.
			PRINTFORMDW 다음으로, 당신은 레이무의 손을 잡는다.
			PRINTFORMW 「...? %CALLNAME:MASTER%...?」
			PRINTFORMDW 당신은 그녀의 손가락을 핥기 시작한다.
			PRINTFORMW 「...뭐... 뭐 하는 거야...」
			IF !CFLAG:1:1092
				PRINTFORMDW "내가 뭘 하는 거지? 그냥 음식을 낭비하지 않으려고 노력하는 거야."
				PRINTFORMDW 그녀의 몸에 남은 초콜릿을 계속 핥으며 말한다.
			ENDIF
			PRINTFORMDW 너는 그녀의 발을 잡고 그것들을 핥는다.
			PRINTFORMW 「그만-멈춰, 그만...」
			PRINTFORMDW 레이무의 얼굴은 당황함으로 달아올랐다.
			PRINTFORMDW 너는 마치 혀로 어루만지듯 그녀의 발가락을 부드럽게 핥는다.
			PRINTFORMW 「그만... 으윽, 윽...」
			PRINTFORMDW 네가 그녀의 발바닥을 핥기 시작하자, 그녀는 작은 비명을 질렀다.
			PRINTFORMDW 너는 그녀의 발 구석구석을 핥은 후 혀를 거둔다.
			PRINTFORMDW 은빛 침 한 가닥이 너의 혀와 그녀의 발가락 사이에 형성되었다.
			PRINTFORMW 「...변태...」
			PRINTFORMDW 레이무는 얼굴을 새빨갛게 물리고 말했다.
			;お手々のチョコ舐め取ったよ
			;CLEARBIT STAIN:1,7
			RETURN 1
			;分岐条件　CFLAG:1500のbit0の値これ真ならイベント発生　塗り塗り分岐
		ELSEIF GETBIT(STAIN:1,7) && FIRSTTIME("Lotion_2") ;custom code, condition fix
			PRINTFORML 
			IF !CFLAG:1:1092
				PRINTFORMDW "레이무, 이거 몸에 발라줄 수 있어?"
				PRINTFORMW 「...이게 뭐야?」
				PRINTFORMDW "이거? 그 말이야, 당연히 그거."
			ENDIF
			PRINTFORMW 「이게 뭐야?」
			SIF !CFLAG:1:1092
				PRINTFORMDW "초콜릿이야."
			PRINTFORMW 「…초콜릿?」
			SIF !CFLAG:1:1092
				PRINTFORMDW "응."
			PRINTFORMW 「초콜릿은 먹는 거 아니야?」
			IF !CFLAG:1:1092
				PRINTFORMDW "응, 하지만 이런 식으로도 사용할 수 있어."
				PRINTFORMW 「...꽤나... 도착적이네.」
			ELSE
				PRINTFORMW 「...초콜릿을 정말 도착적으로 사용했네...」
			ENDIF
			PRINTFORMDW 레이무가 한숨을 쉰다.
			PRINTFORMW 「...어쩔 수 없지, 무슨 말을 해도 듣지 않을 테니까.」
			PRINTFORMDW 그녀는 포기하고 너를 설득하려는 노력을 그만둔다.
			IF !CFLAG:1:1092
				PRINTFORMDW 당신은 초콜릿을 한 줌 게 눈으로 떠 올렸다.
			ELSE
				PRINTFORMDW 당신은 한 움큼의 초콜릿을 떠 올린다.
			ENDIF
			PRINTFORMDW 그러고는 천천히 초콜릿을 레이무의 피부에 흘리기 시작한다.
			PRINTFORMW 「으윽... 미지근해...」
			PRINTFORMDW 레이무는 자신의 피부에 닿은 초콜릿의 미지근한 감각에 놀란다.
			PRINTFORMDW 그녀의 몸에서 달콤한 향이 풍겨온다.
			PRINTFORMW 「음... 좋은 냄새지만, 온몸에 다 흘리고 있으니까...」
			PRINTFORMW 「냄새가 배지 않을까...?」
			PRINTFORMDW 당신은 초콜릿을 한 줌 더 떠서 그녀의 가슴과 사타구니에 흘린다.
			PRINTFORMW 「응... 그만해... 손이 정말 도착적으로 움직이고 있어... 하아, 응...」
			PRINTFORMDW 레이무는 감미롭게 신음한다.
			PRINTFORMDW 당신은 초콜릿을 그녀의 피부 위에 바르며 문지르기 시작한다...
			;お手々べとべと
			SETBIT STAIN:1,7
			RETURN 1
			;それ以外　ローション分岐
		ELSEIF !GETBIT(STAIN:1,7) && FIRSTTIME("Lotion_3")
			PRINTFORML 
			SIF !CFLAG:1:1092
				PRINTFORMDW "레이무, 이거 좀 발라보자."
			PRINTFORMW 「...이건 뭐지... 투명한... 거야?」
			SIF !CFLAG:1:1092
				PRINTFORMDW "그건 윤활제야."
			PRINTFORMW 「루브?」
			SIF !CFLAG:1:1092
				PRINTFORMDW "음, 기본적으로 윤활제랄까."
			PRINTFORMW 「...윤활제...」
			PRINTFORMDW 그녀는 로션 한 움큼을 떠 올린다.
			PRINTFORMW 「아... 아직 괜찮다고 말하지 않았는데... 뭐, 어쩔 수 없겠지...」
			PRINTFORMDW 레이무는 체념한 듯 말한다.
			SIF !CFLAG:1:1092
				PRINTFORMDW "그러면... 여기 있군."
			PRINTFORMW 「으윽?! 추워... 음...」
			PRINTFORMDW 너는 그녀의 피부에 로션을 떨어뜨린다.
			PRINTFORMDW 그리고 너는 로션을 문질러 온몸에 펴 바른다.
			PRINTFORMW 「음... 미끌거려...」
			PRINTFORMDW 그녀는 몸 전체에 발린 윤활제 감각에 홍조를 띤다.
			PRINTFORMDW 그녀가 그 느낌에 익숙해지자, 너는 로션을 그녀의 가슴과 사타구니에 바른다.
