;added, original content
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K1(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME '= STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K1
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K1(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K1(ROLE, SCENE, CLIENT_ID)
ENDIF
RESETCOLOR
SIF RESULT
	RETURN 1
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K1
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			;SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;CASE "一般依頼名"
			SELECTCASE SCENE
				CASE "依頼提示時"
					;依頼を持ちかけられる時
					PRINTDATAL
						DATAFORM 「잠깐 시간 좀 내줄 수 있나요?」
						DATAFORM 「제가 뭔가 여쭤봐도 괜찮을까요?」
						DATAFORM 「저를 도와주시겠어요?」
						DATAFORM 「사람들을 도와주느라 바빴던 것 같네요, 그렇죠?」
						DATAFORM 「%CALLNAME:MASTER%, 지금 시간 있으시니 제 심부름 좀 해주시는 건 어떨까요?」
						DATAFORM 「%CALLNAME:MASTER%, 이 부탁을 들어주시겠어요?」
					ENDDATA
				CASE "依頼非受託時"
					;内容だけ見て受託しなかった時
					PRINTDATAL
						DATAFORM 「아, 내 부탁을 듣고 싶지 않다는 거야? 돈도 줄 수 있는데 말이야.」
						DATAFORM 「...실망이네.」
						DATAFORM 「왜, 이건 그냥 평범한 부탁이라고. 너무 고집 세잖아!」
						DATAFORM 「흥... 뭐, 네가 그렇게 할 거라면...」
						DATAFORM 「음? 왜 그랬어? 도와주려고 할 줄 알았는데.」
					ENDDATA
				CASE "依頼受託時"
					;依頼を受託した時
					PRINTDATAW
						DATAFORM 「고맙다.」
						DATAFORM 「진지하게 임해줘서 기쁘군.」
						DATAFORM 「그럴 거라 알고 있었다. 기대하겠다.」
						DATAFORM 「만약 그 일을 감당할 자신이 없다면, 지금 돌아가는 게 좋을 거다.」
						DATAFORM 「%CALLNAME:MASTER%, 나태해지지 않도록 해라. 네 마음대로 아무거나 하지 말고.」
						DATAFORM 「네가 최우선으로 생각해도 상관은 없지만. 아니, 사실 그렇게 해야 한다.」
					ENDDATA
				CASE "依頼確認時"
					;[366]で依頼内容を依頼人に確認した時
					PRINTDATAL
						DATAFORM 「요청은...」
						DATAFORM 「어떤 질문에 대한 답을 원하시나요?」
						DATAFORM 「음, 지난번에 분명하게 말했다고 생각했는데. 좋아, 다시 시작해 볼까...」
						DATAFORM 「하지만 시도해 봐야 할 겁니다. 가만히 앉아 있으면 아무것도 얻지 못할 테니까.」
					ENDDATA
				CASE "依頼破棄時"
					;受託した依頼を破棄する時
					PRINTDATAL LOCAL
						DATAFORM 「알겠다... 어쩔 수 없겠지.」
						DATAFORM 「없다고? 음. 그럼 어떤 종류의 의뢰를 받고 싶으신가요?」
						DATAFORM 「음? 취소한다는 게 무슨 소리야? 농담이지?!」
						DATAFORM 「나에게 희망을 갖게 하다니... 한 번 속으면...」
						DATAFORM 「받았는데 이제 거절하는 거야? 믿을 수가 없군...」
					ENDDATA
					SIF GROUPMATCH(LOCAL, 2, 3, 4)
						PRINTFORMDL 레이무는 불평하지만, 그다지 화가 있는 것 같지는 않다... 적어도 당신은 그렇게 바란다.
				CASE "依頼実行直前"
					;[367]で依頼を実行する時、実行処理の前に呼び出される
				CASE "依頼実行直後"
					;[367]で依頼を実行する時、実行処理の後に呼び出される
				CASE "成功報告時"
					;報告時（成功）
					PRINTDATAL
						DATAFORM 「요즘 나한테 그렇게 도움이 됐으니, 뭔가 보답하고 싶어.」
						DATAFORM 「%CALLNAME:MASTER%정말 잘했어! 지금까지 아주 잘 해왔어.」
						DATAFORM 「항상 나를 위해 이런 일들을 해주네, %CALLNAME:MASTER%. 믿을 수 있겠다고 생각했어.」
						DATAFORM 「...순식간이군. 아직 네 보상을 준비하지도 못한 것 같은데. 잠시만... 그래, 이걸로 됐어.」
						DATALIST
							DATAFORM 「당신은 정말 시간 엄격하군요. 외계인인가요? 아, 맞다, 당신은 바깥에서 왔군요...」
							DATAFORM 「다른 사람들과 달리 그렇게 분별력이 있는 이유가 궁금했거든요.」
						ENDLIST
						DATALIST
							DATAFORM 「잘했어. 네가 해낼 줄 알았지. 노고에 대한 작은 선물이란다.」
							DATAFORM 「하쿠레이 신사는 빚을 반드시 갚는다는 것을 알려두겠다.」
						ENDLIST
					ENDDATA
				CASE "失敗報告時"
					;報告時（失敗）
					;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					PRINTDATAL
						DATALIST
							DATAFORM 「%CALLNAME:MASTER%, 나에게 부탁을 들어주겠다고 했었는데... 왜 이렇게 늦었지? 무슨 일이야?」
							DATAFORM 「아, 그렇군요. 안됐네요...」
						ENDLIST
						DATAFORM 「음, 흥미롭군. 그렇게 화려하게 실패할 수 있을 줄은 몰랐어. 뭐...」
						DATAFORM 「정말로 그게 감당 가능하다고 생각했나? 음, 다음엔 좀 더 깊이 생각해 보는 게 좋겠어.」
						DATALIST
							DATAFORM 「%CALLNAME:MASTER%, 여기에 오기 전에 뭘 하고 있었지?」
							DATAFORM 「음... 거기서 많은 시간을 허비했군. 그럴 만도 하지.」
						ENDLIST
					ENDDATA
					PRINTFORMDL 레이무는 평소처럼 무표정한 말투로 말한다. 하지만 그녀라면 아마 그것 때문에 여전히 속상할 것이다...
			ENDSELECT
			;ENDSELECT
			RETURN 1
		ENDIF
ENDSELECT
RESETCOLOR
;for massage request, rub reimu's shoulders

@M_KOJO_IRAI_肩もみ_K1(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF FIRSTTIME("Irai1", 0, 1)
			PRINTFORML 「너한테 할 일이 생겼어. 있잖아, 이... 너 늘 주변에 있으니까...」
			PRINTFORMDL 레이무가 어깨를 으쓱하며 말한다.
			PRINTFORML 「만약 그걸 해준다면, 내가 차라도 줄게.」
			RETURN 1
		ENDIF
		SELECTCASE RAND:7
			CASE 0
				PRINTFORML 「손재주가 꽤 좋으신 것 같은데, 그렇죠?」
				PRINTFORML 「저를 위해 작은 것을 하나 해주시겠어요?」
			CASE 1
				PRINTFORML 「이건 별로지만... 다른 선택지가 없는 것 같아.」
			CASE 2
				PRINTFORML 「이 일에 대해 물어볼 만한 다른 사람이 없어서 웃음거리가 될까 봐 걱정이야.」
				PRINTFORML 「그래서, 부탁할 수 있을까요?」
			CASE 3
				PRINTFORML 「이봐요, %CALLNAME:MASTER%! 완벽하군요, 와 주셨네요.」
				PRINTFORML 「다른 사람을 돕는 연습이 필요할 것 같아요. 괜찮으시겠어요?」
			CASE 4
				PRINTFORML 「너에게 할 일이 있다. 어깨가 좀 뻐근해서 어깨 마사지를 받을까 생각 중이었다.」
			CASE 5
				PRINTFORML 「보시다시피, 이런 문제에 있어서 당신보다 더 나은 사람은 없습니다, %CALLNAME:MASTER%.」
			CASE 6
				PRINTFORML 「요즘 어깨가 너무 뻣뻣해서... 좀 도와주시겠어요?」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「이렇게 뻣뻣하면 잠들기가 힘들더라고, 알지?」
			DATAFORM 「좋아... 다시 마리사한테 부탁하고 일주일 동안 그 농담을 참아야겠네.」
			DATAFORM 「정말? 그렇게 나를 만지는 게 두려워?」
			DATAFORM 「흥. 간단할 줄 알았는데. 이게 왜 너한테 그렇게 큰 문제인 거야?」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTFORML 「감사합니다. 잠시만 시간 내주시면 됩니다. 하지만 제가 안심할 때까지 몇 번 하셔야 할 수도 있어요.」
		PRINTFORMW 「아, 그리고 저를 부적절하게 만지지 말아 주세요. 제가 당신에게 만져도 된다고 허락하는 건 아니니까 알겠죠?」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「이게 뭐가 어렵다는 거야? 그냥 손을 좀 써봐!」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「아라... 이대로는 더 복잡한 부탁을 맡기기가 두렵군요.」
		RETURN 1
	CASE "依頼実行直前"
		PRINTDATAL
			DATAFORM 「아아, 네, 이 곳이...」
			DATAFORM 「더 세게 해주세요, 네...」
			DATAFORM 「흐음, 내가 신경을 안 쓰고 있다고 해서 아무 데나 만져도 된다는 건 아니에요... 내 등을 계속 잡아주세요.」
			DATAFORM 「네, 부끄러워하지 말고 진심으로 문질러 주세요...」
			DATAFORM 「계속 그렇게 해줘요... 조금 더 위로... 네, 완벽해요...」
		ENDDATA
		RETURN 1
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORML 「고마워, 기분이 정말 좋아졌어. 몸이 훨씬 가벼워진 것 같아.」
		PRINTFORML 「자, 이거 마셔봐. 차 같은 건데 더 나아. 내가 아침에 커피 대신 마시면서 활력을 얻는 거야.」
		PRINTFORML 「사실 난 커피가 싫거든.」
		IF TALENT:恋慕 && !(MARK:反発刻印 || CFLAG:ブチギレ)
			PRINTFORML 「아, 그리고 거래를 좀 달게 해 줄 작은 선물이 있어.」
			CALL GetRandMaterial(1, 10000, 5000)
			PRINTFORML 「얼마 전에 그것을 찾았는데, 네가 쓸 수 있을 것 같아서 말이야.」
			PRINTFORML 「아, 그리고 음... 이것도.」
			PRINTFORMDL 레이무는 몸을 앞으로 숙여 네 뺨에 부드럽게 입을 맞춘다...
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		PRINTFORML 「어디에 도망간 거니? 가끔은 정말...」
		PRINTFORML 「이런 일에서 실패하다니, 너에게 약간의 문제가 있는 것 같구나.」
		RETURN 1
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
;help Marisa return her lost item

@M_KOJO_IRAI_魔理沙の忘れ物_K1(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE DAY%4
			CASE 1
				PRINTFORML 「아, %CALLNAME:MASTER%. 정말 딱 맞춰 왔네.」
				PRINTFORML 「있잖아, 마리사가 물건을 뒤지다가 무언가를 깜빡했어-- 음, 내 창고를 뒤지는 걸 말이야. 그 산만한 애가...」
				PRINTFORML 「분명 나한테 나가서 만나라고 했던 것 같은데, 오늘은 다른 계획이 있어. 게다가 매번 그녀를 돌봐주고 싶지도 않거든.」
				PRINTFORML 「혹시 그걸 그녀에게 그냥 건네줄 수 있겠니? 이 수고에 보답할 약간의 용돈이라도 줄게.」
				PRINTFORML 「솔직히 기부금으로 그런 거 잘 못 받거든, 있잖아.」
			CASE 2
				PRINTFORML 「%SPLIT_G("나 또 마리사가 잃어버린 물건을 돌려받는 걸 도와달라고 부탁하는 거야.:마리사가 잃어버린 물건을 되찾도록 도와줄 수 있어?")%」
				PRINTFORML 「그녀는 나에게 이런 편지들을 계속 쓰는데, 급하고 뭐 그런 내용들이야.」
				PRINTFORML 「만약 내가 벽난로라도 가지고 있다면, 이미 그걸 태우기엔 충분한 양을 받았다.」
				PRINTFORML 「고통스럽지만 네가 이 일을 할 가치가 있도록 돈이라 좀 넣어주지.」
			CASE 3
				PRINTFORML 「있잖아, 마리사가 여기서 물건을 놓고 간 걸 깨달았어. 그래서 돌려주고 싶거든.」
				PRINTFORML 「내가 직접 돌려주겠지만... 그 일 때문에 오늘 외출하는 건 좀 귀찮아.」
				PRINTFORML 「물론 그녀가 찾으러 올 수도 있겠지만, 보통 이런 것들에 대해 고집이 세잖아.」
				PRINTFORML 「나 대신 해줄 수 있어? 내 신사는 분실물 센터 같은 곳이 아니거든, 하아.」
			CASEELSE
				PRINTFORML 「너는 무슨 일이든 처리할 수 있는 사람이지, 안 그래? 마리사가 또 무언가를 잊어버린 것 같아.」
				PRINTFORML 「내가 더 일찍 알아차리지 못한 것이 내 잘못이야. 어떤 것들은 변하지 않는구나, 응?」
				PRINTFORML 「지금 당장은 그녀를 보고 싶지 않지만, 어떻게든 도와야 할 것 같은 기분이 들어.」
				PRINTFORML 「자, 여기. 내 부탁을 전해주고 대신 가져다줄 수 있겠니? 돌아오면 특별한 걸 줄게.」
		ENDSELECT
		IF CFLAG:現在位置 == CFLAG:11:現在位置
			PRINTFORMDL 음, 레이무... 마리사가 바로 여기 있는데?
			PRINTFORML 「내가 신경 쓰는 것처럼 보이니? 이제 네 일이야. 가서 가져와.」
			CALL CHARA_TEXT( [[魔理沙]], "『...뭐야, 도대체 무슨 소리 하는 거야?』")
			PRINTFORMDL 대답하는 대신 레이무는 그저 당신에게 윙크를 하고 마리사에 고개를 끄덕였다. 그녀가 무엇을 하려는 걸까...?
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「하아... 그냥 버려야겠지.」
			DATAFORM 「음... 그녀가 여기 와서 직접 가져갈 때까지 기다리자.」
			DATAFORM 「그 일에 대해 한바탕 꾸짖어줘야 할 것 같군...」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「받아주실 거예요? 고마워요. 이런 걸 부탁해서 미안해요.」
			DATAFORM 「고마워요. 당신을 믿게 되어서 기뻐요.」
			DATAFORM 「좋아요. 아, 그리고 마리사에 다음엔 %SPLIT_G("all the way to the Underground so she'll have to convince local oni to part with it:in the pond so she'll have to dive for it:to the Moon. Good luck getting there:at the Bamboo forest. If she gets lost there, it's none of my business:away like a junk it is")% 할 거라고 전해줘.」
			DATALIST
				DATAFORM 「으음... 팔아버렸어야 했나. 꽤 가치 있는 것 같네.」
				DATAFORM 「뭐 됐어, 잘 가렴.」
			ENDLIST
		ENDDATA
		PRINTFORML 「마리사는 아마 마법의 숲에 있는 자기 곳에서 시간을 보낼 것이다. 여기서부터는 먼 여정이다, 그러니 조심해라.」
		PRINTFORML 「가끔 스칼렛 데빌 맨션이나 인간 마을을 방문하고 있을 수도 있다, 그것도 가능성이 있다.」
		PRINTFORML 「아, 그리고 만약 그녀를 아직 찾지 못한다면 그냥 문 앞에 두어도 상관없다, 별일 아니니까.」
		PRINTFORML 「행운을 빈다.」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「그래-응, 잡동사니야, 마리사, 돌려줘, 확실히 처리해 버려.」
		PRINTFORMDL 마지막 부분을 제대로 들었는지 확신이 서지 않는군...
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「뭐야, 안 돼? 너무 귀찮은 부탁인가 보네.」
		PRINTFORML 「음, 네 잘못이라고 할 수는 없지.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORML 「...네가 보상을 받으러 돌아오지 않기를 바랐는데.」
		PRINTFORML 「뭐, 네 쪽은 약속을 지었으니... 뭐...」
		PRINTFORML 「아니, 이것이 나를 유혹하게 두지는 않을 거야. 여기... 너의... 돈이야...」
		PRINTFORMDL 플레이어는 레이무가 떨리는 손으로 500엔짜리 지폐를 꽉 쥐고 상당히 망설이는 것을 알아차린다.
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「길을 잃은 거야? 이 정도는 감당하지 못할 거라고 믿기 힘든데.」
			DATAFORM 「이 요청이 네가 잊어버릴 만큼 하찮았니?」
			DATAFORM 「음... 마리사가 하루 종일 투덜거리는 걸 또 들어야겠지.」
			DATAFORM 「아마 너를 낯선 곳으로 보낸 게 내 실수였을지도 모르겠다.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
