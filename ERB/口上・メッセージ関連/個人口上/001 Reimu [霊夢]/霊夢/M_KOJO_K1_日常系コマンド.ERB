@M_KOJO_MESSAGE_COM_K1_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人 && RAND:4 ;custom code
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 
				PRINTFORMW 「――Oh, thanks, %CALLNAME:MASTER%.」
				PRINTFORMDW Reimu takes the cup in her hands and starts sipping the tea.
				PRINTFORMW 「...It's delicious. You've really improved recently.」
				SIF !CFLAG:1:1092
				PRINTFORMDW "Well, I've been making a lot of tea recently after all", you answer.
				PRINTFORMW 「...Sip, sip, I'm glad you're my lover, %CALLNAME:MASTER%.」
				IF !CFLAG:1:1092
					PRINTFORMDW "You only love me because of my tea, that's cold!", you say with a sad tone.
					PRINTFORMW 「That's not what I meant...」
					PRINTFORMDW Reimu could only give you an apologetic smile.
				ENDIF
			CASE 1
				PRINTFORMW 
				PRINTFORMW 「Nmm, thanks.」
				PRINTFORMDW Reimu sips the tea with a smile.
				PRINTFORMW 「Mmm, delicious.」
				SIF !CFLAG:1:1092
				PRINTFORMDW "I'm glad you like it", you grin.
				PRINTFORMDW Reimu sighs contentedly from the warmth of the drink.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 
				PRINTFORMW 「――Ah, did you make it for me? Thank you.」
				PRINTFORMDW Reimu expresses her gratitude as she accepts the cup you handed to her.
				PRINTFORMW 「...Mmm, delicious. I feel warmed from the inside.」
				PRINTFORMDW Seems like she's extremely satisfied by the tea you made.
			CASE 1
				PRINTFORMW 
				PRINTFORMW 「――Hmm? Oh, is that tea? Thank you.」
				PRINTFORMDW Reimu sips the tea with a smile.
				PRINTFORMW 「Nnng, sho hoth!」
				PRINTFORMDW Because of the heat, she couldn't help but lisp for some time.
				PRINTFORMDW ...So cute.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 
				PRINTFORMW 「――Oh? You made it for me?」
				PRINTFORMW 「T-thank you.」
				PRINTFORMDW Reimu thanks you with a faint blush.
				PRINTFORMW 「...My, it's delicious.」
				PRINTFORMDW She comments in a surprised tone.
			CASE 1
				PRINTFORMW 
				PRINTFORMW 「――Hmm? ...Oh, tea?」
				PRINTFORMW 「...You made it for me? ...T-thank you.」
				PRINTFORMDW Reimu accepts the cup and takes a sip of the tea.
				PRINTFORMW 「...Mmm, it's really delicious.」
				PRINTFORMDW She lets out a long, satisfied sigh.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 
				PRINTFORMW 「――Huh...? Oh, it's tea?」
				PRINTFORMW 「That's unusual of you. Can I have some?」
				SIF !CFLAG:1:1092
				PRINTFORMDW "I've made some extra, so you could have some", you respond.
				PRINTFORMW 「I see, then I'll be helping myself.」
				PRINTFORMDW Reimu sips the tea expressionlessly.
			CASE 1
				PRINTFORMW 
				PRINTFORMW 「――Huh... Tea?」
				PRINTFORMW 「I hope you didn't put anything weird in it, right?」
				PRINTFORMDW Without denying the accusation, you simply take a sip of the tea in response.
				PRINTFORMDW Reimu eyes you cautiously as she puts the tea to her mouth tentatively.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
