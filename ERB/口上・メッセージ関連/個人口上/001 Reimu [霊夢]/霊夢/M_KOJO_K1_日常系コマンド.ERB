;626,土産屋 gift shop custom code added
;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================

@M_KOJO_MESSAGE_COM_K1_626
CALL M_KOJO_MESSAGE_COM_K1_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:194 >= 1
		PRINTFORMW 「이거 저를 위한 건가요?... 고마워요, 저는 %SPLIT_G("gratefully accept it:happily take it:take it graciously")%할게요.」
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:1:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 装飾
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
		IF GROUPMATCH(TFLAG:194, 2, 3)
			IF STRFIND(RESULTS:1, "装飾") >= 0
				PRINTFORML 「사실 이런 걸 잘 안 하긴 했는데, 생각해보니 말이야...」
				PRINTFORMW 「음, 어떻게 생각해? 나한테 어울려?」
			ELSEIF strReaction == "身につける"
				IF RAND:2
					PRINTFORML 「그걸 나한테 입히고 싶다고? 후후, 고마워.」
					PRINTFORMDW 레이무는 받은 옷을 소중하게 들고 행복해 보인다.
				ELSE
					PRINTFORML 「가끔 외출할 때 갈아입을 옷이 좀 필요하겠네.」
					PRINTFORMW 「다시 한번 고마워, 꼭 간직할게.」
				ENDIF
			ENDIF
		ELSE
			SELECTCASE TFLAG:194
				CASE 1
				CASE 2
					PRINTFORMW 「이런 거 항상 갖고 싶었어!」
				CASE 3
					PRINTFORMW 「정말 예쁘네요... 다시 한번 고마워요, 잘 간직할게요.」
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF
