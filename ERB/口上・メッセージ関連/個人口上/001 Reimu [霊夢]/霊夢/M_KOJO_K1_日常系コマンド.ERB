;626,土産屋 gift shop custom code added
;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================
@M_KOJO_MESSAGE_COM_K1_626
CALL M_KOJO_MESSAGE_COM_K1_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:194 >= 1
		PRINTFORMW 「Is this for me? ...Thank you, I'll %SPLIT_G("gratefully accept it:happily take it:take it graciously")%.」
		
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:1:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 装飾
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
		
		IF GROUPMATCH(TFLAG:194, 2, 3)
			IF STRFIND(RESULTS:1, "装飾") >= 0
				PRINTFORML 「I never really put these things on, now that I think about it...」
				PRINTFORMW 「Well, what do you think? Does it look good on me?」
			ELSEIF strReaction == "身につける"
				IF RAND:2
					PRINTFORML 「So you want me to wear it? Fufu, thank you.」
					PRINTFORMDW Reimu looks happy, holding the clothes she received with great care.
				ELSE
					PRINTFORML 「I could use some change of clothes when going out once in a while.」
					PRINTFORMW 「Thanks again, I'll definitely keep it.」
				ENDIF
			ENDIF
		ELSE
			SELECTCASE TFLAG:194
				CASE 1
				CASE 2
					PRINTFORMW 「I've always wanted one of these!」
				CASE 3
					PRINTFORMW 「It's so pretty... Thanks again, I'll take good care of it.」
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF

