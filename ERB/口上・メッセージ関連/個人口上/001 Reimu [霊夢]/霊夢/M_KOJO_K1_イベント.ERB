@M_KOJO_EVENT_K1_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		IF TALENT:恋人
			PRINTFORML 
			PRINTFORML 「――Oh, %CALLNAME:MASTER%.」
			PRINTFORMDL 레이무가 당신을 발견하고 당신에게 말을 건다.
			PRINTFORML 「후후, 오늘은 뭘 할까?」
			PRINTFORMDW 그녀는 당신에게 파고든다.
		ELSEIF TALENT:恋慕
			PRINTFORML 
			PRINTFORML 「――Ah, %CALLNAME:MASTER%.」
			PRINTFORMDL 레이무가 당신을 알아본다.
			PRINTFORML 「환, 환영해. 차라도 마실래?」
			PRINTFORMDW 레이무는 불안하게 묻는다.
		ELSEIF TALENT:思慕
			PRINTFORML 
			PRINTFORML 「...아, %CALLNAME:MASTER%아니신가요?」
			PRINTFORMDL 레이무는 방에 들어오며 당신을 알아본다.
			PRINTFORML 「...요즘 계속... 이 기분은 뭐지?」
			PRINTFORMDW 레이무는 다가오면서 혼잣말을 중얼거린다.
		ELSE
			PRINTFORML 
			PRINTFORML 「...Oh, %CALLNAME:MASTER%.」
			PRINTFORMDL 레이무가 당신을 눈치챈 것 같다.
			PRINTFORML 「여기에 무슨 일로 왔니?」
			PRINTFORMDW 레이무는 무심하게 묻는다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORML 「후후, 들어갈게, %CALLNAME:MASTER%님.」
			PRINTFORMDW 레이무가 미소를 지으며 방에 들어온다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「저-저 들어갈게요, %CALLNAME:MASTER%.」
			PRINTFORMDW 레이무가 불안하게 몸을 뒤척이며 방에 들어간다.
		ELSEIF TALENT:思慕
			PRINTFORML 「%CALLNAME:MASTER%, 들어간다.」
			PRINTFORMDL 레이무가 방에 들어서며 말한다.
			PRINTFORML 「...뭐라고?」
			PRINTFORMDW 당신의 시선과 마주치자 레이무는 얼굴을 붉히고 시선을 피했다.
		ELSE
			PRINTFORML 「들어간다.」
			PRINTFORMDW 레이무가 방에 들어서며 퉁명스럽게 말했다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORML 「――아, %CALLNAME:MASTER%. 벌써 안에 계셨어요?」
			PRINTFORMDL 레이무가 문을 열고 욕실 안으로 들어갔다.
			PRINTFORML 「저도 여기 들어가게 해줘.」
			PRINTFORML 「당신 옆에 앉아도 괜찮죠?」
			PRINTFORMDW 레이무는 당신의 시선을 받으며 일부러 가슴을 서로 붙여 몸매를 드러냈다...
		ELSE
			PRINTFORML 「――Oh, %CALLNAME:MASTER%.」
			PRINTFORML 「벌써 안에 있네?」
			PRINTFORML 「나도 들어가게 해줘.」
			PRINTFORMDW 레이무가 당신 맞은편 욕실로 들어온다...
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「――――――」
		PRINTFORMDW 그녀가 당신을 보았는지 아닌지 알 수 없어, 당신은 레이무가 목욕탕에서 나오는 것을 지켜본다.
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「――――――」
		PRINTFORMDL 레이무는 네가 목욕탕에 들어오는 것을 보고 얼어버린다.
		PRINTFORML 「――――――!!」
		PRINTFORMDW 그리고 그렇게, 레이무가 당신을 욕실에서 쫓아낸다.
		RETURN 0
	ENDIF
ENDIF
RETURN 0
