@M_KOJO_SPEVENT_K1_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:恋人
			PRINTW
			PRINTFORML 「정말 즐거운 하루였어.」
			PRINTFORML 「다음에 또 가자, 알았지?」
			PRINTFORML 「후후, 다음에 어디로 갈까?」
			IF !CFLAG:1:1092
				PRINTFORMDL "어디로 가고 싶든, 레이무"라고 당신이 대답한다., you answer.
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 나와 함께라면 어디든 괜찮아.」
				PRINTFORMDW 레이무는 행복하게 응답한다.
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTW
			PRINTFORML 「오늘 정말 즐거운 하루였다.」
			PRINTFORML 「음... 다음엔...」
			PRINTFORMDL \@ CFLAG:1:1092 ? 고개를 끄덕인다 # "응, 물론이지"라고 대답한다 \@.
			PRINTFORML 「정말? 그럼 기대하고 있을게.」
			PRINTFORMDW 레이무가 미소 지으며 말한다.
		ELSEIF TALENT:思慕
			PRINTW
			PRINTFORML 「오늘은... 뭐, 꽤 즐거워.」
			PRINTFORML 「기분이 들 때, 다음엔 나를 초대해도 돼.」
			SIF !CFLAG:1:1092
				PRINTFORMDL "언제인데?"라고 당신이 묻는다., you ask.
			PRINTFORML 「...아마 곧 다시 그럴 기분이 들지도 모르겠어.」
			PRINTFORMDL 레이무가 부드럽게 중얼거렸다.
			PRINTW
		ELSE
			PRINTW
			PRINTFORML 「하아... 피곤하다.」
			PRINTFORML 「신사에서 쉬는 게 역시 최고다~」
			IF !CFLAG:1:1092
				PRINTFORMDL "가끔 밖에 나가는 게 그렇게 나쁜 건 아니야", 당신이 말한다.
				PRINTFORML 「원하면 혼자 나가겠어.」
				PRINTFORMDW 레이무가 대답한다.
			ENDIF
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕 ;custom code
			PRINTFORML 「――하아, 좋아.」
			PRINTFORML 「알았어, 용서해 줄게.」
			PRINTFORML 「하지만 만약 나쁜 짓을 하면 다시 화낼 거야, 알겠지?」
			PRINTFORMDW 레이무는 미소가 뺨에 떠오르며 말한다.
			RETURN 0
		ELSE
			PRINTFORML 「――하아, 어쩔 수 없겠지.」
			PRINTFORML 「좋아, 용서해 줄게.」
			PRINTFORML 「지금으로선 믿을 만한 것 같네.」
			PRINTFORMDL 레이무의 표정이 부드러워진다.
			PRINTW
			RETURN 0
		ENDIF
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕 ;custom code
			PRINTFORML 「...좋아, 조금은 용서해 줄게.」
			PRINTFORML 「이해했지? 하지만 *조금*만 말이야, 알았어?」
			PRINTFORML 「난 아직 너를 완전히 용서한 건 아니야, 알겠지?」
			PRINTFORMDW 그녀가 말을 할 때 얼굴에는 여전히 약간의 긴장감이 보였다.
			RETURN 0
		ELSE
			PRINTFORML 「...너를 용서해 줄게, 아주 조금만.」
			PRINTFORML 「하지만 만약 네가 다시 선을 넘는다면, 무슨 일이 일어날지 알고 있겠지?」
			PRINTFORMDL 레이무가 딱딱한 표정으로 말했다.
			PRINTW
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕 ;custom code
			PRINTFORML 「너무 빈둥거리면 너를 전멸시킬 테니, 알겠어?」
			PRINTFORML 「...하지만, 조금은 용서해 줄게.」
			PRINTFORML 「감사해야 해.」
			PRINTFORMDW 레이무가 당신을 향해 말을 건네는데, 그녀의 표정은 여전히 긴장되어 있었다.
			RETURN 0
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 딱 한 번만 내 말을 들어줘,」
			PRINTFORML 「나를 아직도 과소평가한다면, 정말 그만둬야 해.」
			PRINTFORML 「잠깐 동안은 용서해 줄게.」
			PRINTFORML 「앞으로 네 행동은 전적으로 너에게 달렸어, %CALLNAME:MASTER%.」
			PRINTW
		ENDIF
		RETURN 0
	ENDIF
	PRINTFORML
ENDIF
RETURN 0
