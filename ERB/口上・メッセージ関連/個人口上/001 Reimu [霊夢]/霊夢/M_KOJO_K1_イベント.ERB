@M_KOJO_EVENT_K1_12(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;寝床に侵入
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORML
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF TALENT:恋人
			PRINTFORMW 「...응, 아...」
			PRINTFORMDL 레이무는 졸린 눈으로 당신을 바라본다.
			PRINTFORML 「...어머, 뭐야, 당신뿐이구나, %CALLNAME:MASTER%...」
			PRINTFORMDW 레이무는 침입자가 당신임을 깨닫고 안도하는 표정을 짓는다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...음냐?」
			PRINTFORMDL 레이무는 매우 졸려 보인다.
			PRINTFORML 「...뭐 필요한 거 있어...?」
			SIF !CFLAG:1:1092
				PRINTFORMDW "별로"라고 말한다. 레이무가 더 이상 눈을 뜨고 있을 수 없어 눈을 감자., you say as Reimu closes her eyes, unable to keep them open anymore.
		ELSE
			PRINTFORMW 「음... 여기 좀 졸리네...」
			PRINTFORML 「...이상한 짓 하면... 알잖아...」
			SIF !CFLAG:1:1092
				PRINTFORMDW "...일어날 거야, 맞지?"
			PRINTFORMDW 레이무는 너무 졸려 문장도 끝내지 못하는 것 같았다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		IF TALENT:恋人
			PRINTFORML 「...Zzz...」
			PRINTFORMDL 레이무는 잠결에 고르게 숨을 쉬었다.
			PRINTFORMDL 당신이 그녀의 뺨을 부드럽게 찌르자, 그녀가 눈을 떴다.
			PRINTFORML 「아... 그만해줘... 피곤해...」
			SIF !CFLAG:1:1092
				PRINTFORMDL 안 좋은 타이밍에 온 것 같군.
			PRINTFORMDW 당신은 레이무에게서 멀어진다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「...%CALLNAME:MASTER%...」
			PRINTFORMDL 레이무는 여전히 베개에 얼굴을 파묻은 채 당신을 올려다본다.
			PRINTFORML 「...잘 자...」
			IF !CFLAG:1:1092
				PRINTFORMDL 그녀는 즉시 잠이 들었다.
				PRINTFORMDL 정말 피곤한 것 같다.
			ENDIF
			WAIT
		ELSE
			PRINTFORML 「...Zzz...Zzz...」
			PRINTFORMDL 레이무는 당신에게 전혀 반응하지 않는다.
			IF !CFLAG:1:1092
				PRINTFORMDL "이제 뭘 해야 할까?"
				PRINTFORMDL 당신은 미소를 지으며 생각한다.
			ENDIF
			WAIT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;追い出される
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		;added
		PRINTFORML 「...하아, %CALLNAME:MASTER%...」
		PRINTFORML 「허락 없이 내 방에 들어오지 말아줘, 알겠지?」
		PRINTFORMW 「진심이야. 지금 당장 나가, 나가!」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;追い出される（衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		PRINTFORML
		RETURN 0
	ENDIF
	;その他
	PRINTFORML 
ENDIF
RETURN 0
