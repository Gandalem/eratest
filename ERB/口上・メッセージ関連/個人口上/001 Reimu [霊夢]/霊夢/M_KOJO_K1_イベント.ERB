	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORML 「――헤이, %CALLNAME:MASTER%.」
			PRINTFORMDL 레이무가 갑자기 당신을 부르고 당신은 그녀를 향해 돌아본다.
			PRINTFORMDL 눈 깜짝할 사이에 그녀는 당신을 밀어붙인다.
