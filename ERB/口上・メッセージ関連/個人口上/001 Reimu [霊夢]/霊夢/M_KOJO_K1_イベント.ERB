			PRINTFORMW 「그냥, 아무도 볼 수 없는 곳에서 해, 알았지?」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;二人とも説教
	;記入チェック（=0, 非表示、1, 表示）
