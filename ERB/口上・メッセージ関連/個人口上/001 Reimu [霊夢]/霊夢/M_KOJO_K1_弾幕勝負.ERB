; Modular ERB: 個人口上/001 Reimu [霊夢]/霊夢/M_KOJO_K1_弾幕勝負.ERB
;added, original content + some lines from J
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K1_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		IF MARK:反発刻印 || CFLAG:ブチギレ
			PRINTFORML 「혹시 네 무덤을 스스로 파고 있는 건가?」
			PRINTFORML 「이런 기분일 때 나에게 도전하다니...」
			PRINTFORML 「내가 경고하지 않은 게 아니라고 말하지 마.」
			PRINTFORMDL 레이무가 진지해진다!
			HANDICAP_FIXED += 300
			HANDICAP_RAND += 100 * ABL:戦闘能力
		ELSEIF CFLAG:弾幕勝負勝利
			PRINTFORML 「흠... 하지만 이미 한 번 나를 이겼지.」
			PRINTFORMDL 레이무가 씁쓸하게 미소 지으며 말한다.
			PRINTDATAL
				DATAFORM 「이것이 당신에게 복수할 수 있는 한 방법이라고 생각해요.」
				DATAFORM 「후후... 당신을 이길 기회를 가지려면 당신의 습관을 더 잘 알아야겠어요!」
				DATAFORM 「하지만 그렇게 생각하지 마세요... 예전처럼 쉽게 저를 쓰러뜨릴 수는 없을 테니까!」
				DATAFORM 「어쩌면 첫 번째 때는 그저 운이 좋았던 것일지도 모르죠... 확인해 봅시다!」
			ENDDATA
			HANDICAP_RAND += 100 * ABL:戦闘能力
		ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
			PRINTFORML 「뭐야, 요즘 네 능력을 자신 있게 느끼고 있는 건가?」
			PRINTFORML 「미안하지만, 너는 태양에 너무 가까이 날고 있다고 생각해.」
			PRINTFORML 「걱정 마, 곧 네가 있어야 할 곳으로 내가 끌어내 줄게. 시작하자!」
			PRINTDATAL
				DATAFORM 「아, 한 가지 더. 그렇게 쉽게 포기하지 않겠다고 약속해 줘.」
				DATAFORM 「나를 이길 수 있다면, 다음 "인과쿄 최고의 단마쿠 파이터"가 될 길로 가는 거야!」
				DATAFORM 「야, 그럴 겸 우리 같이 새로운 주문 카드라도 만들까?」
			ENDDATA
			PRINTFORMDL 레이무는 이 기술들을 완벽하게 숙련할 시간이 있었다... 당신은 이를 악물고 최악에 대비한다!
		ELSE
			IF ABL:MASTER:戦闘能力 < 2
				IF FIRSTTIME("DanmakuWeak")
					PRINTFORML 「오, %CALLNAME:MASTER%... 아직 날지 못하는 거야? 바로 그 이유 때문에 인간에게 도전장을 내미는 건 규칙으로 금지하고 있거든...」
					PRINTFORML 「뭐, 걱정 마! 내 단마쿠를 피할 수만 있다면 괜찮을 테니까! 좋아, 그럼 시작해 볼까!」
				ELSE
					PRINTDATAL
						DATAFORM 「스펠 카드에 대해서 말이야... 에, 하나도 없다고?」
						DATAFORM 「이것보다 더 강해져야 해. 시작하자!」
						DATAFORM 「너만의 스펠 카드가 한두 개는 필요하다고 생각해. 내가 언젠가 만드는 걸 도와줄게.」
					ENDDATA
				ENDIF
			ELSE
				PRINTDATAL
					DATAFORM 「정말, 좋은 판단이군... 네가 뭘 할 수 있는지 보자!」
					DATAFORM 「나 간다! 나를 따라올 수 있겠어?」
					DATAFORM 「준비할 시간이 잠시 필요해... 좋아, 다 준비됐어, 가자!」
					DATAFORM 「덤벼라, 나한테 와봐. 스스로 상처 입지 않도록 조심해.」
					DATAFORM 「운동 좀 할 필요가 있겠군... 어쩌면 네가 나를 즐겁게 해줄지도 모르지?」
					DATAFORM 「너에게 봐주진 않을 거지만... 부디 조심하길 기억해줘, 알았지?」
				ENDDATA
			ENDIF
		ENDIF
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		IF MARK:反発刻印 || CFLAG:ブチギレ
			SELECTCASE 相手残機
				CASE 2
					PRINTFORML 「이건 오래가지 못할 거야. 이미 마지막 발악 중이라는 게 확실해.」
					PRINTFORML 「반면에 나는 아직 이 상황에 대해 침착함을 유지할 여지가 많아.」
					PRINTFORML 「지금 포기하면, 그냥 몇 개의 멍만 얻고 빠져나갈 수 있을 거라고, 알잖아?」
				CASE 1
					PRINTFORML 「하아... 이렇게 하게 되어서 싫지만, 네가 나를 몰아붙이고 있어.」
					PRINTFORML 「"드림랜드 '그레이트 듀플렉스 배리어'!"」
					PRINTFORML 「그리고... 신성한 도움을 조금 빌린다... 여기.」
					PRINTFORML 「간다, 마지막 저항이야!」
					PRINTFORMDL 잠시 동안, 너는 레이무의 눈이 붉게 번쩍이는 것을 본 것만 같았다...
					HANDICAP_FIXED += 1000
				CASE 0
					PRINTFORML 「윽... 믿을 수가 없군... 어떻게든 치트라도 썼겠지...」
					PRINTFORML 「능력도 없는 평범한 인간이 나 상대로 이렇게 잘할 리가 없어?」
					PRINTFORML 「아니면... 처음부터 능력을 갖고 있었던 건가?」
					PRINTFORMDL 당신은 목을 가다듬는다.
			ENDSELECT
			RETURN 1
		ENDIF
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
			CASE 2
				SELECTCASE RAND:6 ;custom code
					CASE 0
						PRINTFORML 「%CAPITALIZE(FSYN("ow"))%! ...적어도 실력은 향상된 것 같군.」
					CASE 1
						PRINTFORML 「후후, 실력이 좀 있는 것 같네!」
						PRINTFORML 「얼마나 버틸 수 있는지 보자고!」
					CASE 2
						PRINTFORML 「그냥 또 하나의 우연일 뿐이잖아, 그렇지 않아?」
						PRINTFORML 「당신의 경이로운 행운은 나의 그것을 능가하는 것 같군요. 곧 이 점에 대해 말씀드리겠습니다!」
					CASE 3 ;custom code
						PRINTFORML 「으윽... 이제 끝이군!」
						PRINTFORML 「우리 능력의 거대한 격차를 보여주지!」
					CASE 4 ;custom code
						PRINTFORML 「전 네가 나와 정면으로 맞설 거라고는 전혀 예상 못 했기에 방금 놀랐지.」
						PRINTFORML 「이제 난 준비됐어.」
					CASE 5 ;custom code
						PRINTFORML 「보아하니... 처음부터 너를 진지하게 받아들이지 않은 게 내 잘못이다.」
						PRINTFORML 「수위를 좀 높여볼까? 내 경계의 간극 속으로 떨어져 봐!」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「진짜 싸움 한판 할 준비가 됐나?」
						PRINTFORML 「내가 보여주지...」
					CASE 1
						PRINTFORML 「이제 내가 보여주지...」
						PRINTFORML 「My true boundary.」
					CASE 2
						PRINTFORML 「...나 화가 나고 있어. 그리고 말해주지, 날 화나게 하는 건 네가 저지른 가장 큰 실수야.」
						PRINTFORML 「오늘 분명 너에게 약간의 교훈을 가르쳐야 할 것 같아.」
				ENDSELECT
			CASE 0
				PRINTFORMDL %BREAKENG(@"레이무는 숨 쉴 틈 없이 엄청난 양의 탄환과 단막으로 당신을 억누르며 빈틈을 주지 않는다.")%
				PRINTFORMDL 당신은 다른 접근 방식을 시도하기로 한다.
				PRINTFORMDL 당신은 집중하여 레이무의 몸에 있는 약점들을 목표로 단마쿠를 난사한다.
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「너를 이기겠어! 내 난사에서 벗어날 수는 없어!」
			CASE 1
				PRINTFORML 「내 필살기 좀 잘 봐라!」
				PRINTFORML 「정령 사인 "판타지 봉인"!!!」
			CASE 2
				PRINTFORML 「이제 스펠 카드도 좀 섞을 테니 준비해라!」
			CASE 3
				PRINTFORMDL 당신은 레이무에게 좀 봐주고 단막(Danmaku)을 그렇게 많이 쏘지 말라고 애원한다.
				PRINTFORML 「왜? 이거 재밌잖아!」
				PRINTFORMDL 레이무는 계속 발사하고, 당신은 문제가 생긴 것 같다고 느낀다.
			CASE 4
				PRINTFORML 「무슨 일이야, %CALLNAME:MASTER%? 저걸 피하지 않으면 오래 못 갈 거야!」
				PRINTFORMDL "그-그건... 불공평해! 내가 방어할 수 없을 때 공격하지 마!"
				PRINTFORML 「이런, 미안. 좀 더 일찍 경고했어야 했는데...」
				PRINTFORMDL 레이무가 희미하게 웃었다.
				PRINTFORML 「다시 해볼까?」
				PRINTFORMDL 그녀는 그렇게 말하며 다시 공격을 퍼부었다!
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF 相手残機 > 0 && !CFLAG:弾幕勝負勝利 && FIRSTTIME("DanmakuDefeat")
			PRINTFORML 「그게 다야, 끝났어.」
			PRINTFORMDL 레이무는 공격을 멈추고 땅에 주저앉은 너에게 다가갔다.
			PRINTFORML 「일어나 볼 수 있겠니? 좋아...」
			PRINTFORML 「인간 세상 최고인 근원에서 패배의 맛을 느끼다니... 어쩌면 이것이 어떤 일들을 움직여 결국 네 몸을 훨씬 강하게 만들어 줄지도 모르지?」
			PRINTFORML 「어쨌든 기대하고 있을게.」
			PRINTFORML 「더 훈련하고 싶으면 언제든지 나에게 물어봐도 돼. 하지만 명심해, 난 결코 힘을 아끼지 않아.」
			RETURN 1
		ENDIF
		IF (MARK:反発刻印 || CFLAG:ブチギレ)
			IF 相手残機 > 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDL 레이무가 당신 주위를 빙글빙글 돌며 얼굴에 짜증을 가득 드러냈다.
						PRINTFORML 「흥... 재미없네.」
					CASE 1
						PRINTFORMDL 레이무에게 완전히 패배한다...
						PRINTFORML 「아아~... 예상했던 것보다 훨씬 약하네... 알고 있었어!」
						PRINTFORML 「패배자들과 시간 낭비하는 건 싫다. 좀 더 강해져서 다시 와라.」
						PRINTFORML 「아니, 취소. *훨씬* 더 강해져야 한다. 그래야 그때 또 놀 수 있으니까.」
					CASE 2
						PRINTFORML 「알다시피, 나는 적이 아닌 사람을 전멸시키는 것을 선호하지 않는다.」
						PRINTFORML 「하지만 네가 곧 예의를 배우지 않는다면, 마음을 바꿔야 할지도 모른다.」
				ENDSELECT
				PRINTFORMDL 레이무는 코웃음을 치며 어딘가로 날아간다...
				CALL GETOUT(TARGET)
			ELSE
				PRINTFORML 「...크윽.」
				PRINTFORMDL 레이무는 아픈 엉덩이를 문지르며 당신을 노려본다.
				PRINTFORML 「...지금 스스로에게 정말 자부심이 가득하겠구나.」
				PRINTFORML 「좋아, 그렇다면. 내가 패배한 게 이번이 처음은 아니야.」
				PRINTFORML 「하지만 하나 말해두지. 나보다 훨씬 더 무서운 사람들이 세상에는 있어.」
				PRINTFORMW 「그들과 원수 지지 않도록 조심해. 그렇지 않으면 오늘 네가 나에게 한 일의 대가를 치르게 될지도 몰라.」
			ENDIF
			RETURN 1
		ENDIF
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTDATAL
					DATAFORM 「너는 충분히 강하지 않아! 네 싸움을 고를 줄 배워야 해, %CALLNAME:MASTER%!」
					DATAFORM 「...뭐, 단막에 점점 능숙해지는 것 같네. 그래도 초보자가 지는 건 당연한 일이야.」
					DATAFORM 「\@ RAND:2 ? 몸이 안 좋아? # 너 무슨 일 있어?\@ 이대로 가다간 네 스스로 다치게 될 거야.」
					DATAFORM 「인간들은 너무 눈에 보이는 것에 의존하곤 하지...\n　단막의 감을 익혀야 해, 그러면 눈을 감고도 회피할 수 있게 될 테니까.」
					DATAFORM 「여전히 약하네... 뭐, 이번 게 좋은 교훈이 됐으면 좋겠어.」
				ENDDATA
			CASE 2
				PRINTDATAL
					DATAFORM 「그들을 피하기 위해 그렇게 크게 방향을 틀 필요는 없어. 조금씩 회피해!」
					DATAFORM 「총알의 양에 속지 마!」
					DATAFORM 「한 번에 너무 많은 단마쿠를 발사하지 마! 스스로 너무 예측 가능하게 만들고 있어!」
					DATAFORM 「비켜야 할 만큼 가까이 붙었다가, 조금씩 피하는 게 요령이야.」
					DATAFORM 「그레이징을 마스터하면, 너는 막을 수 없는 존재가 될 거야.」
					DATAFORM 「모든 것을 한 번에 피하려 하는 것이 공격받게 만드는 거지... 그리고 그게 네가 여전히 약한 이유야.」
				ENDDATA
				PRINTFORMDL 레이무가 조언을 해주지만, 당신은 여전히 그녀에 대해 일종의 우월감을 떨쳐버릴 수 없다...
			CASE 1
				PRINTFORML 「됐다! 이미 정해진 결말이야! 다시는 신사 여신을 건드리지 마!」
				PRINTFORML (후우... 좀 아슬아웠어.)
				PRINTFORMDL 이유도 모르게 레이무가 많이 당황한 것 같다...
			CASE 0
				PRINTFORML 「%SPLIT_G("아아아아악:우와아앙:꺄아아악")%?!」
				PRINTFORMDL 레이무가 부자연스러운 비명을 지르며 땅으로 추락한다.
				PRINTFORMDL "안녕, 레이무."
				PRINTFORMDL "네 영혼이 편히 쉬기를 기도할게."
				PRINTFORML 「그렇게 나를 죽이지 마!」
				IF !CFLAG:弾幕勝負勝利 ;after first win
					WAIT
					PRINTFORML 「우으윽... 단마쿠에서 패배를 맛본 지 오랜만이다.」
					PRINTFORML 「너는 나에게 수없이 맞서 왔으니, 한 번은 내가 이기는 것이 당연하다고 생각하겠지.」
					PRINTFORML 「나는 이것을 분명히 명심하고 재대결을 위해 더욱 열심히 훈련할 것이다.」
					PRINTFORML 「하지만 이걸 마음에 두지는 마라. 방심하게 되면 그 오만함이 너를 무너뜨릴 테니.」
				ENDIF
		ENDSELECT
		IF TALENT:恋慕 && !(MARK:反発刻印 || CFLAG:ブチギレ)
			PRINTFORMDL 게임을 끝내고 레이무에게 볼에 키스를 해주며 보상하기로 한다.
			PRINTFORMDL "재미있게 해줘서 고마워, 레이무."
			PRINTFORMDL 그녀는 어리둥절하게 당신을 바라보다가 이내 당신을 꼭 껴안는다.
			PRINTFORML 「천만에.」
			PRINTFORML 「\@ 相手残機 == 0 ? 이걸로 좀 기분이 나아진 것 같네... 하지만 다음엔 지지 않을 거야! # 개인적으로 받아들이지는 마. 분명 더 성장할 여지가 많을 테니까. \@」
			PRINTFORMDL \@ 相手残機 == 0 ? 당신이 그녀를 품에 안고 머리를 쓰다듬자 레이무는 얼굴을 붉힌다 # 그녀가 말하기엔 쉽다는 건, 당신은 그렇게 생각한다 \@...
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
