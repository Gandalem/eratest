;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K1
SIF TFLAG:反発刻印取得 ;don't show in case of hate mark
	RETURN 1
RETURN 0

@M_KOJO_MESSAGE_MARKCNG_K1
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい

;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORML 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORML 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORML 
ENDIF

IF !FLAG:時間停止
	;苦痛刻印
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORML 
		PRINTFORMW 「O-ouch... That's not very nice you know...」
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORML 
		PRINTFORMW 「O-ouchhh...?! It huuuurts...」
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORML 
		PRINTFORMW 「Urghhhh, o-oww... P-please, no more...」
	ENDIF

	;快楽刻印
	IF TFLAG:23 == 1
		PRINTFORML 
		PRINTFORMW 「...It feels good...... Nn... W-what did I just...?」
	ELSEIF TFLAG:23 == 2
		PRINTFORML 
		PRINTFORMW 「...It feels good... It feels soooo goooood...」
	ELSEIF TFLAG:23 == 3
		PRINTFORML 
		PRINTFORMW 「...I c-can't... I can't forget that kind of pleasure anymore... I've already drowned it in, for so long, huh...?」
	ENDIF
	
	;不埒刻印
	;快楽による刻印
	;LV1
	IF TFLAG:24 == 11
		PRINTFORML 
		PRINTFORMW 「Ahhhnnn... S-stop it! S-stop saying that noise was cute...」
	;LV2
	ELSEIF TFLAG:24 == 12
		PRINTFORML 
		PRINTFORMW 「Haaa, aaaah! ...Ehh? W-why did you stop...?」
	;LV3
	ELSEIF TFLAG:24 == 13
		PRINTFORML 
		PRINTFORMW 「Aaaahhh, haaa, d-don't stop, more, more, give me mooooooore...」
	;屈服、恭順による刻印
	;LV1
	ELSEIF TFLAG:24 == 31
		PRINTFORML 
		PRINTFORMW 「...%CALLNAME:MASTER%... U-umm, can we d-do that again...?」
	;LV2
	ELSEIF TFLAG:24 == 32
		PRINTFORML 
		PRINTFORMW 「...There? %CALLNAME:MASTER%... Did you like that?」
	;LV3
	ELSEIF TFLAG:24 == 33
		PRINTFORML 
		PRINTFORMW 「Haaa... %CALLNAME:MASTER%, %CALLNAME:MASTER%...」
	ENDIF
	
	;反発刻印
	IF TFLAG:反発刻印取得 == 1
		PRINTFORML 
		PRINTFORMDW Reimu's expression turns blank, but she stares at you with cold distain in her eyes...
	ELSEIF TFLAG:反発刻印取得 == 2
		PRINTFORML 
		PRINTFORMDW Reimu glares at you sharply...
		PRINTFORMDW Seeing her expression so full of animosity, a bead of sweat rolls down your cheeks.
	ELSEIF TFLAG:反発刻印取得 == 3
		PRINTFORML 
		PRINTFORMDW ――For a brief moment
		PRINTFORMDW you feel the strongest wave of killing intent you've ever felt in your pathetic, worthless life emanating from Reimu.
		SIF !CFLAG:1:1092
		PRINTFORMDW She is way out of your league.
		PRINTFORMDW Just imagining the difference in your strength chills your heart to the core with fear.
		PRINTFORMDW A bead of cold sweat rolls down the side of your cheeks.
	ENDIF
ENDIF
