; Modular ERB: 個人口上/001 Reimu [霊夢]/霊夢/M_KOJO_K1_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K1
SIF TFLAG:反発刻印取得 ;don't show in case of hate mark
	RETURN 1
RETURN 0

@M_KOJO_MESSAGE_MARKCNG_K1
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORML 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORML 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORML 
ENDIF
IF !FLAG:時間停止
	;苦痛刻印
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORML 
		PRINTFORMW 「오우... 그거 별로 좋지 않잖아...」
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORML 
		PRINTFORMW 「오우욱...?! 아프다...」
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORML 
		PRINTFORMW 「우으윽, 흐윽... 제발, 더는...」
	ENDIF
	;快楽刻印
	IF TFLAG:23 == 1
		PRINTFORML 
		PRINTFORMW 「...기분이 좋다...... 응... 방금 내가 뭘 한 거지...?」
	ELSEIF TFLAG:23 == 2
		PRINTFORML 
		PRINTFORMW 「...기분이 좋아... 정말 너무 좋구나...」
	ELSEIF TFLAG:23 == 3
		PRINTFORML 
		PRINTFORMW 「...나는 안 돼... 그런 종류의 쾌락을 더는 잊을 수가 없어... 너무 오랫동안 그것에 잠겨 있었지, 응...?」
	ENDIF
	;不埒刻印
	;快楽による刻印
	;LV1
	IF TFLAG:24 == 11
		PRINTFORML 
		PRINTFORMW 「아아... 그만해! 그 소리가 귀엽다고 말하는 거... 그만해...」
		;LV2
	ELSEIF TFLAG:24 == 12
		PRINTFORML 
		PRINTFORMW 「하아, 아아앗!...응? 왜 멈춘 거야...?」
		;LV3
	ELSEIF TFLAG:24 == 13
		PRINTFORML 
		PRINTFORMW 「아아아아, 하아, 그만두지 마, 더, 더, 나한테 더 줘어어어...」
		;屈服、恭順による刻印
		;LV1
	ELSEIF TFLAG:24 == 31
		PRINTFORML 
		PRINTFORMW 「...%CALLNAME:MASTER%... 음... 다시 해볼 수 있을까요...?」
		;LV2
	ELSEIF TFLAG:24 == 32
		PRINTFORML 
		PRINTFORMW 「...거기에 있었어? %CALLNAME:MASTER%... 마음에 들었어?」
		;LV3
	ELSEIF TFLAG:24 == 33
		PRINTFORML 
		PRINTFORMW 「하아... %CALLNAME:MASTER%, %CALLNAME:MASTER%...」
	ENDIF
	;反発刻印
	IF TFLAG:反発刻印取得 == 1
		PRINTFORML 
		PRINTFORMDW 레이무의 표정은 공허해지지만, 그녀는 차가운 경멸을 담아 당신을 응시한다...
	ELSEIF TFLAG:反発刻印取得 == 2
		PRINTFORML 
		PRINTFORMDW 레이무가 당신을 날카롭게 노려본다...
		PRINTFORMDW 그녀의 표정이 너무 적대감으로 가득한 것을 보고, 당신의 뺨 위로 한 방울의 땀이 떨어진다.
	ELSEIF TFLAG:反発刻印取得 == 3
		PRINTFORML 
		PRINTFORMDW 잠시 동안은
		PRINTFORMDW 네 비참하고 하찮은 인생에서 느껴본 그 어떤 것보다 강렬한 살의가 레이무에게서 뿜어져 나오는 것을 느낀다.
		SIF !CFLAG:1:1092
			PRINTFORMDW 그녀는 당신의 수준을 훨씬 넘어섰다.
		PRINTFORMDW 당신의 힘의 차이를 상상하는 것만으로도 공포가 마음을 깊숙이 얼어붙게 만든다.
		PRINTFORMDW 식은땀 한 방울이 뺨을 타고 흘러내린다.
	ENDIF
ENDIF
