;セクハラ系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K1_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1_310
CALL M_KOJO_MESSAGE_COM_K1_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORML 
		PRINTFORMDW 너는 레이무의 엉덩이를 만진다.
		PRINTFORMDW 그것은 매끄럽고 형상이 잘 잡혀있다.
		PRINTFORMDW 면처럼 부드러운 그녀의 엉덩이 살은 네가 손을 떼면 매번 원래 모양으로 되돌아온다.
		PRINTFORMDW 너는 한동안 그녀의 엉덩이 감촉을 계속 즐긴다.
	ELSEIF CFLAG:睡眠
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 
					PRINTFORMW 「아... 하지 마...」
					PRINTFORMDW 당신이 그녀의 엉덩이를 만지자 레이무는 그 자리에 얼어붙었다.
					PRINTFORMW 「...%CALLNAME:MASTER%, 당신의 손은... 너무 음란해...」
					PRINTFORMDW 그녀는 후끈한 숨결 사이로 말했지만 저항하는 것 같지는 않았다.
				CASE 1
					PRINTFORMW 
					PRINTFORMW 「응... 으윽...」
					PRINTFORMDW 레이무의 뺨은 당황스러움을 참으려 애쓰면서 새빨갛게 변했다.
					PRINTFORMW 「...저기, %CALLNAME:MASTER%... 이런 건 옷을 벗고 나서 하면 되는 거야...」
					PRINTFORMDW 그녀는 항의했지만 즐기고 있는 것 같았다.
					PRINTFORMDW 그녀의 말을 무시하고 계속해서 그녀의 엉덩이를 만진다.
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 
					PRINTFORMW 「응... 안 돼...」
					PRINTFORMDW 레이무는 당신의 행동에 저항하지 않는다.
					PRINTFORMW 「싫어... 잠깐만... 그만둬야 해...」
					PRINTFORMDW 그렇게 말하고도 그녀는 당신의 손을 멈추지 않는다.
				CASE 1
					PRINTFORMW 
					PRINTFORMW 「응... 하지 마...」
					PRINTFORMDW 네 손에 엉덩이를 만져지자 레이무의 얼굴이 붉은빛으로 물든다.
					PRINTFORMW 「응... 내 옷을 구겨버릴 거야...」
					PRINTFORMDW 그녀는 힘없이 당신의 손을 막으려 한다.
			ENDSELECT
		ELSE
			PRINTFORML 
			PRINTFORMW 「...! ...윽...」
			PRINTFORMDW 그녀는 저항하지 못한 채 얼어붙으며 얼굴이 새빨개진다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K1_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1_311
CALL M_KOJO_MESSAGE_COM_K1_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDW 너는 레이무를 껴안는다.
		PRINTFORMDW 그녀는 시간에 고정되어 있어 반응하지 않는다.
		SIF !CFLAG:1:1092
			PRINTFORMDW "마치 인형처럼"이라고 스스로 생각한다., you think to yourself.
		;ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSE
		IF TALENT:恋人
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORMW 「Zzz...Zzz...」
				PRINTFORMDW 레이무는 잠을 자며 조용히 숨을 쉬었다...
				PRINTFORMW 「Nnng... Zzz...」
				PRINTFORMDW 그녀를 안으면, 얼굴에 평온한 표정이 떠졌다.
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「젠장, 갑자기 뭐 하는 거야...」
						PRINTFORMDW 당신은 레이무를 뒤에서 끌어안는다.
						PRINTFORMW 「응... 아아, 너로 뭘 하게 될지 모르겠네...」
						PRINTFORMDW 그녀는 한숨을 쉬며 당신에게 몸을 기댄다.
					CASE 1
						PRINTFORMW 
						PRINTFORMDW 당신은 레이무를 품에 안는다.
						PRINTFORMW 「응... 후후, 그렇게 세게 안지 않아도 됐는데...」
						PRINTFORMDW 그녀는 작은 미소를 지으며 불평한다.
						PRINTFORMW 「...후후, %CALLNAME:MASTER%!%UNICODE(0x2665)%」
						PRINTFORMDW 그 후, 그녀는 달콤한 목소리로 당신의 이름을 부르며 팔을 감싸 안고 포옹에 화답한다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:恋慕
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORML 「Zzz...Zzz...」
				PRINTFORMDW 레이무는 잠을 자면서 조용히 숨을 쉬었다...
				PRINTFORMW 「Nnng... Zzz...」
				PRINTFORMDW 당신이 레이무를 안으면, 그녀의 얼굴은 잠든 상태에서도 환해졌다.
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「...%CALLNAME:MASTER%...?」
						PRINTFORMDW 당신은 뒤에서 레이무를 껴안으며 눈을 감는다.
						PRINTFORMW 「...뭔가 잘못된 것 같아...?」
						IF !CFLAG:1:1092
							PRINTFORMDW 그녀가 조심스럽게 당신에게 묻는다.
							PRINTFORMDW "괜찮아. 나 좀 이렇게 있어도 돼", 당신이 부탁한다.
							PRINTFORMW 「...알았어...」
							PRINTFORMDW 그녀는 당신처럼 눈을 감고 긴장을 풀었다.
						ELSE
							PRINTFORMDW 그녀는 당신에게 조심스럽게 묻지만, 잠시 후 눈을 감고 긴장을 푼다.
						ENDIF
					CASE 1
						PRINTFORMW 
						PRINTFORMW 「...음, 얼마나 더 이렇게 할 거야?」
						PRINTFORMDW 당신은 레이무를 꽉 껴안으며 인질로 잡는다.
						SIF !CFLAG:1:1092
							PRINTFORMDW "만족할 때까지, 적어도 지금은"이라고 대답한다., you reply.
						PRINTFORMW 「...알았다.」
						PRINTFORMDW 운명을 반쯤 체념한 채, 그녀는 중얼거린다.
				ENDSELECT
				PRINTFORMW 
			ENDIF
		ELSE
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORMW 「Zzz...Zzz...」
				PRINTFORMDW 레이무는 잠을 자며 조용히 숨을 쉬었다..
				PRINTFORMW 「Nnng... Zzz...」
				PRINTFORMDW 당신이 그녀를 안으면, 부드러운 신음을 내뱉는다.
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「...잠깐, %CALLNAME:MASTER%?」
						PRINTFORMDW 당신이 그녀를 껴안자 레이무가 부른다.
						PRINTFORMW 「...나한테 매달리면서 잠들면 안 돼, 알았지?」
						PRINTFORMDW 눈을 감은 채로 당신은 조용히 고개를 끄덕인다.
						PRINTFORMW 「...진심으로, 잠들지 마...」
						PRINTFORMDW 그녀는 한숨을 내쉰다.
					CASE 1
						PRINTFORMW 
						PRINTFORMW 「...곧 그만둘 수 없어?」
						PRINTFORMDW 레이무가 목소리를 약간 높이며 항의한다.
						PRINTFORMDW 당신은 마지못해 그녀에게서 멀어진다.
						PRINTFORMW 「...하아...」
						PRINTFORMDW 그녀는 고개를 한쪽으로 기울이고 멍하니 위를 바라본다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K1_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1_312
CALL M_KOJO_MESSAGE_COM_K1_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDW 당신은 레이무의 입술에 키스를 한다.
		PRINTFORMDW 시간이 멈춰있더라도 그 감각은 변하지 않는다.
		PRINTFORMDW 당신은 한동안 그녀의 입술의 감각을 탐욕스럽게 즐긴다.
	ELSE
		IF TALENT:恋人
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORMW 「Zzz...Zzz...」
				PRINTFORMDW 잠든 레이무와 키스를 나눈다.
				PRINTFORMW 「응... 음...」
				PRINTFORMDW 그녀의 뺨에 희미한 홍조가 번진다.
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMW 「%RANDLIPS()%... %FSYN("lips_over")%!」
						PRINTFORMDW 레이무의 입술이 당신으로부터 떨어졌다.
						PRINTFORMDW 그녀는 욕망에 잠긴 듯하다.
						PRINTFORMW 「아아ー...이것은 거의 녹아내리는 것 같아...」
						PRINTFORMDW 그녀는 공허한 표정으로 저 먼 곳을 응시하며, 눈의 초점을 맞추지 못하는 듯했다.
					CASE 1
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMDW 당신과 레이무는 열정적인 키스를 나눈다.
						PRINTFORMDW 서로의 입술을 한동안 맛본 후, 두 사람은 헤어진다.
						PRINTFORMW 「하아, 하아, 하아... 응, 더 키스할까...?」
						PRINTFORMDW 그녀는 당신에게 계속하자고 재촉한다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:恋慕
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORMW 「Zzz...Zzz...」
				PRINTFORMDW 잠든 레이무와 키스를 나눈다.
				PRINTFORMW 「응... 음...」
				PRINTFORMDW 그녀의 뺨에 희미한 홍조가 번진다.
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMW 「%RANDKISS("kiss")%... %FSYN("lips_muffle")%, 하아...」
						PRINTFORMDW 레이무는 길게 안도의 한숨을 내쉰다.
						PRINTFORMW 「아ー ...뜨거웠어...」
						PRINTFORMDW 그녀는 머리로 피가 몰리는 것을 느끼며 멍해진다.
					CASE 1
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...!」
						PRINTFORMW 「%RANDLIPS()%... %FSYN("lips_over")%...」
						PRINTFORMW 「...너무 뜨거워... 녹아내리는 것 같아, %CALLNAME:MASTER%...」
						PRINTFORMDW 레이무는 당신과의 교환으로 인해 어지러워 보인다.
					CASE 2
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMDW 레이무가 당신에게 깊고 열정적인 키스를 나눈다.
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMW 「하아, 하아, %CALLNAME:MASTER%, 더, 더 많이!」
						PRINTFORMDW 그녀는 당신의 키스 열기에 현기증을 느끼며 더 많은 것을 갈망했다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORMW 「Zzz...Zzz...」
				PRINTFORMDW 잠든 레이무와 입을 맞춘다.
				PRINTFORMW 「%FSYN("lips_muffle")%... 음...」
				PRINTFORMDW 희미한 홍조가 그녀의 뺨 위로 번진다.
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMW 「%RANDLIPS()%... %FSYN("lips_over")%...」
						PRINTFORMDW 그녀는 희미한 홍조를 띠며 당신을 응시한다.
					CASE 1
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMDW 레이무가 당신에게 절제된 키스를 나눈다.
						PRINTFORMW 「%FSYN("lips_muffle")%... %FSYN("lips_over")%, 하...」
						PRINTFORMDW 당신이 혀를 밀어 넣으려 하자, 그녀는 움츠러들며 키스를 끊는다.
				ENDSELECT
			ENDIF
		ELSE
			IF CFLAG:TARGET:睡眠
				PRINTFORML 
				PRINTFORMW 「Zzz...Zzz...」
				PRINTFORMDW 당신은 잠든 레이무와 키스를 나눈다.
				PRINTFORMW 「%FSYN("lips_muffle")%... 크윽...」
				PRINTFORMDW 그녀는 약간 신음한다.
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 
						PRINTFORMW 「%FSYN("lips_muffle")%?! ...%FSYN("lips_muffle")%, %TOLOWER(FSYN("lips_muffle"))%, %TOLOWER(FSYN("lips_over"))%, 그만해!」
						PRINTFORMDW 네가 혀를 밀어 넣으려고 하자, 레이무는 움츠러들며 키스를 끊는다.
					CASE 1
						PRINTFORMW 
						PRINTFORMW 「%RANDLIPS()%...」
						PRINTFORMDW 레이무는 당신에게 자제하는 키스를 나눈다.
						PRINTFORMDW 그녀의 입술은 꽉 다물어져 있어 당신이 혀를 넣을 틈을 주지 않는다...
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;313,胸愛撫
;CFLAG:うふふ==2&&TCVAR:20(27=谷間を見せる 33=胸を揉ませる 53=パイズリ(小分岐は地の文EVENT_MESSAGE_COM_セクハラ.ERB参照) 73=ぱふぱふ 77=乳を吸わせる 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;ABL:Ｂ感覚(2未満=性的には感じてない 5未満=多少感じてる 5以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;乳のサイズでも変わる場合があるので、地の文EVENT_MESSAGE_COM_セクハラ.ERB参照
;==================================================

@M_KOJO_SUCCESS_COM_K1_313
;成否判定
;TFLAG:192(-1＝強制失敗
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1_313
CALL M_KOJO_MESSAGE_COM_K1_313_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDW 너는 레이무의 가슴을 만지려고 시도한다.
		PRINTFORMDW 그것들은 면처럼 부드럽고, 그녀의 유두가 딱딱해지기 시작한다.
		PRINTFORMDW 너는 그녀의 가슴에서 느껴지는 감각을 마음껏 즐긴다.
	ELSEIF CFLAG:睡眠
	ELSE
		IF ABL:Ｂ感覚 > 4
			PRINTFORML 
			PRINTFORMW 「아니, 하얀, %MOAN(,1)%아!」
			PRINTFORMDW 최근 레이무가 가슴에서 기분이 좋아지는 것 같다.
			PRINTFORMW 「아아, 그만두지 마, 더 만져줘!」
			PRINTFORMDW 그녀는 요즘 정말 많은 것을 갈구하고 있다.
		ELSEIF ABL:Ｂ感覚 > 2
			PRINTFORML 
			PRINTFORMW 「...%MOAN()%... 안 돼... 히얀!」
			PRINTFORMDW 최근 레이무의 새끼들이 더 민감해졌다.
			PRINTFORMW 「――내 가슴만? 다른 곳도... 만져주지 않을 거야?」
			PRINTFORMDW 그녀는 욕망으로 탁한 눈으로 당신을 바라봤다.
		ELSE
			PRINTFORML 
			PRINTFORMW 「%MOAN()%... 히아앗...!」
