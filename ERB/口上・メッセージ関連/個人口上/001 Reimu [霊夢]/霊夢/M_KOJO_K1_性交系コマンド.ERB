			ENDIF
			;処女
		ELSEIF FIRSTTIME(SELECTCOM)
			IF TCVAR:破瓜 == 1
				PRINTFORML 
				IF !CFLAG:1:1092
					PRINTFORMDW "레이무, 부탁이 하나 있어."
