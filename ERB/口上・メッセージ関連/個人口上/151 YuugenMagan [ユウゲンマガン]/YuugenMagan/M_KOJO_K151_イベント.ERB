@M_KOJO_CHECK_K151_DAYEVENT_COND(ARGS, ARG, ARG:1)
SELECTCASE ARG
	CASE DAYEVENT_GENERAL ;initial, if the function is allowed to run at all
		SIF !TALENT:恋慕
			RETURN -1
		SIF MARK:反発刻印 || CFLAG:ブチギレ
			RETURN -1
		SIF ARGS == "day" && CFLAG:初期位置 == CFLAG:MASTER:初期位置 ;Magan's morning events can trigger every day like it was before
			RETURN 2
		RETURN 1
		;per event
		;RETURN -1 - means disallowed, 0 - fall back to original condition, 1 - allowed
	CASE DAYEVENT_ORAL
		SIF !HAS_PENIS(MASTER) ;bj only
			RETURN -1
		RETURN 0 ;normal condition
	CASE DAYEVENT_PAIZURI
		RETURN 0 ;normal condition
	CASEELSE
		RETURN -1
ENDSELECT
