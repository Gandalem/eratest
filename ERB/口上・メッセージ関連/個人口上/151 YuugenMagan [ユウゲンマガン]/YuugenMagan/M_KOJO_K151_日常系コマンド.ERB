;==================================================
;603,手を繋ぐ
;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗でもふりほどかれたりはしません
;==================================================
@M_KOJO_SUCCESS_COM_K151_603
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K151_603
CALL M_KOJO_MESSAGE_COM_K151_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		SELECTCASE K151_YM_NATURE()
			CASE 0
				PRINTFORMDW You take YuugenMagan's hand.
				PRINTFORMDW It's surprisingly soft...
				PRINTFORMW 「...?」
				PRINTFORMDW She glances at you. Is she... blushing?
				PRINTFORMW 「What are you doing?」
				$HANDHOLDING_FINISH
				PRINTFORMW 「We can navigate perfectly well by Ourselves.」
				PRINTFORMW 「...It is a gesture of affection? Ah.」

			CASE 1
				PRINTFORMDW You take YuugenMagan's hand and immediately jerk away.
				PRINTFORMDW It's cold and stiff. Like the hand of a corpse.
				PRINTFORMW 「Is something wrong?」
				PRINTFORMDW YuugenMagan rotates her head and stares at you with all seven of her eyes.
				PRINTFORMW 「...Our hand is cold? Is that not normal?」
				PRINTFORMW 「...Hmm. Perhaps We should have fashioned a circulatory system for this body.」
				PRINTFORMW 「Why were you touching it, anyway?」
				GOTO HANDHOLDING_FINISH


			CASE 2

			CASE 3
		ENDSELECT
	ELSE
		IF TALENT:151:恋人
			SELECTCASE K151_YM_NATURE()
				CASE 1
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW YuugenMagan smiles at you as you hold her cold, stiff hand.
							PRINTFORML 「We are glad you continue to hold Our hands despite it feeling unpleasant to you.」
							PRINTFORMW 「To us, it feels... nice.」
						CASE 1
							PRINTFORMDL YuugenMagan rubs her hand with her free hand, trying to warm it up.
							PRINTFORMW 「Is this better?」
						CASE 2
							PRINTFORML 「This is so intimate...」
							PRINTFORMDW Her words come out as a whisper.
							PRINTFORMW 「Even more intimate than mating.」
							PRINTFORMDW She squeezes your hand.
					ENDSELECT

				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDL YuugenMagan concentrates, and her blush vanishes.
							PRINTFORMW 「Is it gone?」
							PRINTFORMDW You nod.
							PRINTFORMW 「Good.」
							PRINTFORMDW She laughs.
							PRINTFORMW 「I don't want to blow my cover, but I really don't want to let your hand go...」

						CASE 1
							PRINTFORML 「How does my hand feel? Is it too soft? Not soft enough?」
							PRINTFORMW 「I can change the way it feels, too.」

						CASE 2
							PRINTFORMW 「Back before... you know, %ALTNAME_REGULAR([[マイ]])% used to tease me about how even Yuki would get a %PRINT_MALE("boy", MASTER)%friend before I did.」
							PRINTFORMW YuugenMagan smirks.
							PRINTFORMW 「I bet if she could see me now, she'd be so jealous that she'd turn into a hashihime on the spot...」

					ENDSELECT

			ENDSELECT
		ELSEIF TALENT:151:セフレ || TALENT:151:愛欲

			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO4", 1, "5", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0)
						CASE 0
							PRINTFORMW 「This gesture has grown on Our skin.」
							PRINTFORMDW Does she mean "grown on Us"?
							PRINTFORML 「Is that the correct term? Yes, that is what We mean.」
							PRINTFORMW 「You may continue.」

						CASE 1
							PRINTFORMW 「You continue to do this even though it is an unpleasant experience for you?」
							PRINTFORMW 「...I-It is not unpleasant, you say?」
							PRINTFORMDW YuugenMagan glances at you, her face even harder to read than usual.

						CASE 2
							PRINTFORML 「We do not understand why you continue to show us affection.」
							PRINTFORMW 「We are mates. That is all.」

						CASE 3
							PRINTFORML 「You are not ashamed to do this in public?」
							PRINTFORMW 「Mating in public is taboo among your people, is it not?」
							PRINTFORMW 「...Yes, but it is a prelude to mating.」
							PRINTFORMW 「...Hmm. Your culture is a strange one...」

						CASE 4
							PRINTFORML 「This is a meaningless gesture...」
							PRINTFORMW 「But somehow, it does not feel meaningless to Us.」
							PRINTFORMW 「How odd. Further study is needed.」

						CASE 5
							PRINTFORMW （I hope %HE_SHE(MASTER)% can't feel how fast my heart is beating...）

					ENDSELECT


				CASE 3

			ENDSELECT
		ELSEIF TALENT:151:思慕 || TALENT:151:恋慕
			SELECTCASE K151_YM_NATURE()
				CASE 0
					PRINTFORMDW Is she blushing?
					PRINTFORMDW YuugenMagan sees you looking at her, and her blush deepens.
					PRINTFORMW 「W-We cannot control how Our body reacts!」

				CASE 1

			ENDSELECT
		ELSE
			SELECTCASE K151_YM_NATURE()
				CASE 0

				CASE 1

			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1

