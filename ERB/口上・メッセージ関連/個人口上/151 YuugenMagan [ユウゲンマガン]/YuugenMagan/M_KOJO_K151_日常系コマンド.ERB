;==================================================
;603,手を繋ぐ
;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗でもふりほどかれたりはしません
;==================================================

@M_KOJO_SUCCESS_COM_K151_603
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K151_603
CALL M_KOJO_MESSAGE_COM_K151_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		SELECTCASE K151_YM_NATURE()
			CASE 0
				PRINTFORMDW 유우겐마간의 손을 잡는다.
				PRINTFORMDW 놀라울 정도로 부드럽다...
				PRINTFORMW 「...?」
				PRINTFORMDW 그녀는 당신을 흘깃 본다. 혹시... 얼굴이 붉어진 건가?
				PRINTFORMW 「뭐 하는 거야?」
				$HANDHOLDING_FINISH
				PRINTFORMW 「우리 스스로도 충분히 잘 해낼 수 있어.」
				PRINTFORMW 「...애정의 몸짓인가? 아.」
			CASE 1
				PRINTFORMDW 유우겐마간의 손을 잡았다가 즉시 움츠러든다.
				PRINTFORMDW 차갑고 뻣뻣하다. 마치 시체의 손 같다.
				PRINTFORMW 「무슨 일이야?」
				PRINTFORMDW 유우겐마간은 고개를 돌려 자신의 일곱 눈으로 당신을 응시한다.
				PRINTFORMW 「...우리 손이 차다고? 그게 정상적이지 않아?」
				PRINTFORMW 「...흠. 이 몸에 순환계를 만들어야 할지도 모르겠군.」
				PRINTFORMW 「어쨌든 왜 만지고 있었던 거야?」
				GOTO HANDHOLDING_FINISH
			CASE 2
			CASE 3
		ENDSELECT
	ELSE
		IF TALENT:151:恋人
			SELECTCASE K151_YM_NATURE()
				CASE 1
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW 유우겐마간은 당신이 그녀의 차갑고 뻣뻣한 손을 잡자 미소 짓는다.
							PRINTFORML 「당신에게 불쾌하게 느껴지더라도 계속 우리의 손을 잡아줘서 기쁘다.」
							PRINTFORMW 「우리에게는... 기분 좋거든.」
						CASE 1
							PRINTFORMDL 유우겐마간은 자유로운 손으로 자신의 손을 비비며 따뜻하게 하려고 노력한다.
							PRINTFORMW 「이게 더 나아?」
						CASE 2
							PRINTFORML 「정말 친밀하네...」
							PRINTFORMDW 그녀의 말은 속삭임처럼 흘러나왔다.
							PRINTFORMW 「교미보다 더 친밀해.」
							PRINTFORMDW 그녀가 당신의 손을 꽉 잡았다.
					ENDSELECT
				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDL 유우겐마간은 집중하며, 그녀의 홍조가 사라진다.
							PRINTFORMW 「사라졌어?」
							PRINTFORMDW 당신은 고개를 끄덕인다.
							PRINTFORMW 「좋아.」
							PRINTFORMDW 그녀는 웃는다.
							PRINTFORMW 「내 정체를 들키고 싶지는 않지만, 네 손을 놓기 정말 싫어...」
						CASE 1
							PRINTFORML 「내 손은 어떤 느낌일까? 너무 부드러울까? 충분히 부드럽지 않을까?」
							PRINTFORMW 「느껴지는 방식을 바꿀 수도 있어.」
						CASE 2
							PRINTFORMW 「예전에는 말이야, %ALTNAME_REGULAR([[マイ]])%이 나한테 유키조차도 내가 그전에 사귀어주지 못할 정도의 %PRINT_MALE("boy", MASTER)%친구를 가졌다고 놀렸었지.」
							PRINTFORMW 유우겐마간은 씨익 웃는다.
							PRINTFORMW 「내가 지금 그녀에게 보인다면, 당장 하시히메로 변해버릴 정도로 질투할걸...」
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:151:セフレ || TALENT:151:愛欲
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO4", 1, "5", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0)
						CASE 0
							PRINTFORMW 「이 몸에 익숙해졌군.」
							PRINTFORMDW 그녀는 "우리에게 익숙해졌다"는 뜻일까?
							PRINTFORML 「그게 맞는 표현인가? 응, 우리가 말하는 게 그거야.」
							PRINTFORMW 「계속해도 좋다.」
						CASE 1
							PRINTFORMW 「당신은 그것이 불쾌한 경험임에도 계속 이것을 하는 건가?」
							PRINTFORMW 「...불쾌하지 않다고 말하는 건가?」
							PRINTFORMDW 유우겐마간은 평소보다 더 읽기 어려운 표정으로 당신을 흘끗 본다.
						CASE 2
							PRINTFORML 「우리는 왜 네가 계속 우리에게 애정을 보여주는지 이해할 수 없다.」
							PRINTFORMW 「우린 반려자다. 그게 전부다.」
						CASE 3
							PRINTFORML 「공공장소에서 이런 행동을 하는 것에 부끄럼이 없는 건가?」
							PRINTFORMW 「당신들의 문화에서는 공공연한 교미는 금기인데, 그렇지 않은가?」
							PRINTFORMW 「...그래, 하지만 그것은 교미의 전주곡이다.」
							PRINTFORMW 「...흠. 당신들의 문화는 이상하군...」
						CASE 4
							PRINTFORML 「이것은 의미 없는 몸짓이다...」
							PRINTFORMW 「하지만 어쩐지, 우리에게는 무의미하게 느껴지지 않는다.」
							PRINTFORMW 「참 이상하다. 추가적인 연구가 필요하다.」
						CASE 5
							PRINTFORMW (내 심장이 얼마나 빨리 뛰는지 %HE_SHE(MASTER)%은 느낄 수 없기를...)
					ENDSELECT
				CASE 3
			ENDSELECT
		ELSEIF TALENT:151:思慕 || TALENT:151:恋慕
			SELECTCASE K151_YM_NATURE()
				CASE 0
					PRINTFORMDW 그녀가 얼굴을 붉히고 있는 건가?
					PRINTFORMDW 유우겐마간은 네가 그녀를 바라보는 것을 보고, 그녀의 홍조가 깊어진다.
					PRINTFORMW 「저-저희 몸이 어떻게 반응하는지 제어할 수 없어요!」
				CASE 1
			ENDSELECT
		ELSE
			SELECTCASE K151_YM_NATURE()
				CASE 0
				CASE 1
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
