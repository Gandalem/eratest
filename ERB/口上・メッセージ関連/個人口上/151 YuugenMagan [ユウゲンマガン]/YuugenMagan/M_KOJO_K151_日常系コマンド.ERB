;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================
@M_KOJO_SUCCESS_COM_K151_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K151_301
CALL M_KOJO_MESSAGE_COM_K151_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME("MaganTea")
		SELECTCASE K151_YM_NATURE()
			CASE 0, 1
				PRINTFORML 「Tea, you say?」
				PRINTFORMDW YuugenMagan stares impassively at the cup.
				PRINTFORMW 「And what do you do with it?」
				PRINTFORMDW You explain that you pour it into your mouth and swallow it.
				PRINTFORMW 「And you gain sustenance from this... fascinating.」
				PRINTFORMW 「In Our world, We have no need of such things.」
				PRINTFORMW 「We simply are.」
				PRINTFORMDW YuugenMagan takes the cup and sips.
				PRINTFORMW 「Hm.」
				PRINTFORMDW She takes another sip.
				PRINTFORMW 「We cannot grasp the appeal... but We shall continue ingesting it to be polite.」
				PRINTFORMW 「We wish to cultivate better relations with the species of your dimension.」
			CASE 2
				PRINTFORMW 「Tea, huh?」
				PRINTFORMW 「I've always been more of an iced coffee girl... but I'll give it a shot.」
				PRINTFORMDW YuugenMagan takes the cup from you and sips. Her eyes light up.
				PRINTFORMW 「Wow, this is really good!」
		ENDSELECT
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				SELECTCASE K151_YM_NATURE()
					CASE 0, 1
						IF FIRSTTIME("GoodTea")
							PRINTFORMW 「The taste is different. More enticing, somehow. Why?」
							PRINTFORMDW You explain that it just worked out that way.
							PRINTFORMW 「Pardon?」
							PRINTFORMDW YuugenMagan's voice remains as impassive as ever.
							PRINTFORMW 「In your world, actions are not pure? They have...」
							PRINTFORMDW YuugenMagan pauses for a moment.
							PRINTFORMW 「Side effects, We believe you call them? The same inputs may produce a different output?」
							PRINTFORMW 「What strange creatures you are.」
						ELSE
							PRINTFORMW 「Your tea is impure again. The enticing kind.」
							IF CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0
								PRINTFORMDW Is YuugenMagan smiling at you?
								PRINTFORMDW As soon as she sees you looking at her, her smile fades and she's back to her usual impassive expression.
							ENDIF
						ENDIF
					CASE 2
						PRINTFORMW 「Oh wow, this is great!」
						PRINTFORMDW YuugenMagan drains the cup and grins at you.
						PRINTFORMW 「You've really gotta teach me how to make it one of these days.」
				ENDSELECT
			CASE 0
				IF TALENT:[[ユウゲンマガン]]:恋人
					SELECTCASE K151_YM_NATURE()
						CASE 1
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「This substance is not enchanted, is it?」
									PRINTFORML 「...No? Then why have We become addicted to consuming it?」
									PRINTFORMW 「It is simply because it is from you?」
								CASE 1
									PRINTFORML 「How many cups of tea have you served Us now?」
									PRINTFORMW 「It must be more than the number of stars in the cosmos.」
									PRINTFORMW 「And yet... We never grow bored of the experience.」
								CASE 2
									PRINTFORMW 「Perhaps We should begin demanding tea as tribute from Our worshippers.」
									PRINTFORMW 「Then again, perhaps not. For none can make tea the way you do.」
							ENDSELECT
						CASE 2
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 「Heheh, %ALTNAME_REGULAR([[マイ]])%'s gonna be so jealous when she finds out about your tea.」
									PRINTFORMW 「Sure, she may be way better at magic than I am, but does she have a smoking hot %PRINT_MALE("boy", MASTER)%friend who's a tea-brewing expert?」
									IF TALENT:105:恋人
										PRINTFORMW 「...Oh wait, she does.」
										PRINTFORMDW YuugenMagan scowls.
									ENDIF
								CASE 1
									PRINTFORML 「I think I'm starting to get addicted to your tea.」
									PRINTFORMW 「I can't remember the last time I had a cup of instant coffee, and I used to drink four cups a day, every day!」
								CASE 2
									PRINTFORMW 「Do you think people would think I'm cool if I used my magic to make this tea look like poison?」
									PRINTFORMW 「...No? Aww...」
							ENDSELECT
					ENDSELECT
				ELSEIF TALENT:[[ユウゲンマガン]]:セフレ || TALENT:[[ユウゲンマガン]]:愛欲
					SELECTCASE K151_YM_NATURE()
						CASE 1
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						CASE 2
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
					ENDSELECT
				ELSEIF TALENT:[[ユウゲンマガン]]:思慕 || TALENT:[[ユウゲンマガン]]:恋慕
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORML 「We do not know why... but We have grown fond of this ritual.」
							PRINTFORMDW YuugenMagan lowers her cup and smiles at you with her upside-down smile.
						CASE 1
							PRINTFORMW （It is strange... this tea is warm, but not in the same way as our chest becomes warm in %HIS_HER(MASTER)% presence...）
							PRINTFORMDW YuugenMagan mutters something to herself as she takes the cup from you.
						CASE 2
							PRINTFORMW 「This is... quite good.」
							PRINTFORMDW YuugenMagan beams at you for a moment, but when she sees that you're looking at her, her face returns to its usual impassive expression.
						CASE 3
							PRINTFORML 「This is an interesting ritual you have devised.」
							PRINTFORMW 「What manner of being does it invoke? Will it happen before We have consumed Our tea, or after?」
					ENDSELECT
				ELSE
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORML 「Ah, so this is a ritual designed to facilitate community and understanding. How wise.」
							PRINTFORMDW It's not that deep...
						CASE 1
							PRINTFORMW 「How did you derive this ritual? Was it told to you by a god?」
							PRINTFORMDW You... don't actually know.
							PRINTFORMW 「The art of... tea-brewing, you called it, is so ancient that you do not even remember where it came from?」
							PRINTFORMW 「Fascinating...」
						CASE 2
							PRINTFORMW 「It could use more sugar... but I suppose it will suffice.」
						CASE 3
							PRINTFORML 「While we enjoy the heat of your tea, We did not give this body taste buds, so we cannot truly appreciate it.」
							PRINTFORMDW YuugenMagan frowns.
							PRINTFORMW 「What does tea taste like, exactly?」
					ENDSELECT
				ENDIF
			CASE -1
				SELECTCASE K151_YM_NATURE()
					CASE 0
						PRINTFORML 「This tea tastes foul!」
						PRINTFORMDW YuugenMagan dumps the cup on the ground and glares at you.
						PRINTFORMW 「Are you insulting Us by serving corrupted beverages?!」
					CASE 1
						PRINTFORML 「Hm.」
						PRINTFORMDW YuugenMagan stares impassively at you as she drinks the tea.
						PRINTFORMW 「This was not as enjoyable, somehow.」
					CASE 2
						PRINTFORML 「Ugh.」
						PRINTFORMDW YuugenMagan lowers her cup and makes a face.
						PRINTFORMW 「I dunno what it is, but this tea tastes... off.」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
