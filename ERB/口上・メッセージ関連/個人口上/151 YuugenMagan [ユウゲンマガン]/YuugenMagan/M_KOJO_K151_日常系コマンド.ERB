RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;ここに口上書いて下さい
	IF TFLAG:193 > -1
		IF RAND:3
			CALL K151_CONVERSATION_INTERACTION
			SIF RESULT
				RETURN 0
		ENDIF

		IF TALENT:[[ユウゲンマガン]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[ユウゲンマガン]]:セフレ || TALENT:[[ユウゲンマガン]]:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[ユウゲンマガン]]:思慕 || TALENT:[[ユウゲンマガン]]:恋慕
			$YM_YEARNING_CONVOS
			SELECTCASE RAND:10
				CASE 0
					PRINTFORMDW YuugenMagan frowns.
					PRINTFORMW 「Recently, upon seeing you, blood has begun rushing to this body's face.」
					PRINTFORMW 「Do you know why this might be? It is vexing.」
				CASE 1
					PRINTFORMW 「How does one... make friends?」
					PRINTFORMW 「Everyone else appears to have them, but We do not, and it vexes us.」
					PRINTFORMDW That's not true. You're her friend, aren't you?
					PRINTFORMW 「Are you? When did that happen? And how?」
					PRINTFORMDW You explain that a friend is someone you enjoy spending time with.
					PRINTFORMW 「Ah... but what does it mean to "enjoy"?」
					PRINTFORMDW ...This is going to take a while.
					PRINTFORMW After explaining a bunch of other things to YuugenMagan, she places a hand on her chest.
					PRINTFORMDW So the strange sensation We feel within when We are in your presence... is pleasure?
					PRINTFORMW 「And that means you and Us are friends?」
					PRINTFORMDW You nod, a little annoyed.
					PRINTFORMW 「That is good.」
					PRINTFORMDW She smiles her weird upside-down smile.
					PRINTFORMW 「I am... glad... that you are Our friend.」

				CASE 2
					PRINTFORML 「What is the sun?」
					PRINTFORMW 「Is it the goddess Amaterasu, or a ball of incandescent plasma?」
					PRINTFORMW 「We have heard conflicting reports.」

				CASE 3
					PRINTFORMW 「Tell Us about the Red String of Fate.」
					PRINTFORMW 「Is it true that everyone has a fated partner?」
					CALL ASK_YN("It is.", "It isn't.")
					IF !RESULT
						PRINTFORMW 「Interesting.」
						PRINTFORMW 「Do only beings of matter have one?」
						PRINTFORMW 「...We are curious! That is all!」
						PRINTFORMDW But the blush on her face says otherwise...
					ELSE
						PRINTFORMW 「It is only a superstition? That is a shame.」
					ENDIF

				CASE 4
					SIF !CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0
						GOTO YM_YEARNING_CONVOS
					PRINTFORMW 「We understand this is somewhat of an odd question...」
					PRINTFORMW 「But if someone you cared about was keeping a secret from you and lying to you about it...」
					PRINTFORMW 「Would you forgive then if that secret came out?」
					CALL ASK_YN("I would.", "I wouldn't.")
					IF !RESULT
						PRINTFORMW 「...」
						PRINTFORMW 「You are kind.」
						PRINTFORMW 「I doubt many others would...」
					ELSE
						PRINTFORMW 「...」
						PRINTFORMW 「I see...」
						PRINTFORMDW YuugenMagan looks away from you.
					ENDIF

				CASE 5
					SIF !TALENT:妊娠
						GOTO YM_YEARNING_CONVOS
					PRINTFORML 「Even though We are with child, We have no reason to depart.」
					SELECTCASE K151_YM_NATURE()
						CASE 0
							PRINTFORMW 「We must raise it right...」
							PRINTFORMDW YuugenMagan swallows.
						CASE 1
							PRINTFORMDW YuugenMagan smiles her weird upside-down smile.
							PRINTFORMW 「We desire to make more. Many more...」
					ENDSELECT

				CASE 6
					SIF !TALENT:妊娠
						GOTO YM_YEARNING_CONVOS
					PRINTFORML 「Do not be surprised if Our child looks exactly like Us.」
					PRINTFORMW 「Such is the way of Great Ones.」

				CASE 7
					SIF !FLAG:異常気象 == 7
						GOTO YM_YEARNING_CONVOS
					PRINTFORMW 「Undergarments are flying through the air.」
					PRINTFORMW 「Is this something that often happens in your world?」
					PRINTFORMW 「Only in Gensokyo? How odd...」

				CASE 8
					SIF !BASE:[[ユウゲンマガン]]:体力 < 750
						GOTO YM_YEARNING_CONVOS
					PRINTFORMDW YuugenMagan yawns.
					PRINTFORMW 「How irritating... this body is malfunctioning.」
					PRINTFORMW 「We would destroy it and make another, if We still had the power to do so.」
					PRINTFORMW 「Alas, it seems We have no choice but to sleep.」

				CASE 9
					PRINTFORMW 「It is strange.」
					PRINTFORMW 「*Below*, We could change the world however We wanted by applying Our will, unless a stronger will prevented Us from doing so.」
					PRINTFORMW 「Yet we cannot do this in the world of matter.」
					PRINTFORMW 「Does your world have a will of its own?」

			ENDSELECT
		ELSE
			SELECTCASE RAND:8
				CASE 0
					PRINTFORMW 「What is it like "below"?」
					PRINTFORMDL YuugenMagan laughs. At least you think it's a laugh. 
					PRINTFORMDW It's more of a bark, like someone told her what a laugh was, but she'd never actually heard one before.
					PRINTFORMW 「You would not comprehend. Let Us see if We can find words in your tongue to describe it...」
					PRINTFORMDW She pauses to think. Her entire body goes rigid, almost like you've just stopped time.
					PRINTFORMW 「There are... pretty colors, but it hurts. We like it here because it does not hurt.」
				CASE 1
					PRINTFORMW 「Do you like Our eyes? We believe they are Our finest feature.」
					PRINTFORMW 「Although they are not like your eyes. Where We come from, you do not need eyes to see.」
					PRINTFORMW 「They are simply how We manifest Ourselves in your world. We do not know why.」
				CASE 2
					PRINTFORMW 「...Have you spoken with Shinki yet?」
					PRINTFORMW 「...We see.」
					PRINTFORML 「The woman is a liar and is not to be trusted.」
					PRINTFORMW 「Do not believe anything she tells you. It will only lead to disaster.」
					PRINTFORMDW YuugenMagan looks strangely nervous...
				CASE 3
					PRINTFORMW 「The satori intrigues Us. Is her third eye truly part of her, or another being altogether? One like Us?」
					PRINTFORMW 「We would investigate, but We don't want her reading Our mind.」
					PRINTFORMW 「N-Not because We have anything to hide. We are just concerned about her safety.」
					PRINTFORMW 「If she tried to read Our mind, We fear it would be... messy.」
				CASE 4
					PRINTFORMW 「Is Sara still guarding the gate to Makai?」
					PRINTFORMDW YuugenMagan sighs. It's oddly human of her.
					PRINTFORMW 「Why didn't she fight the shrine maiden all those years ago? Why did We have to do her job?」
					PRINTFORMW 「As if We didn't already have enough reasons to hate her...」
				CASE 5
					PRINTFORMW 「The blind satori fascinates Us. We are five with one mind, and she is one with no mind at all.」
					PRINTFORMW 「If she has no mind... could We, perhaps, speak to her about things from Our world without driving her mad?」
					PRINTFORMW 「It would be nice to have someone We do not have to keep secrets from.」
					PRINTFORMDW YuugenMagan seems... wistful, somehow.
				CASE 6
					PRINTFORMW 「Has the engineer modeled her Evil Eyes after Us? How charming.」
					PRINTFORMW 「We must be sure to thank her for it. Perhaps We will make her the high priestess of Our cult...」
				CASE 7
					PRINTFORMW 「What is a "div"?」
					PRINTFORMW 「The bridge princess sometimes mutters it under her breath when she thinks We are not listening.」
					PRINTFORML 「We assume that it is not a term of endearment. A slur, perhaps?」
					PRINTFORMW 「Whatever it may be, We do not take kindly to insults.」
					PRINTFORMDW YuugenMagan smiles faintly, but her eyes are cold and full of anger.
					PRINTFORMW 「We will teach her a lesson... in due time.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
