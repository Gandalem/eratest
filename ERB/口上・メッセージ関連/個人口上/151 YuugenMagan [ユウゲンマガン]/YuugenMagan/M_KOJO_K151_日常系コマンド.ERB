							PRINTFORMW 「Seriously though, this stuff tastes awful.」
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORMW 「An intriguing taste.」
							PRINTFORMW 「We would sample more, should you give it to Us.」

						CASE 1
							PRINTFORMW 「It tastes like... biting.」
							PRINTFORMW 「How odd...」

						CASE 2
							PRINTFORMW 「I do not know what I was worried about.」
							PRINTFORMW 「May I have another? Just enough to get a nice buzz going...」

						CASE 3
							PRINTFORMW 「Another offering? We accept it gladly.」
					ENDSELECT
				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「This is... okay, I guess.」

						CASE 1
							PRINTFORMW 「Do you have anything that's not as strong? This isn't really doing it for me.」

						CASE 2
							PRINTFORMW 「Not bad!」
							PRINTFORMDW YuugenMagan takes a swig.
							PRINTFORMW 「I wouldn't mind another... unless you've got something a little less strong.」
					ENDSELECT
			ENDSELECT

		ENDIF
	ENDIF
ENDIF
