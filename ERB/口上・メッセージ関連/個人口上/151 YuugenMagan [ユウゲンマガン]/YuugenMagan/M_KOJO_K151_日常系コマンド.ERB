@M_KOJO_MESSAGE_COM_K151_416_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL

	SELECTCASE TFLAG:193
		CASE 1
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORMW 「A song that would charm Tru'nembra itself.」

						CASE 1
							PRINTFORML 「Your playing is unearthly...」
							PRINTFORMDW YuugenMagan tilts her head to the side.
							PRINTFORMW 「We approve.」

						CASE 2
							PRINTFORML 「We haven't heard music this good since...」
							PRINTFORMDW YuugenMagan trails off.
							PRINTFORMW 「Never mind. Keep playing.」

						CASE 3
							PRINTFORMW YuugenMagan sways hypnotically to the rhythm of your music.
					ENDSELECT

				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「Oooh, that sounded really good!」
							PRINTFORMDW YuugenMagan applauds your performance.
						CASE 1
							PRINTFORML 「Wow, that was amazing!」
							PRINTFORMW 「You've got a real gift for music...」
						CASE 2
							PRINTFORML 「Encore! Encore!」
							PRINTFORMDW YuugenMagan applauds enthusiastically.
					ENDSELECT
			ENDSELECT

		CASE 0
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORMW 「These sound waves are quite pleasant to listen to.」

						CASE 1
							PRINTFORML 「Your hands are quite deft, and you can create pleasing sounds.」
							PRINTFORMW 「Yes, you will make an excellent mate.」

						CASE 2
							PRINTFORML 「You're very talented...」
							PRINTFORMDW YuugenMagan smiles, but she seems a little displeased.

						CASE 3
							PRINTFORML 「We had no idea that so many noises could be created in the world of matter...」
							PRINTFORMW 「Make more of them. 」
					ENDSELECT

				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「Wow, you've got some real talent!」
							PRINTFORMDW YuugenMagan beams at you.
							PRINTFORMW 「Can you play another?」
						CASE 1
							PRINTFORMW 「This is way different than the music we listen to in Makai.」
						CASE 2
							PRINTFORML 「I wish I could play an instrument...」
							PRINTFORMW 「Could you teach me sometime?」
					ENDSELECT
			ENDSELECT

		CASE -1
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORML 「Urgh! What is this... noise?!」
							PRINTFORMDW YuugenMagan claps her hands over her ears.

						CASE 1
							PRINTFORMW 「What are you doing to that device?! Desist!」

						CASE 2
							PRINTFORMW 「Stop it! You're giving Us a headache!」

						CASE 3
							PRINTFORML 「You do not seem to understand. Your music is too pleasant.」
							PRINTFORMW 「Make it more cacophonous.」
					ENDSELECT

				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「You... really need more practice.」
						CASE 1
							PRINTFORMDW YuugenMagan winces at the sound of your "performance".
						CASE 2
							PRINTFORML 「That was... interesting.」
							PRINTFORMDW YuugenMagan applauds halfheartedly.
					ENDSELECT
			ENDSELECT

	ENDSELECT

ENDIF
RETURN 1
