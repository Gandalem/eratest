@M_KOJO_MESSAGE_COM_K151_415
CALL M_KOJO_MESSAGE_COM_K151_415_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_415_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		SELECTCASE K151_YM_NATURE()
			CASE 0, 1
				PRINTFORMW 「And what, exactly, is this?」
				PRINTFORMDW You tell her that it's food.
				PRINTFORMW 「And that is...?」
				PRINTFORMDW You patiently explain the concept of food to YuugenMagan.
				PRINTFORMW 「Ah. So you devour this substance to sustain your own existence?」
				PRINTFORMW 「How sad. And We envied you for being able to change...」
				PRINTFORMW 「Everything has its price, it seems.」

			CASEELSE
				PRINTFORMW 「I just realized... this is this first time you've ever served me anything.」
				PRINTFORMW 「Did you think I was too eldritch to eat or something?」

		ENDSELECT
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				SELECTCASE K151_YM_NATURE()
					CASE 0, 1
						SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
							CASE 0
								PRINTFORMW 「Incredible! No wonder beings of matter are addicted to eating!」
							CASE 1
								PRINTFORMW 「Had we known eating bestowed such sensations, We would have experimented with it sooner.」
							CASE 2
								PRINTFORMW 「Ah, this tastes wonderful! You have done well.」
							CASE 3
								PRINTFORMW 「You have worked a truly miraculous transformation on this matter.」
						ENDSELECT
					CASE 2
						SELECTCASE RAND:3
							CASE 0
								PRINTFORMW 「Oh wow, this is amazing! Yumeko-san herself couldn't do better!」
							CASE 1
								PRINTFORMDW YuugenMagan takes a bite, and her eyes light up.
								PRINTFORML 「D'l'sh's!」
								PRINTFORMDW She shallows.
								PRINTFORMW 「You're a really good cook.」
							CASE 2
								PRINTFORMW 「Wow, I can't remember the last time I had something this good!」
						ENDSELECT
				ENDSELECT

			CASE 0
				SELECTCASE K151_YM_NATURE()
					CASE 0, 1
						SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
							CASE 0
								PRINTFORMDW YuugenMagan chews thoughtfully.
								PRINTFORML 「These flavors... when they combine, they taste different than each one separately.」
								PRINTFORMW 「Why is this so?」
							CASE 1
								PRINTFORML 「An intriguing taste.」
								PRINTFORMW 「May We have more?」
							CASE 2
								PRINTFORML 「Your cooking is quite enjoyable.」
								PRINTFORMW 「Perhaps you could teach Us how it is done?」
							CASE 3
								PRINTFORMW 「Ah, We can feel the energy surging through Us. You have done well.」
						ENDSELECT
					CASE 2
						SELECTCASE RAND:3
							CASE 0
								PRINTFORMW 「This isn't half bad!」
							CASE 1
								PRINTFORMW 「You're a pretty good cook.」
								PRINTFORMW 「...Can you give me some pointers?」
							CASE 2
								PRINTFORMW 「This is way better than instant ramen!」
						ENDSELECT
				ENDSELECT

			CASE -1
				SELECTCASE K151_YM_NATURE()
					CASE 0, 1
						SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
							CASE 0
								PRINTFORMW 「It seems your preparation process contains too many side effects.」
							CASE 1
								PRINTFORMW 「Did you prepare this with impure ingredients? It tastes foul.」
							CASE 2
								PRINTFORMW 「Is it... supposed to taste like this?」
							CASE 3
								PRINTFORMW 「This meal contains too many impurities. Prepare another.」
						ENDSELECT
					CASE 2
						SELECTCASE RAND:3
							CASE 0
								PRINTFORMW 「Um... I don't really like this.」
							CASE 1
								PRINTFORMW 「Urgh... I think your ingredients were spoiled...」
							CASE 2
								PRINTFORMW 「I don't wanna be rude, but this is... bad.」
						ENDSELECT
				ENDSELECT

		ENDSELECT

	ENDIF
ENDIF
RETURN 1
