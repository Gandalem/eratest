;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K151_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K151_310
CALL M_KOJO_MESSAGE_COM_K151_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		SELECTCASE TFLAG:193
			CASE 4
				IF TALENT:[[ユウゲンマガン]]:恋人
				ELSEIF TALENT:[[ユウゲンマガン]]:セフレ || TALENT:[[ユウゲンマガン]]:愛欲
				ELSEIF TALENT:[[ユウゲンマガン]]:思慕 || TALENT:[[ユウゲンマガン]]:恋慕
				ELSE
					PRINTFORMW 「Ah!」
					PRINTFORMDW 당신이 그녀의 엉덩이를 쓰자 마간은 숨을 들이쉰다.
					PRINTFORMW 「우리는 이런 것으로부터 쾌락 응답을 받을 줄은 몰랐어...」
				ENDIF
			CASE 2,3
				IF TALENT:[[ユウゲンマガン]]:恋人
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 
						CASE 1
							PRINTFORML 
						CASE 2
							PRINTFORML 
					ENDSELECT
				ELSEIF TALENT:[[ユウゲンマガン]]:セフレ || TALENT:[[ユウゲンマガン]]:愛欲
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 
						CASE 1
							PRINTFORML 
						CASE 2
							PRINTFORML 
					ENDSELECT
				ELSEIF TALENT:[[ユウゲンマガン]]:思慕 || TALENT:[[ユウゲンマガン]]:恋慕
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 
						CASE 1
							PRINTFORML 
						CASE 2
							PRINTFORML 
					ENDSELECT
				ELSE
					SELECTCASE RAND:5
						CASE 0
							PRINTFORMW 「왜 이 몸의 뒤쪽을 만지는 거지?」
							PRINTFORMW 「어떻게 변형된 거야?」
						CASE 1
							PRINTFORMW 「아, 그렇군. 이 몸의 이 부위는 에로틱 존이지 않나?」
							PRINTFORMW 「우리와 교합하기를 욕망하는가? 우리는 거절해야 한다.」
						CASE 2
							PRINTFORMW 「우리 몸의 이 부위가 매력적인 이유는 무엇인가요?」
							PRINTFORMW 「보통 배설계와 연결되어 있지 않나요?」
							PRINTFORMW 「아니면 그게 이유인가요? 저희는 배설계가 없으니까 더 선호하는 건가요?」
						CASE 3
							PRINTFORMW 「흠. 우리는 바람직한 짝을 끌기 위해 이 몸의 뒤쪽을 만들었지...」
							PRINTFORMW 「하지만 별들이 아직 맞지 않아. 그만두어.」
						CASE 4
							PRINTFORML 「우리에게 마사지를 해주려는 건가요?」
							PRINTFORMW 「우리는 그런 것이 필요 없습니다.」
					ENDSELECT
				ENDIF
			CASEELSE
				IF TALENT:[[ユウゲンマガン]]:恋人
				ELSEIF TALENT:[[ユウゲンマガン]]:セフレ || TALENT:[[ユウゲンマガン]]:愛欲
				ELSEIF TALENT:[[ユウゲンマガン]]:思慕 || TALENT:[[ユウゲンマガン]]:恋慕
				ELSE
					PRINTFORMDW 마간이 당신을 노려본다.
					PRINTFORMW 「이 몸의 뒤에서 손을 치우지 않으면 우리가 직접 찢어버릴 것이다.」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K151_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K151_311
CALL M_KOJO_MESSAGE_COM_K151_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSE
		IF FIRSTTIME("YMHug")
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					PRINTFORMW 「너는 나를 삼키려고 하는 거니?」
					PRINTFORMDW 유우겐마간은 당신을 멍하니 응시한다.
					PRINTFORMW 「너는 위대한 존재를 삼킬 수 없다. 스스로 먹히게 될 테니 시도하지 않는 것을 권고한다.」
					PRINTFORMW 「...오? 한 "포옹"애정의 한 형태라니 말인가?」
					PRINTFORMW 「좋다 허락하겠다」
				CASE 2
					PRINTFORMDW 유우겐마간은 당신의 포옹에 기대며 당신을 다시 안는다.
					PRINTFORMW 「아... 집에 있던 때가 생각나네.」
					PRINTFORMW 「신키님께서 방문하실 때마다 나를 잡아 부러질 것 같을 정도로 세게 껴안곤 했지!」
					PRINTFORMDW 그녀는 웃음을 터뜨린다.
					PRINTFORMW 「당신이 좀 더 자제심이 있는 게 다행이야...」
			ENDSELECT
		ELSEIF TALENT:151:恋人
			SELECTCASE K151_YM_NATURE()
				CASE 1
					SELECTCASE TFLAG:193
						CASE 1
							PRINTFORML 「Ah...」
							PRINTFORMDW 유우겐마간은 당신의 품에서 기쁨으로 떨었다.
							PRINTFORML 「당신의 포옹은 너무 중독적이야...」
							PRINTFORMDW 그녀는 일곱 개의 눈으로 욕망을 담아 당신을 바라본다.
							CALL HPH_PRINT, @"「이제 책임을 지고 우리에게 정기적인 공급을 해라」", "W"
						CASE 0
							SELECTCASE RAND:6
								CASE 0
									PRINTFORMW 「만약 우리가 심장이 있다면, 두근거리고 있을 거야...」
								CASE 1
									PRINTFORML 「춥지 않으세요?」
									PRINTFORMW 「우리는 멈추고 싶지 않지만... 우리의 안위보다 당신의 편안함을 더 생각하게 되었어요.」
								CASE 2
									PRINTFORML 「더 단단히 안아줘, 나의 사랑.」
									PRINTFORMW 「우리와 당신이 하나로 융합될 만큼...」
								CASE 3
									PRINTFORMW 「우리 몸은 너무 안 추워, 그렇지?」
								CASE 4
									PRINTFORMDL 유우겐마간이 당신을 다시 껴안는다.
									PRINTFORMDW 그녀는 포옹하는 것이 훨씬 능숙해졌다...
								CASE 5
									PRINTFORML 「아... 이 자세라면 순식간에 너를 삼킬 수 있겠어.」
									PRINTFORMW 「그럼 너는 영원히 우리와 하나가 될 테지...」
									PRINTFORMW 「농담이었어! 두려워하지 마!」
							ENDSELECT
						CASE -1
							PRINTFORMDW 유우겐마간에게 안기 위해 다가가는 당신은 그녀의 눈알 중 하나에 머리를 부딪친다.
							PRINTFORMW 「아! 괜찮으세요, 나의 사랑?!」
							PRINTFORMDW 당신은 머리를 문지르며 자신이 괜찮다고 그녀를 안심시킨다.
							PRINTFORMW 「그것이 다행이군요. 저희가 사과드립니다.」
							PRINTFORMW 「저희도 너무... 흥분해서, 우리 몸이 어디에 있는지 잊고 말았어요...」
					ENDSELECT
				CASE 2
					SELECTCASE TFLAG:193
						CASE 1
							PRINTFORMDL 유우겐마간의 손이 당신의 등에 미끄러져 내려 두 사람이 포옹하자 당신의 엉덩이에 머문다.
							PRINTFORMDW 그녀는 잠시 멈춘 후... 당신도 그녀의 엉덩이에 손을 올리며 응답한다.
							PRINTFORMDL 그녀는 웃으며 당신의 엉덩이를 꽉 잡는다.
							CALL HPH_PRINT, @"「변태 HPH」", "W"
						CASE 0
							SELECTCASE RAND:4
								CASE 0
									PRINTFORMDL 뭔가 미끌거리는 것이 당신의 엉덩이를 때린다.
									PRINTFORMDW 당신은 유우겐마간에게서 몸을 빼고, 촉수가 포털 속으로 사라지는 것을 보기에 딱 맞춰 돌아본다.
									PRINTFORMDL 유우겐마간은 당신에게 기대어 당신의 귓가에 속삭인다.
									PRINTFORMW 「헤헤.... 잡았네.」
								CASE 1
									PRINTFORMDL 유겐마간은 당신의 품에 기대어 당신을 냄새 맡는다.
									PRINTFORMW 「좋은 냄새가 나네...」
									PRINTFORMDW 당신이 그녀에게 시선을 준다. 그녀도 당신에게 시선을 건넨다.
									PRINTFORMW 「무슨 일이야? 내가 온 곳에서는 그게 당연한 거야.」
								CASE 2
									PRINTFORMDW 유우겐마간은 두 사람이 포옹하는 가운데 당신의 뺨에 키스한다.
								CASE 3
									PRINTFORMDL 두 사람이 서로를 껴안자 유우겐마간의 뜨거운 숨결이 목에 느껴진다.
									PRINTFORMW 「정말 많이 사랑해, 자기야...」
							ENDSELECT
						CASE -1
							PRINTFORMDL 당신이 유우겐마간을 껴안자 손이 그녀의 등을 따라 내려간다.
							PRINTFORMDW 아래로... 아래로... 그리고 그것이 그녀의 엉덩이에 닿았을 때, 그대로 통과해 버린다.
							PRINTFORMDW 유우겐마간은 얼굴을 붉힌다.
							PRINTFORMW 「미안해, %CALLNAME:MASTER%. 내 마법으로 엉덩이를 조금 "강화"하면 눈치채지 못할 거라고 생각했어...」
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:151:セフレ || TALENT:151:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:151:思慕 || TALENT:151:恋慕
			SELECTCASE TFLAG:192
				CASE 1
					PRINTFORMDL 유우겐마간은 당신의 품에 기대며 당신의 뺨을 감싼다.
					CALL HPH_PRINT, @"「너 맛있다HPH」", "W"
					PRINTFORMW 「...죄송합니다. 옛 습관은 쉽게 사라지지 않네요...」
				CASE 0
					SELECTCASE IFRAND("0TO1", 1, "2TO3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "4", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORMDW 유우겐마간은 어색하게 당신을 다시 안는다.
							PRINTFORMW 「이게 맞나요?」
						CASE 1
							PRINTFORMDW 유우겐마간은 당신이 그녀를 껴안자 어색하게 머리를 쓰다듬는다.
						CASE 2
							PRINTFORMDW 당신이 포옹하자, 유우겐마간의 심장이 가슴에서 두근거리는 것을 느낄 수 있다.
							PRINTFORMDW 그녀가 그렇게 당황하는 모습을 보니 꽤 귀엽다...
						CASE 3
							PRINTFORMDW 마간은 당신을 다시 껴안고 얼굴을 당신의 어깨에 기댄다.
							PRINTFORMW (이렇게 안긴 건... 한 지가 없었지.)
							PRINTFORMDW 당신은 자신의 어깨 위에서 무언가 축축한 것을 느낄 수 있다.
						CASE 4
							PRINTFORMDW 당신은 애정 때문이기도 하고 그녀를 조금 따뜻하게 해주고 싶어서 유우겐마간의 등을 감싸 안는다...
							PRINTFORMDW 여전히 그녀를 안는 것은 시신을 안는 것 같은 기분이다...
					ENDSELECT
				CASE -1
					SELECTCASE K151_YM_NATURE()
						CASE 0
							PRINTFORMDL 유우겐마간을 껴안으면서 손을 너무 아래로 움직이자 그녀가 그것을 쳐낸다.
							PRINTFORMW 「또 그러면 떼어버릴 거야.」
						CASE 1
							PRINTFORMDL 당신은 노력했지만, 이 여자가 풍기는 잘못된 느낌이 너무 강했다.
							PRINTFORMDW 유우겐마간에게 짧게 안아준 뒤, 소리를 지르기 전에 물러난다.
							PRINTFORMDW 마음을 가라앉힌 후 그녀의 옆으로 다시 다가가지만... 이번에는 조금 더 거리를 두었다.
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:192
				CASE 1
					SELECTCASE K151_YM_NATURE()
						CASE 0
							PRINTFORMDW 유우겐마간이 느슨하게 팔을 당신에게 감는다.
						CASE 1
							PRINTFORMDW 유우겐마간이 당신을 끌어안고 발끝으로 서 있을 때까지 들어 올린다.
					ENDSELECT
					PRINTFORMDW 적어도 그녀는 노력했나?
				CASE 0
					SELECTCASE IFRAND("0", 1, "1TO2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3TO4", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORMDW 마간의 손이 당신의 몸 위를 미끄러지며 그녀를 껴안는다.
							PRINTFORML 「강하다... 건강하다... 장기로 가득 차 있다...」
							PRINTFORMW 「그래, 너는 훌륭한 반려가 될 것이다.」
						CASE 1
							PRINTFORMDW 유우겐마간은 언제나처럼 표정 없이 그저 서 있다, 네가 그녀를 안는 동안.
						CASE 2
							PRINTFORMW (이것은... 추억을 되살린다...)
							PRINTFORMDW 유우겐마간은 당신이 그녀를 안는 동안 그것을 속삭인다. 아니면 당신이 방금 상상한 것일까?
						CASE 3
							PRINTFORMDW 당신이 안아주자 유우겐마간이 어깨에 침을 흘리는 것을 느낀다.
							PRINTFORMDW 그것을 무시하려고 노력한다.
						CASE 4
							PRINTFORMDW 유우겐마간을 안는 것은, 사체가 아니라 마치 그것을 안는 것 같다. 경직된 시신처럼 말이다.
							PRINTFORMDW 적어도 너는 그렇게 가정하고 있다. 실제로 사체를 안아본 적이 없으니까.
							PRINTFORMDW 그리고 네 머릿속에서 도망치라고 비명을 지르는 무언가가 상황을 더 나쁘게 만들고 있다.
					ENDSELECT
				CASE -1
					SELECTCASE K151_YM_NATURE()
						CASE 0
							PRINTFORML 「우리를 먹기 전에 우리에게서 손 치워!」
							PRINTFORMDW 당신은 유겐마간으로부터 재빨리 몸을 뺀다.
						CASE 1
							PRINTFORMDL 너무 심하다. 추위와 그녀의 옷과 피부에서 느껴지는 부자연스러운 감각, 유우겐마간에게 이렇게 가까이 있다는 느낌에서 오는 점점 커져가는 잘못됨...
							PRINTFORMDW 너는 목숨을 걸고 도망치고 싶은 충동을 거부하며 그녀에게서 몸을 뗀다.
							PRINTFORMW 「뭔가 문제라도 있나?」
							PRINTFORMDW 하지만 유우겐마간은 기분 상한 듯 보이지 않는다. 그녀는 평소처럼 아무 표정 없이 응시할 뿐이다.
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
