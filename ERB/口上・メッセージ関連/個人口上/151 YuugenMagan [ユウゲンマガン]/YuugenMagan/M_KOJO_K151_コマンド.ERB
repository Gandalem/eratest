@M_KOJO_MESSAGE_COM_K151_187
CALL M_KOJO_MESSAGE_COM_K151_187_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_187_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:お風呂場プレイ
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;終了
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
