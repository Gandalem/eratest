;==================================================
;121,貝あわせ
;==================================================

@M_KOJO_MESSAGE_COM_K151_121
CALL M_KOJO_MESSAGE_COM_K151_121_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_121_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF FIRSTTIME("YMScissoring")
		SELECTCASE K151_YM_NATURE()
			CASE 0, 1
				PRINTFORMW 「이게 뭐야?」
				PRINTFORMDW 유우겐마간은 당신이 그녀 위로 올라가 %FSYN("vagina")%을 그녀에게 갖다 대자 멍하니 당신을 바라본다.
				PRINTFORMW 「...트리바디즘? 하지만 이건 번식 행위가 아니야.」
				PRINTFORMW 「우리는 단순한 쾌락을 추구하지 않아. 우리는 교미를 원해. 우리의 촉수를 소환하자.」
				PRINTFORMW 「...오? 이 행위를 하면 당신의 체액이 흐르게 되어 촉수 간의 결합과 임신에 도움이 된다는 건가?」
				PRINTFORMW 「그럼 시도해 보자.」
			CASE 2
				PRINTFORMW 「응? 트리바디즘?」
				PRINTFORMDW 유우겐마간은 당신이 그녀 위로 올라가 당신의 %FSYN("vagina")%을 그녀에게 대는 것을 멍하니 응시한다.
				PRINTFORMW 「스트랩온 같은 걸 쓰는 게 더 쉽지 않아? 아니면 내 촉수를 소환할 수도 있는데~」
				PRINTFORMW 「...정말 이걸 하고 싶구나, 응? 좋아, 뭐 해보자...」
		ENDSELECT
	ELSE
		IF ABL:151:腰 >= 5
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW 유우겐마간은 당신의 유두를 빨면서 무관심하게 당신에게 비빈다.
							PRINTFORMW 「이것이 당신에게 즐거운가?」
						CASE 1
							PRINTFORMDW 유우겐마간의 손가락들이 당신의 몸 전체를 어루만지며 그녀는 자신의 %FSYN("vagina")%을 당신에게 비빈다.
							PRINTFORMDW 그녀가 당신의 약점 중 하나를 발견할 때마다, 신음이 당신의 입에서 새어 나온다.
						CASE 2
							PRINTFORMDW 유겐마간이 당신을 희롱한다. 처음에는 가능한 한 빨리 당신에게 몸을 비비다가, 절정에 가까워지면 속도를 다시 늦춘다.
							PRINTFORMDW 우리는 당신이 에너지를 다 써버리길 원치 않는다. 적절한 교미를 위해 일부는 아껴야 한다.
							PRINTFORMDW ...그녀의 얼굴에 아주 희미한 미소가 떠 있는 것을 확신한다.
					ENDSELECT
				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDW 유우겐마간의 뜨거운 숨결이 당신의 얼굴에 느껴진다. 그녀가 당신 위를 걸터앉는다.
							PRINTFORMW 「기분 좋아?」
							PRINTFORMDW 그녀는 그 위에 비비기 시작하기 전에 당신의 가장 민감한 곳을 찾으려고 움직인다.
						CASE 1
							PRINTFORMDW 유우겐마간은 당신의 뺨에 키스하면서 천천히 당신을 괴롭힌다.
							CALL HPH_PRINT, @"「음... 흠뻑 젖었네, 안 그래? 이 더러운 여자 HPH」", "W"
						CASE 2
							PRINTFORMDW 그녀가 당신을 비비자, 유우겐마간은 당신의 가랑이 사이 공간에 손가락을 넣었다가 %FSYN("juice")%로 축축하게 적혀 돌아왔다.
							PRINTFORMDW 그녀는 그것을 입에 넣고 깨끗하게 빨아들였다.
							PRINTFORMW 「음... 누군가 신났네~」
					ENDSELECT
			ENDSELECT
		ELSEIF ABL:151:腰 >=3
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE IFRAND("0TO1", 1, "2", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 0, "3", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
						CASE 0
							PRINTFORMW 「이 자세를 시도해 보자.」
							PRINTFORMDW 유우겐마간은 주위를 어슬렁거리며 다시 너에게 갈리기 시작한다.
						CASE 1
							PRINTFORMDW 유우겐마간은 당신 위에서 몸을 비비며 어색하게 당신의 몸을 쓰다듬는다.
						CASE 2
							PRINTFORMW 「이건... 아! 기분 좋다...」
							PRINTFORMDW 유우겐마간의 목소리가 당신을 비비면서 약간 힘들어하는 듯 들린다.
						CASE 3
							PRINTFORMDW 유우겐마간의 스킬이 그녀의 몸이 얼마나 차가운지 거의 상쇄한다.
							PRINTFORMDW 거의 그렇다.
					ENDSELECT
				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「아... 느끼는 것 같아!」
							PRINTFORMDW 유우겐마간은 너 위에서 갈기며 눈을 빛냈다.
						CASE 1
							PRINTFORMDL 유우겐마간이 당신을 온몸으로 쓸어내리며 비비고 있다.
							PRINTFORMW 「그럼 뭐가 더 기분이 좋아? 내 손이야, 아니면 내 보지야~?」
						CASE 2
							PRINTFORMDW 유우겐마간이 그녀의 %FSYN("vagina")%을 당신의 것과 비비며 당신의 유두를 간지럽힌다.
							PRINTFORML 「어디가 가장 예민해...? 여기? 아니면 아마 여기?」
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「어쩌면 당신의 구멍을 윤활시키기 위해 촉수를 소환해야 할지도 모르겠군요...」
						CASE 1
							PRINTFORMDW 유겐마간은 당신을 짓누르려다가 거의 얼굴로 차려고 한다.
						CASE 2
							PRINTFORMW 「무슨 느낌이라도 있나요? 우리는 없어요.」
					ENDSELECT
				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「어쩌면 이렇게 해보는 건 어때...?」
							PRINTFORMDW 유우겐마간은 맞는 곳을 찾으려고 다시 자리를 바꾼다.
						CASE 1
							PRINTFORMW 「그냥 너를 입으로 해버릴까? 이게 안 되네.」
						CASE 2
							PRINTFORMW 「나 정말 촉수 좀 끌어들여야 한다고 생각해. 이건 안 될 것 같아.」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
