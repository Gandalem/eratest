@M_KOJO_CHECK_K151_SNOWMAN(ARGS,ARG,ARG:1)
#DIM SNOWMAN_TYPE
LOCAL = 30
IF !FA17_OBJ:(ARG % 100)
	SNOWMAN_TYPE = RAND:3
ELSE
	SNOWMAN_TYPE = FA17_TYPE:(ARG % 100)
ENDIF
SELECTCASE RAND:3
	CASE 0
		RESULTS = snow tesseract
		LOCAL = 60
	CASE 1
		RESULTS = snow... something
		RESULTS:1 = that seems to blur the air around it
		LOCAL = 40
	CASE 2
		RESULTS = massive snow eyeball
		RESULTS:1 = that seems to stare into your soul
		LOCAL = 20
ENDSELECT
RETURN LOCAL, SNOWMAN_TYPE
