@K151_CONVERSATION_INTERACTION
;Interactions with other characters present in the same location.
#DIM Character

SIF GET_TARGETNUM() < 2
	RETURN 0
DO
	Character = TARGET:RAND(1, GET_TARGETNUM()+1)
LOOP Character == [[ユウゲンマガン]]

SELECTCASE Character
	;If there's a target character, display their interaction.

    CASE [[霊夢]]
        PRINTFORMW 「Shrine maiden! We demand a rematch under the new rules!」
        PRINTFORMDW Reimu stares blankly at YuugenMagan.
        CALL CHARA_TEXT([[霊夢]],@"「...Who are you again?」","w")
        PRINTFORMW 「You do not remember Us? We are YuugenMagan, the Phantom Evil Eyes.」
        CALL CHARA_TEXT([[霊夢]],@"「...Nope, that doesn't ring a bell. Are you Murasa's sister or something?」","w")
        PRINTFORMDW YuugenMagan looks shocked.
        PRINTFORMW 「We know that We battled you when you were but a child, but have you truly forgotten Us?」
        PRINTFORMDW Reimu rolls her eyes.
        CALL CHARA_TEXT([[霊夢]],@"「I don't even remember everyone I fought in the last incident. I'm not going to remember every two-bit youkai I exterminated decades ago.」","w")
        PRINTFORMW 「Two-bit... youkai?」
        PRINTFORMDW YuugenMagan looks like she's about to cry...

    CASE [[る～こと]]
        PRINTFORMW 「You are alive... and yet, you are not.」
        PRINTFORMW 「How is this so?」
        CALL CHARA_TEXT([[る～こと]],@"「I'm a robot. A living machine built by Yumemi-sama.」","w")
        PRINTFORMW 「Living... machine?」
        PRINTFORMDW YuugenMagan leans forward, studying Ruukoto's face.
        PRINTFORML 「So life does not require a body of carbon...」
        PRINTFORMW 「May we study you further?」
        CALL CHARA_TEXT([[る～こと]],@"「Please don't...」","w")

    CASE [[サニー]]
        CALL CHARA_TEXT([[サニー]],@"（Hehehe... that weirdo's never gonna know what hit her!）","w")

        IF FIRSTTIME("StakingHerLifeOnAPrank")
            SELECTCASE K151_YM_NATURE()
                CASE 0, 2
                    PRINTFORMDW Sunny turns herself invisible, sneaks up behind YuugenMagan, and holds her hand out.
                    PRINTFORMDW A beam of concentrated sunlight emerges from her hand. A few moments later, the hem of YuugenMagan's kimono is on fire.
                    PRINTFORMDW YuugenMagan yells and rolls around on the ground to put the fire out.
                    PRINTFORMW 「W-What the hell was that?!」
                    PRINTFORMDW She looks around frantically, trying to figure out what happened, but Sunny is long gone.
                CASE 1
                    PRINTFORMDW Sunny turns herself invisible, sneaks up behind YuugenMagan... and then YuugenMagan turns her head 180 degrees and stares down at her.
                    PRINTFORMW 「You are aware that We can see you, yes?」
                    CALL CHARA_TEXT(5,@"「Gyah!」","w")
                    PRINTFORMDW You hear Sunny's footsteps as she runs away.
            ENDSELECT
        ELSE
            PRINTFORMDW YuugenMagan glares at Sunny.
            PRINTFORMW 「\@ GROUPMATCH(CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE, 0, 2) ? Prank # Try to prank\@ Us again, child, and your suffering will be legendary, even in Hell.」
            SELECTCASE K151_YM_NATURE()
                CASE 0, 2
                    CALL CHARA_TEXT([[サニー]],@"「Whaddya mean?! I wasn't gonna prank you!」","w")
                    PRINTFORMW 「A likely story.」
                CASE 1
                    CALL CHARA_TEXT([[サニー]],@"「Eep! I-I wasn't gonna prank you, I swear!」","w")
                    PRINTFORMW 「We will hold you to that promise.」
            ENDSELECT
            PRINTFORMDW YuugenMagan folds her arms.
            PRINTFORMW 「We are watching you. Remember that.」
        ENDIF

    CASE [[大妖精]]
        PRINTFORMW 「Daiyousei. The big fairy.」
        PRINTFORMDW YuugenMagan beams at Daiyousei.
        PRINTFORMW 「We have finally found it... a being of matter with a sensible name.」
        PRINTFORMW 「Our name describes what We are... the Phantom Evil Eyes.」
        PRINTFORMW 「But the others? "Reimu" is not a divine revelation received in a dream. "Marisa" is not a reasonable demon of the sand.」
        PRINTFORMW 「How is anyone in this world expected to learn what things are?」
        PRINTFORMDW YuugenMagan turns to stare expectantly at Daiyousei with all seven of her eyes.
        CALL CHARA_TEXT([[大妖精]],@"「Umm...」","w")

    CASE [[レミリア]] ;Remilia
        PRINTFORMW 「They say that you are so charismatic that fate bends to your will.」
        PRINTFORMW 「But We wonder... when you change fate, what happens to the old world?」
        PRINTFORMW 「Is it simply destroyed? Does it continue to exist, inaccessible?」
        PRINTFORMW 「Or is it cast into another realm to be devoured?」
        CALL CHARA_TEXT([[レミリア]],@"「I don't know, and I don't care. Can we talk about something else? You're giving me a headache    .」","w")

    CASE [[にとり]]
        PRINTFORML 「Have you ever considered blending magic with kappa technology?」
        PRINTFORMW 「Perhaps you could create explosives infused with spells that increase their power, or devices that replicate occult rituals through machinery...」
        CALL CHARA_TEXT([[にとり]],@"「Hm...」","w")
        PRINTFORMDW Nitori rubs her chin.
        CALL CHARA_TEXT([[にとり]],@"「I'll think about it. Don't ask any other kappa until I give you an answer, OK?」","w")

    CASE [[妹紅]]
        IF FIRSTTIME("MokouConvo")
            PRINTFORMW 「Your eyes...」
            PRINTFORMDW YuugenMagan narrows her own eyes.
            PRINTFORMW 「You have the eyes of an eternal one. What are you?」
            CALL CHARA_TEXT([[妹紅]],@"「I'm a Hourai immortal.」","w")
            CALL CHARA_TEXT([[妹紅]],@"「I drank the Hourai Elixir, so I can't die. Ever.」","w")
            PRINTFORMW 「This is not your first cycle, is it? How many universes have you seen die and be reborn since the elixir passed your lips?」
            CALL CHARA_TEXT([[妹紅]],@"「None of your damn business. Now get outta my face.」","w")
        ELSE
            CALL CHARA_TEXT([[妹紅]],@"「If you're gonna ask me more weird questions, don't bother. Unless you wanna taste my flames.」","w")
            PRINTFORMDW Mokou conjures up a fireball and glares at YuugenMagan.
        ENDIF

    CASE [[慧音]] ;Keine
        PRINTFORMW 「Is it true that you do not teach any sorcery at your school?」
        CALL CHARA_TEXT([[慧音]],@"「Goodness, no! It's hard enough to keep my students under control already. I'd never be able to teach them anything if they could do magic!」","w")
        PRINTFORMW 「We suppose...」
        PRINTFORMW 「Do you at least teach them how to perform ritual sacrifices?」
        CALL CHARA_TEXT([[慧音]],@"「Why would they need to learn things like that?! Their parents can teach them that on their own time! Or Reimu-san, or Sanae-san!」","w")
        PRINTFORMW 「What kind of temple are you running?! With that kind of "education", your charges will be eaten last when the ones from beyond come!」
        CALL CHARA_TEXT([[慧音]],@"「It's a temple SCHOOL, not a TEMPLE...」","w")

    CASE [[メリー]]
        PRINTFORMW 「Are you from another plane of existence, too?」
        CALL CHARA_TEXT([[メリー]],@"「Umm... I'm from the future, but I don't think that count-」","L")
        PRINTFORMW 「We knew it!」
        PRINTFORMDW All seven of YuugenMagan's eyes light up.
        PRINTFORMW 「You have a name that creatures of matter cannot pronounce!」
        PRINTFORMW 「You know forbidden secrets about the true nature of reality!」
        PRINTFORMW 「You can see *between*, just as We do!」
        PRINTFORMW 「Ah, it is such a relief to finally meet someone normal...」
        PRINTFORMDW Maribel looks increasingly uncomfortable as YuugenMagan continues talking.

    CASE [[ムラサ]]
        PRINTFORMW 「Ah!」
        PRINTFORMDW All seven of YuugenMagan's eyes widen when she sees Murasa's ladle.
        PRINTFORMDW She steps forward and sticks a finger into its bowl. Then her entire hand, then her arm...
        PRINTFORMW 「We have found it! Something that is mot constrained by geometry!」
        PRINTFORMW 「Ah, We never thought We would see something NORMAL in this world...」
        CALL CHARA_TEXT([[ムラサ]],@"「Hey, don't touch that!」","w")
        PRINTFORMDW Murasa snatches her ladle away and glares at YuugenMagan.

    CASE [[芳香]]
        PRINTFORMW 「You are rotting. You should be dead.」
        PRINTFORMW 「Why are you not dead?」
        CALL CHARA_TEXT([[芳香]],@"「I'm a jiangshi!」","w")
        PRINTFORMDW Yoshika grins proudly, exposing her rotten gums.
        CALL CHARA_TEXT([[芳香]],@"「Seiga-sama resurrected me because she needed a servant!」","w")
        PRINTFORMW 「So death is not the end...」
        PRINTFORMDW YuugenMagan stares at Yoshika.
        PRINTFORMW 「What did you see on the other side?」
        CALL CHARA_TEXT([[芳香]],@"「Uhh...」","w")
        PRINTFORMDW Yoshika scratches her head.
        CALL CHARA_TEXT([[芳香]],@"「...I forgooooot!」","w")

    ;NAS Custom code
    CASE 102 ;Shinki
        CALL SHINKI_CharacterConflict(151)

    ;============================

    CASE [[純狐]]
        CALL CHARA_TEXT([[純狐]],@"「You know forbidden sorceries, yes?」","w")
        PRINTFORMW 「We do indeed. Why do you ask?」
        CALL CHARA_TEXT([[純狐]],@"「Do you know any that can kill a Hourai immortal? Permanently?」","w")
        PRINTFORMW 「We know of no ways to do such a thing... but We do know how to inflict such unspeakable pain on an immortal that it would wish it were dead.」
        PRINTFORMDW Junko grins savagely.
        CALL CHARA_TEXT([[純狐]],@"「Good enough.」","w")

    CASE [[袿姫]]
        PRINTFORMW 「Tell us your secrets.」
        PRINTFORMW 「Your idols are not alive, and then they are. How is that change brought about?」
        CALL CHARA_TEXT([[袿姫]],@"「I... don't really know...」","w")
        PRINTFORMDW Keiki looks a little embarrassed.
        CALL CHARA_TEXT([[袿姫]],@"「I just place my hands on them and concentrate. Then I feel this energy flow through me and into the idol... and they come to life.」","w")
        PRINTFORMW 「So you do not know the secrets of life either...」
        PRINTFORMW 「Do you know who might? Who was your creator?」
        CALL CHARA_TEXT([[袿姫]],@"「Um...」","w")
        PRINTFORMDW Keiki looks really embarrassed now.

    CASE [[早鬼]]
        PRINTFORMW 「You are a horse, and a bird... yet you are neither.」
        PRINTFORMW 「What are you?」
        CALL CHARA_TEXT([[早鬼]],@"「\"What are you\"?!」","w")
        PRINTFORMDW Saki glares at YuugenMagan.
        CALL CHARA_TEXT([[早鬼]],@"「What kind of question is that?! Are you trying to pick a fight with me?!」","w")
        SELECTCASE K151_YM_NATURE()
            CASE 0
                PRINTFORMW 「N-Not at all!」
                PRINTFORMW 「I s-simply wished to know how a mighty creature like you came into existence...」
                CALL CHARA_TEXT([[早鬼]],@"「Mighty, eh? So you do have some manners...」","w")
                PRINTFORMDW Saki grins.
                CALL CHARA_TEXT([[早鬼]],@"「I'm a kurokoma, a flying horse. I'm not the only one, but I'm for sure the strongest one.」","w")
                PRINTFORMW 「I- er, We see. We are very impressed...」
                PRINTFORMDW Weird. YuugenMagan looks almost afraid...
            CASE 1
                PRINTFORMW 「Not at all. We simply wished to know how one such as you came into existence.」
                PRINTFORMW 「We are fascinated by life, and We wish to know its secrets. And you are truly a fascinating being...」
                PRINTFORMDW Saki snorts.
                CALL CHARA_TEXT([[早鬼]],@"「That's a waste of time if you ask me. I dunno what life is... all I know is that I'm alive, and I plan on living each day to the fullest!」","w")
                PRINTFORMDW She grins and flexes.
                PRINTFORMW 「A noble sentiment.」
                PRINTFORMW 「For Our part, We will continue prying into these mysteries. Do you know of one who might be able to help?」
                CALL CHARA_TEXT([[早鬼]],@"「Mmm... Prince Shotoku, maybe? She's the smartest person I know.」","w")
                IF CFLAG:[[ユウゲンマガン]]:K151EN_YM_MIKO
                    PRINTFORMW 「We have already spoken, but she told Us that such a question was useless.」
                    PRINTFORMDW Saki snorts again.
                    CALL CHARA_TEXT([[早鬼]],@"「Maybe you should listen to her, then.」","w")
                ENDIF
        ENDSELECT

    CASE [[ミケ]]
        PRINTFORMW 「Is it true that your people can manipulate fate itself?」
        CALL CHARA_TEXT([[ミケ]],@"「Kinda...」","w")
        CALL CHARA_TEXT([[ミケ]],@"「We can attract customers and money, if that's what you mean.」","w")
        PRINTFORMW 「How odd. We will never quite comprehend existing as a being within time.」
        PRINTFORMW 「*Below*, all times are one. We can see what has happened and what will happen just as clearly as we can see you.」
        CALL CHARA_TEXT([[ミケ]],@"「Really? Weeelll...」","w")
        PRINTFORMDW With a flourish, Mike pulls out a pack of ability cards.
        CALL CHARA_TEXT([[ミケ]],@"「If you're concerned about the future, why not buy some cards? You'll br able to blast all your troubles away!」","w")
        CALL CHARA_TEXT([[ミケ]],@"「And since it's your first time, I'll throw in a holographic card of yours truly for the low, low price of free!」","w")
        PRINTFORMDW YuugenMagan cocks her head to the side.
        PRINTFORMW 「What is "buy"?」
        CALL CHARA_TEXT([[ミケ]],@"「Hoo boy...」","w")
        PRINTFORMW 「」
        PRINTFORMDW Mike sighs.
        CALL CHARA_TEXT([[ミケ]],@"「Okay, so, some people have things that other people want...」","w")

    CASE [[サラ]]
        PRINTFORMW 「Sara, you are but a creature of three dimensions. How are you to guard Makai from beings that can move in more than three?」
        PRINTFORMDW Sara shrugs.
        CALL CHARA_TEXT([[サラ]],@"「That's not in my contract. And if Shinki-san doesn't think they're worth worrying about, then neither do I.」","w")

    ; CASE CHARANUM-1 ;Mob Girl

    CASEELSE
			;If there's no target character, abort so that another topic can be picked.
        RETURN 0
ENDSELECT
WAIT
RETURN 1