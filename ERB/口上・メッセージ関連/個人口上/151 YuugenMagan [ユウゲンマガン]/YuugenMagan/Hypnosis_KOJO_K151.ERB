; Modular ERB: 個人口上/151 YuugenMagan [ユウゲンマガン]/YuugenMagan/Hypnosis_KOJO_K151.ERB
;==================================================
;催眠口上
;XX　　　　　　Chara ID
;ARG　　　　　Hypnosis Type
;ARG:1　　　Hypnosis Result
;==================================================

@M_KOJO_EVENT_K151_666(ARG, ARG:1)
;口上主はTARGET
;ARGは催眠タイプ（0催眠キャンセル、1反発抑制、2合意誤認、3発情抑制/発情促進、4常識改変）
;ARG:1は催眠結果（-3大失敗、-2大失敗、-1失敗、0キャンセル、1成功、2大成功、3大成功）
;臨時素質（TALENT:反発抑制、TALENT:合意誤認、TCVAR:Common_Sense_Alteration_Status）
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF 顔絵付きメッセージ && ARG != 0 && ARG:1 > 0
		PRINTL 
	;催眠タイプ
	SELECTCASE ARG
		;催眠キャンセル　　Hypnosis Cancel
		CASE 0
			;催眠結果　　必ず0である　　そして記入を推奨しない
			;反発抑制　　Resistance Weakened
		CASE 1
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					;成功　　Success
				CASE 1, 2
					SELECTCASE K151_YM_NATURE()
						CASE 0
						CASE 1
						CASE 2
						CASE 3
					ENDSELECT
				CASE 3
					SELECTCASE K151_YM_NATURE()
						CASE 0
						CASE 1
						CASE 2
						CASE 3
					ENDSELECT
			ENDSELECT
			;合意誤認　　Make Sex Acceptable
		CASE 2
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「우리는 그렇게 생각하지 않는다.」
						CASE 1
							PRINTFORMW 「우리가 당신과 동침하기를 원했다면, 이미 그렇게 하고 있었을 것이다.」
						CASE 2
							PRINTFORMW 「우리의 정신은 당신들과 같지 않다. 우리의 시간을 낭비하지 마라.」
					ENDSELECT
					;成功　　Success
				CASE 1, 2
					SELECTCASE K151_YM_NATURE()
						CASE 0
							PRINTFORMW 「I...」
							PRINTFORMDW 유우겐마간은 입술을 깨물었다.
							IF THINKS_IS_VIRGIN([[ユウゲンマガン]])
								PRINTFORMW (나는 언제나 섹스가 어떤 느낌인지 알고 싶었다. 하지만 아무도 나에게 관심이 없었다.)
								PRINTFORMW (특히 지금은 더욱 그렇다.)
								PRINTFORMW (하지만 %HE_SHE(MASTER)%은 그래준다. 이건 내가 얻을 수 있는 첫 번째 기회다. 그리고 아마 영원히 다시는 없을 것이다.)
								PRINTFORMW (내가 정말 이걸 놓치게 둘까?)
							ELSE
								PRINTFORMW (마지막으로 사랑을 나눈 게 너무 오래됐어.)
								PRINTFORMW (그리고 그 상대가 매춘부였지. 이건 안 돼.)
							ENDIF
							SIF HAS_PENIS(MASTER)
								PRINTFORMW (게다가, 나는 내 약이 있어. 임신하지 않을 거야.)
							PRINTFORMDW 유우겐마간은 앞으로 몸을 기울이고 당신의 눈을 응시한다.
							PRINTFORMW 「당신. 우리 함께 하자. 별들이 제자리에 있어.」
						CASE 1
							PRINTFORMW 「We...」
							PRINTFORMDW 유우겐마간은 입술을 깨물었다.
							PRINTFORMW 「이것은 무슨 감정일까? 이 욕정인가?」
							PRINTFORMW 「단지 이 육체가 반응하는 것일까, 아니면... %HE_SHE(MASTER)%이 그 존재일지도?」
							PRINTFORMW 「분명 %HE_SHE(MASTER)%가 \@ HAS_PENIS(MASTER) ? 아버지가 # 낳을 수 없다 해도, %HIM_HER(MASTER)%와 교미하는 것이 해롭지는 않을 것이다.」 \@
							PRINTFORMW (그렇다면 우리는 그저 %HIM_HER(MASTER)%를 삼킬 뿐이다.)
							PRINTFORMW 유우겐마간은 앞으로 몸을 숙이고 당신의 눈을 응시했다.
							PRINTFORMDW 당신은 어지러움을 느끼기 시작했다.
							PRINTFORMW 「당신. 우리 교미하자. 별들이 옳다.」
							PRINTFORMDW 그녀는 농담하는 것이 아니었다. 그녀의 눈 속에서 별들을 볼 수 있었다. 온 은하들까지도.
							PRINTFORMDW 그리고 무언가가 움직이고 있었다. 병적으로 적갈색인 무언가.
							PRINTFORMDW 머리가 몽롱해졌다. 귀가 울렸다.
							PRINTFORMDW 아니... 그것은 귀에서 울리는 소리가 아니다. 다른 무언가다.
							PRINTFORMDW 음악인가?
							PRINTFORMDW 당신은 더 잘 보기 위해 몸을 앞으로 숙였다-
							PRINTFORMDW Ow!
							PRINTFORMDW 당신은 뒤로 물러서며 머리를 문지른다.
							PRINTFORMDW 이 여자 주변에서는 조심해야 할 것이다. 그녀가 거의 당신을 최면 걸 뻔했으니까...
						CASE 2
						CASE 3
					ENDSELECT
				CASE 3
					SELECTCASE K151_YM_NATURE()
						CASE 0
							PRINTFORMW 「야.」
							PRINTFORMDW 당신은 유우겐마간을 응시한다. 뭔가 이상하다.
							PRINTFORMDW 아니... 그게 맞는 단어가 아니다. 오히려 이상함의 부재에 가깝다.
							PRINTFORMDW 유우겐마간 주변의 이계적인 오라가 사라졌다. 지금 그녀는 평범하지 않은 소녀이긴 하지만, 평소보다 더 평범해 보인다.
							PRINTFORMDL 말로 표현하기 어렵지만, 너 근처에서 느끼던 그 미묘하게 기묘한 느낌과 같은 것 같다.
							PRINTFORMW 「야!」
							PRINTFORMDW 유우겐마간이 당신의 얼굴 앞에서 손가락을 탁 친다. 당신은 움찔한다.
							PRINTFORMW 「우리 섹스할 거야, 안 할 거야?」
							PRINTFORMDW 그녀는 팔짱을 낀다.
							PRINTFORMDW 이 여자에게 뭔가 문제가 있다. 그리고 그녀에게서 느껴지는 평소의 종류의 이상함과는 다르다.
							PRINTFORMW 「아, 제발 계속 쳐다보지 말고 대답해!」
							PRINTFORMDW 그녀가 당신을 노려보고 있다. 당신은 자신도 모르게 고개를 끄덕인다.
							PRINTFORMW 「좋아.」
							PRINTFORMDW 유우겐마간이 당신에게 미소를 짓는다.
							PRINTFORMW 「자, 이제 가자. 나한테 하루 다 있는 건 아닌 거 알잖아.」
							PRINTFORMDW 어쩌면 이건 좋은 생각이 아닐지도 모른다. "미친 여자에게 네 것을 넣지 마라"는 말은 없었나?
						CASE 1
							PRINTFORMDW 유우겐마간이 당신을 응시한다. 그러고는, 당신이 반응하기도 전에 무언가 미끈거리는 것이 팔과 다리를 휘감아 바닥으로 끌어당긴다.
							PRINTFORMDW 당신은 허둥지둥 주변을 둘러보고 발견한다...
							PRINTFORMDW 촉수들이다. 땅에서 자라나 팔다리를 묶고 있는 검푸른 보랏빛의 네 개의 촉수가 있다.
							PRINTFORMDW 유우겐마간이 당신 위로 올라탄다. 그녀는 이미 옷을 벗기 시작했다.
							PRINTFORMW 「우리는 교미 중이다.」
							PRINTFORMDW 그녀는 날씨 이야기를 하듯 담담하게 말한다.
							PRINTFORMDW 무언가가 당신에게 이 문제에 선택권이 없다는 것을 알려준다.
							CFLAG:151:溜まってる度 = 1000
							CFLAG:MASTER:うふふ = 2
							CFLAG:151:うふふ = 2
							IF !UFUFU_START_TIME
								UFUFU_START_TIME = TIME
								UFUFU_START_DAY = DAY
							ENDIF
							; CFLAG:151:LAST_SEX_DAY = DAY
							TFLAG:102 = 3
							TFLAG:抱きつきモード = 0
							TFLAG:押し倒され開始時間 = TIME + DAY * 1440
							TFLAG:COMABLE管理 = 3
							TCVAR:好きにして = 1
							CFLAG:ヤラせちゃった = 1
							TCVAR:馴れ合い = 3
							TCVAR:PLAYER:馴れ合い = 3
							RETURN 99
						CASE 2
						CASE 3
					ENDSELECT
			ENDSELECT
			;発情抑制/発情促進　　Estrus Control
		CASE 3
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2, 3
					PRINTFORML 
			ENDSELECT
			;常識改変　　Common-Sense Control
		CASE 4
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
