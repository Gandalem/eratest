; Modular ERB: 個人口上/151 YuugenMagan [ユウゲンマガン]/YuugenMagan/M_KOJO_K151_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K151_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF FIRSTTIME("YMDanmaku")
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					PRINTFORMW 「우리에게 단마쿠 대결을 신청하고 싶으신 건가?」
					PRINTFORMDW 유겐마간은 기묘한 웃음을 터뜨리며 웃는다.
					PRINTFORMW 「우리는 받아들이겠다... 하지만 우리의 마지막 전투는 오랜만이다. 예전 실력을 되찾기 위해 시간이 좀 필요할지도 모른다.」
					PRINTFORMW 「자신감 있는 사람이 바로 너라는 거겠지, 응?」
					PRINTFORMDW ...뭐라고?
					PRINTFORMDW \@ HAS_PENIS(MASTER) ? 네가 자신감이 있다는 건 사실이지만... 왜 # 왜 \@ 그녀는 단마쿠 대결 직전에 네 성적인 부분에 대해 묻는 거지?
					PRINTFORMDW 아니면 그녀는 네가 겁쟁이라고 암시하는 걸까?
					PRINTFORMW 「그것들을 꺼내지 않을 거니?」
					PRINTFORMDW 당신은 최대한 조심스럽게 그녀가 무슨 말을 하는지 묻는다.
					PRINTFORMW 「단마쿠 대결은 그런 식으로 진행되는 게 아닌가?」
					PRINTFORMW 「우리는 우리의 단마쿠로 너를 맞추려 하고, 너는 우리나 우리의 단마쿠에 맞지 않으면서 네 것으로 우리를 맞추려고 노력한다.」
					PRINTFORMW 「그게 아주 오래전 신사 마이드를 상대로 전투를 벌이던 방식이었다.」
					IF IS_FEMALE(1) && CFLAG:1:既成事実 & 合意_うふふ
						PRINTFORMDW 좋아, 그녀는 확실히 고환에 대해 말하는 게 아니야. 너도 레이무한테 그런 거 없다는 거 알잖아.
					ELSE
						PRINTFORMDW 레이무가 봉인 카드 규칙 이전에 사건을 해결했던 게 정말 이런 방식이었던 건가?!
					ENDIF
					PRINTFORMDW 당신은 단막 대결이 이제 다르다고 설명하며, 스펠 카드 규칙에 대해 간략하게 설명한다.
					PRINTFORMW 「아, 그러니까 예전 방식과 비슷하네... 하지만 단마쿠도 사용하는구나. 알겠다, 알겠어.」
					PRINTFORMW 「좋다, 그럼. 싸우도록 하지.」
				CASE 2
					PRINTFORMW 「단마쿠라니, 후후?」
					PRINTFORMW 「물론이지, 재미있을 것 같아! 하지만, 음... 너무 심하게는 하지 말아줘, 알겠지? 수십 년 만에 대결해 보는 거라...」
					PRINTFORMDW 유겐마간이 당신을 응시한다. 그녀는 무언가를 기다리는 듯하다.
					PRINTFORMW 「네 고추 꺼낼 생각 없어?」
					PRINTFORMDW ...뭐라고?
					PRINTFORMDW \@ HAS_PENIS(MASTER) ? 네가 공을 가지고 있다는 건 사실이지만... 왜 # 왜 \@ 그녀는 단마쿠 대결 직전에 네 성기를 물어보는 거지?
					PRINTFORMDW 당신은 최대한 조심스럽게 그녀가 무슨 말을 하는지 묻는다.
					PRINTFORMW 「응?」
					PRINTFORMW 「단마쿠 대결이 그렇게 진행되는 거 아니야? 내가 단마쿠로 너를 맞히려고 하고, 너는 네 공으로 나를 때리면서 스스로 피해 보지 않으려고 노력하는 거지.」
					PRINTFORMW 「그게 예전 레이무랑 내가 싸우던 방식이었어.」
					IF IS_FEMALE(1) && CFLAG:1:既成事実 & 合意_うふふ
						PRINTFORMDW 좋아, 그녀는 확실히 고환에 대해 말하는 게 아니야. 너도 레이무한테 그런 거 없다는 거 알잖아.
					ELSE
						PRINTFORMDW 레이무가 봉인 카드 규칙 이전에 사건을 해결했던 게 정말 이런 방식이었던 건가?!
					ENDIF
					PRINTFORMDW 당신은 단막 대결이 이제 다르다고 설명하며, 스펠 카드 규칙을 간략하게 정리해 준다.
					PRINTFORMW 「아, 알겠어. 그럼 우리 둘 다 단막을 쓰는 거네... 이해했어.」
					PRINTFORMW 「좋아, 그럼. 준비됐어?」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't apply if the character's handicap is 0)
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	RESETCOLOR
	RESETCOLOR
ENDIF
RETURN 1
