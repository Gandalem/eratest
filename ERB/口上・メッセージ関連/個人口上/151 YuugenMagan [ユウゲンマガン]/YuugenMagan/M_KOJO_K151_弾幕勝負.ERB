@M_KOJO_MESSAGE_COM_K151_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF FIRSTTIME("YMDanmaku")
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					PRINTFORMW 「You wish to challenge Us to a Danmaku duel?」
					PRINTFORMDW YuugenMagan laughs her odd bark of a laugh.
					PRINTFORMW 「We accept... but it has been many years since Our last battle. We may need some time to regain Our old skill.」
					PRINTFORMW 「You are the one with balls, yes?」
					PRINTFORMDW ...What?
					PRINTFORMDW \@ HAS_PENIS(MASTER) ? It's true that you have balls, but... why # Why\@ is she asking about your genitals right before a Danmaku match?
					PRINTFORMDW Or is she implying you're a coward?
					PRINTFORMW 「Are you not going to take them out?」
					PRINTFORMDW You ask as delicately as you can what she's talking about.
					PRINTFORMW 「That is how Danmaku matches work, is it not?」
					PRINTFORMW 「We attempt to hit you with Our Danmaku, and you attempt to hit us with your balls without getting hit by either them or Our Danmaku.」
					PRINTFORMW 「That was how we engaged in battle against the shrine maiden all those years ago.」
					IF IS_FEMALE(1) && CFLAG:1:既成事実 & 合意_うふふ
						PRINTFORMDW Okay, she's definitely not talking about testicles. You know Reimu doesn't have any.
					ELSE
						PRINTFORMDW Was that really how Reimu resolved incidents before the Spell Card Rules?!
					ENDIF
					PRINTFORMDW You explain that Danmaku duels are different now, and give a quick rundown of the Spell Card Rules.
					PRINTFORMW 「Ah, so it is similar to the old ways... but you fire Danmaku as well. We see, We see.」
					PRINTFORMW 「Very well, then. Let us do battle.」
				CASE 2
					PRINTFORMW 「Danmaku, huh?」
					PRINTFORMW 「Sure, that sounds fun! But, um... go easy on me, okay? I haven't had a match in decades...」
					PRINTFORMDW YuugenMagan stares at you. She seems to be waiting for something.
					PRINTFORMW 「Aren't you gonna take your balls out?」
					PRINTFORMDW ...What?
					PRINTFORMDW \@ HAS_PENIS(MASTER) ? It's true that you have balls, but... why # Why\@ is she asking about your genitals right before a Danmaku match?
					PRINTFORMDW You ask as delicately as you can what she's talking about.
					PRINTFORMW 「Huh?」
					PRINTFORMW 「Isn't that how Danmaku matches work? I try to hit you with my Danmaku, and you try to hit me with your balls without getting hit yourself.」
					PRINTFORMW 「That was how Reimu and I fought all those years ago.」
					IF IS_FEMALE(1) && CFLAG:1:既成事実 & 合意_うふふ
						PRINTFORMDW Okay, she's definitely not talking about testicles. You know Reimu doesn't have any.
					ELSE
						PRINTFORMDW Was that really how Reimu resolved incidents before the Spell Card Rules?!
					ENDIF
					PRINTFORMDW You explain that Danmaku duels are different now, and give a quick rundown of the Spell Card Rules.
					PRINTFORMW 「Oh, okay. So now both of us use Danmaku... got it.」
					PRINTFORMW 「All right, then. You ready?」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't apply if the character's handicap is 0)
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"


	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"


	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"


	ENDIF


	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	RESETCOLOR
	RESETCOLOR
ENDIF
RETURN 1

