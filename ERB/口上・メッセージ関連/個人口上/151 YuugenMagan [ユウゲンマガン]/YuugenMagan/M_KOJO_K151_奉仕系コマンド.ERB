;80,手淫
;==================================================

@M_KOJO_SUCCESS_COM_K151_80
IF CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1 && TCVAR:PLAYER:イきそう && !NOWEX:PLAYER:射精 && EXP:[[ユウゲンマガン]]:手淫経験 > 20
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「너 벌써 절정에 다 왔구나.」
			PRINTFORMW 「네 정액은 내 손이 아닌 나의 자궁에 있어야 해.」
		CASE 1
			PRINTFORMW 「내 자궁에 사정해라.」
		CASE 2
			PRINTFORMW 「당신의 씨를 품고 싶습니다. 손으로 사정하는 것은 역효과일 겁니다.」
	ENDSELECT
	RETURN 0
ENDIF

@M_KOJO_MESSAGE_COM_K151_80
CALL M_KOJO_MESSAGE_COM_K151_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K151_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[ユウゲンマガン]])
		IF FIRSTTIME("YuugenMaganHandjob")
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					PRINTFORMW 「무엇을 받고 싶다고?」
					PRINTFORMDW 유우겐마간은 혼란스럽게 고개를 기울인다.
					PRINTFORMW 「우리 손으로 당신의 성기를 문질러 주라는 거야? 하지만 너희 종족은 그렇게 교미하지 않는데...」
					PRINTFORMW 「비생식적인 교미라고?! 우리가 실수로 너희를 미치게 만든 건가?!」
					PRINTFORMW 「우리는 당신에게 쾌감을 주기 위해 온 게 아니야! 우리는 당신이 우리의 별의 아이를 낳을 수 있도록 오게 된 거야!」
					PRINTFORMDW 쉽지는 않았지만, 당신은 유우겐마간을 설득해 %FSYN("penis")%을 자위하다가 사정 직전까지 이르게 했다.
					PRINTFORMDW 완전히 발기하면 "진짜" 교미로 전환할 것이다.
					PRINTFORMW 「사정하지 않도록 조심해라.」
					PRINTFORMDW 유우겐마간은 당신의 %FSYN("penis")%을 쓰다듬으며 강철 같은 눈빛으로 당신을 응시했다.
					PRINTFORMW 「네 정액을 낭비해서는 안 된다, 그렇지 않으면 우리는 불쾌할 것이다.」
				CASE 2
					PRINTFORMW 「수음이구나...」
					PRINTFORMDW 유우겐마간은 당신의 %FSYN("penis")%을 잡고 엄지손가락으로 문지른다.
					PRINTFORMW 「그런 건 한 번도 해본 적 없는데... 하지만 그렇게 어렵지는 않겠지, 그렇지?」
					PRINTFORMW 「내가 할 일은 네가 사정할 때까지 쓰다듬어 주는 것뿐이야.」
			ENDSELECT
		ELSE
			SELECTCASE K151_YM_NATURE()
				CASE 0, 1
					IF ABL:TARGET:指 >= 5
						SELECTCASE IFRAND("0TO3", 1, "4TO5", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
							CASE 0
								PRINTFORMDL 유우겐마간은 당신의 샤프트를 오르가슴 직전까지 능숙하게 자극한다... 그러고는 멈춘다.
								PRINTFORMDW 발기력이 풀리기 시작하면, 그녀는 다시 당신을 쓰다듬기 시작한다.
								PRINTFORML 「기억해라... 나의 자궁 안에서만 사정하는 것이 허락되었다.」
								PRINTFORMDW 그녀는 악마 같은 뒤집힌 미소를 짓는다.
							CASE 2
								PRINTFORMW 「아프지 않느냐? 오르가즘을 갈망하면서도, 그것에 도달할 수 없구나...」
								PRINTFORMDW 그녀는 마치 웃는 듯한 기이한 짖음을 내뱉었다.
							CASE 3
								PRINTFORMDW 유우겐마간이 무언가를 속삭이며, \@ CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1 ? 당신은 %HE_SHE([[ユウゲンマガン]])%의 당신의 %FSYN("penis")%를 쓰다듬을 때 기분 좋은 짜릿함을 느끼고 # 느껴지는 쾌감이 너무 커서 거의 아플 정도이다 \@.
								PRINTFORMDW %HE_SHE([[ユウゲンマガン]],1)%이 이상한 거꾸로 된 미소인 %HIS_HER([[ユウゲンマガン]])%을 짓는다.
								PRINTFORMW 「그것이 마음에 드나요? 우리가 당신에게 사정을 원하지 않더라도, 우리는 당신의 경험을 즐거운 것으로 만드는 것에 아무런 이유를 보지 못하니까.」
							CASE 4
								PRINTFORMDL 유우겐마간의 수음은 차갑고 어색하며 임상적이던 것에서 부드럽고 능숙하며 관능적인 것으로 변했다.
								PRINTFORMDW 그녀는 당신의 %FSYN("penis")%을 거칠게 주무르는 대신, 너무 조이지도 않고 너무 느슨하지도 않은 단단한 그립으로 위아래로 쓸어내린다.
								PRINTFORMDW 그녀의 인간 같지 않은 눈이 당신과 마주하고, 당신은 그 안에 욕정의 기색을 볼 수 있다.
								PRINTFORML 「빨리 발기해라.」
								PRINTFORMW 「우리는 네가 우리 안에 들어오길 원해...」
							CASE 5
								PRINTFORMDL 유우겐마간은 손을 내밀어 그것에 전기를 주입했다.
								PRINTFORMDW 그녀는 손가락 끝으로 당신의 성기에 닿는다. 당신의 %FSYN("penis")%이 뻣뻣해지면서 기분 좋은 짜릿함이 피부 전체로 퍼진다.
								PRINTFORMW 「아... 그게 비밀이었구나.」
								PRINTFORMDW %HE_SHE([[ユウゲンマガン]],1)%는 전기로 충전된 손으로 당신의 성기를 계속 쓰다듬는다.
								PRINTFORMDW 그것은 수음과 누군가 당신의 %FSYN("crotch")%에 전기 마사지기를 사용하는 것 사이의 느낌이다.
						ENDSELECT
					ELSEIF ABL:TARGET:指 >= 3
						SELECTCASE IFRAND("0TO5", 1, "6TO7", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
							CASE 0
								PRINTFORMW 「우리 종족은... 이런 일을 하지 않아.」
								PRINTFORMW 「말해봐, 어떻게 네 성기를 즐겁게 할 수 있지?」
								PRINTFORMDW 유우겐마간은 당신이 설명하는 것을 주의 깊게 듣는다.
								PRINTFORMW 「천천히 시작해서 속도를 높여... 너무 세게 잡지 마... 페니스의 아랫부분에 집중해...」
								PRINTFORMDW 그녀는 이번에는 더 자신감을 가지고 당신의 %FSYN("penis")%을 다시 쓰기 시작한다.
							CASE 1
								PRINTFORMW 「우리에게 ... 스스로 만져줄 수 있나요?」
								PRINTFORMW 「당신이 어떻게 스스로 기쁨을 느끼는지 안다면, 우리는 당신을 더 효과적으로 만족시킬 수 있을 거예요.」
								PRINTFORMDW 당신은 등을 대고 누워 유우겐마간이 주의 깊게 지켜보는 가운데 스스로를 어루만졌다.
								PRINTFORMW 「아... 그런 식으로 하는 거군요.」
								PRINTFORMDW 그녀는 당신이 했던 것을 따라 하려고 다시 당신의 %FSYN("penis")%을 만지기 시작했다.
							CASE 2
								PRINTFORMW 「이거 기분 좋아?」
								PRINTFORMDW 유우겐마간은 당신의 피드백에 맞춰 그녀의 기교와 속도를 조절한다.
							CASE 3
								PRINTFORMW 「가장 즐거운 느낌은 어디에서 느껴지나요?」
								PRINTFORMW 「이 세계의 시간은 점점 짧아지고 있어요. 너무 늦기 전에 발기를 이루시길 바랍니다.」
							CASE 4
								PRINTFORMW 「아. 오. 응. 너무 기분이 좋아. 우리 손을 망쳐버리네.」
								PRINTFORMDW 유우겐마간은 당신의 %FSYN("penis")%를 쓰면서 들어본 적 없는 가장 설득력 없는 신음을 흘린다.
							CASE 5
								PRINTFORMW 「서둘러라. 우리는 네가 우리 안에 있기를 원한다.」
								PRINTFORMDW 유우겐마간은 당신의 %FSYN("penis")%을 더 빠르고 거칠게 쓰다듬는다.
								PRINTFORMDW 그녀의 얼굴은 언제나처럼 무표정하게 남아있다.
							CASE 6
								PRINTFORMW 「당신의 쾌감을 증진시킬 마법을 알았더라면 좋았을 텐데...」
								PRINTFORMDW 유우겐마간은 눈을 가늘게 뜨고 차가운 손으로 당신의 %FSYN("penis")%을 자극하는 데 집중한다.
							CASE 7
								PRINTFORMDW 유우겐마간은 당신의 %FSYN("penis")%을 쓰다듬으며 그 머리를 핥는다.
								PRINTFORMDW 그녀의 입은 몸의 나머지 부분처럼 차갑고, 그녀의 혀는 나무 조각처럼 단단하고 거칠었다.
						ENDSELECT
					ELSE
						SELECTCASE IFRAND("0TO5", 1, "6TO7", CFLAG:[[ユウゲンマガン]]:K151EN_YM_NATURE == 1)
							CASE 0
								PRINTFORMW 「왜 아직 발기하지 않은 거야? 우리가 뭘 잘못하고 있는 거지?」
								PRINTFORMDW 유우겐마간은 당신이 가장 좋아하는 조합을 찾으려고 다양한 속도와 압력으로 실험한다.
							CASE 1
								PRINTFORMW 「이것은 우리가 예상했던 것보다 더 어렵다.」
								PRINTFORMW 「너의 비밀을 말해라. 어떻게 우리의 손으로 너를 발기시킬 수 있단 말이냐?」
							CASE 2
								PRINTFORMW 「이거 재미없니?」
								PRINTFORMDW 유우겐마간은 실망한 듯하다.
							CASE 3
								PRINTFORMDW 유우겐마간은 마치 소를 짜듯이 당신의 성기를 어색하게 위아래로 움직인다.
								PRINTFORMW 「왜 아직 발기하지 못했지? 빨리 해줘서 우리가 아이를 가질 수 있게 해야 하니까.」
							CASE 4
								PRINTFORMDW 유우겐마간은 당신의 %FSYN("penis")%을 거의 부술 정도로 꽉 쥐었다가 아무것도 느낄 수 없을 정도로 힘없이 잡았다가 번갈아 행동한다.
							CASE 5
								PRINTFORMW 「이게 정말 필요할까요? 이 몸만으로도 당신이 자극을 받을 만큼 충분히 아름답지 않나요?」
								PRINTFORMDW 유우겐마간은 어색하게 당신의 %FSYN("penis")%을 쓸어내리며 투덜거렸다...
							CASE 6
								PRINTFORML 「우리 몸이 너무 추운 걸까?」
								PRINTFORMW 「어쩌면 우리 자신을 불태워야 할지도 몰라.」
							CASE 7
								PRINTFORMDW 유우겐마간의 얼음처럼 차가운 손이 당신의 %FSYN("penis")%에 닿는 느낌은 발기를 유지하는 것을 불가능하게 만든다.
								BASE:MASTER:勃起 = 0
						ENDSELECT
					ENDIF
				CASE 2
					IF ABL:TARGET:指 >= 5
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 
							CASE 1
								PRINTFORML 
							CASE 2
								PRINTFORML 
						ENDSELECT
					ELSEIF ABL:TARGET:指 >= 3
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 
							CASE 1
								PRINTFORML 
							CASE 2
								PRINTFORML 
						ENDSELECT
					ELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 
							CASE 1
								PRINTFORML 
							CASE 2
								PRINTFORML 
						ENDSELECT
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
