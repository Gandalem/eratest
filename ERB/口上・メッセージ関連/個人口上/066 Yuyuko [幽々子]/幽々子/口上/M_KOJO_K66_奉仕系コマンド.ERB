@M_KOJO_MESSAGE_COM_K66_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「그럼~…… 잘 먹겠습니다~ 응읏%UNICODE(0x2665) *1%」
		PRINTFORMDW 유유코 님은 싱글벙글 웃으며 당신의 성기를 사랑스럽게 쓰다듬은 후, 세차게 물어뜯는다.
		PRINTFORMDW 너무 잘 받아먹어서 정말 삼아버린 줄 알았지만……
		PRINTFORMW 「음후훗…… 츄릅…… 응읏…… 후훗%UNICODE(0x2665) *1%」
		PRINTFORMDW 그 외에도 유유코는 맛있게 핥고 있었다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「라히효우하호(쌀 것 같아?)~%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"가")% 사정하려는 것을 느끼자, 확인하듯 말을 걸며 당신에게 더욱 큰 쾌락을 선사한다.
			PRINTFORMW 「츄릅, 쭈욱……%UNICODE(0x2665) *1%응후훗, 헨냐하호~(이상한 얼굴~)앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭈루륵… 음! 움찔하며 따뜻해, %UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 당신의 성기를 입에 물고 얼굴을 비비며 당신의 사정을 유도한다.
			PRINTFORMW 「톡... 톡톡%UNICODE(0x2665) *1% 참지 말고 내보내면 기분 좋을 거야~?」
		ELSE
			PRINTFORMW 「……츄읍……츄읍……%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 일부러 희미한 쾌감만을 주려는 듯 버드키스를 계속한다.
			PRINTFORMW 「……무슨 일이야~ 후후훗 귀여워~읏%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMW 「응…… 냠냠~ %UNICODE(0x2665) *1% 음~ 짜고 진한 살 맛이라 맛있어~ %UNICODE(0x2665) *1% 큭흐흡후훗 변♪」
			PRINTFORMW 「응……앗 %UNICODE(0x2665) *1% 흐읍 이제 못 하겠어~…… 이거 없으면 살 수 없어…… %UNICODE(0x2665) *1%」
			PRINTFORMDW 당신의 성기 맛을 마음껏 즐기며 계속 자위를 하는 유유코는 행복해 보이는 표정을 짓는다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 「츄릅~%UNICODE(0x2665) *1% 퐁! ……응……%UNICODE(0x2665) *1% 후훗, 응, 츄릅~……%UNICODE(0x2665) *1%」
			PRINTFORMDW 뿌리까지 삼켰다가…… 단숨에 끌어내는 듯한 움직임으로 당신의 성기를 괴롭히는 유유코 님.
			PRINTFORMDW 단 한 번의 움직임만으로 엄청난 쾌락을 느낀 당신은 견디는 것만으로도 벅찼지만……
			PRINTFORMW 「……후우……후우……응흣……%UNICODE(0x2665) *1%」 하고 유유코도 조금 괴로운 듯 땀을 흘린다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「내줘, 내줘읏%UNICODE(0x2665) *1% 후후훗……%UNICODE(0x2665) *1% 아아앙쿠햔%UNICODE(0x2665) *1%」
			PRINTFORMDW 당신의 성기를 격렬하게 먹어치우는 듯한 움직임으로 거칠게 몰아붙인다.
			PRINTFORMW 「참을 수 없어히이~%UNICODE(0x2665) *1% 쭉쭉쭈왑읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흐응…… 음…… 츄릅… 쭉 넘어가 버려. 맛있어……%UNICODE(0x2665) *1%」
			PRINTFORMW 「…… 기분 좋지…… 좋은 거 %CALLNAME:MASTER%도 기분이 좋아졌으면 해서%UNICODE(0x2665) *1%」
			PRINTFORMDW 그녀는 그렇게 말하며 당신의 성기를 즐기면서도, 사랑이 가득한 봉사를 계속하고 있었다.
		ELSE
			PRINTFORMW 「……응응응응~읏%UNICODE(0x2665) *1% 응후후……푸하아……어때? 내 볼 부드럽지~? 응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「……읏%UNICODE(0x2665) *1%응……후……%UNICODE(0x2665) *1%……%UNICODE(0x2665) *1%」
			PRINTFORMDW 당신의 귀두를 볼살에 밀어붙인 채, 한껏…… 시간을 들여 즐겼다……
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응…… 혀로 핥짝%UNICODE(0x2665) *1% 응~ 짜고 진한 고기 맛이라 맛있어~ %UNICODE(0x2665) *1% 흠후후 변♪」
			PRINTFORMDW 유유코는 당신의 성기를 마음껏 음미하며 당신과의 행원을 즐긴다……. 타락했구나?
		ELSEIF RAND:2 == 0
			PRINTFORMW 「츄릅~%UNICODE(0x2665) *1% 퐁!……응……%UNICODE(0x2665) *1% 후후, 응, 츄릅~……%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코 님은 뿌리까지 삼켰다가…… 단숨에 뽑아내는 듯한 움직임으로 당신의 자지를 애무하며 괴롭힌다.
			PRINTFORMDW 단 한 번의 스트로크만으로도 엄청난 쾌락이 밀려와, 당신은 견디는 것만으로도 벅찼다.
		ELSE
			PRINTFORMW 「내놔, 내놔읏%UNICODE(0x2665) *1% 후후훗……%UNICODE(0x2665) *1% 아아앙커풉%UNICODE(0x2665) *1%」
			PRINTFORMDW 당신의 성기를 격렬한 춤을 추듯 거세게 핥고 있었다.
			PRINTFORMDW 너무나 큰 쾌락에 신음이 터져 나오려 했으나 간신히 참아내고 있었다.
			PRINTFORMW 「참아버릴래흐으잇~%UNICODE(0x2665) *1% 주루쮸루응앗%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「읏……응……츄릅……쭈르륵 맛있다……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후후훗…… 응앗, 핥아봐…… 어때~ 기분 좋으려나~ %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……응으응으~ %UNICODE(0x2665) *1% 음후훗……푸하앗…… 어때? 내 볼 부드럽지이~? 응읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
