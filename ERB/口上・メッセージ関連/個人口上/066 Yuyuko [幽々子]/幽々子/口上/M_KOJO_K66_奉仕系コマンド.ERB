@M_KOJO_MESSAGE_COM_K66_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「우후훗, 근사하네……. 냄새도 정말 맛있을 것 같고 먹을 맛 나겠어……%UNICODE(0x2665) *1%」
		PRINTFORMDW 그리고 유유코님은 싱글벙글 웃으며 당신의 성기를 애틋하게 쓰다듬는다.
		PRINTFORMW 「우후훗……♪ 잔뜩 쓰다듬어 줄 테니까~♪」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「아라? 벌써 나올 것 같아 %UNICODE(0x2665) *1% 괜찮아~ 좋아하는 곳에 싸도……♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후훗~응%UNICODE(0x2665) *1% 의외로 잘하잖아~ %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「도뻬우도뻬읏%UNICODE(0x2665) *1% 잔뜩 내보내자아~♪」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMW 「핥아주고 싶어…… 핥아주고 싶다~ 응, 괜찮지? %UNICODE(0x2665) *1% 아앙 참아버렸어…… 후후훗 %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응후후읏%UNICODE(0x2665) *1% 자, 슥슥%UNICODE(0x2665) *1%…… 슥슥……읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쓰다듬어 줄게…… 후후, 귀두 쓰다듬히는 게 괴로워 보이는 얼굴 재미있어…… 후훗」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……스으읏……응! %UNICODE(0x2665) *1% 좋은 향기…… 후우윽…… 우후훗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 날뛰어서 잡기 힘든 거예요 %UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW (핥고 싶어…… 핥고 싶어 핥고 싶어……. %UNICODE(0x2665) *1% 거시기 핥고 싶어)
			PRINTFORMW 「우후훗, 뭐야?읏 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「수컷 냄새 나아…… 우후훗%UNICODE(0x2665) *1% 후우…… 후우……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「빨리…… 싸버려? 빨리 싸버려…… 읏후후읏%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「기분 좋아? 후후, 참지 않아도 되는 거야 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「벌벌 떨고 있네, 괜찮아…… 참지 않아도 돼, 전부 받아줄게 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「후우읏…… 우후후, 숨을 불어넣었을 뿐인데 움찔거려 귀엽네 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
