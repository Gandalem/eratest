@M_KOJO_EVENT_K66_24(ARG,ARG:1)
;口上主はLOCAL
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「……아이…… 생겨버렸네, 후후훗!」
		PRINTFORMDW 진심으로 행복해 보이는 그녀를 보며 당신은 안도한다.
		PRINTFORMDW 당신의 아이를 진심으로 기대하고 있으며…… 당신에게 가볍게 애교를 부리듯 이마를 비빈다.
		PRINTFORMW 「……당신과 나의 아이야, 분명…… 분명 건강하게 자랄 거야」
		PRINTFORMDW 유유코는 다정하게 배를 쓰다듬으며 상냥한 미소를 지어 보였다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……아이…… 생겨버렸어…… 괜찮을까? 모르겠어」
		PRINTFORMDW 처음에는 커지기 시작하는 배를 부드럽게 쓰다듬는 유유코는 당혹감과 절반, 공포와 비슷한 표정을 보인다.
		PRINTFORMDW ……하지만 이윽고 그녀는 당신 쪽을 올려다본다.
		PRINTFORMW 「……건강한 아이를 키워볼까?」
		PRINTFORMDW 당황스러움이 섞여 있었지만, 지금까지 본 적 없는 어머니 같은 표정으로 당신을 응시했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「망령이라도…… 아이는 생길 수 있구나……」
		PRINTFORMDW 처음에는 커지기 시작하는 배를 유유코가 부드럽게 쓰다듬었지만…… 그 표정은 무엇을 생각하고 있는 건지 알 수 없었다.
		PRINTFORMDW ……하지만
		PRINTFORMW 「기쁘다아……」
		PRINTFORMDW 들릴 듯 말 듯 한 목소리로 그녀는 중얼거렸다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「큭...? 방금 그 느낌 뭐지~」
		PRINTFORMW 「식중독? 희귀하네에~」
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
