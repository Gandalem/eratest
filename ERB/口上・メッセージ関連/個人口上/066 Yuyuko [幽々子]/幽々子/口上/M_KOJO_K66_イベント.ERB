@M_KOJO_EVENT_K66_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【キャラの自室】に戻りました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:318 == 1
			PRINTFORMW 「……그럼, 나는 돌아갈 테니 내가 왜 깨어 있는지 이것저것 생각하고 있어 봐?」
			PRINTFORMDW 유유코는 그렇게 말하고 살금살금 집으로 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「자 슬슬 시간이 되었으니까…… %CALLNAME:MASTER%…… 응읏%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"의")% 뺨에 키스하며 깔깔 웃으며 돌아갔다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%…… 잘 자요~」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"에게")% 손을 파닥거리며 흔들고 돌아갔다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「%CALLNAME:MASTER%, 잘 자아~요오옷」
			PRINTFORMDW 그러고는 그녀는 당신의 목덜미에 차가운 손을 대더니, 펑 하고 소리를 내며 사라졌다……
		ELSE
			PRINTFORMW 「오~야~스~미~나사이」
			PRINTFORMDW 라고 그녀는 당신의 등 뒤에서 말한 후 깨닫고 나니 사라져 있었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている（～は眠そうにしている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「하아아…… 응, 아직 괜찮아…… 조금만 더 이야기하자?」
			PRINTFORMDW 그러고 유유코는 크게 하품을 했다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「하아아…… 졸려……. 이제 기브해 줄까~?」
			PRINTFORMDW 유유코는 크게 하품을 했다.
		ELSE
			PRINTFORMW 「하아아…… 졸리다네에~……」
			PRINTFORMDW 유유코는 크게 하품을 했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（～は眠っている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「음~ 음냐음냐앗…… %CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 가끔 %조사처리(CALLNAME:MASTER,"의")% 이름을 부르며 잠들어 있다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%……자~요우카리~ 안돼애~……응~ 거긴 싫다고~」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"를")% 품은 채 이상한 꿈을 꾸고 있는 듯하다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「……크으, 스으…… 일어날게요…… 웅얼웅얼」
			PRINTFORMDW 유유코는 새근새근 잠들어 있다.
		ELSE
			PRINTFORMW 「……음~……요무~……유카리~」
			PRINTFORMDW 유유코는 새근새근 잠들어 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱して寝る（体力500以下,うふふ時はうふふ強制終了）
	;（キャラの自室以外：～を【現在地】から【キャラの自室】に運びました）
	;（キャラの自室　　：～は疲れたと言って、横になりました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「……하아~ 굉장해…… 이 정도면 체력에는 자신 있다구~……%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 쇠약한 모습으로 옆에 누워있다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%…… 피곤해~ 어디에 그런 체력이 있는 거야~?」
			PRINTFORMDW 유유코는 쇠약해진 모습으로 옆에 누워 있다.
		ELSE
			PRINTFORMW 「대단하네~…… 이쪽 체력은 이제 무리야~……」
			PRINTFORMDW 유유코는 쇠약한 모습으로 옆에 누워 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（恋慕のみ,そのまま一日が終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF CFLAG:318 == 1
			PRINTFORMW 「……저기…… 정말 귀찮아지니까 그만둬야 할걸?」
			PRINTFORMW 「귀찮게 구는 아이들은 싫지만 말이야, 이제……」
		ELSEIF TALENT:恋人
			PRINTFORMW 「%CALLNAME:MASTER%, 어라? 피곤해? 정말이지……」
			PRINTFORMDW 한숨을 내쉬며 당신을 방까지 데려가는 유유코……
			PRINTFORMW 「귀찮게 하는 아이들은 싫지 않아 후후훗」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「어째서 %CALLNAME:MASTER%도 요우무도 쓰러질 때까지 노력하는 걸까……」
			PRINTFORMW 「뭐……. 그만큼 나를 생각하고 있다고 해석해 주도록 할까요%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 그런 말을 하고 나서…… 당신을 방까지 데려다주었다.
		ELSE
			PRINTFORMW 「유카리일 때라면 쓰러지는 건 나 쪽인데 말이야~……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが寝るために自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た（【TARGET】が部屋に戻ってきた→寝間着へと着替え、寝床に潜った）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			IF CFLAG:318 == 1
				PRINTFORMW 「……화는 하고 있지만, 졸리니까 자요오…… 잘자~」
				PRINTFORMDW 유유코는 방으로 돌아와 잠옷으로 갈아입고는…… 그대로 옆으로 누워버렸다.
			ELSEIF TALENT:恋人
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 함께 자지 않겠어? 후훗, 유탄포 유탄포♪」
				PRINTFORMW 「괜찮잖아. 빙의당한 자신을 가져봐 %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 함께 잠들자~ 우후훗……♪」
				PRINTFORMW 「남자라는 사람의 심장 소리는 차분해지는 것이지～」
			ELSE
				PRINTFORMW 「후우…… 그럼 이상한 거 하지 말아줘~? 나는 졸려용」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出して寝た（眠そうな【TARGET】に追い出された……）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF CFLAG:318 == 1
				PRINTFORMW 「……응응 나가렴, 나는 자야 하니까~」
			ELSEIF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%, 그럼, 읏~」
				PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"를")% 방에서 내보냈다.
				PRINTFORMW 「후~ 극락극락…… 지이잉♪」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%…… 졸리니까 나가줘~ 심장 소리가 너무 시끄러워~」
			ELSE
				PRINTFORMW 「망령의 잠을 방해하지 말라고 자주 듣지만, 망령이 자는 것도 방해하면 안 돼요」
				PRINTFORMW 「네네, 잘 거니까 나가줘, 나가줘」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た（【TARGET】が部屋に戻ってきた→唇をとがらせる【TARGET】に、【MASTER】は渋々【Ｈの相手】から離れた）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;来訪キャラが拠点で休憩（～は疲れ切っている→ちょっと休んでいきなよ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝室に居る状態でその場で寝る（～は眠気に負け、眠りについた……）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF CFLAG:うふふ
			;うふふ中に寝る
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;移動時すれちがい
;==================================================

@M_KOJO_EVENT_K66_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
			RETURN 0
		PRINTFORM 유유코는 %조사처리(CALLNAME:MASTER,"를")%
		IF TALENT:恋人
			PRINTFORM 무언가를 기대하는 듯이
		ELSEIF TALENT:恋慕
			PRINTFORM 욕심 가득하게
		ELSEIF GETBIT(CFLAG:1,0)
			PRINTFORM 유심히
		ENDIF
		PRINTFORMDW 보고 올게.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「앗…… 어디 가는 거야?」
			PRINTFORMW 「급한가 보네? 그럼, 기분이 되면 말 걸어주렴~?」
			PRINTFORMDW 유유코는 부채로 입가를 가린 채 크크 웃었다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「앗, 후~ 인사만 하고 지나갈 거야~?」
			PRINTFORMW 「응? 딱히 용건은 없어? 너를 곤란하게 만들고 싶었을 뿐이야」
			PRINTFORMDW 유유코는 부채로 입가를 가린 채 쿠스쿠스 웃었다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「아라라, 안녕. 오늘도 여러 아이들이 붙어 있네~」
			PRINTFORMW 「우후후, 귀찮게 하려고 붙잡았을 뿐이야. 응? 붙어있는 건 정말이야?」
			PRINTFORMDW 유유코는 입가를 부채로 가린 채 쿠스쿠스와 웃었다.
		ELSE
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 유유코에게 가볍게 목례를 하자,
			PRINTFORMDW 그녀도 가볍게 인사를 건넸다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
			RETURN 0
		PRINTFORM 유유코는 %조사처리(CALLNAME:MASTER,"를")%
		IF TALENT:恋人
			PRINTFORM 낙담한 듯
		ELSEIF TALENT:恋慕
			PRINTFORM 조금 아쉬운 듯이
		ELSEIF GETBIT(CFLAG:1,0)
			PRINTFORM 어라? 하고
		ENDIF
		PRINTFORMDW 응시하고 있었다.
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
