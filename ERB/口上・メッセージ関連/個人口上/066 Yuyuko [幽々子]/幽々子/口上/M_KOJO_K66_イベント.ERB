@M_KOJO_SPEVENT_K66_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTFORMW 「나 좀 봐, %CALLNAME:MASTER%」
	PRINTFORMW 「후후, 놀라게 해 주려고. 그러니까 나 봐줘, 깜짝 놀라야지」
	PRINTFORMW 「쪽……」
	PRINTFORMW 「우후후, 볼에 쪽 하고 키스해 버렸어♪ 어머나~」
	PRINTFORMDW 장난치는 유유코에게 당신은
	CALL ASK_YN("뒤돌아보았다.", "남자에게 보여주다")
	SELECTCASE RESULT
		CASE 0
			PRINTFORMW 
			PRINTFORMW 「응읏……!?」
			PRINTFORMDW 돌아선 순간, %조사처리(CALLNAME:MASTER,"와")% 유유코의 입술이 불현듯 접촉했고, 유유코는 눈을 크게 뜨게 되었다.
			PRINTFORMW 「……앗아우」
			PRINTFORMDW 유유코는 한동안 눈을 크게 뜬 채 시선을 돌리지 않고 계속 응시하다가, 마침내 접촉이 풀린 순간 약간 아쉬운 표정을 지었다.
			PRINTFORMW 「헉!? 그, 입술만 스친 거잖아? 에엣……에엣?」
			PRINTFORMW 「……앗! 꺄아아악!!」
			PRINTFORMDW 그 후 유유코는 얼굴을 붉히며 소리를 지르더니…… 당신에게서 멀어져 나무 뒤로 숨는다.
			PRINTFORMW 「힐끔……」
			PRINTFORMDW 그 후에도 유유코는 좀처럼 나무 뒤에서 나오지 않았지만,
			PRINTFORMW 「이제 그만, 놀라게 하잖아! 힝!」
			PRINTFORMDW 그러고는 화난 듯한 모습을 보이면서도 소녀답게 자신의 입술에 남은 감촉을 계속 확인했다…….
		CASE 1
			PRINTFORMW 
			PRINTFORMW 「응읍...!?」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"와")%는 강제로 유유코의 입술을 빼앗고, 혀를 얽히게 하며, 타액을 흘려 넣는다.
			PRINTFORMDW 자신이라는 존재를 이 놀리기 좋아하는 망령에게 가르쳐 넣는다.
			PRINTFORMDW 주루주루 소리를 내며…… 망령에게 생(콘돔없이)을 가르친다.
			PRINTFORMW 「……헉, 하아하아…… 아아…… 심, 정말 못된 사람이네, 지나친 장난이야, 야수 같아」
			PRINTFORMDW 유유코는 분노하며 %CALLNAME:MASTER%에게서 얼굴을 돌린다.
			PRINTFORMDW 화나게 해버린 걸까…… 사과해야 하나…….
			PRINTFORMW (조금…… 두근거려 버렸어…… 대단하네…… %CALLNAME:MASTER%……)
			PRINTFORMW (하지만 아가씨의 입술을 아무런 망설임 없이 빼앗은 건 화나잖아♪)
			PRINTFORMDW 유유코는 그 후 꽤 진심으로 화를 내버렸다
			BASE:怒り = 1500
			CFLAG:66:1300 = 1
	ENDSELECT
ENDIF
RETURN 1
