@M_KOJO_EVENT_K66_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「연인 데이트 할 거야~ %CALLNAME:MASTER%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 데이트하자?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%, 시간 안 나? 같이 데이트하자~ ♪」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 심심하잖아? 데이트 가자~」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「우후훗! 그럼 가보자…… 어디든 괜찮아 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「달콤한 걸 먹고 싶다~ 후훗」
				ELSEIF TALENT:思慕
					PRINTFORMW 「그럼 단 거 먹으러 갈까요?」
				ELSE
					PRINTFORMW 「별로 인기 없어도 이야기만 해도 괜찮잖아~?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「정말 아쉽네. 그럼 다음에 또 부탁할게?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「후~음, 나보다 놀고 싶은 여자애가 있는 걸까아~」
				ELSE
					PRINTFORMW 「쌀쌀맞네에~……」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%, 방 데이트 하자아~♪」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 우리 집에도 와주지 않을래? 맛있는 다과가 준비되어 있단다~」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 차 한잔하러 우리 집까지 안 올래~?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「……읏%UNICODE(0x2665) *1% 있잖아…… 뭐 하고 싶어?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「후우~…… 여유를 가지실래요?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「……재미있는 게 하나도 없으니까 요우무가 오면 괴롭혀 볼까?」
				ELSE
					PRINTFORMW 「자고 싶다고 해놓고 아무것도 안 하니까 대충 시간 보내~」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「좋아~ 그럼 또 다른 기회에 봐?」
				ELSEIF TALENT:恋慕
