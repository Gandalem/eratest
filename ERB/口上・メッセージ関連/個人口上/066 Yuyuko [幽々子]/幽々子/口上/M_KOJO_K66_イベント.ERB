@M_KOJO_EVENT_K66_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「……아라라, 엿보고 있었니~? 싫은 취미네~」
				PRINTFORMDW 유유코는 그렇게 말하며, 당신을 빤히 노려보았다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「……이제…… 아무것도 안 할 거면 귀찮으니까 나가버려?」
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「……후훗%UNICODE(0x2665) *1%」
				PRINTFORMDW 유유코는 오히려 당신의 시선을 최고의 간식으로 삼고 자위행을 계속했다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「……아아, 그만해~」
				PRINTFORMDW 유유코는 자위하는 것을 방해받자 화가 나 있었다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「……읏%UNICODE(0x2665) *1%」
				PRINTFORMDW 유유코는 쿠스쿠스와 웃고 있는 입가를 부채로 가리면서 손짓으로 당신을 유혹했다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「……후읏응…… 우훗……%UNICODE(0x2665) *1%……후읏%UNICODE(0x2665) *1%」
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
	ENDSELECT
ENDIF
;オナバレックス判定用関数
;RETURN -1で強制失敗、RETURN 1で強制成功

