@M_KOJO_EVENT_K66_23(ARG,ARG:1)
;口上主はLOCAL
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;断られた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:318 == 1
			PRINTFORMW 「……화난 상태로 몸을 보일 리가 없잖아」
		ELSEIF TALENT:恋人
			PRINTFORMW 「지금은 그런 기분이 아니야~」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「욕탕에 들어가고 싶어~ 혼자라면 괜찮은데, 지금은 그런 기분이 아니야」
		ELSE
			PRINTFORMW 「친구들이랑 같이 목욕하는 거잖아~ 난 싫지만……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一緒に入ってくれた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「아라, 목욕? 후후훗 귀여운 연인과 함께 들어가 볼까요~♪」
			PRINTFORMW 「물론…… 등에 물을 받아 줄게요?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「아라라 변태 씨, 나랑 같이 목욕하고 싶다니 대담하네에…… 후후훗!」
		ELSE
			PRINTFORMW 「같이 목욕할래~? 우응 그렇게 가슴 만지고 싶었나~ 괜찮아, 해줄게~?」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
