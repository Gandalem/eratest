; Modular ERB: 個人口上/066 Yuyuko [幽々子]/幽々子/口上/M_KOJO_K66_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K66_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「아라라…… 그렇게 죽고 싶었으면 말해줬으면 좋았을 텐데~」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%CALLNAME:MASTER%쨩 그거 하자, 그거? 그게 그거 말하는 거 맞지?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「별로 오랜만은 아니지만, 좀 진심을 내 볼까~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이기면 뭐든지 들어달라고 하는 건 어때? 물론 들어주기만 할게」
		ELSE
			PRINTFORMW 「탄막보다는 차가 더 좋은데 말이야~」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「앗…… 후~ 그런 걸 하는 거야~」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아앗 지금 전장이었다면 죽었을 거야……. 원래부터 죽고 있었지」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「지금 거 일부러 맞춘 거야? 응 아니야~ 거짓말♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……하나 잡았다! 꽤 하네~」
				ELSE
					PRINTFORMW 「……지금 식사 생각하고 있었어」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……나 지금 좀 화났는데~?」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「헤에~ %UNICODE(0x2665) *1% 꽤 하는걸……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「응읏…… 우후훗…… 요우무만 한가~?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「망령인데 조금 두근거리기 시작했네~」
				ELSE
					PRINTFORMW 「한 번만 더…… 궁지에 몰려버렸네~♪ 우후훗…… %UNICODE(0x2665) *1%」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「…… %CALLNAME:MASTER%싫어」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아~ 당해버렸네……%UNICODE(0x2665) *1% 슬쩍……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「앗!?……하아……졌어요~」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「요~무~! 이 사람 치트잖아~!!」
				ELSE
					PRINTFORMW 「그럼…… 슬슬 나도 본심을 내야 하는데…… 응? 진 거야?」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「슬슬 사과할 생각은 난 걸까~? 잡몹잡몹들…… 어서 사과해~」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「이런 걸? 발이 땅에 안 닿아있잖아~?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「전부터 생각하고 있었는데, 당신은 잡몹이네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후음? 이렇게 약한데 지금까지 잘 살아왔네~」
				ELSE
					PRINTFORMW 「시간 때우기 정도는 됐을까? 아직 안 됐네…… 아, 유감이야」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「흥~ 사과도 안 하고 미소녀를 모욕하다니~」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「꽤 하는데~ 결국 지긴 했지만」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「전부터 생각은 했지만……. 당신, 오래 살 것 같지 않네?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「잔기라는 핸디가 있는데도 쓰러뜨릴 수 없다니 말이야……」
				ELSE
					PRINTFORMW 「조금은 시간 때우기엔 딱 됐네~」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「네가 실수로 안 해줘서 피격한 거야」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아~하아…… 조금만 더였는데 아쉽네~?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「전부터 생각하고 있었는데…… 너 정말 성장 빠르다 그치?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「힌트를 줄게, 봄은 피하지 않아도 쓸 수 있어~」
				ELSE
					PRINTFORMW 「아~ 아쉽네…… 하지만 다음이 있으니까 힘내나~」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……퉁…… 지금 저는 화가 나 있고 쓰러져서 삐져있어요…… 퉁」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아아…… 벌써 만신창이네…… 지면 정말 싫어질 것 같아」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「전부터 생각하고 있었는데…… 당신은 진심을 내면 강해지잖아?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「꽤 진심이었는데 말이야…… 있잖아, 다음엔 요우무도 데려와도 될까?」
				ELSE
					PRINTFORMW 「배가 고파서 힘이 안 나아~……」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
