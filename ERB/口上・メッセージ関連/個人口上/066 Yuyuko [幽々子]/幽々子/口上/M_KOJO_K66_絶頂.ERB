; Modular ERB: 個人口上/066 Yuyuko [幽々子]/幽々子/口上/M_KOJO_K66_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K66
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 유유코는 격렬하게 절정에 달했다.
	ELSE
		PRINTFORMW 「꺄아앗%UNICODE(0x2665) *1%!! 하아앗……하아앗……%UNICODE(0x2665) *1%」
		IF RAND:3 == 0
			PRINTFORMW 「아~앗…… 소중한 %CALLNAME:MASTER%전용 우유인데 아깝잖아~읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「네~ 우유예요~ 후훗후훗……읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「내 우유 어때?…… 맛있어? 그래…… 다행이다%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 다섯 번이나 중첩된 절정을 맞이했다.
		ELSE
			PRINTFORMW 「～～읏%UNICODE(0x2665) *1%～～읏읏%UNICODE(0x2665) *1%%UNICODE(0x2665) *1% 끼읏%UNICODE(0x2665) *1%이이……읏%UNICODE(0x2665) *1%……읏%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%히으우우……읏%UNICODE(0x2665) *1%――읏, 가아아앗……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%크으%UNICODE(0x2665) *1%크으으응%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 온몸을 경련시키며, 몸을 있는 힘껏 뒤로 젖혔다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 네 번의 절정에 도달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「읏～～～읏%UNICODE(0x2665) *1%　대단해앳%UNICODE(0x2665) *1% 후우응응%UNICODE(0x2665) *1% 뭐야 이거어%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「하아, 앙읏%UNICODE(0x2665) *1% 너무 좋아앗, 웃음이 나앗%UNICODE(0x2665) *1% 머리가 이상해져 버려엇%UNICODE(0x2665) *1% 요오무우~읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후아아……읏%UNICODE(0x2665) *1%아아아아아아앗아아앗……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후우읏%UNICODE(0x2665) *1%……응응……%UNICODE(0x2665) *1%읏……하아앗%UNICODE(0x2665) *1% 전부 기분 좋아앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……우훗, 아하아……%UNICODE(0x2665) *1% 굉장해앳…… 머리가 이상해질 것 같아%UNICODE(0x2665) *1%…… 유카리이이잇%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 삼중으로 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「으으으읏～～～읏%UNICODE(0x2665) *1% 너무읏%UNICODE(0x2665) *1% 기분 좋아아%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「하아, 앙%UNICODE(0x2665) *1% 대단해애%UNICODE(0x2665) *1% 좋아아아 무우~읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후아아……읏%UNICODE(0x2665) *1%응읏, 아아아앗%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후우읏%UNICODE(0x2665) *1%……으응……%UNICODE(0x2665) *1%읏……하아앗응%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……후훗, 아하아……%UNICODE(0x2665) *1%　대단해앳……%UNICODE(0x2665) *1%후후훗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「읏～～～앗%UNICODE(0x2665) *1%기분 좋아아%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「하아, 앗……%UNICODE(0x2665) *1% 우후훗……%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후아아……읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후우읏%UNICODE(0x2665) *1%…… 하아앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……우훗, 아하아……%UNICODE(0x2665) *1%우후훗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｃ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 클리토리스로 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응읏~ %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「후아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「클리로 가버렸어 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「클리로 가버리다니읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「야앗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 질내에서 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「후으읍! %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「더욱 격렬하게 해줘읏 후후훗 %UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「질내읏…… 기분 좋아욧%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후앗 코시이~ 좋아라아애읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏후우윽……%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 항문으로 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「오옷호옷%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「파앗, 아웅%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「항문읏 기분 좋아……캬아%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후으앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「더 더 거칠게 해줘 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 그 무게감 가득한 가슴으로 절정에 달했다.
		ELSEIF RAND:9 == 0
			PRINTFORMW 「조여오는 느낌 굉장하네에 %UNICODE(0x2665) *1%」
		ELSEIF RAND:8 == 0
			PRINTFORMW 「하아앗……응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:7 == 0
			PRINTFORMW 「그런 가슴만으로도 %UNICODE(0x2665) *1%」
		ELSEIF RAND:6 == 0
			PRINTFORMW 「히아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응읏후으윽%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「가슴, 굉장해읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「가슴 만져지는 거 좋아하지~ %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후아아……앗 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「젖꼭지이이…… 더 만져줘읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 유유코는 벚꽃 맛의 입으로 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「~~~~~읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「쭈릅흡후우……%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏…… 후읍…… 푸하아~~ %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「히끅 아아앙! %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏, 쥬루프하아……앗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K66
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;あなたが射精したときに関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K66_00
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K66_00(ARG)
;-------------------------------------------------
;TARGETの手による射精で、射精対象が非TARGET
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 
	RETURN 1
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K66_0
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K66_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 콘돔에 정액을 뱉어냈다.
	ELSEIF TALENT:MASTER:濃厚精液
		IF RAND:3 == 0
			PRINTFORMW 「헤에~ 농후하네~…… 우후훗 %UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「콘이 이렇게 착 달라붙어서 엄청나아…… %UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 「스으…… %UNICODE(0x2665) *1% 수컷의 향기! 맛있겠다아 %UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응…… 이렇게나 많이 내는 거야~ %UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「고무가 빵빵하네…… %UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 「……스응스응읏……좋은 향기야%UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K66_23
