RETURN 1

@M_KOJO_MESSAGE_SCOM_K66_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「괜찮아? (쌀 것 같아~?)~%UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 확인하듯 말을 걸며, 당신에게 더욱 큰 쾌락을 선사한다.
			PRINTFORMW 「츄릅, 쭉……%UNICODE(0x2665) *1%응후훗, 이상한 표정이네~(이상한 얼굴~)읏%UNICODE(0x2665) *1%」
			PRINTFORMDW 당신의 자지를 천천히 어루만지면서…… 유유코는 자신만만하게, 그리고 조금은 사디스틱하게 미소 짓는다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭈릅쭈르루……응, 움찔움찔해서 따뜻해아 %UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 당신의 성기에 얼굴을 비비며 사정을 유도한다.
			PRINTFORMW 「두둑……두두두두 %UNICODE(0x2665) *1% 참지 말고 싸면 기분 좋을 텐데~?」
			PRINTFORMW 「네, 주물주물, 주물주물 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……쪽…… 스윽스윽…… 쪽…… %UNICODE(0x2665) *1%」
			PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하자 일부러 희미한 쾌감만을 주는 것처럼 버드키스를 계속한다.
			PRINTFORMW 「……어떡해~ 후후, 귀엽다~ %UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
		;ELSEIF TALENT:恋慕
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응…… 냠냠~ %UNICODE(0x2665) *1% 음~ 짜고 진한 살의 맛이라 맛있어~ %UNICODE(0x2665) *1% 흥후훗 변♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「시코시코 거칠게~ %UNICODE(0x2665) *1% 후후, 굉장한 표정이네……%UNICODE(0x2665) *1% 슬슬 먹어버릴까?」
			PRINTFORMW 「아~응커푸!%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……후우%UNICODE(0x2665) *1%……후우%UNICODE(0x2665) *1% 자, 슥슥%UNICODE(0x2665) *1%」이라고 유유코는 당신의 성기에 입김을 불어넣는다.
		ENDIF
	ENDIF
ENDIF
