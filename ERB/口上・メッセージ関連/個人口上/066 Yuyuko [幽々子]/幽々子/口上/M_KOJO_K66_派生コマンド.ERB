@M_KOJO_MESSAGE_SCOM_K66_6
CALL M_KOJO_MESSAGE_SCOM_K66_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K66_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;恋慕
	IF TALENT:恋慕 || MARK:不埒刻印 == 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「흡, 흡후읍…… 응긋앗, 하윽…… 아아앗%UNICODE(0x2665) *1%」
					PRINTFORML 「들려? 지금 당신의 끈적한 게 내 안에 쏟아지고 있어……%UNICODE(0x2665) *1% 아이를 갖기 힘든 사이라 해도, 나쁜 사람이네……」
				CASE 1
					PRINTFORML 「……흡, 큭…… 톡, 톡, 토쿠토쿠읏%UNICODE(0x2665) *1% 으아~ 하고 탁탁탁탁읏 쿠토푼…… %UNICODE(0x2665) *1%」
					PRINTFORML 「……탁, …… 꿀꺽읏%UNICODE(0x2665) *1% 잘 먹었습니다%UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORML 「윽…… 후욱…… 거기, 기분, 좋은 거지…… 우후훗 좋아, 참지 마?」
					PRINTFORML 「그대로 마음껏 쏟아내줘…… 읏! 흐읍…… 하아, 아아앗%UNICODE(0x2665) *1%」
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「여자아이들이 제일 기분 좋게 되는 곳만 노리다니…… 나쁜 거잖아~읏%UNICODE(0x2665) *1%」
					PRINTFORML 「내 몸의 일을 다 알고 있어 주었어~? 더, 더 많이 알아줘도 괜찮아~……%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORML 「좋아, 거기, 꾹꾹 눌러지니까 몸이 노곤~해져 가는 느낌이야…… %UNICODE(0x2665) *1%」
					PRINTFORML 「흐응 %UNICODE(0x2665) *1% 그것! %UNICODE(0x2665) *1% 아아, 꾹꾹이 말고 자꾸 넘어가 버리는 거야 응에%UNICODE(0x2665) *1% 아앗, 으응…… %UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORML 「응, 푸아앗, 아아앗아아아앙%UNICODE(0x2665) *1%」
					PRINTFORML 「흥, 이상한 소리가 나와버렸잖아……후훗%UNICODE(0x2665) *1%」
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「네에~ 네, 여기에 톡톡톡톡이, 제일 여자애를 기쁘게 해주는 거라구~♪ 우후훗%UNICODE(0x2665) *1%」
			CASE 1
				PRINTFORML 「그렇지~ 거시기랑 비비는 데 집중해 봐~ %UNICODE(0x2665) *1% 응, 으응! %UNICODE(0x2665) *1%」
			CASE 2
				PRINTFORML 「음훗%UNICODE(0x2665) *1% 좋다아, 그 움직임…… 엄청 기분 좋아%UNICODE(0x2665) *1% 여자아이 마음으로 대단하네~ %UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
	ENDIF
	PRINTW
ENDIF
