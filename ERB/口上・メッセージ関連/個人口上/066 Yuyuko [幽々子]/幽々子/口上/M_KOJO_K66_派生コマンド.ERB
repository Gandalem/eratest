RETURN 1

@M_KOJO_MESSAGE_SCOM_K66_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		PRINTFORMW 「음읏, 주추루…… 후응, %UNICODE(0x2665) *1%」
		PRINTFORMDW 유유코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 머리를 앞뒤로 움직이며 당신의 성기에서 정액을 짜내려고 한다.
		PRINTFORMDW 당신 역시 지지 않겠다는 듯 유유코의 달콤한 질에 입을 맞추며 유유코로부터 쾌락을 끌어내려 한다.
		PRINTFORMW 「음읏~~~ッ……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		;恋慕
		;ELSEIF TALENT:恋慕
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「흡……응……주르륵 후윽……쮸읍……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏……응……츄릅……쭈르륵 맛있어……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「츄릅~읏%UNICODE(0x2665) *1%　퐁!……응……%UNICODE(0x2665) *1% 후훗, 응, 츄릅~……%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
