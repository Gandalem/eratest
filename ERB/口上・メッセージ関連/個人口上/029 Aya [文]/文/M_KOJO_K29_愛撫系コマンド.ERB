@M_KOJO_MESSAGE_COM_K29_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF FLAG:時間停止 && FIRSTTIME(TOSTR(SELECTCOM) + "_TS")
			PRINTFORML 
			PRINTFORMDL %CALLNAME:MASTER%は文の秘所に口づけた。
			PRINTFORMDL 陰毛は整えられていて、綺麗に生え揃っている。
			PRINTFORMDW 陰核を吸い上げると、膣内から愛液がとくとくと溢れ出してきた……。
			RETURN 1
		ELSEIF FIRSTTIME(SELECTCOM)
			IF TALENT:恋慕
				PRINTFORML 
				PRINTFORML 「……な、舐める、の？」
				PRINTFORML 「き、汚い……えっ、いや、ちゃんと綺麗にしてきたけど」
				PRINTFORML 「そ、それでも、良い、の？」
				PRINTFORMDL 文は顔を紅くして訊ねて来る。
				PRINTFORMDL %CALLNAME:MASTER%が頷くと、文は顔を真っ赤にした。
				PRINTFORML 「……ぃ、いい、けど」
				PRINTFORMDW 真っ赤な顔を背けながら、文は小さく言う。
				PRINTFORMDL それから文は、おずおずと太ももに手をかけて、脚を開いた。
				PRINTFORML 「……そ、そんなにじっくり、見ないでっ……」
				PRINTFORMDL 羞恥のあまり目じりに涙を浮かべながら、文は懇願してくる。
				PRINTFORMDW あんまり待たせるのも悪いので、%CALLNAME:MASTER%はゆっくりと、文の秘所に口づけた。
				PRINTFORML 「……ふ、ぁ、っ……」
				PRINTFORMDL 文は顔を手で覆いながら、小さく声を上げる。
				PRINTFORMDL ゆっくりと、なぞるように、舌先で膣口を刺激する。
				PRINTFORMDL 陰核を舌の上で転がしたり、膣内に少しだけ舌を挿入したりする。
				PRINTFORML 「は、んっ……うあっ、や、それ、だめっ……んっ……」
				PRINTFORMDW 文は未知の感覚に背を震わせ、恍惚とした表情を浮かべている……。
			ELSE
				PRINTFORML 
				PRINTFORML 「……き、汚い、ですよ」
				PRINTFORML 「い、いえ、ちゃんと綺麗にしてますけど、その」
				PRINTFORMDL 文は顔を真っ赤にしてそう言う。
				PRINTFORMDL それならいいじゃないか、そう言って、%CALLNAME:MASTER%は文の脚を開く。
				PRINTFORML 「ぁっ、や、やっぱり、やめっ……」
				PRINTFORMDL 文は何か言いかけたが、すぐに口を閉じた。
				PRINTFORMDW その顔に抵抗の色は無く、羞恥の赤だけが浮かんでいた。
				PRINTFORML 「……ぁ……恥ずかしい、ですよ……」
				PRINTFORMDL 恥ずかしがる文の顔を見ながら、%CALLNAME:MASTER%は秘所に口づけた。
				PRINTFORMDL 未知の感覚に、文は目を見開く。
				PRINTFORML 「なに、これっ……あ、や、んっ！」
				PRINTFORMDW 陰核を舌で転がすと、もう文の口から拒絶の言葉は出てこなくなった……。
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	
	;時姦中
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %CALLNAME:MASTER%は文の膣口に口づけた。
		PRINTFORMDL 陰核を吸い上げ、膣内を舌で拓いて行く。
		PRINTFORMDW 尖った陰核を唇で甘く噛むと、膣奥からは愛液が溢れ出してきた……。
		RETURN 1
	ENDIF
	
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			IF TALENT:恋慕
				PRINTFORML 
				PRINTFORML 「はぁっ、はぁっ……や、そんなっ、今は汚いっ……」
				PRINTFORMDL 文は脱力したままそう言って、%CALLNAME:MASTER%を止めようとする。
				PRINTFORMDL しかし%CALLNAME:MASTER%は気にせず、文の秘所に口づけた。
				PRINTFORML 「やぁ……精液、汚いのに……んっ」
				PRINTFORMDW 膣内に深く舌を挿入すると、文は何も言わなくなった。
			ELSE
				PRINTFORML 
				PRINTFORML 「はぁっ、はぁっ、えっ、そんな、今は、汚い、っ……」
				PRINTFORMDL 文はそう言って、脚を閉じようとする。
				PRINTFORMDL しかし%CALLNAME:MASTER%はその脚を無理やり開いて、秘所に口づけた。
				PRINTFORML 「は、あっ……あ、やぁっ……んっ……」
				PRINTFORMDW 膣内を舌でかき回すと、文の脚から力が抜けた、
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:Ｃ絶頂
		IF TALENT:恋慕
			PRINTFORML 
			PRINTFORML 「あ、あっ、だめ、イく、イっちゃうっ」
			PRINTFORMDL 文は可愛らしい声を上げながら、必死に快楽に耐えている。
			PRINTFORMDL もっと可愛らしい声で鳴いてくれるだろうか。
			PRINTFORMDW そう思って、%CALLNAME:MASTER%はとどめとばかりに、陰核を強く吸い上げた。
		ELSE
			PRINTFORML 
			PRINTFORML 「はぁっ、はぁっ、%CALLNAME:MASTER%、さん、イっちゃう、イっちゃいますっ」
			PRINTFORMDL 文は荒く息を吐きながら、快楽に耐えている。
			PRINTFORMDL 反射的に脚を閉じたのだろうが、それは抵抗としては、無意味なことだった。
			PRINTFORMDW 意地悪く、%CALLNAME:MASTER%は陰核を唇で食んだ……。
			;実際に脚で頭を挟まれたら妖怪特有の怪力で頭蓋骨割られそう
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORML 
			PRINTFORML 「は、んっ……ひゃんっ……は、あぁっ」
			PRINTFORMDL 文は恍惚とした表情で、嬌声を上げている。
			PRINTFORML 「んっ、ああ……そんな、飲んじゃ、ん、んんっ！」
			PRINTFORMDL %CALLNAME:MASTER%は文の顔を見ながら、愛液をじゅる、と音を立ててすする。
			PRINTFORMDW 口ではそう言いながらも、その秘所からは愛液がとめどなく溢れてきている……。
		ELSE
			PRINTFORML 
			PRINTFORML 「……んっ……あっ……ひゃうっ」
			PRINTFORMDL 文は熱い吐息を吐きながら、%CALLNAME:MASTER%に身を任せている。
			PRINTFORML 「はぁっ、は、んっ、良いっ、%CALLNAME:MASTER%の舌、良いっ」
			PRINTFORMDW 眼を見開いて背をそらしては、文は甲高い嬌声を上げた。
		ENDIF
	;屈服3
	;ELSEIF MARK:不埒刻印 == 3
	;それ以外
	ELSE
		IF RAND:2 == 0
			PRINTFORML 
			PRINTFORML 「はぁっ、はぁっ、ん、あぁっ、や、んっ」
			PRINTFORMDL 文は%CALLNAME:MASTER%の舌の感触に、熱い息を漏らしている。
			PRINTFORML 「んぅっ、は、あぁっ！　やっ、それ、つよすぎ、ますぅっ！？」
			PRINTFORMDW 陰核を甘く唇で噛んで舌先で弾くと、文は悲鳴を上げた。
		ELSE
			PRINTFORML 
			PRINTFORML 「はぁっ……んっ、は……ふぅっ、んっ……」
			PRINTFORMDL 文はとろんとした顔で、舌から与えられる快楽を享受している。
			PRINTFORML 「は、んんっ……良い、です……ん、あぁっ」
			PRINTFORMDW 口の端から涎をこぼしながら、文はとろけたように言った。
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

