@M_KOJO_MESSAGE_COM_K29_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「えっ、咥えるんですか？ど、どうぞ…」
			PRINTFORMW 「あ、あ、あっ… そんなにされたらもう私…♪」
		ELSE
			PRINTFORMW 「し、正気ですか！？」
		ENDIF 
		RETURN 1
	ENDIF
	
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「おちんちんがこんなに気持ちいいなんて…♪」
				PRINTFORML 「もう病み付きですね、これは」
				PRINTFORMW 「記事にしちゃいたいくらいですよ…♪」
			CASE 1
				PRINTFORML 「あああああっ♪お、おちんぽ凄い…！焼けそうですよぉ…！」
				PRINTFORMW 「はぁっ…♪これ、気持ちよすぎて変な気を起こしちゃいそうですよぉ…、えへへ…♪」
		ENDSELECT
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「あああっ…、そんなにされたら…」
	ELSE
		PRINTFORMW 「い、嫌です… やめてください…」
	ENDIF
ENDIF
RETURN 1

