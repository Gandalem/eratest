@M_KOJO_MESSAGE_COM_K29_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF FLAG:時間停止 && FIRSTTIME(TOSTR(SELECTCOM) + "_TS")
			PRINTFORML 
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야의 은밀한 곳에 입을 맞추었다.
			PRINTFORMDL 음모는 정돈되어 있었고, 깨끗하게 자라 있었다.
			PRINTFORMDW 음핵을 빨아들이자, 질내에서 애액이 뚝뚝 흘러나왔다……
			RETURN 1
		ELSEIF FIRSTTIME(SELECTCOM)
			IF TALENT:恋慕
				PRINTFORML 
				PRINTFORML 「……뭐, 핥는 거야?」
				PRINTFORML 「더러워……엣, 아니, 깨끗하게 해왔는데」
				PRINTFORML 「그, 그래도 괜찮은 거야?」
				PRINTFORMDL 아야는 얼굴을 붉히며 물어온다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, 아야는 얼굴을 새빨갛게 물들였다.
				PRINTFORML 「……응, 괜찮지만」
				PRINTFORMDW 새빨개진 얼굴을 돌린 채, 아야는 작게 말한다.
				PRINTFORMDL 그러고 나서 아야는 조심스럽게 허벅지에 손을 대고 다리를 벌렸다.
				PRINTFORML 「……그, 그렇게 자세히 보지 말아 줘……」
				PRINTFORMDL 수치심에 눈가에 눈물을 글썽이며, 아야는 간청해 온다.
				PRINTFORMDW 너무 오래 기다리게 하는 것도 나쁘니, %조사처리(CALLNAME:MASTER,"는")% 천천히 아야의 은밀한 곳에 입을 맞추었다.
				PRINTFORML 「……흐, 으윽……」
				PRINTFORMDL 아야는 얼굴을 손으로 가린 채 작게 소리를 낸다.
				PRINTFORMDL 천천히, 더듬듯이 혀끝으로 질 입구를 자극한다.
				PRINTFORMDL 음핵을 혀 위에서 굴리거나, 질 내부에 살짝 혀를 넣는다.
				PRINTFORML 「하, 응…… 아앗, 그건 안 돼……응……」
				PRINTFORMDW 아야는 미지의 감각에 몸을 떨며 황홀한 표정을 짓고 있다…….
			ELSE
				PRINTFORML 
				PRINTFORML 「...더러워요.」
				PRINTFORML 「아, 아니에요. 제대로 치고는 있는데, 그게...」
				PRINTFORMDL 그는 얼굴을 새빨갛게 물리고 그렇게 말한다.
				PRINTFORMDL 그렇다면 괜찮지 않느냐, 그렇게 말하며 %조사처리(CALLNAME:MASTER,"는")% 문다리(혹은 다리)를 벌린다.
				PRINTFORML 「아앗, 안 돼, 역시 그만해...」
				PRINTFORMDL 그는 무언가 말하려다 곧 입을 닫았다.
				PRINTFORMDW 그 얼굴에는 저항의 기색이 없고 수치심의 붉은빛만이 떠 있었다.
				PRINTFORML 「……아……부끄럽다구요……」
				PRINTFORMDL 부끄러워하는 문 얼굴을 보며, %조사처리(CALLNAME:MASTER,"는")% 비밀스러운 곳에 입 맞추었다.
				PRINTFORMDL 미지의 감각에, 문은 눈을 크게 뜬다.
				PRINTFORML 「뭐야, 이거... 아, 야, 안 돼!」
				PRINTFORMDW 음핵을 혀로 굴리자, 더 이상 문이 입에서 거절의 말은 나오지 않게 되었다…….
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;時姦中
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야의 질구에 입 맞추었다.
		PRINTFORMDL 음핵을 빨아들이고, 질 안을 혀로 넓혀 나간다.
		PRINTFORMDW 뾰족한 음핵을 입술로 달콤하게 깨물자, 질 깊은 곳에서 애액이 흘러내려왔다…….
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			IF TALENT:恋慕
				PRINTFORML 
