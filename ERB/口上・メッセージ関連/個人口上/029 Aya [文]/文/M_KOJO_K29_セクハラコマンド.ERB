;==================================================
;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K29_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K29_310
CALL M_KOJO_MESSAGE_COM_K29_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %CALLNAME:MASTER%は文の尻に手を伸ばした。
		PRINTFORMDL ふにゅ、と感触が返ってきて、心地が良い。
		PRINTFORMDW %CALLNAME:MASTER%は、だんだんと楽しく感じてきた……。
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
			PRINTFORML 
			PRINTFORMDL %CALLNAME:MASTER%は文の尻に手を伸ばす。
			PRINTFORMDL 張りがあり、しかし硬すぎない、素晴らしい感触が返ってくる。
			PRINTFORMDL 文は、その手を払わず、されるがままとなっている。
			PRINTFORMDW %CALLNAME:MASTER%はそのまま、文の尻を揉みしだき続けた。
		ELSE
			PRINTFORML 
			PRINTFORMDL %CALLNAME:MASTER%は文の尻に手を伸ばす。
			PRINTFORMDL ぴと、と触れた瞬間、文の手が%CALLNAME:MASTER%の手を払った。
			PRINTFORMDL 南無三、起きていたか。
			PRINTFORMDL そう思うも、文は起きていなかった。
			PRINTFORMDL どうやら、無意識の行動だったらしい。
			PRINTFORMDW %CALLNAME:MASTER%はふう、と息をついた。
		ENDIF
	ELSE
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 
			PRINTFORML 「……っ！？　な、なにするんですか！？」
			PRINTFORMDL 文は%CALLNAME:MASTER%の手を跳ね除ける。
			PRINTFORML 「……きゅ、急に尻を揉んだりして、こ、この、変態っ！」
			PRINTFORMDL 顔を真っ赤にして、文は抗議している。
			PRINTFORMDW あまりやっていたら、頬に紅葉を作られそうだ。
		ELSEIF PREVCOM == 305
			IF TFLAG:193 == 4
				PRINTFORML 
				PRINTFORMDL %CALLNAME:MASTER%は膝枕をしてもらったまま、文の尻に触れた。
				PRINTFORML 「ひゃ、んっ……もう、なにするんですか」
				PRINTFORMDL 文は頬を紅くしながらも、されるがままになっている。
				PRINTFORMDW %CALLNAME:MASTER%はにっこりと笑って、尻を揉みしだき続けた。
			ELSE
				PRINTFORML 
				PRINTFORMDL %CALLNAME:MASTER%は膝枕をしてもらったまま、文の尻に触れた。
				PRINTFORML 「ひゃっ……？　な、なにするんですか！」
				PRINTFORMDL 文は、ばっ、と%CALLNAME:MASTER%の手を振り払った。
				PRINTFORMDW その顔には、恥情と怒りが入り混じっている……。
			ENDIF
		ELSEIF TFLAG:193 == 1
			PRINTFORML 
			PRINTFORML 「……っ！？　や、やめなさいっ！」
			PRINTFORMDL 文は%CALLNAME:MASTER%の手を強く振り払った。
			PRINTFORML 「……いきなり何を……」
			PRINTFORMDW 文は不快そうにこちらをにらんでいる。
		ELSEIF TFLAG:193 == 2 || TFLAG:193 == 3
			PRINTFORML 
			PRINTFORML 「……ひゃっ！？　な、ちょ、ちょっと、やめてください……」
			PRINTFORMDL 文は頬を紅くしながら、%CALLNAME:MASTER%の手を払いのけた。
			PRINTFORML 「……あんまりそういうことは……やめてくださいね？」
			PRINTFORMDW %CALLNAME:MASTER%の手を押さえながら、文は言った。
		ELSEIF TFLAG:193 == 4
			PRINTFORML 
			PRINTFORML 「ひゃ、うっ！？　……も、もう、何するんですかぁ……」
			PRINTFORMDL 文は驚いたように悲鳴を上げた。
			PRINTFORML 「……ほどほどに、してくださいね……？」
			PRINTFORMDW 文は照れくさそうに、そう言った。
		ELSE
			PRINTFORML 
			PRINTFORML 「……っ……何、するんですか……」
			PRINTFORMDL 文は恥ずかしそうにしている。
			PRINTFORML 「……いい加減で、終わってくださいね……？」
			PRINTFORMDW 恥情にうめきながらも、文はされるがままとなった。
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K29_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K29_311
CALL M_KOJO_MESSAGE_COM_K29_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %CALLNAME:MASTER%は、時を止めたまま文に抱きついてみた。
		PRINTFORMDL 文は表情一つ変えず、抱きつかれるままとなっている。
		PRINTFORMDW そのまま頭を撫でてみたが、つまらなく感じ、%CALLNAME:MASTER%は文から離れた。
	ELSEIF CFLAG:睡眠
		PRINTFORML 
		PRINTFORML 「すぅ…………ん……」
		PRINTFORMDL %CALLNAME:MASTER%は眠っている文に抱きついた。
		IF TALENT:恋慕
			PRINTFORML 「ふ……%CALLNAME:MASTER%……さん……」
			PRINTFORMDL 小さく%CALLNAME:MASTER%の名を呼んで、文は%CALLNAME:MASTER%の胸に頬をすりつける。
			PRINTFORMDW %CALLNAME:MASTER%は優しく、その頭を撫でた。
		ELSEIF TALENT:思慕
			PRINTFORML 「……ん……%CALLNAME:MASTER%さん……」
			PRINTFORMDL 急に文は、%CALLNAME:MASTER%を抱きしめ返す。
			PRINTFORMDL %CALLNAME:MASTER%は少しびっくりしたが、そのまま抱きしめたままで居た。
			PRINTFORMDW 傍から見ればいかがわしいことをしているようにしか見えなかった。
		ELSE
			PRINTFORML 「……ん、む……ぅ……」
			PRINTFORMDW 文は小さく、寝苦しそうにうめいた。
		ENDIF
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORMDL 文。
					PRINTFORML 「何ですか？　%CALLNAME:MASTER%さん……んっ、もう……」
					PRINTFORML 「……しょうがないですねえ」
					PRINTFORMDL 文は頬を赤らめてされるがままになっている。
					PRINTFORML 「……%CALLNAME:MASTER%さん……大好き、です……」
					PRINTFORMDW 感極まったようで、文はそう耳元で囁いてきた。
				CASE 1
					PRINTFORML 
					PRINTFORML 「……%CALLNAME:MASTER%、さん？」
					PRINTFORMDL %CALLNAME:MASTER%は文に前から抱きつく。
					PRINTFORML 「ちょ、ちょっと、%CALLNAME:MASTER%さん……む、胸は、駄目ですよ……んっ」
					PRINTFORMDL 顔を埋め、深呼吸する。
					PRINTFORML 「や、やぁ……んっ、だ、だめです……服を……服を、脱いでから……」
					PRINTFORMDW そう言いながらも本気で抵抗しない辺り、満更でもないのだろう。
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORML 「んっ……どうしたんですか、急に……」
					PRINTFORMDL ちょっと抱きつきたくなったから。
					PRINTFORML 「……その、変なところ触ったりしたら、駄目ですよ？」
					PRINTFORMDW 文は微笑んで言った。
				CASE 1
					PRINTFORML 
					PRINTFORML 「……%CALLNAME:MASTER%……さん……？」
					PRINTFORMDL ……文の体、柔らかい。
					PRINTFORML 「……そうですか……ふふ……」
					PRINTFORMDL 文は微笑を浮かべ、抱き返してきた。
					PRINTFORMDL なんともいえない柔らかい感触が全身を包む。
					PRINTFORMDW 幸福感を感じながら、%CALLNAME:MASTER%は文の体の感触を楽しんだ。
			ENDSELECT
		ELSEIF TALENT:思慕
			;PRINTDATA
			;	DATALIST
					PRINTFORML 
					PRINTFORML 「……どうしたのですか、%CALLNAME:MASTER%さん」
					PRINTFORMDL ちょっと人肌が恋しくなったんだ、駄目か？
					PRINTFORML 「……いえ、駄目という、わけでは……」
					PRINTFORMDL 文は少々困惑した様子でそう言う。
					PRINTFORMDW 拒まれてはいないので、%CALLNAME:MASTER%は少しの間、文の熱を感じた。
			;	ENDLIST
			;ENDDATA
		ELSE
			;PRINTDATA
			;	DATALIST
					PRINTFORML 
					PRINTFORML 「……っ、ちょ、何、するんですかっ！」
					PRINTFORMDL 文はもぞもぞとぎこちなくもがいている。
					PRINTFORMDL 抱き心地が悪かったので、%CALLNAME:MASTER%はすぐに離れた。
					PRINTFORML 「……何を血迷ったのやら……」
					PRINTFORMDW 文はぶつぶつと呟いている。
			;	ENDLIST
			;ENDDATA
		ENDIF
	ENDIF

ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K29_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K29_312
CALL M_KOJO_MESSAGE_COM_K29_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %CALLNAME:MASTER%は時を止めたまま、文に口づけた。
		PRINTFORMD もし時が動いていたら、
			IF TALENT:恋慕
				PRINTFORMDL 文は頬を染めて照れただろう。
			ELSE
				PRINTFORMDL 文はじたばたと暴れて抵抗していただろう。
			ENDIF
		PRINTFORMDW %CALLNAME:MASTER%はそのまま、文の唇を貪り続けた……。
	ELSEIF CFLAG:睡眠
	ELSE
		;嫌がられる (custom - put here above the successful attempt)
		IF TFLAG:193 == 99
			PRINTFORML 
			PRINTFORML 「……っ……やめてください」
			PRINTFORMDL 文は後ずさり、唇を求めてきた%CALLNAME:MASTER%から離れた。
			PRINTFORML 「……やめてください、近づかないで」
			PRINTFORMDW その拒絶振りに、何気に傷ついた%CALLNAME:MASTER%であった。
		ELSEIF FIRSTTIME(SELECTCOM)
		;経験豊富に見えて実は初心な文、実に良い。
			;キス未経験だよ　スレで指摘があったから直したよ
			IF EXP:キス経験 == 1
				PRINTFORML 
				PRINTFORMDL %CALLNAME:MASTER%は、そっと文の唇に口づけた。
				PRINTFORMDL 触れるだけの、
				PRINTFORML 「……え……？　……え？」
				PRINTFORMDL 文は何が起こったかを把握していないようだ。
				PRINTFORML 「……ちょ、な、なにするんですか！」
				PRINTFORMDL 数瞬遅れ、文の顔が真っ赤になる。
				PRINTFORML 「は、は、はじ、初めて、だったのにぃっ……！」
				PRINTFORMDL 涙目で、文は叫ぶ。
				;そこまで想ってるならさっさとしてるだろ状態
				IF TALENT:恋慕
					PRINTFORMDL しかし、その頬はにやにやと緩んでいる。
					PRINTFORMDW 文はこの上なく嬉しそうにしている……。
				;妥当
				ELSEIF TALENT:思慕
					PRINTFORMDL しかし、少しだけ、その頬は緩んでいる。
					PRINTFORMDW 文はそう叫びつつも、どこか嬉しそうだ……。
				;結構反感買いそう
				ELSE
					PRINTFORMDL その顔は、少々険しい。
					PRINTFORMDW ちょっと強引過ぎたかな、と、%CALLNAME:MASTER%は心中思った。
				ENDIF
			;キス経験済みだよ
			ELSE
				PRINTFORML 
				PRINTFORML 「……ん……っ！？」
				PRINTFORMDL 唐突に口付けた%CALLNAME:MASTER%に、文は目を見開いて驚いている。
				PRINTFORML 「……んっ、んんっ、ふ、ん……っ」
				PRINTFORMDL 少しの間、文は息を荒くして、じたばたとしている。
				IF TALENT:恋慕
					PRINTFORMDL しかし、そのうち文は抵抗するのをやめ、%CALLNAME:MASTER%に身を任せた。
					PRINTFORML 「……ん……ふ、む……ちゅ、ん……」
					PRINTFORMDL 時折、舌を絡めてくるかのように動かしてくる。
					PRINTFORML 「ん、ちゅ、ふ、ぁ……ぷぁ……ん……」
					PRINTFORMDW 少しして口を離すと、文の顔は上気し、とろんとしていた。
				ELSEIF TALENT:思慕
					PRINTFORMDL しかし、そのうち文は抵抗するのをやめ、%CALLNAME:MASTER%に身を任せた。
					PRINTFORMDL %CALLNAME:MASTER%が口を離すと、文の顔は真っ赤に上気していた。
					PRINTFORML 「は、ぁ……%CALLNAME:MASTER%さんって……結構、強引なんですね……」
					PRINTFORMDW どこか恥ずかしそうに、文はそういった。
				ELSE
					PRINTFORML 「んっ、ん、ぷぁ、な、何をするんですかっ！」
					PRINTFORMDL それから文は、無理やり口を離して、抗議してきた。
					PRINTFORMDL その顔は少し険しく、怒っているようにも見える。
					PRINTFORMDW 少しだけ、早かったかも知れない……。
				ENDIF
			ENDIF
		;押し倒され中
		ELSEIF CFLAG:うふふ ==2
			IF TCVAR:20 == 50
				IF TALENT:2 & 2
					PRINTFORML 
					PRINTFORML 「……どう？　%CALLNAME:MASTER%……」
					PRINTFORMDL %CALLNAME:MASTER%は肉棒をしごく文を抱き寄せ、口づけた。
					IF TALENT:恋慕
						PRINTFORML 「ふ、んっ……む、ちゅ……%CALLNAME:MASTER%……%CALLNAME:MASTER%っ……%UNICODE(0x2665)%」
						PRINTFORMDL 文は完全にとろけた顔で、%CALLNAME:MASTER%の名を呼ぶ。
						PRINTFORMDW その口の端からはよだれが漏れていて、%CALLNAME:MASTER%の情欲を煽った……。
					ELSE
						PRINTFORML 「……ん、むっ……ん、ちゅ……」
						PRINTFORMDL 文は若干苦しそうに、鼻から息を漏らしている。
						PRINTFORMDW 一瞬、肉棒をしごくその手が、さらに射精を促す艶かしい動きになった。
					ENDIF
				ELSE
					PRINTFORML 
					PRINTFORML 「……ふふ、%CALLNAME:MASTER%……どう……？」
					PRINTFORMDL 文は%CALLNAME:MASTER%の体をまさぐりながら、甘く囁いてくる。
					PRINTFORMD %CALLNAME:MASTER%が答えの代わりに口づけを寄越すと、
					IF TALENT:恋慕
						PRINTFORMDL 文は途端に頬を緩ませて、
						PRINTFORML 「ん、ちゅ、むぅっ……は、はっ、はぁっ、そう……いい、のね……」
						PRINTFORMDW と、また甘く蟲惑的な声を、%CALLNAME:MASTER%の耳にかけた。
					ELSE
						PRINTFORML 「……ん、む……ちゅ……はぁっ……気持ち、いいのね……？」
						PRINTFORMDW と、今度は魅力的な声を耳元で囁いて、愛撫の手を早めた。
					ENDIF
				ENDIF
			ELSEIF TCVAR:20 == 60
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORMDL %CALLNAME:MASTER%は、文の口内へ舌を挿入れた。
					PRINTFORML 「む、んっ……ちゅ、は、ぁっ……ん、むぅっ……ちゅる、ちゅっ……」
					PRINTFORMDL その口づけの濃厚さに、文は堪らず、体をがくがくと震わせた。
					PRINTFORMDW その顔は、幸福感と情愛に蕩けきっている……。
				ELSE
					PRINTFORML 
					PRINTFORMDL %CALLNAME:MASTER%は、口内を蹂躙してくる文の舌に自ら舌を絡めた。
					PRINTFORML 「ん、むっ……ちゅ、ちゅっ、む、ん、ふぅっ……」
					PRINTFORMDL 文は貪るように、さらに激しく頬の内側を愛撫してくる。
					PRINTFORMDW お互いが満足するまで、文と%CALLNAME:MASTER%は口づけを続けた……。
				ENDIF
			ELSE
				PRINTFORML 
				PRINTFORML 「……%CALLNAME:MASTER%……」
				PRINTFORMDL 文は%CALLNAME:MASTER%の名を呼び、唇をこちらの唇に近づけてきた。
				IF TALENT:恋慕
					PRINTFORMDL こちらからその唇を貪ると、文は、
					PRINTFORML 「ふ、んむっ……ちゅ、む……ぷ、はっ……%CALLNAME:MASTER%、%CALLNAME:MASTER%っ……%UNICODE(0x2665)%」
					PRINTFORMDL と、腰を砕けさせて、とろけた甘い声を上げた。
					PRINTFORMDW その顔は、幸せそうである……。
				ELSE
					PRINTFORMDL %CALLNAME:MASTER%は抵抗せずに、文の唇を受け入れた。
					PRINTFORML 「ふ、むっ……ちゅ、んっ、は、む……」
					PRINTFORMDW その貪るような口づけに、%CALLNAME:MASTER%はされるがままとなっていた……。
				ENDIF
			ENDIF
		;前回膝枕
		ELSEIF PREVCOM == 305
			IF TALENT:恋慕
				PRINTFORML 
				PRINTFORML 「……んうっ……む、ちゅっ……」
				PRINTFORMDL 文は急に%CALLNAME:MASTER%が口づけてきたので、少し驚いている。
				PRINTFORMDL しかしその顔はすぐに綻び、緩み、とろけた。
				PRINTFORML 「……ぷぁ……いきなりは、だめですよぉ……」
				PRINTFORMDW 体重をこちらにかけてきながら、文は、甘い小さな悲鳴を上げた。
			ELSE
				PRINTFORML 
				PRINTFORML 「……んっ……ちゅ、ん、ぅっ……」
				PRINTFORMDL 文は急に%CALLNAME:MASTER%が口づけてきたので、少し驚いている。
				PRINTFORML 「……んっ、んー……っ、ぷはっ……な、なんで、急に、するんですかぁっ……」
				PRINTFORMDW 文は顔を真っ赤にして、抗議してきた。
			ENDIF
		ELSEIF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORML 「……%CALLNAME:MASTER%、さん……口づけてください」
					PRINTFORMDL 文は口づけへの期待感だけで上気した顔をこちらに向け、願ってきた。
					PRINTFORMDL %CALLNAME:MASTER%は望むとおりに、その淡い桃色の唇に軽く口づけた。
					PRINTFORML 「んっ……そんな、触れるだけなんて、足りませんよぉ……」
					PRINTFORMDL 文は堪らなさそうに、こちらの首に腕を回してきた。
					PRINTFORMDW あまり焦らすのもかわいそうなので、%CALLNAME:MASTER%は深い口づけを交わした。
				CASE 1
					PRINTFORML 
					PRINTFORMDL %CALLNAME:MASTER%は不意に、文に口づけた。
					PRINTFORML 「……んうっ……ちゅ、ふ、んむっ……」
					PRINTFORMDL 体をびくりとさせて、文は驚いている。
					PRINTFORMDL しかし、やがてその体からは力が抜けて行った。
					PRINTFORML 「ちゅ、む、ん……ぷぁっ……%CALLNAME:MASTER%……%UNICODE(0x2665)%」
					PRINTFORMDW その顔は蕩けきっていて、情欲に塗れていた……。
					;目がハートになってそうな文さんですね。
			ENDSELECT
