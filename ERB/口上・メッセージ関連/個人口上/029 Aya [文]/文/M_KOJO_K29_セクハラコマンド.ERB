;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K29_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K29_310
CALL M_KOJO_MESSAGE_COM_K29_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야의 엉덩이에 손을 뻗었다.
		PRINTFORMDL 푸니, 하고 감촉이 돌아와서 기분이 좋다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")%, 점점 즐거워지고 있었다……
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
			PRINTFORML 
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야의 엉덩이에 손을 뻗는다.
			PRINTFORMDL 탄력이 있으면서도 너무 단단하지 않은, 환상적인 감촉이 되돌아온다.
			PRINTFORMDL 아야는 그 손길을 뿌리치지 않고, 있는 그대로 받아들이고 있다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그대로 아야의 엉덩이를 계속 주무르기 시작했다.
		ELSE
			PRINTFORML 
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야의 엉덩이에 손을 뻗는다.
			PRINTFORMDL 살짝, 하고 닿은 순간, 아야의 손이 %조사처리(CALLNAME:MASTER,"의")% 손을 쳐냈다.
			PRINTFORMDL 남무삼, 깨어 있었나.
			PRINTFORMDL 그렇게 생각했지만, 아야는 깨어 있지 않았다.
			PRINTFORMDL 아무래도 무의식적인 행동이었던 모양이다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 후우, 하고 한숨을 쉬었다.
		ENDIF
	ELSE
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 
			PRINTFORML 「……앗!? 뭐, 뭐 하시는 거예요!?」
			PRINTFORMDL 아야는 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리친다.
			PRINTFORML 「……갑자기 엉덩이를 만지다니, 이, 이 변태아!」
			PRINTFORMDL 얼굴을 새빨갛게 물린 채, 아야는 항의하고 있다.
			PRINTFORMDW 너무 계속하다가는 볼에 홍조가 생길 것만 같다.
		ELSEIF PREVCOM == 305
			IF TFLAG:193 == 4
				PRINTFORML 
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 무릎 베개를 한 채로, 아야의 엉덩이에 손을 댔다.
				PRINTFORML 「힉, 응…… 이제, 뭐 하시는 거예요」
				PRINTFORMDL 아야는 뺨을 붉히면서도, 그대로 당하고 있다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 방긋 웃으며, 엉덩이를 계속 주무르기 시작했다.
			ELSE
				PRINTFORML 
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 무릎 베개를 한 채, 아야의 엉덩이에 손을 댔다.
				PRINTFORML 「햐앗...? 뭐, 뭐 하시는 거예요!」
				PRINTFORMDL 아야는 탁, 하고 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다.
				PRINTFORMDW 그 얼굴에는 부끄러움과 분노가 뒤섞여 있었다……
			ENDIF
		ELSEIF TFLAG:193 == 1
			PRINTFORML 
			PRINTFORML 「……엣!? 그, 그만둬욧!」
			PRINTFORMDL 아야는 %조사처리(CALLNAME:MASTER,"의")% 손을 세게 뿌리쳤다.
			PRINTFORML 「……갑자기 뭘……」
			PRINTFORMDW 아야는 불쾌한 듯 이쪽을 노려보고 있다.
		ELSEIF TFLAG:193 == 2 || TFLAG:193 == 3
			PRINTFORML 
			PRINTFORML 「……히얏!? 아, 잠, 잠깐만요, 그만해 주세요……」
			PRINTFORMDL 아야는 볼을 붉히며 `%CALLNAME:MASTER%`의 손을 뿌리쳤다.
			PRINTFORML 「……너무 그런 건……하지 말아 주세요?」
			PRINTFORMDW `%CALLNAME:MASTER%`의 손을 잡은 채, 아야가 말했다.
		ELSEIF TFLAG:193 == 4
			PRINTFORML 
			PRINTFORML 「햐, 윽!? ……모, 모우, 나니 스루ㄴ데스카아……」
			PRINTFORMDL 아야는 놀란 듯 비명을 질렀다.
			PRINTFORML 「……호도호도니, 시테쿠다사이네……?」
			PRINTFORMDW 아야는 부끄러운 듯 그렇게 말했다.
		ELSE
			PRINTFORML 
			PRINTFORML 「……윽……뭐, 하시는 거예요……」
			PRINTFORMDL 아야는 부끄러워하고 있다.
			PRINTFORML 「……적당히 해주세요……?」
			PRINTFORMDW 부끄러움에 신음하면서도, 아야는 내버려졌다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K29_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K29_311
CALL M_KOJO_MESSAGE_COM_K29_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%, 시간을 멈춘 채 아야에게 안겨보았다.
		PRINTFORMDL 아야는 표정 하나 바꾸지 않은 채, 끌어안긴 상태로 있다.
		PRINTFORMDW 그대로 머리를 쓰다듬어 보았지만 시시하게 느껴져, %조사처리(CALLNAME:MASTER,"는")% 아야에게서 떨어졌다.
	ELSEIF CFLAG:睡眠
		PRINTFORML 
		PRINTFORML 「스윽…… 응……」
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 잠든 아야에게 안겼다.
		IF TALENT:恋慕
			PRINTFORML 「후……%CALLNAME:MASTER%……씨……」
			PRINTFORMDL 작게 %조사처리(CALLNAME:MASTER,"의")% 이름을 부르며, 아야는 %조사처리(CALLNAME:MASTER,"의")% 가슴에 볼을 비빈다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 상냥하게 그 머리를 쓰다듬었다.
		ELSEIF TALENT:思慕
			PRINTFORML 「……응…… %조사처리(CALLNAME:MASTER,"는")%……」
			PRINTFORMDL 갑자기 아야는 %조사처리(CALLNAME:MASTER,"를")% 껴안아 되돌려 안았다.
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 잠시 놀랐지만, 그대로 끌어안은 채 머물렀다.
			PRINTFORMDW 옆에서 보기에는 음란한 짓을 하고 있는 것처럼밖에 보이지 않았다.
		ELSE
			PRINTFORML 「……응, 음……으으……」
			PRINTFORMDW 아야는 작게, 잠 못 이루는 듯 신음했다.
		ENDIF
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORMDL 아야.
					PRINTFORML 「뭔데요? %CALLNAME:MASTER%씨……응읏, 벌써……」
					PRINTFORML 「……어쩔 수 없네요」
					PRINTFORMDL 아야는 얼굴을 붉히며 내버려져 있다.
					PRINTFORML 「……%CALLNAME:MASTER%씨…… 정말 좋아해요……」
					PRINTFORMDW 감격한 듯, 아야는 그렇게 귀에 속삭였다.
				CASE 1
					PRINTFORML 
					PRINTFORML 「……%CALLNAME:MASTER%, 씨?」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야에게부터 껴안았다.
					PRINTFORML 「저, 저기요, %CALLNAME:MASTER%씨…… 가슴은, 안 돼요…… 음윽」
					PRINTFORMDL 얼굴을 묻고 심호흡한다.
					PRINTFORML 「아, 안 돼요…… 옷을…… 옷을 벗고 나서……」
					PRINTFORMDW 그렇게 말하면서도 진심으로 저항하지 않는 것으로 보아, 만족하는 모양이다.
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORML 「응읏…… 무슨 일이에요, 갑자기……」
					PRINTFORMDL 그냥 좀 안아주고 싶어졌으니까.
					PRINTFORML 「……그, 이상한 데 만지면 안 돼요?」
					PRINTFORMDW 아야는 미소 지으며 말했다.
				CASE 1
					PRINTFORML 
					PRINTFORML 「……%조사처리(CALLNAME:MASTER,"는")%……씨……?」
					PRINTFORMDL ……아야의 몸이 부드럽다.
					PRINTFORML 「……그런가요……후후……」
					PRINTFORMDL 아야는 미소를 지으며 되안아왔다.
					PRINTFORMDL 형언할 수 없는 부드러운 감촉이 전신을 감싼다.
					PRINTFORMDW 행복감을 느끼며, %조사처리(CALLNAME:MASTER,"는")% 아야의 몸의 감촉을 즐겼다.
			ENDSELECT
		ELSEIF TALENT:思慕
			;PRINTDATA
			;	DATALIST
			PRINTFORML 
			PRINTFORML 「……무슨 일이세요, %조사처리(CALLNAME:MASTER,"는")%」
			PRINTFORMDL 좀 사람의 온기가 그리워졌는데, 안 될까?
			PRINTFORML 「……아뇨, 안 된다는 건…… 그런 게 아니라……」
			PRINTFORMDL 아야는 약간 당황한 듯 그렇게 말한다.
			PRINTFORMDW 거절당한 것은 아니었기에, %조사처리(CALLNAME:MASTER,"는")% 잠시 동안 아야의 온기를 느꼈다.
			;	ENDLIST
			;ENDDATA
		ELSE
			;PRINTDATA
			;	DATALIST
			PRINTFORML 
			PRINTFORML 「……읏, 저, 뭐 하시는 거예요!」
			PRINTFORMDL 아야는 꿈틀거리며 어색하게 몸부림친다.
			PRINTFORMDL 안아주는 느낌이 좋지 않았던 %조사처리(CALLNAME:MASTER,"는")% 금세 떨어졌다.
			PRINTFORML 「……무슨 생각에 빠진 걸까……」
			PRINTFORMDW 아야는 중얼거리고 있다.
			;	ENDLIST
			;ENDDATA
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K29_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K29_312
CALL M_KOJO_MESSAGE_COM_K29_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 시간을 멈춘 채, 아야에게 입을 맞추었다.
		PRINTFORMD 만약 시간이 움직이고 있었다면,
		IF TALENT:恋慕
			PRINTFORMDL 아야는 뺨을 물들이며 부끄러워했을 것이다.
		ELSE
			PRINTFORMDL 아야는 허둥지둥 발버둥 치며 저항했을 것이다.
		ENDIF
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그대로 아야의 입술을 탐하기를 계속했다…….
	ELSEIF CFLAG:睡眠
	ELSE
		;嫌がられる (custom - put here above the successful attempt)
		IF TFLAG:193 == 99
			PRINTFORML 
			PRINTFORML 「……읏……그만두세요」
			PRINTFORMDL 아야는 뒷걸음질 치며 입술을 갈구해 온 %CALLNAME:MASTER%에게서 떨어졌다.
			PRINTFORML 「……그만두세요, 가까이 오지 마세요」
			PRINTFORMDW 그 거절하는 몸짓에, 별것 아닌 일로 상처받은 %CALLNAME:MASTER%였다.
		ELSEIF FIRSTTIME(SELECTCOM)
			;経験豊富に見えて実は初心な文、実に良い。
			;キス未経験だよ　スレで指摘があったから直したよ
			IF EXP:キス経験 == 1
				PRINTFORML 
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%, 조용히 아야의 입술에 키스했다.
				PRINTFORMDL 그저 접촉만 하는,
				PRINTFORML 「……엣……? ……에?」
				PRINTFORMDL 아야는 무슨 일이 일어났는지 파악하지 못한 듯하다.
				PRINTFORML 「……잠깐, 뭐, 뭘 하시는 거예요!」
				PRINTFORMDL 몇 초 뒤, 아야의 얼굴이 새빨갛게 물든다.
				PRINTFORML 「하, 하, 처음이었는데에엣...!」
				PRINTFORMDL 눈물 어린 채로, 아야는 외친다.
				;そこまで想ってるならさっさとしてるだろ状態
				IF TALENT:恋慕
					PRINTFORMDL 하지만 그 뺨은 싱글벙글 풀려 있다.
					PRINTFORMDW 아야는 이보다 더 기쁠 수 없을 정도로 행복해하고 있다…….
					;妥当
				ELSEIF TALENT:思慕
					PRINTFORMDL 하지만, 살짝 그 볼이 풀려 있다.
					PRINTFORMDW 아야는 그렇게 외치면서도 어딘가 기뻐 보인다…….
					;結構反感買いそう
				ELSE
					PRINTFORMDL 그 얼굴은, 조금 험악하다.
					PRINTFORMDW 좀 너무 강압적이었을까 하고, %조사처리(CALLNAME:MASTER,"는")% 속으로 생각했다.
				ENDIF
				;キス経験済みだよ
			ELSE
				PRINTFORML 
				PRINTFORML 「……응……앗!?」
				PRINTFORMDL 갑작스럽게 입을 맞춘 %조사처리(CALLNAME:MASTER,"에게")%, 아야는 눈을 크게 뜨고 놀라고 있다.
				PRINTFORML 「……흡, 음음, 후, 응……읏」
				PRINTFORMDL 잠시 동안, 아야는 숨을 거칠게 몰아쉬며 허둥지둥하고 있다.
				IF TALENT:恋慕
					PRINTFORMDL 하지만, 어느새 아야는 저항을 멈추고 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡겼다.
					PRINTFORML 「……응…… 후, 음…… 츄, 응……」
					PRINTFORMDL 이따금 혀를 얽어오는 것처럼 움직여 온다.
					PRINTFORML 「응, 츄, 푸, 아…… 푸앙……」
					PRINTFORMDW 잠시 후 입술을 떼자, 아야의 얼굴은 상기되어 몽롱해져 있었다.
				ELSEIF TALENT:思慕
					PRINTFORMDL 하지만 어느새 아야는 저항하는 것을 그만두고 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡겼다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 입술을 떼자, 아야의 얼굴은 새빨갛게 상기되어 있었다.
					PRINTFORML 「하, 하아…… %CALLNAME:MASTER%씨는…… 꽤나 강압하시네요……」
					PRINTFORMDW 어딘가 부끄러운 듯, 아야는 그렇게 말했다.
				ELSE
					PRINTFORML 「응읏, 응, 푸아, 나, 뭐 하시는 거예요!」
					PRINTFORMDL 그러고는 아야가 억지로 입술을 떼며 항의했다.
					PRINTFORMDL 그 얼굴은 조금 굳어 있었고, 화가 난 것처럼 보이기도 했다.
					PRINTFORMDW 아주 조금, 빨랐을지도 모른다……
				ENDIF
			ENDIF
			;押し倒され中
		ELSEIF CFLAG:うふふ ==2
			IF TCVAR:20 == 50
				IF TALENT:2 & 2
					PRINTFORML 
					PRINTFORML 「……어때? %조사처리(CALLNAME:MASTER,"는")%……」
