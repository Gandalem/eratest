IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;基本セット
	;装着
	IF TEQUIP:クリキャップ
		IF FLAG:時間停止 && FIRSTTIME(TOSTR(SELECTCOM) + "_TS")
			PRINTFORML 
			PRINTFORMDL 시간을 멈춘 채, %조사처리(CALLNAME:MASTER,"는")% 전원을 넣는다.
