;==================================================
;82,パイズリ (custom code added)
;==================================================
@M_KOJO_MESSAGE_COM_K29_82
CALL M_KOJO_MESSAGE_COM_K29_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕 || ABL:奉仕精神 >= 3
			PRINTFORML 「胸でですか？私のはそこまで大きくないですけど…」
			PRINTFORMW 「こんな感じですかね？なかなか上手く挟めませんね…」
		ELSE
			PRINTFORML 「胸でですか？…私そこまで巨乳じゃないですよ？」
			PRINTFORMW 「できるんですかね…、とりあえずやってみますか…」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF GET_BUSTSIZE(TARGET) > 0 && RAND:3
			PRINTFORMW 「ふふっ、これだけ大きいと、やっぱりやりがいがありますね…♪」
			PRINTFORMW 「んっ、ふっ…、ほら、どうです？おっぱい熱くて気持ちいいですよね？」
			PRINTFORMW 「私もすっかり気持ちよくなってきましたよ…♪ こんな良いおっぱいにしてくれて、ありがとうございます、%CALLNAME:MASTER%…♪」
		ELSE
			IF RAND:2
				PRINTFORMW 「これ、胸がオマンコみたいですね…♪」
				PRINTFORMW 「私も気持ちいいですし、%CALLNAME:MASTER%も気持ちいいんですよね？もう最高です…♪」
			ELSE
				PRINTFORMW 「ふっ、ふぅっ…♪どうですか%CALLNAME:MASTER%？気持ちいいですか？」
				PRINTFORMW 「これ、私も気持ちいいので気に入ってるんですよ♪んっ…、おっぱいが熱いです…♪」
				PRINTFORMW 「これだけ使っていればいつか大きくなりますかね？ちょっと期待してるんですよ…♪」
			ENDIF
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		IF TALENT:MASTER:形状 >= 5
			PRINTFORMW 「ちょっと無理がありますよ、%CALLNAME:MASTER%のが大きすぎるんです…」
		ELSEIF GET_BUSTSIZE(TARGET) <= 0
			PRINTFORMW 「んっ、ふっ…」
			PRINTFORMW 「う～ん、やっぱり私の胸だとサイズが合いませんね…」
		ELSE
			PRINTFORMW 「どうです？大きくなった分、やっぱり気持ちいいですよね？」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

