	;時姦中
	IF FLAG:70
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF !RAND:3 ;added
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「んしょっ…、どうですか？気持ちいいですか？」
