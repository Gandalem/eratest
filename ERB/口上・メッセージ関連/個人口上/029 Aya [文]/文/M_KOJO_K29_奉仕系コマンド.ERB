@M_KOJO_MESSAGE_COM_K29_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 
			PRINTFORML 「……ん、手で？」
			PRINTFORMDL %CALLNAME:MASTER%が頼むと、文はそう聞き返してきた。
			PRINTFORML 「……うん、わかった……上手には、できないだろうけど……」
			PRINTFORMDL そう言って、文はおずおずと%CALLNAME:MASTER%の一物に手を伸ばす。
			PRINTFORML 「……すごい、びくびくしてる……」
			PRINTFORMDL 物珍しそうに、文はまじまじと%CALLNAME:MASTER%の一物を見つめる。
			PRINTFORML 「……う、わ……すっごく熱いわね……」
			PRINTFORMDW ひんやりとした小さい手で一物を握り、文は少し驚いたように声を上げる。
			PRINTFORMDL それから、文はおずおずと手を動かし始めた。
			PRINTFORML 「……気持ち良い？　そ、そう？　なら良かったわ……」
			PRINTFORMDL %CALLNAME:MASTER%が頷くと、文は安心したのか頬を緩めた。
			PRINTFORMDL それから、文は少し趣向を凝らして一物を弄る。
			PRINTFORMDL 先のほうをこすったり、息を吹きかけたり。
			PRINTFORMDW 一物が少し大きく脈動するのを感じるたび、文の顔はどこか楽しそうになっていった。
		ELSE
			PRINTFORML 
			PRINTFORML 「……ん、手で、ですか？」
			PRINTFORMDL %CALLNAME:MASTER%が頼むと、文はそう聞き返してきた。
			PRINTFORML 「……はい、わかりました……上手には、できませんでしょうが……」
			PRINTFORMDL そう言って、文はおずおずと%CALLNAME:MASTER%の一物に手を伸ばす。
