;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K29_100
CALL M_KOJO_MESSAGE_COM_K29_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「히야아!... 갑자기 때리는 건 무슨 일입니까!?」
		ELSE
			PRINTFORMW 「엣...? 헉, 히익!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:マゾっ気 >= 5
			IF RAND:2 == 0
				PRINTFORML 「아프면서 기분 좋다는 건...♪」
				PRINTFORML 「이렇게 변태가 될 줄은 몰랐어요, 저는. 기분이 좋으니까 괜찮지만... 아앗♪」
				PRINTFORMW 「더..., 더 때뤄 주세요♪」
			ELSE
				PRINTFORML 「아앗, 좋다...♪ 더 때려주세요...♪」
				PRINTFORMW 「히야앗! 아앗, 맞는 게 이렇게 기분 좋을 줄이야...♪」
			ENDIF
		ELSEIF ABL:マゾっ気 >= 3
			PRINTFORML 「최근에 맞히는 게 기분 좋아지기 시작했어요.」
			PRINTFORML 「혹시 처음부터 이렇게 하려고 했던 거예요? 그렇다면 기쁘지만...♪」
			PRINTFORMW 「아앗! ...좋아요...♪」
		ELSE
			PRINTFORMW 「그렇게 많이 때리지 않아도 %조사처리(CALLNAME:MASTER,"는")% 더 이상 거역하지 않아요...」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF ABL:マゾっ気 >= 3
		PRINTFORML 「왜... 이런 게 기분 좋을 리가...」
		PRINTFORMW 「앗, 아아악!」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「맞아봤자... 으윽!」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
