;104,アイマスク
;==================================================

@M_KOJO_MESSAGE_COM_K29_104
CALL M_KOJO_MESSAGE_COM_K29_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF FIRSTTIME(SELECTCOM)
			IF TALENT:恋慕
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 보이지 않다니, 무서워요...」
				PRINTFORMW 「계속 곁에 있어 주세요?」
			ELSE
				PRINTFORMW 「보이지 않는 편이 아직 좋으니까 부디」
			ENDIF
			RETURN 1
		ENDIF
		IF TALENT:恋慕
			IF ABL:マゾっ気 >= 5
				IF RAND:2 == 0
					PRINTFORML 「눈가리기를요...」
					PRINTFORMW 「눈가리기를 한 다음엔 뭘 해줄 건지 궁금해요? 벌써 두근거리네요♪」
				ELSE
					PRINTFORML 「눈을 가리고, 뭘 할 생각이에요?」
					PRINTFORMW 뭔가 짜릿해요, 기대해버렸어요...♪
				ENDIF
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORML 「눈가리기를 말하는 건가요...」
				PRINTFORMW 「요즘, 눈을 가한 사이에 다음에 무엇을 하실지 생각하는 게 즐겁거든요. 기대하고 있어요?」
			ELSE
				PRINTFORML 「역시 못 보면 무서워요...」
				PRINTFORMW 「부탁이니까 곁에 있어 주세요?」
			ENDIF
			;屈服3
		ELSEIF ABL:マゾっ気 >= 3
			PRINTFORML 「으윽... 도대체 무슨 짓을 하려는 겁니까...?」
			PRINTFORMDW 눈가리개를 한 몸의 사타구니에서는 애액이 흘러내리고 있었다...
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「보이지 않는다고 해서 무엇을 해도 되는 건 아니지만 말이야...」
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF FIRSTTIME(TOSTR(SELECTCOM) + "_REMOVE")
			IF TALENT:恋慕
				PRINTFORML 「흠, 이렇게 눈가리기를 당한 후에 다시 %조사처리(CALLNAME:MASTER,"를")% 보니」
				PRINTFORMW 「뭐랄까, 사랑스러워서 견딜 수가 없네요 혹시 이걸 노리고 있었나요?」
			ELSE
				PRINTFORMW 「벗으시는 건가요, 뭐 당하는 일은 변하지 않겠지만...」
			ENDIF
			RETURN 1
		ENDIF
		IF TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORML 「역시, %조사처리(CALLNAME:MASTER,"가")% 보이는 쪽이 좋네요」
				PRINTFORML 「이렇게 할 수도 있잖아요♪」
				PRINTFORMDW 그렇게 말하자, 문은 %조사처리(CALLNAME:MASTER,"에게")% 안겼다.
			ELSE
				PRINTFORML 「흠, 이렇게 눈가리기를 당한 후에 다시 %조사처리(CALLNAME:MASTER,"를")% 보니」
				PRINTFORMW 「뭐랄까, 사랑스러워서 견딜 수가 없네요 혹시 이걸 노리고 있었나요?」
			ENDIF
			;それ以外
		ELSE
			PRINTFORMW 「벗으시는 건가요, 뭐 당하는 일은 변하지 않겠지만...」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
