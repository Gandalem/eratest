;==================================================
;100,スパンキング
;==================================================
@M_KOJO_MESSAGE_COM_K29_100
CALL M_KOJO_MESSAGE_COM_K29_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「ひゃあ！…いきなり叩くなんて、どういう事ですか！？」
		ELSE
			PRINTFORMW 「えっ・・・？ひっ、ひいっ！」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:マゾっ気 >= 5
			IF RAND:2 == 0
				PRINTFORML 「痛いのに気持ちいいなんて…♪」
				PRINTFORML 「ここまで変態になっちゃうなんて思いませんでしたよ私、気持ちいいから良いですけど…ああっ♪」
				PRINTFORMW 「もっと…、もっとぶって下さい♪」
			ELSE
				PRINTFORML 「ああっ、いいっ…♪もっとぶってください…♪」
				PRINTFORMW 「ひゃああっ！ああっ、叩かれるのがこんなに気持ちいいなんて…♪」
			ENDIF
		ELSEIF ABL:マゾっ気 >= 3
			PRINTFORML 「最近、叩かれるのが気持ちよくなって来たんですよね」
			PRINTFORML 「もしかして最初からこうするためにやってたんですか？それなら嬉しいですけど…♪」
			PRINTFORMW 「ああっ！…気持ちいいですっ…♪」
		ELSE
			PRINTFORMW 「そんなに叩かなくても%CALLNAME:MASTER%にはもう逆らわないですよぉ…」
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF ABL:マゾっ気 >= 3
		PRINTFORML 「なんで…、こんなのが気持ちよくなんて…」
		PRINTFORMW 「あっ、あああっ！」
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「叩かれたところで…、ううあっ！」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;104,アイマスク
;==================================================
@M_KOJO_MESSAGE_COM_K29_104
CALL M_KOJO_MESSAGE_COM_K29_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF FIRSTTIME(SELECTCOM)
			IF TALENT:恋慕
				PRINTFORML 「%CALLNAME:MASTER%が見えないなんて、怖いですよぉ…」
				PRINTFORMW 「ずっとそばにいて下さいよ？」
			ELSE
				PRINTFORMW 「見えない方がまだ良いですからどうぞ」
			ENDIF		
			RETURN 1
		ENDIF
	
		IF TALENT:恋慕
			IF ABL:マゾっ気 >= 5
				IF RAND:2 == 0
					PRINTFORML 「目隠しですか…」
					PRINTFORMW 「目隠しをした次は何をしてくれるんですかね？もうワクワクですよ♪」
				ELSE
					PRINTFORML 「目隠しをして、何をするつもりなんですか？」
					PRINTFORMW 「なんだかゾクゾクしますよ、期待しちゃって…♪
				ENDIF
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORML 「目隠しですか…」
				PRINTFORMW 「最近、目隠しされてる間に次に何をされるか考えるのが楽しみなんですよね、期待してますよ？」
			ELSE
				PRINTFORML 「やっぱり見えないと怖いですよぉ…」
				PRINTFORMW 「お願いですからそばにいて下さいね？」
			ENDIF
		;屈服3
		ELSEIF ABL:マゾっ気 >= 3
			PRINTFORML 「うぅ…、一体何をする気ですか…？」
			PRINTFORMDW 目隠しされた文の股間からは愛液が零れていた…
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「見えないからと言って何をしても良いわけではないんですけどね…」
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF FIRSTTIME(TOSTR(SELECTCOM) + "_REMOVE")
			IF TALENT:恋慕
				PRINTFORML 「ふむ、こうして目隠しをされた後にあらためて%CALLNAME:MASTER%を見てみると」
				PRINTFORMW 「何というか、愛しくてたまらないですね もしかしてこれを狙ってました？」
			ELSE
				PRINTFORMW 「外すんですか、まあやられることは変わらないんでしょうけど…」
			ENDIF		
			RETURN 1
		ENDIF
		
		IF TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORML 「やっぱり、%CALLNAME:MASTER%が見える方が良いですよ」
				PRINTFORML 「こうすることができますしね♪」
				PRINTFORMDW そう言うと、文は%CALLNAME:MASTER%に抱きついてきた
			ELSE
				PRINTFORML 「ふむ、こうして目隠しをされた後にあらためて%CALLNAME:MASTER%を見てみると」
				PRINTFORMW 「何というか、愛しくてたまらないですね もしかしてこれを狙ってました？」
			ENDIF
		;それ以外
		ELSE
			PRINTFORMW 「外すんですか、まあやられることは変わらないんでしょうけど…」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;105,縄
;==================================================
@M_KOJO_MESSAGE_COM_K29_105
CALL M_KOJO_MESSAGE_COM_K29_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------

	;基本セット
	;装着
	IF TEQUIP:縄
		IF FIRSTTIME(SELECTCOM)
			IF TALENT:恋慕
				PRINTFORML 「縛るんですか？私、何も御奉仕できなくなっちゃうけど良いんですか？」
				PRINTFORMW 「そうですか…、仕方ないですね」
			ELSE
				PRINTFORMW 「縛って何をするつもりですか、一体…」
			ENDIF		
			RETURN 1
		ENDIF
	
		IF TALENT:恋慕
			IF ABL:マゾっ気 >= 5
				IF RAND:2 == 0
					PRINTFORML 「あっ…、今日も縛ってくれるんですね♪」
					PRINTFORMW 「縄で縛られて感じちゃう変態マゾ天狗の射命丸文をお楽しみあれ…、ああんっ♪」
				ELSE
					PRINTFORML 「ああっ、きつい…♪」
					PRINTFORMW 「この感触がたまらないんですよね、これ…♪」
				ENDIF
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORML 「縛られるのも最近好きになってきたんですよね」
				PRINTFORMW 「この締め付けられる感覚がたまらなくて…♪もう少しきつめに締めて良いですよ？」
			ELSE
				PRINTFORML 「また縛るんですか…」
				PRINTFORMW 「私の方から何もできないので、あんまり好きじゃないんですよね…」
			ENDIF
		;屈服3
		ELSEIF ABL:マゾっ気 >= 3
			PRINTFORMW 「ぐうっ！これ、きついのにぃ…♪」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「はぁ、はぁ… きついですよこれ…」
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF FIRSTTIME(TOSTR(SELECTCOM) + "_REMOVE")
			IF TALENT:恋慕
				PRINTFORML 「ふうっ…、やっと終わりですか」
				PRINTFORMW 「やっぱり動ける方が落ち着いて良いですね」
			ELSE
				PRINTFORMW 「ああもう、跡が残ってるじゃないですか…」
			ENDIF		
			RETURN 1
		ENDIF
		
		IF TALENT:恋慕
			IF ABL:マゾっ気 >= 5
				PRINTFORML 「あれっ、もう終わりですか？」
				PRINTFORMW 「もう少し縄の感触を楽しんでいたかったんですけど…」
			ELSE
				PRINTFORML 「やっぱり動ける方が良いですね♪」
				PRINTFORMDW そう言うと文は、%CALLNAME:MASTER%に抱きついてきた
			ENDIF
		;それ以外
		ELSE
			PRINTFORMW 「痣になっちゃってるじゃないですか…」
		ENDIF
	ENDIF
ENDIF
RETURN 1

