;105,縄
;==================================================

@M_KOJO_MESSAGE_COM_K29_105
CALL M_KOJO_MESSAGE_COM_K29_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;基本セット
	;装着
	IF TEQUIP:縄
		IF FIRSTTIME(SELECTCOM)
			IF TALENT:恋慕
				PRINTFORML 「묶으시는 건가요? 저, 아무것도 봉사할 수 없게 되는데 괜찮을까요?」
				PRINTFORMW 「그렇군요... 어쩔 수 없겠네요.」
			ELSE
				PRINTFORMW 「묶어서 뭘 할 생각이신 거예요, 대체…」
			ENDIF
			RETURN 1
		ENDIF
		IF TALENT:恋慕
			IF ABL:マゾっ気 >= 5
				IF RAND:2 == 0
					PRINTFORML 「앗…, 오늘도 묶어주시는군요 ♪」
					PRINTFORMW 「밧줄에 묶여서 느끼는 변태 마조 천둥의 샤메이마루 아야를 즐겨보세요… 아앙♪」
				ELSE
					PRINTFORML 「아앗, 괴로워...♪」
					PRINTFORMW 「이 감촉이 참 좋네요, 이거...♪」
				ENDIF
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORML 「묶이는 것도 요즘 좋아하게 됐어요」
				PRINTFORMW 「이 조여오는 감각이 참 견딜 수가 없어서...♪ 조금 더 세게 조여도 괜찮아요?」
			ELSE
				PRINTFORML 「또 묶는 건가요...」
				PRINTFORMW 「제가 아무것도 할 수 없으니까, 별로 좋아하지 않아요...」
			ENDIF
			;屈服3
		ELSEIF ABL:マゾっ気 >= 3
			PRINTFORMW 「크윽! 이거, 힘든데에...♪」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「하아, 하아... 이거 힘들어요...」
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF FIRSTTIME(TOSTR(SELECTCOM) + "_REMOVE")
			IF TALENT:恋慕
				PRINTFORML 「후우... 드디어 끝인가요」
				PRINTFORMW 「역시 움직일 수 있는 편이 마음이 놓이고 좋네요」
			ELSE
				PRINTFORMW 「아, 정말 흔적이 남아 있잖아요……」
			ENDIF
			RETURN 1
		ENDIF
		IF TALENT:恋慕
			IF ABL:マゾっ気 >= 5
				PRINTFORML 「어라, 벌써 끝인가요?」
				PRINTFORMW 「조금 더 밧줄의 감촉을 즐기고 싶었는데...」
			ELSE
				PRINTFORML 「역시 움직일 수 있는 쪽이 좋네요♪」
				PRINTFORMDW 그렇게 말하자 문은 %조사처리(CALLNAME:MASTER,"에게")% 달려들었다
			ENDIF
			;それ以外
		ELSE
			PRINTFORMW 「멍이 들고 있잖아요…」
		ENDIF
	ENDIF
ENDIF
RETURN 1
