;==================================================
;140,イラマチオ custom code expanded
;==================================================

@M_KOJO_MESSAGE_COM_K29_140
CALL M_KOJO_MESSAGE_COM_K29_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF ABL:奉仕精神 >= 3
			PRINTFORML 「응!? 윽, 음, 응!!」
			PRINTFORMW 「이건 격렬하네요..., 숨을 쉴 수가 없어요...」
		ELSE
			PRINTFORML 「응!? 음윽, 움, 응!!」
			PRINTFORMW 「콜록, 콜록... 뭐, 뭘 하시는 거예요!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF FLAG:70
	ELSEIF TALENT:恋慕 && ABL:奉仕精神 == 5
		IF RAND:2 == 0
			PRINTFORML 「아, 제 입에 몽키를 해 주시는군요...♪」
			PRINTFORMW 「음부욱... 음보쿠, 응응...♪ 어, 어떻습니까? 제 입의 몽키가 기분 좋은가요?」
		ELSE
			PRINTFORML 「음부벅! 흠…, 음부~옷! 음후~♪」
			PRINTFORMDW 문은 흐트러진 채 침을 흘리면서, %조사처리(CALLNAME:MASTER,"에게")% 격렬하게 입을 범당하는 감촉을 즐기고 있다.
		ENDIF
		RETURN 1
	ELSEIF ABL:奉仕精神 >= 3
		PRINTFORML 「응윽! 음읍! 음보옷! 쥽, 주르륵...」
		PRINTFORMW 「하아앗, 하아앗..., 격렬합니다...」
		;それ以外
	ELSE
		PRINTFORMW 「응, 윽!? 그런, 억지로 끼우지 마아... 응보옷!」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
