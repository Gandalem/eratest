;144,放尿
;==================================================

@M_KOJO_MESSAGE_COM_K29_144
CALL M_KOJO_MESSAGE_COM_K29_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「어째서 이런 곳을 봐야 하는 건가요... 아앗...!」 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF FLAG:70
	ELSEIF TALENT:恋慕 && ABL:露出癖 >= 5
		IF RAND:2 == 0
			PRINTFORML 「앗, 하아아아...♪ %CALLNAME:MASTER%... 제가 오줌 하는 곳을 제대로 봐 주세요...♪」
			PRINTFORML 「하앗..., 나온다! 아아아아앗...♪」
			PRINTFORMDW 문은 너무 강렬한 해방감에 무릎을 격하게 떨고 있다...
		ELSE
			PRINTFORML 「하아…♪%CALLNAME:MASTER%, 잘 봐주세요…♪」
			PRINTFORML 「아앗, 나올 것 같아, 나와버릴 것 같아…♪ 하아아앗…♪」
			PRINTFORMDL 문은 대량의 소변을 분출하며 몸을 떨고 있었다.
			PRINTFORMDW 방뇨가 끝난 문의 은밀한 곳은 소변 이외의 액체로 요사스럽게 빛나고 있었다.
		ENDIF
		RETURN 1
	ELSEIF ABL:露出癖 >= 5
		PRINTFORML 「앗, 하아... 저, 제 소변 보는 곳을, 보게 될지도 몰라요...♪」
		PRINTFORML 「보여도 괜찮은데에...♪」
		PRINTFORMDW 문은 너무 강렬한 해방감에 무릎을 격렬하게 떨고 있다...
		RETURN 1
	ELSEIF ABL:露出癖 >= 3
		PRINTFORMW 「하아... 으윽♪ 어째서, 나... 이런 곳이 보이고 있는데...♪」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「이, 이런 곳 보지 말아주세요... 아앗...!」
		PRINTFORMDW 문은 얼굴을 돌린 채 소변을 보고 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
