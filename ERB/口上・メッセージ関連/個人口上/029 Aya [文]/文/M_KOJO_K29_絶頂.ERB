LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	IF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3 ;added
		IF TALENT:恋慕
			PRINTFORML 「ああっ…♪私のおまんこの中でこんなに膨らんで、%CALLNAME:MASTER%もう出そうなんですか？」
			PRINTFORML 「はぁっ…♪我慢しなくて良いですよ、一緒にイキましょう…♪あああああっ…♪」
			PRINTFORMW 「一杯出ましたね…♪あっ、もう少しこのままでいていいですか？暖かくて良い気分なんですよ…♪」
		ELSE
			PRINTFORML 「あっ、ああっ…！あああああっ！！！」
			PRINTFORMW 「ああっ…、こんな…中に出されながらイクなんて…！」
		ENDIF
	ELSEIF TALENT:妊娠 == 1
		IF TALENT:恋慕
			PRINTFORML 「ひゃあっ！%CALLNAME:MASTER%ったら、子供が中にいるのに容赦無いですね…」
			PRINTFORML 「でも、中の子供も喜んでるみたいですね、ほら、こんなに動いて…♪」
			PRINTFORMW 「きっと%CALLNAME:MASTER%に似てるんでしょうね、この子は 産むのが楽しみですよ…♪」
		ELSE
			PRINTFORML 「ああっ！もう、また子供を作る気なんですか？」
			PRINTFORMW 「次からはちゃんと外にしてくださいね、これ以上子供ができても%CALLNAME:MASTER%は仕方ないでしょう？」
		ENDIF
	ELSEIF TALENT:恋慕 || TALENT:恋人 || TALENT:淫乱
		;選択コマンドが挿入子宮口責めもしくは種付けプレス
		IF SELECTCOM == 73
			IF RAND:3 == 0
				PRINTFORML 
				PRINTFORML 「……ぁ……子宮に……」
				PRINTFORML 「……もう入らないくらい、出されたかも……」
				PRINTFORMW 「……子供、できちゃうかも、ね……」
			ELSEIF RAND:2 == 0
				PRINTFORML 
				PRINTFORML 「……ぁ……こんなに、出して……」
				PRINTFORML 「……そんなに、孕ませたいの？」
				PRINTFORMW 「……もっと、注ぎ込んでも、良いわよ%UNICODE(0x2665)%」
			ELSE
				PRINTFORML 
				PRINTFORML 「……ん……出しすぎ……」
				PRINTFORML 「……ね、もっと、%CALLNAME:MASTER%……」
				PRINTFORMW 「孕んじゃうくらい、出してぇ……%UNICODE(0x2665)%」
			ENDIF
		ELSE
			IF !RAND:4 ;added
				IF RAND:2 == 0
					PRINTFORML 「はぁっ…♪一杯出ましたね、零れてきてますよ…♪」」
					PRINTFORMW 「でもまだ足りないです、もっともっと私の中で出してくださいね…♪」
				ELSE
					PRINTFORML 「あっ…♪出そうなんですか？我慢しなくて良いですよ？」
					PRINTFORMDL 文に促されると、%CALLNAME:MASTER%は勢い良く射精した
					PRINTFORMW 「ああっ、来てますっ…！…えへへ、こんなに出してくれるなんて私嬉しいです…♪」
				ENDIF
			ELSEIF RAND:3 == 0
				PRINTFORML 
				PRINTFORML 「……んっ……出てきちゃった……」
				PRINTFORML 「勿体無いわね……んっ……」
				PRINTFORMW 「……ほら、これで、こぼれないわ」
			ELSEIF RAND:2 == 0
				PRINTFORML 
				PRINTFORML 「……ん、出てきた……」
				PRINTFORML 「本当、熱いわね……どろっとしてて、ねばねばしてて……」
				PRINTFORMW 「……今度は、奥に……もっと、頂戴？」
			ELSE
				PRINTFORML 
				PRINTFORML 「……ぁ……もう……出しすぎじゃない？」
				PRINTFORML 「見ないでも分かるくらい、出すなんて……」
				PRINTFORML 「……もう、なんでそんなに、固くなるのが早いの？」
				PRINTFORMW 「……良いわよ……もっと出してね……%UNICODE(0x2665)%」
			ENDIF
		ENDIF
	;愉悦愉悦
	ELSEIF MARK:反発刻印 == 2 || MARK:反発刻印 == 3
		IF SELECTCOM == 73
			PRINTFORML 
			PRINTFORML 「……っ……子宮、にっ……ぅあ……」
			PRINTFORML 「……こんなの、こんなのっ……いや、いやぁ……」
			PRINTFORMW 「……最、低……」
		ELSE
			IF !RAND:3 ;added
				IF RAND:2 == 0
					PRINTFORMW 「ひっ！？な、中に出されてる…！」
				ELSE
					PRINTFORML 「ひっ！？ま、まさか…！いやぁぁあああああああ！！」
					PRINTFORMW 「は、早く抜いてください！かき出さないと…！」
				ENDIF
			ELSE
				PRINTFORML 
				PRINTFORML 「……っ……中、出てっ……うっ……」
				PRINTFORML 「子供、なんてっ……いやぁっ……」
				PRINTFORMW 「……最低……この、屑……」
			ENDIF
		ENDIF
	ELSE
		IF !RAND:3 ;custom code
			PRINTFORMW 「えっ！？ああっ、ち、ちょっと待っ…ああっ！」
			IF RAND:2
				PRINTFORMW 「勝手に中に出さないで下さいよぉ…」
			ELSE
				PRINTFORMW 「う、うう……相手が天狗でも避妊ぐらいしてくださいよ……」
			ENDIF
		ELSEIF RAND:2 == 0
			PRINTFORML 
			PRINTFORML 「……う、中、出てます……」
			PRINTFORML 「……ちょっと、気持ち悪い感触ですね……」
			PRINTFORMW 「あ、垂れてきた……」
		ELSE
			PRINTFORML 
			PRINTFORML 「……ぁ、出ましたか……？」
			PRINTFORML 「いっぱい、出しましたね……ん……」
			PRINTFORMW 「……もっと、したくないんですか？」
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1

