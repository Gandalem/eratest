	IF FLAG:時間停止
		;PRINTFORML
		;PRINTFORMW
	ELSE
		IF TALENT:恋人
			PRINTFORML 
			PRINTFORML 「……드디어, 바칠 수 있게 됐어……」
			PRINTFORML 「기뻐…… 아직 조금 아프지만……」
			PRINTFORML 「……그것보다, 뜨거워, %조사처리(CALLNAME:MASTER,"가")%」
			PRINTFORML 「……있잖아, %CALLNAME:MASTER%」
			PRINTFORMW 「좋아해, 사랑해…… 응, 그러니까, 움직여줘…… 응?」
		ELSEIF TALENT:恋慕
			PRINTFORML 
			PRINTFORML 「……후후, 처녀가 바쳐졌네……」
			PRINTFORML 「아직 아프지만…… %CALLNAME:MASTER%, 움직여도 돼?」
			PRINTFORMW 「사양하지 마…… 곧 익숙해질 테니…… 응?」
		ELSEIF MARK:反発刻印 == 2 || MARK:反発刻印 == 3
			PRINTFORML 
			PRINTFORML 「……윽, 흐윽…… 최악, 최악, 최악이야……」
			PRINTFORML 「처, 처녀가, 이럴 리가, 이럴 리가……」
			PRINTFORML 「……이, 외도, 쓰레기……」
			PRINTFORMW 「레이무가 없었으면, 이런 녀석은 지금 당장, 지금 당장…… 아, 아앗」
		ELSE
			PRINTFORML 
			PRINTFORML 「……바치고 말았나요」
			PRINTFORML 「특별히 집착하고 있었던 건 아니지만, 어쩐지……」
			PRINTFORMW 「……아뇨, 아무것도 아니에요…… 움직여도 좋아요」
		ENDIF
	ENDIF
	;正真正銘処女喪失
	IF TCVAR:破瓜 == 1
		PRINTFORML 
		PRINTFORMW 
		;再生処女喪失
	ELSEIF TCVAR:破瓜 == 2
		PRINTFORML 
		PRINTFORML 
		;無自覚非処女喪失
		;無自覚喪失してから初めて挿入するものだと認識して書くので状況的におかしかったらスレに報告をお願いします
	ELSEIF TCVAR:破瓜 == -1
		PRINTFORML 
		PRINTFORML 
	ENDIF
ENDIF
;Ａ処女喪失
IF TCVAR:Ａ破瓜
	;正真正銘Ａ処女喪失
	IF TCVAR:Ａ破瓜 == 1
		PRINTFORML 
