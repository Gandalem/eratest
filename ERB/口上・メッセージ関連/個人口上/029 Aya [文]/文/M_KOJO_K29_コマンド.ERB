	ELSEIF TCVAR:Ａ破瓜 == -1
		PRINTFORML 
		PRINTFORML 
	ENDIF
ENDIF
;フェラで射精後のお掃除
IF (TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2) && SELECTCOM == 81
	IF FLAG:時間停止
		PRINTFORML 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 아야의 윤기 나는 혀에 정액으로 더러워진 것을 비빈다.
