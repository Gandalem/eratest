;==================================================
;411,戦闘訓練
;==================================================
@M_KOJO_MESSAGE_COM_K29_411
CALL M_KOJO_MESSAGE_COM_K29_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;訓練後の分岐は趣味、要らなかったら全部消してくれておっけーね
	SELECTCASE RAND:4
		CASE 3
			PRINTFORML 
			PRINTFORML 「では、%CALLNAME:MASTER%さん」
			PRINTFORML 「今日は、私に一発当てられたら終わりにしましょうか」
			PRINTFORMDL 翼をぴこぴこと揺らしながら、文は言う。
			PRINTFORMDL さて、どうやって当てたものかな。
			PRINTFORMDL %CALLNAME:MASTER%は難題に頭を抱えた。
				IF TALENT:恋慕 || !TALENT:6
					PRINTFORMW 
					PRINTFORML 「……一発でも当てられたら、ちゅーしてあげます」
					PRINTFORMDL 本気で行くことを誓った%CALLNAME:MASTER%であった。
				ENDIF
				;恋人と恋慕で戦闘能力が文より上だったらご褒美のねっとりキス
				IF ABL:MASTER:戦闘能力 > ABL:TARGET:戦闘能力 && TALENT:恋人
					CALL MUTUAL_KISS(TARGET, 3)
				;恋人無しで戦闘能力が文より上の場合
				ELSEIF ABL:MASTER:戦闘能力 > ABL:TARGET:戦闘能力
					CALL MUTUAL_KISS
				ENDIF
		CASE 2
			PRINTFORML 
			PRINTFORML 「今日は、そうですねえ」
			PRINTFORML 「速く動く練習でもして見ますか？」
			PRINTFORMDL 文は笑顔で言う。
			PRINTFORMDL つまり、最速の鴉天狗と追いかけっこをしろということか？
			PRINTFORML 「具体的に言うとそうですね、頑張ってください」
			PRINTFORMDL %CALLNAME:MASTER%は頭を抱えた。
		CASE 1
			PRINTFORML 
			PRINTFORML 「……今日は、どうしましょうか」
			PRINTFORML 「……動体視力について、しましょうかね」
			PRINTFORMDL そう言うと、文は翼を動かして宙に浮いた。
			PRINTFORML 「私の動きを目で追えるように頑張ってくださいね」
			PRINTFORMDL そう言いながら、文は%CALLNAME:MASTER%の周りを漂い始める。
			PRINTFORMDL ……手加減してくれよ。
			PRINTFORML 「ええ、眼を回さないようにしてくださいね」
			PRINTFORMDL そう言って、文は急激に速度を上げた。
				IF TALENT:恋慕
					PRINTFORMW 
					PRINTFORML 「今なら、%CALLNAME:MASTER%の大好きな下着が見えるかもしれませんよ？」
					PRINTFORMDL %CALLNAME:MASTER%は全身全霊を尽くし、必死で眼を凝らした。
					SIF !TEQUIP:0
						PRINTFORMDL ……何だかはいていないように見えたが、多分気のせいだ。
				ENDIF
		CASE 0
			PRINTFORML 
			PRINTFORML 「ではでは%CALLNAME:MASTER%さん、今日の訓練はですねえ……」
			PRINTFORML 「……弾幕を避ける訓練です！」
			PRINTFORMDL 無理。
			PRINTFORML 「まあまあそんなこと言わないで」
			PRINTFORMDL とりあえず手加減してくれ。
			PRINTFORML 「ええ、そりゃあ本気で言ったら人間の%CALLNAME:MASTER%さんは――」
			PRINTFORMDL そう言いつつも、割と本気で弾幕を張ってきた文であった。
				IF TALENT:恋慕
					PRINTFORMW 
					PRINTFORML 「はあ、疲れました……頭撫でてください」
					PRINTFORMDL 訓練後、唐突に文は言った。
					PRINTFORMDL 望むとおり、%CALLNAME:MASTER%は文の頭を撫でる。
					PRINTFORML 「む……ふう……」
					PRINTFORMDL 文は疲労のため息をついた。
					EXP:TARGET:愛情経験 += 1
				ENDIF
	ENDSELECT
WAIT
ENDIF
RETURN 1
;==================================================
;412,勉強
;==================================================
@M_KOJO_MESSAGE_COM_K29_412
CALL M_KOJO_MESSAGE_COM_K29_412_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K29_412_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	IF ABL:MASTER:教養 >= ABL:TARGET:教養
		SELECTCASE RAND:3
			;教養の基準なんて知りません、ごめんなさい
			CASE 2
				PRINTFORML 
				PRINTFORML 「……何してるんですか？」
				PRINTFORMDL 勉強。
				PRINTFORML 「……私もしましょうかね」
				PRINTFORMDL 文はそう言って、向かいに座った。
				PRINTFORML 「そういえば、この漢字はなんと読むのでしょうか」
				PRINTFORMDL 文は時折、%CALLNAME:MASTER%に質問を投げかけた。
			CASE 1
				PRINTFORML 
				PRINTFORML 「……何読んでるんですか、%CALLNAME:MASTER%さん」
				PRINTFORMDL 外の世界の本だ。
				PRINTFORML 「……これ、なんですか？」
				PRINTFORMDL これはな……原子って言うものだ。
				PRINTFORML 「面白そうですね、私にも教えていただけませんか？」
				PRINTFORMDL %CALLNAME:MASTER%は文と一緒に勉強をした……。
			CASE 0
				PRINTFORML 
				PRINTFORML 「%CALLNAME:MASTER%さん、難しそうな勉強をしてますね」
				PRINTFORMDL 文もするか？
				PRINTFORML 「……ええ、私も興味があります」
				PRINTFORMDL 文は嬉々として、%CALLNAME:MASTER%の隣に座った。
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 2
				PRINTFORML 
				PRINTFORML 「……勉強してるんですか？　%CALLNAME:MASTER%さん」
				PRINTFORMDL ん、丁度良かった。　文、ここを教えてくれ。
				PRINTFORML 「んーと、どれどれ……ここはですね、分子を直して……」
				PRINTFORMDL 文はなかなか博識で、%CALLNAME:MASTER%の分かっていないところを的確に教えた。
			;なんか遊び心で入れたくなったんです、ゆるして　気に入らなければコメントアウト、もしくは削除を
			CASE 1
				PRINTFORML 
				PRINTFORMDL なあ、文。
				PRINTFORML 「なんですか？　分からないところでもありましたか？」
				PRINTFORMDL いや、ちょっと例題を出して欲しいなあ、と。
				PRINTFORML 「……問題、ですか。　唐突ですねえ、まあ良いですけど」
				PRINTFORMDL そうだ。
				PRINTFORML 「……はい、じゃあ数学で行きますね」
				PRINTFORML 「数の桁で、『正』の後はなんですか？」
				PRINTFORMW 
				PRINTFORMDL 唐突ですが問題です！　あなたは答えられるでしょうか！？
				PRINTFORMDL ※　どれを選択しても特に影響はないです
				PRINTFORMDL [0]　載
				PRINTFORMDL [1]　裁
				PRINTFORMDL [2]　澗
				PRINTFORMDW [3]　京
					IF RESULT == 0
						PRINTFORML 「正解です、%CALLNAME:MASTER%さん」
						PRINTFORMDL 文はにこりと笑って、褒めてきた。
						PRINTFORMDL 何となく嬉しい。
					ELSE
						PRINTFORML 「残念、不正解です」
						PRINTFORML 「ちょっと難しかったですか？」
						PRINTFORMDL 文は笑って、そう言った。
					ENDIF
			CASE 0
				PRINTFORML 
				PRINTFORML 「……%CALLNAME:MASTER%さん、分からないところとかありませんか？」
				PRINTFORMDL ああ、文。　ここ、どうすればいいんだ？
				PRINTFORML 「……じゃあ、まず、どこまで分かってるか教えてください」
				PRINTFORMDL なんでこの文から作者がどう思っているか分かるかが分からん。
				PRINTFORML 「あー……それはもう、慣れですね」
				PRINTFORMDL 文は頬を掻き苦笑しながら、そう言った。
		ENDSELECT
	ENDIF
WAIT
ENDIF
RETURN 1
