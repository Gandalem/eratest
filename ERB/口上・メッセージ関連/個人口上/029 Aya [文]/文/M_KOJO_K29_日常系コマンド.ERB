@M_KOJO_MESSAGE_COM_K29_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;custom code
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「뭐, 대화는 상대를 아는 데 중요하죠. 차라도 마시면서 이야기해요」
		PRINTFORMDW 음료와 다과를 준비해 테이블에 %조사처리(CALLNAME:TARGET,"와")% 마주 앉았다…….
		RETURN 1
	ELSEIF ONCE("AyaTea")
		IF TALENT:恋人
			PRINTFORMW 「아, 앉아 있어. 차라면 준비해 줄 테니까.」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「오늘은 좋은 다과가 있단다. 같이 먹자」
		ELSE
			PRINTFORMW 「아, 차를 준비해 주실 수 있나요? 감사합니다」
			PRINTFORMDW 그렇게 하자 %조사처리(CALLNAME:TARGET,"는")% 의자에 앉아 기다리고 있었다
		ENDIF
		RETURN 1
	ENDIF
	IF TFLAG:193 == 1
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
