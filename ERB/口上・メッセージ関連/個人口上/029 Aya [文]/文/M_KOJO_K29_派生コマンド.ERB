@M_KOJO_MESSAGE_SCOM_K29_1
CALL M_KOJO_MESSAGE_SCOM_K29_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K29_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORML 「ふふ、どっちが先にイかせられるか、勝負ですね♪」
			PRINTFORMW 「負けませんよ…♪ああっ、そんな、いきなりっ…♪」
		ELSE
			PRINTFORML 「私も舐めなきゃいけないんですよね？」
			PRINTFORMW 「仕方ないですね…、ん、んちゅっ…」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:奉仕精神 >= 3 && ABL:Ｃ感覚 >= 3
			IF RAND:2 == 0
				PRINTFORML 「ひ、ひゃああっ♪%CALLNAME:MASTER%、そこはぁっ♪」
				PRINTFORMW 「負けてられないですね…、んっ、じゅぼっ、じゅぼっ…」
			ELSE
				PRINTFORML 「んぁっ♪あああっ、そんなとこ責められたら…♪」
				PRINTFORMW 「やられてばかりではいけませんね…、んっ、じゅっ…♪」
			ENDIF
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%、私のおまんこ美味しいですか？」
			PRINTFORMW 「そうですか、えへへ…♪%CALLNAME:MASTER%のも美味しいですよ…♪」
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF ABL:奉仕精神 >= 3 && ABL:Ｃ感覚 >= 3
			PRINTFORML 「ひゃっ！ああっ、そこは…♪」
			PRINTFORMW 「ただやられてばかりも面白くないですね…、んっ、ちゅぱっ…」
		ELSE
			PRINTFORML 「ああっ…、そこを舐められたら…」
			PRINTFORMW 「仕方ないですね、私も…ん、ちゅぱっ…」
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「ううっ、こう目の前にどんっと性器があると何と言うか…」 
		RETURN 1
	ENDIF
ENDIF
