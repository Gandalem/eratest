@M_KOJO_MESSAGE_SCOM_K29_3
CALL M_KOJO_MESSAGE_SCOM_K29_3_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K29_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORML 「앗! 저, 거길... 더 만져주세요...♪」
		PRINTFORML 「하아...! 이거 대단해...♪」
		PRINTFORMDW 민감한 부분을 핀포인트로 희롱당하며, 문은 몸을 떨며 쾌락에 몸부림치고 있다.
		RETURN 1
		;屈服3
	ELSEIF ABL:Ｖ感覚 >= 3
		PRINTFORML 「큭...앗! 그, 거긴 계속 만지지 말아줘...아앗!」
		PRINTFORMDW 가장 민감한 부분을 직접 자극받고, 문은 쾌락에 몸부림치고 있었다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「엣!? 뭐, 이 느낌은 뭔가요...!?」
		RETURN 1
	ENDIF
ENDIF
