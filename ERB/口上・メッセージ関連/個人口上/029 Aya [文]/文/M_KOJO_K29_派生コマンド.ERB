@M_KOJO_MESSAGE_SCOM_K29_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「응, 응쥰...♪ 어때요 %CALLNAME:MASTER%, 기분 좋아요...?」
			PRINTFORMW 「저도 가슴이 뜨거워서 굉장해요, 더더욱 봉사하게 해 주세요...♪」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%」도 욕심쟁이네요...
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORML 「후후, 역시 %CALLNAME:MASTER%도 이건 참기 힘드시죠? 거시기(성기)가 파르르 떨리고 있어요...♪」
		PRINTFORMW 「이대로 제가 가게 해 드릴게요, 자아...♪」
		RETURN 1
		;屈服3
	ELSEIF ABL:奉仕精神 >= 3
		PRINTFORML 「응, 쭉, 응쭉...!」
		PRINTFORMDW 문은 정신없이 가슴과 입으로 봉사하고 있다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「왜 내가 이런 짓을 해야 하는 거지..., 하아...」
		RETURN 1
	ENDIF
ENDIF
