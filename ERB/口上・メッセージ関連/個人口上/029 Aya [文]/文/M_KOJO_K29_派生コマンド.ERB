@M_KOJO_MESSAGE_SCOM_K29_1
CALL M_KOJO_MESSAGE_SCOM_K29_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K29_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORML 「후후, 누가 먼저 흥분하는지 내기를 하는군요♪」
			PRINTFORMW 「지지 않아요...♪ 아앗, 그런 갑작스러운 건...♪」
		ELSE
			PRINTFORML 「저도 맛봐야 하잖아요?」
			PRINTFORMW 「어쩔 수 없네요... 응, 츄읍...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:奉仕精神 >= 3 && ABL:Ｃ感覚 >= 3
			IF RAND:2 == 0
				PRINTFORML 「히, 히야앗♪ %CALLNAME:MASTER%, 거기는 아앗♪」
				PRINTFORMW 「져 있을 순 없죠..., 응, 주봇, 주봇...」
			ELSE
				PRINTFORML 「응앗♪ 아아, 그런 곳을 공격당하면...♪」
				PRINTFORMW 「계속 당하고만 있을 수는 없죠..., 응, 쥰...♪」
			ENDIF
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 나의 보지가 맛있나요?」
			PRINTFORMW 「그런가요, 헤헤...♪ %CALLNAME:MASTER%것도 맛있어요...♪」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF ABL:奉仕精神 >= 3 && ABL:Ｃ感覚 >= 3
			PRINTFORML 「햐앗! 아앗, 거긴...♪」
			PRINTFORMW 「그냥 당하고만 있는 것도 재미없지 않나요..., 응, 쪽...」
		ELSE
			PRINTFORML 「아앗…, 거길 핥히면…」
			PRINTFORMW 「어쩔 수 없네요, 저도… 응, 쭉 빠앗…」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「우욱, 눈앞에 성기가 떡하니 있다니 뭐라고 해야 할지...」 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K29_{SELECTCOM}_1
RETURN 1
