; Modular ERB: 個人口上/029 Aya [文]/文/M_KOJO_K29_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K29
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K29
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	;PRINTFORMW
ELSEIF TFLAG:時姦刻印取得 == 2
	;PRINTFORMW
ELSEIF TFLAG:時姦刻印取得 == 3
	;PRINTFORMW
ENDIF
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 1
;苦痛刻印
IF TFLAG:苦痛刻印取得 == 1
	PRINTFORML 
	PRINTFORML 「이, 윽...!」
	PRINTFORMDW 아야는 무심코 비명을 질렀다.
ELSEIF TFLAG:苦痛刻印取得 == 2
	PRINTFORML 
	PRINTFORML 「아, 아파아……!」
	PRINTFORML 「안, 아우윽……」
	PRINTFORMDW 아야는 약간 눈시울이 붉어진 채 고통을 견디고 있다.
ELSEIF TFLAG:苦痛刻印取得 == 3
	PRINTFORML 
	PRINTFORML 「……헉……끅, 으윽……」
	PRINTFORML 「이제 그만해, 그만둬……흐, 컥……」
	PRINTFORMDW 아야는 고통을 견디지 못하고 울음을 터뜨렸다.
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORML 
	PRINTFORML 「하, 응윽……!」
	PRINTFORMDL 아야는 귀여운 소리를 내며 몸을 움찔 떨었다.
	PRINTFORML 「……아, 아무것도 아니에요」
	PRINTFORMDW 아야는 부끄러운 듯 얼굴을 돌렸다.
ELSEIF TFLAG:23 == 2
	PRINTFORML 
	PRINTFORML 「하, 하앗…… 하아앗……」
	PRINTFORMDL 아야는 거칠게 숨을 몰아쉬고 있다.
	PRINTFORML 「……무, 무슨 눈이에요, 그건」
	PRINTFORMDW 미소 짓는 %조사처리(CALLNAME:MASTER,"의")% 시선에, 아야는 공허한 눈으로 되돌아보았다.
ELSEIF TFLAG:23 == 3
	PRINTFORML 
	PRINTFORML 「하, 안읏!」
	PRINTFORMDL 아야는 요염한 신음소리를 냈다.
	PRINTFORML 「흡, 헉, 하아앗, 하아앗……」
	PRINTFORMDW 아야는 뺨을 붉게 물들이고, 쾌락의 여운에 잠겨 있다……
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORML 
	PRINTFORML 「햐, 응응읏!」
	PRINTFORML 「……아……」
	PRINTFORMDL 아야는 얼굴을 새빨게 물리고 고개를 돌려버렸다.
	PRINTFORMDW 실로 귀엽구나.
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORML 
	PRINTFORML 「하아앗, 하아앗…… 응, 야앗……」
	PRINTFORMDL 아야는 %조사처리(CALLNAME:MASTER,"를")% 촉촉하게 빛나는 눈으로 바라보고 있다.
	PRINTFORMDL 매혹적인 숨을 내쉬는 아야는, 더 만져줬으면 좋겠다는 듯 몸을 비틀고 있다.
	PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그 시선에, 히죽 웃었다.
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORML 
	PRINTFORML 「큭, 하아앗, 하아앗, 더, 더 해주세요옷!」
	PRINTFORMDL 아야는 커다란 신음을 내며 간청해 왔다.
	PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 바라는 대로 더욱 강하게 몰아붙인다.
	PRINTFORML 「아, 아아앗! 좋아요, 좋아요윽!」
	PRINTFORMDW 아야는 더한 쾌락을 갈구하며 신음을 계속 내고 있다……
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORML 
	PRINTFORML 「…………%조사처리(CALLNAME:MASTER,"는")%……」
	PRINTFORMDL ……뭐지.
	PRINTFORMDL 아야는 말을 걸어온 뒤로 말이 없다.
	PRINTFORMDL 지지 않겠다는 듯, %CALLNAME:MASTER%는도 아야의 눈을 응시한다.
	PRINTFORML 「……후후훗」
	PRINTFORMDL 왠지 모르게 답답함을 느낀 %조사처리(CALLNAME:MASTER,"는")% 시선을 그 눈에서 돌렸다.
	PRINTFORMDW ……이것이 아키나미에게 보내지는 것이겠지.
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 
	PRINTFORML 「……후후……」
	PRINTFORMDL 무슨 일이야, 아야.
	PRINTFORML 「……아니에요, 아무것도 아니에요」
	PRINTFORMDL ……? 그래.
	PRINTFORML 「……후후훗」
	PRINTFORMDW 아야는 이유도 없이, 어쩐지 기쁜 듯 웃었다.
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML 
	PRINTFORML 「……하아……」
	PRINTFORMDL 어째선지 아야는 이쪽을 바라보며 한숨을 쉬고 있다.
	PRINTFORMDL 무슨 일이라도 있었어?
	PRINTFORML 「……아, 아니에요, 아무것도 없어요」
	PRINTFORMDW 하고 놀란 듯, 아야는 대답했다.
ENDIF
;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORML 
	PRINTFORML 「……칫……」
	PRINTFORMDL 지금 뭔가 혀를 차는 소리 같은 게 들렸지만.
	PRINTFORML 「아니, 기분 탓이겠지?」
	PRINTFORMDW 묘하게 경직된 미소로 아야가 말했다.
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORML 
	PRINTFORML 「……인간이라는 게…….」
	PRINTFORMDL 오오, 뭔가 나한테 하는 말 같았는데?
	PRINTFORML 「……혹시 그랬을지도 모르겠네요」
	PRINTFORMDL ……음, 꽤 화나게 해버린 모양이다.
	PRINTFORMDW 아야는 무표정하게 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 바라보고 있다.
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORML 
	PRINTFORMW 「……적당히 해라」
	PRINTFORMW 「얼마까지 나를 화나게 해야 만족하는 거야, 고작 인간 주제에」
	PRINTFORMDW 소름이 돋으며 온몸에 한기가 돌고 등골에 소름이 돋았다.
	PRINTFORMDW 쾌감과는 전혀 다른, 순수한 공포에서 오는 감각이다.
	PRINTFORMW 「……잘 들어라, 인간」
	PRINTFORMDW 레이무만큼은 아닐지라도, 이것 또한 격이 다르다.
	PRINTFORMW 「네가 죽지 않은 건, 레이무 덕분이라고 생각해라」
	PRINTFORMW 「고작 인간이라면 지금 당장 죽여버렸을 테니」
	PRINTFORMW 「다시 말한다, 적당히 해라」
	PRINTFORMW 「그게 네 목숨을 위한 일이다」
	PRINTFORML 
	PRINTFORMW 「……자, 뭔가 할래요, %CALLNAME:MASTER%씨」
	PRINTFORMDW 다음 순간에는 아야는 본래의 말투로 돌아와 있었다.
	PRINTFORMDW ……솔직히 말하면, 나도 모르게 말이 새어 나올 뻔했다.
	PRINTFORMDW 뺨으로 식은땀이 흘러내리고 있다. 아직 한기가 가시지 않는다.
	PRINTFORMDW ……앞으로는 조금 자중하도록 하자.
	PRINTFORMDW 그렇게 결의하는 %CALLNAME:MASTER%였다.
ENDIF
