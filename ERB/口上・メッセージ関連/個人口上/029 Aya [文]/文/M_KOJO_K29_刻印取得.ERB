;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K29
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K29
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい

;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	;PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	;PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	;PRINTFORMW 
ENDIF

SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 1

;苦痛刻印
IF TFLAG:苦痛刻印取得 == 1
	PRINTFORML 
	PRINTFORML 「いっ、つぅっ……！」
	PRINTFORMDW 文は思わず悲鳴を上げた。
ELSEIF TFLAG:苦痛刻印取得 == 2
	PRINTFORML 
	PRINTFORML 「痛、いっ……！」
	PRINTFORML 「な、いっ、あぅ……」
	PRINTFORMDW 文は若干涙目になりながら、痛みに耐えている。
ELSEIF TFLAG:苦痛刻印取得 == 3
	PRINTFORML 
	PRINTFORML 「……ひっ……っく、うぅっ……」
	PRINTFORML 「もう、やめっ、やめ、てっ……ひ、くっ……」
	PRINTFORMDW 文は痛みに耐えかね、泣き出してしまった。
ENDIF

;快楽刻印
IF TFLAG:23 == 1
	PRINTFORML 
	PRINTFORML 「は、んっ……！」
	PRINTFORMDL 文は可愛らしい声を上げ、ぴくりと体を跳ねさせた。
	PRINTFORML 「……な、何でもありません」
	PRINTFORMDW ふい、と文は顔を背けた。
ELSEIF TFLAG:23 == 2
	PRINTFORML 
	PRINTFORML 「は、ぁっ……はぁっ……」
	PRINTFORMDL 文は荒く息をついている。
	PRINTFORML 「……な、なんですか、その目は」
	PRINTFORMDW 微笑む%CALLNAME:MASTER%の視線に、文はじとっとした目で返した。
ELSEIF TFLAG:23 == 3
	PRINTFORML 
	PRINTFORML 「は、あんっ！」
	PRINTFORMDL 文は艶かしい喘ぎ声を上げた。
	PRINTFORML 「っ、はっ、はぁっ、はぁっ……」
	PRINTFORMDW 文は頬を紅く染め、快楽の余韻に浸っている……
ENDIF

;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORML 
	PRINTFORML 「ひゃ、んんっ！」
	PRINTFORML 「……ぁ……」
	PRINTFORMDL 文は顔を真っ赤にしてそっぽを向いてしまった。
	PRINTFORMDW 実に可愛らしい。
;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORML 
	PRINTFORML 「はぁっ、はぁっ……ん、やぁっ……」
	PRINTFORMDL 文は%CALLNAME:MASTER%を潤んだ瞳で見つめている。
	PRINTFORMDL 艶やかな息を吐く文は、もっと触って欲しいといわんばかりに体をくねらせている。
	PRINTFORMDW %CALLNAME:MASTER%はその視線に、にや、と笑った。
;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORML 
	PRINTFORML 「っ、はぁっ、はぁっ、もっと、もっと、してくださいぃっ！」
	PRINTFORMDL 文は、大きな嬌声を上げながら懇願してきた。
	PRINTFORMDL %CALLNAME:MASTER%は望みどおりに、もっと強く責め立てる。
	PRINTFORML 「あ、あぁっ！　いい、いい、ですぅっ！」
	PRINTFORMDW 文はさらなる快楽を求め、嬌声を上げ続けている……
;屈服、恭順による刻印
;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORML 
	PRINTFORML 「…………%CALLNAME:MASTER%さん……」
	PRINTFORMDL ……何だ。
	PRINTFORMDL 文は声をかけて来たっきり、黙っている。
	PRINTFORMDL 負けじと、%CALLNAME:MASTER%も文の眼を見つめる。
	PRINTFORML 「……うふふ」
	PRINTFORMDL 妙にむずがゆく感じたので、%CALLNAME:MASTER%は視線をその眼から外した。
	PRINTFORMDW ……これが秋波を送られているということなのだろうか。
;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 
	PRINTFORML 「……ふふ……」
	PRINTFORMDL どうした、文。
	PRINTFORML 「……いえ、何でもありませんよ」
	PRINTFORMDL ……？　そうか。
	PRINTFORML 「……ふふふっ」
	PRINTFORMDW 文は意味も無く、何故か嬉しそうに笑った。
;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORML 
	PRINTFORML 「……はぁ……」
	PRINTFORMDL 何故か文は、こちらを見つめながらため息をついている。
	PRINTFORMDL どうかしたか？
	PRINTFORML 「……あ、いえ、何でもありません」
	PRINTFORMDW はっとしたように、文は答えた。
ENDIF

;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORML 
	PRINTFORML 「……ちっ……」
	PRINTFORMDL 今なんだか舌打ちっぽい音が聞こえたが。
	PRINTFORML 「いえ、気のせいでは？」
	PRINTFORMDW 妙に強張った笑顔で、文は言った。
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORML 
	PRINTFORML 「……人間風情が……」
	PRINTFORMDL おおう、何だか悪口が聞こえた気がするぞ？
	PRINTFORML 「……もしかしたら、言ったかもしれませんね」
	PRINTFORMDL ……うむ、結構怒らせてしまったようだ。
	PRINTFORMDW 文は無表情で、%CALLNAME:MASTER%の顔を見ている。
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORML 
	PRINTFORMW 「……いい加減にしろ」
	PRINTFORMW 「どれほどまで私を怒らせれば気が済む、たかが人間が」
	PRINTFORMDW ぞくり、と全身に寒気が走り、鳥肌が立った。
	PRINTFORMDW 快感とは絶対に違う、純粋な恐怖によるもの。
	PRINTFORMW 「……いいか、人間」
	PRINTFORMDW 霊夢ほどではないが、これもまた、格が違う。
	PRINTFORMW 「お前が死んでいないのは、霊夢のおかげだと思え」
	PRINTFORMW 「……唯の人間であれば、今直ぐに殺している」
	PRINTFORMW 「もう一度言う、いい加減にしておけ」
	PRINTFORMW 「それがお前の、身のためだ」
	PRINTFORML 
	PRINTFORMW 「……さ、なにかしますか、%CALLNAME:MASTER%さん」
	PRINTFORMDW 次の瞬間には、文はもとの口調に戻っていた。
	PRINTFORMDW ……正直、ちびるかと思った。
	PRINTFORMDW 頬に冷や汗が伝っている。　まだ寒気が治まらない。
	PRINTFORMDW ……これからは、少し慎むようにしよう。
	PRINTFORMDW そう決意する%CALLNAME:MASTER%であった。
ENDIF
