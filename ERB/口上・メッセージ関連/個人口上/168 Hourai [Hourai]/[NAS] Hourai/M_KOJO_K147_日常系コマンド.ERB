;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K168_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 0

@M_KOJO_MESSAGE_COM_K168_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
CALL TRAIN_MESSAGE
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K168_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K168_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0,1
			IF SignificantRelationship(147)
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「으음, 알겠어, 좋아.」
					CASE 1
						PRINTFORML 「그들은 마지막에 죽나요?」
					CASE 2
						PRINTFORML 「섹스? 아니. 우린 섹스 안 할 거야.」
					CASE 3
						PRINTFORML 「대체 무슨 변태적인 취향이야!」
						PRINTFORML 「너무 더럽잖아!」
					CASE 4
						PRINTFORML 「이 빌어먹을 토끼굴은 얼마나 깊은 거지!?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「꺼져라 %CALLNAME:MASTER%!」
					CASE 1
						PRINTFORML 「너 왜 나한테 말을 거는 거야?」
					CASE 2
						PRINTFORML 「멋지군. 안타깝게도 그건 내가 싫어하는 거야.」
					CASE 3
						PRINTFORML 「정말 비극적이네.」
					CASE 4
						PRINTFORML 「네 바보 같은 이야기 듣고 싶지 않아.」
				ENDSELECT
			ENDIF
		CASEELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「그거 너무 지긋지긋하게 많이 말했잖아!」
				CASE 1
					PRINTFORMW 「여기서 지루해 죽겠어...」
					PRINTFORMW 「뭐라도 말해봐!」
				CASE 2
					PRINTFORMW 「계속 그 말만 되풀이할 거면 그냥 꺼져라.」
			ENDSELECT
	ENDSELECT
	;ここに口上書いて下さい
ENDIF
RETURN 1
