		CASE 1
			SELECTCASE RAND:5
				CASE 0
					IF IsPadded([[Hourai]])
						PRINTFORMW 「내 %PeeProtectType([[Hourai]],3)%이 당신에게 베개처럼 느껴지나요?」
						PRINTFORMW 「당신이 사용한 기저귀 위에 자는 것을 좋아한다는 걸 몰랐어요.」
					ELSE
						PRINTFORMW 「내 가랑이의 쿠션 부족을 그렇게 그리워하다니 유감이다.」
						PRINTFORMDW 당신은 정말로 %CALLNAME:[[Hourai]]%의 말랑한 패딩에 머리를 기대는 것을 그리워하는군요.
						PRINTFORMW 「잠깐... 내가 그런 말을 했더니... 또 나를 기저귀에 넣을 거라는 거야? 그렇지 않아?」
					ENDIF
				CASE 1
					PRINTFORMDW 당신은 %CALLNAME:[[Hourai]]%의 허벅지 위에 눕기 시작하는 것을 막을 수 없다.
					IF IsPadded([[Hourai]])
						PRINTFORMDW 부드럽고 말랑한 패딩이 편안하고 집 같은 느낌을 느끼도록 도와준다.
						PRINTFORMW 「흥. 아이러니하군. 내 기저귀 위에서 낮잠을 자다니.」
					ELSE
						PRINTFORMDW 부드러운 패딩 대신 단단한 인형 폴리머 때문에 편하게 있기 좀 어렵다.
						PRINTFORMW 「기저귀가 없어. 그만둬!」
					ENDIF
				CASE 2
					PRINTFORMDW 당신은 다시 %CALLNAME:[[Hourai]]%의 %PeeProtectType([[Hourai]],2)% 안에 머리를 파묻는다.
					IF SoiledDiaper([[Hourai]],2,,15)
						PRINTFORMW 「너 정말 내 똥 냄새 맡는 걸로 흥분하는구나.」
						PRINTFORMW 「내 빌어먹을 %PeeProtectType([[Hourai]],2)% 뒤쪽에 바로 누군가 싸놓은 진짜 변이야.」
						PRINTFORMDW %CALLNAME:[[Hourai]]%의 배설물에서 나는 지독한 냄새와 %HIS_HER([[Hourai]])%의 물컹한 패딩이 너를 한계까지 몰고 간다.
						PRINTFORMW 「충분히 킁킁거려라, 응가 기저귀 좋아하는 동성애자.」
					ELSEIF SoiledDiaper([[Hourai]],1,,30) && IsPadded([[Hourai]])
						PRINTFORMW 「말랑하고 오줌 냄새 나지?」
						PRINTFORMDW %CALLNAME:[[Hourai]]%의 소변에서 나는 비릿한 냄새와 %HIS_HER([[Hourai]])%의 말랑한 패딩이 합쳐져 당신을 한계로 몰아간다.
					ELSEIF IsPadded([[Hourai]])
						PRINTFORMW 「편하긴 한데 말이야, 아무 냄새도 안 나잖아?」
						PRINTFORMW 「왜 세상에서 제일 신성한 것처럼 구는 거야?」
					ELSE
						PRINTFORMW 「나한테 빨려고 허락도 안 했잖아!」
					ENDIF
				CASE 3
					IF SoiledDiaper([[Hourai]],2,,15)
						PRINTFORMW 「오 %CALLNAME:102%, 왜 이런 짓을 하는 거야!」
						PRINTFORMW 「넌 마치 발정 난 개 같아, 다만 네가 개 대신 지저분한 %PeeProtectType([[Hourai]],2)%일 뿐이지.」
						PRINTFORMDW %CALLNAME:[[Hourai]]%의 지독한 배설물 냄새와 %HIS_HER([[Hourai]])%의 축축한 패드가 너를 한계까지 몰아붙인다.
						PRINTFORMW 「똥이야. 기저귀야. 킁킁. 그만해.」
						PRINTFORMW 「%CALLNAME:102%... 도와줘.」
					ELSEIF SoiledDiaper([[Hourai]],1,,30) && IsPadded([[Hourai]])
						PRINTFORMW 「그래서 이게 네 약점인가... 흥.」
						PRINTFORMW 「오줌이랑 똥 냄새랑 축축한 느낌이 너를 황홀하게 만드는 거냐?」
					ELSEIF IsPadded([[Hourai]])
						PRINTFORMW 「뭐라고? 이제 '베이비 파우더'라는 걸 맡는 거야?」
						PRINTFORMW 「It's a nice smell, but it won't be there for long...」
					ELSE
						PRINTFORMW 「야, 오늘은 큰 바지 입는 날이다. 너한테 패딩은 없다.」
					ENDIF
				CASE 4
					PRINTFORMW 「제발 그 몸 비비는 거 좀 멈춰줘.」
					PRINTFORMW 「내 %PeeProtectType([[Hourai]],3)%을 내 %PRINT_CLIT([[Hourai]])%에 문지르는 게 좋을 것 같아, 한번 해봐.」
			ENDSELECT
		CASEELSE
	ENDSELECT
ENDIF
RETURN 1
