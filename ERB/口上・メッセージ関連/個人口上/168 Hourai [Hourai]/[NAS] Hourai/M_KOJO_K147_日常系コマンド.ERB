;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K168_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 0

@M_KOJO_MESSAGE_COM_K168_301
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K168_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K168_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K102_UPDATE:4
		PRINTFORML 「Ha Ha...」
		PRINTFORML 「좋은 차를 가지고 있네...」
		PRINTFORMDW %CALLNAME:[[Hourai]]%은 강한 표정을 지으려 하지만 당신의 차에 감명받지 못한 것 같다.
		RETURN 1
	ENDIF
	SELECTCASE ABL:MASTER:44
		CASE IS >= UniversalRank("OverDrive")
			PRINTFORMW 「이것이야 완벽해.」
			PRINTFORML 「내가 맛본 차 중에 단연 최고야.」
			PRINTFORML 그리고 마카이 마녀처럼 전부 혼자 가져가지 않아.
			PRINTFORMW 「가끔은 정말 맛있는 차 한 잔이 필요할 때가 있지.」
		CASE IS >= UniversalRank("Phantasm")
			PRINTFORMW 「와, 정말 부드럽네.」
			PRINTFORML 「정말 좋은 차야.」
		CASE IS >= UniversalRank("Extra")
			PRINTFORML 「풍미가 좋군.」
			PRINTFORML 「식감도 훌륭하고, 그 텁텁함이 전혀 없으며, 맛도 일품이야.」
		CASE IS >= UniversalRank("S")
			PRINTFORMW 「좋은 차를 가지고 있네.」
			PRINTFORML 「맛은 좋은데 질감이 좀 별로야.」
			PRINTFORML 「잎에서 오는 약간의 "낡은 느낌"이 있지만, 그 외에는 괜찮아.」
		CASE IS >= UniversalRank("A")
			PRINTFORMW 「축하한다...」
			PRINTFORMW 「통과했다.」
			PRINTL
			PRINTFORML 「넌 "소변도 안 봐"라고 했지!」
			PRINTFORMW 「차를 못 마시는 사람이 몇 명인지 알아?」
			PRINTFORMW 「답을 알려주마:」
			VARSET LOCAL
			FOR LOCAL,0,CHARANUM
			SIF ABL:LOCAL:44 < UniversalRank("A")
				LOCAL:1 ++
			NEXT
			PRINTL
			PRINTFORMW 「%TOUPPER(NUM_COUNT(LOCAL:1))%!!!」
			PRINTL
			PRINTFORML 「말 그대로 누구도 차를 만들 수 없어, 너 말고는.」
			PRINTFORMW 「그리고 이건 그저 괜찮은 맛일 뿐이야. 액체 쓰레기보다는 '괜찮은' 차가 낫지.」
			PRINTFORML 「이게 나를 얼마나 행복하게 하는지 알아?」
			PRINTFORML 「누군가가 마침내 차가 무엇인지 알게 되었다는 걸 말이야.」
			PRINTFORMW 「이건 우연이 아니야. 이건 진짜라고.」
		CASE IS >= UniversalRank("B")
			PRINTFORMW 「오우 와, 저것 좀 봐, 오줌이야.」
			PRINTFORML 「이건 네가 나에게 대접하는 오줌이다.」
			PRINTW
			PRINTFORML 「너에게 뭘 기대했겠어? 신의 걸작 같은 걸 말이야?」
			PRINTFORML 「아니! 대신 손에 넣은 건 %조사처리(CALLNAME:MASTER,"의")% 맛없는 차였을 뿐이라고!」
			PRINTFORMW 「오줌처럼 느껴지진 않지만, 만약 소변처럼 느껴진다면 여전히 소변 맛이 나는 거야.」
			PRINTL
			PRINTFORML 「네가 그럭저럭 마실 만한 걸 만들 수 있다는 건 알지만, 분명히 노력을 안 하고 있어.」
			PRINTFORMW 「나에게 차를 대기 전에 차 만드는 데 한 15시간 더 투자해 줘.」
			K168_Teasucks = 1
		CASE IS >= UniversalRank("C")
			PRINTFORMW 「이봐, 네 요리 액체 쓰레기에서 오줌 수준으로 진화했네.」
			PRINTFORML 「그래도 네 차는 여전히 형편없지만 말이야.」
			PRINTL
			PRINTFORML 「여전히 형편없어, 변기물 마시는 기분이야...」
			PRINTFORML 「이걸 당신에게 뱉고 싶은 거 참을 수가 없어.」
			PRINTFORML 「그리고 있잖아, 네 차는 여전히 빌어먹게 별로야.」
			PRINTFORMW 「쓰레기라고, 너도 그걸 알고 있잖아.」
			PRINTL
			PRINTFORMW 「나에게 소변을 주면서 내가 그것을 마시게 하네.」
			PRINTFORML 「나는 그렇게 바보가 아니야. 나는 차와 %CALLNAME:17%의 패딩에 들어가는 그 쓰레기의 차이를 알고 있어.」
			PRINTFORML 「이 쓰레기는 나에게 대접하지 말아줘, 제발.」
			K168_Teasucks = 1
		CASE IS > 0
			PRINTFORMW 「이 차는 개똥 맛이 난다.」
			PRINTFORML 「내 잇몸에 달라붙는데, 나한테 잇몸조차 없다.」
			PRINTFORML 「게다가 보기에도 하고 냄새도 개똥 같다.」
			PRINTL
			PRINTFORML 「이렇게 차를 만들지 않는 거야.」
			PRINTFORML 「차를 너무 많이 넣었더니, 이제 망했어.」
			PRINTFORML 「지금 일본 요리사들이 이런 상태라면, 차라리 자살하는 게 나아.」
			PRINTFORMW 「물론 나는 먹을 필요가 없으니 그럴 일은 없을 테지만.」 
			PRINTL
			PRINTFORML 「이런 쓰레기는 나에게 내지 마세요.」
			;TFLAG:193 = -1
			K168_Teasucks = 1
		CASEELSE
			PRINTFORMW 「방금 나에게 뭘 대접한 거냐!」
			PRINTFORML 「이건 차가 아니다. 이건 오줌이라고 부르기에도 너무 형편없다!」
			PRINTFORMW 「이걸 뭐라고 불러야 할지 모르겠다!?」
			PRINTL
			PRINTFORMW 「준비된 형태의 설사라고?」
			PRINTFORML 「나에게 액체 같은 걸 대놓고 차라고 부르는군.」
			PRINTFORMW 「게다가 신이시여, 당신은 SEEPING이 어떻게 작동하는지 모르고 있군요.」
			PRINTL
			PRINTFORML 「너는 네가 그런 얼간이처럼 봉지를 자는 게 아니라, 봉지를 주전자에 넣고 기다리며 우러나게 해야 한다.」
			PRINTFORML 「분명 너의 두개골은 그것을 알기엔 너무 무감해서 그래. 그래서 그 안에 잎들을 그대로 둔 거다.」
			PRINTFORMW 「네 액체 같은 개소리는 집어치워라. 사람들에게 대접하는 대신 변기에 버려라.」
			RESETCOLOR
			;TFLAG:193 = -1
			K168_Teasucks = 1
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K168_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K168_302
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K168_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K168_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE nCharaSaveUp:[[Hourai]]:0:5
		CASE 1
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「아, 씨발 뭐야!」
					PRINTFORMW 「내 %PeeProtectType([[Hourai]],3)%이 아닌 곳을 만질 수 있어?!」
				CASE 1
					PRINTFORMDW 당신은 %CALLNAME:[[Hourai]]%의 %PeeProtectType([[Hourai]],2)%에 있는 \@ IsPadded([[Hourai]]) ? 패딩 # 천 \@을 만지지 않을 수 없다.
					PRINTFORMW 「아니, 내 빌어먹을 %PeeProtectType([[Hourai]],3)% 또 만지지 마...」
				CASE 2
					PRINTFORMDW 당신의 손이 %CALLNAME:[[Hourai]]%의 %PeeProtectType([[Hourai]],2)%를 다시 만지기 시작한다.
					PRINTFORMW 「내 아기 팬티에 그렇게 집착할 거면 반지를 끼는 게 맞겠지.」
					PRINTFORMW 「아니면 그냥 벗어서 더러운 통에 버려버리든가.」
				CASE 3
					PRINTFORMW 「제발!」
					PRINTFORMW 「내 가랑이 말고 아무 데나, 제발요!」
					PRINTFORMW 「네 기저귀 페티시는 신경 안 써, 그냥 등 마사지 해줘.」
					PRINTFORMDW 좀 힘들었지만 결국 %CALLNAME:[[Hourai]]%에게 %HIS_HER([[Hourai]])%의 뒤쪽 말고 다른 곳에서 마사지를 해주긴 했어.
					PRINTFORMDW 그리고 눈을 떼지 않고 그걸 해냈네, %HIS_HER([[Hourai]])% %PeeProtectType([[Hourai]],2)%.
				CASE 4
					PRINTFORMW 「제발 그 몸 비비는 거 좀 멈춰줘.」
					PRINTFORMW 「내 %PeeProtectType([[Hourai]],3)%을 내 %PRINT_CLIT([[Hourai]])%에 문지르는 게 좋을 것 같아, 한번 해봐.」
			ENDSELECT
		CASEELSE
			;時間停止中
			IF FLAG:70
				;睡眠中
			ELSEIF CFLAG:睡眠
				;通常
			ELSE
				;can't think of wife variations
				SELECTCASE ABL:MASTER:50
					CASE IS >= UniversalRank("A")
						SELECTCASE RAND:5
							CASE 0
								PRINTFORMW 「내 머리, 위쪽을 좀 쓰다듬어 줄래?」
								PRINTFORMW 「응... 그런 식으로... %MOAN("l")%～」
								PRINTFORMDW 이게 그녀를 흥분시키고 있는 걸까?
								;Yes. Yes it is.
								PALAM:TARGET:潤滑 += 100
							CASE 1
								PRINTFORML 「이거 기분 좋으라고 하는 건지, 아니면 날 괴롭히려는 거야?」
							CASE 2
								PRINTFORML 「우으으... 우우웅... 아아우우웅...」
								PRINTFORMDL %CALLNAME:[[Hourai]]%은(는) 당신이 %HIS_HER([[Hourai]])%의 머리를 쓰다듬자 행복한 작은 소리를 낸다.
								PRINTFORMDW %HE_SHE([[Hourai]],1)%은(는) 당신에게서 떨어지며 홍조를 띤다.
							CASE 3
								PRINTFORMW 「내 머리 위 조심해! ... 민감해서...」
							CASE 4
								PRINTFORML 「아기처럼 부드럽네.」
								PRINTFORML 「네가 하는 게 마음에 들어.」
						ENDSELECT
					CASE IS >= UniversalRank("B")
						SELECTCASE RAND:5
							CASE 0
								PRINTFORML 「흐음... 더 노력해야 해」
							CASE 1
								PRINTFORML 「내 머리 쓰다듬어 봐, 네가 그렇게 해주니 기분이 좋았어.」
							CASE 2
								PRINTFORML 「미안해, %CALLNAME:MASTER%... 그냥 기분이 안 좋네.」
								PRINTFORMW 「어깨 마사지를 해주는 게 좋을지도 몰라.」
							CASE 3
								PRINTFORMDW %CALLNAME:[[Hourai]]% blushes as 당신이 만지작거리자 %HIS_HER([[Hourai]])% 머리를 쓰다듬으며 %HIM_HER([[Hourai]])%.
							CASE 4
								PRINTFORMW 「거의 다 왔어...」
								PRINTFORMW 「아직은 너무 멀지만...」
						ENDSELECT
					CASE IS >= UniversalRank("C")
						SELECTCASE RAND:5
							CASE 0
								PRINTFORMW 「Ow!」
								PRINTFORMDW 당신의 손이 %CALLNAME:[[Hourai]]%의 엉킨 머리카락 부분에 걸린 것 같다.
							CASE 1
								PRINTFORML 「손이 너무 거칠잖아!」
							CASE 2
								PRINTFORML 「이거 정말 형편없네.」
								PRINTFORMW 「좀 더 노력해 보는 게 좋을지도 몰라.」
							CASE 3
								PRINTFORML 「으윽. 가정폭력 신고하게 만들지 마!」
							CASE 4
								PRINTFORML 「넌 인형 마사지를 어떻게 하는지 전혀 모르는구나.」
						ENDSELECT
					CASEELSE
						PRINTFORML 「네 비참한 손 당장 치워!」
						PRINTFORMDW 너는 %CALLNAME:[[Hourai]]%의 접근에 폭력적으로 저항한다.
						PRINTFORMDW 너는 당황하며 천천히 자리를 뜬다.
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
