;123,足コキする
;==================================================

@M_KOJO_MESSAGE_COM_K117_123
CALL M_KOJO_MESSAGE_COM_K117_123_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_123_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「응. %CALLNAME:MASTER%라면, 물건 취급을 받아도 전혀 기쁘다고♪」
			PRINTFORMW 「아하♪ 주무르는 거 좋아♪」
			PRINTFORMW 「발로 차이는데 흥분해버리는 거야♪」
		ELSE
			PRINTFORMW 「즐거워? ……그래. 그렇다면 상관없지만」
			PRINTFORMW 「……아플 뿐이네」
			PRINTFORMW 「알고 있니? 일부러 거칠게 행동하는 것과, 거칠기밖에 할 수 없는 것은 완전히 다른 거야?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF IS_FEMALE(MASTER) && !RAND:3
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 다리, 정말 예쁘고 매끈하네」
			PRINTFORMW 「가볍게 만져졌을 뿐인데, 거시기에서 여러 가지가 나올 것 같아♪」
			PRINTFORMW 「자♪ 다음엔 밟아봐♪」
			PRINTFORMW 「주저할 필요 없어. 내가 나도 모르게 비명을 지를 정도로 세게 부탁해♪」
		ELSEIF RAND:2
			PRINTFORMW 「아앙! 좋아! 더 밟고 차줘♪」
			PRINTFORMW 「나의 소중한 곳, 마음껏 유린해줬으면 해♪」
		ELSE
			PRINTFORMW 「아하핫♪ 밟히니까 느껴버린다니, 나 정말 얼마나 천박한 걸까♪」
			PRINTFORMW 「짜릿해진다♪」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「뭐, %CALLNAME:MASTER%라면 괜찮을까……」 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「......유쾌하지 않네」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
