;==================================================
;120,クンニ強制
;==================================================

@M_KOJO_MESSAGE_COM_K117_120
CALL M_KOJO_MESSAGE_COM_K117_120_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_120_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;＋助手調教
		IF TALENT:恋慕
			PRINTFORMW 「우후후…… 무심코 기절할 정도로 기분 좋게 해줄게」
			PRINTFORMW 페로리하고 혀를 내밀며, 겐게츠는 도발하듯 미소 지었다. 
			PRINTFORMW 「아하하! 받아버릴 거야♪」
			PRINTFORMW 겐게츠는 %조사처리(CALLNAME:MASTER,"를")% 덮치자, 그 비틈에 달려들었다.
		ELSE
			PRINTFORMW 「사실 처음 봤을 때부터 먹어버리고 싶다고 생각하고 있었어」
			PRINTFORMW 「왜냐면, 이렇게 귀엽잖아」
			PRINTFORMW 겐게츠는 기쁜 듯 %조사처리(CALLNAME:MASTER,"의")% 비열함을 탐하고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:2
			PRINTFORMW 「쪽… 쪽…♪ 후후… 더 목소리를 들려줘」
			PRINTFORMW 겐게츠는 교성을 자아내려고 격렬하게 %조사처리(CALLNAME:MASTER,"의")% 꿀을 탐하고 있다.
			PRINTFORMW 그 %조사처리(CALLNAME:MASTER,"는")% 힘없이 주저앉아 쾌락에 몸을 맡기고 있었다. 
		ELSE
			PRINTFORMW 「쪽... 음... 아하♪ 엄청 넘쳐흐르네. 멈추질 않는군」
			PRINTFORMW 겐게츠는 소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 꿀단지를 마시고 애액을 삼키고 있다.
			PRINTFORMW 「후후후... 야한 맛이네. 더 먹여줘♪」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:2
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 보지가 맛있네♪」
			PRINTFORMW 겐게츠는 %조사처리(CALLNAME:MASTER,"의")% 꿀단지를 마음에 들어 했는지 입을 떼려 하지 않는다.
		ELSE
			PRINTFORMW 「쪽...응...젖었네. 기분 좋아?」
			PRINTFORMW 소악마적으로 겐게츠는 미소 지으며 혀의 움직임을 재개했다.
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「ぺちゃ……ぺちゃ……」
		PRINTFORMW 얼굴 위에 걸린 %조사처리(CALLNAME:MASTER,"의")% 비열함에, 겐게츠는 혀를 핥고 있다.
		PRINTFORMW 그 혀의 움직임은 단조로웠고, 손을 빼고 있다는 것이 분명했다. 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
