;==================================================
;91,アナル舐めされる
;==================================================
@M_KOJO_MESSAGE_COM_K117_91
CALL M_KOJO_MESSAGE_COM_K117_91_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_91_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「お尻？　クスクス……いいよ。幻月お姉さんのアナル開発テク味わわせてあげる」
			PRINTFORMW 言うやいなや%CALLNAME:MASTER%は幻月によって所謂ちんぐり返しの体勢にされてしまった。
			PRINTFORMW 「アナルがひくひく言ってるよ。かわいい……」
			PRINTFORMW 幻月の舌が%CALLNAME:MASTER%の肛門に吸い込まれていく。
		ELSE
			PRINTFORMW 「まーた、マニアックな事させたがるのねぇ」
			PRINTFORMW 渋々といった表情で幻月は%CALLNAME:MASTER%の肛門へ顔を近づけた。
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:3 == 0 && HAS_PENIS(TARGET)
			PRINTFORMW 「ちゅぷ……んん……お尻の穴気持ちいい？」
			PRINTFORMW 頷いた%CALLNAME:MASTER%に幻月は嬉しそうだ。
			PRINTFORMW 「ねえ、折角生えてるんだから、入れちゃっていい？」
			PRINTFORMW 「この幻月お姉さんに任せてくれれば、三日で立派なケツマンコに仕上げてあげるよ」
			PRINTFORMW %CALLNAME:MASTER%は必死で首を横に振った。
		ELSEIF RAND:2 == 0 && !HAS_PENIS(TARGET)
			PRINTFORMW 「……んんん……じゅぱ。……うん美味しい」
			PRINTFORMW 貪っていた肛門と幻月の口の間には涎の橋が架かっている。
			PRINTFORMW 「貴方のお尻も結構緩んできたねぇ」
			PRINTFORMW 「私におちんちんがあれば突っ込んであげるんだけど」
			PRINTFORMW 「きっと気持ちいいんだろうなぁ」
			PRINTFORMW 幻月は冗談めかして言ったが、目は笑っていなかった。
		ELSE
			PRINTFORMW 「……ん……じゅぷ…ちゅぱ……」
			PRINTFORMW 「臭くて汚いお尻の穴♪　凄く苦いけど大好きな味だよ♪」
			PRINTFORMW 舌の刺激にひくひくする肛門を見て、幻月が妖艶に笑う。
			PRINTFORMW 「こんなに物欲しそうにして……いやらしいアナルだねぇ」
			PRINTFORMW 「仕方ないなあ……幻月お姉さんが開発してあげる♪」
			PRINTFORMW そう言って幻月はその細くしなやかな指を%CALLNAME:MASTER%の肛門へずぷりと突き入れた。
			PRINTFORMW そして直腸内のある一点を刺激し始める。
			PRINTFORMW 「ここが前立腺♪」
			PRINTFORMW 「男の子はここを弄られると女の子みたいによがっちゃうんだよ♪」
			PRINTFORMW 「本当はちょっと慣れないと気持ちよくなるのは難しかったりするけど……」
			PRINTFORMW 「貴方はきっと素質がある♪　良かったね♪　すぐ気持ちよくなれるよ♪」
			PRINTFORMW 「男の子を辞めさせてあげる。尻穴だけでいっちゃう卑しい体に作り変えてあげる♪」
			PRINTFORMW 幻月が甘く囁く。
			PRINTFORMW 痺れるようなオーガズムを感じながら%CALLNAME:MASTER%は、もしお尻でしか絶頂できない体になってしまったらどうしようかと、そんな事を考えていた。
		ENDIF 
		RETURN 1
	;屈服3
	ELSEIF ABL:奉仕精神 >= 3
		PRINTFORMW 「お尻匂うよ。ちゃんと拭いてる？」
		PRINTFORMW 「まあいいや。私の舌で綺麗にしてあげる♪」
		PRINTFORMW 「ん……ちゅぷ……すっごく濃いねぇ……」
		PRINTFORMW 幻月は%CALLNAME:MASTER%の肛門に舌を差込み、味わっている。 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「……んん……じゅぷ。……汚いお尻ね」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
