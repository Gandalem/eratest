;==================================================
;91,アナル舐めされる
;==================================================

@M_KOJO_MESSAGE_COM_K117_91
CALL M_KOJO_MESSAGE_COM_K117_91_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_91_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「엉덩이? 크크... 괜찮아. 겐게츠 언니의 항문 개발 테크를 맛보게 해줄게」
			PRINTFORMW 말하자마자 %조사처리(CALLNAME:MASTER,"는")% 겐게츠에 의해 소위 뒤집기 자세로 만들어졌다.
			PRINTFORMW 「항문이 파르르 떨고 있어. 귀여워...」
			PRINTFORMW 겐게츠의 혀가 %조사처리(CALLNAME:MASTER,"의")% 항문에 빨려 들어갔다.
		ELSE
			PRINTFORMW 「또, 마니아적인 걸 시키고 싶어 하는 거야.」
			PRINTFORMW 망설이는 표정으로 겐게츠는 %조사처리(CALLNAME:MASTER,"의")% 항문에 얼굴을 가까이했다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:3 == 0 && HAS_PENIS(TARGET)
			PRINTFORMW 「쭉……음……엉덩이 구멍 기분 좋아?」
			PRINTFORMW 고개를 끄덕인 %조사처리(CALLNAME:MASTER,"에게")% 겐게츠는 기쁜 듯했다.
			PRINTFORMW 「있잖아, 모처럼 자랐으니까 넣어줘도 돼?」
			PRINTFORMW 「이 겐게츠 언니한테 맡겨주면 사흘 만에 당당한 케츠만코로 만들어 줄게」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 필사적으로 고개를 저었다.
		ELSEIF RAND:2 == 0 && !HAS_PENIS(TARGET)
			PRINTFORMW 「……음음……쪽. ……응 맛있다」
			PRINTFORMW 탐닉하던 항문과 겐게츠의 입 사이에는 침의 다리가 놓여 있었다.
			PRINTFORMW 「너의 엉덩이도 꽤 풀렸네애」
			PRINTFORMW 「나에게 거시기만 있다면 박아줄 수 있는데」
			PRINTFORMW 「분명 기분 좋을 거야」
			PRINTFORMW 겐게츠는 농담처럼 말했지만, 눈은 웃고 있지 않았다.
		ELSE
			PRINTFORMW 「……음……쪽… 쭉……」
			PRINTFORMW 「냄새나고 더러운 항문구♪ 아주 쓰지만 제일 좋아하는 맛이야♪」
			PRINTFORMW 혀의 자극에 움찔거리는 항문을 보며, 겐게츠가 요염하게 웃는다.
			PRINTFORMW 「이렇게 욕망하는 걸 보니…… 야한 아날이네」
			PRINTFORMW 「어쩔 수 없지…… 겐게츠 누나가 개발해 줄 테니까♪」
			PRINTFORMW 그렇게 말하며 겐게츠는 그 가늘고 유연한 손가락을 %조사처리(CALLNAME:MASTER,"의")% 항문으로 쑥 밀어 넣었다.
			PRINTFORMW 그리고 직장 안의 한 지점을 자극하기 시작한다.
			PRINTFORMW 「여기가 전립선이야♪」
			PRINTFORMW 「남자는 여기를 만지면 여자처럼 몸을 비틀게 된단다♪」
			PRINTFORMW 「사실 좀 익숙해져야 기분 좋아지는 게 어려울 수도 있지만……」
			PRINTFORMW 「너는 분명 소질이 있어♪ 다행이다♪ 금방 기분이 좋아질 거야♪」
			PRINTFORMW 「남자인 걸 버리게 해줄게. 항문으로만 절정하는 비루한 몸으로 바꿔 줄게♪」
			PRINTFORMW 겐게츠가 달콤하게 속삭인다.
			PRINTFORMW 짜릿한 오르가즘을 느끼면서 %조사처리(CALLNAME:MASTER,"는")%, 만약 엉덩이로밖에 절정에 도달할 수 없는 몸이 되어버린다면 어쩌나 하고 그런 생각을 하고 있었다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF ABL:奉仕精神 >= 3
		PRINTFORMW 「엉덩이 냄새 나. 제대로 닦고 있어?」
		PRINTFORMW 「뭐 됐어. 내 혀로 깨끗하게 해 줄게♪」
		PRINTFORMW 「음... 츄릅... 엄청 진하네...」
		PRINTFORMW 겐게츠는 %조사처리(CALLNAME:MASTER,"의")% 항문에 혀를 넣고 맛보고 있다. 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「……음음……쮸읍. ……더러운 엉덩이네」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
