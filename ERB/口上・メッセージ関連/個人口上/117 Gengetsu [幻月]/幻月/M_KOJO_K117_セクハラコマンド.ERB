;==================================================
;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K117_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_310
CALL M_KOJO_MESSAGE_COM_K117_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 0
		IF TALENT:恋慕
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORMW 「지금은 그만둬 줄 수 있나요?」
				CASE 2,3
					PRINTFORMW 「쓰다듬는 게 즐거워...?」
				CASE 4
					PRINTFORMW 「당신이 즐겁다면 됐지만...」
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORMW 「히익! 그, 그런 건 그만둬 줄 수 있을까?!」
				CASE 2,3
					PRINTFORMW 「큭! 갑자기 뭐야!」
				CASE 4
					PRINTFORMW 「이번 한 번뿐이야」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K117_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_311
CALL M_KOJO_MESSAGE_COM_K117_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
		IF TALENT:恋慕
			PRINTFORMW (따뜻해, 와)
		ELSEIF TALENT:思慕
			PRINTFORMW (가끔은 이런 것도……)
		ELSE
			PRINTFORMW 「큭! 갑자기 뭘 하는 거야!」
		ENDIF
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「음... 으응...」
	ELSEIF CFLAG:うふふ == 0
		IF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「정말, 늘 갑자기네」
				CASE 0
					PRINTFORMW (역시 조금 부끄럽네, 와)
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORMW 「들키면 어쩌려고 그래」
		ELSE
			PRINTFORMW 「뭐, 뭐야, 갑자기!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K117_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_312
CALL M_KOJO_MESSAGE_COM_K117_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;隠岐奈口上を参考に
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
		;拒否
	ELSEIF TFLAG:194 == 99
		PRINTFORML 「그만둬라」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 다가온 얼굴을 맞았다.
	ELSEIF EXP:117:キス経験 == 1
		PRINTFORMW 「응, 쪽............」
		PRINTFORMW 「나의, 처음이었어.... 그... 어땠어?」
		;うふふ中で何かしらあるやつ（押し倒され中かな）
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;前から抱きしめる
			CASE 32
				PRINTFORML 「음, 츄, 츄우... 푸하」
				PRINTFORMW 「온몸으로 %조사처리(CALLNAME:MASTER,"를")% 느낄 수 있어...」
				;手淫
			CASE 50
				PRINTFORML 「음, 쪽……」
				PRINTFORMW 「후후, 키스하면서 하는 게 더 좋은가 봐」
				;ディープキス
			CASE 60
				PRINTFORMW 「츄... 쫩, 츄푸... 음무」
				;性交系
			CASE 85,87,88,89
				SELECTCASE RAND:3
					CASE 2
						PRINTFORML 「응, 쪽, 츄...」
						PRINTFORMW (위도 아래도... 기분 좋아...)
					CASE 1
						PRINTFORML 「츄, 응, 쪽……냠……」
						PRINTFORMW 겐게츠는 녹아내린 얼굴로 쾌락을 즐기고 있다.
					CASE 0
						PRINTFORML 「음... 응, 쪽, 쭉쭉... 퉤」
						PRINTFORMW 「좋아, 좋아, %CALLNAME:MASTER%!」
				ENDSELECT
				;だいしゅきホールド
			CASE 86
				PRINTFORML 「음, 쪽, 츄... 츄풉」
				;好きってそう簡単に言わせたくないおじさん
				IF TALENT:恋慕 || TALENT:恋人 || TALENT:愛欲
					SELECTCASE RAND:2
						;ちょっとキャラ崩壊気味？
						CASE 1
							PRINTFORMW 「하아, 좋아해, %CALLNAME:MASTER%」
						CASE 0
							PRINTFORMW 「%CALLNAME:MASTER%, 내보일게, 그렇다면……내 안에서……」
					ENDSELECT
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 내보일게, 그렇다면……내 안에서……」
				ENDIF
		ENDSELECT
		;日常で
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「음, 쪽, 쭈욱......」
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「......%조사처리(CALLNAME:MASTER,"가")% 키스할 때는 언제나 갑작스럽지」
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%, 키스는 좋아하니?」
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 혀, 맛있다」
					PRINTFORMW 뭔가 무서운 말을 들었다.
			ENDSELECT
		ELSE
			PRINTFORML 「응, 쪽...」
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「......잠깐, 혀 넣지 마!」
				CASE 0
					PRINTFORMW 「꽤 잘하네.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
