@M_KOJO_MESSAGE_PALAMCNG_D_K117(ARG)
;-------------------------------------------------
;After reaching certain threshold for palams for the first time
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;don't show if unconscious
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 0
	
SIF CFLAG:うふふ != 1 ;don't show stuff below unless having sex
	RETURN 0

;-------------------------------------------------
;初めて潤滑がLV2超えた
;-------------------------------------------------
IF PALAM:潤滑 + UP:潤滑 > PALAMLV:2 && FIRSTTIME("潤滑V2")
	IF IS_SELECTCOM("ローション")
		PRINTFORMW 「うーん。ねとねと」
	ELSEIF TALENT:恋慕
		PRINTFORMW 「あれ？　濡れてる？」
		PRINTFORMW 「クスクス……頑張ってくれたんだね。ちょっと見直したわ」
	ELSE
		PRINTFORMW 「……うーん」
		PRINTFORMW 「ちょっと期待したのと違うなぁ」
	ENDIF
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
IF PALAM:欲情 + UP:欲情 > PALAMLV:3 && FIRSTTIME("欲情V2")
	IF IS_SELECTCOM("媚薬")
		PRINTFORMW 「なりふり構わないねぇ。まあ私は気持ちよければ何でもいいけど」
	ELSE
		PRINTFORMW 「うふふ……ちょっと体が火照ってきたかも」
	ENDIF
ENDIF

;-------------------------------------------------
;初めて恥情がLV2超えた
;-------------------------------------------------
IF PALAM:恥情 + UP:恥情 > PALAMLV:3 && FIRSTTIME("恥情V2")
	PRINTFORMW 「あはは♪　ここは恥ずかしがった方が可愛く見えるかな？」
ENDIF

;-------------------------------------------------
;初めて恐怖がLV2超えた
;-------------------------------------------------
IF PALAM:恐怖 + UP:恐怖 > PALAMLV:3 && FIRSTTIME("恐怖V2")
	PRINTFORMW 「あは♪　背中がぞくっとしたよ」
	PRINTFORMW 「自分も生き物だったって事を久々に思い出したわね」
ENDIF
