#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	IF FIRSTTIME("GengetsuCoom")
		IF TALENT:恋慕
			PRINTFORMW 「あはは、すっごい。射精ってこんなに気持ちいいんだ」
			PRINTFORMW 「病み付きになりそうよ」　
		ELSE
			PRINTFORMW 「おー、精子が出てる。すごいすごーい」
		ENDIF
	ELSE
		IF TCVAR:2 == 4 ;mouth
			PRINTFORMW 「あは♪　突っ込んであげるね」
			PRINTFORMW 幻月は有無を言わせず%CALLNAME:MASTER%の喉の奥にペニスを捻じ込んだ。
			PRINTFORMW 「どう？　おいしい？」
			PRINTFORMW びくりびくりと跳ねるペニスが喉の奥に精液を流し込んでいる。
		ELSEIF GROUPMATCH(TCVAR:2, 3, 5, 7) ;hj, tj, fj
			PRINTFORMW 「うふふ、ぶっかけてあげる」
			PRINTFORMW 幻月は逃げる暇も与えず%CALLNAME:MASTER%の顔面目掛けて大量の精液を飛ばした。
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「おー？　一杯出たねぇ」
					PRINTFORMW 幻月は自分の出した精液を指先で弄んでいる。
				CASE 1
