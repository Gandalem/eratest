IF !FLAG:70 && NOWEX:Ａ絶頂 > 0 && FIRSTTIME("初Ａ絶頂")
	SIF LOCAL
		PRINTFORML
	PRINTFORMW 「あ！…あん……ふぁ！…あぁん！」
