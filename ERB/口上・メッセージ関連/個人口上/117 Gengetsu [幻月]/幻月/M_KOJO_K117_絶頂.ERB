	; SIF LOCAL
		; PRINTFORML
	; LOCAL ++
; ENDIF

;end here after first orgasms
SIF LOCAL
	RETURN 1
SIF FLAG:70
	RETURN 0

;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	IF IS_SELECTCOM("自慰") && ONCE("GengetsuFap")
		PRINTFORMW 「んん……ふぁ…あん！　……いっちゃた♪」
		PRINTFORMW 「クスクス……いつまででも気持ち良くなれるのは女の子の特権よね♪」
		RETURN 1
	ENDIF
	
	SELECTCASE NOWEX:TotalEX
