LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF ABL:精液中毒 >= 5
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「응츄……츄……꿀꺽……♪」
				PRINTFORMW 「……푸하아. 한 잔 나왔네♪ 정말 맛있었어」
