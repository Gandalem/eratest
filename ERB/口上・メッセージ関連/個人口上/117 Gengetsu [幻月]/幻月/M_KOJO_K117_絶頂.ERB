; Modular ERB: 個人口上/117 Gengetsu [幻月]/幻月/M_KOJO_K117_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ added
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K117
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	IF FIRSTTIME("GengetsuCoom")
		IF TALENT:恋慕
			PRINTFORMW 「아하하, 굉장해. 사정이라는 게 이렇게 기분 좋은 거구나」
			PRINTFORMW 「병 들 것 같아.」　
		ELSE
			PRINTFORMW 「오, 정액이 나오고 있어. 대단해 대단해.」
		ENDIF
	ELSE
		IF TCVAR:2 == 4 ;mouth
			PRINTFORMW 「아하♪ 박아줄게」
			PRINTFORMW 겐게츠는 말할 틈도 주지 않고 %조사처리(CALLNAME:MASTER,"의")% 목구멍 깊숙이 페니스를 밀어 넣었다.
			PRINTFORMW 「어때? 맛있어?」
			PRINTFORMW 움찔움찔 떨리는 페니스가 목구멍 깊은 곳으로 정액을 흘려보내고 있다.
		ELSEIF GROUPMATCH(TCVAR:2, 3, 5, 7) ;hj, tj, fj
			PRINTFORMW 「우후후, 뿌려줄게」
			PRINTFORMW 겐게츠는 도망칠 틈도 주지 않고 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 향해 다량의 정액을 날렸다.
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「오? 한 모금 나왔네.」
					PRINTFORMW 겐게츠는 자신이 배출한 정액을 손끝으로 가지고 놀고 있다.
				CASE 1
					PRINTFORMW 「후아앙! 있잖아, 보고 있어, 수치스럽게 정액을 내보내는 나를!」
				CASE 2
					PRINTFORMW 「크크크♪ 많이 나왔으니 행복해♪」
					PRINTFORMW 만족스러운 겐게츠는 자신의 정자를 손가락으로 떠 입속에 가져갔다.
				CASE 3
					PRINTFORMW 「후하♪ 사정해버렸네♪」
					PRINTFORMW 「...남자가 원숭이처럼 자위하는 이유를 알겠어.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
LOCAL = 0
;added first time orgasms, from ym + modified
;-------------------------------------------------
;初めてC絶頂
;-------------------------------------------------
IF !FLAG:70 && NOWEX:Ｃ絶頂 > 0
	PRINTFORMW 「후아...... 아앙! ......어라? 혹시 나 가버렸나?」
	LOCAL ++
ENDIF
;-------------------------------------------------
;初めてV絶頂
;-------------------------------------------------
IF !FLAG:70 && NOWEX:Ｖ絶頂 > 0 && FIRSTTIME("初Ｖ絶頂")
	SIF LOCAL
		PRINTFORML
	PRINTFORMW 「아하하♪ 해버렸다♪」
	PRINTFORMW 「역시 보지는 좋네♪」
	LOCAL ++
ENDIF
;-------------------------------------------------
;初めてA絶頂
;-------------------------------------------------
IF !FLAG:70 && NOWEX:Ａ絶頂 > 0 && FIRSTTIME("初Ａ絶頂")
	SIF LOCAL
		PRINTFORML
	PRINTFORMW 「아! ...앙...파! ...아앙!」
	PRINTFORMW 「...쿠스♪ 엉덩이로 해버렸다」
	LOCAL ++
ENDIF
;-------------------------------------------------
;初めてB絶頂
;-------------------------------------------------
IF !FLAG:70 && NOWEX:Ｂ絶頂 > 0 && FIRSTTIME("初Ｂ絶頂")
	SIF LOCAL
		PRINTFORML
	PRINTFORMW 「파아! ...아앙!」
	PRINTFORMW 「...가버린 것 같아. 꽤 유두는 느끼는구나」
	LOCAL ++
ENDIF
;-------------------------------------------------
;初めてＭ絶頂
;-------------------------------------------------
; IF !FLAG:70 && NOWEX:Ｍ絶頂 > 0 && FIRSTTIME("初Ｍ絶頂")
; SIF LOCAL
; PRINTFORML
; LOCAL ++
; ENDIF
;end here after first orgasms
SIF LOCAL
	RETURN 1
SIF FLAG:70
	RETURN 0
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	IF IS_SELECTCOM("自慰") && ONCE("GengetsuFap")
		PRINTFORMW 「응음... 하아... 안! ...해버렸다 ♪」
		PRINTFORMW 「크크크... 언제까지라도 기분 좋아질 수 있는 건 여자들의 특권이지 않아 ♪」
		RETURN 1
	ENDIF
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 「……아아……후아앙!」
			PRINTFORMW 「후우……좀 신경 쓰게 해버렸네」
			PRINTFORMW 「응, 그 정도 기분 좋았어♪」
			;中
		CASE 2 TO 4
			PRINTFORMW 「아하하! 머릿속이 하얗게 돼. 이 정신을 잃을 정도의 쾌락을 당신에게도 가르쳐 주고 싶어♪」  
			;弱
		CASE 1
			PRINTFORMW 「%MOAN(,,RAND(3,7),"rand")%!」
	ENDSELECT
ENDIF
