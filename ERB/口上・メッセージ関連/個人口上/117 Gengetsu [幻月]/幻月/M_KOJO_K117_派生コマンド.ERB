RETURN 1
;一人目口上

@M_KOJO_MESSAGE_SCOM_K117_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORMW 「둘 다 동시에?」
			PRINTFORMW 「그런 거 당하면, 조루 씨는 금방 가버릴 것 같은데♪」
		ELSE
			PRINTFORMW 「두 분 둘이서 잘 해나가 주면 된다고 생각하는데.」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「음……츄. ……안 돼 %CALLNAME:LOCAL%」
		PRINTFORMW 「가게 해달라고 한심한 목소리를 낼 때까지, 충분히 애태워주는 거야 ♪」
		PRINTFORMW 겐게츠는 %CALLNAME:LOCAL%의 귀두에 질척하게 혀를 문질렀다.
		PRINTFORMW 하지만 좀처럼 절정에 이르게 해주지 않아서, %조사처리(CALLNAME:MASTER,"는")% 답답해서 무심코 허리를 흔들어 버렸다.
		PRINTFORMW 그 모습을 본 겐게츠는 쿠스스 웃었다. 
		RETURN 1
	ELSE
		PRINTFORMW 「음, 열심히 할게.」
		PRINTFORMW 「%CALLNAME:LOCAL%이 의욕 넘치니까, 나는 필요 없을지도 모르겠는데?」
		RETURN 1
	ENDIF
ENDIF
