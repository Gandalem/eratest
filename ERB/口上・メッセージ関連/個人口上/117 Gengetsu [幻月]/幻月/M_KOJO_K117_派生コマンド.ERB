@M_KOJO_MESSAGE_SCOM_K117_1
CALL M_KOJO_MESSAGE_SCOM_K117_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K117_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕 && !HAS_PENIS(MASTER)
			PRINTFORMW 「아하하, 같이 서로 입맞춤하자♪」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「서로 맛보는 거야? 응, 괜찮아」
			PRINTFORMW 「한 잔 기분 좋게 해줘. 나도 힘내서 빨 테니까」
			PRINTFORMW 그렇게 말하며 겐게츠는 %조사처리(CALLNAME:MASTER,"에게")% 몸을 기울였다.
		ELSEIF !HAS_PENIS(MASTER)
			PRINTFORMW 「어머? 당신은 여자 상대여도 괜찮은 거군요」
		ELSE
			PRINTFORMW 「당신이 위에 되는 거야? ……뭐 상관없지만.」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF !HAS_PENIS(MASTER) && !RAND:3
			PRINTFORMW 「아하♪ %조사처리(CALLNAME:MASTER,"의")% 국물 정말 맛있다. 내 건 어때?」
			PRINTFORMW 겐게츠와 %조사처리(CALLNAME:MASTER,"는")% 서로의 성기에서 분비되는 액체를 소리를 내며 마시고 있다.
		ELSEIF HAS_PENIS(MASTER) && !RAND:3
			PRINTFORMW 「츄……츄파. 아하♪ 카우퍼가 줄줄 새네. 느끼고 있구나. 기뻐♪」
			PRINTFORMW 「하지만, 게을리하면 안 되잖아. 입이 자리를 비웠어」
			PRINTFORMW 겐게츠는 한 것을 빨면서, 애액을 문지르듯이 젖은 은밀한 곳을 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 밀어붙였다. 
		ELSEIF !RAND:2
			PRINTFORMW 「아……안! ……팬! 할 거야」
			PRINTFORMW 「쿠스♪ 보답해 줄게♪」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 혀에 만족한 듯 겐게츠는, 한 개를 다시 물고 주보주보 소리를 내며 다루기 시작했다.
		ELSE
			PRINTFORMW 「크크크... 함께 기분 좋아져요」
			PRINTFORMW 「먼저 가게 하는 쪽이 이기는 거야♪」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「보지가 만족스럽지 않네.」
		PRINTFORMW 「너만 기분 좋아지는 거 불공평하지 않아?」 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K117_{SELECTCOM}_1
RETURN 1
