;==================================================
;1,シックスナイン
;==================================================
@M_KOJO_MESSAGE_SCOM_K117_1
CALL M_KOJO_MESSAGE_SCOM_K117_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K117_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕 && !HAS_PENIS(MASTER)
			PRINTFORMW 「あはは、一緒におまんこ舐め合おう♪」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「舐めあうの？　うん、いいよ」
			PRINTFORMW 「一杯気持ちよくしてね。私も気合入れてしゃぶるから」
			PRINTFORMW そう言って幻月は%CALLNAME:MASTER%にのしかかった。
		ELSEIF !HAS_PENIS(MASTER)
			PRINTFORMW 「あら？　貴方は女の子相手でも大丈夫なのね」
		ELSE
			PRINTFORMW 「貴方が上になるの？　……別にいいけど」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF !HAS_PENIS(MASTER) && !RAND:3
			PRINTFORMW 「あは♪　%CALLNAME:MASTER%のおつゆとっても美味しいね。私のはどうかな？」
			PRINTFORMW 幻月と%CALLNAME:MASTER%は、互いの性器から分泌される液体を音を立てて啜りあっている。
		ELSEIF HAS_PENIS(MASTER) && !RAND:3
			PRINTFORMW 「ちゅ……ちゅぱ。あは♪　カウパー駄々漏れだね。感じてくれてるんだ。嬉しい♪」
			PRINTFORMW 「でも、サボっちゃだめでしょ。お口がお留守になってるわ」
			PRINTFORMW 幻月は一物をしゃぶりながら、愛液を塗りたくるように濡れた秘裂を%CALLNAME:MASTER%の顔に押し付けた。 
		ELSEIF !RAND:2
			PRINTFORMW 「ぁ……あん！　……ふぁん！　やるねぇ」
			PRINTFORMW 「クス♪　お返ししてあげる♪」
			PRINTFORMW %CALLNAME:MASTER%の舌に満足したらしい幻月は、一物を咥え直すとジュボジュボと音を立てて扱き始めた。
		ELSE
			PRINTFORMW 「クスクス……一緒に気持ちよくなりましょ」
			PRINTFORMW 「先にいかせた方が勝ちね♪」
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「おまんこの気持ちよさが足りないなぁ」
		PRINTFORMW 「貴方ばっかり気持ちよくなって不公平じゃない？」 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K117_{SELECTCOM}_1
RETURN 1

