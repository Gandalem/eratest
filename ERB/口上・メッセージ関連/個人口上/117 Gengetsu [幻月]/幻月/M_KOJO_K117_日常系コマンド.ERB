			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 「뭐, 나쁘지 않은 기분이네」
					PRINTFORMW 겐게츠는 잡힌 손을 의식하고 있는 듯하다.
				CASE 0
