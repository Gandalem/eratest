;==================================================
;617,甘味処に誘う
;TFLAG:193(1=大成功 0=成功 -1=失敗)(地の文分岐は大成功のみ追加
;==================================================

@M_KOJO_SUCCESS_COM_K117_617
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_617
CALL M_KOJO_MESSAGE_COM_K117_617_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_617_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;幻月は甘いの好きだって！
	IF TFLAG:193 == 1
		PRINTFORML 「별로 내 취향의 맛은 아니었어」
		PRINTFORMW 겐게츠는 약간 불만스러워했다.
	ELSEIF TFLAG:193 == 0
		;洋風のほうが好きみたいなので和菓子分岐に入るのを少なめに
		IF RAND:3 == 1
			PRINTFORML 화과자점에 들어가기로 했다.
			PRINTFORMW 「화과자도 가끔은 좋네」
			PRINTFORML
			PRINTFORML
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 「쫀득한 느낌이 참 좋네」
					PRINTFORMW 겐게츠는 경단(다코)을 맛있게 먹고 있다.
				CASE 2
					PRINTFORML 「이렇게 먹는 게 매너라고 하네」
					PRINTFORMW 겐게츠는 양갱을 깔끔하게 나누어 가며 먹고 있었다.
				CASE 1
					PRINTFORML 「시원해서 맛있어……. 컥」
					PRINTFORMW 겐게츠는 와라비모치의 킨코에 기침을 한다.
				CASE 0
					PRINTFORML
					SELECTCASE DAY:2
						CASE 1 ;春
							PRINTFORML 「벚꽃 맛이라는 게 영 모르겠네」
							PRINTFORMW 그렇게 말하면서 겐게츠는 벚꽃떡을 먹고 있다.
						CASE 2 ;夏
							PRINTFORML 「수만주우는, 보기에도 시원해 보여.」
							PRINTFORMW 확실히 조금 더 더위가 가신 것 같다.
						CASE 3 ;秋
							PRINTFORML 「밤과 양갱. 한쪽만 먹어도 맛있는데 둘이 합쳐지니 최고네」
							PRINTFORMW 마치 겐게츠와 무게츠 같다.
						CASE 4 ;冬
							PRINTFORML 「후우, 따뜻해진다……」
							PRINTFORMW 겐게츠는 젠자이를 마시며 느긋하게 있다.
					ENDSELECT
			ENDSELECT
		ELSE
			PRINTFORML 양과자점에 들어가는 것으로 했다.
			PRINTFORMW 「나는 화과자보다 서양 과자파야. 물론 화과자도 좋아하지만 말이야」
			PRINTFORML
			PRINTFORML
			SELECTCASE RAND:4
				CASE 3 ;ケーキ　種類たくさんあるし分岐
					SELECTCASE RAND:3
						CASE 2
							PRINTFORMW 겐게츠는 쇼트케이크를 주문했다.
							PRINTFORML 「정석이지만 이게 좋으니까」
							PRINTFORMW 겐게츠는 딸기는 마지막에 먹는 편인 것 같다.
						CASE 1
							PRINTFORMW 겐게츠는 치즈케이크를 주문했다.
							PRINTFORML 「여러 종류가 있지만, %조사처리(CALLNAME:MASTER,"는")% 어떤 게 좋아?」
							PRINTFORMW 「나는 전부 좋아해」
						CASE 0
							PRINTFORMW 겐게츠는 과일 타르트를 주문했다.
							PRINTFORML 「과일의 산미와 케이크의 단맛을 동시에 맛볼 수 있는 멋진 케이크야」
							PRINTFORMW 확실히 겐게츠는 행복해하며 먹고 있다.
					ENDSELECT
				CASE 2
					PRINTFORML 겐게츠는 쿠키를 집어 먹으며 홍차를 마시고 있다.
					PRINTFORMW 「진정되네」
				CASE 1
					PRINTFORMW 겐게츠는 슈크림을 주문했다.
					PRINTFORMW 만면에 미소를 지으며 그것을 즐기는 겐게츠를 보고 나까지 행복해진다.
				CASE 0
					PRINTFORMW 겐게츠는 파운드케이크를 주문했다.
					PRINTFORML 「심플하지만, 그게 좋지.」
					PRINTFORMW 「...어머, 이거 차 잎을 넣어 만든 건가? 맛있네.」
			ENDSELECT
		ENDIF
	ELSE
	ENDIF
ENDIF
RETURN 1
