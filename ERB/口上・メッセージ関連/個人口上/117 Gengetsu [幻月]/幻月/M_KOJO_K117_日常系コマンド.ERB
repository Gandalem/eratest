	;食事をふるまうと同一
	SELECTCASE TFLAG:193
		;失敗
		CASE -1
			IF TALENT:恋慕
				PRINTFORML
				PRINTFORMW 「뭐, %조사처리(CALLNAME:MASTER,"가")% 만들어 주는 건 뭐든지 맛있어……」
			ELSEIF TALENT:思慕
				PRINTFORML
