; Modular ERB: 個人口上/117 Gengetsu [幻月]/幻月/M_KOJO_K117_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K117_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K117_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML
	;それぞれ5種類以上作れたらいいな
	;現在は陥落状態->成功など　という分岐ですが、 成功など->陥落状態のほうがいいかも？
	;とは言えどちらでもあんま支障はないような気もする
	;恋慕
	;せっかくなのでラブラブにしたいけど、イメージとそれるか？
	;あなたに質問してきたり、頼りにしてきたり
	IF TALENT:恋慕
		IF TFLAG:193 == -3 ;custom code, hate mark 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「아아. 당신의 머리가 갑자기 폭발해버렸으면 좋겠는데」
				CASE 1
					PRINTFORMW 「……하아」
					PRINTFORMW 겐게츠는 %조사처리(CALLNAME:MASTER,"의")% 모습을 보자 노골적으로 한숨을 쉬었다.
				CASE 2
					PRINTFORMW 「뭐라고 해야 할까…… 당신과는 맞지 않아」
					PRINTFORMW 「지금 여기서 갈기 버리지 못하는 게 유감이야」
					PRINTFORMW 겐게츠가 작은 목소리로 중얼거렸다. 그 눈동자에서 읽을 수 있는 것은 명백한 경멸과 살의였다.
			ENDSELECT
			;怒り
		ELSEIF CFLAG:318
			PRINTFORMW 「지금은 별로 이야기할 기분이 아니야」
			;失敗、大失敗
		ELSEIF TFLAG:193 == -1 || TFLAG:193 == -2
			;思いつかないので思慕のを
			PRINTFORMW 「고요함을 즐기는 것도 좋은 거야」
			;成功
		ELSE
			SELECTCASE RAND:12
				CASE 11
					;料理について
					IF ABL:料理技能 < 2
						PRINTFORML 「무게츠의 요리, 맛있구나」
						PRINTFORML 「다음에 가르쳐 달라고 해야겠네」
						PRINTFORML (그리고 언젠가 %CALLNAME:MASTER%에 맛있는 요리를……!)
						PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 겐게츠가 무언가를 결심하는 것을 느꼈다.
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%, 뭔가 먹고 싶은 거 있어?」
						PRINTFORMW 「나한테 만들 수 있는 거라면 다음에 만들어 줄게」
					ENDIF
				CASE 10
					PRINTFORML 겐게츠에게 메이드복이 잘 어울리지 않을까 생각한다…….
					PRINTFORML 「나한테? 메이드복이라고?」
					PRINTFORML 아무래도 입 밖으로 내버리고 말았다.
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 가끔 이해할 수 없는 말을 하곤 하지……」
					PRINTFORML 꽤 진심인데 말이다.
					PRINTFORML 「응 응 고마워 고마워」
					PRINTFORMW 겐게츠는 들으려 하지 않았다.
				CASE 9
					PRINTFORML 「%CALLNAME:MASTER%, 겐게츠를 본 적이 있니?」
					PRINTFORML 지금 눈앞에 있지만...?
					PRINTFORML 「그게 아니라... 달의 현상 말이야」
					PRINTFORML 「아주 아름다운 현상이거든, 그걸 보는 걸 좋아해」
					PRINTFORMW 「언젠가 둘이서 보고 싶어」
				CASE 8
					PRINTFORML 「천사인지 악마인지 확실해줬으면 좋겠어?」
					PRINTFORMW 약간의 흥미에서 물어봤다.
					PRINTFORML 「옛날엔 천사였거든. 그러다가 여러 가지 일이 생겨서 천계에서 추방당했지…….」
					PRINTFORMW 겐게츠는 자신의 과거에 대해 이야기해 주었다…….
					PRINTFORML
					PRINTFORML 「물론 농담이야」
					PRINTFORMW 그녀의 사연 이야기의 마지막 말이다.
				CASE 7
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 이 시간이 멈췄으면 하고 생각해 본 적이 있어?」
					PRINTFORML 환월의 갑작스러운 발언에 %조사처리(CALLNAME:MASTER,"는")% 가슴이 철렁한다.
					PRINTFORML 「나는 지금 이 순간이 영원히 계속되기를 바라고 있어.」
					PRINTFORMW 그런 거였구나.
				CASE 6
					;突然始まる最強談義
					PRINTFORML 「이 환상향에는 강한 사람들이 많이 있네」
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 누가 최강이라고 생각해?」
				CASE 5
					;メイドキャラについて
					PRINTFORML 「너 이자요이 사쿠야라는 메이드 알고 있니?」
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 마을에서 몇 번 본 적 있다고 대답했다.
					PRINTFORML 「응, 홍마관에서 일하는 그녀 말이야.」
					PRINTFORML 「시간을 조종할 수 있고, 일도 잘 한다고 해.」
					PRINTFORMW 「어떻게든 꿈환관으로 스카우트하고 싶어.」
				CASE 4
					PRINTFORML 「최근까지 무쌍세계에 살았기 때문에 환상향에 대해서는 잘 몰라.」
					PRINTFORML 「그러니까 앞으로 이것저것 가르쳐 줘, %CALLNAME:MASTER%.」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 자신도 그렇게 자세히는 알지 않지만 하고 머리를 긁었다.
				CASE 3
					;メイドについて
					PRINTFORML 「당신은 메이드복에 대해 어떻게 생각해?」
					PRINTFORML 진지한 눈빛의 겐게츠에게 %CALLNAME:MASTER%도 성실하게 대답해 보았다.
					PRINTFORML 「그렇구나, 그런 시각도 있는 거네……」
					PRINTFORMW 겐게츠는 팔짱을 끼고 무언가를 생각하기 시작했다…….
				CASE 2
					;夢月について
					PRINTFORML 「별로 무게츠는 메이드가 아닌데 말이야」
					PRINTFORML 왜 집안일을 해주는 걸까 하고 겐게츠는 이상하게 생각한다.
					PRINTFORMW 「뭐, 도움이 되니까 괜찮지만」
				CASE 1
					;からかう
					;シチュは思慕とおんなじ
					;恋慕だともう恥ずかしがらないね
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")%, 겐게츠에게 오늘도 귀엽다고 속삭여 보았다.
					PRINTFORML 「응, 고마워」
					PRINTFORMW 기쁜 듯 수줍어하는 겐게츠의 미소에 %조사처리(CALLNAME:MASTER,"는")% 치유되었다.
				CASE 0
					;夢幻世界について
					PRINTFORML 무한세계에 대해 이야기해 보았다……
					PRINTFORML 「무게츠가 만든 이 세상의 낙원이야. ……이 세상이라는 표현은 적절하지 않을까?」
					PRINTFORML 「어쨌든, 거기는 좋은 곳이야. 당신도 다음에 와보지 않겠어?」
			ENDSELECT
		ENDIF
		;思慕
		;ある程度まで詳しくORまともに話してくれる(思慕でようやく？)
		;気分で書くことになりそうだなー
	ELSEIF TALENT:思慕
		;怒り
		IF CFLAG:318 || TFLAG:193 == -3 ;custom code, hate mark 3
			PRINTFORMW 「지금은 별로 이야기할 기분이 아니야」
			;失敗、大失敗
		ELSEIF TFLAG:193 == -1 || TFLAG:193 == -2
			PRINTFORMW 「고요함을 즐기는 것도 좋은 거야」
			;成功
		ELSE
			SELECTCASE RAND:9
				CASE 8
					PRINTFORML 「저는 단 걸 좋아해요.」
					PRINTFORMW 「혹시 괜찮으면 다음에 추천해 줄 만한 가게를 알려줄게요.」
				CASE 7
					;本当はゴロゴロしてましたが言いたくない幻月
					PRINTFORML 「몽환적인 세계에서 뭘 하고 있었니...?」
					PRINTFORML 「...뭐, 기본적으로 차를 마시고 있었지」
					PRINTFORMW 겐게츠는 잠시 고민한 뒤 %조사처리(CALLNAME:MASTER,"의")% 질문에 대답해 주었다.
				CASE 6
					PRINTFORML 「악마인데 왜 날개인지 궁금해?」
					PRINTFORML 「천사 같으면서 악마라니 멋있잖아.」
					PRINTFORMW 천사와 같은 미소를 지으며, 겐게츠는 농담처럼 말했다.
				CASE 5
					;メイドキャラについて
					PRINTFORML 「환상향에는 메이드형 안드로이드 같은 게 있는 모양이네」
					PRINTFORMW 「시대의 발전을 느꼈어」
				CASE 4
					PRINTFORML 「과연 그렇구나」
					PRINTFORML 「이 환상향은 아직 내가 모르는 것들로 가득하네」
					PRINTFORMW 겐게츠는 흥미로운 듯 행동했다.
				CASE 3
					;メイドについて
					PRINTFORML 「메이드의 장점? 다시 들으니 어렵네요...」
					PRINTFORML 「...자신에게 순종하는 아이는 매력이 없나요?」
					PRINTFORMW 「아니, 무게츠를 그런 눈으로 보고 있는 건 아니에요?」
				CASE 2
					;夢月について
					PRINTFORML 「무게츠의 메이드옷? 내가 명한 게 아니야. 알아차리니 이미 입고 있었어.」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")%, 겐게츠와 조금 고찰해 보았다.
				CASE 1
					;からかう
					;なんかスキンシップっぽいな
					;幻月はからかいがいがあるので、もっと増やしたい
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 겐게츠에게 오늘도 귀엽다고 속삭여 보았다.
					PRINTFORML 「뭐, 뭐 뭐야 갑자기!!」
					PRINTFORMW 아무것도 아닌데도 겐게츠는 얼굴을 붉히며 고개를 떨구었다.
				CASE 0
					PRINTFORML 「나의 연애 경험?」
					PRINTFORML 「그런 %조사처리(CALLNAME:MASTER,"는")% 어때서 그래」
					PRINTFORMW 겐게츠에게 화제를 돌려버렸다.
			ENDSELECT
		ENDIF
		;恋慕でも思慕でもない
		;あんまり詳しくは話してくれないOR興味なさげ
	ELSE
		;怒り
		IF CFLAG:318 || TFLAG:193 == -3 ;custom code, hate mark 3
			PRINTFORML 「ﾁｯ」
			PRINTFORMW 겐게츠는 화가 난 것 같다.
			;大失敗
		ELSEIF TFLAG:193 == -2
			PRINTFORML 「뭐, 그런 것도 모르고 있어?」
			PRINTFORMW 겐게츠는 믿을 수 없다는 듯했다.
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORMW 「잠깐, 뭐 좀 얘기해 봐.」
			;成功
		ELSE
			SELECTCASE RAND:8
				CASE 7
					PRINTFORML 「귀엽다고?」
					PRINTFORML 「뭐야 갑자기. 성추행이야?」
					PRINTFORMW 겐게츠는 의아한 듯하고 있다.
				CASE 6
					;本当はごろごろしてただけなので言いたくない。
					PRINTFORML 「몽환 세계에서 뭘 하고 있었냐고?」
					PRINTFORML 「……%CALLNAME:MASTER%에게는 말해 주지 않을 거야」
					PRINTFORMW 겐게츠는 잠시 고민하는 듯한 모습을 보인 후 %조사처리(CALLNAME:MASTER,"의")% 부탁을 거절했다.
				CASE 5
					PRINTFORML 겐게츠는 어느 정도 강한지 물어봤다…….
					PRINTFORMW 「자랑할 수는 없지만, 이 환상향에서도 위에서부터 세는 게 빠를 거야」
				CASE 4
					PRINTFORML 「후우, 그런 일이 있었구나」
					PRINTFORMW 겐게츠는 %조사처리(CALLNAME:MASTER,"의")% 이야기를 흥미 없다는 듯 듣고 있다.
				CASE 3
					;幻月はメイド好き
					PRINTFORML 「메이드의 좋음? 당신에게는 모를 거야」
					PRINTFORMW 겐게츠는 단정 지었다.
				CASE 2
					;幻月はシスコン
					PRINTFORML 「무게츠? 그 아이는 할 수 있는 아이야」
					PRINTFORMW 당신은 무게츠의 유능함을 충분히 들었다.
				CASE 1
					PRINTFORML 「꿈환세계는 쾌적이야」
					PRINTFORMW 겐게츠는 자랑스럽게 말했다.
				CASE 0
					;思いつかない。。。
					PRINTFORML 「그럼 저건 어때?」
					PRINTFORMW 겐게츠는 추천을 해 주었다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K117_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_301
CALL M_KOJO_MESSAGE_COM_K117_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;失敗
	IF TFLAG:193 == -1
		PRINTFORML
		PRINTFORML 「맛이 없네……」
		PRINTFORMW 「더 정진하거라」
		;成功
		;恋慕とかでの分岐が浮かばない
	ELSE
		SELECTCASE RAND:5
			CASE 4
				PRINTFORML
				PRINTFORML 「아, 좋은 차잎이네」
				PRINTFORML 「어디서 구한 걸까?」
				PRINTFORMW 마음에 들어 주신 것 같네요.
			CASE 3
				PRINTFORML
				PRINTFORML 「음, 맛있다」
				PRINTFORMW 겐게츠의 날개가 파닥파닥 움직였다.
			CASE 2
				PRINTFORML
				PRINTFORMW 「그러고 보니, 좋은 다과가 있었지……」
			CASE 1
				PRINTFORML
				PRINTFORML 「조금 시큰하네」
				PRINTFORMW 그렇게 말하면서 겐게츠는 전부 마셔주었다.
			CASE 0
				IF TALENT:恋慕
					PRINTFORML
					PRINTFORML 「무게츠와도 승부네」
					PRINTFORMW 흘리듯 겐게츠는 그런 감상을 내뱉었다.
				ELSEIF TALENT:思慕
					PRINTFORML
					PRINTFORML 「차 내려준 거야? 고마워.」
					PRINTFORML (무게츠보다...... 아니......)
					PRINTFORMW 겐게츠는 어려운 표정을 짓고 있다.
				ELSE
					PRINTFORML
					PRINTFORMW 「차? 마시겠어요」
					PRINTFORML 무게츠가 우려준 게 맛있겠네…….
					PRINTFORMW 그런 중얼거림이 %조사처리(CALLNAME:MASTER,"의")% 귀에 닿았다.
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K117_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K117_302
CALL M_KOJO_MESSAGE_COM_K117_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;結構やる印象あるから増やしたい
	;怒り
	IF CFLAG:318
		PRINTFORML
		PRINTFORML 「칫」
		PRINTFORMW 겐게츠는 노여운 듯하다.
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:6
			CASE 5
				PRINTFORML
				PRINTFORML 겐게츠의 손을 잡아보았다…….
				PRINTFORML 「어떻게 된 거야, 갑자기?」
				PRINTFORMW 「……예쁜 손이라고? 후후, 고마워」
			CASE 4
				PRINTFORML
				PRINTFORML 겐게츠의 몸을 가볍게 찔러보았다.
				PRINTFORML 「후후, 간지러워」
				PRINTFORMW 보답으로 그녀도 %조사처리(CALLNAME:MASTER,"의")% 몸을 찔렀다…….
			CASE 3
				PRINTFORML
				PRINTFORML 겐게츠의 귀에 숨을 불어넣어 보았다.
				PRINTFORML 「큭!」
				PRINTFORMW 「정말이지... 깜짝 놀라잖니...」
			CASE 2
				PRINTFORML
				PRINTFORML 겐게츠의 머리를 쓰다듬어 보았다.
