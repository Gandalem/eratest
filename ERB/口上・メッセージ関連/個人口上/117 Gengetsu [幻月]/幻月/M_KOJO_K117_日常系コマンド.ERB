;==================================================
;413,料理
;TFLAG:194(100以上=禁断のメニュー 3=デザート 2=主食 1=軽食
;==================================================

@M_KOJO_MESSAGE_COM_K117_413
;TFLAG:194が100以上の場合のみ
CALL M_KOJO_MESSAGE_COM_K117_413_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	SELECTCASE TFLAG:194
		;禁断のメニュー
		CASE IS >= 100
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML
					PRINTFORMW 「요리...? 이걸로...?」
				CASE 0
					PRINTFORML
					PRINTFORMW 「정말로 먹을 수 있는 거야...?」
			ENDSELECT
			;デザート
		CASE 3
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML
					PRINTFORMW 「디저트는 중요하지」
				CASE 0
					PRINTFORML
					PRINTFORMW 「이게 완성되면, 무게츠도 불러서 차 마시자」	
			ENDSELECT
			;主食と軽食
			;ここだけ分岐は寂しいのでデザートも分岐させたい
		CASE 2
			IF TALENT:恋慕
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML
						PRINTFORML 「당신의 숨겨진 맛을 배우게 해줘」
					CASE 0
						IF ABL:117:料理技能 > 2
							PRINTFORML
							PRINTFORML 「후후, 저에게 맡기세요」
						ELSE
							PRINTFORML
							PRINTFORML 「나도 요리를 할 수 있게 되고 싶어」
						ENDIF
				ENDSELECT
				PRINTFORMW 겐게츠는 의욕이 넘친다.
			ELSEIF TALENT:思慕
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML
						PRINTFORMW 「오늘은 뭘 만들 거야?」
					CASE 0
						PRINTFORML
						PRINTFORMW 「도와줘도 될까?」
				ENDSELECT
			ELSE
				PRINTFORML
				PRINTFORMW 「도와주게 해줘」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
