			ENDIF
			;成功
		CASE 0
			IF TALENT:恋慕
				PRINTFORML
				PRINTFORML 「응. 맛있다」
				PRINTFORMW 「%CALLNAME:MASTER%고마워」
			ELSEIF TALENT:思慕
				PRINTFORML
				PRINTFORML 「맛있네」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 실력이 대단하네」 
			ELSE
				PRINTFORML
				PRINTFORML 「아, 맛있다」
				PRINTFORMW (조금 의외일지도)
			ENDIF
			;大成功
		CASE 1
			IF TALENT:恋慕
				PRINTFORML
				PRINTFORML 「! 맛있네, 이거」
				PRINTFORMW 「앞으로도 부탁할게」
			ELSEIF TALENT:思慕
				PRINTFORML
				PRINTFORML 「! 맛있다, 이거」
				PRINTFORMW 「가게라도 열어보면 %CALLNAME:MASTER%」
			ELSE
				PRINTFORML
				PRINTFORML 「! 맛있다, 이거」
				PRINTFORMW (꽤 의외네)
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
