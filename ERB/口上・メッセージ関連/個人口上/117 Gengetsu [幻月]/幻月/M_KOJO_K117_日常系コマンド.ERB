IF LOCAL
	;最凶最悪のボスだし、訓練相手としてはいいはず
	SELECTCASE TFLAG:194
		CASE 0,3
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML
					PRINTFORMW 「누군가 이기고 싶은 상대라도 있는 거야?」
				CASE 2
					PRINTFORML
					PRINTFORMW 「앞을 읽고 움직이는 거야」
				CASE 1
					PRINTFORML
					PRINTFORMW 「발광탄막? 죽겠네?」
				CASE 0
					PRINTFORML
					PRINTFORMW 「좋은 움직임이야」
			ENDSELECT
		CASE 1
			SELECTCASE RAND:3
				CASE 2
					PRINTFORML
					PRINTFORMW 「악천후에서의 탄막은 별로 해본 적이 없네요.」
				CASE 1
					PRINTFORML
					PRINTFORMW 「이런 날씨에도 하는구나. 열심인 건 좋다고 생각해.」
				CASE 0
					PRINTFORML
					PRINTFORMW 「탄막이 날아가 버리네...」
			ENDSELECT
		CASE 2
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML
					PRINTFORML 「뭐라도 무슨 일 있으면 책임져 줘!」
				CASE 0
					PRINTFORML
					PRINTFORMW 「뭔가 위험해 보이는데...? 막지 않을 거야?」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
