;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K117_100
CALL M_KOJO_MESSAGE_COM_K117_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「아하♪ 아파라♪」
			PRINTFORMW 「자, 더 때려줘. 엉덩이를 새빨갛게 만들고 싶어♪」
		ELSE
			PRINTFORMW 「흐윽! ……정말 아프네」
			PRINTFORMW 겐게츠는 불만스럽게 입술을 삐죽 내밀었다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:マゾっ気 >= 5 && RAND:2
			PRINTFORMW 「응, 괜찮아♪ 더 때려줘♪ 아프게 해줘♪」
			PRINTFORMW 「히야!? 굉장해!」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 손이 그 하얀 엉덩이에 자국을 남길 때마다, 겐게츠는 침을 흘리며 환희의 목소리를 질렀다.
		ELSE
			PRINTFORMW 「아하♪ 벌이잖아요」
			PRINTFORMW 「부끄러운 나를 가르치려면, 아직 고통이 부족한걸♪」
			PRINTFORMW 요염하게 미소 짓는 겐게츠는, 더한 손바닥을 원한다는 듯 엉덩이를 %CALLNAME:MASTER%에 내밀었다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF ABL:マゾっ気 >= 3
		PRINTFORMW 「……응, 더 세게 와도 좋아」
		PRINTFORMW 「당신의 손자국을 잔뜩 남겨줘」
		PRINTFORMW 엉덩이의 붉은 기가 늘어나는 것에 비례하여, 맞았을 때 겐게츠의 신음 소리도 커져갔다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「뭐라고 할까, 아니야」
		PRINTFORMW 「아픈 건 좋아하지만, 당신의 평타로는 욕정할 수 없어」
		PRINTFORMW 겐게츠는 시시하다는 듯 내뱉었다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;104,アイマスク
;==================================================

@M_KOJO_MESSAGE_COM_K117_104
CALL M_KOJO_MESSAGE_COM_K117_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「에? 혹시 보여지는 게 부끄럽다는 거야?」
		ELSE
			PRINTFORMW 「그건 자고 가라는 거야? ……뭐야……아니야」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF TALENT:恋慕
			PRINTFORMW 「뭐, 보이지 않아도 대충 알 수 있거든」
			PRINTFORMW 「왜냐면 당신의 패턴은 아주 잘 드러나는 거니까♪」
			RETURN 1
		ELSE
			PRINTFORMW 「음, 졸리다 이거」
			RETURN 1
		ENDIF
		;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「역시 보이는 쪽이 좋네♪」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「음. 눈부시다」
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;105,縄
;==================================================

@M_KOJO_MESSAGE_COM_K117_105
CALL M_KOJO_MESSAGE_COM_K117_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「그럼, 실력을 한번拝見(하이켄) 해볼까나」
		ELSE
			PRINTFORMW 「묶는 법 알아? 초보라면 하지 않는 게 좋을 거야.」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 5 && !RAND:3
			PRINTFORMW 「있잖아, 예를 들어 내가 사지가 괴사할 정도로 속박해 달라고 말하면 당신은 응해 줄 거야」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 고개를 가로저으며, 일단 상품이니까 손상시키지는 못한다고 대답했다.
			PRINTFORMW 「그렇겠지, 아쉽네. 이런 때는 원래 몸이 편리한데. 망가져도 금방 돌아오니까」
		ELSEIF ABL:マゾっ気 >= 3 && !RAND:3
			PRINTFORMW 「오늘은 아프고 괴로운 느낌으로 묶어보자♪」
			PRINTFORMW 「당신이라면 안심하고 긴 결박을 맡길 수 있어♪」
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「응. 정책이 느껴지는 좋은 속박이네」
			PRINTFORMW 「너, 좋은 밧줄 장인이 될 수 있어」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「당신이 상상했던 그대로 구속되고 있어?」
			PRINTFORMW 「그리고 그건 이미지대로의 효과를 가져왔어?」
			PRINTFORMW 「아마 다를 거라고 생각해. 연구해 봐. 밧줄이라는 건 아주 깊은 게 있거든」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「……묶을 거면 좀 더 능숙하게 묶으렴」
			PRINTFORMW 「짜증 나네」
			RETURN 1
		ENDIF
		;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「응, 맞아. 밧줄은 풀기 전까지가 작품이야」
			PRINTFORMW 「그렇게까지 생각한 긴박을 할 수 있게 된 너는 대단해♪」
			PRINTFORMW 밧줄의 흔적을 손끝으로 더듬으며, 겐게츠는 만족스럽게 그렇게 말했다.
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「아직 멀었네.」
			PRINTFORMW 「밧줄은 SM의 꽃이니까, 더 잘 묶을 수 있도록 되지 않으면」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
