;加虐系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;100,スパンキング
;==================================================
@M_KOJO_MESSAGE_COM_K117_100
CALL M_KOJO_MESSAGE_COM_K117_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「あは♪　いったーい♪」
			PRINTFORMW 「ほら、もっと叩いてよ。お尻を真っ赤にして欲しいの♪」
		ELSE
			PRINTFORMW 「あぅ！　……もー痛いなあ」
			PRINTFORMW 幻月は不平そうに唇を尖らせた。
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:マゾっ気 >= 5 && RAND:2
			PRINTFORMW 「あん、いいよぅ♪　もっとぶって♪　痛くさせて♪」
			PRINTFORMW 「ひゃう！？　凄いぃ！」
			PRINTFORMW %CALLNAME:MASTER%の手がその白いお尻に痕を残すたび、幻月は涎を垂らして歓喜の声を上げた。
		ELSE
			PRINTFORMW 「あは♪　お仕置なんでしょ」
			PRINTFORMW 「浅ましい私を躾けるには、まだまだ痛みが足りないなぁ♪」
			PRINTFORMW 妖艶に微笑む幻月は、さらなる平手を求めるようにお尻を%CALLNAME:MASTER%に突き出した。
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF ABL:マゾっ気 >= 3
		PRINTFORMW 「……うん、もっと強くてもいいよ」
		PRINTFORMW 「貴方の手形をいっぱい付けて」
		PRINTFORMW お尻の赤みが増すのに比例するように、叩かれたときの幻月の嬌声も大きくなっていった。
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「なんて言うかねぇ、違うのよ」
		PRINTFORMW 「痛いのは好きだけど、貴方の平手じゃ欲情できないわ」
		PRINTFORMW つまらなそうに幻月は吐き捨てた。
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;104,アイマスク
;==================================================
@M_KOJO_MESSAGE_COM_K117_104
CALL M_KOJO_MESSAGE_COM_K117_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「あれ？　もしかして見られるのが恥ずかしいとか？」
		ELSE
			PRINTFORMW 「それは寝てていって事？　……何だ……違うんだ」
		ENDIF		
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF TALENT:恋慕
			PRINTFORMW 「まあ、見えなくても大体分かるんだけどね」
			PRINTFORMW 「だって、貴方のパターンはとっても分かりやすいもの♪」
			RETURN 1
		ELSE
			PRINTFORMW 「んー、眠くなるなぁこれ」
			RETURN 1
		ENDIF
	;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「やっぱり見えてるほうがいいね♪」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「うーん。眩しい」
			RETURN 1
		ENDIF 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;105,縄
;==================================================
@M_KOJO_MESSAGE_COM_K117_105
CALL M_KOJO_MESSAGE_COM_K117_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「じゃあ、お手並み拝見させていただこうかしら」
		ELSE
			PRINTFORMW 「縛り方分かる？　素人なら止しといた方がいいわよ」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 5 && !RAND:3
			PRINTFORMW 「ねぇ、例えば私が四肢が壊死しちゃうように緊縛してって言ったら貴方は応えてくれる」
			PRINTFORMW %CALLNAME:MASTER%は首を横に振って、一応商品だから傷物には出来ないと答えた。
			PRINTFORMW 「そうだよね、残念。こういう時、元の身体が便利なんだけどね。壊れてもすぐ戻るし」
		ELSEIF ABL:マゾっ気 >= 3 && !RAND:3
			PRINTFORMW 「今日は痛くて苦しい感じに縛りましょ♪」
			PRINTFORMW 「貴方なら安心して緊縛を任せられるわ♪」
		;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「うん。ポリシーを感じるいい緊縛だね」
			PRINTFORMW 「貴方、いい縄師になれるよ」
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「貴方のイメージした通りの緊縛になってる？」
			PRINTFORMW 「そしてそれはイメージ通りの効果をもたらした？」
			PRINTFORMW 「多分違うと思う。研究してね。縄って凄く奥が深いの」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「……縛るならもっと手際よく縛りなさいよ」
			PRINTFORMW 「苛々するなぁ」
			RETURN 1
		ENDIF
	;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「うん、そうそう。縄はほどいた後までが作品よ」
			PRINTFORMW 「そこまで考えた緊縛をできるようになった貴方は偉い♪」
			PRINTFORMW 縄の痕を指先でなぞりつつ、幻月は満足げにそう言った。
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「まだまだねぇ」
			PRINTFORMW 「縄はＳＭの花形なんだから、もっと上手に縛れるようにならないと」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※
;ハードな調教コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;140,イラマチオ
;==================================================
@M_KOJO_MESSAGE_COM_K117_140
CALL M_KOJO_MESSAGE_COM_K117_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「はいどうぞ。一番奥まで突っ込んでも大丈夫だよ♪」
			PRINTFORMW そう言って口を開けた幻月の喉は、もの欲しそうにひくひくしている。
		ELSE
			PRINTFORMW 「けほっ！　……いきなり突っ込まないでほしいなぁ」
			PRINTFORMW 「心の準備とかあるんだから」
			PRINTFORMW 幻月は不機嫌そうな顔つきだが、一呼吸置くと自分からペニスを喉の奥まで咥え込み、
			PRINTFORMW 動けと、そう目で伝えてきた。
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF FLAG:70
	ELSEIF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORMW 「ん……むぐ……ん……ぷはっ！」
			PRINTFORMW 「あはは、喉の奥がいい感じ♪　もっと犯してよ♪」
			PRINTFORMW 自ら再び一物を喉に突き入れた幻月は、
			PRINTFORMW %CALLNAME:MASTER%の尻を抱きかかえ、より深くの挿入を促している。
		ELSE
			PRINTFORMW 「んぐ……んん……ぷはっ♪」
			PRINTFORMW 「ディープスロートは得意なの。ちょっと自慢だったり」
			PRINTFORMW 「これできる女の子はあんまりいないよ♪」
			PRINTFORMW 幻月は再び根元まで咥え込んだ一物を、
			PRINTFORMW %CALLNAME:MASTER%の腰の動きに合わせるように喉の奥で扱き上げている。
			PRINTFORMW 苦しさを伴うプレイのはずだが、その表情は心地よさそうだ。
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「むぐ……ん……ぷはぁ♪」
		PRINTFORMW 「……喉の奥で咥えるにはちょっとコツがあるんだよね」
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「んぐ……ぷはっ……」
		PRINTFORMW 「……そんな間抜けな事はしないけど、もし喉に傷とか付いたら嫌だなぁ」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

