;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K117_140
CALL M_KOJO_MESSAGE_COM_K117_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「자, 여기요. 가장 안쪽까지 파고들어도 괜찮아요♪」
			PRINTFORMW 그렇게 말하며 입을 연 겐게츠의 목은 무언가를 원하는 듯 떨리고 있었다.
		ELSE
			PRINTFORMW 「콜록! ……갑자기 몰아붙이지 말아줬으면 좋겠어」
			PRINTFORMW 「마음의 준비 같은 것도 하는 거라고」
			PRINTFORMW 겐게츠는 불쾌한 표정이었지만, 잠시 숨을 고르더니 스스로 페니스를 목구멍 깊숙이 물고,
			PRINTFORMW 움직이라고, 그렇게 눈빛으로 전해왔다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF FLAG:70
	ELSEIF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORMW 「음……응……응……푸하핫!」
			PRINTFORMW 「아하하, 목구멍 깊은 곳이 기분 좋아♪ 더 범해줘♪」
			PRINTFORMW 스스로 다시 한 개를 목구멍에 밀어 넣은 겐게츠는,
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 엉덩이를 안고, 더욱 깊은 삽입을 재촉하고 있다.
		ELSE
			PRINTFORMW 「응구... 음음... 푸핫♪」
			PRINTFORMW 「딥 스로트는 잘하는 편이야. 좀 자랑하고 싶기도 하고」
			PRINTFORMW 「이거 할 수 있는 여자 별로 없거든♪」
			PRINTFORMW 겐게츠는 다시 뿌리까지 물어버린 그것을,
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 허리 움직임에 맞추듯 목구멍 깊은 곳에서 삼키고 있다.
			PRINTFORMW 괴로움을 동반하는 플레이일 터인데, 그 표정은 기분 좋아 보인다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「음그... 으응... 푸하아♪」
		PRINTFORMW 「...목구멍 깊숙이 물려면 약간 요령이 필요하거든.」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「음그... 푸하핫...」
		PRINTFORMW 「...그런 바보 같은 일은 하지 않지만, 만약 목에 상처라도 생기면 싫으니까 말이야」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
