@M_KOJO_EVENT_K117_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「하아... 응, 아앗....... 에?」
				PRINTFORMW 예상치 못한 타이밍의 방문객에게 완전히 얼어버렸다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「잠, 저기, 뭐야 이 상황은!」
				PRINTFORMW 겐게츠의 탄막을 등에 느끼며 %조사처리(CALLNAME:MASTER,"는")% 방에서 나갔다……।
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「이대로 계속하라고...... 취향 너무 나쁘잖아......」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 부탁에 겐게츠는 노골적으로 싫은 표정을 지었다.
				PRINTFORMW 하지만 한숨을 내쉬더니 한번 은밀한 곳에서 뗀 손을 다시 움직이기 시작했다.
				PRINTFORML 「이런 건............ 정말 변태야......」
				PRINTFORMW 시선이 신경 쓰이는지 쾌락에 몰두하지 못하는 모습의 겐게츠를 지켜보았다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「――윽!」
				PRINTFORMW 겐게츠는 소리 없는 신음을 내며 %조사처리(CALLNAME:MASTER,"를")% 몰아냈다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「뭐, 뭐야......응!」
				PRINTFORMW 상황을 따라가지 못하는 모습의 겐게츠의 입술을 키스로 막았다.
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「음……레로」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 하려는 것을 눈치챘는지 겐게츠 쪽에서 혀를 얽어왔다.
					PRINTFORMW 잠시 후 입술을 떼자 %조사처리(CALLNAME:MASTER,"는")% 겐게츠의 녹아내린 눈동자로 응시한다.
					PRINTFORMW 「……나도……혼자서는 외로웠어……」
					PRINTFORML %조사처리(CALLNAME:MASTER,"를")% 유혹하듯, 겐게츠는 젖은 은밀한 곳을 보여주었다.
					PRINTFORMW 「이리 와, %CALLNAME:MASTER%」
				ELSE
					PRINTFORML 「음, 후……」
					PRINTFORMW 입안으로 들어오려는 혀를 거부하듯 순간적으로 입이 다물어지지만, 이윽고 포기한 듯 틈이 생긴다.
					PRINTFORMW 한참 후에 입술을 떼준다.
					PRINTFORML 「%CALLNAME:MASTER%……」
					PRINTFORMW 상기된 얼굴로 자신을 보는 겐게츠에게는 이미 저항할 의지가 없는 것처럼 보였다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 원하는 것은 기쁘지만……」
					PRINTFORMW 「그, 이번에는 조금 더 보통으로……」
				ELSE
					PRINTFORMW 「갑자기 들어와서... 이런 걸...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
	ENDSELECT
ENDIF
