			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「혼자서 느긋하게 자고 싶어」
			IF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「미안해, %CALLNAME:MASTER%」
			ELSE
				PRINTFORMW 「나가 줄 수 있을까?」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			;同棲中
			IF CFLAG:MASTER:初期位置 == CFLAG:117:初期位置
				PRINTFORMW 「저기...」
				PRINTFORMW 「그런 짓을 할 거라면 더 좋은 장소가 있을 거라고 생각해.」
