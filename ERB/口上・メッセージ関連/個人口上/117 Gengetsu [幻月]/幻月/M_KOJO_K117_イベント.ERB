	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW (아직 잊은 건 아니야)
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;added, events at the end of the day

@M_KOJO_CHECK_K117_DAYEVENT_COND(ARGS, ARG, ARG:1)
SELECTCASE ARG
	CASE DAYEVENT_GENERAL ;initial, if the function is allowed to run at all, -1 is disallowed, 1 is allowed
		SIF CFLAG:2 < 2000
			RETURN -1
		SIF MARK:反発刻印 || CFLAG:ブチギレ
			RETURN -1
		RETURN 1
		;per event
		;RETURN -1 - means disallowed, 0 - fall back to original condition, 1 - allowed
		; 	RETURN 0 ;og condition otherwise
	CASE DAYEVENT_COWGIRL, NIGHTEVENT_YOBAI
		SIF !HAS_PENIS(MASTER) ;penis only
			RETURN -1
		SIF !(ABL:欲望 >= 5)
			RETURN -1
		SIF !(!TALENT:処女 && !IS_DOUTEI(MASTER)) ;must be experienced
			RETURN -1
		SIF !(TALENT:恋慕 || TALENT:セフレ) ;require fall state
			RETURN -1
		RETURN 1
	CASE DAYEVENT_PAIZURI
		RETURN 0 ;normal condition
	CASEELSE
		RETURN -1
ENDSELECT
RETURN 0
