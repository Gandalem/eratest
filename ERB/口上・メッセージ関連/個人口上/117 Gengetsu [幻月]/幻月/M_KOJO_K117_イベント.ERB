		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 그렇게 말한다면……」
		PRINTFORMW 「아, 하지만 위험한 날은 안 돼」
		RETURN 1
	ENDIF
