; Modular ERB: 個人口上/117 Gengetsu [幻月]/幻月/M_KOJO_K117_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;
;幻月の特性
;	豪放磊落、残忍酷薄、狷介孤高
;

@M_KOJO_MESSAGE_COM_K117_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318
			PRINTFORMW 「내가 악마라는 걸 상기시켜 줄게.」
		ELSE
			PRINTFORML 「악마의 힘, 보여줄게」
			PRINTFORMW 겐게츠의 몸에서 헤아릴 수 없는 정도의 힘이 흘러나오는 것을 %조사처리(CALLNAME:MASTER,"는")% 느꼈다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;恋慕、愛欲でこんな奴呼ばわりはさすがにひどいかなーと
				IF CFLAG:318
					IF TALENT:恋慕 || TALENT:思慕
						PRINTFORML 「그냥 인간 주제에……」
					ELSE
						PRINTFORML 「젠장, 이런 놈에게……」
					ENDIF
				ELSE
					PRINTFORML 「단순한 인간치고는 대단하네.」
				ENDIF
			CASE 1
				IF CFLAG:318
					PRINTFORML 「크윽, 이대로는……」
				ELSE
					PRINTFORML 「이제 남은 게 없어...!」
				ENDIF
			CASE 0
				IF CFLAG:318
					PRINTFORML 「그런... 이런 녀석에게... 내가――」
				ELSE
					PRINTFORML 「에, 거짓말?!」
					PRINTFORML 우츠호를 달리는 겐게츠의 몸을 %조사처리(CALLNAME:MASTER,"의")% 탄막이 포착했다――――
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		SELECTCASE 相手残機
			CASE 3
				PRINTFORML 「어머, 이 정도밖에 안 돼?」
			CASE 2
				PRINTFORML 「아직이야!」
			CASE 1
				PRINTFORML 「아직 끝나지 않았어!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF CFLAG:318
			SELECTCASE 相手残機
				CASE 4
					PRINTFORML 
				CASE 1,2,3
					PRINTFORMW 「내 힘을 실감했니?」
				CASE 0
					PRINTFORML 「그런…… 제가……」
					PRINTFORMW 겐게츠는 믿을 수 없다는 듯 주저앉아 있다.
			ENDSELECT
		ELSE
			SELECTCASE 相手残機
				CASE 4
					PRINTFORML 
				CASE 3
					PRINTFORML 「이 정도로는 상대가 안 돼.」
					PRINTFORML 「다시 단련하고 오렴.」
				CASE 2
					PRINTFORML 「아직은, 그래도 근성만큼은 나쁘지 않았어.」
				CASE 1
					PRINTFORML 「후우, 간신히 이겼네」
					PRINTFORML 「꽤 하는구나, %CALLNAME:MASTER%」
				CASE 0
					PRINTFORML 「설마 내가 질 리가...」
					PRINTFORML 「%CALLNAME:MASTER%, 정말 인간이야?」
			ENDSELECT
			IF 相手残機 > 0
				PRINTFORMW 그렇게 말하면서 겐게츠는 쓰러지는%CALLNAME:MASTER%것을 도와주었다.
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
