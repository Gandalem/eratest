RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「クスクス♪　幻月お姉さんのデビルハンドは容赦ないよ」
			PRINTFORMW 「貴方はどれくらい耐えてくれるかしら？　楽しみ♪」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「すっごい勃起してるねぇ」
			PRINTFORMW 「クス♪　ちょっと触っただけで射精しないでよ？」
		ELSE
			PRINTFORMW 「はいはい、これで満足？」
			PRINTFORMW 余所見しながら、幻月はペニスを乱雑に擦りあげている。
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORMW 「あはは♪　簡単には射精させてあげないよ♪」
			PRINTFORMW 「イきたくてもイけない快楽地獄で悶えればいいわ」
			PRINTFORMW 幻月はもう少しで射精というタイミングを把握しているらしく、
			PRINTFORML 絶頂が間近になると手の動きを緩める。
			PRINTFORMW そして射精感が収まる頃合を見計らって、容赦ない肉棒虐めを再開するのだった。
		ELSE
			PRINTFORMW 「クスクス……可愛いね。先走りでドロドロ。ほらこっちも弄ってあげる」
			PRINTFORMW 幻月は絶妙の力加減でペニスを扱きつつ、余った左手で陰嚢を優しく揉んだ。
			PRINTFORMW 「出すときはイッちゃう！　って叫んでね♪」
			PRINTFORMW 「恥ずかしがっちゃダメだよ♪」
		ENDIF 
		RETURN 1
	;屈服3
	ELSEIF ABL:奉仕精神 >= 3
		PRINTFORMW 「裏筋、亀頭、尿道口と。……もっと激しいのが好み？」
		PRINTFORMW 幻月は淫靡な笑みを浮かべながら、ペニスを玩具のように弄り倒している。 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「だらしなくカウパーを漏らして……堪え性のないチンポだねぇ」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

