@M_KOJO_MESSAGE_COM_K117_80
CALL M_KOJO_MESSAGE_COM_K117_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「크크크♪ 겐게츠 언니의 데빌 핸드는 자비가 없어」
			PRINTFORMW 「당신은 얼마나 버텨줄 수 있을까? 기대돼♪」
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「엄청 발기했네~」
			PRINTFORMW 「크스♪ 조금 만졌다고 사정하지 마?」
		ELSE
			PRINTFORMW 「네, 네, 이걸로 만족해?」
			PRINTFORMW 이리저리 두리번거리면서, 겐게츠는 페니스를 아무렇게나 문지르고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORMW 「아하하♪ 쉽게 사정시켜 주지는 않을 거야♪」
			PRINTFORMW 「오고 싶어도 올 수 없는 쾌락 지옥에서 몸부림치면 돼」
			PRINTFORMW 겐게츠는 조금 있으면 사정할 타이밍을 파악하고 있는 듯했다.
			PRINTFORML 절정에 가까워지자 손의 움직임을 느슨하게 만들었다.
			PRINTFORMW 그리고 사정감이 가라앉을 시점을 노리고, 가차 없는 남성기 학대를 재개했다.
		ELSE
			PRINTFORMW 「크큭... 귀엽네. 성급하게 질척거리다니. 자, 이쪽도 만져줄게」
			PRINTFORMW 겐게츠는 절묘한 힘 조절로 페니스를 다루면서, 남은 왼손으로 음낭을 부드럽게 주물렀다.
			PRINTFORMW 「나 나올 때 '간다!'라고 외쳐줘♪」
			PRINTFORMW 「부끄러워하면 안 돼♪」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF ABL:奉仕精神 >= 3
		PRINTFORMW 「뒷부분, 귀두, 요도구와. ……더 격렬한 게 취향이야?」
		PRINTFORMW 겐게츠는 음란한 미소를 지으며 페니스를 장난감처럼 가지고 놀고 있다. 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「흐트러지게 커퍼를 흘리고 있네... 참을성이 없는 자지구나.」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
