;==================================================
;84,泡踊り
;==================================================
@M_KOJO_MESSAGE_COM_K117_84
CALL M_KOJO_MESSAGE_COM_K117_84_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_84_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「なるほどねぇ。そんなのやってみたいんだ」
			PRINTFORMW 「いいよ♪　私そういうの得意だから」
		ELSE
			PRINTFORMW 「……自分の体くらい自分で洗えばいいと思うよ」
			PRINTFORMW 幻月は石鹸の泡立てもそこそこに体を擦り付けている。
			PRINTFORMW 気持ちよくさせようという気はないらしく、その動きは単調で乱雑だった。
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF ABL:奉仕精神 >= 5 && RAND:3
			PRINTFORMW 「あはは♪　幻月お姉さんの取っておき味わってみる？」
			PRINTFORMW うつ伏せにさせた%CALLNAME:MASTER%の上に幻月は乗りかかった。
			PRINTFORMW ぬるりという石鹸の感触がする。
			PRINTFORMW 「このプレイは女の子がスポンジの代わりになるというのが本質じゃないの」
			PRINTFORMW 「つまり、貴方の体中に存在している性感帯を女の子がどれだけ発見してあげるかって事なのよ♪」
			PRINTFORMW 幻月は体を擦りつけながら、指と口で%CALLNAME:MASTER%の肉体を刺激し始めた。
			PRINTFORMW くすぐり、吸い付き、時に軽く歯を立て、容赦なく性感帯を開発していく。
			PRINTFORMW 体全部が性器にでもなったような快感に%CALLNAME:MASTER%は悶える他なかった。
		ELSE
			PRINTFORMW 「さぁ♪　寝転がってね♪」
			PRINTFORMW 幻月は石鹸をたっぷり泡立てると%CALLNAME:MASTER%に圧し掛かった。
			PRINTFORMW 「綺麗にしてあげる♪」
			PRINTFORMW そして、体全体で%CALLNAME:MASTER%を愛撫し始めた。
			PRINTFORMW 石鹸越しで肌と肌が刺激し合う感覚に%CALLNAME:MASTER%は快感で鳥肌が立つのが分かった。
		ENDIF
		RETURN 1
	;屈服3
	;ELSEIF MARK:不埒刻印 == 3
	;	PRINTFORMW 
	;	RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「これは慣れてない子には難しいだろうねぇ」
		PRINTFORMW 「気持ち良さを追求するなら、体をスポンジ代わりにするだけじゃ駄目なのよ」
		PRINTFORMW 「もっとも、貴方は女の子の体が当たるだけで満足なのかしらね」
		PRINTFORMW 幻月はこれで十分でしょとでも言うように、やや小振りな胸のふくらみを適当に擦り付けている。 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

