; Modular ERB: 個人口上/117 Gengetsu [幻月]/幻月/M_KOJO_K117_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K117
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
;added
IF TFLAG:22 == 1
	PRINTFORMW 「아하하♪ 너무 아파서 의식이 날 것 같아」 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 「아하하♪ 너무 아파서 의식이 날 것 같아」 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 「오랜만에 느끼는 아픔이야. 기쁘지 않아♪」 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「응... 기분, 좋다」
ELSEIF TFLAG:23 == 2
	PRINTFORML 「음, 크윽……」
	PRINTFORMW 「지금 건 좋았어……」
ELSEIF TFLAG:23 == 3
	PRINTFORML 「응, 아, 갈 것…갈 거야아아!」
	PRINTFORMW 「하아, 하아… 굉장했어, 와…」
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 「음... 아무것도 아니야」
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「아, %CALLNAME:MASTER%, 더......」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 「앙, %CALLNAME:MASTER%, 더, 더 주세요!」	
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「%CALLNAME:MASTER%……아, 아무것도 아니야」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「%CALLNAME:MASTER%목마르지 않아? 차라도 마실래?」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「%CALLNAME:MASTER%、なにか私にできることある？」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	IF TALENT:恋慕 ;added
		PRINTFORMW 　
		PRINTFORMW 「음, 복잡한 감정이야」
		PRINTFORMW 「……하지만 당신 속을 보고 싶다는 건 분명 본심이네」
	ELSE
		PRINTFORMW 「흥분하지 마」
	ENDIF
ELSEIF TFLAG:21 == 2
	PRINTFORML 「ﾁｯ」
	PRINTFORMW 겐게츠의 혀 차는 숨길 수 없는 분노가 번지고 있었다. 
ELSEIF TFLAG:21 == 3
	IF TALENT:恋慕 ;added
		PRINTFORMW 「당신에게는 여러 가지 부족한 것이 있는 것 같아. 사려 깊음 같은 거 말이야.」
		PRINTFORMW 「……아, 아쉽네. 유감이다.」
		PRINTFORMW 「오랜만에 살의 같은 달콤한 감정이 피어났는데, 그걸 실행할 팔 힘이 없다니 말이야.」
	ELSE
		PRINTFORML 「과연, 즉 %조사처리(CALLNAME:MASTER,"는")% 자살 희망자구나」
		PRINTFORMW 겐게츠는 살기를 숨기려 하지 않았다.
	ENDIF
ENDIF
