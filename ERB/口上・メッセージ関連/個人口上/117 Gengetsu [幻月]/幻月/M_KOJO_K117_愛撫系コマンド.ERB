;9,自慰 added
;==================================================
@M_KOJO_MESSAGE_COM_K117_9
CALL M_KOJO_MESSAGE_COM_K117_9_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「オナニーするの？　いいけど、見てるだけで満足できる？」
			PRINTFORMW 「折角だし入れちゃえばいいと思うんだけどなあ」
			PRINTFORMW 幻月はちょっぴり不満らしいが、秘裂を弄る指先の動きは激しい。
		ELSE
			PRINTFORMW 「ふーん。見たいんだ……変態さんの相手は疲れるねぇ」
			PRINTFORMW  ゆったりとした手つきで幻月は自らの秘裂を弄り始めた。
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:2
			PRINTFORMW 「あは！　もうおまんこぐちょぐちょだね♪」
			PRINTFORMW 「ほら、指を動かすと愛液で音が鳴るんだよ。……ふあぁ……あん！」
			PRINTFORMW 幻月は慣れた手つきで自らの秘裂を激しくまさぐっている。
			PRINTFORMW じゅぷじゅぷという淫靡な水音が響いていた。
		ELSE
			PRINTFORMW 「んん……ふぁん！　……いいよぅ！」
			PRINTFORMW 「……どうかな？　興奮してくれてる？ 私のあそこが掻き回されるのを見て」
			PRINTFORMW %CALLNAME:MASTER%の股間を覗き込み、その状態に満足したらしい幻月は妖艶に微笑むと、
			PRINTFORMW べっとり愛液の付着した自分の指をぺろりと舐め上げた。
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「んぁ……あん……」
		PRINTFORMW 「……ほら見て、糸引いてるよ」
		PRINTFORMW 割れ目と幻月の指の間には愛液の橋が架かっていて、
		PRINTFORMW ヌラヌラと怪しげな輝きを放っていた。 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「……まあ、いいけど」
		PRINTFORMW 「貴方に触られるよりは、自分の指の方がずっと気持ちいいし」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
