@M_KOJO_MESSAGE_COM_K117_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF CFLAG:2 >= 3000 ;added
			PRINTFORMW 「うん、好きなように触って」
			PRINTFORMW 「信頼してるから……気持ちよくさせてね」
			PRINTFORMW 幻月は満面の笑顔で%CALLNAME:MASTER%に身を委ねた。
		ELSE
			PRINTFORMW 「初めてじゃないだろうし、クリトリスの位置くらい分かるよね？」
			PRINTFORMW 「うん……そうそう」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:6
			CASE 5 ;added
				PRINTFORMW 「ふわぁ……あん！……。うわぁ♪　おまんこ、びちゃびちゃ♪」
				PRINTFORMW 「うふふ……上手になったね。褒めてあげる」
				PRINTFORMW 満足そうな幻月は%CALLNAME:MASTER%の唇に軽くキスした。
			CASE 4 ;added
				PRINTFORMW 「あ……ふぁん……いいよ。その感じで気持ちよくして」
				PRINTFORMW 幻月はほんのり頬を赤く染め微笑んだ。
			CASE 3
				PRINTFORMW 「ん、あっ……もっと」
			CASE 2
				PRINTFORMW 「んっ、%CALLNAME:MASTER%の手、気持ちいい……」
			CASE 1
				PRINTFORMW 「これだけで終わり、じゃないわよね？」
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%の手、優しいわね……」
		ENDSELECT
		RETURN 1
	;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 3 ;added
				PRINTFORMW 「うーん。……まあ最初よりは上手になったかな」
				PRINTFORMW 「でも満足しちゃだめよ。演技で無い喘ぎ声を聞きたいならね」
			CASE 2
				PRINTFORMW 「別に抵抗はしないから、さっさと弄れば？」
				PRINTFORMW 幻月はやる気の伺えない顔つきのまま、ごろんとベッドに横たわった。
			CASE 1
				PRINTFORMW 「んっ、いやらしい動き、ね」
			CASE 0
				PRINTFORMW 「ん、あっ……もっと」
		ENDSELECT 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
