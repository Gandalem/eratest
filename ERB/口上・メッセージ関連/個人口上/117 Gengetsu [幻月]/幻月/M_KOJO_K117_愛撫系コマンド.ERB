@M_KOJO_MESSAGE_COM_K117_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;added
		IF TALENT:恋慕
			PRINTFORMW 「うん、私もずっと貴方に舐めて欲しいと思ってた」
			PRINTFORMW 幻月はいきなり%CALLNAME:MASTER%の頭を掴むと、
			PRINTFORMW 自らの秘所を%CALLNAME:MASTER%の口元へ強引に押し当てた。
			PRINTFORMW 「いっぱい気持ちよくしてね♪」
			PRINTFORMW そして八重歯を覗かせ、悪戯っ子のような笑みを浮かべたのだった。
		ELSEIF CFLAG:2 >= 1500
			PRINTFORMW 「舐めたいの？　仕方ないなあ。優しくね」
			PRINTFORMW そう言って幻月は自らの秘裂を突き出した。
		ELSE
			PRINTFORMW 「舐め方分かる？　ただ舌を動かせばいいってものじゃないのよ」
		ENDIF		
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102 ;added
			PRINTFORMW 「どう？　おまんこ美味しい？」
			PRINTFORMW 幻月は自らの秘所に%CALLNAME:MASTER%の頭を押し付けるようにしている。
			PRINTFORMW その割れ目からは愛液が止め処なく溢れ出ていた。
			PRINTFORMW 「もっと奥まで舌を差し込んで、私の味を覚えて♪」
			PRINTFORMW 「……ふぁ！……いいよぉ……その調子♪」 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:4
			CASE 3 ;added
				PRINTFORMW 「折角だから気合入れて舐めてね」
				PRINTFORMW そう言って幻月は自らの秘裂を指で開いて見せた。
			CASE 2
				PRINTFORMW 「んっ、そこっ、いいわ」
			CASE 1
				PRINTFORMW 「あっ、もっと、舐めて」
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%が舐めてるのを見てると、私も興奮してくるわ……」
		ENDSELECT
		RETURN 1
	;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 2 ;added
				PRINTFORMW 「ぺろぺろされるのは好きだけど、相手が貴方だとねえ……」
				PRINTFORMW 幻月は気乗りしないような表情を浮かべている。
			CASE 1
				PRINTFORMW 「なかなか、nnっ、上手い、じゃない」
			CASE 0
				PRINTFORMW （舐めてる%CALLNAME:MASTER%を見てると……興奮してくるわね……）
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
