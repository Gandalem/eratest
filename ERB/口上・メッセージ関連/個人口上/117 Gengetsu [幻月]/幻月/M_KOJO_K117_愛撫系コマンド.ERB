@M_KOJO_MESSAGE_COM_K117_0
CALL M_KOJO_MESSAGE_COM_K117_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF CFLAG:2 >= 3000 ;added
			PRINTFORMW 「응, 하고 싶은 대로 만져줘」
			PRINTFORMW 「믿고 있으니까…… 기분 좋게 해줘」
			PRINTFORMW 겐게츠는 환한 미소로 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡겼다.
		ELSE
			PRINTFORMW 「처음이 아니잖아, 클리토리스 위치 정도는 알겠지?」
			PRINTFORMW 「응... 응응」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:6
			CASE 5 ;added
				PRINTFORMW 「후와아……안!……. 우와♪ 보지, 축축해♪」
				PRINTFORMW 「우후후…… 잘하게 됐네. 칭찬해 줄게」
				PRINTFORMW 만족스러운 겐게츠는 %조사처리(CALLNAME:MASTER,"의")% 입술에 가볍게 키스했다.
			CASE 4 ;added
				PRINTFORMW 「아......팬......괜찮아. 그 느낌으로 기분 좋게 해줘」
				PRINTFORMW 겐게츠는 살짝 볼을 붉히며 미소 지었다.
			CASE 3
				PRINTFORMW 「응, 아…… 더」
			CASE 2
				PRINTFORMW 「응, %조사처리(CALLNAME:MASTER,"의")% 손이 기분 좋아......」
			CASE 1
				PRINTFORMW 「이것으로 끝나는 건 아니잖아?」
			CASE 0
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 손, 다정하네……」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 3 ;added
				PRINTFORMW 「음. ……뭐 처음보다는 나아졌을까」
				PRINTFORMW 「하지만 만족하면 안 돼. 연기가 아닌 신음소리를 듣고 싶다면 말이야.」
			CASE 2
				PRINTFORMW 「딱히 저항하지 않을 테니, 어서 가지고 놀아봐?」
				PRINTFORMW 겐게츠는 의욕 없어 보이는 얼굴 그대로 침대에 데구르르 누웠다.
			CASE 1
				PRINTFORMW 「응, 야릇한 움직임이네.」
			CASE 0
				PRINTFORMW 「응, 아…… 더」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
