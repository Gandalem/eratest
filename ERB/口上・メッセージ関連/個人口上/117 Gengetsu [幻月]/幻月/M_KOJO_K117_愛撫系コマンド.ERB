@M_KOJO_MESSAGE_COM_K117_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;added
		IF TALENT:恋慕
			PRINTFORMW 「응, 나도 계속 당신에게 빨리고 싶다고 생각하고 있었어」
			PRINTFORMW 겐게츠는 갑자기 %조사처리(CALLNAME:MASTER,"의")% 머리를 잡고,
			PRINTFORMW 자신의 은밀한 곳을 %조사처리(CALLNAME:MASTER,"의")% 입가에 강제로 밀어붙였다.
			PRINTFORMW 「잔뜩 기분 좋게 해줘♪」
			PRINTFORMW 그리고 송곳니를 드러내며 장난꾸러기 같은 미소를 지었다.
		ELSEIF CFLAG:2 >= 1500
			PRINTFORMW 「핥고 싶어? 어쩔 수 없네. 부드럽게 해줘」
			PRINTFORMW 그렇게 말하며 겐게츠는 자신의 비열을 내밀었다.
		ELSE
			PRINTFORMW 「어떻게 핥아야 하는지 알아? 그냥 혀를 움직이면 되는 게 아니야」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102 ;added
			PRINTFORMW 「어때? 보지 맛있어?」
			PRINTFORMW 겐게츠는 자신의 은밀한 곳에 %조사처리(CALLNAME:MASTER,"의")% 머리를 밀착시키고 있다.
			PRINTFORMW 그 갈라진 틈에서는 애액이 멈추지 않고 흘러나오고 있었다.
			PRINTFORMW 「더 깊숙이 혀를 넣어, 나의 맛을 기억해♪」
			PRINTFORMW 「……후아! ……좋아……그대로 해♪」 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:4
			CASE 3 ;added
				PRINTFORMW 「모처럼이니까 힘내서 빨아줘」
				PRINTFORMW 그렇게 말하며 겐게츠는 자신의 비리를 손가락으로 벌려 보였다.
			CASE 2
				PRINTFORMW 「응, 거기... 좋아.」
			CASE 1
				PRINTFORMW 「아, 더, 핥아줘」
			CASE 0
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 핥고 있는 걸 보고 있으니, 나도 흥분해 온다……」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 2 ;added
				PRINTFORMW 「핥아지는 건 좋아하지만, 상대가 당신이라는 점은 말이야...」
				PRINTFORMW 겐게츠는 별로 기분이 아닌 듯한 표정을 짓고 있다.
			CASE 1
				PRINTFORMW 「꽤, 음, 잘하는걸.」
			CASE 0
				PRINTFORMW (핥고 있는 %조사처리(CALLNAME:MASTER,"를")% 보고 있으면...... 흥분해 온다네......)
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
