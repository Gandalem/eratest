;45,アナルバイブ
;==================================================

@M_KOJO_MESSAGE_COM_K117_45
CALL M_KOJO_MESSAGE_COM_K117_45_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「후후, 음탕한 모양이네. 벌써 시험해 보자.」
			PRINTFORMW 「나는 그것이 엉덩이를 괴롭히는 감각에 흥미진진하거든.」
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「엉덩이용? 재미있는 도구네」
			PRINTFORMW 「음... 이걸로 넣기 쉬울까?」
			PRINTFORMW 바이브에 흥미진진한 겐게츠는, 부드럽게 삽입할 수 있도록 자신의 손가락으로 항문을 벌려 보였다.
		ELSE
			PRINTFORMW 「그게 엉덩이에 들어가는 거야」
			PRINTFORMW 「......별로 내키지 않네.」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アナルバイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			IF ABL:Ａ感覚 >= 3
				PRINTFORMW 「캬하하♪ 기분 너무 좋아서 엉덩이가 부서질 것 같아♪」
				PRINTFORMW 「완전히 중독됐네. 아니, 하루 종일 넣어도 괜찮아」
			ELSE
				PRINTFORMW 「우후후……자, 나의 음란한 항문에 막아줘 ♪」
				PRINTFORMW 「……앙! 들어와 ♪」
			ENDIF
			RETURN 1
			;屈服3
			;ELSEIF MARK:不埒刻印 == 3
			;	PRINTFORMW
			;	RETURN 1
			;それ以外
		ELSE
			IF ABL:Ａ感覚 >= 3
				PRINTFORMW 「아하하♪ 직장이 부르르 떨리는 거야♪」
				PRINTFORMW 겐게츠는 애널바이브의 진동을 즐기고 있는 것 같다.
			ELSE
				PRINTFORMW 「뭐, 싫어하는 느낌은 아닌데」
				PRINTFORMW 「……뭔가 다르네」
			ENDIF
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF TALENT:恋慕
			PRINTFORMW 「아아……후앙! 까하♪ 마치 실수로 대변을 본 듯한 느낌이야」
			PRINTFORMW 겐게츠는 뽑힌 애널바이브를 집어 입가로 가져간 뒤, 질척하게 핥았다.
			PRINTFORMW 「우후후……내 안은 이런 맛이 나는구나」
		ELSEIF ABL:Ａ感覚 >= 3
			PRINTFORMW 「앙♪ ……이제 빼버릴 거야」
			PRINTFORMW 겐게츠는 뽑힌 애널바이브를 아쉬운 듯 바라보고 있었다.
		ELSE
			PRINTFORMW 「만족했니?」
			PRINTFORMW 겐게츠는 차가운 눈으로 %조사처리(CALLNAME:MASTER,"를")% 흘겨보았다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
