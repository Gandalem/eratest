RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「面白い物を持ってるねぇ」
			PRINTFORMW 「早速使ってみましょ。ね？」
			PRINTFORMW 幻月は股を開き、ローターが押し当てられるのを待っている。
		ELSE
			PRINTFORMW 「なるほどねぇ……ちょっと興味があるかも」
			PRINTFORMW 幻月はローターに好奇の視線を向けている 
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「まあ、気持ちいいことは気持ちいいんだけど」
		PRINTFORMW 「ちょっとこれだけじゃ満足できないかなって」
		PRINTFORMW そう言った幻月の視線は%CALLNAME:MASTER%の股間に注がれている。 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「あはは♪　クリトリスがピリピリするね」 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「技術が足りないのを道具で何とかしようとするのは正解だと思うわ」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

