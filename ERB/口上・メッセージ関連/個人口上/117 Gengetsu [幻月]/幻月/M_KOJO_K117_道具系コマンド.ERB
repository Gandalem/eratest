;==================================================
;44,バイブ
;==================================================
@M_KOJO_MESSAGE_COM_K117_44
CALL M_KOJO_MESSAGE_COM_K117_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				PRINTFORMW 「わざわざ戻しておいて、それはないわよ」
				PRINTFORMW 「あーあ、おちんちんで破ってほしかったなー」
				PRINTFORMW 幻月は不満気に唇を尖らせている。
			ELSE
				PRINTFORMW 「結局何がしたかったのかな？」
				PRINTFORMW バイブを伝う血を見て、幻月は呆れたようにそう呟いた。
			ENDIF 
			RETURN 1
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「へー。貴方のより大きいんじゃない？」
				PRINTFORMW 幻月は面白そうにバイブを握ると、自らの手で秘裂に挿入した。
				PRINTFORMW 「ふーん、まずまずってところかしら♪」
			ELSE
				PRINTFORMW 「あれ？　もしかして自分のおちんちんに自信がないのかしら？」
				PRINTFORMW 幻月は貶すような表情で%CALLNAME:MASTER%を見ている。
			ENDIF 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW 
			RETURN 1
		;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「これも好きだけど……どうせなら貴方のを食べたいなぁ」
			PRINTFORMW 幻月は自分でバイブを抜き差ししながら、%CALLNAME:MASTER%を誘うように尻を突き出した。
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「あはは♪　一気に突っ込んじゃって。…………ふぁん！」
			PRINTFORMW 勢い良く奥まで挿入されたバイブに、幻月は体を仰け反らせて声を上げた。
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「あー、なんか鬱陶しいなぁ」
			PRINTFORMW 幻月は股間で震えるバイブの感覚に文句を並べている。
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF TALENT:恋慕
			IF HAS_PENIS(MASTER)
				PRINTFORMW 「あぁん♪」
				PRINTFORMW バイブを引き抜くと、幻月は甘く嬌声を上げた。
				PRINTFORMW 「あはは♪　今度は別のが欲しいな」
				PRINTFORMW 目をトロンとさせた幻月の視線は勃起した%CALLNAME:MASTER%の一物に注がれている。
			ELSE
				PRINTFORMW 「あん♪　抜けちゃった」
				PRINTFORMW 床に落ちたバイブを拾い上げた幻月は、何故か熱っぽい瞳で%CALLNAME:MASTER%の股間を見た。
				PRINTFORMW 「貴方に突っ込んでみたいなぁ。今なら私の愛液でびっちょりだからスムーズに入ると思うよ」
			ENDIF
			RETURN 1
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「あれ？　抜いちゃうの？」
			PRINTFORMW 「気持ちよかったんだけどなぁ」
			RETURN 1
		ELSE
			PRINTFORMW 「うん、抜いたほうがいい。安眠の邪魔だもん」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

;==================================================
;45,アナルバイブ
;==================================================
@M_KOJO_MESSAGE_COM_K117_45
CALL M_KOJO_MESSAGE_COM_K117_45_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「うふふ、いやらしい形だねぇ。早速試してみましょ」
			PRINTFORMW 「私はそれがお尻を虐める感覚に興味津々なのよ」
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「お尻用？ 面白い道具だねぇ」
			PRINTFORMW 「よっと……これで入れやすいかな？」
			PRINTFORMW バイブに興味津々な幻月は、スムーズに挿入できるよう、自らの指で肛門を開いてみせた。
		ELSE
			PRINTFORMW 「それがお尻に入るんだ」
			PRINTFORMW 「……あんまり気が進まないなぁ」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アナルバイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW 
			RETURN 1
		;恋慕
		ELSEIF TALENT:恋慕
			IF ABL:Ａ感覚 >= 3
				PRINTFORMW 「キャハハ♪　気持ちよすぎてお尻が壊れちゃいそう♪」
				PRINTFORMW 「すっかり病み付きだわ。何なら一日中入れててもいいよ」
			ELSE
				PRINTFORMW 「うふふ……ほら、私のいやらしい尻穴に栓しちゃって♪」
				PRINTFORMW 「……あん！　入ってくる♪」
			ENDIF
			RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW 
		;	RETURN 1
		;それ以外
		ELSE
			IF ABL:Ａ感覚 >= 3
				PRINTFORMW 「あはは♪　直腸がぷるぷるしてるの♪」
				PRINTFORMW 幻月はアナルバイブの振動を面白がっているようだ。
			ELSE
				PRINTFORMW 「まあ、嫌いな感覚じゃないんだけど」
				PRINTFORMW 「……何か違うなぁ」
			ENDIF 
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF TALENT:恋慕
			PRINTFORMW 「あぁ……ふぁあん！　キャハ♪　まるでおもらししちゃった感覚」
			PRINTFORMW 幻月は引き抜かれたアナルバイブを拾い上げると、口元へ近づけ、ねっとりと舐め上げた。
			PRINTFORMW 「うふふ……私の中ってこんな味がするんだ」
		ELSEIF ABL:Ａ感覚 >= 3
			PRINTFORMW 「あん♪　……もう抜いちゃうんだ」
			PRINTFORMW 幻月は引き抜かれたアナルバイブを、名残惜しそうに眺めている。
		ELSE
			PRINTFORMW 「満足かしら？」
			PRINTFORMW 幻月は冷めた目で%CALLNAME:MASTER%を一瞥した。
		ENDIF
	ENDIF
ENDIF
RETURN 1

