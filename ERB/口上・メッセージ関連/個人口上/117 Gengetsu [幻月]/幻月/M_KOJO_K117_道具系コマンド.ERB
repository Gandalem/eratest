;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K117_44
CALL M_KOJO_MESSAGE_COM_K117_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				PRINTFORMW 「굳이 돌아와 줬으니, 그런 건 안 돼.」
				PRINTFORMW 「아~ 남자한테 박히고 싶었는데 말이야~」
				PRINTFORMW 겐게츠는 불만스럽게 입술을 삐죽 내밀고 있다.
			ELSE
				PRINTFORMW 「결국 뭘 하고 싶었던 걸까?」
				PRINTFORMW 바이브를 통해 흐르는 피를 보고, 겐게츠는 어이없다는 듯 그렇게 중얼거렸다.
			ENDIF
			RETURN 1
		ELSE
			IF TALENT:恋慕
				PRINTFORMW 「헤에. 당신 것보다 크지 않아?」
				PRINTFORMW 겐게츠는 재미있다는 듯 바이브를 잡고, 자신의 손으로 은밀한 곳에 삽입했다.
				PRINTFORMW 「후우, 그럭저럭이려나♪」
			ELSE
				PRINTFORMW 「あれ？　もしかして自分のおちんちんに自信がないのかしら？」
				PRINTFORMW 겐게츠는 멸시하는 듯한 표정으로 %조사처리(CALLNAME:MASTER,"를")% 보고 있다.
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「이것도 좋지만……어차피 당신의 것을 먹고 싶네」
			PRINTFORMW 겐게츠는 스스로 바이브를 빼고 넣으면서, %조사처리(CALLNAME:MASTER,"를")% 유혹하듯 엉덩이를 내밀었다.
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「아하하♪ 한 번에 박아버리네. …………팬!」
			PRINTFORMW 기세 좋게 안쪽까지 삽입된 바이브에, 겐게츠는 몸을 뒤로 젖히며 소리를 질렀다.
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「아, 뭔가 귀찮네.」
			PRINTFORMW 겐게츠는 가랑이에서 떨리는 바이브의 감각에 불평을 늘어놓고 있다.
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF TALENT:恋慕
			IF HAS_PENIS(MASTER)
				PRINTFORMW 「아앙♪」
				PRINTFORMW 바이브를 빼자, 겐게츠는 달콤하게 신음했다.
				PRINTFORMW 「아하하♪ 이번에는 다른 게 갖고 싶네」
				PRINTFORMW 눈을 동그랗게 뜬 겐게츠의 시선은 발기한 %조사처리(CALLNAME:MASTER,"의")% 것에 향하고 있었다.
			ELSE
				PRINTFORMW 「앙♪ 빠져버렸네」
				PRINTFORMW 바닥에 떨어진 바이브를 주운 겐게츠는 어째선지 열기 어린 눈으로 %조사처리(CALLNAME:MASTER,"의")% 사타구니를 보았다.
				PRINTFORMW 「당신에게 돌진해 보고 싶어. 지금이라면 내 애액으로 흥건해서 부드럽게 들어갈 거라고 생각해」
			ENDIF
			RETURN 1
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「어라? 빼버리는 거야?」
			PRINTFORMW 「기분 좋았는데 말이야.」
			RETURN 1
		ELSE
			PRINTFORMW 「음, 빼는 게 좋을 거야. 숙면 방해되잖아.」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
