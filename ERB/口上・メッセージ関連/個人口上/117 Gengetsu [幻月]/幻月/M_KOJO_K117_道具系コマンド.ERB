@M_KOJO_MESSAGE_COM_K117_40
CALL M_KOJO_MESSAGE_COM_K117_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「재미있는 걸 가지고 있네」
			PRINTFORMW 「바로 사용해 보자. 응?」
			PRINTFORMW 겐게츠는 다리를 벌리고, 로터가 밀어 넣어지는 것을 기다린다.
		ELSE
			PRINTFORMW 「과연... 조금 흥미가 생길지도 모르겠네」
			PRINTFORMW 겐게츠는 로터를 호기심 어린 시선으로 바라보고 있었다. 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「뭐, 기분 좋은 건 기분이 좋지만」
		PRINTFORMW 「이것만으로는 만족할 수 없을 것 같아서」
		PRINTFORMW 그렇게 말한 겐게츠의 시선은 %조사처리(CALLNAME:MASTER,"의")% 가랑이에 향하고 있었다. 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「아하하♪ 클리토리스가 찌릿찌릿하다.」 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「기술이 부족한 걸 도구로 어떻게든 하려는 건 정답이라고 생각해」 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
