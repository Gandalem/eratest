;==================================================
;48,搾乳機
;==================================================
@M_KOJO_MESSAGE_COM_K117_48
CALL M_KOJO_MESSAGE_COM_K117_48_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K117_48_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「へー、こんなのがお金になるんだ」
			PRINTFORMW 「世の中物好きばっかりだねぇ」
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「これ付けたらおっぱい大きくなるかな？」
			PRINTFORMW 「ん？　ならない？　……そっか残念」
		ELSE
			PRINTFORMW 「母乳を売る？　うーん、何だかなぁ……」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:搾乳機
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「クスクス♪　うん、頑張って一杯出すね♪」 
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「折角だし直接飲んでみない？」
			PRINTFORMW 「自分で言うのもあれだけど、悪くない味だと思うのよ」 
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「牛にでもなったみたい」
			PRINTFORMW 「……あんまりいい気分はしないなぁ」
			RETURN 1
		ENDIF
	;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「はい、お口開いて」
			PRINTFORMW 幻月は先端から母乳が垂れている乳首を、%CALLNAME:MASTER%に含ませ、乳房をぎゅっと押した。
			PRINTFORMW すると再び大量の母乳が噴出し、%CALLNAME:MASTER%の口を一杯にしていく。
			PRINTFORMW 「どうかな？　幻月お姉さんの特製生搾りミルクの味は」
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 幻月は搾乳機を外しても未だ溢れ出ている母乳を手の平に溜め、喉を鳴らして飲み干した。
			PRINTFORMW 「癖が無くてまろやかで。うん上々♪」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「……全部売らずにちょっと残しておかない？」
			PRINTFORMW 「いや、自分のミルクの味には、ちょっと興味があるかなって」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
