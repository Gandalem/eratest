	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		;時姦中
		IF FLAG:70
			PRINTFORMW 「밧줄...? 음, 뭘 하는 거야...?」
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「제발 부드럽게 해줘...%UNICODE(0x2665) *1%」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 >= 3
			PRINTFORMW 「나에게 무슨 일이 일어날까...?%UNICODE(0x2665) *1% %UNICODE(0x2665) *1%」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「뭐가... 코에, 나한테 무슨 일이 일어날지...?」
			RETURN 1
		ENDIF
		;解除
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
