;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K13_100
CALL M_KOJO_MESSAGE_COM_K13_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K13_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「아... 아파, 으윽!」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「아아... 이상해지기 시작했어.」
		PRINTFORMW 「아아, 히히」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMDW 당신은 그녀의 울음과 사과를 무시하고 계속해서 부드럽게 스팽킹한다 %FSYN("ass")%.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
