@M_KOJO_MESSAGE_COM_K13_0
CALL M_KOJO_MESSAGE_COM_K13_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K13_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORMW 「아앗... 그렇게 만지지 마... 응흣」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「%UNICODE(0x2665) *1%～아, 거기… 움찔해 버려%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「앗…… 거기…… 햐읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「상냥하게 대해주셔서 기뻐요……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응... %UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 야앗%UNICODE(0x2665) *1% 싫어앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「내 몸이 아닌 것 같아……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「이런 짓 당하고…… 응응!%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「머릿속이 저려서…… 파아%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……후흣……앗……앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……안 돼, 나 이상해질 것 같아……%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
