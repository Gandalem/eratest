;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K13_80
CALL M_KOJO_MESSAGE_COM_K13_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K13_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 
		ELSE
			PRINTFORMDW 대요우세이는 조심스럽게 그녀의 어린 손으로 당신의 성기를 감싼다.
			PRINTFORMW 「히익...」
			PRINTFORMDW 그녀는 너무 무서워서 자신의 페니스 위에 올려진 손을 움켜쥐기 시작한다...
			PRINTFORMW 「저-저는 이걸 하는 방법을 모르겠어요...」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「아... 떨리기 시작하는군...」
			PRINTFORMW 「가까워진 것 같네, 응. 흥...음...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「터질 것 같아...」
			PRINTFORMDW 대요세이가 당신의 %FSYN("penis")%을 양손으로 감싸며 움직임을 재촉한다.
		ELSE
			PRINTFORMDW 대요정은 얼굴을 애무하며 광적으로 몰두한 듯 %TINKO(PLAYER)%를 문지른다.
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「이렇게 애처로운 얼굴을 하고 있어서 안쓰러워…… 지금은 편하게 해줄게」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「끝부분을 세게 핥아주면…… 움찔하고 움직이네요」
			PRINTFORMW 「후훗, 귀여워요 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMDW 대요정은 손가락 끝을 얽히게 하여 %TINKO(PLAYER)%를 자극한다….
			PRINTFORMW 「좀 더 힘내주세요……」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「빨리…… 나에게 갖고 싶어 해줘……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「츄릅쮸릅하게 정액을 내어줄게요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「뿌리도 귀두도 전부 잔뜩 주물러 줄게요%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「아, 아직 안 나오는 건가요?」
			PRINTFORMW 「하, 빨리 싸 주세요……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아아…… 무서워」
			PRINTFORMW 「이, 이쪽으로 향하지 말아 주세요……」
		ELSE
			PRINTFORMDW 대요정은 서툰 손놀림으로 %TINKO(PLAYER)%를 문지르고 있다.
			PRINTFORMDW 쾌감에 %TINKO(PLAYER)%가 몸을 움찔거릴 때마다 대요정의 눈에 눈물이 고인다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
