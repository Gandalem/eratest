@M_KOJO_MESSAGE_COM_K13_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 
		ELSE
			PRINTFORMW 「가슴으로 끼우는 건가요……」
			PRINTFORMDW 대요정은 불안정한 손놀림으로 %TINKO(PLAYER)%를 끼워 넣었다.
			PRINTFORMW 「이걸로 가슴으로 위아래로 움직여서...?」
			PRINTFORMW 「이럇샤, 이럇샤…… 꽤 힘들네요」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「내 가슴, 기분 좋은가요...?」
			PRINTFORMW 「아, 기뻐하는 듯이 움찔움찔 뛰고 있어……♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「더 세게 해 드릴게요…… 응, 응……」
		ELSE
			PRINTFORMDW 가슴골 사이로 보이는 귀두를 대요정은 넋을 잃고 바라보고 있다.
			PRINTFORMW 「이렇게나 커져줘서…… 기뻐%UNICODE(0x2665) *1%」
		ENDIF
		;思慕
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「어이구, 어이구……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이렇게 좌우로 움직여봐……」
			PRINTFORMW 「아, 커졌어요……」
		ELSE
			PRINTFORMW 「양쪽에서 눌러…… 야, 후우...」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW (가슴 쪽이 커지고 있는 게 보여…. 무서워…)
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……아직 해야 하는 거예요…?」
			PRINTFORMDW 대요정은 가슴에 끼인 채로, 반쯤 울먹이며 이쪽을 올려다보고 있다.
		ELSE
			PRINTFORMW 「우…… 우응……」
			PRINTFORMDW 대요정은 %TINKO(PLAYER)%에게서 얼굴을 떼고 가슴을 움직이고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
