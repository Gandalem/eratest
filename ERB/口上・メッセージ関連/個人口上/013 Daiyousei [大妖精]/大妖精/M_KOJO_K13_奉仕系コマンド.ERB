@M_KOJO_MESSAGE_COM_K13_81
CALL M_KOJO_MESSAGE_COM_K13_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K13_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 
		ELSE
			PRINTFORMW 「이걸 입에」
			PRINTFORMW 「아, 아무…… 음뭇… 츄릅」
			PRINTFORMDW 대요정은 입을 열고 %TINKO(PLAYER)%를 입으로 삼킨다.
			PRINTFORMDW 귀두가 자극되어 적당한 쾌감에 자신도 모르게 목구멍 깊숙이 밀어 넣으려 %조사처리(CALLNAME:MASTER,"는")% 허리를 내밀었다.
			PRINTFORMW 「응윽!?」
			PRINTFORMDW 까삭! 
			PRINTFORMW 
			PRINTFORMDW ＼ｷﾞｬｰ！／
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「츄릅%UNICODE(0x2665) *1%응뭄%UNICODE(0x2665) *1%하뭄%UNICODE(0x2665) *1%」
			PRINTFORMW 「흐어어흐읍하아…?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「츄읏, 쥬르읏, 츄풉%UNICODE(0x2665) *1%」
			PRINTFORMDW 혀끝으로 귀두를 핥아 돌리며 꿈틀거리는 귀두에 쾌감을 준다.
		ELSE
			PRINTFORMW 「푸하아…… 음뭇……%UNICODE(0x2665) *1%」
			PRINTFORMDW 대요정의 이가 음경을 문지르고, 적당한 자극으로 사정을 유도한다…….
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「하후……힛하히히호후핫헤후하하이%UNICODE(0x2665) *1%」
			PRINTFORMDW 대요정이 입에 문 채 말할 때마다 구강 내부가 물결치고 쾌감이 파도처럼 밀려온다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응츄... 쥬... 츄... 하무%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「츄우우우…%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMDW 대요정은 %조사처리(CALLNAME:MASTER,"에게")% 매달리며 격렬하게 입안을 앞뒤로 움직여 간다….
		ELSEIF RAND:2 == 0
			PRINTFORMW 「츄릅…… 츄르르…… 쪽부%UNICODE(0x2665) *1%」
			PRINTFORMDW 사탕을 핥는 것처럼 침을 흘리며 %TINKO(PLAYER)%를 거칠게 탐한다.
		ELSE
			PRINTFORMW 「주무치쮸뿌쮸루루%UNICODE(0x2665) *1%」
			PRINTFORMDW 대요정은 음경 깊숙한 곳까지 빨아들이는 듯한 흡착력으로 입과 혀를 요염하게 움직인다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「우으... 음그우... 윽」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「크흑… 컥, 컥… 죄송해요」
			PRINTFORMDW 대요정은 목을 막고, 눈에 눈물을 가득 담아 구역질을 하고 있다.
		ELSE
			PRINTFORMW 「응응응……읏」
			PRINTFORMDW 대요정은 육봉의 생생한 감촉과 냄새에 눈을 감으며 입술을 움직이고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
