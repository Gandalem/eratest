; Modular ERB: 個人口上/013 Daiyousei [大妖精]/大妖精/M_KOJO_K13_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K13
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K13
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF FLAG:70
	RETURN 1
ELSE
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORMW 「흐으음... 너무 폭력적으로 굴지 말아줘...」
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORMW 「미안해요... 당신이 하는 말을 들을 테니, 저를 해치지 말아주세요...」
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORMW 「...서노...쨩... 모두...」
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 「아니... 이상하네...」
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 「무슨 일이야...? 나한테 무슨 일이 생길 거야...?」
	PRINTFORMDW 다이요우의 몸은 그녀를 관통하는 갑작스러운 쾌감에 떨었다.
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 「...이제 정말 괜찮아졌어.」
	PRINTFORMW 「왜냐면... 너무 기분이 좋거든%UNICODE(0x2665) *1%」
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「기분이 좋았어... 또 하고 싶어...%UNICODE(0x2665) *1%」
ELSEIF TFLAG:23 == 2
	PRINTFORMW 「더... 더 하고 싶어...」
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「하아%UNICODE(0x2665) *1% 흐음...%UNICODE(0x2665) *1%」
	PRINTFORMDW 스스로의 쾌락을 추구하는 요정은 방금 태어났다.
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMDW 대요우세이는 충동적으로 허벅지를 비비며 자신의 가랑이를 자극한다.
	PRINTFORMW 「응...아...! 아-안 돼...!」
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「오-아니야... 내가... 뭘 하고 있는 거야...?」
	PRINTFORMDW 다이요세이가 자신이 무엇을 하고 있는지 갑자기 깨달았을 때, 그녀의 어린 슬릿은 자신의 분비물로 축축해졌다.
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 「아...%UNICODE(0x2665) *1%, 후우...%UNICODE(0x2665) *1%」
	PRINTFORMDW 대요세이는 기회가 있을 때마다 스스로를 위로한다.
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「S-이렇게 해도 될까...?」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「...다음에 뭘 해야 하지?」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「네가 원하는 건 뭐든지 해줄게...」
ENDIF
;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORMW 「지금 떠나고 싶어...」
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORMW 「히으... 아, 안 돼...」
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORMW 「증오해... 증오해... 네가 싫어!」
ENDIF
