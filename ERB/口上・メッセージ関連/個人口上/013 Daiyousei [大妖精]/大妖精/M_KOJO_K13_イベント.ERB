@M_KOJO_EVENT_K13_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「아... 저...」
				PRINTFORMDW 대요정은 머뭇거리며 이쪽을 올려다보고 있다.
				PRINTFORMDW 잠시 안절부절못하다가 결심한 것처럼 얼굴을 들었다.
				PRINTFORMW 「꼭 가고 싶은 장소가 있어요. ...하지만 혼자서는 무서워서...」
				PRINTFORMW 「...같이 따라와 주시겠어요?」
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMDW 대요정은 화사하게 얼굴을 빛내며 기쁜 듯 날갯짓을 했다.
				PRINTFORMW 「와아…… 정말 감사합니다! 금방 준비할게요…」
				PRINTFORMDW 대요정은 나는 것조차 잊고 서둘러 집 쪽으로 뛰어 나갔다. 발이 꼬여 넘어질 듯 위태로워 보인다.
				PRINTFORMDW 그곳이 어떤 모습일지 궁금함에도 불구하고, %조사처리(CALLNAME:MASTER,"는")% 준비를 하기 위해 자신의 방으로 향했다.	
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「그, 그렇죠…… 갑자기 들으면 곤란하잖아요」
				PRINTFORMW 「이상한 말 해서 죄송해요……」
				PRINTFORMDW 대요정은 사이드테일을 축 늘어뜨리며 고개를 숙였다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;怒り口上
;==================================================

@M_KOJO_EVENT_K13_29(ARG,ARG:1)
;口上主はTARGET
;ARGはTARGETの度胸で分岐
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;怒らせてしまった
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;泣かせてしまった　[臆病]持ち
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDL 대요정의 귀여운 얼굴이 눈 깜짝할 사이에 일그러져 간다….
		PRINTFORML 「우…… 으에에에……」
		PRINTFORML 「어째서…… 끅… 어째서 그런 걸 하시는 거예요……」
		PRINTFORMDL 대요정은 눈물을 터트리듯 그 자리에서 울음을 터뜨리고 말았다….
		RETURN 1
	ENDIF
ENDIF
RETURN 1
