RETURN 1

@M_KOJO_SPEVENT_K13_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1003)
			SETCOLOR COLOR("緑")
			PRINTFORMDL 다녀세이는 아무 말도 하지 않고 그저 바닥을 응시하며 치마를 꽉 쥐고 있었다.
			PRINTFORMW 
			PRINTFORMW 「%CALLNAME:MASTER%-상...」
			PRINTFORMW 「내 감정을 이해해 줄 수 있어...?」
			PRINTFORMW 
			PRINTFORMDL 그녀가 고개를 들자 당신의 손을 잡아 자신의 가슴 위에 올려놓는다.
			PRINTFORMDL 그녀의 작고 부드러운 가슴을 만지는 느낌 외에, 당신은 빠르게 뛰는 박동을 느낀다. 
			PRINTFORMW 
			PRINTFORMW 「최근에 항상 이런 상태였어.」
			PRINTFORMW 「너랑 함께 있으면 내 가슴이 이렇게 세차게 뛰는 것 같아... 혼자 있을 때조차 너 생각을 해, %CALLNAME:MASTER%...」
			PRINTFORMW 「어떤 일 때문일 거라고 생각했는데, 키네 선생님께서 그게 사랑이라고 알려주셨어.」
			PRINTFORMW 「그녀가 말했지... 내가 소중히 여기게 된 누군 사람이 있기 때문이라고.」
			PRINTFORMW 「비록 내가 요정이지만, 너를 사랑하게 됐어, %CALLNAME:MASTER%.」
			PRINTFORMW 
			PRINTFORMDL 다이요세이가 당신의 손을 잡고 있는 그 손이 떨리고 있다.
			PRINTFORMW 
			PRINTFORMW 「나는 그저 평범한 대요정일 뿐이야... 난 단막(Danmaku)에 소질이 없어... 시르노쨩이 항상 나를 도와줘야 해...」
			PRINTFORMW 「나도 별로 똑똑하지 않아... 요정이 너랑 함께하는 건 미친 짓일지도 몰라, %CALLNAME:MASTER%...」
			PRINTFORMW 「하지만 그래도... 난 너와 함께 있고 싶어, %CALLNAME:MASTER%...!」
			PRINTFORMW 
			PRINTFORMDL 다이요우세이의 눈에서 눈물이 흘러내리기 시작했다. 그녀는 불안한 표정으로 당신을 바라본다.
			PRINTFORMW 
			PRINTFORML 
			PRINTFORML 
			PRINTFORMW 
			PRINTFORMW 「%CALLNAME:MASTER%... 사랑해.」
			RESETCOLOR
			;二回目の告白
		ELSE
			SETCOLOR COLOR("緑")
			PRINTFORMW 「이건 장난이 아니야... 정말로 너를 연모해.」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 싫다고 말했는데... 나, 참지 못해서」
			PRINTFORMW 「부탁이야... 싫다고 하지 말아줘...」
			RESETCOLOR
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL 당신은 다이요우세이를 안았다.
		PRINTFORMDL 그녀는 자신의 고백이 받아들여졌음을 깨닫고 진심으로 울기 시작했다.
		PRINTFORMW 「으, 흐윽....」
		PRINTFORMW 「나-나는 만약 네가 거절한다면 어떻게 해야 할지 몰라서...」
		PRINTFORMW 「%CALLNAME:MASTER%... 나는 당신을 너무너무 사랑해요... 영원히...!」
		PRINTFORMDW 당신은 그녀의 눈물 속에서 미소 짓고 있는 다이요우세이를 그녀가 진정될 때까지 꼭 안아주었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDW 다이요우세이는 힘없이 고개를 숙이며 표정이 굳는다...
		PRINTFORMW 「......」
		PRINTFORMW 「T-그렇지. 모든 것의 요정이 당신을 사랑하게 되다니, %CALLNAME:MASTER%, 그것은...」
		PRINTFORMW 「R-맞아... 이건 그냥 요정의 장난이었어.」
		PRINTFORMW 「그러니까 이 일은 잊어도 돼 %CALLNAME:MASTER%... 잊어버려...」
		PRINTFORMDL 그녀가 말을 마치기 전에, 대요정이 날아가 버렸다.
		PRINTFORMDL 대요정의 슬픔이 눈에 고이다가 결국 흘러내린다.
		PRINTFORMDW 남은 것은 땅 위의 눈물 자국뿐이었다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
