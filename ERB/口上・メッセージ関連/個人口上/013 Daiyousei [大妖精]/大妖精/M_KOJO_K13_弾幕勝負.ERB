; Modular ERB: 個人口上/013 Daiyousei [大妖精]/大妖精/M_KOJO_K13_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K13_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIM LCOUNT
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	IF CFLAG:TARGET:溜まってる度 > 500 && TALENT:MASTER:性別 != 1 && CFLAG:2 > 1500 && ARGS == "戦闘前"
		PRINTFORML
		PRINTFORML
		PRINTFORMDL 대요정의 모습이 어딘가 이상하다…
		PRINTFORMDL 호흡이 거칠고 뺨이 홍조를 띠고 있다.
		PRINTFORMW
		PRINTFORML
		PRINTFORMDL [0] 걱정되니까 봐줄게
		PRINTFORMDL [1] 봐주지 않을 거야
		LCOUNT ++
		$INPUT_LOOP_K13_ENCOUNTER
		INPUT
		IF RESULT == 0
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 눈치채지 못하도록 핸디를 거기로 했다.
			LCOUNT ++
			HANDICAP_FIXED = 3000
			HANDICAP_RAND = 3000
		ELSEIF RESULT == 1
			PRINTFORMDW 어디를 가든 무엇을 하든, %조사처리(CALLNAME:MASTER,"의")% 자유야!
			LCOUNT ++
			HANDICAP_FIXED = 0
			HANDICAP_RAND = 0
			PRINTFORML
			PRINTFORML
		ELSE
			IF LCOUNT >5
				PRINTFORMDL 설정 안 되어 있다고 했잖아!
			ELSE
				PRINTFORMDL 설정되어 있지 않다.
				LCOUNT ++
			ENDIF
			GOTO INPUT_LOOP_K13_ENCOUNTER
		ENDIF
		LCOUNT = 0
	ENDIF
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「……장난으로만은 용서받지 못할지도 몰라요」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「스펠 카드가 없더라도...!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「저도 치르노랑 같이 탄막 놀이 하고 있잖아요!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「요정이니까 봐주지 마세요」
		ELSE
			PRINTFORMW 「이변 때의 요정은 악령보다 흉포해요!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		IF RAND:3 == 0
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 두 팔을 들고 한쪽 다리를 들어 포즈를 취했다.
		ELSEIF RAND:2 == 0
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 두 손으로 머리를 감싼 채 카리스마 포즈를 취했다.
		ELSE
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 밤새의 울음소리를 흉내냈다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「후에애……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「앗……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「저, 아직 지지 않았어요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「꺄악!」
				ELSE
					PRINTFORMW 「아직 더 힘낼 수 있어요!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「크윽……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「이번에는 화염탄을 가득……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「이대로는……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「치르노쨩이 열심히 하고 있는데……」
				ELSE
					PRINTFORMW 「저, 승부는 이제부터예요!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「아파요오……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「맞았잖아~」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「지구해버렸어요……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「맞아버렸다……」
				ELSE
					PRINTFORMW  [패배견]
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「나 진짜 화났다는 거, 알아줬어?」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「저, 다치신 곳은 없으세요?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「좋으시다면 같이 수련하지 않으실래요?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아, 너무 지나쳐 버린 걸까……」
				ELSE
					PRINTFORMW 「요정인 제가 이길 수 있다니, 정말 기뻐요...」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「화난 만큼 강해진 것 같아요」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「요정이라고 해서 방심하시면 안 돼요」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「잠깐 쉬지 않을래요?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「치르노쨩이랑 탄막 놀이한 덕분이에요」
				ELSE
					PRINTFORMW 「순간이동을 좀 더 사용하는 편이 나을까?」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「하아…… 하아……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아, 해냈어……! 이겼어요!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「저 탄막을 피하지 못했다면 오히려 제가 당했을지도 몰라요……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「나라도 이 정도...!」
				ELSE
					PRINTFORMW 「다행이다, 이길 수 있어서」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「으에에에엥……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「역시 저로는 무리인 걸까요……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「강하시네요…… 저도 배워야겠어요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「괜찮으시면, 다음에 탄막놀이 훈련 좀 가르쳐 주세요」
				ELSE
					PRINTFORMW 「치르노보다 강할지도……」
				ENDIF
		ENDSELECT
		IF 相手残機 != 0 && CFLAG:TARGET:溜まってる度 > 700 && TALENT:MASTER:性別 != 1 && CFLAG:2 > 1500
			SETCOLOR COLOR("桃")
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 「괜찮……가요?」
			PRINTFORMDW 몸을 일으키려 하는 %조사처리(CALLNAME:MASTER,"에게")%, 대요정은 고개를 숙이면서 손을 내민다.
			PRINTFORMDW 그 표정이 붉게 상기된 것에 깨달았을 때는, 이미 내민 손을 잡아버린 뒤였다.
			PRINTFORMDW 순간, 시야가 휘청거리며 풍경이 한순간에 바뀌어 간다.
			PRINTFORMDW 몇 초가 채 지나지 않아 부드러운 이불의 감촉을 등지고, %조사처리(CALLNAME:MASTER,"는")% 탄막 승부로 지친 몸을 일으키려 한다.
			PRINTFORMW 
			PRINTFORMW 「미안해요, 이렇게 거친 짓을 해버려서……」
			PRINTFORMW 「아직 몸이 제대로 움직일 수가 없는데……」
			PRINTFORMW 
			PRINTFORMDW 대요정은 정욕으로 촉촉해진 눈동자로 바라본 채, 치마를 들어 올린다.
			PRINTFORMDW 드러난 밀혈에서 감미로운 암컷의 향기가 풍긴다. 귀여운 팬티는 꿀에 젖어 이미 속옷으로서의 의미를 지니지 못했다.
			PRINTFORMW 
			PRINTFORMW 「이제... 참을 수가 없어요...」
			PRINTFORMW 「탄막 놀이로 흥분이 너무 심해져서...윽 %UNICODE(0x2665) *1%... 군앗 %UNICODE(0x2665) *1%」
			PRINTFORMW 
			PRINTFORMDW 대요정은 속옷을 흘리며 애액으로 범벅이 된 와레메를 가느다란 손가락으로 만지작거리며 달랜다.
			PRINTFORMDW 끊임없이 와레메에게서 애액이 흘러나와, 허벅지에는 여러 방울의 물방울이 떨어져 있었다. 
			PRINTFORMW 
			PRINTFORMW 「아아앗…%UNICODE(0x2665) *1%아아앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「야아…%UNICODE(0x2665) *1%부족해… 손가락만으로는, 이제…」
			PRINTFORMW 
			PRINTFORMDW 목소리를 떨리는 대요정은, %조사처리(CALLNAME:MASTER,"의")% 눈앞에서 젖은 옷을 벗어 던지고 태어난 그대로의 모습이 된다.
			PRINTFORMDW 거친 숨결과 함께 분홍빛 유두가 꼿꼿하게 서 있고, 온몸이 달아올라 어린 몸임에도 말로 표현할 수 없는 색기를 풍기고 있다.
			PRINTFORMDW 그 요염한 몸을 %조사처리(CALLNAME:MASTER,"에게")% 쓰러뜨린다고 생각하자, 무의식적으로 %조사처리(CALLNAME:MASTER,"의")% 옷 속으로 손을 넣고 욕망대로 남근을 찾아냈다.
			PRINTFORMDW 대요정의 자위와 달콤한 냄새에 매혹된 %조사처리(CALLNAME:MASTER,"의")% 남근은, 대요정의 손에 의해 강직하게 외부로 세워졌다.
			PRINTFORMW 
			PRINTFORMW 「앗…… 이렇게나 큰……%UNICODE(0x2665) *1%」
			PRINTFORMW 「안돼…… 벌써…… 몸이 부서질 것 같아……」
			IF TALENT:処女 == 1
				PRINTFORMDW 대요정은 %CALLNAME:MASTER%위에 올라타자, 터질 듯한 남근에 와레메를 문지르며 필사적으로 쾌락을 탐하기 시작했다.
				PRINTFORMW 
				PRINTFORMW 「하아… 아%UNICODE(0x2665) *1%…응읏%UNICODE(0x2665) *1%아아아%UNICODE(0x2665) *1%」
				PRINTFORMW 「후우응…%UNICODE(0x2665) *1%단단해서앗… 바들바들 떨고… 앗%UNICODE(0x2665) *1% 기분 좋아아%UNICODE(0x2665) *1%」
				PRINTFORMW 
				PRINTFORMDW 자신의 작은 클리와 와레메를 자극시키면서, 대요정은 열성적으로 남근을 치구에 문지른다.
				PRINTFORMDW 쾌락에 지쳐 %조사처리(CALLNAME:MASTER,"가")% 정액을 뿜어내지만, 대요정은 그를 더욱 흥분시키며 허리를 격렬하게 움직인다.
				PRINTFORMW 
				PRINTFORMW 「죄송해요앗%UNICODE(0x2665) *1%죄송해요%UNICODE(0x2665) *1%……아아앗%UNICODE(0x2665) *1%」
				PRINTFORMW 
				PRINTFORMDW 대요정의 애처로운 사죄의 목소리와 함께 음란한 물소리가 방에 울려 퍼진다.
				EXP:13:Ｃ経験 += 3
			ELSE
				PRINTFORMDW 대요정이 %CALLNAME:MASTER%위에 올라타자, 흥분한 체액으로 젖은 남근을 와레메에게 유혹한다.
				PRINTFORMW 
				PRINTFORMW 「이런 건 나쁜 짓인데……%UNICODE(0x2665) *1%앗……%UNICODE(0x2665) *1%」
				PRINTFORMW 
				PRINTFORMDW 대요정은 수치심과 죄책감을 토로하면서도, 허리를 낮추고 단숨에 밀한 곳으로 남근을 깊숙이 박아 넣는다.
				PRINTFORMW 
				PRINTFORMW 「아아아아앗……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 
				PRINTFORMDW 황홀한 표정을 지으며 떨리는 대요정. 이윽고 욕망대로 허리를 흔들며, %CALLNAME:MASTER%위에서 작은 몸을 들썩이게 한다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 걱정하는 기색조차 없이, 일방적으로 애액으로 남근을 깨물 듯 빨아대며, 달콤한 액체를 사방에 뿌리면서 끊임없이 흡입한다.
				PRINTFORMW 
				PRINTFORMW 「하앗, 힛, %UNICODE(0x2665) *1%기분 좋아아%UNICODE(0x2665) *1%」
				PRINTFORMW 
				PRINTFORMDW 이윽고 육봉이 움찔거리며 박동하고 정액을 뿜어내려고 하는 것을 그치지 않는다. 백탁액을 결합부에서 흘러나오게 하면서도 허리를 계속 움직인다.
				PRINTFORMDW 대요정은 울 것 같은 슬픈 표정을 한 채로 육봉을 아랫입으로 물고, 결코 놓으려 하지 않는다.
				PRINTFORMW 
				PRINTFORMW 「미안해앗%UNICODE(0x2665) *1%미안해%UNICODE(0x2665) *1%… 아아앗%UNICODE(0x2665) *1%」
				PRINTFORMW 
				PRINTFORMDW 살과 살이 퍽퍽 부딪치는 소리에 섞여 대요정의 사죄가 방에 울려 퍼진다.
				EXP:13:膣射経験 += 3
				EXP:13:Ｖ性交経験 += 3
				EXP:MASTER:挿入経験 += 3
				CALL ADD_SAMEN_V(13, BASE:MASTER:精力)
			ENDIF
			PRINTFORMDW 터져버린 성욕에 미쳐 날뛰는 요정의 장난은, 대요정의 체력이 다할 때까지 반복된다…….
			EXP:13:精液経験 += 3
			EXP:13:絶頂経験 += 3
			EXP:MASTER:絶頂経験 += 3
			EXP:MASTER:射精経験 += 3
			BASE:MASTER:精力 = 0
			BASE:MASTER:勃起 = 0
			RESETCOLOR
		ELSE
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
$INPUT_K13_RAPE
RETURN 1
