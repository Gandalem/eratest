@M_KOJO_MESSAGE_COM_K13_65_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			;処女
		ELSEIF TCVAR:破瓜 == 1
			IF TALENT:恋慕
				PRINTFORMW 「제 페이스대로 하면 되는 거죠…… 해볼게요」
				PRINTFORMDW 대요정은 누워있는 %조사처리(CALLNAME:MASTER,"를")% 가로질러, 솟아오른 %TINKO(PLAYER)%에 축축함을 갖다 댄다.
				PRINTFORMDW 긴장했는지 등에 달린 두 장의 날개는 팽팽하게 당겨져 있으며 희미하게 떨리고 있다.
				PRINTFORMW 「응…… 후우……」
				PRINTFORMDW 자잘하게 %TINKO(PLAYER)%를 비비고, 끈적……한 애액을 떨어뜨릴 때마다 귀두에 짜릿한 쾌감이 흘렀다.
				PRINTFORMW 「……갈게요. 응흣...!」
				PRINTFORMDW 천천히 허리를 가라앉히며, %TINKO(PLAYER)%를 대요정의 질 속으로 깊이 밀어 넣는다.
				PRINTFORMW 「윽…… 하…… 후우…… 더…… 깊이……」
				PRINTFORMDW 파과(파과)의 피가 %TINKO(PLAYER)%에 떨어졌다. 통증으로 숨을 헐떡이면서도 대요정은 스스로 박아 넣은 말뚝을 삼키려는 듯 질을 꿈틀거리며 허리를 낮춘다.
				PRINTFORMW 「아…… 겨우…… 들어왔어요」
				PRINTFORMDW 겨우 %TINKO(PLAYER)% 전체가 대요정에게 받아들여지자, 힘없이 이쪽으로 쓰러지는 대요정을 받아 안았다.
				PRINTFORMW 「배 속에 가득……했어…… 수고했어요」
				PRINTFORMDW 무사히 %TINKO(PLAYER)%를 받아들인 대요정을 위로하듯이, %조사처리(CALLNAME:MASTER,"는")% 그 작은 등을 쓰다듬으며 안아주었다.
			ELSE
				PRINTFORMW 「저, 제가 스스로……?」
				PRINTFORMW 「……저, 알겠습니다」
				PRINTFORMDW 두려워하면서도 대요정은 %조사처리(CALLNAME:MASTER,"에게")% 올라타며, %TINKO(PLAYER)%에 클리토리스를 갖다 댄다.
				PRINTFORMW  남근이 클리토리스 주변을 헤집고 들어갔지만, 그 앞의 처녀막에 막혀 대요정은 본능적으로 주춤거렸다.
				PRINTFORMW 「아, 어라…… 안 들어가...? 읍... 읍... 어, 어떻게 해……」
				PRINTFORMDW 느릿느릿 움직이는 대요정에게 참지 못하고, %조사처리(CALLNAME:MASTER,"는")% 대요정의 허리를 잡고 남근을 주저 없이 찔러 넣었다.
				PRINTFORMW 「히익!…… 아, 아파…… 아, 아프다...」
				PRINTFORMDW 입을 벌리고 처녀막이 찢어지는 격통에 충격을 받는 대요정을 신경 쓰지 않고, 사정기를 이용해 주무르기 시작했다.
			ENDIF
		ELSE
			PRINTFORMW 「응읏……」
			PRINTFORMDW 대요정은 %TINKO(PLAYER)% 쪽으로 허리를 낮추며 %TINKO(PLAYER)%를 삼키듯 받아들인다....
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			;前回射精した
		ELSEIF TCVAR:102
			IF RAND:3 == 0
				PRINTFORMW 「제 질 안, 기분 좋았나요?」
				PRINTFORMW 「응... 더 노력할게요 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「앗… 따뜻한 것이 퍼져오고 있어요…%UNICODE(0x2665) *1%」
				PRINTFORMW 「앗… %UNICODE(0x2665) *1% 남은 것도 아직 있는 것 같네요%UNICODE(0x2665) *1%」
				PRINTFORMDW 대요정은 짜듯이 조여 남아있던 정액을 질 안에서 짜냈다.
			ELSE
				PRINTFORMW 「아직 낼 수 있죠 %CALLNAME:MASTER%」
				PRINTFORMW 「앗, 또 단단해졌어…… %UNICODE(0x2665) *1%」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 사정액으로 뒤덮인 단단한 것을 대요정의 깊은 곳까지 박아 넣듯이 내리쳤다.
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「앗... 안쪽... 콩콩거리고 있어요...%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「앗, 하앗, 응읏%UNICODE(0x2665) *1%」
				PRINTFORMW 「저도 움직일 수 있어요……앗……너무 기분 좋은 게 가득해요……응……%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응읏... 응읏... 저, 기분 좋은가요?」
				PRINTFORMDW 대요정은 %조사처리(CALLNAME:MASTER,"의")% 움직임에 맞춰 남근에 허리를 부딪치고 있다.
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「저 열심히 할게요…… 마음껏 기분 좋아져도 돼요네」
		PRINTFORMW 「응…… %UNICODE(0x2665) *1%」
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「…으으으%UNICODE(0x2665) *1%이거, 이걸 원했어요%UNICODE(0x2665) *1%야앗, 아앗%UNICODE(0x2665) *1%」
		PRINTFORMDW 대요정은 아무 말도 하지 않고 %조사처리(CALLNAME:MASTER,"의")% %TINKO(PLAYER)%에 주저앉아, 쾌락을 찾아 거칠게 허리를 흔든다.
		;それ以外
	ELSE
		PRINTFORMW 「흐윽…… 응……」
		PRINTFORMDW 대요정은 서툴게 %TINKO(PLAYER)%를 질혈에 삽입하며, 절제된 움직임으로 허리를 움직였다.
	ENDIF
ENDIF
