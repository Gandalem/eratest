@M_KOJO_MESSAGE_PALAMCNG_B_K13
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		;PRINTFORMW
	ELSE
		PRINTFORMW 「햐아앗! 가슴이 새어 나와요%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		IF FLAG:70
			;PRINTFORMW
		ELSE
			PRINTFORMW 「힉%UNICODE(0x2665) *1%꺄앗%UNICODE(0x2665) *1%하아아아앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「눈앞이%UNICODE(0x2665) *1%새하얘져엇%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			;PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW 「그만해읏, 그만하라고오! 이상해앳! 미쳐버릴 것 같아%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMDW 한 마리의 요정이 구멍이라 불리는 구멍에서 액체를 배출하며 쾌락을 즐기고 있다.
			PRINTFORMDW 더욱한 고문에 의해 경련하더라도 손길을 게을리할 리 없다.
		ELSE
			PRINTFORMW 「싫어%UNICODE(0x2665) *1%싫어싫어싫어%UNICODE(0x2665) *1%아아아%UNICODE(0x2665) *1%아아%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			;PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW 「아아아아앗...!%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「에헤, 에헤헤…%UNICODE(0x2665) *1%이젠 아무것도… 앗… 생각할 수 없앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「하아――읏%UNICODE(0x2665) *1%하아――읏%UNICODE(0x2665) *1%하아――읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			;PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW 「야앗… 그렇게 해버리면%UNICODE(0x2665) *1% 후와아… 앗앗%UNICODE(0x2665) *1%」
