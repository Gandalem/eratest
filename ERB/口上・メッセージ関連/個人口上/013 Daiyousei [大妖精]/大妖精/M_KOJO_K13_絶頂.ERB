@M_KOJO_MESSAGE_PALAMCNG_A_K13_23(ARG)
;-------------------------------------------------
;イラマチオ
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		;PRINTFORMW
	ELSEIF TALENT:MASTER:濃厚精液
		IF RAND:3 == 0
			PRINTFORMW 「코호, 콜록…」
			PRINTFORMW 「목구멍에 걸려 와서… 대단해…」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「!? 커헉, 콜록!」
			PRINTFORMW 「하, 숨이……! 콜록」
			RETURN 1
		ELSE
			PRINTFORMW 「입안에서 끈적거리네……」
			PRINTFORMW 「아우... 코까지 흘러내릴 것 같아……」
			RETURN 1
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「으윽…… 콜록」
			PRINTFORMW 「콜록, 콜록……」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「배가 가득 차버릴 거예요…」
			RETURN 1
		ELSE
			PRINTFORMW 「이렇게나 많이 나오는군요」
			PRINTFORMW 「흐, 흐으…… 츄릅!」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K13_22
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K13_22(ARG)
;-------------------------------------------------
;シックスナイン
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;同時射精
	IF NOWEX:射精 && NOWEX:MASTER:射精
		PRINTFORMW
		RETURN 1
		;TARGETだけ射精
	ELSEIF NOWEX:射精
		;PLAYERについてる
		IF GETBIT(TALENT:PLAYER:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			PRINTFORMW
			RETURN 1
		ENDIF
		;PLAYERだけ射精
	ELSE
		;TARGETについてる
		IF GETBIT(TALENT:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			PRINTFORMW
			RETURN 1
		ENDIF
	ENDIF
