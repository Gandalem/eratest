@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K13_0
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K13_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		;PRINTFORMW
	ELSEIF TALENT:MASTER:濃厚精液
		IF RAND:3 == 0
			PRINTFORMW 「이렇게나 많이 내주신 거예요…… 젤리 같아요……」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMDW 대요정은 흥미진진하게 정액이 찬 콘돔을 찌르고 있다.
			RETURN 1
		ELSE
			PRINTFORMW 「나의 질내…… 이렇게 많이 나오면 임신해 버리겠네요」
			RETURN 1
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「정액…… 아직 따뜻하네요……」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「하얗고 진하고 가득……」
			RETURN 1
		ELSE
			PRINTFORMW 「아…… 보고 있는 것만으로도 배 속 깊은 곳이 애틋해지네요……」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
