			ELSE
				PRINTFORMW 「응응—%UNICODE(0x2665) *1%」
			ENDIF
			;絶頂Ｖ
		ELSE
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「흐아……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아앗%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「흐으…%UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;強絶頂Ａ
		IF NOWEX:Ａ絶頂 >= 2
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				;PRINTFORMW
			ELSEIF RAND:2 == 0
				;PRINTFORMW
			ELSE
				;PRINTFORMW
			ENDIF
			;絶頂Ａ
		ELSE
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				;PRINTFORMW
			ELSEIF RAND:2 == 0
				;PRINTFORMW
			ELSE
				;PRINTFORMW
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;強絶頂Ｂ
		IF NOWEX:Ｂ絶頂 >= 2
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「꺄앗%UNICODE(0x2665) *1% 움찔움찔해%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아... 가슴이 민감해애... 야앗%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「히아앗%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
			ENDIF
			;絶頂Ｂ
		ELSE
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「앗, 야, 가슴에 싸버릴 것 같아%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「후우웅……%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「큭... 윽 %UNICODE(0x2665) *1%
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		IF TEQUIP:13:口接触部位 == 4
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「더 입에 장난쳐 주세요……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아흐앗%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMDW 대요정은 충혈된 입술을 누르며 쾌감에 떨고 있다.
			ENDIF
			;強絶頂Ｍ
		ELSEIF NOWEX:Ｍ絶頂 >= 2
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「앗... 햐앙%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응읏... 응응%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「입으로 기분 좋아진다고……앗%UNICODE(0x2665) *1%」
			ENDIF
			;絶頂Ｍ
		ELSE
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「아……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응응앗%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「하으……%UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
	ENDIF
ENDIF
