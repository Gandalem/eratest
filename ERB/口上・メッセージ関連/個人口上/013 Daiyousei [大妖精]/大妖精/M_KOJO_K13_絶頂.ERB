			PRINTFORMW 「안 돼... %UNICODE(0x2665) *1% 안 돼... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「꺄앗%UNICODE(0x2665) *1%야아아아…%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｃ絶頂
		;強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 >= 2
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「절정에 달할 것 같다고 생각했어요……읏%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMDW 대요정은 넋을 잃고 오르가즘에 몸을 떨고 있다.
				PRINTFORMW 「윽%UNICODE(0x2665) *1%!윽%UNICODE(0x2665) *1%!」
			ELSE
				PRINTFORMW 「싫어%UNICODE(0x2665) *1% 이런 데 보지 마앗…%UNICODE(0x2665) *1%」
			ENDIF
			;絶頂Ｃ
		ELSE
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
				PRINTFORMW 「앗…… 아아%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「평소보다…… 아으…… 움찔하고 말았어…… %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「아, 아아%UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 >= 2
			;時姦中
			IF FLAG:70
				;PRINTFORMW
			ELSEIF RAND:3 == 0
