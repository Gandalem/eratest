;==================================================
;5,手淫フェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K13_5
CALL M_KOJO_MESSAGE_SCOM_K13_5_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K13_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMW 
		ELSE
			PRINTFORMW 「이렇게……인가요……아무읏」
			PRINTFORMW 「음무앗……후우……레로……」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응… 쭉……%UNICODE(0x2665) *1%」
			PRINTFORMW 「...응... 나오는 거야...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흡읏, 음츄……」
		ELSE
			PRINTFORMW 「르로레로... 츄릅...」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「...응구우...으우...응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「츄릅……응%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「즈윽, 주밧%UNICODE(0x2665) *1%」
			PRINTFORMW 「레류레류……%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응…… 크윽……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응그윽... 으에...」
			PRINTFORMW 「입이 피곤해질 것 같아요...」
		ELSE
			PRINTFORMW 「응응... 르르...」
			PRINTFORMW (이상한 맛이 나요...)
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K13_{SELECTCOM}_1
RETURN 1
