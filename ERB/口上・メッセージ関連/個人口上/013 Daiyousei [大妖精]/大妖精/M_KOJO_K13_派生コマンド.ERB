		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「더 많이 와줘읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「아기 씨앗 많이 흘려보내줘읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아아아%UNICODE(0x2665) *1% 아기를 원하고 싶어져 버려요%UNICODE(0x2665) *1%」
			PRINTFORMW 「잔뜩 내주세요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 야앗%UNICODE(0x2665) *1% 하앗%UNICODE(0x2665) *1% 읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「아기 방이%UNICODE(0x2665) *1% 내려와 버려엇%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「으아앗! 아아아악%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「햐아우읏...! 응응%UNICODE(0x2665) *1%」
			PRINTFORMW 「정자 많이 주세요...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「꺄앗, 아윽, 앙%UNICODE(0x2665) *1%」
			PRINTFORMW 「더 격렬하게%UNICODE(0x2665) *1% 가득 채워 줘엇%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「이런, 너무 많이 넣으면… 앗 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아우욱... 크윽... 응응읏……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「앗, 아아……윽……햐아, 싫어……%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
