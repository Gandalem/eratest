@M_KOJO_MESSAGE_SCOM_K13_6
CALL M_KOJO_MESSAGE_SCOM_K13_6_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K13_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 
		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%그런…… 안쪽을%UNICODE(0x2665) *1%문지르지 마앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「후읏, 큐웅%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「그렇게 세게 찌르면앗%UNICODE(0x2665) *1% 이상해져 버려%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「부, 부서질 것 같아요%UNICODE(0x2665) *1%」
			PRINTFORMW 「하앗, 하앗, 하아아%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아……읏, 안……응응ぅ%UNICODE(0x2665) *1%」
			PRINTFORMW 「더 많이 찔러줘……%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「흐으윽...! 흐아앗…… 응ん%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「배가 볼록해져요... 야, 아직 깊은 곳에 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「하아아……%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응읏, 앗, 야……!」
			PRINTFORMW 대요정은 질내를 문지르며, 그럴 때마다 몸을 경련시키고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「야아아…… 그렇게 많이 박지 말아 주세요……」
		ELSE
			PRINTFORMW 「후우... 음... 후읏... 후읏」
			PRINTFORMW 야한 신음을 참으려고 필사적으로 입가를 막고 있다.
		ENDIF
	ENDIF
ENDIF
