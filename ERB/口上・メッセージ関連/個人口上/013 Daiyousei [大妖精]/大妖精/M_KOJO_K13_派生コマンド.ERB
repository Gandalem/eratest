@M_KOJO_MESSAGE_SCOM_K13_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMW 
		ELSE
			PRINTFORMW 「저기요... 가슴으로 끼운 다음 핥는 건가요?」
			PRINTFORMW 「응... 레로... 응츄...」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「제 가슴, 기분 좋아요…?%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흡…츄…음…」
		ELSE
			PRINTFORMW 「어때요...? 제가 제대로 하고 있나요...?」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「이렇게 비벼서…… 응앗! %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……기분 좋아 보이는 얼굴 하고 있어요%UNICODE(0x2665) *1%」
			PRINTFORMW 「하무…… 음뭇……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「음무…… 함무…… 츄…… %UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「힉, 움찔움찔 움직이고 있어요……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아, 너무 날뛰지 말아주세요……」
		ELSE
			PRINTFORMW 「응, 응쇼…… 우웅~」
		ENDIF
	ENDIF
ENDIF
