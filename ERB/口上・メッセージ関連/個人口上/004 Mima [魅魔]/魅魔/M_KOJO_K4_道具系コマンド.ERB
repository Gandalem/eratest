;==================================================
;49,乳首ローター
;==================================================

@M_KOJO_MESSAGE_COM_K4_49
CALL M_KOJO_MESSAGE_COM_K4_49_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_49_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「스-그래서 내 유두를 보여달라고 하는 거야?」
			PRINTFORMDW 미마는 당신이 가까이 다가가 그녀의 유두에 로터를 부착하자 다소 위축된 듯 보인다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMDL 미마는 유두에서 로터가 거칠게 진동하자 정신을 놓을 것 같다.
			PRINTFORML 「응쿠!... %UNICODE(0x2665)% %CALLNAME:MASTER%...」
			PRINTFORMDW 미마는 당신의 손을 잡고 쾌감을 견디려 애썼다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「후우... 후우...」
			PRINTFORMDL 미마는 자신의 유두가 고통받는 것을 느끼며 천천히 초점을 잃는다.
			PRINTFORMDW 당신이 주파수를 높이자 미마의 동공은 수축한다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「응... 흐으...%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 유두의 간지러운 감각에서 쾌감을 느낀다.
			PRINTFORMW 「그만두지 마...%UNICODE(0x2665)% 계속해...!」
		ELSEIF RAND:2 == 0
			PRINTFORMDL 로터로 미마의 유두 주변을 더듬는다.
			PRINTFORML 「야아... %UNICODE(0x2665)% 헤이, %CALLNAME:MASTER%...%UNICODE(0x2665)%」
			PRINTFORMDW 미마는 비명을 지르며 도착적인 감각을 참으려 한다.
		ELSE
			PRINTFORML 「음... %UNICODE(0x2665)% 후우... %UNICODE(0x2665)%」
			PRINTFORMDL 로터의 진동이 미마의 유두를 자극한다.
			PRINTFORMDW 로터가 분리되면, 그녀는 당신에게 그것을 다른 쪽 유두에 부착해달라고 부탁한다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K4_50
CALL M_KOJO_MESSAGE_COM_K4_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF !TEQUIP:PLAYER:コンドーム ;for equip only
		RETURN 0
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「콘돔이라니... 정말 배려심이 깊네.」
			PRINTFORMDW 미마는 콘돔을 가져와 당신의 성기에 부착한다.
			PRINTFORMW 「저것 좀 봐...♪ 이제 이걸 가졌으니 우리가 원하는 건 뭐든지 할 수 있겠어...♪」
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「이렇게 말해볼게...」
			PRINTFORMDL 미마는 만족스러운 표정으로 당신의 성기를 내려다보며 피임약을 바른다.
			PRINTFORMW 「조금 단단한가? 더 좋은 자극을 줄 수도 있어.」
		ELSEIF RAND:4 == 0
			PRINTFORMDL 미마가 분홍색 콘돔을 펼친다.
			PRINTFORMDL 그렇게 하면 당신의 성기를 완벽하게 덮을 수 있다.
			PRINTFORMW 「버리기엔 아깝지 않겠어, 동의하지 않아?」
		ELSEIF RAND:3 == 0
			PRINTFORML 「이것으로...」
			PRINTFORMDL 콘돔을 착용한 후, 미마는 당신에게 시선을 돌렸다.
			PRINTFORMW 「이제... 시작하자%UNICODE(0x2665)%」
		ELSEIF RAND:2 == 0
			PRINTFORMDL 마이마는 입으로 콘돔을 물고 있었다.
			PRINTFORMDL 그러한 상태에서, 그녀는 당신의 성기에 더 가까이 다가가 능숙하게 입으로 콘돔을 착용했다.
			PRINTFORMW 「음, 어때? 계속하자♪」
		ELSE
			PRINTFORML 「응, 다 넣었어.」
			PRINTFORMDL 미마는 손가락으로 당신의 성기를 더듬는다.
			PRINTFORMW 「우리가 하던 것부터 계속하는 건 어때...%UNICODE(0x2665)%?」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
