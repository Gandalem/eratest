;==================================================
;40,ローター
;==================================================

@M_KOJO_MESSAGE_COM_K4_40
CALL M_KOJO_MESSAGE_COM_K4_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「처음엔 부드럽게 해줄 수 있겠어?」
			PRINTFORMDW 당신은 로터를 미마의 음핵에 대고, 다이얼을 아주 조금 돌린다.
			PRINTFORMDW 그녀의 클릿에서 나는 진동 때문에 다리가 떨리기 시작한다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「후우... %UNICODE(0x2665)% 음... %UNICODE(0x2665)% 크으... %UNICODE(0x2665)%」
			PRINTFORMDL 미마의 클리토리스에 느껴지는 진동이 서서히 강해진다.
			PRINTFORMDW 당신은 손을 거두고 그녀에게 휴식을 주었다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 로터로 미마의 클리토스를 따라 문지른다.
			PRINTFORML 「야아%UNICODE(0x2665)% 아흐%UNICODE(0x2665)% 캬아%UNICODE(0x2665)%」
			PRINTFORMDW 진동이 쾌락으로 변하며 그녀의 몸을 뜨겁게 만든다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 당신은 로터를 미마의 은밀한 곳에 박는다.
			PRINTFORML 「아아아%UNICODE(0x2665)% 하으으...우%UNICODE(0x2665)%」
			PRINTFORMDW 미마는 쾌락을 거부하려 고개를 좌우로 흔든다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「흐읍! 음...! %UNICODE(0x2665)% 후우...%UNICODE(0x2665)%」
			PRINTFORMDL 당신은 다이얼을 조작하며 미마의 클리토리스를 능숙하게 애태웠다.
			PRINTFORMW 「후으...ㄴ...%UNICODE(0x2665)% 아아앗!」
		ELSE
			PRINTFORML 「야아%UNICODE(0x2665)% 히유우...우...%UNICODE(0x2665)%」
			PRINTFORMDL 진동에 응답하여 그녀의 비밀스러운 곳에서 연모의 즙이 흘러내린다.
			PRINTFORMDW 그리고 로터가 그녀의 클리토스에 부착될 때, 더욱 많은 연모의 즙이 나온다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
