;41,Ｅマッサージャ
;==================================================

@M_KOJO_MESSAGE_COM_K4_41
CALL M_KOJO_MESSAGE_COM_K4_41_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_41_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「커다란 나무 장난감이다. 그것으로 무엇을 할 거니?」
			PRINTFORMDW 당신은 마사지기를 켜고 그녀의 어깨에 갖다 댄다.
			PRINTFORMW 「아! 알겠어! 마사지용이니? 이해했어, 이해했어...」
			PRINTFORMDW 미마는 당신이 마사지기를 자신의 가랑이 쪽으로 가까이 가져가는 것을 알아차리자 얼굴이 붉어진다.
			PRINTFORMW 「... 뭐-? %CALLNAME:MASTER%, 나한테 뭘 하려는 거야...?」
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「%CALLNAME:MASTER%... 잠깐, 좀 쉬게 해줘...%UNICODE(0x2665)%」
			PRINTFORMDL 진동을 즐기고 있던 미마가 잠시 쉬자고 당신에게 요청했다.
			PRINTFORMDW 당신은 그녀의 연모액으로 얼룩진 마사지기를 옆에 내려놓았다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 미마의 은밀한 곳이 풀리며, 적당한 진동을 받는다.
			PRINTFORML 「후우...%UNICODE(0x2665)% 아응%UNICODE(0x2665)% 응으...%UNICODE(0x2665)%」
			PRINTFORMDW 미마는 마사지기에 애무를 당하며 눈을 감았다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 진동을 최대로 높여 미마의 은밀한 곳에 붙인다.
			PRINTFORML 「우아아!? 그만...%UNICODE(0x2665)%」
			PRINTFORMDW 미마는 깜짝 놀라 몸을 피하고, 당신은 마사지기를 끈다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「으음... 아아... %UNICODE(0x2665)% 정말 좋다...%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 진동의 쾌감에 점점 더 몰입하게 되고, 당신은 마사지기를 끄기로 결정했다.
			PRINTFORMW 「응... 와... 정말 좋았어...」
		ELSE
			PRINTFORML 「후우%UNICODE(0x2665)% 흐음%UNICODE(0x2665)% 하아%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 진동에서 벗어나려고 허리를 움직인다.
			PRINTFORMDW 당신은 마사지기를 더 가까이 가져가 그녀의 은밀한 곳에 닿게 한다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
