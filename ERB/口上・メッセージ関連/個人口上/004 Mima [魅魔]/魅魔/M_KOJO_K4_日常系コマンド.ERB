;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K4_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K4_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「...」
		PRINTFORMDW 미마는 당신과 이야기하기를 거부한다.
		;会話不能
	ELSEIF TCVAR:302
		IF TALENT:恋慕
			IF RAND:5 == 0
				PRINTFORML 「아하하! 너무 웃기게 만들지 마!」
				PRINTFORMDW 미마는 즐겁게 당신의 이야기를 듣는다.
			ELSEIF RAND:4 == 0
				PRINTFORML 「그렇군요, 그것은 한 가지 바라보는 방법이겠네요...」
				PRINTFORMDW 미마는 감탄하며 고개를 끄덕였다.
			ELSEIF RAND:3 == 0
				PRINTFORML 「그렇게 %CALLNAME:MASTER%도 놀라울 정도로 힘든 삶을 살고 있구나...」
				PRINTFORMDW 미마는 당신의 고난에 대해 듣고 동정심을 보인다.
			ELSEIF RAND:2 == 0
				PRINTFORMDL 미마가 졸린 표정으로 당신을 바라본다.
				PRINTFORMW 「에? 응, 응, 듣고 있어.」
			ELSEIF RAND:1 == 0
				PRINTFORMDL 당신은 미마에게 자신의 삶에 대한 이야기를 해줄 수 있는지 묻는다.
				PRINTFORMW 「좋아, 그럼 내가 가장 좋아하는 제자에 대해 이야기해 줄게...」
			ENDIF
		ELSE
			PRINTFORML 「너는 너무 집요하다. 가라.」
			PRINTFORMDW 미마는 자신의 짜증을 숨기지 못하는 듯했다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「아하하! 너무 웃기게 만들지 마!」
			PRINTFORMDW 미마는 즐겁게 당신의 이야기를 듣는다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「그렇군요, 그것은 한 가지 바라보는 방법이겠네요...」
			PRINTFORMDW 미마는 감탄하며 고개를 끄덕였다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「그렇게 %CALLNAME:MASTER%도 놀라울 정도로 힘든 삶을 살고 있구나...」
			PRINTFORMDW 미마는 당신의 고난에 대해 듣고 동정심을 보인다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 미마가 졸린 표정으로 당신을 바라본다.
			PRINTFORMW 「에? 응, 응, 듣고 있어.」
		ELSEIF RAND:1 == 0
			PRINTFORMDL 당신은 미마에게 자신의 삶에 대한 이야기를 해줄 수 있는지 묻는다.
			PRINTFORMW 「좋아, 그럼 내가 가장 좋아하는 제자에 대해 이야기해 줄게...」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:5 == 0
			PRINTFORML 「너는 너무 집요해. 그렇게 나랑 이야기하고 싶니?」
			PRINTFORMDW 미마는 말에 약간 부끄러워하는 듯했다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「넌 해롭지 않아 보인다. 하지만 네가 여기서 뭘 얻을 수 있을지 모르겠어.」
			PRINTFORMDW 미마는 너를 바라보며 평가한다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「나랑 이야기하는 거 너한테 재미있어?」
			PRINTFORMW 「나는 이런 가벼운 대화에 그다지 능숙하지 않아...」
		ELSEIF RAND:2 == 0
			PRINTFORML 「알겠다...」
			PRINTFORMDW 미마는 시선을 돌리고 있지만, 적어도 당신의 말을 듣고 있는 것 같다.
		ELSEIF RAND:1 == 0
			PRINTFORML 「...」
			PRINTFORMDW 미마는 당신의 이야기를 조용히 듣는다.
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORML 「음? 왜 나한테 말하는 거야?」
			PRINTFORMDW 미마는 어리둥절해 보인다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「네 의도가 뭔지는 모르겠지만, 너무 가까이 오지 마.」
			PRINTFORMDW 미마는 다소 우울해 보인다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 미마가 짜증 섞인 한숨을 내쉰다.
			PRINTFORMW 「할 일도 없으세요?」
		ELSEIF RAND:2 == 0
			PRINTFORML 「잡담하고 싶으면 레이무랑 가서 해.」
			PRINTFORMDW 미마는 무시하듯 손을 휘저었다.
		ELSEIF RAND:1 == 0
			PRINTFORML 「뭐야, 악령 같은 건 본 적이 없다고?」
			PRINTFORMDW 미마는 토라진 표정을 짓는다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K4_301
CALL M_KOJO_MESSAGE_COM_K4_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML
	IF CFLAG:318 == 1
		PRINTFORML 「흐윽... 싫어요.」
		PRINTFORMDW 미마는 당신의 차를 조금 마시고 다시 당신에게 돌려준다.
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「분명 어떤 종류의 보상을 해줘야 할 것 같은데, 동의하지 않아?」
			PRINTFORMDW 미마는 웃으며 차를 받고 웃었다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 미마가 차를 한 모금 마신 후, 그녀는 손 중 하나로 자신의 혀를 부채질했다.
			PRINTFORMW 「너무 뜨거워...!」
		ELSEIF RAND:3 == 0
			PRINTFORML 「후우... 고마워.」
			PRINTFORMDW 미마는 우아하게 네 차를 마신다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「음... 내 취향을 아주 잘 알고 있네.」
			PRINTFORMDW 미마가 당신의 차에 대해 높이 말했어.
		ELSEIF RAND:1 == 0
			PRINTFORML 「고마워요 %CALLNAME:MASTER%.」
			PRINTFORMDW 미마는 미소를 지으며 차를 받았다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:5 == 0
			PRINTFORML 「참 배려심이 깊네. 차에 이상한 거 넣지 않았겠지?」
			PRINTFORMDW 미마는 당신의 등을 때리고 웃었다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 미마가 차를 한 모금 마신 후, 그녀는 한 손으로 자신의 혀를 부채질한다.
			PRINTFORMW 「너무 뜨거워...!」
		ELSEIF RAND:3 == 0
			PRINTFORML 「고마워, 목말랐어.」
			PRINTFORMDW 미마는 차를 받고 한 번에 모두 마셨다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「음, 그럭저럭 마실 만하군.」
			PRINTFORMDW 미마는 차의 맛에 만족하는 듯했다.
		ELSEIF RAND:1 == 0
			PRINTFORML 「오, 정말 다정하시네요.」
			PRINTFORMDW 미마는 기쁘게 차를 받는다.
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORML 「꿀꺽... 꿀꺽...」
			PRINTFORMDW 미마는 재빨리 차를 마시고 당신에게 컵을 돌려준다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 미마가 차를 한 모금 마신 후, 그녀는 한 손으로 자신의 혀를 부채질한다.
			PRINTFORMW 「너무 뜨거워...!」
		ELSEIF RAND:3 == 0
			PRINTFORML 「이상한 거 차에 넣지 않았겠지?」
			PRINTFORMDW 미마는 의심스러운 눈으로 당신을 바라보며 차를 마셨다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「... 내 취향에 맞지 않아.」
			PRINTFORMDW 미마는 차의 맛에 대해 불평한다.
		ELSEIF RAND:1 == 0
			PRINTFORML 「꿀꺽...」
			PRINTFORMDW 미마는 조용히 차를 마신다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K4_302
CALL M_KOJO_MESSAGE_COM_K4_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML
	IF CFLAG:318 == 1
		PRINTFORML 「만지지 마...!」
		PRINTFORMDW 미마가 너에게 죽을 듯한 눈빛을 보낸다.
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「아, 그건...!」
			PRINTFORMDW 미마는 당신의 성적인 접근에 개의치 않는 것 같다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「살아있는 몸을 만지는 것과 다르게 느껴지니?」
			PRINTFORMDW 미마의 정신적인 부분을 네가 만진다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 미마에게 가까이 다가갈수록 그녀는 몸을 당신에게 더 가깝게 움직인다.
			PRINTFORMW 「응? 후후...♪」
		ELSEIF RAND:2 == 0
			PRINTFORML 「우후우... 거기 주변에 너무 많이 만지지 마...」
			PRINTFORMDW 당신은 미마의 몸을 만진다.
		ELSEIF RAND:1 == 0
			PRINTFORML 「나를 만지고 싶니? 어쩔 수 없겠지...」
			PRINTFORMDW 미마는 당신의 스킨십을 즐긴다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:5 == 0
			PRINTFORML 「너무 가까워지고 있어.」
			PRINTFORMDW 미마는 당신이 팔 길이 안에 들어오자 초조해 보인다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 미마는 당신이 그녀의 영적인 부분을 만지려고 할 때 속상해한다.
			PRINTFORMW 「무엇을 만지려고 한다고 생각하는 거니?」
		ELSEIF RAND:3 == 0
			PRINTFORML 「나에게 너무 집착하지 마.」
			PRINTFORMDW 미마는 불평하지만, 별다른 저항은 하지 않는다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「누가 네가 나를 만져도 된다고 했지?」
			PRINTFORMDW 미마는 당신의 손을 떼어낸다.
		ELSEIF RAND:1 == 0
			PRINTFORML 「정말로, 너한테 이게 재미있긴 해?」
			PRINTFORMDW 미마는 불편하게 머리를 긁적인다.
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORML 「누군가를 만지고 싶다면, 이무(Reimu)를 건드려라.」
			PRINTFORMDW 미마는 당신을 무례하게 거절했다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「더 가까이 오지 마.」
			PRINTFORMDW 미마는 당신에게서 멀어지려고 노력한다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「잠깐, 어디를 만지고 있다고 생각하는 거야.」
			PRINTFORMDW 미마는 당신의 손을 잡고 엄한 눈빛으로 바라본다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 미마가 차가운 시선으로 당신을 바라보는데, 당신이 그녀를 만지려 한다.
			PRINTFORMW 「내 팔을 자르면 불평하지 마라.」
		ELSEIF RAND:1 == 0
			PRINTFORML 「내 몸에 손대지 마.」
			PRINTFORMDW 미마는 당신의 손에서 멀리 뛰어오른다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
