;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K4_303
CALL M_KOJO_MESSAGE_COM_K4_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0,1,2
			IF TALENT:恋慕
				PRINTFORML 「... 이해한다...」
				PRINTFORML 「고개를 들어라, 용서하겠다.」
				PRINTFORMDW 미마가 당신에게 동정 어린 눈빛을 보내며 당신을 용서한다.
			ELSEIF TALENT:思慕
				PRINTFORML 「하아... 어쩔 수 없지.」
				PRINTFORMDW 미마는 한숨을 내쉬며 당신을 용서한다.
			ELSE
				PRINTFORML 「... 같은 실수를 두 번 하지 마라.」
				PRINTFORMDW 미마는 당신에게서 시선을 돌리며 이렇게 말한다.
			ENDIF
		CASEELSE
			IF TALENT:恋慕
				PRINTFORML 「죄송해요 %CALLNAME:MASTER%, 하지만 당신을 용서할 수 없어요.」
				PRINTFORMDW 미마는 미간을 찌푸리고 당신을 내려다본다.
			ELSEIF TALENT:思慕
				PRINTFORML 「흥흡.」
				PRINTFORMDW 미마는 화가 나서 시선을 돌린다.
			ELSE
				PRINTFORML 「칫...」
				PRINTFORMDW 미마는 혀를 차며 당신을 무시한다.
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;304,仕事を手伝う
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:350(仕事内容(JOB_仕事内容.ERB参照のこと
;TCVAR:手伝えない(=2 手伝っても早くは終わらない、時間停止中不可 永琳の診察等)
;==================================================

@M_KOJO_MESSAGE_COM_K4_304
CALL M_KOJO_MESSAGE_COM_K4_304_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_304_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		;通常
		PRINTFORML
	ELSE
		IF CFLAG:318 == 1
			PRINTFORML 「다른 할 일도 없으세요?」
			PRINTFORMDW 미마는 이 말을 한 뒤 당신을 노려본다.
		ELSEIF TALENT:恋慕
			IF RAND:5 == 0
				PRINTFORML 「원할 때 언제든지 나를 도와주러 와.」
				PRINTFORMDW 미마는 수줍게 당신의 손을 잡는다.
			ELSEIF RAND:4 == 0
				PRINTFORML 「당신의 움직임은 훌륭하네요.」
				PRINTFORMDW 미마는 당신의 실력에 감명받았다.
			ELSEIF RAND:3 == 0
				PRINTFORML 「자, 수고한 것에 대한 보답이야.」
				PRINTFORMDW 미마가 너에게 돈을 건넨다.
				;added
				CALL GET_MONEY_YEN(RAND(100, 1001), 2)
			ELSEIF RAND:2 == 0
				PRINTFORML 「도와주러 와줘서 기뻐...」
				PRINTFORMDW 미마는 당신에게 고맙다고 말하며 홍당무처럼 얼굴을 붉힌다.
			ELSEIF RAND:1 == 0
				PRINTFORML 「고마워 %CALLNAME:MASTER%, 나 좀 도와줬어.」
				PRINTFORMDW 미마가 감사를 표한다.
			ENDIF
		ELSEIF TALENT:思慕
			IF RAND:5 == 0
				PRINTFORML 「나를 도와주러 왔는데, 변했네.」
				PRINTFORMDW 미마는 행복하게 당신을 바라본다.
			ELSEIF RAND:4 == 0
				PRINTFORML 「너 이쪽 일을 점점 잘하게 되고 있어.」
				PRINTFORMDW 미마가 당신의 움직임을 평가한다.
			ELSEIF RAND:3 == 0
				PRINTFORML 「여기, 이것으로 충분해?」
				PRINTFORMDW 미마가 당신에게 돈을 건넨다.
				;added
				CALL GET_MONEY_YEN(RAND(10, 101), 2)
			ELSEIF RAND:2 == 0
				PRINTFORML 「아니, 별로 상관없어.」
				PRINTFORMDW 미마가 희미하게 미소 짓는다.
			ELSEIF RAND:1 == 0
				PRINTFORML 「도와주겠니?」
				PRINTFORMDW 미마는 당신의 도움에 고마워하는 것 같다.
			ENDIF
		ELSE
			IF RAND:5 == 0
				PRINTFORML 「좀 더 열심히 일할 수 있겠어?」
				PRINTFORMDW 미마는 당신에게 가혹하지만 정직한 조언을 건넨다.
			ELSEIF RAND:4 == 0
				PRINTFORML 「돈이 필요하면 인간 마을로 가라.」
