LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORMW 「기분 좋게 해 줄게요 %CALLNAME:MASTER%, 편하게 지내 볼까요?」
			PRINTFORMDW 미마는 69 자세에서 당신을 자신의 가슴골 사이에 위치시킨다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMDL 당신은 그녀의 허리를 감싸 안은 채 미마의 은밀한 곳을 핥기 시작했다.
			PRINTFORML 「아, 좋아! 정말 좋다.」
			PRINTFORMDW 그 대가로 미마는 가슴 사이에 당신의 성기를 강하게 조였다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「이봐, 지금은 쉴 때가 아니야.」
			PRINTFORMDL 미마는 당신에게 짜증을 느끼며 소외감을 느낀다.
			PRINTFORMDW 당신은 보상하기 위해 그녀의 은밀한 곳에 혀를 넣는다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「우으... 흠...」
			PRINTFORMDL 미마는 당신을 즐겁게 해주던 것을 잠시 멈추고 당신의 엉덩이를 때린다.
			PRINTFORMDW 놀란 영혼은 소리를 지르며 가슴과 입으로 그 남성의 성기를 다시 즐겁게 해준다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「하아... 하아... 후우...」
			PRINTFORMDL 미마는 계속 가슴을 만지며 땀을 흘린다.
			PRINTFORMDW 너는 그녀가 네 성기를 즐기는 동안 영혼에게 구강성교를 해준다.
		ELSE
			PRINTFORML 「음... 끅...」
			PRINTFORMDL 미마는 구강성애로 인한 쾌락에 저항하려 한다.
			PRINTFORMDW 미마가 가슴으로 당신의 성기를 움켜쥐자, 당신은 그 쾌락에 약해지기 시작한다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
