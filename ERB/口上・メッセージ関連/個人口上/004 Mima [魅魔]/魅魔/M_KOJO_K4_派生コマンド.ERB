@M_KOJO_MESSAGE_SCOM_K4_6
CALL M_KOJO_MESSAGE_SCOM_K4_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K4_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORMW 「흐으아악! 아아아앗!」
			PRINTFORMDW 미마가 G스팟을 자극당하며 크게 신음했다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	PRINTFORML
	IF FLAG:70
		PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;対面立位
		IF PREVCOM == 60 && TFLAG:193
			IF RAND:5 == 0
				PRINTFORMDL 당신은 미마의 안에 자신의 성기를 삽입한다.
				PRINTFORMDL 미마는 당신이 그녀의 질을 더 쉽게 자극할 수 있도록 다리를 벌린다.
				PRINTFORMDW 둘 다 즐거움이 커지자, 당신은 몸을 위아래로 움직인다.
			ELSEIF RAND:4 == 0
				PRINTFORML 「우으음%UNICODE(0x2665)% 우웅%UNICODE(0x2665)%크으응%UNICODE(0x2665)%」
				PRINTFORMDL 미마의 몸이 살짝 떠오르자 당신을 끌어안는다.
				PRINTFORMDW 당신은 그녀를 안은 채 필사적으로 골반을 움직였다.
			ELSEIF RAND:3 == 0
				PRINTFORMDL 당신의 성기가 정령의 질 뒷부분을 강렬하게 문지른다.
				PRINTFORML 「아아! 정말 좋다%UNICODE(0x2665)%」
				PRINTFORMDW 당신은 허리와 골반을 앞뒤로 계속 흔든다.
			ELSEIF RAND:2 == 0
				PRINTFORML 「%CALLNAME:MASTER%%UNICODE(0x2665)% 기분이 좋아...%UNICODE(0x2665)% 기분이 좋아...%UNICODE(0x2665)%」
				PRINTFORMDL 미마는 당신의 등에 손을 올리고 계속해서 당신의 이름을 중얼거린다.
				PRINTFORMDW 두 사람은 그 순간을 마음껏 즐긴다.
			ELSE
				PRINTFORML 「아아%UNICODE(0x2665)% 아아%UNICODE(0x2665)% 놀라워%UNICODE(0x2665)%」
				PRINTFORMDL 당신의 치고는 그녀의 자궁경부에 끊임없이 도달한다.
				PRINTFORMDW 당신은 그녀의 허벅지 하나를 들어 올린 채 미마에게 여러 번 침투한다.
			ENDIF
			;正常位
		ELSEIF PREVCOM == 60
			IF RAND:5 == 0
				PRINTFORMDL 당신은 그녀와 관계를 가지면서 미마의 손을 잡는다.
				PRINTFORMDL 미마는 당신의 손가락과 자신의 손가락을 얽는다.
				PRINTFORMDW 두 사람은 서로 연결되어 침묵 속에서 사랑을 나눈다.
			ELSEIF RAND:4 == 0
				PRINTFORMDL 당신의 추동음이 그 공간에 울려 퍼졌다.
				PRINTFORML 「야아%UNICODE(0x2665)% 아%UNICODE(0x2665)% 아느%UNICODE(0x2665)% 푸와아%UNICODE(0x2665)%」
				PRINTFORMDW 당신과 미나는 교합으로 인해 땀으로 흠뻑 젖었다.
			ELSEIF RAND:3 == 0
				PRINTFORML 「츄... %UNICODE(0x2665)% 음므... %UNICODE(0x2665)% 치유... %UNICODE(0x2665)%」
				PRINTFORMDL 당신과 미마는 미션너리 자세로 섹스하면서 키스를 한다.
				PRINTFORMDW 당신은 서로 입으로 위로하며 점점 더 흥분한다.
			ELSEIF RAND:2 == 0
				PRINTFORML 「%CALLNAME:MASTER%%UNICODE(0x2665)%　나는- %UNICODE(0x2665)% 사랑한다」
				PRINTFORMDL 미마의 질이 당신을 단단히 조인다.
				PRINTFORMDW 당신은 페니스를 앞뒤로 움직여 그녀를 떨게 한다.
			ELSE
				PRINTFORML 「아아%UNICODE(0x2665)% 더%UNICODE(0x2665)% 더%UNICODE(0x2665)%」
				PRINTFORMDL 미마는 당신이 깊숙이 박자 미쳐버릴 것 같다.
				PRINTFORMDW 당신은 절정에 이르기 위해 골반을 더욱 빠르게 흔든다.
			ENDIF
			;背面立位
		ELSEIF PREVCOM == 61 && TFLAG:193
			IF RAND:5 == 0
				PRINTFORML 「우으...%UNICODE(0x2665)% 응%UNICODE(0x2665)% 으음%UNICODE(0x2665)%」
				PRINTFORMDL 미마는 뒤에서 침범당하며 큰 쾌감을 느낀다.
				PRINTFORMDW 너는 끊임없이 네 성기를 앞뒤로 움직인다.
			ELSEIF RAND:4 == 0
				PRINTFORMDL 당신은 미마의 허리에 손을 대고 골반을 밀어붙이기 시작한다.
				PRINTFORML 「하아... %UNICODE(0x2665)% 응... %UNICODE(0x2665)% 음... %UNICODE(0x2665)%」
				PRINTFORMDW 미마는 뒤에서 몰리는 동안 부드럽게 당신의 손을 어루만진다.
			ELSEIF RAND:3 == 0
				PRINTFORMDL 당신은 뒤에서 미마의 가슴을 어루만진다.
				PRINTFORML 「아앗! 저기요!」
				PRINTFORMDW 당신이 그녀의 인상적인 가슴을 어루만지는 동안 미마는 몰린다. 
			ELSEIF RAND:2 == 0
				PRINTFORML 「캬아-앗 %UNICODE(0x2665)% 더(More) %UNICODE(0x2665)%」
				PRINTFORMDL 너는 미마의 질 안에서 네 성기를 앞뒤로 밀어 넣는다.
				PRINTFORMDW 그녀의 목소리는 떨리고, 너희의 골반이 끊임없이 부딪힌다.
			ELSE
				PRINTFORML 「아아%UNICODE(0x2665)% 흐응%UNICODE(0x2665)% 나아～%UNICODE(0x2665)%」
				PRINTFORMDL 미마의 목소리가 당신의 단단한 것이 뒤에서 그녀를 찔러댈 때 천천히 높아진다.
				PRINTFORMDW 그녀는 당신의 모든 추동 후에 신음한다.
			ENDIF
			;後背位
		ELSEIF PREVCOM == 61
			IF RAND:5 == 0
				PRINTFORML 「%CALLNAME:MASTER%, 나 때리지 마...」
				PRINTFORMDL 미마의 말을 무시하고 그녀의 엉덩이를 계속 때린다.
				PRINTFORMW 「우응%UNICODE(0x2665)% 그만해... %UNICODE(0x2665)%」
			ELSEIF RAND:4 == 0
				PRINTFORML 「후우... %UNICODE(0x2665)% 정말 기분 좋아, 정말 좋아... %UNICODE(0x2665)%」
				PRINTFORMDL 그녀의 몸은 황홀경 속에서 떨리고 단단해진 질이 당신을 조여온다.
				PRINTFORMDW 당신은 황홀한 악마(Evil Spirit)에게 계속 사랑을 베푼다.
			ELSEIF RAND:3 == 0
				PRINTFORMDL 미마의 무거운 가슴이 당신의 손에 의해 들린다.
				PRINTFORML 「아, 내 가슴을 더럽게 가지고 놀고 있네」
				PRINTFORMDW 당신은 허리를 흔들면서 손으로 영혼의 가슴을 즐긴다.
			ELSEIF RAND:2 == 0
				PRINTFORMDL 당신은 허리를 앞뒤로 움직이며 그녀의 보지 안에서 미마의 엉덩이를 마사지한다.
				PRINTFORML 「안 돼...%UNICODE(0x2665)% 내 엉덩이 만지지 말아줘...%UNICODE(0x2665)%」
				PRINTFORMDW 미마의 소망을 무시하고, 당신은 그녀와 사랑을 나누면서 계속해서 그녀의 엉덩이를 어루만진다.
			ELSE
				PRINTFORML 「으응%UNICODE(0x2665)% 우우%UNICODE(0x2665)% 너무 강하게%UNICODE(0x2665)% 아아%UNICODE(0x2665)%」
				PRINTFORMDL 당신은 네 발로 있는 미마에게 거칠게 당신의 성기를 삽입한다.
				PRINTFORMDW 속도가 붙자, 정령의 거대한 가슴이 앞뒤로 출렁인다.
			ENDIF
			;騎乗位
		ELSEIF PREVCOM == 65
			IF RAND:5 == 0
				PRINTFORMDL 당신은 골반을 움직여 위아래로 흔들리는 미마의 자궁을 찌른다.
				PRINTFORML 「응! 응, %CALLNAME:MASTER%너도 골반을 움직여...%UNICODE(0x2665)%」
				PRINTFORMDW 당신이 골반을 움직일 때마다 그녀의 가슴은 떨리고 그녀는 웃는다.
			ELSEIF RAND:4 == 0
				PRINTFORML 「이봐 %UNICODE(0x2665)% 저것 좀 봐%UNICODE(0x2665)%」
				PRINTFORMDL 미마는 당신이 그녀의 질을 더 잘 볼 수 있도록 자세를 잡았다.
				PRINTFORMDW 그녀의 질은 당신의 성기를 삼킬 때마다 연모즙을 반복해서 흘린다.
			ELSEIF RAND:3 == 0
				PRINTFORML 「이거 어때...%UNICODE(0x2665)%」
