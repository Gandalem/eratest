@M_KOJO_MESSAGE_SCOM_K4_1
CALL M_KOJO_MESSAGE_SCOM_K4_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K4_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORMW 「헤이 %CALLNAME:MASTER%, 서로 맛을 보는 건 어때?」
			PRINTFORMDW 미마와 너는 반대 방향으로 누워 상대방의 성기를 핥기 시작한다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMDL 두 분은 미친 듯이 서로를 빨아댄다.
			PRINTFORMDL 미마가 제공하는 쾌감에 감사하며, 당신은 그녀의 비밀스러운 곳을 핥는다.
			PRINTFORMDW 미마는 응답으로 당신의 성기를 사랑스럽게 핥았다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「후우음...%UNICODE(0x2665)% 우으음...%UNICODE(0x2665)%」
			PRINTFORMDL 미마가 갑자기 구강성애를 중단하고 당신이 그녀를 핥을 때 뒤돌아본다.
			PRINTFORMDW 당신이 가볍게 그녀의 엉덩이를 때리자, 그녀는 반응하며 블로우잡이 다시 시작된다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 미마가 당신을 빨고 있을 때 갑자기 구강성교를 중단한다.
			PRINTFORML 「츄읍... 이봐 %CALLNAME:MASTER%, 너도 나를 핥아야 해.」
			PRINTFORMDW 당신은 혀를 내밀어 영혼에게 다시 주의를 기울인다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 당신은 혀끝으로 미마의 음핵을 간지럽힌다.
			PRINTFORML 「히유우%UNICODE(0x2665)% 으음... 간지러워...」
			PRINTFORMDW 미마는 마치 당신과 경쟁하듯 당신의 귀두를 핥는다.
		ELSE
			PRINTFORML 「음... 축축... 츄읍...」
			PRINTFORMDL 미마는 당신의 페니스를 빨면서 쓰다듬는다.
			PRINTFORMDW 뒤처지고 싶지 않아, 당신의 혀는 미마의 은밀한 곳 안으로 기어들어 갔다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K4_{SELECTCOM}_1
RETURN 1
