@M_KOJO_MESSAGE_SCOM_K4_5
CALL M_KOJO_MESSAGE_SCOM_K4_5_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K4_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORMDW 미마가 한 손으로 당신의 것을 잡고 몇 번 핥는다.
			PRINTFORMDW 당신은 받고 있는 쾌감에 땀을 흘린다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「음프... 음흣...」
			PRINTFORMDL 미마는 손바닥으로 귀두를 문지르며 막을 핥는다.
			PRINTFORMDW 너의 성기 밑부분은 그녀의 다른 손에 잡혀 있다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「츄우... 츄우...」
			PRINTFORMDL 미마는 귀두를 입에 넣고 손으로 페니스를 쓰다듬는다.
			PRINTFORMDW 당신의 페니스가 쾌감에 움찔거린다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 미마가 네 성기를 입에 넣은 채 다른 손으로 고환을 마사지한다.
			PRINTFORML 「음큭... 쭉... 음프...」
			PRINTFORMDW 영혼의 손가락이 너의 고환을 부드럽게 마사지했다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「하암푸우...」
			PRINTFORMDL 미마는 당신의 고환을 핥으면서 음경을 쓰다듬는다.
			PRINTFORMDW 그녀는 자신의 혀로 당신의 주머니를 가지고 놀면서 엄지손가락으로 귀두를 간지럽힌다.
		ELSE
			PRINTFORML 「흡... 음프...」
			PRINTFORMDL 미마는 손가락으로 기둥을 어루만지면서 귀두를 핥는다.
			PRINTFORMDW 당신의 성기가 쾌감에 움찔거릴 때, 미마는 위쪽을 바라본다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
