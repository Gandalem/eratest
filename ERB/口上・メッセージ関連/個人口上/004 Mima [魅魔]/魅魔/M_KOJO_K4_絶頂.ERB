;-------------------------------------------------
;射精に関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K4_0
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K4_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;対面立位
	IF SELECTCOM == 60 && TFLAG:193
		IF RAND:5 == 0
			PRINTFORML 「음... 사정했어?」
			PRINTFORMDL 미마가 당신을 가까이서 보며 묻는다.
			PRINTFORMDW 당신은 성기를 빼서 가득 찬 콘돔을 미마에게 보여준다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 당신은 %HIS_HER(4)% 질에서 당신의 성기를 빼낸다.
			PRINTFORML 「아흐%UNICODE(0x2665)% 후후%UNICODE(0x2665)%」
			PRINTFORMDW 미마는 콘돔이 완전히 가득 찼음을 확인한 뒤, 당신을 껴안는다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「%CALLNAME:MASTER%, 나를 조금 더 안아줘...」
			PRINTFORMDL 마마는 당신의 성기가 아직 %HIS_HER(4)% 안에 있는 동안 당신을 끌어안는다.
			PRINTFORMDW 당신의 팔은 마마의 허리를 감싸고, 당신의 귀두는 %HIS_HER(4)% 자궁 입구에 키스한다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 미마가 당신이 안에서 사정할 때 부드럽게 당신을 껴안았다 %HIS_HER(4)%.
			PRINTFORML 「괜찮아, 괜찮아...%UNICODE(0x2665)% 그건 그냥 조금 아팠던 거야...%UNICODE(0x2665)%」
			PRINTFORMDW 당신은 사정을 멈출 때까지 미마를 끌어안았다.
		ELSE
			PRINTFORMDL 정액이 당신의 음경에서 흘러나온다.
			PRINTFORMDL 콘돔이 제 역할을 한 것 같다.
			PRINTFORMW 「아... 사정했구나...%UNICODE(0x2665)%」
		ENDIF
		;正常位
	ELSEIF SELECTCOM == 60
		IF RAND:5 == 0
			PRINTFORMDL 음경이 이완되면 빼낸다.
			PRINTFORMDL 미마는 콘돔 안의 정액을 %HIS_HER(4)% 손가락으로 휘젓는다.
			PRINTFORMW 「너무 끈적해...」
		ELSEIF RAND:4 == 0
			PRINTFORMDL 중간 사정 중, 당신은 미마에게 키스한다.
			PRINTFORML 「츄우... 기분 좋았어?」
			PRINTFORMDW 당신의 성기에서 정액이 더욱 흘러나오고, 미마는 %HE_SHE(4)% 웃으며 얼굴이 붉어진다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「아아%UNICODE(0x2665)% 떨리고 있어%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 당신의 페니스가 안에서 사정하는 것을 느끼며 신음한다.
			PRINTFORMDW 당신은 허리를 움직여 더 깊이 밀어 넣었고, 다행히 콘돔이 모든 방울을 받아냈다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 당신은 절정에 이르면서 미마의 손을 잡는다.
			PRINTFORML 「응ㄴ%UNICODE(0x2665)% 뜨거워...%UNICODE(0x2665)%」
			PRINTFORMDW 콘돔이 당신의 정액으로 부풀어 오른다.
		ELSE
			PRINTFORML 「후우...%UNICODE(0x2665)% 후우...%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 눈물을 글썽이며 %HIS_HER(4)% 은밀한 곳을 내려다본다.
			PRINTFORMDW 당신의 정액은 콘돔에 의해 수집되었다.
		ENDIF
		;背面立位
	ELSEIF SELECTCOM == 61 && TFLAG:193
		IF RAND:5 == 0
			PRINTFORML 「...%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 당신의 페니스가 %HIS_HER(4)% 몸 안에서 움찔거리는 동안 눈을 감는다.
			PRINTFORMDW 당신은 뒤에서 그 영혼을 꼭 안았다.
		ELSEIF RAND:4 == 0
			PRINTFORMDL 사정하고 나면 미마의 부드러운 유두를 마사지한다.
			PRINTFORML 「기다려라%UNICODE(0x2665)%　%CALLNAME:MASTER%, 조금만 기다려라%UNICODE(0x2665)%」
			PRINTFORMDW 정령의 질은 쾌감에 반응하며 너의 이완된 페니스를 조인다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「크윽! ...후우...%UNICODE(0x2665)%」
			PRINTFORMDL 미마가 그것의 밑부분에서 당신의 성기를 잡고 뽑아낸다.
			PRINTFORMDW 작은 콘돔 끝이 정액으로 채워지면서 부풀어 오른다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 당신이 꺼내서 미마에게 부풀어 오른 콘돔을 보여준다.
			PRINTFORML 「와, 굉장해.」
			PRINTFORMDW 미마는 %HE_SHE(4)%이 콘돔 안의 정액 양을 감상하는 것을 보고 놀란 표정을 짓는다.
		ELSE
			PRINTFORMDL 미마의 온몸이 당신의 거기로 인한 쾌감의 물결에 휩싸인다.
			PRINTFORMDL 힘이 다해가는 당신은 미마에게 매달린다.
			PRINTFORMW 「너무 기분이 좋아%UNICODE(0x2665)% 떨림을 멈출 수가 없어%UNICODE(0x2665)%」
		ENDIF
		;後背位
	ELSEIF SELECTCOM == 61
		IF RAND:5 == 0
			PRINTFORMDL 영혼의 질에서 빠져나오면서 당신의 성기가 방울방울 떨린다.
			PRINTFORMDL 미마는 %HIS_HER(4)% 사타구니를 잡고 뒤돌아 축 늘어진 성기를 바라본다.
			PRINTFORMW 「또 단단해지고 있어...%UNICODE(0x2665)%」
		ELSEIF RAND:4 == 0
			PRINTFORMDL 당신은 미마의 허리를 붙잡고 안에 사정한다 %HIS_HER(4)%.
			PRINTFORMDL 당신의 골반이 부드럽게 미마의 뒤를 스치며, 당신의 성기가 안에서 떨린다 %HIS_HER(4)%.
			PRINTFORMW 「와아%UNICODE(0x2665)% 음, 후우%UNICODE(0x2665)%」
