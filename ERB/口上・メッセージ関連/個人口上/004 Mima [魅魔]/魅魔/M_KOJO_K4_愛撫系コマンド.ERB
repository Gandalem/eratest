@M_KOJO_MESSAGE_COM_K4_0
CALL M_KOJO_MESSAGE_COM_K4_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「나를 만지고 싶어?」
			PRINTFORMDW 미마의 양쪽 다리를 벌리고 그녀의 사타구니 쪽으로 손을 뻗는다.
			PRINTFORMW 「응...%UNICODE(0x2665)% 나에게 상냥하게 대해줄래...?」
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「하아... 하아...%UNICODE(0x2665)%」
			PRINTFORMDL 미마의 은밀한 곳을 쓰다듬기 시작하면 그녀는 신음을 내기 시작한다.
			PRINTFORMW 「응...%UNICODE(0x2665)% 후우...%UNICODE(0x2665)%」
		ELSEIF RAND:4 == 0
			PRINTFORML 「절대 퍼뜨리지 마!」
			PRINTFORMDL 그녀의 다리를 벌리자, 미마는 숨을 들이키며 재빨리 손으로 자신의 은밀한 곳을 가린다.
			PRINTFORMW 「보지 마!」
		ELSEIF RAND:3 == 0
			PRINTFORMDL 당신은 그녀의 가랑이에 손을 대고 위아래로 움직인다.
			PRINTFORML 「아아%UNICODE(0x2665)% 아아%UNICODE(0x2665)% 야아%UNICODE(0x2665)%」
			PRINTFORMDW 미마는 다리를 올리고 신음한다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「아아...%UNICODE(0x2665)% 후우아아...%UNICODE(0x2665)%」
			PRINTFORMDL 당신은 그녀의 성기를 피하며 영혼의 허벅지를 쓸어내렸다.
			PRINTFORMW 「으음... 너무 잔인해...%UNICODE(0x2665)%」
		ELSE
			PRINTFORMDL 당신은 미마의 성기에 손을 대고 마사지한다.
			PRINTFORML 「음... %UNICODE(0x2665)% 후우... %UNICODE(0x2665)%」
			PRINTFORMW 「그게... %UNICODE(0x2665)% 아아 %UNICODE(0x2665)% 안 돼... %UNICODE(0x2665)%」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
