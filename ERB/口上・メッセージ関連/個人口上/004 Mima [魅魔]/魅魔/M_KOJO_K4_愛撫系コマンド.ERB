@M_KOJO_MESSAGE_COM_K4_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMDW 미마는 기대하는 표정으로 당신을 바라본다.
			PRINTFORMW 「다른 사람에게 핥아지는 게 정말 기분 좋아..♪」
			PRINTFORMDW 당신이 그녀의 다리 사이에 머리를 넣고 입구(입장)를 핥자, 영혼이 기쁨에 비명을 지른다.
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORML 「야아%UNICODE(0x2665)% 퍼지네...%UNICODE(0x2665)%」
			PRINTFORMDL 미마가 다리를 벌리자, 당신은 혀로 그녀의 입구를 애무한다.
			PRINTFORMW 「히야아%UNICODE(0x2665)% 이야아%UNICODE(0x2665)% 후우프..%UNICODE(0x2665)%」
		ELSEIF RAND:4 == 0
			PRINTFORMDL 당신은 그녀를 핥으면서 미마를 올려다본다.
			PRINTFORML 「음...%UNICODE(0x2665)% 너무 기분 좋아..%UNICODE(0x2665)%」
			PRINTFORMDW 그녀가 뒤돌아보자 당신은 다시 그녀의 클리토리스를 핥기 시작한다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「아아아%UNICODE(0x2665)% 이이야아%UNICODE(0x2665)%」
			PRINTFORMDL 당신은 입으로 미마의 음핵을 빨고, 영혼이 크게 신음하게 만든다.
			PRINTFORMW 「그건 %UNICODE(0x2665)% 안 돼%UNICODE(0x2665)% 아하아%UNICODE(0x2665)%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「하아%UNICODE(0x2665)% 하아%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 눈에 눈물을 글썽이며 당신의 머리를 쓰다듬는다.
			PRINTFORMDW 당신이 그녀의 입안을 더 깊숙이 핥기 시작하자, 그녀의 골반이 움찔거린다.
		ELSE
			PRINTFORML 「저기에... %UNICODE(0x2665)% 바로 저기... %UNICODE(0x2665)%」
			PRINTFORMDL 미마가 당신에게 핥기를 원하는 곳을 가리킨다.
			PRINTFORMW 「아아... %UNICODE(0x2665)% 거기... 정말 맛있다... %UNICODE(0x2665)%」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
