IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF TALENT:恋慕
			IF RAND:5 == 0
				PRINTFORML 「헤헤...♪ 이봐, 한 번 더...」
