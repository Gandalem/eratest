@M_KOJO_MESSAGE_COM_K4_80
CALL M_KOJO_MESSAGE_COM_K4_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K4_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「워아... 단단해지는구나...」
			PRINTFORMDW 미마가 손으로 당신의 성기를 잡았다.
			PRINTFORMW 「내가 손을 써서 그를 기분 좋게 해줄까?」
			PRINTFORMDW 당신이 고개를 끄덕이자 미마가 미소를 지었다.
			PRINTFORMW 「좋아...♪ 레이디 미마에게 맡겨줘♪」
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMDL 사악한 영혼의 서비스 덕분에, 너는 이미 애액을 흘리기 시작한다.
			PRINTFORML 「오후후후...」
			PRINTFORMDW 미마의 검지 손가락 끝은 하얗게 물들어 있다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「기분 좋다...%UNICODE(0x2665)%」
			PRINTFORMDL 미마가 당신의 성기를 움켜쥐고 자극한다.
			PRINTFORMDW 그녀의 수음 기술이 당신의 고환을 떨게 만든다.
		ELSEIF RAND:3 == 0
			PRINTFORML 「쿠치-쿠우...♪」
			PRINTFORMDL 미마는 다섯 손가락으로 분비선을 문지른다.
			PRINTFORMDW 이 간질거리는 감각은 당신에게 강렬한 쾌감을 준다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 미마의 손에 당신의 음낭이 만족한다.
			PRINTFORML 「이곳도 모종의 사랑을 받을 자격이 있어...%UNICODE(0x2665)%」
			PRINTFORMDW 미마의 한 손은 당신의 주머니를 마사지하고 다른 한 손은 단단해진 성기를 만족시킨다.
		ELSE
			PRINTFORML 「여기 어때?」
			PRINTFORMDL 미마는 손으로 당신의 성기를 잡고 위아래로 만지며 다룬다.
			PRINTFORMW 「오오, 지금 반응이 좋네%UNICODE(0x2665)%」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
