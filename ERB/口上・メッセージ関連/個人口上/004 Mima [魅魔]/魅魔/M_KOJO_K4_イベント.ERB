@M_KOJO_EVENT_K4_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		PRINTFORML
		IF CFLAG:318 == 1
			PRINTFORML 「무엇을 원하는 거지?」
			PRINTFORMDW 미마가 눈살을 찌푸렸다.
		ELSEIF TALENT:恋人
			PRINTFORML 「아, %조사처리(CALLNAME:MASTER,"가")% 아니면.」
			PRINTFORMDW 미마는 기쁘게 미소 짓는다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「안녕, %CALLNAME:MASTER%.」
			PRINTFORMDW 미마가 따뜻하게 당신을 맞이한다.
		ELSEIF TALENT:思慕
			PRINTFORML 「오, 너였구나.」
			PRINTFORMDW 미마가 당신을 알아채면 잠시 인사를 건넨다.
		ELSE
			PRINTFORMDW 미마가 당신을 흘긋 보더니 다른 곳으로 시선을 돌렸다.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		IF CFLAG:318 == 1
			PRINTFORML 「...」
			PRINTFORMDW 미마는 당신을 완전히 무시한다.
		ELSEIF TALENT:恋人
			PRINTFORML 「아, %조사처리(CALLNAME:MASTER,"가")% 아니면.」
			PRINTFORMDW 미마는 기쁘게 미소 짓는다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「안녕, %CALLNAME:MASTER%.」
			PRINTFORMDW 미마가 따뜻하게 당신을 맞이한다.
		ELSEIF TALENT:思慕
			PRINTFORML 「오, 너였구나.」
			PRINTFORMDW 미마가 당신을 알아채면 잠시 인사를 건넨다.
		ELSE
			PRINTFORMDW 미마가 당신을 흘긋 보더니 다른 곳으로 시선을 돌렸다.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		IF CFLAG:318 == 1
			PRINTFORML 「...」
			PRINTFORMDW 미마는 당신을 완전히 무시한다.
		ELSEIF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%, 내가 합류해도 괜찮아?」
			PRINTFORMDW 미마가 당신 옆에 앉아 풍만한 몸을 드러낸다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「들어갈게.」
			PRINTFORMDW 미마는 작은 수건으로 자신의 풍만한 몸을 가리려 욕조 안으로 발을 들인다.
		ELSEIF TALENT:思慕
			PRINTFORML 「좀 비켜봐.」
			PRINTFORMDW 미마가 당신과 함께 욕조에 들어오자 당신은 조금 걱정스러운 기분이 들었다.
		ELSE
			PRINTFORML 「좀 비켜줘.」
			PRINTFORMDW 미마가 당신의 존재를 무시하며 욕실로 들어온다.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
