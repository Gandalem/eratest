@M_KOJO_SPEVENT_K4_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTFORML
	PRINTFORMW 「흐-흠, 잠깐만 기다려줘...」
	PRINTFORMDW 집에 돌아가는 길에 뒤에 서 있는 미마에게 불린다.
	PRINTFORMDW 뒤돌아보자 미마가 눈을 똑바로 응시하고 있었다.
	PRINTFORMW 「오늘 데이트 정말 즐거웠으니까...」
	PRINTFORMW 「음, 당신은 남자고 나는 여자니까, 이걸 하고 싶어...」
	PRINTFORMDW 그렇게 말한 후 그녀는 네 얼굴 쪽으로 더 다가와 가볍게 입을 맞춘다.
	PRINTFORMW 「오-오! 시간 좀 봐! 오늘은 여기까지야, 나 집에 가야 해!」
	PRINTFORMDW 미마는 얼굴이 완전히 빨개진 채 너의 등을 세게 두드리고는 서둘러 집으로 돌아간다.
	PRINTFORML
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K4_2
RETURN 1

@M_KOJO_SPEVENT_K4_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML
		PRINTFORMW 「저기, 들어봐.」
		PRINTFORMDW 미마는 진지한 표정으로 당신에게 말을 건다.
		PRINTFORMW 「이런 종류의 말은 잘 못해. 그래서 솔직하게 말할게.」
		PRINTFORMW 「나는 너를 좋아해.」
		PRINTFORMW 「농담하는 거 아니야. 너랑 함께 있으면, 다시 진정으로 살아있음을 느껴.」
		PRINTFORMW 「마치 내 영혼이 어떤 분홍빛 안개에 둘러싸여 있는 듯한 평온함을 느껴. 기분 좋은 느낌이야.」
		PRINTFORMDW 미마는 심호흡을 하고 당신의 눈을 바라봤다.
		PRINTFORMW 「나의 연인이 되어줄래?」
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		PRINTFORMW 「......」
		PRINTFORMW 「흥! 역시 알았어! 네가 받아줄 거라고!」
		PRINTFORMW 「넌 고백을 거절할 타입이 아니야! 난 전혀 긴장하지 않았어!」
		PRINTFORMDW 미마는 소리를 지른 후 안도하며 한숨을 내쉬었다. 
		PRINTFORMW 「...음, 기분 좋지 않아?」
		PRINTFORMDW 당신은 동의하며 고개를 끄덕였다.
		PRINTFORMW 「헤헤, 그러니까...」
		PRINTFORMW 「나 잘 부탁해, %CALLNAME:MASTER%%UNICODE(0x2665)%」
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		PRINTFORMW 「......」
		PRINTFORMW 「뭐? 내가 어린 소녀처럼 눈물을 터뜨릴 거라고 기대했어?」
		PRINTFORMW 「유감스럽게도, 나는 악의 정령이니까. 감정적인 기복은 우리에게는 사소해.」
		PRINTFORMW 「그렇다면, 오늘 일은 그냥 넘어가 주지.」
		PRINTFORMW 「하지만 기억해둬, 악의 정령들은 매우 집요하니까.」
		PRINTFORMDW 미마가 뒤돌아 집으로 향하며 눈가에 눈물이 고였다.
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K4_3
RETURN 1

@M_KOJO_SPEVENT_K4_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML
		IF CFLAG:318 == 1
			PRINTFORMW 「...」
			PRINTFORMDW 미마는 조용히 화를 내며 집으로 돌아간다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「아- 벌써 끝났구나...」
			PRINTFORMDW 미마는 실망한 표정으로 당신의 팔을 잡는다.
			PRINTFORMW 「시간 될 때 나 또 데리고 나가줄 수 있어?」
			PRINTFORMDW 당신은 고개를 끄덕이고, 미마는 당신의 팔에서 손을 떼며 미소 짓는다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「어라, 벌써 집에 가려고?」
			PRINTFORMDW 그 이유가 시간 때문이라고 답하자, 미마는 원망스러운 표정을 짓는다.
			PRINTFORMW 「시간 따위 나에겐 중요하지 않아. 나는 악령이니까.」
			PRINTFORMDW 미마는 데이트를 계속해달라고 계속 물었지만, 결국 포기하고 집으로 돌아간다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「후우, 피곤해.」
			PRINTFORMW 「하지만 그래도 거기서 정말 즐거운 시간을 보냈어.」
			PRINTFORMDW 미마는 만족스러운 표정으로 집으로 돌아갔다.
		ELSE
			PRINTFORMW 「아아, 너무 피곤하다...」
			PRINTFORMW 「다음엔 혼자 외출해 봐.」
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		IF TALENT:恋人
			PRINTFORMW 「... 이해했어, 용서할게.」
			PRINTFORMW 「유혹에 넘어갔구나, 이런 일은 생기기 마련이야. 누구나 실수를 해.」
			PRINTFORMW 「이것을 화해의 포옹으로 삼자, %CALLNAME:MASTER%♪」
			PRINTFORMDW 미마는 당신에게 기대어 웃고 있다.
		ELSE
			PRINTFORMW 「... 아아, 당분간은 눈감아주지.」
			PRINTFORMW 「하지만 이런 일이 또 일어난다면. 벌 받을 준비를 하는 게 좋을 거야.」
		ENDIF
		PRINTL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		IF TALENT:恋人
			PRINTFORMW 「...음.」
			PRINTFORMDW 미마는 진지한 표정으로 당신을 바라보지만, 조금 더 침착해 보인다.
		ELSE
			PRINTFORMDW 미마는 당신을 차갑게 내려다보더니, 시무룩하게 몸을 돌려 당신을 무시한다.
		ENDIF
		PRINTL
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		IF TALENT:恋人
			PRINTFORMW 「너... 나를 가볍게 여겼지, 안 그래?」
			PRINTFORMW 「원한다면 눈 깜짝할 새에 너를 죽일 수도 있어, 알잖아?」
			PRINTFORMDW 그녀가 위협을 끝낸 후, 약간 더 기분이 좋아진 듯하다.
		ELSE
			PRINTFORMW 「내가 아직 침착할 때 어딘가로 가라. 그렇지 않으면 너를 죽일 테니까.」
			PRINTFORMDW 미마는 분노로 떨면서 당신에게 경고한다.
		ENDIF
		PRINTL
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
