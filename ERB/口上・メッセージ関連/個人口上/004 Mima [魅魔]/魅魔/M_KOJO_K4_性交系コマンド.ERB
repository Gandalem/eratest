LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			;処女
			IF TCVAR:破瓜 == 1
				PRINTFORMW 「처음이니까 부드럽게 하자...」
				PRINTFORMDW 미마는 처녀를 잃을 생각에 불안해하는 듯했다.
				RETURN 1
			ELSE
				PRINTFORMW 「흐음... 너도 이걸 하고 싶구나...♪」
				PRINTFORMDW 미마는 섹스하면서 당신과 얼굴을 마주하는 것에 흥미를 느끼는 것 같다.
				RETURN 1
			ENDIF
		ELSE
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:5 == 0
			PRINTFORMDL 당신은 미마에게 당신의 성기를 삽입한다.
			PRINTFORMDL 미마는 당신이 그녀의 질을 더 쉽게 자극할 수 있도록 다리를 벌린다.
			PRINTFORMDW 둘 모두의 쾌감이 증가함에 따라, 그들은 몸을 위아래로 움직인다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「우으%UNICODE(0x2665)% 우우%UNICODE(0x2665)%쿠우%UNICODE(0x2665)%」
			PRINTFORMDL 미마의 몸이 살짝 떠서 당신을 끌어안는다.
			PRINTFORMDW 당신은 미마를 안으며 허리를 필사적으로 움직인다.
		ELSEIF RAND:3 == 0
			PRINTFORMDL 네 페니스가 정령의 질 뒤쪽을 강렬하게 문지른다.
			PRINTFORML 「아아! 정말 좋아%UNICODE(0x2665)%」
			PRINTFORMDW 너는 허리와 골반을 앞뒤로 흔들기 계속한다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「%CALLNAME:MASTER% %UNICODE(0x2665)%　느낌이...%UNICODE(0x2665)%　좋은 느낌이야...%UNICODE(0x2665)%」
			PRINTFORMDL 미마는 당신의 등에 손을 올리고 계속해서 당신의 이름을 되뇌었다.
			PRINTFORMDW 두 사람은 그 순간을 만끽했다.
		ELSE
			PRINTFORML 「아아%UNICODE(0x2665)% 아아%UNICODE(0x2665)% 굉장해%UNICODE(0x2665)%」
			PRINTFORMDL 당신의 몰아치듯 깊은 움직임이 그녀의 자궁경부에 불안하게 닿는다.
			PRINTFORMDW 당신은 그녀의 허벅지 하나를 들고 미마에게 여러 번 박아 넣었다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
