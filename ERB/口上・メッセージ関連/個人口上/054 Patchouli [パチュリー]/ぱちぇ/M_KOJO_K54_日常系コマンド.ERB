;301,お茶を淹れる
;==================================================
@M_KOJO_MESSAGE_COM_K54_301
CALL M_KOJO_MESSAGE_COM_K54_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
;Custom code, prevent reaction during timestop
SIF FLAG:70
	RETURN 1
;初めて
IF FIRSTTIME(SELECTCOM)
	PRINTFORML 「...... It's not very good, is it.」
	PRINTFORMDL \@ CFLAG:1003 ? Patchouli # The purple-haired girl \@ frankly tells you that the tea tastes bad.
	PRINTFORMW 「There's a book on how to brew tea \@ CFLAG:現在位置 == 310 ? over there # in the library \@, you're welcome to have it.」
;美味しかった
ELSEIF TFLAG:193 == 1
	PRINTFORML 「Ara, This is delicious... I give it a full 96 points.」
	PRINTDL Patchouli keeps taking sips from the cup, seemingly very satisfied.
	SIF CFLAG:1004 <= 20
		PRINTFORML 「Remember this feeling and strive to be able to brew this at any time.」
	WAIT
;不味い
ELSEIF TFLAG:193 == -1
	PRINTFORML 「This is... No matter how you look at it, this is terrible.」
	PRINTFORMDL Patchouli takes a single sip, returns the cup and has you drink it too.
	PRINTFORML 「See? Not good, is it?」
	SIF TALENT:恋慕
		PRINTFORMDL You say that the tea might be bad but Patchouli's leftovers are good, and Patchouli's face turns bright red.
	WAIT
;恋慕(愛でカバーされました)
ELSEIF TALENT:恋慕
	PRINTFORML 「Drinking tea with you is something special, %CALLNAME:MASTER%.」
	PRINTDL Patchouli holds the cup with both hands and empties it little by little.
	IF CFLAG:1004 <= 20
		PRINTFORMW 「If it was just a little tastier I would have absolutely no complaints to make, you know... If you need advice, I can give you as much as you need.」
	ELSE
		PRINTFORMW 「Sharing something delicious with the one you love... I never thought I would feel this happy.」
	ENDIF
;まだまだ好みが分かっていない
ELSEIF CFLAG:1004 <= 10
	PRINTFORML 「Hm... {27 + RAND:3 * CFLAG:1004} points, you've still got a ways to go.」
	PRINTFORMDL \@ CFLAG:1003 ? Patchouli # The purple-haired girl \@ takes a sip of the tea you brewed and gives it an evaluation right away.
	SIF CFLAG:1004 == 5
		PRINTFORML 「It's alright for you to ask Sakuya to teach you as well.」
	WAIT
;好みが分かってきた
ELSEIF CFLAG:1004 <= 20
	PRINTFORML 「...... {53 + RAND:3 * (CFLAG:1004 / 2)} points, you're becoming fairly decent.」
	PRINTFORMDL Patchouli looks straight at you.
	PRINTFORMW 「The amount of tea leaves has become adequate. Now you only need to get the steeping time right.%COND_STR(@"..... Keep it up.", CFLAG:1004 == 15)%」
;好みと合致
ELSE
	PRINTFORML 「Un, Delicious.」
	PRINTFORMDL You gratefully accept Patchouli's evaluation.
	PRINTFORMW 「Now just keep the taste like this and we can really say it's become drinkable.」
ENDIF
CFLAG:1004 ++
TCVAR:354 = 1
ENDIF
RETURN 1
