;302,スキンシップ
;==================================================

@M_KOJO_MESSAGE_COM_K54_302
CALL M_KOJO_MESSAGE_COM_K54_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, prevent reaction during timestop
	SIF FLAG:70
		RETURN 1
	;初めて
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「......?! 갑자기 뭐야?...... 더 만지면 화낼 거야.」
		IF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
			PRINTFORMDL 경계심 많은 패치울리에게 방금 돌아왔다고 말한다.
			SIF !CFLAG:6
				PRINTFORML 「...... (%HE_SHE(MASTER)%이 이상한 짓을 하면 그냥 %HIM_HER(MASTER,,1)%를 태워버릴 수 있으니까)...... 해봐.」
			WAIT
		ENDIF
		;大浴場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		;恋慕
		IF TALENT:恋慕
			PRINTFORMDL 파츄리가 뒤에서 당신에게 매달린다.
			PRINTFORMW 「다음엔 머리부터 발끝까지 씻겨줄 거야.」
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「...... 그만둬. 너무 세게 하든 약하게 하든, 혼자 생각이 너무 많아진 것 같네.」
			PRINTFORMDW 파조울리는 당신에게서 스펀지를 빼고 %HIM_HER(54)%스스로를 씻기 시작한다.
			;うふふ解禁状態
		ELSEIF CFLAG:6 >= 2
			PRINTFORMDL 일단 %HIS_HER(54)% 등이 씻기자 패치울리가 당신에게 어깨 너머로 시선을 돌렸다.
			PRINTFORMW 「...... 모르겠네, 수세미 대신 내 가슴으로 씻겨 주는 게 더 좋을까?」
			;セクハラ解禁状態
		ELSEIF CFLAG:6 == 1
			PRINTFORML 「조금 더 부드럽게 해줘......」
			PRINTFORMDW 네가 문지르고 있는 그 부분이 정말 조금 빨갛게 변했어.
			;それ以外
		ELSE
			PRINTFORML 「너 의외로 잘한다, 그렇지...? 팔도 해줄 수 있어?」
			PRINTFORMDW 패치울에게 문제없다고 말하고, %HIS_HER(54)% 팔꿈치를 들어 문지르기 시작했다.
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「머리 쓰다듬기는 정말 어린애들한테나 하는 거지... 하지만......」
			PRINTFORMDW 그렇게 말하면서도 패치울리는 머리를 쓰다듬는 손을 멈추지 않고 당신의 무릎에 %HIS_HER(54)% 머리를 기댄다.
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「아야!」 아팠다!
			PRINTFORMDW 패치울리의 머리를 쓰다듬는 도중 손가락 하나가 걸려 무심코 그것을 잡아 빼버린다.
		ELSE
			PRINTFORML 「...... 내 뺨 만지는 게 정말 그렇게 재미있어?」
			PRINTFORMDL 패치울리의 말에 수줍게 고개를 끄덕이며, %HIS_HER(54)%의 뺨을 꼬집고 가볍게 잡아당긴다.
			PRINTFORMW 「내 볼에 다 묻히지 마ー」
		ENDIF
		;うふふ解禁状態
	ELSEIF CFLAG:6 >= 2
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「다른 사람의 발을 만지는 게 뭐가 그렇게 재미있는지 이해가 안 된다.」
			PRINTFORMDW 너는 패치울에게 예쁜 발을 만지는 것이 다른 어떤 것보다 기분이 좋다고 말하고 %HIS_HER(54)% 무릎 쪽으로 키스하기 시작한다.
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「기분이 안 좋으니까 떨어져......」
			PRINTDW 지금은 좋은 시간이 아닌 것 같다.
		ELSE
			PRINTFORML 「...... 좀 숨 막히지 않니.」
			PRINTFORMDW 불평을 하고 있음에도 패치울리는 당신을 내보내지 않는다.
		ENDIF
		;セクハラ解禁状態
	ELSEIF CFLAG:6 == 1
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「아이처럼 손을 잡고 싶은 건가, 응.」
			PRINTFORMDW 그만둘지 묻지만, 파치우리는 체념한 표정으로 당신의 손을 잡는다 %HIS_HER(54)%.
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「흐으앗!」
			PRINTFORMDL 당신은 패치울리의 목을 따라 손을 쓸어 올리고 %HE_SHE(54)% 놀라 벌떡 일어난다.
			PRINTFORMW 「왜 그랬어?! 머릿속으로 계산하고 있었는데 이제 공식이 다 엉망이야!!」
		ELSE
			PRINTFORML 「다른 사람의 머리카락 끝을 만지는 것이 꽤 재미있는 것 같다...」
			PRINTFORMDW 책을 읽고 있음에도 불구하고 패치울리는 당신이 수상한 행동을 하지 않도록 주의를 기울이고 있다.
		ENDIF
		;それ以外
	ELSE
		;大成功
		IF TFLAG:193 == 1
			PRINTFORML 「참 대단한 변태로군, 내 손가락을 만지고 싶어 하다니...」
			PRINTFORMDL 당신은 %HIS_HER(54)%의 말을 무시하고 자신의 손가락으로 패치울리의 손가락을 더듬었다.
			PRINTFORMW 「응, 다음은 다른 손이야?............ 네 마음대로 해.」
			;失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「아, 정말 짜증나!」
			PRINTFORMDW 패치올리가 당신을 내쫓는다.
		ELSEIF !RAND:2
			PRINTFORMDL 당신은 패치울리 옷에 붙어있는 먼지를 털어낸다.
			PRINTFORMDW 패치울리는 인상을 쓰며 나머지 먼지도 털어내라고 한다.
		ELSE
			PRINTFORML 「어깨 마사지 해 줄 거야?...... 뭐, 괜찮아. 해 봐.」
			PRINTFORMDL 당신은 패치풀의 어깨에 손을 대고 %HIM_HER(54)% 부드럽게 마사지를 시작한다.
			PRINTFORMW 「응...... 생각보다 기분이 좋다.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
