;==================================================
;410,掃除
;==================================================
@M_KOJO_MESSAGE_COM_K54_410
CALL M_KOJO_MESSAGE_COM_K54_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_410_1
;初めて
;Custom code, prevents people from cleaning when time is stopped or they're sleeping
SIF FLAG:時間停止 || CFLAG:睡眠
	RETURN 0
IF FIRSTTIME(SELECTCOM)
	IF TFLAG:193
		PRINTFORML 「Right, it's been a while since last time so let's give cleaning a try.」
		PRINTFORMDW %BREAKENG(@"Patchouli \@ CFLAG:300 != BATHROOM() ? takes off %HIS_HER(54)% hat and bundles the hair on %HIS_HER(54)% shoulders together, then # wraps a bath towel around %HIM_HER(54)%self and \@ begins helping you.")%
	ELSE
		PRINTFORML 「Cleaning is \@ CFLAG:1004 ? one of your jobs # your job\@, is it not......?」
		PRINTFORMDL %BREAKENG(@"\@ CFLAG:1003 ? Patchouli # The purple-haired girl \@ says \@ BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置) ? while soaking languishingly in the bath. # languishingly and looks back down at %HIS_HER(54)% book. \@")%
		;パチュリー私室以外でパチュリー私室の掃除が出来る
		SIF CFLAG:300 != CFLAG:初期位置 && YOGORE:(CFLAG:初期位置) > 500
			PRINTFORML 「......Oh, That's right. Go clean around my desk and bed too.」
		WAIT
	ENDIF
;恋慕
ELSEIF TALENT:恋慕
	SELECTCASE TFLAG:194
		CASE 0
			PRINTFORML 「Let's get this over with and do something more fun, shall we?」
			PRINTDW Patchouli takes the initiative and begins cleaning.
		CASE 1
			PRINTFORMDL Patchouli hands you a handkerchief and turns around.
			PRINTFORML 「I can't tie it well myself...... Could you tie it for me?」
			PRINTFORMDW %BREAKENG(@"While smiling to yourself about Patchouli's occasional clumsiness, you tie the handkerchief into a makeshift dust mask.")%
		CASE 2
			PRINTFORML 「It does seem worth doing......」
			PRINTFORMDW You and Patchouli take a trash bin and begin picking up the trash scattered around.
		CASE 3
			PRINTFORML 「It does seem daunting at this point, doesn't it...」
			PRINTFORMDL Patchouli says to you while staring at the mountain of garbage.
			PRINTFORML 「We'll have to just stop and do it. Let's clean up as much of it as we can.」
			PRINTFORMD Patchouli doesn't forget to add a
			PRINTFORMW 「Reward me later, okay?」 
	ENDSELECT
;うふふ解禁状態
ELSEIF CFLAG:6 >= 2
	SELECTCASE TFLAG:194
		CASE 0
			PRINTFORML 「With this little dirt, it's fine to just wipe things down, right?」
			PRINTDW Patchouli goes around with light steps wiping down places within reach.
		CASE 1
			PRINTFORML 「I've got a handkerchief ready.」
			PRINTFORMDW You ask if it's damp, and Patchouli asks you to moisten it.
		CASE 2
			PRINTFORML 「There's a lot of trash, isn't there... I wonder if I should blow it away with magic......」
			PRINTDW If it kicks up dust there will be even more to clean, so please don't.
		CASE 3
			PRINTFORML 「Haaー...... Let's do it.」
			PRINTFORMDW Patchouli lets out a long sigh and battles the mountain of garbage alongside you.
	ENDSELECT
;それ以外で一緒に掃除をする
ELSEIF TFLAG:193
	SELECTCASE TFLAG:194
		CASE 0
			PRINTFORML 「Everything's clean...... Hm? Wipe it down?」
			PRINTFORMDL Patchouli says to you, then tries wiping something within reach.
			PRINTFORMW 「...... I see, there's still a surprising amount of dirt left.」
		CASE 1
			;風呂場以外
			IF !BATHROOM()
				PRINTFORML 「The broom kicks up the dust so I don't like it... That's why I always neglect cleaning, it's bad for my lungs too...」
				PRINTFORMDW %BREAKENG(@"You wring dry a water-soaked handkerchief, fashion a makeshift dust mask out of it for Patchouli, and have %HIM_HER(54)% work.")%
			ELSE
				PRINTFORML 「Brushing splashes dirt on my legs so I don't like it......」
				PRINTFORMDW %BREAKENG(@"You propose that Patchouli could do it while floating. Patchouli replies with「I suppose so」and floats up %HIS_HER(54)% body clad in only a bath towel.")%
			ENDIF
		CASE 2
			PRINTFORML 「It's fine to just toss whatever is clearly trash into the bin, right?」
			PRINTFORMDW You nod and Patchouli begins slowly collecting the trash.
		CASE 3
			PRINTFORML 「...... Can't we just pretend not to see it?」
			PRINTFORMDL After some thought, you tell Patchouli to clean until %HE_SHE(54)% gets fed up with it for now.
			PRINTFORMW 「...... I feel like I'm already fed up.」
	ENDSELECT
;それ以外
ELSE
	SELECTCASE TFLAG:194
		CASE 0
			PRINTFORML 「Isn't that already clean?」
			PRINTFORMDL You do one wipe and show the rag to Patchouli.
			PRINTFORMW 「Uwah, Don't show me such a dirty thing......」
		CASE 1
			;風呂場以外
			IF !BATHROOM()
				PRINTFORML 「Using a broom? Please try not to kick the dust all the way up here.」
				PRINTFORMDW That's unreasonable... You think as you sweep, trying not to send any dust towards Patchouli.
			ELSE
				PRINTFORML 「You're using a brush? Please try not to splash dirt over here.」
				PRINTFORMDW You turn your back towards Patchouli so that the splatters don't reach %HIM_HER(54)% and begin scrubbing. 
			ENDIF
		CASE 2
			PRINTFORMW 「Cleaning does seem to be worth it...... I still won't do it though.」
		CASE 3
			PRINTFORML 「Tidying things up ahead of schedule...... It's getting difficult to walk so I guess it can't be helped.」
			PRINTFORMDW Patchouli needn't have asked, but you begin cleaning the mountains of garbage anyway.
	ENDSELECT
ENDIF
RETURN 1
