;==================================================
;403,休憩
;==================================================
@M_KOJO_MESSAGE_COM_K54_403
CALL M_KOJO_MESSAGE_COM_K54_403_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_403_1;パチュリーが眠っている
IF CFLAG:313
	PRINTFORMDL %BREAKENG(@"You sit down in Patchouli's favorite rocking chair and take a short rest while gazing at the sleeping Patchouli.")%
;大浴場
ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
	IF TALENT:恋慕
		IF YOGORE:333 < 1000
			PRINTFORML 「What a nice bath......」
			PRINTFORMDL %BREAKENG(@"Patchouli places %HIS_HER(54)% arms and chin on the bathtub's edge and stretches %HIS_HER(54)% upper body by leaning on the edge.")%
			PRINTFORMDL %BREAKENG(@"You struggle with finding a place to look, but eventually you sit next to Patchouli and relax in the bath.")%
		ELSE
			PRINTFORML 「It's a little dirty, isn't it......」
			PRINTFORMDL Patchouli relaxes in the bath next to you and then wonders if some cleaning might be in order.
		ENDIF
	ELSE
		IF FLAG:118 < 1000
			PRINTFORMDL You stare at Patchouli while relaxing in the bath.
			PRINTFORML 「............ What?」
			PRINTFORMDL %BREAKENG(@"You says that you were staring because %HE_SHE(54)%'s pretty. Unusually for Patchouli, %HE_SHE(TARGET)% is embarrassed.")%
		ELSE
			PRINTFORML 「The bathtub is dirty...」
			PRINTFORMDL Patchouli looks at you and asks you to clean it as soon as you have the time.
		ENDIF
	ENDIF
ELSEIF CFLAG:311 == CFLAG:MASTER:311
	PRINTFORMDL You sit down on the empty bed and collapse onto it.
	PRINTFORML 「Having a break I presume?...... Do you need a \@ RAND:2 ? lap pillow # hug pillow \@?」
	PRINTFORMDL You say a yes please, and Patchouli smiles replies that %HE_SHE(TARGET)% would be delighted to.
ELSEIF TALENT:恋慕
	PRINTFORML 「Ara, A break?」
	PRINTFORMDL You take a relaxed posture on the bed and Patchouli sits on the side of it.
	PRINTFORML 「Hm? Don't worry about me, you can sleep.」
ELSE
	PRINTFORML 「...... A break?...... When you next wake up, I may have left already, you know.」
ENDIF
PRINTFORML 
RETURN 1
