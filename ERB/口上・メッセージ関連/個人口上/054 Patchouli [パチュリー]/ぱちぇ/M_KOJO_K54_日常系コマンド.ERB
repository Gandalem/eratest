@M_KOJO_MESSAGE_COM_K54_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K54_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, prevent reaction during timestop
	SIF FLAG:70
		RETURN 1
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		LOCAL:9 = 0
		IF !CFLAG:318
			CFLAG:318 = 1 ;trigger needed dialogue like this
			LOCAL:9 = 1
		ENDIF
	ENDIF
	;ここに口上書いて下さい
	;初めて
	IF FIRSTTIME(SELECTCOM)
		RESETCOLOR
		DRAWLINE
		CALL SET_KOJO_COLOR(TARGET)
		;お茶は淹れた
		IF TCVAR:354
			;どんなに厳つかろうと不自然であろうと性別ではなく格好で判断する
			;custom code, more extensive clothing check
			PRINTFORM 그래서, 당신은 대체 누구죠? 그런 옷차림으로 보아 아마 
			IF GROUPMATCH(CFLAG:MASTER:基本服装セット, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "執事セット"), OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "男装セット")) || (CFLAG:MASTER:基本服装セット == OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "着流しセット") && IS_MALE(MASTER))
				PRINTFORML 집사 같은 사람.
			ELSEIF GROUPMATCH(CFLAG:MASTER:基本服装セット, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "女中セット"), OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "女装セット")) || (CFLAG:MASTER:基本服装セット == OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "着流しセット") && IS_FEMALE(MASTER))
				PRINTFORML 하녀 같은 것.」
			ELSE
				PRINTFORML 그냥 주워들인 한 명의 무임승차자, 레미다.
			ENDIF
			PRINTFORMDL 당신은 본인의 성함을 말하며 답하고, 소녀는 차를 마시며 쉬고 있는 모습이다.
			PRINTFORML 「아, 아직 서로 소개하지 못했군요... 저는 평범한 프리로더인 패치풀리 노우리지예요.」
		ELSE
			LOCALS:0 = 
			IF GROUPMATCH(CFLAG:MASTER:基本服装セット, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "執事セット"), OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "男装セット")) || (CFLAG:MASTER:基本服装セット == OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "着流しセット") && IS_MALE(MASTER))
				LOCALS:0 '= @"집사"
			ELSEIF GROUPMATCH(CFLAG:MASTER:基本服装セット, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "女中セット"), OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "女装セット")) || (CFLAG:MASTER:基本服装セット == OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "着流しセット") && IS_FEMALE(MASTER))
				LOCALS:0 '= @"메이드"
			ELSE
				LOCALS:0 '= @"손님"
			ENDIF
			PRINTFORMDL 소녀는 의심스러운 눈으로 당신을 바라보고, 당신은 최근에 여기에 온 %LOCALS:0%이라고 그녀에게 말한다.
			PRINTFORML 「음... 그렇다면. 나는 평범한 마녀인 패치울리 나이트다.」
		ENDIF
		PRINTFORMDW 파치풀이라는 소녀가 당당하게 너를 바라본다.
		CFLAG:1003 = 1
		;恋慕
	ELSEIF TALENT:恋慕
		;妊娠(日数によって変化していくと面白いと思う)
		;	IF CFLAG:6
		;怒り分岐
		IF CFLAG:318 && !(TCVAR:353 & 1)
			PRINTFORML 「관계가 아무리 가까워져도, 용서할 수 없는 것들이 있다.」
			PRINTFORMDL 패치울리가 차가운 시선을 주며 말한다.
			PRINTFORMW 「친밀한 관계에서도 매너가 얼마나 필수적인지 철저하게 가르쳐 줄 것이다.」
			TCVAR:353 |= 1
		ELSEIF CFLAG:318
			PRINTFORML 「음, 우리는 그런 일들을 침착하게 할 만큼 가까운 사이니까.」
			PRINTFORMDL 패치울리가 당신에게 중얼거린다.
			PRINTFORMW 「아니, 아직 안심하지 마... 난 할 말이 끝나지 않았어.」
		ELSEIF (BASE:怒り >= (MAXBASE:怒り / 5) * 3) && !(TCVAR:353 & 2)
			PRINTFORML 「오늘의 계획을 바꿔야겠어. 네가 저지른 죄들을 세어볼까, %CALLNAME:MASTER%?」
			PRINTFORMDW 파츄리가 너를 노려본다.
			TCVAR:353 |= 2
		ELSEIF ((BASE:怒り >= MAXBASE:怒り / 5) && (BASE:怒り <= (MAXBASE:怒り / 5) * 3)) && !(TCVAR:353 & 4)
			;怒りが収まってきた
			IF TCVAR:353 & 2
				PRINTFORML 「잘못을 세는 건 별로 로맨틱한 주제가 아니지 않나?」
				PRINTFORMDL 파츄리의 시선이 조금 부드러워지고 %HE_SHE(54)%은 계속했다.
				PRINTFORMW 「알고 있어, 우리가 함께 했던 일들을 되돌아볼까?」
				;ちょっとむっとした
			ELSE
				PRINTFORML 「후후, 당신이 무슨 바보 같은 소리를 하는 건지 궁금하네요, %CALLNAME:MASTER%?」
				PRINTFORMDW 패치울리가 웃자 %HE_SHE(54)%가 %HIS_HER(54)% 책의 표지를 쾅 닫았다.
			ENDIF
			TCVAR:353 |= 4
			;会話大成功
		ELSEIF TFLAG:193 == 1
			PRINTFORMDL 파조울리가 말이 많아져서 당신에게 무언가를 말한다.
			PRINTDATAW
				DATAFORM 「정령 마법은 자신의 힘을 이용해 정령과 소통하여 그들의 힘을 사용하는 방식이지만......」
				DATAFORM 「그림보를 분석하며 얻는 지식 자체가 필요하지만......」
				DATAFORM 「도서관 밖에도 세상에 책들은 분명 있지만, 대부분은 쓸모가 없다... 비록 몇몇은 꽤 흥미롭긴 하다.」
				DATAFORM 「도서관에는 성과 관련된 알고 있는 모든 것이 들어있어야 할 것이다... 다만 어디에 있는지 모르겠군.」
			ENDDATA
			;会話大失敗
		ELSEIF TFLAG:193 <= -1
			PRINTDL 무슨 이유에서인지 패치울과의 대화는 그저 혼란스러운 난장판이 되어버린다.
			PRINTFORMW 「아니, 내가... 어떻게 말해야 할까......」
		ELSEIF !RAND:6
			PRINTFORML 「코아쿠마가 말해주기 전까지는 몰랐는데......」
			PRINTFORMDL 패치울리가 당신을 바라본다.
			PRINTFORMW 「읽기에 너무 집중하면 주변 사물들을 떠다니게 만드는 버릇이 있다는 모양이야.」
		ELSEIF !RAND:5
			PRINTFORML 「바깥세상에 발렌타인이라는 행사가 있는 것 같아.」
			PRINTFORML 「사랑하는 사람에게 초콜릿을 주는 날 같은 거라 들었는데...」
			PRINTFORMDL 패치울리는 장난기 어린 미소를 지어 보인다.
			PRINTFORMW 「당연히, 나에게 줄 수 있는 재료를 찾아서 당신에게 초콜릿으로 보답해 주겠지, 안 그래?」
		ELSEIF !RAND:4
			PRINTFORMDL 패치울리(Patchouli)는 눈썹을 살짝 찌푸리며 %HIS_HER(54)% 최근의 실패에 대해 말한다.
			PRINTFORMW 「어제 읽었던 마도서는 별로였어... 수정이 필요한 곳이 이렇게 많을 줄은 몰랐지.」
		ELSEIF !RAND:3
			PRINTFORML 「책 없이는 못 살아. 책 없는 나는 내가 아니니까.」
			PRINTFORMDL 너는 책들에 조금 부러움을 느낀다.
			PRINTFORMW 「괜찮아, %CALLNAME:MASTER%도 필수적이니까.」
		ELSEIF !RAND:2
			PRINTFORML 「외부 세계에서 그라비아 포토 컬렉션이라는 것을 봤어......」
			PRINTFORMDW %HIS_HER(54)% 가슴을 느끼며, 패치울리는 진지하게 혼잣말을 한다.
			PRINTFORMW 「조금만 더 크면 방해가 될 것 같아.」
		ELSE
			GOTO TALKING2
		ENDIF
		;言葉が見つからない
	ELSEIF TCVAR:302
		;簡易に
		CALL D_LINE ;custom code
		PRINTFORMDL 당신은 "...음..."과 "...에으..."를 반복하며 침착함을 잃기 시작한다.
		PRINTFORML 「......어? 아....... 음-흠......」
		PRINTDW 패치울리도 불분명한 무언가로 대답했다.
		;うふふ解禁状態
	ELSEIF CFLAG:6 >= 2
		$TALKING2
		;怒り
		IF CFLAG:318 && TCVAR:353 != 1
			PRINTFORMDL 파츄리가 %HIS_HER(54)%의 뺨을 살짝 부풀린 듯하다.
			PRINTFORMW 「%CALLNAME:MASTER%... 그거 명백히 용납할 수 없는 일이었다는 거 알잖아, 그렇지?」
			TCVAR:353 |= 1
		ELSEIF CFLAG:318
			PRINTFORMDL 패치울리는 당신을 보지 않는다. 당신은 %HE_SHE(54)%이 듣고 있는지조차 확신할 수 없다.
			PRINTFORMW 「...............하아.」
			;会話大成功
		ELSEIF TFLAG:193 == 1
			PRINTFORML 「나의 선호도라고?...... 정확히 선호도라기보다는, 내가 가지고 있지 않은 것을 가진 사람들이 흥미롭다고 생각한다.」
			PRINTFORMDL 패치울리는 멀리 응시하던 %HIS_HER(54)% 눈을 당신에게로 돌렸다.
			PRINTFORMW 「...... 혹시 그런 사람이 될 수 있을까?」
			;会話大失敗
		ELSEIF TFLAG:193 <= -1
			PRINTFORML 「야, %CALLNAME:MASTER%, 어디서 그런 걸 들었지?」
			PRINTDL 패치울리의 목소리는 침착해 보이지만, 위험의 기색이 섞여 있다.
			PRINTFORMW 「그래서, 내 과거에 대해 소문을 퍼뜨린 사람이 누구인지 말해주지 않을 거니? 후후후......」
		ELSEIF !RAND:4
			PRINTFORML 「내가 네게 준 책은 어땠니?」
			PRINTFORMDW 파치나우는 지난번에 주었던 책에 대한 너의 생각을 물어본다 %HE_SHE(54)%. 
		ELSEIF !RAND:3
			PRINTFORML 「우리가 마녀의 진정한 본질에 대해 어디까지 얘기했더라......」
			PRINTFORMDW 당신이 무심하게 반사적으로 두 손으로 머리를 감싸자, 패치울리는 %HE_SHE(54)%이 끝냈던 곳부터 말을 시작했다.
		ELSEIF !RAND:2
			PRINTFORML 「헤이, %CALLNAME:MASTER%...... 나에게 말해줘, 네 눈에는 어떤 재미있는 책들이 있니?」
			PRINTFORMDL 잠시 생각한 후, 몇 권의 책 제목을 나열했다.
			PRINTFORMW 「그것들 염두에 둘게, 고마워.」
		ELSE
			PRINTFORML 「계속 말하지만, 그건 그냥 지긋지긋하다고 생각해.」
			PRINTFORMDL 너는 그게 더 잘 맞아서 그렇게 좋아한다고 말하지.
			PRINTFORMW 「뭐... 이번에는 확실히 하자.」
		ENDIF
		;セクハラ解禁状態
	ELSEIF CFLAG:6 == 1
		;怒り
		IF CFLAG:318 && TCVAR:353 != 1
			PRINTFORML 「.........」
			PRINTFORMDW 당신은 필사적으로 대화 주제를 찾고 있지만, 파츄리는 신경 쓰지 않는 것 같다.
			TCVAR:353 |= 1
		ELSEIF CFLAG:318
			PRINTFORML 「...... 내가 왜 화가 났는지 알잖아, 그렇지?」
			PRINTFORMDW 당신은 그저 고개를 끄덕이고 폭풍이 지나가기를 기다릴 뿐이다.
			;会話大成功
		ELSEIF TFLAG:193 == 1
			PRINTFORML 「%CALLNAME:MASTER%, 어떤 종류의 사람을 좋아해?」
			PRINTFORMDL 갑작스러운 질문에 당황하여 패치울 같은 사람을 좋아한다고 실수로 대답한다. 
			PRINTDW 패치울은 그리 불만족스러워 보이지 않고 웃는다.
			;会話大失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「그것에 대해 말하는 걸 그만둬 줄래?」
			PRINTFORMDL 파치울리가 갑자기 네 이야기를 중단한다.
			PRINTFORMW 「미안해, 나는 그 주제가 별로 안 좋아해서 그래.」
		ELSEIF !RAND:4
			PRINTFORML 「내 임무인가?...... 음, 환경을 유지하고 이모우토님을 관리하는 것이겠지.」
			PRINTFORMDL 파치불리가 질문에 부드럽게 대답하며 말을 이어갔다.
			PRINTFORMW 「왜냐하면 %HIS_HER(50)% 마음 \@ TALENT:50:恋慕 ? 안정되어 # 안정의 기미를 보이기 시작했기 때문이야 \@ 최근에는 그다지 힘들지 않았어.」
		ELSEIF !RAND:3
			PRINTFORML 「생각해보니 마녀라는 존재가 어떤 종류인지 알고 있나요?」
			PRINTFORMDL 당신은 그것이 단순히 마법을 사용하는 여성들을 일컫는 일반적인 용어는 아닌지 물으며 대답한다.
			PRINTFORMW 「음, 사람들이 그렇게 생각하죠... 알아요, 제가 마녀들에 대해 강의해 드릴게요. 지루해질 때까지 할 거예요.」
		ELSEIF !RAND:2
			PRINTFORML 「가끔은 이런 책을 읽어보는 건 어때, %CALLNAME:MASTER%?」
			PRINTFORMDW 당신은 감사하게 그 책을 받고 시간이 날 때 읽겠다고 약속한다.
		ELSE
			GOTO TALKING1
		ENDIF
		;それ以外
	ELSE
		$TALKING1
		;怒り
		IF CFLAG:318 && TCVAR:353 != 1
			PRINTFORML 「너는... 사람들을 화나게 만드는 것이 전문이냐?」
			PRINTFORMDW 패치울리의 눈에 소리 없는 불길이 차오르며 %HE_SHE(54)%이 너를 바라본다.
			TCVAR:353 |= 1
		ELSEIF CFLAG:318
			PRINTFORML 「..................... 알겠다.」
			PRINTFORMDW 네 이야기에 잠시라도 멈춤이 생기면 패치울리는 차가운 시선을 보낸다.
			;会話大成功
		ELSEIF TFLAG:193 == 1
			PRINTFORML 「오~ 흥미로운 이야기로군.」
			PRINTFORMDW 패치우리는 계속할 것을 촉구한다.
			;会話大失敗
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「...... 이 이야기는 오래 계속될 건가요?」
			PRINTFORMDW 패치울리가 하품을 참는다. %HE_SHE(54,1)%은 매우 지루해 보인다.
		ELSEIF !RAND:4
			PRINTFORML 「최근에 쥐들이 심각한 피해를 주고 있어......」
			PRINTFORMDW 패치울은 한숨을 쉬며 당신에게 무언가 조치를 취하라고 말한다.
		ELSEIF !RAND:3
			PRINTFORMDL 당신과 패치울이 책을 마주 보고 살펴보고 있다.
			PRINTFORMW 「흠... 다른 관점의 의견을 듣고 싶었는데, 우리가 같은 의견일 줄은 몰랐네...」
		ELSEIF !RAND:2
			PRINTFORML 「너는 어떤 종류의 책을 좋아할지 궁금하구나, %CALLNAME:MASTER%?」
			PRINTFORMDW 패치울리는 네가 관심을 갖는 책에 대해 이야기하는 것을 들으며 같은 종류의 다른 책들이 어느 선반에서 찾을 수 있는지 알려준다.
		ELSE
			PRINTFORML 「사람의 생각 과정을 말하는 방식에서 알 수 있는 것 같다.」
			PRINTFORMDW 평소 읽던 책보다 큰 책을 읽는 동안 패치울은 마치 독백하듯이 당신에게 말을 건다.
		ENDIF
	ENDIF
	SIF LOCAL:9 ;custom code
		CFLAG:318 = 0
ENDIF
RETURN 1
