;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K54_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K54_310
CALL M_KOJO_MESSAGE_COM_K54_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		;初めて
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「햐?!............ 무슨 일이야?」
			;親密が5以下
			IF ABL:親密 <= 5
				PRINTFORMDL 패치울리의 눈이 차가워진다, 당신이 %HIS_HER(54)% 엉덩이를 만지자.
				PRINTFORMW 「...... 그만두지 않으면 너를 재로 만들어 버릴 테다.」
			ELSE
				PRINTFORMDL 패치울리가 사랑스러운 울음을 터뜨린 후 홍당무처럼 붉어진다.
				PRINTFORMW 「이봐, 그만해!」
			ENDIF
			;恋慕
		ELSEIF TALENT:恋慕
			;うふふ中(と言うか押し倒されてる)
			IF CFLAG:317
				SELECTCASE TCVAR:20
					;(ディープ)キス
					CASE 30,60
						PRINTFORMDL 당신은 당신의 혀로 %HIS_HER(54)% 입을 탐험하면서 패치울리의 엉덩이 쪽으로 손을 뻗는다.
						PRINTFORML 「응푸우!......아움흠음.」
						PRINTFORMDW 당신이 %HIM_HER(54)%를 만지기 시작하자 패치울리는 행복하게 키스를 깊게 한다.
						;抱きつかれる
					CASE 31,32
						PRINTFORMDL 패츄리를 안은 채, 당신은 부드럽게 %HIS_HER(54)%의 엉덩이를 쓰다듬는다.
						PRINTFORML 「아, 이건 그저 다정한 포옹이어야 하는 거 아닌가?」
						PRINTFORMDW 그렇게 말했음에도 불구하고, 패츄리는 %HIS_HER(54)%에게 \@ TCVAR:20 == 32 ? 등 뒤로 감싼다. # . \@
						;胸をもまれる
					CASE 36
						PRINTFORMDL 패치울리의 가슴을 만지는 동시에 그녀의 엉덩이도 더듬었다.
						PRINTFORMW 「아라, 내 가슴보다 내 엉덩이를 더 좋아하니?」
						;秘所への攻撃
					CASE 50 TO 53
						PRINTFORML 「아... 그런 식으로...... 응... 이게 대가야...」
						PRINTFORMDL 패치울리가 네 \@ HAS_PENIS(MASTER) ? 페니스를 # 보지 \@ 문지를 때, 너는 %HIM_HER(54)% 부드럽게 만졌다.
						SIF TCVAR:MASTER:107 && !NOWEX:0 && !NOWEX:3
							PRINTFORML 「하지만... 후우... 이번엔 내가 이길 거야...... 어서 와!」
						WAIT
						;飽きたから次回以降に追加
					CASEELSE
						PRINTFORML 「더... 더 힘을 실어봐... 나를 더 거칠게 만져줘......」
						PRINTFORMDW 당신은 패치울의 요구에 따르며 %HIS_HER(54)% 엉덩이를 더 강한 힘으로 만지기 시작한다.
				ENDSELECT
				;大成功
			ELSEIF TFLAG:193 == 1
				PRINT 「그/당신」
				SETCOLOR 0xff1493
				FONTITALIC
				PRINTFORM %UNICODE(0x2665)%
				FONTREGULAR
				RESETCOLOR
				CALL SET_KOJO_COLOR(TARGET)
				PRINTFORML ...젠장, 갑자기 무슨 일이야......」
				PRINTFORMDL 파츄리는 너를 바라보며 살짝 입술을 삐죽인다.
				PRINTFORMW 「만약 나를 애무할 거라면... 기분 좋게 해줘.」
				;大失敗？
			ELSEIF TFLAG:193 == -1
				PRINTFORMDL 당신은 패치울의 엉덩이를 만지려고 시도한다.
				PRINTFORMDL 하지만 그것을 알아챈 패치울이 %HIS_HER(54)% 부드러운 살을 향하는 당신의 손을 잡고 멈춘다.
				PRINTFORMW 「야, 갑자기 내 엉덩이 쓰지 마!」
			ELSEIF !RAND:4
				PRINTFORML 「%CALLNAME:MASTER%, 사람의 엉덩이를 쓰다듬는 것에 대한 호감이 있나요?」
				PRINTFORMDL 당신은 잠시 생각하더니, 그것이 자신이 좋아하는 감정이 아니라 상대방의 반응을 보는 것이라고 대답한다.
				PRINTFORML 「정말 끔찍해... 어째서 이런 사람에게 사랑에 빠진 걸까?」
				PRINTFORMDW %HIS_HER(54)%의 말에도 불구하고 패치울리는 따뜻하게 미소 짓는다. 
			ELSEIF !RAND:3
				PRINTFORML 「그리고 그게 이유야, 아...」
				PRINTFORMDW 당신이 %HIS_HER(54)%의 엉덩이를 쓰다듬자, %HIS_HER(54)%는 말을 하던 도중에 말을 멈추고 흐릿한 눈으로 당신을 바라본다.
			ELSEIF !RAND:2
				PRINTFORMDL 당신이 패치울의 엉덩이를 쓰다듬자, %HE_SHE(54)%은/는 %HIS_HER(54)% 얼굴에 침착한 표정으로 되돌아본다.
				PRINTFORMW 「그걸로 만족해?...... 하고 싶으면 계속해도 돼.」
			ELSE
				PRINTFORMDL 당신은 패치울에게 %HIS_HER(54)%의 엉덩이를 쓰다듬어도 괜찮은지 묻는다.
				PRINTFORMW 「갑자기... 좋아, 네 마음대로 해.」
			ENDIF
			;うふふ中(と言うか押し倒されてる)
		ELSEIF CFLAG:317
			PRINTFORML 「내가 너를 밀어붙였는데도 대담하구나.」
			PRINTFORMDL 파조울리가 %HIS_HER(54)%의 엉덩이를 더 세게 눌러 손을 누른다. 
			;うふふ解禁状態か親密Lv7以上
		ELSEIF CFLAG:6 >= 2 || ABL:9 >= 7
			;大成功
			IF TFLAG:193 == 1
				PRINTFORML 「왜 나한테 그렇게 관심이 있는 거야?」
				PRINTFORMDL 당신은 놀라운 통통함 때문에 기분이 좋다고 대답한다.
				PRINTFORML 「'놀랍다'는 표현은 무례한 방식이야, 알잖아.」
				PRINTDW 그렇게 말했지만, 패치울리는 즐거워 보인다.
				;大失敗？
			ELSEIF TFLAG:193 == -1
				PRINTFORMDL 당신은 패치울의 엉덩이를 쓰다듬는다.
				PRINTFORMW 「히야와... 아까 말했지, 나한테 경고 없이 만지지 말라고?」
			ELSEIF !RAND:2
				PRINTFORMW 「아... 뭐라고? 내 엉덩이를 만졌다고 내가 기분이 좋아질 거라고 생각했어?」
			ELSE
				PRINTFORML 「내 엉덩이를 쓰다듬고 싶다고 말하는군... 성적으로 좌절했나?」
				PRINTFORMDW 그렇게 말했음에도, 패치울리는 네가 %HIS_HER(54)%의 엉덩이를 어루만지는 것을 허락한다. 
			ENDIF
			;それ以外
		ELSE
			;大成功
			IF TFLAG:193 == 1
				PRINTFORML 「히야...... %CALLNAME:MASTER%...... 나한테 만지기 전에 허락받으라고 미리 말했잖아, 안 그랬어?」
				PRINTFORMDL 패치울리는 당신을 바라보며, %HIS_HER(TARGET)% 뺨이 약간 홍조를 띤다.
				PRINTFORMW 「음, 이번에는... 허락해 주지.」
				;大失敗
			ELSEIF TFLAG:193 == -1
				PRINTFORML 「...... 당장 그만둬. 이건 쓰다듬는 수준이 아니잖아. 너무 거칠어.」
				PRINTFORMDW 파츄리는 가늘게 눈을 뜨고 당신을 바라본다.
			ELSEIF !RAND:2
				PRINTFORMDL 당신은 패치울의 엉덩이에 손을 뻗지만 %HE_SHE(TARGET)%이 알아채고 당신의 손을 멈춘다.
				PRINTFORMW 「아가씨에게 만지려면 허락을 받아라.」
			ELSE
				PRINTFORMW 「예고 없이 누군가를 만지는 것은 매우 무례하다.」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K54_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K54_311
CALL M_KOJO_MESSAGE_COM_K54_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K54_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSE
		;初めて
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「...... 고통스러워요, 제발 저 좀 빨리 놓아주실 수 있나요?」
			PRINTFORMDW 그렇게 말하자 황급히 손을 놓고, 파츄리는 재빨리 빠져나갈 틈을 찾는다.
			;恋慕
		ELSEIF TALENT:恋慕
			;うふふ中
			IF CFLAG:317
				SELECTCASE TCVAR:20
					;(ディープ)キス
					CASE 30,60
						IF !RAND:3
							PRINTFORMDL %BREAKENG(@"너는 파츄리의 허리를 감싸 안고 %HE_SHE(54)%은(는) \@ TALENT:性別 == 2 ? 그의 # 그녀의 \@ 목을 감싸며 반응한다.")%
							PRINTFORMW 「음... 더...... 음.」
						ELSEIF !RAND:2
							PRINTFORMDL 당신은 파츌리의 몸과 뒤엉키며 키스를 끝낸다.
							PRINTFORML 「아...... 음, 응.」
							PRINTFORMDW 키스가 멈추자 파츌리의 입술이 쓸쓸해 보이지만, 지체 없이 당신은 그녀의 입술을 빼앗고 다시 키스를 시작한다.
						ELSE
							PRINTFORML 「아...... 후후, 당신을 연모해요.」
							PRINTFORMDW 파츄리는 당신이 자신을 안는 것에 기뻐하는 듯하다 %HIM_HER(54)%.
						ENDIF
						;後ろから抱きつかれた
					CASE 31
						IF RAND:2
							PRINTFORML 「나도 너를 안고 싶어...? 이걸 어쩌면 좋을까, 궁금하네.」
							PRINTFORMDL 파츌리가 뒤에서 당신을 끌어안으며 그것을 생각하는 듯하다.
							PRINTFORMW 「농담이었어, 여기.」
						ELSE
							PRINTFORMDL 당신은 파츌리에게 이 자세로는 그녀를 안아줄 수 없다고 말한다.
							PRINTFORMW 「그런 것 같네. 음, 괜찮아.」
						ENDIF
						;前から抱きつかれた
					CASE 32
						PRINTFORMDL 갑자기 %HE_SHE(54)%이 소리를 내자, 너는 파츌리의 향을 즐긴다.
						PRINTFORML 「아! 그렇게 거칠게 숨 쉬지 마... 가슴이 뜨거워져.」
						IF RAND:2
							PRINTFORMDW 일단 %HIM_HER(54)% 못 들은 척한다.
						ELSE
							PRINTFORMDW %BREAKENG(@"너는 파츄리의 품에서 얼굴을 들고, 이번에는 %HIM_HER(54)%을 안으며 %HIS_HER(54)%의 향기를 즐긴다 \@ TALENT:100 <= TALENT:MASTER:100 ? 머리. # 배꼽. \@")%
						ENDIF
						;手淫系
					CASE 34,50
						IF RAND:2
							PRINTFORML 「그렇게 세게 안으면 기분 좋게 해줄 수가 없어.」
							PRINTFORMDL 「그렇게 딱딱하게 껴안으면 기분 좋게 해줄 수 없어」
							PRINTFORMW 「아하하, 그래, 내가 너를 기분 좋게 해 줄게.」
						ELSE
							PRINTFORMDL 파츌리가 당신의 가슴에 %HIS_HER(54)% 머리를 기댄 채 %HIS_HER(54)% 손가락으로 당신을 애틋하게 만진다. 
							PRINTFORMW 「더욱 더 기분 좋게 해줄게......」
						ENDIF
						;その他
					CASEELSE
						PRINTFORMW 「무쿠우, 제발... 자, %CALLNAME:MASTER%, 너무 거칠잖아요.」
				ENDSELECT
				;大成功
			ELSEIF TFLAG:193 == 1
				PRINTFORML 「그냥 포옹이라고?」
				PRINTFORMDL 파츌리의 위로 향한 눈빛 속의 간청에 너는 결심한다.
				PRINTFORML 
				PRINTFORMLC [0] 키스한다 %HIM_HER(54)%
				PRINTFORMLC [1] 이마에 가볍게 입맞춤을 한다 %HIM_HER(54)%
				PRINTFORMLC [2] 모르는 척한다
				TINPUT 10000,3,0
				IF !RESULT
					PRINTFORMDL 당신은 파츌리를 키스한다.
					PRINTFORMW 「츄... 음... 사랑해.」
					EXP:MASTER:27 += 1
					EXP:27 += 1
				ELSEIF RESULT == 1
					PRINTFORMDL 당신은 파츌리의 앞머리를 쓸어 올리고 %HIS_HER(54)% 이마에 키스한다.
					PRINTFORMW 「한숨... 그렇게 해줬으면 했는데 조금 더 아래로...」
				ELSEIF RESULT == 2
					PRINTFORMDL 당신은 눈치채지 못하는 척 파츌리를 꽉 끌어안는다.
					PRINTFORMW 「음, 이런! 겁쟁이...」
				ELSE
					PRINTFORML 「결정할 수가 없어, 응...... 음.」
					PRINTFORMDW 파츌리가 당신의 얼굴을 %HIM_HER(54)% 자신 쪽으로 당겨 키스한다.
					EXP:MASTER:27 += 1
					EXP:27 += 1
				ENDIF
				;失敗
			ELSEIF TFLAG:193 == -1
				PRINTFORMDL 당신은 패치울을 한동안 껴안고 있다가, 어딘가에서 날카로운 쌕쌕거리는 소리를 듣는다.
				PRINTFORMDL %BREAKENG(@"당신은 파츄리에게 소리를 들을 수 있는지 물으려고 그녀를 붙잡던 힘을 풀지만, 파츄리는 당신의 옷자락을 움켜쥔 채 쓰러진다.")%
				PRINTDL 천식 발작인 것 같다.
				PRINTFORMDW 당신은 패치울리를 편안한 자세로 눕히고, 약을 가지러 달려가서 %HIM_HER(54)%에게 그것을 먹인다.
				;時間経過の追加
				TIME += 10
			ELSEIF !RAND:5
				PRINTFORML 「음...... 좋은 냄새가 나는구나.」
				PRINTFORMDL \@ DAY * 1440 + TIME - CFLAG:MASTER:314 >= 480 ? 땀에 젖었어? # 먼지가 쌓였어? \@ 네가 묻는다.
				PRINTFORMW 「그것을 걱정하기보다는, 나를 더 세게 안아줘.」
			ELSEIF !RAND:4
				PRINTFORML 「뒤에서 저를 안으시면 저는 그 포옹을 되돌려드릴 수가 없어요...」
				PRINTFORMDL %BREAKENG(@"너는 서둘러 팔에 힘을 빼려고 하지만 파츄리가 그것들을 껴안고 %HIS_HER(54)% 무게를 너에게 기댄다.")%
				PRINTFORMW 「하지만 이렇게 있는 게 좋네......」
			ELSEIF !RAND:3
				PRINTFORML 「……안겨 있는 게 어떤 기분일지 궁금해……」
				PRINTFORMD 패치볼리가 중얼거리자 당신은 
				IF TALENT:100 <= TALENT:MASTER:100
					PRINTDL 순간적으로 그녀의 허리를 붙잡고 공주 업하듯 들어 올린다.
					PRINTFORML 「히야! 갑자기 나를 들어 올리면 놀랄 거라는 게 명백하지 않았어?!」
				ELSE
					PRINTDL 떠다니는 것 같은 느낌일지 궁금해하며 대답한다.
				ENDIF
				WAIT
			ELSEIF !RAND:2
				PRINTFORML 「아... 잠시만 기다려줘...」
				PRINTFORMDL 파츄리는 잠시 당신에게서 떨어졌다가, %HIS_HER(54)% 다시 당신 쪽으로 돌아와 무언가를 중얼거린 후 몸을 돌린다. 
				PRINTFORML 「좋아, 이제 해도 돼.」
				PRINTFORMDW 파츄리가 말하며 %HIS_HER(54)% 팔을 활짝 벌려 당신에게 포옹을 청한다.
			ELSEIF CFLAG:溜まってる度 < 300
