@M_KOJO_EVENT_K54_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;Custom code, prevent reaction during timestop
	SIF FLAG:70
		RETURN 1
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕
			IF !RAND:2
				PRINTFORMDW 패치울리가 네가 들어온 걸 아직 눈치채지 못한 것 같다.
			ELSE
				PRINTFORMDW 파조울리의 표정이 부드러워진다, 당신이 들어오는 것을 %HE_SHE(54)%가 알아차리자.
			ENDIF
		ELSE
			IF !CFLAG:1001
				PRINTFORMDW 보라색 머리 소녀는 %HE_SHE(54)%이 당신을 알아볼 때 의심스럽게 미간을 찌푸린다.
			ELSEIF !RAND:2
				PRINTFORMDW 파즈만이 당신이 들어오는 것을 보고 \@ TCVAR:130 ? 잠시 후 # 무관심하게 \@ %HIS_HER(54)% 책 쪽으로 돌아본다.
			ELSE
				PRINTFORMDW 정신 차려보니 당신은 %HIM_HER(54)%과 이야기하기 위해 파츄리에게 다가갔다.
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕
			;気付いてたり気付いてなかったり
			IF !RAND:4
				PRINTFORMDL 파추리는 조용히 책을 읽으며 너를 알아차리지 못하는 것 같다 %COND_STR(@" and the others", CMATCH(CFLAG:320,0,1,CHARANUM) < 6)%.
				PRINTFORMDW %BREAKENG(@"너는(은) \@ CMATCH(CFLAG:320,0,1,CHARANUM) < 6 ? 그리고 다른 이들은 독서 중인 파츄리에게 폐를 끼치지 않으려 이동하고 # 독서 중인 파츄리에게 폐를 끼치지 않으려 조용히 지나간다 \@.")%
			ELSEIF !RAND:3
				PRINTFORMDL 파조울리가 무언가를 듣고 고개를 들더니 당신의 시선과 마주친다.
				PRINTFORMDW 당신은 어색하게 미소 짓고 파조울리는 이해한다는 듯 고개를 끄덕인 뒤 %HIS_HER(54)% 책으로 돌아간다.
			ELSEIF !RAND:2
				PRINTFORMDL 당신은 패치울이 책을 응시하며 무언가를 열심히 적고 있는 것을 알아차린다.
				PRINTFORMDW 당신은 혼잣말을 하며 메모 중인 패치울에게 방해하지 않고 지나가려고 한다. 
			ELSE
				PRINTFORMDL 패치울리가 당신이 들어오는 것을 알아채고 미소 짓는다.
				PRINTFORMDW 당신은 미소 짓는 패치울리의 머리를 한 번 쓸어넘기고 지나간다.
			ENDIF
		ELSE
			;その他
			PRINTFORML *꾸벅*
			PRINTFORMDW 파츄리는 계속 책을 읽으며 살짝 고개를 까딱한다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;まともに挨拶をしていない
		IF !CFLAG:1001
			PRINTFORMDW 보라색 머리의 소녀는 당신을 알아보고 한 번 흘깃 보지만, 당신이 멈추지 않을 것을 눈치채고 다시 %HIS_HER(54)% 책으로 돌아간다.
		ELSEIF !RAND:5
			PRINTFORML 「코아쿠마, \@ CFLAG:2:300 == CFLAG:3:300 ? 차 좀 타 줘. # 주변에 있니?\@」
			PRINTFORMDW 너를 알아차리지 않고 패치울리는 \@ CFLAG:2:300 == CFLAG:3:300 ? 코아쿠마에게 차를 부탁한다. # 코아쿠마를 찾는다. \@
		ELSEIF !RAND:4
			PRINTFORMDW 파조울리는 당신이 서둘러 지나가는 것을 그저 지켜본다.
		ELSEIF !RAND:3
			PRINTFORMDL 파츄리는 졸고 있어서 당신을 알아챌 상태가 아니다.
			PRINTFORMDW 지나가면서 파츄리를 흘긋 본다.
		ELSEIF !RAND:2
			PRINTFORMDL 패치울리가 당신을 보고 있다는 것을 깨닫고 %HIM_HER(54)%에게 고개를 숙인다.
			PRINTFORMDW 패치울리는 %HE_SHE(54)%가 다시 %HIS_HER(54)%로 돌아와 독서하는 것을 개의치 않는 듯하다.
		ELSE
			PRINTFORML 「.........」
			PRINTDW 파조울리는 독서에 너무 몰두해서 너를 알아차리지 못하는 것 같다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
