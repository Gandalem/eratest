@M_KOJO_EVENT_K54_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		;PRINTFORMWにしない方がいいでしょう
		;初めて会った
		IF CFLAG:1001 < 1
			PRINTFORM 전에 뵌 적이 없으신 것 같은데...? 
			;図書館
			IF CFLAG:現在位置 == 310
				PRINTFORML 뭐, 어쩔 수 없지. 나의 위대한 도서관에 온 걸 환영해.
				;パチュリー私室
			ELSEIF CFLAG:現在位置 == CFLAG:初期位置
				PRINTFORML 여긴 내 서재다. 나한테 용건이 있나?
				;それ以外
			ELSE
				PRINTFORML 그럼 당신은 누구죠?
			ENDIF
			CFLAG:1001 = 1
			;妊娠時
			;	ELSEIF CFLAG:6
			;bad妊娠
			;		IF なにがいいのかな？
			;			PRINTFORML 「いやあぁあああああああ近づかないで」
			;			PRINTFORML パチュリーは%CALLNAME:MASTER%が現れたのを見て恐怖している
			;good妊娠
			;		ELSE
			;			PRINTFORML 「%CALLNAME:MASTER%」
			;			PRINTFORML パチュリーは%CALLNAME:MASTER%の姿を見ると嬉しそうに声をかけてきた
			;		ENDIF
			;恋慕時
		ELSEIF TALENT:恋慕
			;部屋を同じにした
			IF CFLAG:MASTER:初期位置 == CFLAG:初期位置 && !CFLAG:1005
				PRINTFORMDL 당신은 패치울을 맞이하고 즉시 %HIM_HER(54)%에게 함께 살고 싶다고 말한다.
				PRINTFORML 「에? 아, 음-음... 잘 대해 주세요.」
				CFLAG:1005 = 1
				SIF CFLAG:1001 < 2
					CFLAG:1001 = 2
				;部屋を変えた
			ELSEIF CFLAG:MASTER:初期位置 != CFLAG:初期位置 && CFLAG:1005 == 1
				PRINTFORMDL 당신은 주저하며 패치울에게 이제부터 다른 방에서 살겠다고 말한다.
				PRINTFORML 「오... 그건... 유감하네요.」
				CFLAG:1005 = 2
				;部屋をまた同じにした
			ELSEIF CFLAG:MASTER:初期位置 == CFLAG:初期位置 && CFLAG:1005 == 2
				PRINTFORMDL 당신은 망설이며 패치울에게 %HIM_HER(54)%과 다시 함께 살고 싶다고 말한다.
				PRINTFORML 「알겠어... 이번에는 영원히 같이 살 수 있으면 좋겠다.」
				CFLAG:1005 = 1
				;恋慕初回のみ
			ELSEIF CFLAG:1001 < 2
				PRINTFORMDL 파츄리가 당신을 보는 순간, %HE_SHE(54)% 당신에게 가까이 오라고 손짓한다.
				PRINTFORMDL 당신은 %HIM_HER(54)%에게 다가가고 파츄리는 당신의 귓가에 속삭인다.
				PRINTFORML 「원할 때마다 이 열쇠를 사용해... 하지만 너무 많은 장난을 치지 않았으면 좋겠어.」
				CFLAG:1001 = 2
				;恋慕通常
			ELSE
				;図書館
				IF CFLAG:現在位置 == 310
					PRINTFORML 「%CALLNAME:MASTER%, 들어와라.」
					SIF CFLAG:1001 < 3
						PRINTFORML 「여기 있는 건 무엇이든 네가 원하는 대로 사용할 수 있어, 어느 정도는……. 나도 포함해서.」
					PRINTFORMDL %BREAKENG(@"패치울리가 옆자리에 %HE_SHE(54)%이 앉는 것을 만지고, 자신이 읽고 있던 책 쪽으로 고개를 돌린다. ")%
					;パチュリー私室
				ELSEIF CFLAG:現在位置 == CFLAG:初期位置
					;MASTERの開始位置がパチュリー私室以外
					IF CFLAG:MASTER:初期位置 != CFLAG:初期位置
						PRINTFORML 「내 서재에 온 것을 환영해. \@ YOGORE:311 >= 500 ? 청소하러 왔니? 아니면 나를 만나러 왔어? # 차 마시면서 이야기할까? \@」
					ELSE
						PRINTFORM 집에 온 걸 환영해. 
						;他に誰かいる
						IF GET_TARGETNUM() > 2
							PRINTFORML 차 한잔하지.
						ELSE
							;条件はINFO.ERBから拝借
							PRINTFORML \@NEMUKE() >= 720 ? 혹시 피곤한가요? 제 무릎을 빌려드릴 수 있어요. # 잠시 쉬러 오셨나요? 아니면 쉬러 오신 건가요? \@」
						ENDIF
					ENDIF
					;大浴場
				ELSEIF CFLAG:現在位置 == 333
					PRINTFORML 「%CALLNAME:MASTER%...! 갑자기 들어와서... 좀 민망하네...」
					;浴場が汚れていると台詞を追加
					CALL PRINT_DIALOGUE, @"아, 맞다. 지금 해야 할 말이 있었지. 목욕하고 싶어? \@ YOGORE:333 >= 500 ? 아니면 청소할 필요가 있어? # 아니면 나를 원해? \@"
					;それ以外
				ELSE
					PRINTFORMDL 파즈는 당신을 알아보고 천천히 다가온다.
				ENDIF
				CFLAG:1001 = 3
			ENDIF
			;それ以外
		ELSE
			;会った回数による口上
			IF TCVAR:350 > 5
				;馴れ合い強度で台詞の変更
				PRINTFORMDL \@ TCVAR:130 > 0 ? 패치울리가 너에게 다가오는데, %HE_SHE(54)%이 %HIS_HER(54)%에게 뭔가 담아둔 것 같다. # 「...... ......」 \@
			ELSEIF TCVAR:350 == 5
				;馴れ合い強度で台詞の変更
				PRINTFORML 「\@ TCVAR:130 > 0 ? 우리 자주 보잖아, 그렇지 않아? 하지만 괜찮아. # 날 스토킹하는 거야? 이건 우연이라고 하기엔 너무 심해! \@」
			ELSEIF TCVAR:350 == 4
				PRINTFORML 「...후, 우리 최근에 자주 보지 않았나?」
				;図書館
			ELSEIF CFLAG:現在位置 == 310 && RAND:2
				PRINTFORML 「청소 중인가? 마침 그럴 거면, \@ TCVAR:130 > 0 ? 나와 이야기 좀 해줄래? # 주변의 책들을 정리해줘.\@」
				;パチュリー私室
			ELSEIF CFLAG:現在位置 == CFLAG:初期位置 && RAND:2
				PRINTFORML 「언제나처럼 잘해줬어...... 아, 저 선반들은 만지지 않도록 조심해.」
				;大浴場
			ELSEIF CFLAG:現在位置 == 333
				PRINTFORML 「... 청소인가? 아니면 어쩌면 당신은 \@ GET_TARGETNUM() == 1 ? 나를 보려 했거나 # 누군가를 \@ 노출하려 했던 것 같다.」
				;それ以外
			ELSEIF RAND:2
				PRINTFORML 「딱 맞춰서 차 좀 타다 줄래.」
			ELSE
				PRINTFORML 「제때 오셨네요. 흥미로운 이야깃거리가 있으신지 궁금하군요.」
			ENDIF
		ENDIF
		TCVAR:350 ++
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:1001 < 1
			;図書館
			IF CFLAG:現在位置 == 310
				PRINTFORML 「여기에 무슨 일로 왔지? 이곳은 스칼렛 데빌 맨션의 대도서관이다.」
				;パチュリー私室
			ELSEIF CFLAG:現在位置 == CFLAG:初期位置
				PRINTFORML 「허락도 없이 내 방으로 들어오다니, 마치 어떤 생쥐처럼 말이다.」
				;それ以外
			ELSE
				PRINTFORM 오 마이, 보는 건 특이하네 
				;吸血鬼
				IF TALENT:MASTER:132
					PRINTFORM 레미와 %HIS_HER(16)% 언니가 아닌 흡혈귀 
					;狐とか動物耳
				ELSEIF TALENT:MASTER:90 || TALENT:MASTER:91 || TALENT:MASTER:143
					PRINTFORM 일부 괴물 
					;小人か巨躯
				ELSEIF TALENT:MASTER:100 == -3 || TALENT:MASTER:100 == 3
					PRINTFORM 인간이라니... 인간이라고? 뭐, 그냥 인간이지. 
					;それ以外
				ELSE
					PRINTFORM 인간 
				ENDIF
				PRINTFORML 이 저택 안에서.」
			ENDIF
			CFLAG:1001 = 1
			;恋慕
		ELSEIF TALENT:恋慕
			;部屋を同じにした
			IF CFLAG:MASTER:初期位置 == CFLAG:初期位置 && !CFLAG:1005
				PRINTFORMDL 당신은 패치울에게 인사하고 곧바로 %HIM_HER(54)%과 함께 살고 싶다고 말한다.
				PRINTFORML 「엣? 아, 음-흠... 잘 대해 주세요.」
				CFLAG:1005 = 1
				SIF CFLAG:1001 < 2
					CFLAG:1001 = 2
				;部屋を変えた
			ELSEIF CFLAG:MASTER:初期位置 != CFLAG:初期位置 && CFLAG:1005 == 1
				PRINTFORMDL 당신은 주저하며 패치울에게 앞으로 다른 방에서 살 것이라고 말한다.
				PRINTFORML 「아... 그건... 유감하네요.」
				CFLAG:1005 = 2
				;部屋をまた同じにした
			ELSEIF CFLAG:MASTER:初期位置 == CFLAG:初期位置 && CFLAG:1005 == 2
				PRINTFORMDL 당신은 망설이며 패치울에게 다시 %HIM_HER(54)%과 함께 살고 싶다고 말한다.
				PRINTFORML 「알겠어... 이번에는 영원히 같이 살 수 있으면 좋겠어.」
				CFLAG:1005 = 1
				;恋慕初回のみ
			ELSEIF CFLAG:1001 < 2
				PRINTFORMDL 파츄리가 당신을 보는 순간, %HE_SHE(54)% 당신에게 가까이 오라고 손짓한다.
				PRINTFORMDL 당신은 %HIM_HER(54)%에게 다가가고 파츄리는 당신의 귓가에 속삭인다.
				PRINTFORML 「원할 때마다 이 열쇠를 사용해... 하지만 너무 많은 장난을 치지 않았으면 좋겠어.」
				CFLAG:1001 = 2
				;恋慕通常
			ELSE
				;図書館
				IF CFLAG:現在位置 == 310
					PRINTFORML 「아, 여기 있었군요, %CALLNAME:MASTER%.」
					SIF CFLAG:1001 < 3
						PRINTFORML 「여기 있는 건 무엇이든 네가 원하는 대로 사용할 수 있어, 어느 정도는……. 나도 포함해서.」
					PRINTFORMDL 파즈프리(Patchouli)는 상냥하게 미소 지으며 %HIS_HER(54)%가 가장 좋아하는 자리에 앉았다.
					;パチュリー私室
				ELSEIF CFLAG:現在位置 == CFLAG:初期位置
					;MASTERの開始位置がパチュリー私室以外
					IF CFLAG:MASTER:初期位置 != CFLAG:初期位置
						PRINTFORML 「내 서재에 온 것을 환영해. \@ YOGORE:311 >= 500 ? 청소하러 왔니? 아니면 나를 만나러 왔어? # 차 마시면서 이야기할까? \@」
					ELSE
						PRINTFORM 돌아왔다. 
						;他に誰かいる
						IF GET_TARGETNUM() > 2
							PRINTFORML 차 좀 타 줄래.
						ELSE
							;パチュリーが眠い場合(就寝時間は2時だから余裕を見て前後1時間ずつ)
							PRINTFORMDL \@ TIME >= 60 && TIME <= 180 ? 후와...... 내 무릎 좀 빌려줄래? # 쉬고 있었어? 나랑 같이 쉴래? \@
						ENDIF
					ENDIF
					;それ以外
				ELSE
					PRINTFORMDL 패치울리가 네가 여기에 온 것을 깨닫고, %HE_SHE(54)%은 치어캣의 미소처럼 너에게 다가간다.
				ENDIF
			ENDIF
			;それ以外
		ELSE
			;会った回数による口上
			IF TCVAR:350 > 5
				;セクハラ強度で台詞の変更
				PRINTFORMDL \@ TCVAR:130 > 0 ? 패치울리가 너에게 다가오는데, %HE_SHE(54)%이 %HIS_HER(54)%에게 뭔가 담아둔 것 같다. # 「...... ......」 \@
			ELSEIF TCVAR:350 == 5
				PRINTFORML 「\@ TCVAR:130 > 0 ? 우리 자주 봤잖아, 그렇지 않나? 하지만 괜찮아. # 하아... \@」
			ELSEIF TCVAR:350 == 4
				PRINTFORML 「……후, 우리 요즘 자주 보지 않았나?」
				;図書館
			ELSEIF CFLAG:現在位置 == 310 && RAND:2
				PRINTFORML 「혹시 청소하러 오셨나요? 아, 주변의 책들이 읽고 이해하기가 어렵네요.」
				;パチュリー私室
			ELSEIF CFLAG:現在位置 == CFLAG:初期位置 && RAND:2
				PRINTFORML 「내가 없을 때는 여기 너무 자주 들어오지 말아줬으면 좋겠어.」
				;それ以外
			ELSEIF RAND:2
				PRINTFORML 「딱 제때 왔네, 차 좀 타다 줄래.」
			ELSE
				PRINTFORML 「아, 네가 여기 있었구나. 흥미로운 주제로 이야기할 것이 있는지 궁금하네.」
			ENDIF
		ENDIF
		TCVAR:350 ++
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕
			PRINTFORML 「청소하고 있었던 건가요? 안됐네요... 이 후에 또 더러워질 테니까.」
		ELSE
			PRINTFORML 「\@ TRAINNAME:PREVCOM == "掃除" ? 청소 중이야? 괜찮아, 내가 들어갈게. # 집에서 편안하게 지내고 있니? 나도 너랑 같이 목욕하러 갈게. \@」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「여기 있었어?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 「여기 있었어?」
		RETURN 1
	ENDIF
	;その他
	;PRINTFORML 「You were here?」
ENDIF
RETURN 1
