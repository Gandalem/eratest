	IF LOCAL:1 && ARG == 6
		PRINTFORML 「%CALLNAME:MASTER%......? 잠을 자는 거였나?」
		PRINTFORMDW 패치울리가 마법을 사용해 당신의 몸을 공중에 띄운 뒤, 방으로 옮긴다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
