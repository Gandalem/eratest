			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF

