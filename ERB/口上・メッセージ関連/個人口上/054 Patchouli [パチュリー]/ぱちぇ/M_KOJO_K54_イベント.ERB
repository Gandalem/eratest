@M_KOJO_EVENT_K54_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORMW 「유감스럽게도, 그만둬라.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;負けじと参加（馴れ合い度:高）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		LOCALS:0 = 
		IF ARG == [[レミリア]]
			LOCALS:0 '= @"레밀리아에게,"
		ELSEIF ARG == [[フラン]]
			LOCALS:0 '= @"여동생님,"
		ENDIF
		PRINTFORMW 「오 마이, %LOCALS:0% 너 뭔가 재미있는 걸 하는 것 같네. 나도 같이 하자.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		IF CFLAG:PLAYER:うふふ == 2
			PRINTFORMW 「우으...... 대체 이게 무슨 상황이지......」
		ENDIF
		RETURN 1
		;-------------------------------------------------
		;まぐわってた(MASTERが挿入中)
		;-------------------------------------------------
		IF MASTER_POSE(SET_V,SET_P,1)
			PRINTFORMW 「...... 딱 제 시간에 도착한 것 같네요.」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;まぐわってた(MASTERに挿入中)
		;記入チェック
		;-------------------------------------------------
		IF MASTER_POSE(SET_P,6,1)
			PRINTFORMW 「중간 삽입? 내 잘못이야.」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて参加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG:1 == 4
	;PRINTFORML
	;RETURN 1
	;ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
