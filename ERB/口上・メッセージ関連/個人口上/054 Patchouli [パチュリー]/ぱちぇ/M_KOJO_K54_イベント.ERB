		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			;時間によって変化
			PRINTFORML 「\@ BASE:体力 > 500 ? 잠자리에 들 시간이야. # 피곤하니까 나가 \@」
			PRINTFORMDW 패치울리가 문을 걸어 잠그기 전에 당신을 %HIS_HER(54)% 방에서 내보낸다.
		ENDIF
