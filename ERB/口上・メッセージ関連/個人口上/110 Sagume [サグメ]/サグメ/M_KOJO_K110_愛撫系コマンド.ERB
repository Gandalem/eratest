@M_KOJO_MESSAGE_COM_K110_0
CALL M_KOJO_MESSAGE_COM_K110_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K110_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 사구메의 전신을 애무했다.
			RETURN 1
		ELSE
			PRINTFORMW 「너무... 달라붙지 말아줘」
			PRINTFORMW 「느끼게 되니까...」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「읏……%UNICODE(0x2665) *1%아아앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「변태%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 그렇게 말하면서도 싫지만은 않은 기색이다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응%UNICODE(0x2665) *1%」
			PRINTFORMW 「더…… 만져줘…… %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「음……%UNICODE(0x2665) *1%……좋아해……%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「……윽……」
			PRINTFORMW (……조금 기분 좋았다……%UNICODE(0x2665) *1%)
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「민감하니까…… 너무 만지지 마……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……에치……. %UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 그렇게 말하면서도 행위를 받아들이고 있다.
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「……」
			PRINTFORMW 사구메는 말없이 얼굴을 붉히고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 몽롱한 눈으로 바라보고 있다.
		ELSE
			PRINTFORMW 「……윽……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 입에 손을 대고 소리를 지르는 것을 참는다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
