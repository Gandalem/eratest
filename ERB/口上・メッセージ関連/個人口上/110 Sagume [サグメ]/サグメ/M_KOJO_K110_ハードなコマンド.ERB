;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K110_140
CALL M_KOJO_MESSAGE_COM_K110_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K110_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「응...! 음음~」
		PRINTFORMW 「음훗... 입이... 침범당해버렸다... %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;出す直前
	IF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「으응!!!」
			PRINTFORMW 사구메는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목을 사용해 교묘하게 그것을 재촉하고 있다.
			PRINTFORMW 「츄릅……%UNICODE(0x2665) *1%……으응……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음...?」
			PRINTFORMW 사구메는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 목을 사용해 능숙하게 그것을 부추고 있다.
			PRINTFORMW 「질척... %UNICODE(0x2665) *1%... 쭈왑... %UNICODE(0x2665) *1%... 음츄... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……흠칫……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 목을 사용해 능숙하게 그것을 부추긴다.
			PRINTFORMW 「……음음……%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음... %UNICODE(0x2665) *1%」
			PRINTFORMW 「...격렬한 거... 좋아해... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏……츄읍……%UNICODE(0x2665) *1%……응읏……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……목구멍……%UNICODE(0x2665) *1%……범해줘……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응응... %UNICODE(0x2665) *1%...... 응응... %UNICODE(0x2665) *1%」
			PRINTFORMW 「더욱... %UNICODE(0x2665) *1%...... 목구멍 깊숙이 범해줘... %UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응...!!」
			PRINTFORMW 「...더... 성기 맛을 가르쳐줘...%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏……츄릅……%UNICODE(0x2665) *1%……응읏……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……목……%UNICODE(0x2665) *1%……범해 줘……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응~%UNICODE(0x2665) *1%……응응……%UNICODE(0x2665) *1%」
			PRINTFORMW 「좀 더……%UNICODE(0x2665) *1%……더럽혀서 목구멍 깊숙한 곳까지 내줘……%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응...!」
			PRINTFORMW 사구메는 목 깊숙이 페니스를 박히고 동요하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음~!」
			PRINTFORMW 「......더러운 냄새...... 목구멍에 배어버린다......」
		ELSE
			PRINTFORMW 「음~응...!!!」
			PRINTFORMW 사구메는 목구멍 깊숙이 페니스를 박히고 괴로운 듯 신음하고 있다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
