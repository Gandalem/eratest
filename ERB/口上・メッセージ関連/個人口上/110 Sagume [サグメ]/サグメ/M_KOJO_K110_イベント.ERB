				PRINTFORMW 「……함께……해줘……」
			ENDIF
		ENDIF
		TCVAR:110:発情 = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「……끝이야?」
			PRINTFORMW 사구메는 아쉬운 듯 몸을 떼었다.
