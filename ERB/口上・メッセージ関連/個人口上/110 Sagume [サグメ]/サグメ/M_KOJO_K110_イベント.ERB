					PRINTFORMW 「오늘은 즐겨보자, 그런 운명이라면 좋겠네」
				ELSEIF TALENT:思慕
					PRINTFORMW 「오늘은 어디로 갈지, 운명은 아직 정해지지 않았어.」
				ELSE
					PRINTFORMW 「지상은 자세히 몰라, 안내해 줘.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「그럼 다음에 다시 하도록 해요」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「……안타깝네」
				ELSEIF TALENT:思慕
					PRINTFORMW 「……운명이 바뀌었을까?」
				ELSE
					PRINTFORMW 「......지상인은 차갑네......」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%、家に来ないかしら？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「내 집으로 지금 올 거야?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「…우리 집에 안 올래?」
				ELSE
					PRINTFORMW 「있잖아, 시간 돼?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「이런 건 연인 같네」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「......너무 집 찾지 말아줘」
				ELSEIF TALENT:思慕
					PRINTFORMW 「…이상한 짓은 하지 말아줘」
				ELSE
					PRINTFORMW 「과자 정도는 내 줄게.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「……안타깝네」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「......그런 운명인 거군요」
				ELSEIF TALENT:思慕
					PRINTFORMW 「……유감이네」
				ELSE
					PRINTFORMW 「……」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
