@M_KOJO_EVENT_K110_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「있잖아, %CALLNAME:MASTER%, 데이트하자%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 부탁이 있는데」
					PRINTFORMW 「......데이트...하자」
				ELSEIF TALENT:思慕
					PRINTFORMW 「저기, 데이트... 안 할래?」
				ELSE
					PRINTFORMW 「……%조사처리(CALLNAME:MASTER,"와")% 데이트하자」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「그럼, 어디에 가고 싶어? %조사처리(CALLNAME:MASTER,"가")% 가고 싶은 곳으로 가고 싶어.」
