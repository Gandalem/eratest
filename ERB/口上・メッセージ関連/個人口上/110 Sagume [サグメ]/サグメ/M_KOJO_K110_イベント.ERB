@M_KOJO_SPEVENT_K110_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1110)
			PRINTFORMW  「저기, %CALLNAME:MASTER%」
			PRINTFORMW  사구메는 조심스럽게 말을 꺼냈다.
			PRINTFORMW  입을 손으로 가리고 몇 초간 생각한 뒤 조금씩 입을 열었다.
			PRINTFORMW  「저, 있잖아요」
			PRINTFORMW  「오늘은 즐거웠어요」
			PRINTFORMW  「고마워요」
			PRINTFORMW  「딱 하나만, 고백하고 싶은 게 있어요」
			PRINTFORMW  
			PRINTFORMW  「%조사처리(CALLNAME:MASTER,"가")% 좋아」
			PRINTFORMW  「%조사처리(CALLNAME:MASTER,"와")% 함께라면 나는 타락해도 돼」
			PRINTFORMW  「꿰뚫려버렸어, 나의 마음이」
			PRINTFORMW  「이런 기분은 처음이라 어떻게 해야 할지 모르겠지만」
			PRINTFORMW  「하지만 무서운 게 아니라, 이 감정이 즐거워」
			PRINTFORMW  「%조사처리(CALLNAME:MASTER,"와")% 함께 있을 수 있다는 것이 기쁘고」
			PRINTFORMW  「%조사처리(CALLNAME:MASTER,"와")% 이야기하는 것이 정말 좋아」
			PRINTFORMW  「더 %조사처리(CALLNAME:MASTER,"와")% 함께 있고 싶어」
			PRINTFORMW  「더 %CALLNAME:MASTER%에 대해 알고 싶어」
			PRINTFORMW  「더 %조사처리(CALLNAME:MASTER,"와")% 여러 가지를 보고 싶어」
			PRINTFORMW  「……」
			PRINTFORMW  「나로는... 안 될까...?」
			;二回目の告白
		ELSE
			PRINTFORMW 「……끈질길지도 모르겠지만」
			PRINTFORMW 「좋아해……%조사처리(CALLNAME:MASTER,"를")%……」
			PRINTFORMW 「그렇다면 몇 번이든 운명을 역전시켜 보여주겠어」
			PRINTFORMW 「그러니까……부탁이야……너의 곁에 있게 해줘……」
			PRINTFORMW 사구메는 간청하듯 이쪽을 바라보고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「......정말?」
		PRINTFORMW 「......진짜 정말이야?」
		PRINTFORMW 「……」
		PRINTFORMW 「정말 좋아해」
		PRINTFORMW 사구메는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 안겨왔다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……」
		PRINTFORMW 「……알았어」
		PRINTFORMW 「……하지만……」
		PRINTFORMW 「좋아해서……그래서……」
		PRINTFORMW 사구메는 그렇게 말하고 떠났다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K110_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……」
			PRINTFORMW 사구메는 말없이 가버렸다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「음…… 그럼 안녕……」
			PRINTFORMW 「…… 또, 내일 봐」
			PRINTFORMW 사구메는 부끄러워하며 작별 인사를 건넸다.
			PRINTFORMW (만날 수 있겠지……)
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……그럼 안녕……」
			PRINTFORMW 「또, 만나자」
			PRINTFORMW 사구메는 그렇게 말하고 떠났다
			PRINTFORMW (만날 수 있다면…… 좋겠어……)
		ELSEIF TALENT:思慕
			PRINTFORMW 「오늘은 여기까지」
			PRINTFORMW 「즐거웠어... 그럼 잘 가...」
			PRINTFORMW 사구메는 그렇게 말하고 떠났다
		ELSE
			PRINTFORMW 「그럼... 안녕」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
	ELSEIF TALENT:恋人
		PRINTFORMW 「별로...」
		PRINTFORMW 「이제 화 안 났어」
		PRINTFORMW 「용서해」
	ELSE
		PRINTFORMW 「화내지 않았어」
		PRINTFORMW 「이건 정말이야」
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;反発刻印2>1レベルダウンイベント
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 2
	IF TALENT:恋人
		PRINTFORMW 「좋지만, 아직 화나 있어」
		PRINTFORMW 「아직 진심을 느낄 수 없어」
	ELSE
		PRINTFORMW 「알았어...」
		PRINTFORMW 「하지만 아직 화나 있어」
		PRINTFORMW 사구메는 아직 조금 화가 난 듯하다.
		PRINTW
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;反発刻印3>2レベルダウンイベント
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 3
	IF TALENT:恋人
		PRINTFORMW 「……」
		PRINTFORMW 「조금만 용서해 주겠다」
	ELSE
		PRINTFORMW 「안 돼…」
		PRINTFORMW 「용서 못 해」
		PRINTFORMW 사구메는 그래도 조금만 분노를 가라앉혔다.
		PRINTW
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
