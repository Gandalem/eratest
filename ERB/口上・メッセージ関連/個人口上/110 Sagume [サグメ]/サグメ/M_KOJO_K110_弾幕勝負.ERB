; Modular ERB: 個人口上/110 Sagume [サグメ]/サグメ/M_KOJO_K110_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K110_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「『영원히 죽어라』!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「……」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「...시험해 볼게, 당신의 힘을」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......더러움에 뒤덮인 지상인 따위에게 질 리 없는 나야」
		ELSE
			PRINTFORMW 「……「덧없이 지는 것이 좋다」!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「……！」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「...맞았어?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「......이 정도로는」
				ELSE
					PRINTFORMW 「……우연이네」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……！」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「……말도 안 돼……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「……운이 아니야?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...... 의외로 강하네.」
				ELSE
					PRINTFORMW 「이대로라면 당신이 이기겠네」!
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……이……!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「……졌다……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「......실력은 있는 것 같네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……っ！」
				ELSE
					PRINTFORMW 「……！！！」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...언제 죽는 거야?」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「......별일 없었네」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「……어차피 지상인이군」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……살아있어?」
				ELSE
					PRINTFORMW 「……」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「귀찮네, 고집 세군」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「......별로 강하지는 않았어」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「……꽤 강하네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……」
				ELSE
					PRINTFORMW 「……」
					PRINTFORMW 사구메는 조금 흥미롭게 이곳을 보고 있다.
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...지체시켜 주는군」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「……꽤 강하네.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「…이쪽도 궁지에 몰리고 있었어… 이길 수 있었던 건 우연일까」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……아슬아슬했네」
				ELSE
					PRINTFORMW 「……」
					PRINTFORMW 사구메는 흥미롭다는 듯이 이쪽을 보고 있다.
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……천박한 것들이」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「……강하구나, %CALLNAME:MASTER%」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「……졌나……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……지상인의 힘이란 무시할 수 없네」
				ELSE
					PRINTFORMW 「……」
					PRINTFORMW 사구메는 흥미롭게 이쪽의 얼굴을 들여다보고 있다.
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
