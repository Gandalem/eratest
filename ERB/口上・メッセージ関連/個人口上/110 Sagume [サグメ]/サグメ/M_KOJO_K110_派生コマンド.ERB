@M_KOJO_MESSAGE_SCOM_K110_6
CALL M_KOJO_MESSAGE_SCOM_K110_6_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K110_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 사구메의 질 내부를 깊이 범하기 시작했다.
		ELSE
			PRINTFORMW 「거기……%UNICODE(0x2665) *1%」
			PRINTFORMW 「응……%UNICODE(0x2665) *1%……아아……%UNICODE(0x2665) *1%」
			PRINTFORMW 그 은밀한 곳에 %조사처리(CALLNAME:MASTER,"의")% 음경이 천천히 삽입되어 갔다……
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 사구메를 깊이 범하기 시작했다.
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 천천히 사구메의 질 안에 음경을 넣었다 빼기를 하고 있다.
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「흐윽... %UNICODE(0x2665) *1%... 으음... %UNICODE(0x2665) *1%」
			PRINTFORMW 「...아앗... %UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 행위로 거친 숨을 몰아쉬고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흡……야한 거야……깊어……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……앗……%UNICODE(0x2665) *1%……윽……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「윽……%CALLNAME:MASTER%……아……%UNICODE(0x2665) *1%」
			PRINTFORMW 「응 아……많이……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 격렬한 행위에 신음하고 있다.
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아앗……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……거기……%UNICODE(0x2665) *1%……응앗……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽……윽……%UNICODE(0x2665) *1%」
			PRINTFORMW 「성기…… 커지고 있어……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「윽……후아……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……으윽……거기……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 격렬한 행위에 신음하고 있다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「윽……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……앗……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아……」
			PRINTFORMW 「……음윽……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「……응아……%UNICODE(0x2665) *1%」
			PRINTFORMW 「크윽……안 돼……%UNICODE(0x2665) *1%」
			PRINTFORMW 사구메는 격렬한 행위에 신음하고 있다.
		ENDIF
	ENDIF
ENDIF
