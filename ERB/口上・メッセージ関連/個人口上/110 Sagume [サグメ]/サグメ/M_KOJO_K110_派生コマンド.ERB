@M_KOJO_MESSAGE_SCOM_K110_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 사구메의 가슴을 범하며 구강에 음경을 박았다.
		ELSE
			PRINTFORMW 「……음……질척……」
			PRINTFORMW 「이렇게……?」
			PRINTFORMW 사구메는 가슴으로 음경을 문지르며 끝을 빨고 있다.
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 사구메의 가슴을 범하며 구강에 음경을 박았다.
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……어때?…… 기분 좋아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……음……크지만……」
		ELSE
			PRINTFORMW 「……기분 좋게 해 줄게……」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아……응……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……가슴으로……잘……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응아... 이렇게...?」
			PRINTFORMW 「응츄... 레로... 응!」
		ELSE
			PRINTFORMW 「……응……이거……」
			PRINTFORMW 「……먹어봐……쪽……」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「……음……이게 좋아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......어때?」
		ELSE
			PRINTFORMW 「……」
			PRINTFORMW 사구메는 말없이 음경을 가슴으로 완전히 덮고 있다.
		ENDIF
	ENDIF
ENDIF
