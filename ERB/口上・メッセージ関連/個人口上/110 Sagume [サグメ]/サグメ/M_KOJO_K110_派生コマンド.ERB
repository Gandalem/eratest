@M_KOJO_MESSAGE_SCOM_K110_5
CALL M_KOJO_MESSAGE_SCOM_K110_5_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K110_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 사구메의 구강을 범하기 시작했다.
		ELSE
			PRINTFORMW 「……응추……레로……」
			PRINTFORMW 「아……앗……손……끈적끈적해……」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 사구메의 손에 음경을 잡힌 채 구강을 범하기 시작했다.
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응……쪽……」
			PRINTFORMW 「……응……나 나오는 거야……?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흡……응……」
			PRINTFORMW 「……먹어줘……」
		ELSE
			PRINTFORMW 「윽... 주읍... 해줘...」
			PRINTFORMW 「...응... 많이... 내줘... %UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아...... 주루...... 주부......」
			PRINTFORMW 「......응...... 레로옷......」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭈읍... 넣어줘... 응...」
			PRINTFORMW 「응... 더... 가득...」
		ELSE
			PRINTFORMW 「……더러워……」
			PRINTFORMW 「……먹어라……깨끗하게 해줄게……%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「흐읍...... 츄릅......」
			PRINTFORMW 「응...... 맛없어......」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......흐읍...」
			PRINTFORMW 「......응... 커...」
		ELSE
			PRINTFORMW 「……음……쪽……」
			PRINTFORMW 「쭈욱……응……」
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K110_{SELECTCOM}_1
RETURN 1
