@M_KOJO_MESSAGE_COM_K110_80
CALL M_KOJO_MESSAGE_COM_K110_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K110_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 순간 속에서 사구메의 손에 성기를 잡게 했다.
		ELSE
			PRINTFORMW 「……？」
			PRINTFORMW 「……알았어, 거시기 꺼내 봐」
			PRINTFORMW 사구메는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 음경을 잡았다.
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 순간 속에서 사구메의 손에 성기를 잡게 했다.
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「...슬슬 내보낼까...?」
			PRINTFORMW 그렇게 말하자 사구메는 더욱 격렬하게 움직이기 시작했다.
			PRINTFORMW 「야한 액체... 많이 내줘... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「거시기 커지고 있어...%UNICODE(0x2665) *1%」
			PRINTFORMW 그렇게 말하자 사구메는 더욱 격렬하게 움직이기 시작했다.
			PRINTFORMW 「하얀 거... 내줘...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「……참을 수 없는 액체…… 넘쳐흘러…… %UNICODE(0x2665) *1%」
			PRINTFORMW 그렇게 말하자 사구메는 더욱 격렬하게 애지작하기 시작했다.
			PRINTFORMW 「거기(좆)가 파르르 떨리고 있어……」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「커졌어……. 단단해져 있어……」
			PRINTFORMW 「만져줬으면 해?」
			PRINTFORMW 사구메는 그렇게 말하며 음경을 문지르고 있었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응... 야한 거 보니까 거시기 커지고 있어... %UNICODE(0x2665) *1%」
			PRINTFORMW 「...사정하면... 더럽게... 쌓이는 게 좋지 않아...」
			PRINTFORMW 사구메는 그렇게 말하면서
		ELSE
			PRINTFORMW 「음...... 크다......」
			PRINTFORMW 「내버려…… 안 돼…… 기분 좋은 건 참는 게 좋아」
			PRINTFORMW 사구메는 그렇게 말하면서도 음경을 비비고 있다.
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응, 내줘... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「정액, 내줘」
			PRINTFORMW 사구메는 그렇게 말하며 음경을 쓸어 올리고 있다.
		ELSE
			PRINTFORMW 「많이… 싸줘…」
			PRINTFORMW 「……더… 쌓여있어?」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「더러워...」
			PRINTFORMW 사구메는 그렇게 말하면서도 성기를 쓸어 올리는 손을 멈추지 않는다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……」
			PRINTFORMW 사구메는 진심으로 싫다는 표정을 지으며 %조사처리(CALLNAME:MASTER,"의")% 음경을 문지르고 있다.
		ELSE
			PRINTFORMW 「……응……여기?」
			PRINTFORMW 「……느끼고 있어?」
			PRINTFORMW 사구메는 싫다는 표정을 지으면서도 %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해주려고 열심히 음경을 문지르고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
