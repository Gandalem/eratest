; Modular ERB: 個人口上/064 Yuugi [勇儀]/勇儀/M_KOJO_K64_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K64_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;名乗り口上
		IF !CFLAG:64:1002 && !CFLAG:64:弾幕勝負勝利
			PRINTFORMW 「먼저, 우리가 싸우기 전에 나를 소개할게.」
			PRINTFORMW 「좀 길어지겠지만, 참아줘 부탁이야.」
			PRINTFORMDW 유우기는 깊은 숨을 쉬고 당신에게 시선을 고정하며 당신을 살핀다.
			PRINTFORMW 「내 이름은 호시구마 유우기야. 봐, 아주 멋진 오니 종족이지!」
			PRINTFORMW 「예전엔 산의 사대장 중 한 명으로 알려져 있었지만, 그건 아주 먼 옛날 이야기야.」
			PRINTFORMW 「요즘은 '오래된 지옥' 온천 마을이라는 리조트 지구를 책임지고 있어.」
			PRINTFORMW 「그렇다고 오니 본능을 잊었다는 뜻은 아니지!」
			PRINTFORMW 「나는 여전히 강한 상대와 싸우고 싶어! 목숨을 걸고 싸우고 싶다고!」
			PRINTFORMDW 유우기는 가슴을 두드리며, 내면에서 타오르는 열정에 용기를 얻는다.
			PRINTFORMW 「――너에 대한 소문을 좀 들어왔거든. 네가 최고 중 한 명이라고 하던걸.」
			PRINTFORMW 「그래서 말인데, 우리 시합 한번 할래? 그 이야기들 사실이지, 안 그래?」
			PRINTFORMW 「내 두 눈으로 네 강함을 직접 보고 싶어. 그리고 운이 내 편이라면, 음...」
			PRINTFORMDW 그녀는 참지 못하고 웃는다.
			PRINTFORMW 「――후후, 이래저래 떠들 시간에 됐어. 솔직히 난 처음부터 제대로 된 싸움이 간절했거든!」
			PRINTFORMW 「그리고 네 눈빛! 그 비웃음! 나를 아무것도 아닌 것처럼 보는 그 시선!」
			PRINTFORMW 「...그런 식으로 날 쳐다보지 말아 줄래?」
			PRINTFORMW 
			PRINTFORMW 「――그게 나를 ... 먼지가 될 때까지 록앤롤하고 싶게 만들거든!!!」
			CFLAG:64:1002 = 1
			;通常
		ELSE
			SELECTCASE IFRAND("0TO2", 1, "D2", TALENT:妊娠 || TALENT:育児中)
				CASE 0
					PRINTFORML 「싸우고 싶어? 오오, 그러고 싶어!」
					PRINTFORML 「딱 필요한 운동였지!」
					PRINTFORMDW 유우기는 어깨를 돌리고 스트레칭을 한다. 끝내자 그녀는 당신에게 간절한 눈빛을 보낸 뒤 고개를 끄덕인다.
				CASE 1
					PRINTFORML 「이번엔 참을 필요 없겠지, 그치?」
					PRINTFORMW 「뭐라고 했어? 어라, %MASTERNAME:64%?」
				CASE 2
					PRINTFORMDL 유우기(Yuugi)는 자신의 접시에 사케를 따르고... 그것을 전부 마신다!
					PRINTFORML 「"이걸 흘리게 만들 수 있다면"... 쳇, 너무 시시한 소리야! 안 그래?」
					PRINTFORML 「만약 뭔가 해볼 생각이 있다면, 네가 온 마음과 영혼을 다해 임하는 걸 보고 싶다고 말해주고 싶어.」
					PRINTFORML 「그건 너한테 문제가 되지 않겠지?」
					PRINTFORMDW 그녀는 눈썹을 치켜뜨리며 활기찬 어조로 묻는다.
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 「우와 거기 서! %SPLIT_G(@"You're one tough %PRINT_MALE("guy", MASTER)%, %MASTERNAME:64%! I like it!:You're pretty good, I gotta say!")%」
				PRINTFORMW 「이제 드디어 일어나고 정신이 들었어! 고맙다고 해야겠네!」
			CASE 1
				PRINTFORML 「이걸로 끝내자!」
				PRINTFORMW 「빅 포 아카눔――"3단계에 처치!"!!!」
				;added by linguine
				PRINTFORMDW %BREAKENG(@"유우기가 한쪽 다리를 높이 들고 발로 공중을 가르며 땅에 내리치자 %SPLIT_G("fracturing the surface with many lines tearing out from the center:fragmenting the surface underneath:rending the surface asunder")%.")%
				PRINTFORMDW %BREAKENG(@"그녀는 반쯤 웅크린 자세로 양옆에 팔을 들고 다른 발로 같은 동작을 반복하자 너는 그 행동 때문에 비틀거렸다.")%
				PRINTFORMDW 기이하고 다채로운 에너지들이 땅에서 솟아올라 그녀의 형체 주위를 소용돌이친다.
				PRINTFORMDW %BREAKENG(@"얼음 총알로 이루어진 빽빽한 벽이 나타나 유우기를 에워싸고, 이어서 훨씬 성긴 형태로 다시 형성되면서 주변이 흔들리고 너는 멈추거나 맞게 된다.")%
				PRINTFORMDW %BREAKENG(@"유우기가 자신 안으로 더 많은 세상의 힘을 끌어들이고 마지막 불가침의 막이 당신 뒤쪽에서 더욱 단단해지기 직전, 땅이 잠시 더 진동한다.")%
				PRINTFORMDW 마침내, 그녀는 손가락을 튕기자 모든 것이 움직이기 시작했고, 당신은 각 투사체 사이를 헤치고 지나가야 했다.
				PRINTFORMDW 그녀는 그 과정을 반복하고 또 반복했다...
				HANDICAP_RAND = 100
			CASE 0
				PRINTFORMW 「훌륭해! 네가 내가 바랐던 모든 것이 되었어!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORML 「――――――%SPLIT_G("AaaaaaaaaaaAAAAAAAAAAAAAHHHHHHHHHHHHHH:UuuuUUUUUUUUUUUHHHHHHHHHHHHH:RrrrrraaaaaaaaaAAAAAAAAAAAGHHHHHHHHHHHHHHH")%!!!!!!」
		PRINTFORMDL 오니의 거대한 포효가 거의 당신의 고막을 파열시킬 정도였다.
		PRINTFORMDL 당신이 날린 단마쿠는 공중에서 소리만으로 사라지거나 흔적도 없이 사라졌다.
		PRINTFORMW 「하아앗! 자, 그럼 다시 시작해 보자!」
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 「아이고, 정말 네가 이 정도로 못할 줄은 몰랐는데...」
				PRINTFORMDL 잠시 유우기가 생각에 잠긴 표정으로 턱을 문지르다가 당신을 바라본다.
				PRINTFORMW 「%SPLIT_G("Wanna rematch sometime?:Wanna give it another shot?")% 내가 가장 좋은 사케 한 잔 따라줄게!」
			CASE 2
				PRINTFORML 「꽤 괜찮은데, 인정해줘야겠어.」
				PRINTFORMDL 유우기가 눈을 찡긋하며 말했다.
				PRINTFORMW 「하지만 승리는 내 거야. 나중에 다시 붙자!」
			CASE 1
				PRINTFORML 「정말 신났어. 이렇게 기분 좋았던 건 오랜만이야!」
				PRINTFORMDL 유우기는 명랑한 미소를 지으며 팔짱을 낀다.
				PRINTFORMW 「자, 이제 목욕하고 상쾌하게 하자! 같이 가는 거지?」
			CASE 0
				PRINTFORML 「승리했어! 정말 완벽하게 패배했거든!」
				PRINTFORML 「지금 당장 내 머리를 줄 수 있는데... 네가 원하지 않는다고 했지, 맞지?」
				PRINTFORMW 「후후, 그렇다면 이걸 받아. 너의 당연한 승리를 축하하며. 건배!」
				PRINTFORMDL 유우기가 뒤쪽에서 술병을 꺼낸다.
				PRINTFORMDL 빚은 액체를 붉은 그릇에 따서 건네지만, 당신은 정중하게 거절한다.
				PRINTFORMDL 그녀는 그것에 눈썹을 치켜떴지만 곧 어깨를 으쓱했다%COND_STR(@", downing the sake in one continuous swig", !(TALENT:妊娠 || TALENT:育児中))%.
				SIF !(TALENT:妊娠 || TALENT:育児中)
					CALL RECOVER(TARGET, 200, "酒気", " ")
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
