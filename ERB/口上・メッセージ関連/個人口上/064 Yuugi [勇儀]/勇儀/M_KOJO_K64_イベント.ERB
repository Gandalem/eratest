IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:恋慕
			PRINTFORML 「...후, 벌써 돌아왔네.」
			PRINTFORML 「하지만 뭔가 부족한 느낌이 들어. 이참에 술이나 한 잔 할래?」
			PRINTFORMDW 유우기는 그녀에게 잠시 쉬라고 말하며 농담하는 것뿐이라고 웃는다.
		ELSEIF TALENT:思慕
			PRINTFORML 「%SPLIT_G("오늘 재미있었어:오늘 정말 즐거운 시간 보냈어")%!」
			PRINTFORMW 「다시 나랑 데이트해 줄래?」
		ELSE
			PRINTFORML 「나 시간 잘 보낸 것 같아.」
			PRINTFORMW 「가끔 이런 경험을 하는 건 좋지.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「좋아. 그냥 깔끔하게 끝내자고, 알겠지? 지난 일은 잊어버리자는 거지.」
		PRINTFORMDL 무슨 일이 있었을지 궁금하겠지만, 그녀는 너를 용서해 준 것 같아.
		PRINTFORML 「무슨 일이야? 엄청 행복해 보이는데, 그렇지 않아?」
		PRINTFORML 「음, 그럼 그걸로 됐어... 하지만 만약 네가 다시 그런 짓을 한다면...」
		PRINTFORML 「그때 무슨 일이 생길지는 말 안 해도 되겠지, 그치?」
		PRINTFORMDW 안도의 한숨이 입에서 새어 나왔다. 드디어 끝난 것이다. 유우기의 단호한 경고를 마음속에 새기려 한다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「...너 정말 대단한 배짱이 있구나.」
		PRINTFORML 「내 말은, 일단 오니를 건드리고, 그러고는 그녀와 데이트까지 신청하다니.」
		PRINTFORML 「네가 무슨 짓을 꾸미는지 나에게 말할 때라고 생각해. 말해봐!」
		PRINTFORMDL 유우기는 집에 가는 길에 믿을 수 없다는 듯한 표정으로, 가느다란 눈으로 당신을 옆에서 흘겨보며 분위기를 깬다.
		PRINTFORMDL 당신이 평화를 원한다고 설명하자, 유우기는 걸음을 멈추고 나무 같은 시선으로 완전히 몸을 돌린다.
		PRINTFORMDL 그러자 넓은 미소가 그녀의 입가에 번진다.
		PRINTFORML 「푸하...! 아-하하!」
		PRINTFORML 「솔직히 말해서... 너 정말 재미있는 %PRINT_MALE("guy", MASTER)%, %MASTERNAME:64%구나!」
		PRINTFORMDW 유우기는 약간 기분이 나아진 채 앞으로 걸어가며 그렇게 말했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「...하아, 정말이지.」
		PRINTFORML 「헤어질 때 네 얼굴을 주먹으로 치려고 생각했는데...」
		PRINTFORMDL 유우기가 뒤에서 뭔가 불길한 것을 중얼거린다...
		PRINTFORMW 「뭐, 됐겠지 뭐...」
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K64_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF !TCVAR:64:今日会ったか
			IF TALENT:恋慕
				PRINTFORML 「%MASTERNAME:64%! 이리 와봐!」
				PRINTFORMDL 유우기가 당신에게 인사한 후 손과 밝은 미소로 당신을 부른다.
				PRINTFORMW 「오늘 뭐 할 계획이야? 네가 하고 싶은 거라면 뭐든지 같이 해줄게!」
			ELSEIF TALENT:思慕
				PRINTFORML 「오, %MASTERNAME:64%. 네가 나를 보러 올 줄은 몰랐어.」
				PRINTFORMW 「금방 들를 생각이었는데, 네가 수고를 덜어줬네.」
			ELSE
				PRINTFORML 「오 이런, %MASTERNAME:64%이시군요!」
				PRINTFORMW 「제가 해드릴 수 있는 게 있나요?」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF !TCVAR:64:今日会ったか
			IF ABL:親密 >= 3 && !TALENT:妊娠 && !TALENT:育児中 && !RAND:5
				PRINTFORML 「오, 여기 있었네.」
				PRINTFORMDL 유우기가 술병을 손에 들고 당신에게 다가온다.
				PRINTFORMDL 그녀는 당신에게 닿기 전에 호기심 어린 순간 술을 들어 살펴보더니 다시 당신을 바라본다.
				PRINTFORML 「사실 좋은 술을 좀 구했는데... 혼자 마시려니 좀 외롭네.」
				PRINTFORMW 「나랑 같이 한잔할래?」
				CALL GET_ITEM("鬼殺し", 1, 1)
			ELSEIF TALENT:恋慕
				PRINTFORML 「오옷! %MASTERNAME:64%! 여기 있었네!」
				PRINTFORMW 「%SPLIT_G("네가 언제 나타날까 궁금했어: 못 찾을 때 걱정했어")%!」
			ELSEIF TALENT:思慕
				PRINTFORML 「Yo! %MASTERNAME:64%!」
				PRINTFORMW 「시간이 좀 남아있어서 %SPLIT_G("to visit:to hang out:here to play")%에 왔다.」
			ELSE
				PRINTFORMW 「안녕, %MASTERNAME:64%. 괜찮다면 내가 들어갈게.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「안녕, %MASTERNAME:64%. 물은 어때?」
		PRINTFORMDL %BREAKENG(@"유우기는 아무런 꾸밈없이 당신에게 다가와 욕조 안으로 발을 들였고, 그녀의 은밀한 곳은 완전히 노출된 채였다.")%
		PRINTFORMDL 당신은 얼굴이 달아오르는 것을 느끼며 재빨리 시선을 돌린다.
		PRINTFORML 「얼굴에 무슨 표정이야?」
		PRINTFORMW 「우리는 이미 서로에게 부끄러워할 정도는 아니잖아, 그렇지 않아?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「아차, 내 잘못이야. 네가 안에 있을 줄 몰랐어.」
		PRINTFORML 「……아니? 나랑 같이 하고 싶다고 물으시는 건가요?」
		IF MARK:反発刻印 || CFLAG:ブチギレ
			PRINTFORML 「꿈이나 꾸지 마라. 정신 차려!」
			PRINTFORMDW 유우기가 문을 세게 닫자 목재 프레임의 일부가 소리와 함께 눈에 띄게 갈라졌다.
		ELSE
			PRINTFORML 「끌려오지만... 오늘은 사양할까 봐요.」
			PRINTFORMDW 유우기는 당신에게 목욕을 즐기라고 말하고 문을 닫는다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「어라, 아직 거기 있나?」
		PRINTFORMW 「원한다면 나중에 따라가 줄 수도 있지만, 지금은 밖에 나와. 어서!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF !TCVAR:64:今日会ったか
			IF ABL:親密 >= 3 && !RAND:5 && !TALENT:妊娠 && !TALENT:育児中
				PRINTFORML 「음~? 오옷! 너 거기 있었구나, %MASTERNAME:64%?!」
				PRINTFORML 「미안, 방금 술 마시느라 바빴어. 처음엔 못 알아봤네.」
				PRINTFORML 「아, 네가 여기 취하려고 온 건 아니라는 거 알지만, 지금 나랑 같이 한잔할래?」
				PRINTFORMW 「에이, 그렇게 부끄러워하지 마! 평생 마셔도 모자랄 만큼 술은 잔뜩 있어!」
				CALL RECOVER(TARGET, 2000, "酒気", " ")
				TALENT:64:機嫌 = 1
			ELSEIF TALENT:恋慕
				PRINTFORML 「오, %MASTERNAME:64%이 아니겠어!」
				PRINTFORMW 「여기서 뭘 하고 있는 거야?」
			ELSEIF TALENT:思慕
				PRINTFORML 「반갑다, %MASTERNAME:64%.」
				PRINTFORMW 「차는 대접할 수 없지만, 술은 원하는 만큼 마셔도 좋다.」
			ELSE
				PRINTFORML 「오, 당신이군요.」
				PRINTFORMW 「이곳에서 당신을 만나다 정말 우연이네요.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF !TCVAR:64:今日会ったか
			IF CFLAG:64:1099 && TALENT:恋人 ;jealous yuugi toggle
				;was removed in the og dialogue, so; the "punishment snu-snu" event should still fire though
				IF FIRSTTIME("YuugiPunchJealous") ;expanded with a follow up by Linguine
					PRINTFORML 「여자친구를 두고 제법 즐기고 있는 것 같네요.」
					PRINTFORMDL %BREAKENG(@"돌아보니 유우기가 그곳에 서 있는 것이 보인다, 그녀의 미간은 분노로 찌푸려져 있고 새로 생긴 분노로 이 악물고 있다.")%
					PRINTFORMDL %BREAKENG(@"하얗게 힘이 들어간 주먹들이 그녀의 옆에서 떨렸다. 전설 속의 진짜 오니처럼 보이는 것은 흔한 일이 아니었지만, 그 명백한 유사성은 이제 분명했다.")%
					PRINTFORML 「아아, 오늘의 데이트는 여기까지인가!」
					PRINTFORMDL 얼굴에서 피가 빠져나가는 것을 느끼며 상황을 의심하기 시작했지만 이미 너무 늦어버렸다.
					PRINTFORMDL 그녀의 주먹이 마치 비행기가 탑에 충돌하듯 당신과 부딪히며, 당신을 엄청난 속도로 공중에 날려 보냈다.
					CALL RECOVER(MASTER, -10000, "体力", " ")
					PRINTFORML 「하아... 당분간은 너에게 더 이상 해를 가하지 않겠다.」
					;word play
					PRINTFORML 「결국 난 그렇게 악마 같은 존재가 아니었나... 잠깐, 그런 것 같기도 하다. 뭐 어쩔 수 없지...」
					PRINTFORMW 「자, 그럼... 집에 가서 내가 아직 할 수 있는 작은 방법들로 \@ TALENT:妊娠 ? 긴장을 풀거나 # 취하거나 해야겠어, 아마.」 \@
				ELSEIF ONCE("YuugiCheatingPunish")
					PRINTFORMDL %BREAKENG(@"유우기는 너와 네 데이트의 발소리를 들었을 때 돌아보며, 네가 %CALLNAME:(ARG:1)%과 함께 있는 것을 보는 순간 얼굴의 미소를 사라지게 한다.")%
					PRINTFORMDL 그녀의 눈이 커졌다가 미간을 찌푸리고 입꼬리가 아래로 휘어지며 경멸적으로 변했다.
					PRINTFORML 「정말? 또 그러는 거야? 내 주먹으로 충분히 경고했을 거라고 생각했는데.」
					IF TALENT:妊娠
						PRINTFORMDL %BREAKENG(@"유우기는 몇 시간 전 당신과의 열정적인 교합의 증거인 자신의 부푼 배를 강조하듯 허리에 손을 올리며 한숨을 내쉰다.")%
						PRINTFORMDL 당신의 시선을 알아차린 그녀는 비웃으며 %CALLNAME:(ARG:1)%에게 윙크를 하고 상처에 모욕을 더한다.
						PRINTFORML 「너의 작은 데이트를 마음껏 즐기길 바라, 나의 사랑아.」
						PRINTFORMDL 그녀의 얼굴에 잘난 체하는 미소가 떠올랐다.
						PRINTFORML 「분명 그럴 거야, 하하하!」
						PRINTFORMDL %CALLNAME:(ARG:1)%의 표정을 거의 즐기는 듯, 유우기는 고개를 치켜든 채 만족스러운 표정으로 걸어갔다.
						PRINTFORMDW 결국 당신과 유우기는 각자의 위치가 어디인지 정확히 알고 있다...
					ELSE
						PRINTFORMDL 유우기가 한숨을 쉬며 허리에 걸린 술병에 감긴 밧줄을 푼다.
						PRINTFORMDL 그녀는 평소보다 더 강하고 갑작스럽게 다른 손의 빨간 그릇에 내용물을 붓기 시작한다.
						PRINTFORMDL 그 결과 약간의 사케가 넘치지만, 그녀는 가득 차도록 계속 붓는다.
						PRINTFORML 「뭐 됐어, 데이트나 즐기고 오든가.」
						PRINTFORMDL %BREAKENG(@"유우기가 술잔을 높이 들고 기울여 마시기 시작한다. 하지만 모든 술이 입으로 들어가는 것은 아니었고, 옆으로 새어 그녀의 셔츠 위로 흘러내리며 가슴에 달라붙은 흰 천을 투명하게 만들었다.")%
						PRINTFORMDW %BREAKENG(@"그녀는 술을 마지막 한 모금 비우고 돌아섰으며, 두 사람에게 잠시 시선을 준 뒤 멀리 사라졌다.")%
					ENDIF
				ENDIF
			ELSEIF TALENT:恋慕
				PRINTFORML 「어, 음, 뭐...」
				PRINTFORML 「즐거운 시간 보내길 바랄게.」
				PRINTFORMDW 유우기가 다소 언짢아 보인다.
			ELSE
				IF CFLAG:MASTER:現在位置 / 100 == 9 && !CFLAG:64:1003
					PRINTFORML 「오호라, 두 분! 오늘 특별히 가려는 곳이라도 있으신가요?」
					PRINTFORML 「……뭐랄까, %PRINT_MALE(@"a man and a woman:%SPLIT_G("you two:both of you")%", MASTER)%은 어깨를 나란히 하고 걸고 계시네요. 어디로 가시는지 충분히 보이는데요, 그렇죠?」
					CALL PRINT_DIALOGUE, @"온천은 이쪽이다. 커플 숙소는 저쪽에 있다. 기념품을 찾는다면 일반 약국 같은 곳을 잘 봐야 한다. 왜냐하면 많은 곳이 사기이기 때문이다.", "w"
					PRINTFORMW 「자, 그럼 이제 당신의 귀찮은 존재가 되어 떠나겠소. 원한을 품은 영혼들이 모이는 가장 위험한 온천 리조트에서의 체류를 즐기시오!」
					CFLAG:64:1003 = 1
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「오호, %MASTERNAME:64%이 아니시네요! 거기서 작은 밀회를 즐기고 계신가 보군요?」
							PRINTFORML 「하하하! 에이, 그렇게 쳐다보지 않아도 돼요!」
							PRINTFORML 「저는 두 분 사이에 끼어들 만큼 천박하지 않아요.」
						CASE 1
							PRINTFORML 「너희가 그렇게 잘 지내는 걸 보니 정말 기쁘구나.」
							PRINTFORML 「서로의 시간을 충분히 즐기길 바라요. 제대로, 알겠지?」
							PRINTFORMDL 유우기가 눈을 한 번 깜빡이고 다시 자신의 일로 돌아갔다.
							RETURN 1
						CASE 2
							PRINTFORML 「이런, %MASTERNAME:64%이 아니면, ... 헤에.」
							PRINTFORML 「방해해서 미안해. 다음에 또 연락 줘, 알겠지?」
					ENDSELECT
					PRINTFORMDW 유우기가 손을 휘저으며 무시하듯 걸어 나간다.
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
