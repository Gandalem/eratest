		ELSE
			PRINTFORML 「그럼 집에 갈 시간인 것 같네.」
			PRINTFORMW 「%MASTERNAME:64%, 다음에 보자.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート中帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:うふふ
			IF CFLAG:衰弱
				;うふふ中に疲れて帰る
				PRINTFORMW 
			ELSE
				;うふふ中に眠くて帰る
				PRINTFORMW 
			ENDIF
		ELSE
			;疲れて帰る
			IF CFLAG:衰弱
				IF TALENT:恋慕
					PRINTFORML 「하아... 좀 너무 즐겼나 봐...」
