;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;何回も表示されたら邪魔なので１日１回
		IF !TCVAR:64:350
			IF TALENT:恋慕
				PRINTFORML 「%MASTERNAME:64%, 아주 바빴던 것 같네요.」
				PRINTFORML 「제가 도울 일이 있을까요?」
				PRINTFORMW 「...괜찮아요? 음, 정말 그렇기를 바라요.」
			ELSEIF TALENT:思慕
				PRINTFORML 「어이, %MASTERNAME:64%! 어디 가니?」
				PRINTFORML 「시간 되면 같이 가도 될까... 응? 지금 바빠?」
				PRINTFORMW 「그렇구나. 다음에 또 만나자, 알겠지?」
			ELSE
				PRINTFORML 「%SPLIT_G("요:안녕:야")%!」
				PRINTFORMDW 유우기가 손을 들고 당신에게 가볍게 손을 흔든다.
			ENDIF
			TCVAR:64:350 = 1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF FLAG:70
			RETURN 1
		ELSE
			PRINTFORMDL 유우기는 아직 당신을 알아차리지 못한 것 같다.
			PRINTFORMDW 당신은 인사하는 수고조차 하지 않기에 그녀를 무시하고 지나간다...
			RETURN 1
		ENDIF
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
