@M_KOJO_EVENT_K64_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;うふふ==2（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;MASTERを押し倒した（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF FIRSTTIME("YuugiSnuSnu") || RAND:3 == 0
				PRINTFORML 「흥, 너 반격 안 하네.」
				PRINTFORMW 「좋아, 나한테 더 쉽겠군. %SPLIT_G("I'll take what I can get:You'll let me get on with it, then")%!」
				PRINTFORMDL 유우기(Yuugi)는 당신의 옷을 벗기 시작하면서 그렇게 말한다.
				PRINTFORMDW %BREAKENG(@"그녀의 손이 거칠고 간절한 동작으로 네 옷을 벗겨내는데, 아래에 있는 보물에 대한 갈증을 겨우 참는 듯했다.")%
				PRINTFORML 「후후후, %SPLIT_G("looks like someone is seriously erect right now:look at you getting so big and hard already:look at you poppin' such a fine boner")%...」
				PRINTFORMW 「그렇게 되어 있으니 뭔가 기대하고 있는 거야? 음?」
				PRINTFORMDL %BREAKENG(@"유우기는 이번에 섬세한 손으로 네 성기를 어루만지며, 부러뜨리지 않으려는 듯 천천히 부드럽게 그 길이를 쓰다듬는다.")%
				PRINTFORMDW %BREAKENG(@"당신의 맥동하는 성기 끝에서 상당량의 애액이 흘러 그녀의 손 위로 떨어지며 그녀의 질문에 대한 답을 대신했다.")%
			ELSEIF TALENT:恋慕 ;added this and below
				PRINTFORMW 「이봐, %MASTERNAME:64%... 이리 와 봐.」
				PRINTFORMDL 유우기는 갑자기 당신을 무릎으로 밀어눕히며 그녀를 만족시키라고 재촉한다.
				PRINTFORMW 「%MOAN()%... 미안해. 네가 내 곁에 있는 것만으로도 나 정말 흥분하거든, 알잖아.」
				IF BASE:MASTER:勃起 >= 1000
					PRINTFORMDW 유우기(Yuugi)는 당신을 훑어보다가 눈빛에 번뜩이는 당신 바지의 발기를 발견했다.
					PRINTFORML 「헤헤～ 그런 걸 보여주면 나도 흥분하지 않을 거라고 기대하는 건 아니겠지...」
					PRINTFORML 「음, 이렇게 마음껏 날 풀어줄 수 있는 것도 다 당신 덕분이잖아, 그렇지 않아?」
					PRINTFORMW 「나중에 내가 기분을 좋게 해준 것에 대한 보답을 해야 하는데, 알잖아.」
				ENDIF
			ELSE
				PRINTFORML 「죄송하지만 범죄를 저지르려 하고 있어요!」
				PRINTFORMDW %BREAKENG(@"유우기는 전력을 다해 당신을 밀어 넘어뜨리고 옷을 거칠게 벗기기 시작하며 거의 찢어버릴 듯이 한다.")%
				CALL PRINT_DIALOGUE, @"휴... 정말 굉장한 광경이네~ 네가 내가 처음 찾은 사람이어서 다행이다. 어쨌든 나를 따라올 사람은 아무도 없을 거라고 생각해."
				PRINTFORML 「좀 불안해서 진정할 방법을 찾으려고 했어. 괜찮지, 그렇지?」
				PRINTFORMW 「얘야, 쉬잇... 곧 끝날 거야, 알겠지? 끝나면 시원한 거 사 줄게, 그러니까 서운해하지 마!」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERに抱きついた（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「왜 그렇게 서두르는 거야? 이리 와, 괜찮으니까 긴장 풀어.」
			PRINTFORMW 「지금 바로 이걸 하고 싶은 기분이야!」
			PRINTFORMDL 유우기가 당신의 머리를 쓰다듬으며 머리를 쓸어 넘겼다.
			PRINTFORMDW 술에 취한 유우기의 접근에 하위가 될 수도 있다는 생각에 작은 탄성이 입에서 새어 나왔다...
			RETURN 1
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;-------------------------------------------------
		;抜け出した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORML 「%SPLIT_G("그것에 동참하는 게 그렇게 너를 힘들게 해? 그걸 정말 불만스러워했어?")%?」
			PRINTFORML 「네가 원하는 대로 해라.」
			PRINTFORMDW 그리고 그렇게 유우기는 너를 놓아버린다.
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード満足終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「뭐, 이번엔 그냥 넘어가 주지.」
			PRINTFORML 「더 이상 참을 수 있을지 모르겠어.」
			PRINTFORMDW 유우기의 애정 어린 손길 후에 머리를 정리하고 옷을 고쳐 매며 한숨을 내쉰다...
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード強制終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML 「흠, 이 정도로는 아직 만족스럽지 않네...」
			PRINTFORMW 「뭐 어쩌겠어, 당분간은 그렇게 해야지.」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;好きにして状態から抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「야, 이리와. 너 나랑 하고 싶다고 말했잖아.」
			IF IS_MALE(MASTER) ;elaborated
				PRINTFORML 「그건 네 말이지, 내 말이 아니야. 남자라고 스스로 부르려면 그걸 지켜야지. 정신 차려!」
				PRINTFORMDL %BREAKENG(@"욕정으로 당신을 응시하며, 유우기는 당신이 원하든 안 하든 마지막 씨앗 한 방울까지 짜내겠다는 결의에 차 있었다.")%
			ELSE
				PRINTFORML 「나한테 그렇게 도전할 거면, 내가 봐줄 생각 없어, 알겠어. 여자 대 여자로도 말이야!」
				PRINTFORMDL 그녀의 말투에서 유우기가 끝까지 당신을 황홀하게 만들 작정임이 느껴졌다.
			ENDIF
			PRINTFORMDW 당신은 여기서 살아남을 수 있을지 궁금해한다.
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;欲求不満が高くて抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML 「이봐, 아직 배가 안 불렀어!」
			PRINTFORML 「오라! 그냥 %SPLIT_G("do me a solid:be a good fella")%하고 망해버려!」
			PRINTFORMDW 유우기가 눈에 흥분된 빛을 띠며 진심으로 너를 제압한다. 이를 알아챈 너는 잠시 후 저항하는 것을 포기한다.
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;誘ってきた（人目につかない場所に行きたがるやつ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;ARG:1=TARGETの欲求不満度（最高1000）
		;必要ならばこれで分岐を作ってください
		;added
		PRINTFORML 「이봐, %MASTERNAME:64%... 너를 바닥에 깔고 내 마음대로 하고 싶은 충동을 간신히 참는 중이야.」
		PRINTFORMW 「당장 방이라도 잡자... 알겠지?」
		RETURN 1
	ENDIF
	;その他
	PRINTFORML
ENDIF
RETURN 1
;==================================================
;浴場で遭遇
;==================================================

