@M_KOJO_MESSAGE_COM_K64_334_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF ONCE("YuugiBanquet") ;added from J
		PRINTFORML 「오? 나랑 마실래?」
		PRINTFORMW 「Now we're talking! Let's get to it, then!」
		RETURN 1
	ENDIF
	SELECTCASE TFLAG:193
		CASE 1
			;大成功
			;added og
			IF !TALENT:恋慕
				IF FIRSTTIME("YuugiBanquet2")
					PRINTFORML 「...있으면서 나랑 술 마시는 게 그렇게 긴장돼?」
					PRINTFORMDW 그녀가 무슨 뜻일까? 생각하게 되네...
					PRINTFORML 「있잖아, 이렇게 얼굴을 보고 얘기할 때 네 시선은 항상 아래로 향하는 경향이 있어서 말이야. 그냥 궁금해서 물어본 거야.」
					PRINTFORMDW 유우기는 한 손으로 자신의 거대한 가슴을 받치며 묻는다.
					PRINTFORMDW Oh... Oh!
					PRINTFORMDW 당신은 어색한 변명을 하며 걱정할 것이 없다고 말한다.
					PRINTFORMW 「정말 괜찮을 거라고 확신해? 뭐, 네가 그렇게 말하니까.」
				ELSEIF RAND:2
					PRINTFORML 「하아~? 나 같은 여자한테 관심이 있다고, 말하는 거야?」
					PRINTFORML 「아하하하! 그만둬 %MASTERNAME:64%, 취했잖아!」
					PRINTFORMW 「나 같은 천박한 애를 누가 좋아할 리 없어!」
				ELSE
					PRINTFORMDL 유우기는 만족스러운 소리를 내며 당신의 등을 툭 치는데, 그 힘에 숨이 거의 빠질 지경이었다.
					PRINTFORML 「하하하!」
					PRINTFORML 「너 같은 인간이 이 세계에서 제일 강한 오니 소녀 옆에 앉아있다니 말이야.」
					PRINTFORML 「넌 배짱이 있구나, %PRINT_MALE("boy", MASTER)%!」
					SIF CFLAG:[[萃香]]:面識 && CFLAG:[[萃香]]:2 >= 1000
						PRINTFORML 「스이카가 너랑 술 나눠 마시는 게 당연하겠지...」
					WAIT
				ENDIF
			ENDIF
			RETURN 1
		CASE 0 ;added from J
			;成功
			PRINTFORML 「자, 자, 계속 마셔! 어린애처럼 홀짝이지 말고 제대로 다 마시란 말이야!」
			PRINTFORMW 「괜찮을 거야, 내가 말했잖아! 네가 무너지면 내가 돌봐줄 테니까!」
			RETURN 1
		CASE -1 ;added from J
			;失敗
			PRINTFORML 「오, 좋아, 우리 술내기 할까? 네가 이기면 뭐든지 들어줄게.」
			PRINTFORMDL ...한 번 해보려고 했지만 불가능했다.
			PRINTFORMW 「참 지저분하게... 음, 그럴 만도 하지.」
			RETURN 1
	ENDSELECT
ENDIF
RETURN 0
