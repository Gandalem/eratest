@M_KOJO_MESSAGE_COM_K64_414_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		PRINTFORML 
		RETURN 1
		;通常
	ELSE
		;勇儀と一緒に作った料理を食べる
		IF DISH_ASSI == 64
			;判定
			SELECTCASE TFLAG:193
				;大成功
				CASE 1
					PRINTFORML 「자, 그럼 건배를 하지!」
					PRINTFORML 「건배! 꿀꺽, 꿀꺽, 꿀꺽...!」
					PRINTFORML 「――부하아아아! 좋은 술, 맛있는 음식! 기분이 좋아졌어!」
					PRINTFORMDW 정기적으로 식사할 거라고 생각했지만, 어느새 그것은 성대한 연회로 발전해 버렸다...
					;成功
				CASE 0
					PRINTFORML 「응, 맛있어-냠냠! 술이랑 같이 먹기 딱 좋아!」
					PRINTFORML 「음, 가르쳐준 사람이 너였지. 잘 된 게 당연해!」
					PRINTFORMDW 당신과 유우기가 맛있는 식사를 마치고 몇 잔의 술을 나눈다.
					;失敗
				CASE -1
					PRINTFORML 「젠장, 이건 당혹스럽군... 우리는 모든 단계를 철저히 따랐다고 생각했는데...」
					PRINTFORML 「그렇긴 하지만, 버리기는 아깝지. 술을 좀 마시면서 해결해 볼 수 있겠어.」
					PRINTFORML 「'곁들임이야, 계속 먹으면 놀라울 정도로 맛있을지도 몰라!」
					PRINTFORMDL 유우기는 음식을 간식처럼 먹으며 몇 입씩 사케와 함께 들이키고, 얼굴에는 만족스러운 표정을 짓는다.
					PRINTFORMDW 당신은 그녀 옆에 앉아 그녀의 예를 따른다.
			ENDSELECT
			IF TALENT:妊娠 || TALENT:育児中 ;added
				PRINTFORML 「오, 내가 뭘 마시고 있는 거지? 레모네이드잖아, 진정해! 하하하...」
				PRINTFORMDW 유우기에게 의심스러운 눈초리를 보낸다. 그녀는 웃음으로 상황을 모면하려 한다...
			ELSE
				CALL RECOVER(TARGET, 20, "酒気", " ")
			ENDIF
			CALL RECOVER(MASTER, 20, "酒気", " ")
			;それ以外
		ELSE
			IF DISH_TYPE == "デザート"
				SELECTCASE TFLAG:193
					;大成功
					CASE 1
						PRINTFORML 「음... 음~! ～～!」
						PRINTFORMDL 그녀는 디저트를 한 입 베어 물었고, 그것이 미각에 닿는 순간 유우기의 표정은 황홀함으로 녹아내린다.
						PRINTFORML 「유... 우움!!! 이거 정말 맛있다!」
						PRINTFORML 「어떻게 나한테 그런 맛있는 디저트가 있다는 걸 말해주지 않았던 거야?!」
						PRINTFORMDW 왜냐하면 그녀는 물어보지 않았으니까...
						;成功
					CASE 0
						PRINTFORML 「구시가지에서는 이런 걸 볼 수 없어. 그들이 원하는 건 술에 곁들일 간식뿐이야!」
						PRINTFORMDL 저쪽엔 바만 있고 단 것이 파는 가게 하나 없다는 게 사실이지...
						PRINTFORML 「그래도... 이렇게 달콤한 걸 먹으면 뭔가 짭짤한 것도 당기네.」
						PRINTFORML 「이왕 온 김에 그런 것도 있었으면 좋겠는데... 오, 정말 배려심 깊은 사람이네!♪」
						PRINTFORMDW 유우기는 입가심으로 준비된 라이스 크래커를 게걸스럽게 먹어치운다.
						;失敗
					CASE -1
						PRINTFORML 「말하자면, 이건... 나한테 좀 너무 달아.」
						PRINTFORML 「――우으... 가슴이 조금 메스꺼워지기 시작해...」
						PRINTFORMDW 유우기는 입안의 맛을 없애려 차를 한 모금 삼켰다.
				ENDSELECT
			ELSE
				SELECTCASE TFLAG:193
					;大成功
					CASE 1
						PRINTFORML 「오오! 바로 이거야! 내가 찾던 맛이야!」
						PRINTFORMW 「내 입맛에 맞게 양념해 주는 법을 정확히 알고 있네, 잘했어!」
						PRINTFORMDL 유우기는 엄청난 속도로 한 조각씩 음식을 계속 입에 밀어 넣었다.
						PRINTFORMDW 그리고 몇 분도 채 되지 않아 그것은 모두 사라지고 그녀의 목구멍으로 넘어갔다.
						PRINTFORML 「하아아~... 와, 이 음식 정말 배를 채워주네!」
						PRINTFORML 「너무 맛있어서 술 한 잔 하는 것도 잊을 정도였어!」
						PRINTFORMDL 그녀는 그 결과에 상당히 만족한 듯했다.
						PRINTFORMDW 당신은 그녀에게 술 대신 차를 한 잔 내고 유우기에게 건넨다...
						;成功
					CASE 0
						PRINTFORML 「정말이야? 그럼 기꺼이 맛볼게!」
						PRINTFORMDW 유우기는 감사하며 손뼉을 치고 재빨리 식사를 계속했다.
						PRINTFORML 「냠, 꿀꺽...! 응, 이 음식 정말 좋다!」
						PRINTFORML 「양념이 딱 맞고, 술 안주로 완벽해!」
						PRINTFORMDW 모든 것을 주류의 관점에서 판단한다는 사실은 오니답다고 생각한다.
						;失敗
					CASE -1
						PRINTFORML 「이것도 한계가 있긴 하겠지, 뭐...」
						PRINTFORML 「간식으로 먹을 만한 것도 아니야!」
						PRINTFORMDL 불행하게도 유우기 취향은 아니었다...
						PRINTFORMDW 하지만 유우기는 여전히 식사를 끝냈다. 아마 당신에게 대접받았기 때문에 좋은 매너를 보인 것 같다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
