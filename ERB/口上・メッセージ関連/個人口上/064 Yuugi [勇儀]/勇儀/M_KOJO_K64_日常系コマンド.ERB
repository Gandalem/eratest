@M_KOJO_EXTRASOURCE_SCOM_K64_63
;ムードが高まってる時は反感ゼロ
IF BASE:ムード >= 1000
	SOURCE:反感 = 0
	;条件を満たさない場合は大幅減
ELSEIF CFLAG:2 >= 1000 ;added condition
	SOURCE:反感 = SOURCE:反感 / 10
ENDIF

@M_KOJO_MESSAGE_SCOM_K64_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		PRINTFORML 
		RETURN 1
		;押し倒され
	ELSEIF CFLAG:うふふ == 2
		CALL AUTO_AEGI
		RETURN 1
		;通常
	ELSE
		PRINTFORMDL 당신은 유우기에게 입맞춤을 깊게 했다%COND_STR(@" while laying next to each other", CFLAG:TARGET:添い寝中)%.
		PRINTFORMDW 
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 열기와 욕정의 순간에 그녀의 입술을 거의 삼킬 듯 유우기를 키스하고, 야만적인 갈망으로 두 사람의 혀가 얽힌다.
					CALL HPH_PRINT,@"「%RANDKISS("kiss")%... %RANDKISS()%...!HPH %FSYN("lips_muffle")%, 후우...HPH」","L"
					CALL HPH_PRINT,@"「%FSYN("lips_over")%...HPH %SPLIT_G("We can go for one more, right:Keep it coming, alright")%...?HPH」","L"
					PRINTFORMDW 유우기는 희망에 찬 눈빛으로 당신을 응시하며 볼에 홍조가 퍼진다...
				CASE 1
					CALL HPH_PRINT,@"「%FSYN("lips_muffle")%... 더 원해? 헤에, 너 정말 성급한 애구나...HPH」","L"
					CALL HPH_PRINT,@"「자, 해봐...HPH %FSYN("lips_muffle")%... %RANDKISS()%...!HPH」","L"
					PRINTFORMDW 당신의 입술은 뜨겁고 갈망하는 듯한 키스들을 연달아 누르며 벌어진다...
				CASE 2
					CALL HPH_PRINT,@"「%RANDKISS()%... %RANDKISS()%...!흡!헉...!」","L"
					PRINTFORMDL 당신들이 원초적인 갈망으로 서로에게 계속 입맞춤하자 침이 뒤섞이고 그녀의 혀가 당신의 입안을 탐색한다...
					CALL HPH_PRINT,@"「무우욱...후프 %SPLIT_G("That was great:It was good:You're real good at this")%, %MASTERNAME:64%...후프」","W"
			ENDSELECT
		ELSEIF CFLAG:2 >= 1000 ;added condition
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「――나한테 또 해볼래? 라고 묻는 거야?」
					PRINTFORML 「제발, 그만둬 %SPLIT_G("sweating the small stuff so much:asking permission for every single thing you do:being such a pansy over nothing")%... %RANDKISS()%!」
					PRINTFORMDW 당신은 반박하려 입을 열지만, 유우기가 입술로 당신을 조용하게 만든다.
				CASE 1
					PRINTFORML 「%RANDLIPS(, "kiss")%...!」
					PRINTFORMDL 당신은 유우기에게 손을 대고 그녀를 부드럽게 자신 쪽으로 끌어당긴 채 입술을 계속 맞댄다.
					PRINTFORMDW 그녀는 당신의 얼굴에 매혹적인 숨결을 불어넣으며 키스를 하고, 가끔 당신의 아랫입술을 깨문다.
				CASE 2
					PRINTFORML 「%RANDLIPS(, "kiss")%...!」
					PRINTFORML 「%FSYN("lips_over")%... 헤에, %SPLIT_G("turns out your lips are sweet too:your lips ain't so bad either")%!」
					PRINTFORMDW 유우기는 당신의 입술 위를 집요하게 혀로 쓸며 침을 핥아낸다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%RANDLIPS(, "kiss")%...!」
					PRINTFORMDL 당신은 유우기에게 몸을 바싹 밀착시킨 채 그녀의 체온을 느끼며 당신의 혀가 %SPLIT_G("dance together:caress each other")%.
					PRINTFORMW 「흡, 하아... 하아...! 너 이 일에 너무 격앙된 거 아니야...?」
				CASE 1
					PRINTFORML 「%RANDLIPS(, "kiss")%...!」
					PRINTFORML 「%FSYN("lips_over")%...! 그만해, 깜짝 놀라게 하지 마...!」
					PRINTFORMDW 유우기의 얼굴이 새빨개지며 입술을 닦았다.
				CASE 2
					PRINTFORML 「%RANDLIPS(, "kiss")%...!」
					PRINTFORMDL 당신은 유우기를 다시금 또 키스하며 단단하게 그녀를 안는다.
					PRINTFORMDW 얼굴을 간지럽히는 거친 숨소리를 무시하고, 만족할 때까지 계속해서 그녀의 부드러운 입술을 탐색한다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
