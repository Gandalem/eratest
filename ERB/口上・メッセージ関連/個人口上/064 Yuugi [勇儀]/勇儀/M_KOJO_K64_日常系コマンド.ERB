@M_KOJO_MESSAGE_SCOM_K64_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋慕 && FIRSTTIME("YuugiLeadByHand") ;repurposed
		PRINTFORML 「%MASTERNAME:64%와 손을 잡고, 경치를 보며 산책한다...」
		PRINTFORML 「이것이 바로 소소한 것들을 즐긴다는 말이겠지...」
		PRINTFORMDL 당신은 유우기(Yuugi)의 손가락과 깍지를 끼고 그녀도 똑같이 당신의 손을 꽉 잡는다.
		PRINTFORMDW 지금 보면 정말 진정한 커플처럼 보인다...
		RETURN 1
	ENDIF
	IF TCVAR:390 && ONCE("YuugiArmwrestling") ;repurposed
		;continuation from the "hold hand" case? (603,手を繋ぐ)
		PRINTFORMDL 유우기가 손을 잡고 걸어간다.
		PRINTFORML 「야, 제발! 한 판만 하자고!」
		PRINTFORML 「봐! 그 나무가 바로 저기 있어!」
		PRINTFORMDW 그녀는 정말 집요하군...
		RETURN 1
	ENDIF
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「우리가 가는 곳에 그렇게 서두를 필요 없어. 도망가지 않을 거야!」
			PRINTFORML 「이건 우리에게 즐거운 여행을 할 기회야, 알지? 그러니 여유롭게 풍경을 감상하면서 천천히 가자!」
			PRINTFORMDL ――그녀 말이 맞아, 네가 좀 서두른 것 같아.
			PRINTFORMDW 너는 속도를 줄이고 유우기 옆에 나란히 걷기 시작한다.
		CASE 1
			PRINTFORML 「시간이 중요하다고 말하는 건가? 음, 그래, 네 마음을 알겠어.」
			PRINTFORML 「나도 방금 그렇게 생각했지!」
			PRINTFORMDL 비웃는 미소를 지으며 유우기는 당신의 손을 뿌리치고 달려나가 버렸다!
			PRINTFORMDW 경주다! 당신은 다리에 허락하는 한 가장 빠르게 유우기를 뒤쫓는다.
			PRINTFORMDW 그럼에도 그녀는 쉽게 당신보다 앞서 나갔고, 멀리 달아가는 그녀의 체형이 점점 작아졌다.
		CASE 2
			PRINTFORML 「그렇게 서두른다면, 경주라고 부르자.」
			PRINTFORML 「저기 있는 %SPLIT_G("tree:boulder:wall")% 보이지? 먼저 도착하는 사람이 이기는 거야!」
			PRINTFORML 「준비됐어? 준비 자세――출발!!!」
			PRINTFORMDL 하나, 둘, 셋 걸음... 오니의 강력한 보폭이 땅을 흔든다.
			PRINTFORMDW 네가 첫걸음을 내디딜 때, 유우기는 이미 너보다 훨씬 앞서 있었다...
	ENDSELECT
ENDIF
RESETCOLOR
RETURN 1
