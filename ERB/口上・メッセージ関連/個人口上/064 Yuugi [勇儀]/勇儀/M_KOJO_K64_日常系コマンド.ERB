@M_KOJO_MESSAGE_COM_K64_605_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMDL 유우기와 함께 우회하기로 결정한다.
	PRINTFORMDW 
	;天気によって分岐
	SELECTCASE TIME:5
		;晴れ
		CASE 0,1
			IF TALENT:恋慕
				PRINTFORML 「잠깐 들를래? 응, 문제없어.」
				PRINTFORML 「오늘 정말 아름다운 날이네! 산책하기 딱이야.」
				PRINTFORMDW 유우기랑 풍경을 즐긴다.
			ELSE
				PRINTFORML 「아하? 하지만 이쪽으로 가고 있네... 아, 알겠다.」
				PRINTFORML 「내가 지켜볼 테니, 얼른 재빨리 끝내버려!」
				PRINTFORMDW 유우기는 네가 자연의 부름에 응해야 한다고 생각하는 모양이다...
			ENDIF
			;曇り
		CASE 2,3
			IF TALENT:恋慕
				PRINTFORML 「비가 쏟아지기 시작하면 지저분해질 거야.」
				PRINTFORML 「우산 꼭 챙겨, 알았지?」
				PRINTFORMDW 날씨는 그렇게 많이 변하지 않을 거라고 생각했다. 그는 그것을 걱정하지 않고 우회하기로 결정한다.
			ELSE
				PRINTFORML 「이런 반쯤 제대로 된 날씨가 제일 짜증난다.」
				PRINTFORML 「본격적으로 비 오기 전에 서둘러야 해... 우와, 이봐! 나 기다려!」
				PRINTFORMDL 앞으로 계속 걸어가자 유우기가 이미 멀리 가버린 것을 알아차렸다.
				PRINTFORMDW %BREAKENG(@"길을 가는 동안 흥미로운 것을 보고 계속 멈춰 서더니, 얼마 지나지 않아 뒤처지고 말았다.")%
			ENDIF
			;それ以外
		CASEELSE
			IF TALENT:恋慕 && !RAND:4
				PRINTFORML 「비나 눈 오는 풍경을 술과 함께 보는 건 말이야...」
				PRINTFORML 「술 한잔 전에 날씨가 안 좋은 걸 즐기는 것도 가끔은 나쁘지 않은 생각이지.」
				PRINTFORML 「저쪽에 편의점 같은 노점이 있으니 잠시 쉬자.」
				PRINTFORMDW 발이 아파오기 시작하여, 당신과 유우기는 노점에서 휴식을 취한다.
				CALL RECOVER(MASTER, 100, "体力", " ")
				CALL RECOVER(MASTER, 150, "気力", " ")
				TIME += 60
			ELSE
				PRINTFORML 「날씨가 이렇게 안 좋지 않았다면...」
				PRINTFORMDW 불운하게도 당신은 좋지 않은 날씨 때문에 풍경을 즐길 수 없었다.
			ENDIF
	ENDSELECT
ENDIF
RESETCOLOR
RETURN 1
