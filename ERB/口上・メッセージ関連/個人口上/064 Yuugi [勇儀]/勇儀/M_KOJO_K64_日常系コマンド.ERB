;==================================================

@M_KOJO_SUCCESS_COM_K64_414
;成否判定
;TFLAG:192(-2=コマンド終了(非TARGET時強制失敗)、-1＝強制失敗、0=COM依存(非TARGET時強制成功)、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K64_414
CALL M_KOJO_MESSAGE_COM_K64_414_1
