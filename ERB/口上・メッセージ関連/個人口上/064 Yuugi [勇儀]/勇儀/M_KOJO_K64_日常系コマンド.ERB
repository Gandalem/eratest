;402,就寝
;TFLAG:193(0=通常 1=子供と一緒に川の字で寝る)
;==================================================

@M_KOJO_MESSAGE_COM_K64_402
;就寝にTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K64_402_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K64_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;お招き部屋で勇儀が恋慕じゃないor勇儀が睡眠中・衰弱中・あなたの部屋にお泊りの場合はこれ
	IF (!TALENT:恋慕 && CFLAG:MASTER:現在位置 == OMANEKIBEYA()) || (CFLAG:睡眠 || CFLAG:衰弱 || FLAG:一時滞在 == 64)
		PRINTFORML 「그으음... 크윽... 즈즈...」
		PRINTFORMDW 당신은 깊이 잠든 유우기 옆에 누워 눈을 감는다...
		;一緒に寝る
	ELSEIF CFLAG:MASTER:現在位置 == CFLAG:初期位置
		;子供と一緒に川の字で寝る
		IF TFLAG:193 == 1
			PRINTFORML 「꼬마가... 벌써 잠들었네, 응.」
			PRINTFORML 「알았어, 우리도 좀 자야겠지.」
			PRINTFORMDW 아이를 가운데 두고 세 사람이 나란히 잠든 모습은 거의 "강" 문자 ["川"]을 닮았다.
			;それ以外
		ELSEIF !CFLAG:添い寝中
			PRINTFORML 「음, 이제 잠자리에 들 시간인가 보네.」
			PRINTFORMDL 유우기는 \@ TALENT:妊娠 || TALENT:育児中 ? 당신이 그녀를 도와 이불을 펼치는 동안 이불을 펴거나 # 당신이 이불을 펴는 동안 빈 사케병들을 치며 한다 \@.
			PRINTFORMDL 이불 하나와 베개 두 개. 요즘은 아주 평범해진 광경이다.
			PRINTFORML 「――다 됐어? 좋아, 불 끌게~」
			PRINTFORMDW 방을 희미하게 비추던 등불이 꺼지고 유우기는 이불 속으로 들어간다.
		ENDIF
		PRINTFORMW 「...%SPLIT_G("달콤한 꿈을 꾸렴")%, %MASTERNAME:64%.」
		PRINTFORMDL .........
		PRINTFORMDL ......
		PRINTFORMDW ...
		;通常
	ELSE
		;恋慕かつ３分の１の確率
		IF TALENT:恋慕 && !RAND:3
			PRINTFORML 「\@ RAND:2 ? 하루를 마무리하는 거라고 들었는데, 난 우리가 이제 시작이라고 생각했어! # 뭐야, 벌써 잠자리에 드는 거야? 하지만 우리 할 게 훨씬 더 많다고! \@」
			PRINTFORMDW 유우기는 당신과 저녁 식사 겸 술을 마실 것을 기대했던 것 같다.
			CALL ASK_YN("술 한 잔만 더 마시려고 깨 있어 봐", "잠자리에 들어라")
			SELECTCASE RESULT
				;付き合う
				CASE 0
					PRINTFORML 「후훗! 우리가 같은 생각이라는 게 다행이야.」
					PRINTFORMW 「자, 앉아봐! 내가 술 따라 줄게!」
					PRINTFORMDW .........
					PRINTFORMDW 유우기와 함께 술을 마시는 것은 세상이 하얗게 변할 때까지 계속되었다...
					CFLAG:MASTER:徹夜 = 1
					CALL CHANGE_CFLAG(2, 64, 300)
					;寝る
				CASE 1
					PRINTFORML 「후우... 나도 기대하고 있었는데...」
					PRINTFORMDW 네가 잠들자 유우기는 실망한 표정으로 방을 나갔다.
			ENDSELECT
		ELSE
			PRINTFORMW 「응, 잘 자!」
			;あなたの自室で３分の１の確率
			IF CFLAG:MASTER:現在位置 != OMANEKIBEYA() && !RAND:3
				PRINTFORMW 
				PRINTFORMDL 의식의 땅에서 표류하던 당신은 코르크가 열리는 뚜렷한 소리를 듣는다.
				PRINTFORMDW 설마, 여기서 마시려고 머물 계획인 건가...?
				PRINTFORML 「아앙? %SPLIT_G("Haven't fallen asleep yet, have ya:What's the matter, can't sleep")%?」
				PRINTFORMW 「여기서 한 잔 해. 밤을 마무리하기에 딱이지!」
				PRINTFORMDL 고맙지만... 정말 미안하지만...
				PRINTFORMDW 유우기가 그냥 가준다면 정말 감사할 것 같은데...
			ENDIF
		ENDIF
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
;==================================================
;403,休憩
;CFLAG:TARGET:睡眠(1=TARGETが寝てる隣で休憩
;==================================================

@M_KOJO_MESSAGE_COM_K64_403
CALL M_KOJO_MESSAGE_COM_K64_403_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K64_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:睡眠
		PRINTFORML 「그르릉... 쿨쿨...」
		PRINTFORMDW 유우기는 죽은 사람처럼 자고 있다...
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE IFRAND("0TO5", 1, "D1, D2", TALENT:妊娠 || TALENT:育児中)
				CASE 0
					PRINTFORML 「무슨 일이야, 피곤해?」
					PRINTFORML 「그럼 여기 앉아, 내 무릎을 편하게 사용해도 돼.」
					PRINTFORMDW 유우기의 관대함을 이용해 그녀의 무릎에 기대어 쉬었다.
				CASE 1
					PRINTFORML 「음? 한 모금 마시지 뭐.」
					PRINTFORML 「아, 있잖아, 잠시 쉬어주려고 생각했거든.」
					PRINTFORMDW 유우기는 배를 쓰다듬으며 말했다. 간의 휴식일인가...?
				CASE 2
					PRINTFORML 「이럴 때일수록 그냥 편하게 앉아서 한 잔 즐기는 게 최고야.」
					PRINTFORML 「술 한 잔 할래?」
					PRINTFORMDW 유우기랑 술 마시면서 대화하는 걸 즐긴다...
					CALL RECOVER(MASTER, 20, "酒気", " ")
					CALL RECOVER(TARGET, 20, "酒気", " ")
				CASE 3 ;repurposed
					PRINTFORML 「아무것도 안 하고 시간을 보내다 지루해질 거라고 생각했다.」
					PRINTFORML 「하지만 어쩐지 별로 나쁘지 않다고 느낀다. 네 옆에서 시간을 보낼 수 있다면 말이다.」
					PRINTFORMDW 유우기가 너의 옆에 앉으며 환하게 웃는다.
				CASE 4 ;repurposed
					PRINTFORML 「나 좀 졸리네... 잠시 네 어깨 빌릴게.」
					PRINTFORMDL 유우기가 당신 옆에 바싹 다가와 머리를 기대며 기댄다.
					PRINTFORMDW 당신은 한동안 말없이 서로의 온기와 존재를 즐긴다.
				CASE 5 ;added
					PRINTFORML 「가끔 이렇게 시간을 보내는 것도 좋다고 생각한다...」
					PRINTFORML 「어때? 술 한잔 할래?」
					IF TALENT:妊娠 || TALENT:育児中
						PRINTFORML 「그래도 마시진 않을 거야, 걱정하지 마. 왜 그런지 알잖아, 헤헤.」
						PRINTFORMDL 유우기는 배를 쓸어내리며 씁쓸하게 미소 지었다.
					ELSE
						PRINTFORMDL 당신은 그녀의 제안을 받아들이고 함께 그 좋은 술을 즐긴다.
						CALL RECOVER(MASTER, 20, "酒気", " ")
						CALL RECOVER(TARGET, 20, "酒気", " ")
					ENDIF
					WAIT
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE IFRAND("0TO4", 1, "D1, D2, D4", TALENT:妊娠 || TALENT:育児中)
				CASE 0
					PRINTFORML 「――지루해. 나를 즐겁게 해줄 만한 게 있나...?」
					PRINTFORMDL 유우기가 몸을 돌려 주위를 살피다가 당신을 보고 미소를 짓는다.
					PRINTFORML 「오, 여기 있었네! 딱 내가 찾던 거야! 당분간 너랑 같이 놀 생각이야!」
					PRINTFORMDW 그녀는 시간을 보내기 위해 당신과 어울기로 한다...
				CASE 1
					PRINTFORML 「그냥 여기서 아무것도 안 하고 앉아 있을 거야?」
					PRINTFORML 「네 마음대로 해. 나 혼자 마실 테니까!」
					PRINTFORMDW 유우기는 당신 옆에 자리에 앉아 술을 마시기 시작하고, 당신은 멍하니 시간을 보내고 있다...
					CALL RECOVER(TARGET, 20, "酒気", " ")
				CASE 2
					PRINTFORML 「이것이야말로 술 몇 잔 하면서 이야기 나누기에 좋은 기회 같지 않나!」
					PRINTFORML 「우리와는 달리 인간의 삶은 짧다. 그러니 너 자신에 대해 더 말해줘!」
					PRINTFORMDW 제안된 사케 요리를 받아들여 유우기에게 자신의 개인적인 이야기를 들려준다...
					CALL RECOVER(MASTER, 20, "酒気", " ")
					CALL RECOVER(TARGET, 20, "酒気", " ")
				CASE 3 ;repurposed
					PRINTFORML 「오니의 본성상 가만히 앉아있을 리 없다.」
					PRINTFORML 「이왕 모인 김에 작은 놀이를 하는 건 어때?」
					PRINTFORMDL 그렇게 생각하며, 당신은 유우기에게 %SPLIT_G("a game of rock-paper-scissors:do some thumb wrestling:try a word-chain game")%을 제안했다.
					PRINTFORMDW ...의외로 강렬했다.
				CASE 4 ;repurposed
					PRINTFORML 「이럴 때일수록 편하게 쉬면서 술 한잔하는 게 최고야.」
					PRINTFORML 「%MASTERNAME:64%, 좀 할래?」
					PRINTFORMDW 유우기는 가득 담긴 사케 접시를 너에게 건넨다. 너는 정중하게 거절한다.
					CALL RECOVER(TARGET, 20, "酒気", " ")
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
