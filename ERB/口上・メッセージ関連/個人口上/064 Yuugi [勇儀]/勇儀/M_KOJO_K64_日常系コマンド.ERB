;==================================================
;621,釣りをする
;TFLAG:193(0=釣れない 1～4=魚 11～15=うまい魚 610=木材 131=守矢の守札 21=ローター 609=氷の鱗 606=龍の爪)
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K64_621
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K64_621
CALL M_KOJO_MESSAGE_COM_K64_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K64_621_1
#DIM CHARA
#DIMS strFish
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文をカットしてるのでMESSAGE処理を内蔵する
IF LOCAL
	CALL M_KOJO_COLOR_K64
	SELECTCASE TFLAG:193
		;釣れない
		CASE 0
			PRINTFORMDW 아무것도 잡지 못했다...
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음, 그게 %SPLIT_G("the best part about fishing:what makes fishing so special")%인가 보네.」
					PRINTFORMDW 당신과 유우기는 물결치는 물속에서 움직이지 않는 채 낚시 부표를 응시했다.
				CASE 1
					PRINTFORML 「그냥 물에 들어가서 물고기를 잡는 게 더 빠르지 않을까?」
					PRINTFORMDW 곰처럼 행동하지 말자...
				CASE 2
					PRINTFORML 「그들이 미끼를 물었나 봐. 조금만 들어 올려봐!」
					PRINTFORMDL 당신은 그것을 감아 올리고 창을 들자, 바늘에 미끼 없이 비어있는 것을 발견한다.
					PRINTFORMW 「하하, 그들이 더 잘했군!」
			ENDSELECT
			RETURN 1
			;木片
		CASE 610
			IF TFLAG:194 > 1000
				PRINTFORMW 「걸린 것 같네... 저기 있다.」
				PRINTL 
				PRINTFORMDL 유우기가 나무 조각 하나를 잡았다.
				PRINTW
			ELSE
				PRINTFORMDL 나무를 좀 잡았네...
				PRINTW
			ENDIF
			PRINTFORMDL 이것은 장엄한 유목이다. 일부 열광적인 사람들은 그것을 위해 많은 돈을 지불할 의향이 있을지도 모른다.
			PRINTFORMW 「흐음, 다음 술값으로 충분할지도 모르겠군!」
			RETURN 1
			;紙切れ
		CASE 131
			IF TFLAG:194 > 1000
				PRINTFORML 「아아? 뭔가 걸렸어!」
			ELSE
				PRINTFORMDL 너 종이 몇 장 잡았네...
			ENDIF
			PRINTDW 
			PRINTDL ┌─────────────┐
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 부적
			PRINTDL 복권
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 부적 5개를 모아라
			PRINTDL 복권 한 개를 얻어라
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 기적은 보장되지 않는다.
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 신사
			PRINTDL └─────────────┘
			PRINTW 
			PRINTFORML 「모리야... 모리야? 아아, 최근에 이사 온 그 산신님인가, 그런 분 같네?」
			PRINTFORMW 「이렇게 여기저기 던져지고 있다면, 저쪽의 신앙이 그리 잘 되고 있지 않다는 뜻일까?」
			RETURN 1
		CASE 1 TO 20, 22 TO 60
			LOCALS = %FISH_NAME(TFLAG:193)%
			strFish = %FISH_NAME_TR(TFLAG:193)%
		CASE 21
			LOCALS = ローター
			strFish = rotor
		CASEELSE
			LOCALS = %ITEMNAME:(TFLAG:193)%
			strFish = %ITEMNAME_TR(TFLAG:193)%
	ENDSELECT
	;edited to remove redundancy
	IF TFLAG:194 > 1000
		PRINTFORMW 「오호! 온다, 온다!」
		PRINTL 
		PRINTFORMDL 유우기가 %ARTICLE(strFish)%을 잡았다!
	ELSE
		PRINTFORMDL 당신은 %ARTICLE(strFish)%을(를) 잡았다!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORMDL 　크기: {LOCAL:1}cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORML 　지금까지 잡은 가장 큰 %strFish%이다!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
	ENDIF
	RESETCOLOR
	;説明を流す
	SELECTCASE TFLAG:193
		CASE 1 TO 20, 22 TO 60
			DRAWLINE
			PRINTFORML %CAPITALIZE(strFish)%
			CALL FISHING_EXPLANATION(TFLAG:193)
		CASE 21 ;ローター
		CASE IS > 61
			DRAWLINE
			PRINTFORML %CAPITALIZE(strFish)%
			PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
	ENDSELECT
	PRINTW 
	CALL M_KOJO_COLOR_K64
	SELECTCASE LOCALS
		CASE "ローター"
			PRINTFORML 「도대체 뭐야... 이게 뭐지?」
			PRINTFORMW 「이거에 대해 아는 거 있어, %MASTERNAME:64%?」
		CASE "カエル"
			PRINTFORML 「개구리라니, 응? 먹을 수는 없지만...」
			PRINTFORMW 「이제 잡았으니, 농어용 개구리 낚시를 한번 해보는 건 어때?」
		CASE "氷の鱗", "龍の爪", "龍涎香"
			PRINTFORML 「하아... 이거 도저히 먹을 수 없을 것 같은데!」
			PRINTFORMDW 유우기는 그것을 버리려 하지만, 당신은 필사적으로 그것을 집어든다.
		CASE "アマゴ", "ヤマメ", "イワナ", "ニジマス", "アユ", "ヒメマス", "クニマス"
			PRINTFORML 「%SPLIT_G("Alright:There we go:Nice:Oh yeah")%! 오늘 밤 술안주로 딱이겠어!」
			PRINTFORML 「소금에 그냥 구워도 되는데... 아니면 튀기거나 단물에 조림하는 것도 괜찮을 것 같아...」
			PRINTFORMDW ...유우기가 그렇게 말하니까 괜히 배가 고파진다.
		CASE "ガーパイク", "サケ", "カムルチー", "チョウザメ", "シーラカンス", "イトウ", "ピラルクー", "タキタロウ", "アオウオ"
			PRINTFORML 「오옷! %SPLIT_G("Finally, some big catch:Now that's a big one alright:We got ourselves a jackpot at last")%!」
			PRINTFORML 「살이 실하고 기름져서 먹을 게 많아 보여!」
			PRINTFORMDW ...유우기, 막 물고기를 잡은 곰 같네...
		CASE "ヤツメウナギ"
			PRINTFORML 「%SPLIT_G("Heck yeah:There it is")%! 잠깐, 이건 장어 아니야...? 이게 도대체 뭐야?」
			PRINTFORMDL 그 독특한 입 모양은 가오리장어가 아닐까. 유우기에게 그렇게 말해줘.
			PRINTFORMDL (가오리장어(yatsumeunagi), 여기서 yatsume는 "저 자식"을 의미할 수 있다)
			PRINTFORML 「후우, 알겠다, 그래서 그게 이름이구나! 이제 와서 보니 정말 기운 넘쳐 보여!」
			PRINTFORMDW 가오리장어는 무표정한 채 아무런 응답도 하지 않는다...
		CASEELSE
