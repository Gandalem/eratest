@M_KOJO_MESSAGE_COM_K64_411_1
#DIM 正解
#DIM 経験値
#DIM 制限時間
#DIM 倍率
#DIM FEINT
#DIM イカサマ
VARSET LOCAL
イカサマ = 0
制限時間 = 2000 - (ABL:64:戦闘能力 - ABL:MASTER:戦闘能力) * 100
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;本気の戦闘訓練は一日一回だけ
	IF !TCVAR:64:353
		;特訓デイリーからお借りしました
		CALL M_KOJO_COLOR_K64
		PRINTFORML 「더 강해지기 위해 노력할 의지가 있다니, 그런 태도를 매우 높이 평가한다!」
		PRINTFORML 「산의 사대장 중 한 명으로서, 나 유우기 대단한 자가 최선을 다해 너를 돕도록 하겠다!」
		PRINTFORMDW 유우기는 손가락 마디를 꺾고 싸울 자세를 취한다!
		PRINTFORMW 「준비되면 언제든지 나에게 달려와라!」
		RESETCOLOR
		PRINTFORML 
		CALL ASK_YN("유우기 훈련 시작한다!","거절한다")
		IF RESULT
			CALL M_KOJO_COLOR_K64
			PRINTFORML 「무슨 일이야? 정말 강해지고 싶은 거야, 아니면 그저 허풍이었던 거야?」
			IF TALENT:妊娠 || TALENT:育児中
				PRINTFORMW 「...하아, 뭐 그렇겠지, 어쨌든 상관없어.」
			ELSE
				PRINTFORMW 「...하아, %SPLIT_G("what a letdown:here goes my mood")%. 술이나 마시러 가야겠어.」
			ENDIF
			RESETCOLOR
		ELSE
			TCVAR:64:353 = 1
			正解 = RAND:4
			経験値 = MAX(ABL:64:戦闘能力 * 5, 5)
			SELECTCASE RAND:20
				CASE IS <= 6
					;普通に
					LOCALS:0 = ↑
					LOCALS:1 = →
					LOCALS:2 = ←
					LOCALS:3 = ↓
					倍率 = 100
				CASE 7 TO 10
					;ローマ字
					LOCALS:0 = UE
					LOCALS:1 = MIGI
					LOCALS:2 = HIDARI
					LOCALS:3 = SHITA
					倍率 = 160
					;英語
				CASE 11,12,13
					LOCALS:0 = UP
					LOCALS:1 = RIGHT
					LOCALS:2 = LEFT
					LOCALS:3 = DOWN
					倍率 = 120
					;スワヒリ語
				CASE 14
					LOCALS:0 = juu
					LOCALS:1 = kulia
					LOCALS:2 = kushoto
					LOCALS:3 = chini
					倍率 = 320
					;added Japanese
					;ひらがな
				CASE 15, 16
					LOCALS:0 = うえ
					LOCALS:1 = みぎ
					LOCALS:2 = ひだり
					LOCALS:3 = した
					倍率 = 240
					;カタカナ
				CASE 17, 18
					LOCALS:0 = ウエ
					LOCALS:1 = ミギ
					LOCALS:2 = ヒダリ
					LOCALS:3 = シタ
					倍率 = 240
					;漢字
				CASE IS <= 19
					LOCALS:0 = 上
					LOCALS:1 = 右
					LOCALS:2 = 左
					LOCALS:3 = 下
					倍率 = 400
			ENDSELECT
			;あなたの戦闘能力が高いとフェイントかけてくる
			IF ABL:MASTER:戦闘能力 >= 5 && !RAND:5
				FEINT = 1
				制限時間 += 400
				倍率 += 80
			ELSE
				FEINT = 0
			ENDIF
			CALL FISHER_YATES_SHAFFLE(4)
			PRINTFORMW 유우기(Yuugi)의 공격을 피하고 반대 방향으로 회피하라 (클릭하여 시작)
			PRINTFORM 유우기가 ~로부터 공격한다 
			SETCOLOR C_YELLOW
			IF FEINT
				PRINTFORM %LOCALS:(RAND:4)%
				RESETCOLOR
				PRINTFORM  하지만 실제로는 %LOCALS:(3 - 正解)%에서 온 것이다.
			ELSE
				PRINTFORM %LOCALS:(3 - 正解)%
				RESETCOLOR
			ENDIF
			PRINTFORML !
			$LOOP_IKASAMA
			FOR LOCAL:10,0,4
			LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
			PRINTFORML [{LOCAL}] - 회피한다 %LOCALS:LOCAL%
			NEXT
			SIF !イカサマ && BASE:MASTER:TSP > 500
				PRINTFORML [{4}] - 시간 정지
			TINPUT 制限時間, -1, 1
			IF RESULT == 正解
				PRINTFORML 공격을 피했다!
				IF !イカサマ
					CALL M_KOJO_COLOR_K64
					PRINTFORMDL 유우기의 공격이 빗나가며 방어 자세가 풀리자 그녀의 눈이 놀라 크게 떠졌다.
					PRINTFORMDW 그 순간을 놓치지 않고, 당신은 모든 힘을 실어 유우기의 턱을 주먹으로 가격한다!
					PRINTFORML 「크윽――!」
					PRINTFORML 「하아, 하하! 오 마이 갓, 네가 나를 잡았군!」
					PRINTFORMW 「나한테 진심일 때 공격을 피하다니, 대단한 솜씨야!」
					PRINTFORMDL 유우기는 목을 돌리며 당신을 칭찬한다.
					PRINTFORMDW 당신은 그녀에게 함께 훈련해 준 것에 대해 감사함을 전하고, 노력에 대한 고마움을 표현한다.
					PRINTFORML 「하지만 네가 뭔가 알아차린 것 같아. 눈빛에서 읽을 수 있어.」
					PRINTFORMW 「다음엔 단순한 훈련이 아닌, 진정한 싸움이 기대되네!」
					RESETCOLOR
				ELSE
					;二回目以降は２分の１の確率で反撃される
					IF CFLAG:64:1100 && !RAND:2
						CALL M_KOJO_COLOR_K64
						PRINTFORML 「거기 있구나!!!」
						PRINTFORMDW %BREAKENG(@"네 속셈을 간파한 듯, 시간이 다시 흐르는 순간 유우기가 주먹 뒷부분으로 얼굴을 정면으로 강타한다!")%
						PRINTFORML 「갑자기 그렇게 확신에 차 보여서 말이야,"이봐, 잠깐만, %HE_SHE(MASTER)% 혹시...?"라고 생각했지. 그리고 정말 그랬어!」
						PRINTFORMW 「내가 말했잖아, 안 그래? "다음에 서로 맞설 때는 그걸 염두에 두도록 노력할게", 그렇지?」
						PRINTFORMDW 네가 완전히 허를 찔린 것 같군. 고통스러운 얼굴을 문지르며 어떻게든 몸을 일으킨다.
						RESETCOLOR
						CALL RECOVER(MASTER, -1000, "体力")
						SETCOLOR C_RED
						FONTBOLD
						PRINTFORMW 고통스러운 반격으로 인해 당신의 STA가 큰 타격을 입는다!
						RESETCOLOR
						;通常
					ELSE
						CALL M_KOJO_COLOR_K64
						PRINTFORMDL 시간의 흐름을 멈추고, 유우기 뒤로 걸어가 그녀의 등을 토닥이며 다시 흐르게 한다.
						PRINTFORMDW 그녀는 깜짝 놀란 표정으로 빠르게 돌아보며 당신에게 집중한다.
						PRINTFORML 「――이제 알겠어. 그게 네 능력인가 보네?」
						PRINTFORMW 「그렇다면 다음번에 서로 맞설 때 염두에 두도록 하지!」
						RESETCOLOR
						SIF !CFLAG:64:1100
							CFLAG:64:1100 = 1
					ENDIF
				ENDIF
				CALL RECOVER(MASTER, -(100 * (1 + ABL:戦闘能力)), "体力", " ")
				CALL RECOVER(MASTER, -(100 * (1 + ABL:戦闘能力)), "気力", " ")
				CALL RECOVER(MASTER, -(100 * (1 + ABL:戦闘能力)), "TSP", " ") ;added TSP
				経験値 = 経験値 * 倍率 / 100
				CALL AddEXP("戦闘経験", MASTER, 経験値)
				CALL AddEXP("戦闘経験", TARGET, 経験値 * 2)
				CALL CHANGE_CFLAG(2,TARGET,経験値 * 2)
				CALL CHANGE_CFLAG(4,TARGET,経験値 * 2)
			ELSEIF RESULT == 4 && !イカサマ && BASE:MASTER:TSP > 500
				イカサマ = 1
				倍率 /= 5
				PRINTFORMW 너는 시간 정지를 사용하여 공격을 간파한다!
				GOTO LOOP_IKASAMA
			ELSE
				CALL M_KOJO_COLOR_K64
				PRINTFORMDL 피하기 전에, 유우기의 주먹이 당신의 복부를 강타한다!
				PRINTFORMDW 그 일격의 힘에 몇 번 공중으로 회전한 뒤 땅에 '쿵' 소리를 내며 떨어진다.
				PRINTFORML 「오오옷, 괜찮아...? 정말, 내가 좀 과했나 봐...」
				PRINTFORMW 「음, 지는 법을 배우는 것도 중요해. 귀중한 학습 경험이라고 생각해 봐.」
				RESETCOLOR
				CALL RECOVER(MASTER, -(400 * (1 + ABL:戦闘能力)), "体力", " ")
				CALL RECOVER(MASTER, -(400 * (1 + ABL:戦闘能力)), "気力", " ")
				CALL AddEXP("戦闘経験", TARGET, 経験値)
				CALL CHANGE_CFLAG(2,TARGET,経験値 / 2)
				CALL CHANGE_CFLAG(4,TARGET,経験値 / 2)
			ENDIF
		ENDIF
	ELSE
		PRINTFORMDL 그런 종류의 훈련을 너무 자주 하면 건강을 해친다.
		PRINTFORMDW 대신 유우기에게 가벼운 신체 활동에 함께 하자고 초대한다.
		;added from J
		IF ONCE("YuugiPE")
			PRINTFORML 「그래, 잘했어. 적어도 좀 운동은 해야지.」
			PRINTFORML 「살살 해줄 테니, 온 마음을 다해서 나에게 달려와야 해!」
			PRINTFORMDW 그래도 약간의 운동이긴 하지, 안 그래? 응...?
		ELSE
			IF ABL:MASTER:戦闘能力 > 3
				PRINTFORML 「헤헤, 요새 많이 강해지고 있네, 정말 자랑스럽다!」
				PRINTFORMW 「But you know... you're not quite there yet for me!」
			ELSEIF ABL:MASTER:戦闘能力 > 1
				PRINTFORML 「와, 거기서... 이번엔 잘했어.」
				PRINTFORMW 「점점 이해하기 시작하는군, 안 그래? 다음 걸 하자.」
			ELSE
				PRINTFORML 「자네 좀 봐, 발이 흔들리고 있잖아.」
				PRINTFORMW 「그건 나한테 자네를 이기라고 하는 거랑 같지... 어서, 스쿼트 하자. 지금 바로 오백 개 해!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
