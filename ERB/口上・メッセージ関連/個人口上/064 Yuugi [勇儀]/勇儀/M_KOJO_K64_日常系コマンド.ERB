@M_KOJO_MESSAGE_COM_K64_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止
		RETURN 0
	IF CFLAG:睡眠
		PRINTFORML 
		RETURN 1
		;固有料理
	ELSEIF DISHNAME == "ぼたん鍋"
		;練習
		IF STRCOUNT(DISH_TASTE, "練習")
			PRINTFORML 「맛있게 먹을 수 있고, 눈에도 즐거워…」
			PRINTFORML 「그렇기에 보탄나베가 내가 제일 좋아하는 거야. 너도 분명 좋아할 거라고 확신해!」
			PRINTFORMDW 유우기는 자신의 특별한 레시피의 정수를 가르쳐준다...
			;ラーニング済
		ELSE
			PRINTFORML 「오오, 나의 보탄나베를 요리하고 있는 건가?」
			PRINTFORML 「내가 도와줄게! 마침 배가 좀 고파서 말이야!」
			PRINTFORMDW 유우기가 불을 피하는 동안, 당신은 음식을 준비한다.
		ENDIF
		;通常
	ELSE
		IF ABL:料理技能 < 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「후우, 요리! 해낼 거야?」
					PRINTFORML 「재밌겠다! 내가 도와줄게!」
					PRINTFORML 「그렇다고 해도 난 설거지밖에 못 하겠어.」
					PRINTFORMDW 당신은 음식을 준비하고 유우기가 가끔 맛을 본다.
				CASE 1
					PRINTFORML 「젠장, 이 모든 티스푼과 테이블스푼들... 너무 헷갈린다.」
					PRINTFORML 「이런 것들의 대략적인 규칙은 눈대중으로 측정하는 거라고 말이야!」
					PRINTFORMDL 유우기는 도깨비처럼 격렬하게 요리하며 재료를 사방에 뿌리고 옷을 더럽힌다.
					PRINTFORMDW 조금... 걱정되는 게 틀림없다고 할 수 있다.
				CASE 2
					PRINTFORML 「어? 벌써 끝났다고 하는 거야?」
					PRINTFORML 「생각보다 훨씬 쉽네. 나 혼자서도 이걸 만들 수 있을지도 몰라!」
					PRINTFORMDW 요리에서 무서운 건 결과가 어떻게 될지 절대 알 수 없다는 거지...
			ENDSELECT
		ELSE
			SELECTCASE IFRAND("0TO3", 1, "D2", TALENT:妊娠 || TALENT:育児中)
				CASE 0
					PRINTFORML 「그래서, 오늘 뭐 해 먹을 거야?」
					PRINTFORMDL 유우기에게 오늘의 메뉴가 무엇인지 말해준다.
					PRINTFORML 「%DISHNAME_TR(DISHNAME)%, 응? 좋아! 시작하자!」
					PRINTFORMDW 유우기의 능숙한 손길 덕분에 요리가 훨씬 순조롭게 진행되었다.
				CASE 1
					IF RAND:2 ;repurposed as a variant
						CALL PRINT_DIALOGUE, @"나는 음식이 그저 배에 채워 넣을 수 있는 것이면 다 똑같다고 생각했었다. 하지만... 알고 보니 그것보다 훨씬 많은 게 있구나."
						PRINTFORML 「그것을 알려줘서 고마워!」
						PRINTFORMDW 유우기가 조금 과장하는 것 같은 느낌이 들어...
					ELSE
						PRINTFORML 「내가 이거 꽤 잘한다고 생각하는 거야, 응? 그래, 요즘 나만의 간식을 만들고 있어.」
						PRINTFORML 「하지만 대부분은 네가 가르쳐 준 대로만 하고 있는 거라고!」
						PRINTFORMDW 유우기는 지금 빠르고 효율적으로 요리하고 있다. 그녀의 실력이 정말 향상되었다!
					ENDIF
				CASE 2
					PRINTFORML 「나한테는 되게 맛있어 보이는데, 그렇지 않니?」
					PRINTFORMDL 완성된 요리를 접시에 놓는다.
					PRINTFORML 「자, 나 음료 좀 가지러 갈게...」
					PRINTFORMW 「왜? 좋은 식사와 좋은 술은 함께 먹어야 제맛이잖아, 맞지?」
				CASE 3 ;added
					PRINTFORML 「이봐, 내가 식사 준비하는 거 도와줄게!」
					PRINTFORMDL 유우기가 무슨 이유에서인지 대담하게 합류한다.
					PRINTFORML 「요리도 마시듯이 함께 끝내면 훨씬 더 재미있어지잖아!」
					PRINTFORMDW ...Oh.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
