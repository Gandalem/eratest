; Modular ERB: 個人口上/064 Yuugi [勇儀]/勇儀/M_KOJO_K64_FUNC.ERB
;added

@K64_CALLIN
SIF CFLAG:64:現在位置 == CFLAG:MASTER:現在位置 || FIRSTTIME("YuugiBath", 1, 64)
	RETURN 0
IF FLAG:デート相手
	PRINTFORMDW 다른 사람과 데이트 중일 때 유우기에게 전화하는 것은 꽤 나쁘겠지...
	RETURN 0
ELSEIF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 < 360
	PRINTFORMDW 아직 목욕할 기분이 아니니까 지금 유우기에게 전화하는 건 좀 무례할 것 같다...
	RETURN 0
ELSEIF CFLAG:64:睡眠 || !VISIT(64)
	PRINTFORMDW 계속 전화하고 있는데, 유우기가 자리에 없는 것 같거나 잠들어 있는 듯하다...
	RETURN 0
ELSEIF CFLAG:64:ブチギレ || MARK:64:反発刻印
	PRINTFORMDW 유우기는 기분이 아닌 것 같다...
	RETURN 0
ELSEIF BATHCHECK(CFLAG:64:現在位置) || IN_TOILET(CFLAG:64:現在位置) || CFLAG:64:現在位置 == OMANEKIBEYA()
	PRINTFORMDL 유우기는 지금 바쁜 것 같다.
	PRINTFORMDL 그녀를 기다려 볼래?
	CALL ASK_YN
	IF !RESULT
		LOCAL = RAND(5, 31)
		TIME += LOCAL
		PRINTFORMDW 시간이 좀 지나서, 유우기가 드디어 나타났다!
		PRINTFORMDW {LOCAL}분밖에 걸리지 않았구나...
	ELSE
		RETURN 0
	ENDIF
ENDIF
TIME += 3
CFLAG:64:現在位置 = CFLAG:MASTER:現在位置
CFLAG:64:同室 = 1
CFLAG:64:遭遇位置 = CFLAG:MASTER:現在位置
CFLAG:64:拠点来訪 = 1
TCVAR:64:なるべく動かない = 1
;自由行動の中断
Activity_Duration:64 = 0
Activity_Type:64 = 0
PRINTFORMDL %CALLNAME:64% 당신의 요청에 마치 어디선가 나타난 듯 온다.
CALL SPTALK, [[勇儀]], "笑顔", 0, @"「기다리게 해서 미안해!/ 안녕 %MASTERNAME:64%, 나한테 전화했어?/ 헤헤, 듣기 좋다. 자, 온천에 가서 좀 흠뻑 젖고 쉬자, 어때?」", 1
WAIT
CALL TARGETSET_CHACK
TARGET = 64

@M_KOJO_EVENT_K64_AFTERTRAIN_BEGIN(ARGS,ARG,ARG:1)
;event by linguine
IF CFLAG:64:1099 && !ONCE("YuugiCheatingPunish", 1, 64)
	LOCAL = TARGET
	TARGET = 64
	PRINTFORMDL
	PRINTFORMDW 유우기가 갑자기 당신의 방에 부딪히며 문이 파손되고 경첩에서 떨어지려고 애쓰고 있다.
	IF !FIRSTTIME("YuugiSurpriseRape", 1)
		CALL SPTALK, [[勇儀]], "笑顔", 0, @"「아, 지난번에 고쳤구나, 응? 아유, 기분이 좀 나빠지네.」", 1
		WAIT
		PRINTFORMDW 그녀는 당신을 발견할 때까지 이마에 손을 얹고 혼잣말을 중얼거렸다.
	ENDIF
	PRINTFORMDW 그녀의 자세는 순식간에 곧게 펴지고, 팔은 축 늘어져 옆으로 떨어진다.
	CALL SPTALK, [[勇儀]], "笑顔", 0, @"「오니 앞에서 그렇게 배신적인 짓을 하다니, \@ FIRSTTIME("YuugiSurpriseRape", 1) ? 두 번이나?! # 너는 어떤 존재야?\@」", 1
	WAIT
	PRINTFORMDW 유우기가 천둥 같은 웃음을 터뜨려 당신이 청력을 위해 귀를 막게 만들지만—그것조차 별로 도움이 되지 않았다.
	PRINTFORMDW 그녀는 곧 진정하며 눈에서 몇 방울의 눈물을 닦았다.
	CALL SPTALK, [[勇儀]], "通常", 0, @"「고의로 그랬지, 그렇지 않아? 네 용기와 무모함은 나를 놀라게 해.」", 1
	WAIT
	CALL SPTALK, [[勇儀]], "発情", 0, @"「당신의 행동에 대한 보상과 마땅한 처벌이 필요하다고 생각한다.」", 1
	WAIT
	IF FIRSTTIME("YuugiButINeverCared")
		CALL SPTALK, [[勇儀]], "通常", 0, @"「어라? 다른 여자랑 있어도 상관없다고 말하지 않았나?」", 1
		WAIT
		CALL SPTALK, [[勇儀]], "笑顔", 0, @"「음, 있잖아, 바로 그때였지.」/「그리고 지금은 우리 사이에 상황이 달라졌어.」", 1
		WAIT
		CALL SPTALK, [[勇儀]], "発情", 0, @"「그러니까... 아무리 말해도 이제 너는 살 수 없어!」", 1
		WAIT
	ELSE
		CALL SPTALK, [[勇儀]], "発情", 0, @"「아니, 난 안 화났어. 그냥 도전으로 보는 거지。」/「그리고 그래서, 나는 결코 포기하지 않아!」", 1
		WAIT
	ENDIF
	IF TALENT:妊娠
		PRINTFORMDW 임신한 배에도 여전히 빠르게 움직이는 오니가 광기 어린 표정을 지으며 자신의 열린 손바닥에 주먹을 내리쳤다. 
		PRINTFORMDW 넓고 미친 듯한 미소가 뺨에서부터 번지고 동공은 당신에게 온전히 집중하며 점처럼 작아졌다.
	ELSE
		PRINTFORMDW 빨간 사케 접시를 떨어뜨리며, 오니는 자신의 손바닥을 주먹으로 내리치고 얼굴에 거친 표정이 떠오른다. 
		PRINTFORMDW 넓고 취한 미소가 볼에서 볼로 퍼지고 그녀의 동공은 당신에게만 초점이 맞춰진 작은 점들로 수축한다.
	ENDIF
	PRINTFORMDW 그녀는 거대한 암사자가 어린 가젤에게 다가가는 것처럼 자신만만한 걸음으로 접근하며 목을 돌린다.
	;PRINTFORMDW Needless to say, the only choice you had in the matter is swift and total capitulation...
	PRINTFORMDL
	CALL SPTALK, [[勇儀]], "発情", 0, @"「이봐, 울지 마. 기회를 주지, 알겠어? 딱 한 번만.」/「기절하기 전에 나를 절정에 이르게 한다면, 보내주도록 하지! 어때?」", 1
	WAIT
	CALL SPTALK, [[勇儀]], "笑顔", 0, @"「자, 이제 아래로 가라!」", 1
	WAIT
	PRINTFORMDL
	TRYCALL Add_LOST_GYAKURE_EX(TARGET, 1) ;function from addition branch
	TRYCALL Add_LOST_GYAKURE(TARGET) ;function from addition branch
	PRINTFORMDL
	PRINTFORMDW 모든 것을 가져가기 직전에 희망의 작은 불빛을 던져주다... 지독한 오니답다.
	PRINTFORMDW 경기가 시작되기도 전에 자신이 이 판에서 진 것임을 깨닫는다.
	CALLF FIRSTTIME("YuugiSurpriseRape")
	TARGET = LOCAL
	RETURN 1
ENDIF
