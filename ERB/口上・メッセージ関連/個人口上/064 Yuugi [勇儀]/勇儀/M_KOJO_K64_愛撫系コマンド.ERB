@M_KOJO_MESSAGE_COM_K64_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;custom code, moved here
		PRINTFORML 「후훗, 내 맛을 보고 싶다는 거겠지?」
		PRINTFORMDL 유우기는 자신의 대음순을 넓게 벌려 안쪽 주름을 드러내며 가르랑거렸다.
		PRINTFORMW 「좋아, 가져봐... %MOAN()%♪」 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;cunni, eating out right after a creampie
		IF TCVAR:102
			;恋慕
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDL 당신은 유우기의 정액이 흘러내리는 질에 입을 대고 큰 소리를 내며 빨기 시작한다.
						CALL HPH_PRINT,@"「나중에 좀 남겨줘, 알겠지?HPH」","L"
						CALL HPH_PRINT,@"「나를 위해 한 잔을 따라주기까지 애썼구나... %MOAN()%!HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「후후... 이 정도 양은 나조차 마시기에 너무 많은 것 같네... 흐으」","L"
						PRINTFORMDL 유우기(Yuugi)가 자신의 labia를 펼치자, %SEMEN()% 안쪽에서 끈적한 소리를 내며 흘러나오기 시작한다!
						PRINTFORMDW 네가 그것을 부지런히 모두 핥고 있는 동안, 그녀의 골반이 눈에 띄게 움찔거린다.
					CASE 2
						CALL HPH_PRINT,@"「하아아~... HPH 누가 제법 큰 걸 터뜨린 것 같은데, 말해줘야겠어... HPH」","L"
						PRINTFORMDL 유우기의 보지는 정액으로 계속 넘쳐흐른다. 아무리 열심히 퍼내고 핥으려고 해도 끝이 보이지 않는다...
						CALL HPH_PRINT,@"「하지만 아직 만족하지 못했지, 안 그래? 자, 그럼 일하러 가자. 시간 낭비할 여유 없어 HPH」","W"
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「네가 내 안에 사정하고 나서 실제로 나를 핥을 거라고는 상상도 못 했어... 그래서 맛은 어때?」
						PRINTFORML 「――윽? 하하, 당연하지! 뭘 기대한 거야?」
						PRINTFORMDW 네가 방금 유우기 안에서 사정한 후에 조금이라도 후회하기 시작하는 기분이 들 수도 있을 거다.
					CASE 1
						PRINTFORML 「맞아. 네 정액이면서 이 난장판을 만든 거니까 제대로 치워줘야 해, 알겠지?」
						PRINTFORMDL 네가 방금 그녀에게 사정시킨 많은 양의 %SEMEN()%이 유우기가 다리를 벌리자 흘러나온다.
						PRINTFORMDW 예상했겠지만, 질액과 정액이 섞인 건 입맛을 좋게 만들지는 않는다...
					CASE 2
						PRINTFORMDL 크림파이 직후 유우기에게 구강성교를 시작하는데, 말할 것도 없이 그녀의 보지는 정액 맛이 난다.
						;only one variant is being shown once after a creampie for a cleanup description, so it technically doesn't contradict the above case, might go with "lick your goop off"
						PRINTFORML 「뭐야- 이봐, 일부러 몸을 아프게 하려는 거야? 내가 너한테 나를 핥으라고 말한 적 없잖아!」
						PRINTFORML 「이봐, 그만둬, 스스로 괴롭히지 마. 자, 이걸로 입을 헹궈.」
						PRINTFORMDW 유우기가 술을 건넨다. 지금 이 물조차 축복처럼 느껴질 지경이다...
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;cunnilingus
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아... %MOAN(,,2)%!후프 %MOAN()%!후프」","L"
				PRINTFORMDL %BREAKENG(@"네 혀가 떨리는 아랫입술 사이로 미끄러져 들어가 그녀의 벽을 네 혀의 분홍빛 붓으로 코팅하는 동안, 네 입술이 그녀의 벌어진 입술에 밀착했다.")%
				PRINTFORMDL 그녀의 취향은 날카롭고 취하게 만들며, 속은 많은 아름다운 불완전함이 있는 비단 표면 같다.
				PRINTFORMDW 당신을 둘러싼 그녀의 근육들이 움츠러들고 조여오는데, 당신의 탐색적인 신체 부위에 매우 반응한다...
			CASE 1
				CALL HPH_PRINT,@"「%SPLIT_G("Don't just focus on the outside, you're neglecting the best part:Don't bother with the flappy part, I want you to stick your tongue inside")%...HPH」","L"
				CALL HPH_PRINT,@"「%MOAN(,,2)%...!후후 정말이야, 바로 그거야...!후후」","L"
				PRINTFORMDW 유우기의 얼굴은 당신의 혀가 그녀의 깊숙한 곳을 어루만지는 짜릿한 감각에 기쁨으로 풀어지고 입가에는 미소가 떠오른다...
			CASE 2
				PRINTFORMDL %BREAKENG(@"당신은 혀끝으로 유우기의 %PRINT_CLIT(TARGET)%을 찍고, 이내 벌린 입으로 그녀의 뜨거운 음부를 감싼 뒤, 조여진 입술 사이에 그 진주를 자리 잡게 한다.")%
				CALL HPH_PRINT,@"「%MOAN()%!HPH %MOAN()%!HPH ――하아앗!HPH」","L"
				CALL HPH_PRINT,@"「오 예... HPH 방금 그거 느꼈어, 수고했어... HPH」","L"
				PRINTFORMDW 그녀의 골반은 아래쪽에서부터 맥동하는 강력한 쾌감의 파도에 맞춰 계속 비틀리고 꿈틀거렸다...
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%MOAN(,,2)%♪ 정말 맛있지, 안 그래? 우리가 말하는 건 내 보지야!」
				PRINTFORML 「잡았다! 더 마시고 싶다면 네 혀를 잘 사용해야 할 거야♪」
				PRINTFORMDW 그렇게 유우기는 너 위로 우뚝 서서 너의 얼굴을 그녀의 가랑이에 묻고, 너의 입술을 그녀의 봉선에 단단히 밀착시켰다...
			CASE 1
				PRINTFORML 「%MOAN()%, 큭, 하하! 간지럽네!」
				PRINTFORML 「크흠, 후후! 자 %CALLNAME:MASTER%, 서두르지 마, 천천히 해. 난 어디 안 가니까!」
				PRINTFORMDW 유우기가 당신의 얼굴을 그녀의 사타구니에 박아 넣는 동안, 그녀는 당신의 머리를 활기차게 토닥여 주었다.
			CASE 2
				CALL PRINT_DIALOGUE, @"헤에, 목마르시겠죠, 그렇죠? 뭐, 걱정 마세요. 이 유우기(Yuugi)가 당신의 그 머리(%CALLNAME:MASTER%)에게 충분히 채워줄 테니까!"
				PRINTFORMDL 당신의 머리 뒤쪽을 짓누르던 손아귀가 열정적인 쓸림으로 변하고, 그녀의 손톱이 당신의 머리 표면을 가로질러 선을 그린다.
				PRINTFORMDW 당신이 그녀의 울퉁불퉁한 신경 부위를 핥자 만족스러운 으르렁거림이 목에서 치솟았다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
