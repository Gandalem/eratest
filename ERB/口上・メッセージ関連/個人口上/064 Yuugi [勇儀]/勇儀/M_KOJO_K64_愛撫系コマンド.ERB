@M_KOJO_MESSAGE_COM_K64_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;caress, love (follows the same pattern in the following sections, love -> no love)
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「%MOAN(,,2)%!HPH ――%MOAN("m")%!HPH」","L"
				CALL HPH_PRINT,@"「――오우 그래, %SPLIT_G("just like that:that hit the spot:right there")%...!후후 %MOAN()%, 하아...!후후」","L"
				PRINTFORMDW 유우기는 엉덩이를 들고 좌우로 몸을 흔들며 당신의 손가락이 그녀의 발그레한 아래를 탐험하는 느낌을 즐긴다...
			CASE 1
				CALL HPH_PRINT,@"「――지금 내가 신음하면서 아주 귀엽다고 생각하는 거지, 응? 후후...흐읍」","L"
				CALL HPH_PRINT,@"「물론이지. 내가 그렇게 되는 방식이랄까... 네가 나를 만질 때 말이야... HPH」","L"
				PRINTFORMDW 유우기(Yuugi)는 당신을 가까이 끌어당기고 팔로 등을 감싸며 나지막이 중얼거린다.
			CASE 2
				CALL HPH_PRINT,@"「이봐, 여기 좀 봐. 뭐 빠뜨리고 있는 거 같지 않아?HPH」","L"
				CALL HPH_PRINT,@"「%FSYN("lips_muffle")%... %RANDKISS("kiss")%...!HPH 하아... %RANDKISS("kiss")%...!HPH」","L"
				PRINTFORMDL 당신의 탐색하던 손가락들이 그녀의 입술을 감싸자 멈췄고, 두 혀는 그 사이 공간에서 서로 말려 압박했다.
				PRINTFORMDW %BREAKENG(@"술의 흙내음 가득한 단맛이 여전히 그녀의 입가에 남아있고, 그 아래 깔린 '유우기' 특유의 소박한 향 덕분에 더욱 풍부하고 먹음직스럽게 느껴진다...")%
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		;no love
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%MOAN(,,2)%... 그냥, 뭐랄까, 주저하지 말고 제대로 한번 해보지도 못해?」
				PRINTFORML 「아니면 이대로 날 죽을 때까지 간지럽힐 거야... %MOAN("m")%?!」
				PRINTFORMDW 유우기의 갑작스러운 잡아당김이 %PRINT_CLIT(TARGET)% 그리고 그녀의 엉덩이가 움찔하며 치솟는다.
			CASE 1
				PRINTFORML 「%RANDLIPS(,"kiss")%...」
				PRINTFORML 「%FSYN("lips_over")%...! ...이게 네가 말하는 "오니 퇴치"인가, 후훗?」
				PRINTFORMDW 유우기의 몸을 바이올린처럼 다루지만, 그녀의 질문에 대답으로 고개를 끄덕이는 대신 그저 다시 입술만 맞댄다.
			CASE 2
				PRINTFORML 「왜 그런지 모르겠지만... 이렇게 서로 안을 때마다...」
				PRINTFORML 「몸 전체가 뜨거워져. 네가 나중에 마시려고 아껴두었던 그 특별한 술을 한 모금 마실 때처럼...」
				PRINTFORMDW 유우기(Yuugi)는 그렇게 말하며 당신에게로 돌아와, 당신의 애정 어린 손길을 받아들이며 긴장을 풀었다...
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
