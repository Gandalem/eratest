@M_KOJO_EVENT_K130_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「너무 뚫어지게 보지 말아 주세요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이대로 괜찮은 건가요?」
					ELSE
						PRINTFORMW 「벗으라고 해서 벗는 것도 부끄럽네요」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「...부끄럽네요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「귀여운 속옷 같은 건 아닌데요...」
					ELSE
						PRINTFORMW 「너무 많이 보지 말아 주세요」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「이쪽 쪽이 더 흥분되나요?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「옷을 더럽히고 싶지 않아서요」
					ELSE
						PRINTFORMW 「이런 것도 나쁘지 않을지도 모르겠네요」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 팬티를 대신 줄 거라면 상관없어요?」
								CALL ASK_YN("네","네")
								IF !RESULT
								ELSE
								ENDIF
								PRINTFORMW 「그럼 교환합시다」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「……그럼 교환으로 하죠」
								CALL ASK_YN("네","네")
								IF !RESULT
								ELSE
								ENDIF
							ELSE
								PRINTFORMW 「그냥 주는 것만으로는 싫네요, 교환할까요」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「이걸로 만족하십니까?」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「자, 여기요」
							ELSE
								PRINTFORMW 「감사해라, 내가 해 줄 테니까」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「뭐, 상관없지만」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「네에... 상관없지만 말이야」
							ELSE
								PRINTFORMW 「무엇에 쓰실 생각입니까... 정말이지」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「싫어요」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「안 되네요」
							ELSE
								PRINTFORMW 「기분 나쁜 취미네요.」
							ENDIF
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
