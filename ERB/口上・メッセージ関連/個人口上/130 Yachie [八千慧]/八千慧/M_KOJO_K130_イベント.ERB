				ELSEIF TALENT:思慕
					PRINTFORMW 「내 방에 와 볼래?」
				ELSE
					PRINTFORMW 「시간이 난다면 내 방에 오지 않겠어?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「그럼, 즐거운 일을 하자%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「그럼, 편히 있어 주세요 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「차 정도는 내 드릴 테니, 안심하세요」
				ELSE
					PRINTFORMW 「아무것도 꾸미고 있는 게 아니니까, 안심해 주세요」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「......설마 바람 같은 건 아니시죠?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「무언가 경계하고 있나요?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「그럼 다음에 또 보자」
				ELSE
					PRINTFORMW 「그렇군요, 아쉽네요」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
