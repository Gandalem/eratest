@M_KOJO_SPEVENT_K130_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
IF LOCAL
	PRINTFORMW 「%CALLNAME:MASTER%……오늘은 즐거웠어요」
	PRINTFORMW 야센 케이는 그렇게 말하며 %CALLNAME:MASTER%앞에 가로섰다.
	PRINTFORMW 「그러니까, 부탁 하나만 더 들어줄 수 있겠어?」
	CALL ASK_YN("네","네")
	IF !RESULT
	ELSE
	ENDIF
	PRINTFORMW 「그럼, 사양하지 않고……」
	PRINTFORMW 야치에가 %조사처리(CALLNAME:MASTER,"의")% 목에 손을 감고 그대로 입술을 맞댔다.
	PRINTFORMW 「응윽……」
	PRINTFORMW 「……이것뿐이니까, 그럼 또 봐」
	PRINTFORMW 그녀는 그렇게 말하며 작별을 고하고 그 자리를 떠났다.
	PRINTFORMW 
	PRINTFORMW (나는 어쩜 이렇게 교활할까……어딘가에서 나온 근육질 바보는 고민도 후회도 하지 않을 테지만)
	PRINTFORMW (사용하지 않았다면……%조사처리(CALLNAME:MASTER,"는")% 받아줬을까……?)
	PRINTFORMW 그녀는 고개를 숙이고 울 것 같으면서 쓴 키스의 맛을 음미하고 있었다.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K130_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1130)
			PRINTFORMW 「아, %CALLNAME:MASTER%, 조금 부탁이 있는데」
			PRINTFORMW 헤어질 때 야치에(八千慧)는 평소와 달리 긴장한 어조로 말을 걸어왔다.
			PRINTFORMW 「저랑 사귀어 주실 수 없을까요?」
			PRINTFORMW 「이야기가 너무 성급했나요, 순서대로 이야기하는 게 좋겠네요」
			PRINTFORMW 「간단히 말하면, %조사처리(CALLNAME:MASTER,"의")% 일이, 저는 좋아해요」
			PRINTFORMW 그녀는 말을 잘 하지 못하는 듯 조금씩 이야기를 이어나갔다.
			PRINTFORMW 「호의를 가지고 있다고? 그 이상이에요, 사랑하고 있어요」
			PRINTFORMW 「그래서, 음... 연인이 되어 주세요」
			PRINTFORMW 「...이런 때, 더 좋은 고백 방법도 있을 텐데 잘 안 되네요」
			PRINTFORMW 그렇게 말하며 얼굴을 %CALLNAME:MASTER%쪽으로 향했다.
			PRINTFORMW 「싫어요, %조사처리(CALLNAME:MASTER,"가")% 누군가의 것이 되어버리는 게」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 누군가와 친하게 지내는 걸 보면 마음이 아파요」
			PRINTFORMW 「그러니 평생의 부탁이에요」
			PRINTFORMW 「저만의 %조사처리(CALLNAME:MASTER,"가")% 되어 주지 않겠어요?」
			PRINTFORMW 조금 부끄러운 듯 수줍게 미소 지었다.
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 나에게 너무 창피를 주지 말아 주세요.」
			PRINTFORMW 야센 케이는 가슴에 손을 얹고 각오를 다진 듯 말을 이었다.
			PRINTFORMW 「사랑해요... 저랑 사귀어 주지 않겠어요?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「후후, 긴장되는 것이네요, 이런 것은」
		PRINTFORMW 야치에가 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 목에 손을 감고 안는 자세가 되었다.
		PRINTFORMW 「음……」
		PRINTFORMW 그대로 %조사처리(CALLNAME:MASTER,"의")% 입술에 키스하고
		PRINTFORMW 「맹세의 키스예요, 배신하지 말아 주세요, %CALLNAME:MASTER%」
		PRINTFORMW 그렇게 요염하게 미소 지어 보였다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……후회할 거예요, %CALLNAME:MASTER%」
		PRINTFORMW 야치에(八千慧)는 조금 어두운 미소를 띠고 있다.
		PRINTFORMW (마음대로 되지 않으니까, 좋아해서 흥분하는 걸까?)
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K130_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……오늘은 이제 돌아가자, 기분이 안 좋아서」
			PRINTFORMW 야치에(八千慧)는 그렇게 말하고 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「또 내일, 데이트해요. 약속이에요?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「오늘은 정말 즐거웠어요, 또 데이트해 주세요」
			CALL ASK_YN("네","네")
			IF !RESULT
			ELSE
			ENDIF
			PRINTFORMW 「...기대하고 있어요」
		ELSEIF TALENT:思慕
			PRINTFORMW 「오늘은 이걸로 끝이지만, 다음에 또 데이트해 주세요」
			CALL ASK_YN("네","네")
			IF !RESULT
			ELSE
			ENDIF
			PRINTFORMW 「후후, 좋은 대답이네요. 기대하고 있을게요」
		ELSE
			PRINTFORMW 「꽤 즐거운 하루였어요, 또 언젠가 데이트해요」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K130_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;今日会ってない。
	IF !TCVAR:130:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:130:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「지금 가져오는 중인데, 무슨 용무라도 있으신가요?」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K130
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「...가까이 오지 말아 주시겠어요?」
					;屋外かつ満月
				ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					PRINTFORMW 「아아, %CALLNAME:MASTER%인가요, 오늘 밤 달이 예쁘네요.」
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%저쪽 달을 볼 수 있다니, 행복할지도 모르겠네요.」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「……아무것도 아니에요」
					ENDIF
					;台風
				ELSEIF FLAG:異常気象 == 9
					PRINTFORMW 「%CALLNAME:MASTER%, 태풍이 와서 힘들군요」
					IF TALENT:恋人
						PRINTFORMW 「……그러니까, 네%UNICODE(0x2665) *1%」
						PRINTFORMW 야치에는 요염하게 미소 지었다.
					ENDIF
					;猛吹雪
				ELSEIF FLAG:異常気象 == 10
					PRINTFORMW 「%CALLNAME:MASTER%오늘은 밖에 나가지 않는 게 좋아요」
					IF TALENT:恋人
						PRINTFORMW 「나도 추위는 싫으니까, 서로 따뜻하게 지내자네 %UNICODE(0x2665) *1%」
					ENDIF
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕, %CALLNAME:MASTER%」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「오늘은 뭘 할 거예요? 기대되네요」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「나를 보러 와 준 건가요? 기쁘네요.」
					ELSEIF TALENT:思慕
						PRINTFORMW 「시간 있으면 같이 있어 줄게요」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:130:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「지금 가져오는 중인데, 무슨 용무라도 있으신가요?」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K130
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「……최악이다」
					;屋外かつ満月
				ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					PRINTFORMW 「아아, %CALLNAME:MASTER%인가요, 오늘 밤 달이 예쁘네요.」
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%저쪽 달을 볼 수 있다니, 행복할지도 모르겠네요.」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「……아무것도 아니에요」
					ENDIF
					;台風
				ELSEIF FLAG:異常気象 == 9
					PRINTFORMW 「%CALLNAME:MASTER%, 태풍이 와서 힘들군요」
					IF TALENT:恋人
						PRINTFORMW 「……그러니까, 네%UNICODE(0x2665) *1%」
						PRINTFORMW 야치에는 요염하게 미소 지었다.
					ENDIF
					;猛吹雪
				ELSEIF FLAG:異常気象 == 10
					PRINTFORMW 「%CALLNAME:MASTER%오늘은 밖에 나가지 않는 게 좋아요」
					IF TALENT:恋人
