					ENDIF
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕, %CALLNAME:MASTER%」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「오늘은 뭘 할 거예요? 기대되네요」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「나를 보러 와 준 건가요? 기쁘네요.」
					ELSEIF TALENT:思慕
						PRINTFORMW 「시간 있으면 같이 있어 줄게요」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF TALENT:恋人
				PRINTFORMW 「어느 정도는 다 해드릴 수 있어요, 그런 사이니까요.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「모처럼 왔으니 같이 들어갈래요, 뭐야, 안 줄 거예요.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「어라? 같이 들어가도 괜찮아요?」
				CALL ASK_YN("네","네")
				IF !RESULT
				ELSE
				ENDIF
			ELSE
				PRINTFORMW 「먼저 오셨지만, 사양하지 않아요」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			IF TALENT:恋人
				PRINTFORMW 「나는 신경 쓰지 않지만, %조사처리(CALLNAME:MASTER,"가")% 신경을 쓴다면 사양할게요」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「나와 같은 방식으로 깔끔한 거네요, 좋은 일이에요」
			ELSEIF TALENT:思慕
				PRINTFORMW 「……이건 실례야」
			ELSE
				PRINTFORMW 「......이상한 게 떠 있을 것 같네요... 사양하겠습니다」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			IF TALENT:恋人
				PRINTFORMW 「음, 지금 그런 기분은 아니라서 미안하지만」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「…죄송해요, 나가주시겠어요?」
			ELSEIF TALENT:思慕
				PRINTFORMW 「혼자 들어가고 싶은데, 나가주실 수 있나요?」
				CALL ASK_YN("네","네")
				IF !RESULT
				ELSE
				ENDIF
			ELSE
				PRINTFORMW 「엿보는 건가요? 그만들어 주셨으면 합니다.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:130:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「지금 가져오는 중인데, 무슨 용무라도 있으신가요?」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K130
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「……최악이다」
					;屋外かつ満月
				ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					PRINTFORMW 「아아, %CALLNAME:MASTER%인가요, 오늘 밤 달이 예쁘네요.」
					IF TALENT:恋人
						PRINTFORMW 「%CALLNAME:MASTER%저쪽 달을 볼 수 있다니, 행복할지도 모르겠네요.」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「……아무것도 아니에요」
					ENDIF
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕, %CALLNAME:MASTER%」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「오늘은 뭘 할 거예요? 기대되네요」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「나를 보러 와 준 건가요? 기쁘네요.」
					ELSEIF TALENT:思慕
						PRINTFORMW 「시간 있으면 같이 있어 줄게요」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:130:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「지금 가져오는 중인데, 무슨 용무라도 있으신가요?」
			ELSE
				IF TALENT:恋人
					PRINTFORMW 「……」
					PRINTFORMW 「......바보」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「만남인가요, %CALLNAME:MASTER%?」
					PRINTFORMW (미남자...)
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 데이트인가요? 즐거워 보이네요」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
