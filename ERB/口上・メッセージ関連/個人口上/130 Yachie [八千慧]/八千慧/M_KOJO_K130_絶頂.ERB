@M_KOJO_MESSAGE_PALAMCNG_A_K130_22(ARG)
;-------------------------------------------------
;シックスナイン
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;同時射精
	IF NOWEX:射精 && NOWEX:MASTER:射精
		PRINTFORMW
		RETURN 1
		;TARGETだけ射精
	ELSEIF NOWEX:射精
		;PLAYERについてる
		IF GETBIT(TALENT:PLAYER:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			PRINTFORMW
			RETURN 1
		ENDIF
		;PLAYERだけ射精
	ELSE
		;TARGETについてる
		IF GETBIT(TALENT:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음, 잔뜩 사정해라」
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음~~~」
				PRINTFORMW 「%CALLNAME:MASTER%만 가다니 반칙이잖아요...」
				RETURN 1
			ELSE
				PRINTFORMW 「음~」
				PRINTFORMW 「시원해지셨나요?」
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
