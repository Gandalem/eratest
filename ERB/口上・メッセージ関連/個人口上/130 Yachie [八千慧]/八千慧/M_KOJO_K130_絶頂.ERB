; Modular ERB: 個人口上/130 Yachie [八千慧]/八千慧/M_KOJO_K130_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K130
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
	ELSE
		PRINTFORMW 「음응%UNICODE(0x2665) *1%」
		PRINTFORMW 「나라도 가슴은 나올 수 있어요%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSE
			PRINTFORMW 「으゛읏%UNICODE(0x2665) *1%으゛읏%UNICODE(0x2665) *1%느゛느゛느゛읏%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 제대로 된 목소리조차 되지 않는 교성을 내지르며 엄청난 쾌락에 몸을 떨고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「으읏%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「으응읏%UNICODE(0x2665) *1%으아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「으윽 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%오옷%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%오゛읏%UNICODE(0x2665)*1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응앗%UNICODE(0x2665) *1% 가버려엇%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「으읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응아%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%느히읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「으゛읏%UNICODE(0x2665) *1% 안 돼앳%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%좀 더엇%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「으앗%UNICODE(0x2665) *1% 응힛%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「좀 더읏%UNICODE(0x2665) *1% 가게 해줘읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으앗%UNICODE(0x2665) *1%오゛읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%앗%UNICODE(0x2665) *1% 안 돼애%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｃ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「거기! %UNICODE(0x2665) *1% 거기!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「거기……%UNICODE(0x2665) *1% 좀 더……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「클립으로 가버릴 거야 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「야앗%UNICODE(0x2665) *1% 그만둬%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 정말%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 깊어엇%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 바보가 돼버려앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 거기읏%UNICODE(0x2665) *1% 좀 더엇%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 으응읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「으゛읏%UNICODE(0x2665) *1% 거기읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「애널이 약하다니……%UNICODE(0x2665) *1% 그런 건……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「읏%UNICODE(0x2665) *1%애널로 가버려엇%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%감도는 쿠로코마 따위보다 훨씬 높거든요%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 어째서인지 가슴으로 절정하며 득의양양해하고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「안돼앳%UNICODE(0x2665) *1% 너무 민감하단 말이에요옷%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응흣%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「더엇%UNICODE(0x2665) *1%가슴읏%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 야치에가 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW (입으로도 기분이 좋아지는 거군요......%UNICODE(0x2665) *1%)
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으으읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%푸핫%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 더 기분 좋아지도록 하자 %UNICODE(0x2665) *1%
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K130
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
