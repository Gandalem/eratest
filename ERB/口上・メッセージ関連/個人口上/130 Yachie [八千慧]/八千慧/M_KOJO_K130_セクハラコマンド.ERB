;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		IF RAND:3 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 엉덩이뿐이야……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응! %UNICODE(0x2665) *1%」
			PRINTFORMW 「거기는 약하니까...」
		ELSE
			PRINTFORMW 「응? %UNICODE(0x2665) *1% 뭔가... 아무것도 아니에요」
		ENDIF
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「그만둬!」
		PRINTFORMW 야치에가 '딱' 소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 뺨을 때렸다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「이런 플레이가 취미인가요? 싫지는 않지만...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「꼬리 밑부분은 약하니까, 너무...」
		ELSE
			PRINTFORMW 「전혀, 사람들 앞에서 만지지 말아 주세요.」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「별로 이런 건 하지 않는 편이 좋을 것 같아요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응, 뭐예요!?」
			PRINTFORMW 「......뭐 하시는 거예요, 바보...」
		ELSE
			PRINTFORMW 「……무슨 일이에요? 그런 걸 할 거면 장소를 옮겨요」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 취미에 간섭하지는 않지만 별로 좋지 않아.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그만두세요」
			PRINTFORMW 야치에는 '팍' 하고 손을 뿌렸다.
		ELSE
			PRINTFORMW 「치한인가... 인간 남성의 성욕은 무시할 수 없군요」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「……」
			PRINTFORMW 야치에(八千慧)는 날카롭게 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「죽고 싶은 건가요?」
		ELSE
			PRINTFORMW 「죽여버릴 거야?」
			PRINTFORMW 야치에는 미소 지으며 화를 내고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
