;CFLAG:うふふ==2&&TCVAR:20(35=スカートの中を見せる 70=クンニ強制 85=Ｖ挿入する 86=だいしゅきホールド 87=Ａ挿入する 88=腰振りＶ 89=腰振り
;ABL:Ｃ感覚(4未満=くすぐったい 6未満=ちょっといいかも 6以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K130_315
;成否判定
;TFLAG:192(-1＝強制失敗
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K130_315
CALL M_KOJO_MESSAGE_COM_K130_315_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K130_315_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW 얼어붙은 시간 속에서 야치에의 클리토리스를 애무했다.
	ELSEIF CFLAG:TARGET:睡眠
		PRINTFORMW 「......응흣%UNICODE(0x2665) *1%」
		PRINTFORMW 야치에야는 푹 자고 있었지만 신음을 내뱉는다.
	ELSEIF CFLAG:うふふ == 2
		IF RAND:3 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1% 거기읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%소리 나와 버리니까앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「읏……%UNICODE(0x2665) *1%그만해……%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「！」
		PRINTFORMW 「어디 만지고 있는 거예요!」
		PRINTFORMW 야치에가 '팍' 소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 뺨을 때린다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 거기앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 소리 나와 버리니까앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「읏……%UNICODE(0x2665) *1%그만해앳……%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……윽%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 클리토리스를 애무당하며 느끼고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 바보, 어디를 만지고 있는 거예요……%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 그렇게 말하면서도 행위를 받아들이고 있다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「이런 거 별로 안 좋아요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응? %UNICODE(0x2665) *1% 벌써, 바보인가요?」
		ELSE
			PRINTFORMW 「배짱이 대단하시네요...%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「......바보!」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"에게")% 만져지는 것이 싫다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「！？」
			PRINTFORMW 「뭐 하시는 거예요!」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 행위에 당황하고 있다.
		ELSE
			PRINTFORMW 「죽여버릴 거야!」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
