		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1% 잠깐만앳%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
