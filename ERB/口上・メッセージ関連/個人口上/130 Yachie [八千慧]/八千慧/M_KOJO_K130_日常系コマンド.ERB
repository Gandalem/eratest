;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K130_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K130_302
CALL M_KOJO_MESSAGE_COM_K130_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K130_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「나에게도 역린이 있는 거랍니다?」
			PRINTFORMW 야치에(八千慧)는 스킨십에 대해 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「나에게 손대지 마!」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「그만두세요!」
			PRINTFORMW 야치에가 화난 표정으로 항의해 온다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「가려운 곳은 없나요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......커다란 등, 나만의 등이 되어 주지 않겠어요?」
		ELSE
			PRINTFORMW 「사람의 등을 흘린 적은 없으니, 조절을 전해주세요.」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「괜찮아요, 화내지 않을 거예요」
			PRINTFORMW 입으로는 그렇게 말하면서도 야치에가 %조사처리(CALLNAME:MASTER,"에게")% 안겼다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응... 간지러워요...」 %UNICODE(0x2665) *1%
			PRINTFORMW 야치에가 얼굴을 붉히며 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 하고 있다.
		ELSE
			PRINTFORMW 「뭐, 이런 스킨십도 행복할지도 모르겠네요」
			PRINTFORMW 야치에는 얼굴을 흐릿하게 만들면서 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 하고 있다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「이런 곳은 남들에게 보여주고 싶지 않은 것이죠」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좋아해요, %조사처리(CALLNAME:MASTER,"랑")% 애틋하게 하는 거」
		ELSE
			PRINTFORMW 「……음음……」
			PRINTFORMW 「펫으로 취급당하는 것도 나쁘지 않을지도 모르겠네요」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「응... 느끼고 있지 않아, 바보...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「별로 만져지는 건……」
			PRINTFORMW 「……나쁘지 않을지도 모르지만요」
