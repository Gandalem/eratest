				ELSE
					PRINTFORMW 「......후우...... 힘들다...!」
				ENDIF
			ENDIF
		CASE 6
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			IF CFLAG:318 == 1
				PRINTFORMW 「...조용히 해 주실 수 있나요?」
			ELSEIF TFLAG:193 == -1
				PRINTFORMW 「……그런가요」
