;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K130_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K130_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K130_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K130_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「시끄럽네요. 조용히 해 주시면 안 될까요」
		;会話不能
	ELSEIF TCVAR:302
		IF RAND:5 == 0
			PRINTFORMW (...... 뭔가 말해 주시지 않겠어요?)
		ELSEIF RAND:4 == 0
			PRINTFORMW (......어색하네......)
		ELSEIF RAND:3 == 0
			PRINTFORMW (…할 말이 없네요)
		ELSEIF RAND:2 == 0
			PRINTFORMW (…시간이 흘렀네요)
		ELSE
			PRINTFORMW (뭔가…… 할 이야기가……)
		ENDIF
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「%CALLNAME:MASTER%～」
			PRINTFORMW 야치에가 취해서 말을 걸어온다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 「저기 %CALLNAME:MASTER%……」
			PRINTFORMW 야치에가 취해서 달라붙는다.
			PRINTFORMW 「……아무것도 아니에요」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「%CALLNAME:MASTER%」
			PRINTFORMW 야치에가 얼굴을 상기시키며 부른다.
			PRINTFORMW 「그냥 불렀을 뿐이에요... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%CALLNAME:MASTER%~ 어디 보고 있어요?」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%……」
		ENDIF
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「%CALLNAME:MASTER%……」
			PRINTFORMW 「……취해서 쓰러지면 부축해 주세요」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%CALLNAME:MASTER%」
			PRINTFORMW 야치에(八千慧)는 취해서 말을 건다.
			PRINTFORMW 「......부른 것뿐이에요? 오해하지 말아 주세요.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「조금 좋았네요」
			PRINTFORMW 「나쁘지는 않지만요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……%CALLNAME:MASTER%%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「음……」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 마시고 있나요?」
		ENDIF
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「음... ♪」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「……%CALLNAME:MASTER%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「음……음……」
			PRINTFORMW 「아직 취하지 않았어요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응? 뭐야 벌써...」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 이런 것도 즐겁네요」
		ENDIF
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「모두들 바보뿐이군……」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「쿠로코마도 제대로 된 일을 하지 않네요」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「왠지 취해왔어요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「조금 과음했나 보군요...」
		ELSE
			PRINTFORMW 「……머리 아프네」
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「……음…」
			PRINTFORMW 「취해왔어…」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「……」
			PRINTFORMW 「물... 좀 주세요...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「정말 저 신 행세하는 것도 귀찮은 일을...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……거북이가 아니에요……」
		ELSE
			PRINTFORMW 「...조금 취했나 보네요」
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「……기분 좋네요♪」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「～♪」
			PRINTFORMW 야치에가 작은 흥얼거림을 부르고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「기분이 좀 나아졌습니다」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 때, 이상한 생각을 하게 되더라고요」
		ELSE
			PRINTFORMW 「아직 더 마실 수 있어요?」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「목욕도 좋아하지만, 수영하는 것도 좋아요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「욕조에 몸을 담그고 있으면 모든 것을 잊을 수 있거든요... 그래서 목욕을 좋아하는 거예요」
		ELSE
			PRINTFORMW 「아아... 언제까지나 몸을 담그고 싶네요...」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「지내기 좋은 날씨네요, 등딱지를 말리기에 딱이에요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「벚꽃이 아름답다고 비참해집니다」
						PRINTFORMW 「......방금 들은 건 못 들은 걸로 해주세요」
					ELSE
						PRINTFORMW 「이런 날 밖에 나가는 게 가장 좋아요.」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「더워... 참아줬으면 하는 더위네요...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「지상의 더위는 견디기 힘들군요...」
					ELSE
						PRINTFORMW 「너무 가까이 오지 말아 주세요... 더우니까...」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「단풍이 아름답네요, 전부 말로해버리고 싶어...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「지상은 맛있는 것이 많아서 부럽네요」
					ELSE
						PRINTFORMW 「시원해서 지내기 좋네요, 졸려지겠어……」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「우으... 움직임이 느려져 버리네요...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「변온동물이니까, 따뜻하게 해 주세요.」
					ELSE
						PRINTFORMW 「겨울이 되면 이유 없이 슬퍼지곤 하네요... 아니, 추운 게 싫을 뿐이지만」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						PRINTFORMW 「우리가 신을 바라더라도 아무것도 얻을 수 없는데, 어째서 인간이 바라면 신이 내려오는 걸까요?」
						PRINTFORMW 「부조리하네요. 뭐, 상관없는 이야기지만요.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 저랑 이야기하는 거 즐거워요?」
						PRINTFORMW 「전 즐거워요, %조사처리(CALLNAME:MASTER,"와")% 대화할 수 있어서」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「%CALLNAME:MASTER%에 대해서 목걸이를 걸어주고 싶을 정도로 좋아요?」
						PRINTFORMW 「……저도 그런 것을 받고 싶은 쪽은 부정할 수 없네요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「사람도 겉보기엔 재미있네요, 이렇게 소통하는 것은 별로 경험이 없는 것이라.」
					ELSE
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 있다면 우리가 천하를 차지하는 것도 쉬운 일이겠네요」
						PRINTFORMW 「……다른 말은 필요 없어요? 다른 사람에게 말하면…… 죽일 거예요 %UNICODE(0x2665) *1%」
						PRINTFORMW 야치에는 킬킬 웃으며 농담이라고 덧붙였다.
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「인간이란 참 재미있네요, %조사처리(CALLNAME:MASTER,"가")% 재미있는 것뿐일지도 모르겠지만」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「남의 이야기를 들어주는 것도 즐겁네요」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「쿠로코마도 머리가 좋다면 매력적인데 말이죠.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 저랑 쿠로코마 중에 누가 좋아요?」
						PRINTFORMW 「……들었을 뿐이에요, 잊어주세요」
					ELSE
						PRINTFORMW 「저 도자기 군단한테도 곤란한 일이 생겼습니다」
						PRINTFORMW 「위험할 때는 의지하고 있습니다, %CALLNAME:MASTER%」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「지상도 의외로 재미있는 곳이었습니다.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「%CALLNAME:MASTER%도 쿠로코마처럼 근육으로만 살아서는 안 돼요?」
						PRINTFORMW 「머리를 쓰지 않으면, 좋은 대로 이용당할 테니까요」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「하늘을 날 수 있냐고요?」
						PRINTFORMW 「……사지를 거두고 회전하면서 날 수 있어요.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「수는 힘입니다, 그래서 우리는 무리를 지어 있는 것이랍니다」
					ELSE
						PRINTFORMW 「……치생계도 나쁘지는 않지만」
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 마음에 들지 않았을까요」
					ENDIF
				ELSEIF CFLAG:2 >= 500
					IF RAND:5 == 0
						PRINTFORMW 「저 무녀도 결국 인간에 불과했네요」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「그 신님도 결국 사람을 노예로 만드는 것뿐이잖아」
						PRINTFORMW 「그렇다면 저에게 다 쓰이는 편이 세상과 사람들을 위한 것이겠지요」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「귀찮은 일이 있다면 내가 해결해 줄게?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「……%조사처리(CALLNAME:MASTER,"의")% 이야기는 언제나 흥미롭네요」
					ELSE
						PRINTFORMW 「지상으로 나와도 저희에게는 기반이 없다고 말이죠.」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「무슨 일입니까?」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「재미있는 이야기를 해드릴게요, %CALLNAME:MASTER%」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「쿄가조라는 녀석들에게 휘둘려서는 안 돼요?」
						PRINTFORMW 「저놈들은 머리가 나빠서 바로 폭력에 호소하는 형편없는 녀석들이니까요.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「천생계도 의외로 좁네요, 지상은 넓다고들 하는데」
					ELSE
						PRINTFORMW 「무슨 일 있으면 바로 연락 주세요.」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
