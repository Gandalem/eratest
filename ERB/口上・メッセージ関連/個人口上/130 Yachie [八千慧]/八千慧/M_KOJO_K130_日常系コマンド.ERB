@M_KOJO_SUCCESS_COM_K130_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K130_301
CALL M_KOJO_MESSAGE_COM_K130_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K130_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「무슨 생각을 하고 계신 건가요?」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「맛없어...」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「마실 수 있는 것이 아니군요......」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「봉사로서의 재능은 없는 것 같네요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이렇게 맛있는 차를 우릴 수 있다니, 재능이네요」
		ELSE
			PRINTFORMW 「……쓰다」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「후우... 맛있네요...」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「어머, 차 자국이 서 있네요」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 우려낸 차는 맛있네요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「다도에는 별로 자세히 알지 못하지만... 괜찮은 몸가짐으로」
		ELSE
			PRINTFORMW 「맛있다……」
		ENDIF
	ENDIF
ENDIF
RETURN 1
