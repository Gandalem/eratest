IF LOCAL
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			;(GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
			IF RAND:3 == 0
				PRINTFORMW 「우리 구역에서 함부로 장난 치면 어떻게 되는지 알고 있겠지?」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「꾸중을 들었네요, 다음에 카와우소 레이에게 사과하게 해볼까요」
			ELSE
				PRINTFORMW 「너무 오래 머물면 안 되겠네요, 가시죠」
			ENDIF
			;やっぱりやめる（見送り）
		CASE -1
			IF RAND:3 == 0
				PRINTFORMW 「조금 더 구경해도 좋았을 텐데 말이야」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「이번에는 저희와 제휴해 주시겠어요, 물건만 좀 진열해 달라는 거예요」
			ELSE
				PRINTFORMW 「미미(커피곰)에게 줄 기념품이 생겼네요」
			ENDIF
			;400点未満（BAD）
		CASE 1
			IF RAND:3 == 0
				PRINTFORMW 「쿠로코마에게 주는 게 좋겠네요」
				PRINTFORMW 야치에는 별로 기뻐 보이지 않는다……
			ELSEIF RAND:2 == 0
				PRINTFORMW 「토테츠라면 기꺼이 먹어줄 거예요」
				PRINTFORMW 야치에는 별로 기뻐 보이지 않는다…….
			ELSE
				PRINTFORMW 「센스가 없네요...」
				PRINTFORMW 야치에(八千慧)는 그다지 기뻐 보이지 않는다...
			ENDIF
			;400点～699点（NOMAL）
		CASE 2
			IF RAND:3 == 0
				PRINTFORMW 「고마워, 소중히 간직할게」
