@M_KOJO_MESSAGE_COUNTER_K130_51
CALL M_KOJO_MESSAGE_COUNTER_K130_51_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K130_51_1
;出す直前
IF BASE:PLAYER:2 > 8000
	;精液中毒4以上
	IF ABL:精液中毒 > 4
		IF RAND:3 == 0
			PRINTFORMW 「응응 %UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하고 능숙한 혀놀림으로 그것을 더욱 재촉하고 있다.
			PRINTFORMW 「자, 어서 정액을 내보내렴 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「으응……%UNICODE(0x2665) *1%……응읏%UNICODE(0x2665) *1%……냄새나앗%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 능숙하게 놀려 그것을 재촉하고 있다.
		ELSE
			PRINTFORMW 「응%UNICODE(0x2665) *1% 나와랏%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 교묘하게 그것을 재촉하고 있다.
			PRINTFORMW 「어서 정액을 마시게 해%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응, 응...」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 능숙한 혀놀림으로 그것을 더욱 재촉하고 있다.
			PRINTFORMW 「어떠세요? 벌써 사정하고 싶으시죠?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응~%UNICODE(0x2665) *1%푸핫%UNICODE(0x2665) *1%」
			PRINTFORMW 「자지를 빨리고 한심한 얼굴을 하고 계시네요, 귀여우셔라%UNICODE(0x2665) *1%」
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 더욱 재촉하고 있다.
		ELSE
			PRINTFORMW 「음, 으윽... 으응」 %UNICODE(0x2665) *1%
			PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 능숙한 혀놀림으로 그것을 더욱 재촉하고 있다.
		ENDIF
	ENDIF
	;舌3以上
ELSEIF ABL:舌 > 2
	;精液中毒4以上
	IF ABL:精液中毒 > 4
		IF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%츄읍%UNICODE(0x2665) *1%핥아앗%UNICODE(0x2665) *1%」
			PRINTFORMW (왠지 핥고 있으니 흥분해 오는군요……%UNICODE(0x2665) *1%)
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응음! %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
			PRINTFORMW (그것이 마음에 드는 듯하다 %UNICODE(0x2665) *1%)
		ELSE
			PRINTFORMW 「츄릅%UNICODE(0x2665) *1% 낼름%UNICODE(0x2665) *1% 으응읏%UNICODE(0x2665) *1%」
			PRINTFORMW (이거 좋아……%UNICODE(0x2665) *1%)
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음~푸하핫%UNICODE(0x2665) *1%」
			PRINTFORMW 「후훗, 내가 핥아서 깨끗하게 해 줄 테니 감사히 받아라%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「자, 제가 입으로 해 드릴 테니 기뻐해 주세요」
		ELSE
			PRINTFORMW 「んん읏%UNICODE(0x2665) *1%臭いですね、普段から綺麗にしないから歯垢が溜まるんですよ?」
		ENDIF
	ENDIF
	;それ以外
ELSE
	IF RAND:3 == 0
		PRINTFORMW 「응~ %UNICODE(0x2665) *1%」
		PRINTFORMW 「...냄새가 나네」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「……흐읍……응! ……쪽%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「......음응... 컥...」
		PRINTFORMW 야치에는 어딘가 어색하게 그곳을 입에 물고 있다.
	ENDIF
ENDIF
RETURN 1
