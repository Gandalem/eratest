; Modular ERB: 個人口上/130 Yachie [八千慧]/八千慧/M_KOJO_K130_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K130_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「나에게 시비를 걸다니 배짱이 좋네요」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「지옥은 절망적으로 넓습니다. 첫 번째로 안내해 드리죠.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「어리석은…… 나에게 어떻게든 할 수 있다고 생각하는 건가요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좋아요, 받아내겠습니다.」
		ELSE
			PRINTFORMW 「검은 말만큼 바보가 아닌 모양이군요, 좋습니다.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……っ！」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「...하시네요」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「...우연이에요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「찰과상입니다」
				ELSE
					PRINTFORMW 「이 정도로는 흐름을 바꿀 수 없어요」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……적당히 해라!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「의외로 강하시네요.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「이대로는 지고 말 거예요...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「사람에게도 의외로 골이 있는 사람이 있네요」
				ELSE
					PRINTFORMW 「손 봐주지도 않을 건가요? ……농담이에요」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……죽어라……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「안 되겠네요...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「이러서는 부하들에게 모범을 보일 수 없겠네요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이 정도의 힘이 있다니...」
				ELSE
					PRINTFORMW 「흐름이 좋지 않았던 것 같네요.」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……어리석군요」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「나에게 질 정도로는 아직 멀었네요」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「이거 단련할 맛 나겠네요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「저는 무사한데요? 봐준 건가요?」
				ELSE
					PRINTFORMW 「정말 하찮은 싸움이었네요.」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이 정도 가지고 감히 맞서려 했군요」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「짐승계 쪽이 훨씬 골치 아픈 녀들이 많아요?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「수달 레이무 쪽이 더 강할지도 모르겠네요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「옷값 정도는 지불하게 해드리죠」
				ELSE
					PRINTFORMW 「나에게 거스르지 않는 편이 좋을 거라고 몸으로 깨달았나요?」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……폐를 끼쳤군요」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「꽤 괜찮은 다도였어.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「뭐, 검은 말보다는 약하네요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「그 정도로는 축생계에서는 통하지 않아요.」
				ELSE
					PRINTFORMW 「... 다른 사람을 찾으시겠습니까」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「......바보」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「항복입니다... 지옥이라고 말하고 있습니다」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「역시 강하시네요.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이 정도라면 지옥계의 천하도 얻을 수 있을지도……. 아니, 아무것도 아닙니다.」
				ELSE
					PRINTFORMW 「나를 이기다니, 역시 대단하네요」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
