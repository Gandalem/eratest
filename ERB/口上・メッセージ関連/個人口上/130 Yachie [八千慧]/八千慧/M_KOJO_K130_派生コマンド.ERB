@M_KOJO_MESSAGE_SCOM_K130_1
CALL M_KOJO_MESSAGE_SCOM_K130_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K130_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「음... 내 것도 핥아봐 %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「음~~~ %UNICODE(0x2665) *1%」
				PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하고 혀를 사용해 능숙하게 그것을 부추기고 있다.
				PRINTFORMW 「자, 어서 정액을 마시게 해라 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음……%UNICODE(0x2665) *1%……빨리 싸줘%UNICODE(0x2665) *1%」
				PRINTFORMW 야치에가 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 이용해 능숙하게 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「음응%UNICODE(0x2665) *1%」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW 「냄새도 나고 진해서 맛이 좋아요...%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~ 벌써 나올 것 같으세요? 정말 하찮은 자지네요」
				PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 이용해 능숙하게 그것을 재촉하고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 응!」
				PRINTFORMW 야치에가 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하자 능숙하게 그것을 자극하고 있다.
			ELSE
				PRINTFORMW 「음... 으윽...」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 촉진하고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응……%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
				PRINTFORMW 「……어서 마시게 해……%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 「냄새가 참을 수 없는 맛이네요 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응~%UNICODE(0x2665) *1%핥아앗%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「ん～」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하고 혀 사용으로 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW (이렇게 수컷의 성기를 핥고 있으면 자신이 암컷이라는 걸 느끼는……)
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음...쪽」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 촉진한다.
			ELSE
				PRINTFORMW 「응응...」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자, 혀 사용으로 능숙하게 그것을 부추겼다.
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 잠깐 거기 움직이지 말아 주세요... 물 수 없어요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「......익숙하지 않아요?」
		ELSE
			PRINTFORMW 「......음... 역겹다...」
			PRINTFORMW 야치에는 어딘가 서툴게 성기를 입에 넣었다.
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K130_{SELECTCOM}_1
RETURN 1
