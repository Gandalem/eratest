@M_KOJO_MESSAGE_COM_K130_81
CALL M_KOJO_MESSAGE_COM_K130_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K130_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음…… 빨면 되는 거죠?」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응응... 쪽 %UNICODE(0x2665) *1%」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 재촉한다.
				PRINTFORMW (아앗 커지고 있어... %UNICODE(0x2665) *1%)
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응응……%UNICODE(0x2665) *1%츄읍%UNICODE(0x2665) *1%핥아앗, 응읏……%UNICODE(0x2665) *1%」
				PRINTFORMW 야치에는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자, 능숙한 혀놀림으로 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「음! %UNICODE(0x2665) *1%」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 재촉한다.
				PRINTFORMW 「이봐, 냄새나는 정액 빨리 먹게 해주세요 %UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~」
				PRINTFORMW 야치에가 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 재촉한다.
				PRINTFORMW 「지독한 냄새네요... 참을 수 없어요.」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 빨리 싸라」
				PRINTFORMW 야치에가 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「음... 참는 자의 체취가 나네요」
				PRINTFORMW 야치에(八千慧)는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하고 혀를 사용해 능숙하게 그것을 부추긴다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응……%UNICODE(0x2665) *1%……쪽……%UNICODE(0x2665) *1%」
				PRINTFORMW (버릇이 될 것 같은 맛이네요%UNICODE(0x2665) *1%)
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음~~~%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 「...빨리 정액을 내보내라%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응%UNICODE(0x2665) *1%넣어엇%UNICODE(0x2665) *1%」
				PRINTFORMW (쉰 좆밥 냄새…… 좋아하네요%UNICODE(0x2665) *1%)
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~」
				PRINTFORMW 「익숙하지 않은 맛이네요... 나쁘진 않지만」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 평소에 안 씻으니까 이렇게 냄새가 나잖아요.」
			ELSE
				PRINTFORMW 「응응」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 응...」
			PRINTFORMW 「...평소에 씻지 않아서 냄새가 나잖아요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……흐읍……먼저……」
		ELSE
			PRINTFORMW 「……음음……쪽」
			PRINTFORMW 야치에(八千慧)는 어딘가 서툴게 음경을 입에 넣었다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
