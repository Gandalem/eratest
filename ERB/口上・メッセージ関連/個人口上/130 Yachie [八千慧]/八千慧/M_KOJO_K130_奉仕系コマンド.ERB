;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K130_80
CALL M_KOJO_MESSAGE_COM_K130_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K130_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「이렇게 더러운 것을 나에게 쥐게 하다니……」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「벌써 나올 건가요? 한심하네요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후훗, 단정한 얼굴로 내버리면 되지 않나요 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응, 벌써 나올 것인가요?」
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:3 == 0
			PRINTFORMW 「손질 정도는 아무것도 아니에요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%빨리 싸라 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「손 쪽이 좋다고 하는 건 불가능한 건가요%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「정말 이런 짓을 시키다니……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「더러운 말이지... 이것으로도 쓸 만한 건가요?」
		ELSE
			PRINTFORMW 「응~ 빨리 꺼주지 않겠어?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
