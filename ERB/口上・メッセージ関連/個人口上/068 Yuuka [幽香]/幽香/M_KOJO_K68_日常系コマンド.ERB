@M_KOJO_MESSAGE_COM_K68_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:68:泥酔
		;when drunk
		PRINTFORMW 「...푸우...」
	ELSEIF MARK:68:反発刻印 >= 3
		PRINTFORML 「...」
