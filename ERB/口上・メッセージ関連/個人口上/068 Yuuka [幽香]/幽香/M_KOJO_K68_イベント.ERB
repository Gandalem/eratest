					CALL HEARTCB_K68(0xD02830)
					PRINTFORMW ）
				ELSE
					PRINTFORM (\@ TALENT:68:恋人 || TALENT:68:恋慕 ? 아아~ 하고 # 얼마나 답답했는지, 그리고 \@ 기분이 너무 좋았는데...)
					CALL HEARTCB_K68(0xD02830)
					PRINTFORMW ）
				ENDIF
				RETURN 1
			ENDIF
