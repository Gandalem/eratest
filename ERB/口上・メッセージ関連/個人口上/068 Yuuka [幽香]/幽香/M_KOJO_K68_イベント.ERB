	;-------------------------------------------------
	;恋慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「봐 자기야 %PLNOUN("this",CFLAG:68:LatestChildCount)% %PLVERB("is",CFLAG:68:LatestChildCount)% 우리의 %PLNOUN("child",CFLAG:68:LatestChildCount)%.」
		PRINTFORML 「지금까지 나는 꽃들을 내 아이들처럼 키워왔다.」
		PRINTFORMW 「...하지만 당신이 사랑하는 사람으로부터 온 「1」은 %PLNOUN("child",CFLAG:68:LatestChildCount)% 당신이 사랑하는 사람으로부터 온 %PLNOUN("it's",CFLAG:68:LatestChildCount)% 정말로 특별하다.」
		SIF EXP:68:出産経験 > 0
			PRINTFORMW 「...또 다시, 이것이 내가 믿는 것이다.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;まず表示されないだろう
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「봐, 자기야, 우리 %PLNOUN("this",CFLAG:68:LatestChildCount)% %PLVERB("is",CFLAG:68:LatestChildCount)%의 %PLNOUN("child",CFLAG:68:LatestChildCount)%를.」
		PRINTFORMW 「사실 나는 우리가 결혼한%COND_STR(@" human", !(TALENT:MASTER:狐 || TALENT:MASTER:妖狐 || TALENT:MASTER:吸血鬼 ||TALENT:MASTER:動物耳))% 부부로서 관계를 맺어야 한다고 생각해... 이리 내 말 듣고 있니?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;まず表示されないだろう
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「...%PLNOUN("It",CFLAG:68:LatestChildCount)% %PLVERB("was",CFLAG:68:LatestChildCount)% 건강하게 태어났다.」
		PRINTFORMW 「나는 ... %PLNOUN("this",CFLAG:68:LatestChildCount)% %PLNOUN("child",CFLAG:68:LatestChildCount)%을 행복하게 해줄 수 있을지 궁금하다...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「...%PLNOUN("It",CFLAG:68:LatestChildCount)% %PLVERB("was",CFLAG:68:LatestChildCount)% 건강하게 태어났다 %COND_STR(" a",CFLAG:68:LatestChildCount < 2)% %PLNOUN("body",CFLAG:68:LatestChildCount)%.」
		PRINTFORMW 「언제든 %PLNOUN("this",CFLAG:68:LatestChildCount)% %PLNOUN("child",CFLAG:68:LatestChildCount)%의 %PLNOUN("face",CFLAG:68:LatestChildCount)%를 보면... 하아, 너를 행복하게 해줘야겠구나...」
		RETURN 1
	ENDIF
	;その他
ENDIF
RETURN 1
