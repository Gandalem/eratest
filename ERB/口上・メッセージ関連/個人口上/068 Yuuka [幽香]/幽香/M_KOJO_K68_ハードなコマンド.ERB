;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K68_150
CALL M_KOJO_MESSAGE_COM_K68_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTL 
		PRINTFORMDL 당신은 유우카의 풍만한 가슴을 마치 그것을 위해 만들어진 것처럼 %TINKO(MASTER)% 꼭 감싼다.
		PRINTFORMDW 당신은 골반을 앞뒤로 움직이며 그녀의 %OPPAI_DESCRIPTION_TR(TARGET)%를 즐긴다.
		PRINTFORMDL 당신이 움직일 때마다 나는 음탕하고 축축한 소리가 당신을 자극하여 절정에 더 가까이 몰아붙인다.
		PRINTFORMDL 폭력적이고 비사회적인 요괴는 그녀의 %OPPAI_DESCRIPTION_TR(TARGET)%를 당신의 성적 욕망을 위한 배출구 이상의 것으로 사용한다.
		PRINTFORMDW 상황이 깨닫히자, 당신은 더욱 빠르게 허리를 움직이기 시작한다.
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTL 
		PRINTFORMDL 당신은 %OPPAI_DESCRIPTION_TR(TARGET)%을 움켜쥐고, 쿠션 같은 가슴 사이에 %TINKO(MASTER)%를 끼운다.
		PRINTFORMDL 머리는 유우카의 잠든 얼굴을 똑바로 겨누며 삽입하기 시작한다.
		PRINTFORMDL %HIS_HER(TARGET)% 눈앞에서 %OPPAI_DESCRIPTION_TR(TARGET)%이 난리인데도 유우카는 계속 잠들어 있다.
		PRINTFORMDW 당신은 그들을 임신시키려는 듯, 광란적으로 골반을 움직인다.
	ELSEIF TCVAR:68:泥酔 == 1
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		SELECTCASE RAND:2
			CASE 0
				PRINTFORM 「흠, 아, 냐」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORML  하아, 그렇게 기분이 좋은가...?」
			CASEELSE
				PRINTFORM 「응」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORML 하아, 내 가슴이랑 섹스하려는 거야...?
		ENDSELECT
		PRINTFORMDW 유우카는 당신이 얼마나 %HIS_HER(TARGET)% 가슴을 즐기는지 거의 말을 잃은 듯 놀라서 바라봤고, %HE_SHE(TARGET)%가 뒤로 박칠 때마다 간헐적으로 신음했다.
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「흐으음... 정말... 부끄러운 걸 하고 있어...」
			CASEELSE
				PRINTFORML 「흐음... 어서 싸줘...!」
		ENDSELECT
		PRINTFORMDW 유우카는 당신이 %TINKO(MASTER)%을 %HIS_HER(TARGET)%와 %OPPAI_DESCRIPTION_TR(TARGET)% 사이에 밀어 넣자 시선을 돌렸고, 그 소리에 %HIM_HER(TARGET)%가 홍당무처럼 물들었다.
	ENDIF
ENDIF
RETURN 1
