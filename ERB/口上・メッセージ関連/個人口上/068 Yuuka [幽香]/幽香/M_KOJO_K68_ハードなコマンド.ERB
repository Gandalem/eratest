;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K68_140
CALL M_KOJO_MESSAGE_COM_K68_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「「%GROAN("ngh")%... %GROAN("guh")%?! 어, %GROAN("ack")%, 크윽, 쿠흐음... 으윽!」
				SIF ABL:68:マゾっ気 >= 2
					PRINTFORML (괴롭긴 하지만, 난 여전히 즐기고 있어... 어째서일까...?)
			CASEELSE
				PRINTFORML 「「%GROAN(@"guh")%?! 음... %GROAN("ack")%, 크윽...!」
				SIF ABL:68:マゾっ気 >= 2
					PRINTFORML (이것 정도는…아무것도 아니다.)
		ENDSELECT
		PRINTFORMDW 유우카가 당신을 노려보며, 고통으로 얼굴이 일그러졌다.
	ENDIF
ENDIF
RETURN 1
