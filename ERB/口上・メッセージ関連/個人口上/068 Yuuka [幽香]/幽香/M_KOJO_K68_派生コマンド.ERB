LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		IF ABL:68:胸 < 2
			PRINTFORML 「...기분이 안 좋은가? 음음, 그럼 이걸 어때...!」
			PRINTFORMDW 다소 짜증을 낸 유우카는 당신에게 %HIS_HER(TARGET)% 혀로 더욱 열정적으로 봉사를 시작한다...
		ELSE
			PRINTFORMW 「츄우... 후후, \@ NOWEX:MASTER:射精 ? 더 이상 저항할 수 있겠어 호라～ 어서 이미 해버려...! # 나는 너희 전부를 나만 가질 테니까... \@」
		ENDIF
		;それ以外
	ELSE
		IF ABL:68:胸 < 2
			PRINTFORML 「음프, 음음... 츄욱, 음응...」
			PRINTFORMDW 유우카는 %HIS_HER(TARGET)% 혀와 가슴을 동시에 움직이는 것에 그다지 익숙하지 않은 것 같다...
		ELSE
			PRINTFORML 「쳇, 이거 정말 바보 같아... 추루, 레로!」
			PRINTFORMDW 유우카의 얼굴은 그것을 즐기지 않는다고 말하지만, 네가 신음을 내뱉자 %HIS_HER(TARGET)% 표정이 미소로 변했다.
		ENDIF
	ENDIF
