;90,アナル愛撫される
;==================================================

@M_KOJO_MESSAGE_COM_K68_90
CALL M_KOJO_MESSAGE_COM_K68_90_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
	ELSE
		IF ABL:PLAYER:Ａ感覚 >= 3
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「후후후, 한심한 신음이군... 자괴감 느껴야 하지 않나%COND_STR(@" as a man", IS_MALE(MASTER))%?」
				CASEELSE
					PRINTFORMW 「여기서 상당히 민감해졌네... 이 지경에 내 손가락 하나만으로 충분할까.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「아직도 아프니? 두려워하지 마, 금방 익숙해질 거야...」
				CASEELSE
					PRINTFORMW 「아파? 후후, 네 괴로워하는 표정은 정말 볼만하구나.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
