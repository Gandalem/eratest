		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「응, 기꺼이... 결국 당신의 부끄러운 곳이니까, 맞지? 헤헤.」
			CASEELSE
				PRINTFORMW 「결국 네 필요를 돌봐야 하니까... 자, 움직이지 마.」
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「%SPLIT_G(@"이게 어떻게 된 거지: 내가 왜 이걸 하게 되는 걸까")%...」
			CASEELSE
				PRINTFORMW 「흥, 이런 걸 시키다니...!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
