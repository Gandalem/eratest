@M_KOJO_MESSAGE_COM_K68_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTL 
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORMDL 너는 \@ NOWEX:PLAYER:射精 ? 사정할 것 같은 느낌이 들자 너는 # 너는 \@이 유우카의 머리를 너에게 당겨 거칠게 키스하게 한다.
			PRINTFORMDL 너는 허리가 유우카의 허리에 세차게 부딪힐 때마다 그녀의 입 안으로 거칠게 숨을 몰아쉰다.
			PRINTFORMDW 너는 그녀의 입술과 혀를 열렬하게 빨면서 엉덩이가 부딪히는 소리를 집어삼킨다 \@ NOWEX:PLAYER:射精 ? %" "% 네가 절정에 달할 때까지... # ... \@
		ELSE
			PRINTFORMDL 유우카가 원하는 것이 무엇이든 프랑스식 키스를 해주고, 너의 키스는 결국 혀놀이에 불과하게 변한다.
			PRINTFORMDL 너는 그녀의 입안 구석구석을 맛본다. 잇몸부터 입천장까지, 서로 얽힌 혀들로 그녀의 입안을 침으로 더럽힌다.
			PRINTFORMDW 너는 그녀의 고귀하고 아름다운 얼굴을 바라보며 혀의 움직임을 가속한다...
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTL 
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORMDL 당신은 그녀의 사랑스러운 몸을 즐기며 유우카의 잠든 얼굴에 키스한다.
			PRINTFORM 「...흐음...츄욱...응...」
			CALL HEARTCB_K68(0xD02830)
			PRINTFORML 」
			PRINTFORMDW 당신은 저항하지 않는 유우카를 %COND_STR(@" passionately", TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲)% 거듭 다시 키스한다.
		ELSE
			PRINTFORMDL 잠들어 있는 유우카의 매혹적인 입술을 핥으며, 당신은 그 위를 혀로 쓸고 지나간다.
			PRINTFORMW 「...흐음...츄...응」
			PRINTFORMDW 현재 상태에서 유우카는 평범한 소녀와 다르지 않다. 당신은 그녀에게 반복적으로 키스하며, 그 과정에서 큰 소리를 냈다...
		ENDIF
	ELSEIF TCVAR:68:泥酔 == 1
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORMDL 당신은 두 사람이 섹스를 하는 동안 유우카의 입술에 키스하고, 그녀는 응답으로 당신의 몸을 껴안는다.
			PRINTFORM 「하아, 으응」
			CALL HEARTCB_K68(0xD02830)
			PRINTFORM  기분 좋았다...
			CALL HEARTCB_K68(0xD02830)
			PRINTFORML 」
			PRINTFORMDW 유우카는 응석받이 아이처럼 더 많은 쾌락을 요구했고, 두 사람은 다시 한번 깊게 키스를 나눈다.
		ELSE
			PRINTFORMDL 취기가 오른 유우카의 입술에 네가 입술을 맞대자, 그녀는 붉어진 얼굴로 기꺼이 너의 혀에 복종한다.
			PRINTFORM 「츄, 쭈욱...」
			CALL HEARTCB_K68(0xD02830)
			PRINTFORM  에로, 레로...후와아
			CALL HEARTCB_K68(0xD02830)
			PRINTFORMW 」
			PRINTFORML 「정말 형편없는 키스들이군... 내가 키스라고 말했을 때, 나는 이런 종류의 것을 의미했어.」
			PRINTFORMDW 거의 의식이 없는 유우카가 당신이 누구인지 신경 쓰지 않고 깊게 키스한다...
		ENDIF
		;初キス
	ELSEIF EXP:68:キス経験 == 1
		PRINTFORMW 「...응? 하아, 당신은 의외로 적극적이군요...」
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			;射精した
			IF NOWEX:PLAYER:11
				PRINTFORM 「아아, 하아」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORM  점점 커지고 있어... 음무! 츄, 에로...
				CALL HEARTCB_K68(0xD02830)
				PRINTFORML 」
				PRINTFORM 열어봐, 입을 벌려줘
				CALL HEARTCB_K68(0xD02830)
				PRINTFORM  우리 입술이 연결되길 원해...
				CALL HEARTCB_K68(0xD02830,2)
				PRINTFORMW ）
			ELSE
				PRINTFORM 「응, 음우우」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW  읍하아, 좋아…… 너무 좋아, 당신」
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORM 「음... 아...으응」
					CALL HEARTCB_K68(0xD02830)
					PRINTFORM  흐으음, 하아, 아으...
					CALL HEARTCB_K68(0xD02830)
					PRINTFORML 」
				CASEELSE
					PRINTFORM 「레로, 츄...」
					CALL HEARTCB_K68(0xD02830)
					PRINTFORM  하아, 더, 더...
					CALL HEARTCB_K68(0xD02830)
					PRINTFORML 」
			ENDSELECT
			PRINTFORMDW 유우카는 격렬한 구강 성애에 완전히 매료되었다.
		ENDIF
		;それ以外
	ELSE
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			;射精した
			IF NOWEX:PLAYER:11
				PRINTFORM 「하아, 곧 갈 거야? 밖에서 해봐... 음무우」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORM ?!! 에하아, 음
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW ?!」
			ELSE
				PRINTFORM 「야아안, 하아, 후우! 하아, 너무 거칠어... 응?! 안~~」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORML 」
				PRINTFORMDW 유우카의 조용한 신음을 입맞춤으로 막고, 그녀가 내 입안에서 신음할 때 훨씬 더 크게 들린다는 것을 느낀다.
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「흐으음... 아아, 으음...~?! ...하아, 이렇게 키스당할 거라고 동의한 적 없는데...!」
				CASEELSE
					PRINTFORML 「응...? 하아, 안 돼...! ...하아, 변태...!」
			ENDSELECT
			PRINTFORMDW 유우카는 당신이 그녀의 입술 구석구석을 맛보자 놀란 표정을 지었다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
