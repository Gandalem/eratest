@M_KOJO_MESSAGE_COM_K68_101_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;まだ実装されていません。残念
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「하아, 아흐! 이것으로 뭘 하려는 거야...?」
			CASEELSE
				PRINTFORML 「크윽, 나한테 고통으로 항복을 강요하려는 거냐...? 그렇다면 큰 오산이다.」
				SIF ABL:68:マゾっ気 >= 2
					PRINTFORML (…대신 기분이 좋아지는 것 같지만, 당연히 그렇게 말할 수는 없어…)
		ENDSELECT
		PRINTFORMDL 당신은 유우카를 최대한 세게 채찍질하지만, %HIS_HER(TARGET)% 강철 같은 의지는 조금도 휘어지지 않아 소용이 없다.
		PRINTFORMDW 사실, %HIS_HER(TARGET)% 몸에 상처조차 입힐 수 없는 것 같다...
	ENDIF
ENDIF
RETURN 1
