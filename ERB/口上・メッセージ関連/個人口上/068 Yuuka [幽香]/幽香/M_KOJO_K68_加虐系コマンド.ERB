;==================================================
;108,乳スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K68_108
CALL M_KOJO_MESSAGE_COM_K68_108_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_108_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTL 
		PRINTFORMDL 평소에 그렇게 잘난 척하는 유우카에게 분노를 표출하며, 당신은 아무것도 참지 않고 %SPLIT_G("smack:slap")% %HIS_HER(TARGET)% %OPPAI_DESCRIPTION_TR(TARGET)%한다.
		PRINTFORMDW 정말 역겨울 정도로 노출된 가슴들이다. 그것들은 다른 이들을 유혹하고 끌어들이며, %HIM_HER(TARGET)%가 %HIS_HER(TARGET)%의 모든 힘을 폭발시키기에 딱 적당한 거리에 있다. 얼마나 잔인한지.
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2	;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;それ以外
	ELSE
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML 「에엑, 뭐 하는 거야?! 후으, 아아... 크윽!」
			PRINTFORMDW 유우카에게는 별로 효과가 없었지만, 정복감만으로도 이미 골반을 훨씬 더 빠르게 움직이게 된다.
		ELSE
			PRINTFORML 「으윽... 이 변태 같으니...」
			SIF ABL:68:マゾっ気 >= 2
				PRINTFORML (하아, 이 타오르는 고통의 느낌... 정말 기분 좋아~)
			PRINTFORMDW 유우카에게는 그다지 효과가 없었지만, 그렇게 강력한 요괴의 피부를 살짝 붉게 만드는 것만으로도 충분히 만족스럽다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
