					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「흐으...!! 야 그만둬, 화나게 하잖아...!」
						CASEELSE
							PRINTFORMW 「하아, 네가 그렇게 친근하게 굴어도 된다고 말한 적은 없는데... 변태 같으니...」
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「...다른 여자들에게도 이렇게 해?」
						CASEELSE
							PRINTFORMW 「...이번 한 번은 용서해 주지... 흐읍, 잠깐! 네 손을 쓰는 방식이 너무...」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
