;40,ローター
;==================================================

@M_KOJO_MESSAGE_COM_K68_40
CALL M_KOJO_MESSAGE_COM_K68_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		SELECTCASE RAND:2
			CASE 0
				PRINTFORM 「흐음... 후아아」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW  나한테는 당신보다 훨씬 기분이 나을지도 몰라... 어쩌면.」
			CASEELSE
				PRINTFORM 「흐으음... 후우, 음ㅁ프」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW  하아, 결국 목소리를 죽일 수가 없네...」
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「으음... 흠! 아아, 이 보잘것없는 장난감으로 하는군...」
			CASEELSE
				PRINTFORMW 「크윽... 음음! 이제 충분하지 않으신가...? 얼마나 더... 하아!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
