;==================================================
;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K68_44
CALL M_KOJO_MESSAGE_COM_K68_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		IF TEQUIP:バイブ
			PRINTL 
			PRINTFORMDL 바이브를 유우카의 %SLIT(TARGET)%에 맞춘 후, 완전히 밀어 넣는다.
			PRINTFORMDW %HIS_HER(TARGET, 1)%민감한 질이 그것을 쉽게 받아들여서, 보는 것만으로도 꽤 재미있었다.
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		;解除時
		IF !TEQUIP:バイブ
			PRINTFORM 「우으음... 하아」
			CALL HEARTCB_K68(0xD02830)
			PRINTFORMW  당신이 나에게 다음에 할 차례야, 안 그래...?」
		ELSE
			PRINTFORM 후후... 내가 이걸로 너를 배신해도 괜찮아...? 헤헤
			CALL HEARTCB_K68(0xD02830)
			PRINTFORML 」
			PRINTFORM 아아... 온다, 너무 좋다... 후으-
			CALL HEARTCB_K68(0xD02830)
			PRINTFORMW 」
		ENDIF
		;それ以外
	ELSE
		;解除時
		IF !TEQUIP:バイブ
			PRINTFORM 「...흐응, 으윽! ...하아, 하아, 하아... 으음」
			CALL HEARTCB_K68(0xD02830)
			PRINTFORMW 」
		ELSE
			PRINTFORM 「응, 아아... 으음」
			CALL HEARTCB_K68(0xD02830)
			PRINTFORMW 아아, 이건, 부서지고 있어...!
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;45,アナルバイブ
;==================================================

@M_KOJO_MESSAGE_COM_K68_45
CALL M_KOJO_MESSAGE_COM_K68_45_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K68_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		IF TEQUIP:アナルバイブ
			PRINTL 
			PRINTFORMDL 진동기를 유우카의 항문에 맞추고 당신은 \@ EXP:68:Ａ経験 > 20 ? 그것을 끝까지 삽입한다. # 그것을 밀어 넣어라 \@ 안에 넣고 거기에 고정해라.
			PRINTFORMDW \@ EXP:68:Ａ経験 > 20 ? 잘 발달해서 자연스럽게 받아들이고 유우카가 ~에서 쾌감을 느끼게 만들면서 %HIS_HER(TARGET)% 금지된 구멍 # 유카는 단호한 표정으로 완전히 가만히 서서 %HIS_HER(TARGET)% 얼굴에 단호한 표정으로 완전히 멈춰 서서 깨닫지 못하는 %HIS_HER(TARGET)% 항문이 훈련되고 있다 \@.
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:68:泥酔 == 1
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:68:恋人 || TALENT:68:恋慕 || TALENT:68:愛欲
		;解除時
		IF !TEQUIP:アナルバイブ
			IF EXP:68:Ａ経験 > 20
				PRINTFORM 「아아...」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW  이거 너무 창피한데, 정말 기분 좋아...」
			ELSE
				PRINTFORMW 「으음... 크흡, 그리고 이게 익숙해질 거라고 확신하는 거야...?」
			ENDIF
		ELSE
			IF EXP:68:Ａ経験 > 20
				PRINTFORM 「아! 아-내 엉덩이가 아니야... 아아, 아아아아」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW 」
			ELSE
				PRINTFORMW 「아-내 거에 이걸 넣을 거야...? 저기- 잘 됐으면 좋겠어... 윽, 쿠큭...!」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		;解除時
		IF !TEQUIP:アナルバイブ
			IF EXP:68:Ａ経験 > 20
				PRINTFORM 「...아아! 안 돼, 그만해, 멈춰...」
				CALL HEARTCB_K68(0xD02830)
				PRINTFORMW 」
			ELSE
				PRINTFORML 「...으윽, 하아...! 이 빌어먹을...!」
				PRINTFORMDW 즐기지 못하는 듯, 짜증 난 유우카는 항문 바이브를 버린다.
			ENDIF
		ELSE
			IF EXP:68:Ａ経験 > 20
				PRINTFORML 「히이?! 저게 내 항문에 들어갈 거야...? 아, 아아아....!」
				PRINTFORMDW 유우카는 장난감으로 당신이 %HIS_HER(TARGET)%의 항문을 난폭하게 휘두르는 것에 부끄러움에 얼굴을 홍조로 물들였다.
			ELSE
				PRINTFORML 「오-분명 이 물건이 내 항문에 들어가면 기분이 좋을 리 없어! 저기, 너 듣고 있니---...?!」
				PRINTFORMDW 유카의 불평을 무시하며, 당신은 진동기를 %HIS_HER(TARGET)% 항문 깊숙이 천천히 밀어 넣었다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
