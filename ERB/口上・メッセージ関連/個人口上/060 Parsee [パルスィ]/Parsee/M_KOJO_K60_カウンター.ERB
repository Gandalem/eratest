@M_KOJO_MESSAGE_COUNTER_K60_1
CALL M_KOJO_MESSAGE_COUNTER_K60_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K60_1_1
SELECTCASE K60_ATTITUDE()
	;Loving
	CASE 0
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아, 내가 너무 가까웠나? 미안해.」
				PRINTFORMDL 파르시가 %PARSE("you")%에게서 멀어진다.
			CASE 1
				PRINTFORMDL 파씨가 %PARSE("your")%의 허리를 감싸 안으려고 손을 뻗는다.
				PRINTFORMDL 처음에는 천천히, 하지만 이내 %HE_SHE(TARGET)%는 더 대담해지며 그것을 %PARSE("you")% 주위로 휘감는다.
				PRINTFORMDL %PARSE("You smile")%에 있고 %HIM_HER(TARGET)%를 두드리며 %HIS_HER(TARGET)%의 손을 쓰다.
			CASE 2
				PRINTFORMDL 파시가 %PARSE("you")%에게 다가가 %PARSE("your")%의 손을 잡는다.
		ENDSELECT
		;Nice, horny
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 파씨가 당신에게 걸어와 당신의 %FSYN("ass")%에 "실수로" 손을 스쳤다.
			CASE 1
				PRINTFORML (궁금하네... %K60_MASTER()%은(는) 얼마나 단단한지 \@ BASE:TARGET:勃起 >= 1000 ? 나는 # 내 유두가 이쪽에서인지?)\@
			CASE 2
				PRINTFORML 「여기서부터... 내가 해야 할 건 조금 앞으로 숙이는 것뿐이고 우리는 코를 맞댈 거야.」
				PRINTFORMDL 파르시는 미소 짓는다.
				PRINTFORML 「그리고 불행하게도, 나의 음주 때문에 균형 감각이 아주 나빠졌어...」
				PRINTFORML 「그래서 내가 "실수로" 그걸 하게 될지도 몰라. 너무 짜증 내지 않길 바라.」
		ENDSELECT
		;Grumpy tsundere
	CASE 2
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「누군가 너를 지켜줘야 해.」
				PRINTFORML 「네가 제멋대로 두어진다면, 아마 근육이 있는 모든 것에 다시 호감을 보러 가겠지.」
			CASE 1
				CALL M_KOJO_COLOR_K60_JEALOUS
				PRINTFORML 「내가 너무 가까워? 뭐, 내가 정말 그렇게 못생겼나? 난 네가 %K60_NAME_WITH_HONORIFICS("Yuugi")%이 너에게 이렇게 가까이 오는 걸 허락하지 않을 거라고 장담해...」
				PRINTFORMDL 파세는 %HIM_HER(TARGET)% 자신에게 계속 투덜거린다.
				CALL M_KOJO_COLOR_K60
			CASE 2
				PRINTFORMDL 그녀가 생각하는 동안 %PARSE("you're")% 보지 않는 동안 파르씨가 한 걸음 더 다가가 %PARSE("you")%그리고 또 한 걸음. 그리고 또 한 걸음.
				PRINTFORMDL %PARSE("You clear")% %PARSE("your")% 목구멍과 %HE_SHE(TARGET)% 뛰어 돌아 원래 위치로 되돌아간다 %HIS_HER(TARGET)% 원래 위치에
		ENDSELECT
		;Fake nice
	CASE 3
		$FAKE_NICE_COUNTER_1
		SELECTCASE RAND:3
			CASE 0
				IF SHOW_TOP(MASTER,1) == ""
					GOTO FAKE_NICE_COUNTER_1
				ELSE
					CALL M_KOJO_COLOR_K60_JEALOUS
					PRINTFORML 「그 %SHOW_TOP(MASTER,1)% 당신에게 아주 잘 어울리네요. 저도 그런 걸 살 수 있으면 좋을 텐데...」
					CALL M_KOJO_COLOR_K60
				ENDIF
			CASE 1
				CALL M_KOJO_COLOR_K60_JEALOUS
				PRINTFORML 「오늘 정말 멋지시네요. 조금 질투가 나는데... 패션 조언 좀 해주시겠어요?」
				CALL M_KOJO_COLOR_K60
			CASE 2
				PRINTFORML 「머리에 뭔가 다르게 했니?」
		ENDSELECT
ENDSELECT
RETURN 1
;==================================================
;Gaze ("You can feel CHARACTER's glances...")
;チラ見
