@M_KOJO_MESSAGE_COUNTER_K60_2
CALL M_KOJO_MESSAGE_COUNTER_K60_2_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K60_2_1
SELECTCASE K60_ATTITUDE()
	;Loving
	CASE 0
		SELECTCASE RAND:3
			CASE 0
				IF K60_PARSEE_INSECURE()
					PRINTFORML (이 상황이 얼마나 지속될지 모르겠어. %HIM_HER(MASTER)%와 가능한 한 많은 시간을 보내야 해.)
				ELSE
					PRINTFORML (아, %K60_MASTER()% 씨... 당신이 나를 얼마나 행복하게 하는지 표현할 말을 찾고 싶어요.)
				ENDIF
			CASE 1
				PRINTFORML 「당신의 눈은 정말 아름다워요, %K60_MASTER()%님... 당신을 질투하게 하지 않고 그 눈을 바라보고 싶어요.」
			CASE 2
				PRINTFORML 「뭐라고? 내 \@ IS_MALE(MASTER) ? 잘생긴 # 예쁜 \@ %PRINT_MALE("boy", MASTER)%친구를 쳐다보는 게 안 돼?」
		ENDSELECT
		;Nice, horny
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아, 당신의 미소는 정말 아름답군요, %K60_MASTER()%.」
				CALL HPH_PRINT, @"「하지만 네가 절정에 달했을 때 짓는 얼굴만큼 아름답지는 않아 HPH」", "L"
			CASE 1
				PRINTFORML 「술에 취하는 것에서 당신이 얼마나 \@ IS_MALE(MASTER) ? 잘생겼는지 # 아름다운지 \@ 그 자체에 취하게 됐다.」
			CASE 2
				PRINTFORML (지하세계에서는 공개적인 성관계에 대한 금기는 없다.)
				CALL PRINT_DIALOGUE, @"(%COND_STR(@"If we went down there, ", GET_MAPID(CFLAG:MASTER:現在位置) == 9)%%K60_MASTER()% ~할 수 있다%COND_STR(@" lead me to the main street,", GET_TARGETNUM() > 1)% 나를 눕히고 즉시 사랑을 시작하다."
				IF ABL:露出癖 - TALENT:羞恥心 >= 3
					PRINTFORML (그 생각 자체가 나를 \@ HAS_PENIS(TARGET) ? 단단하게 만든다 # 흥분시킨다 \@...)
					SIF HAS_PENIS(TARGET) && BASE:TARGET:勃起 < 1000
						BASE:TARGET:勃起 = 1000
				ELSE
					PRINTFORML (나는 특별히 매력적이지 않고, %K60_MASTER()% 외에는 아무도 나를 벌거벗은 채 보는 것을 원하지 않아...)
					PRINTFORML (하지만 모두 앞에서 %HIM_HER(MASTER)%에게 안긴다는 생각에 이상하게 짜릿한 무언가가 있어...)
				ENDIF
				PRINTFORMDL 아, 안 돼. 파씨가 또 그 미소를 지으며 너를 쳐다보고 있어...
		ENDSELECT
		;Grumpy tsundere
	CASE 2
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「뭐야, 그 비웃는 표정은?!」
				PRINTFORMDL 파시의 귀가 분홍색으로 변했다.
				PRINTFORML 「나 너 쳐다보고 있는 거 아니거든!」
				PRINTFORMDL 그녀는 팔짱을 끼고 시선을 돌렸다.
			CASE 1
				CALL M_KOJO_COLOR_K60_JEALOUS
				IF IS_MALE(MASTER) && IS_MALE(TARGET)
					PRINTFORML (그는 나보다 훨씬 잘생겼어... 너무 질투나.)
				ELSEIF IS_FEMALE(MASTER) && IS_FEMALE(TARGET)
					PRINTFORML (그녀는 나보다 훨씬 예쁘다... 질투가 난다.)
				ELSE
					PRINTFORML (%HE_SHE(MASTER,1)%가 나보다 훨씬 매력적이야... 정말 질투나.)
				ENDIF
				CALL M_KOJO_COLOR_K60
			CASE 2
				CALL PRINT_STRL, @"(%HE_SHE(MASTER)%이 왜 아직도 나 주변에 있는 건지 이해가 가지 않는다.)"
		ENDSELECT
		;Fake nice
	CASE 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 파시가 네가 알아차린 것을 보면, %HE_SHE(TARGET)% 살짝 홍당무처럼 빨개지며 %HIS_HER(TARGET)% 시선을 돌린다.
			CASE 1
				IF TALENT:TARGET:恋慕 || MARK:TARGET:快楽刻印 == 3
					PRINTFORML 「젠장... %HIM_HER(MASTER)%을 볼 때마다 심장이 멈추질 않아...」
				ELSE
					PRINTFORML (%HIM_HER(MASTER)%을 볼 때마다 왜 심장이 두근거리는 걸까?)
				ENDIF
			CASE 2
				PRINTFORMDL 파르시가 방금 %HIS_HER(TARGET)%의 입술을 핥았나?
		ENDSELECT
ENDSELECT
RETURN 1
