@M_KOJO_MESSAGE_COUNTER_K60_4
CALL M_KOJO_MESSAGE_COUNTER_K60_4_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K60_4_1
SELECTCASE K60_ATTITUDE()
	;Loving
	CASE 0
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아, 마음에 들어? 다행이네.」
			CASE 1
				PRINTFORML 「나는 %K60_NAME_WITH_HONORIFICS("Yuugi")%이 나를 실망시키지 않을 거라는 걸 알고 있었다.」
				PRINTFORML 「%HE_SHE(64, 1)%은 이 \@ IS_MALE(TARGET) ? 향수 # 향수를 추천했다 \@」
				SIF !HETEROSEX(TARGET, 64)
					PRINTFORML 「그것은 %HIS_HER(64)%가 가장 좋아하는 것 중 하나다.」
			CASE 2
				GOTO PARSEE_FRAGRANCE_EMBRACE
		ENDSELECT
		;Nice, horny
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL %PARSE("You sniff")% 파르시에게서 풍겨오는 향기 그리고 %PARSE("your")% %FSYN("crotch")% 갑자기 욕망으로 고동친다.
				PRINTFORMDL 파시가 알아챈다 %PARSE("your")% 반응하며 미소 짓는다.
				PRINTFORML 「그 페로몬이 섞인 것 같아 \@ IS_MALE(TARGET) ? 코롱 # 퍼퓸 \@ %K60_NAME_WITH_HONORIFICS("Reisen")% 나를 위해 섞인 것이 효과가 있는 것 같다.」
			CASE 1
				PRINTFORML 「마음에 들어요? 인도 전통 향수인 참파 아타르예요.」
				PRINTFORML 「게다가 자연적인 최음제이기도 하죠...」
			CASE 2
				$PARSEE_FRAGRANCE_EMBRACE
				PRINTFORMDL 파시가 %PARSE("you sniffing")% 공기를 감지하고 %PARSE("your")% 손을 가져간다.
				PRINTFORML 「가까이서 맡으면 더 잘 느껴질 거야...」
				PRINTFORMDL %HE_SHE(TARGET,1)%은(는) %PARSE("you")%를 품으로 끌어들인다.
		ENDSELECT
		;Grumpy tsundere
	CASE 2
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「코골이 좀 그만해줄래? 역겨워.」
				PRINTFORMDL 파씨가 %PARSE("you")%을 노려본다.
			CASE 1
				PRINTFORML 「이거 당신을 위해 한 게 아니에요, 알잖아요.」
				;todo fix this so it doesn't change if you hang out with Parsee long enough for the time to go from <900 to >=900
				IF TIME >= 900
					PRINTFORML 「오늘 일찍 %K60_NAME_WITH_HONORIFICS("Yuugi")%과 술을 마시러 나갔다.」
				ELSE
					PRINTFORML 「오늘 %K60_NAME_WITH_HONORIFICS("Yuugi")%이랑 술 마시러 나갈 거야.」
				ENDIF
				PRINTFORMDL 진심이야 누가 입고 나가 \@ IS_MALE(TARGET) ? 향수 # 향수 \@ 친구들과 술 마시러 나갈 때
			CASE 2
				PRINTFORML 「네가 개 같은 예의를 갖추고 있다는 건 알지만, 그게 나한테 개처럼 코를 킁킁거려야 한다는 뜻은 아니야.」
		ENDSELECT
		;Fake nice
	CASE 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「좋은 향기지 않나? 인도에서 온 거야.」
			CASE 1
				IF IS_MALE(MASTER)
					PRINTFORML 「가끔 향수 같은 거 뿌리는 게 좋을 거야%COND_STR(@" of your own", IS_MALE(TARGET))%%PRINT_MALE("Men", TARGET)%. 그런 종류의 것 말이야.」
				ELSE
					PRINTFORML 「가끔 향수를 뿌리는 게 좋을 거야%COND_STR(@" of your own", !IS_MALE(TARGET))%. 그런 종류의 것을 말이야%PRINT_MALE("Men", TARGET)%.」
				ENDIF
			CASE 2
				PRINTFORML 「그거 좋아해? %K60_NAME_WITH_HONORIFICS("Yuugi")% 나한테 추천해 줬어.」
		ENDSELECT
ENDSELECT
RETURN 1
