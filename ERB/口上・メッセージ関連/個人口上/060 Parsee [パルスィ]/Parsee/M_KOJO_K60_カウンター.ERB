					PRINTFORML (내가 %HIM_HER(MASTER)%를 볼 때마다, \@ CFLAG:[[パルスィ]]:K60ENC_SETTING_YUUPARU_CRUSH == 1 ? %K60_NAME_WITH_HONORIFICS("Yuugi")%을 볼 때와 똑같이 느껴진다 # 내 심장이 두근거리기 시작한다 \@...)
				CASE 1
