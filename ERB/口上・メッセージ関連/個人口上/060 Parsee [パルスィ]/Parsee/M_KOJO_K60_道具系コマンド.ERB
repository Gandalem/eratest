				ENDSELECT
				;Nice, horny
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 
					CASE 1
						PRINTFORMW 
					CASE 2
						PRINTFORMW 
				ENDSELECT
				;Grumpy tsundere
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 
					CASE 1
						PRINTFORMW 
					CASE 2
						PRINTFORMW 
				ENDSELECT
				;Fake nice
			CASE 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 
					CASE 1
						PRINTFORMW 
					CASE 2
						PRINTFORMW 
				ENDSELECT
