; Modular ERB: 個人口上/060 Parsee [パルスィ]/Parsee/Hypnosis_KOJO_K60.ERB
;==================================================
;催眠口上
;XX　　　　　　Chara ID
;ARG　　　　　Hypnosis Type
;ARG:1　　　Hypnosis Result
;==================================================

@M_KOJO_EVENT_K60_666(ARG, ARG:1)
;口上主はTARGET
;ARGは催眠タイプ（0催眠キャンセル、1反発抑制、2合意誤認、3発情抑制/発情促進、4常識改変）
;ARG:1は催眠結果（-3大失敗、-2大失敗、-1失敗、0キャンセル、1成功、2大成功、3大成功）
;臨時素質（TALENT:反発抑制、TALENT:合意誤認、TCVAR:Common_Sense_Alteration_Status）
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF 顔絵付きメッセージ && ARG != 0 && ARG:1 > 0
		PRINTL 
	;催眠タイプ
	SELECTCASE ARG
		;催眠キャンセル　　Hypnosis Cancel
		CASE 0
			;催眠結果　　必ず0である　　そして記入を推奨しない
			PRINTFORMDL %CALLNAME:[[パルスィ]]% 눈을 깜빡이고 %HIS_HER(TARGET)%의 머리를 흔든다.
			SELECTCASE K60_ATTITUDE()
				CASE 0, 3
					PRINTFORMW 「왜 이렇게 이상한 기분이 들까...?」
				CASE 1
					PRINTFORMW 「무슨 일이야 내가 얼마나 \@ IS_MALE(MASTER) ? 잘생긴 # 아름다운 \@ 당신이 얼마나 대단한지 눈이 멀었나?」
				CASE 2
					PRINTFORML 「무슨 이유에서인지 갑자기 좀 속이 메스꺼워. 그리고 그건 네 잘못이라고 확신해.」
					PRINTFORMDW %CALLNAME:[[パルスィ]]%는 당신을 노려본다.
			ENDSELECT
			;反発抑制　　Resistance Weakened
		CASE 1
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE K60_ATTITUDE()
						CASE 0, 3
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「네가 뭘 하고 있다고 생각하는지는 모르겠지만, 나를 덜 짜증나게 만들진 않아.」
								CASE 1
									PRINTFORMW 「...그게 뭐였든, 사과해 보는 건 어때?」
								CASE 2
									PRINTFORMW 「머리 아프게 하네. 그만해줘.」
							ENDSELECT
						CASE 1
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「날 유혹하려는 거라면, 그건 통하지 않을 거야.」
								CASE 1
									PRINTFORMW 「손으로 뭘 하는 거야? 혹시 새로운 성적 기교 같은 거야?」
								CASE 2
									PRINTFORMW 「손을 휘젓는 대신, 다른 걸 해보면 어떨까?」
									PRINTFORMDW %CALLNAME:[[パルスィ]]%는 %HIS_HER(TARGET)%의 셔츠를 아래로 잡아 작은 가슴골을 드러내며 윙크한다.
							ENDSELECT
						CASE 2
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「다른 곳에서나 그렇게 해라.」
									PRINTFORMW 「나에게서 아주, 아주 멀리 떨어진 곳에서 말이다.」
								CASE 1
									PRINTFORMW 「왜 평범한 사람처럼 행동하지 못하는 거야?」
								CASE 2
									PRINTFORMW 「네가 뭘 하는지는 모르겠지만, 그만두지 않으면 바비즈를 네게 풀어버릴 거야.」
							ENDSELECT
					ENDSELECT
					;成功　　Success
				CASE 1
					SELECTCASE K60_ATTITUDE()
						CASE 0, 3
							PRINTFORMW (나는 %HIM_HER(MASTER)%에게 화를 내야 하는 것 같은데... 그래야 하지 않을까?)
							PRINTFORMDW %CALLNAME:[[パルスィ]]%가 미간을 찌푸린다.
							PRINTFORML (나는 %HIM_HER(MASTER)%에게 화가 났던 기억은 나지만, 왜 그랬는지는 기억나지 않아...)
							PRINTFORMW (어쩌면 별로 중요하지 않은 일일지도 모르겠다.)
						CASE 1
							PRINTFORMW 음? 나는 화가 나 있었는데 %K60_MASTER()%근데 지금은 아니야 그리고 왜 화났었는지 기억나지 않아)
							PRINTFORMW (아, 상관없다. 어차피 그렇게 \@ IS_MALE(MASTER) ? 잘생긴 # 아름다운 \@ 같은 사람에게 오랫동안 화를 내고 있을 수는 없으니까.)
						CASE 2
							PRINTFORMDW %CALLNAME:[[パルスィ]]%가 멍하게 당신을 응시한다.
							PRINTFORMW 「당신... 무언가 내가 화를 내야 한다고 말하지만, 그렇지 않아.」
							PRINTFORMDW %HE_SHE(TARGET,1)%이 %HIS_HER(TARGET)%의 이마를 문지른다.
							PRINTFORMW 「그리고 왜 그런 건지 기억하려고 애쓰니 두통이 오네.」
							PRINTFORMW 「뭐라고 말하려 했는데-」
							PRINTFORMDW %HE_SHE(TARGET,1)%이 %HIS_HER(TARGET)%의 고개를 젓는다.
							PRINTFORMW 「됐어. 상관없어.」
					ENDSELECT
					;Great Success
				CASE 2, 3
					SELECTCASE K60_ATTITUDE()
						CASE 0, 3
							PRINTFORMW 「음? 내가... 너한테 화냈던 건가?」
							PRINTFORMDW %CALLNAME:[[パルスィ]]%의 얼굴이 붉어진다.
							PRINTFORMW 「용서해줘, %K60_MASTER()%. 왜 아무 일도 없는데 화를 냈는지 모르겠어.」
						CASE 1
							PRINTFORML 「내가 무슨 생각을 한 거지? 아무것도 아닌 일로 화내는 것은 친구를 대하는 방법이 아니야.」
							PRINTFORMW 「나... 당신에게 사과하면 어떨까? 개인적으로 말이야?」
							PRINTFORMDW %CALLNAME:[[パルスィ]]%는 눈을 찡긋한다.
						CASE 2
							PRINTFORML 「별것도 아닌 일로 너한테 화냈어. 정말 아무것도 아니라고. 그런데도 아직 나 주변에 있는 거야?!」
							PRINTFORMW 「넌 바보야, 뭐라도 된 거야?!」
							PRINTFORMDW ...최면이 실제로 효과가 있었나?
					ENDSELECT
			ENDSELECT
			;合意誤認　　Make Sex Acceptable
		CASE 2
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE K60_ATTITUDE()
						CASE 0
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「우리가 연인이라는 건 알지만, 결혼할 때까지 정말 기다려야 해.」
								CASE 1
									PRINTFORMW 「제발 그게 뭐였든 나랑 잠자게 만들려고 했던 거 멈춰줘. 그냥 창피해.」
								CASE 2
									PRINTFORMW 「너랑 잠자지는 않을 거고, 이상한 손짓을 하는 것도 그걸 바꾸지 못할 거야.」
							ENDSELECT
						CASE 1
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 
								CASE 1
									PRINTFORML 
								CASE 2
									PRINTFORML 
							ENDSELECT
						CASE 2
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「으윽, 너 역겹다! 가서 찬물에 몸이라도 담가라.」
								CASE 1
									PRINTFORMDL %CALLNAME:[[パルスィ]]%은(는) 눈을 굴리며 당신에게 %HIS_HER(TARGET)% 손가락을 까딱이기 시작한다.
									PRINTFORMW 「나를 혼자 두겠다고... 나를 최면 걸려고 하는 것을 그만두겠다고...」
									PRINTFORMW 「너는 이젠 유녀조의 모든 사람들과 잠자리를 갖는 시도를 그만둘 거다...」
								CASE 2
									PRINTFORMW 「너는 타락했구나. 내 손가락을 부러뜨리기 전에 그만둬.」
							ENDSELECT
						CASE 3
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「그것은 극도로 부적절하다. 다시 묻지 마라.」
								CASE 1
									PRINTFORMW 「아니, 그리고 그만둬... 네가 뭘 하고 있든 상관없이 말이야.」
								CASE 2
									PRINTFORMW 「나를 최면 걸려고 하는 거야?」
									PRINTFORMDW %CALLNAME:[[パルスィ]]% 코웃음 친다.
									PRINTFORMW 「정말? 그건 음란 만화에서만 통하는 거잖아, 안 그래?」
							ENDSELECT
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMDW %CALLNAME:[[パルスィ]]%은(는) %HIS_HER(TARGET)%의 입술을 물고 %HIS_HER(TARGET)%의 허벅지를 비빈다.
					PRINTFORMW (뭐지? 그냥 %HIM_HER(MASTER)%를 쳐다보는 것만으로도 점점 더 흥분돼...)
					SELECTCASE K60_ATTITUDE()
						CASE 0
							PRINTFORMW (결국 우리가 결혼한다면 괜찮을 거야.)
							PRINTFORMW (응. 물론 괜찮을 거야. 왜 안 되겠어?)
						CASE 1
						CASE 2
							PRINTFORMW (젠장, 왜 이러지? %HIM_HER(MASTER)%에 대한 내 감정을 더 싸우려고 할수록, 그 감정은 더 강해져!)
							PRINTFORMW (%HIM_HER(MASTER)%가 나와 함께 잠들게 하면 사라질지도 몰라. 그게 논리적인 선택이니까.)
						CASE 3
							PRINTFORMW (이번 한 번만 봐줄지도.)
							PRINTFORMW (게다가, 다리 지킴이로서 여행자에게 해를 입히거나 그들이 해를 입는 것을 허용해서는 안 될 의무가 있으니까.)
							PRINTFORMW (그리고 내가 일에 집중할 수 없을 만큼 흥분해선 그런 걸 할 수가 없잖아, 그렇지?)
					ENDSELECT
					PRINTFORMDW %CALLNAME:[[パルスィ]]%는 갈등하는 듯했다.... 하지만 그때 %HE_SHE(TARGET)%가 당신에게 돌아와 긴장된 미소를 지었다.
					PRINTFORMDW 효과가 있었던 모양이다...
					;Great Success
				CASE 2, 3
					SELECTCASE K60_ATTITUDE()
						CASE 0
							PRINTFORMW (내가 뭐 하는 거지? 우리는 연인이야. 거의 결혼한 거나 다름없어.)
							PRINTFORMW (게다가, 내가 그러지 않으면 %HE_SHE(MASTER)%는 더 속이 얕은 누군가에게 나를 버릴 거야...)
						CASE 1
						CASE 2
							PRINTFORMW (내가 성적으로 너무 못해서 %HIM_HER(MASTER)%을 멀어지게 할지도 몰라.)
						CASE 3
							PRINTFORMW (%HIM_HER(TARGET)%와 잠자면 안 된다는 걸 알지만... 어쩐지 정말 하고 싶다.)
							SIF !(K60_HAS_FUCKED_PARSEE())
								PRINTFORMW (그리고 \@ CFLAG:K60EN_PARSEE_STARTING_VIRGINITY ? 드디어 처녀성을 잃을 것이다 # 거의 천 년 동안 섹스를 하지 않았다 \@. 아마 이번 한 번만...)
					ENDSELECT
			ENDSELECT
			;発情抑制/発情促進　　Estrus Control
		CASE 3
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE K60_ATTITUDE()
						CASE 0
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「연모하고 싶다면 그냥 물어보면 돼. 뭘 하고 있는 거야?」
								CASE 1
									PRINTFORMDL %CALLNAME:[[パルスィ]]%는 웃는다.
									PRINTFORMW 「오, %K60_MASTER()%... 당신을 보는 것만으로도 나를 흥분하게 해. 그럴 필요 없어.」
								CASE 2
									PRINTFORMW 「네가 뭘 하는지는 모르겠지만, 머리가 아파오기 시작했어.」
									PRINTFORMW 「나를 기분 나게 하고 싶다면...」
									PRINTFORMDW %CALLNAME:[[パルスィ]]%는 검지 손가락을 맞대고 홍조를 띤다.
									PRINTFORMW 「내 귀를 살짝 깨물어보는 건 어때...」
							ENDSELECT
						CASE 1
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMDL %CALLNAME:[[パルスィ]]%이(가) 눈을 굴린다.
									PRINTFORMW 「그냥 미약 같은 거나 줘.」
								CASE 1
									PRINTFORMW 「나를 발정 상태로 만들고 싶다면 귀를 마사지해 봐.」
								CASE 2
									PRINTFORML 「정말로 %K60_MASTER()%이(가)? 나 벌써 욕망하지 않나?」
									PRINTFORMW 「나에게 저런 마법의 자궁 문신도 하게 만들려고 하는 거야?」
							ENDSELECT
						CASE 2
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「나는 동물이 아니야, %CALLNAME:MASTER%. 나는 발정하지 않아.」
									PRINTFORMW 「그건 기본적인 생물학이야. 어떻게 이렇게 무지할 수가 있지?」
									CALL PRINT_STRL, @"「질이 어디에 있는지 네가 정말 알고 있니?」"
									CALL PRINT_STRW, @"「아니면 그냥 시도해 보는 거야 \@ HAS_PENIS(TARGET) ? 너의 것을 모든 구멍에 밀어 넣어라 # 가여운 여자에게 온몸을 핥아대다 \@ 찾을 때까지?」"
								CASE 1
									PRINTFORMW 「발정기에 들어갔다고? 내가 \@ HAS_PENIS(TARGET) ? 중성화시키거나 # 대신 \@ 너를 거세해 줄까?」
								CASE 2
									PRINTFORMW 「하아... 몸을 가득 채우는 통제할 수 없는 충동이 느껴진다...」
									PRINTFORMW 「최대한 세게 %조사처리(CALLNAME:MASTER,"의")% 사타구니를 차고 싶은 충동...」
							ENDSELECT
						CASE 3
							SELECTCASE RAND:3
								CASE 0
									PRINTFORMW 「나는 발정기에 들지 않고, 설령 그랬다 해도 네 손가락을 흔든다고 해서 그럴 일은 일어나지 않을 거야.」
								CASE 1
									PRINTFORML 「나를 최면 걸려고 하는 거야? 정말 잘 못하는걸.」
									PRINTFORMW 「사토리에게 조언을 구해보는 건 어때? 그녀는 굉장한 최면술가야.」
								CASE 2
									PRINTFORMW 「머리 아프게 하네. 내가 정신 차리게 때리기 전에 그만둬.」
							ENDSELECT
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMDW 파르시가 삼키자 한 방울의 땀이 %HIS_HER([[パルスィ]])%의 얼굴을 타고 흘러내린다.
					SELECTCASE K60_ATTITUDE()
						CASE 0
							PRINTFORMW (이렇게 흥분한 적은 없었던 것 같다. 너무 흥분해서 아플 지경이야.)
							PRINTFORMW (이건 정상적이지 않지? 하지만 %K60_MASTER()%는 어떻게 해야 할지 알 거야. 확신해.)
							PRINTFORMW (하지만 먼저 정신을 차릴 수 있을 때까지 %HIM_HER(MASTER)%가 나에게 사랑을 주게 해야겠어.)
							PRINTFORMDW %HE_SHE(TARGET,1)%은/는 당신의 어깨에 손을 올리고 미소 짓는다.
							PRINTFORML 「있잖아, 요즘 옛날 나라에서 온 책을 읽고 있어. 카마스와라 말이야.」
							PRINTFORMW 「그리고 그 책이 사랑하는 기술에 대해 많은 것을 가르쳐 주었지. 내가 배운 걸 보여줄까?」
						CASE 1
							PRINTFORMW (나는 언제나 %K60_MASTER()%을 보면 흥분하지만, 이렇지는 않아!)
							PRINTFORMW (뭔가 이상한 일이 벌어지고 있어... 하지만 너무 흥분해서 제대로 생각할 수가 없어.)
							PRINTFORMW (진정된 후에 걱정하겠어.)
							PRINTFORMDL %HE_SHE(TARGET,1)%은 당신의 어깨에 기대며 당신의 귓가에 속삭인다.
							CALL PRINT_STRW, @"「ITALIC 날 범해줘, %CALLNAME:MASTER%. 내 옷을 다 찢고 나를 네 것으로 만들어줘.」"
							PRINTFORMDW %HE_SHE(TARGET,1)%이 당신 앞에 서서 당신의 머리를 잡고 %HIS_HER(TARGET)%의 혀를 당신의 입속에 밀어넣었다.
							CALL MUTUAL_KISS
							PRINTFORMDW 어쩌면 조금 과했는지 모르겠네...
						CASE 2
							PRINTFORMDL %HE_SHE(TARGET,1)% 눈을 질끈 감고 입술을 깨문다.
							PRINTFORMDW 하지만 소용이 없다. 네가 강하게 %HE_SHE(TARGET)% 저지를수록 더 흥분하는 것을 확인했으니까.
							PRINTFORMW 「아, 더는 못 참겠어!」
							PRINTFORMDW %CALLNAME:[[パルスィ]]% 팔짱을 끼고, 이빨을 갈며, 너를 노려본다.
							PRINTFORML 「상관없어. 그냥 나가서 말할 거야.」
							PRINTFORMW 「네가 나랑 섹스 안 해주면 미쳐버릴 거야.」
							PRINTFORMW 「이제 %COND_STR(@" take me somewhere private and", !(GET_TARGETNUM() == 1 && (CFLAG:TARGET:現在位置 == 940 || CFLAG:TARGET:現在位置 == CFLAG:TARGET:初期位置)))% 날 밀어붙여봐.」
							CALL M_KOJO_COLOR_K60_JEALOUS
							CALL PRINT_STRL, @"「그리고 내가 너무 못생겼다고 말하지 마! 네가 아는 그런 걸레들 좀 봤거든!」"
							PRINTFORMW 「적어도 나 아직 이 다 가지고 있잖아! 그리고 오니를 질식시킬 만큼 많은 화장도 안 하고 다니고!」
							CALL M_KOJO_COLOR_K60_VERY_JEALOUS
