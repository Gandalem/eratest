; Modular ERB: 個人口上/060 Parsee [パルスィ]/Parsee/M_KOJO_K60_依頼.ERB
;==================================================
;Common Request Dialogue
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K60(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
;The character making the request
#DIMS SCENE    ;セリフの表示されるタイミング
;When the dialogue appears
#DIM  IRAI_ID  ;依頼自体のID
;The request ID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;The requestee's ID
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
;The request type ID (cut some wood, water my flowers, etc.)
#DIMS IRAI_NAME;依頼名
;The name of the request
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_UNIQUE_{CHK_ID}_K60(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K60(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;Here is the common opening statement for each request.
;If you display the common comments for each request, the common comments will not be displayed.
;The items circled by [ ] are the background sentences before and after the opening remarks and the processing that takes place.
;Please use this as a guideline for whether to WAIT or not (L and W stand for PRINTFORML and PRINTFORMW, respectively).
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		; ●When a request is made to you.
		; [w It seems that [she] has a favor to ask of [you].
		;-◆Dialogue
		; [Request Data Display].
		; [INPUT (Do you accept the request? Y/N)].
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		SELECTCASE K60_ATTITUDE()
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「혹시 방해하는 건 아닐지 모르겠지만, 이것 좀 도와주실 수 있나요?」
					CASE 1
						CALL PRINT_STRL, @"「자기야, 이거 좀 도와줄 수 있어?」"
					CASE 2
						PRINTFORML 「%K60_MASTER()%님, 잠시 시간 있으신가요? 도움이 좀 필요해서요...」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「당신 섹프 중 한 명을 도와줄 시간 좀 있나요?」
					CASE 1
						CALL PRINT_STRL, @"「네에게 충분한 에너지가 있다는 걸 알고 있어... 이것 좀 도와줄 수 있겠니?」"
					CASE 2
						PRINTFORML 「도움이 필요한 일이 있다. 물론 보상은 해 줄 것이다.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「너에게 의지해야 한다는 게 싫어...」
						PRINTFORML 「하지만 이걸 친구들에게 부탁하고 싶지도 않고, 다른 누구도 도와주지 않을 거라는 걸 알아.」
					CASE 1
						PRINTFORML 「아, 네가 가련한 소녀를 괴롭히지 않는 드문 순간에 붙잡힌 것 같군.」
						PRINTFORML 「자, 이것 좀 도와주게.」
					CASE 2
						PRINTFORML 「좀 쓸모 있게 행동해서 나에게 도움을 주는 게 어때?」
				ENDSELECT
			CASE 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「당신이 상당히 유능한 %PRINT_MALE("man", MASTER)%이라고 들었습니다... 저를 도와주시겠어요?」
					CASE 1
						PRINTFORML 「이거 좀 도와주시겠어요?」
					CASE 2
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORML 「당신은 나보다 훨씬 재능이 넘쳐요... 저에게 도움을 청할 일이 있어요.」
						CALL M_KOJO_COLOR_K60
				ENDSELECT
		ENDSELECT
	CASE "依頼非受託時"
		;●When you saw only the contents and did not accept the request.
		;- [L [you] politely declined
		;-◆Dialogue
		;W She looks disappointed.
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
		SELECTCASE K60_ATTITUDE()
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「...귀찮은 일인가요?」
					CASE 1
						PRINTFORML 「...알겠다.」
					CASE 2
						PRINTFORML 「내가 스스로 처리할 수 있을 것 같아...」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「내 몸에만 신경 쓰는 것 때문이 아니길 바라.」
					CASE 1
						PRINTFORMDL 파시가 미간을 찌푸리며 혼잣말을 중얼거린다.
					CASE 2
						PRINTFORML 「흥. 오늘 밤 나랑 같이 잠자리를 할 거라고 기대하지 마.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「놀랍지 않아.」
						PRINTFORML 「나를 도와준다는 건, 그녀의 옷을 벗기는 것과 관련 없는 여자를 상대한다는 뜻이 될 거야.」
					CASE 1
						CALL M_KOJO_COLOR_K60_VERY_JEALOUS
						CALL PRINT_STRL, @"「음, 당신에게 더 중요한 일이 있을 거라고 확신해. 아니, 어쩌면 어떤ITALIC누군가...」"
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORML 「적어도 나를 부드럽게 실망시키긴 했네. 네가 내 얼굴에 침을 뱉을 거라고 반쯤 예상했거든.」
				ENDSELECT
			CASE 3
				SELECTCASE RAND:3
					CASE 0
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORML 「특별한 누군가와 시간을 보내기 때문인가?」
						CALL M_KOJO_COLOR_K60
					CASE 1
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORML 「내가 더 매력적이라면 당신도 나를 위해 시간을 내주었을 거라 확신해...」
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORML 「오? 치정이다.」
				ENDSELECT
		ENDSELECT
	CASE "依頼受託時"
		;●When [you] accepted [her] request
		;W [you] accepted [her] request
		;- [◆Dialogue
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		SELECTCASE K60_ATTITUDE()
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「훌륭해. 네게 기댈 수 있을 거라고 알고 있었어.」
						PRINTFORMDW 파르시가 당신에게 고개 숙여 미소 짓는다.
					CASE 1
						PRINTFORMW 「잘생기고, 지적이고, 매력적이며, 성실하기까지 하다? 정말 완벽한 %PRINT_MALE("boy", MASTER)% 친구구나.」
						PRINTFORMDW 파시의 귀가 빨개지기 시작했다...
					CASE 2
						PRINTFORML 「감사합니다, %K60_MASTER()%.」
						PRINTFORMW 「부담이 되면 언제든지 말해줘, 알았지?」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「너에게 기댈 수 있다는 걸 알고 있었어.」
						PRINTFORMDW 파르시는 당신을 보고 미소 짓는다.
					CASE 1
						PRINTFORML 「멋지다!」
						PRINTFORMW 「너무 오래 걸리지 마, 알았지? 네가 없으면 외로워지니까...」
					CASE 2
						PRINTFORMW 「내 보상에 실망하지 않도록 확실히 해줄게.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「어차피 네가 전부 잊어버릴 거라 확신해.」
					CASE 1
						PRINTFORMW 「보상 때문에 이러는 거지?」
					CASE 2
						PRINTFORMW 「"고맙다고 해야 할 것 같지만... 일단 네가 임무를 끝낼 때까지 기다려 주겠다."」
				ENDSELECT
			CASE 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「감사합니다, %K60_MASTER()%.」
					CASE 1
						PRINTFORMW 「그 약속은 지키게 할 거야...」
					CASE 2
						PRINTFORMW 「끝내지 못할 것 같으면 알려줘도 돼, 알았지? 화 안 낼게.」
				ENDSELECT
		ENDSELECT
	CASE "依頼確認時"
		;●[366] When doing "Listen to Request" after accepting the request
		;◆Dialogue
		;-[Request Data Display].
		;[INPUT (Discard or Y/N)].
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		SELECTCASE K60_ATTITUDE()
			CASE 0, 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「잊었다고 말하지 마...」
					CASE 1
						PRINTFORMW 「기억을 되살려 줄까요?」
					CASE 2
						PRINTFORMW 「좋아, 다시 말해 주지...」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「내 몸에 너무 정신 팔려서 집중하지 못하진 않았으면 좋겠어.」
					CASE 1
						PRINTFORMW 「이번에는 더러운 생각에 정신 팔리지 마라.」
					CASE 2
						PRINTFORMW 「이게 애정 행각과는 관련 없다는 건 알지만, 그래도 중요해.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「이번에는 잘 들어두는 게 좋을 거야.」
					CASE 1
						PRINTFORMW 「물론이지. 내가 하는 말 중에 신경 쓸 만한 게 있을 리가 없잖아.」
					CASE 2
						PRINTFORMW 「성관계와 관련 없는 것을 생각하는 게 힘들다는 건 알지만, 이건 중요해.」
				ENDSELECT
		ENDSELECT
	CASE "依頼破棄時"
		;When you cancel a request you have been entrusted with.
		; [◆Dialogue].
		; W I have discarded the request.
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		SELECTCASE K60_ATTITUDE()
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「...알겠다.」
					CASE 1
						PRINTFORMW 「치정이다.」
					CASE 2
						PRINTFORMW 「별일 아니라고 생각하지 않았기를 바랐어...」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「대신 그 시간에 나랑 사랑을 나누는 걸 바란다.」
					CASE 1
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「다른 섹프랑 시간을 보내려고 하는 거야?」
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORMW 「너무 어려워서가 아니라, 당신이 내 몸만 신경 쓰기 때문인 건 아니었으면 좋겠어.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「적어도 나를 무시하지는 않고 하지 않겠다고 말해줬잖아.」
					CASE 1
						CALL M_KOJO_COLOR_K60_VERY_JEALOUS
						PRINTFORMW 「당신처럼 완벽한 사람에게는 어렵지 않았을 거란 걸 알고 있다. 그저 신경 쓰지 않은 거지?」
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORMW 「너 같은 애가 선행을 할 리 없었지.」
				ENDSELECT
			CASE 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「너무 어려웠나?」
					CASE 1
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「오? 그럼 더 중요한 할 일이 있는 거냐?」
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORMW 「너라면 분명 해낼 수 있을 거라고 생각했어...」
				ENDSELECT
		ENDSELECT
	CASE "成功報告時"
		;Success
		;When the request is completed and reported: Continued from the above dialogue.
		;[◆Dialogue]
		; [Obtaining a source, obtaining a reward such as an item, etc.].
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		SELECTCASE K60_ATTITUDE()
			CASE 0
				;todo expand
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「감사합니다, %K60_MASTER()%로! 고마워요.」
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
			CASE 1
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「감사합니다, %K60_MASTER()%님.」
				PRINTFORMDW 파씨가 당신을 향해 미소 짓는다.
				PRINTFORMW 「제가 작은 추가 보상을 드려야겠네요...」
				CALL MUTUAL_KISS
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						CALL M_KOJO_COLOR_K60_VERY_JEALOUS
						PRINTFORML 「물론 너 해냈어. 네가 뛰어나지 않은 게 하나도 없어.」
						PRINTFORMW 「성인들과 신사는 언제든 사임하고 네가 그들의 자리를 맡게 될 거라고 확신해.」
						CALL M_KOJO_COLOR_K60
						PRINTFORMDW 그녀는 네가 자신을 도와주지 않기를 더 선호했을까?
					CASE 1
						PRINTFORMW 「...」
						PRINTFORMW 「...감사합니다.」
					CASE 2
						PRINTFORMW 「나는 네가 「2」변태 같은 것 말고 다른 일들을 해줄 거라고 믿을 수 있는 것 같아 "변태가 되는 것".」」
				ENDSELECT
			CASE 3
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「고맙습니다, %K60_MASTER()%!」
				CALL M_KOJO_COLOR_K60_JEALOUS
				PRINTFORMW 「정말 재능이 넘치는군...」
				CALL M_KOJO_COLOR_K60
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
		ENDSELECT
	CASE "失敗報告時"
		;When a report is forgotten or expired, it is called up at the end of the encounter.
		;(During the encounter) [Greetings, etc.] → [Good or Bad Mood] → [Detection of Inferiority] → [Holiday Event] → [◆Coco! (In addition, the date invitation will not occur if the request is judged to have failed.)
		;◆Dialogue
		;(If the request is judged as a failure, a date invitation will not occur)
		; ○ Change of mood, additional penalties, etc. should be handled by the dialogue.
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してくださ
		SELECTCASE K60_ATTITUDE()
			;todo expand
			CASE 0
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「%K60_MASTER()%… 잊었어? 이게 중요하다고 말했잖아!」
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
			CASE 1
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「정말, %K60_MASTER()%은(는) 기억조차 못 했어?」
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
			CASE 2
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「나는 네게 의지해서는 안 됐다는 걸 알고 있었다.」
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
			CASE 3
				; SELECTCASE RAND:3
				; 	CASE 0
				PRINTFORMW 「더 중요한 일들이 있었던 모양이군. 치정스럽게...」
				; 	CASE 1
				; 		PRINTFORML
				; 	CASE 2
				; 		PRINTFORML
				; ENDSELECT
		ENDSELECT
		;I don't think this is used anymore
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
		PRINTFORMDW 케이스 "의뢰 보고 불필요"가 호출되었다! 이것을 보고해라!
ENDSELECT
RETURN 1
