@M_KOJO_EVENT_K60_STONEBATTLE(ARGS,ARG,ARG:1)
IF ARGS == "beginning"
	PRINTFORMDW 「지각 아래의 질투! 미즈하시 파르시!!!」
	PRINTFORMW
	SELECTCASE K60_ATTITUDE()
		CASE 0
			PRINTFORMW 「%K60_MASTER()%?! 뭐, 너라고 해도 참지 않을 거야...」
		CASE 1
			PRINTFORMW 「어이쿠, 이게 누구신가. %K60_MASTER()%님. 내 손으로 얼마나 잘하는지 다시 알려드릴 시간이야~」
		CASE 2
			PRINTFORMW 「뭐야?! %STONE_UKETSUKENAME%-씨, 포기하기엔 너무 늦었어? 내가 %K60_MASTER()%을 상대로 이길 방법은 없어...」
		CASE 3
			PRINTFORMW 「아, %K60_MASTER()%님. 다리 정비 작업 덕분에 손재주가 상당히 좋아졌어요...」
	ENDSELECT
ELSEIF ARGS == "win"
	SELECTCASE K60_ATTITUDE()
		CASE 0
			PRINTFORMW 「음, 당신을 이길 거라고는 예상하지 못했어. 정말 잘하네. 내가 예상했던 대로야.」
			PRINTFORMW 「나랑 커플 부문 도전을 해보겠어?」
		CASE 1
			PRINTFORMW 「네 손재주가 그 정도일 줄은 놀랄 일 아니겠지...」
			PRINTFORMW 「오늘 내 기억을 되살려 줄래?」
		CASE 2
			CALL M_KOJO_COLOR_K60_JEALOUS
			PRINTFORMW 「네 돌 쌓기 기술이 너무 부러워. 파루파루...」
			CALL M_KOJO_COLOR_K60
		CASE 3
			CALL M_KOJO_COLOR_K60_JEALOUS
			PRINTFORMW 「...」
			PRINTFORMW 「나도 저렇게 돌 쌓는 거 잘했으면 좋겠다...」
			CALL M_KOJO_COLOR_K60
	ENDSELECT
ELSEIF ARGS == "lose"
	SELECTCASE K60_ATTITUDE()
		CASE 0
			PRINTFORMW 「%K60_MASTER()%에게 이길 거라고는 기대하지 않았는데... 하지만 꽤 저항해 주었어.」
			PRINTFORMW 「나랑 커플 부문으로 도전하고 싶어?」
		CASE 1
			PRINTFORMW 「오? 내가 이겼다고? 나 때문에 그냥 포기한 건 아니길 바라는데.」
		CASE 2
			PRINTFORMW 「나를 이기게 해 준 거잖아, 안 그래?」
		CASE 3
			PRINTFORMW 「이겼나 보군요. 다시 한 판 더 하시겠다면 알려주세요.」
	ENDSELECT
ENDIF
RETURN 1

@M_KOJO_EVENT_K60_FAIRY_PRANK(ARGS,ARG,ARG:1)
#DIMS SELECTED_PRANK
#DIM CULPRIT
SELECTCASE ARGS
	CASE "scenarios"
		SELECTCASE RAND:2
			CASE 0
				SELECTED_PRANK = parsee_bridge_trap
			CASE 1
				SELECTED_PRANK = parsee_house_vandalism
		ENDSELECT
		RETURN 2
	CASE "prank"
		CULPRIT = VAR_OR_DEFAULT("Add_CULPRIT")
		SELECTCASE SELECTED_PRANK
			CASE "parsee_bridge_trap"
				CALL K60_GET_BRIDGE_PASSERBY()
				;hack until I can rewrite the above function to be less shit
				LOCALS = %RESULTS:5%
				PRINTFORML 당신과 %CALLNAME:CULPRIT%은 파르시가 떠나기 30분 전 다리에 몰래 올라가 지키기로 한다.
				PRINTFORML 그곳에 도착하자, 바닥 판자 일부를 통해 대부분을 볼 수 있었다.
				PRINTFORML 일을 마친 후, 당신은 톱을 안전한 곳에 숨기고 올드 헬에서 다음 35분을 구경하며 보낸다.
				PRINTFORML 그런 다음 다리로 돌아와 파르시와 대화하며 태연한 척 행동한다.
				PRINTFORML 얼마 지나지 않아 %ARTICLE(LOCALS)%가 다리의 불안정한 부분을 밟는다.
				PRINTFORML 그것은 %RESULTS:3%의 발밑에서 무너지고, 놀라 비명을 지른 %RESULTS:1%는 강으로 떨어진다.
				PRINTFORML 파르시는 다리에서 뛰어내려 충격받은 %LOCALS%를 붙잡고 %RESULTS:2%와 함께 해변으로 수영해 돌아온다.
				PRINTFORML 그녀는 적절한 다리 보수를 하지 않은 것에 대해 %RESULTS:2%에게 연신 사과하고, 다시는 그런 일이 없을 것이라고 %RESULTS:2%를 안심시킨다.
				PRINTFORML 다행히 %LOCALS%는 화가 없어 보이고, %RESULTS:3%의 길을 계속 가기 전에 파르시에게 %RESULTS:2%를 구해준 것에 대해 감사 인사를 전한다.
				PRINTFORML 파르시는 다시 다리로 돌아와 순찰을 재개한다.
				PRINTFORML 그녀는 이제 다리 전체를 확인해야 한다는 사실에 혼잣말로 투덜거린다.
			CASE "parsee_house_vandalism"
				PRINTFORML 당신과 %CALLNAME:CULPRIT%는 Parsee가 집을 나갈 때까지 기다린 후 몰래 들어간다.
				PRINTFORML 안으로 들어가면, 일을 시작한다.
				PRINTFORML 그녀의 옷장 속에 초상화 몇 점을 숨기고 나머지 초상화들은 거꾸로 뒤집는다.
				PRINTFORML 마지막으로 "BEWARE OF BRIDGE TROLL"이라는 팻말을 문에 붙인다.
				PRINTFORML 혼자 키득거리며, 당신과 %CALLNAME:CULPRIT%는 떠나 근처에 숨는다. 곧 Parsee가 무언가를 흥얼거리며 집으로 돌아온다.
				PRINTFORML 그녀가 그 팻말을 보자 흥얼거림이 끊긴다. 이내 익숙하지 않은 언어로 뭔가를 씩씩거리는 소리로 바뀐다.
				PRINTFORML 하지만 그녀의 어조로 보아, 아마 욕설일 것이다.
				PRINTFORML Parsee는 문에서 팻말을 뜯어내고, 그것이 종잇조각으로 변할 때까지 계속 반으로 찢은 후 멀리 던져버린다.
				PRINTFORML 그런 다음 그녀는 여전히 혼잣말로 욕을 하며 문을 연다.
				PRINTFORML 그녀는 잠시 충격에 할 말을 잃고 집 안을 응시하다가, 분노로 소리를 지르며 안으로 뛰어든다.
				PRINTFORML 그녀가 초상화들을 고치는 데 바쁘다는 것을 확신하면, 당신과 %CALLNAME:CULPRIT%는 도망친다.
		ENDSELECT
		RETURN 1
	CASE "failure"
		CULPRIT = VAR_OR_DEFAULT("Add_CULPRIT")
		SELECTCASE SELECTED_PRANK
			CASE "parsee_bridge_trap"
				PRINTFORML 당신과 %CALLNAME:CULPRIT%은(는) 파르씨가 떠나기 30분 전에 다리를 지키려고 몰래 올라간다.
				PRINTFORML 혹은 적어도, 그렇게 생각했다.
				PRINTFORML 바닥 판자를 자르기도 전에, 뒤에서 목소리가 무슨 짓을 하고 있는지 묻는다.
				PRINTFORML 당신은 몸을 돌려 팔짱을 끼고 날카롭게 노려보는 파르씨를 본다.
				PRINTFORM 변명을 생각해내기도 전에 그녀는 
				SELECTCASE K60_ATTITUDE()
					CASE 0, 1
						PRINTFORML 당신의 손에서 톱을 빼내면서 실수로 당신을 베지 않도록 조심한다.
						PRINTFORML 그러고는 차갑게 웃으며 당신의 눈을 똑바로 응시한다.
						PRINTFORML 당신은 스스로에게 화가 나서 슬그머니 자리를 피한다. 왜 파르세에게 장난칠 수 있다고 생각했을까?
						PRINTFORML 그녀는 당신보다 훨씬 나이가 많고 현명하다. 당신이 그녀를 방심하게 만들 일은 없을 것이다.
						PRINTFORML 당신은 그녀가 너무 질투 난다. 그리고 %CALLNAME:CULPRIT%도 질투 난다.
						PRINTFORML 당신은 집으로 걸어가면서 자신의 질투 속에 계속 빠져든다. 다행히 도착한 지 얼마 지나지 않아 그 감정은 사라진다.
					CASE 2, 3
						IF TALENT:MASTER:体型 >= 2
							PRINTFORML 그녀와 난간 사이에 있는 당신을 향해 움직여 얼굴을 주먹으로 가격한다.
							CALL RECOVER(MASTER, -750, "体力", " ")
							PRINTFORML 그 일격에 휘청하지만, 당신은 발을 붙인 채 버린다.
							PRINTFORML 그녀가 다시 주먹을 날리기 전에 떠나기로 결정한다.
						ELSEIF ABL:MASTER:戦闘能力 > ABL:TARGET:戦闘能力
							PRINTFORML 그녀와 난간 사이에 위치하도록 움직이며 당신을 향해 휘두른다.
							PRINTFORML 당신은 피하지만, 그 일격이 당신의 옆구리를 스치고 지나가며 만약 명중했다면 코를 부러뜨렸을 것이라는 것을 알 수 있다.
							PRINTFORML 파르시가 다시 당신을 때리려고 하기 전에 자리를 떠하기로 한다.
						ELSEIF TALENT:MASTER:体型 < 0
							PRINTFORML 당신의 팔을 잡고 강으로 밀어버린다.
						ELSE
							PRINTFORML 그녀와 난간 사이에 당신이 있게 만든 다음 얼굴을 주먹으로 때린다.
							PRINTFORML 그 일격에 당신은 뒤로 비틀거리며 나간다. 당신은 난간을 넘어 강 속으로 떨어진다.
						ENDIF
						IF TALENT:MASTER:体型 < 2 && (ABL:MASTER:戦闘能力 <= ABL:TARGET:戦闘能力)
							PRINTFORML 당신은 물에 뒤집혀 뛰어들었고, 숨이 막혔다.
							PRINTFORML 잠시 동안 공포스럽게 가라앉는 듯하더니, 힘을 되찾고 수면으로 몸을 끌어올렸다.
							PRINTFORML 고개가 물 위로 솟아오르자, 당신은 숨을 몰아쉬며 눈에서 물을 털어냈다.
							PRINTFORML 숨을 돌린 후, 해변 쪽으로 헤엄치기 시작했다.
							PRINTFORML 가는 길에 다리를 흘긋 바라봤다.
							PRINTFORML 파씨는 난간에 몸을 기댄 채 당신을 지켜보고 있었다. 그녀의 표정은 약간 걱정스러워 보였다.
							PRINTFORML 당신이 익사하지 않을 것을 보자, 그녀의 얼굴에는 만족스러운 미소가 떠올랐다.
							PRINTFORML 알고 보니 농담의 대상은 당신이었던 모양이다...
							DOWNBASE:MASTER:体力 += 50 * ABL:TARGET:戦闘能力
							DOWNBASE:MASTER:気力 += 50 * ABL:TARGET:戦闘能力
						ENDIF
				ENDSELECT
			CASE "parsee_house_vandalism"
				PRINTFORML 당신과 %CALLNAME:CULPRIT%은(는) 파르시가 집을 나갈 때까지 기다린 후 몰래 들어간다...
				SELECTCASE K60_ATTITUDE()
