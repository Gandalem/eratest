;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		;基本セット
		;時姦中
		IF FLAG:70
			PRINTFORMDW 당신은 모든 좌절을 파르시의 %HIP_TR(TARGET)%에게 풀며, 멈춘 시간 속에서 그것을 거듭 때린다...
			RETURN 1
			;睡姦中
			;Sleep rape
		ELSEIF CFLAG:MASTER:イタズラ == 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
			RETURN 1
			;Character is drunk
			;Conscious rape
		ELSEIF (TCVAR:無理矢理 || CFLAG:無理矢理膣射)
			RETURN 1
		ELSEIF TCVAR:TARGET:泥酔 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
			RETURN 1
		ELSEIF FIRSTTIME("ParseeSpanking", 1)
			SELECTCASE K60_ATTITUDE()
				;Loving
				CASE 0
					PRINTFORMW 「나를 때리고 싶어...?」
					PRINTFORMW 「복수하고 싶은 거야? 아니면 너도 흥분하는 거야?」
					PRINTFORMDW 파르시는 약간 긴장한 듯 보였지만, 이내 살짝 미소를 지으며 누웠다.
					PRINTFORMW 「음, 가끔은 네가 나를 지배하게 해 주지 않는다면 위선자겠지...」
					;Nice, horny
				CASE 1
					PRINTFORMW 「스팽킹이라니, 흥? 그런 종류의 것에 관심이 있구나...」
					PRINTFORMDW Parsee는 당신을 보며 미소를 짓고 장난스럽게 %HIS_HER(TARGET)% %HIP_TR(TARGET)%를 %PARSE("you")%에 내려놓는다.
					PRINTFORMW 「그럼 네가 할 수 있는 걸 보여줘. 끝난 후에 내가 몇 가지 팁을 줄게.」
					;Grumpy tsundere
				CASE 2
					PRINTFORMW 「여기가 어떻게 돌아가는지 이해 못 하는 것 같군.」
					PRINTFORMDW 파시가 %PARSE("you")%에게 시든 듯한 눈빛을 보냈다.
					PRINTFORMW 「나는 너에게 고통을 가한다. 그 반대는 아니다.」
					CALL PRINT_STRW, @"「넌 그걸 어떻게 해야 하는지 알 리가 없어, 이 자식아!」"
					PRINTFORMDW 분노가 타오르다 %PARSE("you")%, 그리고 %PARSE("you bring")% %PARSE("your hand")% Parsee의 위로 %HIP_TR(TARGET)% 만큼 거칠게 %PARSE("you can")%.
					PRINTFORMDW 파시가 노려본다 %PARSE("you")%에 타오르는 분노가 %HIS_HER(TARGET)% 눈에... 경멸로 바뀌기 전에.
					PRINTFORMW 「방금 뭐였지? 별로 아무것도 안 느껴졌는데!」
					CALL PRINT_STRW, @"「ITALIC아큐우는 아마 그것보다 더 세게 때릴 수 있을 거야!」"
					PRINTFORML 「너는 약해, %K60_MASTER()%. 더 이상 자멸하기 전에 그냥 포기해라.」
					PRINTFORMDW %HE_SHE([[パルスィ]], 1)%은(는) 너무 예측 가능하군.
					PRINTFORMDW %BREAKENG(@"%HE_SHE([[パルスィ]], 1)%'ll let %PARSE("you")% do anything to %HIM_HER(TARGET)% if %HE_SHE(TARGET)% thinks %HE_SHE(TARGET)% can use it to make %PARSE("you", 1)% jealous.")%
					PRINTFORMDW 당신은 다시 손을 들면서 스스로 미소를 지었다...
					;Fake nice
				CASE 3
					PRINTFORMW 「스팽킹? 아니, 그런 것 같지 않아.」
					CALL PRINT_STRW, @"「네가 말을 안 들으면 ITALIC너를 때려줄 수도 있어!」"
					PRINTFORMDW 파르시를 무시하고, %PARSE("you bring")% %PARSE("your hand")% 그의 %HIP_TR(TARGET)%에 %PARSE("you can")%만큼 세게 내리쳤다.
					PRINTFORMDW 파르시는 %PARSE("you")%에게 노려보았고, %HIS_HER(TARGET)%의 눈에는 분노가 타올랐지만... 경멸로 바뀌었다.
					PRINTFORMW 「뭐였지? 거의 아무것도 못 느꼈다고!」
					CALL PRINT_STRL, @"「ITALIC아큐우는 아마 그것보다 더 세게 때릴 수 있을 거야!」"
					PRINTFORMW 「넌 약하구나, %K60_MASTER()%. 더 망치기 전에 지금 포기해라.」
					PRINTFORMDW 이제 화까지 났군.
					PRINTFORMDW 당신은 다시 손을 들며 그녀를 똑바로 노려본다...
			ENDSELECT
			CALLF FIRSTTIME("ParseeSpanking")
			RETURN 1
		ELSE
			SELECTCASE K60_ATTITUDE()
				;Loving
				CASE 0
					PRINTFORMDW 파시 그릿은 %HIS_HER(TARGET)%의 이를 악물고 고통을 참는다.
					SELECTCASE RAND:3
						CASE 0
							IF ABL:TARGET:マゾっ気 < 2
								PRINTFORMW 「아파요, %K60_MASTER()%... 다른 거 할 수 없어요?」
							ELSE
								CALL HPH_PRINT, @"「아파요, 하지만 좋은 쪽으로... 멈추지 말아주세요 HPH」", "W"
							ENDIF
						CASE 1
							IF ABL:TARGET:マゾっ気 < 2
								IF TEQUIP:縄
									PRINTFORMW 「우리가 이걸 해야 하나요? 그냥 묶어둔 채로 저를 어루만져 주시면 안 돼요?」
								ELSE
									PRINTFORMW 「이거 해야 해? 그냥 나 묶어주면 안 돼?」
								ENDIF
							ELSE
								IF TEQUIP:縄
									PRINTFORMW 「묶여 있을 때가 훨씬 기분이 좋네... %MOAN("l")%...」
								ELSE
									PRINTFORMW 「나도 묶어줘, 제발... %MOAN("l")%...」
								ENDIF
							ENDIF
						CASE 2
							IF ABL:TARGET:マゾっ気 < 2
								PRINTFORMW 「나한테 화났기 때문에 이러는 거 아니지?」
							ELSE
								PRINTFORMW 「고통을 받는 것이 고통을 주는 것만큼 기분 좋을 줄은 몰랐어... %SLUR(MOAN("m"), -1)%」
							ENDIF
					ENDSELECT
					;Nice, horny
				CASE 1
					PRINTFORMDW 당신이 손을 들어 %HIS_HER(TARGET)%의 %HIP_TR(TARGET)%에 내리치자 파르시가 신음한다.
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「%MOAN("m")% 나 사람 때릴 때 기분이 이렇단 말이야?」
							SIF ABL:TARGET:マゾっ気 >= 2
								PRINTFORMW 「%MOAN("l")%... 아파요... 하지만 좋은 방식으로...」
						CASE 1
							PRINTFORMW 「흐읍... 고통 내성이 더 높았으면...」
						CASE 2
							PRINTFORML 「내 엉덩이는 좀 쉬게 해주고 잠시 내 허벅지에 집중해!」
							PRINTFORMW 「같은 곳만 계속 때리면 기분이 좋지 않아.」
					ENDSELECT
					;Grumpy tsundere
				CASE 2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「같은 곳만 계속 때리지 마, 이 바보야!」
							PRINTFORMW 「멍들게 할 거야!」
							PRINTFORMW 「솔직히... 이제부터 내가 매달라고. 너 혼자 창피해질 뿐이야.」
						CASE 1
							PRINTFORMW 「으윽... 이 멍이 가시려면 친구들이랑 온천에 가지 말라고 상기시켜줘.」
							PRINTFORMW 「내 성생활을 그들에게 알리고 싶지 않아. 특히 너랑 잔 걸은 더더욱 알고 싶지 않아.」
						CASE 2
							IF ABL:TARGET:マゾっ気 < 2
								PRINTFORML 「고통과 쾌락은 당신에게 뒤섞여 있을지 몰라도, 나에게는 그렇지 않아!」
								PRINTFORMW 「그만두지 않으면, 진짜 스팽킹이 어떤 느낌인지 보여주겠어!」
							ELSE
								PRINTFORMW 「당신이 나를 때리는 것보다 더 창피한 것은 어떻게 \@ HAS_PENIS(TARGET) ? 단단하게 # 젖는다 \@ 나를 만들고 있어...」
							ENDIF
					ENDSELECT
					;Fake nice
				CASE 3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「대신 내가 당신을 때려주는 게 더 좋지 않아?」
						CASE 1
							PRINTFORML 「계속 같은 곳을 스팽킹하면 멍이 들게 된다.」
							PRINTFORMW 「이 정도는 잘 모르던 것 같네?」
						CASE 2
							IF IS_NONHUMAN(MASTER)
								PRINTFORMW 「당신은 요괴일지 모르지만, 나에게 큰 고통을 줄 만큼 강하지는 않다.」
							ELSE
								PRINTFORMW 「인간이 나 같은 요괴에게 해를 끼칠 수 있다고 정말 생각하는 거야?」
							ENDIF
							PRINTFORMW 「다른 걸 하는 건 어때? 너 혼자 지쳐서 나를 만족시키지 못하게 할 거야.」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
