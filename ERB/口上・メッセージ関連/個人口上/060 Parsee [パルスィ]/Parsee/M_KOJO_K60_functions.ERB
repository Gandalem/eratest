@K60_ATTITUDE(ARG)
#FUNCTION
;If Lover and not Lust or Sex Friend, acts genuinely nice (or if ARG and Love or Pleasure Mark 3)
IF (TALENT:TARGET:恋人 && !(TALENT:TARGET:愛欲 || TALENT:TARGET:セフレ)) || (ARG && (TALENT:TARGET:恋慕 && MARK:TARGET:快楽刻印 < 3))
	RETURNF 0
	;If Sex Friend or Lust, acts less nice than Love but nicer than Other (and also hornier)
ELSEIF TALENT:TARGET:愛欲 || TALENT:TARGET:セフレ
	RETURNF 1
	;If Yearning but not Love or not Love/Lust/Sex Friend, and not Pleasure Mark 3, or if you've seen her meltdown scene/cheated on one of her friends but she's not at Love, act grumpy and tsundere
	;We don't check for Sex Friend/Lust because we already checked for it above
ELSEIF (TALENT:TARGET:思慕 && !TALENT:TARGET:恋慕 && MARK:TARGET:快楽刻印 < 3 && !CFLAG:[[パルスィ]]:K60EN_PARSEE_KNOWS_ABOUT_YOUR_BTD_RELATIONSHIP) || ((CFLAG:[[パルスィ]]:K60EN_PARSEE_MELTDOWN == 1 || (!FIRSTTIME("NTRedParseesFriend", 1))) && !TALENT:TARGET:恋慕)
	;todo: if yearning, sometimes slip into Loving attitude?
	RETURNF 2
	;Otherwise, acts falsely nice
ELSE
	RETURNF 3
ENDIF
;==================================================================
;Have Parsee get angry if she sees you on a date with someone else
;ARG is the other character's ID
;==================================================================

@K60_DATE_ANGER(ARG)
;TODO increase this the more different girls you date in front of her
DEBUGPRINTFORML DATE_ANGER에서 ARG는 {ARG}이다.
;Parsee doesn't get angry if you're in an open relationship with her or sex friends
;If she's at Love but not Lovers, she gets mad but not hate marks
IF TALENT:[[パルスィ]]:恋人
	IF VAR_OR_DEFAULT("MORELOVER")
		RETURN 1
	ELSE
		; If you ARE cheating on her, she gets PISSED
		CALL K60_GET_ANGRY(3)
		CALL K60_DATE_ANGER_PENALTY_FAVOR(20)
	ENDIF
ELSE
	SELECTCASE K60_ATTITUDE()
		CASE 1
			RETURN 1
		CASEELSE
			;If Parsee likes you, she gets pissed but you only lose a little favor
			IF TALENT:TARGET:恋慕 || MARK:TARGET:快楽刻印 >= 3 && !GROUPMATCH(ARG, 83, 84)
				CALL K60_GET_ANGRY()
				CALL K60_DATE_ANGER_PENALTY_FAVOR(1)
				RETURN 1
			ELSE
				SELECTCASE ARG
					CASE 157 ;Zanmu
						CALL K60_DATE_ANGER_PENALTY(5)
					CASE 38, 97 ;Koishi, Seija
						CALL K60_DATE_ANGER_PENALTY(4)
					CASE 17, 64, 178 ;Alice, Yuugi, Noroiko
						CALL K60_DATE_ANGER_PENALTY(3)
					CASE 49 ;Satori
						CALL K60_DATE_ANGER_PENALTY(2)
					CASE 83, 84 ;Kisume and Yamame
						;No penalty because she's happy for her friends (Yuugi is an exception because you're stealing her crush)
						RETURN 1
					CASEELSE
						CALL K60_DATE_ANGER_PENALTY(1)
				ENDSELECT
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
;==================================================================
;Apply the actual penalty for Parsee's jealousy
;ARG is the severity
;==================================================================

@K60_DATE_ANGER_PENALTY(ARG)
#DIM OriginalHateMarkValue
DEBUGPRINTFORML DATE_ANGER_PENALTY ARG는 {ARG}이다.
PRINTFORML
SELECTCASE ARG
	CASE 1
		PRINTFORMDW 파씨는 %HIS_HER(TARGET)% 이를 갈고 %HE_SHE(TARGET)%는 부러움에 %PARSE("you")%를 바라본다...
	CASE 2
		PRINTFORMDW 파시(Parsee)는 %HIS_HER(TARGET)%의 이를 갈며 분노로 떨고, %HE_SHE(TARGET)%은(는) %PARSE("you")%을 부러운 듯 응시한다...
	CASEELSE
		PRINTFORMDL Parsee는 이빨을 갈고 분노로 떨면서 %HE_SHE(TARGET)%가 %PARSE("you")%를 질투스럽게 바라보는 것을 본다.
		PRINTFORMDW %HE_SHE(TARGET,1)%의 주먹을 너무 세게 꽉 쥐어서 %HIS_HER(TARGET)% 손톱에서 피가 나고 있다...
ENDSELECT
SELECTCASE CFLAG:K60ENC_SETTING_JEALOUSY_PENALTY
	;Hate Marks, anger, and favor loss
	CASE 0
		DEBUGPRINTFORML 증오 표시, 분노, 그리고 호의 손실
		CALL K60_GET_ANGRY(ARG)
		CALL K60_DATE_ANGER_PENALTY_FAVOR(ARG)
		;Anger and favor loss
	CASE 1
		DEBUGPRINTFORML 분노 및 호의 손실
		CALL K60_GET_ANGRY()
		CALL K60_DATE_ANGER_PENALTY_FAVOR(ARG)
		;No penalty if the flag is 2
	CASE 2
		DEBUGPRINTFORML 패널티 없음
		;Hate Marks, anger, favor loss, and yandere points (Not yet implemented)
	CASE 3
		CALL K60_GET_ANGRY()
		CALL K60_DATE_ANGER_PENALTY_FAVOR(ARG)
		IF TALENT:[[パルスィ]]:恋人
			LOCAL = 9999
		ELSEIF TALENT:[[パルスィ]]:恋慕
			LOCAL = 3
		ELSEIF TALENT:[[パルスィ]]:思慕
			LOCAL = 2
		ENDIF
		CFLAG:[[パルスィ]]:K60EN_PARSEE_YANDERE_POINTS += (10 * ARG * LOCAL)
	CASEELSE
		PRINTFORMDW ARG는 {ARG}여서는 안 된다! 이것을 보고하라!
ENDSELECT
RETURN 1

@K60_DATE_ANGER_PENALTY_FAVOR(ARG)
CALL CHANGE_CFLAG(2, TARGET, -20 * ARG)
CALL CHANGE_CFLAG(4, TARGET, -10 * ARG)
PRINTFORML
RETURN 1
