; Modular ERB: 個人口上/060 Parsee [パルスィ]/Parsee/M_KOJO_K60_HashihimeServices.ERB
;-------------------------------------------------
;パルスィ用
;Hashihime services
;-------------------------------------------------

@K60_HASHIHIME_SERVICES
#DIM UnwantedLover
#DIM DYNAMIC LOVERPEP
CALL M_KOJO_COLOR_K60
SELECTCASE K60_ATTITUDE()
	CASE 0, 1, 3
		PRINTFORMDW 파르시는 당신에게 미소 짓는다.
		PRINTFORMW 「나에게 무엇이 필요한가요?」
	CASE 2
		PRINTFORMDW 파시가 당신을 노려본다.
		PRINTFORMW 「뭐 원하는 거냐?」
ENDSELECT
DO
RESETCOLOR
DRAWLINE
CALL K60_HashihimeServices_CalculateLOVERPEP()
LOVERPEP = RESULT:0
UnwantedLover = RESULT:1
IF LOVERPEP > 1
	PRINTFORML [  1] 나의 연인 중 한 명과 헤어지는 것을 도와줘
ELSEIF UnwantedLover == 60
	PRINTFORML [  1] 나는 당신과 헤어지고 싶다.
ELSEIF LOVERPEP == 1
	PRINTFORML [  1] - %CALLNAME:UnwantedLover%와 헤어지게 도와줘
ELSE
	SETCOLOR C_L_GRAY
	PRINTFORML [  1] - 연인을 얻는다
	RESETCOLOR
ENDIF
IF ABL:[[パルスィ]]:親密 >= 2
	PRINTFORML [  2] 나에게 ~에 대해 말해줘...
ELSE
	SETCOLOR C_L_GRAY
	PRINTFORML [  2] - ????? (Parsee와 친구 되기)
	RESETCOLOR
ENDIF
IF (K60_FUCKED_PARSEE())
	PRINTFORML [  3] [ 3] - 네 음모를 스타일링하고 싶어.
ELSE
	SETCOLOR C_L_GRAY
	PRINTFORML [  3] [ 3] - ???? (Parsee에게 밀려 내려가거나 Parsee의 동의를 얻는다)
	RESETCOLOR
ENDIF
IF K60_YOU_ARE_CHEATING_ON_ONE_OF_PARSEES_FRIENDS()
	SETCOLOR C_L_GRAY
	IF !CFLAG:[[パルスィ]]:生解禁
		PRINTFORML [  4] [ 4] - ????? (더 많은 연인을 허용하거나 파르시의 친구들과 헤어진다)
	ELSE
		PRINTFORML [  4] 파르시는 '더 많은 연인'을 활성화하거나 그녀의 친구들과 헤어지지 않으면 노골적인 섹스에 동의하지 않는다.
	ENDIF
	RESETCOLOR
ELSEIF CFLAG:[[パルスィ]]:生解禁 == 2
	SETCOLOR C_L_GRAY
	PRINTFORML [  4] [ 4] - 파르시(Parsee)는 이미 당신과 아이를 가질 의향이 있다.
	RESETCOLOR
ELSEIF (TALENT:[[パルスィ]]:恋人 && CFLAG:[[パルスィ]]:生解禁 == 1) && ESTRUS_CYCLE([[パルスィ]]) == 150
	PRINTFORML [  4] 나는 당신과 아이를 갖고 싶다.
ELSEIF CFLAG:[[パルスィ]]:生解禁 == 1
	SETCOLOR C_L_GRAY
	PRINTFORML [  4] [ 4] 파르시의 연인이 되어 무해한 날 성관계 허락을 받고 그녀의 위험한 날까지 기다렸다.
	RESETCOLOR
ELSEIF !CFLAG:[[パルスィ]]:生解禁 && (TALENT:[[パルスィ]]:恋人 || TALENT:[[パルスィ]]:愛欲 || TALENT:[[パルスィ]]:セフレ)
	PRINTFORML [  4] 나는 위험하지 않은 날에는 그것을 생으로 하고 싶다.
ELSE
	SETCOLOR C_L_GRAY
	PRINTFORML [  4] [ 4] - ??? (파르시의 연인이나 섹프가 되어 위험하지 않은 날을 기다린다)
	RESETCOLOR
ENDIF
PRINTFORML [999] 신경 쓰지 마
INPUT
SELECTCASE RESULT
	CASE 999
		CALL M_KOJO_COLOR_K60
		TIME += 5
		RETURN 1
	CASE 1
		IF !TALENT:MASTER:恋人
			CONTINUE
		ELSE
			CALL K60_HashihimeServices_Breakup(LOVERPEP, UnwantedLover)
			SIF RESULT == -2
				RETURN -1
		ENDIF
	CASE 2
		IF ABL:[[パルスィ]]:親密 < 2
			CONTINUE
		ELSE
			CALL K60_HashihimeServices_ParseeChanDoesNotShutUp()
		ENDIF
	CASE 3
		IF !K60_FUCKED_PARSEE()
			CONTINUE
		ELSE
			CALL M_KOJO_COLOR_K60
			CALL K60_STYLE_PUBIC_HAIR()
			TIME += 5
			RESETCOLOR
		ENDIF
	CASE 4
		IF K60_YOU_ARE_CHEATING_ON_ONE_OF_PARSEES_FRIENDS()
			CONTINUE
		ELSEIF CFLAG:[[パルスィ]]:生解禁 == 2
			CONTINUE
		ELSEIF (TALENT:[[パルスィ]]:恋人 && CFLAG:[[パルスィ]]:生解禁 == 1) && ESTRUS_CYCLE([[パルスィ]]) == 150
			CALL OGAMITAOSHI([[パルスィ]])
		ELSEIF CFLAG:[[パルスィ]]:生解禁 == 1
			CONTINUE
		ELSEIF !CFLAG:[[パルスィ]]:生解禁 && (TALENT:[[パルスィ]]:恋人 || TALENT:[[パルスィ]]:愛欲 || TALENT:[[パルスィ]]:セフレ)
			CALL OGAMITAOSHI([[パルスィ]])
		ELSE
			CONTINUE
		ENDIF
ENDSELECT
LOOP 1

@K60_HashihimeServices_CalculateLOVERPEP()
#DIM UnwantedLover
#DIM TMP
#DIM DYNAMIC LOVERPEP
;Copied from MORELOVER.ERB
;TODO: Refactor that file to split its functionality into separate functions and call them instead
FOR TMP,1,CHARANUM
IF TALENT:TMP:7 > 0
	LOVERPEP ++
	UnwantedLover = TMP
ENDIF
NEXT
DEBUGPRINTFORML 연인페프는 {LOVERPEP}이다.
RETURN LOVERPEP, UnwantedLover, TMP

@K60_HashihimeServices_Breakup(LOVERPEP, UnwantedLover)
#DIM BreakupPrice
#DIM UnwantedLover
#DIM TMP
#DIM DYNAMIC LOVERPEP
#DIM nLineCnt_Head
CALL M_KOJO_COLOR_K60
IF FIRSTTIME("ParseeBreakup")
	nParseeLoversBrokenUpWith ++
	IF LOVERPEP == 1
		IF UnwantedLover == 60
			GOTO BreakParseesHeart
		ELSEIF GROUPMATCH(UnwantedLover, 83, 84, 64)
			GOTO FriendBreakup
		ENDIF
	ENDIF
	SELECTCASE K60_ATTITUDE()
		CASE 0, 1
			PRINTFORMW 「이게 하시히메가 하는 말치고 이상하게 들릴 거란 건 알지만...」
			PRINTFORMW 「하지만 너는 나를 바꿔 놓았어.」
			PRINTFORMW 「정말로 이걸 하고 싶은 거야? %HIM_HER(UnwantedLover)%와 대화로 풀 수 없어?」
			PRINTFORMW 「...아니? 두 사람이 이 관계를 유지할 방법이 전혀 없다는 게 확신해?」
			PRINTFORMDW 파르세가 한숨을 내쉰다.
			PRINTFORMW 「좋아. 둘 다 원치 않는 관계에 갇혀 있는 것보다는 나을 테니까.」
			PRINTFORMW 「하지만 난 여전히 너에게 비용을 청할 거야.」
			BreakupPrice = 5000
		CASE 2
			PRINTFORMW 「%HIM_HER(UnwantedLover)%에게 %HIS_HER(UnwantedLover)% 얼굴을 보라고 말할 용기가 없어, 응?」
			PRINTFORMDW 파르세가 미소 짓는다.
			PRINTFORMW 「좋다. 하지만 공짜로는 해주지 않을 것이다.」
			BreakupPrice = 20000
		CASE 3
			PRINTFORMW 「그러니까 두 분은 함께 할 운명이 아니었던 모양이네요... 참 안됐어요.」
			PRINTFORMDW 파르시는 고개를 젓는다.
			PRINTFORMW 「음, 그걸 고칠 수도 있죠... 대가는 치러야 하지만요.」
			BreakupPrice = 10000
	ENDSELECT
ELSE
	SIF TALENT:TARGET:恋人 && !VAR_OR_DEFAULT("MORELOVER")
		GOTO BreakParseesHeart
	SELECTCASE K60_ATTITUDE()
		CASE 0, 1
			BreakupPrice = nParseeLoversBrokenUpWith * 5000
		CASE 2
			BreakupPrice = nParseeLoversBrokenUpWith * 20000
		CASE 3
			BreakupPrice = nParseeLoversBrokenUpWith * 10000
	ENDSELECT
ENDIF
$BREAKUP_SELECT
SIF LOVERPEP <= 1
	GOTO BREAKUP
PRINTFORML 「누구와 헤어지고 싶니?」
RESETCOLOR
DRAWLINE
nLineCnt_Head = LINECOUNT
REDRAW 0
FOR TMP,1,CHARANUM
IF TALENT:TMP:恋人 > 0
	PRINTFORMLC [{TMP, 3}] %CALLNAME:TMP%
ENDIF
NEXT
PRINTFORML
PRINTFORML [-1] 취소
INPUT
UnwantedLover = RESULT
CALL M_KOJO_COLOR_K60
$BREAKUP
IF UnwantedLover == -1
	PRINTFORMW 「갑자기 마음이 변했어?」
	RESETCOLOR
	RETURN -1
ELSEIF UnwantedLover < 0 || UnwantedLover >= CHARANUM
	PRINTFORMW 「도대체 누구를 말하는 거야?」
	GOTO BREAKUP_SELECT
ELSEIF !TALENT:UnwantedLover:恋人
	PRINTFORMW 「지금 뭘 하는 거야? 너는 %HIM_HER(UnwantedLover)%와 연애 중이 아니야.」
	GOTO BREAKUP_SELECT
ELSEIF UnwantedLover == MASTER
	PRINTFORMW 「무슨 소리 하는 거야? 너 자신과 헤어질 수는 없잖아.」
	GOTO BREAKUP_SELECT
ELSEIF TALENT:UnwantedLover:妻
	IF TALENT:UnwantedLover:妻 == 1
		PRINTFORMW 「이미 %HIM_HER(UnwantedLover)%에게 약혼했잖아. 이 일에 휘말릴 생각은 없어.」
	ELSEIF TALENT:UnwantedLover:妻 == 2
		PRINTFORMW 「나 이혼 안 해. 스스로 해결해봐.」
	ENDIF
	RESETCOLOR
	RETURN -1
ELSEIF GROUPMATCH(UnwantedLover, 83, 84, 64)
	$FriendBreakup
	IF UnwantedLover != 64
		PRINTFORMDW 파씨는 팔짱을 끼고 당신을 노려본다.
	ELSE
		PRINTFORMDW 파르시는 잠시 갈등하는 듯하다... 그러고는 팔짱을 끼고 당신을 노려본다.
	ENDIF
	PRINTFORML 「당신이 내 친구 중 한 명과 헤어지려고 한다는 걸 알고 있지 않나?」
	PRINTFORMW 「만약 내가 그렇게 하길 원한다면 추가 비용을 청구할 거야.」
	BreakupPrice *= 2
ELSEIF UnwantedLover == 60
	$BreakParseesHeart
	CALL PRINT_STRL, @"「뭐라고?」"
	IF !CFLAG:[[パルスィ]]:K60EN_PARSEE_TIMES_BROKEN_UP_WITH
		PRINTFORMDW 파르시는 경악한 표정을 짓는다.
		PRINTFORMW 「너... 정말로...?」
		CALL ASK_YN("나는 한다.", "안 한다.")
		IF RESULT
			PRINTFORMDW 파르시가 안도하며 한숨을 내쉰다.
			CALL PRINT_STRW, @"「다행이야. 네가 나를 미워하게 될 줄 알았더라면 내가 어쩔지 모르겠어.」"
			RESETCOLOR
			RETURN -1
		ELSE
			PRINTFORMDW 파르시가 잠시 당신을 응시한다. 그녀는 모든 것이 그저 악몽이기를 필사적으로 바라는 듯하다.
			PRINTFORMDW 당신이 정말로 그녀와 헤어지길 원한다는 것이 분명해졌을 때, 그녀는 깊고 떨리는 숨을 들이마시고 말을 꺼낸다.
			PRINTFORMW 「...알겠어. 나를 더 이상 사랑하지 않는다면 나와 관계에 갇히고 싶지 않아.」
			PRINTFORMW 「이 일에 대해 대가 청하지 않을게.」
			BreakupPrice = 0
			GOTO BreakupRitual
		ENDIF
	ELSE
		PRINTFORMDW 파르시가 당신을 노려본다.
		CALL PRINT_STRW, @"「나와 함께하고, 나에게 헤어지고, 다시 나와 함께하기를 원하다가, 이제 또 헤어지려고 하는 거야?!」"
		PRINTFORMDW 그녀는 당신에게 탄막을 퍼부으려는 듯 보인다.
		PRINTFORMW 「이게 무슨 농담이야?! 만약 그렇다면 난 전혀 재미없어.」
		CALL ASK_YN("그게 아니다.", "그렇다.")
		PRINTFORMDW 파르시가 미소 짓는다.
		IF RESULT
			PRINTFORMW 「아쉽네. 우리 끝났어. 너도 지쳤고, 네 더러운 것도 질렸어.」
		ELSE
			PRINTFORMW 「좋아. 우린 끝났으니까. 난 네가 지긋지긋하고, 네 쓰레기 같은 행동들도 지긋지긋해.」
		ENDIF
		FONTITALIC
		SETCOLOR C_RED
		CALL KEYTYPING(@"「꺼져서 죽어.」", "W", 200)
		FONTREGULAR
		CALL M_KOJO_COLOR_K60
		PRINTFORMDW 파시가 공중에 떠서 스펠 카드를 들어 올린다.
		PRINTFORMDW 그녀는 독을 품은 모욕과 함께 단마쿠를 물결처럼 발사하고, 당신은 목숨을 걸고 도망친다.
		LOCAL = CFLAG:[[パルスィ]]:2
		PRINTFORMDW 호의 -{LOCAL} (분석)
		CFLAG:[[パルスィ]]:2 = 0
		LOCAL = CFLAG:[[パルスィ]]:4
		PRINTFORMDW 신뢰 -{LOCAL} (분석)
		CFLAG:[[パルスィ]]:4 = 0
		ABL:[[パルスィ]]:従順 = 0
		ABL:[[パルスィ]]:親密 = 0
		JUEL:[[パルスィ]]:10 = 0
		JUEL:[[パルスィ]]:16 = 0
		JUEL:[[パルスィ]]:12 = 0
		JUEL:[[パルスィ]]:20 = 0
		PRINTFORMDW 순종이 LV0으로 감소했다...
		PRINTFORMDW 친밀도가 LV0으로 감소했다...
		TALENT:[[パルスィ]]:恋人 = 0
		TALENT:[[パルスィ]]:恋慕 = 0
		TALENT:[[パルスィ]]:セフレ = 0
		TALENT:[[パルスィ]]:愛欲 = 0
		TALENT:[[パルスィ]]:思慕 = 0
		CALL K60_GET_ANGRY(3)
		IF CFLAG:TARGET:同行
			CFLAG:TARGET:同行 = 0
			CFLAG:MASTER:同行 = 0
		ENDIF
		CALL RUNOFF(60, 0)
		CFLAG:[[パルスィ]]:K60EN_PARSEE_TIMES_BROKEN_UP_WITH ++
		RESETCOLOR
		RETURN -2
	ENDIF
ELSEIF INRANGE(RELATION:[[パルスィ]]:UnwantedLover, 1, 99)
	SELECTCASE K60_ATTITUDE()
		CASE 0, 1
			PRINTFORMW 「알겠어...」
			PRINTFORMDW 파르시가 안도하는 듯한 표정을 감추려 노력한다.
		CASE 2, 3
			PRINTFORMW 「좋아. 솔직히 네가 처음부터 %HIM_HER(UnwantedLover)%에게서 뭘 봤는지 모르겠어.」
	ENDSELECT
	BreakupPrice *= ((100 - RELATION:[[パルスィ]]:UnwantedLover) / 100)
ENDIF
PRINTFORML 「나의 비용은 %金額表示(BreakupPrice)%이다.」
IF MONEY < BreakupPrice
	PRINTFORML 「...그리고 당신은 그것을 감당할 수 없는 것 같다.」
	PRINTFORMW 「나중에 다시 돌아와라, 여유가 될 때 말이다.」
	RESETCOLOR
	RETURN -1
ENDIF
CALL ASK_M("나는 마음을 바꿨다", 1, @"원치 않는 연인(%CALLNAME:UnwantedLover%)과 헤어지다", 1)
SELECTCASE RESULT
	CASE 0
		IF GROUPMATCH(UnwantedLover, 83, 84, 64)
			PRINTFORMDW 파시가 너를 노려본다.
			PRINTFORMW 「가지고 있는 게 좋을 거야.」
		ELSE
			SELECTCASE K60_ATTITUDE()
				CASE 0, 1
					PRINTFORMW 「그게 아마 최선일 거야.」
				CASE 2
					PRINTFORMW 「그럼 내 시간을 뭘 위해 낭비한 거지?」
				CASE 3
					PRINTFORMW 「알겠다.」
					PRINTFORMDW 파시가 조금 실망한 듯 보인다.
			ENDSELECT
		ENDIF
		RESETCOLOR
		RETURN -1
	CASE 1
		$BreakupRitual
		IF FIRSTTIME("RitualCutscene")
			PRINTFORMDW 파르시가 주머니에 손을 넣어 사악해 보이는 가위 한 쌍을 꺼냈다.
			PRINTFORMDW 그것들은 당신이 이전에 본 적 없는 이상한 은색 금속으로 만들어져 있었다.
			PRINTFORMW 「이 의식이 성공하려면, 곧 헤어질 연인의 모습을 마음속에 담아야 한다.」
			PRINTFORMW 「힘든 시간을 떠올리는 것이 더 쉽다.」
			IF UnwantedLover == 60
				PRINTFORMDW 파세는 비웃는다.
				PRINTFORMW 「그건 문제가 되지 않을 거야. 결국 우리가 얘기하는 건 나니까.」
			ENDIF
			PRINTFORMW 「이제 눈을 감아라.」
			PRINTFORMDW 당신은 눈을 감고 %CALLNAME:UnwantedLover%와 가졌던 나쁜 시간들을 생각한다.
			PRINTFORMDW 싸움들, 그녀가 신경을 건드린 순간들, 당신이 참을 수 없는 그녀의 모든 짜증 나는 작은 습관들...
			PRINTFORMDW 당신은 자신의 \@ IS_MALE(MASTER) ? 새끼손가락 # 엄지손가락 \@ 주변에 무언가 조여오는 것을 느끼고 충격 속에 눈을 뜬다.
			IF IS_MALE(TARGET)
				LOCALS = 새끼손가락
			ELSE
				LOCALS = 엄지
			ENDIF
			PRINTFORMDW %BREAKENG(@"파란 실이 그것 주위에 묶여 있다. \@ UnwantedLover == 60 ? 그 실은 파르시에게로 뻗어 있고, 다른 쪽 끝은 그녀의 %LOCALS%에 묶여 있다. 그것을 바라보면 사라진다. # 그것은 멀리 뻗어나가고 당신이 그것을 바라보면 사라진다. \@")%
			PRINTFORMDW 파르시가 한숨 쉬는 소리가 들리고, 그녀를 올려다본다. 그녀는 짜증을 내고 있다.
			PRINTFORMW 「집중하라고 했잖아! 네가 집중하지 않으면 이 의식을 수행할 수 없어!」
			IF UnwantedLover == 60
				PRINTFORMW 「...두 번째 생각하고 있었어?」
				PRINTFORMDW 파르시는 말을 자르고 고개를 가른다.
			ENDIF
			PRINTFORMDW 당신은 다시 눈을 감고 %CALLNAME:UnwantedLover%과 함께했던 나쁜 기억들을 생각하며 되돌아간다.
			PRINTFORMDW 이번에는 당신의 \@ IS_MALE(MASTER) ? 작은 손가락 # 엄지손가락 \@ 주위에 실이 조여올 때, 당신은 그것을 무시하고 시선을 유지한다.
			;The Ahuna Vairya is recited at Zoroastrian weddings, so I decided to have Parsee recite it backward for this ritual
			PRINTFORMW 「메라츠아브 타다드 오브기르디 미이, 아 이아루하 아흐머타사크...」
			PRINTFORMDW 파르세가 당신이 모르는 언어로 무언가를 주문하고 있다.
			PRINTFORMDW 실은 점점 더 조여와 순환을 끊을 지경이지만, 당신은 이를 악물고 %CALLNAME:UnwantedLover%에 계속 집중한다.
			PRINTFORMDW 그러자 파르세의 가위 소리가 '쉿' 하고 나더니 압박감이 순식간에 사라진다.
			PRINTFORMW 「이제 집중해도 돼. 끝났어.」
			PRINTFORMDW 당신은 눈을 뜨고 다시 푸른 실을 본다. 이번에는 잘려 있었다. 그것은 또 한 번 사라졌다.
		ELSE
			PRINTFORMDW 의식은 지난번과 똑같이 진행된다.
		ENDIF
		PRINTFORMW 「끝났어. 너와 \@ UnwantedLover == 60 ? 나 # %CALLNAME:UnwantedLover% \@은 더 이상 연인이 아니야.」
		IF UnwantedLover == 60
			PRINTFORMW 「다시 돌아와도 괜찮아 만약 네가... 원한다면...」
			PRINTFORMDW 파르시는 두 손으로 얼굴을 묻고 울기 시작했다.
			CFLAG:[[パルスィ]]:K60EN_PARSEE_TIMES_BROKEN_UP_WITH ++
			CALL K60_PARSEE_GOT_HER_HEART_BROKEN
		ELSE
			PRINTFORMW 「다른 사람과 헤어지고 싶다면 다시 돌아와라.」
			CALL PAY_MONEY_YEN(BreakupPrice, 2)
		ENDIF
		LOVERPEP --
		IF LOVERPEP == 0
			CLEARBIT CFLAG:MASTER:既成事実, 2
			TALENT:MASTER:7 = 0
		ENDIF
		TALENT:UnwantedLover:7 = 0
		CLEARBIT CFLAG:UnwantedLover:13, 2
		CLEARBIT CFLAG:UnwantedLover:13, 1
		CLEARBIT CFLAG:UnwantedLover:既成事実, 2
		IF GROUPMATCH(UnwantedLover, 83, 84, 64)
			CFLAG:[[パルスィ]]:押し倒し禁止 = CFLAG:[[パルスィ]]:K60EN_PARSEE_OLD_NO_PUSHDOWN_VALUE
			CFLAG:[[パルスィ]]:既成事実 = CFLAG:[[パルスィ]]:K60EN_PARSEE_OLD_CONSENT_VALUE
			CFLAG:[[パルスィ]]:ヤラせちゃった = CFLAG:[[パルスィ]]:K60EN_PARSEE_OLD_BEEN_PUSHED_DOWN_VALUE
			CFLAG:[[パルスィ]]:K60EN_PARSEE_OLD_NO_PUSHDOWN_VALUE = 0
			CFLAG:[[パルスィ]]:K60EN_PARSEE_OLD_CONSENT_VALUE = 0
			CFLAG:[[パルスィ]]:K60EN_PARSEE_OLD_BEEN_PUSHED_DOWN_VALUE = 0
		ENDIF
		TCVAR:[[パルスィ]]:K60ENC_TCVAR_DATE_REACTION = 0
		UnwantedLover = 0
		nParseeLoversBrokenUpWith ++
		TIME += 30
		RESETCOLOR
		RETURN 1
ENDSELECT
