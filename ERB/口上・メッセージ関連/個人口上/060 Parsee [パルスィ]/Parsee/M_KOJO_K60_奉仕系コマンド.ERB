@M_KOJO_MESSAGE_COM_K60_89_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && SHIRAHU(60) && !(TCVAR:無理矢理 || CFLAG:無理矢理膣射)
	IF ABL:TARGET:精液中毒 >= 3
		SELECTCASE K60_ATTITUDE()
			CASE 0, 1
				PRINTFORMW 「건배!」
				PRINTFORMDW 파르시가 미소를 지으며 당신의 정액을 간절히 마신다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은(는) 맛을 음미하기 위해 잠시 동안 그것을 %HIS_HER(TARGET)% 입안에서 휘젓다가 삼킨다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은(는) 아무것도 놓치지 않았는지 확인하듯 %HIS_HER(TARGET)% 입술을 핥고, 이내 미소 짓는다.
				PRINTFORML 「이렇게까지 이것들을 즐기게 될 줄은 몰랐어...」
				PRINTFORMW 「어쩌면 당신 것이기 때문일지도 모르지? 어떤 의미에서는 내게 대한 당신의 사랑이 액체로 형상화된 것 같아...」
			CASE 2
				PRINTFORMDW 파르시는 당신의 정액을 시무룩하게 마신다.
				PRINTFORMDW %BREAKENG(@"그것을 %HE_SHE(TARGET,1)%이 할 수 있는 만큼 빨리 삼킨 후, %HIS_HER(TARGET)%의 혀로 %HIS_HER(TARGET)%의 입안을 탐색하며 %HE_SHE(TARGET)%가 아무것도 놓치지 않았는지 확인한다.")%
				PRINTFORMW 「그냥 입안의 맛을 느끼려고 노력하는 것뿐이라고! 이걸 즐기거나 그런 건 전혀 없다고!」
			CASE 3
				PRINTFORMDW 파르시는 당신의 정액을 마신다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은(는) 맛을 음미하기 위해 잠시 동안 그것을 %HIS_HER(TARGET)%의 입안에서 휘젓다가 삼킨다.
				PRINTFORMW 「이거 맛이 점점 즐거워지는 것 같아...」
		ENDSELECT
	ELSE
		SELECTCASE K60_ATTITUDE()
			CASE 0, 1
				PRINTFORMW 「건배...」
				PRINTFORMDW 파르시는 마지못해 당신의 정액을 마신다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은 재빨리 그것을 삼키고 당신에게 얼굴을 찡그린다.
				PRINTFORMW 「입을 헹굴 만한 거 없어? 이 맛 정말 못 견디겠어.」
				PRINTFORMW 「당신이 아니었다면 전혀 이런 행동 안 했을 텐데...」
			CASE 2
				PRINTFORMDW 파씨는 저항하며 당신의 정액을 마신다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은/는 그것을 급히 삼키고 \@ CFLAG:K60EN_SEMEN_DRINKING != 2 ? 차갑게 미소 짓는다 # 당신을 노려본다 \@.
				IF CFLAG:K60EN_SEMEN_DRINKING != 2
					PRINTFORMW 「너를 위해 조금 남겨뒀어. 먹을래?」
					IF ABL:MASTER:精液中毒 >= 3
						CALL ASK_YN("파르시의 블러프를 호출한다", "절대로 안 돼")
						IF !RESULT
							PRINTFORMDW 왜 안 되지? 게다가 파르세는 네가 거부하면 위선자라고 부를 거야.
							PRINTFORMDW %HIS_HER(TARGET)%에게서 그것을 받아 마시고, 그녀를 비웃어 봐.
							EXP:MASTER:精液経験 += 3
							PRINTFORMDW 파시가 당신을 노려본다.
							PRINTFORML 「제기랄... 네가 실제로 그걸 할 줄은 몰랐어!」
							PRINTFORMW 「자기 정액을 마시는 자기애적인 인간이 어디 있어?!」
							CFLAG:K60EN_SEMEN_DRINKING = 2
						ELSE
							GOTO DAGA_KOTOWARU
						ENDIF
					ELSE
						$DAGA_KOTOWARU
						PRINTFORMDL 너는 통과할 거야.
						PRINTFORMDW 파르시가 당신을 향해 미소 짓는다.
						PRINTFORMW 「오? 왜 안 돼? 네가 나에게 마시길 원했잖아.」
						PRINTFORMW 「네 정액에 아무 문제 없어. 오히려 아주 맛있었어!」
						PRINTFORMDW %HE_SHE(TARGET,1)%은/는 연극적으로 입술을 핥는다.
						IF CFLAG:K60EN_SEMEN_DRINKING == 0
							PRINTFORMDW %HE_SHE(TARGET)%은(는) 당신의 정액을 마실 때마다 이것을 할 거야, 그렇지 %HE_SHE(TARGET)%?
							CFLAG:K60EN_SEMEN_DRINKING = 1
						ELSE
							PRINTFORMDW 당신은 정말로 %HE_SHE(TARGET)%가 매번 이렇게 하는 것에 지기 시작했군요.
						ENDIF
					ENDIF
				ELSE
					PRINTFORMW 「네가 자기 정액을 마셨다는 게 아직도 믿기지 않아.」
					PRINTFORMW 「너에게 너무 역겨워서 도저히 할 수 없는 퇴폐적인 형태 같은 건 정말 없겠지?」
					PRINTFORMDW %HIM_HER(TARGET)%를 보며 비웃는다. 당연히 없어.
					PRINTFORMDW 특히 그녀를 상대로 한 것이라면...
				ENDIF
			CASE 3
				PRINTFORMW 「좋지만, 그 후에 귀 마사지를 해줘야 할 거야.」
				PRINTFORMDW 파르시는 마지못해 당신의 정액을 마신다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은(는) %HE_SHE(TARGET)%이(가) 가능한 한 빨리 그것을 삼키고 당신에게 얼굴을 찡그린다.
				PRINTFORMW 「입을 헹굴 만한 게 있니? 이 맛 정말 못 견디겠어.」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
