RETURN RESULT

@M_KOJO_MESSAGE_COM_K60_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;Join Navelgazing
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			;PRINTFORMW
		CASE 1
			;Join Play
			;Only possible if the character has the [Childish] trait
			;▼遊ぶ［一緒に遊ぶ］
			;※[幼稚]持ちのみ
			;TFLAG:193,1=大いに盛り上がる,-1=あまり盛り上がらない
			;PRINTFORMW
		CASE 2
			;Join Meal
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			;PRINTFORMW
		CASE 3
			;Join Snack
			;Only possible for Rumia, Koishi, Yuyuko, Shion, and characters with the [Fairy] trait
			;▼つまみ食い［一緒につまみ食い］
			;※[妖精]持ちとルーミア、こいし、幽々子、紫苑のみ
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			;PRINTFORMW
		CASE 4
			;Join Cleaning
			;Only possible if the character has the [Cleaner] trait or [Smell Resistance] <= -1
			;▼掃除［掃除を手伝う］
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			;PRINTFORMW
		CASE 5
			;Join Exercising
			;Will not trigger for characters with [Musical Knowledge] (they will perform music instead)
			;▼運動［一緒に運動する］
			;※[音楽知識]持ちは除く（演奏になる）
			IF FIRSTTIME("JoinExercising")
				PRINTFORMDL 파씨는 순수한 살의에 찬 표정으로 복싱 자세를 취하고 허공에 잽을 날리고 있다%COND_STR(@"로", GROUPMATCH(K60_ATTITUDE(), 2, 3))%.
				SIF GROUPMATCH(K60_ATTITUDE(), 2, 3)
					PRINTFORMDL 그녀가 누구를 때리는 척하는지 궁금해한다. 부디 당신이 아니길 바라...
				SELECTCASE K60_ATTITUDE()
					;Loving
					CASE 0
						PRINTFORMW 「아, %K60_MASTER()%님. 그림자 복싱에 함께 하시겠어요?」
						CALL PRINT_STRW, @"「훌륭해. 이제 왼쪽 발을 ITALIC여에 놓고, 오른쪽 발을 ITALIC여에 놓아...」"
						;Nice, horny
					CASE 1
						PRINTFORML 「아, %K60_MASTER()%. 나의 그림자 복싱에 참여하고 싶으신가요?」
						PRINTFORMW 「걱정 마세요. 제가 시작하기 전에 그만두셔도 저는 기분 나쁘지 않아요. 사랑을 나누기엔 너무 지치셨으면 원치 않으니까요.」
						;Grumpy tsundere
					CASE 2
						PRINTFORML 「뭐 하는 거야? 가버려. 실수로 너를 때리고 싶지 않아.」
						PRINTFORMW 「그리고 내가 운동하려는 걸 자꾸 방해하면, 일부러 널 때릴지도 몰라.」
						PRINTFORMDW 당신은 Parsee를 무시하고 스스로 복싱 자세를 취하며 안전한 거리를 유지한다.
						PRINTFORMW 「내가 왜 애쓰는지 모르겠어...」
						;Fake nice
					CASE 3
						PRINTFORMW 「아, %K60_MASTER()%님. 제 그림자 복싱에 참여하시겠어요?」
						PRINTFORMW 「좋아요. 좀 더 운동을 하는 게 좋을 거예요.」
				ENDSELECT
			ELSE
				SELECTCASE K60_ATTITUDE()
					;Loving
					CASE 0, 3
						PRINTFORMDL 파르시는 상상 속의 상대에게 도발하며 코웃음을 친다.
						PRINTFORMDW 그녀는 정말 몰입하는 것 같다...
						;Nice, horny
					CASE 1
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML
							CASE 1
								PRINTFORML
							CASE 2
								PRINTFORML
						ENDSELECT
						;Grumpy tsundere
					CASE 2
						SELECTCASE RAND:4
							;This wouldn't be eraTohoTW without Jojokes, right?
							CASE 0
								PRINTFORMW 「%HIS_HER(TARGET)%의 눈에 엄지손가락을 박고, 밀어 넣은 뒤 뚫어버리겠어!」
								PRINTFORMDW 파르시는 상상 속 상대에게 사나운 오른손 훅을 날리며 혼잣말을 중얼거렸다.
							CASE 1
								PRINTFORML 「가장 미워하는 사람을 있는 힘껏 때린다고 상상해 보려고 노력한다.」
								PRINTFORMW 「나는 그것이 나 자신을 한계까지 몰아붙이고 더 좋은 운동을 하게 해준다고 생각한다.」
								SIF MARK:TARGET:反発刻印 >= 1
									PRINTFORMW 「아니, 그 사람은 당신이 아니에요. 다른 누군가죠. 분명 당신이 누가 그런 사람인지 알아낼 수 있을 거예요...」
							CASE 2
								PRINTFORMDW 당신은 자신의 자세가 맞는지 파르시에게 물으려고 잠시 멈추지만, 그녀는 당신의 말을 듣지 못했다. 그녀는 자신의 운동에 너무 몰두해 있었다.
								PRINTFORMW 「너 %PRINT_MALE("son of a bitch:bitch", TARGET)%... 왜 날 혼자 두지 않는 거야?! 왜 나 때문에 모든 걸 망치려고 하는 거야?!」
								PRINTFORMDW 파르시는 상상 속의 상대에게 온 힘을 다해 휘두르며 낮은 욕설을 중얼거렸다.
								PRINTFORMDW 당신은 그녀를 방해하지 않기로 결정하고 혼자 그림자 복싱을 다시 시작했다.
							CASE 3
								CALL PRINT_STR, @"「나는 당신에게 거절할 것이다!」"
								PRINTFORMDW 파시가 이를 악물고 거대한 왼손 훅으로 날아버린다.
								PRINTFORMDW 그녀가 무슨 뜻이었는지는 확신할 수 없지만, 꽤 멋져 보였다.
						ENDSELECT
				ENDSELECT
			ENDIF
		CASE 6
			;Join Reading
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			;PRINTFORMW
		CASE 7
			;Join Cooking / Join Eating
			;TFLAG:193: 2=Join Cooking, 0=Join Eating, 1=player is full so doesn't eat
			;▼料理［料理を手伝う］→［料理を分けてもらう］
			;TFLAG:193,2=料理を手伝う,0=作った料理を食べる,-1==MASTERはお腹が空いてなかった（食べる時）
			;PRINTFORMW
		CASE 8
			;Join Jamming / Join Accompaniment
			;Only possible if the character has [Musical Knowledge]. The type of performance depends on the value of that trait.
			;If [Musical Knowledge] is 1, the character will play an instrument. If it's 2, they will sing, and if it's 3, they will dance.
			;▼演奏［セッションする］or［伴奏する］
			;※[音楽知識]持ちのみ（TALENT:音楽知識で変化）
			;TALENT:音楽知識,1=演奏してる,2=歌ってる,3=踊ってる
			;TFLAG:193,1=ノリノリ,0=成功,-1=失敗,-2=楽器がなくて見てるだけ
			;PRINTFORMW
		CASE 9
			;Join Foraging
			;▼採集［採集を手伝う］
			;PRINTFORMW
		CASE 10
			;Join Fishing
			;▼釣り［一緒に釣りをする］
			;TFLAG:193,-1=釣り竿がなくて見てるだけ
			;todo write more
			$FISHING
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「♪～♪～♪～～♪♪♪～～～♪♪♪～♪♪♪～♪～～」
					PRINTFORMDW 파르시가 낚시를 하면서 노래를 흥얼거린다.
				CASE 1
					PRINTFORML 「%K60_MASTER()%은(는) "가라앉는 미끼"가 뭔지 알고 있나?」
					PRINTFORMW 「희귀한 종류의 물고기를 잡는 데 매우 효과적이라고 들었어.」
				CASE 2
					PRINTFORML 「또 로터를 얻지 않기를 정말 바란다.」
					PRINTFORMW 「누가 계속 저 안에 던지는 거야?!」
					PRINTFORMW 「아-아니, 나 아냐! 나는 내 섹스 토이를 처분했어-」
