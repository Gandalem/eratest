;Surrender
;360,身を任せる
;TCVAR:20(27=谷間を見せる 32=前から抱きつく 35=スカートの中を見せる 53=パイズリ 73=ぱふぱふ 77=乳を吸わせる 85=Ｖ挿入する 86=だいしゅきホールド 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ
;==================================================

@M_KOJO_MESSAGE_COM_K60_360
CALL M_KOJO_MESSAGE_COM_K60_360_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K60_360_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:[[パルスィ]]:K60ENC_SETTING_DOMINANCE == 1
		SELECTCASE K60_ATTITUDE()
			CASE 0, 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「좋은 %PRINT_MALE("boy", MASTER)%이야～」
						PRINTFORMDW 파르시가 미소 지으며 %PARSE("you")%의 머리를 쓰다듬는다.
						CALL HPH_PRINT, @"「그냥 뒤에 누워서 내가 기분 좋게 해 줄게 HPH」", "W"
					CASE 1
						PRINTFORML 「내가 주도권을 잡게 되는 게 정말 기분 좋지 않아?」
						PRINTFORMW 「그리고 네가 이렇게 행복해하고 있다는 걸 아는 게 더 기분이 좋아...」
					CASE 2
						PRINTFORMW 「하아... 너처럼 착한 %PRINT_MALE("boy", MASTER)%에게는 보상이 필요하지...」
						PRINTFORMDW 파르시는 사랑스럽게 미소 지으며 당신의 모든 곳에 키스하고, 특히 당신의 \@ IS_FEMALE(MASTER) ? %FSYN("chest")%와 %FSYN("crotch")% # %FSYN("crotch")% \@에 더 많은 주의를 기울인다.
						EXP:[[パルスィ]]:キス経験 += 3
						IF IS_FEMALE(MASTER)
							EXP:MASTER:Ｂ経験 += 1
							EXP:MASTER:レズ経験 += 3
							EXP:[[パルスィ]]:レズ経験 += 3
							SOURCE:MASTER:快Ｂ = 80
						ENDIF
						SOURCE:MASTER:快Ｃ = 80
				ENDSELECT
				;Grumpy tsundere
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML
					CASE 1
						PRINTFORML
					CASE 2
						PRINTFORML
				ENDSELECT
				;Fake nice
			CASE 3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML
					CASE 1
						PRINTFORML
					CASE 2
						PRINTFORML
				ENDSELECT
		ENDSELECT
	ELSEIF CFLAG:[[パルスィ]]:K60ENC_SETTING_DOMINANCE == 2
		;From Reverse, slight punctuation/grammar tweaks
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW 파르시는 미간을 찌푸린다.
				PRINTFORML 「네가 스스로를 몰아붙이고 있다는 건 나한테 좀 분명해...」
			CASE 1
				PRINTFORML 「도대체 무슨 소리를 하는 거야... 벌써 완전히 바보로 퇴행했어?」
				PRINTFORMW 「내 말은, 내가 뭘 하든 결국 넌 그걸 즐길 테니까. 이 돼지 같으니...」
			CASE 2
				PRINTFORML 「지금까지 이 모든 걸 참은 건 내가 바보 같았다.」
				PRINTFORMW 「너는 정말이지 변태구나. 타락자. 쓰레기.」
		ENDSELECT
	ELSE
		PRINTFORMDW K60ENC_SETTING_DOMINANCE에 유효하지 않은 값이 있습니다! 이것을 보고하세요!
	ENDIF
ENDIF
RETURN 1
