@M_KOJO_MESSAGE_SCOM_K60_60_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME("Earpicking")
		PRINTFORMDW %CALLNAME:[[パルスィ]]%는 귀파기를 %HIS_HER([[パルスィ]])%의 얼굴 가까이에 대고 살펴본다.
		SELECTCASE K60_ATTITUDE()
			CASE 0
				PRINTFORMW 「도대체 이걸로 뭘 하라는 거야? 설마 이걸 가지고 당신에게 저주를 걸게 만들고 싶은 건 아니겠지...」
			CASE 1
				PRINTFORMW 「도대체 이걸 나한테 뭘 시키려는 거야? 무슨 성인용품이라도 되는 거야?」
			CASE 2
				PRINTFORMW 「흥. 이게 무슨 못인지 잘 모르겠지만, 나한테 그것으로 저주를 내리게 하고 싶다면 기꺼이 들어줄 수 있어.」
			CASE 3
				PRINTFORMW 「도대체 이걸 가지고 나에게 뭘 하라는 거야?」
		ENDSELECT
		PRINTFORMDW 당신은 귀파기가 무엇이고 그것이 무엇에 사용되는지 설명한다. %CALLNAME:[[パルスィ]]%는 \@ GROUPMATCH(K60_ATTITUDE(), 2, 3) ? 눈썹을 찌푸린다 # 고개를 끄덕인다 \@.
		SELECTCASE K60_ATTITUDE()
			CASE 0
				PRINTFORMW 「알겠다.」
				$PARSEE_LOVE_LUST_EARPICKING
				PRINTFORMW 「이런 건 해본 적이 없지만, 배우려는 의지는 충분해요.」
				CALL M_KOJO_COLOR_K60_JEALOUS
				PRINTFORMW 「다른 %PRINT_MALE("guy", [[パルスィ]])%이 네 귀를 만지는 건 원치 않아-」
				CALL M_KOJO_COLOR_K60
				PRINTFORMDW %HE_SHE([[パルスィ]],1)%은(는) %HIMSELF_HERSELF([[パルスィ]])%를 자르고 %HIS_HER([[パルスィ]])% 입술을 깨문다.
			CASE 1
				PRINTFORML 「알겠다.」
				PRINTFORMDW %HE_SHE([[パルスィ]],1)%은(는) 조금 실망한 것 같다.
				GOTO PARSEE_LOVE_LUST_EARPICKING
			CASE 2
				PRINTFORMW 「오. 어떤 페티시 같은 거군. 깜짝 놀랐네.」
				PRINTFORMW 「좋아. 다른 불쌍한 %PRINT_MALE("guy", [[パルスィ]])%에게 신경 쓰게 하는 것보다는 나한테 짜증 내는 게 낫지.」
				PRINTFORMW 「하지만 난 그걸 사용하지 않을 거야...」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%는 귀파리를 바닥에 떨어뜨리고, 비웃으며 손톱을 꺼냈다.
			CASE 3
				CALL M_KOJO_COLOR_K60_JEALOUS
				PRINTFORMW 「자기 귀는 스스로 청소 못 해? 내가 하는 것보다 네가 훨씬 잘할 거라 확신해.」
				CALL M_KOJO_COLOR_K60
				PRINTFORMW 「다른 사람들이 해줄 때 편안하다고 말하는 건가요? 좋아요, 저도 한번 해보죠.」
		ENDSELECT
	ELSE
		SELECTCASE K60_ATTITUDE()
			;Loving
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW %CALLNAME:[[パルスィ]]%은 당신에게 미소 지으며 머리를 쓸어 넘기고, %HE_SHE([[パルスィ]])%는 당신의 귀를 청소한다.
					CASE 1
						PRINTFORMW 「자, 다 끝났어.」
						PRINTFORMDW %CALLNAME:[[パルスィ]]%가 몸을 숙여 당신의 뺨에 키스한다.
						PRINTFORMW 「이제 뒤집으면 내가 다른 쪽도 해줄게.」
					CASE 2
						PRINTFORMW 「음... 당신의 귀도 나머지 부분만큼 아름답군요.」
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「나도 저렇게 예쁜 귀가 있었으면...」
						CALL M_KOJO_COLOR_K60
				ENDSELECT
				;Nice, horny
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW %CALLNAME:[[パルスィ]]%은(는) %HIS_HER([[パルスィ]])% 자유로운 손으로 당신의 귀를 어루만지며 그것을 %HE_SHE([[パルスィ]])% 청소한다.
						CALL HPH_PRINT, @"「네 귀도 민감한지 궁금하네... 호호」", "W"
					CASE 1
						PRINTFORMDW %CALLNAME:[[パルスィ]]%의 자유로운 손이 당신의 엉덩이 쪽으로 향하다가 %HE_SHE([[パルスィ]])%는 얼굴을 붉히며 그것을 거두어들인다.
					CASE 2
						PRINTFORMW 「내가 다 하고 나서 내 귀 좀 청소해 줄 수 있어?」
						PRINTFORMDW %CALLNAME:[[パルスィ]]%의 얼굴이 붉어진다.
				ENDSELECT
				;Grumpy tsundere
			CASE 2
				SELECTCASE IFRAND("0TO2", 1, "3", !RAND:10)
					CASE 0
						PRINTFORMDW %CALLNAME:[[パルスィ]]%은 그 어느 때보다 더 심하게 얼굴을 찡그린다.
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「하시히메가 네 귀에 못을 박고 있는데 어떻게 이렇게 침착할 수 있어?!」
						PRINTFORMW 「크윽... 너의 담력이 너무 부럽다...」
						CALL M_KOJO_COLOR_K60
					CASE 1
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「네 귀가 내 것보다 훨씬 예쁘구나.」
						PRINTFORMW 「사람들이 너를 엘프라고 부르는 걸 감당하지 않아도 될 거라고 확신해.」
						PRINTFORMW 「어쩌면 나도 한번 잡아 당겨서 네 것도 내 것처럼 못생기고 뾰족하게 만들어 줄지도 모르지.」
						PRINTFORMW 「...아니, 그러면 안 되겠어. 너 너무 약해서 그냥 뽑아버릴 것 같거든.」
						PRINTFORMW 「그러면 하시히메에게 훼손당한 걸로 모두가 동정해 주겠지.」
						CALL M_KOJO_COLOR_K60_VERY_JEALOUS
						PRINTFORMW 「겐소쿄의 모든 %PRINT_MALE("guy", [[パルスィ]])%들이 그것을 더 좋아하려고 줄 서 있을 거라고 확신해...」
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORMW 「물론 네 더러운 마음에는 더러운 귀가 당연히 따르지.」
					CASE 3
						PRINTFORMW 「Oh...?」
						PRINTFORMDW %CALLNAME:[[パルスィ]]%는 앞으로 몸을 숙이고 당신의 귀 안을 들여다봤다.
						PRINTFORMW 「어머, 어머... 난 그걸 예상 못 했네.」
						PRINTFORMW 「난 네 두개골을 통과해서 다른 쪽 귀로 다 볼 수 있어.」
						PRINTFORMDW %HE_SHE([[パルスィ]],1)%는 비웃었다.
				ENDSELECT
				;Fake nice
			CASE 3
				SELECTCASE IFRAND("0", !TALENT:TARGET:恋慕 && !MARK:TARGET:快楽刻印 == 3, "1TO2", 1, 3, TALENT:TARGET:恋慕 || MARK:TARGET:快楽刻印 == 3)
					CASE 0
						PRINTFORML 「말해야겠는데, 너 귀가 아주 더럽구나.」
						PRINTFORMW 「사실 이렇게 더러운 귀를 가진 사람은 본 적이 없어. 혹시 무슨 병이라도 있는 거니?」
					CASE 1
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「당신의 귀는 정말 부드럽네...」
						CALL M_KOJO_COLOR_K60
					CASE 2
						PRINTFORMW 「닦을 만한 거 좀 있어?」
					CASE 3
						PRINTFORMW 「당신이 나를 그렇게 대했던 후에 내가 이걸 하게 해 줄 만큼 아직도 날 믿어 준다는 게 놀랍다.」
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「당신처럼 친절했으면 좋겠어...」
						CALL M_KOJO_COLOR_K60
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
