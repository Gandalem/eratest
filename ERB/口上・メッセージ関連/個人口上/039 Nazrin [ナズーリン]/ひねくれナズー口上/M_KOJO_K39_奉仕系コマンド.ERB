;==================================================
;144,放尿
;好きなコマンドだが持ちネタの少なさに絶望。間違いなく手抜き口上No.1
;==================================================

@M_KOJO_MESSAGE_COM_K39_144
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K39_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K39_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		IF RAND:3 == 0
			PRINTFORMW 「하아... 후우......」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「푸...우...우...」
		ELSE
			PRINTFORMW 「...음... 하아...」
		ENDIF
		IF RAND:3 == 0
			PRINTFORMDW 잠든 나즈린의 수직 틈에서 황금빛 액체가 흘러나오기 시작한다...
		ELSEIF RAND:2 == 0
			PRINTFORMDW 액체가 새어 나와 침구에 스며들고 커다란 얼룩을 만들었다...
		ELSE
			PRINTFORMDW 그녀의 자극받은 요도구에서 따뜻한 액체가 분출하며 방을 시큼한 향으로 가득 채운다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「...실례지만, 다시 한번 말씀해 주시겠어요?」
			PRINTFORMDW 당신은 나즈린에게 그녀가 소변 보는 것을 보고 싶다고 말하며 반복한다.
			PRINTFORML 「...하아. 뭐라 할 수 있겠어, 인간의 업보란 정말 대단하군.」
			PRINTFORMW 「그건 그렇고, 이게 당신의 애정 표현 중 하나라고 가정해도 될까요?」
			PRINTFORMW 물론, 당신은 대답했고 나즈린은 다시 한숨을 내쉰다.
			PRINTFORMW 「...뭐, 고통스럽지 않다면 괜찮겠지... 제기랄, 내가 왜 이런 사람의 연인이 되었는지 모르겠어...」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...미안하지만, 다시 한번 설명해 줄 수 있겠어?」
			PRINTFORMW 당신은 나즈린에게 그녀가 소변 보는 것을 볼 수 있는지 물으며 반복한다.
			PRINTFORML 「...하아. 이게 나를 죽을 만큼 당황스럽게 만들 거라는 걸 알고 있지, 안 그래?」
			;/むしろそれが目的ですが？
			PRINTFORMW 네가 긍정적으로 대답하면, 나즈린은 눈에 눈물을 머금고 너를 노려본다...
			PRINTFORMW 「흥~ 당신은 이걸 감사히 여겨야 할 거야...」
		ELSE
			PRINTFORMW 「...미안하지만 다시 말해줄래?」
			PRINTFORMW 당신은 나즈린에게 그녀가 소변 보는 것을 보고 싶다고 반복해서 말했다.
			PRINTFORMW 「...하아. 네가 그렇게 변태일 줄 몰랐어... 저렇게까지 가는 걸 보니 오히려 시원하다.」
			PRINTFORMW 「알겠어, 할게. 하지만 뭔가 중요한 걸 버리는 것 같아서 좀 그렇네...」
		ENDIF
		RETURN 1
	ENDIF
	;風呂場 というか、風呂場しか書けそうにない。そしてネタ切れ、恋慕と露出癖高い時の分岐誰か書いて
	IF BATHROOM()
		;恋慕
		IF TALENT:恋慕
			IF RAND:3 == 0
				PRINTFORMW 「아, 또? 으윽...」
				PRINTFORMDW 나즈린은 변기 앞에 쭈그리고 앉으며 배수구 쪽으로 돌아가는 것이 저항하는 듯하다...
			ELSEIF RAND:2 == 0
				PRINTFORMW 「흐읍... 크윽...~~!」
				PRINTFORMDW Nazrin이 소리 없는 비명을 지르자, 그녀의 요도에서 황금빛 액체가 분출되어 배수구로 작은 강을 만든다...
			ELSE
				PRINTFORMW 「으음... 이거 정말 최악의 페티시야...」
				PRINTFORMW 「정말 이걸 해야 해...? 응... 음, 크흡~~~~」
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「아, 또야? 흐음...」
				PRINTFORMDW 저항하는 듯한 표정으로, 나즈린은 배수구를 향해 쭈그리고 앉았다...
			ELSEIF RAND:2 == 0
				PRINTFORMW 「흡... 크윽...~~!」
				PRINTFORMDW 나즈린의 억눌린 비명과 함께 금빛 액체가 그녀의 요도에서 분출되어 배수구로 이어지는 작은 강을 만들었다...
			ELSE
				PRINTFORMW 「으음... 이건 정말 최악의 페티시야...」
				PRINTFORMW 「정말 이걸 해야 해...? 응... 음, 크하아~~」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
