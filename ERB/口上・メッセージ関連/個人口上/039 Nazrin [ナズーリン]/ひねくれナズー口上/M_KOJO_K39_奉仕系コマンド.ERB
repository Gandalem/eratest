@M_KOJO_MESSAGE_SCOM_K39_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K39_1_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K39_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;初めてチンコを間近で観察。必然的にクンニ→フェラの流れで発生することになる（先にフェラしてしまうとその時点で初めてチンコ観察フラグが立ってしまうため）
		IF CFLAG:1209 == 0
			PRINTFORMW 「후으, 아우, 아앙, 하아, 아... 이건...」
			PRINTFORMDW 그녀의 민감한 음핵을 당신이 마사지하는 동안, 나즈린은 그녀 앞에서 꿈틀거리는 당신의 남성기를 알아차린다.
			PRINTFORMDW 꿈결 같은 표정으로, 그녀는 거의 무의식적으로 그것에게 조심스럽게 손을 뻗는다.
			PRINTFORMDW 흥분한 자동 모드에서, 그녀는 당신의 거시기(cock)를 입에 넣고 빨기 시작한다...
			CALL HPH_PRINT,@"「음...츄, %FSYN("lips_gulp")%, %RANDKISS("suck")%, 후우... 음...! 푸, 아, %RANDKISS("kiss")%, 츄, %RANDKISS("suck")%, 하아...흐읍」","W"
			CFLAG:1209 = 1
		ELSE
			;フェラを選択して発生 クンニしてるところにナズが自発的にフェラ
			IF SELECTCOM == 81
				CALL HPH_PRINT,@"「후후, 하아~, 하, 내가 핥을게... 당신 것도... 후후훗, 여전히 크네~」","W"
				PRINTFORMDW 나즈린은 당신의 발기된 페니스를 향해 손을 뻗으며 계속해서 그녀의 손길을 이어갔다.
				CALL HPH_PRINT,@"「대가로 무언가를 주지... 하프츄, 하, %FSYN("lips_gulp")%, %RANDKISS("suck")%...」","W"
				;クンニを選択して発生 フェラしてもらってるところにMASTERが自発的にクンニ
			ELSE
				PRINTFORMW 「%RANDKISS("kiss")%, Nchu, Nn, %FSYN("lips_gulp")%, %RANDKISS("suck")%...」
				PRINTFORMDW 당신이 나즈린의 젊은 속으로 혀를 내밀자, 그녀는 간절하게 당신을 기쁘게 해주려고 최선을 다한다...
				CALL HPH_PRINT,@"「아우~HPH 잠깐만, 이대로는 너한테 보답할 수가 없어...HPH」","W"
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;フェラを選択して発生
	IF SELECTCOM == 81
		IF TALENT:恋慕
			PRINTFORMDW 나즈린의 귀여운 작은 곳을 음미하는 동안, 그녀는 보답으로 당신의 성기를 깨문다...
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「후, 하아~, 하, 내가 핥을게... 당신 것도...흐읍, 하, %FSYN("lips_gulp")%, %RANDKISS("suck")%...」","W"
				CALL HPH_PRINT,@"「하아~, 네가 나에게 하는 것을 너도 나에게 하니, 나는 그것이 좋아...후후」","W"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「「%RANDKISS("kiss")%... 흐음... 추우~, 하, 아우~ HPH 나도 기분이 좋아, %FSYN("lips_gulp")%... 추우우~...」","W"
				PRINTFORMDW 가끔 그녀는 당신의 애무를 거부하지 못하고 입에서 당신의 것을 내보이기도 하지만, 여전히 당신을 기쁘게 하려고 열심히 노력한다...
			ELSE
				CALL HPH_PRINT,@"「하아헵 하헵 하무... 주, %RANDKISS("kiss")%, 아아~헵」","W"
				CALL HPH_PRINT,@"「이건 좋지 않아... 섹스 말고는 아무것도 생각할 수가 없어... HPH」","W"
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「하아~, 아, 하안~, 하... 추, %RANDKISS("kiss")%, %RANDKISS("suck")%...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「후후, 나도 너에게 똑같이 해 줄게...」
			ELSE
				PRINTFORMW 「아... %FSYN("lips_gulp")%, 추... 추우~, 음...」
			ENDIF
		ENDIF
		RETURN 1
		;クンニを選択して発生
	ELSE
		;「慈しむように懸命に奉仕するナズリンの幼いワレメを舌で愛撫してやった...」
		IF TALENT:恋慕
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「아우~ 흐읍 잠깐만, 그렇게 하면 나 집중 못 해, 너 위해서 그것도 할 수 없어...흐읍」","L"
				PRINTFORMDW 그 자극은 너무 압도적이어서 나즈린은 당신의 손길 아래 몸을 떨며 입에서 남자의 성기를 놓는다...
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「후우~하프 냐, 추, 나푸, 푸, 후운~하프」","L"
				PRINTFORMDW 당신의 봉사에 응답하는 것처럼, 나즈린은 거칠게 그녀의 입안으로 당신의 성기를 삼킨다...
			ELSE
				CALL HPH_PRINT,@"「누후프 푸운~, %RANDKISS("suck")%, %RANDKISS("suck")%, 으윽...! %FSYN("lips_over")%~, 하아프 하흔프」","L"
				PRINTFORMDW 당신의 애무를 견딜 수 없자, 나즈린은 입으로 당신의 것을 잡은 채 거친 한숨을 내쉰다...
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「후훗, 후한~!! 하아, 음, 나도 핥고 싶었어...? 」
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「응, 쿠운~... 다운 보이, 하, 야아~... HPH」","W"
			ELSE
				PRINTFORMW 「흐읍-저기, 저기 하려고 하는데, 아아악~...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
