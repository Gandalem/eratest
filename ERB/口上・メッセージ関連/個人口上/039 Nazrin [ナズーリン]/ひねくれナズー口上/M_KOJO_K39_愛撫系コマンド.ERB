;41,Ｅマッサージャ
;ナズーリンはC敏感！
;C感覚と欲情による分岐の異様な数の多さは本体のEVENT_MESSAGE_COM.ERB準拠。つまり、寅の人が電マ大好きだということ
;==================================================

@M_KOJO_MESSAGE_COM_K39_41
CALL M_KOJO_MESSAGE_COM_K39_41_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K39_41_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;Ｃ感覚LV3未満＋欲情のPALAMLV3未満
		IF ABL:Ｃ感覚 < 3 && PALAM:欲情 < PALAMLV:3
			;「くすぐったそうに身をよじった…」
			PRINTFORMW 「...느낌...」
			;Ｃ感覚LV3未満＋欲情のPALAMLV3以上
		ELSEIF ABL:Ｃ感覚 < 3 && PALAM:欲情 >= PALAMLV:3
			;「自然と足を開き、快感を受け入れているようだ…」
			PRINTFORMW 「후우... 후우...」
			;Ｃ感覚LV3以上＋欲情のPALAMLV3未満
		ELSEIF ABL:Ｃ感覚 >= 3 && PALAM:欲情 < PALAMLV:3
			;「強い快感に頬を赤らめている…」
			PRINTFORMW 「응... 음...」
			;Ｃ感覚LV3以上＋欲情のPALAMLV3以上＋欲情のPALAMLV5未満
		ELSEIF ABL:Ｃ感覚 >= 3 && PALAM:欲情 >= PALAMLV:3 && PALAM:欲情 < PALAMLV:5
			;「息を荒げて快楽を貪っている…」
			PRINTFORMW 「하아... 하후우...」
			;Ｃ感覚LV3以上＋欲情のPALAMLV5以上
		ELSEIF ABL:Ｃ感覚 >= 3 && PALAM:欲情 >= PALAMLV:5
			;「びくびくと体を震わせ絶頂に達してしまいそうな様子だ…」
			PRINTFORMW 「크으음... 하아... 음...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;一緒に買いに行った
