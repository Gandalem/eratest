@M_KOJO_MESSAGE_COM_K39_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;欲情3以上
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「후우... 음...흐읍」","W"
			ELSEIF RAND:2 == 0
				PRINTFORMW 「하아... 하아... 흠...!」
			ELSE
				CALL HPH_PRINT,@"「하아... 음, 흠... 흐으읍」","W"
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음...... 후우...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 음......」
			ELSE
				PRINTFORMW 「하아... 음...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;※うふふ == 2のことも考えるとこのあたりのFIRSTTIMEは難しい
	;↑ほら、相手に押し倒されたときはまた別な心境になるじゃん？
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMDW 당신은 나즈린의 작은 몸을 부드럽게 쓸어내리자, 손이 닿는 것에 그녀가 살짝 움찔거리며 반응한다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;※どっちかに挿入、もう片方にバイブの状態で自慰や愛撫は四重絶頂狙いでよくやると思われる。留意しておきたい
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF RAND:3 == 0
				PRINTFORML 「하아, 후우, 하응... 하아, 아응...」
			ELSEIF RAND:2 == 0
				PRINTFORML 「아응, 아우, 후운... 하아, 응, 아아아...」
			ELSE
				PRINTFORML 「흐읍, 음, 아, 크으... 너, 하, 사정하는 거야...?」
			ENDIF
			PRINTFORMDW 당신은 나즈린을 열렬하게 애무하며, 당신의 페니스가 정액을 분출할 때마다 그녀가 반응하는 것을 즐긴다.
			RETURN 1
			;これで絶頂する
		ELSEIF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂
			PRINTFORMDW 당신의 애무와 쾌감으로 증폭된 듯, 그녀의 절정은 평소보다 나즈린에게 더 강하게 다가왔다.
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「말도 안 돼, 그냥 나를 어루만지는 것만으로... 하아우...!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「우아, 아아, 머리가... 음, 하얗게 변하는 것 같아, 우으음...」
			ELSE
				PRINTFORMW 「아우, 키스해줘, 제발! 아아응, 하, 하아앙...」
			ENDIF
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	;恋慕
	IF TALENT:恋慕
		;手淫してもらった直後
		IF PREVCOM == 80
			PRINTFORMD 호의를 갚기 위해, 당신은 나즈린에게 손을 뻗었다. 
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINTFORMD 촉촉하고 축축한 
			PRINTFORMDL 사적인 부위들을 많은 연모로 어루만진다...
			IF TALENT:恋人
				IF RAND:3 == 0
					CALL HPH_PRINT,@"「흐음, 아아...후프 푸, 후운, 그래서 네가 나에게 보답하려는 게 이거야?」","W"
				ELSEIF RAND:2 == 0
					PRINTFORML 「음... 후우, 당신 정말 잘하는구나... 나 이거 때문에 진짜 흥분하고 있어...」
					PRINTFORMW 「응... 음, 그리고 네가 이걸 하는 동안 우리가 키스한다면 훨씬 더 좋을 텐데～ 후후...」
				ELSE
					PRINTFORML 「후, 후우음~ 이게 너무 좋아, 이... 나 혼자서는 도저히 못 할 거야...」
					PRINTFORMW 「사랑하고 사랑받는 것, 음! 다들 말하듯이... 후후...」
				ENDIF
				;恋人なし
				;/ハイパー手抜き
			ELSE
				IF RAND:3 == 0
					CALL HPH_PRINT,@"「흐음, 아아...후프 푸, 후운, 그래서 네가 나에게 보답하려는 게 이거야?」","W"
				ELSEIF RAND:2 == 0
					PRINTFORML 「음... 후우, 당신 정말 잘하는구나... 나 이거 때문에 진짜 흥분하고 있어...」
					PRINTFORMW 「응... 음, 그리고 네가 이걸 하는 동안 우리가 키스한다면 훨씬 더 좋을 텐데～ 후후...」
				ELSE
					PRINTFORML 「후, 후우음~ 이게 너무 좋아, 이... 나 혼자서는 도저히 못 할 거야...」
					PRINTFORMW 「사랑하고 사랑받는 것, 음! 다들 말하듯이... 후후...」
				ENDIF
			ENDIF
			;これで絶頂する&ランダム1/2
			;※ランダム付けとかないと能力伸びてきたら毎回絶頂してこればっかり出るからね
		ELSEIF (NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂) && RAND:2 == 0
			;キスもした
			IF RAND:2 == 0 && EXP_UP(27,TARGET)
				IF RAND:2 == 0
					PRINTFORML 「음, 흐윽... %RANDKISS("kiss")%, 후아앙, 아, 쿠우우!」
					PRINTFORMDW 당신의 애무의 강도를 견디지 못하고 나즈린은 자신도 모르게 입을 떼며 유혹적인 신음을 흘렸다...
				ELSE
					PRINTFORML 「후무, 쪽... 음, 응아앙, %TOLOWER(FSYN("lips_muffle"))%!」
					PRINTFORMDW Nazrin은 당신의 끝없는 애정 공세에 흥분하여 몸을 떨지만 입술을 당신으로부터 떼지 않는다...
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「아, 바로 거기, 아, 굉장해! 야한, 하우...!」
					PRINTFORMDW 나즈린의 몸은 당신의 애무에 흥분이 점점 더 고조되면서 점차 더욱 휘어진다...
				ELSE
					CALL HPH_PRINT,@"「아, 하아앙, 그곳, 너무 심해! 아우안~ 나 갈 것 같아... 흐프」","L"
					PRINTFORMDW 당신의 손가락 움직임 하나하나에 나즈린은 점점 더 흥분하며 과장된 떨림을 보인다...
				ENDIF
			ENDIF
			;前のコマンドが手淫以外で絶頂もしなかった
		ELSE
			;キスもした
			IF RAND:2 == 0 && EXP_UP(27,TARGET)
				IF RAND:2 == 0
					PRINTFORML 「응츄우...후우... 음프...」
					PRINTFORMDW 그녀에게 키스하는 동안, 당신은 나즈린의 작은 몸 위로 손을 더듬으며 그녀의 모든 민감한 부위를 애태운다...
				ELSE
					PRINTFORML 「츄우... 하아～ 후후... 음... 이거 좋아, 더 줘...」
					PRINTFORMDW 당신의 애무와 키스에 몸을 맡긴 나즈린의 얼굴이 만족감으로 풀어졌다...
				ENDIF
			ELSE
				IF RAND:5 == 0
					CALL HPH_PRINT,@"「하아, 아아앙... 아, 바로 거기... 우후우웅~헵ㅎ」","L"
					PRINTFORMDW 그녀의 민감한 곳을 괴롭히자, 나즈린은 감탄스러운 신음을 참지 못한다...
				ELSEIF RAND:4 == 0
					PRINTFORML 「후우... 오온, 네가 나를 만지는 방식이 정말, 음, 사랑스러워... 흠프!」
					PRINTFORMDW Nazrin은 당신의 애무에 응하며 얼굴을 따라 손가락으로 부드럽게 쓸어내린다...
				ELSEIF RAND:3 == 0
					PRINTFORMW 「후우음... 리, 맞지! 바로 거기, 더 만져봐...!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「응... 흐윽, 바로 거기야... 만져봐, 주물러 봐, 애태워줘...!」
				ELSE
					CALL HPH_PRINT,@"「후후~ 당신이, 흠흥 나를 만지면, 정말 굉장한 기분이 들어...」","W"
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
		;恋慕なし
	ELSE
		IF RAND:8 == 0
			PRINTFORML 「아쿠, 후우...」
			PRINTFORMW 「후우, 후우... 나를 계속 만지고 싶다면 괜찮아... 알잖아...?」
		ELSEIF RAND:7 == 0
			PRINTFORMW 「음~ 후후... 네 손은 아주 못된 짓을 할 줄 알잖아, 그렇지 않아...?」
		ELSEIF RAND:6 == 0
			PRINTFORMW 「응... 네가 이렇게 해줄 때 좋아, 사랑받는 기분이 들어...」
		ELSEIF RAND:5 == 0
			PRINTFORMDW 네 손가락이 민감한 곳을 만날 때마다, 나즈린은 뜨겁고 달콤한 숨을 내쉰다...
		ELSEIF RAND:4 == 0
			PRINTFORMW 「흐응... 후우음... 아하하, 그 부분, 간지러워...♪」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「쿠우!? ...후후. ...꽤 대담하네, 그렇지~ 아우운!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「히아안~ ...흠, 여기 약해졌어, 아쿠우~!」
		ELSE
			PRINTFORMW 「아, 하우... 야안, 아...」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
