@M_KOJO_MESSAGE_COM_K39_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;欲情3以上　※で、地の文にクリトリス吸い上げが入る
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「크윽... 우응흥...흐읍」","W"
			ELSEIF RAND:2 == 0
				PRINTFORMW 「하아... 하아... 킁!」
			ELSE
				CALL HPH_PRINT,@"「푸우... 응, 으응흐흑」","W"
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「하아... 아, 후우...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 음...」
			ELSE
				PRINTFORMW 「하후... 음...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「...부디 그렇게 많이 쳐다보지 말아줘... 나도 부끄럽단 말이야...」
		PRINTFORMW 「흥...! 하안, 핥고 있네... 아...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;/汚れ無視ってどうやって取るんだろう
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:112 == 1
			PRINTFORMDL 네가 아까 그녀에게 주입했던 정액이 나즈린의 애액과 뒤섞여 그녀의 외음부에서 넘쳐흐른다...
			IF RAND:3 == 0 && ABL:精液中毒 >= 3
				PRINTFORML 「아... 당신의 정액이, 너무 많이 흘러 나오고 있네...」
				PRINTFORMDW 나즈린은 눈에 아련한 빛을 담고 그녀에게서 떨어지는 정액을 응시했다...
			ELSEIF RAND:2 == 0
				PRINTFORMW 「후후... 내 것과 섞이면 정말 더럽게 맛날 거라고 장담해...」
			ELSE
				PRINTFORMW 「아아... 나에게 더 많이 부어주세요...」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:Ｃ絶頂
		;欲情3以上　※で、地の文にクリトリス吸い上げが入る
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「히유~?! 저, 그 부분 빨지 마아—! 아우우~핫프」","L"
				PRINTFORMDW 당신은 나즈린의 통통하고 부어오른 봉우리를 끊임없이 혀로 쓸며 그녀의 가장 민감한 부분을 괴롭힌다.
				CALL HPH_PRINT,@"「우아아, 스-스톱빗, 나 녹고 있어~하프!!」","W"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「아우우! 나, 나 약해졌어——히우우~! 하프!」","L"
				PRINTFORMDW 당신은 나즈린의 클리토스를 입에 물고, 그녀의 온몸이 움찔하며 골반을 들썩인다.
			ELSE
				CALL HPH_PRINT,@"「히유~! ...후아안~! 거기 없어~ 안 돼... 야아안...킄」","L"
				PRINTFORMDW  네가 그녀의 음핵을 혀로 핥자, 나즈린은 격렬한 황홀경 속에서 미친 듯이 비명을 질렀다...
			ENDIF
		ELSE
			IF RAND:2 == 0
				CALL HPH_PRINT,@"「...안 돼... 갈 거야, 갈 거야아~! ...후프」","W"
			ELSE
				PRINTFORML 「~~응?!!」
				PRINTFORMDW 약점 부위에 느껴지는 격렬한 쾌감에 기습당하자, 자극이 나즈린의 감각을 압도하며 그녀는 입을 벌리고 말을 잇지 못했다...
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;欲情3以上
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:5 == 0
				PRINTFORML 당신은 나즈린의 보지를 삼키며 그녀의 연모액을 빨아들인다...
				PRINTFORMW 「후우... 후훈... 그렇게 크게 소리 내서 빠는 게... 정말 흥분돼...」
			ELSEIF RAND:4 == 0
				CALL HPH_PRINT,@"「아우~...흐읍 스토, 그만해~~! 네 혀로 나를 빨고 있잖아...」","L"
				PRINTFORMDW 나즈린의 역하게 달콤한 신음을 들은 후, 당신은 태도를 바꿔 그녀의 치골 부위를 혀로 덮는다...
				CALL HPH_PRINT,@"「우우~...♪ 안 돼, 그렇게 혀를 돌리는 거 그만둬, 이잇...헉」","W"
			ELSEIF RAND:3 == 0
				CALL HPH_PRINT,@"「아... 후우~...흐읍 이렇게 나를 핥을 때, 좋아...」","L"
				PRINTFORMW 「느껴져, 히우~! 마치 네가 내가 쾌락에 미쳐버릴 때까지 멈추지 않겠다고 말하는 것 같아...♪」
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「아, 쿠~훈!! 나 여기 있어, 민감하니까 좀 부드럽게 해줘, 쿠우~흐읍!」","L"
				CALL HPH_PRINT,@"「아앙~ 나 방금 말했잖아, 그렇게 세게 빨지 마! 쿠히이~! 아앙~후파 우아, 아하안~후파」","W"
				PRINTFORML 
				CALL HPH_PRINT,@"「하아... 하은... 정말 못되게 구는구나......흐흑」","L"
				PRINTFORMDW 입을 뒤로 당기면, 나즈린의 부풀어 오른 질이 전부 부어오르고 꿈틀거리며 고동치는 것이 보인다...
			ELSE
				PRINTFORML 「응응! 거기, 바로 거기에 계속 빨아들여... 하아아앗～!」
				PRINTFORMDW 명령을 따르고 그녀의 클리토스를 더 세게 빨아들이자, 나즈린은 떨며 몸을 비튼다...
			ENDIF
		ELSE
			IF RAND:5 == 0
				PRINTFORML 「쿠우... 응... 하아... 아앙~...」
				PRINTFORMDW 네 혀가 그녀의 질을 스칠 때마다 나즈린은 작은 숨을 내쉰다.
				IF PALAM:潤滑 >= PALAMLV:2
					PRINTFORML 「젠장... 전희는 이제 그만해... 이리 와봐. 흠흥...」
					PRINTFORMDW 나즈린의 질 입구에서 걸쭉한 꿀이 넘쳐흐르며 당신을 받아들일 준비가 되어 있었다...
