;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:搾乳機
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 
			RETURN 1
		;不埒3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;解除
	ELSE
		PRINTFORMW
	ENDIF
ENDIF
RETURN 1

