;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K39_44
CALL M_KOJO_MESSAGE_COM_K39_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K39_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;装着
		IF TEQUIP:バイブ
			;直前までセックス
			IF TCVAR:100 == PLAYER
				;「%CALLNAME:TARGET%からペニスを引き抜くと先程まで犯していた\@ TALENT:体型 < 0 ? 幼いワレメ # 秘裂 \@にバイブをあてがい一気に挿入した」
				;EXP:Ｖ経験 > 100　%CALLNAME:TARGET%は、すぐさまバイブのもたらす快感にとろけ\@ TALENT:体型 < 0 ? 可愛らしい # 艶っぽい \@吐息を漏らし始めた…
				;EXP:Ｖ経験 > 20　%CALLNAME:TARGET%はバイブのもたらす快感に息を荒げている…
				;　　　　　　　　%CALLNAME:TARGET%は不慣れなバイブの刺激に身をよじらせている…
				;それ以外（普通に挿入）
			ELSE
				;Ｖ経験40以上　バイブの擦れる感触に体を震わせ熱い吐息をつい
				;Ｖ経験20以上　バイブの擦れる感触に身をよじらせ愛液を滲ませて
				;それ以外　　　バイブの擦れる感触に肉襞をひくつかせ
			ENDIF
			;解除
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;一緒に買いに行った
		IF GETBIT(CFLAG:1003,4)
			PRINTFORMW 「아... 그날 사던 거...」
			;Ｖ経験20以下
			IF EXP:Ｖ経験 <= 20
				PRINTFORMW 「크, 우으윽... 생각했던 대로 너무 커, 내 보지에~...!」
			ELSE
				CALL HPH_PRINT,@"「후, 우으음...큭 이 느낌, 너무 좋아...」","L"
				CALL HPH_PRINT,@"「역시, 상인이 말한 그대로군...큭」","W"
				PRINTFORMDW 진동기와의 첫 경험에 빠르게 적응하며, 나즈린의 표정은 순식간에 황홀경으로 풀린다...
			ENDIF
			RETURN 1
			;一緒に買ってない
		ELSE
			;Ｖ経験20以下
			IF EXP:Ｖ経験 <= 20
				PRINTFORML 「우와... 저런 걸 꺼내는 게 정상인지 모르겠어...」
				PRINTFORMDW 나즈린은 당신이 진동기를 천천히 삽입하면서 그녀의 연모즙으로 코팅하는 것을 확인하자 약간 짜증 난 듯 중얼거렸다...
				PRINTFORMW 「크으, 음... 더 중요한 건, 이거 내 몸에는 좀 큰 것 같아...!」
			ELSE
				PRINTFORML 「우와, 굉장해... 그런 걸 대체 어디서 산 거야?」
				PRINTFORMDW Nazrin은 당신이 진동기를 조심스럽게 삽입하는 것을 호기심 어린 눈으로 지켜보며, 먼저 연모의 애액을 발라주는지 확인한다...
				CALL HPH_PRINT,@"「후, 으음...하아 이쪽은, 아마시...」","L"
				PRINTFORMDW 진동기와의 첫 경험에 빠르게 적응하며, 나즈린의 표정은 순식간에 황홀경으로 풀린다...
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;恋慕
		IF TALENT:恋慕
			;直前までセックス
			IF TCVAR:100 == PLAYER
				;%CALLNAME:TARGET%からペニスを引き抜くと先程まで犯していた\@ TALENT:体型 < 0 ? 幼いワレメ # 秘裂 \@にバイブをあてがい一気に挿入した
				;Ｖ中出しの直後
				IF TCVAR:112 == 1
					IF RAND:2 == 0
						PRINTFORMDL %BREAKENG(@"네가 그녀의 질에 정액으로 가득 찬 진동기를 밀어 넣자 나즈린의 얼굴은 편안해지고 뜨거운 한숨을 내뱉는다.")%
						CALL HPH_PRINT,@"「음~ 후후... 막으려고 한다니...? 정말 나를 임신시키고 싶구나, 그렇지... HPH」","W"
					ELSE
						CALL HPH_PRINT,@"「후후... 내 보지가, 하아, 네 정액으로 가득 차있어...큭」","L"
						PRINTFORMDW 나즈린은 자신의 안에 엄청난 양의 정액이 가득 찬 느낌에 만족스러운 한숨을 내쉰다.
					ENDIF
					;Ｖ経験100より大
					;「%CALLNAME:TARGET%は一瞬抗議するような視線を投げかけたが、すぐさまバイブのもたらす快感にとろけ\@ TALENT:体型 < 0 ? 可愛らしい # 艶っぽい \@嬌声をあげ始めた…」
				ELSEIF EXP:Ｖ経験 > 100
					IF RAND:2 == 0
						CALL HPH_PRINT,@"「오노호오, 전부 연결하는 거야... 아하아~ HPH」","L"
						PRINTFORMDW 네가 그녀의 잘 다듬어진 살 구멍에서 거시기(cock)를 빼내고 진동기(vibrator)를 박아 넣자, 나즈린은 기쁨에 찬 놀라움의 비명을 지른다...
					ELSE
						CALL HPH_PRINT,@"「오노호오오우, 하지만 %MASTERNAME:39%가 좋지만, %MASTERNAME:39%의 것이 더 나아... HPH」","L"
						PRINTFORMDW 나즈린의 보지가 당신과 교미하기를 애원하고 있지만, 그것은 즐겁게 바이브레이터를 삼킨다...
					ENDIF
					;Ｖ経験20より大
				ELSEIF EXP:Ｖ経験 > 20
					IF RAND:2 == 0
						CALL HPH_PRINT,@"「아하아... 아-안 돼, 네 것보다 훨씬 나아... 아, 야아아...흐읍」","L"
						PRINTFORMDW 네즈린의 약간 실망한 얼굴은 당신이 페니스 대신 바이브를 제자리에 넣었을 때 순식간에 쾌감으로 녹아내린다...
					ELSE
						CALL HPH_PRINT,@"「아... 왜 멈추는 거야, 흐응, 하우...헵」","L"
						PRINTFORMDW %BREAKENG(@"너는 그녀의 구멍에서 네 성기를 빼고 진동기로 대체하고, 나즈린은 다른 종류의 쾌감 속에서 몸을 비틀기 시작한다...")%
					ENDIF
					;Ｖ経験20以下
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「흐으윽... 이, 이런 것보다는 당신이 곁에 있는 게 더 좋아요...」
						PRINTFORMDW 나즈린의 힘겨운 숨소리는 아직 바이브레이터라는 낯선 감각에 익숙하지 않다는 신호처럼 보인다...
					ELSE
						PRINTFORML 「후구우... 네 것이 벌써 나에게 너무 크고, 이것은 정말 말도 안 돼...!」
						PRINTFORMDW 당신이 바이브레이터를 Nazrin의 꽉 조이는 작은 보지에 밀어 넣자, 그녀는 고통스럽게 신음했다...
					ENDIF
				ENDIF
				;それ以外（普通に挿入）
			ELSE
				;Ｖ経験40以上
				IF EXP:Ｖ経験 >= 40
					;「バイブの擦れる感触に陶酔しきった吐息をついている…」
					IF RAND:5 == 0
						PRINTFORML 「후후... 이제 그걸로 나를 가지고 놀 생각이야?」
						CALL HPH_PRINT,@"「크으... 아아... 음프흐햣 이것은 정말이지... 음으으헵」","W"
						PRINTFORMDW 나즈린은 진동기가 자신의 몸속으로 들어오는 감각에 기쁨에 차 골반을 흔들며 즐거운 비명을 질렀다.
					ELSEIF RAND:4 == 0
						CALL HPH_PRINT,@"「후, 후으으...흐읍 안쪽에 있어, 하아, 하아앙...흐읍」","L"
						PRINTFORMDW 진동기가 안으로 밀고 들어오자, 나즈린의 혀가 축 늘어지며 그녀는 연달아 신음했다...
					ELSEIF RAND:3 == 0
						CALL HPH_PRINT,@"「우으음... 나한테는 좀 큰 것 같아... 하아... 흐읍 잠시만 쉬게 해줘... 흐읍」","L"
						PRINTFORMDW 그녀의 말에도 불구하고, 나즈린의 작은 구멍이 바이브레이터를 삼키고, 사랑의 체액으로 행복하게 흘러내린다...
					ELSEIF RAND:2 == 0
						PRINTFORML 「생각했던 대로 네 게 훨씬 낫네... 그렇지 않아?」
						CALL HPH_PRINT,@"「그리고 이거... 후우... 싫다는 건 아니거든, 그치만... 하프」","W"
					ELSE
						PRINTFORML 「흐음... 이건 여전히 좀 이상한 것 같지만... 그래도 꽤 기분이 좋네...」
						CALL HPH_PRINT,@"「아우...흐읍 이 일 때문에 머리가 제대로 돌아가지 않아...흐읍」","W"
					ENDIF
					;Ｖ経験20以上
				ELSEIF EXP:Ｖ経験 >= 20
					;「バイブの擦れる感触に身をよじらせ愛液を滲ませてている…」
					IF RAND:2 == 0
						PRINTFORML 「우으, 또... 싫은 건 아닌데 네 게 쓰면 훨씬 좋거든... 안 돼?」
