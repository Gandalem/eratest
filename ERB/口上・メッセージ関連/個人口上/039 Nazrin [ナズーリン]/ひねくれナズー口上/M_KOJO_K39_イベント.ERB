						PRINTFORML 「Hm... It's you. Yeah, well, it's not a good time to go in my room at the moment.」
						PRINTFORMW 「I won't bother explaining, because it's a pain in the ass.」
					ENDIF
				;台所
				CASE P111台所
					SIF MAIN_MAP != 1 ;can't access this outside
						GOTO END4
					IF RAND:3 == 0 
