					ELSEIF RAND:2 == 0 
						PRINTFORMW 「Hm, are you here to get a snack?」
					ELSE
						PRINTFORMW 「Oh hey, it's you. Are you planning on making something?」
					ENDIF
				;ナズ私室
				CASE P113ナズーリン私室
					SIF MAIN_MAP != 1 ;can't access this outside
						GOTO END4
					;好感度500以上でランダム２つ追加、うふふ経験済みでランダム3つ追加
					IF RAND:8 == 0 && (CFLAG:1200 == 1 || CFLAG:1200 == 2)
						PRINTFORML 「...Look who's here.」
						PRINTFORMW 「Are you perhaps in the mood again?」
					ELSEIF RAND:7 == 0 && (CFLAG:1200 == 1 || CFLAG:1200 == 2)
						PRINTFORML 「Hm... So it's you.」
						PRINTFORMW 「I was just about to sit back and relax... Mind giving me some company?」
					ELSEIF RAND:6 == 0 && (CFLAG:1200 == 1 || CFLAG:1200 == 2)
						PRINTFORML 「Oh look, seems you beat me here.」
						PRINTFORMW 「...Wanna do it?」
					
					ELSEIF RAND:9 == 0 && CFLAG:2 >= 500
						PRINTFORMW 「Oh hey, did you need me for something?」
						PRINTFORMW 「Wait a minute, let me just get this cleaned up first...」
					;◆
					ELSEIF RAND:8 == 0 && CFLAG:2 >= 500
						PRINTFORMW 「You do know that this is my room, right...」
						PRINTFORMW 「What, I'm not implying that you should leave. It's fine if you stay and relax a little.」
					;◆
					ELSEIF RAND:7 == 0
						PRINTFORMW 「Huh. Why are you in my room?」
					;◆
					ELSEIF RAND:6 == 0
						PRINTFORMW 「Oh hey, did you need something from my room?」
					ELSEIF RAND:5 == 0 
						PRINTFORMW 「Oh hey, are you here to clean?」
						;前回ネズミと話していた
						IF PREVCOM == 420
							PRINTFORML 「...Oh, I bet you were speaking with the mice. Were you looking for someone?」
						ENDIF
					ELSEIF RAND:4 == 0 
						PRINTFORMW 「...You know, I don't like it when people enter my room without permission.」
					ELSEIF RAND:3 == 0 
						PRINTFORMW 「Hmー? Ah, it's you.」
					ELSEIF RAND:2 == 0
						PRINTFORML 「Hm...it's you.」
						PRINTFORMW 「What do you want?」
					ELSE
						PRINTFORML 「Ah, are you cleaning?」
						;汚れ度合いで分岐
						SELECTCASE YOGORE:(CFLAG:MASTER:現在位置)
							;清潔度:高
							CASE IS < 500
								PRINTFORMW 「Even mice have a preference for clean rooms, I'll have you know.」
							;清潔度:中
							CASE IS < 2000
								PRINTFORMW 「Ah, y'see... I was just feeding the little ones earlier.」
							;清潔度:低
							CASE IS < 5000
								PRINTFORML 「...Yeah, the little ones had a major field day in here earlier.」
								PRINTFORMW 「This and this are no longer useful, can you toss them out for me?」
							;ゴミの山
							CASEELSE
								PRINTFORML 「...Just look at this wreck. I take my eyes off my room for just a little and this is what I get.」
								PRINTFORML 「I'll leave the cleanup to you, since you're the professional.」
								PRINTFORMDW This one looks like it's going to be a pretty big job...
								;/ぱんつ発見のチャンス！
						ENDSELECT
					ENDIF
				;◆離れ（あなた私室）
				CASE P119離れ
					SIF MAIN_MAP != 1 ;can't access this outside
						GOTO END4
					PRINTFORML 「I'll go ahead and let myself in, pardon the intrusion.」
				;他
				CASEELSE
					$END4
					;◆
					IF RAND:7 == 0
						PRINTFORMW 「Oh hey, thanks for your hard work.」
						PRINTFORMW 「...No, I just happened to stop by. I don't need anything in particular.」
					;◆
					ELSEIF RAND:6 == 0
						PRINTFORMW 「Hey hey, what a coincidence.」
						PRINTFORMW 「Well, I suppose the Myouren temple is so small that it's common to meet up somewhere else.」
					ELSEIF RAND:5 == 0 
						PRINTFORMW 「Oh, I seem to be seeing you a lot these days.」
					ELSEIF RAND:4 == 0 
						PRINTFORML 「...」
						PRINTFORMW When your eyes meet hers, she turns away with a huff.
					ELSEIF RAND:3 == 0 
						PRINTFORML 「...」
						PRINTFORMDW Nazrin's off by herself, with a book spread open in front of her...
					ELSEIF RAND:2 == 0 
						PRINTFORMW 「Thanks for always cleaning up.」
					;/星ちゃん失くしすぎ
					ELSE
						PRINTFORML 「Hmm. Please deliver this to my Master.」
						PRINTFORM 「What is it? Ah, it's just some 
						IF RAND:5 == 0 
							PRINTFORMW documents that went missing.」
						ELSEIF RAND:4 == 0 
							PRINTFORMW materials that went missing.」
						ELSEIF RAND:3 == 0 
							PRINTFORMW sūtras that went missing.」
						ELSEIF RAND:2 == 0 
							PRINTFORMW record books that went missing.」
						ELSE
							PRINTFORMW consultation forms that went missing..」
						ENDIF
						;星ちゃんが恋慕かつナズが恋人でない
						SIF TALENT:[[星]]:恋慕 && TALENT:恋人 == 0
							PRINTFORMW 「...It makes more sense for you to make the delivery, so just take it already.」
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
