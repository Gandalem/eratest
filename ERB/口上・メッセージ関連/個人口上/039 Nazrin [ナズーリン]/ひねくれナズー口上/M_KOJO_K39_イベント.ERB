	;/告白し返すために告白を断る。その発想はなかった。こぁろだにナズ口上をうpしてくれた人に感謝
	ELSEIF RESULT == 2
		;告白し返しフラグを立てる
		CFLAG:1213 = 1
		;告白成功フラグを立てる
		TFLAG:193 = 1
		;告白口上にジャンプ
		JUMP M_KOJO_MESSAGE_COM_K39_352_1
