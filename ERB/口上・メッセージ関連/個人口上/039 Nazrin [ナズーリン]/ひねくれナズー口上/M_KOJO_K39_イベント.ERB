		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:LOCAL:ブチギレ
			PRINTFORMW 「...음.」
			;恋人かつランダム1/2
		ELSEIF TALENT:恋人 && RAND:2 == 0
			;◆
			IF RAND:4 == 0
				PRINTFORMW 「수고했어, 나중에 봐.」
				;◆
			ELSEIF RAND:3 == 0
				PRINTFORMW 「일하고 있어? 끝나면 나한테 소리쳐도 돼.」
			ELSEIF RAND:2 == 0
				PRINTFORML 「Mn...」
				PRINTFORMDW 당신은 그녀의 머리를 쓰다듬으며 지나가고, 나즈린은 부끄러운 듯 고개를 돌린다.
			ELSE
				PRINTFORMDW 나즈린은 당신의 목례에 희미한 미소로 응답했다.
			ENDIF
		ELSE
			;MASTERの気力が0
			IF BASE:MASTER:気力 <= 0
				PRINTFORMW 「당신 지쳐 보이는데, 잠시 쉬는 게 어때?」
			ELSE
				;◆
				IF RAND:5 == 0
					PRINTFORML 
					PRINTFORML 「아, 안녕.」
					PRINTFORMDL 나즈린은 손에 어떤 막대 같은 것을 들고 무언가를 찾고 있는 것 같다.
					IF TALENT:恋慕 && RAND:2 == 0
						PRINTFORMW 
						PRINTFORMDL 그녀는 당신에게서 시선을 돌리고 다시 손에 집중하며, 표정이 즉시 찌푸려졌다.
						PRINTFORMDW ...왜냐하면 그 지팡이가 계속 당신 쪽을 가리키고 있기 때문이다.
					ENDIF
				ELSEIF RAND:4 == 0
					PRINTFORML 
					PRINTFORMDL 나즈린은 손을 들어 당신의 인사에 응답한다.
					;◆
				ELSEIF RAND:3 == 0
					PRINTFORML 
					PRINTFORML 「오, 수고했군.」
					IF TALENT:恋慕 && RAND:2 == 0
						PRINTFORMW 
						PRINTFORMDL 나즈린은 한동안 당신의 뒷모습을 응시한다.
						PRINTFORML 
						PRINTFORMW 「...잠깐, 내가 대체 뭘 하고 있는 거지...」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMDW 당신이 그녀에게 고개를 끄덕이자 나즈린의 눈썹이 살짝 올라갔다.
				ELSE
					PRINTFORML 「Mn.」
					PRINTFORMDW 나즈린은 당신의 활쏘기에 살짝 놀라 반응했다.
				ENDIF
			ENDIF
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
