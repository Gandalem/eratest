								;清潔度:低
							CASE IS < 5000
								PRINTFORML 「...응, 애들이 여기에서 아까 아주 신나게 놀았어.」
								PRINTFORMW 「이거랑 이것은 더 이상 쓸모가 없으니 버려줄 수 있겠니?」
								;ゴミの山
							CASEELSE
								PRINTFORML 「...이 폐허를 좀 봐. 내 방에서 잠시 눈을 돌렸더니 이런 게 나와.」
								PRINTFORML 「네가 전문가니까 청소는 너에게 맡길게.」
								PRINTFORMDW 이거 꽤 큰일이 될 것 같은데...
								;/ぱんつ発見のチャンス！
						ENDSELECT
					ENDIF
					;◆離れ（あなた私室）
				CASE P119離れ
					SIF MAIN_MAP != 1 ;can't access this outside
						GOTO END4
					PRINTFORML 「제가 먼저 들어가겠습니다. 실례합니다.」
					;他
				CASEELSE
					$END4
					;◆
					IF RAND:7 == 0
						PRINTFORMW 「오, 안녕. 수고했어.」
						PRINTFORMW 「...아니, 그냥 들렀을 뿐이야. 특별히 필요한 건 없어.」
						;◆
					ELSEIF RAND:6 == 0
						PRINTFORMW 「이봐, 이거 우연이네.」
						PRINTFORMW 「뭐, 명련 사찰은 워낙 작아서 다른 곳에서 마주치는 건 흔한 일이라고 봐야겠지.」
					ELSEIF RAND:5 == 0
						PRINTFORMW 「아, 요즘 자꾸 당신이 눈에 띄네요.」
					ELSEIF RAND:4 == 0
						PRINTFORML 「...」
						PRINTFORMW 당신의 시선이 그녀와 마주치자, 그녀는 콧방귀를 뀌며 몸을 돌린다.
					ELSEIF RAND:3 == 0
						PRINTFORML 「...」
						PRINTFORMDW 나즈린은 혼자 책을 펼쳐 들고 있다...
					ELSEIF RAND:2 == 0
						PRINTFORMW 「항상 청소해줘서 고마워.」
						;/星ちゃん失くしすぎ
					ELSE
						PRINTFORML 「흠. 이걸 나의 마스터에게 전해주시오.」
						PRINTFORM 「뭔가요? 아, 그냥 약간의」 
						IF RAND:5 == 0
							PRINTFORMW 사라진 문서들.
						ELSEIF RAND:4 == 0
							PRINTFORMW 사라진 재료들.
						ELSEIF RAND:3 == 0
							PRINTFORMW 사라진 수트라들.
						ELSEIF RAND:2 == 0
							PRINTFORMW 분실된 기록들을.
						ELSE
							PRINTFORMW 사라진 상담 양식들...」
						ENDIF
						;星ちゃんが恋慕かつナズが恋人でない
						SIF TALENT:[[星]]:恋慕 && TALENT:恋人 == 0
							PRINTFORMW 「네가 배달하는 게 더 말이 되니까, 그냥 가져가라.」
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
