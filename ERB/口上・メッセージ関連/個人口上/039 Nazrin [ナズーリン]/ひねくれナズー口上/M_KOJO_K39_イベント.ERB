;-------------------------------------------------
;フェラ、クンニで起こされる
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 1
	IF IS_FEMALE(MASTER) ;added from tohoJ
		IF TALENT:恋慕
			PRINTFORMW 「너는 어때, 우리 오랜만에 서로 안아주지 못해서 몸이 아픈 거 아니야?」
			PRINTFORMW 「응, 나도 똑같아. 내 몸은 자꾸 너를 원하고, 또 원하고, 더욱 원하게 돼...」
			PRINTFORMW 「어쩔 수 없지 뭐. 우리 외로운 사랑의 새들끼리 서로 위로하자...」
		ELSEIF ABL:レズ中毒 >= 3
			PRINTFORMW 「음, 손을 사용하는 게 싫다면, 우리가 시도해 볼 만한 몇 가지 아이디어가 있지...」
			PRINTFORMW 「흠, 이 작은 친구는 어때... 오호호. 결정했어! 이 큰 남자가 네 파트너가 될 거야!! ...네가 거절하지 않는다면 말이야...」
		ELSEIF ABL:レズっ気 >= 3
			PRINTFORMW 「좋아, 이것쯤은 괜찮겠군.」
			PRINTFORMW 「내가 무슨 소리를 하는 거지? 후후후~ 우리에게 약간의 만족감을 줄 수 있는 작은 모방일 뿐이야...」
		ELSE
			PRINTFORMW 「있잖아, 지금 잠깐 나 좀 상대해줄 수 있어?」
			PRINTFORMW 「오랜만에 아무도 나한테 손대지 않아서, 조금 외로워지고 있거든...」
		ENDIF
	ELSEIF TALENT:恋人
		;精液中毒Lv.3以上でランダム分岐3つ追加
		IF RAND:6 == 0 && ABL:精液中毒 >= 3
			PRINTFORML 「%RANDKISS("suck")%... 응, 음음... %RANDKISS("kiss")%, 아으, %TOLOWER(FSYN("lips_over"))%... 아직 사정하지 마, 들려?」
			PRINTFORMW 「내가 너를 애태우는 데 이유가 있어. 하루의 첫 사정이 내가 삼킬 때 아주 진했으면 좋겠거든...」
		ELSEIF RAND:5 == 0 && ABL:精液中毒 >= 3
			PRINTFORML 「음... %RANDKISS("suck")%, %TOLOWER(RANDKISS("kiss"))%, %TOLOWER(FSYN("lips_muffle"))%, 음... 좋은 아침~」
			PRINTFORMW 「뭐? 네 귀여운 잠든 얼굴을 보러 온 거야... 그리고 너의 향기를 맡으려고, 그게 다야~ 후후~ 대접 고마워♪」
		ELSEIF RAND:4 == 0 && ABL:精液中毒 >= 3
			PRINTFORML 「음~ ...%RANDKISS("suck")%, %TOLOWER(RANDKISS("kiss"))%, %TOLOWER(FSYN("lips_muffle"))%... 하아, 무구... 아, 깨어난 것 같네.」
			PRINTFORMW 「네 이불 속으로 기어들자마자 네 체취가 나를 흥분시키기에 충분했지... 조금만 더 참아줘♪」
		ELSEIF RAND:3 == 0
			PRINTFORML 「음냐... %RANDKISS("suck")%, 아으, 하안, %TOLOWER(RANDKISS("suck"))%, %TOLOWER(RANDKISS("suck"))%, 쿠운... 음, %TOLOWER(RANDKISS("suck"))%...」
			PRINTFORMDW 너는 야릇한 나즈린이 네 성기를 탐닉하며 격렬하게 자위를 하는 동안 몸을 비비고 있는 것을 보고 잠에서 깨어난다...
			PRINTFORMW 「음냐... 하아~♪ 좋은 아침이야. 거기서 조금 더 있어 줄 수 있어, 거의 다 됐으니까... 음~♪」
		ELSEIF RAND:2 == 0
			PRINTFORML 「하아프, %TOLOWER(FSYN("lips_gulp"))%, %TOLOWER(FSYN("lips_muffle"))%... %RANDKISS("suck")%, 주우우, 하아... 핥기-핥기, 음... 아아, 좋은 아침이야...」
			PRINTFORMW 「음, 너를 깨우러 왔는데 네가 치던 그 텐트가 너무 멋져 보여서 도저히 참을 수가 없었어... 계속해도 괜찮겠니?」
			;◆
		ELSE
			PRINTFORMW 「아무, 음, %TOLOWER(FSYN("lips_gulp"))%, 음... 좋은 아침이야...」
			PRINTFORMW 「잠든 사이에도 네 몸이 나를 갈망하는 것 같아.」
			PRINTFORMW 「음, 내 서비스는 어떻게 즐기고 있니?」
		ENDIF
		RETURN 1
	ELSEIF TALENT:恋慕
		;◆
		IF RAND:3 == 0
			PRINTFORMW 「누, 음음... 아, 내가 깨웠니?」
			PRINTFORMW 「꽤 쌓여 있었던 것 같아서 말이야. 내가 알아서 치워뒀어.」
			PRINTFORMW 「이곳은 사찰이니까. 하루를 시작하자마자 그런 속세의 욕망을 안고 다니는 건 좋지 않아.」
			;◆
		ELSEIF RAND:2 == 0
			PRINTFORMW 「핥는 소리, 음... %RANDKISS("kiss")%... 좋은 아침이야...」
			PRINTFORMW 「거기 누워있는 모습이 너무 무방비해 보여서, 그냥 장난치고 싶어졌어.」
			PRINTFORMW 「음, 이런 종류의 장난은 전혀 개의치 않을 거라고 확신하는데, 그렇지 않아?」
		ELSE
			PRINTFORMW 「%FSYN("lips_gulp")%, %TOLOWER(FSYN("lips_muffle"))%, %RANDKISS("suck")%～, 하아... 음, 안녕...」
			PRINTFORML 「음, 있잖아... 너 정말 멋진 텐트를 치고 있었는데, 내 바로 앞에서 말이야...」
			PRINTFORMW 「그렇게 하고 일하러 가는 걸 그냥 보고 있을 수는 없겠지?」
		ENDIF
		;◆合意
	ELSEIF GETBIT(CFLAG:1,0)
		IF RAND:2 == 0
			PRINTFORMW 「음, %TOLOWER(RANDKISS("kiss"))%... 쪽쪽... 어이쿠, 좋은 아침이야. 아주 좋아 보이네.」
			PRINTFORMW 「그리고 이 작은 친구도 아주 활기차 보이네～」
		ELSE
			PRINTFORMW 「츄, 핥아봐... %FSYN("lips_gulp")%, %TOLOWER(FSYN("lips_over"))%, 내가 너를 깨웠니?」
			PRINTFORMW 「이런 알람 같은 건 나쁘지 않잖아, 그렇지 않아?」
		ENDIF
		;◆好感度高い
	ELSEIF CFLAG:2 >= 251
		PRINTFORMW 「츄, %TOLOWER(FSYN("lips_muffle"))%, 음음... 어이쿠... 이런 종류의 자극으로 잠에서 깬 사람도 놀랍지 않겠지...」
		;◆
	ELSE
		PRINTFORMW 「아무래도, 음... %FSYN("lips_gulp")%, %TOLOWER(RANDKISS("kiss"))%... 뭐야? 그냥 충동적으로 해본 거야.」
	ENDIF
ENDIF
;--------------------------------------------------
;パイズリで起こされる
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 2
	IF TALENT:恋人
		;精液中毒Lv.3以上でランダム分岐1つ追加
		IF RAND:4 == 0 && ABL:精液中毒 >= 3
			PRINTFORML 「음... 후우, 하아, 응... 음, 어라. 깨웠나 보네.」
			PRINTFORML 「후후... 그렇게 된 너를 보니 참을 수가 없었어...」
			CALL HPH_PRINT,@"「당신의 정액, 그 냄새만으로도 나를 미치게 하기에 충분해...HPH」","W"
			;◆
		ELSEIF RAND:3 == 0
			PRINTFORMW 「좋은 아침이야, 난 보통 이렇게 일찍 일어나지 않으니까 네 마음대로 해도 돼.」
			PRINTFORMW 「하지만 알잖아, 내 가슴이 일반적인 남자를 만족시키기엔 좀 부족하다는 걸.」
			PRINTFORMW 「네 거시기가 이렇다는 게 나 때문일까? 아니면 너 그런 취미가 있는 거야? 둘 다?」
			;◆
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 좋은 아침이야. 오늘따라 꽤 활기차 보이네...」
			PRINTFORMW 「하지만 이미 알고 있겠지만, 내 가슴은 좀 작잖아... 그래도 즐거웠어?」
			PRINTFORMW 「네가 아직 자고 있을 때 물어볼 수는 없었지. 이리 와서 대답해 봐.」
		ELSE
			PRINTFORML 「하아, 하아... 응, 음... 아, 좋은 아침이야...」
			CALL HPH_PRINT,@"「오늘 아침 당신의 거기가 정말 활기차 보여... 덕분에 다시 만지고 싶어지네HPH」","L"
			PRINTFORMW 그렇게 말한 후, 나즈린은 당신의 귀두를 자신의 유두에 계속 비비기 시작한다...
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORML 「음~... 크으, 음, 자아~ 하아, 음~... 어이쿠, 좋은 아침이야.」
			PRINTFORMW 「좀 창의적으로 해봤는데... 마음에 들어?」
			;◆
		ELSEIF RAND:2 == 0
			PRINTFORMW 「결국 별로 효과가 없었던 것 같네, 응.」
			;◆
		ELSE
			PRINTFORMW 「음, 어서 와.」
			PRINTFORMDW ...
			PRINTFORMW 「아니, 음, 그냥 장난치려고 네 이불을 벗긴 건 아니거든... 있잖아...」
		ENDIF
		;◆好感度高い
	ELSEIF CFLAG:2 >= 251
		PRINTFORMW 「이 정도면 어때? 너희 같은 남자들은 이런 걸 좋아하잖아?」
	ELSE
		PRINTFORMW 「오 안녕, %MASTERNAME:39%. 멋진 일출이네, 그렇지? 쿠쿠쿠...」
	ENDIF
	RETURN 1
ENDIF
;--------------------------------------------------
;騎乗位、貝合わせ (ARG:1が１の場合、うふふに突入するか否か回答後の口上)
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 3
	;騎乗位、貝合わせ描写
	IF ARG:1 == 0
		IF TALENT:恋人
			;◆
			IF RAND:5 == 0
				PRINTFORMW 「아, 일어났네.」
				PRINTFORMW 「알잖아. 네 잘못이야. 내가 옷을 벗겼을 때나 다리를 들어 올렸을 때도 일어나고 싶지 않았던 건 너잖아.」
				PRINTFORMW 「거의 나한테 이걸 해달라고 부탁하는 것 같아.」
			ELSEIF RAND:4 == 0
				PRINTFORML 「후우, 나아하아...♪ 아, 음, 안녕...♪」
				CALL HPH_PRINT,@"「왜 그런지는 잘 모르겠지만 너를 깨우러 왔을 때 배가 그냥 꾸르륵 소리를 내기 시작했어... 응아앙흐프」","W"
				;◆
			ELSEIF RAND:3 == 0
				PRINTFORMW 「%RANDLIPS()%… 아, 좋은 아침이에요. 그냥 나 자신을 즐겁게 해줄 뿐이에요.」
				PRINTFORMW 「하지만 있잖아요, 전 불교의 제자이잖아요. 이렇게 이른 아침부터 당신의 함께 있는 것이 그리워하는 저 자신이 믿기지 않아요...」
				PRINTFORMW 「그리고 전부 당신 때문이에요. 그러니까… 알잖아요?」
				;◆
			ELSEIF RAND:2 == 0
				PRINTFORMW 「%RANDLIPS()%... 킁... 아, 드디어 일어났구나.」
				PRINTFORMW 「내가 뭘 하고 있는지 궁금해? ...너 바보야? 눈으로 보고 추측할 수 없니?」
				PRINTFORMW 「다음엔 무슨 일이 일어날지 알잖아... 안 그래～?」
				;◆
			ELSE
				PRINTFORMW 「음... 음... 어이쿠, 좋은 아침이야. 이렇게 이른 시간에 미안해.」
				PRINTFORMW 「처음엔 그냥 너를 깨우려고 했는데, 네 몸이 나를 기다리고 있는 것 같았어.」
				PRINTFORMW 「내가 한 건 그저 네 몸의 간절한 요청을 들어준 것뿐이야. 자, 그럼 다음은 뭘까?」
			ENDIF
			;◆恋慕
		ELSEIF TALENT:恋慕
			IF RAND:3 == 0
				PRINTFORMW 「응, %RANDLIPS()%, 아아~ %MASTERNAME:39%, 음, %MASTERNAME:39%...」
				PRINTFORMW 「아... 깨어 있었구나...?」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「%RANDLIPS()%… 어이, 좋은 아침. 오늘 일출 참 아름답네.」
				PRINTFORMW 「아직도 꿈을 꾸고 있니, 라고 묻는 거야? 아니, 물론 아니지. 하지만 만약 계속해서 꿈같은 무언가를 하고 싶다면...」
			ELSE
				PRINTFORMW 「후우~... %RANDLIPS()%... 아, 일어났어?」
				PRINTFORMW 「오늘 아침에 너무 활기차 보여서 내가 진정시켜줘야겠다고 생각했거든...」
			ENDIF
			;◆好感度高い
		ELSEIF CFLAG:2 >= 251
			PRINTFORMW 「흠... 후우... 아아, 좋은 아침이야. 이거 잠시 빌릴게.」
			;◆
		ELSE
			PRINTFORMW 「흠... 아, 깨어 있었군. 자, 그럼 실험을 시작해 볼까~」
		ENDIF
		;そのままうふふモードに突入するか
	ELSE
		;そのまま押し倒した
		IF TFLAG:193 == 1
			;恋人
			IF TALENT:恋人
				;◆
				IF RAND:6 == 0
					PRINTFORMW 「드디어 기분이 나셨군요, 응? 좋아, 우리 재미 좀 볼까요~」
					;◆
				ELSEIF RAND:5 == 0
					PRINTFORMW 「후후~ 오늘 아침 서비스는 어디에서 받고 싶으세요?」
				ELSEIF RAND:4 == 0
					CALL HPH_PRINT,@"「후훗... 아침부터 활기차네. 나도 그런가 봐...후후」","W"
					;◆
				ELSEIF RAND:3 == 0
					PRINTFORMW 「후후~ 아침이라고 서둘러 도착할 필요는 없다는 거 알잖아?」
					;◆
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후후... 이제 어떻게 나에게 사랑을 베풀 셈이신가요?」
					;◆
				ELSE
					PRINTFORMW 「꺄아~안이야!? 아-너무 욕심내는 거 아니야?!」
				ENDIF
				;恋慕
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「...! 후, 후후... 내가 먼저 너를 초대했던 사람이었다는 걸 알고 있네...」
					PRINTFORMW 「좋아... 네 마음대로 해...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「흐응...! ...후후, 괜찮아...」
					PRINTFORMW 「널 기분 나게 만들려고 노력한 보람이 있네... 자, 신나게 놀자?」
				ELSE
					PRINTFORMW 「흐응~안...! 응, 그런 기분이신가 봐...」
					PRINTFORMW 「좋아... 하지만 이번엔 나를 꼭 안아야 해...」
				ENDIF
				;◆好感度高い
			ELSEIF CFLAG:2 >= 251
				PRINTFORMW 「이런, 이번엔 내가 잡아먹히는 모양이네.」
				;◆
			ELSE
				PRINTFORMW 「하아암~ 역시, 남자는 이래야지~」
			ENDIF
			;押しのけて朝の準備
		ELSE
			IF TALENT:恋人
				IF RAND:4 == 0
					PRINTFORML 「...이것에 대해 미안해, 너무 오랫동안 이 더위 때문에 고생했어.」
					PRINTFORMDW 이게 골칫거리로 변하기 시작하는 것 같아. 오늘 밤 그녀를 제대로 연모하려면 시간이 좀 필요할 것 같네...
					;◆
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아, 당신에게 폐가 되나요?」
					;◆
				ELSEIF RAND:2 == 0
					PRINTFORMW 「오 정말? 뭐, 하루는 이제 막 시작했을 뿐이야.」
					;◆
				ELSE
					PRINTFORMW 「...바보 같아.」
				ENDIF
				;恋慕
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「...미안해...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...내 잘못이야. 아무래도 내가 스스로를 통제하지 못하는 쪽인가 봐...」
				ELSE
					PRINTFORMW 「...내가 너무 앞서 나갔던 것 같아. 그냥 잊어줘...」
				ENDIF
				PRINTFORMDW 정신을 차린 나즈린은 풀이 죽은 표정으로 몸을 돌린다.
				;◆好感度高い
			ELSEIF CFLAG:2 >= 251
				IF RAND:3 == 0
					PRINTFORMW 「오, 흥미가 없다고?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「정말? 뭐, 모든 사람이 이렇게 이른 아침에 준비된 건 아닌 모양이지...」
				ELSE
					PRINTFORMW 「나는 괜찮은데, 너는 어때?」
				ENDIF
				;◆
			ELSE
				PRINTFORMW 「오, 흥미롭군, 예상치 못한 응답이야.」
			ENDIF
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
