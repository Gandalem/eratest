	PRINTFORMDL Preoccupied with sniffing the rod, the mouse doesn't look any different from an ordinary rodent.
	PRINTFORMDW But then Nazrin tosses a chunk of some unidentifiable meat at its feet, and the mouse instantly snatches it up and scampers off.
	PRINTFORML 
	PRINTFORMDW A moment of silence follows.
	PRINTFORML 
	PRINTFORML 
	PRINTFORML 
	PRINTFORMW 「...Looks like I might've startled you. My apologies.」
	PRINTFORML 
	PRINTFORMDW A presence moves behind you, finally reminding you to breathe.
	PRINTFORML 
	PRINTFORMW 「In the end, this is just a taste of what can happen when youkai and humans live together.」
	CALL PRINT_DIALOGUE, @"I'm not saying you shouldn't let your guard down, but... It's best not to wander into someone else's territory until you're both comfortable with each other.", "w"
	PRINTFORML 
	PRINTFORMDL Nazrin steps in front of you and offers her hand to help you up.
	PRINTFORMDW ...Seems like you slumped to the ground without even realizing it.
	PRINTFORML 
	PRINTFORMW 「Well, to be more specific, try not to provoke the mice too much when you clean my room and other spots around the temple.」
	PRINTFORML 「Let me just give you a word of caution - there are certain boundaries that you must respect.」
	PRINTFORMW 「Though I'm sure you'll be fine. Just as long as you avoid the hanging baskets over the closet, and the nest under the floor...」
	PRINTFORML 
	PRINTFORMDW As small and dainty as Nazrin's hand is, she still pulls you up to your feet without much difficulty.
	PRINTFORML 
	PRINTFORMW 「Hup, there you are.」
	PRINTFORML 「If you ever get bitten, there's some medicine on the right, just inside the entrance to my room.」
	PRINTFORMW 「The sliding door next to mine also has a built-in mouse repellent, so if you think you're in trouble, just take refuge in Ichirin's room.」
	PRINTFORML 
	PRINTFORMDW As you stand up, you notice several eyes staring at you from the basket draped over Nazrin's tail.
	PRINTFORML 
	PRINTFORMW 「Don't worry, you'll get used to it eventually. Though the first time Kyouko and Kogasa got gnawed on, they also...」
	PRINTFORML 「Nah, never mind. Not much has really changed, I guess.」
	IF MAIN_MAP == 1
		PRINTFORMW 「...Oh, uh, what else? Anyway, I know I've been rambling on at length, but there's still one thing I forgot to mention. I'll make it short.」
		PRINTFORML 
		PRINTFORML 
		PRINTFORMW 「Welcome to Myouren Temple. We'll be counting on you, dear human. To the best of your ability, of course.」
		PRINTFORML 
		PRINTFORML 
		PRINTFORMDW Still holding your hand, she shakes it energetically up and down.
		PRINTFORML 
	ELSE
		PRINTFORMW 「Well, I guess I've been rambling, so I'd better wrap up. come see me whenever you get the chance. You're welcome to use my services.」
		PRINTFORML 
		PRINTFORML 
		PRINTFORMW 「It was nice to meet you, dear human. And welcome to Gensokyo.」
	ENDIF
ENDIF

RETURN 1

;-------------------------------------------------
;名前を教えるイベント（関数）
;/見事な響子口上の丸パクだと感心するがどこもおかしくはない
;-------------------------------------------------

@NAME_SET_K39
gLineCount = LINECOUNT
REDRAW 0
DO
	SIF LINECOUNT - gLineCount > 0
		CLEARLINE LINECOUNT - gLineCount
	PRINTFORMDL Input a name %NAME:39% should use when referring to you. (Type it in or press a button)
LOCALS = %CALLNAME:MASTER%
	PRINTBUTTON @"[Just %LOCALS%]", @"%LOCALS%"
	PRINTL 
	INPUTS
	; 行頭行尾の空白文字削除
	LOCALS = %RESULTS%
	REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
	;10文字以上は受け付けない
	IF STRLENS(LOCALS) > 30
		CLEARLINE 1
		PRINTFORMW 「You know what they say - brevity is the soul of wit. Can't you make it any shorter?」
		CONTINUE
	;空白は受け付けない
	ELSEIF RESULTS == ""
		PRINTDW Input a name.
		CONTINUE
	ELSE
		; 同姓同名
		IF FLAG:なりきり != [[ナズーリン]] && STRCOUNT(LOCALS, "(?i)nazrin")
			PRINTFORMW 「...Seeing someone else take my name like that doesn't make me happy in the least.」
			CONTINUE
		; 白蓮が主人ではなく、白蓮というフレーズが含まれている。もしくは
		; 星が主人ではなく、寅丸もしくは星というフレーズが含まれている
		ELSEIF (FLAG:なりきり != [[白蓮]] && STRCOUNT(LOCALS, "(?i)byakuren|hijiri")) || (FLAG:なりきり != [[星]] && STRCOUNT(LOCALS, "(?i)toramaru|shou"))
			PRINTFORMW 「...Spare me your preposterous jokes.」
			CONTINUE
		; 命蓮寺勢はじき
		; うんそうだね多々良勝五郎とか教える人もいるかもしれないもんね
		ELSEIF (FLAG:なりきり != [[小傘]] && STRCOUNT(LOCALS, "(?i)tatara|kogasa")) || (FLAG:なりきり != [[一輪]] && STRCOUNT(LOCALS, "(?i)kumoi|(?i)ichirin")) || (FLAG:なりきり != [[ムラサ]] && STRCOUNT(LOCALS, "(?i)minamitsu|murasa")) || (FLAG:なりきり != [[響子]] && STRCOUNT(LOCALS, "(?i)kasodani|kyouko"))
			PRINTFORMW 「...That's just too similar to a member of our group, it's confusing. Can you try something else?」
			CONTINUE
		ELSEIF FLAG:なりきり != 69 && STRCOUNT(LOCALS, "(?i)futatsuiwa|(?i)mamizou")
			PRINTFORMW 「...That woman's got a massive tail on her back, for your information. Try again.」
			CONTINUE
		ELSEIF (FLAG:なりきり != [[ぬえ]] && STRCOUNT(LOCALS, "^(?i)nue$|(?i)houjuu"))
			PRINTFORMW 「...I just saw Nue napping on the roof. You're not her.」
			CONTINUE
		; 道教勢力はじき
		ELSEIF (FLAG:なりきり != [[芳香]] && STRCOUNT(LOCALS, "^(?=.*\b[M|m]iyako\b)(?=.*\b[Y|y]oshika\b).*$")) || (FLAG:なりきり != [[青娥]] && STRCOUNT(LOCALS, "(?i)kaku|(?i)seiga")) || (FLAG:なりきり != [[屠自古]] && STRCOUNT(LOCALS, "(?i)soga|(?i)tojiko")) || (FLAG:なりきり != [[布都]] && STRCOUNT(LOCALS, "(?i)mononobe|(?i)futo")) || (FLAG:なりきり != [[神子]] && STRCOUNT(LOCALS, "(?i)toyosatomimi|(?i)shoutoku|(?i)taishi"))
			PRINTFORMW 「...I don't recognize you as one of those heathens. Are you?」
			CONTINUE
		; 博麗霊夢というフレーズが含まれてる。もしくは
		; 東風谷早苗というフレーズが含まれている
		ELSEIF STRCOUNT(LOCALS, "(?i)hakurei") || STRCOUNT(LOCALS, "(?i)kochiya")
			PRINTFORMW 「Are you related to that unorthodox priestess? Well, if you say so.」
			PRINTFORML
		; 霧雨魔理沙というフレーズが含まれてる。
		ELSEIF STRCOUNT(LOCALS, "(?i)kirisame")
			PRINTFORMW 「You bear a strange connection to that wacky magician, don't you? Well, if you say so.」
			PRINTFORML
		; 直接入力ならいけると思ったか？弾くぜ！
		ELSEIF ABL:親密 < 4 && STRCOUNT(LOCALS, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$")
			PRINTFORMW 「Are you pretending to be stupid?」
			CONTINUE
		ELSEIF ABL:親密 < 7 && STRCOUNT(LOCALS, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$")
			PRINTFORMW 「Are you actually stupid?」
			CONTINUE
		ELSEIF (ABL:従順 < 7 || ABL:奉仕精神 < 7) && STRCOUNT(LOCALS, "((?i)master|lord|god)$")
			PRINTFORMW 「You *are* stupid, huh?」
			CONTINUE
		ELSEIF (!TALENT:恋人 || !TALENT:恋慕) && STRCOUNT(LOCALS, "(?i)(husband|dear|darling|honey|hubby)$")
			PRINTFORMW 「...Stupid is as stupid does.」
			CONTINUE
		ELSE
			PRINTFORML 「%RESULTS%... then?」
		ENDIF
		CALL ASK_YN
		IF RESULT == 0
			;あなたの名前を%MASTERNAME:39%に格納
			MASTERNAME:39 = %RESULTS%
			PRINTFORML 
			BREAK
		ELSEIF RESULT == 1
			CONTINUE
		ENDIF
	ENDIF
LOOP 1

