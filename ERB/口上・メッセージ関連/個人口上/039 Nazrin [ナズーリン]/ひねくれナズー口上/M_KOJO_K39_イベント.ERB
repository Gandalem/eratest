;==================================================
;◆デート反発刻印消去共通イベント
;==================================================
@M_KOJO_SPEVENT_K39_3(ARG,ARG:1)
;口上主はTARGET
;共通メッセージ出力
CALL SPEVENT_MESSAGE_3(ARG,ARG:1)
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;added from tohoJ, normal after date talk
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF MARK:反発刻印 || CFLAG:ブチギレ
			PRINTFORMW 「Well then, let's hope to avoid any major improprieties from now on, shall we?」
