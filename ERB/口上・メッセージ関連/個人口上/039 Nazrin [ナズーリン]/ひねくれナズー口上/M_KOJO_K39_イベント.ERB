						PRINTFORMW 「Of course it's your right to go where you will... So then, that means it's up to me to stay by your side.」
						PRINTFORMDW With an unperturbed expression on her face, Nazrin plops herself down at your side.
					;◆
					ELSEIF RAND:6 == 0 && TALENT:恋人
						PRINTFORMW 「I happened to catch sight of you, so I just came over. ...Is that a bother? If so, I'll leave.」
						PRINTFORMW 「It's not at all? I see. In that case, mind if I get a little closer?」
					ELSEIF RAND:5 == 0 
						PRINTFORML 「Oh hey, lately I've seen you around quite a bit.」
						PRINTFORMW 「...Fufu.」
					ELSEIF RAND:4 == 0 
						PRINTFORML 「...!」
						PRINTFORMDW When you make eye contact with Nazrin, she suddenly turns away. 
					ELSEIF RAND:3 == 0 
						PRINTFORML 「...」
						PRINTFORMDW Nazrin casually sidles up beside you...
					ELSEIF RAND:2 == 0 
						PRINTFORML 「Thanks for always cleaning up.」
						PRINTFORMW 「If you ever need help, just let me know.」
					;/星ちゃん失くしすぎ
					ELSE
						PRINTFORML 「Hmm. Please deliver this to my Master.」
						PRINTFORM 「What is it? Ah, it's just some 
						IF RAND:5 == 0 
							PRINTFORMW documents that went missing.」
						ELSEIF RAND:4 == 0 
							PRINTFORMW materials that went missing.」
						ELSEIF RAND:3 == 0 
							PRINTFORMW sūtras that went missing.」
						ELSEIF RAND:2 == 0 
							PRINTFORMW record books that went missing.」
						ELSE
							PRINTFORMW consultation forms that went missing..」
						ENDIF
						;星ちゃんが恋慕かつナズが恋人でない
						SIF TALENT:[[星]]:恋慕 && TALENT:恋人 == 0
						PRINTFORMW 「...It makes more sense for you to make the delivery, so just take it already.」
					ENDIF
			ENDSELECT
		;通常、恋慕なし
		ELSE
			;場所限定
			SELECTCASE CFLAG:現在位置
				;居間
				CASE P108居間, 命蓮寺方丈
					IF RAND:4 == 0 
						PRINTFORMW 「Oh hey. I was in the mood to do a little bit of maintenance on my tools.」
						PRINTFORMW 「If it's not too much to ask, would you mind helping me out?」
					ELSEIF RAND:3 == 0 
						PRINTFORMW 「Hm... it's you. Isn't there more dirt to clean someplace else?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「Ooh, there you are. Just in time, I was hoping to have some tea.」
					ELSE
						PRINTFORMW 「Hm... I see that you're cleaning up. Good work.」
					ENDIF
				;縁側
				CASE P110縁側
					SIF MAIN_MAP != 1 ;can't access this outside
						GOTO END4
					IF RAND:3 == 0 
