@M_KOJO_EVENT_K39_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF TALENT:恋慕
				IF !RAND:2
					LOCAL:2 = RAND:5 + 1
					CALL M_KOJO_SPEVENT_K39_5(LOCAL:2)
				ELSE
					LOCAL:2 = RAND:3 + 1
					CALL M_KOJO_SPEVENT_K39_4(LOCAL:2)
				ENDIF
			;おそらく発生しない？
			ELSE
				;◆
				IF RAND:3 == 0
					PRINTFORMW 「...Good morning. Hurry up and get out of my futon.」
				;◆
				ELSEIF RAND:2 == 0
					PRINTFORMW 「......You're awake, aren't you? Hurry up and get out of there.」
				ELSE
					PRINTFORMW 「...Why are you here?」
				ENDIF
			ENDIF
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋慕
				;◆
				IF RAND:3 == 0
					PRINTFORMW 「Did you have a pleasant dream? What, I was in it?」
					PRINTFORMW 「Let's see, maybe I should take a performance fee...」
					PRINTFORMDW Before you have a chance to react, she steals away your lips...
				;◆
				ELSEIF RAND:2 == 0
					PRINTFORMW 「You know, you sure say some interesting things in your sleep.」
					PRINTFORML 「What kind of things? Fufu～ I'm not telling.」
					PRINTFORMW 「I'll have to save that kind of evidence for when it'll have maximum impact♪」
					PRINTFORMDW Nazrin giggles in amusement...
				;◆
				ELSE
					PRINTFORMW 「I guess you're still a little sleepy. Okay, I'll just try that...」
					PRINTFORMDW You get a bad premonition about this, and instinctively scuttle away.
					PRINTFORMW 「Hmー? And here I was thinking of giving you a good morning kiss. ...Ah, what a shame...」
				ENDIF
			ELSE
				IF !RAND:3
					LOCAL:2 = RAND:5 + 1
					CALL M_KOJO_SPEVENT_K39_5(LOCAL:2)
				ELSE
					LOCAL:2 = RAND:3 + 1
					CALL M_KOJO_SPEVENT_K39_4(LOCAL:2)
				ENDIF
			ENDIF
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF !RAND:2
			LOCAL:2 = RAND:5 + 1
			CALL M_KOJO_SPEVENT_K39_5(LOCAL:2)
		ELSE
			LOCAL:2 = RAND:3 + 1
			CALL M_KOJO_SPEVENT_K39_4(LOCAL:2)
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;共通
		;恋慕かつ恋人
		IF TALENT:恋慕 && TALENT:恋人
			;過激なイタズラ中
			IF CFLAG:うふふ == 2 && CFLAG:睡眠
			;少し怒ってらっしゃる
				IF RAND:3 == 0
					PRINTFORMW 「...Haaah, seriously. What can I say, you're just so energetic.」
					PRINTFORMW 「Well, that's okay. I'll just have to squeeze every last drop out of you...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...Well, I guess night crawling is a form of affection.」
					PRINTFORMW 「If you can satisfy me, perhaps I'll forgive you?」
				ELSE
					PRINTFORMW 「...I actually woke up about halfway through, but I thought it would be more interesting if I pretended to be asleep.」
					PRINTFORMW 「You looked so adorable and desperate as you bucked your hips for me... Hehe～...」
				ENDIF
			;イタズラ中
			ELSEIF CFLAG:イタズラ
				PRINTFORML 「Mmmnfn... G'morning...」
				PRINTFORMW 「...If you poke me that much, of course it'll wake me up...」
			ELSE
				;◆
				IF RAND:3 == 0
					PRINTFORMW 「...Mmngh, ah... Nicea meecha...」
					PRINTFORML 
					PRINTFORML Surrounded by the chittering mice, Nazrin turns a bleary, half-closed gaze toward you.
					PRINTFORML If you had to hazard a guess, you'd say she's still at least two-thirds asleep.
					PRINTFORMW After valiantly clinging on by a single ear, her nightcap falls off and her wildly disheveled hair splashes out across her face.
					PRINTFORML 
					PRINTFORMW ...It seems like she's really not much of a morning person.
					PRINTFORML Mounting a herculean effort, she finally wrenches her eyes all the way open.
					PRINTFORMW 「Nguh... Good morning, %MASTERNAME:39%.」
				ELSEIF RAND:2 == 0
					PRINTFORML 「Mm... G'morning.」
					PRINTFORMDW Nazrin glances over at you.
					PRINTFORMW 「...I'm happy.」
				ELSE
					PRINTFORMW 「...Good morning.」
					PRINTFORML 「When I wake up in the morning, and you're there next to me... How can I put it.」
					PRINTFORML 「Maybe it's a cliché, but it really makes me happy.」
					PRINTFORMDW With that, Nazrin lets out a soft giggle...
				ENDIF
			ENDIF
		ELSEIF TALENT:恋慕
			;/起きて恋慕相手が目の前にいたらそりゃだれだってびっくりするよね
			;過激なイタズラ中
			IF CFLAG:イタズラ && CFLAG:睡眠
				IF RAND:2 == 0
					PRINTFORML 「...What are you doinggg...?!」
				ELSE
					PRINTFORML 「...Fool...」
				ENDIF
				PRINTFORMDW Nazrin glares at you with tears in her eyes...
				IF RAND:3 == 0
					PRINTFORMW 「After doing that to me, there's no way I could wake up normally...!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...If you'd just tell me like a normal person, I could...」
				ELSE
					PRINTFORMW 「I honestly have no idea what you're even thinking...」
				ENDIF
			;普通
			ELSE
				PRINTFORMW 「%MASTERNAME:39%, hm...」
				PRINTFORMDW As she opens her eyes, Nazrin catches sight of you and smiles faintly for a moment.
				PRINTFORMDL And then she jumps back with such force that you can practically hear her break the sound barrier...
				PRINTFORMW 「Why. Are you. Even here.」
				PRINTFORMDW You tell her that you got the urge to come see her face this morning.
				PRINTFORMW 「～～～Y-You——! Ah, for cryin' out loud!」
				;他に恋人持ちがいる。あなたマジ女たらし
				SIF TALENT:[[一輪]]:恋人 || TALENT:[[ムラサ]]:恋人 || TALENT:[[星]]:恋人 || TALENT:[[白蓮]]:恋人 || TALENT:[[ぬえ]]:恋人 || TALENT:[[小傘]]:恋人 || TALENT:[[響子]]:恋人 || TALENT:[[マミゾウ]]:恋人
					PRINTFORMW 「There's someone more suitable for that! Go wake them up instead!」
				PRINTFORMW 「Good grief... I feel like an idiot...」
			ENDIF
		ELSE
			;過激なイタズラ中
			IF CFLAG:イタズラ && CFLAG:睡眠
				PRINTFORML 「...What exactly, do you think you're doing?」
				PRINTFORMDW Nazrin gives you a cold stare as she awakens.
				PRINTFORMW 「It bears repeating, so I'll ask again. What do you think you're doing?」
				;/ナニをヤってました(ﾄﾞﾔ
			;イタズラ中
			ELSEIF CFLAG:イタズラ
				PRINTFORML 「Mmmnfn... G'morning...」
				PRINTFORMW 「...If you poke me that much, of course it'll wake me up...」
			ELSE
				;MASTERがMASTERの開始位置（＝自室）で起床した
				IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:311
					PRINTFORML 
					PRINTFORMW （...I must have fallen asleep like this...）
				ELSE
					PRINTFORMW 「...Good morning. What're you doing up so early?」
				ENDIF
			ENDIF
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

