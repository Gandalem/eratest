			PRINTFORMW 「Aah... This is pretty much the same as how Master's cooking tastes.」
		ENDIF
	;わさび
	ELSEIF TASTE_REACTION("わさび")
		PRINTFORMW 「Kuu... Mhnn, that wasabi is certainly doing its job... You did that on purpose, didn't you?」
		PRINTFORMW 「Oh well, unfortunately for you... I'm the kind of girl who can handle this much.」
