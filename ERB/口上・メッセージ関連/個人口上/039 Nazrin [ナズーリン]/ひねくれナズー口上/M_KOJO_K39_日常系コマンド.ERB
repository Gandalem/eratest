			ENDIF
		ELSE
			;初めて
			IF CFLAG:1603 < 1
				PRINTFORMW 「...? What's up?」
				CFLAG:1603 = 1
			ELSE
				IF RAND:3 == 0 
					PRINTFORMW 「Hmm, are you trying to impress me or something?」
				ELSEIF RAND:2 == 0
					PRINTFORMDW Nazrin's hand is so very small...
				ELSE
					PRINTFORML 「...I'm not even your lover...」
					PRINTFORMDW Although her voice sounds dismissive, Nazrin still holds out her hand to you...
				ENDIF
			ENDIF
		ENDIF
	ENDIF
