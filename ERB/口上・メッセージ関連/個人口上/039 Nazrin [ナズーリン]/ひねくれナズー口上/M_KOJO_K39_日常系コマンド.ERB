	ELSE
		IF ABL:欲望 >= 5
			IF RAND:3 == 0
				PRINTFORMW 「...That's not all you're gonna do, right?」
				PRINTFORMW 「Hurry up, let's have some real fun...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「Nfu... I suppose this is you're way of saying it's that kind of invitation, right?」
			ELSE
				PRINTFORMW 「Fufu, you're teasing me... You know exactly what I want...」
			ENDIF
		ELSEIF ABL:親密 >= 5
			IF RAND:3 == 0
				PRINTFORMW 「...」
				PRINTFORMDW When you touch her forehead with your lips, Nazrin blushes and looked a little miffed, but she doesn't complain.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「Uuuu——...」
				PRINTFORMDW Nazrin looks up at you with a reproachful look in her eyes...
			ELSE
				PRINTFORMW 「...Haa...」
				PRINTFORMDW Nazrin sighs in resignation, although her cheeks still flush.
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「You seem to have a rather uncanny penchant for mischief...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「...Geez, you're just trying to be cool.」
			ELSE
				PRINTFORMW 「...Isn't that something you should do when you're a little more familiar with each other?」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
