				PRINTFORML 「...You put meat in it, didn't you?」
				PRINTFORML 「The mice are staring at me with anticipation in their eyes.」
				PRINTFORMW 「Good grief, I wonder if there'll be any left for me...」
			ELSE
				PRINTFORML 「You've been staring at me for a while now, what's up?」
				PRINTFORML 
				PRINTFORMDL You keep it to yourself, but just as you suspected, it seems that she holds her food with both hands.
				PRINTFORML 
				PRINTFORMW 「...Why are you nodding your head like that?」
			ENDIF
		ENDIF
	;激辛
	ELSEIF TASTE_REACTION("辛い")
		IF RAND:2 == 0
			PRINTFORMW 「U, umu... there's a bit of a tingle to it.」
		ELSE
			PRINTFORML 「...The hawk's claw chilis are a little much, don't you think? But I don't mind it.」
			PRINTFORMW 「Although I'm sure Master would have a field day with this...」
		ENDIF
	;激甘
	ELSEIF TASTE_REACTION("甘い")
		;デザート
		IF DISH_TYPE == "デザート"
			PRINTFORMW 「A little too sweet, don't you think? I'm afraid I need a cup of tea with this one.」
