@M_KOJO_MESSAGE_COM_k35_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「무, 가슴으로…… 끼우는 건가요……?」
		PRINTFORML  조심스럽게 당신의 것을 가슴에 끼운다.
		PRINTFORMW 「이렇게…… 할까요? 기분 좋아요……?」
		PRINTFORML  가슴을 움직이도록 지시하고 거기에 침을 흘리도록 가르친다.
		PRINTFORMW 「침이라니…… 알겠어요…… 응! 입으로…… 야해……. 목구멍에 넣을까?」
		PRINTFORMW  움직임은 서툴지만 윤활액을 얻은 가슴을 움직일 때마다 쾌감이 스쳐간다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:140
		PRINTFORML 「후훗 %UNICODE(0x2764)% 가슴 속에서 떨면서 거시기 기뻐하고 있어요 %UNICODE(0x2764)%%UNICODE(0x2764)%」
		PRINTFORMW 「더 골반 흔들어서 쭉 %UNICODE(0x2764)% 쭉 %UNICODE(0x2764)% 하고 가슴 속에 사정해 주세요 %UNICODE(0x2764)%」
	ELSEIF ABL:胸 >= 4
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「음후후 %UNICODE(0x2764)% 야릇한 소리를 내면서... 그렇게 가슴에 사정하고 싶으신 건가요?」
				PRINTFORMW 「참지 마세요... 츄 %UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「가슴골에서 외롭다고 외로워한다고 귀두가 울고 있어요 %UNICODE(0x2764)%」
				PRINTFORML 「후후, 귀엽네요…… %UNICODE(0x2764)%」
				PRINTFORMW 「쪽 %UNICODE(0x2764)% 응응 %UNICODE(0x2764)% 음쪽음 %UNICODE(0x2764)%」
		ENDSELECT
	ELSEIF ABL:胸 >= 2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「점점 감이 오고 있어요... 이렇게 해 주시는 게 좋은 거죠?」
				PRINTFORMW 「후훗... 벌써 앞서나가 버려서 미끌미끌해지고 있잖아요 %UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「끼어들면서 입으로 하는 게 참 좋군요%UNICODE(0x2764)%」
				PRINTFORMW 「아아... 크고 멋지고 굉장하네요%UNICODE(0x2764)%」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「음... 생각보다 어렵네요...」
				PRINTFORMW 「어때요? 기분 좋아요?」
			CASE 1
				PRINTFORMW 「물고 있으면서 무는 거 꽤 힘들죠...... 움읏...... 주무우%UNICODE(0x2764)%」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
