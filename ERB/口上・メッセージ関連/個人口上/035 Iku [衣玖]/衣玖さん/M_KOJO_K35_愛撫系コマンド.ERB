@M_KOJO_MESSAGE_COM_k35_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML  키스를 하고 허리를 감싸 안고 등 쪽으로 손가락이 쓸어내린다.
		PRINTFORML  침대로 천천히 밀쳐 눕히고 가슴에 손을 댄다.
		PRINTFORMW  크고 부드러운 가슴에 닿을 때마다 형태를 바꾼다.
		PRINTFORML  잠시 그 감촉을 즐기자 관능적인 숨소리가 새어 나온다.
		PRINTFORMW  천천히 한 손을 가슴에서 배로, 허리로 쓸어내리듯 애처(秘所) 쪽으로 뻗는다.
		PRINTFORML  약간의 축축함이 느껴지는 속옷 위를 부드럽게 쓰다 자극한다.
		PRINTFORML  천천히 애태우듯이 전신을 애무하고 때로는 강하게 자극하며 시간을 들여 익숙해지게 한다.
		PRINTFORMW 「츄……%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF TCVAR:140
				PRINTFORML 「하아...... %UNICODE(0x2764)%컥 굉장해 %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORML 「더 깊이...... %UNICODE(0x2764)%속까지...... 범하고 싶어 %UNICODE(0x2764)%%UNICODE(0x2764)%」
			ELSE
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「응... %UNICODE(0x2764)%더... 더 애태워줘%UNICODE(0x2764)%」
						PRINTFORMW 「사정해줘%UNICODE(0x2764)% 그대로 와줘%UNICODE(0x2764)%」
					CASE 1
						PRINTFORML 「앙... 그렇게 한 번에...」
						PRINTFORMW 「사려고 하세요? 좋아요, 그대로 와 주세요.」
					CASE 2
						PRINTFORML 「야아... %UNICODE(0x2764)% 거칠어... 안 돼 %UNICODE(0x2764)%」
						PRINTFORMW 「몸이 떨리고 있잖아 %UNICODE(0x2764)% 그대로 빼지 마읏 %UNICODE(0x2764)%」
					CASE 3
						PRINTFORML 「안 돼 %UNICODE(0x2764)% 그럴 수 없어 %UNICODE(0x2764)%」
						PRINTFORMW 「모든 걸 사랑받고 싶어 %UNICODE(0x2764)% 미쳐버릴 것 같아 %UNICODE(0x2764)%%UNICODE(0x2764)%」
				ENDSELECT
			ENDIF
			RETURN 1
		ELSE
			IF TCVAR:140
				PRINTFORML 「하아...... %UNICODE(0x2764)%컥 굉장해%UNICODE(0x2764)%%UNICODE(0x2764)%」
			ELSE
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「응……%UNICODE(0x2764)%더……더 조여줘 %UNICODE(0x2764)%」
					CASE 1
						PRINTFORML 「응……이렇게 한 번에……」
					CASE 2
						PRINTFORML 「야앗... %UNICODE(0x2764)%가 거칠어... 좋아 %UNICODE(0x2764)%」
					CASE 3
						PRINTFORML 「안 돼! %UNICODE(0x2764)% 그만해! %UNICODE(0x2764)%」
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TCVAR:140
		PRINTFORML 「하아... 자꾸 애태우기만 하네...」
		PRINTFORMW 「빨리... 빨리 질 안에 넣어주세요...」
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응! %UNICODE(0x2764)% 다정하시네요……%UNICODE(0x2764)%」
				PRINTFORMW 「쪽! %UNICODE(0x2764)% 더 격렬하게 해도 괜찮아요%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「앗응%UNICODE(0x2764)%하아하아... 계속 재촉만 해%UNICODE(0x2764)%」
				PRINTFORML 심술 부리지 말고 가게 해 주세요 %UNICODE(0x2764)%
				IF TALENT:恋人
					PRINTFORML 남편님
				ENDIF
				PRINTW 」
			CASE 2
				PRINTFORML 「츄 %UNICODE(0x2764)% 후후... 그런 망설이지 말고」
				PRINTFORMW 「더... 갈구해 주셔도 괜찮아요 %UNICODE(0x2764)%」
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「응... 키스도... 괜찮을까요? %UNICODE(0x2764)%」
			CASE 1
				PRINTFORMW 「응... 가슴만... 그, 저쪽도... 부탁드려요... %UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
