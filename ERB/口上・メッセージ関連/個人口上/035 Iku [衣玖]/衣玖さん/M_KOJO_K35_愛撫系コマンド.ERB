@M_KOJO_MESSAGE_COM_k35_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「저, 저곳을 입으로라니……」
		PRINTFORML  불안한 표정을 짓지만 당신은 설득하는 행위로 들어간다.
		PRINTFORML 「거칠게 하지 말아 주세요…… 소중한 곳이니까……」
		PRINTFORMW  이쿠는 조심스럽게 두 다리를 벌려 당신을 맞이한다.
		PRINTFORML  우선 처음에는 귀두에 입을 맞추고,
		PRINTFORML  다음으로 양손의 엄지손가락 끝으로 부드럽게 음경의 열린 부분을 조금 넓혀 포피나 돌출된 음핵을 혀끝으로 가지고 논다.
		PRINTFORML  시간을 들여 혀로 음핵을 핥거나 때로는 빨리, 때로는 빨아 애무한다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		PRINTFORMW 
		PRINTFORMW 
		PRINTFORMW 
		PRINTFORMW 
		PRINTFORMW 
		PRINTFORMW 
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TCVAR:140
		PRINTFORML  약으로 완전히 만들어진 균열 속을, 혀끝으로 휘젓는다.
		PRINTFORML 「후아앗 %UNICODE(0x2764)%%UNICODE(0x2764)%」
		PRINTFORML  녹아내린 목소리를 내며 지금인가 언제쯤일까 하며 균열은 수축 운동을 하고 삽입을 기다린다.
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응……햐앙%UNICODE(0x2764)% 하아……흥%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORML  이쿠는 쾌감의 소리를 누르려 참으며 전희로 지치지 않도록 버티고 있다.
				PRINTFORMW  당신은 그녀의 사랑스러운 모습에 가학심을 키우며 더욱 혀로 괴롭히기 시작한다.
			CASE 1
				PRINTFORML 「냥... %UNICODE(0x2764)%거기만 계속... 하아앗 %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW  음핵을 집중적으로 핥고 빨며 절정으로 몰아붙인다.
			CASE 2
				PRINTFORML 「아, 후와아아 %UNICODE(0x2764)%%UNICODE(0x2764)% 거기는…… %UNICODE(0x2764)%」
				PRINTFORML  음핵이나 질구뿐만 아니라 때때로 요도구까지 자극하며 단숨에 몸을 이완시켜 삽입 준비를 시킨다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「음... 후우... 햐앗...」
			CASE 1
				PRINTFORMW 「흐윽... 더 상냥하게...」
		ENDSELECT
		PRINTFORMW  아직 익숙하지 않은 건지 몸이 경직되어 있어 아직 더 익숙해질 필요가 있을 것 같다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
