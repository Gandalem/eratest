@M_KOJO_MESSAGE_SCOM_k35_7
CALL M_KOJO_MESSAGE_SCOM_k35_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_k35_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「응구우%UNICODE(0x2764)%굉장해읏%UNICODE(0x2764)%깊숙한 곳까지 키스당하고 있어읏%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORML 「하아 안 돼 %UNICODE(0x2764)% 사정하고 바로 박히면 어떡해 히야우우 %UNICODE(0x2764)%%UNICODE(0x2764)%」
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	IF TCVAR:140
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「하지마아%UNICODE(0x2764)% 지쳤단 말야아%UNICODE(0x2764)%」
				PRINTFORML 「기분 조아아%UNICODE(0x2764)% 안쪽에에%UNICODE(0x2764)% 해줘어%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「응오오%UNICODE(0x2764)%%UNICODE(0x2764)% 속에서 부서지는 소리%UNICODE(0x2764)%하고 후우기이%UNICODE(0x2764)%」
		ENDSELECT
	ELSEIF TALENT:78
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「윽%UNICODE(0x2764)% 굉장해%UNICODE(0x2764)% 자궁에 닿고 있어어%UNICODE(0x2764)%」
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 더 깊은 곳에 사정해줘어%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「그렇게 %UNICODE(0x2764)% 안 돼! 아직 더 깊이 박히고 있잖아 %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORML 「더 깊이 사랑받고 있어 %UNICODE(0x2764)% 더 깊숙이 %UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 2
				PRINTFORML 「깊다아앗 %UNICODE(0x2764)% 엄마에게 괴롭힘당하는 게 좋아애 %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORML 「오옷! %UNICODE(0x2764)% 히구우 %UNICODE(0x2764)%」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「앙! %UNICODE(0x2764)% 그렇게 깊이...?」
			CASE 1
				PRINTFORML 「흐응 %UNICODE(0x2764)% 더더 %UNICODE(0x2764)% 좋아아 %UNICODE(0x2764)% 좋아앙 %UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
