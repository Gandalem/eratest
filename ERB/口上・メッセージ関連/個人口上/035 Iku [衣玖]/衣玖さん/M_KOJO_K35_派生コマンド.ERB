;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_k35_6
CALL M_KOJO_MESSAGE_SCOM_k35_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_k35_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「푸아앗 %UNICODE(0x2764)%! 음…… 뭐였어요…… 방금…」
		PRINTFORML  당신이 이쿠의 약한 곳을 발견하고 계속 괴롭히듯 콕콕 찌른다.
		PRINTFORML 「거기! 기분 좋아어 %UNICODE(0x2764)% 안 돼, 머리 아파아 넓게 해줘 %UNICODE(0x2764)%%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORML 「방금 %UNICODE(0x2764)% 사정했는데 말이야%UNICODE(0x2764)%」
			PRINTFORML 「거기 좋다고%UNICODE(0x2764)% 안 돼%UNICODE(0x2764)% 괴롭혀줘라%UNICODE(0x2764)%%UNICODE(0x2764)%」
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	IF TCVAR:140
		PRINTFORML 「히아우우%UNICODE(0x2764)%거기 조아아아%UNICODE(0x2764)%모로이 히메테에%UNICODE(0x2764)%%UNICODE(0x2764)%」
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응! %UNICODE(0x2764)%거기는 약하니까 안 돼!! %UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「기분 좋은 곳만 계속... 이상해지겠어...」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_k35_{SELECTCOM}_1
RETURN 1
