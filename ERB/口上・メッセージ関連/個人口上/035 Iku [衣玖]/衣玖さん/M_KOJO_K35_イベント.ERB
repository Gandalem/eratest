;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K35_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%? 무슨 용무이신가요?」
		ELSE
			PRINTFORML 「안녕하세요... 무슨 용무 있으신가요?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕
			PRINTFORML 「아, %CALLNAME:MASTER%! 잠시 시간 괜찮으세요?」
		ELSE
			PRINTFORML 「안녕하세요... 무엇을 하고 계신 건가요?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「온도는 어떤가요? 등을 주물러 드릴게요%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「아! 죄송해요! 당신이 여기에 있는 건 몰라서...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「저, 지금 시간대는 여성 전용입니다! 나가 주세요!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「어라? 이런 곳에서 우연이네요」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%……누구예요 그 아이는……」
			PRINTFORMW  등 뒤에서 갑자기 이쿠에게 말을 걸어 소름이 돋는다.
			PRINTFORML 「설명해 주세요…… 누구신 거죠…… 제대로 대답해주지 않으면……」
			PRINTFORMW  등에 단단하고 날카로운 것이 밀착된 채 당신은 이쿠에게 조금 둘러대면서 설명했다.
			PRINTFORMW 「모르겠어요! 집에 가면 꾸중이니까 각오해 주세요」
		ELSE
			PRINTFORML 「앗! 안녕하세요! 방해해서 죄송해요」
			PRINTFORMW (그런 아이가 취향인 걸까...)
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;朝起きたとき（おはよう口上）
