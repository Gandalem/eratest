			IF LOCAL:1
				PRINTFORML 「그렇습니까... 뭐, 다음에 기회가 있기를...」
				PRINTFORML  슬픈 듯 눈을 내리깔았다가, 억지로 하듯 얼굴을 들고 미소를 지었다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「앗 %CALLNAME:MASTER%!」
				PRINTFORML 「저기요... 우리 집에 놀러 오지 않겠어요...?」
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「후훗... 방도 깔끔하게 정리되어 있잖아요!」
				PRINTFORML  어딘가 자랑스럽게 말하는 이쿠를 따라 집 안으로 올라간다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「그, 그렇습니까...... 죄송해요...... 갑자기 초대해서......」
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
