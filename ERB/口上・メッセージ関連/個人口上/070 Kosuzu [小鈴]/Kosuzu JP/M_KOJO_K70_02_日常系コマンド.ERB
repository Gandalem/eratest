;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	IF FLAG:時間停止
		;押し倒され中, 地の文を参考に、全パターンあるわけではない模様
	ELSEIF CFLAG:70:うふふ == 2
		SIF !M_KOJO_JP_REWRITE_K70_UFUFU()
			RETURN 1
		SELECTCASE TCVAR:70:カウンター行動
			;胸を揉ませる
			CASE 33
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% %CALLNAME:MASTER%님이 좋아하는 가슴이에요❤ 마음껏 만끽해 주세요...❤」
					CASE 2
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "…❤ ")% 나의 가슴...❤ 더 괴롭혀줘...❤」
					CASEELSE
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 좋아... 기분이 좋아요❤ 더 해 주세요❤」
				ENDSELECT
				;パイズリ
			CASE 53
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 후훗❤ 가슴 어떠세요? 기분이 좋으신가요?」
					CASE 2
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 그런걸요❤ 지금은 제 차례인데 말이에요~❤」
					CASEELSE
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 안, 안 돼요! 제가 봉사하고 있잖아요~❤」
				ENDSELECT
				IF NOWEX:MASTER:射精
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「가슴 만지는 기분 좋으시죠❤ 기뻐요❤ 부디, 싸세요❤」
						CASE 2
							PRINTFORMW 「가버릴래요? 그럼 이대로 가슴에 싸주세요❤」
						CASEELSE
							PRINTFORMW 「앗! 가고 싶으신가 보네요❤ 부디❤ 마음껏 내보내세요❤」
					ENDSELECT
				ENDIF
				;ぱふぱふ
			CASE 73
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 가슴으로 머리가 가득 찬 거네요❤ 더 많이요❤」
					CASE 2
						PRINTFORMW 「그렇게 가슴 좋아해요? 그럼 가슴이랑 하나가 되자구요❤ 파후파후읏❤」
					CASEELSE
						PRINTFORMW 「%CALLNAME:MASTER%씨는 정말 가슴 좋아하시네요❤ 힘내세요❤」
				ENDSELECT
				;乳合わせ,これなに？
			CASE 74
				PRINTFORMW 「앗❤ 야앗❤ %CALLNAME:MASTER%씨 거 가슴에 닿았어❤」
				;乳を吸わせる
			CASE 77
				IF TALENT:[[小鈴]]:母乳体質
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 그렇게 줄이면 말이죠 %M_KOJO_JP_REWRITE_K70_AUTO("母乳")%나와버려요~♥」
						CASE 2
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 짜지면 %M_KOJO_JP_REWRITE_K70_AUTO("母乳")%로 가버릴 거야~♡」
						CASEELSE
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 싫어어❤ %M_KOJO_JP_REWRITE_K70_AUTO("母乳")%로 젖 먹을래어❤」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 그렇게 짜내도 %M_KOJO_JP_REWRITE_K70_AUTO("母乳")%는 안 나와요❤」
						CASE 2
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 짜져버릴 거야~❤」
						CASEELSE
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 주세요~❤ 더 짜주세요~❤」
					ENDSELECT
				ENDIF
				;Ｖ挿入,Ａ挿入,Ｖ腰振り,Ａ腰振り
			CASE 85, 87, 88, 89
				PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 3)%%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 이제 그만해❤」
				IF NOWEX:MASTER:射精
					CALL M_KOJO_JP_REWRITE_K70_日常愛撫("射精")
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 가슴도 같이 기분 좋아요」
						CASE 2
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 그런가아❤ 동시에❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
						CASEELSE
							PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 지금은 안 돼❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 안 돼에❤」
					ENDSELECT
				ENDIF
				;だいしゅきホールド
			CASE 86
				PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 3)%%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 이제 그만해❤」
				CALL M_KOJO_JP_REWRITE_K70_DAISHUKI_HOLD("胸愛撫")
				;それ以外
			CASEELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 가 가슴을 좋아하시는군요❤ 마음껏 즐겨주세요❤」
					CASE 2
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 내 마음은 어때요...? %CALLNAME:MASTER%당이 좋아준다면 기뻐요...❤」
					CASEELSE
						PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 정말 가슴이 너무 좋아요~❤」
				ENDSELECT
		ENDSELECT
	ELSEIF CFLAG:70:睡眠
		CALL M_KOJO_JP_REWRITE_K70_日常愛撫("睡眠")
		;酔ってる
	ELSEIF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		CALL M_KOJO_JP_REWRITE_K70_DRUNK("胸愛撫")
		;発情中
	ELSEIF TCVAR:[[小鈴]]:発情
		CALL M_KOJO_JP_REWRITE_K70_HATSUJO("胸愛撫")
		;不機嫌
	ELSEIF M_KOJO_JP_REWRITE_K70_FUKIGEN([[小鈴]])
		CALL M_KOJO_JP_REWRITE_K70_日常愛撫("不機嫌")
		;イっちゃう
	ELSEIF NOWEX:[[小鈴]]:Ｂ絶頂
		CALL M_KOJO_JP_REWRITE_K70_日常愛撫("絶頂")
	ELSE
		CALL M_KOJO_JP_REWRITE_K70_日常愛撫("胸愛撫")
	ENDIF
ENDIF
RETURN 1
