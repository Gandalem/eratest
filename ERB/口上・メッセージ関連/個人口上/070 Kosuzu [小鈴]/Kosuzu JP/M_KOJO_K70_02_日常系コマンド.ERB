	;[酒に弱い]ので どぶろく=10, 清酒=8, 鬼殺し=5
	IF M_KOJO_JP_REWRITE_K70_ALCOHOL_FACE(TCVAR:[[小鈴]]:382) == "ぐでぐで"
		PRINTFORMW 「끄으으…… 」
	ELSEIF M_KOJO_JP_REWRITE_K70_ALCOHOL_FACE(TCVAR:[[小鈴]]:382) == "酔いどれ"
