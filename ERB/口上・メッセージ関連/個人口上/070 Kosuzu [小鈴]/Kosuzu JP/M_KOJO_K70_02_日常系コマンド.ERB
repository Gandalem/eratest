@KOSUZU_BI(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "❤"
		IF TALENT:[[小鈴]]:恋慕
			RETURNF "❤"
		ELSE
			RETURNF ""
		ENDIF
	CASE "！❤"
		IF TALENT:[[小鈴]]:恋人
			RETURNF "❤"
		ELSE
			RETURNF "！"
		ENDIF
	CASE "！♪"
		IF TALENT:[[小鈴]]:恋慕
			RETURNF "♪"
		ELSE
			RETURNF "！"
		ENDIF
	CASE "？♪"
		IF ABL:[[小鈴]]:親密 >= 5
			RETURNF "♪"
		ELSE
			RETURNF "？"
		ENDIF
ENDSELECT
