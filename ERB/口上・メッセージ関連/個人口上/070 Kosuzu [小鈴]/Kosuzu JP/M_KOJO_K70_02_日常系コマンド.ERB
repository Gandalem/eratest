;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	PRINTFORMD %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"와")% 함께
	SELECTCASE CFLAG:[[小鈴]]:現在位置
		CASE 商家町
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMD 식당에서
				CASE 2
					PRINTFORMD 소바집에서
				CASE 3
					PRINTFORMD 예론정에서
				CASEELSE
					PRINTFORMD 요리점에서
			ENDSELECT
		CASE 竹林入り口
			PRINTFORMDL 미스티아의 노점에서
		CASE 中有の道
			PRINTFORMD 길가 노점에서
		CASE 旧地獄街道
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMD 지하 찻집에서
				CASE 2
					PRINTFORMD 요괴 카페에서
				CASEELSE
					PRINTFORMD 지옥 요리점에서
			ENDSELECT
	ENDSELECT
	IF CFLAG:[[小鈴]]:現在位置 == 竹林入り口
		PRINTFORMDL 여덟 번째 장어를 먹었어
	ELSE
		SELECTCASE TIME
			CASE 240 TO 599
				PRINTFORMDL 아침 식사를 했다.
			CASE 600 TO 839
				PRINTFORMDL 점심을 먹었다
			CASE 840 TO 1019
				PRINTFORMDL 조금 늦게 점심을 먹었어
			CASE 1020 TO 1199
				PRINTFORMDL 저녁을 먹었다
			CASE 1200 TO 1440
				PRINTFORMDL 저녁 식사를 했다
			CASEELSE
				PRINTFORMDL 야식을 먹었다
		ENDSELECT
	ENDIF
	PRINTW 
	;酔ってる
	IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		CALL M_KOJO_JP_REWRITE_K70_DRUNK("食事に誘う")
		;発情中
	ELSEIF TCVAR:[[小鈴]]:発情
		PRINTFORMW 「식사를 하고 정을 붙인 후에라는 거네요...❤」
	ELSE
		PRINTFORML 「에엥, 식사 대접받아도 되는 거예요!」
		PRINTFORMW 「그럼 말씀에 응해볼게요♪」
		PRINTL 
		IF TFLAG:SELECTCOMの分岐 == 1
			PRINTFORML 「음~♪ 이 요리 정말 맛있어요~!」
			PRINTFORMW 「좋은 가게였네요! 또 오기로 해요♪」
			PRINTL 
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 만족스러운 모습이다
		ELSEIF TFLAG:SELECTCOMの分岐 == -1
			PRINTFORML 「음~음…… 이 양념은 저한테는 좀……」
			PRINTFORMW 「죄송해요, 남은 건 %CALLNAME:MASTER%님께 드릴게요……」
			PRINTL 
			PRINTFORMDW ……%조사처리(CALLNAME:TARGET,"는")% 별로 안 먹은 것 같아…
		ELSE
			SELECTCASE CFLAG:[[小鈴]]:現在位置
				CASE 商家町
					SELECTCASE RAND:4
						CASE 1
							PRINTFORMW 「여기 요리, 먹어보고 싶었거든요~」
						CASE 2
							PRINTFORMW 「아우우…… 다 맛있어 보여…… 어라, 침이 고여버렸네읏」
						CASE 3
							PRINTFORMW 「아, %CALLNAME:MASTER%씨, 이 요리 추천해요!」
						CASEELSE
							PRINTFORMW 「응~! 맛있어요~♪」
					ENDSELECT
				CASE 竹林入り口
