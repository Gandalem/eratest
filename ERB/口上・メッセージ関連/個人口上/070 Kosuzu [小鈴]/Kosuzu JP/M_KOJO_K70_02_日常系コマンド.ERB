;会話セットver.2.0
;恋人の時は恋人会話＋恋慕会話＋友好会話＋汎用会話＋阿求会話
;恋慕の時は恋慕会話＋友好会話＋汎用会話＋阿求会話
;思慕の時は思慕会話＋友好会話＋汎用会話＋阿求会話
;初期の時は初期会話＋汎用会話
;がそれぞれ等確率で発生するような仕組み
;ARGS,会話分類
;ARG:0,状況会話の番号,ゲストのキャラ番号
;ARG:1,状況会話用の引数,ゲストの引数
;ARGS:1,ゲスト会話のコマンド
;==================================================

@M_KOJO_JP_REWRITE_K70_TALKSET(ARGS, ARG, ARG:1, ARGS:1)
#DIM 恋人会話数
#DIM 恋慕会話数
#DIM 思慕会話数
#DIM 汎用会話数
#DIM 友好会話数
#DIM 阿求会話数
恋人会話数 = 13
恋慕会話数 = 40
思慕会話数 = 14
友好会話数 = 17
汎用会話数 = 9
阿求会話数 = 11
SELECTCASE ARGS
	CASE "恋人"
		;恋人でのみ発生する会話
		SELECTCASE RAND:(恋人会話数 + 恋慕会話数 + 友好会話数 + 汎用会話数 + 阿求会話数)
			CASE 1
				PRINTFORML 「이렇게 %조사처리(CALLNAME:MASTER,"의")% 옆에 있으면, 왠지 안심된다.」
				PRINTFORMW 「더 가까이 다가가도… 괜찮을까?」
			CASE 2
				PRINTFORML 「뚫어져라 쳐다보고, 무슨 일 있어요?」
				PRINTFORMW 「후후, 판독안은 겉모습만 보고 알 수 없답니다?」
			CASE 3
				PRINTFORML 「지금은 레이무 씨나 마리사 씨가 뒤를 지켜주고 있지만」
				PRINTFORMW 「앞으로는 %조사처리(CALLNAME:MASTER,"에게")% 뒤를 봐 달라고 생각하고 있어요♪」
			CASE 4
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 언젠가 바깥세상으로 돌아가는 날이 오는 건가요...?」
				PRINTFORML 「싫어요! 떨어져 있게 되는 건 싫단 말이에요~!」
				PRINTFORMW 「그렇게 된다면 저 따라갈 거예요! 」
			CASE 5
				PRINTFORML 「다음 데이트는 어디로 갈까요~」
				PRINTFORMW 「아! 그러고 보니 제가 하고 싶은 게 있었어요!」
			CASE 6
				PRINTFORML 「니헤에~……」
				PRINTFORMW 「핫! 죄송합니다, 잠시 방심하고 있었습니다…❤」
			CASE 7
				PRINTFORML 「엣, %CALLNAME:MASTER%씨 그런 거 신경 쓰고 계셨어요?」
				PRINTFORMW 「저는 %CALLNAME:MASTER%씨의 그런 점이 좋아요~」
			CASE 8
				PRINTFORML 「저기……. 좀 부끄러운 걸 듣고 싶은데요……」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 제 어디를 좋아해 주셨어요?」
			CASE 9
				PRINTFORML 「연인에게는 장애가 딸려오는 법이죠」
				PRINTFORMW 「하지만 마지막엔 해피엔딩이 되는 것도 정해져 있어요!」
			CASE 10
				PRINTFORML 「이렇게 %조사처리(CALLNAME:MASTER,"랑")% 느긋하게 이야기하는 시간도, 저는 정말 좋아해요」
				PRINTFORMW 「물론, 그 다음 일들도 기대하고 있어요…❤」
			CASE 11
				PRINTFORML 「%CALLNAME:MASTER%씨옷❤」
				PRINTFORMW 「후후, 부른 것뿐입니다♪」
			CASE 12
				PRINTFORML 「만약 나를 가질 것인가, 세계를 가질 것인가라고 강요받는다면, %CALLNAME:MASTER%씨는 어떻게 하실 거예요?」
				PRINTFORMW 「저, 제가 직접 물어보는 건 반칙이었나요……」
			CASE 13
				IF CFLAG:[[小鈴]]:子供人数 > 1
					PRINTFORML 「만약 %CALLNAME:MASTER%님이 괴로운 일이나 고난에 좌절한다면, 저나 %CHILDNAME:[[小鈴]]:(CFLAG:[[小鈴]]:子供人数 % 10)%들이 있다는 것을 기억해 주세요」
				ELSEIF CFLAG:[[小鈴]]:子供人数
					PRINTFORML 「만약 %CALLNAME:MASTER%님이 괴로운 일이나 고난에 좌절한다면, 저나 %CHILDNAME:[[小鈴]]:1%가 있다는 것을 기억해 주세요」
				ELSE
					PRINTFORML 「만약 %조사처리(CALLNAME:MASTER,"가")% 힘들거나 고난에 지친다면, 내가 있다는 걸 기억해줘」
				ENDIF
				PRINTFORMW 「저의 \@ CFLAG:[[小鈴]]:子供人数 ? 아이들 #  \@는 언제나 %CALLNAME:MASTER%님을 생각하고 있으니까요옷!」
			CASEELSE
				ARGS = 恋慕
				RESTART
		ENDSELECT
	CASE "恋慕"
		;恋人でも発生する会話
		SELECTCASE RAND:(恋慕会話数 + 友好会話数 + 汎用会話数 + 阿求会話数)
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%씨는 요괴가 안 무서워요?」
				PRINTFORMW 「그거 역시 실력이 있다는 거겠죠…… 부럽다아」
			CASE 2
				PRINTFORML 「아하하, %CALLNAME:MASTER%씨에게도 그런 어린 시절이 있었군요, 귀여워요」
				PRINTFORMW 「저 말이에요? 에에, 부끄럽지만…… 예를 들자면――」
			CASE 3
