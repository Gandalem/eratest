					ELSEIF GET_MONTH() == "冬の月"
						PRINTFORML 「후훗, 몸을 따뜻하게 데우기에 딱 좋네요!」
					ENDIF
					PRINTFORMW 「그럼, 잘 먹겠습니다」
					;冷たい
				ELSEIF STRCOUNT(DISH_TASTE, "冷たい")
					IF GET_MONTH() == "夏の月"
						PRINTFORML 「이걸 먹고 더위를 이겨내자!」
					ELSEIF GET_MONTH() == "冬の月"
						PRINTFORML 「이걸 먹으면 몸이 차가워지잖아요……」
					ENDIF
					PRINTFORMW 「그럼, 잘 먹겠습니다」
				ELSE
					PRINTFORMW 「그럼, 잘 먹겠습니다」
				ENDIF
		ENDSELECT
		;一緒に作ってない
	ELSE
		SELECTCASE DISHNAME
			CASE "おせち料理"
				PRINTFORML 「와아! 오세치 요리 좋네요~!」
				PRINTFORML 「저도 드셔도 돼요? 감사합니다~!」
				PRINTFORML 「그럼, 잘 먹겠습니다」
				PRINTW 
				PRINTFORMW 「역시 오세치를 먹고 있으면 새해 느낌이 나네요~」
			CASE "年越し蕎麦"
				PRINTFORML 「와! 연말 국수인가~!」
				PRINTFORML 「저도 드셔도 돼요? 감사해요~!」
				PRINTFORML 「그럼, 잘 먹겠습니다」
				PRINTW 
				IF TALENT:70:恋慕 && TALENT:70:思慕
					PRINTFORMW 「올해도 일년 동안 신세 많이 졌어요~」
				ELSE
					PRINTFORMW 「올해도 여러 가지 일이 있었네요」
				ENDIF
			CASE "恵方巻"
				PRINTFORML 「그러고 보니 오늘은 세츠분이었네요」
				PRINTFORMW 「음, 올해의 에호우 방향은……%EHOU_DIRECTION()%이군요」
				PRINTFORML 「그럼, 잘 먹겠습니다」
				PRINTW 
				PRINTFORMW 「……」
				PRINTFORMW 「…………」
				PRINTFORMW 「………………………………」
			CASE "ドーピングコンソメスープ"
				PRINTFORMW 「아라, 식사하실 수 있는 거예요? 감사합니다~」
				IF FIRSTTIME("ドーピングコンソメスープ", 1)
					PRINTFORMW 「%CALLNAME:MASTER%씨는 안 드세요?」
					PRINTFORMW 「에? 주사기? 어라, %CALLNAME:MASTER%씨, 뭐 하시는 거예요……?」
				ELSE
					PRINTFORMW 「핫, 이것은 도핑 콘소메 수프…….」
					PRINTFORMW 「설마 범인은……」
				ENDIF
			CASE "モッツァレラチーズとトマトのサラダ"
				PRINTFORML 「아라, 식사하실 수 있어요? 감사합니다~」
				PRINTFORML 「그럼, 잘 먹겠습니다」
				PRINTW 
				PRINTFORML 「이거 정말 맛있네요!」
				PRINTFORMW 「왠지 어깨 결림이 풀리는 기분입니다!」
			CASE "義大莉而鳥苗鳥肉"
				PRINTFORML 「아라, 식사하실 수 있나요? 감사하구……」
				PRINTFORML 「우에~, 이게 뭐예요…… 뭔가 벌레 같은 게……」
				PRINTFORMW 「정말 드시는 거예요……?」
			CASE "ギンギー料理"
				PRINTFORMW 「이거 무슨 요리예요?」
				PRINTFORMDW 긴기요리
				PRINTFORMW 「재료는 뭔가요?」
				PRINTFORMDW 긴기
				PRINTFORMW 「…………」
			CASE "お子様ランチ", "紅魔ランチ"
				PRINTFORML 「아, 식사하실 수 있나요? 감사합니다~」
				PRINTFORMW 「와! 귀여운 요리네요♪」
				PRINTFORMW 「그럼, 잘 먹겠습니다」
			CASE "鈴カステラ"
				PRINTFORML 「아, 저의 스즈 카스테라를 만들어 주셨군요!」
				PRINTFORMW 「왠지 조금 기뻐요♪」
				PRINTFORML 「제대로 맛있게 만들었는지 확인해 보겠어요~」
				PRINTFORMW 「잘 먹겠습니다~♪」
			CASE "求聞雑炊"
				PRINTFORML 「아라, 식사 가능하신가요? 감사합니다~」
				PRINTFORML 「아, 이거 아큐의 집에서 내시는 요리군요」
				PRINTFORMW 「기억력이 좋아진다는 이야기는 사실인가요」
				PRINTFORMW 「그럼, 잘 먹겠습니다」
			CASE "ウミガメのスープ"
				PRINTFORML 「아라, 식사하실 수 있는 건가요? 감사합니다~」
				PRINTFORMW 「이거, 무슨 스튜예요?」
				PRINTFORML 「에? 바다거북 스튜? 바다거북이라니……?」
				PRINTFORMW 「불길한 기운이 감돌고 있지만…… 잘 먹겠습니다……」
			CASE "鯢呑亭秘伝の煮付け"
				PRINTFORML 「아라, 식사하실 수 있어요? 감사해요~」
				PRINTFORML 「아, 이거 게노테이에서 인기 있는 요리네요」
				PRINTFORMW 「정말 맛있잖아요~!」
				PRINTFORMW 「그럼, 잘 먹겠습니다.」
			CASE "ショートケーキ", "チョコレートケーキ", "ハロウィンケーキ", "クリスマスケーキ"
				PRINTFORML 「와아! 드셔 주시는 거예요!?」
				PRINTFORML 「굉장히 호화로운 케이크예요! 감사해요~♪」
				PRINTFORMW 「그럼, 사양 없이…… 잘 먹겠습니다♪」
			CASEELSE
				;禁断
				IF STRCOUNT(DISH_TASTE, "ローター") || STRCOUNT(DISH_TASTE, "謎料理")
					PRINTFORML 「아라, 식사하실 수 있나요? 고마워요……」
					PRINTFORMW 「저기, 이건…… 요리인가...? 먹을 수 있어요...?」
					PRINTFORMW 「저... 먹겠습니다...」
					;カエル
				ELSEIF STRCOUNT(DISH_TASTE, "カエル")
					PRINTFORML 「그, 닭고기 같은 맛이라고 하던 것 같은데요……」
					PRINTFORMW 「잘, 먹겠습니다……」
					;グロテスク
				ELSEIF STRCOUNT(DISH_TASTE, "虫肉") || STRCOUNT(DISH_TASTE, "グロテスク") || STRCOUNT(DISH_TASTE, "地獄風")
					PRINTFORML 「아, 식사하실 수 있나요? 감사해드려요……」
					PRINTFORML 「저, 저기…… 이거…… 요리인 거죠…… 네……」
					PRINTFORMW 「하……시겠습니……다……」
					;軽食
				ELSEIF DISH_TYPE == "軽食"
					PRINTFORML 「아라, 저도 드실 수 있는 거예요? 감사합니다~」
					PRINTFORMW 「그럼, 잘 먹을게요」
					;デザート
				ELSEIF DISH_TYPE == "デザート"
					PRINTFORML 「와아! 드셔 주시는 건가요!? 감사합니다~♪」
					PRINTFORMW 「그럼, 사양 없이... 잘 먹겠습니다♪」
					;温かい
				ELSEIF STRCOUNT(DISH_TASTE, "温かい")
					PRINTFORML 「아라, 저에게도 주시는 거예요? 고마워요~」
					IF GET_MONTH() == "夏の月"
						PRINTFORML 「앗! 뜨거워! 땀 흘릴 것 같아……」
					ELSEIF GET_MONTH() == "冬の月"
						PRINTFORML 「와아~ 따뜻해! 이거 먹으니까 포근하다~」
					ENDIF
					PRINTFORMW 「그럼, 잘 먹겠습니다」
					;冷たい
				ELSEIF STRCOUNT(DISH_TASTE, "冷たい")
					PRINTFORML 「아라, 저에게도 주시는 거예요? 고마워요~」
					IF GET_MONTH() == "夏の月"
						PRINTFORML 「와아~! 차가워서 여름에는 딱이네요~」
					ELSEIF GET_MONTH() == "冬の月"
						PRINTFORML 「윽! 차가워! 몸이 식어버릴 것 같아……」
					ENDIF
					PRINTFORMW 「그럼, 잘 먹겠습니다」
				ELSE
					PRINTFORML 「아라, 식사하실 수 있어요? 감사합니다~」
					PRINTFORMW 「그럼, 잘 먹겠습니다」
				ENDIF
		ENDSELECT
	ENDIF
	;味の評価
	PRINTL 
	;阿求と作った
	SIF DISH_ASSI == [[阿求]]
		PRINTFORML 「엣, 이 요리 아큐랑 같이 만든 거예요? 후우음……」
	;ドッキリ味
	IF STRCOUNT(DISH_TASTE, "ドッキリ味/") || STRCOUNT(DISH_TASTE, "未知の味/")
		PRINTFORML 「우...윽! 이게 뭔데요...?」
		PRINTFORMW 「왠지 이상한 맛이 나지 않으세요...?」
		IF TCVAR:[[小鈴]]:料理評価値 >= 700
			PRINTFORMW 「음~ 그렇지만 신기하게 맛있네요」
		ELSEIF TCVAR:[[小鈴]]:料理評価値 >= 500
			PRINTFORMW 「음음…… 이상하게 맛이 나쁘지 않네요~」
		ELSE
			PRINTFORMW 「우윽…… 배가 아파지기 시작했어요……」
		ENDIF
		;低評価
	ELSEIF TCVAR:[[小鈴]]:料理評価値 < 700
		;辛い
		IF STRCOUNT(DISH_TASTE, "辛い")
			PRINTFORMW 「히으윽! 매워, 후우……!」
			;阿求と作った
		ELSEIF DISH_ASSI == [[阿求]]
			;悪い
			IF TCVAR:[[小鈴]]:料理評価値 < 500
				PRINTFORMW 「흥…… 아큐 같은 녀석한테 만들게 하다니……」
				;……まあまあだ。
			ELSEIF TCVAR:[[小鈴]]:料理評価値 < 600
				PRINTFORML 「흠... 그럭저럭이군~」
				PRINTFORMW 「아큐는 요리를 잘하는 건가?」
				;おいしい
			ELSE
				PRINTFORML 「응~! 맛있어요~」
				PRINTFORMW 「아큐도 꽤 하는구만~」
			ENDIF
		ELSE
			IF TCVAR:[[小鈴]]:料理評価値 < 500
				PRINTFORMW 「음~…… 이 양념은 나한테는 좀…….」
				;……まあまあだ。
			ELSEIF TCVAR:[[小鈴]]:料理評価値 < 600
				PRINTFORMW 「변변하네~」
				;おいしい
			ELSE
				PRINTFORMW 「맛있네요~!」
			ENDIF
		ENDIF
		;高評価
	ELSE
		;味チェック
		LOCALS =
		WHILE LOCALS == ""
		SELECTCASE RAND:13
			CASE 1
				SIF STRCOUNT(DISH_TASTE, "甘い")
					LOCALS = 甘い
			CASE 2
				SIF STRCOUNT(DISH_TASTE, "和食")
					LOCALS = 和食
			CASE 3
				SIF STRCOUNT(DISH_TASTE, "麺類")
					LOCALS = 麺類
			CASE 4
				SIF STRCOUNT(DISH_TASTE, "すっぱい")
					LOCALS = すっぱい
			CASE 5
				SIF STRCOUNT(DISH_TASTE, "あっさり")
					LOCALS = あっさり
			CASE 6
				SIF STRCOUNT(DISH_TASTE, "淡白")
					LOCALS = 淡白
			CASE 7
				SIF STRCOUNT(DISH_TASTE, "上品")
					LOCALS = 上品
			CASE 8
				SIF STRCOUNT(DISH_TASTE, "もちもち")
					LOCALS = もちもち
			CASE 9
				SIF STRCOUNT(DISH_TASTE, "外界風")
					LOCALS = 外界風
				;ここから先は好きな味ではない
			CASE 10
				SIF STRCOUNT(DISH_TASTE, "サクサク")
					LOCALS = サクサク
			CASE 11
				SIF STRCOUNT(DISH_TASTE, "ぷるぷる")
					LOCALS = ぷるぷる
			CASE 12
				SIF STRCOUNT(DISH_TASTE, "不思議")
					LOCALS = 不思議
			CASEELSE
				LOCALS = その他
		ENDSELECT
		WEND
		SELECTCASE LOCALS
			CASE "甘い"
				PRINTFORMW 「음~♪ 달콤하고 맛있다~♪」
			CASE "和食"
				PRINTFORMW 「역시 일식(화식)이 좋아요~」
			CASE "麺類"
				PRINTFORMW 「후루룩...! 저, 면류는 좋아한답니다~」
			CASE "すっぱい"
				PRINTFORMW 「음~!! 시큼해서 맛있어요~」
			CASE "あっさり"
				PRINTFORMW 「음~!! 깔끔해서 맛있어요~!」
			CASE "淡白"
				PRINTFORMW 「음~!! 부드러운 맛이 좋네요~!」
			CASE "上品"
				PRINTFORMW 「음~...! 고급스러운 맛이 좋네요~!」
			CASE "もちもち"
				PRINTFORMW 「음~♪ 말랑말랑해서 맛있다~♪」
			CASE "外界風"
				PRINTFORMW 「이게 외계의 맛……! 맛있어요읏!」
			CASE "サクサク"
				PRINTFORMW 「바삭한 식감이라 정말 좋아요~!」
			CASE "ぷるぷる"
				PRINTFORMW 「후훗♪ 부르르 떨고 있어서 귀엽네요♪」
			CASE "不思議"
				PRINTFORMW 「음~? 신기한 맛이긴 하지만, 맛있어요!」
			CASEELSE
				;すごくおいしい
				IF TCVAR:[[小鈴]]:料理評価値 < 850
					PRINTFORMW 「이거 엄청 맛있어요~!」
					;大好き
				ELSE
					PRINTFORMW 「나 이거 완전 좋아할지도 몰라~!」
				ENDIF
		ENDSELECT
		;阿求と作った
		IF DISH_ASSI == [[阿求]]
			PRINTFORML 「아큐는 이렇게 요리를 잘하는 거야~」
			IF TALENT:[[小鈴]]:恋慕
				PRINTFORMW 「아니면 %CALLNAME:MASTER%씨 덕분일까요?」
			ELSE
				PRINTFORMW 「좀 다시 살펴봤더니 말이야♪」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
