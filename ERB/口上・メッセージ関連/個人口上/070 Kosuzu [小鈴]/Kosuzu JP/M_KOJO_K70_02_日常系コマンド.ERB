IF LOCAL
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	;した
	IF TFLAG:SELECTCOMの分岐
		;初めて
		IF FIRSTTIME("告白")
			IF TALENT:70:恋慕
				PRINTFORMW 「우으…… 기뻐요오~!!」
				PRINTL 
				PRINTFORMDL 　꽉
				PRINTFORMDL 코스즈는 환희에 울음을 터뜨리며 %조사처리(CALLNAME:MASTER,"를")% 안았다
				PRINTW 
				PRINTFORMW 「저도 %CALLNAME:MASTER%씨를 좋아했어요……!」
				PRINTFORMW 「하지만, 입 밖에 내는 게 무서워서…… 관계가 깨져버릴까 봐 생각했거든요……」
				PRINTFORMW 「그래서 너무 기뻐요…… 지금 정말 행복해요……❤」
				;日記を書く
				CALL M_KOJO_JP_REWRITE_DIARYSETTING_K70(43)
			ELSE
				PRINTFORMW 「에, 에에에엣!?」
				PRINTFORMW 「정말이세요……?」
				PRINTFORMW 「그런 걸…… 갑자기 말씀하셔도…… 하지만……」
				PRINTFORMW 「하지만…… 네, 좋아요…… %CALLNAME:MASTER%씨라면……」
				PRINTFORMW 「불안한 부분은 있지만, 분명 %CALLNAME:MASTER%씨라면 저를 소중히 대해 주실 거예요……」
				PRINTFORMW 「저도 %CALLNAME:MASTER%씨를 좋아할 수 있을 것 같아요… 그러니까……」
				;日記を書く
				CALL M_KOJO_JP_REWRITE_DIARYSETTING_K70(44)
			ENDIF
			;一度フった,都合のいい奴じゃ！
		ELSE
			;告白口上と同じ,こちらは恋慕のみしかない、はず
			PRINTFORMW 「정, 정말이세요...? 저, 괜찮으신 거예요...?」
			PRINTFORMW 「우, 기뻐요... 다행이다아...」
			PRINTFORMW 「저, 미움받은 건 아닐까…… 계속 무서웠단 말이에요...」
			PRINTFORMW 「하지만 희망을 버리지 않고 있어 다행이에요... %CALLNAME:MASTER%님이 받아주셔서... 정말 다행이야...」
			;日記を書く
			CALL M_KOJO_JP_REWRITE_DIARYSETTING_K70(45)
		ENDIF
		IF TALENT:70:恋慕
			PRINTL 
			PRINTFORMDL 사랑이 이루어진 두 사람은 조용히 서로에게 기댄 채, 달콤한 분위기 속에 어느새 입맞춤을 나누었다…….
			PRINTW 
			EXP:70:キス経験 += 1
			EXP:70:Ｍ経験 += 1
			EXP:MASTER:Ｍ経験 += 1
			EXP:MASTER:キス経験 += 1
			IF FIRSTTIME("ファーストキス")
				CALL SET_FIRSTKISS(70)
				;［告白する］の条件が二人きり
				IF M_KOJO_JP_REWRITE_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
					CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、誰も居なくなった静かな鈴奈庵で恋い焦がれていた%CALLNAME:MASTER%の告白を受け、幸せなムードの中で契りのファーストキスを捧げた
				ELSEIF M_KOJO_JP_REWRITE_K70_SUZUNAAN(CFLAG:70:現在位置) == 2
					CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、自分の部屋で恋い焦がれていた%CALLNAME:MASTER%の告白を受け、幸せなムードの中で契りのファーストキスを捧げた
				ELSEIF FLAG:デート相手 == 70
					CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、%DATENAME_PLACE()%でデート中、%DATENAME_PLACE()%で恋い焦がれていた%CALLNAME:MASTER%の告白を受け、幸せなムードの中で契りのファーストキスを捧げた
				ELSE
					CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、%NAME_FROM_PLACE(CFLAG:70:現在位置)%で恋い焦がれていた%CALLNAME:MASTER%の告白を受け、幸せなムードの中で契りのファーストキスを捧げた
				ENDIF
			ENDIF
			CALL M_KOJO_JP_REWRITE_COLOR_K70
			PRINTFORMW 「후훗……❤ 앞으로 어떤 일이 생길지 모르겠지만――」
			PRINTFORMW 「계속 같이 있어 주면 좋겠어♪ %CALLNAME:MASTER%씨❤」
		ENDIF
		;言葉に詰まる
	ELSE
		PRINTFORML 「？」
		PRINTFORMW 「%CALLNAME:MASTER%씨, 무슨 일이에요?」
	ENDIF
ENDIF
RETURN 1
