;胸愛撫,クリ愛撫,指挿入れ用

@M_KOJO_JP_REWRITE_K70_日常愛撫(ARGS)
SELECTCASE ARGS
	CASE "怒る"
		;理論上できなくないけど、計算式が関数ではなく判定フラグも無いのでやめておく
	CASE "不機嫌"
		IF TALENT:[[小鈴]]:恋慕
			PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "…！")%」
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「미안해요... 지금은 기분이 아니에요...」
				CASE 2
					PRINTFORMW 「죄송해요… 지금은 그만해 주세요……」
				CASEELSE
					PRINTFORMW 「그만, 그만해 주세요...!」
			ENDSELECT
			BASE:70:怒り += MAXBASE:70:怒り / 4
		ELSE
			PRINTFORMW 「그만두세요읏!」
			BASE:70:怒り += MAXBASE:70:怒り / 3
		ENDIF
	CASE "絶頂"
		PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")%」
		SELECTCASE RAND:8
			CASE 1
				PRINTFORMW 「안 돼...! 지금 만지면…… 아앗❤」
			CASE 2
				PRINTFORMW 「싫어...! 이제 안 돼...읏❤️」
			CASE 3
				PRINTFORMW 「잠깐만 기다려 주세…! 잠깐…앗❤」
			CASE 4
				PRINTFORMW 「그, 거긴 안돼요…… 아우윽❤」
			CASE 5
				PRINTFORMW 「응읏, 이제…… 안돼애...♡」
			CASE 6
				PRINTFORMW 「싫어어...읏! 응...읏❤」
			CASE 7
				PRINTFORMW 「잠깐…! 위험해요읏……아❤」
			CASEELSE
				PRINTFORMW 「앗... 그 이상은......읏❤」
		ENDSELECT
	CASE "睡眠"
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「응...! 간지러워아...」
			CASE 2
				PRINTFORMW 「음응...! 포아~……」
			CASE 3
				PRINTFORMW 「응음~...! 음냐......」
			CASE 4
				PRINTFORMW 「응읏...! 무슨 일이야아~...」
			CASEELSE
				PRINTFORMW 「음~...! 후냐아~……」
		ENDSELECT
	CASE "射精"
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「이 군이네요읏❤ 잔뜩!!❤ 싸줘!!❤ 주세요읏❤」
			CASE 2
				PRINTFORMW 「네에❤ 싸주세요❤ 저에게❤ 내줘요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ")%」
			CASE 3
				PRINTFORMW 「부디~ ❤ 저를~ ❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ")% 주세요~ ❤」
			CASEELSE
				PRINTFORMW 「와줘❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ")% 그대로 와주세요❤ 해줘~❤」
		ENDSELECT
		;胸,クリ,膣
	CASEELSE
		IF TALENT:[[小鈴]]:恋慕 && CFLAG:[[小鈴]]:溜まってる度 >= 750
			PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "…❤")%」
		ELSE
			PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "…！")%」
		ENDIF
		IF TALENT:[[小鈴]]:恋慕
			;簡易同室人チェック
			IF TARGET:2
				;ゲストキャラ判定
				CALL M_KOJO_JP_REWRITE_K70_GUEST("日常愛撫")
				IF RESULT
					SELECTCASE RAND:4
						CASE 1
							PRINTFORMW 「저, 잠깐만요! %RESULTS:1%가 계시잖아요!」
						CASE 2
							PRINTFORMW 「%RESULTS:1%가 있는데…… 안 돼요...!」
						CASE 3
							PRINTFORMW 「이제...!! %RESULTS:1%가 있는 앞이라고우...!」
						CASE 4
							PRINTFORMW 「저기...! %RESULTS:1%가 이쪽 보고 있어요...!」
						CASEELSE
							PRINTFORMW 「%RESULTS:1%에게 들키면 어떡해욧...!」
					ENDSELECT
				ELSE
					SELECTCASE RAND:4
						CASE 1
							PRINTFORMW 「저, 저기! 사람 있잖아요!」
						CASE 2
							PRINTFORMW 「앗…… 목소리 들켜버린 것 같아……」
						CASE 3
							PRINTFORMW 「사람들 앞에서 만지는 건, 그, 치한이잖아요...!」
						CASEELSE
							PRINTFORMW 「사람들이 보고 있잖아요……!」
					ENDSELECT
				ENDIF
				;野外,確率
			ELSEIF !RAND:3 && OUTROOF(CFLAG:[[小鈴]]:現在位置)
				SELECTCASE RAND:4
					CASE 1
						PRINTFORMW 「저, 저기! 여기는 외부잖아요...!」
					CASE 2
						PRINTFORMW 「이제……! 사람들에게 들리면 어떡해요...!」
					CASE 3
						PRINTFORMW 「이, 이런 건 되도록 방에서……」
					CASEELSE
						PRINTFORMW 「이런 곳에 있다간…… 잡힐지도 몰라요오~…」
				ENDSELECT
			ELSE
				SELECTCASE RAND:11
					CASE 1
						PRINTFORMW 「%CALLNAME:MASTER%씨의 변태적인 모습……❤」
					CASE 2
						PRINTFORMW 「기, 기분 좋아요……❤」
					CASE 3
						PRINTFORMW 「흐으으음…… 야해읏!」
					CASE 4
						PRINTFORMW 「흐, 간지러워요오~읏!」
					CASE 5
						PRINTFORMW 「무우~, 치사해용~!」
					CASE 6
						PRINTFORMW 「정말 야한 거라구요~읏!」
					CASE 7
						PRINTFORMW 「거기는…… 잠깐만...❤」
					CASE 8
						PRINTFORMW 「응응~……읏❤」
					CASE 9
						PRINTFORMW 「안, 안 돼용……❤」
					CASE 10
						IF ARGS == "胸愛撫"
							PRINTFORMW 「%CALLNAME:MASTER%씨, 가슴 좋아해요~?」
						ELSE
							PRINTFORMW 「저기! 손가락 보여주지 마세요!! 에잇, 싫어읏!」
						ENDIF
					CASEELSE
						IF ARGS == "胸愛撫"
							IF TALENT:[[小鈴]]:バストサイズ > 0
								PRINTFORMW 「그렇게 주무르니까 커져버리는 거잖아……❤」
							ELSEIF TALENT:[[小鈴]]:バストサイズ < 0
								PRINTFORMW 「으음음...! 작아서 미안해……」
							ELSE
								PRINTFORMW 「역시 %CALLNAME:MASTER%씨는…… 큰 쪽이 좋아요…?」
							ENDIF
						ELSE
							PRINTFORMW 「싫어...읏! 지, 지저분해져 버릴 것 같아...!」
						ENDIF
				ENDSELECT
			ENDIF
		ELSE
			;簡易同室人チェック,確率
			IF !RAND:3 && TARGET:2
				;ゲストキャラ判定
				CALL M_KOJO_JP_REWRITE_K70_GUEST("日常愛撫")
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「잠깐만요…… %RESULTS:1%가 보고 있어요……」
					CASE 2
						PRINTFORMW 「%RESULTS:1% 앞에서 뭐 하고 있는 거예요!」
					CASEELSE
						PRINTFORMW 「%RESULTS:1%에게 말해버릴 거예요~...?」
				ENDSELECT
				;野外,確率
			ELSEIF !RAND:3 && OUTROOF(CFLAG:[[小鈴]]:現在位置)
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「저기…… 밖이잖아요……」
					CASE 2
						PRINTFORMW 「신고할 거예요……!」
					CASEELSE
						PRINTFORMW 「이런 곳에서 그만해 주세요...!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:8
					CASE 1
						PRINTFORMW 「헤…… 헤타이읏!」
					CASE 2
						PRINTFORMW 「아, 안 돼 주세요옷……」
					CASE 3
						PRINTFORMW 「응! 변태다아앗!」
					CASE 4
						PRINTFORMW 「에…… 에치읏!」
					CASE 5
						PRINTFORMW 「에, 야한 건 안 돼요옷!」
					CASE 6
						PRINTFORMW 「거, 거기는 안 돼요...!」
					CASE 7
						IF ARGS == "胸愛撫"
							PRINTFORMW 「흥, 벌써! 남자들은 맨날 가슴만……읏!」
						ELSE
							PRINTFORMW 「더러워요읏!」
						ENDIF
					CASEELSE
						IF ARGS == "胸愛撫"
							IF TALENT:[[小鈴]]:バストサイズ > 0
								PRINTFORMW 「이런 거 방해만 되고 있는데에……」
							ELSEIF TALENT:[[小鈴]]:バストサイズ < 0
								PRINTFORMW 「무우~...! 작아서 죄송해요...!」
							ELSE
								PRINTFORMW 「남자들은 정말 가슴 좋아하는구나……」
							ENDIF
						ELSE
							PRINTFORMW 「우으…… 부끄러워……」
						ENDIF
				ENDSELECT
			ENDIF
		ENDIF
ENDSELECT
