@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;CALL TRAIN_MESSAGE
DRAWLINE
;口上メイン呼出
CALL M_KOJO_JP_REWRITE_MESSAGE_COM_K70_300_1
RETURN RESULT

@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_300_1
#DIM GUEST, 2
#DIMS GUESTS
#DIM POINT
#DIM デート会話, 120
#DIM 会話日
#DIM 会話回数
;日が変わってたらフラグリセット
SIF !TCVAR:70:352
	VARSET デート会話
IF 会話日 != DAY
	会話回数 = 0
	会話日 = DAY
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	RESETCOLOR
	会話回数 ++
	;ゲストキャラ判定
	CALL M_KOJO_JP_REWRITE_K70_GUEST("会話")
	GUEST = RESULT
	GUEST:1 = RESULT:1
	GUESTS = %RESULTS%
	;ここに口上書いて下さい
	IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 말을 걸어보았지만, %조사처리(CALLNAME:TARGET,"는")% 발음이 제대로 되지 않아 무슨 말을 하는지도 알아들을 수 없다.
	ELSEIF TCVAR:[[小鈴]]:発情
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 이상한 %조사처리(CALLNAME:TARGET,"에게")% 말을 걸어 보았다.
		;会話不能の地の文は恋慕でない場合は省略できず、恋慕の時は表示されないので、ここではどちらの場合も同じように表示されるようにする
	ELSEIF TCVAR:70:会話不能
		IF TALENT:70:恋慕
			PRINTFORML %조사처리(CALLNAME:TARGET,"에게")% 말을 걸려고 했지만 말이 떠오르지 않는다.
			PRINTFORMW 주변에 어색한 공기가 감돌았다……
		ENDIF
	ELSEIF GUESTS != ""
		CLEARLINE 2
		PRINTFORML 세 명이 대화한다
		DRAWLINE
		;文章上だけであってソース等は変わりません,優先度の問題で多少齟齬は出るけど面倒なので妥協
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"와")% %GUESTS%를 사이에 두고 세 명이 대화했다.
	ELSE
		;デート会話
		IF TALENT:70:恋慕 && FLAG:デート相手 == 70 && DATENAME_SPOT() != "道中" && !デート会話:(CFLAG:70:現在位置 / 10)
			CLEARLINE 2
			PRINTFORML %DATENAME_SPOT()%으로 데이트
			DRAWLINE
		ENDIF
		PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"와")%
		IF TALENT:70:恋慕
			PRINTDATA
				DATAFORM 나란히 앉아
				DATAFORM 조금 부끄러워하며
				DATAFORM 미소를 주고받으며
				DATAFORM 화기애애한 분위기 속에서
				DATAFORM 조금 열이 오면서
				DATAFORM 장난치며
			ENDDATA
		ELSE
			PRINTDATA
				DATAFORM 하찮다
				DATAFORM 별것 아닌
				DATAFORM 세간
				DATAFORM 평화로운
				DATAFORM 흔한
				DATAFORM 약간의
				DATAFORM 우스꽝스러운
			ENDDATA
		ENDIF
		IF TFLAG:SELECTCOMの分岐 > 0
			PRINTFORML 이야기하며 즐거워졌다
		ELSEIF TFLAG:SELECTCOMの分岐 < 0
			PRINTFORML 이야기를 하고 있었는데 이야기가 끊겨버렸어……
		ELSE
			PRINTFORML 이야기를 나누었다.
		ENDIF
	ENDIF
	PRINTW 
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	;添い寝中
	IF CFLAG:[[小鈴]]:添い寝中
		IF TALENT:[[小鈴]]:恋慕
			SELECTCASE RAND:8
				CASE 1
					PRINTFORMW 「응음~…… 이대로…… 푹……」
				CASE 2
					PRINTFORMW 「또 내일…… 이야기해요……」
				CASE 3
					PRINTFORMW 「응응, 웅얼웅얼……」
				CASE 4
					PRINTFORMW 「후훗…… 기분 좋아요……」
				CASE 5
					PRINTFORMW 「후냐아~…… 따뜻해애……」
				CASE 6
					PRINTFORMW 「에헤에…… 더 붙어 있자아…… ❤」
				CASE 7
					PRINTFORMW 「푸아…… 안심돼요우……」
				CASEELSE
					PRINTFORMW 「하아~…… 졸려왔어에~……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「음~…… 이제 자자아~…」
				CASE 2
					PRINTFORMW 「응응, 웅얼웅얼……」
				CASEELSE
					PRINTFORMW 「네…… 네……」
			ENDSELECT
		ENDIF
		;酔ってる
	ELSEIF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		CALL M_KOJO_JP_REWRITE_K70_DRUNK("会話")
		;発情中
	ELSEIF TCVAR:[[小鈴]]:発情
		CALL M_KOJO_JP_REWRITE_K70_HATSUJO("会話")
		;自己紹介
	ELSEIF CFLAG:70:1004 == 0
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 가볍게 자기소개를 했다.
		PRINTW 
		PRINTFORMW 「헤에, 보기 힘든 분이시긴 하다고 생각했는데, 그런 분이셨군요」
		PRINTFORMW 「환상향에 그런 분이 살고 계신 줄은 몰랐어요」
		CFLAG:70:1004 = 1
		;不機嫌
	ELSEIF M_KOJO_JP_REWRITE_K70_FUKIGEN([[小鈴]])
		IF TALENT:70:恋慕
			;あなたが怒らせた
			IF !TCVAR:[[小鈴]]:380
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「%CALLNAME:MASTER%씨…… 왜……」
					CASE 2
						PRINTFORMW 「으음~ 실망이에요……」
					CASE 3
						PRINTFORMW 「하아…… 못 봤어요……」
					CASE 4
						PRINTFORMW 「%CALLNAME:MASTER%님이 그런 분이었다니…… 충격이에요」
					CASEELSE
						PRINTFORMW 「%CALLNAME:MASTER%씨, 저 지금 화났어요...!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「우음……」
					CASE 2
						PRINTFORMW 「저기……. 하아……」
					CASE 3
						PRINTFORMW 「에? 네! 죄송해요, 듣고 있지 못했어요……」
					CASE 4
						PRINTFORMW 「죄송해요, 오늘은 왠지……」
					CASEELSE
						PRINTFORMW 「으음, 미안해. 지금 잠깐 생각하는 게 있어서……」
				ENDSELECT
			ENDIF
		ELSE
			;あなたが怒らせた
			IF !TCVAR:[[小鈴]]:380
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「하아~……」
					CASE 2
						PRINTFORMW 「무우……!」
					CASE 3
						PRINTFORMW 「지금은 말 걸지 말아주세요!」
					CASE 4
						PRINTFORMW 「%CALLNAME:MASTER%께 드릴 말씀은 아무것도 없어요!」
					CASEELSE
						PRINTFORMW 「뭐예요? 저 지금 화났단 말이에요!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「음……」
					CASE 2
						PRINTFORMW 「에? 아아……네……」
					CASE 3
						PRINTFORMW 「후우음……」
					CASE 4
						PRINTFORMW 「죄송해요, 지금은 좀……」
					CASEELSE
						PRINTFORMW 「하아... 그렇구나아...」
				ENDSELECT
			ENDIF
		ENDIF
		;会話不能
	ELSEIF TCVAR:70:会話不能
		IF TALENT:70:恋慕 || TALENT:70:思慕
			SELECTCASE RAND:8
				CASE 1
					PRINTFORMW 「죄송해요…… 저는 책 이야기는밖에 못 해서요……」
				CASE 2
					PRINTFORMW 「아하하, 억지로 얘기하려고 안 해도 괜찮아요」
				CASE 3
					PRINTFORMW 「아, 맞다! ……어라? 무슨 말을 하려 했더라...?」
				CASE 4
					PRINTFORMW 「오늘 본 꿈인가요? 저기, 못 봤어요……」
				CASE 5
					PRINTFORMW 「지금은 이야기보다는, 다른 걸 하자」
				CASE 6
					PRINTFORMW 「이야 할 게 다 끝나면, 책을 읽자」
				CASE 7
					PRINTFORMW 「후후, 억지로 이야기하지 않아도 나는 즐거워요」
				CASEELSE
					PRINTFORMW 「%CALLNAME:MASTER%씨, 그 얘기 아까도 들었어요?」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「네, 그렇지만……」
				CASE 2
					PRINTFORMW 「저기……. 그건……」
				CASEELSE
					PRINTFORMW 「아하하…… 그 이야기는 아까도 했잖아요……」
			ENDSELECT
		ENDIF
		;失敗
	ELSEIF TFLAG:SELECTCOMの分岐 == -1
		IF TALENT:70:恋慕 || TALENT:70:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「에? 저기... 무슨 말씀이세요?」
				CASE 2
					PRINTFORML 「음~……」
					PRINTFORMW 「%CALLNAME:MASTER%씨의 이야기는 가끔 어렵네요……」
				CASE 3
					PRINTFORML 「%CALLNAME:MASTER%씨! 방금 하신 말씀 듣고 있었어요!?」
					PRINTFORMW 「적당히 흘려버리시면 안 돼요읏!」
				CASEELSE
					PRINTFORML 「음……?」
					PRINTFORMW 「왠지 모르게 찝찝해요……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「죄송해요, 그 이야기는 좀……」
				CASE 2
					PRINTFORMW 「음~ 잘 모르겠어요……」
				CASE 3
					PRINTFORMW 「저기……. 네, 네……」
				CASEELSE
					PRINTFORMW 「하아… 그러신가요……」
			ENDSELECT
		ENDIF
		;ゲストキャラと同室だと各キャラ1日1回ずつゲスト会話が発生（お茶とは別）
		;4=小鈴が恋慕(同行中だと最優先),3=ゲストと同行中in鈴奈庵,2=ゲストとデート中orゲストが恋慕で同行中,1=それ以外
	ELSEIF GUESTS != ""
		CALL M_KOJO_JP_REWRITE_K70_画像表示(GUEST:1, "通常", "通常")
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("ゲスト", GUEST:1, GUEST, "会話")
		;一日一回
		TCVAR:70:(M_KOJO_JP_REWRITE_K70_GUEST_TCVAR(GUEST:1)) = 1
		;デート同行会話と被る場合があるのでこちらを優先させ発生させないようにする
		SETBIT TCVAR:70:360, 0
		;試しに散策側に移行してみる,
		;鈴奈庵のデート同行会話
	ELSEIF M_KOJO_JP_REWRITE_K70_SUZUNAAN(CFLAG:70:現在位置) == 1 && FLAG:デート相手 && !CFLAG:70:同行 && !GETBIT(TCVAR:70:360, 0)
		IF TALENT:[[小鈴]]:恋人
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「하아……. 대낮에 바람이라니……」
					PRINTFORMW 「그 당당함은 역시 %CALLNAME:MASTER%씨답네요……」
				CASE 2
					PRINTFORML 「잠깐만! 일부러 바람피는 거 보여주러 오는 연인이 어디에 있는 거예요!?」
					PRINTFORMW 「아무리 그래도 너무 무신경하시잖아요~!」
				CASEELSE
					PRINTFORML 「굳이 묻자면, 그거 데이트잖아요……」
					PRINTFORMW 「왜 일부러 우리 집에 온 거예요…… 화난다고요?」
			ENDSELECT
			CALL M_KOJO_JP_REWRITE_K70_YAMETEKUDASAI([[小鈴]], 1)
		ELSEIF TALENT:70:恋慕
			PRINTFORML 「%CALLNAME:MASTER%씨, 꽤 즐거워 보이는데요~」
			PRINTFORMW 「말씀하시기 전에, 데이트라면 다른 곳에서 해줬으면 좋겠어요……」
			BASE:70:怒り += MAXBASE:70:怒り / 3
		ELSE
			PRINTFORML 「오늘은 두 분서 뭐 하신 거예요?」
			PRINTFORMW 「혹시 저희 가게에서 데이트 같은 거……?」
			PRINTFORMW 「뭐, 가게로서는 기쁘지만, 다른 곳이 더 좋을 거예요……」
			BASE:70:怒り += MAXBASE:70:怒り / 5
		ENDIF
		;一日一回
		SETBIT TCVAR:70:360, 0
		;レア
	ELSEIF !RAND:512
		PRINTFORMW 「훌쩍! ……앗, 감기 걸렸나?」
		;▼状況会話集
		;1-1,大雨,猛烈な雨,台風
	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 1) && (GROUPMATCH(天候, 5, 14) || FLAG:異常気象 == 9)
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 1, 1)
		;1-2,雨,霧雨,みぞれ
	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 1) && GROUPMATCH(天候, 4, 6, 12)
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 1, 2)
		;2-1,吹雪,猛吹雪
	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 2) && (GROUPMATCH(天候, 9) || FLAG:異常気象 == 10)
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 2, 1)
		;2-2,雪,細雪,霧雪
	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 2) && GROUPMATCH(天候, 8, 10, 11)
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 2, 2)
		;	;3,※欠番
		;	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 3) &&
		;		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 3)
		;4,あられ,雹
	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 4) && GROUPMATCH(天候, 13, 15)
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 4)
