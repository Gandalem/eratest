@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_604_1
#DIM POINT
#DIM デート会話, 120
SIF !TCVAR:70:352
	VARSET デート会話
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;酔ってるor発情中だと表示しない
	SIF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで" || TCVAR:[[小鈴]]:発情
		RETURN 1
	;試しにデート会話をこっちに持ってきた
	IF ABL:[[小鈴]]:親密 >= 7 && !デート会話:(CFLAG:[[小鈴]]:現在位置 / 10)
		PRINTL 
		POINT = CFLAG:70:現在位置 / 10
		;こんなにこだわるつもりはなかったのに、某美人妻がたくさん喋るのに釣られてつい
		;新たに地点ができたら修正します（多分）
		SELECTCASE STR:(POINT + 6000)
			;▼博麗神社
			CASE "桜並木の鳥居"
				;春
				IF GET_MONTH() == "春の月"
					PRINTFORML 「벚꽃, 정말 예쁘네요~!」
					PRINTFORMW 「잠깐 꽃놀이 하러 가지 않을래요?」
					;春以外
				ELSE
					PRINTFORML 「봄 동안은 자주 여기서 꽃놀이를 하곤 했어요」
					PRINTFORMW 「대체로 밤에 하는 거라, 저는 잘 못 오는데……」
				ENDIF
			CASE "神社境内"
				PRINTFORML 「역시 여기는 마음이 놓여요~」
				PRINTFORMW 「요괴들이 놀러 오는 것도, 어쩐지 알 것 같은 기분이 들어요」
			CASE "神社本堂"
				PRINTFORML 「모처럼 왔으니, 참배하고 가요」
				PRINTFORMW 「무엇을 빌지는…… 비밀이에요♪」
			CASE "神社縁側"
				PRINTFORML 「그래도 여기는 여러 사람이 있네요」
				PRINTFORMW 「그만큼 레이무 씨는 인기 많은 거구나」
			CASE "妖精の大樹"
				PRINTFORML 「어라, 여기 요정의 서식지인가요?」
				PRINTFORMW 「평소에는 그냥 나무로만 보였는데…… 이상해……」
			CASE "夢幻遺跡"
				PRINTFORML 「와아, 신사 옆에 이런 유적이 있었다니」
				PRINTFORMW 「왠지 신비로운 구조네요…… 정말 유적일까요」
				;▼命蓮寺
			CASE "お地蔵通り"
				PRINTFORML 「가끔은 이 근처까지 저도 와요」
				PRINTFORMW 「……주로 걱정거리가 있을 때, 찾아뵙고」
			CASE "枝垂れ柳の下"
				PRINTFORML 「버드나무는 왜 저렇게 불길해 보이는 걸까요……」
				PRINTFORMW 「낮은 아직 괜찮지만, 밤에는 오고 싶지 않아요……」
			CASE "命蓮寺境内"
				PRINTFORML 「여기는 요괴들도 많이 살고 있다던데……」
				PRINTFORMW 「음, 요괴인데 선행 같은 걸 하고 있는 게 괜찮은 건가요~?」
			CASE "命蓮寺方丈"
				PRINTFORML 「마을 쪽에서도 몇 명이나 이 절에서 수행하러 오고 있대요」
				PRINTFORMW 「돌아오는 사람들을 보면, 역시 엄격한 곳인가 봐요?」
			CASE "墓地"
				PRINTFORML 「히에~, 왜 이런 묘지에 와 있는 거야……」
				PRINTFORMW 「빨리 다른 곳으로 가자아~!」
			CASE "神霊廟広場"
				PRINTFORML 「아주 화려한 문이네요~」
				PRINTFORMW 「선인이라는 분들은 좀 더 온화한 이미지가 떠올랐는데, 그렇지 않은 걸까요」
			CASE "神霊廟道場"
				PRINTFORML 「알고 있어요, 이 도장은 선계의 일부잖아요」
				PRINTFORMW 「선인이라니~ %CALLNAME:MASTER%님은 되어보고 싶으세요~?」
				;▼人里
			CASE "広場"
				PRINTFORML 「%CALLNAME:MASTER%씨! %CALLNAME:MASTER%씨! 오늘은 저기 가요!」
				PRINTFORMW 「에헤헤, 다음에 데이트할 때 가기로 정했었잖아요♪」
			CASE "商家町"
				;ここでいうウチは自分の部屋ではなく鈴奈庵の事
				PRINTFORML 「우리 집에 올래요? 아니면 쇼핑할 거예요?」
				PRINTFORMW 「후후, 데이트 같은 느낌이라 즐겁네요♪」
			CASE "呑屋小道"
				PRINTFORML 「%CALLNAME:MASTER%씨, 이렇게 이른 시간에 술을 마시는 거예요~?」
				PRINTFORMW 「너무 많이 마시면 돌아가지 못하게 될지도 몰라요~」
			CASE "寺子屋"
				PRINTFORML 「저도 예전에는 여기에 다니곤 했어요」
				PRINTFORMW 「아, 그립다! 이 낙서 아직 남아있었네」
			CASE "大衆浴場"
				IF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 < 360
					PRINTFORML 「후우~!! 개운해졌어요!」
					PRINTFORMW 「포근해요♪」
				ELSE
					PRINTFORML 「여기 목욕탕도 저 가끔 와요」
					PRINTFORMW 「역시 넓은 욕조는 기분 좋죠~!」
				ENDIF
			CASE "連れ込み宿"
				;入った時点で合意取得するのね…,うふふ前か後かは絶頂したかで判断するので事前に絶頂させてるとちょっと齟齬
				IF EX:70:Ｃ絶頂 + EX:70:Ｖ絶頂 + EX:70:Ａ絶頂 + EX:70:Ｂ絶頂 + EX:70:Ｍ絶頂
					IF TALENT:70:処女
						PRINTFORMW 「……❤」
					ELSE
						PRINTFORMW 「……❤」
					ENDIF
				ELSE
					IF TALENT:70:処女
						PRINTFORMW 「저기…… 부, 부드럽게 해주세요……❤」
					ELSE
						PRINTFORMW 「지이……❤」
					ENDIF
				ENDIF
			CASE "長屋街"
				PRINTFORML 「여기는 주로 주거 구역이에요」
				PRINTFORMW 「아큐네 집에도 놀러 가요?」
				;と言いつつ行こうとすると拒否されちゃいます。女の子って難しいね
				;▼霧の湖
			CASE "霧の湖"
				IF GET_MONTH() == "夏の月"
					PRINTFORML 「후우, 괜히 수영하고 싶어져요」
					PRINTFORMW 「하지만 이쪽 호수는 위험하니까 들어가면 안 된다고요」
				ELSE
					PRINTFORML 「이쪽 호수에 주인 같은 거 있나요?」
					PRINTFORMW 「큰 메기라거나 인어, 하얀 대뱀이라든지 여러 목격담은 들었어요」
				ENDIF
			CASE "氷のかまくら"
				PRINTFORML 「왜 이런 곳에 눈사람이 있는 거야……」
				IF GET_MONTH() == "夏の月"
					PRINTFORMW 「시원하네요……」
				ELSE
					PRINTFORMW 「흐으윽…… 추워요……」
				ENDIF
			CASE "廃洋館"
				PRINTFORML 「히익, 폐허 같은 데는 분명 뭔가 있을 거예요!」
				PRINTFORMW 「헉! 저기 봐요! 지금 뭔가……」
			CASE "正門"
				PRINTFORML 「헤에, 이게 흡혈귀의 저택인가아」
				PRINTFORMW 「하, 들어가면 안 돼요...!」
			CASE "広間"
				PRINTFORML 「저, 괜찮으세요? 흡혈귀의 저택 같은 곳에 들어오게 되어서……」
				PRINTFORMW 「그렇더라도 넓네요……. 뭔가 밖에서 봤을 때보다 이상할 정도로 넓은 것 같아요……」
			CASE "食堂"
				PRINTFORML 「이렇게 넓은 곳에서 식사하고 계신 거예요……」
				PRINTFORMW 「저는 어쩐지 마음이 불안해요~」
			CASE "大図書館"
				PRINTFORML 「와아! 굉장하다! 여기가 카노 코우마칸 도서관이구나!」
				PRINTFORMW 「좋다 좋다, 하루 종일 여기에 있고 싶어……」
			CASE "地下室"
				PRINTFORML 「%CALLNAME:MASTER%씨! 여기 들어와도 되는 거예요!?」
				PRINTFORMW 「무서워요~ 돌아가 버려요~!」
				;▼迷いの竹林
			CASE "竹林入り口"
				PRINTFORML 「여기서부터는 안내 없이는 진행할 수 없어요」
				PRINTFORMW 「그래서, %CALLNAME:MASTER%씨, 부탁드려요!」
			CASE "迷いの小道", "斜角の竹林"
				PRINTFORML 「어라? 여기 아까도 왔던 것 같은데…… %CALLNAME:MASTER%씨, 괜찮으시죠...?」
				PRINTFORMW 「길을 잃어서 나가지 못하게 되는 일은 없겠죠...?」
			CASE "兎の洞穴"
				PRINTFORML 「이런 동굴에 무슨 용무세요~?」
