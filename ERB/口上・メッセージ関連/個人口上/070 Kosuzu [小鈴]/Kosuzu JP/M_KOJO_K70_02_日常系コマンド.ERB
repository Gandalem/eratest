@M_KOJO_JP_REWRITE_K70_COOKSET(ARGS, ARG)
SELECTCASE ARGS
	CASE "完成：良好"
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「네, 다 됐어요~♪」
			CASE 2
				PRINTFORML 「이런 건가요~ 완성이에요!」
			CASE 3
				PRINTFORML 「다 됐어요~! 완성이에요~」
			CASEELSE
				PRINTFORML 「이걸로 완성이에요!」
		ENDSELECT
	CASE "完成：微妙"
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「저, 완성했어요…… 후우, 힘들다아」
			CASE 2
				PRINTFORML 「이런 느낌은 어떠세요…… 일단 완성입니다……」
			CASE 3
				PRINTFORML 「자, 완성했어요~! 다 됐어요~」
			CASEELSE
				PRINTFORML 「일단 이걸로 완성이에요……」
		ENDSELECT
	CASE "料理"
		IF ABL:[[小鈴]]:料理技能 >= ARG
			ARGS = テキパキ
		ELSE
			ARGS = がんばる
		ENDIF
		RESTART
	CASE "テキパキ"
		PRINTL 
		PRINTFORMDL 코스즈는 경쾌하게 흥얼거리며 테키파키하고 요리했다.
		PRINTL 
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「변후후후~ 변♪」
			CASE 2
				PRINTFORML 「요리하는 거 즐겁네요~♪」
			CASE 3
				PRINTFORML 「간단~해~♪」
			CASEELSE
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 요리하는 거 즐거워요~♪」
		ENDSELECT
		PRINTW 
		ARGS = 完成：良好
		RESTART
	CASE "がんばる"
		PRINTL 
		PRINTFORMDL 코스즈는 레시피를 노려보며 열심히 요리했다.
		PRINTL 
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「저기, 다음엔 이 재료를~……」
			CASE 2
				PRINTFORML 「이, 이 재료로 정말 맞는 건가요?」
			CASE 3
				PRINTFORML 「%CALLNAME:MASTER%씨읏! "적량"이라니 어느 정도를 말씀하시는 거예요~!?」
			CASEELSE
				PRINTFORML 「이거 얼마나 해야 되는 거예요?」
		ENDSELECT
		PRINTW 
		ARGS = 完成：微妙
		RESTART
	CASE "手練"
		PRINTL 
		PRINTFORMDL 코스즈는 경험을 바탕으로 신중하게 요리했다.
		PRINTL 
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「어려운 요리라도 익숙해지면 즐겁네요」
			CASE 2
				PRINTFORML 「음, 확실히 다음 과정은~……」
			CASE 3
				PRINTFORML 「양념은 이 정도면 되겠지~」
			CASEELSE
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 함께라서 힘낼 수 있어요!」
		ENDSELECT
		PRINTW 
		ARGS = 完成：良好
		RESTART
	CASE "わからない"
		PRINTL 
		PRINTFORMDL 코스즈는 %조사처리(CALLNAME:MASTER,"의")% 지시에 따라 필사적으로 요리했다.
		PRINTL 
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%씨읏! 다음엔 어떻게 하실 거예요~!?」
			CASE 2
				PRINTFORML 「이, 이게 정말 이대로 괜찮은 거예요!?」
			CASE 3
				PRINTFORML 「재료…… 이걸로 맞는 걸까아……」
			CASEELSE
				PRINTFORML 「에? 그게 뭔데요! 듣지도 못했단 말이에요~」
		ENDSELECT
		PRINTW 
		ARGS = 完成：微妙
		RESTART
	CASE "料理：イージー"
		IF FIRSTTIME(DISHNAME)
			PRINTFORML 「%DISHNAME% 정도는 만들 수 있어요! \@ ABL:[[小鈴]]:料理技能 < 3 ? ……아마도 #  \@」
		ELSEIF ABL:[[小鈴]]:料理技能 >= 3
			PRINTFORML 「%DISHNAME%네요! 조금만 조금씩~♪」
		ELSEIF ABL:[[小鈴]]:料理技能 >= 1
			PRINTFORML 「%DISHNAME%네요! 간단해~ 간단해~」
		ELSE
			PRINTFORML 「%DISHNAME%인가요! 맡겨주세요!」
		ENDIF
		ARGS = テキパキ
		RESTART
	CASE "料理：ノーマル"
		IF FIRSTTIME(DISHNAME)
			PRINTFORML 「%DISHNAME%의 레시피는 음으음……」
			PRINTFORML 「헤에, 이렇게 만드는 거구나」
			PRINTFORML 「음, 우선은……」
			ARGS = がんばる
		ELSEIF ABL:[[小鈴]]:料理技能 >= 3
			PRINTFORML 「%DISHNAME%죠! 맡겨주세요!」
			PRINTFORML 「저, %DISHNAME% 만드는 거 잘 할지도 몰라요~♪」
			ARGS = テキパキ
		ELSE
			PRINTFORML 「%DISHNAME%는 배웠어요~! 맡겨주세요!」
			ARGS = がんばる
		ENDIF
		RESTART
	CASE "料理：ハード"
		IF FIRSTTIME(DISHNAME)
			PRINTFORML 「%DISHNAME%는 뭘까……?」
			PRINTFORML 「이 책에…… 있었어!」
			PRINTFORML 「흠, 그렇구나」
			PRINTFORML 「그래서 어떻게 만드는 거지……?」
			ARGS = がんばる
		ELSEIF ABL:70:料理技能 >= 3
			PRINTFORML 「%DISHNAME% 같은 건 평소엔 안 먹으니까, %조사처리(CALLNAME:MASTER,"랑")% 함께 있을 때밖에 만들 기회가 없어요~」
			ARGS = テキパキ
		ELSE
			PRINTFORML 「%DISHNAME%는 배웠어요~! 맡겨주세요!」
			ARGS = がんばる
		ENDIF
		RESTART
	CASE "料理：ルナティック"
		IF FIRSTTIME(DISHNAME)
			PRINTFORML 「%DISHNAME%는 대체 뭘까……?」
			PRINTFORML 「도, 도서 어디에도 나와 있지 않아…… 어떡하지……」
			PRINTFORML 「에? 만들어 보면 알 수 있다고요?」
			PRINTFORML 「정말 그런 걸로 괜찮을까요……」
			ARGS = わからない
		ELSEIF ABL:70:料理技能 >= 3
			PRINTFORML 「%DISHNAME%…… 예전에 한 번 만들어봤으니까, 대충은 기억하고 있을 거예요! 열심히 할게요!」
			ARGS = 手練
		ELSE
			PRINTFORML 「%DISHNAME%…… 어떤 요리인지는 기억하지만, 제대로 만들 수 있을까요……」
			ARGS = わからない
		ENDIF
		RESTART
	CASE "卵割り：成功"
		PRINTL 
		PRINTFORMDW 　탁
		PRINTL 
	CASE "卵割り：失敗"
		PRINTL 
		PRINTFORMDW 　파쩨
		PRINTL 
		PRINTFORML 「아…… 뭐야……?」
	CASE "DCS"
		PRINTL 
		PRINTFORMDW 코스즈는 지시받은 대로 재료를 던져 넣었다.
		PRINTL 
		PRINTFORML 「음…… 보기에는 평범한데, 이거 먹어도 괜찮은 걸까요……」
	CASE "JAN"
		PRINTL 
		PRINTFORMDW 코스즈는 마지못해 요리를 했다.
		PRINTL 
		PRINTFORML 「……나는 안 먹을 거예요?」
ENDSELECT
RETURN 1
