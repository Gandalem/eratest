@M_KOJO_JP_REWRITE_K70_ALCOHOL_FACE(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE IS <= 2
		RETURNF "素面"
	CASE IS <= MAXBASE:[[小鈴]]:酒気 / 10 * 5
		RETURNF "ほろ酔い"
	CASE IS <= MAXBASE:[[小鈴]]:酒気 / 10 * 8
		RETURNF "酔いどれ"
	CASEELSE
		RETURNF "ぐでぐで"
ENDSELECT

@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_332
CALL TRAIN_MESSAGE
CALL M_KOJO_JP_REWRITE_MESSAGE_COM_K70_332_1
RETURN RESULT

