				CALL M_KOJO_JP_REWRITE_K70_COOKSET("料理：イージー")
			CASE "おひたし", "漬物", "オムレツ", "ゆでたまご", "干物", "茹でた枝豆", "からあげ", "竜田揚げ", "塩焼き", "焼きいも", "たけのこごはん", "雑炊", "フルーツ盛り合わせ"
				CALL M_KOJO_JP_REWRITE_K70_COOKSET("料理：イージー")
			CASE "カットスイカ"
				CALL M_KOJO_JP_REWRITE_K70_COOKSET("料理：イージー")
				;知らない料理
			CASE "ラピュタパン", "タコス", "ムニエル", "マリネ", "チーズフォンデュ", "ボルシチ", "ブレッドボウルシチュー", "蛇羹", "油淋鶏", "スターゲイジーパイ", "タピオカミルクティー"
				CALL M_KOJO_JP_REWRITE_K70_COOKSET("料理：ハード")
			CASE "いちごとうふ",
				CALL M_KOJO_JP_REWRITE_K70_COOKSET("料理：ハード")
				;知ってるけど作り方は知らないような料理
			CASEELSE
				CALL M_KOJO_JP_REWRITE_K70_COOKSET("料理：ノーマル")
		ENDSELECT
	ENDIF
	WAIT
ENDIF
RETURN 1
