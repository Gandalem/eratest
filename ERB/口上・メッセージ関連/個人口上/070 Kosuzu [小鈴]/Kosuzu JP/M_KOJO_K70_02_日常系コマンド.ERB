	ELSEIF M_KOJO_JP_REWRITE_K70_ALCOHOL_FACE(TCVAR:[[小鈴]]:382) == "ほろ酔い"
		;仕事中
		IF CFLAG:70:行動 == 5
			PRINTFORML 「에엣! 아직 더 마신다는 거예요~?」
			PRINTFORMW 「저, 이제 어쩔 수 없네요~~」
		ELSE
			PRINTFORML 「후훗, 감사합니다♪」
			PRINTFORMW 「얏! 잘 지냈어!」
		ENDIF
	ELSE
		;仕事中
		IF CFLAG:70:行動 == 5
			PRINTFORML 「에, 술이요? 일 중인데요……」
			PRINTFORMW 「그럼, 잠깐만……」
		ELSE
			PRINTFORML 「아라! 술이신가요?」
			PRINTFORMW 「감사합니다~!」
		ENDIF
	ENDIF
	PRINTL 
