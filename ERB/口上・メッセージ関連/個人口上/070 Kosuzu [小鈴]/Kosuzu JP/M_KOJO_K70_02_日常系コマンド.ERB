;603,手を繋ぐ
;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗でもふりほどかれたりはしません
;==================================================

@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_603
CALL TRAIN_MESSAGE
CALL M_KOJO_JP_REWRITE_MESSAGE_COM_K70_603_1
RETURN RESULT

@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	;酔ってる
	IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		CALL M_KOJO_JP_REWRITE_K70_DRUNK("手を繋ぐ")
		;発情中
	ELSEIF TCVAR:[[小鈴]]:発情
		CALL M_KOJO_JP_REWRITE_K70_HATSUJO("手を繋ぐ")
	ELSEIF TALENT:[[小鈴]]:恋人
		SELECTCASE RAND:8
			CASE 1
				PRINTFORMW 「이 손은 놓지 않을 테니까~♪」
			CASE 2
				PRINTFORMW 「꼭~♡」
			CASE 3
				PRINTFORMW 「%CALLNAME:MASTER%랑의 유대감을 느껴요❤️」
			CASE 4
				PRINTFORMW 「나 데리고 가 주세요♪」
			CASE 5
				PRINTFORMW 「진짜 연인들이 손잡는 모습이네요... ❤」
			CASE 6
				PRINTFORMW 「좀 부끄럽네요……♪」
			CASE 7
				PRINTFORMW 「더 꼭 붙자아 ❤」
			CASEELSE
				PRINTFORMW 「코, 연인이니까……❤」
		ENDSELECT
	ELSEIF TALENT:[[小鈴]]:恋慕
		SELECTCASE RAND:8
			CASE 1
				PRINTFORMW 「놔주지 마세요~♪」
			CASE 2
				PRINTFORMW 「꽉……❤」
			CASE 3
				PRINTFORMW 「%CALLNAME:MASTER%손……❤」
			CASE 4
				PRINTFORMW 「그래서 데이트 같은 기분이 드네요...❤」
			CASE 5
				PRINTFORMW 「아, 동경하던 연인이라니...❤」
			CASE 6
				PRINTFORMW 「저, 손에서 땀이 나요…… 부끄러워요……」
			CASE 7
				PRINTFORMW 「좀 더 기대도 괜찮을까요...❤」
			CASEELSE
				PRINTFORMW 「코, 연인 같네요...❤」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「이, 이렇게 하는 건가요...?」
			CASE 2
				PRINTFORMW 「꽉……❤」
			CASE 3
				PRINTFORMW 「이, 이게 데이트구나……❤」
			CASEELSE
				PRINTFORMW 「네, 네엣!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
