@M_KOJO_JP_REWRITE_K70_DRUNK(ARGS)
;泥酔フラグ
TCVAR:[[小鈴]]:383 = 1
SELECTCASE ARGS
	CASE "お茶"
		PRINTFORML 「파아... 하하케...?」
		PRINTFORMW 「응군군구... 오이히이헵헤~!」
	CASE "食事", "お弁当を食べる", "食事に誘う", "甘味処に誘う"
		PRINTFORML 「응히익…… 배고파...?」
		PRINTFORMW 「하구하구하구…… 맛있어 헤에~!」
	CASE "キスする", "胸愛撫", "アナル愛撫", "クリ愛撫", "指挿入れ", "スカートめくり"
		IF ARGS == "キスする"
			PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "…❤")%」
		ELSE
			PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "…！")% 응하아❤」
		ENDIF
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「우헤헤...❤ 아우히아얀히아아~!」
			CASE 2
				PRINTFORMW 「히헤❤ 후헤헤 하아호후히안!」
			CASEELSE
				PRINTFORMW 「후하❤ 하히히야 후오, 웬히아우에?」
		ENDSELECT
	CASEELSE
		SELECTCASE RAND:8
			CASE 1
				PRINTFORML 「라아~! 라메레스오~, 오햐햣하아~~!」
				PRINTFORMW 「오우아오은아~! 오우오에아엔~~!」
			CASE 2
				PRINTFORML 「아아~~!! 웃음의 왕 아온아~!」
				PRINTFORMW 「이야, 아라와라이야~~!!」
			CASE 3
				PRINTFORML 「아히우호와아라레파~? 위은……」
				PRINTFORMW 「우히이헤헤~! 히아히하히운에프!」
			CASE 4
				PRINTFORML 「하히! 아하히오피헤와아호후헤에히!」
				PRINTFORMW 「에히와아, 후히헤하후하아~?」
			CASE 5
				PRINTFORML 「하아후아? 안안니이우엣에이히인애카아~!」
				PRINTFORMW 「하아아이운에이아이아이아!」
			CASE 6
				PRINTFORML 「호오~ 이엔아후아히아! 아하핫!」
				PRINTFORMW 「아하히헤후하히~!! 우에헤헤헤~히하하!」
			CASE 7
				PRINTFORML 「후에이안아훗헤에~……」
				PRINTFORMW 「호에~~……후헤히안아후헤~……」
			CASEELSE
				PRINTFORML 「응아~……, 피요햐앙, 햐아에파?」
				PRINTFORMW 「오후와라엔헤아이아우~~!」
		ENDSELECT
ENDSELECT
PRINTFORML 
SELECTCASE ARGS
	CASE "膝枕してもらう", "お腹を撫でる", "頬をつまむ", "頭を撫でる", "尻を撫でる", "抱き付く", "キスする", "胸愛撫", "アナル愛撫", "クリ愛撫", "指挿入れ", "スカートめくり", "デコちゅー"
		PRINTFORMDW 신경 써주는 건지, 잘 모르겠는데……
	CASE "お茶"
		PRINTFORMDW 코스즈는 술이라고 생각하고 마시고 있다……
	CASE "食事", "お弁当を食べる", "食事に誘う", "甘味処に誘う"
		PRINTFORMDW 코스즈는 술안주라고 생각하고 먹고 있다…….
	CASE "仕事を手伝う"
		PRINTFORMDW 코스즈가 만취해서 일을 도와줬다…….
	CASE "膝枕する", "休憩"
		PRINTFORMDW 편안하게 쉬고 있는 건지, 잘 모르겠네……
	CASE "読書"
		PRINTFORMDW 제대로 된 독서는 아니야……
	CASE "耳かき"
		PRINTFORMDW 역시 위험해…….
	CASEELSE
		PRINTFORMDW 대화가 되지 않았다……
ENDSELECT
