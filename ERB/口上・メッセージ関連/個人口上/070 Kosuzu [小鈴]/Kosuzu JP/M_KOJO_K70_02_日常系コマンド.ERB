	ELSEIF !GETBIT(TCVAR:[[小鈴]]:359, 8) && TCVAR:[[小鈴]]:今日の贈り物 && FLAG:デート相手 == [[小鈴]]
		CALL M_KOJO_JP_REWRITE_K70_TALKSET("状況会話", 8)
