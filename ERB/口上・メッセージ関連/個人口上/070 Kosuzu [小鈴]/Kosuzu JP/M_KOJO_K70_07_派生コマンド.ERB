@M_KOJO_JP_REWRITE_MESSAGE_SCOM_K70_9
CALL TRAIN_MESSAGE
CALL M_KOJO_JP_REWRITE_MESSAGE_SCOM_K70_9_1
;戻り値とTARGETを保存、TARGETを二人目に一時的に交代して二人目口上を呼び出した後、TARGETをもどして保存した戻り値でRETURNする
;二人目はいらない場合はここで処理
;二人目
LOCAL = MASTER_POSE(4,1,1)
LOCAL:1 = RESULT
LOCAL:2 = TARGET
TARGET = LOCAL
TRYCALLFORM M_KOJO_JP_REWRITE_MESSAGE_SCOM_K{TARGET}_9_2
TARGET = LOCAL:2
RETURN LOCAL:1
;一人目口上

@M_KOJO_JP_REWRITE_MESSAGE_SCOM_K70_9_1(ARG)
#DIM CHARA
IF !ARG
	CHARA = MASTER_POSE(4,1,1)
ELSE
	CHARA = ARG
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_JP_REWRITE_K70_UFUFU()
;-------------------------------------------------
IF LOCAL
	IF CHARA == [[阿求]]
		SELECTCASE M_KOJO_JP_REWRITE_K70_BALANCE([[小鈴]], [[阿求]])
			CASE "独占", "信頼"
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「아큐, 같이 %CALLNAME:MASTER%님께 봉사하자❤」
					CASEELSE
						PRINTFORMW 「후후❤ 아큐랑 반반 나눠 가지자❤」
				ENDSELECT
			CASE "悲恋", "揶揄"
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「싸, 승부야 아큐! 어느 쪽이 %CALLNAME:MASTER%님을 기분 좋게 해줄 수 있을까...!」
					CASEELSE
						PRINTFORMW 「응응으…… 아큐만 받는 거 너무 치사해……! 나도 말이야……!」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「아큐에게 기분 좋게 해 줄게요옷!」
					CASEELSE
						PRINTFORMW 「아큐에게는 안 줄 거야...! %M_KOJO_JP_REWRITE_K70_AUTO("おくち：前", "❤")%」
				ENDSELECT
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「응응…… %CALLNAME:CHARA% 씨만 계속 받는 거 너무 치사해……! 나도 받았단 말이야...!」
			CASEELSE
				PRINTFORMW 「응—! %CALLNAME:CHARA% 씨, 저에게도 주세요……읏!」
		ENDSELECT
	ENDIF
	;ここから[フェラチオ]に転送
	CALL M_KOJO_JP_REWRITE_MESSAGE_COM_K70_81_1
ENDIF
;未記入
;CALLFORM M_KOJO_JP_REWRITE_MESSAGE_COM_K70_{SELECTCOM}_1
RETURN 1
;二人目口上

@M_KOJO_JP_REWRITE_MESSAGE_SCOM_K70_9_2
VARSET LOCAL
;一人目
LOCAL:101 = MASTER_POSE(4,1)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_JP_REWRITE_K70_UFUFU()
;-------------------------------------------------
IF LOCAL
	;一人目と同じ
