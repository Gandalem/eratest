@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_JP_REWRITE_K70_UFUFU()
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF FIRSTTIME("パイズリ")
		PRINTFORMW 「에엣!? 가, 가슴으로만 하는 거예요……?」
		IF TALENT:[[小鈴]]:バストサイズ > 0
			PRINTFORML 「저, 뭐 가슴에는 자신 있긴 한데요……」
			PRINTFORMW 「그런 식으로 쓰실 줄은 생각도 못 했어요……」
		ELSEIF TALENT:[[小鈴]]:バストサイズ < 0
			PRINTFORML 「그런 건…… 저에겐 무리예요……」
			PRINTFORMW 「시험 삼아 말씀이신가요…… 네, 알겠어요……」
		ELSE
			PRINTFORML 「그, 못할 리는 없을 거라고 생각해요……」
			PRINTFORMW 「저에게 할 수 있을까요……」
		ENDIF
	ELSEIF NOWEX:MASTER:射精
		;サディスティック
		IF M_KOJO_JP_REWRITE_K70_SADISTIC(70)
			;カウンター[パイズリ]から
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「가고 싶으신가요? 그럼, 나의 가슴으로……❤ 후훗, 응, %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")%」
					PRINTFORMW 「이런 느낌 어때요❤ 어떻습니까❤ 에잇❤ 에잇❤」
				CASE 2
					PRINTFORMW 「음후후...❤ 갈 것 같아요...❤ 제 가슴에 싸 주세요...❤」
					PRINTFORMW 「자, 자❤ 자, 자❤ 자, 해봐❤ 해봐❤」
				CASE 3
					PRINTFORMW 「거시기 엄청 뜨거워졌어요……❤」
					PRINTFORMW 「제가 가슴으로 짜내 드릴게요~ ❤ 그거! ❤ 그거! 가요! ❤」
				CASEELSE
					PRINTFORMW 「%CALLNAME:MASTER%씨, 좋은 표정을 짓고 있군요 ❤」
					PRINTFORMW 「행복에 감싸져 버리자 ❤ 에잇❤ 에잇❤」
			ENDSELECT
		ELSE
			;[身を任せる]から
			IF TALENT:[[小鈴]]:バストサイズ < 0
				PRINTFORMW 「응...! 응...! %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 갈 것 같아요?」
				SELECTCASE RAND:4
					CASE 1
						PRINTFORMW 「기뻐읏❤ 내 가슴에서 싸줘요? ❤」
					CASE 2
						PRINTFORMW 「어때요옷❤ 저도 말이죠❤ 호흡할 수 있어요옷❤」
					CASE 3
