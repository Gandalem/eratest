@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_85_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_JP_REWRITE_K70_UFUFU()
;-------------------------------------------------
IF LOCAL
	;足コキは常時サディスティック
	IF FLAG:時間停止
	ELSEIF LOCAL:1 && FIRSTTIME("足コキ") && !FLAG:時間停止
		PRINTFORMW 「에헤…… 발로 해줬으면 좋겠어요?」
		PRINTFORMW 「%CALLNAME:MASTER%씨는, 그런 걸 좋아하시는 거예요…? ❤」
	ELSEIF NOWEX:MASTER:射精
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「아라아? 갈 것 같으시군요❤ 좋아요❤ 발로 가버리죠❤」
				PRINTFORMW 「여기가 좋잖아요♪ 자, 봐봐❤ 자, 봐봐❤ 가버려❤ 가버려ー❤」
			CASEELSE
				PRINTFORMW 「아라아? 가고 싶은 거예요? %CALLNAME:MASTER%씨는 변태시네요……」
				PRINTFORMW 「알아요? 이런 걸로 갈 정도면 변태인걸요? 변태씨❤ 변・타・이・상❤ 퍄읏❤ 퍄ー읏❤」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「아하♪ 발로 주물러지는 기분은 어떤 건가요?」
				PRINTFORMW 「억울한가요? 기분이 좋은가요?」
			CASEELSE
				PRINTFORMW 「우후❤ %CALLNAME:MASTER%씨의 거시기 귀여워요❤」
				PRINTFORMW 「봐라♪ 여기를 만지니까 움찔움찔하고……❤ 정말 기분 좋아 보여❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
