@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_JP_REWRITE_K70_UFUFU()
;-------------------------------------------------
IF LOCAL
	;一文目をPRINTFORMLにするか迷う……
	IF FLAG:時間停止
	ELSEIF FIRSTTIME("手淫")
		PRINTFORMW 「손으로 주무르는 거군요……. 저, 이렇게 하면 어떨까요…?」
		PRINTFORMW 「어떠세요...? 잘 되고 있나요?」
	ELSEIF NOWEX:MASTER:射精
		;サディスティック
		IF M_KOJO_JP_REWRITE_K70_SADISTIC(70)
			;カウンター[手淫]から
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「만져줬으면 좋겠어요? 제 손으로 가고 싶으세요? 가고 싶다면 해도 돼요❤」
					PRINTFORMW 「자아❤ 만져줄게❤ 잔뜩 뿌려보자~❤ 뿌슉❤ 뿌슉❤」
				CASE 2
					PRINTFORMW 「응 후후…❤ 기분 좋아요? %CALLNAME:MASTER%씨, 귀여워요❤」
					PRINTFORMW 「어머, 갈 것 같아요? 괜찮아요❤ 뿜뿜해 주세요❤ 뿜❤ 뿜❤」
				CASE 3
					PRINTFORMW 「아앗❤ %CALLNAME:MASTER%님이 갈 것 같은 게 보여요❤」
					PRINTFORMW 「그럼, 간지럽게 해 드릴 테니 가세요❤ 뿌욱❤ 푸우욱❤」
				CASEELSE
					PRINTFORMW 「%CALLNAME:MASTER%씨의 거시기 대단해……읏❤ 단단해요……❤」
					PRINTFORMW 「제가 비벼서, 해방시켜 드릴게요❤ 비비비❤ 뿌우욱❤」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「하아...❤ 부풀어 올랐네요...❤ 제가 진정시켜 드리겠습니다...!」
					PRINTFORMW 「음...후우...! 괜찮습니다... 주저하지 마시고 하셔도 좋습니다...❤」
				CASE 2
					PRINTFORMW 「아하아...❤ 갈 것 같은 거예요...? 제 손으로 가고 싶은 거죠...!」
					PRINTFORMW 「후훗❤ 어떤 게 좋으세요? 빨리 할까요? 엉킬까요?」
					;ちょっとしつこい
					;				PRINTFORMW 「ふふ❤ 早いほうがいいですかぁ？ 絡めたほうがいいですかぁ？ 鈴口がいいですかぁ？ 裏筋がいいですかぁ？」
				CASE 3
					PRINTFORMW 「아라, 갈 것 같으신가요? 괜찮아요❤ 자, 자! 가버려요❤」
					PRINTFORMW 「스윽 스윽❤ 슉❤ 푸욱❤」
				CASEELSE
					PRINTFORMW 「거시기 엄청 뜨겁다…! 벌써 폭발할 것 같다…!」
					PRINTFORMW 「괜찮습니다. 제가 이대로 시코시코 해드리겠습니다❤ 그것❤ 뿌욱❤」
			ENDSELECT
		ENDIF
	ELSE
		;サディスティック
		IF M_KOJO_JP_REWRITE_K70_SADISTIC(70)
			;カウンター[手淫]から
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「만져줬으면 좋겠어요? 제 손으로 가고 싶으세요? 가고 싶다면 해도 돼요❤」
					PRINTFORMW 「자아❤ 만져줄게❤ 잔뜩 뿌려보자~❤ 뿌슉❤ 뿌슉❤」
				CASE 2
					PRINTFORMW 「응 후후…❤ 기분 좋아요? %CALLNAME:MASTER%씨, 귀여워요❤」
					PRINTFORMW 「어머, 갈 것 같아요? 괜찮아요❤ 뿜뿜해 주세요❤ 뿜❤ 뿜❤」
				CASE 3
					PRINTFORMW 「아앗❤ %CALLNAME:MASTER%님이 갈 것 같은 게 보여요❤」
					PRINTFORMW 「그럼, 간지럽게 해 드릴 테니 가세요❤ 뿌욱❤ 푸우욱❤」
				CASEELSE
					PRINTFORML 「%CALLNAME:MASTER%씨의 거시기 대단해……읏❤ 단단해요……❤」
					PRINTFORML 「제가 비벼서, 해방시켜 드릴게요❤ 비비비❤ 뿌우욱❤」
			ENDSELECT
		ELSEIF ABL:[[小鈴]]:指 < 3
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「손으로 해줬으면 하나요? 알겠어요」
				CASE 2
					PRINTFORMW 「손으로 하는 거군요…… 네……」
				CASE 3
					PRINTFORMW 「손으로 주무르시는 거군요, 괜찮아요」
				CASEELSE
					PRINTFORMW 「손으로 주물러 줄게요...❤」
			ENDSELECT
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「응읏, 후우…… 이, 이런 느낌일까요……」
				CASE 2
					PRINTFORMW 「흐으윽……! 기, 기분 좋아요어?」
				CASE 3
					PRINTFORMW 「상냥하게…… 자, 어때요?」
				CASEELSE
					PRINTFORMW 「응읏, 응읏…… 어때요... 기분 좋게 하고 있어요...?」
			ENDSELECT
		ELSE
			;一部[身を任せる]から
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「손으로 하는 거군요, 알겠어요읏!」
				CASE 2
					PRINTFORMW 「손으로 해줬으면 해요? 네엣❤」
				CASE 3
					PRINTFORMW 「후후, 자위해주셨으면 하시나 보네요❤ 좋아요옷!」
				CASEELSE
					PRINTFORMW 「좋아요, 제가 시코시코 해 드릴게요읏❤」
			ENDSELECT
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「기분 좋아요? %CALLNAME:MASTER%씨, 귀여워요❤」
				CASE 2
					;二重の意味で…？
					PRINTFORMW 「어때요? 기분 좋아요? 기분이 좋다면 말해줘❤」
				CASE 3
					PRINTFORMW 「%CALLNAME:MASTER%씨…… 기분 좋아 보여❤ 괜찮아요…… 저에게 몸을 맡겨 봐요…❤」
				CASEELSE
					PRINTFORMW 「%CALLNAME:MASTER%씨의 거시기, 굉장해……❤ 점점 커져요……❤」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
