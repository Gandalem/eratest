; Modular ERB: 個人口上/070 Kosuzu [小鈴]/Kosuzu JP/M_KOJO_K70_日記.ERB
;==========================================================
;存在判定
;0だと日記は書かれません。
;==========================================================

@DIARY_JP_REWRITE_K70_EXIST
RETURN 1
;==========================================================
;常時チェックされる日記の状態情報
;簡易版ではCHARAに番号を入れれば自動で処理してくれます
;MAX_DIARY_PAGEの有効範囲は2～100です
;==========================================================

@DIARY_JP_REWRITE_BEFORE_CHECK_K70
#DIM CHARA
CHARA = [[小鈴]]
MAX_DIARY_PAGE:CHARA:0 = 100
FOR LOCAL, 1, MAX_DIARY_PAGE:CHARA:0 + 1
RESULT = 0
TRYCALLFORM DIARY_JP_REWRITE_K{CHARA}_{LOCAL}_HAPPEN
IF RESULT
	IF !DIARY:CHARA:LOCAL || RESULT:2
		DIARY:CHARA:LOCAL = RESULT:1
		SIF RESULT:1 == 3
			CALL CHARA_DIARY_PAGESETTING(CHARA, LOCAL)
	ENDIF
ENDIF
NEXT
;==========================================================
;デイリーイベントで日記が読まれた際の後処理。
;フラグの管理等自由に扱って良い。
;==========================================================

@DIARY_JP_REWRITE_AFTER_CHECK_K70
