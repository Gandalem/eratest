		;一部[身を任せる]から
		PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "…❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "…❤")%」
