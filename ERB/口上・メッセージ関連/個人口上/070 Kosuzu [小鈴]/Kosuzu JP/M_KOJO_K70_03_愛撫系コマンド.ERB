				CASE 2
					PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "❤")% 키스하면서 가자...❤」
					PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "…❤")% 으응-❤」
				CASEELSE
					PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "❤")% 괜찮아요...❤ 이대로...❤ 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "❤")%」
					PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：後", "…❤")% 응아...♡」
			ENDSELECT
		ENDIF
	ELSEIF ABL:70:Ｍ感覚 < 3
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "…❤")%」
				PRINTFORMW 「왠지…… 머리가 멍해져요…❤」
			CASE 2
				PRINTFORMW 「%M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("キス：前", "❤")%」
				PRINTFORMW 「에헤헤……❤ 쪽쪽❤」
