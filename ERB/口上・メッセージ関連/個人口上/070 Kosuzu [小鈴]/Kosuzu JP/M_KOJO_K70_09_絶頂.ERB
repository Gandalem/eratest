; Modular ERB: 個人口上/070 Kosuzu [小鈴]/Kosuzu JP/M_KOJO_K70_09_絶頂.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_JP_REWRITE_MESSAGE_PALAMCNG_B_K70
CALL PALAM_MESSAGE_B
SIF FLAG:時間停止
	RETURN 1
;-------------------------------------------------
;噴乳
;-------------------------------------------------
IF NOWEX:噴乳 && M_KOJO_JP_REWRITE_K70_UFUFU()
	PRINTDATAL
		DATAFORM 「자, 자아~~❤ %M_KOJO_JP_REWRITE_K70_AUTO("母乳")% 나와버려~❤」
		DATAFORM 「응앗❤ %M_KOJO_JP_REWRITE_K70_AUTO("母乳")% 흘러내려~❤」
		DATAFORM 「앗❤ 안 돼❤ %M_KOJO_JP_REWRITE_K70_AUTO("母乳")% 나와버릴 거야❤」
		DATAFORM 「하윽❤ 아아~~❤ %M_KOJO_JP_REWRITE_K70_AUTO("母乳")% 나오겠어~~❤」
	ENDDATA
	WAIT
ENDIF
;;-------------------------------------------------
;;射精
;;-------------------------------------------------
;IF NOWEX:射精
;	PRINTFORMW
;ENDIF
;-------------------------------------------------
;放尿
;-------------------------------------------------
IF NOWEX:放尿 && M_KOJO_JP_REWRITE_K70_UFUFU()
	PRINTDATAL
		DATAFORM 「후으~ ❤ 흘리고 말았어요~❤ 죄송해요~~❤」
		DATAFORM 「싫어어~❤ 오줌으로 나와버려요❤」
		DATAFORM 「앗❤ 안 돼에❤ 흘러버릴 거예요❤」
		DATAFORM 「핫❤ 아아~❤ 나와 버려요~~❤」
	ENDDATA
	WAIT
ENDIF
;-------------------------------------------------
;絶頂
;-------------------------------------------------
;すいません、手抜きです。ご主人様……じゃなかった、阿求（？）許して……。Ｍ絶頂で無いのは仕様です。
;改良してちょっと手抜きじゃなくなった。でも部位に関しては言及しない
IF NOWEX:五重絶頂 || NOWEX:四重絶頂 || NOWEX:三重絶頂 || NOWEX:二重絶頂 || NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ａ絶頂
	IF !CFLAG:[[小鈴]]:うふふ
		PRINTDATAL
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 갈게❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 아앗❤ 갈 것 같아❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 안 돼... 큿❤」
			DATAFORM 「아앗❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 가버리겠어…❤」
			DATAFORM 「안 돼... 앗! 터질 것 같아...! 아아♡」
		ENDDATA
	ELSEIF NOWEX:五重絶頂 || NOWEX:四重絶頂 || NOWEX:三重絶頂 || NOWEX:二重絶頂
		PRINTDATAL
			DATAFORM 「가겠어❤ 갈 거야아앗❤ 가버릴 거야아앗❤」
			DATAFORM 「앗❤ 안 돼…❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：急", "❤")% 갈게❤」
			DATAFORM 「하아~~❤ 벌써❤ 갈게❤ 가게 될 것 같아아~❤」
			DATAFORM 「응아~~❤ 가겠어❤ 갈 거야❤ 가게 될 것 같아아~❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 기분 좋아요❤ 갈게❤ 갈 것 같아~❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 햐아~❤ 죄송해요❤ 가버릴 거예요❤」
			DATAFORM 「%CALLNAME:MASTER%자…! 안 돼애❤ 가겠어❤ 갈 거야아~❤」
			DATAFORM 「앗❤ 갈게…❤ 크윽❤ ~~~~~ッ❤❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 안 돼❤ 놓아줘❤ 갈 것 같아❤ 가게 될 것 같아❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% 이거❤ 대단해❤ 응아❤ 가버릴 거야❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% %CALLNAME:MASTER%씨❤ 갈게❤ 갈게❤」
			DATAFORM 「돌아갈 것 같아❤ 해버릴 것 같아❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤ ", 1)% 갈 것 같아❤」
			DATAFORM 「아아~❤ 굉장한 게 와❤ 갈게❤ 가버릴 거야❤ 응아~❤」
			DATAFORM 「갈게❤ 갈게요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "❤")% %CALLNAME:MASTER%씨❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：被虐", "❤")% 안 돼애❤ 부서질 것 같아❤ 응아❤」
		ENDDATA
		;単発絶頂
	ELSE
		PRINTDATAL
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 갈게❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 가 터질 것 같아요❤」
			DATAFORM 「앗 ❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% 가버릴 것 같아...❤」
			DATAFORM 「음~!! 갈 것 같아❤ 가아아악❤」
			DATAFORM 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：小", "！")% %CALLNAME:MASTER%씨...!! 갈 것 같아❤ 가고 있어❤」
			DATAFORM 「안 돼...윽! 올 것 같아...!! 아앗❤」
		ENDDATA
	ENDIF
	WAIT
	IF M_KOJO_JP_REWRITE_K70_UFUFU()
		IF !CFLAG:[[小鈴]]:うふふ && !TCVAR:[[小鈴]]:発情 && !TCVAR:[[小鈴]]:発情 && ALCOHOL_FACE(70) != "酔いどれ" && ALCOHOL_FACE(70) != "ぐでぐで"
			PRINTDATAL
				DATAFORM 「모오...! 지금은 안 돼요...」
				DATAFORM 「응~...! 그, 그런 건 이불 위에서...」
				DATAFORM 「무~...! 너무 심하시잖아요...」
				DATAFORM 「모오...! %CALLNAME:MASTER%씨의 야한 거...」
				DATAFORM 「모오...! 정말 변태시잖아요...」
			ENDDATA
			WAIT
			;満足フラグ
		ELSEIF M_KOJO_JP_REWRITE_K70_MANZOKU(70)
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「하아... 하아...❤ 최고예요...❤」
				CASE 2
					PRINTFORMW 「하아... 하아... ❤ 녹아버려요... ❤」
				CASEELSE
					PRINTFORMW 「하아... 하아... ❤ 행... 행복해... ❤」
			ENDSELECT
			TCVAR:70:355 = 1
			TALENT:70:機嫌 = 1
		ELSEIF BASE:70:気力 <= 0
			PRINTFORMW 「하아... 하아... 하아...♡ 모... 이제 안 돼...♡ 의... 의식이 날아가 버릴 것 같아...♡」
		ELSE
			PRINTFORMW 「하아... 하아...❤」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;-------------------------------------------------
;満足フラグ判定関数
;-------------------------------------------------

@M_KOJO_JP_REWRITE_K70_MANZOKU(ARG)
#FUNCTION
;SIF BASE:ARG:体力 <= MAXBASE:ARG:体力 / 2
;	RETURNF 0
LOCAL = EX:ARG:Ｃ絶頂 + EX:ARG:Ｖ絶頂 + EX:ARG:Ａ絶頂 + EX:ARG:Ｂ絶頂 + EX:ARG:Ｍ絶頂
IF CFLAG:ARG:溜まってる度 <= 100
	RETURNF 1
ELSEIF CFLAG:ARG:溜まってる度 < 300 && LOCAL >= 20
	RETURNF 1
ELSEIF CFLAG:ARG:溜まってる度 < 500 && LOCAL >= 40
	RETURNF 1
ELSEIF CFLAG:ARG:溜まってる度 < 800 && LOCAL >= 60
	RETURNF 1
ELSEIF LOCAL >= 80
	RETURNF 1
ENDIF
