;-------------------------------------------------
IF LOCAL
	;同時射精
	IF NOWEX:射精 && NOWEX:MASTER:射精
		RETURN 1
		;TARGETだけ射精
	ELSEIF NOWEX:射精
		;PLAYERについてる
		IF GETBIT(TALENT:PLAYER:性別,1)
			RETURN 1
			;付いてない
		ELSE
			RETURN 1
		ENDIF
		;PLAYERだけ射精
	ELSE
		;TARGETについてる
		IF GETBIT(TALENT:性別,1)
			RETURN 1
			;付いてない
		ELSEIF M_KOJO_JP_REWRITE_K70_UFUFU()
			PRINTFORMW 「아하♪ 잔뜩 나왔네요❤」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

