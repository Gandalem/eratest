					PRINTFORML 「♪～～」
			ENDSELECT
			;蔵書整理
		ELSEIF CFLAG:70:職種 == 40
			;特に要らない気がした
			;WAIT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;記入チェック（=0, 非表示、1, 表示）
