@M_KOJO_JP_REWRITE_EVENT_K70_17(ARG,ARG:1)
#DIM 表示済み
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
表示済み = 0
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ARG=1～3は排他
	;謎の快感
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「응응……읏!?」
		PRINTFORMW (지금…… 뭔가……)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「앗!」
		PRINTFORMDW 코스즈는 눈에 눈물을 고한 채 뺨을 희미하게 물들이고 있다.
		PRINTFORMW 「에...? 에? 뭐... 뭐야...... 이거...?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;パンツ紛失
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「어라!?」
		PRINTFORMW (왠지 가랑이가......)
		;パンツのことは知らない
		IF FIRSTTIME("パンツ没収", 1)
			PRINTFORMW (에? ……없잖아!? 말도 안 돼……!)
			;パンツを没収したことがある
		ELSE
			PRINTFORML (말... 말도 안 돼...!?)
			PRINTFORMW (아니야... 불가능해...)
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚口内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;精液中毒低精飲
		IF ARG:1 == 1
			;味を知らない
			IF FIRSTTIME("精液の味", 1)
				PRINTFORML 「응그윽!? 콜록, 크헉!」
				PRINTFORMW 「뭐, 뭐야아, 이거... 크헉!」
				PRINTFORMW 「히... 조금 마셔버렸어......」
				;味を知っている
			ELSE
				PRINTFORML 「응그앗!? 콜록콜록!」
				PRINTFORMW 「컥, 크윽, 설마... 콜록!」
				PRINTFORMW 「우웩... 기, 기분 나빠...」
			ENDIF
			;精液中毒低吐き出し＆濃厚精液
		ELSEIF ARG:1 == 2 || ARG:1 == 5
			;味を知らない
			IF FIRSTTIME("精液の味", 1)
				PRINTFORML 「응윽!? 콜록콜록!」
				PRINTFORMW 「뭐, 뭐야, 이... 역겨워, 콜록!」
				PRINTFORMW 「우웩…… 이게, 뭐야……. 기분 나빠……」
				;味を知っている
			ELSE
				PRINTFORML 「응윽!? 콜록콜록!」
				PRINTFORMW 「크, 크윽, 설마, 컥!」
				PRINTFORMW 「으윽…… 왜……. 헉……」
			ENDIF
			;精液中毒低手で覆う
		ELSEIF ARG:1 == 3
			;味を知らない
			IF FIRSTTIME("精液の味", 1)
				PRINTFORML 「응윽!? 콜록콜록!」
				PRINTFORMW 「뭐, 뭐야... 이거, 구역질 나, 컥!」
				PRINTFORMW 「으으... 이게 뭐야... 쓰다, 기분 나빠...」
				;味を知っている
			ELSE
				PRINTFORML 「응윽!? 콜록콜록!」
				PRINTFORMW 「컥, 크으, 설마... 컥!」
				PRINTFORMW 「음그…… 왜 갑자기…… 우푸읏……」
			ENDIF
			;精液中毒高精飲＆濃厚精液
		ELSEIF ARG:1 == 4 || ARG:1 == 6
			PRINTFORML 「응윽!? 꿀꺽!」
			PRINTFORMW 「우으... 뭐야, 방금 그건...」
			PRINTFORMW 「마셔버렸어...」
		ENDIF
		表示済み = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚顔面射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;幼稚持ち＆精液経験100未満
		IF ARG:1 == 1
			;通常ぬぐい取り
		ELSEIF ARG:1 == 2
			IF 表示済み
				PRINTFORMW 「우에…… 얼굴에도 붙고 있어……」
			ELSE
				PRINTFORML 「헉…… 이게 뭐야……」
				PRINTFORMW 「왜 이런 걸…… 기분 나빠……」
			ENDIF
			;顔射精液舐めとり
		ELSEIF ARG:1 == 3
			IF 表示済み
				PRINTFORMW 「아…… 얼굴에도 붙었네…… 핥짝……」
			ELSE
				PRINTFORML 「히익…… 왜 이러는 거지……」
				PRINTFORMW 「음…… 핥아……」
			ENDIF
		ENDIF
		表示済み = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚手淫射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;ぬぐい取り
		IF ARG:1 == 1
			IF 表示済み
				PRINTFORMW 「이런 곳에도……」
			ELSE
				PRINTFORML 「우에…… 이게 뭐야……」
				PRINTFORMW 「어, 어떡하지……」
			ENDIF
			;舐めとり
		ELSEIF ARG:1 == 2
			IF 表示済み
				PRINTFORMW 「아아…… 손에도…… 핥짝……」
			ELSE
				PRINTFORML 「에... 왜...」
				PRINTFORMW 「음... 핥아...」
			ENDIF
		ENDIF
		表示済み = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚アナル射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;Ａ感覚0
		IF ARG:1 == 1
			PRINTFORML 「히익!!」
			PRINTFORMW 「으윽... 뭐, 뭐야..., 엉덩이가 갑자기... 아파....」
			;ソレ以外
		ELSEIF ARG:1 == 2
			PRINTFORML 「히익!!」
			PRINTFORMW 「으윽... 뭐, 뭐야..., 엉덩이가 갑자기... 아파....」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚処女喪失】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		IF 表示済み == 2
			PRINTFORML 「크윽……!!」
			PRINTFORMW 「뭐, 뭐야…… 아파…… 누가…… 도와줘……」
		ELSE
			PRINTFORML 「히윽!!」
			PRINTFORMW 「뭐, 뭐야…… 아파…… 누가…… 도와줘……」
		ENDIF
		表示済み = 2
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚膣内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		PRINTFORML 「으윽…… 뭐야, 대체 뭐예요……」
		PRINTFORMW 「엄마…… 도와줘…… \@ TALENT:70:恋慕 ? %CALLNAME:MASTER% # 레이무 \@씨…… 우에엥……」
		表示済み = 2
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;時間停止解除共通
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;小鈴の部屋追い出し
		IF M_KOJO_JP_REWRITE_K70_SUZUNAAN(CFLAG:70:現在位置) == 3
			PRINTFORMW 「도, 도둑이야아아아!!!」
			CALL M_KOJO_JP_REWRITE_K70_KOSUZU_BURST
		ENDIF
	ENDIF
ENDIF
RETURN 1
