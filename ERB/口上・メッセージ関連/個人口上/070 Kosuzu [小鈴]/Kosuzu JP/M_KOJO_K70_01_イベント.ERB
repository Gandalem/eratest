	ELSEIF STRCOUNT(SENSE, "(眼鏡)")
		PRINTFORMW 「%CALLNAME:MASTER%님께 어울려요!」
	ELSEIF STRCOUNT(SENSE, "(マニアック)")
		PRINTFORMW 「이거, 희귀템이라구요!」
	ELSEIF STRCOUNT(SENSE, "(かっこいい)")
		PRINTFORMW 「멋있는 %CALLNAME:MASTER%님께는 이걸로 할까 해서……❤」
	ELSE
		PRINTFORMW 「기뻐해 주시면 좋겠어요……」
	ENDIF
	RETURN 1
