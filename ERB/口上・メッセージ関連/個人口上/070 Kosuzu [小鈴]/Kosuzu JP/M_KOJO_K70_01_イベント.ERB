SIF CFLAG:[[小鈴]]:睡眠
	RETURNF 0
;添い寝中
SIF CFLAG:ARG:添い寝中
	RETURNF 0
SIF CFLAG:[[小鈴]]:添い寝中
	RETURNF 0
;浴場
SIF BATHCHECK(CFLAG:MASTER:現在位置)
	RETURNF 0
RETURNF 1
