		PRINTFORML 이 데이터의 코스즈는 키스를 경험한 상태이다.
ENDIF
IF EXP:70:精飲経験
	SIF FIRSTTIME("精液の味", 0, 70)
		PRINTFORML 이 데이터의 코스즈는 정액 맛을 알고 있습니다
ENDIF
RESETCOLOR
IF CFLAG:70:1100 == VERSION
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	PRINTFORML 최신 버전입니다(ver.{CFLAG:70:1100 / 100}.{CFLAG:70:1100 % 100})
	RESETCOLOR
ELSE
	SIF !CFLAG:70:1002
		CFLAG:70:1002 = DAY
	IF !CFLAG:70:1004 && ABL:70:親密
		PRINTFORML 코스즈에게 자기소개는 마친 것으로 할까?
		PRINTL [1] - 네
		PRINTL [0] - 아니
		INPUT
		IF RESULT
			CFLAG:70:1004 = 1
			PRINTFORMW 자기소개는 마쳤어요.
		ELSE
			PRINTFORMW 조만간 자기소개를 하게 될 것 같습니다
		ENDIF
	ENDIF
	IF !CFLAG:70:1005 && ABL:70:親密
		PRINTFORML 코스즈가 있는 스즈나안에 들러도 괜찮을까요?
		PRINTL [1] - 네
		PRINTL [0] - 아니요
		INPUT
		IF RESULT
			PRINTFORML 어느 정도 방문한 것으로 할까요? (지금으로서는 특별한 의미는 없다)
			PRINTL [5] - 아주 많이
			PRINTL [3] - 보통이다
			PRINTL [1] - 조금
			PRINTL [0] - 역시 그만둔다
			INPUT
			CFLAG:70:1005 = ABL:70:親密 * LIMIT(RESULT, 0, 5)
		ENDIF
		PRINTFORMW 당신의 방문 경험은 현재 {CFLAG:70:1005} 회입니다
	ENDIF
	IF TALENT:70:酒耐性 != -1
		PRINTFORML [酒に弱い] 「술에 약하다」를 붙여도 괜찮은가?
		PRINTL [1] - 좋다
		PRINTL [0] - 안 된다
		INPUT
		IF RESULT
			TALENT:70:酒耐性 = -1
			CALL M_KOJO_JP_REWRITE_COLOR_K70
			PRINTFORMW 「아하♪」
			RESETCOLOR
		ELSE
			PRINTPLAIN [332] 술을 권하는 입장이 조금 달라집니다. 양해 부탁드립니다.
			PRINTW 
		ENDIF
	ENDIF
	IF RELATION:[[小鈴]]:[[阿求]] < 200 || RELATION:[[小鈴]]:[[霊夢]] < 120 || RELATION:[[小鈴]]:[[魔理沙]] < 120 || RELATION:[[小鈴]]:[[紫]] < 120 || RELATION:[[小鈴]]:[[文]] < 120 || RELATION:[[小鈴]]:[[マミゾウ]] < 150
		PRINTFORML 작중에서 관련 있는 캐릭터와의 상성을 변경해도 되는가?
		PRINTL [1] - 괜찮다.
		PRINTL [0] - 안 된다.
		INPUT
		IF RESULT
			;めんどくさいので無駄多いけど80番まで回す
			FOR LOCAL, 1, [[阿求]] + 1
			IF GROUPMATCH(LOCAL, [[霊夢]], [[魔理沙]], [[紫]], [[文]], [[マミゾウ]], [[阿求]])
				PRINTFORM %CALLNAME:LOCAL, 12, LEFT%{RELATION:70:LOCAL, 3}\% → 
				IF LOCAL == [[阿求]]
					RELATION:70:LOCAL = 200
				ELSEIF LOCAL == [[マミゾウ]]
					RELATION:70:LOCAL = 150
				ELSE
					RELATION:70:LOCAL = 120
				ENDIF
				PRINTFORML {RELATION:70:LOCAL, 3}\%
			ENDIF
			NEXT
			PRINTFORMW 위와 같은 상태가 되었다.
		ELSE
			PRINTFORMW 변경하지 않았습니다
		ENDIF
	ENDIF
	CFLAG:70:1100 = VERSION
	CALL M_KOJO_JP_REWRITE_COLOR_K70
	PRINTFORML 업데이트 완료!(버전.{CFLAG:70:1100 / 100}.{CFLAG:70:1100 % 100})
	RESETCOLOR
ENDIF
RETURN 1
