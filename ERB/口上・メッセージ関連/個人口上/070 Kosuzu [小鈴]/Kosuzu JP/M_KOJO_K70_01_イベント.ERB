;スイカ割り
;スイカ割りの口上はムシバトル同様、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;カギ括弧は自動で付きます
;"衝突","結果"のみ、口上色が自動で付きます
;"衝突","結果"以外は半角26文字（全角13文字）までの文字数制限があります。はみ出ないように気をつけてください
;数パターンあると雰囲気が出ます（%TEXTR( / )%を使うと良い）
;==================================================

@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_SUIKA(ARGS, ARG)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1
	SELECTCASE ARGS
		CASE "衝突"
			;-------------------------------------------------
			;場外に出てあなたがキャラと衝突した際の台詞
			;文字数制限はありません,汎用台詞もありません
			;-------------------------------------------------
			RESULTS = あたっ！ それは私です！
		CASE "そこだ！"
			RESULTS = %TEXTR("そこです！/今です！/今！ 今！")%
		CASE "近い"
			RESULTS = %TEXTR("近いです！/近づいてます！/もう少しです！")%
		CASE "遠い"
			RESULTS = %TEXTR("まだ遠いです/遠いですね～/まだ離れています")%
		CASE "かなり遠い"
			RESULTS = %TEXTR("ずっと遠くですよー/まだまだ離れています")%
		CASE "前"
			RESULTS = %TEXTR("前です/そのまま、まっすぐ/そっちです")%
		CASE "少し前"
			RESULTS = %TEXTR("もうちょっと前です！/少し前です！/あと一歩かな？")%
		CASE "後ろ"
			RESULTS = %TEXTR("逆向いてますよー！/そっちじゃないですよー！/反対方向です！")%
		CASE "少し後ろ"
			RESULTS = %TEXTR("すぐ後ろです！/逆を向いてますね/一歩後ろです！")%
		CASE "右"
			RESULTS = %TEXTR("右です/右ですよー/もっと右です")%
		CASE "少し右"
			RESULTS = %TEXTR("ちょっと右です/少し右です")%
		CASE "左"
			RESULTS = %TEXTR("左です/左ですよー/もっと左です")%
		CASE "少し左"
			RESULTS = %TEXTR("ちょっと左です/少し左です")%
		CASE "結果"
			;-------------------------------------------------
			;終了後の一言
			;文字数制限はありません,汎用台詞もありません
			;TFLAG:193,
			;   -1=失敗
			;    0=成功
			;    1=大成功
			;    2=木刀で大成功（ボーナス点）
			;ARG
			;    0=正直者
			;    1=ウソつき
			;-------------------------------------------------
			IF ARG
				SELECTCASE TFLAG:193
					CASE -1
						RESULTS = あはは、残念でした～♪
					CASE 0
						RESULTS = お、やりますねえ！
					CASE 1
						RESULTS = すごい！ さすがです！
					CASE 2
						RESULTS = わっ、真っ二つ！
				ENDSELECT
			ELSE
				SELECTCASE TFLAG:193
					CASE -1
						RESULTS = う～ん、残念です……
					CASE 0
						RESULTS = わっ、やった！
					CASE 1
						RESULTS = すごい！ さすがです！
					CASE 2
						RESULTS = わっ！ 真っ二つ！
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
