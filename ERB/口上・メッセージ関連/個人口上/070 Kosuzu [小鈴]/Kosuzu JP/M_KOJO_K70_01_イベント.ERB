@M_KOJO_JP_REWRITE_EVENT_K70_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;やたら分岐あるけど全部正常に動くか確認できてない
	;まぁ変なの表示されたりしてなければ多少の死に分岐くらいは気にしない
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた＆TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2) && !GETBIT(TCVAR:70:360, 3)
		CALL M_KOJO_JP_REWRITE_EVENT_K70_1_MAINMAP(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;統合しました
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「앗!! %CALLNAME:MASTER%씨! 저, 저기 죄송해요!!」
		PRINTFORMW 「저... 같이 있어도 괜찮을까요...?」
		PRINTFORMW 「그럼, 말씀에 응해서……❤」
		CALL M_KOJO_JP_REWRITE_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「앗!! %CALLNAME:MASTER%씨! 저, 저기... 죄송해요!!」
		PRINTFORMW 「아, 아무것도 안 봤어요! 실, 실례했어요~~!」
		CALL M_KOJO_JP_REWRITE_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;謎の設定
		PRINTFORML 「앗!! %CALLNAME:MASTER%씨엣!」
		PRINTFORMW 「지금은 여자가 이용하는 시간이에요! 어서 나가 주세요옷!!」
		CALL M_KOJO_JP_REWRITE_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && !GETBIT(TCVAR:70:360, 3)
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_HALLOWEEN
			;元旦（2年目以降）
		ELSEIF DAY:2 == 1 && DAY:3 == 1 && DAY != 1
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_GANTAN
			;クリスマスイブ
		ELSEIF DAY:2 == 4 && DAY:3 == 24 && !TCVAR:[[小鈴]]:今日の贈り物
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_XMAS
			;鈴奈庵
		ELSEIF M_KOJO_JP_REWRITE_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_ENTER_SUZUNAAN(M_KOJO_JP_REWRITE_K70_FOLLOWER())
		ELSE
			IF TALENT:[[小鈴]]:恋慕
				PRINTFORML 「아, %CALLNAME:MASTER%씨, %M_KOJO_JP_REWRITE_K70_AISATSU()%!」
				;人里
				IF INRANGE(CFLAG:[[小鈴]]:現在位置, 200, 300)
					;非番
					IF CHARA_HOLIDAY([[小鈴]], 1)
						IF TALENT:[[小鈴]]:恋人
							PRINTFORMW 「오늘은 비번이에요!」
							SELECTCASE RAND:5
								CASE 1
									PRINTFORMW 「혹시 만나러 와 주신 거예요?」
								CASE 2
									PRINTFORMW 「저기…… 저, 데이트 안 해주실래요!?」
								CASE 3
									PRINTFORMW 「그러니까 하루 종일 한가한 거예요! 그래서……」
								CASE 4
									PRINTFORMW 「괜찮으면 같이 외출이라도 할까……」
								CASEELSE
									PRINTFORMW 「그래서, 음... 같이 밥이라도 먹을래요?」
							ENDSELECT
						ELSE
							PRINTFORMW 「오늘은 비번이거든요~」
							SELECTCASE RAND:5
								CASE 1
									PRINTFORMW 「잠깐 이야기 좀 하지 않을래요?」
								CASE 2
									PRINTFORMW 「같이 있어 줄래……」
								CASE 3
									PRINTFORMW 「시간 되시면 산책이라도 같이 하실래요?」
								CASE 4
									PRINTFORMW 「저기, 같이 차 같은 거 마시러……」
								CASEELSE
									PRINTFORMW 「그래서 하루 종일 한가해서……」
							ENDSELECT
						ENDIF
						;仕事日
					ELSE
						SELECTCASE RAND:5
							CASE 1
								PRINTFORMW 「오늘은 무슨 용무로 마을에 오셨나요?」
							CASE 2
								PRINTFORMW 「오늘 하실 일은 다 끝났어요?」
							CASE 3
								PRINTFORMW 「오늘은 어디로 가세요?」
							CASE 4
								PRINTFORMW 「쇼핑 중이세요?」
							CASEELSE
								PRINTFORMW 「꽤 바빠 보이시네요」
						ENDSELECT
					ENDIF
					;人里以外
				ELSE
					PRINTFORMW 「이런 곳에서 만나다니 드물네요」
				ENDIF
			ELSE
				PRINTFORMW 「아, %CALLNAME:MASTER%씨, %M_KOJO_JP_REWRITE_K70_AISATSU()%」
			ENDIF
		ENDIF
		;バレンタイン
		SIF DAY:2 == 4 && DAY:3 == 14
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_VALENTINE
		CALL M_KOJO_JP_REWRITE_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7 && !GETBIT(TCVAR:70:360, 3)
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_HALLOWEEN
			;元旦（2年目以降）
		ELSEIF DAY:2 == 1 && DAY:3 == 1 && DAY != 1
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_GANTAN
			;クリスマスイブ
		ELSEIF DAY:2 == 4 && DAY:3 == 24 && !TCVAR:[[小鈴]]:今日の贈り物
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_XMAS
			;鈴奈庵
		ELSEIF M_KOJO_JP_REWRITE_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
			CALL M_KOJO_JP_REWRITE_EVENT_K70_1_ENTER_SUZUNAAN(M_KOJO_JP_REWRITE_K70_FOLLOWER())
		ELSE
			IF FLAG:デート相手 == [[阿求]]
				;5の扱いが鈴奈庵で遭う時と異なってるのは仕様
				PRINTFORMW 「아, %CALLNAME:MASTER%씨, %M_KOJO_JP_REWRITE_K70_AISATSU()%\@ TALENT:70:恋慕 ? ! #  \@」
				SELECTCASE M_KOJO_JP_REWRITE_K70_BALANCE([[小鈴]], [[阿求]])
					CASE "独占", "信頼"
						PRINTFORML 「아라, 오늘은 아큐랑 데이트예요~?」
						PRINTFORMW 「후음, %CALLNAME:MASTER%씨는 대단한 분이시겠죠」
						PRINTFORMW 「뭐, 저도 그런 걸로 일일이 눈썹 축 늘어뜨리진 않으니까요~」
						PRINTFORMW 「게다가 아큐는 소중한 친구니까, 약간의 말실수는 신경 쓰지 않을 거예요♪」
					CASE "悲恋"
						PRINTFORMW 「오늘도 아큐랑 함께이시네요」
