@M_KOJO_JP_REWRITE_SPEVENT_K70_2(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME("告白")
			PRINTL 
			PRINTFORMDW 데이트를 마치고 돌아오는 길, 코스즈의 발걸음이 불안정해지더니 이윽고 걸음을 멈춘다.
			PRINTFORMDL 이런 순간의 그녀는 무언가 고민하고 있을 것이다.
			PRINTFORMDL 그렇게 생각한 %조사처리(CALLNAME:MASTER,"는")% 걱정하며 코스즈를 정면으로 마주 보고 천천히 다가갔다.
			PRINTW 
			PRINTFORMW 「%CALLNAME:MASTER%씨…… 저, 그게……」
			PRINTFORMW 「저기…… 나…… 아……」
			PRINTFORMW 「좋아해요! 저, %조사처리(CALLNAME:MASTER,"를")% 좋아해!!」
			PRINTFORMW 「진심이에요! 누구에게도 지고 싶지 않고, 누구에게도 빼앗기고 싶지 않아요!」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 옆에 없을 때도…… %조사처리(CALLNAME:MASTER,"가")% 다른 여자애들이랑 얘기하고 있을 때도……」
			PRINTFORMW 「가슴이 조여와서…… 괴로워요…… 그래서……」
			PRINTFORMW 「그러니까 %CALLNAME:MASTER%씨! 저의…… 나만의 연인이 되어 주세요!!」
		ELSE
			PRINTL 
			PRINTFORMDW 데이트를 마치고 돌아오는 길, 코스즈의 걸음이 흔들렸다.
			PRINTFORMDL 짐작 가는 바는 있다. 그녀는 아직 포기하지 못한 모양이다.
			PRINTW 
			PRINTFORMW 「%CALLNAME:MASTER%씨…… 나로는 안 되는 건가요……?」
			PRINTFORMW 「언제나 이렇게 데이트를 해주시는데……」
			PRINTFORMW 「기쁘긴 해요…… 기쁘지만…… 역시 괴롭네요……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;お断りしてない
		IF FIRSTTIME("返答")
			PRINTFORMW 「정…… 정말인가요……?」
			PRINTFORMW 「우, 기뻐…… 다행이야……」
			PRINTFORMW 「나, 거절당하면 어떡하나…… 계속 무서웠어……」
			PRINTFORMW 「하지만, 제대로 말할 수 있어서 다행이에요…… %CALLNAME:MASTER%씨가 받아주셔서…… 정말 다행이야……」
			;日記を書く
			CALL M_KOJO_JP_REWRITE_DIARYSETTING_K70(43)
			;お断りしたことある
		ELSE
			PRINTFORMW 「에…… 지금…… 무슨 말씀이세요……」
			PRINTFORMW 「정, 정말이세요...? 저, 괜찮으신 거예요...?」
			PRINTFORMW 「흐윽, 기뻐요…… 다행이에요……」
			PRINTFORMW 「저 혹시 싫어하게 된 건 아닐까…… 계속 무서웠어요……」
			PRINTFORMW 「하지만 희망을 놓지 않고 있어서 다행이에요…… %CALLNAME:MASTER%님이 받아주셔서…… 정말 다행이에요……」
			;日記を書く
			CALL M_KOJO_JP_REWRITE_DIARYSETTING_K70(45)
		ENDIF
		PRINTFORML 「후후……❤ 앞으로 어떤 일들이 있을지는 모르겠지만」
		PRINTFORMW 「계속 함께 있자고 해요♪ %CALLNAME:MASTER%씨❤」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;初めてのお断り
		IF FIRSTTIME("返答")
			PRINTFORMW 「그렇……군요……」
			PRINTFORMW 「아니에요…… 괜찮아요…… %CALLNAME:MASTER%씨가 그렇게 말씀하신다면……」
			PRINTFORMW 「하지만 저, 포기하지 않을 거예요……!」
			PRINTFORMW 「언젠가 %CALLNAME:MASTER%곁에 걸맞은 여자가 되어 보이겠어요……!」
			PRINTFORMW 「그러니까…… 윽…… 우으……」
			;日記を書く
			CALL M_KOJO_JP_REWRITE_DIARYSETTING_K70(42)
			;お断り二回目以降
		ELSE
			PRINTFORMW 「…………아니에요…… 저야말로…… 죄송해요……」
			PRINTFORMW 「집착하는 여자는 싫어지죠……」
			PRINTFORMW 「하지만 %조사처리(CALLNAME:MASTER,"랑")% 같이 있으면…… 힘들어서……」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 다정함이…… 괴로워요……」
			PRINTFORMW 「그래서…… 으윽…… 흐윽……」
		ENDIF
		;泣かせんなよ
		RETURN 1
	ENDIF
ENDIF
RETURN 1
