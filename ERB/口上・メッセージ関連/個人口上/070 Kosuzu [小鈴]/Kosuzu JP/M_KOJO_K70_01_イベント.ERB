		PRINTFORMW 「아무리 %CALLNAME:MASTER%씨라도 안 돼요!!」
		PRINTFORMW 「조금은 제 마음도 생각해 주세요옷!」
		TCVAR:70:350 = 3
		TALENT:70:機嫌 = -1
		BASE:70:怒り += MAXBASE:70:怒り
		CALL M_KOJO_JP_REWRITE_K70_YAMETEKUDASAI(70, 3, 1)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「으응…… 알겠어……」
		IF TALENT:[[小鈴]]:恋人
			PRINTFORMW 「우리 연인이잖아요……❤」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%님을 위해서니까……❤」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「음……알겠다. 결심했다……!」
		PRINTFORMW 「책임, 지어 주십시오❤」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
