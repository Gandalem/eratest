	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[紫]]
		PRINTFORMW 「앗! 유, 유카리 씨…… %M_KOJO_JP_REWRITE_K70_AISATSU()%……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;文が入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[文]]
		PRINTFORMW 「앗! 아야 씨! 이건 그, 그게……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;マミゾウが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[マミゾウ]]
		PRINTFORMW 「앗! 마미조 씨! 이건 그, 저기……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;阿求が入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[阿求]]
		SELECTCASE M_KOJO_JP_REWRITE_K70_BALANCE([[小鈴]], [[阿求]])
			CASE "独占", "信頼"
				PRINTFORMW 「아라 아큐! 이제 막 좋은 분위기였는데 방해하지 말아줘욧!」
			CASE "悲恋", "揶揄"
				;阿求と恋人なのにあるのか……？
				PRINTFORMW 「아라 아큐! 미, 미안해…… 아하하」
			CASE "敵対", "恋慕"
				PRINTFORMW 「아라 아큐! 벌써, 지금 좋았는데 너는 다른 데 가 있어라옹!」
			CASEELSE
				PRINTFORMW 「뭐야 아큐냐. 이제 분위기 좀 읽으라고」
		ENDSELECT
		RETURN 1
	ENDIF
	;その他
	SELECTCASE RAND:6
		CASE 1
			PRINTFORML 「아라, 사람이 와버렸네요……」
		CASE 2
			PRINTFORML 「음~…… 좋은 데였는데……」
		CASE 3
			PRINTFORML 「앗, 사람이…… 콜록콜록」
		CASE 4
			PRINTFORML 「저, 죄송해요. 너무 가까웠죠……」
		CASE 5
			PRINTFORML 「아~…… 잠시 거리를 두는 게 좋겠어요……」
		CASEELSE
			PRINTFORML 「음음…… 여기까지만 하자……」
	ENDSELECT
ENDIF
RETURN 1
