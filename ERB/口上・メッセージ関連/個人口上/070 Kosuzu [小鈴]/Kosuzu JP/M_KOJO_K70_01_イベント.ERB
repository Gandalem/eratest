	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:[[小鈴]]:うふふ
			PRINTFORML 「흐으음……」
			PRINTFORMW 「죄송해요, 저 벌써 졸려서…… 하아……」
			PRINTL 
			PRINTFORMDW 어쩔 수 없어서, %조사처리(CALLNAME:MASTER,"는")% 졸려 보이는 코스즈에게 돌아가라고 재촉했다.
		ELSEIF TALENT:[[小鈴]]:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「아아, 슬슬 돌아가야 한다네...」
					PRINTFORML 「더 %CALLNAME:MASTER%씨와 이야기하고 싶은 것이 있었는데~」
				CASE 2
					PRINTFORML 「하아... 졸려지기 시작했다.」
					PRINTFORML 「아쉽지만, 슬슬 돌아간다.」
				CASEELSE
					PRINTFORML 「아차, 벌써 어두워져 버렸네요」
					PRINTFORML 「오늘은 이쯤에서 실례할게요」
			ENDSELECT
			PRINTFORML 「%CALLNAME:MASTER%씨, 또 만나요」
			;キス経験済みで5分の1
			IF TALENT:[[小鈴]]:恋人 && !FIRSTTIME("ファーストキス", 1, [[小鈴]]) && !RAND:5
				PRINTFORMW 「잘 가아! 쪽❤」
				PRINTFORMDW 헤어질 때의 허를 찔러, 코스즈는 %조사처리(CALLNAME:MASTER,"의")% 뺨에 키스를 남기고 떠났다.
			ELSE
				PRINTFORMW 「잘 가~」
			ENDIF
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「후아~하아…… 이제 돌아갈 시간이에요」
				CASE 2
					PRINTFORML 「벌써 어두워졌으니까 돌아가야 해」
				CASEELSE
					PRINTFORML 「아, 벌써 이 시간이네요. 이제 돌아갈게요」
			ENDSELECT
			IF TALENT:[[小鈴]]:思慕
				PRINTFORMW 「잘 가요 %CALLNAME:MASTER%씨, 그럼 또 봐용」
			ELSE
				PRINTFORMW 「잘 가~」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート中帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:うふふ
			IF CFLAG:衰弱
				;うふふ中に疲れて帰る
				PRINTFORML 「흐으읍…… 죄송해요, %CALLNAME:MASTER%씨……」
				PRINTFORMW 「저 이제, 한계예요~……」
				PRINTL 
				PRINTFORMDW 코스즈가 지쳐버려서 데이트는 여기서 끝이 났다.
			ELSE
				;うふふ中に眠くて帰る
				PRINTFORML 「응응~…… 죄송해요, %CALLNAME:MASTER%씨……」
				PRINTFORMW 「저 이제, 졸려요오~……」
				PRINTL 
				PRINTFORMDW 코스즈가 진심으로 졸려 하는 바람에 데이트는 끝이 났다.
			ENDIF
		ELSE
			;通常帰宅と大体同じ
			IF TALENT:[[小鈴]]:恋慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「아아, 슬슬 돌아가야 해요……」
					CASE 2
						PRINTFORML 「하아~ 하아…… 졸려졌어요……」
					CASEELSE
						PRINTFORML 「아라라, 벌써 어두워져 버렸네요」
				ENDSELECT
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「더 %조사처리(CALLNAME:MASTER,"랑")% 놀고 싶었는데~」
					CASE 2
						PRINTFORML 「아쉬운데, 이제 돌아갈게요」
					CASEELSE
						PRINTFORML 「오늘은 이만 실례할게요」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「후아~하아…… 이제 돌아갈 시간이에요」
					CASE 2
						PRINTFORML 「벌써 어두워졌으니까 돌아가야 해」
					CASEELSE
						PRINTFORML 「아, 벌써 이 시간이네요. 이제 돌아갈게요」
				ENDSELECT
			ENDIF
			PRINTFORMW 「그럼 오늘은 즐거웠어요♪ 또 놀러 와요!」
			;キス経験済みで5分の1
			IF TALENT:[[小鈴]]:恋人 && !FIRSTTIME("ファーストキス", 1, [[小鈴]]) && !RAND:5
				PRINTFORMW 「잘 가아! 쪽❤」
				PRINTFORMDW 헤어질 때의 허를 찔러, 코스즈는 %조사처리(CALLNAME:MASTER,"의")% 뺨에 키스를 남기고 떠났다.
			ELSE
				PRINTFORMW 「잘 가~」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;玄関先でお見送り（キャラの自宅位置、またはキャラの部屋でデート終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;お招き部屋
		IF CFLAG:[[小鈴]]:現在位置 == OMANEKIBEYA()
			PRINTFORMW 「후아앙…… 졸려졌어요……」
			PRINTFORMW 「%CALLNAME:MASTER%씨, 안녕히 주무세요……」
			IF !TCVAR:(CFLAG:MASTER:お招き):連泊禁止 && NEMUKE() < 720
				PRINTFORMW 「……아니면, 아침까지 옆에 있어 줄 수 있어……?」
			ELSEIF TALENT:70:恋慕
				PRINTFORMW 「……아니면, 아침까지 옆에 있어 줄 수 있어……?」
			ENDIF
		ELSE
			PRINTFORML 「아, 통금이라서 저는 이만 실례하겠습니다.」
			PRINTFORMW 「오늘은 즐거웠습니다♪ 안녕 %CALLNAME:MASTER%씨, \@ TCVAR:70:354 ? 다음에 다시 초대하겠습니다 # 또 불러주세요 \@」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート終了時に部屋に来ないかと誘う（～から部屋に来ないかと誘われた）
	;（来訪キャラのみ,自宅が無いキャラでも発生します）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:[[小鈴]]:恋人
			PRINTFORML 「저기요, %CALLNAME:MASTER%씨…… 계속은 제 방에서 하지 않을래요...?」
		ELSE
			PRINTFORML 「저기, %CALLNAME:MASTER%씨…… 괜찮으시면 제 방에 오지 않으실래요…?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;部屋に来ないか→「行く」を選択（～に誘われるまま、【MASTER】は【TARGET】の部屋へと向かった……）
	;（これが発生すると十中八九押し倒されます）
