		PRINTFORMW 「이걸로 언제든 %CALLNAME:MASTER%씨가 지켜주는 기분이 들 수 있으니까…❤」
	ELSEIF TALENT:[[小鈴]]:恋慕
		PRINTFORML 「아니, 어차피 그렇다면 피부에서 눈 떼지 않고 가지고 있자고」
		PRINTFORMW 「이걸로 언제든 %CALLNAME:MASTER%씨를 느낄 수 있으니까…❤」
	ELSE
		PRINTFORMW 「아니, 어차피 그렇다면 항상 가지고 있는 게 좋을지도」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	IF STRCOUNT(SENSE, "(妖魔本)")
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 받은 이 요마본……」
		PRINTFORMW 「나한테는 알 수 있어…… 표지만 봐도 이게 실패작이라는 걸……」
		PRINTFORMW 「그렇지만, 요마본인 건 틀림없잖아! %조사처리(CALLNAME:MASTER,"에게")% 감사해야 해!」
		;日記用のフラグ
		TCVAR:[[小鈴]]:381 = 1
	ELSEIF STRCOUNT(SENSE, "(鈴)")
		;プレゼントをあげた女の子が実はこんな風に思ってると思うと悲しくなる
		PRINTFORMW 「%CALLNAME:MASTER%에게서 방울을 받았는데, 음~……」
		PRINTFORMW 「차라리 더 멋진 게 좋았을 텐데 말이야」
	ELSEIF STRCOUNT(SENSE, "(書物)") && !STRCOUNT(SENSE, "(手帳)")
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 받은 이 책…….」
		PRINTFORMW 「일단 읽어보긴 하겠지만……. 표지를 본 것만으로 그다지 재미있을 것 같지 않다는 것이 느껴졌다.」
	ELSEIF STRCOUNT(SENSE, "(眼鏡)")
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 받은 이 안경, 어떡하지」
		PRINTFORMW 「뭐 조금은 써야 %CALLNAME:MASTER%한테 미안하지 않을까……」
	ENDIF
	IF STRCOUNT(SENSE, "(/カード|レアカード)")
		PRINTFORMW 「그래, 이걸 책갈피로 쓰자」
	ELSE
		SELECTCASE CFLAG:[[小鈴]]:1074 % 5
			CASE 1
				PRINTFORMW 「일단 여기에 두자」
			CASE 2
				PRINTFORMW 「이 근처에 장식해 둘까나」
			CASE 3
				PRINTFORMW 「여기에 잘 넣어 두면 되려나……」
			CASE 4
				PRINTFORMW 「음~ 어디에 두면 좋을까……」
			CASEELSE
				PRINTFORMW 「여기에 두어도 상품이라고 생각 안 하겠지……」
		ENDSELECT
		IF CFLAG:[[小鈴]]:1074 >= 3
			;順当にいけば3から
			SELECTCASE CFLAG:[[小鈴]]:1074 % 4
				CASE 1
					PRINTFORMW 「정신 차려보니 이렇게 많이 받아버리고 있네……」
				CASE 2
					PRINTFORMW 「아, 여기엔 이제 둘 수 없나……」
				CASE 3
					PRINTFORMW 「선물도 점점 늘어오네……」
				CASEELSE
					PRINTFORMW 「후후, %CALLNAME:MASTER%씨의 물건이 충실해지고 있네~」
			ENDSELECT
		ENDIF
	ENDIF
	;保存した回数をカウント
	CFLAG:[[小鈴]]:1074 ++
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	IF TALENT:[[小鈴]]:恋人
		PRINTFORML 「하아…… %CALLNAME:MASTER%씨, 저도 더 알아주는 줄 알았는데」
		PRINTFORMW 「이건 아무리 그래도 좀……」
	ELSEIF TALENT:[[小鈴]]:恋慕
		PRINTFORMW 「음~…… %CALLNAME:MASTER%씨, 사실 센스가 별로 아닐지도 몰라……」
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%씨란 대체, 센스가 없는 사람인가 봐……」
	ENDIF
	PRINTFORMW 「어쩔 수 없지만, 엄마한테 부탁해서 몰래 처리해 달라고 해야겠네……」
	RETURN 1
ENDIF
RETURN 1
;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================

@M_KOJO_JP_REWRITE_MESSAGE_COM_K70_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「えっ…私ですか……？」
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「じゃあ、この子で」
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「がんばれー！ %MUSHI_NAME%！」
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「あっ、やられちゃった」
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「あれ、もう終わり…？」
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「負けちゃいました～」
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「あれ、私の勝ちですか…？」
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「まさか勝っちゃうなんて……」
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「残念ですね～」
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「勝ったんですか？ やった～」
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「あらら、残念です」
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1
