			ELSE
				PRINTFORMW 「앗, 이런 시간에 집에 돌아가야 해」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;店番
		IF CFLAG:70:職種 == 47
			SELECTCASE RAND:10
				CASE 1
					PRINTFORML 「%M_KOJO_JP_REWRITE_K70_AISATSU()%～」
				CASE 2
					PRINTFORML 「저기, 이 책은 말이죠――」
