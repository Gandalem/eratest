@M_KOJO_JP_REWRITE_K70_YAMETEKUDASAI(ARG, ARG:1, ARG:2)
;ARG	上げるキャラ
;ARG:1	上げるLV量
;ARG:2	0=CUP, 1=PALAM
;コマンド等の精算前ならCUPにすることでソースに表示されたり刻印取得に関わる,そうできない場合はPALAMを直接上げる
SIF ARG:1 <= 0
	RETURN
LOCAL = PALAMLV:(GETPALAMLV(PALAM:ARG:反感, 15) + ARG:1) - PALAMLV:(GETPALAMLV(PALAM:ARG:反感, 15))
;反感ゼロの時は最低でも+2する
SIF ARG:1 == 1 && GETPALAMLV(PALAM:ARG:反感, 15) == 0
	LOCAL = PALAMLV:2
IF ARG:2
	PALAM:ARG:反感 += LOCAL
ELSE
	CUP:ARG:反感 += LOCAL
ENDIF
