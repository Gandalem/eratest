@M_KOJO_JP_REWRITE_EVENT_K70_31(ARG,ARG:1)
#DIM 前回のブーム
#DIM 今回のブーム
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;※口上はないけどフラグの管理だけする
	;マイブームが無い場合、確率で発生
	IF (!CFLAG:[[小鈴]]:1080 || CFLAG:[[小鈴]]:1080 > 10)
		IF !RAND:24
			前回のブーム = CFLAG:[[小鈴]]:1080 % 10
			CFLAG:[[小鈴]]:1080 = 0
			WHILE !CFLAG:[[小鈴]]:1080
			;種類数を取得
			CALLF M_KOJO_JP_REWRITE_K70_KOSUZUBOOM()
			今回のブーム = RAND:RESULT + 1
			SIF 今回のブーム != 前回のブーム
				CFLAG:[[小鈴]]:1080 = 今回のブーム
			WEND
			;残り日数は40～80日
			CFLAG:[[小鈴]]:1081 = 40 + RAND:41
			CFLAG:[[小鈴]]:1082 = 0
			[IF_DEBUG]
			PRINTFORML ※코스즈 구두 디버깅용
			PRINTFORML !마이부름 발생
			[ENDIF]
		ENDIF
		;残り日数が無くなったらマイブーム終了,
	ELSEIF CFLAG:[[小鈴]]:1081 <= 0
		CFLAG:[[小鈴]]:1080 += 10
		CFLAG:[[小鈴]]:1081 = 0
		CFLAG:[[小鈴]]:1082 = 0
	ELSE
		;マイブームカウントダウン
		CFLAG:[[小鈴]]:1081 --
	ENDIF
	[IF_DEBUG]
	CALL EVENTEND_TSUBUYAKI
	PRINTFORML ※코스즈 구술 디버깅용
	PRINTFORML 마이 부흥:%M_KOJO_JP_REWRITE_K70_KOSUZUBOOM()%(앞으로 {CFLAG:[[小鈴]]:1081}일)
	PRINTFORML 수치:{CFLAG:[[小鈴]]:1080}, 횟수:{CFLAG:[[小鈴]]:1082}
	[ENDIF]
	;	;-------------------------------------------------
	;	;小分岐
	;	;-------------------------------------------------
	;	;今日会っていない
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARG
	;		RETURN 1
	;	ENDIF
	;	;-------------------------------------------------
	;	;今日会っている
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARG == 0
	;		RETURN 1
	;	ENDIF
ENDIF
RETURN 1
