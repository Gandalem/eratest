			CASE 5
				SIF GROUPMATCH(体位, "正常位", "対面座位", "背面座位")
					LOCALS = 「앗❤ 싫어❤ 야한 소리 하지 마세요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 1)%%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
			CASE 6
				SIF GROUPMATCH(体位, "正常位", "対面座位", "騎乗位")
					LOCALS = 「아앗♡ %CALLNAME:MASTER%씨의 거시기♥ 단단해지고 있어요♥ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 1)%%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
			CASE 7
				SIF GROUPMATCH(体位, "後背位", "背面座位")
					LOCALS = 「이런 자세...❤ 하앗❤ 부끄러워요...❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：被虐", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
			CASE 8
