;==================================================
;性交口上セット
;パターン多すぎて分岐大変だったのでデータベース化して状況に応じたものを出力する形式に
;練度,不慣れor経験
;状況,続行or継続or挿入,"続行"は練度関係なし
;体位,"正常位", "後背位", "対面座位", "背面座位", "騎乗位", すべてに対応したものは1
;==================================================

@M_KOJO_JP_REWRITE_K70_VSEXSET(練度, 状況, 体位)
#DIMS 状況
#DIMS 体位
#DIMS 練度
VARSET LOCALS
WHILE LOCALS == ""
IF 状況 == "続行"
	;続行は練度関係なし
	SELECTCASE RAND:7
		CASE 1
			SIF GROUPMATCH(体位, "正常位", "後背位", "対面座位", "背面座位")
				LOCALS = 「아직 계속하실 거예요? ❤ 응앗❤ 네! 계속해주세요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
		CASE 2
			SIF GROUPMATCH(体位, "正常位", "後背位", "対面座位", "背面座位")
				LOCALS = 「계속하실 거예요❤ %CALLNAME:MASTER%님! 건강하시네요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
		CASE 3
			SIF GROUPMATCH(体位, "正常位", "後背位", "対面座位", "背面座位")
				LOCALS = 「이대로 계속하는 건가요❤ 응아앗❤ 하큭❤ 어서 해주세요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
		CASE 4
			SIF GROUPMATCH(体位, "正常位", "後背位", "対面座位", "背面座位")
				LOCALS = 「기다려...! %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 그럴 리가아❤」
		CASE 5
			SIF GROUPMATCH(体位, "後背位", "背面座位")
				LOCALS = 「히익❤ 용서해 주세요❤ 아앙❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
		CASE 6
			SIF GROUPMATCH(体位, "後背位", "背面座位")
				LOCALS = 「그런 거군요❤ 죄송해요❤ 응아앗❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
		CASEELSE
			SIF 1
				LOCALS = 「한 번 더 할까요? 후후❤ 좋아요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
	ENDSELECT
ELSEIF 練度 == "不慣れ"
	IF 状況 == "継続"
		;不慣れ,継続
		SELECTCASE RAND:144
			CASE 1
				SIF GROUPMATCH(体位, "正常位", "後背位", "対面座位", "背面座位")
					LOCALS = 「아, 그렇죠? 거기 좋아요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 1)% 더요❤」
			CASE 2
				SIF 1
					LOCALS = 「%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 안쪽이야❤ 대단해❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 1)% 더 해줘❤」
			CASE 3
				SIF 1
					LOCALS = 「네❤ 네❤ 기분 좋아요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤ ", 1)%%M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")%」
			CASE 4
