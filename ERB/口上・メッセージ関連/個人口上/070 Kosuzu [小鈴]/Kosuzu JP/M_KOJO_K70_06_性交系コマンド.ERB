			CASEELSE
				SIF GROUPMATCH(体位, "正常位", "背面座位")
					LOCALS = 「싫어요❤ 다리 벌리지 말아 주세요❤ %M_KOJO_JP_REWRITE_K70_AUTO("喘ぎ：挿入", "❤")% 부끄러워요옷❤」
		ENDSELECT
	ELSE
