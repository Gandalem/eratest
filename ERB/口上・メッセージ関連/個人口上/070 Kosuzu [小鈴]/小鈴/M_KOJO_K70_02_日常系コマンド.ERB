@M_KOJO_K70_TALKSET(ARG)
SELECTCASE ARG
	;気候と季節の会話
	CASE 1
		IF TALENT:70:恋慕
			LOCALS = ♪
		ELSE
			LOCALS = !
		ENDIF
		;大雨,台風
		IF GROUPMATCH(天候, 5) || FLAG:異常気象 == 9
			PRINTFORML 「\@ OUTROOF(CFLAG:70:現在位置) ? 오늘 정말 비가 온다 # 밖에 정말 비가 온다 \@...」
			PRINTFORMW 「오늘은 읽는 날에 한정이다! 비 오는 날 밖에에서 읽기%LOCALS%」
			;雨,霧雨,霧
		ELSEIF GROUPMATCH(天候, 4, 6, 7)
			PRINTFORML 「오늘은 비가 오네.」
			PRINTFORMW 「이 날은 독서 전용이다! 밖에는 비가 오는데 %LOCALS% 읽기」
			;吹雪,猛吹雪
		ELSEIF GROUPMATCH(天候, 9) || FLAG:異常気象 == 10
			PRINTFORML 「\@ OUTROOF(CFLAG:70:現在位置) ? 눈보라가 오늘 정말 거세다 # 바깥의 눈보라가 오늘 정말 거세다 \@...」
			IF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
				PRINTFORMW 「이런 날에는 코타츠에 앉아 그냥 책을 읽자 %LOCALS%」
				PRINTFORMW 「...음, 사실 나 코타츠 없어.」
			ELSE
				PRINTFORMW 「이런 날에는 코타츠에 있으면서 그냥 책을 읽고 싶어.」
			ENDIF
			;雪,細雪,霧雪,みぞれ,あられ
		ELSEIF GROUPMATCH(天候, 8, 10, 11, 12, 13)
			PRINTFORML 「오늘 눈이 오고 점점 추워지는군...」
			PRINTFORML 「오늘은 독서에만 한정이다!」
			PRINTFORMW 「밖에 비가 오는 동안 독서를 하다니... 잠깐, 아니네. 밖에 눈이 온다%LOCALS%」
			;春
		ELSEIF DAY:2 == 1
			PRINTFORML 「봄에는 편안하네~」
			IF OUTROOF(CFLAG:70:現在位置)
				PRINTFORMW 「이런 날은 그늘 아래서 느긋하게 독서하자%LOCALS%」
			ELSE
				PRINTFORMW 「이런 날에는 그늘에서 여유롭게 독서하고 싶다.」
			ENDIF
			;夏
		ELSEIF DAY:2 == 2
			PRINTFORML 「매일이 덥네...」
			PRINTFORMW 「이번 시즌에는 비가 올 확률이 높으니, 비 오는 날 집에서 책을 가지고 있으면 좋겠어~ %LOCALS%」
			SIF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
				PRINTFORMW 「그래서, 책은 어때?」
			;秋
		ELSEIF DAY:2 == 3
			PRINTFORML 「가을이 빨리 오네~」
			PRINTFORMW 「응, 물론 가을은 가을 독서의 계절이지!」
			;ゲーム内でそんなものはない,あなたが借りれる本は割引対象外なのだ
			SIF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
				PRINTFORMW 「지금 할인 판매 중이야. 책은 어때, %CALLNAME:MASTER%-상?」
			;冬
		ELSEIF DAY:2 == 4
			PRINTFORML 「음... 오늘은 쌀쌀해졌네...」
			PRINTFORMW 「이런 날에는 이불을 덮고 하루 종일 책을 읽고 싶어...」
		ENDIF
		;店内案内の会話
	CASE 2
		SELECTCASE RAND:6
