RETURN RESULT

@M_KOJO_MESSAGE_COM_K70_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K70
	;同梱CSVを前提としています
	;[酒に弱い]ので どぶろく=10, 清酒=8, 鬼殺し=5
	IF ALCOHOL_FACE(70) == "ぐでぐで"
		PRINTFORMW 「끄으~~~」
	ELSEIF ALCOHOL_FACE(70) == "酔いどれ"
		PRINTFORMW 「예에~ 예스예스예스...」
	ELSEIF ALCOHOL_FACE(70) == "ほろ酔い"
		;仕事中
		IF CFLAG:70:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			PRINTFORML 「에이! 아직도 마시고 있어~?」
			PRINTFORMW 「하아, 그럼 어쩔 수 없지~~」
		ELSE
			PRINTFORML 「후후, 고마워♪」
			PRINTFORMW 「야! 부자 양반!」
		ENDIF
	ELSE
		;仕事中
		IF CFLAG:70:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			PRINTFORML 「에이, 술? 아직 일 중이라서...」
			PRINTFORMW 「그럼, 조금만...」
		ELSE
			PRINTFORML 「어머나! 사케라고?」
			PRINTFORMW 「정말 감사해요~!」
		ENDIF
	ENDIF
	;鬼殺し
	IF ALCOHOL_TASTE(TFLAG:194) <= 5
		IF ALCOHOL_FACE(70) == "ぐでぐで"
			;コピペですまぬ
			PRINTFORMW 「～～ ! ! @ # ! $ \% ! ? * * * * ! !」
		ELSEIF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ほろ酔い"
			PRINTFORML 「음~~!!」
			PRINTFORMW 「무우~~ 애에푸~~!! 이야후아~~!!!」
		ELSE
			PRINTFORML 「히야! 이, 이거 강한 사케인가요?」
			PRINTFORMW 「저한테는 좀 너무 힘들어요...」
		ENDIF
		;どぶろく
	ELSEIF ALCOHOL_TASTE(TFLAG:194) >= 10
		IF ALCOHOL_FACE(70) == "ぐでぐで"
			PRINTFORMW 「우오에히이~~! 미안해~~...」
		ELSEIF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ほろ酔い"
			PRINTFORMW 「음~~! 나 취했어~」
		ELSE
			PRINTFORMW 「음~♪ 이거 좋아. 이 은은한 맛이 딱 나한테 맞네~♪」
		ENDIF
		;清酒
	ELSE
		IF ALCOHOL_FACE(70) == "ぐでぐで"
			PRINTFORMW 「아하~♪ 이건 최고야~♪ 기분이 너무 좋아~~♪♪」
		ELSEIF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ほろ酔い"
			PRINTFORMW 「맛있는 사케~ 헤후후~ 정말 맛있어~♪」
		ELSE
			PRINTFORML 「음~ 맛있어...!」
			PRINTFORMW 「하지만 나에겐 좀 힘들지도...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
