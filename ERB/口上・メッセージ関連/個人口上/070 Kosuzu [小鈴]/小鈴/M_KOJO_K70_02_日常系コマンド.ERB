; Modular ERB: 個人口上/070 Kosuzu [小鈴]/小鈴/M_KOJO_K70_02_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K70_300
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K70_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K70_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K70_300_1
#DIM GUEST, 2
#DIMS GUESTS
#DIM POINT
#DIM デート会話, 120
;Custom code from conversation
#DIMS PARTS
#DIMS OUTPUT
;日が変わってたらデート会話リセット
SIF !TCVAR:70:352
	VARSET デート会話
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	RESETCOLOR
	;ゲストキャラ判定
	CALL M_KOJO_K70_GUEST(0)
	GUEST = RESULT
	GUEST:1 = RESULT:1
	GUESTS = %RESULTS%
	;ここに口上書いて下さい
	IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"에게")% 말을 걸려고 하지만, 그녀는 당신이 하는 말을 이해하지 못한다.
		;会話不能の地の文は恋慕でない場合は省略できず、恋慕の時は表示されないので、ここではどちらの場合も同じように表示されるようにする
	ELSEIF TCVAR:70:会話不能
		IF TALENT:70:恋慕
			PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"에게")% 말을 걸려고 하지만 할 말이 떠오르지 않는다.
			PRINTFORMW 어색한 침묵이 방을 가득 채운다...
		ENDIF
	ELSEIF GUESTS != ""
		CLEARLINE 2
		PRINTFORML 세 사람 간의 대화
		DRAWLINE
		;文章上だけであってソース等は変わりません
		PRINTFORML 당신과 %CALLNAME:TARGET%, 그리고 %CALLNAME:(RESULT:1)%이 함께 이야기를 나눈다.
	ELSE
		;デート会話
		IF TALENT:70:恋慕 && FLAG:デート相手 == 70 && DATENAME_SPOT() != "on the road" && !デート会話:(CFLAG:70:現在位置 / 10)
			CLEARLINE 2
			PRINTFORML 데이트 장소는 %DATENAME_SPOT()%이다.
			DRAWLINE
		ENDIF
		IF TFLAG:193 == -2
			IF RAND:2 == 0
				OUTPUT = 당신은 %CONV_WHAT("has")%을 가지고 %PNAME(TARGET)%를 가지려고 노력한다.
			ELSE
				OUTPUT = 당신은 %PNAME(TARGET)%에게 %CONV_WHAT("engage")%를 시도한다.
			ENDIF
		ELSEIF RAND:3 == 0
			OUTPUT = 당신은 %CONV_WHAT("has")%과 함께 %PNAME(TARGET)%를 가졌다.
		ELSEIF RAND:2 == 0
			OUTPUT = 당신은 %PNAME(TARGET)%에 참여한다. %CONV_WHAT("engage")%에서.
		ELSE
			OUTPUT = 당신과 %PNAME(TARGET)%은(는) %CONV_WHAT("has")%를 가지고 있습니다.
		ENDIF
		PRINTFORML %OUTPUT%
	ENDIF
	PRINTW 
	CALL M_KOJO_COLOR_K70
	;酔ってる
	IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
		IF !RAND:2
			PRINTFORML 「쉿~! 그만둬어~ 아하하하~~!」
			PRINTFORMW 「아우나아~! 아하하하~~!」
		ELSE
			PRINTFORML 「아하~~!! 나 웃게 하지 마아~!」
			PRINTFORMW 「이야 하하하하~~!!!」
		ENDIF
		PRINTFORML 
		PRINTFORMW 그것을 대화라고 부르기도 민망하다…
		;会話不能
	ELSEIF TCVAR:70:会話不能
		IF TALENT:70:恋慕 || TALENT:70:思慕
			PRINTFORML 「방금 그거 나한테 말해줬잖아~」
			PRINTFORMW 「정말이야, %CALLNAME:MASTER%-씨, 책을 더 많이 읽어야 할 것 같아. 계속 할 말이 다 떨어질 테니까!」
			PRINTFORMW 「너만을 위한 좋은 책이 있어, 『수치심 책』! 아, 하지만 이건 틀린 거겠지?」
		ELSE
			PRINTFORMW 「아하하... 방금 그 말을 이미 나에게 했었지...」
		ENDIF
		;ゲストキャラと同室だと各キャラ1日1回ずつゲスト会話が発生（お茶とは別）
		;4=小鈴が恋慕(同行中だと最優先),3=ゲストと同行中in鈴奈庵,2=ゲストとデート中orゲストが恋慕で同行中,1=それ以外
	ELSEIF GUESTS != ""
		SELECTCASE GUESTS
			CASE "霊夢"
				IF GUEST == 4
					IF INRANGE(CFLAG:70:現在位置, 0, 100)
						PRINTFORML 「레이무 씨, 이 신사에서 어떤 축복을 받을 수 있나요?」
						PRINTFORMW 「저... 그것은... 연모 자각을 위한 건가요?」
					ELSE
						PRINTFORML 「레이무 씨처럼 강해지려면 어떻게 해야 하죠?」
						PRINTFORMW 「우선, 이지 모드에 집착하지 말라고... 응?」
					ENDIF
				ELSEIF GUEST == 3
					IF !RAND:2
						PRINTFORML 「용무는 다 보셨나요?」
						PRINTFORMW 「레이무 씨에게 신세를 지고 있으니, 천천히 하세요.」
					ELSE
						PRINTFORMW 「맞아! 이 책으로 우리 둘의 운세 궁합을 확인할 수 있어!」
						PRINTFORML 「에, 레이무 씨 혼자서도 할 수 있는데...」
						PRINTFORMW 「그럼 한번 해보자!」
					ENDIF
				ELSEIF GUEST == 2
					PRINTFORML 「레이무 씨랑 다른 사람들도 요즘 사이가 좋아졌어.」
					PRINTFORMW 「봐, 지금도 손을 잡고 있잖아.」
					PRINTFORML 「에? 못 봤어?」
					PRINTFORMW 「후후, 이제 얼굴이 빨개지기 시작했네.」
				ELSE
					PRINTFORML 「아 맞다, 레이무 씨가 여기 계시니까 그녀에게 하고 싶은 말이 있어.」
					PRINTFORMW 「It's been rumored recently in the village that...」
				ENDIF
			CASE "魔理沙"
				IF GUEST == 4
					IF INRANGE(CFLAG:70:現在位置, 500, 600) && FLAG:住み込みキャラ != 70
						IF MAIN_MAP == 5
							PRINTFORMW 「%CALLNAME:MASTER%-씨와 마리사는 이 숲에 살고 있죠...」
						ELSE
							PRINTFORMW 「마리사 씨는 이 숲에 살지 않나요...」
						ENDIF
						PRINTFORML 「착해야겠어, 나도 여기서 살아보고 싶으니까...」
						PRINTFORMW 「하지만 그렇다고 해도, 요괴들은 소름이 끼치잖아～!」
					ELSE
						PRINTFORML 「마리사 씨의 빗은 멋지네요~」
						PRINTFORML 「그것으로 하늘을 날 수 있겠어요.」
						PRINTFORMW (%CALLNAME:MASTER%-님과의 공중 여행이라니, 정말 로맨틱하네요~)
						PRINTL 
						PRINTFORMW 「에?! 마법사가 아니면 날 수 없단 거야?! 쯧...」
					ENDIF
				ELSEIF GUEST == 3
					IF !RAND:2
						PRINTFORML 「용무는 다 보았나?」
						PRINTFORMW 「마리사 씨에게 신세 지고 있으니, 부디 편히 가지게.」
					ELSE
						PRINTFORML 「맞아! 외부 세계에서 가져온 카드 게임이 마법의 컬렉션이라고 해.」
						PRINTFORMW 「마법에 대해 잘 몰랐으니, 마리사 씨랑 같이 한번 해보는 건 어때?」
					ENDIF
				ELSEIF GUEST == 2
					PRINTFORML 「마리사는 다른 이들과 요즘 잘 지내고 있네.」
					PRINTFORMW 「봐, 지금도 손을 잡고 있어.」
					PRINTFORML 「에? 못 봤어?」
					PRINTFORMW 「후후, 이제 얼굴이 붉어지기 시작했군.」
				ELSEIF GUEST == 1
					PRINTFORML 「아 맞다, 마리사 씨가 여기 계시니 할 말이 좀 있어서 말이야.」
					PRINTFORMW 「최근 마을에서 소문이 돌았는데...」
				ENDIF
			CASE "紫"
				IF GUEST == 4
					PRINTFORML 「유카리 씨는 어떤 사람일까? 그녀의 오라가 다르다는 건 분명해...」
					PRINTFORMW 「그런데도 숨기는 것 같지는 않아. 내가 알아차리기 전에 그냥 사라지기만 해...」
					PRINTFORMW 「하지만 나쁘진 않은 요괴라고 생각해.」
				ELSEIF GUEST == 3
					PRINTFORML 「음, 저, 두 분께 오늘 무슨 도움을 드릴 수 있을까요?」
					PRINTFORMW 「또 내가 뭘 잘못한 걸까...?」
				ELSEIF GUEST == 2
					PRINTFORML 「%CALLNAME:MASTER%-씨는 유카리 씨를 얼마나 잘 알고 있나요?」
					PRINTFORMW 「그분은 제가 아는 것보다 더 많이 알지도 모르겠어요, 좀 사적인 느낌이네요.」
				ELSEIF GUEST == 1
					PRINTFORML 「%CALLNAME:MASTER%-씨는 가끔 일어나는 영혼의 사라짐에 대해 알고 있나요?」
					PRINTFORMW 「친숙한 장소에서도 예기치 않게 일어나니 조심해요, 아하하...」
				ENDIF
			CASE "文"
				IF GUEST == 4
					IF INRANGE(CFLAG:70:現在位置, 700, 900)
						PRINTFORML 「요괴 산은 정말 무서운 곳일지도 모르겠어.」
						PRINTFORMW 「하지만 아야 씨 같은 텐구님을 보면 조금 안심이 돼.」
					ELSE
						PRINTFORMW 「아마 아야 씨는 본분마루 신문을 쓰는 텐구일 거라는 걸 알고 있겠지만.」
						PRINTFORML 「그녀는 텐구임에도 종종 마을에 와서 사람들을 정중하게 인터뷰한다.」
						PRINTFORMW 「정말 이상한 사람이란―」
					ENDIF
				ELSEIF GUEST == 3
					;カリスマは景気の指針
					IF CHARISMA_NOW() >= 100
						PRINTFORML 「아야 씨의 신문이 꽤 잘 팔리고 있어―」
						PRINTFORMW 「Depending on the future prospects, she might increase the number of prints.」
					ELSE
						PRINTFORML 「아야 씨의 신문이 요즘 잘 팔리지 않는 것 같아...」
						PRINTFORMW 「새로운 소재를 좀 추가하는 것이 좋을 것 같다.」
					ENDIF
					SIF !FLAG:新聞購読
						PRINTFORMW 「아! %CALLNAME:MASTER%-씨, 관심 있으신가요?」
				ELSEIF GUEST == 2
					PRINTFORML 「혹시 오늘 두 분 데이트하시는 거예요―?」
					PRINTFORMW 「Fufu, if you don't mind, I'll take a picture of you both♪」
				ELSEIF GUEST == 1
					PRINTFORML 「에헤, 혹시 아야 씨의 인터뷰 중 하나인가?」
					IF TALENT:70:思慕
						PRINTFORML 「아야 씨! 만약 %CALLNAME:MASTER%님에 관한 거라면, 저에게 물어보세요!」
						PRINTFORMW 「%COND_STR(@"그분은 저희 후원자 중 한 분이시니까, ", CFLAG:70:1005 >= 8)%저는 %CALLNAME:MASTER%님에 대해 많이 알고 있어요!」
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%-씨, 응?」
						PRINTFORMW 「%CALLNAME:MASTER%-씨는 신비롭지 않아ー」
					ENDIF
				ENDIF
			CASE "マミゾウ"
				IF GUEST == 4
					PRINTFORML 「그나저나, %CALLNAME:MASTER%-씨는 베케단키에 대해 어떻게 생각하세요?」
					PRINTFORMW 「얘들은 친절하고, 솔직히 꽤 기분 좋은 요괴랍니다――」
					SIF ABL:69:親密 >= 5
						PRINTFORMW 「요즘 누군가와 꽤 친하게 지냈던 것 같은데... 아! 안 돼! 아무것도 아니야!」
				ELSEIF GUEST == 3
					IF TALENT:69:恋慕
						PRINTFORMW 「그럼에도 두 분은 여전히 친밀하군요.」
						PRINTFORMW (정말로 사이가 좋은 것 같아 의심하는 건 좋지 않아...)
					ELSE
						PRINTFORMW 「너희 둘은 오늘 뭘 하는 거니?」
						PRINTFORMW (둘 다 즐거워하는 것 같으니 마미조우 씨는 걱정할 필요가 없다.)
					ENDIF
				ELSEIF GUEST == 2
					PRINTFORML 「너희 둘 오늘 기분 좋아 보이네─」
					PRINTFORMW 「데이트 하는 것 같아.」
				ELSEIF GUEST == 1
					PRINTFORML 「%CALLNAME:MASTER%님, 탄키에게 조심해야 한다.」
					PRINTFORMW 「그들은 종종 자신을 인간으로 위장하고 다른 사람들에게 음모를 꾸미거나 장난을 친다.」
				ENDIF
			CASE "阿求"
				;8=独占,7=悲恋,6=揶揄,5=信頼,4=敵対,3=恋慕,2=応援,1=平穏
				SELECTCASE M_KOJO_K70_BALANCE(70, 80)
					CASE 8, 5
						IF FLAG:デート相手 == 80
							PRINTFORML 「후후, 방해할 생각은 없지만...」
							PRINTFORMW 「대신 이번에는 나랑 데이트하는 거야♪」
						ELSE
							SELECTCASE RAND:3
								CASE 1
									PRINTFORML 「%CALLNAME:MASTER%-씨에게 정보를 좀 주지.」
									PRINTFORMW 「"아큐는 유명한 전설의 밴드인 '요가단'의 대팬이야~"」
								CASE 2
									PRINTFORMW 「아큐는 평소에 딱딱하지만, 그녀의 취미에 대해 이야기하기 시작하면 즉시 부드러워진다.」
									PRINTFORML 「확실히 차이가 나는데, 그녀에게는 특유의 생기가 있다.」
									PRINTFORMW 「그녀 정말 독특한 아이야—」
								CASEELSE
									PRINTFORML 「%CALLNAME:MASTER%-씨, 당신은 아큐우를 어떻게 생각하나요?」
									PRINTFORMW 「그녀는 늘 나를 바보로 만들어요. 내가 이해하기엔 너무 어려운 말들을 하면서요ー!」
							ENDSELECT
						ENDIF
					CASE 7
						SELECTCASE RAND:2
							CASE 1
								PRINTFORML 「%CALLNAME:MASTER%, 너는 항상 아큐우랑 같이 있네ー」
								PRINTFORMW 「가끔 나랑 놀아주면 좋겠어ー 농담이야～」
							CASEELSE
								PRINTFORML 「아큐는 항상 나에게 와서 %CALLNAME:MASTER%님에 대해 다정하게 이야기한다ー」
								PRINTFORMW 「나는 아큐를 미워하고 싶지 않아... 그래서...」
						ENDSELECT
					CASE 6
						SELECTCASE RAND:3
							CASE 1
								PRINTFORML 「정보를 좀 줄게, %CALLNAME:MASTER%-상.」
								PRINTFORMW 「아큐우는 '유가쿠단'이라는 유명한 전설의 밴드의 대팬이야!」
								PRINTFORMW 「기회가 된다면 아큐우는 콘서트에 초대받으면 분명 기뻐할 거야～」
							CASE 2
								PRINTFORML 「%CALLNAME:MASTER%-씨는 아큐우에 대해 무엇을 좋아하시나요?」
								PRINTFORMW 「내가 모르는 무언가가 있는 걸까??」
							CASEELSE
								PRINTFORML 「아큐는 항상 나에게 와서 %CALLNAME:MASTER%-님에 대해 애정을 담아 이야기한다.」
								PRINTFORMW 「그녀는 마음이 강한 사람이지만, 부디 그녀를 돌봐주세요.」
						ENDSELECT
					CASE 4
						IF FLAG:デート相手 == 80
							PRINTFORML 「그건 그렇고, %CALLNAME:MASTER%-씨는 요즘 아큐우랑 되게 가까워진 것 같아.」
							PRINTFORMW 「무슨 일이라도 있었어? 둘이 이상한 거 하고 있는 건 아니지?」
						ELSEIF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
							PRINTFORML 「그건 그렇고 아큐우, 여기서 볼일 다 봤으면 어서 집에 가는 게 어떻겠어?」
							PRINTFORMW 「손님들이 오고 있으니 계속 여기 있으면 곤란할 거야.」
						ELSE
							PRINTFORML 「음, %CALLNAME:MASTER%-씨, 다른 곳에 가보시겠어요?」
							PRINTFORMW 「아-아무것도 아니에요, 그게 무슨 의미가 있겠어요! 그냥 제가 좀 긴장해서...」
						ENDIF
					CASE 3, 1
						PRINTFORML 「아큐우는 내 친구야.」
						PRINTFORMW 「우리는 오랫동안 함께 해왔어.」
					CASE 2
						SELECTCASE RAND:2
							CASE 1
								PRINTFORML 「아큐우에 대해 %CALLNAME:MASTER%-님은 어떻게 생각하세요?」
								PRINTFORMW 「그녀는 마음이 강한 사람이지만, 속으로는 착한 여자예요~」
							CASEELSE
								PRINTFORML 「아큐는 항상 나에게 와서 %CALLNAME:MASTER%-님에 대해 애정을 담아 이야기한다.」
