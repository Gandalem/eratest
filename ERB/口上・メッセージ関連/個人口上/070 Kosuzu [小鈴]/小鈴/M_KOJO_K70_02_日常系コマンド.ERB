@M_KOJO_MESSAGE_COM_K70_621_1
#DIM CHARA
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;地の文をカットしてるのでMESSAGE処理を内蔵する
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K70
	SELECTCASE TFLAG:193
		;釣れない
		CASE 0
			;todo translate
			PRINTFORMDW 아무것도 안 잡혔다…….
			IF TALENT:70:恋慕
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「느긋하게 기다리자」
					CASE 2
						PRINTFORMW 「이렇게 있는 시간도 좋아용♪」
					CASE 3
						PRINTFORMW 「낚시하는 법 같은 거 있었나아……?」
					CASE 4
						PRINTFORMW 「기다리는 것이 진정한 즐거움이야—」
					CASEELSE
						PRINTFORMW 「음~ 아무것도 안 잡히네에……」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「……책 읽어도 괜찮아요?」
					CASE 2
						PRINTFORMW 「이렇게 기다리는 게 제일 매력인 거잖아요~」
					CASEELSE
						PRINTFORMW 「음, 아무것도 미끼를 물지 않네...」
				ENDSELECT
			ENDIF
			RETURN 1
			;木片
		CASE 610
			IF TFLAG:194 > 1000
				PRINTFORMW 「Ah!」
				PRINTL 
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 나무 조각 하나를 잡았다...
				PRINTW
				PRINTFORMW 「아, 운이 없네...」
			ELSE
				PRINTFORMDL 나무를 좀 잡았네...
				PRINTW
				PRINTFORMW 「후후... 안됐네.」
			ENDIF
			RETURN 1
			;紙切れ
		CASE 131
			IF TFLAG:194 > 1000
				PRINTFORML 「Ah!」
			ELSE
				PRINTFORMDL 너 종이 몇 장 잡았네...
			ENDIF
			PRINTDW 
			PRINTDL ┌─────────────┐
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 부적
			PRINTDL 복권
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 부적 5개를 모아라
			PRINTDL 복권 한 개를 얻어라
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 기적은 보장되지 않는다.
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 신사
			PRINTDL └─────────────┘
			PRINTW 
			PRINTFORMW 「음... 이건...」
			RETURN 1
		CASE 1 TO 20, 22 TO 60
			LOCALS = %FISH_NAME(TFLAG:193)%
		CASE 21
			LOCALS = rotor
		CASEELSE
			LOCALS = %ITEMNAME_TR(TFLAG:193)%
	ENDSELECT
	;小鈴が釣った
	IF TFLAG:194 > 1000
		PRINTFORMW 「Ah!」
		PRINTL 
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) %FISH_NAME_TR(TFLAG:193)%를 잡았다!
		RESETCOLOR
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORML %FISH_NAME_TR(TFLAG:193)%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORML %FISH_NAME_TR(TFLAG:193)%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K70
		SELECTCASE LOCALS
			CASE "ローター"
				PRINTFORML 「어, 저기...이게...\/\/\/」
				PRINTFORMW 「다르잖아! 다른 걸 잡았어!」
			CASE "カエル"
				PRINTFORMW 「에잇~! 역겨워...」
				;お宝
			CASE "氷の鱗", "龍の爪"
				PRINTFORMW 「와~! 예쁘다~! 이게 뭐야?」
			CASE "龍涎香" ;todo translate (there's a section below with mostly same text)
				PRINTFORMW 「어라? 이 돌 혹시 레어 아이템이었던 것 같은데……」
			CASE "ガーパイク", "カムルチー", "チョウザメ", "イトウ", "ピラルクー", "タキタロウ"
				PRINTFORMW 「우와, 무거워~! %CALLNAME:MASTER%씨 도와주세요~」
			CASE "ピラニア"
				PRINTFORMW 「꺅!! 왜 이런 게 나오는 거야!」
			CASE "シーラカンス"
				PRINTFORMW 「이건 환상의 고대어! 라고, 환상향에서는 "환상" 같은 건 보통이었네요...」
			CASE "ウナギ", "ヤツメウナギ", "ナマズ"
				PRINTFORMW 「꺄앗! 미끌미끌해서 기분 나빠요……」
			CASEELSE
				PRINTFORMW 「이야! 이거 뭐야?!」
		ENDSELECT
		;MASTERが釣った
	ELSE
		RESETCOLOR
		PRINTFORMDL 당신은 %FISH_NAME_TR(TFLAG:193)%을 잡았다!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORML 　사이즈: {LOCAL:1}cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORML 　지금까지 잡은 가장 큰 %FISH_NAME_TR(TFLAG:193)%이다!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORML %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORML %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K70
		SELECTCASE LOCALS
			CASE "ローター"
				PRINTFORMW 「어, 이, 이건…\/\/\/」
			CASE "カエル"
				PRINTFORMW 「에잇~! 역겨워...」
			CASE "氷の鱗", "龍の爪"
				PRINTFORMW 「와~! 예쁘다~! 이게 뭐야?」
			CASE "龍涎香" ;todo translate
				PRINTFORMW 「어라? 이 돌 혹시 레어 아이템이었던 것 같은데……」
			CASE "ピラニア"
				PRINTFORMW 「꺅!! 그거 피라니아예요~」
			CASE "シーラカンス"
				PRINTFORMW 「"그것은 환상의 고대어! 라고, 환상향에서는 '환상' 같은 건 평범한 거였네요..."」
			CASE "ウナギ", "ヤツメウナギ", "ナマズ"
				PRINTFORMW 「우…… 미끌미끌해서 기분 나빠요……」
			CASEELSE
				IF LOCAL:1 >= 80
					PRINTFORMW 「햐~!! 크네요~!」
				ELSEIF INRANGE(TFLAG:193, 11, 20) || INRANGE(TFLAG:193, 24, 60)
					PRINTFORMW 「와아~! 희귀 물고기네요~!」
				ELSEIF TALENT:70:恋慕 || TALENT:70:思慕
					PRINTFORMW 「와아~! 역시 대단하세요~」
				ELSE
					PRINTFORMW 「오오~! 해냈어~!」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
