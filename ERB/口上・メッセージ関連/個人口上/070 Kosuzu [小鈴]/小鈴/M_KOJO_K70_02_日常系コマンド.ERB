@M_KOJO_MESSAGE_COM_K70_304_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K70
	PRINTL 
	IF CFLAG:70:職種 == 41
		;■店番
		;　　時間：毎週水・木、朝9時～夕17時まで
		;　　場所：鈴奈庵（商家町）
		;　仕事量：4800(8時間分)
		;　　職種：41（会話）
		;　手伝い：手伝っても早く終わらない
		;報酬倍率：x2
		;その日最初の手伝いは序文が入る,ただし住んでると省略
		SIF !GETBIT(TCVAR:70:360, 1) || CFLAG:MASTER:初期位置 == CFLAG:70:初期位置
			PRINTFORML 「오, 나를 도와줄 거야? \@ TALENT:70:恋慕 ? 그렇다면 부탁해~♪ # 고마워. \@」
		SELECTCASE RAND:9
			CASE 1
				PRINTFORMW 「이 책을 선반에 다시 놓아 줄 수 있나요?」
			CASE 2
				PRINTFORMW 「그럼 대여 상태를 확인해 주세요.」
			CASE 3
				PRINTFORMW 「그럼 청소 좀 도와줘.」
				SIF ABL:MASTER:清掃技能 >= 4
					PRINTFORMW (하아, 마음을 바꿨어...!)
				EXP:MASTER:清掃経験 ++
			CASE 4
				PRINTFORMW 「아, 맞다. 손님 좀 불러올 수 있겠어?」
			CASE 5
				IF TALENT:70:恋慕
					PRINTFORML 「악마 책들을 정리해 줄 수 있나요?」
					PRINTFORMW 「걱정 마세요~ 난 난 폭주하지 않을 거예요♪」
				ELSE
					PRINTFORML 「\@ !GETBIT(TCVAR:70:360, 1) ? 비록 ~하지만 # 아무것도 할 수 없다 \@ 지금은.」
					PRINTFORMW 「기다리는 동안 책이나 읽자.」
				ENDIF
				;残りはのんびり
			CASEELSE
				PRINTFORML 「\@ !GETBIT(TCVAR:70:360, 1) ? 비록 ~하지만 # 아무것도 할 수 없다 \@ 지금은.」
				PRINTFORMW 「기다리는 동안 책이나 읽자.」
		ENDSELECT
	ELSEIF CFLAG:70:職種 == 40
		;■蔵書の整理
		;　　時間：毎週月・火・金、夕18時～夜20時まで
		;　　場所：鈴奈庵（商家町）
		;　仕事量：1200(2時間分)
		;　　職種：40（掃除）
		;　手伝い：可
		;報酬倍率：x3
		;その日最初の手伝いは序文が入る,ただし住んでると省略
		SIF !GETBIT(TCVAR:70:360, 1) || CFLAG:MASTER:初期位置 == CFLAG:70:初期位置
			PRINTFORML 「오, 나를 도와줄 거야? \@ TALENT:70:恋慕 ? 그렇다면 부탁해~♪ # 고마워. \@」
		SELECTCASE RAND:8
			CASE 1
				PRINTFORMW 「이해하지 못하는 것이 있다면 말해 주세요.」
			CASE 2
				PRINTFORMW 「아, 이 책을 놓쳤네!」
			CASE 3
				PRINTFORMW 「어라, 이 책을 읽은 적이 있나...」
			CASE 4
				IF TALENT:70:恋慕
					PRINTFORMW 「조심해서 다뤄줘.」
				ELSE
					PRINTFORMW 「거칠게 다루지 마세요!」
				ENDIF
			CASEELSE
				PRINTFORMW 「괜찮아, 괜찮아.」
		ENDSELECT
	ENDIF
	;一日一回
	SETBIT TCVAR:70:360, 1
ENDIF
RETURN 1
