@M_KOJO_MESSAGE_COM_K70_303
CALL M_KOJO_MESSAGE_COM_K70_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K70_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:SELECTCOMの分岐 == -2 || TFLAG:SELECTCOMの分岐 == 2
		PRINTFORMDL 당신은 용서받기 위해 %조사처리(CALLNAME:TARGET,"에게")% 케이크 상자를 준다.
	ELSE
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 무례했던 것에 대해 사과한다.
	ENDIF
	PRINTW 
	;フキゲンが最大(3)だと謝っても許してくれない、謝りキャンセルが発動
	IF TFLAG:192 == -2
		PRINTFORMW 「...」
		PRINTL 
		PRINTFORMDW 다른 날 다시 시도해보는 게 더 나을지도 모르겠네...
		CFLAG:70:ブチギレ = 1
		TALENT:70:機嫌 = -1
		BASE:70:怒り = MAXBASE:70:怒り
		RETURN 1
	ELSEIF TFLAG:SELECTCOMの分岐 == 1
		PRINTFORML 「후후, %CALLNAME:MASTER%-씨도 그런 태도를 가지고 있군요.」
		PRINTFORMW 「괜찮아, 어차피 별일 아니니까.」
	ELSEIF TFLAG:SELECTCOMの分岐 == 2
		PRINTFORML 「후우... 뭐, 아직 너에게 약간의 믿음은 남아있어.」
		PRINTFORMW 「좋아, 이번 한 번만...」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% Lv 1 증오 표식이 제거되었다!
	ELSEIF TFLAG:SELECTCOMの分岐 == 0
		PRINTFORML 「하아... 이해했다.」
		PRINTFORMW 「어쩔 수 없지... 이번 한 번만은.」
	ELSEIF TFLAG:SELECTCOMの分岐 == -2
		PRINTFORML 「후우, 그게 네 사과 시도인가?」
		PRINTFORMW 「그런 사람이었구나, %CALLNAME:MASTER%-씨. 내가 너를 오해했어.」
		;今日はもう謝れない
		TCVAR:70:350 = 3
		TALENT:70:機嫌 = -1
	ELSE
		PRINTFORML 「사과할 작정이야?」
		PRINTFORMW 「Please think more about what you did and learn from it.」
	ENDIF
	;通常は成功しても機嫌は戻らないがフキゲンを消すので一緒に戻ってもらう
	IF GROUPMATCH(TFLAG:SELECTCOMの分岐, 1, 2, 0)
		TALENT:70:機嫌 = 0
		TCVAR:70:350 = 0
		TCVAR:70:353 = 0
	ENDIF
ENDIF
RETURN 1
