;一人目口上

@M_KOJO_MESSAGE_SCOM_K70_9_1
#DIM CHARA
CHARA = MASTER_POSE(4,1,1)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
IF LOCAL
	IF CHARA == 80
		SELECTCASE M_KOJO_K70_BALANCE(70, 80)
			CASE 8, 5
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「아큐우, %CALLNAME:MASTER%님과 함께 봉사하자%UNICODE(0x2764)%」
					CASEELSE
						PRINTFORMW 「후후%UNICODE(0x2764)% 아큐는 절반을 가질 수 있다%UNICODE(0x2764)%」
				ENDSELECT
			CASE 7, 6
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「나-이게 한 판이야, 아큐우! 누가 %CALLNAME:MASTER%-님을 가장 기분 좋게 해줄 수 있을까...!」
					CASEELSE
						PRINTFORMW 「음... 아큐, 너무 불공평해...! 나도...!」
				ENDSELECT
			CASE 4, 3
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「아큐보다 더 기분 좋게 해 줄게!」
					CASEELSE
						PRINTFORMW 「나는 아큐에게 그걸 넘겨주지 않을 것이다...! 암흐%UNICODE(0x2764)%」
				ENDSELECT
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「음... %CALLNAME:CHARA% 씨, 너무 불공평해...! 나도 그래...!」
			CASEELSE
				PRINTFORMW 「응! %CALLNAME:CHARA%씨, 나에게 줘...!」
		ENDSELECT
	ENDIF
	;サディスティックになる
	IF NOWEX:MASTER:射精
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「음... 구우... 커밍스? 괜찮아, 많이 내놔 %UNICODE(0x2764)%」
				PRINTFORMW 「응 %UNICODE(0x2764)% 꾸우 %UNICODE(0x2764)% 응 %UNICODE(0x2764)% 음 %UNICODE(0x2764)% 응 %UNICODE(0x2764)% 음 %UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%-상, 너무 부풀었어...%UNICODE(0x2764)% 내가 빨아낼게%UNICODE(0x2764)%」
				PRINTFORMW 「츄%UNICODE(0x2764)% 츕우%UNICODE(0x2764)% 응우%UNICODE(0x2764)% 구푸%UNICODE(0x2764)% 에로 에로...%UNICODE(0x2764)% 구푸%UNICODE(0x2764)% 구추%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「츄우우%UNICODE(0x2764)% 응응%UNICODE(0x2764)% 음%UNICODE(0x2764)% 커밍스? 하아...%UNICODE(0x2764)% 좋아...%UNICODE(0x2764)%」
				PRINTFORMW 「부디 당신의 %ONEDARI_MASTER_TINKO()% 우유를 많이 싸줘%UNICODE(0x2764)% 퓌우%UNICODE(0x2764)% 구푸우%UNICODE(0x2764)% 구포오%UNICODE(0x2764)%」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「츄%UNICODE(0x2764)% 페로...%UNICODE(0x2764)% 암흐%UNICODE(0x2764)% 레로%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「흐음...후우 후후 하아 푸우」
			CASEELSE
				PRINTFORMW 「어때~? 기분 좋아~? 푸푸%UNICODE(0x2764)% 쿠쿠%UNICODE(0x2764)% 구구%UNICODE(0x2764)%」
		ENDSELECT
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K70_{SELECTCOM}_1
RETURN 1
