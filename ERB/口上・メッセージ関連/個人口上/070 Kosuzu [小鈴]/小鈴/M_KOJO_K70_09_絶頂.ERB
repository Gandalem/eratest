; Modular ERB: 個人口上/070 Kosuzu [小鈴]/小鈴/M_KOJO_K70_09_絶頂.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K70
SIF FLAG:時間停止
	RETURN 1
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 「아, 아앗～～\/\/\/ 내 가슴이…… 나 사정하고 있어～\/\/\/」
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 「후에에～\/\/\/ 나 오줌 싸고 있어～\/\/\/ 미안해애～～\/\/\/」
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
;すいません、手抜きです。ご主人様……じゃなかった、阿求（？）許して……。Ｍ絶頂で無いのは仕様です。
IF LOCAL
	IF NOWEX:五重絶頂 || NOWEX:四重絶頂 || NOWEX:三重絶頂 || NOWEX:二重絶頂 || NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ａ絶頂
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「아악! 사정%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「하아! 사정해버렸어%UNICODE(0x2764)%」
			CASE 3
				PRINTFORMW 「아%UNICODE(0x2764)% 아으%UNICODE(0x2764)% 사정하고 있어...%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 4
				PRINTFORMW 「음~!! 사정%UNICODE(0x2764)% 사정%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「크으 %UNICODE(0x2764)% 크음 %UNICODE(0x2764)% 나 사정 중이야 %UNICODE(0x2764)%」
		ENDSELECT
		SIF !CFLAG:70:1006
			RETURN 1
		;		PRINTL
		;満足フラグ
		IF M_KOJO_K70_MANZOKU(70)
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「하아... 하아... %UNICODE(0x2764)% 최고야... %UNICODE(0x2764)%」
				CASE 2
					PRINTFORMW 「하아... 하아... %UNICODE(0x2764)% 나, 녹아버릴 것 같아... %UNICODE(0x2764)%」
				CASEELSE
					PRINTFORMW 「하아... 하아... %UNICODE(0x2764)% 정말 행복해... %UNICODE(0x2764)%」
			ENDSELECT
			TCVAR:70:355 = 1
			TALENT:70:機嫌 = 1
		ELSEIF BASE:70:気力 <= 0
			PRINTFORMW 「하아... 하아... 하아... %UNICODE(0x2764)% 안 되겠어%UNICODE(0x2764)% 나, 나 기절할 것 같아...%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「하아... 하아...%UNICODE(0x2764)%」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;満足フラグ判定関数
;-------------------------------------------------

@M_KOJO_K70_MANZOKU(ARG)
#FUNCTION
SIF BASE:ARG:体力 <= MAXBASE:ARG:体力 / 2
	RETURNF 0
LOCAL = EX:ARG:Ｃ絶頂 + EX:ARG:Ｖ絶頂 + EX:ARG:Ａ絶頂 + EX:ARG:Ｂ絶頂 + EX:ARG:Ｍ絶頂
IF CFLAG:ARG:溜まってる度 < 100 && LOCAL >= 20
	RETURNF 1
ELSEIF CFLAG:ARG:溜まってる度 < 200 && LOCAL >= 30
	RETURNF 1
ELSEIF CFLAG:ARG:溜まってる度 < 500 && LOCAL >= 60
	RETURNF 1
ELSEIF CFLAG:ARG:溜まってる度 < 800 && LOCAL >= 80
	RETURNF 1
ENDIF
