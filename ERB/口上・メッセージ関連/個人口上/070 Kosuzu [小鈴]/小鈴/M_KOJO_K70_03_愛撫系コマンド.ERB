@M_KOJO_MESSAGE_COM_K70_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF FLAG:時間停止
	ELSEIF FIRSTTIME("ファーストキス")
		PRINTFORMW 「Ah...!!」
		PRINTFORMW 「후우...이것은 내가 해본 첫 키스야...」
		PRINTFORMW 「순서가 뒤바뀌었어...」
		IF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
			CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, %CALLNAME:MASTER% took her first kiss in Suzunaan in the middle of having an affair with her, even though it was an immoral thing to do.
		ELSEIF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 2
			CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, %CALLNAME:MASTER% took her first kiss in her room in the middle of having an affair with her.
		ELSEIF FLAG:デート相手 == 70
			CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, %DATENAME_SPOT()%, %CALLNAME:MASTER% took her first kiss in the middle of having an affair with her.
		ELSE
			CSTR:70:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, %NAME_FROM_PLACE(CFLAG:70:現在位置)%, %CALLNAME:MASTER% took her first kiss in the middle of having an affair with her.
		ENDIF
		;月並みですが憧れの台詞だったりします,ゲーム中はやらないけど
		;V挿入中,＞素股
	ELSEIF TEQUIP:70:Ｖセックス == PLAYER || PREVCOM == 83
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「%CALLNAME:MASTER%-상... 키스해 줘...%UNICODE(0x2764)% 취우%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%-상... 키스하자...%UNICODE(0x2764)% 추우%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「%CALLNAME:MASTER%-상... 키스...%UNICODE(0x2764)% 쪽으로...%UNICODE(0x2764)%」
		ENDSELECT
		IF NOWEX:MASTER:射精
			;			CALL M_KOJO_K70_NAKADASHI
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 「하아%UNICODE(0x2764)% C-정액 지금...%UNICODE(0x2764)%」
					PRINTFORMW 「키스하는 동안 내보내 줘, 부탁해...%UNICODE(0x2764)%」
					PRINTFORMW 「응%UNICODE(0x2764)% 추우%UNICODE(0x2764)% 음%UNICODE(0x2764)% 으음...%UNICODE(0x2764)%%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORMW 「하아%UNICODE(0x2764)% 키스하는 동안 내뱉어 봐...%UNICODE(0x2764)%」
					PRINTFORMW 「응%UNICODE(0x2764)% 추우%UNICODE(0x2764)% 추워...%UNICODE(0x2764)% 음음%UNICODE(0x2764)%%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「Nn...%UNICODE(0x2764)%」
				PRINTFORMW 「머리가……녹아내려……\/\/\/」
			CASE 2
				PRINTFORMW 「츄츄♡」
				PRINTFORMW 「에헤...♡츄츄♡」
			CASE 3
				PRINTFORMW 「음... 리로...」
				PRINTFORMW 「하아... 리로... 음... 더...」
			CASE 4
				PRINTFORMW 「쪽츄%UNICODE(0x2764)% 추우...%UNICODE(0x2764)%」
				PRINTFORMW 「%CALLNAME:MASTER%-상의 키스... 정말 달콤해...%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「츄%UNICODE(0x2764)% 추추우%UNICODE(0x2764)% 쿠푸%UNICODE(0x2764)%」
				PRINTFORMW 「기분이 좋다...%UNICODE(0x2764)% 하아%UNICODE(0x2764)% 음무%UNICODE(0x2764)%」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
