@M_KOJO_MESSAGE_COM_K70_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME("クンニ") && !FLAG:時間停止
		PRINTFORMW 「엣...! 안 돼... 더러워...\/\/\/」
		PRINTFORMW 「아앗!!! 아...! ㄴㄴ%UNICODE(0x2764)% 아...%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		;継続クンニ
	ELSEIF PREVCOM == SELECTCOM
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「하와아%UNICODE(0x2764)% 아%UNICODE(0x2764)% 아아%UNICODE(0x2764)%」
				PRINTFORMW 「더%UNICODE(0x2764)% 핥아줘 더%UNICODE(0x2764)% 나아～%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「하아%UNICODE(0x2764)% 와...%UNICODE(0x2764)% 응%UNICODE(0x2764)%」
				PRINTFORMW 「얼마나 더 그걸 핥을 작정이야?%UNICODE(0x2764)% 에이～%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「아아...%UNICODE(0x2764)% 모...%UNICODE(0x2764)% 좋았어%UNICODE(0x2764)%」
				PRINTFORMW 「아직도 가는 거야?%UNICODE(0x2764)% 응%UNICODE(0x2764)% 아아%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
		;カウンター文
	ELSEIF M_KOJO_K70_SADISTIC(70)
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「%CALLNAME:MASTER%-씨... 핥아주세요...\/\/\/」
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%-상... 나의 음란한 곳... 핥아주세요...\/\/\/」
			CASEELSE
				PRINTFORMW 「%CALLNAME:MASTER%-씨... 핥아봐...%UNICODE(0x2764)%」
		ENDSELECT
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응(Nn)%UNICODE(0x2764)% 아(Ah)%UNICODE(0x2764)% 아아(Ahh)%UNICODE(0x2764)%」
				PRINTFORMW 「좋다(It's good)%UNICODE(0x2764)% 더(More)%UNICODE(0x2764)% 아아(Ahh)%UNICODE(0x2764)%」
			CASE 2
				PRINTFORML 「아, 더 세게%UNICODE(0x2764)% 더 강하게%UNICODE(0x2764)%」
				PRINTFORMW 「흥%UNICODE(0x2764)% 삼켜라%UNICODE(0x2764)% 즐겨라%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORML 「%CALLNAME:MASTER%-san%UNICODE(0x2764)% 맛있어?」
				PRINTFORMW 「더 핥아봐%UNICODE(0x2764)% 빨아봐%UNICODE(0x2764)% 그거 좋다%UNICODE(0x2764)%」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「네, 네……\/\/\/ 여기……%UNICODE(0x2764)%」
				PRINTFORMW 「Ah...%UNICODE(0x2764)% Nn%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「너 그거 핥을 거니...? 좋아...\/\/\/」
				PRINTFORMW 「응... %UNICODE(0x2764)% 쿠... %UNICODE(0x2764)% 저-저 부끄러워...\/\/\/」
			CASEELSE
				PRINTFORMW 「저기-괜찮을까...? 그럼, 부탁이야...\/\/\/」
				PRINTFORMW 「쿠우...%UNICODE(0x2764)% 아%UNICODE(0x2764)% 퍼뜨려줘...%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
