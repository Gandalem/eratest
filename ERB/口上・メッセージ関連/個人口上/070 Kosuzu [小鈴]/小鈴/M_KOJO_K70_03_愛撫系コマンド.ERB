@M_KOJO_MESSAGE_COM_K70_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;勝手な解釈ですけど、挿入時や素股時の愛撫は包容だと思ってます
	;V挿入
	IF LOCAL:1 && TEQUIP:70:Ｖセックス == PLAYER && !FLAG:時間停止
		IF NOWEX:MASTER:射精
			CALL M_KOJO_K70_NAKADASHI
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「음... 아아... 안돼...」
					PRINTFORMW 「정말 좋아... 더 해줘... 응...」
				CASE 2
					PRINTFORMW 「하아%UNICODE(0x2764)% 응%UNICODE(0x2764)% %CALLNAME:MASTER%-상...! 나를 안아줘%UNICODE(0x2764)%」
					PRINTFORMW 「%CALLNAME:MASTER%-상%UNICODE(0x2764)% 연모%UNICODE(0x2764)% 음%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORMW 「음... 갑자기~」
					PRINTFORMW 「아, 아... 정말 좋다」
			ENDSELECT
		ENDIF
		RETURN 1
		;A挿入
		;	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;		;射精した
		;		IF NOWEX:PLAYER:11
		;			PRINTFORMW
		;			RETURN 1
		;		ELSE
		;			PRINTFORMW
		;			RETURN 1
		;		ENDIF
	ENDIF
	;-------------------------------------------------
	;共通
	;-------------------------------------------------
	IF FLAG:時間停止
		;＞素股
	ELSEIF PREVCOM == 83
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「Nn%UNICODE(0x2764)% %CALLNAME:MASTER%-씨%UNICODE(0x2764)%」
				PRINTFORMW 「너무 따뜻해...%UNICODE(0x2764)% 조금만 더...%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「하아...%UNICODE(0x2764)% 음...%UNICODE(0x2764)% %CALLNAME:MASTER%-상, 나를 안아줘...%UNICODE(0x2764)%」
				PRINTFORMW 「아아... 나는 연모해... %CALLNAME:MASTER%-상...%UNICODE(0x2764)% 정말 다정해...%UNICODE(0x2764)%」
		ENDSELECT
	ELSE
		SELECTCASE RAND:6
			CASE 1
				PRINTFORMW 「하아...!」
				PRINTFORMW 「%CALLNAME:MASTER%님... 당신은 음란해요...」
			CASE 2
				PRINTFORMW 「아으...%UNICODE(0x2764)%」
				PRINTFORMW 「나의...%UNICODE(0x2764)% 나의 목소리%UNICODE(0x2764)% 아앗%UNICODE(0x2764)% 나오고 있어...%UNICODE(0x2764)%」
			CASE 3
				PRINTFORMW 「아...! 음%UNICODE(0x2764)% 아아...%UNICODE(0x2764)%」
				PRINTFORMW 「%CALLNAME:MASTER%-씨... 더...%UNICODE(0x2764)%」
			CASE 4
				PRINTFORMW 「하아...좋다...」
			CASE 5
				PRINTFORMW 「안(Ahn)%UNICODE(0x2764)% 안 돼...! 아(Nha)%UNICODE(0x2764)%」
				PRINTFORMW 「하아...! 아...%UNICODE(0x2764)% 아%UNICODE(0x2764)% 아으으(Ahh)%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「흐음후우 아아」
				PRINTFORMW 「스윽 거칠어 흐응 아아」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
