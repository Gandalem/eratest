; Modular ERB: 個人口上/070 Kosuzu [小鈴]/小鈴/M_KOJO_K70_弾幕勝負.ERB
;戦闘能力を上げれば戦えるはず！
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K70_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;todo translate this entire file
		IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
			PRINTFORMW 「헤에~?? 탄막 놀이인가아~?」
		ELSEIF TALENT:70:機嫌 == -1 || CFLAG:70:ブチギレ || MARK:70:反発刻印 >= 3
			PRINTFORMW 「으윽…… 그런 기분이 아닌데요……」
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「특훈의 성과를 보여주겠어!」
				CASE 2
					PRINTFORMW 「나도 싸울 수 있다고요!」
				CASEELSE
					PRINTFORMW 「부디 잘 부탁드려요!」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
				PRINTFORML 「앗……」
			ELSEIF TALENT:70:機嫌 == -1 || CFLAG:70:ブチギレ || MARK:70:反発刻印 >= 3
				PRINTFORML 「아아……」
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「히아아~……」
					CASE 2
						PRINTFORML 「이제 안 돼~……」
					CASEELSE
						PRINTFORML 「죽었어……」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「헤에~!?」
					CASE 2
						PRINTFORML 「헤에~!?」
					CASEELSE
						PRINTFORML 「우응……」
				ENDSELECT
			ELSEIF TALENT:70:機嫌 == -1 || CFLAG:70:ブチギレ || MARK:70:反発刻印 >= 3
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「아우윽……」
					CASE 2
						PRINTFORML 「우으……」
					CASEELSE
						PRINTFORML 「음……」
				ENDSELECT
			ELSE
				SELECTCASE RAND:9
					CASE 1
						PRINTFORML 「히얏!」
					CASE 2
						PRINTFORML 「앗!!」
					CASE 3
						PRINTFORML 「앗!」
					CASE 4
						PRINTFORML 「우와아앗!」
					CASE 5
						PRINTFORML 「꺄앗!」
					CASE 6
						PRINTFORML 「꺄악!」
					CASE 7
						PRINTFORML 「큭!」
					CASE 8
						PRINTFORML 「히익!」
					CASEELSE
						PRINTFORML 「에엣!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
				PRINTFORMW 「에헤~? 무슨 일이 일어난 거예요~?」
			ELSEIF TALENT:70:機嫌 == -1 || CFLAG:70:ブチギレ || MARK:70:反発刻印 >= 3
				PRINTFORMW 「이제…… 재미없어~」
			ELSE
				IF TALENT:70:恋慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 역시 강하시네요~!」
						CASE 2
							PRINTFORMW 「탄막 놀이 하는 거 재미있네요♪」
						CASEELSE
							PRINTFORMW 「제, 제발 단련시켜 주세요!!」
					ENDSELECT
				ELSEIF TALENT:70:思慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「강하시네요……」
						CASE 2
							PRINTFORMW 「나에겐 아직 빠를지도 모르겠어……」
						CASEELSE
							PRINTFORMW 「우으윽! 분해요...!」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「자, 대단해요……」
						CASE 2
							PRINTFORMW 「졌어요……」
						CASEELSE
							PRINTFORMW 「아직인가……」
					ENDSELECT
				ENDIF
			ENDIF
			;小鈴勝利,普通にやっててありえるのか？？
		ELSE
			IF ALCOHOL_FACE(70) == "酔いどれ" || ALCOHOL_FACE(70) == "ぐでぐで"
				PRINTFORML 「에헤~? %CALLNAME:MASTER%씨, 왜 그러시는 거예요~?」
			ELSEIF TALENT:70:機嫌 == -1 || CFLAG:70:ブチギレ || MARK:70:反発刻印 >= 3
				PRINTFORML 「해냈다! 기분 상쾌해!!」
			ELSE
				IF TALENT:70:恋慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%CALLNAME:MASTER%씨, 아직 멀었네요~♪」
						CASE 2
							PRINTFORMW 「해냈다! %조사처리(CALLNAME:MASTER,"에게")% 이겨버렸어~」
						CASEELSE
							PRINTFORMW 「나 혹시 재능 있을지도 몰라~♪」
					ENDSELECT
				ELSEIF TALENT:70:思慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「어라!? 나 혹시 이긴 거야!?」
						CASE 2
							PRINTFORMW 「말, 말도 안 돼... 이길 리가 없어...!」
						CASEELSE
							PRINTFORMW 「저, 봐주신 거죠...!」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「해냈다! 이겼다앗!」
						CASE 2
							PRINTFORMW 「%CALLNAME:MASTER%씨, 의외로 약한…?」
						CASEELSE
							PRINTFORMW 「좋은 승부였어요♪」
					ENDSELECT
				ENDIF
				TALENT:70:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
