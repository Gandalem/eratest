;SOURCEやNOWEXを使ってSELECTCOMに依存しない口上があってもいいんじゃない

@M_KOJO_MESSAGE_COM_K70_00
;性交処女喪失をRETURN 100して
;IF RESULT == 100 でまとめるとか
;苦痛や快楽のSOURCEをトリガーとして汎用あえぎ口上を作るとか
;いろいろ利用方法は考えられますが適当にやってください
;-------------------------------------------
;調教後のテキスト
;TFLAG:8 (1=TARGETがお掃除 2=ASSIがお掃除 3=TARGETとASSIがお掃除)
;-------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_C_K70
SIF FLAG:時間停止
	RETURN 1
SIF !CFLAG:70:1006
	RETURN 1
;処女喪失
IF TCVAR:破瓜
	;正真正銘処女喪失
	IF TCVAR:破瓜 == 1
		PRINTL 
		PRINTFORMW 「하아... 정말 행복해...%UNICODE(0x2764)%」
		PRINTFORMW 「이제 성인 여자가 되었어...♪」
		;日記を書く
		CALL M_KOJO_DIARYSETTING_K70(47)
		;再生処女喪失
	ELSEIF TCVAR:破瓜 == 2
		;無自覚非処女喪失
	ELSEIF TCVAR:破瓜 == -1
	ENDIF
ENDIF
;Ａ処女喪失
IF TCVAR:Ａ破瓜
	;正真正銘Ａ処女喪失
	IF TCVAR:Ａ破瓜 == 1
		PRINTL 
		PRINTFORMW 「으윽... 고통스러워요... %CALLNAME:MASTER%님, 잔인하시네요...」
		;無自覚Ａ処女喪失
	ELSEIF TCVAR:Ａ破瓜 == -1
	ENDIF
ENDIF
;フェラで射精後のお掃除
IF (TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2) && SELECTCOM == 81
	PRINTL 
	PRINTFORMW 「아하%UNICODE(0x2764)% 많은 게 나오고 있네...」
	PRINTFORMW 「괜찮아, 내가 치울게...%UNICODE(0x2764)%」
ENDIF
RETURN 1
