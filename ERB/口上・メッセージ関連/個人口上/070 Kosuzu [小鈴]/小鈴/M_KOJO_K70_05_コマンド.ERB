@M_KOJO_MESSAGE_COM_K70_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
IF LOCAL
	;サドっ気があるときのみ、カウンター文を表示
	IF M_KOJO_K70_SADISTIC(70)
		PRINTFORMW 「%CALLNAME:MASTER%-상의 곳이야... 만져볼게...%UNICODE(0x2764)%」
		PRINTFORML 「더럽지 않아...%UNICODE(0x2764)% 왜냐하면 그것은 %CALLNAME:MASTER%-상의 몸이니까...%UNICODE(0x2764)%」
		PRINTFORMW 「기분이 좋아졌으면 좋겠어...%UNICODE(0x2764)%」
	ENDIF
ENDIF
RETURN 1
