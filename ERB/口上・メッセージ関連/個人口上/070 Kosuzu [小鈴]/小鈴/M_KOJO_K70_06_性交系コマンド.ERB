	WAIT
	;後背位（立ち位）,;背面座位
ELSEIF POSE_BEHIND(TEQUIP:70:体位) ;custom code
	SELECTCASE RAND:3
		CASE 1
			PRINTFORML 「하아%UNICODE(0x2764)% 아우%UNICODE(0x2764)% 아%UNICODE(0x2764)% 더 깊이%UNICODE(0x2764)%」
			PRINTFORMW 「더 깊게%UNICODE(0x2764)% 더 많이%UNICODE(0x2764)% 사정해 주세요~~%UNICODE(0x2764)%%UNICODE(0x2764)%」
		CASE 2
			PRINTFORML 「음%UNICODE(0x2764)% 음%UNICODE(0x2764)% 아%UNICODE(0x2764)% 제발%UNICODE(0x2764)% %CALLNAME:MASTER%-상의 정액%UNICODE(0x2764)%」
			PRINTFORMW 「내 안에%UNICODE(0x2764)% 많이 넣어줘%UNICODE(0x2764)% 나를 임신시켜 줘~~%UNICODE(0x2764)%%UNICODE(0x2764)%」
		CASEELSE
			PRINTFORML 「아%UNICODE(0x2764)% 오오%UNICODE(0x2764)% 더 깊이%UNICODE(0x2764)% 하-더 세게%UNICODE(0x2764)%」
			PRINTFORMW 「제발 나 안에 아기를 넣어줘~~~%UNICODE(0x2764)%%UNICODE(0x2764)%」
