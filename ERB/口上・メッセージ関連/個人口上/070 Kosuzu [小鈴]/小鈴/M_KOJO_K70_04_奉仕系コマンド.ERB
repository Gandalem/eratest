@M_KOJO_MESSAGE_COM_K70_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = CFLAG:70:1006
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「내 손으로 해줘...」
		PRINTFORMW 「이, 이렇게...?」
		PRINTFORMW 「어때...? 잘하고 있는 걸까?」
		RETURN 1
	ENDIF
	;一文目をPRINTFORMLにするか迷う……
	IF FLAG:時間停止
	ELSEIF NOWEX:MASTER:射精
		;サディスティック
		IF M_KOJO_K70_SADISTIC(70)
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「수음을 원해? 내 손으로 절정에 오고 싶어? 만약 절정에 오고 싶다면 그냥 와, 알겠지%UNICODE(0x2764)%」
					PRINTFORMW 「여기%UNICODE(0x2764)% 문질러봐%UNICODE(0x2764)% 많이 싸버려, 좋아%UNICODE(0x2764)% 뿌욱%UNICODE(0x2764)% 뿌욱%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORMW 「후후후... %UNICODE(0x2764)% 기분 좋아? 너무 귀여워, %CALLNAME:MASTER%-상%UNICODE(0x2764)%」
					PRINTFORMW 「오, 사정하고 싶어? 괜찮아%UNICODE(0x2764)% 풀어내도 돼%UNICODE(0x2764)% 푸우%UNICODE(0x2764)% 푸우%UNICODE(0x2764)%」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「하아아... \/\/\/ 더는 못 참겠어요, 응? \/\/\/ 제가 진정시켜 드릴게요...!」
					PRINTFORMW 「응... 거기...! 괜찮아... 참지 마... %UNICODE(0x2764)%」
				CASEELSE
					PRINTFORMW 「아하아...\/\/\/ 사정하는 건가...? \/\/\/ 제가 손으로 해드릴게요...!」
					PRINTFORMW 「후후 %UNICODE(0x2764)% 빨리 할까 꽉 감을까 머리는 괜찮아 막대는 어때」
			ENDSELECT
		ENDIF
	ELSE
		;サディスティック
		IF M_KOJO_K70_SADISTIC(70)
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「후후후... %UNICODE(0x2764)% 수음을 원해?」
					PRINTFORMW 「많이 문질러 줄게%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORMW 「내 손으로 해달라고? 그럼, 잔뜩 놀아줄게♪」
					PRINTFORMW 「아하♪ %CALLNAME:MASTER%-씨의 페니스는 정말 귀여워%UNICODE(0x2764)%」
			ENDSELECT
		ELSE
