@M_KOJO_EVENT_K70_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		CASE 0
			;-------------------------------------------------
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE STR:(5000 + ARG:1)
					CASE "博麗神社"
						PRINTFORML 「음, 같이 박래 신사에 가고 싶어?」
						PRINTFORMW 「며칠 전에 레이무 씨에게 빌려줬던 책이 어떻게 되었을까 궁금했거든♪」
					CASE "命蓮寺"
						PRINTFORML 「음, 같이 명련사(命蓮寺)에 가고 싶니?」
						PRINTFORMW 「후훗, 거기서 경전들을 읽으며 많은 것을 배웠어♪」
					CASE "人間の里"
						PRINTFORML 「음, 마을에 함께 가시겠어요?」
						PRINTFORMW 「음... 데이트하고 싶어... \/\/\/」
					CASE "霧の湖～紅魔館"
						PRINTFORML 「음, 나랑 안개 호수에 같이 갈래?」
						PRINTFORMW 「한동안 여유로운 산책을 하고 싶었거든♪」
					CASE "迷いの竹林"
						PRINTFORML 「음, 같이 미아의 대나무 숲에 가고 싶어?」
						PRINTFORMW 「대나무 숲에 있는 손님들은 항상 찾기 힘들어서 쉽게 만날 수가 없어~」
					CASE "魔法の森"
						PRINTFORML 「음, 마법의 숲에 같이 가실래요?」
						PRINTFORMW 「며칠 전 마리사 씨에게 빌려줬던 책이 어떻게 됐을지 궁금했어요♪」
					CASE "三途の川～冥界"
						PRINTFORML 「음, 함께 경계의 길로 갈래?」
						PRINTFORMW 「나... 나는 죽지 않을 거야! 손님이 기다리고 있어!」
					CASE "妖怪の山 (山麓)"
						PRINTFORML 「음, 요괴산 기슭에 같이 가고 싶으신가요?」
						PRINTFORMW 「카파들이 관심 있어 하는 책을 빌렸어요.」
					CASE "妖怪の山 (山頂)"
						PRINTFORML 「음, 요괴산 정상에 같이 가보지 않을래?」
						PRINTFORMW 「나는 종종 그 신사에 책을 빌리는데, 가서 찾아오기가 힘들다.」
					CASE "地底"
						PRINTFORML 「음, 지하세계에 가고 싶어!」
						PRINTFORMW 「좀 무섭긴 하지만, %CALLNAME:MASTER%-님이 오신다면...」
					CASE "夢の世界～月"
						PRINTFORML 「음, 달로 여행을 가고 싶어!」
						PRINTFORMW 「정말 로맨틱할 거야!」
				ENDSELECT
				RETURN 1
			ENDIF
		CASE 1
			;-------------------------------------------------
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「야호! 괜찮아, 벌써 준비해뒀어♪」
				TCVAR:70:354 = 1
				TALENT:70:機嫌 = 1
				RETURN 1
			ENDIF
		CASE 2
			;-------------------------------------------------
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「알겠다. 아, 신경 쓰지 마세요.」
				PRINTFORMW 「Next time, then.」
				RETURN 1
			ENDIF
		CASE 3
			;-------------------------------------------------
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「음, 오늘 우리 집에 오는 게 어때?」
				IF FIRSTTIME("お招き", 1, 70)
					;どんな事情だ,店番しなくていいんか
					PRINTFORMW 「엄마 아빠 오늘 안 계셔서... 그래서...」
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%CALLNAME:MASTER%-님께서 읽으실 만한 책이 하나 있어요...」
						CASE 2
							PRINTFORMW 「배우고 싶은 게 있어...」
						CASEELSE
							PRINTFORMW 「부모님은 외출 중이셔...」
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
		CASE 4
			;-------------------------------------------------
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF FIRSTTIME("お招き", 0, 70)
					PRINTFORML 「정말?! 야호!」
					PRINTFORMW (방을 깨끗하게 유지해서 다행이다...)
				ELSE
					PRINTFORML 「야호♪」
					PRINTFORMW 「그럼, 당장 움직이자!」
				ENDIF
				TALENT:70:機嫌 = 1
				TCVAR:70:354 = 1
				RETURN 1
			ENDIF
		CASE 5
			;-------------------------------------------------
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「봤어... 아, 걱정하지 마세요.」
				PRINTFORMW 「다음엔 꼭 할게요!」
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
