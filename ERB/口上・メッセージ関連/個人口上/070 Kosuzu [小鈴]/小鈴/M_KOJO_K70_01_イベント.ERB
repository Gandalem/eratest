;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出される（怒り）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 「...Nn!」
			CASEELSE
				PRINTFORML 「...흠!」
		ENDSELECT
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「제발 나가세요!!」
			CASEELSE
				PRINTFORMW 「나 좀 내버려 둬!!」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「쿨... 후우...」
			CASE 2
				PRINTFORMW 「음... 음냠냠...」
			CASEELSE
				PRINTFORMW 「스윽... 스윽...」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		$MADOROMI
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「쿨... 후우... 음!」
			CASE 2
				PRINTFORMW 「음... 냠냠냠... 앗!」
			CASEELSE
				PRINTFORMW 「스우... 스우... 응!」
		ENDSELECT
		;いらん分岐かも
		IF CFLAG:MASTER:初期位置 == CFLAG:70:初期位置
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%-상... 일어나셨나요...?」
				CASE 2
					PRINTFORMW 「나아... %CALLNAME:MASTER%님... 안녕...」
				CASEELSE
					PRINTFORMW 「후우... %CALLNAME:MASTER%님... 외로워...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「오, %CALLNAME:MASTER%씨... 놀랐잖아...」
				CASE 2
					PRINTFORMW 「나아... %CALLNAME:MASTER%씨...? 무슨 일이야...?」
				CASEELSE
					PRINTFORMW 「후우... %CALLNAME:MASTER%님... 함께...」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		;非衰弱と同じ
		GOTO MADOROMI
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		$WARNING
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 「...Nn!」
			CASEELSE
				PRINTFORML 「...흠!」
		ENDSELECT
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「T-침입자!!」
			CASE 2
				PRINTFORMW 「뭐, 뭐 하는 거야?!!」
			CASEELSE
				PRINTFORMW 「뭐, 뭐 하는 거야?!!」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される（衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		;非衰弱と同じ
		GOTO WARNING
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
