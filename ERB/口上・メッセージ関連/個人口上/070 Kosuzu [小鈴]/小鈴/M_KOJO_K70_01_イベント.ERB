@M_KOJO_K70_KOSUZU_BURST
BASE:70:怒り += MAXBASE:70:怒り
CALL M_KOJO_K70_YAMETEKUDASAI(70, 8, 1)
CALL GETOUT(MASTER)
;付き添いゲストキャラ算出,分岐用と似てるけど扱いが異なるので注意,ゲストキャラ以外はゼロ

@M_KOJO_K70_FOLLOWER
#FUNCTION
#DIM CHARA
;阿求(80)は最優先
SIF CFLAG:80:同行
	RETURNF 80
;霊夢(1)、魔理沙(11)、紫(26)、文(29)、マミゾウ(69)、阿求(80)
FOR LOCAL, 1, 10
CHARA = TARGET:LOCAL
SIF GROUPMATCH(CHARA, 1, 11, 26, 29, 69, 80) && CFLAG:CHARA:同行
	RETURNF CHARA
NEXT
RETURNF 0
;反感をPALAMLVごと上げる処理,一応汎用性あり

@M_KOJO_K70_YAMETEKUDASAI(ARG, ARG:1, ARG:2)
;ARG	上げるキャラ
;ARG:1	上げるLV量
;ARG:2	0=CUP, 1=PALAM
;コマンド等の精算前ならCUPにすることでソースに表示されたり刻印取得に関わる,そうできない場合はPALAMを直接上げる
SIF ARG:1 <= 0
	RETURN
LOCAL = PALAMLV:(GETPALAMLV(PALAM:ARG:反感, 15) + ARG:1) - PALAMLV:(GETPALAMLV(PALAM:ARG:反感, 15))
;反感ゼロの時は最低でも+2する
SIF ARG:1 == 1 && GETPALAMLV(PALAM:ARG:反感, 15) == 0
	LOCAL = PALAMLV:2
IF ARG:1
	PALAM:ARG:反感 += LOCAL
ELSE
	CUP:ARG:反感 += LOCAL
ENDIF
;サドっ気小鈴ちゃん,一応汎用化

@M_KOJO_K70_SADISTIC(ARG)
#FUNCTION
SIF ABL:ARG:サドっ気 >= 3 && ABL:ARG:サドっ気 > ABL:ARG:マゾっ気 + 1
	RETURNF 1
;custom code, csv lines translation

