@M_KOJO_UPDATE_K70
#DIM VERSION
;口上独自のUPDATE用
;ENCOUNTER専用に独自分岐フラグを仕込んだ場合等にどうぞ
;UPDATE判定でCFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります
VERSION = 120
SIF TALENT:70:恋慕 || TALENT:70:愛欲 || TALENT:70:セフレ >= 2
	CFLAG:70:1006 = 1
CALL M_KOJO_COLOR_K70
IF !TALENT:70:キス未経験 || EXP:70:キス経験
	SIF FIRSTTIME("ファーストキス", 0, 70)
		PRINTFORML 코스즈는 %HIS_HER(70)%의 첫 키스를 경험했다.
ENDIF
IF EXP:70:精飲経験
	SIF FIRSTTIME("精液の味", 0, 70)
		PRINTFORML 코스즈는 정액의 맛을 안다.
ENDIF
RESETCOLOR
IF CFLAG:70:1100 == VERSION
	CALL M_KOJO_COLOR_K70
	PRINTFORML 최신 버전 (ver.{CFLAG:70:1100 / 100}.{CFLAG:70:1100 % 100})
	RESETCOLOR
ELSE
	SIF !CFLAG:70:1002
		CFLAG:70:1002 = DAY
	IF !CFLAG:70:1004 && ABL:70:親密
		PRINTFORML 코스즈의 자기소개는 이미 끝났나?
		PRINTL [1] - 응
		PRINTL [0] - No
		INPUT
		IF RESULT
			CFLAG:70:1004 = 1
			PRINTFORMW 자기소개는 완료되었다.
		ELSE
			PRINTFORMW 머지않아 자기소개를 할 것이다.
		ENDIF
	ENDIF
	IF !CFLAG:70:1005 && ABL:70:親密
		PRINTFORML 스즈나안이 방문된 상태로 설정한다?
		PRINTL [1] - 예
		PRINTL [0] - No
		INPUT
		IF RESULT
			PRINTFORML 스즈나안을 몇 번이나 방문했나요? (지금은 아무 의미가 없습니다)
			PRINTL [5] - 많이
			PRINTL [3] - 조금
			PRINTL [1] - 약간
			PRINTL [0] - 다시 생각해보니, 한 번도 안 함
			INPUT
			CFLAG:70:1005 = ABL:70:親密 * LIMIT(RESULT, 0, 5)
		ENDIF
		PRINTFORMW 당신의 방문 경험은 이제 {CFLAG:70:1005}입니다.
	ENDIF
	;these settings are for old saves
	IF TALENT:70:酒耐性 != -1
		PRINTFORML [약한 음주자?] 설정한다.
		PRINTL [1] - 예
		PRINTL [0] - No
		INPUT
		IF RESULT
			TALENT:70:酒耐性 = -1
			CALL M_KOJO_COLOR_K70
			PRINTFORMW 「아하♪」
			RESETCOLOR
		ELSE
			PRINTPLAIN [332] 대화가 조금 다를 수 있다. 참고해 달라.
			PRINTW 
		ENDIF
	ENDIF
	IF RELATION:70:80 < 200
		PRINTFORML 코스즈가 함께 일하는 캐릭터들과의 친밀도를 고칠까?
		PRINTL [1] - 예
		PRINTL [0] - No
		INPUT
		IF RESULT
			;めんどくさいので無駄多いけど80番まで回す
			FOR LOCAL, 1, 81
			IF GROUPMATCH(LOCAL, 1, 11, 26, 29, 69, 80)
				PRINTFORM %CALLNAME:LOCAL, 12, LEFT%{RELATION:70:LOCAL, 3}\% → 
				IF LOCAL < 30
					RELATION:70:LOCAL = 120
				ELSEIF LOCAL == 69
					RELATION:70:LOCAL = 150
				ELSEIF LOCAL == 80
					RELATION:70:LOCAL = 200
				ENDIF
				PRINTFORML {RELATION:70:LOCAL, 3}\%
			ENDIF
			NEXT
			PRINTFORMW 이제 이것으로 변경되었다.
		ELSE
			PRINTFORMW 변경되지 않았다.
		ENDIF
	ENDIF
	CFLAG:70:1100 = VERSION
	CALL M_KOJO_COLOR_K70
	PRINTFORML 업데이트 완료! (버전.{CFLAG:70:1100 / 100}.{CFLAG:70:1100 % 100})
	RESETCOLOR
ENDIF
RETURN 1
