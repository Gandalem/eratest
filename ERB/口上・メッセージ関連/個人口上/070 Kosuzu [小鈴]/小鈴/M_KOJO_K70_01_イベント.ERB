;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;通常の仕事以外（宴会）では発生しない
IF LOCAL && TCVAR:70:357 != TIME && GROUPMATCH(CFLAG:70:職種, 40, 41)
	;連打防止
	TCVAR:70:357 = TIME
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;仕事開始（職場へ移動する）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;小鈴の部屋
		IF M_KOJO_K70_SUZUNAAN(CFLAG:MASTER:現在位置) == 2
			PRINTFORMW 「죄송해요, %CALLNAME:MASTER%님. 지금 할 일이 있어서요...」
			SIF TALENT:70:恋慕 && PALAM:70:欲情
				PRINTFORMW 「나중에 계속하자...%UNICODE(0x2764)%」
		ELSE
			IF TALENT:70:恋慕
				PRINTFORML 「할 일이 있어서, 집에 가야 해.」
				PRINTFORMW (하아... 더 오래 함께 있고 싶었는데...)
			ELSE
				PRINTFORMW 「아, 벌써 이렇게 늦었네, 집에 가야겠어.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;店番
		IF CFLAG:70:職種 == 41
			SELECTCASE RAND:10
				CASE 1
					PRINTFORMW 「%M_KOJO_K70_AISATSU()%～」
