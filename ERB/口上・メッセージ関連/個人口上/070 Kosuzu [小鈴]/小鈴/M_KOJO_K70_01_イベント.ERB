					PRINTFORMW 「음, 이 책 말이야?」
				CASE 3
					PRINTFORMW 「환영해!」
				CASE 4
					PRINTFORMW 「돌아와 주셔서 감사합니다～」
					;半分はまったり
				CASEELSE
					PRINTFORMW 「♪～～」
			ENDSELECT
			;蔵書整理
		ELSEIF CFLAG:70:職種 == 40
			;特に要らない気がした
			;WAIT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;小鈴の仕事って活動時間外に終わるからデート誘えないのよねー
	IF LOCAL:1 && ARG == 3
		;店番
		IF CFLAG:70:職種 == 41
			;仕事手伝った
			IF GETBIT(TCVAR:70:360, 1)
				IF TALENT:70:恋慕
					PRINTFORML 「후우, 도와줘서 고마워~」
					IF CFLAG:MASTER:初期位置 == CFLAG:70:初期位置
						SELECTCASE RAND:3
							CASE 1
								PRINTFORMW 「%CALLNAME:MASTER%님과 함께 일하게 되어 기뻐♪」
								PRINTFORMW 「괜찮으시다면 %CALLNAME:MASTER%상님... 저... 아무것도 아니에요, 신경 쓰지 마세요!\/\/\/」
							CASE 2
								;お父さん登場するのか？
								PRINTFORMW 「%CALLNAME:MASTER%님 덕분에 최근 매출이 늘었어요!」
								PRINTFORMW 「아버지께서 항상 도와주셔서 감사하다고 전해달라고 하셨어요~」
							CASEELSE
								PRINTFORMW 「%CALLNAME:MASTER%-씨가 여기에 있어서 정말 감사해~」
								PRINTFORMW 「다음엔 저녁 먹을래? 목욕할까? 아니면...%UNICODE(0x2764)%?」
						ENDSELECT
					ELSE
						PRINTFORMW 「오늘 도와주셔서 정말 감사합니다!」
						SELECTCASE RAND:5
							CASE 1
								;特にイベントというわけではなく引っ越しを促してるだけ
								PRINTFORML 「%CALLNAME:MASTER%-상, 괜찮다면 공식적으로 내 가게에서 일해도 돼ー」
								PRINTFORMW 「그럼 우리 집에도 살 수 있고, 혹시 꺼리지 않는다면 - 내 방에... 나와 함께...%UNICODE(0x2764)%」
							CASEELSE
								PRINTFORMW 「후후, %CALLNAME:MASTER%-님과 일하는 건 정말 재미있네요♪」
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「후우, 도와줘서 고마워.」
					PRINTFORMW 「나중에 보상 줄게.」
				ENDIF
			ELSE
				IF TALENT:70:恋慕
					PRINTFORML 「후우, 피곤해~」
					PRINTFORMW 「게다가 당신의 도움에도 불구하고 말이야 %CALLNAME:MASTER%-상.」
