					PRINTFORMW 「후우, 피곤해~」
				ENDIF
			ENDIF
			;蔵書整理
		ELSEIF CFLAG:70:職種 == 40
			;仕事手伝った
			IF GETBIT(TCVAR:70:360, 1)
				IF TALENT:70:恋慕
					PRINTFORML 「후우, 도와줘서 고마워~」
					PRINTFORMW 「%CALLNAME:MASTER%-님과 함께 정말 빨리 끝났어♪」
				ELSE
					PRINTFORML 「후우, 도와줘서 고마워.」
					PRINTFORML 「네 도움 덕분에 일찍 끝냈어~」
					PRINTFORMW 「정말 고마워!」
				ENDIF
			ELSE
				PRINTFORMW 「후우, 드디어 끝났네~」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
