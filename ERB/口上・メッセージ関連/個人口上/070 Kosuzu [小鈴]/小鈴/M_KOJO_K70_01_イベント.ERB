			CASE 2
				;欲求不満が高くて抜け出せなかった
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「아직 안 됐잖아~! 아직 부족해~!」
					CASE 2
						PRINTFORML 「미안해요! 조금만 더 해주세요!」
						PRINTFORMW 「아직 좀 더 하고 싶어요~!」
					CASEELSE
						PRINTFORML 「아! 잠깐만 기다려 주세요!」
						PRINTFORMW 「조금 더, 정말 조금만 더요!」
				ENDSELECT
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
