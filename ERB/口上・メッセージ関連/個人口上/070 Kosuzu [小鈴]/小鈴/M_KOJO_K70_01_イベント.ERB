					PRINTFORML 「혹시 저에게 스스로 밀리기를 원하셨던 건가요~?」
			ENDSELECT
			IF TALENT:70:恋慕
				IF M_KOJO_K70_SADISTIC(70)
					SELECTCASE RAND:5
						CASE 1
							PRINTFORMW 「... 괜찮을 거야... 아프지 않게 해줄 테니까...%UNICODE(0x2764)%」
						CASE 2
							PRINTFORMW 「... 너를 많이 괴롭힐 거야...%UNICODE(0x2764)%」
						CASE 3
							PRINTFORMW 「… 이걸 예상하고 있었지, 그렇지? 알고 있어…%UNICODE(0x2764)%」
						CASE 4
							PRINTFORMW 「... 후후♪ 나를 초대하는 데 정말 능력이 있네...%UNICODE(0x2764)%」
						CASEELSE
							PRINTFORMW 「... 오늘 어떻게 해야 할지 모르겠어%UNICODE(0x2764)%」
					ENDSELECT
				ELSE
					SELECTCASE RAND:5
						CASE 1
							PRINTFORMW 「... 괜찮을 거야... 부드럽게 할게...%UNICODE(0x2764)%」
						CASE 2
							PRINTFORMW 「... 너를 아이처럼 응석받이로 만들어 줄 거야...%UNICODE(0x2764)%」
						CASE 3
							PRINTFORMW 「... 제발, 네가 원한 거잖아...%UNICODE(0x2764)%」
						CASE 4
							PRINTFORMW 「... 전부 %CALLNAME:MASTER%-님이 저를 그렇게 바라보시기 때문이야...%UNICODE(0x2764)%」
						CASEELSE
							PRINTFORMW 「... 나는 연모한다... %CALLNAME:MASTER%-상...%UNICODE(0x2764)%」
					ENDSELECT
				ENDIF
			ELSE
				PRINTFORMW 「이번엔 내가 모시겠다...%UNICODE(0x2764)%」
			ENDIF
			;妊娠中
			IF TALENT:70:妊娠 && CFLAG:70:妊娠自覚状態 == 1
				PRINTFORML 
				PRINTFORMW 「아...! 임신했으니까 부드럽게 해줘...」
				;危険日
			ELSEIF CFLAG:70:生理周期 == 7 && !TALENT:70:妊娠 && CFLAG:70:生解禁 == 2
				PRINTFORML 
				PRINTFORMW (후훗... %UNICODE(0x2764)% 작은 코스즈~♪)
				;使い方ちがくないですかぁ？
			ENDIF
			TCVAR:70:351 = 1
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERに抱きついた（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			RETURN 1
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
				;抜け出した
				IF TALENT:70:恋慕
					;妊娠中
					IF TALENT:70:妊娠 && CFLAG:70:妊娠自覚状態 == 1
						PRINTFORML 「아아... 어쩔 수 없지...」
						PRINTFORMW 「우리는 %BABYPLNOUN("baby",70)%을 돌봐야 해...」
