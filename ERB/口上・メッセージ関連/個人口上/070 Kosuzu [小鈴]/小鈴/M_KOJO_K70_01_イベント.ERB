			PRINTL 
			PRINTFORML 「음... 문야... 하아...」
			IF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 2
				IF GROUPMATCH(分岐, 1, 2, 3) || TALENT:70:機嫌 == 1
					PRINTFORMW 「아, %CALLNAME:MASTER%-씨, 좋은 아침이에요~♪」
					IF CFLAG:70:1001 == DAY - 1
						PRINTFORML 「에헤헤 %UNICODE(0x2764)% 어제 정말 최고였어♪」
						PRINTFORMW 「다음에 또 하자♪」
						TALENT:70:機嫌 = 1
					ELSE
						PRINTFORMW 「후후♪ %CALLNAME:MASTER%-님께서 꿈에 나타나셨어...%UNICODE(0x2764)%」
					ENDIF
				ELSEIF 分岐 == 0 || TALENT:70:機嫌 == -1
					PRINTFORMW 「아, %CALLNAME:MASTER%-씨, 좋은 아침이야...」
					PRINTL 
					PRINTFORMDL 코스즈가 짜증을 내는 것 같다...
					PRINTFORMDL 어쩌면 어제 무슨 일이 있었던 걸지도 모르겠다...
					PRINTW 
					PRINTFORMW 「뭔 거지...? 내 얼굴에 뭐 묻었나?」
					TALENT:70:機嫌 = -1
				ELSEIF GROUPMATCH(分岐, 4, 5, 6)
					PRINTFORMW 「아, %CALLNAME:MASTER%씨, 좋은 아침이에요.」
					PRINTFORMW 「헤헤...♪ 깨서 %CALLNAME:MASTER%씨 얼굴을 보니 기분이 좋네요~」
				ELSE
					PRINTFORMW 「아, %CALLNAME:MASTER%-상, 좋은 아침입니다.」
					IF DAY:2 == 1
						PRINTFORML 「꽤 따뜻해지고 있네.」
						PRINTFORMW 「좀 더 자고 싶어...」
					ELSEIF DAY:2 == 2
						PRINTFORML 「오늘 더운데...」
						PRINTFORMW 「%CALLNAME:MASTER%님, 땀 흘리고 있어요?」
					ELSEIF DAY:2 == 3
						PRINTFORML 「꽤 추워지고 있어」
						PRINTFORMW 「%CALLNAME:MASTER%씨, 저를 따뜻하게 해 주세요...\/\/\/」
						;＞＜*
					ELSEIF DAY:2 == 4
						PRINTFORML 「오늘 점점 추워지는군...」
						PRINTFORMW 「우으... 이 이불 밖으로 나가기 싫어...」
					ENDIF
				ENDIF
			ELSE
				PRINTFORMW 「...엣? %CALLNAME:MASTER%씨? 그곳은...」
				PRINTFORMW 「아, 맞다! 저... 실례합니다...\/\/\/」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			;非同棲時と同じ
			GOTO OHAOHAYOU
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
