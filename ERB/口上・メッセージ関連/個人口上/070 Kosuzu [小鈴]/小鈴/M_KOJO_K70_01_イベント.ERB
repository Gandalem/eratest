			;こすずちゃん妖気モード
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「아아... %UNICODE(0x2764)%」
					PRINTFORML 「%CALLNAME:MASTER%-씨, 얼마나 무방비한지... %UNICODE(0x2764)%」
