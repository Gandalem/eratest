@M_KOJO_EVENT_K70_1(ARG,ARG:1)
#DIM フキゲン
#DIM 嫉妬フキゲン
フキゲン = 0
嫉妬フキゲン = 0
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;やたら分岐あるけど全部正常に動くか確認できてない
	;まぁ変なの表示されたりしてなければ多少の死に分岐くらいは気にしない
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた＆TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2) && !GETBIT(TCVAR:70:360, 3)
		CALL M_KOJO_EVENT_K70_1_MAINMAP(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;統合しました
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「아!!! %CALLNAME:MASTER%-님! 죄-죄송합니다!!!」
		PRINTFORMW 「에... 저도 같이 가도 될까요?」
		PRINTFORMW 「저... 그 은혜는 감사하게 생각하겠습니다...\/\/\/」
		CALL M_KOJO_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「아!!! %CALLNAME:MASTER%-상!」
		PRINTFORMW 「이제 여자들의 시간이야! 빨리 나가줘!!」
		CALL M_KOJO_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;謎の設定
		PRINTFORML 「아!!! %CALLNAME:MASTER%-상!」
		PRINTFORMW 「이제 여자들의 시간이야! 빨리 나가줘!!」
		CALL M_KOJO_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && !GETBIT(TCVAR:70:360, 3)
		;ハロウィン優先
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_EVENT_K70_1_HALLOWEEN
			;鈴奈庵
		ELSEIF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
			CALL M_KOJO_EVENT_K70_1_ENTER_SUZUNAAN(M_KOJO_K70_FOLLOWER())
		ELSE
			PRINTFORMW 「아, %CALLNAME:MASTER%-상, %M_KOJO_K70_AISATSU()%\@ TALENT:70:恋慕 ? ! # . \@」
		ENDIF
		;バレンタイン
		SIF DAY:2 == 4 && DAY:3 == 14
			CALL M_KOJO_EVENT_K70_1_VALENTINE
		CALL M_KOJO_EVENT_K70_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7 && !GETBIT(TCVAR:70:360, 3)
		;ハロウィン優先
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_EVENT_K70_1_HALLOWEEN
			;鈴奈庵
		ELSEIF M_KOJO_K70_SUZUNAAN(CFLAG:70:現在位置) == 1
			CALL M_KOJO_EVENT_K70_1_ENTER_SUZUNAAN(M_KOJO_K70_FOLLOWER())
		ELSE
			;霊夢(1)、魔理沙(11)、紫(26)、文(29)、マミゾウ(69)、阿求(80)
			IF FLAG:デート相手 == 80
				;5の扱いが鈴奈庵で遭う時と異なってるのは仕様
				PRINTFORMW 「아, %CALLNAME:MASTER%-상, %M_KOJO_K70_AISATSU()%\@ TALENT:70:恋慕 ? ! # . \@」
				SELECTCASE M_KOJO_K70_BALANCE(70, 80)
					CASE 8, 5
						PRINTFORML 「오, 오늘 아큐우랑 데이트해?~」
