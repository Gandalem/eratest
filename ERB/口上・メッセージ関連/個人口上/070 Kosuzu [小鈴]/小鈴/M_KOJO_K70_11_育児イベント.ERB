; Modular ERB: 個人口上/070 Kosuzu [小鈴]/小鈴/M_KOJO_K70_11_育児イベント.ERB
;-------------------------------------------------
;子供の性格設定関数
;ARG	子供の番号
;■小鈴の子供（男女共通,男はNo.+10）
;No,▼タイプ　　▼好きなもの　　　▼嫌いなもの　▼将来の夢
; 1,元気　　　　恋愛小説・妖魔本　おばけ　　　　跡継ぎ
; 2,真面目　　　推理小説・文学書　妖怪　　　　　先生
; 3,クール　　　随筆・歴史書　　　騒音　　　　　外の世界で生活
;-------------------------------------------------

@M_KOJO_K70_CHILD_TYPE_SETTING(ARG)
#DIM タイプ
#DIM LPCOUNT
SELECTCASE 素質計算(MASTER)
	;気弱系,2:6:4
	CASE 1
		LOCAL:1 = 2
		LOCAL:2 = 8
		LOCAL:3 = 12
		;強気系,3:3:6
	CASE 2
		LOCAL:1 = 3
		LOCAL:2 = 6
		LOCAL:3 = 12
		;素直系,6:4:2
	CASE 3
		LOCAL:1 = 6
		LOCAL:2 = 10
		LOCAL:3 = 12
		;真面目系,2:6:4
	CASE 4
		LOCAL:1 = 2
		LOCAL:2 = 8
		LOCAL:3 = 12
		;その他,6:4:2
	CASEELSE
		LOCAL:1 = 6
		LOCAL:2 = 10
		LOCAL:3 = 12
ENDSELECT
LOCAL = RAND:12
IF LOCAL < LOCAL:1
	タイプ = 1
ELSEIF LOCAL < LOCAL:2
	タイプ = 2
ELSEIF LOCAL < LOCAL:3
	タイプ = 3
ELSE
	RESTART
ENDIF
SIF CHILD_SEX:70:ARG == 2
	タイプ += 10
IF MATCH(CFLAG:70:0, タイプ, 1011, 1020) && LPCOUNT < 10
	LPCOUNT ++
	RESTART
ENDIF
CFLAG:70:(1010 + ARG) = タイプ
