@M_KOJO_K70_漢数字変換(ARG)
#FUNCTIONS
;日記用に作った漢数字文字列にして返す関数
;1～99まで
;=============================
LOCALS =
SELECTCASE ARG / 10
	CASE 1
		LOCALS += "十"
	CASE 2
		LOCALS += "二十"
	CASE 3
		LOCALS += "三十"
	CASE 4
		LOCALS += "四十"
	CASE 5
		LOCALS += "五十"
	CASE 6
		LOCALS += "六十"
	CASE 7
		LOCALS += "七十"
	CASE 8
		LOCALS += "八十"
	CASE 9
		LOCALS += "九十"
ENDSELECT
SELECTCASE ARG % 10
	CASE 1
		LOCALS += "一"
	CASE 2
		LOCALS += "二"
	CASE 3
		LOCALS += "三"
	CASE 4
		LOCALS += "四"
	CASE 5
		LOCALS += "五"
	CASE 6
		LOCALS += "六"
	CASE 7
		LOCALS += "七"
	CASE 8
		LOCALS += "八"
	CASE 9
		LOCALS += "九"
ENDSELECT
RETURNF LOCALS
;=============================

@M_KOJO_K70_適当日付設定(ARG)
;日記用に作った適当に日付を付ける関数
;=============================
SELECTCASE ARG % 12
	CASE 1, 2, 3
		PRINT 월 ○
	CASE 4, 5, 6
		PRINT 달 □
	CASE 7, 8, 9
		PRINT 월 △
	CASEELSE
		PRINT 월 ☆
ENDSELECT
PRINT , 
SELECTCASE ARG % 10
	CASE 1
		PRINT 날짜 ×
	CASE 2
		PRINT 날짜 ■
	CASE 3
		PRINT 날짜 ●
	CASE 4
		PRINT 날짜 ▲
	CASE 5
		PRINT 낮 ★
	CASE 6
		PRINT 날
	CASE 7
		PRINT 날짜☆
	CASE 8
		PRINT 날짜 □
	CASE 9
		PRINT 날짜 △
	CASE 0
		PRINT 날짜 ○
ENDSELECT
