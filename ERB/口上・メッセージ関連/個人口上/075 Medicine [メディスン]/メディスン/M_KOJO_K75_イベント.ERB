@M_KOJO_EVENT_K75_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;人間とデート中（種族：人間が付いているキャラ）
		IF GROUPMATCH(ARG:1,1,11,15,23,31,46,47,56,61,62,67,70,72,80,81,82,90,92,98,99,106,110,122,123)
			IF TALENT:恋慕 || TALENT:恋人
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「%CALLNAME:MASTER%…」
						PRINTW 
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%……역시, 인간과 함께 있는 쪽이 즐거운 거야?」
						PRINTFORML 메디슨은 울 것 같은 표정을 짓고 있다.
						PRINTW 
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「……역시, 인간들은 나를 버려버리는구나」
						PRINTW 
					CASE 1
						PRINTFORML 「역시 인간은 인간끼리 붙는 걸 좋아하는구나」
						PRINTW 
				ENDSELECT
			ENDIF
		ELSE
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「나한테서 %조사처리(CALLNAME:MASTER,"를")% 빼앗지 말아줘요오」
				PRINTFORML 메디슨은 울상이 된 표정을 하고 있다.
				PRINTW 
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「변, %조사처리(CALLNAME:MASTER,"가")% 없다고 딱히 외롭지 않아」
						PRINTFORML 메디슨은 휙 돌아서서 등을 돌렸다.
						PRINTW 
					CASE 1
						PRINTFORML 「저기, 오늘은 나한테 인간의 걸 가르쳐 주는 날 아니었어?」
						PRINTW 
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		IF TALENT:恋慕 || TALENT:恋人
			IF TIME >= 360 && TIME < 720
				SIF CFLAG:75:1002 == 1
					PRINTFORML 「안녕, %CALLNAME:MASTER%」
				PRINTFORML 메디슨은 싱글벙글 웃고 있다.
				CALL ASK_YN("안녕","왜 그래, 기분 좋아 보이네")
				IF !RESULT
					PRINTFORML 「오늘은 뭘 하면서 놀까. %조사처리(CALLNAME:MASTER,"는")%, 뭐가 하고 싶어?」
					PRINTW 
				ELSE
					PRINTFORML 「응,だて 아침부터 %조사처리(CALLNAME:MASTER,"를")% 만났으니까」
					PRINTFORML 「아침부터 %조사처리(CALLNAME:MASTER,"를")% 만난 날은 정말 행복한 날이라고 정해뒀거든. 응, 수우 씨」
					PRINTW 
				ENDIF
				PRINTW 
			ELSEIF TIME >= 720 && TIME < 930
				SIF CFLAG:75:1002 == 1
					PRINTFORML 「안녕하세요, %CALLNAME:MASTER%」
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 정말 잠이 많은 사람이구나. 기다리다 지쳤잖아」
				PRINTFORML 「기다린 만큼, 나한테 많이 신경 써줘」
				PRINTW 
			ELSEIF TIME >= 930 && TIME < 960
				SIF CFLAG:75:1002 == 1
					PRINTFORML 「안녕하세요, %CALLNAME:MASTER%」
				PRINTFORML 「이제 슬슬 집에 가려고 생각하고 있었는데」
				IF CFLAG:MASTER:初期位置 == CFLAG:75:初期位置
					PRINTFORML 「%CALLNAME:MASTER%도 같이 돌아가요」
					PRINTW 
				ELSE
					PRINTFORML 「집에 들러주면 정말 기쁠 거야」
					CALL ASK_YN("물론","좀 어렵나")
					IF !RESULT
						PRINTFORML 「기뻐! 잔뜩 이야기하자」
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 무릎 위에서, 안겨 있으면서 이야기하는 거야」
						PRINTW 
					ELSE
						PRINTFORML 「그렇구나... 정말 안됐네」
						PRINTFORML 메디슨은 눈에 띄게 풀이 죽었다
						PRINTW 
					ENDIF
				ENDIF
			ELSE
				IF CFLAG:75:1002 == 1
					SIF TIME >= 1080
						PRINTFORML 「안녕하세요, %CALLNAME:MASTER%」
				ENDIF
				PRINTFORML 「오늘은 못 볼지도 모른다고 생각하니까, 너무 외로웠어……」
				PRINTFORML 
			ENDIF
		ELSE
			IF TIME >= 360 && TIME < 720
				SIF CFLAG:75:1002 == 1
					PRINTFORML 「좋은 아침」
				IF TIME < 600
					PRINTFORML 「당신은 일찍 일어나네」
				ELSE
					IF GROUPMATCH(TIME:5, 0, 1)
						PRINTFORML 「벌써 해가 높이 떠 있잖아. 당신은 잠꾸러기였네」
						PRINTW 
					ELSE
						PRINTFORML 「당신은 늦잠 자는 사람이구나」
						PRINTW 
					ENDIF
				ENDIF
			ELSEIF TIME >= 720 && TIME < 930
				SIF CFLAG:75:1002 == 1
					PRINTFORML 「안녕하세요」
				IF GROUPMATCH(TIME:5, 0, 1)
					PRINTFORML 「벌써 해가 높이 떠 있는데. 너무 늦었잖아」
					PRINTW 
				ELSE
					PRINTFORML 「너무 늦잖아. 언제까지 기다리게 할 거야」
					PRINTW 
				ENDIF
			ELSEIF TIME >= 930 && TIME < 960
				SIF CFLAG:75:1002 == 1
					PRINTFORML 「안녕하세요」
				PRINTFORML 「나, 이제 집에 가려고 생각 중이었는데…」
				PRINTFORML 「당신은 요괴보다 늦은 시간에 활동하는구나」
				PRINTW 
			ELSE
				IF CFLAG:75:1002 == 1
					SIF TIME >= 1080
						PRINTFORML 「안녕하세요」
					PRINTFORML 「몇 시라고 생각하는 거야」
					PRINTFORML 「나, 이제 집에서 푹 쉬고 싶은데……」
					PRINTW 
				ELSE
					PRINTFORML 「몇 시라고 생각하는 거야」
					PRINTFORML 「나, 이제 집에서 푹 쉬고 싶은데……」
					PRINTW 
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;朝起きたとき（おはよう口上）
;==================================================

@M_KOJO_EVENT_K75_2(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「……저, ……와줘, %CALLNAME:MASTER%, 일어나」
				PRINTFORML 눈을 뜨자, 메디슨의 얼굴이 시야 가득 들어왔다.
				PRINTFORML 「아, 드디어 일어났네. %조사처리(CALLNAME:MASTER,"는")% 정말 잠꾸러기시구나」
				PRINTW 
				PRINTFORML 어느새 메디슨이 올라타 몸을 흔들고 있었던 듯하다.
				CALL ASK_M("키스한다", EXP:75:キス経験 >= 1, "안아준다", 1, "뺨을 쓰다듬는다", 1, "앞으로 5분...", 1)
				SELECTCASE RESULT
					;キスする
					CASE 0
						PRINTFORML 「아……응……츄……츄……」
						PRINTFORML 순간 놀란 표정을 지었지만, 메디슨은 순순히 입맞춤을 받아들였다.
						PRINTW 
						PRINTFORML 「푸아…… 벌써, 끝이야?」
						PRINTFORML 아쉬운 듯, 두 사람 사이에 은색 실이 연결되어 있다.
						PRINTW 
						CALL ASK_YN("계속한다.","슬슬 일어나자")
						IF !RESULT
							PRINTFORML 「멋져. 머리가 녹아버릴 것 같아. 쪽, 츄릅, 촉촉…」
							PRINTFORML 서로가 만족할 때까지, 충분한 시간을 들여 입맞춤을 나누었다
							PRINTW 
						ELSE
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 못됐어」
							PRINTFORML 메디슨이 볼을 부풀리며 항의한다.
							PRINTFORML 「나중에 계속해 줘. 약속이야」
							PRINTFORML 알겠다고 약속하고 이마에 입 맞추자, 메디슨은 간지러운 듯한 표정을 지었다.
							PRINTW 
						ENDIF
						;抱きしめる
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%, 따뜻해」
						IF GROUPMATCH(TALENT:MASTER:体型,1,2,3)
