						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
