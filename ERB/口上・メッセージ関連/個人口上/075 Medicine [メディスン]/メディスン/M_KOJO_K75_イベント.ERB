											PRINTFORML 「투정도 안 부를게. 외로운 건 싫으니까」
									ENDSELECT
								ENDIF
							CASE 1
								PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 있을 때, 나 정말 행복해」
								PRINTFORML 「내일도 보러 와줘. 약속이야」
						ENDSELECT
						PRINTW 
					ENDIF
				ELSEIF BASE:75:ムード >= MAXBASE:75:ムード / 2
					IF CFLAG:MASTER:初期位置 == CFLAG:75:初期位置
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 외출하면, 언제나 즐거운 발견이 있다」
						PRINTFORML 「자, 우리 집에 돌아가자」
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")% 안긴 채, 침대에서 즐거운 꿈을 꾸는 거야」
						PRINTW 
					ELSE
						PRINTFORML 「언제나 이 시간은 조금 서툴러서요」
						PRINTFORML 「왜냐면, %조사처리(CALLNAME:MASTER,"와")% 떨어지게 되잖아요」
						PRINTW 
					ENDIF
				ELSE
					IF CFLAG:MASTER:初期位置 == CFLAG:75:初期位置
						PRINTFORML 「もと %조사처리(CALLNAME:MASTER,"와")% 여러 곳을 둘러다니고 싶었어」
						PRINTFORML 「아니면, 나랑 집에서 단둘이 시간을 보내고 싶었던 거야?」
						PRINTW 
					ELSE
						PRINTFORML 「금방 돌아가 버려서, 재미없다」
						PRINTFORML 「나는 %조사처리(CALLNAME:MASTER,"와")% 더 함께 있고 싶다」
						PRINTW 
					ENDIF
				ENDIF
			ENDIF
		ELSE
			;デート回数１００回
			IF CFLAG:1001 == 100
				PRINTFORML 「――언제나 고마워」
				CALL ASK_YN("천만에","뭔가 말했어?")
				IF !RESULT
					PRINTFORML 「그 여유로운 태도가 짜증 나게 해」
					PRINTFORML 「내가 더 우위에 있는 몸이니까. 잊지 마렴」
					PRINTFORML 「알았으면, 그 비웃는 표정 좀 없애줘」
					PRINTW 
				ELSE
					PRINTFORML 「아무것도 아니야. 응, 수스 씨」
					PRINTFORML 메디슨은 뾰로통하게 고개를 돌려버렸다
				ENDIF
			ELSE
				IF BASE:75:ムード == MAXBASE:75:ムード
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「…… 당신치곤 괜찮았네」
						CASE 1
							PRINTFORML 「……%CALLNAME:MASTER%치고는 나았네」
							CALL ASK_YN("이름을 불러줘서 기뻐","지금, 이름을 불러준 거야?")
							IF !RESULT
								PRINTFORML 「……언제나 '당신'뿐이라 말하기가 좀 그렇잖아」
								PRINTFORML 메디슨은 뾰로통하게 뒤돌아섰다
								PRINTW 
							ELSE
								PRINTFORML 「착각일 거야. 네 귀가 망가진 거 아니야?」
								CALL ASK_YN("불러줬지?","그렇구나")
								IF !RESULT
									PRINTFORML 「기분 탓이라고 말하고 있잖아」
									PRINTFORML 「우웁, 귀찮아! 해버려, 수스 씨!」
									PRINTFORML 메디슨은 화를 내며 독의 탄막을 여기저기 뿌렸다.
									PRINTW 
								ELSE
									PRINTFORML 「그렇단 말이야」
									PRINTFORML 「이름을 불러주길 원한다면, 나를 더 여러 곳에 데려가 줘」
									PRINTW 
								ENDIF
							ENDIF
					ENDSELECT
				ELSEIF BASE:75:ムード >= MAXBASE:75:ムード / 2
					SELECTCASE RAND:2
						CASE 0
							SELECTCASE RAND:2
								CASE 0
									PRINTFORML 「지루하지 않았어. 그 기세로 계속 노력해 봐」
									PRINTW 
								CASE 1
									PRINTFORML 「지루하지 않았어. 그 기세로 계속 노력해 봐」
									CALL ASK_YN("알겠습니다, 아가씨.","여전히 잘난 체하는군")
									IF !RESULT
										PRINTFORML 「뭐야, 그 말투. 마치 하인 같잖아」
										PRINTFORML 「하지만 당신이 하인이 된 것도 나쁘지는 않네」
										PRINTFORML 「'복종할 수 있다'는 의미로 말한 거야. 히죽거리지 마. 기분 나빠」
										PRINTW 
									ELSE
										PRINTFORML 「아라, 눈치채지 못했니? 당신은 내가 생으로 살려주고 있는 것뿐인데」
										PRINTFORML 「독에 물리고 싶지 않다면, 앞으로도 내 말을 잘 들어야 해」
										PRINTW 
									ENDIF
							ENDSELECT
						CASE 1
							PRINTFORML 「오늘은 그럭저럭이다」
							PRINTFORML 「내일은 더 즐거운 곳으로 데려가라」
							PRINTW 
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「지렁이에게 독을 뿌리고 우울해하는 걸 보는 쪽이 훨씬 즐거웠어」
							PRINTW 
						CASE 1
							PRINTFORML 「인간이란 거 좀 더 박식할 거라고 생각했는데, 기대 이하였나 봐」
							PRINTW 
						CASE 2
							PRINTFORML 「하아, 재미없었어」
							PRINTFORML 「당신은 다른 사람들과는 다르다고 생각했는데, 정말 실망이네」
							PRINTW 
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
