@M_KOJO_EVENT_K75_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;==================================================
	;メディスン特殊イベント枠
	;==================================================
	;禁断のポワゾン
	IF ((TALENT:恋慕 && TALENT:恋人) || ((TALENT:恋慕 || TALENT:恋人) && CFLAG:75:好感度 >= 10000 && CFLAG:75:信頼度 >= 5000)) && CFLAG:75:1222 <= 1
		CALL K75_POISON_XXX
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		IF !TALENT:75:恋慕 || !TALENT:75:恋人
			IF ARG == 124 && CFLAG:好感度 >= 2000 && CFLAG:信頼度 >= 1000
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[メディスン]], "通常", "服", "", ""
				PRINTFORML 「………………」
				PRINTW 
			ELSEIF ARG == 62 && CFLAG:好感度 >= 2000 && CFLAG:信頼度 >= 500
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[メディスン]], "発情", "裸", "", ""
				PRINTFORML (%CALLNAME:MASTER%…… 분명, 나 같은 건 벌써 잊어버렸겠지)
				PRINTFORML (역시, 인간이란 믿을 수 없어)
				PRINTW 
			ELSEIF ARG == 31 && CFLAG:好感度 >= 1000 && CFLAG:信頼度 >= 300
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[メディスン]], "通常", "裸", "", ""
				PRINTFORML (%CALLNAME:MASTER%, 전혀 보러 안 와주네)
				PRINTFORML 「불쾌한 기분이네요, 수스 씨」
				PRINTW 
			ELSEIF ARG == 10 && CFLAG:好感度 >= 1000 && CFLAG:信頼度 >= 100
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[メディスン]], "怒り", "服", "", ""
				PRINTFORML 「저 사람, 벌써 며칠째 나한테 오지 않네……」
				PRINTFORML 「정말 무례한 사람이란 말이야, 수우 씨」
				PRINTW 
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		RETURN 1
	ENDIF
ENDIF
RETURN 1
