@M_KOJO_MESSAGE_COM_K75_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(413)
		LOCALS:0 = 
		IF TALENT:恋慕 || TALENT:恋人 || TALENT:思慕 || CFLAG:好感度 >= 500
			LOCALS:0 = %MASTERNAME:42%
		ELSE
			LOCALS:0 = 「너」
		ENDIF
		PRINTFORML 「헤에, %LOCALS:0%가 요리를 하는구나. 뭘 만들 거야?」
	ELSE
		PRINTFORMW 「이번에는 뭘 만들 작정인 거야?」
	ENDIF
	IF CFLAG:睡眠 || FLAG:70
		;実際の鈴蘭は嘔吐とか心臓麻痺とかを引き起こすみたいなんですが、ゲームっていうことでビジュアル重視の症状にしました
	ELSEIF DISHNAME == "鈴蘭団子"
		;1回目
		IF CFLAG:1010 == 0
			PRINTFORML 「요리를 가르쳐 달라고? 나한테?」
			IF EXP:料理経験 == 0
				PRINTFORML 「저, 인간의 요리 같은 건 해본 적 없는데……」
			ELSE
				IF TALENT:恋慕 || TALENT:恋人
					IF ABL:料理技能 >= 3
						PRINTFORML 「음~ 요리라고 해도 %조사처리(CALLNAME:MASTER,"가")% 기뻐해 줄까……」
					ELSE
						PRINTFORML 「요리 방법은 알고 있는데, 잘 못하면 부끄럽잖아」
					ENDIF
				ELSE
					PRINTFORML 「에ー 귀찮아……. 꼭 가르쳐야 해?」
					PRINTFORML 「하아……. 알겠어. 하지만 인간들이 좋아하는 건지 모르니까 말이야」
				ENDIF
			ENDIF
			PRINTFORML 「그럼, 내가 제일 좋아하는 걸 알려줄게」
			PRINTW 
			PRINTFORML 메디슨이 준비한 재료를 보았다.
			PRINTFORML 단고 가루, 뜨거운 물, 물, 설탕, 간장까지는 알겠다.
			PRINTFORML 그 옆에, 대량의 은란…… 은란?
			PRINTW 
			PRINTFORML 「그렇지. 그거 없으면 맛있게 안 되니까」
			PRINTFORML 「우선 따온 은방울꽃을 물에 담가 두는 거야」
			PRINTW 
			PRINTFORML 「응... 이런 걸까. 지금 이 물 가득 수레란 독이 고여있어」
			PRINTFORML 「%CALLNAME:MASTER%에게는 보이지 않는 거구나. 나한테는 만찬의 산으로 보이는데」
			PRINTFORML 얼굴을 가까이 가져가자, 머리가 어지러워졌다...
			PRINTW 
			PRINTFORML 「그래서, 이 물에 경단 가루를 넣고 잘 저어주세요」
			PRINTFORML 「자, 자…… 후우, 힘들다아」
			PRINTFORML 젓는 손이 어딘가 저릿하다… 자세히 보니 빨갛게 부풀어 오르지 않았던가
			PRINTW 
			PRINTFORML 「적당히 부드러워지면, 잘게 찢어서 경단 모양으로 동글동글 만들어줘. 빙글빙글, 빙글빙글」
			PRINTFORML 「그걸 냄비에 넣고 삶는 거야. 야호, 야호」
			PRINTFORML 이대로 작업을 계속하다가는 손이 독랑권처럼 변해버릴 것 같다……
			PRINTW 
			PRINTFORML 「떠오르면 차가운 물에 담가줘. 자바아 하고」
			PRINTFORML 경단(団子)을 삶던 뜨거운 물이, 뭐라고 말할 수 없는 색으로 변해있다...
			PRINTFORML 두통이 온다... 메스꺼움까지 느껴져왔어...
			PRINTW 
			PRINTFORML 「그릇에 담고, 설탕 간장을 뿌리면 완성이야」
			PRINTFORML 「어라? %CALLNAME:MASTER%, 왜 구석에서 토하고 있는 거야?」
			PRINTW 
			CFLAG:1010 = 1
		ELSEIF STRCOUNT(DISH_TASTE, "練習")
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「%CALLNAME:MASTER%, 무리하지 않는 게 좋을걸?」
				PRINTFORML 「나의 몸을 통해서라도 괜찮지만, 수레란의 독을 그대로 다루는 거니까」
				PRINTW 
			ELSE
				PRINTFORML 「요리 정도에 기분이 나빠지다니, 인간은 약하다네, 수우 씨」
				PRINTFORML 지난번에는 요리라기보다는 해충 구제약을 만드는 기분이었다...
				PRINTW 
			ENDIF
			PRINTFORML 「음~ 그렇게 무리하지 마. 네 마음을 모르는 건 아닌데도」
			PRINTFORML 「완벽하게 재현하려고 생각하지 않으면, 얼마든지 타협해 버릴 수 있으니까 말이야, 이 요리는」
			PRINTW 
			PRINTFORML 「하지만, %MASTERNAME:42%는 완벽하게 재현하는 것에 신경 써주고 있잖아」
			PRINTFORML 「에헤헤, 역시 %MASTERNAME:42%에게 배우길 잘했나 봐♪」
			PRINTW 
		ELSE
			PRINTFORML 「또 만들어 보고 싶어졌어? 그치~♪」
			PRINTFORML 「기쁘거나 즐거운 일은, 몇 번을 해도 좋은 거거든♪」
			PRINTW 
			PRINTFORML 솔직히 저 폭발적일 정도의 단맛에는 아직 익숙지 않지만, 하타테의 최고의 미소는 볼 수 있다.
			PRINTFORML 요리사에게 더할 나위 없는 기쁨이지만…… 자신의 몫은 작게 만들기로 비밀리에 결심했다.
			PRINTW 
		ENDIF
	ELSE
		;料理下手orそもそも作ったことがない（霊夢など大半）
		IF ABL:TARGET:料理技能 == 0
			PRINTFORML 뒤쪽에서 「꺄아!」 같은 비명과 무언가를 요란하게 엎지르는 소리가 들려온다...
			PRINTW 
			;食べられるものは作れる（ex.魔理沙、デフォルトのアリス、る～こと、華扇など大半）
		ELSEIF ABL:TARGET:料理技能 == 1
			PRINTFORML 하타테는 신중하게 식재료를 자르고 있다
			PRINTFORML 다소 위태로워 보이는 점도 있지만, 맡겨도 괜찮을 것 같다
			PRINTW 
			;一般的に「料理ができる」と言われるレベル（ex.大妖精）
		ELSEIF ABL:TARGET:料理技能 == 2
			PRINTFORML 하타테는 리듬감 있게 밑재료 준비를 도와주고 있다.
			PRINTFORML 이것이라면 안심이다.
			PRINTW 
			;料理でメシが食っていけるレベル（ex.藍、妖夢、ミスティア、ヤマメ）
		ELSEIF ABL:TARGET:料理技能 == 3
			PRINTFORML 평소부터 요리하는 데 익숙한지, 하타테는 손놀림이 능숙했다.
			PRINTFORML 함부로 끼어들지 않는 편이 좋을 것이다.
			PRINTW 
			;絶品料理が作れるレベル（ex.該当なし？）
		ELSEIF ABL:TARGET:料理技能 == 4
			PRINTFORML 옆에서 지켜보고 있어도, 하타테의 손놀림은 굉장하다고 밖에 할 말이 없었다.
			PRINTFORML 나에게서 나올 말은 아무것도 없었다.
			PRINTW 
			;紅魔館に永久就職できるレベル（既存キャラでは最高クラス。ex.咲夜）
		ELSEIF ABL:TARGET:料理技能 == 5
			PRINTFORML 「하타테가 분신해서 보이는……!?」
			PRINTFORML 그녀의 주변만 시간의 흐름이 변하고 있는 것 같다
			PRINTW 
			;幻想郷の食を牛耳るもの（該当なし）
		ELSEIF ABL:TARGET:料理技能 >= 6
			PRINTFORML 「식재료가, 기뻐하고 있어……!?」
			PRINTFORML 하타테에 조리되어, 들릴 리 없는 식재료들의 환희의 목소리가 확실히 들렸다
			PRINTW 
		ENDIF
	ENDIF
ENDIF
