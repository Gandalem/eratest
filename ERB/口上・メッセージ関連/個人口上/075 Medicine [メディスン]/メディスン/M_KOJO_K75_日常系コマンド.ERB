						TALENT:TARGET:バストサイズ  = 1
					ELSEIF TALENT:TARGET:バストサイズ  == -1
						TALENT:TARGET:バストサイズ  = 0
					ELSEIF TALENT:TARGET:バストサイズ  == -2
						TALENT:TARGET:バストサイズ  = -1
					ENDIF
				ENDIF
				PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 생명력을 전환하여 메디슨의 몸을 만들어냈다...
				BASE:MASTER:体力 -= BASE:MASTER:体力 / 2
				BASE:MASTER:気力 -= BASE:MASTER:気力 / 2
				BASE:MASTER:精力 -= BASE:MASTER:精力 / 2
			ELSEIF RESULT == 1
				IF TALENT:TARGET:バストサイズ  == -2
					PRINTFORML 더는 작아질 수 없어……
					GOTO INPUT_OPPAI_SIZE
				ELSE
					PRINTFORML 메디슨의 가슴 사이즈가 한 단계 내려갔다...
					IF TALENT:TARGET:バストサイズ  == 2
						TALENT:TARGET:バストサイズ  = 1
					ELSEIF TALENT:TARGET:バストサイズ  == 1
						TALENT:TARGET:バストサイズ  = 0
					ELSEIF TALENT:TARGET:バストサイズ  == 0
						TALENT:TARGET:バストサイズ  = -1
					ELSEIF TALENT:TARGET:バストサイズ  == -1
						TALENT:TARGET:バストサイズ  = -2
					ENDIF
				ENDIF
				PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 생명력을 전환하여 메디슨의 몸을 만들어냈다...
				BASE:MASTER:体力 -= BASE:MASTER:体力 / 2
				BASE:MASTER:気力 -= BASE:MASTER:気力 / 2
				BASE:MASTER:精力 -= BASE:MASTER:精力 / 2
			ELSEIF RESULT == 2
				PRINTFORML 메디슨의 질을……
				CALL ASK_M("금세 허둥지둥하게 되도록", 1,"적당히 축축해지기 쉽다", 1,"젖지 않도록 유지한 채로", 1)
				SELECTCASE RESULT
					CASE 0
						PRINTFORML 메디슨의 질은 쉽게 젖게 되었다...
						TALENT:75:濡れやすさ = 1
					CASE 1
						PRINTFORML 메디슨의 질은 적당히 촉촉해지기 쉬워졌다...
						TALENT:75:濡れやすさ = 0
					CASE 2
						PRINTFORML 메디슨의 질이 마르기 쉬워졌다…
						TALENT:75:濡れやすさ = -1
				ENDSELECT
				PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 생명력을 전환하여 메디슨의 몸을 만들어냈다...
				BASE:MASTER:体力 -= BASE:MASTER:体力 / 2
				BASE:MASTER:気力 -= BASE:MASTER:気力 / 2
				BASE:MASTER:精力 -= BASE:MASTER:精力 / 2
			ELSEIF RESULT == 3
				PRINTFORML 어떤 귀에 들을래?
				CALL ASK_M("토끼 귀", 1,"강아지 귀", 1,"고양이 귀", 1)
				SELECTCASE RESULT
					CASE 0
						PRINTFORML 메디슨의 머리에 토끼 귀가 돋아났다...
						TALENT:75:動物耳 = 2
					CASE 1
						PRINTFORML 메디슨의 머리에 개 귀가 돋아났다...
						TALENT:75:動物耳 = 3
					CASE 2
						PRINTFORML 메디슨의 머리에 고양이 귀가 자라나왔다...
						TALENT:75:動物耳 = 4
				ENDSELECT
			ELSEIF RESULT == 4
				PRINTFORML 지금은 그만둬두자……
			ELSE
				GOTO INPUT_OPPAI_SIZE
			ENDIF
		ELSE
		ENDIF
	ENDIF
ENDIF
