;410,掃除
;FLAG:70(1=時間停止中
;TFLAG:193(0=見てるだけ 1=一緒に掃除)
;TFLAG:194(3=汚れ高 2=汚れ中 1=汚れ低 0=汚れ最小
;OUTROOF(CFLAG:現在位置)(野外掃除（冬は雪かき
;==================================================

@M_KOJO_MESSAGE_COM_K75_410
CALL M_KOJO_MESSAGE_COM_K75_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K75_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSE
		;屋外の掃除
		IF OUTROOF(CFLAG:TARGET:現在位置)
			;無明の丘
			IF CFLAG:TARGET:現在位置 == 436
				;汚れを見る
				SELECTCASE TFLAG:194
					CASE 2,3
						PRINTDATADL
							DATAFORM 「정말, 누가 더럽히고 있는 걸까」
							DATAFORM 「너무하다. 나만의 소중한 곳을 더럽히다니」
							DATAFORM 「더럽히는 녀석을 찾으면 혼내줄 테니까」
							DATAFORM 「스우 씨, 여기서 날뛰는 사람이 있어요」
							DATAFORM 메디슨은 아끼는 장소를 망가져 슬퍼하고 있다.
							DATAFORM 메디슨은 일터를 어지럽혀 화를 내고 있다.
						ENDDATA
						PRINTW 
					CASE 1,0
						PRINTDATADL
							DATAFORM 「여기는 깨끗해야지」
							DATAFORM 「그 돌邪魔이니까 치워버리자」
							DATAFORM 「여기가 깨끗해지면, 당신도 기쁘겠지?」
							DATAFORM 「%조사처리(CALLNAME:MASTER,"는")% 청소에 능하구나」
							DATAFORM 「수스 씨, 기뻐 보여. 다행이야」
							DATAFORM 메디슨은 아끼는 장소가 깨끗해진 것에 만족하는 듯하다
						ENDDATA
						PRINTW 
				ENDSELECT
			ELSE
				;冬は雪かき
				IF DAY:2 == 4
					;手伝ってくれる
					IF TFLAG:193 == 1
						;積雪量を見る
						SELECTCASE TFLAG:194
							CASE 2,3
								PRINTDATADL
									DATAFORM 「다 됐다! 눈사람」
									DATAFORM 「이쪽은 %CALLNAME:MASTER%. 이쪽은 나. 이게 수스 씨야」
									DATAFORM 「눈이라는 게 무거운 거구나……」
									DATAFORM 「도와줄 거야? 고마워」
									DATAFORM 메디슨은 부지런히 눈을 날라주고 있다
								ENDDATA
								PRINTW 
							CASE 1,0
								PRINTDATADL
									DATAFORM 「여기도 지나다닐 수 있게 돼서 다행이야」
									DATAFORM 「후우, 눈이 많이 쌓였네」
									DATAFORM 「여기가 깨끗해지면 당신도 기쁠 거잖아?」
									DATAFORM 「%CALLNAME:MASTER%손, 차가워지고 있어. 따뜻하게 해줘야겠어」
								ENDDATA
								PRINTW 
						ENDSELECT
						;見てるだけ
					ELSE
						;積雪量を見る
						SELECTCASE TFLAG:194
							CASE 2,3
								PRINTDATADL
									DATAFORM 「눈사람이 좋아, 니이…」
									DATAFORM 메디슨이 눈덩이를 던져 방해해 온다…
									DATAFORM 메디슨은 작은 눈사람을 잔뜩 만들며 놀고 있다…
									DATAFORM 「심심하아~」
									DATAFORM 「눈을 치지 않아도 하늘을 날면 되잖아. 응, 스우 씨」
								ENDDATA
								PRINTW 
							CASE 1,0
								PRINTDATADL
									DATAFORM 「드디어 걸을 수 있게 됐어」
									DATAFORM 메디슨이 길가에 치워둔 눈을 동그랗게 뭉쳐 이쪽으로 던져왔다.
									DATAFORM 「저렇게 많은 눈이 사라졌어!」
									DATAFORM 메디슨이 높이 쌓인 눈 위에서 뛰어놀고 있다.
								ENDDATA
								PRINTW 
						ENDSELECT
					ENDIF
					;通常の掃除
				ELSE
				ENDIF
			ENDIF
			;屋内
		ELSE
			;メディスンの家
			IF CFLAG:TARGET:現在位置 == 437
				;手伝ってくれる
				IF TFLAG:193 == 1
					;汚れを見る
					SELECTCASE TFLAG:194
						CASE 2,3
							PRINTDATADL
								DATAFORM 「저쪽은 보면 안 돼. 여자애들은 비밀이 많단 말이야」
								DATAFORM 「오늘은 우연히 이런 거야. 평소에는 훨씬 정돈되어 있어」
								DATAFORM 「그건 보물이니까 버리면 안 돼앳」
								DATAFORM 「둘이 하면 정리하는 게 빠르니까 좋네」
								DATAFORM 「나는 이쪽을 치고 있을 테니, %조사처리(CALLNAME:MASTER,"는")% 저쪽을 좀 치고 있어 줄래?」
							ENDDATA
							PRINTW 
						CASE 1,0
							PRINTDATADL
								DATAFORM 「예쁘지? 제대로 정리하고 있잖아」
								DATAFORM 「정리하고 있으니까 머리 쓰다듬어 줘도 괜찮다고 생각하는데」
								DATAFORM 집 안이 깨끗하다고 칭찬하자, 메디슨은 허리에 손을 얹고 가슴을 폈다.
								DATAFORM 「그렇게 지저분하지 않다고 생각해」
							ENDDATA
							PRINTW 
					ENDSELECT
					;見てるだけ
				ELSE
					;汚れを見る
					SELECTCASE TFLAG:194
						CASE 2,3
							PRINTDATADL
								DATAFORM 「시끄럽네. 치우면 되는 거 아니야? 다음에 할 테니까」
								DATAFORM 「그건 버려도 돼. 그건 버리지 마. 아, 저건……」
								DATAFORM 「빨리 정리해 줘~ 발 디딜 곳이 없잖아」
								DATAFORM 지저분한 모습에 어이가 되자 메디슨은 「우, 시끄럽네」라며 당황했다
								DATAFORM 「오늘은 우연히 어지러웠을 뿐이야. 평소엔 이렇지 않아」
								DATAFORM 「앗! 그거 돌려줘~!」
							ENDDATA
							PRINTW 
						CASE 1,0
							PRINTDATADL
								DATAFORM 「다음에부터 %조사처리(CALLNAME:MASTER,"를")% 우리 집 청소 담당으로 임명해 주겠어」
								DATAFORM 「잘했네. 칭찬해 주지」
								DATAFORM 「%CALLNAME:MASTER%, 해낼 수 있잖아」
								DATAFORM 메디슨은 창틀을 손가락으로 쓸어 먼지가 없는 것을 보고 만족스럽게 고개를 끄덕이고 있다
							ENDDATA
							PRINTW 
					ENDSELECT
				ENDIF
				;メディスンの家以外の屋内
			ELSE
				SELECTCASE TFLAG:194
					CASE 2,3
						PRINTDATADL
							DATAFORM 「우와아. 지저분하네……」
							DATAFORM 「에엥, 여기 치우는 거야~?」
							DATAFORM 「빨리 좀 치워줘. 발 디딜 데가 없잖아」
						ENDDATA
						PRINTW 
					CASE 1,0
						PRINTDATADL
							DATAFORM 「여기 주인도 기뻐하지 않을까?」
							DATAFORM 「역시 깨끗한 게 최고야」
							DATAFORM 「이 정도면 충분하지 않을까아」
						ENDDATA
						PRINTW 
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
