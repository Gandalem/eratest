; Modular ERB: 個人口上/075 Medicine [メディスン]/メディスン/M_KOJO_K75_ユーザー関数.ERB
;本関数はM_KOJO_K33諏訪子口上のユーザー関数を基に作成しました
;**** FlagManagement **********************************************************
;本口上にて使用しているCFLAG・TCVAR等
;TCVAR:360　その日の毒カウンター回数
;CFLAG:1001　デート回数
;CFLAG:1002　あいさつに関する進行度
;CFLAG:1003　おちんちんを見たか
;CFLAG:1004　クリトリスの存在
;CFLAG:1005　ヴァギナの存在
;CFLAG:1006　アナルの存在
;CFLAG:1007　精液名づけ
;CFLAG:1010　固有料理（鈴蘭団子）初めて
;CFLAG:1111　UPDATE判定
;CFLAG:1112　UPDATE判定（性器の名称）
;CFLAG:1222　メディスン改造段階 2= 紫  3=永琳 4=青娥 5=アリス
;CFLAG:1301　毒を喰らわせた総回数
;CFLAG:1302　睡姦毒を喰らわせた総回数
;CFLAG:1303　通常時の毒を喰らわせた総回数
;******************************************************************************
;-----------------------------------------------------------
;毒カウンターの制御用関数（メディスン専用）
;ARG:0 ループ回数（接触が濃厚なほど回数を増す）
;-----------------------------------------------------------

@K75_POISON_COUNTER(ARG:0)
#DIM 減少値
IF TALENT:75:恋慕
	減少値 = -35
ELSEIF TALENT:75:思慕
	減少値 = -75
ELSE
	減少値 = -100
ENDIF
SELECTCASE MARK:75:反発刻印
	CASE 1
		減少値 -= 20
	CASE 2
		減少値 -= 40
	CASE 3
		減少値 -= 60
ENDSELECT
SELECTCASE CFLAG:75:好感度
	CASE IS >= 10000
		減少値 += 10
	CASE IS >= 5000
		減少値 += 7
	CASE IS >= 3000
		減少値 += 5
	CASE IS >= 1000
		減少値 += 3
	CASE IS >= 500
		減少値 += 1
ENDSELECT
SELECTCASE CFLAG:75:信頼度
	CASE IS >= 5000
		減少値 += 15
	CASE IS >= 3000
		減少値 += 12
	CASE IS >= 2000
		減少値 += 10
	CASE IS >= 1000
		減少値 += 5
	CASE IS >= 500
		減少値 += 3
ENDSELECT
SELECTCASE EXP:75:愛情経験
	CASE IS >= 1000
		減少値 += 20
	CASE IS >= 500
		減少値 += 15
	CASE IS >= 200
		減少値 += 10
	CASE IS >= 100
		減少値 += 5
ENDSELECT
SELECTCASE EXP:75:デート経験
	CASE IS >= 1000
		減少値 += 5
	CASE IS >= 500
		減少値 += 3
	CASE IS >= 200
		減少値 += 2
	CASE IS >= 100
		減少値 += 1
ENDSELECT
SIF TALENT:75:機嫌 == -1
	減少値 -= 50
SIF CFLAG:75:ブチギレ
	減少値 -= 50
;√累計回数の補正
SIF CFLAG:75:1301 || CFLAG:75:1302 || CFLAG:75:1303
	減少値 += CBRT(CFLAG:75:1301 + CFLAG:75:1302 + CFLAG:75:1303)
;恋人の場合は、一律ゼロに補正／プラス値のときも補正
SIF TALENT:75:恋人
	減少値 = 0
SIF 減少値 > 0
	減少値 = 0
IF 減少値 < 0
	SELECTCASE TCVAR:75:360
		CASE 0
			;最初回の説明用テキスト（総毒カウンターがゼロの時）
			IF !CFLAG:75:1301 && !CFLAG:75:1302 && !CFLAG:75:1303
				IF FLAG:70
					PRINTFORML 메디슨은 %조사처리(CALLNAME:MASTER,"의")% 능력 앞에 꿈쩍도 하지 않는다.
					PRINTFORML 시간이 멈춘 상태라면, 여러 가지로 몸을 조사할 수 있을 것이다.
					PRINTW 
				ELSEIF CFLAG:睡眠
					PRINTFORML 메디슨은 천사 같은 잠든 얼굴을 하고 있다.
					PRINTW 
				ELSE
					PRINTFORML 언뜻 보기에는 메디슨이 무해한 인형처럼 보이지만...
				ENDIF
				PRINTFORMW 조금 긴장하며 메디슨의 몸에 살짝 손을 대 보았다
				PRINTL 
				PRINTFORML 두근.
				PRINTW 
				PRINTFORML 만진 부분이 마치 화상을 입은 듯한 통증을 느낀다.
				PRINTFORML 이것이 메디슨의 독인가….
				PRINTW 
				PRINTFORML 오래 만지고 있으면 생명에 지장이 있을지도 몰라.
				PRINTFORML 뭔가, 독을 진정시킬 좋은 방법은 없을까...
				PRINTW 
			ELSE
				SETCOLOR 0xA4A8D4
				IF (TALENT:75:恋慕 || TALENT:75:恋人) && TALENT:75:SexKnow > -1
					PRINTFORML 두근거려……
				ELSE
					PRINTFORML 만진 부분이 부은 것 같아……
				ENDIF
			ENDIF
		CASE 1 TO 10
			SETCOLOR 0x4D4398
			IF (TALENT:75:恋慕 || TALENT:75:恋人) && TALENT:75:SexKnow > -1
				PRINTFORML 맥박이 이상해, 하반신이 뜨거워……
			ELSE
				PRINTFORML 화상 같은 통증이 몸을 괴롭는다...
			ENDIF
		CASE 11 TO 30
			SETCOLOR 0x56256E
			IF (TALENT:75:恋慕 || TALENT:75:恋人) && TALENT:75:SexKnow > -1
				PRINTFORML 생각에 안개가 끼는 것 같아, 메디슨을 안고 싶어서 견딜 수가 없어...
			ELSE
				PRINTFORML 코에서 미끌거리는 감촉. 만져보니 피가 흘러 나오고 있었다...
			ENDIF
			減少値 -= SQRT(TCVAR:75:360)
		CASEELSE
			SETCOLOR 0x47266E
			IF (TALENT:75:恋慕 || TALENT:75:恋人) && TALENT:75:SexKnow > -1
				PRINTFORML 하반신이 폭발할 것만 같아……
			ELSE
				PRINTFORML 숨쉬기가 힘들어…… 손이 떨려……
			ENDIF
			減少値 -= 2 * SQRT(TCVAR:75:360)
	ENDSELECT
	RESETCOLOR
	CALL K75_POISON_MAIN(ARG:0, 減少値)
ENDIF
;-----------------------------------------------------------
;毒システムの減算実行関数（メディスン専用）
;ARG:0 ループ回数（接触が濃厚なほど回数を増す、コマンド毎に指定）
;ARG:1 減少値、負の値を入れる
;-----------------------------------------------------------

@K75_POISON_MAIN(ARG:0, ARG:1)
#DIM ループ回数
ループ回数 = 0
$POISON_LOOP
;TSPを必ず削る
;CALL BUFF_BASE(MASTER, BASE_TSP, ARG:1, 0)
SELECTCASE RAND:3
	CASE 0
		CALL BUFF_BASE(MASTER, BASE_体力, ARG:1, 0)
	CASE 1
		CALL BUFF_BASE(MASTER, BASE_気力, ARG:1, 0)
	CASEELSE
		IF GETBIT(TALENT:MASTER:性別, 1)
			CALL BUFF_BASE(MASTER, BASE_精力, (ARG:1 / 2) , 0)
		ENDIF
ENDSELECT
ループ回数 ++
;周回数が指定された回数以下ならループ
SIF ループ回数 < ARG:0
	GOTO POISON_LOOP
;本日の毒回数に加算（ループ回数に関わらず１回のカウント）
TCVAR:75:360 ++
;時姦、睡姦それぞれの毒総カウントに加算
IF FLAG:70
	CFLAG:75:1301 ++
ELSEIF CFLAG:睡眠
	CFLAG:75:1302 ++
ELSE
	CFLAG:75:1303 ++
ENDIF
