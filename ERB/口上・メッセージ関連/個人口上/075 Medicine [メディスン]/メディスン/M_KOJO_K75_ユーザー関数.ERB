@PENIS_NAME_SET_K75
PRINTL 의사가 남성 성기를 뭐라고 부르길 원하십니까? 입력해 주세요.
LOCALS = penis
PRINTBUTTON @"[그대로 부른다 (%CAPITALIZE(LOCALS)%)]", @"%LOCALS%"
PRINTL 　
;名前を入力するループ
$INPUT_LOOP_PONAMAE
INPUTS
; 行頭行尾の空白文字削除
LOCALS = %RESULTS%
REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
;20文字以上は受け付けない
IF STRLENS(LOCALS) > 20
	CLEARLINE 1
	REUSELASTLINE 「How am I supposed to remember a name that long?」
	GOTO INPUT_LOOP_PONAMAE
	;空白は受け付けない
ELSEIF RESULTS == ""
	PRINTL 무언가를 입력해야 한다.
	GOTO INPUT_LOOP_PONAMAE
ELSE
	; 同姓同名
	IF FLAG:なりきり != 75 && STRCOUNT(LOCALS, "メディスン|Medicine|medicine")
		PRINTFORML 「오, 그게 내 이름이랑 같은 건가요?」
	ELSE
		PRINTFORML 「%CAPITALIZE(RESULTS)%, 그럼?」
	ENDIF
	CALL ASK_YN
	IF RESULT == 0
		;チンコの名称を%CSTR:75:80%に格納
		CSTR:75:80 = %RESULTS%
		PRINTFORML 
	ELSE
		PRINTL 이름을 입력하세요.
		GOTO INPUT_LOOP_PONAMAE
	ENDIF
ENDIF
