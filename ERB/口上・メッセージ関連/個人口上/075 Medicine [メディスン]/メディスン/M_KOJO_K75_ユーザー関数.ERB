	PRINTL 무언가를 입력해야 한다.
	GOTO INPUT_LOOP_OMANKOONAMAE
ELSE
	; 同姓同名
	IF FLAG:なりきり != 75 && STRCOUNT(LOCALS, "メディスン|Medicine|medicine")
		PRINTFORML 「오, 그게 내 이름이랑 같은 건가요?」
	ELSE
		PRINTFORML 「%CAPITALIZE(RESULTS)%, 그럼?」
	ENDIF
	CALL ASK_YN
	IF RESULT == 0
		;精液の名称を%CSTR:75:82%に格納
		CSTR:75:82 = %RESULTS%
		PRINTFORML 
	ELSE
		PRINTL 이름을 입력하세요.
		GOTO INPUT_LOOP_OMANKOONAMAE
	ENDIF
