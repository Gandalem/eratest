$INPUT_LOOP_OMANKOONAMAE
INPUTS
; 行頭行尾の空白文字削除
LOCALS = %RESULTS%
REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
;20文字以上は受け付けない
IF STRLENS(LOCALS) > 20
	CLEARLINE 1
	REUSELASTLINE 「How am I supposed to remember a name that long?」
	GOTO INPUT_LOOP_OMANKOONAMAE
	;空白は受け付けない
