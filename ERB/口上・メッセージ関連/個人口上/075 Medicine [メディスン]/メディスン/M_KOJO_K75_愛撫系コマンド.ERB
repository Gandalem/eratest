@M_KOJO_MESSAGE_COM_K75_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL K75_POISON_COUNTER(2)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:75:人形 == 99
			IF TALENT:恋慕 || TALENT:恋人
				IF TALENT:SexKnow == -1
					PRINTFORML 메디슨의 도자기 같은 하얀 피부를 쓰다듬었다.
					PRINTFORML 메디슨은 신기한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 호의를 바라보고 있다.
					PRINTW 
					PRINTFORML 「그건, 무슨 목적으로 하는 거야?」
					PRINTFORML 「싫지는 않아. 다만 이유를 몰랐을 뿐이야」
					PRINTW 
					PRINTFORML 메디슨에게, 이것은 남녀가 사이를 깊게 하는 행위라고 가르쳐 준다.
					PRINTFORML 메디슨은 일단 이해한다는 듯 보였지만, 당혹스러워하는 것 같다.
					PRINTW 
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")%, 나를 소중하게 생각해 주고 있다는 건 알았어」
					PRINTFORML 「나도, %조사처리(CALLNAME:MASTER,"의")% 피부에 많이 만져봐도 되는 거야」
					PRINTW 
					PRINTFORML 메디슨도 %조사처리(CALLNAME:MASTER,"를")% 본떠서 가슴팍을 더듬어 왔다.
					PRINTFORML 손길은 서툴렀지만, 애정을 되돌려 주고 있는 것은 틀림없다.
					PRINTW 
					PRINTFORML 「%CALLNAME:MASTER%, 나한테 더 만져줘. 나도, %조사처리(CALLNAME:MASTER,"에게")% 더 닿고 싶어」
					PRINTFORML 메디슨은 두 팔을 벌리고 미소 지었다…
				ELSE
					PRINTFORML 「당신이 만지는 방식, 좋아. 정말 다정해서」
					PRINTFORML 메디슨의 말투는 매우 온화하다
					PRINTW 
					PRINTFORML 진정한 의미의 기분 좋은 건 아닌 것 같지만…
					PRINTFORML 　당신이 만지는 곳은 따뜻하고, 제 가슴 깊은 곳에서 무언가가 넘쳐흐를 것 같아요.
					PRINTW 
					PRINTFORML 「분명, 그게 인형인 나에게 있어 '기분 좋은' 거겠지……」
					PRINTFORML 「아니면 %조사처리(CALLNAME:MASTER,"는")% 다른 반응을 보고 싶었던 걸까. 그렇다면 미안해」
					PRINTW 
					CALL ASK_YN("신경 쓸 필요는 없다.","포기하기엔 아직 이르다")
					IF !RESULT
						PRINTFORML 시선을 떨구는 메디슨의 머리를 부드럽게 쓰다듬고, 뺨에 입을 맞춘다.
						PRINTFORML 메디슨이 어떻게 반응했는지보다는 자신이 느낀 감정을 소중히 하고 싶다고 고백한다.
						PRINTW 
						PRINTFORML 「고마워, %CALLNAME:MASTER%」
						PRINTFORML 「『기쁘다』『따뜻하다』『좋아해』『더 만져줬으면 해』」
						PRINTFORML 「당신이 손을 대주는 것만으로도 이렇게 마음이 움직이는 거야」
						PRINTFORML 「이것도, 하나의 섹스 아닐까나」
						PRINTW 
						PRINTFORML 어린아이 같은 체형의 메디슨에게서 '섹스'라는 생생한 말이 터져 나오는 것에 가슴이 두근거린다.
						PRINTFORML 사람과 똑같은 반응을 하지 않더라도, 그녀 나름으로 이것을 섹스로 받아들여 주고 있는 것 같다.
						PRINTW 
						PRINTFORML 그렇다면, 우리 둘만의 방식으로 사랑하는 법을 찾아가 보자.
						PRINTFORML 그렇게 생각하며, 메디슨에게 정성스러운 애무를 이어갔다...
						PRINTW 
					ELSE
						PRINTFORML 인형이라도 기분 좋아질 수 있는 방법이 있을 거잖아
						PRINTFORML 게다가 이렇게 계속 사랑해주면, 변화가 올지도 몰라
						PRINTW 
						PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 말에는 응하지 않고, 메디슨은 살짝 미소 지을 뿐이었다.
						PRINTW 
					ENDIF
				ENDIF
			ELSE
				IF TALENT:SexKnow == -1
					PRINTFORML 메디슨의 도자기 같은 하얀 피부를 쓰다듬었다.
					PRINTFORML 메디슨은 신기한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 호의를 바라보고 있다.
					PRINTW 
					PRINTFORML 「게다가, 도대체 무슨 의미가 있는 거야?」
					PRINTFORML 「사람에게 만져지는 건 별로 기분 좋지 않아」
					PRINTW 
					PRINTFORML 메디슨에게, 이것은 남녀가 가까워지기 위한 행위라고 가르쳐 주겠다.
					PRINTFORML 하지만 메디슨은 언어의 의미는 이해해도 납득하지 못하는 듯하다.
					PRINTW 
					PRINTFORML 「이런 걸로, 나와 당신이 사이좋아질 수 있다는 거야?」
					PRINTFORML 실제로 만져보고 어땠는지 물어본다.
					IF CFLAG:75:信頼度 >= 500
						PRINTFORML 「그런 건 몰라」
						PRINTFORML 메디슨은 고개를 돌려버렸다
					ELSE
						PRINTFORML 「지렁이한테 기어 다니는 게 나을 것 같아」
						PRINTFORML 매서운 평가를 받아버렸다……
					ENDIF
					PRINTW 
				ELSE
					PRINTFORML 「인간은, 인형에게도 욕정을 느끼는 거야?」
					PRINTFORML 「아니면, 너뿐일까. 있잖아, 변태 씨」
					PRINTW 
					PRINTFORML 메디슨은 행위의 의미를 이해하고 있다.
					PRINTFORML 그 위에서, 나를 도발하고 있는 것 같다.
					PRINTW 
					PRINTFORML 그런 메디슨을 귀엽게 울리고 싶어서 집요하게 애무한다.
					PRINTFORML 「그런 걸로는, 인형인 나의 몸은 기분 좋게 할 수 없잖아」
					PRINTW 
					PRINTFORML 「더. 더 당신의 더럽고, 비참하고, 일편단심인 마음을 부딪쳐 줘」
					PRINTFORML 「인간의 욕망 전부 알고 싶어」
					PRINTW 
				ENDIF
			ENDIF
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:恋人
		;人形の乙女
		IF TALENT:75:人形 == 99
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 손이 따뜻해……」
				CASE 1
				CASE 2
				CASE 3
					PRINTDATADL
						DATAFORM 「%CALLNAME:MASTER%손, 따뜻해」
						DATAFORM 「기분 좋아 보이는 얼굴네」
						DATAFORM 「싫지는 않아. 그저 지루했을 뿐이야」
						DATAFORM 「나도 기뻐 보여? 그래, 그런 거야?」
						DATAFORM 「당신 정도는 그렇겠지. 나에게 이런 걸 해달라고 바라는 건」
						DATAFORM 「네네, 늘 하던 대로야」
						DATAFORM 「당신을 기쁘게 하는 것도 싫지 않게 되어 왔어」
					ENDDATA
			ENDSELECT
		ELSE
		ENDIF
		RETURN 1
	ELSE
		;人形の乙女
		IF TALENT:75:人形 == 99
		ELSE
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
