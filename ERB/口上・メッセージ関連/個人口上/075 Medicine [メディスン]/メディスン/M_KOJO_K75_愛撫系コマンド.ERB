;愛撫系コマンドソース処理
;毒人形時は絶頂を迎えない
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;愛撫

@M_KOJO_EXTRASOURCE_COM_K75_0
IF TALENT:75:人形 == 99
	SOURCE:75:快Ｃ = 0
	SOURCE:75:快Ｂ = 0
	SOURCE:75:情愛 = 100
ENDIF
;クンニ

@M_KOJO_EXTRASOURCE_COM_K75_1
IF TALENT:75:人形 == 99
	SOURCE:75:快Ｃ = 0
ENDIF
;指挿れ、アナル舐め、アナル愛撫は毒人形時は実行不可
;胸愛撫

@M_KOJO_EXTRASOURCE_COM_K75_6
IF TALENT:75:人形 == 99
	SOURCE:75:快Ｂ = 0
ENDIF
;乳首責め

@M_KOJO_EXTRASOURCE_COM_K75_7
IF TALENT:75:人形 == 99
	SOURCE:75:快Ｂ = 0
ENDIF
;乳首吸い

@M_KOJO_EXTRASOURCE_COM_K75_10
IF TALENT:75:人形 == 99
	SOURCE:75:快Ｂ = 0
ENDIF
;胸揉み

@M_KOJO_EXTRASOURCE_COM_K75_12
IF TALENT:75:人形 == 99
	SOURCE:75:快Ｂ = 0
ENDIF
;キス
;例外的に快Ｍのソースがほぼ倍増。ランダムで愛情経験が手に入る
;じゃあ同様に最初からついてる乳首はどうなんだって話ですが、そこは作者の好みということで…

@M_KOJO_EXTRASOURCE_COM_K75_20
IF TALENT:75:人形 == 99
	SOURCE:快Ｍ = ABL:PLAYER:舌 * 6 + 20
	;時間停止中は駄目
	IF FLAG:70
	ELSE
		IF !RAND:3 == 0
			CALL AddEXP("愛情経験", TARGET, 1)
		ENDIF
	ENDIF
ENDIF
