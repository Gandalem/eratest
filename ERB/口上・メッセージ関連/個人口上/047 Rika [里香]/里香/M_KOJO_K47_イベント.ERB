			PRINTFORMDW 「Oh, %CALLNAME:MASTER%... fancy meeting you here.」
		ELSE
			PRINTFORMDW Rika enters the area, pretty much ignoring everyone around while looking at some papers.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		IF CFLAG:318 == 1
			PRINTFORMDW Rika grumbles something and gets in the bath.
		ELSEIF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%, let's bathe together.」
			PRINTFORMDW Rika gets close to you, completely naked with a happy smile.
		ELSEIF TALENT:恋慕
			PRINTFORML 「Well, since you're here, I'd be a fool to not take this chance..」
			PRINTFORMDW Rika hesitates a bit, before she reveals her body and sits near you.
		ELSEIF TALENT:愛欲
			PRINTFORML 「What a *coincidence* meeting you here, %CALLNAME:MASTER%...」
			PRINTFORMDW Rika makes no effort to hide herself as she places herself as close to you as she can.
			PRINTFORMDW You're sure you saw a Bakebake just a few minutes ago...
		ELSEIF TALENT:思慕
			PRINTFORML 「Coming in.」
			PRINTFORMDW Rika doesn't seem bothered by your presence, and casually enters the bath.
		ELSEIF TALENT:セフレ
			PRINTFORMDW Rika notices you in the bath, and blushes as she gets in near you.
			PRINTFORMDW 「Not the worst surprise I've had.」
		ELSE
			PRINTFORML 「So few men in Gensokyo, you forget this is a mixed bath...」
			PRINTFORMDW Rika grumbles to herself but gets in the bath anyway, hiding her body.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		IF CFLAG:318 == 1
			PRINTFORML 「Really...」
			PRINTFORMDW Rika complains when she sees you, and then leaves.
		ELSEIF TALENT:恋人
			PRINTFORML 「Hmm, I think I'll wait.」
			PRINTFORMDW Rika leaves with a small smile.
		ELSEIF TALENT:恋慕
			PRINTFORML 「Uh... I'll wait for you to finish!」
			PRINTFORMDW Rika leaves, but not before her eyes linger on you for a few moments.
		ELSEIF TALENT:思慕
			PRINTFORML 「Ah, you're here...」
			PRINTFORMDW Rika blushes before turning and rushing out.
		ELSE
			PRINTFORMDW Rika lets out a surprised yelp, clutches her towel, tightly and leaves.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
