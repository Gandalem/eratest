@M_KOJO_CHECK_K47_SNOWMAN(ARGS,ARG,ARG:1)
#DIM SNOWMAN_TYPE
LOCAL = 30
IF !FA17_OBJ:(ARG % 100)
	SNOWMAN_TYPE = RAND:10
ELSE
	SNOWMAN_TYPE = FA17_TYPE:(ARG % 100)
ENDIF
SELECTCASE SNOWMAN_TYPE
	CASE 0 TO 4
		RESULTS = snow tank
		RESULTS:1 = constructed with expert precision
		LOCAL = 60
	CASE 5 TO 6
		RESULTS = snow Bakebake
		RESULTS:1 = sticking a tongue out and winking
		LOCAL = 30
	CASE 7 TO 8
		RESULTS = snow Evil Eye
		RESULTS:1 = staring lifelessly at you
		LOCAL = 30
	CASE 9
		RESULTS = snow Evil Eye Sigma
		RESULTS:1 = floating there, menacingly
		LOCAL = 100
ENDSELECT
RETURN LOCAL, SNOWMAN_TYPE
