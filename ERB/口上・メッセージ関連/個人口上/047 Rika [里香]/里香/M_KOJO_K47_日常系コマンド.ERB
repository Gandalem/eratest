;==================================================
;605,寄り道する
;TFLAG:193(1=大成功 0=成功 -1=失敗)(地の文無し
;==================================================

@M_KOJO_MESSAGE_COM_K47_605
;寄り道するにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K47_605_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K47_605_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K47
	PRINTFORMD 당신과 %조사처리(CALLNAME:TARGET,"는")% 간다 
	SELECTCASE CFLAG:MASTER:現在位置
		CASE 商家町
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMD 한 식당
				CASE 2
					PRINTFORMD 소바 가게
				CASEELSE
					PRINTFORMD 식당
			ENDSELECT
		CASE 竹林入り口
			PRINTFORMDL 미스티아의 자리에 앉아 장어 요리를 좀 먹는다.
			GOTO JUMP
		CASE 中有の道
			PRINTFORMD 근처 음식 가판대
		CASE 旧地獄街道
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMD 지옥의 찻집
				CASE 2
					PRINTFORMD 요괴의 다실
				CASEELSE
					PRINTFORMD 지옥의 레스토랑
			ENDSELECT
	ENDSELECT
	SELECTCASE TIME
		CASE 240 TO 599
			PRINTFORMDL 그리고 아침을 먹는다.
		CASE 600 TO 839
			PRINTFORMDL 그리고 점심을 먹는다.
		CASE 840 TO 1019
			PRINTFORMDL 그리고 늦은 점심을 먹는다.
		CASE 1020 TO 1199
			PRINTFORMDL 그리고 저녁을 먹는다.
		CASE 1200 TO 1440
			PRINTFORMDL 그리고 늦은 저녁을 먹는다.
		CASEELSE
			PRINTFORMDL 그리고 저녁 식사를 한다.
	ENDSELECT
	$JUMP
	PRINTW 
	PRINTFORML 「오? 음식? 내가 요리할 필요도 없고? 돈을 낼 필요도 없는 건가? 뭐, 거절하는 건 바보짓이지!」
	PRINTL 
	IF TFLAG:SELECTCOMの分岐 == 1
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 식사 후 상당히 만족해 보인다.
	ELSEIF TFLAG:SELECTCOMの分岐 == -1
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 초기 흥분에도 불구하고 식사를 끝내지 못했다.
	ENDIF
ENDIF
RETURN 1
