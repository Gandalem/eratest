@M_KOJO_MESSAGE_COM_K47_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「파이즈리?!」
			PRINTFORMW 리카는 자신의 가슴을 내려다본다. 그녀는 당신에게 시선을 돌린다. 다시 아래를 본다.
			PRINTFORMW 「어떻게?! 내가 납작한 벌레처럼 평평하다는 걸 당신도 알 거 아니야!」
			PRINTFORMDW 리카는 당신의 애원하는 얼굴을 바라본 다음, 존재하지 않는 가슴으로 시선을 돌린다.
			PRINTFORMW 「형편없다고 불평하지 마.」
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORML 「이게 나를 향한 농담 같은 느낌이지만, 일단 맞춰주려고 한다.」
			PRINTFORMDW 리카는 당신에게 몸을 비비려 애쓰며 약간 투덜거렸다.
		ELSEIF RAND:2 == 0
			PRINTFORMDL 리카는 기본적으로 당신의 샤프트 위에 누워 상체를 그것에 비비고 있다.
		ELSE
			PRINTFORMDL 너는 네 성기를 리카의 평평한 가슴에 비볐다.
			PRINTFORMDW 그녀는 자신의 가슴을 서로 맞추려 했지만... 이것으로는 아무것도 이루지 못했다.
		ENDIF
	ELSEIF TALENT:愛欲
		IF RAND:3 == 0
			PRINTFORMDL 리카는 옆으로 누워 당신의 성기를 위아래로 양쪽 단단한 유두를 문지른다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「이것들로 나조차 할 수 있어!」
			PRINTFORMDW 리카는 자신의 딱딱한 유두 중 하나로 당신의 성기를 간지럽히기 시작하며 자랑스러워하는 듯하다.
		ELSE
			PRINTFORMDW 엔지니어는 침으로 유두에 윤활을 하고, 그것을 당신의 귀두에 문지른다.
			PRINTFORML 「이 미끌거리는 간지러움은 어떤 느낌이야? 나한테는 기분이 좋아...」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMDL 리카는 한숨을 쉬며 자신의 가슴으로... 무엇이든 하려고 노력한다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「내가 자기를 당황하게 하는 게 만족스러워?」
			PRINTFORMDW 리카는 타이틀잡을 시도하며 입술을 삐죽 내민다.
		ELSE
			PRINTFORML 「이게 날 가지고 노는 무슨 전희인가?」
			PRINTFORMDW 리카는 패배감에 한숨을 쉬며 어쨌든 시도한다.
		ENDIF
	ELSEIF TALENT:セフレ
		IF RAND:3 == 0
			PRINTFORMDL  리카가 당신에게 가슴을 만져주려고 하지만 힘들어할 때 실망한 표정을 짓는다.
		ELSEIF RAND:2 == 0
			PRINTFORML 「나... 도구가 없어! 망치가 필요한데 렌치를 쓰고 있잖아!」
			PRINTFORMDW 리카는 자신의 신체적 부족함에 대해 불평한다.
		ELSE
			PRINTFORML 「이것들로 내가 할 수 있는 일이 있어야 하는데...」
			PRINTFORMDW 소녀는 당신의 명령을 수행하지 못하는 자신의 무능함에 좌절한 표정을 짓는다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
