@M_KOJO_MESSAGE_COM_K47_71
CALL M_KOJO_MESSAGE_COM_K47_71_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K47_71_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;考えうる分岐が多すぎるので地の文の大まかな分岐だけ
	;連続
	IF PREVCOM == SELECTCOM
		PRINTFORMW 
		RETURN 1
		;主人V挿入→助手A挿入
	ELSEIF TCVAR:100 == MASTER
		PRINTFORMW 
		RETURN 1
		;主人A挿入→助手V挿入
	ELSEIF TCVAR:101 == MASTER
		PRINTFORMW 
		RETURN 1
		;助手V挿入→主人A挿入
	ELSEIF TCVAR:100 == ASSI
		PRINTFORMW 
		RETURN 1
		;助手A挿入→主人V挿入
	ELSEIF TCVAR:101 == ASSI
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;72,挿入Ｇスポット責め
;==================================================

@M_KOJO_MESSAGE_COM_K47_72
CALL M_KOJO_MESSAGE_COM_K47_72_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K47_72_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW
			PRINTFORMW
		ELSE
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORMDW 엔지니어는 당신이 그녀의 G스팟을 자극하자 날카로운 신음을 흘린다.
		ELSE
			PRINTFORML 「으윽... 저 곳이 정말... 아... 민감하네!」
		ENDIF
	ELSEIF TALENT:愛欲
		IF RAND:2 == 0
			PRINTFORML 「그래, 바로 거기야! 그게 불꽃 스위치야!」
			PRINTFORMDL 리카가 기쁨에 소리를 지른다.
		ELSE
			PRINTFORMDW 리카는 당신이 그녀의 민감한 지점을 건드리자 몸을 굳히며 만족스러운 신음을 내뱉는다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:2 == 0
			PRINTFORML 「이게 뭐야... 이 지점은 대체 뭐지... 아앗!」
			PRINTFORMDW 리카는 당신이 자극하자 거의 압도당한 듯한 소리를 냈다.
		ELSE
			PRINTFORML 「아니... 거기 아니야... 안 돼... 터질 것 같아...」
			PRINTFORMDW 리카는 숨을 들이쉬며 손에 힘을 주고, 그 쾌감을 버티려 했다.
		ENDIF
	ELSEIF TALENT:セフレ
		IF RAND:2 == 0
			PRINTFORMDW 리카는 당신이 그녀의 G스팟을 건드리자 기쁜 소리를 낸다.
		ELSE
			PRINTFORMDW 리카의 눈이 잠시 초점을 잃었다가 더 강렬해진다.
			PRINTFORML 「네가 방금 한 거 뭐든... 더 해줘... 더...」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
