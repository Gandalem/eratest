;73,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_COM_K47_73
CALL M_KOJO_MESSAGE_COM_K47_73_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K47_73_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
		IF TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORMDW 리카는 불편함에 이를 악물지만 동시에 행복해 보인다.
			ELSE
				PRINTFORML 「더 이상은 정말 나를 부술지도 몰라... 거기서 사정해줘...」
			ENDIF
		ELSEIF TALENT:愛欲
			IF RAND:2 == 0
				PRINTFORML 「당신의 연료 노즐이 내 탱크에 딱 붙었어... 채워줘, 채워줘!」
				PRINTFORMDL 리카는 황홀경 속에서 당신의 정액을 간절히 원한다.
			ELSE
				PRINTFORMDW 리카의 표정은 취한 듯한 쾌락과 고통이 뒤섞여 보인다.
			ENDIF
		ELSEIF TALENT:思慕
			IF RAND:2 == 0
				PRINTFORML 「아파요... 너무 깊이 들어와요! 제발, 거기까지만 해줘! 당신은 치고 있어요... 아!」
				PRINTFORMDW 그녀가 항의하는 와중에도, 목소리에는 어느 정도의 쾌감이 느껴진다.
			ELSE
				PRINTFORML 「적어도 좀 더... 부드럽게 해줄 수 있겠어...? 나 망가질 거야!」
				PRINTFORMDW 리카는 진심으로 걱정하는 듯하지만, 동시에 약간 행복해하는 소리도 난다.
			ENDIF
		ELSEIF TALENT:セフレ
			IF RAND:2 == 0
				PRINTFORMDW 리카는 고통의 비명을 지르다가 당신이 조금 물러서자 작은 신음으로 바꾼다.
			ELSE
				PRINTFORMDW 리카는 쾌감 속에서 미소 짓고 있음에도 고통으로 눈물이 글썽였다.
				PRINTFORML 「다시는 그럴 때 나한테 미리 경고 좀 해줘...」
			ENDIF
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
ENDIF
