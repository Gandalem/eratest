;==================================================
;181,媚薬,
;==================================================

@M_KOJO_MESSAGE_COM_K105_181
CALL M_KOJO_MESSAGE_COM_K105_181_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_181_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;こういうのが好き、というのがあるんだけど上手いこと書けてる気がまったくしない
IF LOCAL
	IF TCVAR:泥酔 == 1
		PRINTFORML 
	ELSEIF CFLAG:うふふ
		IF FIRSTTIME("うふふ中媚薬")
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「미약이네…… 찾아보면 여러 가지 나올 것 같긴 하지만, 정말 효과가 있는 거야?」
				PRINTFORML 「겨우 혈행이 좋아진 정도 같은 거 아니야.」
				PRINTFORMW 「효과가 없더라도 내 잘못은 아니니까 말이야.」
				PRINTFORML 
				PRINTFORML 「음……」
				PRINTFORMW (뭐, 꿈을 부숴도 나쁘진 않으니까…… 태워줄까)
				PRINTFORMW (정말로 효과가 난다면 재미있겠지)
				PRINTFORMW (의외로 플라세보 효과라면……)
				PRINTFORML 
				PRINTFORMW 「……아, 어라? 뭔가 기분이……아」
				PRINTFORMW 「%CALLNAME:MASTER%……이 약」
				PRINTFORMW 「아, 아아……%UNICODE(0x2665) *1% 이거…… 아마 효과 있을 거야……%UNICODE(0x2665) *1%」
				PRINTFORML 
				PRINTFORMW 「일단... 계속하자... %UNICODE(0x2665) *1%」
				CALL RECOVER(TARGET,300,"気力")
				TCVAR:105:351 += 1
			ELSE
				PRINTFORML 「미약...?」
				PRINTFORMW 「...그래, 그런 것이」
				PRINTFORMW 「아마 효과가 없을 거라고」
				PRINTFORMW 「생각한다...」
				PRINTFORMW 「하지만...?」
				PRINTFORML 
				PRINTFORML 「윽... 이, 이거... 설마」
				PRINTFORMW 「아아아... 이렇게... %UNICODE(0x2665) *1%」
				CALL RECOVER(TARGET,300,"気力")
				TCVAR:105:351 += 1
			ENDIF
		ELSE
			IF TALENT:恋人 || TALENT:恋慕
				SELECTCASE TCVAR:105:351
					CASE 0
						PRINTFORML 「우, 미약인가아……분명 기분 좋을 것 같은데」
						PRINTFORMW 「기억이 모호해서……나 이상한 거 안 하고 있지?」
						PRINTFORMW 「뭐 됐어, 일단……응……」
						PRINTFORML 
						PRINTFORMW 「......후우, 효과가 오고 있어... %UNICODE(0x2665) *1%」
						PRINTFORMW 「그럼, 계속할게 %UNICODE(0x2665) *1%」
						CALL RECOVER(TARGET,300,"気力")
						TCVAR:105:351 += 1
					CASE 1
						IF CFLAG:105:1002 == 0
							PRINTFORML 「후훗, 약이네... %UNICODE(0x2665) *1% 한 번 더 할래?」
							PRINTFORML 「...응... %UNICODE(0x2665) *1%」
							PRINTFORML 
							PRINTFORMW 「아아, 효과가 있어... %UNICODE(0x2665) *1% %CALLNAME:MASTER%... 빨리, 계속하자... %UNICODE(0x2665) *1%」
							CALL RECOVER(TARGET,200,"気力")
							TCVAR:105:351 += 1
						ELSEIF CFLAG:105:1002 == 1
							PRINTFORML 「약이, 부족해... %UNICODE(0x2665) *1% 아아, 정말 귀찮네.」
							PRINTFORML 「나도 가져왔어... %UNICODE(0x2665) *1% %조사처리(CALLNAME:MASTER,"의")% 미약이랑... 같이 먹으면 안 될 것 같은 거%UNICODE(0x2665) *1%.」
							PRINTFORMW 「자, 실험해 보자... 후후, 후후후... %UNICODE(0x2665) *1%」
							PRINTFORMDW 마이는 주머니에서 작은 병을 꺼내 내용물을 단숨에 마셨다...
							PRINTFORML 
							TCVAR:105:351 += 3
							CFLAG:105:1002 = 2
							SETCOLOR 0xFF99EE
							PRINTFORMW 「아, 아, 아……왔어아아%UNICODE(0x2665) *1%」
							PRINTFORMW 「이거……전의 그거……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							PRINTFORMW 「아헤헤……%CALLNAME:MASTER%……섹스 계속하자……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							CALL RECOVER(TARGET,200,"気力")
						ELSEIF CFLAG:105:1002 == 2
							PRINTFORML 「약, 아직 추가할 거야? 그럼 오늘도 슬슬 날아가 볼까 %UNICODE(0x2665) *1%」
							PRINTFORML 「제대로, 개량하고 있단 말이야…… 완벽하게 효과 있을 거야……%UNICODE(0x2665) *1%」
							PRINTFORMW 「아니, 악화인가……. 후후후후, 후후……%UNICODE(0x2665) *1%」
							PRINTFORMDW 마이는 주머니에서 작은 병을 꺼내 내용물을 단숨에 다 마셨다……
							PRINTFORML 
							TCVAR:105:351 += 3
							SETCOLOR 0xFF99EE
							PRINTFORML 
							PRINTFORMW 「……아아, 왔다, 왔어……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							CALL RECOVER(TARGET,200,"気力")
						ELSE
							PRINTFORML
							TCVAR:105:351 += 1
						ENDIF
					CASE 2
						PRINTFORML 「에에, 또? 위험해, 이 이상은…… 아마…」
						PRINTFORMW 「조금만, 무서워져서」
						PRINTFORMW 「하지만... 좋아, 기분 좋고... 응!」
						PRINTFORML 
						SETCOLOR 0xFF99EE
						PRINTFORMW 「응, 아아... %UNICODE(0x2665) *1% 좋아... %UNICODE(0x2665) *1% 아직, 아직 할 수 있어 %UNICODE(0x2665) *1%」
						PRINTFORMW 「더... 더, 미약, 으...」
						SETCOLOR 0xFFDDEE
						PRINTFORML 
						PRINTFORMW 「윽……후, 후후후후ふ……%UNICODE(0x2665) *1%」
						PRINTFORMDW 마이의 상태가 이상하다…… 이대로 미약을 더 먹이는 건 좋지 않겠어.
						CALL RECOVER(TARGET,200,"気力")
						TCVAR:105:351 += 1
					CASE 3
						IF FIRSTTIME("媚薬OD")
							PRINTFORML 「약이... 아직, 있는 거야? 그럼, 한 번 더... %UNICODE(0x2665) *1%」
							PRINTFORMW 「이거... 아하하... 마시면, 마시는 대로, 효과가 나네」
							PRINTFORML 
							TCVAR:105:351 += 1
							CFLAG:105:1002 = 1
							SETCOLOR 0xFF99EE
							PRINTFORMW 「아, 이거... 위험해, 아악...윽」
							PRINTFORMW 「응오오... 이게 뭐야 %UNICODE(0x2665) *1% 머리가 이상해져... 으 %UNICODE(0x2665) *1%」
							PRINTFORMW 「기분 좋아... %CALLNAME:MASTER%... 아, 후후 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						ELSE
							PRINTDATAW
								DATAFORM 「아아, 이제는 하아... 죽을 것 같아... %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
								DATAFORM 「아, 아직...? 아직 기분 좋게 될 수 있는 거야... 그럼, 그럼... %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
								DATAFORM 「아하아, 또... %UNICODE(0x2665) *1% 이거... 이제 못 멈춰버렸어! %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							ENDDATA
							CALL RECOVER(TARGET,100,"気力")
							TCVAR:105:351 += 1
						ENDIF
					CASE IS >= 4
						PRINTDATAW
							DATAFORM 「아아, 이제는 하아... 죽을 것 같아... %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							DATAFORM 「아, 아직...? 아직 기분 좋게 될 수 있는 거야... 그럼, 그럼... %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
							DATAFORM 「아하아, 또... %UNICODE(0x2665) *1% 이거... 이제 못 멈춰버렸어! %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						ENDDATA
						CALL RECOVER(TARGET,100,"気力")
						TCVAR:105:351 += 1
					CASEELSE
						PRINTFORML 
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE TCVAR:105:351
					CASE 0
						PRINTFORML 「아, 미약이네……」
						PRINTFORMW 「……뭐, 조금이라면…… 기분 좋으니까……」
						TCVAR:105:351 += 1
					CASEELSE
						PRINTFORML 「안, 안 돼...... 이 이상은......」
						PRINTFORML 「뭔가...... 좋지 않은 예감이 들어......」
						PRINTFORMDW 마이는 미약을 대부분 토해버렸다......
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ELSE
		PRINTFORML 
	ENDIF
ENDIF
RETURN 1

@M_KOJO_EXTRASOURCE_COM_K105_181
;折角だから媚薬でイってしまえ、という気持ち
IF TALENT:恋人 || TALENT:恋慕
	LOCAL = 1000 * TCVAR:105:351
	SOURCE:快Ｍ += LOCAL
