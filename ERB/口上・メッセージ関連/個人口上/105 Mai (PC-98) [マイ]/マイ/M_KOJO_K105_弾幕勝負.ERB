; Modular ERB: 個人口上/105 Mai (PC-98) [マイ]/マイ/M_KOJO_K105_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K105_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ABL:戦闘能力 >= ABL:MASTER:戦闘能力
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「승부라니... %조사처리(CALLNAME:MASTER,"와")%?」
				PRINTFORMW 「할 거면, 진심을 내겠지만... 괜찮겠지?」
			ELSE
				PRINTFORMW 「승부는…… 상관없어」
				SIF TALENT:思慕
					PRINTFORMW (흥, 진심을 낼 필요도 없을까……?)
			ENDIF
		ELSE
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「음, 솔직히 이길 것 같지는 않은데... %CALLNAME:MASTER%, 너무 강하잖아」
				PRINTFORML 「뭐, 그래도... 할 거라면 공짜로 질 생각은 없어」
				PRINTFORMW 「진심으로 와줘」
			ELSE
				PRINTFORMW 「승부는…… 상관없어」
				SIF TALENT:思慕
					PRINTFORMW (보통으로 하면 질 것 같아... 자, 어떡할까)
			ENDIF
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML
			CASE 2
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「잘한다, %CALLNAME:MASTER%」
					PRINTFORMW 「하지만 이 정도 가지고 이겼다고 생각하지 마.」
				ELSE
					PRINTFORMW 「……크윽……」
					SIF TALENT:思慕
						PRINTFORMW (……잘하는군, %CALLNAME:MASTER%)
				ENDIF
			CASE 1
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「도대체 그 강함은 뭐예요...」
					PRINTFORMW 「...아직, 끝나지 않았어요!」
				ELSE
					PRINTFORMW 「크윽... 이번이야...」
					SIF TALENT:思慕
						PRINTFORMW (이놈, 대체 정체가 뭐야......)
				ENDIF
			CASE 0
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「우으, 진심으로 했는데……」
					PRINTFORMW 「완전 망했어~!」
				ELSE
					PRINTFORMW 「너무 강해...」
					SIF TALENT:思慕
						PRINTFORMW (이런 녀석에게 졌다……)
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「보석이 부족해? 자, 무슨 소리지?」
			PRINTFORMW 「기합으로 피하면 어떻게든 될 거야... 자, 간다!」
		ELSE
			PRINTFORML 「음... 무슨 일이야?」
			PRINTFORMW 「……%UNICODE(0x2665) *1%」
			SIF TALENT:思慕
				PRINTFORMW (후후……이건 몰수네)
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「대체, 예상대로의 강성이네... 아직 멀었어.」
					PRINTFORMW 「훈련 같은 거 할 거면, 같이 해 줄게.」
				ELSE
					PRINTFORMW 「이런 것 말이지……」
					SIF TALENT:思慕
						PRINTFORMW (뭐, 예상대로라는 쪽이겠지)
				ENDIF
			CASE 2
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「뭐, 뭐 재미있었어 %UNICODE(0x2665) *1%」
					PRINTFORMW 「그렇네... 예를 들면, 아까의 공격은--」
				ELSE
					PRINTFORMW 「뭐, 뭐... 그런가.」
					SIF TALENT:思慕
						PRINTFORMW (완승이라고 할 수는 없었나... 음음)
				ENDIF
			CASE 1
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「흡... 나도 조금 연습 안 하면 안 될지도.」
					PRINTFORMW 「같이 하지 않을래?」
				ELSE
					PRINTFORMW 「후우... 위험할지도...」
					SIF TALENT:思慕
						PRINTFORMW (이건 좀 대책을 세워야겠어...)
				ENDIF
			CASE 0
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「하아...... %CALLNAME:MASTER%, 정체가 뭐야」
					PRINTFORMW 「있잖아, 내가 부족했던 부분 전부 가르쳐줘...... 이번엔 꼭 이길 테니까」
				ELSE
					PRINTFORML 「……하아」
					SIF TALENT:思慕
						PRINTFORML (어렴풋이 눈치채고 있었지만…… %CALLNAME:MASTER%주변에서는, 나는…… 꽤 약한 편인 것 같아……)
					PRINTFORMDW 마이는 낙담한 것 같다……
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
