@M_KOJO_MESSAGE_COM_K105_80
CALL M_KOJO_MESSAGE_COM_K105_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「음... 단단하네...」
			PRINTFORMW 「...따뜻해 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「잡을게... 응...」
			PRINTFORMW 「응, 이 다음은...?」
		ENDIF
		RETURN 1
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TCVAR:105:351 >= 4
			PRINTFORML 「단단해... 후후후...%UNICODE(0x2665) *1%」
			PRINTFORMW 「저도 만져줘...?」
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「손으로 괜찮아? 후훗, 그래... %UNICODE(0x2665) *1%」
			PRINTFORMW 「하지만 나의 것도 제대로 기분 좋게 해줄 테니까...」
		ELSE
			PRINTFORML 「……기분, 좋아?」
			PRINTFORMW 「문지르는 것만으로는, 나는…… 조금, 부족하다고 할까……」
		ENDIF
		;通常
	ELSE
		IF NOWEX:MASTER:射精
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「헤헤, 갈 것 같아?」
				PRINTDATAW
					DATAFORM 「괜찮아... 자, 갈 것까지 보여줘 %UNICODE(0x2665) *1%」
					DATAFORM 「얼마나 날지 실험이네.」
				ENDDATA
			ELSE
				PRINTFORML 「아…… 나오는 거야?」
				PRINTFORMW 「세차게, 해버릴까...?」
				SIF TALENT:思慕
					PRINTFORMW (벌벌 떨고 있어... 표정도... 알기 쉽네)
			ENDIF
		ELSE
			IF TALENT:恋人 || TALENT:恋慕
				PRINTDATAW
					DATAFORM 「%조사처리(CALLNAME:MASTER,"의")% 기분 좋은 곳을 \@ ABL:技巧 > 3 ? ……봐, 이렇게 당하는 게 좋잖아…… 알고 있으니까 %UNICODE(0x2665) *1% # , 천천히 알아봐 줄게 %UNICODE(0x2665) *1% \@」
					DATAFORM 「손이 좋다고? 좋아…… 그럼 짜줄 테니」
				ENDDATA
			ELSE
				PRINTFORMW 「이거... 사용하면 되는 거야? ...이렇게 하면, 맞겠지...?」
				SIF TALENT:思慕
					PRINTFORMW (세게 쥐는 게 좋을까...... 그리고, 역시 앞쪽을......?)
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
