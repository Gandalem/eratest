@M_KOJO_MESSAGE_COM_K105_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아하하, 미끌미끌해... %UNICODE(0x2665) *1%」
			PRINTFORMW 「음, 토... 자...」
		ELSE
			PRINTFORML 「?? 여기에, 손...? 이렇게...?」
			PRINTFORMW 「에... 모르겠어... 뭐였지」
		ENDIF
		RETURN 1
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TCVAR:105:351 >= 4
			PRINTFORML 「아하핫……%UNICODE(0x2665) *1% 파이즈리, 재미있어라……%UNICODE(0x2665) *1%」
			PRINTFORMW 「자, 정액을 내놔! %UNICODE(0x2665) *1% 잔뜩 뿌리고 싶어! %UNICODE(0x2665) *1%」
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「이걸로 기분 좋은 거야? ……후후후, 그렇다면 됐지만」
			PRINTFORMW 「하지만…… 나도 흥분해오고 있어…… %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「……기분, 좋아?」
			PRINTFORMW 「문지르는 것만으로는, 나는…… 조금, 부족하다고 할까……」
		ENDIF
		;通常
	ELSE
		IF ABL:TARGET:胸 < 2
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「가슴으로 말이야... 이거 있잖아, 나...」
				PRINTFORMW 「아니야, 괜찮아... 잘 못 해도 불평하지 말아 줘」
			ELSE
				PRINTFORML 「응, 가슴으로, 끼워둬...」
				PRINTFORMW 「흡... 후우...」
				SIF TALENT:思慕
					PRINTFORMW (이, 노골적으로 불만스러운 얼굴을... 보고 있잖아)
			ENDIF
		ELSEIF ABL:TARGET:胸 < 4
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「가슴으로 말이야, 기다리고 있었어」
				PRINTFORML 「요령을 알게 된 것 같아, 요즘」
			ELSE
				PRINTFORML 「음... 갈게」
				PRINTFORMW 「이런 느낌, 맞지……」
				SIF TALENT:思慕
					PRINTFORMW (알아왔어, 알아왔다고... 봤니, 이)
			ENDIF
		ELSE
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「아... 또, 가슴으로 해줬으면 해?」
				PRINTDATAW
					DATAFORM 「좋아, 각오해둬... 빠져나가지 못하게 해줄 테니까 %UNICODE(0x2665) *1%」
					DATAFORM 「맡겨둬... 참지 말고, 하고 싶은 대로 해도 돼」
				ENDDATA
			ELSE
				PRINTFORMW 「후후... 어때, 이걸로... %UNICODE(0x2665) *1%」
				SIF TALENT:思慕
					PRINTFORMW (응, 가슴으로 하는 거야... 완전히 내 것으로 만들어버렸어... 후훗)
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
