	ENDIF
ELSEIF TFLAG:22 == 2
	IF CFLAG:105:1006 && FLAG:70 != 1
		PRINTFORML 「あ、ぐ……いっ、たぁ」
		PRINTFORML 「あぁ、痛い……っ、はぁ、はぁ」
		PRINTFORML 「痛い……ふふ、ふふふ……あははは」
		PRINTFORMW 「%CALLNAME:MASTER%……もっとぉ……%UNICODE(0x2665) *1%」
	ENDIF
ELSEIF TFLAG:22 == 3
	IF CFLAG:105:1006 && FLAG:70 != 1
		PRINTFORML 「あ、あぁ……はっ、ひっ……」
		PRINTFORML 「っ、ぐ……目が、ちかちかする」
		PRINTFORML 「ああ、この、痛み……」
