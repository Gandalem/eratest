; Modular ERB: 個人口上/105 Mai (PC-98) [マイ]/マイ/M_KOJO_K105_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K105
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	IF CFLAG:105:1006 && FLAG:70 != 1
		PRINTFORML 「이, 방금 건…… 꽤 아팠지만」
		PRINTFORML 「왠지 몸 깊은 곳에서…… 이상한 느낌」
		PRINTFORMW 「뭐였을까, 지금의 이 감정은……」
	ENDIF
ELSEIF TFLAG:22 == 2
	IF CFLAG:105:1006 && FLAG:70 != 1
		PRINTFORML 「아,윽...... 아파...」
		PRINTFORML 「아아, 아파...... 하아, 하아」
		PRINTFORML 「아파...... 후후, 후후후...... 아하하하」
		PRINTFORMW 「%CALLNAME:MASTER%...... 더...... %UNICODE(0x2665) *1%」
	ENDIF
ELSEIF TFLAG:22 == 3
	IF CFLAG:105:1006 && FLAG:70 != 1
		PRINTFORML 「아, 아아...... 핫, 힉......」
		PRINTFORML 「윽, 크윽...... 눈이, 반짝거린다.」
		PRINTFORML 「아아, 이, 고통......」
		PRINTFORMW 「...절대, 잊을 수 없어... %UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORMW 「이건, 나빠...」
		PRINTFORMW 「중독되는 게...%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW (이 사람은… 나를 기분 좋게 해주고 있어…)
	ENDIF
ELSEIF TFLAG:23 == 2
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「――...!」
		PRINTFORML 「기-기다려, 나... 이러고 있어...」
		PRINTFORMW 「%CALLNAME:MASTER%...%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML (아아, 더 이상은... 더 가면 나는...%UNICODE(0x2665) *1%)
		PRINTFORMW 「...돌아갈 수 없어.」
	ENDIF
ELSEIF TFLAG:23 == 3
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「하아, 하아... 그만해...」
		PRINTFORML 「%CALLNAME:MASTER%... I'm...」
		PRINTFORMW 「부서질 것 같아...」
		PRINTFORMW 「...%UNICODE(0x2665) *1%」
		PRINTFORMW 「...%CALLNAME:MASTER%... 더 많이, 계속...%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML (――아아악――)
		PRINTFORMW 「…더는 못 참겠어.」
		PRINTFORMW 「…에? 아, 내가 무슨 말을 했지...? 아니, 아무것도...」
		PRINTFORMW 「…계속해둬...%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORML (이건 뭐지... 마치 %조사처리(CALLNAME:MASTER,"가")%...)
	PRINTFORMW 「%CALLNAME:MASTER%...」
	PRINTFORMW 「...%UNICODE(0x2665) *1%」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORML 「...%CALLNAME:MASTER%.」
	PRINTFORMW 「나랑 함께 있는 게 즐거워...? 」
	PRINTFORMW 「그렇구나... 기쁘다... %UNICODE(0x2665) *1%」
	;LV3
ELSEIF TFLAG:24 == 33
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「%CALLNAME:MASTER%.」
		PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 행복할 때 나는 언제나 행복해.」
		PRINTFORMW 「이런 감정을 느껴본 것은 처음이야...」
		PRINTFORMW 「...」
		PRINTFORMW 「저기, 내가 해줄 일이 있니...?」
	ELSE
		PRINTFORMW （%CALLNAME:MASTER%）
		PRINTFORMW 「...%CALLNAME:MASTER%.」
		PRINTFORML 
		PRINTFORMW (나를 봐)
		PRINTFORMW 「나를 봐...」
		PRINTFORMW 「...%CALLNAME:MASTER%...%UNICODE(0x2665) *1%」
		PRINTFORML 
		PRINTFORMW (으음, 이건 점점... 더 나빠지고 있어... %UNICODE(0x2665) *1%)
	ENDIF
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 
ELSEIF TFLAG:21 == 2
	PRINTFORMW 
ELSEIF TFLAG:21 == 3
	PRINTFORMW 
ENDIF
