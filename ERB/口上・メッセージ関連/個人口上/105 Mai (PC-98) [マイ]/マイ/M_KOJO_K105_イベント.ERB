	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		;custom lines?
		IF TALENT:恋人
			PRINTFORML 「야.」
			PRINTFORML 「%CALLNAME:MASTER%%UNICODE(0x2665) *1%.」
			PRINTFORMW 「오늘 할 분량은 채웠다.」
		ELSEIF TALENT:恋慕
			PRINTFORML 「......」
			PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 지루해하고 멍한 듯하다.
		ELSEIF TALENT:思慕
			PRINTFORML (오늘, %조사처리(CALLNAME:MASTER,"는")%...)
			PRINTFORMW (...아니, 매일 %HIM_HER(MASTER,,1)%를 만날 필요가 있는 건 아니지만...)
		ELSE
			PRINTFORMW 「하아, 졸리네...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
