@M_KOJO_EVENT_K105_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 0
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「흐으... 후우...」
						PRINTFORMW 「아아, %CALLNAME:MASTER%%UNICODE(0x2665) *1%... 잠깐만, 기다려!」
					ELSE
						PRINTFORML 「흐으음... 후우...」
						PRINTFORMW 「...Eh...」
					ENDIF
				ELSE
					;緊縛オナバレ以降はここの反応も改変地の文に統合
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 2
					PRINTFORML 「아아악, 기다려! 부탁이야!」
					PRINTFORMW 「크윽, 몸이 움직여지지 않아... 대체 이 밧줄은 뭐야! 누가 나를 묶은 거야!」
					PRINTFORMW 「……」
					PRINTFORMW 「뭐, 저는...」
				ELSEIF TCVAR:105:353 == 1
					PRINTFORML 「잠깐만…… 설마, 들으러 온 거야?」
					PRINTFORML 「부족하지만…… 혼자 계속할 기분도 아니야」
					PRINTFORMW 「붙잡아 두면 좋았을까…….」
				ELSE
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「알겠다...」
						PRINTFORMW 「......」
						PRINTFORMW 「...복수하는 의미에서 너를 염탐할 거라는 것도 기억해 두지.」
					ELSE
						PRINTFORML 「도대체 너 뭐야?!」
						PRINTFORMW 「멈춰!」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 2
					PRINTFORML 「그대로 말이야... 밧줄도, 이대로?」
					PRINTFORML 「저기, 아무래도 좀 부끄러운데...」
					PRINTFORML 「……」
					PRINTFORMW 「크윽, 할 수밖에 없나...」
				ELSEIF TCVAR:105:353 == 1
					PRINTFORML 「……%조사처리(CALLNAME:MASTER,"는")%, 보고만 있어?」
					PRINTFORML 「하아……누구 때문이야, 내가 이렇게……」
					PRINTFORMW 「정말로, 좋은 취미를 가지고 있네」
				ELSE
					IF TALENT:恋人 || TALENT:恋慕
						IF CFLAG:105:性格傾向 == 1 || CFLAG:105:性格傾向 == 4
							PRINTFORML 「보이고 있다는 걸 알면서 그대로 하는 건…… 좀 어려울지도.」
							PRINTFORMW 「일단, 할 일은 하니까…… 그걸로 용서해줘……」
						ELSEIF CFLAG:105:性格傾向 == 2 || CFLAG:105:性格傾向 == 3 || CFLAG:105:性格傾向 == 5
							PRINTFORML 「보고 있어 줄게, 응... 잘난 척하는 걸」
							PRINTFORML 「…………」
							PRINTFORMW 「알았어... 보여줄게」
						ENDIF
					ELSE
						PRINTFORML 「...바보냐?」
						PRINTFORMW (이 상황 때문에 너무 긴장돼.)
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 2
					PRINTFORML 「제발... 이제, 돌아가」
					PRINTFORMW 「아, 울컥해지네...」
				ELSEIF TCVAR:105:353 == 1
					PRINTFORML 「용건이 없다면, 돌아가라」
					PRINTFORMW 「정말이지... 어째서 이렇게 타이밍이 안 좋을까」
				ELSE
					PRINTFORMW 「...이제 쇼는 끝났어.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 2
					PRINTFORML 「에... %CALLNAME:MASTER%도, 사귈 거야?」
					PRINTFORMW 「……」
					PRINTFORMW 「저기, 그럼... 가능하다면, 잔뜩 괴롭혀 주었으면 좋겠어...라든가」
					PRINTFORMW 「있잖아, %CALLNAME:MASTER%... 후, 후후후... %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「알고 있어.」
					PRINTFORML 「우리 둘뿐이니까…%CALLNAME:MASTER%%UNICODE(0x2665) *1%」
					PRINTFORMW 「봤듯이, 난 이미 절박하니까… 끝까지 가는 게 좋겠어.」
					PRINTFORMW 「너를 놓아줄 생각 없어.」
				ELSE
					PRINTFORML 「...기다려, 그만둬.」
					PRINTFORMW 「농담이지, 그렇지...? 그만두라고 했잖아.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 2
					PRINTFORMDW 만족한 %조사처리(CALLNAME:MASTER,"는")%, 잔뜩 범해져 망연자실한 마이의 밧줄을 풀어주었다…….
					PRINTFORML 「아, 고마워……」
					PRINTFORMW 「……」
					PRINTFORMW 「저기, %CALLNAME:MASTER%…… 정말로, 저를 버리지 말아 주세요…… 부탁이에요」
					PRINTFORMW 「이제, 저는…… %조사처리(CALLNAME:MASTER,"가")% 없으면……」
				ELSEIF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「응, 으음... %UNICODE(0x2665) *1% ... 하아, 가볍게 자위만 할 생각이었는데」
					PRINTFORMW 「좋은데 말이야, 이쪽이 더 기분 좋으니까...」
					PRINTFORMW 「갑작스러워서 놀랐지만... 와줘서 기뻤어」
					PRINTFORML 
					PRINTFORMW 「……자, 오늘은 이 다음에 어떻게 할 거야?」
				ELSE
					PRINTFORML 「윽……흐으, 아……%UNICODE(0x2665) *1%」
					PRINTFORML 「……확실히……욕구 불만이었지만」
					PRINTFORMW 「이제……너무 심했어……%UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TCVAR:105:353 == 2
					PRINTFORML 「묵고... 응, 물론이지」
					PRINTFORMW 「고마워, %CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「에, 머물러 준다고... 계속 있어 줄 거야?」
					PRINTFORMW 「어떡해, 오늘... 꽤 서비스 좋잖아.」
					PRINTFORMW 「...아, 설마... 아직 못 한 게 있거나 그래?」
					PRINTFORMW 「후후, 나는 그 정도밖에 할 일이 없었으니까... 뭐든지 하고 싶은 대로 해%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORML 「……묵어줘……」
					PRINTFORMW 「뭐, 아무것도 없지만…… 편하게 지내면 어때」
					PRINTFORML 
					PRINTFORMW 「……그렇게 물건을 갖고 싶어 보였나……. 나」
