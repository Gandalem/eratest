#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	IF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%, 잠깐... 이거, 받아줘」
				PRINTFORMW 「별거 아니야... 그냥 나한테 준 거 가지고 있어줬으면 좋겠어서.」
				PRINTFORML 
				PRINTFORML 「뭐, 마음에 안 들면 처분해도 돼.」
				PRINTFORMW 「일단 가지고 가.」
			CASEELSE
				PRINTFORML 「...나 나름으로 %CALLNAME:MASTER%에게는 감사하고 있어」
				PRINTFORMW 「별로 애교가 없는 것 같아, 이렇게 데이트 같은 걸 같이 해줘서」
				PRINTFORML 
				PRINTFORML 「......그런 이유로, 이거... 그, 선물 %UNICODE(0x2665) *1%」
				PRINTFORMW 「하아, 부끄럽네...... 뭔가」
		ENDSELECT
	ELSE
		PRINTFORML 「……아, 그래…… 이거, 줄게」
		PRINTFORML 「별로…… 나한테는 필요 없는 거니까……」
		PRINTFORMW 「……그것뿐이야」
		SIF TALENT:思慕
			PRINTFORMW (꽤 골랐는데…… 그에 걸맞은 반응을 보여줘...? 자, 어때)
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物を大事にする（700点以上）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「후후후, %CALLNAME:MASTER%에게서 온 선물이야%UNICODE(0x2665) *1%」
		PRINTFORML 「이야아 좋은 센스네... 역시 대단해」
		PRINTFORMW 「어떡할 거야~ 받은 것만 있으면 안 되잖아~%UNICODE(0x2665) *1%」
		PRINTFORML 
		PRINTFORML 「응, 몸으로 돌려줄 수밖에 없겠네... 이건」
		PRINTFORMW 「뭐야, 하하... 탐욕스럽구나, 나도... %UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「자, 이제 %조사처리(CALLNAME:MASTER,"에게")% 받은 선물...」
		PRINTFORML 「...역시 좋다... 후후훗%UNICODE(0x2665) *1%」
		PRINTFORMW 「생각보다 나에 대한 이해도가 높네... 바보인 것 같으면서 잘 보고 있는 건가」
		PRINTFORML 
		PRINTFORMW 「어느 쪽이든, 앞으로도 주의해야겠네……%UNICODE(0x2665) *1%」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「이거... %조사처리(CALLNAME:MASTER,"에게")% 받은 거라, 나도 모르게 들떠버렸지만」
		PRINTFORMW 「...냉정하게 보면, 뭐라고 해야 할까... 평범해?」
		PRINTFORML 
		PRINTFORML 「뭐, 뭐랄까 %조사처리(CALLNAME:MASTER,"와")%의 소중한 추억의 물건이라서……」
		PRINTFORMW 「소중히 보관해 둬야겠네~ %UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「……데이트에, 선물……인가아」
		PRINTFORML 「물 자체도, 그럭저럭 좋은 느낌이고」
		PRINTFORMW 「꽤, 익숙해진 것 같거나…… 단단하구나~……」
		PRINTFORML 
		PRINTFORML 「……안 돼 안 돼, 너무 많이 생각하게 되네」
		PRINTFORMW 「빨리 자자……」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「자, %CALLNAME:MASTER%로부터의 선물인데……」
		PRINTFORMW 「……뭐, 필요 없는 건 어쩔 수 없으니…… 미안하지만, 처분할게.」
		PRINTFORML 
		PRINTFORML 「이건 큰 문제야... 나를 전혀 알아주지 못하고 있어」
		PRINTFORML 「어떻게든, 좀 더 봐달라고 해야 하는데」
		PRINTFORMW 「음~ 어떡하지...」
	ELSE
		PRINTFORML 「나에 대한 선물이, 이거인가... 뭐, 이건 폐기해야겠지」
		PRINTFORMW 「저 사람은... 내가 기뻐할 만한 걸 고른 거겠지.」
		PRINTFORML 
		PRINTFORML 「일부러 자신을 숨기고 있는 거니까... 어떤 의미에서는 잘 되고 있다고도 할 수 있지만」
		PRINTFORMW 「...뭐랄까, 이것 나름으로 개운하지 않은 면이 있네.」
	ENDIF
ENDIF
RETURN 1
;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================

@M_KOJO_MESSAGE_COM_K105_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人 || TALENT:恋慕
				RESULTS = 「いや、わたしはムシなんて持ってないし……あれっ、持ってる！　なんで！？」
			ELSE
				RESULTS = 「あの……わたし、ムシなんて持って……え、持ってる……なにこれ」
			ENDIF
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「ま、こいつでいいか……それっ」
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORML 
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「……儚いなぁ」
				CASE 1
					RESULTS = 「ああ……ちょっと、可哀想かもね……」
				CASEELSE
					RESULTS = 「……死んじゃった？」
			ENDSELECT
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「……そっか、これでおしまいだったね」
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「え、わたしの勝ち……そ、そう……」
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「わたしの負け……えーと、おめでとう」
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「え、わたしの勝ち……そ、そう……」
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「良い勝負だった、のかな……？」
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「まあ……味方が良かった、ってことかな……」
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「ごめんなさい、わたしのせいかな……」
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1
