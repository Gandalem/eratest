		ELSE
			PRINTFORML 「……후우……이제, 됐어」
			PRINTFORMW 「수고했어」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
