@M_KOJO_MESSAGE_COM_K105_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70 ;時姦
		PRINTFORML 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「……음, 으윽……」
			PRINTFORMW 「아, 거기……좋아해 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「……? 뭐야, 만지고 있어……?」
			PRINTFORMW 「아... 안 돼... 싫어」
		ENDIF
		RETURN 1
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TCVAR:105:351 >= 4
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「얏, 아앗 %UNICODE(0x2665) *1% 히잇이이이 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1% 더 만져줘 %UNICODE(0x2665) *1%」
					PRINTDATAW
						DATAFORM 「가슴 좋아, 더 갖고 싶어 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						DATAFORM 「보지 보고 싶어, 안쪽을 만지고 싶어 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
					ENDDATA
				CASEELSE
					PRINTFORML 「흐응, 가득 차버릴 거야 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
					PRINTFORMW 「기분 좋아, 기분 좋아……응 헤헤, 헤헤……%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아앗 %UNICODE(0x2665) *1% 그래, 많이 만져줬으면 해……%UNICODE(0x2665) *1%」
					PRINTFORMW 「지금 민감하니까…… 엄청 느껴져……. %UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 「음음%UNICODE(0x2665) *1% 잘하네, %CALLNAME:MASTER%……기분 좋아%UNICODE(0x2665) *1%」
					PRINTFORMW 「키스도 해줘……가슴도 클리 것도 전부 만져줘……%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSE
			PRINTFORML 「우으으... 기분, 좋다... 더, 더... %UNICODE(0x2665) *1%」
			PRINTFORMDW 마이는 황홀한 표정으로 애무를 받아들이고 있다...
		ENDIF
		;VA挿入
	ELSEIF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		IF TALENT:恋人 || TALENT:恋慕
			PRINTDATAW
				DATAFORM 「그렇게…… 몸 전체를 %조사처리(CALLNAME:MASTER,"의")% 것으로 해줘, 안팎 전부 다 %UNICODE(0x2665) *1%」
				DATAFORM 「히익 %UNICODE(0x2665) *1% 그렇게 한 번에 당하면…… 몸이 정신을 못 차릴 거야 %UNICODE(0x2665) *1%」
				DATAFORM 「응, %CALLNAME:MASTER%, 아…… 키스도…… %UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTFORMW 「......하아, 하아...... 너무 만졌어......」
			SIF TALENT:思慕
				PRINTFORMW (우와... 온몸이 엉망이 되어버려......%UNICODE(0x2665) *1%)
		ENDIF
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			PRINTDATAW
				DATAFORM 「응, 그래... 많이 만져줘, 나만 봐줘... %UNICODE(0x2665) *1%」
				DATAFORM 「후후, %조사처리(CALLNAME:MASTER,"의")% 손... 느껴진다 %UNICODE(0x2665) *1%」
				DATAFORM 「응에, %CALLNAME:MASTER%, 아... 응, 키스도... %UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTFORML 「……응응」
			PRINTFORMDW 마이는 간지러운 듯 몸을 떨면서도, 조용히 만지고 있다…….
			SIF TALENT:思慕
				PRINTFORMW (음, 이상한 곳만 만지고 있어...)
		ENDIF
	ENDIF
ENDIF
RETURN 1
