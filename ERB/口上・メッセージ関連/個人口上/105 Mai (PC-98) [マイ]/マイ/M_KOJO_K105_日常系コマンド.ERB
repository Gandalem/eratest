@M_KOJO_SUCCESS_COM_K105_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K105_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K105_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「...흥.」
		PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 아예 돌아보지도 않는다...
		;失敗
	ELSEIF TFLAG:193 == -1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「...에?」
			PRINTFORMW 「미안, 못 들었어.」
		ELSE
			PRINTFORML 「......」
			PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%은(는) 멍해 있다...
		ENDIF
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「응, 듣고 있어?」
					PRINTFORMW 「듣고 있어, 전부 듣고 있어... 언제나」
				CASE 1
					PRINTFORML 「으아, 취했어~」
					PRINTFORMW 「%CALLNAME:MASTER%……후후, 무슨 그 표정이야-」
				CASE 2
					PRINTFORMW 「%CALLNAME:MASTER%말이야? 응, 정말 좋아해」
