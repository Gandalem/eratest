			ENDSELECT
		ELSE
			PRINTFORML 「……응?」
			PRINTFORMW 「음……뭐라고 했어?」
		ENDIF
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TALENT:恋人 || TALENT:恋慕
