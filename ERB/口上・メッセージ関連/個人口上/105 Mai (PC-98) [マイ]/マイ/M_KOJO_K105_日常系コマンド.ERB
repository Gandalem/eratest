;TFLAG:194(3=夏の昼間 2=ヤバい天気 1=悪天候 0=屋内or通常天気
;==================================================

@M_KOJO_MESSAGE_COM_K105_411
CALL M_KOJO_MESSAGE_COM_K105_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:泥酔 == 1
		PRINTFORML 
	ELSEIF ABL:MASTER:戦闘能力 > ABL:戦闘能力
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「오, 너를 맞출 수가 없어!」
					PRINTFORMW 「좀 더 인간처럼 행동해 봐!」
				CASE 1
					PRINTFORMW 「너무 강해...」
					PRINTFORMW 「그 순간이동 같은 움직임은 반칙이야.」
				CASE 2
					;MS defeat line reference
					PRINTFORMW 「왜 그렇게 강한 거야?」
					PRINTFORMW 「얼마나 민망할까...」
			ENDSELECT
		ELSE
			PRINTFORMW 「...」
			PRINTFORMW 「다음엔 너를 이길 거야...」
		ENDIF
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「응, 바로 그렇게.」
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 무슨 일이라 생기면 곤란하니까... 최소한 이건 배움의 경험으로 만들어둬.」
				CASE 1
					PRINTFORMW 「꽤 잘하네, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
					PRINTFORMW 「그런 수준의 마법사를 쓰러뜨릴 수 있을 거야.」
				CASE 2
					PRINTFORMW 「맞아, 불필요한 것에는 신경 쓰지 마...」
					PRINTFORMW 「중요한 것만.」
			ENDSELECT
		ELSE
			PRINTFORMW 「...」
			PRINTFORMW 「그게 다야?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
