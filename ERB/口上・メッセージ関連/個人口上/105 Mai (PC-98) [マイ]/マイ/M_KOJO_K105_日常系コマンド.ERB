@M_KOJO_MESSAGE_COM_K105_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Activity_Type =0考え事/=1遊ぶ/=2食事/=3つまみ食い/=4掃除/=5運動/=6読書/=7料理
	;				=8セッション/=9採集/=10釣り/=11調合/=12休憩/=13晩酌/=14買い物/=15説教/=16落とし穴
	SELECTCASE Activity_Type:105
		CASE 0
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			;自室のみ
			IF TFLAG:193 == -1
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「음... %CALLNAME:MASTER%에게만은 말할 수 없는 것, 그런 걸까」
					PRINTFORMW 「그래서, 알려주지 않을 거야」
				ELSE
					PRINTFORML 「……별로, 아무것도」
					PRINTFORMW 「잠시, 내버려 두어도……?」
				ENDIF
			ELSE
				IF TALENT:恋人 || TALENT:恋慕
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「뭐긴 뭐야... 음」
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 무슨 생각을 하는지, 같은 거?」
							PRINTFORML 
							PRINTFORMW 「……평소에 무슨 생각 하는 거야」
						CASE 1
							PRINTFORML 「음……. 뭔가 잊고 있는 게 있었던 것 같기도 하고, 없었던 것 같기도 해」
							PRINTFORMW 「……%CALLNAME:MASTER%, 몰라? 아무렇게나 정해도 괜찮아, 이젠」
						CASEELSE
							PRINTFORML 「생각하고 있는 거……뭐가 좋아? 역시 야한 거 생각하고 있어 줬으면 좋겠어?」
							PRINTFORMW 「……뭐, 그럴 때는 멍하니 생각하지 말고 %조사처리(CALLNAME:MASTER,"에게")% 직접 말할게」
					ENDSELECT
				ELSE
					PRINTFORML 「……밖에」
					PRINTFORMW 「여러 사람이 있네, 하고……」
				ENDIF
			ENDIF
		CASE 1
			;▼遊ぶ［一緒に遊ぶ］
			;※[幼稚]持ちのみ
			;TFLAG:193,1=大いに盛り上がる,-1=あまり盛り上がらない
			;PRINTFORML
		CASE 2
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			IF TALENT:恋人 || TALENT:恋慕
				IF TFLAG:193 == -1
					PRINTFORML 「자신이 먼저 왔다고 하기엔, 안 먹잖아」
					PRINTFORML 「……나랑 함께 있고 싶었던 것뿐이라든가? 같은 거」
					PRINTFORMW 「그렇다면 나도 바라는 바야만」
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「네, 네, 여기 있어요...」
							PRINTFORMW 「그렇지... 가끔은 제가 음료라도 내드릴까요」
						CASEELSE
							PRINTFORML 「후후... 혼자 먹는 쪽을 좋아했었는데」
							PRINTFORMW 「예전에는 말이야」
					ENDSELECT
				ENDIF
			ELSE
				PRINTFORML 「함께...?」
				PRINTFORMW 「...뭐, 어서 오세요」
				SIF TALENT:思慕
					PRINTFORMW (굳이 나랑... 아니면, 그저 체면을 세우고 있는 걸까)
			ENDIF
		CASE 3
			;▼つまみ食い［一緒につまみ食い］
			;※[妖精]持ちとルーミア、こいし、幽々子、紫苑のみ
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			;マイはそんなことしない
			;PRINTFORML
		CASE 4
			;▼掃除［掃除を手伝う］
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			;誰かの部屋
			IF TALENT:恋人 || TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「역시 그렇네, 그럼 잘 부탁해 %UNICODE(0x2665) *1%」
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 있다 생각해서... 나도 좀 기대하고 있었어」
					CASEELSE
						PRINTFORML 「자, 다음엔 뭘 하면 될까? ……라고」
						PRINTFORMW 「내가 도와주는 쪽이 되어버렸어……. 언제부터?」
				ENDSELECT
			ELSE
				PRINTFORML 「아아... 고마워」
				PRINTFORMW 「じゃあ、向こうを……」
				SIF TALENT:思慕
					PRINTFORMW (만지게 해 줄 것 같지 않은 곳은... 하고)
			ENDIF
		CASE 5
			;▼運動［一緒に運動する］
			;※[音楽知識]持ちは除く（演奏になる）
			;戦闘能力が1以上で音楽知識が無い
			IF TALENT:恋人 || TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「역시, 어느 정도는 몸을 단련해 두지 않으면 안 되겠네.」
						PRINTFORMW 「뭐, 편하게 하자고.」
					CASEELSE
						PRINTFORML 「혼자 집에 있는 시간이 많아서, 가끔 몸을 움직이려고 노력하고 있긴 한데 말이야」
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 데이트해 주면 도움이 될 것 같아…… 오래 이어질 수 있을 것 같으니까」
				ENDSELECT
			ELSE
				PRINTFORML 「......좋지만」
				PRINTFORMW 「그럼, 잠깐 도와줘」
				SIF TALENT:思慕
					PRINTFORMW (왠지, 좀... 하기 어렵다기보다는... 신경 쓰게 되네)
			ENDIF
		CASE 6
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			;教養1以上で読書可な位置
			IF TFLAG:193 == -1
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「……미안해, 좀 나중에 해줘……」
					PRINTFORMW 「…………」
				ELSE
					PRINTFORML 「……시끄러워」
					PRINTFORMW 「말 걸지 마……」
				ENDIF
			ELSE
				IF TALENT:恋人 || TALENT:恋慕
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「%CALLNAME:MASTER%도 읽을 거야? 그렇다면, 별로 말할 수가 없네」
							PRINTFORMW 「만지는 것만, 만지는 것만 말이야…… 음」
							PRINTFORMW 「그래서 그 후에――헉…… 많이 말해버렸나……. 미안해」
						CASEELSE
							PRINTFORML 「%CALLNAME:MASTER%도 읽어본 적 있어?」
							PRINTFORMW 「그럼, 그게... 나의 감상은 잠시 접어두고, 먼저 당신의 의견을 듣고 싶어.」
