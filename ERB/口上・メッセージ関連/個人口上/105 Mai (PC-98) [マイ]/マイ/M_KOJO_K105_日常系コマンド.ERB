			;(GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「뭐랄까... 그렇게 고민했으면 그럴 수 있지」
				PRINTFORMW 「그렇게 집착할 정도였어? 저쪽 가게의 기념품을」
			ELSE
				PRINTFORML 「……길었네」
				PRINTFORMW 「피곤하다……」
				SIF TALENT:思慕
					PRINTFORMW (결단력 있는 면도 있다고 생각했는데, 이상한 곳에서 우유부단하네... 이 녀석)
			ENDIF
			;やっぱりやめる（見送り）
		CASE -1
			IF TALENT:恋人 || TALENT:恋慕
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「기념품 가게였네... 뭔가 이상하게 여러 가지 물건을 팔고 있었는데」
						PRINTFORMW 「결국, 무슨 가게였던 걸까」
					CASE 1
						PRINTFORML 「어라, 좀 신경 쓰이네……. 살 정도는 아니었지만」
						PRINTDATA
							DATAFORM 「마계」
							DATAFORM 「배신」
							DATAFORM 「금단의」
						ENDDATA
						PRINTFORMW ……뭔가였더라.
				ENDSELECT
			ELSE
				PRINTFORML 「……이제, 괜찮아?」
				PRINTFORMW 「안 살 거야」
				SIF TALENT:思慕
					PRINTFORMW (뭐, 필요 없는 것도 사도 말이야...)
			ENDIF
			;400点未満（BAD）
		CASE 1
			IF TALENT:恋人
				PRINTFORML 「선물을 주는 건 좋은데 말이야……이게 뭐야」
				PRINTFORML 「나의 취향은 아직 모르는 거야?」
				PRINTFORMW 「슬프네~」
			ELSEIF TALENT:恋慕
				PRINTFORML 「아, 나에게 주는 사람이었구나」
				PRINTFORML 「후우, 이걸... 음... 고마워」
				PRINTFORMW 「...다음부터는 같이 골라볼까」
			ELSE
				PRINTFORML 「……이걸, 저에게?」
				PRINTFORMW 「음……」
				PRINTFORMW 「뭐, 일단 받아 둘게…… 일단은」
				SIF TALENT:思慕
					PRINTFORMW (전혀 취향이 아니네... 어떡하지, 이거)
			ENDIF
			;400点～699点（NORMAL）
		CASE 2
			IF TALENT:恋慕 || TALENT:恋人
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「선물, 말이지... 어떤 걸 봐야 할까」
						PRINTFORML 「! ...헤에, 좋네」
						PRINTFORMW 「고마워%UNICODE(0x2665) *1% 뭔가, 답례를 해야겠어...」
					CASE 1
						PRINTFORML 「저기, 아까 사던 거...」
						PRINTFORMW 「에! 나한테 주는 선물이었어?」
						PRINTFORML 「그렇구나... 조금, 좋다고 생각했었거든」
						PRINTFORML 「고마워, 기쁘다%UNICODE(0x2665) *1%」
						PRINTFORMW 「후훗...%UNICODE(0x2665) *1%」
				ENDSELECT
			ELSE
				PRINTFORML 「......이걸, 나에게?」
				PRINTFORMW 「헤에...... 고마워」
				PRINTFORML 
				PRINTFORMW 「……%UNICODE(0x2665) *1%」
			ENDIF
			;700点以上（GOOD）
		CASE 3
			;形容詞+本体名を取得
			CALL GIFTNAME(TCVAR:105:今日の贈り物)
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「선물? ……어, 이거」
				PRINTFORML 「%RESULTS%……이런 것도 팔고 있었어?」
				PRINTFORML 「내가 직접 찾았으면 분명 샀을 거라고 생각해…… 상당히, 나 취향이야.」
				IF TALENT:恋人
					PRINTFORMW 「역시 내 마음을 잘 알아주는구나」
				ELSE
					PRINTFORMW 「그렇게나, 나의 것을 알아주고 있었구나」
				ENDIF
				PRINTFORML
				SELECTCASE 属性
					CASE "眺める"
						PRINTFORML 「아아... 이거 좋네, 어디에 장식할까」
					CASE "抱く"
						PRINTFORML 「……응, 딱 맞는 느낌이야……%UNICODE(0x2665) *1%」
					CASE "握る"
						PRINTFORML 「후후... 좋네, 사이즈감이.」
					CASE "身につける"
						PRINTFORML 「바로, 달아도 괜찮을까?」
						PRINTFORMW 「음~ 저기... 좋아」
						PRINTFORMW 「어때, 이거... 어울려?」
				ENDSELECT
				PRINTFORMW 「고마워, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「...이걸, 나에게?」
				PRINTFORMW 「！　……%RESULTS%……」
				PRINTFORML 「에, 응... 좋아하지만, 이런 건」
				PRINTFORMW 「잘 알아줬구나?」
				PRINTFORMW 「저기, 고마워요... 기뻐요」
				PRINTFORML 
				PRINTFORMW 「소중히 간직할게... %UNICODE(0x2665) *1%」
				SIF TALENT:思慕
					PRINTFORMW (저기, 이 녀석... %UNICODE(0x2665) *1% 윽, 얼굴에 드러나네)
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
