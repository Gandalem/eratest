;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
		RETURN 0
	IF TCVAR:泥酔 == 1
		PRINTFORML 
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「지금은 이런 교양보다... 더 공부하고 싶은 것이 있어서 말이야」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 전문 분야에서... 후후후... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「……응, 더 가까이 와줘……」
			PRINTFORMW 「아니, 그게…… 잘 보이지 않아서요」
		ENDIF
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「와, 당신은 참 박식이군요.」
				PRINTFORMW 「네, 그래서...」
			CASE 1
				PRINTFORMW 「그래, 지금 내가 파고 있는 게 바로 그 마법이야――」
			CASE 2
				PRINTFORMW 「후, 그렇게 하면 더 쉽게 먼지를 제거하는 거구나...」
				PRINTFORMW 「흠, 나도 저번에 마법 공부할 때 그거 사용했었어.」
		ENDSELECT
	ELSE
		IF ABL:MASTER:教養 > ABL:教養
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「그렇구나, 그렇게 되는 거네」
					PRINTFORMW 「잘 알겠어... 고마워」
					SIF TALENT:思慕
						PRINTFORMW (이 녀석... 비틀거리는 것 같으면서도, 교양은 갖추고 있구나) 
				CASE 1
					PRINTFORML 「……어, 틀렸어?」
					PRINTFORMW 「음……응, 확실히 그렇네……」
					SIF TALENT:思慕
						PRINTFORMW (아, 한심해...... 가르쳐 줄 생각이었는데) 
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「나에게, 가르쳐 주길 바라는 거야?」
					PRINTFORMW 「……뭐, 괜찮아……조금 정도는.」
					SIF TALENT:思慕
						PRINTFORMW (어디 보자... 좀 좋은 걸 보여줄까나) 
				CASE 1
					PRINTFORML 「생각하는 방법은… 이 책의, 여기야」
					PRINTFORMW 「……읽으면 알게 될 거야」
					SIF TALENT:思慕
						PRINTFORMW (설명도 필요할까 생각했지만, 괜찮을 것 같네……. 지식이 부족할 뿐 머리가 나쁜 건 아닌 모양이야)
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
