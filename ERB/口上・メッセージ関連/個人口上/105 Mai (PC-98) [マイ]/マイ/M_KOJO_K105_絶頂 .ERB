@M_KOJO_MESSAGE_PALAMCNG_A_K105_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦
	IF FLAG:70
		PRINTFORML 
	ELSEIF TCVAR:泥酔 == 1
		PRINTFORML 
	ELSEIF TCVAR:105:351 >= 4
		PRINTDATAL
			DATAFORM 「아아아... %UNICODE(0x2665) *1% 속이 시원해, 기분 좋아... %UNICODE(0x2665) *1%」
			DATAFORM 「따뜻해... %UNICODE(0x2665) *1% 있잖아, 더... %UNICODE(0x2665) *1%」
		ENDDATA
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF ABL:膣射中毒 > 3
			PRINTDATAL
				DATAFORM 「안 돼... 왔어... 따뜻해... %UNICODE(0x2665) *1%」
				DATAFORM 「흐윽... %UNICODE(0x2665) *1% 아아, 참을 수 없어... %UNICODE(0x2665) *1%」
				DATAFORM 「아, 나오고 있어... %UNICODE(0x2665) *1% 그래... 전부 깊숙이 넣어줘... %UNICODE(0x2665) *1%」
				DATAFORM 「응, 안쪽으로... %UNICODE(0x2665) *1% 안 돼, 완전히 버릇이 되어버렸어... 있잖아, 더... 더 내줘...?」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「우, 굉장해... 나오는 게 알겠어... %UNICODE(0x2665) *1%」
				DATAFORM 「히익!? 아... %조사처리(CALLNAME:MASTER,"가")% 안에... %UNICODE(0x2665) *1%」
				DATAFORM 「앗, 츠... %UNICODE(0x2665) *1% ... 벌써 당연하다는 듯 가장 안쪽에서 내고 있잖아」
			ENDDATA
		ENDIF
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「……윽, 나오고 있어……」
				SIF TALENT:思慕
					PRINTFORML (\@ ABL:膣射中毒 >4 ? 아아, 기분 좋아……. 돌아갈 수 없어……. %UNICODE(0x2665) *1% # 우우, 이질감…… \@ )
			CASE 1
				PRINTFORML 「앗, 안... 아...」
				SIF TALENT:思慕
					PRINTFORML (\@ ABL:膣射中毒 >4 ? 아하, 이 감각... 그만둘 수 없어%UNICODE(0x2665) *1% # 정말, 거리낌이 없네... \@ )
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
