@M_KOJO_MESSAGE_SCOM_K105_7
CALL M_KOJO_MESSAGE_SCOM_K105_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K105_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORML 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		PRINTDATAW
			DATAFORM 「응 으윽 %UNICODE(0x2665) *1% 크윽, 흐읍... 안 돼... 아악... 으 %UNICODE(0x2665) *1%」
			DATAFORM 「에윽, 끄윽... 거...기... 너무 괴로워... 어, 응 %UNICODE(0x2665) *1%」
		ENDDATA
		RETURN 1
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TCVAR:105:351 >= 4
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「응윽 %UNICODE(0x2665) *1% 흐으윽…… 끅, 으윽…… %UNICODE(0x2665) *1% 끄윽, 엄청나아…… 좋아 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
					PRINTFORMW 「음응, 더…… 깊이…… 으윽 %UNICODE(0x2665) *1% 아에, 헤헤헤……」
				CASEELSE
					PRINTFORML 「응으윽... 급해, 부서져버릴 것 같아... %UNICODE(0x2665) *1% 끅, 크윽... %UNICODE(0x2665) *1%」
					PRINTFORMW 「앗, 나도... 이제... 으... 아, 하%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「응, 으윽 %UNICODE(0x2665) *1% 깊숙이……. 꽉, 아파…… %UNICODE(0x2665) *1%」
					PRINTFORMW 「자궁……. 범하고 싶어, 응? 후후, 좋아…… %UNICODE(0x2665) *1% 더……. 깊게, 으윽…… %UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 「윽 %UNICODE(0x2665) *1% 갑자기... 밀어붙이기, 너무... 아아 %UNICODE(0x2665) *1%」
					PRINTFORMW 「아앗 아... 돌려줘... 기분 좋아... %UNICODE(0x2665) *1%」
			ENDSELECT
		ELSE
			PRINTFORML 「ん゛읏……ちょと읏、苦しぃ……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……けど……これ、ぇ……읏%UNICODE(0x2665) *1% あ、あぁ……%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF EXP:子宮口開発経験 > 25
		IF TALENT:恋人 || TALENT:恋慕
			PRINTDATAW
				DATAFORM 「응윽, 우에……. 안쪽, 윽……. 이거, 터져버릴 것 같아……. 윽, 아…… %UNICODE(0x2665) *1%」
				DATAFORM 「어, 윽…… 박혀, 버려……. %UNICODE(0x2665) *1% %CALLNAME:MASTER%흑, 전부……. 끝, 어」
			ENDDATA
		ELSE
			PRINTFORMW 「윽, 우, 아...... 후윽, 카......」
			SIF TALENT:思慕
				PRINTFORMW (이거, 안 될지도 몰라... 가장 깊숙한 곳까지, %조사처리(CALLNAME:MASTER,"의")% 것이 되고 있는 거야...)
		ENDIF
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			PRINTDATAW
				DATAFORM 「윽, 안 돼... 무리야, 잠깐만...!」
				DATAFORM 「큭... 너무 깊어... 용서해줘...」
			ENDDATA
		ELSE
			PRINTFORMW 「흐, 윽……그만해……」
			SIF TALENT:思慕
				PRINTFORMW (무모해지기 너무 심하잖아... 설마, 내가 약한 걸까...)
		ENDIF
	ENDIF
ENDIF
