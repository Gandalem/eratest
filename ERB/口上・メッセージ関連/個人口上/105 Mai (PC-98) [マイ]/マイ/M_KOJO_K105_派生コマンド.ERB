;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K105_6
CALL M_KOJO_MESSAGE_SCOM_K105_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K105_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORML 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		PRINTDATAW
			DATAFORM 「! 응으으응 %UNICODE(0x2665) *1% 아아앙 %UNICODE(0x2665) *1% 끅, 힉그, 응 %UNICODE(0x2665) *1%」
			DATAFORM 「응잇! 안 돼 안 돼, 거기, 오오 %UNICODE(0x2665) *1% 야앗, 아아앗!」
		ENDDATA
		RETURN 1
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TCVAR:105:351 >= 4
			PRINTFORML 「윽, 야아아!! 히끅, 크으 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1% 거기 위험해어어%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
			PRINTFORMW 「모오옴이이이%UNICODE(0x2665) *1%%UNICODE(0x2665) *1% 어엇, 이상해지네에%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아앙 %UNICODE(0x2665) *1% 거기이 %UNICODE(0x2665) *1% 좋은 데 맞고 있어욧 %UNICODE(0x2665) *1%」
			PRINTFORMW 「좋아, 으히잉 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1% 안 돼, 너무 느껴져버릴 것 같아욧 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「흐윽앗 %UNICODE(0x2665) *1% 잠깐, 어…… %UNICODE(0x2665) *1% 거긴 위험해…… %UNICODE(0x2665) *1%」
			PRINTFORMW 「저, 잠깐만요 %UNICODE(0x2665) *1% 기다려, 라고 말하고 싶어 %UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			PRINTDATAW
				DATAFORM 「앗, 거기, 안 돼... 너무 좋아! 잠깐, 끅, 응응%UNICODE(0x2665) *1%」
				DATAFORM 「그래, 거기로... 야, 우아아악! 히익, 음으윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTFORMW 「!? 저, 거기는... 아 %UNICODE(0x2665) *1%」
			SIF TALENT:思慕
				PRINTFORMW (이제, 좋은 곳이 들켜버렸다... 크윽%UNICODE(0x2665) *1%)
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K105_{SELECTCOM}_1
RETURN 1
