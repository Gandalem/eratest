; Modular ERB: 個人口上/105 Mai (PC-98) [マイ]/マイ/M_KOJO_K105_依頼.ERB
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K105(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K105(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K105(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「그래, %CALLNAME:MASTER%라면……저기, 잠깐 시간 있어?」
			PRINTFORMW 「부탁할 게 있어서……시간 괜찮으면 좋겠는데」
		ELSE
			PRINTFORML 「저기요... %CALLNAME:MASTER%」
			PRINTFORMW 「조금, 부탁하고 싶은 것이 있어요...」
		ENDIF
	CASE "依頼非受託時"
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「무리할 것 같아?」
			PRINTFORMW 「그렇구나, 그럼 어쩔 수 없지…… 스스로 어떻게든 할게, 고마워」
		ELSE
			PRINTFORML 「무리... 알았어」
			PRINTFORMW 「...하아」
			SIF TALENT:思慕
				PRINTFORMW (가능하다면 %조사처리(CALLNAME:MASTER,"가")% 좋았겠지만... 뭐 괜찮아, 스스로 어떻게든 해볼게)
		ENDIF
	CASE "依頼受託時"
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아, 해 줄 수 있어? 그럼 잘 부탁해.」
			PRINTFORMW 「기대하고 있으니까.」
		ELSE
			PRINTFORML 「……해주시는구나」
			PRINTFORMW 「도움이 되겠어……」
		ENDIF
	CASE "依頼確認時"
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「의뢰 내용을 잊었나? 아아, 그렇구나」
			PRINTFORMW 「뭐... 받아들인 것 자체는 기억해주고 있어서 다행이야.」
		ELSE
			PRINTFORML 「어떤 의뢰였던 거지...?」
			PRINTFORMW 「...잊고 있었네」
			SIF TALENT:思慕
				PRINTFORMW (음... 내버려 두는 것만으로 괜찮을까, 불안해지기 시작했다)
		ENDIF
	CASE "依頼破棄時"
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「없었던 일로 해줬으면 해? 그래」
			PRINTFORMW 「어쩔 수 없는 거니까... 알았어, 신경 쓰지 마.」
		ELSE
			PRINTFORML 「아, 의뢰 건에 대해서... 취소?」
			PRINTFORMW 「알았어...」
			SIF TALENT:思慕
				PRINTFORMW (깔끔하게 거절해 주는 것만으로도... 내버려지는 것보다는 나은 걸까)
		ENDIF
	CASE "依頼実行直前"
		;●[367]で依頼を実行する時、実行処理の前に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【◆口上】
		;【実行時の地の文・ソース等】
		;【▼下の口上に続く】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		ENDIF
	CASE "依頼実行直後"
		;●[367]で依頼を実行する時、実行処理の後に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【▲上の口上から続き】
		;【◆口上】
		;【達成時・CLIENT：▼下の口上に続く】
		;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ENDIF
	CASE "成功報告時"
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「후훗, 역시 대단하네... 역시 %조사처리(CALLNAME:MASTER,"에게")% 부탁하길 다행이야」
			PRINTFORMW 「혹시 모르니 감사 표시도 준비해 두었으니까」
		ELSE
			PRINTFORML 「고마워」
			PRINTFORMW 「보상도 있네... 가지고 가렴」
			SIF TALENT:思慕
				PRINTFORMW (……꽤, 믿음직할지도 모르겠네)
		ENDIF
	CASE "失敗報告時"
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「저기, %CALLNAME:MASTER%……부탁했던 일 말인데」
			PRINTFORMW 「……변명할 게 있다면 들어줄게」
		ELSE
			PRINTFORML 「……부탁했던 건」
			PRINTFORMW 「잊어도 돼……. 지금까지와 마찬가지로」
			SIF TALENT:思慕
				PRINTFORMW (의외로, 대충 하는 사람이네... 조심해야겠다)
		ENDIF
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
ENDSELECT
RETURN 1
;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================

@M_KOJO_IRAI_1_K105(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「청소... 아무래도 생각대로 진행이 안 되어서」
			IF ABL:MASTER:清掃技能 >= 4
				PRINTFORMW 「겸사겸사, %조사처리(CALLNAME:MASTER,"의")% 방법도 배우고 싶네」
			ELSE
				PRINTFORMW 「질려왔으니까, %조사처리(CALLNAME:MASTER,"랑")% 같이 하고 싶어진 것 같아」
			ENDIF
		ELSE
			PRINTFORML 「보수는 줄게……」
			IF ABL:MASTER:清掃技能 >= 4
				PRINTFORMW 「……자랑이야?」
			ELSE
				PRINTFORMW 「……어쨌든, 인력이 필요해」
			ENDIF
			SIF TALENT:思慕
				PRINTFORMW (보이면 곤란한 것은 제대로 숨겨두었지... 뭐, %CALLNAME:MASTER%라면)
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「뭐야, 어쩔 수 없지……. 그럼 성실하게 해야겠네」
			PRINTFORMW 「기분이 되면 도와주면 기쁠 거야」
		ELSE
			PRINTFORML 「안 되면 됐어」
			PRINTFORMW 「자기 방이니까... 스스로」
			SIF TALENT:思慕
				PRINTFORMW (뭐... 언젠가 하겠지)
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아, 꽤 의욕이 넘치는 거야?」
			IF ABL:MASTER:清掃技能 >= 4
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 있다면, 끝난 것이나 다름없을까」
			ELSE
				PRINTFORMW 「뭐, 편하게... 느긋하게 하자.」
			ENDIF
		ELSE
			PRINTFORML 「잘 부탁해」
			PRINTFORMW 「좋아하는 대로 해줘도 상관없으니까...」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「어라... 이렇게 깨끗했나」
				PRINTFORMW 「뭐, %CALLNAME:MASTER%에게는 정돈되어 있다면 틀림없이 아름답겠지」
			ELSE
				PRINTFORML 「할 곳이 없는 거야?」
				PRINTFORMW 「...확실히, 그런 것 같아...?」
			ENDIF
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			IF TALENT:恋人 || TALENT:恋慕
				IF ABL:MASTER:清掃技能 >= 4
					PRINTFORML 「자, 어디서부터 할까」
					PRINTFORMW 「...괜찮으세요? 프로님?」
				ELSE
					PRINTFORML 「어디부터 손을 대는 게 좋을까……」
					PRINTFORMW 「저쪽은 귀중품이 많으니 조심해.」
				ENDIF
			ELSE
				PRINTFORML 「...시작하자」
				PRINTFORMW 「모르는 게 있으면 물어봐」
			ENDIF
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人 || TALENT:恋慕
			IF CFLAG:105:1005 == 0 && GETBIT(CFLAG:既成事実 , 1) && !TALENT:処女
				;なんか変に長いけど、落としたあとのマイの依頼をこなしてくれるような奇特な人向けだし良いよね…いいのか？
				PRINTFORML 
				PRINTFORMDW …………
				PRINTFORMDL 마이의 방은 불결하다고 할 수는 없지만, 물건이 많아서 어지럽게 보인다.
				PRINTFORMDL 필요 없는 것은 판단받고 있지만, 그다지 줄어들지는 않을 것 같다.
				PRINTFORMDW 정돈된 인상을 주려면 어딘가에 치워야 한다. 우선 주변 수납공간을 정리하는 것이 좋겠다.
				PRINTFORML 
				PRINTFORML 「음... 상당히 큰일이 될 것 같지만, 어쩔 수 없겠지」
				PRINTFORMW 「알았어, 과감하게 한 번에 정리해 버리자.」
				PRINTFORMDL 예상보다 시간이 걸릴 것 같지만, 의뢰로 맡은 일이다. 끝까지 해내야 한다.
				PRINTFORMDW 책임감에 이끌린 %조사처리(CALLNAME:MASTER,"는")% 서둘러 가까이에 있던 서랍을 열었다.
				PRINTFORMW 「그럼 %조사처리(CALLNAME:MASTER,"는")% 저쪽을――앗, 거긴 열면 안 돼……!」
				PRINTFORMDW 당황하는 마이를 뒤로하고 서랍 속을 확인해보니, 막대 모양의 기구들이 몇 개 들어 있었다.
				PRINTFORMDW 형태는 남성의 성기를 본떠 만들었으며, 스위치 같은 것이 부착되어 있다.
				PRINTFORMDW 시험 삼아 스위치를 넣자, 진동하면서 꿈틀거리며 움직이기 시작했다.
				PRINTFORMW 「저기... 그게...」
				PRINTFORMW 「그건... 약품을 섞거나 휘젓는 데 편리한 거야... 조제할 때 같은 거.」
				PRINTFORMW 「봐... 움직이면서 진동도 한다고...?」
				PRINTFORMDL 
				CALL ASK_YN("더욱 추궁한다","납득한다")
				IF !RESULT
					PRINTFORMDW 이런 것으로 약을 섞을 리가 없어.
					PRINTFORMDW 재질도 불안하고, 마이가 가지고 있는 용기에 비해 크기가 너무 커.
					PRINTFORMDW 애초에 왜 남성기의 형태를 하고 있어야 하는 거지?
					PRINTFORML 「네…… 저도 그렇게 생각해요……」
					PRINTFORMW 「조합에 사용한 적 없어요…… 죄송해요…… 우우」
					PRINTFORMDL 이게 무슨 일이야. 마이는 거짓말을 하고 있었어.
					PRINTFORMDW 마법 연구를 한다고 말해놓고……. 연구자가 거짓말을 하다니, 용납할 수 없어.
					PRINTFORMW 「이제 그만 좀 해줘……」
					PRINTFORMDW ——하지만 정말 전부 거짓인 걸까? 
					PRINTFORMDW 이 기구를 사용해서 저어주는 것이 효과가 있는 경우도 있지 않을까?
					PRINTFORMDW 진동하면서 어느 정도의 크기가 필요하고, 남성기 형태가 유효한 경우다.
					PRINTFORMW 「잠깐……? 설마, %CALLNAME:MASTER%」
					PRINTFORMDW "유효한 경우"에 대한 답은 있어.
					PRINTFORMDW 하지만 정말 유효한지는 실험해 보지 않으면 알 수 없어.
					PRINTFORMDW 마이의 무죄를 증명하기 위해서라도 지금 바로 실험해 봐야겠지.
					PRINTFORML 「우으, 역시……」
					PRINTFORMW 「이번엔 제가 잘못했으니까…… 알았어요, 마음대로 해요……」
					PRINTFORMDW 그렇게 말하자 마이는 속옷을 벗기 시작했다. 아직 어디에 사용할지도 말하지 않았는데, 잘 이해하고 있는 것 같아.
					PRINTFORMDW 물론 그럴 생각이었으니, 이쪽으로도 편리하다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 마이에게 다리를 벌리게 하고, 부분을 자세히 관찰하기 시작했다.
					PRINTFORMW 「뭐야…… 부끄러우니까 너무 많이……」
					PRINTFORMDW 실험에서는 잘 저어졌는지, 그 효과를 확인해야 해.
