@M_KOJO_IRAI_12_K105(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「개인적인 원한이 있긴 한데…… 직접적으로 대립하는 건 별로 좋아하지 않아.」
			PRINTFORML 「그렇다고 그저 참는 것도 내 성격에 맞지 않아서.」
			PRINTFORMW 「내 손길을 들키지 않는 선에서, 괴롭혀 주지 않을래?」
		ELSE
			PRINTFORML 「승부해서, 지게 해줬으면 좋겠어」
			PRINTFORML 「자세한 이유는 좀 할 수 없지만……」
			PRINTFORMW 「그래도 괜찮다면…… 보수는 줄게」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「엣, 승부? 좋지만, 갑자기 왜 그래」
				PRINTFORML 「뭐, 무슨 눈이야... 뭔가, 가볍게 노는 느낌이 아닌 것 같은데」
				PRINTFORMW 「흠... 뭐 됐어, 일단 해보자」
			ELSE
				PRINTFORML 「승부라니... 나랑?」
				PRINTFORML 「...설마...」
				PRINTFORMW 「...알겠어, 시작하자」
			ENDIF
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「어, 어떻게든 됐나…….」
					PRINTFORML 「하지만……. 아무래도 %조사처리(CALLNAME:MASTER,"를")% 쓰러뜨려도 아무것도 해결되지 않는 것 같아.」
					PRINTFORMW 「하아, 어떡하지…….」
				ELSE
					PRINTFORML 「……후우」
					PRINTFORMW 「승부라면, 언제든 받아들이겠어……다른 상대라도」
				ENDIF
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「역시 강하네…… 일단, 진심인데」
				PRINTFORML 「틀림없이, 나의 패배야! 나는 %조사처리(CALLNAME:MASTER,"에게")%, 두들겨 맞았어」
				PRINTFORMW 「누구에게 물어도, 그렇게 대답해 둘 테니…… 안심해」
			ELSE
				PRINTFORML 「내가 패배했네……」
				PRINTFORMW 「……필요하다면 증명서 같은 걸 내줄게.」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「알고 있어, 제대로 보고 있었으니까」
			PRINTFORML 「후후후후……아아, 후련해졌어%UNICODE(0x2665) *1%」
			PRINTFORMW 「그럼, %CALLNAME:MASTER%에게는 보상을…… 또 부탁하게 될지도 몰라%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「해준 것 같네……」
			PRINTFORML 「도움이 됐어…… 보상, 받아가」
			PRINTFORMW 「……다른 말은 할 필요 없어, 응」
			SIF TALENT:思慕
				PRINTFORMW (후후후후, 기분 좋네... %UNICODE(0x2665) *1%)
		ENDIF
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
