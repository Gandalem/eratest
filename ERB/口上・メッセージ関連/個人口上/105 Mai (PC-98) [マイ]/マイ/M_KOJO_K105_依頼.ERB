;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K105(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「스스로 말하기엔 그렇지만, 집에서만 틀어박혀 마법 연구 같은 것만 하고 있었던 탓일까... 세상 물정 모른다, 뭐 그런.」
			PRINTFORML 「왠지 일반적인 상식이 부족한 것 같아.」
			PRINTFORMW 「그런 교양 같은 건 %조사처리(CALLNAME:MASTER,"가")% 더 잘 알잖아요?」
		ELSE
			PRINTFORML 「조금…… 마계와의 문화적인 차이 같은 걸요」
			PRINTFORMW 「확인하고 싶은 게……」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「음... 어렴풋이 듣는 것보다 정보원이 명확한 게 좋겠지」
						PRINTFORMW 「뭐, 자료 쪽이 틀렸다면 방법이 없겠지만」
					ELSE
						PRINTFORML 「흠…」
						PRINTFORMW 「……좋은 정보가 발견되면 좋겠는데」
					ENDIF
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「과연, 그렇다면 설명이 붙을 것 같네」
					PRINTFORMW 「하아... 정말 다행이야.」
					PRINTFORML 
				ELSE
					PRINTFORML 「아아... 그런 거구나」
					PRINTFORMW 「잘 알겠어...」
					PRINTFORML 
				ENDIF
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 생각은 이해했지만……. 어쩐지, 마음에 와닿지 않는 느낌이야」
					PRINTFORMW 「분명 아직 뭔가……. 부족한 정보가 있다고 생각해.」
					PRINTFORML 
				ELSE
					PRINTFORML 「아니... 아직, 뭔가」
					PRINTFORMW 「...아뇨, 이제 됐어요...」
					SIF TALENT:思慕
						PRINTFORMW (이 이상은, 들어도 소용없는 것 같네… 일단 다시 생각해 볼까)
					PRINTFORML 
				ENDIF
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「음...... 아무래도 너무 기대를 걸었던 걸지도 모르겠어」
			PRINTFORML 「왠지 %조사처리(CALLNAME:MASTER,"는")% 뭐든지 할 수 있을 것 같은 이미지가 생겨버렸나 봐......」
			PRINTFORMW 「안 좋을지도 몰라」
		ELSE
			PRINTFORML 「……」
			PRINTFORMW 「뭐, 안 되는 건 어쩔 수 없지...」
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
