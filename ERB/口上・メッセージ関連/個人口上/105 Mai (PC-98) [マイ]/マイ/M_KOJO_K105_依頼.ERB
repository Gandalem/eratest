		ELSEIF TFLAG:193 == -2
			;正解の選択肢だったが逆にハズレ
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「역시, 그렇게 생각해?」
				PRINTFORML 「하지만…… 아무래도 다른 것 같아.」
				PRINTFORMW 「%CALLNAME:MASTER%라면, 뭔가 새로운 시점으로 봐 줄지도 모른다고 생각했는데」
			ELSE
				PRINTFORML 「그렇네……나도 처음엔 그렇게 생각했어」
				PRINTFORMW 「……그러니까, 그건 정답이 아니야」
			ENDIF
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：野菜か果物
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 
			PRINTFORML 「일단, 후련해졌으니까…… 약속대로 보수는.」
			PRINTFORMW 「이런 건 역시 %CALLNAME:MASTER%뿐이야…… 또 잘 부탁해.」
		ELSE
			PRINTFORML 
			PRINTFORML 「이제 충분해」
			PRINTFORMW 「일단, 이걸 줄게…」 
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML
			PRINTFORML 「특별히 어떤 해결도 되지 않았지만…… 뭐, 상관없겠지」
			PRINTFORML 「들어줘서 고마워요, %CALLNAME:MASTER%」
			PRINTFORMW 「하지만, 보상은 없는 걸까요」
		ELSE
			PRINTFORML 
			PRINTFORML 「이제 충분해」
			PRINTFORMW 「그럼……」 
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "口上委託率"
		;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
		RESULT:100 = 100
		;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
		;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
		;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
		;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
		RESULT:0 = 0
		RESULT:23 = 0
		RESULT:24 = 0
		RESULT:25 = 0
		RETURN 1
	CASE "口上専用"
		;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
		;16,お悩み相談 の場合
		;RESULT        発生判定,0だと発生しません
		;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
		;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
		;RESULTS:0     お悩み文章（自動で『』で囲まれます）
		;RESULTS:1～3  選択肢１～３
		;何も発生しない状態になると無限ループになるので注意してください
		;●追記メモ
		;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
		;RESULT:1を7にするとどれも正解になります
		;RESULT:1を8にするとどれもハズレになります
		;1～3以外の場合は逆張り判定が自動で無くなります
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:4
				CASE 0
					RESULT = 1
					RESULTS:0 = 会ったばかりの頃と今、どっちのわたしが好き？
					RESULTS:1 = 今が良い
					RESULTS:2 = 昔が良かった
					RESULTS:3 = 変わらない
					RESULT:1 = 7
					RESULT:2 = 1
					TFLAG:194 = 2
				CASE 1
					RESULT = 1
					RESULTS:0 = 調合に失敗して……このレシピなんだけど、何か違うかな
					RESULTS:1 = 材料が間違っている
					RESULTS:2 = 手順に抜けがある
					RESULTS:3 = レシピ以外に問題がある
					RESULT:1 = RAND:3 + 1
					RESULT:2 = 0
				CASE 2
					RESULT = 1
					RESULTS:0 = なんか、下着が飛んできて……これ、どうしよう？
					RESULTS:1 = 持ち主を探して返す
					RESULTS:2 = 面倒事になる前に捨てる
					RESULTS:3 = 寄越せ！
					RESULT:1 = 6
					RESULT:2 = 1
					TFLAG:194 = 3
				CASE 3
					SIF CFLAG:48:面識 && CFLAG:102:面識 && CFLAG:103:面識
						RESULT = 1
					RESULTS:0 = わたし以外の魔界人、一人選ぶなら……
					RESULTS:1 = ルイズ
					RESULTS:2 = 夢子
					RESULTS:3 = 神綺
					RESULT:1 = 6
					RESULT:2 = 1
					TFLAG:194 = 4
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					RESULT = 1
					RESULTS:0 = 苦手な知り合いを、どう扱う？
					RESULTS:1 = 我慢して、表面的には仲良くする
					RESULTS:2 = はっきりと拒絶する
					RESULTS:3 = 好きになれるよう、良い所を探してみる
					RESULT:1 = 6
					RESULT:2 = 1
					TFLAG:194 = 2
				CASE 1
					RESULT = 1
					RESULTS:0 = 調合に失敗して……このレシピ、何か違う？
					RESULTS:1 = 材料が間違っている
					RESULTS:2 = 手順に抜けがある
					RESULTS:3 = レシピ以外に問題がある
					RESULT:1 = RAND:3 + 1
					RESULT:2 = 0
				CASE 2
					RESULT = 1
					RESULTS:0 = 誰かの下着を拾ったの……どうするべき？
					RESULTS:1 = 持ち主を探して返す
					RESULTS:2 = 面倒事になる前に捨てる
					RESULTS:3 = 寄越せ！
					RESULT:1 = 6
					RESULT:2 = 1
					TFLAG:194 = 3
				CASE 3
					RESULT = 1
					RESULTS:0 = わたしの印象は？
					RESULTS:1 = 可愛い
					RESULTS:2 = 怪しい
					RESULTS:3 = エッチだ
					RESULT:1 = 7
					RESULT:2 = 1
			ENDSELECT
		ENDIF
		;▼サンプル
		SIF !RESULT
			RESTART
		RETURN 1
ENDSELECT
