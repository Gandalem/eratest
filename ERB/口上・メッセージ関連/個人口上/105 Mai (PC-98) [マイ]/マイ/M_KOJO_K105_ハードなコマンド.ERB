;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K105_140
CALL M_KOJO_MESSAGE_COM_K105_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		PRINTFORML 
		RETURN 1
		;通常
	ELSE
		IF ABL:マゾっ気 < 2
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「응, 우!? 윽, 음...음...」
				PRINTFORMDW 갑작스러운 격렬한 행위에 마이는 비난 섞인 눈길을 보내고 있지만, 특별히 저항하는 모습은 없다.
			ELSE
				PRINTFORML 「응윽! 음~!」
				PRINTFORMDW 마이는 얼굴을 돌리려 몸부림치고 있다...
			ENDIF
		ELSE
			IF TALENT:恋人 || TALENT:恋慕
				IF CFLAG:105:1006
					PRINTFORMDL 마이는 스스로 %조사처리(CALLNAME:MASTER,"의")% 음경을 삼키는 것처럼 얼굴을 밀착시키고, 목구멍 깊숙한 곳을 이용해 봉사하기 시작했다.
					PRINTFORMDL 괴로울 듯 신음하면서도 그 목소리에는 달콤한 음색이 섞여 있었고, 어딘가 기뻐하는 모습이었다...
					PRINTFORML 「응으으, 응앗, 거어%UNICODE(0x2665) *1% 컥, 꾸릅... 응%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORML 「응, 크윽……%UNICODE(0x2665) *1% 오고, 푸……%UNICODE(0x2665) *1%」
					PRINTFORMDW 마이는 괴로워하면서도 얼굴과 혀를 움직이듯 적극적으로 봉사하고 있다.
				ENDIF
			ELSE
				PRINTFORMDL 마이는 반사적으로 약간의 저항을 보였지만, 곧 순순히 행위를 받아들였다.
				PRINTFORMW 「흐윽...응부, 우으...」
				SIF TALENT:思慕
					PRINTFORMW (괴롭다... 괴롭지만... 의외로, 이건...)
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1

@M_KOJO_EXTRASOURCE_COM_K105_140
IF TALENT:恋人 || TALENT:恋慕
	SELECTCASE CFLAG:105:1006
		CASE 0
			SOURCE:反感 = 300
		CASE 1
			SOURCE:屈従 += ABL:105:マゾっ気 * 150
			SOURCE:反感 = 0
			SOURCE:快Ｍ += ABL:105:マゾっ気 * 100
			TIMES DOWNBASE:体力 , 0.50
			TIMES DOWNBASE:気力 , 0.50
		CASE 2
			SOURCE:屈従 += ABL:105:マゾっ気 * 300
			SOURCE:反感 = 0
			SOURCE:快Ｍ += ABL:105:マゾっ気 * 200
			TIMES DOWNBASE:体力 , 0.30
			TIMES DOWNBASE:気力 , 0.30
		CASE 3
			SOURCE:屈従 += ABL:105:マゾっ気 * 500
			SOURCE:反感 = 0
			SOURCE:快Ｍ += ABL:105:マゾっ気 * 300
			SOURCE:快Ｖ += ABL:105:マゾっ気 * 30
			TIMES DOWNBASE:体力 , 0.10
			TIMES DOWNBASE:気力 , 0.10
		CASEELSE
	ENDSELECT
ENDIF
RETURN 1
