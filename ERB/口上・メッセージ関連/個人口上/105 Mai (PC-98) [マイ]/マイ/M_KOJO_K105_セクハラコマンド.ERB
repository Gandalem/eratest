;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K105_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K105_310
CALL M_KOJO_MESSAGE_COM_K105_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 너는 그 형상을 익히기 위해 손으로 %ALTNAME_REGULAR([[マイ]])%'의 엉덩이를 조심스럽게 더듬었다...
		PRINTFORMDL 굉장한 엉덩이다. 많은 비행과 움직임에도 상대적으로 단단하고 탄탄하다.
		PRINTFORMDW 너는 그 감각을 마음껏 즐겼다...
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...응, 으음...」
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아앗, 엉덩이 만져줘...」
			PRINTFORMW 「어때, 나의...?」
		ELSE
			PRINTFORML 「음...?」
			PRINTFORMW 「왠지... 이상한 느낌이야」
		ENDIF
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「응... %UNICODE(0x2665) *1%」
			PRINTFORMW 「... 참지 않아도 괜찮으니까?」 
		ELSE
			PRINTFORML 「흐윽...」
			PRINTFORMW 「...더, 세게 해도... 괜찮지만」
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		IF TCVAR:媚薬 || TCVAR:発情
			IF TCVAR:105:351 >= 4
				PRINTFORML 「아아우, 짜릿해지지만……」
				PRINTFORMW 「어디든 좋으니까, 구멍에 넣어줘 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「응, 간지러워... %UNICODE(0x2665) *1%」
				PRINTFORMW 「하지만, 엉덩이 정도만으로 만족하게 하면 곤란해... %UNICODE(0x2665) *1%」 
			ELSE
				PRINTFORML 「흐윽...」
				PRINTFORMW 「...더, 세게 해도... 괜찮지만」
			ENDIF
		ELSEIF TALENT:恋人
			PRINTFORML 「음~, 내 엉덩이 말이야?」
			PRINTFORMW 「알겠어, 천천히 해...%UNICODE(0x2665) *1%」
		ELSEIF TALENT:恋慕
			PRINTFORML 「하얀%UNICODE(0x2665) *1%」 
			PRINTFORMW 「와이-, 그런 식으로 문지르는 건...」
		ELSE
			PRINTFORML 「우와...」
			PRINTFORMW 「너무 오래 걸리지 마...」
		ENDIF
	ELSE
		SELECTCASE TFLAG:193
			CASE 1, 2, 3
				IF TALENT:恋人
					PRINTFORML 「히이―」
					PRINTFORMW 「응, 갑자기 뭘 원하는 거야?」
				ELSEIF TALENT:恋慕
					PRINTFORML 「와, 잠깐-」 
					PRINTFORMW 「왜 그렇게 아무렇지도 않게 나를 만지는 거야?」
				ELSE
					PRINTFORML 「히익...」
					PRINTFORMW 「뭐야...? 그만해.」
				ENDIF
			CASE 4
				IF TALENT:恋人
					PRINTFORML 「음...?」
					PRINTFORMW 「눈치채지 못했다면 말인데... 이렇게 하면서 행복해하는 네 모습이 완전 변태처럼 보여.」
				ELSEIF TALENT:恋慕
					PRINTFORML 「우와! 오, 그만둬...」 
					PRINTFORMW 「상관없지만... 그게 놀랐으니까, 적어도 당신을 볼 수 있을 때 해줘.」
				ELSE
					PRINTFORML 「음...」
					PRINTFORMW 「이제 어떡하지...?」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
