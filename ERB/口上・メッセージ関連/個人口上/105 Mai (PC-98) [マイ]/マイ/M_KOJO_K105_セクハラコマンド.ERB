			ELSE
				PRINTFORML 「아, 아……」
				PRINTFORMW 「……키스라니, 이렇게……」
			ENDIF
		ELSEIF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「음―%UNICODE(0x2665) *1%」
					PRINTFORMW 「하아... 아니, 천천히 해...」
				CASEELSE
					PRINTFORML 「음...흡.」
					PRINTFORMW 「후훗, %조사처리(CALLNAME:MASTER,"의")% 맛은...%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「후후... 키스를 좋아하는 것 같네.」
					PRINTFORMW 「나도... 이게 좋아.」
				CASEELSE
					PRINTFORML 「음...」
					PRINTFORMW 「하아... 얼굴이 뜨거워지네.」
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORML 「응... 음프...」
			PRINTFORML 「흥...」
			PRINTFORMW (으음, 언제나처럼 갑작스럽네... 이건 내 심장에 안 좋아.)
		ELSE
			PRINTFORML 「음, 음...?!」
			PRINTFORMW 「잠깐만, 떨어져...」
		ENDIF
	ENDIF
ENDIF
