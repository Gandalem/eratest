;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K105_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K105_312
CALL M_KOJO_MESSAGE_COM_K105_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDW 당신은 %ALTNAME_REGULAR([[マイ]])%의 입을 마음껏 침범한다...
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...음...」
	ELSEIF TFLAG:193 == 99
		PRINTFORML
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「응? ……%UNICODE(0x2665) *1% 음-읏%UNICODE(0x2665) *1% ……후훗%UNICODE(0x2665) *1%」
			PRINTFORMW 「있잖아, 더…… %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「음, 응? 음-, 응-... 푸하」
			PRINTFORMW 「뭐 하는 거야...? 숨 막혀...」
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		IF TCVAR:媚薬 || TCVAR:発情
			IF TCVAR:105:351 >= 4
				PRINTFORML 「응, 음……혀가 기분 좋아……%UNICODE(0x2665) *1% 더 줘……%UNICODE(0x2665) *1%」
				PRINTFORMW 「하아……입이 말라가는 것 같아서……」
			ELSEIF TCVAR:105:351
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「%CALLNAME:MASTER%에게도……미약, 나눠 줄까……%UNICODE(0x2665) *1%」
					PRINTFORMW 「아마 남아있을 테니까…… 핥아 먹고 싶어%UNICODE(0x2665) *1%」 
				ELSE
					PRINTFORML 「음, 후우……」
					PRINTFORMW 「좀 더……」
				ENDIF
			ELSE
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「아아, 아아... 머리가 녹아버려... %UNICODE(0x2665) *1%」
					PRINTFORMW 「더... 한 번만 더... %UNICODE(0x2665) *1%」
				ELSE
					PRINTFORML 「음, 후우……」
					PRINTFORMW 「좀 더……」
				ENDIF
			ENDIF
		ELSE
			SELECTCASE TCVAR:20
				CASE 85, 86, 87, 88, 89 ;性交
					IF TALENT:恋人 || TALENT:恋慕
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「하아, 음프...」
								PRINTFORMW 「응, 우린 완전히 연결됐어...%UNICODE(0x2665) *1%」
							CASEELSE
								PRINTFORML 「헤헤, 너무 격렬해...」
								PRINTFORMW 「그래, 계속 나를 농락해줘...%CALLNAME:MASTER%%UNICODE(0x2665) *1%」
						ENDSELECT
					ELSE
						PRINTFORML 「흐읍! 흐으읍...」
						PRINTFORMW 「오-오, 당신은... %UNICODE(0x2665) *1%」
					ENDIF
				CASEELSE
					IF TALENT:恋人 || TALENT:恋慕
						PRINTFORML 「음...음흠...%UNICODE(0x2665) *1%」
						PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 당신의 입술을 음미하는 데 몰두하고 있다...
					ELSE
						PRINTFORML 「Nn...」
						PRINTFORMW 「푸하, 키스라니...%UNICODE(0x2665) *1%」
					ENDIF
			ENDSELECT
		ENDIF
	ELSEIF EXP:TARGET:キス経験 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아... 키스...%UNICODE(0x2665) *1%」
			PRINTFORML 「그게 사실 내 첫 경험이었어.」
			PRINTFORMW 「너는 정말 특별한 사람이 되었구나...%CALLNAME:MASTER%%UNICODE(0x2665) *1%」
		ELSEIF TALENT:思慕
			PRINTFORML 「Nn...」
			PRINTFORMW (%조사처리(CALLNAME:MASTER,"는")%/는... 이 사람이 나의 첫 번째 것을 가져갔어...)
		ELSE
			PRINTFORML 「?!...」
			PRINTFORMW 「그건 나의...」
			PRINTFORMW 「됐어...」
			PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 충격을 받은 듯하다... 네가 너무 서두르고 있는 건 아닌지 궁금해진다.
