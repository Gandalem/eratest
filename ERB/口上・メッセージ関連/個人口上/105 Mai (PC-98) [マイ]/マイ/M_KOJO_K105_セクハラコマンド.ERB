;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K105_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K105_311
CALL M_KOJO_MESSAGE_COM_K105_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 저항이 없을 것을 알고, 당신은 온 힘을 다해 그녀를 껴안는다...
		PRINTFORMDW 그녀의 가슴과 허리... 평소 헐렁한 옷에 가려져 있던 %ALTNAME_REGULAR([[マイ]])%'의 몸의 선들이 당신에게 분명하게 전달된다.
		;ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%...%UNICODE(0x2665) *1%」
			PRINTFORMW 「흐응... 후후.」
		ELSEIF TALENT:思慕
			PRINTFORMW 「Nn...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「음...」
			PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 당신의 손아귀에서 벗어나려고 몸부림친다...
		ENDIF
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「! ……응……%UNICODE(0x2665) *1%」
			PRINTFORMW 「……후우, 기분 좋다……」
		ELSE
			PRINTFORML 「좀, 방해하지 마...」
			PRINTFORMW 「우윽」
		ENDIF
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		IF TCVAR:105:351 >= 4
			PRINTFORML 「아, 아…… 만지는 곳 전부 기분 좋아……%UNICODE(0x2665) *1%」
			PRINTFORMW 「전신이 흥분해버릴 것 같아%UNICODE(0x2665) *1%」
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「아아... 오늘은 계속 이대로 있으면 좋겠어... %UNICODE(0x2665) *1%」
			PRINTFORMW 「그렇지 않으면... 정신이 이상해질 것 같아」
		ELSE
			PRINTFORML 「큭……흐응」
			PRINTFORMW 「조, 좀 더……세게」
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			CASE 60 ;ディープキス
				PRINTFORML 「흐으...응, 음... 푹。」
				PRINTFORMW 「아니, 아직 놓지 마...」
			CASE 73 ;ぱふぱふ
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORMW 「후후...%UNICODE(0x2665) *1% 아프지 않아?」
				ELSE
					PRINTFORML 「...하아.」
					PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 한숨을 내쉬지만 당신의 머리를 안는다...
				ENDIF
			CASE 77 ;乳を吸わせる
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「잠깐, 그건...햐아앙%UNICODE(0x2665) *1%」
					PRINTFORMW 「괜찮아, 나 어디 안 가니까... 천천히 해.」
				ELSE
					PRINTFORML 「우와, 이건...」
					PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%가 당신에게서 벗어나려고 꿈틀거리고 있어...
				ENDIF
			CASE 85, 87, 88, 89 ;性交
				IF TALENT:恋人 || TALENT:恋慕
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「아...%UNICODE(0x2665) *1% 내 차례인데도 말이야.」
						CASEELSE
							PRINTFORMW 「후후, 잡았다%UNICODE(0x2665) *1%」
					ENDSELECT
				ELSE
					PRINTFORMW 「흐읍... 더... %UNICODE(0x2665) *1%」
				ENDIF
			CASE 86 ;ホールド
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「응, 후우...」
					PRINTFORMW 「맞아... 서로 하나가 될 정도로 단단해... %UNICODE(0x2665) *1%」
				ELSE
					PRINTFORML 「기-, 잠깐만...」
					PRINTFORMW 「아파...%UNICODE(0x2665) *1%」
				ENDIF
			CASEELSE
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「음... 응, 더 세게...」
					PRINTFORMW 「...이거 나를 안심시켜 주네.」
				ELSE
					PRINTFORML 「Ah...%UNICODE(0x2665) *1%」
					PRINTFORMDW 이미 당신과 가까운 접촉 상태인 채로, %ALTNAME_REGULAR([[マイ]])%는 당신을 더 세게 껴안는다...
				ENDIF
		ENDSELECT
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「음...」
					PRINTFORMW 「놓지 마.」
				CASEELSE
					;					PRINTFORMW 「You don't have to hold me this close, I'm already yours, %CALLNAME:MASTER%...%UNICODE(0x2665) *1%」
					PRINTFORMW 「그렇게 붙잡고 있지 않아도, 나는 %조사처리(CALLNAME:MASTER,"의")% 것이야……%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아...%UNICODE(0x2665) *1%」
					PRINTFORMW 「이건 조금 고통스럽지만 동시에 안심이 된다.」
				CASEELSE
					PRINTFORML 「정말 따뜻해.」
					PRINTFORMW 「이봐, 더 꼭 안아줘...%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORML 「우에?!」
			PRINTFORML 「갑자기 이게 뭐야...? %UNICODE(0x2665) *1%」
			PRINTFORMW (아아... 나 녹을 것 같아...)
		ELSE
			PRINTFORMW 「...너무 가까워...!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
