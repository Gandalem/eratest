;====================================================================================================

@M_KOJO_MESSAGE_COM_K105_322
CALL M_KOJO_MESSAGE_COM_K105_322_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_322_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:破瓜 == 1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:媚薬 || TCVAR:発情
			IF TCVAR:105:351 >= 4
				PRINTFORML 「아아...... 드디어 왔어...... %UNICODE(0x2665) *1%」
				PRINTFORML 「가려워, 기분 좋아...... %UNICODE(0x2665) *1%」
				PRINTFORMW 「빨리 움직여줘...... %UNICODE(0x2665) *1% 이제 네 마음대로 해도 돼...... %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「아아……이게, 아……%UNICODE(0x2665) *1%」
				PRINTFORML 「이걸로, 더 즐길 수 있어……후후, 후후후……%UNICODE(0x2665) *1%」
				PRINTFORML 「……있잖아, %CALLNAME:MASTER%……」
				PRINTFORMW 「이만큼 해버렸으니까, 제대로 기분 좋게 해줘……%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「아, 으윽... 들어와 있어...」
				PRINTFORMW 「괜찮아... 움직여도 돼.」
				SIF TALENT:思慕
					PRINTFORMW (이걸로, 더 즐길 수 있어……후후, 후후후……%UNICODE(0x2665) *1%)
			ENDIF
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「우, 아...... 정말로 들어와 있어...?」
			PRINTFORML 「들어오는 법이구나, 정말로.」
			PRINTFORML 「...있잖아, 나의 단 한 번의 첫 경험.」
			PRINTFORMW 「모처럼이니까, 천천히 음미해줘.」
		ELSE
			PRINTFORML 「아, 윽... 들어와, 있어...?」
			PRINTFORMW 「괜찮아... 움직여도 돼.」
			SIF TALENT:思慕
				PRINTFORMW (왠지, 싸버렸는데... 이걸로 정말 괜찮은 걸까)
		ENDIF
	ELSE
		IF TCVAR:媚薬 || TCVAR:発情
			IF TCVAR:105:351 >= 4
				PRINTFORML 「응, 아……%UNICODE(0x2665) *1% 더, 깊이 해줘%UNICODE(0x2665) *1%」
				PRINTFORMW 「있잖아, 거칠게 해줘%UNICODE(0x2665) *1% 부수고 싶어……%UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「아아아, 좋은 %UNICODE(0x2665) *1% 역시 이거, 최고야…… %UNICODE(0x2665) *1%」
				PRINTFORMW 「후후후, 빨리 써줘 %UNICODE(0x2665) *1% 벌써 기다릴 수 없어…… %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「아, 아...... 전부 들어갔어...?」
				PRINTFORMW 「마음대로 해줘... 그러면서 나도 기분 좋으니까... %UNICODE(0x2665) *1%」
			ENDIF
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTDATAW
				DATAFORM 「그래, 더 깊숙이... 밀어 넣어줘, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
				DATAFORM 「응, 왔어... %UNICODE(0x2665) *1% 내가 허락할 때까지 빼지 마.」
			ENDDATA
		ELSE
			PRINTFORMW 「우, 아……%UNICODE(0x2665) *1% ……그렇게 확실하게 붙잡아줘……」
			SIF TALENT:思慕
				PRINTFORMW (아, 왔다 왔다... %UNICODE(0x2665) *1%)
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;330,スカートめくり
;TFLAG:193(-5=拒絶（ビンタ） -3=拒絶（つねり） -1=いやがる 0=いやがる（嬉しげ） 1=受け入れ)
;TFLAG:193=1&&ABL:露出癖(5以上=人目のある場所で、自らスカートをまくり上げる 4以下=人目のある場所でめくられるさいに弱い抵抗 3以上=人目のない場所で自らスカートをまくり上げる 3未満=弱い抵抗)
;TFLAG:400(1=デート先or地底のモブが反応する)
;後ろからピラリ、ではなく、前からペラって感じ（そうじゃなかったら、めくり上げようとするのを止めて即座にビンタとか無理、めくり上げられた後にしかならないしその状況ならビンタ食らうより普通に弾幕で一発ＫＯにならないほうがおかしい
;==================================================

@M_KOJO_MESSAGE_COM_K105_330
CALL M_KOJO_MESSAGE_COM_K105_330_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K105_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML
	ELSEIF TCVAR:泥酔 == 1
		PRINTFORML 
	ELSEIF TCVAR:媚薬 || TCVAR:発情
		PRINTFORML 
	ELSE
		SELECTCASE TFLAG:193
			CASE -5, -3, -1
				PRINTFORML 「...무슨 수를 쓰려는 거니?」
				PRINTFORMDL %ALTNAME_REGULAR([[マイ]])%의 시선은 얼음처럼 차갑다...
			CASE 0
				IF TALENT:恋人
					PRINTFORML 「그만둬~, 이건 실례야.」
					PRINTFORMW 「숨겨져 있는 게 더 낫지 않아?」
				ELSEIF TALENT:恋慕
					PRINTFORML 「흥~ 보고 싶어...?」
					PRINTFORMW 「...아니%UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORML 「뭐...」
					PRINTFORML 「무슨 짓을 하는 거야?」
					PRINTFORMW (하아, 너 애가 아니잖아...)
				ELSE
					PRINTFORML 「...하아.」
					PRINTFORMDL %ALTNAME_REGULAR([[マイ]])%는 놀란 듯 보이지만, 불편해하는 것 같지는 않다.
					PRINTFORMDW 아마 그녀는 그것을 일종의 스킨십으로 받아들인 모양이다...
				ENDIF
			CASE 1
				IF GET_TARGETNUM() == 1 && !DATE_HITOGOMI(CFLAG:MASTER:現在位置) && !WITH_MOB()
					IF ABL:露出癖 > 2
						IF TALENT:恋人
							PRINTFORML 「좋아, 좋아, 여기 있어... 천천히 해.」
							PRINTFORMW 「저기... 부끄러우니까 뭐라도 말해봐.」
						ELSEIF TALENT:恋慕
							PRINTFORML 「후후, 보고 싶어? 여기 있어%UNICODE(0x2665) *1%」
							PRINTFORMW 「...내가 직접 하는 건 소용이 없겠지? 그렇구나...」
						ELSEIF TALENT:思慕
							PRINTFORML 「...계속해 봐.」
							PRINTFORMW (어라...? 나 지금 뭐 하는 거지...?)
						ELSE
							PRINTFORML 「...」
							PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%의가 네가 그녀의 치마를 들게 허용했으니, 너는 본 것을 눈에 새긴다...
						ENDIF
					ELSE
						IF TALENT:恋人
							PRINTFORML 「뭐야, 저기요.」
							PRINTFORMW 「아무도 없죠...? 미리 확인해 보셨겠죠, %CALLNAME:MASTER%?」
						ELSEIF TALENT:恋慕
							PRINTFORML 「?!」
							PRINTFORMW 「...딱 이번 한 번만 뒤집을 수 있지만...」
							PRINTFORMW 「대중의 시야에서 치워둬라.」
						ELSEIF TALENT:思慕
							PRINTFORML 「Ah...」
							PRINTFORMW (크윽, 경계를 풀었나...)
						ELSE
							PRINTFORML 「...」
							PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 얼굴에 경악한 표정으로 당신을 응시한다...
						ENDIF
					ENDIF
				ELSE
					IF ABL:露出癖 > 5
						IF TALENT:恋人
							PRINTFORML 「음? 내 치마라고?」
							PRINTFORMW 「여기%UNICODE(0x2665) *1% 후후, 있잖아?」
						ELSEIF TALENT:恋慕
							PRINTFORML 「원하면 내가 잡아줄게.」
							PRINTFORMW 「음... 어때?」
						ELSEIF TALENT:思慕
							PRINTFORML 「...계속해 봐.」
							PRINTFORMW (이거 좀 위험해지는데... 즐기기 시작하는 것 같아.)
						ELSE
							PRINTFORML 「...」
							PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%의가 네가 그녀의 치마를 들게 허용했으니, 너는 본 것을 눈에 새긴다...
						ENDIF
					ELSE
						IF TALENT:恋人
							PRINTFORML 「잠깐, 여기서 하고 싶다고?」
							PRINTFORMW 「공개된 곳이니까 여기여야 한다니... 정말 좋은 성격을 가졌네.」
						ELSEIF TALENT:恋慕
							PRINTFORML 「흐읍, 저기요.」
							PRINTFORMW 「주변에 사람들이 있잖아요...」
							PRINTFORMW 「제발 그렇게 높이 올리지 마세요...」
						ELSEIF TALENT:思慕
							PRINTFORML 「우으... 저기...」
							PRINTFORMW (다른 사람들도 이거 볼 수 있을까...?)
						ELSE
							PRINTFORML 「...」
							PRINTFORMDW %ALTNAME_REGULAR([[マイ]])%는 경계하며 주변을 살피고 있다...
						ENDIF
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
