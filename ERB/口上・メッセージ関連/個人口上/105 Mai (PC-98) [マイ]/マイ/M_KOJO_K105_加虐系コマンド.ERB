@M_KOJO_EXTRASOURCE_COM_K105_100
IF (TALENT:恋人 || TALENT:恋慕) && CFLAG:105:1006
	PRINTFORMDL 
	PRINTFORMDL 어떡하지?
	CALL ASK_M("뒤를 보통으로 두드린다.", 1, "엉덩이를 세게 때린다.", 1, "볼을 때렸다", CFLAG:105:1006 >= 2, "배를 때리다", TALENT:105:マゾ && !TALENT:105:妊娠)
	TCVAR:105:354 = RESULT
	SELECTCASE CFLAG:105:1006
		CASE 0
			SOURCE:反感 = 200
		CASE 1
			SOURCE:苦痛 += (300 * TCVAR:105:354 * ABL:105:マゾっ気)
			SOURCE:反感 = 0
			TIMES DOWNBASE:体力 , 0.50
			TIMES DOWNBASE:気力 , 0.50
		CASE 2
			SOURCE:苦痛 += (300 * TCVAR:105:354 * ABL:105:マゾっ気)
			SOURCE:屈従 += (300 * TCVAR:105:354 * ABL:105:マゾっ気)
			SOURCE:反感 = 0
			TIMES DOWNBASE:体力 , 0.30
			TIMES DOWNBASE:気力 , 0.30
		CASE 3
			IF MARK:105:苦痛刻印 >= 3
				SOURCE:苦痛 += (1500 * TCVAR:105:354)
				SOURCE:屈従 += (300 * TCVAR:105:354 * ABL:105:マゾっ気)
				SOURCE:反感 = 0
				SOURCE:快Ｖ += ABL:105:マゾっ気 * 300
				TIMES DOWNBASE:体力 , 0.10
				TIMES DOWNBASE:気力 , 0.10
			ELSE
				SOURCE:苦痛 += (300 * TCVAR:105:354 * ABL:105:マゾっ気)
				SOURCE:屈従 += (300 * TCVAR:105:354 * ABL:105:マゾっ気)
				SOURCE:反感 = 0
				SOURCE:快Ｖ += ABL:105:マゾっ気 * 300
				TIMES DOWNBASE:体力 , 0.10
				TIMES DOWNBASE:気力 , 0.10
			ENDIF
		CASEELSE
	ENDSELECT
	;口上導入前にマゾっ気上げまくってる人がいたら（いるのか？）物凄いダメージ食らうので…
	SIF SOURCE:苦痛 >= 10000
		SOURCE:苦痛 = 10000
ENDIF
RETURN 1
