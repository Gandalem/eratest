@M_KOJO_MESSAGE_COM_K67_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF TALENT:恋人
				PRINTFORMW 「혼자서 하는 거야...?」
				PRINTFORMW 「...알았어. 하지만... 다음엔 나로서 해줘...?」
				PRINTFORMW 「후훗, 내가 어떤 자위하는지 똑똑히 지켜봐 줘.」
				IF HAS_PENIS(TARGET)
					PRINTFORMDW 케이네는 자신의 단단하게 발기한 페니스를 손으로 만지기 시작했다. 두 손으로 세심하게 만져 신경이 가득한 성기를 쾌락에 물들였다
				ELSE
					PRINTFORMDW 음모를 더듬으며 민감한 부위를 손가락으로 만지자 케이네는 질 깊은 곳에서 멈추지 않고 애액을 흘리며 음모를 흥건하게 적시고 있었다.
				ENDIF
				PRINTFORMDW 부끄러운 기색도 없이 자위하는 도중, 유혹하듯 몇 번이고 당신의 이름을 계속 부르고 있었다…….
			ELSE
				PRINTFORMW 「자위...? 그걸, 나에게 하라고?」
				PRINTFORMDW 당신이 명하자, 케이네는 얼굴을 새빨갛게 물리고 고개를 숙였다.
				PRINTFORMW 「...꼭 해야 하나?」
				PRINTFORMDW 그 질문에 대답하지 않고 있자, 참지 못한 케이네가 먼저 입을 열었다.
				PRINTFORMW 「알았어... 네가 보고 싶다고 한다면...」
				PRINTFORMDW 케이네는 자신의 은밀한 곳에 손을 가져갔다. 경험이 있는지, 망설이지 않고 자신의 \@ HAS_PENIS(TARGET) ? 페니스 # 음핵 \@을 손가락으로 가지고 놀기 시작했다.
				PRINTFORMW 「우, 응... 보여지고 있다는 걸... 너라도 부끄러워...」
			ENDIF
		ELSE
			PRINTFORMW 「바보냐, 그런 걸 내가……. 윽, 그, 그런 눈으로 보지 마…….」
			PRINTFORMDW 당신이 악의를 담아 노려하자, 케이네는 순간 몸을 경직시킨 후 마지못해 자위를 시작했다.
			PRINTFORMW 「사람들 앞에서 이런 짓을 하게 하다니, 제정신이 아니야……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF TALENT:恋人 && RAND:3
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「아, 오나니 기분 좋다... 기분 좋네?」
					IF HAS_PENIS(TARGET)
						PRINTFORMW 「봐줘, 나의 이렇게 커진 걸. 언제나 후처리가 힘들 정도로 잔뜩 사정해버려...」
					ELSE
						PRINTFORMW 「봐, 너 생각하니까 이렇게 흥분해버리잖아... 어쩔 수 없을 정도로 좋아하고 있어...」
					ENDIF
				CASE 1
					PRINTFORMDW 망상 속에서 당신과 교접하는 케이네는, 몸을 떨며 혼자 흥분해간다…….
					PRINTFORMW 「더, 있잖아, 더…… 안아줘, 안아줘……」
				CASE 2
					PRINTFORMW 「그 시선, 소름 돋아……. 더, 바라봐 줘……」
					PRINTFORMDW 케이네는 몸 깊은 곳에서 음욕을 끌어내는 손가락을 멈추지 않고, 더욱 큰 흥분을 바라고 있었다
				CASE 3
					PRINTFORMW 「보여지니까 또 느낌이 다르네……」
					PRINTFORMW 「자위 행위란, 불필요한 성욕을 처리하기 위해 유효한 행위다.」
					PRINTFORMW 「보이면…… 너도 기쁘려나……」
					PRINTFORMW 「하지만 너 이외의 사람에게 보여주는 건 싫어? 그건 알아줘……」
				CASE 4
					PRINTFORMW 「응윽... 크아악... 안 돼...」
					PRINTFORMW 「나 %조사처리(CALLNAME:MASTER,"에게")% 보였다니...」
					PRINTFORMW 「손가락이... 멈추지 않아」
					PRINTFORMW 「%CALLNAME:MASTER%... 이런 나를 봐도, 아앗...」
					PRINTFORMW 「싫어하지 말아줘...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「나로서는…… 너에게 만져지고 싶어……」
					PRINTFORMW 「하지만 보고 싶다고 말한다면…… 나로 만족할 수 있다면, 봐줘……」
					PRINTFORMW 「나의, 부끄러운 모습도, 전부, 음……」
				CASE 1
					PRINTFORMW 「하아, 하아……지루하겠지……나는 언제든 준비는 되어 있으니까……」
					PRINTFORMW 「마음대로 해줘…………」
				CASE 2
					PRINTFORMW 「혼자라면 언제든지 할 수 있어…… 지금은, 그 손을 사용해 주지 않아?」
					PRINTFORMDW 케이네는 애틋한 눈으로 당신을 바라보지만, 그 음란한 손가락은 혼자 쾌락을 찾고 있다
				CASE 3
					PRINTFORMW 「너를 기쁘게 하기 위해, 일부러 음란함을 강조하는 거야……」
					PRINTFORMW 「평소 같으면 이런 비밀 같은 건 보여주지 않는데.」
				CASE 4
					PRINTFORMW 「나의 부끄러운 모습을 보는 게 좋으니까?」
					PRINTFORMW 「특별하잖아? 아아아...」
			ENDSELECT
		ENDIF
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:3
			CASE 0
				;慧音と実行者が同性
				IF IS_SAMESEX(TARGET, MASTER)
					PRINTFORMW 「거울이라도 보고 스스로 해보는 건 어때? 뒤틀린 동성애자 같으니.」
				ELSE
					PRINTFORMW 「너는 우선 이성에게 대하는 법을 배워야 할 것 같구나」
				ENDIF
			CASE 1
				PRINTFORMW 「전혀 불쾌하다……」
				PRINTFORMDW 움직이는 손가락은 도저히 자위하는 것처럼 보이지 않고, 그저 아무렇게나 음부를 만지고 있는 것만 보인다.
			CASE 2
				PRINTFORMW 「너, 여자를 성욕의 배출구 정도밖에 생각하고 있겠지……」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「남의 자위라니... 볼 만한 게 아니야...」
				PRINTFORMDW 케이네는 입으로는 부정하면서도, 당신의 명령에 거스를 수 없어 은밀한 곳을 가지고 놀고 있었다.
			CASE 1
				PRINTFORMW 「저, 그렇게 노려보지 말아 줄래……」
				PRINTFORMDW 케이네의 손가락은 정확하게 자신의 연약한 부분을 어루만지고 있다. 익숙해진 듯하다
			CASE 2
				PRINTFORMW 「부끄러운데…… 어째서 이렇게 흥분하는 거지……」
				PRINTFORMW 「시선만으로 몸이 떨린다…… 완전히, 발달해버렸다……」
			CASE 3
				PRINTFORMW 「윽, 혼자 하는 건데……」
				PRINTFORMDW 케이네는 수치심으로 가득한 듯하다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
