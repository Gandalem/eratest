;==================================================
;20,キスする
;==================================================
@M_KOJO_MESSAGE_COM_K67_20
CALL M_KOJO_MESSAGE_COM_K67_20_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF TALENT:恋人
				PRINTFORMW 「んっ、好き……愛してる……もっとたくさんキスをしよう？」
			ELSE
				PRINTFORMW 「ん……好きだぞ。もっと……」
			ENDIF
			PRINTFORMDW 慧音は%CALLNAME:MASTER%と舌を絡ませ、時折、吸い付いたりしてくる……。
		ELSEIF MARK:反発刻印
			PRINTFORMW 「汚い……そんなに顔を近づけるな……」
		ELSE
			PRINTFORMW 「ぶちゅっ…ぷぁはっ…」
			PRINTFORMW 「いきなり何をするんだ……」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:7
			CASE 0
				PRINTFORMDW %CALLNAME:PLAYER%が動くよりも前に、慧音は唇を、あなたの唇に重ねる。その口吻の時間は長く、一秒が一分にも一時間にも感じられるほどに濃厚だ
				PRINTFORMDW 慧音の愛を感じた%CALLNAME:PLAYER%は、より深く求め、慧音を抱きしめた
			CASE 1
				PRINTFORMDW キスをする前に、慧音が軽く息を吸う
				PRINTFORMDW それを見届けた%CALLNAME:PLAYER%は、包み込むように慧音を抱きしめて唇を重ねあった
			CASE 2
				PRINTFORMW 「はぅ……ん……好き…………」
				PRINTFORMDW 互いの唾液の啜り合い、舌の絡ませ合い、%CALLNAME:PLAYER%と慧音は、その互いに貪欲に求め合う接吻を、心行くまで楽しんだ
			CASE 3
				PRINTFORMW 「んっ、んっ……」
				PRINTFORMDW %CALLNAME:MASTER%と慧音は、強く抱き合いながら、愛情を確かめ合う……。
				PRINTFORMDW 時間経過と共に興奮と、互いを求める感情が強まっていった。
				PRINTFORMDW 慧音も同じ気持ちらしく、胸を押し付け、足を絡めてくる……。
			CASE 4
				PRINTFORMW 「んちゅっ……あっ」
				PRINTFORMW 「なっ何だか落ち着くんだ…」
			CASE 5
				PRINTFORMW 「ふちゅっ……ぷはっ…」
				PRINTFORMW 「…やっぱりお前との接吻は良いな」
				PRINTFORMW 「………もう少しやってくれないか？」
				PRINTFORMDW それから%CALLNAME:MASTER%と慧音は数回程接吻を行った。
			CASE 6
				PRINTFORMW 「ぷちゅっ……んふっ……」
				PRINTFORMW 「……うん、心が安らぐよ」
		ENDSELECT
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「やめろ……笑えんぞ……」
			CASE 1
				PRINTFORMW 「その臭い息を私に吐きかけるな」
			CASE 2
				PRINTFORMW 「んんん……っ！」
				PRINTFORMDW 慧音の全身は強張り、強く目を閉じ、唇を引き締めてキスを拒否している……。
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「うぅ……私はこんなこと、したくない……」
				PRINTFORMDW 慧音は若干の抵抗もあるが、確実にそのキスは柔らかくなってきている
			CASE 1
				PRINTFORMW 「ん、ぅぅん……はぁ……」
				PRINTFORMW 「どうしてお前なんかと……接吻しなくちゃいけないんだ」
			CASE 2
				PRINTFORMW 「っふ、んんっ……満足したか？」
				PRINTFORMDW キスに対する嫌悪感は大分消えてくれたらしく、積極性が出てきた。
			CASE 3
				PRINTFORMW 「くっ……お前は何かを感じているのか？」
			CASE 4
				PRINTFORMW 「ぷちゅっ……んふっ……」
				PRINTFORMW 「もう少し優しくしてくれないか？」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1


;==================================================
;21,何もしない
;==================================================
@M_KOJO_MESSAGE_COM_K67_21
CALL M_KOJO_MESSAGE_COM_K67_21_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_21_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「ん、なっ……？　どうしたんだ？」
			PRINTFORMW 「疲れたのか？　それとも……まさか、私に飽きて……」
			PRINTFORMDW 慧音は不安がって、目を潤ませている。
		ELSE
			PRINTFORMW 「おや、休憩か？」
			PRINTFORMW 「待たせるくらいなら終わってくれないだろうか……」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF TALENT:恋人 && RAND:3
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「うずうずするね……うずうず……」
				CASE 1
					PRINTFORMW 「なんなんだ？ 何もしないなら私から何かしちゃってもいい？」
				CASE 2
					PRINTFORMW 「なんだ……あまり焦らさないでくれ」
				CASE 3
					PRINTFORMW 「な、何もしてくれないのかっ。うぅ、あちこちがうずうずするんだ」
					PRINTFORMW 「お前は本当にいじわるだな……」
				CASE 4
					PRINTFORMW 「ふむ、何もしないならば……少しこのままにさせてくれ」
					PRINTFORMDW そう言って、慧音は%CALLNAME:MASTER%の背中に寄りかかるようにして布団の上に座った。
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「疲れたのか？ ふふ、じゃあちょっと休もうか。あまり慌てなくてもいいよ」
				CASE 1
					PRINTFORMW 「……本当は、もっと違う形で一緒に居られたらな、と思う」
				CASE 2
					PRINTFORMW 「私たちって、普通に、暮らせないのかな……」
				CASE 3
					PRINTFORMW 「最初は飽きられたのかと思って取り乱してしまったがな……」
					PRINTFORMW 「お前がここに居てくれるというだけで、私は嬉しいんだぞ」
				CASE 4
					PRINTFORMW 「ふむ、何もしないのか。では、少し話でもしようか」
					PRINTFORMDW そして、しばらく慧音と%CALLNAME:MASTER%は雑談を楽しんだ。
			ENDSELECT
		ENDIF
	;反発刻印あり
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「飽きたのならとっとと終われ」
			CASE 1
				;アホっぽい
				PRINTFORMW （反撃のチャンスか……？ いや、罠かもしれない……）
			CASE 2
				PRINTFORMW 「な、何もされないというのもそれはそれで気持ち悪いな……」
				PRINTFORMW 「だからと言って何かされるのも……むぅ」
			CASE 3
				PRINTFORMW 「…もう終わりなのか？　……いや、違うようだな」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「……？ なんだ？」
			CASE 1
				PRINTFORMW 「私はいつまでここに居ればいいんだ？」
			CASE 2
				PRINTFORMW 「む？　……？　終わりか？」
			CASE 3
				PRINTFORMW 「ふむ、何もしないのか」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

