@M_KOJO_MESSAGE_COM_K67_3
CALL M_KOJO_MESSAGE_COM_K67_3_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF TALENT:恋人
				PRINTFORMW 「응...? 손가락으로, 손가락으로 괜찮아?」
				PRINTFORMW 「손가락이 아니라 성기를 삽입해도 되는 거잖아?」
				PRINTFORMDW 손가락을 삼키는 질 내부는 더욱 축축해지고, 당사 케이네는 다른 것을 기대하는 듯한 눈으로 바라본다.
