@M_KOJO_MESSAGE_COM_K67_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「こうじっくり触られるのは、初めてな気がする」
			PRINTFORMW 「ふふん、私も少しばかり緊張してきたぞ」
			PRINTFORMW 「あと、その、%CALLNAME:MASTER%」
			PRINTFORMW 「優しくしてくれ…」
		ELSEIF MARK:反発刻印
			PRINTFORMW 「……触るんじゃない」
			PRINTFORMDW 慧音はあなたの手を振り払うが、あなたは無理やり慧音の体に指を這わせた
		ELSE
			PRINTFORMW 「おい、ちゃんと清潔にしてるんだろうな？」
			PRINTFORMW 「…分かった。痛くしないでくれよ」
		ENDIF 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:7
			CASE 0
				PRINTFORMW 「なかなか……巧いじゃないか……」
				PRINTFORMW 「どこでも……もっと色んなところを……触ってくれ」
			CASE 1
				PRINTFORMDW 慧音の弱い部分を重点的に責めてやると、慧音は少女のような可愛らしい声を漏らした
				PRINTFORMW 「もう、意地悪なやつだな……でも………嬉しいんだ、そういうの」
			CASE 2
				PRINTFORMDW 慧音は目を閉じ、あなたの愛撫を全体で感じている。
				PRINTFORMDW あなたが悪戯心でその頬に唇を寄せると、慧音はあなたを見て微笑んだ
			CASE 3
				PRINTFORMW 「前戯を大事にする奴は、嫌いじゃないぞ」
				PRINTFORMW 「ゆっくりでいい、楽しもう」
			CASE 4
				PRINTFORMW 「そう、そこが良いんだ……」
				PRINTFORMDW 慧音はおもむろに%CALLNAME:MASTER%の手を取り、その指をしゃぶった……。
				PRINTFORMW 「ふふふ……好きだよ」
			CASE 5
				PRINTFORMW 「ふぁぁっ…」
				PRINTFORMDW %CALLNAME:MASTER%が指に付いた愛液を舐め取ると、その様子を見つめていた慧音はふるっと身体を震わせた。
			CASE 6
				PRINTFORMW 「んっ、あっ…」
				PRINTFORMDW 慧音は、%CALLNAME:MASTER%の愛撫に身を委ねている。
		ENDSELECT
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「触るな、下衆め」
			CASE 1
				PRINTFORMW 「この体はな、いや、女性の体は、お前みたいな大馬鹿者が気安く触っていいものじゃないんだ」
			CASE 2
				PRINTFORMW 「気味が悪い……そんな指は切り落としてしまえ」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「触るなら……もっと優しく撫でるようにしてくれ……」
				PRINTFORMDW そうは言う慧音だが、表情には明らかな不快感が表れている
			CASE 1
				PRINTFORMW 「その指で触らないでくれ……」
				PRINTFORMDW 慧音はあなたの手を振り払い、ぷいっと目を背けた
			CASE 2
				PRINTFORMW 「まったく……私の体など触っても面白くはないだろう」
			CASE 3
				PRINTFORMW 「あ、ぅっ……そんな、弱点ばかり責め……あぁっ」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
