@M_KOJO_MESSAGE_COM_K67_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「少し怖いな……お前じゃなきゃ、こうも無防備な姿を晒せないだろう」
			PRINTFORMW 「良いのか？そんな汚いところを舐めて…」
		ELSEIF MARK:反発刻印
			PRINTFORMW 「そんな汚い場所……舐めるところじゃない」
		ELSE
			PRINTFORMW 「そこは舐めるような所じゃないぞ……うっ」
			PRINTFORMDW その強すぎる刺激に、慧音は跳ねるように腰を引いた。
		ENDIF
		SIF !TALENT:恋慕
			PRINTFORMW 「嫌ではないのか？　自分で言うのも何だが、そこは清潔じゃないぞ」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 「かっ変わった行為だな……」
			PRINTFORMDW 慧音は顔を真っ赤にしている。とても恥ずかしいのだろう。
			PRINTFORMDW やめる事を提案してみる。
			PRINTFORMW 「いや……お前がしたいと言うならば私は…」
			PRINTFORMDW 戸惑いつつも、行為に許可をしてくれた。 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF PALAM:潤滑 > PALAMLV:3 && ONCE("KeineWet")
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「見てくれ……もうこんなになってしまった」
					PRINTFORMDW 慧音は割れ目に指を当て、愛液をすくい上げて見せた。
					PRINTFORMDW ねばつく愛液は、淫らに糸を引いている……。
				CASE 1
					PRINTFORMW 「濡れてるって？　違うよ、お前の唾だよ」
					PRINTFORMW 「なに？　唾の粘性はこんなに強くないだと？　……わかってるよ」
					PRINTFORMW 「私の恥ずかしがる様を見るのがそんなに好きか……うう」
			ENDSELECT
		ELSE
			SELECTCASE RAND:7
				CASE 0
					PRINTFORMW 「う、ん……気持ち良いが……私も、お前に何かしてやれないだろうか……？」
					PRINTFORMDW あらぬ心配をする慧音に応えるように、柔らかな膣口へと舌を這わせる
				CASE 1
					PRINTFORMW 「はっ、はっ……まるで犬みたい……そんなにここが好きなの？」
					PRINTFORMDW 慧音は%CALLNAME:PLAYER%の頭を押さえながら、舌での刺激に愛液を溢れさせている
				CASE 2
					PRINTFORMDW 股間の白い茂みを舌でかき分けると、なんとも言えない慧音の匂いが鼻腔を掠める
					PRINTFORMW 「くぅん……刺激……強ぃ……」
				CASE 3
					PRINTFORMW 「知っていたか？　ここって、快感を得る以外にこれといった役割が無いんだ……」
					PRINTFORMW 「だから、こんなに気持ち良く……あ、あ……」
				CASE 4
					PRINTFORMW 「丁寧に洗ってある……臭くはないはずだ」
					PRINTFORMW 「だから……たくさん舐めてくれ……んっ、そう……陰核をだ」
				CASE 5
					PRINTFORMDW %CALLNAME:MASTER%は慧音の秘所に顔を近づける。
					PRINTFORMDW すると、そこはすでにもう濡れていた。
					PRINTFORMDW %CALLNAME:MASTER%は、舌で優しく舐め始めた。
					PRINTFORMW 「あっ、んあっ…」
					PRINTFORMW 「きっ気持ち良いぞ、%CALLNAME:MASTER%…」
				CASE 6
					PRINTFORMW 「ふぁぁっ、あそこが吸われて……」
					PRINTFORMW 「ふぁんっ…私感じてる……」
					PRINTFORMDW 慧音は鏡に映った、自分達を見て、恥ずかしそうにしつつも、何かを感じているようだ。
			ENDSELECT
		ENDIF
	;反発刻印あり
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「おいバカ、やめろ」
			CASE 1
				PRINTFORMW 「貴様ごときに舐められて喜ぶ淫売だとでも思ってるのか？」
			CASE 2
				PRINTFORMW 「その薄汚い唾液がまとわりつくとは、病気にでもなりそうだ」
			CASE 3
				PRINTFORMW 「そっそんな汚い所を…ひゃんっ」
		ENDSELECT
	;その他
	ELSE
		IF PALAM:潤滑 > PALAMLV:3 && ONCE("KeineWet")
			SELECTCASE RAND:3 ;custom code
				CASE 0
					PRINTFORMW 「刺激され続ければ濡れるようになってるんだ……」
					PRINTFORMW 「ワーハクタクであろうと、例外ではない……」
				CASE 1
					PRINTFORMW 「溢れてるって？　いちいち言わないでくれ……わかってるよ」
				CASE 2
					PRINTFORMW 「『溢れてる、強がってても体は素直』だと？」
					PRINTFORMW 「無理矢理にしておいて得意げに言うんじゃない」
			ENDSELECT
		ELSE
			SELECTCASE RAND:6
				CASE 0
					PRINTFORMW 「なんて退屈な時間だ……こんな行為に意味など無い」
				CASE 1
					PRINTFORMW 「やめてくれ……お前に舐められても、嬉しくも気持ち良くもない」
				CASE 2
					PRINTFORMW 「それ以上変なことをしたら、はっ倒してやる……」
				CASE 3
					PRINTFORMW 「酷い辱めだ……あっ、はぁ……」
				CASE 4
					PRINTFORMW 「敏感なだけに舌の感触が気持ち悪いな……」
				CASE 5
					PRINTFORMW 「ふぁっ、あぁっ……」
					PRINTFORMDW 慧音はまだこの行為に慣れていないようだが、少し何かを感じているようだ。
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
