@M_KOJO_MESSAGE_COM_K67_0
CALL M_KOJO_MESSAGE_COM_K67_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「이렇게 천천히 만져지는 건, 처음인 것 같아.」
			PRINTFORMW 「후훗, 나도 조금은 긴장하게 되었어.」
			PRINTFORMW 「저기, 그게 %CALLNAME:MASTER%」
			PRINTFORMW 「상냥하게 해줘...」
		ELSEIF MARK:反発刻印
			PRINTFORMW 「……만지지 마」
			PRINTFORMDW 케이네는 당신의 손을 뿌리치지만, 당신은 억지로 케이네의 몸에 손가락을 움직였다
		ELSE
			PRINTFORMW 「야, 제대로 청결하게 하고 있는 거지?」
			PRINTFORMW 「...알았어. 아프게 하지 말아줘」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:7
			CASE 0
				PRINTFORMW 「꽤…… 능숙하네……」
				PRINTFORMW 「어디든…… 더 여러 곳을…… 만져줘」
			CASE 1
				PRINTFORMDW 케이네의 약한 부분을 중점적으로 괴롭혀주자, 케이네는 소녀 같은 귀여운 목소리를 흘렸다.
				PRINTFORMW 「이제, 심술궂은 녀네……하지만………기쁜 거야, 그런 거」
			CASE 2
				PRINTFORMDW 케이네는 눈을 감고 당신의 애무를 온몸으로 느끼고 있다.
				PRINTFORMDW 당신이 장난스러운 마음으로 그 뺨에 입술을 가져가자, 케이네는 당신을 보며 미소 지었다
			CASE 3
				PRINTFORMW 「전희를 소중히 여기는 놈은 싫지 않아」
				PRINTFORMW 「천천히 해도 돼, 즐기자」
			CASE 4
				PRINTFORMW 「응, 거기가 좋아......」
				PRINTFORMDW 케이네는 문득 %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 그 손가락을 빨았다…….
				PRINTFORMW 「후후후...... 좋아해」
			CASE 5
				PRINTFORMW 「후아…」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 손끝에 묻은 애액을 핥자, 그 모습을 지켜보고 있던 케이네는 몸을 파르르 떨었다.
			CASE 6
				PRINTFORMW 「음, 아...」
				PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 애무에 몸을 맡기고 있다.
		ENDSELECT
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「만지지 마, 천박한 자 같으니」
			CASE 1
				PRINTFORMW 「이 몸은 말이야, 아니, 여성의 몸이란 네 같은 대바보가 함부로 만질 수 있는 게 아니란다.」
			CASE 2
				PRINTFORMW 「소름 끼친다……그런 손가락은 잘라버려 버려라」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「만진다면…… 좀 더 상냥하게 쓰다듬어 주길 바라……」
				PRINTFORMDW 그렇게 말하는 케이네지만, 표정에는 명백한 불쾌감이 드러나 있었다.
			CASE 1
				PRINTFORMW 「그 손가락으로 만지지 말아줘...」
				PRINTFORMDW 케이네는 당신의 손을 뿌리치고, 휙 하고 시선을 돌렸다.
			CASE 2
				PRINTFORMW 「정말이지... 나의 몸 따위 만져봤자 재미없을 거야.」
			CASE 3
				PRINTFORMW 「아, 으윽... 그런 약점들만 공격하다니... 아앗」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
