@M_KOJO_MESSAGE_COM_K67_1
CALL M_KOJO_MESSAGE_COM_K67_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「조금 무섭네... 너 아니면 이렇게 무방비한 모습을 보일 수 없을 거야.」
			PRINTFORMW 「괜찮을까? 그런 더러운 곳을 핥다니...」
		ELSEIF MARK:反発刻印
			PRINTFORMW 「그런 더러운 곳…… 핥을 만한 곳이 아니야」
		ELSE
			PRINTFORMW 「거기는 함부로 대할 곳이 아니라고... 윽」
			PRINTFORMDW 그 너무 강한 자극에, 케이네는 벌떡 몸을 움츠렸다.
		ENDIF
		SIF !TALENT:恋慕
			PRINTFORMW 「싫지는 않은가? 스스로 말하는 것도 그렇지만, 거기는 깨끗하지 않아.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 「바뀐 행위네...」
			PRINTFORMDW 케이네는 얼굴을 새빨갛게 하고 있었다. 매우 부끄러운 모양이다.
			PRINTFORMDW 그만두자고 제안해 본다.
			PRINTFORMW 「아니... 네가 하고 싶다고 한다면 나는...」
			PRINTFORMDW 망설이면서도, 행위에 허가를 해 주었다. 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF PALAM:潤滑 > PALAMLV:3 && ONCE("KeineWet")
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「봐줘... 벌써 이렇게 되어버렸어」
					PRINTFORMDW 케이네는 갈라진 곳에 손가락을 대고 애액을 떠서 보여주었다.
					PRINTFORMDW 끈적이는 애액은 음란하게 실을 끌고 있다....
				CASE 1
					PRINTFORMW 「젖었다고? 아니, 네 침이야」
					PRINTFORMW 「뭐라고? 침의 점성이 이렇게 강하지 않다고? ……알고 있어」
					PRINTFORMW 「나 부끄러워하는 모습 보는 게 그렇게 좋으냐……우우」
			ENDSELECT
		ELSE
			SELECTCASE RAND:7
				CASE 0
					PRINTFORMW 「우, 응...... 기분은 좋지만...... 나도 너에게 뭔가 해줄 수 없을까......?」
					PRINTFORMDW 쓸데없는 걱정을 하는 케이네에게 대답하듯 부드러운 질 입구로 혀를 가져갔다.
				CASE 1
					PRINTFORMW 「핫, 핫... 마치 개 같아... 그렇게 여기가 좋아하는 거야?」
					PRINTFORMDW 케이네는 %조사처리(CALLNAME:PLAYER,"의")% 머리를 누르면서, 혀로 자극하는 것에 애액을 흘리고 있다.
				CASE 2
					PRINTFORMDW 가랑이의 하얀 무성한 것을 혀로 헤치자, 이루 말할 수 없는 케이네의 냄새가 코를 스쳤다.
					PRINTFORMW 「쿠운... 자극... 강해...」
				CASE 3
					PRINTFORMW 「알고 있었나? 여기는 쾌감을 얻는 것 외에 특별한 역할이 없는 곳이야……」
					PRINTFORMW 「그래서, 이렇게 기분 좋게……아, 아……」
				CASE 4
					PRINTFORMW 「정성껏 빨아뒀어……. 냄새나지 않을 거야」
					PRINTFORMW 「그러니까……. 많이 핥아줘……. 응, 그래……. 음핵을」
				CASE 5
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 케이네의 은밀한 곳에 얼굴을 가까이 한다.
					PRINTFORMDW 그러자 그곳은 이미 젖어 있었다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 혀로 부드럽게 핥기 시작했다.
					PRINTFORMW 「앗, 응앗…」
					PRINTFORMW 「정말 기분 좋잖아, %CALLNAME:MASTER%…」
				CASE 6
					PRINTFORMW 「하아, 거기가 빨려들고…」
					PRINTFORMW 「흡… 나 느끼고 있어…」
					PRINTFORMDW 케이네는 거울에 비친 자신들을 보며 부끄러워하면서도 무언가를 느끼고 있는 듯했다.
			ENDSELECT
		ENDIF
		;反発刻印あり
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「야, 바보, 그만둬」
			CASE 1
				PRINTFORMW 「네놈 같은 자에게 무시당하고 기뻐하는 매춘부라고 생각하는 거냐?」
			CASE 2
				PRINTFORMW 「그 더러운 침이 달라붙는 걸 보니, 병에라도 걸릴 것 같군.」
			CASE 3
				PRINTFORMW 「그, 그런 더러운 곳을... 햐앗!」
		ENDSELECT
		;その他
	ELSE
		IF PALAM:潤滑 > PALAMLV:3 && ONCE("KeineWet")
			SELECTCASE RAND:3 ;custom code
				CASE 0
					PRINTFORMW 「자극받고 계속 있으면 젖게 되어 있는 거야……」
					PRINTFORMW 「워하쿠타크이든 예외는 아니야……」
				CASE 1
					PRINTFORMW 「넘치고 있다고? 하나하나 말하지 말아줘... 알고 있어.」
				CASE 2
					PRINTFORMW 「'넘치고 있잖아, 강한 척해도 몸은 솔직하잖아'라고?」
					PRINTFORMW 「억지로 해놓고 잘난 척 하지 마.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:6
				CASE 0
					PRINTFORMW 「정말 지루한 시간이야... 이런 행위에 의미 따윈 없어」
				CASE 1
					PRINTFORMW 「그만둬... 너한테 깔려도 기쁘지도 편하지도 않아」
				CASE 2
					PRINTFORMW 「더 이상 이상한 짓 하면, 죽여주마……」
				CASE 3
					PRINTFORMW 「끔찍한 모욕이야... 하아, 하아...」
				CASE 4
					PRINTFORMW 「민감한 만큼 혀의 감촉이 기분 나쁘네……」
				CASE 5
					PRINTFORMW 「하앗, 아아……」
					PRINTFORMDW 케이네는 아직 이 행위에 익숙하지 않은 듯하지만, 무언가를 느끼고 있는 것 같다.
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
