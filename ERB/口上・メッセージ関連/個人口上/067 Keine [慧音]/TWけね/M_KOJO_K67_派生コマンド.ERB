@M_KOJO_MESSAGE_SCOM_K67_1
CALL M_KOJO_MESSAGE_SCOM_K67_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K67_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:恋慕
			PRINTFORMW 「서로 성기를 핥을 건가...?」
			PRINTFORMW 「뭐, 나쁘지는 않은데...」
		ELSE
			PRINTFORMW 「서로 성기를 핥을 건가...?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「후후후, 어때? 기분 좋아지고 있나?」
		PRINTFORMW 「흐윽, 나도 기분이... 앙... 좋아...」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「흡, 으윽...」
		PRINTFORMW 「깔리면서 같은 건 할 수 없어...」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K67_{SELECTCOM}_1
RETURN 1
