;12,パイズリフェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K67_12
CALL M_KOJO_MESSAGE_SCOM_K67_12_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K67_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2
			PRINTFORMW 「가슴과 입... 흠」
			PRINTFORMDW 케이네는 가슴으로 봉사하면서, 당신의 귀두를 물어버렸다.
			PRINTFORMW 「응, 응... 질척, 쪽...」
			PRINTFORMDW 입 안에서 혀를 움직이며, 귀두를 애무해온다.
			PRINTFORMDW 자지와 귀두에 가해지는 자극에, 당신은 지금이라도 사정할 것만 같았다.
		ELSE
			PRINTFORMW 「음... 츄루, 주...」
			PRINTFORMDW 그저 필사적으로 봉사하며 사랑스럽게 페니스를 바라본다.
			PRINTFORMDW 가슴의 고동과 애쓰는 표정에서 큰 애정도 느낄 수 있었다.
			PRINTFORMW 「...언제든... 싸도 괜찮아... 후후」
			PRINTFORMDW 그 모습에, 당신은 속 깊은 곳부터 사정감이 밀려오는 것을 자각했다.
		ENDIF
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		IF RAND:2
			PRINTFORMW 「뭐... 상관없지만...」
			PRINTFORMDW 다소 당황했지만, 당신의 페니스를 흘긋 보고 승낙했다.
			PRINTFORMW 「훗, 음...」
			PRINTFORMDW 파이즈리에서 시작하여, 그 후 당신의 페니스를 입에 넣었다.
			PRINTFORMW 「음무... 츄파...」
			PRINTFORMDW 가슴으로 비비면서, 혀로 서툴게 봉사하는 모습은 어딘가 귀엽고 아름다웠다.
		ELSE
			PRINTFORMW 「이렇게 좋은 걸 생각해 내다니... 음...」
			PRINTFORMDW 귀두를 통째로 삼키더니, 입안에서 혀를 얽어왔다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
