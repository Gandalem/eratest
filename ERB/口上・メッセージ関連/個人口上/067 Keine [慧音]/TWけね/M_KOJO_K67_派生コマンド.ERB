;==================================================
;3,Gスポット刺激
;==================================================

@M_KOJO_MESSAGE_SCOM_K67_3
CALL M_KOJO_MESSAGE_SCOM_K67_3_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K67_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「파앙!! 햐아앗!!」
		PRINTFORMW 「뭐지, 이 감각은?」
		RETURN 1
	ENDIF
	IF !FLAG:70 && NOWEX:Ｖ絶頂
		IF TALENT:恋慕
			PRINTFORMW 「응, 손가락이 질 안에 있어……」
			PRINTFORMDW 손가락을 케이네의 질 안에 넣자마자, 케이네의 G스팟을 자극해 보았다.
			IF RAND:2
				PRINTFORMW 「!!?? 이거 이건……」
				PRINTFORMW 「흐응, 후으윽……정말 기분 좋아」
			ELSE
				PRINTFORMW 「!!!!???? 좋다, 좋아아. 하앗, 머리가 이상해지겠어...」
				PRINTFORMW 「판, 파앗, 히야아앙!!」
			ENDIF
		ELSE
			PRINTFORMW 「아앗... 느껴져서... 아응...」
			PRINTFORMDW 그렇게 말하고 있으니, 케이네의 G스팟을 자극해 주겠다.
			PRINTFORMW 「!?햐으... 뭐, 이 감각은 뭐야?」
			PRINTFORMW 「안 돼... 이거 이러면 부서져 버릴 것 같아...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「그래, 거기... 조금 거친 부분이... 응, 아아」
		PRINTFORMW 「G스팟... 음, 음으... 아아앗」
		PRINTFORMDW 절정에 가까워진 건지 케이네의 질벽은 수축하며 %조사처리(CALLNAME:MASTER,"의")% 손가락을 짓누르려 했다.
		PRINTFORMDW 케이네의 반응을 즐기며, 손가락 끝으로 G스팟을 강하게 어루만졌다.... 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「그만둬……거, 거긴……」
		PRINTFORMW 「머릿속이 새하얘져버려……우, 우와아아악!」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「아파... 너무 거칠게 하지 마!」
		PRINTFORMW 「여성의 소중한 부분이라고... 으윽...」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K67_{SELECTCOM}_1
RETURN 1
