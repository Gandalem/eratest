;==================================================
;3,Gスポット刺激
;==================================================
@M_KOJO_MESSAGE_SCOM_K67_3
CALL M_KOJO_MESSAGE_SCOM_K67_3_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K67_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「ふぁぅん！！ひゃぁっ！！」
		PRINTFORMW 「なっ何だ、この感覚は？」
		RETURN 1
	ENDIF
	
	IF !FLAG:70 && NOWEX:Ｖ絶頂
		IF TALENT:恋慕
			PRINTFORMW 「あんっ、指が膣内にぃ……」
			PRINTFORMDW 指を慧音の膣内に入れたすぐ後に、慧音のGスポットを刺激してみた。
			IF RAND:2
				PRINTFORMW 「！！？？こっこれは……」
				PRINTFORMW 「ひゃんっ、ひゅんっ……きっ気持ちが良いよぉ」
			ELSE
				PRINTFORMW 「！！！！？？？？良い、良いよぉ。ふぁっ、頭がっおかしくなるっ……」
				PRINTFORMW 「ふぁん、ふぁっ、ひゃぁぁぁん！！」
			ENDIF
		ELSE
			PRINTFORMW 「あぅっ…感じてなんか…あぅん…」
			PRINTFORMDW そう言っているので、慧音のGスポットを刺激してやる。
			PRINTFORMW 「！？ひゃぅ…なっ、何この感覚？」
			PRINTFORMW 「だっ駄目だ……こっこれじゃあ、壊れちゃう……」
		ENDIF
		RETURN 1
	ENDIF
	
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「そうそこ……少しざらざらしたところが……んっ、あぁ」
		PRINTFORMW 「Gスポ……ん、んぅ……あぁぁっ」
		PRINTFORMDW 絶頂が近いのか慧音の膣壁は引き絞られ、%CALLNAME:MASTER%の指を押し潰そうとする。
		PRINTFORMDW 慧音の反応を楽しみながら、指の腹でGスポットを強くなぞった……。 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「やめろぉ……そ、そこは……」
		PRINTFORMW 「頭の中が真っ白になってしまう……う、うぁぁぁ！」
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「痛いっ……あまり乱暴にするな！」
		PRINTFORMW 「女性の大切な部分なんだぞ……うぐ……」
		RETURN 1
	ENDIF
ENDIF
