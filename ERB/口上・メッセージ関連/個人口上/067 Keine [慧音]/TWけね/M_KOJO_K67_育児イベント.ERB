;-------------------------------------------------
;育児イベント食事時。
;-------------------------------------------------
@M_KOJO_EVENT_K67_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
SIF (!TALENT:思慕 && !TALENT:恋慕) || (MARK:反発刻印 >= 3 || CFLAG:ブチギレ)
	RETURN 0
CALL M_KOJO_COLOR_K67
IF ARGS == "授乳"
	IF RAND:2
		PRINTFORMW 「ふふふ、どうだ、美味いか？」
		PRINTFORMDW 慧音は赤ん坊に母乳を飲ませていた。
		PRINTFORMW 「おや%CALLNAME:MASTER%。丁度、この子に母乳をあげていたところだよ」
		PRINTFORMDW 赤ん坊は嬉しそうに慧音の母乳を飲んでいる。
		PRINTFORMDW ……何となく羨ましくなったのはきっと気のせいでは無い。
		PRINTFORMW 「あー%CALLNAME:MASTER%……お前も飲むか？」
		PRINTFORMDW んー、飲まない方が赤ん坊にとっては良いのだろうけれど……
		PRINTFORMDW 結局%CALLNAME:MASTER%は慧音の母乳を美味しく飲む事にした。
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%、来てくれたのか」
		PRINTFORMW 「今この子に母乳をあげていたのだが……」
		PRINTFORMW 「時々吸いつきが赤ん坊とは思えないくらい強いんだよ」
		PRINTFORMW 「……一体誰に似たんだろうな？」
		PRINTFORMDW いやいや面目無い。
		PRINTFORMDW しかし赤ん坊とはいえ、自分の子供の前でそういう事を話すのもどうかとは思うが……。
	ENDIF
ELSEIF ARGS == "離乳食"
	PRINTFORML 
ELSEIF ARGS == "幼少期"
	PRINTFORML 
ELSE
	PRINTFORML 
ENDIF

