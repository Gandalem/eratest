;-------------------------------------------------
;育児イベント登下校時の地の文。
;-------------------------------------------------

@M_KOJO_EVENT_K67_CHILD_RAISING_登下校(ARGS,ARG,ARG:1)
IF !ARG
	;登校時
	PRINTFORML 
ELSE
	;下校時
	PRINTFORML 
ENDIF
;-------------------------------------------------
;育児イベント食事時。
;-------------------------------------------------

@M_KOJO_EVENT_K67_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
SIF (!TALENT:思慕 && !TALENT:恋慕) || (MARK:反発刻印 >= 3 || CFLAG:ブチギレ)
	RETURN 0
CALL M_KOJO_COLOR_K67
IF ARGS == "授乳"
	IF RAND:2
		PRINTFORMW 「후후후, 어떠냐, 맛있니?」
		PRINTFORMDW 케이네는 아기에게 모유를 먹이고 있었다.
		PRINTFORMW 「어라 %CALLNAME:MASTER%. 마침 이 아이에게 모유를 주고 있던 참이야」
		PRINTFORMDW 아기는 기쁜 듯 케이네의 모유를 마시고 있다.
		PRINTFORMDW ……왠지 모르게 부러워졌던 건 분명 착각은 아니었다.
		PRINTFORMW 「아아 %CALLNAME:MASTER%…… 너도 마실래?」
		PRINTFORMDW 음, 안 마시는 게 아기에게 더 좋을 테지만……
		PRINTFORMDW 결국 %조사처리(CALLNAME:MASTER,"는")% 케이네의 모유를 맛있게 마시기로 했다.
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%, 와주었나」
		PRINTFORMW 「지금 이 아이에게 모유를 먹이고 있었는데……」
		PRINTFORMW 「가끔 빠는 힘이 아기라고 하기엔 강하거든」
		PRINTFORMW 「……대체 누구를 닮은 걸까?」
		PRINTFORMDW 아니, 부끄럽다.
		PRINTFORMDW 하지만 아기라고 해도, 자신의 아이 앞에서 그런 이야기를 하는 것도 어딘가 좀 그렇지만…….
	ENDIF
ELSEIF ARGS == "離乳食"
	PRINTFORML 
ELSEIF ARGS == "幼少期"
	PRINTFORML 
ELSE
	PRINTFORML 
ENDIF
