@M_KOJO_MESSAGE_COM_K67_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF TALENT:恋人
				PRINTFORMW 「모두 짜줄게. 한 번만 내서 그치지 않을 테니까?」
				PRINTFORMDW 케이네는 익숙한 손놀림으로 페니스를 손가락으로 감싼 뒤, 초보 남성의 욕구를 처리하듯 부드럽게 자극하고 있었다.
			ELSE
				PRINTFORMW 「응? 아무래도 스스로 해내는 방법은 알겠지? 뭐, 좋아, 내가 방법을 가르쳐 주도록 하지」
				PRINTFORMDW 케이네는 %조사처리(CALLNAME:PLAYER,"의")% 발기한 남성기를 만지며 음란한 말을 섞어 자위법에 대해 설명하기 시작했다.
			ENDIF
			;その他の場合
		ELSE
			PRINTFORMW 「뭐야...? 한 번 더 말해봐」
			PRINTFORMW 「손으로 비빈다고? 무슨 소리를 하는 거야, 이 자식은... 스스로 해」
			PRINTFORMW 「…………알았어, 어쩔 수 없겠네」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:8
			CASE 0
				PRINTFORMW 「후후, 이렇게 크게 만들어서... 그렇게 흥분하고 있었나?」
				PRINTFORMW 「아아, 걱정 없어, %SPLIT_G("今から気持ちよくしてやるからな:すぐに射精させてやる")%」
				PRINTFORMDW 케이네는 %조사처리(CALLNAME:PLAYER,"의")% 페니스를 가볍게 잡고 상하로 움직인다.
				PRINTFORMDW 금방 사정시킬 생각은 없는 듯한 온화한 손길에, %조사처리(CALLNAME:PLAYER,"는")% 앞서 나감을 내뱉으며 몸부림쳤다
			CASE 1
				PRINTFORMW 「너무 앞서나가 버렸어…… 언제까지 견딜 수 있을까♪」
				PRINTFORMDW 뿌리를 움켜쥐고 넘쳐흘러 나온 쿠퍼액을 손가락에 감싸, 귀두를 문지른다.
				PRINTFORMDW 집요한 자극에 민감한 끝부분이 뜨거워지며, 둔한 사정감을 느꼈다
			CASE 2
				PRINTFORMW 「이런 자세도, 좀 더…… 좋지 않아?」
				PRINTFORMDW 케이네가 당신의 뒤로 돌아와 그대로 안은 채 당신의 페니스를 비비기 시작했다.
				PRINTFORMDW 떨리는 육봉은 가늠할 수 없는 난폭한 봉사에 지금이라도 사정을 해버릴 것 같았다
			CASE 3
				PRINTFORMW 「낼 때는, 사양 없이, 언제든지, 응...?」
				PRINTFORMDW %조사처리(CALLNAME:PLAYER,"는")% 케이네의 손에 봉사된 채, 그녀가 원하는 대로 뜨거운 입맞춤을 나누었다.
			CASE 4
				PRINTFORMW 「만히고 있으면 화상을 입을 것 같아, 후후……」
				PRINTFORMW 「화산처럼, 여기서 정액이 분출하는 거구나……」
				PRINTFORMW 「빨리 내줘, 잔뜩 뿌려줘……」
			CASE 5
				PRINTFORMW 「정액이란 본래 아이를 만드는 데 필요한 귀중한 체액인데……」
				PRINTFORMW 「……뭐, 너는 무한히 생산할 것 같으니 괜찮아……」
			CASE 6
				PRINTFORMW 「오, 손 안에서 움찔거리고 있잖아」
				PRINTFORMW 「흠, 그건 기분이 좋아지고 있다는 거겠지?」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕인다.
				PRINTFORMDW 케이네는 적당한 느낌으로 자극하고 있었기에, %조사처리(CALLNAME:MASTER,"가")% 느끼는 감각은
				PRINTFORMDW 굉장한 것이었다. 언제 사정해도 이상하지 않을 상태다.
				PRINTFORMW 「응, 언제든지 내도 돼」
			CASE 7
				PRINTFORMW 「흠, 이 움직임은 어렵네...」
				PRINTFORMW 「미안하구나, 기분 좋게 해 주지 못해서」
		ENDSELECT
	ELSE
		SELECTCASE RAND:7
			CASE 0
				PRINTFORMW 「벌벌 떨고 있구나... 흥, 어서 내버려라」
			CASE 1
				PRINTFORMDW 케이네는 손가락 속에서 앞서나가는 페니스에서 눈을 돌리고, 무감정한 손길로 그저 그것을 다루고 있다.
				PRINTFORMW 「뭐야? 따로 보면서 하라고 말한 적은 없으니까」
			CASE 2
				PRINTFORMW 「더럽네... 제대로 씻고 있는 거야?」
			CASE 3
				PRINTFORMW 「뭐... 이 정도라면 상관없지만...」
			CASE 4
				PRINTFORMW 「이 거리에서도 조금 냄새가 나는군……」
			CASE 5
				PRINTFORMW 「정말 단단하네... 그렇게 기분 좋은 거야? 으응」
			CASE 6
				PRINTFORMW 「크윽, 이런 일을 시키게 될 줄은……!!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
