@M_KOJO_MESSAGE_COM_K67_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			IF TALENT:恋人
				PRINTFORMW 「全部搾り取ってあげる。一回出しただけじゃ、止まらないからな？」
				PRINTFORMDW 慧音は慣れた手つきでペニスを指で包んでは、初心な男児の欲望を処理するように優しく竿を扱いている
			ELSE
				PRINTFORMW 「うん？ さすがに自分で出す方法は分かるよな？ まぁいい、私がやり方を教えてやろう」
				PRINTFORMDW 慧音は%CALLNAME:PLAYER%の勃起した男性器を扱き、卑猥な言葉を織り交ぜながら自慰の説明を始めた
			ENDIF
		;その他の場合
		ELSE
			PRINTFORMW 「何……？ もう一回言ってみろ」
			PRINTFORMW 「手で擦れ？ 何を言ってるんだ、こいつは……自分でやれ」
			PRINTFORMW 「…………分かったよ、仕方ないな」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋人
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:8
			CASE 0
				PRINTFORMW 「ふふ、こんなに大きくして……そんなに興奮してたのか？」
				PRINTFORMW 「ああ、心配無い、%SPLIT_G("今から気持ちよくしてやるからな:すぐに射精させてやる")%」
				PRINTFORMDW 慧音は%CALLNAME:PLAYER%のペニスを軽く握って上下に動かす。
				PRINTFORMDW すぐには射精させるつもりが無さそうな穏やかな手つきに、%CALLNAME:PLAYER%は先走りを漏らしながら悶えた
			CASE 1
				PRINTFORMW 「先走りしすぎだ……いつまで耐えられるかな♪」
				PRINTFORMDW 根元を握って溢れ出てきたカウパーを指に絡ませ、亀頭を擦る。
				PRINTFORMDW 執拗な責めに敏感な先端が熱くなり、鈍い射精感に見舞われた
			CASE 2
				PRINTFORMW 「こういう体勢も、っと……良いんじゃないか？」
				PRINTFORMDW 慧音があなたの後ろに周り、そのまま抱きつきながらあなたのペニスを擦り始めた。
				PRINTFORMDW 震える肉棒は見境のない乱暴な奉仕に今にも精を吐き出してしまいそうだ
			CASE 3
				PRINTFORMW 「出す時は、遠慮無く、いつでも、ね……？」
				PRINTFORMDW %CALLNAME:PLAYER%は慧音の手に奉仕されたまま、彼女の求めるがままに熱い接吻を交わした
			CASE 4
				PRINTFORMW 「触っていたら火傷しそうだ、ふふ……」
				PRINTFORMW 「火山のように、ここから精子が噴き出すんだな……」
				PRINTFORMW 「早く出して、たっぷりかけてくれ……」
			CASE 5
				PRINTFORMW 「精液だって、本来子供を作るための貴重な体液なのだが……」
				PRINTFORMW 「……まぁ、お前は無限に生産しそうだし、良いや……」
			CASE 6
				PRINTFORMW 「おっ、手の中でビクビクしてるぞ」
				PRINTFORMW 「ふむ、それは気持ち良くなっているという事なんだな？」
				PRINTFORMDW %CALLNAME:MASTER%は頷く。
				PRINTFORMDW 慧音は程良い感じに竿をしごいているので、%CALLNAME:MASTER%が感じている感覚は
				PRINTFORMDW 凄まじい物である。いつ射精してもおかしくない状態だ。
				PRINTFORMW 「うん、いつでも出して良いぞ」
			CASE 7
				PRINTFORMW 「ふぅむ、この動きは難しいな……」
				PRINTFORMW 「すまないな、気持ち良くしてやれなくて」
		ENDSELECT
	ELSE
		SELECTCASE RAND:7
			CASE 0
				PRINTFORMW 「びくびくしてるな……ふん、さっさと出してしまえ」
			CASE 1
				PRINTFORMDW 慧音は指の中で先走るペニスから目を背け、情のない手つきでただそれを扱いている
				PRINTFORMW 「なんだ？ 別に見ながらやれとは言われてないからな」
			CASE 2
				PRINTFORMW 「汚いな……ちゃんと洗っているのか？」
			CASE 3
				PRINTFORMW 「まぁ……このぐらいなら構わないが……」
			CASE 4
				PRINTFORMW 「この距離からでも少し臭うな……」
			CASE 5
				PRINTFORMW 「すごく硬いな……そんなに気持ち良いのか？　うぅ」
			CASE 6
				PRINTFORMW 「くっ、こんな事をさせるとは……！！」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

