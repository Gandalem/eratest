@M_KOJO_MESSAGE_COM_K67_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;custom code added
		IF ABL:奉仕精神 >= 3
			PRINTFORMW 「뭐야, 빨라라고? 깨끗하게 해뒀어?」
			PRINTFORMW 「아니, 그건 별로 상관없는데...」
			PRINTFORMW 「음, 최대한 잘 할 수 있게 할게.」
			PRINTFORMDW 그렇게 말하며 케이네는 육봉을 물기 시작했다.
		ELSE
			PRINTFORMW 「그만둬, 왜 입으로......」
			PRINTFORMDW 케이네는 입을 닫고 거부했기에, 코를 막고 호흡을 멈췄다.
			PRINTFORMDW 그리고 숨을 쉬기 위해 입을 연 순간, %조사처리(CALLNAME:MASTER,"는")% 그 입에 페니스를 박아 넣었다.
			PRINTFORMW 「응윽!? 흐으......」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中(FLAG:70)
	IF FLAG:70
		IF MARK:反発刻印 ; == 3 - custom code
			;射精(ex:11)
			IF NOWEX:PLAYER:11
				PRINTFORMDW 한계에 다다르기 직전, 케이네의 목구멍 깊숙이 페니스를 밀어 넣는다.
				PRINTFORMDW 식도로 직접 정액을 흘려보내고 천천히 빼내 입안도 단백질로 가득 채운다.
				PRINTFORMDW 이쪽을 날카롭게 노려보며 입에서 정액을 떨어뜨리는 모습은 꽤나 우스꽝스러웠다.
			ELSE
				PRINTFORMDW 단단한 표정의 케이네 입에 페니스를 밀어 넣었다.
				PRINTFORMDW 상당한 저항이 있었지만, 오나홀로서는 딱 좋은 정도다.
			ENDIF
			RETURN 1
			;射精(ex:11)
		ELSEIF NOWEX:PLAYER:11
			PRINTFORMDW 꿈쩍도 하지 않는 케이네의 입안에 가득 사정했다.
			PRINTFORMDW 페니스를 빼내자, 축축하게 작게 거품이 일었다.
			RETURN 1
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMDW 시간이 멈춘 케이네의 입에 페니스를 밀어 넣었다.
					PRINTFORMDW 허리를 흔들자, 단정한 얼굴이 유린되어 갔다.
				CASE 1
					PRINTFORMDW 모레의 방향을 응시하는 케이네의 입으로 자위를 시작했다.
					PRINTFORMDW 정적 속에서 짜낸 타액이 주푸주푸 소리를 냈다.
					;custom code added
				CASE 2
					PRINTFORMW 「물어뜯어도 괜찮을까? 이건?」
				CASE 3
					PRINTFORMW 「최악의 기분이야, 당장이라도 갈기차버리고 싶을 정도라고.」
				CASE 4
					PRINTFORMW 「흥? 내 입을 도구 같은 걸로 생각하고 있으면 후회하게 될 거다?」
			ENDSELECT
			RETURN 1
		ENDIF
	ELSEIF TALENT:恋人 && RAND:3
		;射精(ex:11)
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「응윽……읏……」
					PRINTFORMDW 크으윽……컥컥
					PRINTFORMDW 매혹적인 케이네의 목구멍에서 음란한 소리가 울린다
					PRINTFORMW 「……음……흡……주푸즛쥬루루」
					PRINTFORMDW 황홀한 표정으로 정액을 삼키자, 그대로 놓지 않고 구강욕을 재개해 버렸다
				CASE 1
					PRINTFORMW 「윽……후우……」
					PRINTFORMW 「%CALLNAME:MASTER%……선생님, 아직 전혀 부족해요……?」
					PRINTFORMW 「……컥」
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「언제나처럼 대단한 것이네」
					PRINTFORMW 「'이후'에 대비해서, 단단히 준비해 두지 않으면 안 되겠어... 후후」
				CASE 1
					PRINTFORMW 「냄새만으로 어지러워진다니」
					PRINTFORMW 「에헤헤, 먹어볼게요...」
				CASE 2
					PRINTFORMW 「자, '선생님, 빨아주세요' 하고 부탁해봐.」
					PRINTFORMW 「지금이라면 잔뜩 보상을 줄 수 있는데...??」
				CASE 3
					PRINTFORMW 「음, 좀 냄새 나는데... 어쩔 수 없는 녀석이군」
					PRINTFORMDW 그렇게 말하며 케이네는 손가락으로 가슴을 몇 번 쓸었다.
					PRINTFORMW 「뭐, 그런 냄새에 흥분해 버리지만...」
					PRINTFORMW 「불결한 건 좋지 않아, 깨끗하게 해 주겠어... 츄...」
					PRINTFORMDW 한 번에 입에 넣지 않고, 침이 묻은 혀로 %조사처리(CALLNAME:MASTER,"의")% 페니스의 더러움을 핥아 나간다.
					PRINTFORMW 「정말이지... 제대로 씻을 줄 모르는 거야? ...쪽」
					PRINTFORMW 「응, 음후... 다음에 같이 목욕이라도 하면서 정성껏 씻겨 줄 수도 있어...」
				CASE 4
					PRINTFORMW 「쪽, 흐읍... 핥아, 쪽...」
					PRINTFORMDW 케이네는 절묘한 혀 사용으로 %조사처리(CALLNAME:MASTER,"의")% 성기를 자극하고 있다.
					PRINTFORMW 「음, 어때? 기분 좋아지고 있나?」
					PRINTFORMW 「흠, 그렇군, 다행이네.」
					PRINTFORMW 「하지만 아직 놓아줄 수는 없지. 흐읍, 음...」
					PRINTFORMDW 그렇게 케이네는 다시 %조사처리(CALLNAME:MASTER,"의")% 성기를 물기 시작했다.
			ENDSELECT
			RETURN 1
		ENDIF
	ELSEIF TALENT:恋慕
		;射精(ex:11)
		IF NOWEX:PLAYER:11
			PRINTFORMW 「음……윽」
			PRINTFORMDW 사정함과 함께 페니스를 깊게 물고, 그대로 케이네의 움직임이 멈춘다.
			PRINTFORMDW 식도로 사정하는 것이 끝나자, 무언가를 입에 문 채 무언가를 호소하듯 나를 바라보았다.
			PRINTFORMDW 그녀가 전하고 싶은 것은 알 수 없었지만, 페니스는 따뜻한 입안에서 다시 경도를 되찾고 있었다.
			RETURN 1
		ELSE
			SELECTCASE RAND:10
				CASE 0
					PRINTFORMDW 눈앞에 페니스를 가져오자 자연스럽게 봉사를 시작했다.
					PRINTFORMDW 상당히 적극적으로 된 것 같지만, 기분 탓일까.
				CASE 1
					PRINTFORMDW 이쪽 상황을 올려다보며 살피는 케이네
					PRINTFORMDW 혀의 움직임 자체는 소극적이지만, 확실하게 봉사해주고 있다.
				CASE 2
					PRINTFORMW 「응... 후후, 참지 않아도 괜찮아?」
					PRINTFORMW 「계속부터 앞서나가고 있어... 나한테 숨기는 건 소용없어.」
				CASE 3
					PRINTFORMW 「입 안에서 내줘도 괜찮으니까…… 전부 마셔줄게」
					PRINTFORMDW 케이네는 입에 물고도 혀를 움직여 기분 좋은 자극을 준다…….
				CASE 4
					PRINTFORMW 「후우, 입안이 가득해…… 이렇게 많은 정액을 내다니, 정액보다 많을지도?」
					PRINTFORMDW 대량으로 흘러나오는 쿠퍼액을 빨아들이는 자극조차 쾌감으로 이어져, %조사처리(CALLNAME:PLAYER,"는")% 지금이라도 사정할 것만 같았다.
				CASE 5
					PRINTFORMDW 케이네는 그 자리에서 쪼그려 앉아, 직립한%조사처리(CALLNAME:PLAYER,"의")% 솟아오른 성기를 입에 넣고 핥고 있다.
					PRINTFORMW 「무릎을 벌리게 되어서... 귀엽다.」
				CASE 6
					PRINTFORMW 「나는 기분 좋은 곳 전부 알고 있단 말이야…… 참으라고 해도 소용없어」
					PRINTFORMDW 케이네는 뿌리부터 목구멍까지 혀를 움직여 귀두에 입술로 닿고, 혀끝으로 은구멍을 자극하고 있다…….
				CASE 7
					PRINTFORMW 「음... 당황하지 마... 제대로 뽑아줄 테니까...」
					PRINTFORMDW 케이네는 침이 흘러 나올 듯 축축해진 혀로, 개처럼 %조사처리(CALLNAME:PLAYER,"의")% 페니스를 계속 핥았다.
				CASE 8
					PRINTFORMW 「자... 기분 좋지? 말하지 않아도 알겠어」
					PRINTFORMDW 케이네의 혀 놀림은 음란했고, 근육이나 귀두에 주는 자극 하나하나가 사정으로 이어질 듯했다……
				CASE 9
					PRINTFORMW 「후훗……여기가……약한 것 같네」
					PRINTFORMDW 뜨거운 혀로 정확하게 약점을 공격하는 케이네의 봉사에, %조사처리(CALLNAME:PLAYER,"는")% 지금이라도 사정할 것만 같다
			ENDSELECT
			RETURN 1
		ENDIF
	ELSEIF MARK:不埒刻印 == 3
		;射精(ex:11)
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「응... 크큭」
					PRINTFORMW 「내보낼 거면 내보낸다고 말해라... 옷이 더러워지잖아」
				CASE 1
					PRINTFORMW 「우에에……」
					PRINTFORMW 「확실히, 전보다 익숙해졌지만 말이야……」
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「얼굴이 빨갛다고?」
					PRINTFORMW 「당연하지, 이런 걸 눈앞에 내놓으면 누구라도 빨개지니까.」
				CASE 1
					PRINTFORMW 「으으... 하루 동안 식욕이 없어지니까 하고 싶지 않아.」
					PRINTFORMW 「알았어, 알았으니까 강요하지 마!」
				CASE 2
					PRINTFORMW 「내 것도 실컷 빨렸으니까 말이야……」
				CASE 3
					PRINTFORMW 「후읏, 흠...」
					PRINTFORMW 「흐음, 쉽사리 잘 되는 게 아니군...」
			ENDSELECT
			RETURN 1
		ENDIF
		RETURN 1
	ELSE
		SELECTCASE RAND:6
			CASE 0
				PRINTFORMW 「우으윽... 지독한 냄새... 어째서 네 것을...」
				PRINTFORMDW 케이네는 입으로 봉사를 계속하지만, 아직 혐오감은 가시지 않은 듯했다.
