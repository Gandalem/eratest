;==================================================
;押し倒した
;==================================================
@M_KOJO_EVENT_K67_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;うふふ==2（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;MASTERを押し倒した（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF TCVAR:発情 ;in heat, custom code
				;note to translator - replace mentions of "pink fog" with being in heat or whatever
				PRINTFORMW 「おい、ちょっと待て」
				PRINTFORMW 「お前にも前に話したか、私の半分は獣でな。大体は人の理性で行動できるんだが、時折ハクタクの力が強く出過ぎる時がある。」
				PRINTFORMW 「いつもは昂りが治まるまで我慢していれば良いんだが、最近の霧のせいで…その、自分で慰めても…抑えが利かないんだ」
				PRINTFORMW 「…まさかここまで言ってもわからないなんて事は無いよな？」
				PRINTFORMW 「だからさ…。今日はお前が、私の獣を鎮めてくれ…」
			ELSEIF TALENT:恋人
				PRINTFORMW 「ふふ、ふふふ……」
				PRINTFORMDW さっと慧音が覆い被さってくる
				PRINTFORMDW 危険を直感で察した%CALLNAME:MASTER%はとっさに躱そうとするが、やはり間に合わなかった
				PRINTFORMDW 情欲に濁った瞳が%CALLNAME:MASTER%を捉える
				PRINTFORMW 「わかってる、何も言わなくていい。お望み通りにしてやるさ……先生も辛抱ならなかったんだ……ふふ」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「今、私を満足させられるのはお前だけかもしれない……」
				PRINTFORMDW 息を荒げる慧音があなたの胸元から首筋と唇を寄せ、終いに耳元で囁く
				PRINTFORMW 「さあ、私を、抱いてくれ」
			ELSE
				PRINTFORMW 「ふふ、たまには私にもさせてくれたって罰は当たらんだろう」
				RETURN 1
			ENDIF
		ENDIF
		;-------------------------------------------------
		;MASTERに抱きついた（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋人
				PRINTFORMW 「ふふ、%CALLNAME:MASTER%の身体っていつも温かいね」
				PRINTFORMW 「人のこと言えないって？そりゃあ目の前に%CALLNAME:MASTER%がいるんだから当たり前だろう？」
			ELSE
				PRINTFORMW 「……」
				PRINTFORMW 「……すまないけど、こうしてると落ち着くんだ」
				RETURN 1
			ENDIF
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
			;抜け出した
				IF TALENT:恋人
					PRINTFORMW 「なんだ？この期に及んで恥ずかしいとでも？」
				ELSE
					PRINTFORMW 「あっ……狡いぞ%CALLNAME:MASTER%、自分の番だけ逃げるなんて」
					RETURN 1
				ENDIF
			CASE 1
			;抱き着きモード満足終了
				PRINTFORML
				RETURN 1
			CASE 2
			;抱き着きモード強制終了
				PRINTFORMW 「むぅ……」
				RETURN 1
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
			;好きにして状態から抜け出せなかった
				IF TALENT:恋人
					PRINTFORMW 「どうした、誘ってるのか？」
					PRINTFORMW 「もっと暴れてみなよ、その方がそそるからさ」
					PRINTFORMW 「そしたらお望み通りねじ伏せてあげる」
				ELSE
					PRINTFORMW 「おい、好きにしていいって言ってたじゃないか」
					RETURN 1
				ENDIF
			CASE 2
			;欲求不満が高くて抜け出せなかった
				IF TALENT:恋人
					PRINTFORMW 「もう十分だって？まだ始まったばかりじゃないか」
					PRINTFORMW 「私が収まるまで逃がさないよ……ふふ」
				ELSE
					PRINTFORMW 「あっ、こら、逃げようとするんじゃない」
					RETURN 1
				ENDIF
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

