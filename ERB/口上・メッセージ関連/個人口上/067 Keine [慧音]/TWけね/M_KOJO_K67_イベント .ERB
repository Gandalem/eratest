@M_KOJO_EVENT_K67_15(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;未実装（押し倒しコマンドに統合？
	;MASTERが押し倒した（ウフフ開始時）
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 1
		;PRINTFORML
		;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;逢瀬終了（ウフフ終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF FLAG:70 || CFLAG:睡眠
		ELSEIF MARK:反発刻印
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「こんな場所じゃなければ……こんな状況じゃなければ……」
					PRINTFORMW 「お前なんか……！」
				CASE 1
					PRINTFORMW 「貴様みたいな不衛生なやつの相手にされる身にもなってみろ」
					PRINTFORMW 「ああ、汚らわしい」
				CASE 2
					PRINTFORMW 「二度と来るな。この外道が」
				CASE 3
					PRINTFORMW 「ふん。すっきりしたか？　気が済んだなら一刻も早く帰ってくれ」
			ENDSELECT
		ELSEIF BASE:0 <= 500 ;out of sta
			IF TALENT:恋慕
				;ネガティブな調教が多かった場合
				IF PALAM:苦痛+PALAM:恐怖 > PALAM:欲情
					PRINTFORMW 「少し苦しい……私はあまり酷いことをされるのは好きじゃないからな」
					PRINTFORMW 「お前とは、もう少し情愛に満ちた時間を過ごしたいんだ」
					PRINTFORMDW 弱々しくあなたの手に重なる慧音の手を振り払うと、彼女は少し悲しそうな表情を見せた
				;普通に気持ちよかった場合
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「結構……疲れるな、ふぅ」
							PRINTFORMDW あなたは慧音を労る言葉を喉に詰まらせながら部屋を去った
						CASE 1
							PRINTFORMDW 体力を失った慧音は息を荒げ、疲れた体を労るような楽な姿勢をしている。
							PRINTFORMW 「は、激しいな……まぁ、たまにはこういうのもいいんだが……」
							PRINTFORMW 「お前がしたいなら……私でよければ、いくらでも激しく……」
