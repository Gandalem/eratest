@M_KOJO_DAILY_EVENT_K67_12(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
;地の文を変えたければコメントアウト
;コメントアウトできるのはARG:1=1,2のみです
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG:1
		CASE 1
			;特訓を頼まれる
			;～から新技の訓練に付き合って欲しいと言われた
			PRINTFORMW 「잠시 훈련하지 않았으니 둔해졌을지도 몰라. 상대해 줘.」
		CASE 2
			;断る
			;～は残念そうだ
		CASE 3
			;～の攻撃！
			;※ここはWAITしないでください
		CASE 4
			IF ARG:2
				;時間停止して回避
			ELSE
				;回避成功
			ENDIF
		CASE 5
			;回避失敗
	ENDSELECT
ENDIF
RETURN 1
