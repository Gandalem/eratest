@M_KOJO_EVENT_K67_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;trigger if not met today
	IF ONCE("KeineMeet")
		IF MARK:反発刻印 ; == 3 - custom code
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「このバカが！ また来たのか！」
					PRINTFORMDW ヒステリックにあなたを拒む慧音だが、何にも動じないあなたへあれやこれやと怒りをぶつけるうちに、消耗して大人しくなってしまった
				CASE 1
					PRINTFORMDW あなたが部屋に入ると、慧音はこちらを睨みつけてくる。もはや殺意すら感じられるその視線にも、あなたは臆することはない
					PRINTFORMDW その後、慧音が少なからず抵抗したのは言うまでも無いだろう
				CASE 2
					PRINTFORMW 「貴様ぁ……」
					PRINTFORMW 「死すらも生ぬるい……全ての歴史から完全に葬り去ってやる！」
					PRINTFORMDW この期に及んでまだ大口を叩く慧音を嘲笑いながら、あなたは陵辱の準備を進めた
				CASE 3
					PRINTFORMW 「まったく、こんな大きなクソガキを相手にするのも疲れるな」
			ENDSELECT
		ELSEIF MARK:反発刻印 || CFLAG:ブチギレ
			PRINTFORMW 「む、お前か」
			PRINTFORMW 「先日のアレはいただけないぞ、もう少し女性には優しくするのが…」
		ELSEIF TALENT:恋人 && FIRSTTIME("KeineLoverGreet",1)
			PRINTFORMW 「ん、ああ、いや、なんでもない…」
			PRINTFORMDW ぽぅっとこちらを見つめたまま箸を動かさないので、心配して声をかけると優しく微笑まれてしまった。
			CALLF FIRSTTIME("KeineLoverGreet")
		ELSEIF TALENT:恋慕 && FIRSTTIME("KeineLoveGreet",1)
			PRINTFORMDW 部屋に入ると慧音はベッドの上でこちらを見上げている。隣に座ると%CALLNAME:MASTER%の肩に頭を預けてきた。
			PRINTFORMW 「なぁ、これからはちょっとくらい甘えても…良いよな？」
			PRINTFORMDW 頷いて頭を撫でてやると、慧音は鼻を%CALLNAME:MASTER%の首筋に当てて甘えてきた。
			CALLF FIRSTTIME("KeineLoveGreet")
		ELSEIF !TALENT:キス未経験 && STRLENS(CSTR:ファーストキス喪失履歴) && FIRSTTIME("KeineKissGreet",1)
			PRINTFORMDW 先日キスをして以来、慧音と顔を合せるたびに逃げられてしまうので、直接部屋を訪ねて行く事にした。
			PRINTFORMW 「う、あぁ…お前か。その、何か用か…？」
			CALLF FIRSTTIME("KeineKissGreet")
		ELSEIF EXP:デート経験 && FIRSTTIME("KeineDateGreet",1)
			PRINTFORMW 「ああいうところに出掛けるのも悪くないものだな」
			PRINTFORMW 「うん、また誘ってくれると嬉しいぞ」
			CALLF FIRSTTIME("KeineDateGreet")
		ELSEIF TALENT:恋慕 && ONCE("KeineDaySection")
			IF DAY - CFLAG:最後に会った日 >= 30 && !IS_VIRGIN(TARGET)
				PRINTFORMW 「ああ……ずいぶんと、久しいな」
				PRINTFORMDW 長いこと体を重ねていなかった慧音が、あなたの胸に頬擦りし、体中を擦り合わせてくる
				PRINTFORMW 「今日は何回達するだろうか……我慢してた分が全部込み上がってきたら、気持ち良すぎて死んでしまうかもしれない」
				PRINTFORMW 「なんてな、ふふ」
				PALAM:欲情 += 500
				PALAM:抑鬱 += 100
			ELSEIF DAY - CFLAG:最後に会った日 >= 20
				PRINTFORMW 「もう……どこに行ってたんだ。馬鹿」
				PRINTFORMW 「私のことなんか忘れてしまったのかと思った……私を一人にしないでくれ……」
			ELSEIF DAY - CFLAG:最後に会った日 >= 14
				PRINTFORMW 「しばらく見なかったが……何をしていたんだ？」
				PRINTFORMDW 慧音は{DAY - CFLAG:最後に会った日}日もご無沙汰だったことに少しばかり機嫌を損ねているようだ
			ELSEIF DAY - CFLAG:最後に会った日 >= 7
				PRINTFORMW 「こうして話すのも久しぶりだな。最近はどうしていたんだ？」
			ELSEIF DAY - CFLAG:最後に会った日 == 2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「やぁ、昨日は忙しかったのか？」
						PRINTFORMW 「何か用事があるなら、私を頼ってくれてもいいんだ。役に立つよ」
						PALAM:恭順 += 500
					CASE 1
						PRINTFORMW 「昨日は、もしかすると別の……」
						PRINTFORMW 「いや、なんでもない。今日は私だけを見てくれるか？」
						PALAM:欲情 += 100
				ENDSELECT
			ENDIF
		ELSEIF TALENT:恋慕 && CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ONCE("KeineMeetEvent")
			PRINTFORMDL %CALLNAME:MASTER%が自室に戻ると慧音が洗濯物を持ち込んでいた。
			PRINTFORML 「乾いたから畳んでおいたぞ…と、それも汚れているな。こっちのと着替えろ」
			PRINTFORMDW 慧音は%CALLNAME:MASTER%から服を無理やり脱がせ、にこにこしながら裏手の洗濯場に持って行った。
		ENDIF
	ENDIF
	
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 2, 6)
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「一緒に風呂か。こういうのも良いな」
		PRINTFORMW 「ふふ、風呂場だから私をいくら汚してくれても構わないぞ？」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

