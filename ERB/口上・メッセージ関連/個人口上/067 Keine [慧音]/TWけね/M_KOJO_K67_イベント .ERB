		ELSEIF TALENT:恋慕
			PRINTFORMDW 何か言いたげな表情でこちらを見ている
			PRINTFORMDW 目を合わせると何も言わずに下を向いてしまった
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMDW 怒りを含んだ表情で睨みつけてきた
			PRINTFORMDW 流石に謝った方がよさそうだ
		ELSE
			PRINTFORMW 「……いい加減にしないか、私だって怒る時はあるぞ？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;泣かせてしまった　[臆病]持ち
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;相手が押し倒しを解除
;==================================================
@M_KOJO_EVENT_K67_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
	;疲れた
		IF TALENT:恋人
			PRINTFORMW 「……はぁ、はぁ……」
			PRINTFORMW 「少し、はしゃぎ過ぎたか……」
			PRINTFORMDW ゆらりと%CALLNAME:MASTER%の身体から離れる慧音
			PRINTFORMW 「先生、少し疲れちゃった……ふふ」
			PRINTFORMDW 汗を滴らせながら艶めかしい笑みを向けてくる彼女だったが、疲れたのは%CALLNAME:MASTER%も同じだった
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……はぁ、はぁ……」
			PRINTFORMW 「はっ……す、すまない、こんなことするつもりじゃあ……！」
			PRINTFORMDW 疲れて我に返った慧音は、まるで漫画のように目を回しながら贖罪の言葉を選んでいる
		ELSE
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
	;満足して解放
		IF TALENT:恋人
			PRINTFORMW 「……ふぅ」
			PRINTFORMDW 深く息をついて%CALLNAME:MASTER%の身体から離れる慧音
			PRINTFORMW 「とりあえず、ご馳走様」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……ふぅ……」
			PRINTFORMW 「はっ……す、すまない、こんなことするつもりじゃあ……！」
			PRINTFORMDW 満足すると同時に我に返った慧音は、まるで漫画のように目を回しながら贖罪の言葉を選んでいる
		ELSE
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
	;満足したところを押し倒された
		IF TALENT:恋人
			PRINTFORMW 「……へっ？」
			PRINTFORMDW 完全に油断していたのか、気の抜けた声と共に無抵抗に押し倒される慧音
			PRINTFORMDW ……が、すぐに陶酔した表情に変わった
			PRINTFORMW 「えへへ……先生いじめられちゃう……？」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「あっ……」
			PRINTFORMW 「あの、そのあの……ご、ごめんなさいっ！」
			PRINTFORMDW 何故か押し倒されながら敬語で謝る慧音
			PRINTFORMDW わたわたと慌ててはいるが、どうも押し退けようとはしてこない
			PRINTFORMDW このまま続けてしまっても構わないだろう
		ELSE
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
	;壊れるまでしてあげる
		IF TALENT:恋人
			PRINTFORMW 「――言ったな？」
			PRINTFORMDW 満足したように一旦身を引いた慧音だったが、好きにして良いと言った途端に再び覆いかぶさってくる
			PRINTFORMDW 気付いているのかいないのか、綻んだ彼女の口から%CALLNAME:MASTER%の胸にとろりと涎が糸を引く
			PRINTFORMDW 文字通り、目の色が変わった……ように見えた
			PRINTFORMW 「ふふ、もう泣き言は聞かないからな……壊れるまで、してやろう……」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「そ、そんなこと言われても、だな……」
			PRINTFORMDW 目を逸らして指をいじいじさせているが、%CALLNAME:MASTER%の上から退こうとはしない
			PRINTFORMDW しばらくそんな状態が続いたが、やがて徐に再び身を乗り出した
		ELSE
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;custom code
;==================================================
;一日の終了時(AFTERTRAニーの前)、面識がなければ呼び出されない
;==================================================
@M_KOJO_EVENT_K67_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		RETURN 1
	ENDIF
	
	;check if nightly events can be called at the end of the day
	IF ARG && TALENT:妊娠 && TALENT:恋慕 && DAYEVENT_TARGET != TARGET ;custom code, if not met, go check on pregnant keine
		IF CFLAG:妊娠経過日数 == 60 && !EXP:出産経験
			PRINTFORMW 「や、やっぱり……出来ちゃった、だよな？」
			PRINTFORMDW 慧音は顔を赤くし、少しばかり期待するような目であなたを見つめている
		ELSEIF CFLAG:妊娠経過日数 >= 71
			IF RAND:3 == 0
				PRINTFORMW 「む、%CALLNAME:MASTER%、来てくれたのか」
				PRINTFORMDW %CALLNAME:MASTER%の姿を見た慧音はそれだけで嬉しそうに笑ってくれた。
				PRINTFORMW 「最近妙にお前に会いたくなるんだ」
				PRINTFORMW 「だから、来てくれて嬉しいよ」
				PRINTFORMDW そう言われて自分も嬉しい。
				PRINTFORMDW 二人はしばらく雑談を交わして楽しんだ。
			ELSEIF RAND:2 == 0
				PRINTFORMW 「む、%CALLNAME:MASTER%、来てくれたのか」
				PRINTFORMDW ベッドの上にいる慧音の前に、ある野菜を見せた。
				PRINTFORMW 「おや、これは…トマトか？　丁度食べたかったんだ。どうして分かったんだ？」
				PRINTFORMDW この時期は一般的にそういう物が食べたくなると聞いたので持ってきた。
				PRINTFORMW 「ふふふ、ありがとう。ん、これはお前が作った野菜か…いつにも増して美味しいな」
			ELSE
				PRINTFORMW 「む、いつも来てくれて悪いな%CALLNAME:MASTER%」
				PRINTFORMDW いやいや、感謝する事では無い。
				PRINTFORMW 「そんな事も無いぞ。お前が来てくれているから私も頑張れるのだぞ？」
				PRINTFORMDW 慧音は微笑みながら、そう言った。
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1

