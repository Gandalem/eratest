@M_KOJO_MESSAGE_COM_K67_68_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			IF TALENT:恋人
				CALL K67_LOVERDEFLOWER
			ELSEIF TALENT:恋慕
				PRINTFORMW 「하아, 하아... 불안하네...」
				PRINTFORMW 「그러니까... 안아줘... 움직이지 않게」
				PRINTFORMDW 당신은 케이네를 뒤에서 강하게 끌어안고 자신의 단단함에 파묻었다.
				PRINTFORMW 「후우... 얼굴은 보이지 않지만... 확실히 느끼고 있어...」
				PRINTFORMDW 그대로 벌린 두 손으로, 케이네의 가슴과 은밀한 곳을 만진다.
				PRINTFORMW 「햐앙! 한 번에... 후훗, 보이지 않는 만큼... 많이 기분 좋게 해 줄 거지?」
				PRINTFORMDW 케이네의 기대에 응답하기 위해, 당신은 허리를 움직이기 시작한다.
				PRINTFORMW 「하아♪ 올라갔다가, 떨어지고... 들어가 줘♪」
				PRINTFORMDW 신음하는 케이네의 몸을 두 손으로 달래면서 삽입을 반복한다.
				PRINTFORMW 「몸 전체를... 너의 몸을 느껴봐...!」
				PRINTFORMW 「하앙, 아아, 굉장해...♪」
			ELSEIF MARK:反発刻印
				PRINTFORMW 「그러니까... 싫다고 말하고 있잖아...」
				PRINTFORMDW 싫어하는 케이네를 설득하지만, 잘 되지 않는다.
				PRINTFORMDW 참지 못한 당신은 강행 수단에 나서는 것을 결정했다.
				PRINTFORMW 「뭐, 놓아라!」
				PRINTFORMDW 뒤에서 케이네의 몸을 안고 그대로 질에 삽입했다.
				PRINTFORMW 「아아악! 싫어... 범해지다니...!」
				PRINTFORMW 「그만둬! 빼라고!」
				PRINTFORMDW 케이네는 필사적으로 외치지만, 그런 것은 신경 쓰지 않고 당신은 허리를 움직인다.
				PRINTFORMW 「앗, 아응, 괴로워... 윽」
				PRINTFORMDW 케이네는 약간 괴로워하는 듯하다.
				PRINTFORMW 「나를 범하다니... 너...!」
				PRINTFORMDW 아무것도 들리지 않는다. 그렇게 생각하면서 당신은 허리를 계속 움직였다.
			ELSE
				PRINTFORMW 「음? 이 체위는……」
				PRINTFORMW 「안겨 있는 것 같아, 행복해…… 가슴도 만져줘……」
			ENDIF
		ELSE
			IF MARK:反発刻印
				PRINTFORMW 「우, 윽...... 싫어......!」
				PRINTFORMDW 케이네는 도망치려 하지만, %조사처리(CALLNAME:MASTER,"는")% 뒤에서 단단히 안고 놓아주지 않는다.
				PRINTFORMDW 그리고 격렬하게 허리를 상하로 움직이며, 케이네의 질 깊숙한 곳까지 페니스를 계속 박아 넣는다.
				PRINTFORMW 「우그, 큭...... 그만둬어......」
			ELSE
				PRINTFORMW 「……앉은 상태로 연결되는 건가? 게다가 뒤에서라니……」
				PRINTFORMDW 고개를 끄덕인다.
				PRINTFORMW 「후우, 어쩜 저런 생각을 해낼 수 있는 거지. 감탄했어」
				PRINTFORMDW 반쯤 어이없다는 듯, 케이네는 말했다. 그리고 그 말은 칭찬으로 받아들여진다.
				PRINTFORMW 「뭐, 어쩔 수 없지. 넣어도 괜찮아?」
			ENDIF
		ENDIF
		CALLF FIRSTTIME("KeineSexDone")
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:12
			CASE 0
				PRINTFORMW 「좀 불안하네…… 더, 강하게 안아줄 수 있겠어? 놓지 않게」
				PRINTFORMDW 뒤에서 케이네의 몸을 꽉 껴안자, 그녀도 %조사처리(CALLNAME:MASTER,"의")% 손에 닿는다
			CASE 1
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 케이네를 뒤에서 강하게 끌어안고, 그 뜨거운 몸을 자신의 단단함에 잠기게 했다.
				PRINTFORMW 「으음...... 얼굴은 보이지 않지만...... 확실히 느끼고 있어...... 들어와 있구나, 응......」
			CASE 2
				PRINTFORMDW 뒤에서 무릎 위에 앉히듯 이어져 있던 케이네의 가슴과 은밀한 곳을 우츠호가 양손으로 만지작거리자 케이네는 기쁜 듯 웃었다.
				PRINTFORMW 「다정한 손길이네요…… 저도, 이런 손길로 만져진다면 몸이 아려올지도 모르겠어요……」
			CASE 3
				PRINTFORMW 「하아, 후후, 좋은 거네…… 전부, 전부, 네게 감싸이고 있어. 나도…… 이봐……」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 팔에 부드럽게 안긴 케이네는 감사하다는 듯 질벽을 꽉 조여 %조사처리(CALLNAME:MASTER,"를")% 감쌌다
			CASE 4
				PRINTFORMDW 숨을 내쉬며 입술을 떨게 하는 케이네의 기대에 부응하듯, 그 몸을 강하게 끌어안고 페니스를 가장 깊숙이 받아들이도록 허리를 흔든다.
				PRINTFORMW 「음으... 올라와, 떨어져... 들어와아... 배가 가득해...」
			CASE 5
				PRINTFORMDW 팔 안에서 신음하는 케이네의 몸을 양손으로 어루만지며 행위를 계속한다. %조사처리(CALLNAME:MASTER,"의")% 애무에 동조하여, 질이 남성기를 찾는 것처럼 수축을 반복하고 있다.
				PRINTFORMW 「더, 쓰다듬어줘…… 상냥하게 해주면 가슴이 터질 것 같아서 다른 생각 할 수가 없어……」
			CASE 6
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 케이네를 안고 머리 향을 만끽하며, 그 뜨거운 몸을 흔들었다.
				PRINTFORMW 「목덜미에 숨결이 닿아서... 조금, 간지러울지도...」
			CASE 7
				PRINTFORMW 「하, 하아윽……응, 연결되어 있어……」
				PRINTFORMW 「빼지 말아줘…… 뿌리까지 넣어줘……」
				PRINTFORMW 「질도 자궁도, 네 정자로 가득 채워줘……」
			CASE 8
				PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 손을 가슴에 대고, 스스로 음핵을 만지고 있다.
				PRINTFORMW 「최고로 기분 좋게 해줘……」
				PRINTFORMW 「절정에 달하면 질 깊숙한 곳이 확장하고 수축하며, 펌프 운동을 한다고……」
				PRINTFORMW 「정자를 조금이라도 많이 자궁 안에 삼키기 위해서야……그래서……」
				PRINTFORMW 「많이 기분 좋아져서, 너와의 아이……응, 음윽……」
			CASE 9
				PRINTFORMW 「흡... 후우...」
				PRINTFORMW 「이거 굉장하다%CALLNAME:MASTER%. 네 모습이 보이지 않는 것뿐만이 아니라」
				PRINTFORMW 「가슴과 아래를 동시에 공략하다니...」
				PRINTFORMW 「이렇게서는 아이도 갖기 어려울 게 아닌가...」
				PRINTFORMDW 그렇다면, 더 감당할 수 없는 상태로 만들어 주지.
				PRINTFORMW 「잠깐, 움직임이 격해져서... 아앙」
			CASE 10
				PRINTFORMW 「아앙, 기분… 너무 좋아…」
				PRINTFORMW 「안쪽이랑 가슴이랑 클리로… 하아♪ 전부 공격당해서… 행복해…」
				PRINTFORMDW 당신은 머리 향을 만끽하며 케이네의 몸을 농락했다.
				PRINTFORMDW 그럴 때마다, 케이네는 달콤한 신음소리를 냈다.
			CASE 11
				PRINTFORMW 「이 체위는… 나는 받는 것뿐이니까…」
				PRINTFORMW 「내 질… 기분 좋으려나?」
				PRINTFORMDW 케이네의 질문에, 당신은 고개를 끄덕인다.
				PRINTFORMW 「…그렇구나」
				PRINTFORMDW 케이네는 작게 미소 짓는다. 다시 질 안쪽이 조금 세게 조여왔다.
		ENDSELECT
		RETURN 1
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:9
			CASE 0
				PRINTFORMW 「그러니까…… 싫다고 말하고 있잖아…… 적당히 하지 그래」
				PRINTFORMDW 케이네의 설득을 무시하고 %조사처리(CALLNAME:MASTER,"는")% 강제로 행위에 나섰다……
			CASE 1
				PRINTFORMDW 등 뒤에서 압박하듯이 케이네의 몸을 안고, 기대감에 부풀어 오른 페니스를 깊숙이 밀어 넣는다...
				PRINTFORMW 「놓아줘... 놓아줘... 제발...!」
			CASE 2
				PRINTFORMW 「바보 같아... 어서 떨어져」
				PRINTFORMDW 케이네는 침착하게 %조사처리(CALLNAME:MASTER,"를")% 타이르지만, 그런 말은 신경 쓰지 않고 쾌감을 탐하는 듯한 난폭한 행위를 계속했다.
			CASE 3
				PRINTFORMW 「아, 윽…… 젠장……」
				PRINTFORMDW 반쯤 강제로 밀어 넣어지는 난폭한 행위에 케이네는 조금 괴로워하는 듯했다.
			CASE 4
				PRINTFORMW 「나를 범하다니... 네놈은...!」
				PRINTFORMDW 무언가 들린 것 같은 기분이 들었지만, 그저 착각이라고 생각하며 %조사처리(CALLNAME:MASTER,"는")% 계속 허리를 움직였다.
			CASE 5
				PRINTFORMW 「우으... 기분 좋다고는... 될 리가 없어...」
				PRINTFORMDW 케이네는 자신의 쾌감을 부정하지만, 흘러나오는 애액을 멈출 수는 없는 것 같다.
			CASE 6
				PRINTFORMW 「너무 만지지 마…… 가지고 놀면…… 큭……」
				PRINTFORMDW 온갖 민감한 부위를 공격당하며 의지와는 반하게 밀려오는 쾌감에, 케이네는 마치 어린아이처럼 눈물 가득한 채 당황하고 있었다
			CASE 7
				PRINTFORMW 「넣어져 있다는 것만으로도 싫은데……아, 앙」
				PRINTFORMW 「이렇게 밀착하는 자세라니……」
			CASE 8
				PRINTFORMW 「……그만해…… 빼줘!!」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 몸부림치는 케이네를 놓치지 않고, 깊숙이 계속해서 페니스를 박아 넣었다…….
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……음흡……두, 아파……」
				PRINTFORMW 「흔들지 말아줘……아아아……」
			CASE 1
				PRINTFORMW 「윽, 네 모습은 보이지 않는데... 가슴과 아래쪽이 공격당하고 있어...」
				PRINTFORMW 「부서져 버릴 것 같아...」
				PRINTFORMW 「하아, 속도를 높이지 마...」
			CASE 2
				PRINTFORMW 「으윽… 기분 좋다는 건…」
				PRINTFORMDW 케이네는 자신의 쾌감을 부정하지만, 흘러나오는 애액을 멈출 수는 없다.
				PRINTFORMW 「그렇게 가지고 놀면… 너무 기분이 좋아서… 부서질 것 같아…」
				PRINTFORMDW 마치 어린아이처럼, 케이네는 울면서 쾌감에 당황했다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
