RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_188_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「シャワーを浴びれば良いのか？」
			PRINTFORMW 「恥ずかしくないことはないが、そんなところ見て楽しいのか……？」
			PRINTFORMDW 首を傾げながらシャワーを浴びる慧音の肌は、お湯が滴って淫靡に輝いている。
			PRINTFORMDW 熱を帯びて紅潮してきた肌も、%CALLNAME:MASTER%の目を十分に楽しませた。
		ELSE
			PRINTFORMW 「シャワー……？　まぁ、汚いまま犯されるよりはましか……」
			PRINTFORMW 「だがお前が汚いと私が嫌だ。次はお前の番だぞ」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:シャワー
		IF TALENT:恋人 && RAND:3
			PRINTFORMW 「ほら、お前の事を洗ってやる。綺麗にしとかないといけないだろう？」
			PRINTFORMDW そう言って慧音は、嬉しそうに%CALLNAME:MASTER%の体を洗い始めた。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「シャワーか、よし。隅々まで洗うぞっ」
			PRINTFORMW 「……あ、臭う方が興奮する部位があれば言ってくれ……」
			PRINTFORMDW 慧音はそう言ってはにかんでから、シャワーのコックを捻った。 
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「……仕方無いな、洗ってやる」
			PRINTFORMW 「ほら、綺麗にしてやるから、こっちに来い」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「何度も何度も……そんなに臭いか？　私の体……」
			PRINTFORMDW %CALLNAME:MASTER%がわざと大きく頷くと、慧音の目が潤んでしまった。
			PRINTFORMW 「わかった……臭いのは嫌だものな、お互い……」
			RETURN 1
		ENDIF
	;終了
	ELSE
		IF TALENT:恋慕
			PRINTFORMW 「ふぅ。気持ち良かったな」
			PRINTFORMW 「さて、続きをやるのか？」
			PRINTFORMW 「だったら、もう一回お前の事を洗ってやらないとな」
		ELSE
			PRINTFORMW 「ふぅ。さっぱりしたな」
		ENDIF 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;189,新妻プレイ
;==================================================
@M_KOJO_MESSAGE_COM_K67_189
CALL M_KOJO_MESSAGE_COM_K67_189_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_189_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「わっ……」
			PRINTFORMDW 慧音は口元を覆って、赤くなったまま動かなくなってしまった。
			PRINTFORMW 「擬似でも嬉しいぞ……本当にもらってくれたら、もっとだが……」
			PRINTFORMDW 消えそうな程小さな声でそう言いながら、嬉しそうにエプロンを身に着けた。
		ELSE
			PRINTFORMW 「む？　ままごとか？」
			PRINTFORMW 「まぁ……全裸だろうが着衣だろうが、乱暴されるのに変わりないしな」
			PRINTFORMDW 慧音は何の感動も無くエプロンを受け取り、手際良く身につけた。
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:新妻プレイ
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「やったっ」
			PRINTFORMDW エプロンを見せた瞬間、子供のように喜んだ。
			IF RAND:2
				PRINTFORMDW 慧音にエプロンを着せると、慧音は頬を赤らめてあなたに振り向いた。
				PRINTFORMW 「に、似合ってるか……？ 旦那様……？」
			ELSE
				PRINTFORMW 「今日も、旦那様にたっぷりご奉仕するぞ！」
				PRINTFORMDW 焦り気味にエプロンを身に着けると、嬉しそうに抱きついてきた。
			ENDIF
			PRINTFORMW 「いつか、本当にこうやって出迎えられたらいいのにな……なぁ、いつか私を……嫁にして、くれるな？」
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORMW 「…私は着せ替え人形じゃないぞ？」
			PRINTFORMW 「はぁぁぁぁぁ…………」
			PRINTFORMDW 長い長いため息を吐きながら、慧音は渋々とエプロンを身につけた
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW （こっこの格好は恥ずかしいな……）
			PRINTFORMW 「ふふっ、どうだ、%CALLNAME:MASTER%？　似合っているだろうか？」
			PRINTFORMDW とても似合っているというと、慧音は嬉しそうに笑った。
			RETURN 1
		;それ以外
		ELSE
			IF RAND:2
				PRINTFORMW 「この程度で興奮してくれるなら楽で良い」
				PRINTFORMW 「あまり変な格好をさせられるのは嫌だがな」
			ELSE
				PRINTFORMW 「ちゃんとした服を返してもらいたいものだな」
				PRINTFORMDW 慧音は白けた目つきであなたを見つめながらも、慣れた素振りでエプロンを身に着けた
			ENDIF
			RETURN 1
		ENDIF
	;終了
	ELSE
		IF FIRSTTIME("KeineApronTakeOff")
			IF TALENT:恋慕
				PRINTFORMW 「え、もう外すのか？　ん……残念」
				PRINTFORMDW 寂しそうな表情になってしまったので、抱きしめて優しく撫でてやった。
				PRINTFORMW 「ん……大好きだぞ……」
				PRINTFORMDW 慧音は%CALLNAME:MASTER%の胸に顔を埋め、強く抱きついてきた……。
			ELSE
				PRINTFORMW 「着ろとか脱げとか、忙しいやつだな」
				PRINTFORMW 「また使うから洗濯しとけ、だと？　はぁ……」
				PRINTFORMW 「私はお前の妻ではな……ハッ！？」
				PRINTFORMDW ようやく意味を理解したのか、%CALLNAME:MASTER%の顔を見て真っ赤になってしまった。
			ENDIF
			RETURN 1
		ENDIF
	
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「これを脱ぐとき、いつもすごく切ないんだ」
			PRINTFORMW 「結局、奴隷のような立場のままで、擬似にすぎないではないか、と思ってな」
			PRINTFORMW 「でも……捨てられるよりは、奴隷で居られる方がまだずっと幸せだ……」
			PRINTFORMDW 話の途中で慧音の声が震えだしたと思ったら、目から涙がこぼれ落ちた。
			PRINTFORMW 「ん、すまない……続きをしよう」
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORMW 「ようやく終わったか……」
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「ふう、こういう格好はまたやってみたいな……」
			PRINTFORMW 「また洗濯しておけば良いんだな？」
			PRINTFORMDW 慧音はそう言って、ふふんと得意げに鼻を鳴らした。
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「まあ、たまにはこういう格好をやってみても良いかもしれないな……」
			RETURN 1
		ENDIF 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
