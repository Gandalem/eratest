;==================================================

@M_KOJO_MESSAGE_COM_K67_90
CALL M_KOJO_MESSAGE_COM_K67_90_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF TALENT:恋人 && RAND:3 ;custom code
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「이것만으로 그렇게 얼굴을 녹게 하다니... 완전히 성감대가 되어버렸네」
				PRINTFORMW 「변태」
			CASE 1
				PRINTFORMW 「후후, 직장 검사 시간이야」
				PRINTFORMW 「우선 준비부터 해야겠지」
		ENDSELECT
		RETURN 1
	ELSEIF TALENT:恋慕
		PRINTFORMW 「에, 음...」
		PRINTFORMW 「이, 이걸로 괜찮은... 거야?」
		PRINTFORMDW 이쪽의 안색을 살피며 항문에 손가락을 삽입하는 케이네
		PRINTFORMW 「...미안해, 잘 몰라서 그래...」
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「기분 좋으냐?... 그렇다면 괜찮다」
		PRINTFORMDW 무심하게 %조사처리(CALLNAME:MASTER,"의")% 항문을 희롱하는 케이네
		PRINTFORMDW 뭐라고 말할 수 없는 무기질함이 오히려 %조사처리(CALLNAME:MASTER,"의")% 흥분을 유발했다
		;それ以外
	ELSE
		PRINTFORMW 「하고 싶다고 하는 건 아직 알겠지만, 이런 걸 당하고 싶어하는 사람도 있다니」
		PRINTFORMW 「세상 참 넓구나」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
