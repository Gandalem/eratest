;==================================================
@M_KOJO_MESSAGE_COM_K67_140
CALL M_KOJO_MESSAGE_COM_K67_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF MARK:反発刻印
			PRINTFORMW 「むっ無理矢理こんな事をするな！！」
			PRINTFORMDW 怒りを込めた眼で、慧音は%CALLNAME:MASTER%を強く睨んできた。
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「そんな無理矢理……！　んぐ、苦し……」
			PRINTFORMW 「ん、ぐ……ちゅぱ、ちゅぷ……」
			PRINTFORMDW 慧音は苦しみながらも、一生懸命にペニスをしゃぶって快楽を与えようとしている。
		ELSE
			PRINTFORMW 「ん、ぐ……げぇっ！！」
			PRINTFORMDW 慧音は%CALLNAME:MASTER%の腹を押して必死に抵抗している……。
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF FLAG:70
	ELSEIF TALENT:恋人
		IF DAY:3 == 15 && (TIME:0 <= 240 || TIME:0 >= 1140)
			PRINTFORMW 「んぶぅっ……ぉごっ……ぐ……ぅ……！！」
			PRINTFORMDW 白澤と化した慧音の立派な角を掴み、彼女の喉に容赦なくペニスを突き立てる
			PRINTFORMDW 酸素を求めているのか、はたまた暴力に奉仕で返しているのか、裏筋を這う舌の感触がたまらない
			PRINTFORMDW 忙しなく揺れる尻尾を見る限り、悦んでいるのだろう
		ELSEIF RAND:2
			PRINTFORMW 「んっ……ぐっ、こほっ……げほっ！！」
			PRINTFORMDL 色々な液体を垂れ流しながら道具として扱われる慧音
			PRINTFORMDW 酸欠であることは明らかだったが、%CALLNAME:MASTER%に絡みついた慧音の腕は離れようとしない
		ELSE ;custom code added
			PRINTFORMW 「んぷっ……んぐ……」
			PRINTFORMW 「ぷは……乱暴にされるのも少し興奮するな……んむっ」
			PRINTFORMDW 慧音は唾液を垂らしながら、歯を唇で包んでペニスを受け入れている。
			PRINTFORMDW その献身的な姿に興奮した%CALLNAME:MASTER%は、さらに乱暴に口内を犯した……。
		ENDIF
	ELSEIF TALENT:恋慕
		PRINTFORMW 「……私は、大丈夫だ」
		PRINTFORMDW 控えめに口を開きながら、頭に添えられる%CALLNAME:MASTER%の手を受け入れる
		PRINTFORMW 「……好きに、使ってくれ……」
		PRINTFORMDW 随分従順になったものだ
		RETURN 1
	ELSEIF MARK:反発刻印
		PRINTFORMW 「やっ、ひゃめろっ……うぐ、げっほ……んむぅ！！」
		PRINTFORMDW %CALLNAME:MASTER%は嫌がる慧音の頭を押さえつけ、欲望のままに腰を振った……。
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「むっ……やはりこれには慣れないな……」
		PRINTFORMDL 激しさこそないが、無意識に軽い抵抗をしている
		PRINTFORMDW 嘔吐感というのは身体の反射だ……なかなか慣れないのも無理はない
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「げほっ……口でしたいならこちらからしてやるのに……」
		PRINTFORMW 「ぐっ、おぇ……じゅるっ……」
		PRINTFORMDW 慧音の口内は唾液でよく滑り、膣とは違った感触を楽しませてくれた……。 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

