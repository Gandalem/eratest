;140,イラマチオ custom code expanded
;==================================================

@M_KOJO_MESSAGE_COM_K67_140
CALL M_KOJO_MESSAGE_COM_K67_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF MARK:反発刻印
			PRINTFORMW 「크윽, 무리해서 이런 짓 하지 마!!」
			PRINTFORMDW 분노를 담은 눈으로, 케이네는 %조사처리(CALLNAME:MASTER,"를")% 강하게 노려보았다.
		ELSEIF ABL:奉仕精神 >= 3
			PRINTFORMW 「그런 무리하게...! 응구, 고통스러워...」
			PRINTFORMW 「응, 구... 쪽, 쭉...」
			PRINTFORMDW 케이네는 괴로워하면서도 열심히 페니스를 빨아 쾌락을 주려고 하고 있다.
		ELSE
			PRINTFORMW 「응, 으윽…… 구역질이 난다!!」
			PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 배를 누르며 필사적으로 저항하고 있다…….
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF FLAG:70
	ELSEIF TALENT:恋人
		IF DAY:3 == 15 && (TIME:0 <= 240 || TIME:0 >= 1140)
			PRINTFORMW 「음으윽……흐읍……크윽……우……!!」
			PRINTFORMDW 백사와 변한 케이네의 당당한 뿔을 잡고, 그녀의 목구멍에 가차 없이 페니스를 박아넣는다.
			PRINTFORMDW 산소를 원하는 걸까, 아니면 폭력에 봉사로 응답하는 걸까, 등줄기를 타고 기어가는 혀의 감촉이 참을 수 없다.
			PRINTFORMDW 바쁘게 흔들리는 꼬리를 보니, 즐기고 있는 모양이다.
		ELSEIF RAND:2
			PRINTFORMW 「응... 크윽, 콜록... 게홉!!」
			PRINTFORMDL 온갖 액체를 흘리며 도구처럼 다루어지는 케이네
			PRINTFORMDW 산소가 부족한 것은 분명했지만, %조사처리(CALLNAME:MASTER,"에게")% 매달린 케이네의 팔은 떨어지려 하지 않았다
		ELSE
			PRINTFORMW 「음프……응구……」
			PRINTFORMW 「푸하……난폭하게 당하는 것도 조금 흥분한다……응무」
			PRINTFORMDW 케이네는 침을 흘리면서 입술로 페니스를 감싸 받아들이고 있다.
			PRINTFORMDW 그 헌신적인 모습에 흥분한 %조사처리(CALLNAME:MASTER,"는")% 더욱 난폭하게 구강을 범했다…….
		ENDIF
	ELSEIF TALENT:恋慕
		PRINTFORMW 「……나는, 괜찮다」
		PRINTFORMDW 조심스럽게 입을 열면서, 머리에 올려진 %조사처리(CALLNAME:MASTER,"의")% 손을 받아들인다.
		PRINTFORMW 「……마음대로, 써줘……」
		PRINTFORMDW 꽤 순종적이 되었구나
		RETURN 1
	ELSEIF MARK:反発刻印
		PRINTFORMW 「읏, 비켜라... 크윽, 콜록... 으음!!」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 싫어하는 케이네의 머리를 눌러버리고 욕망대로 허리를 흔들었다....
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「흥……역시 이것에는 익숙해지지 않네……」
		PRINTFORMDL 격렬함은 없지만, 무의식적으로 가벼운 저항을 하고 있다.
		PRINTFORMDW 구토감이라는 것은 신체의 반사다…… 좀처럼 익숙해지지 않는 것도 무리가 아니다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「콜록… 입이 보고 싶다면 여기서 해줄 수 있는데…」
		PRINTFORMW 「윽, 어우… 질척…」
		PRINTFORMDW 케이네의 구강은 침으로 잘 미끄러졌고, 질과는 다른 감촉을 즐길 수 있게 해주었다…. 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
