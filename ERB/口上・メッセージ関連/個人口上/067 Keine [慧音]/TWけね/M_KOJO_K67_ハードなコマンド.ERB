
;custom code added
;※※※※※※※※※※※※※※※※※※※※※※※※※
;加虐系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;100,スパンキング
;==================================================
@M_KOJO_MESSAGE_COM_K67_100
CALL M_KOJO_MESSAGE_COM_K67_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……四つん這いになったが、何をするんだ？」
		PRINTFORMDW 四つん這いになった慧音を%CALLNAME:MASTER%は勢い良く叩いた。
		IF TALENT:恋慕
			PRINTFORMW 「ンンッ！？　な、なんだいきなり……いくらお前でもやって良い事と悪い事があるぞ！」
			PRINTFORMDW 慧音は%CALLNAME:MASTER%を強く睨みつけた。
			PRINTFORMW 「大きな尻が目の前で揺れるから気になったって……？」
			PRINTFORMW 「だからって叩くこと無いだろう……うぅ」
		ELSE
			PRINTFORMW 「痛いっ！　子供じゃないんだぞ！！」
			PRINTFORMW 「まぁ他の部位を殴られるよりは良いが……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2
			PRINTFORMW 「うんっ……なんだか、子供の頃いたずらをして叩かれたのを思い出すな……」
			PRINTFORMW 「至らぬ所もあるだろう……お、おしおき……してくれ……」
			PRINTFORMDW 慧音は赤く腫れた尻を悩ましげに揺らして、お仕置きをねだっている。
		ELSE
			PRINTFORMW 「ふぁっ、叩かれてるのに、何だか変な感じがしてきた…」
			PRINTFORMW 「…もっと叩いてくれないか？」
			PRINTFORMDW お望み通り、%CALLNAME:MASTER%は慧音を叩くペースを速めた。
			PRINTFORMW 「あっ、良いかもしれない……」
		ENDIF
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「くっ、せめてもう少し優しく叩いても良いんじゃないか？」
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「私のこと憎たらしいのか……こっちも不愉快だぞ」
		PRINTFORMDW 平手が打ち下ろされる度に悲鳴を上げながらも、慧音は反抗的に睨みつける。 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;104,アイマスク
;==================================================
@M_KOJO_MESSAGE_COM_K67_104
CALL M_KOJO_MESSAGE_COM_K67_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「目隠しをするのか？」
			PRINTFORMW 「まあ良いけれど……」
			PRINTFORMDW 慧音にアイマスクを装着させた。
			PRINTFORMW 「%CALLNAME:MASTER%……暗くてよく見えないのだが」
			PRINTFORMW 「それにお前も見えないんだ…外してくれないか？」
			PRINTFORMDW 外してやりたくなったが、それでは意味が無いので、仕方無く慧音の頼みを無視する事にした。
		ELSEIF MARK:反発刻印
			PRINTFORMW 「なっ……何をする！」
		ELSE
			PRINTFORMW 「目隠しをするのか？」
			PRINTFORMW 「まあ良いけれど……」
			PRINTFORMDW 慧音にアイマスクを装着させた。
			PRINTFORMW 「……何も見えないな」
		ENDIF		
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「はぁ、はぁ……これから何をしてくれるんだ……？」
			PRINTFORMDW 独り暗闇の中、慧音は想像を膨らませて秘部を湿らせている……。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「周りが見えないのも辛いけれど……」
			PRINTFORMW 「やはりお前が見えないのが一番辛いな……」
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORMW 「やめろ……」
			PRINTFORMDW 怯える慧音の乳首をつまんでやると、体を大きく跳ねさせた。
			PRINTFORMDW 言葉とは裏腹に、随分興奮しているようだ。
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「周りが見えないと辛いな……」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「くっ、何も見えないな…」
			PRINTFORMW 「こんなことして何の意味があるんだ……」
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「ん？　付けっぱなしの方が興奮するのにな……」
			PRINTFORMW 「でも、お前の顔が見えないし、付けっぱなしも良くないか」
		;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「ふう……やっとお前の姿を見る事が出来た…」
			PRINTFORMDW そう言って慧音は%CALLNAME:MASTER%に抱きついてきた。 
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORMW 「眩しい……急に外すんじゃない」
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「ふう……やっと周りが見えるようになった」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「…ようやく終わったのか」
			RETURN 1
		ENDIF 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;105,縄
;==================================================
@M_KOJO_MESSAGE_COM_K67_105
CALL M_KOJO_MESSAGE_COM_K67_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「縄で縛るのか……？　変わってるな…」
		ELSE
			PRINTFORMW 「縄で縛るのか……？　最早呆れたとしか……」
		ENDIF 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「あ、あぁ……全身に愛撫されているようだぞ……」
			PRINTFORMDW 慧音は、食い込む縄の感触に浸っている。
			PRINTFORMDW 大きな胸が搾り出され張り詰める様子は、一味違う興奮を呼んだ……。
		;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「なっ何だか縛られてると……落ち着くんだ」
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「嫌だ……縛って何する気だ……」
			PRINTFORMDW だが縄で締め上げられる度、口からは悩ましげな吐息がこぼれた……。 
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「やめろ……！　いくら言うこと聞かないからって、こんな……！」
			PRINTFORMDW %CALLNAME:MASTER%は暴れまわる慧音を押さえつけ、瞬く間に亀甲縛りを仕上げた。
			PRINTFORMW 「うぐっ……痛い……」
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「は、あぁ……痕が残ってしまったぞ……」
			PRINTFORMDW 慧音は縄の痕をなぞり、ひりひりするその感触に恍惚の表情を見せた……。 
		;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「勿論自由に動けた方が良いけれども……」
			PRINTFORMW 「縛られても悪くないしれない……」
			RETURN 1
		;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「やっぱり自由の方が良いな」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「やっやっと動けるようになったな……」
			PRINTFORMW 「ここまでして私の体を弄びたいのか……」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

