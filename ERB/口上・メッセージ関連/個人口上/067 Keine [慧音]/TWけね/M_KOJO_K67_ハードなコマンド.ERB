;104,アイマスク
;==================================================

@M_KOJO_MESSAGE_COM_K67_104
CALL M_KOJO_MESSAGE_COM_K67_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「눈가리개를 할 건가?」
			PRINTFORMW 「뭐 괜찮긴 하지만……」
			PRINTFORMDW 케이네에게 눈가리개를 착용시켰다.
			PRINTFORMW 「%CALLNAME:MASTER%……어두워서 잘 보이지 않는데」
			PRINTFORMW 「게다가 너도 안 보이잖아… 벗겨주지 않을래?」
			PRINTFORMDW 벗겨주고 싶어졌지만, 그러면 의미가 없으므로 어쩔 수 없이 케이네의 부탁을 무시하기로 했다.
		ELSEIF MARK:反発刻印
			PRINTFORMW 「뭐... 뭘 하는 거야!」
		ELSE
			PRINTFORMW 「눈가리개를 할 건가?」
			PRINTFORMW 「뭐 괜찮지만……」
			PRINTFORMDW 케이네에게 눈가리개를 착용시켰다.
			PRINTFORMW 「……아무것도 보이지 않는군」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「하아, 하아... 이제부터 뭘 해줄 거야...?」
			PRINTFORMDW 혼자 어둠 속에서 케이네는 상상을 부리며 은밀한 곳을 축축하게 만들고 있다...
		ELSEIF TALENT:恋慕
			PRINTFORMW 「주변이 보이지 않는 것도 괴롭지만……」
			PRINTFORMW 「역시 네가 보이지 않는 게 가장 괴롭구나……」
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORMW 「그만둬……」
			PRINTFORMDW 떨고 있는 케이네의 젖꼭지를 잡아주자, 몸을 크게 움찔했다.
			PRINTFORMDW 말과는 달리 꽤 흥분한 것 같다.
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「주변이 보이지 않으니 괴롭네...」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「윽, 아무것도 보이지 않아...」
			PRINTFORMW 「이런 걸 하고 무슨 의미가 있는 거지...」
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「응? 계속 달고 있는 게 더 흥분되는데……」
			PRINTFORMW 「하지만, 네 얼굴이 보이지 않고, 계속 달고 있는 것도 좋지 않아」
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「후우... 드디어 너의 모습을 볼 수 있게 되었어...」
			PRINTFORMDW 그렇게 말하며 케이네는 %조사처리(CALLNAME:MASTER,"에게")% 안겼다. 
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORMW 「눈부셔... 갑자기 벗지 마.」
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「후우... 드디어 주변이 보이기 시작했어」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「...드디어 끝난 건가」
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
