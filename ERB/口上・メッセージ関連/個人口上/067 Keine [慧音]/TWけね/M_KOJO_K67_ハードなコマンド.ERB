;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K67_100
CALL M_KOJO_MESSAGE_COM_K67_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……네 발로 기게 되었지만, 뭘 하려는 거지?」
		PRINTFORMDW 네 발로 기게 된 케이네를 %조사처리(CALLNAME:MASTER,"는")% 힘차게 때렸다.
		IF TALENT:恋慕
			PRINTFORMW 「응?!? 뭐, 뭐야 갑자기... 아무리 너라도 해도 되는 일과 안 되는 일이 있는 거야!」
			PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"를")% 강하게 노려보았다.
			PRINTFORMW 「큰 엉덩이가 눈앞에서 흔들려서 신경 쓰인다고...?」
			PRINTFORMW 「그렇다 해도 때릴 수는 없잖아... 으윽」
		ELSE
			PRINTFORMW 「아파! 애가 아니라고!!」
			PRINTFORMW 「뭐 다른 부위를 맞기보다는 낫지만...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2
			PRINTFORMW 「음... 뭔가 어린 시절 장난치다가 맞았던 게 생각나네...」
			PRINTFORMW 「부족한 점도 있겠지... 어, 벌을... 내려줘...」
			PRINTFORMDW 케이네는 빨갛게 부어오른 엉덩이를 괴로운 듯 흔들며 꾸중을 바라고 있다.
		ELSE
			PRINTFORMW 「흐읍, 맞고 있는데, 어쩐지 이상한 기분이 들었어…」
			PRINTFORMW 「…더 때려주지 않을래?」
			PRINTFORMDW 원하던 대로, %조사처리(CALLNAME:MASTER,"는")% 케이네를 때리는 속도를 높였다.
			PRINTFORMW 「아, 좋은 걸지도 몰라…」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「크윽, 적어도 조금 더 부드럽게 때려도 괜찮지 않을까?」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「나를 미워하는 건가…… 나도 불쾌해질 뿐이다」
		PRINTFORMDW 평평한 손이 내려칠 때마다 비명을 지르면서도, 케이네는 반항적으로 노려본다. 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
