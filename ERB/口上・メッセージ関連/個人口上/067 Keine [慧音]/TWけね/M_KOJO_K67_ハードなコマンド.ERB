@M_KOJO_MESSAGE_COM_K67_105
CALL M_KOJO_MESSAGE_COM_K67_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「밧줄로 묶는 건가...? 특이하네...」
		ELSE
			PRINTFORMW 「밧줄로 묶을 건가...? 이제는 어이없다고밖에...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「아, 아아... 전신이 애무당하는 것 같아...」
			PRINTFORMDW 케이네는 파고드는 밧줄의 감촉에 잠겨 있었다.
			PRINTFORMDW 커다란 가슴이 짜여지며 팽팽해지는 모습은 사뭇 다른 흥분을 불러일으켰다....
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「뭐야, 묶여 있으니… 마음이 편해져」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「싫어... 묶어서 뭘 하려는 거야...」
			PRINTFORMDW 하지만 밧줄에 조여질 때마다 입에서는 괴로워하는 듯한 숨소리가 새어 나왔다...。 
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「그만둬...! 아무리 말을 듣지 않아도, 이런 건...!」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 날뛰는 케이네를 제압하고 순식간에 거꾸로 묶었다.
			PRINTFORMW 「으윽... 아파...」
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF ABL:マゾっ気 >= 5
			PRINTFORMW 「하, 아아... 흔적이 남고 말았어...」
			PRINTFORMDW 케이네는 밧줄의 흔적을 더듬으며, 따끔거리는 그 감촉에 황홀한 표정을 지었다... 
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「물론 자유롭게 움직일 수 있는 편이 좋겠지만……」
			PRINTFORMW 「묶여 있어도 나쁘지 않을지도……」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「역시 자유로운 게 좋네」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「드디어 움직일 수 있게 되었네……」
			PRINTFORMW 「이 지경까지 해서 내 몸을 가지고 놀고 싶은 건가……」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
