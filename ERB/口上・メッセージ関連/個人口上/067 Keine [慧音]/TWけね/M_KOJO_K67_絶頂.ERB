@M_KOJO_MESSAGE_PALAMCNG_D_K67(ARG)
;-------------------------------------------------
;After reaching certain threshold for palams for the first time
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;don't show if unconscious
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 0
	
;-------------------------------------------------
;初めて好意がLV2超えた
;-------------------------------------------------
IF !(MARK:反発刻印 || CFLAG:ブチギレ) && PALAM:好意 + UP:好意 > PALAMLV:3 && FIRSTTIME("好意V2")
	PRINTFORMW （……ふむ、%CALLNAME:MASTER%は悪くないかもな）
ENDIF

SIF CFLAG:うふふ != 1 ;don't show stuff below unless having sex
	RETURN 0
	
;-------------------------------------------------
;初めて潤滑がLV2超えた
;-------------------------------------------------
IF PALAM:潤滑 + UP:潤滑 > PALAMLV:2 && FIRSTTIME("潤滑V2")
	IF IS_SELECTCOM("ローション")
		PRINTFORMW 「変なところで私の体を気遣うのだな……」
		PRINTFORMW 「すごい粘性だぞ……」
	ELSE
		IF TALENT:恋慕
			PRINTFORMW 「な、なんで濡れてるって……」
			PRINTFORMW 「多分、き、気持ち良いから……じゃないのか？ って、何を言わせるんだお前は」
		ELSE
			PRINTFORMW 「愛液だと？　粘膜を守ろうとして、体液が分泌しているだけだ……」
			PRINTFORMW 「単なる生理現象だよ、鬼の首でも獲ったみたいに勝ち誇るんじゃない」
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
IF PALAM:欲情 + UP:欲情 > PALAMLV:3 && FIRSTTIME("欲情V2")
	IF IS_SELECTCOM("媚薬")
		PRINTFORMW 「卑怯者……ここまでして、私を手篭めにしたいか……あ、ん……」
		PRINTFORMDW 慧音の肌は紅潮して汗ばみ、乳首は硬くしこっている……。
		PRINTFORMDW クリトリスも充血し、膨らんでその存在を主張している……。
		PRINTFORMDW ……効果は十分なようだ。
	ELSE
		PRINTFORMW （駄目だ……私、我慢できなくなりそう……）
		PRINTFORMW （ここで終わられたらと思うと切ない……）
		PRINTFORMW （生理現象とはいえ……くぅ……）
	ENDIF
ENDIF

;-------------------------------------------------
;初めて恥情がLV2超えた
;-------------------------------------------------
IF PALAM:恥情 + UP:恥情 > PALAMLV:3 && FIRSTTIME("恥情V2")
	IF TALENT:恋慕
		PRINTFORMW 「……%CALLNAME:MASTER%の前だから、より一層恥ずかしいぞ」
	ELSE
		PRINTFORMW 「…恥ずかしいぞ」
	ENDIF
	PRINTFORMW 「見ないでくれ……」
ENDIF

;-------------------------------------------------
;初めて恐怖がLV2超えた
;-------------------------------------------------
IF PALAM:恐怖 + UP:恐怖 > PALAMLV:3 && FIRSTTIME("恐怖V2")
	PRINTFORMW 「私をどうする気なんだ……」
	PRINTFORMDW 慧音は青ざめて、恐怖に満ちた視線で%CALLNAME:MASTER%の様子を伺っている……
	IF TALENT:恋慕
		PRINTFORMW （こっ怖い……助けて、%CALLNAME:MASTER%）
	ELSE
		PRINTFORMW （こっ怖い……）
	ENDIF
	PRINTFORMW （わ、私は、臆してなど！）
ENDIF
