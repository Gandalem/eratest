@M_KOJO_MESSAGE_PALAMCNG_D_K67(ARG)
;-------------------------------------------------
;After reaching certain threshold for palams for the first time
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;don't show if unconscious
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 0
;-------------------------------------------------
;初めて好意がLV2超えた
;-------------------------------------------------
IF !(MARK:反発刻印 || CFLAG:ブチギレ) && PALAM:好意 + UP:好意 > PALAMLV:3 && FIRSTTIME("好意V2")
	PRINTFORMW (......흠, %조사처리(CALLNAME:MASTER,"는")% 나쁘지 않을지도 모르겠군)
ENDIF
SIF CFLAG:うふふ != 1 ;don't show stuff below unless having sex
	RETURN 0
;-------------------------------------------------
;初めて潤滑がLV2超えた
;-------------------------------------------------
IF PALAM:潤滑 + UP:潤滑 > PALAMLV:2 && FIRSTTIME("潤滑V2")
	IF IS_SELECTCOM("ローション")
		PRINTFORMW 「이상한 곳에서 내 몸을 배려하는구나……」
		PRINTFORMW 「엄청난 점성이군……」
	ELSE
		IF TALENT:恋慕
			PRINTFORMW 「아, 왜 젖어 있는 거야……」
			PRINTFORMW 「아마, 기분 좋아서... 아니야? 뭐라고 말하게 만드는 거야 너는」
		ELSE
			PRINTFORMW 「애액이라고? 점막을 보호하려다 체액이 분비되는 것뿐이야……」
			PRINTFORMW 「단순한 생리 현상일 뿐이다. 귀신이나 목이라도 잡은 듯이 승리에 도취되지 마라」
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
IF PALAM:欲情 + UP:欲情 > PALAMLV:3 && FIRSTTIME("欲情V2")
	IF IS_SELECTCOM("媚薬")
		PRINTFORMW 「비겁자……. 여기까지 해서, 나를 몸으로 삼고 싶은 건가……. 아,응…….」
		PRINTFORMDW 케이네의 피부는 홍조를 띠며 식은땀을 흘리고, 유두는 단단하게 솟아있다…….
		PRINTFORMDW 클리토리스도 충혈되어 부풀어 올라 그 존재감을 주장하고 있다…….
		PRINTFORMDW ……효과는 충분한 것 같다.
	ELSE
		PRINTFORMW (안 돼...... 나, 참을 수 없을 것 같아......)
		PRINTFORMW (여기서 끝나버린다고 생각하니 애타......)
		PRINTFORMW (생리 현상이라고는 해도...... 쿠우......)
	ENDIF
ENDIF
;-------------------------------------------------
;初めて恥情がLV2超えた
;-------------------------------------------------
IF PALAM:恥情 + UP:恥情 > PALAMLV:3 && FIRSTTIME("恥情V2")
	IF TALENT:恋慕
		PRINTFORMW 「...... %CALLNAME:MASTER%앞이니까, 더욱 부끄럽다.」
	ELSE
		PRINTFORMW 「...부끄럽네」
	ENDIF
	PRINTFORMW 「보지 말아줘……」
ENDIF
;-------------------------------------------------
;初めて恐怖がLV2超えた
;-------------------------------------------------
IF PALAM:恐怖 + UP:恐怖 > PALAMLV:3 && FIRSTTIME("恐怖V2")
	PRINTFORMW 「나를 어떻게 할 작정이야……」
	PRINTFORMDW 케이네는 창백해져서, 공포로 가득 찬 시선으로 %조사처리(CALLNAME:MASTER,"의")% 상황을 살피고 있다……
	IF TALENT:恋慕
		PRINTFORMW (너무 무서워... 도와줘, %CALLNAME:MASTER%)
	ELSE
		PRINTFORMW (너무 무서워...)
	ENDIF
	PRINTFORMW (아, 나는, 겁먹을 리가!)
ENDIF
