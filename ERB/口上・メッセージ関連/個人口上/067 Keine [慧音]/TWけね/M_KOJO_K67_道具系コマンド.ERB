		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:クリキャップ
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「가지고 놀아지고 있네, 나도……후후」
			PRINTFORMW 「하지만, 너라면 괜찮아」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「크아앙... 으응...」
			PRINTFORMW 「이, 이걸 한 채로라니...」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「용서해줘... 이런 건 제정신이 아니야...」
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMW 「응, 자극이 너무 심해서 살짝 따끔거려……」
			PRINTFORMW 「부드럽게 핥아주고, 보살펴줬으면 좋겠어……」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「후우... 끝인가...」
			PRINTFORMW 「하아... 하아...」
			PRINTFORMDW 느끼고 있었을까? 케이네는 한동안 바닥에 쓰러져 있었다.
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「흑, 끝나는 거구나?」
			PRINTFORMW 「후우, 후우... 드디어 벗겨줬나...」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
