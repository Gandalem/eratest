@M_KOJO_MESSAGE_COM_K67_40
CALL M_KOJO_MESSAGE_COM_K67_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「이, 이건 그게... 모르지 않아. 소위 로터라는 물건일까?」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕인다.
			PRINTFORMW 「물론 나에게 쓰는 거지...?」
			PRINTFORMDW 다시 한번 %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕였다.
			PRINTFORMW 「왠지, 기계는 좀 싫지만... 네가 하고 싶다면 어쩔 수 없겠네...」
			PRINTFORMW 「앙, 후우 떨리고 있어... 아아앗!!」
		ELSEIF MARK:反発刻印
			PRINTFORMW 「크윽...!」
			PRINTFORMW 「그런 것까지 꺼내다니...!」
		ELSE
			PRINTFORMW 「어리석은 도구군... 만든 건 대체 누구지...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「히익, 하, 아아...! 아, 머리까지... 흔들릴 것 같아...!」
				PRINTFORMDW 케이네는 작은 로터의 무거운 진동에 몸부림치며 불규칙한 호흡을 반복하고 있었다.
			CASE 1
				PRINTFORMW 「장난감 떨리고 있어...... 기분 좋아......」
				PRINTFORMDW 둔한 진동에 암컷을 이끌려 나오는 케이네는 소녀 같은 달콤한 목소리를 내고 있다......
			CASE 2
				PRINTFORMW 「이런 도구를 사용하는 건 연인 같은 여유가 있어서 좋다네」
				PRINTFORMW 「나의 몸, 마음대로 가지고 놀아줘......」
			CASE 3
				PRINTFORMW 「응아... 하아앗!」
				PRINTFORMW 「훗... 역시 나는 너에게 해주는 쪽이 더 좋아... 히얀...」
			CASE 4
				PRINTFORMW 「흐으…… 크윽……」
				PRINTFORMW 「앗…… 이런 것보다 네가 더…… 아악」
		ENDSELECT
	ELSEIF MARK:反発刻印
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「그 더러운 손으로 만져지는 것보다는 나을지도 모르겠군」
			CASE 1
				PRINTFORMW 「사용자에게 닮은 빈약한 진동이다」
			CASE 2
				PRINTFORMW 「응아앗... 느껴져... 햐아앗...」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「그만둬애...」
				PRINTFORMW 「이상해지고 있을 것 같아...」
			CASE 1
				PRINTFORMW 「우으, 이건 반칙이야……」
				PRINTFORMW 「나는 싫은데…… 몸이……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
