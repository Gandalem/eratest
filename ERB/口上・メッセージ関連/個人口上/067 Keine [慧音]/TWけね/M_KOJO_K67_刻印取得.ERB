; Modular ERB: 個人口上/067 Keine [慧音]/TWけね/M_KOJO_K67_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K67
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K67
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 1
;custom code, added lines, hate mark lines moved to talk
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 「윽, 헉...」
	PRINTFORMW 「아프잖아...」
ELSEIF TFLAG:22 == 2
	PRINTFORMW 「꺅, 히끅…」
	PRINTFORMW 「그만, 제발 그만해줘…」
ELSEIF TFLAG:22 == 3
	PRINTFORMW 「기분 좋게 해주고 싶은 건지, 아픈 경험을 시키고 싶은 건지, 분명히 말해줘……」
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「이, 이건 도대체 뭐야...?」
	PRINTFORMW 「안, 안 돼, 내가 이상해져 버려... 아아...」
ELSEIF TFLAG:23 == 2
	PRINTFORMW 「하아아앙! 코, 이것은...」
	PRINTFORMW 「정말 기분 좋아...」
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「아, 아아... 지식이, 역사가 사라져 버릴 것 같아...」
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW (...%조사처리(CALLNAME:MASTER,"는")% 나를 어떻게 생각하는 걸까?)
	PRINTFORMW (...모르겠어. 나는 선생님인데...)
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「후우... 너와 이렇게 되다니...」
	PRINTFORMW 「...하지만 나쁘지 않군」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 「설마, 너와 여기까지 관계가 되다니...」
	PRINTFORMW 「...책임은 지게 될 거니까.」
	PRINTFORMW 「그럼... 많이 사랑해 줄 테니까.」
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW (...나는 %조사처리(CALLNAME:MASTER,"의")% 일이...)
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「…설마 너랑 이렇게 될 줄은 몰랐어.」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「...너와 이렇게 된다니 말이야」
	PRINTFORMW 「그렇구나...... 이제, 도망칠 수 없다는 거지......」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	IF TALENT:恋慕
		PRINTFORMW 「이봐, 무슨 일이야? 뭔가 나쁜 걸 먹은 거니?」
	ELSE
		PRINTFORMW 「뭘 하는 거야!」
		PRINTFORMW 「남의 마음과 몸을 가지고 노는 게 뭐가 재미있다는 거야...!!」
	ENDIF
ELSEIF TFLAG:21 == 2
	IF TALENT:恋慕
		PRINTFORMW 「어째서 이런 일을... ? 저기, 이건 뭔가 착각일 거야?」
	ELSE
		PRINTFORMW 「...어째서 이런 걸?」
		PRINTFORMW 「......무슨 일을 당하든 용서할 줄 알았다면 큰 오산이다」
	ENDIF
ELSEIF TFLAG:21 == 3
	IF TALENT:恋慕
		PRINTFORMW 「...나는 아무래도 너를 오해하고 있었던 모양이야」
		PRINTFORMW 「이제 와서 너에게 무언가를 하려는 생각은 없어. ...하지만」
		PRINTFORMW 「실망시켰다, %CALLNAME:MASTER%!!」
	ELSE
		PRINTFORMW 「... 설마 네가 그런 녀석일 줄이야」
		PRINTFORMW 「기억해 둬. 난 언젠가 네 역사를 먹어치워 주겠어!!」
	ENDIF
ENDIF
