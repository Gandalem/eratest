;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K67
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K67
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 1
;custom code, added lines, hate mark lines moved to talk
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 「あぐっ、がっ…」
	PRINTFORMW 「痛いよ………」
ELSEIF TFLAG:22 == 2
	PRINTFORMW 「ぎゃっ、ひぎっ…」
	PRINTFORMW 「もっ、もうやめて…」
ELSEIF TFLAG:22 == 3
	PRINTFORMW 「気持ち良くさせたいのか、痛い思いをさせたいのか、はっきりしてくれ……」
ENDIF

;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF

;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「こっ、これはなっ何だ…？」
	PRINTFORMW 「だっ、駄目だ、私がおかしく…あぁん…」
ELSEIF TFLAG:23 == 2
	PRINTFORMW 「はぁぁあぁん！　こっ、これは…」
	PRINTFORMW 「きっ気持ち良いよ……」
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「あ、あぁ……知識が、歴史が消えてしまいそうだ……」
ENDIF

;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW （…%CALLNAME:MASTER%は私をどう思っているのだ？）
	PRINTFORMW （…分からない。私は教師なのに…）」
;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「ふう…お前とこうなるとは…」
	PRINTFORMW 「…だが悪くないな」
;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 「まさか、お前とここまでの関係になってしまうとはな…」
	PRINTFORMW 「…責任は取ってもらうからな」
	PRINTFORMW 「そのっ…たくさん愛して貰うぞ」
;屈服、恭順による刻印
;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW （…私は%CALLNAME:MASTER%の事が…）」
;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「…まさかお前とこうなるとはな」
;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「…お前とこうなるとはな」
	PRINTFORMW 「そうか……もう、逃げられないのだな……」
ENDIF

;反発刻印
IF TFLAG:21 == 1
	IF TALENT:恋慕
		PRINTFORMW 「おい、どうしたんだ？　何か悪い物でも食べてしまったのか？」
	ELSE
		PRINTFORMW 「何をするんだ！」
		PRINTFORMW 「人の心と体を弄んで何が楽しい……！！」
	ENDIF
ELSEIF TFLAG:21 == 2
	IF TALENT:恋慕
		PRINTFORMW 「どうしてこんな事を……？　なあ、これは何かの間違いだろう？」
	ELSE
		PRINTFORMW 「…どうしてこんな事を？」
		PRINTFORMW 「……何をされても許すと思っていたら大間違いだぞ」
	ENDIF
ELSEIF TFLAG:21 == 3
	IF TALENT:恋慕
		PRINTFORMW 「…私はどうやらお前を誤解していたようだよ」
		PRINTFORMW 「今更お前に何かをしようとは思わない。…が」
		PRINTFORMW 「見損なったぞ、%CALLNAME:MASTER%！！」
	ELSE
		PRINTFORMW 「…まさかお前がそんな奴だったとはな」
		PRINTFORMW 「覚えておけ。私はいつかお前の歴史を食べてやる！！」
	ENDIF
ENDIF
