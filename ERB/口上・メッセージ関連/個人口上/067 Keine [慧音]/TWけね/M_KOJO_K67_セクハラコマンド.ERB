@M_KOJO_MESSAGE_COM_K67_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF FIRSTTIME("胸愛撫")
			PRINTFORMW 「음, 가슴을 만지는 건가?」
			PRINTFORMW 「알았어. 최대한 부드럽게 해줘...」
			PRINTFORMW 「응... 아프게 하지 마...」
		ELSE
			SELECTCASE IFRAND("0TO2", 1, "3TO5", TALENT:恋慕, "6TO12", TALENT:恋人)
				CASE 0
					PRINTFORML 「...응으윽...얀.... 하...히으윽...」
					PRINTFORMDW 옷 위로 유두를 손가락으로 건드려, 달콤하고 애틋한 소리를 내고 있다.
				CASE 1
					IF TALENT:恋人
						PRINTFORML 「...후후, 나의 가슴은 어떤 상태일까...?」
						PRINTFORMDW 케이네의 가슴에 손바닥을 올리고, 손가락이 파고드는 감촉을 즐겼다.
					ELSE
						PRINTFORML 「...후후, 나의 가슴은 어떤 상태일까...?」
						PRINTFORMDW 케이네의 가슴에 손바닥을 올리고, 각각의 손가락이 파고드는 감촉을 즐겼다.
					ENDIF
				CASE 2
					PRINTFORML 「응, 아... 크으응...」
					PRINTFORMDW 케이네의 머리에서 나는 향기를 맡으며 동그란 가슴을 쓸어내렸다.
				CASE 3
					PRINTFORML 「...응으윽...얀.... 하...히으윽...」
					PRINTFORMDW 옷 위로 유두를 손가락으로 건드려, 달콤하고 애틋한 소리를 내고 있다.
				CASE 4
					IF TALENT:恋人
						PRINTFORML 「흐으, 응! 아, 안 돼애애…」
						PRINTFORMDW 케이네의 옷깃을 들여다보니 옷 위로 만져진 유두가 움찔거리며 변형되는 모습이 보였다.
					ELSE
						PRINTFORML 「흐아, 응! 아, 안 돼애애엣…」
						PRINTFORMDW 케이네의 옷깃을 들여다보니 옷 위로 유두를 만지고, 꼭 모양을 바꾸는 모습이 보였다.
					ENDIF
				CASE 5
					IF TALENT:恋人
						PRINTFORMDL 자신의 가슴을 들어 탱탱하게 흔들면서 케이네는 귓가에 입을 대고 중얼거렸다.
						PRINTFORMW 「자유롭게 해도 괜찮아... 네가 좋아하는 형태로 만들어줘...」
					ELSE
						PRINTFORMDL 뒤에서 들어 올리듯 가슴을 흔들리며, 케이네는 귓가에 입을 가까이 대고 중얼거렸다.
						PRINTFORMW 「더 자유롭게 해도 괜찮다고... 네가 좋아하는 형태로 바꿔줘...」
					ENDIF
				CASE 6
					PRINTFORML 「아... 하으... 응. 부디... 직접 만져줘...」
					PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 양손을 가슴에 붙이고, 올려다보며 가만히 바라보고 있다.
				CASE 7
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 양손으로 케이네의 가슴을 움켜쥐고, 옷 위로 유두를 비틀어 올렸다.
					PRINTFORMW 「힉, 야앗, 아우, 아아앙!!」
				CASE 8
					PRINTFORML 「응... 후우, ... 으음, ... 응... 물지 마...」
					PRINTFORMDW 케이네는 가슴에 얼굴을 묻은 %조사처리(CALLNAME:MASTER,"의")% 머리에 손을 감고, 안기듯이 밀착하고 있다.
				CASE 9
					PRINTFORML 「쿠...응, 으윽... 아니이야아앙...」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 타액으로 케이네의 유두 부분이 천에 축축하게 젖어있다...
				CASE 10
					PRINTFORML 「...아, 역시 여기서는 안 돼!」
					PRINTFORMDW 직접 만져달라고 애원하는 바람에 마지못해 가슴을 드러냈지만, %조사처리(CALLNAME:MASTER,"가")% 손을 뻗자마자 양팔로 가려버렸다.
				CASE 11
					PRINTFORML 「그! 그런 건 하고 있지 않아! 할 리가 없잖아!!」
					PRINTFORMDW 케이네가 가끔 자신의 유두를 만지고 있는 것을 지적하자 얼굴을 새빨갛게 물고 반론했다.
				CASE 12
					PRINTFORMDL 드러낸 케이네의 가슴을 관찰하고 있자, 만지지도 않았는데 끝부분이 서서히 솟아올랐다.
					PRINTFORMW 「응... 언제까지... 보고 있는 거야.........앗!」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
