@M_KOJO_SUCCESS_COM_K67_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K67_312
CALL M_KOJO_MESSAGE_COM_K67_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF MARK:反発刻印 && RAND:3
			PRINTFORMW 「키스하는 건 그만둬줘... 음」
			PRINTFORMDW 침이 흘러넘칠 정도, 입안을 범해버렸다....
		ELSEIF TFLAG:193 == 1 || CFLAG:うふふ == 2 || SELECTCOM == PREVCOM ;proper kiss
			IF FIRSTTIME("キスする_1")
				PRINTFORMW 「……응…」
				PRINTFORMDW 케이네는 눈을 감고 입술을 꾹 다물었다.
			ELSE
				IF TALENT:恋人
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「후... 응, 음... 퍄...」
							PRINTFORMDW 케이네의 눈동자는 촉촉해지고 몽롱한 표정으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있었다...
						CASE 1
							PRINTFORML 「느껴진다... 두근두근하고 있어... 응...」
							PRINTFORMDW 케이네의 손이 %조사처리(CALLNAME:MASTER,"의")% 가슴에 놓여 애틋하게 쓰다듬고 있다.
						CASE 2
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 떨어지려고 해도, 케이네의 얼굴이 뒤쫓아오듯 입술에 달라붙어 온다….
							PRINTFORMW 「더… 세게 해줘…」
					ENDSELECT
				ELSEIF TALENT:恋慕
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「...한 번만 더... 해줘」
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 뺨에 닿자, 케이네는 살며시 눈을 감았다.
						CASE 1
							PRINTFORML 「……후……응………음음……」
							PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 목에 손을 감고, 그 입술에 자신의 입술을 눌렀다.
						CASE 2
							PRINTFORMDL 케이네의 뺨을 따라 손을 움직이며 입술에 가져다 대는 듯한 키스를 했다.
							PRINTFORMW 「후……응, 벌써 끝인가…?」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「……음………후우…」
							PRINTFORMDW 두 사람의 입술이 떨어지고 나서, 불현듯 불어와진 케이네의 숨결에 간지러움을 느끼는 듯한 착각을 느꼈다.
						CASE 1
							PRINTFORML 「응... 응...... 음음......」
							PRINTFORMDW 케이네는 꼭 눈을 감고, 떨면서 %조사처리(CALLNAME:MASTER,"의")% 양팔을 힘껏 붙잡고 있다.
						CASE 2
							PRINTFORML 「훗! 후우우읏! 음응!」
							PRINTFORMDW 케이네에게 입맞춤을 한 채 목덜미를 손가락으로 쓸어내리며, 쓰러낼 때마다 민감하게 반응하는 모습을 즐겼다.
					ENDSELECT
				ENDIF
			ENDIF
		ELSE
			IF FIRSTTIME("キスする_2")
				PRINTFORML 「음……。」
				PRINTFORMDW 케이네의 감긴 눈꺼풀이 파르르 떨리고 있다….
			ELSE
				IF TALENT:恋人
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「음……쪽, 후우…」
							PRINTFORMDW 서로의 손가락을 얽으며 입술이 살짝 맞닿는 감촉을 즐겼다….
						CASE 1
							PRINTFORML 「음... 츄... 응... 키스...」
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 케이네와 단단히 껴안고, 각도를 바꾸며 서로의 입술을 탐했다.
						CASE 2
							PRINTFORML 「츄, 르로, 르로... 츄우...」
							PRINTFORMDW 케이네는 혀끝을 사용해 %조사처리(CALLNAME:MASTER,"의")% 입가(입술 끝)를 간지럽히듯 핥고 있다.
					ENDSELECT
				ELSEIF TALENT:恋慕
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「더? ...응, 좋아...」
							PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 뺨에 닿자, 케이네는 살짝 눈을 감았다.
						CASE 1
							PRINTFORML 「...응, 흣... 츄, 응......」
							PRINTFORMDW 케이네는 키스하면서 %조사처리(CALLNAME:MASTER,"의")% 머리를 부드럽게 쓰다듬었다...
						CASE 2
							PRINTFORML 「나에게서인가... 알겠다, 눈을 감아줘...」
							PRINTFORMDW 케이네는 부끄러워하면서 조심스럽게 입술을 포개왔다.
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「............우윽!」
							PRINTFORMDW 아직 키스에 익숙하지 않은지, 케이네는 꼭 눈을 감고 있다...
						CASE 1
							PRINTFORML 「……음으으…………흐윽!…」
							PRINTFORMDW 입맞춤을 하면서 살짝 어깨에 손이 닿자, 케이네는 움찔 온몸을 떨었다.
						CASE 2
							PRINTFORML 「……응, 응, 음…!」
							PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 뺨을 꽉 잡고 어색하게 입술을 눌러왔다…
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
