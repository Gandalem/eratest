@M_KOJO_EXTRASOURCE_COM_K67_350
IF TCVAR:抱き寄せ初回 == 8
	SOURCE:反感 = 0
ELSEIF GROUPMATCH(TCVAR:抱き寄せ初回, 6, 7) || TFLAG:194 == 4
	TIMES SOURCE:反感, 0.30
ENDIF

@M_KOJO_MESSAGE_COM_K67_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止 == 1
		;野外失敗
	ELSEIF TFLAG:194 == 2
		PRINTFORMW 「안 된다고 말하고 있잖아... 아, 그러니까 그런 곳에 만지지 마!!」
		;人目失敗 乱交失敗
	ELSEIF GROUPMATCH(TFLAG:194, 1, 3)
		PRINTFORMW 「하, 하잖아!! 정말이지... 악질적인 농담은 그만둬.」
		;ムード失敗
	ELSEIF TFLAG:194 == 4
		PRINTFORMW 「윽! 거칠게 하지 마! 아프잖아」
	ELSEIF GROUPMATCH(TCVAR:抱き寄せ初回, 6, 7)
		PRINTFORMW 「성교라는 것은, 사랑하는 사람들끼리 하는 것이다」
		PRINTFORMW 「서로 사랑하기에 서로에게 쾌락을 주기도 한다는 측면이 있을지도 모른다」
		PRINTFORMW 「하지만 거부하는 상대에게 그것을 강요하는 것은 폭력과 같거나 그 이상으로 잔혹한 행위이다」
		PRINTFORMW 「야, 듣고 있나?」
	ELSEIF TCVAR:抱き寄せ初回 == 8
		PRINTFORMW 「성교는 자손을 얻기 위한 신성한 행위다. 성기는 그를 위한 소중한 부위다」
		PRINTFORMW 「나쁜 말은 하지 않겠다, 당장 그만둬라. 이건 최악이다」
	ELSE
		IF GET_TARGETNUM() > 1 && CFLAG:[[妹紅]]:現在位置 == CFLAG:現在位置
			RESETCOLOR
			CALL SET_KOJO_COLOR([[妹紅]])
			LOCAL:9 = GETCOLOR()
			RESETCOLOR
			CALL SET_KOJO_COLOR(TARGET)
			IF TALENT:恋慕
				PRINTFORMW 「야, 이번엔 계속 가슴 만지는 거 그만해 주지 그래. 꽤 부끄럽다고.」
				CALL COLORMESSAGE(@"『시끄럽네. 눈앞에서 부르렁 부르렁 흔들리니까 자꾸 잡고 싶어져 버려.』",LOCAL:9,1,0)
				PRINTFORMW 「너희들이 격렬하니까 말이야……」
			ELSE
				PRINTFORMW 「모코우라도 놓아주어 줄 수 없을까……」
				CALL COLORMESSAGE(@"『なに言ってるの？　私は自分の意思でここにいるんだから、良いのよ』",LOCAL:9,1,0)
				PRINTFORMW 「눈을 떠라, 모코우……」
				CALL COLORMESSAGE(@"『됐으니까, 오늘도 기분 좋게 하자. 응?』",LOCAL:9,2,0)
			ENDIF
		ELSEIF GET_TARGETNUM() > 1 && CFLAG:[[永琳]]:現在位置 == CFLAG:現在位置
			RESETCOLOR
			CALL SET_KOJO_COLOR([[永琳]])
			LOCAL:9 = GETCOLOR()
			RESETCOLOR
			CALL SET_KOJO_COLOR(TARGET)
			PRINTFORMW 「네 가슴은 뜨겁고 숨 막히며, 무겁고 방해될 게 하나도 없는데……」
			CALL COLORMESSAGE(@"『똑같이 돌려주겠어』",LOCAL:9,1,0)
			PRINTFORMW 「그래, 내 것이 큰 것만으로 충분하다. 작은 걸 데려오면 되는 거야」
			CALL COLORMESSAGE(@"『그런 취미야? 모코우나 히메라면 괜찮지 않아?』",LOCAL:9,1,0)
			PRINTFORMW 「……그런 문제인 것 같지는 않은데.」
			CALL COLORMESSAGE(@"『시간 벌기는 이제 됐어. 오늘도 땀 범벅이 되자, 음후후후~』",LOCAL:9,2,0)
		ELSE
			IF GETPERCENT(BASE:体力, MAXBASE:体力) < 50
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「나랑 하고 싶다는 건 알겠지만, 조금 기분이 안 좋아서 말이야……」
						PRINTFORMW 「너무 무리할 수는 없어…… 부드럽게 해줄래?」
					CASE 1
						PRINTFORMW 「조금 몸 상태가 좋지 않아... 평소처럼 못 할지도 몰라.」
						PRINTFORMW 「하지만 최선을 다할 테니까. 미안해.」
				ENDSELECT
			ELSEIF BATHCHECK(CFLAG:MASTER:現在位置)
				IF TALENT:恋慕
					PRINTFORMW 「목욕탕에서... 뭐, 마치 연인들 같네」
					PRINTFORMW 「상쾌하게, 깨끗하게, 기분 좋게 해줄 테다!」
					PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"가")% 놀랄 정도의 기세로 옷을 벗어던지고 목욕탕으로 향했다…….
				ELSE
					PRINTFORMW 「음, 목욕에서 할 거라고?」
					PRINTFORMW 「더러움도 금방 씻어낼 수 있고, 이치에 맞으니까 좋네.」
					PRINTFORMW 「가끔은 좋은 말을 하는구나.」
				ENDIF
			ELSE
				PRINTFORMW 「그게... 할 거야?」
				PRINTFORMW 「알겠어」
				PRINTFORMDW 그렇게 말하며, 케이네는 옷을 벗기 시작했다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
