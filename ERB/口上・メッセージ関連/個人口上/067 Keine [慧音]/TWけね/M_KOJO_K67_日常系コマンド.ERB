;332,お酒をふるまう
;TFLAG:193(0=下戸飲み成功 -1=下戸飲み失敗 -2=下戸飲み大失敗 -5=下戸飲みあきらめ)
;TFLAG:194(51=どぶろく 52=清酒 53=鬼殺し)
;ALCOHOL_TASTE(TFLAG:194)(15以上=気に入る 9以下=口に合わない)
;==================================================
@M_KOJO_SUCCESS_COM_K67_332
;成否判定
;TFLAG:192(-1＝強制失敗、0=COM依存
;TFLAG:口上特殊補正 (ここに数値を入れるとALCOHOL_TASTEを増減させられる)
TFLAG:192 =0
TFLAG:口上特殊補正 = 0

@M_KOJO_MESSAGE_COM_K67_332
CALL M_KOJO_MESSAGE_COM_K67_332_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;恋慕
	;「月のイナバと地上の因幡」のネタなのですが、個人的にツボだったので、入れてみました。
	;色々な意味で申し訳ございませんorz
	IF GETPERCENT(BASE:酒気, MAXBASE:酒気) >= 50 ;check tipsiness, if keine's getting drunk
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「ふぅ、少し酔ってきたな………」
				PRINTFORMW 「この辺りで酒は切り上げなければならないだろうな」
			CASE 1
				PRINTFORML 「ふりゅふ、どうした？何を唖然としていりゅ？」
				PRINTFORMDW 慧音はすっかり出来上がってしまっている。というか慧音さん、
				PRINTFORMDW ついさっき、『この辺りで酒は切り上げなければならない』とか言ってませんでしたか？
				PRINTFORMW 「ふみゅ、時に貴方はきょんな言葉を知ってりゅか？」
				PRINTFORMDW ？
				PRINTFORMW 「言うは易し、行うは難し！！」
				PRINTFORMDW この人駄目だ！！
			CASE 2
				PRINTFORML 「ほら！何を遠慮していりゅ！もっと呑め！！ふにゅうぅぅ！」
				PRINTFORMDW すっかり出来上がってしまったようだ。酔いを醒まさせるために、慧音を風の当たる所へ連れて行った。
		ENDSELECT
	ELSEIF GETPERCENT(BASE:MASTER:酒気, MAXBASE:MASTER:酒気) >= 50 ;if you're getting drunk
		PRINTFORML 「おっと」
		PRINTFORMDL %CALLNAME:MASTER%の胸に倒れこんできた慧音を抱きとめた。
		PRINTFORMW 「いかんな、酔いが回ってしまったようだ…」
	ELSE
		PRINTDATAW
			DATAFORM 「お前の潰れた所を見たことが無いんだが…」
			DATAFORM 「まだ呑むのか…。程ほどにしておけ、お前を担いで帰りたくは無いからな。」
		ENDDATA
	ENDIF
ENDIF
RETURN 1
