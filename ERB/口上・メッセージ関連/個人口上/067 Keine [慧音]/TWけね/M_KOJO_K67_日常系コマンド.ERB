;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K67_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K67_302
CALL M_KOJO_MESSAGE_COM_K67_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K67_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 < 0
		PRINTFORMW 「꺅! 이, 이봐! 갑자기 뭘 하는 거야!」
	ELSE
		IF MARK:反発刻印
			PRINTFORMW 「누가 만져도 된다고 했어. 주제넘지 마.」
			PRINTFORMDW 케이네는 %조사처리(CALLNAME:MASTER,"의")% 팔을 붙잡고 노려본다.
		ELSEIF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「앗, 그만둬, 멈추... 아우」
					PRINTFORMDW 케이네는 엉덩이를 움켜쥐어지고 마음대로 주물러지면서 달콤한 소리를 내고 있다...
				CASE 1
					PRINTFORMDL 케이네를 무릎에 앉히고 손을 잡은 채, 서로의 목덜미와 입가를 빨아들였다.
					PRINTFORMW 「츄, 츄, 쭉우, 핥, 핥……응…」
				CASE 2
					PRINTFORMDL 케이네는 %조사처리(CALLNAME:MASTER,"의")% 뺨이나 목덜미를 쓰던 손을 갑자기 옷깃 사이로 집어넣었다.
					PRINTFORMW 「아하핫, 네 유두가 딱딱해지고 있어…」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아아, 이리 와... 귀를 깨물지 마... 크으윽...」
					PRINTFORMW 「청소했으니까 깨끗해? 이... 쓸데없는 참견이야!!」
				CASE 1
					PRINTFORML 「응, …아, 하안……싫어…」
					PRINTFORMDW 한 손으로 누르듯이 케이네의 양쪽 손목을 고정시키고, 옷 위로 허벅지를 부드럽게 쓰다듬어 주었다.
				CASE 2
					PRINTFORML 「자, 내가 옆에 있는데, 너는 뭘 하고 있는 거니?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 안긴 케이네는 부드러운 뺨을 비볐다...
			ENDSELECT
		ELSEIF EXP:キス経験
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음……후으윽, 응, 음ㅁ…」
					PRINTFORMDW 케이네의 겨드랑이에 손바닥을 대고 입술을 빨면서 파르르 떨리는 감촉을 즐겼다….
				CASE 1
					PRINTFORML 「...싫어, 핥지 마...」
					PRINTFORMDW 케이네는 볼을 핥히면서, 얼굴을 감싼 %CALLNAME:MASTER%양팔을 밀쳐내려고 하고 있다.
				CASE 2
					PRINTFORML 「응, 크으응, 간지러워... 우웅, 벌써...!」
					PRINTFORMDW 케이네의 손바닥을 손가락으로 간지럽히자 강아지 같은 소리를 냈다.
			ENDSELECT
		ELSEIF EXP:デート経験
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...후후, 간지러워」
					PRINTFORMDW 케이네는 손등을 쓰다듬는 %조사처리(CALLNAME:MASTER,"의")% 손을 가만히 바라보고 있었다...
				CASE 1
					PRINTFORML 「뭐야, 관심 받고 싶어... 이쪽으로!」
					PRINTFORMDW 허리에서 엉덩이로 이동한 %조사처리(CALLNAME:MASTER,"의")% 손을 황급히 떼어내려 하고 있다.
				CASE 2
					PRINTFORML 「히야앗!!…뭐야, 네가 이상한 곳을 만지니까…」
					PRINTFORMDW 귀 뒤쪽을 손가락으로 쓰다듬어 사랑스러운 목소리를 낸 케이네는, 못마땅한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 응시하고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 검지를 세운 채 어깨를 두드리자 돌아본 케이네의 뺨에 푹, 하고 박혔다.
					PRINTFORMW 「뭐야?...라니, 언제까지 어린애 같은 짓을 하는 거야!」
				CASE 1
					PRINTFORML 「...농담이야. 잠깐, 기다려! 미안해, 더는 말하지 않을게... 아하하하하하하!」
					PRINTFORMDW 좀처럼 하지 않는 농담을 크게 실수한 케이네의 겨드랑이를 잠시 간지럽혀 주었다.
				CASE 2
					PRINTFORML 「음... 잘한다. 잠들 것 같아...」
					PRINTFORMDW 어깨를 주물러주자 케이네는 눈을 감고 행복해했다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
