@M_KOJO_EXTRASOURCE_COM_K67_350
IF TCVAR:抱き寄せ初回 == 8
	SOURCE:反感 = 0
ELSEIF GROUPMATCH(TCVAR:抱き寄せ初回, 6, 7) || TFLAG:194 == 4
	TIMES SOURCE:反感, 0.30
ENDIF

@M_KOJO_MESSAGE_COM_K67_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止 == 1
	;野外失敗
	ELSEIF TFLAG:194 == 2
		PRINTFORMW 「ダメだと言っているだろう…ああ、だからそんな所で触るな！！」
	;人目失敗 乱交失敗
	ELSEIF GROUPMATCH(TFLAG:194, 1, 3)
		PRINTFORMW 「ふ、ふざけるなっ！！　全く…悪質な冗談はやめておけ」
	;ムード失敗
	ELSEIF TFLAG:194 == 4
		PRINTFORMW 「っ！乱暴にするな！痛いじゃないか」
	ELSEIF GROUPMATCH(TCVAR:抱き寄せ初回, 6, 7)
		PRINTFORMW 「性交というのは、愛する者同士が行うものだ」
		PRINTFORMW 「愛し合うからこそ、互いに快楽を与え合うという側面は持っているかもしれない」
		PRINTFORMW 「だが、嫌がる相手にそれを強要するのは、暴力と同じか、それ以上に酷い行為なんだ」
		PRINTFORMW 「おい、聞いているのか？」
	ELSEIF TCVAR:抱き寄せ初回 == 8
		PRINTFORMW 「性交は子宝を授かるための神聖な行為だ。性器はその為の大切な部位だ」
		PRINTFORMW 「悪いことは言わない、すぐにでもやめろ。これは最低なことだぞ」
	ELSE
		IF GET_TARGETNUM() > 1 && CFLAG:[[妹紅]]:現在位置 == CFLAG:現在位置
			RESETCOLOR
			CALL SET_KOJO_COLOR([[妹紅]])
			LOCAL:9 = GETCOLOR()
			RESETCOLOR
			CALL SET_KOJO_COLOR(TARGET)
			IF TALENT:恋慕
				PRINTFORMW 「おい、今回はいちいち胸を揉むのはやめてくれないか。結構恥ずかしいんだぞ」
				CALL COLORMESSAGE(@"『うるさいなあ。目の前でぶるんぶるん揺れるからつい掴みたくなるのよ』",LOCAL:9,1,0)
				PRINTFORMW 「お前達が激しいからだよ……」
			ELSE
				PRINTFORMW 「妹紅だけでも逃がしてやってくれないか……」
				CALL COLORMESSAGE(@"『なに言ってるの？　私は自分の意思でここにいるんだから、良いのよ』",LOCAL:9,1,0)
				PRINTFORMW 「目を覚ませ、妹紅……」
				CALL COLORMESSAGE(@"『いーから、今日も気持ちよくなろ。ね？』",LOCAL:9,2,0)
			ENDIF
		ELSEIF GET_TARGETNUM() > 1 && CFLAG:[[永琳]]:現在位置 == CFLAG:現在位置
			RESETCOLOR
			CALL SET_KOJO_COLOR([[永琳]])
			LOCAL:9 = GETCOLOR()
			RESETCOLOR
			CALL SET_KOJO_COLOR(TARGET)
			PRINTFORMW 「お前の胸は暑っ苦しいし、重いし、邪魔なことこの上ないのだが……」
			CALL COLORMESSAGE(@"『そっくりそのまま返すわ』",LOCAL:9,1,0)
			PRINTFORMW 「そうだ、私のが大きいだけで十分だ。小さいやつを連れてくれば良いんだ」
			CALL COLORMESSAGE(@"『そういう趣味なの？　妹紅や姫なら良いんじゃない？』",LOCAL:9,1,0)
			PRINTFORMW 「……そういう問題でもない気がするな」
			CALL COLORMESSAGE(@"『時間稼ぎはもう良いのよ。今日も汗だくになりましょ、んふふふ～』",LOCAL:9,2,0)
		ELSE
			IF GETPERCENT(BASE:体力, MAXBASE:体力) < 50
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「私とヤリたいのは分かるが、少し気分が悪くてな……」
						PRINTFORMW 「あんまり無茶はできないんだ……優しく、して？」
					CASE 1
						PRINTFORMW 「少しばかり本調子じゃないんだ……いつもみたいには出来ないかもしれない」
						PRINTFORMW 「でも精一杯やるから。ごめんね」
				ENDSELECT
			ELSEIF BATHCHECK(CFLAG:MASTER:現在位置)
				IF TALENT:恋慕
					PRINTFORMW 「風呂場で……ま、まるで恋人同士のようだな」
					PRINTFORMW 「すっきり、綺麗に、気持ちよくしてやるぞっ！」
					PRINTFORMDW 慧音は%CALLNAME:MASTER%が驚くほどの勢いで服を脱ぎ捨て、風呂場に向かっていった……。
				ELSE
					PRINTFORMW 「ん、風呂でするって？」
					PRINTFORMW 「汚れもすぐ洗い流せるし、理に適っているな」
					PRINTFORMW 「たまには良いことを言うじゃないか」
				ENDIF
			ELSE
				PRINTFORMW 「その……するのか？」
				PRINTFORMW 「分かったよ」
				PRINTFORMDW そう言って、慧音は服を脱ぎ始めた。
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
