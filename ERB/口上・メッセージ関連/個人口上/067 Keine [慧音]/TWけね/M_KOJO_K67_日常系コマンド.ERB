;==================================================
;63,もっとキスする
;前ターンキスする後キスする
;分岐条件はEVENT_MESSAGE_COM500.ERB参照
;==================================================
@M_KOJO_SUCCESS_SCOM_K67_63
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_SCOM_K67_63
CALL M_KOJO_MESSAGE_SCOM_K67_63_1
RETURN RESULT
@M_KOJO_MESSAGE_SCOM_K67_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSE
		IF FIRSTTIME("もっとキスする")
			PRINTFORML 「ふむっ！！むうう！！！」
			PRINTFORMDW 突然舌を差し込まれた慧音は目を見開いて硬直している。
		ELSE
			SELECTCASE IFRAND("0TO2", 1, "3TO4", TALENT:恋慕, "5TO11", TALENT:恋人)
				CASE 0
					PRINTFORML 「んっ…ふぅっ、…くぅん、…ふぅぅ…」
					PRINTFORMDW 慧音はキスしながら%CALLNAME:MASTER%の髪をくしゃくしゃと掻き回している。
				CASE 1
					PRINTFORML 「ちゅぅぅ…ちゅ…ん、んんぅ…」
					PRINTFORMDW 口からあふれ出た涎が慧音の顎をつたい、つぅっと垂れ落ちた。
				CASE 2
					PRINTFORML 「ん、ふっ、ちゅ……ちゅ…ふぅん…」
					PRINTFORMDW 慧音の髪を梳くように撫でながら、唾液でぬめる唇を存分に味わった。
				;love
				CASE 3
					PRINTFORMDL %CALLNAME:MASTER%は慧音の唇の柔らかさに我を忘れてむしゃぶりついた。
					PRINTFORMW 「んむっ！？ぬむぅっ！…ぷはぁ！…強すぎるぞ…」
				CASE 4
					PRINTFORMDL 鎖骨まで垂れていた涎を舌で舐め取ると「ひゃんっ！」と可愛らしい声を上げて%CALLNAME:MASTER%の胸を突き飛ばした。
					PRINTFORMW 「はぁ、はぁ…。い、いきなり舐めるな…」
				;lover
				CASE 5
					PRINTFORML 「じゅぷっ、ちゅるるっ…じゅるる、ちゅるちゅる…」
					PRINTFORMDW お互いの唾液を口内に溜め、舌を絡ませながら何度も往復させた…。
				CASE 6
					PRINTFORML 「くちゅ…ちゅる、ちゅぅぅ…ぷぁ。……ふふ。」
					PRINTFORMDW 唇を離した後も慧音は熱っぽい瞳で%CALLNAME:MASTER%を見つめている。
				CASE 7
					PRINTFORMDL %CALLNAME:MASTER%は慧音の唇の柔らかさに我を忘れてむしゃぶりついた。
					PRINTFORMW 「んむっ！？ぬむぅっ！…ぷはぁ！強すぎるぞ…」
				CASE 8
					PRINTFORML 「わ、わかったよ…」
					PRINTFORMDL %CALLNAME:MASTER%は突き出した舌先を慧音に舐めさせた。
					PRINTFORMDW 乗せられた舌の熱に溶かされる様な感覚や、粘っこく絡み合う慧音の唾液、吹きかけられる鼻息を存分に味わえた。
				CASE 9
					PRINTFORML 「んぅっ…ぷふぁっ。…うぁん、ひぅっ…」
					PRINTFORMDW 唇を離すと脱力した慧音がもたれ掛かってきた。無防備な白いうなじを甘噛みされ、弱弱しい声で鳴いている。
				CASE 10
					PRINTFORML 「ぇ…ふ…ぁ、ふぁぁぁぁ……」
					PRINTFORMDW 慧音の下唇を指で軽く引き下げ、その裏側と前歯をなぞるように舐め回した。
				CASE 11
					PRINTFORMDL だらしなく垂れ落ちてきた涎を舌で掬い取り、上を向かせて流し込んだ。
					PRINTFORMW 「ん…む、ぴちゃ、ぷちゅ……ちぅ、ちぅ…」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
