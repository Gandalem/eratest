	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「...」
		PRINTFORML A moment's hesitation later, Sekibanki returns your greeting with a slight, albeit awkward, bow.
		PRINTFORML （Phew. I'm not so good at all those subtle head motions after all.）
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML Sekibanki turns her head to an angle that is clearly impossible for a normal person, just to stare at your back, almost glaringly.
		PRINTFORML In any case, she seems to be offended in some way.
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

