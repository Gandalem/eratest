			PRINTFORML Despite the awkwardness of the situation, she doesn't seem to be that uncomfortable with you.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
