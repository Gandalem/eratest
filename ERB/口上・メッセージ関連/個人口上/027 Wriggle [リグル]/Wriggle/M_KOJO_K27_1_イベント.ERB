		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF DAYEVENT_TARGET != TARGET || !DAYEVENT_SCENARIO
				IF (TALENT:TARGET:愛欲 || TALENT:TARGET:セフレ) && !RAND:3
					CALL K27_WRIGGLE_MORNING_SEX_EVENTS()
				ENDIF
				RETURN 1
			ENDIF
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character woke up first, and they are living with the player
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF DAYEVENT_TARGET != TARGET || !DAYEVENT_SCENARIO
			IF TALENT:[[リグル]]:恋人
				IF !RAND:3
					CALL K27_WRIGGLE_MORNING_SEX_EVENTS()
				ELSE
					PRINTFORMW 「좋은 아침이야, %K27_MASTER()%～」
					PRINTFORMDW %CALLNAME:[[リグル]]%이/가 당신을 보며 볼에 키스한다.
					PRINTFORMW 「움직이지 마, 알겠지? 잠깐만...」
					PRINTFORMDW %CALLNAME:[[リグル]]%이/가 몸을 숙여 당신의 눈을 응시한다.
					CALL HPH_PRINT, @"「막 일어난 모습이 너무 귀여워서, 내가 절대 잊지 않게 해주고 싶어 HPH」", "W"
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
