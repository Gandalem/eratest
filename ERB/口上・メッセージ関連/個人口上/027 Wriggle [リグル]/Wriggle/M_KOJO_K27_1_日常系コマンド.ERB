RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K27_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 1
			IF IN_HEAT([[リグル]])
				PRINTFORMW 「안 돼... 견딜 수가 없어...」
				PRINTFORMDW %CALLNAME:[[リグル]]%는 당신을 바라본다. 절망이 %HIS_HER([[リグル]])%의 눈에 서려 있다.
				PRINTFORMW 「%K27_MASTER()%... 내 온몸이 불타고 있어. 그리고 네가 나를 만질 때마다 상황은 더 나빠져.」
				PRINTFORMW 「나와 교미해 주길 바래. 제발...」
			ELSEIF TALENT:[[リグル]]:恋人
				PRINTFORMW 「음...」
				PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신의 손가락과 맞잡는다.
				PRINTFORMW 「나는 많은 것을 잊어버리지만... 단 하나, 당신과 손을 잡는 것이 얼마나 기분 좋은지 절대 잊지 않을 거야.」
				CALL HPH_PRINT, @"「내가 할 때마다, 나는 당신에게 또다시 사랑에 빠진다고 맹세해 HPH」", "W"
			ELSEIF TALENT:[[リグル]]:セフレ || TALENT:[[リグル]]:愛欲
				PRINTFORML 
			ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
				PRINTFORMW 「에헤헤...」
				PRINTFORMDW (내 뒤쪽이 빛나지 않는군?)
				PRINTFORMDL %CALLNAME:[[リグル]]%은(는) %HIM_HER([[リグル]])%의 뒤를 보려고 충분히 뒤로 기대려 한다-
				PRINTFORMW 「와!」
				PRINTFORMDW %CALLNAME:[[リグル]]%이 비틀거리며 거의 넘어질 뻔한다. 당신이 %HIM_HER([[リグル]])%보다 먼저 %HE_SHE([[リグル]])%를 품에 안는다.
				PRINTFORMW 「아! 고마워, %K27_MASTER()%!」
				PRINTFORMDW (아, 정말... 뒤로 공중제비를 돌았어야 했어. 이제 %K27_MASTER()%가 내가 바보라고 생각할 거야!)
			ELSE
				PRINTFORMW 「에헤헤...」
				PRINTFORMDW (왜 이렇게 흥분하는 걸까? 내 손이 성감대는 아닌데.)
				PRINTFORMDW (...혹시 %K27_MASTER()%의 손일지도? \@ !IS_NONHUMAN(MASTER) ? 인간은 어떻게 작동하는지 잘 모르겠어... # %HIS_HER(MASTER)% 종족은 어떨까... \@)
			ENDIF
		CASE 0
			IF IN_HEAT([[リグル]])
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「안 돼... 여기...」
						PRINTFORMDW %CALLNAME:[[リグル]]%가 당신의 손을 %HIS_HER([[リグル]])%의 가랑이에 올린다.
					CASE 1
						PRINTFORMDW 나를 침실로 데려가는 거야...?
					CASE 2
						PRINTFORML 「하아앙...」
						PRINTFORMDW 공기를 가득 채우는 달콤한 냄새가 점점 더 강해진다.
				ENDSELECT
			ELSEIF TALENT:[[リグル]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「오? 나를 어딘가로 이끌려고 하는 거야?」
						CALL HPH_PRINT, @"「이제는 알아야 할 것이다, 나는 네가 원하는 어디든 갈 수 있다는 것을.」", "W"
					CASE 1
						PRINTFORML 「원하면 내 손을 조금 더 꽉 잡을 수도 있어.」
						PRINTFORMW 「아니면 훨씬 더 세게...」
					CASE 2
						PRINTFORMDW 몇 마리의 호기심 많은 반딧불이들이 당신의 손을 잡고 주변을 맴돈다.
						PRINTFORMW 「%K27_MASTER()%, 봐! 걔들도 그러고 있어!」
						PRINTFORMDW 당신은 더 가까이 들여다본다. 과연, 반딧불이들은 앞발끼리 얽혀 있었다.
						PRINTFORMDW %CALLNAME:[[リグル]]%는 미소를 짓는다.
						PRINTFORML 「그들이 나에게 너와 손잡고 있을 때 내가 얼마나 행복한지 봤고 한번 시도해 보고 싶다고 말했어.」
						CALL HPH_PRINT, @"「에헤헤, 유행을 시작했어」", "W"
				ENDSELECT
			ELSEIF TALENT:[[リグル]]:セフレ || TALENT:[[リグル]]:愛欲
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 
					CASE 1
						PRINTFORML 
					CASE 2
						PRINTFORML 
				ENDSELECT
			ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW (내 손의 감촉을 %HE_SHE(MASTER)%가 좋아해 주었으면 해.)
						PRINTFORMDW (어쩌면 그 침벌레들이 제안한 걸 받아들였어야 했을지도 모르지...)
					CASE 1
						PRINTFORMDW 위글은 천천히 당신의 손가락과 %HIS_HER([[リグル]])%손가락을 엮는다.
						PRINTFORMDW (좋아! %HES_SHES(MASTER)% 떨어지지 않아!)
						PRINTFORMDW (%NAME:[[リグル]]%에게 또 하나의 승리야!)
					CASE 2
						PRINTFORMW 「당신의 손은 정말 따뜻해...」
						PRINTFORMW 「그리고 그저 만지는 것만으로도 온몸이 따뜻해져! 그게 당신의 능력이야?!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신의 손을 쥐었다. 당신도 되쥔다.
						PRINTFORMW 「원한다면 더 세게 쥘 수 있어...」
						PRINTFORMDW 왜 %HE_SHE([[リグル]])%는 그렇게 흥분한 것 같지?
					CASE 1
						PRINTFORML 「와, 당신의 등껍질 정말 부드럽네요...」
						PRINTFORMW 「잠깐만요, 아니에요, \@ !IS_NONHUMAN(MASTER) ? 인간들은 # 여러분은 그것을 가지고 있지 않아요.」 \@
						PRINTFORMDW %CALLNAME:[[リグル]]%는 약간 당황한 표정을 지었다.
					CASE 2
						PRINTFORMW 「뭐야, 내가 길을 잃거나 그런 걸 할 거라고 생각하는 거야?」
						PRINTFORMW 「자, %K27_MASTER()%#! 난 바보지만, 그렇게 바보는 아니라고!」
				ENDSELECT
			ENDIF
		CASE -1
			IF IN_HEAT([[リグル]])
				PRINTFORMW 「흐윽... 놀리지 마!」
			ELSEIF TALENT:[[リグル]]:恋人
				PRINTFORMW 「미안해, %K60_MASTER()%. 하지만 버그가 내 손에 내려앉았어.」
			ELSEIF TALENT:[[リグル]]:セフレ || TALENT:[[リグル]]:愛欲
				PRINTFORML 
			ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
				PRINTFORMDL (오 안 돼... 내 손이 다 땀으로 흥건해...)
				PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 재빨리 당신의 손을 놓았다.
				PRINTFORMDW (젠장 젠장 젠장! 이제 %HES_SHES(MASTER)%가 내가 무례하다고 생각할 거야!)
				PRINTFORMW 「음, 어... 당신 피부가 너무 좋아서 망치고 싶지 않아서 그래, 그래서 손을 놓았어, 그리고...」
			ELSE
				PRINTFORMW 「야, 나 양손 다 자유로워야 해!」
				PRINTFORMW 「만약 악당이 우리를 방해하려고 하면 어떡하지?」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
