;Sleep Together
;354,添い寝する（相手は起きて布団に招く感じ）
;CFLAG:衰弱(1以上=起きない
;CFLAG:お招き(0以外=起きない
;==================================================

@M_KOJO_EN01_MESSAGE_COM_K27_354
CALL M_KOJO_EN01_MESSAGE_COM_K27_354_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K27_354_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF IN_HEAT([[リグル]])
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT, @"「음... 연모해... \@ IS_MALE(MASTER) ? 마스터 # 미스레쓰 \@HPH」", "W"
			CASE 1
				PRINTFORML 「따뜻하고 기분 좋네...」
				PRINTFORMDW 위글이 몸을 뒤척여 당신의 몸에 밀착한다.
			CASE 2
				PRINTFORML 「음?」
				PRINTFORMDW 위글의 안테나가 움찔거린다.
		ENDSELECT
	ELSEIF TALENT:[[リグル]]:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「오, 내 작은 고치에서 함께하고 싶니?」
				PRINTFORMDW 위글은 미소 지으며 이불을 토닥였다.
			CASE 1
				IF DAY:2 == 2
					PRINTFORMW 「정말 괜찮아? 온몸이 끈적하고 땀투성이야...」
				ELSE
					PRINTFORMW 「멋지다! 나를 따뜻하게 해 줄 누군가가 필요했어.」
				ENDIF
			CASE 2
				PRINTFORML 「음... 나는 침대를 같이 쓰는 것에 익숙하지 않아...」
				PRINTFORMW 「그러니까 이불을 독차지해도 화내지 마, 알겠지?」
		ENDSELECT
	ELSEIF TALENT:[[リグル]]:セフレ || TALENT:[[リグル]]:愛欲
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
