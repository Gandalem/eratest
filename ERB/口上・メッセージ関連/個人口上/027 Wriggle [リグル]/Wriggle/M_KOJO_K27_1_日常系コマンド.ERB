					ELSE
						PRINTFORM "아내들 
					ENDIF
				ENDIF
				PRINTFORMW ought to wear matching outfits!"」
				PRINTFORMW 「I tried to tell her we're just dating, not married, but I don't think she understood...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
