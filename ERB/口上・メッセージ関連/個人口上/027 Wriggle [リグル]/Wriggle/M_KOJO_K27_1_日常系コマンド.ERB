LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:[[リグル]]:恋人
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신을 보며 미소 지었다.
				PRINTFORML 「바보 같기는... 속았잖아! 이제 키스할 수 있는 거리에 왔어!」
				PRINTFORMDW %HE_SHE([[リグル]],1)%은(는) 당신의 뺨에 입맞춤을 했다.
				PRINTFORMW 「헤헤... 위대한 %NAME:[[リグル]]%을(를) 속이려 하기엔 아직 100년이나 이르다고!」
			CASE 0
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「헤이, 나 간지럽히는 거 그만둬, 이 자식아!」
						PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 웃으며 너를 다시 간지럽히기 시작한다.
						CALL HPH_PRINT, @"「내 버그 친구들에게 지원 요청하기 전에 지금 항복하는 게 좋을 거다.」", "W"
					CASE 1
						PRINTFORMW 「오, 이런... 온몸이 빛나고 있어...」
						PRINTFORMDW %CALLNAME:[[リグル]]%의 얼굴은 새빨갛다.
					CASE 2
						PRINTFORML 「내 날을 찾고 있는 거야? 난 없거든, 알잖아.」
						PRINTFORMW 「하지만 그렇게 한다면, 어깨 마사지 좀 해줄 수 있어?」
						PRINTFORMDW 당신은 %CALLNAME:[[リグル]]%의 어깨를 마사지하기 시작하고, 그녀는 만족스러운 한숨을 내쉰다.
						CALL HPH_PRINT, @"「아아... 너는 최고의 %PRINT_MALE("boy", MASTER)%친구다 HPH」", "L"
						PRINTFORMW 「다 끝내고 하나 줄까?」
					CASE 3
						PRINTFORMW 「헤헤... 당신의 손은 정말 부드럽군요...」
						PRINTFORMW 「나는 갑각류에 더 익숙한데.」
						PRINTFORMDW 위글이 웃었다.
					CASE 4
						PRINTFORMDW 너는 Wriggle와 스킨십을 하는 동안 반딧불들이 당신 위로 몰려오고 있었다.
						PRINTFORMDW 그녀가 고개를 들고 얼굴을 붉혔다.
						PRINTFORMW 「얘들아, 나 창피하게 하잖아!」
						PRINTFORMDW 당신은 %HIS_HER([[リグル]])%의 시선을 따라갔고, ... 물론이다. 그들은 심장 모양으로 자리를 잡았다.
				ENDSELECT
			CASE -1
				PRINTFORMW 「진심이야? 네가 내 %PRINT_MALE("boy", MASTER)%친구니까 갑자기 나한테 손을 대도 된다는 뜻은 아니잖아...」
		ENDSELECT
	ELSEIF TALENT:[[リグル]]:セフレ || TALENT:[[リグル]]:愛欲
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORML 「하아...」
				PRINTFORMDW %CALLNAME:[[リグル]]%이(가) 한숨을 쉬며 당신에게 몸을 비빈다.
			CASE 0
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「아앗! 간지러워!」
					CASE 1
						PRINTFORML 「아... 기분 좋네...」
						PRINTFORMDW 당신이 %HIS_HER([[リグル]])%의 어깨를 마사지하자 리글은 미소 짓는다.
					CASE 2
						PRINTFORMW (%HE_SHE(MASTER)%가 나에게 손을 대면 왜 속이 이렇게 따뜻해지는 걸까?)
					CASE 3
						PRINTFORML 「헤헤, 네 손가락이 온몸을 기어다니는 게 느껴져.」
						PRINTFORMW 「그것들은 작은 벌레들 같아...」
					CASE 4
						PRINTFORMDW 몇몇 반딧불이들이 당신과 위글 주변에 모여들기 시작한다.
						PRINTFORMDW 그들은 두 사람이 무엇을 하고 있는지 궁금해하는 것 같다.
				ENDSELECT
			CASE -1
				PRINTFORML 「이런 변태처럼 굴지 마...」
				PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신을 못마땅하게 노려본다.
		ENDSELECT
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORMDL %CALLNAME:[[リグル]]% 초조하게 삼킨다.
				PRINTFORMDW 당신은 %HIS_HER([[リグル]])%'의 심장이 더 빠르게 뛰는 것을 느낄 수 있다...
			CASE 0
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「워, 워, 갑자기 나한테 만지기 시작하지 마!」
						PRINTFORMDW %CALLNAME:[[リグル]]%이 너를 밀쳐내지만 %HE_SHE([[リグル]])%는 약간 얼굴을 붉힌다.
					CASE 1
						PRINTFORML 「우와!」
						PRINTFORMDW 당신이 %CALLNAME:[[リグル]]%를 만지자 %HIM_HER([[リグル]])%은(는) 뛰어오지만, %HE_SHE([[リグル]])%는 당신을 밀어내거나 불행해 보이지 않는다.
					CASE 2
						PRINTFORMW 「음, 먼저 나한테 저녁이라도 사주지 그래?」
					CASE 3
						PRINTFORMW 「솔직히 말해서 내 벌레들이 나 위를 기어다니는 게 더 좋아...」
					CASE 4
						PRINTFORMDL 반딧불 무리가 당신에게 급강하 공격을 시작한다.
						PRINTFORMW 「얘들아, 진정해! %HES_SHES(MASTER,1)%는 나를 해치거나 그런 거 없어!」
				ENDSELECT
			CASE -1
				PRINTFORML 「야! 그만둬!」
				PRINTFORMDW %CALLNAME:[[リグル]]%이 너를 밀쳐내며 노려본다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
