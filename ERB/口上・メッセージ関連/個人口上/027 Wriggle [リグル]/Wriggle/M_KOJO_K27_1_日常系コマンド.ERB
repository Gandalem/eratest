	ELSE
		IF IN_HEAT([[リグル]])
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음...」
					PRINTFORMDW 리글은 눈을 감고 미소 짓는다.
				CASE 1
					PRINTFORMW 「나머리도 머리를 쓰다듬어 줄 수 있어?」
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[リグル]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「에헤헤... 네가 내 베개보다 훨씬 편하네.」
					PRINTFORMW 「우리 잠자리에 들 때마다 이걸 하게 만들어야겠어.」
					CALL HPH_PRINT, @"「걱정 마, 우리가 함께 침대에 있을 때 다른 걸 하면서 갚을게HPH」", "W"
				CASE 1
					PRINTFORML 「정말 좋다... 눈을 감고 잠들고 싶게 만드네...」
					PRINTFORMW 「하지만 그럴 수 없어! 내가 자는 동안 어떤 요괴가 너를 공격하면 어떡해?!」
				CASE 2
					PRINTFORMW (깨어 있어야 해... 혹시 코골기 시작하면 어떡하지?)
					PRINTFORMW (잠깐, 나 코 골까? 내 코 고는 소리 들어본 적 없는데...)
					PRINTFORMW (다음번에 잠들 때 벌 친구 중 한 명에게 들어달라고 해야겠어...)
					PRINTFORMDW 리글이 뭔가 신경 쓰이는 게 있나? %HE_SHE([[リグル]],1)%가 좀 스트레스 받는 것 같아.
			ENDSELECT
		ELSEIF TALENT:[[リグル]]:セフレ || TALENT:[[リグル]]:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW (저렇게 구르면 %K27_MASTER()%의 무릎에서 떨어질 거야...)
					PRINTFORMW (하지만 저쪽으로 구르면, 바로 %HIS_HER(MASTER)%의... 사타구니로 굴러들겠지...)
					PRINTFORMW (아, 벌레가 뭘 할 수 있겠어?)
					PRINTFORMW (미스티가 여기 있었으면 좋겠다. 그녀는 항상 좋은 조언을 해주거든.)
					IF CFLAG:[[リグル]]:現在位置 == CFLAG:[[ミスティア]]:現在位置
						PRINTFORMW 「아, 저기 그녀가 있어!」
						PRINTFORMW 「하지만 %K27_MASTER()% 앞에서 물어볼 수가 없어...」
						PRINTFORMW 「내 버그 친구 중 한 명이 메시지를 전달해 줄 수 있을까?」
					ENDIF
				CASE 1
					PRINTFORMW 「음... 당신의 허벅지가 정말 부드럽네요...」
					PRINTFORMW 「아, 아니에요. 살 빼라는 게 아니라! 그냥 말했을 뿐이에요!」
				CASE 2
					PRINTFORMW 「내 더듬이가 너를 찌르고 있니?」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「얘들아, 예의를 지켜! %HE_SHE(MASTER)%가 허락하기 전에 MASTER에게 기어오지 마!」
					PRINTFORMDW 다리 아래로 무언가가 꿈틀거리는 것을 느낀다.
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
