@M_KOJO_EN01_MESSAGE_COM_K27_0
CALL M_KOJO_EN01_MESSAGE_COM_K27_0_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K27_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[リグル]]) && FIRSTTIME(SELECTCOM)
		PRINTFORMDW 당신이 %HIS_HER([[リグル]])%의 몸을 부드럽게 어루만지자 리글의 숨소리가 거칠어진다.
		CALL HPH_PRINT, @"「%K27_MASTER()%은(는) 그렇게 부드러울 필요 없어. 난 거친 게 좋아, 알잖아HPH」", "W"
		PRINTFORMDW 음, 만약 그게 %HE_SHE([[リグル]])%이 원하는 거라면...
		PRINTFORMDW 당신은 위글의 몸을 부드럽게 쓰다듬는 것에서 더듬고 꼬집는 것으로 바꾸고, %HE_SHE([[リグル]])%은 등을 아치형으로 만들며 신음한다.
		PRINTFORMW 「응! 그렇게 해줘! 멈추지 마!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDW 당신이 %HIM_HER([[リグル]])%의 유두를 잡아당기며 그 안에서 사정한다.
				CASE 1
					PRINTFORMDW 당신은 절정에 이르면서 엄지와 검지로 위글의 클리토리스를 문지른다.
				CASE 2
					PRINTFORML 
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;1,クンニ
;==================================================

@M_KOJO_EN01_MESSAGE_COM_K27_1
CALL M_KOJO_EN01_MESSAGE_COM_K27_1_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K27_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && SHIRAHU([[リグル]]) && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「Ah-!」
		PRINTFORMDW 당신이 %HIS_HER([[リグル]])%의 다리를 벌리고 %HIS_HER([[リグル]])%의 보지에 길고 느린 핥음을 주자 리글은 숨을 들이쉰다.
		PRINTFORMW 「좀 간지럽긴 하는데...」
		PRINTFORMW 「근데 정말 기분도 좋아. 제발 멈추지 마세요, %K27_MASTER()%!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 「방금 내 안에 사정하고 나서 왜 거기 아래를 핥고 있는 거야?」
			PRINTFORMW 「자기 자신의 맛을 즐기는 거니?」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF ABL:MASTER:Ｍ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 당신은 위글의 클리토스를 꼬집으며 %HIM_HER([[リグル]])% 처럼 %PRINT_MALE("man", MASTER)% 미친 듯이
				PRINTFORMDW 비틀거리며 비명을 지르고 활처럼 휘다 %HIS_HER([[リグル]])% 뒤로 밀며 %HIS_HER([[リグル]])% 네 얼굴에 박히는
			CASE 1
				PRINTFORMDW 당신은 위글의 통통한 엉덩이를 주무르면서 위에서부터 아래까지 %HIS_HER([[リグル]])%의 보지를 핥는다.
			CASE 2
				PRINTFORML 「내 클리토스 물어줘... 제발...」
				PRINTFORMDW 당신은 Wriggle이 하는 대로 하고, %HE_SHE([[リグル]])%는 고통과 쾌감이 뒤섞인 비명을 지른다.
				PRINTFORMDW 당신은 다시 공격을 가하기 전에 %HIS_HER([[リグル]])%의 갈라진 곳에서 새어 나오는 액체를 핥는다.
		ENDSELECT
	ELSEIF ABL:MASTER:Ｍ感覚 >= 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「더 세게 핥아줄 수 있어?」
				PRINTFORMDW 당신은 핥는 속도를 높이고, 위글은 기쁨에 신음한다.
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 잠시 위글에게서 떨어져 혀에 휴식을 준다.
				PRINTFORMDW 위글은 아래를 내려 당신을 보며 미간을 찌푸린다.
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
