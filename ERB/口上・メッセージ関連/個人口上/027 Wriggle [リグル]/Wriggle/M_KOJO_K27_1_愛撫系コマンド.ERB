	IF LOCAL:1 && CFLAG:[[リグル]]:K27EN_WRIGGLE_OLD_RAW_PERMISSION != 2 && HAS_VAGINA([[リグル]]) && SHIRAHU([[リグル]])
		PRINTFORML 「음? 왜 멈췄어?」
		PRINTFORMW 「무슨 일 있어?」
		CALL ASK_M("아니, 아무것도 이상 없어.", 1, @"당신은 내가 아이를 가질 의향이 있는지 \@ K27EN_WRIGGLE_OLD_RAW_PERMISSION == 1 ? 나와 함께 # 위험하지 않은 날에 원한다 \@", CFLAG:[[リグル]]:K27EN_WRIGGLE_OLD_RAW_PERMISSION < 2)
		SELECTCASE RESULT
			CASE 1
				PRINTFORML 「Oh!」
				PRINTFORMDW 위글이 얼굴을 붉힌다.
				PRINTFORMW 「음...」
				CFLAG:[[リグル]]:生解禁 = CFLAG:[[リグル]]:K27EN_WRIGGLE_OLD_RAW_PERMISSION
				RESETCOLOR
				CALL OGAMITAOSHI([[リグル]])
				CALL M_KOJO_EN01_COLOR_K27
				CFLAG:[[リグル]]:K27EN_WRIGGLE_OLD_RAW_PERMISSION = CFLAG:[[リグル]]:生解禁
				CFLAG:[[リグル]]:生解禁 = 2
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
