; Modular ERB: 個人口上/027 Wriggle [リグル]/Wriggle/Hypnosis_KOJO_K27_1.ERB
;==================================================
;催眠口上
;XX　　　　　　Chara ID
;ARG　　　　　Hypnosis Type
;ARG:1　　　Hypnosis Result
;==================================================

@M_KOJO_EN01_EVENT_K27_666(ARG, ARG:1)
;口上主はTARGET
;ARGは催眠タイプ（0催眠キャンセル、1反発抑制、2合意誤認、3発情抑制/発情促進、4常識改変）
;ARG:1は催眠結果（-3大失敗、-2大失敗、-1失敗、0キャンセル、1成功、2大成功、3大成功）
;臨時素質（TALENT:反発抑制、TALENT:合意誤認、TCVAR:Common_Sense_Alteration_Status）
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF 顔絵付きメッセージ && ARG != 0 && ARG:1 > 0
		PRINTFORML
	;催眠タイプ
	SELECTCASE ARG
		;催眠キャンセル　　Hypnosis Cancel
		CASE 0
			;催眠結果　　必ず0である　　そして記入を推奨しない
			PRINTFORMW 「뭐지?」
			PRINTFORMDW 깜빡이며 %CALLNAME:[[リグル]]%와 %HIS_HER([[リグル]])%로 이마를 문진다.
			PRINTFORMW 「뭔가 좀 이상해...」
			;反発抑制　　Resistance Weakened
		CASE 1
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「음... %K27_MASTER()%은(는) 뭘 하는 거냐?」
						CASE 1
							PRINTFORMW 「머리가 아파지기 시작했어. 다른 곳에서 해 줄 수 있어?」
						CASE 2
							PRINTFORML 「나를 용서받고 싶다면, 그냥 사과해.」
							PRINTFORMW 「아니면 나에게 맛있는 애플 파이를 줄 수도 있어. 그것도 괜찮아.」
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMW 「응? 왜 용서하고 싶은 기분이 들지...」
					PRINTFORMDW %CALLNAME:[[リグル]]%은(는) %HIS_HER([[リグル]])%의 고개를 젓는다.
					PRINTFORMW 「잠시 정신을 놓았던 것 같아. 무슨 일 있었어?」
					;Great Success
				CASE 2, 3
					PRINTFORMW 「어라? 뭔가 너한테 화가 난 것 같은데, 뭐가 그랬는지 기억이 안 나네.」
					PRINTFORMDW %CALLNAME:[[リグル]]%는 미소 짓는다.
					PRINTFORMW 「그러니까 별일 아니었나 봐! 게다가 영웅은 원망을 품지 않아!」
			ENDSELECT
			;合意誤認　　Make Sex Acceptable
		CASE 2
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「뭐라고? 안 돼! 위대한 %NAME:[[リグル]]%는 걸레가 아니야!」
						CASE 1
							PRINTFORMW 「안 돼. 먼저 구애 춤을 추면 생각해 볼게.」
						CASE 2
							PRINTFORMW 「내가 그걸 하고 싶었다면 페로몬을 방출했을 것이다. 하지만 나는 그렇지 않다.」
					ENDSELECT
					;成功　　Success
				CASE 1
					IF TALENT:[[リグル]]:恋人
						PRINTFORMW 「하지만... 내가 임신하고 %HE_SHE(MASTER)%이 나를 떠나면 어떡해?」
					ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
						PRINTFORMW 「하지만... 만약 %HE_SHE(MASTER)%이 나를 좋아하지 않는다면?」
					ELSE
						PRINTFORMW 「하지만... 나는 %HIM_HER(MASTER)%을 잘 몰라...」
					ENDIF
					PRINTFORMDL %CALLNAME:[[リグル]]%는/은 %HE_SHE([[リグル]])%가 제안을 저항하려 애쓰면서 이를 악문다.
					IF TALENT:[[リグル]]:恋人
						PRINTFORMW 「아니, 그건 미친 소리야. %K27_MASTER()%'는 좋은 사람이잖아. %HE_SHE(MASTER,1)%은 그런 짓 안 할 거야.」
						PRINTFORMW 「게다가 난 피임약이 잔뜩 있어. 위험한 날 그냥 그거 먹으면 돼.」
					ELSEIF TALENT:[[リグル]]:思慕 || TALENT:[[リグル]]:恋慕
						IF EXP:[[リグル]]:愛情経験 > 0
							PRINTFORMW 「아니... 만약 %K27_MASTER()%이 나를 좋아하지 않았다면, %HE_SHE(MASTER)%은 나와 데이트를 하지 않았을 거야.」
							PRINTFORMW 「게다가 이건 그냥 짝짓기일 뿐이야.」
						ELSE
							PRINTFORMW 「음... %HE_SHE(MASTER)%가 그러지 않더라도 그건 그냥 교미일 뿐이야.」
						ENDIF
						GOTO WRIGGLE_JUST_MATING
					ELSE
						PRINTFORMW 「그래서 뭐? 그냥 짝짓기잖아.」
						$WRIGGLE_JUST_MATING
						PRINTFORMW 「나는 그저 구애 의식을 치르면 되고, 만약 %HE_SHE(MASTER)%가 응답한다면 우리는 그걸 한다. 그게 전부다.」
						PRINTFORMW 「만약 %HE_SHE(MASTER)%가 응답하지 않는다면... 뭐, 상관없지. 기분 나빠하지 않을 거야.」
					ENDIF
					;Great Success
				CASE 2, 3
					IF CFLAG:[[リグル]]:既成事実 & 合意_うふふ
						PRINTFORML (나는 전에 %K27_MASTER()%와 성관계를 가졌고, 정말 좋았다.)
						PRINTFORMW (%HE_SHE(MASTER)%가 다시 하고 싶은지 물어봐야겠다...)
					ELSE
						PRINTFORMW 「이봐, %K27_MASTER()%?」
						PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 얼굴을 붉힌다.
						PRINTFORMW 「나랑 같이 하고 싶다면, 그냥 물어보면 돼.」
						PRINTFORMW 「전에 왜 말 안 했는지 모르겠네. 내가 잊어버렸나?」
					ENDIF
			ENDSELECT
			;発情抑制/発情促進　　Estrus Control
		CASE 3
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「진심이야? 나는 매년 봄에 발정하는데, 그것만으로도 충분하잖아.」
						CASE 1
							PRINTFORMW 「음... 손을 흔들거나 중얼거리는 것만으로 사람을 흥분시킬 수는 없어.」
						CASE 2
							PRINTFORMW 「단순히 나에게 섹스를 요구하는 거라면 그건 이상할 정도야.」
							PRINTFORMW 「하지만 날 발정 상태로 만들기 위해 마법을 걸려고 하는 거야?」
							PRINTFORMDW %CALLNAME:[[リグル]]%는 당신을 노려본다.
							PRINTFORMW 「%CALLNAME:[[リグル]]%가 걷어차기 전에 그만둬.」
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMW (흐으... 왜 흥분하는 거지?)
					PRINTFORMW (진정해야 해. 섹시하지 않은 걸 생각해 봐야지. 거미 같은 거.)
					PRINTFORMW (%K27_MASTER()%가 나를 거미줄로 묶고 찰싹 때리면 정말 뜨거울 거야- 앗!)
					PRINTFORMW (좋아, 차가운 건 어때? 정말 추운 걸 상상해 봐. 흥분하기엔 너무 추워서.)
					PRINTFORMW (%K27_MASTER()%를 박아야 할 정도로 추우면... 뭐지, 나한테 무슨 일이야?!)
					PRINTFORMDW %CALLNAME:[[リグル]]%는 %HIS_HER([[リグル]])%의 이마에서 땀을 닦아낸다.
					;Great Success
				CASE 2, 3
					PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 신음소리를 참기 위해 %HIS_HER([[リグル]])%의 입술을 깨문다.
					PRINTFORMD %HIS_HER([[リグル]],1)% 
					IF HAS_PENIS([[リグル]])
						PRINTFORMD %FSYN("penis")% 
						IF HAS_VAGINA([[リグル]])
							PRINTFORMD 그리고 유두가 단단해진다
						ELSE
							PRINTFORMD 단단해진다
						ENDIF
					ELSE
						PRINTFORMD 유두가 단단해진다
					ENDIF
					PRINTFORMDW .
					PRINTFORMDW 달콤한 냄새가 공기를 가득 채운다. %HIS_HER([[リグル]],1)% 항문이 빛나기 시작한다.
					PRINTFORMDW 그리고, 깨닫지 못하는 듯, %HE_SHE([[リグル]])% 당신 주위를 빙글빙글 돌며 %HIS_HER([[リグル]])% 다리를 흔들기 시작한다?
					PRINTFORMDW 불빛 요괴들은 발정기에 들면 이상한 짓을 한다...
			ENDSELECT
			;常識改変　　Common-Sense Control
		CASE 4
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「도대체 무슨 소리 하는 거야?」
						CASE 1
							PRINTFORMW 「이거 무슨 이상한 정신 조종 같은 거야?」
							PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신을 노려본다.
							PRINTFORMW 「정말 심각해. 그만둬.」
						CASE 2
							PRINTFORMW 「"이상한 사람처럼 행동하면서 왜 '상식' 같은 소리를 하고 있는 거야?"」
					ENDSELECT
					;成功　　Success
				CASE 1
					PRINTFORMDW 위글이 삼킨다.
					PRINTFORMW (이상한 기분이 들어. 마치 발정 중인 것 같아... 하지만 그럴 때면 그냥 엄청 흥분하게 되거든.)
					PRINTFORMW (하지만 지금은 %K27_MASTER()%과 교미하고 싶을 때만 그런 느낌이 들어. 그리고 그냥 %HIM_HER(MASTER)%와 교미하고 싶은 게 아니야.)
					PRINTFORMW (나는 %HE_SHE(MASTER)%가 시키는 건 뭐든지 하고 싶어. 나...)
					PRINTFORMDW 위글이 %HIS_HER([[リグル]])%의 입술을 물었다. 마치 %HE_SHE([[リグル]])%'가 최면과 싸우고 있는 것 같았다.
					PRINTFORMDW 당신은 %HIS_HER([[リグル]])%'의 눈을 들여다보며 제안을 심화시킨다.
					PRINTFORMW (잠깐, 내가 무슨 말을 하는 거지? 물론 그런 모든 것을 하고 싶지. 난 %K27_MASTER()%을 사랑하니까!)
					PRINTFORMW (그리고 좋아하는 사람과 그런 걸 하고 싶은 건 당연한 거잖아, 맞지?)
					PRINTFORMDW 위글의 얼굴에 커다란 어리둥절한 미소가 퍼진다. %HE_SHE([[リグル]])%'는 초점이 없는 눈으로 당신을 응시한다.
					PRINTFORMW 「아, %K27_MASTER()%... 뭔가 하고 싶어?」
					PRINTFORMW 「저가 저녁을 해줄 수도 있고, 목욕물을 받아줄 수도 있어... 아니면 당신이 나를 해줘～」
					;Great Success
				CASE 2
					IF FIRSTTIME("WriggleCommonSenseInstantLoss")
						PRINTFORMW (너무 이상해. 꼭 발정하고 취한 것 같은 기분이야.)
						PRINTFORMW (그리고 내 머릿속에서 %K27_MASTER()%의 목소리가 울리는 게 들려. 마치-)
						PRINTFORMW 「(오... %HE_SHE(MASTER)%가 나를 최면 걸었어, 그렇지 %HE_SHE(MASTER)%)? 그건...」
						PRINTFORMDW 거대한 어리둥절한 미소가 %CALLNAME:[[リグル]]%의 얼굴에 퍼진다. %HE_SHE([[リグル]])%는 초점이 풀린 눈으로 당신을 응시한다.
						PRINTFORMW (너무 섹시해...)
						PRINTFORMW (이제 언제든지 %HE_SHE(MASTER)%가 원할 때, %HE_SHE(MASTER)%가 원하는 대로 나를 하게 만들 수 있고 나는 저항할 수가 없어.)
						PRINTFORMW (%HE_SHE(MASTER,1)%는 내가 모든 사람이 볼 수 있는 공공장소에서 옷을 벗고 %HIM_HER(MASTER)%을 하도록 최면 걸 수도 있을 거야.)
						PRINTFORMW (그리고 만약 %HE_SHE(MASTER)%가 정말 새디스트라면, %HE_SHE(MASTER)%는 내가 무슨 일이 일어나고 있는지 알게 만들 수도 있어.)
						PRINTFORMW (아무리 발버둥 쳐도 내 몸은 내 말을 듣지 않고 쾌락은 점점 쌓여가고 %K27_MASTER()%은 웃고 또 웃어-)
					ELSE
						PRINTFORMDW 와글의 얼굴에 거대한 어리석은 미소가 퍼진다. %HE_SHE([[リグル]])%는 초점 없는 눈으로 당신을 응시한다.
						PRINTFORMW 「%K27_MASTER()%～ 또 나를 최면 걸었어?」
						CALL HPH_PRINT, @"「아이고, 제 의지와 상관없이 온갖 더러운 짓을 저지르게 만들지는 말아주길 정말 바란다 HPH」", "W"
					ENDIF
					PRINTFORMDW 위글은(는) %HIS_HER([[リグル]])% 허벅지를 문지르기 시작한다.
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
