@M_KOJO_EN01_CHECK_K27_SNOWMAN(ARGS,ARG,ARG:1)
#DIM SNOWMAN_TYPE
LOCAL = 30

IF !FA17_OBJ:(ARG % 100)
    SNOWMAN_TYPE = RAND:4
ELSE
    SNOWMAN_TYPE = FA17_TYPE:(ARG % 100)
ENDIF
SELECTCASE SNOWMAN_TYPE
    CASE 0
        RESULTS = group of snow ants
        RESULTS:1 = marching in a line
        LOCAL = 60
    CASE 1
        RESULTS = snow butterfly
        RESULTS:1 = that looks a lot like Larva
        LOCAL = 10
    CASE 2
        RESULTS = swarm of snow beetles
        LOCAL = 60
    CASE 3
        RESULTS = snow centipede
        RESULTS:1 = with a tiny pickaxe and shovel in its forelegs
        LOCAL = 60
ENDSELECT

RETURN LOCAL, SNOWMAN_TYPE