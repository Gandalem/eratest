;90,アナル愛撫される
;==================================================

@M_KOJO_EN01_MESSAGE_COM_K27_90
CALL M_KOJO_EN01_MESSAGE_COM_K27_90_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K27_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「와!」
		PRINTFORMDW 당신이 %HIS_HER([[リグル]])%의 엉덩이에 손가락을 넣자 리글이 꿈틀거렸다.
		PRINTFORMW 「네가 뭘 하는 건지 알고 있나?!」
		PRINTFORMW 「...오? 기분 좋을 거라고 말하는군?」
		PRINTFORMW 「좋아 그럼... 하지만 기분이 안 좋으면 네 엉덩이를 차버릴 거야!」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;91,アナル舐めされる
;==================================================

@M_KOJO_EN01_MESSAGE_COM_K27_91
CALL M_KOJO_EN01_MESSAGE_COM_K27_91_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K27_91_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;基本セット
	;Time stop
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
		;Sleep rape
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;Character is drunk
		;Conscious rape
	ELSEIF (TCVAR:無理矢理 || CFLAG:無理矢理膣射)
		RETURN 1
	ELSEIF TCVAR:TARGET:泥酔 == 1
		RETURN 1
	ELSEIF LOCAL:1 && FIRSTTIME("WriggleEatsAss")
		PRINTFORMW 「나한테 네 엉덩이를 핥으라고...?」
		PRINTFORMDW 리글은 %HIS_HER([[リグル]])%의 머리를 옆으로 기울였다.
		PRINTFORMW 「모르겠어. 왜 그런 걸 나한테 하라는 거야?」
		PRINTFORMW 「...엉덩이 구멍이 민감하다고?!」
		PRINTFORMDW %HE_SHE([[リグル]],1)%는 얼굴을 찡그렸다.
		PRINTFORMW 「윽! 난 그냥 바깥쪽만 핥으려고 했는데!」
		PRINTFORMW 「내가 분변 딱정벌레인 줄 알아?!」
		PRINTFORMW 「절대 네... 역겨운... 땀에 젖은... 엉덩이를 핥을 순 없어...」
		PRINTFORMDW 리글은 거칠게 숨을 쉬기 시작했다.
		PRINTFORMW 「우웩... 나 같은 불쌍한 %PRINT_MALE("boy", [[リグル]])%에게 그렇게 수치스러운 일을 시키다니 믿을 수가 없네...」
		RETURN 1
	ELSEIF ABL:[[リグル]]:舌 <= 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW 위글은 어색하게 당신의 엉덩이를 핥다가 당신의 항문을 빠르게 핥았다.
			CASE 1
				PRINTFORMDW 위글은 당신의 항문을 실제로 안쪽까지 핥지 않고 머뭇거리며 주위를 핥았다.
			CASE 2
				PRINTFORMDW 위글이 당신의 항문에 %HIS_HER([[リグル]])% 혀를 넣고 몇 번 흔든다.
		ENDSELECT
		PRINTFORMDW %HE_SHE([[リグル]],1)%이(가) %HIS_HER([[リグル]])%의 머리를 뒤로 빼며 얼굴을 찌푸린다.
	ELSEIF ABL:[[リグル]]:舌 <= 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				; IF HAS_VAGINA(MASTER)
				; 	PRINTFORMDW Wriggle reaches around in front of you and slides two fingers into your %FSYN("vagina")%.
				; 	PRINTFORMDW %HE_SHE([[リグル]],1)% alternates between
				; ELSE
				; ENDIF
			CASE 1
				PRINTFORML 
			CASE 2
				PRINTFORML 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
