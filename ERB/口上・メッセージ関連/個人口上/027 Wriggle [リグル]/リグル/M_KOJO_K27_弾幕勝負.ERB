; Modular ERB: 個人口上/027 Wriggle [リグル]/リグル/M_KOJO_K27_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K27_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 「본격적으로 나올 거야!」
			CASE 2
				PRINTFORML 「꽤 하는구나!」
			CASE 1
				PRINTFORML 「히익」
			CASE 0
				PRINTFORML 「우와아앙」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
				CFLAG:K27C_弾幕敗北回数 += 1
			CASE 3
				PRINTFORML 「우리의 승리야!」
				CFLAG:K27C_弾幕敗北回数 += 1
			CASE 2
				PRINTFORML 「오분의 영혼, 봤냐아!」
				CFLAG:K27C_弾幕敗北回数 += 1
			CASE 1
				PRINTFORML 「야호, 이겼다아!」
				CFLAG:K27C_弾幕敗北回数 += 1
			CASE 0
				PRINTFORML 「우와아앙」
				CFLAG:K27C_弾幕勝利回数 += 1
				IF (CFLAG:K27C_弾幕勝利回数 >= 30 || CFLAG:142:弾幕勝負勝利 == 1) && CFLAG:1008 == 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 정말 강하네……」
					SIF CFLAG:142:弾幕勝負勝利 == 1
						PRINTFORML 「그건 그렇고, %조사처리(CALLNAME:MASTER,"는")% 대오갈색보다 강하잖아…… 당연히 이길 리가 없지이」
					PRINTFORML 「나, %CALLNAME:MASTER%처럼 강한 \@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 남자 # 사람 \@를 정말 좋아해……❤」
					IF TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3
						PRINTFORML 「%TEXTR(@"%CALLNAME:MASTER%/君")%라면, 강한 후손을 남길 수 있을지도...❤」
						PRINTW 
						PRINTFORML 리글의 암컷 본능은, \@ CFLAG:142:弾幕勝負勝利 == 1 ? 대오갈비조차 쓰러뜨리는 # 자신을 완벽하게 박살 낸 \@%조사처리(CALLNAME:MASTER,"를")% 매력적으로 느끼는 것 같다.
						PRINTFORML 리글은 %조사처리(CALLNAME:MASTER,"의")% 정자로 임신하고 싶다고 생각하게 되었다.
						PRINTW 
						CFLAG:生解禁 = 2
					ELSE
						PRINTFORML 「아아~ 이렇게 %조사처리(CALLNAME:MASTER,"가")% 남자였으면 더 좋았을 텐데……」
						PRINTW 
						PRINTFORML 리글은 %조사처리(CALLNAME:MASTER,"에게")% 거기가 생겨 있다면 좋겠다고 생각하는 것 같다.
					ENDIF
					CFLAG:1008 = 1
				ELSEIF CFLAG:K27C_弾幕勝利回数 == 15
					PRINTFORML 「우으, %조사처리(CALLNAME:MASTER,"는")% 강하네……」
					PRINTFORML (완전히 박살 나버렸지만… 만약 누군가와 짝을 이루자면 %CALLNAME:MASTER%처럼 강한 사람일까)
					PRINTL 
					PRINTFORML 리글은 강자인 %조사처리(CALLNAME:MASTER,"를")% 좋아하고 있는 것 같다.
					PRINTFORML (리글을 더 이겨볼까, 거대한 벌레 요괴를 쓰러뜨린다면…?)
					PRINTW 
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
