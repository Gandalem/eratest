@M_KOJO_MESSAGE_COUNTER_K27_50
CALL M_KOJO_MESSAGE_COUNTER_K27_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K27_50_1
IF TALENT:MASTER:形状 == 4
	SELECTCASE ABL:指
		CASE IS >= 5
			SELECTCASE RAND:10
				CASE 0
					CALL HPH_PRINT,@"「아아…… HPH, 몇 번 봐도 멋진 %TEXTR("生殖器/おちんちん")%네……. HPH」","L"
					CALL HPH_PRINT,@"「안에 갖고 싶어져 버렸어… 안 돼, 어떡하지…? 안 돼…? HPH」","L"
					PRINTW 
				CASE 1
					CALL HPH_PRINT,@"「엄청 빛나고... 손안에서 움찔거려... HPH」","L"
					CALL HPH_PRINT,@"「벌써 내 안에 넣어줬으면 하고 생각했지? 나는…… 언제든 괜찮아 HPH」","L"
					PRINTW 
				CASE 2
					PRINTFORML 「이대로 손으로 끝내도 괜찮아?」
					CALL HPH_PRINT,@"「이 단단하고 당당한 %TEXTR("生殖器/おちんちん")%로…… 나와 교미해 주고 싶지 않아? HPH」","L"
					PRINTW 
				CASE 3
					CALL HPH_PRINT,@"「……HPH」","L"
					PRINTFORML 리글은 황홀한 표정으로, %조사처리(CALLNAME:MASTER,"의")% 페니스를 느긋하게 애무하고 있다...
					PRINTW 
				CASE 4
					CALL HPH_PRINT,@"「있잖아, 이거 빨리 갖고 싶다아... HPH」","L"
					CALL HPH_PRINT,@"「사실은 전부 안에 싸줬으면 좋겠는데, 손으로 기분 좋게 해줬더니 넣어줄 거야...? HPH」","L"
					PRINTW 
				CASE 5
					CALL HPH_PRINT,@"「후후. 내 손 안에서 날뛰고 있네 HPH」","L"
					CALL HPH_PRINT,@"「내보내고 싶구나? HPH 나랑 많이 교미해 준다면, 싸게 해줄게 HPH」","L"
					PRINTW 
				CASE 6
					PRINTFORML 「내 손이 그렇게 기분 좋은 거야?」
					CALL HPH_PRINT,@"「하지만 교미하는 쪽이 너도 나도 더 기분 좋아질 거라고 생각하는데…… HPH」","L"
					PRINTW 
				CASE 7
					CALL HPH_PRINT,@"「네 부탁이니까 손으로 해줄게…… 하지만 정액은 이쪽으로 내주지 않으면 싫으니까…… HPH」","L"
					PRINTFORML 빛나는 페니스에 안겨진 리글은 요염한 표정을 지으며, 은밀한 곳을 손가락으로 벌려 보였다...
					PRINTW 
				CASE 8
					CALL HPH_PRINT,@"「있잖아, 빨리 이걸로 교미하자고오 HPH」","L"
				CASE 9
					CALL HPH_PRINT,@"「지금 당장 교미하겠다고 말 안 하면, 싸게 해 주지 않을 거야…… HPH」","L"
			ENDSELECT
		CASE IS >= 2
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「에헤헤, 잘해지고 있잖아? HPH」","L"
					CALL HPH_PRINT,@"「너를 위해 노력했단 말이야…… HPH이니까, 나중에 네 거 잔뜩 받고 싶다 HPH」","L"
					PRINTW 
				CASE 1
					PRINTFORML 「있잖아, 여기 기분 좋아?」
					CALL HPH_PRINT,@"「나도 많이 기분 좋게 해줬으면 좋겠어…… HPH」","L"
					PRINTW 
				CASE 2
					CALL HPH_PRINT,@"「아하, 엄청 딱딱하네... HPH」","L"
					CALL HPH_PRINT,@"「게다가 강한 빛. 이 정도면 나도 강한 아이를 낳을 수 있을 것 같아…… HPH」","L"
					PRINTW 
				CASE 3
					CALL HPH_PRINT,@"「손으로 받아내고 싶어? HPH 괜찮아, HPH」","L"
					CALL HPH_PRINT,@"「그 대신, 같은 양만큼 나한테 사정해 주면 되잖아 HPH」","L"
					PRINTW 
				CASE 4
					CALL HPH_PRINT,@"「저기, 싸고 싶어? HPH」","L"
					CALL HPH_PRINT,@"「이대로 싸버릴까? HPH 아니면, 나랑 아이 만들래? HPH」","L"
			ENDSELECT
		CASEELSE
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「와아... HPH 멋진 %TEXTR("生殖器/おちんちん")%네... HPH」","L"
					CALL HPH_PRINT,@"「나, 열심히 봉사할게 HPH」","L"
					PRINTW 
				CASE 1
					CALL HPH_PRINT,@"「너의 여기…… 엄청 빛나고 있어 HPH」","L"
					PRINTW 
				CASE 2
					PRINTFORML 「이렇게 멋진 %TEXTR("生殖器/おちんちん")%를 만나다니, 나 정말 행운이야♪」
					PRINTFORML 「열심히 봉사하겠지만, 기분이 좋지 않다면 미안해?」
					PRINTW 
				CASE 3
					CALL HPH_PRINT,@"「이렇게 하면, %TEXTR("生殖器/おちんちん")%가 점점 단단해져 가는 거야…… HPH」","L"
					CALL HPH_PRINT,@"「아하핫, 역시…… HPH 내 손 안에서 엄청나게 되고 있어…… HPH」","L"
				CASE 4
					CALL HPH_PRINT,@"「나 말이야, 열심히 기분 좋게 해 줄 테니까…… 후훗」","L"
					CALL HPH_PRINT,@"「기분 좋아지면 나랑 교미해 줄래……HPH」","L"
			ENDSELECT
	ENDSELECT
ELSEIF TALENT:恋慕 || TALENT:恋人
	SELECTCASE ABL:指
		CASE IS >= 5
			SELECTCASE RAND:6
				CASE 0
					PRINTFORML 「%TEXTR(@"%CALLNAME:MASTER%/君")%는 완전히 내 손에 빠져버렸네……♪」
					PRINTFORML 리글의 손가락은 마치 거미가 먹이를 휘감듯이 %조사처리(CALLNAME:MASTER,"의")% 페니스 위를 기어 다니고 있다……
				CASE 1
					PRINTFORML 「있잖아, 가르쳐줘. 내 손으로 싸게 해줄까?」
					PRINTFORML 「솔직하게 대답하면 끝까지 해줄게. 그러니까, 말해줘…❤」
					PRINTFORML 리글의 손가락은 능숙하게 꿈틀거리며 %조사처리(CALLNAME:MASTER,"의")% 페니스를 생살 상태로 만들고 있었다...
				CASE 2
					PRINTFORML 「언제든 싸도 괜찮아. 몇 번이든 해 줄 테니까……❤」
				CASE 3
					PRINTFORML 「이렇게 단단하고 뜨거운 게, 내 안에 들어오네…… 대단해……」
				CASE 4
					PRINTFORML 「알고 있어. 끝에서 나온 꿀로 적시면서 주물러주면, %TEXTR(@"%CALLNAME:MASTER%/君")%는 기분 좋단 말이야❤」
					PRINTFORML 리글의 손가락에 의해 가져오는 쾌감은 소화액처럼 %조사처리(CALLNAME:MASTER,"의")% 생각을 질척하게 녹여간다...
				CASE 5
					PRINTFORML 「ふ、ふふ。ふふふ。こぉんなに激しくしても痛くないんだよね」
					PRINTFORML 「%TEXTR(@"%CALLNAME:MASTER%/君")%の%TEXTR("生殖器/おちんちん")%のことなら、なんだって知ってるんだから❤　射精だって、思うがままだよ❤」
			ENDSELECT
			PRINTW 
		CASE IS >= 2
			SELECTCASE RAND:5
				CASE 0
