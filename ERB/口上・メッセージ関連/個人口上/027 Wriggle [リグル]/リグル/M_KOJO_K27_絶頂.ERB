LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋慕 || TALENT:恋人
		IF TALENT:妊娠願望
			IF TALENT:MASTER:濃厚精液
				SELECTCASE RAND:2
					CASE 0
						;百々世に勝利
						IF CFLAG:142:弾幕勝負勝利 == 1
							CALL HPH_PRINT,@"(대오롱보다 강한 수컷의 정액…… 나의 가장 깊은 곳에 딱 맞게 부어져 있어…… HPH)","L"
							PRINTFORML (분명, 강한 아이가 태어나 줄 거야……❤)
							PRINTW 
						ELSEIF CFLAG:1:弾幕勝負勝利 == 1
							CALL HPH_PRINT,@"(하쿠레이의 무녀로부터 온 강한 남자의 정액... 내 가장 깊은 곳에 딱 맞춰 부어져 있어... HPH)","L"
							PRINTFORML (분명, 강한 아이가 태어나 줄 거야……❤)
							PRINTW 
						ELSEIF CFLAG:1:弾幕勝負勝利 == 27
							CALL HPH_PRINT,@"(나 같은 것보다 강한 수컷의 정액…… 내 가장 깊은 곳에 딱 맞게 뿌려지고 있어…… HPH)","L"
							PRINTFORML (%조사처리(CALLNAME:MASTER,"와")% 아이라면, 인간이든 벌레든 좋으니까 태어나줬으면 해... ❤)
							PRINTW 
						ENDIF
					CASE 1
						PRINTDATADL
							DATAFORM 「아, 저 %조사처리(CALLNAME:MASTER,"와")%의 정액으로 수정될 거야……❤」
							DATAFORM 「저한테 진심으로 새끼를 낳게 할 생각인 거죠…❤」
							DATAFORM 「더 사정해줬으면 좋겠어…… %조사처리(CALLNAME:MASTER,"와")%의 아이가 갖고 싶으니까…❤」
							DATAFORM 「응읏… 뜨거워…❤ 금방 배가 가득 차버렸어…❤」
							DATAFORM 「%조사처리(CALLNAME:MASTER,"와")%의 강한 사정이 너무 좋아…❤」
							DATAFORM 「%조사처리(CALLNAME:MASTER,"와")%의 강력한 정액이 내 안으로 잔뜩 들어와…❤」
							DATAFORM 「우와…… 이거 저를 임신시키고 싶어서 이렇게 나오는 거야. 헤헤❤」
							DATAFORM 「제 여기, %조사처리(CALLNAME:MASTER,"와")%의 정액을 더 원하고 있대요… 안 돼요?」
							DATAFORM 「산란기라서 그런가… 더더욱 갖고 싶다고 생각하게 돼… 이 강하고 진한 정액이❤」
							DATAFORM 「하아, 하아…❤ 아, 새어버렸네… 또 부어줄 수 있을까…❤ 제대로 임신할 때까지…❤」
							DATAFORM 「스스로도 알겠어… 몸이 정액을 원하고 있다는 걸…❤ %조사처리(CALLNAME:MASTER,"와")%라면 분명 아기가 생길 것 같아…❤」
							DATAFORM 「내면으로 사정해줘. 밖에 내버리면 싫어…❤」
							DATAFORM 「저 말고 다른 암컷에게는 하지 말아 줘. 전부 내 안에 해줘…❤」
							DATAFORM 「강한 정액은 내가 독차지하고 싶거든. 그러니까 전부 내 안에 사정해 줘❤」
							DATAFORM 「여기가 아이를 만드는 곳이구나… 지금 여기에 정액이 쏟아지고 있네…❤」
							DATAFORM 「알겠어… 두 사람의 지금 느낌이라면 분명 아기가 생길 거라고…❤」
