						CASE 4
							RESULTS = 「やるね…！　でも、この子が相手ならどうかな？　%MUSHI_NAME%！」
					ENDSELECT
				CASE 1
					SELECTCASE RAND:5
						CASE 0
							RESULTS = 「まだ…！　%MUSHI_NAME%がいる！」
						CASE 1
							RESULTS = 「%MUSHI_NAME%！　キミにすべてを懸ける！」
						CASE 2
