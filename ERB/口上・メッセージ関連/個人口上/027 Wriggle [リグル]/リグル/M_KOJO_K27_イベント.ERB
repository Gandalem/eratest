				CASE 2
					RESULTS = 「わあ、%TEXTR(@"%CALLNAME:MASTER%/너")%って強いんだね♪」
				CASE 3
					RESULTS = 「おめでとう！　さすがだね！」
				CASE 4
					RESULTS = 「うん、悔しいけど君に負けるなら納得かな」
				CASE 5
					RESULTS = 「強い人って、私は好きだよ♪」
				CASE 6
					RESULTS = 「またやろうね！　約束だよ！」
				CASE 7
