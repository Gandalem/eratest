@K27_BEFORETRAIN
;一日の開始時、正確には来訪判定時に読み込む関数
;ここでCFLAG:XX:翌日来訪を設定して確実に来訪させたりTCVAR:XX:発情で朝っぱらからサカらせることもできる
;ただし「毎朝例外なく読み込まれる」ため、条件を設定しておくことが望ましい
;春の月下旬～夏の月上旬（実際の年月に合わせると５～６月ごろ）は妊娠願望を持つ
;あなたがホタルチンポもちで弾幕勝負勝利済みなら疑似ヤリマンになる
;生解禁レベルをCFLAGに格納し、一時的にMAX（=危険日生OK）にする
;恋の季節が終わるとCFLAGを参照して元の生解禁レベルに戻る
IF !TALENT:妊娠願望 && (DAY:2 == 1 && DAY:3 == 20)
	SETCOLOR 0xFF69B4
	PRINTL 
	PRINTFORML ❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤
	PRINTFORML ❤️리글에게 사랑의 계절이 찾아왔어요❤️
	PRINTFORML ❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤❤
	PRINTL 
	RESETCOLOR
	PRINTFORML 여름의 달이 뜨자, 리글은 10일까지 건강한 아이를 가질 수 있는 교미 상대를 찾게 된다.
	PRINTL 
	TALENT:妊娠願望 = 1
	CFLAG:K27C_恋の季節 = 1
	IF !TALENT:ヤリマン
		IF TALENT:MASTER:形状 == 4 && CFLAG:27:弾幕勝負勝利 == 1
			CFLAG:K27C_限定ヤリマン = 1
			TALENT:ヤリマン = 1
			;生解禁レベルを一時的にＭＡＸに
			IF CFLAG:生解禁 == 0
				CFLAG:1010 = 1
				CFLAG:生解禁 = 2
			ELSEIF CFLAG:生解禁 == 1
				CFLAG:1011 = 1
				CFLAG:生解禁 = 2
			ENDIF
			SETCOLOR 0xFF69B4
			PRINTL 
			CALL HPH_PRINT,@"리글은 강한 '동족'이라면 무조건 아이를 갖고 싶다고 느끼는 것 같다 HPH","L"
			PRINTL 
			RESETCOLOR
		ELSEIF CFLAG:27:弾幕勝負勝利 == 1
			PRINTFORML 리글은 「동족」이라 할지라도, 자신보다 강한 상대가 아니면
		ENDIF
	ENDIF
ENDIF
IF CFLAG:K27C_恋の季節 == 1 && (DAY:2 == 2 && DAY:3 == 10)
	;恋の季節が終わると妊娠願望やヤリマンを失う
	CFLAG:K27C_恋の季節 = 0
	TALENT:妊娠願望 = 0
	SIF TALENT:ヤリマン == 1 && CFLAG:K27C_限定ヤリマン == 1
		TALENT:ヤリマン = 0
	;生解禁レベルを元に戻し、フラグをリセット
	;元が0
	IF CFLAG:1010 == 1
		CFLAG:生解禁 = 0
		CFLAG:1010 = 0
		;元が1
	ELSEIF CFLAG:1011 == 1
		CFLAG:生解禁 = 1
		CFLAG:1011 = 0
	ENDIF
ENDIF
