				CASE 6
					RESULTS = 「テントウムシのサンバでお祝いだね♪」
				CASE 7
					RESULTS = 「虫の女王の座は譲れないね♪」
				CASE 8
					RESULTS = 「虫たちとの絆が強くなったみたい♪」
			ENDSELECT
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:8
				CASE 0
					RESULTS = 「おめでとう！　%TEXTR(@"%CALLNAME:MASTER%/너")%の勝利だよ！」
				CASE 1
