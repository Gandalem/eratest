			PRINTFORML 「우으, 생각보다 꽉 조이는 것 같아……」
			PRINTFORML 「조, 천천히 움직여 줄 수 있어…? 배가 너무 아파서……」
			PRINTW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
			;それ以外
		ELSE
			CALL K27_AEGI
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		CALL K27_AEGI
		RETURN 1
	ENDIF
ENDIF
