;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があってもムードが足りぬ　100=合意はあるが口上内特殊判定によって失敗）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先にキスぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外 98=口上内特殊判定による失敗 99=口上内特殊判定による成功
;口上内特殊判定は該当するCFLAGが0だと無効
;==================================================

@M_KOJO_MESSAGE_COM_K27_350
CALL M_KOJO_MESSAGE_COM_K27_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K27_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:抱き寄せ初回
		SELECTCASE TCVAR:抱き寄せ初回
			;恋の季節
			CASE 99
				IF CFLAG:K27C_恋の季節 == 1
					PRINTFORML (뭐지... 이 기분...)
					PRINTFORML (나 지금 %조사처리(CALLNAME:MASTER,"와")% 엄청 교미하고 싶다... 아냐, 교미해야 해...♥)
					PRINTFORML 「좋아…… 교미하자...?」
					PRINTW 
					IF CFLAG:K27C_発情フラグ == 1
						IF CFLAG:生解禁 == 1
							CFLAG:1011 = 1
							CFLAG:生解禁 = 2
						ELSEIF CFLAG:生解禁 == 0
							CFLAG:1010 = 1
							CFLAG:生解禁 = 2
						ENDIF
					ENDIF
				ENDIF
				;弾幕勝負未勝利
			CASE 98
				PRINTFORML 「에에!? 너랑!?」
				IF K27C_弾幕敗北回数 > K27C_弾幕勝利回数
					PRINTFORML 「나한테 이길 수 없을 정도로 약한 너라니…… 아우으…」
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"를")% 싫어하는 건 아니지만……」
					PRINTFORML 「나랑 교미하고 싶다면, 네가 나보다 강해져서 보여줘」
				ELSE
					PRINTFORML 「나보다 강한 \@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 남성 # 의 상대와는……」 \@
					PRINTFORML 「뭐, %조사처리(CALLNAME:MASTER,"를")% 싫어하는 건 아니지만……」
					PRINTFORML 「나랑 교미하고 싶다면, 네가 나보다 강하다는 걸 증명해 보여봐」
				ENDIF
				PRINTL 
				PRINTFORML 리글은 탄막 승부에서 자신보다 강한 상대 이외의 유전자를 남길 생각이 아닌 듯하다...
				PRINTL 
				PRINTW 
				;普通に
			CASE 1
				IF TALENT:MASTER:形状 == 4
					PRINTFORML 「혹시 %TEXTR(@"%CALLNAME:MASTER%/君")%랑 이런 일이 생길지도 있다고 생각했거든…♪」
					PRINTFORML 「응, 괜찮아…❤ 나랑, 교미하자…❤」
				ELSE
					IF CFLAG:142:弾幕勝負勝利 == 1
						PRINTFORML 「응, 괜찮아……♥」
						PRINTFORML 「큰 지네도 물리칠 %CALLNAME:MASTER%라면……」
					ELSEIF K27C_弾幕勝利回数 >= 10
						PRINTFORML 「응, 괜찮아……♥」
						PRINTFORML 「나보다 훨씬 강한\@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 남성 # 사람 \@이라면…」
						PRINTFORML 「하지만 아프게는 해주지 말아줬으면 해……」
						PRINTW 
					ELSE
						PRINTFORML 「응, 괜찮아…」
						PRINTFORML 「%CALLNAME:MASTER%라면 강한 유전자를 남겨줄 수 있다고 생각하니까」
						PRINTFORML 「하지만 아프게 하진 말아줘」
						PRINTW 
					ENDIF
				ENDIF
				;キスがまだ
			CASE 2
				;媚薬or発情
			CASE 3
				IF TCVAR:媚薬
					PRINTFORML (으응... 몸이 이상해... '계절'도 아닌데, 교미하고 싶다고 해...)
				ELSE
					PRINTFORML (우으... 본능에 거스를 수 없어... 머리로 생각하는 것보다 몸이 교미하고 싶어해...)
				ENDIF
				PRINTFORML 「앗, 저기…… 적어도, 한다면 상냥하게 해줘……」
				PRINTW 
				;刻印
			CASE 4
				;まんざらでも
			CASE 6
				PRINTFORML 「흥, 나와 그렇게 교미하고 싶구나」
				PRINTFORML 「%CALLNAME:MASTER%도 호타루의 매력에 사로잡혀 버린 것 같네
				;駄目
			CASE 7
				PRINTFORML 「안, 안 돼읏, 나 마음의 준비가 안 됐단 말이야」
				PRINTFORML 「아직 너랑은 그런 기분이 아닌데엣. 아앗,」
				PRINTW 
				;論外
			CASE 8
				PRINTFORML 「저, 잠깐만! 갑자기 너무 심한 거 아니야!?」
				PRINTFORML 「이런 건 말도 안 돼읏」
				PRINTW 
		ENDSELECT
		;２回目以降
	ELSE
		SELECTCASE TFLAG:194
			;成功
			CASE 0
				;弾幕勝負で30回以上勝利or百々世に勝利フラグ
				IF CFLAG:1008 == 1
					IF TALENT:恋慕 || TALENT:恋人
						IF TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3
							PRINTFORML 「교미하고 싶구나……♥ 좋아, %CALLNAME:MASTER%라면…….♥」
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 강한 정액으로 나를 임신시켜줘……♥」
						ELSE
							PRINTFORML 「교미하고 싶구나...♥ 암컷끼리지만, %CALLNAME:MASTER%라면 싫지 않아」
							PRINTFORML 「응... %조사처리(CALLNAME:MASTER,"가")% 하고 싶은 대로 해줘도 괜찮아...♥」
						ENDIF
						PRINTW 
					ELSE
						IF TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3
							PRINTFORML 「교미하고 싶구나... 좋아, 강한 수컷이라면 환영할 테니...」
							PRINTFORML 「응... 나 같은 것보다 훨씬 강한 %조사처리(CALLNAME:MASTER,"의")% 정액으로, 나를 임신시켜줘...」
						ELSE
							PRINTFORML 「교미하고 싶구나... 암컷끼리인데」
							PRINTFORML 「응... %조사처리(CALLNAME:MASTER,"가")% 하고 싶은 대로, 괜찮아...」
						ENDIF
						PRINTW 
					ENDIF
				ELSE
					;恋の季節
					IF CFLAG:K27C_恋の季節 == 1
						IF TALENT:MASTER:形状 == 4
							PRINTL 
