@M_KOJO_MESSAGE_SCOM_K27_7
CALL M_KOJO_MESSAGE_SCOM_K27_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K27_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF CFLAG:K27C_恋の季節 == 1
			SELECTCASE EXP:子宮口開発経験
				;開発され切った
				CASE IS > 50
					SELECTCASE RAND:11
						CASE 0
							CALL HPH_PRINT,@"「\@ CFLAG:1006 >= 1 ? %TEXTR("자궁/子袋")% # 안쪽 \@突いて \@ CFLAG:1006 >= 1 ? %TEXTR("자궁/子袋")% # 안쪽 \@突いて \@ CFLAG:1006 >= 1 ? %TEXTR("자궁/子袋")% # 안쪽 \@찔러서윽흐으읍」","L"
							CALL HPH_PRINT,@"「거기에읏! HPHHPH %TEXTR(@"%CALLNAME:MASTER%/君")%의 정액을 가득 부어줘어읏! HPHHPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「임신시키고 싶어읏 HPH 임신하고 싶어욧 HPH %TEXTR(@"%CALLNAME:MASTER%/君")%의 아기읏 HPH」","L"
							CALL HPH_PRINT,@"「안에서 싸도 좋으니까! HPH 제일 깊은 곳에 싸줘, 응? HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「억지로 열어줘읏 HPH 거기가 제일 소중한 곳이라고오옷 HPH」","L"
							CALL HPH_PRINT,@"「나한테!! HPH 강한 아이 낳게 해줘읏 HPHHPH」","L"
						CASE 3
							CALL HPH_PRINT,@"「아앗 HPH 아다 나올 것 같아 HPH 제일 깊은 곳에 있는 거 아앗 HPHHPH」","L"
							CALL HPH_PRINT,@"「%TEXTR("せーしょくき/おちんちん")%가 바로 닿아있어욧 HPH」","L"
						CASE 4
							CALL HPH_PRINT,@"「왔다 HPH 왔다 HPH 왔어 HPHHPH」","L"
							CALL HPH_PRINT,@"「가장 안쪽! 딱딱한 곳이!! 닿았어앗! 하프하프」","L"
						CASE 5
							CALL HPH_PRINT,@"「아기 만들자아앗 HPH %TEXTR("生殖器/おちんちん")%로오 HPH 키스하고 싶어읏 HPH」","L"
						CASE 6
							CALL HPH_PRINT,@"「저, 저기... 그렇게 난폭하게 찔러지면 어떡해요...!」","L"
							CALL HPH_PRINT,@"「나 나올 것 같아읏 HPH \@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋")% # 주머니 \@ 나 나올 것 같아욧 HPHHPH」","L"
						CASE 7
							CALL HPH_PRINT,@"「거기! HPH 거기, 좋아!! HPH」","L"
							CALL HPH_PRINT,@"「쌓아뒀던 정액 전부 내 가장 깊은 곳에 넣어줘읏 HPHHPH」","L"
						CASE 8
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%…HPHHPH」","L"
							CALL HPH_PRINT,@"「빨리…… HPH \@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋/질내/おまんこ")% # 안 \@에 싸줘… HPH 있잖아… HPH」","L"
						CASE 9
							CALL HPH_PRINT,@"「すごぉ…いHPH　%TEXTR(@"%CALLNAME:MASTER%/君")%の%TEXTR("生殖器/おちんちん")%…っHPH」","L"
							CALL HPH_PRINT,@"「배 속이, 뒤죽박죽이 되어버렸어…… HPH」","L"
						CASE 10
							CALL HPH_PRINT,@"「아아앗 HPH 아아앗 HPH 아아앗 HPH 아아앗 HPH」","L"
					ENDSELECT
					PRINTW 
					;綻び始めた
				CASE 25 TO 50
					SELECTCASE RAND:6
						CASE 0
							CALL HPH_PRINT,@"「응읏!? HPH 응읏 HPH 으윽 HPH」","L"
							CALL HPH_PRINT,@"「괴로운데 앗HPH 이거읏HPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「\@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋")% # 없었을 \@ HPH 터질 것 같아읏HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「깊숙이윽 HPH %TEXTR(@"%CALLNAME:MASTER%/君")%가 골리골리하고 있어읏 HPH」","L"
						CASE 3
							CALL HPH_PRINT,@"「앗 흐읍 하으윽 읏 하으윽 아흐읍 아아앙 아악!!」","L"
							PRINTFORML 리글은 자궁경부에 한 방씩 당할 때마다 날카로운 신음을 내며 온몸을 떨었다……
						CASE 4
							CALL HPH_PRINT,@"「배 속 깊은 곳까지읏 HPH 배 속 깊은 곳까지읏 HPH」","L"
							CALL HPH_PRINT,@"「%TEXTR(@"%CALLNAME:MASTER%/君")%가 HPH에 도착했어읏 HPH」","L"
						CASE 5
							CALL HPH_PRINT,@"「안 돼읏 HPH 안 돼읏 HPH」","L"
							CALL HPH_PRINT,@"「정액읏 HPH 원하게 되네 읏 HPH \@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋/질내/おまんこ")% # 중앙 \@에 원하게 되네 읏 HPHHPH」","L"
					ENDSELECT
					PRINTW 
					;異物感
				CASEELSE
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「흐으윽! 끅...!」","L"
							CALL HPH_PRINT,@"「괴로운데 앗HPH 이거읏HPH」","L"
						CASE 1
							CALL HPH_PRINT,@"「\@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋")% # 없었을 \@ HPH 터질 것 같아읏HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「안돼애읏 HPH, 그 이상은 안 들어가요오읏 HPH」","L"
					ENDSELECT
					PRINTW 
			ENDSELECT
		ELSE
			SELECTCASE EXP:子宮口開発経験
				;開発され切った
				CASE IS > 50
					IF TALENT:恋慕 || TALENT:恋人
						SELECTCASE RAND:7
							CASE 0
								PRINTFORML 「와줘…… %TEXTR(@"%CALLNAME:MASTER%/君")%라면, 세게 해도 괜찮으니까……♥」
							CASE 1
								PRINTFORML 「배에, 울려…… 윽♥」
								PRINTFORML 리글은 이물감과는 별개로, 가끔 깊숙한 곳에서 '쿵' 하고 울리는 쾌락에 휘둘리고 있는 듯하다…
							CASE 2
								PRINTFORML 「하아, 아앗, 그, 부드럽게 토닥여지는 거, 싫지 않을지도…♥」
								PRINTFORML 「응! 좋아, 좋아, 아, 아앗♥」
							CASE 3
								PRINTFORML 「더 토크토 해줘♥ 토크토♥」
								PRINTFORML 「들어가 버릴 것 같아♥ 아ー♥ 들어가 버릴 것 같아♥」
							CASE 4
								PRINTFORML 「%TEXTR(@"%CALLNAME:MASTER%/君")%の%TEXTR("生殖器/おちんちん")%と私のが密着してるよおっ♥」
							CASE 5
								PRINTFORML 「괴로워도 기분이 좋다, 아앗 ♥」
								PRINTFORML 「왜일까? %TEXTR(@"%CALLNAME:MASTER%/君")%이기 때문인 걸까♥」
							CASE 6
								PRINTFORML 「안 돼♥ 그런데도 말이야♥」
								PRINTFORML 「%TEXTR("グリグリ/ゴツゴツ/")% 당하는 거 좋아♥」
						ENDSELECT
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						SELECTCASE RAND:7
							CASE 0
								PRINTFORML 「제일 깊숙한 곳♥ %TEXTR(@"%CALLNAME:MASTER%/君")% 전용 구멍이 되어버렸어읏♥」
							CASE 1
								PRINTFORML 「이거♥ 대박이야♥ 깊숙이 찔러주는 거 중독돼버렸어읏♥」
							CASE 2
								PRINTFORML 「무거운 게 와요 ♥ 깊숙이요 ♥ 쿵쿵 내려와요 ♥」
							CASE 3
								PRINTFORML 「박힌다읏♥ 짓눌려버릴 것 같아욧♥ 푸규윽♥ 푸규윽♥」
							CASE 4
								PRINTFORML 「앗♥ 아으윽♥ 안쪽이♥ 부서질 것 같아♥」
							CASE 5
								PRINTFORML 「\@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋")% # 더 깊이 박아줘읏♥」 \@
							CASE 6
								PRINTFORML 「\@ CFLAG:1006 >= 1 ? %TEXTR("자궁/赤ちゃんの部屋/子袋")% # 깊숙이 \@ 닿았어♥ 아응앗♥」
						ENDSELECT
					ELSEIF TALENT:思慕
						SELECTCASE RAND:2 ;custom code
							CASE 0
								PRINTFORML 「흐윽, 으응, 윽」
								SELECTCASE RAND:3
									CASE 0
										PRINTFORML (안쪽이, 무거운 게 쿵 하고 느껴져...)
									CASE 1
										PRINTFORML (내 속이, 깊숙한 곳까지 %조사처리(CALLNAME:MASTER,"의")% 생식기 모양으로 만들어질 거야읏)
									CASE 2
										PRINTFORML (이거, 아기 방에 닿아 있는 거야!? 안, 안 돼읏……♥)
								ENDSELECT
							CASE 1
								PRINTFORML 「후으윽!? ♥ 아니야, 기분 좋지 않아……」
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「아앗!!?♥ 들어갔어!? 들어가고 있어옷!!」
							CASE 1
								PRINTFORML 「안, 안 돼읏! 깊숙이 찔러대면, 이상해질 거야아앗!」
						ENDSELECT
					ENDIF
					PRINTW 
					;綻び始めた
				CASE 25 TO 50
					IF TALENT:恋慕 || TALENT:恋人
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「와줘…… %TEXTR(@"%CALLNAME:MASTER%/君")%라면, 받아들일 수 있어……」
							CASE 1
								PRINTFORML 「응읏, 응읏, 응읏, 응읏, 으읍!?♥」
								PRINTFORML 리글은 이물감과는 별개로, 가끔 쿵 하고 깊숙한 곳에서 울리는 쾌락에 휘말리고 있는 듯하다…
							CASE 2
								PRINTFORML 「하아, 아앗, 그, 부드럽게 토닥여지는 거, 싫지 않을지도…♥」
								PRINTFORML 「응! 좋아, 좋아, 아, 아앗♥」
						ENDSELECT
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「안 돼엣, 그렇게 깊숙이 가득 박히면 아앗♥ %TEXTR(@"%CALLNAME:MASTER%/君")% 전용 구멍이 되어버릴 거야엣♥」
							CASE 1
								PRINTFORML 「이거!! ♥ 대박!! ❤️ 빠져버릴지도 몰라읏♥」
							CASE 2
								PRINTFORML 「무거운 게 와요 ♥ 깊숙이요 ♥ 쿵쿵 내려와요 ♥」
						ENDSELECT
					ELSEIF TALENT:思慕
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「흐윽, 으응, 윽」
								SELECTCASE RAND:3
									CASE 0
										PRINTFORML (안쪽이, 무거운 게 쿵 하고 느껴져...)
									CASE 1
										PRINTFORML (내 속이, 깊숙한 곳까지 %조사처리(CALLNAME:MASTER,"의")% 생식기 모양으로 만들어질 거야읏)
									CASE 2
										PRINTFORML (이거, 아기 방에 닿아 있는 거야!? 안, 안 돼읏……♥)
								ENDSELECT
							CASE 1
								PRINTFORML 「후으윽!? ♥ 아니야, 기분 좋지 않아……」
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「구우우, 깊숙이, 들어가고 있어……!」
							CASE 1
								PRINTFORML 「가장 깊숙한 곳, 맞고 있어...!」
						ENDSELECT
					ENDIF
					PRINTW 
					;異物感
				CASEELSE
					IF TALENT:恋慕 || TALENT:恋人
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「부탁해…… 찔러도 되니까, 상냥하게 해줘……」
							CASE 1
								PRINTFORML 리글은 입술을 깨물며 꿋꿋하게 통증과 이물감에 견디고 있다…
							CASE 2
								PRINTFORML 「거기…… 격하게 박아버리면 안 돼읏」
						ENDSELECT
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「아파앗...! 거긴 아직 무리야...」
							CASE 1
								PRINTFORML 「기분 안 좋아, 싫어앗... 그만해, 제발...」
						ENDSELECT
					ELSEIF TALENT:思慕
						PRINTFORML 「아, 아파읏, 안쪽이, 더 이상 넣지 마아앗」
					ELSE
						PRINTFORML 「으윽!!? 아, 아파! 그만둬, 야우읏」
					ENDIF
					PRINTW 
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
