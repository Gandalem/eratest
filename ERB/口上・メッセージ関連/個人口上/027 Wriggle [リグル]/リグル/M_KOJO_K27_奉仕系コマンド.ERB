@M_KOJO_MESSAGE_COM_K27_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:MASTER:形状 == 4
			PRINTFORML 「아......❤」
			PRINTFORML 「네 것... 핥거나 입에 물어도 되는 거구나... ❤ 알겠어... ❤」
			PRINTW 
			PRINTFORML 쿠풉, 르륵, 르로로록, 쭉, 주우우읏
			CALL HPH_PRINT,@"(왜일까…… 처음 하는데, 어쩐지 하는 법을 알 것 같아…… 후으)","L"
			CALL HPH_PRINT,@"(이렇게 하면 좋다고 본능이 가르쳐줘…… HPH)","L"
			PRINTW 
		ELSE
			PRINTFORML 「하아? 입으로 말이야?」
			PRINTFORML 「있잖아, 거기 소변도 나오는 곳이잖아요? 뭔가 싫은데……」
			PRINTFORML 「알았어. 하면 되는 거잖아? 히에엑, 억지로 밀어 넣지 마아」
			PRINTW 
			PRINTFORML 「하는 법 같은 건 잘 모르니까, 기분이 안 좋아도 실망하지 말아줘?」
			PRINTFORML 살짝, 살짝……
			PRINTFORML 「음, 이런 식으로 하면 괜찮을까? 끝부분을 물어서? 음, 흠…… 어렵네」
			PRINTW 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:MASTER:形状 == 4
		SELECTCASE ABL:舌
			CASE IS >= 5
				PRINTFORML %TEXTR("ぐぽっ❤　ぐぽっ❤　ぐぽっ❤　ぐぽっ❤/ぶぽっ　ぶぽっ　ぶぽっ　ぶぽっ/ぢゅずずずずううっっっ、ぶぽんっ❤/れるっ　れるれるっ　れるっ/「ん゛っ❤　ふーーっ❤　ふーーっ❤　ふうっ❤」/にゅにゅう～～～～、じゅるるるるるっっ！！/れろお～～～～～～～っ❤")%
				SELECTCASE RAND:5
