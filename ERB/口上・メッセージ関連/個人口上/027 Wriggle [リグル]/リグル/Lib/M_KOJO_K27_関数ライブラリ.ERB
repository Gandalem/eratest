;MASTERの恋人がその場に居るかどうか返す式中関数
;=-1 リグルが恋人 =0 元から恋人なし =1 その場に居ない =2 恋人と同席

@K27_FIND_LOVER()
#FUNCTION
RETURNF FIND_LOVER(27) ;custom code
SIF TALENT:MASTER:恋人 == 0
	RETURNF 0
SIF TALENT:恋人
	RETURNF -1
LOCAL = TALENT:MASTER:恋人
SIF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
	RETURNF 2
RETURNF 1
