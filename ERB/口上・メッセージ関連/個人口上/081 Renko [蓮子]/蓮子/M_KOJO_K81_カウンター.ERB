RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K81_51_1
;出す直前
IF BASE:PLAYER:2 > 8000
	;精液中毒4以上
	IF ABL:精液中毒 > 4
		IF RAND:3 == 0
			PRINTFORMW 「음, 음~~%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추기고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%츄읍%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 교묘하게 그것을 재촉하고 있다.
			PRINTFORMW (아앗……이 맛, 좋아……%UNICODE(0x2665) *1%)
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 능숙하게 움직여 그것을 재촉하고 있다.
			PRINTFORMW (안 돼앳…… 자지 냄새와 맛 때문에 아무것도 생각할 수 없어……%UNICODE(0x2665) *1%)
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응... 음...」
			PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추기고 있다.
			PRINTFORMW (빨리 사정하렴... %UNICODE(0x2665) *1%)
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응... 빨리 사정해줘」
			PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀 사용으로 능숙하게 그것을 재촉하고 있다.
		ELSE
			PRINTFORMW 「んん읏%UNICODE(0x2665) *1%ん～%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 촉진하고 있다.
		ENDIF
	ENDIF
	;舌3以上
ELSEIF ABL:舌 > 2
	;精液中毒4以上
	IF ABL:精液中毒 > 4
		IF RAND:3 == 0
			PRINTFORMW 「음... %UNICODE(0x2665) *1%음응! %UNICODE(0x2665) *1%」
			PRINTFORMW 「빨리 사정해 줘... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 더 해%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「……그렇게 쳐다보지 마, 바보 같은 얼굴로 자지를 빨고 있는 모습 같은 건 말이야앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%응으읏%UNICODE(0x2665) *1%」
			PRINTFORMW (자지를 기쁘게 해주지 않으면……%UNICODE(0x2665) *1%)
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음~…… 익숙하지 않은 맛이네」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 짜네.」
		ELSE
			PRINTFORMW 「응, 응... 어때? 내 혀 사용은? 익숙하잖아」
		ENDIF
	ENDIF
	;それ以外
ELSE
	IF RAND:3 == 0
		PRINTFORMW 「음... 음음... 쪽」
		PRINTFORMW (왜 플랭크 수준의 두뇌를 가진 내가 이런 일을...)
	ELSEIF RAND:2 == 0
		PRINTFORMW 「……응윽……으르륵」
	ELSE
		PRINTFORMW 「……쪽……응……」
	ENDIF
ENDIF
