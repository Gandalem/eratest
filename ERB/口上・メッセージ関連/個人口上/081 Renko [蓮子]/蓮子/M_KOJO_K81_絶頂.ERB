; Modular ERB: 個人口上/081 Renko [蓮子]/蓮子/M_KOJO_K81_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K81
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSE
		PRINTFORMW 「음응%UNICODE(0x2665) *1%」
		PRINTFORMW 「……가슴으로 느끼고 있구나……나에게」
	ENDIF
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
;-------------------------------------------------
;五重絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF NOWEX:五重絶頂
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「으읏%UNICODE(0x2665) *1%으어어읏%UNICODE(0x2665) *1%응으읏%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 말이 되지 않는 교성을 흘리며 엄청난 쾌락에 몸을 떨고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「으읏%UNICODE(0x2665) *1%응응응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 목소리조차 되지 않는 교성을 내지르며 엄청난 쾌락에 몸을 떨고 있다.
		ELSE
			PRINTFORMW 「으읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%응으으읏%UNICODE(0x2665) *1%」
			PRINTFORMW 렌코는 목소리조차 되지 않는 교성을 내지르며 엄청난 쾌락에 몸을 떨고 있다.
		ENDIF
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;四重絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF NOWEX:四重絶頂
	;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:5 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:4 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1% 으앗%UNICODE(0x2665) *1%」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「앙읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;三重絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF NOWEX:三重絶頂
	;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:5 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%아앗%UNICODE(0x2665)*1%오옷%UNICODE(0x2665) *1%오옷%UNICODE(0x2665) *1%」
	ELSEIF RAND:4 == 0
		PRINTFORMW 「아앗%UNICODE(0x2665) *1% 앙%UNICODE(0x2665) *1%」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「으으읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「아아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%안돼앳%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「으응%UNICODE(0x2665) *1%으응%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;二重絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF NOWEX:二重絶頂
	;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:5 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%기다려엇%UNICODE(0x2665) *1%안 돼앳%UNICODE(0x2665) *1%」
	ELSEIF RAND:4 == 0
		PRINTFORMW 「읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「아앗%UNICODE(0x2665) *1%안 돼앳%UNICODE(0x2665) *1%앗%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
IF NOWEX:Ｃ絶頂
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:5 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1% 간지러워앗%UNICODE(0x2665) *1%」
	ELSEIF RAND:4 == 0
		PRINTFORMW 「거기잇%UNICODE(0x2665) *1% 민감하단 말이야아%UNICODE(0x2665) *1%」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「거기는앗%UNICODE(0x2665) *1%안 돼엣%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「읏%UNICODE(0x2665) *1% 으으읏%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
IF NOWEX:Ｖ絶頂
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF TEQUIP:50 == MASTER && TEQUIP:MASTER:コンドーム == 0
		IF RAND:5 == 0
			PRINTFORMW 「안돼앳%UNICODE(0x2665) *1%생자지로 가앗%UNICODE(0x2665)*1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 간다앗%UNICODE(0x2665) *1% 으응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「으응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TEQUIP:50 == MASTER
		IF RAND:5 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665)*1%좋아앗%UNICODE(0x2665) *1%좋아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%이거%UNICODE(0x2665) *1%좋아%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%앙%UNICODE(0x2665) *1%응%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 읏%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 안돼앳%UNICODE(0x2665)*1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%오읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 오옷%UNICODE(0x2665) *1% 으앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%좀 더엇%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「앙읏%UNICODE(0x2665) *1% 응앗%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
IF NOWEX:Ａ絶頂
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:5 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%오오읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:4 == 0
		PRINTFORMW 「엉덩이……%UNICODE(0x2665) *1%안 돼……%UNICODE(0x2665) *1%」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「앙읏%UNICODE(0x2665) *1%응앗%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
IF NOWEX:Ｂ絶頂
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:5 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
	ELSEIF RAND:4 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1% 안돼앳%UNICODE(0x2665) *1%」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「거기앗%UNICODE(0x2665) *1%민감하단 말이야앗%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「응읏%UNICODE(0x2665) *1%응응읏%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「아앗%UNICODE(0x2665) *1%으응읏%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
IF NOWEX:Ｍ絶頂
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 렌코는 절정에 달했다.
	ELSEIF RAND:3 == 0
		PRINTFORMW 「음~윽%UNICODE(0x2665) *1%」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「음~~~앗%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORMW 「음~~~~~ %UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K81
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
