;==================================================

@M_KOJO_MESSAGE_COM_K81_368
CALL M_KOJO_MESSAGE_COM_K81_368_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			IF CFLAG:318 == 1
				PRINTFORMW 「...징그러워」
			ELSEIF TFLAG:193 == -1
				PRINTFORMW 「글쎄? 무슨 생각을 하는 걸까.」
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「어디까지 주관적인 관측 결과 속에서 무엇이 진실인지 모르겠어, 주간의 바깥쪽에 진실이 있는데」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「가짜라고 해서 진짜보다 못할 리는 없어, 나도 그렇게 생각해.」
				ELSE
					PRINTFORMW 「음, 이 근처에는 귀여운 옷이 팔고 없는 것 같아.」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「메리라는 애는 알고 보면 힘이 세지만 평소에 뭘 먹고 있을까? 합성 단백질?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「메리의 가슴은 왜 큰 걸까? 인종 차이일까?」
				ELSE
					PRINTFORMW 「어떻게든 밖에 나갈 수 없을까? 방이라는 의미가 아니라 말이야」
				ENDIF
			ENDIF
		CASE 2
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			IF CFLAG:318 == 1
				PRINTFORMW 「왜 너 같은 애랑...!」
				PRINTFORMW 렌코는 화를 내며 식사를 하고 있다.
			ELSEIF TALENT:恋慕
				PRINTFORMW 「애써 만든 요리니까 즐기자♪」
			ELSE
				PRINTFORMW 「모처럼 왔으니 %CALLNAME:MASTER%도 먹으면 좋겠네」
			ENDIF
		CASE 4
			;▼掃除［掃除を手伝う］
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			IF CFLAG:318 == 1
				PRINTFORMW 「더러운 손으로 만지지 마요... 정말이지.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「그렇네, 나보다 청소가 능숙하니까 부탁할게」
			ELSE
				PRINTFORMW 「아, 그러고 보니 그거 어디 갔지?」
			ENDIF
		CASE 5
			;▼運動［一緒に運動する］
			;※[音楽知識]持ちは除く（演奏になる）
			IF CFLAG:318 == 1
				PRINTFORMW 「……변태!」
				PRINTFORMW 렌코는 땀에 젖은 셔츠의 가슴 부분을 벌리며 그렇게 말했다.
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「하아……덥다……」
					PRINTFORMW 렌코는 땀에 젖은 셔츠의 가슴 부분을 벌리며 그렇게 말했다.
				ELSEIF RAND:2 == 0
					PRINTFORMW 「음... 힘들다... 아무래도 본격적으로 운동하면 피곤하네」
					PRINTFORMW 렌코는 땀에 젖은 셔츠의 가슴팍을 벌리며 그렇게 말했다.
				ELSE
					PRINTFORMW 「음… 물 마시게 해줘…」
					PRINTFORMW 렌코는 땀에 젖은 셔츠의 가슴 부분을 벌리며 그렇게 말했다.
				ENDIF
			ENDIF
		CASE 6
			;▼読書［本の感想を聞く］
			;TFLAG:193,-1=集中していて返事してくれない
			IF CFLAG:318 == 1
				PRINTFORMW 「……」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 것을 무시하고 있다.
			ELSEIF TFLAG:193 == -1
				PRINTFORMW 「......아, 그래, 지금 읽고 있는 중이니까.」
				PRINTFORMW 렌코는 무심한 대답을 했다.
			ELSE
				PRINTFORMW 「응, 꽤 흥미로웠어! 특히――」
				PRINTFORMW 렌코의 이야기는 길게 이어질 것 같다……
			ENDIF
		CASE 7
			;▼料理［料理を手伝う］→［料理を分けてもらう］
			;TFLAG:193,2=料理を手伝う,0=作った料理を食べる,-1==MASTERはお腹が空いてなかった（食べる時）
			IF TFLAG:193 == 2
				IF CFLAG:318 == 1
					PRINTFORMW 「기분 나쁘니까 혼자 만들어 있어」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「둘이 나란히 있으니까 연인 같네」
				ELSE
					PRINTFORMW 「헤에, 잘하네, 이런 거」
				ENDIF
			ELSE
				IF CFLAG:318 == 1
					PRINTFORMW 「멋대로 먹어버려라……」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「자, 아~ 해봐 %UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「둘이서 만든 거니까 분명 맛있을 거야」
				ENDIF
			ENDIF
		CASE 9
			;▼採集［採集を手伝う］
			IF CFLAG:318 == 1
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 빼앗기고 싶지 않은데」
			ELSE
				PRINTFORMW 「여러 곳에 여러 가지 것이 있구나, 그래 예를 들면 여기에도...」
			ENDIF
		CASE 10
			;▼釣り［一緒に釣りをする］
			;TFLAG:193,-1=釣り竿がなくて見てるだけ
			IF CFLAG:318 == 1
				PRINTFORMW 「흐음, 둘 다 쓸 데가 없는데 말이지」
			ELSE
				PRINTFORMW 「큰 물고기 잡으면 알려줘.」
			ENDIF
		CASE 11
			;▼実験［実験を手伝う］
			IF CFLAG:318 == 1
				PRINTFORMW 「사양 없이 인체 실험을 하게 해 주마.」
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「헤에, 같이 있어도 괜찮구나. 그럼 거기 앉아 줄래?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이건 정체불명의 신사에서 얻은 미지의 오미즈(부적)인데, 달아줄래?」
				ELSE
					PRINTFORMW 「그럼 꿈의 세계를 우리는 공유할 수 있는 걸까, 실험에 함께 해 줄래?」
				ENDIF
			ENDIF
		CASE 12
			;▼のんびり［一緒にのんびりする］
			IF CFLAG:318 == 1
				PRINTFORMW 「...징그러워」
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「뭐, 이런 때일수록 재미있는 아이디어가 떠오르는 거야.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이렇게 하고 있으면 마음이 편안해지네, 이상한 파동이라도 나오고 있나?」
				ELSE
					PRINTFORMW 「저기, 나를 느끼고 있어?」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「뇌를 쉬게 하는 것도 재능 중 하나야」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「붉게 물드는 것도 나쁘지 않네」
				ELSE
					PRINTFORMW 「세상에 여유가 있으니까 느긋하게 지낼 수 있어」
				ENDIF
			ENDIF
		CASE 13
			;▼晩酌［晩酌に付き合う］
			;※酒耐性0以上のみ
			IF CFLAG:318 == 1
				PRINTFORMW 「……」
				PRINTFORMW 렌코는 무표정으로 반주를 마시고 있다.
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「건배♪」
					PRINTFORMW 렌코는 뺨을 물들이며 한잔하고 있다.
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 마시면 취해버리잖아 %UNICODE(0x2665) *1%」
