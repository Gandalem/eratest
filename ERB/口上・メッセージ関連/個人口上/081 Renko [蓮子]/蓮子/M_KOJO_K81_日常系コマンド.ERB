;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K81_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K81_301
CALL M_KOJO_MESSAGE_COM_K81_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「너 무슨 신경으로 그러는 거야......」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「...... 뭐, 일본차일지도.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「메리가 우려낸 게 더 맛있네요」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「내가 모범을 보여줄까?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……다음부터는 스스로 우릴게」
		ELSE
			PRINTFORMW 「......어떻게 이런 맛이 나는 걸까......」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「쭉... 헤에, 잘하는구나」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「꾸욱... 천연물은 맛이 다르네.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후루룩... 꽤 괜찮은 다도구나」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「고마워, 받을게」
		ELSE
			PRINTFORMW 「후우... 마음이 진정되네, 일본인이니까 그럴까?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
