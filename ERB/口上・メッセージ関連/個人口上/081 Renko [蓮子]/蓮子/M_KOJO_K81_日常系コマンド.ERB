;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K81_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K81_302
CALL M_KOJO_MESSAGE_COM_K81_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「잠깐 멈춰줘!」
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「헤에, 이런 미녀에게 등을 맡고 긴장하고 있는 거야?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「자, 노천탕에서 같이 있잖아요. 더 놀아요.」
		ELSE
			PRINTFORMW 「헤에...... %조사처리(CALLNAME:MASTER,"의")% 몸은...... 후우」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「음, 더 세게 주물러도 괜찮아.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좀 어디 만지는 거야...... 딱히 상관없지만......」
		ELSE
			PRINTFORMW 「아하하하! 이상한 곳 만지지 마, 기분이 좋아지잖아%UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「그런 거라면…… 보답해 줄게?」
			PRINTFORMW 렌코는 그렇게 말하며 안아오고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응, 좀 격렬하네……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응, 간지러워.」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「......지금 이상한 곳 만졌어?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「뭐야, 간지러운데?」
		ELSE
			PRINTFORMW 「덥네, 메리 같아.」
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「그렇게 만지고 싶다면 그런 가게에라도 가보지 그래?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……이걸로 괜찮아?」
		ELSE
			PRINTFORMW 「메리가 아니니까……」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「속셈이 다 드러나 보이네?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좀 기분 나빠...」
		ELSE
			PRINTFORMW 「......뭐 하는 거야」
		ENDIF
	ENDIF
ENDIF
RETURN 1
