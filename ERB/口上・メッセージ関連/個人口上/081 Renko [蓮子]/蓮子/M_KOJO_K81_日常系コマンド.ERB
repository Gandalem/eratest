;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K81_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K81_300
RETURN 1

@M_KOJO_MESSAGE_COM_K81_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K81_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 이야기할 생각은 없는데, 모르겠어?」
		PRINTFORMW 렌코는 분노가 담긴 목소리로 대답했다.
		;会話不能
	ELSEIF TCVAR:302
		PRINTFORMW 「……그렇네, 메리라면 뭐라고 말할까나」
		PRINTFORMW 렌코는 말이 없어졌다.
		;ミニマップ時のみ
		;条件をメインマップ時にできなくもないけど面倒
		;現在位置が墓
	ELSEIF CFLAG:MASTER:現在位置 == 150
		IF RAND:5 == 0
			PRINTFORMW 「결계 폭파도 비봉부 활동이야!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「메리는 싫어하지만 이런 곳에야 해답이 있는 거야.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「사람의 의식이 전자산으로밖에 없다면 이곳은 더 소란스러울 터야!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「영감은 없는 편이지만 어쩐지 사람의 기척이 느껴지네」
		ELSE
			PRINTFORMW 「묘지 참이라 해도 여기에 나의 조상은 있을 리가 없잖아?」
		ENDIF
		;現在位置が竹林入り口
	ELSEIF CFLAG:MASTER:現在位置 == 410
		IF RAND:5 == 0
			PRINTFORMW 「메리가 꿈에서 대나무 숲 안에 있었다고 들었는데, 여기일까?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「헤에, 어디까지나 길을 잃어버릴 것 같네.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「천연의 죽순 같은 건 좀 보기 힘든 거네요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「한 번 와보고 싶었어. 이야기만은 듣고 있었으니까.」
		ELSE
			PRINTFORMW 「불다루미의 소녀... 불쥐의 가운... 분명 메리가 본 것은 카구야 공주야!」
		ENDIF
		;現在位置が彼岸
	ELSEIF CFLAG:MASTER:現在位置 == 640
		IF RAND:5 == 0
			PRINTFORMW 「메리는 피안화를 싫어하는 것 같아.」
			PRINTFORMW 「왜일까? 어울린다고 생각하는데.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「나는 천국에 갈 거야. 지옥은 여기서도 갈 수 있는 것 같고 말이야」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「삼도의 강도 수학적으로 계산할 수 있다니, 누구한테 들었더라」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「여기(곳)도 재정난이라고 들었는데 세상이 참 힘들다니까, 뭔가 할 수 있는 일은 없을까?」
		ELSE
			PRINTFORMW 「이렇게 좋은 기회인데 연마님께 인사드러요」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「너무 보지 마, 메리랑 비교당하면 부끄럽잖아」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후우... 좋은 목욕이네...」
		ELSE
			PRINTFORMW 「나체로 지내는 것도 좋은 거네」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「이 세계도 봄은 화창하네」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「죽순은 지금이 제철이네, 천연물이 여기에 있다는 걸 들었는데……」
					ELSE
						PRINTFORMW 「큰 벚꽃나무를 본 적이 있어, 마치 꿈 같은 풍경이었지」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「아츠... 민소매로 하길 잘했어...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「수영복 안 가져왔네…… 뭐 아는 사람이 메리밖에 없으니 괜찮지만」
					ELSE
						PRINTFORMW 「여름은 어쩔 수 없이 덥네……. 지옥의 가마도 달궈졌을까?」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「가을이 되어 시원해져서 다행이야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「일본다운 계절이 되었네, 메리도 아마 만끽하고 있겠지」
					ELSE
						PRINTFORMW 「단풍은 신께서 손으로 그리고 계신 거였나? 신이라기보다는 마치 풍경화가 같네」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「추운 계절이 되어 왔지만 난방 기구는 이불 이상의 것은 없네요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「눈이 내리는 날은 술을 마시며 보내는 게 최고지.」
					ELSE
						PRINTFORMW 「코타츠에 나베라 고전적이지만 멋있지 않아?」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 보는 풍경을 나도 볼 수 있어서 행복해」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 내가 보는 풍경을 보고 어떻게 생각했어?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「가상현실이 현실에서 이길 수 없는 도리는 없어, 적어도 %조사처리(CALLNAME:MASTER,"는")% 멋지잖아?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 있으면 마음이 놓여져서 말이야, 왜일까? 그런 입자라도 나오고 있는 걸까?」
					ELSE
						PRINTFORMW 「내 눈에는 장소와 시간이 다 보인다」
						PRINTFORMW 물론 여기가 어디인지는 말할 것도 없지
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「우주에는 로망이 있지만 이 세계에도 무한한 관측 외의 세계가 펼쳐져 있어서 멋지네」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「물질의 구성 단위를 최소 단위까지 거슬러 올라가면 %CALLNAME:MASTER%도 나도 똑같으니까, 당연히 상성이 좋은 거야」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「관측 물리학의 세계는 이미 철학적으로 변해버렸지만 이 세상에 퍼지는 것은 아직 관측할 수 없는 거야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「합성란이랑 합성딸기랑 우리, 어떻게 다를까?」
					ELSE
						PRINTFORMW 「%CALLNAME:MASTER%도 같이 동인지 만들자, 분명 즐거울 거야!」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「모든 것이 서로 영향을 주고 있다면 주관 따위는 문제가 아니야, 객관이야말로 세계를 만들어가는 거야.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「천국이랑 지옥, 둘 다 가보고 싶네」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「메리의 눈도 나의 눈도 이상한 것을 볼 수 있는데, %조사처리(CALLNAME:MASTER,"의")% 눈은?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「하지만 이곳은 메리의 꿈과는 다른 것 같네.」
					ELSE
						PRINTFORMW 「천연 재료들뿐이라 술도 잘 넘기네」
					ENDIF
				ELSEIF CFLAG:2 >= 500
					IF RAND:5 == 0
						PRINTFORMW 「우주의 끝에는 무엇이 있을까? 아주 멀리 가보고 싶네」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「고대의 토리이(鳥居)는 안과 바깥을 가르는 결계지만, 동시에 토리이끼리 연결하는 워프존이기도 해.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「코스믹 호러든 뭐든 그렇지만 관측 한계 너머에는 지루한 현실뿐이야」
						PRINTFORMW 「그래서 나는 꿈을 꾸는 거야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 꿈과 현실에 유의미한 차이는 없지, 사람은 상상함으로써 세상을 계속 관측해 왔는데 말이야
					ELSE
						PRINTFORMW 「오래된 술만 있는 것도 재미있네」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「비봉클럽에 들어가고 싶어? 안 돼, 우리 사이를 갈라놓으려고 하다니」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「메리는 비관주의자지만, 나는 로맨티스트야. 꿈이 있거든.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「へえ？何？ナンパ？」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이 근처 산책은 이미 마쳤어.」
					ELSE
						PRINTFORMW 「냄새도 나고 소리도 들려, 꿈이 아니겠지~」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
