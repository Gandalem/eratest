;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先にキスぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外 98=口上内特殊判定による失敗 99=口上内特殊判定による成功
;口上内特殊判定は該当するCFLAGが0だと無効
;==================================================

@M_KOJO_MESSAGE_COM_K81_350
CALL M_KOJO_MESSAGE_COM_K81_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORML 
	ELSEIF TFLAG:194
		SELECTCASE TFLAG:194
			CASE 1
				PRINTFORMW 「좀 너무 흥분했잖아...」
			CASE 2
				PRINTFORMW 「청간 취미는 가지고 있지 않아, 유감이야」
			CASE 3
				PRINTFORMW 「메리라면 몰라도 난잡한 관계 같은 건 사랑이 없어.」
			CASE 4
				PRINTFORMW 「정말이지... 분위기도 만들지 못하는 최악의 남자네」
		ENDSELECT
	ELSEIF TCVAR:抱き寄せ初回
		SELECTCASE TCVAR:抱き寄せ初回
			CASE 1
				PRINTFORMW 「헤에... 나를 범할 만한 가치는 있구나... %UNICODE(0x2665) *1%」
			CASE 2
				PRINTFORMW 「......키스 정도는 해봐, 벌써...」
			CASE 3
				PRINTFORMW 「……최악이야……%UNICODE(0x2665) *1%」
			CASE 4
				PRINTFORMW 「んん읏%UNICODE(0x2665) *1%……ん～%UNICODE(0x2665) *1%」
			CASE 5
			CASE 6
				PRINTFORMW 「그런 건 연인끼리 하는 거야.」
			CASE 7
				PRINTFORMW 「바로 그런 생각 하는 거 싫어.」
			CASE 8
				PRINTFORMW 「그만둬!」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 뺨을 때렸다.
		ENDSELECT
	ELSE
		IF TALENT:恋人
			IF RAND:3 == 0
				PRINTFORMW 「음... 나도 그런 기분이었어 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음……%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「결국 신체적인 유대감이 가장 강한 거잖아」
			ENDIF
		ELSEIF TALENT:恋慕
			IF RAND:3 == 0
				PRINTFORMW 「이러다 바보가 되어버릴 거야…… %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「오늘은 다정하게 대해줘……%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「뭐든지 해도 좋지만 책임은 지는 거야 %UNICODE(0x2665) *1%」
			ENDIF
		ELSEIF TALENT:思慕
			IF RAND:3 == 0
				PRINTFORMW 「메리에게는 비밀이야?」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「좋아해 주는 게 좋아」
			ELSE
				PRINTFORMW 「음... 몸 깨끗이 씻었어?」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「……좋지만 책임져야 해.」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「어서 끝내버려.」
			ELSE
				PRINTFORMW 「……변태」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
