;304,仕事を手伝う
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:350(仕事内容(JOB_仕事内容.ERB参照のこと
;TCVAR:手伝えない(=2 手伝っても早くは終わらない、時間停止中不可 永琳の診察等)
;==================================================

@M_KOJO_SUCCESS_COM_K81_304
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K81_304
CALL M_KOJO_MESSAGE_COM_K81_304_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_304_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		;通常
