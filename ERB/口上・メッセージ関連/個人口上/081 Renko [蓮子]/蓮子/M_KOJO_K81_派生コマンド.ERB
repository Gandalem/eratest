@M_KOJO_MESSAGE_SCOM_K81_1
CALL M_KOJO_MESSAGE_SCOM_K81_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K81_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「서로를 깔보는 건 광대극이야」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응! %UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추기고 있다.
				PRINTFORMW 「음! %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「으응%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%으으응~읏%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 교묘하게 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「응%UNICODE(0x2665) *1%응~읏%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW 「……이 냄새, 좋아해%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응?」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀 사용으로 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW 「해버리면 되잖아 %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 점점 뭔가 나오고 있어...」 %UNICODE(0x2665) *1%
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추고 있다.
			ELSE
				PRINTFORMW 「응응읏%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추기고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「음... %UNICODE(0x2665) *1%음~... %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음음음음읏%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
				PRINTFORMW 「나의 혀 사용도 대단하지 않아%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「아앗%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음?」
				PRINTFORMW 「나도 좀 더 핥아주란 말이야%UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 응응%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「んん읏……읏%UNICODE(0x2665) *1%」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「ん……ん읏……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……응윽……앙윽……」
		ELSE
			PRINTFORMW 「……응윽……응윽……」
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K81_{SELECTCOM}_1
RETURN 1
