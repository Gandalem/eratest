@M_KOJO_EVENT_K81_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;仕事中、今日会ってない。
	IF CFLAG:行動 == 5 && !TCVAR:81:今日会ったか && GROUPMATCH(ARG, 1, 2, 6, 7) && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		PRINTFORMW 「아, 미안, 지금 바빠.」
		;今日会ってない。
	ELSEIF !TCVAR:81:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K81
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「……용건 같은 건 없는 것 같은데」
			ELSEIF TALENT:恋人
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 얼굴을 봐서 안심했어」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 우리들의 운명은 만나게 되어 있었던 거야?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%！」
					PRINTFORMW 렌코는 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
					PRINTFORMW 「드디어 찾았네, 어디에 있었던 거야?」
				ENDIF
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 잘 지냈네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 오늘도 컨디션이 좋아 보이네」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 오늘은 뭐 하고 있어?」
				ENDIF
			ELSEIF TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%、元気そうだけど何かあった？」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 재미있는 거라도 찾았니?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 안녕, 좋은 날이 되길 바라.」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「아라, %CALLNAME:MASTER%, 우연이네 이런 곳에서」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 만난 건 소립자의 이끌림일까나」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일이야. 드물게 보는 듯한 표정으로 왜 그래?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K81
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「……용건 같은 건 없는 것 같은데」
			ELSEIF TALENT:恋人
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 얼굴을 봐서 안심했어」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 우리들의 운명은 만나게 되어 있었던 거야?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%！」
					PRINTFORMW 렌코는 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
					PRINTFORMW 「드디어 찾았네, 어디에 있었던 거야?」
				ENDIF
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 잘 지냈네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 오늘도 컨디션이 좋아 보이네」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 오늘은 뭐 하고 있어?」
				ENDIF
			ELSEIF TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%、元気そうだけど何かあった？」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 재미있는 거라도 찾았니?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 안녕, 좋은 날이 되길 바라.」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「아라, %CALLNAME:MASTER%, 우연이네 이런 곳에서」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 만난 건 소립자의 이끌림일까나」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일이야. 드물게 보는 듯한 표정으로 왜 그래?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;風呂のやつって浴場で遭遇と違うのかわからん
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF TALENT:恋人
				PRINTFORMW 「아아, %CALLNAME:MASTER%쪽이 먼저였네」
				PRINTFORMW 「상관없어, 연인이니까~♪」
			ELSEIF TALENT:恋慕
