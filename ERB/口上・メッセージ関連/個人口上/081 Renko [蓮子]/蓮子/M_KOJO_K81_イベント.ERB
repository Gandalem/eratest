@M_KOJO_SPEVENT_K81_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
IF LOCAL
	PRINTFORMW 「%CALLNAME:MASTER%, 잠깐 괜찮을까?」
	PRINTFORMW 돌아보는 동작으로 머리카락을 살짝 헤치며 그녀는 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 조심스럽게 손을 뻗었다.
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 눈, 언제나 섬뜩해」
	PRINTFORMW 그렇게 말하며 그녀는 %조사처리(CALLNAME:MASTER,"의")% 입술에 키스했다.
	PRINTFORMW 「음... 하지만 키스는 기분 좋네」
	PRINTFORMW 그녀는 그렇게 말하며 등 뒤로 손을 돌려 살짝 몸을 숙인 자세로 이쪽의 상황을 살피고 있다.
	PRINTFORMW 「어땠어? 나의 키스, 처음이거든?」
	PRINTFORMW 부끄러운 듯 수줍게 웃던 그녀는 그대로 발길을 돌려 가버렸다.
	PRINTFORMW 「맞아, 이거 메리한테는 비밀이니까 말이야!」
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K81_2
RETURN 1

@M_KOJO_SPEVENT_K81_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1081)
			PRINTFORMW 「%CALLNAME:MASTER%, 잠깐 할 말이 있는데」
			PRINTFORMW 렌코는 평소와 달리 긴장한 말투로 말을 걸어왔다.
			PRINTFORMW 「나, %조사처리(CALLNAME:MASTER,"를")% 좋아해」
			PRINTFORMW 「언제든 내 마음을 신경 써주는 점도 다른 사람에게 다정한 점도 전부 좋아」
			PRINTFORMW 「어떤 때라도 나는 %CALLNAME:MASTER%에 대해 생각하게 되어 버렸어」
			PRINTFORMW 「이렇게 누군가를 생각하는 시기가 올 거라고는 상상도 못 했어!」
			PRINTFORMW 「사실은 참아야 하는 게 나을지도 모르겠지만, 독차지하고 싶어졌어」
			PRINTFORMW 「%CALLNAME:MASTER%, 나의 연인이 되어주지 않을래?」
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%、私と恋人になるのはどうしてもダメ？」
			PRINTFORMW 렌코는 다시 고백해왔다.
			PRINTFORMW 「私と%CALLNAME:MASTER%の運命の赤い糸は誰にも切れないのよ？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「고마워, %CALLNAME:MASTER%」
		PRINTFORMW 「살아있는 모든 생명 속에서 우리의 운명은 맺어진 인연이었단다」
		PRINTFORMW 「어떻게 미립자들 간의 움직임이 있었든 이 묶인 붉은 실만은 말이야」
		PRINTFORMW 그렇게 말하며 그녀는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 유심히 바라보았다.
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 얼굴, 달을 보는 것보다 훨씬 멋져」
		PRINTFORMW 렌코는 그대로 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗고 만족스러운 듯 미소 지었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「어라? 예상 밖이네……」
		PRINTFORMW 렌코는 그렇게 말하며 조금 이상하다는 듯하고 있다.
		PRINTFORMW 「플랭크 수준의 두뇌인 나를 버리겠다는 각오를 해야 할 거야?」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K81_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「잘 가!!!」
			PRINTFORMW 렌코는 화를 내며 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「오늘은 이제 돌아가지만, 바람 피우면 안 돼?」
			PRINTFORMW 렌코는 아쉬워하며 헤어졌다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「돌아갈래, 돌아가면 또 만날 수 있겠지」
		ELSEIF TALENT:思慕
			PRINTFORMW 「그럼, 메리가 기다리고 있으니 돌아갈게.」
		ELSE
			PRINTFORMW 「그럼, 잘 가」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
