			ELSE
				PRINTFORMW 「아차, 들어와 있었나……. 뭐 괜찮아, 등 정도는 씻겨 줄게.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			IF TALENT:恋人
				PRINTFORMW 「이런 미녀와 온탕에서 목욕할지도 모른다고 조금은 기대하고 있었나?」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「어쩔 수 없으니, 잠시 기다릴 테니 어서 올라가렴」
			ELSEIF TALENT:思慕
				PRINTFORMW 「미안 미안, 들어있는지 확인을 못 했어」
			ELSE
				PRINTFORMW 「……실례했어요~」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			IF TALENT:恋人
				PRINTFORMW 「혼욕은 다음에 하자%UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「미안해, 지금 혼자 들어가고 싶어!」
			ELSEIF TALENT:思慕
				PRINTFORMW 「미안하지만 나 혼자 있게 해 줄래?」
			ELSE
				PRINTFORMW 「자, 어서 올라가라, 빨리 올라가.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K81
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「……용건 같은 건 없는 것 같은데」
			ELSEIF TALENT:恋人
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 얼굴을 봐서 안심했어」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 우리들의 운명은 만나게 되어 있었던 거야?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%！」
					PRINTFORMW 렌코는 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
					PRINTFORMW 「드디어 찾았네, 어디에 있었던 거야?」
				ENDIF
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 잘 지냈네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 오늘도 컨디션이 좋아 보이네」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 오늘은 뭐 하고 있어?」
				ENDIF
			ELSEIF TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%、元気そうだけど何かあった？」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, 재미있는 거라도 찾았니?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 안녕, 좋은 날이 되길 바라.」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「아라, %CALLNAME:MASTER%, 우연이네 이런 곳에서」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 만난 건 소립자의 이끌림일까나」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일이야. 드물게 보는 듯한 표정으로 왜 그래?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			;怒り
			IF CFLAG:318 == 1
				PRINTFORMW 「……뭐야, 눈빛을 그렇게 보내고」
				;怒り 恋慕時 デート相手がメリー
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 82
				PRINTFORMW 「내가 쓸모없어졌으니 비꼬는 거잖아!?」
				;恋慕時 デート相手がメリー
			ELSEIF TALENT:恋慕 && ARG:1 == 82
				PRINTFORMW 「……정신 나갈 것 같아……」
			ELSEIF TALENT:恋人
				PRINTFORMW 「……그런 짓을 하는 거구나」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「……뭐, 남의 연애사에 신경 쓸 리가 없지」
			ELSEIF TALENT:思慕
				PRINTFORMW 「그런 사람이 있는 거구나%CALLNAME:MASTER%」
			ELSE
				PRINTFORMW 「헤에, 그렇구나-」
				PRINTFORMW 렌코는 살짝 히죽거리며 이쪽을 바라보고 있다.
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
