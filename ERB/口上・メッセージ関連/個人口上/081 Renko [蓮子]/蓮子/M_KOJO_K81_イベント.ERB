@M_KOJO_EVENT_K81_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORMW 「이제 무리야... 지쳤어...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		PRINTFORMW 「응, 이제 됐어……%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORMW 「んん！？…もう無理なのに……%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORMW 「もう！じゃあ覚悟してよね……%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デイリーイベント2,夢精
;濃厚精液状態で発生
;▼地の文--------------------------------------------------
;【MASTER】が夢精で汚した下着を洗っていると【TARGET】が飛んできた！
;【TARGET】はそんなもの他の洗濯物と一緒に洗わないでと抗議すると、【MASTER】の手に収まった下着をふんだくり戻っていった…
;【TARGET】　欲情の珠＋1000
;==================================================

@M_KOJO_DAILY_EVENT_K81_2(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
;地の文を変えたければコメントアウト
;※コメントアウトすると欲情の珠＋1000（JUEL:11 += 1000）もカットされるので注意
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	IF TALENT:恋慕
		PRINTFORMW 「아, 정말이지, 내가 빨 테니 빌려줘!」
		PRINTFORMW 렌코는 그렇게 말하며 %CALLNAME:MASTER%속옷을 가져가 버렸다.
		PRINTFORMW 「……후우……정말이지 %UNICODE(0x2665) *1%」
		PRINTFORMW 그녀는 %조사처리(CALLNAME:MASTER,"의")% 정액이 묻은 속옷에 얼굴을 묻고 황홀해하고 있었다.
	ELSE
		PRINTFORMW 「으윽... 최악이야...!」
		PRINTFORMW 렌코는 얼굴을 찡그리며 %조사처리(CALLNAME:MASTER,"의")% 팬티를 버렸다.
	ENDIF
ENDIF
RETURN 1
