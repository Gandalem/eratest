@M_KOJO_EVENT_K81_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%! 놀러 가시죠!」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 시간 되면 결계 폭파하러 가지 않을래?
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%、デートしない？」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 잠깐 같이 있어 줄래?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「이 앞의 멋진 장소를 찾았어, %조사처리(CALLNAME:MASTER,"랑")% 가고 싶어서 말이야♪」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「자, 어느 결계에 가서 볼까요?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「모처럼의 데이트니까 즐겨야지.」
				ELSE
					PRINTFORMW 「...메리도 초대할 걸 그랬나」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「음, 그럼 다음에 말이야...」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「어라? 흥미 없어 보이네?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「헤에, 내 유혹을 거절하다니 말이야」
				ELSE
					PRINTFORMW 「그럼 메리를 유혹해 볼까요?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%、ねえ私の部屋に来ない？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 보여주고 싶은 게 있는데」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%, 좀 가까이 와 줄래?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%、暇なら寄ってくる？」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「괜찮아? 오늘 밤은 재우지 않을 테니까%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「좋은 걸 발견했어, 꿈속에서 말이야」
				ELSEIF TALENT:思慕
					PRINTFORMW 「……이상한 기대는 하지 말아줘?」
				ELSE
					PRINTFORMW 「기왕 온 김에 차라도 대접할게.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「헤에, 다른 용무가 있는 거야?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「…다음에 기회로 할게.」
				ELSEIF TALENT:思慕
					PRINTFORMW 「애들 방에 들어올 수 있는데 융통성이 없네.」
				ELSE
					PRINTFORMW 「어라? 메리라면 기꺼이 들어갈 텐데」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;脱衣口上
;==================================================

@M_KOJO_EVENT_K81_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORMW 「자, %CALLNAME:MASTER%도 벗으란 말이야!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORMW 「응, 부끄럽네...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORMW 「정말, 성급하긴……!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「그렇네, 그럼 교환이지」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「좋아, 내 속옷으로 실컷 해 봐?」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「네에...? 괜찮지만...」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「뭘 쓸 작정이야……」
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
