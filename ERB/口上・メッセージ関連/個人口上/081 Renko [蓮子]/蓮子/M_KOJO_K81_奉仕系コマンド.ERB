;==================================================
;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K81_80
CALL M_KOJO_MESSAGE_COM_K81_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「이런 건 주지 말아줘……」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「헤에? 이런 걸로 사정하는구나」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응... 냄새나」
		ELSE
			PRINTFORMW 「어서 사정하렴……」
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:3 == 0
			PRINTFORMW 「흥, 뭐 익숙해졌지」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「빨리 사정하면 되는 거잖아」
		ELSE
			PRINTFORMW 「왠지 조금 귀여울지도...」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「자, 어서 거 꺼내.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「우와... 커지고 있어...」
		ELSE
			PRINTFORMW 「...... 이런 바다 생물 같네」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K81_81
CALL M_KOJO_MESSAGE_COM_K81_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K81_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「왜 이런 곳까지 와서 남자의 거시기(성기)를 핥아야 하는 거지...」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「음, 음~~%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추기고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응읏%UNICODE(0x2665) *1%츄읏%UNICODE(0x2665) *1%응응읏%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW (아아…… 이 맛 좋아……%UNICODE(0x2665) *1%)
			ELSE
				PRINTFORMW 「응읏%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀놀림으로 능숙하게 그것을 재촉하고 있다.
				PRINTFORMW (안 돼앗…… 자지 냄새와 맛 때문에 아무것도 생각할 수 없어……%UNICODE(0x2665) *1%)
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응... 음...」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추기고 있다.
				PRINTFORMW (빨리 사정하렴... %UNICODE(0x2665) *1%)
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응응... 빨리 사정해줘」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀 사용으로 능숙하게 그것을 재촉하고 있다.
			ELSE
				PRINTFORMW 「음응%UNICODE(0x2665) *1%음~%UNICODE(0x2665) *1%」
				PRINTFORMW 렌코는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 부추고 있다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				PRINTFORMW 「응……. %UNICODE(0x2665) *1%응응! %UNICODE(0x2665) *1%」
				PRINTFORMW 「빨리 사정해 줘……. %UNICODE(0x2665) *1%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「으응읏%UNICODE(0x2665) *1%낼름%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
				PRINTFORMW 「……너무 보지 마, 바보 같은 얼굴로 자지 빨고 있는 모습 같은 건 말이야앗%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「응응읏%UNICODE(0x2665) *1% 응응응읏%UNICODE(0x2665) *1%」
				PRINTFORMW (자지를 기쁘게 해주지 않으면……%UNICODE(0x2665) *1%)
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~…… 익숙하지 않은 맛이네」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 짜네.」
			ELSE
				PRINTFORMW 「응, 응... 어때? 내 혀 사용은? 익숙하잖아」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 음음... 쪽」
			PRINTFORMW (왜 플랭크 수준의 두뇌를 가진 내가 이런 일을...)
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……응윽……으르륵」
		ELSE
			PRINTFORMW 「……쪽……응……」
		ENDIF
	ENDIF
ENDIF
RETURN 1
