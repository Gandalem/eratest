;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「변태! 치한!」
		PRINTFORMW 렌코는 바시옷 %조사처리(CALLNAME:MASTER,"의")% 뺨에 뺨을 때렸다.
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K81_5_1
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「으응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「정말앗%UNICODE(0x2665) *1% 익숙해져 버렸어%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 그렇게 야하게 만지지 마요 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 이런 곳에서 치한 플레이라니... %UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응%UNICODE(0x2665) *1% 이상한 짓 하지 마……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
