		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		LOCAL:1 = M_KOJO_K103_KANKEI()
		SELECTCASE LOCAL:1
			CASE 10, 11, 12, 13, 21, 22, 23, 24
				;特別な感情は抱いていない時
				SELECTCASE M_KOJO_K103_RANDNR(4,315)
					CASE 1
						PRINTFORMW 「아윽... 잠깐, 거긴 민감해... 더...!!」
					CASE 2
						PRINTFORMW 「하아...윽...! 안 돼, 안 돼...!」
					CASE 3
						PRINTFORMW 「...젖어오고 있다고 말하지 않아도 돼...!」
					CASEELSE
						PRINTFORMW 「히으...윽! 아... 머리가... 지끈거려...윽!」
				ENDSELECT
				PRINTFORML
			CASE 31,32,33,34,61,62,63,64
				;思慕ORセフレ
				SELECTCASE M_KOJO_K103_RANDNR(5,315)
					CASE 1
						PRINTFORMW 「...앙... 왜 이래... 클리만 계속...」
					CASE 2
						PRINTFORMW 「안 돼, 이상하게... 이상해질 테니까... 응응...!」
					CASE 3
						PRINTFORMW 「응... 으음... 아앙...」
					CASE 4
						PRINTFORMW 「아앗... 다리가 저절로 움직여버려... 하앗... 안 돼...」
					CASEELSE
						PRINTFORMW 「아...응음...응아...」
				ENDSELECT
				PRINTFORML
			CASE 41,42,43,44,51,52,53,54,71,72,73,74
				;恋慕OR愛欲
				SELECTCASE M_KOJO_K103_RANDNR(5,315)
					CASE 1
						PRINTFORMW 「응응... 클리토리스는 안 돼... 약해지는 건... 안 돼... %M_KOJO_K103_HEART()%」
					CASE 2
						PRINTFORMW 「앗, 안 돼, 만지지 마, 안 돼, 으윽, 문지르는 것도, 아, 아...%M_KOJO_K103_HEART()%」
					CASE 3
						PRINTFORMW 「안 돼... %M_KOJO_K103_AEGI()%...%M_KOJO_K103_AEGI()%...%M_KOJO_K103_HEART()%」
					CASE 4
						PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_AEGI()%…눌러줘…아앗…%M_KOJO_K103_HEART()%」
					CASEELSE
						PRINTFORMW 「그렇게 문지르면 안 돼... 금방 가버릴 거야... 안 돼...」 %M_KOJO_K103_HEART()%
				ENDSELECT
				PRINTFORML
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
