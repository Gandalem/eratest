@M_KOJO_MESSAGE_COM_K103_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		SIF FLAG:口上色
			CALL M_KOJO_COLOR_K103
		PRINTFORMW 「에, 나, 빨고 싶은 거야?」
		PRINTFORML 
		PRINTFORMDW 유메코는 가랑이를 손으로 가리며 부끄러운 듯 살짝 뒤로 물러섰다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 유메코를 조금 몰아붙이듯 얼굴을 가랑이 쪽으로 가까이 대고, 숨기고 있던 손을 살며시 내렸다.
		PRINTFORML 
		PRINTFORMW 「... 뭔가 이상하지 않아? ...아후...」
		PRINTFORML
		PRINTFORMDL 그런 일은 없다고 말하면서 %M_KOJO_K103_ZURASHI()%, 살짝 혀를 내밀자 유메코는 움찔하며 어깨를
		PRINTFORMDW 떨며 작게 목소리를 냈다.
		PRINTFORML
		PRINTFORML 「왠지... 이상한 느낌이야... 아...」
		RETURN 1
	ENDIF
	;初めての時は地の文を表示させない
	CALL TRAIN_MESSAGE
	SIF FLAG:70
		RETURN 1
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORML 「아, 잠시만, 저기...윽!!」
			PRINTFORML 「음응, 지금 핥지 않아도 되는데...」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 「ああああ읏、%M_KOJO_K103_AEGI()%안 돼, 안 돼, 안 돼...%M_KOJO_K103_HEART()%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE M_KOJO_K103_RANDNR(8, 912);
			CASE 1
				PRINTFORMW 「아, ……응…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「어떻게… 맛있어…? %M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「ぺろぺろ…気持ちい…%M_KOJO_K103_HEART()%」
			CASE 3
				PRINTFORMW 「앗, 거기... 응, 쿠리 쪽이야... %M_KOJO_K103_HEART()%」
				PRINTFORMW 「더... 더... %M_KOJO_K103_HEART()%」
			CASE 4
				PRINTFORMW 「앗, 아, 클리 쪽을 빨면 안 돼... %M_KOJO_K103_HEART()%」
				PRINTFORMW 「아...... 아앗... %M_KOJO_K103_HEART()%」
			CASE 5
				PRINTFORMW 「하아...%M_KOJO_K103_AEGI()%...아...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「여기, 이쪽, 더 가지고 놀아줘...%M_KOJO_K103_HEART()%」
			CASE 6
				PRINTFORMW 「응, ……%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗, 안 돼, 클리(Clery)를 그렇게……%M_KOJO_K103_HEART()%」
			CASE 7
				PRINTFORMW 「앗... 안에 혀가 들어와 버려...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「아... 없었어... 없어....%M_KOJO_K103_HEART()%」
			CASEELSE
				PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「음! %M_KOJO_K103_AEGI()% 그렇게 필사적으로...읏%M_KOJO_K103_HEART()%」
		ENDSELECT
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		SELECTCASE M_KOJO_K103_RANDNR(8, 912);
			CASE 1
				PRINTFORMW 「앗, ……응…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「그런 곳은… 맛있지 않아……?%M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「손과는... 다른 느낌이야... %M_KOJO_K103_HEART()%」
			CASE 3
				PRINTFORMW 「앗, 클리만...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗... 앗......%M_KOJO_K103_HEART()%」
			CASE 4
				PRINTFORMW 「앗, 아, 클리 쪽을 빨면 안 돼... %M_KOJO_K103_HEART()%」
				PRINTFORMW 「아...... 아앗... %M_KOJO_K103_HEART()%」
			CASE 5
				PRINTFORMW 「하아...%M_KOJO_K103_AEGI()%...아...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「여기, 이쪽, 더 가지고 놀아줘...%M_KOJO_K103_HEART()%」
			CASE 6
				PRINTFORMW 「응, ……%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗, 안 돼, 클리(Clery)를 그렇게……%M_KOJO_K103_HEART()%」
			CASE 7
				PRINTFORMW 「앗……안에 혀가 들어와 버려…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗…응응………%M_KOJO_K103_HEART()%」
			CASEELSE
				PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「음! %M_KOJO_K103_AEGI()% 그렇게 필사적으로...읏%M_KOJO_K103_HEART()%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
