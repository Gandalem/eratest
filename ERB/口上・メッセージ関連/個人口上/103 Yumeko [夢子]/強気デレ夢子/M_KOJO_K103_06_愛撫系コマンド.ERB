@M_KOJO_MESSAGE_COM_K103_0
CALL M_KOJO_MESSAGE_COM_K103_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;1行入れたい
	PRINTFORML 
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「앗, 잠시만요, 간지러워... 응...」
		PRINTFORML 
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 애무가 가려운 것인지, 유메코는 몸을 비틀고 있다.
		PRINTFORMDW 하지만 시간이 지남에 따라, 점차 유메코의 숨이 거칠어진다…
		PRINTFORMDW 축축한 느낌이 감도는 음부를 %M_KOJO_K103_ZURASHI()% 손가락으로 살며시 더듬자, 작은 신음소리를 흘렸다…
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORML
			CALL M_KOJO_K103_CALL_ZAMEN()
			RETURN 1
		ELSE
			PRINTFORMW 「내 %M_KOJO_K103_GET("ヴァギナ")%, 웅얼거리고 있어……」
			;RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORML
			CALL M_KOJO_K103_CALL_ZAMEN()
			RETURN 1
		ELSE
			PRINTFORMW 「%M_KOJO_K103_GET("アヌス")%… 아앗……」
			;RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE M_KOJO_K103_RANDNR(8, 103)
			CASE 1
				PRINTFORMW 「앗, ……응…%M_KOJO_K103_HEART()%」
				PRINTFORMW 「더……더 만져줘……%M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「하아... 응... 귀가 약해진 거야...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「%M_KOJO_K103_AEGI()%……%M_KOJO_K103_HEART()%」
			CASE 3
				PRINTFORMW 「아, 거기 기분 좋아...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「더...... 더...... %M_KOJO_K103_HEART()%」
			CASE 4
				PRINTFORMW 「아앙... 만지는 방식이 야해... %M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗... 하지만... 기분 좋으니까... 아앗... %M_KOJO_K103_HEART()%」
			CASE 5
				PRINTFORMW 「하아......아...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「여기, 이쪽, 더 만져줘......%M_KOJO_K103_HEART()%」
			CASE 6
				PRINTFORMW 「응, ……%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗, 안 돼, 클리(Clery)를 그렇게……%M_KOJO_K103_HEART()%」
			CASE 7
				PRINTFORMW 「음음... 가슴, 가슴 더 만져줘...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗... 기분 좋아...%M_KOJO_K103_HEART()%」
			CASEELSE
				PRINTFORMW 「더 여러 곳을 만져줬으면 해...%M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗... 그래... 아앙...! %M_KOJO_K103_HEART()%」
		ENDSELECT
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		SELECTCASE M_KOJO_K103_RANDNR(8, 103)
			CASE 1
				PRINTFORMW 「아, ......응...」
				PRINTFORMW 「아, 거기 기분 좋아......%M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「하아... 응... 귀...」
				PRINTFORMW 「%M_KOJO_K103_AEGI()%……%M_KOJO_K103_HEART()%」
			CASE 3
				PRINTFORMW 「앗, 거기, 거기...」
				PRINTFORMW 「앗... 앗...... %M_KOJO_K103_HEART()%」
			CASE 4
				PRINTFORMW 「아앙... 만지는 방식이 야해...」
				PRINTFORMW 「앗... 하지만...... 기분이 좋아서... 아앗... %M_KOJO_K103_HEART()%」
			CASE 5
				PRINTFORMW 「하아...... 아...」
				PRINTFORMW 「여기, 이쪽, 여기가 기분 좋은 거야...... %M_KOJO_K103_HEART()%」
			CASE 6
				PRINTFORMW 「앙, …… %M_KOJO_K103_HEART()%」
				PRINTFORMW 「앗, 안 돼, 클리(Cleri)를 그렇게…… %M_KOJO_K103_HEART()%」
			CASE 7
				PRINTFORMW 「응응... 가슴이 느껴져...」
				PRINTFORMW 「앗... 기분 좋아... %M_KOJO_K103_HEART()%」
			CASEELSE
				PRINTFORMW 「온몸을 농락당해서... 음응!」
				PRINTFORMW 「앗... 안 돼...... 아앙...! %M_KOJO_K103_HEART()%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
