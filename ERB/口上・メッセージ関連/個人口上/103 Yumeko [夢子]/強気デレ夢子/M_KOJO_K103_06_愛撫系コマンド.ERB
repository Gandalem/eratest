@M_KOJO_MESSAGE_COM_K103_3
CALL M_KOJO_MESSAGE_COM_K103_3_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML
		PRINTFORMW 「……왠지, 배 안에 손가락이 들어오는 게 이상한 느낌이야……」
		PRINTFORML
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 살짝 어깨에 힘을 주고, 처음 느끼는 손가락의 감각을 확인하듯이,
		PRINTFORMDW 질을 조여온다.
		PRINTFORML
		PRINTFORMW 「……흐윽…응…처음인데...!」
		PRINTFORML
		PRINTFORMDL 손가락을 질 벽에 대고 문지르자, 애액이 금세 안쪽에서 흘러나오는 것을
		PRINTFORMDW 느꼈다.
		PRINTFORMDL 기분 좋아서 오히려 저절로 무의식적으로 손가락을 기분 좋은 곳으로 이끄는 그녀를
		PRINTFORMDW 한 팔로 붙잡고, 다시 손가락을 움직여 나간다...
		PRINTFORML
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
		;ELSEIF TALENT:恋慕
		;	PRINTFORMW
		;	RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		IF TCVAR:破瓜 == 1
			;指で処女奪っちゃった時
			PRINTFORMDW 손가락을 깊숙이 넣자, '툭' 하는 감각이 손끝으로 전해졌다.
			PRINTFORMDW 문득 은밀한 곳을 들여다보니, 파굴의 증거인 선혈이 손가락에서 손으로 이어져 있었다.
			PRINTFORML
			PRINTFORMW 「……으윽… 아파…… 어라…?」
			PRINTFORML
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 무슨 일이 일어났는지 바로 알아차리지 못하고,
			PRINTFORMDW 당혹스러운 표정을 지은 뒤, 뭐라고 말할 수 없는, 후회하는 듯하면서도
			PRINTFORMDW 쓸쓸해 보이는 표정을 짓고는 포옹을 요구하듯 손을 내밀었다.
			PRINTFORML
			PRINTFORMW 「……네… 아파……」
			PRINTFORML
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 일단 그녀를 달래기로 했다.
			PRINTFORML
			RETURN 1
		ENDIF
		LOCAL:1 = M_KOJO_K103_KANKEI()
		SELECTCASE LOCAL:1
			CASE 10, 11, 12, 13, 21, 22, 23, 24
				;特別な感情は抱いていない時
				SELECTCASE M_KOJO_K103_RANDNR(4,3)
					CASE 1
						PRINTFORMW 「안 됐어……응……흐윽……」
					CASE 2
						PRINTFORMW 「기다려... 아, 다리가 후들후들해져 버린다...」
					CASE 3
						PRINTFORMW 「꾸덕꾸덕 소리가 나고 있어... 들려주지 않아도 돼, 그렇게 거칠게...」
					CASEELSE
						PRINTFORMW 「あ읏……ひぅ…읏! チカチカする…읏!」
				ENDSELECT
				PRINTFORML
			CASE 31,32,33,34,61,62,63,64
				;思慕ORセフレ
				SELECTCASE M_KOJO_K103_RANDNR(4,3)
					CASE 1
						PRINTFORMW 「...응... 안 돼, 뒤섞지 말아줘...윽...」
					CASE 2
						PRINTFORMW 「안 돼... 기분 좋아...!」
					CASE 3
						PRINTFORMW 「응윽……아앙……응윽……」
					CASEELSE
						PRINTFORMW 「응... 응... 하윽... 하윽... 그럭저럭... 하지 마아...! 」
				ENDSELECT
				PRINTFORML
			CASE 41,42,43,44,51,52,53,54,71,72,73,74
				;恋慕OR愛欲
				SELECTCASE M_KOJO_K103_RANDNR(5,3)
					CASE 1
						PRINTFORMW 「안 돼... 기분 좋아서 머리가 이상해져 버려... 아, 거기... 아앙...! %M_KOJO_K103_HEART()%」
					CASE 2
						PRINTFORMW 「손가락으로 휘저어지면 의식이 날아갈 것만 같아... 헉... 아아...」 %M_KOJO_K103_HEART()%
					CASE 3
						PRINTFORMW 「…%M_KOJO_K103_AEGI()%…안 돼, 안 돼어…%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART()%」
					CASE 3
						PRINTFORMW 「…%M_KOJO_K103_AEGI()%…거기…배 쪽을 주무르네…아앗…%M_KOJO_K103_HEART()%」
					CASEELSE
						PRINTFORMW 「꾸욱소리 내지 마아... 그래도, 이제 알았으니까아앙... %M_KOJO_K103_HEART()%」
				ENDSELECT
				PRINTFORML
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
