;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K103_6
CALL M_KOJO_MESSAGE_SCOM_K103_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K103_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
		;ELSEIF TALENT:恋慕
		;	PRINTFORMW
		;	RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		LOCAL:2 = M_KOJO_K103_KANKEI()
		SELECTCASE LOCAL:2
			CASE 10, 11, 12, 13, 21, 22, 23, 24
				;特別な感情は抱いていない時
				SELECTCASE M_KOJO_K103_RANDNR(4,6)
					CASE 1
						PRINTFORMW 「응윽... 거기, 주무르면...」
					CASE 2
						PRINTFORMW 「배 속에서부터 밀어 올려지는 것 같아...윽」
					CASE 3
						PRINTFORMW 「…%M_KOJO_K103_AEGI()%…」
					CASEELSE
						PRINTFORMW 「안쪽으로 꾹꾹... 소리가 나와버려...」
				ENDSELECT
				PRINTFORML
			CASE 31,32,33,34,61,62,63,64
				;思慕ORセフレ
				SELECTCASE M_KOJO_K103_RANDNR(4,6)
					CASE 1
						PRINTFORMW 「하아...윽...응...」
					CASE 2
						PRINTFORMW 「앗, 아파, 안 돼...! 안 돼...!」
					CASE 3
						PRINTFORMW 「앗... 앗... 허리가 멋대로 움직여버려...!」
					CASEELSE
						PRINTFORMW 「배 속에서 그렇게 발버둥 치지 마아……!」
				ENDSELECT
				PRINTFORML
			CASE 41,42,43,44,51,52,53,54,71,72,73,74
				;恋慕OR愛欲
				SELECTCASE M_KOJO_K103_RANDNR(4,6)
					CASE 1
						PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART()%」
					CASE 2
						PRINTFORMW 「으응... 오고 있어...윽... %M_KOJO_K103_HEART()%」
					CASE 3
						PRINTFORMW 「...앗, 거, 거기이...! %M_KOJO_K103_HEART()%」
					CASEELSE
						PRINTFORMW 「%M_KOJO_K103_AEGI()%... %M_KOJO_K103_HEART()% 거칠게... 이, 허리가 멈추질 않아...! %M_KOJO_K103_HEART()%」
				ENDSELECT
				PRINTFORML
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K103_{SELECTCOM}_1
RETURN 1
