	;ELSE
	PRINTFORML 
	IF ONCE("授乳プレイ")
		PRINTFORML 「또 응석 부리고 싶어...?」
		PRINTFORMW 「네~ 가슴으로 해드릴게요 %M_KOJO_K103_HEART(1)%」
	ELSE
		SELECTCASE M_KOJO_K103_RANDNR(8, 519)
			CASE 1
				PRINTFORML 「후후후... 야한 아기네...%M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「젖 맛있니?%M_KOJO_K103_HEART(1)%」
			CASE 2
				PRINTFORML 「음, ...많이 응석 부려도 돼... %M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「자, 가슴 더 빨아봐... %M_KOJO_K103_HEART(1)%」
			CASE 3
				PRINTFORML 「응애쟁이 씨……%M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「이렇게 가슴을 쪽쪽 빨아버리고, 벌써……%M_KOJO_K103_HEART(1)%」
			CASE 4
				PRINTFORML 「응... 유두 물면 안 돼...?」
				PRINTFORMW 「앗... 안 된다고 말하고 있는데... %M_KOJO_K103_HEART(1)%」
			CASE 5
				PRINTFORML 「네, %조사처리(CALLNAME:MASTER,"가")% 제일 좋아하는 가슴이야~%M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「많이 쪽쪽 해주고, 많이 뿜뿜 하자구~...%M_KOJO_K103_HEART(1)%」
			CASE 6
				PRINTFORML 「응... 이제... 유두로 놀지 마 %M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「아앙, 안 돼 정말... %M_KOJO_K103_HEART(1)%」
			CASE 6
				PRINTFORML 「네에, 쪽쪽 해줘...%M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「거시기 힘이 넘치네, 잔뜩 문질러 보자~ %M_KOJO_K103_HEART(1)%」
			CASE 7
				PRINTFORML 「음, 쪽쪽거리는 소리가 멈췄어, 제대로 빨아줘...%M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「혹은, 거시기 기분 좋아서 집중 못 하는 거야? ...자, 주무르렴...%M_KOJO_K103_HEART(1)%」
			CASEELSE
				PRINTFORML 「스윽스윽, 스윽스윽…%M_KOJO_K103_HEART(1)%」
				PRINTFORMW 「뭐야? 가슴 더 갖고 싶어? 응, 얼마든지 빨아도 돼...? %M_KOJO_K103_HEART(1)%」
		ENDSELECT
	ENDIF
	RETURN 1
