					PRINTFORMDL 쿵, 하는 충격과 함께, %조사처리(CALLNAME:MASTER,"는")% 정신을 차려보니 유메코에게 제압당하고 있었다.
					PRINTFORMDL 유메코의 숨은 거칠었고, 얼굴은 상기되어 있었으며, 무슨 생각을 하고 있는지 욕망에 흔들리는 눈으로 나를 보고 있었다.
					PRINTFORMDL 
					PRINTFORMW 「...저기, %CALLNAME:MASTER%, 받아줘...! %M_KOJO_K103_HEART(1)%」
				ELSE
					PRINTFORMDL 유메코가 천천히 이쪽으로 몸을 기울여와, %조사처리(CALLNAME:MASTER,"는")% 유메코 아래에 깔리는 자세가 되었다.
					PRINTFORMDL 
					PRINTFORMW 「……더는 참을 수 없어……. 있잖아… 해볼까…? %M_KOJO_K103_HEART(1)%」
				ENDIF
			ENDIF
			PRINTFORML 
			RETURN 1
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;-------------------------------------------------
		;抜け出した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORML
			IF !TALENT:恋慕
				PRINTFORMW 「그, ...그렇겠지, 이런 건 안 되는 거니까, ...응...」
			ELSE
				PRINTFORMW 「아... 싫었어...? ...미안해」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード満足終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード強制終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;好きにして状態から抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			PRINTFORMW 「안 돼%M_KOJO_K103_HEART(1)% 아직, 아직 부족해%M_KOJO_K103_HEART(1)%」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;欲求不満が高くて抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			IF TCVAR:媚薬 || TCVAR:発情
				PRINTFORMW 「안 돼%M_KOJO_K103_HEART(1)% 놓아주지 않을 거니까%M_KOJO_K103_HEART(1)%」
			ELSE
				PRINTFORMW 「안 돼 %M_KOJO_K103_HEART(1)% 나 아직 만족 못 했단 말이야 %M_KOJO_K103_HEART(1)%」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
