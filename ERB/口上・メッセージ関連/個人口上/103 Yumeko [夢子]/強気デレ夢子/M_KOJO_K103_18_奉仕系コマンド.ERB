;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K103_80
CALL M_KOJO_MESSAGE_COM_K103_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:70
		PRINTFORMW 「손으로 해줬으면 하는 거구나?」
		PRINTFORMW 「음... 이렇게...?」
		PRINTFORML 
		PRINTFORMDL 조금 더 세게 쥐어도 괜찮냐고 하자, 유메코는 조심스러워하며 힘을 주어 문지르기 시작했다.
		PRINTFORMW 
		PRINTFORMW 「응... 기분 좋아...? 어때...?」
		PRINTFORML
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE M_KOJO_K103_RANDNR(4,80)
			CASE 1
				PRINTFORMW 「흡... 흡...... 어때? 기분 좋아?%M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「후후…%M_KOJO_K103_GET("ペニス")%따뜻해%M_KOJO_K103_HEART()%」
			CASE 3
				PRINTFORMW 「구석구석... 구석구석...%M_KOJO_K103_HEART()%」
			CASEELSE
				PRINTFORMW 「끝부분도 이렇게 손바닥으로 만지면 기분 좋잖아...? %M_KOJO_K103_HEART()%」
		ENDSELECT
		SIF NOWEX:MASTER:射精
			PRINTFORMW 「앗... 부풀어 올랐네... 갈 것 같아? 괜찮아... 보여줘... %M_KOJO_K103_HEART()%」
		PRINTFORML
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		SELECTCASE M_KOJO_K103_RANDNR(4,80)
			CASE 1
				PRINTFORMW 「헉... 헉... 어때? 잘 하고 있나...」
			CASE 2
				PRINTFORMW 「꽤 따뜻하네... 이거... 냄새도...」
			CASE 3
				PRINTFORMW 「응... 저... 팔이 피곤해졌어...」
			CASEELSE
				PRINTFORMW 「끝 부분도 만져줬으면 좋겠어...? 그, 그렇게...?」
		ENDSELECT
		SIF NOWEX:MASTER:射精
			PRINTFORMW 「아... 부풀어 올랐다... 갈 것 같아? 에잇... 에잇...」
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
