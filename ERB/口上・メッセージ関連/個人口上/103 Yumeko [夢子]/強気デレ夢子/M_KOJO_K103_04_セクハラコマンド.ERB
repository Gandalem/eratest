RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSE
		PRINTFORML
		IF TCVAR:350 >= 6 && TCVAR:350 < 10
			;初対面で時止め状態だった
			;邂逅処理を行う
			CALL M_KOJO_K103_MEET
			PRINTFORMD 치마를 들어 올리려고
			;初対面の挨拶を強制的に呼び出す
			CALL M_KOJO_ENCOUNTER_K103
			;時止めフラグ初期化
			CALL M_KOJO_K103_RESETTW
			RETURN 1
		ENDIF
		IF TFLAG:193 == -5
			PRINTFORMW 「갑자기 뭐 하는 거야!!」
		ELSEIF TFLAG:193 == -3
			PRINTFORMW 「잠깐, 무슨 생각 하는 거야!!」
		ELSEIF TFLAG:193 == -1
			PRINTFORMW 「저, 저기, 뭐 하는 거야!」
		ELSEIF TFLAG:193 == 0
			PRINTFORMW 「잠깐, 잠깐, 뭐 하는 거야...」
		ELSE
			IF GET_TARGETNUM() == 1 && !DATE_HITOGOMI(CFLAG:PLAYER:現在位置) && !WITH_MOB()
				IF ABL:露出癖 > 3
					PRINTFORMW 「보, 보고 싶었죠, 자…」
				ELSE
					PRINTFORMW 「뭐, 뭐 하는 거야...... 그렇게 보고 싶어...?」
				ENDIF
			ELSE
				IF ABL:露出癖 > 5
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 보고 싶다고 해서 어쩔 수 없이... 어쩔 수 없이... 자...」
				ELSE
					PRINTFORMW 「아, 저, 잠깐만요, 다들 보고 있잖아요...」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
