;==================================================
;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K103_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
IF TCVAR:350 >= 6
	TFLAG:192 = -2
ELSE
	TFLAG:192 =0
ENDIF
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K103_310
RETURN 1

@M_KOJO_MESSAGE_COM_K103_310
CALL M_KOJO_MESSAGE_COM_K103_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;地の文消してるので口上色変更処理
	SIF FLAG:口上色
		CALL M_KOJO_COLOR_K103
	IF FLAG:70 == 1
		PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% 뒤에서 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%에게 손을 뻗었다.
		PRINTFORMDL 시간을 멈춰진 %조사처리(CALLNAME:TARGET,"는")% 저항 없이 엉덩이를 쓰다듬어지고 있다...
	ELSEIF CFLAG:TARGET:睡眠 == 1
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 누워서 잠든 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%에게 손을 뻗었다.
		IF TALENT:恋慕
			PRINTFORML 「음... 음음...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 살짝 홍조를 띠며 %조사처리(CALLNAME:PLAYER,"에게")% 당하고 있다...
		ELSE
			PRINTFORML 「음... 음-...? 응...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 몸을 비틀더니 무의식적으로 %조사처리(CALLNAME:PLAYER,"의")% 손을 뿌리쳤다...
		ENDIF
	ELSE
		IF TCVAR:350 >= 6 && TCVAR:350 < 10
			;初対面で時止め状態だった
			;邂逅処理を行う
			CALL M_KOJO_K103_MEET
			PRINTFORML
			PRINTFORMD 엉덩이를 쓰다듬으려고
			;初対面の挨拶を強制的に呼び出す
			CALL M_KOJO_ENCOUNTER_K103
			;時止めフラグ初期化
			CALL M_KOJO_K103_RESETTW
			RETURN 1
		ENDIF
		IF CFLAG:うふふ == 2
			SELECTCASE TCVAR:20
				;クンニ強制
				CASE 70
					IF !TEQUIP:0
						PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%를 천천히 주무르면서 밀어붙여지는 %SLIT(TARGET, 1)%에게 혀로 봉사했다...
					ELSE
						GOTO NOMALSIRINADE
					ENDIF
					;アナル奉仕
				CASE 72
					IF !TEQUIP:0
						PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 엉덩이 살을 벌리고, 뾰족한 혀를 항문에 침입시켰다...
					ELSE
						GOTO NOMALSIRINADE
					ENDIF
					;スカートの中を見せる
				CASE 35
					PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 자신에게 향하게 하고 쓰다듬었다...
					;素股
				CASE 52
					PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")% 허리 위에 올라탄 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%를 주물렀다...
				CASEELSE
					$NOMALSIRINADE
					PRINTFORMD %조사처리(CALLNAME:TARGET,"는")%
					;シックスナイン パンツ有り顔面騎乗(70～72)はこちら
					SIF TEQUIP:シックスナイン
						PRINTFORMD 얼굴 위에 올라탔다
					PRINTFORMD %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%를 주물렀다...
			ENDSELECT
		ELSE
			PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% \@ PREVCOM == 305 ? 무릎에 누운 채 # 뒤에서 \@%조사처리(CALLNAME:TARGET,"의")%%HIP(TARGET)%에게 손을 뻗었다.
			SELECTCASE TFLAG:193
				CASE 1
					IF TALENT:TARGET:10 == -1
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 꽉 눈을 감고, 눈가에 눈물을 글썽이며 %조사처리(CALLNAME:PLAYER,"의")% 성추행에 耐이고 있다…
						PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% 약간 죄책감을 느꼈다
					ELSE
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 불쾌감을 드러낸 표정으로 %조사처리(CALLNAME:PLAYER,"의")% 손을 쳐냈다…
					ENDIF
				CASE 2,3
					IF OTOKOGIRAI(TARGET)
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 작게 비명을 지르며 몸을 움츠렸다
						PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% 조금 죄책감을 느꼈다
					ELSE
						LOCALS:0 = 
						IF TARGET == 57 && !TALENT:恋慕
							LOCALS:0 = 원숭이 같은 표정을 지었다
						ELSE
							LOCALS:0 = 얼굴을 붉히며
						ENDIF
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %LOCALS:0%의 %CALLNAME:PLAYER%손을 뿌리쳤다...
					ENDIF
				CASE 4
					LOCALS:1 = 
					IF TARGET == 57 && !TALENT:恋慕
						LOCALS:1 = 원숭이 얼굴과 노인 얼굴을 번갈아
					ELSE
						LOCALS:1 = 부끄러워하는 표정을
					ENDIF
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %LOCALS:1%을 드러내면서도 %조사처리(CALLNAME:PLAYER,"에게")% 몸을 맡기고 있다...
			ENDSELECT
			;人込みは要らない
			;TFLAG:400 = RAND:2
			;SIF TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)
			;	CALL DATE_HITOGOMI_MESSAGE(CFLAG:PLAYER:現在位置)
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K103_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K103_311
CALL M_KOJO_MESSAGE_COM_K103_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		;ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
		;ELSEIF CFLAG:睡眠
	ELSE
		LOCAL:1 = M_KOJO_K103_KANKEI()
		SELECTCASE LOCAL:1
			CASE 10, 11, 12, 13, 21, 22, 23, 24
				;特別な感情は抱いていない時
				SELECTCASE M_KOJO_K103_RANDNR(4,311)
					CASE 1
						PRINTFORMW 「앗... 어째서 그래?」
					CASE 2
						PRINTFORMW 「잠깐, 뭐 하는 거야...」
					CASE 3
						PRINTFORMW 「...성희롱에는 관심 없어」
					CASEELSE
						PRINTFORMW 「그만! 달라붙지 마!」
				ENDSELECT
				PRINTFORML
			CASE 31,32,33,34,61,62,63,64
				;思慕ORセフレ
				SELECTCASE M_KOJO_K103_RANDNR(4,311)
					CASE 1
						PRINTFORMW 「갑자기 왜 그래, 벌써」
					CASE 2
						PRINTFORMW 「좀, 뭐야? 안고 와버리거나...」
					CASE 3
						PRINTFORMW 「...나 아니면 성희롱이야?」
					CASEELSE
						PRINTFORMW 「흥, 뭐야? 잠깐, 눈 돌아간 사이에 가슴을 만지지 마!」
				ENDSELECT
				PRINTFORML
			CASE 41,42,43,44,51,52,53,54,71,72,73,74
				;恋慕OR愛欲
				SELECTCASE M_KOJO_K103_RANDNR(4,311)
					CASE 1
						PRINTFORMW 「응? 네... 꼭 안아줘...」
					CASE 2
						PRINTFORMW 「뭐야? 부드러워? 그럼 다행이네」
					CASE 3
						PRINTFORMW 「...음... 가슴에 얼굴을 묻고 있어도 괜찮아? ...조금 부끄럽지만 말이야」
					CASEELSE
						PRINTFORMW 「잠깐, 이제 그만해. 가슴이나 엉덩이를 만지는 장난스러운 손은 말이야.」
				ENDSELECT
				PRINTFORML
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K103_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K103_312
CALL M_KOJO_MESSAGE_COM_K103_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
		PRINTFORML 「음, 음~…… 스윽……」
	ELSE
		IF !TCVAR:ＦＫ喪失
			LOCAL:1 = M_KOJO_K103_KANKEI()
			SELECTCASE LOCAL:1
				CASE 10, 11, 12, 13, 21, 22, 23, 24
					;特別な感情は抱いていない時
					PRINTFORML 「엣……뭐야……?」
					PRINTFORML 「에, 잠깐……거짓말……」
					PRINTFORML 「나……처음이었는데……」
					PRINTFORMDL
					PRINTFORMDW 유메코는 고개를 숙이고, 어깨를 파르르 떨고 있다.
				CASE 31,32,33,34,61,62,63,64
					;思慕ORセフレ
					PRINTFORML 「엣.........앗……」
					PRINTFORML 「저기, %CALLNAME:MASTER%...?」
					PRINTFORMW 「방금 건... 그... 그런 의미일까...?」
				CASE 41,42,43,44,51,52,53,54,71,72,73,74
					;恋慕OR愛欲
					PRINTFORML 「엣……......」
					PRINTFORMDL
					PRINTFORMDL 유메코는 자신의 입에 손가락을 대고 방금 무슨 일이 일어났는지 기억해내려는 듯 눈을 이리저리 굴렸다.
					PRINTFORMDL
					PRINTFORML 「음, %CALLNAME:MASTER%……?」
					PRINTFORML 「방금 건……그게……. 그런 의미인 걸까…?」
					PRINTFORML 「저기… 음…………에에에………?」
					PRINTFORML 
					PRINTFORMDL 유메코는 그렇게 말하며 머리를 감싸 쥐더니, 그 자리에 주저앉았다.
					PRINTFORMDW 보니 귀가 새빨갛게 물들어 있었다.
			ENDSELECT
			TCVAR:ＦＫ喪失 = 1
			CSTR:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、%DATENAME_PLACE()%で\@ TALENT:恋慕 ? 初恋の相手である # (TALENT:思慕 ? 好意を寄せていた # ) \@%CALLNAME:MASTER%に、突然ファーストキスを奪われた
		ELSE
			LOCAL:1 = M_KOJO_K103_KANKEI()
			SELECTCASE LOCAL:1
				CASE 10, 11, 12, 13, 21, 22, 23, 24
					;特別な感情は抱いていない時
					PRINTFORML 「음... 쪽...」
					PRINTFORMW 「음... 인사 같은 거랄까...?」
				CASE 31,32,33,34,61,62,63,64
					;思慕ORセフレ
					PRINTFORML 「음... 츄...」
					PRINTFORML 「아, 한 번 더」
					PRINTFORMW 「츄...」
				CASE 41,42,43,44,51,52,53,54,71,72,73,74
					;恋慕OR愛欲
					PRINTFORML 「음... 쪽... 음쪽...」
					PRINTFORMW 「푸아... 햄읍... 쪽...」
					PRINTFORMW 「...어... 벌써 끝이야?」
			ENDSELECT
			PRINTFORML 
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;313,胸愛撫
;CFLAG:うふふ==2&&TCVAR:20(27=谷間を見せる 33=胸を揉ませる 53=パイズリ(小分岐は地の文EVENT_MESSAGE_COM_セクハラ.ERB参照) 73=ぱふぱふ 77=乳を吸わせる 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;ABL:Ｂ感覚(2未満=性的には感じてない 5未満=多少感じてる 5以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;乳のサイズでも変わる場合があるので、地の文EVENT_MESSAGE_COM_セクハラ.ERB参照
;==================================================

@M_KOJO_MESSAGE_COM_K103_313
CALL M_KOJO_MESSAGE_COM_K103_313_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		LOCAL:1 = M_KOJO_K103_KANKEI()
		SELECTCASE LOCAL:1
			CASE 10, 11, 12, 13, 21, 22, 23, 24
				;特別な感情は抱いていない時
				SELECTCASE M_KOJO_K103_RANDNR(4,313)
					CASE 1
						PRINTFORMW 「앗... 잠깐만... 세게 하지 마...」
					CASE 2
						PRINTFORMW 「음응... 가슴만으로 느끼는 건 없어...?」
					CASE 3
						PRINTFORMW 「...모양이 있잖아? 좀 자랑하는 거야...」
					CASEELSE
						PRINTFORMW 「응… 좀 더 부드럽게… 앙…」
				ENDSELECT
				PRINTFORML
			CASE 31,32,33,34,61,62,63,64
				;思慕ORセフレ
				SELECTCASE M_KOJO_K103_RANDNR(4,313)
					CASE 1
						PRINTFORMW 「...앙... 벌써... 그렇게 가슴 좋아하는 거야...?」
					CASE 2
						PRINTFORMW 「응... 주무르는 것만으로 괜찮아...?」
					CASE 3
						PRINTFORMW 「응... 응응... 흐윽... 소리... 소리가 나버렸어...」
					CASEELSE
						PRINTFORMW 「아...응음...응아...」
				ENDSELECT
				PRINTFORML
			CASE 41,42,43,44,51,52,53,54,71,72,73,74
				;恋慕OR愛欲
				SELECTCASE M_KOJO_K103_RANDNR(6,313)
					CASE 1
						PRINTFORMW 「んんん읏…そんなに胸ばかり…%M_KOJO_K103_HEART()%」
					CASE 2
						PRINTFORMW 「뭐야? 부드러워? 응, 더 주물러줘...%M_KOJO_K103_HEART()%」
					CASE 3
						PRINTFORMW 「앙... %M_KOJO_K103_HEART()% 저기, 있잖아, 그... 유두도... 아니야... 아무것도 아니야...」
					CASE 4
						PRINTFORMW 「응... %M_KOJO_K103_HEART()% 유두를 만지작... 아앙! %M_KOJO_K103_HEART()%」
					CASE 5
						PRINTFORMW 「더, 더 만져줘... %M_KOJO_K103_HEART()% 이걸로 벌써 이상해지겠어... %M_KOJO_K103_HEART()%」
					CASEELSE
						PRINTFORMW 「응… 말랑한 게 느껴지지…? 무거워, 이거…」
						PRINTFORMW 「이렇게 주무르면, 또 커지거나 할지도 몰라… %M_KOJO_K103_HEART()%」
				ENDSELECT
				PRINTFORML
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
