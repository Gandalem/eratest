@M_KOJO_MESSAGE_COUNTER_K103_35
CALL M_KOJO_MESSAGE_COUNTER_K103_35_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K103_35_1
IF PALAM:潤滑 < PALAMLV:2
	SELECTCASE M_KOJO_K103_PANTSU()
		CASE -1, 1
			;パンツ穿いてる
			PRINTFORMW 「%CALLNAME:MASTER%, 자, 봐……. %M_KOJO_K103_HEART(1)%」
			IF TEQUIP:TARGET:50 == MASTER
				PRINTFORMW 「붙어 있는 곳... 잘 보이는 것 같아...? %M_KOJO_K103_HEART(1)%」
			ELSEIF 充填率(TARGET,1) > 50 || 充填率(TARGET,2) > 50
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% %M_KOJO_K103_GET("ザーメン")%로, 질척질척……%M_KOJO_K103_HEART(1)%」
			ELSEIF PALAM:潤滑 > PALAMLV:3
				PRINTFORMW 「……헉……헉………%M_KOJO_K103_HEART(1)%」
				PRINTFORML
				PRINTFORMW 유메코의 %PANTSNAME(EQUIP:下半身下着２, TARGET)%은 은밀한 곳에서 흘러나오는 애액으로 커다란 얼룩이 생겨있다...
			ELSEIF PALAM:潤滑 > PALAMLV:1
				PRINTFORMW 「만져줬으면 좋겠어……? %M_KOJO_K103_HEART(1)%」
				PRINTFORML
				PRINTFORMW 유메코의 %PANTSNAME(EQUIP:下半身下着２, TARGET)%은 비밀스러운 곳에서 새어 나오는 애액으로 얼룩이 생겨있다...
			ENDIF
		CASE 2
			;ノーパン
			PRINTFORMW 「……ん읏…%M_KOJO_K103_HEART(1)%」
			IF TEQUIP:TARGET:50 == MASTER
				PRINTFORMW 「붙어 있는 곳... 잘 보이는 것 같아...? %M_KOJO_K103_HEART(1)%」
			ELSEIF 充填率(TARGET,1) > 50 || 充填率(TARGET,2) > 50
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% %M_KOJO_K103_GET("ザーメン")%로, 질척질척……%M_KOJO_K103_HEART(1)%」
			ELSEIF PALAM:潤滑 > PALAMLV:3
				PRINTFORMW 「만져줬으면 좋겠어……? %M_KOJO_K103_HEART(1)%」
				PRINTFORML
				PRINTFORMW 유메코의 은밀한 곳은 침을 흘리듯 애액을 또뚝 떨어뜨렸다...
			ELSEIF PALAM:潤滑 > PALAMLV:1
				PRINTFORMW 「만져줬으면 좋겠어……? %M_KOJO_K103_HEART(1)%」
				PRINTFORML
				PRINTFORMW 유메코의 은밀한 곳은 촉촉하게 습기를 머금고 있었다...
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
