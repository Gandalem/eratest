			PRINTFORMDL 몸의 저림을 견디지 못한 %조사처리(CALLNAME:TARGET,"는")%, 삽입은 하지 않겠다는 조건으로 %조사처리(CALLNAME:MASTER,"에게")% 몸을 허락해 버렸다...
		CASE 1
			IF TALENT:恋慕 && TALENT:恋人
				PRINTFORMDL %CALLNAME:TARGET%도%조사처리(CALLNAME:MASTER,"에게")% 팔을 두르고 되안아왔다… 
			ELSEIF TALENT:恋慕 && TALENT:度胸 < 0
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 결심을 한 듯하면서도 확신 없는 눈으로 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다...
			ELSEIF TALENT:調合知識
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 허둥대고 있다...
			ELSEIF TALENT:SexKnow == -1
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 잘 모르겠군...
			ELSEIF TALENT:度胸 < 0
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 아직 각오를 다지지 못한 듯하다.
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 각오를 다진 듯한 눈으로 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다...
			ENDIF
			IF TALENT:処女 == -1 || TALENT:処女 == 1
				LOCALS:0 = 
				IF TARGET == 57 && !TALENT:恋慕
					LOCALS:0 = 노인과 원숭이와 아이의 얼굴을 번갈아 가며
				ELSE
					LOCALS:0 = 불안과 기대가 뒤섞인 듯한 표정을
				ENDIF
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %LOCALS:0%를 떠올리고 있다...
			ENDIF
		CASE 20
			LOCALS:1 = 
			IF TALENT:TARGET:度胸 > 0 || TALENT:態度 > 0 || TALENT:プライド > 0
				LOCALS:1 = 모욕감에 이를 악물며
			ELSE
				LOCALS:1 = 눈에 눈물을 글썽이며
			ENDIF
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 저항했지만, 순순히 안기도록 강하게 명하자 %LOCALS:1% 받아들였다...
	ENDSELECT
ENDIF
IF !FLAG:70 && HAS_PENIS(MASTER) && !TFLAG:194
	IF TALENT:恋人
		CALL COLORMESSAGE(@"%조사처리(CALLNAME:TARGET,"의")% 체온을 느끼는 것만으로도, %조사처리(CALLNAME:MASTER,"는")% 벌써 팽팽하다!",C_PINK,1)
		BASE:MASTER:勃起 = MAXBASE:MASTER:勃起
	ELSEIF TCVAR:TARGET:抱き寄せ初回 == 20
		CALL COLORMESSAGE(@"지금부터 %CALLNAME:TARGET%에서 마음껏 할 수 있다고 생각하니, 싫어도 사타구니에 피가 몰려온다...",C_PINK,1)
		BASE:MASTER:勃起 = MAX(BASE:MASTER:勃起, 1000)
	ELSEIF CFLAG:溜まってる度 >= 500
		CALL COLORMESSAGE(@"정욕에 젖은 %조사처리(CALLNAME:TARGET,"의")% 눈빛에, %조사처리(CALLNAME:MASTER,"는")% 흥분을 참지 못했다.",C_PINK,1)
		BASE:MASTER:勃起 = MAX(BASE:MASTER:勃起, 1000)
	ENDIF
ENDIF
