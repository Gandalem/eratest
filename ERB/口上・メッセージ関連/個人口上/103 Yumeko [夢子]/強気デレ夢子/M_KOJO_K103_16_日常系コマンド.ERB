				PRINTFORMW 「...그럼 반대쪽 귀를... 아아... 응, 반대쪽 귀를 보여줘...」
			ENDIF
		CASE 41,42,43,44,51,52,53,54,71,72,73,74
			;恋慕OR愛欲
			SIF FIRSTTIME("耳かき")
				PRINTFORML 「에, 귀 파기? 나 한 적 없는데... 괜찮아.」
			IF TFLAG:193 == -1
				PRINTFORML 「앗, 미안했어 아팠지?」
				PRINTFORMW 「미안하다고, 머리 쓰다듬어 줄 테니까 응?」
			ELSE
				PRINTFORML 「...응, 끝났다」
				PRINTFORMW 「...아, 잠깐만, 자잘한 게 흩어져 있으니까... 후우...」
			ENDIF
	ENDSELECT
	;時止めフラグ初期化
	CALL M_KOJO_K103_RESETTW
ENDIF
RETURN 1
