@M_KOJO_SUCCESS_COM_K103_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K103_300
SIF TCVAR:350 < 6 || TCVAR:350 > 10
	RETURN 0
RETURN 1

@M_KOJO_MESSAGE_COM_K103_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K103_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF TCVAR:350 >= 6 && TCVAR:350 < 10
		;初対面で時止め状態だった
		PRINTFORML
		;邂逅処理を行う
		CALL M_KOJO_K103_MEET
		;初対面の挨拶を強制的に呼び出す
		CALL M_KOJO_ENCOUNTER_K103
		;時止めフラグ初期化
		CALL M_KOJO_K103_RESETTW
		RETURN 1
	ELSEIF TCVAR:350 >= 2 && TCVAR:350 < 10
		;今日初めて会った時に時止め状態だった
		;邂逅処理を行う
		CALL M_KOJO_K103_MEET
		SELECTCASE TCVAR:350
			CASE 2
				;何もしてない
				PRINTFORML 「앗, ...뭐, 뭐야......라고 %CALLNAME:MASTER%인가...」
				PRINTFORML 「어디서 나온 거야......%M_KOJO_K103_AISATSU()%」
			CASE 3
				;パンツが無い
				PRINTFORML 「엣, ...어라? 뭔가.........아, %CALLNAME:MASTER%...」
				PRINTFORML 「...그게...%M_KOJO_K103_AISATSU()%」
			CASE 4
				;快感が走ってる
				PRINTFORML 「앗!? ………아, %CALLNAME:MASTER%…」
				PRINTFORML 「…아니야, 아무것도 아니야, 아무것도 아니라고……%M_KOJO_K103_AISATSU()%」
			CASE 5
				;絶頂した
				PRINTFORML 「흐윽……아……%CALLNAME:MASTER%…」
				PRINTFORML 「………%M_KOJO_K103_AISATSU()%…」
		ENDSELECT
		;時止めフラグ初期化
		CALL M_KOJO_K103_RESETTW
		RETURN 1
	ENDIF
	LOCAL:1 = M_KOJO_K103_KANKEI()
	SELECTCASE LOCAL:1
		CASE 11, 12, 21, 22
			;関係が普通もしくは同行許可かつ機嫌がいい
			IF ALCOHOL_FACE(TARGET) == "酔いどれ" || ALCOHOL_FACE(TARGET) == "ぐでぐで"
				;酔ってる
				PRINTFORML 「우으... 끅... 듣고 있어요~, ...듣고 있어요... 네」
				PRINTFORML 「저, 무슨 이야기였더라...?」
			ELSEIF TFLAG:193 == 0
				$KAIWA01
				;会話成功時
				IF TCVAR:103:350 == 11 || TCVAR:103:350 == 15
					;時止め解除：通常
					PRINTFORML 「앗, 깜짝이야!」
					PRINTFORMW 「\@ LOCAL:1 > 20 ? 당신 # %CALLNAME:MASTER% \@ 갑자기 나타나지 않았어?」
				ELSEIF TCVAR:103:350 == 12 || TCVAR:103:350 == 16
					;時止め解除：パンツ
					PRINTFORML 「스스스하다……아, 정말 뭐야 대체…」
					PRINTFORMW 「…아, 미안. 뭐 말했어?」
				ELSEIF TCVAR:103:350 == 13 || TCVAR:103:350 == 17
					;時止め解除：快感
					PRINTFORML 「음... 뭐지?」
					PRINTFORMW 「...용건이라면 나중에 해줬으면 해」
				ELSEIF TCVAR:103:350 == 14 || TCVAR:103:350 == 18
					;時止め解除：絶頂
					PRINTFORML 「...응윽... 헉...!」
					PRINTFORMW 「...어? 아무것도 아니야, 아무것도 없어」
				ELSE
					IF FLAG:デート相手 == 103 || CFLAG:同行
						;未実装らしいのでこっちで回収 実装後は要修正
						CALL M_KOJO_MESSAGE_COM_K103_600_1
					ELSE
						SELECTCASE M_KOJO_K103_RANDNR(5,300)
							CASE 1
								PRINTFORML 「나랑 수다 떠는 것도 즐겁지는 않다고 생각하지만...」
								PRINTFORMW 「뭐, 시간 때우기 정도라면 들어줄게」
							CASE 2
								PRINTFORML 「일단 나도 메이드의 한 조각이긴 하지만...」
								IF LOCAL:1 > 20
									PRINTFORML 「청소가 도저히 서툴러서 말이야…」
									PRINTFORMW 「그러고 보니 %조사처리(CALLNAME:MASTER,"는")% 청소가 일이라고 하던 거네요.」
								ELSE
									PRINTFORMW 「주로 사고 담당이네…」
								ENDIF
							CASE 3
								PRINTFORML 「그때 마리사의 얼굴은 정말이지...」
								IF CFLAG:102:現在位置 != CFLAG:103:現在位置
									PRINTFORML 「맞아, 그때의 마리사는 말이야…」
									PRINTFORML
									IF CFLAG:11:現在位置 == CFLAG:103:現在位置
										PRINTFORMDL 뒤에서 굉장한 시선이 느껴진다...
										PRINTFORMDW 차가운 것을 느끼고, %조사처리(CALLNAME:MASTER,"는")% 황급히 화제를 돌렸다.
									ELSE
										PRINTFORMDL 이거 들어도 되는 이야기일까...
										PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 어쩐지 화제를 돌렸다
									ENDIF
								ELSE
									;神綺が同じ場所にいる場合
									PRINTFORMW 「신키님도 그렇게 생각하시죠?」
								ENDIF
							CASE 4
								PRINTFORML 「왠지 요즘 팬티가 사라지는 소동이 일어나고 있나 봐?」
								PRINTFORML 「이상...일지도 모르겠네......응? 무슨 일이야?」
								PRINTFORMW 「그, 아무것도 아니면 됐지만」
							CASEELSE
