;==================================================
;150,胸の谷間を犯す
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K103_150
RETURN 1

@M_KOJO_MESSAGE_COM_K103_150
CALL M_KOJO_MESSAGE_COM_K103_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K103_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;谷間潤滑チェック
	LOCAL:2 = M_KOJO_K103_B_WET()
	;地の文を移動させているため口上色を変更
	SIF FLAG:口上色
		CALL M_KOJO_COLOR_K103
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:70
		PRINTFORML 「저, 잠깐만요, 가슴을 그렇게 난폭하게!」
		PRINTFORMW 「앗, 응윽, 정말이지!!」
		PRINTFORMW 「히끅... 그, 유두를 만지지 마세요... 아으윽 %M_KOJO_K103_HEART()%」
		PRINTFORML
		RETURN 1
	ENDIF
	;地の文 意図に沿わないので持ってきた
	IF SELECTCOM == PREVCOM
		PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")%
		SIF FLAG:70 == 1
			PRINTFORMD 시간을 멈췄다
		SIF CFLAG:MASTER:イタズラ == 2
			PRINTFORMD 잠들어 있다
		PRINTFORMD %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET,1)%
		IF RAND:2
			IF RAND:3 == 0
				PRINTFORMD 의 유륜을 엄지손가락으로 간지럽히면서
			ELSEIF RAND:2
				PRINTFORMD %NIPPLE_DESCRIPTION(TARGET,1)%을 손가락으로 만지작거리며
			ELSE
				PRINTFORMD 을 구겨가며
			ENDIF
		ELSE
			IF RAND:4 == 0
				PRINTFORMD 안쪽으로 모으면서
			ELSEIF RAND:3 == 0
				PRINTFORMD 를 밀착시키면서
			ELSEIF RAND:2
				PRINTFORMD 를 조이면서
			ELSE
				PRINTFORMD 를 압박하면서
			ENDIF
		ENDIF
		IF EXP:PLAYER:Ｖ性交経験 + EXP:PLAYER:Ａ性交経験 && RAND:2
			IF RAND:3 == 0
				PRINTD 성교라도 하는 것처럼
			ELSEIF RAND:2
				PRINTFORMD 유방을 임신시키려고
			ELSE
				PRINTD 마치 교미하는 것처럼
			ENDIF
		ENDIF
		SIF RAND:2
			PRINTFORMD 체력이 허락하는 한
		IF ABL:PLAYER:サドっ気 && RAND:3 == 0
			PRINTFORMDL 거칠게 허리를 움직이며
		ELSEIF RAND:2
			PRINTFORMDL 허리를 격렬하게 움직였다.
		ELSE
			PRINTFORMDL 허리를 앞뒤로 움직인다
		ENDIF
		IF RAND:3
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET)%을
		ELSE
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET)%의 골짜기를
		ENDIF
		IF RAND:2 == 0
			PRINTFORMDL 계속 저지르고 있어...
		ELSE
			PRINTFORMDL 계속 저질렀다...
		ENDIF
	ELSE
		PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")%
		SIF FLAG:70 == 1
			PRINTFORMD 시간을 멈췄다
		SIF CFLAG:MASTER:イタズラ == 2
			PRINTFORMD 잠들어 있다
		PRINTFORMD %조사처리(CALLNAME:TARGET,"의")%
		;貧乳
		IF TALENT:バストサイズ == -1
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)%를 비볐다.
			;巨乳
		ELSEIF TALENT:バストサイズ == 1
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 문질러 올린다.
			;爆乳
		ELSEIF TALENT:バストサイズ == 2
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 문질러 올린다.
			;超乳
		ELSEIF TALENT:バストサイズ == 3
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)% 밀어붙여 문지른다
		ELSE
			PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 문질러 올린다.
		ENDIF
		PRINTDL 음...
		PRINTFORMD %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET)%
		IF RAND:2
			IF RAND:3 == 0
				PRINTFORMD 의 유륜을 엄지손가락으로 간지럽히면서
			ELSEIF RAND:2
				PRINTFORMD %NIPPLE_DESCRIPTION(TARGET,1)%을 손가락으로 만지작거리며
			ELSE
				PRINTFORMD 을 구겨가며
			ENDIF
		ELSE
			IF RAND:4 == 0
				PRINTFORMD 안쪽으로 모으면서
			ELSEIF RAND:3 == 0
				PRINTFORMD 를 밀착시키면서
			ELSEIF RAND:2
				PRINTFORMD 를 조이면서
			ELSE
				PRINTFORMD 를 압박하면서
			ENDIF
		ENDIF
		IF EXP:PLAYER:Ｖ性交経験 + EXP:PLAYER:Ａ性交経験 && RAND:2
			IF RAND:3 == 0
				PRINTD 성교라도 하는 것처럼
			ELSEIF RAND:2
				PRINTFORMD 유방을 임신시키려고
			ELSE
				PRINTD 마치 교미하는 것처럼
			ENDIF
		ENDIF
		IF ABL:PLAYER:サドっ気 && RAND:3 == 0
			PRINTFORMDW 거칠게 허리를 움직였다...
		ELSEIF RAND:2
			PRINTFORMDW 허리를 격렬하게 움직였다...
		ELSE
			PRINTFORMDW 허리를 앞뒤로 움직였다...
		ENDIF
		IF !FLAG:70 && CFLAG:MASTER:イタズラ != 2
			PRINTFORMD %조사처리(CALLNAME:TARGET,"는")%(는) 가슴골을 범당했다
			;恋慕か親愛（愛欲の有無でちょっと分岐）
			IF TALENT:愛欲
				PRINTFORMDL \@ TALENT:恋慕 ? 황홀하게 # 녹아내린 \@ 표정을 하고 있다…
			ELSE
				PRINTFORMDL 하고 있다...
			ENDIF
			IF ABL:PLAYER:技巧 > 2
				;プレイヤーの技巧3以上
				;胸で分岐させてサイズはSELECTCASEで分けてみる。大きさは違ってもその先に突起はあるんだよ
				SELECTCASE TALENT:バストサイズ
					;きょにゅー以上
					CASE IS > 0
						IF RAND:2 == 0
							PRINTFORMDL 통통하게 채워진 살과 살, %OPPAI_DESCRIPTION(TARGET,1)% 사이에 %TINKO(PLAYER)%를 끼우고 농락한다.
							PRINTDL 촉촉하게 감싸 안으며 부드럽지만 끝까지 단단한 육봉을 받아들인다.
							PRINTDL 가라앉는 듯한 기분은 마치 살의 바다에 녹아드는 듯한 감각이다...
						ELSE
							PRINTFORMDL 그 %OPPAI_DESCRIPTION(TARGET,1)%에 %TINKO(PLAYER)%를 밀어붙이고, 충분히 %OPPAI_DESCRIPTION(TARGET)%의 중압을 가한 상태에서,
							PRINTFORMDL %조사처리(CALLNAME:PLAYER,"의")% %TINKO(PLAYER)%를 쑤셔 넣는다.
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 살이 부드럽고 압도적인 양감으로 닿는 느낌에, %조사처리(CALLNAME:PLAYER,"는")% 빨려 들어간다...
						ENDIF
						SIF LOCAL:2 >= 3 && LOCAL:2 < 5
							PRINTFORMDL 적당히 젖은 %TINKO(PLAYER)%는 가슴에 부딪힐 때마다 눅눅, 파직파직 소리를 낸다.
						SIF LOCAL:2 >= 3
							PRINTFORMDL 축축하게 젖은%TINKO(PLAYER)%은, 가슴에 부딪힐 때마다 주푸주푸, 바츄바츄 소리를 낸다.
						PRINTDL 미끌거리는 살과 살은 밀어 넣을수록 단단한 페니스를 어디까지나 받아들이고, 깊이 가라앉을수록 부드러운...
						SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
							PRINTFORMDL 그 안에서 복숭아빛이 도는 %OPPAI_DESCRIPTION(TARGET,1)%의 끝, %NIPPLE_DESCRIPTION(TARGET,1)%가 때때로 바늘이나 칼을 비비듯 간질인다…
						;ひんぬー以下
					CASE IS < 0
						PRINTFORMDL 물리적인 핸디캡을 경험과 기술로 보충하려 %OPPAI_DESCRIPTION(TARGET,1)%를 사용해 %TINKO(PLAYER)%에게 봉사하고 있다.
						SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
							PRINTFORMDL 상기된 가슴팍의 끝에 있는 %NIPPLE_DESCRIPTION(TARGET,1)%으로 남성기나 칼을 문지르듯이 정중하게 유도해 온다.
						;ふにゅぅ
					CASEELSE
						PRINTFORMDL %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 끼고, 주무른다.
						SIF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000
							PRINTFORMDL 이따금 땀으로 축축해진 %OPPAI_DESCRIPTION(TARGET,1)%의 봉우리, %NIPPLE_DESCRIPTION(TARGET,1)%에 막이나 칼을 비비며 달콤한 목소리를 낸다.
				ENDSELECT
			ELSEIF ABL:PLAYER:技巧 <= 2
				;胸2以下
				;貧乳
				IF TALENT:バストサイズ == -1
					PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)%로 필사적으로 %TINKO(PLAYER)%를
					;巨乳
				ELSEIF TALENT:バストサイズ == 1
					PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)%로 %TINKO(PLAYER)%를 감싸 안았다.
					;爆乳、超乳
				ELSEIF TALENT:バストサイズ >= 2
					PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)%으로 %TINKO(PLAYER)%를 감싸듯 하여
				ELSE
					PRINTFORMD %OPPAI_DESCRIPTION(TARGET,1)%으로 %TINKO(PLAYER)%를 끼우고
				ENDIF
				PRINTDL 올려지고 있다...
			ELSE
			ENDIF
		ENDIF
	ENDIF
	IF FLAG:70 == 1 || CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ENDIF
	PRINTDW 
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE M_KOJO_K103_RANDNR(4,150)
			CASE 1
				PRINTFORMW 「아, 정말! 그렇게까지 세게 할 필요 없잖아요!」
				PRINTL
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하면서도 옆구리를 조이고, %OPPAI_DESCRIPTION(TARGET,1)%를 안쪽으로 꽉 밀착시켜 주었다.
				PRINTDW 밀착도가 올라가면서 쾌감이 강해지고 머릿속이 저릿한 감각이 머리로 올라왔다.
				PRINTL
				PRINTFORMW 「후후, 기분 좋아 보이는 얼굴...%M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「젖꼭지를 잡고 흔들리니, 나도 히기익... %M_KOJO_K103_HEART()%」
