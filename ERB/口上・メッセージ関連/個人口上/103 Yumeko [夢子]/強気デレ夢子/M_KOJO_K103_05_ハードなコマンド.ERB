				PRINTL
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하면서 손으로 가슴 옆을 잡고,
				PRINTFORMDW %OPPAI_DESCRIPTION(TARGET,1)%를 이쪽 허리의 움직임에 맞춰 흔들었다
				PRINTFORMDW 세차게 부딪치는 %TINKO(PLAYER)%의 밑동이, 파칭! 파칭! 소리를 내고 있다
				PRINTL
				PRINTFORMW 「언제라도, 해줘, 괜찮으니까%M_KOJO_K103_HEART()%」
		ENDSELECT
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		SELECTCASE M_KOJO_K103_RANDNR(4,150)
			CASE 1
				PRINTFORMW 「아, 정말! 그렇게 거칠게 하지 마!」
				PRINTL
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 몸을 살짝 비틀자, %OPPAI_DESCRIPTION(TARGET,1)%의 압박감이 더해졌다.
				PRINTFORMDW 기분 좋아진 것에 대한 보답으로, 붙잡고 있는 %OPPAI_DESCRIPTION(TARGET,1)%의 유두를 주무르듯 만다.
				PRINTL
				PRINTFORMW 「あ읏、ちょと읏…ああん읏%M_KOJO_K103_HEART()%」
			CASE 2
				PRINTFORMW 「유두 잡아 흔들지 말아 줘, 아, 안...%M_KOJO_K103_HEART()%」
