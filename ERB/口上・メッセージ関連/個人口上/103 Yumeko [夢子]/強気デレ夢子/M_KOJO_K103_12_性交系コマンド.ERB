;時姦しか対面立位無くない…？…いや、身長が相当一致しない限り不可能だし。駅弁になるけどもさ…？
;-------------------------------------------------
;立位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:70
		;処女
		IF TCVAR:破瓜 == 1 && !FLAG:70
			IF ALCOHOL_FACE(TARGET) == "酔いどれ" || ALCOHOL_FACE(TARGET) == "ぐでぐで"
				;酔ってる
				PRINTFORML 「이...윽...뭐, 뭐야...? 아파...」
				PRINTFORMW 「아...하지만...조금 몽롱한 것 같아...?」
				PRINTFORMDL
				PRINTFORMDL 처녀를 잃었음을 보여주는 피가 %조사처리(CALLNAME:TARGET,"의")% 다리를 타고 흐른다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 상황을 잘 파악하지 못한 듯, 통증을 달래려는 듯 허리를 움직이고 있다.
				PRINTFORMDW 눌러 담듯이 깊숙이 삽입하자, 미지의 감각에 %조사처리(CALLNAME:TARGET,"의")% 허리가 살짝 들렸다.
				PRINTFORMDL
				PRINTFORMW 「아윽……아흑……흐응……」
				PRINTFORMDL
				PRINTFORMDW 심박수가 올라 더 취했는지, %조사처리(CALLNAME:TARGET,"의")% 얼굴이 유난히 붉어진다.
				PRINTFORMDW 탐욕스럽게 허리를 흔들자, %조사처리(CALLNAME:TARGET,"는")% 조금씩 신음소리를 내기 시작했다...
			ELSE
				PRINTFORML
				PRINTFORML 「흥... 크윽......... 꽤 아픈 거네...」
				PRINTFORMDL
				PRINTFORMDL 파과(破瓜)의 피가 두 사람의 결합부를 적셔간다…
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 아랫입술을 살짝 깨물고, 통증에 견디는 듯하다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 부드럽게, 깊숙이 파고들며 삽입해 나간다.
				PRINTFORML
				PRINTFORML 「흐윽... 윽... 소름이 돋아......」
				PRINTFORML
				PRINTFORMDW 이미 익숙해진 건지, %조사처리(CALLNAME:TARGET,"는")% 무의식인지 깊숙이 쿵쿵 부딪히듯이 허리를 흔들기 시작했다.
				PRINTFORMDL 필요 이상으로 아프게 하지 않아 안도한 것과 동시에, 탐욕스러운 몸을 감당하기 힘들어하는 %조사처리(CALLNAME:TARGET,"에게")% 약간 어이없어하면서
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 탐닉하듯이 허리를 흔들기 시작했다…
				PRINTFORML
			ENDIF
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
