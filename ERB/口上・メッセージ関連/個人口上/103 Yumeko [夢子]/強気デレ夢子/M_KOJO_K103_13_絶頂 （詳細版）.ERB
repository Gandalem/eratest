; Modular ERB: 個人口上/103 Yumeko [夢子]/強気デレ夢子/M_KOJO_K103_13_絶頂 （詳細版）.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K103
#DIM 絶頂強度
絶頂強度 = NOWEX:0 + NOWEX:1 + NOWEX:2 + NOWEX:3 + NOWEX:4 + NOWEX:10 + NOWEX:11 + NOWEX:12
;この口上では全てをおっぱい基準で進めます
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時止めの時は表示しない
	SIF FLAG:70
		RETURN 1
	;1行挟みたい
	PRINTFORML
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:五重絶頂
		PRINTFORML 「%M_KOJO_K103_IKU(3)%…갈 것 같아 갈 것 같아... 가윽... 이잇........... 큭... 아... 아... %M_KOJO_K103_HEART(2)%......... 아... %M_KOJO_K103_HEART(2)%」
		PRINTFORMDL
		IF NOWEX:噴乳
			IF TEQUIP:乳首吸い
				PRINTFORML 「「%M_KOJO_K103_OG(2)%%M_KOJO_K103_HEART(1)%%CALLNAME:MASTER%、마셔라%M_KOJO_K103_HEART(1)% 잔뜩 마셔줘!」%M_KOJO_K103_HEART(2)%」
				PRINTFORMDL
				PRINTFORMDL 모유를 줄줄 흘리는 유두에 더 빨려주길 바라며, 유메코는 %조사처리(CALLNAME:MASTER,"의")% 머리를 가슴에 누르듯이 끌어안았다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 그에 응답하듯, 뿜어져 나오는 모유를 마시면서 다시 유두를 세게 빨아들이자, 유메코는 등을 아치형으로 만들며 느슨한 미소를 지었다.
			ELSE
				PRINTFORML 「앗 %M_KOJO_K103_HEART(1)% 젖이 멈추지 않아 %M_KOJO_K103_HEART(2)% 멈출 수 없어... %M_KOJO_K103_HEART(2)% 아악... %M_KOJO_K103_HEART(2)%」
				PRINTFORMDL 흥건하게 계속 분수처럼 뿜어져 나오는 모유를 보며, 이미 우유송 같은 거라고 생각하면서
			ENDIF
		ENDIF
		PRINTFORMDL 유메코의 얼굴을 보자, 경련하며 위를 향한 채 고개를 숙이지 못하고 교성조차 제대로 지르지 못하는 듯했다.
		PRINTFORMDL 
		PRINTFORML 「하아... 아... %CALLNAME:MASTER%... %CALLNAME:MASTER%%M_KOJO_K103_HEART(2)%」
		PRINTFORMDL
		PRINTFORMDL 파르르, 파르르 떨면서 %조사처리(CALLNAME:MASTER,"의")% 이름을 중얼거리는 그 모습을 보고 있으면, 자신 안의 지배욕이 채워지는 것을 느낀다...
		PRINTFORMDL 유메코는 지금 머리 꼭대기부터 발끝까지, 스스로에게 주어지는 쾌감에 잠겨 있는 것이다
		IF NOWEX:放尿
			PRINTFORMDL
			PRINTFORML 「에헤...%M_KOJO_K103_HEART(1)%……아……아아……%M_KOJO_K103_HEART(2)%」
			PRINTFORMDL
			PRINTFORMDL 유메코의 질에서 끊임없이 나오는 액체는, 이미 애액인지, 조(潮)인지, 소변인지 눈으로 구별할 수 없지만
			PRINTFORMDL 자욱하게 풍기는 소변 냄새로, 지금 그녀가 지리고 있다는 것을 알았다
			PRINTFORMDL 유메코가 자신의 몸을 지탱하지 못하고 자세를 무너지자, 푸슉 하고 소변이 세차게 튀어 %CALLNAME:MASTER%에 튀었다
		ENDIF
		PRINTFORMDL
		PRINTFORMDL 두 사람이 있는 곳은 온몸의 수분을 다 짜낸 것 같을 정도로 구겨져 있었다...
		PRINTFORMDW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:四重絶頂
		PRINTFORML 「%M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART(1)%……%M_KOJO_K103_IKU(3)%……아아악…!!!%M_KOJO_K103_HEART(2)%」
		IF NOWEX:噴乳
			IF TEQUIP:乳首吸い
				PRINTFORML 「%M_KOJO_K103_OG(2)%, %M_KOJO_K103_OG(2)%%M_KOJO_K103_HEART(1)%%CALLNAME:MASTER%, 마셔라%M_KOJO_K103_HEART(1)% 마시라고! %M_KOJO_K103_HEART(2)%」
				PRINTFORMDL
				PRINTFORMDL 모유를 뿜어내는 유두에 더 달라붙어 주길 바라는 듯, 유메코는 %조사처리(CALLNAME:MASTER,"의")% 머리를 가슴에 밀어 넣듯이 끌어안았다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 그것에 응하듯 다시 유두를 세게 빨아들이자, 유메코는 등을 뒤로 젖히며 느슨한 미소를 지었다.
			ELSE
				PRINTFORML 「앗 %M_KOJO_K103_HEART(1)% 가슴이 멈추지 않아 %M_KOJO_K103_HEART(2)% 멈추지 않을 거야아! %M_KOJO_K103_HEART(2)%」
				PRINTFORMDL
				PRINTFORMDL 벌써 아무것도 생각할 수 없는 건가, 모유가 나오는 감각이 아직 쾌감을 붙잡고 있는 건가, 유메코가 떨 때마다 모유는, 푸슉, 하고 간헐적으로 뿜어져 나오고 있었다.
				PRINTFORMDL 그대로 경련하는 유메코의 몸은 모유를 뿌리고 주변을 가리지 않고 흰색으로 물들였다.
			ENDIF
		ENDIF
		IF NOWEX:放尿
			PRINTFORMDL
			PRINTFORML 「아, 아아...%M_KOJO_K103_HEART(1)%......실수했어...아.........헤헤...%M_KOJO_K103_HEART(2)%」
			PRINTFORMDL
			PRINTFORMDL 이제 유메코에게는 참는다는 생각이 사라진 건지, 고장난 수도꼭지처럼 졸졸 소변이 흘러나오고 있다.
			PRINTFORMDL 그 감각조차 기분 좋은 건지, 소변이 다 나온 후, 유메코는 무의식적으로 요도를 쓰다듬기 시작했다.
		ENDIF
		PRINTFORMDL
		PRINTFORML 「엄청 해버렸어... %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)%...... 이제, 모든 게 상관없을 정도로... 기분 좋아... %M_KOJO_K103_HEART(1)%」
		PRINTFORMDL
		PRINTFORMDL 그렇게 말하는 유메코는 초점이 약간 풀린 눈으로 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다.
		PRINTFORMDW 그 얼굴을 보고, %조사처리(CALLNAME:MASTER,"는")% 만족했던 지배욕이 다시 고개를 드는 것을 느꼈다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:三重絶頂
		PRINTFORML 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_IKU(2)%…%M_KOJO_K103_HEART(1)%……%M_KOJO_K103_IKU(3)%…!!%M_KOJO_K103_HEART(1)% 굉장한 게 온다…!!%M_KOJO_K103_HEART(1)%」
		IF NOWEX:噴乳
			IF TEQUIP:乳首吸い
				PRINTFORML 「%CALLNAME:MASTER%, 마셔라! %M_KOJO_K103_HEART(1)% %M_KOJO_K103_OG(2)%%M_KOJO_K103_HEART(1)% 유두 좋은 거야, 머리가 터질 것 같은걸! %M_KOJO_K103_HEART(2)%」
				PRINTFORMDL
				PRINTFORMDL 모유를 뿜어내는 유두에도 더 달라붙어 주길 바라며, 유메코는 %조사처리(CALLNAME:MASTER,"의")% 머리를 가슴에 안았다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 그것에 응하듯 유두를 빨아들이자, 유메코는 등을 아치형으로 만들고 쾌감을 탐하고 있었다.
			ELSE
				PRINTFORML 「앗 %M_KOJO_K103_HEART(1)% 가슴 굉장하네 %M_KOJO_K103_HEART(1)% 봐봐 %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)%」
				PRINTFORMDL
				PRINTFORMDL 유메코는 흘러넘치는 모유를 %CALLNAME:MASTER%에 보이며 자랑한다.
				PRINTFORMDL 주변은 모유의 비릿함과 달콤함이 섞인 냄새로 가득 차 있다…
			ENDIF
		ENDIF
		IF NOWEX:放尿
			PRINTFORMDL
			PRINTFORML 「아, 아아……%M_KOJO_K103_HEART(1)%」
			PRINTFORMDL
			PRINTFORMDL 한심한 소리를 내고 난 후, 다시 유메코의 음순에서 오줌이 주르륵 분수처럼 뿜어져 나왔다.
			PRINTFORMDL 모든 것을 다 비우자 유메코는 탈력했고, 자신이 흘린 오줌을 튀기며 축축한 소리를 냈다.
		ENDIF
		PRINTFORMDL
		PRINTFORML 「왜 이렇게 기분 좋은 거야... %CALLNAME:MASTER%? %M_KOJO_K103_HEART(1)%……왜...? %M_KOJO_K103_HEART(1)%」
		PRINTFORMDL
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"를")% 보며 유메코는 입을 반쯤 벌린 채 멍하니 있었다.
		PRINTFORMDW 더 그 감각을 가르쳐주고 싶어, %조사처리(CALLNAME:MASTER,"는")% 비틀거리는 유메코를 다시 한번 끌어안았다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:二重絶頂
		PRINTFORML 「%M_KOJO_K103_AEGI()%…이제 안 돼……%M_KOJO_K103_IKU(2)%…%M_KOJO_K103_HEART(1)%……%M_KOJO_K103_IKU(2)%…!!%M_KOJO_K103_HEART(1)%」
		IF NOWEX:噴乳
			IF TEQUIP:乳首吸い
				PRINTFORML 「더 마셔줘%M_KOJO_K103_HEART(1)% %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)% %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)%%M_KOJO_K103_OG(2)%%M_KOJO_K103_HEART(1)%」
				PRINTFORMDL
				PRINTFORMDL 모유를 뿜어내는 유두에도 더 붙어주길 바랐던 유메코는 %조사처리(CALLNAME:MASTER,"의")% 머리를 가슴에 안았다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 이에 응하듯 유두를 빨아들이자, 유메코는 표정을 녹였다.
			ELSE
				PRINTFORML 「아앗 %M_KOJO_K103_HEART(1)% 가슴 아직 나와버렸어 %M_KOJO_K103_HEART(1)%」
				PRINTFORMDL
				PRINTFORMDL 유메코는 나오는 모유를 %CALLNAME:MASTER%에 보여주고 온다.
				PRINTFORMDL 주변은 모유의 비릿함과 단내가 섞인 냄새로 가득 차 있다...
			ENDIF
		ENDIF
		IF NOWEX:放尿
			PRINTFORMDL
			PRINTFORML 「아, 안 돼...%M_KOJO_K103_HEART(1)%」
			PRINTFORMDL
			PRINTFORMDL 참지 못했는지, 다시 유메코의 음순에서 소변이 분출했다.
			PRINTFORMDL 모든 것을 다 내보내고 나자 유메코는 남아있던 긴장이 풀렸는지, 자신이 본 소변의 따뜻함을 느끼고 있었다.
		ENDIF
		PRINTFORMDL
		PRINTFORML 「기분 좋아... %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)%.... 방금 거, 굉장했어... %M_KOJO_K103_HEART(1)%」
		PRINTFORMDL
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"를")% 보면서 유메코는 눈을 풀고 멍하니 있었다.
		PRINTFORMDW
		RETURN 1
	ENDIF
	IF NOWEX:Ｃ絶頂
		;超強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 == 3
			PRINTFORMW 「앗 %M_KOJO_K103_HEART(1)% %M_KOJO_K103_IKU(2)%%M_KOJO_K103_HEART(1)% %M_KOJO_K103_IKU(3)%%M_KOJO_K103_HEART(1)% %M_KOJO_K103_OG(1)%…아, 더는 아무것도 모르겠어, 생각할 수가 없어!! %M_KOJO_K103_HEART(2)%」
			;強絶頂Ｃ
		ELSEIF NOWEX:Ｃ絶頂 == 2
			PRINTFORMW 「앗 %M_KOJO_K103_HEART(1)% %M_KOJO_K103_OG(1)%%M_KOJO_K103_HEART(1)% %M_KOJO_K103_IKU(2)%%M_KOJO_K103_HEART(1)%」
			;絶頂Ｃ
		ELSE
			PRINTFORMW 「앗 %M_KOJO_K103_HEART(1)% %M_KOJO_K103_OG(1)%%M_KOJO_K103_HEART(1)% 아...아......%M_KOJO_K103_IKU(1)%%M_KOJO_K103_HEART(1)%」
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;超強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 == 3
			PRINTFORMW 「아앙…%M_KOJO_K103_HEART(1)% %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)%、%CALLNAME:MASTER%%M_KOJO_K103_HEART(1)%、%M_KOJO_K103_OG(4)%%M_KOJO_K103_HEART(1)% %M_KOJO_K103_GET("ヴァギナ")%꾸욱꾸욱이라니…… 아…%M_KOJO_K103_IKU(3)%읏……!!!%M_KOJO_K103_HEART(2)%」
			;強絶頂Ｖ
		ELSEIF NOWEX:Ｖ絶頂 == 2
			PRINTFORMW 「%M_KOJO_K103_OG(4)%…기분 좋아…… %CALLNAME:MASTER%%M_KOJO_K103_HEART(1)% 아…아… %M_KOJO_K103_IKU(2)%…가버릴 것 같아!! %M_KOJO_K103_HEART(2)%」
			;絶頂Ｖ
		ELSE
			PRINTFORMW 「%M_KOJO_K103_OG(4)%…%M_KOJO_K103_HEART(1)% 아……%M_KOJO_K103_IKU(1)%앗!! %M_KOJO_K103_HEART(1)%」
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;超強絶頂Ａ
		IF NOWEX:Ａ絶頂 == 3
			PRINTFORMW 「「%M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(5)%…%M_KOJO_K103_HEART(1)% 아…%M_KOJO_K103_AEGI()%…%M_KOJO_K103_IKU(3)%!!%M_KOJO_K103_HEART(2)%」
			;強絶頂Ａ
		ELSEIF NOWEX:Ａ絶頂 == 2
			PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART(1)% 아…%M_KOJO_K103_OG(5)%%M_KOJO_K103_AEGI()%…%M_KOJO_K103_IKU(2)%! %M_KOJO_K103_HEART(1)%」
			;絶頂Ａ
		ELSE
			PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(5)%…%CALLNAME:MASTER%…%M_KOJO_K103_HEART(1)% %M_KOJO_K103_AEGI()%……%M_KOJO_K103_IKU(1)%っ！！%M_KOJO_K103_HEART(1)%」
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;強絶頂Ｂ
		IF NOWEX:Ｂ絶頂 == 3
			PRINTFORMW 「%M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(2)%…%M_KOJO_K103_HEART(1)% %M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%%M_KOJO_K103_IKU(3)%っ！！%M_KOJO_K103_HEART(2)%」
			;強絶頂Ｂ
		ELSEIF NOWEX:Ｂ絶頂 == 2
			PRINTFORMW 「%M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(2)%…%M_KOJO_K103_HEART(1)% %M_KOJO_K103_AEGI()%…乳首…%M_KOJO_K103_IKU(2)%っ！！%M_KOJO_K103_HEART(1)%」
			;絶頂Ｂ
		ELSE
			PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(2)%…%M_KOJO_K103_HEART(1)% %M_KOJO_K103_AEGI()%…가슴으로……%M_KOJO_K103_IKU(1)%앗!!%M_KOJO_K103_HEART(1)%」
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;超強絶頂Ｍ
		IF NOWEX:Ｍ絶頂 == 3
			PRINTFORMW 「%M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%…%M_KOJO_K103_HEART(1)% %M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(3)%윽!…%M_KOJO_K103_IKU(3)%!!%M_KOJO_K103_HEART(2)%」
			;強絶頂Ｍ
		ELSEIF NOWEX:Ｍ絶頂 == 2
			PRINTFORMW 「%M_KOJO_K103_AEGI()%%M_KOJO_K103_AEGI()%...%M_KOJO_K103_OG(3)%...%M_KOJO_K103_HEART(1)% %M_KOJO_K103_AEGI()%...안 돼...%M_KOJO_K103_IKU(2)%!!%M_KOJO_K103_HEART(1)%」
			;絶頂Ｍ
		ELSE
			PRINTFORMW 「%M_KOJO_K103_AEGI()%…%M_KOJO_K103_OG(3)%…%M_KOJO_K103_HEART(1)% 아……%M_KOJO_K103_IKU(1)%!!%M_KOJO_K103_HEART(1)%」
		ENDIF
	ENDIF
	;1行挟みたい
	PRINTFORML
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K103
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
