; Modular ERB: 個人口上/050 Flandre [フラン]/eTWたらこフラン/M_KOJO_K50_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K50
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K50
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:苦痛刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:苦痛刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:苦痛刻印取得 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 
ENDIF
;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORMW 「장난치는 건 좋지 않아, 오빠(오니이사마).」
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORMW 「오빠, 알고 있었어? 타라코는 나쁜 아이들이 있는 곳으로 갈 거야.」
	PRINTFORMW 「타라코가 아주아주 많이 올 테니까, 알겠지?」
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORMW 「오빠는 나쁜 아이니까 타라코가 분명히 너를 찾아올 거야!」
ENDIF
