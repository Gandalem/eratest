@M_KOJO_MESSAGE_COM_K50_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K50_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K50_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;時間停止中は無言 喋らせる際は;を消して「台詞」を加筆の事
	IF FLAG:70 == 1 && CFLAG:TARGET:344 == 0
		;PRINTFORML 「」
		RETURN 1
	ENDIF
	;睡眠中
	IF CFLAG:睡眠 == 1
		RETURN 1
	ENDIF
	;時間停止以外でシラフでない場合
	IF !SHIRAHU(TARGET)
		;PRINTFORML 「」
		RETURN 1
	ENDIF
	;相手主導押し倒され中
	IF CFLAG:うふふ == 2
		;ちんこついてる
		IF TALENT:TARGET:2 & 2
			;PRINTFORML 「」
			;ちんこついてない
		ELSE
			;PRINTFORML 「」
		ENDIF
		RETURN 1
	ENDIF
	;あなた主導押し倒し中
	IF CFLAG:うふふ == 1
		;PRINTFORML 「」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;特殊分岐 使用時にはコメントアウトを解放してください
	;-------------------------------------------------
	;妊娠中
	;IF TALENT:妊娠
	;	PRINTFORML 「」
	;	RETURN 1
	;ENDIF
	;精液ボテ
	;IF !TALENT:妊娠 && EX:TARGET:膣内精液 >= 1000
	;	PRINTFORML 「」
	;	RETURN 1
	;ENDIF
	;マイナスになってもいいさと考えるんだ
	;IF !CFLAG:1502 && CFLAG:信頼度 >= 500 && ABL:教養 > 2 && MONEY >= 300000
	;IF !CFLAG:1502 && CFLAG:信頼度 >= 500 && ABL:教養 > 2
	;	TRYCALLFORM M_KOJO_MESSAGE_COM_K50_進学
	;	RETURN 1
	;ENDIF
	IF 家庭菜園可(CFLAG:MASTER:現在位置) && !GETBIT (TCVAR:350,1)
		SETBIT TCVAR:350,1
		;SELECTCASE PLANT_TYPE_0
		SELECTCASE PLANT_TYPE
			CASE 151
				PRINTFORMW 「아, 양배추 농장이군요.」
				PRINTFORML 「정원에 그렇게 많은 것을 심고 있어요%UNICODE(0x2661)%」
				PRINTFORMW 「오빠, 아기 준비하는 거예요?」
				IF CFLAG:生解禁 <= 2 && TALENT:恋人
					IF CFLAG:16:信頼度 < 500
						PRINTFORML 「하지만 언니는 안 된다고 말해。」
					ELSE
						PRINTFORML 
						PRINTFORML 「좋아,」
						PRINTFORMW 「왜냐하면 %CALLNAME:TARGET%도 오니이상의 아기를 원하거든.」
						PRINTFORMW 「우후후! 어서 와, 오니이상! 양배추밭에서 %조사처리(CALLNAME:TARGET,"를")% 잡으려고 노력해 봐!」
						CFLAG:生解禁 = 2
					ENDIF
				ELSE
					PRINTDATAL
						DATALIST
							DATAFORM 「%CALLNAME:TARGET%에게는 좀 이른 것 같아, 아마도.」
							;ばっちゃに語呂を合わせぱっちぇ呼称
							DATAFORM 「패치이가 그녀의 세키한(첫 생리 축하용 붉은 밥)을 %조사처리(CALLNAME:TARGET,"가")% 갖기 전에 불가능하다고 말한다.」
						ENDLIST
						DATALIST
							DATAFORM 「오빠, 아직 안 돼요.」
							DATAFORM 「억지로 하는 건 안 돼, 알겠지? 후후♪」
						ENDLIST
						DATALIST
							DATAFORM 「원하는 거잖아, 오-니-이사마?」
							DATAFORM 「%조사처리(CALLNAME:TARGET,"는")% 네 눈에서 그걸 볼 수 있어, 결국.」
							DATAFORM 「우후후, 아직은 안 돼.%UNICODE(0x2661)%」
						ENDLIST
					ENDDATA
				ENDIF
			CASE 163
				PRINTFORML 「음, 누님도 어렸을 때 초록색이었나요?」
			CASE 164
				PRINTFORML 「수박씨~ 수박씨~ 크고 튼튼하게 자라렴, 알았지? 수박씨~」
				PRINTFORML 「다 같이 수박 먹자!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 웃는다.
			CASE 177
				PRINTFORML 「이 포도로 와인을 만들자.」
				PRINTFORML 「%조사처리(CALLNAME:TARGET,"는")% 발로 밟는 일을 하고 싶어 해, 알겠지?」
				PRINTFORML 「후훗, 정말 재미있네♪」
				PRINTFORMD %조사처리(CALLNAME:TARGET,"가")% 치맛자락을 살짝 들고, 
				IF TALENT:MASTER:マゾ
					PRINTFORMDL 그리고 그렇게 하면서 그녀의 시선은 당신의 가랑이로 향하고, 작은 발들은 이리저리 쿵쿵거린다.
				ELSE
					PRINTFORMDL 파토마임 포도 밟기 광란 속에서 발을 구르고 있다.
				ENDIF
			CASE 187
				PRINTFORML 「유리~♪ 유리유리~♪」 (Yuri는 백합을 뜻하는 일본어이다)
				PRINTFORML 「오빠, 알았어? 몰랐지? 백합의 뿌리를 먹을 수 있대!」
				SIF TALENT:MASTER:性別 == 3
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 당신의 사타구니를 다소 이상하게 본다.
			CASE 188
				IF TCVAR:媚薬
					PRINTFORML 「오빠, 알고 있었어, 정말로,」
					PRINTFORML 「당근에 레몬을 짜면 애쉬프로데시악이 된다고. 그런데 도대체 애쉬프로데시악이란 게 뭔데?」
				ELSE
					PRINTFORML 「당근 씨♪ 무 씨♪ 표고버섯 씨♪ 양파 씨♪ 구멍이 가득한 연근 씨♪」
					PRINTFORML 「그리고 덩굴이 가득한 쓴오이 씨♪」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;以下日常 とりあえずランダム三枠
	;-------------------------------------------------
	IF TFLAG:193 == 1
		PRINTFORMDW 당신이 말하자 %조사처리(CALLNAME:TARGET,"는")%(는) 고개를 끄덕이며 동의한다.
		RETURN 1
	ELSEIF TFLAG:193 == -1
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 말에 고개를 살짝 흔든다.
		RETURN 1
	ENDIF
	;恋慕 後期
	IF TALENT:恋慕
		IF !RAND:3
			;PRINTFORML 「」
		ELSEIF !RAND:2
			;PRINTFORML 「」
		ELSE
			;PRINTFORML 「」
		ENDIF
		RETURN 1
		;思慕 中期
	ELSEIF TALENT:思慕
		IF !RAND:3
			;PRINTFORML 「」
		ELSEIF !RAND:2
			;PRINTFORML 「」
		ELSE
			;PRINTFORML 「」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF !RAND:3
			;PRINTFORML 「」
		ELSEIF !RAND:2
			;PRINTFORML 「」
		ELSE
			;PRINTFORML 「」
		ENDIF
		RETURN 1
	ENDIF
	;ここに口上書いて下さい
ENDIF
RETURN 1
