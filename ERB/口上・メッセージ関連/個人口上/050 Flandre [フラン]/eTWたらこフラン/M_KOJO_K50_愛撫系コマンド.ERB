;1,クンニ
;==================================================

@M_KOJO_MESSAGE_COM_K50_1
CALL M_KOJO_MESSAGE_COM_K50_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K50_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「오빠, 내 오줌 나오는 데 어디야!」
		PRINTFORMW 「아우우! 핥지 마!!!」
		PRINTFORMW 「안 돼... 응으...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;二回目
	PRINTFORML 「오니이상, 또 핥아줄 거야 %조사처리(CALLNAME:TARGET,"의")% 또다시?」
	PRINTFORMDW 너는 그 생각에 약간 불안해하며 %조사처리(CALLNAME:TARGET,"에게")% 묻는다.
	PRINTFORML 「내 성기가 핥아지면 %CALLNAME:TARGET%기분이 좋아져.」
	PRINTFORMW 「이상하지 않아? %조사처리(CALLNAME:TARGET,"는")% 이상한 여자지, 안 그래?」
	PRINTFORML 
	PRINTFORML 「죄송해요, 오니-사마!」
	PRINTFORMW 「%조사처리(CALLNAME:TARGET,"는")% 이상한 여자라서 죄송해요.」
	PRINTFORML 「미안 미안 미안 미안...」
	PRINTFORML 
	PRINTFORMW 「타라코가 지금부터 %조사처리(CALLNAME:TARGET,"에게")% 올 거야...」
	PRINTFORMW 「흐읍... 히끅... 오니이상. %조사처리(CALLNAME:TARGET,"를")% 미워하지는 않겠지?」
ENDIF
RETURN 1
