;9,自慰
;==================================================

@M_KOJO_MESSAGE_COM_K50_9
CALL M_KOJO_MESSAGE_COM_K50_9_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K50_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「마스터베이트?」
		PRINTFORMW 「내 거 만져줄까? 좋아, %조사처리(CALLNAME:TARGET,"가")% 해볼게.」
		RETURN 1
	ENDIF
	;IF TALENT:恋慕 && TALENT:処女 == 1
	;小さくても大きいと言わせそちんあなたをより情けなくしてみる試み
	;	PRINTFORMW 「ねぇおにいさまぁ。%CALLNAME:TARGET%のちっちゃなおまんこをお兄様のおっきなおちんちんで、ごしごししてください」
	;	RETURN 1
	;ENDIF
	;IF ABL:自慰中毒 >= 5
	;	PRINTFORMW 「おなにーっていけない事なの？たらこきちゃうの？」
	;	PRINTFORMW 「そんな事言われても、指止まんないよぉ」
	;	PRINTFORMW 「酷いよぉお兄様」
	;	PRINTFORMW 「酷いよぉ」
	;	PRINTFORMW 「ごめんなさいたらこさんごめんなさい」
	;	PRINTFORMDW それでも%CALLNAME:TARGET%は自慰をやめられないようだ
	;	RETURN 1
	;ELSEIF ABL:自慰中毒 >= 2
	IF ABL:自慰中毒 >= 2
		PRINTDATAL
			DATAFORM 「내 성기를 비비는 게 정말 좋아...」
			DATAFORM 「%CALLNAME:TARGET%」은(는) 바보가 되어가는 것 같아...
			DATALIST
				DATAFORM 「하아... 하...」
				DATAFORM 「마스터베이팅 기분이 좋아... 마스터베이팅은 정말 좋아, 오니-상...」
			ENDLIST
		ENDDATA
	ELSEIF ABL:自慰中毒 >= 1
		IF BASE:MASTER:勃起 > 1000
			PRINTFORMW 「오빠의 거시기... 점점...」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 눈은 당신의 가랑이에서 떨어지지 못하고, 그녀의 손가락은 빨라지고 침 한 줄기가 입가로 흘러내린다.
			PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"의")% 작고 예쁜 입술에 묻은 침을 닦아준다.
		ELSE
			PRINTFORMW 「오빠아~」
			PRINTFORMW 「%CALLNAME:TARGET%」는 오빠가 자신의 은밀한 곳을 가지고 놀아주기를 원한다.
			SIF CFLAG:TARGET:溜まってる度 / 10 > 750
				PRINTFORMW 「음, 오니이상...? 제발요?」
		ENDIF
	ELSE
		IF !RAND:5
			PRINTFORML 「응, 후우, 음음, 으윽...」
			PRINTFORMW 「응, 후우, 음음, 으윽...」
			PRINTFORMW 「와, 오빠, 이거 정말 기분 좋다.」
			PRINTFORMW 「오빠, 내 곳도 가지고 놀아주지 않을 거야?」
		ELSEIF !RAND:4
			IF !TALENT:処女 && BASE:MASTER:勃起 > 1000
				PRINTFORMW 「헤이, 오니이상, 안 하는 거야?」
				PRINTFORMW 「%조사처리(CALLNAME:TARGET,"의")% 보지가 오니상에게 비비고 싶어 해. 원하지 않아?」
				SIF CFLAG:TARGET:溜まってる度 / 10 > 500
					PRINTFORMW 「안 그래?」
				SIF CFLAG:TARGET:溜まってる度 / 10 > 600
					PRINTFORMW 「계속 해 봐, 문질러 봐.」
				SIF CFLAG:TARGET:溜まってる度 / 10 > 750
					PRINTFORMW 「부탁해?」
			ELSE
				PRINTFORMW 「오빠, 그냥 %CALLNAME:TARGET%보는 거 지루하지 않아?」
				PRINTFORMW 「%조사처리(CALLNAME:TARGET,"는")% 차라리 오빠랑 놀고 싶어 해.」
			ENDIF
		ELSEIF !RAND:3
			;おまたごしごしじゃなくてオナニーだよウフフ It's not "weewee rubbie", it's "masturbate" *gentlemanly giggle*
			PRINTFORMW 「헤이, 오니이상, 패치기도 음부(weewee)를 비비는 거야?」
			PRINTFORML 「Oh,」
			PRINTFORMW 「마스터베이트?」
			PRINTFORMW 「패치이는 마스터베이트 해?」
		ELSEIF !RAND:2
			PRINTFORMW 「헤이, 오니-사마, 사쿠야도 부비부비(rubbie rubbie) 해?」
			PRINTFORML 「Oh,」
			PRINTFORMW 「마스터베이트?」
			PRINTFORMW 「사쿠야도 마스터베이트 하는 걸까?」
		ELSE
			PRINTFORMW 「저기, 오빠, 누님도 이걸 할 줄 아는 걸까?」
			PRINTFORMW 「비밀이야?」
			PRINTFORML 「자, 여기!」
			PRINTFORMW 「꼭 약속해. %조사처리(CALLNAME:TARGET,"는")%(는) 이거 아무한테도 말 안 할 거야.」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
