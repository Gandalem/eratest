			RETURN 1
		ENDIF
		;死に分岐
		;まとまりが悪い。
		IF GETBIT (CFLAG:1500,4)
			IF 充填率(TARGET,1)
				PRINTFORML 「또 "아기 만들기"를 하는 거야?」
			ELSE
				PRINTFORML 「오빠, 또 "아기 만들기" 하고 싶어?」
			ENDIF
		ELSEIF GETBIT (CFLAG:1500,3)
			IF CFLAG:TARGET:溜まってる度 / 10 > 750
				PRINTFORML 「%조사처리(CALLNAME:TARGET,"는")% "안에 사정하기"를 하고 싶어 한다.」
			ELSE
				PRINTFORML 「또 "안에 사정하기"를 할 거야?」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
