@k1011TextPrint()
	#DIM index
	#DIMS char
	#DIMS colorList, 999
	;获取颜色list
	SPLIT K1011GalTextColor, "_", colorList
	FOR index, 0, STRLENSU(K1011GalText)
		char '= SUBSTRINGU(K1011GalText, index, 1)
		;设置颜色
		SETCOLOR TOINT(colorList:index)
		PRINTS char
	NEXT

@k1011TextInput
	#DIM index
	FOR index, 0, VARSIZE("K1011GalChoiceList")
		IF K1011GalChoiceList:index != ""
			PRINTFORML [{index,2}] %K1011GalChoiceList:index%
		ELSE
			BREAK
		ENDIF
	NEXT
	WHILE 1
		INPUT
		IF RESULT >= 0 && RESULT < VARSIZE("K1011GalChoiceList") && K1011GalChoiceList:RESULT != ""
			RETURN RESULT
		ELSE
			PRINTW Invalid Input
			CLEARLINE 2
		ENDIF
	WEND
