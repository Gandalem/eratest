; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/DATA/SEX_TATTOO_DATA.ERB
;========================================================
;淫纹
;========================================================
;-------------------------------------------------
;影响因素
;-------------------------------------------------

@k1011StInfluence, key_name, key, index
#DIMS REF key_name
#DIM REF key
#DIM REF index
;接受
IF k1011GetTalent("服从") || ((k1011GetTalent("淫乱") || k1011GetTalent("亲爱")) && !k1011GetMark("反发刻印"))
	key_name:index = 天才魔法少女拿捏淫纹可是易如反掌的哟
	key:index = 20
	index += 1
	key_name:index = 高贵的吸血鬼天生就亲和魔法
	key:index = 10
	index += 1
	;不接受
ELSE
	key_name:index = 天才魔法少女拿捏淫纹可是易如反掌的哟
	key:index = -20
	index += 1
	key_name:index = 高贵的吸血鬼天生就亲和魔法
	key:index = -10
	index += 1
ENDIF
;-------------------------------------------------
;主纹
;-------------------------------------------------

@k1011StMainTattoo, m_index, m_id, m_cost, m_name, m_info
#DIM REF m_index
#DIM REF m_id
#DIM REF m_cost
#DIMS REF m_name
#DIMS REF m_info
m_id:m_index = 10
m_cost:m_index = 495 - (k1011GetTalent("亲爱") + k1011GetTalent("服从") + k1011GetTalent("妄信") + k1011GetTalent("相爱")) * 100
m_name:m_index = 四重极乐纹
m_info:m_index = 对快感最强烈的部位施加「Four Of A Kind」、使其分散到身体另外三个部位上
m_index += 1
IF K1011AllowMagic
	m_id:m_index = 11
	m_cost:m_index = 100
	m_name:m_index = 精魔纹
	m_info:m_index = 刻上这个淫纹、芙兰就会变成可以将肚子里的精液当成MP施法的色情魔法少女。
	m_index += 1
ENDIF
;-------------------------------------------------
;辅助纹
;-------------------------------------------------

@k1011StAssiTattoo, a_index, a_id, a_cost, a_max_lv, a_name, a_info
#DIM REF a_index
#DIM REF a_id
#DIM REF a_cost, 0, 0
#DIM REF a_max_lv
#DIMS REF a_name
#DIMS REF a_info
a_id:a_index = 7
a_cost:a_index:1 = 10
a_cost:a_index:2 = 20
a_cost:a_index:3 = 40
a_max_lv:a_index = 3
a_name:a_index = 吸血改良纹
a_info:a_index = 作为调教对象时、令其吸血可恢复自身体力,气力,每级100点
a_index += 1
;四重极乐纹效果

@k1011FourOfAKindSt
#DIM DYNAMIC maxH
#DIM DYNAMIC maxHId
#DIM expectH
#DIM index
#DIMS palcesName
;统计最大快感
FOR index, 0, 4
IF maxH < k1011GetSource(SOURCENAME:index)
	maxH = k1011GetSource(SOURCENAME:index)
	maxHId = index
ENDIF
NEXT
IF maxH
	SELECTCASE maxHId
		;C
		CASE 0
			palcesName = 클리토리스
			;V
		CASE 1
			palcesName = 질
			;A
		CASE 2
			palcesName = 항문
			;B
		CASE 3
			palcesName = 가슴
	ENDSELECT
	;文本
	;四重绝对
	expectH = maxH * RELATION:k1011GetNo(PLAYER) / 100
	IF expectH > 1400
		SELECTCASE RAND:2
			CASE 1
				CALL k1011GP("L", @"쾌감이 생겨남과 동시에, 플란의 복부에 새겨진 음문이 요염한 분홍색 빛을 발했다.")
				CALL k1011GP("W", @"본래는 %palcesName%에서 강렬한 쾌감을 느끼며 갑자기 다리가 길어지듯 몸의 다른 부위로 달려갔고, 애초에 자극을 받지 못한 부위조차 이 예기치 않은 쾌감 때문에 반복해서 떨었다.")
				CALL k1011GP("L", @"사방에서 밀려오는 쾌감의 공격에, 플란쨩의 작은 머리는 순식간에 하얗게 변했고 어린 몸은 계속 떨리며 흔들렸다.")
				CALL k1011GP("W", @"깊은 붉은 욕망에 삼켜진 눈동자가 격렬하게 위로 뒤집히고, 작은 입도 'O'자 모양으로 벌어지며, 침이 자신도 모르게 흘러나왔다.")
				CALL k1011GP("W", @"더럽혀진 어린 몸이 쾌락의 바다 위를 오르내리며 떠다녔다.")
			CASE 0
				CALL k1011GP("L", @"%palcesName%에서 쾌감을 느끼는 그 순간, 요염한 분홍빛이 후란의 복부 음문으로부터 흘러나왔다.")
				CALL k1011GP("L", @"이어서 쾌감이 %palcesName%에서 전신 각 부위로 퍼져나갔다.")
				CALL k1011GP("W", @"쾌감에 점령당한 음핵, 질, 엉덩이, 가슴이 미친 듯이 떨리기 시작했다.")
				CALL k1011GP("L", @"이러한 쾌감의 매개체로서, 후라노는 어린 몸으로 %조사처리(CALLNAME:MASTER,"의")% 품에 힘없이 기대며 저절로 입을 벌리고 미친 듯이 경련했다.")
				CALL k1011GP("W", @"기쁨에 삼켜진 눈알이 계속 하얗게 위로 돌아갔다.")
		ENDSELECT
		;快感>3000
	ELSEIF expectH > 3000
		SELECTCASE RAND:2
			CASE 1
				CALL k1011GP("W", @"%palcesName%가 쾌감을 느끼자, 플랑쨩의 복부에 새겨진 음흔이 눈부시고 요염한 분홍색 빛을 발했다.")
				CALL k1011GP("W", @"분홍빛 섬광이 비추는 아래, 어린 몸 전체가 쾌감으로 떨리기 시작했다.")
				CALL k1011GP("L", @"사방에서 몰려오는 쾌감의 공격에, 어린 플란 양의 머릿속은 순식간에 하얘졌다.")
				CALL k1011GP("W", @"그저 경련으로 계속 흔들리는 작은 머리를 들고, 쾌감만이 남은 눈빛으로 %조사처리(CALLNAME:MASTER,"를")% 바라봤다.")
			CASE 0
				CALL k1011GP("L", @"쾌감 자극을 받는 동시에, 플란쨩의 복부가 요염한 분홍색 빛을 발했다.")
				CALL k1011GP("W", @"원래 %palcesName%에 머물렀던 쾌감이 갑자기 번개처럼 온몸으로 퍼져나갔다.")
				CALL k1011GP("L", @"다른 부위들도 이 갑작스러운 쾌감에 떨리기 시작했다.")
				CALL k1011GP("L", @"어린 몸이 전신의 네 부위에서 오는 쾌감의 자극에 미친 듯이 경련했다.")
				CALL k1011GP("W", @"깊은 진홍색의 쾌감만이 눈동자에서 멍하게 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있었다.")
		ENDSELECT
	ENDIF
	TIMES maxH, 0.75
	;增加到其他部位
	FOR index, 0, 4
	SIF index == maxHId
		CONTINUE
	CALL k1011AddSource(SOURCENAME:index, maxH)
	NEXT
ENDIF
;吸血改良纹

@k1011BloodSt
CALL k1011AddBase("体力", st_a_lv:7 * 50)
CALL k1011AddBase("气力", st_a_lv:7 * 50)
