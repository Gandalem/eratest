@k1011AddMarkInfo, nameOfMark, addNum, chara
#DIMS nameOfMark
#DIM addNum
#DIM chara
;没有增加值
SIF !addNum
	RETURN
;设置角色颜色
CALLF k1011ACharaColor, chara
PRINTS CALLNAME:chara
RESETCOLOR
;增加
IF addNum > 0
	FONTBOLD
	PRINTFORM %nameOfMark%Lv.{MARK:chara:nameOfMark}
	FONTREGULAR
	PRINTL 획득
	;降低
ELSE
	PRINTFORML %nameOfMark%의 레벨이 Lv.{MARK:chara:nameOfMark}로 낮아졌다.
ENDIF

