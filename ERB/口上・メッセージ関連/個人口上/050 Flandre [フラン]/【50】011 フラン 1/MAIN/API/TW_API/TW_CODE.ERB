@k1011TwDayendH()
#DIM hTimes
;你先生要有男性的象征
SIF !(k1011GetTalent("性别", MASTER) & 2)
	RETURN 0
;必须陷落
SIF !(k1011GetTalent("恋慕") || TALENT:愛欲)
	RETURN 0
;不能是处女捏
SIF k1011GetTalent("处女")
	RETURN 0
;体力必要
SIF k1011GetBase("体力") < 500 || k1011GetBase("体力", MASTER) < 500
	RETURN 0
;Ｖ感觉
IF k1011GetAbl("Ｖ感觉") <= 3
	hTimes = 0
ELSEIF k1011GetAbl("Ｖ感觉") == 3
	hTimes = 1
ELSEIF k1011GetAbl("Ｖ感觉") == 4
	hTimes = 2
ELSE
	hTimes = 4
ENDIF
;次数太少
SIF hTimes < 1
	RETURN 0
IF CFLAG:溜まってる度 >= 800
	TIMES hTimes, 2.00
ELSEIF CFLAG:溜まってる度 >= 600
	TIMES hTimes, 1.30
ELSEIF CFLAG:溜まってる度 >= 400
	TIMES hTimes, 1.00
ELSEIF CFLAG:溜まってる度 >= 200
	TIMES hTimes, 0.75
ELSE
	TIMES hTimes, 0.5
ENDIF
DRAWLINE
;地文
PRINTFORML 하루가 끝나고, %조사처리(CALLNAME:MASTER,"가")% 침대에 오려던 순간, 욕구가 채워지지 않은 %조사처리(CALLNAME:TARGET,"가")% 갑자기 \@ CFLAG:現在位置 == CFLAG:MASTER:現在位置 ? %조사처리(CALLNAME:MASTER,"를")% 밀쳤다 # 방 안으로 들어왔다_. \@
PRINTFORML 그는 그렇게 곧바로 %조사처리(CALLNAME:MASTER,"를")% 넘어뜨리고, 자신의 성기를 질 안에 넣은 채 격렬하게 허리를 움직였다.
PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 작은 구멍을 즐기고 있었다...
PRINTFORMW %조사처리(CALLNAME:TARGET,"와")% {hTimes}번 관계를 가진 후, 만족스러운 두 사람은 서로 껴안은 채 그렇게 교합하며 깊은 잠에 빠졌다.
;口上
IF RAND:2 == 0
	CALL k1011TrainEndV
ELSE
	CALL k1011TrainEndNight
ENDIF
CALL k1011AddExp("Ｖ经验")
CALL k1011AddExp("精液经验")
CFLAG:溜まってる度 -= hTimes * 50
CFLAG:溜まってる度 = MAX(0, CFLAG:溜まってる度)
;夜爬

