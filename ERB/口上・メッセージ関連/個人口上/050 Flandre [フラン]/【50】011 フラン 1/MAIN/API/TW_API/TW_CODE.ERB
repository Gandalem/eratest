@k1011TwMorningEvent(flanWake)
#DIM flanWake ;1已经醒了,0刚醒,-1还在睡
#DIMS DYNAMIC type, 20
#DIM DYNAMIC weight, 20
#DIM DYNAMIC index
#DIMS out
;一言口上
type:index = 평소에는
weight:index = 30
index ++
;芙兰先醒后的清晨事件
IF flanWake == 1
	;h
	IF CFLAG:既成事実 & 2
		;朝口交
		IF CFLAG:既成事実 & 1
			type:index = HM
			weight:index = k1011GetTalent("淫乱") * 3 + TALENT:185 * 3 + TALENT:愛欲 * 3 + k1011GetTalent("恋慕") + ABL:Ｍ感覚 * 2
			index ++
		ENDIF
		;朝乳交
		type:index = HB
		weight:index = k1011GetTalent("淫乱") * 3 + TALENT:185 * 2 + TALENT:愛欲 * 3 + k1011GetTalent("恋慕") + ABL:Ｂ感覚 * 2
		index ++
		;朝骑乘
		IF !k1011GetTalent("处女")
			type:index = HV
			weight:index = k1011GetTalent("淫乱") * 3 + TALENT:185 * 3 + TALENT:愛欲 * 3 + k1011GetTalent("恋慕") + ABL:Ｖ感覚 * 2
			index ++
		ENDIF
		;朝骑乘+揉胸
		IF !k1011GetTalent("处女")
			type:index = HVB
			weight:index = k1011GetTalent("淫乱") * 3 + TALENT:185 * 3 + TALENT:愛欲 * 3 + k1011GetTalent("恋慕") + ABL:Ｖ感覚 + ABL:Ｂ感覚
			index ++
		ENDIF
		;朝骑乘位肛交
		IF CFLAG:既成事実 & 8
			type:index = HA
			weight:index = k1011GetTalent("淫乱") * 3 + TALENT:185 * 3 + TALENT:愛欲 * 3 + k1011GetTalent("恋慕") + ABL:Ａ感覚 * 2
			index ++
		ENDIF
	ENDIF
	;纯爱系
	IF k1011GetTalent("恋慕")
		type:index = LOVE
		weight:index = k1011GetTalent("恋慕") * 3 + k1011GetTalent("亲爱") * 3 + k1011GetTalent("恋人") * 3 + k1011GetTalent("相爱") * 3 + ABL:料理技能 * 2
		index ++
		type:index = 키스
		weight:index = k1011GetTalent("恋慕") * 3 + k1011GetTalent("亲爱") * 3 + k1011GetTalent("恋人") * 3 + k1011GetTalent("相爱") * 3 + ABL:Ｍ感覚 * 2
		index ++
	ENDIF
ENDIF
