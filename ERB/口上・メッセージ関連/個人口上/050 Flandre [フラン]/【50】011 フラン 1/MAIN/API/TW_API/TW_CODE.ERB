@k1011TwChangeSex, chara
#DIM chara
SELECTCASE TALENT:chara:性別
	;女
	CASE 1
		TALENT:chara:性別 = 2
		MAXBASE:chara:2 = 10000
		MAXBASE:chara:精力 = 1000
		MAXBASE:chara:勃起 = 1500
		SIF BASE:chara:精力 > 1000
			BASE:chara:精力 = 1000
		;男
	CASE 2
		TALENT:chara:性別 = 1
		MAXBASE:chara:2 = 0
		MAXBASE:chara:精力 = 0
		TALENT:chara:120 = 0
		;女(扶她)
	CASE 3
		TALENT:chara:性別 = 2
		;ERROR
	CASE 4
		THROW [芙兰口上ERROR] 未知性别
ENDSELECT
