	IF MONEY - K1011TwBaseMoney >= 1000000
		IF ABL:従順 + ABL:親密 + ABL:欲望 + ABL:奉仕精神 < 100
			SETCOLOR color_mix(0xff5050, MAX(100 - (ABL:従順 + ABL:親密 + ABL:欲望 + ABL:奉仕精神), 0) , 0x50ff50, ABL:従順 + ABL:親密 + ABL:欲望 + ABL:奉仕精神)
