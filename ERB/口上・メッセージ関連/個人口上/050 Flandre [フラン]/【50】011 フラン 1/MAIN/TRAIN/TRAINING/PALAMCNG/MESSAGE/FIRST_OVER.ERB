; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/PALAMCNG/MESSAGE/FIRST_OVER.ERB
;-------------------------------------------------
;点数初次达到某些值
;-------------------------------------------------

@k1011FirstOver
;-------------------------------------------------
;初次润滑超过LV2
;-------------------------------------------------
IF k1011GetNowPalam("润滑") > PALAMLV:2 && !K1011TrainArriveFirst:润滑
	;恋慕
	IF k1011GetTalent("恋慕")
		;使用润滑液
		IF k1011GetNowSelectcom() == 60
			CALL k1011GPC("W", @"「뭐라고? 이, 미끌미끌한 건... 이걸 뭐로 하는 거야?」", TARGET)
			;除此之外
		ELSE
			CALL k1011GPC("W", @"「아? 아래가 이미 젖었어♪」", TARGET)
		ENDIF
		;除此之外
	ELSE
		;使用润滑液
		IF k1011GetNowSelectcom() == 60
			CALL k1011GPC("W", @"「뭐라고? 이, 미끌미끌한 건... 이걸 뭐로 하는 거야?」", TARGET)
			;除此之外
		ELSE
			WAIT
			IF K1011InfOfSex == 1
				CALL k1011GP("W", @"프랑의 음순에서 애액이 흘러나오자, 프랑은 그 광경에 놀라 외쳤다.")
				CALL k1011GPC("W", @"「뭐라고? 이게 뭐야!?」", TARGET)
				CALL k1011GP("L", @"푸란은 비밀스러운 곳에서 나온 것이 오줌뿐이라고 생각하고 당황한 표정을 지었다.")
				CALL k1011GP("W", @"그에게 이건 아주 자연스러운 일이고 이상한 게 없다고 말해라.")
				CALL k1011GPC("W", @"「오, 작은 구멍에서 애액이 흘러 나오는 게 사람을 편안하게 하는 거였구나... %k1011Name(TARGET, MASTER)%는 아는 게 정말 많네」", TARGET)
			ELSE
				CALL k1011GP("W", @"애액이 플란의 음순에서 새어 나왔다.")
				CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 일부러 띠링띠링 소리를 내서 플란을 희롱하고 얼굴을 새빨갛게 만들었다.")
				CALL k1011GPC("W", @"「싫어... 그렇게 가지고 놀지 마... %k1011Name(TARGET, MASTER)%♥」", TARGET)
			ENDIF
		ENDIF
	ENDIF
	K1011TrainArriveFirst:润滑 = 1
ENDIF
;-------------------------------------------------
;初次欲情超过LV3
;-------------------------------------------------
IF k1011GetNowPalam("欲情") > PALAMLV:3 && !K1011TrainArriveFirst:欲情
	;恋慕
	IF k1011GetTalent("恋慕")
		;使用媚药
		IF k1011GetNowSelectcom() == 61
			CALL k1011GPC("W", @"「아... 이 약은 무슨 약이지... 뭐라고 해야 할까, 어서 하고 싶어...」", TARGET)
			;除此之外
		ELSE
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, TARGET)%…… 뭔가 H 같은 걸 하고 싶어진 것 같아……」", TARGET)
		ENDIF
		;除此之外
	ELSE
		;使用媚药
		IF k1011GetNowSelectcom() == 61
			CALL k1011GPC("W", @"「아... 이 약은 무슨 약이지... 뭐라고 해야 할까, 어서 하고 싶어...」", TARGET)
			;除此之外
		ELSE
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, TARGET)%…… 뭔가 H 같은 걸 하고 싶어진 것 같아……」", TARGET)
		ENDIF
	ENDIF
	K1011TrainArriveFirst:欲情 = 1
ENDIF
;-------------------------------------------------
;初次耻情超过LV2
;-------------------------------------------------
IF k1011GetNowPalam("耻情") > PALAMLV:2 && !K1011TrainArriveFirst:耻情
	;恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GP("W", @"후란은 %k1011Name(TARGET, MASTER)%의 행동 때문에 부끄러워하는 것 같다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 너무 이상한 짓은 하지 말아줘」", TARGET)
		;除此之外
	ELSE
		CALL k1011GP("W", @"후란은 %k1011Name(TARGET, MASTER)%의 행동 때문에 부끄러워하는 것 같다.")
		CALL k1011GPC("W", @"「너무 이상한 짓은 하지 말아줘」", TARGET)
	ENDIF
	K1011TrainArriveFirst:耻情 = 1
ENDIF
;-------------------------------------------------
;初次恐怖超过LV2
;-------------------------------------------------
IF k1011GetNowPalam("恐怖") > PALAMLV:2 && !K1011TrainArriveFirst:恐怖
	CALL k1011GP("W", @"푸란은 %조사처리(CALLNAME:MASTER,"에게")% 공포를 느낀다.")
	CALL k1011GPC("W", @"「이게 뭐야... 두려워? 이런 느낌은 처음이야...」", TARGET)
	K1011TrainArriveFirst:恐怖 = 1
ENDIF
;-------------------------------------------------
;初次C絶頂
;-------------------------------------------------
IF k1011GetNowex("Ｃ绝顶") && !K1011TrainArriveFirst:C绝顶
	CALL k1011GPC("L", @"「뭔 것이 왔지... %k1011Name(TARGET, TARGET)%가 이상해졌다!」", TARGET)
	CALL k1011GP("W", @"푸란은 눈을 감고 %조사처리(CALLNAME:PLAYER,"를")% 껴안았다. 아마도 미지의 파도가 두려워서일 것이다.")
	CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "呜、呜、啊啊——! !")%」", TARGET)
	CALL k1011GP("W", @"삐빅, 그 작은 몸 안에서 즐거운 파도가 소용돌이치고 있었다.")
	CALL k1011GP("W", @"플란은 처음으로 오르가즘을 느끼며, 가볍게 경련하면서 %조사처리(CALLNAME:PLAYER,"를")% 응시했다.")
	CALL k1011GPC("W", @"「이게 뭐야……. %k1011Name(TARGET, TARGET)%도 모르겠어……」", TARGET)
	CALL k1011GPC("W", @"「가는 거라고 했어? 음... %k1011Name(TARGET, TARGET)%가 갔어...」", TARGET)
	CALL k1011GP("W", @"후란은 얼굴을 붉히며 살짝 고개를 끄덕였다.")
	K1011TrainArriveFirst:C绝顶 = 1
ENDIF
;-------------------------------------------------
;初次V絶頂
;-------------------------------------------------
IF k1011GetNowex("Ｖ绝顶") && !K1011TrainArriveFirst:V绝顶
	CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "啊!哈啊!")%」", TARGET)
	CALL k1011GP("W", @"후란의 모습이 이상하다, 여자들의 절정이 오는 것 같다.")
	CALL k1011GPC("W", @"「구멍 안의 것들, 너무 무서워!」", TARGET)
	CALL k1011GPC("W", @"「두뇌가 새하얘졌다! %k1011Name(TARGET, MASTER)%!!」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"의")% 품 안에서, 작은 몸이 귀엽게 떨며 첫 번째 절정을 맞았다.")
	CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "哈哈哈……")%%k1011Name(TARGET, MASTER)%♥%k1011Name(TARGET, TARGET)%…의 작은 구멍에 갔다…♪」", TARGET)
	K1011TrainArriveFirst:V绝顶 = 1
ENDIF
;-------------------------------------------------
;初次A絶頂
;-------------------------------------------------
IF k1011GetNowex("Ａ绝顶") && !K1011TrainArriveFirst:A绝顶
	CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "啊、啊、")%%k1011Name(TARGET, TARGET)%의 엉덩이 너무 대단해! 이상해져 버릴 것 같아%k1011Sound("Orgasm", "啊!啊啊啊!")%」", TARGET)
	CALL k1011GP("W", @"어릴 때부터 더럽혀지지 않은 작은 몸이 출생 이후 처음으로 항문 오르가즘을 맞았다.")
	CALL k1011GPC("W", @"「엉덩이... 정말... 망가졌어... 망가졌어...」", TARGET)
	CALL k1011GP("W", @"행복에 빠진 눈으로 멍하니 하늘을 바라보며 입가에는 침이 흘렀다.")
	CALL k1011GP("W", @"어린 몸이 떨면서 반복적으로 경련하며 강렬한 기쁨을 표현했다.")
	K1011TrainArriveFirst:A绝顶 = 1
ENDIF
;-------------------------------------------------
;初次B絶頂
;-------------------------------------------------
IF k1011GetNowex("Ｂ绝顶") && !K1011TrainArriveFirst:B绝顶
	CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%의 가슴, 정말 이상해…… %k1011Sound("Orgasm", "啊啊!")%」", TARGET)
	CALL k1011GP("W", @"플란은 스스로 경련하는 가슴을 살짝 만지다가 자신의 몸에 놀랐다.")
	CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "哈……哈……")%유방이 떨리고 있네……야……」", TARGET)
	K1011TrainArriveFirst:B绝顶 = 1
ENDIF
;-------------------------------------------------
;奉仕100/200
;-----------------------------------------------
IF k1011GetExp("侍奉快乐经验") > 100 && K1011TrainArriveFirst:侍奉快乐 == 0
	CALL k1011GP("W", @"푸란은 봉헌의 기쁨을 느끼며, 매우 기쁘게 행동을 계속했다.")
	CALL k1011GPC("W", @"「소위 'ㅎ'이란 한 사람이 아니라 두 사람 모두 기분이 편안해지는 것...」", TARGET)
	CALL k1011GPC("W", @"「히히. 아... 더 많은 색정적인 일을 하자, 같이 기분이 좋아지겠지♪」", TARGET)
	K1011TrainArriveFirst:侍奉快乐 = 1
ELSEIF k1011GetExp("侍奉快乐经验") > 200 && K1011TrainArriveFirst:侍奉快乐 == 1
	CALL k1011GPC("W", @"「어이, 기분 좋아?」", TARGET)
	CALL k1011GPC("W", @"「헤헤…… %k1011Name(TARGET, TARGET)%도 기분이 좋네…♪」", TARGET)
	CALL k1011GP("W", @"후란은 타인을 섬기는 즐거움을 배웠고, 행동 속 눈빛에 변화가 생겼다.")
	K1011TrainArriveFirst:侍奉快乐 = 2
ENDIF
