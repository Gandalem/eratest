; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/PALAMCNG/MESSAGE/STOP.ERB
;-------------------------------------------------
;寸止
;-------------------------------------------------

@k1011OrgasmStop
;-------------------------------------------------
;寸止失败(你先生不小心)
;-------------------------------------------------
IF k1011GetNowex("寸止失败(你先生)")
	;Ｖ绝顶高潮前停止失败
	IF NOWEX:1 > 0
		CALL k1011GPC("L", @"「%k1011Sound("Orgasm", "啊!啊啊!")%」", TARGET)
		CALL k1011GP("W", @"하지만 좀 더 자극했더니, 플란은 결국 절정에 도달했다.")
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "啊啊啊啊啊啊! !")%%k1011Name(TARGET, TARGET)%너를 좋아해!♪」", TARGET)
		;Ｃ绝顶高潮前停止失败
	ELSEIF NOWEX:0 > 0
		CALL k1011GPC("L", @"「%k1011Sound("Orgasm", "啊……啊啊! !")%」", TARGET)
		CALL k1011GP("W", @"후란은 %조사처리(CALLNAME:PLAYER,"가")% 이렇게 격렬하게, 놀라면서 절정에 도달할 줄은 몰랐다.")
		;Ａ绝顶高潮前停止失败
	ELSEIF NOWEX:2 > 0
		CALL k1011GPC("L", @"「음, 엉덩이, %k1011Sound("Orgasm", "哈哇哇!")%」", TARGET)
		CALL k1011GP("W", @"프랑은 흥분해서 항문 오르가즘을 느꼈다.")
		CALL k1011GPC("W", @"「와!! 너무 상쾌해!」", TARGET)
		;Ｂ绝顶高潮前停止失败
	ELSEIF NOWEX:3 > 0
		CALL k1011GPC("L", @"「%k1011Sound("Orgasm", "啊……啊啊! !")%」", TARGET)
		CALL k1011GP("W", @"플란은 %조사처리(CALLNAME:PLAYER,"가")% 이렇게 격렬하고 준비되지 않은 작은 몸으로 떨면서 절정에 도달할 줄 몰랐다.")
	ENDIF
	;-------------------------------------------------
	;高潮前停止失败(芙兰酱忍不住了)
	;-------------------------------------------------
ELSEIF k1011GetNowex("寸止失败(芙兰)")
	;Ｖ绝顶高潮前停止失败
	IF NOWEX:1 > 0
		;恋慕
		;性交系
		IF GROUPMATCH(k1011GetNowSelectcom(), 20, 21, 22, 23, 27, 28, 610, 612, 614, 615)
			IF RAND:2 == 0
				CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 색을 좋아하는 아이네, 참지 못했어…!」", TARGET)
				CALL k1011GP("W", @"플란은 갑자기 자신의 허리를 다시 사용하며, 마치 %조사처리(CALLNAME:PLAYER,"의")% 음경으로 자위하는 듯했지만 절정에 도달했다.")
				CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "啊!啊!")% 정말 기분 좋아!!♪」", TARGET)
			ELSE
				CALL k1011GPC("W", @"「안 돼! %k1011Name(TARGET, TARGET)%는 또 단단하고 큰 거에 못 견디겠어!」", TARGET)
				CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "噫噫啊、恩!哈!")%%k1011Name(TARGET, PLAYER)%！！！」", TARGET)
			ENDIF
			;除此之外
		ELSE
			CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%는 참을 수 없어!」", TARGET)
		ENDIF
		;Ｃ绝顶高潮前停止失败
	ELSEIF NOWEX:0 > 0
		CALL k1011GPC("L", @"「오, 클리 너무 괴롭잖아!」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%을 가게 해줘! %k1011Name(TARGET, TARGET)%, 더는 못 참겠어!」", TARGET)
		;Ａ绝顶高潮前停止失败
	ELSEIF NOWEX:2 > 0
		CALL k1011GPC("W", @"「엉덩이 더 자극해 봐!!」", TARGET)
		CALL k1011GPC("W", @"「갔다! %k1011Name(TARGET, TARGET)%의 엉덩이가 가려고 해! !♪♪」", TARGET)
		;Ｂ绝顶高潮前停止失败
	ELSEIF NOWEX:3 > 0
		CALL k1011GPC("W", @"「이런 가슴은, %k1011Name(TARGET, TARGET)%는 이미... 참을 수 없어!」", TARGET)
	ENDIF
	;-------------------------------------------------
	;寸止
	;-------------------------------------------------
ELSEIF (k1011GetNowex("Ｃ高潮前停止累计数") || k1011GetNowex("Ｖ高潮前停止累计数") || k1011GetNowex("Ａ高潮前停止累计数") || k1011GetNowex("Ｂ高潮前停止累计数")) && k1011GetTequip("挑逗play")
	;Ｖ绝顶寸止
	IF NOWEX:21
		IF RAND:3 == 0
			CALL k1011GPC("W", @"「싫어! 거시기 그만둬!」", TARGET)
			CALL k1011GP("W", @"후란은 얼굴이 새빨개져 허리를 비틀며 절정에 도달하려 했지만 %조사처리(CALLNAME:PLAYER,"가")% 세게 눌렀다.")
		ELSEIF RAND:2 == 0
			CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 플란의 고조를 느끼고 즉시 충격을 멈췄다.")
			CALL k1011GPC("W", @"「아아, 조금만 더, 조금만 더 하면 돼, %k1011Name(TARGET, PLAYER)%♥......」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%……%k1011Name(TARGET, PLAYER)%♥……%k1011Name(TARGET, TARGET)%아직 안 갔어…」", TARGET)
			CALL k1011GPC("W", @"「왜 움직이지 않아? 너무 교활해.」", TARGET)
		ENDIF
		;Ｃ绝顶寸止
	ELSEIF NOWEX:20
		CALL k1011GPC("L", @"「그만두지 마, 그만두지 마, 이렇게 괴로워」", TARGET)
		CALL k1011GPC("W", @"「저기, 좀 더 만져도 될까? 저기, 저기……」", TARGET)
		;Ａ绝顶寸止
	ELSEIF NOWEX:22
		CALL k1011GPC("L", @"「엉덩이가 가렵네... 아」", TARGET)
		CALL k1011GPC("W", @"「아직 안 갔어, 한 번 더 만져줘」", TARGET)
		;Ｂ绝顶寸止
	ELSEIF NOWEX:23
		CALL k1011GPC("L", @"「오... 아... 온다!」", TARGET)
		CALL k1011GPC("W", @"「음, 거의 올 뻔했어……」", TARGET)
	ENDIF
ENDIF
;-------------------------------------------------
;喷乳前停止
;-------------------------------------------------
IF k1011GetNowex("喷乳前停止累计数")
	;寸止4次以上
	IF k1011GetEx("喷乳前停止累计数") >= 4
		CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%의 가슴이 너무 부풀어 올랐고, 안의 우유가 점점 많아지고 있어...」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%, 퐁 하고 한 번만 하면 %k1011Name(TARGET, TARGET)%의 가슴에서 젖이 뿜어져 나올 거야」", TARGET)
		;除此之外
	ELSE
		CALL k1011GP("W", @"유즙은 끊임없이 떨리고 있는 단단한 가슴에서 떨어졌다.")
		CALL k1011GPC("L", @"「아, 방금 가슴에서 나올 것 같았어... 한 번 더 해줘, 한 번 더 해줘」", TARGET)
	ENDIF
ENDIF
;-------------------------------------------------
;空射精
;-------------------------------------------------
IF k1011GetNowex("空射精累计数") && k1011GetTequip("禁止射精")
	;空射精累计次数差分
	IF k1011GetEx("空射精累计数") >= 15
		CALL k1011GPC("L", @"「으윽! 으으으윽! %k1011Name(TARGET, TARGET)%사정할 수 없어! %k1011Name(TARGET, TARGET)%사정할 수 없어! !」", TARGET)
		CALL k1011GPC("W", @"「히, 히! 빨리 벗어! %k1011Name(TARGET, PLAYER)%!」", TARGET)
	ELSEIF k1011GetEx("空射精累计数") >= 5
		CALL k1011GP("W", @"붉고 검은 발기된 성기가 계속 경련하고, 플란은 눈물을 글썽였다.")
		CALL k1011GPC("L", @"「안 되겠어... 안 되겠어... %k1011Name(TARGET, TARGET)%의 성기가 망가져 버릴 것 같아...」", TARGET)
		;除此之外
	ELSE
		IF RAND:2 == 0
			CALL k1011GPC("W", @"「너무 이상해... 너무 이상해」", TARGET)
			CALL k1011GPC("W", @"「방금 %k1011Name(TARGET, TARGET)%의 거시기에서 나왔어야 했는데, 안 나왔네……」", TARGET)
		ELSE
			CALL k1011GPC("L", @"「육봉... 흑흑, 사정하면 안 돼, 요!」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%♥...... 이걸 치워도 될까? 저기, 괜찮은 거지?」", TARGET)
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;射精渇望中
;-------------------------------------------------
IF k1011GetNowex("射精前停止累计数")
	;寸止4次差分
	IF k1011GetEx("射精前停止累计数") >= 4
		CALL k1011GPC("L", @"「아, 흐윽!」", TARGET)
		CALL k1011GPC("W", @"「...... 아, 또 온 거야?」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%♥부탁이야, %k1011Name(TARGET, TARGET)%의 자지가 삑 소리를 내게 해 줘!」", TARGET)
		;除此之外
	ELSE
		CALL k1011GP("W", @"플란나 귀여운 성기가 끝없이 떨고 있다.")
		CALL k1011GPC("L", @"「아...... %k1011Name(TARGET, TARGET)%는 이미 사정했다고 생각했어.」", TARGET)
	ENDIF
ENDIF
IF k1011GetBase("射精") == k1011GetMaxbase("射精") - 1
	;ntr
	IF (k1011GetNowSelectcom() == 107 && k1011GetTequip("捆绑") && k1011GetTequip("野外play")) || GROUPMATCH(k1011GetNowSelectcom(), 105, 106)
		CALL k1011NtrKiller()
	ELSE
		IF RAND:4 == 0
			CALL k1011GP("L", @"프랑은 곧 절정에 도달할 음경이 호흡에 따라 미세하게 떨렸다.")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%의 성기, 거의 나올 뻔했어... 조금 더 자극해 봐...」", TARGET)
		ELSE
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;放尿渇望
;-------------------------------------------------
IF k1011GetNowex("放尿前停止累计数")
	;寸止め4回分以上
	IF k1011GetEx("放尿前停止累计数") >= 4
		CALL k1011GPC("W", @"「안 되겠어! %k1011Name(TARGET, TARGET)%이 변태가 되어도 상관없어, 여기서 소변 보고 싶어!」", TARGET)
		CALL k1011GPC("W", @"「그렇지 않으면 방광이 망가져 버려요! %k1011Name(TARGET, PLAYER)%!!」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「아, 아...... 소변이 나왔어——!」", TARGET)
		CALL k1011GPC("L", @"「어라?... 아, %k1011Name(TARGET, PLAYER)%♥...... 왜 멈추는 거야...」", TARGET)
		CALL k1011GP("W", @"플란은 자신이 한 창피한 말에 얼굴을 새빨갛게 물들이고 %CALLNAME:PLAYER%에게서 시선을 돌렸다.")
	ENDIF
ENDIF
IF k1011GetBase("尿意") == k1011GetMaxbase("尿意") - 1
	;ntr
	IF (k1011GetNowSelectcom() == 107 && k1011GetTequip("捆绑") && k1011GetTequip("野外play")) || GROUPMATCH(k1011GetNowSelectcom(), 105, 106)
		CALL k1011NtrKiller()
	ELSE
		IF RAND:4 == 0
			CALL k1011GP("W", @"후란은 양손을 가랑이에 대고 몸을 계속 흔들며 소변의 충동을 참았다.")
			CALL k1011GPC("L", @"「아아... 안 되겠어, 오줌 나올 것 같아...」", TARGET)
		ELSEIF RAND:3 == 0
			CALL k1011GP("W", @"후란은 얼굴이 새빨개지고 눈을 감은 채 살짝 떨며 소변 욕구를 참는 듯했다.")
			CALL k1011GPC("L", @"「안 돼, 나올 것 같아, 나올 것 같아...」", TARGET)
		ELSE
		ENDIF
	ENDIF
ENDIF
