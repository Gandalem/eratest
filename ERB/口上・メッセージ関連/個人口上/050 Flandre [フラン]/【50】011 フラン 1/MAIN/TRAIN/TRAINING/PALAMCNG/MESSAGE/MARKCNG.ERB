; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/PALAMCNG/MESSAGE/MARKCNG.ERB
;-------------------------------------------------
;首次取得刻印
;-------------------------------------------------

@k1011Markcng
;-------------------------------------------------
;苦痛刻印Lv3取得
;-------------------------------------------------
IF TFLAG:40 == 3 && K1011MarkGetFirst:苦痛刻印 != 3
	;恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 너도 아플 거야?」", TARGET)
		CALL k1011GP("W", @"프랑의 표정은 주눅이 들지 않았고, 오히려 도취된 눈빛이었다.")
	ELSE
		CALL k1011GPC("W", @"「%k1011Sound("Pain", "呜、呜……")% 너무 아파... 너무 아파... 으윽」", TARGET)
	ENDIF
	K1011MarkGetFirst:苦痛刻印 = 3
ENDIF
;-------------------------------------------------
;快乐刻印Lv3取得
;-------------------------------------------------
IF TFLAG:41 == 3 && K1011MarkGetFirst:快乐刻印 != 3
	CALL k1011GPC("W", @"「와, 이건 뭐야…」", TARGET)
	CALL k1011GPC("W", @"「쾌감이 사라지고, 몸이 사방이 불편하고, 망할 것 같아, 망할 것 같아...!」", TARGET)
	IF k1011GetTalent("性好奇") != 1
		CALL k1011GPC("W", @"「하... 하... %k1011Name(TARGET, MASTER)%는 많은 대단한 일들을 알고 있구나...」", TARGET)
		CALL k1011GPC("W", @"「저기... %k1011Name(TARGET, TARGET)%에게 더 선정적인 걸 말해줘...♪」", TARGET)
		CALL k1011GP("W", @"플란트로는 성 지식에 [호기심]을 품고 있다.")
		CALL k1011SetTalent("性好奇", 1)
	ENDIF
	K1011MarkGetFirst:快乐刻印 = 3
ENDIF
;-------------------------------------------------
;屈服刻印Lv3取得
;-------------------------------------------------
IF TFLAG:42 == 3 && K1011MarkGetFirst:屈服刻印 != 3
	CALL k1011GPC("W", @"「오, 오...」", TARGET)
	CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%가 말을 잘 들으면…… %k1011Name(TARGET, TARGET)%랑 조금만 더 놀아도 될까?」", TARGET)
	CALL k1011GPC("W", @"「아, 기쁘구나...♪」", TARGET)
	K1011MarkGetFirst:屈服刻印 = 3
ENDIF
;-------------------------------------------------
;反发刻印Lv3取得
;-------------------------------------------------
IF TFLAG:44 == 3 && K1011MarkGetFirst:反发刻印 != 3
	;恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 너무 심하다……」", TARGET)
		CALL k1011GPC("W", @"「설마 이런 짓을 하다니...」", TARGET)
		CALL k1011GPC("W", @"「………………………………」", TARGET)
		CALL k1011GPC("W", @"「……흐흐」", TARGET)
		CALL k1011GPC("W", @"「헤헤, 헤헤」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%영원히 잊지 않을 거야, %k1011Name(TARGET, MASTER)%……」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「아하...」", TARGET)
		CALL k1011GPC("W", @"「아하하하하하하하하.」", TARGET)
		CALL k1011GPC("W", @"「아하하하하하하하하하하.」", TARGET)
		CALL k1011GPC("SL", @"「하하하하하하하하하하하하하.」", TARGET)
		CALL k1011GPC("SL", @"「하하하하하하하하하하하하하.」", TARGET)
		CALL k1011GPC("SL", @"「하하하하하하하하하하하하하.」", TARGET)
		CALL k1011GPC("SL", @"「하하하하하하하하하하하하하하하.」", TARGET)
		CALL k1011GPC("SL", @"「하하하하하하하하하하하하하하하.」", TARGET)
		CALL k1011GPC("W", @"「하하하하하하하하하하하하하하하.」", TARGET)
		CALL k1011GP("W", @"..................")
		CALL k1011GPC("W", @"「……고장났어……」", TARGET)
	ENDIF
	K1011MarkGetFirst:反发刻印 = 3
ENDIF
