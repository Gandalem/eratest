; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/COM_MESSAGE/EQUIPTXT.ERB

@k1011TequipTxt
;淋浴时对话
IF k1011GetTequip("淋浴play") && k1011GetNowSelectcom() != 351
	IF k1011GetAbl("受虐感") >= 3
		IF RAND:2 == 0
			CALL k1011GPC("W", @"「%k1011Sound("Pain", "嗯、啊、嗯……啊、啊、啊——啊ーーー♪")%」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「%k1011Sound("Pain", "唔、唔、唔……♪……啊、唔、唔……呵呵……呵呵")%」", TARGET)
		ENDIF
		CALL k1011GP("W", @"푸란은 물줄기가 주는 고통을 즐기고 있는 듯, 오히려 거기에 심취해 있었다.")
	ELSE
		IF RAND:3 == 0
			CALL k1011GPC("W", @"「%k1011Sound("Pain", "嗯、啊、嗯……啊、啊、啊……嗯")%」", TARGET)
		ELSEIF RAND:2 == 0
			CALL k1011GPC("W", @"「%k1011Sound("Pain", "呼……哈、呜……哈、啊……啊……」")%", TARGET)
		ELSE
			CALL k1011GPC("W", @"「%k1011Sound("Pain", "唔、唔、唔……!……啊、唔、唔……呵呵……呵呵」")%」", TARGET)
		ENDIF
		CALL k1011GP("W", @"프랑은 필사적으로 물이 가져오는 고통을 견뎠다.")
	ENDIF
ENDIF
;装备影响口上
SIF K1011Game == "YM"
	TRYCALL KOJO_X_TRAIN_MESSAGE_EQUIPTEXT
