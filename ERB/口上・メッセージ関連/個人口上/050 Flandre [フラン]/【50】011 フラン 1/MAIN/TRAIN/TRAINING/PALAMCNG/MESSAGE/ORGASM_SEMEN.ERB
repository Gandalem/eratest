; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/PALAMCNG/MESSAGE/ORGASM_SEMEN.ERB

@k1011OrgasmSemen
;-------------------------------------------------
;榨乳
;-------------------------------------------------
IF k1011GetOtherInfo("榨乳")
	;触手
	IF k1011GetOtherInfo("触手召唤")
		IF k1011GetAbl("触手中毒") >= 3
			IF RAND:2 == 0
				CALL k1011GPC("W", @"「아!! 촉수 선생님, 플랜의 우유를 그렇게 빨지 마세요!!」", TARGET)
			ELSE
			ENDIF
		ELSE
			IF RAND:2 == 0
				CALL k1011GPC("L", @"「아... 플랜의 가슴, 이렇게 빨면 안 되는데...」", TARGET)
				CALL k1011GP("W", @"플란은 얼굴을 붉히고 자신의 유두에 빨려 붙은 촉수를 응시했다.")
			ELSE
			ENDIF
		ENDIF
	ELSEIF RAND:2 == 0
		CALL k1011GPC("W", @"「아, 아! %k1011Name(TARGET, TARGET)%의 가슴이 짜여나갔다!」", TARGET)
	ELSE
		CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%의 우유가 다 도둑맞았어……」", TARGET)
		CALL k1011GPC("W", @"「하지만 누가 %k1011Name(TARGET, TARGET)%에게 우유를 마시게 하겠어…… 그래도 %k1011Name(TARGET, TARGET)%를 기분 좋게 해 줄 수만 있다면 됐어……♪」", TARGET)
	ENDIF
ENDIF
;-------------------------------------------------
;喷乳
;-------------------------------------------------
IF k1011GetOtherInfo("喷乳")
	;榨乳不算喷乳
	SIF k1011GetOtherInfo("榨乳") > 0
		RETURN
	;初次
	IF !K1011TrainOtherFirst:喷乳
		;恋慕
		IF k1011GetTalent("恋慕")
			CALL k1011GPC("L", @"「하, 하, %k1011Name(TARGET, MASTER)%아, 왜 우유가 나와, 왜 우유가 나오는 거야!?」", TARGET)
			CALL k1011GPC("W", @"「다 다 앞쪽으로 흘러나왔어! 아아!」", TARGET)
			;除此之外
		ELSE
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, TARGET)%의 가슴에서 모유가 나올 것 같아! 아아!」", TARGET)
		ENDIF
		K1011TrainOtherFirst:喷乳 = 1
	ELSEIF k1011GetOtherInfo("触手召唤")
		IF k1011GetAbl("触手中毒") >= 3
			IF RAND:2 == 0
				CALL k1011GPC("W", @"「하아, 아...... %k1011Name(TARGET, TARGET)%의 가슴에 촉수 선생님이 많이 묻었어...♪」", TARGET)
			ELSE
			ENDIF
		ELSE
			IF RAND:2 == 0
				CALL k1011GP("W", @"프랑이 솟아오른 유두에서 많은 우유가 분출되어 그녀의 촉수를 흰색으로 만들었다.")
			ELSE
			ENDIF
		ENDIF
		;絶頂逃がし
	ELSEIF k1011GetNowSelectcom() == 105 || k1011GetNowSelectcom() == 106 || k1011GetNowSelectcom() == 107
		CALL k1011NtrKiller()
		;二回目以降
	ELSE
		;恋慕
		IF k1011GetTalent("恋慕")
			IF RAND:4 == 0
			ELSEIF RAND:3 == 0
				CALL k1011GPC("L", @"「아기야, 이런 걸 마셔야 해...」", TARGET)
				CALL k1011GP("W", @"후란은 유두를 잡고, 손에 모유를 받쳐 가지고 놀았다.")
			ELSEIF RAND:2 == 0
				CALL k1011GPC("L", @"「우유가 점점 많아질 거야!」", TARGET)
				CALL k1011GPC("W", @"「어떡하지? %k1011Name(TARGET, MASTER)%……!」", TARGET)
			ELSE
				CALL k1011GPC("L", @"「음, 우유가 나왔어... 가슴에서 우유가 흘러나왔어...」", TARGET)
			ENDIF
			;初次之外
		ELSE
			CALL k1011GPC("W", @"「아... 유두에서 우유가 흘러 나왔어...」", TARGET)
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;放尿
;-------------------------------------------------
IF k1011GetOtherInfo("放尿")
	SIF k1011GetNowex("Ｃ绝顶") || k1011GetNowex("Ａ绝顶") || k1011GetNowex("Ｖ绝顶") || k1011GetNowex("Ｂ绝顶")
		RETURN
	IF k1011GetTequip("尿布play")
		IF K1011AcceptPee == 1
			CALL k1011GPC("L", @"「%k1011Sound("Happy", "啊~ ~ ~")% 정말 재미있고 기분 좋다……」", TARGET)
			CALL k1011GP("W", @"플랜인은 기저귀에 감싸져 안심하며 마음껏 소변을 봤다.")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%♥, 푸란의 기저귀가 더러워졌어, 갈아줘...♪」", TARGET)
		ELSE
			CALL k1011GP("W", @"프랑은 기저귀 속의 부드러운 감촉에 얼굴을 붉혔다.")
			CALL k1011GPC("L", @"「%k1011Sound("Happy", "啊、啊、啊……")%은 그렇구나. 기저귀를 차고, 프란... 정말 아기 같네」", TARGET)
		ENDIF
	ELSEIF RAND:3 == 0
		CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊、啊……")% 여기는 화장실이 아닌데, 프란이 소변을 봤다……」", TARGET)
	ELSEIF RAND:2 == 0
		CALL k1011GP("W", @"후란은 얼굴이 붉어졌지만, 여전히 편안한 표정으로 자신의 소변을 바라보았다.")
		CALL k1011GPC("L", @"「%k1011Sound("Happy", "啊、啊……")% 정말 싫다, 아무 데나 소변을 봤다니……♪」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「이런 곳에선 안 돼... 소변까지 나왔어...」", TARGET)
	ENDIF
ENDIF
;射精&绝顶
IF k1011GetShootPlace() & 1 && k1011GetEx("Ｖ绝顶") >= 80
	IF RAND:2 == 0
		CALL k1011GP("L", @"삽입으로 인한 강렬한 쾌감을 느끼자, 플란은 야수처럼 고함을 지르며 신음했다.")
		CALL k1011GP("W", @"하지만 %조사처리(CALLNAME:PLAYER,"가")% 사정을 시작하려는 것을 느끼고, 몸을 가라앉히며 내부로 사정되는 느낌을 음미했다.")
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "啊――哈啊——嗯啊——唔、嗯……！")%」", TARGET)
		CALL k1011GP("L", @"매번 사정할 때, %조사처리(CALLNAME:PLAYER,"는")% 플란의 육구에서 오는 조여오는 느낌을 느낀다.")
		CALL k1011GP("W", @"이미 쾌감으로 떨리고 있는 작은 몸")
		CALL k1011GP("W", @"후란은 절정의 쾌감 속에서 %조사처리(CALLNAME:PLAYER,"를")% 꽉 안으며 참을 수 없는 쾌감을 %조사처리(CALLNAME:PLAYER,"에게")% 전했다.")
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "哈、哈、啊、、、")% 사정해 버렸네, 사정해야 해, 많이, 많이……\@ (PLAYER == PLAYER) ? %k1011Name(TARGET, PLAYER)% # %CALLNAME:PLAYER% \@♥♥」", TARGET)
	ELSE
		CALL k1011GP("L", @"%조사처리(CALLNAME:PLAYER,"가")% 사정할 순간, 플란은 무언가 말하려 한 것 같다.")
		CALL k1011GP("W", @"하지만 강렬한 쾌감의 충격에, 의미 없는 신음으로 변해버려 귀여운 작은 머리를 흔들 뿐이었다.")
		CALL k1011GP("W", @"그럼에도 불구하고, %조사처리(CALLNAME:PLAYER,"는")% 망설임 없이 미숙한 성기에 사정을 주입했고, 플란의 몸은 즉시 뻣뻣해지며 경련했다.")
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "―――！！ 啊、啊、、啊唔………♥")%」", TARGET)
		CALL k1011GP("W", @"자궁에 대량의 흰 액체가 직접 주입되었고, 플란은 강렬한 쾌감 아래 뇌가 하얗게 변했으며 입가의 침이 통제 불가능하게 흘러나왔다.")
	ENDIF
	;TODO肛门高潮射精
ENDIF
;-------------------------------------------------
;阴道射精
;-------------------------------------------------
IF k1011GetShootPlace() & 1
	;吸血射精时
	IF K1011VampirismShoot == 1
		IF RAND:2 == 0
			CALL k1011GPC("W", @"「%k1011Sound("Mouth", "哈——呼——嗯、嗯——♪")%」", TARGET)
			CALL k1011GP("W", @"모든 감각의 쾌감이 온몸을 휘몰아쳤다.")
			CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 플란에게서 거시기조차 빼지 못하고 사발했다.")
			CALL k1011GP("W", @"마치 자신의 것이 아닌 것처럼, 평소와는 다른 엄청난 양의 정액을 프란체스카 안에 거칠게 사정했다.")
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "——、哈……嗯……")%%k1011Name(TARGET, PLAYER)%……잘 먹었습니다」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊——喂、啊——!")%」", TARGET)
			CALL k1011GP("W", @"%CALLNAME:PLAYER%몸 안의 혈색이 사라지는 반대, 분노한 것은 비정상적으로 혈액을 모으고 한계까지 부풀어 올랐다.")
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "嗯——!——哈——呼——!")%」", TARGET)
			CALL k1011GP("W", @"플랜에서 흡혈의 자극을 받은 %조사처리(CALLNAME:PLAYER,"는")% 눈앞이 하얘지고 의식이 천국으로 날아갔다.")
			CALL k1011GP("W", @"그리고 %조사처리(CALLNAME:PLAYER,"는")% 수십 초 동안 지속적으로 사정했고, 플란의 어린 연약한 구멍은 순식간에 가득 찼으며, 씨앗이 역류하여 자궁 깊숙한 곳으로 향했다.")
		ENDIF
		;吸血射精
		K1011VampirismShoot = 2
		;初射精
	ELSEIF !K1011TrainOtherFirst:阴道射精
		IF k1011GetTalent("恋慕") && ASSIPLAY == 0
			CALL k1011GPC("W", @"「아... 육봉이 안에서 움직이고 있어...」", TARGET)
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊、啊……啊…")%%k1011Name(TARGET, PLAYER)%, %k1011Name(TARGET, TARGET)% 안에 사정하는 거지?」", TARGET)
			CALL k1011GPC("W", @"「왠지 좀 흥분되는 기분이야... %k1011Name(TARGET, PLAYER)%♪」", TARGET)
			CALL k1011GPC("W", @"「앞으로 %k1011Name(TARGET, TARGET)%는 %k1011Name(TARGET, PLAYER)%의 것이니까, 제대로 책임져 줘…♪」", TARGET)
			CALL k1011GP("W", @"플랜은 자신의 작은 구멍이 %조사처리(CALLNAME:PLAYER,"에게")% 처음으로 사정당하고 기뻐했다.")
		ELSE
			CALL k1011GPC("W", @"「에, 이거 뭐야? 거기가 안에서 조금씩 움직이고 있어...?」", TARGET)
			CALL k1011GPC("W", @"「!? 안 돼! 구멍 속이 너무 뜨거워!」", TARGET)
			CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 허둥지둥하는 플란의 허리를 잡아당겨, 그녀가 처음으로 자궁이 정액으로 가득 찬 느낌을 맛보게 했다.")
		ENDIF
		IF K1011NotMenchare == 1 && k1011GetOtherInfo("未经初潮")
			WAIT
			CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 후란의 어린 구멍 속에서 분출되는 만족감을 즐기는 동시에 이질감을 발견했다.")
			CALL k1011GP("W", @"그것은 다른 여성의 질에서 맛보지 못했던, 특별히 어린 듯 솔직한 느낌이었다.")
			CALL k1011GP("W", @"어쩌면 지금까지 플란은 한 번도 생리를 경험하지 못했을지도 모른다.")
		ENDIF
		K1011TrainOtherFirst:阴道射精 = 1
		;初潮日
	ELSEIF k1011GetOtherInfo("初潮")
		IF RAND:3 == 0
			CALL k1011GP("W", @"한계에 도달하는 동시에, %조사처리(CALLNAME:PLAYER,"는")% 플랜의 아직 완전히 발달하지 않은 작은 구멍 안에 사정했다.")
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "嗯呜呜…")% 안에 사정할 거야?」", TARGET)
			CALL k1011GPC("W", @"「우아... 구멍 안에 피와 정액이 가득 차 버렸어...」", TARGET)
		ELSEIF RAND:2 == 0
			CALL k1011GP("W", @"특이한 따뜻한 작은 구멍 안에서, %조사처리(CALLNAME:PLAYER,"는")% 최대한 많은 정액을 사출했다.")
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "呜啊啊…")%안쪽도 끈적끈적해졌네…%k1011Name(TARGET, PLAYER)%♥……♪」", TARGET)
			CALL k1011GP("W", @"플랑은 아직 발달하지 않은 어린 구멍 안에서 온갖 종류의 액체들이 뒤섞여 빨간색과 흰색의 액체가 끊임없이 흘러나왔다.")
		ELSE
			CALL k1011GP("W", @"작은 구멍 안에서 사정하고 난 뒤, %조사처리(CALLNAME:PLAYER,"는")% 여전히 벌어 있고 붉게 물든 거시기(성기)를 빼냈다.")
			CALL k1011GPC("W", @"「%k1011Sound("Happy", "哇啊、")%자지가 엄청나진 것 같네. 저건 %k1011Name(TARGET, TARGET)%내 피야? 맛있어 보이는데……」", TARGET)
			CALL k1011GP("W", @"플란은 손으로 빨간 육봉을 잡고, 그 위에 자신의 피를 핥았다.")
		ENDIF
		;排卵诱发剂
	ELSEIF k1011GetOtherInfo("排卵诱发剂") && k1011GetTalent("恋慕") && !(k1011GetOtherInfo("未经初潮") || k1011GetOtherInfo("初潮"))
		;绝顶
		IF k1011GetNowex("Ｖ绝顶")
			IF RAND:4 == 0
				CALL k1011GPC("W", @"「%k1011Sound("Happy", "呜啊！")%%k1011Name(TARGET, PLAYER)%！♪」", TARGET)
				CALL k1011GP("W", @"후란은 곧 절정에 이를 듯했고, 본래 매우 조였던 작은 구멍이 더욱 조여지는 것을 분명히 느꼈다.")
				CALL k1011GP("W", @"자궁구도 내려왔다, %조사처리(CALLNAME:PLAYER,"의")% 정액을 전부 삼킬 작정인 것 같다.")
				CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊、嗯、唔呜————！")%%k1011Name(TARGET, PLAYER)%! 플란이 날아오를 거야, 하늘까지 날아갈 거야, 아기가 나올 거야 으응 아아아아!!?」", TARGET)
				CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 허리를 흔드는 플란을 끌어안고, 의식이 날아갈 듯한 쾌감이 머릿속을 가득 채웠다.")
			ELSEIF RAND:3 == 0
				CALL k1011GPC("L", @"「%k1011Sound("Happy", "呀啊、")%의 자지가 %k1011Name(TARGET, TARGET)% 안에서 더 커졌어…?」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%♥플랑은 이미 가버렸어%k1011Sound("Happy", "啊啊啊啊…、")% 싫어어, 아기를 만드는 액체가 자궁에서 흘러나오고 있어…!」", TARGET)
			ELSEIF RAND:2 == 0
				CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%곧, 절정에 이를 거야 아아! 구멍이 갈 것 같아%k1011Sound("Happy", "呜呜呜啊啊啊！！")%」", TARGET)
				CALL k1011GP("L", @"격렬하게 흔들리는 어린 몸은 이 순간 여성의 즐거움을 맞이했다.")
				CALL k1011GP("W", @"자궁은 새로운 생명을 갈구하는 듯, %조사처리(CALLNAME:PLAYER,"의")% 성기를 놓지 않고 꽉 붙잡았다.")
			ELSE
				CALL k1011GP("W", @"후란 스스로도 격렬하게 허리를 흔들며 %조사처리(CALLNAME:PLAYER,"가")% 사정하도록 재촉했다.")
				CALL k1011GPC("L", @"「%k1011Name(TARGET, PLAYER)%♥, 안에 천천히 싸줘…%k1011Name(TARGET, TARGET)%도 아기를 갖고 싶어…%k1011Sound("Happy", "唔啊啊啊！！")%」", TARGET)
				CALL k1011GP("W", @"플란은 절정에 이르렀고, 어린 몸으로 %조사처리(CALLNAME:PLAYER,"와")% 자신의 아이를 얻기 위해 끊임없이 정액을 갈망했다.")
			ENDIF
		ELSE
			IF RAND:6 == 0
				CALL k1011GP("W", @"푸슉, 푸슉...푸슉......")
				CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 자궁구에서 사정하고 난 후, 플랜의 부드러운 허벅지를 잡고 플랜이 질을 위로 향한 채 누워 있도록 했다.")
				CALL k1011GPC("W", @"「우웅, 이 자세로 %k1011Name(TARGET, PLAYER)%의 따뜻한 것이 천천히 흘러들어 오고 있어…」", TARGET)
				CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 부끄러움에 계속 몸을 비틀고 있는 후란을 무시하다가 자궁이 정액을 전부 삼킨 후에 손을 놓았다.")
				CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%의 정액이 전부 들어왔어...♪」", TARGET)
