				CALL k1011GPC("L", @"「안 돼! 지금 소변 구멍 만지면 안 돼!!」", TARGET)
				CALL k1011GP("W", @"플란은 야야거리며 고개를 흔들고, 음경을 머금은 질이 가려지기 시작하며 %조사처리(CALLNAME:PLAYER,"의")% 복부를 따뜻하게 했다.")
			ENDIF
		ENDIF
		;V/A射精
		IF k1011GetShootPlace() & 3
			IF RAND:2 == 0
				CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"가")% 부끄러워 붉어진 자신의 얼굴을 보지 않으려고, 플란은 %조사처리(CALLNAME:PLAYER,"를")% 꼭 껴안았고, %조사처리(CALLNAME:PLAYER,"는")% 허리를 움직여 새로운 활동을 시작했다.")
			ELSE
				CALL k1011GP("W", @"이 광경을 보며, %조사처리(CALLNAME:PLAYER,"는")% 다시 허리를 움직이기 시작했다.")
			ENDIF
		ENDIF
		;装备器具
	ELSEIF k1011GetTequip("导尿管") || k1011GetTequip("采尿器")
		CALL k1011GP("L", @"플랜이 절정에 도달했을 때 실금하자 설치된 기구가 바로 소변을 빨아들였다.")
		CALL k1011GPC("W", @"「아, 플란의 소변이 다 빨려갔어……」", TARGET)
		;其他情况
	ELSE
		IF RAND:3 == 0
			CALL k1011GPC("L", @"「%k1011Sound("Orgasm", "啊……啊……啊、")% 너는 %k1011Name(TARGET, TARGET)%가 정말 우스워 보여?」", TARGET)
			CALL k1011GP("W", @"후란은 자신이 오르가즘의 여운 때문에 소변을 봤다는 것을 모르는 것 같았다.")
		ELSEIF RAND:2 == 0
			CALL k1011GPC("L", @"「%k1011Sound("Orgasm", "哇、哇、")% 소소, 와... 멈출 수가 없어...」", TARGET)
			CALL k1011GP("W", @"절정의 쾌감이 프랑의 몸을 스치고, 프랑 역시 미쳐버렸다.")
		ELSE
			CALL k1011GP("L", @"플란이 오르가즘을 느낄 때, 살짝 떨면서 그 자리에서 소변을 봤다.")
			CALL k1011GPC("W", @"「하아~ ~ ~…………기분 좋다」", TARGET)
		ENDIF
	ENDIF
ENDIF
