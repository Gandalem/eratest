; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/PALAMCNG/MESSAGE/LOSE_VIRGIN.ERB
;-------------------------------------------------
;破处
;-------------------------------------------------

@k1011LoseVirgin
IF k1011GetOtherInfo("处女丧失")
	;恋慕因你先生丧失处女
	IF k1011GetOtherInfo("因为你先生丧失处女")
		;无反发
		IF k1011GetTalent("恋慕") && !k1011GetMark("反发刻印")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……」", TARGET)
			CALL k1011GP("W", @"프랑은 %조사처리(CALLNAME:MASTER,"와")% 꼭 안긴 채, 더욱 애틋하게 키스를 갈구했다.")
			CALL k1011GPC("L", @"「저기, %k1011Name(TARGET, TARGET)% 전부터 정말 하고 싶었는데… 어떻게 해야 할지 몰랐어…… 저기, %k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)% 이렇게 할 수 있어서 기뻐」", TARGET)
			CALL k1011GPC("W", @"「계속 방에만 있다니, 지루하고, 시야도 %k1011Name(TARGET, MASTER)%…… 정말 좋다.」", TARGET)
			;有反发
		ELSE
			CALL k1011GPC("W", @"「부, 부...... %k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%는 네가 나한테 좀 더 잘해 줄 거라고 생각했어......」", TARGET)
			CALL k1011GPC("W", @"「하지만 %k1011Name(TARGET, MASTER)%……%k1011Name(TARGET, TARGET)%라서 싫지는 않아……」", TARGET)
		ENDIF
		K1011GiveMasterVirgin = 1
		;再生处女
	ELSEIF K1011VirginKind == 2
		CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊、哈……哼……")%」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%이 또다시 %k1011Name(TARGET, TARGET)%의 첫 경험을 빼앗았어♪」", TARGET)
		CALL k1011GPC("W", @"「처음은 아니지만, %k1011Name(TARGET, MASTER)%에게 %k1011Name(TARGET, TARGET)%를 빼앗겨서 기뻐…♪」", TARGET)
		;手指插入导致处女喪失
	ELSEIF k1011GetNowSelectcom() == 4
		;恋慕
		IF k1011GetTalent("恋慕") == 1
			CALL k1011GP("W", @"%조사처리(CALLNAME:PLAYER,"는")% 손가락을 빼내자, 예상대로 손가락이 붉게 물들었다.")
			CALL k1011GP("W", @"안쪽이 상당히 단단해서, %조사처리(CALLNAME:MASTER,"는")% 소녀의 순결을 손으로 빼앗으려던 참인데 좋지 않게 팔이 붙잡혔다.")
			CALL k1011GPC("W", @"「%k1011Sound("Mouth", "啾……啾……")%」", TARGET)
			CALL k1011GP("W", @"후란은 진지하게 자신의 순결을 핥고, 끝난 뒤 애교처럼 %조사처리(CALLNAME:MASTER,"를")% 껴안았다.")
			CALL k1011GPC("W", @"「저기, 이제 뭐 할 거야? 즐거운 일 같이 하자~ ~」", TARGET)
			CALL k1011GP("W", @"그저 플란의 표정과 행동이 좀 이상하다고 느꼈다.")
			;除此之外
		ELSE
			CALL k1011GPC("W", @"「좀 아파... 방금 뭐 한 거야?」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 어른이 되었나? 음...」", TARGET)
			CALL k1011GP("W", @"푸란은 상황의 심각성을 깨닫지 못하고, 자신의 순결한 증거를 보며 믿을 수 없다는 표정을 지었다.")
		ENDIF
		;除此之外の時に处女喪失
	ELSE
		IF ASSIPLAY && ASSI > 0
			CALL k1011GPC("W", @"「와... 별로 안 아픈가...」", TARGET)
			CALL k1011GPC("W", @"「동 안이 이상하네……」", TARGET)
			CALL k1011GPC("W", @"「뭔가 흘러나온 것 같아, 화끈화끈해...」", TARGET)
			;恋慕
		ELSEIF k1011GetTalent("恋慕") == 1
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%、%k1011Name(TARGET, TARGET)%……」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%의 첫 경험을 %k1011Name(TARGET, MASTER)%에게 줄 수 있다면…… 좋을 텐데……」", TARGET)
			CALL k1011GPC("W", @"「으, 으윽... 와아아! !」", TARGET)
			CALL k1011GP("W", @"프랑은 소녀처럼 크게 울기 시작했다")
			CALL k1011GP("W", @"그곳에서 유린당한 작은 상처 위로 찢겨진 순결의 증거가 떨어지고 있었다.")
			;除此之外
		ELSE
			CALL k1011GPC("W", @"「와... 별로 안 아픈가...」", TARGET)
			CALL k1011GPC("W", @"「동 안이 이상하네……」", TARGET)
			CALL k1011GPC("W", @"「뭔가 흘러나온 것 같아, 화끈화끈해...」", TARGET)
		ENDIF
	ENDIF
ENDIF
