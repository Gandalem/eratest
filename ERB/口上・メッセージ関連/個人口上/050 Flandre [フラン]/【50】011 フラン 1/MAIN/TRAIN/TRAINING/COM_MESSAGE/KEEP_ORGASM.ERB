		CALL k1011GP("W", @"어쩌면 거대한 성기가 자궁을 건드려 후란쨩이 강렬한 절정을 느끼게 했고, 등을 활처럼 휘며 침대 같은 물보라를 뿜어낸 것이다.")
	ELSEIF RAND:2 == 0
		CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊……啊……♪啊、啊……♪")%」", TARGET)
		CALL k1011GP("W", @"푸란은 작은 머리를 살랑이며 의미 없는 신음만을 흘렸다.")
		CALL k1011GP("W", @"그럼에도 몸은 %조사처리(CALLNAME:PLAYER,"의")% 음경에 반응하여 민감해졌고 여러 번 격렬하게 떨렸다.")
		CALL k1011GPC("W", @"「%k1011Sound("Happy", "哈、哈 - ♪ 嗯、啊、嗯- - -――♪")%」", TARGET)
		CALL k1011GP("W", @"마치 한 번 부딪히거나, 매번 삽입할 때 어린 질이 꽉 조여드는 것 같았다.")
	ELSE
		CALL k1011GP("W", @"프랑은 너무 강렬한 쾌감에 녹아내며, 격렬한 피스톤 운동을 계속했다.")
		CALL k1011GPC("W", @"「%k1011Sound("Happy", "——啊♪ 啊、、、啊！ 啊――♪")%」", TARGET)
		CALL k1011GP("W", @"비록 미끌거리는 좁은 질이었지만, 안쪽은 변함없는 단단함으로 %조사처리(CALLNAME:PLAYER,"의")% 음경을 받아들였다.")
		CALL k1011GPC("W", @"「응, 응...――아아... 아아-- 우고, -- 후, 하-- ♪」", TARGET)
	ENDIF
