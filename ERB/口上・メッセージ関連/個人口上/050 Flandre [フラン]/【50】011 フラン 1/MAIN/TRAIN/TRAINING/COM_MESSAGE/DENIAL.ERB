; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/TRAINING/COM_MESSAGE/DENIAL.ERB

@k1011ComDenial, comId
#DIM comId
#DIM DYNAMIC action	;执行过标志
;自慰
IF comId == 7
	;执行过标志
	action = 1
	CALL k1011GWait()
	;初次
	IF !K1011TrainDenialFirst:通常自慰
		IF K1011InfOfSex == 1
			CALL k1011GPC("W", @"「누군가에게 %k1011Name(TARGET, TARGET)% 한 명을 두다니... 그건 무슨 뜻이지?」", TARGET)
			CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 후란의 뒤로 가서 직접 가르쳐 주려 했으나, 그녀에게 거세게 밀쳐졌다.")
			CALL k1011GPC("W", @"「싫어, 비켜!」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「안 돼!」", TARGET)
			CALL k1011GPC("W", @"「그런 일은 그놈조차 본 적이 없어……」", TARGET)
		ENDIF
		K1011TrainDenialFirst:通常自慰 = 1
		;媚药
	ELSEIF k1011GetTequip("媚药")
		;初回
		IF !K1011TrainDenialFirst:媚药自慰
			IF K1011Character == 1
				CALL k1011GPC("L", @"「하아... 하아...」", TARGET)
				CALL k1011GPC("W", @"「싫어! 설마 저런 사람이 있을 줄이야!」", TARGET)
			ELSE
				CALL k1011GPC("L", @"「이런 상태에서 %k1011Name(TARGET, TARGET)%에게 이런 일을 시키다니...」", TARGET)
				CALL k1011GPC("W", @"「...술이 너무 많이 취한 거 아니야」", TARGET)
			ENDIF
			K1011TrainDenialFirst:媚药自慰 = 1
			;二回目以降
		ELSE
			CALL k1011GPC("L", @"「후후」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 하고 싶지 않아……」", TARGET)
		ENDIF
		;公开自慰
	ELSEIF k1011GetTequip("录像带摄影")
		;初次
		IF !K1011TrainDenialFirst:录像自慰
			CALL k1011GPC("L", @"「혼자서 성인 게임을 하는 거야?」", TARGET)
			CALL k1011GPC("W", @"「안, %k1011Name(TARGET, TARGET)%는 하지 않을 거야」", TARGET)
			K1011TrainDenialFirst:录像自慰 = 1
			;之后
		ELSE
			;正常自慰可以进行
			IF TFLAG:240 > 32
				CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%는 테이프를 좋아하지 않는다」", TARGET)
				CALL k1011GPC("W", @"「……그것을 처리해 줄 수 있겠어...?」", TARGET)
				;正常自慰不行
			ELSE
				CALL k1011GPC("L", @"「싫어!」", TARGET)
				CALL k1011GPC("W", @"「부끄럽다...」", TARGET)
			ENDIF
		ENDIF
		;淋浴自慰
	ELSEIF k1011GetTequip("淋浴play")
		CALL k1011GPC("W", @"「.........」", TARGET)
		;振动棒・肛门振动棒・双穴振动棒自慰
	ELSEIF k1011GetTequip("震动棒") || k1011GetTequip("肛门震动棒")
		;初次
		IF !K1011TrainDenialFirst:震动棒自慰
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)% 한 사람에게 이런 일을 시키다니…… 안 돼……」", TARGET)
			K1011TrainDenialFirst:震动棒自慰 = 1
			;之后
		ELSE
			;正常自慰可以进行
			IF TFLAG:240 > 32
				CALL k1011GPC("W", @"「이런 걸 스스로 한다니... 너무 무섭다, 그냥 평범하게 자위할 수 있을까?」", TARGET)
				;正常自慰不行
			ELSE
				CALL k1011GPC("W", @"「아아... 안 돼」", TARGET)
			ENDIF
		ENDIF
		;通常自慰
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%에게 색스러운 일을 하게 할까?」", TARGET)
		CALL k1011GPC("W", @"「싫어!」", TARGET)
	ENDIF
	;骑乘位
ELSEIF comId == 24
	;执行过标志
	action = 1
	;处女
	IF k1011GetTalent("处女") == 1
		;初回
		IF !K1011TrainDenialFirst:处女骑乘位
			CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%에게 올라타게 할까?」", TARGET)
			CALL k1011GPC("L", @"「싫어... 방금 네 거 거의 들어갈 뻔했잖아」", TARGET)
			CALL k1011GPC("W", @"「네 거시기 좀 치워」", TARGET)
			K1011TrainDenialFirst:处女骑乘位 = 1
			;二回目以降
		ELSE
			CALL k1011GPC("W", @"「네 거시기 좀 치워, 정말 싫어!」", TARGET)
		ENDIF
		;除此之外
	ELSE
		;初回
		IF !K1011TrainDenialFirst:通常骑乘位
			;处女拒绝过
			IF K1011TrainDenialFirst:处女骑乘位
				CALL k1011GPC("W", @"「싫어, 스스로 그 거시기 삼아버려, 무서워...」", TARGET)
				;没有
			ELSE
				CALL k1011GPC("L", @"「스스로 %k1011Name(TARGET, TARGET)%에 살을 박으라고...?」", TARGET)
				CALL k1011GPC("W", @"「그런 일은 너무 무섭고, 할 수 없어... 평소처럼 하자」", TARGET)
			ENDIF
			K1011TrainDenialFirst:通常骑乘位 = 1
			;二回目以降
		ELSE
			CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%는 스스로 먼저 하지 않는 것을 좋아한다...」", TARGET)
			CALL k1011GPC("W", @"「……%k1011Name(TARGET, MASTER)%맵게 하고 싶다면, 직접 %k1011Name(TARGET, TARGET)% 안에 넣어도 괜찮아♪」", TARGET)
		ENDIF
	ENDIF
	;手淫
ELSEIF comId == 40
	;执行过标志
	action = 1
	;初回
	IF !K1011TrainDenialFirst:手淫
		CALL k1011GPC("L", @"「이건 뭐야... 남근?」", TARGET)
		CALL k1011GPC("W", @"「아, 왜 이렇게 뜨거워... 싫어...」", TARGET)
		K1011TrainDenialFirst:手淫 = 1
		;二回目以降
	ELSE
		CALL k1011GPC("W", @"「이런 일이라니... 너무 무서워...」", TARGET)
		CALL k1011GPC("W", @"「너무 무서워, %k1011Name(TARGET, TARGET)%는 안 돼」", TARGET)
	ENDIF
	;口交系
ELSEIF comId == 41
	;执行过标志
	action = 1
	;初回
	IF !K1011TrainDenialFirst:口交
		CALL k1011GPC("L", @"「이건 뭐야... 남근?」", TARGET)
		CALL k1011GPC("W", @"「아, 왜 이렇게 뜨거워... 싫어...」", TARGET)
		K1011TrainDenialFirst:口交 = 1
		;二回目以降
	ELSE
		;无污物可执行
		IF TFLAG:240 + TFLAG:242 >= TFLAG:241
			CALL k1011GPC("L", @"「어이, 위에 붙은 건 뭐야... 역겹다...」", TARGET)
			CALL k1011GPC("W", @"「……만약 네가 깨끗하게 정리한다면, %k1011Name(TARGET, TARGET)%는 시도해 볼 수 있을지도 몰라」", TARGET)
			;干净也不行
		ELSE
			CALL k1011GPC("W", @"「이런 일이라니... 너무 무서워...」", TARGET)
			CALL k1011GPC("W", @"「너무 무서워, %k1011Name(TARGET, TARGET)%는 안 돼」", TARGET)
		ENDIF
	ENDIF
	;乳交系
ELSEIF comId == 42
	;执行过标志
	action = 1
	;初回
	IF !K1011TrainDenialFirst:乳交
		CALL k1011GPC("L", @"「젖가슴으로 거시기 잡는 거야?」", TARGET)
		CALL k1011GPC("W", @"「...이런 일은 이상한 사람 같아」", TARGET)
		K1011TrainDenialFirst:乳交 = 1
		;二回目以降
	ELSE
		CALL k1011GPC("L", @"「가슴으로 말하는 건가?」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 하고 싶지 않다」", TARGET)
	ENDIF
	;素股
ELSEIF comId == 43
	;执行过标志
	action = 1
	;初回
	IF !K1011TrainDenialFirst:素股
		CALL k1011GPC("L", @"「이런 식으로 %k1011Name(TARGET, TARGET)%를 배치해야 하나?」", TARGET)
		CALL k1011GPC("W", @"「싫어, 어떻게 이런 일이 생길 수 있어, 너무 무서워」", TARGET)
		K1011TrainDenialFirst:素股 = 1
		;二回目以降
	ELSE
		CALL k1011GPC("W", @"「그, 너무 역겨워!」", TARGET)
	ENDIF
	;强制舔足
ELSEIF comId == 46
	;执行过标志
	action = 1
	;初回
	IF !K1011TrainDenialFirst:强制舔足
		CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%더러 발을 핥으라고!? %k1011Name(TARGET, TARGET)%더러 이렇게 더러운 걸 핥게 하다니, 꿈도 크시네」", TARGET)
		CALL k1011GPC("W", @"「헤헤... 오히려 네가 %k1011Name(TARGET, TARGET)%의 발을 핥는 게 더 딱이군?」", TARGET)
		K1011TrainDenialFirst:强制舔足 = 1
		;二回目以降
	ELSE
		CALL k1011GPC("W", @"「아이쿠, 정말 더럽네, 비켜」", TARGET)
	ENDIF
ENDIF
RETURN action
