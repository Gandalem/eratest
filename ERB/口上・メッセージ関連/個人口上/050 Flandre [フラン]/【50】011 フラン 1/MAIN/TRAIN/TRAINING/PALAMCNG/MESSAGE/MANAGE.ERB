;----------------------------------------------------------------
;贤者之血
;----------------------------------------------------------------

@k1011SageBloodMedicine
IF k1011GetOtherInfo("贤者之血积累")
	IF K1011BloodMedicine == 0
		IF RAND:3 == 0
			CALL k1011GPC("W", @"「……저, 왜, 왜 갈 수 없는 거예요…… 이상하네요……」", TARGET)
			CALL k1011GP("W", @"프랑은 약의 효과를 모르고 호기심 가득 자신의 몸을 바라보았다.")
		ELSEIF RAND:2 == 0
			CALL k1011GPC("W", @"「하, 아...... 아, 그?」", TARGET)
			CALL k1011GPC("W", @"「몸이 벌떡 일어났는데, 목구멍에서는 멈췄다!」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「응, 응—! 아이고... 이상하네...」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%♥……분명 편해야 하는데 왜 느껴지지 않는 거지, 이게 무슨 일이야……」", TARGET)
		ENDIF
	ENDIF
