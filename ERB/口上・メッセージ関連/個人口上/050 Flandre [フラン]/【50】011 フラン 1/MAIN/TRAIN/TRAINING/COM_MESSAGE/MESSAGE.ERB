				ELSE
					CALL k1011GPC("W", @"「%k1011Name(TARGET, PLAYER)%♥ 안 되겠어, 허리, 부서지겠어... 응!?」", TARGET)
					CALL k1011GPC("W", @"「%k1011Sound("Happy", "呼呀、哈、呜啊啊…")%엄청 격렬해, 하고 있어~ %k1011Name(TARGET, TARGET)%, 지금 서서 H한 일을 하고 있어, 하♪」", TARGET)
