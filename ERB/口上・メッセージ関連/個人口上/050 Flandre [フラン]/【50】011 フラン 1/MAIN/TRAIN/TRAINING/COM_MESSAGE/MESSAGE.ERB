					CALL k1011GP("W", @"위엄 있는 %조사처리(CALLNAME:PLAYER,"의")% 빛을 끌어안은 플란은 애를 먹으며 참다 못하고 스스로 허리를 움직였다.")
					CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%더, 더 기분 좋아지고 싶어! %k1011Name(TARGET, PLAYER)%♥, 자지로 %k1011Name(TARGET, TARGET)%를 기분 좋게 해줄까♪」", TARGET)
				ELSEIF RAND:2 == 0
