; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/START/MESSAGE/LOW_PRIORITY.ERB

@k1011TrainStartLowPriority
;-------------------------------------------------
;屈服事件 反发小于等于1 屈服刻印Lv3
;-------------------------------------------------
IF !K1011TrainStartFirst:屈服 && k1011GetMark("屈服刻印") == 3 && !k1011GetTalent("恋慕") && k1011GetTalent("淫乱") && k1011GetTalent("服从") && k1011GetMark("反发刻印") <= 1
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%！」", TARGET)
	CALL k1011GP("W", @"후란이 %조사처리(CALLNAME:MASTER,"를")% 꼭 안았다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, MASTER)%, 놀러 와」", TARGET)
	CALL k1011GP("W", @"플란은 천진난만한 모습으로 애교를 부렸다. 마치 이미 %조사처리(CALLNAME:MASTER,"를")% 완전히 좋아하게 된 것 같았다.")
	CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 옷 사이로 그녀의 은밀한 곳을 만지자, 플랜의 몸이 즉시 반응했다.")
	CALL k1011GalSetMood("Sing")
	CALL k1011GPC("L", @"「아, 아... 응, 아주 좋아...♪ 오늘도 %k1011Name(TARGET, MASTER)%랑 많이 할 거야...........♪」", TARGET)
	CALL k1011GalSetMood("")
	CALL k1011GP("W", @"후란은 옷을 쉽게 벗기 위해 몸을 비틀며 %조사처리(CALLNAME:MASTER,"의")% 목에 손을 올렸다.")
	CALL k1011GP("W", @"셔츠 단추가 풀리자, 가느다란 미니 스커트가 드러났고, 이어서 미니 스커트가 풀리며 귀여운 팬티가 모습을 드러냈다.")
	CALL k1011GPC("W", @"「——%k1011Name(TARGET, TARGET)%는 돌아가고 싶지 않아…….」", TARGET)
	CALL k1011GP("W", @"플란이 귓가에 조용히 속삭였다. 흥분한 소녀의 달콤한 향기가 코를 찔렀다.")
	CALL k1011GPC("W", @"「프란을 계속 여기 있게 해 줘, %k1011Name(TARGET, MASTER)%이 나한테 야한 걸 가르쳐서 %k1011Name(TARGET, TARGET)%를 기분 좋게 해 줘……♪」", TARGET)
	CALL k1011GP("W", @"플란은 완전히 새로운 즐거움에 몰입하여 이전의 삶을 미련으로 남기지 않았다.")
	K1011TrainStartFirst:屈服 = 1
	RETURN 1
	;-------------------------------------------------
	;反发刻印Lv3
	;-------------------------------------------------
ELSEIF k1011GetMark("反发刻印") == 3 && k1011GetTalent("恋慕") == 0 && k1011GetTalent("疯狂") == 1
	DRAWLINE
	CALL k1011GP("L", @"플란은 눈앞의 %조사처리(CALLNAME:MASTER,"를")% 노려보며 오른손을 움켜쥐었다가, 무언가를 두려워하는 듯 금세 풀었다.")
	CALL k1011GP("W", @"프랑은 그렇게 계속 오른손을 쥐고 있었고, %조사처리(CALLNAME:MASTER,"가")% 어린 소녀의 얼굴 앞에 올 때까지")
	CALL k1011GP("L", @"이어서 어린 소녀가 고개를 들고, 못된 표정을 지었다.")
	CALL k1011GalSetMood("Angry")
	CALL k1011GPC("W", @"「......뭐야」", TARGET)
	CALL k1011GalSetMood("")
	CALL k1011GP("W", @"그것은 매우 불만스러워 들리는 목소리였다.")
	RETURN 1
	;-------------------------------------------------
	;恐怖刻印lv2
	;-------------------------------------------------
ELSEIF k1011GetMark("恐怖刻印") >= 2
	DRAWLINE
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 방에 들어서자마자 플란의 몸이 떨리기 시작하고 표정도 약간 변했다.")
	IF TALENT:恋慕
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, 무서운 일... 그만해 줄 수 없어...?」", TARGET)
		CALL k1011GP("W", @"이전에 준 공포가 플란에게 지금도 가시지 않았다.")
	ELSE
		CALL k1011GPC("W", @"「부, 필요 없어! 필요 없다고!」", TARGET)
		CALL k1011GP("W", @"플란의 붉은 눈에서 안구가 흘러나와 끊임없이 애원하고 있었다.")
	ENDIF
	RETURN 1
	;-------------------------------------------------
	;反发刻印Lv2
	;-------------------------------------------------
ELSEIF k1011GetMark("反发刻印") == 2 && k1011GetTalent("疯狂")
	DRAWLINE
	CALL k1011GPC("W", @"「흐읍, 흐읍...」", TARGET)
	CALL k1011GPC("W", @"「와라 와라... 같이 놀자?」", TARGET)
	CALL k1011GP("W", @"눈알을 지닌 어린 소녀는 제 발을 아무렇게나 흔들면서도,\n변덕스러워 보이는 얼굴에는 천진난만함 속에 기이함이 배어 있는 미소가 떠올라 있었다.")
	RETURN 1
	;-------------------------------------------------
	;反发刻印Lv1
	;-------------------------------------------------
ELSEIF k1011GetMark("反发刻印") == 1 && k1011GetTalent("疯狂")
	DRAWLINE
	;早熟性格
	IF K1011Character == 2
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 막 문을 열자, %k1011Her()%의 비꼬는 목소리가 들렸다.")
		CALL k1011GPC("W", @"「여기 방도 너무 허술하잖아?」", TARGET)
		CALL k1011GPC("W", @"「아아... 여기가 내 방이라면-」", TARGET)
		CALL k1011GPC("W", @"「설령 %k1011Name(TARGET, TARGET)%가 폭주하고 싶다고 해도... 뭐, 이런 폐품 같은 모습이 되겠지」", TARGET)
	ELSE
		CALL k1011GP("W", @"마치 %조사처리(CALLNAME:MASTER,"의")% 도착을 감지한 듯, 플란은 입술을 삐죽 내밀고 작은 몸을 %조사처리(CALLNAME:MASTER,"에게")% 등을 돌렸다.")
		CALL k1011GPC("W", @"%조사처리(CALLNAME:MASTER,"가")% %k1011Her()% 앞에 다가가자, 플랜은 비로소 한 마디를 내뱉었다.", TARGET)
		CALL k1011GPC("W", @"「비켜 줄 수 있어? %k1011Name(TARGET, TARGET)%는 지금 곰이랑 놀고 싶어.」", TARGET)
	ENDIF
	RETURN 1
	;屈服刻印Lv1
ELSEIF (k1011GetMark("屈服刻印") == 1 || k1011GetMark("屈服刻印") == 2)
	DRAWLINE
	IF RAND:3 == 0 && k1011GetTalent("性别", MASTER) == 2
		CALL k1011GPC("W", @"「파츄리가 말했던 것 같아」", TARGET)
		CALL k1011GPC("W", @"「작은 여자아이를 좋아하는 성인 남성은 다 로리 마니아라니, 알고 보니 %k1011Name(TARGET, MASTER)%도 그런 사람이었구나♪」", TARGET)
	ELSEIF RAND:2 == 0
		CALL k1011GPC("W", @"「별로 하고 싶지 않은걸... 이번엔 탄막 게임 하자, 응...? 」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 방에 막 들어왔을 때, 프랑은 포기한 듯 말투를 바꿨다.")
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 무슨 일이야?」", TARGET)
		CALL k1011GPC("W", @"「자, 시작해 봐♪」", TARGET)
		CALL k1011GP("W", @"계속 생각해보니, 플란이 H에 약간 흥미가 생긴 것 같다")
	ENDIF
	RETURN 1
	;屈服刻印Lv3＋无恋慕
ELSEIF k1011GetMark("屈服刻印") == 3 && !k1011GetTalent("恋慕")
	DRAWLINE
	IF RAND:3 == 0
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)% 또 놀러 왔어?」", TARGET)
		CALL k1011GalSetMood("Happy")
		CALL k1011GPC("W", @"「잘됐다, 가르쳐 주는 게 점점 중독되네♪」", TARGET)
		CALL k1011GalSetMood("")
	ELSEIF RAND:2 == 0
		CALL k1011GalSetMood("Sing")
		CALL k1011GPC("W", @"「아, 기회가 드물다니 더 즐겁게 놀자~♪」", TARGET)
		CALL k1011GalSetMood("")
		CALL k1011GP("W", @"후란은 말하다가 부끄러운 표정을 지었다.")
	ELSE
		CALL k1011GalSetMood("Happy")
		CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%이여~!」", TARGET)
		CALL k1011GalSetMood("")
		CALL k1011GP("W", @"방에 들어서자, 플란은 작은 고양이처럼 %조사처리(CALLNAME:MASTER,"의")% 품으로 달려들었다.")
		CALL k1011GPC("W", @"「어이, 우리 뭐 할 거야? 편하게 해주는 거라도 하는 거지?」", TARGET)
		CALL k1011GP("W", @"품에 안긴 플란 양은 애교를 부리며 말했다.")
	ENDIF
	RETURN 1
	;恋慕
ELSEIF k1011GetTalent("恋慕")
	DRAWLINE
	IF k1011GetOtherInfo("贞操带") && RAND:2 == 0
		IF RAND:2 == 0
			CALL k1011GalSetMood("Happy")
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%!」", TARGET)
			CALL k1011GalSetMood("")
			CALL k1011GP("W", @"처녀벨을 찬 플란이 달려와 %조사처리(CALLNAME:MASTER,"를")% 꼭 껴안았다.")
			CALL k1011GPC("W", @"「이게 있어서 다행이야, %k1011Name(TARGET, TARGET)%은 혼자 야한 짓을 하지 않고 얌전히 %k1011Name(TARGET, MASTER)%를 기다리고 있어\n」", TARGET)
			CALL k1011GPC("W", @"「이렇게 오랫동안 안 했으니까, 플란은 %k1011Name(TARGET, MASTER)%랑 많이, 아주 많이 할 거야~♪」", TARGET)
		ELSE
			CALL k1011GP("W", @"플란은 처녀막을 차고 조용히 기다렸지만, %조사처리(CALLNAME:MASTER,"를")% 보자 소리를 질렀다.")
			CALL k1011GalSetMood("Happy")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 이걸 분해해 줘. 플란이 더 이상 참지 못하고 있어」", TARGET)
			CALL k1011GalSetMood("")
			CALL k1011GP("W", @"플란이 초조해하는 모습을 보자, %조사처리(CALLNAME:MASTER,"가")% 그녀의 처녀막을 풀어주자 발정 난 듯한 암컷의 기운을 풍기는 어린 소녀의 음순이 드러났다.")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%에게 야한 보상을 좀 줘!♪」", TARGET)
		ENDIF
		;通用
	ELSE
		IF RAND:7 == 0
			CALL k1011GalSetMood("Happy")
			CALL k1011GPC("W", @"「아 %k1011Name(TARGET, MASTER)%가 드디어 왔네」", TARGET)
			CALL k1011GalSetMood("")
			CALL k1011GPC("W", @"「아까 %k1011Name(TARGET, TARGET)%가 %k1011Name(TARGET, MASTER)%가 슬슬 올 때가 됐다고 생각해서, 준비 운동을 좀 해뒀어. 봐……」", TARGET)
			CALL k1011GP("L", @"후란은 천천히 치맛자락을 들었다.")
			CALL k1011GP("W", @"통통한 것이 이미 자취를 감춘 것을 발견하고, 어린 성기는 애액으로 젖어 있었다.")
			CALL k1011GalSetMood("Sing")
			CALL k1011GPC("W", @"「벌써 이렇게 되어버렸네……♪」", TARGET)
			CALL k1011GalSetMood("")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 어서 와요♪」", TARGET)
			CALL k1011AddPalam("欲情", 2000)
			CALL k1011AddPalam("润滑", 1500)
		ELSEIF RAND:6 == 0
			CALL k1011GalSetMood("Sing")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)% 빨리 와서 놀자♪」", TARGET)
			CALL k1011GalSetMood("")
			CALL k1011GP("W", @"후란은 %조사처리(CALLNAME:MASTER,"에게")% 두 팔을 내밀며 %조사처리(CALLNAME:MASTER,"가")% 자신을 안아주길 졸랐다.")
		ELSEIF RAND:5 == 0
			CALL k1011GP("W", @"방으로 들어가자 플란의 눈은 앞을 응시하고 있었고 입으로는 무언가를 중얼거렸다.")
			CALL k1011GP("W", @"이어서 프랑쨩의 이름을 부른 후, %k1011Her()%은 정신을 차리고 바로 %조사처리(CALLNAME:MASTER,"를")% 바라봤다.")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……와줄 수 있다니 정말 다행이야…♪」", TARGET)
		ELSEIF RAND:4 == 0
			CALL k1011GPC("W", @"「오늘은 %k1011Name(TARGET, TARGET)%한테 %k1011Name(TARGET, MASTER)%가 옷을 벗겨 줬으면 해……」", TARGET)
			CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 애교를 부리는 플란을 안아 올리며 정교한 양장을 한 벌씩 벗겨냈다.")
			CALL k1011GP("W", @"남아있는 어린 듯한 몸과 하얀 피부가 점차 %조사처리(CALLNAME:MASTER,"의")% 눈앞에 드러났다.")
			CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%의 팬티도 벗겨 줘…」", TARGET)
			CALL k1011GP("W", @"플란은 수줍게 얼굴을 붉혔지만, 이내 이를 악물고 이런 요구를 했다.")
			;早熟
		ELSEIF RAND:3 == 0 && K1011Character == 2
			CALL k1011GP("W", @"후란쨩은 아무런 방비도 없이 침대에 누워 잠을 자고 있었다.")
			CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 가까이 올 때, 한쪽 눈을 살짝 떴다.")
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%……」", TARGET)
			CALL k1011GPC("W", @"「방금 %k1011Name(TARGET, MASTER)%랑 같이 노는 꿈을 꿨는데... 지금 계속 놀 수 있어...? ♪」", TARGET)
			;天真
		ELSEIF RAND:2 == 0 && K1011Character == 1
			CALL k1011GPC("L", @"「아, %k1011Name(TARGET, MASTER)%」", TARGET)
			CALL k1011GP("W", @"프란쨩이 %CALLNAME:MASTER%곁으로 달려가, %조사처리(CALLNAME:MASTER,"의")% 뺨에 키스했다.")
			CALL k1011GalSetMood("Sing")
			CALL k1011GPC("W", @"「헤헤, 오늘은 뭘 할까~」", TARGET)
			CALL k1011GalSetMood("")
		ELSE
			CALL k1011GalSetMood("Happy")
			CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)%는 어서...♪」", TARGET)
			CALL k1011GalSetMood("")
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 방에 막 들어오자, 플란은 고양이처럼 %조사처리(CALLNAME:MASTER,"의")% 품으로 달려들었다.")
			CALL k1011GPC("W", @"「우리 기분 좋아지는 일을 하자」", TARGET)
			CALL k1011GP("W", @"후란은 말하면서 고양이처럼 %조사처리(CALLNAME:MASTER,"에게")% 몸을 비볐다.")
		ENDIF
	ENDIF
	RETURN 1
	;没有屈服刻印
ELSE
	DRAWLINE
	IF RAND:3 == 0
		IF K1011Character >= 2
			CALL k1011GPC("W", @"「아... 집에 가고 싶다!」", TARGET)
			CALL k1011GPC("W", @"「사쿠야가 만든 딸기 푸딩이 먹고 싶다」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「…보고 싶어, 코이코이」", TARGET)
			CALL k1011GPC("W", @"「여기서도 갑자기 나타나나요?」", TARGET)
			CALL k1011GPC("W", @"푸란은 옆의 %조사처리(CALLNAME:MASTER,"를")% 전혀 신경 쓰지 않고 혼자 놀이 친구들의 이름을 중얼거렸다.", TARGET)
		ENDIF
	ELSEIF RAND:2 == 0
		CALL k1011GPC("W", @"「혹시 다른 아이랑 놀아볼래? 나 요즘 별로 기분이 안 좋아서.」", TARGET)
		CALL k1011GPC("W", @"「안 돼?... 여기 지하실처럼 지루해.」", TARGET)
	ELSE
		IF k1011GetTalent("性别", MASTER) == 2
			CALL k1011GPC("W", @"「야, 우리 나가서 놀자. %k1011Name(TARGET, MASTER)%…이런 곳은 정말 지루해.」", TARGET)
			CALL k1011GP("W", @"플란은 불쾌한 표정으로 혼잣말을 했다.")
		ELSEIF k1011GetTalent("MASTER:男性") == 0
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%」", TARGET)
			CALL k1011GPC("W", @"「우리 나가서 놀자... 이런 곳은 정말 지루해.」", TARGET)
			CALL k1011GP("W", @"푸란은 불쾌한 표정으로 중얼거렸다.")
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 0
