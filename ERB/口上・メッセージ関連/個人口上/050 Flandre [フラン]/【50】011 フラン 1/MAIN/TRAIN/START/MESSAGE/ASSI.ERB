;灵梦

@k1011TrainStartAssi1001
IF K1011TrainStartFirst:灵梦 == 0
	CALL k1011GPC("W", @"『아, 너였구나, 플란』", ASSI)
	CALL k1011GPC("W", @"「레이무? 왜 왔어?」", TARGET)
	CALL k1011GPC("W", @"『겨우 왔는데... 아, 그러고 보니 나랑 약속했잖아--』", ASSI)
	CALL k1011GP("L", @"레이무가 말을 끝내기도 전에, 플란은 레이무를 침대에 눕혔다.")
	CALL k1011GPC("W", @"「자주 오겠다고 했었는데... 하지만 그때 이후로, 한 번도 오지 않았어」", TARGET)
	CALL k1011GPC("W", @"『흐흐... 그래, 그럼 지금부터 너랑 놀게』", ASSI)
	CALL k1011GP("W", @"레이무는 조금도 저항하지 않고 후란의 조용히 다가온 작은 입술을 받아들였다.")
	K1011TrainStartFirst:灵梦 = 1
ELSEIF K1011TrainStartFirst:灵梦 == 1 && !(k1011GetTalent("贞操观念") == 1 && k1011GetTalent("恋慕"))
	CALL k1011GPC("L", @"「말해봐 레이무, 너는 나의 아내가 되고 싶은 거야 아니면 남편이 되고 싶은 거야?」", TARGET)
	CALL k1011GPC("W", @"『아?! 왜 그렇게 말하는 거야!』", ASSI)
	CALL k1011GPC("L", @"「하지만 마리사가 신사 무녀를 나에게 소개해 주고, 우리가 잘 어울린다고 말했어.」", TARGET)
	CALL k1011GPC("W", @"『흥......마리사가 그 자식, 이렇게 귀찮은 일을...... 역시 그 자식이 꾸민 게 틀림-』", ASSI)
	CALL k1011GPC("W", @"「마리사는 무슨! 우리 일단 제대로 놀자!」", TARGET)
	K1011TrainStartFirst:灵梦 = 2
ELSE
	CALL k1011GPC("L", @"「호호호, 레이무를 볼 수 있다니 정말 기쁘네♪」", TARGET)
	CALL k1011GPC("W", @"『......이런 어린 여자아이에게까지 손을 대다니, %조사처리(CALLNAME:MASTER,"는")% 정말이지...』", ASSI)
ENDIF
;魔理沙

@k1011TrainStartAssi1002
IF K1011TrainStartFirst:魔理沙 == 0
	CALL k1011GPC("W", @"『아......』", ASSI)
	CALL k1011GPC("W", @"「아, 마리사 선생님, 당신은 감히 이런 곳에 와서 물건을 훔치다니? 크크」", TARGET)
	CALL k1011GPC("W", @"『뭐야, 혹시 오늘 내 상대가 이 녀석이야? 좀... 와』", ASSI)
	CALL k1011GP("L", @"후란이 갑자기 마리사를 넘어 침대에 누르게 했다.")
	CALL k1011GPC("W", @"「히히, 다시는 도망가지 못하게 할 거야」", TARGET)
	CALL k1011GPC("W", @"『이봐 이봐, 주도권은 내 손에 있어야 한다』", ASSI)
	CALL k1011GPC("W", @"「그건 상관없어, 같이 놀자♪」", TARGET)
	K1011TrainStartFirst:魔理沙 = 1
ELSE
	CALL k1011GPC("L", @"「마리사, 너 언제쯤 나한테 결혼 상대 소개해 줄 수 있어?」", TARGET)
	CALL k1011GPC("W", @"『음... 다음에 또 보자』", ASSI)
	CALL k1011GPC("W", @"「아, 알겠어. 난 별다른 의견 없어. 네가 스스로를 소개해 주는 것도 괜찮지♪」", TARGET)
	CALL k1011GP("W", @"후란은 말하며 마리사를 한 번 입맞춤했다.")
ENDIF
;红美铃

@k1011TrainStartAssi1006
IF K1011TrainStartFirst:美铃 == 0
	CALL k1011GPC("L", @"「와! 미즈루야! ♪」", TARGET)
	CALL k1011GPC("W", @"『아! 여동생...?!』", ASSI)
	CALL k1011GPC("W", @"「오늘 미즈루랑 같이 놀 수 있어요? 고마워요! %k1011Name(TARGET, MASTER)%!」", TARGET)
	CALL k1011GP("L", @"푸란은 천진난만하게 미즈루를 안았고, 미즈루는 놀라서 그녀를 바라보았다.")
	CALL k1011GPC("W", @"『저기, 좀 여쭤보고 싶은 게 있어요.』", ASSI)
	CALL k1011GPC("W", @"『왜 누이를 여기에 데려왔지? 구체적인 상황을 말해줘.』",ASSI)
	DRAWLINE
	CALL k1011GP("SL", @"아, 플란과 미령에게 무슨 관계가 있어?")
	CALL k1011GSetQ("彩虹组", "一般般(素质默认)")
	$INPUT_LOOP_15
	CALL k1011GInput()
	IF RESULT == 0
		CALL k1011GP("L", @"―궁합이 좋아졌다―")
		RELATION:k1011RealNo(1006) = 150
	ENDIF
	K1011TrainStartFirst:美铃 = 1
ELSE
	CALL k1011GPC("L", @"「미링♪ 미링♪♪」", TARGET)
	CALL k1011GP("W", @"푸란은 마치 어머니에게 애교를 부리는 아이처럼 미스루의 등을 안고 흥분해서 말했다.")
	CALL k1011GPC("W", @"『음, 음... 자, 시작하자』", ASSI)
ENDIF
;咲夜

@k1011TrainStartAssi1009
IF K1011TrainStartFirst:咲夜 == 0
	CALL k1011GP("W", @"후란은 사쿠야를 알아보고 눈을 한 번 깜빡였다.")
	CALL k1011GPC("W", @"「아, 그게—」", TARGET)
	CALL k1011GPC("W", @"『나는 사쿠야, 누나다.』", ASSI)
	CALL k1011GP("W", @"사쿠야가 그렇게 말하자, 플란이 화를 냈다.")
	CALL k1011GPC("W", @"「...그러면 어때? 그 사람한테 찾아가기만 하면 되잖아?」", TARGET)
	CALL k1011GPC("W", @"『오늘은 봉 대소저의 명령으로 여동생을 보러 왔다.』", ASSI)
	CALL k1011GPC("W", @"「음... 별거 없어」", TARGET)
	CALL k1011GP("W", @"후란은 사쿠야의 허리를 꽉 안고, 얼굴이 새빨개진 채 그녀를 올려다보았다.")
	CALL k1011GPC("W", @"「누나라고 부르는 게 어른스러운 호칭이라고 했지, 알겠어?」", TARGET)
	CALL k1011GP("W", @"사쿠야는 그녀의 말에 깜짝 놀랐다가, 그녀의 귀여움에 웃음을 터뜨렸다.")
	CALL k1011GPC("W", @"『알겠습니다, 후란 아가씨』", ASSI)
	K1011TrainStartFirst:咲夜 = 1
ELSE
	CALL k1011GPC("W", @"「사쿠야, 누나의 시녀는 하지 말고, 나의 시녀가 되어줘!」", TARGET)
	CALL k1011GPC("W", @"『좋습니다, 저는 두 분 아가씨의 메이드입니다』", ASSI)
	CALL k1011GPC("W", @"「칫, 필요 없어. 지금은 나 혼자만 모셔야 해.」", TARGET)
ENDIF
