CALL k1011GPC("W", @"「……그게, 아주 오래전……아주 오래전에」", TARGET)
CALL k1011GPC("W", @"「누군가 나에게 행복을 찾아야 한다고 말했다.」", TARGET)
CALL k1011GPC("W", @"「행복을 찾을 때, 고통을 겪기도 하고 눈물을 흘리기도 한다.」", TARGET)
CALL k1011GPC("W", @"「하지만, 행복하고 즐거운 마음을 유지하는 것이 가장 중요하다.」", TARGET)
CALL k1011GPC("W", @"「그게 가장 하기 힘든 일이야」", TARGET)
CALL k1011GPC("W", @"「난 그렇게 생각해…… 언니랑, 다 같이 놀 때는\n항상 즐겁고 행복한 마음으로」", TARGET)
CALL k1011GPC("W", @"「그래서 나는 항상 매우 행복하다고 느낀다」", TARGET)
CALL k1011GPC("W", @"「하지만 처음 %k1011Name(TARGET, MASTER)%와 함께 플레이할 때는 항상 고통스럽고 슬픈 마음이었다.」", TARGET)
CALL k1011GPC("W", @"「그래서 나는 기분이 좋지 않았다」", TARGET)
CALL k1011GPC("W", @"「하지만 즐겁고 행복한 마음으로 회상하며…… 다시 생각해보니,」", TARGET)
CALL k1011GPC("W", @"「마치... 기쁘고, 행복한 것 같아...」", TARGET)
CALL k1011GPC("W", @"「이런 거지」", TARGET)
CALL k1011GalSetMood("Love")
CALL k1011GPC("W", @"「저... 저의 행복은 바로... %k1011Name(TARGET, MASTER)%와 함께 있는 거예요...」", TARGET)
CALL k1011GalSetMood("")
PRINTL
CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……나를 꼭 안아주고 있니?」", TARGET)
CALL k1011GSleep
CALL k1011GPC("W", @"「저기, %k1011Name(TARGET, MASTER)%……너랑 이렇게 오래 지냈는데 아직 네 생일이 몇 일인지 모르겠어……」", TARGET)
CALL k1011GPC("W", @"「플란에게 말해도 될까?」", TARGET)
CALL k1011GP("SL", @"플란에게 네 생일을 알려줘야 해?")
CALL k1011GSetQ("当然可以", "这是我的个人秘密")
CALL k1011GInput()
IF RESULT == 0
	CALL k1011AskBirthDayMain()
	IF K1011MasterBirthday:0 == 7 && K1011MasterBirthday:1 == 4
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%의 생일도 7월 4일!?」", TARGET)
		CALL k1011GPC("W", @"「란의 생일도 7월 4일이야」", TARGET)
		CALL k1011GPC("W", @"「아무래도 하늘도 우리 둘이 함께하기를 바라는 것 같아~♪」", TARGET)
	ENDIF
ELSEIF RESULT == 1
	CALL k1011GPC("W", @"「프란에게 말하지 않아도 괜찮아」", TARGET)
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%에게도 %k1011Name(TARGET, MASTER)%만의 비밀은 있는 거야」", TARGET)
ENDIF
