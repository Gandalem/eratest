; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/START/MESSAGE/MIDDLE_PRIORITY.ERB

@k1011TrainStartMiddlePriority
;-------------------------------------------------
;TODO节日判断
;-------------------------------------------------
;玩家生日
IF k1011GetDay("玩家生日") && !K1011Festive:trainStart:玩家生日 && TALENT:恋慕
	CALL k1011MasterBirthday
	;过了生日了在选择调教对象时就不说了
	K1011Festive:impression:玩家生日 = 1
	K1011Festive:event:玩家生日 = 1
	K1011Festive:trainStart:玩家生日 = 1
	RETURN 1
	; ;情人节
	;芙兰日
ELSEIF k1011GetDay("芙兰日") && !K1011Festive:trainStart:芙兰日
	CALL k1011FlanBirthday
	K1011Festive:trainStart:芙兰日 = 1
	RETURN 1
	;-------------------------------------------------
	;学吸血
	;好感度>=3700
	;-------------------------------------------------
ELSEIF !K1011TryVampirism && k1011GetCflag("好感") >= 3700 && k1011GetTalent("恋慕")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……」", TARGET)
	CALL k1011GP("W", @"플란의 모습이 좀 이상하다")
	CALL k1011GP("W", @"상기된 하얀 피부와 약간 거친 숨소리")
	CALL k1011GP("W", @"성적인 흥분이 조금 다르다")
	CALL k1011GP("W", @"푸란쨩은 선홍색 눈으로 %조사처리(CALLNAME:MASTER,"의")% 어느 한 곳을 계속 응시했다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%…%k1011Name(TARGET, TARGET)% 아무 일 없어. 빨리… 해줘?」", TARGET)
	CALL k1011GP("W", @"...프란이 그렇게 말했으니, %조사처리(CALLNAME:MASTER,"는")% 평소처럼 조교를 시작하기로 결정했다.")
	;结局预定
	K1011TrainEndSc '= "学吸血"
	;-------------------------------------------------
	;接受快感 肛门４　自慰１
	;-------------------------------------------------
ELSEIF k1011GetAbl("Ａ感觉") >= 3 && k1011GetAbl("自慰中毒") >= 1 && k1011GetTalent("快感接受度") != 1 && !K1011TrainStartFirst:接受快感
	CALL k1011GalSetMood("Surprise")
	CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%!?」", TARGET)
	CALL k1011GalSetMood("")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 방에 막 들어오자, 후란은 황급히 이불로 몸을 감쌌다.")
	CALL k1011GP("W", @"하지만 문을 여는 순간, %k1011Her()%의 흐트러진 옷은 %조사처리(CALLNAME:MASTER,"의")% 눈에 포착되었다……. 음, 자위 중인가 보다.")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 한마디도 하지 않고 조교를 시작하려 했는데... 갑자기 불안한 기색을 보이는 플란이 무언가 말하고 싶어 하는 것 같았다.")
	CALL k1011GPC("W", @"「어, 저기...」", TARGET)
	CALL k1011GPC("W", @"「아, 그게...」", TARGET)
	CALL k1011GP("SL", @"얼굴이 새빨개져서 말을 더듬으며 무언가 말하려는 플란 양을 보며, %조사처리(CALLNAME:MASTER,"는")% 결정했다…….")
	CALL k1011GSetQ("难得的机会、等一下吧", "无所谓、和往常一样尽情的疼爱芙兰吧")
	CALL k1011GInput()
	IF RESULT == 0
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 참을성 있게 기다리던 중, 플란은 드디어 결심하고 말했다.")
		CALL k1011GPC("W", @"「그게... 방금... 잠깐 해봤어...」", TARGET)
		CALL k1011GPC("W", @"「그, 그게... 가지고 논 건 클리가 아니야......~~~~~」", TARGET)
		CALL k1011GPC("W", @"「음, 맞아요... 엉덩이, 왜냐하면... 정말 기분이 좋아서, 이렇게 해도 괜찮을까요...」", TARGET)
		CALL k1011GP("SL", @"...란은 수치심과 불안이 뒤섞인 눈빛으로 %조사처리(CALLNAME:MASTER,"를")% 올려다보며 미간을 찌푸렸다.")
		CALL k1011GSetQ("没什麼奇怪的、变得直率也行", "捅肛门来做h事情真是太可怕了")
		CALL k1011GInput()
		IF RESULT == 0
			CALL k1011GPC("W", @"「정말...? %k1011Name(TARGET, MASTER)%는 거짓말 안 했지?」", TARGET)
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이는 것을 본 %k1011Her()%는 기쁘면서도 수줍은 듯 이불을 들춰\n흐트러진 옷을 드러냈다.")
			CALL k1011GPC("W", @"「그게... %k1011Name(TARGET, TARGET)%는 엉덩이 만질 때가 제일 편해...」", TARGET)
			CALL k1011GPC("W", @"「그래서 이제 시작이야. %k1011Name(TARGET, TARGET)%의 엉덩이가 더, 더 편안한 일들을 원하고 있어...♪」", TARGET)
		ELSEIF RESULT == 1
			CALL k1011GPC("W", @"「아......♪」", TARGET)
			CALL k1011GP("W", @"푸란은 얼굴이 새빨개진 채 조심스럽게 침대 시를 내렸다.")
			CALL k1011GP("W", @"그리고 스스로 흐트러진 옷을 벗고 누워 작은 엉덩이를 이쪽으로 돌렸다.")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%……방금 엉덩이를 만졌어, 한참 동안…♪」", TARGET)
			CALL k1011GP("W", @"밀어 올린 복숭아 엉덩이, 깊은 곳에는 기대감에 떨리는 항문이 드러났다.")
			CALL k1011GP("W", @"그럼, 어떻게 해야 할까요?")
		ENDIF
		DRAWLINE
		CALL k1011GP("W", @"플랜이 「쾌감 수용도」를 얻었다.")
		CALL k1011SetTalent("快感接受度", 1)
	ELSEIF RESULT == 1
		CALL k1011GPC("W", @"「아...」", TARGET)
		CALL k1011GP("W", @"푸란쨩은 %조사처리(CALLNAME:MASTER,"가")% 손을 내미는 것을 보고 얼굴에 약간 쓸쓸한 표정을 지었다.")
	ENDIF
	CALL k1011AddPalam("快Ａ", 3000)
	CALL k1011AddPalam("润滑", 5000)
	K1011TrainStartFirst:接受快感 = 1
	RETURN 1
	;-------------------------------------------------
	;淫尻取得
	;-------------------------------------------------
ELSEIF k1011GetTalent("淫尻") && !K1011TrainStartFirst:淫尻取得
	DRAWLINE
	CALL k1011GPC("W", @"「와, 와...! 와♪」", TARGET)
	CALL k1011GP("W", @"방에 들어서자, 플란은 홀로 격렬하게 게임을 하고 있었다.")
	CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)% 씨, 오신 것을 환영합니다.」", TARGET)
	CALL k1011GP("W", @"푸란은 %조사처리(CALLNAME:MASTER,"를")% 알아봤지만 자위하는 손을 멈추지 않았다.")
	CALL k1011GP("W", @"자세히 보면... 플랜은 음순이 아니라 국문을 가지고 노는 것이다")
	CALL k1011GPC("W", @"「저, 저기요... 음♪ 방금 화장실에 다녀왔어요」", TARGET)
	CALL k1011GPC("W", @"「왜냐면, 하고 나서, 아......♪ 플란은 기분이 좋다, 아......」", TARGET)
	CALL k1011GPC("W", @"「그래서 후란은 계속 자위하고 있어♪」", TARGET)
	CALL k1011GP("L", @"키쿠몬은 나로부터 흘러나온 애액에 젖었다.")
	CALL k1011GP("W", @"푸란은 두두두 소리를 내며 전념해서 가지고 놀았다.")
	CALL k1011GPC("W", @"「갈 거야, 갈 거야!!」", TARGET)
	CALL k1011GPC("W", @"「엉덩이 와와와!! 응 와와와~ ~ ! !♪」", TARGET)
	CALL k1011GP("W", @"후란은 전전긍긍 떨며 절정에 도달해, 공허한 눈으로 나를 바라봤다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 부디... 플란의... 엉덩이를... 놀려줘♪」", TARGET)
	K1011TrainStartFirst:淫尻取得 = 1
	CALL k1011AddPalam("快Ａ", 9999)
	CALL k1011AddPalam("润滑", 20000)
	CALL k1011AddPalam("欲情", 49500)
	;接受快感取得
	IF !k1011GetTalent("接受快感")
		CALL k1011GP("W", @"플랜이 「쾌감 수용도」를 얻었다.")
		CALL k1011SetTalent("快感接受度", 1)
	ENDIF
	;-------------------------------------------------
	;怀孕
	;怀孕日期储存在K1011PregDay中
	;-------------------------------------------------
ELSEIF DAY - K1011PregDay >= 12 && GROUPMATCH(K1011PregFlow, 0, 1, 2) && k1011GetTalent("怀孕")
	DRAWLINE
	CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%……」", TARGET)
	CALL k1011GP("W", @"오랫동안 임신했던 플란 양, 이제 산모가 되었다.")
	CALL k1011GP("W", @"후란은 일어나려 했지만, 배가 너무 고팠는지 몇 번이나 토했다.")
	CALL k1011GPC("W", @"「오늘도 색다른 일을 할 거야?」", TARGET)
	CALL k1011GPC("W", @"「……그렇게 격렬하면 안 되지만, 불가능한 건 아니야?」", TARGET)
	CALL k1011GP("W", @"푸란쨩은 약간 불안하게 %조사처리(CALLNAME:MASTER,"를")% 바라봤다.")
	CALL k1011GP("W", @"분만까지 며칠 남지 않았고, 임신을 만끽하고 싶은 플란 씨는 지금뿐이다.")
	K1011PregFlow = 3
ELSEIF DAY - K1011PregDay >= 6 && GROUPMATCH(K1011PregFlow, 0, 1) && k1011GetTalent("怀孕")
	DRAWLINE
	CALL k1011GalSetMood("Happy")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%님을 환영합니다」", TARGET)
	CALL k1011GP("W", @"푸란쨩은 불룩해진 배를 쓰다듬었다.")
	CALL k1011GalSetMood("Surprise")
	CALL k1011GPC("W", @"「앗?! 방금 움직였어, 어머, 아기가 방금 움직였어!」", TARGET)
	CALL k1011GalSetMood("Sing")
	CALL k1011GPC("W", @"「히히, 어서 태어나면 좋겠네♪」", TARGET)
	CALL k1011GalSetMood("")
	CALL k1011GP("W", @"태아는 순조롭게 성장하는 것 같지만, 분만까지는 시간이 좀 남아있다.")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 한 걸음씩 임산부가 되어가는 소녀를 보며, 부도덕한 흥분감이 들끓었다.")
	K1011PregFlow = 2
ELSEIF DAY - K1011PregDay >= 1 && K1011PregFlow == 0 && k1011GetTalent("怀孕")
	DRAWLINE
	CALL k1011GalSetMood("Sing")
	CALL k1011GPC("W", @"「아기는 괜찮을까♪ 좀 빨리 태어나면 안 될까♪」", TARGET)
	CALL k1011GalSetMood("")
	CALL k1011GP("W", @"푸란 씨는 노래를 흥얼거리며 살짝 부푼 배를 어루만졌다.")
	CALL k1011GalSetMood("Happy")
	CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%!」", TARGET)
	CALL k1011GalSetMood("")
	CALL k1011GPC("W", @"「음, 세 명이 함께 하는 거, 야하네♪」", TARGET)
	CALL k1011GP("W", @"후란쨩의 출산까지는 시간이 좀 더 있다.")
	CALL k1011GP("W", @"오늘은 임신한 플란이랑 뭘 할까?")
	K1011PregFlow = 1
	RETURN 1
	;助手口上
ELSEIF ASSI > 0
	RESULT = 0
	TRYCALLFORM k1011TrainStartAssi{k1011GetNo(ASSI)}
	RETURN RESULT
ENDIF
