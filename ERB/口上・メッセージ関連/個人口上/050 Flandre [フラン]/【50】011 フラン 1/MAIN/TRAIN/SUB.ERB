; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/SUB.ERB

@k1011BackRod
;振动棒
IF !ITEM:k1011GetItem("振动棒") && (K1011FlanHaveRod & 1p0)
	CALL k1011SetItem("振动棒", 1)
	K1011FlanHaveRod -= 1p0
	PRINTFORMW 진동봉이 없는 %조사처리(CALLNAME:MASTER,"가")% 플랜의 진동봉을 거두었다.
ENDIF
;肛门振动棒
IF !ITEM:k1011GetItem("肛门振动棒") && (K1011FlanHaveRod & 1p1)
	CALL k1011SetItem("肛门振动棒", 1)
	K1011FlanHaveRod -= 1p1
	PRINTFORMW 항문 진동봉이 없는 %조사처리(CALLNAME:MASTER,"는")% 플란의 진동봉을 거두었다.
ENDIF
;初次标志
;位运算
;读取

@k1011GetComFirst(com = -999)
#FUNCTION
#DIM com
#DIM index
#DIM GCF_BIT ;custom
;#DIM bit
SIF com == -999
	com = k1011GetNowSelectcom()
SIF com < 0 || com > 1000
	RETURNF 0
index = com / 64
GCF_BIT = GCF_BIT % 64
POWER GCF_BIT, 2, GCF_BIT
RETURNF K1011ComFirst:index & GCF_BIT
;设置

@k1011SetComFirst(com = -999)
#DIM com
#DIM index
#DIM SCF_BIT ;custom
;#DIM bit
SIF com == -999
	com = k1011GetNowSelectcom()
SIF com < 0 || com > 1000
	RETURN 0
index = com / 64
SCF_BIT = com % 64
POWER SCF_BIT, 2, SCF_BIT
K1011ComFirst:index |= SCF_BIT
