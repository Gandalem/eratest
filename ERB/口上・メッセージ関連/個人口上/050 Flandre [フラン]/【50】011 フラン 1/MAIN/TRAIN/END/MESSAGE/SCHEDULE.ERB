; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/TRAIN/END/MESSAGE/SCHEDULE.ERB

@k1011TrainEndSc
;没有
SIF K1011TrainEndSc == ""
	RETURN 0
SELECTCASE K1011TrainEndSc
	;初潮来临
	CASE "初潮"
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 출혈 부위를 처리했지만, 아무리 해도 푸란의 아랫배에서 피가 계속 흘렀다…")
		;喜欢芙兰
		IF k1011Love()
			CALL k1011GPC("W", @"「……뭐지, 이건 %k1011Name(TARGET, MASTER)%...?……무서워……」", TARGET)
			CALL k1011GP("W", @"%CALLNAME:MASTER%출혈을 계속 처리하는 동시에\n프란을 품에 안고 자신의 체온으로 완화되길 바라며%k1011Her()%복부의 통증\n프란에게 초경의 의미를 설명하며")
			CALL k1011GP("W", @"얼마나 지났을까%k1011Her()%~에%조사처리(CALLNAME:MASTER,"의")% 위로 아래 잠이 들었다\n몸이 격렬한 활동을 멈추고 출혈도 일시적으로 멎었기 때문에")
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 조심스럽게 프랑에게 이불을 덮어주고 살금살금 방 문을 나섰다.")
		ELSE
			CALL k1011GP("W", @"한동안 뒤적거린 후, %조사처리(CALLNAME:MASTER,"의")% 인내심이 다한 듯했다.\n피로 흠뻑 젖은 종이를 %k1011Her()%의 얼굴에 내던지고는 몸을 돌려 떠났다.")
			CALL k1011GP("L", @"눈가에 눈물만 가득한 프란이 짙은 붉은 종이 더미 속에 누워 힘없이 희미한 말을 내뱉었다.")
			CALL k1011GPC("W", @"「……%k1011Name(TARGET, TARGET)%……정말로 죽는 거야……」", TARGET)
		ENDIF
		CALL k1011GP("W", @"이 후에 작은 구멍 안에 사정하면 위험할지도 모른다.")
		CALL k1011GP("W", @"다행히 어린 몸으로 임신할 확률은 비교적 낮지만, 역시 주의해야 할 사항이다.")
		;学吸血
	CASE "学吸血"
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%…이제 가야 하나…?」", TARGET)
		CALL k1011GP("W", @"플란은 평소보다 더 쓸쓸한 표정으로 %조사처리(CALLNAME:MASTER,"를")% 바라봤다.")
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 그녀와 조금 더 함께 있고 싶어서, 플란 옆에 앉았다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……」", TARGET)
		CALL k1011GP("W", @"그녀의 몸을 쓰다듬고, 플란은 그녀의 손을 잡고 탐욕스럽게 자극을 구했다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……음, 아아아……」", TARGET)
		CALL k1011GP("W", @"거친 숨소리와 달콤한 목소리가 방 안을 울렸다.")
		CALL k1011GP("W", @"이제야 %조사처리(CALLNAME:MASTER,"는")% 플란에게 뭔가 이상하다는 것을 깨달았다.")
		CALL k1011GP("W", @"플란은 %조사처리(CALLNAME:MASTER,"를")% 밀치고 넘긴 후, 비정상적으로 흥분한 모습으로 계속 거친 숨을 몰아쉬었다.")
		CALL k1011GPC("W", @"「하……하……음……」", TARGET)
		CALL k1011GP("W", @"갈망하는 %조사처리(CALLNAME:MASTER,"의")% 어린 입술이 %CALLNAME:MASTER%위에서 어지럽게 움직이고, 침대 위의 고리들이 지지직 소리를 내고 있었다.")
		CALL k1011GPC("W", @"「%k1011Sound("Mouth", "唔、嗯、唔、普洛、唔、唔、唔……")%」", TARGET)
		CALL k1011GP("W", @"마치 %조사처리(CALLNAME:MASTER,"의")% 키스를 받고 싶어하는 듯하다.")
		CALL k1011GP("W", @"눈앞의 혈색 안목 속에는 예전의 천진난만함이 사라지고 갈망으로 가득 찬 시선이 있었다.")
		CALL k1011GPC("W", @"「음, %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%, %k1011Name(TARGET, TARGET)%......하고 싶어......%k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GP("W", @"프랑쨩이 %조사처리(CALLNAME:MASTER,"의")% 가슴 앞에서 날카로운 손톱을 드러냈다.")
		CALL k1011GP("W", @"가슴 앞에서 통증이 느껴졌다.")
		CALL k1011GP("W", @"피가 그곳에서 천천히 새어 나왔고, 플란은 즉시 혀로 그곳을 핥기 시작했다.")
		CALL k1011GPC("W", @"「쏴아... 쏴아... 쏴아...」", TARGET)
		CALL k1011GP("W", @"플란은 우유 마시는 새끼 고양이 같은 표정으로 %조사처리(CALLNAME:MASTER,"의")% 피를 조용히 핥았다.")
		CALL k1011GP("W", @"......만약 이것이 후랑쨩의 본성이라면 어쩔 수 없다. 만약 피 같은 것이라면, 내가 줄 수 있다")
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 프랑의 머리를 쓰다듬으며 눈을 감았다.")
		CALL k1011GWait
		CALL k1011GP("W", @"— 한 차례 극심한 고통이 밀려왔다.")
		CALL k1011GP("W", @"눈을 뜨자, 한 쌍의 호랑이 송곳니가 %조사처리(CALLNAME:MASTER,"에게")% 박혀 있었고, 다량의 피가 뿜어져 나왔다.")
		CALL k1011GP("W", @"동시에 자신의 의식도 급속히 사라졌다.")
		CALL k1011GPC("W", @"「쿠—후우————!」", TARGET)
		CALL k1011GP("W", @"각성한 본능의 악마는 모든 것을 잊고 탐욕스럽게 %조사처리(CALLNAME:MASTER,"를")% 빨아들였다.")
		CALL k1011GP("W", @"눈앞의 혈색 눈동자 속에서 예전의 천진난만함이 사라졌다.")
		CALL k1011GP("W", @"피를 갈망하는 눈빛이 가득했다.")
		CALL k1011GPC("W", @"「――호————응!」", TARGET)
		CALL k1011GP("W", @"비록 조금 혼란스러웠지만, %조사처리(CALLNAME:MASTER,"는")% 현재 상황을 이해했다.")
		CALL k1011GP("SL", @"부주의한 플란에게 피를 빨릴 수도 있다.")
		CALL k1011GSetQ("接受", "推开")
		CALL k1011GInput()
		IF RESULT == 1
			CALL k1011GP("W", @"비정상적인 느낌을 받은 후, %조사처리(CALLNAME:MASTER,"는")% 온 힘을 다해 플란을 날려버렸다.")
			CALL k1011GalSetMood("Surprise")
			CALL k1011GPC("W", @"「아!」", TARGET)
			CALL k1011GalSetMood("")
			;喜欢芙兰
			IF k1011Love()
				CALL k1011GP("L", @"푸란의 동공은 이 충격으로 원래의 빛을 되찾았다.")
				CALL k1011GP("W", @"프랑은 얼굴이 창백했고, 마치 「죄송합니다」라고 말하는 듯했다.")
				CALL k1011GPC("W", @"「흐, 흐윽……」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, 미안해, 미안해……」", TARGET)
				CALL k1011GPC("W", @"「싫... 싫어... 미워하지 말아줘...」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 다시는 안 할 거야, 미안해, 미안해」", TARGET)
				CALL k1011GPC("W", @"「우, 우, 와, 와——! !」", TARGET)
				CALL k1011GP("W", @"플란은 거기서 엉엉 울었다.")
				CALL k1011GPC("W", @"「응... 응... 아아!... 너무 슬프고, 정말 싫어...」", TARGET)
				CALL k1011GP("W", @"프랑은 정말 자신의 생명을 빼앗으려고 흡혈한 걸까...")
				CALL k1011GP("W", @"혹은 본능에게 지더라도, 갈증을 채울 수 있다면 누구라도 괜찮은 건가….")
				CALL k1011GP("W", @"역시――")
				CALL k1011GSleep()
				CALL k1011GP("W", @"――죄책감을 느끼는 %조사처리(CALLNAME:MASTER,"는")% 계속 울고 있는 플란쨩을 달래며, 이미 차가워진 그녀의 몸을 따뜻하게 감쌌다.")
				;不喜欢
			ELSE
				CALL k1011GP("W", @"프랑쨩의 작은 몸이 공중에서 날아, 침대에서 굴러떨어졌다.")
				CALL k1011GP("W", @"곧 몸을 돌려 떠났다... 이 노예는 너무 위험해, 다음 조교 때는 반드시 대비해야 해.")
				CALL k1011GP("L", @"푸란의 동공은 이 충격으로 원래의 빛을 되찾았다.")
				CALL k1011GPC("W", @"「흐, 흐윽……」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, 미안해, 미안해……」", TARGET)
				CALL k1011GPC("W", @"「싫... 싫어... 미워하지 말아줘...」", TARGET)
				CALL k1011GP("W", @"플란은 따라잡으려 했다%CALLNAME:MASTER%사과하려고 쫓아가려 했지만, 방금 너무 세게 넘어졌는지 몸에 힘이 하나도 안 들어서\n오직 멍든 작은 손 하나를 들어 굳게 닫힌 문 쪽으로 내밀 뿐이었다")
				CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 다시는 안 할 거야, 미안해, 미안해」", TARGET)
				CALL k1011GPC("W", @"「우, 우, 와, 와——! !」", TARGET)
				CALL k1011GP("W", @"안타깝게도 다친 %k1011Her()%의 힘없는 목소리는 두꺼운 문을 통과할 수 없었다.")
			ENDIF
		ELSEIF RESULT == 0
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 저항을 포기하고 이 비정상적인 느낌에 자신을 맡기기로 했다.")
			CALL k1011GPC("W", @"「―――――」", TARGET)
			CALL k1011GP("W", @"처음에는 고통뿐이었지만, 서서히 %조사처리(CALLNAME:MASTER,"는")% 전례 없는 쾌감을 느끼기 시작했다.")
			CALL k1011GPC("W", @"「하, 후우—응, 음—」", TARGET)
			CALL k1011GP("W", @"플란이 몸을 돌리자 거친 숨소리가 목덜미를 타고 흘렀다.")
			CALL k1011GP("W", @"민감해진 %CALLNAME:MASTER%전신이 소녀의 숨결에 흥분하여 떨었다.")
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 떨리는 두 손으로 작은 흡혈귀를 품었다.")
			CALL k1011GP("W", @"프란은 촉촉한 눈으로 %조사처리(CALLNAME:MASTER,"에게")% 더욱 힘을 주어 %조사처리(CALLNAME:MASTER,"를")% 빨아들인다.")
			CALL k1011GPC("W", @"「삐익, 삐익, 삐익——삐익, 삐이이이이이이이이이」", TARGET)
			CALL k1011GP("W", @"막 각성한 어린 악마는 %조사처리(CALLNAME:MASTER,"를")% 데리고 한 번도 느껴본 적 없는 절정으로 향했다...")
			CALL k1011GSleep
			WAIT
			CALL k1011GPC("W", @"「저기…… 고마워요, %k1011Name(TARGET, MASTER)%」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 흡혈 방법을 잘 모르지만... 하지만 아주 잘 해낸 것 같아」", TARGET)
			CALL k1011GPC("W", @"「아마 %k1011Name(TARGET, MASTER)%라서, 분명 %k1011Name(TARGET, MASTER)% 때문이야……」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%의 맛... 정말 맛있어」", TARGET)
			CALL k1011GPC("W", @"「그러니까... 더 빨 수 있나?」", TARGET)
			CALL k1011GWait
			CALL k1011GP("W", @"플란쨩은 특정 성교 활동에서 흡혈한다.")
			K1011AllowVampirism = 1
		ENDIF
		K1011TryVampirism = 1
		CALL k1011AddExp("吸血经验", MASTER)
		;待整理
		;告白失败1
	CASE "1"
		CALL k1011ValentineConfessionFail1
		;惊喜派对
	CASE "惊喜派对"
		CALL k1011SupBirthdayFlan
		;拒绝过生日
	CASE "拒绝过生日"
		CALL k1011NotJoinBirthday
	CASEELSE
		THROW [芙兰口上ERROR]未知的结局预定(K1011TrainEndSc = %K1011TrainEndSc%)
ENDSELECT
RETURN 1
