@k1011DrawApiWarn
#DIM line, 2
#DIM oBgColor
LOADGLOBAL
;不是TEXTRENDERER
IF GETCONFIGS("描画インターフェース") != "TEXTRENDERER"
	;忽略警告
	SIF K1011IgnoreApiWarning
		RETURN
	oBgColor = GETBGCOLOR()
	SETBGCOLOR 0x000000
	line:0 = LINECOUNT
	PRINTFORML 렌더링 API를 TextRenderer로 설정하고 저장한 뒤 emuera를 재시작하지 않으면 레이아웃이 정렬되지 않는 등의 상황이 발생할 수 있습니다.
	PRINTL [0] 경고 무시
	WHILE 1
	INPUT
	CLEARLINE 1
	SELECTCASE RESULT
		CASE 0
			line:1 = LINECOUNT
			PRINTFORML 경고를 무시하시겠습니까?
			PRINTFORML 레이아웃이 깔끔하지 않은 등의 상황이 발생할 수 있습니다.
			PRINT [0] 취소	
			SETCOLOR 0xFF2020
			PRINTL [1] 경고 무시한다
			RESETCOLOR
			WHILE 1
			INPUT
			CLEARLINE 1
			SELECTCASE RESULT
				CASE 0
					CLEARLINE LINECOUNT - line:1
					BREAK
				CASE 1
					K1011IgnoreApiWarning = 1
					CLEARLINE LINECOUNT - line:0
					SAVEGLOBAL
					SETBGCOLOR oBgColor
					RETURN
			ENDSELECT
			WEND
	ENDSELECT
	WEND
	;是TEXTRENDERER
ELSE
	K1011IgnoreApiWarning = 0
	SAVEGLOBAL
ENDIF
;读档ui

@k1011LoadSaveUi
#DIM index
WHILE 1
PRINTL 어떤 저장 파일을 읽을까요?
;常规存档
FOR index, 0, SAVENOS()
IF CHKDATA(COUNT)
	PRINTFORML [{COUNT, 2}] ----
ELSE
	PRINTFORML [{COUNT, 2}] %RESULTS%
ENDIF
NEXT
;自动存档
IF CHKDATA(99)
	PRINTFORML [99] ----
ELSE
	PRINTFORML [99] %RESULTS%
ENDIF
PRINTFORML [100] 돌아가기
INPUT
SELECTCASE RESULT
	CASE 0 TO 19
		SELECTCASE CHKDATA(RESULT)
			CASE 0
				LOADDATA RESULT
			CASE 1
				PRINTL 해당 저장 슬롯에 데이터가 없습니다.
			CASE 2
				PRINTL 해당 저장 파일은 본 게임과 일치하지 않습니다.
			CASE 3
				PRINTL 해당 저장 데이터의 게임 버전은 더 이상 지원되지 않습니다.
			CASE 4
				PRINTL 저장 파일에 다른 문제가 있다.
			CASEELSE
				PRINTL 저장 파일을 불러오는 중 알 수 없는 오류가 발생했다.
		ENDSELECT
	CASE 99
		IF CHKDATA(99)
			PRINTL 자동 저장 파일을 불러오는 데 실패했다.
		ELSE
			LOADDATA 99
		ENDIF
	CASE 100
		BREAK
	CASEELSE
		PRINTL 입력한 값이 유효하지 않습니다
ENDSELECT
WEND
