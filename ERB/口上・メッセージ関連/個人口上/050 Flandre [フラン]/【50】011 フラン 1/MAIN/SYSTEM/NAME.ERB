@k1011CallMasterNameInput()
#DIM line
PRINTL 성함을 입력해 주세요.
PRINT 빠른 입력:
PRINTBUTTON @"[%CALLNAME:MASTER%]", CALLNAME:MASTER
PRINTL 
line = LINECOUNT
WHILE 1
INPUTS
STRLENS RESULTS
IF RESULT > 14
	CALL k1011GPC("L", @"「당신의 이름이 너무 길어서, 푸란은 기억할 수 없어」", TARGET)
	CONTINUE
ELSEIF RESULTS == ""
	CONTINUE
ELSE
	IF RESULTS == "芙兰"
		CALL k1011GPC("L", @"「너도 프랑이라고 해?」", TARGET)
		CALL k1011GPC("L", @"「그건 내 닉네임이야」", TARGET)
	ELSEIF RESULTS == "芙兰朵露"
		CALL k1011GPC("L", @"「오, 그렇구나, 오, 오」", TARGET)
		CALL k1011GPC("L", @"「그것은 나의 이름이다」", TARGET)
	ELSEIF RESULTS == "蕾米莉亚"
		CALL k1011GPC("L", @"「푸흡... 아하하하! 오, 그래? 역시 나를 가두려고 하는 사람들은 다 이 이름이구나」", TARGET)
	ELSEIF RESULTS == "霊梦"
		CALL k1011GPC("L", @"「그렇게 말하자면, 당신의 이름은 사실 마리사 맞죠?」", TARGET)
	ELSEIF RESULTS == "魔理沙"
		CALL k1011GPC("L", @"「아, 솔직하게 대답하는 건 정말 드문 일이네요, 마리사 씨? 저를 여기에 데려온 건 파츄리에게 혼날 거예요.」", TARGET)
	ELSEIF RESULTS == "帕秋莉"
		CALL k1011GPC("L", @"「언제 천식이 나을 거야?」", TARGET)
	ELSEIF RESULTS == "咲夜"
		CALL k1011GPC("L", @"「아, 그럼 케이크 가져와, 플란 배고프잖아」", TARGET)
	ELSEIF RESULTS == "美铃"
		CALL k1011GPC("L", @"「음……이건 하극상인가?」", TARGET)
	ELSEIF RESULTS == "あなた"
		IF k1011GetTalent("相爱")
			CALL k1011GPC("L", @"「당신... %k1011Name(TARGET,TARGET)%가 당신을 좋아해」", TARGET)
		ELSEIF k1011GetTalent("恋慕")
			CALL k1011GPC("L", @"「당신, 당신, 당신……이게 정말인가? %k1011Name(TARGET,TARGET)%은(는) 정말로 당신이라고 불러도 되는 걸까?」", TARGET)
		ELSEIF k1011GetMark("反发刻印") > 1
			CALL k1011GPC("L", @"「만나면 당신과 친하지 않은 여자가 당신을 '당신'이라고 부르게 하세요」", TARGET)
			CALL k1011GPC("L", @"「정말 염치 없구나……」", TARGET)
			CALL k1011GPC("L", @"「%k1011Name(TARGET,TARGET)% 이후에는 네놈을 염치없는 자라고 부르겠다」", TARGET)
		ELSE
			CALL k1011GPC("L", @"「만나면 당신과 친하지 않은 여자가 당신을 '당신'이라고 부르게 하세요」", TARGET)
			CALL k1011GPC("L", @"「정말 염치도 없구나... 설마 당신이라는 것이 단지 당신의 뜻뿐인가?」", TARGET)
			;你先生
			IF k1011GetTalent("性别", MASTER) == 2
				CALL k1011GPC("L", @"「오... 설마 당신이 그 전설 속의 당신이라는 분이었군요」", TARGET)
			ELSE
				CALL k1011GPC("L", @"「오... 네가 바로 전설의 당신 아가씨였구나.」", TARGET)
			ENDIF
		ENDIF
	ELSEIF RESULTS == "你"
		CALL k1011GPC("L", @"「하,\"너\"이 인칭대명사가 언제부터 이름처럼 쓰여도 돼」", TARGET)
		;你先生
		IF k1011GetTalent("性别", MASTER) == 2
			CALL k1011GPC("L", @"「알고 보니 당신이 소문으로만 듣던 그 분이었군요.」", TARGET)
		ELSE
			CALL k1011GPC("L", @"「알고 보니 당신이 전설 속의 그 분이시군요.」", TARGET)
		ENDIF
	ELSE
		CALL k1011GPC("L", @"「%RESULTS%？」", TARGET)
	ENDIF
	CALL k1011GP("SL", @"당신의 이름이 %RESULTS%입니까?")
	CALL k1011GSetQ("Yes", "No")
	CALL k1011GInput()
	IF RESULT == 0
		;你先生特殊处理
		IF RESULTS == "芙兰"
			MASTERNAME = 假芙兰
		ELSEIF RESULTS == "芙兰朵露"
			MASTERNAME = 假芙兰
		ELSEIF RESULTS == "你"
			;你先生
			IF k1011GetTalent("性别", MASTER) == 2
				MASTERNAME = 你先生
			ELSE
				MASTERNAME = 你小姐
			ENDIF
		ELSEIF RESULTS == "あなた"
			IF k1011GetTalent("恋慕")
				MASTERNAME = あなた
			ELSEIF k1011GetMark("反发刻印") > 1
				MASTERNAME = 不要脸
			ELSE
				;你先生
				IF k1011GetTalent("性别", MASTER) == 2
					MASTERNAME = 你先生
				ELSE
					MASTERNAME = 你小姐
				ENDIF
			ENDIF
		ELSE
			MASTERNAME = %RESULTS%
		ENDIF
		CALL k1011GPC("L", @"「그럼 이제부터 당신을 %MASTERNAME%라고 부를게요」", TARGET)
		K1011FlanCallMaster = 8
		BREAK
	ENDIF
ENDIF
CLEARLINE LINECOUNT - line
WEND
RETURN 0
