					CASE 3
						PRINTFORML Lg[10] Maximum
					CASE 4
						PRINTFORML Hu[10] Maximum
				ENDSELECT
			ENDIF
			PRINTFORML \@ (K1011Config:vampirismDie) ? √ # × \@[ 1] MC can die by getting sucked too much
			PRINTFORML \@ (K1011Config:exDaily) ? √ # × \@[ 3] Daily Events
			;日常事件附加设置
			IF K1011Config:exDaily
				; PRINT     
				; PRINTFORML \@ (0) ? √ # × \@[31] 催眠师(未完工)
			ENDIF
			PRINTFORML \@ (K1011Config:combo) ? √ # × \@[ 4] Combo commands
			;PRINTFORML \@ (K1011Config:semenBaby) ? √ # × \@[ 5] 胎儿精液灌溉
			PRINTFORML \@ (K1011Config:semenBaby) ? √ # × \@[ 5] Ejaclulating inside affects baby
			PRINTFORML	[98] Help
			PRINTFORML	[99] Return
			INPUT
			;揉胸
			IF RESULT == 0
				K1011Config:bDev = !K1011Config:bDev
			;胸揉多大
			ELSEIF RESULT == 10
				K1011Config:bDevMax += 1
				SIF K1011Config:bDevMax >= 5
					K1011Config:bDevMax = 0
			;吸血致死
			ELSEIF RESULT == 1
				K1011Config:vampirismDie = !K1011Config:vampirismDie
			;日常事件
			ELSEIF RESULT == 3
				K1011Config:exDaily = !K1011Config:exDaily
			;指令组合
			ELSEIF RESULT == 4
				K1011Config:combo = !K1011Config:combo
			ELSEIF RESULT == 5
				K1011Config:semenBaby = !K1011Config:semenBaby
			;说明
			ELSEIF RESULT == 98
				DRAWLINE
				PRINTL 基本设置说明
				DRAWLINE
				PRINTL [ 0] 胸部揉大
				PRINTL 	启用后芙兰的胸部可以揉大
				PRINTL
				PRINTL [10] 最大能揉多大
				PRINTL 	胸最大能揉多大
				PRINTL 	壁-飞机场  贫-贫乳  普-普通乳  巨-巨乳  爆-爆乳
				PRINTL
				PRINTL [ 1] 吸血致死
				PRINTL 	In non-vampire mode, two consecutive sucks will kill you.
				PRINTL
				PRINTL [ 2] 缠人模式
				PRINTL 	芙兰在早上会缠着你让你、让你直接開始调教
				PRINTL
				PRINTL [ 3] 日常事件
				PRINTL 	会触发口上的日常事件、这是某些事件的前置条件
				PRINTL
				PRINTL [ 4] 指令组合
				PRINTL 	允许将多个指令组合成新指令、如执行过正常位再执行爱抚会组合成正常位爱抚
				PRINTL 	需要和芙兰有比较好的关系才会触发
				PRINTL
				PRINTL [ 5] 胎儿精液灌溉
				PRINTL 	在芙兰怀孕时进行内射会对胎儿产生一定影响(包括日常事件、夜爬事件)
				PRINTL 	胎儿会根据芙兰怀孕时被内射的情况获取精液中毒、欲望、精爱味觉
				PRINTW
			ELSEIF RESULT == 99
				CLEARLINE LINECOUNT - line
				BREAK
			ELSE
			ENDIF
			CLEARLINE LINECOUNT - line
		WEND
	
	;[ 2]显示设置
	@k1011Setting2
		#DIM line
		;删除行数
		line = LINECOUNT
		WHILE 1
			;删除行数
			DRAWLINE
			PRINTL Display Settings
			DRAWLINE
			PRINTFORML \@ (K1011Config:skipAssi) ? √ # × \@[ 0] Skip dialogue on assistant's conditioning
			PRINTFORML \@ (K1011Config:skipBall) ? √ # × \@[ 1] Skip dialogue with ball gag equipped
			PRINTFORML \@ (K1011Config:skipStopTime) ? √ # × \@[ 2] Skip dialogue when time is stopped
			PRINTFORML \@ (K1011Config:skipPassout) ? √ # × \@[ 3] Skip dialogue when you pass out
			PRINTFORML	[98] Help
			PRINTFORML	[99] Return
			INPUT
			IF RESULT == 0
				K1011Config:skipAssi = !K1011Config:skipAssi
			ELSEIF RESULT == 1
				K1011Config:skipBall = !K1011Config:skipBall
			ELSEIF RESULT == 2
				K1011Config:skipStopTime = !K1011Config:skipStopTime
			ELSEIF RESULT == 3
				K1011Config:skipPassout = !K1011Config:skipPassout
			ELSEIF RESULT == 98
				DRAWLINE
				PRINTL 基本设置说明
				DRAWLINE
				PRINTL [ 0]助手调教时跳过口上(tw玩家无视)
				PRINTL 	设计的有问题、没考虑过助手的情况
				PRINTL
				PRINTL [ 1]口球装备时跳过口上
				PRINTL 	看喜好吧、原作者说带口球应该说不出来话
				PRINTL
				PRINTL [ 2]时间停止时跳过口上
				PRINTL 	时间都停止了、应该说不了话
				PRINTL
