				PRINTL 	失神时是否显示口上、分为完全显示、部分显示、和不显示
				PRINTW
			ELSEIF RESULT == 99
				CLEARLINE LINECOUNT - line
				BREAK
			ENDIF
			CLEARLINE LINECOUNT - line
		WEND
	
	;[ 3]机制设置
	@k1011Setting3
		#DIM line
		;设置行数设定
		line = LINECOUNT
		WHILE 1
			DRAWLINE
			PRINTL 显示设置
			DRAWLINE
			PRINTFORML \@ (K1011Config:chastity) ? √ # × \@[ 0] 贞操观念重整
			PRINTFORML \@ (K1011Config:stressWithDesire) ? √ # × \@[ 1] 压力越大欲望越大
			PRINTFORML  [98] Help
			PRINTFORML  [99] Return
			INPUT
			;贞操观念重整
			IF RESULT == 0
				K1011Config:chastity = !K1011Config:chastity
			;压力越大欲望越大
			ELSEIF RESULT == 1
				K1011Config:stressWithDesire = !K1011Config:stressWithDesire
			ELSEIF RESULT == 98
				DRAWLINE
				PRINTL 机制设置说明
				DRAWLINE
				PRINTL [ 0]贞操观念重整
				PRINTL 	调整了下贞操观念,调整后更类似tk里的贞操观念
				PRINTL 	详细内容请看口上说明
				PRINTL
				PRINTL [ 1]压力越大欲望越大(tw玩家无视)
				PRINTL 	有压力时欲情追加会增加
				PRINTL 	详细内容请看口上说明
				PRINTW
			ELSEIF RESULT == 99
				CLEARLINE LINECOUNT - line
				RETURN 0
			ELSE
			ENDIF
			CLEARLINE LINECOUNT - line
		WEND
	
	;[90]更改对你的称呼
	@k1011Setting90
		#DIM line
		;删除行数
		line = LINECOUNT
		WHILE 1
			DRAWLINE
			PRINTFORML Change how %CALLNAME:50% adresses you
			DRAWLINE
			IF k1011GetTalent("恋慕")
				PRINTFORML [ 0] %cALLNAME:50%:%k1011Name(TARGET, MASTER)%
			ELSE
				SETCOLOR 0x656565
				PRINTPLAINFORM [ 0] %cALLNAME:50%:%k1011Name(TARGET, MASTER)%
				PRINTL
				RESETCOLOR
			ENDIF
			PRINTFORML [98] Help
			PRINTFORML [99] Return
			INPUT
			IF RESULT == 0
				IF k1011GetTalent("恋慕")
					CALL k1011SelectCallNameFlan
				ELSE
					PRINTFORML Unable to change without 【%GET_TALENTNAME_TR(3,1,50)%】.
				ENDIF
			ELSEIF RESULT == 98
				DRAWLINE
				PRINTL 更改对你的称呼说明
				DRAWLINE
				PRINTL 只有恋慕(思慕)了才能修改
				PRINTL 只有相爱了才能被称为「达令」
				PRINTW
			ELSEIF RESULT == 99
				CLEARLINE LINECOUNT - line
				BREAK
			ELSE
			ENDIF
			CLEARLINE LINECOUNT - line
		WEND

