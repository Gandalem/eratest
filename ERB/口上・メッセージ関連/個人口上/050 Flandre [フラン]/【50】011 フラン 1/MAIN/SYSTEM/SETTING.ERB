;输入月份

@k1011AskBirthDayMoon
PRINTL 
PRINTFORML 생년월일은 몇 월이죠?
;ym
IF K1011Game == "YM"
	PRINTFORML [ 1] [ 2] [ 3] [ 4]
	PRINTFORML [ 5] [ 6] [ 7] [ 8]
	PRINTFORML [ 9] [10] [11] [12]
	WHILE 1
	INPUT
	IF RESULT >= 1 && RESULT <= 12
		K1011MasterBirthday:0 = RESULT
		RETURN
	ENDIF
	WEND
	;tw
ELSE
	PRINTBUTTON "[봄]", 1
	PRINT  
	PRINTBUTTON "[여름]", 2
	PRINT  
	PRINTBUTTON "[아키]", 3
	PRINT  
	PRINTBUTTON "[겨울]", 4
	PRINTL
	WHILE 1
	INPUT
	IF RESULT >= 1 && RESULT <= 4
		K1011MasterBirthday:0 = RESULT
		RETURN
	ENDIF
	WEND
ENDIF
;输入日期

@k1011AskBirthDayDay
#DIMS moonName = "", "春", "夏", "秋", "冬"
;ym
IF K1011Game == "YM"
	PRINTFORML {K1011MasterBirthday:0} 그날인가요?
	SELECTCASE K1011MasterBirthday:0
		CASE 1,3,5,7,8,10,12
			PRINTFORML [ 1][ 2][ 3][ 4][ 5][ 6][ 7]
			PRINTFORML [ 8][ 9][10][11][12][13][14]
			PRINTFORML [15][16][17][18][19][20][21]
			PRINTFORML [22][23][24][25][26][27][28]
			PRINTFORML [29][30][31]
		CASE 2
			PRINTFORML [ 1][ 2][ 3][ 4][ 5][ 6][ 7]
			PRINTFORML [ 8][ 9][10][11][12][13][14]
			PRINTFORML [15][16][17][18][19][20][21]
			PRINTFORML [22][23][24][25][26][27][28]
			PRINTFORML [29]
		CASE 4,6,9,11
			PRINTFORML [ 1][ 2][ 3][ 4][ 5][ 6][ 7]
			PRINTFORML [ 8][ 9][10][11][12][13][14]
			PRINTFORML [15][16][17][18][19][20][21]
			PRINTFORML [22][23][24][25][26][27][28]
			PRINTFORML [29][30]
	ENDSELECT
	PRINTL [99] 반환
	WHILE 1
	INPUT
	;返回
	SIF RESULT == 99
		RETURN -1
	;异常值处理
	SELECTCASE K1011MasterBirthday:0
		CASE 1,3,5,7,8,10,12
			SIF !(RESULT >= 1 && RESULT <= 31)
				CONTINUE
		CASE 2
			SIF !(RESULT >= 1 && RESULT <= 29)
				CONTINUE
		CASE 4,6,9,11
			SIF !(RESULT >= 1 && RESULT <= 30)
				CONTINUE
	ENDSELECT
	K1011MasterBirthday:1 = RESULT
	CALL k1011AskYn(@"{K1011MasterBirthday:0}월{K1011MasterBirthday:1}이 %조사처리(CALLNAME:MASTER,"의")% 생일입니까?")
	SIF RESULT
		RETURN 0
	WEND
	;tw
ELSE
	PRINTFORML %moonName:(K1011MasterBirthday:0)%의 그날은 언제인가요?
	PRINTFORML [ 1][ 2][ 3][ 4][ 5][ 6][ 7]
	PRINTFORML [ 8][ 9][10][11][12][13][14]
	PRINTFORML [15][16][17][18][19][20][21]
	PRINTFORML [22][23][24][25][26][27][28]
	PRINTFORML [29][30][31]
	PRINTL [99] 반환
	WHILE 1
	INPUT
	;返回
	SIF RESULT == 99
		RETURN -1
	;异常值处理
	SIF !(RESULT >= 1 && RESULT <= 31)
		CONTINUE
	K1011MasterBirthday:1 = RESULT
	CALL k1011AskYn(@"%moonName:(K1011MasterBirthday:0)%의 달이 {K1011MasterBirthday:1}은 %조사처리(CALLNAME:MASTER,"의")% 생일인가?")
	SIF RESULT
		RETURN 0
	WEND
ENDIF
