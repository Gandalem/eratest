; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/SYSTEM/MAGIC/UNKNOWN.ERB
;体力恢复

@k1011UMagic3
#DIM DYNAMIC hp = 100
#DIM index
#DIM loseHp
DEBUGPRINTL 체력 회복이 호출되었다.
FOR index, 0, CHARANUM
loseHp = MAXBASE:index:0 - BASE:index:0
SIF loseHp == 0
	CONTINUE
;有溢出
IF loseHp < hp
	BASE:index:0 += loseHp
	hp -= loseHp
	;回不满
ELSE
	BASE:index:0 += hp
	RETURN 1
ENDIF
NEXT
IF hp == 100
	RETURN 0
ELSE
	RETURN 1
ENDIF
