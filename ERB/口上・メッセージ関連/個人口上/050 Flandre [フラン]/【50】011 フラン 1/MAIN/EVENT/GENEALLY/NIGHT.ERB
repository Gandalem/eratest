; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/NIGHT.ERB
;陪睡事件

@k1011NightEventSleepWithMaster, scuess
#DIM scuess
IF scuess
	IF RAND:2 == 0
		CALL k1011GPC("W", @"「정말? %k1011Name(TARGET, TARGET)%이 옆에서 자도 돼, %k1011Name(TARGET, MASTER)%? 응, 다행이다!」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%내일은 답례로 널 깨워줄게, %k1011Name(TARGET, MASTER)%일단 기대하고 있어, 히히♪」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……헤헤……」", TARGET)
		CALL k1011GPC("W", @"「잘 자!」", TARGET)
	ENDIF
ELSE
	CALL k1011GPC("W", @"「…혼자 기다리고 있으면 이런 기분이 들지」", TARGET)
	CALL k1011GPC("W", @"「......%k1011Name(TARGET, MASTER)%……참 외롭네……」", TARGET)
ENDIF
;相爱事件

@k1011NightEventLove(kind)
#DIM kind
SELECTCASE kind
	;夜宵(h)
	CASE 1
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 잠자리에 들 준비를 하고 있을 때, 푸른이 국 한 그릇을 들고 왔다.")
		CALL k1011GP("W", @"왠지 국이 너무 맛있었는지, %조사처리(CALLNAME:MASTER,"의")% 졸음은 배에서 나는 소리에 순식간에 자리를 내주었다.")
		CALL k1011GP("W", @"두 사람은 그렇게 머리를 맞대고 야식을 다 먹었다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%은 밤간 음식 맛있니?」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 우라라가 보상을 받나요?」", TARGET)
		CALL k1011GPC("W", @"「음, 도도하게 %k1011Name(TARGET, TARGET)%을 보상으로 줄게!♪」", TARGET)
		;夜访(h)
	CASE 2
		CALL k1011GPC("W", @"「아내로서 하는 일이라 남편이 바람피지 않게 막는 것, 물론 색정적인 일을 많이 해줘야겠지♪」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%와 %k1011Name(TARGET, TARGET)%가 준비됐어, 빨리, 빨리 해봐 ♪」", TARGET)
		;陪睡
	CASE 3
		IF RAND:4 == 0
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%과 %k1011Name(TARGET, TARGET)%는 결혼했어…… %k1011Name(TARGET, MASTER)%가 로리를 좋아해서야?」", TARGET)
			CALL k1011GPC("W", @"「히히……헤헤……」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 로리콘이라 정말 좋다♪」", TARGET)
		ELSEIF RAND:3 == 0
			CALL k1011GPC("W", @"「저 %k1011Name(TARGET, MASTER)% 씨, 우리 정말 결혼한 건가요...?」", TARGET)
			CALL k1011GPC("W", @"「왠지, 가끔은... 이유 모를 불안감이 들곤 해...」", TARGET)
			CALL k1011GP("W", @"후라의 불안을 없애기 위해 %조사처리(CALLNAME:MASTER,"는")% 힘껏 후라를 품에 안았다.")
			CALL k1011GPC("W", @"「아……음……우리가, 계속, 계속, 계속, 계속, 함께 있어 주길……♪」", TARGET)
		ELSEIF RAND:2 == 0
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%은 %k1011Name(TARGET, TARGET)%의, %k1011Name(TARGET, MASTER)%은 %k1011Name(TARGET, TARGET)%의 남편♪」", TARGET)
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"의")% 신혼 아내는 얼굴을 붉히며 흥분해서 소리를 지르고 있었다.")
		ELSE
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 우리 모두 부부가 되었으니 매일 음란한 일을 해도 돼 ♪」", TARGET)
			IF k1011GetTalent("怀孕")
				CALL k1011GPC("W", @"「아이 태어난 후에도 %k1011Name(TARGET, TARGET)%는 계속 음란한 아이가 되어야지 ♪」", TARGET)
			ELSE
				IF K1011HavePreg == 1
					CALL k1011GPC("W", @"「야야, 우리 %k1011Name(TARGET, TARGET)%의 배를 더 불릴 만한 일을 좀 더 할까~♪」", TARGET)
					CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%의 아이를 가질 수 있어서 정말 기뻐♪ 하지만 %k1011Name(TARGET, TARGET)%의 아이를 %k1011Name(TARGET, MASTER)%은 하나 더 갖고 싶어」", TARGET)
				ELSE
					CALL k1011GPC("W", @"「부부 두 사람은 아이를 갖는 것 같다. 하지만 어떻게 해야 할까, %k1011Name(TARGET, MASTER)%?」", TARGET)
					CALL k1011GP("W", @"플랑의 천진난만한 얼굴을 보며, %조사처리(CALLNAME:MASTER,"는")% 어떻게 대답해야 할지 몰랐다.")
				ENDIF
			ENDIF
		ENDIF
ENDSELECT
;眠奸MASTER

@k1011NightEventSleepH(kind)
#DIM kind
SELECTCASE kind
	;挿入失败(献处失败)
	CASE 1
		CALL k1011GP("L", @"얼마 전 %조사처리(CALLNAME:MASTER,"가")% 언급했던 섹스의 의미를 생각하며, 플란은 순식간에 얼굴을 붉혔다.")
		CALL k1011GPC("W", @"「보고 싶어, 보고 싶어...... %k1011Name(TARGET, MASTER)%와 합쳐지고 싶어......」", TARGET)
		CALL k1011GP("L", @"잠시 망설인 후, 조용히 깊이 잠든 %조사처리(CALLNAME:MASTER,"에게")% 다가갔다.")
		CALL k1011GP("W", @"배우가 몰래 책에서 본 섹스 자세로, 벌어진 밀구멍으로 %조사처리(CALLNAME:MASTER,"의")% 것을 삼킬 준비를 한다.")
		CALL k1011GP("W", @"하지만 경험이 없었는지, 성기가 벌어진 구멍에서 미끄러지더니 빠져나왔다.")
		CALL k1011GPC("W", @"「……아, 나 방금 뭐 하려 했지?」", TARGET)
		CALL k1011GPC("W", @"「너무 무서워, %k1011Name(TARGET, MASTER)%……」", TARGET)
		;逆强奸
	CASE 2
		CALL k1011GPC("W", @"「오……%k1011Name(TARGET, MASTER)%의 성기가 감당 못 하겠어……」", TARGET)
		CALL k1011GPC("W", @"「어이, 한 번 찔러봐, %k1011Name(TARGET, TARGET)%의 작은 구멍에…… %k1011Name(TARGET, MASTER)%의 자지는 아직 더 할 수 있을 것 같네♪」", TARGET)
		;口交
	CASE 3
		CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%의 성기라니... 이럴 때 이렇게 귀엽다니」", TARGET)
		CALL k1011GPC("W", @"「……그, 그냥 입으로 하는 게 좋겠어….♪」", TARGET)
		CALL k1011GPC("W", @"「%k1011Sound("Mouth", "啾、啾、哼……久、啾、啾。")%」", TARGET)
		CALL k1011GPC("W", @"「%k1011Sound("MouthShout", "嗯、嗯、嗯……!……喂!")%」", TARGET)
		;手淫
	CASE 4
		;消極的
		IF RAND:2 == 0
			CALL k1011GPC("W", @"「아...... 음...... %k1011Name(TARGET, MASTER)%의 손이 프란보다 훨씬 크다......」", TARGET)
			;積極的
		ELSE
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%의 손이 푸란의 속옷 안을 만졌다……」", TARGET)
			CALL k1011GPC("W", @"「음? %k1011Name(TARGET, MASTER)% ……」", TARGET)
		ENDIF
		;貞操帯
	CASE 5
		CALL k1011GPC("L", @"「음, 만약 %k1011Name(TARGET, MASTER)%가 깨어나 후란이 아직 정조대 차고 있는 것을 발견한다면」", TARGET)
		CALL k1011GPC("W", @"「반드시 %k1011Name(TARGET, TARGET)%에게 후하게 보상할 거야」", TARGET)
ENDSELECT
;两人h

@k1011NightEventH(kind)
#DIM kind
SELECTCASE kind
	;消极。但主人要求
	CASE 1
		CALL k1011GPC("W", @"「안 돼! 안 돼!」", TARGET)
		CALL k1011GPC("W", @"「음란한 일은... 지금 플란은 하고 싶지 않아!」", TARGET)
		;消极
	CASE 2
		CALL k1011GPC("W", @"「저기, 저기...」", TARGET)
		CALL k1011GPC("W", @"「……음, 하자」", TARGET)
		;积极
	CASE 3
		CALL k1011GPC("W", @"「어이, 우리 야한 거 해보자~ ~」", TARGET)
		CALL k1011GPC("W", @"「그렇지 않으면, 오늘은 잠을 잘 수 없을 거야~」", TARGET)
		;献处
	CASE 4
		CALL k1011GPC("W", @"「흐윽, 흐읍…… 아, %k1011Name(TARGET, MASTER)%……」", TARGET)
		CALL k1011GPC("W", @"「지금까지 %k1011Name(TARGET, TARGET)%은 계속 %k1011Name(TARGET, MASTER)%와의 관계를 한 단계 더 진전시키고 싶었어……」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%, 드디어 %k1011Name(TARGET, MASTER)%와 하나가 됐어…… 응, 작은 구멍이 자지를 삼켰어…♪」", TARGET)
		CALL k1011GPC("W", @"「육봉, 좋아, 뜨겁네!」", TARGET)
		CALL k1011GP("W", @"플란이 강인한 미소를 짓는 것을 본 %조사처리(CALLNAME:MASTER,"는")% 처녀의 가치를 경험하는 것을 잊고 플란을 침범하기 시작했다.")
		CALL k1011GPC("W", @"「아! 아! 아! 너무 아파, 너무 아파, 하지만 %k1011Name(TARGET, TARGET)%는 기뻐!」", TARGET)
		CALL k1011GPC("W", @"「아, 육봉, 응, 엄청 크네... 뜨거워, 이걸 %k1011Name(TARGET, TARGET)% 몸 안에 박아버리자!♪」", TARGET)
ENDSELECT
;5p

@k1011NightEvent5P(kind)
#DIM kind
IF kind == 0
	IF RAND:2 == 0
		CALL k1011GPC("W", @"후란 「히히... %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GPC("W", @"푸란은 「모두 함께 사람을 행복하게 하는 일을 하자♪」라고 말했다.", TARGET)
	ELSE
		CALL k1011GPC("W", @"플랑「%k1011Name(TARGET, MASTER)%는 %k1011Name(TARGET, TARGET)%를 모두 앞에서 즐겁게 해주고 싶어?」", TARGET)
		CALL k1011GPC("W", @"후란 「다 같이 즐기는 게 좋지 않을까?」", TARGET)
		CALL k1011GPC("W", @"후란 「헤헤, %k1011Name(TARGET, MASTER)%는 마음대로 가지고 놀아도 좋아♪」", TARGET)
		CALL k1011GPC("W", @"프랑「%k1011Name(TARGET, TARGET)%도 모두도, %k1011Name(TARGET, MASTER)%의 것이니까♪」", TARGET)
	ENDIF
ELSE
	CALL k1011GPC("W", @"플랑「있잖아…%k1011Name(TARGET, MASTER)%♥는 %k1011Name(TARGET, TARGET)%랑 잔뜩잔뜩 할 거야…♪」", TARGET)
ENDIF
;看到猪脚和其他人h

@k1011NightEventSeeMasterHOther(kind)
#DIM kind
;自慰
IF kind == 1
	;恋慕时会嫉妒
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("W", @"「있잖아, %k1011Name(TARGET, TARGET)%랑 같이 놀자, %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GPC("W", @"「봐, %k1011Name(TARGET, TARGET)%의 보지가 벌써 젖었어…… %k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)% 이제 원해……」", TARGET)
		CALL k1011GPC("W", @"「가슴도 부드럽네……히히, 응…… 마음대로 가지고 놀아도 돼…… %k1011Name(TARGET, MASTER)%. 」", TARGET)
		;除此之外
	ELSE
		CALL k1011GPC("W", @"「작은 구멍에서 많은 '바닥바닥' 소리가 나지…… 이렇게 만지니……」", TARGET)
		CALL k1011GPC("W", @"「……어라? 왜 %k1011Name(TARGET, TARGET)%의 구멍이 이렇게 젖어버렸지…… 아, 오, 오……」", TARGET)
	ENDIF
ENDIF
