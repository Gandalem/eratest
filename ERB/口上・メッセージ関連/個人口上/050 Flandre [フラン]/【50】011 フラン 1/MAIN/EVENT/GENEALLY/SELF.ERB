			CALL k1011GPC("W", @"「음... 역시 혼자 있는 게 제일 편하네...」", TARGET)
			CALL k1011GPC("W", @"「음……오늘은 두 번 정도 해보자♪」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「와……다시 한 번 해보자……♪」", TARGET)
			CALL k1011GP("W", @"후란은 한 사람의 공간에서 능숙하게 자위를 했다.")
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 왜 이렇게 일찍 온 거야……」", TARGET)
