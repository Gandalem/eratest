; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/SEMEN_LOVE.ERB
;--------------------------------------------------
;[精爱味觉]取得
;--------------------------------------------------

@k1011GetSemenLove
;恋慕
IF k1011GetTalent("恋慕") || k1011GetTalent("淫乱")
	IF K1011Game == "YM"
		CALL k1011GP("L", @"분명 조교는 끝났지만, 플란은 %조사처리(CALLNAME:MASTER,"를")% 놓아줄 생각이 전혀 없었고, 작은 날개를 파닥이며 %조사처리(CALLNAME:MASTER,"에게")% 달려들었다.")
	ELSE
		CALL k1011GP("L", @"분명 잠자리에 들 시간인데, 플란은 %조사처리(CALLNAME:MASTER,"를")% 놓아줄 생각이 전혀 없었고 작은 날개를 파닥이며 %조사처리(CALLNAME:MASTER,"에게")% 달려들었다.")
	ENDIF
	CALL k1011GP("W", @"그러더니 새하얀 작은 손으로 %조사처리(CALLNAME:MASTER,"의")% 가랑이 밑에서 발기한 것을 꺼내 욕정으로 물든 뺨에 붙였다.")
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("L", @"「왠지 모르겠지만, 오늘은 %k1011Name(TARGET, TARGET)%도 %k1011Name(TARGET, MASTER)%의 특제 우유를 또 마시고 싶어…… 분명 괜찮겠지?」", TARGET)
	ELSE
		CALL k1011GPC("L", @"「봐, 성기는 아직 발기되어 있고, 분명 사정하고 싶겠지? 문제없어. %k1011Name(TARGET, TARGET)%가 만족시켜 줄 테니까.」", TARGET)
	ENDIF
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 대답하기도 전에, 두 눈을 반짝이는 소녀가 %조사처리(CALLNAME:MASTER,"의")% 것을 입속으로 밀어 넣었다.")
	CALL k1011GP("W", @"능숙한 작은 혀가 뜨거운 성기를 끊임없이 쓰다듬고, 귀두 부분을 핥을 때마다 방금 분비된 선액을 쓸어 담는다.")
	CALL k1011GP("W", @"동시에 작은 손도 가만히 있지 않고, %조사처리(CALLNAME:MASTER,"의")% 성기를 반복해서 비비며 그 안에 숨겨진 액체까지 짜내려는 듯했다.")
	CALL k1011GP("W", @"어쩌면 핥는 게 너무 즐거워서일지도, 작은 날개가 파르륵 흔들리고 있었다.")
	PRINTL
	CALL k1011GP("W", @"후란의 끊임없는 노력 아래, %조사처리(CALLNAME:MASTER,"의")% 깊은 곳에서 참기 힘든 쾌감이 전해져 왔고, 성기는 한 바퀴 부풀어 올랐다.")
	CALL k1011GP("W", @"후란은 무언가를 이해한 듯, %조사처리(CALLNAME:MASTER,"의")% 몸을 꼭 안고 단단한 성기를 좁은 목구멍 깊숙이 밀어 넣었다.")
	CALL k1011GPC("W", @"「%k1011Sound("MouthShout", "唔唔唔、")% 정액이 나왔어……」", TARGET)
	CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 견딜 수 없는 쾌감이 정액을 통해 플란에게 전달되었다.")
	CALL k1011GP("W", @"소녀의 몸이 통제 불능으로 뒤로 젖혀지고, 눈동자가 하얗게 변하며, 사타구니에서도 음액이 터져 나왔다.")
	CALL k1011GP("W", @"부풀어 오른 육봉도 그 결과 소녀의 입에서 미끄러져 나오고, 분출된 정액이 플란의 얼굴에 뿌려져 귀여운 뺨을 크림 케이크처럼 물들였다.")
	CALL k1011GPC("L", @"「음~ 그저 %k1011Name(TARGET, MASTER)%에게 구강성애를 해주던 건데, 어째서 갑자기 절정에 다다르고 정액을 많이 낭비해버렸지……」", TARGET)
	CALL k1011GP("W", @"후란은 하얀 작은 손으로 얼굴의 정액을 닦아내며, 손에 묻은 정액을 빨면서 불평했다.")
	PRINTL
	IF k1011GetTalent("恋慕")
		CALL k1011GP("W", @"정당하게 %조사처리(CALLNAME:MASTER,"는")% 일이 끝나면 떠날 수 있다고 생각했는데, 플란이 갑자기 미간을 찌푸리며 작은 입술을 내밀고 중얼거렸다.")
		CALL k1011GPC("W", @"「다 괴물 %k1011Name(TARGET, MASTER)%는 좋지 않아, 플란을 절정에 이르게 하고 많은 정액을 낭비했어……」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 다시 한 번 사정해야 갈 수 있어, 아키...」", TARGET)
		;喜欢芙兰
		IF k1011Love()
			CALL k1011GP("W", @"소녀는 말하면서 %조사처리(CALLNAME:MASTER,"의")% 것을 멋대로 입에 넣었다...")
			CALL k1011AddExp("饮精绝顶经验", 2)
			CALL k1011AddExp("口交经验", 2)
			CALL k1011AddExp("精液经验", 2)
			CALL k1011AddExp("射精经验", 2, MASTER)
			WAIT
			;不喜欢
		ELSE
			CALL k1011GP("W", @"소녀는 말하면서 멋대로 %조사처리(CALLNAME:MASTER,"의")% 것을 입에 밀어 넣었다.")
			CALL k1011GP("L", @"하지만 지금으로 볼 때, 플란의 입은 이미 완전히 개발되었으니 더 이상 경험을 낭비할 필요가 없다.")
			CALL k1011GP("W", @"그런 생각을 품고, %조사처리(CALLNAME:MASTER,"는")% 플랜에게 놓으라고 명령했다.")
			IF k1011GetTalent("服从")
				CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"의")% 말을 들은 소녀는 처음에는 멍해졌지만, 곧 머릿속에 %조사처리(CALLNAME:MASTER,"의")% 명령이 절대적인 목소리로 울렸다.")
				CALL k1011GP("W", @"소녀는 입안의 성기를 놓아주었다.")
			ELSE
				CALL k1011GPC("W", @"「하지만 플란은 생각했다...」", TARGET)
				CALL k1011GP("L", @"아직 소녀가 말을 마치기도 전에 %조사처리(CALLNAME:MASTER,"는")% 플란에게 한 대를 때리고, 이내 소녀의 입에서 성기를 빼낸 뒤 돌아서서 떠났다.")
				CALL k1011GP("W", @"소녀는 뜨겁게 달아오른 뺨을 부드럽게 쓸어내리며 %조사처리(CALLNAME:MASTER,"의")% 멀어져 가는 뒷모습을 바라보고 있었고, 어느새 손에 물방울이 떨어지고 있었다……")
			ENDIF
			CALL k1011AddExp("饮精绝顶经验", 1)
			CALL k1011AddExp("口交经验", 1)
			CALL k1011AddExp("精液经验", 1)
			CALL k1011AddExp("射精经验", 1, MASTER)
			WAIT
		ENDIF
	ELSE
		CALL k1011GP("W", @"정당하게 %조사처리(CALLNAME:MASTER,"가")% 일어나서 가려 할 때, 플란이 갑자기 성기를 붙잡았다.")
		CALL k1011GPC("W", @"「우리 한 번 더 하자? 방금 정액이 많이 흘렀잖아... 플란은 제대로 마시지도 못했으니까...」", TARGET)
		;喜欢
		IF k1011Love()
			CALL k1011GP("W", @"어쩔 수 없는 %조사처리(CALLNAME:MASTER,"는")% 다시 자신의 것을 플란의 입속에 밀어 넣었다.")
			CALL k1011AddExp("饮精绝顶经验", 2)
			CALL k1011AddExp("口交经验", 2)
			CALL k1011AddExp("精液经验", 2)
			CALL k1011AddExp("射精经验", 2, MASTER)
			WAIT
			;不喜欢
		ELSE
			CALL k1011GP("W", @"플란의 입이 이미 완전히 개발된 것 같으니, 더 위로 힘을 쓸 필요가 없을 것 같다.")
			CALL k1011GP("W", @"그런 생각을 한 %조사처리(CALLNAME:MASTER,"는")% 플란의 작은 손을 뿌리치고 돌아 떠났다.")
			CALL k1011AddExp("饮精绝顶经验", 1)
			CALL k1011AddExp("口交经验", 1)
			CALL k1011AddExp("精液经验", 1)
			CALL k1011AddExp("射精经验", 1, MASTER)
			WAIT
		ENDIF
	ENDIF
	;反发
ELSEIF k1011GetMark("反发刻印") > 1
	CALL k1011GP("W", @"입안에 남아있는 정액 냄새를 맡고, 플란은 참지 못하고 핥았다.")
	CALL k1011GP("W", @"하지만 정액이 목을 통과할 때, 알 수 없는 쾌감이 번개처럼 소녀의 척추를 타고 스쳐 지나갔고 하체는 자제하지 못하고 흰 액체를 분출했다.")
	IF K1011Game == "YM"
		CALL k1011GP("W", @"소녀는 경악하며 자신의 몸을 바라본 뒤, %CALLNAME:MASTER%쪽으로 살인적인 시선을 던졌다.")
		;喜欢
		IF k1011Love()
			CALL k1011GP("L", @"무슨 말을 해야 할지 모르는 %조사처리(CALLNAME:MASTER,"가")% 고개를 돌려 떠났다.")
			CALL k1011GP("W", @"어쩌면 후난과의 관계를 개선한 후에 이런 이상한 일들을 하는 게 나을지도 모른다.")
			;不喜欢
		ELSE
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 오히려 만족스럽게 고개를 끄덕였다. 프랑의 입이 완전히 개방된 모양이다.")
		ENDIF
	ENDIF
	CALL k1011AddExp("饮精绝顶经验", 1)
	CALL k1011AddExp("口交经验", 1)
	CALL k1011AddExp("精液经验", 1)
	CALL k1011AddExp("射精经验", 1, MASTER)
	WAIT
	;非恋慕
ELSE
	CALL k1011GP("W", @"입안에 남아있는 정액 냄새를 맡고, 플란은 참지 못하고 핥았다.")
	CALL k1011GP("W", @"하지만 정액이 목을 통과할 때, 알 수 없는 쾌감이 번개처럼 소녀의 척추를 타고 스쳐 지나갔고 하체는 자제하지 못하고 흰 액체를 분출했다.")
	CALL k1011GPC("L", @"「아, 아무것도 안 했는데 왜 가버린 거지... 이상해...」", TARGET)
	;不喜欢
	SIF !k1011Love() && K1011Game == "YM"
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 만족스러운 듯 고개를 끄덕였다. 후란의 입이 완전히 개화한 모양이다.")
	CALL k1011AddExp("饮精绝顶经验", 1)
	CALL k1011AddExp("口交经验", 1)
	CALL k1011AddExp("精液经验", 1)
	CALL k1011AddExp("射精经验", 1, MASTER)
	WAIT
ENDIF
