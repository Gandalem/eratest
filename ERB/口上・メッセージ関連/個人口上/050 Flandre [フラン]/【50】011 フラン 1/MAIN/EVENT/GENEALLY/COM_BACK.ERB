; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/COM_BACK.ERB
;ADDCHARA与DELCHARA相关的
;购买

@k1011BeBought
;战斗中に捕らえられた
IF TFLAG:99
	;CALL k1011GP("W", @"")
ELSE
	CALL k1011GP("W", @"플란도르라는 소녀가 수면 상태로 가르침(調教)을 받은 후 전적으로 소환되었다.")
	CALL k1011GPC("W", @"「……흡! 흡!……흡! 흡!」", TARGET)
	CALL k1011GP("W", @"안아보았더니 가볍다는 것이 무서울 정도였다. 평온한 수면 속에서 숨을 쉬는 동안, 작은 가슴이 위아래로 오르내렸다.")
	CALL k1011GP("W", @"대가(大師)가 공들여 조각한 인형처럼 외모가 매우 귀하다…….")
	CALL k1011GP("W", @"이 능력은 출처를 알 수 없는, 매우 신비한 능력이니 그 점에 유의해야 한다.")
	CALL k1011GP("W", @"뭐, 하지만 여기서는 모든 능력을 사용할 수 없어서 그녀는 그저 순수한 소녀로서 존재할 수밖에 없다.")
	CALL k1011GP("W", @"그녀를 끝없는 성적인 즐거움에 몰입시킨다면, 남성을 완전히 착취하는 마성의 소녀로 키울 수 있을 것이다.")
	CALL k1011GP("W", @"아니면 점차적으로 색정적인 것을 좋아하게 되는 걸 그녀에게 가르쳐주는 건가...")
	CALL k1011GPC("W", @"「……――」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 자신만의 색을 입은 플란트르의 미래가 어떨지 상상하며 소녀를 방으로 데려갔다.")
ENDIF
;被其他人带回来的时候

@k1011BeCaught
CALL k1011GP("W", @"가방 안에는 금발에 눈처럼 하얀 피부를 가진, 인형처럼 귀여운 소녀가 들어 있었다.")
CALL k1011GPC("W", @"「……흡! 흡!……흡! 흡!」", TARGET)
CALL k1011GP("W", @"평온하게 숨을 쉬며, 잠이 아주 깊게 잔 듯했다.")
CALL k1011GPC("W", @"「음, 아…… 음…… 곰돌아…… 오늘 뭐 하고 놀까……」", TARGET)
;解放回来时带人

@k1011CatchOther
CALL k1011GPC("W", @"「자 %k1011Name(TARGET, MASTER)%, 어서 봐, 어서 봐……」", TARGET)
CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%대단하지…… 얼른 %k1011Name(TARGET, TARGET)%에게 상을 줘, %k1011Name(TARGET, TARGET)%에게 상을 줘♪」", TARGET)
CALL k1011GP("L", @"머리 위에서 부드러운 손길을 느끼자, 플란은 만족스러운 미소를 지었다.")
IF k1011GetTalent("淫乱")
	CALL k1011GP("L", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 이렇게 하는 것이 괜찮은지 물었을 때, 고개를 돌리고 입술을 삐죽 내밀며 중얼거렸다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%플랑을 기분 좋게 해줄 보상 없이는, %k1011Name(TARGET, TARGET)%말 안 할 거야……」", TARGET)
ELSE
	CALL k1011GP("L", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 이렇게 하는 것이 좋지 않을 수도 있는지 물었을 때, 당연하게 %조사처리(CALLNAME:MASTER,"에게")% 알려주었다.")
	CALL k1011GPC("W", @"「어차피 %k1011Name(TARGET, MASTER)%의 가르침을 받다 보면 야한 일을 좋아하게 될 테니까♪ 그 뒤에는 그 애도 %k1011Name(TARGET, TARGET)%에게 감사할 거야」", TARGET)
ENDIF
;带钱回来

@k1011BackWithMoney
CALL k1011GPC("W", @"「자 %k1011Name(TARGET, MASTER)%, 어서 봐, 어서 봐……」", TARGET)
CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)% 대단하지…… 얼른 %k1011Name(TARGET, TARGET)%에게 상을 줘, %k1011Name(TARGET, TARGET)%에게 상을 줘♪」", TARGET)
CALL k1011GP("L", @"머리 위에서 부드러운 손길을 느끼자, 플란은 만족스러운 미소를 지었다.")
IF k1011GetTalent("淫乱")
	CALL k1011GP("L", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 이 돈이 어떻게 생겼냐고 물었을 때, 고개를 돌리고 입술을 삐죽 내밀며 중얼거렸다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%가 %k1011Name(TARGET, TARGET)%를 기분 좋게 해 주는 보상 없이는, %k1011Name(TARGET, TARGET)%는 말하지 않을 거야……」", TARGET)
ELSE
	CALL k1011GP("L", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 그 돈이 어떻게 생겼는지 묻자, 후란은 얼굴을 들고 의기양양하게 %조사처리(CALLNAME:MASTER,"에게")% 자랑했다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%예전에 지하실에 살았는데, 바로 옆에 홍마관의 토지문서가 놓여 있길래, %k1011Name(TARGET, TARGET)%그걸 팔았어」", TARGET)
ENDIF
;好感仅回来,获得把柄

@k1011BackWithTalent
CALL k1011GP("W", @"플란을 보내고 숨 돌릴 틈도 없이 %조사처리(CALLNAME:MASTER,"는")% 「쿵쿵쿵」하는 노크 소리를 들었다.")
CALL k1011GP("L", @"문이 살짝 열리자 금발의 어린 소녀가 %조사처리(CALLNAME:MASTER,"를")% 덮쳤다.")
CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%돌아왔어, %k1011Name(TARGET, MASTER)%♪」", TARGET)
CALL k1011GP("L", @"그 소녀는 %조사처리(CALLNAME:MASTER,"가")% 왜 집에 가지 않느냐고 묻기 시작하자마자 즉시 선언했다.")
CALL k1011GPC("W", @"「여기가 %k1011Name(TARGET, TARGET)%의 집이야, %k1011Name(TARGET, TARGET)%는 아무 데도 안 가!」", TARGET)
CALL k1011GPC("L", @"「홍마관에 대해서는 말이지...」", TARGET)
CALL k1011GPC("W", @"「그것이 %k1011Name(TARGET, TARGET)%를 가두는 감옥이야!」", TARGET)
CALL k1011GP("L", @"소녀는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 보자 약간 흔들리며, 살짝 팔을 붙잡고, 작은 볼로 그 위를 비비면서 가엾은 목소리로 애원했다.")
CALL k1011GPC("W", @"「……%k1011Name(TARGET, TARGET)%를 쫓아내지 않으면 안 돼……%k1011Name(TARGET, TARGET)%는 그 차가운 지하실로 다시 돌아가고 싶지 않아……%k1011Name(TARGET, TARGET)%는 앞으로 절대 말썽 안 부릴게……」", TARGET)
CALL k1011GP("W", @"결론적으로, 곁에서 지저귀는 작은 새들의 간청에 %조사처리(CALLNAME:MASTER,"는")% 플란이 여기에 머무르는 것을 허락했다.")
