; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/RELATION.ERB
;使魔

@k1011Servant
IF !K1011EventFirst:使魔
	CALL k1011GPC("W", @"「사마?」", TARGET)
	CALL k1011GPC("W", @"「그렇게 %k1011Name(TARGET, TARGET)%을 만들고 싶은 거야? 파츄리 옆에 있는 작은 악마처럼 말이야?」", TARGET)
	;天真
	IF K1011Character == 1
		CALL k1011GPC("W", @"「만약 %k1011Name(TARGET, MASTER)%에게 도움이 될 수 있다면, 당연히 할 수 있다」", TARGET)
		CALL k1011GPC("W", @"「하지만 %k1011Name(TARGET, TARGET)%은 어떻게 해야 할지 모르겠어……」", TARGET)
		;早熟
	ELSEIF K1011Character == 2
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%의 요구라면 말이지」", TARGET)
		CALL k1011GPC("W", @"「괜찮아♪」", TARGET)
	ENDIF
	K1011EventFirst:使魔 = 1
ELSE
	CALL k1011GPC("W", @"「또 %k1011Name(TARGET, TARGET)%를 사용하게 되었네」", TARGET)
	CALL k1011GPC("W", @"「정말 기뻐…… 이렇게 %k1011Name(TARGET, TARGET)%하면 %k1011Name(TARGET, MASTER)%를 더 잘 느낄 수 있어」", TARGET)
ENDIF
;烙印

@k1011Brand
CALL k1011GPC("W", @"「아, 음... 이것은 %k1011Name(TARGET, MASTER)%의 인각이다」", TARGET)
CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%평생 %k1011Name(TARGET, MASTER)%의 것이야…」", TARGET)
CALL k1011GP("W", @"이어서 프란은 순순히 서약을 말했다.")
CALL k1011GP("W", @"그러고는, 나는 작은 소리로 중얼거렸다.")
CALL k1011GPC("W", @"「그러니까, 계속 함께 있어야 해... %k1011Name(TARGET, MASTER)%」", TARGET)
;赤色项圈

@k1011Necklace
CALL k1011GPC("W", @"「이거, %k1011Name(TARGET, TARGET)%에게 줄 거야? 와, 이름이 새겨져 있네...」", TARGET)
CALL k1011GP("W", @"프랑은 기분 좋게 목걸이의 감촉을 만졌다.")
CALL k1011GPC("W", @"「아름다운 붉은색... 정말 예쁘네...」", TARGET)
CALL k1011GP("W", @"후란에게서 느껴지는 고귀한 붉은색이 마치 %조사처리(CALLNAME:MASTER,"가")% 굴복을 한 듯했다.")
CALL k1011GP("W", @"역시 빨간색과 후란은 잘 어울린다.")
CALL k1011GPC("W", @"「고마워요, %k1011Name(TARGET, MASTER)%…♪」", TARGET)
