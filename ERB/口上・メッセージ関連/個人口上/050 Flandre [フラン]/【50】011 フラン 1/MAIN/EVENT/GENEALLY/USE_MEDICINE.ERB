; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/USE_MEDICINE.ERB
;营養剂

@k1011Nutrient()
;初次
IF (K1011MedicineFirst:营养剂) == 0
	CALL k1011GPC("L", @"「물론 약을 사용할 수도 있어」", TARGET)
	CALL k1011GPC("W", @"「하지만 하루 자고 나면 원래대로 돌아오는 거 아냐?」", TARGET)
	K1011MedicineFirst:营养剂 = 1
	;二次
ELSE
	;恋慕+体力500未満
	IF k1011GetTalent("恋慕") && k1011GetBase("体力") < 500
		CALL k1011GPC("L", @"「아... %k1011Name(TARGET, MASTER)%랑 많은 걸 해서 흔들리는 거야.」", TARGET)
		CALL k1011GPC("W", @"「약을 마셨더니... 금방 %k1011Name(TARGET, MASTER)%와 색을 볼 수 있게 되었어♪」", TARGET)
		;恋慕
	ELSEIF k1011GetTalent("恋慕")
		CALL k1011GPC("L", @"「음... 곧 괜찮아질 거야.」", TARGET)
		CALL k1011GPC("W", @"「우리는 더 많은 색정적인 일을 할 수 있어, %k1011Name(TARGET, MASTER)%♪」", TARGET)
		;除此之外
	ELSE
		CALL k1011GPC("L", @"「아, 좋아졌어...」", TARGET)
		CALL k1011GPC("W", @"「아직 야한 거 충분히 안 했잖아? 내일 얘기하자」", TARGET)
	ENDIF
ENDIF
;扶她药

@k1011FutaMedicine(mod)
#DIM mod
;消去時
IF mod == 1
	IF K1011Character == 1
		CALL k1011GPC("W", @"「아, %k1011Name(TARGET, TARGET)%의 거시기(성기)는 어떻게 사라진 거지?」", TARGET)
		CALL k1011GPC("W", @"「……하지만, 남성기가 없어도 괜찮아……♪」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「아, 성기가 사라졌다」", TARGET)
		CALL k1011GPC("W", @"「음핵이 갑자기 커지는 건 정말 힘들고 괴롭다」", TARGET)
		CALL k1011GPC("W", @"「하지만 %k1011Name(TARGET, MASTER)%를 기쁘게 해줄 수 있다면 좋겠어♪」", TARGET)
	ENDIF
	CALL k1011SetTalent("持久", 0)
	;付加時
ELSEIF mod == 0
	;初次
	IF K1011MedicineFirst:扶她药 == 0
		CALL k1011GPC("W", @"「응? 뭐야?」", TARGET)
		CALL k1011GP("W", @"후루... 후루...")
		CALL k1011GPC("W", @"「야! 프랑의 작은 클리가 점점 커지고 있어!!」", TARGET)
		CALL k1011GP("W", @"- - -")
		IF K1011Character == 1
			CALL k1011GP("W", @"플란은 얼굴이 새빨개진 채 사타구니에서 솟아오른 성기를 응시했다.")
			CALL k1011GPC("W", @"「싫어……이렇게 창피해……」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「봐, %k1011Name(TARGET, TARGET)%도 거시기 생겼어♪」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%이 남자애가 됐어?」", TARGET)
			CALL k1011GPC("W", @"「아하하, 봐, 손으로 한 번 문지르니 커졌어, 정말 이상해——」", TARGET)
		ENDIF
		K1011MedicineFirst:扶她药 = 1
		;二次
	ELSE
		;恋慕
		IF K1011Character == 1
			CALL k1011GPC("W", @"「아, %k1011Name(TARGET, TARGET)%의 클리가 또…… 커졌네……」", TARGET)
			CALL k1011GPC("W", @"「또 거시기(?)가 나왔네...♪」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「어라? 어째서 %k1011Name(TARGET, TARGET)% 회장님에게 거시기(meat rod)가 생겼지?」", TARGET)
			CALL k1011GPC("W", @"「아, 또 왔어? 작은 클리가 갑자기 커져서 피곤해지는 것…….」", TARGET)
		ENDIF
	ENDIF
	CALL k1011GetFutaNormally
ENDIF
;豊胸剂

@k1011BreastUp()
;初次
IF K1011MedicineFirst:丰胸 == 0
	;恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("L", @"「와, %k1011Name(TARGET, TARGET)%의 가슴이 커졌어…?」", TARGET)
		CALL k1011GP("W", @"처음에는 플란이 당황했지만, 이것이 현실임을 알게 되자 금세 들떠버렸다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%아, 만져봐 봐! 진짜지?」", TARGET)
		;除此之外
	ELSE
		CALL k1011GPC("L", @"「어라... 이거 %k1011Name(TARGET, TARGET)%의 가슴인가?」", TARGET)
		CALL k1011GPC("W", @"「아, 빨리 저 녀석이랑 비교해 보고 싶다♪」", TARGET)
	ENDIF
	K1011MedicineFirst:丰胸 = 1
	;二次
ELSE
	SELECTCASE k1011GetTalent("胸部")
		;巨乳→爆乳
		CASE 3
			CALL k1011GPC("L", @"「음……가슴이 무겁네……」", TARGET)
			CALL k1011GPC("W", @"「어깨가 뻐근한 건 이래... 미즈루가 말했어.」", TARGET)
			;普通→巨乳
		CASE 2
			CALL k1011GPC("W", @"「로리 거유? 무슨 일이야?」", TARGET)
			CALL k1011GPC("W", @"「됐어, %k1011Name(TARGET, MASTER)% 빨리 와서 봐, 가슴이 아주 재미있어♪」", TARGET)
			CALL k1011GP("W", @"플란은 천진난만하게 풍만한 가슴을 가지고 놀았다.")
			CALL k1011GPC("W", @"프랑이의 인형 같은 얼굴과 거유가 손안에서 「푸푸」 소리를 내며 변하는 모습은 정말 혈관을 팽창시킬 듯한 광경이었다.", TARGET)
			;贫乳→普通
		CASE 1
			CALL k1011GP("L", @"후란은 손가락으로 커져가는 가슴을 누르고 있다.")
			CALL k1011GPC("W", @"「아... 오호, 가슴이 참 부드럽네」", TARGET)
			;飞机场→贫乳
		CASE 0
			CALL k1011GPC("L", @"「아... 원래대로 돌아왔네」", TARGET)
			CALL k1011GPC("W", @"「헤에... 이게 후란 본래의 가슴이구나...」", TARGET)
	ENDSELECT
ENDIF
;缩胸剂

@k1011BreastDown()
;初次
IF K1011MedicineFirst:缩胸 == 0
	CALL k1011GPC("L", @"「어라, 어라...?」", TARGET)
	CALL k1011GPC("W", @"「가슴이... 어째서 작아졌지...」", TARGET)
	K1011MedicineFirst:缩胸 = 1
ENDIF
;止乳药

@k1011Lactifuge()
;怀孕
IF k1011GetTalent("恋慕") && k1011GetTalent("怀孕")
	CALL k1011GPC("W", @"「응...? 모유... 안 나와요?」", TARGET)
	CALL k1011GP("W", @"프란의 얼굴에서 혈색이 순식간에 사라졌다.")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 어떡하지, 어떡해... 아이를 낳으면 모유 수유를 해야 하는데...!」", TARGET)
	;恋慕
ELSEIF k1011GetTalent("恋慕")
	CALL k1011GPC("L", @"「아, 모유가 없어」", TARGET)
	CALL k1011GPC("W", @"「하지만 왜 우유가 나오는 거지?」", TARGET)
	;除此之外
ELSE
	CALL k1011GPC("L", @"「아, 드디어 모유 수유가 끝났네.」", TARGET)
	CALL k1011GPC("W", @"「%조사처리(CALLNAME:MASTER,"가")% 우유를 전부 짜냈기 때문에 없어진 건가요?」", TARGET)
ENDIF
;漏尿改善

@k1011UrinaryImprove()
;恋慕
IF k1011GetTalent("恋慕")
	CALL k1011GPC("L", @"「하지만 이렇게...는 재미가 없네」", TARGET)
	CALL k1011GPC("W", @"「……어, 그래도 고마워요, %k1011Name(TARGET, MASTER)%」", TARGET)
