;记忆消除药

@k1011MemoryForget()
;初次(YM特有,就用ym的判定吧)
IF (CFLAG:17 & 16) == 0
	;看着好刀啊，我为什麼要在这里受罪。有没有这种药，给我也来个，好像把这个片段忘了
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("W", @"「이번에 이 약 먹으면 되는 거죠?」", TARGET)
		CALL k1011GP("W", @"이미 더 이상 %조사처리(CALLNAME:MASTER,"의")% 플란은 망설임 없이 그 약을 삼켰다.")
		CALL k1011GPC("W", @"「음, 좀 쓰네.」", TARGET)
		CALL k1011GPC("W", @"「그리고 %k1011Name(TARGET, MASTER)%는 이번에 뭘 할 거야?」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%——?」", TARGET)
		CALL k1011GPC("W", @"「너는 플란(Fland)이 되러 온 게 약 먹으려고야? 뭐야, 정말 지루해......」", TARGET)
		CALL k1011GP("W", @"후란은 풀이 죽어 몸이 갑자기 무너졌다.")
		CALL k1011GPC("W", @"「어라… 뭔가 좀 멍한 기분이야…」", TARGET)
		CALL k1011GPC("W", @"「지쳤겠지…… %k1011Name(TARGET, MASTER)%는 잠시 눈 좀 붙어도 괜찮을까...?」", TARGET)
		CALL k1011GPC("W", @"「응, 그럼 잠시 눈 좀 붙이자...」", TARGET)
		CALL k1011GPC("W", @"「내가 바로 일어나서, 그리고——」", TARGET)
		CALL k1011GPC("W", @"「너랑 놀고 싶었던 거잖아……」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%．．．．．．」", TARGET)
		;除此之外
	ELSE
		CALL k1011GPC("W", @"「아, 이건 뭐지……」", TARGET)
		CALL k1011GPC("W", @"「정말 어리네... 플란은 사라지지 않겠지?」", TARGET)
		CALL k1011GPC("W", @"「음...... 잠시 자야겠다. 안녕, %k1011Name(TARGET, MASTER)%......」", TARGET)
	ENDIF
	;二次
ELSE
	;記憶を無くす前は恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("W", @"「이번에 이 약 먹으면 되는 거죠?」", TARGET)
		CALL k1011GP("W", @"이미 더 이상 %조사처리(CALLNAME:MASTER,"의")% 플랑이 그 약을 갖고 있는지 의심하지 않는다——")
		CALL k1011GPC("W", @"「아... 이쪽인가?」", TARGET)
		CALL k1011GP("W", @"잃어버렸다")
		CALL k1011GPC("W", @"「왜일까? 뭔가, 뭔가......」", TARGET)
		CALL k1011GPC("W", @"「정말 슬프네……」", TARGET)
		CALL k1011GPC("W", @"「으, 그만... 그만... 싫어, 나 이 약 못 먹겠어!」", TARGET)
		CALL k1011GP("W", @"후란이 %조사처리(CALLNAME:MASTER,"를")% 끌어안고 소리 높여 울었다.")
		CALL k1011GP("W", @"……")
		CALL k1011GP("W", @"．．．．．．")
		CALL k1011GP("W", @".．.")
		;除此之外
	ELSE
		CALL k1011GPC("W", @"「아, 이건 뭐지……」", TARGET)
		CALL k1011GPC("W", @"「정말 어리네... 플란은 사라지지 않겠지?」", TARGET)
		CALL k1011GPC("W", @"「음...... 잠시 자야겠다. 안녕, %k1011Name(TARGET, MASTER)%......」", TARGET)
	ENDIF
ENDIF
;个人不喜欢记忆控制之类的药物
CALL k1011MemoryForgetDp()
;红色糖果(处女再生)

@k1011RedCandy()
;初次
IF K1011MedicineFirst:处女再生 == 0
	;恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("L", @"「처녀 재생? 이건 뭐 하는 거야?」", TARGET)
		CALL k1011GPC("W", @"「하지만 %k1011Name(TARGET, MASTER)%이 준 것이니, 분명 사람을 기분 좋게 해주는 것이겠지♪」", TARGET)
		;除此之外
	ELSE
		CALL k1011GPC("L", @"「이렇게... 무슨 변화가 있나요?」", TARGET)
		CALL k1011GP("W", @"이렇게 플란은 처녀의 상태로 회복했을 것이다. 다음 조련을 기대하자.")
	ENDIF
	K1011MedicineFirst:处女再生 = 1
	;二次
ELSE
	;恋慕
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("L", @"「아, 이러면 %k1011Name(TARGET, TARGET)%가 또 순녀막을 피우는 건가?」", TARGET)
		CALL k1011GPC("W", @"「이런 상황에서 사랑을 나누면, 특별히 아플 거야……」", TARGET)
		CALL k1011GPC("W", @"「하지만 다시 %k1011Name(TARGET, MASTER)%에게 처녀를 바칠 수 있다면……%k1011Name(TARGET, TARGET)%도 꽤 기대돼♪」", TARGET)
		;除此之外
	ELSE
		CALL k1011GPC("L", @"「음......무슨 일이야?」", TARGET)
		CALL k1011GPC("W", @"「네 거 다시 단단해진 것 같아... 더 하면 엄청 아플 거야」", TARGET)
	ENDIF
ENDIF
;蓝色糖果(母乳)

@k1011BlueCandy()
CALL k1011GPC("L", @"「어라... 무슨 변화라도 있나?」", TARGET)
CALL k1011GPC("W", @"「아... 가슴이 간지러운 것 같아.」", TARGET)
;记忆消除药数据保存处理

@k1011MemoryForgetDp()
;选择重置区
CALL k1011ChoiceInitVar
IF K1011FlanHaveRod & 1p0
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 플란의 방에서 진동봉을 찾아냈다.")
	SIF k1011GetItem("振动棒")
		CALL k1011GP("W", @"하지만 자기 손에 이미 진동봉이 있었기에, %조사처리(CALLNAME:MASTER,"는")% 그것을 버렸다.")
	CALL k1011SetItem("振动棒", 1)
ENDIF
IF K1011FlanHaveRod & 1p1
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 플랑의 방에서 항문 진동봉을 찾아냈다.")
	SIF k1011GetItem("肛门振动棒")
		CALL k1011GP("W", @"하지만 자기 손에 이미 항문 진동봉이 있었기에, %조사처리(CALLNAME:MASTER,"는")% 그것을 버릴 수밖에 없었다.")
	CALL k1011SetItem("肛门振动棒", 1)
ENDIF
