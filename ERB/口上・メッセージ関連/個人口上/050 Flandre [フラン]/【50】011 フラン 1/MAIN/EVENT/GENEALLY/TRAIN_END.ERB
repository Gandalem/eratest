; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/TRAIN_END.ERB
;调教后双人运动

@k1011TrainEndV
IF K1011AllowVampirism && RAND:8 >= 5
	CALL k1011GPC("W", @"「아, 아, %k1011Name(TARGET, MASTER)%의 피... 갖고 싶어... 정말 갖고 싶어!」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 프랑의 목을 물고, 동시에 힘껏 프랑의 어린 구멍을 박아댔다.")
	CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "呼、嗯!嗯……～～～～～! !")%」", TARGET)
	CALL k1011GP("W", @"흡혈로 인한 예민한 감각으로 두 사람을 여러 번 높은 정점으로 이끈다.")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 마치 생명이 빨려 나간 것처럼 모든 정액을 플란에게 주었다.")
	CALL k1011Vampirism
	CALL k1011AddExp("精液经验", 5)
	;怀孕
ELSEIF k1011GetTalent("怀孕")
	IF RAND:3 == 0
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%! ……좀 더 힘을 내! 좀 더 힘내라고!」", TARGET)
		CALL k1011GP("W", @"푸란은 힘껏 허리를 흔들고, 파닥파닥 날갯짓을 하며 몸을 비틀었다.")
		CALL k1011GPC("W", @"「많은 정자들, %k1011Sound("Orgasm", "哇、好……哇!")%」", TARGET)
	ELSEIF RAND:2 == 0
		CALL k1011GP("W", @"임신한 소녀가 품 안에서 거칠게 몸을 흔드는 모습을 보자, %조사처리(CALLNAME:MASTER,"는")% 더욱 격렬하게 허리를 흔들기로 결정한다.")
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "呜呜呜!啊!啊!啊! !")%」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……안으로 좀 더 들어와」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%은 동시에 두 번 임신하고 싶다...」", TARGET)
	ENDIF
	;V感觉Lv4以上 吸血
ELSEIF k1011GetAbl("Ｖ感觉") >= 3
	IF RAND:4 == 0
		CALL k1011GPC("W", @"「가지 마세요…… %k1011Name(TARGET, MASTER)%, 좀 더 해봐요……♪」", TARGET)
		CALL k1011P("", @"「여기 좀 만져봐... 나 벌써 다 젖을 지경이야」", TARGET)
	ELSEIF RAND:3 == 0
		CALL k1011GPC("W", @"「아, 몸이 너무 뜨거워서 견딜 수가 없어...」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%! 계속, 계속, 빨리 %k1011Name(TARGET, TARGET)%의 보지를 엉망진창으로 만들어줘!」", TARGET)
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "啊、呀!")%%k1011Name(TARGET, MASTER)%！！」", TARGET)
	ELSEIF RAND:2 == 0
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%의 그런 일은 마음이 좋아질 거야♪」", TARGET)
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "嗯……呼、嗯……哼……")%」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 자궁구와 어린 질에 삽입될 때마다 음경을 조인다.")
		CALL k1011GPC("W", @"「'%k1011Sound("Orgasm", "啊、哦……啊!")%'가 흘러 나왔다... ♪」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, ...좀 더 빨리! 더 빠르게 가자!", TARGET)
		CALL k1011GP("W", @"후란은 힘껏 허리를 흔들고, 작은 날개를 파닥이며, 몸을 비틀었다.")
		CALL k1011GPC("W", @"「정액이 정말 많네, %k1011Sound("Orgasm", "哇、好……哇!")%」", TARGET)
	ENDIF
	;除此之外
ELSE
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%……아, 아!%k1011Name(TARGET, TARGET)%……잘……했지?」", TARGET)
ENDIF
;调教后夜爬

@k1011TrainEndNight
;吸血夜爬
IF K1011AllowVampirism && RAND:8 >= 4
	CALL k1011GPC("W", @"「아, 아, %k1011Name(TARGET, MASTER)%……%k1011Name(TARGET, TARGET)% 목말라 죽겠어…」", TARGET)
	CALL k1011GP("W", @"프랑은 내 곳으로 음경을 물고, 몸을 뒤집어 %조사처리(CALLNAME:MASTER,"의")% 목을 물었다.")
	CALL k1011GP("W", @"몸이 힘이 없자 %조사처리(CALLNAME:MASTER,"는")% 주도권을 플란에게 넘겼다.")
	CALL k1011GPC("W", @"「%k1011Sound("Mouth", "哈——嗯……嗯……嗯。")%」", TARGET)
	CALL k1011GP("W", @"프랑은 흡혈하는 동시에 격렬하게 허리를 비틀었다.")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 숨을 쉴 때마다 다량의 정액을 플란의 몸속에 뱉었다.")
	CALL k1011GPC("W", @"「어이, %k1011Name(TARGET, MASTER)%%k1011Sound("Orgasm", "喂、哟……嗯、呼——呼")%」", TARGET)
	CALL k1011Vampirism
	CALL k1011AddExp("精液经验", 8)
	K1011VampirismTimes ++
	;怀孕
ELSEIF k1011GetTalent("怀孕")
	IF RAND:2 == 0
		CALL k1011GPC("W", @"「이렇게 하면, 아이가 일찍 태어날 것 같아……」", TARGET)
		CALL k1011GP("W", @"새 생명을 품고 있는 소녀는 거친 숨을 몰아쉬며 %조사처리(CALLNAME:MASTER,"의")% 정액을 필사적으로 찾는다.")
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 번의 노릇을 프란의 질에 사정했다.")
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%…… 아이가 어째 아직 태어나지 않는 거야……」", TARGET)
		CALL k1011GPC("W", @"「너무 외롭네... 너무 외롭네...」", TARGET)
		CALL k1011GP("W", @"프랑은 외로움에 눈물을 흘렸지만, 여전히 %조사처리(CALLNAME:MASTER,"의")% 것을 품고 움직였다.")
	ENDIF
	;除此之外
ELSE
	IF RAND:5 == 0
		CALL k1011GPC("L", @"「후후, %k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%가 네가 잠들지 못하게 하려는 게 아니라,\n이런 밤에는 하지 않으면 몸이 너무 괴로워져…♪」", TARGET)
		CALL k1011GPC("W", @"「그러니까, 오늘 밤은 계속 %k1011Name(TARGET, TARGET)%하고 사랑을 나눌 거야♪」", TARGET)
		CALL k1011GP("W", @"후란은 귀엽고도 음란한 미소를 지으며 격렬한 허리 기술로 %조사처리(CALLNAME:MASTER,"의")% 것을 빨아들였다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, MASTER)% 벌써 갈 것 같아? 정말 싫어, 조금만 더 참으면서 계속해 줘♪」", TARGET)
		CALL k1011GPC("L", @"「응!♪ %k1011Name(TARGET, MASTER)%의 거시기가 안에서 꾸르륵거리고 있어……」", TARGET)
		CALL k1011GPC("W", @"「음란한 %k1011Name(TARGET, TARGET)%은 흥분했나? 그럼 어쩔 수 없지♪」", TARGET)
	ELSEIF RAND:4 == 0
		CALL k1011GPC("W", @"「아, 아... %k1011Name(TARGET, MASTER)%...... 몸이 뜨거워서 잠을 이룰 수 없다」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 후란이 정말 가고 싶어 했고, 작은 구멍도 여러 번 가고 싶었지!」", TARGET)
	ELSEIF RAND:3 == 0
		CALL k1011GPC("L", @"「오늘, %k1011Name(TARGET, TARGET)%는 고기 막대 먹고 싶어... 괜찮을까?」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%는 %k1011Name(TARGET, MASTER)%와 함께 있을 거야……」", TARGET)
		CALL k1011GP("W", @"두 사람은 아침까지 계속 움직였고, 플란은 항상 %CALLNAME:MASTER%위에서 작은 몸을 흔들었다.")
	ELSEIF RAND:2 == 0
		CALL k1011GPC("L", @"「%k1011Sound("Happy", "哈、啊……恩、恩、")% 더는 참을 수 없어」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%혼자서 몇 번이나 해봤지만, %k1011Name(TARGET, MASTER)%의 것이 없으면 도저히 만족할 수 없어……」", TARGET)
		CALL k1011GPC("W", @"「아! 계속해, 더 세게 %k1011Name(TARGET, TARGET)%를 찔러줘!♪」", TARGET)
		CALL k1011GPC("W", @"「와, 와! %k1011Name(TARGET, TARGET)%의 작은 구멍과 남성 성기의 모양으로 변해버렸네!」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%는 당신과 함께 있고 싶어서 왔어요...」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, 괜찮겠지...」", TARGET)
	ENDIF
ENDIF
;触手

@k1011TrainEndT
IF k1011GetAbl("触手中毒") >= 3
	CALL k1011GPC("W", @"「아하...♪ %k1011Name(TARGET, MASTER)%가 떠났네...♪」", TARGET)
	CALL k1011GPC("W", @"「단 두 명뿐이야, 촉수 선생님…」", TARGET)
	CALL k1011GPC("W", @"「다시는 아무도 방해하지 못할 거야…」", TARGET)
	CALL k1011GPC("W", @"「다봉이 푸란을 완전히 망쳐버렸어...♪」", TARGET)
ELSE
	CALL k1011GPC("W", @"「싫어! %k1011Name(TARGET, MASTER)%가 이미 없잖아, 빨리 사라져 버려!」", TARGET)
	CALL k1011GPC("W", @"「싫어! 싫다고! 나한테 달라붙지 마!」", TARGET)
	CALL k1011GPC("W", @"「싫어! 그런 곳에 가지 마... 흑흑!」", TARGET)
ENDIF
