		CALL k1011GP("W", @"위험을 느낀 %조사처리(CALLNAME:MASTER,"는")% 푸른의 손에서 아기를 들고 육아실을 뛰쳐나갔다.")
		CALL k1011GP("W", @"――그날 플란의 미친 웃음소리가 홀 전체에 울려 퍼졌다.")
	ENDIF
