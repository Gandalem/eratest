@k1011BirthBaby
DRAWLINE
IF K1011HavePreg == 1 && k1011GetTalent("魅惑") && k1011GetOtherInfo("父亲") == NO:MASTER
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, 봐, 이건 플랑과 %k1011Name(TARGET, MASTER)%의 아기야♪」", TARGET)
	CALL k1011GPC("W", @"「이번에 태어난 아기가 %k1011Name(TARGET, MASTER)%이랑 좀 닮았네...」", TARGET)
	CALL k1011GPC("W", @"「히히... 정말 귀엽네♪」", TARGET)
ELSE
	IF k1011GetTalent("恋慕") == 1 && k1011GetTalent("魅惑")
		CALL k1011GPC("W", @"「이것이 아기인가?」", TARGET)
		SIF k1011GetOtherInfo("父亲") == NO:MASTER
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%와……%k1011Name(TARGET, MASTER)%의?」", TARGET)
		CALL k1011GP("W", @"후란은 품 안의 아기를 바라보며 작은 소리로 중얼거렸다.")
		CALL k1011GPC("W", @"「......너무 귀엽다」", TARGET)
		CALL k1011GP("W", @"선홍색의 큰 눈에서 서서히 눈물이 새어 나왔다.")
		CALL k1011GP("W", @"아기는 호기심 가득 엄마 얼굴에서 떨어지는 물방울을 올려다본다.")
	ELSE
		CALL k1011GPC("W", @"「이것이 아기인가?」", TARGET)
