		CALL k1011GP("W", @"금세... 플란은 천진난만한 미소를 지으며 아기를 안았다.")
		CALL k1011GPC("W", @"「아하하하하! 이봐, 아가야... 빨리 와서 나랑 놀자」", TARGET)
		CALL k1011GP("W", @"언제부터였을까... 그 눈동자 속에 알 수 없는 어두운 빛이 감돌고 있었다.")
