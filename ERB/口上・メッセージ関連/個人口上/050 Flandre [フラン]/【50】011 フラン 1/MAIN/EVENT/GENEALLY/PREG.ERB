@k1011GetPreg
DRAWLINE
IF K1011HavePreg == 1
	CALL k1011GP("W", @"(아... 이런 느낌...)")
	CALL k1011GPC("W", @"「...이미 둘째가 있다...」", TARGET)
	CALL k1011GP("W", @"후란은 부드럽게 미소 지으며 배를 애정스럽게 쓰다듬었다.")
	CALL k1011GPC("W", @"「만약 건강하게 태어날 수 있다면 좋겠는데...♪」", TARGET)
ELSE
	CALL k1011GP("W", @"(어라...? 뭔가 이상하다고 느끼는데...)")
	CALL k1011GPC("W", @"「어떻게 된 거야, %k1011Name(TARGET, TARGET)%의 몸이 이상해……」", TARGET)
ENDIF
