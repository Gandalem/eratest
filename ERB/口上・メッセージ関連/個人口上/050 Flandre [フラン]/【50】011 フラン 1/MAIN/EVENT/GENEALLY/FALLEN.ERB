@k1011GetFutaNormally
SIF K1011Game == "TW"
	RETURN
CALL k1011GSetQ("「她超持久的」", "「嗯、当然」", "「扶她当然是早泄的小鸡鸡啊!」")
CALL k1011GInput()
IF RESULT == 0
	CALL k1011GP("W", @"후란은 특별히 오래가고 대단하다.")
	CALL k1011SetTalent("持久", 1)
ELSEIF RESULT == 1
	CALL k1011GP("W", @"플랜과 %조사처리(CALLNAME:MASTER,"는")% 똑같이, 대단하다")
	CALL k1011SetTalent("持久", 0)
ELSEIF RESULT == 2
	CALL k1011GP("W", @"후란, 너 조금만 더 참아줘")
	CALL k1011SetTalent("持久", -1)
ENDIF
