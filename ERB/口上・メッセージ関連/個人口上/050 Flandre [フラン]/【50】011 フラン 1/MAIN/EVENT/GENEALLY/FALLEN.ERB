@k1011FallenLove
DRAWLINE
IF K1011Character == 1
	CALL k1011GPC("W", @"「.........」", TARGET)
	CALL k1011GP("W", @"후란은 열렬한 시선으로 %조사처리(CALLNAME:MASTER,"를")% 바라보았다.")
	CALL k1011GP("W", @"그리고 %조사처리(CALLNAME:MASTER,"가")% 오히려 플랜을 비난하자, 그녀는 허둥지둥 침대로 피하며 파닥파닥 작은 날개를 흔들었다.")
	CALL k1011GP("W", @"(%조사처리(CALLNAME:MASTER,"를")% 보면, 마음이 너무 괴롭다...)")
ELSE
	CALL k1011GPC("W", @"「.........」", TARGET)
	CALL k1011GP("W", @"후란은 열렬한 시선으로 %조사처리(CALLNAME:MASTER,"를")% 바라보았다.")
	CALL k1011GP("W", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 오히려 프랑을 지적하자, 프랑의 얼굴이 점차 붉어졌다.")
	CALL k1011GP("W", @"(…이상한 느낌, 저 사람을 만났을 때의 느낌과는 다른 것 같아...)")
	CALL k1011GP("W", @"(너무 흥분돼... 너무 괴로워...)")
ENDIF
CALL k1011GPC("W", @"「쾅」 소리와 함께 문이 잠기고, 플란은 홀로 방에 남았다.", TARGET)
CALL k1011GPC("W", @"「아...... 또 %k1011Name(TARGET, TARGET)% 혼자가 되었네......」", TARGET)
DRAWLINE
