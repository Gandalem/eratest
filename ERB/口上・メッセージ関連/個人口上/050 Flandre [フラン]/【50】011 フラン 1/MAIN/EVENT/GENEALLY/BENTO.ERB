			CALL k1011GPC("W", @"「하아, 아! %k1011Name(TARGET, MASTER)%는, 플란의 처녀가 편하니?」", TARGET)
			CALL k1011GPC("W", @"「기분은 좋았지만, 플란이 아직 배불리 못했으니 정액을 좀 더 줘!」", TARGET)
			CALL k1011GP("W", @"플랑의 요구대로 %조사처리(CALLNAME:MASTER,"는")% 소녀의 처녀를 가져갔다.")
		ENDIF
	ELSE
		IF RAND:3 == 0
			CALL k1011GPC("W", @"「헤헤, %k1011Name(TARGET, MASTER)% 배불리 먹었지? 그럼 후른은 하고 싶은 일을 하러 올게♪」", TARGET)
			CALL k1011GPC("W", @"「페로... 음, 아키... 음, 음... 그래... 응, 크다♪」", TARGET)
			CALL k1011GP("L", @"후란은 먼저 %조사처리(CALLNAME:PLAYER,"가")% 흥분한 것을 구강성애로 하고, 그녀의 두 다리 사이로 올라간 뒤 스스로 음순을 벌리고 분노하는 것을 삼켰다.")
			CALL k1011GPC("W", @"「음... 너무 크네, 다 못 먹겠어... 겨우 삼켰다, 거기도 아주 기운이 넘치네♪」", TARGET)
			CALL k1011GPC("W", @"「그럼 시작하자, %k1011Name(TARGET, MASTER)%가 플랑의 손을 잡자! 플랑은 손을 잡고 싶어! 플랑은 손을 잡고 싶어!」", TARGET)
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 후란의 작은 손을 꼭 잡고, 후란이 탑승 자세를 취하기 시작했다.")
			CALL k1011GPC("W", @"「후란의 작은 구멍은 계속 배가 고프다, 얼마나 나오든 다 싸버려라」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 그저 플랑의 손을 잡고 있으면 괜찮아♪ 헤헤♪」", TARGET)
			CALL k1011GP("W", @"그래서 기분이 좋은 프란은 계속 주도권을 잡았다.")
		ELSEIF RAND:2 == 0
			CALL k1011GPC("L", @"「어, 하! 플란 안에서, 덜컹덜컹거려!」", TARGET)
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 정상 자세, 등 뒤 자세, 기마 자세... 어떤 자세로든 플란이 귀여운 신음을 내게 했다.")
			CALL k1011GPC("W", @"「또 단단하고 크네, 굉장해! 정말 대단해!」", TARGET)
			CALL k1011GPC("W", @"「아, 아! 플란이 가요! 플란이 또 절정에 다다를 거예요! ♪」", TARGET)
		ELSE
			CALL k1011GPC("W", @"「음……하……하……%k1011Name(TARGET, MASTER)%……」", TARGET)
			CALL k1011GPC("L", @"「후란은 당신을 좋아해... 후란은 가장 당신을 좋아해...」", TARGET)
			CALL k1011GPC("W", @"「후란은 계속 이렇게 당신과 함께 있고 싶어♪」", TARGET)
			CALL k1011GP("W", @"푸란은 %조사처리(CALLNAME:MASTER,"의")% 등에 손을 올리고, 두 사람은 숨이 찰 때까지 서로 키스를 했다.")
			CALL k1011GPC("W", @"「히히... 프란이 %k1011Name(TARGET, MASTER)%에게 이렇게 열심히 키스해 주는 거, 정말 다행이야♪」", TARGET)
		ENDIF
	ENDIF
