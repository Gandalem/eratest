		CALL k1011GPC("W", @"「오……%k1011Name(TARGET, MASTER)%……」", TARGET)
		CALL k1011GP("W", @"아마 포만감과 피로감, 그리고 정신을 차렸을 때 프란은 이미 %조사처리(CALLNAME:MASTER,"의")% 무릎 위에서 잠들어 있었기 때문일 것이다.")
