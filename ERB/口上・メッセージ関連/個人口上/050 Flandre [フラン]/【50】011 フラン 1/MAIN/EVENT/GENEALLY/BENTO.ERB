			;媚药标志
			K1011SexBento = 1
		ELSEIF RAND:2 == 0
			CALL k1011GP("W", @"식사를 마친 후, 프란이 %조사처리(CALLNAME:MASTER,"의")% 품에 안겨 홍조 가득한 작은 얼굴로 계속 비비고 있다.")
			CALL k1011GPC("W", @"「어머, %k1011Name(TARGET, MASTER)%♥ 내가 만든 요리 맛있지? 플란은 보상이 원해」", TARGET)
