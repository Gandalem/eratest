@k1011MakeBento
;媚药标志初期化
K1011SexBento = 0
IF K1011EventFirst:便当制作 == 0
	CALL k1011GPC("W", @"「요리」", TARGET)
	CALL k1011GPC("W", @"「음식을 만들고 싶다는 거야?」", TARGET)
	IF k1011GetTalent("恋慕")
		CALL k1011GPC("W", @"「음, %k1011Name(TARGET, TARGET)% 한번 해봐!」", TARGET)
		CALL k1011GPC("W", @"「그러니까 그게……%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%에게 요리하는 법을 가르쳐 줄 수 있어…?」", TARGET)
	ELSE
		CALL k1011GPC("W", @"「어떻게 해야 하지?」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%은/는 한 번도 만들어 본 적이 없다」", TARGET)
	ENDIF
	WAIT
	K1011EventFirst:便当制作 = 1
ELSE
	IF k1011GetTalent("恋慕")
		IF RAND:3 == 0 && k1011GetTalent("淫乱")
			CALL k1011GPC("W", @"「아, 괜찮아, 응... 좋아, %k1011Name(TARGET, MASTER)% 씨, 괜찮다면 나중에 같이 먹자♪」", TARGET)
			CALL k1011GPC("W", @"「헤헤... %k1011Name(TARGET, TARGET)% 또 좋은 아이디어를 떠올렸어」", TARGET)
			CALL k1011GP("W", @"푸란은 부엌에서 사라지며 매우 기뻐하는 것 같았다.")
		ELSEIF RAND:2 == 0
			CALL k1011GPC("W", @"「응, %k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%가 널 위해 열심히 만들었어. 괜찮으면 같이 먹자♪」", TARGET)
			CALL k1011GPC("W", @"「만약 가능하다면……」", TARGET)
			CALL k1011GPC("W", @"「……헤헤♪」", TARGET)
			SIF k1011GetTalent("淫乱")
				CALL k1011GP("W", @"후란은 이미 그 점을 깨달았는지, 얼굴을 붉히며 몸을 흔들었다.")
		ELSE
			CALL k1011GPC("W", @"「헤헤……%k1011Name(TARGET, TARGET)%은 맛있는 걸 만들도록 노력할 거야」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%가 거기서 기다리고 있으니, 여기로 오지 마 ♪」", TARGET)
		ENDIF
	ELSEIF k1011GetMark("反发刻印") > 1
		IF RAND:50 == 0 && k1011GetMark("反发刻印") >= 3
			CALL k1011GPC("W", @"「아, 괜찮아, 응... 좋아, %k1011Name(TARGET, MASTER)% 씨, 괜찮다면 나중에 같이 먹자♪」", TARGET)
			CALL k1011GP("W", @"플랑이 부엌에서 사라진 것을 보니 매우 기뻐하는 것 같았다. %조사처리(CALLNAME:MASTER,"는")% 오늘의 플랑이 다소 순종적인 것 같다고 느꼈다.")
			K1011BentoBE = 1
		ELSEIF K1011Character == 1
			CALL k1011GPC("W", @"「흐읍, 흐읍...」", TARGET)
			CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%맛있는 거 만들어 줄게… 기다리고 있어%k1011Name(TARGET, TARGET)%응」", TARGET)
			CALL k1011GPC("L", @"「정말 맛있는데... '둥' 소리가 날지도 않아...♪」", TARGET)
			PRINTW 후란은 말하면서 이상한 미소를 지었다.
		ELSEIF K1011Character == 2
			CALL k1011GPC("W", @"「아, 또 너에게 밥을 해줘야 하는구나……」", TARGET)
			CALL k1011GPC("W", @"「스스로 만들지 않으실 건가요?」", TARGET)
			IF k1011GetMark("恐怖刻印") && RAND:(4 - k1011GetMark("恐怖刻印")) == 0
				CALL k1011GP("L", @"비록 프란은 이에 대해 매우 큰 불만을 가지고 있었지만")
				CALL k1011GP("W", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 불쾌한 표정을 짓자, 겁에 질려 온몸을 떨더니 아무 말 없이 부엌으로 사라졌다.")
			ELSE
				CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 후에게 이 기간 동안 말 잘하면 집에 데려다주겠다고 하자, 후는 순순히 부엌으로 걸어 들어갔다.")
				CALL k1011GPC("W", @"「이건 네가 직접 한 말이야, 만약 약속을 어기려 한다면 네 몸이 '쿵' 하고 커지게 만들 거야.」", TARGET)
			ENDIF
		ELSE
			THROW 性格特点值错误,当前值为{K1011Character}
		ENDIF
	ELSE
		CALL k1011GPC("W", @"「어차피 %k1011Name(TARGET, TARGET)%도 과자 같은 걸 만들고 싶을 테니」", TARGET)
		CALL k1011GPC("W", @"「달콤한 케이크 위에 산딸기 잼을 바른다」", TARGET)
	ENDIF
ENDIF
