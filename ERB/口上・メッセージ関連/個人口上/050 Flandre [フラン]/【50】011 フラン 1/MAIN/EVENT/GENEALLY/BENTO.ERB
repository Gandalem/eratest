			CALL k1011GPC("W", @"「……다행이다♪」", TARGET)
		ELSE
			CALL k1011GP("W", @"후란은 어찌 된 일인지 주저하며 %CALLNAME:MASTER%옆으로 다가갔다.")
			CALL k1011GP("W", @"한쪽에서는 %조사처리(CALLNAME:MASTER,"의")% 옷자락을 붙잡고, 다른 쪽에서는 얼굴을 붉힌 채 고개를 들어 %조사처리(CALLNAME:MASTER,"를")% 바라봤다.")
