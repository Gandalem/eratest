	CALL k1011GPC("W", @"「그, 그래... 푸른의 일은...」", TARGET)
	CALL k1011GPC("W", @"「아이고, 아이고! 아야!」", TARGET)
	CALL k1011GP("W", @"그 모습을 보자, 프랑은 본능적으로 자신이 무엇을 당했는지 감지하고 격렬하게 저항하기 시작했다.")
	CALL k1011GPC("W", @"「이제 됐어! 이제 됐다고! !됐어! ! !됐어!」", TARGET)
	CALL k1011GP("W", @"대량 주입된 촉수의 정액이 가장 깊은 곳에 도달한 후, 서둘러 플란의 난자로 몰려갔다.")
ENDIF
IF CFLAG:3669 == -2
	CALL k1011GP("W", @"갑자기 촉수들은 착상이 되지 않은 후란에게 경이로움을 느끼며 아직 초경 때가 되지 않았음을 알아차렸다.")
	CALL k1011GP("W", @"그리고 특수한 분비액이 있는 관을 벌어진 틈에 삽입하여, 소녀의 자궁을 강제로 어른의 자궁으로 만들었다.")
	CALL k1011GP("W", @"그 일이 성공한 후 촉수는 매우 만족했고, 다시 활력 있는 정액을 주입하여 플란이 임신하게 했다.")
