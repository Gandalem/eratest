@k1011BloodTrainEnd
;恋慕
IF k1011GetTalent("恋慕")
	CALL k1011GPC("W", @"「%k1011Sound("Happy", "哇、哇! !哇! !♪")%」", TARGET)
	CALL k1011GPC("W", @"「아! %k1011Name(TARGET, MASTER)%님! 왜 계속 안 하는 거야!」", TARGET)
	CALL k1011GPC("W", @"「이런 일은 플란 혼자서는 못 견뎌요~ %k1011Name(TARGET, MASTER)%!!!」", TARGET)
	;除此之外
ELSE
	CALL k1011GPC("L", @"「%k1011Sound("Happy", "啊、啊、")% 무슨 일이야, 가야 해...!」", TARGET)
	CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊啊! !")% 도저히 멈출 수가 없어!!」", TARGET)
ENDIF
