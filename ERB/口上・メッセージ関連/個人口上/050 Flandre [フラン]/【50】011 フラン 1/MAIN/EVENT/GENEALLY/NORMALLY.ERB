@k1011BloodTrain
;恋慕
IF k1011GetTalent("恋慕")
	CALL k1011GPC("W", @"「아...」", TARGET)
	CALL k1011GPC("W", @"「안 돼, 안 돼, 안 돼, 안 돼!! 가버릴 거야!! ♪」", TARGET)
	CALL k1011GPC("W", @"「%k1011Sound("Happy", "啊、啊-啊! !")% 갑자기 굉장해졌어! ♪」", TARGET)
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%! 빨리 %k1011Name(TARGET, TARGET)%를 가지고 놀아!」", TARGET)
	;除此之外
ELSE
	CALL k1011GPC("L", @"「%k1011Sound("Happy", "啊呀、啊呀! !")% 너무 기분이 좋다~ ~ ~ ~!!」", TARGET)
	CALL k1011GPC("W", @"「더 거세하게, 빨리 방법을 생각해내라! ! !♪」", TARGET)
ENDIF
K1011BloodMedicine = 1
