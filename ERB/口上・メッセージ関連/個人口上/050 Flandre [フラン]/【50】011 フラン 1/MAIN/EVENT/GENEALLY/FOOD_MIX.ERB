; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/GENEALLY/FOOD_MIX.ERB
;----------------------------------------------------------------
;食物混入物
;----------------------------------------------------------------

@k1011FoodMixSemen, accept
#DIM loveSemen	;是否喜欢精液
#DIM accept		;接受度 1反抗 2接受
;是否喜欢精液
loveSemen = k1011GetTalent("精爱味觉") || k1011GetAbl("精液中毒") >= 5
;首次触发
IF K1011FoodMixSemenReaction == 0
	IF K1011MouthShout && accept == 1 && !loveSemen
		CALL k1011GPC("W", @"「에, 퉤, 퉤, 퉤……」", TARGET)
		CALL k1011GP("L", @"후란은 속이 메스꺼워져서 작은 발걸음으로 화장실에 달려가 입을 헹궜다.")
		CALL k1011GPC("W", @"「이건 무슨 맛이야, 이렇게 역겹다...」", TARGET)
		K1011FoodMixSemenReaction = 1
	ELSEIF accept == 1 && !loveSemen
		CALL k1011GPC("W", @"「에, 퉤, 퉤, 퉤……」", TARGET)
		CALL k1011GP("L", @"프랑은 메스꺼움을 느끼고 입안의 음식 전부를 토해냈다.")
		CALL k1011GPC("W", @"「어떻게 밥에 이런 걸 섞을 수 있지, %k1011Name(TARGET, MASTER)% 정말 역겹다」", TARGET)
		K1011FoodMixSemenReaction = 1
	ELSEIF accept == 1 && loveSemen
		CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%의 정액이군……」", TARGET)
		CALL k1011GPC("W", @"「삼키고 싶어...」", TARGET)
		CALL k1011GP("W", @"푸란이 망설이기 시작한다.")
		CALL k1011GP("L", @"하지만 결국 혀에서 전해오는 미묘한 쾌감을 이겨내고 음식을 토해냈다.")
		CALL k1011GPC("W", @"「안 돼, %k1011Name(TARGET, TARGET)%은 %k1011Name(TARGET, MASTER)%에게 굴복할 수 없어」", TARGET)
		K1011FoodMixSemenReaction = 3
	ELSEIF accept == 2 && !loveSemen
		CALL k1011GPC("W", @"「엣-」", TARGET)
		CALL k1011GPC("W", @"「어떻게 정액 같은 게 있어, 정말 역겨워……」", TARGET)
		CALL k1011GPC("W", @"「하지만 이건 %k1011Name(TARGET, MASTER)%의 액체인 것 같네...」", TARGET)
		CALL k1011GP("L", @"비록 플란은 정액의 이상한 맛에 구역질이 났지만, 이것이 자신이 가장 좋아하는 %조사처리(CALLNAME:MASTER,"의")% 체액이라는 생각을 하니 플란은 결국 참고 삼켰다.")
		K1011FoodMixSemenReaction = 2
	ELSEIF accept == 2 && loveSemen
		CALL k1011GPC("W", @"「음...... %k1011Name(TARGET, MASTER)%의 맛이네……」", TARGET)
		CALL k1011GP("W", @"플란은 음식 속에 스며든 정액의 맛을 음미했다.")
		CALL k1011GPC("W", @"「음식에 정액을 넣다... %k1011Name(TARGET, MASTER)% 정말 변태네」", TARGET)
		CALL k1011GPC("W", @"「하지만%k1011Name(TARGET, TARGET)% 너무 좋아…… %k1011Name(TARGET, TARGET)%도 정말 변태였구나」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%랑 %k1011Name(TARGET, MASTER)%는 둘 다 변태니까, 우리 정말 잘 어울리겠지?」", TARGET)
		K1011FoodMixSemenReaction = 4
	ENDIF
	;二次
ELSE
	SELECTCASE K1011FoodMixSemenReaction
		;上次讨厌拒绝
		CASE 1
			;讨厌拒绝
			IF accept == 1 && !loveSemen
				CALL k1011GPC("W", @"「에헤헤...」", TARGET)
				CALL k1011GPC("W", @"「어째서 또 음식에 정액을 넣는 거야……」", TARGET)
				CALL k1011GP("W", @"구역질 나는 게 토할 것 같은 프랑은 서둘러 화장실로 달려가 입을 헹궜다.")
				K1011FoodMixSemenReaction = 1
				;讨厌接受
			ELSEIF accept == 2 && !loveSemen
				CALL k1011GPC("W", @"「에...」", TARGET)
				CALL k1011GPC("W", @"「또 안에 정액을 넣는 거야...」", TARGET)
				CALL k1011GPC("W", @"「하지만 버리게 된다면 %k1011Name(TARGET, MASTER)%가 슬퍼하겠지」", TARGET)
				CALL k1011GP("W", @"안에 넣은 것이 자신이 좋아하는 사람의 체액이라는 점에, 프랑은 여전히 역겨움을 참으며 그것을 삼켰다.")
				K1011FoodMixSemenReaction = 2
				;喜欢拒绝
			ELSEIF accept == 1 && loveSemen
				CALL k1011GPC("W", @"「음…… 나는 어째서 먹고 싶다는 느낌이 드는 걸까……」", TARGET)
				CALL k1011GPC("W", @"「안에는 %k1011Name(TARGET, MASTER)%의 정액이 들어있다……」", TARGET)
				CALL k1011GPC("W", @"「안 돼, 너무 무서워」", TARGET)
				CALL k1011GP("W", @"프랑은 허둥지둥 음식을 쏟았다.")
				K1011FoodMixSemenReaction = 3
				;喜欢接受
			ELSEIF accept == 2 && loveSemen
				CALL k1011GPC("W", @"「음... 내가 어떻게 이런 걸 먹고 싶을까...」", TARGET)
				CALL k1011GPC("W", @"「난 더 변태가 되고 싶어……」", TARGET)
				CALL k1011GPC("W", @"「하지만 음식에 정액을 넣는 변태라면 플란 같은 변태를 좋아할 것이다」", TARGET)
				CALL k1011GP("W", @"플란은 음식 속으로 스며든 정액 맛을 음미했다.")
				K1011FoodMixSemenReaction = 4
			ENDIF
			;上次讨厌接受
		CASE 2
			;讨厌拒绝
			IF accept == 1 && !loveSemen
				CALL k1011GPC("W", @"「에헤헤...」", TARGET)
				CALL k1011GPC("W", @"「어째서 또 음식에 정액을 넣는 거야……」", TARGET)
				CALL k1011GPC("W", @"「이번엔 정말 못 먹겠어」", TARGET)
				CALL k1011GP("W", @"구역질 나는 게 토할 것 같은 프랑은 서둘러 화장실로 달려가 입을 헹궜다.")
				K1011FoodMixSemenReaction = 1
				;讨厌接受
			ELSEIF accept == 2 && !loveSemen
				CALL k1011GPC("W", @"「에...」", TARGET)
				CALL k1011GPC("W", @"「또 안에 정액을 넣는 거야...」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%」를 행복하게 하기 위해, 한 번만 더 버텨보자.", TARGET)
				CALL k1011GP("W", @"안에 넣은 것이 자신이 좋아하는 사람의 체액이라는 점에, 프랑은 여전히 역겨움을 참으며 그것을 삼켰다.")
				K1011FoodMixSemenReaction = 2
				;喜欢拒绝
			ELSEIF accept == 1 && loveSemen
				CALL k1011GPC("W", @"「음......%k1011Name(TARGET, TARGET)%가 어째서 이런 걸 먹고 싶다고 느끼는 거지...」", TARGET)
				CALL k1011GPC("W", @"「안에는 %k1011Name(TARGET, MASTER)%의 정액이 들어있다……」", TARGET)
				CALL k1011GPC("W", @"「안 돼, 너무 무서워. 앞으로는 정액이 섞인 음식을 함부로 먹으면 안 되겠어.」", TARGET)
				CALL k1011GP("W", @"프랑은 허둥지둥 음식을 쏟았다.")
				K1011FoodMixSemenReaction = 3
				;喜欢接受
			ELSEIF accept == 2 && loveSemen
				CALL k1011GPC("W", @"「음... 오늘은 %k1011Name(TARGET, TARGET)%가 어째서 이런 걸 먹고 싶어하는 거지...」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%가 너무 변태적으로 변해버렸어……」", TARGET)
				CALL k1011GPC("W", @"「하지만 음식에 정액을 넣는 변태라면 %k1011Name(TARGET, TARGET)% 같은 변태를 좋아할 것이다.」", TARGET)
				CALL k1011GP("W", @"플란은 음식 속으로 스며든 정액 맛을 음미했다.")
				K1011FoodMixSemenReaction = 4
			ENDIF
			;上次喜欢拒绝
		CASE 3
			;讨厌拒绝
			IF accept == 1 && !loveSemen
				K1011FoodMixSemenReaction = 1
				;讨厌接受
			ELSEIF accept == 2 && !loveSemen
				K1011FoodMixSemenReaction = 2
				;喜欢拒绝
			ELSEIF accept == 1 && loveSemen
				CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%의 정액이군……」", TARGET)
				CALL k1011GPC("W", @"「삼키고 싶어...」", TARGET)
				CALL k1011GP("W", @"푸란이 망설이기 시작한다.")
				CALL k1011GP("L", @"하지만 결국 혀에서 전해오는 미묘한 쾌감을 이겨내고 음식을 토해냈다.")
				CALL k1011GPC("W", @"「안 돼, %k1011Name(TARGET, TARGET)%은 %k1011Name(TARGET, MASTER)%에게 굴복할 수 없어」", TARGET)
				K1011FoodMixSemenReaction = 3
				;喜欢接受
			ELSEIF accept == 2 && loveSemen
				CALL k1011GPC("W", @"「음... 그냥 삼키는 게 어때.」", TARGET)
				CALL k1011GPC("W", @"「파치리는 식량을 낭비하는 것은 좋은 아이가 아니라고 말했다」", TARGET)
				CALL k1011GP("W", @"정액의 유혹을 참지 못한 플란이 정액 덮밥을 음미하기 시작했다.")
				K1011FoodMixSemenReaction = 4
			ENDIF
			;上次喜欢接受
		CASE 4
			;讨厌拒绝
			IF accept == 1 && !loveSemen
				K1011FoodMixSemenReaction = 1
				;讨厌接受
			ELSEIF accept == 2 && !loveSemen
				K1011FoodMixSemenReaction = 2
				;喜欢拒绝
			ELSEIF accept == 1 && loveSemen
				CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%의 정액이군……」", TARGET)
				CALL k1011GPC("W", @"「삼키고 싶어...」", TARGET)
				CALL k1011GP("W", @"푸란이 망설이기 시작한다.")
				CALL k1011GP("W", @"하지만 결국 혀에서 전해오는 미묘한 쾌감을 이겨내고 음식을 토해냈다.")
				CALL k1011GPC("W", @"「안 돼, %k1011Name(TARGET, TARGET)%은 아직 %k1011Name(TARGET, MASTER)%에게 굴복할 수 있어」", TARGET)
				K1011FoodMixSemenReaction = 3
				;喜欢接受
			ELSEIF accept == 2 && loveSemen
				IF RAND:4 == 0 && k1011GetTalent("相爱")
					CALL k1011GPC("W", @"「음......%k1011Name(TARGET, MASTER)%의 체액이 플란체 안으로 들어왔다...」", TARGET)
					CALL k1011GP("W", @"푸란은 소중한 사람의 체액을 먹고 행복한 표정을 지었다.")
				ELSEIF RAND:3 == 0 && k1011GetTalent("亲爱")
					CALL k1011GPC("W", @"「음...... %k1011Name(TARGET, MASTER)%의 정액이 과연 최고의 조미료다」", TARGET)
					CALL k1011GPC("W", @"「정말 맛있다...」", TARGET)
				ELSEIF RAND:2 == 0 && k1011GetTalent("恋慕")
					CALL k1011GPC("W", @"「음... %k1011Name(TARGET, MASTER)%의 맛이야」", TARGET)
					CALL k1011GP("W", @"플란은 자신이 좋아하는 사람의 체액이 몸속으로 들어오는 것에 기뻐했다.")
				ELSE
					CALL k1011GPC("W", @"「음…… %k1011Name(TARGET, MASTER)%의 정액은 여전히 사람을 빠져나올 수 없게 만든다」", TARGET)
					CALL k1011GP("W", @"후란의 몸에 퍼져있던 피로가 혀끝에서 오는 미세한 쾌감으로 모두 씻겨 내려갔다.")
				ENDIF
				K1011FoodMixSemenReaction = 4
			ENDIF
	ENDSELECT
ENDIF
