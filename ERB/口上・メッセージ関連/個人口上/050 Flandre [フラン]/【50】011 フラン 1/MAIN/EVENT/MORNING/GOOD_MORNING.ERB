; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/MORNING/GOOD_MORNING.ERB
;-------------------------------------------
;早晨对话
;-------------------------------------------

@k1011GoodMorning()
#DIMS beforeName
IF K1011Game == "YM"
	beforeName = %k1011Name(TARGET, TARGET)%
ELSE
	beforeName =
ENDIF
;泥酔
IF k1011GetBase("醉意") > MAXBASE:8 * 2
	;疯狂
	IF k1011GetTalent("疯狂")
		IF k1011GetTalent("恋慕") && k1011GetMark("反发刻印") == 0
			CALL k1011P("S", @"%beforeName%「아아아…… 머리가 너무 아프고, 짜증 나……. 와, %k1011Name(TARGET, MASTER)%……」", -1011)
		ELSE
			CALL k1011P("S", @"%beforeName%「아아아... 이 장소... 너무 귀찮네...」",-1011)
		ENDIF
		;非疯狂
	ELSE
		IF k1011GetTalent("恋慕") && k1011GetMark("反发刻印") == 0
			CALL k1011P("S", @"%beforeName%「아……%k1011Name(TARGET, MASTER)%……좋은 아침……같, 같이 %k1011Name(TARGET, TARGET)%………놀, 놀자」",-1011)
		ELSE
			IF k1011GetTalent("恋慕")
				CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%……정말, 정말 귀찮아……」",-1011)
			ELSE
				CALL k1011P("S", @"%beforeName%「아... 오늘은, 오늘 여기서 부숴버리겠어.......」",-1011)
			ENDIF
		ENDIF
	ENDIF
	;恋慕
ELSEIF k1011GetTalent("恋慕")
	;嫉妒(3分の2)触发
	IF k1011GetSetting("病娇") && k1011GetTalent("嫉妒") && RAND:3 < 2
		IF RAND:3 == 0
			CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%……아직도 %k1011Name(TARGET, TARGET)%를 좋아하는 거야……?」",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName%「좋은 아침, %k1011Name(TARGET, MASTER)%…… 또 %k1011Name(TARGET, TARGET)%를 무시할 생각이야?」",-1011)
		ENDIF
		;怀孕(三分之二)
	ELSEIF K1011Game == "YM" && k1011GetTalent("怀孕") && RAND:5 == 0
		IF DAY - K1011PregDay >= 12
			IF RAND:2 == 0
				CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%님! 방금 배가 움직였어. 아기가 아주 기뻐하는 것 같아」",-1011)
			ELSE
				CALL k1011P("S", @"%beforeName%은(는) 「막 일어나서 이렇게 피곤하고, 이대로 %k1011Name(TARGET, MASTER)%와 놀 수 없게 됐어. 어쩌지?」",-1011)
			ENDIF
		ELSEIF DAY - K1011PregDay >= 6
			CALL k1011P("S", @"%beforeName%은/는 「배가 점점 불러와서 이렇게 %k1011Name(TARGET, MASTER)%하고 놀 수가 없어, 어떡하지?」라고 했다.",-1011)
		ELSE
			IF RAND:3 == 0 && EXP:52 == 0
				CALL k1011P("S", @"%beforeName%「이게 임신인가요? %k1011Name(TARGET, MASTER)%…… 아이는 언제 나오나요?」",-1011)
			ELSEIF RAND:2 == 0
				CALL k1011P("S", @"%beforeName%「왜 아기가 성장하는 걸 촉진시킬 마법이 없는 거야, %k1011Name(TARGET, MASTER)%?」",-1011)
			ELSE
				CALL k1011P("S", @"%beforeName%은(는) 「%k1011Name(TARGET, MASTER)%에게 어떻게 해야 빨리 아기를 낳을 수 있을까」라고 물었다.",-1011)
			ENDIF
		ENDIF
		;反发
	ELSEIF RAND:(k1011GetMark("反发刻印") + 1) > 0
		PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 후란에게 인사를 건넸지만, 후란은 차갑게 눈을 흘긴 뒤 입술을 삐죽 내밀고 가버렸다.
		;玩家生日
	ELSEIF k1011GetDay("玩家生日")
		IF RAND:3 == 0 && k1011GetAbl("烹饪技能") >= 3
			CALL k1011P("S", @"%beforeName%은 「생일 축하해, %k1011Name(TARGET, MASTER)%……빨리 일어나렴, 네가 먹을 만한 한 상 차려놨어」라고 말했다.",-1011)
		ELSEIF RAND:2 == 0 && k1011GetAbl("烹饪技能") >= 3
			CALL k1011P("S", @"%beforeName%은(는) 「%k1011Name(TARGET, MASTER)%가 생일 케이크를 먹고 싶어 해, 아니면 장수면을? 둘 다 만들어 줄까?」",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName% 「생일 축하해, %k1011Name(TARGET, MASTER)%♪……%k1011Name(TARGET, TARGET)%의 선물은 어때?」",-1011)
		ENDIF
		;情人节
	ELSEIF k1011GetDay("情人节") && (k1011GetTalent("亲爱") || k1011GetCTalent(1))
		CALL k1011P("S", @"%beforeName%「오늘은 %k1011Name(TARGET, MASTER)%와 %k1011Name(TARGET, TARGET)%을 위해 마련된 기념일이잖아」",-1011)
		;520
	ELSEIF k1011GetDay("5.20")
		CALL k1011P("S", @"%beforeName%「520,%k1011Name(TARGET, MASTER)%♪」",-1011)
		;相爱（４分の１）
	ELSEIF k1011GetTalent("相爱") && RAND:4 == 0
		IF RAND:2 == 0 && 0
			CALL k1011P("S", @"%beforeName%은(는) 「좋은 아침 키스야, %k1011Name(TARGET, MASTER)%♪」라고 한다.",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName%「……하아… %k1011Name(TARGET, TARGET)%, 나랑 조금만 더 같이 자면 안 돼……%k1011Name(TARGET, MASTER)%……」",-1011)
		ENDIF
		;淫乱
	ELSEIF k1011GetTalent("淫乱") && RAND:5 == 0
		IF k1011GetTalent("母乳体质")
			CALL k1011P("S", @"%beforeName%「아침에는 우유를 마셔야 몸이 건강해지지, 어서 %k1011Name(TARGET, TARGET)%의 젖을 맛보렴, %k1011Name(TARGET, MASTER)%」",-1011)
		ELSEIF RAND:3 == 0 && k1011GetTalent("精爱味觉")
			CALL k1011P("S", @"%beforeName%「좋은 하루야, %k1011Name(TARGET, MASTER)%의 성기부터 시작이야... 아키... 일어나자마자 이렇게 커져 있네...」",-1011)
		ELSEIF RAND:2 == 0
			CALL k1011P("S", @"%beforeName%은(는) 「하루의 계획은 아침에 있다. 그래서 아주 이른 시간에 %k1011Name(TARGET, TARGET)%와 사랑을 나누려고 한다♪」",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, TARGET)%아직 한창 자랄 나이니까, 아침에는 %k1011Name(TARGET, MASTER)%특제 우유를 마셔야 해. 얼른 내놔」",-1011)
		ENDIF
		;漏尿癖
	ELSEIF k1011GetTalent("漏尿癖") && RAND:6 == 0
		IF k1011GetAbl("受虐感") > 3
			CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%가 어젯밤에 오줌을 쌌어. 어서 %k1011Name(TARGET, TARGET)%를 때려 줘♪」",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName%「와, 침대에 오줌 쌌다…… 아, %k1011Name(TARGET, MASTER)%가 오고 있어………… 조, 좋은 아침, %k1011Name(TARGET, MASTER)%…………」",-1011)
		ENDIF
		;助手中(２分の１)
	ELSEIF ASSI >= 0 && k1011GetNo(ASSI) == 1011 && RAND:2 == 0
		IF RAND:3 == 0 && EXP:99 > 500
			CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%、%k1011Name(TARGET, TARGET)% 조련사 재능이 있나요?」",-1011)
		ELSEIF RAND:2 == 0 && k1011GetTalent("精爱味觉")
			CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%는 어제 밤새도록 바빴으니까, %k1011Name(TARGET, TARGET)%한테 정액 조금 포상으로 줄 수 있어?」",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%가 좀 더 자게 해 주면 안 돼…… 어제 그렇게 늦게까지 바빴잖아……」",-1011)
		ENDIF
		;除此之外
	ELSE
		SELECTCASE RAND:5
			CASE 4
				CALL k1011P("S", @"%beforeName%「아침이야, %k1011Name(TARGET, MASTER)%♪」",-1011)
			CASE 3
				CALL k1011P("S", @"%beforeName%「좋은 아침이에요, %k1011Name(TARGET, MASTER)%♪」",-1011)
			CASE 2
				CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%, 얼른 일어나서 %k1011Name(TARGET, TARGET)% 솜씨가 어떤지 맛봐」",-1011)
				CALL k1011AddExp("烹饪经验", 1)
			CASE 1
				CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, MASTER)%, 와서 %k1011Name(TARGET, TARGET)%랑 놀아주라♪」",-1011)
			CASEELSE
				CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, MASTER)%는 오늘 아침에 뭐 먹을까?」",-1011)
		ENDSELECT
	ENDIF
	;反发+无恋慕
ELSEIF RAND:(k1011GetMark("反发刻印")+1) > 0
	IF k1011GetMark("反发刻印") == 1
		IF RAND:3 == 0
			CALL k1011P("S", @"%beforeName%은(는) 「아침부터 왜 너랑 마주쳤지? 불길하네」라고 했다.",-1011)
		ELSEIF RAND:2 == 0
			CALL k1011P("S", @"%beforeName%은(는) 「왜 일어나자마자 너를 만나는 거야, 혹시 문밖에서 몰래 훔쳐보고 있었어%k1011Name(TARGET, TARGET)%아?」",-1011)
		ELSE
			CALL k1011P("S", @"%beforeName%은(는) 「가지고 놀아, 너 보고 싶지 않아」",-1011)
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML 원래 세수하려던 플란은 %조사처리(CALLNAME:MASTER,"를")% 보자마자 바로 돌아섰다.
		ELSE
			PRINTFORML 잠든 %조사처리(CALLNAME:MASTER,"는")% 문이 세게 발로 차이는 소리를 듣고 복도 끝에서 자신을 노려보는 플란을 찾았다.
		ENDIF
	ENDIF
	;精爱味觉
ELSEIF k1011GetTalent("淫乱") && RAND:5 == 0
	IF k1011GetTalent("母乳体质")
		CALL k1011P("S", @"「%beforeName% %k1011Name(TARGET, TARGET)% 신선한 모유야, 아침에 짠 거. 맛보고 싶니?」",-1011)
	ELSEIF RAND:3 == 0 && k1011GetTalent("精爱味觉")
		CALL k1011P("S", @"%beforeName%는 「좋은 하루야, %k1011Name(TARGET, MASTER)%의 성기부터 시작이야... 아키... 막 일어났는데 벌써 이렇게 커졌네...」라고 했다.",-1011)
	ELSEIF RAND:2 == 0
		CALL k1011P("S", @"%beforeName%은(는) 「하루 중 계획은 아침에 세우니, 아주 일찍 %k1011Name(TARGET, TARGET)%와 사랑을 해야 해」라고 했다.",-1011)
	ELSE
		CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, TARGET)%아직 한창 자랄 나이니까, 아침에는 우유를 꼭 마셔야 해. %k1011Name(TARGET, MASTER)%특제 우유를 좀 제공해 줄 수 있어?」",-1011)
	ENDIF
	;漏尿癖
ELSEIF k1011GetTalent("漏尿癖")
	IF k1011GetAbl("受虐感") > 3
		CALL k1011P("S", @"%beforeName%「%k1011Name(TARGET, TARGET)%어젯밤에 오줌 쌌어, 얼른 때려%k1011Name(TARGET, TARGET)%줘♪」",-1011)
	ELSE
		CALL k1011P("S", @"%beforeName%「와, 설마 오줌을 싸버렸네…… 큰일 났다, %k1011Name(TARGET, MASTER)%가 왔어………… 아, 안녕, %k1011Name(TARGET, MASTER)%」",-1011)
	ENDIF
ELSE
	IF RAND:4 == 0
		CALL k1011P("S", @"%beforeName% 「아... 아...」",-1011)
	ELSEIF RAND:3 == 0
		CALL k1011P("S", @"%beforeName%「좋은 아침이야…」",-1011)
	ELSEIF RAND:2 == 0 && K1011Game == "YM"
		CALL k1011P("S", @"%beforeName%은(는) 「오늘 나를 돌려보낼 거야?」",-1011)
	ELSE
		CALL k1011P("S", @"%beforeName%은(는) 「오늘 아침엔 무슨 밥이야?」라고 했다.",-1011)
	ENDIF
ENDIF
