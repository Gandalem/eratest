@k1011MasterBirthday
;淫乱
IF RAND:3 == 0 && k1011GetTalent("淫乱")
	CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 방에 들어서자, 작고 귀여운 소녀가 달려들었다.")
	CALL k1011GPC("W", @"「생일 축하해, %k1011Name(TARGET, MASTER)%……♪」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 비로소 오늘이 자신의 생일이고, 최근 일에 치여 바빴으며, 이 일을 거의 잊고 있었다는 것을 떠올렸다.")
	CALL k1011GPC("W", @"「저기……%k1011Name(TARGET, TARGET)%이 %k1011Name(TARGET, MASTER)%에게 줄 선물은…… 바로 %k1011Name(TARGET, TARGET)% 자신이야」", TARGET)
	CALL k1011GP("W", @"이어서 소녀는 단추를 풀면서 %조사처리(CALLNAME:MASTER,"의")% 귓가에 속삭였다.")
	CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)% 마음껏 즐겨♪ 꼭 즐겁게 놀아, %k1011Name(TARGET, MASTER)%……」", TARGET)
	CALL k1011GP("W", @"자신을 즐겁게 하기 위해 필사적으로 유혹하는 플란 양을 보고, %조사처리(CALLNAME:MASTER,"의")% 성욕이 순식간에 치솟았다.")
	;淫乱+烹饪技能5 会产生裸体宴(限ym)
ELSEIF RAND:2 == 0 && k1011GetTalent("淫乱") && k1011GetAbl("烹饪技能") >= 5 && K1011Game == "YM"
	CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 방에 들어서자마자 향긋한 냄새가 풍겨왔고, 프란은 케이크로 가득 찬 호화로운 관 안에 벌거벗은 채 누워 있었다.")
	CALL k1011GP("L", @"인형 같은 육체와 정교하게 디자인된 케이크가 서로의 우아함을 돋보이게 했다.")
	CALL k1011GPC("W", @"「생일 축하해, %k1011Name(TARGET, MASTER)%」", TARGET)
	CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%가 만든 생일 케이크 어때 맛보러 와」", TARGET)
	IF k1011GetTalent("母乳体质") && k1011GetAbl("Ｂ感觉") >= 5
		CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 가슴 위의 정교한 케이크를 입에 넣고, 이빨 자극을 받은 유두가 떨리면서 모유까지 입안으로 분출했다.")
		CALL k1011GP("W", @"어린 소녀만이 가진 달콤한 맛이 가득한 모유가 케이크의 크림 부족한 단점을 보완하며 독특한 풍미를 형성했다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 맛이 어때?」", TARGET)
		CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 우유가 묻은 케이크를 문 입술을 후란의 작은 입에 대어 응답하며, 어린 소녀의 타액으로 케이크를 적셨다.")
		CALL k1011GP("L", @"이어서 두 사람의 타액이 섞인 케이크를 절반 삼키고, 나머지 절반을 어린 소녀의 목구멍으로 밀어 넣었다.")
		CALL k1011GP("W", @"두 사람은 오랫동안 입을 맞춘 후에야 헤어졌고, 반짝이고 투명한 긴 다리 하나를 남겼다.")
		CALL k1011GPC("W", @"「원래 %k1011Name(TARGET, TARGET)%의 모유가 이렇게 맛있는 거였나...... 그때는 모유만으로는 맛이 없을까 걱정했었는데」", TARGET)
		CALL k1011GPC("W", @"「좋아한다면 마음껏 먹어줘, %k1011Name(TARGET, TARGET)%들이 많이 만들었어♪」", TARGET)
		CALL k1011GP("W", @"정교하면서도 음란한 케이크를 바라보자 %조사처리(CALLNAME:MASTER,"의")% 것이 발기했다.")
		PRINTFORML
		CALL k1011AddPalam("欲情", 2000)
		CALL k1011AddPalam("快Ｂ", 9999)
		CALL k1011AddPalam("恭顺", 9999)
		CALL k1011AddJuel("习得", 1000)
		CALL k1011AddExp("喷乳经验", 1)
	ELSE
		CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 음순 위에 붙은 딸기 케이크를 입에 넣었다.")
		CALL k1011GP("W", @"어린 소녀만이 가진 달콤한 맛이 나는 애액과 케이크의 달콤한 맛이 뒤섞여 독특한 풍미를 형성했다.")
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%는 맛이 어때?」", TARGET)
		CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")%(는) 딸기 케이크를 머금은 입술을 플란의 작은 입가에 가져다 대며 응답했고, 어린 소녀의 침으로 케이크를 적셨다.")
		CALL k1011GP("L", @"이어서 두 사람의 타액이 섞인 케이크를 절반 삼키고, 나머지 절반을 어린 소녀의 목구멍으로 밀어 넣었다.")
		CALL k1011GP("W", @"두 사람은 오랫동안 입을 맞춘 후에야 헤어졌고, 반짝이고 투명한 긴 다리 하나를 남겼다.")
		CALL k1011GPC("W", @"「좋아한다면 마음껏 먹어줘, %k1011Name(TARGET, TARGET)%들이 많이 만들었어♪」", TARGET)
		PRINTFORML
		CALL k1011AddPalam("欲情", 2000)
		CALL k1011AddPalam("快Ｖ", 9999)
		CALL k1011AddPalam("恭顺", 9999)
		CALL k1011AddJuel("习得", 1000)
	ENDIF
	CALL k1011SetTequip("裸体宴", 1)
ELSE
	CALL k1011GPC("L", @"「생일 축하해, %k1011Name(TARGET, MASTER)%」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 방에 들어서자, 정성스럽게 포장된 선물 상자를 안고 달려오는 소녀를 보았다.")
	IF k1011GetAbl("制作技能") >= 3
		CALL k1011GP("W", @"열어보니 제작이 정교한 \@ (RAND:2) ? 일용품 # 공예품 \@、上面还刻着\n\n	赠%k1011Name(TARGET, MASTER)%\n			——\@ (k1011GetTalent("相爱")) ? 당신의 사랑하는 아내 # 당신을 사랑하는 플란 \@가 새겨져 있었다.")
		CALL k1011GPC("W", @"「좋아? %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 그 정교한 선물에 망설임 없이 긍정적인 대답을 했다.")
	ELSEIF k1011GetAbl("制作技能") >= 1
		CALL k1011GP("W", @"열어보니 정성껏 만든 \@ (RAND:2) ? 일용품 # 공예품 \@、但是还是有点粗糙、上面歪歪扭扭的刻着\n\n	赠%k1011Name(TARGET, MASTER)%\n			——\@ (k1011GetTalent("相爱")) ? 당신의 사랑스러운 아내 # 당신을 사랑하는 플란 \@")
		CALL k1011GPC("L", @"「그것은... 좀 조잡할지도... 혹시 %k1011Name(TARGET, MASTER)%께서 괜찮으시다면...」", TARGET)
		CALL k1011GP("W", @"플란이 말을 끝내기도 전에 %조사처리(CALLNAME:MASTER,"는")% 소녀를 품에 안고 자신이 본 것 중 가장 멋진 선물이라고 말했다.")
	ELSE
		CALL k1011GP("W", @"열어보니, 정교하게 제작된 \@ (RAND:2) ? 일용품 # 공예품 \@、里面还夹杂着一张纸条\n\n	赠%k1011Name(TARGET, MASTER)%\n			——\@ (k1011GetTalent("相爱")) ? 당신의 사랑하는 아내 # 당신을 사랑하는 프랑 \@")
		CALL k1011GPC("L", @"「좋아? %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 이토록 정성껏 고른 선물에 만족한다고 플란에게 말했다.")
	ENDIF
ENDIF
