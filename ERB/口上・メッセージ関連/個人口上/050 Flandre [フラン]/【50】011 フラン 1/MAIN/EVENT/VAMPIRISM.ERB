; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/VAMPIRISM.ERB
;--------------------------------------------------
;吸血
;--------------------------------------------------

@k1011Vampirism
IF k1011IsVampirism(MASTER)
	CALL k1011GP("W", @"답례로, %조사처리(CALLNAME:MASTER,"는")% 프랑스처럼 희고 가느다란 목을 물었다.")
	CALL k1011AddExp("吸血经验", 1)
ENDIF
CALL k1011AddBase("体力", k1011GetMaxbase("体力") - k1011GetBase("体力"))
CALL k1011AddBase("气力", k1011GetMaxbase("气力") - k1011GetBase("气力"))
CALL k1011AddExp("吸血经验", 1, MASTER)
CALL k1011AddJuel("恭顺", 5000)
CALL k1011AddJuel("欲情", 4000)
CALL k1011AddJuel("习得", 1500)
CALL k1011GWait()
;吸血次数增加
K1011VampirismTimes ++
RETURN 0
;--------------------------------------------------
;吸血致死
;--------------------------------------------------

@k1011VampirismDead
;启用吸血致死
SIF K1011Config:vampirismDie
	CALL k1011BadEnding("k1011BadEnding1")
;--------------------------------------------------
;玩家变吸血鬼
;--------------------------------------------------

@k1011MasterToVampirism()
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 방을 떠나려고 할 때")
CALL k1011GP("W", @"침대에 앉아있는 프랑을 보고, 문득... 이상한 기분을 느꼈다.")
CALL k1011GP("W", @"심장이 빠르게 뛰고, 이성이 점차 자신을 통제할 수 없게 된다.")
CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)%는 왜 그래...?」", TARGET)
CALL k1011GP("W", @"이성을 잃은 %조사처리(CALLNAME:MASTER,"가")% 플랑쨩을 밀쳤다.")
CALL k1011GP("W", @"작은 몸을 꼭 안고, 혀로 그 위를 핥는다.")
CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)%…색적인 일을 하고 싶으신가요? 아아—!」", TARGET)
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 계속해서 플란쨩을 쓰다듬으며, 전혀 자제할 기미가 보이지 않았고 동작도 점차 거칠어졌다.")
CALL k1011GalSetMood("Surprise")
CALL k1011GPC("L", @"「%k1011Sound("Happy", @"啊!哇!♪%k1011Name(TARGET, MASTER)%！！")%」", TARGET)
CALL k1011GalSetMood("")
CALL k1011GP("W", @"비록 이미 플란이 부드러운 몸으로 %조사처리(CALLNAME:MASTER,"를")% 달래고 있었지만")
CALL k1011GP("W", @"그럼에도 불구하고 %조사처리(CALLNAME:MASTER,"의")% 호흡은 여전히 거칠어졌고, 알 수 없는 충동도 멈출 기미가 보이지 않았다.")
CALL k1011GP("W", @"――――")
CALL k1011GP("W", @"--- %조사처리(CALLNAME:MASTER,"는")% 이것이 성욕과는 다른 것임을 알아차렸다.")
CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)%！？」", TARGET)
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 입을 플란 양의 목에 대자, %조사처리(CALLNAME:MASTER,"는")% 언제부터 그렇게 길어진 호랑이 이빨로 플란 양의 깨지기 쉬운 피부를 가볍게 관통했다.")
CALL k1011GPC("L", @"「%k1011Sound("Pain", @"啊!哇!♪%k1011Name(TARGET, MASTER)%！！")%」", TARGET)
CALL k1011GP("W", @"피, 피... 따뜻한 액체가 %조사처리(CALLNAME:MASTER,"의")% 목을 적신다.")
CALL k1011GP("W", @"맛있어")
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 이렇게 맛있는 음료가 있다는 것을 몰랐다.")
CALL k1011GP("W", @"이것만 있으면, 앞으로는 아무것도 먹지도 마시고 마시지도 않아도 된다...")
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 자기 몸의 모든 것이 변하고 있음을 느꼈다.")
CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)%……%k1011Name(TARGET, TARGET)%와 똑같아졌어」", TARGET)
CALL k1011GalSetMood("Love")
CALL k1011GPC("L", @"「음……앞으로는 %k1011Name(TARGET, TARGET)%의 피를 더 많이 흡수해야겠어……」", TARGET)
CALL k1011GalSetMood("")
CALL k1011GP("W", @"프랑은 %조사처리(CALLNAME:MASTER,"의")% 머리를 꼭 안고 부드럽게 쓰다듬었다.")
WAIT
DRAWLINE
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 흡혈귀로 변했다.")
CALL k1011AddExp("吸血经验", 3)
CALL k1011ToVampirism(MASTER)
