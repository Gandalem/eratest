; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/DESTROY.ERB
;--------------------------------------------------
;拆家
;--------------------------------------------------

@k1011Destroy
#DIM costMoney
;8013难度(0简单,不触发)
IF K1011TrainStartFirst:拆家 && K1011Difficult && !K1011PreventDestroy && k1011GetTalent("疯狂")
	DRAWLINE
	;反发3
	IF k1011GetMark("反发刻印") == 3
		IF RAND:3 == 0
			;扣体力最大值
			CALL k1011AddMaxbase("体力", - (50 + RAND:50))
			;扣体力
			CALL k1011AddBase("体力", - (250 + RAND:200))
			costMoney = MIN(MONEY / 4, 200000)
			MONEY -= costMoney
			CALL k1011GP("L", @" 방이 거의 절반이나 파괴되었고, 수리하는 데 ${costMoney}가 들 것으로 예상된다.")
			CALL k1011GP("L", @" 푸란의 손은 피투성이였고, 언제 기력이 다했는지 모른 채 부상을 입었다.")
		ELSEIF RAND:2 == 0
			;扣体力最大值
			CALL k1011AddMaxbase("体力", - (20 + RAND:30))
			;扣体力
			CALL k1011AddBase("体力", - (100 + RAND:200))
			costMoney = MIN(MONEY / (4 + RAND:4), 100000)
			MONEY -= costMoney
			CALL k1011GP("L", @" 방의 벽에 금이 가 있어서 수리비로 ${costMoney}가 들 것이다.")
			CALL k1011GP("L", @" 프랑의 손이 다쳤고, 체력도 감소했다.")
		ELSE
			;扣体力最大值
			CALL k1011AddMaxbase("体力", - (40 + RAND:40))
			;扣体力
			CALL k1011AddBase("体力", - (400 + RAND:100))
			CALL k1011GP("L", @" 플란은 몸이 온통 상처투성이였다.")
			CALL k1011GP("L", @" 자신의 몸에 묻은 핏자국을 보고, 플란은 마침내 진정했다.")
		ENDIF
		PRINTL 　
		CALL k1011GP("W", @" 도저히 손댈 수가 없다. 그녀 자신을 위해서, 아니면 그녀를 잘 아는 사람에게 맡기는 게 더 좋을 것이다.")
	ELSEIF k1011GetMark("反发刻印") == 2
		IF RAND:2 == 0
			;扣体力最大值
			CALL k1011AddMaxbase("体力", - (10 + RAND:15))
			;扣体力
			CALL k1011AddBase("体力", - (100 + RAND:50))
			costMoney = MIN(MONEY / (13 + RAND:7), 50000)
			MONEY -= costMoney
			CALL k1011GP("L", @" 골목 곳곳에 소란을 피운 흔적이 있다. 만약을 대비해, 말로 ${costMoney}를 써서 수습할 필요가 있다.")
			CALL k1011GP("W", @" 프랑이 부상을 입었고, 체력이 바닥났다.")
		ELSE
			;扣体力最大值
			CALL k1011AddMaxbase("体力", - (5 + RAND:15))
			;扣体力
			CALL k1011AddBase("体力", - (50 + RAND:100))
			costMoney = MIN(MONEY / (20 + RAND:5), 50000)
			MONEY -= costMoney
			CALL k1011GP("L", @" 방의 벽에 균열이 생겼다. 수리비는 ${costMoney}가 들 것이다.")
			CALL k1011GP("W", @" 프랑의 손이 다쳤고, 체력도 감소했다.")
		ENDIF
		IF RAND:4 == 0
			CALL k1011GP("W", @" 좀 까다로워 보인다. 그녀를 진정시킬 방법을 생각해내면 좋겠다.")
		ENDIF
	ELSEIF k1011GetMark("反发刻印") == 1
		;扣体力最大值
		CALL k1011AddMaxbase("体力", - (5 + RAND:10))
		;扣体力
		CALL k1011AddBase("体力", - (50 + RAND:80))
		costMoney = MIN(MONEY / (25 + RAND:5), 10000)
		MONEY -= costMoney
		CALL k1011GP("L", @" 방 안의 물건이 몇 개 망가졌고, 수리비로 ${costMoney}를 써야 한다.")
		CALL k1011GP("W", @" 프랑의 손이 다쳤고, 체력도 감소했다.")
	ELSEIF k1011GetMark("反发刻印") == 0
		IF RAND:2
			;扣体力
			CALL k1011AddBase("体力", 200)
			CALL k1011GP("W", @" 프랑은 약간의 부상을 입었는데, 보기에는 스스로 만든 상처인 것 같다.")
		ENDIF
	ENDIF
ENDIF
