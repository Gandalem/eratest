					CALL k1011GP("W", @"예상했던 대로, 호기심 가득 플란이 달려왔다.")
					CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 선물을 플란의 품에 안겨주며 생일 축하를 전했다.")
					CALL k1011GPC("L", @"「이건… %k1011Name(TARGET, TARGET)%한테 주는 거……? 아, 맞다. 오늘은 %k1011Name(TARGET, TARGET)%의 생일이네♪」", TARGET)
					CALL k1011GP("W", @"들뜬 플란은 선물을 안고 방 안을 뛰어다녔다.")
				ENDIF
				PRINTL
				CALL k1011GP("L", @"플란이 행복하게 웃는 모습을 보자, %조사처리(CALLNAME:MASTER,"는")% 알 수 없는 행복감을 느꼈다.")
				CALL k1011GP("W", @"플란과 생일을 보내는 것이 확실히 옳은 선택인 것 같다.")
				;加点数
				CALL k1011AddLikability(LIMIT(k1011GetCflag("好感") / 20, 10, 10000))
				;困难模式处理
				IF K1011Difficult >= 3
					IF K1011Difficult:自杀判定 >= 150 || K1011Difficult:暴走判定 >= 150
						PRINTL
						CALL k1011GP("W", @"후란의 마음속에 있던 %CALLNAME:MASTER%에 대한 분노와 불만은 선물 받은 기쁨으로 희석되었다.")
					ENDIF
					K1011Difficult:自杀判定 = LIMIT(K1011Difficult:自杀判定 - 70, 0, 999999)
					K1011Difficult:暴走判定 = LIMIT(K1011Difficult:暴走判定 - 70, 0, 999999)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	;过生日次数+1
	K1011FlanBirthdayTimes += 1
ENDIF
;--------------------------------------------------
;芙兰惊喜派对追加
;--------------------------------------------------

@k1011DSupBirthdayForFlan
#DIM index
#DIMS DYNAMIC names
VARSET LOCAL, 0
;惊喜派对人物计数
CALL k1011SupriseBirthdayForFlanCheck
LOCAL = RESULT:0
FOR index, 0, LOCAL
LOCAL:(index+1) = RESULT:(index+1)
names += @"、%CALLNAME:(LOCAL:(index+1))%"
NEXT
CALL k1011GP("L", @"저녁 무렵, 플란은 홀로 방 안에 기다리고 있었다.")
CALL k1011GPC("W", @"「다들 %k1011Name(TARGET, TARGET)%의 생일을 잊어버렸나…….」", TARGET)
IF k1011GetTalent("相爱")
	CALL k1011GPC("W", @"「당신이 %k1011Name(TARGET, MASTER)%조차 생각나지 않았다……」", TARGET)
ELSEIF k1011GetTalent("亲爱")
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%가 %k1011Name(TARGET, TARGET)%와 함께 생일을 보내 줬으면 좋겠는데……」", TARGET)
ENDIF
CALL k1011GWait()
CALL k1011GP("W", @"정당한 소녀가 실망했을 때, 갑자기 문밖에서 노크 소리가 들려왔다.")
CALL k1011GP("L", @"문을 열어보니, 케이크를 안고 있는 %CALLNAME:MASTER%였다.")
CALL k1011GP("W", @"미리 준비한 노예들도 어둠 속에서 나와 함께 플란에게 생일 축하한다고 말했다.")
CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%%names%……%k1011Name(TARGET, TARGET)%은 절대 잊지 않을 거라는 걸 알고 있었어」", TARGET)
CALL k1011GP("L", @"소녀는 사람들이 있는 곳으로 달려가, 선물을 안고 행복한 미소를 지었다.")
IF K1011FirstSupBirthday == 0
	CALL k1011GWait()
	CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%은 이것이 깜짝 생일 파티라고 알고 있다」", TARGET)
	CALL k1011GPC("L", @"「예전에 그 친구가 그녀를 위해 파티를 열었을 때, %k1011Name(TARGET, TARGET)%는 특히 부러워했다」", TARGET)
	CALL k1011GPC("L", @"「하지만 오늘 %k1011Name(TARGET, TARGET)%도 경험했다」", TARGET)
	CALL k1011GPC("W", @"「이것은 %k1011Name(TARGET, TARGET)%가 보낸 최고의 생일이다」", TARGET)
	K1011FirstSupBirthday = 1
ENDIF
IF K1011RefuseBirthdayGift
	PRINTL
	CALL k1011GP("L", @"플란이 행복하게 웃는 모습을 보자, %조사처리(CALLNAME:MASTER,"는")% 알 수 없는 행복감을 느꼈다.")
	CALL k1011GP("W", @"플란과 생일을 보내는 것이 확실히 옳은 선택인 것 같다.")
	K1011RefuseBirthdayGift = 0
ENDIF
;加点数
CALL k1011AddRelation, TARGET, MASTER, 10 + RAND:40
FOR index, 0, LOCAL
CALL k1011AddRelation, TARGET, LOCAL:(index + 1), 10 + RAND:40
NEXT
;困难模式处理
IF K1011Difficult >= 4
	IF K1011Difficult:自杀判定 >= 150 || K1011Difficult:暴走判定 >= 150
		PRINTL
		CALL k1011GP("W", @"플란은 마음속의 %CALLNAME:MASTER%에 대한 분노와 불만을 행복으로 대체했다.")
	ENDIF
	K1011Difficult:自杀判定 = LIMIT(K1011Difficult:自杀判定 - 100 * (k1011GetTalent("恋慕") + k1011GetTalent("亲爱")), 0, 999999)
	K1011Difficult:暴走判定 = LIMIT(K1011Difficult:暴走判定 - 100 * (k1011GetTalent("恋慕") + k1011GetTalent("亲爱")), 0, 999999)
ENDIF
;-------------------------------------------
;不参加芙兰生日
;-------------------------------------------

@k1011DFNotJoinBirthday
CALL k1011GP("L", @"정당%조사처리(CALLNAME:MASTER,"가")% 잠자리에 들 준비를 하고 있을 때, 플란이 갑자기 쳐들어왔다.")
CALL k1011GPC("W", @"「죄송합니다, %k1011Name(TARGET, MASTER)%……」", TARGET)
CALL k1011GPC("W", @"「지난번에 %k1011Name(TARGET, TARGET)%가 잘못했어……」", TARGET)
CALL k1011GPC("W", @"「오늘은 %k1011Name(TARGET, TARGET)%의 생일이네……」", TARGET)
CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%은 이제 혼자 생일을 보내고 싶지 않아, %k1011Name(TARGET, MASTER)%가 %k1011Name(TARGET, TARGET)%을 용서해 줄래?」", TARGET)
CALL k1011GP("SL", @"프랑을 기대와 불안이 뒤섞인 작은 눈빛으로 바라보는 %조사처리(CALLNAME:MASTER,"는")% 결정했다.")
CALL k1011GSetQ("离開", "她都已经道歉了、况且这孩子也很可怜")
CALL k1011GInput()
IF RESULT == 0
	CALL k1011GP("W", @"갈수록 화가 나는 %조사처리(CALLNAME:MASTER,"는")% 스스로 잠자리에 들겠다고 플란에게 말했다.")
	CALL k1011GPC("L", @"「하지만, %k1011Name(TARGET, MASTER)%……」", TARGET)
	CALL k1011GP("W", @"플란이 말을 마치기도 전에 %조사처리(CALLNAME:MASTER,"는")% 일어나 플란을 문밖으로 밀어냈다.")
	PRINTL
	CALL k1011GP("W", @"홀로 남은 소녀의 시야가 점차 흐려졌다.")
	CALL k1011GP("W", @"몸이 갑자기 힘을 잃은 듯, 끊어진 인형처럼 %조사처리(CALLNAME:MASTER,"의")% 문 앞에 쓰러졌다.")
	CALL k1011GPC("L", @"「……%k1011Name(TARGET, MASTER)%는 어찌할 수 있단 말인가……」", TARGET)
	CALL k1011GP("W", @"소녀는 말을 하다가 중간에 삼켰다. 모든 일의 원인이 자신에게 있는 것이 아닌가?")
	CALL k1011GPC("L", @"「……흐윽……응, 응, 응……………」", TARGET)
ELSEIF RESULT == 1
	CALL k1011GP("L", @"프랑의 간청에, %조사처리(CALLNAME:MASTER,"는")% 결국 남아 프랑과 함께했다.")
	CALL k1011GPC("L", @"「역시 %k1011Name(TARGET, TARGET)%은 %k1011Name(TARGET, MASTER)%가 %k1011Name(TARGET, TARGET)%을 용서해 줄 줄 알았어」", TARGET)
	CALL k1011GPC("L", @"「%k1011Name(TARGET, MASTER)% 최고다♪」", TARGET)
	CALL k1011GP("L", @"프랑은 작은 고양이처럼 %조사처리(CALLNAME:MASTER,"의")% 품에 몸을 비볐다.")
	IF K1011RefuseBirthdayGift
		PRINTL
		CALL k1011GP("L", @"플란이 행복하게 웃는 모습을 보자, %조사처리(CALLNAME:MASTER,"는")% 알 수 없는 행복감을 느꼈다.")
		CALL k1011GP("W", @"플란과 생일을 보내는 것이 확실히 옳은 선택인 것 같다.")
		K1011RefuseBirthdayGift = 0
	ENDIF
ENDIF
