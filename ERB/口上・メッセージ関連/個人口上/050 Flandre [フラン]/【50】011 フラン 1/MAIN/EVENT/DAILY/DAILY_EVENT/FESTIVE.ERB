@k1011DFMasterBirthday
;惊喜派对
CALL k1011SupriseBirthdayForMasterCheck
IF RAND:3 == 0 && RESULT && K1011Game == "YM"
	CALL k1011GP("W", @"왠지 모르게 오늘 푸른이 좀 이상하다고, 계속 %조사처리(CALLNAME:MASTER,"를")% 피하고 있었다.")
	CLEARLINE 1
	;掉回普通时间
	TRYCALL k1011NormallyDayEvent
	;对玩家的惊喜派对追加
	K1011DayEndEvent = 2
	;淫乱
ELSEIF RAND:2 == 0 && k1011GetTalent("淫乱")
	LOCAL = RAND:((k1011GetBase("体力") + k1011GetBase("体力", MASTER)) / 500) + 2
	CALL k1011GP("L", @"드디어 손에 들고 있던 일을 끝내고 %조사처리(CALLNAME:MASTER,"가")% 의자에 앉자 뒤에서 한 소녀가 튀어나왔다.")
	CALL k1011GPC("W", @"「생일 축하해, %k1011Name(TARGET, MASTER)%……♪」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 비로소 오늘이 자신의 생일이고, 최근 일에 치여 바빴으며, 이 일을 거의 잊고 있었다는 것을 떠올렸다.")
	CALL k1011GPC("W", @"「저기……%k1011Name(TARGET, MASTER)%에게 줄 %k1011Name(TARGET, TARGET)%의 선물은…… 바로 %k1011Name(TARGET, TARGET)% 자신이야♪」", TARGET)
	CALL k1011GP("W", @"이어서 소녀는 단추를 풀면서 %조사처리(CALLNAME:MASTER,"의")% 귓가에 속삭였다.")
	CALL k1011GPC("L", @"「마음껏 즐겨줘 플랑이지♪ 꼭 재미있게 놀아야 해, %k1011Name(TARGET, MASTER)%……」", TARGET)
	CALL k1011GP("W", @"자신을 즐겁게 하기 위해 필사적으로 유혹하는 플란 양을 보고, %조사처리(CALLNAME:MASTER,"의")% 성욕이 순식간에 치솟았다.")
	CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 플란을 침대에 눕히고, 플란은 %조사처리(CALLNAME:MASTER,"에게")% 마음대로 휘둘린다.")
	CALL k1011GP("W", @"두 사람은 {LOCAL}번을 하고 나서야 멈췄다.")
	PRINTL
	;加好感
	CALL k1011AddLikability(LIMIT(LOCAL * k1011GetCflag("好感") / 100, 100, 10000))
	CALL k1011AddJuel("恭顺", LOCAL * 1000)
	CALL k1011AddJuel("欲情", LOCAL * 1000)
	CALL k1011AddExp("精液经验", LOCAL)
	WAIT
ELSE
	CALL k1011GPC("L", @"「생일 축하해, %k1011Name(TARGET, MASTER)%」", TARGET)
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"의")% 방 문이 갑자기 열리더니, 선물 상자를 안은 소녀가 「타다다닥」 달려왔다.")
	CALL k1011GP("W", @"소녀는 부끄러워하며 선물 상자를 %조사처리(CALLNAME:MASTER,"에게")% 건넸다.")
	CALL k1011GPC("L", @"「그게…… 좋아해, %k1011Name(TARGET, MASTER)%?」", TARGET)
	IF k1011GetAbl("制作技能") >= 3
		CALL k1011GP("W", @"열어보니 제작이 정교한 \@ (RAND:2) ? 일용품 # 공예품 \@、上面还刻着\n\n	赠%k1011Name(TARGET, MASTER)%\n			——\@ (k1011GetTalent("相爱")) ? 당신의 사랑하는 아내 # 당신을 사랑하는 플란 \@가 새겨져 있었다.")
		PRINTFORMW
		CALL k1011GPC("W", @"「좋아? %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 그 정교한 선물에 망설임 없이 긍정적인 대답을 했다.")
	ELSEIF k1011GetAbl("制作技能") >= 1
		CALL k1011GP("W", @"열어보니 정성껏 만든 \@ (RAND:2) ? 일용품 # 공예품 \@、但是还是有点粗糙、上面歪歪扭扭的刻着\n\n	赠%k1011Name(TARGET, MASTER)%\n			——\@ (k1011GetTalent("相爱")) ? 당신의 사랑스러운 아내 # 당신을 사랑하는 플란 \@")
		PRINTFORMW
		CALL k1011GPC("L", @"「그것은... 좀 조잡할지도... 혹시 %k1011Name(TARGET, MASTER)%께서 괜찮으시다면...」", TARGET)
		CALL k1011GP("W", @"플란이 말을 끝내기도 전에 %조사처리(CALLNAME:MASTER,"는")% 소녀를 품에 안고 자신이 본 것 중 가장 멋진 선물이라고 말했다.")
	ELSE
		CALL k1011GP("W", @"열어보니, 정교하게 제작된 \@ (RAND:2) ? 일용품 # 공예품 \@、里面还夹杂着一张纸条\n\n	赠%k1011Name(TARGET, MASTER)%\n			——\@ (k1011GetTalent("相爱")) ? 당신의 사랑하는 아내 # 당신을 사랑하는 프랑 \@")
		PRINTL
		CALL k1011GPC("L", @"「좋아? %k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 이토록 정성껏 고른 선물에 만족한다고 플란에게 말했다.")
	ENDIF
	PRINTL
	CALL k1011AddLikability(LIMIT(k1011GetCflag("好感") / 100, 100, 10000))
	GETPALAMLV k1011GetJuel("恭顺"), 10
	CALL k1011AddJuel("恭顺", (RESULT + 1) * 100)
	;亲手制作的增加制作经验
	IF k1011GetAbl("制作技能") >= 1
		GETPALAMLV k1011GetJuel("习得"), 10
		CALL k1011AddJuel("习得", (RESULT + 1) * 100)
	ENDIF
	WAIT
ENDIF
;--------------------------------------------------
;玩家惊喜派对追加
;--------------------------------------------------

@k1011DSupBirthdayForMaster
#DIM index
#DIMS DYNAMIC names
VARSET LOCAL, 0
;惊喜派对人物计数
CALL k1011SupriseBirthdayForMasterCheck
LOCAL = RESULT:0
FOR index, 0, LOCAL
LOCAL:(index+1) = RESULT:(index+1)
names += @"、%CALLNAME:(LOCAL:(index+1))%"
NEXT
CALL k1011GP("L", @"하루 종일 바빴던 %조사처리(CALLNAME:MASTER,"는")% 우연히 달력을 보았다.")
CALL k1011GP("W", @"아, 오늘이 자신의 생일이었구나")
CALL k1011GP("L", @"나 스스로 매일 바쁘게 지내다 보니 이 사실을 다 잊어버렸다.")
CALL k1011GP("W", @"아마 아무도 이 일을 기억하지 않을 테니, 생일은 그냥 이렇게 넘기자.")
CALL k1011GWait()
CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 외출 준비로 세수하고 잠자리에 들려 할 때, 방 구석에서 갑자기 색종이가 쏟아져 나왔다.")
CALL k1011GPC("L", @"「생일 축하해, %k1011Name(TARGET, MASTER)%♪」", TARGET)
CALL k1011GP("W", @"소리를 따라 가보니 플란과 몇몇 노예들이 각양각색의 생일 선물 상자들을 안고 있었고, 가운데에는 생일 케이크가 있었다.")
;TODO不同奴隶不同对话
PRINTL
CALL k1011GP("W", @"파티에 참석한 노예는 플란%names%다.")
CALL k1011GWait()
;加点数
CALL k1011AddLikability(LIMIT(k1011GetCflag("好感") / 20, 10, 10000))
CALL k1011AddJuel("恭顺", LIMIT(k1011GetJuel("恭顺") / 20, 10, 10000))
FOR index, 0, LOCAL
CALL k1011AddLikability(LIMIT(k1011GetCflag("好感", index) / 20, 10, 10000), index)
CALL k1011AddJuel("恭顺", LIMIT(k1011GetJuel("恭顺", index) / 20, 10, 10000), index)
NEXT
WAIT
;--------------------------------------------------
;芙兰生日
;--------------------------------------------------

@k1011DFBirthdayFlan
CALL k1011GP("W", @"오늘은 플란의 생일인 것 같다.")
;初次
IF !K1011FlanBirthdayTimes
	;恋慕
	IF k1011GetTalent("恋慕")
		;通用開头
		IF k1011GetTalent("相爱")
			CALL k1011GP("W", @"자기 자신과 가장 관계가 좋은 아내의 생일이니, %조사처리(CALLNAME:MASTER,"는")% 당연히 무언가를 해야 한다.")
		ELSE
			CALL k1011GP("W", @"플란이 평소 자신을 매우 사랑하는 것을 알고, %조사처리(CALLNAME:MASTER,"는")% 플란에게 생일을 축하해 주기로 한다.")
		ENDIF
		;惊喜派对判定
		CALL k1011SupriseBirthdayForFlanCheck
		IF RESULT:0
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 조용히 정성껏 준비한 케이크를 몰래 숨기고, 다른 노예들에게 깜짝 파티를 준비하라고 통지했다.")
			CALL k1011GP("W", @"그 후 플랜 앞에서 평소와 같은 생활을 시작했다.")
			;惊喜派对
			K1011DayEndEvent = 1
		ELSE
			CALL k1011GP("W", @"준비를 마친 후, %조사처리(CALLNAME:MASTER,"는")% 정성껏 준비한 생일 선물을 들고 플란의 방으로 들어갔다.")
			CALL k1011GPC("W", @"「와, 정말 예쁜 선물 상자네」", TARGET)
			CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 선물 상자를 플란에게 건네며 생일 축하를 해준다.")
			SIF k1011GetMark("恐怖刻印")
				CALL k1011GPC("W", @"「이건…… %k1011Name(TARGET, TARGET)%에게 주는 거야? %k1011Name(TARGET, MASTER)%?」", TARGET)
			CALL k1011GPC("W", @"「알고 보니 이게 생일 선물이었구나. 예전에 많은 사람이 저 사람에게 생일 선물을 주는 걸 봤었는데, %k1011Name(TARGET, TARGET)%도 정말 갖고 싶어 했었지……」", TARGET)
			CALL k1011GPC("W", @"「하지만 그 녀석은%k1011Name(TARGET, TARGET)%좀 더 큰 푸딩 하나를...」", TARGET)
			CALL k1011GPC("L", @"「오늘 %k1011Name(TARGET, TARGET)%에게도 생일 선물이 있네♪」", TARGET)
			CALL k1011GP("W", @"플란은 선물을 품에 안고 행복한 미소를 지었다.")
			CALL k1011GPC("W", @"「이것은 %k1011Name(TARGET, TARGET)%에게 있어 역대 가장 멋진 생일이야♪」", TARGET)
			;加相性
			CALL k1011AddRelation, TARGET, MASTER, 10 + RAND:40
			;困难模式处理
			IF K1011Difficult >= 4
				IF K1011Difficult:自杀判定 >= 150 || K1011Difficult:暴走判定 >= 150
					PRINTL
					CALL k1011GP("W", @"플란은 마음속의 %CALLNAME:MASTER%에 대한 분노와 불만을 행복으로 대체했다.")
				ENDIF
				K1011Difficult:自杀判定 = LIMIT(K1011Difficult:自杀判定 - 100 * (k1011GetTalent("恋慕") + k1011GetTalent("亲爱")), 0, 999999)
				K1011Difficult:暴走判定 = LIMIT(K1011Difficult:暴走判定 - 100 * (k1011GetTalent("恋慕") + k1011GetTalent("亲爱")), 0, 999999)
			ENDIF
		ENDIF
	ELSE
		IF k1011GetMark("反发刻印")
			CALL k1011GP("W", @"준비를 마친 후, %조사처리(CALLNAME:MASTER,"는")% 정성껏 준비한 생일 선물을 들고 플란의 방으로 들어갔다.")
			CALL k1011GP("L", @"원래 관계가 서먹했던 플랜은 정교한 선물 상자를 보자 눈이 번쩍 뜨였다. 역시 이 디자인은 아이들의 마음을 사로잡는 데 능하다.")
			CALL k1011GP("W", @"어쩌면 이것은 플란과의 관계를 개선할 기회일지도 모른다.")
			IF k1011GetMark("反发刻印") == 3
				CALL k1011GP("L", @"하지만 %조사처리(CALLNAME:MASTER,"가")% 선물 상자를 플란에게 건네주었을 때……")
				CALL k1011GPC("W", @"「네가 잘못 기억했어. 오늘은 %k1011Name(TARGET, TARGET)%의 생일이 아니야. 선물은 돌려주렴」", TARGET)
				CALL k1011GP("L", @"아무리 그래도, 플란은 %조사처리(CALLNAME:MASTER,"의")% 선물을 받아들이려 하지 않는다.")
				CALL k1011GP("W", @"실망한 %조사처리(CALLNAME:MASTER,"는")% 결국 선물을 거두고 일상으로 돌아갔다.")
				;困难模式处理
				IF K1011Difficult >= 3
					IF K1011Difficult:自杀判定 >= 150 || K1011Difficult:暴走判定 >= 150
						PRINTL
						CALL k1011GP("W", @"비록 플란은 선물을 받지는 않았지만, 마음속에서 %CALLNAME:MASTER%에 대한 분노와 불만은 조금 가라앉았다.")
					ENDIF
					K1011Difficult:自杀判定 = LIMIT(K1011Difficult:自杀判定 - 30, 0, 999999)
					K1011Difficult:暴走判定 = LIMIT(K1011Difficult:暴走判定 - 30, 0, 999999)
				ENDIF
				;拒绝过生日
				K1011RefuseBirthdayGift = 1
			ELSE
				CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 선물을 플랑에게 건넬 때, 플랑은 한참 망설이다가 결국 받았다.")
				CALL k1011GPC("W", @"「……고마워」", TARGET)
				IF k1011GetMark("反发刻印") == 1 && k1011GetMark("恐怖刻印") == 0 && CFLAG:好感度 > 800
					CALL k1011GPC("W", @"「사실, 이건 %k1011Name(TARGET, TARGET)%이 받은 첫 번째 생일 선물이야...」", TARGET)
					CALL k1011GPC("L", @"「예전에는...... 그놈만이 %k1011Name(TARGET, TARGET)%에게 생일을 챙겨줬었지……」", TARGET)
					CALL k1011GPC("L", @"「하지만 그냥 좀 더 큰 푸딩 하나 넣고 가버렸을 뿐이야……」", TARGET)
					CALL k1011GPC("L", @"「...」", TARGET)
					CALL k1011GPC("L", @"「......」", TARGET)
					CALL k1011GPC("L", @"「.........」", TARGET)
					CALL k1011GP("W", @"장벽이 해소된 플란은 %조사처리(CALLNAME:MASTER,"에게")% 자신이 495년간 느낀 고통을 토로했다.")
					CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%와 생일을 함께 보내줄 수 있어서 정말 기뻤다」", TARGET)
					CALL k1011GPC("W", @"「이것은 %k1011Name(TARGET, TARGET)%에게 있어 역대 가장 멋진 생일이야♪」", TARGET)
					PRINTL
					;恋慕
					CALL k1011GetLove()
					WAIT
				ENDIF
				;加点数
				;困难模式处理
				IF K1011Difficult >= 3
					IF K1011Difficult:自杀判定 >= 150 || K1011Difficult:暴走判定 >= 150
						PRINTL
						CALL k1011GP("W", @"후란의 마음속에 있던 %CALLNAME:MASTER%에 대한 분노와 불만은 선물 받은 기쁨으로 희석되었다.")
					ENDIF
					K1011Difficult:自杀判定 = LIMIT(K1011Difficult:自杀判定 - 50, 0, 999999)
					K1011Difficult:暴走判定 = LIMIT(K1011Difficult:暴走判定 - 50, 0, 999999)
				ENDIF
				PRINTL 플랜의 반발 각인이 낮아졌다.
				CALL k1011AddMark("反发刻印", -1)
			ENDIF
			;普通
		ELSE
			IF k1011GetMark("恐怖刻印") > 1
				CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 정성껏 준비한 생일 선물을 들고 방으로 들어갔다.")
				CALL k1011GP("W", @"하지만 플란은 겁에 질려 온몸을 떨며 몸을 웅크렸지만, 화려한 선물 상자를 본 후 용기를 내어 머리를 내밀었다.")
				CALL k1011GPC("W", @"「이게... 뭐지...?」", TARGET)
				CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 부드럽게 이것이 선물 상자이고 안에 생일 선물이 들어있다고 소개하며, 선물 상자를 플란 쪽으로 내밀었다.")
				CALL k1011GP("W", @"하지만 이 일은 여전히 프랑을 움찔하게 했다.")
				CALL k1011GPC("W", @"「아…… 안 돼, 때리지 마%k1011Name(TARGET, TARGET)%, %k1011Name(TARGET, TARGET)%, 잘못했어……」", TARGET)
				CALL k1011GP("W", @"생일 축하한다는 말을 듣자, 플란은 조심스럽게 눈을 떴다.")
				CALL k1011GPC("W", @"「이, 이건 …… %k1011Name(TARGET, TARGET)%에게 주는 건가요……?」", TARGET)
				CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이는 것을 본 후에, 플란이 선물 상자를 받았다.")
				CALL k1011GPC("W", @"「와, 정말 예쁘다. 이게 생일 선물인가?」", TARGET)
				CALL k1011GPC("W", @"「%k1011Name(TARGET, TARGET)%에게도 생일 선물이 있구나♪」", TARGET)
			ELSE
				CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 정성껏 준비한 생일 선물을 들고 방으로 들어갔다.")
				CALL k1011GPC("L", @"「이건 뭐야? %k1011Name(TARGET, TARGET)%이 볼 수 있어?」", TARGET)
				CALL k1011GP("W", @"예상했던 대로, 호기심 가득 플란이 달려왔다.")
				CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 선물을 플란의 품에 안겨주며 생일 축하를 전했다.")
