; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/DAILY/NIGHT_EVENT/GENERAL.ERB
;肉棒过家家

@k1011NHPlayHouse
CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 침대에 누워 잠을 청하려 할 때, 성기가 따뜻한 촉감에 감싸여 발기했다.")
CALL k1011GP("W", @"아, 플란쨩의 작은 손이구나")
CALL k1011GP("W", @"가끔 천진난만한 미소를 짓는 어린 소녀가 아직 성기만 한 작은 손으로 위쪽의 리본을 살짝 감쌌다.")
;喜欢芙兰
IF k1011Love()
	CALL k1011GP("L", @"저 어린 소녀, 꽤 즐겁게 노는 것 같네. 어차피 장난치기 좋아하는 나이잖아. 그냥 그렇게 놀게 두자.")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 그런 생각을 하며 눈을 감았다.")
	CALL k1011GSleep()
	CALL k1011GPC("L", @"「응, 다 됐어」", TARGET)
	CALL k1011GPC("L", @"「역시 육봉 선생님이 만지기에 딱이다」", TARGET)
	CALL k1011GPC("W", @"「이렇게 보니까 멋있고 생기가 넘치잖아」", TARGET)
	CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"는")% 살짝 눈을 뜨고 훔쳐봤다.")
	CALL k1011GP("W", @"어린 소녀가 자랑스럽게 자신의 걸 감상했다. — 나비넥타이를 맨 성기")
	CALL k1011GPC("L", @"「신랑 복장은 다 됐고, 이제 신부 차례야.」", TARGET)
	CALL k1011GP("W", @"어린 소녀는 혼자 중얼거리면서 치마를 들었는데, 알고 보니 속이 비어있었다.")
	CALL k1011GP("L", @"뚱뚱한 것의 보호를 벗어난, 나비가 묶인 후타의 육봉이 그대로 허공에 노출되었다.")
	CALL k1011GP("L", @"사랑하는 이의 남성적인 기운을 느꼈는지, 퍼타 육봉이 이전 음핵으로서의 역할을 잘 발휘했다.")
	CALL k1011GP("L", @"어린 소녀 같은 혈액이 점차 아래쪽으로 몰리고, 남성의 성기가 흔들리며 공중에 서 있었다.")
	CALL k1011GP("W", @"원래 괜찮았던 나비 장식도 성기의 발기 때문에 벌어져 미끄러져 떨어졌다.")
	CALL k1011GPC("L", @"「아, 육봉 아가씨는 육봉 신사님을 보자마자 그녀의 영실함에 마음을 빼앗겨 옷을 벗어버렸다」", TARGET)
	CALL k1011GPC("W", @"「보아하니 육봉선생님은 정말 매력이 넘치시네요」", TARGET)
	CALL k1011GPC("L", @"「그럼 우리는 직접 결혼식의 마지막 단계로 들어가자—」", TARGET)
	CALL k1011GPC("W", @"「음란한 사내와 음란한 아가씨의 밀착」", TARGET)
	CALL k1011GP("W", @"순진함과 성적 흥분이 뒤섞인 표정의 어린 소녀가 이상한 리본으로 묶인 두 개의 남성기를 잡고 끊임없이 문지르며, 가쁜 숨소리를 내어 둘의 「결혼」을 설명했다.")
	CALL k1011GP("W", @"하지만 말할 수 없이, 어린 소녀의 성적인 기술은 만점이다.")
	CALL k1011GP("L", @"자신의 육봉이 살집 있는 작은 손과, 뜨겁고 탄력 있는 판타지(futa)의 육봉에 감싸였다.")
	CALL k1011GP("W", @"마치 몸의 다른 모든 감각을 빼앗아갈 듯한 쾌감이 귀두에서부터 솟아나 온몸으로 빠르게 퍼져나갔다.")
	CALL k1011GP("W", @"후타의 육봉에서 오는 압박이 갑자기 거세지더니, 저 색마적인 후타 어린 여자애가 사정할 것 같다.")
	CALL k1011GP("L", @"%CALLNAME:MASTER%도 쾌락에 대한 저항을 포기하고, 원래부터 굵었던 성기가 다시 한번 모양을 갖추었다.")
	CALL k1011GP("L", @"녹아내리는 듯한 쾌감이 귀두를 스치고, 두 개의 육봉은 고압 물총이 되어 진득한 정액을 해설에 몰입해 있던 어린 소녀의 얼굴로 뿜었다.")
	CALL k1011GP("W", @"어린 소녀의 발그레한 얼굴과 금발을 모두 하얗게 더럽혔고, 원래 둘째 아가씨의 고상했던 기품도 진한 정액으로 흔적 없이 뒤덮여 버렸다.")
	CALL k1011GPC("W", @"「하아, 하아, 하아…… 큰일이다, 이렇게까지 놀아 버리다니, %k1011Name(TARGET, MASTER)%가 깨어나면 %k1011Name(TARGET, TARGET)%한테 분명 혼날 거야」", TARGET)
	IF k1011GetTalent("精爱味觉")
		CALL k1011GPC("W", @"「하지만, 이렇게 많은 정액이라니... 핥고 싶어...」", TARGET)
		CALL k1011GP("L", @"얼굴에 두껍게 발린 정액에서 진한 비릿한 냄새가 풍겨 나왔고, 그것은 코를 통해 쉽게 지나가 어린 소녀의 이미 미리 각성된 암컷 본능을 자극했다.")
		CALL k1011GP("W", @"게다가 방금 있었던 「결혼식」의 자극과 어린 몸은 완전히 성욕에 빠졌다.")
		CALL k1011GP("L", @"몸이 완전히 뇌의 통제를 받지 못하는 것처럼 입을 벌리고, 침으로 뒤덮인 부드러운 작은 혀를 내밀었다.")
		CALL k1011GP("W", @"마치 크림을 먹는 것처럼 김이 모락모락 나는 두꺼운 정액 한 층이 입가에서 스며들어 입안으로 들어왔다.")
		CALL k1011GP("L", @"정액이 목구멍 깊숙한 곳을 지나갈 때, 진한 정액 냄새가 완전히 발달한 신경 세포를 자극했다.")
		CALL k1011GP("L", @"정액에 완전히 복종한 신경 세포들이 한 파동씩 쾌감 신호를 뇌로 전달했다.")
		CALL k1011GP("L", @"이러한 기이하고 강렬한 쾌감 자극 아래, 어린 소녀의 작은 머리는 순간 새하얘졌다.")
		CALL k1011GP("W", @"몸은 암컷의 본능을 따라 뒤로 들리며, 아직 정액이 조금 묻은 작은 혀를 내밀고 경련하듯 절정에 이르렀다.")
		CALL k1011GPC("W", @"「%k1011Sound("Orgasm", "呼哈、哈、啊、啊、啊——………")%」", TARGET)
		CALL k1011GPC("L", @"「%k1011Sound("Happy", "呼哈、哈、啊、啊、啊——………")%」", TARGET)
		CALL k1011GPC("L", @"「하아, 다, 이상해 %k1011Name(TARGET, MASTER)%가, 후우, 안 돼, 음……」", TARGET)
		CALL k1011GPC("L", @"「후, 후, 사정하는 거, 우, 우, 정액이 이렇게, 하, 맛있다……」", TARGET)
		CALL k1011GPC("W", @"「흑, 흑, 아직 이렇게 많아, 으음...」", TARGET)
		CALL k1011GP("W", @"지금의 어린 소녀는 욕망에 완전히 빠져들었고, 정액을 먹고 정액으로 절정에 이르는 것을 끊임없이 반복하는 암수가 되었다.")
		CALL k1011GP("W", @"어린 소녀가 손으로 정액을 긁어내면서 손가락을 핥는 귀여운 모습을 보고, %조사처리(CALLNAME:MASTER,"는")%(는) 부끄러운 듯 웃으며 눈을 감았다.")
		CALL k1011GSleep()
		CALL k1011GP("W", @"프랑 쪽의 움직임이 사라진 것을 느끼고, 다소 불안해진 %조사처리(CALLNAME:MASTER,"가")% 눈을 떴다.")
		CALL k1011GP("L", @"이 음란한 작은 녀석이 절정에 너무 자주 도달해서 지쳐 보인다.")
		CALL k1011GP("W", @"자기의 가랑이에 기대 잠이 들어버렸다.")
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 인형처럼 가녀린 어린 소녀의 몸을 안아 자신의 침대로 들여놓았다.")
		CALL k1011GP("W", @"오늘 밤은 이 괴팍한 플란쨩이랑 혼자 자야지")
	ELSE
		CALL k1011GPC("W", @"「금기 '포 오브 어 카인드'」", TARGET)
		CALL k1011GPC("L", @"「거짓말... 방에 있는 종이를 가져와」", TARGET)
		CALL k1011GPC("L", @"「이걸 깨끗하게 닦아라」", TARGET)
		CALL k1011GPC("L", @"「주의, 소리를 내지 말아줘」", TARGET)
		CALL k1011GSleep()
		CALL k1011GP("L", @"한 분도 채 안 되어 네 명의 어린 여자아이들이 범행의 흔적을 모두 깨끗하게 치우고 사라졌다.")
		CALL k1011GP("W", @"오늘 밤에도 플랑을 끌어안고 자고 싶었나, 안 될 것 같네.")
	ENDIF
	;不喜欢芙兰
ELSE
	CALL k1011GP("W", @"이런 자기만 잘났다고 생각하는 노예는 제대로 교육해야 한다, 안 그러면 나중에 분명 자신의 명성에 영향을 줄 무슨 일이 생길 것이다.")
	CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"가")% 갑자기 일어나 「짝」 하는 소리를 내며 아무것도 반응하지 못하고 있는 어린 소녀의 얼굴을 때렸다.")
	CALL k1011GP("W", @"어린 소녀가 울기도 전에, %조사처리(CALLNAME:MASTER,"는")% 소녀의 옷을 잡고 플란을 문밖으로 던져버렸다.")
	CALL k1011GP("W", @"비록 오늘 밤 플랜의 통곡 소리가 홀 전체에 울려 퍼졌지만, 오직 %조사처리(CALLNAME:MASTER,"의")% 방만 침묵의 문을 통해 들리지 않았다.")
ENDIF
