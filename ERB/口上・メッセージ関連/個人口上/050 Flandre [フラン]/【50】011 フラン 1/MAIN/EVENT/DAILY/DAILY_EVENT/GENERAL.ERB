	IF k1011GetTalent("淫乱")
		LOCAL = RAND:((k1011GetBase("体力") + k1011GetBase("体力", MASTER)) / 500) + 2
		CALL k1011GP("L", @"%조사처리(CALLNAME:MASTER,"가")% 괜찮아진 것을 본 후, 플란이 갑자기 음흉한 미소를 지었다.")
		CALL k1011GPC("L", @"「규칙대로, 패배자는 승자에게 정액을 짜내야 한다고……. ♪」", TARGET)
		CALL k1011GP("W", @"후란은 능숙하게 %조사처리(CALLNAME:MASTER,"의")% 가랑이를 풀고 기승 자세를 취했다.")
		CALL k1011GP("W", @"{LOCAL}번을 한 후에 플란이 비로소 만족스럽게 %조사처리(CALLNAME:MASTER,"를")% 놓았다.")
		CALL k1011AddJuel("欲情", LOCAL * 1000)
		CALL k1011AddExp("精液经验", LOCAL)
	ENDIF
ELSE
	CALL k1011GP("W", @"후란은 단 한 발의 탄막에 쓰러진 %조사처리(CALLNAME:MASTER,"를")% 황급히 방으로 돌려보냈다.")
