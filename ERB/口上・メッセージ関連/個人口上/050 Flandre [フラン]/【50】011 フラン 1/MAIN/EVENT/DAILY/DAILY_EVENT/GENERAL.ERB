	CALL k1011GP("W", @"플란은 돌아서서 자신만의 작은 찻잔을 가져와, 마안을 수정처럼 투명하고 어린 소녀 특유의 향이 살짝 나는 찻잔 입구에 겨누고 %조사처리(CALLNAME:MASTER,"의")% 정액을 모두 담았다.")
	CALL k1011GPC("W", @"「후우... %k1011Name(TARGET, MASTER)%의 특제 우유 냄새는 여전히 진하고, 맡기만 해도 식욕을 ... 자극한다.」", TARGET)
	flow = 1
ENDIF
;吸血
IF K1011AllowVampirism
