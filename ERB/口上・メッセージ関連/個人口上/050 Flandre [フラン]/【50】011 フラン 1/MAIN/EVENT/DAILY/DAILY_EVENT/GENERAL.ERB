	CALL k1011GP("W", @"소녀는 입을 벌렸고, 선홍색의 피가 작은 시냇물처럼 그녀의 몸에서 흘러 프랑의 찻잔 속으로 떨어져 진한 정액 위로 반쪽 하트 모양을 그렸다.")
	CALL k1011GPC("W", @"「그것은 %k1011Name(TARGET, MASTER)%의 피로군」", TARGET)
