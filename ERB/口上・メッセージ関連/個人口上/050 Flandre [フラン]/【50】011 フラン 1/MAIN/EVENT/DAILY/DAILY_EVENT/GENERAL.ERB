SIF k1011GetTalent("淫乱")
	CALL k1011GPC("W", @"「지금 %k1011Name(TARGET, TARGET)%는 %k1011Name(TARGET, MASTER)%와 성적인 게임을 하는 게 제일 좋아」", TARGET)
