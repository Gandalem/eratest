; Modular ERB: 個人口上/050 Flandre [フラン]/【50】011 フラン 1/MAIN/EVENT/ONE_UNDER_TALENT.ERB
;一人之下素质

@k1011OneUnderGetMessage
CALL k1011GP("W", @"후란 양의 눈빛이 조금 이상했다...")
CALL k1011GP("W", @"명백히 타인을 괴롭하는 것을 즐기는 플란쨩은, %조사처리(CALLNAME:MASTER,"를")% 본 순간 눈빛이 촉촉해졌다.")
CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)% 요즘 또 말을 잘 안 듣고 다른 사람을 괴롭혔네? 나쁜 아이한테는 벌을 좀 줘야겠지♪」", TARGET)
;喜欢芙兰
IF k1011Love()
	CALL k1011GP("W", @"플랑은 아기처럼 부드럽고, 하얗지만 복숭아빛이 도는 듯한 섬세한 피부를 하고 있었고, %조사처리(CALLNAME:MASTER,"는")% 다소 난감하게 고개를 떨궜다.")
	CALL k1011GP("W", @"이걸 어떻게 손에서 놓을 수가 있겠어...")
	CALL k1011GP("L", @"하지만 %조사처리(CALLNAME:MASTER,"에게")% 생각할 시간을 주지 않자, 푸란짱이 갑자기 몸을 바짝 밀착해 왔다.")
	CALL k1011GP("L", @"숨은 점점 거칠어지고, 얼굴에는 홍조가 돌며 눈에는 기대감으로 가득 차 있었다...")
	CALL k1011GPC("W", @"「왜 그래, %k1011Name(TARGET, MASTER)%? 어서 플란을 벌혀라」", TARGET)
	IF k1011GetTalent("施虐狂", MASTER)
		CALL k1011GP("W", @"후란이 일부러 약한 모습을 보이며 애원하자, %조사처리(CALLNAME:MASTER,"의")% 마음속에 불꽃이 타오르기 시작했다.")
		CALL k1011GPC("L", @"「야♥, %k1011Name(TARGET, MASTER)%이/가」", TARGET)
		CALL k1011GP("W", @"결국, 욕망을 더는 이기지 못한 %조사처리(CALLNAME:MASTER,"는")% 거칠게 후우의 날개를 들어 올렸고, 소녀의 어린 몸은 힘없이 공중에 매달렸다.")
		CALL k1011GP("W", @"눈앞의 팬티를 휙 벗겨내고 새하얗고 여린 작은 엉덩이에 한 대를 때렸다.")
		CALL k1011GPC("W", @"「%k1011Sound("Pain", "呀、啊啊啊——")%%k1011Name(TARGET, MASTER)%♥」", TARGET)
		CALL k1011GSleep()
		CALL k1011GP("W", @"얼마나 지났을까, 플란쨩의 엉덩이는 복숭아처럼 빨갛게 달아올라 '미나미츠'처럼 진득해질 때쯤, 두 사람의 SM 욕망이 비로소 충족되었다.")
	ELSE
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 여동생에게 애원받은 형처럼 비싼 인형을 보며 어쩔 줄 몰라 했다.")
		CALL k1011GP("W", @"하지만 망설이는 것도 방법이 아니었다. %조사처리(CALLNAME:MASTER,"는")% 결심하고, 후란 양의 팬티를 걷어 올린 뒤, 매끈한 작은 엉덩이에 손바닥으로 한 대 때렸다.")
		CALL k1011GPC("W", @"「%k1011Sound("Pain", "哇啊♥……")%가 부족해, 한 번 더, 한 번 더」", TARGET)
		CALL k1011GP("W", @"후란은 몸이 부드러워져 %조사처리(CALLNAME:MASTER,"의")% 품에 기대 만족스러운 표정을 지었고, 어쩔 수 없이 계속 가볍게 두드리자 후란의 신음도 부드럽고 다양하게 변했다.")
		CALL k1011GSleep()
		CALL k1011GP("W", @"얼마나 지났는지 모르게, 플란쨩은 비로소 만족하며 잠이 들었다.")
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 다친 '복숭아 엉덩이'를 마음 아파하며 만지고, 힘겹게 몸을 기울여 약상자를 꺼내 무릎에 쓰러져 있는 플란에게 치료해 주었다.")
	ENDIF
	CALL k1011GPC("L", @"「정말 이상하네, 이런 일은 %k1011Name(TARGET, TARGET)%이 하는 게 맞는데……」", TARGET)
	CALL k1011GPC("W", @"「당신에게 %k1011Name(TARGET, MASTER)%에게 괴롭힘을 당하다니... 왜 이렇게 기대하는 걸까」", TARGET)
	CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%, %k1011Name(TARGET, TARGET)%를 괴롭혀 줘, 정말 좋아♪」", TARGET)
	;不喜欢芙兰
ELSE
	IF k1011GetTalent("施虐狂", MASTER)
		CALL k1011GP("W", @"발산할 대상을 찾는 %CALLNAME:MASTER%, 거칠게 플랜의 날개를 들어 올리자, 어린 몸이 강제로 공중으로 끌어올려졌고 날개 뿌리에서 피가 스며 나왔다.")
		CALL k1011GPC("W", @"「아, %k1011Name(TARGET, MASTER)%♥」", TARGET)
		CALL k1011GP("W", @"방해되는 속옷을 벗기고, 눈앞의 새하얗고 연약한 작은 분홍빛 엉덩이에 한 대를 때렸다.")
		CALL k1011GPC("W", @"「%k1011Sound("Pain", "啊、啊啊啊♥——")%%k1011Name(TARGET, MASTER)%」", TARGET)
		CALL k1011GSleep()
		CALL k1011GP("L", @"얼마나 지났는지 모르겠지만, 플란쨩의 엉덩이가 새빨갛게 맞아서 마치 너무 익은 복숭아처럼 '즙'을 흘리고 있었고, %조사처리(CALLNAME:MASTER,"의")% 욕망이 비로소 해소되었다.")
		CALL k1011GP("W", @"망가뜨릴 수는 없고, 아무렇게나 날개를 펼치고, 떨어지는 플란을 옆에 내려놓으며, 일하러 돌아가야 했다.")
		CALL k1011GPC("L", @"「싫어, %k1011Name(TARGET, TARGET)%는 분명 괴롭힘 당하고 싶지 않은데……」", TARGET)
		CALL k1011GPC("W", @"「하지만 %k1011Name(TARGET, MASTER)%에게 엉덩이를 맞다니... 정말 기쁘네」", TARGET)
		CALL k1011GP("W", @"프랑의 혼잣말에는 신경 쓰지 않고, %조사처리(CALLNAME:MASTER,"는")% 제 갈 길을 갔다.")
		CALL k1011GPC("W", @"「으응, 다음에도 %k1011Name(TARGET, MASTER)%가 %k1011Name(TARGET, TARGET)%를 괴롭힐 거지♪」", TARGET)
	ELSE
		CALL k1011GP("L", @"플랑쨩이 완전히 M으로 변한 것 같아. 전의 그 어린아이보다는, 가학을 즐기는 흡혈귀가 더 비싸게 팔리겠어. %조사처리(CALLNAME:MASTER,"는")% 그렇게 생각했다.")
		CALL k1011GP("W", @"기쁜 마음으로 플란을 안았다.")
		CALL k1011GPC("L", @"「참 따뜻하네, %k1011Name(TARGET, TARGET)%은 괴롭힘 당하고 싶어지는걸……」", TARGET)
		CALL k1011GPC("W", @"「%k1011Name(TARGET, MASTER)%가 가까이 올 때마다... 특별히 괴롭힘당하고 싶은 느낌이 들어.」", TARGET)
		CALL k1011GPC("W", @"「참 이상하네... 분명, 몰래 후란을 내보낸 미즈 언니나 후란조차도 그녀를 괴롭히고 죽이는 생각만 했을 텐데.」", TARGET)
		CALL k1011GPC("W", @"「후후, 좋아, %k1011Name(TARGET, TARGET)%을 놀려보자♪」", TARGET)
		CALL k1011GP("W", @"%조사처리(CALLNAME:MASTER,"는")% 마음속으로 크게 놀라며, 플란이 다른 사람에게 괴롭힘 당해도 괜찮은지 거듭 물었다.")
		CALL k1011GPC("L", @"「%k1011Name(TARGET, TARGET)%은 남을 괴롭히는 것밖에 관심이 없어! %k1011Name(TARGET, TARGET)%을 괴롭히는 녀석들은 전부 죽어버려! ……아, 봤어, %k1011Name(TARGET, MASTER)%? %k1011Name(TARGET, TARGET)%은 나쁜 아이야. 어서 플랑을 벌해줘♥……」", TARGET)
		CALL k1011GP("W", @"무슨 농담이야, 그저 누군가에게 괴롭힘을 당하고 싶다고? 노예가 아니라면 감동적이라고 할 수도 있겠지만, 노예로서의 가치는 구매자가 좋아하지 않을 거야! 발각되면 구매자에게 잔인하게 가격을 매겨질 테니까! 쯧")
		CALL k1011GP("W", @"마음이 바닥까지 떨어진 %조사처리(CALLNAME:MASTER,"는")% 플란이 말을 끝내기도 전에 손을 놓고, 플란이 땅에 떨어지는 것을 내버려 둔 채 뒤도 돌아보지 않고 떠났다.")
		CALL k1011GPC("W", @"「으응, %k1011Name(TARGET, MASTER)%너무 거칠어, %k1011Name(TARGET, TARGET)%, 너무 좋아♥…」", TARGET)
	ENDIF
ENDIF
SIF k1011GetTalent("施虐狂")
	CALL k1011GP("L", @"후란[가학자]은(는) 잃었다.")
SIF k1011GetTalent("受虐狂")
	CALL k1011GP("L", @"후란[피학자]은(는) 잃었다")
CALL k1011GP("W", @"후란(일인하)을 얻었다")
;判断是否取得[一人之下],每回合开始时判断

@k1011GetOneUnderJudge
;已经取得
SIF k1011GetCTalent(2)
	RETURN
;必须恋慕
SIF !k1011GetTalent("恋慕")
	RETURN
;前置条件不满足
SIF !(k1011GetAbl("施虐感") >= 5 && k1011GetAbl("受虐感") >= 5)
	RETURN
;需要连续执行200次M指令
SIF K1011OneUnderAccNum < 50
	RETURN
;取得文本
DRAWLINE
CALL k1011OneUnderGetMessage()
;DP
CALL k1011SetTalent()
CALL k1011SetTalent("施虐狂", 0)
CALL k1011SetTalent("受虐狂", 0)
CALL k1011SetCTalent(2, 1)
;先行口上处理

@k1011UnderOneF
;没有[一人之下]
SIF !k1011GetCTalent(2)
	RETURN
;非猪脚时为施虐狂
IF PLAYER != MASTER
	CALL k1011SetTalent("施虐狂", 1)
	CALL k1011SetTalent("受虐狂", 0)
	;主人相反
ELSE
	CALL k1011SetTalent("施虐狂", 0)
	CALL k1011SetTalent("受虐狂", 1)
ENDIF
;调教结束处理

@k1011UnderOneE
;没有[一人之下]
SIF !k1011GetCTalent(2)
	RETURN
CALL k1011SetTalent("施虐狂", 0)
CALL k1011SetTalent("受虐狂", 0)
;回合结束处理

@k1011UnderOneTurnend
;已经有素质了
SIF k1011GetCTalent(2)
	RETURN
;自然下降
SIF K1011OneUnderAccNum
	K1011OneUnderAccNum -= 1
;培养素质

@k1011UnderOneTrain
;已经有素质了
SIF k1011GetCTalent(2)
	RETURN
;S芙兰类
SIF GROUPMATCH(k1011GetNowSelectcom(), 220, 221, 222, 223, 224, 227, 228, 229, 230, 231, 232, 233, 234, 235, 236, 237, 240, 241, 251, 253, 270)
	K1011OneUnderAccNum += 1
;被芙兰S类
SIF GROUPMATCH(k1011GetNowSelectcom(), 47, 271, 272, 273)
	K1011OneUnderAccNum -= 10
;保底
K1011OneUnderAccNum = MAX(K1011OneUnderAccNum, 0)
