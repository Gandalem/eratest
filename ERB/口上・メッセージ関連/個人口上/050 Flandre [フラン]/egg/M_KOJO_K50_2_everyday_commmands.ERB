@M_KOJO_EGG_MESSAGE_COM_K50_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「나에게 차를 달라고?」
		PRINTFORML 「사쿠야가 파업했어?」
		PRINTFORMDW 당신은 미소를 지으며 여유분이 좀 있어서 나누고 싶다고 알려준다.
		PRINTFORML 「좋아, 네 것이 얼마나 대단한지 보자.」
		PRINTFORMDW 플랜더는 당신이 준비한 차를 홀짝였다.
	ELSEIF CFLAG:TARGET:行動 == 5
		GOTO PERSONAL_SAKUYA
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				SELECTCASE IFRAND("0", TALENT:[[フラン]]:恋人, "1", TALENT:[[フラン]]:恋慕 || TALENT:[[フラン]]:恋人, "2", TALENT:[[フラン]]:思慕 || TALENT:[[フラン]]:恋慕 || TALENT:[[フラン]]:恋人, "3", 1)
					CASE 0
						PRINTFORML 「음, 차를 만들었어?」
						PRINTFORMDW 플랜더는 한 모금 마시며 미소 짓는다.
						PRINTFORML 「정말 맛있네 – 이거 점점 잘하는구나.」
						PRINTFORMDW 그녀는 사랑이 담긴 눈으로 말한다.
						PRINTFORMDW 플랜더는 몸을 기울이며 조용하고 만족스러운 순간을 나눈다.
						PRINTFORML 「너의 사소한 것들이 매일을 특별하게 만들어줘.」
						PRINTFORMDW 그녀는 당신의 시선을 애정 어린 눈빛으로 바라보며 중얼거린다.
					CASE 1
						PRINTFORML 「오, 차를 만들었어?」
						PRINTFORMDW 플랜드는 기분 좋게 놀란 표정을 짓는다.
						PRINTFORMDW 그녀는 그릇을 재빨리 들고 부드럽게 향을 맡았다.
						PRINTFORML 「음, 향이 좋다~」
						PRINTFORMDW 그녀의 눈은 감사함이 담긴 빛으로 당신과 마주쳤다.
						PRINTFORMDW 그녀가 맛을 보자 얼굴에 화색이 퍼졌다.
						PRINTFORML 「맛있다!❤」
						PRINTFORML 「너 정말 놀라운 것들로 가득하구나, 그렇지?」
						PRINTFORMDW 그녀는 장난기 어린 말투로 말했다.
					CASE 2
						PRINTFORML 「나한테 차 한 잔?」
						PRINTFORMDW 플랜더의 눈이 빛난다.
						PRINTFORML 「고마워～」
						PRINTFORMDW 잔을 받아 한 모금 마시자, 그녀의 미소가 넓어진다.
						PRINTFORML 「이거 정말 맛있다!」
						PRINTFORMDW 그녀는 그 맛을 음미하며 외친다.
						PRINTFORMDW 편안한 자세에서 그녀의 안도감과 즐거움이 느껴진다.
					CASE 3
						$PERSONAL_SAKUYA
						PRINTFORML 「오? 참 다정하네.」
						PRINTFORMDW 당신은 찻잔을 건네고 그녀는 그것을 마신다.
						PRINTFORML 「이거 최고야! 마치 나만의 사쿠야를 가진 것 같아~」
						PRINTFORMDW 그러고 나서 그녀는 재빨리 남은 것을 다 마시고 만족스러운 한숨을 내쉰다.
				ENDSELECT
			CASE 0
				SELECTCASE IFRAND("0", 1, "1", !IS_FALLEN([[フラン]]) || TALENT:[[フラン]]:思慕, "2TO3", TALENT:[[フラン]]:恋慕 || TALENT:[[フラン]]:恋人)
					CASE 0
						PRINTFORML 「오, 차를 만들었어?」
						PRINTFORMDW 플랜더는 당신에게서 찻잔을 받으며 은은한 호기심을 드러낸다.
						PRINTFORMDW 그녀는 그것을 맛보는데, 표정은 중립적이지만 생각에 잠긴 듯하다.
						PRINTFORML 「꽤 기본적이네, 그렇지? 사쿠야에게 조언을 구하는 게 좋을 거야.」
						PRINTFORMDW 그녀는 무심하게 말하며 찻잔을 내려놓는다.
						PRINTFORMDW 그녀의 시선이 잠시 당신과 마주치고, 눈빛에는 미묘한 감사가 담겨 있었다.
					CASE 1
						PRINTFORML 「차라, 응?」
						PRINTFORMDW 플랜드는 조심스럽게 그 잔을 바라본다.
						PRINTFORMDW 그녀는 그것을 조심스럽게 집어 호기심 어린 듯 킁킁거린다.
						PRINTFORML 「그냥 평범한 차잖아, 맞지?」
						PRINTFORMDW 그녀는 여전히 약간 확신이 없는 채로 묻는다.
						PRINTFORMDW 망설이다 한 모금 마시고, 살짝 고개를 끄덕인다.
						PRINTFORML 「괜찮은 것 같아. 어쨌든 고마워.」
						PRINTFORMDW 그녀는 방어적인 태도를 유지하면서도 약간의 개방성을 보이며 중얼거린다.
					CASE 2
						PRINTFORML 「또 차야?」
						PRINTFORML 「나를 너무 귀하게 대해주네, %CALLNAME:MASTER%~」
						PRINTFORMDW 플랜더가 따뜻하고 애정 어린 어조로 말한다.
						PRINTFORMDW 그녀의 시선이 당신을 향하며 분명한 감정의 깊이를 담는다.
						PRINTFORMDW 그녀는 한 모금 마시며 사색적인 표정을 짓는다.
						PRINTFORML 「최고의 배합은 아니지만, 네가 만든 거니까 그래도 좋아~❤」
						PRINTFORMDW 그녀는 다정한 미소로 말한다.
					CASE 3
						PRINTFORML 「또 차야? 역시 최고야, %CALLNAME:MASTER%～」
						PRINTFORMDW 플랜드는 다정한 손길로 잔을 받아들며 사랑스러운 미소를 지어 말한다.
						PRINTFORMDW 그녀는 한 모금 마시고 맛을 음미하듯 잠시 눈을 감는다.
						PRINTFORML 「네가 최고인 건 아니지만, 네가 만들어줬으니 상관없어～❤」
						PRINTFORMDW 그녀는 사랑이 가득 담긴 눈빛으로 당신을 바라보며 애정 어린 말투로 말한다.
				ENDSELECT
			CASE -1
				SELECTCASE IFRAND("0TO1", TALENT:TARGET:恋慕 || TALENT:[[フラン]]:恋人 || TALENT:[[フラン]]:愛欲, "2TO3", 1)
					CASE 0
						PRINTFORML 「이것은...」
						PRINTFORMDW 플랜더가 컵을 내려놓는다.
						PRINTFORMW 「다음엔 행운이 있기를?」
					CASE 1
						PRINTFORML 「...」
						PRINTFORMW 「사쿠야에게 조언을 구할 수도 있지 않을까?」
					CASE 2
						PRINTFORMW 「이건 끔찍해...」
					CASE 3
						PRINTFORMW 「이건... 안 좋아.」
				ENDSELECT
			CASE -3
				PRINTFORMW 「취하면 알겠지만, 독은 흡혈귀에게는 통하지 않아.」
		ENDSELECT
	ENDIF
	;Lines for serving tea with semen mixed in (Good/Mid, Flan likes it) (I don't think you can actually do this yet)
	; PRINTFORMDW Flandre takes another sip and, her face becomes flushed.
	; PRINTFORML 「This flavor... Is this...?」
	; PRINTFORMDW She looks up at you with anticipation and lust in her eyes.
	; PRINTFORMDW You nod as her breathing becomes heavy.
	; PRINTFORML 「Tha... Thank you～ ❤」
	; PRINTFORMDW Flandre takes another sip, savoring the taste.
ENDIF
RETURN 1
