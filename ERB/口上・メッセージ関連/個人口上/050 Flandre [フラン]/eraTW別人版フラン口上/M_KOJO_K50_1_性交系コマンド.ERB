				PRINTFORML 「내가, 넣는 거야…… 조금, 무섭지만……」
				PRINTFORMW 「응, 츄%UNICODE(0x2665)%――이걸로, 괜찮아. 그럼, 넣을게……」
			ENDIF
		ELSE
		ENDIF
		TCVAR:50:351 += 1
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		;PRINTFORMW
		RETURN 1
		;それ以外
	ELSE
		;PRINTFORMW
		RETURN 1
	ENDIF
ENDIF
RETURN 1
