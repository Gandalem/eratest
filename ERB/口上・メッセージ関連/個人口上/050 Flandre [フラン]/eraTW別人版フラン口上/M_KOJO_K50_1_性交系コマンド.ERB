@M_KOJO_ふらん_MESSAGE_COM_K50_60_1
;-------------------------------------------------
;立位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && TFLAG:193
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			PRINTFORML 
			PRINTFORML  
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;正常位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		;FIRSTKISSしたかどうかでの分岐えっちだったからそのうち入れる
		IF TCVAR:破瓜 == 1
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「아……」
				PRINTFORML 플랑을 눕히고, 그 가랑이에 박힌 것을 가져다 댄다.
				PRINTFORML 「그, 처음이니까……」
				PRINTFORML 「……상냥하게 해줘」
				PRINTFORML 더욱 단단해지는 것을 스스로 인지하고 있으면서도, 플랑의 부탁에 응하여 가능한 한 천천히 삽입한다.
				IF PALAM:潤滑 >= PALAMLV:3
					PRINTFORML 「응, 음음……」
					PRINTFORML 이미 충분히 젖어 있는 질내는 천천히, 하지만 확실하게 한 우물을 삼켜 나간다.
					PRINTFORML 아마 막일 부분도, 적어도 통증이 적도록 숨을 내쉬는 순간 밀어 넣었다.
					PRINTFORML 「앗, ~~~~~~~읏!!!」
					PRINTFORML 아파하며 신음하는 플랑에게 괜찮냐고 목소리를 걸자
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")%, 나의 첫 경험을 줄 수 있었다는 게 기뻐서」
					PRINTFORML 「아프지만 행복해. 그러니까 계속해줘, %CALLNAME:MASTER%……%UNICODE(0x2665)%」
					PRINTFORMW 플랑의 애처로움에 더욱 이성을 자극받은 자신의 것을 느끼며, 삽입 페이스를 올렸다.
				ELSE
					PRINTFORML 「응읏! 응……」
					PRINTFORML 플랑의 그다지 젖지 않은 질에 천천히 삽입해 나간다.
					PRINTFORML 살을 밀어내며 진행하는 질 내부는 단단했고, 꽤 강한 자극을 주고 있었다.
					PRINTFORML 「후우, 하아, 후우, 하아. ……그대로, 와줘, %CALLNAME:MASTER%」
					PRINTFORML 막힌 듯 느껴졌던 질 내부를 숨을 내쉬는 순간 기세 좋게 밀어 넣었다.
					PRINTFORML 「흐윽, 음~~~~~옷!!!!!!!!!」
					PRINTFORML 발버둥 치는 대신 사지를 당신에게 감싸 안으며 고통을 참아내고 있다.
					PRINTFORML 고통에 몸부림치는 플랑에게 괜찮냐고 말을 건네자
					PRINTFORML 「……조금, 아니, 생각보다 아팠지만」
					PRINTFORML 「하지만 당신 것이 될 수 있었잖아. 기뻐」
					PRINTFORML 「그러니까, 그게, 잠깐만 기다려줬으면 해. 익숙해질 때까지」
					PRINTL
					PRINTL
					PRINTL
					PRINTFORML 「응, 이제 됐어. 미안해, 참게 했구나」
					PRINTFORML 그녀의 말을 듣고, 천천히 삽입을 재개한다.
					PRINTFORML 「앗, 음... 응, 그대로. 나로 기분 좋아져 줘, %CALLNAME:MASTER%%UNICODE(0x2665)%」
				ENDIF
				;潤滑足りないと多分苦痛刻印付くけど、このタイミングだけあっちの苦痛刻印口上表示止めたいところ
			ELSE
			ENDIF
			RETURN 1
		ELSE
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			IF TALENT:恋慕 || TALENT:恋人
				;前回フランちゃんが絶頂しているかで分岐？作る。あとＶ感度分岐も
				SELECTCASE NOWEX:TotalEX
					CASE 5 TO 15
						PRINTFORML 「후우읏%UNICODE(0x2665)%후우읏%UNICODE(0x2665)%……아윽, 응읏!!」
						PRINTFORML 「얏%UNICODE(0x2665)% 벌써 가버렸어%UNICODE(0x2665)% 가버렸어요오%UNICODE(0x2665)%」
						PRINTFORMW 「아우%UNICODE(0x2665)%야, 또%UNICODE(0x2665)%가버릴 것 같으니까아%UNICODE(0x2665) *3%」
					CASE 2 TO 4
						PRINTFORML 「아응우%UNICODE(0x2665)%야, 갔어, 갔는데 말이야%UNICODE(0x2665)%」
						PRINTFORMW 「아직이야, 질 내부, 딱딱해%UNICODE(0x2665)%」
					CASE 1
						PRINTFORML 「응~~앗! 아, 가버렸는데...」
						PRINTFORMW 「아, 자, 아직, 안, 들어와, 읏!」
					CASEELSE
						PRINTFORML 「앗, 응, 아직 딱딱하네」
						PRINTFORMW 「……한 번 더 해줄까? 아, 응읏」
				ENDSELECT
			ELSE
			ENDIF
			RETURN 1
		ELSE
			;出さずに継続？
			IF TALENT:恋慕 || TALENT:恋人
				;5超えると普通に超強絶頂するんでここ分岐で
				IF ABL:1 >= 5
					PRINTFORML 「아앗 %UNICODE(0x2665)%야, 거기 %UNICODE(0x2665)%」
					PRINTFORML 「기분 좋아 %UNICODE(0x2665)% 아, 갈 것 같아 %UNICODE(0x2665)%」
					PRINTFORMW 「야 %UNICODE(0x2665)%%CALLNAME:MASTER%%UNICODE(0x2665)%, %CALLNAME:MASTER%%UNICODE(0x2665) *3%」
				ELSEIF ABL:1 >= 3
					PRINTFORML 「아, 야, %CALLNAME:MASTER%, 거기가 좋아%UNICODE(0x2665)%」
					PRINTFORMW 「아, 응! 기분 좋아, %CALLNAME:MASTER%%UNICODE(0x2665)%」
				ELSE
					PRINTFORML 「응, 기분 좋아, %CALLNAME:MASTER%」
					PRINTFORMW 「맞아, 그, 안쪽을 꾹꾹 눌러줘, 좋아, %CALLNAME:MASTER%……!」
				ENDIF
			ELSE
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;本日最初のSEX
	ELSEIF TCVAR:50:351 == 0
		IF TALENT:恋人 || TALENT:恋慕
			;TCVAR:351は恋人OR恋慕でしか変動しないため不要？
			IF ABL:1 >= 5
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「저기, 요즘 %CALLNAME:MASTER%때문에 뭔가 쉽게 흥분하고 있어서……」
						PRINTFORMW 「음…… 다정하게 해줬으면 좋겠어~ 라든지…… 아앗%UNICODE(0x2665)%」
					CASE 1
						PRINTFORML 「이 자세, %CALLNAME:MASTER%얼굴 보이니까 좋아」
						PRINTFORMW 「아, 하지만 분명 잔뜩 해버리는 제 얼굴 보여버리겠네요……%UNICODE(0x2665)%」
				ENDSELECT
			ELSEIF ABL:1 >= 3
				PRINTFORML 「이 자세, %CALLNAME:MASTER%얼굴 보이는 게 좋네」
				PRINTFORMW 「사랑받고 있다는 느낌도 드는 것 같아. ... 사랑해줘?」
			ELSE
				PRINTFORML 「응읏, 이 자세로, 하는 거지……」
				PRINTFORML 「저기, 그게... 기회니까... 키스해 주면 좋겠는데」
				PRINTFORMW 「음, 쪽%UNICODE(0x2665)%……그럼, 해볼까」
			ENDIF
		ELSE
		ENDIF
		TCVAR:50:351 += 1
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
