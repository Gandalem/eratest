@M_KOJO_ふらん_SUCCESS_COM_K50_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_ふらん_MESSAGE_COM_K50_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_ふらん_MESSAGE_COM_K50_300_1
RETURN RESULT

@M_KOJO_ふらん_MESSAGE_COM_K50_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF TALENT:恋人
		IF TCVAR:50:350 == 0
			SELECTCASE DAY:2
				CASE 1
					;APRIL FOOL
					IF DAY:3 == 1
						PRINTFORML 「오늘은 에프릴 풀이네」
						PRINTFORML 「거짓이라 해도, 싫다고 들키고 싶지도 않고 말할 수도 없어」
						PRINTFORML 「하지만 좋아한다고 말하기도 어렵다니, 힘든 날이네」
						;WHITE DAY
					ELSEIF DAY:3 == 14
						PRINTFORML 「오늘은, 그게, 화이트 데이라는데」
						IF TALENT:処女
							PRINTFORML 「저기…… 아, 쿠키가 있는 거야」
							PRINTFORMW 「잘 먹을게. 고마워해」
						ELSE
							PRINTFORML 「저기…… 그, 에치하게 할까?」
							PRINTFORML 「아니야, 흰 날이니까, 당신의, 그게…… 음……」
							PRINTFORML 얼굴이 새빨개져서 지금이라도 김이 모락모락 나는 것 같다.
							PRINTFORML 이왕 이렇게 준비된 거, 먹어볼까.
						ENDIF
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%, 안녕」
						PRINTFORMW 「봄이라 해도, 밤이니까 %CALLNAME:MASTER%에게는 쌀쌀할지도 모르겠네」
					ENDIF
				CASE 2
					;七夕
					IF DAY:3 == 7
						PRINTFORML 「%CALLNAME:MASTER%, 오늘은 견우와 직녀의 날이야」
						IF TIME:5 == 1 || TIME:5 == 0
							PRINTFORML 「정말 아름답게 은하수가 보이네」
							PRINTFORML 「오리히메도, 쇼도 만날 수 있었을까」
							PRINTFORML 「일 년이나 못 본다는 생각만 해도 어떻게 될 것 같아」
							PRINTFORMW 「……1분 1초라도 떨어지고 싶지 않아」
						ELSEIF TIME:5 == 2 || TIME:5 == 3
							PRINTFORML 「은하수가 보이지는 않지만」
							PRINTFORML 「제 소원이 제대로 닿을 수 있을지 불안해져 버렸네」
							PRINTFORMW 「……뭐, 당신의 마음에 닿아주면 그걸로 괜찮으니까」
						ELSEIF TIME:5 == 4 || TIME:5 == 5
							PRINTFORML 「비, 와버렸나…」
							PRINTFORML 「전에는 치라토미 같은 건 아무래도 괜찮았는데」
							PRINTFORML 「지금은 이루고 싶은 소원이 잔뜩 있어서 신경 쓰이네」
							PRINTFORMW 「……당신이랑 계속 함께 있고 싶다, 같은 거 말이야」
						ELSE
							PRINTFORML 「아쉽게 날씨가 안 좋네」
							PRINTFORMW 「오히메와 쇼에게, 소원을 들어주길 바랄 수 없을 것 같아」
						ENDIF
					ELSE
						PRINTFORML 「안녕, %CALLNAME:MASTER%」
						PRINTFORMW 「밤인데 더우네읏」
					ENDIF
				CASE 3
					;お月見
					IF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- "
						PRINTFORML 「오늘은 보름달이야, %CALLNAME:MASTER%」
						IF TIME:5 == 0 || TIME:5 == 1
							PRINTFORMW 「――달이, 예쁘네요」
							PRINTFORML 「대답 안 해도 돼. 벌써 대답은 받고 있으니까」
							PRINTFORMW 「게다가, 돌려 말하는 걸로는 만족 못 하겠어…… 직접, 나한테 알려줄래?」
						ELSEIF TIME:5 == 2 || TIME:5 == 3
							PRINTFORML 「구름이 끼었지만, 어쩐지 밝은 밤이다」
							PRINTFORML 「――좀, 들뜨게 되네」
							PRINTFORMW 「일단……떡이나 먹을까」
						ELSEIF TIME:5 == 4 || TIME:5 == 5
							PRINTFORML 「비,구나」
							PRINTFORML 「대신 사쿠야 보면서 단고 먹을래?」
							PRINTFORMW 「십육야 사쿠야라는 건, 바로 십오야잖아」
						ELSE
							PRINTFORML 「이런 날씨면 보이지 않을지도 모른다」
							PRINTFORML 「유감이지만, 사쿠야와 함께 오니기리를 먹는 것은 어떠냐?」
						ENDIF
					ELSEIF DAY:3 == 30
