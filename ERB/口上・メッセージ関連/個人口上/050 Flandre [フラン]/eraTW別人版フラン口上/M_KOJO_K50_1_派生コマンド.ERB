; Modular ERB: 個人口上/050 Flandre [フラン]/eraTW別人版フラン口上/M_KOJO_K50_1_派生コマンド.ERB
;==================================================
;7,挿入子宮口責め
;==================================================

@M_KOJO_ふらん_MESSAGE_SCOM_K50_7
CALL M_KOJO_ふらん_MESSAGE_SCOM_K50_7_1
RETURN 1

@M_KOJO_ふらん_MESSAGE_SCOM_K50_7_1
;custom code, moved from M_KOJO_ふらん_MESSAGE_COM_K50_73
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF FLAG:時間停止
	ELSEIF TALENT:恋慕 || TALENT:恋人
		IF NOWEX:MASTER:射精
			IF ABL:1 >= 15
				PRINTFORML 「안돼%UNICODE(0x2665)% %CALLNAME:MASTER%, 뭐야, 아아…… 후앗, 안 돼에……%UNICODE(0x2665)%」
				PRINTFORML 「야, %CALLNAME:MASTER%%UNICODE(0x2665)%가 지금, 나오면 어떡해…… 응읏!%UNICODE(0x2665)%」
				PRINTFORML 「안돼%UNICODE(0x2665)% 돌아갈 수 없어%UNICODE(0x2665)% 깊이, 크윽……!%UNICODE(0x2665)%」
				PRINTFORMW 「가,겠어…………%UNICODE(0x2665) *5%」
			ELSEIF ABL:1 >= 5
				PRINTFORML 「야, 윽……%UNICODE(0x2665)%」
				PRINTFORML 「아앗, 안 돼, 나오게 해줘, 응%UNICODE(0x2665)%」
				PRINTFORMW 「아앗, 저, 저도… %UNICODE(0x2665)%응~~이이이이잇%UNICODE(0x2665)%」
			ENDIF
		ELSE
			IF ABL:1 >= 15
				;子宮口開発経験があるらしいのでそれも加えたいところ
				PRINTFORML 「아앗%UNICODE(0x2665)%얔, 거기, 약해, 하으윽%UNICODE(0x2665) *3%」
				PRINTFORML 「안 돼, 거긴 약한가, 아으윽%UNICODE(0x2665)% 금방 갈지도 몰라아%UNICODE(0x2665)%」
				PRINTFORML 「응으윽%UNICODE(0x2665)% 안 돼, 가, 갑니다%UNICODE(0x2665)%」
				PRINTFORMW 「하아아아아아악%UNICODE(0x2665) *5%」
			ELSEIF ABL:1 >= 5
				PRINTFORML 「흐, 으윽……%UNICODE(0x2665)%」
				PRINTFORML 「거기, 아앗, 약해, 줘……%UNICODE(0x2665)%」
				PRINTFORMW 「안 돼, 당장, 금방 갈 것 같아…%UNICODE(0x2665)%」
				RETURN 1
			ENDIF
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		;PRINTFORMW
		RETURN 1
		;それ以外
	ELSE
		;PRINTFORMW
		RETURN 1
	ENDIF
ENDIF
RETURN 1
