@M_KOJO_ふらん_EVENT_K50_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		CFLAG:1501 = ARG
		;ONE DAY
		IF ARG == 1
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「다음엔 언제, 보러 와주는 걸까」
				PRINTFORML 「……보러 와줄 거지?」
			ENDIF
		ELSEIF ARG == 7
			IF TALENT:恋人
				PRINTFORML 「한숨 쉬며 혼자 잠드는 날의 시간이」
				PRINTFORML 「……이렇게 길 줄은 몰랐어, 알고 싶지 않았는데」
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 있으면, 한순간인데 말이야」
			ELSEIF TALENT:恋慕
				PRINTFORML 「일주일밖에 안 지났잖아」
				PRINTFORML 「벌써 일 년은 %조사처리(CALLNAME:MASTER,"를")% 기다린 기분이야」
			ENDIF
		ELSEIF ARG == 30
			IF TALENT:恋人
				;そして誰もいなくなった
				PRINTFORML 「그러면 아무것도 없었지...」
				PRINTFORML 「그런 건, 외롭잖아. 혼자... 우울해하지 말아줘...」
				PRINTFORML 「보고 싶어, %CALLNAME:MASTER%...」
			ELSEIF TALENT:恋慕
				PRINTFORML 「차라리, 처음부터 만나지 않았더라면」
				PRINTFORML 「사랑하지 않았다면」
				PRINTFORML 「이렇게 괴로운 감정을 느낄 일도 없었을 텐데 말이야」
				PRINTFORML 「……외롭다구, %CALLNAME:MASTER%」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0 && GET_MAPID(CFLAG:MASTER:現在位置) != GET_MAPID(CFLAG:現在位置)
		IF CFLAG:1501 >= 30
			IF TALENT:恋人
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"를")% 드디어 만났지만」
				PRINTFORML 「또, 못 보는 날들이 계속되는 걸까……」
				PRINTFORML 「매일 만나고 싶어…… 잠깐도 떨어지고 싶지 않아……」
				PRINTFORML 「――이제, 혼자는…… 아니야」
				PRINTFORML 「하지만 그렇게 말해봤다가 %조사처리(CALLNAME:MASTER,"에게")% 미움받으면…… 싫은데」
				PRINTFORML 「……내일도 만날 수 있기를」
			ELSEIF TALENT:恋慕
				PRINTFORML 「만나게 된 것만으로도 이렇게 기쁘고, 충족되는걸」
				PRINTFORML 「나는 꽤 단순해져 버렸네」
				PRINTFORML 「……우리 집에 살아주면 어떨까」
				PRINTFORML 「그럼 매일 보러 갈 수 있는데」
			ENDIF
		ELSEIF CFLAG:1501 >= 7
			IF TALENT:恋人
				PRINTFORML 「긴 한 주였지만, 드디어 %조사처리(CALLNAME:MASTER,"에게")% 만날 수 있어서 다행이다」
				PRINTFORML 「하지만, %조사처리(CALLNAME:MASTER,"는")% 나를 두고 어디에 가 있었을까」
				PRINTFORML 「……다른 여자아이들일까」
				PRINTFORML 「연인이 있는데 말이야.――질투해 버릴지도 몰라」
				PRINTFORML 「내가 질투의 불꽃에 타버리기 전에, 찾아와 주기를 바란다」
				;なお嫉妬よりも寂しさが上回る模様
			ELSEIF TALENT:恋慕
				PRINTFORML 「시간은 불평등하네」
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 있을 때만 빨리 흘러가거든」
				PRINTFORML 「……또, 일주일이나 기다려야 하나」
				PRINTFORML 「――빨리, 만나러 와주면 좋겠어」
			ENDIF
		ELSEIF !CFLAG:1501
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「오늘도 %조사처리(CALLNAME:MASTER,"를")% 만날 수 있어서, 좋은 꿈을 꿀 것 같아」
				PRINTFORML 「내일도 만날 수 있기를」
			ENDIF
		ENDIF
		CFLAG:1501 = 0
		RETURN 1
	ENDIF
ENDIF
RETURN 1
