@M_KOJO_IRAI_15_K26(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【※依頼処理側にある専用口上が表示されます】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\20,000（ホ別）
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "UNIQUE_SCENARIO_CHANCE"
		;return the chance (1/X) to select the character's unique scenario instead of a general one
		RESULT:100 = 100 ;yukari always uses outside world scenario
		RETURN 1
	CASE "UNIQUE_SCENARIO"
		PRINTFORMDL 유카리는 음란한 의도로 미소 지으며 %SPLIT_G("leads:takes")% 당을 손으로 이끌며
		PRINTFORMDW 너는 갑자기 열린 어두운 틈으로 이끌린다.
		PRINTFORMDL 
		CALL TRIPLEDOT, "reverse:timed" ;custom code
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMDL 
				PRINTFORMDL 간극을 벗어나, 당신은 모모이와는 비교할 수 없을 정도로 음침하고 불쾌한 소란스러운 도시 구역에 도착한다.
				PRINTFORMDW 화려한 네온사인의 깜빡임이 당신의 주의를 끈다. 바깥세상의 러브호텔인 것 같다.
				PRINTFORMDL 
				PRINTFORMW 「이 종류의 장소에는 특유의 매력이 있는 것 같지 않아?」
				PRINTFORMDL 
				PRINTFORMDW 그렇게 말하며, 그녀는 당신의 팔을 붙잡고 두 사람은 입구로 걸어 들어간다.
				CALL 一般依頼15_AEGI_YUKARI
				PRINTFORMDL 
				PRINTFORMDL 샤워를 비추는 일방통행 거울로 유카리의 젖은 몸을 보면 자제할 수 없다.
				PRINTFORMDW 당신은 욕실로 들이닥쳐 그녀를 난폭하게 대한다.
				PRINTFORMDL 
				PRINTFORMDL "누군가 기다릴 수 없었나 보네~", 유카리가 불평하는 것 같지는 않게 애교를 부렸다.
				PRINTFORMDW 그녀의 갈망 어린, 축축한 %FSYN("vagina")%이 당신의 맥동하는 %FSYN("penis")%를 감싸며 욕정으로 가득 찬 채 안으로 파고들었다.
				PRINTFORMDW 그녀는 비명 지르며, 윤기 나는 신음소리를 타일 벽에 울리게 했다.
				PRINTFORMDL 
				PRINTFORMDL 유카리의 손이 벽을 누르자 당신은 뒤에서 그녀의 자궁에 부딪히고; 그녀는 야수적인 쾌감으로 등을 아치형으로 휘었다.
				PRINTFORMDW 그녀의 벽은 계속 수축하며, 당신의 %FSYN("penis")% 길이를 맥동하고 조여왔다.
				PRINTFORMDL 
				PRINTFORMDL 마침내 한계에 도달하여 빼내자 당신의 %SEMEN(,1)%이 유카리의 엉덩이를 완전히 덮는다.
				PRINTFORMDW 방울방울, 당신의 %SEMEN()%가 넘쳐 샤워실 바닥으로 흘러내린다. 유카리는 욕정으로 가득 찬 표정으로 당신을 돌아본다.
				PRINTFORMDL 
				PRINTFORMW 「다음으로, 배수구로 흘러내리지 않을 안쪽에 놓는 건 어때?」
				PRINTFORMDL 
				PRINTFORMDL 또 한 판을 더 권유받아, 당신은 샤워기를 끈다. 활력이 단단해지는 %FSYN("penis")%에 돌아온다.
				PRINTFORMDW 당신은 아름다운 유카리를 팔에 들고 침대로 데려간다...
			CASE 1
				PRINTFORMDL 
				PRINTFORMDL 틈을 빠져나와 유황 냄새가 나는 곳에 도착했고, 열기와 습기가 느껴진다.
				PRINTFORMDW 너는 나무들에 둘러싸여 있으며, 자연석 지형으로 만들어진 물이 가득 찬 목욕탕 같은 것이 보인다. 온천 근처인 것 같다.
				PRINTFORMDL 
				PRINTFORMW 「여기는 외부 세계의 비밀 온천이다. 물론 나 말고는 아무도 오지 않는다.」
				PRINTFORMDL 
				PRINTFORMDW 그렇게 말하며, 그녀는 옷을 벗기 시작하면서 유혹적인 시선을 준다.
				CALL 一般依頼15_AEGI_YUKARI
				PRINTFORMDL 
				PRINTFORMDL 처음에는 온천을 즐기려고 했고 그게 전부였다. 하지만 당신은 유카리의 바로 옆에서 목욕하고 있었다...
				PRINTFORMDW 더 이상 자신을 통제할 수 없게 된다. 당신은 유카리를 끌어안고, 한 가지 일이 다른 일로 이어져 두 사람은 마치 야수처럼 서로를 탐하게 된다.
				PRINTFORMDL 
				PRINTFORMDL 그것이 그녀가 선호하는 온도였을지도 모르지만, 뜨거운 물은 그녀의 몸을 상당히 데운다.
				PRINTFORMDW 역자세로 앉아, 그녀의 자궁 입구를 밀어붙일 때마다 그녀는 황홀함으로 가득 찬 목소리를 내며 몸을 떨었다.
				PRINTFORMDL 
				PRINTFORMDL 마침내 한계에 도달하여 어디서 끝낼지 묻는다. 하지만 열기와 쾌감에 압도당해,
				PRINTFORMDW 유카리는 아무 말도 할 수 없고, 당신의 %SEMEN(,1)%이 그녀의 내면을 채우는 소리만 낼 뿐이다.
			CASE 2
				PRINTFORMDL 
				PRINTFORMDL 틈을 벗어나자 찬 바닷바람이 휘몰아치는 곳에 밝은 태양이 내리쬐는 곳에 도착했다.
				PRINTFORMDL 백사장, 풍경, 야스카모야에서는 볼 수 없는 야자수와 각종 식물 등을 고려해 보았을 때,
				PRINTFORMDW 외부 세계의 열대 국가에 와 있는 것 같다.
				PRINTFORMDL 
				PRINTFORMW 「여기는 사람이 살지 않는 섬이다. 가끔 이렇게 탁 트인 곳에 있는 것도 좋지 않나?」
				PRINTFORMDL 
				PRINTFORMDW 그렇다고는 해도, 그녀는 아무렇지도 않게 옷을 벗기 시작하고 당신의 것도 벗긴다.
				CALL 一般依頼15_AEGI_YUKARI
				PRINTFORMDL 
				PRINTFORMDW 그녀의 손으로 모래 해변을 누르며, 당신과 유카리는 동물처럼 교미하고 있다.
				PRINTFORMDL 
				PRINTFORMDL 당신은 눈앞의 매혹적인 광경에 휩싸인다.
				PRINTFORMDL 작열하는 태양 아래 빛나고 땀 흘리는 그녀의 몸, 바람에 나부끼는 눈부신 금발.
				PRINTFORMDW 거친 해방감과 함께, 당신은 마치 어떤 신화 속 세계로 발을 들인 듯한 기분을 느낀다.
				PRINTFORMDL 
				PRINTFORMDL 이 감각 때문에 눈앞의 미녀에게 사정하고 싶은 충동이 기하급수적으로 증가한다. 하지만 네가 빼려고 하자...
				PRINTFORMDW 유카리는 뒤를 돌아보며 그녀의 허리를 붙잡은 너의 손을 쓰다듬는다.
				PRINTFORMDL 
				PRINTFORMW 「이것은 야생이다—동물들의 세계다. 수컷이 정액을 뿌려야 할 암캐의 몸에는 단 하나의 장소만 있지 않나. 그렇지 않은가?」
				PRINTFORMDL 
				PRINTFORMDW 세상에서 가장 멋진 암캐 중 하나인 양 유혹적으로 중얼거리니 그런 초대는 거부할 수 없다.
				PRINTFORMDL 
				PRINTFORMDL 당신은 자신의 %FSYN("penis")%을 그녀의 가장 깊숙한 곳까지 밀어 넣고, 그녀가 요청한 대로 자신의 %SEMEN(,1)%로 그녀의 자궁 안쪽을 풍부하게 표시한다.
				PRINTFORMDW 순수한 쾌감에 압도된 암캐는 떨며 몸을 비틀고, 황홀함으로 가득 찬 그녀의 크고 날카로운 신음 소리가 절정에 달하며 울려 퍼진다.
			CASE 3
				PRINTFORMDL 
				PRINTFORMDL 틈을 빠져나오자, 당신은 이전에 있던 환상향보다 훨씬 음침하고 불쾌한 소란스러운 도시 지역에 도착했다.
				PRINTFORMDL 높은 건물들이 햇빛을 가리고 있으며, 주변에는 빈 캔과 반쯤 피운 담배가 널려 있었다.
				PRINTFORMDW 어쩌면 당신은 이 세계의 어떤 뒷골목에 있는 것일지도 모른다?
				PRINTFORMDL 
				PRINTFORMW 「이런 곳조차 쓸모가 있는 법이다. 자, 가보지 않겠나?」
				PRINTFORMDL 
				PRINTFORMDW 그렇게 말했지만, 그녀는 근처 벽에 단단히 손을 대고 자신의 뒤쪽을 내밀며 흔들면서 당신의 욕정을 분명하게 자극한다.
				CALL 一般依頼15_AEGI_YUKARI
				PRINTFORMDL 
				PRINTFORMDW 유카리의 크고 여자답지 못한 신음이 골목 전체에 울려 퍼진다.
				PRINTFORMDL 
				PRINTFORMDL 언제든 누군가에게 들킬지도 모른다는 스릴이 그녀를 흥분시킨다.
				PRINTFORMDW 당신의 %FSYN("penis")% 그녀의 %FSYN("vagina")% 뒤에서 노크하는 것이 그녀의 몸을 떨리게 만든다.
				PRINTFORMDL 
				PRINTFORMDL 그녀의 신음은 더욱 격렬해지고, 당신이 통제력을 잃으면서 소리도 커진다; 격렬하게 그녀의 안으로 박아 넣으며 골반을 앞으로 내민다.
				PRINTFORMDW 유카리는 당신의 %SEMEN()%이 자궁 입구를 지나 몇 번 분출된 후 큰 절정에 몸을 떨었다.
				PRINTFORMDL 
				PRINTFORMDW 여전히 숨을 몰아쉬며, 유카리는 이제 힘이 빠진 당신의 %FSYN("penis")% 앞에 무릎을 꿇었다.
				PRINTFORMDL 
				PRINTFORMDL 그녀가 애정 가득한 클리닝 블로우잡을 해준 후, 당신의 성기는 예전의 단단함을 되찾는다.
				PRINTFORMDW 골목은 다시 관능적인 여자의 큰 신음으로 가득 찬다.
				;ここまで書いといてなんだけどいまいちピンと来なかったのでコメントアウトしとく
				;加筆してみました。イマイチだったら再度コメントアウトして、SELECTCASE:RANDの値を4にセットし直してください(2023/03/18)
			CASE 4
				PRINTFORMDL 
				PRINTFORMDL 당신이 그 틈에서 걸어 나온 앞에 펼쳐진 것은 이상으로 같으면서도 어딘가 다른 환상향의 학교와 유사한 광경이었다.
				PRINTFORMDW 가지런히 줄지어 있는 의자와 책상들, 칠판, 구석의 스피커, 그리고 연단. 이것이... 외부 세계의 "학교"일까?
				PRINTFORMDL 
				PRINTFORMW 「후훗, 마음에 들었나요?」
				PRINTFORMDL 
				PRINTFORMDL 평소보다 약간 높은 목소리를 듣고, 당신은 그 소리가 어디서 들렸는지 확인하기 위해 뒤돌아본다.
				PRINTFORMDL 그곳에는 교복을 입은 유카리가 창가에 서 있는 것이 보인다.
				PRINTFORMDL 그녀는 평소 모습보다 조금 더 어린 듯, 더욱 순수한 분위기를 풍긴다.
				PRINTFORMDW 확실하지 않지만... 그녀는 몸집도 조금 더 작아 보였다.
				PRINTFORMDL 
				PRINTFORMW 「나는 환경에 더 잘 어울리도록 목소리와 용모를 바꿨다. 그게 다 전체적인 이미지 연기니까, 있잖아.」
				PRINTFORMDL 
				PRINTFORMDL 그러고 유카리는 당신을 가리킨다.
				PRINTFORMDW 당신 또한 교복을 입고 있다는 것을 깨닫는다!
				PRINTFORMDL 
				PRINTFORMDL 당신의 혼란을 보며 킥킥거리던 그녀는 유혹적인 걸음으로 다가와 무언가 기억해낸 듯 당신에게 가까이 속삭였다.
				PRINTFORMDL 
				PRINTFORMW 「아, 그러면서 우리 서로 부르는 호칭부터 바꿔보는 건 어때?」
				PRINTFORML 
				PRINTFORMDL 그녀는 눈을 반쯤 감은 관능적인 시선으로 당신을 올려다보며 당신의 귓가에 속삭인다.
				PRINTFORML 
				CALL HPH_PRINT("「자, 이제 우리 즐길 준비를 할까, 응? ――선배HPH」","W")
				CALL 一般依頼15_AEGI_YUKARI
				PRINTFORMDL 
				PRINTFORMDW 두 개의 책상을 임시 침대로 사용하며 그녀의 등이 차가운 표면에 기대어 당신과 사랑을 나눈다.
				PRINTFORMDW %BREAKENG(@"교실의 공허함을 울리는 소리들은 오직 너의 거친 숨소리와 책상의 불규칙한 삐걱거림, 그리고 네 사랑스러운 \”주니어\”...")%
				PRINTFORML 
				PRINTFORMDW 유카리에 대한 이 완전히 새로운 관점은 당신이 새로 얻은 활력으로 그녀에게 돌진할 때 당신의 흥분을 더욱 고조시킨다.
				PRINTFORMDW %BREAKENG(@"당신의 신음소들이 \”주니어\” 강도를 따라가며 더 크고 극단적으로 변하고 그녀의 순진한 모습과 큰 대조를 이루는")%
				PRINTFORMDW %BREAKENG(@"그러고는 그녀의 자궁 깊숙이 많은 것들의 첫 번째 거대한 양을 받아낸 후, 유카리는 온몸을 최대한 뒤로 젖히며 이에 걸맞은 분수처럼 뿜어져 나오는 조수로 격렬한 절정에 이른다.")%
				PRINTFORML 
				CALL HPH_PRINT("「선배... HPH 선배... HPH」","L")
				PRINTFORMDL 그녀는 황홀함 속에서 부드럽게 한숨을 쉬며, 오르가슴의 여운 속에 몸을 떨며 천천히 가라앉는다.
				PRINTFORMDW %BREAKENG(@"그 말을 듣자마자 네 거기는 거의 즉시 힘을 되찾고 망설임 없이 너의 타락한 \”주니어\”의 매끄러운 작은 구멍")%
				PRINTFORMDW %BREAKENG(@"정액으로 더럽혀 수업에 적합하지 않은 교복이 된 것을 신경 쓰지 않고, 유카리의 만족스러운 쾌감의 목소리가 다시 폐허가 된 교실을 울렸다...")%
		ENDSELECT
		RETURN 1
ENDSELECT
