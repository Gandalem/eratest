	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「우리가 음과 양의 영원한 순환 속에 잡힌 우로보로스 같은 존재인 것만 같다.」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「음마아~~흐읍」","W"
				PRINTFORMDW 유카리가 당신의 사정을 감지하면, 그녀는 능숙하게 혀로 그것을 부추긴다.
				CALL HPH_PRINT,@"「빨리 와서 네 거(cock milk)를 마시게 해줘 HPH」","W"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「음...흐읍 %RANDKISS("kiss")%흐읍 ...곧 사정할 거야? 안에서 올라오는 정액 냄새가 나네, 흐읍」","W"
				PRINTFORMDW 유카리가 당신의 사정을 감지하면, 그녀는 능숙하게 혀로 그것을 부추긴다.
			ELSE
				CALL HPH_PRINT,@"「음므으으응흐읍 응흐읍」","W"
				PRINTFORMDW 유카리가 당신의 사정을 감지하면, 그녀는 능숙하게 혀로 그것을 부추긴다.
				CALL HPH_PRINT,@"「당신의 성기가 지금 내 온몸에 정액을 뿌리고 싶다고 말하고 있어...HPH」","W"
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~」
				PRINTFORMDW 유카리가 네 사정이 임박했음을 감지하면 그녀는 능숙하게 자신의 혀로 그것을 부추었다.
				CALL HPH_PRINT,@"「빨리 가서 물이나 가져와」","W"
			ELSEIF RAND:2 == 0
				PRINTFORMW 「음... 거의 다 왔어~」
				PRINTFORMDW 유카리가 너의 사정이 임박했음을 감지하면, 그녀는 능숙하게 혀로 그것을 부추긴다.
			ELSE
				CALL HPH_PRINT,@"「음... 그 짙은 남성적인 맛이 느껴지기 시작하는군」","W"
				PRINTFORMDW 유카리가 당신의 사정을 감지하면, 그녀는 능숙하게 혀로 그것을 부추긴다.
			ENDIF
		ENDIF
		;舌3以上
	ELSEIF ABL:舌 > 2
		;精液中毒4以上
		IF ABL:精液中毒 > 4
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「흐으...후헵 %RANDKISS("suck")%후헵」","W"
				CALL HPH_PRINT,@"「네 음낭의 분비물 냄새가 마음에 들기 시작하는 것 같아... HPH」","W"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「음므흐프흐프흐프」","W"
				CALL HPH_PRINT,@"「나에게 네 맛을 각인시켜줘, 그래야 영원히 잊지 않을 테니까 HPH」","W"
			ELSE
				CALL HPH_PRINT,@"「응흐읍핥흑」","W"
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「음~」
				CALL HPH_PRINT,@"「내 혀로 네가 사정하게 만드는 게 점점 익숙해지고 있어 HPH」","W"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「음... 궁금하네...후프」","W"
			ELSE
				PRINTFORMW 「음, 핥는다...」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「Nm... %RANDKISS("kiss")%...HPH」","W"
			PRINTFORMW 「나 많은 페니스를 핥아본 적이 없어서, 나 좀 기다려줘야 할 거야.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...%RANDKISS("kiss")% ...음...」
		ELSE
			PRINTFORMW 「...음... 추우...」
			PRINTFORMDW 유카리는 다소 어색하게 네 성기를 입에 넣는다.
		ENDIF
	ENDIF
ENDIF
