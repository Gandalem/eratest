;================================
;custom com
;y is the id of the button, range from 0 to 29
;カスタムコマンド、0~29まで設定可能
;使用する際はSKIPSTART~SKIPENDを外してください。
;================================

;コマンド名
@KOJO_COM_NAME_K26_0
IF TALENT:体型 < 0
	RESULTS = Grow
ELSE
	RESULTS = Shrink
ENDIF

;judge
;judge the button can be shown, if return 1, it will show
;コマンド使用条件、通常のCOM_ABLE関数と同じくRETURN 1すれば実行可能としてコマンドが表示される
@KOJO_COM_ABLE_K26_0
SIF !SHIRAHU(TARGET)
	RETURN 0
SIF !TALENT:恋慕 && !TALENT:愛欲
	RETURN 0
SIF TALENT:年齢 == -1 || TALENT:幼児／幼児退行
	RETURN 0
SIF !CFLAG:うふふ
	RETURN 0

RETURN 1

;================================
;実行可能判定に係る部分、通常は書かなくてよい
@KOJO_COM_K26_0
CALL SET_KOJO_COLOR()
IF !TCVAR:390
	TCVAR:390 = 1
	TCVAR:391 = TALENT:体型
	TCVAR:392 = TALENT:バストサイズ

	IF TALENT:体型 < 0
		PRINTFORML 「So you'd like something a little more mature today?」
		PRINTFORML 「Fufu, allow me to endulge you, then.」
		PRINTFORMDL Yukari grows taller, taking on an air of maturity.
		TALENT:体型 = 0
		IF TALENT:バストサイズ < 0 ;can ask to make breasts match her new size, but not shrink them if they're already fitting
			PRINTFORMDL Should her breasts be adjusted, too?
			CALL ASK_YN
			IF !RESULT
				PRINTFORML 「They're very nice, aren't they?」
				TALENT:バストサイズ = 1
			ELSE
				PRINTFORML 「This suits me fine.」
			ENDIF
		ENDIF
	ELSE
		PRINTFORML 「So you have these kinds of tastes as well, hmm?」
		PRINTFORML 「Alright then, allow me to accept all of your desires.」
		PRINTFORMDL Yukari shrinks down, taking on a childlike form.
		TALENT:体型 = -2
		IF TALENT:バストサイズ > 0 ;can ask to make breasts match her new size, but not grow them if they're already fitting
			PRINTFORMDL Should her breasts be adjusted, too?
			CALL ASK_YN
			IF !RESULT
				PRINTFORML 「Is it to your liking?」
				TALENT:バストサイズ = -1
			ELSE
				PRINTFORML 「Don't worry, I will accept this side of you as well.」
			ENDIF
		ENDIF
	ENDIF
ELSE
	PRINTFORML 「Are you satisfied already?」
	PRINTFORMDL Yukari returns to her original form.
	TALENT:体型 = TCVAR:391
	TALENT:バストサイズ = TCVAR:392
	TCVAR:390 = 0
	TCVAR:391 = 0
	TCVAR:392 = 0
ENDIF
