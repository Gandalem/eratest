;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K26_80
CALL M_KOJO_MESSAGE_COM_K26_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「내 손으로 당신을 문지르길 원해? 내 손가락이 그렇게 마음에 들어?」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「너무 뜨겁고 너무 힘들다... HPH」","W"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「뜨거울 때의 철봉 같아서 갖고 싶어~」
		ELSE
			CALL HPH_PRINT,@"「음, 당신의 페니스는 전부 쿠퍼액으로 뒤덮여 있네~ 맛있어 보여HPH」","W"
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「내 손놀림을 음미해봐 HPH」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「후훗, 이거 하면서 즐거워HPH」","W"
		ELSE
			CALL HPH_PRINT,@"「이거 잘하게 됐어, 네 거에 손가락으로 그림 그리기. 그렇지? HPH」","W"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「이게 이걸 해야 하는 방식인가...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이건 내 손가락의 본래 용도가 아니란 걸 알잖아.」
		ELSE
			PRINTFORMW 「흠, 이렇게 하면 될까?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
