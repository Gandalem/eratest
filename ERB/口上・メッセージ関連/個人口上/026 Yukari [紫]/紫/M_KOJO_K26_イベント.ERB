;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K26_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
CALL M_KOJO_COLOR_K26
	;仕事中、今日会ってない。
	IF CFLAG:行動 == 5 && !TCVAR:26:今日会ったか && GROUPMATCH(ARG, 1, 2, 6, 7) && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		PRINTFORMW 「I'm working today, so don't bother me.」
	;今日会ってない。
	ELSEIF !TCVAR:26:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K26
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「...I have no interest in you, so leave my sight.」
			;屋外かつ満月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「Oho? It's %CALLNAME:MASTER%.」
				PRINTFORMW 「What am I doing?」
				PRINTFORMW 「——The moon is beautiful tonight, so I came to watch it.」
			ELSEIF TALENT:恋人
				IF RAND:3 == 0
					PRINTFORMW 「Oho? %CALLNAME:MASTER%, whatever shall we do today?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, I've been looking for you, what are your plans for today?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, did you come to see me?」
					PRINTFORMDW Yukari does a slight wave and greets you.
					CALL HPH_PRINT,@"「These eyes of mine don't miss a thing, %CALLNAME:MASTER%HPH」","L"
				ENDIF
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「Pleased to see you, %CALLNAME:MASTER%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, I'm glad to see you again.」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, how have you been?」
					PRINTFORMDW Yukari greets you cheerfully when she notices you.
					PRINTFORMW 「As for me, I'm doing fine. However, did you need anything?」
				ENDIF
			ELSEIF TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「What are you doing right now?」
					PRINTFORMW 「If you're searching for something, there are others who specialize in that sort of thing.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, what's the matter?」
				ELSE
					PRINTFORMW 「Oho, %CALLNAME:MASTER%. You seem to be in good health.」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「Oho, %CALLNAME:MASTER%, you appear to be doing well.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, I trust you're well today?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, what a coincidence!」
					PRINTFORMW 「But is it a coincidence? Or perhaps we were fated to meet today?」
				ENDIF
			ENDIF
			
			;custom code
			IF !TALENT:1:キス未経験 && STRLENS(CSTR:1:ファーストキス喪失履歴) && FIRSTTIME("ReimuKiss")
				PRINTFORML
				PRINTFORMW 「...It's you, you're the cause of this.」
				PRINTFORMDW Surprised by the sudden rebuke, you turn around to find Yukari standing there, when you're sure you were alone a moment ago...
				PRINTFORMW 「Reimu has been behaving somewhat oddly lately, and it was starting to concern me.」
				PRINTFORMW 「But it seems that it wasn't anything all that much out of the ordinary. Well, in any case, I wish you luck～」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K26
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「...I have no interest in you, so leave my sight.」
			;屋外かつ満月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「Oho? %CALLNAME:MASTER%, the moon is beautiful tonight, is it not?」
			ELSEIF TALENT:恋人
