@M_KOJO_SPEVENT_K26_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
CALL M_KOJO_COLOR_K26
IF LOCAL
	PRINTFORMW 「%CALLNAME:MASTER%.」
	PRINTFORMDW As if it were natural, Yukari suddenly stops and calls your name. She gently reaches for your face.
	PRINTFORMW 「Every time I look at them, your eyes are so uneasy, %CALLNAME:MASTER%.」
	PRINTFORMDW While saying that, she kisses your lips.
	PRINTFORMW 「Nnmh... This is my way of expressing gratitude for everything. You're always entertaining me after all.」
	PRINTFORMDW After she finishes saying that, Yukari promptly disappears into a gap before you can even muster a reply.
	PRINTFORMW 
	PRINTFORMW （I might have done something foolish...）
	PRINTFORMDW She thinks to herself as she rubs her blushing cheeks on her way home.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1

;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
@M_KOJO_SPEVENT_K26_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
CALL M_KOJO_COLOR_K26
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;『硝子の中の幻想郷』
		;初回
		IF FIRSTTIME(1026)
			PRINTFORMW 「%CALLNAME:MASTER%.」
			PRINTFORMDW Yukari speaks in an unusually fragile tone.
			PRINTFORMW 「You don't have to be so on edge... I'm not going to capture and devour you.」
			PRINTFORMW 「But, in a similar fashion, I may have been the one that's been captured.」
			PRINTFORMW 「There exists a thing called lovesickness, right? In harsher words, an incurable disease——a mental illness.」
			PRINTFORMW 「Perhaps residing in something like a sanatorium would be appropriate, but unfortunately, this is Gensokyo.」
			PRINTFORMW 「Even though my friend has passed on, she might burst into laughter if she heard that I'm in love after all this time. However——」
			PRINTFORMDW Having let that out, Yukari places her hands on your face.
			PRINTFORMW 
			PRINTFORMW 「——%CALLNAME:MASTER%, I love you.」
			PRINTFORMW 
			PRINTFORMW 「Will you accept my feelings?」
			PRINTFORMDW The serious expression on the sage's face looks like she is on the verge of breaking down into tears.
			PRINTFORMW 「I really enjoy the time I spend with you, %CALLNAME:MASTER%.」
			PRINTFORMW 「I'm really happy whenever I'm with you, %CALLNAME:MASTER%.」
			PRINTFORMW 「However, it saddens me so much to think that one day it will inevitably end.」
			PRINTFORMW 「As if everything were but an illusion in the looking-glass.」
			PRINTFORMW 「But despite that, my feelings for you right now are unchanging, %CALLNAME:MASTER%.」
			PRINTFORMW 「Will you accept my love?」
			PRINTFORMDW She bows her head, trembling a little as she appeals to you.
		;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%.」
			PRINTFORMDW Yukari 's words are tinged with sadness, but nonetheless she entreaties you.
			PRINTFORMW 「Can you not accept me after all?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;『胡蝶の夢』
		;そもそも荘子の言う所の胡蝶の夢は夢の中で蝶になっていること自体になんら意味はなく、蝶は蝶で荘子は荘子として励めばいいという所、つまりどちらが夢でどちらが現実かというのは文字通りの問題外とかなんとか。
		;includes a short passage that alludes to the meta topic of the game as a whole. took me forever to find out info about 邯鄲の枕, or apparently "the world inside a pillow". 
		PRINTFORMW 「...Thank you.」
		PRINTFORMDW Saying those words of gratitude, she turns around to you——
		PRINTFORMDW Why is eternal love sought after in a such a finite world as this?
		PRINTFORMDW It may be instinct as a living creature to love and respect others.
		PRINTFORMDW But, wherein lies the enjoyment of romance? Is it the process as a whole?
		PRINTFORMDW Or, even if it's fake, if this life is but an illusion inside a pillow——it's possible that everything is worthless, yet everything has value.
		PRINTFORMW 「From now on, let us enjoy this world together.」
		PRINTFORMW 「For nothing has changed as of yet. The pleasant times and the sorrowful moments, such happiness awaits us.」
		PRINTFORMW 「No matter what the future may turn out to be, I'm positive I will love you, %CALLNAME:MASTER%.」
		PRINTFORMDW ——Yukari says with the brightest smile she can muster.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 
		PRINTFORMDW In the end, it's one's own land of fantasy after all...
		PRINTFORMW 
		RETURN 1
	ENDIF

ENDIF
RETURN 1

