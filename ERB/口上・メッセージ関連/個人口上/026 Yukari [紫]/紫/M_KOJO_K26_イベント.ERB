		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		IF TALENT:恋人
			PRINTFORMW 「Fuwaa～ ...Oh my? Did I oversleep?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Fuwaa～ %CALLNAME:MASTER%, good morning♪」
		ELSEIF TALENT:思慕
			PRINTFORMW 「Fuwaa～ Good morning, %CALLNAME:MASTER%.」
		ELSE
			PRINTFORMW 「Fuwaa～ ...Oho? You sure got up early.」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	;PRINTFORMW 「Ara, good morning, %CALLNAME:MASTER%.」
