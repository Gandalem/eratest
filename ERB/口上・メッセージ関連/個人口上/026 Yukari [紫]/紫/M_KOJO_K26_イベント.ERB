				ENDIF
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, what were you doing in such a place?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「I searched everywhere, but you were here all along, it seems.」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%.」
					PRINTFORMDW All of a sudden, Yukari arrives and calls out to you.
					PRINTFORMW 「Hey, %CALLNAME:MASTER%, what are you looking at?」
				ENDIF
			ELSEIF TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「Oho? What a coincidence, it's %CALLNAME:MASTER%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, I hope you haven't run into any wicked youkai lately?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, what are you up to?」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「I'm glad you seem to be doing well.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「Do you have some business around here, I wonder?」
				ELSE
					PRINTFORMW 「Oho, %CALLNAME:MASTER%, you seem to be in good health.」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;風呂のやつって浴場で遭遇と違うのかわからん
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF TALENT:妻 ;custom code
				PRINTFORMW 「Let's get in together today. I'll go ahead and wash your back.」
			ELSEIF TALENT:恋人
				PRINTFORMW 「Let's get in together.」
				PRINTFORMW 「...We look like a married couple, don't we? Teehee～」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「Oho? There's already someone in the bath?」
				PRINTFORMDW Saying this, Yukai just barges right inside without bothering to ask permission.
				PRINTFORMW 「It's fine, it's not like we're strangers or anything～」
			ELSEIF TALENT:思慕
				PRINTFORMW 「Arara? Maybe you knew I was headed here and rushed to get here too?」
				PRINTFORMW 「I seem to be quite popular right now～」
			ELSE
				PRINTFORMW 「I don't mind a bit, let's get in together.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			IF TALENT:恋人
				PRINTFORMW 「Oops, I'm sorry for the disturbance.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「I don't want to be a bother since you're already here, I'll have my chance in a bit.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「...Pardon me.」
			ELSE
				PRINTFORMW 「Oho? Taking advantage of all the perks, are we?」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			IF TALENT:恋人
				PRINTFORMW 「Mixed bathing will have to wait for another opportunity♪」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「Sometimes I just want to relax alone, because I'm a hard-working youkai, you know♪」
			ELSEIF TALENT:思慕
				PRINTFORMW 「...I'm sorry, but I'm going to have to ask you to leave me alone.」
			ELSE
				PRINTFORMW 「How do they say it, "Ladies First"? My apologies.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K26
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「...I have no interest in you, so leave my sight.」
			;屋外かつ満月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「Oho? It's %CALLNAME:MASTER%.」
				PRINTFORMW 「What am I doing?」
				PRINTFORMW 「——The moon is beautiful tonight, so I came to watch it.」
			ELSEIF TALENT:恋人
				IF RAND:3 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, if you aren't busy, mind giving me some company?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, I've been looking for you, where are you going today?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, did you come to see me?」
					PRINTFORMDW Yukari does a slight wave and greets you.
					CALL HPH_PRINT,@"「I can tell everything with these eyes of mine, %CALLNAME:MASTER%HPH」","W"
				ENDIF
			ELSEIF TALENT:恋慕
				IF RAND:3 == 0
					PRINTFORMW 「I wonder what your plans are for today, %CALLNAME:MASTER%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, pleased to see you once more.」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, how have you been?」
					PRINTFORMDW Yukari greets you cheerfully when she notices you.
					PRINTFORMW 「As for me, I'm doing fine. However, did you need anything?」
				ENDIF
			ELSEIF TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「It's nice to see you, %CALLNAME:MASTER%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, what are you doing here?」
				ELSE
					PRINTFORMW 「Waa～!」
					PRINTFORMDW Yukari sneaks up behind you and startles you with a sudden shout, followed by a giggle.
					PRINTFORMW 「I just felt like giving you a little surprise, don't be upset～」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「Oho, %CALLNAME:MASTER%. You seem to be in good health.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%CALLNAME:MASTER%, you're doing well, I trust?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, what a coincidence!」
					PRINTFORMW 「But is it a coincidence? Or perhaps we were fated to meet today?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		;few of these are vague as hell without knowing the author's intentions
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			IF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 1
			;怒り 恋慕時 デート相手が霊夢
				PRINTFORMW 「...Is it fine to assume that you're on a date with Reimu?」
			;怒り 恋慕時 デート相手が妖夢
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 23
				PRINTFORMW 「...It seems Youmu also has the same bad taste.」
			;怒り 恋慕時 デート相手が橙
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 24
				PRINTFORMW 「...You damned lolicon.」
			;怒り 恋慕時 デート相手が藍
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 25
				PRINTFORMW 「...Ran, when did your standards drop so low?」
			;怒り 恋慕時 デート相手が天子
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 34
				PRINTFORMW 「...That is some truly bad taste.」
			;怒り 恋慕時 デート相手が華扇
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 43
				PRINTFORMW 「...I thought you were on my side. Am I wrong?」
			;怒り 恋慕時 デート相手が幽々子
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 66
				PRINTFORMW 「...Yuyuko, as a word of advice to my dear friend, you should stop associating with %HIM_HER(MASTER,,1)%.」
			;怒り 恋慕時 デート相手が隠岐奈 (phrase 外堀を埋める)
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 124
				PRINTFORMW 「...I see you're making steady progress in removing obstacles in the way of your objective, huh?」
			;怒り
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「...Aah, I just got angry now, didn't I?」
			ELSEIF TALENT:恋慕 && ARG:1 == 1
			;恋慕時 デート相手が霊夢
				PRINTFORMW 「Oho, what have we here? Instead of me, do you prefer Reimu?」
			;恋慕時 デート相手が妖夢
			ELSEIF TALENT:恋慕 && ARG:1 == 23
				PRINTFORMW 「I recall Youmu being well acquainted with another man.」
			;恋慕時 デート相手が橙
			ELSEIF TALENT:恋慕 && ARG:1 == 24
				PRINTFORMW 「Fufu, to think I could become jealous of Chen.」
			;恋慕時 デート相手が藍
			ELSEIF TALENT:恋慕 && ARG:1 == 25
				PRINTFORMW 「Ran, to think you could be this wily as well.」
			;恋慕時 デート相手が天子
			ELSEIF TALENT:恋慕 && ARG:1 == 34
				PRINTFORMW 「You're as irritating as ever... To think you'd go as far as to steal %HIM_HER(MASTER,,1)% away from me...!」
			;恋慕時 デート相手が華扇
			ELSEIF TALENT:恋慕 && ARG:1 == 43
				PRINTFORMW 「Is it fine for a hermit such as yourself to become distracted by lust?」
			;恋慕時 デート相手が幽々子
			ELSEIF TALENT:恋慕 && ARG:1 == 66
				PRINTFORMW 「Yuyuko, my good friend, my rival.」
			;恋慕時 デート相手が隠岐奈
			ELSEIF TALENT:恋慕 && ARG:1 == 124
				PRINTFORMW 「It seems we both share the same fine tastes, hmm...?」
			ELSEIF TALENT:恋人
				PRINTFORMW 「I don't mind yourself becoming overrun with your lust, however do not forget about me.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「...Right, someone that's not me.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「I wonder if those who're just in the way should leave?」
			ELSE
				PRINTFORMW 「Oho? Am I perhaps intruding on you?」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

