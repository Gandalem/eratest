			PRINTFORMW 「Is it already noon? It'll be a problem if you lose your sense of time, you know.」
		ELSE
			PRINTFORMW 「Would it be better if I made breakfast with a naked apron?」
			PRINTFORMDW Yukari gives you a laughing smile while cracking a joke.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			CALL HPH_PRINT,@"「Oho, %CALLNAME:MASTER%, good morningHPH」","W"
			PRINTFORMDW Yukari happily greets you as dawn's rays stream across her face.
			PRINTFORMW 「Would it be alright if we slept a little longer? I love your cute face♪」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%, did you wake up?」
			PRINTFORMDW Yukari sweetly greets you in the morning.
			PRINTFORMW 「I wish I could gaze at your sleeping face even more...」
		ELSEIF TALENT:思慕
			PRINTFORMW 「%CALLNAME:MASTER%, good morning♪」
			PRINTFORMDW Yukari gives you a chipper morning greeting.
			PRINTFORMW 「Is it already noon? It'll be a problem if you lose your sense of time, you know.」
		ELSE
			PRINTFORMW 「Would it be better if I made breakfast with a naked apron?」
			PRINTFORMDW Yukari gives you a laughing smile while cracking a joke.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
