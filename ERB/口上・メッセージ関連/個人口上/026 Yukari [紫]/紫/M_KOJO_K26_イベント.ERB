@M_KOJO_EVENT_K26_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「헤이, %CALLNAME:MASTER%, 데이트는 어때?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 여행을 가고 싶어?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%, 지금 시간 돼?」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 재미있는 거 같이 할래?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「즐거운 저녁을 보내길 바라, %CALLNAME:MASTER%.」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「후후, 우리가 어떤 사건처럼 오해받지는 않았으면 좋겠어.」
				ELSEIF TALENT:思慕
					PRINTFORMW 「이것을 레이무에게 비밀로 해라. 그렇지 않으면 너는 토벌 대상이 될 테니까.」
				ELSE
					PRINTFORMW 「자, 그럼 판타지 대륙이 무엇을 선사하는지 한번 보자.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「후훗, 다음 기회에.」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「오 이런, 정말 안됐네.」
				ELSEIF TALENT:思慕
					PRINTFORMW 「아라라, 난 랜에게 유혹의 방법을 배워야겠어.」
				ELSE
					PRINTFORMW 「얼마나 충격적으로 불운한가.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「네가 여기 있으니 내 방으로 들어오는 게 어때?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「흥미로운 것들을 볼 수도 있겠지만, 안으로 들어오는 건 어때?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「집 구하는 거 좀 해보고 싶지 않아?」
				ELSE
					PRINTFORMW 「차 좀 드시겠어요?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「이제 하루 종일 함께 보낼 수 있어, %CALLNAME:MASTER%♪」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「후후, 이제 후회하지 마라.」
				ELSEIF TALENT:思慕
					PRINTFORMW 「네가 무엇을 두려워하는지 잘 모르겠어, %CALLNAME:MASTER%.」
				ELSE
					PRINTFORMW 「그러니 이 틈으로 들어와라―」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「아쉽지만 언제든지 들러도 돼.」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「오, 그래? 정말 실망스럽네.」
				ELSEIF TALENT:思慕
					PRINTFORMW 「하지만 정말 드문 기회이기도 해.」
				ELSE
					PRINTFORMW 「음, 참 현명하시네요.」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
