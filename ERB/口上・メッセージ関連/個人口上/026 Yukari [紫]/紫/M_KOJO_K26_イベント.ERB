;相手が押し倒しを解除
;==================================================
@M_KOJO_EVENT_K26_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
CALL M_KOJO_COLOR_K26
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
	;疲れた
		CALL HPH_PRINT,@"「I can't... go on...HPH」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
	;満足して解放
		CALL HPH_PRINT,@"「Fuuh... That felt amazing...HPH」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
	;満足したところを押し倒された
		CALL HPH_PRINT,@"「Phew... I can't keep...HPH」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
	;壊れるまでしてあげる
		CALL HPH_PRINT,@"「I'll make sure that you don't come back to...HPH」","W"
		RETURN 1
	ENDIF
ENDIF
RETURN 1

