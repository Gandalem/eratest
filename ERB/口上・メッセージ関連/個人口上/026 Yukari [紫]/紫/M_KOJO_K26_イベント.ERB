	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
		;誘い文句
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORMW 「Hey, %CALLNAME:MASTER%, how about a date?」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%, would you like to go on a trip?」
			ELSEIF TALENT:思慕
				PRINTFORMW 「%CALLNAME:MASTER%, are you free right now?」
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%, do you want to tag along for some entertainment?」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 1
		;受けた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORMW 「I hope we'll have a fun evening, %CALLNAME:MASTER%.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「Fufu, I hope we won't be mistaken for some kind of incident happening.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「Keep this a secret from Reimu. Else you'll be an extermination target.」
			ELSE
				PRINTFORMW 「Well then, let us see what the land of fantasy has to offer.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 2
		;断った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORMW 「Fufu, next time, then.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「Oh my, how unfortunate.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「Arara, I'll have to make Ran teach me the ways of seduction.」
			ELSE
				PRINTFORMW 「How shockingly unfortunate.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 3
		;部屋に誘われた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORMW 「Since you're here, why not come into my room?」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「You may see some interesting things, but how about coming inside?」
			ELSEIF TALENT:思慕
				PRINTFORMW 「Aren't you curious to try a little house-hunting?」
			ELSE
				PRINTFORMW 「Would you like some tea?」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 4
		;部屋に誘われたのを受けた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORMW 「Now we can spend all day together, %CALLNAME:MASTER%♪」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「Fufu, don't regret it now.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「I'm not sure what you're afraid of, %CALLNAME:MASTER%.」
			ELSE
				PRINTFORMW 「Then, come into this gapー」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 5
		;部屋に誘われたのを断った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORMW 「How unfortunate, but you can stop by anytime.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「Oh, is that so? How disappointing.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「It's such a rare opportunity, though.」
			ELSE
				PRINTFORMW 「Well, how wise of you.」
			ENDIF
			RETURN 1
		ENDIF
	ENDSELECT
ENDIF
RETURN 1

