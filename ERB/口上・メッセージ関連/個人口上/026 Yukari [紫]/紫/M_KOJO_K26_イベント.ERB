@M_KOJO_EVENT_K26_18(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
CALL M_KOJO_COLOR_K26
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;避妊要求台詞
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:318 == 1
			PRINTFORMW 「...How brazen of you to even dare to suggest such a thing.」
		ELSEIF TALENT:恋人
			PRINTFORMW 「Hmmm, doing it raw, you ask?」
			PRINTFORMW 「I'm just not quite ready to take that step yet, I suppose?」
			PRINTFORMDW Yukari requests for you to keep using contraceptives.
			CALL HPH_PRINT,@"「But I may be able to give you that permission... one dayHPH」","W"
		ELSEIF TALENT:恋慕
			PRINTFORMW 「It would be troublesome if you don't use contraceptives.」
			PRINTFORMW 「You see, %CALLNAME:MASTER%, I've already made some pretty big concessions when it comes to you.」
			PRINTFORMW 「...My agreement to have sexual relations with you being just one of them.」
		ELSE
			PRINTFORMW 「I have no interest in becoming pregnant with your child.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:318 == 1
			PRINTFORMW 「...Don't you understand? What I meant was that I am absolutely against the idea.」
			PRINTFORMDW Yukari gets flustered as she refuses.
		ELSEIF TALENT:恋人
			PRINTFORMW 「I reiterate... I'm just not ready yet...」
			PRINTFORMW Yukari persists in refusing your request.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「No, I can't agree to any unproductive behavior.」
			PRINTFORMDW Yukari persists in refusing your request.
		ELSE
			PRINTFORMW 「...No means no.」
			PRINTFORMDW Yukari absolutely demands that you use contraception.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断ったのに粘られて切れた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「Enough already! You're testing my patience!」
		PRINTFORMDW Yukari gets visibly angry and her voice rises to a yell, a rare sight for her.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			PRINTFORMW 「...Very well.」
			CALL HPH_PRINT,@"「As long as it's not a dangerous day... Let's use this to enjoy ourselves even more...HPH」","W"
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...Very well.」
			PRINTFORMW 「But only on safe days, you understand?」
		ELSE
			PRINTFORMW 「...I suppose I have no choice.」
			PRINTFORMW 「It's my fault for underestimating the sexual desires of a healthy human male, so I'll take responsibility for that.」
			PRINTFORMW 「But not on dangerous days, though, yes? If you can't at least follow that rule, I may have to resort to more extreme measures.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「...Very well.」
			CALL HPH_PRINT,@"「For the sake of our passionate lovemaking, I'll risk a child... Or twoHPH」","W"
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...Hrm, very well.」
			CALL HPH_PRINT,@"「I've decided that I'm ready too, so let's melt togetherHPH」","W"
		ELSE
			PRINTFORMW 「...Fine... Good grief, I can't believe this...」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
