;特別な日イベント用関数
;==================================================
;-------------------------------------------------
@SPECIALDAY_EVENT_K26
;-------------------------------------------------
CALL M_KOJO_COLOR_K26
	;謹賀新年
	IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1
		IF TALENT:恋人
			PRINTFORMW 「Happy new year, %CALLNAME:MASTER%.」
			PRINTFORMDW Yukari greets the new year with you.
			PRINTFORMW 「I'll be under your care for this year as well♪」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Happy new year, %CALLNAME:MASTER%.」
			PRINTFORMDW Yukari greets the new year with you.
			PRINTFORMW 「Fufu, I hope this year will as enjoyable as well.」
		ELSEIF TALENT:思慕
			PRINTFORMW 「I wish you the best for this new year.」
			PRINTFORMDW Yukari greets the new year with you.
			PRINTFORMW 「What are your aspirations for this year?」
		ELSE
			PRINTFORMW 「I wish you the best for this new year, I hope we get along amicably this year as well.」
		ENDIF
	;バレンタインデー
	ELSEIF DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000
		IF TALENT:恋人
			PRINTFORMW 「%CALLNAME:MASTER%.」
			PRINTFORMDW Yukari timidly calls out your name.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%, this is for you.」
		ELSEIF TALENT:思慕
			PRINTFORMW 「%CALLNAME:MASTER%, a present for you.」
		ELSEIF CFLAG:2 >= 1000
			PRINTFORMW 「%CALLNAME:MASTER%, let me borrow your hand for a moment.」
		ENDIF
		SELECTCASE CFLAG:好感度
		CASE 1000 TO 3000
			PRINTFORMW 「Here you are, friendship chocolate.」
			PRINTFORMDW Yukari hands over some chocolate.
			PRINTFORMW 「It's not exactly heart-throbbing, but it's my thanks for these recent times regardless.」
		CASE 3001 TO 5000
			PRINTFORMDW Yukari gives you chocolate.
			PRINTFORMW 「It wasn't exactly easy to obtain these, so be thankful, alright?」
			PRINTFORMDW A little embarrassed, she quickly separates from you. 
		CASE IS > 5000
			IF EXP:愛情経験 >= 100
				PRINTFORMW 「These are handmade.」
				PRINTFORMDW As she says that, Yukari hands you chocolate.
				PRINTFORMW 「I think... Maybe, probably, definitely that these came out delicious, so... Be sure to enjoy them.」
			ELSE
				PRINTFORMW 「Here, some chocolate.」
				PRINTFORMDW As she says that, Yukari hands you chocolate.
				PRINTFORMW 「These are from the outside world, so I'll have you know that it was quite expensive.」
			ENDIF
		ENDSELECT
	;ハロウィン
	ELSEIF DAY:2 == 3 && DAY:3 == 30
		IF TALENT:恋人
			PRINTFORMW 「%CALLNAME:MASTER%, trick or treat♪」
			PRINTFORMDW Yukari talks to you through a gap.
			PRINTFORMW 「...If you don't give me sweets, I'll play a prank on you.」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Trick or treat♪」
			PRINTFORMDW Yukari says as she calls out to you.
			PRINTFORMW 「Sweets or mischief, which will you choose, %CALLNAME:MASTER%?」
		ELSEIF TALENT:思慕
			PRINTFORMW 「Trick or treat♪」
			PRINTFORMDW Yukari says as she puts her hand around your shoulders.
			PRINTFORMW 「You're always making mischief, %CALLNAME:MASTER%, so I'd appreciate you giving me something instead.」
		ELSE
			PRINTFORMW 「Trick or treat♪」
			PRINTFORMDW It's a little threatening when Yukari is the one saying it.
			PRINTFORMW 「...Real apparitions may exist here, but none that might play a trick on you.」
		ENDIF
	;クリスマス
	ELSEIF DAY:2 == 4 && DAY:3 == 25
		IF TALENT:恋人
			CALL HPH_PRINT,@"「Merry Christmas, %CALLNAME:MASTER%HPH」","W"
			PRINTFORMDW Yukari happily talks to you.
			PRINTFORMW 「Hey... Would you mind if we spent the whole day together today?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Merry Christmas, %CALLNAME:MASTER%♪」
			PRINTFORMDW Yukari greets you with that.
			PRINTFORMW 「...If you're up for it, how about a date? That's right, a Christmas date.」
		ELSEIF TALENT:思慕
			PRINTFORMW 「Merry Christmas, %CALLNAME:MASTER%.」
			PRINTFORMDW Yukari greets you with that.
			PRINTFORMW 「I'm free today so I'll accompany you. It is Christmas, after all.」
		ELSE
			PRINTFORMW 「Merry Christmas, %CALLNAME:MASTER%.」
			PRINTFORMDW Yukari greets you with that.
			PRINTFORMW 「...I don't think I'll be getting a present today, though.」
		ENDIF
	ENDIF
