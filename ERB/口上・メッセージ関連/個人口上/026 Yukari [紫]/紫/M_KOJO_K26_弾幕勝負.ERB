; Modular ERB: 個人口上/026 Yukari [紫]/紫/M_KOJO_K26_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K26_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			;SWR reference, "official" translation
			PRINTFORMW 「너는 아름답지만 잔인하게 지구를 떠나야 한다!」
		ELSEIF RAND:4 == 0
			;PCB Phantasm stage reference, "official" translation
			PRINTFORMW 「불행하게도 당신에게는 나의 단마쿠가 어떤 거미줄보다 더 가늘고 복잡하다.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「내 방벽을 부술 수 있을지 궁금하네.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「잔소리 좀 할 시간이다.」
		ELSE
			PRINTFORMW 「네 자신의 자리를 모르느냐? 네 용기의 어리석음을 깨달아라.」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「내가 방심했어...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「나의 장벽은 수가 적지 않다.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「오 마이? 맞았어?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「방금 뭐에 맞은 거야?」
				ELSE
					PRINTFORMW 「아니, 이대로 가다간 옷이 찢어지겠어.」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「왜, 너!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「음, 내가 처한 상황이 좋지 않군.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「음, 당신은 정말 경험이 많은 분이시네요, %CALLNAME:MASTER%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「네 눈앞에서 벗어날 수 없을 거다!」
				ELSE
					PRINTFORMW 「내가 이 틈으로 단마쿠를 얼마나 더 쏠 수 있을까 궁금하다.」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이대로 계속되면 잘 끝나지 않을 거야.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「도대체 랜과 천은 어디로 간 거지?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「나는 궁지에 몰린 여우가 되어가는 건가?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「나의 마지막 수단을 보여주지.」
				ELSE
					PRINTFORMW 「지금까지 나를 몰아붙인 것에 대해 칭찬해주지.」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「......」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「여기까지 올 거라고는 생각 못 했어...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「인간과 요괴의 경계를 넘어섰을지 궁금하군.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「오호? 내가 진 것 같군.」
				ELSE
					PRINTFORMW 「승리의 색깔은 어떤 것일지 궁금하다.」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF RAND:4 == 0
			PRINTFORMW 「나의 마지막 술법이여, 얼마나 향수를 불러일으키는가.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「나 방심했다고? 좀 더 자세히 봐...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이럴 때 집중력을 흐트러뜨리지 마라.」
		ELSE
			PRINTFORMW 「이것은 카운터 펀치라고 불린다.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		IF RAND:4 == 0
			PRINTFORMW 「이게 네 상대를 네 스스로에게 이용하는 거라고 하는 거니?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「죄송하지만, 그건 안 될 것 같습니다.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「비록 아슬아슬한 상황이었지만 말이야. 그냥 "전혀 안 됐어!"라고 하자!」
		ELSE
			PRINTFORMW 「그렇게 나를 때릴 수는 없을 거야.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				;怒り
				IF CFLAG:318 == 1
					;Hisoutensoku reference, "official" translation
					PRINTFORML 「하늘로 올라간 원숭이는 분노하여 자신의 자리를 거부했다.」
					PRINTFORMW 「결국 그는 산에 감금되었다.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「유감스럽게도, 이것은 당신의 완전한 패배로 끝났다, %CALLNAME:MASTER%.」
				ELSEIF RAND:3 == 0
					;IAMP reference
					PRINTFORMW 「쏘는 것도, 자르는 것도, 찌르는 것도, 때리는 것도, 죽이는 것도... 나한테는 전부 소용없다.」
				ELSEIF RAND:2 == 0
					;SWR reference
					PRINTFORMW 「시간을 멈춘다 해도, 엎질러진 우유는 다시 병에 담을 수 없다. 당신은 그 잔을 우유로 채울 것인가?」
				ELSE
					;IAMP reference
					PRINTFORMW 「비밀 하나 말해주지... 나는 약점이 없어.」
				ENDIF
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「당신은 내가 당신을 해체하는 것을 선호합니까, 아니면 제가 당신의 살점만 발라내는 것을 선호합니까?」
				ELSEIF RAND:4 == 0
					;IAMP reference
					PRINTFORMW 「겐소쿄는 모든 것을 받아들이고 그것은 잔혹하고 잔혹한 일이다.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「쏘는 것도, 자르는 것도, 찌르는 것도, 때리는 것도, 죽이는 것도... 나한테는 전부 소용없다.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「유감스럽게도 당신만큼 약하지는 않다.」
				ELSE
					PRINTFORMW 「나는 민들레로부터 더 힘든 도전을 받아왔다.」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이것이 바로 내가 그렇게 골치 아파하는 이유다.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「너... 너 나에게 꽤 상처를 줬어.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「글쎄? 이제 좀 익숙해졌나?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「우리가 대등하게 시작했음에도 불구하고, 나는 여전히 우월하다.」
				ELSE
					PRINTFORMW 「ran과 맞선다면 이길 수도 있을 것이다.」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「고집 센 사람들은 정말 싫어해.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「너에게 재능이 있구나, %CALLNAME:MASTER%.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「당신은 대단한 상대였습니다, %CALLNAME:MASTER%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「어때요? 사건을 해결해 보는 건 어때요?」
				ELSE
					PRINTFORMW 「비록 종이처럼 가볍게 보일지라도, 당신과 나 사이의 간격은 산즈 강 자체보다 더 넓다.」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...믿을 수 없어, 하필 나 같은 사람에게 여기까지 오게 하다니...!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「나를 이기려면 사려 깊은 양의 기술이 필요하다.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「너는 레이무보다 강할지도 몰라.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「첸과 랜과 함께 싸웠어야 했을까?」
				ELSE
					PRINTFORMW 「다시 나랑 스파링 할래?」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
