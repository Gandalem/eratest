		ELSE
			CALL HPH_PRINT,@"「내 작은 오므림에 꽤 자신 있다」","W"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「아무리 그것을 쳐다봐도 주름의 개수는 늘지 않는다~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「여기에 넣을 생각은 없으신가요?」
		ELSE
			PRINTFORMW 「내 약점 중 하나처럼 보이니?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
