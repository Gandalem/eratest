;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K26_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K26_300
RETURN 1

@M_KOJO_MESSAGE_COM_K26_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K26_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「어떻게 감히 남의 얼굴을 그렇게 직설적으로 들여다볼 수 있지?!」
		PRINTFORMDW 유카리는 분노로 가득 찬 목소리로 응수한다.
		;会話不能
	ELSEIF TCVAR:302
		PRINTFORMW 「......」
		PRINTFORMDW 유카리는 침묵을 지킨다.
	ELSEIF TFLAG:193 == -2
		IF RAND:5 == 0
			PRINTFORMW 「너도 좀 스스로 공부하는 게 어때?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「요정들과 대화를 나누는 것이 더 즐거울지도 모른다.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「어찌나 지루한지. 사실, 네 한계에 도달했어.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「내가 네가 공부하는 걸 지켜봐 주는 건 어때?」
		ELSE
			PRINTFORMW 「죄송하지만 좀 더 똑똑해지세요.」
		ENDIF
		;ミニマップ時のみ
		;条件をメインマップ時にできなくもないけど面倒
		;現在位置が墓
	ELSEIF CFLAG:MASTER:現在位置 == 150
		IF RAND:5 == 0
			PRINTFORMW 「묘지 도굴반인 척하고 싶었다면 혼자서도 충분했을 것이다.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「이 길이 지하세계로 이어질지 궁금하다.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「이상한 거 본 적 있나? 나도 이 주변에서 많은 걸 봤거든.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「장례도, 사후 의식도 필요 없다면, 이곳의 승려들이 당신을 원망하기 시작할지도 모른다.」
		ELSE
			PRINTFORMW 「이곳에 너무 오래 머무르는 것은 좋지 않은 취지이다.」
		ENDIF
		;現在位置が竹林入り口
	ELSEIF CFLAG:MASTER:現在位置 == 410
		IF RAND:5 == 0
			PRINTFORMW 「이 근처에는 무서운 괴물들이 좀 있다.」
			PRINTFORMW 「내가 나 자신을 지칭하는 건가? 뭐, 그렇게 말할 수도 있겠지.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「진실은 주관 속에 있다는 거네, 그럼 내가 진짜라고 불릴 수 있을지 궁금해진다.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「어쩌면 나는 그저 꿈의 연장선을 목격하고 있는 것인지 모르겠다.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「스칼렛 데빌 저택의 쿠키는 맛있지만 이 죽순도 정말 맛있다. 길을 잃지 않는다면 말이다.」
		ELSE
			PRINTFORMW 「이 죽순들은 비 온 뒤에 이렇게 맛이 없으면 안 되는데.」
		ENDIF
		;現在位置が彼岸
	ELSEIF CFLAG:MASTER:現在位置 == 640
		IF RAND:5 == 0
			PRINTFORMW 「백합... 아주 오래전부터 싫어했다.」
			PRINTFORMW 「응, 정말 아주 먼 옛날부터 말이야.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「엔마님께서 우리를 발견하시면 번거로우실 겁니다. 저는 그 사람을 상대하는 데 별로 능숙하지 않아요.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「요즘 네 책임 회피하고 다니는 거 아니지?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이 세계의 경계에서, 당신은 나에게 무엇을 필요로 했지?」
		ELSE
			;referring to Ghostly Field Club
			PRINTFORMW 「이건 거의 렌다인 같군.」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「정말 기분 좋은 뜨거운 목욕이네, 영원히 머물고 싶을 정도야~」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후후~ 우리의 작은 비밀스러운 만남 중에 누군가 우리를 몰래 훔쳐봤을 거라고 생각하니?」
		ELSE
			PRINTFORMW 「오호? 내 벌거벗은 몸이 정말 그렇게 흥미로운가?」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「봄은 낮잠의 계절이지 않나? 당신도 충분히 즐기고 있겠지, %CALLNAME:MASTER%?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「오, 알고 있었어? 그 체리 나무들 아래에 시신이 묻혀 있다는 걸?」
					ELSE
						PRINTFORMW 「후우와아... 아직 좀 졸린 것 같네~」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「여름은 해변에 갈 때라고 말하고 싶지만, 여기엔 바다가 전혀 없네.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「요즘 너무 더워서 숙면을 취하기가 어렵네...」
					ELSE
						PRINTFORMW 「우리 둘 다 란이랑 첸이랑 수영하러 갈까~」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「가을의 여신들은 이번 시기에 꽤 활기차지 않나.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「가을 단풍의 계절이네, 술 한 잔 하면서 달맞이 파티를 열자~」
					ELSE
						PRINTFORMW 「이 긴 가을밤에 이야기들을 좀 해볼까요? 밤이 길어요, 제가 가진 이야기들처럼요~」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 추워지면 가끔 랜의 복슬복슬한 꼬리가 있었으면 하고 생각하곤 해~」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「겨울 동안 동면하지 않을 거니? 평소처럼 일찍 일어나 계획이 있니?」
					ELSE
						PRINTFORMW 「따뜻한 이불 아래서 날들을 보내고 싶지만, 아아 어쩔 수 없지, 나는 여전히 일어나야 해.」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						PRINTFORMW 「음~ 너랑 같이 있는 것만으로도 %CALLNAME:MASTER%나에겐 충분히 즐거운데, 하지만...」
						PRINTFORMW 「여기서 멀리 떠나고 싶어.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「나는 여분의 속옷을 한두 벌 가지고 다닌다.」
						PRINTFORMW 「네가 가장 좋아하는 것은 무엇이야, %CALLNAME:MASTER%?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「후후, 당신에 대해 이야기해 주면 좋겠어요, %CALLNAME:MASTER%.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「나 때문에 죽지 마, %CALLNAME:MASTER%.」
					ELSE
						PRINTFORMW 「어떤 종류의 상황극을 좋아하는지 말해줘, %CALLNAME:MASTER%.」
						PRINTFORMW 「가능하다면 네 소원을 들어줄지도 몰라.」
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「만약 "시간이 돈이라면", 시간을 조종할 수 있는 자들이 부자라는 말에 동의하지 않으시겠어요?」
					ELSEIF RAND:4 == 0
						;I think this may be wordplay with ウチ, did best
						PRINTFORMW 「장벽 뒤에 있는 것들과 밖에 있는 것으로 환원될 수 있는 장벽의 개념이 있다. 그리고 그 경계를 넘는 것은?」
						PRINTFORMW 「그들이 안으로 들어오는 순간, 그들은 나의 세계 안에 있게 된다.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「저렇게 느린 사람들과 함께 일하는 건 정말 골치 아프군. 정말이지.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「지금 어떤 꿈을 꾸고 있는 걸까, %CALLNAME:MASTER%?」
					ELSE
						PRINTFORMW 「그들이 우리를 깔본다 하더라도, 달 위의 그들은 인생을 한계까지 즐긴다는 개념을 결코 이해하지 못할 것이다.」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「음~, 여기엔 흥미로운 게 없어.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「나조차 할 일이 있지만 아무도 알아주지 않는다. 하지만 그게 되어야 하는 것이다.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「필요한 것은 취하고 나머지는 버려라. 장벽 안이든 밖에 있든 상관없다.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「냉소주의자가 뭔지 알아? 그것은 사물의 진정한 가치를 모르는 사람이야.」
					ELSE
						PRINTFORMW 「세상에, %CALLNAME:MASTER%. 흥미로운 것을 하나 말해 주면 고맙겠어.」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「란이 좀 더 자주 어울리면서 노는 법을 배우면 정말 좋을 텐데...」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「그러고 보니, 난의 목욕 사진을 팔지 말라는 금지령이 있었어. 너무 지루해ー」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「눈으로 볼 수 있는 것이 현실이라면, 보이지 않는 것은 허구라는 뜻인가?」
						PRINTFORMW 「그저 나비가 지구 반대편에서 날갯짓을 하는 것을 아무도 신경 쓰지 않을 테니까.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「오류가 발생하면 해당 섹션을 수정해야 한다.」
					ELSE
						PRINTFORMW 「여기서 영원히 놀고 싶어 하는 것 같네. 하지만 그건 불가능해.」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
