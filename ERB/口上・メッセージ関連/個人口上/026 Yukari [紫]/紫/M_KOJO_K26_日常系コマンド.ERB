;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K26_303
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K26_303
CALL M_KOJO_MESSAGE_COM_K26_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	SELECTCASE TFLAG:193
		CASE 0,1,2
			PRINTFORMDW 당신은 자신의 무례함에 대해 유카리에게 사과한다.
			PRINTFORMW 「오호, 애써주는군. 내가 그렇게까지 신경 썼던 것도 아닌데.」
			PRINTFORMDW 그녀는 미소를 지으며 당신을 용서한다.
		CASEELSE
			PRINTFORMDW 당신은 자신의 무례함에 대해 유카리에게 사과한다.
			PRINTFORMW 「진심이 부족하군.」
			PRINTFORMDW 그녀는 눈에 아무런 재미도 없다는 듯 말한다.
