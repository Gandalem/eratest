@M_KOJO_SUCCESS_COM_K26_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K26_301
CALL M_KOJO_MESSAGE_COM_K26_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「음, 받아들이겠지만...」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「좀 더 진지하게 시도해 주면 어떨까 생각하네...」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「이건 꽤 안 좋은데...」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「마셔도 안 되겠어.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 것을 대접하다니...」
		ELSE
			PRINTFORMW 「이게 얼마나 최악인지 말로 표현할 수가 없어...」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「후우... 후우...」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「하쿠레이 신사에서 대접하는 차보다 나아.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「오호? 친절에 감사드립니다.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이거 신선하네요, 그렇죠? 전혀 물컹하지 않아요.」
		ELSE
			PRINTFORMW 「아... 맛있다.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
