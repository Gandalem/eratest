;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K26_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K26_302
CALL M_KOJO_MESSAGE_COM_K26_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「나를 만지지 말아 주면 고맙겠다.」
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「당신의 등만 씻겨 드릴까요? 예를 들자면... 다른 곳 말이에요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후후~ 여기서 아래쪽도 깨끗하고 물이 잘 빠지도록 확인해야겠어, 그렇지 않아~」
		ELSE
			PRINTFORMW 「봐, 엄청 더러워졌잖아, 안 그래? 다시 반짝반짝하게 해줄게~」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「연인들은 이런 종류의 행동을 하지 않나?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「얼마나 간지럽고, 더 하고 싶어.」
		ELSE
			CALL HPH_PRINT,@"「음... 별로 나쁘지 않네.」","W"
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「하아... 좋아해 주는 거지...? 이런 것들을 하는 거.」
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「아아... 그렇게 많이 만지지 마...흐흑」","W"
			PRINTFORMW 「부끄럽네...」
		ELSE
			PRINTFORMW 「누군가 너무 친근하게 구는 것 같네... 딱히 신경 쓰진 않아.」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「나 말고 다른 사람들에게도 이런 행동을 하니...? ...상관없지만.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...아무것도 느껴지지 않아.」
		ELSE
			PRINTFORMW 「조금 더 거칠어도 괜찮을 것 같은데.」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「너무 친한 척 하지 마.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흠... 네 자리를 가르쳐 주고 싶은데...」
		ELSE
			PRINTFORMW 「뭐 필요한 거 있었어?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
