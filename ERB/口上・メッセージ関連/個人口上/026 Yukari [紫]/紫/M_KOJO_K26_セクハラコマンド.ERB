@M_KOJO_MESSAGE_COM_K26_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	IF FLAG:70
		PRINTFORMDW 시간이 멈춘 동안, 당신은 유카리의 입술에 자신의 입술을 맞댄다.
		;i have no idea how her lips can taste "sad"
		PRINTFORMDW 그녀의 그 입술은 부드럽고 어딘가 슬픈 맛이 배어 있었다.
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K26_20_1
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...Nn...」
		PRINTFORMDW 유카리는 키스를 받으며 작은 중얼거림을 내뱉는다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「음...흐으...아...흐으」","W"
			CALL HPH_PRINT,@"「...계속해...HPH」","W"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...음... 키스만으로 괜찮아...?」
			PRINTFORMDW 유카리는 다시 다가가 또 다른 키스를 하며 말한다.
		ELSE
			CALL HPH_PRINT,@"「...%CALLNAME:MASTER%...HPH」","W"
			PRINTFORMDW 유카리가 당신에게 자신의 입술을 빼앗길 대로 스스로를 맡긴다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음?」
			CALL HPH_PRINT,@"「...천천히 해... HPH」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「Nn...HPH」","W"
			PRINTFORMW 「나는 이 강렬함이 좋다.」
		ELSE
			CALL HPH_PRINT,@"「...HPH」","W"
			PRINTFORMDW 유카리는 당신에게 더욱더 입술을 맞추며 호의를 되갚는다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			;what
			CALL HPH_PRINT,@"「후훗... 레몬 맛은 아니었지? HPH」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「Nn...HPH」","W"
			PRINTFORMW 「얼마나 불공평해.」
		ELSE
			CALL HPH_PRINT,@"「음~흐읍」","W"
			PRINTFORMW 「...이거 마음에 드는 것 같아.」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...응...?!!」
			PRINTFORMDW 유카리는 당신의 키스에 당황한다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...!?」
			PRINTFORMW 「이번 한 번은 그냥 넘어갈게.」
		ELSE
			PRINTFORMW 「내 입술의 가격이 그렇게 저렴한 건 아니라는 걸 알아둬.」
			PRINTFORMDW 유카리는 당신을 약하게 노려보며 입술을 닦았다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
