;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K26_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K26_310
CALL M_KOJO_MESSAGE_COM_K26_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「그만둬!」
		PRINTFORMDW 유카리가 큰 소리를 내며 당신의 뺨을 때렸다.
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K26_5_1
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응하아헵」","W"
			CALL HPH_PRINT,@"「나를 희롱하고 있는 것 같네, 응? 후후. 음, 흥분하는 걸지도?」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「...응...더 만져줘...흐으」","W"
		ELSE
			CALL HPH_PRINT,@"「당신이 나에게 거칠게 대하기 시작하면 좋아하게 될지도 몰라요, %CALLNAME:MASTER%HPH.」","W"
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「내 엉덩이가 그렇게 매력적으로 보이니?」","W"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「히야안!」
			PRINTFORMW 「...갑자기 만지지 마. 그냥 물어보면 네가 원하는 만큼 만지게 해줄 테니까.」
		ELSE
			PRINTFORMW 「...무슨 일이라도 있나요?」
			PRINTFORMDW 그녀는 약간 부끄러워하는 듯, 사람 적은 곳으로 당신을 초대했다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「...음... 다른 사람 괴롭히지 마라.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「나 너무 많이 만지지 않았으면 좋겠어.」
		ELSE
			PRINTFORMW 「내가 아니었다면 그 자리에서 죽었을지도 모른다는 것을 알아주길 바란다.」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음, 그럼 너 변태구나...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「유유코를 쓰다듬으면 훨씬 기분이 좋아질 거라고 확신해.」
			PRINTFORMDW 당신을 확실한 죽음으로 초대하면서도 유카리는 당신의 손을 털어낸다.
		ELSE
			PRINTFORMW 「당장 그만두세요.」
			PRINTFORMDW 유카리는 당신의 엉덩이를 더듬는 손을 털어낸다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
