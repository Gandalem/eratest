RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	IF FLAG:70
		PRINTFORMDW 시간은 정지된 채 유카리의 풍만한 가슴을 어루만졌다.
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...음...」
		PRINTFORMDW 유카리는 당신이 그녀의 통통한 가슴을 어루만지자 약간 먹먹한 신음을 흘린다.
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K26_6_1
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「음...흐읍... 이 못 말리는 것 같아...흐읍」","W"
			CALL HPH_PRINT,@"「...그냥 만지는 건 괜찮아...후후」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「...하아... 더 만져줘 HPH」","W"
			PRINTFORMDW 유카리가 당신에게 애원하며 떨고 있다...
		ELSE
			CALL HPH_PRINT,@"「...%CALLNAME:MASTER%... 좀 격렬하게 스킨십 해보자 HPH」","W"
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「우와!?」
			CALL HPH_PRINT,@"「...네가 원하면 마음껏 만져도 돼, 단지 부탁만 해봐...HPH」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「NhHPH」","W"
			PRINTFORMW 「더 세게 해도 괜찮아♪」
		ELSE
			CALL HPH_PRINT,@"「...AhHPH」","W"
			PRINTFORMDW 당신은 유카리의 얼굴이 붉어지는 동안 그녀의 가슴을 애무한다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「후후... 왜 저렇게 유혹적인지 모르겠네HPH」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「흐읍」","W"
			PRINTFORMW 「...당신은 정말 못 고치겠군요 %PRINT_MALE("man", MASTER)%.」
		ELSE
			CALL HPH_PRINT,@"「안호프」","W"
			PRINTFORMW 「나는... 아무것도 느끼지 못해...」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...잠깐...?!」
			PRINTFORMDW 유카리는 당신이 그녀의 가슴을 애무하자 당황하며 반응한다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「내 가슴이 그렇게 매력적이라니 기쁘네.」
			PRINTFORMW 「하지만 너무 심하게 몰아붙이지 마.」
		ELSE
			PRINTFORMW 「요조(幻想郷)에서도 사람들이 다치고 상처받을 수 있다는 걸 기억해야 해.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
