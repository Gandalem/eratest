;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K26_140
CALL M_KOJO_MESSAGE_COM_K26_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음... 음마아~~!」
		CALL HPH_PRINT,@"「그만둬, 강요하면 안 돼... HPH」","W"
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「음흠흡」","W"
			PRINTFORMDW 유카리는 당신의 사정이 임박했음을 감지하고 능숙하게 클라이맥스로 이끌어준다.
			CALL HPH_PRINT,@"(서둘러야 해... HPH 서둘러야 해... HPH)","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「만나보지 못했다」","W"
			PRINTFORMDW 유카리는 당신의 사정이 임박했음을 감지하고 능숙하게 클라이맥스로 이끌어준다.
		ELSE
			CALL HPH_PRINT,@"「음흠프흐 음~흠프흐」","W"
			PRINTFORMDW 유카리는 당신의 사정이 임박했음을 감지하고 능숙하게 클라이맥스로 이끌어준다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「Mn～!」
			PRINTFORMDW 유카리는 당신이 그녀의 목구멍에 거기를 밀어 넣자 신음했다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 냠!!」
			PRINTFORMDW 유카리가 네가 그녀의 목구멍으로 네 것을 밀어 넣자 신음한다.
		ELSE
			PRINTFORMW 「～～～!!!」
			PRINTFORMDW 유카리는 당신이 그녀의 목구멍에 거기를 밀어 넣자 신음했다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
