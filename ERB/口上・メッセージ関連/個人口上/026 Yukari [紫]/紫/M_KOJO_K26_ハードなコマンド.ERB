;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K26_150
CALL M_KOJO_MESSAGE_COM_K26_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K26_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K26
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「오호? 네가 그렇게 세게 거기를 박을 줄은 몰랐어, 내 가슴이 정말 그렇게 매혹적이야 HPH」","W"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;胸3以上
	ELSEIF ABL:胸 > 2
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「이렇게 가슴이 침범당하는 건 좀 흥분되는 것 같아HPH」","W"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「NmhHPH 그만둬, 내 가슴에서 고름 냄새가 나잖아HPH」","W"
		ELSE
			CALL HPH_PRINT,@"「너는 나보다 내 가슴을 더 좋아하는구나, %CALLNAME:MASTER%HPH」","W"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 가슴에 거칠게 박는 기교가 좋군.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「당신이 곧 사정하지 않으면 내 가슴은 결코 자유로워지지 않을 거야~」
		ELSE
			CALL HPH_PRINT,@"「꽤 인상적이군, 안 그래? 내 가슴 말이야 HPH」","W"
		ENDIF
	ENDIF
ENDIF
RETURN 1
