					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG >= 1
		PRINTFORMW 「꽤 해내네. 다시 생각해 봤어.」
		RETURN 1
	ENDIF
