; Modular ERB: 個人口上/043 Kasen [華扇]/華扇/M_KOJO_K43_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K43
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;custom code
SIF FLAG:70
	RETURN 0
;苦痛刻印
IF TFLAG:苦痛刻印取得 == 1
	PRINTFORMW 「아프다고! 벌써 상처 입을 거야!!」 
ELSEIF TFLAG:苦痛刻印取得 == 2
	PRINTFORMW 「아얏!! 그건 아무리 그래도 아프잖아!」 
ELSEIF TFLAG:苦痛刻印取得 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「벌써 이렇게 해줘서, 야해」 
ELSEIF TFLAG:23 == 2
	PRINTFORMW (나, %CALLNAME:MASTER%일만 생각하고 있어...)
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「너무 기분 좋아서... 머리가 이상해질 것 같아...」 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW (음~ 이 정도인가 보네)
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW (뭔가, 엄청 두근거린다)
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW (나도 저쪽에서 밀어붙여 버릴까)
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW (무슨 일이야, 나! 정신 차려!)
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「%CALLNAME:MASTER%, 이제 놓아주지 않을 거야!」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「이제 %CALLNAME:MASTER%없이는 살아갈 수 없을지도 몰라……」 
ENDIF
;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORMW 「흥...」
	PRINTFORMW 「역시 머리가 터지겠어...」 
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORMW 「……조금 더 상냥하게 해줄 수 없나요!」 
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORMW 
ENDIF
