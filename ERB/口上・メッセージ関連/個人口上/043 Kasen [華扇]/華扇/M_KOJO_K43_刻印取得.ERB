;-------------------------------------------
;刻印取得
;-------------------------------------------
@M_KOJO_MESSAGE_MARKCNG_K43
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;custom code
SIF FLAG:70
	RETURN 0

;苦痛刻印
IF TFLAG:苦痛刻印取得 == 1
	PRINTFORMW 「痛いってば！もう傷ついちゃうわよ！！」 
ELSEIF TFLAG:苦痛刻印取得 == 2
	PRINTFORMW 「いたぁっ！！それはさすがに痛いわ！」 
ELSEIF TFLAG:苦痛刻印取得 == 3
	PRINTFORMW 
ENDIF

;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF

;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「もう、こんなにしてくれちゃって、えっち」 
ELSEIF TFLAG:23 == 2
	PRINTFORMW （私、%CALLNAME:MASTER%のことばかり考えちゃってる…）
ELSEIF TFLAG:23 == 3
	PRINTFORMW 「気持ち良すぎて……頭がおかしくなりそう……」 
ENDIF

;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW （う～ん、こんなもんかしらね）
;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW （なんだろう、すっごいどきどきする）
;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW （もっと私のほうから押し倒しちゃおうかな）
;屈服、恭順による刻印
;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW （どうした私！しっかりしろ！）
;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「%CALLNAME:MASTER%、もう離さないんだからね！」
;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「もう%CALLNAME:MASTER%無しじゃ生きていけないかも……」 
ENDIF

;反発刻印
IF TFLAG:反発刻印取得 == 1
	PRINTFORMW 「ふん…」
	PRINTFORMW 「さすがに頭にきたわ…」 
ELSEIF TFLAG:反発刻印取得 == 2
	PRINTFORMW 「……もうちょっと優しくできないんですか！」 
ELSEIF TFLAG:反発刻印取得 == 3
	PRINTFORMW 
ENDIF
