;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K43_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K43_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------


IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF !MARK:3 && CFLAG:2 >= 10000 && CFLAG:1000 == 1 ;custom code
		PRINTFORMDW %CALLNAME:MASTER%はふと気になって、華扇に腕の包帯のことを尋ねてみた
		PRINTFORMW 「…………わかりました、正直にお話しします」
		PRINTFORMW 「これは怪我ではありません、腕自体が無いのです」
		PRINTFORMW 「動かせるのは術の類だと思っていただければ」
		PRINTFORMW 「そして……私が持っている例の枡でお酒を飲んでいないと、腕が腐ってしまうんです」
		PRINTFORMW 「今話せるのは、こんなところですね」
		PRINTFORMW 「……今まで騙していてごめんなさい」
		PRINTFORMW 「もし……もし%CALLNAME:MASTER%がどこかで腕の話を聞いたら、私に教えてくれませんか？」
		PRINTFORMW 「お願い……します……」
		PRINTFORMDW %CALLNAME:MASTER%は語り終えた華扇を労わった
		PRINTFORMDW %CALLNAME:MASTER%と華扇の仲が、少し深まった気がした
