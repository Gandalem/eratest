;==================================================
;301,お茶を淹れる
;==================================================
@M_KOJO_MESSAGE_COM_K43_301
CALL M_KOJO_MESSAGE_COM_K43_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K43_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -1
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 華扇はお茶を一口飲むと、顔を顰めて湯飲みを置いた
				PRINTFORML 「折角入れてもらったんだけど……ちょっと濃すぎるわ」
				PRINTFORMW 「ごめんなさいね」
			CASEELSE
				PRINTFORMDW 華扇は紅茶を一口飲むと、顔を顰めて懐から砂糖を取り出した
				PRINTFORML 「折角入れてもらったんだけど……ちょっと口に合わないみたい」
				PRINTFORMW 「ごめんなさいね」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 華扇はお茶を一口飲むと、顔を顰めて湯飲みを置いた
				PRINTFORML 「……いえ、熱かっただけですよ」
				PRINTFORMW 「お茶、ありがとうございます」
			CASEELSE
				PRINTFORMDW 華扇は紅茶を一口飲むと、顔を顰めて懐から砂糖を取り出した
				PRINTFORML 「量が足りなかったみたいです」
				PRINTFORMDW 華扇のカップに、底に溜まるほど大量の砂糖が投入された……
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 華扇はお茶を一口飲むと、顔を顰めて湯飲みを置いた
				PRINTFORML 「ごめんなさい、ちょっと口に合わないというか……」
				PRINTFORML 「あ、いえ、その、熱かっただけです！ええ！」
				PRINTFORMW 「実は少し猫舌で……あはは……」
			CASEELSE
				PRINTFORMDW 華扇は紅茶を一口飲むと、顔を顰めて懐から砂糖を取り出した
				PRINTFORML 「渋いのでそれを消すために……」
				PRINTFORML 「で、ではなく、甘い物が好きなんですよ、私、甘い物が」
				PRINTFORMDW 華扇のカップに、底に溜まるほど大量の砂糖が投入された……
			ENDSELECT
		ENDIF
	ELSE
		IF TALENT:恋人
			PRINTDATA
				DATALIST
					DATAFORM 「ありがとう、%CALLNAME:MASTER%」
					DATAFORM 華扇は紅茶に砂糖をたっぷり入れ、おいしそうに飲んでいる
					DATAFORM 「はふぅ……」
				ENDLIST
				DATALIST
					DATAFORM 「今ちょうどお茶菓子が……」
					DATAFORM 「さ、おあがりなさい」
				ENDLIST
				DATALIST
					DATAFORM 「ありがとう、%CALLNAME:MASTER%」
					DATAFORM 「ふう……偶には甘くないお茶もいいわね」
				ENDLIST
				DATALIST
					DATAFORM %CALLNAME:MASTER%は自分のお茶に茶柱が立っているのに気付き、華扇に見せてあげた
					DATAFORM 「あら、本当」
					DATAFORM 「ですが、人に見せる前に飲まないと幸運はやって来ませんよ」
					DATAFORM 「失敗しましたね、ふふっ」
				ENDLIST
				DATALIST
					DATAFORM 「貴方知ってる？」
					DATAFORM 「外の世界では、恋人は同じ器で飲み物を飲むそうよ」
				ENDLIST
			ENDDATA
			WAIT
		ELSEIF TALENT:恋慕
			PRINTDATA
				DATALIST
					DATAFORM 「ありがとう、%CALLNAME:MASTER%」
					DATAFORM 華扇は紅茶に砂糖をたっぷり入れ、おいしそうに飲んでいる
					DATAFORM 「はふぅ……」
				ENDLIST
				DATALIST
					DATAFORM 「今ちょうどお茶菓子が……」
					DATAFORM 「はい、どうぞ」
				ENDLIST
				DATALIST
					DATAFORM 「ありがとう、%CALLNAME:MASTER%」
					DATAFORM 「ふう……偶には甘くないお茶もいいわね」
				ENDLIST
			ENDDATA
			WAIT
		ELSEIF TALENT:思慕
			PRINTDATA
				DATALIST
					DATAFORM 「あ、ありがとう」
					DATAFORM 華扇は紅茶に砂糖をたっぷり入れ、おいしそうに飲んでいる
					DATAFORM 「え、入れすぎ？ま、まあいいじゃないですか、味覚は人其々ですよ」
				ENDLIST
				DATALIST
					DATAFORM 「あら、ありがとう」
					DATAFORM 「お茶菓子でも用意してくれば良かったわ」
				ENDLIST
				DATALIST
					DATAFORM 「ありがとう、%CALLNAME:MASTER%」
					DATAFORM 「ふう……偶には甘くないお茶もいいわね」
				ENDLIST
			ENDDATA
			WAIT
		ELSE
			PRINTDATA
				DATALIST
					DATAFORM 「あ、ありがとうございます」
					DATAFORM 華扇は紅茶に砂糖をたっぷり入れ、おいしそうに飲んでいる
					DATAFORM %CALLNAME:MASTER%は砂糖の使いすぎではないかと心配になったが、華扇の笑顔を見るため黙っていることにした……
				ENDLIST
				DATALIST
					DATAFORM 「私のために……？ありがとうございます」
					DATAFORM 「お茶菓子でも用意してくれば良かったわ」
					DATAFORM 「いや、催促したわけでは……」
				ENDLIST
			ENDDATA
			WAIT
		ENDIF
	ENDIF
ENDIF
		
		
RETURN 1
