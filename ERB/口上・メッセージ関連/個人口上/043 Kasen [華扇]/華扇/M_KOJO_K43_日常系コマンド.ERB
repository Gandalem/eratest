;==================================================
;615,お弁当を食べる
;==================================================
@M_KOJO_MESSAGE_COM_K43_615
CALL M_KOJO_MESSAGE_COM_K43_615_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K43_615_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;custom code
	IF TALENT:恋人
		IF !RAND:3
			PRINTFORMW 「はい、%CALLNAME:MASTER%の分」
			PRINTFORMDW わあ、華扇さんの手作り。いただきます！
		ELSEIF RAND:2
			PRINTFORMW 「はい、%CALLNAME:MASTER%の分」
			PRINTFORMDW 華扇さん手作り淫ピ弁当じゃないですか！
			PRINTFORMW 「殴るわよ」
		ELSE
			PRINTFORMW 「こうやって二人で外で食べるのもいいわね」
			PRINTFORMDW そうですね～…眠くなってきた…
			PRINTFORMW 「膝枕してあげよっか？」
			PRINTFORMDW 是非！！
		ENDIF
		CFLAG:242 = 3
	ELSEIF TALENT:恋慕
		PRINTFORMW 「こうやって二人で外で食べるのもいいわね」
		PRINTFORMDW そうですね～…眠くなってきた…
		PRINTFORMW 「膝枕してあげよっか？」
		PRINTFORMDW それはそれで恥ずかしいです…
	ELSE
		PRINTFORMW 「ご飯にしましょ」
		PRINTFORMDW そうですね、そうしましょう
	ENDIF
ENDIF
RETURN 1
