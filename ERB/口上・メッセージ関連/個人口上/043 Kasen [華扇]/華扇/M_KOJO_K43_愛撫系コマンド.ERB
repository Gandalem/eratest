	SELECTCASE EXP:TARGET:Ｃ絶頂経験
		CASE 0
			SIF !FIRSTTIME(SELECTCOM,1)
				RETURN 0
		CASEELSE
			SIF !(PALAM:快Ｃ >= 7000 && NOWEX:Ｃ絶頂)
