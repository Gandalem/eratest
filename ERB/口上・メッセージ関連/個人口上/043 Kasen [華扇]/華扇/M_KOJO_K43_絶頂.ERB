@M_KOJO_MESSAGE_PALAMCNG_A_K43_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF TCVAR:PLAYER:コンドーム != 1
		CFLAG:TARGET:1023 = 1
	IF TCVAR:PLAYER:コンドーム == 1
		PRINTFORML 
	ELSE
		IF NOWEX:Ｖ絶頂 && TALENT:恋慕 && TALENT:快感応答 == -1 && EXP:5 >= 20 && EXP:Ｖ絶頂経験 >= 20 && EXP:8 >= 20 && EXP:41 >= 30
			PRINTFORMDW 카센은 한바탕 몸을 경련시킨 후, 크게 숨을 내쉬며 %조사처리(CALLNAME:MASTER,"의")% 허리에 다리를 감았다.
			PRINTFORMDL ……………………
			PRINTFORMDW 카센의 나를 보는 눈이 이상하다…….
			PRINTFORMW 「아무래도 나는…… 하나 착각하고 있었던 것 같아요」
			PRINTFORML 「지금까지, 성교로 육체적인 쾌감을 얻는 것을 좋지 않은 일이라고 생각했어요」
			PRINTFORMW 「하지만 그것은…… 잘못된 생각이었네요」
			PRINTFORML 「서로를 배려하고 마음을 통해 교감하는 상태에서의 애무에 강한 쾌감을 느끼고……」
			PRINTFORMW 「그것으로 더욱 사랑을 깊게 해 나가는 것…… 이것이 올바른 형태군요」
			PRINTFORMDL 카센은 %조사처리(CALLNAME:MASTER,"를")% 강하게 끌어안았다.
			PRINTFORMW 「%CALLNAME:MASTER%…… 사랑해요……」
			PRINTFORML 
			PRINTFORMDW 카센은 여자의 기쁨에 눈을 뜬 것 같다.
			PRINTFORMDW 카센의 쾌감의 부정(否定)이 사라졌다.
			PRINTFORML 
			TALENT:快感応答 = 0
			RETURN 1
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
	ENDIF
	;custom code
	IF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「아하하, 잔뜩 안에 싸 놓았구나」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...아기가 생기면 좋겠다」
		ELSE
			PRINTFORMW 「뜨거운 것이 들어오는 것, 알겠어……」
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
