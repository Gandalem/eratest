							IF BASE:MASTER:精力 <= 200
								PRINTFORMW 
								PRINTFORML 「あら……」
								PRINTFORMDW しかし、%CALLNAME:MASTER%のペニスは休憩が必要なようだ
								PRINTFORML 「す、少し休みましょうか、あはは……」
								PRINTFORMDW (時間は経過しないけど)休憩して%CALLNAME:MASTER%の精力が少し回復した！
								BASE:MASTER:精力 += 50
							ELSEIF BASE:MASTER:体力 <= 800
								PRINTFORMW 
								PRINTFORML 「あら……」
								PRINTFORMDW しかし、疲れきった%CALLNAME:MASTER%は華扇に対応することができない
								PRINTFORML 「す、少し休みましょうか、あはは……」
								PRINTFORMDW (時間は経過しないけど)休憩して%CALLNAME:MASTER%の体力が少し回復した！
								BASE:MASTER:体力 += 50
							ELSE
								PRINTFORMDL 乳肉に飲み込まれたペニスは揉まれ、扱かれ、擦られ
								PRINTFORMDL 瞬く間に射精前の固さと大きさを取り戻した……
								PRINTFORMW 
								PRINTFORML 「ほら、ほら、気持ちいいでしょう？また射精してもいいのよ？」
								SELECTCASE RAND:2
								CASE 0
									PRINTFORML 「……コホン、とはいえあまり連続でするのも負担があるでしょうし」
									PRINTFORML 「今回は寸前で止める事にします」
									PRINTFORML 「次は%CALLNAME:MASTER%の好きなところに出してください%UNICODE(0x2661)%」
									PRINTFORMDL %OPPAI_DESCRIPTION(TARGET)%から解放された%CALLNAME:MASTER%の%TINKO(PLAYER)%は既に射精寸前で、
									PRINTFORMDW %CALLNAME:MASTER%は華扇を精液で汚すべく、艶かしい肢体に狙いを定めた……
									TCVAR:MASTER:イきそう = 1
									BASE:MASTER:2 = 10000
								CASE 1
									PRINTFORMDL 華扇のパイズリ責めはますますその苛烈さを増していき、
									PRINTFORMDL 陰茎から亀頭まで、性器全てが%OPPAI_DESCRIPTION(TARGET)%に捏ね繰り回されている
									PRINTFORML 「んっ……ビクビクしてきたわ……さあ、我慢しなくていいわよ%UNICODE(0x2661)%」
									PRINTFORMDW %CALLNAME:MASTER%は獣のようなうめき声を上げながら、射精まで華扇の乳房に蹂躙され続けた……
									DRAWLINE
									PRINTFORMDL 絶頂経験 +1(%CALLNAME:MASTER%)
									PRINTFORMDL 射精経験 +3(%CALLNAME:MASTER%)
									PRINTFORML 
									PRINTFORMDL Ｂ経験 +1(華扇)
									PRINTFORMDL 精液経験 +5(華扇)
									PRINTFORMDL 口淫経験 +1(華扇)
									PRINTFORMDL パイズリ経験 +2(華扇)
									PRINTFORMDL 奉仕快楽経験 +16(華扇)
									PRINTFORMDL 愛情経験 +2(華扇)
									PRINTFORML 
									PRINTFORMDW 連続大量射精
									PRINTFORMDL %CALLNAME:MASTER%は先程射精したばかりにも関わらず、華扇の%OPPAI_DESCRIPTION(TARGET)%で責められて射精した
									PRINTFORMDL 豊満な乳房の間で脈動するペニスは水っぽいながらも大量の精液を噴き上げ、華扇の顔と胸を汚していく
									PRINTFORMDW 華扇は幸せそうな表情で%CALLNAME:MASTER%の精液に汚れていった……
									PRINTFORML 「あぁっ……素敵っ……%UNICODE(0x2661)%」
									PRINTFORML 「私の胸、気に入ってくれたかしら？」
									PRINTFORMW 「うんうん♪そう言ってもらえると嬉しいわ♪」
									IF CFLAG:1010 == 0
										PRINTFORMW 「明日からこれ、日課にしましょうか」
										PRINTFORML 「%CALLNAME:MASTER%、私の知らないところで精液の無駄遣いをしてはいけませんよ」
										PRINTFORMW 「当然自慰行為も禁止します、どうしてもというなら私の前でどうぞ%UNICODE(0x2661)%」
										CFLAG:1010 = 1
									ENDIF
								ENDSELECT
							ENDIF
						CASEELSE 
							PRINTFORMDW 華扇は%OPPAI_DESCRIPTION(TARGET)%で%TINKO(PLAYER)%を擦りあげ、吹き出る精液を顔と乳房で受け止めた
							PRINTFORML 「ん……%UNICODE(0x2661)%たくさん出たわね%UNICODE(0x2661)%」
							PRINTFORML 「この量を見ると……私も大分パイズリが上手くなったみたいね」
							PRINTFORMDW 華扇は満足げにそう言うと、精液がこびりついた%CALLNAME:MASTER%の%TINKO(PLAYER)%を咥え込んだ
						ENDSELECT
					ENDSELECT
				ENDSELECT
			ENDIF
		ENDIF
	ENDSELECT
ENDIF
RETURN 1

