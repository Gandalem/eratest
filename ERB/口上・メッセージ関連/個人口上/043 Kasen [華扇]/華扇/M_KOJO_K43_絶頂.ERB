					CASE 1
						PRINTFORML 「응우웅...!!......아아...」
						PRINTFORML 「또... 가버렸어요 %UNICODE(0x2661)%」
						PRINTFORMW 「이렇게 멋진 걸 어떻게 지지 않을 수 있겠어요 %UNICODE(0x2661)%」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「앗, 아, 아아앙%UNICODE(0x2661)%……히익……」
						PRINTFORMW 「사……보답해 줄 테니 각오하렴%UNICODE(0x2661)%」
					CASE 1
						PRINTFORML 「응으으윽!!......아아......」
						PRINTFORML 「가능하다면 함께하고 싶지만......이것만은 어쩔 수 없겠지」
						PRINTFORMW 「하지만 다음엔......지지 않을 거야%UNICODE(0x2661)%」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
