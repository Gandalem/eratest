@M_KOJO_MESSAGE_COM_K80_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML
				PRINTFORML 「%CALLNAME:MASTER%-씨, 네가 만든 차 정말 맛있어...」
				PRINTFORMDL 아큐는 잔 속의 차를 맛보며 그렇게 말한다.
				PRINTFORML 「지금부터 나랑 계속 함께 있어 줘.」
			CASE 1
				PRINTFORML
				PRINTFORML 「음...후우————」
				PRINTFORMDL 아큐는 편안하게 숨을 내쉰다.
				PRINTFORML 「차 만드는 게 점점 나아지고 있어, %CALLNAME:MASTER%-씨.」
				PRINTFORMDL 고마워요.
			CASE 2
				PRINTFORML
				PRINTFORML 「%CALLNAME:MASTER%-씨, 당신이 만든 차는... 맛있네요.」
				PRINTFORMDL ...아큐가 잔에서 마시는 소리가 들린다.
				PRINTFORMDL 그녀 옆에서 웃으며 말했다. 기쁘다고 말하며.
			CASE 3
				PRINTFORML
				PRINTFORMDL 아큐는 정말 차를 좋아한다... 당신은 아큐 옆에 앉아 그렇게 생각했다.
				PRINTFORML 「그게 사실은 아니야... 그건... 이것이 %CALLNAME:MASTER%-님이 만든 것이기 때문이야...」
				PRINTFORMDL 그녀는 수줍게 계속해서 차를 마셨다.
			CASE 4
				PRINTFORML 「%CALLNAME:MASTER%-씨의 차... 마음에 들어요.」
				PRINTFORMDL 아큐는 마시면서 부드럽게 말했다.
				PRINTFORML 「마치... 그 안에 연모의 맛이 있는 것 같아요.」
				PRINTFORMDL 정말 부끄러운 방식이야... 그녀 옆에서 장난스럽게 말하며.
				PRINTFORML 「정말요! 제가 당신을 칭찬했음에도 불구하고.」
		ENDSELECT
		PRINTFORMW
		RETURN 1
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML
				PRINTFORML 「이건... 나를 위해 준비해 준 거야?」
				PRINTFORML 「그럼... 내가 해도 괜찮아...」
				PRINTFORMDL 후우———— (꿀꺽)...
				PRINTFORML 「정말 고마워요, %CALLNAME:MASTER%-상.」
			CASE 1
				PRINTFORML
				PRINTFORML 「나한테는요?」
				PRINTFORMDL 아큐는 당신이 만들어 준 차를 두 손으로 받는다.
				PRINTFORM 「Nn～～」 
				PRINTFORMDW 아큐는 편안하게 숨을 내쉰다.
				PRINTFORML 「...차 고마워.」
			CASE 2
				PRINTFORML 
				PRINTFORML 「(꿀꺽, 꿀꺽)————후우————」
				PRINTFORMDL 아큐는 어깨의 긴장을 풀고 편안하게 숨을 내쉬었다.
				PRINTFORML 「비록 이게 맛있긴 해도... %CALLNAME:MASTER%-상의 차 우리는 방식은... 아직 개선할 점이 있어.」
				PRINTFORMDL 맞아... 다음엔 아큐 선생님의 차를 맛보면서 배워야겠어. 라고 웃으며 말했다.
			CASE 3
				PRINTFORML
				PRINTFORML 「————이건 나를 위한 거야?」
				PRINTFORMDL 아큐의 눈꺼풀은 피로 때문에 살짝 처져 있었다.
				PRINTFORMDL ...
				PRINTFORML 「음... 맛있다.」
				PRINTFORMDL 그녀의 에너지가 약간 회복되자, 그녀는 당신의 차를 칭찬했다.
			CASE 4
				PRINTFORML 
				PRINTFORML 「...후우————」
				PRINTFORMDL 아큐는 긴 한숨을 내쉰다.
				PRINTFORML 「마치 이 안에서 당신의 감정을 느낄 수 있는 것 같아요, %CALLNAME:MASTER%-상.」
		ENDSELECT
		PRINTFORMW
	ELSEIF TALENT:思慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML
				PRINTFORML 「오, 나에게 차를 만들어 주었구나... 고마워요, %CALLNAME:MASTER%-씨.」
				PRINTFORMDL 아큐는 정중하게 잔을 받고 차를 마시기 시작했다.
			CASE 1
				PRINTFORML
				PRINTFORML 「오... 차인가?」
				PRINTFORML 「정말 감사합니다...」
				PRINTFORMDL 아큐는 살짝 홍조를 띤다.
				PRINTFORML 「차는 아직 개선할 부분이 있지만... 그래도 정말 맛있었어요.」
				PRINTFORMDL 그녀는 차를 홀짝이며 부드러운 미소를 짓는다.
			CASE 2
				PRINTFORML
				PRINTFORML 「당신은 좋은 사람이네요... %CALLNAME:MASTER%-상...」
				PRINTFORMDL 아큐는 차로 갈증을 해소한다.
				PRINTFORML 「후우... 하아————」
				PRINTFORMDL 그녀는 사랑스러운 한숨을 내쉰다.
			CASE 3
				PRINTFORML
				PRINTFORML 「정말 고맙습니다... %CALLNAME:MASTER%-씨.」
				PRINTFORMDL 아큐는 작은 입술을 컵에 가져다 댄다.
				PRINTFORML 「모조리 마실게요.」
		ENDSELECT
		PRINTFORMW
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML
				PRINTFORML 「그게...차인가?」
				PRINTFORML 「배려해 주셔서 감사합니다.」
				PRINTFORMDL 아큐는 조용히 차를 마신다.
				PRINTFORMDL 그녀는 살짝 얼굴을 찡그리지만, 당신 쪽으로 몸을 돌려 미소를 보여준다.
			CASE 1
				PRINTFORML 
				PRINTFORML 「...차를 만들어 주셔서 정말 감사합니다.」
				PRINTFORMDL 아큐는 감사함에 당신을 향해 살짝 고개를 숙였다.
		ENDSELECT
		PRINTFORMW
	ENDIF
ENDIF
RETURN 1
