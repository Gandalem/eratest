;==================================================
;351,連れ出す
;==================================================

@M_KOJO_MESSAGE_COM_K80_351
;連れ出しにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K80_351_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K80_351_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && CFLAG:同行 == 60
	IF TALENT:恋人
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 
				PRINTFORMDL 아큐우... 나와 함께 가줄 수 있니?
				PRINTFORML 「음...」
				PRINTFORMDL 아큐우는 행복하게 미소 지으며 너를 따라가기 시작한다.
			CASE 1
				PRINTFORML 
				PRINTFORMDL 아큐우, 나랑 같이 가자.
				PRINTFORML 「음... 알겠어. 어디로 데려가려고, %CALLNAME:MASTER%-상?」
				PRINTFORMDL 그녀는 당신의 손을 잡는다.
		ENDSELECT
		PRINTFORMW 
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 
				PRINTFORMDL 아큐우, 나와 같이 가줄래?
				PRINTFORML 「음... 무례하게 굴고 싶지 않아.」
				PRINTFORMDL 그녀는 당신에게 다가와 손을 잡는다.
			CASE 1
				PRINTFORML 
				PRINTFORMDL 아큐의 손 중 하나를 잡는다.
				PRINTFORML 「음? ...산책하고 싶어?」
				PRINTFORMDL 그녀는 당신을 바라보며 미소 짓는다.
				PRINTFORML 「괜찮아... 나 꼭 지켜줘.」
		ENDSELECT
		PRINTFORMW 
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 
				PRINTFORMDL 아큐, 나랑 같이 가줄래?
				PRINTFORML 「...무슨 일이야, %CALLNAME:MASTER%-씨?」
				PRINTFORMDL 너를 데리고 산책을 하고 싶어.
				PRINTFORML 「...음... 알겠어요.」
				PRINTFORMDL 그녀는 당신을 따라오기 시작한다.
			CASE 1
				PRINTFORML 
				PRINTFORMDL 아큐우... 나와 함께 가줄 수 있니?
				PRINTFORML 「흠?... 음, 알겠어.」
				PRINTFORMDL 그녀는 부탁받은 대로 당신을 따르기 시작했다.
				PRINTFORML
		ENDSELECT
		PRINTFORMW 
	ENDIF
ENDIF
RETURN 1
;==================================================
;352,告白する
;==================================================

@M_KOJO_MESSAGE_COM_K80_352
CALL M_KOJO_MESSAGE_COM_K80_352_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K80_352_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193
		PRINTFORMW 「――――――」
		PRINTFORMW
		PRINTFORML 
		PRINTFORMDW ————잠깐만, 아큐우.
		PRINTFORMW 「...무슨 일이야, %CALLNAME:MASTER%-씨?」
		PRINTFORMDW ...너에게 물어볼 게 있어...
		PRINTFORMW 「기꺼이 대답할게, 만약 할 수 있다면..」
		PRINTFORMDW 아큐우가 미소 짓는다.
		PRINTFORMDW 너는 깊은 곳에서 담력을 이끌어낸다.
		PRINTFORMDW 아큐우 씨...
		PRINTFORM 「......」
		PRINTFORMDW 그녀는 주의 깊게 듣는다.
		PRINTFORMDW 당신을 만난 순간부터 연모하게 되었어요...
		PRINTFORMDW 제발요... 제 사랑을 받아주세요!
		PRINTFORMDW 당신은 고개를 숙이고, 그녀를 쳐다보지 못한다.
		PRINTFORM 「...」
		PRINTFORMDW 아큐는 조용히 당신을 바라본다.
		PRINTFORMDW 그녀는 몇 번 말을 걸어보지만 어떻게 대답해야 할지 모른다.
		PRINTFORMDW 아큐는 처음에 당신의 고백에 놀라면서도 기뻐한다.
		PRINTFORMDW 하지만 그녀의 마음은 슬픔으로 가득 차 있다.
		PRINTFORML
		PRINTFORMW 「...미안해...」
		PRINTFORMDW 아큐의 눈에 눈물이 고이고, 목소리가 떨린다.
		PRINTFORMW 「...정말 미안해요, %CALLNAME:MASTER%-상...」
		PRINTFORMDW 그녀는 당신이 자신의 눈물을 보지 않게 등을 돌렸다.
		PRINTFORMW 「%CALLNAME:MASTER%-상, 이제 긴 시간 동안 이세계에 살았잖아요... '미아레의 아이들'의 운명에 대해 들어보고 싶으세요?」
		PRINTFORMW 「평범한 사람과 같은 연모를 얻는 건 저에게... 불가능해요.」
		PRINTFORMDW 당신은 천천히 고개 숙인 자세에서 일어선다.
		PRINTFORMW 「...그러니... 제발... 포기해 주세요... 당신을 위해서예요.」
		PRINTFORML
		PRINTFORMDW 거절해!
		PRINTFORMDW 너는 갑자기 그녀를 뒤에서 껴안는다.
		PRINTFORMW 「...아?! ...제발... 놓아줘.」
		PRINTFORMDW 아큐는 힘없이 몸부림치지만 이미 그녀의 울음소리가 들린다.
		PRINTFORMDW 너는 계속해서 이렇게 조용히 그녀를 안고 있다.
		PRINTFORMW 「30살...」
		PRINTFORMW 「그게 내 수명의 한계야.」
		PRINTFORMDW 나는 이미 알고 있었다.
		PRINTFORMDW 아큐는 몸부림치는 것을 멈춘다.
		PRINTFORMW 「...알면서도, 너는 여전히... 바보야?」
		PRINTFORMDW 너는 침묵을 지키며 그녀를 품에 계속 안고 있다.
		PRINTFORMW 「아플 거야... 열 년 후에 나는 이 세상에서 너를 홀로 두어야만 해...」
		PRINTFORML
		PRINTFORM 「...So...」
		PRINTFORMDW 아큐우가 당신의 손 위에 작은 손을 올린다.
		PRINTFORML
		PRINTFORMW 「나를 포기해줘... 네 자신을 위해서라도...」
		PRINTFORMDW 뜨거운 눈물이 아큐우의 뺨을 타고 흘러내려 당신의 팔 위로 떨어졌다.
		PRINTFORML
		PRINTFORMDW 당신은 그곳에 서서 그녀의 이야기를 조용히 듣는다... 그녀의 마음이 아프다는 것을 느낄 수 있다.
		PRINTFORMDW 오랜 시간이 흐른 뒤, 당신은 마침내 말을 걸기 시작한다.
		PRINTFORMDW 만약 나에게 기회를 준다면, 나는 기꺼이 당신의 모든 짐을 짊어지겠다.
		PRINTFORMDW 사랑이란 그런 것이겠지, 그렇지 않나? 서로의 행복에 안겨주고; 상대방의 고통을 경험하고; 서로의 아픔을 나누는 것.
		PRINTFORMDW 만약 내가 그것들을 할 수 없다면, 그것은 결코 사랑이라고 부를 수 없을 것이다.
		PRINTFORMW
		PRINTFORMDW 아큐는 몸을 돌려 당신의 가슴에 얼굴을 묻고 조용히 울었다.
		PRINTFORMDW 당신은 그녀의 턱을 부드럽게 들어 그녀의 얼굴을 똑바로 바라본다.
		PRINTFORMDW 앞으로 무슨 일이 일어나든, 함께 마주하자.
		PRINTFORMDW 그렇게 말한 후, 당신은 아큐의 부드러운 입술에 키스한다.
		PRINTFORMW 「음————츄...」
		PRINTFORMDW 짧은 충격의 순간 후, 아큐는 힘껏 당신의 목을 끌어안는다.
		PRINTFORML
		PRINTFORMW 『고마워... 정말 고마워...』
		PRINTFORMW 『이 생에서 당신을 만날 수 있어서 정말 기뻐요, %CALLNAME:MASTER%-씨... 정말로... 너무 행복해요...』
		PRINTFORMW
		;プレイヤーの妄想を阻害不ために一人称をあえて使ってなかったというのはないしょ
	ELSE
		PRINTFORML 
		PRINTFORMDW ...아큐우 씨.
		PRINTFORMW 「뭔 거야? 갑자기 왜 그렇게 진지해졌어.」
		PRINTFORMDW 아큐우는 당신을 바라보며 미소 짓는다.
		PRINTFORML 『(말해야 해.)』
		PRINTFORML 『(진심으로...)』
		PRINTFORMDW ...아, 아무것도 아니야. 신경 쓰지 마...
		PRINTFORMW 「무언가 정말 걱정하는 것 같네... 정말 아무것도 아닌 거 맞아?」
		PRINTFORMDW ...괜찮아, 정말로...
		PRINTFORML 「음, 그럼 됐어...」
		PRINTFORMDW 아큐우는 부드러운 미소로 대답한다.
		PRINTFORMDW 당신의 심장을 찢는 듯한 고통을 느낀다.
		PRINTFORMW 『(왜...? 왜 담력을 찾지 못했을까...?!)』
		IF TALENT:恋慕
			PRINTFORMDW 속상함과 자책에 몰두하여,
			PRINTFORMDW 아큐의 슬픈 표정을 알아채지 못한다.
		ELSE
			PRINTFORMDW 당신은 단단하게 주먹을 쥔다.
			PRINTFORMDW 다음에는 더 적극적으로 행동하겠다고 다짐한다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
