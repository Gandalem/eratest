@M_KOJO_EVENT_K80_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SIF FLAG:時間停止 ;fix
			RETURN 1
		LOCALS:0 = 
		IF TALENT:恋人
			LOCALS:0 '= @"부드러운 미소를 지으며"
		ELSEIF TALENT:恋慕
			LOCALS:0 '= @"미소 지으며"
		ELSEIF GETBIT(CFLAG:1,0)
			LOCALS:0 '= @"고정적으로"
		ENDIF
		PRINTFORMDW 아큐는 당신을 바라본다 %LOCALS:0%.
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「아라, %CALLNAME:MASTER%-씨. 어디로 가시는 건가요?」
			PRINTFORMDW 당신은 아큐에게 목적지를 말한다.
			PRINTFORMW 「즐거운 시간 보내세요.」
			PRINTFORMDW 아큐는 부드럽게 말한다.
			PRINTFORMDW 당신도 마찬가지라고, 당신은 아큐에게 인사한다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...아, %CALLNAME:MASTER%-상.」
			PRINTFORMDW 아큐우를 지나친다.
			PRINTFORMW 「아, 음... 그게 아니야, 아무것도 아니야.」
			PRINTFORMDW 아큐우는 무언가 말하려 망설이다가 재빨리 자리를 떠버린다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「안녕, %CALLNAME:MASTER%-상.」
			PRINTFORMDW 당신은 아큐를 지나친다.
			PRINTFORMW 「어디로 가는 거야?」
			PRINTFORMDW 당신은 자신의 목적지를 아큐에게 말한다.
			PRINTFORMW 「아... 알겠어, 다음에 봐.」
			PRINTFORMDW 그렇게 말한 뒤, 아큐는 자리를 떠났다.
		ELSE
			PRINTFORMDW 당신은 아큐우에게 고개를 숙여 인사한다.
			PRINTFORMDW 아큐우는 정중하게 당신의 인사를 받는다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SIF FLAG:時間停止 ;fix
			RETURN 1
		LOCALS:1 = 
		IF TALENT:恋人
			LOCALS:1 '= @"부드러운 미소를 지으며"
		ELSEIF TALENT:恋慕
			LOCALS:1 '= @"미소 지으며"
		ELSEIF GETBIT(CFLAG:1,0)
			LOCALS:1 '= @"고정적으로"
		ENDIF
		PRINTFORMDW 아큐는 당신을 바라본다 %LOCALS:1%.
		RETURN 0
	ENDIF
	;その他
	PRINTFORMW  
ENDIF
RETURN 0
