;夜寝るとき（おやすみ口上）
;==================================================

@M_KOJO_EVENT_K80_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に返回（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「나 곧 집에 가야 해.」
			PRINTFORMW 「에?... 같이 자고 싶어? ...좀 부끄럽네.」
			PRINTFORMW 「내일 봐.」
			PRINTFORMDW 그렇긴 하지만, 아큐는 자신의 방으로 향한다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「푸아아————」
			PRINTFORMDW 아큐가 하품을 한다.
			PRINTFORMW 「좀 피곤하지만, 너랑 조금 더 함께 있고 싶어.」
			PRINTFORMDW 당신은 아큐의 부드러운 보라색 머리를 쓰다듬는다.
			PRINTFORMW 「To...」
			PRINTFORMDW 아큐의 희미하게 속삭이는 목소리가 겨우 들릴 정도였다.
			PRINTFORMW 「...함께......」
			PRINTFORMDW 무슨 소리 했어? 당신이 물었다.
			PRINTFORMW 「아-아무것도 아니야. 그럼, 내일 다시 보자, %CALLNAME:MASTER%-씨.」
			PRINTFORMDW 살짝 실망한 표정으로 아큐는 자신의 방으로 돌아갔다.
		ELSEIF TALENT:思慕
			PRINTFORMDW 집에 갈 시간 아닌가요? 당신이 묻는다.
			PRINTFORMW 「에? 아, 뭐라고 하셨죠? 죄송해요, 잠시 정신을 놓았던 것 같아요.」
			PRINTFORMDW 아큐는 의아한 표정으로 당신을 돌아본다.
			PRINTFORMW 「오, 시간이 참 빨리 갔네요. 벌써 집에 갈 시간이에요. 그럼 안녕 %CALLNAME:MASTER%-상.」
			PRINTFORMDW 그런 말을 남기고, 아큐는 집으로 돌아간다.
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음, 이제 집에 가야겠어.」
					PRINTFORML 「%CALLNAME:MASTER%-씨, 좋은 밤 보내세요.」
					PRINTFORMDL 그렇게 말하고 아큐우는 자기 방으로 돌아간다.
				CASE 1
					PRINTFORML 「저 이제 가야겠어요, 실례하겠습니다.」
					PRINTFORMDL 아큐는 살짝 고개를 숙이고 집으로 돌아갔다.
				CASE 2
					PRINTFORML 「잘 자요, %CALLNAME:MASTER%-씨. 너무 늦게까지 깨어 있지 마세요.」
					PRINTFORMDL 아큐는 집으로 돌아간다.
			ENDSELECT
			PRINTFORMW
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「음... 아, 미안해요. 방금 무슨 말을 했는지 못 들었어요.」
			PRINTFORMDW 아큐는 에너지가 다 된 것 같다.
			PRINTFORMW 「아니에요, 아무것도 아니에요... 저는 괜찮아요.」
			PRINTFORMDW 보라 머리 소녀가 잠이 오지 않는다고 말하고 있지만, 눈꺼풀은 위아래로 처지고 있다. 
			PRINTFORMDW 웃음을 참으려고 애쓴다.
			PRINTFORMW 「어떻게 저한테 저렇게 웃을 수가 있죠.」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「아, 당신과 조금 더 함께 있고 싶어요.」
			PRINTFORMDW 아큐는 지친 두 눈을 뜨고 있으려고 애쓰고 있다.
			PRINTFORMW 「평범한 사람의 에너지라도 있었으면 좋겠는데...」
			PRINTFORMDW 언제 쓰러져도 이상하지 않을 것 같다.
		ELSE
			PRINTFORMW 「후와아————, 나 좀 졸리네.」
			PRINTFORMDW 아큐가 눈에 눈물이 고인 채 그렇게 말했다.
			PRINTFORMDW 그녀는 정말로 졸린 것 같다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「......%CALLNAME:MASTER%-상...」
					PRINTFORMDW 잠든 당신에게 아큐가 이름을 부른다.
					PRINTFORMW 「에헤헤...후우....」
					PRINTFORMDW 정확히 이해하지는 못하지만, 그녀는 행복해 보인다.
				CASE 0
					PRINTFORMW 「음... %CALLNAME:MASTER%-상...」
					PRINTFORMDW 잠든 동안, 아큐가 당신의 이름을 부른다.
					PRINTFORMW 「아... 그건... 창피해...」
					PRINTFORMDW 그녀는 무슨 꿈을 꾸고 있는 걸까?
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「...Uh...Nn...」
					PRINTFORMW 「음... 아니...」
					PRINTFORMDW 아큐는 잠을 자면서 가벼운 소리를 내고 얼굴에 살짝 주름이 잡힌다.
					PRINTFORMDW 그녀는 어떤 꿈을 꾸고 있는 걸까?
				CASE 0
					PRINTFORMW 「냐...아...」
					PRINTFORMDW 아큐는 자면서 살짝 몸을 웅크린다.
					PRINTFORMDW 그녀는 어떤 꿈을 꾸고 있는 걸까?
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「———— ————」
					PRINTFORMDW 아큐는 잠을 자면서 규칙적으로 숨을 쉬고 있다.
					PRINTFORMW 「......」
					PRINTFORMDW 아주 작은 목소리로 그녀도 잠꼬리를 하고 있다.
					PRINTFORMDW 당신은 그녀가 당신의 이름을 부르는 것 같지만, 아마 상상일 것이다.
				CASE 1
					PRINTFORMW 「———— ————」
					PRINTFORMDW 아큐는 잠을 자면서 규칙적으로 숨을 쉬고 있다.
				CASE 0
					PRINTFORMW 「———— ————」
					PRINTFORMDW 아큐는 깊이 잠들어 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「———— ————」
					PRINTFORMDW 아큐는 부드럽게 잠들어 있다.
					PRINTFORMW 「으음...음...」
					PRINTFORMDW 아큐의 우아한 얼굴선과 고운 수면 자세가 어우러져 마치 잠자는 미녀처럼 보인다.
					PRINTFORMDW 당신은 한동안 매료되어 아큐를 바라본다.
				CASE 0
					PRINTFORMW 「———— ————」
					PRINTFORMDW 아큐는 평온한 잠 속에서 비교할 수 없을 만큼 아름답다.
					PRINTFORMDW 그녀는 잠을 자면서 매우 차분한 표정을 짓는다.
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 1
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「Nn...Ah...」
			CASE 1
				PRINTFORMW 「아아... 안... 음...」
			CASE 0
				PRINTFORMW 「아... 더...」
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「ㄴ-음...아...」
			CASE 1
				PRINTFORMW 「아...응-음...」
			CASE 0
				PRINTFORMW 「아아...하아...」
		ENDSELECT
	ENDIF
	RETURN 0
	;ENDIF
	;-------------------------------------------------
	;衰弱中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「....너무 피곤해... 조금 더 함께 있고 싶지만...」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「음... 안 되겠어... 너무 피곤해...」
		ELSE
			PRINTFORMW 「음... 나 좀 피곤해...」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORMW 「%CALLNAME:MASTER%-상, %CALLNAME:MASTER%-상. 괜찮아?」
			PRINTFORMDW 이건 아무것도 아니야. 대답해.
			PRINTFORMW 「나한테 거짓말하지 마, 이건 아무것도 아닌 것 같지 않아.」
			PRINTFORMDW 그렇게 말하면서 아큐는 필사적으로 당신을 자신의 어깨에 지탱한다.
			PRINTFORMW 「내 방으로 돌아가자.」
			PRINTFORMDW 아큐는 자신보다 큰 당신의 몸을 천천히, 고통스럽게 부축하며 걸어간다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「괜찮아?」
			PRINTFORMDW 땅에 쓰러진 채, 아큐의 걱정스러운 목소리가 당신을 부르는 것이 들린다.
			PRINTFORMW 「어차피 내 방으로 돌아가자.」
			PRINTFORMDW 미안하다고 말한다. 그녀는 당신의 몸을 지탱하려 애쓰고 있었다.
		ENDIF
		RETURN 0
	ENDIF
	;その他
	PRINTFORMW  
ENDIF
RETURN 0
