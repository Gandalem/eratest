@M_KOJO_EVENT_K80_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, 당신이었군요, %CALLNAME:MASTER%-상?」
					PRINTFORMDL 아큐는 기쁘게 당신을 부른다.
					PRINTFORML 「오늘도 함께 있을 수 있을까요?」
					PRINTFORMDL 아큐가 당신 쪽으로 걸어온다.
				CASE 1
					PRINTFORML 「환영한다, %CALLNAME:MASTER%-씨.」
					PRINTFORMDL 당신이 그 지역에 들어서자 아큐우가 즉시 당신을 맞는다.
					PRINTFORML 「나는 방금 당신 생각을 하고 있었다.」
					PRINTFORMDL 아큐우는 당신의 가슴에 몸을 기댄다.
			ENDSELECT
			PRINTFORMDW
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「——아, %CALLNAME:MASTER%-씨.」
					PRINTFORMDL 아큐는 좀 긴장한 것 같다.
					PRINTFORML 「환영해요. 차라도 한 잔 드릴까요? 바로 준비해 드릴게요.」
				CASE 1
					PRINTFORML 「안녕, %CALLNAME:MASTER%-씨.」
					PRINTFORMDL 당신의 방향을 바라보며, 아큐는 희미하게 뺨을 붉힌다.
					PRINTFORML 「오늘은 뭘 할까?」
			ENDSELECT
			PRINTFORMW
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「오, %CALLNAME:MASTER%-씨가 아니신가요.」
					PRINTFORMDL 아큐는 당신이 영역에 들어서자 당신 쪽을 바라본다. 
				CASE 1
					PRINTFORML 「안녕하세요, %CALLNAME:MASTER%-상.」
					PRINTFORMDL 아큐가 정중하게 인사한다. 
					PRINTFORML 「만나서 기쁩니다, %CALLNAME:MASTER%-상.」
			ENDSELECT
			PRINTFORMW
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL 발소리 스치는 소리가 들린다.
					PRINTFORML 「실례합니다.」
					PRINTFORML 「아, %CALLNAME:MASTER%-씨.」
					PRINTFORMDL 아큐우가 우아하게 당신에게 다가와 당신의 손을 잡는다.
					PRINTFORML 「그냥 당신 생각 하고 있었어요.」
				CASE 1
					PRINTFORMDL 발소리가 들린다.
					PRINTFORML 「실례합니다.」
					PRINTFORMDL 아큐가 문을 열었을 때... 그녀는 당신을 알아본다.
					PRINTFORML 「안녕하세요, %CALLNAME:MASTER%-상.」
			ENDSELECT
			PRINTFORMW
		ELSE
			PRINTFORMW 「실례합니다.」
			PRINTFORMDW 그렇게 말하며 아큐가 그 구역으로 들어온다.
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが浴室に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아... %CALLNAME:MASTER%-씨가 아니신가.」
					PRINTFORMDL 흰 수건 하나만 걸친 아큐는 몸의 대부분을 공기 중에 노출하고 있다.
					PRINTFORML 「저를 그렇게 쳐다보지 말아 주시겠어요?」
					PRINTFORML 「갑자기 저를 사랑한다고 말씀하시니, 좀 부끄럽잖아요?」
					PRINTFORMDL 아큐가 당신 옆에 앉는다.
				CASE 1
					PRINTFORML 「에? 방금 도착한 거야, %CALLNAME:MASTER%-씨?」
					PRINTFORMDL 입구 근처에 서서 아큐는 수건으로 우아한 몸을 가리고 있었다.
					PRINTFORML 「같이... 들어갈 수 있을까?」
					PRINTFORMDL 당신은 아큐의 요청에서 약간의 긴장감을 느꼈다. 
					PRINTFORMDL 물론이지. 당신은 뒤돌아보며 대답했다.
					PRINTFORMDL 목욕탕에 몸을 담근 아큐는 당신 옆에 앉으러 다가왔다.
				CASE 2
					PRINTFORMDL 발소리가 들린다.
					PRINTFORML 「들어가겠다.」
					PRINTFORMDL 아무것도 걸치지 않은 보라색 머리의 소녀가 입구에 서 있다.
					PRINTFORML 「저, 저런 눈으로 계속 쳐다보면, 저-나는 레이무상을 부를 거예요.」
					PRINTFORMDL 아큐는 발달 중인 가슴을 가리기 위해 오른팔을 들고, 털 없는 음부를 숨기기 위해 왼팔을 올린다.
					PRINTFORML 「이 시점에서는 당신을 아주 잘 알지만, 이처럼 마른 몸을 보고 흥분한다면 의심할 여지 없이 변태예요.」
					PRINTFORMDL 아큐는 부끄러워 보이지만, 그래도 당신 옆에 앉았다.
			ENDSELECT
			PRINTFORMW
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「오, %CALLNAME:MASTER%-상.」
					PRINTFORMDL 수건을 두른 아큐는 욕실 입구 옆에 서 있다. 그녀의 아름다운 다리는 긴장으로 단단히 움츠러들었다.
					PRINTFORML 「혼탕이라니... 좀 부끄럽네요.」
					PRINTFORMDL 그녀의 뺨에는 희미한 홍조가 떠 있었다.
					PRINTFORML 「같이... 같이 들어가도 될까요?」
					PRINTFORMDL 아큐는 당신 맞은편에 앉으며 약간 긴장해 있는 듯했다.
				CASE 1
					PRINTFORML 「아, %CALLNAME:MASTER%-상...」
					PRINTFORMDL 아큐우는 한 장의 수건으로 발달하지 않은 몸을 가리고 있었다.
					PRINTFORMDL 평소 도자기처럼 하얀 그녀의 피부가 희미하게 붉었다. 
					PRINTFORML 「저-저는 죄송해요, 다른 사람이 여기 있을 줄 몰랐어요.」
					PRINTFORMDL 아큐우는 목욕탕을 나서기 시작했다.
					PRINTFORMDL 피곤해? 그녀를 부르며 말한다.
					PRINTFORML 「네?... 조금요...」
					PRINTFORMDL 아큐우는 필사적으로 모르는 척하려고 하지만 %조사처리(CALLNAME:MASTER,"는")% 떨리는 다리와 피로로 가득 찬 눈을 알아차릴 수밖에 없었다.
					PRINTFORMDL 같이 들어가자고 말하며 자신의 수건을 집어 들고 시선을 돌린다.
					PRINTFORMDL 레이무에게서 네 신체 건강에 대해 들었어.
					PRINTFORMDL 아큐우는 입을 벌린 채 그 자리에 서 있었다.
					PRINTFORML 「당신은 친절한 사람이네요. 감사합니다, %CALLNAME:MASTER%...」
					PRINTFORMDL 아큐우는 당신 맞은편에 앉는다.
			ENDSELECT
			PRINTFORMW
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが浴室に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「.........」
		PRINTFORMDW 아큐는 목욕 중이지만, 당신을 보자마자 즉시 자리를 떠버린다.
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;TARGETが浴室に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMDW 아큐가 당신이 욕실에 들어온 것을 보자 놀라서 고개를 숙이며 묻는다,
		PRINTFORMW 「기다려 줄 수 있니? 거의 다 했어.」
		PRINTFORMDW 당신은 어쩔 수 없이 목욕탕을 떠나야 한다.
		RETURN 0
	ENDIF
ENDIF
RETURN 0
