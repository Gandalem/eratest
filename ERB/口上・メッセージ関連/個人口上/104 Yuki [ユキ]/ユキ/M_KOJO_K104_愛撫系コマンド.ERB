@M_KOJO_MESSAGE_COM_K104_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORML 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「훗, 우음... 그래, 만져줘」
			PRINTFORMW 「...응~ 계속...」
		ELSE
			PRINTFORML 「아아~…… 범해진다니, 싫어~」
			PRINTFORMW 「아하하……윽 %UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTDATAW
				DATAFORM 「안 돼, %조사처리(CALLNAME:MASTER,"에게")% 만져지면, 벌써…… %UNICODE(0x2665) *1%」
				DATAFORM 「아, 아파…… %UNICODE(0x2665) *1% 아, 아…… 더, 온몸이, 윽…… %UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTFORMW 「윽, 정성스럽네... %UNICODE(0x2665) *1% 맞아, 부드럽게 해줘 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
