	ELSE
		PRINTFORML 「아 %UNICODE(0x2665) *1% 응, 기분 좋은 곳이야 %UNICODE(0x2665) *1%」
		PRINTFORMW 「하아, 큰일이야... %UNICODE(0x2665) *1%」
	ENDIF
ENDIF
RETURN 1
