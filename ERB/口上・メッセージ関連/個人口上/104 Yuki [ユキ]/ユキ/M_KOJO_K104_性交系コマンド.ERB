				CASE 2
					PRINTFORML 「그렇지, 더, 더 %UNICODE(0x2665) *1% 어, 크윽 %UNICODE(0x2665) *1%」
					PRINTFORMW 「아으, 아아 %UNICODE(0x2665) *1% 큭, 잇…… %UNICODE(0x2665) *1%」
			ENDSELECT
		ELSE
			PRINTFORML 「앗, 윽 %UNICODE(0x2665) *1% 아아, 넣어버렸어, 하 %UNICODE(0x2665) *1%」
			PRINTFORMW 「하하, 가까워... %UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
