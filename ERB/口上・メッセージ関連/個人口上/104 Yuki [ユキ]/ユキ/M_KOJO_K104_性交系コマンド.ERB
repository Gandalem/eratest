				CASE 0
					PRINTFORML 「んぉ%UNICODE(0x2665) *1% またぁ읏、そんなに읏%UNICODE(0x2665) *1% う! うぇ……」
					PRINTFORMW 「ぅ、うぅ～……ゆ、揺らさないでぇ～……」
				CASE 1
					PRINTFORML 「우아, 아아%UNICODE(0x2665) *1% 음~%UNICODE(0x2665) *1% 우~읏%UNICODE(0x2665) *1%」
