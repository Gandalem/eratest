	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		PRINTDATAW
			DATAFORM 「응, 으윽 %UNICODE(0x2665) *1% 크윽, 아우, 오오...윽 %UNICODE(0x2665) *1%」
			DATAFORM 「에엑, 윽, 안 돼... 응 %UNICODE(0x2665) *1% 잇, 더... %UNICODE(0x2665) *1%」
		ENDDATA
		RETURN 1
	ELSEIF EXP:子宮口開発経験 > 25
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTDATAW
				DATAFORM 「んぉ %UNICODE(0x2665) *1% そう읏、奥が……苦しくてぇ、気持ちいい……읏 %UNICODE(0x2665) *1%」
				DATAFORM 「ぎ읏、ぅ……もと、もと深くぅ %UNICODE(0x2665) *1% そのままで、そこで出してぇ %UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTFORML 「윽……어째서 %UNICODE(0x2665) *1% 이렇게 오는 거야……%UNICODE(0x2665) *1%」
			PRINTFORMW 「아, 안 돼…… 이상해지고 있을지도 몰라……%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「응, 괴로워... %UNICODE(0x2665) *1%」
			PRINTFORMW 「하지만... %조사처리(CALLNAME:MASTER,"로")%, 가득... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「이, 이럴 수가!? 잠깐만, 너무 심하잖아요...윽」
		ENDIF
	ENDIF
ENDIF
