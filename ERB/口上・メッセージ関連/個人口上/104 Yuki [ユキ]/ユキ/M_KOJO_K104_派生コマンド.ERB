;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K104_6
CALL M_KOJO_MESSAGE_SCOM_K104_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K104_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORML 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		PRINTDATAW
			DATAFORM 「いぃぃ읏%UNICODE(0x2665) *1% そ읏、そこぉ읏%UNICODE(0x2665) *1% ひ읏、いぃ읏%UNICODE(0x2665) *1%」
			DATAFORM 「ああ゛ぁ～읏! うあぁ읏%UNICODE(0x2665) *1% あえぇ읏、う゛ぅ～%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ENDDATA
		RETURN 1
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTDATAW
				DATAFORM 「흐으! 아아, 아앗 %UNICODE(0x2665) *1%! 굉장해, 좋아...!! %UNICODE(0x2665) *1%」
				DATAFORM 「응, 지금처럼 %UNICODE(0x2665) *1% 더, 더 해줘 %UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTFORMW 「거짓말, 저건 뭐야 %UNICODE(0x2665) *1% 엄청나게 온다 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K104_{SELECTCOM}_1
RETURN 1
