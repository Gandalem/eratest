			DATAFORM 「いぃぃ읏%UNICODE(0x2665) *1% そ읏、そこぉ읏%UNICODE(0x2665) *1% ひ읏、いぃ읏%UNICODE(0x2665) *1%」
			DATAFORM 「ああ゛ぁ～읏! うあぁ읏%UNICODE(0x2665) *1% あえぇ읏、う゛ぅ～%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ENDDATA
		RETURN 1
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「야앗 %UNICODE(0x2665) *1% 몸 안, 티 나고 있어 %UNICODE(0x2665) *1%」
			PRINTFORMW 「그, 거기인가요…… %UNICODE(0x2665) *1% 굉장해욧 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「잠깐, 자궁 안에 들어왔어%UNICODE(0x2665) *1% 그런 건 있어...?」
		ENDIF
	ENDIF
ENDIF
