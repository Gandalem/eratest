; Modular ERB: 個人口上/104 Yuki [ユキ]/ユキ/M_KOJO_K104_依頼.ERB
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K104(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K104(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K104(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%이라면, 이 정도는 간단하잖아?」
					PRINTFORMW 「부탁이야, 사례는 꼭 할 테니까!」
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 맡아주면, 나도 안심이 되는데~」
					PRINTFORMW 「어때, 해줄 수 있어?」
				CASE 2
					PRINTFORML 「맞아, 잠깐 시간 돼?」
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 팔을 믿고 좀 부탁할 게 있어서 %UNICODE(0x2665) *1%」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「좋아! %CALLNAME:MASTER%, 시간 안 나?」
					PRINTFORMW 「잠깐, 일 좀 부탁할까 해서」
				CASE 1
					PRINTFORML 「있잖아, 좀 부탁하고 싶은 게 있는데... 어때?」
					PRINTFORMW 「물론, 공짜로 하진 않을 거야!」
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%인가... 응, 의외로 괜찮을지도!」
					PRINTFORMW 「사실 좀 곤란한 일이 있어서 말이야」
			ENDSELECT
		ENDIF
	CASE "依頼非受託時"
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아아, 무리야? 그렇구나……. 그럼, 괜찮아」
					PRINTFORMW 「그렇게 대단한 문제는 아니니까 신경 쓰지 마!」
				CASE 1
					PRINTFORML 「크윽, 안 되는 건가…. 알았어, 스스로 해보도록 할게.」
					PRINTFORMW 「하지만 막히면 또 상담할지도 몰라... 그때는 잘 부탁해!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「그렇게 격식 차릴 필요 없어, 그냥 시험 삼아 물어본 것뿐이니까.」
					PRINTFORMW 「음~ 그 외에 부탁할 만한 건... 잠깐」
				CASE 1
					PRINTFORML 「에엣, 안 돼? 바빠? 아니면 보수에 불만이 있어?」
					PRINTFORMW 「크윽... 사람을 고용하는 것도 어려운 거네.」
			ENDSELECT
		ENDIF
	CASE "依頼受託時"
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「괜찮아? 휴, 살았다...」
					PRINTFORMW 「역시, 곤란할 때는 %CALLNAME:MASTER%같은 느낌이네!」
				CASE 1
					PRINTFORML 「역시~ 상냥하네%UNICODE(0x2665) *1%」
					PRINTFORMW 「그럼, 맡길게」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「오, 해줄 수 있어? 역시~ 만물상답네!」
					PRINTFORMW 「그럼 나머지는 뭔가 좋은 느낌으로 잘 부탁해 %UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORML 「해냈다%UNICODE(0x2665) *1% 고마워, 한번 들어보는 거지!」
					PRINTFORMW 「하지만 그래도, 받아들였으니까 제대로 해줘?」
			ENDSELECT
		ENDIF
	CASE "依頼確認時"
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「의뢰 건이네! 응응, 확인은 중요하지」
			PRINTFORML 「이제, 몇 번이라도 가르쳐 줄 테니까」
		ELSE
			PRINTFORML 「엣, 설마 잊어버린 거야!?」
			PRINTFORML 「어쩔 수 없네, 그럼 한 번만 더 해줄게……아, 메모 같은 거 할래?」
		ENDIF
	CASE "依頼破棄時"
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「그렇구나, 안 되어버렸구나……」
					PRINTFORMW 「응, 아마 어떻게든 할 수 있으니까…… 일단, 의뢰는 취소할게」
				CASE 1
					PRINTFORML 「엣! 의, 의 취소라니...」
					PRINTFORMW 「우으, 알겠어... 어쩔 수 없네, 완전히 의존하고 있었으니까」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「그만둔다고... 그런 말은, 충격이야」
					PRINTFORMW 「그렇다면 대신 다른 사람이라도 소개해 주지 않을래? 스케줄이 맞는 사람이랑」
				CASE 1
					PRINTFORML 「어라, 포기하는 거야?」
					PRINTFORML 「설마, 잘 생각해 보니 생각보다 힘들었다는 거?」
					PRINTFORMW 「안 돼~ 안 좋은 약속을 하면」 
			ENDSELECT
		ENDIF
	CASE "依頼実行直前"
		;●[367]で依頼を実行する時、実行処理の前に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【◆口上】
		;【実行時の地の文・ソース等】
		;【▼下の口上に続く】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		ENDIF
	CASE "依頼実行直後"
		;●[367]で依頼を実行する時、実行処理の後に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【▲上の口上から続き】
		;【◆口上】
		;【達成時・CLIENT：▼下の口上に続く】
		;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ENDIF
	CASE "成功報告時"
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「응, 완벽해! 역시 너는 대단하다」
					PRINTFORMW 「약속한 보상도 있으니까... 앞으로도 잘 부탁해 %UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%답게, 잘 해줄 거라고 생각은 했지만」
					PRINTFORMW 「기대대로네! 도와줘서 고마워~ %UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORML 「역시, %조사처리(CALLNAME:MASTER,"에게")% 부탁한 게 정답이었나 봐요 %UNICODE(0x2665) *1%」
					PRINTFORMW 「그럼, 약속에 대한 감사! 또 뭔가 부탁할지도 모르니까 잘 부탁해요」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이야, 꽤 잘하는걸~」
					PRINTFORMW 「이런 거, 꽤 자신 있었나?」
				CASE 1
					PRINTFORML 「이걸로, 의뢰는 완료네…… 고마워, %CALLNAME:MASTER%!」
					PRINTFORMW 「그럼…… 어, 보수는? 아하하, 기억하고 있었나」
				CASE 2
					PRINTFORML 「음...... %CALLNAME:MASTER%, 꽤 요령이 좋네~」
					PRINTFORMW 「또 무슨 일 있으면 상담해 볼까나~」
			ENDSELECT
		ENDIF
	CASE "失敗報告時"
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「맞아, %CALLNAME:MASTER%! 의뢰했던 건 말이야」
				PRINTFORMW 「역시, 잊고 있었어? 정말, 제대로 해줘~」
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%말이야... 의뢰, 잊고 있었지?」
				PRINTFORMW 「정말이지... 이건 뭔가로 보상받아야겠어 %UNICODE(0x2665) *1%」
		ENDSELECT
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
ENDSELECT
RETURN 1
