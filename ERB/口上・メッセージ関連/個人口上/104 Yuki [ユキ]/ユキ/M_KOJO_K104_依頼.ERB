	CASE "依頼非受託時"
		PRINTFORML 「흐윽, 너무 달라붙었어...?」
		PRINTFORMW 「뭐야~ 분위기가 부족하다니? 상관없잖아, 그런 거... 기분 좋으면 됐지 뭐」
		RETURN 1
	CASE "依頼受託時"
		PRINTFORML 「다행이다, 기꺼이 해줘서... 정말 참고 있었어, 이제 한계였거든」
		PRINTFORMW 「그럼, 마음껏 즐기자고... %UNICODE(0x2665) *1%」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")%, 잔뜩 안아줬으면 하는 거야……%UNICODE(0x2665) *1%」
		PRINTFORML 「……앗, 설마 말하게 하고 싶었던 건가?」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「에엣, 잠깐! 정말 그만두는 거야!?」
		PRINTFORMW 「그런 거... 벌써 의욕 만땅이었는데 말이야」
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【※依頼処理側にある専用口上が表示されます】
		;【▼そのまま下の口上へ】
		PRINTFORML 「자, 됐어! 사소한 건 됐으니까 빨리 해버리자.」
		PRINTFORMW 「내가 만족할 때까지 같이 있어 줄 테니까~?」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\20,000
		PRINTFORML 「하아, 다행이다%UNICODE(0x2665) *1% 이 정도 보상이라면 괜찮을지도 모르겠네」
		PRINTFORMW 「……또 잘 부탁해%UNICODE(0x2665) *1%」
		RETURN 1
	CASE "失敗報告時"
		PRINTFORML 「우윽, 가지고 놀아졌어...」
		PRINTFORMW 「크으... 억지로 쓰러뜨렸으면 좋았을까」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================

@M_KOJO_IRAI_16_K104(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		IF TFLAG:193 == 1
			;正解の選択肢
		ELSEIF TFLAG:193 == 2
			;ハズレの選択肢だったが逆に正解
		ELSEIF TFLAG:193 == -1
			;ハズレの選択肢
		ELSEIF TFLAG:193 == -2
			;正解の選択肢だったが逆にハズレ
		ENDIF
		RETURN 0
	CASE "成功報告時"
		;報酬：野菜か果物
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "口上委託率"
		;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
		RESULT:100 = 0
		;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
		;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
		;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
		;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
		RESULT:1 = 0
		RESULT:2 = 0
		RETURN 1
	CASE "口上専用"
		;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
		;16,お悩み相談 の場合
		;RESULT        発生判定,0だと発生しません
		;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
		;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
		;RESULTS:0     お悩み文章（自動で『』で囲まれます）
		;RESULTS:1～3  選択肢１～３
		;何も発生しない状態になると無限ループになるので注意してください
		;●追記メモ
		;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
		;RESULT:1を7にするとどれも正解になります
		;RESULT:1を8にするとどれもハズレになります
		;1～3以外の場合は逆張り判定が自動で無くなります
		RESULT = 0
		;▼サンプル
		SIF !RESULT
			RESTART
		RETURN 1
ENDSELECT
