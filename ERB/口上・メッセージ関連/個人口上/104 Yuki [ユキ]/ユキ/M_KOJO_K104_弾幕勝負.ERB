; Modular ERB: 個人口上/104 Yuki [ユキ]/ユキ/M_KOJO_K104_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K104_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF TALENT:恋慕 || TALENT:愛欲
			IF ABL:戦闘能力 >= ABL:MASTER:戦闘能力
				PRINTFORML 「에, 승부? 물론 괜찮아~」
				PRINTFORML 「하지만, 다치지 않도록 조심해줘?」
				PRINTFORMW 「분명 내가 이겨버릴 테니까!」
			ELSE
				PRINTFORML 「승부네! %조사처리(CALLNAME:MASTER,"가")% 상대라니, 긴장을 놓을 수가 없잖아~」
				PRINTFORMW 「하지만 강한 사람이랑 해야 하잖아!」
				PRINTFORMW 「열심히 해버릴 테니까!」
			ENDIF
		ELSE
			PRINTFORML 「흥, 나를 쓰러뜨릴 수 있다고 생각하는 거야?」
			PRINTFORMW 「마계의 마법사는 그쪽 애들과는 격이 다르다고!」
			PRINTFORMW 「자, 물리쳐 주겠어!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML
			CASE 2
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「아앗, 당해버렸다...... 역시 대단하네!」
					PRINTFORMW 「하지만 아직 끝나지 않았어! 갈까~?」
				ELSE
					PRINTFORML 「아, 어라? 이상하네……」
					PRINTFORMW 「음~ ...좋았어, 일단 다시 한 번!」
				ENDIF
			CASE 1
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「안 돼~ 또 해버렸어……」
					PRINTFORMW 「집중, 집중! 멋없는 모습만 보여줄 순 없잖아!」
					PRINTFORMW 「좋아, 한 번 더!」
				ELSE
					PRINTFORML 「아얏! 어떻게 이럴 수가~?」
					PRINTFORMW 「진심으로 해버릴 테니까!!」
				ENDIF
			CASE 0
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORMW 「우에~ㄴ, 왜 그렇게 강한 거야~……」
					PRINTFORMW 「수고했어, %CALLNAME:MASTER%……즐거웠어」
					PRINTFORMW 「……하아~」
				ELSE
					PRINTFORML 「이, 이럴 리가 없는데...」
					PRINTFORMW 「당신, 대체 누구야...」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		PRINTFORML 「좋아, 특제다!」
		PRINTFORMW 「이걸로 받아라~!」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「잠깐, 괜찮아?」
					PRINTFORMW 「이 근처는 위험한 녀석들도 많은 것 같고... 조금 불안하네~」
					PRINTFORMW 「같이 특훈 해줄까?」
				ELSE
					PRINTFORML 「아하핫! 나, 강하지 않아!」
					PRINTFORMW 「후후~응, %CALLNAME:MASTER%도 잘 버텼잖아?」
				ENDIF
			CASE 2
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「아쉬웠네, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
					PRINTFORMW 「승부는 또 언제든 같이 해줄 테니까 말이야」
					PRINTFORMW 「시합 외의 것도, 그…… 물론 괜찮지만」
				ELSE
					PRINTFORML 「나에게 흠집 하나 남긴 것만으로도 충분한 성과야!」
					PRINTFORMW 「또 해줄 수도 있지만, 다음엔 완벽하게 박살 내 줄 테니까.」
				ENDIF
			CASE 1
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「음~, 호각이네!」
					PRINTFORMW 「훈련 상대치로, 서로 딱 좋지 않아?」
					PRINTFORMW 「같이 힘내자!」
				ELSE
					PRINTFORML 「이겼다... 아슬아슬했네」
					PRINTFORMW 「이렇게 몰리다니... 좀 안 좋겠어.」
				ENDIF
			CASE 0
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「나, 약한 걸까……」
					PRINTFORMW 「같이 특훈 같은 거 해줄 수 없어?」
					PRINTFORMW 「왠지 마이에게 부탁하기 미안해서……%CALLNAME:MASTER%이라면, 신뢰할 수 있으니까」
				ELSE
					PRINTFORML 「으윽, 정말 분하다」
					PRINTFORMW 「다음엔 지지 않을 테니까... 다음에 또 하자」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
