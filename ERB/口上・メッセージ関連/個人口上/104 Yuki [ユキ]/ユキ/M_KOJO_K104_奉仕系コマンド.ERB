	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「음후후, 그럼 응리력 없이 꾹%UNICODE(0x2665) *1%」
			PRINTFORMW 「응... 음%UNICODE(0x2665) *1% 음~%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「빨아줄까~? 좋아, 갈게」
			PRINTFORMW 「음질르륵... 응, 하아... 음헤헤, 괴로워」
		ENDIF
		RETURN 1
		;通常
	ELSE
		IF NOWEX:MASTER:射精
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「먹여 줄 거야~?」
				PRINTFORMW 「그럼, 잘 먹겠습니다%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「와앗, 입이 좋네?」
				PRINTFORMW 「어쩔 수 없지~」
			ENDIF
		ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「네~ 맡겨줘 %UNICODE(0x2665) *1%」
				PRINTFORMW 「하지만... 아직 끝나지 않았잖아?」
			ELSE
				PRINTFORML 「깨끗하게 해줬으면 좋겠어~?」
				PRINTFORMW 「또, 금방 더럽히는 거 아니야?」
			ENDIF
		ELSE
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「아무... 음~%UNICODE(0x2665) *1%」
				PRINTFORMW 「응, 응, 응...」
			ELSE
				PRINTFORML 「물어볼래?」
				PRINTFORMW 「좋아~, 할까?」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
