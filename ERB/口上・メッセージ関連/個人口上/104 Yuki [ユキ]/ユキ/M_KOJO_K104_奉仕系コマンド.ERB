;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K104_80
CALL M_KOJO_MESSAGE_COM_K104_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K104_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「하아~이, 스윽스윽~」
			PRINTFORMW 「어때, 이런 느낌으로 좋아~?」
		ELSE
			PRINTFORML 「아하하, 구르르~」
			PRINTFORMW 「음~ 뭔가 굉장하네.」
		ENDIF
		RETURN 1
		;通常
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「손으로? 응, 맡겨줘」
			PRINTFORMW 「내가 확실하게 기분 좋게 해 줄 테니까... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「어떻게 되는 게 기분 좋은 거야?」
			PRINTFORMW 「여러 가지 시도해 볼 테니까~」
		ENDIF
	ENDIF
ENDIF
RETURN 1
