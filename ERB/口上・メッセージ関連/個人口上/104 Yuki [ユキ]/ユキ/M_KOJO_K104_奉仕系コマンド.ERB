@M_KOJO_MESSAGE_COM_K104_82
CALL M_KOJO_MESSAGE_COM_K104_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K104_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「음, 음쇼, 음, 음……」
			PRINTFORMW 「우으…… 어렵다구, 미안해…… %CALLNAME:MASTER%」
		ELSE
			PRINTFORML 「파이즈리~? 내가 하는 거야?」
			PRINTFORMW 「에~, 자, 자... 자, 어때요」
		ENDIF
		RETURN 1
		;通常
	ELSE
		IF ABL:TARGET:胸 < 2
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「응, 내 것으로 괜찮다면...」
				PRINTFORMW 「어, 어때? 됐어?」
			ELSE
				PRINTFORML 「좀, 무리가 가는 것 같은데……」
				PRINTFORMW 「아! 불만 접수는 받지 않으니까.」
			ENDIF
		ELSE
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「어때? %조사처리(CALLNAME:MASTER,"의")% 기분 좋은 부분이라면, 제대로 알고 있으니까~」
				PRINTFORMW 「자아, 점점 더 갈 거야 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「흥... 크면 좋은 것만 있는 게 아니라는 걸 보여주지」
				PRINTFORMW 「진심을 내버릴 테니까!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
