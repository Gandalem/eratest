; Modular ERB: 個人口上/104 Yuki [ユキ]/ユキ/M_KOJO_K104_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K104
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	IF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
	ELSE
		PRINTFORMW 「하아~…… 온 힘을 다해 왔어……」
		PRINTFORMW 「참을 수 없어~, 이거%UNICODE(0x2665) *1%」
	ENDIF
ELSEIF TFLAG:23 == 2
	IF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
	ELSE
		PRINTFORMW 「하아... %UNICODE(0x2665) *1% 아직, 몸이, 아... %UNICODE(0x2665) *1%」
		PRINTFORMW 「%CALLNAME:MASTER%……」
		PRINTFORMW 「다시 한번, 데려가줘...」 %UNICODE(0x2665) *1%
	ENDIF
ELSEIF TFLAG:23 == 3
	IF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 
	ELSE
		PRINTFORMW 「응에……이게 뭐야……윽」
		PRINTFORMW 「……%CALLNAME:MASTER%……후우……」
		PRINTFORMW 「감히, 이런 짓을 하다니……」
		PRINTFORMW 「이제……다른 것으로는 만족할 수 없잖아……%UNICODE(0x2665) *1%」
	ENDIF
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「있잖아, %CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
	PRINTFORMW 「응~, 아무것도 아니야!」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 있으면, 뭔가……」
	PRINTFORMW 「어떻게 말해야 할까, 이 기분」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「……%CALLNAME:MASTER%……」
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 위해서라면, 나……%UNICODE(0x2665) *1%」
	PRINTFORMW 「어라, 무슨 소리를 하는 거지…… 뭔가 이상해」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 「……음~……」
	PRINTFORMW 「정말, 화났어!」
	PRINTFORMW 「흥!」
ELSEIF TFLAG:21 == 2
	PRINTFORMW 
ELSEIF TFLAG:21 == 3
	PRINTFORMW 
ENDIF
