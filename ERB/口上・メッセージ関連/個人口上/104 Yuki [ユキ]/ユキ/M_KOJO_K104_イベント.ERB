;==================================================
;贈り物イベント
;==================================================

@M_KOJO_EVENT_K104_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	PRINTFORML 「맞아, %조사처리(CALLNAME:MASTER,"에게")% 주려고 했던 게 있거든!」
	PRINTFORMW 「짜잔, 이거! 음... %GIFT_NAME%였나? ...?」
	IF TALENT:恋慕 || TALENT:愛欲
		PRINTDATAW
			DATAFORM 「항상 신세 지고 있어요! 저기... 앞으로도 잘 부탁해요.」
			DATAFORM 「저 나름으로, 제대로 골랐을 거라고 생각하는데... 어때요? 그, 마음에 들어 주면 기쁠 거예요!」
		ENDDATA
	ELSE
		PRINTFORML 「왠지, 뭔가 %CALLNAME:MASTER%에 어울릴 것 같아서!」
		PRINTFORMW 「소중히 해줘?」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物を大事にする（700点以上）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	IF TALENT:恋慕 || TALENT:愛欲
		PRINTFORML 「음~, 몇 번을 봐도 좋아~... 이거」
		PRINTFORML 「게다가, %CALLNAME:MASTER%로부터의... %UNICODE(0x2665) *1%」
		PRINTFORMW 「우아아~! 대박이야 대박!! %UNICODE(0x2665) *1%」
		PRINTFORML 
	ELSE
		PRINTFORML 「맞아, 맞아! 선물 받은 거였지!」
		PRINTFORMW 「이거 이거... 후후~ %UNICODE(0x2665) *1% 좋은 거 받았네~ %UNICODE(0x2665) *1%」
		PRINTFORMW 「쟤 정말 대단하네...」
		PRINTFORML 
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	IF TALENT:恋慕 || TALENT:愛欲
		PRINTFORMW 「헤헤, %조사처리(CALLNAME:MASTER,"의")% 사랑을 느끼네~%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「이거 전설의 경지에 도달했네~」
		PRINTFORMW 「후훗, 마이에게도 자랑해줘야지~」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	IF TALENT:恋慕 || TALENT:愛欲
		PRINTFORML 「%CALLNAME:MASTER%에게서 온 선물인가~……응, 어쩐지 맛이 있달까」
		PRINTFORMW 「에헤헤헤……%UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「맞아, 선물 받았었지!」
		PRINTFORML 「응, 뭔가 쓸 곳이 있을지도...?」
		PRINTFORMW 「뭐... 나중에 생각해 둘게」 
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	IF TALENT:恋慕 || TALENT:愛欲
		PRINTFORML 「소중한 %CALLNAME:MASTER%에게서 받은 선물인데……. 크으」
		PRINTFORMW 「뭐, 뭐……. 가지고 있으면서 잊어버리는 것보단 건전하겠지! ……분명」
		PRINTFORMW 「윽, 죄책감이……」
	ELSE
		PRINTFORML 「맞아, 선물 받았었지... 음~ 근데 말이야」
		PRINTFORML 「뭐, 전혀 필요 없으니까... 최대한 유용하게 사용해 봐야겠어」
		PRINTFORMW 「정리 정돈, 좋아!」 
	ENDIF
ENDIF
RETURN 1
;==================================================
;ムシバトル
;ムシバトルの口上は少し特殊で、PRINTを使うのではなく、
;台詞一行のみをRESULTSに入れてください
;ムシの名前は %MUSHI_NAME% で表示できます
;ムシの名前の最長はアレキサンドラトリバネアゲハの全角14文字です
;文字数制限があります。はみ出ないように気をつけてください
;ARGは残りムシ数か順位です
;==================================================

@M_KOJO_MESSAGE_COM_K104_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「さぁっ、勝負ね！　わたしが相手をしてあげるわ！」
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE ARG
				CASE 3
					RESULTS = 「まずはこいつよ！　魔界の！%MUSHI_NAME%！」
				CASE 2
					RESULTS = 「やったな～？　次はこいつ！　真紅の！%MUSHI_NAME%！」
				CASEELSE
					RESULTS = 「本気出しちゃうから！！　行け、禁断の！%MUSHI_NAME%！」
			ENDSELECT
		ENDIF
	CASE "攻撃時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》の『（攻撃名）』！」"の直前
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「行け～、必殺技よ！　クリムゾン・デッド・メテオバースト！」
				CASE 1
					RESULTS = 「頑張ってよぉ、%MUSHI_NAME%！　ご褒美あげるから！」
				CASEELSE
					RESULTS = 「%MUSHI_NAME%！　あいつの弱点は目よ！　狙い打て～！」
			ENDSELECT
		ENDIF
	CASE "倒れた時"
		;-------------------------------------------------
		;"【（キャラ）】《（ムシ）》は倒れた！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			SELECTCASE RAND:3
				CASE 0
					RESULTS = 「立て、%MUSHI_NAME%！　……あ、ダメそうね……お疲れ様」
				CASE 1
					RESULTS = 「なんでそんなに強いのよ～！　さては、ムシバトルやりこんでるな～？」
				CASEELSE
					RESULTS = 「ああっ、わたしの%MUSHI_NAME%！　……い、生きてる？」
			ENDSELECT
		ENDIF
	CASE "敗退時"
		;-------------------------------------------------
		;"【（キャラ）】敗退！！"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		残りムシ数 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「うう、めちゃくちゃ悔しい……ごめんね、わたしのムシたち」
		ENDIF
	CASE "タイマン：勝ち"
		;-------------------------------------------------
		;順位は1位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「勝った……わたし、才能あるかも？」
		ENDIF
	CASE "タイマン：負け"
		;-------------------------------------------------
		;順位は2位
		;全角20文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「負けた、このわたしが……やるな～」
		ENDIF
	CASE "バトルロイヤル：優勝"
		;-------------------------------------------------
		;順位は1位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「1位……わたし、才能あるかも？」
		ENDIF
	CASE "バトルロイヤル：２位以下"
		;-------------------------------------------------
		;順位は2～4位
		;全角30文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「バトルロイヤル、奥が深いわ……！」
		ENDIF
	CASE "チーム戦：勝ち"
		;-------------------------------------------------
		;順位は1位（やられていても）
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「チームワークの差ね！　名コンビの予感がする！」
		ENDIF
	CASE "チーム戦：負け"
		;-------------------------------------------------
		;順位は2位
		;全角32文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		順位 = ARG
		;-------------------------------------------------
		IF LOCAL:1
			RESULTS = 「チームワークの差ね……もっとお互いを知りましょ」
		ENDIF
ENDSELECT
SIF RESULTS != ""
	RETURN 1
