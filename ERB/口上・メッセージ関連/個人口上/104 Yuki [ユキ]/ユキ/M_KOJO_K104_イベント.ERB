@M_KOJO_EVENT_K104_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:318 == 1
			PRINTFORML 
		ELSEIF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF DAY:2 == 4 && DAY:3 == 14 && CFLAG:104:好感度 >= 1000 && !TCVAR:104:今日会ったか
			CALL EVENTDAY_GREETING_K104
		ELSEIF CFLAG:104:オナバレ == 1
			PRINTFORML 「아, %CALLNAME:MASTER%……저기 있잖아요, 지난번에……」
			PRINTFORML 「아~……아무것도 아니에요」
			PRINTFORMW 「하아……」
		ELSEIF CFLAG:104:オナバレ
			IF (TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ)
				PRINTFORML 「%CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
				PRINTFORMW 「다음에도 딱 맞춰 와 준다면... 상대해 줄 테니까.」
			ELSE
				PRINTFORML 「윽, %CALLNAME:MASTER%……」
				PRINTFORML 「지난번엔 흘러가 버렸지만, 다음엔 이럴 순 없어!」
				PRINTFORMW 「조심해 줘!」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「앗, %CALLNAME:MASTER%!」
			PRINTFORMW 「기다리고 있었어 %UNICODE(0x2665) *1%」
		ELSEIF TALENT:思慕
			PRINTFORML 「아, %CALLNAME:MASTER%!」
			PRINTFORMW 「오늘은 뭐 하고 있는 거야?」
		ELSE
			PRINTFORMW 「아라, %CALLNAME:MASTER%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:318 == 1
			PRINTFORML 
		ELSEIF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF DAY:2 == 4 && DAY:3 == 14 && CFLAG:104:好感度 >= 1000 && !TCVAR:104:今日会ったか
			CALL EVENTDAY_GREETING_K104
		ELSEIF CFLAG:104:オナバレ == 1
			PRINTFORML 「아, %CALLNAME:MASTER%……저기 있잖아요, 지난번에……」
			PRINTFORML 「아~……아무것도 아니에요」
			PRINTFORMW 「하아……」
		ELSEIF CFLAG:104:オナバレ
			IF (TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ)
				PRINTFORML 「%CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
				PRINTFORMW 「다음에도 딱 맞춰 와 준다면... 상대해 줄 테니까.」
			ELSE
				PRINTFORML 「윽, %CALLNAME:MASTER%……」
				PRINTFORML 「지난번엔 흘러가 버렸지만, 다음엔 이럴 순 없어!」
				PRINTFORMW 「조심해 줘!」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「아, 있었네!」
			PRINTFORMW 「있잖아, 나랑 놀아줘」
		ELSEIF TALENT:思慕
			PRINTFORML 「아, %CALLNAME:MASTER%……」
			PRINTFORMW 「아~……시간 있으면, 같이 어디 가지 않을래?」
		ELSE
			PRINTFORMW 「아라, %CALLNAME:MASTER%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:318 == 1
			PRINTFORML 
		ELSEIF TCVAR:泥酔 == 1
			PRINTFORML 
