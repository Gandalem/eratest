@M_KOJO_EVENT_K104_18(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;避妊要求台詞
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「안 돼, 안 돼. 애들은 골치 아프다고」
		PRINTFORMW 「싫어!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「그런 말을 해도 안 돼! 참아줘~」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断ったのに粘られて切れた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「시끄러워~!」
		PRINTFORMW 「안 되는 건 안 되니까!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「에~…… 뭐, 오늘은…… 간신히 괜찮지만~」
		PRINTFORMW 「하지만 정말 안 되는 때는 그만둬?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「...뭐, 됐어! %CALLNAME:MASTER%라면」
			PRINTFORMW 「이제 와서 부탁할게 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「아아...... 그렇게 말해주니, 뭔가......」
			PRINTFORMW 「뭐, 한 번 정도는...? 아마 괜찮을 거라고 생각해.」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
