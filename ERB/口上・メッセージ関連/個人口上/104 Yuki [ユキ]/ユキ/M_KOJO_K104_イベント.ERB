@M_KOJO_EVENT_K104_21(ARG,ARG:1)
;口上主はARG
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 
		PRINTFORMW 「마이! 나, 좋아하는 사람이 생겼어!」
		PRINTFORML 
		SETCOLOR 0xFFDDEE
		PRINTFORMW 『……보고 있으면, 알 수 있어』
		IF TALENT:105:恋人
			PRINTFORMW 『주지 않을 거야』
			PRINTFORMW 『...나의 것이니까』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORML 「우, 이럴 수가... 알고 있어」
			PRINTFORMW 「하지만, 일단 보고해야 할 것 같아서」
			PRINTFORMW 「포기하고 싶지 않으니까... 함께 있을 수 있다는 것만으로도 충분한데」
			PRINTFORML 
			SETCOLOR 0xFFDDEE
			PRINTFORMW 『그렇구나...』
			PRINTFORMW 『뭐... 마음대로 해봐』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORMW 「고마워, 마이」
			PRINTFORMW 「이제 뒤끝 될 일은 없어!」
			PRINTFORML 
		ELSEIF TALENT:105:恋慕 || TALENT:105:愛欲
			PRINTFORMW 『……그래서, 어떻게 할 거야』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORML 「물론, 나의 것도 좋아해 주길 바래!」
			PRINTFORMW 「함께 하고 싶은 게 잔뜩 있거든」
			PRINTFORML 「마이도 꽤 친한 것 같지만……」
			PRINTFORMW 「혹시, 같은 기분이야?」
			PRINTFORML 
			SETCOLOR 0xFFDDEE
			PRINTFORML 『......자』
			PRINTFORMW 『몰라... 기분 같은 건』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORML 「? 무슨 소리야?」
			PRINTFORML 「뭐, 어쨌든... %CALLNAME:MASTER%에게는 돌아보게 해야 해.」
			PRINTFORMW 「좋아...」
			PRINTFORML
		ELSE
			PRINTFORMW 『……그래서, 어떻게 할 거야』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORML 「물론, 저도 좋아해 주길 바래!」
			PRINTFORMW 「함께 하고 싶은 게 잔뜩 있거든」
			PRINTFORML 
			PRINTFORML 「이런 기분이 들 수 있는 사람이 있을 줄은, 지금까지 생각해 본 적 없었어.」
			PRINTFORML 「우리, 마법만 생각했는데……」
			PRINTFORMW 「기왕 이렇게 된 거, 마이도 여러 사람과 접해보면 자극이 될지도?」
			PRINTFORML 
			SETCOLOR 0xFFDDEE
			PRINTFORMW 『…………』
			PRINTFORMW 『……그렇구나』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORMW 「응! 분명 그럴 거야!」
			PRINTFORMW 「좋아, 하기로 마음먹었으면! 절대로 돌아보게 만들어야 해!」
			PRINTFORML
		ENDIF
		PRINTFORMW 「본격적으로 해버릴 테니까!!」
		PRINTFORML
		SETCOLOR 0xFFDDEE
		PRINTFORMW 『……』
		PRINTFORMW 『...하아, 바보』
		PRINTFORML  
		RESETCOLOR
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 
		PRINTFORMW 「그래서 말이야~, 그때 %조사처리(CALLNAME:MASTER,"가")%......」
		PRINTFORMW 「...마이? 무슨 일 있어?」
		PRINTFORML 
		SETCOLOR 0xFFDDEE
		PRINTFORMW 『...딱히』
		PRINTFORML 『꽤, 깊이 들어간 것 같네』
		PRINTFORMW 『%CALLNAME:MASTER%얘기가 요즘 많아서...』
		PRINTFORML 
		SETCOLOR 0xAA8888
		PRINTFORMW 「에! 그, 그런 걸까...?」
		PRINTFORMW 「...하지 말아줘~ 그런 말을 들으면 의식해버리잖아」
		PRINTFORMW 「태도에 드러낼지도 몰라... 어떡하지」
		PRINTFORML 
		IF TALENT:105:恋慕
			SETCOLOR 0xFFDDEE
			PRINTFORMW 『……유키"도"인가……귀찮네』
			PRINTFORML 
			SETCOLOR 0xAA8888
			PRINTFORMW 「응, 뭔가 말했어?」
			PRINTFORML 
			SETCOLOR 0xFFDDEE
			PRINTFORMW 『……아무것도 아니야……』
			RESETCOLOR
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛欲取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 
		PRINTFORML 「으음, 자극적이야...」
		PRINTFORMW 「아아... %CALLNAME:MASTER%하고 하고 싶어라」
		PRINTFORML 
		SETCOLOR 0xFFDDEE
		PRINTFORML 『유키... 조금 진정하면』
		PRINTFORMW 『최근에는 그것밖에 없어...』
		PRINTFORML 
		SETCOLOR 0xAA8888
		PRINTFORMW 「아하, 마이... 진지해.」
		PRINTFORMW 「마이도 정말 기분 좋은 걸 알게 되면 그런 소리 못 하게 될 거야.」
		PRINTFORMW 「가엾다... 아니면 내가 가르쳐 줄까?」
		PRINTFORMW 「언제든 괜찮아... 마음이 내키면 불러줘%UNICODE(0x2665) *1%」
		PRINTFORMW 「아하하하...」
		PRINTFORML 
		PRINTFORML 
