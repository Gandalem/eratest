@M_KOJO_EVENT_K104_20(ARG,ARG:1)
;口上主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:うふふ
			;うふふ中に眠くて帰る
			IF TCVAR:泥酔 == 1
				PRINTFORML 
			ELSEIF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「음... 큰일이야, 졸리네.」
				PRINTFORML 「저기, 미안한데... 오늘은 일단 여기까지 해도 될까?」
				PRINTFORML 「다음 기회에, 못다 한 만큼 마음껏 하자ね.」 
				PRINTFORMW 「그럼... 하아...」
			ELSE
				PRINTFORML 「하아......으음, 벌써 졸릴지도」
				PRINTFORMW 「오늘은 이쯤에서 그만두는 게 어때?」
				PRINTFORMW 「그럼 안녕, 또 보자...」
			ENDIF
		ELSE
			IF CFLAG:318 == 1
				PRINTFORML 「흥... 돌아가자」
				PRINTFORMW 「그럼 잘 가」
			ELSEIF TCVAR:泥酔 == 1
				PRINTFORML 
			ELSEIF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「음~ 벌써 이런 시간인가아...」
				PRINTFORML 「%CALLNAME:MASTER%, 나 돌아가지만... 그」
				PRINTFORMW 「...아무것도 아니야! 또 보자%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「어이쿠, 이제 돌아가야겠네」
				PRINTFORMW 「하아~ 오늘도 수고했어...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート中帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:うふふ
			;うふふ中に眠くて帰る
			IF TCVAR:泥酔 == 1
				PRINTFORML 
			ELSEIF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「음... 큰일이야, 졸리네.」
				PRINTFORML 「저기, 미안한데... 오늘은 일단 여기까지 해도 될까?」
				PRINTFORML 「다음 기회에, 못다 한 만큼 마음껏 하자ね.」 
				PRINTFORMW 「그럼... 하아...」
			ELSE
				PRINTFORML 「하아......으음, 벌써 졸릴지도」
				PRINTFORMW 「오늘은 이쯤에서 그만두는 게 어때?」
				PRINTFORMW 「그럼 안녕, 또 보자...」
			ENDIF
		ELSE
			IF CFLAG:318 == 1
				PRINTFORML 
			ELSEIF TCVAR:泥酔 == 1
				PRINTFORML 
			ELSEIF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「아, 시간이 빨리 지나네... 왜일까」
				PRINTFORML 「%CALLNAME:MASTER%, 나... 이제 돌아가야 해」
				PRINTFORMW 「또 같이 어디론이라 갈까 응 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「어라, 이제 돌아가야겠네」
				PRINTFORMW 「그럼 수고했어~」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;玄関先でお見送り（キャラの自宅位置、またはキャラの部屋でデート終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート終了時に部屋に来ないかと誘う（～から部屋に来ないかと誘われた）
	;（来訪キャラのみ,自宅が無いキャラでも発生します）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「이걸로 끝내기엔 서운하잖아! 응, %CALLNAME:MASTER%」
			PRINTFORML 「괜찮다면, 내 방에서 연장전 하는 건 어때?」
			PRINTFORMW 「서비스 해 줄게~ %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「오늘은 벌써, 끝인가아……」
			PRINTFORMW 「맞아! 이제부터, 내 방에 오지 않을래?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;部屋に来ないか→「行く」を選択（～に誘われるまま、【MASTER】は【TARGET】の部屋へと向かった……）
	;（これが発生すると十中八九押し倒されます）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「훗후훗, 그렇게 해야지! 역시 %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
			PRINTFORMW 「한동안 돌아가지 못하게 해줄 테니까... 각오해둬 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「아, 올 거야?」
			PRINTFORMW 「좋아 좋아, 재미있어지기 시작했네......%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;部屋に来ないか→「やめとく」を選択（～は心なしか寂しそうだ……）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「에~, 그럴 리가... 무슨 일이라도 있는 거야?」
			PRINTFORMW 「있잖아, 나중에라도 괜찮으니까... 와줄 수 없어? 안 될까?」
		ELSE
			PRINTFORML 「뭐야, 아쉽네」
			PRINTFORMW 「뭐 괜찮아... 그럼 또 봐」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今夜は帰りたくないと言い出す（～は今夜は帰りたくないと言い出した…）
	;（来訪キャラの帰宅時に欲求不満と欲望が高いと発生）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「있잖아, 오늘은 계속 같이 있고 싶어~」
			PRINTFORMW 「좋지?」
		ELSE
			PRINTFORML 「오늘은, 집에서 느긋하게 쉬고 싶은 기분이 아니야~」
			PRINTFORMW 「그렇네... %CALLNAME:MASTER%, 지금 시간 있어?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今夜は帰りたくない→「泊める」を選択（～は【MASTERの自室】に泊まっていくことになりました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		IF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「아하...... 해냈어%UNICODE(0x2665) *1%」
			PRINTFORML 「그럼 말이야, 오늘 밤은 마음껏…… 응%UNICODE(0x2665) *1%」
			PRINTFORMW 「즐거워지기 시작했네~ %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「엣, 머물러 줄 거야?」
			PRINTFORMW 「뭐야, %CALLNAME:MASTER%도 그럴 생각이었어... 아하하, 좋네 %UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今夜は帰りたくない→「泊めない」を選択、または家主が居る（【MASTER】は丁重に断った）
	;（家主が居る＝MASTERの私室に他のキャラの私室を設定している）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「에~, 안 되는 거야~? 그런가아」
			PRINTFORML 「뭐, 어쩔 수 없겠지... 그럼 다음에 봐」
			PRINTFORMW 「음으... 잘 안 풀리네」
		ELSE
			PRINTFORML 「아, 안 돼?」
			PRINTFORMW 「그럼 돌아가야겠네... 아~하, 재미없네」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;疲れて帰宅（疲れきった～は帰って行きました）
	;（～は疲れ切っている→（入り口）まで送るよ でも発生）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		IF CFLAG:うふふ
			;うふふ中に疲れて帰る
			IF TCVAR:泥酔 == 1
				PRINTFORML 
			ELSEIF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「히이익, 괴로워... 이제 죽을 것 같아...」
				PRINTFORML 「아하하... 그것도 나쁘지 않을지도 모르지만.」
				PRINTFORMW 「오늘은 돌아갈게... 다음엔 %조사처리(CALLNAME:MASTER,"가")% 만족할 때까지 노력할 테니까.」
			ELSE
				PRINTFORML 「저, 잠깐만요... 이제, 무리예요~」
				PRINTFORMW 「오늘은 이쯤으로 할게요... 히잉, 예정에 없던 소모라니.」
			ENDIF
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
