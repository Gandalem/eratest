@EVENTDAY_GREETING_K104
;バレンタイン
IF DAY:2 == 4 && DAY:3 == 14
	SELECTCASE CFLAG:好感度
		CASE 1000 TO 5000
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「%CALLNAME:MASTER%! 네, 초콜릿%UNICODE(0x2665) *1%」
				PRINTFORMW 「밸런타인데이잖아! 아무래도 %조사처리(CALLNAME:MASTER,"에게")% 주지 않을 수 없지」
			ELSEIF TALENT:思慕
				PRINTFORML 「%CALLNAME:MASTER%! 발렌타인이니까 초콜릿 줄게~」
				PRINTFORML 「그 근처에서 팔던 걸로 죄송하지만, 마음이 담겨있지 않은 건 아니니까 말이야」
				PRINTFORMW 「정말이야?」
			ELSE
				PRINTFORML 「오늘은 발렌타인데이네! %CALLNAME:MASTER%, 컨디션은 어때?」
				PRINTFORMW 「일단, %CALLNAME:MASTER%에게도 줄게! 친구의 정이야」
			ENDIF
		CASE IS > 5000
			IF EXP:愛情経験 < 100
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「오늘은 발렌타인데이! 물론, %CALLNAME:MASTER%에게는 최고의 게 있으니까 말이야%UNICODE(0x2665) *1%」
					PRINTFORMW 「정말 엄청 고민했단 말이야... 줄 수 있어서 다행이다」
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%! 자~, 발렌타인 초콜릿이야!」
					PRINTFORMW 「어때, 비싸해 보이지? 정말 비쌌단 말이야... 깜짝 놀랐어」
				ENDIF
			ELSE
				PRINTFORML 「밸런타인데이네! 나로부터 온 초콜릿은…… 자, 이것 봐, 수제야! 자신작이라고!」
				PRINTFORMW 「본격한 건 본격한 거니까, 각오하고 받아줘!」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
