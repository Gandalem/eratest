;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K104_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF FIRSTTIME("告白")
			PRINTFORML 「%CALLNAME:MASTER%……%CALLNAME:MASTER%윽!」
			PRINTFORMW 「저기... 이제 참을 수가 없어서 할게.」
			PRINTFORML 
			PRINTFORMW 「나, %조사처리(CALLNAME:MASTER,"를")% 좋아해」
			PRINTFORMW 「더욱 더 사이좋아져서, 계속 함께 있을 수 있다면……」
			PRINTFORMW 「뭐랄까, 그게~…… 연인 같은」
			PRINTFORMW 「내 주변에도 다른 귀여운 애들이 많으니까…… 쉽지 않을지도 모르지만」
			PRINTFORMW 「그래도……」
			PRINTFORML
			PRINTFORMW 「있지, %CALLNAME:MASTER%」
			PRINTFORMW 「나만 봐줘...?」
		ELSE
			PRINTFORML 「있잖아, 나를 차고 후회하고 있지 않아?」
			PRINTFORMW 「지금이라면 아직 괜찮은데……」
			PRINTFORMW 「어때?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;恋人の数え方があってるかはわからん
	IF LOCAL:1 && ARG == 1
		VARSET LOCAL
		FOR LOCAL, 1, CHARANUM
		SIF TALENT:LOCAL:恋人
			LOCAL:1 ++
		NEXT
		SELECTCASE LOCAL:1
			CASE 1
				PRINTFORML 「해냈어 %UNICODE(0x2665) *1% 고마워, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
				PRINTFORML 「나중에 다른 사람이 좋다고 해도, 이제 안 되니까!」
				PRINTFORMW 「괜찮아, 지루하게 안 할 테니까 %UNICODE(0x2665) *1%」
			CASE 2 TO 4
				PRINTFORMW 「해냈다%UNICODE(0x2665) *1% 고마워, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
				PRINTFORMW 「나중에 다른 사람이 좋다고 해도, 이제 안 돼... 에? 이미 연인이 다른 사람 있어?」
				PRINTFORMW 「음~ 나는 혼자뿐인 쪽이 특별한 것 같아서 동경하지만... 뭐, 괜찮아!」
				PRINTFORMW 「사귀어 나갈 거라면, 어느 정도의 문화적 차이는 받아들여야지.」
				PRINTFORMW 「어쨌든 잘 부탁해 %UNICODE(0x2665) *1%」
			CASE 5 TO 10
				PRINTFORMW 「해냈다 %UNICODE(0x2665) *1% 고마워, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
				PRINTFORMW 「나중에 다른 사람이 좋다고 해도 이제 안 돼…… 뭐라고? 나로 {LOCAL:1} 사람目?」
				PRINTFORMW 「그, 그런 거야! 음, 조금 상상과는 달랐지만…… 일단 알겠어」
				PRINTFORMW 「뭐, 뭐…… %조사처리(CALLNAME:MASTER,"를")% 사랑하는 사람들끼리 아마 사이좋게 지낼 수 있겠지」
				PRINTFORMW 「어쨌든 연인은 연인이니까! 앞으로도 잘 부탁해 %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「해냈어%UNICODE(0x2665) *1% 고마워, %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
				PRINTFORMW 「나중에 다른 사람이 좋다고 해도 이제 안 돼…… 뭐라고? 이미 연인이... {LOCAL:1}사람이라고!?」
				PRINTFORMW 「정말이야!? 사소한 지인도 연인으로 계산하는 경우도 있잖아!?」
				PRINTFORMW 「에~ ... 고백 성공해서 골인했다고 생각했는데... 오히려 출발선에 선 기분이네」
				PRINTFORMW 「우, 묻히지 않도록 해야 해... 우으, 긴장이 풀리지 않아~!」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「우음, 안 돼? 왜 그래~」
		PRINTFORMW 「있잖아, 어떤 걸 좋아해?」
		PRINTFORMW 「이 정도로는 포기 안 할 테니까!」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K104_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORML 
		ELSEIF TCVAR:泥酔 == 1
			PRINTFORML 
		ELSEIF TALENT:恋慕 || TALENT:愛欲
			PRINTFORMW 「오늘은 즐거웠어! 다음도 기대하고 있을 테니까 말이야」
			PRINTFORMW 「...그래서, 이 다음은 어떻게 할까...? ...%UNICODE(0x2665) *1%」
		ELSEIF TALENT:思慕
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 있는 거, 꽤 좋아해」
			PRINTFORMW 「또, 어디론가 데려가 줘 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「역시, 마계 이외의 곳도 꽤 신선하고 재미있어!」
			PRINTFORMW 「다른 데도 좋은 곳 알면 나한테 알려줘.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「음~? 저, 다른 일로도 화 안 냈어요」
		PRINTFORMW 「제대로 반성했다면, 용서해 줄지도 모르지」
		PRINTFORML 
		PRINTFORMW 「…반성하고 있지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「알았어, 알았다고... 조금만 용서해 줄게」
		PRINTFORMW 「조금뿐이니까 알고 있겠지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「화해할 수 있을 거라고 생각했어.」
		PRINTFORML 「뭐, 나도 남이랑 사이가 안 좋으면 피곤하니까.」
		PRINTFORMW 「성의를 봐서, 분노의 3할 정도는 누그러뜨려 주도록 하지.」
		PRINTFORMW 「하지만 아직 화나고 있으니까! 7할 정도는.」
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
