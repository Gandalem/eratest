;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K104_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K104_310
CALL M_KOJO_MESSAGE_COM_K104_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K104_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML
	ELSEIF CFLAG:睡眠
		PRINTFORML 
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「뭐야, 유혹하는 거야~?」
			PRINTFORMW 「후후후, 좋아... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「에엥~ 뭐 하는 거야」
			PRINTFORMW 「아아... 좀 기분 좋다...」
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「뭐야, 엉덩이가 신경 쓰여?」
			PRINTFORMW 「응... 더 세게 해도 괜찮아 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「앗, 그... 날 저렇게 발버둥 치지 마요」
			PRINTFORMW 「에헤헤, 조용히 있으라고 %UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「뭐야, 뭐 하는 거야」
			PRINTFORMW 「음란한 손길을 사용하고 있잖아」
		ELSEIF TALENT:思慕 || TALENT:セフレ
			PRINTFORMW 「그만해줘~, 뭔가 변태 같아?」
		ELSE
			PRINTFORML 「우히야! 잠깐!」
			PRINTFORMW 「뭘 생각하는 거야!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K104_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K104_311
CALL M_KOJO_MESSAGE_COM_K104_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K104_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 
		;ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
		PRINTFORML 
	ELSEIF TCVAR:泥酔 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「흐헤헤…… 진정해~」
			PRINTFORMW 「%CALLNAME:MASTER%…… 계속……」
		ELSE
			PRINTFORML 「우와아~……덥네.」
			PRINTFORMW 「음으…… 잠들어버릴 것 같아……」
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			CASE 73, 77, 85, 86, 87, 88, 89 ;快感あり
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「음, 안 될 거야 %UNICODE(0x2665) *1% 강요해 버릴까…… 아 %UNICODE(0x2665) *1%」
					PRINTFORMW 「그만, 이제…… %UNICODE(0x2665) *1%」
				ELSE
					PRINTFORML 「이봐, 너무 세게 하잖아~」
					PRINTFORMW 「응, 응... 이거, 좋을지도 %UNICODE(0x2665) *1%」
				ENDIF
			CASEELSE
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORML 「흐으윽……그런 식으로 당하면, 저는……」
					PRINTFORMW 「%CALLNAME:MASTER%윽……아아……%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORML 「뭐야~, 달라붙어」
					PRINTFORMW 「아하, 연인 같아?」
				ENDIF
		ENDSELECT
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「왜 그래~? 외로워졌어?」
			PRINTFORMW 「귀여운 %UNICODE(0x2665) *1%」
		ELSEIF TALENT:思慕 || TALENT:セフレ
			PRINTFORML 「응, %CALLNAME:MASTER%……」
			PRINTFORML 「아~……잠깐만, 이대로 있지 않을래?」
			PRINTFORMW 「아니, 스킨십이라기보다는…… 그게」
		ELSE
			PRINTFORML 「와아, 정열적이네!」
			PRINTFORML 「인사하는 느낌일지도 모르지만, 여자애한테는 자제하면 어때?」
			PRINTFORMW 「상처받을지도 몰라~」
		ENDIF
	ENDIF
ENDIF
RETURN 1
