;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K104_100
CALL M_KOJO_MESSAGE_COM_K104_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K104_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特殊状況
	IF FLAG:70 ;時姦
		PRINTFORMW 
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMW 
		RETURN 1
	ELSEIF TCVAR:泥酔 == 1
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		IF ABL:マゾっ気 < 2
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「아야! 잠, %CALLNAME:MASTER%!?」
				PRINTFORMW 「음~, %조사처리(CALLNAME:MASTER,"의")% 취향이라면 좋지만... 너무 세게 하지 말아줘?」
			ELSE
				PRINTFORML 「아파아!」
				PRINTFORMW 「그런 취미는 없는데! 그만해줘~」
			ENDIF
		ELSE
			IF TALENT:恋慕 || TALENT:愛欲
				PRINTFORML 「아하앗 %UNICODE(0x2665) *1% 아파...... %UNICODE(0x2665) *1%」
				PRINTFORMW 「......더, 세게 해도 좋으니까 %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORML 「んん %UNICODE(0x2665) *1% 야, 뭘 치는 거야!」
				PRINTFORMW 「뭐... 조금 기분은 좋으니까 딱히 상관없지만~」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
