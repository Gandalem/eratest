@M_KOJO_MESSAGE_PALAMCNG_A_K104_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦
	IF FLAG:70
		PRINTFORML 
	ELSEIF TCVAR:泥酔 == 1
		PRINTFORML 
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		PRINTFORML 「응응, 많이 나왔네 %UNICODE(0x2665) *1% 기분 좋았어?」
		SIF (ABL:膣射中毒 > 2 || ABL:肛射中毒 > 2) && (CFLAG:生解禁 == 2 || (CFLAG:生解禁 == 1 && CFLAG:生理周期 != 7))
			PRINTFORML 「하지만, 고무 같은 건... 하지 않아도 됐을 텐데」
	ELSE
		PRINTFORML 「오~, 쌓여 있네」
		PRINTFORML 「편하네~ 이거」
	ENDIF
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
