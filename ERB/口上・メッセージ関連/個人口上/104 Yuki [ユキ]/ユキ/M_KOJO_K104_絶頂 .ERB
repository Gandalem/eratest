; Modular ERB: 個人口上/104 Yuki [ユキ]/ユキ/M_KOJO_K104_絶頂 .ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K104
;時姦
SIF FLAG:70
	RETURN 1
;睡姦
SIF CFLAG:MASTER:イタズラ == 2
	RETURN 1
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		IF TCVAR:泥酔 == 1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「으윽, 가, 가아앙!」
					PRINTFORML 「흐읍, 아... 휴우, 하앗...」
				CASEELSE
					PRINTFORML 「んお゛ぉ%UNICODE(0x2665) *1% おお゛읏……が읏……んえ゛ぇ……」
					PRINTFORML 「…………」
			ENDSELECT
		ELSE
			PRINTFORML 「!! 응! 아...윽!!」
			PRINTFORML 「...헉, 흐으......」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		IF TCVAR:泥酔 == 1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「으윽, 가, 가아앙!」
					PRINTFORML 「흐읍, 아... 휴우, 하앗...」
				CASEELSE
					PRINTFORML 「응 어어 %UNICODE(0x2665) *1% 윽... 으읍... 으엥...」
					PRINTFORML 「…………」
			ENDSELECT
		ELSE
			SELECTCASE NOWEX:四重絶頂
				;Ｃ＆Ｖ＆Ａ＆Ｂ絶頂
				CASE 1
					PRINTDATAL
						DATAFORM 「싫어 싫어, 죽을 것 같아 %UNICODE(0x2665) *1% 아, 히아앗!! ~~~ %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
						DATAFORM 「아 %UNICODE(0x2665) *1% 갈 것 같아—아, 뭐야? 전부 가버릴 것 같아... 안 돼, 아 %UNICODE(0x2665) *1% 아아아앗 %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
					ENDDATA
					RETURN 1
					;Ｍ含み
				CASEELSE
					PRINTFORML 「응응응!! 응아, 응! ……윽, 아……%UNICODE(0x2665) *1%」
					PRINTFORML 「헉, 하아……위험해……%UNICODE(0x2665) *1%」
					RETURN 1
			ENDSELECT
		ENDIF
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		IF TCVAR:泥酔 == 1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「으윽, 가, 가아앙!」
					PRINTFORML 「흐읍, 아... 휴우, 하앗...」
				CASEELSE
					PRINTFORML 「흐으윽%UNICODE(0x2665) *1% 갈 거야 갈게, 아아악%UNICODE(0x2665) *1%」
					PRINTFORML 「아아아%UNICODE(0x2665) *1% 히익%UNICODE(0x2665) *1% 앗, 흐읍……」
			ENDSELECT
		ELSE
			SELECTCASE NOWEX:三重絶頂
				CASE 1, 2, 3, 4 ;Ｍ空き
					PRINTDATAL
						DATAFORM 「앗 앗, 갈 것 같아, 가고 있어 %UNICODE(0x2665) *1% 전부 가버려 %UNICODE(0x2665) *1%」
						DATAFORM 「얏, 몸 전체에 온다! 아, 아 %UNICODE(0x2665) *1% 히익 %UNICODE(0x2665) *1%」
						DATAFORM 「윽, 아…… %UNICODE(0x2665) *1% 아하하…… 어디서 가고 있는지 모르겠어…… %UNICODE(0x2665) *1%」
					ENDDATA
					RETURN 1
				CASEELSE
					PRINTDATAL
						DATAFORM 「음흡! 음으윽! 음아, 하윽... 숨이 가빠... %UNICODE(0x2665) *1%」
						DATAFORM 「! 푸읏... 미안해, 잠깐...! 갈 것 같으니까... 기다려줘... %UNICODE(0x2665) *1%」
					ENDDATA
					RETURN 1
			ENDSELECT
		ENDIF
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書きたかったので、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いた
		IF TCVAR:泥酔 == 1
			PRINTDATAL
				DATAFORM 「아응, 가, 우으윽%UNICODE(0x2665) *1% 하아......%UNICODE(0x2665) *1%」
				DATAFORM 「아아우, 아에으%UNICODE(0x2665) *1% 응이이%UNICODE(0x2665) *1% 응에헤, 갈 거야 갈 거야...윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「히으윽 %UNICODE(0x2665) *1% 몰아서 하고 있어 %UNICODE(0x2665) *1% 이거, 위험할지도 몰라 %UNICODE(0x2665) *1%」
				DATAFORM 「잠깐, 어느 쪽이 아니면 %UNICODE(0x2665) *1% 아아앙 %UNICODE(0x2665) *1% 이상해져 버릴 테니까…… %UNICODE(0x2665) *1%」
				DATAFORM 「파아앗! 잔뜩 가고 있어 %UNICODE(0x2665) *1% 으윽…… 머리가 어지러워 %UNICODE(0x2665) *1%」
			ENDDATA
		ENDIF
		RETURN 1
	ENDIF
	;単絶頂
	IF NOWEX:Ｃ絶頂
		IF TCVAR:泥酔 == 1
			PRINTDATAL
				DATAFORM 「아응, 가, 우으윽%UNICODE(0x2665) *1% 하아......%UNICODE(0x2665) *1%」
				DATAFORM 「아아우, 아에으%UNICODE(0x2665) *1% 응이이%UNICODE(0x2665) *1% 응에헤, 갈 거야 갈 거야...윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「っあ%UNICODE(0x2665) *1%　は～……そこ、弱いんだよね～」
				DATAFORM 「くッ……읏%UNICODE(0x2665) *1% んん、行ちゃた%UNICODE(0x2665) *1%」
			ENDDATA
		ENDIF
		RETURN 1
	ENDIF
	IF NOWEX:Ｖ絶頂
		IF TCVAR:泥酔 == 1
			PRINTDATAL
				DATAFORM 「아응, 가, 우으윽%UNICODE(0x2665) *1% 하아......%UNICODE(0x2665) *1%」
				DATAFORM 「아아우, 아에으%UNICODE(0x2665) *1% 응이이%UNICODE(0x2665) *1% 응에헤, 갈 거야 갈 거야...윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「하아, 하앗... 질 안쪽, 가겠어... 아%UNICODE(0x2665) *1%」
				DATAFORM 「네, 슬슬 갈 것 같아... 음응%UNICODE(0x2665) *1%」
			ENDDATA
		ENDIF
		RETURN 1
	ENDIF
	IF NOWEX:Ａ絶頂
		IF TCVAR:泥酔 == 1
			PRINTDATAL
				DATAFORM 「아응, 가, 우으윽%UNICODE(0x2665) *1% 하아......%UNICODE(0x2665) *1%」
				DATAFORM 「아아우, 아에으%UNICODE(0x2665) *1% 응이이%UNICODE(0x2665) *1% 응에헤, 갈 거야 갈 거야...윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「응응, 엉덩이, 이제...앗, 커%UNICODE(0x2665) *1%」
				DATAFORM 「잠깐, 너무 격하게 하면... 벌써 갈 것 같아%UNICODE(0x2665) *1%」
			ENDDATA
		ENDIF
		RETURN 1
	ENDIF
	IF NOWEX:Ｂ絶頂
		IF TCVAR:泥酔 == 1
			PRINTDATAL
				DATAFORM 「아응, 가, 우으윽%UNICODE(0x2665) *1% 하아......%UNICODE(0x2665) *1%」
				DATAFORM 「아아우, 아에으%UNICODE(0x2665) *1% 응이이%UNICODE(0x2665) *1% 응에헤, 갈 거야 갈 거야...윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「흐윽 %UNICODE(0x2665) *1% ……우으, 가슴으로 해버렸어아」
				DATAFORM 「앗, 나, 가슴…… 정말 %UNICODE(0x2665) *1% 응, 기분 좋아…… %UNICODE(0x2665) *1%」
			ENDDATA
		ENDIF
		RETURN 1
	ENDIF
	IF NOWEX:Ｍ絶頂
		IF TCVAR:泥酔 == 1
			PRINTDATAL
				DATAFORM 「아응, 가, 우으윽%UNICODE(0x2665) *1% 하아......%UNICODE(0x2665) *1%」
				DATAFORM 「아아우, 아에으%UNICODE(0x2665) *1% 응이이%UNICODE(0x2665) *1% 응에헤, 갈 거야 갈 거야...윽%UNICODE(0x2665) *1%」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM 「응! 음... %UNICODE(0x2665) *1% 하아... 안 돼, 입으로... %UNICODE(0x2665) *1%」
				DATAFORM 「윽... %UNICODE(0x2665) *1% 응... 입으로만, 왜 이렇게 오는 걸까 %UNICODE(0x2665) *1%」
			ENDDATA
		ENDIF
		RETURN 1
	ENDIF
ENDIF
