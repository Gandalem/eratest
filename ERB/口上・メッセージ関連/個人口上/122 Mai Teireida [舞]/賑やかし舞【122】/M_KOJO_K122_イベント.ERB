@M_KOJO_EVENT_K122_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:狂気
			PRINTFORML 「……아, %CALLNAME:MASTER%―. 상태는 어때?」
			PRINTFORMW 허공을 응시하고 있던 마이의 눈에 빛이 돌아왔다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「어라, %CALLNAME:MASTER%이잖아」
			PRINTFORML 「혹시 나한테 용건이라도 있나? 후후후~♪」
			PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 보고 기분이 좋아 보인다.
		ELSE
			PRINTFORML 「아, %조사처리(CALLNAME:MASTER,"다")%」
			PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"를")% 발견하자, 인사 삼아 손에 들고 있던 대나무를 가볍게 흔들었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%ー」
			PRINTFORML 뒤에서 누군가에게 갑자기 말을 걸어왔다.
			PRINTFORMW 「푸훗! 놀랐어? 나야, 마이야~♪」
		ELSE
			PRINTFORML 「네 네, 실례할게-」
			PRINTFORMW 등 뒤의 문에서 갑자기 마이가 나타났다…….
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:狂気
			PRINTFORML 「아, %CALLNAME:MASTER%…」
			PRINTFORML 마이의 가녀린 몸에는 여기저기 울혈된 부분이 보였다. 크기로 보아… 키스 마크일까?
			PRINTFORML 「뭐야? 그렇게 내 몸을 보고 싶은 거야?」
			PRINTFORMW 「어쩔 수 없네…… 조금만 괜찮아? 후후훗!」
		ELSEIF TALENT:恋慕
			PRINTFORML 「헉! %조사처리(CALLNAME:MASTER,"가")% 들어있었나...」
			PRINTFORML 마이는 자신의 나체를 가리듯이 목욕물에 들어왔다.
			PRINTFORMW 「...나도 여자란 말이야. 너무 빤히 쳐다보지 말아줘?」
		ELSE
			PRINTFORML 「누가 들어있는 건가 싶더니... 뭐야, %CALLNAME:MASTER%인가아」
			PRINTFORML 마이는 안도하는 표정을 지으며 별로 부끄러워하는 기색 없이 물에 들어왔다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:狂気
			PRINTFORML 「우와, %CALLNAME:MASTER%…」
