@M_KOJO_SUCCESS_COM_K122_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K122_302
CALL M_KOJO_MESSAGE_COM_K122_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K122_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:狂気
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「후후후... 더 야한 거라도 할까?%UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"에게")% 도발적인 시선을 던졌다.
			CASE 1
				PRINTFORML 「후우...... ...귀엽다♪」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 귓가에 숨을 불어넣고, 쿠스쿠스 웃었다.
			CASE 2
				PRINTFORML 「……있잖아, 이런 거 해줘도 괜찮다고?」
				PRINTFORMW 마이는 옷 위로 %조사처리(CALLNAME:MASTER,"의")% 가랑이를 더듬고 있다…….
			CASE 3
				PRINTFORML 「%CALLNAME:MASTER%, 이런 곳 같은 데는 만져보고 싶지 않아?」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"를")% 유혹하듯, 자신의 허벅지에 손을 가져갔다.
			CASE 4
				PRINTFORML 「벌써 지루해 죽겠어-! 더 만져줘도 괜찮다고?」
				PRINTFORML 「여기나, 이런 곳도... %UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 자신의 몸 곳곳을 만지게 했다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「에헤헤, 왠지 부끄러워지네 %UNICODE(0x2764)%」
				PRINTFORMW 마이는 볼을 붉히며, %조사처리(CALLNAME:MASTER,"의")% 손을 받아들이고 있다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%, 그렇게 많이 만지면 부끄럽잖아...」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"에게")% 어루만져지고, 부끄러워서 안절부절못한다.
			CASE 2
				PRINTFORML 「와앗!? 거, 거기 안 된다고 했잖아요!」
				PRINTFORMW 아슬아슬한 곳까지 손을 뻗히자 마이는 놀라서 몸을 움츠렸다.
			CASE 3
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 손, 따뜻해서 뭔가 안심이 된다아~♪」
				PRINTFORMW 마이는 망설임 없이 %조사처리(CALLNAME:MASTER,"의")% 손을 꽉 잡고 있다.
			CASE 4
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 마이의 머리를 손으로 빗겨주었다.
				PRINTFORML 「평소에는 사토노가 해 주던 건데 말이야.」
				PRINTFORMW 「......%조사처리(CALLNAME:MASTER,"는")%, 머릿결이 예쁜 사람을 좋아해?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「가끔 주인님도 이런 걸 하시는구나~」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"에게")% 볼을 주물러지고 있다...
			CASE 1
				PRINTFORML 「히얏!? 벌써! 그거 성희롱이라고!」
				PRINTFORMW 귀에 살짝 숨결을 불어넣어진 마이는 볼을 부풀리고 있다.
