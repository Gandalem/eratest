;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K122_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K122_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K122_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K122_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF TALENT:恋人
		SELECTCASE RAND:7
			CASE 0
				PRINTFORML 「갑자기 말인데……%CALLNAME:MASTER%, 좋아해~ %UNICODE(0x2764)%」
				PRINTFORML 「꽉~ %UNICODE(0x2764)% 에헤헤, 가끔 이렇게 하고 싶어지더라고 %UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"에게")% 안기며 환한 미소를 지었다.
			CASE 1
				PRINTFORML 「나, 이렇게 누군가를 좋아하게 된 건 처음이야.」
				IF TALENT:狂気
					PRINTFORML 「몸을 더럽히게 되면서 부여받은 광기 같은 건 필요 없어. 좀 더 순수한 마음과 몸으로, 사랑에 미쳐보고 싶었어……」
					PRINTFORMW 「그렇게 생각해도, 지금 와서 말이야.」
				ELSE
					PRINTFORML 「에헤헤... 앞으로도 계속 좋아할 테니까, %CALLNAME:MASTER%%UNICODE(0x2764)%」
					PRINTFORMW 마이는 애정으로 가득 찬 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
				ENDIF
			CASE 2
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 연주와 나의 춤으로, 여러 가지 표현을 시도해 보고 싶어~」
				PRINTFORMW 「소중한 사람과 하나의 것을 완성시킨다니……후후훗, 뭔가 멋지네~!」
			CASE 3
				IF TALENT:狂気
					PRINTFORML 「있잖아, 그런데 %조사처리(CALLNAME:MASTER,"는")% 쌓이지 않았어?」
					PRINTFORMW 「말해주면 언제든지 상대해 줄 테니까! 연인으로서 나의 의무 같은 거니까 %UNICODE(0x2764)%」
				ELSE
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 꽤 야하네ー」
					PRINTFORML 「뭐, 딱히…… 연인 상대니까, 그런 얘기 해줘도 괜찮지만 말이야」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 건 음담에, 마이는 뺨을 물들이고 입술을 삐죽 내밀고 있다.
				ENDIF
			CASE 4
				PRINTFORML 「사토노는 나와 %조사처리(CALLNAME:MASTER,"의")% 진전이 유독 궁금해하는 거야.」
				PRINTFORMW 「걱정해 주는 건지, 단순한 호기심인 건지 모르겠지만... 조금 부끄럽네...」
			CASE 5
				PRINTFORML 「스승님께 들었는데, %조사처리(CALLNAME:MASTER,"는")% 팬티 컬렉터야?」
				PRINTFORMW 「......내 거라면 말해주면 줄 수 있지만.」
			CASE 6
				PRINTFORML 「%CALLNAME:MASTER%、今晩は暇？」
				IF TALENT:狂気
					PRINTFORML 「에헤헤, 너의 얼굴을 보고 있으니 하고 싶어져 버렸어」
					PRINTFORML 「꼭 밤이 아니어도 괜찮은데. 어때?」
					PRINTFORMW 마이는 히죽거리며 욕망으로 가득 찬 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
				ELSE
					PRINTFORML 「아, 무리할 것 같으면 괜찮지만……」
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 더 함께 있고 싶다고 생각했을 뿐이니까……」
					PRINTFORMW 마이는 부끄러워하며 뺨을 붉히면서, %조사처리(CALLNAME:MASTER,"에게")% 애정이 담긴 시선을 보내고 있다.
				ENDIF
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:7
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%. 만약 육체적인 피로가 쌓인다면, 부디 나에게 말해 주렴?」
				PRINTFORML 「내가 네 뒤에서 춤을 추면, 분명 밤에도 잠들 수 없을 거야!」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"를")% 놀리듯 웃고 있다.
			CASE 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 유독 인기가 많네. 좀 웃길지도?」
				PRINTFORMW 「...아니, 역시 웃기지 않아」
			CASE 2
				PRINTFORML 「나랑 사토노, 누가 %조사처리(CALLNAME:MASTER,"를")% 좋아해?」
				PRINTFORMW 「후후후... 물론, 나를 선택해 줄 거지?」
			CASE 3
				PRINTFORML 「내가 %조사처리(CALLNAME:MASTER,"랑")% 노는 거, 사부님께는 비밀이야?」
				PRINTFORMW 마이는 살짝 %조사처리(CALLNAME:MASTER,"의")% 귓가에서 속삭였다.
			CASE 4
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 좋아하는 사람이라도 있어?」
				PRINTFORMW 「아무한테도 말 안 할 테니까 가르쳐 줘! 정말 아무한테도 말 안 할게!」
			CASE 5
				PRINTFORML 「다음에 사토노랑 함께 마을 구경을 할 거야~♪」
				PRINTFORMW 「%CALLNAME:MASTER%도 따라와도 괜찮지만... 어때?」
			CASE 6
				PRINTFORML 「있잖아, 다음에 뭐라도 사줘! 대신 내 춤 보여줄게~」
				IF TALENT:狂気
					PRINTFORMW 「춤만으로는 부족하다니... 그럼 말이야, %CALLNAME:MASTER%취향에 맞는 야한 서비스도 해줄게? 후후훗!」
				ELSE
					PRINTFORMW 「아, 뭐든 같이 춤출래? 좀 하기 힘든 경험이잖아~?」
				ENDIF
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「저기 저, %조사처리(CALLNAME:MASTER,"는")% 로리콘이야?」
				PRINTFORML 「왜냐면 자꾸 나한테 말을 걸잖아. 로리콘이라는 건 그런 사람을 말하는 거지?」
				PRINTFORMW 「...어, 아니야? 후-」
			CASE 1
				IF TALENT:狂気
					PRINTFORML 「소로소니, 소로소…………」
					PRINTFORML 마이는 어딘가 공허한 미소로 노래하고 있다…….
					PRINTFORMW 「……아, %CALLNAME:MASTER%? 무슨 일이야, 그런 표정을 하고서」
				ELSE
					PRINTFORML 「솔로 솔소니, 솔로 소오♪」
					PRINTFORML 마이는 천진난만한 미소를 지으며 노래하고 있다.
					PRINTFORMW 「무슨 의미냐고? 후후후... 비밀이야~♪」
				ENDIF
			CASE 2
				PRINTFORML 「사토노랑은 여러 면에서 잘 맞는 것 같아」
				PRINTFORMW 「일이 즐거운 것도 솔직히 사토노가 있어서 그런 거거든~」
			CASE 3
				PRINTFORML 「%CALLNAME:MASTER%, 다음에 춤을 가르쳐 줄 수도 있는데... 어때?」
				PRINTFORMW 마이는 기쁜 듯 대나무를 흔들고 있다.
			CASE 4
				PRINTFORML 「스승님은 귀찮게 구는 성격이시지. %CALLNAME:MASTER%도 그렇게 생각하지 않아?」
				PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 동의하려 하자, 갑자기 등 뒤에서 정체 모를 기척이 느껴져 소름이 돋았다.
				PRINTFORMW 「……? 갑자기 왜 그래, 얼굴 하얗잖아?」
			CASE 5
				PRINTFORML 「사토노는 참 배려심이 깊어. 그 아이 덕분에 항상 도움을 받고 있어!」
				PRINTFORMW 「예를 들면... 내가 손수건 안 잊게 매일 주머니에 넣어주거나 그런 거 말이야!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「이런 곳에서 뭘 하고 있냐고?」
				PRINTFORML 「……뭐, 잠깐의 잡일을 하고 있었지.」
				PRINTFORMW 마이는 휘파람을 불며 고개를 돌렸다.
			CASE 1
				PRINTFORML 「아, 내일도 연습이라니... 귀찮네-」
				PRINTFORMW 마이는 우울해하며 한숨을 쉬었다.
			CASE 2
				PRINTFORML 「에이, 스승님 얘기하는 거야~? 싫어~!」
				IF TALENT:狂気
					PRINTFORMW 마이는 노골적으로 싫다는 표정을 지었다…….
				ELSE
					PRINTFORMW 마이는 어쩐지 즐거운 듯 입가에 손을 대고 쿠스쿠스 웃고 있다.
				ENDIF
			CASE 3
				PRINTFORML 「후후후. 나에게 거스르는 녀석은 이 대나무로 꿰뚫어 주마-」
				PRINTFORMW 마이는 손에 들고 있던 대나무를 흔들었다…….
			CASE 4
				PRINTFORML 「죽순이 요키... 요키키...」
				PRINTFORMW 「...헉! 어라, 나 뭐 하고 있었더라?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
