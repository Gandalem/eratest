;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K122_80
CALL M_KOJO_MESSAGE_COM_K122_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K122_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:狂気
			PRINTFORML 「후훗, 그런 일은 나에게 맡겨줘!」
			PRINTFORMW 마이는 정열적인 눈빛으로 %조사처리(CALLNAME:MASTER,"에게")% 봉사를 시작했다…….
		ELSE
			PRINTFORML 「음, 어느 정도의 강도로 잡아야 할까...?」
			PRINTFORMW 마이는 당황하며 조심스럽게 손을 위아래로 움직이고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF TALENT:狂気
			PRINTFORML 「바로 그거야, 힘내 힘내♪ 언제든지 내도 괜찮으니까~♪」
			PRINTFORMW 마이는 적극적인 봉사를 계속하고 있다…….
		ELSE
			PRINTFORML 「에헤헤, 잘하고 있어?」
			PRINTFORMW 마이는 조금 부끄러운 듯하면서도 방긋 웃으며 손을 움직이고 있다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
