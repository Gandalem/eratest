			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「에헤헤... 따뜻하고, 안심이 된다아...」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 안기며 마이는 완전히 응석을 부리고 있다.
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%, 더... 꼭 안아줘...?」
					PRINTFORMW 마이는 애교 섞인 목소리를 내며 %조사처리(CALLNAME:MASTER,"에게")% 부탁하고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「후후후, 따뜻해~♪」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 안긴 채 마이는 천진난만하게 웃고 있다.
				CASE 1
					PRINTFORML 「사토노랑도 자주 이렇게 해.」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 포옹을 나누며, 마이는 조금 부끄러운 듯 웃고 있다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
