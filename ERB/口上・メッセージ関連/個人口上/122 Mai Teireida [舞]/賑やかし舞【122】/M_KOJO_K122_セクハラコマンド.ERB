;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K122_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K122_310
CALL M_KOJO_MESSAGE_COM_K122_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K122_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF TALENT:狂気
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「우와, 갑자기 만지지 마. 기분 나빠-」
					PRINTFORMW 마이는 불쾌하다는 듯 %조사처리(CALLNAME:MASTER,"의")% 손을 쳐냈다.
					;恥ずかしがる
				CASE 2,3
					PRINTFORML 「모오! 음흉한 손길로 만리지 마%UNICODE(0x2764)%」
					PRINTFORMW 마이는 드물게 수줍은 미소를 짓고 있다.
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「푸푸푸~ 당신도 그 주변의 변태 아저씨랑 수준이 같네ー」
							PRINTFORMW 마이는 히죽거리며, 나무라듯이 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
						CASE 1
							PRINTFORML 「아하하! %CALLNAME:MASTER%라니, 치한 같잖아!」
							PRINTFORMW 마이는 키득거리며 건조한 웃음소리를 내고 있다.
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「히얏!? 이, 갑자기 그만둬요!」
					PRINTFORML 「벌써…… 그런 건 치한이라고 하는 거야?」
					PRINTFORMW 마이는 볼을 부풀리며 %CALLNAME:MASTER%에 항의하고 있다.
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「으윽... 부, 부끄러우니까 그만해줘...」
						CASEELSE
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 변태……」
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「에헤헤... 내 엉덩이, 어때?」
						CASEELSE
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 엉덩이가 좋아하는 거야?」
							PRINTFORMW 「좋아한다면…… 더 만져도 괜찮아?」
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「히이익!! 변, 변태...!」
					PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다.
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「싫어, 그만해줘……」
							PRINTFORMW 마이는 불편한 듯 몸을 움찔거린다.
						CASEELSE
							PRINTFORMW 「우으... 이런 걸 하는 게, 즐거워...?」
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「너무 많이 만지지 말아줘……」
							PRINTFORMW 마이는 끈적하게 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
						CASEELSE
							PRINTFORMW 「뭐랄까... %조사처리(CALLNAME:MASTER,"는")% 변태네...」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
