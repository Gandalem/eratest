	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:狂気
		PRINTFORML 「아하핫 %UNICODE(0x2764)% 좋아, 더 깔아봐! %UNICODE(0x2764)%」
		PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 머리를 누르고 자신의 은밀한 곳에 밀어붙였다.
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORML 「하아, 하아... 우우, 미안, 엉망이 되어 버렸네...」
		PRINTFORMW 마이는 은밀한 곳에서 끊임없이 애액을 흘리며 부끄러운 듯 뺨을 물들였다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「응, 혀가 까끌까끌해서… 기분 좋아……윽」
		PRINTFORMW 마이는 %CALLNAME:MASTER%에서 주는 쾌락으로, 색기 있게 허리를 비틀고 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
