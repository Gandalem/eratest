@M_KOJO_MESSAGE_COM_K122_0
CALL M_KOJO_MESSAGE_COM_K122_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K122_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:狂気
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「그래, 그런 느낌으로... 후훗, %CALLNAME:MASTER%도 능숙하네~ %UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 애무에 황홀한 미소를 짓고 있다.
			CASE 1
				PRINTFORML 「네가 하고 싶은 대로 해도 돼? 자, %UNICODE(0x2764)%」
				PRINTFORMW 마이는 몸을 살짝 움직여서, %조사처리(CALLNAME:MASTER,"가")% 만지기 편하게 해 주었다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 만져지면, 엄청 두근거려……%UNICODE(0x2764)%」
				PRINTFORMW 마이는 숨을 거칠게 쉬며, %CALLNAME:MASTER%로부터 주어지는 쾌락을 누리고 있다.
			CASE 1
				PRINTFORML 「う읏、んん읏%UNICODE(0x2764)% %CALLNAME:MASTER%、気持ちいい…%UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 애무에 황홀한 미소를 띠고 있다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「음... 후후, 나쁘지 않은걸... %UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"의")% 애무에 만족스러운 미소를 지었다.
			CASE 1
				PRINTFORML 「더, 해도 괜찮아? %UNICODE(0x2764)%」
				PRINTFORMW 마이는 %조사처리(CALLNAME:MASTER,"를")% 유도하듯 몸을 밀착시켰다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
