	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「...Make sure you learn the difference between being a good person and acting like a jerk at least. Like, for real.」
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
