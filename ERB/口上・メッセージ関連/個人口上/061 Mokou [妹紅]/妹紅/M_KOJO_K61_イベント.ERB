@M_KOJO_SPEVENT_K61_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF 陥落状態() >= 4
			PRINTFORML 「%SPLIT_G("I never thought:It never occurred to me:I couldn't imagine")% that it would be so fun to spend time with my lover.」
			PRINTFORML 「Fufu, I love you so much, %MASTERNAME:61%. ...Hey there, what's with that blush? Why would you feel shy now of all times?」
