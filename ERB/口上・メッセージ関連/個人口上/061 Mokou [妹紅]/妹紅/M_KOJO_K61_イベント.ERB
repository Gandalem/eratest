			PRINTFORML 「Wanna push me down? Or want me to take charge? %SPLIT_G("Either way is fine to me:I don't mind either way")%.」
		ELSEIF 陥落状態() == 1
			PRINTFORML 「Oh, I was just about to visit your place myself.」
		ELSE
			PRINTFORML 「Uh, yeah, %SPLIT_G("greetings:hello there")%.」
		ENDIF
		PRINTFORMW 
		RETURN 1
