;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K61_50
CALL M_KOJO_MESSAGE_COM_K61_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K61_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	; IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	; PRINTFORMW
	; RETURN 1
	; ENDIF
	IF TEQUIP:PLAYER:コンドーム && EXP:出産経験 && !FLAG:70
		IF 陥落状態() >= 4
			PRINTFORML 「...%MASTERNAME:61%, 도대체 무슨 생각을 하는 거야, 물어봐도 돼?」
			PRINTFORML 「내 미소가 무섭다고 생각하는 거야? ...하지만 물론, 왜 그렇지 않을 리가 없지.」
			PRINTFORML 「우리는 %SPLIT_G("baby making sex:sex for the purpose of procreation:sex and try for a baby")%를 하려고 해, 콘돔 같은 건 여기 어울리지 않아!」
			PRINTFORML 「자! 소각 처리 완료! 자, 이제 최선을 다해 나에게 정액을 넣어 아이를 갖게 해줘, 알겠지?」
		ELSEIF 陥落状態() == 3
			PRINTFORML 「...왜 그 고무 조각을 사용하고 싶어? 나를 임신시키고 싶지 않아?」
			PRINTFORML 「네가 무슨 말을 하든, 나는 정말 너와 아이를 갖고 싶으니 이걸 가져갈 거야.」
		ELSEIF 陥落状態() == 2
			PRINTFORML 「오늘은 아기를 만들 테니 그런 건 안 할 거야.」
		ENDIF
		TEQUIP:PLAYER:コンドーム = 0
		PRINTFORML 
		CALL COLORMESSAGE("모코가 장착된 콘돔을 제거한다!",C_YELLOW,2,1)
		;基本セット
		;時姦中
	ELSEIF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF 陥落状態() == 3
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
