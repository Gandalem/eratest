; Modular ERB: 個人口上/061 Mokou [妹紅]/妹紅/M_KOJO_K61_依頼.ERB
;custom code
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K61(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K61(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K61(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
	CASE "依頼非受託時"
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
	CASE "依頼受託時"
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
	CASE "依頼確認時"
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
	CASE "依頼破棄時"
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
	CASE "依頼実行直前"
		;●[367]で依頼を実行する時、実行処理の前に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【◆口上】
		;【実行時の地の文・ソース等】
		;【▼下の口上に続く】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		ENDIF
	CASE "依頼実行直後"
		;●[367]で依頼を実行する時、実行処理の後に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【▲上の口上から続き】
		;【◆口上】
		;【達成時・CLIENT：▼下の口上に続く】
		;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ENDIF
	CASE "成功報告時"
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
	CASE "失敗報告時"
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
ENDSELECT
RETURN 1
;==================================================
;Kaguya's Unique Request 1: Trial of Guts
;==================================================

@M_KOJO_IRAI_TRIAL_OF_GUTS_K61(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;mokou goes full-on chuuni mode here, essentially
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「오, 당신이군요, %CALLNAME:MASTER%.」
			PRINTFORMW 「깊은 밤에 이 숲까지 무슨 일로 오셨나요?」
		ELSE
			PRINTFORMW 「이런 밤에 나설 정도의 바보들도 있는 거냐?」
			PRINTFORMDL 누구지?
			PRINTFORML 「당신 말이지, 당연히?」
			PRINTFORMDW 아니, 내가 누가 바보인지는 묻는 게 아니다.	
			PRINTFORML 「나는 이곳에서 오래 살아온 인간이다.」
			PRINTFORML 「나는 바보라서 여기에 온 것이 아니다.」
			PRINTFORMW 「그럼, 너는 왜 여기 있는 거냐, 이 바보야?」
		ENDIF
		PRINTFORMDL 용기를 시험하는 것.
		PRINTFORML 「뭐라고! 용기 시험이라고?!」
		PRINTFORML 「오, 인간들이 언제부터 이렇게 어리석어졌던 거지?」
		PRINTFORML 「밤중에 이 미친 보름달 아래, 수많은 요괴가 풀린 곳까지 와서, 고작 용기를 시험하려고 온 거라고?!」
		PRINTFORML 「아직 요괴들에게 죽지 않은 게 기적이야.」
		PRINTFORMW 「용기 시험이라니, 진심으로! 만약 네가 죽으면 네 내장이 요괴들의 잔치가 되겠어---」
		PRINTFORMDW 뭐, 나는 카구야가 '이리 나가봐'라고 해서 온 것뿐이니까...
		PRINTFORML 「방금 뭐라고 했지? "카구야"라고 말했나?」
		PRINTFORMW 「분명 "카―구―야"라고 발음했어.」
		PRINTFORML 「크윽! 네 용기 시험이 수상하다고 생각했거든.」
		PRINTFORMW 「당연히 그녀가 뒤에 있을 테지.」
		IF TALENT:恋人
			PRINTFORML 「내 연인조차 나를 암살하게 만들 계략을 꾸다니...」
		ELSEIF TALENT:[[輝夜]]:恋人
			PRINTFORML 「그녀 자신의 연인을 나를 죽이러 보내다니...」
		ELSEIF TALENT:[[輝夜]]:妄信 && TALENT:MASTER:追加種族 == 4
			PRINTFORML 「그녀의 "사랑하는 남편"을 보내 나를 죽인다고...?」
		ELSE
			PRINTFORML 「그래, 이번에도 그녀가 나를 없애도록 너를 부추겼지, 그렇지 않아?」
		ENDIF
		PRINTFORML 「그녀는 항상, 정말로 나를 없애려고 해!」
		PRINTFORML 「아악, 게다가 처음에 이 불편한 몸을 준 건 그녀였잖아?!」
		PRINTFORMDL 모코우가 이 일 때문에 정말 흥분하고 있다.
		IF TALENT:恋人
			PRINTFORMW 「흥. 좋아. 당신이라 할지라도, %MASTERNAME:61%, 나는 자비를 베풀지 않을 것이다.」
		ELSEIF TALENT:[[輝夜]]:恋人 || (TALENT:[[輝夜]]:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「흥. 그렇다면 내가 직접 카구야의 "사랑하는 남편"이 얼마나 강한지 확인해 봐야겠군?」
		ELSE
			PRINTFORML 「흥. 카구야의 전령이라는 네놈이 얼마나 강한지 내가 직접 확인해 봐야겠군.」
			PRINTFORMW 「그녀가 너를 보냈다면, 나보다 더 강해야 할 거 아냐?」
		ENDIF
		PRINTFORML 「내가 평범한 인간이라고 생각하지 마라. 난 죽지 않아. 난 완전히 죽을 수 없어. 그 형편없는 카구야 덕분이다.」
		PRINTFORML 「그래, 그녀가 아무리 나를 제거하려고 애써도 전혀 소용이 없을 거야.」
		PRINTFORML 「그녀는 그걸 알고 있으면서 네게 전령을 보내고 있군. 이보다 더 짜증 나는 일은 없을 거다.」
		PRINTFORML 「전력을 다하지 않으면, 너의 생명은 끝이다.」
		PRINTFORML 「이제 되돌릴 수 없어. 한밤중에 가는 길은 일방통행이니까.」
		PRINTFORMW 「네가 원하던 바로 그거지. 네 배짱을 시험하게 해 주마.」
		RETURN 1
	CASE "依頼実行直後"
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			PRINTFORML
			PRINTFORML 「힘내! 어차피 내가 이기는 건 당연하니까.」
			RETURN 1
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			PRINTFORML
			PRINTFORML 「아, 정말이지. 더는 못 참겠어.」
			PRINTFORMDW 모코우는 땅에 쓰러져 간신히 몸을 움직인다.
			IF TALENT:MASTER:追加種族 == 4
				PRINTFORMDL 비록 그녀는 불멸자이지만, 그녀의 신체에도 한계가 있다.
				PRINTFORMDL 너는 그것을 꽤 잘 알고 있다.
				PRINTFORMDL 음, 오늘 밤은 충분히 즐겼다. 동료 불멸자를 일으켜 세워주는 거다.
				PRINTFORMW 「아, 고마워. 나 너무 무리했어.」
				PRINTFORML 「너 정말 절제심이 없구나, %CALLNAME:MASTER%.」
				PRINTFORML 「이제 카구야에게 돌아가야겠군. 대나무 숲의 끔찍한 불멸자 인간을 어떻게 물리쳤는지 전부 말해줘.」
				PRINTFORML 「그냥 여기서 잠이나 자려고 해. 내일은 꽤 쑤길 것 같지만 말이야. 너 정말 나한테 큰일을 벌였어.」
				PRINTFORMDW 목오는 당신에게 가볍게 고개를 끄덕이고 걸어갔다.
				CALL CHANGE_CFLAG(2, [[妹紅]], 50)
				CALL CHANGE_CFLAG(4, [[妹紅]], 30)
			ELSE
				PRINTFORMDL 불멸자의 내장을 먹으면 자신도 불멸이 된다고들 한다.
				PRINTFORMDL 이런 기회는 당분간 없을지도 모른다.
				PRINTFORMDL 어쩌면 이것이 카구야가 말한 "내장 시험"의 진정한 의미일 것이다.
				CALL ASK_YN("그녀의 내장을 먹어라", "그대로 두어라")
				IF !RESULT
					PRINTFORML 「네 눈에 그런 표정이 보이지만, 불멸이 되는 건 추천하지 않아.」
					PRINTFORML 「그것은 보이지 않을지 몰라도, 네가 나에게 준 이 멍들은 정말 고통스러워.」
					PRINTFORML 「아프더라도 죽지는 않을 테니까.」
					CALL ASK_YN("어쨌든 해버린다", "그대로 두어라")
					IF !RESULT
						PRINTFORMDL 정말로 확신하는 건가요? 이걸 한번 하게 되면, 절대 되돌릴 수 없습니다. 영원히.
						PRINTFORMDL %BREAKENG("You'll be cut off from the cycle of reincarnation, forced to exist even after all life on Earth dies and the planet is swallowed by the sun, your soul churning forever in torment.")%
						CALL ASK_YN("너의 인간성을 버려라", "피할 수 없는 죽음의 평화를 받아들여라")
						IF !RESULT
							IF TALENT:恋慕
								PRINTFORML 「네가 정말 고집을 부리는구나. 좋아, 내가 도와주지.」
								PRINTFORMDW 모코우는 자신의 손을 가슴 깊숙이 넣고 자신의 간을 꺼냈다.
								PRINTFORML 「으윽. 아프다.」
								PRINTFORML 「이게 네게 필요한 거 맞겠지? 어서 받아, 나는 괜찮으니까.」
								PRINTFORMDL 모코우는 망설이며 자신의 살점인 간을 너에게 내밀었다.
								CALL ASK_YN("그것을 먹어라", "물러서라")
								IF !RESULT
									PRINTFORMDL 당신은 목우의 간을 꺼내 먹는다.
									NOSKIP
									REPEAT 8
									REUSELASTLINE %"." * COUNT%
									TWAIT 150, 1
									REND
									ENDNOSKIP
									PRINTFORMDL 효과가 있었나? 아무것도 일어나지 않는 것 같아.
									PRINTFORML 「아니, 넌 아직 필멸자야. 난 느껴져.」
									PRINTFORML 「그럴 만도 하겠지, 결국 영약은 다 사라졌으니까.」
									PRINTFORML 「뭐, 이래서 더 나아. 인간은 언젠가 죽어야 하는 법이니까.」
									PRINTFORML 「하지만 집으로 데려다줄 수 있나. 아직 많이 아프거든.」
									PRINTFORMDL 당신은 모코우를 안고 집으로 돌아와 그녀를 침대에 눕힌 후 떠난다.
									IF CFLAG:[[輝夜]]:口上セレクタ == 0 ;prevent possible issues with potential alternate kaguya dialogues that use these variables differently, so only trigger these for the main dialogue
										CFLAG:[[輝夜]]:1092 = 1 ;consumed flesh this time
										CFLAG:[[輝夜]]:1093 = 1 ;cannibal (permanent)
									ENDIF
								ELSE
									PRINTFORML 「지금 그만둘지 결정할 때인가? 내 간을 꺼낸 후에 말인가?」
									PRINTFORML 「아무래도 말이지.」
									PRINTFORML 「솔직히 말하면, 너와 영원히 함께하는 상상은 정말 매력적으로 들리지만, 지금이 더 낫다는 걸 알고 있어.」
									PRINTFORML 「어차피 인간은 그렇게 오래 살도록 되어 있지 않으니까.」
									PRINTFORMDW 모코가 회복할 때까지 그녀에게 작별을 고하기 전에 머무르기로 결정한다.
								ENDIF
							ELSE
								PRINTFORML 「아, 좋아. 움직이기가 너무 아파서, 나를 삶든, 구우든, 뭐든지 해줘!」
								PRINTFORML 「제발 내 셔츠에 피 묻히지 말아 주세요.」
								PRINTFORMDL 당신은 목옥의 셔츠를 벗긴 후 칼을 꺼내 목옥의 가슴 안으로 밀어 넣는다.
								PRINTFORMDL 당신이 돼지처럼 그녀의 내장을 발라낼 때 목옥은 얼굴을 찡그리지만 아무 말도 하지 않는다.
								PRINTFORMDL 당신은 그녀의 장기를 뽑아 미친 광란 속에서 먹어치우며 불멸자의 살점을 배불리 먹는다.
								PRINTFORML 「와, %CALLNAME:MASTER%, 정말 지저분하게 먹는구나.」
								PRINTFORML 「그렇게 채울 필요 없어, 난 어디 가지 않을 거야.」
								PRINTFORMDW 결국, 당신의 끔찍한 만찬은 끝이 난다.
								NOSKIP
								REPEAT 8
								REUSELASTLINE %"." * COUNT%
								TWAIT 150, 1
								REND
								ENDNOSKIP
								PRINTFORMDL 효과가 있었나? 아무 일도 일어나지 않는 것 같군.
								PRINTFORML 「아니, 너는 아직 필멸자니까. 나는 느끼고 있어.」
								PRINTFORML 「하지만 이걸 겪은 후에 네가 스스로를 좋은 사람이라고 부를 수 있을지는 모르겠어.」
								PRINTFORMDL 네 끔찍한 행동은 완전히 시간 낭비였나? 너는 인간으로서의 존엄성을 아무것도 얻지 못하고 버린 건가?
								PRINTFORML 「에이, 별일 아니야. 결국 나 혼자니까 죽지도 않아. 그래도 꽤 역겨웠지만.」
								PRINTFORMDW 목코에게 사과하며 더듬거리고, 너는 모든 사건을 잊으려고 몸을 돌려 떠난다.
								IF CFLAG:[[輝夜]]:口上セレクタ == 0 ;prevent possible issues with potential alternate kaguya dialogues that use these variables differently, so only trigger these for the main dialogue
									CFLAG:[[輝夜]]:1092 = 1 ;consumed flesh this time
									CFLAG:[[輝夜]]:1093 = 1 ;cannibal (permanent)
								ENDIF
							ENDIF
						ELSE
							GOTO NOT_EATING
						ENDIF
					ELSE
						GOTO NOT_EATING
					ENDIF
				ELSE
					$NOT_EATING
					PRINTFORML 「그래, 정말 그러면 안 돼. 불멸은 보이는 것만큼 대단하지 않아.」
					PRINTFORML 「네가 적어도 이해할 만큼 분별력이 있다는 걸 보니 다행이군.」
					PRINTFORML 「음, 너 이 싸움에서 이겼어. 아마 카구야에게 돌아가서 승리를 알려주는 게 좋을 거야.」
					PRINTFORML 「나 걱정 마, 잠깐 쉬면 괜찮을 테니까.」
					PRINTFORML 「어차피 죽지 못하잖아.」
					PRINTFORMDW 목오쿠를 땅에 남겨두고, 그녀에게 손을 흔든 뒤 걸어 나갔다.
					CALL CHANGE_CFLAG(2, TARGET, 75)
					CALL CHANGE_CFLAG(4, TARGET, 50)
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		RETURN 1
	CASE "成功報告時"
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
