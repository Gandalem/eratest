@M_KOJO_SUCCESS_COM_K61_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 妹紅SUC_FAIL()
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K61_302
DRAWLINE
;copied from action translation
IF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置) ;former BATHROOM(CFLAG:現在位置)
	IF 陥落状態() >= 4 && !RAND:2
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"에게")% 등을 씻으라고 했다.
		SETBIT CFLAG:1610,1
	ELSE
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 등을 씻기로 결정한다.
	ENDIF
ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"와")% 어떤 스킨십을 한다%COND_STR(@" while walking", (CFLAG:TARGET:現在位置 % 100) % 10)%.
ELSEIF CFLAG:TARGET:350 == 49
	PRINTFORML 당신은 배짱을 보이며 %조사처리(CALLNAME:TARGET,"와")% 스킨십을 한다.
ELSE
	PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"와")% 어떤 스킨십을 나눈다.
ENDIF
IF TFLAG:193 == 1
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 그것을 즐기는 것 같다...
ELSEIF TFLAG:193 == -1 && !TALENT:恋慕 && !TALENT:恋人
	PRINTFORML 너무 친근하게 굴었지...
ENDIF
PRINTL
RETURN 1

