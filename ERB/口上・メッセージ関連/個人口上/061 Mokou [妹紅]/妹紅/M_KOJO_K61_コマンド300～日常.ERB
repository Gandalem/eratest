;==================================================
;特殊成否判定式中関数
;@妹紅SUC_FAIL()
;姫様に弾幕勝負で勝ってる場合、成否判定のあるコマンドでは必ず成功or大成功するように
;なお、回数制限あり
;==================================================

@妹紅SUC_FAIL()
#FUNCTION
IF TCVAR:62:弾幕勝負結果 == 1 && !CFLAG:1614
	SETBIT CFLAG:1614,0
	SETBIT CFLAG:1614,1
ENDIF
FOR LOCAL,2,7
IF GETBIT(CFLAG:1614,LOCAL-1) && !GETBIT(CFLAG:1614,LOCAL)
	SETBIT CFLAG:1614,LOCAL
	TFLAG:98 = 1
	RETURNF 1
ENDIF
NEXT
RETURNF 0
