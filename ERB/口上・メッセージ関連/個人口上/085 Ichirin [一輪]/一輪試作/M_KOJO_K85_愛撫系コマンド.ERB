@M_KOJO_MESSAGE_COM_K85_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋人
		PRINTFORML 
		PRINTFORMW 「앗! 그건 안 돼! 응... 음응!」
		PRINTFORMDW 이치린은 자신의 입을 막고, 은밀한 곳을 핥는 감촉에 떨었다.
	ELSEIF TALENT:恋慕
		PRINTFORML 
		PRINTFORMW 「아, 어때? 어떻게... 내 보지... 응윽!」
		PRINTFORMDW 애액이 넘치는 은밀한 곳을 핥히자 이치린은 자신의 신음 소리를 삼키려 한다.
	ELSE
		PRINTFORML 
		PRINTFORMW 「아, 응... 안! 혀를 넣었어...」
		PRINTFORMDW 이치린의 갈라진 틈에 혀를 넣어 그녀가 좋아하는 질 내부 천장을 자극했다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
