@M_KOJO_MESSAGE_COM_K85_0
CALL M_KOJO_MESSAGE_COM_K85_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K85_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF FLAG:70
				PRINTFORMDW 시간이 멈춘 이치린의 몸을 장난감으로 여기며, 그녀의 몸 깊숙이 가득 씨를 뿌렸다.
			ELSEIF TALENT:恋人
				PRINTFORML 
				PRINTFORMW 「아, 아앗! 부어줘!! 빨리 내 안에, 가득, 가득 부어줘어!」
				PRINTFORMDW 이치린은 애원하면서 자신의 배 깊숙이 박힌 단단함을 조였다.
				PRINTFORMDW 손가락으로 클리토리스나 유두를 만질 때마다 이치린은 몸을 격렬하게 비틀었다.
				PRINTFORMDW 한계를 넘은 %조사처리(CALLNAME:MASTER,"는")% 이치린의 몸을 강하게 끌어안고, 정을 바라는 자궁에 충분히 정액을 흘려보냈다.
				PRINTFORMW 「아앗! 나오고 있어…… 나오고 있어어!」
				PRINTFORMDW 이치린은 여자의 행복을 채워준 것에 만족하며 녹아내린 얼굴로 미소 지었다.
			ELSEIF TALENT:恋慕
				PRINTFORML 
				PRINTFORMDW 유두와 클리토리스를 손가락으로 만지면서, 몇 번이고 페니스를 자궁구까지 밀어 넣는다.
				PRINTFORMW 「~~~~옷%UNICODE(0x2665)%!!」
				PRINTFORMDW 이치린은 입을 막고 신음 소리를 참으려고 한다.
				PRINTFORMDW 하지만 %조사처리(CALLNAME:MASTER,"가")% 손가락 하나 움직일 때마다, 이치린은 「앗%UNICODE(0x2665)% 안윽%UNICODE(0x2665)%!」 하고 소리를 내버린다.
				PRINTFORMDW 재미있는 반응을 보이지만, 이제 마지막이다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 유두를 꼬집으면서 깊게 발기된 것을 이치린의 가장 깊은 곳까지 밀어 넣고 정액을 사정했다.
				PRINTFORMW 「아아! 좋아옷! 내줘, 내주라고옷!」
			ELSE
				PRINTFORML 
				PRINTFORMW 「기분 좋다! 기분 좋아어!」
				PRINTFORMDW 이치린은 격렬하게 애무당하면서도 스스로 허리를 움직이고 계속했다.
				PRINTFORMDW 한 번 애무를 멈추고, %조사처리(CALLNAME:MASTER,"는")% 이치린에게 안겼다.
				PRINTFORMDW 그리고 페니스를 자궁구에 고정한다.
				PRINTFORMW 「앗♪ 아아아아아아아아아아아!!」
				PRINTFORMDW 그대로 이치린의 깊은 곳에 다량의 정액을 사정하고, 이치린에게 행복을 주었다.
			ENDIF
			RETURN 1
		ELSE
			IF FLAG:70
				PRINTFORMDW 시간이 멈춘 이치린의 몸을 장난감 삼아 그녀의 몸속에 페니스를 박아 넣었다.
			ELSEIF TALENT:恋人
				PRINTFORML 
				PRINTFORMW 「아, 후응…… 들어가면서 애무당하는 건 안 돼……」
				PRINTFORMDW 이치린은 달콤한 목소리를 흘리며 몸 전체를 %조사처리(CALLNAME:MASTER,"에게")% 맡겼다.
				PRINTFORMDW 몸에 매달리는 듯한 애무에 이치린은 신음 소리를 계속 흘렸다.
				PRINTFORMDW 그리고 이치린의 몸이 경련할 때마다, %조사처리(CALLNAME:MASTER,"의")% 페니스는 조여졌다.
			ELSEIF TALENT:恋慕
				PRINTFORML 
				PRINTFORMW 「어때? 내 것……응힛!? 몸…… 기분 좋아?」
				PRINTFORMDW 이치린은 눈에 눈물을 머금고 %조사처리(CALLNAME:MASTER,"의")% 표정을 살폈다.
				PRINTFORMDW 몸에 육봉을 박히고, 몸도 제멋대로 만져지고 있는데, 이치린은 %CALLNAME:MASTER%밖에 보고 있지 않았다.
			ELSE
				PRINTFORML 
				PRINTFORMW 「아앗, 응... 아니야! 그거! 이거 좋아어」
				PRINTFORMDW 이치린은 애무와 종내의 조합에 격렬하게 몸을 비틀었다.
				PRINTFORMDW 머리카락을 헤치고 이치린의 얼굴을 바라보니, 참을 수 없다는 듯한 표정으로 되돌아보고 있었다.
			ENDIF
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 시간이 멈춘 이치린의 몸은 %CALLNAME:MASTER%에 의해 제멋대로 놀아지고 있었다.
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋人
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 
				PRINTFORMW 「응, 손길이, 음탕해…… 응」
				PRINTFORMDW 이치린의 몸을 만지는 손을, 이치린은 순순히 받아들이고 있었다.
				PRINTFORMDW 소녀의 하얀 피부는 만지고 있으면 꽤 중독성이 있는 것이 있었다.
			CASE 1
				PRINTFORML 
				PRINTFORMW 「응! 더, 더 만져줘!」
				PRINTFORMDW 이치린은 자신의 몸을 기쁘게 해주는 팔에 강하게 안겼다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 안겨온 팔을 멈추지 않았다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 만져진다면……정말 안심이 돼」
				PRINTFORMDW 이치린은 얼굴을 붉힌 채, 상냥한 미소를 보였다.
			CASE 1
				PRINTFORML 
				PRINTFORMW 「……윽! ……엣!!」
				PRINTFORMDW 이치린은 자신의 목소리를 누르려 하고 있었다.
				PRINTFORMDW 소녀는 눈물 어린 눈으로 이쪽의 표정을 응시한다.
		ENDSELECT
	ELSEIF TALENT:思慕
		PRINTFORML 
		PRINTFORMW 「어때, 나의 몸? 기분 좋아? 응!」
		PRINTFORMDW 자신보다 이치린은 %CALLNAME:MASTER%쪽을 신경 쓰고 있었다.
	ELSE
		PRINTFORML 
		PRINTFORMW 「따뜻하다, 손이네요……」
		PRINTFORMDW 이치린은 얼굴을 붉히며 %조사처리(CALLNAME:MASTER,"의")% 손을 잡고, 손등을 자신의 뺨에 비볐다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
