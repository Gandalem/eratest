;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K85_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K85_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K85_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K85_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;大成功
	IF TFLAG:193 == 1
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「……푸훕, 아하하하!」
				PRINTFORMDL 이치린이 눈물을 닦으며 배를 잡고 웃는 통에,
				PRINTFORMDW 그 모습에 %CALLNAME:MASTER%도 자신도 모르게 웃어버렸다.
			CASE 1
				PRINTFORML 「푸훗...! 잘 말하는구나, %CALLNAME:MASTER%」
				PRINTFORMDW 대화가 순조롭게 이어지자, 이치린은 정말 좋은 미소를 지었다.
		ENDSELECT
		;会話累積値が閾値を超えて失敗
	ELSEIF TCVAR:302
		PRINTFORML 「아아... 화제가 없어 버렸네...」
		;失敗
	ELSEIF TFLAG:193 == -1
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응, 뭐야 운잔」
				PRINTFORMDW 이치린은 운잔과의 대화에 빠져버렸다...
			CASE 1
				PRINTFORML 「후아...」
				PRINTFORMW 「아, 미안미안, 잘 안 들려서 그래」
		ENDSELECT
		;仕事中
	ELSEIF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		PRINTFORML 「후딱 일 끝내버리자」
		PRINTFORMDW 이치린은 청소하는 손을 쉬지 않고 %조사처리(CALLNAME:MASTER,"와")% 대화했다.
	ELSE
		;キャラに関するトーク
		IF RAND:2 == 0
			SELECTCASE RAND:4
				;星蓮船キャラ
				CASE 0
					SELECTCASE RAND:4
						;ひじりん
						CASE 0
							PRINTFORML 「히지리님은 저의 동경 대상이에요. 예쁘고, 멋있고, 다정하시니까.」
							;ひじりんが恋人or恋慕
							IF 陥落状態(55) > 2
								PRINTFORMW 「뭐, 히지리님과 잘 지내고 있는 %조사처리(CALLNAME:MASTER,"에게")% 이제 와서 할 말도 아닐 거야♪」
							ELSEIF 陥落状態(55) > 0
								PRINTFORMW 「%CALLNAME:MASTER%도 히지리님과 사이좋게 지내주는 것 같아서, 저희로서는 기뻐요」
							ELSE
								PRINTFORMW 「%CALLNAME:MASTER%도, 히지리님 도와드릴게요♪」
							ENDIF
							;ムラサ
						CASE 1
							PRINTFORML 「무라사와는 오랜 인연이네.」
							PRINTFORMW 「저 아이는 외로움을 많이 타서 말이야...」
							;ムラサが恋人or恋慕
							IF 陥落状態(86) > 2
								PRINTFORMW 「%CALLNAME:MASTER%도 무라사(武羅沙)를 제대로 봐줘」
							ELSEIF 陥落状態(86) > 0
								PRINTFORMW 「%CALLNAME:MASTER%도 무라사와 사이좋게 지내주는 것 같아서, 우리로서는 기뻐」
							ELSE
								PRINTFORMW 「%CALLNAME:MASTER%도, 무라사의 말 상대가 되어 주렴.」
							ENDIF
							;星ちゃん（原作での星ちゃんの呼び方はわからないけど、鵺さん呼びから御本尊様呼びとかもありかなと。気に入らなければ各自で修正を）
						CASE 2
							PRINTFORML 「본존님은, 알고 보면 술을 좋아하시거든」
							PRINTFORMW 「하지만, 술주정(술버릇)이 좀 심해서 말이야...」
							;星ちゃんが恋人or恋慕
							IF 陥落状態(87) > 2
								PRINTFORMW 「가능하다면 %CALLNAME:MASTER%에게도, 확 가줬으면 하는데…」
							ELSEIF 陥落状態(87) > 0
								PRINTFORMW 「%CALLNAME:MASTER%도, 본존님의 술 따르는 것에 동행해보는 건 어때?」
							ELSE
								PRINTFORMW 「아, 이건 %조사처리(CALLNAME:MASTER,"에게")% 비밀이었나…」
							ENDIF
							;ナズーリン（TWでは命蓮寺に永住してるけど、一応原作を意識した解釈で）
						CASE 3
							PRINTFORML 「나즈린은 원래 명련사의 주민이 아니야」
							PRINTFORMW 「거처가 망가져서, 지금은 임시로 피난 중인 거야」
							;ナズが恋人or恋慕
							IF 陥落状態(39) > 2
								PRINTFORMW 「뭐, 그래도 %조사처리(CALLNAME:MASTER,"가")% 있는 이상, 그 아이도 이제 와서 돌아올 생각은 없을걸~♪」
							ELSEIF 陥落状態(39) > 0
								PRINTFORMW 「아, 이건 %조사처리(CALLNAME:MASTER,"에게")% 비밀이었나…」
							ELSE
								PRINTFORMW 「거처가 제자리를 찾으면, 그 아이도 이곳을 떠날지도 모르겠구나」
							ENDIF
					ENDSELECT
					;神子
				CASE 1
					PRINTFORML 「맞아, 명련사의 바로 아래에 영묘 같은 게 있거든」
					;神子が恋人or恋慕
					IF 陥落状態(56) > 2
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 미코님과 잘 지내고 있는 거지? 다음에 가는 법 알려줘♪」
					ELSEIF 陥落状態(56) > 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 영묘의 들어가는 방법을 알고 있니?」
					ELSE
						PRINTFORMW 「저기에 사는 사람들은 우리와 상종할 수 없는 이들이니 조심하세요.」
					ENDIF
					;鵺さん
				CASE 2
					PRINTFORML 「노비 씨는 저희가 지상으로 돌아온 뒤에 명련사에 입문하신 분이에요」
					;神子が恋人or恋慕
					IF 陥落状態(41) > 2
						PRINTFORMW 「누에 씨는 %조사처리(CALLNAME:MASTER,"랑")% 평소에 어떤 대화를 나누세요?」
					ELSEIF 陥落状態(41) > 0
						PRINTFORMW 「츠누기와 친해지는 요령 같은 게 있나요?」
					ELSE
						PRINTFORMW 「그러니까, 카나메 씨에 대해서는 별로 잘 모른다는 거죠...」
					ENDIF
					;マミゾウ親分＆響子ちゃん
				CASE 3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「마미조 씨는 노비의 오랜 지인인 것 같네요」
							PRINTFORMW 「지금은 케이죠에서 머물고 있습니다」
						CASE 1
							PRINTFORML 「쿄코는 최근 명련사에 입문한 아이랍니다」
							PRINTFORMW 「부지런하니까 응원해 주세요」
					ENDSELECT
					;custom code, disabled as they look incomplete
					; ;小傘
					; CASE 4
					; 	SELECTCASE RAND:2
					; 		CASE 0
					; 			PRINTFORML 「多々良さんはああ見えて結構すごいんですよ。鍛冶にベビーシッターに…」
					; 		CASE 1
					; 	ENDSELECT
					; ;布都
					; CASE 5
					; 	SELECTCASE RAND:2
					; 		CASE 0
					; 			PRINTFORML 「霊廟にいる銀髪の子と里で飲んでるのを見た？」
					; 			PRINTFORMW 「さぁ…ナンノコトヤラ…」
					; 		CASE 1
					; 	ENDSELECT
			ENDSELECT
			;ふりーとーく
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「운잔과는 긴 인연이 되겠네」
					PRINTFORMW 「아아, 고된 날들이 어제 일처럼 떠오르네」
				CASE 1
					PRINTFORML 「%TEXTR("おお…さっすがぁ！/へえ、知らなかったよー！/すっごーい！/ほうほう、いいセンスだねぇ！/ふぅん、そうなんだー♪/")%」
					PRINTFORMDW 이치린은 경쾌한 추임새를 넣고 있다...
				CASE 2
					PRINTFORML 「운잔을 타고 싶다고?」
					PRINTFORMW 「아니... 사람 많은 거 싫어하는 타입이라 무리일 거야.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K85_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K85_301
CALL M_KOJO_MESSAGE_COM_K85_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K85_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「아, 차? 고마워」
				PRINTFORMDW 이치린은 찻잔을 들고 차를 홀짝였다.
				PRINTFORMW 「맛있다, 응, %조사처리(CALLNAME:MASTER,"의")% 차 정말 좋아」
				PRINTFORMDW 기뻐해줘서 다행이다...라고 말하자
				PRINTFORMW 「여러 아이들을 위해 차를 내려주는 거니까~」
				PRINTFORMDW 질투하고 있나? 라고 %조사처리(CALLNAME:MASTER,"가")% 묻자, 이치린은 고개를 가로젓는다.
				PRINTFORMW 「아니야, 별로」
				PRINTFORMDW 이치린은 그렇게 말하며 다시 차를 홀짝였다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「고마워」
				PRINTFORMDW 스윽, 하고 소리를 내며 차를 마시는 이치린
				PRINTFORMW 「음~ 딱 좋은 온도가……」
				PRINTFORMDW 겨우 이치린이 납득할 만한 온도로 만들어진 것 같다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「아, 내려준 거야? 고마워」
				PRINTFORMDW 이치린은 감사 인사를 한 뒤 찻잔을 집어 들고 그것을 가만히 응시했다.
				PRINTFORMW 「...이상한 것」
				PRINTFORMDW 들어있지 않다고 하자 이치린은 %조사처리(CALLNAME:MASTER,"가")% 우려낸 차를 마셨다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「아…… 차를 주는 거야? 고마워」
				PRINTFORMDW 이치린은 찻잔을 집어 소리를 내며 차를 홀짝였다.
				PRINTFORMW 「뜨거! 데었어, 아야」
				PRINTFORMDW 이치린은 혀를 데이고, 빨개진 혀를 내밀었다.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「아, 차를 내려줬구나?」
				PRINTFORMW 「고마워」
				PRINTFORMDW 이치린은 얼굴을 살짝 홍하게 만들며 감사를 표했다.
				PRINTFORMW 「응, 맛있다」
				PRINTFORMW 
			CASE 0
				PRINTFORML 
				PRINTFORMW 「응? 아, 차?」
				PRINTFORMW 「타주셨구나. 고마워」
				PRINTFORMDW 이치린은 찻잔을 들고 소리를 내며 차를 마신다.
				PRINTFORMW 「……뜨거워!」
				PRINTFORMDW 이치린은 혀를 데이고, 빨개진 혀를 내밀었다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「……차, 말씀이신가요?」
				PRINTFORMW 「마셔도 되는 건가요?」
				PRINTFORMDW 넣어뒀으니 마시라고 이치린이 재촉하자.
				PRINTFORMW 「그럼 사양 없이」
				PRINTFORMDW 이치린은 무표정한 채 차를 홀짝였다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「……차?」
				PRINTFORMW 「그럼, 잘 먹겠습니다」
				PRINTFORMDW 이치린은 조심스러운 듯 차에 입을 댔다.
				PRINTFORMDW 하지만 조금 너무 뜨거웠던 걸까, 「앗!」 하며 재빨리 찻잔에서 입을 뗐다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
