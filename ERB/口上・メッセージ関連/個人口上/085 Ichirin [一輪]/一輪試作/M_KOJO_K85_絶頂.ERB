@M_KOJO_MESSAGE_PALAMCNG_A_K85_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF !FLAG:時間停止
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「싫어 %UNICODE(0x2665)% 빼버리면 안 돼 %UNICODE(0x2665)%」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")%... 가장 깊숙이, 싸게 해줘 %UNICODE(0x2665)%」
				PRINTFORMDW 이치린은 %조사처리(CALLNAME:MASTER,"의")% 페니스에 허리를 밀착시키고 자궁으로의 사정을 재촉했다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 저항하지 않고 그녀의 태내에 남성의 욕망을 쏟아냈다.
				PRINTFORMW 「응, 아아~~~~~~ %UNICODE(0x2665)%%UNICODE(0x2665)%」
				PRINTFORMDW 등을 크게 뒤로 젖히며 도발적인 살들을 수축시켜 이치린은 %조사처리(CALLNAME:MASTER,"와")% 동시에 절정에 달했다.
				PRINTFORMDW 이치린의 질벽은 강렬하게 조이면서 %조사처리(CALLNAME:MASTER,"의")% 정액을 탐욕스럽게 짜내고 있었다.
			CASE 1
				PRINTFORMW 「%CALLNAME:MASTER%%UNICODE(0x2665)%……가겠어?」
				PRINTFORMW 「괜찮아…… 와줘 %UNICODE(0x2665)% 내 안에… 잔뜩, 싸줘 %UNICODE(0x2665)%」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 절정이 가깝다는 것을 느낀 이치린은 살결의 조임을 강하게 하여 자궁으로의 사정을 재촉했다.
				PRINTFORMDW 이치린에게 재촉당한 채, %조사처리(CALLNAME:MASTER,"는")% 그녀를 껴안고 가장 깊숙한 곳까지 남성의 욕망을 쏟아냈다.
				PRINTFORMW 「큭… %UNICODE(0x2665)% 응, 크으~~~~~~ %UNICODE(0x2665)%%UNICODE(0x2665)%」
				PRINTFORMDW 이를 악물고 이성을 잃을 듯한 절정에 견디는 이치린이 사랑스럽게, 껴안는 손에 힘을 주며 그녀와 강하게 밀착한다.
		ENDSELECT
	ENDIF
	IF 充填率(TARGET,1) >= 200
		PRINTFORMDW 주입되는 정액은 태내에 머물지 못하고 접합부에서 꿀꺽거리며 넘쳐흐르고 있다.
		PRINTFORMDW 이미 한 송이는 한계를 넘어 말로 표현할 수 없는 신음을 내며 %조사처리(CALLNAME:MASTER,"에게")% 기대었다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 의식을 잃어가고 있는 한 송이를 부축하며, 오늘은 이걸로 그만둘까? 라고 물으면
		PRINTFORMW 「싫어... 더 줘... %UNICODE(0x2665)%%UNICODE(0x2665)%」
		PRINTFORMDW 쾌락에 취한 얼굴로 계속을 원해왔다.
	ELSEIF 充填率(TARGET,1) >= 100
		PRINTFORMDW 서로의 접합부에 가해지는 자극은 따끔거리는 통증을 느낄 정도가 되어 있었다.
		PRINTFORMW 「우아아... %UNICODE(0x2665)% %CALLNAME:MASTER%... 깊숙한 곳이 간지러워요... %UNICODE(0x2665)%」
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 거시기(성기)로... 간지러움을 가라앉혀 주세요... %UNICODE(0x2665)%%UNICODE(0x2665)%」
	ENDIF
	RETURN 1
ENDIF
RETURN 1
