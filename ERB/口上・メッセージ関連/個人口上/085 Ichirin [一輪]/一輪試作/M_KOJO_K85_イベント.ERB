@M_KOJO_SPEVENT_K85_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
IF LOCAL
	PRINTFORML  
	PRINTFORMW 「하아~ 즐거웠어. 또 불러줘.%CALLNAME:MASTER%」
	PRINTFORMDW 돌아가는 길, 보폭을 맞추며 나란히 귀가하는 두 사람
	PRINTFORMDW 문득 옆을 보니, 이치린은 %조사처리(CALLNAME:MASTER,"의")% 옆모습을 응시하고 있었다
	PRINTFORMDW 그 온화한 표정에 이끌려 미소를 지으며 걸음을 멈춘다
	PRINTFORMDW 뭔가 얼굴에 묻었나, 하고 물어보려던 그때――
	PRINTFORML 
	PRINTFORMDW 살며시, 그녀의 향기가 느껴졌다.
	PRINTFORMDW 이치린의 얼굴이 눈앞에 있다는 것을 깨달았을 때는
	PRINTFORMDW 두 사람의 입술은 포개져 있었다.
	PRINTFORMW 「……응……하아」
	PRINTFORML 
	PRINTFORMW 「……에헤헤,…… 데이트 감사해요, 받아줘//」
	PRINTFORMDW 그렇게 말하며 부끄러워하는 그녀는 매우 귀여웠다
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K85_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML 「처음 인사했을 때는, 이렇게 둘만 같이 놀러 올 줄은 몰랐네…」
		PRINTFORMDW 돌아가는 길, 나란히 귀가하는 중, 이치린이 작게 중얼거렸다.
		PRINTFORMW 「나 말이야, 처음에는 %조사처리(CALLNAME:MASTER,"를")% 남자로 생각해 볼 일은 절대 없을 거라고 생각했어」
		PRINTFORMW 「하지만 함께 있으면 정말 즐겁고, 기쁘고…」
		PRINTFORMDW 부끄러운 듯 살짝 고개를 숙였다가 다시 얼굴을 들고
		PRINTFORMDW 희미하게 홍색으로 물든 얼굴로 그 말을 내뱉는다--
		PRINTFORMW 「나는……」
		PRINTFORMW 「나는, %조사처리(CALLNAME:MASTER,"를")% 좋아해」
		PRINTFORMW 「나랑, 사귀어 주지 않을래?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 
		PRINTFORMDW 이쪽도 같은 마음임을 고하자, 이치린은 눈에 희미하게 눈물을 글썽인다.
		PRINTFORML 
		PRINTFORMW 「정말로……?」
		PRINTFORMW 「정말로, 나로 괜찮은 거야?」
		PRINTFORML 
		PRINTFORMDW 아직 믿을 수 없다는 듯한 얼굴로 되묻는 이치린에게, %조사처리(CALLNAME:MASTER,"는")% 분명하게 고개를 끄덕였다.
		PRINTFORMDW 감격한 이치린은 무심코 %조사처리(CALLNAME:MASTER,"에게")% 안겼다.
		PRINTFORMDW 잠시의 포옹 후, %조사처리(CALLNAME:MASTER,"는")% 이치린이 항상 쓰고 있는 두건에 손을 댔다.
		PRINTFORMW 「앗…//」
		PRINTFORMDW 바람에 닿아 살짝 흐트러진 머리를 쓰다듬는다. 팔 안의 이치린은 평소와 달리 꽃처럼 연약했다.
		PRINTFORMW 「%CALLNAME:MASTER%, 정말 좋아…//」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		PRINTFORMW 「……」
		PRINTFORMW 「……아, 그렇구나...」
		PRINTFORMW 「나, 좀 들떠 있었던 것 같네」
		PRINTFORMDW 어떻게든 평정을 꾸미는 이치린이지만, 명백히 실망한 모습이 읽힌다.
		PRINTFORMW 「오늘은 즐거웠어, 정말로」
		PRINTFORMW 「또, 같이 놀아주면 기쁠 거야」
		PRINTFORMW 「그리고... 그게」
		PRINTFORMW 「언젠가, 반드시 돌아보게 해 보일 테니까」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K85_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「……아하하, 너무 과하다고♪」
					PRINTFORMDL 소소한 대화를 나눈다.
					PRINTFORMDL 손을 잡고 함께 걷는다. 그것만으로도 행복한 기분이 샘솟는다.
					PRINTFORML 「에헤헤……나 지금, %조사처리(CALLNAME:MASTER,"랑")% 있어서 행복해…」
					PRINTFORMDW 같은 방향을 바라보며 둘이 서로 기대어 천천히 귀가했다.
				CASE 1
					PRINTFORML 「음, 다음 데이트는 어디로 할까?」
					PRINTFORML 「나는 저기 가보고 싶어~」
					PRINTFORMDL 귀가하는 두 사람은 벌써 다음 데이트에 대해 상담하고 있었다.
					PRINTFORML 「아, 하지만 그 풍경도 %조사처리(CALLNAME:MASTER,"와")% 함께 보고 싶네……라든지.」
					PRINTFORMDW 두 사람의 돌아오는 길에 화제와 마음은 끊임없이 이어졌다……
				CASEELSE
					PRINTFORML 「후훗, 역시 %조사처리(CALLNAME:MASTER,"랑")% 함께 있으면 시간이 눈 깜짝할 새 지나가네」
					PRINTFORML 「다만, 즐거운 시간은 한순간에 지나가 버리지만」
					PRINTFORML 「그 한순간이 계속 이어진다면 아무 문제 없겠지, %CALLNAME:MASTER%♪」
					PRINTFORMDL 그렇게 말하며 이치린은 꽉, 하고 %조사처리(CALLNAME:MASTER,"에게")% 안겼다.
					PRINTFORMDL 걷기 힘들다고 항의해도 소용없다는 것을 깨달은 %조사처리(CALLNAME:MASTER,"는")%,
					PRINTFORMDW 이치린의 온기를 느끼며 느긋하게 집으로 향했다……
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 돌아가는 길을 걷는 당신과 이치린은 오늘의 데이트를 회상하고 있다.
					PRINTFORML 「이야, 즐거웠네~♪」
					PRINTFORML 「맞아, 다음엔 저기 가보자, 저기!」
					PRINTFORML 「나의 추천을 소개해 줄게. 후훗후훗」
					PRINTFORMDL 끌어안은 팔에 닿는 가슴의 감촉을 즐기면서,
					PRINTFORMDW 담소를 나누며 귀가하게 되었다--
				CASE 1
					PRINTFORML 「아아, 벌써 데이트는 끝인가~...」
					PRINTFORML 「... %조사처리(CALLNAME:MASTER,"는")% 즐거웠어?」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, 이치린은 기쁜 듯 미소 지었다.
					PRINTFORML 「다행이다아, 그럼 다음에 계속하지 않으면 안 돼, 응♪」
					PRINTFORMDW 다음 만남을 생각하며 두 사람은 귀갓길을 걸어갔다...
				CASEELSE
					PRINTFORML 「나, 이 돌아가는 시간도 꽤 좋아하는 거야~」
					PRINTFORML 「뭐랄까, 거기까지 포함해서 데이트구나, 하고……」
					PRINTFORMDL 그런 이치린의 옆모습에는 평온한 충족감이 있었다.
					PRINTFORMW (%CALLNAME:MASTER%도 똑같이 느껴주고 있다면 기쁠텐데……)
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, 벌써 돌아갈 시간인가......」
					PRINTFORML 「꽤 즐거운 시간이었어♪ 다음에도 잘 부탁해~」
					PRINTFORMDW 그렇게 말하며 손을 흔들고, 상쾌하게 이치린은 돌아갔다...
				CASEELSE
					PRINTFORML 「이야~ 역시 누군가랑 둘이서 돌아다니는 것도 좋네~」
					PRINTFORML 「%CALLNAME:MASTER%, 오늘은 고마워.」
					PRINTFORMW 「그럼, 안녕~♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「그럼, 슬슬 돌아갈까요」
					PRINTFORML 「기분 전환이 됐어요. 기회가 되면 또 불러주세요」
					PRINTFORMDW 이치린은 목례를 하고는 작게 손을 흔들며 돌아갔다
				CASEELSE
					PRINTFORML 「그럼, 오늘은 이걸로 해산인가요」
					PRINTFORMW 「조심해서 돌아가세요. 그럼」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
