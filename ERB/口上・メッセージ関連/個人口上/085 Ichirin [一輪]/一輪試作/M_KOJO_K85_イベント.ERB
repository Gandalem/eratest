@M_KOJO_EVENT_K85_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6, 7) ;edit
		;境内の場合
		IF GET_MAPID(CFLAG:MASTER:現在位置) == 1 ;custom code, check the entire temple
			IF TALENT:恋慕 || TALENT:恋人
