;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K16_80
CALL M_KOJO_MESSAGE_COM_K16_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K16_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:SexKnow == -1
			PRINTFORMW 「이게 뭐야? 이걸 만져도 괜찮아?」
			PRINTFORMDW  레밀리아가 당신의 성기를 만진다.
			PRINTFORML 「이런 보상에 만족하다니, 정말 이상한 사람이야...」
		ELSE
			PRINTFORML 「후우... 후후... 떨리고 있어...」
			PRINTFORMW 「... 이 역겨운 걸 만져주길 바라고 있나... 참 건방진 녀석이군...%UNICODE(0x2764)%」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:SexKnow == -1
		PRINTFORML 「다시 손으로 하고 싶어?」
		IF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「알겠어%UNICODE(0x2764)%」
					PRINTFORMW 「빨리 해! 네 하얀 거 다 내놔!」
				CASE 1
					PRINTFORML 「아직 때가 아닌가? 어서 전부 내보내 버려!」
			ENDSELECT
		ELSE
			PRINTFORML 「정말 이대로 괜찮은 거야?」
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「이걸 붙들고 있어야 할 것 같아...」
				CASE 1
					PRINTFORMW 「어쩔 수 없겠지... 이거 괜찮아?」
			ENDSELECT
		ENDIF
	ELSE
		PRINTFORML 「내 손을 쓰길 원해?」
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「좋아...」
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 반응을 주의 깊게 지켜볼 거야%UNICODE(0x2764)%」
				CASE 1
					PRINTFORML 「후우후우... 이 역겨운 것을 자위하고 싶어 하는 건가...%UNICODE(0x2764)%」
					PRINTFORMW 「자, %UNICODE(0x2764)% 쓸모없는 정액을 싸라%UNICODE(0x2764)%」
				CASE 2
					PRINTFORML 「이 더러운 것을 만지다니...%UNICODE(0x2764)%」
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「이걸로 나를 범하고 싶지...? 이걸로는 더 강해져야 해...%UNICODE(0x2764)%」
						CASE 1
							PRINTFORML 「끝부분만 비비는 건가...」
							PRINTFORMW 「평소와는 다르네...%UNICODE(0x2764)%」
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「후우... 내 손에는 좀 큰 것 같아...%UNICODE(0x2764)%」
				CASE 1
					PRINTFORML 「내 손만으로 만족하니...?」
				CASE 2
					PRINTFORML 「호라... 쌓여있던 정액을 전부... 내보내주지 않겠어...%UNICODE(0x2764)%?」
			ENDSELECT
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
