;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K16_81
CALL M_KOJO_MESSAGE_COM_K16_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K16_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧不足
		;技量が低いときにこそ[無知]が活きる気がします
		;ELSEIF ABL:舌 < 2
		;勃起しきってない
	ELSEIF BASE:MASTER:勃起 < 1000
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「... 음음, 이게 뭔지 궁금하네?」
				PRINTFORML 「내가 이렇게 핥으니까 단단해지는 거야? 그렇지 않아?」
				PRINTFORMW 「아아, 무... 응... 그래, 바로 그렇게...%COND_STR(@"%UNICODE(0x2764)%", TALENT:恋慕)%」
			CASE 1
				PRINTFORML 「... 나, 레밀리아는 당신을 섬기고 있는 거야, 알잖아? 적절한 응답을 기대하고 있어.」
				PRINTFORMDW 레밀리아는 당신을 똑바로 노려보며 귀를 따라 음경 전체를 힘주어 핥았다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕 && RAND:2
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응, 추루, 쿠푸우... 쿠츄루, 우우...」
				PRINTFORMDL 레밀리아는 당신의 성기 끝을 입에 넣고 핥기 시작한다.
				PRINTFORMDL 그녀의 입술 가장자리에서 넘쳐흐르는 침은 무시한 채, 레밀리아는 완전한 집중력으로 봉사를 계속한다.
				PRINTFORMDL 망설임 없이, 레밀리아는 당신에게 쾌감을 준다.
				PRINTFORML 「...무구, 추우, 하아... 정말이지... 너무 단단해...」
				PRINTFORMW 「나를 그렇게 매력적이라고 생각하다니... 정말로 어떤 것도 멈추지 않는구나...%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「...」
				PRINTFORMDL 레밀리아가 갑자기 움직임을 멈추고, 당신은 단단한 무언가가 자신의 성기에 눌리는 것을 느낀다.
				PRINTFORML 「... 이것이 바로 먹잇감의 피를 마시기 직전인 흡혈귀의 송곳니라는 것인가.」
				PRINTFORMW 「네가 지금 처한 상황이 얼마나 무서운지 깨닫고 있을까...」
				PRINTFORML 
				PRINTFORML 「... 그냥 작은 농담일 뿐이야, 하하.」
				PRINTFORMDL 레밀리아는 가볍게 웃은 후 입으로 계속 당신을 봉사한다.
				PRINTFORMDL 때때로 날카로우면서도 부드러운 감각이 머리 가장자리를 스치며 짜릿한 느낌을 준다.
				PRINTFORMW 「쿠츠, 구푸, 추루... 이빨을 드러낼 거라고 말해줘야 할지 모르겠네.」
			CASE 2
				PRINTFORML 「뮤우, 추우... 쿠푸우... 기분 좋아?...」
				PRINTFORML 「...푸푸우, 코하아... 기분 좋아?」
				PRINTFORMDL 레밀리아가 자신의 이미지를 유지하려는 모습에 살짝 웃음이 난다. 
				PRINTFORMDL 아무 말도 하지 않으려 노력하며 레밀리아의 머리를 쓰다듬는다.
				PRINTFORMW 「...우우ー...」
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「%TEXTR("Just as always, what/Fuu... What/What")% 놀라운 냄새네...」
				;精液中毒高い
				IF ABL:精液中毒 > 4 && RAND:2
					PRINTFORML 「나에게 이런 서비스 같은 걸 시키다니, 그건... 음... 무례해...」
					PRINTFORMDW 레밀리아는 기쁘게 네 성기를 핥고 허벅지를 비볐다.
				ELSEIF TALENT:恋慕 && RAND:2
					PRINTFORML 「그래도 그 부분은 귀엽다고 생각해...」
					PRINTFORMW 「꽤 이상해...」
				ELSE
					PRINTFORML 「이걸 핥게 하다니, 정말 최악의 사람이군... 음, 추우...」
					PRINTFORMDL 레밀리아는 당신을 모욕하면서 동시에 그 끝을 빨아들인다. 그녀는 갑자기 온 혀를 사용해 그 끝을 압박하기 시작한다.
					PRINTFORMDL 그녀의 부드러운 혀가 유두 아래의 약한 부분을 쓸어내리자, 당신은 작은 신음을 흘릴 정도의 쾌감의 물결이 밀려온다.
					PRINTFORMW 「마아, 네 반응으로 보아 즐기고 있는 것 같네\@ TALENT:恋慕 ? %UNICODE(0x2764)% # . \@」
				ENDIF
			CASE 1
				PRINTFORML 「응, 추우, 죽쿠... 푸아... 솔직히, 무슨 비상식적인 행동이야...」
				IF ABL:精液中毒 > 4 && RAND:2
					;精液中毒高い
					PRINTFORML 「이걸 내 혀에 대고 있어... 응, 흐으...」
					PRINTFORML 「넘쳐흐르는 네 이슬... 끄응..., 전부 삼켜버릴 거야...」
					PRINTFORML 「네 흥분이 느껴져, 후우, 으음... %UNICODE(0x2764)% 입안 가득 느껴져... 추쿠... %UNICODE(0x2764)% 너 정말 심하구나... %UNICODE(0x2764)%」
					PRINTFORML 「결국... %UNICODE(0x2764)% 츄, 레푸... %UNICODE(0x2764)% 저렇게... %UNICODE(0x2764)%」
					PRINTFORMDW 레밀리아는 황홀한 표정으로 정신이 나간 듯 말을 이어가며 페라치오를 계속한다...
				ELSEIF TALENT:恋慕
					PRINTFORML 「너가 아니었다면 난 벌써 물어뜯었을 텐데... 하아, 무...%UNICODE(0x2764)%」
					PRINTFORMDW 그녀의 말이 심각하다는 것을 무시하고, 레밀리아의 혀는 멈추지 않고 움직이며 당신은 더욱 기분이 좋아지기 시작한다.
				ELSE
					PRINTFORMDL 레밀리아는 그것이 살짝 부풀어 오르자 구강 서비스를 계속했다.
				ENDIF
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
