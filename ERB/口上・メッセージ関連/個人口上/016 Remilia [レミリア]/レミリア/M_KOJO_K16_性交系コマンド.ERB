@M_KOJO_MESSAGE_COM_K16_65
CALL M_KOJO_MESSAGE_COM_K16_65_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K16_65_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;こなれてない
		;ABL:Ｖ感覚 < 2
		;恋慕
	ELSEIF TALENT:恋慕 && RAND:2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「이번엔 내가 위에 있는 것 같아...」
				PRINTFORML 「좋아, 스트래들 자세를 취해주지...%UNICODE(0x2764)%」
				PRINTFORMDL 레밀리아가 그렇게 말하며 천천히 허리를 낮춘다.
				PRINTFORM 「후우...」
				;こなれてない||潤滑不足
				IF ABL:Ｖ感覚 < 3 || PALAM:潤滑 <= 3000
					PRINTFORML 「으음... 흐윽, 쿠우...」
					PRINTFORMDL 조금씩, 당신의 페니스가 그녀의 질 속으로 천천히 들어간다.
					PRINTFORMDL 레밀리아는 아직 당신의 페니스를 받아들일 준비가 되지 않았기에, 그것이 몸에 들어오자 살짝 미간을 찌푸린다.
					PRINTFORML 「후우... 으음... 들어갔어...」
					PRINTFORMDL 당신은 레밀리아의 이마에서 땀을 닦아주고 그녀를 안아 위로해준다.
					PRINTFORML 「아... %UNICODE(0x2764)%... 음...%UNICODE(0x2764)%」
					PRINTFORMDW 레밀리아는 당신의 품 안에서 조용히 스스로를 진정시키고, 그녀의 섬세한 몸이 출렁이는 리듬에 맞춰 숨을 고른다.
				ELSE
					PRINTFORML 「하아... 아아... %UNICODE(0x2764)%」
					PRINTFORMDW 단단히 닫혀 있던 주름이 음란한 입처럼 벌어지며 당신의 성기를 축축하게 삼킨다.
					;ぴっちりと閉じていた縦筋がいやらしく口を開き%CALLNAME:MASTER%の陰茎をずぶずぶと呑み込んでいった
				ENDIF
			CASE 1
				PRINTFORML 「하아, 음... %UNICODE(0x2764)%더... 더 자극적으로 해줘... %UNICODE(0x2764)%기분 좋게 해줘... %UNICODE(0x2764)%」
				PRINTFORMDL 매혹적인 눈을 휘두르며, 레밀리아는 몸을 떨면서 당신을 성적으로 흥분시키는 세 번의 당김을 한다.
				PRINTFORMDW 당신은 인내심의 한계에 도달하여 레밀리아의 가느다란 허리를 잡고, 단단하게 발기된 자신의 것을 그녀의 가장 깊숙한 곳으로 밀어 넣는다.
				PRINTFORML 
				PRINTFORML 「구우~?!... %UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMDL 반격은 예상하지 못했지만, 레밀리아는 숨을 들이키면서도 목소리가 새어 나오지 않도록 간신히 참았다.
				PRINTFORMDL 거의 동시에 레밀리아의 질 안쪽이 수축하기 시작하며 당신에게 강렬한 쾌감을 선사한다.
				PRINTFORMW 「기-기다려... 나... 아- 하이-%UNICODE(0x2764)%나야!%UNICODE(0x2764)%아!%UNICODE(0x2764)%흐으응! %UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		;TWレミリア口上がupされる前に書いたブツなのでキャラ違う感じ
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「후후후, 여기서 너를 내려다보니 기분이 좋군!」
				PRINTFORMDL 레밀리아는 당신 위에 올라탄 채 두려움 없이 미소 짓는다.
				PRINTFORML 「자, 내 작은 아가야. 나에게 뭘 시킬래? 말해봐.」
				PRINTFORMDL 당신의 부풀어 오른 성기가 그녀의 아래 입을 천천히 크게 벌리며 젊은 질을 보여준다.
				PRINTFORMDW 레밀리아는 천천히 허리를 비튼다...
			CASE 1
				PRINTFORML 「호라, 너도 이런 종류의 걸 좋아하지...?」
				PRINTFORMDL 레밀리아가 네 유두를 만지기 시작한다.
				PRINTFORMDL 그녀의 가는 손가락이 네 유두를 말아 올리고 어루만지고 꼬집으며 살짝 부풀어 오르게 만든다.
				PRINTFORMDL 전기적이고 간질거리는 감각이 너의 뇌에서 서서히 이성을 녹이기 시작한다...
				PRINTFORML 「참 품위 없는 표정을 짓고 있네. 정말 무력한 인간이구나.」
				PRINTFORMDW 레밀리아가 나직하게 웃자, 그녀의 질 벽이 네 성기를 단단히 감싸기 시작한다...
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
