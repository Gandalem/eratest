; Modular ERB: 個人口上/124 Okina [隠岐奈]/賑やかし隠岐奈【124】/M_KOJO_K124_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K124_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「헤에, 나에게 도전할 생각인가. 꽤나 대단한 무용이군」
		PRINTFORMW 오키나는 등 뒤에서 사계절 색의 오라를 내뿜었다.
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 「훗, 조금은 배짱이 있나 보군? 그럼 이건 어때서?」
				PRINTFORMW 「비기 『일곱 별의 검』! 자, 할 수 있다면 화려하게 피해보라고!」
			CASE 1
				PRINTFORML 「하하하! 설마 여기까지 몰리게 될 줄은 몰랐다고!」
				PRINTFORML 「하지만 말이야…… '아나키 발렛 헬'!! 여기서 너는 끝이다!」
				PRINTFORMW 절망적일 정도의 탄막이 %조사처리(CALLNAME:MASTER,"를")% 뒤덮는다!
			CASE 0
				PRINTFORML 「뭐, 크윽!?」
				PRINTFORMW ……드디어 오키나의 최종 탄막을 격파했다!
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「나 같은 나한테, 쉽게 이길 수 있을 거라고 생각하지 마?」
				PRINTFORMW 오키나는 사계의 마력을 일깨웠다...!
			CASE 1
				PRINTFORML 「후토의 비신을 맛보려 들지 마라? 자, 마음 단단히 먹도록 해라!」
				PRINTFORMW 오키나는 더욱 강하게 마력을 끌어올리며 날카로운 눈빛으로 이쪽을 응시했다.
			CASE 2
				PRINTFORML 「후훗후… 완벽하게 두들겨 패 버려주마!」
				PRINTFORMW 오키나는 불적한 미소를 지으며, 몸을 감싼 오라를 더욱 격렬하게 만들었다.
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「오옷!…… 후후후, 아쉬웠나?」
				PRINTFORMW 오키나는 순간적으로 마력을 해방하여 피격하는 것을 막았다.
			CASE 1
				PRINTFORML 오키나는 순간적으로 마력을 해방하여 피격하는 것을 막았다.
				PRINTFORMW 「크큭, 대단하잖아! 아무리 그래도 방금 건 좀 식은땀이 나네?」
			CASE 2
				PRINTFORML 「앗, 위험해! 등에 있는 문을 열어줘!」
				PRINTFORMW 오키나는 손을 들자 뒤쪽의 문을 이용해 탄막을 어딘가로 날려버렸다...
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3, 2
				PRINTFORML 「후훗. 뭐 당연한 승리지!」
				PRINTFORML 오키나는 성대한 잘난 척을 하고 있다.
				PRINTFORMW 「그래도, 겁쟁이 같으니…… 수련이 부족해, 수련이!」
			CASE 1
				PRINTFORML 「조금은 할 줄 아는 것 같았지만…… 뭐, 나한테 이길 수 없는 게 당연해, 신경 쓰지 마!」
				PRINTFORMW 오키나는 성대한 잘난 체하는 표정을 짓고 있다.
			CASE 0
				PRINTFORML 「죽었다아! 합격이다!!」
				PRINTFORML %CALLNAME:MASTER%, 암흑노가에 흥미는 없어?
				PRINTFORMW 권유 모드인지, 오키나가 갑자기 친근해졌다…….
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
