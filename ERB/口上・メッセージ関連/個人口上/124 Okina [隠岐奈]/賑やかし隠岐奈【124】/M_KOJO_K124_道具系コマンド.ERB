;40,ローター
;==================================================

@M_KOJO_MESSAGE_COM_K124_40
CALL M_KOJO_MESSAGE_COM_K124_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 「후우읏... 크윽, 우으으...앗」
		PRINTFORML 오키나는 잠 못 이루는 듯하다….
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕 || TALENT:124:愛欲
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「이, 이런 장난감으로…… 후, 아니야읏%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「우으윽, 기, 기분은 좋은데…… 뭔가 개운하지 않아...!」
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「크, 응아앗! 야, 이봐! 언제까지 밀착하고 있을 작정이야...!」
			CASEELSE
				PRINTFORMW 「흐으윽, 그, 지, 지독해! 이제 그만둬…….읏!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
