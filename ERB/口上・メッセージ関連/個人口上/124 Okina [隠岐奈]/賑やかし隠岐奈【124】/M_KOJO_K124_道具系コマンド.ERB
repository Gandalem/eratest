;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K124_44
CALL M_KOJO_MESSAGE_COM_K124_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		IF TEQUIP:バイブ
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕
		;解除時
		IF !TEQUIP:バイブ
			IF EXP:Ｖ経験 > 70
				PRINTFORML 「벌써 빼버리는 거야? 그럼 다음엔 %조사처리(CALLNAME:MASTER,"가")% 직접……%UNICODE(0x2764)%」
			ELSE
				PRINTFORML 「크윽, 우우……. 다음엔…… 어떻게 할 생각이야……?」
			ENDIF
		ELSE
			;処女
			IF TALENT:処女 == 1
				PRINTFORML 「처음은 %CALLNAME:MASTER%한테 직접…… 아니, 이미 너무 늦었나…… 우우우……」
			ELSEIF EXP:Ｖ経験 > 70
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「더 난장판으로 만들어줘, %CALLNAME:MASTER%…%UNICODE(0x2764)%」
						PRINTFORMW 오키나는 기대와 욕망에 가득 찬 눈으로 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
					CASEELSE
						PRINTFORML 「하아…… 응, 굵다아…읏%UNICODE(0x2764)%」
						PRINTFORMW 「아앗%UNICODE(0x2764)% 벌써… 중독될 것 같아, 후훗, 음응읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「크으윽... 응, 좀 힘들어...!」
						PRINTFORMW 오키나는 괴로운 듯 얼굴을 일그러뜨리고 있다...
					CASEELSE
						PRINTFORML 「응읏... 크으윽... 하아아...앗」
						PRINTFORMW 「이, 이거... 좀 너무 두껍지 않아...?」
				ENDSELECT
			ENDIF
		ENDIF
		;それ以外
	ELSE
		;解除時
		IF !TEQUIP:バイブ
			PRINTFORML 「우아...윽! ……하아, 하아, 하아……읏」
		ELSE
			;処女
			IF TALENT:処女 == 1
				PRINTFORML 「하아…… 처음이었는데……」
			ELSE
				PRINTFORML 「응으윽, 아아…… 우우읏! 이, 이거, 싫어어……읏」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
