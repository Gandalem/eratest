@M_KOJO_MESSAGE_COM_K124_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		IF TEQUIP:アナルバイブ
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕
		;解除時
		IF !TEQUIP:アナルバイブ
			IF EXP:Ａ経験 > 70
				PRINTFORML 「하아, 하아앗%UNICODE(0x2764)% 후후후, 다음엔 어떻게 할 생각이다…? %UNICODE(0x2764)%」
			ELSEIF EXP:124:Ａ経験 > 20
				PRINTFORML 「윽, 우우욱…… 아직 들어있는 듯한 감각이 해……」
			ELSE
				PRINTFORMW 「하아앗, 하아앗, 후우…… 더는 장난감은 싫다고…?」
			ENDIF
		ELSE
			IF EXP:Ａ経験 > 70
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「하아, 하아……읏%UNICODE(0x2764)% 이대로 내가 부서질 정도로 격렬하게 해줘…%UNICODE(0x2764)%」
						PRINTFORMW 항문을 장난감으로 범해지는 굴욕마저 지금의 오키나에게는 이미 쾌락의 양분일 뿐인 듯하다.
					CASEELSE
						PRINTFORML 「아아앗%UNICODE(0x2764)% 엉덩이 왔어으으윽%UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORMW 오키나는 참을 수 없는 쾌락에 몸부림치고 있다.
				ENDSELECT
			ELSEIF EXP:124:Ａ経験 > 20
				PRINTFORML 「흐, 크으윽, 응으...흣! 나 자신도 이렇게 할 줄은 몰랐어...... 아아...큭%UNICODE(0x2764)%」
			ELSE
				PRINTFORML 「흐읍, 그, 싫어! 그거 싫단 말이야앗!」
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 직접 해줬으면 좋은데! 안 되는 거야!?」
			ENDIF
		ENDIF
		;それ以外
	ELSE
		;解除時
		IF !TEQUIP:アナルバイブ
			IF EXP:124:Ａ経験 > 20
				PRINTFORML 「하아…… 하아…… 그만, 이제 봐줘…… %UNICODE(0x2764)%」
			ELSE
				PRINTFORML 「크윽, 으응…… 다시는 이런 거 쓰지 말아줘……」
			ENDIF
		ELSE
			IF EXP:Ａ経験 > 70
				PRINTFORML 「응으으, 으으으……읏%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 꾹 눈을 감고 쾌락을 참으려 하고 있다.
			ELSEIF EXP:124:Ａ経験 > 20
				PRINTFORML 「히끅, 싫어! 그런 거 넣지 마……읏!」
				PRINTFORMDW 오키나는 장난감으로 엉덩이를 범당하는 것에 저항하는 듯하다.
			ELSE
				PRINTFORML 「잠, 잠깐! 그거 들어갈 리가 없잖아! 그만둬……읏!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
