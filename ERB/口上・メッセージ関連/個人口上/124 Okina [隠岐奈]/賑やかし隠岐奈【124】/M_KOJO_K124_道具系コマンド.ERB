;42,クリキャップ
;==================================================

@M_KOJO_MESSAGE_COM_K124_42
CALL M_KOJO_MESSAGE_COM_K124_42_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_42_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		;解除時
		IF !TEQUIP:クリキャップ
			PRINTFORML 「큭!?」
			PRINTFORMW 오키나는 큰 소리를 질렀지만…… 아직 잠들어 있다.
		ELSE
			PRINTFORML 「쿠으... 후우...」
			PRINTFORMW 민감한 음핵에 도구를 부착당해도, 오키나가 눈을 뜨는 모습은 없다.
		ENDIF
		RETURN 1
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕 || TALENT:124:愛欲
		;解除時
		IF !TEQUIP:クリキャップ
			PRINTFORMW 「꺄아앗!? 그, 벗기려면 미리 말하라고!」
		ELSE
			PRINTFORMW 「우으윽, 도구는 별로 안 좋아하는데……」
		ENDIF
		;それ以外
	ELSE
		;解除時
		IF !TEQUIP:クリキャップ
			PRINTFORMW 「하아, 하아읏, 벌써 끝이야…?」
		ELSE
			PRINTFORMW 「이, 이런 거 달면…… 하아읏%UNICODE(0x2764)%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
