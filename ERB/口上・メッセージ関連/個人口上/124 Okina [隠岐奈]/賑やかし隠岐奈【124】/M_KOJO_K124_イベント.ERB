@M_KOJO_EVENT_K124_17(ARG,ARG:1)
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ARG=1～3は排他
	;謎の快感
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORML 「아...앗%UNICODE(0x2764)%」
			PRINTFORMW 「바, 바보... 이제, %CALLNAME:MASTER%……」
		ELSEIF TALENT:恋慕
			PRINTFORML 「히으윽...!?」
			PRINTFORMW 「하아... %CALLNAME:MASTER%.... 변태 같으니라고...」
		ELSE
			PRINTFORML 「하아……윽!?」
			PRINTFORMW 「이, 이쪽은…! %CALLNAME:MASTER%, 능력을 사용한 거야!?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORML 「아, 아아앗%UNICODE(0x2764)%」
			PRINTFORMW 「하아, 하아…… 무슨 짓을 하는 거야, 저 변태 같으니라고…!」
		ELSEIF TALENT:恋慕
			PRINTFORML 「야, 아아아악!?」
			PRINTFORMW 「하아, 하앗…… 뭐, 뭐야…… 벌써……윽」
		ELSE
			PRINTFORML 「~~~~읏!!!? 아, 나중에 기억해둬……!!」
			PRINTFORMW 오키나는 눈에 눈물을 고한 채 자신을 노려보고 있다…….
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;パンツ紛失
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「……조키나」
					PRINTFORMW 오키나는 얼굴을 붉히며 치마를 붙잡고 있다.
				CASE 1
					PRINTFORML 「우으…… 오늘 하루를 이걸로 보내라고?」
					PRINTFORML 오키나는 얼굴을 붉히며, 부끄러운 듯 움찔거리고 있다.
				CASE 2
					PRINTFORML 「별, 별로…… 원한다면 말해주면 되는데……」
					PRINTFORML 오키나는 부끄러운 듯 치마를 붙잡고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「………………」
					PRINTFORMW 오키나는 말하기 힘든 듯 얼굴을 붉히며 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
				CASE 1
					PRINTFORML 「오, 너……」
					PRINTFORML 오키나는 뺨을 붉히며 치마를 누르면서 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
				CASE 2
					PRINTFORML 「아, 질리지 않는 애네……」
					PRINTFORML 오키나는 새빨간 얼굴로 치마를 붙잡고 있다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚口内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;精液中毒低精飲
		IF ARG:1 == 1
			IF EXP:精液経験 == 0
				PRINTFORML 「우으……읏!? 응, 콜록, 콜록…!」
				PRINTFORML 「으윽…… 이게 뭐야…? 설마…」
				PRINTFORMW 오키나는 처음 맛보는 정액의 맛에 구역질을 하며 불안한 표정을 짓고 있다.
			ELSE
				PRINTFORML 「응윽!? 크, 콜록, 이, 이런……읏」
				PRINTFORMW 오키나는 몇 번이나 기침을 하며 삼켜버린 정액을 토해내려고 애쓰고 있다.
			ENDIF
			;精液中毒低吐き出し
		ELSEIF ARG:1 == 2
			PRINTFORML 「엣!? 크, 크윽, 이런 곳까지……읏」
			PRINTFORMW 오키나는 원망스럽다는 듯 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
			;精液中毒低手で覆う
		ELSEIF ARG:1 == 3
			PRINTFORML 「음읍!? 응... 크윽...읏」
			PRINTFORMW 오키나는 분한 듯 얼굴을 일그러뜨리며 손으로 입가를 가리고 있다.
			;精液中毒高精飲
		ELSEIF ARG:1 == 4
			PRINTFORML 「응읏, 음, 고쿠……응읏」
			PRINTFORMW 오키나는 새빨개진 얼굴로 입안의 정액을 삼켰다.
			;濃厚精液＆精液中毒低吐き出し
		ELSEIF ARG:1 == 5
			PRINTFORML 「콜록, 크윽, 우에엣!? 뭐, 뭐야 이거……읏」
			PRINTFORMW 오키나는 얼굴을 찡그린 채 손에 뱉은 그것을 응시하고 있다.
			;濃厚精液＆精液中毒高精飲
		ELSEIF ARG:1 == 6
			PRINTFORML 「응우읏!? 응, 응우읏… 극, 음, 하아… 하아…」
			PRINTFORML 「이, 이렇게 진한 것을… 정말 참기 힘든 녀석이야……」
			PRINTFORMW 오키나는 얼굴을 일그러뜨리면서도 황홀한 표정으로 크게 숨을 내쉬었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚顔面射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;幼稚持ち＆精液経験100未満
		IF ARG:1 == 1
			PRINTFORML 
			PRINTFORMW 
			;通常ぬぐい取り
		ELSEIF ARG:1 == 2
			PRINTFORML 「우, 와앗!? 큭, 무슨 짓을 하는 거야! 이……읏」
			PRINTFORMW 오키나는 허둥지둥 얼굴에 묻은 정액을 닦아냈다.
			;顔射精液舐めとり
		ELSEIF ARG:1 == 3
			PRINTFORML 「힉!? 뭐, 뭘 하는 거야……!」
			PRINTFORML 「정말… 어쩔 수 없는 애네, 정말……」
			PRINTFORMW 오키나는 불평을 늘어놓으면서도 손으로 닦은 정액을 핥았다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚手淫射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;ぬぐい取り
		IF ARG:1 == 1
			PRINTFORML 「우왓... 여, 여기에까지...」
			PRINTFORMW 오키나는 울 것 같은 표정으로 손의 정액을 닦아내고 있다.
			;舐めとり
		ELSEIF ARG:1 == 2
			PRINTFORML 「여기에까지…… 하아, 마음대로 해버리고…」
			PRINTFORMW 오키나는 욕설을 내뱉으면서 손에 묻은 흰 액체를 살짝 입에 머금었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚アナル射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;Ａ感覚2以下
		IF ARG:1 == 1
			PRINTFORML 「히으윽!? 우우... 뭐야? 엉덩이가...」
			PRINTFORMW 오키나는 엉덩이를 감싸 쥐고 부르르 떨고 있다.
			;ソレ以外
		ELSEIF ARG:1 == 2
			PRINTFORML 「히잉!?! 하앗, 하아……읏」
			PRINTFORMW 오키나는 엉덩이에 밀려온 쾌락과 수치심에 떨고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚処女喪失】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 「우, 아아앗!? 아앗, 그,럴 리가……」
		PRINTFORML 「…이, 이런, 이런 일이……읏」
		PRINTFORMW 오키나는 손으로 얼굴을 가리고 그 자리에 무너져 내렸다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚膣内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;非処女膣内射精ピルなし
		IF ARG:1 == 1
			IF TALENT:恋慕
				PRINTFORML 「배가 뜨겁다……. 이 감각, 설마……」
				PRINTFORML (어떡하지, 피임약 같은 건 먹지 않았는데…… 하지만, %조사처리(CALLNAME:MASTER,"의")% 아이라면……)
				PRINTFORMW 오키나는 뺨을 붉히며, %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
			ELSE
				PRINTFORML 「우, 이 감각…… 설마……」
				PRINTFORMW 오키나는 창백해진 얼굴로 자신의 아랫배를 손으로 누르고 있었다.
			ENDIF
			;非処女膣内射精ピルあり
		ELSEIF ARG:1 == 2
			IF TALENT:恋慕
				PRINTFORML 「배가 뜨거워…… 이 감각, 설마……」
				PRINTFORML (일단 피임약은 먹고 있었지만…… %조사처리(CALLNAME:MASTER,"의")% 행동, 나를 임신시키려는 걸까……?)
				PRINTFORMW 오키나는 뺨을 붉히며 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
			ELSE
				PRINTFORML 「우, 이 감각… 설마…」
				PRINTFORML (일단 피임약을 먹어둔 것이 정답이었지만…)
