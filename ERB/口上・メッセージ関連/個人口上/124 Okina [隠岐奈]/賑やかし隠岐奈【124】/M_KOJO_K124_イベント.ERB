	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORML 「하아… 하아…… 후우…….」
		PRINTFORMW 「나 같은 사람이 조금은 들떠 버렸네, 후훗」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		PRINTFORML 「%CALLNAME:MASTER%……」
		PRINTFORMW 오키나는 마지막으로 다정하게 입을 맞추고 %조사처리(CALLNAME:MASTER,"를")% 해방했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORML 「나는 이미 만족했지만…… 뭐, 원하신다면 들어드릴게」
		PRINTFORMW 오키나는 곤란한 표정을 지으면서도 미소를 띠었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORML 「...후? 그렇게 말한다면, 네가 부서질 때까지 해 주지」
		PRINTFORMW 오키나는 가학적인 마음을 불태우며 눈빛에 욕망을 비추고 웃었다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;一日の終了時(AFTERTRAニーの前)、面識がなければ呼び出されない
;==================================================

