@M_KOJO_EVENT_K124_15(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;未実装（押し倒しコマンドに統合？
	;MASTERが押し倒した（ウフフ開始時）
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 1
	;PRINTFORML
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;逢瀬終了（ウフフ終了時）「おしまい」（体を離す）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SIF FLAG:時間停止 ;fix
			RETURN 0
		IF CFLAG:TARGET:睡眠
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「저기…… %조사처리(CALLNAME:MASTER,"가")%, 마지막으로 키스해 줄래……」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 살며시 입맞춤을 하자, 오키나는 진심으로 행복한 듯 미소 지었다.
				CASE 1
					PRINTFORML 「………………」
					PRINTFORMW 오키나는 상기된 얼굴 그대로, 약간 민망한 듯 서 있다……
				CASE 2
					PRINTFORML 「또, 다음엔…… 반드시야?」
					PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"의")% 귓가에서 살짝 속삭였다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;事後描写
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;精液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「……윽! 흘러버렸어… 으윽……」
					PRINTFORML 오키나는 얼굴을 붉히며, 흘러넘친 정액을 몇 번이고 닦고 있다…….
				CASE 1
					PRINTFORML 「싫, 싫어…… 흘러버려……」
					PRINTFORML 오키나는 부끄러운 듯 엉덩이를 흔들고 있다….
				CASE 2
					PRINTFORML (어떡하지, %조사처리(CALLNAME:MASTER,"가")% 흘러내리고 있어……)
					PRINTFORML (저렇게 많이 받아냈으니… 으윽…)
					PRINTFORML 오키나는 얼굴을 새빨갛게 물들이고, %조사처리(CALLNAME:MASTER,"의")% 얼굴을 응시하고 있다.
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;愛液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아직 몸이 달아오른 것 같아서…… 하아……읏」
					PRINTFORML 오키나는 어쩔 줄 몰라 하면서도 평정심을 되찾으려고 심호흡하고 있다.
				CASE 1
					PRINTFORML (흐윽, 아직 축축해…… 부끄러워…)
					PRINTFORML 오키나는 쭈뼛거리면서도 평정심을 되찾으려고 심호흡을 하고 있다.
				CASE 2
					PRINTFORML (그렇게 많이 했는데, 아직도 욱신거려…… 으윽……)
					PRINTFORML 오키나는 몸을 움츠리면서도 평정심을 되찾으려고 심호흡을 하고 있다.
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;事後のムード
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%……」
					PRINTFORML 오키나는 눈을 촉촉하게 적으며, %조사처리(CALLNAME:MASTER,"의")% 말에 귀를 기울이고 있다……
				CASE 1
					PRINTFORML 「오늘 일은, 누구에게도 말하지 마라…?」
					PRINTFORML 오키나는 소리 없이 %조사처리(CALLNAME:MASTER,"에게")% 속삭였다.
				CASE 2
					PRINTFORML 「많이 사랑해줘서… 우, 기뻤어……」
					PRINTFORML 오키나는 부끄러운 듯 미소 짓고 있다.
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;服を着る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 4
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「후우... 이걸로 됐겠지, 라고」
					PRINTFORML 오키나는 단장하는 것을 마친 듯하다.
				CASE 1
					PRINTFORML 「히얏!? 여, 여기에도 정액이……」
					PRINTFORML 오키나는 닦지 못한 정액을 알아차리고 당황하고 있다.
				CASE 2
					PRINTFORML 「응읏... 으윽...%UNICODE(0x2764)%」
					PRINTFORML (옷이 달라붙어서... 이, 이 정도만 해도 느껴버리는 게 너무 분해...! )
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
