@M_KOJO_SPEVENT_K124_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:恋人
			PRINTFORML 「후후후, 오늘은 즐거웠다」
			PRINTFORMW 오키나는 기분이 좋아 보이며 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다.
			PRINTFORML 「이제 헤어지는 건 아쉽지만… 다음에도 또 불러줄 거지?」
			PRINTFORMW 「그때를 기대하고 있으니까」
		ELSEIF TALENT:恋慕
			PRINTFORML 「……여기서 끝인가?」
			PRINTFORML 「그렇구나… 조금 아쉬울지도 모르겠네, 후훗」 
			PRINTFORML 오키나는 살짝 부끄러운 듯 미소 지었다.
			PRINTFORMW 「다음에 또 이렇게 나가자, 약속이야?」
			PRINTFORMW 「그럼, 다음에……」
		ELSE
			PRINTFORML 「자, 이제 슬슬 헤어질 때가 됐나?」
			PRINTFORML 「그러게, 또 이렇게 외출하는 건가…… 그럼 잘 가」 
			PRINTFORMW 오키나는 손을 작게 흔들며 작별 인사를 했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML (…… %CALLNAME:MASTER%일은 슬슬 용서해 줘도 괜찮을까)
		PRINTFORML (계속 화난 채로 있는 건 어쩔 수 없으니까)
		PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"를")% 완전히 용서한 듯하다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML (자, 조금은 성실한 모습을 보여준 걸까…)
		PRINTFORML (그렇다고는 해도 아직 용서할 수는 없지만.)
		PRINTFORMW 오키나는 조금만 %조사처리(CALLNAME:MASTER,"를")% 용서해 준 듯하다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML (일단은 합격점,이네)
		PRINTFORML (여기서부터 어떻게 올지가 문제지만...)
		PRINTFORMW 오키나는 아직 %조사처리(CALLNAME:MASTER,"를")% 경계하는 듯하다.
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
