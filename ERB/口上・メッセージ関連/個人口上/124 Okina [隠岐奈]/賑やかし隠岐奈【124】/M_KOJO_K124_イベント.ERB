@M_KOJO_EVENT_K124_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 
		IF CFLAG:TARGET:睡眠
			PRINTFORML 「스야……」
			PRINTFORML 오키나는 전혀 위엄 없는, 힘이 빠진 잠든 얼굴을 드러내고 있다….
		ELSEIF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, %CALLNAME:MASTER%인가」
					PRINTFORML 「……무슨 일이지? 이쪽으로 오지 않나?」
					PRINTFORMW 오키나는 빨리 오라고 손짓하고 있다.
				CASE 1
					PRINTFORML 「앗, %CALLNAME:MASTER%!」
					PRINTFORML 오키나는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 보자마자 환하게 웃었다.
					PRINTFORMW 「이리 와 봐! 나랑 수다라도 떨까아옹!」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아… 아아, %CALLNAME:MASTER%인가」
					PRINTFORML 「뭐, 슬슬 올 거라고는 생각하고 있었지만……」
					PRINTFORMW 오키나는 기쁨을 감추지 못하고 실실 웃고 있다.
				CASE 1
					PRINTFORML 「에, 아, %CALLNAME:MASTER%!?」
					PRINTFORML 「아, 아니야, 아무것도 아니야! 딱히 너 생각하고 있었다거나 그런 건 아니라고!」
					PRINTFORMW 오키나는 얼굴을 붉히며 어쩔 줄 몰라 허둥대고 있다….
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「오, %CALLNAME:MASTER%네」
					PRINTFORML 「혹시 나 보러 온 거야아?」
					PRINTFORMW 오키나는 장난스러운 말투로 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다.
				CASE 1
					PRINTFORML 「너냐. 한가하다면 내가 상대해 줄 수도 있는데?」
					PRINTFORMW 오키나는 씨익 웃으며 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「아, %CALLNAME:MASTER%인가」
					PRINTFORMW 오키나는 여전히 잘난 체하고 있다.
				CASE 1
					PRINTFORML 「뭐냐, 너냐」
					PRINTFORML 「……능력을 남용하지 마라」
					PRINTFORMW 오키나는 조용히, 그러나 위압적인 목소리로 %조사처리(CALLNAME:MASTER,"에게")% 경고했다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「오이, %CALLNAME:MASTER%」
					PRINTFORML 갑자기 등 뒤에서 목소리가 들려왔다.
					PRINTFORMW 「나야, 오키나라고…… 뭐야, 그 얼빠진 얼굴는?」
				CASE 1
					PRINTFORML 어깨를 두드리며 돌아보니, 그곳에는 기쁜 듯 미소 짓는 오키나가 있었다.
					PRINTFORML 「%CALLNAME:MASTER%, 내가 왔어♪ 물론, 신경 써 주지 않아도 돼?」
					PRINTFORMW 오키나의 황금색 눈은 기대감으로 가득 차 있다….
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%」
					PRINTFORML 갑자기 등 뒤에서 목소리가 들렸어! ……오키나다.
					PRINTFORMW 「응, 놀랐니? 후훗! 너도 의외로 겁이 많네」
				CASE 1
					PRINTFORML 「아…… %CALLNAME:MASTER%……」
					PRINTFORML 「안, 안녕. 설마 여기서 만나게 될 줄은 몰랐는데…」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 얼굴을 보고 오키나는 살짝 볼이 물들어 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「방해할 거야~」
					PRINTFORMW 어느새 오키나가 %조사처리(CALLNAME:MASTER,"의")% 등 뒤에 서 있었다.
				CASE 1
					PRINTFORML 「네 등 뒤의 문, 꽤 쓰기 편하구나」
					PRINTFORMW 등 뒤에서 들려온 목소리에 놀라 돌아보니, 오키나가 불길한 미소를 짓고 있었다……
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORML 「어라! 뭐야, %CALLNAME:MASTER%였구나」
			PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"의")% 모습을 인정하고 기쁘게 웃은 뒤 그대로 목욕에 들어갔다.
			PRINTFORML 
			PRINTFORML 「음~ 기분 좋아…… 네가 같이 있어 주니까 그런 걸까? 후후훗!」
			PRINTFORMW 욕조에 몸을 담근 오키나는 %조사처리(CALLNAME:MASTER,"에게")% 기대며 기분 좋게 눈을 가늘게 뜨고 있다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%……읏!?」
			PRINTFORMW 「미, 미안해! 네가 여기 있을 줄 몰라서!」
			PRINTFORML 
			PRINTFORML 오키나는 황급히 나가려 했지만, %조사처리(CALLNAME:MASTER,"는")% 그녀를 붙잡고 함께 들어가자고 유혹했다.
			PRINTFORML 「에? 아니, 하지만…… 그게 괜찮은 거야...?」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, 오키나는 홍조를 띠며 기쁜 듯 미소 지었다.
		ELSE
			PRINTFORML 「응? 뭐야, %CALLNAME:MASTER%인가」
			PRINTFORML 오키나는 %조사처리(CALLNAME:MASTER,"의")% 모습을 확인하자, 그대로 망설임 없이 목욕물에 몸을 담갔다.
			PRINTFORMW 「오늘 물 온도는 어때? 나는 뜨거운 편이 좋은데……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			PRINTFORML 「오야……무엇이지, %CALLNAME:MASTER%인가」
			PRINTFORML 「음, 오늘은 느긋하게 담그고 싶으니… 다시 나오도록 하겠다」
			PRINTFORMW 「너와 함께 들어가는 건 다음에 하자, 후훗」
		ELSEIF TALENT:恋慕
			PRINTFORML 「우와...! 앗, 이건 허를 찔렸네!」
			PRINTFORML 「아아…… 그래, 일단 다시 나가서 오도록 하지!」
			PRINTFORMW 오키나는 가볍게 미소를 지으며 서둘러 나갔다.
			PRINTFORML 
			PRINTFORMW (……부끄러워져서 나도 모르게 뛰쳐나와 버렸네…… 좀 손해 봤다……)
		ELSE
			PRINTFORML 「응? 뭐야, 선행인가」
			PRINTFORMW 오키나는 다시 나오겠다고 말한 뒤, 그대로 나갔다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORML 「오야…? 아아, 뭐야, %조사처리(CALLNAME:MASTER,"는")%?」
			PRINTFORML 「뭐야, 너 얼굴 새빨갛잖아? 열나서 쓰러지기 전에 얼른 올라가, 자어」
			PRINTFORML 오키나에게 재촉받아, %조사처리(CALLNAME:MASTER,"는")% 목욕에서 나오기로 했다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「우, 우왓! %조사처리(CALLNAME:MASTER,"는")%!?」
			PRINTFORML 오키나는 %조사처리(CALLNAME:MASTER,"의")% 모습을 보자 황급히 자신의 나체 몸을 가렸다.
			PRINTFORML 「하, 빨리 나가! 바보! 변태!!」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 부당한 대우에 입을 다물지 못한 채 그 자리를 떠났다.
			PRINTFORML 
			PRINTFORML (당황해서 욕을 해버렸어... %조사처리(CALLNAME:MASTER,"에게")% 나쁜 짓 했네...)
			PRINTFORMW 오키나는 아무도 없는 목욕탕에서 크게 한숨을 내쉬었다.
		ELSE
			PRINTFORML 「어라, %CALLNAME:MASTER%인가…… 나쁜 일이 생기면 나가 줄 수 있어?」
			PRINTFORML 어쩔 수 없어서 %조사처리(CALLNAME:MASTER,"는")% 목욕에서 나오기로 했다.
			PRINTFORMW 「후우… 역시, 목욕은 혼자 하는 게 최고네」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋慕
			PRINTFORML 「오, %CALLNAME:MASTER%네, 우연이네」
			PRINTFORML 「……음, 뭘 할까나아」
			PRINTFORMW 오키나는 흘깃거리며 이쪽을 바라보며 혼잣말을 하고 있다….
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%인가. 또 나쁜 계획을 꾸미고 있는 건 아니겠지?」
			PRINTFORMW 오키나는 이쪽을 가늠하듯 유심히 바라보고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
		ELSEIF TALENT:恋人
			PRINTFORML 「아아, %CALLNAME:MASTER%…… 잠깐, 잠깐만! 그 옆에 있는 건……!」
			PRINTFORML 「오, 너, 나 같은 존재가 있는데…… 이건 아무래도 용납할 수 없다랄까…」
			PRINTFORML 「……혹시, 나 혼자로는 만족 못 하는 그런 거라도 있나……?」
			PRINTFORMW 오키나는 드물게 충격을 받은 듯 어쩔 줄 몰라 하고 있다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「오야, %조사처리(CALLNAME:MASTER,"가")% 아니신가. 그리고 그 옆에 있는 건…… 음?」
			PRINTFORML 오키나는 의심스러운 눈초리로 %CALLNAME:MASTER%일행을 바라본다.
			PRINTFORMW 「……뭐, 방해하지는 않도록 해 주지」
			PRINTFORMW ………
			PRINTFORML 「하아아…… 저 두 사람… 그렇게 다정하게, 함께……」
			PRINTFORML %CALLNAME:MASTER%일행에게서 약간 떨어진 오키나는 어깨를 떨구며 우울한 한숨을 내쉬었다.
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%……이라니, 그녀 데리고 온 거야」
			PRINTFORMW 오키나는 즐겁게 놀다 와, 하고 손을 흔들고 있다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
