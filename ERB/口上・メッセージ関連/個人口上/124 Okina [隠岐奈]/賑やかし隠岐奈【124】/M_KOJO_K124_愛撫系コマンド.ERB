		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			;射精した
			IF NOWEX:PLAYER:11
				PRINTFORML 「응, 쪽…… 푸하앗%UNICODE(0x2764)%」
				PRINTFORML 「아, %CALLNAME:MASTER%…… 그, 절대로 할 거야...? 그럼 그대로, 가버려줘……!%UNICODE(0x2764)%」
			ELSE
				PRINTFORML 「하아, 응츄, 음무우~~……읏」
				PRINTFORMW 「푸하앗, 하아... 하아... %CALLNAME:MASTER%……%UNICODE(0x2764)%」
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「츄릅, 주읍%UNICODE(0x2764)% 하아앗, 하아앗……%UNICODE(0x2764)%」
					PRINTFORMW 오키나는 정신없이 %조사처리(CALLNAME:MASTER,"의")% 입술을 탐하고 있다.
				CASEELSE
					PRINTFORML 「쪽……%UNICODE(0x2764)% 쪽, 쭉…… 후아%UNICODE(0x2764)%」
					PRINTFORMW 「이렇게 하고 있으니까…… 배 속 깊은 곳이 뜨거워지는구나……」
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			;射精した
			IF NOWEX:PLAYER:11
				PRINTFORML 「음읍!? 응, 쪽, 쭉, 푹흡!%UNICODE(0x2764)%」
				PRINTFORMW 「하아, 하아%UNICODE(0x2764)% 키스하면서는 안 된다고 했잖아……읏%UNICODE(0x2764)%」
			ELSE
				PRINTFORML 「츄읍, 음무앗... %UNICODE(0x2764)% ...위도 아래도 바쁘네... 후훗」
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「츄, 츄릅, 핥짝…… 주르륵, 쮸읍」
					PRINTFORMW 「푸하앗, 코, 연인도 아닌데, 이럴 수가…… 흐윽%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORML 「응구……!? 하아, 안 돼에……! ……하앗, 이 변태……!」
			ENDSELECT
			PRINTFORMDW 침입해 오는 %조사처리(CALLNAME:MASTER,"의")% 혀에 오키나는 몸을 떨었다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
