	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;睡眠中
	IF CFLAG:睡眠
		PRINTFORML 「푸아, 아……읏%UNICODE(0x2764)%」
		PRINTFORMW 오키나는 작게 신음하며, 꿈틀거리며 다리를 흔들고 있다….
		RETURN 1
		;時姦中
	ELSEIF FLAG:70
		PRINTFORML 주르륵, 천박한 소리를 내면서, 때로는 뿌리까지 물고, 때로는 귀두를 굴리듯 핥으며 %조사처리(CALLNAME:MASTER,"는")% 필사적으로 봉사한다.
		PRINTFORMW 머지않아 올 사정을 위해, 필사적으로 %조사처리(CALLNAME:MASTER,"는")% 입을 움직이며 계속했다……
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「안, 안 돼읏%UNICODE(0x2764)% 이런 건 너무 기분 좋아……읏%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"가")% 선사하는 쾌락에 완전히 빠져들고 있다.
			CASE 1
				PRINTFORML 「아앗, %CALLNAME:MASTER%읏, 더……크으윽%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 주어지는 쾌락에 자신도 모르게 허리를 움직이고 있다.
			CASE 2
				PRINTFORML 「잠, 잠깐만. 더 계속하면 좀 안 될 것 같아…」
				PRINTFORML 그것을 들은 %조사처리(CALLNAME:MASTER,"가")% 더욱 격렬하게 봉사하기 시작하자, 오키나는 당황한 듯 목소리를 높였다.
				PRINTFORMW 「힉!? 그, 그러니까 잠깐만이라고! 저, 나올 것 같단 말이야…윽%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「하, 하앗, 응으윽, 기분 좋아……읏%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 주어지는 쾌락에 자신도 모르게 허리를 움직이고 있다.
			CASE 1
				PRINTFORML 「잠, 잠깐만! 조금 더 천천히…… 윽, 크으윽%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 쾌락에 몸이 움츠러들고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
