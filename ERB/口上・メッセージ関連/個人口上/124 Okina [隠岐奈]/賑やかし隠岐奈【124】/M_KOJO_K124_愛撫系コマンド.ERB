@M_KOJO_MESSAGE_COM_K124_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;睡眠中
		IF CFLAG:睡眠
			PRINTFORML 
			;時姦中
		ELSEIF FLAG:70
			PRINTFORML 
		ELSE
			PRINTFORML 「아, 그게, 만지신다면, 부드럽게……」
			PRINTFORML 「익숙하지 않아요, 이런 거……」
			PRINTFORMW 오키나는 부끄러움에 뺨을 물들이고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;睡眠中
		IF CFLAG:睡眠
			PRINTFORML 「히으읏!? 아, %UNICODE(0x2764)% 응, 우우응%UNICODE(0x2764)%」
			PRINTFORMW 앞뒤로 흔들리면서 민감한 곳을 쓰다듬자 오키나는 잠이 들었음에도 몸을 비틀며 신음을 흘렸다……
			;時姦中
		ELSEIF FLAG:70
			PRINTFORML 애액으로 축축해진 오키나의 은밀한 곳에 페니스를 넣었다 빼기를 반복하며, %조사처리(CALLNAME:MASTER,"는")% 그녀의 클리토리스를 손가락으로 비빈다.
			PRINTFORML 그러자 질강은 민감하게 반응하며 큥큥하고 애틋하게 조여왔다.
			PRINTFORMW 사정을 유도하는 암컷의 꿀을 만끽하며, %조사처리(CALLNAME:MASTER,"는")% 오키나를 계속 가지고 놀았다……
			;射精した
		ELSEIF NOWEX:PLAYER:11
			PRINTFORML 「하아, 하아%UNICODE(0x2764)% 잔뜩 나왔네……?」
			PRINTFORMW 손을 잡고 키스를 갈망하며 얼굴을 가까이 가져가자, 오키나는 이끌리듯 먼저 혀를 섞어왔다….
			RETURN 1
		ELSE
			PRINTFORML 「히익, 응!? 잠깐, 그런 식으로 넣으면서라니엣%UNICODE(0x2764)% 아, 아아앗%UNICODE(0x2764)%」
			PRINTFORMW 연결된 채 민감한 곳을 희롱당하며 오키나는 사랑스러운 신음소리를 내고 있다...
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;睡眠中
		IF CFLAG:睡眠
			PRINTFORML 「히으읏!? 아, %UNICODE(0x2764)% 응, 우우응%UNICODE(0x2764)%」
			PRINTFORMW 앞뒤로 흔들리면서 민감한 곳을 쓰다듬자 오키나는 잠이 들었음에도 몸을 비틀며 신음을 흘렸다……
			;時姦中
		ELSEIF FLAG:70
			PRINTFORML 오키나의 항문에 페니스를 넣었다 빼기를 반복하며, %조사처리(CALLNAME:MASTER,"는")% 그녀의 유두를 손가락으로 주무른다.
			PRINTFORML 그러자 그 쾌감에 반응했는지 장벽이 더욱 좁아져 %조사처리(CALLNAME:MASTER,"의")% 성기를 압박해 왔다.
			PRINTFORMW 이미 여성기의 역할까지 해내는 항문을 만끽하며, %조사처리(CALLNAME:MASTER,"는")% 오키나를 계속 희롱했다…….
			;射精した
		ELSEIF NOWEX:PLAYER:11
			PRINTFORML 「하아, 하아%UNICODE(0x2764)% 잔뜩 나왔네……?」
			PRINTFORMW 손을 잡고 키스를 갈망하며 얼굴을 가까이 가져가자, 오키나는 이끌리듯 먼저 혀를 섞어왔다….
			RETURN 1
		ELSE
			PRINTFORML 「흐으윽, 이, 좋아읏%UNICODE(0x2764)% 기분 좋아읏%UNICODE(0x2764)%」
			PRINTFORMW 연결되면서 민감한 곳을 농락당하자 오키나는 색기 있게 몸을 비틀고 있다…
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;睡眠中
	IF CFLAG:睡眠
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「스으……응, 으음...%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「응…… 하아, 으윽……」
		ENDSELECT
		PRINTFORMW 오키나는 신음 섞인 잠꼬리를 하고 있다…….
		;時姦中
	ELSEIF FLAG:70
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 유감스럽게도, 오키나는 반응을 되돌려주지 않는다.
				PRINTFORML ……하지만 시간을 신경 쓰지 않고 마음껏 그녀를 어루만질 수 있다는 건 좋은 일이다.
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 오키나의 부드러운 피부와 육감을 즐기며, 세심하게 애무를 이어갔다….
			CASE 1
				PRINTFORML 절대 비신의 육체를 지극히 무례하게 농락한다.
				PRINTFORML 전율하는 금단의 감정에 휩싸여 그녀의 가슴을 주무르고, 유두를 만지며, 손끝으로 은밀한 곳을 문지른다.
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 자신도 모르게 미소를 띠면서 오키나에게 애무를 이어갔다….
		ENDSELECT
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응응…읏, 그만둬……그만해, 아아앗%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 쾌락에 자신도 모르게 신음하고 있다.
			CASE 1
				PRINTFORML 「기다려읏! 이제 됐으니까, 그, 싫단 말이야앗%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 거부하듯 %조사처리(CALLNAME:MASTER,"의")% 손을 잡지만, 전혀 힘이 들어가지 않는다.
			CASE 2
				PRINTFORML 「저, 거긴 만지지 마세요…아아앗!」
				PRINTFORMW 오키나는 쾌락을 참는 듯 눈을 감고 있다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 가볍게 음핵을 긁어주자, 오키나는 파르르 몸을 떨었다.
				PRINTFORMW 「아앗, 그만해! 거기는 약하니까…읏」
			CASE 1
				PRINTFORMW 「응읏, 기분 좋게라니……앗 %UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
