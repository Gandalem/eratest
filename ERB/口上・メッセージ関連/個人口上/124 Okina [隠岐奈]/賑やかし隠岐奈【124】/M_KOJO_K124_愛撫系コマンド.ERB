@M_KOJO_MESSAGE_COM_K124_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;睡眠中
		IF CFLAG:睡眠
			PRINTFORML 
			;時姦中
		ELSEIF FLAG:70
			PRINTFORML 
		ELSE
			PRINTFORML 「……엣!? 뭐, 뭐 하는 거야, 어? 그만둬, 제발!」
			PRINTFORML 오키나의 다리를 벌리고 그 비밀스러운 곳을 완전히 노출시키자, 그녀는 욕설과 함께 저항하기 시작했다.
			PRINTFORML 「바, 바보 같아! 무슨 생각 하는 거야, 더럽다고! 싫어, 그만둬읏!?」
			PRINTFORMW 살짝 혀로 자극을 주자, 점차 오키나의 저항은 잦아들었고, 비밀스러운 곳에서는 미끈거리는 점액이 흘러내리기 시작했다….
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			;睡眠中
			IF CFLAG:睡眠
				PRINTFORML 「푸아, 아……읏%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 작게 신음하며, 꿈틀거리며 다리를 흔들고 있다….
				;時姦中
			ELSEIF FLAG:70
				PRINTFORML 질내 사정 직후의 은밀한 곳은, 역시 쓰면서 비릿한 정액 맛이 섞여 있었다.
				PRINTFORMW 그러나 그 맛은 "%조사처리(CALLNAME:MASTER,"가")% 오키나에게 씨를 심었다"는 사실을 더 강하게 실감하게 했다.
			ELSE
				PRINTFORML 「방, 방금 끝냈는데도 잘 빨아주네, 너……」
				PRINTFORMW 오키나는 거친 숨을 죽이며 %조사처리(CALLNAME:MASTER,"의")% 봉사를 받아들이고 있다...
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;睡眠中
	IF CFLAG:睡眠
		PRINTFORML 「푸아, 아……읏%UNICODE(0x2764)%」
		PRINTFORMW 오키나는 작게 신음하며, 꿈틀거리며 다리를 흔들고 있다….
		RETURN 1
		;時姦中
	ELSEIF FLAG:70
		PRINTFORML 침을 가득 머금은 혀로, %조사처리(CALLNAME:MASTER,"는")% 오키나의 은밀한 곳을 정성껏 적신다.
		PRINTFORMW 끈기 있게 계속하자, 그녀의 단내 나는 구멍은 점차 삽입하기에 적합한 상태로 변해갔다….
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「윽, 잠깐만, 소리 내지 마아!」
				PRINTFORMW 「흐으... 아무리 그래도 부끄럽단 말이야! 아앗, 안 돼라고 했잖아...읏%UNICODE(0x2764)%」
			CASE 1
				PRINTFORMW 「흐으……응읏%UNICODE(0x2764)% 우우, 그렇게 집요하게 핥지 마…읏%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응... 크으윽... 마, 아직 하는 거야...?」
				PRINTFORMW 오키나는 부끄러운 듯 뺨을 물들이고 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
			CASE 1
				PRINTFORMW 「야앗!? 아, 다리 벌리지 말아줘……읏!」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
