@M_KOJO_MESSAGE_COM_K124_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;睡眠中
		IF CFLAG:睡眠
			PRINTFORML 
			;時姦中
		ELSEIF FLAG:70
			PRINTFORML 
		ELSE
			PRINTFORML 「아…… 넣는 거라면, 상냥하게…… 부탁해?」
			PRINTFORML 오키나의 질에 듬뿍 손가락을 밀어 넣자, 끈적한 체액이 서서히 손가락에 달라붙기 시작했다….
			PRINTFORMW 「크윽, 우응…… 익숙하지 않은 감각이네……」
		ENDIF
		RETURN 1
	ENDIF
	;睡眠中
	IF CFLAG:睡眠
		PRINTFORML 「크윽, 으응...!」
		PRINTFORMW 오키나는 은은하게 뺨을 물들이고 잠 못 이루는 듯 얼굴을 일그러뜨렸다.
		RETURN 1
		;時姦中
	ELSEIF FLAG:70
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 애액을 충분히 발라놓은 후, %조사처리(CALLNAME:MASTER,"는")% 두 번째 손가락을 삽입하고 오키나의 질을 뒤죽박죽 휘젓는다.
				PRINTFORML 페니스를 박아 넣었을 때와는 또 다른 물소리를 내면서, 질벽을 밀어내듯이 범하기를 계속한다.
				PRINTFORMW 너무 격렬해서 흩뿌려진 애액은 오키나의 허벅지를 더럽혔거나, 혹은 %조사처리(CALLNAME:MASTER,"의")% 손바닥을 축축하게 만들었다…….
			CASE 1
				PRINTFORML 이윽고 G스팟을 찾아내자, %조사처리(CALLNAME:MASTER,"는")% 토닥토닥 가볍게 두드리듯 손가락을 움직였다.
