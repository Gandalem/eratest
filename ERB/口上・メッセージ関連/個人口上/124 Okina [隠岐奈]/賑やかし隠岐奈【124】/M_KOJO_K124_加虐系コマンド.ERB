;==================================================
;108,乳スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K124_108
CALL M_KOJO_MESSAGE_COM_K124_108_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_108_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 오키나의 가슴을 향해 %조사처리(CALLNAME:MASTER,"는")% 손을 휘두른다.
				PRINTFORML 찰싹! 짝! 하고 타격 부위에 따라 다른 소리가 울리지만, 그 다양함이 재미있다.
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 몇 번이고 그녀의 가슴에 평수를 내렸다...
			CASE 1
				PRINTFORML 적당히 힘을 모아 오키나의 가슴을 손바닥으로 때린다.
				PRINTFORML 그러자 살이 부딪치는 소리가 울리고, 그녀의 가슴이 물결치듯 흔들렸다.
				PRINTFORMW 그 모습을 즐거워한 %조사처리(CALLNAME:MASTER,"는")% 반복해서 손을 휘저으며 그녀의 가슴을 놀렸다.
		ENDSELECT
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;それ以外
	ELSE
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			IF ABL:124:マゾっ気 >= 2
				IF TALENT:恋慕
					PRINTFORML 「아앗! 야, 히이잇%UNICODE(0x2764)%」
					PRINTFORML 「아야, 우아앗%UNICODE(0x2764)% 아, %CALLNAME:MASTER%윽, 아앙ッ%UNICODE(0x2764)%」
					PRINTFORMW 고통을 느끼고는 있으나, 그 이상으로 쾌락이 큰 듯하다. 오키나는 색기 있게 몸을 비틀며 이쪽의 열정을 부추겼다.
				ELSE
					PRINTFORML 「꺅, 히익%UNICODE(0x2764)% 아, 때리지 마아, 우앗%UNICODE(0x2764)%」
					PRINTFORMW 하반신과 상반신으로 성질이 다른 쾌락을 받으며 오키나는 귀여운 신음을 내고 있다.
				ENDIF
			ELSE
				IF TALENT:恋慕
					PRINTFORML 「아우윽, 아파! 어, 왜 이렇게……읏」
					PRINTFORML 「흐읍! 더… 더 상냥하게 해줬으면 좋겠는데……읏」
					PRINTFORMW 오키나는 마음을 품은 상대에게 괴롭힘당하며 눈에 눈물이 고여 있다.
				ELSE
					PRINTFORML 「쿠읏! 으윽! 너, 정말 그걸 안 하면 안 되는 거야!?」
					PRINTFORMW 오키나는 자신의 가슴을 집요하게 치는 %조사처리(CALLNAME:MASTER,"를")% "믿을 수 없다"는 듯한 눈으로 응시하고 있다.
				ENDIF
			ENDIF
		ELSE
			IF ABL:124:マゾっ気 >= 2
				IF TALENT:恋慕
					PRINTFORML 「앗, 싫어읏, 히익%UNICODE(0x2764)% 우아아읏%UNICODE(0x2764)%」
					PRINTFORML 「하아, 하아……%UNICODE(0x2764)% 더, 더……앗」
					PRINTFORMW 무심코 다음을 재촉하려던 오키나는 문득 정신이 들고 부끄러운 듯 얼굴을 돌렸다.
				ELSE
					PRINTFORML 「응우읏%UNICODE(0x2764)% 후후후, 너도 취향이 있구나…%UNICODE(0x2764)%」
					PRINTFORMW 오키나는 숨을 거칠게 몰아쉬며 도발적인 미소를 짓고 있다.
				ENDIF
			ELSE
				IF TALENT:恋慕
					PRINTFORML 「아파읏! 흐으, 네가 상대라고 해도... 이런 건 좀…….」
					PRINTFORMW 오키나는 복잡한 표정을 짓고 있다.
				ELSE
					PRINTFORML 「윽! 이, 사디스트 변태 같으니……!」
					PRINTFORMW 오키나는 원망스럽다는 듯 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다…….
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
