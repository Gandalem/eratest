;※※※※※※※※※※※※※※※※※※※※※※※※※
;
;屈服・服従系の追記をするときにまとめて書こうと思います
;（まだ服従も妄信も実装されてないみたいですが）
;現状実装されているのはスパンキング(100)、アイマスク(104)、縄(105)、拘束プレイ(107)、乳スパンキング(108)
;
;==================================================
;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K124_100
CALL M_KOJO_MESSAGE_COM_K124_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 결합부에서 울리는 질척이는 물소리에, 경쾌한 스팽킹 소리가 더해졌다.
					PRINTFORML %CALLNAME:MASTER%자신이 내뱉는 거친 숨소리까지 겹치며, 오키나를 범하고 있다는 사실이 귀를 통해 전해져 왔다.
					PRINTFORMW 이성을 완전히 놓아버린 %조사처리(CALLNAME:MASTER,"는")% 그저 필사적으로 그녀의 엉덩이를 때리고, 범하기를 계속했다….
				CASE 1
					PRINTFORML 피스톤 운동 도중, %조사처리(CALLNAME:MASTER,"는")% 불규칙한 리듬으로 오키나의 엉덩이를 손으로 때린다.
					PRINTFORML 그녀의 몸은 그럴 때마다 움찔하며 페니스를 조여와 자신에게 쾌락을 주었다.
					PRINTFORMW 오키나의 솔직한 반응에 우월감을 느끼며, %조사처리(CALLNAME:MASTER,"는")% 허리 움직임을 빠르게 해갔다……
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 크게 손바닥을 펼쳐 오키나의 엉덩이를 때리자, 짝! 하고 경쾌한 소리가 울렸다.
					PRINTFORML 과연 연예의 신답게 그녀 자신의 몸도 악기처럼 일품인 모양이다.
					PRINTFORMW ……라며 농담을 생각하면서 %조사처리(CALLNAME:MASTER,"는")% 열성적으로 그녀의 엉덩이를 계속 때려댔다.
				CASE 1
					PRINTFORML 짝! 짝! 하며 상태를 확인하듯 %조사처리(CALLNAME:MASTER,"는")% 오키나의 엉덩이를 몇 번 때린다.
					PRINTFORML 탄력보다는 부드러움에 중점을 둔 그녀의 엉덩이였지만, 때리니 정말 좋은 소리가 난다. 버릇이 될 것 같다.
					PRINTFORMW 시간이 멈춘 세계에서는 불평할 일도 없다. %조사처리(CALLNAME:MASTER,"는")% 시원할 때까지 스팽킹을 계속했다…….
			ENDSELECT
		ENDIF
		;睡姦中はできないみたいですね…残念…
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;それ以外
	ELSE
		;V挿入orA挿入中
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			IF ABL:124:マゾっ気 >= 2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「앗, 히으읏! 그, 그만해… 아아악%UNICODE(0x2764)%」
						PRINTFORML 「이렇게 많이 맞으면%UNICODE(0x2764)% 응, 이상한 기분이 들어……. 음으으읏%UNICODE(0x2764)%」
						PRINTFORMW 엉덩이에 손바닥을 맞는 순간마다 오키나는 두근두근거리며 %조사처리(CALLNAME:MASTER,"의")% 페니스를 조였다….
					CASE 1
						PRINTFORML 「아앗%UNICODE(0x2764)% は앗, 야읏, 히우우읏%UNICODE(0x2764)%」
						PRINTFORML 맞고 범해지면서도 교성을 내는 오키나의 귓가에, %조사처리(CALLNAME:MASTER,"는")% 욕설을 속삭였다.
						PRINTFORMW 「치, 치가우%UNICODE(0x2764)% わ, 나는 마조히스트 같은 게……히아앗%UNICODE(0x2764)%%UNICODE(0x2764)%」
				ENDSELECT
				;マゾではない
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「야, 그만둬! 누구에게 그런 걸 하는 거야!!」
						PRINTFORML 「힉, 아으윽, 안 돼... 쿠욱...!」
						PRINTFORMW 오키나는 고통과 쾌감이 뒤섞인 복잡한 표정으로 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
					CASE 1
						PRINTFORML 「햣! 아앗! 야, 너 취향 이상한 거 아니야!?」
						PRINTFORMW 엉덩이를 맞을 때마다 몸을 움찔거리며 오키나는 항의의 목소리를 높였다.
				ENDSELECT
			ENDIF
		ELSE
			IF ABL:124:マゾっ気 >= 2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「언제, 아우윽! 너, 이 나에게 이런 걸… 히으읏%UNICODE(0x2764)%」
						PRINTFORML (크, 크윽! 이렇게 맞고 있는데, 어째 몸이 뜨거워지는 거지…)
						PRINTFORMW 오키나는 거친 숨을 내쉬며 자신의 안에서 솟아오르는 쾌락에 동요하고 있다.
					CASE 1
						PRINTFORML 「하아앗%UNICODE(0x2764)% 윽, 그렇게 많이 때려도 질리지 않아? 후훗, 우와아앗%UNICODE(0x2764)%」
						PRINTFORMW 오키나는 도발적인 미소를 짓고 있지만, 표정에서 틀림없이 욕정을 드러내고 있음이 느껴진다...
				ENDSELECT
				;マゾではない
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「히윽! 그, 그만해…… 이봐, %CALLNAME:MASTER%읏!!」
						PRINTFORMW 「내 엉덩이를 좋아하는 건 알겠지만, 그렇게 세게 때리진 마!」
					CASE 1
						PRINTFORML 「힉앗!? 그, 때리지 마! 바보 같아!」
						PRINTFORMW 엉덩이를 맞는 매번 몸을 움찔거리며, 오키나는 항의의 목소리를 높였다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
