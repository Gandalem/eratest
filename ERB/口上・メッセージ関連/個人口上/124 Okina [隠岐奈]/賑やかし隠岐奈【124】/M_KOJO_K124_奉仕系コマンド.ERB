@M_KOJO_MESSAGE_COM_K124_80
CALL M_KOJO_MESSAGE_COM_K124_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
		ELSEIF CFLAG:睡眠
		ELSE
			PRINTFORMW 「아, 아…… 절대로 비신인 이 나한테 손으로 해달라고……!?」
			PRINTFORML 「……응. 알았어……. 하면 되는 거지…」
			PRINTFORML 오키나는 결심한 듯 %조사처리(CALLNAME:MASTER,"를")% 올려다보았다……
			PRINTFORMW 「하지만…… 누구에게도 말하지 마……? 비밀이야……」
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		IF NOWEX:PLAYER:射精
			PRINTFORML 자궁이나 얼굴이 아니라, 손에 사정하는 것도 나쁘지 않을 거야.
			PRINTFORMW 선행액으로 미끌미끌해진 오키나의 손을 사용해서, %조사처리(CALLNAME:MASTER,"는")% 마지막 스퍼트를 올렸다.
		ELSE
			PRINTFORML 오키나의 손바닥에 귀두를 밀어 넣듯이, 유연한 손가락에 음경을 감싸듯 %조사처리(CALLNAME:MASTER,"는")% 허리를 움직인다.
			PRINTFORML 핸드조이와는 사뭇 다른 이 행위는 직접적인 쾌락보다는 정신적인 흥분을 자극한다.
			PRINTFORMW 흘러나온 쿠퍼액을 문지르면서, 그녀의 어느 부위를 정액으로 더럽힐지 %조사처리(CALLNAME:MASTER,"는")% 생각하기 시작했다……
		ENDIF
		RETURN 1
		;睡眠中
	ELSEIF CFLAG:睡眠
		PRINTFORML 「응……?」
		PRINTFORML 자신에게 닿아 있는 것을, 오키나는 반사적으로 꽉 움켜쥐었다.
		PRINTFORMW 예기치 못한 자극에 %조사처리(CALLNAME:MASTER,"는")% 무심코 신음을 흘리고 말았다…….
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF NOWEX:PLAYER:射精
			PRINTFORML 「응… 싸겠구나? 후훗, 그렇구나」
			PRINTFORML 「제대로 받아줄 테니까, 그대로 기분 좋게 해줘…%UNICODE(0x2764)%」
			PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"를")% 능숙하게 사정에까지 이끌어낸 것에 안도하는 듯하다.
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")%, 사정하고 싶어지면 말하라고 했잖아?」
					PRINTFORMW 오키나는 얼굴을 새빨갛게 물들이며, %조사처리(CALLNAME:MASTER,"가")% 기분 좋도록 페니스를 다루고 있다.
				CASE 1
					PRINTFORML 「이렇게 떨게 만들다니…… 완전히 다른 생물 같군…」
					PRINTFORMW 오키나는 볼을 물들이며, 자신의 손안에 있는 단단함을 만지고 있었다.
				CASE 2
					PRINTFORML 「에? 더 세게 쥐어줬으면 좋겠는데...?」
					PRINTFORML 「그, 어쩔 수 없네! 자, 이 정도 힘 조절로 괜찮아?」
					PRINTFORMW 얼굴을 새빨갛게 물들인 오키나는 %조사처리(CALLNAME:MASTER,"의")% 페니스를 부끄러워하며 꽉 움켜쥐었다.
			ENDSELECT
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			PRINTFORML 「……아, 나가는구나……? 다행이야……」
			PRINTFORML 「이대로 싸도 괜찮아...? 마음껏 기분 좋아져 봐……」
			PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"를")% 능숙하게 사정까지 이끌어낸 것에 안도하는 듯하다.
		ELSE
			PRINTFORML 「……영상 같은 거로는 자주 봤는데…… 근데 설마, 실제로 하게 될 줄은 몰랐어……」
			PRINTFORMW 자위행을 계속하는 오키나의 표정에는 불안감이 가득하다…….
		ENDIF
	ENDIF
ENDIF
RETURN 1
