@M_KOJO_MESSAGE_COM_K124_82
CALL M_KOJO_MESSAGE_COM_K124_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORML 그녀의 가슴을 손으로 모으며 적당한 압박감을 주면서 허리를 움직인다.
		PRINTFORML 쿠퍼액으로 미끌거리는 골짜기는 정자를 뿌리기에 딱이다.
		PRINTFORMW 시간을 멈추기 직전 표정 그대로 굳어 있는 오키나를 바라보며, %조사처리(CALLNAME:MASTER,"는")% 욕망대로 그녀를 범했다.
		RETURN 1
		;睡眠中
	ELSEIF CFLAG:睡眠
		PRINTFORML 오키나의 부드러운 가슴골 사이로, %조사처리(CALLNAME:MASTER,"의")% 귀두가 반복해서 얼굴을 내민다.
		PRINTFORML 「우으……」
		PRINTFORMW 매우 자극적인 광경을 즐기면서도, 못생긴 표정의 오키나를 무시하고 허리를 계속 움직였다…….
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 오키나는 자신의 쌍봉을 두 손으로 모아 %조사처리(CALLNAME:MASTER,"의")% 페니스를 끼워 비비고 있다.
				PRINTFORMW 「후훗, %CALLNAME:MASTER%, 허리가 들렸어? 그렇게 기분 좋은 거야...?」
			CASE 1
				PRINTFORML 「하아… 하아… 응, 어때? 잘 하고 있나?」
				PRINTFORMW 「……후후, 제대로 느끼는 것 같네. 가슴속에서 파르르 떨고 있어%UNICODE(0x2764)%」
			CASE 2
				PRINTFORML 「하아, 하아, 응읏, 우으윽%UNICODE(0x2764)%」
				PRINTFORMW 「후우, 이렇게 단단하게 해주면 나도 흥분해버릴 것 같아…응읏%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「하아... 하아... 흠, 어때? 잘 하고 있나?」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
