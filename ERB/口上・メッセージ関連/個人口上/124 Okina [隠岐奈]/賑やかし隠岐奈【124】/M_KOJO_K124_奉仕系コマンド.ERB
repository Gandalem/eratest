@M_KOJO_MESSAGE_COM_K124_81
CALL M_KOJO_MESSAGE_COM_K124_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
		ELSEIF CFLAG:睡眠
		ELSE
			PRINTFORML 「안, 안 돼. 그것만은……!! 절대로 안 돼……!」
			PRINTFORML 오키나는 얼굴을 손으로 가리고 부르르 떨며 고개를 저었다.
			PRINTFORMW 하지만 %조사처리(CALLNAME:MASTER,"의")% 손가락 틈 사이로 자신을 바라보는 시선을 놓치지 않았다.
			PRINTFORML 
			PRINTFORML 「흐으윽……! 나, 나는 대현자라고, 위대한 존재라구……!!」
			PRINTFORML 「이런, 인간 따위의 성기를…… 빨아…… 넣는 건…… 말이야」
			PRINTFORML 그렇게 말하면서도 오키나는 점점 참지 못하는 듯했다.
			PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"에게")% 등을 돌리게 하고 백도어를 열자, 문을 통해 봉사를 시작했다…….
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			IF TALENT:恋人
				PRINTFORML 예전에 오키나가 「좋아하는 사람의 정액이라도 맛없는 건 맛없다」고 투덜댔던 게 생각난다.
				PRINTFORMW 하지만 실제로 마실 때는 황홀해 하는 것이 그녀의 습성이기에, %조사처리(CALLNAME:MASTER,"는")% 주저 없이 구강 사정을 하게 되었다.
			ELSE
				PRINTFORML 평소부터 거만하고 오만한 그녀에게, 억지로 정액을 마시게 하는 이 행위에 %조사처리(CALLNAME:MASTER,"는")% 끝없는 우월감을 느낀다.
				PRINTFORML 시간을 멈춘 것을 해제하면, 대체 어떤 반응을 보여줄까?
				PRINTFORMW 흥분과 쾌락에 몸을 맡기고, %조사처리(CALLNAME:MASTER,"는")% 드디어 오키나의 입안에 사정했다.
			ENDIF
		ELSE
			PRINTFORML 시간을 멈춘 상태이기에 물릴 걱정도 없어서, %조사처리(CALLNAME:MASTER,"는")% 천천히 오키나의 입안을 탐색한다.
			PRINTFORML 구강은 질내를 연상시키는 따뜻함과 액체로 가득 차 있지만, 단단하고 매끄러우며 거친 치아와 혀의 감촉은 특유한 것이었다.
			PRINTFORMW 충분히 그녀의 입을 만끽한 %조사처리(CALLNAME:MASTER,"는")%, 드디어 쾌락을 얻기 위해 허리를 흔들기 시작했다……
		ENDIF
		RETURN 1
		;睡眠中
	ELSEIF CFLAG:睡眠
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			PRINTFORML 「응쿠읏, 줄루, 무우읏!!」
			PRINTFORMW 괴로워하는 듯 신음하는 오키나의 머리를 눌러, %조사처리(CALLNAME:MASTER,"는")% 크게 몸을 떨었다.
		ELSE
			PRINTFORML 「흐읍, 응으으윽…읏」
			PRINTFORMW 입가에서 침을 흘리며 오키나는 괴로운 듯 얼굴을 일그러뜨리고 있다….
		ENDIF
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			PRINTFORML 「응, 주푸읏… 주포, 구폿…%UNICODE(0x2764)%」
			PRINTFORML 열심으로 페라치오를 계속하는 오키나에게 %조사처리(CALLNAME:MASTER,"는")% 사정이 임박했음을 전한다.
			PRINTFORMW 그러자 그녀는 「이대로 싸도 돼」라고 눈을 위로 향한 채 신호를 보내고, %조사처리(CALLNAME:MASTER,"의")% 페니스를 뿌리까지 깊숙이 물었다.
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「훗, 후우윽…………응, 으윽…………」
					PRINTFORML 「이렇게 하면… 기분 좋겠지? 응?」
					PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"의")% 허리를 감싸 안고, 사랑스럽게 페니스에 봉사하고 있다.
				CASE 1
					PRINTFORML 「후우… 응, 음…… 쪽쮸욱」
					PRINTFORML 「핥짝, 음…… 우응, 응…앗%UNICODE(0x2764)%」
					PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"의")% 성기를 정성껏 빨고 있다.
				CASE 2
					PRINTFORML 오키나는 입가에서 침을 흘리며 %조사처리(CALLNAME:MASTER,"에게")% 봉사하고 있다…….
					PRINTFORML 「쭈파……응읏…쭈읍%UNICODE(0x2764)% 음무……푸하앗!」
					PRINTFORMW 「하아……하아……%CALLNAME:MASTER%, 어때, 제대로 기분 좋아지고 있니…?」
			ENDSELECT
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			PRINTFORML 「음무, 르로, 츄루루……」
			PRINTFORMW 자잘하게 혀를 사용해 봉사하는 오키나의 행위에, %조사처리(CALLNAME:MASTER,"는")% 드디어 사정감을 참지 못하게 되었다.
		ELSE
			PRINTFORML 「훗, 후우윽…… 응, 으윽……」
			PRINTFORMW 오키나는 황홀한 표정으로 %조사처리(CALLNAME:MASTER,"에게")% 봉사를 계속하고 있다…….
		ENDIF
	ENDIF
ENDIF
RETURN 1
