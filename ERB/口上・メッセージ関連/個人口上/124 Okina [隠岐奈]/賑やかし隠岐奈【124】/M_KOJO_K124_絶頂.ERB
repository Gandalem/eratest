@M_KOJO_MESSAGE_PALAMCNG_B2_K124
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「앗%UNICODE(0x2764)% ………응, 하아……하아……」
		CASE 1
			PRINTFORML 「흐으윽! 하아……%UNICODE(0x2764)%」
		CASE 2
			PRINTFORML 「햐앗! 응우……으윽……%UNICODE(0x2764)%」
	ENDSELECT
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	SELECTCASE RAND:2
		CASE 0
			PRINTFORML 「응응………%UNICODE(0x2764)%」
			PRINTFORML 방광이 느슨해진 오키나는 그대로 실수를 해버렸다….
		CASE 1
			PRINTFORML 「후아………%UNICODE(0x2764)%」
			PRINTFORML 오키나는 기분 좋게 잠들어 있다. 아무래도 방뇨감이 편안한 듯하다.
	ENDSELECT
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:四重絶頂
			;Ｃ＆Ｖ＆Ａ＆Ｂ絶頂
			CASE 1
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ａ＆Ｍ絶頂
			CASE 2
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ｂ＆Ｍ絶頂
			CASE 3
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 4
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 5
				PRINTFORMW 
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「앗, ~~~읏!?」
				PRINTFORML 오키나는 움찔하며 몸을 크게 떨었지만…… 아직 자고 있는 듯하다.
			CASE 1
				PRINTFORML 「힉, 크, 우으으윽%UNICODE(0x2764)%」
				PRINTFORML 흐트러지게 침을 흘리며 오키나는 벌벌 떨고 경련하고 있다……।
			CASE 2
		ENDSELECT
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「핫%UNICODE(0x2764)% 흐읍…… 응아아……읏%UNICODE(0x2764)%」
				PRINTFORML 신음 소리를 내며, 오키나는 몸을 파르르 떨고 있다.
			CASE 1
				PRINTFORML 「응 아아앗%UNICODE(0x2764)% 아, 하아아…읏%UNICODE(0x2764)%」
				PRINTFORML 신음 소리를 내면서 오키나는 몸을 파르르 떨고 있다.
		ENDSELECT
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
	IF NOWEX:Ｃ絶頂
		;超強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 == 3
			PRINTFORML 「흐으윽! 후, 아아……읏%UNICODE(0x2764)%」
			PRINTFORML 오키나는 자고 있음에도 불구하고 절정에 다다른 모양이다.
			;強絶頂Ｃ
		ELSEIF NOWEX:Ｃ絶頂 == 2
			PRINTFORML 「헉, 아아…… %UNICODE(0x2764)%」
			;絶頂Ｃ
		ELSE
			PRINTFORML 「흣, 우응……읏!」
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;超強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 == 3
			PRINTFORML 「아아앗%UNICODE(0x2764)% 하아... 아...읏%UNICODE(0x2764)%」
			;強絶頂Ｖ
		ELSEIF NOWEX:Ｖ絶頂 == 2
			PRINTFORML 「흐윽, 아아……읏%UNICODE(0x2764)%」
			;絶頂Ｖ
		ELSE
			PRINTFORML 「응, 응으윽……!」
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;超強絶頂Ａ
		IF NOWEX:Ａ絶頂 == 3
			PRINTFORML 「~~~~읏%UNICODE(0x2764)% 후아, 하아, 하아아……읏%UNICODE(0x2764)% 」
			;強絶頂Ａ
		ELSEIF NOWEX:Ａ絶頂 == 2
			PRINTFORML 「히으윽%UNICODE(0x2764)% 응, 크으… 스으……」
			;絶頂Ａ
		ELSE
			PRINTFORML 「흐읍...!?」
		ENDIF
	ENDIF
