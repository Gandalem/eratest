@M_KOJO_MESSAGE_PALAMCNG_B_K124
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	;時姦中
	IF FLAG:70
	ELSE
		PRINTFORML 「아앗, 나올 것 같아읏!!」
	ENDIF
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	;時姦中
	IF FLAG:70
	ELSEIF TCVAR:124:泥酔 == 1
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「하아앗, 갈 것 같아……!%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「후우읏, 아앗%UNICODE(0x2764)% 하고, 나올 것 같아아%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 2
				PRINTFORML 「아앗%UNICODE(0x2764)% 안돼읏, 나올 것 같아……ッ%UNICODE(0x2764)%」
			CASE 3
				PRINTFORML 「하앗, 하앗%UNICODE(0x2764)% %CALLNAME:MASTER%읏, 나온다……윽%UNICODE(0x2764)%」
		ENDSELECT
	ENDIF
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	;時姦中
	IF FLAG:70
	ELSE
		PRINTFORML 「에, 싫, 싫어앗!? 그런 거, 나……읏」
		PRINTFORMW 「히으윽, 싫단 말이야아, 그만 못하겠어…읏」
	ENDIF
ENDIF
;-------------------------------------------------
;絶頂
;一部、怒涛の勢いで%UNICODE(0x2764)%が入ってますので、鬱陶しかったら消して下さいね
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:四重絶頂
			;Ｃ＆Ｖ＆Ａ＆Ｂ絶頂
			CASE 1
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ａ＆Ｍ絶頂
			CASE 2
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｖ＆Ｂ＆Ｍ絶頂
			CASE 3
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 4
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ａ＆Ｂ＆Ｍ絶頂
			CASE 5
				PRINTFORMW 
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;時姦中
		IF FLAG:70
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「안 돼읏, 이상해지겠어앗%UNICODE(0x2764)% 아, 변해버릴 것 같아읏%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORML 「하아앗%UNICODE(0x2764)% 갈, 갈 것 같아읏%UNICODE(0x2764)%%UNICODE(0x2764)% 아아아아아―――――앗%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
				CASE 1
					PRINTFORML 「아, 아냐! 그만해읏 무리야... 너무 격렬해... 안돼앗 이구우우윽%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORML 「흡, 아아아~~ッ%UNICODE(0x2764)% 하앗... 아, 하아아아………ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
				CASE 2
					PRINTFORML 「앗, 아아앙%UNICODE(0x2764)% 굉장해읏, 기분 좋아욧%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)% 아아아~~%UNICODE(0x2764)%%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;時姦中
		IF FLAG:70
		ELSE
			;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
			;[SKIPSTART]
			SELECTCASE NOWEX:二重絶頂
				;Ｃ＆Ｖ絶頂
				CASE 1
					PRINTFORML 「히이잉! 히익, 하아, 하앗...%UNICODE(0x2764)%」
					PRINTFORMW 「우으음... 부끄러우니까, 보지 마……」
					RETURN 1
					;Ｃ＆Ａ絶頂
				CASE 2
					PRINTFORML 「아, 아아앗, 가버릴 것 같아……%UNICODE(0x2764)%」
					PRINTFORML 「응앗, 하앗, 하앗………윽, 치욕이야…… 우으……」
					RETURN 1
					;Ｖ＆Ａ絶頂
				CASE 3
					PRINTFORML 「아, 아아앗! 싫어, 갔, 크으윽...!!%UNICODE(0x2764)%」
					PRINTFORML 「응앗, 하앗, 하앗…… 우우…… 앞에서도 뒤에서도 당하고, 이렇게…… 우우우~」
					RETURN 1
					;Ｃ＆Ｂ絶頂
				CASE 4
					PRINTFORML 「흐으응! 히이, 하아, 하앗…%UNICODE(0x2764)%」
					PRINTFORMW 「우으…… 이, 이런…… 야한 일을... 내가 아아…읏」
					RETURN 1
					;Ｖ＆Ｂ絶頂
				CASE 5
					PRINTFORML 「흐으응! 히이, 하아, 하앗…%UNICODE(0x2764)%」
					PRINTFORMW 「음아…… %CALLNAME:MASTER%…… 좋아해……」
					RETURN 1
					;Ａ＆Ｂ絶頂
				CASE 6
					PRINTFORML 「아, 아아앗, 가버릴 것 같아……%UNICODE(0x2764)%」
					PRINTFORML 「응앗, 하앗, 하앗………윽, 치욕이야…… 우으……」
					RETURN 1
					;Ａ＆Ｍ絶頂
				CASE 7
					PRINTFORMW 「힉, 갈 것 같아……!! 응아앗, 하앗, 하아앗%UNICODE(0x2764)%」
					RETURN 1
					;Ｖ＆Ｍ絶頂
				CASE 8
					PRINTFORML 「흐으응! 히익, 하아, 하앗...%UNICODE(0x2764)%」
					PRINTFORMW 「우으윽……… 너무 기분 좋아서 이상해져 버릴 것 같아……」
					RETURN 1
					;Ｃ＆Ｍ絶頂
				CASE 9
					PRINTFORMW 「힉, 갈 것 같아……!! 응아앗, 하앗, 하아앗%UNICODE(0x2764)%」
					RETURN 1
					;Ｂ＆Ｍ絶頂
				CASE 10
					PRINTFORML 「흐으응! 힉, 하아, 하앗……%UNICODE(0x2764)%」
					PRINTFORMW 「우으음…… 이, 이런…… 야한 걸… 내가 아앗……읏」
					RETURN 1
			ENDSELECT
		ENDIF
		;[SKIPEND]
	ENDIF
	IF NOWEX:Ｃ絶頂
		;時姦中
		IF FLAG:70
		ELSE
			;超強絶頂Ｃ
			IF NOWEX:Ｃ絶頂 == 3
				PRINTFORML 「히으읏, 기분 좋아앗%UNICODE(0x2764)% 하아앗……읏%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 몸을 크게 뒤로 빼고 파르르 떨며 경련하고 있다…….
				;強絶頂Ｃ
			ELSEIF NOWEX:Ｃ絶頂 == 2
				PRINTFORML 「아아아앗……!! 하앗……하앗……! 」
				PRINTFORML 오키나는 허리를 파르르 떨고 있다…….
				;絶頂Ｃ
			ELSE
				PRINTFORML 「하아앗…… 아으윽…… 이, 이렇게……」
				PRINTFORML 오키나는 절정에 이르러 온 수치심에 몸을 떨고 있다.
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂
		;時姦中
		IF FLAG:70
		ELSE
			;超強絶頂Ｖ
			IF NOWEX:Ｖ絶頂 == 3
				PRINTFORML 「히익, 아앗…… 크으으으윽~~~~~!!%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 너무나도 큰 쾌감에 목소리를 잃고 절정에 달하고 있다….
				;強絶頂Ｖ
			ELSEIF NOWEX:Ｖ絶頂 == 2
				PRINTFORML 「파아앗%UNICODE(0x2764)%%UNICODE(0x2764)% 어, 깊숙한 곳이 와버릴 것 같아……읏!!」
				PRINTFORMW 오키나는 유난히 크게 몸을 떨며 절정에 달했다.
				;絶頂Ｖ
			ELSE
				PRINTFORML 「하응, 하, 아앗%UNICODE(0x2764)% 크으윽……」
				PRINTFORMW 오키나는 절정에 견디지 못하고 벌벌 떨고 있다….
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;時姦中
		IF FLAG:70
		ELSE
			;超強絶頂Ａ
			IF NOWEX:Ａ絶頂 == 3
				PRINTFORML 「꺅%UNICODE(0x2764)%좋아, 엉덩이 기분 좋아%UNICODE(0x2764)%갈 것 같아%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 전신을 파르르 떨며 절규하고 있다.
				;強絶頂Ａ
			ELSEIF NOWEX:Ａ絶頂 == 2
				PRINTFORML 「오, 오시리 기분 좋아읏, 아앗%UNICODE(0x2764)%가아앗%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 완전히 쾌락에 솔직해져 버렸다.
				;絶頂Ａ
			ELSE
				PRINTFORML 「오, 엉덩이 따위가 기분 좋긴 어……읏!!」
				PRINTFORMW 오키나는 굴욕적인 쾌락에 몸을 떨며 파르르 떨고 있다.
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;時姦中
		IF FLAG:70
		ELSE
			;強絶頂Ｂ
			IF NOWEX:Ｂ絶頂 == 3
				PRINTFORML 「이야앗, 갈 것 같아%UNICODE(0x2764)%하아앙!%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 양쪽 가슴을 떨며 등을 아치형으로 만들고 절정에 이르렀다.
				;強絶頂Ｂ
			ELSEIF NOWEX:Ｂ絶頂 == 2
				PRINTFORML 「후아아……%UNICODE(0x2764)% 우으……%UNICODE(0x2764)%」
				PRINTFORMW 오키나는 평소에는 절대 보이지 않는 표정으로 떨고 있다…….
				;絶頂Ｂ
			ELSE
				PRINTFORML 「우, 우아…… 하아, 이, 이런 거 없어……읏」
				PRINTFORMW 오키나는 유두가 발기한 채 얼굴을 새빨갛게 돌렸다…….
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂
		;時姦中
		IF FLAG:70
		ELSE
			;超強絶頂Ｍ
			IF NOWEX:Ｍ絶頂 == 3
				PRINTFORML 「히익, 구우욱%UNICODE(0x2764)% 하앗, 하아아……핫, 우아아……읏%UNICODE(0x2764)%」
				PRINTFORMW 절정에 이른 오키나는 입에서 흐르는 침을 그대로 흘린 채 거친 숨을 내쉬며 몸을 떨고 있다.
				;強絶頂Ｍ
			ELSEIF NOWEX:Ｍ絶頂 == 2
				PRINTFORML 「윽, 응으…… 헉, 하아, 우으……읏」
				PRINTFORMW 오키나는 새빨개진 얼굴로 거친 숨을 내쉬며 입가에 흘러내린 침을 닦아냈다.
				;絶頂Ｍ
			ELSE
				PRINTFORML 「응쿠읏, 응읏…… 하, 하아…앗」
				PRINTFORMW 오키나는 입안의 자극으로 가볍게 절정에 다다른 듯하다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
