@M_KOJO_MESSAGE_SCOM_K124_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORML 아무리 신이라고 해도, 인간의 암컷의 모습을 하고 있다면 당연히 이 부위는 성감대다.
		PRINTFORML 거칠거친 표면을 %조사처리(CALLNAME:MASTER,"가")% 집요하게 문지르자, 오키나는 순식간에 애액을 흘리기 시작했고 질벽은 경련을 반복한다.
		PRINTFORMW 그녀의 무의식적이지만 솔직한 반응에 기분이 좋아진 %조사처리(CALLNAME:MASTER,"는")% 몇 번이고 허리를 흔들며 쾌락을 선사했다.
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 「응으윽……히, 윽……아……응읏」
		PRINTFORMW 오키나의 약점을 자잘하게 파고들자, 쾌감에 몸을 떨며 그녀의 질이 %조사처리(CALLNAME:MASTER,"의")% 페니스를 조여 왔다
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「힉, 우아앗!? 마, 잠깐만, 거긴... 거기서 아아앗%UNICODE(0x2764)%」
				PRINTFORMW 「그, 그만해, 그만두라고...ッ%UNICODE(0x2764)%그리구리당하면 이상해질 것 같아...ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「히익!? 아, 잠깐만 잠깐만 잠깐만으읏%UNICODE(0x2764)%」
				PRINTFORMW 「기분 좋으니까 기분 좋으니까 그만해줘어…ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 2
				PRINTFORML 「아아앗! %CALLNAME:MASTER%읏, 거기, 거기로오옷%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORML 「히으윽%UNICODE(0x2764)% 더, 더 문질러줘어엣읏%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 3
				PRINTFORML 「아앗, 저, 좋아읏%UNICODE(0x2764)% 거기, 더, 더 해줘… 으, 아아아아……읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORML 「응ぅ, 하아앗%UNICODE(0x2764)% %CALLNAME:MASTER%, %CALLNAME:MASTER%……읏%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORML 「히익!? 거, 거기라니, 아아아앗!!%UNICODE(0x2764)%」
				PRINTFORML 「아, 하으윽, 그, 거긴 안 돼!%UNICODE(0x2764)% 어, 이상해져버릴 것 같아……%UNICODE(0x2764)%%UNICODE(0x2764)%」
		ENDSELECT
		PRINTFORMW 집요하게 약점을 공격당하며, 오키나는 비명에 가까운 가냘픈 신음을 내며 쾌락에 몸을 떨고 있다.
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「히익, 뭐, 뭐야, 이... 히아아앗!?」
				PRINTFORML 「잠, 잠깐만요! 잠시, 제발 그만둬에엣%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORML 「뭐, 뭐야!? 이거 기분 좋아...읏 야, 싫어어%UNICODE(0x2764)%」
		ENDSELECT
		PRINTFORMW 집요하게 약점을 공격당하자, 오키나는 비정상적일 정도로 몸을 떨며 쾌락에 몸부림치고 있다.
	ENDIF
ENDIF
RETURN 1
