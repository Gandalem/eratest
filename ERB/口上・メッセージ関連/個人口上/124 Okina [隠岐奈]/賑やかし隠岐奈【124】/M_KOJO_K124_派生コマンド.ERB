@M_KOJO_MESSAGE_SCOM_K124_3
CALL M_KOJO_MESSAGE_SCOM_K124_3_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K124_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
		;恋慕or恋人
		IF TALENT:124:恋人 || TALENT:124:恋慕
			IF EXP:124:Ｖ経験 > 50
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「힉, 우아앗!? 마, 잠깐만, 거긴... 거기서 아아앗%UNICODE(0x2764)%」
						PRINTFORMW 「그, 그만해, 그만두라고...ッ%UNICODE(0x2764)%그리구리당하면 이상해질 것 같아...ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
					CASE 1
						PRINTFORML 「히익!? 아, 잠깐만 잠깐만 잠깐만으읏%UNICODE(0x2764)%」
						PRINTFORMW 「기분 좋으니까 기분 좋으니까 그만해줘어…ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
					CASEELSE
						PRINTFORML 「아아앗! %CALLNAME:MASTER%읏, 거기, 거기로오옷%UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORML 「히으윽%UNICODE(0x2764)% 더, 더 문질러줘어엣읏%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
				ENDSELECT
			ENDIF
		ELSE
			PRINTFORML 「아아앗…읏!? %CALLNAME:MASTER%읏, 무, 뭔가… 이상한 곳에 닿고 있어어……읏%UNICODE(0x2764)%」
		ENDIF
		;それ以外
	ELSE
		IF EXP:124:Ｖ経験 > 50
			PRINTFORML 「히익!? 아, 잠깐만 잠깐만 잠깐만엣%UNICODE(0x2764)%」
			PRINTFORMW 「기분 좋으니까 그만해줘... 기분 좋으니까 그만하라고…ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
		ELSE
			PRINTFORML 「힉…… 아, 아아……!」
			PRINTFORMW 오키나의 약점을 건드릴 때마다 %조사처리(CALLNAME:MASTER,"의")% 팔을 움켜쥐는 힘이 강해진다.
		ENDIF
	ENDIF
ENDIF
