@M_KOJO_MESSAGE_SCOM_K124_14_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		;A感覚Lv3以下andA経験100以下
		IF ABL:124:2 < 3 && EXP:124:Ａ経験 < 100
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 허리를 움직이며, 딱 대장이 구불구불한 부분... S상결장을 반복해서 찔러댔다.
			PRINTFORMW 오키나의 장벽은 익숙하지 않은 자극에 당황한 듯한 반응을 보이지만, 언젠가는 받아들이게 될 것이다.
		ELSE
			PRINTFORML 막다른 곳의 장벽을 향해 가늘게 노크를 반복하자, 쾌감을 느끼고 있는 걸까, 오키나의 항문이 꽉 수축했다.
			PRINTFORMW 그 조임에 황홀한 한숨을 내쉬며, %조사처리(CALLNAME:MASTER,"는")% 질릴 때까지 허리를 흔들었다.
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		;A感覚Lv3以下andA経験100以下
		IF ABL:124:2 < 3 && EXP:124:Ａ経験 < 100
			PRINTFORML 「응"우"으"으"」
			PRINTFORMW 익숙하지 않은 곳을 몇 번이고 찔리자 오키나는 위협적인 듯한 울음소리를 내고 있다…….
		ELSE
			PRINTFORML 「큭! 응읏... 흐으... 아, 윽……」
			PRINTFORMW 오키나는 한 번 몸을 움찔 떨더니, 그 후에는 쾌락을 받아들이듯 작게 신음하기 시작했다...
		ENDIF
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
		RETURN 1
		;A感覚Lv3以下andA経験100以下
	ELSEIF ABL:124:2 < 3 && EXP:124:Ａ経験 < 100
		PRINTFORML 「크윽, 우으윽…… 어디를 찌르고 있는 거야, 너……」
		PRINTFORMW 오키나는 익숙하지 않은 자극을 받으며 괴로운 듯 얼굴을 찡그리고 있다…….
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕 || TALENT:124:愛欲
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「앗, 아아아악! %UNICODE(0x2764)% 안, 엉덩이 같은 걸로윽, 히익, 좋아읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORML 「거기, 좋아읏%UNICODE(0x2764)% %CALLNAME:MASTER%읏, 더, 더 해줘읏%UNICODE(0x2764)%」
		ENDSELECT
		PRINTFORMW \@ TALENT:MASTER:性別 == 1 ? 페니스밴드 # %조사처리(CALLNAME:MASTER,"의")% 페니스 \@로부터 주어지는 쾌락에, 오키나는 완전히 사로잡혀 버렸다….
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「힉!? 아냐, 그만둬, 우아아앗!?」
			CASEELSE
				PRINTFORML 「그만해, 거긴 싫단 말이야앗!!」
		ENDSELECT
		PRINTFORMW 약점 공격에 비명을 참을 여유가 없는 듯, 오키나는 머리카락을 휘날리며 몸부림치고 있다.
	ENDIF
ENDIF
