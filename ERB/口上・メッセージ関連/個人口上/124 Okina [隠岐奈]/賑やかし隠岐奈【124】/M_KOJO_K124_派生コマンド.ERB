;7,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K124_7
CALL M_KOJO_MESSAGE_SCOM_K124_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K124_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		IF EXP:124:子宮口開発経験 >= 50
			PRINTFORML 평소라면 통증이 동반되었을 터이나, 오키나의 자궁경부는 이미 충분히 성감대로 기능하는 듯하다.
			PRINTFORMW 귀두로 꾹꾹 파고들듯이, 밀어붙이듯이 허리를 움직이며, %조사처리(CALLNAME:MASTER,"는")% 민감한 오키나의 질내를 즐겼다.
		ELSE
			PRINTFORML 고통으로 날뛰는 일도 없는 지금 상황은, 오키나 개발에도 딱이었다.
			PRINTFORMW 언젠가 오키나가 쾌감을 느낄 수 있도록, %조사처리(CALLNAME:MASTER,"는")% 열심히 그녀의 자궁구를 귀두로 찔렀다.
		ENDIF
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 오키나의 자궁경부를 천천히 공략하며, 조금씩 조금씩 절정에 이르게 한다……
		IF EXP:124:子宮口開発経験 >= 50
			PRINTFORML 「……아, 쿤윽…… 아…… 아앗……」
			PRINTFORML 완전히 %조사처리(CALLNAME:MASTER,"에게")% 개발된 오키나는, 자궁을 찔릴 때마다 벌벌 떨며 %조사처리(CALLNAME:MASTER,"의")% 씨를 애원하고 있다…
		ELSE
			PRINTFORML 「……으, 으윽…… 응………앗」
			PRINTFORML 지금 꿈속에 있는 오키나는 %조사처리(CALLNAME:MASTER,"에게")% 자궁구를 공격당하며 괴로운 듯 얼굴을 일그러뜨리고 있다…….
			PRINTFORML 이대로 오키나의 자궁을 개발해 나간다면, 스스로 씨를 갈구하게 되는 것도 시간문제일 것이다…….
		ENDIF
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕
		IF EXP:124:子宮口開発経験 >= 50
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아앗! %CALLNAME:MASTER%읏, 벌써 갈 것 같아……?」
						PRINTFORML 「좋, 좋아, 안에, 싸도 돼애애…ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
					CASEELSE
						PRINTFORML 「응읏, 아앗, 하아앗%UNICODE(0x2764)% 이제 도망 못 가게 할 거야…읏%UNICODE(0x2764)%」
						PRINTFORML 「%CALLNAME:MASTER%읏, 안에 싸줘어……읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아, 아앗, 좋아, 좋아읏%UNICODE(0x2764)% %CALLNAME:MASTER%읏%UNICODE(0x2764)%%UNICODE(0x2764)% 」
						PRINTFORML 「하앗, 하아앗%UNICODE(0x2764)% 깊이... 더 깊숙이, 와줘어어……읏%UNICODE(0x2764)%」
					CASEELSE
						PRINTFORML 「응, 아아, 하앗! 저, 이제 미쳐버릴 것 같아읏%UNICODE(0x2764)%」
						PRINTFORML 「제, 제발 싸줘어, %CALLNAME:MASTER%~~……ッ%UNICODE(0x2764)%」
				ENDSELECT
				PRINTFORMW 완전히 히신의 위엄을 잃은 오키나는, %조사처리(CALLNAME:MASTER,"의")% 자손을 갈망하며 미쳐버리고 있다….
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「응, 아아…… 윽! 끅, 우으, 이거 너무 고통스러워…… 흐윽%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORML 「흐, 으윽! 잠, 잠깐만, 그만해! 아... 아파아앗%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		IF EXP:124:子宮口開発経験 >= 50
			IF NOWEX:MASTER:射精
				PRINTFORML 「히익, 아니, 아아앗!!? 잠, 잠깐! 그대로 사정하면 안 돼에엣!!!」
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「히잉, 아앗%UNICODE(0x2764)% 크으윽, 이런, 이 정도 일로 에에엣%UNICODE(0x2764)%%UNICODE(0x2764)%」
					CASEELSE
						PRINTFORML 「흡, 하아아앗%UNICODE(0x2764)% 이, 이 몸이, 이런 기분 좋은 일 같은 걸로……읏%UNICODE(0x2764)%」
				ENDSELECT
				PRINTFORMW 오키나는 어떻게든 이성을 붙잡으려 하지만, 자궁을 범해질 때마다 그 저항이 약해져 간다…….
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「크윽, 으으읍... 그, 그만해, 아파...!」
				CASEELSE
					PRINTFORML 「아우으윽, 잠시만, 그건, 하지 말아줘……읏」
			ENDSELECT
			IF EXP:124:子宮口開発経験 >= 25
				PRINTFORMW 「크윽, 아, 아파앗... 그만두라고 했잖아요...읏」
			ELSE
				PRINTFORMW 「뭐, 무슨 의도로 이런…… 쿠윽!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
