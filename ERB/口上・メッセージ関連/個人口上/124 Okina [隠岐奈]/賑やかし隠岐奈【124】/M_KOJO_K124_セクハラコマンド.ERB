;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K124_310
CALL M_KOJO_MESSAGE_COM_K124_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORML 옷 때문에 잘 보이지는 않지만, 오키나의 엉덩이는 꽤 만지기 좋은 크기를 하고 있다.
		PRINTFORML 자주 앉아 있는 탓이겠지. 탄력보다는 말랑말랑한 살의 부드러움이 인상적이다.
		PRINTFORML 다소 흐트러진 느낌을 주는 엉덩이살에 오히려 흥분을 느끼며, %조사처리(CALLNAME:MASTER,"는")% 그녀의 엉덩이를 질릴 때까지 쓰다듬었다…….
	ELSEIF CFLAG:睡眠
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응, 으윽……」
				PRINTFORMW 말랑하고 부드러운 살결이 정말 참을 수 없다…….
			CASE 1
				PRINTFORML 「응우으…… 그만둬, 마이……」
				PRINTFORML 오키나는 웅얼거리며 잠꼬대를 하고 있다…….
		ENDSELECT
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;アナル奉仕
			CASE 72
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「그, 그렇게 열심히……히윽!」
					CASEELSE
						PRINTFORMW 「저, 저기, 더 정성스럽게……히잉앗」
				ENDSELECT
				;スカートの中を見せる
			CASE 35
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「하아... 하아... 그, 만지는 것만으로 괜찮은 건가? 후훗%UNICODE(0x2764)%」
					CASEELSE
						PRINTFORMW 「그렇게 야한 손길로…… 으윽」
				ENDSELECT
				;素股
			CASE 52
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「앗, 야! 움직이기 힘들잖아!?」
					CASEELSE
						PRINTFORMW 「그, 조금은 참을 수가 없는 거야...!」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「햣!? 자, 그만두라……읏」
					CASEELSE
						PRINTFORMW 「저, 엉덩이 같은 거 만져도…… 우응읏%UNICODE(0x2764)%」
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:124:恋人 || TALENT:124:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORMW 「햐앗!? 그, 그만해!」
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「그... 그런 음란한 손길로... 큭, 변태 같으니...!」
						CASEELSE
							PRINTFORMW 「흐윽... 그만두라고 해도……」
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「뭐야? 그렇게 흥분해서…… 후훗」
						CASEELSE
							PRINTFORMW 「……나의 엉덩이를 만지는 거, 즐거워?」
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「우와앗!? 너, 갑자기 뭐 하는 거야!!」
					PRINTFORMW 오키나는 %조사처리(CALLNAME:MASTER,"의")% 손을 탁 치며 저지했다.
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMW 「힉!? 그, 그만둬! 변태!!」
						CASEELSE
							PRINTFORMW 「낯간지럽게 만지지 마……읏」
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「으, 흑……」
							PRINTFORMW 오키나는 수치심으로 얼굴을 새빨갛게 물들이고 있다.
						CASEELSE
							PRINTFORMW 「이번만큼은 용서해 줄게……」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
