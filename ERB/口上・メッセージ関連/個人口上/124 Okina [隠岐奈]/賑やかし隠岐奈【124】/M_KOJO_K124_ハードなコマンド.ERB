;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K124_140
CALL M_KOJO_MESSAGE_COM_K124_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 시간을 멈추고 있기 때문에, 오키나에게 성기를 물릴 걱정도, 날뛸 걱정도 전혀 없다.
				PRINTFORML 전자는 그렇다 치더라도, 후자는 어떤 의미에서 이 행위의 진정한 맛인데……이라고 생각하면서도, %조사처리(CALLNAME:MASTER,"는")% 오키나를 장난감으로 계속 다룬다.
				PRINTFORMW 피스톤 운동을 반복할 때마다, 오키나의 입 주변은 그녀 자신의 침과 %조사처리(CALLNAME:MASTER,"의")% 체액으로 더럽혀져 갔다….
			CASE 1
				PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 허리를 움직일 때마다, 오키나는 입에서 꿀꺽꿀꺽 정열을 자극하는 소리가 울린다.
				PRINTFORML 시간을 멈추고 의식이 없는 사이에 이런 치욕을 당하고 있다는 것을 알게 된다면, 그녀는 대체 어떤 표정을 지을까?
				PRINTFORMW 프라이드를 상처 입히고 수치심으로 눈물이 고인 오키나의 얼굴을 상상하며, %조사처리(CALLNAME:MASTER,"는")% 더욱 단단하게 발기했다.
		ENDSELECT
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 「무구우읏!? 음푸읏, 푸아앗!!」
		PRINTFORML 목구멍 깊숙이 육봉을 밀어 넣은 오키나는 잠결에도 꿈틀거리며 발버둥쳤고, 한 번 그 구속으로부터 벗어났다.
		PRINTFORMW 하지만 다시 그녀의 머리는 눌려 %조사처리(CALLNAME:MASTER,"의")% 욕망 배출구가 되어버렸다……
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				IF ABL:124:マゾっ気 >= 3
					PRINTFORML 「ん읏%UNICODE(0x2764)% ごぽ읏、ぐぽ읏…む、んんん읏%UNICODE(0x2764)%」
					PRINTFORML (이런… 장난감처럼 사용당하면 흥분해 버리는 것 아닌가…읏%UNICODE(0x2764)%)
					PRINTFORMW 오키나는 산소 부족과 성적 흥분으로 구토할 지경이면서, 새빨간 얼굴로 황홀해하고 있다.
				ELSE
					PRINTFORML 「응…… 그, 윽!? 크윽, 콜록…!?」
					PRINTFORML 오키나는 괴로워하며 발버둥 치지만, 머리를 붙잡혀 도망칠 수가 없다….
				ENDIF
			CASEELSE
				IF ABL:124:マゾっ気 >= 3
					PRINTFORML 「응, 끅, 끄으윽%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORML 「크흡, 음, 퍽, 음ㅁ～～～～읏%UNICODE(0x2764)%」
					PRINTFORMW 몇 번이고 계속 식도에 페니스를 밀어 넣히면서 오키나는 황홀해하면서도 숨을 쉬지 못하고 있다.
				ELSE
					PRINTFORML 「응응! 응, 흐으윽!」
					PRINTFORML 「응…… 그, 크으윽!? 끅, 꿀꺽…읏!」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 식도까지 깊이 범해져 오키나는 격렬하게 구역질을 하고 있다.
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
