;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K124_150
CALL M_KOJO_MESSAGE_COM_K124_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORML 퍽퍽 소리를 내면서, %조사처리(CALLNAME:MASTER,"는")% 욕망의 상징인 발기를 오키나의 가슴에 박아 넣는다.
		PRINTFORML 선행하는 액으로 미끈해진 골짜기는 약간 느슨한 압박감과 함께 %조사처리(CALLNAME:MASTER,"의")% 사정을 유도했다.
		PRINTFORMW 움직일 때마다 울리는 음탕한 물소리와, 출렁거리는 그녀의 가슴에 더욱 흥분이 고취되면서, %조사처리(CALLNAME:MASTER,"는")% 격렬하게 허리를 계속 흔들었다….
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORML 「응…… 후우, 응……앗…」
		PRINTFORMW 자신의 몸이 장난감처럼 다뤄지고 있다는 사실조차 모른 채, 오키나는 잠든 상태이다….
	ELSEIF TCVAR:124:泥酔 == 1
		;恋慕or恋人
	ELSEIF TALENT:124:恋人 || TALENT:124:恋慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「훗, 응, 하아앗...!」
				PRINTFORML 「응응읏, 후훗, 기분 좋아 보이네? 더 허리를 흔들어도 괜찮아용?」
			CASEELSE
				PRINTFORML 「하아, 하앗! 응, 크윽... 후훗%UNICODE(0x2764)%」
				PRINTFORML 「그렇게 흥분해서…… 내 가슴이 그렇게 좋은 거야? 후훗」
		ENDSELECT
		PRINTFORMW 오키나는 거친 숨을 몰아쉬며, 욕망이 가득한 눈빛으로 %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다.
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「큭, 응, 너, 이렇게…… 부끄럽지도 않은 거야...?」
			CASEELSE
				PRINTFORML 「기분 좋게, 이런 야한 짓을……읏」
		ENDSELECT
		PRINTFORMDW 오키나는 수치심에 얼굴을 붉히며, 올려다보는 시선으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
	ENDIF
ENDIF
RETURN 1
