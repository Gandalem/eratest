;90,アナル愛撫される
;==================================================

@M_KOJO_MESSAGE_COM_K124_90
CALL M_KOJO_MESSAGE_COM_K124_90_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中ないよー
	IF FLAG:70
		RETURN 1
		;睡姦中はないよー
	ELSEIF CFLAG:MASTER:イタズラ == 2
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
	ELSE
		IF ABL:PLAYER:Ａ感覚 >= 3
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「큭, 한심한 목소리네? 이런 곳을 만져서 기분 좋은 거야? 후후훗」
				CASEELSE
					PRINTFORMW 「힘 빼, 더 기분 좋게 해 줄 테니까」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「아, 아직 아파? 미, 미안해……」
				CASEELSE
					PRINTFORMW 「조금 더, 부드럽게 만져볼 건데…… 어, 어때?」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
