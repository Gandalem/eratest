RETURN RESULT

@M_KOJO_MESSAGE_COM_K124_94_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		IF EXP:PLAYER:Ａ経験 < EXPLV:3
			PRINTFORML 항문과 복부에 퍼지는 둔한 통증에도, %조사처리(CALLNAME:MASTER,"는")% 허리를 들었다 내렸다 하는 것을 멈추지 않는다.
			PRINTFORMW 하지만 이 고통……항문으로 쾌락을 얻기에는 아직 시간이 좀 걸릴 것 같다.
		ELSE
			PRINTFORML 푹푹 깊은 삽입을 반복하자, 복부 깊은 곳에서 뜨겁고 둔한 쾌감이 밀려온다.
			PRINTFORMW 그와는 대조적으로 물어버린 항문에서는 직접적이고 찌르는 듯한 종류의 쾌락이 피어올라 %조사처리(CALLNAME:MASTER,"를")% 괴롭혔다……
		ENDIF
		RETURN 1
		;睡姦中
	ELSEIF CFLAG:MASTER:イタズラ == 2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「큭……응윽, 크으윽…!」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 허리를 내리칠 때마다 오키나는 작게 신음 소리를 냈다….
			CASE 1
				PRINTFORML 「윽……! 으응…읏!」
				PRINTFORML 최대한 체중을 실지 않으려고 노력하지만, 자꾸 힘이 넘쳐버리는 순간이 있다.
				PRINTFORMW 그럴 때마다 오키나는 괴로운 신음을 흘렸다…….
		ENDSELECT
		RETURN 1
	ELSEIF TCVAR:124:泥酔 == 1
		;それ以外
	ELSE
		IF NOWEX:124:射精
			PRINTFORML 「우아앗! %CALLNAME:MASTER%읏, 더는 참을 수 없어읏%UNICODE(0x2764)%」
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「하, 하앗, 야, 잠깐! 저기, 잠시만 말이야아앗%UNICODE(0x2764)%」
				CASEELSE
					IF TALENT:124:2 & 2
						PRINTFORML 「윽……응읏, 하아, 아앗%UNICODE(0x2764)%」
					ELSE
						PRINTFORML 「앗, 아아앗, 우, 움직이지 말아줘읏%UNICODE(0x2764)%」
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
