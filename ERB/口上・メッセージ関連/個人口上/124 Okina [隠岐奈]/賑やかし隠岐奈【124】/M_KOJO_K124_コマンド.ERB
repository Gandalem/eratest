	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「이, 이 몸에게 이런...!! 부끄러워어...읏」
			CASEELSE
				PRINTFORMW 「아, 나중에 꼭 기억해둬……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
