;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESSAGE_COM_K111_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
			PRINTFORMW 「Whahuh～? A Danmaku game～?」
		ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
			PRINTFORMW 「Grrrr... I'm gonna blow you away～!!」
		ELSE
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「It's ★ Lunatic ★ Time～!」
			CASE 2
				PRINTFORMW 「I'm gonna beat ya with my super-turbo-awesome powerー!」
			CASEELSE
				PRINTFORMW 「I hope you're ready to fall down into Hell!」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				PRINTFORML 「Wh-Whahuh...?」
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				PRINTFORML 「No, no way...」
			ELSE
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Ack, aww man...」
				CASE 2
					PRINTFORML 「H-How could this happen...」
				CASEELSE
					PRINTFORML 「It's n-not over yet...」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Hiiyaaah～!」
				CASE 2
					PRINTFORML 「Whoaaah～!」
				CASEELSE
					PRINTFORML 「Owwwie～!」
				ENDSELECT
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Guh...!」
				CASE 2
					PRINTFORML 「Th-That was nothing!」
				CASEELSE
					PRINTFORML 「Ack! You didn't just hit me!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:11
				CASE 1
					PRINTFORML 「Owwwch!」
				CASE 2
					PRINTFORML 「Oof!」
				CASE 3
					PRINTFORML 「Owwie!」
				CASE 4
					PRINTFORML 「I'm hit!」
				CASE 5
					PRINTFORML 「Kyah!」
				CASE 6
					PRINTFORML 「Gyaaah!」
				CASE 7
					PRINTFORML 「Whoah!」
				CASE 8
					PRINTFORML 「Hey...!」
				CASE 9
					PRINTFORML 「Gaaahー!」
				CASE 10
					PRINTFORML 「W-Wait!」
				CASEELSE
					PRINTFORML 「Pwahー!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		SELECTCASE RAND:3
		CASE 1
			PRINTFORML 「Come on! Hell Sign "Flash and Stripe"!!」
		CASE 2
			PRINTFORML 「Eat this! Inferno "Striped Abyss"!!」
		CASEELSE
			PRINTFORML 「Come if you dare! Hell Sign "Hell Eclipse"!!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				PRINTFORMW 「Hummm～ What the heck was I doing...?」
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				PRINTFORMW 「Th-That's not fairー! %CALLNAME:MASTER% you cheaterー!! Bleeeeehー!」
			ELSE
				PRINTFORML 「Haah, haah, haah...」
				SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「I g-give up! You're too strong, %CALLNAME:MASTER%!」
				CASE 2
					PRINTFORMW 「I l-lost... Crap, this makes me so... MーAーDー!」
				CASE 3
					PRINTFORMW 「%CALLNAME:MASTER%! That wasn't fair at all! Bleehー!」
				CASE 4
					PRINTFORMW 「%CALLNAME:MASTER%, I'm gonna beat you...! N-Next time, for sure...」
				CASEELSE
					PRINTFORMW 「W-Well, I was going easy on you, so there!」
				ENDSELECT
			ENDIF
		;クラウンピース勝利
		ELSE
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				PRINTFORMW 「Kyaahaahaahaa～! Amusing, how amusing!」
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				PRINTFORMW 「Kyahaーn! I feel like a new woman! Repent for your sins in Hell!」
			ELSE
				SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「Kya ha ha! How does it feel! This is the true might of Clownpiece, the Fairy from Hell!」
				CASE 2
					PRINTFORMW 「Ahhー, that was fun! You're actually pretty good too, %CALLNAME:MASTER%!」
				CASE 3
					PRINTFORMW 「Ahhー, that was fun! %CALLNAME:MASTER%, you're really bad at dodging!」
				CASE 4
					PRINTFORMW 「I did itー! Well? How did you like getting a taste of my madness?」
				CASEELSE
					PRINTFORMW 「Hyahooー! %CALLNAME:MASTER%, you've got a long way to go before you can beat me～」
				ENDSELECT
				TALENT:111:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

