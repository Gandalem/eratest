; Modular ERB: 個人口上/111 Clownpiece [クラウンピース]/クラウンピース/M_KOJO_K111_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K111_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
			PRINTFORMW 「우와아~? 단마쿠 게임인가~?」
		ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
			PRINTFORMW 「크르릉... 너를 날려버리겠어~!!」
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「광란의 시간이야~!」
				CASE 2
					PRINTFORMW 「내 슈퍼 터보 멋진 힘으로 너를 이겨주겠어ー!」
				CASEELSE
					PRINTFORMW 「지옥으로 떨어질 준비가 되었기를 바란다!」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				PRINTFORML 「뭐, 뭐지...?」
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				PRINTFORML 「아니, 말도 안 돼...」
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「아, 어우 정말...」
					CASE 2
						PRINTFORML 「어, 어째서 이런 일이...」
					CASEELSE
						PRINTFORML 「아직 끝나지 않았어...」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「히이야아아~!」
					CASE 2
						PRINTFORML 「우와아~!」
					CASEELSE
						PRINTFORML 「오와아아~!」
				ENDSELECT
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「크윽...!」
					CASE 2
						PRINTFORML 「그, 그건 아무것도 아니었어!」
					CASEELSE
						PRINTFORML 「뭐라고! 그냥 나를 맞춘 게 아니잖아!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:11
					CASE 1
						PRINTFORML 「아야!」
					CASE 2
						PRINTFORML 「윽!」
					CASE 3
						PRINTFORML 「아야!」
					CASE 4
						PRINTFORML 「맞았어!」
					CASE 5
						PRINTFORML 「캬아!」
					CASE 6
						PRINTFORML 「꺄아악!」
					CASE 7
						PRINTFORML 「우와!」
					CASE 8
						PRINTFORML 「이봐...!」
					CASE 9
						PRINTFORML 「크아악—!」
					CASE 10
						PRINTFORML 「잠깐만요!」
					CASEELSE
						PRINTFORML 「푸와아-!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「이리 와라! 지옥의 징조 "플래시 앤 스트라이프"!!」
			CASE 2
				PRINTFORML 「이것을 먹어라! 인페르노 "스트라이프드 어비스"!!」
			CASEELSE
				PRINTFORML 「"감히 오지 못할까! 지옥의 징표 '헬 이클립스'!!"」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				PRINTFORMW 「음~ 대체 뭘 하고 있었지...?」
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				PRINTFORMW 「그, 그건 불공평해ー! %CALLNAME:MASTER%너 반칙이야ー!! 크아악ー!」
			ELSE
				PRINTFORML 「하아, 하아, 하아...」
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「나, 포기할래! 너무 강해, %CALLNAME:MASTER%님!」
					CASE 2
						PRINTFORMW 「나 지-졌어... 젠장, 이거 너무 나를... 화나게 해!」
					CASE 3
						PRINTFORMW 「%CALLNAME:MASTER%! 전혀 공평하지 않았어! 크윽—!」
					CASE 4
						PRINTFORMW 「%CALLNAME:MASTER%, 내가 너를 이길 거야...! 다음엔 꼭...」
					CASEELSE
						PRINTFORMW 「뭐, 내가 봐주고 있었는데, 자 이제!」
				ENDSELECT
			ENDIF
			;クラウンピース勝利
		ELSE
			IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
				PRINTFORMW 「캬하하하하～! 재미있군, 정말 재미있어!」
			ELSEIF TALENT:111:機嫌 == -1 || CFLAG:111:ブチギレ || MARK:111:反発刻印 >= 3
				PRINTFORMW 「캬하~난! 새로운 여자 같아! 지옥에서 네 죄를 참회해라!」
			ELSE
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「캬하하! 기분이 어떠냐! 이것이 지옥에서 온 요정 클라운피스의 진정한 힘이다!」
					CASE 2
						PRINTFORMW 「아아~ 재밌었다! 당신도 꽤 잘하네요, %CALLNAME:MASTER%!」
					CASE 3
						PRINTFORMW 「아하~ 재미있었어! %CALLNAME:MASTER%, 회피는 정말 못한다!」
					CASE 4
						PRINTFORMW 「해냈어-! 자? 내 광기의 맛은 어땠지?」
					CASEELSE
						PRINTFORMW 「야호오~! %CALLNAME:MASTER%님, 저를 이기려면 아직 갈 길이 멀 거예요~」
				ENDSELECT
				TALENT:111:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
