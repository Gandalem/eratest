@M_KOJO_MESSAGE_COM_K111_81
CALL M_KOJO_MESSAGE_COM_K111_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「내 m-입을 사용하길 원해?」
		PRINTFORMW 「좋아, 이해한 것 같아... 냠...」
		PRINTFORMW 「음, 그러니까 계속 핥고 머리를 앞뒤로 움직여야 하는 거구나...」
		CALL HPH_PRINT,@"「음음... 음음... 핥아... 핥-핥-핥...흐읍」","W"
		RETURN 1
	ENDIF
	IF FLAG:時間停止
	ELSEIF NOWEX:MASTER:11
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「흐으음 흐으음 후우욱... 갈 것 같아!」","W"
				CALL HPH_PRINT,@"「괜찮아, 내 입에 해줘 HPH MnmmhmmnfHPHHPH Mnnn～～～HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「음... 흐으윽, 많은 조수가 흘러나오고 있어」","W"
				CALL HPH_PRINT,@"「곧 절정에 이를 거야? 그럼 이렇게 해줄게... 응글읍, 글룹, 므물ㅁ, 음mnf~~하프」","W"
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「우선, 기분 좋아? HPH 핥아-핥아 HPH」","W"
				CALL HPH_PRINT,@"「음 글럽... 핥아 핥아 핥아... %RANDKISS("suck")%흐읍」","W"
			CASE 1
				CALL HPH_PRINT,@"「아아아-응흐읍」","W"
				CALL HPH_PRINT,@"「핥는 소리... %RANDKISS("suck")% HPH 피윙 구브? 핥는 소리-핥는 소리... HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「음ㅁ... 츄우... %RANDKISS("suck")%...흐읍」","W"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%'의 혀가, 달콤하네... HPH」","W"
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
RETURN 1
