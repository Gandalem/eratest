;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K111_80
CALL M_KOJO_MESSAGE_COM_K111_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「손으로 문지르길 원해?」
		PRINTFORMW 「이, 이렇게...?」
		PRINTFORMW 「어때? 기분 좋아?」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
	ELSEIF NOWEX:MASTER:11
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「키아하♪ 너무 움찔거려어-흐으흣」","W"
				CALL HPH_PRINT,@"「당신이 그것을 사정할 것 같군요 HPH 여기 HPH 서둘러요 HPH 서둘러요 HPH」","W"
			CASE 1
				PRINTFORMW 「오호~? 내 손만으로 절정에 달할 거야~?」
				CALL HPH_PRINT,@"「파하후, 이리 와. 괜찮아, 사정해도 돼. 해봐, 해봐」","W"
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「어때? 기분 좋아?」
				CALL HPH_PRINT,@"「그거 좋아 HPH 더 기분 좋게 해 줄게 HPH 여기 HPH 이거 받아 HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「멋지다, 그렇지 HPH」","W"
				CALL HPH_PRINT,@"「그냥 참아봐―HPH EiiiHPH EiiiHPH」","W"
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
RETURN 1
