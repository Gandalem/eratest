	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「뭐라고? 파이즈리...?」
		PRINTFORMW 「그게 뭔지는 알아, 난 바보 아니거든... 그냥, 그럴 방법이 없어...」
		PRINTFORMW 「...응, 내 이거 작은 걸로서는 좋을 리가 없을 것 같아...」
		PRINTFORMW 「음, 정말 그렇게 말한다면 %CALLNAME:MASTER%, 한번 해볼게.」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
	ELSEIF NOWEX:MASTER:11
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「우와아, 곧 오려고 해?」
				CALL HPH_PRINT,@"「좋아, 계속 최선을 다할 테니 네가 하고 싶을 때 언제든 해 HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「흠, 흠, 좀 커지고 있는 것 같아 HPH」","W"
				CALL HPH_PRINT,@"「오-케이, 그냥 내가 하는 대로 계속 할게~ HPH 에이이, 에이HPH」","W"
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「휴우후후 이건 어렵네...」","W"
				PRINTFORMW 「이거 실제로 기분 좋은 거야?」
			CASE 1
				PRINTFORMW 「죄송해요, %CALLNAME:MASTER%, 제 가슴이 너무 작아서...」
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
RETURN 1
