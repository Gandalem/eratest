;==================================================
;依頼口上・一般依頼04：料理上手になりたい
;==================================================
@M_KOJO_IRAI_4_K111(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「For some reason I'm in the mood to learn about cooking today!」
	CASE 2
		PRINTFORMW 「Hey %CALLNAME:MASTER%, teach me how to cook～!」
	CASEELSE
		PRINTFORMW 「I wish I knew how to cook too～」
	ENDSELECT
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Cooking♪ Cooking♪」
	CASE 2
		PRINTFORMW 「Hmm～ What should we make?」
	CASEELSE
		PRINTFORMW 「Really? Hoorayー!」
	ENDSELECT
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
;【◆口上】
;【L ［あなた］は［彼女］と一緒に料理をした】
;【W ［料理名］を作ります】
;【▼そのまま下の口上へ】
	PRINTFORMW 「Alright, I'm gonna do my bestー!」
	RETURN 1
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	SELECTCASE RAND:4
	CASE 1
		PRINTFORMW 「Hey hey, can I put in this candy, too? That'll make it taste better, right?」
	CASE 2
		PRINTFORMW 「Hmmmm～ I guess we should put in about this muchー」
	CASE 3
		PRINTFORMW 「%CALLNAME:MASTER%, do you like the taste, or is it bad?」
	CASEELSE
		PRINTFORML 「I'm gonna do the chopping tooー!」
		PRINTFORMDW ...That would be pretty dangerous...
	ENDSELECT
	RETURN 1
CASE "成功報告時"
;報酬：\500
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
;【L できた料理は二人でいっしょに頂いた】
;【食事効果（料理採点）】
	;料理口上のコピペ
	IF ABL:111:料理技能 >= 3
		SELECTCASE RAND:4
		CASE 1
			PRINTFORML 「All done～♪」
			PRINTFORML 「Wowie! It looks super tasty～!」
		CASE 2
			PRINTFORML 「This is no big deal compared to what I usually make～」
			PRINTFORML 「What do you think? I did a good job, right?」
		CASE 3
			PRINTFORML 「All done! Now gimme my reward, gimme!」
			PRINTFORMDL Pat pat...
			PRINTFORML 「Kehehe♪」
		CASEELSE
			PRINTFORML 「It's perfect! That was a piece of cake!」
			PRINTFORML 「Don't you think I'm getting better at cooking?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
		CASE 1
			PRINTFORML 「Phewー, that took a lot of work...」
			PRINTFORML 「Cooking sure is hard, isn't it...」
		CASE 2
			PRINTFORML 「So that's how you do it?」
			PRINTFORML 「Why don't you add more secret ingredients?」
		CASE 3
			PRINTFORML 「All done～! This should be fine!」
			PRINTFORML 「After all, they say you won't gain weight if you only eat this much!」
		CASEELSE
			PRINTFORML 「Awhuh? It's already done?」
			PRINTFORML 「Can't you add more secret ingredients or something?」
		ENDSELECT
	ENDIF
	WAIT
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

