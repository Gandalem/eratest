;【▼そのまま下の口上へ】
	
	RETURN 0
CASE "成功報告時"
;報酬：\500
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Pfahahaー♪ That was a ton of funー♪」
	CASE 2
		PRINTFORMW 「Hmhmmm♪ Well, how was it? My true strength is awesome, isn't it?」
	CASEELSE
		PRINTFORMW 「That was fun, wasn't it～♪ You did really good too, %CALLNAME:MASTER%, that's a surprise!」
	ENDSELECT
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
