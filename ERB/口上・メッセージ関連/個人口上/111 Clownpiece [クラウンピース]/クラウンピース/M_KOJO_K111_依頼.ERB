;【L ［あなた］は［彼女］にうまい魚を渡した】
;【L 何だか生きる希望がわいてきたよ。】
;【▼そのまま下の口上へ】
	PRINTFORMW 「Holy moly! Did you catch it yourself, %CALLNAME:MASTER%?」
	RETURN 1
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	PRINTFORML 「Thanksー!」
	RETURN 1
CASE "成功報告時"
;報酬：白米３個
	PRINTFORMW 「Okay, here you go! Thanks a million!」
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================
@M_KOJO_IRAI_16_K111(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「%CALLNAME:MASTER%, wait up and listen to me for a sec～!」
	RETURN 1
CASE "依頼非受託時"
	PRINTFORML 「Hmmph, fine, be that way!」
	RETURN 1
CASE "依頼受託時"
	PRINTFORML 「Hooray! I'll be counting on you!」
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	PRINTFORML 「You seeー...」
	RETURN 1
CASE "依頼実行直後"
	IF TFLAG:193 == 1
		;正解の選択肢
		PRINTFORML 「Yeah, yeah! Just as expected, %CALLNAME:MASTER%!」
	ELSEIF TFLAG:193 == 2
		;ハズレの選択肢だったが逆に正解
		PRINTFORML 「Huh!? %CALLNAME:MASTER%, that's an awesome choice!」
	ELSEIF TFLAG:193 == -1
		;ハズレの選択肢
		PRINTFORML 「Sheesh～ I really don't know about that...」
	ELSEIF TFLAG:193 == -2
		;正解の選択肢だったが逆にハズレ
		PRINTFORML 「For cryin' out loud, that's just a bunch of nonsense...」
	ENDIF
	RETURN 1
CASE "成功報告時"
;報酬：野菜か果物
	PRINTFORML 「Thanksー!」
	RETURN 1
CASE "失敗報告時"
	PRINTFORML 「Maybe it was a bad idea to ask you, %CALLNAME:MASTER%...」
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
CASE "口上委託率"
;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
	RESULT:100 = 50

;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
	RESULT:1 = 0
	RESULT:2 = 0
	RETURN 1
CASE "口上専用"
;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
;16,お悩み相談 の場合
;RESULT        発生判定,0だと発生しません
;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
;RESULTS:0     お悩み文章（自動で『』で囲まれます）
;RESULTS:1～3  選択肢１～３
;何も発生しない状態になると無限ループになるので注意してください
;●追記メモ
;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
;RESULT:1を7にするとどれも正解になります
;RESULT:1を8にするとどれもハズレになります
;1～3以外の場合は逆張り判定が自動で無くなります
	SELECTCASE RAND:7
	CASE 1
		RESULTS:0 = What should I name my new spell card?

		LOCALS:1 = 「Inferno's Dream」
		LOCALS:2 = 「Freedom Trail」
		LOCALS:3 = 「Million Dollar Lamps」
		LOCALS:4 = 「Sea of the Underworld」
		LOCALS:5 = 「Stars and Stripes Forever」
		LOCALS:6 = 「Abyssal Breeze」

		;most of these are references to spellcards from other hus
		;These are references to Hecatia spellcards
		LOCALS:11 = 「Hell's Non-Ideal Danmaku」
		LOCALS:12 = 「Rain Falling in Hell」
		;These are references to Reisen spellcards
		LOCALS:13 = 「Invisible Full Moon」
		LOCALS:14 = 「Rocket ☆ In ☆ Mist」
		LOCALS:15 = 「Lunatic Red Eyes」
		;Star Sapphire spell cards
		LOCALS:16 = 「Starlight Rain」
		LOCALS:17 = 「Star Piece Shower」
		LOCALS:18 = 「Star Storm」
		LOCALS:19 = 「Star Voyage」
		;Rin spell cards
		LOCALS:20 = 「Spleen Eater」
		LOCALS:21 = 「Blazing Wheel」
		;Komachi spell cards
		LOCALS:22 = 「Narrow Confines of Avici」
		;Yachie spell cards
		LOCALS:23 = 「Tortoiseshell Hell」
		;Kutaka spell cards
		LOCALS:24 = 「Hell Realm Sight-Line」
		CALL M_KOJO_K111_ONAYAMI_POT(6, 14)
		RESULTS:1 = %LOCALS:(RESULT:11)%
		RESULTS:2 = %LOCALS:(RESULT:12)%
		RESULTS:3 = %LOCALS:(RESULT:13)%
		RESULT = 1
;		RESULT:1 = 決定済み
		RESULT:2 = 1
	CASE 2
		RESULTS:0 = Who should I play a prank on next?
		RESULTS:1 = Reimu
		RESULTS:2 = Marisa
		RESULTS:3 = Sanae
		RESULT = 1
		RESULT:1 = 7
	CASE 3
		RESULTS:0 = Who should I play a prank on next?
		RESULTS:1 = Sunny Milk
		RESULTS:2 = Luna Child
		RESULTS:3 = Star Sapphire
		RESULT = 1
		RESULT:1 = 7
	CASE 4
		RESULTS:0 = How are we gonna make it through the winter?
		RESULTS:1 = Play Danmaku games with snowballs
		RESULTS:2 = Develop a new kind of oden noodles
		RESULTS:3 = Summon the fires of Hell
		;秋に発生
		SIF DAY:2 == 3
			RESULT = 1
		RESULT:1 = 7
	CASE 5
		RESULTS:0 = What kind of stalls should we visit during the next festival?

		LOCALS:1 = Yakisoba stall
		LOCALS:2 = Kebab stall
		LOCALS:3 = Taco stall
		LOCALS:4 = Candy apple stall
		LOCALS:5 = Frankfurter stall
		LOCALS:6 = Shooting targets
		LOCALS:7 = Super ball scooping

		LOCALS:11 = Goldfish scooping
		LOCALS:12 = Katanuki
		LOCALS:13 = Try the lottery
		LOCALS:14 = Yoyo fishing
		LOCALS:15 = Mask shop
		LOCALS:16 = Cotton candy stall
		LOCALS:17 = Shaved ice stall
		LOCALS:18 = Ring toss
		LOCALS:19 = Fan shop
		CALL M_KOJO_K111_ONAYAMI_POT(7, 9)
		RESULTS:1 = %LOCALS:(RESULT:11)%
		RESULTS:2 = %LOCALS:(RESULT:12)%
		RESULTS:3 = %LOCALS:(RESULT:13)%
		RESULT = 1
;		RESULT:1 = 決定済み
		RESULT:2 = 1
	CASE 6
		RESULTS:0 = What should I do to try and communicate with the dead?
		RESULTS:1 = Go to the Higan
		RESULTS:2 = Revive them with black magic
		RESULTS:3 = Use a seance to talk with them
		RESULT = 1
		RESULT:1 = 2
		RESULT:2 = 1
	CASEELSE
		RESULTS:0 = Which stand is your favorite?

		;this hardly needs to be said, but these are all JoJo references
		LOCALS:1 = D4C

		LOCALS:11 = Star・Platinum
		LOCALS:12 = Za・Warudo
		LOCALS:13 = Crazy・Diamond
		LOCALS:14 = Killer・Queen
		LOCALS:15 = Gold・Experience
		LOCALS:16 = King・Crimson
		LOCALS:17 = Stone・Free
		LOCALS:18 = Made・In・Heaven
		LOCALS:19 = Tusk
		CALL M_KOJO_K111_ONAYAMI_POT(1, 9)
		RESULTS:1 = %LOCALS:(RESULT:11)%
		RESULTS:2 = %LOCALS:(RESULT:12)%
		RESULTS:3 = %LOCALS:(RESULT:13)%
		RESULT = 1
;		RESULT:1 = 決定済み
		RESULT:2 = 1
	ENDSELECT

	SIF !RESULT
		RESTART
	RETURN 1
ENDSELECT


;お悩み相談用
;回答と選択肢を抽出してくれる関数
@M_KOJO_K111_ONAYAMI_POT(正解数, 間違い数)
#DIM 正解数
#DIM 間違い数
VARSET RESULT
VARSET LOCAL
RESULT:1 = RAND:3 + 1
RESULT:(10 + RESULT:1) = RAND:正解数 + 1
FOR LOCAL, 11, 14
	WHILE !RESULT:LOCAL
		RESULT:LOCAL = RAND:間違い数 + 11
		IF RESULT:LOCAL == LOCAL:1
			RESULT:LOCAL = 0
		ELSE
			LOCAL:1 = RESULT:LOCAL
		ENDIF
	WEND
NEXT
