				RESULT:2 = 1
		ENDSELECT
		SIF !RESULT
			RESTART
		RETURN 1
ENDSELECT
;お悩み相談用
;回答と選択肢を抽出してくれる関数

@M_KOJO_K111_ONAYAMI_POT(正解数, 間違い数)
#DIM 正解数
#DIM 間違い数
VARSET RESULT
VARSET LOCAL
RESULT:1 = RAND:3 + 1
RESULT:(10 + RESULT:1) = RAND:正解数 + 1
FOR LOCAL, 11, 14
WHILE !RESULT:LOCAL
RESULT:LOCAL = RAND:間違い数 + 11
IF RESULT:LOCAL == LOCAL:1
	RESULT:LOCAL = 0
ELSE
	LOCAL:1 = RESULT:LOCAL
ENDIF
WEND
NEXT
