;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K111(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「음~ 무슨 소리야, 도대체 저게 무슨 뜻이지?」
			CASE 2
				PRINTFORMW 「이봐, %CALLNAME:MASTER%, 이것의 답을 알고 있나요?」
			CASEELSE
				PRINTFORMW 「저기 %CALLNAME:MASTER%님, 잠깐 질문이 있는데요——」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					RETURN 0
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「푸훗~?! 알겠다, 그런 거였구나-!</>」
					CASE 2
						PRINTFORMW 「흠~, 그렇게 결정됐군--」
					CASEELSE
						PRINTFORMW 「네, 네, 이제 다 이해가 됐어!」
				ENDSELECT
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「아후움―…」
						PRINTFORMW (%HE_SHE(MASTER)%가 방금 한 말에 대해 도통 하나도 이해할 수 없다…)
					CASE 2
						PRINTFORMW 「농담이지—! 난 네 수법에 속지 않을 거야!」
					CASEELSE
						PRINTFORMW 「그, 그건 복잡하게 들리네...」
				ENDSELECT
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「고마워! 다행이다!」
			CASE 2
				PRINTFORMW 「정말 똑똑하시네요 %CALLNAME:MASTER%, 놀랐어요!」
			CASEELSE
				PRINTFORMW 「고마워~ 더 궁금한 게 생기면 꼭 다시 물어볼게!」
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「됐어... 머리가 어지러워...」
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%, 처음부터 몰랐던 거지!」
			CASEELSE
				PRINTFORMW 「흠~ 알겠다. 너도 전혀 모르는 모양이군!」
		ENDSELECT
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
