@M_KOJO_IRAI_5_K111(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「으르렁~ 왠지 짜증이 나기 시작했어...」
			CASE 2
				PRINTFORMW 「이봐 %CALLNAME:MASTER%, 잠깐만 내 상대가 되어줘!」
			CASEELSE
				PRINTFORMW 「야 %CALLNAME:MASTER%, 나 지금 특별 훈련 좀 할 거니까 와서 도와줘!」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「좋아, 그럼 서둘러 넓은 곳으로 가자~♪」
			CASE 2
				PRINTFORMW 「호호호~ 오늘은 최상의 컨디션이어야 할 거다♪」
			CASEELSE
				PRINTFORMW 「그냥 연습이니까 힘 빼지 마, 알겠지?」
		ENDSELECT
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
		;【▼そのまま下の口上へ】
		;戦闘訓練のコピペ
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「이리 와라! 지옥의 징조 "플래시 앤 스트라이프"!!」
			CASE 2
				PRINTFORMW 「이것을 먹어라! 인페르노 "스트라이프드 어비스"!!」
			CASEELSE
				PRINTFORMW 「"감히 오지 못할까! 지옥의 징표 '헬 이클립스'!!"」
		ENDSELECT
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「푸하하하~♪ 정말 재미있었어~♪」
			CASE 2
				PRINTFORMW 「음~ 어땠어? 나의 진정한 강함은 굉장하지 않아?」
			CASEELSE
				PRINTFORMW 「재미있었지~♪ 당신도 정말 잘했어, %CALLNAME:MASTER%, 놀랍네!」
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
