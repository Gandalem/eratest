;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「곤란해! 이렇게 많은 걸 치울 방법이 없어...!」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			PRINTFORMW 「에? 생각했던 것만큼 지저분하지 않네!」
			PRINTFORMW 「음~... 오늘 운 좋은 날이야~☆ 이게 그 뜻이겠지!」
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して徹底的に部屋を掃除した】
			;【▼そのまま下の口上へ】
			PRINTFORMDL 클라운피스의 방은 광기일 정도로 어수선하고 잡동사니로 가득하다…
			PRINTW 
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「그럼 내가 지시를 내주지!」
				CASE 2
					PRINTFORMW 「야, 잠깐! 뭘 뒤지고 있는 거야!? 변태 같으니라고!」
				CASE 3
					PRINTFORMW 「하아~ 도대체 누가 내 방을 이렇게 지저분하게 만든 거야, 아무튼...」
				CASEELSE
					PRINTFORMW 「뭐지? 이게 도대체 뭐야...? 전부 쓰레기잖아!」
			ENDSELECT
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\1500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		PRINTFORMW 「응, 이제 깨끗해졌어! 정말 고마워ー!!」
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
