				LOCALS:11 = 「지옥의 비이상적인 탄막」
				LOCALS:12 = 「지옥에서 내리는 비」
				;These are references to Reisen spellcards
				LOCALS:13 = 「보이지 않는 보름달」
				LOCALS:14 = 「로켓☆ 안개 속으로」
				LOCALS:15 = 「광인의 붉은 눈」
				;Star Sapphire spell cards
				LOCALS:16 = 「스타라이트 레인」
				LOCALS:17 = 「스타 피스 샤워」
				LOCALS:18 = 「스타 스톰」
				LOCALS:19 = 「스타 보야지」
				;Rin spell cards
				LOCALS:20 = 「비장 흡수자」
				LOCALS:21 = 「타오르는 수레바퀴」
				;Komachi spell cards
				LOCALS:22 = 「아비치의 좁은 감옥」
				;Yachie spell cards
				LOCALS:23 = 「거북이 등 지옥」
				;Kutaka spell cards
				LOCALS:24 = 「지옥 영역 시선 범위」
				CALL M_KOJO_K111_ONAYAMI_POT(6, 14)
				RESULTS:1 = %LOCALS:(RESULT:11)%
				RESULTS:2 = %LOCALS:(RESULT:12)%
				RESULTS:3 = %LOCALS:(RESULT:13)%
				RESULT = 1
				;		RESULT:1 = 決定済み
				RESULT:2 = 1
			CASE 2
				RESULTS:0 = Who should I play a prank on next?
				RESULTS:1 = Reimu
				RESULTS:2 = Marisa
				RESULTS:3 = Sanae
				RESULT = 1
				RESULT:1 = 7
			CASE 3
				RESULTS:0 = Who should I play a prank on next?
				RESULTS:1 = Sunny Milk
				RESULTS:2 = Luna Child
				RESULTS:3 = Star Sapphire
				RESULT = 1
				RESULT:1 = 7
			CASE 4
				RESULTS:0 = How are we gonna make it through the winter?
				RESULTS:1 = Play Danmaku games with snowballs
				RESULTS:2 = Develop a new kind of oden noodles
				RESULTS:3 = Summon the fires of Hell
				;秋に発生
				SIF DAY:2 == 3
					RESULT = 1
				RESULT:1 = 7
			CASE 5
				RESULTS:0 = What kind of stalls should we visit during the next festival?
				LOCALS:1 = 야키소바 노점
				LOCALS:2 = 케밥 가판대
				LOCALS:3 = 타코 노점
				LOCALS:4 = 사탕 사과 노점
				LOCALS:5 = 프랑크푸르터 가판대
				LOCALS:6 = 표적을 사격한다
				LOCALS:7 = 슈퍼 볼 스쿠핑
				LOCALS:11 = 금붕어 떠내기
				LOCALS:12 = 카타누키
				LOCALS:13 = 복권을 시도해 봐
				LOCALS:14 = 요요 낚시
				LOCALS:15 = 가면 가게
				LOCALS:16 = 솜사탕 가판대
				LOCALS:17 = 빙수 가판대
				LOCALS:18 = 고리 던지기
				LOCALS:19 = 팬숍
				CALL M_KOJO_K111_ONAYAMI_POT(7, 9)
				RESULTS:1 = %LOCALS:(RESULT:11)%
				RESULTS:2 = %LOCALS:(RESULT:12)%
				RESULTS:3 = %LOCALS:(RESULT:13)%
				RESULT = 1
				;		RESULT:1 = 決定済み
				RESULT:2 = 1
			CASE 6
				RESULTS:0 = What should I do to try and communicate with the dead?
				RESULTS:1 = Go to the Higan
				RESULTS:2 = Revive them with black magic
				RESULTS:3 = Use a seance to talk with them
				RESULT = 1
				RESULT:1 = 2
				RESULT:2 = 1
			CASEELSE
				RESULTS:0 = Which stand is your favorite?
				;this hardly needs to be said, but these are all JoJo references
				LOCALS:1 = D4C
				LOCALS:11 = 스타·플래티넘
				LOCALS:12 = 자·월드
				LOCALS:13 = 크레이지 다이아몬드
				LOCALS:14 = 킬러·퀸
				LOCALS:15 = 골드·경험치
				LOCALS:16 = 킹 크림슨
				LOCALS:17 = 스톤 프리
