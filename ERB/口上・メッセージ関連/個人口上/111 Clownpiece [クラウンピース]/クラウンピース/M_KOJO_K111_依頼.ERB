;依頼口上・一般依頼04：料理上手になりたい
;==================================================

@M_KOJO_IRAI_4_K111(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「무슨 이유에서인지 오늘은 요리에 대해 배울 기분이네!」
			CASE 2
				PRINTFORMW 「헤이 %CALLNAME:MASTER%, 요리하는 법 가르쳐 줘~!」
			CASEELSE
				PRINTFORMW 「나도 요리하는 법을 알고 싶어~」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「요리♪ 요리♪」
			CASE 2
				PRINTFORMW 「음~ 뭘 만들까?」
			CASEELSE
				PRINTFORMW 「정말? 만세~!」
		ENDSELECT
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		PRINTFORMW 「좋아, 최선을 다할게-!」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「저기 저 사탕도 넣어봐도 될까요? 그러면 더 맛있어지겠죠?」
			CASE 2
				PRINTFORMW 「음~ 이 정도는 넣어야 할 것 같아~」
			CASE 3
				PRINTFORMW 「%CALLNAME:MASTER%, 맛이 좋아, 아니면 나빠?」
			CASEELSE
				PRINTFORML 「나도 베는 거 할 거야ー!」
				PRINTFORMDW ...그거 꽤 위험할 텐데...
		ENDSELECT
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		;料理口上のコピペ
		IF ABL:111:料理技能 >= 3
			SELECTCASE RAND:4
				CASE 1
					PRINTFORML 「다 됐어～♪」
					PRINTFORML 「와우! 엄청 맛있어 보인다~!」
				CASE 2
					PRINTFORML 「이건 내가 평소에 만드는 것에 비하면 별거 아니야~」
					PRINTFORML 「어때? 잘했지?」
				CASE 3
					PRINTFORML 「다 끝냈어! 이제 보상이나 내놔, 내놔!」
					PRINTFORMDL 툭툭...
					PRINTFORML 「케헤헤♪」
				CASEELSE
					PRINTFORML 「완벽해! 그거 정말 식은 죽에 말이었어!」
					PRINTFORML 「나 요리 실력 늘고 있다고 생각하지 않아?」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORML 「휴~ 정말 많은 노력이 들어갔어...」
					PRINTFORML 「요리하는 건 참 힘들지 않아...」
				CASE 2
					PRINTFORML 「그게 네가 하는 방식인가?」
					PRINTFORML 「Why don't you add more secret ingredients?」
				CASE 3
					PRINTFORML 「모든 것이 끝났어~! 괜찮을 거야!」
					PRINTFORML 「결국 이 정도만 먹으면 살이 안 찐다고들 하잖아!」
				CASEELSE
					PRINTFORML 「어라? 벌써 끝났다고?」
					PRINTFORML 「비밀 재료 같은 거 더 추가할 수는 없어?」
			ENDSELECT
		ENDIF
		WAIT
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
