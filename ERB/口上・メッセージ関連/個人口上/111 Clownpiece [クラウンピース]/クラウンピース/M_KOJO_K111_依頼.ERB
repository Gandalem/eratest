;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:111:恋慕 || TALENT:111:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「쿠우우~... 이대로라면 지옥 요정들의 자존심은...」
				CASE 2
					PRINTFORMW 「%CALLNAME:MASTER%! 나를 위해 누군가에게 교훈을 가르쳐줘~☆」
				CASE 3
					PRINTFORMW 「저 자식... 그녀, 정말 대단하네...!」
				CASEELSE
					PRINTFORMW 「헤이 %CALLNAME:MASTER%, 좀 거칠게 다뤄줬으면 하는 사람이 있어☆」
			ENDSELECT
		ELSE
			PRINTFORMW 「어이, %CALLNAME:MASTER%, 잠깐 들어봐! 이 개자식에게 복수해다 줘!」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:111:恋慕 || TALENT:111:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「M-경계심을 풀지 마세요, 알았죠...!」
				CASE 2
					PRINTFORMW 「행운을 빌어!」
				CASE 3
					PRINTFORMW 「포기하지 마, 알았지!」
				CASEELSE
					PRINTFORMW 「내가 광기의 힘을 빌려주는 게 괜찮다고 생각하나?」
			ENDSELECT
		ELSE
			PRINTFORMW 「부탁이야, 나 좀 도와줘~!」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			IF TALENT:111:恋慕 || TALENT:111:思慕
				PRINTFORML 「쿠우, 당신이 나의 상대라면 싸우기 힘들 거예요, %CALLNAME:MASTER%...」
				PRINTFORMW 「하지만 난 여전히 지지 않을 거야! 광란의 시간이야!」
			ELSE
				PRINTFORML 「호호호, 감히 나에게 맞서다니...」
				PRINTFORMW 「뭐, 너에게 무슨 일이 생기든 날 탓하지 마라!」
			ENDIF
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORMW 「바하하하하! 돌아가서 처음부터 다시 시작해~!」
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:111:恋慕 || TALENT:111:思慕
				PRINTFORML 「쿠우, 당신이 나의 상대라면 싸우기 힘들 거예요, %CALLNAME:MASTER%...」
				PRINTFORMW 「하지만 난 여전히 지지 않을 거야! 광란의 시간이야!」
			ELSE
				PRINTFORML 「호호호, 감히 나에게 맞서다니...」
				PRINTFORMW 「뭐, 너에게 무슨 일이 생기든 날 탓하지 마라!」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		IF TALENT:111:恋慕 || TALENT:111:思慕
			PRINTFORMW 「멋지다, 잘했어~! 고마워, %CALLNAME:MASTER%!」
		ELSE
			PRINTFORMW 「오-! %CALLNAME:MASTER%, 결국 해냈군요!」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
