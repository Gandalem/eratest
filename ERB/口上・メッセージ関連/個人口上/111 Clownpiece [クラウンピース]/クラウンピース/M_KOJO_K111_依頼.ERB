;==================================================
;依頼口上・各依頼で共通の口上
;==================================================
@M_KOJO_IRAI_K111(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K111(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K111(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
;●依頼を持ちかけられる時
;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
;【◆口上】
;【依頼データ表示】
;【INPUT（受託するかY/N）】
	IF TALENT:111:恋慕
		PRINTFORMW 「%CALLNAME:MASTER%～! Can you do something for me! Pleeease～!!」
	ELSEIF TALENT:111:思慕
		PRINTFORMW 「Hey %CALLNAME:MASTER%, I got a question, please!」
	ELSE
		PRINTFORMW 「Hey wait up! I need to ask you for a favor!」
	ENDIF
CASE "依頼非受託時"
;●内容だけ見て受託しなかった時
;【L ［あなた］は丁重にお断りした】
;【◆口上】
;【W ［彼女］は残念そうな顔をしている】
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Aw... Aww mannn...」
	CASE 2
		PRINTFORMW 「Phooeyー! Meanie!」
	CASEELSE
		PRINTFORMW 「So that's the way it's gonna be! Well then!」
	ENDSELECT
CASE "依頼受託時"
;●依頼を受託した時
;【W ［あなた］は［彼女］の依頼を受けた】
;【◆口上】
	PRINTFORMW 「Hoorayー! Then, I'll leave it to you!」
CASE "依頼確認時"
;●[366]で依頼内容を依頼人に確認した時
;【◆口上】
;【依頼データ表示】
;【INPUT（破棄するかY/N）】
	PRINTFORML 「Please do it! Please!」
CASE "依頼破棄時"
;●受託した依頼を破棄する時
;【◆口上】
;【W 依頼を破棄しました。】
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Aw... Aww mannn...」
	CASE 2
		PRINTFORMW 「Phooeyー! Meanie!」
	CASEELSE
		PRINTFORMW 「So that's the way it's gonna be! Well then!」
	ENDSELECT
CASE "依頼実行直前"
;●[367]で依頼を実行する時、実行処理の前に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【◆口上】
;【実行時の地の文・ソース等】
;【▼下の口上に続く】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		
	ENDIF
CASE "依頼実行直後"
;●[367]で依頼を実行する時、実行処理の後に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【▲上の口上から続き】
;【◆口上】
;【達成時・CLIENT：▼下の口上に続く】
;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ENDIF
CASE "成功報告時"
;●報告時（成功）
;【依頼実行と報告が同時の時：▲上の口上から続き】
;【◆口上】
;【ソースの入手・アイテム等の報酬獲得】
	IF TALENT:111:恋慕
		PRINTFORMW 「Thank youー, %CALLNAME:MASTER%! You really pulled my chestnuts outta the fire!」
	ELSEIF TALENT:111:思慕
		PRINTFORMW 「Wow～! Thanks a million!!」
	ELSE
		PRINTFORMW 「Oh, nice going!」
	ENDIF
CASE "失敗報告時"
;○直接失敗報告は現在「06_誰か教えて！」のみ
;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
;【◆口上】
;○機嫌の変化や追加のペナルティ等は口上側で処理してください
	SELECTCASE RAND:3
	CASE 1
		;たまに忘れる
		PRINTFORMW 「Whuh? Did I ask you to do that...?」
	CASE 2
		PRINTFORMW 「%CALLNAME:MASTER%! How could you just forget about it!!」
	CASEELSE
		PRINTFORMW 「%CALLNAME:MASTER%～! You broke your promise～!」
	ENDSELECT
	TALENT:111:機嫌 = MIN(TALENT:111:機嫌, 0)
CASE "依頼報告不要"
;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
;○地の文はありません
;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
	
ENDSELECT
RETURN 1

;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================
@M_KOJO_IRAI_1_K111(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;まだ（住み込み以外で）自室ないけど
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORMW 「%CFLAG:111:1099?"Goshujinsama"#"Master"% says that I gotta clean my room... So, uh, you'll gimme a hand, right?」
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
	IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
	;先に掃除してしまっていた場合
	;【◆口上】
	;【W ［彼女］の部屋は十分にきれいだ】
	;【▼そのまま下の口上へ】
		PRINTFORMW 「Whahuh? It's actually not as messy as I remembered!」
		PRINTFORMW 「Hmm～... It's my lucky dayー☆ That must be what this means!」
		RETURN 1
	ELSE
	;一緒に掃除する場合
	;【◆口上】
	;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
	;【▼そのまま下の口上へ】
		PRINTFORMDL Clownpiece's room is insanely messy and cluttered...
		PRINTW 
		SELECTCASE RAND:4
		CASE 1
			PRINTFORMW 「Well then, I'll be the one to give the instructions!」
		CASE 2
			PRINTFORMW 「Hey, wait! What are you doing sniffing around!? You perv!」
		CASE 3
			PRINTFORMW 「Gahh～! Who the heck made my room so messy, anyways...」
		CASEELSE
			PRINTFORMW 「Huh? Just what is this, anyway...? This is just all garbage!」
		ENDSELECT
		RETURN 1
	ENDIF
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	
	RETURN 0
CASE "成功報告時"
;報酬：低級素材
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	PRINTFORMW 「Yeah, now it's spotless! Thanks a tonー!!」
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT
;
