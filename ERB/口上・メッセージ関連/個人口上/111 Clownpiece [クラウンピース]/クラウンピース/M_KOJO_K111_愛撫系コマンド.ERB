	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「...?」
				PRINTFORMW 「무슨 일이야, %CALLNAME:MASTER%? 갑자기 왜 굳은 거야?」
			CASE 1
				PRINTFORMW 「뭐야?! %CALLNAME:MASTER%, 왜 움직이지 않아?」
				PRINTFORMW 「혹시 나만 시간이 멈춘 건가...?」
				CALL HPH_PRINT,@"「그럼, 음, 그냥 좀 재미있게 놀아볼까... BPB」","W"
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
