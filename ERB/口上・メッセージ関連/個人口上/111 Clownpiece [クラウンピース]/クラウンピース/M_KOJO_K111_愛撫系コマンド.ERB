@M_KOJO_MESSAGE_COM_K111_20
CALL M_KOJO_MESSAGE_COM_K111_20_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
	ELSEIF FIRSTTIME("ファーストキス")
		PRINTFORMW 「와아...!」
		CALL HPH_PRINT,@"「ㅅ-그래서 이게 키스구나...흐읍」","W"
		CALL HPH_PRINT,@"「음... 키스는 정말 달콤해HPH」","W"
		;custom code
		CALL SPECIAL_FIRSTKISS(@"%PRINT_DATE_F(DAY)%, 그녀의 첫 키스는 %조사처리(CALLNAME:MASTER,"와")%의 만남 중에 이루어졌다.", TARGET)
	ELSE
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「음냐...흐읍」","W"
				PRINTFORMW 「왠지... 머리가 어지러워...」
			CASE 1
				CALL HPH_PRINT,@"「츄우-후피」","W"
			CASE 2
				PRINTFORMW 「츄우... %RANDKISS("kiss")%... 핥는다...」
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%... 더... HPH」","W"
			CASE 3
				PRINTFORMW 「이번엔 내가 할게!」
				CALL HPH_PRINT,@"「음... 추우... 하프」","W"
				PRINTFORMW 「후와아... 어땠어... %CALLNAME:MASTER%... 기분 좋았어...?」
			CASE 4
				CALL HPH_PRINT,@"「추우호프」","W"
				CALL HPH_PRINT,@"「정말 달콤해...HPH」","W"
				CALL HPH_PRINT,@"「쪽, 쪽」","W"
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
