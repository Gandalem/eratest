@M_KOJO_MESSAGE_COM_K111_0
CALL M_KOJO_MESSAGE_COM_K111_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER && !FLAG:時間停止
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「음... 안 돼, 이건 불공평해...」","W"
				CALL HPH_PRINT,@"「하와아아헵 안느헵 아흔헵」","W"
			CASE 1
				CALL HPH_PRINT,@"「음음흐응 나아음흐응 %CALLNAME:MASTER%, 더 안아줘」","W"
				CALL HPH_PRINT,@"「아아앙! %CALLNAME:MASTER%흐으 좋아해애~흐으」","W"
			CASE 2
				CALL HPH_PRINT,@"「음... 아아... 음... 한꺼번에 몰려올 거야~」","W"
				CALL HPH_PRINT,@"「아아앙흐으으응 쇼 아웨슘므~ㅎㅍㅎ」","W"
		ENDSELECT
		RETURN 1
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
		;	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;		;射精した
		;		IF NOWEX:PLAYER:11
		;			PRINTFORMW
		;			RETURN 1
		;		ELSE
		;			PRINTFORMW
		;			RETURN 1
		;		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;共通
	IF FLAG:時間停止
		RETURN 1
	ELSE
		SELECTCASE RAND:6
			CASE 0
				CALL HPH_PRINT,@"「하아아...」","W"
				CALL HPH_PRINT,@"「당신이 손을 사용하는 방식은... 정말 음란해... HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「아아... 아하안... 흐프」","W"
				CALL HPH_PRINT,@"「M-내 목소리가 HPH 아아, 새어 나오고 있어...HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「아! 후와하안... 아흡... 아아앙...후햣」","W"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%...후후 후후」","W"
			CASE 3
				CALL HPH_PRINT,@"「아아하한...헵 정말 최고야...헵」","W"
			CASE 4
				CALL HPH_PRINT,@"「아항후 나의 가슴들 후후후」","W"
				CALL HPH_PRINT,@"「아앙흐읍 아흡흑 흡흡흥 흐으음흐으읍흐으읍」","W"
			CASE 5
				CALL HPH_PRINT,@"「아흐흠 아흐흠 히야아흠」","W"
				CALL HPH_PRINT,@"「아, 천천히해. 하프 너무 거칠어. 하프 좋아. 아응.하프」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;1,クンニ
;==================================================

@M_KOJO_MESSAGE_COM_K111_1
CALL M_KOJO_MESSAGE_COM_K111_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「후우... 정말 더럽군...」
		CALL HPH_PRINT,@"「아!! 아아... 아...흐읍 그만해...흐읍흐읍」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		RETURN 1
		;継続クンニ
	ELSEIF PREVCOM == SELECTCOM
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하와와아흐프 아하함프 아함느프프」","W"
				CALL HPH_PRINT,@"「더좋아 더좋아 정말 좋아~~하프ㅎㅍ」","W"
			CASE 1
				CALL HPH_PRINT,@" 「아아헵 아아한헵」","W"
				CALL HPH_PRINT,@"「더 세게핥아라 HPHHPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%님, 어때요? 음... 맛이 좋아요? BPB」","W"
				CALL HPH_PRINT,@"「내 보지가 엄청 맛있어? BPB」","W"
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「또핥을 거야...?」
				CALL HPH_PRINT,@"「오-오케이... 응... 내 보지 핥아줘...흐읍프ㅎ」","W"
			CASE 1
				PRINTFORMW 「내 보지 핥고 싶어? 좋아, 그럼 그렇게 해!」
				CALL HPH_PRINT,@"「가서 거기 아래를 핥고 내려라 HPH」","W"
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
