; Modular ERB: 個人口上/111 Clownpiece [クラウンピース]/クラウンピース/M_KOJO_K111_性交系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;性交系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;各種Ｖ挿入は共通（手抜き）

@M_KOJO_MESSAGE_COM_K111_VSEX(ARG)
SIF FLAG:時間停止
	RETURN 1
IF TCVAR:破瓜 == 1
	PRINTFORMW 「후으!? 잠-, 잠깐만요!」
	PRINTFORMW 「저-벌써 안에...?」
	PRINTFORMW 「좀 무섭긴 하지만, 괜찮아요...」
	CALL HPH_PRINT,@"「당신과 처음을 하게 되었어요, %CALLNAME:MASTER%, 너무 행복해요HPH」","W"
	PRINTFORMW 「그래서 최선을 다할 거야!」
	;騎乗位
	IF ARG == 65
		CALL HPH_PRINT,@"「자, 이제 %조사처리(CALLNAME:MASTER,"의")% 성기를 넣을게, 알겠지 HPH」","W"
		;それ以外
	ELSE
		CALL HPH_PRINT,@"「네 거, 스윽 내 보지 안에 박아 넣어줘 HPHHPH」","W"
	ENDIF
ELSE
	SELECTCASE RAND:5
		CASE 0
			CALL HPH_PRINT,@"「응호해줘 응호해줘 응호해줘 응호해줘」","W"
		CASE 1
			CALL HPH_PRINT,@"「%CALLNAME:MASTER%HPH %CALLNAME:MASTER%HPH 아아ㅎ프」","W"
		CASE 2
			CALL HPH_PRINT,@"「음음음 아아아 정말 좋다」","W"
			CALL HPH_PRINT,@"「더 많은 HPH 더 많은 HPHHPH」","W"
		CASE 3
			CALL HPH_PRINT,@"「아흐흑 아앙흑 하안흑 더 하더 하이즈」","W"
		CASE 4
			CALL HPH_PRINT,@"「아아앙 하프 좋네 하프 %조사처리(CALLNAME:MASTER,"의")% 큰 거 하프」","W"
			CALL HPH_PRINT,@"「아-맛있다HPH 정말 좋다HPH 아아HPH」","W"
	ENDSELECT
ENDIF
RETURN 1
;Ａ挿入（手抜きというかない）

