		;すでに覚えてても最初の一回目は表示する
		IF DISHNAME == "アビスバーガー" && FIRSTTIME("アビスバーガー")
			PRINTFORML 「Whuh? You want me to teach you some kind of special dish?」
			PRINTFORMW 「Okay then, I'll show you the style of hamburger that's super popular in my old hometown of Hell☆」
			PRINTL 
			PRINTFORMW 「Ummm... Let's see... The ingredients are meat, and cheese, and sauce, and spices...」
			PRINTFORMW 「And this and that and this... Wait, was it this instead? Oh, there was this too!」
			PRINTFORMW 「Vegetables are evil! But veggie fanatics are a pain, so let's use a little vegetable oil...」
			PRINTL 
			PRINTFORML 「Yeah, so you just sandwich it all between two buns, and it's done!」
			PRINTFORML 「Well? Did you remember all that?」
		ELSE
			;ハンバーガーフラグ
			IF TCVAR:111:356
				PRINTFORML 「Whahuh!? You can make me a hamburger!?」
				IF TALENT:111:恋慕
					CALL HPH_PRINT,@"「Kehehe, you're so nice, %CALLNAME:MASTER%～HPH」","L"
					PRINTFORML 「Let's make it together♪」
				ELSEIF TALENT:111:思慕
					PRINTFORML 「Sheesh %CALLNAME:MASTER%, you sure are thoughtful～!」
					PRINTFORML 「Let me help out too!」
				ELSE
					PRINTFORML 「Sheesh %CALLNAME:MASTER%, you sure know what I like!」
					PRINTFORML 「I'm gonna help too!」
				ENDIF
			ELSE
				PRINTFORML 「Whatcha doing? Are you gonna make a hamburger?」
				PRINTFORML 「Alrightー! I'm gonna help too!」
			ENDIF
			IF DISHNAME == "アビスバーガー"
				WAIT
				PRINTFORMW 「Ooh! Do you wanna make an Abyss Burger? Awesome!」
				PRINTFORMW 「Yeah, that's right, the ingredients are this and this and thatー...」
				PRINTFORML 「Alrightー, and now you just stack everything up～」
				PRINTFORML 「Because the order of the ingredients is super important, you know!」
			ELSE
				IF ABL:111:料理技能 >= 1
					SELECTCASE RAND:4
					CASE 1
						PRINTFORML 「That's it! Let's make it a cheeseburger!」
						DISH_TASTE += "チーズ/"
						TCVAR:111:357 = 1
					CASE 2
						PRINTFORML 「That's it! Let's make it a spicy burger!」
						DISH_TASTE += "スパイス/辛い/"
						TCVAR:111:357 = 2
					CASE 3
						;アビスバーガーは実装されたのでエッグバーガーに
						PRINTFORML 「That's it! Let's make it an egg burger!」
						DISH_TASTE += "卵/甘い/"
						TCVAR:111:357 = 3
					CASEELSE
							IF ABL:111:料理技能 >= 3
								PRINTFORML 「That's it! Let's make it a fairy burger!」
								DISH_TASTE += "きらめき/辛い/"
								TCVAR:111:357 = 4
							ELSE
								;はずれ
							ENDIF
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	CASE "お子様ランチ", "紅魔ランチ"
		PRINTFORML 「Oh, you're making a kid's meal!」
		PRINTFORML 「A flag! Stick a little flag on top!」
	CASE "クッキー"
		PRINTFORML 「You're making cookies!?」
		PRINTFORML 「I wanna do it too!!」
		PRINTW 
		PRINTFORML 「This one's %CFLAG:111:1099?"Goshujinsama"#"Master"%ー, and this one's %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%!」
		TCVAR:111:357 = 1
		IF TALENT:111:恋慕 && !RAND:8
			PRINTFORML 「Ahh! Ummm, and this one's... Kinda supposed to be you, %CALLNAME:MASTER%...」
			TCVAR:111:357 = 2
		ENDIF
		PRINTFORML 「How about it? Do they look like them?」
	CASE "三色地獄そぼろ丼"
		PRINTFORML 「Whoaaah! That's a Three-colored Soborodon of Hell!」
		PRINTFORML 「I'll lend you a hand～!」
	CASEELSE
		IF DISH_TYPE == "デザート"
			SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「Ah! You're making sweets!」
			CASE 2
				PRINTFORML 「Are you gonna make something sweet?」
			CASEELSE
				PRINTFORML 「You're making a dessert!?」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「Ah, you're making food!」
			CASE 2
				PRINTFORML 「Are you making something to eat?」
			CASEELSE
				PRINTFORML 「Are you cooking?」
			ENDSELECT
		ENDIF
		SELECTCASE RAND:5
		CASE 1
			PRINTFORML 「Let me do it too!」
		CASE 2
			PRINTFORML 「I wanna try it too!」
		CASE 3
			PRINTFORML 「I'll lend you a hand～!」
		CASE 4
			PRINTFORML 「I wanna help!」
		CASEELSE
			IF TALENT:[[クラウンピース]]:思慕 || TALENT:[[クラウンピース]]:恋慕
				PRINTFORML 「Let's make it togetherー♪」
			ELSEIF DISH_TYPE == "デザート"
				PRINTFORML 「I'll help you make it so let me have some of it too!」
			ELSE
				PRINTFORML 「I'll help you out!」
			ENDIF
		ENDSELECT
	ENDSELECT
	PRINTW 
	;野菜を抜く
	;野菜抜き処理は本体側に移動しました
	;主人が抜いてようが表示されるのは仕様ってことで
	IF STRCOUNT(DISH_TASTE, "野菜抜き/")
		PRINTFORML 「Gwuh! This has vegetables in it...」
		PRINTFORML 「Let's secretly take them out!」
	ENDIF
	;野菜入り野菜抜き（？）だといけないので
	IF STRCOUNT(DISH_TASTE, "ハンバーガー") && TCVAR:111:356
		PRINTFORML 「Holy moly! It looks super delicious～!」
		PRINTFORML 「Let's hurry up and eat it right away♪ You're gonna eat it now, right? I can have some too, right??」
	;禁断の料理
	ELSEIF STRCOUNT(DISH_TASTE, "ローター")
		PRINTFORML 「It's finished... But... What the heck is it, anyway...?」
		PRINTFORML 「A-Are you really gonna eat this...?」
	ELSE
		IF ABL:111:料理技能 >= 3
			SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「All～ done♪」
				PRINTFORML 「Wowie! It looks super tasty～!」
			CASE 2
				PRINTFORML 「This was no big deal compared to what I usually make～」
				PRINTFORML 「How about it? I did a good job, right?」
			CASE 3
				PRINTFORMW 「All finished! Now gimme my reward, gimme!」
				PRINTFORMDW Pat-pat...
				PRINTFORML 「Kehehe♪」
			CASEELSE
				PRINTFORML 「Perfectー! That was actually pretty easy, you know.」
				PRINTFORML 「I wonder if I'm getting better at cooking?」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「Phewー, that took a lot of work....」
				PRINTFORML 「Cooking sure is hard, you know...」
			CASE 2
				PRINTFORML 「So that's how you do it?」
				PRINTFORML 「Can't you add more secret ingredients or something?」
			CASE 3
				PRINTFORML 「All finished～! I think this should be fine!」
				PRINTFORML 「After all, they say you won't gain weight if you only eat this much!」
			CASEELSE
				PRINTFORML 「Awhuh? It's already done?」
				PRINTFORML 「Can't you add more secret ingredients or something?」
			ENDSELECT
		ENDIF
	ENDIF
	WAIT
ENDIF
RETURN 1
