;352,告白する
;==================================================

@M_KOJO_MESSAGE_COM_K111_352
CALL M_KOJO_MESSAGE_COM_K111_352_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_352_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;した
	IF TFLAG:SELECTCOMの分岐
		PRINTFORMW 「엣... 진심이야!?」
		;初めて
		IF FIRSTTIME("告白")
			PRINTFORMW 「그럼, 네가 말하는 "연모"라는 건...?」
			PRINTFORMW 「그게 내가 정말 너를 사랑한다는 뜻이야...?」
			CALL HPH_PRINT,@"「정말로 사실이구나... 케헤헤헤헵」","W"
			PRINTFORMW 「기뻐! 정말 아주아주 기쁘다!!」
			PRINTFORMW 「...나도 똑같이 느껴왔으니까!」
			PRINTFORMW 「나도 당신을 좋아해요, %CALLNAME:MASTER%! 사랑해요!」
			PRINTFORMW 「솔직히 좀 성급해지기 시작했고, 이걸 가지고 놀려던 참이었어요, %CALLNAME:MASTER%...」
			PRINTFORMW 「하지만 그렇게 분명하게 말해주니, 내 모든 짜증이 날아가 버렸어♪」
			;一度フった,都合のいい奴じゃ！
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 그렇다는 건 정말로 나를 연모하게 되었다는 뜻이야...?」
			PRINTFORMW 「이, 이래서 드디어 내 승리구나!」
			CALL HPH_PRINT,@"「농담이었어♪ 네가 나를 선택해줘서 정말 행복해」","W"
		ENDIF
		CALL HPH_PRINT,@"「그럼 이제부터 우리는 「%PRINT_MALE("boyfriend and girlfriend:lovers", MASTER)%HPH」가 될 거야.」","W"
		CALL HPH_PRINT,@"「크흐흐후훗, 정말 행복해~ㅋㅎ」","W"
		;言葉に詰まる
	ELSE
		PRINTFORML 「?」
		PRINTFORMW 「무슨 일이야, %CALLNAME:MASTER%? 몸이 안 좋은 거야?」
		PRINTFORMW 「...어떻게 이상해-」
	ENDIF
ENDIF
RETURN 1
