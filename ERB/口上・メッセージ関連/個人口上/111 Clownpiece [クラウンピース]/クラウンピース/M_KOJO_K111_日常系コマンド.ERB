RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;デフォルト（ぼくのかんがえたクラウンピースちゃん…もとい自前CSV（受け入れてくれた作者さんには大感謝））
	;では[酒に強い]のでまずい＞どぶろく,おいしい＞清酒
	;口上が出る時点で既に酒気は加算されてる,ぐでぐで口上は果たして表示できるのか
	IF ALCOHOL_FACE(111) == "ぐでぐで"
		PRINTFORMW 「캬하하하♪ 나는 쉐이크를 너무너무 좋아해♪♪♪」
		;現在は無い
	ELSEIF ALCOHOL_FACE(111) == "へべれけ"
		PRINTFORMW 「더, 더, 더~~~♪」
	ELSEIF ALCOHOL_FACE(111) == "酔いどれ"
		PRINTFORMW 「케헤헤~♪ 아직 안 끝났어~~♪」
	ELSE
		PRINTFORMW 「우와! 사케, 사케♪」
	ENDIF
	;どぶろく
	IF ALCOHOL_TASTE(TFLAG:194) < 10
		IF ALCOHOL_FACE(111) == "ぐでぐで"
			PRINTFORMW 「이 쉐이크에 대체 뭐가 들어있는 거야? 여기 양조사 좀 불러!」
		ELSEIF ALCOHOL_FACE(111) == "酔いどれ"
			PRINTFORMW 「아~♪ 이런 걸로 마시면 전혀 취하지 않을 거야~~」
		ELSE
			PRINTFORMW 「음♪ 좀 아쉽네, 내 생각엔~」
		ENDIF
		;清酒
	ELSEIF ALCOHOL_TASTE(TFLAG:194) >= 15
		IF ALCOHOL_FACE(111) == "ぐでぐで"
			CALL HPH_PRINT,@"「이거~ ♪ 좋아해~ ♪ 너를 좋아하는 만큼 이거 정말 마음에 들어, %CALLNAME:MASTER%HPH」","W"
		ELSEIF ALCOHOL_FACE(111) == "酔いどれ"
			PRINTFORMW 「이 술 정말 맛있네~~♪ 도대체 %조사처리(CALLNAME:MASTER,"는")% 이런 맛있는 걸 어디에 숨겨둔 거야~~??」
		ELSE
			PRINTFORMW 「이거 진짜 맛있다~♪ 아직 더 있겠지? 여기 줘♪ 안녕♪」
		ENDIF
		;鬼殺し
	ELSE
		IF ALCOHOL_FACE(111) == "ぐでぐで"
			PRINTFORMW 「Hic!! @ # ! $ \%  ! ? * * * * Hic!!」
		ELSEIF ALCOHOL_FACE(111) == "酔いどれ"
			PRINTFORMW 「쇼 스트롱그! 이딴 걸 뭘 하려는 거야, %조사처리(CALLNAME:MASTER,"는")%(는)~~!?」
		ELSE
			PRINTFORMW 「꺄아~! 이거 엄청 독하다! 긴장되는 게 느껴져~!!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
