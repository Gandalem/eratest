ENDIF

@M_KOJO_MESSAGE_COM_K111_626
CALL M_KOJO_MESSAGE_COM_K111_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_626_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			PRINTFORMW 「꺄아악~! 더는 못 참겠어~」
			PRINTFORMW 「%CALLNAME:MASTER%, 쇼핑할 때 너무 오래 걸려~」
			;やっぱりやめる（見送り）
		CASE -1
			PRINTFORMW 「흥~! 여기에서 그렇게 많은 시간을 보냈는데 아무것도 안 샀어-!?」
			;400点未満（BAD）
		CASE 1
			PRINTFORMW 「음, 이걸 나한테 사준 거야...?」
			PRINTFORMW 「흠... 어, 고마워...」
			;400点～699点（NOMAL）
		CASE 2
			PRINTFORMW 「우와! 나한테 사주려고?」
			PRINTFORMW 「야호♪ 고마워ー!」
			;700点以上（GOOD）
		CASE 3
			;念の為RESULTSを避難させてリセット
			LOCALS:1 = %RESULTS%
			CALL GIFTNAME(TCVAR:[[クラウンピース]]:今日の贈り物, [[クラウンピース]])
			LOCALS = %RESULTS%
			RESULTS = %LOCALS:1%
			IF !RAND:2
				PRINTFORMDL 클라운피스는 【%LOCALS%}을(를) 애정 어린 눈으로 바라본다.
				PRINTW 
				PRINTFORMW 「세상에...! 정말 멋지다...」
				PRINTFORML 「이것 좀 사세요, %CALLNAME:MASTER%~」
				PRINTW
				PRINTFORMDL 어쩔 수 없어, 당신의 지갑은 클라운피스의 순수하고 천진난만한 요청에 저절로 움직이게 되니까...
			ELSE
				PRINTFORML 「이거 한번 봐봐ー」
				PRINTW 
				PRINTFORMDW 클라운피스가 상점에서 주운 무언가를 들고 행복하게 당신에게 다가온다.
				PRINTFORMDL 그녀의 손에는 【%LOCALS%】을 꼭 쥐고 있는 것 같다.
				PRINTW 
				PRINTFORML 「헤이~ 헤이~!」
				PRINTW 
				PRINTFORMDL 클라운피스의 순진한 미소에 압도되어, 당신은 그녀의 애원에 결국 넘어가게 된다...
			ENDIF
			PRINTFORMDL 당신은 혼잣말로 클라운피스가 광기의 횃불보다 훨씬 더 무서운 힘을 가지고 있다고 생각한다.
			PRINTW 
			PRINTFORML 「야호~ 정말 고마워~♪」
			CALL HPH_PRINT,@"「당신을 사랑해요, %CALLNAME:MASTER%ーHPH」","W"
	ENDSELECT
ENDIF
RETURN 1
