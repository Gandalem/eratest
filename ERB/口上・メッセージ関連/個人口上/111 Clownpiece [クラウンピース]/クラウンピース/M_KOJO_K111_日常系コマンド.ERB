ELSE
	RETURN 0
ENDIF

@M_KOJO_MESSAGE_COM_K111_626
CALL M_KOJO_MESSAGE_COM_K111_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_626_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:194
	;ひやかし
	CASE -2
		PRINTFORMW 「Gyaaaahー! I can't take this any longerー!」
		PRINTFORMW 「%CALLNAME:MASTER%, you take way too much time when you go shopping～」
	;やっぱりやめる（見送り）
	CASE -1
		PRINTFORMW 「Huhー! Even though we spent so much time here you didn't even buy anythingー!?」
	;400点未満（BAD）
	CASE 1
		PRINTFORMW 「Um, you bought this for me...?」
		PRINTFORMW 「Hmmmー... Uh, th-thanks...」
	;400点～699点（NOMAL）
	CASE 2
		PRINTFORMW 「Whuh! You're gonna buy it for me!?」
		PRINTFORMW 「Yippee♪ Thanksー!」
	;700点以上（GOOD）
	CASE 3
		;念の為RESULTSを避難させてリセット
		LOCALS:1 = %RESULTS%
		CALL GIFTNAME(TCVAR:[[クラウンピース]]:今日の贈り物, [[クラウンピース]])
		LOCALS = %RESULTS%
		RESULTS = %LOCALS:1%
		IF !RAND:2
			PRINTFORMDL Clownpiece stares adoringly at the 【%LOCALS%】.
			PRINTW 
			PRINTFORMW 「Holy moly...! It's so nifty...」
			PRINTFORML 「Hey %CALLNAME:MASTER%, buy this one～」
			PRINTW
			PRINTFORMDL You can't help it, your wallet just moves on its own in response to Clownpiece's pure and innocent request...
		ELSE
			PRINTFORML 「Heyー heyー, get this oneー」
			PRINTW 
			PRINTFORMDW Clownpiece happily skips up to you, carrying something she's picked up from someplace in the shop.
			PRINTFORMDL It looks like she's clutching a 【%LOCALS%】 in her hands.
			PRINTW 
			PRINTFORML 「Heyー heyー!」
			PRINTW 
			PRINTFORMDL Won over by Clownpiece's innocent smile, you inevitably give in to her begging...
		ENDIF
		PRINTFORMDL You then muse to yourself, Clownpiece actually possesses a power far more terrifying than her torch of madness.
		PRINTW 
		PRINTFORML 「Yayー! Thanks a million～♪」
		CALL HPH_PRINT,@"「I love you, %CALLNAME:MASTER%ーHPH」","W"
	ENDSELECT
ENDIF
RETURN 1
