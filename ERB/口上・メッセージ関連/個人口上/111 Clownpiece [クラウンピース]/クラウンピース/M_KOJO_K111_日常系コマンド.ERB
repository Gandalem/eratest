;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K111_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_300_1
#DIM POINT
#DIM デート会話, 120
#DIM 一回会話
;日が変わってたらデート会話リセット
SIF !TCVAR:111:353
	VARSET デート会話
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	RESETCOLOR
	;ここに口上書いて下さい
	IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 말을 걸려고 하지만, 그녀는 너무 만취해서 당신이 무언가 하려 한다는 것을 알아채지 못한다.
		;会話不能の地の文は恋慕でない場合は省略できず、恋慕の時は表示されないので、ここではどちらの場合も同じように表示されるようにする
	ELSEIF TCVAR:111:会話不能
		IF TALENT:111:恋慕
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 말을 걸어보려 하지만 할 말이 떠오르지 않는다.
			PRINTFORMDW 어색한 침묵이 방을 가득 채운다...
		ENDIF
	ELSE
		;デート会話
		IF TALENT:111:恋慕 && FLAG:デート相手 == 111 && DATENAME_SPOT() != "on the road" && !デート会話:(CFLAG:111:現在位置 / 10)
			CLEARLINE 2
			PRINTFORML %DATENAME_SPOT()%에서 데이트를 한다.
			DRAWLINE
		ENDIF
		;custom code
		CALL CONVERSATION()
	ENDIF
	PRINTW 
	CALL M_KOJO_COLOR_K111
	IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
		IF !RAND:2
			CALL HPH_PRINT,@"「키야하하하♪ 샤키를 너무너무 사랑해♪ 나는 샤케와 당신도 사랑해요, %CALLNAME:MASTER%HPH」","L"
			PRINTFORMW 「～～Hic!! @ # ! $ \% ! ? * * * * Hic!!」
		ELSE
			PRINTFORML 「아니 그래~ 야 이봐, %CFLAG:111:1099?"Goshushinshama"#"Masher"% 완전히 취했어~~ 야 이봐~~~~ 히끅!」
			PRINTFORMW 「하지만 나... 히끅~~ 히끅~~ 응, 하하하하!!」
		ENDIF
		PRINTFORML 
		PRINTFORMDW 그것을 대화라고 부르기도 민망하다…
	ELSEIF M_KOJO_K111_FUKIGEN(111)
		PRINTFORML 「도대체 왜 그래!?」
		PRINTFORMW 「다른 여자나 가서 괴롭히고, 나 좀 내버려 둬!」
		;会話不能
	ELSEIF TCVAR:111:会話不能
		PRINTFORML 「방금 그 이야기 나한테 들려줬잖아―」
		PRINTFORMW 「지루해~」
		;失敗
	ELSEIF TFLAG:SELECTCOMの分岐 == -1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「헤이~, 그냥 내가 하는 말에 고개만 끄덕이고 있는 거지~」
				PRINTFORMW 「관심 없으면 솔직하게 말해봐!」
			CASE 2
				PRINTFORML 「%CALLNAME:MASTER%, 가끔 정말 기술적인 걸 얘기하는 것 같아, 있잖아...」
				PRINTFORMW 「완전 지루해ー」
			CASEELSE
				PRINTFORML 「...음....」
				PRINTFORMW 「네가 무슨 말을 하려는 건지 잘 모르겠어.」
		ENDSELECT
		;夏,野外,汗フラグなし,昼間,地上,晴れで確定
	ELSEIF DAY:2 == 2 && OUTROOF(CFLAG:111:現在位置) && !TCVAR:111:350 && INRANGE(TIME, 600, 960) && M_KOJO_K111_EARTH(CFLAG:111:現在位置) && 天候 < 2
		;暑いの大好きだった
		SELECTCASE RAND:5
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%, 더워? 오늘은 꽤 따뜻한 날이잖아, 그렇지 않아?」
				PRINTFORMW 「캬하하! 마음에 들어! 그 더위에 지친 표정이라니, 내 영혼의 양식이야♪」
				TALENT:111:機嫌 = 1
				;			PRINTFORML 「It's so hot every single day...」
				;			PRINTFORMW 「But compared to the Hell of Blazing Fires, it's still cooler, I guess.」
			CASE 2
				PRINTFORML 「진짜, 요즘 매일 더웠어...」
				PRINTFORMW 「최고야, 피가 끓어오르고 몸이 날아갈 것 같다고!!」
				;			PRINTFORMW 「But how can it get so hot here on the surface...」
			CASE 3
				PRINTFORML 「나는 지옥 출신이야, 태어나서 자랐다고!」
				PRINTFORMW 「뜨거운 여름 햇살이 너무 좋아~♪」
			CASE 4
				PRINTFORML 「이 강렬한 햇살을 받으면, 마치 내 안쪽 깊은 곳에서 힘이 샘솟는 것 같아!」
				PRINTFORMW 「우오오오~!! 긴장감이 고조되는 게 느껴져!!」
				TALENT:111:機嫌 = 1
			CASEELSE
				PRINTFORML 「불타는 불지옥이 이 여름 햇살보다 훨씬 뜨겁다!」
				PRINTFORMW 「하지만 그럼에도 불구하고 태양의 열은 에너지로 가득 차 있고, 그 질감이 다르단 말이야~」
				;			PRINTFORML 「Goodー... Heatー...」
				;			PRINTFORMW 「%CALLNAME:MASTER%, how are you holding up in this heatー?」
		ENDSELECT
		PRINTL 
		PRINTFORMDL 클라운피스는 여름에 짧고 몸에 딱 붙는 스패츠를 입는 것을 좋아하는 것 같다.
		PRINTFORMDW 그녀는 후끈한 여름 더위 속에서 꽤 멋져 보인다...
		TCVAR:111:350 = 1
		;プレゼント会話１（プレゼントのお礼）,フラグ発生から5日以上
	ELSEIF CFLAG:[[クラウンピース]]:1005 && DAY - CFLAG:[[クラウンピース]]:1005 >= 5
		PRINTFORMW 「아, 맞아요! 오늘 당신께 이걸 드리려고 계획하고 있었어요, %CALLNAME:MASTER%!」
		;12日以上
		SIF DAY - CFLAG:[[クラウンピース]]:1005 >= 12
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%(는) 이미 잊어버렸을지도 모르겠지만...」
		PRINTFORMW 「봐, 저번에 말했던 감사 선물이야!」
		SELECTCASE RAND:8
			CASE 1
				LOCALS:1 = Maddening
			CASE 2
				LOCALS:1 = Infernal
			CASE 3
				LOCALS:1 = Clown's
			CASE 4
				LOCALS:1 = Hand-made
			CASEELSE
				LOCALS:1 = Stars & Stripes
		ENDSELECT
		SELECTCASE RAND:8
			CASE 1
				LOCALS:2 = Handkerchief
			CASE 2
				LOCALS:2 = Strap
			CASE 3
				LOCALS:2 = Charm
			CASE 4
				LOCALS:2 = Mug
			CASE 5
				LOCALS:2 = Lamp
			CASE 6
				LOCALS:2 = Walking Stick
			CASE 7
				LOCALS:2 = Mana Stone
			CASEELSE
				IF IS_FEMALE(MASTER) ;custom code
					LOCALS:2 = Ribbon
				ELSE
					LOCALS:2 = Necktie
				ENDIF
		ENDSELECT
		CALL GIFT_ORDER_MADE_FROM_CHARA([[クラウンピース]], LOCALS:1, LOCALS:2)
		PRINTL 
		CALL COLORMESSAGE(@"당신은 클라운피스에게 【%ARTICLE(RESULTS)%】를 받는다!", C_AQUA, 2)
		PRINTL 
		PRINTFORMW 「아니야, 이걸 너한테 주는 건 고마움의 표시니까, 나한테 고맙다고 할 필요 없어!」
		CFLAG:[[クラウンピース]]:1005 = 0
		;プレゼント会話２（クリスマスプレゼント）,フラグ発生から1日以上12日以内
	ELSEIF CFLAG:[[クラウンピース]]:1006 && INRANGE(DAY - CFLAG:[[クラウンピース]]:1006, 1, 12)
		PRINTFORMW 「아, 음, %CALLNAME:MASTER%... 저기, 이거 드리려고요!」
		;年越してる
		SIF DAY - CFLAG:[[クラウンピース]]:1006 > 7
			PRINTFORML 「벌써 꽤 늦었다는 건 알지만...」
		PRINTFORMW 「모두가 크리스마스 선물을 받는 걸 언제나 기뻐하잖아!」
		PRINTFORMW 「그럼 이걸 줄게!」
		SELECTCASE RAND:8
			CASE 1
				LOCALS:1 = Christmas
			CASE 2
				LOCALS:1 = Bethlehem's
			CASE 3
				LOCALS:1 = Santa Clause
			CASE 4
				LOCALS:1 = Reindeer
			CASE 5
				LOCALS:1 = Holy Night
			CASE 6
				LOCALS:1 = Snowy
			CASE 7
				LOCALS:1 = Stars & Stripes
			CASEELSE
				LOCALS:1 = Snow & Stars
		ENDSELECT
		SELECTCASE RAND:8
			CASE 1
				LOCALS:2 = Watch
			CASE 2
				LOCALS:2 = Lamp
			CASE 3
				LOCALS:2 = Mittens
			CASE 4
				LOCALS:2 = Card
			CASEELSE
				LOCALS:2 = Snowglobe
		ENDSELECT
		CALL GIFT_ORDER_MADE_FROM_CHARA([[クラウンピース]], LOCALS:1, LOCALS:2)
		PRINTL 
		CALL COLORMESSAGE(@"당신은 클라운피스에게【%ARTICLE(RESULTS)%】를 받았다!", C_AQUA, 2)
		PRINTL 
		PRINTFORMW 「내년에 네 차례야, 알겠지!!」
		CFLAG:[[クラウンピース]]:1006 = 0
		;デート会話
	ELSEIF FLAG:デート相手 == [[クラウンピース]] && DATENAME_SPOT() != "on the road" && !デート会話:(CFLAG:111:現在位置 / 10)
		POINT = CFLAG:111:現在位置 / 10
		;▼博麗神社
		SELECTCASE STR:(POINT + 6000)
			CASE "桜並木の鳥居"
				;春
				IF DAY:2 == 1
					PRINTFORML 「여기 벚꽃이 정말 아름다워!」
					PRINTFORMW 「처음 봤을 때 나한테 엄청난 인상을 남겼어!」
					;春以外
				ELSE
					PRINTFORML 「봄에는 여기 벚꽃이 정말 예쁘다!」
					PRINTFORMW 「매년 봄엔 꼭 벚꽃놀이를 가려고 노력한다~♪」
				ENDIF
			CASE "神社境内"
				PRINTFORML 「%CALLNAME:MASTER%, 저 학원의 신사 maiden을 조심해!」
				PRINTFORMW 「농담이 들키면, 그녀가 항상 제일 먼저 너를 날려버릴 거거든.」
			CASE "神社本堂"
				PRINTFORML 「이 신사에 신이 있다는 거 알고 있었어?」
				PRINTFORMW 「여기 신님이 %CFLAG:111:1099?"Goshujinsama"#"Master"%～...만큼 강할까.」
			CASE "神社縁側"
				;TW内の設定では別荘ということにしておく
				PRINTFORML 「내 휴가집은 바로 여기 신사 아래에 있어ー」
				PRINTFORMW 「정확히 왜 그런지는 모르겠지만, 어쩐지 신사 지하의 존재가 내 기질과 정말 잘 맞는 것 같아.」
			CASE "妖精の大樹"
				;誰かいる
				IF GROUPMATCH(CFLAG:[[クラウンピース]]:現在位置, CFLAG:[[サニー]]:現在位置, CFLAG:[[ルナ]]:現在位置, CFLAG:[[スター]]:現在位置)
					PRINTFORML 「여기가 내 요정 친구들이 사는 곳이야!」
					PRINTFORMW 「잠깐 놀자ー!」
					;留守
				ELSE
					PRINTFORML 「여기가 내 요정 친구들의 집인데...」
					PRINTFORMW 「지금 아무도 집에 없는 것 같아...」
				ENDIF
			CASE "夢幻遺跡"
				PRINTFORML 「여기는 어디지-? 정말 넓네...」
				PRINTFORMW 「이게 뭐야? 에이이!」
				;▼命蓮寺
			CASE "お地蔵通り"
				PRINTFORML 「여기 자주 안 와, 있잖아.」
				PRINTFORMW 「정확히 왜 그런지는 모르겠지만, 어쩐지 요정에게 사찰은 좋지 않은 곳인 것 같아.」
			CASE "枝垂れ柳の下"
				PRINTFORML 「오오, 정말 무서운 나무야!」
				PRINTFORMW 「유령들이 붙어 사는 것 같아, 걸걸!」
			CASE "命蓮寺境内"
				PRINTFORML 「이게 내가 들었던 요괴 사찰인가 궁금하네~」
				PRINTFORMW 「응, 뭔가 수상한 마력이 느껴지는 게 확실해!」
			CASE "命蓮寺方丈"
				PRINTFORML 「헤이 %CALLNAME:MASTER%, 이 곳에서 사람들은 뭘 하는 걸까?」
				PRINTFORMW 「왠지 여기 모든 사람이 엄청 바빠 보여...」
			CASE "墓地"
				PRINTFORML 「와아~!! 무덤이야~♪」
				PRINTFORMW 「모두 지옥으로 와~♪」
			CASE "神霊廟広場"
				PRINTFORML 「와아~! 정말 거대하고 화려한 문이네!」
				PRINTFORMW 「여기 사람들은 얼마나 잘난 체하는지 완전 알겠다~」
			CASE "神霊廟道場"
				PRINTFORML 「이곳이 그 은둔자의 도장인가요?」
				PRINTFORMW 「은둔자라니~ %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%님이 예전에 누군가 언급했던 것 같아~」
				;▼人里
			CASE "広場"
				PRINTFORML 「오! 저기 아주 쉬운 표적이 있네!」
				PRINTFORMW 「장난 좀 쳐보자!」
			CASE "商家町"
				PRINTFORML 「이봐, %CALLNAME:MASTER%! 저기로 가자!」
				PRINTFORMW 「Ah! Buy that for me! Buy it! Hey! Please!」
			CASE "呑屋小道"
				PRINTFORML 「오, 여기 이자카야가 있네!」
				PRINTFORMW 「역시 사케 냄새를 맡을 수 있는 곳이겠군!」
			CASE "寺子屋"
				PRINTFORML 「인간들은 여기서 학교에 가는 걸까? 음...」
				PRINTFORMW 「잠깐 낙서해도 괜찮을까?」
			CASE "大衆浴場"
				IF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 < 360
					PRINTFORML 「후우~! 상쾌해~!」
					PRINTFORMW 「하지만 %CALLNAME:MASTER%, 왜 우리를 같이 목욕하게 해주지 않는 거지?」
				ELSE
					PRINTFORML 「와아~!! 목욕이네~♪」
					PRINTFORMW 「저런 커다란 온수통 같은 욕조가 있나요~?」
				ENDIF
			CASE "連れ込み宿"
				;入った時点で合意取得するのね…,うふふ前か後かは絶頂したかで判断するので事前に絶頂させてるとちょっと齟齬
				IF EX:111:Ｃ絶頂 + EX:111:Ｖ絶頂 + EX:111:Ａ絶頂 + EX:111:Ｂ絶頂 + EX:111:Ｍ絶頂
					IF TALENT:111:処女
						CALL HPH_PRINT,@"「...케헤헤헤헤BPB」","W"
					ELSE
						CALL HPH_PRINT,@"「...HPH」","W"
					ENDIF
				ELSE
					IF TALENT:111:処女
						CALL HPH_PRINT,@"「야, 여기는 말이지, 음... 케헤헤헤... 비피비」","W"
					ELSE
						CALL HPH_PRINT,@"「서둘러 HPH, 가자 HPH」","W"
					ENDIF
				ENDIF
			CASE "長屋街"
				PRINTFORML 「후우~ 인간들이 이렇게 함께 사는 거구나, 알겠다~」
				PRINTFORMW 「%CALLNAME:MASTER%, 너도 여기에 살아보는 건 어때?」
				;▼霧の湖
			CASE "霧の湖"
				IF DAY:2 == 2
					PRINTFORML 「키아하하하~♪ 정말 상쾌해 보인다~~!」
					PRINTFORMW 「%CALLNAME:MASTER%, 같이 수영하러 가자♪」
				ELSE
					PRINTFORML 「와, 정말 안개가 자욱하네요-」
					PRINTFORMW 「안개가 걷힌다 해도, 이곳은 별로 흥미롭지 않은 것 같아요...」
