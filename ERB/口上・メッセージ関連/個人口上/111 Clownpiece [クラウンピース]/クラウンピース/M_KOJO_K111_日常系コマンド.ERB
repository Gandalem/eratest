@M_KOJO_MESSAGE_COM_K111_360_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;華扇口上さんを参考にさせていただきました。ありがとうございます。
IF LOCAL
	SELECTCASE TCVAR:111:カウンター行動
		;キス
		CASE 30
			CALL HPH_PRINT,@"「하아... 추우~~흐읍ㅍㅎ」","W"
			;後ろから抱きつく
		CASE 31
			PRINTFORMW 「음~ 당신과 함께 있으면 정말 마음이 편해져요... %조사처리(CALLNAME:MASTER,"는")% 마치 아빠 같아요...」
			;前から抱きつく
		CASE 32
			PRINTFORMW 「음... 당신의 체온이... 영원히 이렇게 있고 싶어...」
			;胸を揉ませる
		CASE 33
			PRINTFORMW 「죄송해요... 제 가슴이 너무 작아서요...」
			;股間をまさぐる
		CASE 34
			PRINTFORMW 「캬하하♪ 부풀어 오르기 시작했네♪ 너무 귀여워♪」
			;スカートの中を見せる
		CASE 35
			PRINTFORMW 「어때? 기대돼?」
			;挿入おねだり
		CASE 41 TO 44
			;おあずけ？
			PRINTFORMW 「후우… 괜찮아, 괜찮아! 많이 장난칠게♪」
			;手淫
		CASE 50
			IF NOWEX:MASTER:11
				CALL HPH_PRINT,@"「빨리 해줘, 빨리 해줘HPH」","W"
			ELSE
				CALL HPH_PRINT,@"「캬하하♪ 더 커졌네 HPH 이거 정말 기분 좋다, 그치 HPH」","W"
			ENDIF
			;口淫
		CASE 51
			IF NOWEX:MASTER:11
				IF FIRSTTIME("精液の味")
					CALL HPH_PRINT,@"「응... 음흠... 으음~~흐읍흐흑」","W"
				ELSE
					CALL HPH_PRINT,@"「음... 흐으음... 음~~흐읍헵흐흡」","W"
				ENDIF
			ELSE
				CALL HPH_PRINT,@"「음~, 후우... 핥아라, 음, 맛있다」","W"
			ENDIF
			;素股
		CASE 52
			IF NOWEX:MASTER:11
				CALL HPH_PRINT,@"「하아프 하아프 서둘러 후훗하고 와라」","W"
			ELSE
				CALL HPH_PRINT,@"「노오호피 그들은 멈추지 않아~ 호피 아안호피 아은ㅎ호피」","W"
			ENDIF
			;パイズリ
		CASE 53
			IF NOWEX:MASTER:11
				CALL HPH_PRINT,@"「케헤헵, 네가 이렇게 기분 좋게 느끼도록 내가 해줬어. 나 행복해져♪」","W"
			ELSE
				CALL HPH_PRINT,@"「아흐으프 아흔프 이것도 나한테 정말 기분 좋은 느낌이야ㅎ프」","W"
			ENDIF
			;足コキ
		CASE 54
			CALL HPH_PRINT,@"「쿠후후... HPH 보니 기분이 아주 좋아 보이네~ HPH %조사처리(CALLNAME:MASTER,"는")%, 정말 변태 같아♪」","W"
			;アナル愛撫
		CASE 55
			CALL HPH_PRINT,@"「우와아... 너무 기분 좋아~ HPH 정말이야 %조사처리(CALLNAME:MASTER,"는")%, 마치 변태 같다고 해야 하나♪」","W"
			;アナル舐め
		CASE 56
			CALL HPH_PRINT,@"「더 원해? 핥고쪽 쪽뽀뽀쪽뽀뽀쪽」","W"
			;乳首舐め
		CASE 59
			CALL HPH_PRINT,@"「핥아-핥아-핥아-핥아-핥아 HPH 키시 키스... 하안 HPH」","W"
			;ディープキス
		CASE 60
			CALL HPH_PRINT,@"「하아... 더 HPH 눅추, %TOLOWER(RANDKISS("kiss"))%...HPH」","W"
			;クンニ強制
		CASE 70
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하와와핥 아아흐으은ㅎㅍㅎ」","L"
					CALL HPH_PRINT,@"「정말 좋다~~후헵호흡」","W"
				CASE 1
					CALL HPH_PRINT,@"「아힉흐ㅍ 아힉ㅎ프 아흡ㄴㅎ프」","L"
					CALL HPH_PRINT,@"「더 세게 해줘HPH 더 많이 핥아줘HPHHPH」","W"
				CASE 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%님, 어때? 맛이 좋아?」","L"
					CALL HPH_PRINT,@"「내 보지가 그렇게 맛있어?HPH」","W"
			ENDSELECT
			;アナル舐め強制
		CASE 72
			CALL HPH_PRINT,@"「하와한HPH 내 엉덩이가 최고야HPH」","L"
			CALL HPH_PRINT,@"「당신에게 핥는 기분이 너무 좋다, %CALLNAME:MASTER%~~HPH」","W"
			;ぱふぱふ
		CASE 73
			CALL HPH_PRINT,@"「아앙ㅎ프 아앙ㅎ프 너 엄청 귀여워ㅎ프」","W"
			;乳合わせ
		CASE 74
			CALL HPH_PRINT,@"「아합프 아흔프 당신은 정말 따뜻하네요」","W"
			;タワシ洗い
		CASE 75
			CALL HPH_PRINT,@"「하아프 하아프 미안해 %조사처리(CALLNAME:MASTER,"에게")%, 나만 기분이 좋은 것 같네 HPH」","L"
			CALL HPH_PRINT,@"「하지만 그저 너무 멋지다아하하하 하하하 멈출 수가 없어」","W"
			;強制アソコ愛撫
		CASE 76
			CALL HPH_PRINT,@"「아흐흠 아흐흠 너무 좋다 흐음 하는 야한 소리가 난다 너무 좋아」","W"
			;乳を吸わせる
		CASE 77
			CALL HPH_PRINT,@"「흐으음 흐으음 더흠 더흠」","W"
			;Ｖ挿入,Ａ挿入
		CASE 85, 87
			CALL HPH_PRINT,@"「아아~~흡후프! 안으로 들어갔어~~흡후프헵」","W"
			;だいしゅきホールド
		CASE 86
			;一緒にイく
			IF NOWEX:111:1
				CALL HPH_PRINT,@"「하아헵 하아헵 우리 같이 가자헵 우리 함께 가자헵」","L"
				CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")% 당신을 사랑해 HPH」","W"
			ELSE
				CALL HPH_PRINT,@"「하아흐프 하아흐프 쿰프하프 네 %ONEDARI_MASTER_TINKO()%이 우유를 뿜는 걸 보고 싶어~~하프」","W"
			ENDIF
			;Ｖ腰振り,Ａ腰振り
		CASE 88, 89
			CALL HPH_PRINT,@"「아앙흐으 아앙흐으 멈출 수가 없어 흐윽 내 골반이 흐응」","W"
	ENDSELECT
ENDIF
RETURN 1
