IF LOCAL && DISH_ASSI == 111
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	SELECTCASE DISHNAME
		CASE "ハンバーガー", "アビスバーガー", "逆さバーガー"
			;すでに覚えてても最初の一回目は表示する
			IF DISHNAME == "アビスバーガー" && FIRSTTIME("アビスバーガー")
				PRINTFORML 「뭐라고? 나한테 무슨 특별한 요리를 가르쳐 달라는 거야?」
				PRINTFORMW 「좋아, 그럼 내 옛 고향인 지옥☆에서 엄청 인기 있는 햄버거 스타일을 보여줄게.」
				PRINTL 
				PRINTFORMW 「음... 어디 보자... 재료는 고기랑 치즈, 그리고 소스, 그리고 향신료들...」
				PRINTFORMW 「그리고 이것이랑 저거랑 이거... 잠깐, 이게 아니라 이거였나? 아, 이거도 있었지!」
				PRINTFORMW 「채소는 악이다! 하지만 채소광들은 귀찮으니까, 채소유를 조금 쓰자...」
				PRINTL 
				PRINTFORML 「그래, 그러니까 그걸 두 개의 번 사이에 끼우면 끝이야!」
				PRINTFORML 「그래서? 그거 다 기억하고 있어?」
			ELSE
				;ハンバーガーフラグ
				IF TCVAR:111:356
					PRINTFORML 「우와아?! 나에게 햄버거를 만들어 줄 수 있어!?」
					IF TALENT:111:恋慕
						CALL HPH_PRINT,@"「키히히, 정말 상냥하시네요, %CALLNAME:MASTER%～HPH」","L"
						PRINTFORML 「함께 만들자♪」
					ELSEIF TALENT:111:思慕
						PRINTFORML 「정말 %CALLNAME:MASTER%님, 배려심이 넘치시네요~!」
						PRINTFORML 「저도 좀 돕게 해주세요!」
					ELSE
						PRINTFORML 「세상에, %CALLNAME:MASTER%, 당신은 내가 뭘 좋아하는지 정말 잘 아는군요!」
						PRINTFORML 「나도 도와줄 거야!」
					ENDIF
				ELSE
					PRINTFORML 「뭐 하는 거야? 햄버거 만들 거니?」
					PRINTFORML 「좋아~! 나도 도울게!」
				ENDIF
				IF DISHNAME == "アビスバーガー"
					WAIT
					PRINTFORMW 「오우! 아비스 버거 만들래? 멋지다!」
					PRINTFORMW 「응, 맞아. 재료는 이거랑 이거랑 저기야—...」
					PRINTFORML 「좋아~ 이제 모든 걸 쌓기만 하면 돼~」
					PRINTFORML 「재료의 순서가 엄청 중요하거든, 알지!」
				ELSE
					IF ABL:111:料理技能 >= 1
						SELECTCASE RAND:4
							CASE 1
								PRINTFORML 「그게 다야! 치즈버거로 만들자!」
								DISH_TASTE += "チーズ/"
								TCVAR:111:357 = 1
							CASE 2
								PRINTFORML 「그게 다야! 매운 버거로 만들자!」
								DISH_TASTE += "スパイス/辛い/"
								TCVAR:111:357 = 2
							CASE 3
								;アビスバーガーは実装されたのでエッグバーガーに
								PRINTFORML 「그게 다야! 에그 버거로 만들자!」
								DISH_TASTE += "卵/甘い/"
								TCVAR:111:357 = 3
							CASEELSE
								IF ABL:111:料理技能 >= 3
									PRINTFORML 「그게 그거야! 요정 버거로 만들자!」
									DISH_TASTE += "きらめき/辛い/"
									TCVAR:111:357 = 4
								ELSE
									;はずれ
								ENDIF
						ENDSELECT
					ENDIF
				ENDIF
			ENDIF
		CASE "お子様ランチ", "紅魔ランチ"
