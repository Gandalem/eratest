;==================================================
;610,食事に誘う
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K111_610
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K111_610
CALL M_KOJO_MESSAGE_COM_K111_610_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_610_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, reformatted
	PRINTFORMD You and %CALLNAME:TARGET% go to 
	SELECTCASE CFLAG:MASTER:現在位置
	CASE 商家町
		SELECTCASE RAND:4
		CASE 1
			PRINTFORMD an eatery
		CASE 2
			PRINTFORMD a soba restaurant
		CASE 3
			PRINTFORMD Geidontei
		CASEELSE
			PRINTFORMD a restaurant
		ENDSELECT
	CASE 竹林入り口
		PRINTFORMDL Mystia's stand and eat some lamprey eels.
		GOTO JUMP
	CASE 中有の道
		PRINTFORMD a nearby food stall
	CASE 旧地獄街道
		SELECTCASE RAND:3
		CASE 1
			PRINTFORMD a Hell tea house
		CASE 2
			PRINTFORMD a Youkai tea house
		CASEELSE
			PRINTFORMD a Hell restaurant
		ENDSELECT
	ENDSELECT
	SELECTCASE TIME
	CASE 240 TO 599
		PRINTFORMDL  and have breakfast.
	CASE 600 TO 839
		PRINTFORMDL  and have lunch.
	CASE 840 TO 1019
		PRINTFORMDL  and have a late lunch.
	CASE 1020 TO 1199
		PRINTFORMDL  and have dinner.
	CASE 1200 TO 1440
		PRINTFORMDL  and have a late dinner.
	CASEELSE
		PRINTFORMDL  and have a midnight snack.
	ENDSELECT
	$JUMP
	PRINTW 
	PRINTFORMW 「Yay♪ Food food～♪」
	PRINTL 
	IF TFLAG:SELECTCOMの分岐 == 1
		PRINTFORML 「Mmmmn! This dish is super tasty～♪」
		CALL HPH_PRINT,@"「Ahh! Yours looks really good too, %CALLNAME:MASTER%! Give me a biteHPH」","W"
		PRINTL 
		PRINTFORMDW %CALLNAME:TARGET% looks like she's having a wonderful time...
	ELSEIF TFLAG:SELECTCOMの分岐 == -1
		PRINTFORML 「Nguh...! Th-This dish... It's all vegetables and it doesn't taste good at all...」
		PRINTFORMW 「I'll let you have the rest, %CALLNAME:MASTER%...」
		PRINTL 
		PRINTFORMDW ...It looks like %CALLNAME:TARGET% isn't going to eat much...
	ELSE
		SELECTCASE CFLAG:[[クラウンピース]]:現在位置
		CASE 商家町
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「Hmmmー, so the humans in the human village eat this kind of stuff～」
			CASE 2
				PRINTFORML 「Oh, this looks really tasty! Hmmmー, but this looks good too...」
				PRINTFORMW 「And I want this too! I wanna eat it all!」
			CASEELSE
				PRINTFORML 「I thought that food here on the surface world would be a bit more modest, you know...」
				PRINTFORMW 「But it all has a surprisingly punchy taste～」
			ENDSELECT
		CASE 竹林入り口
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「Ooh～! So this is lamprey～」
			CASE 2
				PRINTFORMW 「By the way, what the heck is a lamprey?」
			CASEELSE
				PRINTFORMW 「Mm! It's tasty! I want seconds!」
			ENDSELECT
		CASE 中有の道
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「It's kinda like a festival, it's fun～♪」
			CASE 2
				PRINTFORMW 「Ummm～... Everything looks really tasty when it's being served at food stalls～」
			CASEELSE
				PRINTFORMW 「Kehe～! This is how Hell's economy was financed, you know!」
			ENDSELECT
		CASE 旧地獄街道
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「This area's really lively and fun～♪」
			CASE 2
				PRINTFORMW 「Ooh, it's super-spicy soba! They had this in Hell, too!」
			CASEELSE
				PRINTFORMW 「It's just like in the Former Hell, there's all the dishes that I like～!」
			ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

