@M_KOJO_MESSAGE_COM_K111_368_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;▼考え事［なに考えてるの］
			;TFLAG:193,-1=はぐらかされる
			IF TFLAG:193 == -1
				PRINTFORML 「뭐야, 안 돼! 그게 아니야!」
				PRINTFORMW 「난 네게 어떤 장난을 쳐야 할지 전혀 생각하고 있지 않아!」
			ELSE
				PRINTFORML 「흠~ 별거 아니지만~」
				SELECTCASE DAY % 8
					CASE 1
						PRINTFORMW 「스파게티를 먹을 때, 포크에 시계 방향으로 말아야 할지 반시계 방향으로 말아야 할지 궁금해졌어~...」
					CASE 2
						PRINTFORMW 「나는 생각했다. 피자를 다섯 조각으로 똑같이 자르려면 어떻게 해야 할까~...」
					CASE 3
						PRINTFORMW 「어제 다른 요정들이 무슨 수다를 떨었을까 생각하고 있었는데~...」
					CASE 4
						PRINTFORMW 「생각해 봤는데, 지옥 돈이랑 지상 돈 간의 환율이 어느 정도일지 궁금하네~...」
					CASE 5
						PRINTFORMW 「생각해 봤는데, 새로운 기발한 장난치는 방법이 있을까~...」
					CASE 6
						PRINTFORMW 「생각해봤는데, 어떤 종류의 새로운 기교를 생각해내야 할지 모르겠어～...」
					CASE 7
						PRINTFORMW 「생각해봤는데, %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%은 나에 대해 무슨 생각을 할까～...」
					CASEELSE
						PRINTFORMW 「%CFLAG:111:1099?"Goshujinsama"#"Master"%이 지금 나를 얼마나 높게 평가하는지 궁금해졌다.」
				ENDSELECT
			ENDIF
		CASE 1
			;▼遊ぶ［一緒に遊ぶ］
			;※[幼稚]持ちのみ
			;TFLAG:193,1=大いに盛り上がる,-1=あまり盛り上がらない
			;PRINTFORMW
		CASE 2
			;▼食事［一緒に食事する］
			;TFLAG:193,-1=MASTERはお腹が空いてなかった
			PRINTFORML 「%CALLNAME:MASTER%, 같이 먹을래?」
			IF TFLAG:193 == -1
