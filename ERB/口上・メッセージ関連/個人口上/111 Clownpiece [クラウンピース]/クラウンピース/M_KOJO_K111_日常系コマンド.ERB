LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;たまにUFO
	IF M_KOJO_K111_EARTH(CFLAG:[[クラウンピース]]:現在位置) && OUTROOF(CFLAG:[[クラウンピース]]:現在位置) && !RAND:12
		;朝～夕方はUFO
		IF INRANGE(TIME, 360, 1080)
			PRINTFORMW 「저기 봐! UFO야! 오오~ 세상에!」
			PRINTL 
			SELECTCASE RAND:13
				CASE 1, 2
					PRINTFORMDW 우와, 정말 UFO네!! 대박이야!!
				CASE 3, 4
					PRINTFORMDW 바람에 날리는 건 그저 팬티뿐이다.
				CASE 5, 6, 7
					PRINTFORMDW 그저 지나가는 불쌍한 인간일 뿐이다.
				CASE 8, 9, 10
					PRINTFORMDW 그저 지나가는 요괴일 뿐이다.
				CASEELSE
					PRINTFORMDW 그저 지나가는 새일 뿐이다.
			ENDSELECT
			;夜は鬼火
		ELSE
			PRINTFORMW 「저쪽을 봐! 지팡이불이야!」
			PRINTL 
			SELECTCASE RAND:13
				CASE 1, 2
					PRINTFORMDW 아니, 실제로는 UFO야!! 완전 대박이야!!
				CASE 3, 4
					PRINTFORMDW 그저 바람에 날리는 반짝이는 팬티일 뿐이다.
				CASE 5, 6, 7
					PRINTFORMDW …실제로 불꽃 요정처럼 보이지만, 그것은 환상향 기준으로는 아무것도 아니다.
				CASE 8, 9, 10
					PRINTFORMDW 그냥 떠돌아다니는 유령일 뿐이다.
				CASEELSE
					PRINTFORMDW 그저 지나가는 떠도는 탄막일 뿐이다.
			ENDSELECT
		ENDIF
	ELSE
		;クラウンピースは人生遠回り
		SELECTCASE RAND:8
			CASE 1
				PRINTFORMW 「저쪽에 뭔가 벌어지는 것 같아!」
			CASE 2
				PRINTFORMW 「어이 어이, 저건 뭐야?」
			CASE 3
				PRINTFORMW 「라라라♪」
			CASE 4
				PRINTFORMW 「오호, 저쪽에 뭔가 있나!?」
			CASE 5
				PRINTFORML 「킁킁...」
				PRINTFORMW 「이쪽 방향에서 무언가 냄새가 난다~」
			CASE 6
				PRINTFORMW 「아니 아니, 막다른 길이 사실은 가는 길이야, 있잖아~」
			CASE 7
				PRINTFORMW 「좋아, 이번에는 막대기가 떨어지는 방향으로 들어가자!」
			CASEELSE
				PRINTFORMW 「뭐라고 뭐라고? 무슨 일 있었어?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
