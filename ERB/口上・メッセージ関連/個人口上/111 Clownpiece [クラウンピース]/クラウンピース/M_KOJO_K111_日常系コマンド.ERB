		CALL M_KOJO_K111_TALKSET("状況会話", 19)
		;20,七夕の話
	ELSEIF !GETBIT(TCVAR:111:359, 20) && FESTIVAL() == "七夕"
		CALL M_KOJO_K111_TALKSET("状況会話", 20)
		;21,満月の話
	ELSEIF !GETBIT(TCVAR:111:359, 21) && MOON_WATCH(DAY:3) == 9
		CALL M_KOJO_K111_TALKSET("状況会話", 21)
		;22,虹の話
	ELSEIF !GETBIT(TCVAR:111:359, 22) && TIME:7 == 1 && M_KOJO_K111_EARTH(CFLAG:[[クラウンピース]]:現在位置) && OUTROOF(CFLAG:[[クラウンピース]]:現在位置)
		CALL M_KOJO_K111_TALKSET("状況会話", 22)
		;	;23,UFOの話（確率）,＞[寄り道する]に移設
		;	ELSEIF !GETBIT(TCVAR:111:359, 23) && M_KOJO_K111_EARTH(CFLAG:[[クラウンピース]]:現在位置) && OUTROOF(CFLAG:[[クラウンピース]]:現在位置) && !RAND:50
		;		CALL M_KOJO_K111_TALKSET("状況会話", 23)
		;24,一緒に住んでる時の話,6日に1回
	ELSEIF !GETBIT(TCVAR:111:359, 24) && M_KOJO_K111_JUNKO_KURASHI() && DAY % 6 == 0
		CALL M_KOJO_K111_TALKSET("状況会話", 24)
		;25,恋人になったばかりの話
	ELSEIF !GETBIT(TCVAR:111:359, 25) && FIRSTTIME("恋人", 1) && TALENT:[[クラウンピース]]:恋人
		CALL M_KOJO_K111_TALKSET("状況会話", 25)
		;26,眠いときの会話
	ELSEIF !GETBIT(TCVAR:111:359, 26) && TIME >= 1200
		CALL M_KOJO_K111_TALKSET("状況会話", 26)
		;27,えっちした後（満足した）
	ELSEIF !GETBIT(TCVAR:111:359, 27) && TCVAR:[[クラウンピース]]:355 && TALENT:[[クラウンピース]]:機嫌 > 0
		CALL M_KOJO_K111_TALKSET("状況会話", 27)
		;28,ほろ酔い
	ELSEIF !GETBIT(TCVAR:111:359, 28) && ALCOHOL_FACE(111) == "ほろ酔い"
		CALL M_KOJO_K111_TALKSET("状況会話", 28)
		;恋人
	ELSEIF TALENT:111:恋人
		CALL M_KOJO_K111_TALKSET("恋人")
		;恋慕
	ELSEIF TALENT:111:恋慕
		CALL M_KOJO_K111_TALKSET("恋慕")
		;通常
	ELSE
		CALL M_KOJO_K111_TALKSET("その他")
	ENDIF
ENDIF
RETURN 1

@M_KOJO_K111_TALKSET(ARGS, ARG, ARG:1)
#DIM 汎用会話数
#DIM 恋慕会話数
汎用会話数 = 18
恋慕会話数 = 44
IF ARGS == "恋人"
	SELECTCASE RAND:(9 + 恋慕会話数 + 汎用会話数)
		CASE 1
			PRINTFORML 「클라운파이~씨는 당신의 연인♪」
			PRINTFORMW 「이게 나의 새 노래야, 어때!?」
		CASE 2
			PRINTFORML 「왜 바람과 불륜이 나쁜 것들이야?」
			PRINTFORMW 「그건 누군가를 사랑하는 게 자연스러운 본능이니까 그렇지, 안 그래?」
			PRINTFORMW 「아니, 하지만 그게 바로 한 사람에게 헌신할 가치가 있는 이유이기도 해!」
		CASE 3
			PRINTFORML 「음......」
			PRINTFORMW 「헤이 %CALLNAME:MASTER%, 도대체 "연모"란 뭐야?」
		CASE 4
			PRINTFORMW 「%CALLNAME:MASTER%, 나에게서 뭐가 제일 좋아~?」
		CASE 5
			PRINTFORML 「내가 다른 남자와 음란한 짓을 한다면 어떻게 할 거야?」
			PRINTFORMW 「화낼 거야? 아니면 울 거야?」
		CASE 6
			PRINTFORML 「%CFLAG:111:1099?"Goshujinsama"#"Master"%가 좋아하는 사람한테 장난치는 걸 좋아하는 타입이라고 나한테 말했어!」
			PRINTFORMW 「도대체 그녀는 무슨 말을 한 거야ー! 부끄럽다!」
		CASE 7
			;reference to WaHH ch. 28
			PRINTFORML 「요정이 모든 힘을 잃으면 "스톤 체리"라는 마법의 돌로 변해 잠이 든다.」
			PRINTFORMW 「혹시라도 나에게 그런 일이 생기면, %조사처리(CALLNAME:MASTER,"가")% 반드시 지켜줘...」
		CASE 8
			IF CFLAG:[[クラウンピース]]:子供人数 > 1
				PRINTFORML 「혹시 포기하고 싶을 때, 나와 %CHILDNAME:[[クラウンピース]]:(CFLAG:[[クラウンピース]]:子供人数 % 10)%와 친구들이 네 곁에 있다는 걸 기억해!」
			ELSEIF CFLAG:[[クラウンピース]]:子供人数
				PRINTFORML 「만약 포기하고 싶을 때가 있다면, 나랑 %CHILDNAME:[[クラウンピース]]:1%가 여기 있다는 걸 기억해!」
			ELSE
				PRINTFORML 「만약 네가 포기하고 싶을 때가 온다면, 내가 여기 있다는 것을 기억해!」
			ENDIF
			PRINTFORMW 「힘들 때마다 당신 생각만 하면, %CALLNAME:MASTER%, 모든 게 더 나아져♪」
		CASE 9
			SELECTCASE M_KOJO_K111_MASTER_IMPRESSION()
				CASE "ロリコン"
					CALL HPH_PRINT,@"「당신은 알잖아요―, 저는 당신의 살짝 장난기 많은 면이 좋아요, %CALLNAME:MASTER%～HPH」","W"
				CASE "清掃中毒者"
					CALL HPH_PRINT,@"「당신이 청소에 얼마나 집착하는지, %조사처리(CALLNAME:MASTER,"는")% 정말 좋아해~HPH」","W"
				CASE "料理人"
					CALL HPH_PRINT,@"「당신은 알잖아요― 당신이 요리하는 걸 좋아하는 게 정말 좋아요, %CALLNAME:MASTER%～HPH」","W"
				CASE "弾幕強者"
					CALL HPH_PRINT,@"「알잖아― 난 네 강하고 믿음직한 면이 좋아, %CALLNAME:MASTER%～HPH」","W"
				CASE "昆虫王"
					CALL HPH_PRINT,@"「너는 말이야- 벌레 잡는 것에 얼마나 집착하는지 내가 좋아해, %CALLNAME:MASTER%～HPH」","W"
				CASE "モテ男"
					;ずるしてません？
					PRINTFORMW 「%CALLNAME:MASTER%, 내 뒤에서 돌아다니고 있었던 거니?」
				CASE "インテリ"
					CALL HPH_PRINT,@"「당신은 알잖아― 난 당신의 명료한 면이 좋아, %CALLNAME:MASTER%～HPH」","W"
				CASE "饒舌"
					CALL HPH_PRINT,@"「당신은 알 거예요― 당신이 항상 재미있는 이야기를 해주는 게 좋아, %CALLNAME:MASTER%～HPH」","W"
				CASE "金持ち"
					CALL HPH_PRINT,@"「너는 알잖아― 네 돈 밝히는 면이 좋아, %CALLNAME:MASTER%～HPH」","W"
				CASEELSE
					CALL HPH_PRINT,@"「당신은 알 거예요ー, 저는 당신의 쾌활한 면이 좋아요, %CALLNAME:MASTER%～HPH」","W"
			ENDSELECT
		CASEELSE
			ARGS = 恋慕
			RESTART
	ENDSELECT
ELSEIF ARGS == "恋慕"
	SELECTCASE RAND:(恋慕会話数 + 汎用会話数)
		CASE 1
			PRINTFORML 「여기 주변은 정말 좋네, 사람들이 고통스러워하지 않아.」
			PRINTFORMW 「지옥 아래에서는 오직 고통받는 자들의 울음소리만 들려오고, 정말 신경을 거슬리게 해!」
		CASE 2
			PRINTFORML 「%CALLNAME:MASTER%, 뭐가 제일 좋으세요—?」
			PRINTFORMW 「저에 관해서는—...」
		CASE 3
			PRINTFORML 「이 의상 정말 귀엽지 않아요ー!」
			PRINTFORMW 「%CFLAG:111:1099?"Goshujinsama"#"Master"%께 만들어 달라고 했어요♪」
		CASE 4
			PRINTFORML 「오늘 뭘 할지 궁금하다ー」
			PRINTFORMW 「아기 고양이를 키울 수 있을지 궁금해!」
		CASE 5
			PRINTFORML 「%CFLAG:111:1099? "Yuujinsama"#"Mrs. Friend"%에 대해서는 말이야ー, 그녀가 나한테 이야기 잔뜩 해주고 같이 놀아줘ー」
			PRINTFORMW 「그녀는 내 머리를 많이 쓰다듬어 주고, 많이 안아주는데, 정말 엄청 착하단 말이지～♪」
		CASE 6
			PRINTFORML 「생각해보면, 당신은 어떤 능력을 가지고 있나요, %CALLNAME:MASTER%?」
			PRINTFORMW 「만약 우리가 진심으로 싸운다면 무슨 일이 일어날지 궁금하네요.」
		CASE 7
			IF TALENT:[[クラウンピース]]:恋人
				PRINTFORML 「인간과 요괴가 사랑에 빠졌다는 이야기를 들었어.」
				PRINTFORML 「하지만 인간과 요정 사이의 사랑 이야기는 들어본 적이 없어...」
				CALL HPH_PRINT,@"「우리가 처음인 것 같아」","W"
			ELSE
				PRINTFORML 「나는 요정이란다. 그리고 당신은 인간이지...」
				PRINTFORMW 「음~ 그것에 대해 어떻게 생각하세요, %CALLNAME:MASTER%?」
