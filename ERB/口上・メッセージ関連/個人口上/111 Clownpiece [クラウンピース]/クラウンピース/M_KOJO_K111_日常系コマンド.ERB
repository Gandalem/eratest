;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があってもムードが足りぬ）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先にキスぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外
;==================================================

@M_KOJO_MESSAGE_COM_K111_350
CALL M_KOJO_MESSAGE_COM_K111_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;押し倒され値	ENDURE(111) >= RAND:300 + 300で真,しかしRANDの値は変化するのでここでは400を超えたら押し倒されることにする
	IF FLAG:時間停止 == 1
		;野外失敗
	ELSEIF TFLAG:194 == 2
		IF ENDURE(111) > 400
			CALL HPH_PRINT,@"「에헤, BPB 말도 안 돼...BPB」","L"
			CALL HPH_PRINT,@"「우-우린 아직 밖에 있어...BPB」","W"
		ELSE
			PRINTFORML 「뭐야! 무슨 소리 하는 거야!?」
			PRINTFORMW 「그-하지만 우리는 아직 밖에 있잖아...?」
		ENDIF
		;人目失敗
	ELSEIF TFLAG:194 == 1
		IF ENDURE(111) > 400
			CALL HPH_PRINT,@"「에헤, BPB 말도 안 돼...BPB」","L"
			CALL HPH_PRINT,@"「사람들이 지켜보고 있어...BPB」","W"
		ELSE
			PRINTFORML 「뭐야! 뭘 묻는 거야!?」
			PRINTFORMW 「하지만 사람들이 보고 있잖아...?」
		ENDIF
		;乱交失敗
	ELSEIF TFLAG:194 == 3
		PRINTFORMW 「에이, 안 돼... 당신이랑 단둘이 있는 게 더 좋아, %CALLNAME:MASTER%...」
		;ムード失敗
	ELSEIF TFLAG:194 == 4
		PRINTFORML 「우와하! 그만둬!」
		PRINTFORMW 「아이고! 기분을 생각해야지, 알잖아~」
		;泥酔失敗
	ELSEIF TFLAG:194 == 5
		PRINTFORMW 「음~? %CALLNAME:MASTER%, 무슨 일이야~~??」
		PRINTL 
		PRINTFORMDW 주변에 정신이 있는 잠재적 목격자들이 너무 많아, 지금은 술 취한 강간을 할 때가 아니야.
		;強制失敗
	ELSEIF TFLAG:194 == 100 || TCVAR:111:抱き寄せ初回 == 98
		PRINTFORML 「%M_KOJO_K111_AUTO("喘ぎ：小", "...!")% 아니, 나 싫어!」
		PRINTFORMW 「지금은 그런 게 하기 싫어!!」
		RETURN 1
		;泥酔
	ELSEIF TCVAR:111:泥酔 == 1
		PRINTFORMW 「푸아아~~ 와샤~~ 올라와~? 침대 종소리~~??」
		;乱交
	ELSEIF GET_TARGETNUM() > 1
		IF FIRSTTIME("乱交")
			PRINTFORMW 「에헤? 우리 다른 여자들이랑... 할 거야...?」
			PRINTFORMW 「저기, 뭐 괜찮을 것 같아...」
		ELSE
			PRINTFORML 「%TOFULL(TOSTR(GET_TARGETNUM()))%」명과 함께라고?
			PRINTFORMW 「우리 모두에게 똑같이 공평하게 대해줄 거야?」
		ENDIF
		;お泊り１
	ELSEIF GROUPMATCH(CFLAG:[[クラウンピース]]:現在位置, 連れ込み宿, ラブホ, CFLAG:MASTER:初期位置) && CFLAG:TARGET:うふふ != 2
		CALL HPH_PRINT,@"「%M_KOJO_K111_AUTO("喘ぎ：小", "HPH")%」","W"
		;お泊り２
	ELSEIF M_KOJO_K111_HOUSE(CFLAG:[[クラウンピース]]:現在位置) == 1 && CFLAG:TARGET:うふふ != 2
		CALL HPH_PRINT,@"「%M_KOJO_K111_AUTO("喘ぎ：小", "HPH")%」","W"
		;それ以外
	ELSEIF !TCVAR:351
		PRINTFORMW 「%M_KOJO_K111_AUTO("喘ぎ：小", "...!")%」
	ENDIF
	;先に押し倒された
	;うふふフラグは押し倒した時点で変更されるんでした
	;押し倒し返しは小傘口上さんを参考にして専用TCVARを作ることに
	;	IF !FLAG:70 && !TFLAG:194 && CFLAG:111:うふふ == 2
	IF TCVAR:351
		PRINTFORML 
		SELECTCASE RAND:3
			CASE 1
				CALL HPH_PRINT,@"「%M_KOJO_K111_AUTO("喘ぎ：小", "HPH")%」","W"
				CALL HPH_PRINT,@"「아이고~ 괜찮아, 괜찮아! 이번엔 네 차례야 HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「푸하하호호 %CALLNAME:MASTER%도 신났어?」","W"
				CALL HPH_PRINT,@"「괜찮아 HPH 우리 함께 기분 좋아지자♪」","W"
			CASEELSE
				PRINTFORMW 「캬하♪ 지금 그런 기분이구나?」
				CALL HPH_PRINT,@"「나는 행복해. 네가 하고 싶은 대로 해.」","W"
		ENDSELECT
	ELSEIF !FLAG:70 && !TFLAG:194
		PRINTFORML 
		SELECTCASE TCVAR:111:抱き寄せ初回
			;普通の初回,キスがまだ,クラウンピースはキスが先だとか後だとか大して気にしてない
			CASE 1, 2
				PRINTFORMW 「꺄아! 잠-잠깐만요!」
				PRINTFORMW 「...%CALLNAME:MASTER%, 진심이에요...?」
				PRINTFORMW 「이런 걸 처음 해보는 거라, 정말 뭘 해야 할지 모르겠어요...」
				CALL HPH_PRINT,@"「하지만 괜찮아, %조사처리(CALLNAME:MASTER,"는")% 부드럽게 해줘 HPH」","W"
				;媚薬or発情
			CASE 3
				PRINTFORML 「후와아... %CALLNAME:MASTER%, 이상해요... 이유도 모르겠지만 머리가 어지러워요...」
				PRINTFORMW 「하아... 뭐, 하고 싶은 대로 해요...」
				;時姦
			CASE 4
				PRINTFORML 「도대체 뭐 하는 거야!? 안 돼!」
				PRINTL 
				PRINTFORMDW 그녀의 입에서 그런 말들이 나왔음에도 불구하고, %조사처리(CALLNAME:TARGET,"는")% 여전히 당신에게 매달린다...
				PRINTL 
				PRINTFORMW 「에헤!? 왜... 내가 이러고 있는 거지...?」
				;		CASE 5
				;			PRINTFORML %CALLNAME:TARGET% pushes you weakly, seemingly unable to firmly reject your advances...
				;もうちょっと
			CASE 6
				PRINTFORML 「후우... 말도 안 돼...」
				PRINTFORMW 「싫어... 미안해, %CALLNAME:MASTER%...」
				;ダメ
			CASE 7
				PRINTFORML 「너 지금 뭐 하는 거야!」
				PRINTFORMW 「그런 건 옳지 않아, 알고 있잖아?」
				;早すぎ
			CASE 8
				PRINTFORML 「꺄아악!!! 도대체 뭘 하는 거야! 이상한 사람! 이상한 사람!」
				PRINTFORMW 「%CFLAG:111:1099?"Goshujinsama"#"Master"%ーー!! 제발 이 자식 좀 지옥으로 끌고 내려줘!!」
				;初回じゃない
			CASEELSE
				SELECTCASE RAND:6
					CASE 1
						CALL HPH_PRINT,@"「흥, 정말이야♪ %CALLNAME:MASTER%, 너무 음란하잖아」","L"
						CALL HPH_PRINT,@"「맘대로 해」","W"
					CASE 2
						PRINTFORMW 「캬하♪ 제기랄, 어쩔 수 없겠지♪」
					CASE 3
						CALL HPH_PRINT,@"「파하♪ 좋아, 우리 함께 못된 장난을 해보자HPH」","W"
					CASE 4
						CALL HPH_PRINT,@"「안 돼~ HPH %CALLNAME:MASTER%, 너 이 야만인 같아~!」","W"
					CASE 5
						PRINTFORMW 「음... %CALLNAME:MASTER%, 오늘 나한테 응석 부려 줄 거야～?」
					CASEELSE
						IF TALENT:111:妊娠
							CALL HPH_PRINT,@"「저 오늘 좀 살살 다뤄주세요 HPH」","W"
						ELSE
							CALL HPH_PRINT,@"「L-오늘은 좀 거칠게 해볼까HPH」","W"
						ENDIF
				ENDSELECT
				;妊娠中
				IF TALENT:111:妊娠 && CFLAG:111:妊娠自覚状態 == 1
					PRINTFORML 
					PRINTFORMW 「아! 내 배에%BABYCONDSTR(" a",111,1)% %BABYPLNOUN("baby",111)%가 있으니까 정말 조심해 주길 바랄게, 알았지?」
					;危険日
				ELSEIF CFLAG:111:生理周期 == 7 && !TALENT:111:妊娠 && CFLAG:111:生解禁 == 2
					PRINTFORML 
					PRINTFORMW (혹시 오늘... 기회가 있을지도? ♪)
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
