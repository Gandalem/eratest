							ENDIF
						ELSE
							CALL HPH_PRINT,@"「아니, 그만해~!! 내 피부에 자국 남을 거야HPH」","W"
						ENDIF
				ENDSELECT
			ENDIF
		ELSE
			PRINTFORML 「%M_KOJO_K111_AUTO("喘ぎ：小", "...!")%」
			;簡易同室人チェック,確率
			IF !RAND:2 && TARGET:2
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「가해자가 있는 것 같아~!」
					CASE 2
						PRINTFORMW 「오 안 돼! 내 신음 소리 들을 수 있어!」
					CASEELSE
						PRINTFORMW 「세상에~ 아무도 알아차렸는지 아세요~?」
				ENDSELECT
				;野外,確率
			ELSEIF !RAND:2 && OUTROOF(CFLAG:[[クラウンピース]]:現在位置)
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「경관님, 이쪽으로 오세요~! 농담이에요~♪」
					CASE 2
						PRINTFORMW 「여기 같은 곳에서 나를 만지는 건 정말 역겨워!」
					CASEELSE
						PRINTFORMW 「%CALLNAME:MASTER%, 아무도 이 모습 보는 거 들키면 체포될 거라는 거 알잖아~?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:8
					CASE 1
						PRINTFORMW 「그건 안 돼~!」
					CASE 2
						PRINTFORMW 「페르브~!!」
					CASE 3
						PRINTFORMW 「크큭, 간지러워!」
					CASE 4
						PRINTFORMW 「와아~! 완전 에로틱해!」
					CASE 5
						PRINTFORMW 「너 엄청 음란하잖아, 알지~」
					CASE 6
						PRINTFORMW 「이상한 사람이 있어~!」
					CASE 7
						IF ARGS == "胸"
							PRINTFORMW 「%CALLNAME:MASTER%, 완전 가슴광이야~?」
						ELSE
							PRINTFORMW 「%CALLNAME:MASTER%, 손이 정말 더러워~」
						ENDIF
					CASEELSE
						IF ARGS == "胸"
							IF TALENT:[[クラウンピース]]:バストサイズ > 0
								PRINTFORMW 「나는 모두보다 더 글래머러스하다고들 하지~♪」
							ELSEIF TALENT:[[クラウンピース]]:バストサイズ < 0
								PRINTFORMW 「...내 가슴이 작은 편인가...?」
							ELSE
								PRINTFORMW 「%CALLNAME:MASTER%, 작은 가슴이랑 큰 가슴 중에 뭐가 더 좋아ー?」
							ENDIF
						ELSE
							PRINTFORMW 「우우~!! 나도 부끄러워!」
