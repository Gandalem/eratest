;303,謝る
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K111_303
DRAWLINE
RETURN 1

@M_KOJO_MESSAGE_COM_K111_303
CALL M_KOJO_MESSAGE_COM_K111_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文改変型
IF LOCAL
	IF TFLAG:SELECTCOMの分岐 == -2 || TFLAG:SELECTCOMの分岐 == 2
		PRINTFORMDL You give %CALLNAME:TARGET% a special sweet in the hope of being forgiven.
	ELSE
		PRINTFORMDL You lower your head desperately while begging %CALLNAME:TARGET% for forgiveness.
	ENDIF
	PRINTW 
	IF TFLAG:SELECTCOMの分岐 == 1
		PRINTFORMW 「Kuku♪ Well, it's alright♪」
		PRINTFORMW 「I wasn't all that angry in the first place!」
	ELSEIF TFLAG:SELECTCOMの分岐 == 2
		PRINTFORML 「Whuh!? U-Umm, whatever should I do, hehehe～♪」
		PRINTFORMW 「Well, I wasn't all that mad～ Maybe I should forgive you this time～♪」
		PRINTFORMDW %CALLNAME:TARGET%'s Lv 1 Hate Mark has been removed!
	ELSEIF TFLAG:SELECTCOMの分岐 == 0
		PRINTFORMW 「Geez, I guess it can't be helped... But be careful from now on, you know.」
	ELSEIF TFLAG:SELECTCOMの分岐 == -2
		PRINTFORMW 「Whoahー! What an awesome sweet!」
		PRINTFORMW 「...Wait, no! I-I won't be fooled by this!」
		PRINTFORMW 「B-But, maybe it's okay if you just want to give it to me...」
		;地の文のままだと分岐==-2の時菓子折り受け取ってくれない,COMFでも菓子折りはなくならないが
		;クラウンピースはお菓子が欲しいのでもらうだけ貰って許してはくれないわがままさんなのだ
		ITEM:菓子折り --
	ELSE
		PRINTFORML 「That's not good enough!」
		PRINTFORMW 「You're gonna have to keep apologizing for a trillion years in the scorching cauldron of Screaming Hell!」
	ENDIF
ENDIF
RETURN 1
