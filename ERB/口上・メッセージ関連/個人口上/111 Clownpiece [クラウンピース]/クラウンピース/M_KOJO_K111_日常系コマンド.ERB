			FOR LOCAL, 1, 10
			SIF !SHAFFLE_ARRAY:LOCAL
				CONTINUE
			IF LOCAL:(SHAFFLE_ARRAY:LOCAL)
				SELECTCASE SHAFFLE_ARRAY:LOCAL
					;野菜
					CASE 1
						PRINTFORML 「으윽! 이제 채소가 들어있다는 걸 알겠네...」
						PRINTFORMW 「더는 안 먹을 거야. 그러니까 나머지는 네가 가져, %CALLNAME:MASTER%!」
						;あっさり
					CASE 2
						PRINTFORMW 「흠~ 좀 너무 가볍고 배가 안 부를 것 같아...」
						;すっぱい
					CASE 3
						PRINTFORML 「으윽, 너무 시다...」
						PRINTFORMW 「나는 이런 요리를 잘 못하는 것 같아...」
						;ヘルシー
					CASE 4
						PRINTFORML 「음~ 이건 너무 건강하기만 해!」
						PRINTFORMW 「몸을 갈아버릴 것 같은 맛이 나는 게 필요해!」
						;淡白
					CASE 5
						PRINTFORMW 「...어이쿠, 이 요리 맛이 전혀 없네...」
				ENDSELECT
				BREAK
			ENDIF
			NEXT
		ENDIF
	ELSE
		VARSET LOCAL
		LOCAL:1 = STRCOUNT(DISH_TASTE, "スパイス/")
		LOCAL:2 = STRCOUNT(DISH_TASTE, "チーズ/")
		LOCAL:3 = STRCOUNT(DISH_TASTE, "甘い/")
		LOCAL:4 = STRCOUNT(DISH_TASTE, "辛い/")
		LOCAL:5 = STRCOUNT(DISH_TASTE, "ジャンキー/")
		LOCAL:6 = STRCOUNT(DISH_TASTE, "濃厚/")
		LOCAL:7 = STRCOUNT(DISH_TASTE, "もちもち/")
		FOR LOCAL, 1, 10
		SIF LOCAL:LOCAL
			LOCAL:10 ++
		NEXT
		;どれでもない
		IF !LOCAL:10
			IF TCVAR:[[クラウンピース]]:料理評価値 >= 850
				PRINTFORMW 「음~~~! 이거 역대급으로 맛있다!! 또 먹고 싶다♪」
			ELSEIF TCVAR:[[クラウンピース]]:料理評価値 >= 750
				PRINTFORMW 「음~!! 정말 맛있어!」
			ELSE
				PRINTFORMW 「음~ 맛있어~!」
			ENDIF
		ELSE
			;シャッフルして最初にヒットしたやつ
			CALL FISHER_YATES_SHAFFLE(10)
			FOR LOCAL, 1, 10
			SIF !SHAFFLE_ARRAY:LOCAL
				CONTINUE
			IF LOCAL:(SHAFFLE_ARRAY:LOCAL)
				SELECTCASE SHAFFLE_ARRAY:LOCAL
					;スパイス
					CASE 1
						PRINTFORMW 「음~♪ 이 요리의 새콤한 맛이 마음에 들어!」
						;チーズ
					CASE 2
						PRINTFORMW 「음~♪ 치즈는 맛있다~♪」
						;甘い
					CASE 3
						CALL HPH_PRINT,@"「음~♪ 달콤해~후우」","W"
						;辛い
					CASE 4
						PRINTFORMW 「푸하하~♪ 매콤하고 맛있어!」
						;ジャンキー
					CASE 5
						PRINTFORMW 「푸하하~♪ 네 건강에 안 좋을 거라는 걸 알면서도 정말 맛있다!」
						;濃厚
					CASE 6
						PRINTFORMW 「음~ 정말 풍미가 깊네~!」
						;もちもち
					CASE 7
						CALL HPH_PRINT,@"「파하하~♪ 정말 흔들리는 게 너무 좋아~후후」","W"
				ENDSELECT
				BREAK
			ENDIF
			NEXT
		ENDIF
	ENDIF
	TCVAR:111:356 = 0
	TCVAR:111:357 = 0
ENDIF
RETURN 1
