@M_KOJO_K111_日常愛撫(ARGS)
SELECTCASE ARGS
	CASE "怒る"
		;理論上できなくないけど、計算式が関数ではなく判定フラグも無いのでやめておく
	CASE "不機嫌"
		IF TALENT:111:恋慕
			PRINTFORML 「%M_KOJO_K111_AUTO("喘ぎ：小", "...!")%」
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「그만해줘~...」
				CASE 2
					PRINTFORMW 「무우! 화날 것 같아, 알잖아ー?」
				CASEELSE
					PRINTFORMW 「그만해줘... 기분이 아니야...」
			ENDSELECT
		ELSE
			PRINTFORMW 「그만해!」
		ENDIF
	CASE "絶頂"
		CALL HPH_PRINT,@"「%M_KOJO_K111_AUTO("喘ぎ：小", "HPH")%」","L"
		SELECTCASE RAND:8
			CASE 1
				CALL HPH_PRINT,@"「스톱...! 지금 만지면... 안돼」","W"
			CASE 2
				CALL HPH_PRINT,@"「흐으윽...! 제발... 음흠흣」","W"
			CASE 3
				CALL HPH_PRINT,@"「저기, 잠깐만...! 좀 더 천천히 해줘... 흐으읍흐윽」","W"
			CASE 4
				CALL HPH_PRINT,@"「그만해... 하아읍」","W"
			CASE 5
				CALL HPH_PRINT,@"「음, 제기랄... 소용없어... 흐응흐응」","W"
			CASE 6
				CALL HPH_PRINT,@"「아니, 그만해... 음, 흐응흐으」","W"
			CASE 7
				CALL HPH_PRINT,@"「와아... 그만해... 으읍큭」","W"
			CASEELSE
				CALL HPH_PRINT,@"「아앙... 더 그러면 안 돼... 음음흐읍」","W"
		ENDSELECT
		;胸,クリ,膣
	CASEELSE
		IF TALENT:[[クラウンピース]]:恋慕
			CALL HPH_PRINT,@"「%M_KOJO_K111_AUTO("喘ぎ：小", "HPH")%」","L"
			;簡易同室人チェック,確率
			IF !RAND:3 && TARGET:2
				SELECTCASE RAND:4
					CASE 1
						PRINTFORMW 「공개적으로 나를 만지는 건 역겨워~!」
					CASE 2
						CALL HPH_PRINT,@"「아니야! 누가 내 신음 소리를 들었을지도 몰라」","W"
					CASE 3
						CALL HPH_PRINT,@"「후우후히 이건 완전히 성추행이잖아♪」","W"
					CASEELSE
						CALL HPH_PRINT,@"「계속 그렇게 무모하게 행동하면, 우리가 들킬 거야HPH」","W"
				ENDSELECT
				;野外,確率
			ELSEIF !RAND:3 && OUTROOF(CFLAG:[[クラウンピース]]:現在位置)
				SELECTCASE RAND:4
					CASE 1
						CALL HPH_PRINT,@"「밖에 있을 때 나를 만져주는 네가 정말 용감하구나~HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「정말이지, 하아... 당신은 너무 성급하네요, %CALLNAME:MASTER%~」","W"
					CASE 3
						CALL HPH_PRINT,@"「우리 조용한 곳으로 가자고~ HPH」","W"
					CASEELSE
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 맹세컨대~ 다음 목표는 네가 될 거야HPH」","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:8
					CASE 1
						CALL HPH_PRINT,@"「뭐야, 이 변태 자식!」","W"
					CASE 2
						PRINTFORMW 「변태~!」
					CASE 3
						PRINTFORMW 「간지러워♪」
					CASE 4
						CALL HPH_PRINT,@"「후우, 정말 굉장해♪」","W"
					CASE 5
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 변태 같아～HPH」","W"
					CASE 6
