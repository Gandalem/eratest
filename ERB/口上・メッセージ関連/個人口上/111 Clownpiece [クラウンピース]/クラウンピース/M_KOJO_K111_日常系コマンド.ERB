;==================================================
@M_KOJO_MESSAGE_COM_K111_621
;DRAWLINE ;custom code
CALL M_KOJO_MESSAGE_COM_K111_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_621_1
#DIM CHARA
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文をカットしてるのでMESSAGE処理を内蔵する
IF LOCAL
	SELECTCASE TFLAG:193
	;釣れない
	CASE 0
		PRINTFORMDW You couldn't catch anything...
		IF TALENT:111:恋慕
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「Aww～～ We can't catch a thing～～!」
			CASE 2
				PRINTFORMW 「Here fishy fishy fishy～♪」
			CASEELSE
				PRINTFORMW 「%CALLNAME:MASTER%, this is getting boring～」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「...Free timeー!!」
			CASE 2
				PRINTFORMW 「...Is this supposed to be fun?」
			CASEELSE
				PRINTFORMW 「...Nothing's biting...」
			ENDSELECT
		ENDIF
		RETURN 1
	;木片
	CASE 610
		IF TFLAG:194 > 1000
			PRINTFORMW 「Look! I caught something!!」
			PRINTL 
			PRINTFORMDL %CALLNAME:TARGET% caught a piece of wood...
			PRINTW
			PRINTFORMW 「...Grrr～～～!!」
		ELSE
			PRINTFORMDL You caught some wood...
			PRINTW 
			PRINTFORMW 「Kyahaha! Looks like a fail～!」
		ENDIF
		RETURN 1
	;紙切れ
	CASE 131
		IF TFLAG:194 > 1000
			PRINTFORML 「Look! I caught something!!」
		ELSE
			PRINTFORMDL You caught some paper...
		ENDIF
		PRINTDW 
		PRINTDL ┌─────────────┐
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　　 Moriya Talisman 　 　｜
		PRINTDL ｜　　　　　Lottery 　　　　｜
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　　Gather 5 Talismans  　｜
		PRINTDL ｜　　　Get a lottery roll　｜
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　Miracle not guaranteed　｜
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　　　　　　Moriya Shrine ｜
		PRINTDL └─────────────┘
		PRINTW 
		PRINTFORMW 「...? What the heck is this? Garbage?」
		RETURN 1
	CASE 1 TO 20, 22 TO 60
		LOCALS = %FISH_NAME_TR(TFLAG:193)%
	CASE 21
		LOCALS = rotor
		IF TFLAG:194 > 1000
			CALL HPH_PRINT,@"「Whuh? Is this...BPB」","W"
		ELSE
			PRINTFORML 「Whuh? Is that...」
			PRINTFORMW 「%CALLNAME:MASTER%, what a pervert you are～!」
		ENDIF
	CASEELSE
		LOCALS = %ITEMNAME_TR(TFLAG:193)%
	ENDSELECT
	;クラウンピースが釣った
	IF TFLAG:194 > 1000
		PRINTFORMW 「Look! I caught something!!」
		PRINTL 
		PRINTFORMDL %CALLNAME:TARGET% caught a %LOCALS%!
		RESETCOLOR
		;説明を流す
		SELECTCASE TFLAG:193
		CASE 1 TO 20, 22 TO 60
			DRAWLINE
			PRINTFORML %LOCALS%
			CALL FISHING_EXPLANATION(TFLAG:193)
		CASE IS > 61
			DRAWLINE
			PRINTFORML %LOCALS%
			PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K111
		SELECTCASE LOCALS
		;CASE "ローター"
		;	PRINTFORMW 「Whuh? This is...」
		;CASE "カエル"
		CASE "frog"
			PRINTFORMW 「Kyahahaha! A froggie! Ribbit ribbit! Ribbit ribbit!」
		;CASE "氷の鱗", "龍の爪"
		CASE "Ice scale", "Dragon's Claw"
			PRINTFORMW 「What is this!? It's so pretty～～!!」
		;CASE "龍涎香"
		CASE "Ambergris"
			PRINTFORMW 「What the heck, this is just trash!」
		;CASE "ガーパイク", "カムルチー", "シーラカンス", "チョウザメ", "イトウ", "ピラルクー", "タキタロウ"
		CASE "garpike", "northern snakehead", "coelacanth", "sturgeon", "sakhalin taimen", "pirarucu", "takitaro"
			PRINTFORMW 「Kyaaa～! It's huge!! %CALLNAME:MASTER%, help me carry it～!」
		;CASE "ピラニア"
		CASE "piranah"
			PRINTFORMW 「Whoah～! It's a piranah! Cool～!」
		;CASE "ウナギ", "ヤツメウナギ", "ナマズ"
		CASE "eel", "lamprey eel", "catfish"
			PRINTFORMW 「Wowie! It's all slippery and slimy～!」
		CASEELSE
			PRINTFORMW 「How is it!? Amazing, right?」
		ENDSELECT
	;MASTERが釣った
	ELSE
		RESETCOLOR
		PRINTFORMDL You caught a %LOCALS%!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORMDL 　Size： {LOCAL:1} cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORML 　It's the biggest %LOCALS% you've caught yet!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
		;説明を流す
		SELECTCASE TFLAG:193
		CASE 1 TO 20, 22 TO 60
			DRAWLINE
			PRINTFORML %LOCALS%
			CALL FISHING_EXPLANATION(TFLAG:193)
		CASE IS > 61
			DRAWLINE
			PRINTFORML %LOCALS%
			PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K111
		SELECTCASE LOCALS
		;CASE "ローター"
		;	PRINTFORML 「Nn? This is...」
		;	PRINTFORMW 「%CALLNAME:MASTER%, how lewd you are～!」
		;CASE "カエル"
		CASE "frog"
			PRINTFORMW 「Kyahahaha! A froggie! Ribbit ribbit! Ribbit ribbit!」
		;CASE "氷の鱗", "龍の爪"
		CASE "Ice scale", "Dragon's Claw"
			PRINTFORMW 「What is this!? It's so pretty～～!!」
		;CASE "龍涎香"
		CASE "Ambergris"
			PRINTFORMW 「What the heck, that's just trash!」
		;CASE "ピラニア"
		CASE "piranah"
			PRINTFORMW 「Whoah～! It's a piranah! Cool～!」
		;CASE "ウナギ", "ヤツメウナギ", "ナマズ"
		CASE "eel", "lamprey eel", "catfish"
			PRINTFORMW 「Kyahahahaha! It's all slippery and slimy～!」
		CASEELSE
			IF LOCAL:1 >= 80
				PRINTFORMW 「Holy moly! It's huge!!」
			ELSEIF INRANGE(TFLAG:193, 11, 20) || INRANGE(TFLAG:193, 24, 60)
				PRINTFORMW 「Whoahー! Awesome! We're gonna eat it, right?」
			ELSEIF TALENT:111:恋慕 || TALENT:111:思慕
				PRINTFORMW 「Whoahー! Amazing! What are you gonna do with it??」
			ELSE
				PRINTFORMW 「Oohー! You caught one～!」
			ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
