;==================================================

@M_KOJO_MESSAGE_COM_K111_621
;DRAWLINE ;custom code
CALL M_KOJO_MESSAGE_COM_K111_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_621_1
#DIM CHARA
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文をカットしてるのでMESSAGE処理を内蔵する
IF LOCAL
	SELECTCASE TFLAG:193
		;釣れない
		CASE 0
			PRINTFORMDW 아무것도 잡지 못했어...
			IF TALENT:111:恋慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「아~~ 아무것도 못 잡겠어~~!」
					CASE 2
						PRINTFORMW 「여기는 물고기 물고기 물고기~♪」
					CASEELSE
						PRINTFORMW 「%CALLNAME:MASTER%, 이거 지루해지네~」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「...자유 시간이야-!!」
					CASE 2
						PRINTFORMW 「...이게 재미있어야 해?」
					CASEELSE
						PRINTFORMW 「...한 입도 안 물어오는군...」
				ENDSELECT
			ENDIF
			RETURN 1
			;木片
		CASE 610
			IF TFLAG:194 > 1000
				PRINTFORMW 「봐! 뭔가 잡았어!!」
				PRINTL 
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 나무 조각 하나를 잡았다...
				PRINTW
				PRINTFORMW 「...크르릉~~!!」
			ELSE
				PRINTFORMDL 나무를 좀 잡았네...
				PRINTW 
				PRINTFORMW 「캬하하! 실패한 것 같아~!」
			ENDIF
			RETURN 1
			;紙切れ
		CASE 131
			IF TFLAG:194 > 1000
				PRINTFORML 「봐! 뭔가 잡았어!!」
			ELSE
				PRINTFORMDL 너 종이 몇 장 잡았네...
			ENDIF
			PRINTDW 
			PRINTDL ┌─────────────┐
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 부적
			PRINTDL 복권
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 부적 5개를 모아라
			PRINTDL 복권 한 개를 얻어라
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 기적은 보장되지 않는다.
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 신사
			PRINTDL └─────────────┘
			PRINTW 
			PRINTFORMW 「...이게 뭐야? 쓰레기인가?」
			RETURN 1
		CASE 1 TO 20, 22 TO 60
			LOCALS = %FISH_NAME_TR(TFLAG:193)%
		CASE 21
			LOCALS = rotor
			IF TFLAG:194 > 1000
				CALL HPH_PRINT,@"「응? 이게...BPB라고?」","W"
			ELSE
				PRINTFORML 「뭐라고? 저게...」
				PRINTFORMW 「%CALLNAME:MASTER%, 정말 변태 같아~!」
			ENDIF
		CASEELSE
			LOCALS = %ITEMNAME_TR(TFLAG:193)%
	ENDSELECT
	;クラウンピースが釣った
	IF TFLAG:194 > 1000
		PRINTFORMW 「봐! 뭔가 잡았어!!」
		PRINTL 
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) %LOCALS%를 잡았다!
		RESETCOLOR
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORML %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORML %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K111
		SELECTCASE LOCALS
			;CASE "ローター"
			;	PRINTFORMW 「Whuh? This is...」
			;CASE "カエル"
			CASE "frog"
				PRINTFORMW 「키야하하하! 개구리다! 릴빗 릴빗! 릴빗 릴빗!」
				;CASE "氷の鱗", "龍の爪"
			CASE "Ice scale", "Dragon's Claw"
				PRINTFORMW 「이게 뭐야!? 너무 예쁘잖아~~!!」
				;CASE "龍涎香"
			CASE "Ambergris"
				PRINTFORMW 「도대체 뭐야, 이거 그냥 쓰레기잖아!」
				;CASE "ガーパイク", "カムルチー", "シーラカンス", "チョウザメ", "イトウ", "ピラルクー", "タキタロウ"
			CASE "garpike", "northern snakehead", "coelacanth", "sturgeon", "sakhalin taimen", "pirarucu", "takitaro"
				PRINTFORMW 「꺄아~!! 엄청 크잖아!! %CALLNAME:MASTER%, 나 좀 옮기는 거 도와줘~!」
				;CASE "ピラニア"
			CASE "piranah"
				PRINTFORMW 「우와~! 피라냐다! 멋지다~!」
				;CASE "ウナギ", "ヤツメウナギ", "ナマズ"
			CASE "eel", "lamprey eel", "catfish"
				PRINTFORMW 「와우! 전부 미끌미끌하고 축축하네~!」
			CASEELSE
				PRINTFORMW 「어때!? 굉장하지 않아?」
		ENDSELECT
		;MASTERが釣った
	ELSE
		RESETCOLOR
		PRINTFORMDL 당신은 %LOCALS%를 잡았다!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORMDL 　크기: {LOCAL:1} cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORML 　지금까지 잡은 것 중 가장 큰 %LOCALS%야!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORML %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORML %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K111
		SELECTCASE LOCALS
			;CASE "ローター"
			;	PRINTFORML 「Nn? This is...」
			;	PRINTFORMW 「%CALLNAME:MASTER%, how lewd you are～!」
			;CASE "カエル"
			CASE "frog"
				PRINTFORMW 「키야하하하! 개구리다! 릴빗 릴빗! 릴빗 릴빗!」
				;CASE "氷の鱗", "龍の爪"
			CASE "Ice scale", "Dragon's Claw"
				PRINTFORMW 「이게 뭐야!? 너무 예쁘잖아~~!!」
				;CASE "龍涎香"
			CASE "Ambergris"
				PRINTFORMW 「뭐야, 고작 쓰레기라니!」
				;CASE "ピラニア"
			CASE "piranah"
				PRINTFORMW 「우와~! 피라냐다! 멋지다~!」
				;CASE "ウナギ", "ヤツメウナギ", "ナマズ"
			CASE "eel", "lamprey eel", "catfish"
				PRINTFORMW 「캬하하하하! 온통 미끌미끌하고 축축해~!」
			CASEELSE
				IF LOCAL:1 >= 80
					PRINTFORMW 「세상에! 엄청 크잖아!!」
				ELSEIF INRANGE(TFLAG:193, 11, 20) || INRANGE(TFLAG:193, 24, 60)
					PRINTFORMW 「와아~! 멋지다! 우리 이거 먹을 거지?」
				ELSEIF TALENT:111:恋慕 || TALENT:111:思慕
					PRINTFORMW 「와아-! 대단해! 그걸로 뭘 할 거야??」
				ELSE
					PRINTFORMW 「오옷~ 하나 잡았네~!」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
