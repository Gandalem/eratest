	IF FLAG:時間停止 || CFLAG:111:睡眠
	ELSEIF CFLAG:111:うふふ
		PRINTFORMW 「Whuh? Cleaning? I don't understand what that means～!」
	ELSE
		IF ABL:[[クラウンピース]]:親密 >= 6
			IF TALENT:MASTER:清掃中毒 || ABL:MASTER:清掃技能 >= 6
				PRINTFORML 「Wowie! It's all done! You're practically a cleaning youkai!」
				PRINTFORMW 「What a terrifying sight～!」
			ELSEIF ABL:MASTER:清掃技能 >= 4
				IF OUTROOF(CFLAG:MASTER:現在位置) && DAY:2 == 4
					PRINTFORML 「So you like shoveling snow too, I seeー」
					PRINTFORMW 「Well, I like rolling up big snowballs, like this!」
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%, you sure like to clean, don't youー」
					PRINTFORMW 「Well, isn't that a good thing? Because I'm in charge of making messes!」
				ENDIF
			ELSE
				IF OUTROOF(CFLAG:MASTER:現在位置) && DAY:2 == 4
					PRINTFORML 「Geezeー, you're going to clean it all even though it took so long for that much to pile up?」
					IF TFLAG:193
						PRINTFORMW 「I guess it can't be helped, I'll lend a hand too...」
					ELSE
						PRINTFORMW 「Well, then I'll make a snowman first, okay～」
					ENDIF
				ELSE
					PRINTFORML 「Geezeー, even though I put so much effort into making that mess, you're going to put it all awayー?」
					IF TFLAG:193
						PRINTFORMW 「I guess it can't be helped, I'll lend a hand too...」
					ELSE
						PRINTFORMW 「Well, then I'll start scattering some toys around over there, okay～」
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF OUTROOF(CFLAG:MASTER:現在位置) && DAY:2 == 4
				PRINTFORML 「You're shoveling snow?」
			ELSE
				PRINTFORML 「You're cleaning up?」
			ENDIF
			;地位が低いのでほぼ手伝う
			IF TFLAG:193
				PRINTFORMW 「That's great, I'll lend you a hand!」
			ELSE
				PRINTFORMW 「That's greatー」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
