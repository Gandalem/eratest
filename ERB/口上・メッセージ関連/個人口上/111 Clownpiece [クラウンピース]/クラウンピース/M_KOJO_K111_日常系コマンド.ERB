					;ヘルシー
					CASE 4
						PRINTFORML 「Hmmー, this is just a bit too healthy!」
						PRINTFORMW 「I need something where you can just taste that it's gonna tear your body to shreds!」
					;淡白
					CASE 5
						PRINTFORMW 「...Hey, this dish doesn't taste good at all...」
					ENDSELECT
					BREAK
				ENDIF
			NEXT
		ENDIF
	ELSE
		VARSET LOCAL
		LOCAL:1 = STRCOUNT(DISH_TASTE, "スパイス/")
		LOCAL:2 = STRCOUNT(DISH_TASTE, "チーズ/")
		LOCAL:3 = STRCOUNT(DISH_TASTE, "甘い/")
		LOCAL:4 = STRCOUNT(DISH_TASTE, "辛い/")
		LOCAL:5 = STRCOUNT(DISH_TASTE, "ジャンキー/")
		LOCAL:6 = STRCOUNT(DISH_TASTE, "濃厚/")
		LOCAL:7 = STRCOUNT(DISH_TASTE, "もちもち/")
		FOR LOCAL, 1, 10
			SIF LOCAL:LOCAL
				LOCAL:10 ++
		NEXT
		;どれでもない
		IF !LOCAL:10
			IF TCVAR:[[クラウンピース]]:料理評価値 >= 850
				PRINTFORMW 「Mmmm～～! This is the most delicious ever!! I wanna eat that again♪」
			ELSEIF TCVAR:[[クラウンピース]]:料理評価値 >= 750
				PRINTFORMW 「Mmmm～～! This is awesomely tasty!」
			ELSE
				PRINTFORMW 「Mmm～! It's tasty～!」
			ENDIF
		ELSE
			;シャッフルして最初にヒットしたやつ
			CALL FISHER_YATES_SHAFFLE(10)
			FOR LOCAL, 1, 10
				SIF !SHAFFLE_ARRAY:LOCAL
					CONTINUE
				IF LOCAL:(SHAFFLE_ARRAY:LOCAL)
					SELECTCASE SHAFFLE_ARRAY:LOCAL
					;スパイス
					CASE 1
						PRINTFORMW 「Mmm～♪ I love the tangy flavor this dish has!」
					;チーズ
					CASE 2
						PRINTFORMW 「Mmm～♪ Cheese is sho tashty～♪」
					;甘い
					CASE 3
						CALL HPH_PRINT,@"「Mmm～♪ Sweeeet～HPH」","W"
					;辛い
					CASE 4
						PRINTFORMW 「Pfahaha～♪ It's spicy and delicious!」
					;ジャンキー
					CASE 5
						PRINTFORMW 「Pfahaha～♪ It's so good, this taste that you just know is bad for you!」
					;濃厚
					CASE 6
						PRINTFORMW 「Mmm! It's got a super rich flavor～!」
					;もちもち
					CASE 7
						CALL HPH_PRINT,@"「Pfahaha～♪ I love how it's super wobbly～HPH」","W"
					ENDSELECT
					BREAK
				ENDIF
			NEXT
		ENDIF
	ENDIF
	TCVAR:111:356 = 0
	TCVAR:111:357 = 0
ENDIF
RETURN 1

