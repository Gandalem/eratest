@M_KOJO_MESSAGE_MESSAGECHECK_COM_K111_300
RETURN 1

@M_KOJO_MESSAGE_COM_K111_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K111_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_300_1
#DIM POINT
#DIM デート会話, 120
#DIM 一回会話
;日が変わってたらデート会話リセット
SIF !TCVAR:111:353
	VARSET デート会話
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	RESETCOLOR
	;ここに口上書いて下さい
	IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
		PRINTFORMDL You try to talk to %CALLNAME:TARGET%, but she's so out of it she doesn't notice you trying to say something to her.
	;会話不能の地の文は恋慕でない場合は省略できず、恋慕の時は表示されないので、ここではどちらの場合も同じように表示されるようにする
	ELSEIF TCVAR:111:会話不能
		IF TALENT:111:恋慕
			PRINTFORMDL You try speaking with %CALLNAME:TARGET% but can't come up with anything to say.
			PRINTFORMDW An awkward silence fills the room...
		ENDIF
	ELSE
		;デート会話
		IF TALENT:111:恋慕 && FLAG:デート相手 == 111 && DATENAME_SPOT() != "on the road" && !デート会話:(CFLAG:111:現在位置 / 10)
			CLEARLINE 2
			PRINTFORML Dating at the %DATENAME_SPOT()%.
			DRAWLINE
		ENDIF
		;custom code
		CALL CONVERSATION()
	ENDIF
	PRINTW 
	CALL M_KOJO_COLOR_K111
	IF ALCOHOL_FACE(111) == "酔いどれ" || ALCOHOL_FACE(111) == "ぐでぐで"
		IF !RAND:2
			CALL HPH_PRINT,@"「Kyahahaha♪ I luvvvv shak-eeeh♪ I luv shak-eh an' I luv you too, %CALLNAME:MASTER%HPH」","L"
			PRINTFORMW 「～～Hic!! @ # ! $ \% ! ? * * * * Hic!!」
		ELSE
			PRINTFORML 「An' then～～ Ya shee, %CFLAG:111:1099?"Goshushinshama"#"Masher"% wash goin' all～～～ Ya shee～～～～～hic!」
			PRINTFORMW 「But I... Hic～～ Hic～～～～ Yeshh, hyahahahaha!!」
		ENDIF
		PRINTFORML 
		PRINTFORMDW It can barely be called a conversation...
	ELSEIF M_KOJO_K111_FUKIGEN(111)
		PRINTFORML 「What's with you, anyway!?」
		PRINTFORMW 「Go bother some other girl already, leave me alone!」
	;会話不能
	ELSEIF TCVAR:111:会話不能
		PRINTFORML 「You just told me that story a little while agoー」
		PRINTFORMW 「Boriiing～」
	;失敗
	ELSEIF TFLAG:SELECTCOMの分岐 == -1
		SELECTCASE RAND:3
		CASE 1
			PRINTFORML 「Heyー, you're just nodding along with whatever I say, aren't youー」
			PRINTFORMW 「If you're not interested, then just say so!」
		CASE 2
			PRINTFORML 「%CALLNAME:MASTER%, sometimes you talk about some really technical stuff, you know...」
			PRINTFORMW 「It's super boringー」
		CASEELSE
			PRINTFORML 「...Hmmmm.」
			PRINTFORMW 「I guess I just don't get what you're trying to say.」
		ENDSELECT
	;夏,野外,汗フラグなし,昼間,地上,晴れで確定
	ELSEIF DAY:2 == 2 && OUTROOF(CFLAG:111:現在位置) && !TCVAR:111:350 && INRANGE(TIME, 600, 960) && M_KOJO_K111_EARTH(CFLAG:111:現在位置) && 天候 < 2
		;暑いの大好きだった
		SELECTCASE RAND:5
		CASE 1
			PRINTFORML 「%CALLNAME:MASTER%, are you hot? It's a pretty warm day today, isn't it?」
			PRINTFORMW 「Kyahaha! I love it! That beaten-down-by-the-heat expression, it's food for my soul♪」
			TALENT:111:機嫌 = 1
;			PRINTFORML 「It's so hot every single day...」
;			PRINTFORMW 「But compared to the Hell of Blazing Fires, it's still cooler, I guess.」
		CASE 2
			PRINTFORML 「Seriously, it's been hot every day recently...」
			PRINTFORMW 「It's the best, it makes your blood boil and your body soar!!」
;			PRINTFORMW 「But how can it get so hot here on the surface...」
		CASE 3
			PRINTFORML 「I'm from Hell, born and raised!」
			PRINTFORMW 「I just love the rays of the hot summer sun～♪」
		CASE 4
			PRINTFORML 「When I bask in these intense sun-rays, it's like power wells up from deep inside me!」
			PRINTFORMW 「Uoooohhhhー! I feel the tension risingー!!」
			TALENT:111:機嫌 = 1
		CASEELSE
			PRINTFORML 「The Hell of Blazing Fires is way hotter than this summer sunshine!」
			PRINTFORMW 「But in spite of that, the heat of the sun is full of energy, and the quality's just different, you know～」
;			PRINTFORML 「Goodー... Heatー...」
;			PRINTFORMW 「%CALLNAME:MASTER%, how are you holding up in this heatー?」
		ENDSELECT
		PRINTL 
		PRINTFORMDL It seems that Clownpiece likes to wear short, skin-tight spats during summertime.
		PRINTFORMDW She's looking pretty smokin' in the steamy summer heat...
		TCVAR:111:350 = 1
	;プレゼント会話１（プレゼントのお礼）,フラグ発生から5日以上
	ELSEIF CFLAG:[[クラウンピース]]:1005 && DAY - CFLAG:[[クラウンピース]]:1005 >= 5
		PRINTFORMW 「Ah, that's right! I was planning to give this to you today, %CALLNAME:MASTER%!」
		;12日以上
		SIF DAY - CFLAG:[[クラウンピース]]:1005 >= 12
			PRINTFORML 「I don't know if you've already forgotten about it, %CALLNAME:MASTER%, but...」
		PRINTFORMW 「Look, here's the thank-you present I was talking about a while ago!」
		SELECTCASE RAND:8
		CASE 1
			LOCALS:1 = Maddening
		CASE 2
			LOCALS:1 = Infernal
		CASE 3
			LOCALS:1 = Clown's
		CASE 4
			LOCALS:1 = Hand-made
		CASEELSE
			LOCALS:1 = Stars & Stripes
		ENDSELECT
		SELECTCASE RAND:8
		CASE 1
			LOCALS:2 = Handkerchief
		CASE 2
			LOCALS:2 = Strap
		CASE 3
			LOCALS:2 = Charm
		CASE 4
			LOCALS:2 = Mug
		CASE 5
			LOCALS:2 = Lamp
		CASE 6
			LOCALS:2 = Walking Stick
		CASE 7
			LOCALS:2 = Mana Stone
		CASEELSE
			IF IS_FEMALE(MASTER) ;custom code
				LOCALS:2 = Ribbon
			ELSE
				LOCALS:2 = Necktie
			ENDIF
		ENDSELECT
		CALL GIFT_ORDER_MADE_FROM_CHARA([[クラウンピース]], LOCALS:1, LOCALS:2)
		PRINTL 
		CALL COLORMESSAGE(@"You receive 【%ARTICLE(RESULTS)%】from Clownpiece!", C_AQUA, 2)
		PRINTL 
		PRINTFORMW 「Oh yeah, I'm giving this to you as a thank-you, so there's no need to thank me in return!」
		CFLAG:[[クラウンピース]]:1005 = 0
	;プレゼント会話２（クリスマスプレゼント）,フラグ発生から1日以上12日以内
	ELSEIF CFLAG:[[クラウンピース]]:1006 && INRANGE(DAY - CFLAG:[[クラウンピース]]:1006, 1, 12)
		PRINTFORMW 「Ah, umm, %CALLNAME:MASTER%... H-Here, I'm giving this to you!」
		;年越してる
		SIF DAY - CFLAG:[[クラウンピース]]:1006 > 7
			PRINTFORML 「I know that it's already pretty late, but...」
		PRINTFORMW 「E-Everyone's always happy to get a Christmas present, aren't they!」
		PRINTFORMW 「So then, I'll give you this!」
		SELECTCASE RAND:8
		CASE 1
			LOCALS:1 = Christmas
		CASE 2
			LOCALS:1 = Bethlehem's
		CASE 3
			LOCALS:1 = Santa Clause
		CASE 4
			LOCALS:1 = Reindeer
		CASE 5
			LOCALS:1 = Holy Night
		CASE 6
			LOCALS:1 = Snowy
		CASE 7
			LOCALS:1 = Stars & Stripes
		CASEELSE
			LOCALS:1 = Snow & Stars
		ENDSELECT
		SELECTCASE RAND:8
		CASE 1
			LOCALS:2 = Watch
		CASE 2
			LOCALS:2 = Lamp
		CASE 3
			LOCALS:2 = Mittens
		CASE 4
			LOCALS:2 = Card
		CASEELSE
			LOCALS:2 = Snowglobe
		ENDSELECT
		CALL GIFT_ORDER_MADE_FROM_CHARA([[クラウンピース]], LOCALS:1, LOCALS:2)
		PRINTL 
		CALL COLORMESSAGE(@"You receive【%ARTICLE(RESULTS)%】 from Clownpiece!", C_AQUA, 2)
		PRINTL 
		PRINTFORMW 「N-Next year it'll be your turn, okay!!」
		CFLAG:[[クラウンピース]]:1006 = 0
	;デート会話
	ELSEIF FLAG:デート相手 == [[クラウンピース]] && DATENAME_SPOT() != "on the road" && !デート会話:(CFLAG:111:現在位置 / 10)
		POINT = CFLAG:111:現在位置 / 10
		;▼博麗神社
		SELECTCASE STR:(POINT + 6000)
		CASE "桜並木の鳥居"
			;春
			IF DAY:2 == 1
				PRINTFORML 「The cherry blossoms here are super beautiful!」
				PRINTFORMW 「The first time I saw them, it made a huge impression on me!」
			;春以外
			ELSE
				PRINTFORML 「During spring, the cherry blossoms here are super pretty!」
				PRINTFORMW 「Every spring I make sure to go raid the cherry blossom viewing partiesー♪」
			ENDIF
		CASE "神社境内"
			PRINTFORML 「%CALLNAME:MASTER%, beware of that Hakurei shrine maiden!」
			PRINTFORMW 「If a prank gets found out, she's always the first one to come blow you away, you know.」
		CASE "神社本堂"
			PRINTFORML 「Did you know that they say there's a god in this shrine?」
			PRINTFORMW 「I wonder if the god here is as strong as %CFLAG:111:1099?"Goshujinsama"#"Master"%～...」
		CASE "神社縁側"
			;TW内の設定では別荘ということにしておく
			PRINTFORML 「My vacation home's right underneath the shrine right hereー」
			PRINTFORMW 「I don't really know why, but somehow the being in the basement of the shrine really suits my temperament.」
		CASE "妖精の大樹"
			;誰かいる
			IF GROUPMATCH(CFLAG:[[クラウンピース]]:現在位置, CFLAG:[[サニー]]:現在位置, CFLAG:[[ルナ]]:現在位置, CFLAG:[[スター]]:現在位置)
				PRINTFORML 「This is where my fairy friends live!」
				PRINTFORMW 「Let's play for a little whileー!」
			;留守
			ELSE
				PRINTFORML 「This is my fairy friends' house, but...」
				PRINTFORMW 「It looks like nobody's home right now...」
			ENDIF
		CASE "夢幻遺跡"
			PRINTFORML 「What is this placeー? It's so spacious...」
			PRINTFORMW 「What's up with this? Eii!」
		;▼命蓮寺
		CASE "お地蔵通り"
			PRINTFORML 「I don't go here very much, you know.」
			PRINTFORMW 「I forget exactly why, but for some reason temples are a bad place for a fairy.」
		CASE "枝垂れ柳の下"
			PRINTFORML 「Ooh, what a spooky tree!」
			PRINTFORMW 「It looks like it's haunted by ghosts, I bet!」
		CASE "命蓮寺境内"
			PRINTFORML 「I wonder if this is the youkai temple I've heard about～」
			PRINTFORMW 「Yeah, I can definitely sense some suspicious magical energy!」
		CASE "命蓮寺方丈"
			PRINTFORML 「Hey %CALLNAME:MASTER%, what do people do in this place?」
			PRINTFORMW 「For some reason, everyone here seems super busy...」
		CASE "墓地"
			PRINTFORML 「Wahh～! It's a grave～♪」
			PRINTFORMW 「Come to hell, everyone～♪」
		CASE "神霊廟広場"
			PRINTFORML 「Wowieー! What a huge and showy gate!」
			PRINTFORMW 「You can totally see how stuck-up the people here must be～」
		CASE "神霊廟道場"
			PRINTFORML 「Is this that hermit's dojo?」
			PRINTFORMW 「A hermit, huh～ I think %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"% mentioned her sometime～」
		;▼人里
		CASE "広場"
			PRINTFORML 「Oh! There's a super easy mark right over there!」
			PRINTFORMW 「Let's play a little prank!」
		CASE "商家町"
			PRINTFORML 「Hey, %CALLNAME:MASTER%! Let's go over there!」
			PRINTFORMW 「Ah! Buy that for me! Buy it! Hey! Please!」
		CASE "呑屋小道"
			PRINTFORML 「Ooh, so there's an izakaya over here!」
			PRINTFORMW 「No wonder I thought I could smell some sake!」
		CASE "寺子屋"
			PRINTFORML 「Do the humans go to school here? Hmmmm...」
			PRINTFORMW 「Is it okay if I doodle for a little while?」
		CASE "大衆浴場"
			IF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 < 360
				PRINTFORML 「Phew～! Refreshing～!」
				PRINTFORMW 「But %CALLNAME:MASTER%, why wouldn't they let us go into the bath together?」
			ELSE
				PRINTFORML 「Wahh～! A bath～♪」
				PRINTFORMW 「Do they have one of those big boiling-pot bathsー?」
			ENDIF
		CASE "連れ込み宿"
			;入った時点で合意取得するのね…,うふふ前か後かは絶頂したかで判断するので事前に絶頂させてるとちょっと齟齬
			IF EX:111:Ｃ絶頂 + EX:111:Ｖ絶頂 + EX:111:Ａ絶頂 + EX:111:Ｂ絶頂 + EX:111:Ｍ絶頂
				IF TALENT:111:処女
					CALL HPH_PRINT,@"「...KeheheheheBPB」","W"
				ELSE
					CALL HPH_PRINT,@"「...HPH」","W"
				ENDIF
			ELSE
				IF TALENT:111:処女
					CALL HPH_PRINT,@"「Hey, this is where, umm... Kehehehe...BPB」","W"
				ELSE
					CALL HPH_PRINT,@"「HurryHPH Let's goHPH」","W"
				ENDIF
			ENDIF
		CASE "長屋街"
			PRINTFORML 「Huuuhー so this is how humans live together, I seeー」
			PRINTFORMW 「%CALLNAME:MASTER%, why don't you live here too?」
		;▼霧の湖
		CASE "霧の湖"
			IF DAY:2 == 2
				PRINTFORML 「Kyahahahaー♪ That looks super refreshing～～!」
				PRINTFORMW 「%CALLNAME:MASTER%, let's go for a swim together♪」
			ELSE
				PRINTFORML 「Wow, it really is misty, isn't itー」
				PRINTFORMW 「Even if the fog clears up, this place doesn't seem very exciting...」
			ENDIF
		CASE "氷のかまくら"
			PRINTFORML 「Ahh, this is Cirno's houseー!」
			PRINTFORMW 「Kyahaha♪ Let's look around for her!」
		CASE "廃洋館"
			PRINTFORML 「What're we doing here? Nobody lives here...」
			PRINTFORMW 「Whahuh! S-Something strange moved over there...」
		CASE "正門"
			PRINTFORML 「This is that vampire's mansion, isn't it～ Sure enough it really is scarletー」
			PRINTFORMW 「You can't just go in there? Pfahaha♪ I'm a fairy, remember?」
		CASE "広間"
			PRINTFORML 「Oh? There's fairies working here...」
			PRINTFORMW 「I wonder if they're working here as servants or something.」
		CASE "食堂"
			PRINTFORMW 「Do you really eat in such a big room? That's awesome!」
		CASE "大図書館"
			PRINTFORML 「Wow, awesome! These are all books?」
			PRINTFORMW 「Well, not that I have the slightest interest in them...」
		CASE "地下室"
			PRINTFORML 「Whoa, I'm sensing some strong madness in this place!」
			PRINTFORMW 「This intimidating presence... I can't stand it!」
		;▼迷いの竹林
		CASE "竹林入り口"
			PRINTFORML 「%CALLNAME:MASTER%, have you heard of the Garden of the Sun?」
			PRINTFORMW 「I go there all the time to playー」
		CASE "迷いの小道", "斜角の竹林"
			PRINTFORML 「Whahuh? Didn't we just walk by this spot?」
			PRINTFORMW 「%CALLNAME:MASTER%, have we been going in circles?」
		CASE "兎の洞穴"
			PRINTFORML 「Brr! It's kinda chilly in here!」
			PRINTFORMW 「Huh, the temperature in a cave really doesn't change, does it.」
		CASE "永遠亭"
			PRINTFORML 「Ugh... It stinks...」
			PRINTFORMW 「What kind of hospital is this? I don't like it here...」
		CASE "無名の丘"
			PRINTFORML 「Wahahー! What a pretty flower field～! It's like it's out of a dream!」
			PRINTFORMW 「Ehe, I want to try making a flower garland real quick～♪」
		CASE "太陽の畑"
			PRINTFORML 「A lot of fairies live around here, there's always something going on.」
			PRINTFORMW 「Well, you could say it's a little bit like a meet-up spot, I guess?」
		CASE "永遠亭奥ノ院"
			PRINTFORML 「Huh, there's a mansion back behind the hospital!」
			PRINTFORMW 「Now then, where's a good spot to play a prank...」
		CASE "夢幻館"
			PRINTFORML 「What the heck is with this mansion?」
			PRINTFORMW 「Somehow, I get a weird feeling around here...」
		;▼魔法の森
		CASE "森の入り口"
			PRINTFORML 「Wow～ there's some really impressive miasma around here...」
			PRINTFORMW 「I can't help but get a shivery feeling in my spineー♪」
		CASE "香霖堂"
			PRINTFORML 「What is this place? A secondhand goods shop?」
			PRINTFORMW 「Is there something fun to do here?」
		CASE "古木の大樹"
			PRINTFORML 「That's a huge treeー」
			PRINTFORMW 「Whuh? It looks like fairies used to live here...」
		CASE "霧雨魔法店"
			PRINTFORML 「Is this that witch's house?」
			PRINTFORMW 「It's surprisingly small, isn't it.」
		CASE "人形の洋館"
			PRINTFORML 「Whose house is thisー?」
			PRINTFORMW 「Ah, a doll! Uhhh... I think it just moved...」
		CASE "再思の道"
			PRINTFORML 「Oooh... What a spooky place...」
			PRINTFORMW 「That flower over there, it looks a little bit like these flowers that bloom in Hell...」
		CASE "無縁塚"
			PRINTFORML 「What's up with this big rock?」
			PRINTFORMW 「You know, I get the feeling that this thing is kinda dangerous...」
		;▼冥界
		CASE "中有の道"
			PRINTFORML 「I wonder if this is that street I've heard about, the one with all the food stalls～」
			PRINTFORMW 「%CALLNAME:MASTER%, buy me something～!」
		CASE "三途の川"
			PRINTFORML 「I've heard of the Sanzu River before!」
			PRINTFORMW 「This is the first time I've seen it, but... Hmm, I guess you could say it looks like an unexpectedly normal river?」
		CASE "マヨヒガ"
			PRINTFORML 「There's a mansion in a place like this?」
			PRINTFORMW 「I guess there's some unusual things on the surface world～」
		CASE "彼岸"
			PRINTFORML 「The dead get judged in Higan, and usually stay in the underworld until it's time to get reincarnated.」
			PRINTFORMW 「――Or so I've heard, this is my first time actually coming here～♪」
		CASE "白玉楼庭"
			PRINTFORML 「That's a big garden～」
			PRINTFORMW 「If I had a garden like this, then I could play in it every day as much as I wanted, I bet.」
		CASE "白玉楼"
			PRINTFORML 「%CFLAG:111:1099?"Goshujinsama"#"Master"% told me not to bother the virtuous spirits too much...」
			PRINTFORMW 「But what type of ghost lives here? The evil kind of spirit?」
		CASE "地獄"
			PRINTFORML 「This is my old stomping grounds!」
			PRINTFORMW 「Well, it's kind of a boring place where nothing interesting ever happensー」
		CASE "畜生界"
			PRINTFORML 「Ughhー, I hate this placeー...」
			PRINTFORMW 「It makes my skin crawl when people who're supposed to be dead look so alive!」
		CASE "霊長園"
			PRINTFORML 「Huhー, I never knew there was a place like this so close by to Hell.」
			PRINTFORMW 「Do you know who made it, and what it's for?」
		;▼山麓
		CASE "麓の樹海"
			PRINTFORML 「Going mountain climbing with you, now that's a new idea～♪」
			PRINTFORMW 「It's like a picnic!」
		CASE "玄武の沢"
			IF DAY:2 == 4
				PRINTFORML 「I feel like going for a swim, but sure enough it's too cold...」
				PRINTFORMW 「Isn't there a warmer stream around here...?」
			ELSE
				PRINTFORML 「It's super fun to ride the rapids here! Go for broke!」
				PRINTFORMW 「Heyーheyー, let's do it, %CALLNAME:MASTER%♪」
			ENDIF
		CASE "大蝦蟇の池"
			PRINTFORML 「Ooh, this is a nice-looking pond.」
			PRINTFORMW 「Are you gonna go fishing?」
		CASE "正邪の隠れ家前"
			PRINTFORML 「Hmmmm, I found a suspicious-looking hideout!」
			PRINTFORMW 「Even though they're not a fairy, how could someone live in a place like this? They're definitely not a good person!」
		CASE "仙人の屋敷"
			PRINTFORML 「Whose house is thisー?」
			PRINTFORMW 「For some reason there's a bunch of animals around here!」
		CASE "間欠泉地下センター"
			PRINTFORML 「What the heck is thisー! So coolー!!」
			PRINTFORMW 「And for some reason it's kinda warm down here, tooー♪」
		CASE "森の深奥"
			PRINTFORML 「It's dark, but you're surrounded by nature and it doesn't feel gloomyー」
			PRINTFORMW 「For some reason I'm itching to make a ruckus!」
		;▼山頂
		CASE "九天の滝"
			SETCOLOR 0x47203C
			PRINTFORML 「Wowie～♪ What an awesome waterfall～～!」
			PRINTFORMW 「I can't even hear your voice over the noise～!」
			RESETCOLOR
		CASE "絶景の丘"
			PRINTFORML 「Awesome! You can see out over all of Gensokyo!」
			PRINTFORMW 「I wonder if I can see some places I haven't been to yetー?」
		CASE "山の湖"
			IF DAY:2 == 4
				PRINTFORML 「Whaah, it's all frozen...!」
				PRINTFORMW 「Ice skating, let's go ice skating!」
			ELSE
				PRINTFORML 「Kyahahaー♪ It looks refreshing～～!」
				PRINTFORMW 「%CALLNAME:MASTER%, let's go for a swim together♪」
			ENDIF
		CASE "守矢神社境内"
			PRINTFORML 「Oho? So there's a shine in this place, too.」
			PRINTFORMW 「Do you know what kind of god is in this one?」
		CASE "守矢神社本殿"
			PRINTFORML 「This one's a lot bigger and more impressive than the shrine at the base of the mountain.」
			PRINTFORMW 「Since they decided to set up shop at the top of the mountain, the god here's gotta be a really cocky one, you know.」
		CASE "天界"
			PRINTFORML 「Huhー, so this is what the land above the clouds looks like!」
			PRINTFORMW 「Whuh? You mean to say that this place is heaven?」
		CASE "虹龍洞"
			PRINTFORML 「What's up with this cave～」
			PRINTFORMW 「There seems to be a lot of treasure laying hidden around here!」
		;▼地底
		CASE "幻想風穴"
			PRINTFORML 「Even though it's dark, as long as we have this torch we'll be just fine, just fine♪」
			PRINTFORMW 「Ahh, make sure you don't look at the fire to closely, %CALLNAME:MASTER%...」
		CASE "地獄の深道"
			PRINTFORML 「I'd imagined that there'd be a spookier atmosphere down in the depths of the earth...」
			PRINTFORMW 「But instead it's kinda wondrous and prettyー」
		CASE "旧地獄街道"
			PRINTFORML 「Hmmm, a long time ago this place used to be Hell.」
			PRINTFORMW 「I wonder if the new hell will end up like this someday?」
		CASE "旧地獄温泉"
			IF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 < 360
				PRINTFORML 「Nguhー... I-It's a little hot, isn't it... Haha...」
				PRINTFORMW 「I g-guess this is the real thing...」
			ELSE
				PRINTFORML 「A hell cauldron onsen～? Don't make me laugh～」
				PRINTFORMW 「Something like this is just child's play, of course～」
			ENDIF
		CASE "ラブホ"
			IF EX:111:Ｃ絶頂 + EX:111:Ｖ絶頂 + EX:111:Ａ絶頂 + EX:111:Ｂ絶頂 + EX:111:Ｍ絶頂
				IF TALENT:111:処女
					CALL HPH_PRINT,@"「...KeheheheheBPB」","W"
				ELSE
					CALL HPH_PRINT,@"「...HPH」","W"
				ENDIF
			ELSE
				IF TALENT:111:処女
					CALL HPH_PRINT,@"「Hey, this is where, umm... Kehehehe...BPB」","W"
				ELSE
					CALL HPH_PRINT,@"「HurryHPH Let's goHPH」","W"
				ENDIF
			ENDIF
		CASE "地霊殿"
			PRINTFORML 「There's a mansion like this in the Former Hell...」
			PRINTFORMW 「Ahh! For some reason there's some weird animals here!?」
		CASE "灼熱地獄跡"
			PRINTFORML 「Around here there's some vengeful spirits who have fallen down to Hell, you know.」
			PRINTFORMW 「I'm gonna go get a little energy from these guys♪」
		;▼月
		CASE "槐安通路"
			PRINTFORML 「Is this what they call the dream world? So are we asleep right now?」
			PRINTFORMW 「Are we actually here right now? My dream self is... Not good... It's like I go out of my mind...」
		CASE "月の都"
			;謎の力
			PRINTFORML 「Thanks to %CFLAG:111:1099?"Goshujinsama"#"Master"%'s special power, it seems nobody can see us right now!」
			PRINTFORMW 「Well, after all we're just here to do a little reconnaissance.」
		CASE "綿月亭"
			PRINTFORML 「S-So huge...」
			PRINTFORMW 「It must be five times bigger than %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%'s mansion...」
		CASE "玉兎の街"
			;ウサギの話流用
			PRINTFORML 「Most of the rabbits here are weak and cowardly, but once in a while there's one with some guts, you knowー」
			PRINTFORMW 「The ones like that are worth their salt, so all in all I don't hate them.」
		CASE "桃林～砂浜"
			PRINTFORML 「The peaches here, they're so nice～...」
			PRINTFORMW 「All-you-can-eat peaches every single day!」
		CASE "静かの海"
			PRINTFORML 「This is my sea right hereー!」
			PRINTFORMW 「It's not much, but it's a step up from Hell! It's all-you-can-play around here♪」
		;○
		CASEELSE
			PRINTFORML 「Where are we nowー?」
			PRINTFORMDW There's no conversation set for this location, so please report it to the author! ： Triggering point＞{POINT}/{CFLAG:111:デート中}
		ENDSELECT
		;デート会話済み
		デート会話:POINT = 1
		TCVAR:111:353 = 1
	;レア
	ELSEIF !RAND:200
		PRINTFORMW 「Achoo!」
	;▼状況会話集
	;1-1,大雨,猛烈な雨,台風
	ELSEIF !GETBIT(TCVAR:111:359, 1) && (GROUPMATCH(天候, 5, 14) || FLAG:異常気象 == 9)
		CALL M_KOJO_K111_TALKSET("状況会話", 1, 1)
	;1-2,吹雪,猛吹雪
	ELSEIF !GETBIT(TCVAR:111:359, 1) && (GROUPMATCH(天候, 9) || FLAG:異常気象 == 10)
		CALL M_KOJO_K111_TALKSET("状況会話", 1, 2)
	;2,敏感,桃色の風
	ELSEIF !GETBIT(TCVAR:111:359, 2) && GROUPMATCH(FLAG:異常気象, 1, 2, 3, 4, 5, 8)
		CALL M_KOJO_K111_TALKSET("状況会話", 2)
	;3,パンツ
	ELSEIF !GETBIT(TCVAR:111:359, 3) && FLAG:異常気象 == 7
		CALL M_KOJO_K111_TALKSET("状況会話", 3)
	;4,春,野外
	ELSEIF !GETBIT(TCVAR:111:359, 4) && DAY:2 == 1 && OUTROOF(CFLAG:111:現在位置)
		CALL M_KOJO_K111_TALKSET("状況会話", 4)
	;5,秋,野外
	ELSEIF !GETBIT(TCVAR:111:359, 5) && DAY:2 == 3 && OUTROOF(CFLAG:111:現在位置)
		CALL M_KOJO_K111_TALKSET("状況会話", 5)
	;6,冬,野外
	ELSEIF !GETBIT(TCVAR:111:359, 6) && DAY:2 == 4 && OUTROOF(CFLAG:111:現在位置)
		CALL M_KOJO_K111_TALKSET("状況会話", 6)
	;7,夏,屋内
	ELSEIF !GETBIT(TCVAR:111:359, 7) && DAY:2 == 2 && !OUTROOF(CFLAG:111:現在位置)
		CALL M_KOJO_K111_TALKSET("状況会話", 7)
	;8,贈り物を貰った
	ELSEIF !GETBIT(TCVAR:111:359, 8) && TCVAR:[[クラウンピース]]:今日の贈り物 && FLAG:デート相手 == [[クラウンピース]]
		CALL M_KOJO_K111_TALKSET("状況会話", 8)
	;9,お気に入りの贈り物（確率）
	ELSEIF !GETBIT(TCVAR:111:359, 9) && CFLAG:[[クラウンピース]]:貰った贈り物 && !RAND:50
		CALL M_KOJO_K111_TALKSET("状況会話", 9)
	;10,サニーの話
	ELSEIF !GETBIT(TCVAR:111:359, 10) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[サニー]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 10, ABL:[[サニー]]:親密)
	;11,ルナの話
	ELSEIF !GETBIT(TCVAR:111:359, 11) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[ルナ]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 11, ABL:[[ルナ]]:親密)
	;12,スターの話
	ELSEIF !GETBIT(TCVAR:111:359, 12) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[スター]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 12, ABL:[[スター]]:親密)
	;13,チルノの話
	ELSEIF !GETBIT(TCVAR:111:359, 13) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[チルノ]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 13, ABL:[[チルノ]]:親密)
	;14,ラルバの話
	ELSEIF !GETBIT(TCVAR:111:359, 14) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[ラルバ]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 14, ABL:[[ラルバ]]:親密)
	;15,大妖精の話
	ELSEIF !GETBIT(TCVAR:111:359, 15) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[大妖精]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 15, ABL:[[大妖精]]:親密)
	;16,リリーホワイトの話
	ELSEIF !GETBIT(TCVAR:111:359, 16) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[リリーＷ]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 16, ABL:[[リリーＷ]]:親密)
	;17,リリーブラックの話
	ELSEIF !GETBIT(TCVAR:111:359, 17) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[リリーＢ]]:現在位置
		CALL M_KOJO_K111_TALKSET("状況会話", 17, ABL:[[リリーＢ]]:親密)
	;18,ヘカーティアとの話,ヘカーティアと純狐は純狐邸に住んでいると高頻度で発生してしまうので除外
	ELSEIF !GETBIT(TCVAR:111:359, 18) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[ヘカーティア]]:現在位置 && !M_KOJO_K111_JUNKO_KURASHI()
		CALL M_KOJO_K111_TALKSET("状況会話", 18)
	;19,純狐との話
	ELSEIF !GETBIT(TCVAR:111:359, 19) && CFLAG:[[クラウンピース]]:現在位置 == CFLAG:[[純狐]]:現在位置 && !M_KOJO_K111_JUNKO_KURASHI()
		CALL M_KOJO_K111_TALKSET("状況会話", 19)
	;20,七夕の話
	ELSEIF !GETBIT(TCVAR:111:359, 20) && FESTIVAL() == "七夕"
		CALL M_KOJO_K111_TALKSET("状況会話", 20)
	;21,満月の話
	ELSEIF !GETBIT(TCVAR:111:359, 21) && MOON_WATCH(DAY:3) == 9
		CALL M_KOJO_K111_TALKSET("状況会話", 21)
	;22,虹の話
	ELSEIF !GETBIT(TCVAR:111:359, 22) && TIME:7 == 1 && M_KOJO_K111_EARTH(CFLAG:[[クラウンピース]]:現在位置) && OUTROOF(CFLAG:[[クラウンピース]]:現在位置)
		CALL M_KOJO_K111_TALKSET("状況会話", 22)
;	;23,UFOの話（確率）,＞[寄り道する]に移設
;	ELSEIF !GETBIT(TCVAR:111:359, 23) && M_KOJO_K111_EARTH(CFLAG:[[クラウンピース]]:現在位置) && OUTROOF(CFLAG:[[クラウンピース]]:現在位置) && !RAND:50
;		CALL M_KOJO_K111_TALKSET("状況会話", 23)
	;24,一緒に住んでる時の話,6日に1回
	ELSEIF !GETBIT(TCVAR:111:359, 24) && M_KOJO_K111_JUNKO_KURASHI() && DAY % 6 == 0
		CALL M_KOJO_K111_TALKSET("状況会話", 24)
	;25,恋人になったばかりの話
	ELSEIF !GETBIT(TCVAR:111:359, 25) && FIRSTTIME("恋人", 1) && TALENT:[[クラウンピース]]:恋人
		CALL M_KOJO_K111_TALKSET("状況会話", 25)
	;26,眠いときの会話
	ELSEIF !GETBIT(TCVAR:111:359, 26) && TIME >= 1200
		CALL M_KOJO_K111_TALKSET("状況会話", 26)
	;27,えっちした後（満足した）
	ELSEIF !GETBIT(TCVAR:111:359, 27) && TCVAR:[[クラウンピース]]:355 && TALENT:[[クラウンピース]]:機嫌 > 0
		CALL M_KOJO_K111_TALKSET("状況会話", 27)
	;28,ほろ酔い
	ELSEIF !GETBIT(TCVAR:111:359, 28) && ALCOHOL_FACE(111) == "ほろ酔い"
		CALL M_KOJO_K111_TALKSET("状況会話", 28)

[SKIPSTART]
	ELSEIF !GETBIT(TCVAR:111:359, ) && 
		CALL M_KOJO_K111_TALKSET("状況会話", )
[SKIPEND]

	;恋人
	ELSEIF TALENT:111:恋人
		CALL M_KOJO_K111_TALKSET("恋人")
	;恋慕
	ELSEIF TALENT:111:恋慕
		CALL M_KOJO_K111_TALKSET("恋慕")
	;通常
	ELSE
		CALL M_KOJO_K111_TALKSET("その他")
	ENDIF
ENDIF
RETURN 1

@M_KOJO_K111_TALKSET(ARGS, ARG, ARG:1)
#DIM 汎用会話数
#DIM 恋慕会話数
汎用会話数 = 18
恋慕会話数 = 44
IF ARGS == "恋人"
	SELECTCASE RAND:(9 + 恋慕会話数 + 汎用会話数)
	CASE 1
		PRINTFORML 「Clownpie～ce is your lover♪」
		PRINTFORMW 「That's my new song, what do you think!?」
	CASE 2
		PRINTFORML 「How come cheating and adultery are bad things?」
		PRINTFORMW 「Because it's just a natural instinct to fall in love with somebody, right?」
		PRINTFORMW 「Ah, but, that's also the same reason why it's worth it to commit to one person!」
	CASE 3
		PRINTFORML 「Hmmmmmm......」
		PRINTFORMW 「Hey %CALLNAME:MASTER%, what is "love" anyway?」
	CASE 4
		PRINTFORMW 「%CALLNAME:MASTER%, what do you like best about me～?」
	CASE 5
		PRINTFORML 「What would you do if I were to do lewd things with some other guy?」
		PRINTFORMW 「Would you get mad? Or would you cry?」
	CASE 6
		PRINTFORML 「%CFLAG:111:1099?"Goshujinsama"#"Master"% told me that I'm the type who likes to play pranks on the one they like!」
		PRINTFORMW 「What the heck did she mean by thatー! That's embarrassing!」
	CASE 7
		;reference to WaHH ch. 28
		PRINTFORML 「When a fairy loses all their power, they turn into a magic rock called a "stone cherry" and go to sleep.」
		PRINTFORMW 「Just in case that ever happens to me, make sure to protect me, %CALLNAME:MASTER%...」
	CASE 8
		IF CFLAG:[[クラウンピース]]:子供人数 > 1
			PRINTFORML 「If you ever feel like giving up, just remember that me and %CHILDNAME:[[クラウンピース]]:(CFLAG:[[クラウンピース]]:子供人数 % 10)% and co. are here for you!」
		ELSEIF CFLAG:[[クラウンピース]]:子供人数
			PRINTFORML 「If you ever feel like giving up, just remember that me and %CHILDNAME:[[クラウンピース]]:1% are here for you!」
		ELSE
			PRINTFORML 「If you ever feel like giving up, just remember that I'm here for you!」
		ENDIF
		PRINTFORMW 「Whenever I'm having a hard time, I just think about you, %CALLNAME:MASTER%, and everything's better♪」
	CASE 9
		SELECTCASE M_KOJO_K111_MASTER_IMPRESSION()
		CASE "ロリコン"
			CALL HPH_PRINT,@"「You knowー, I love your slightly naughty side, %CALLNAME:MASTER%～HPH」","W"
		CASE "清掃中毒者"
			CALL HPH_PRINT,@"「You knowー, I love how obsessed you are with cleaning, %CALLNAME:MASTER%～HPH」","W"
		CASE "料理人"
			CALL HPH_PRINT,@"「You knowー, I love how you like to cook, %CALLNAME:MASTER%～HPH」","W"
		CASE "弾幕強者"
			CALL HPH_PRINT,@"「You knowー, I love your strong and reliable side, %CALLNAME:MASTER%～HPH」","W"
		CASE "昆虫王"
			CALL HPH_PRINT,@"「You knowー, I love how obsessed you are with catching bugs, %CALLNAME:MASTER%～HPH」","W"
		CASE "モテ男"
			;ずるしてません？
			PRINTFORMW 「%CALLNAME:MASTER%, have you been running around behind my back?」
		CASE "インテリ"
			CALL HPH_PRINT,@"「You knowー, I love your clear-headed side, %CALLNAME:MASTER%～HPH」","W"
		CASE "饒舌"
			CALL HPH_PRINT,@"「You knowー, I love how you always tell me funny stories, %CALLNAME:MASTER%～HPH」","W"
		CASE "金持ち"
			CALL HPH_PRINT,@"「You knowー, I love your money-hungry side, %CALLNAME:MASTER%～HPH」","W"
		CASEELSE
			CALL HPH_PRINT,@"「You knowー, I love your cheerful side, %CALLNAME:MASTER%～HPH」","W"
		ENDSELECT
	CASEELSE
		ARGS = 恋慕
		RESTART
	ENDSELECT
ELSEIF ARGS == "恋慕"
	SELECTCASE RAND:(恋慕会話数 + 汎用会話数)
	CASE 1
		PRINTFORML 「It's really nice around here, people aren't in pain.」
		PRINTFORMW 「Down in Hell, all you can hear is the cries of the suffering, and it really gets on your nerves!」
	CASE 2
		PRINTFORML 「%CALLNAME:MASTER%, what do you like bestー?」
		PRINTFORMW 「As for meー...」
	CASE 3
		PRINTFORML 「This outfit is super cute, isn't itー!」
		PRINTFORMW 「I had %CFLAG:111:1099?"Goshujinsama"#"Master"% make it for me♪」
	CASE 4
		PRINTFORML 「I wonder what we should play todayー」
		PRINTFORMW 「I wonder if I can raise a cub!」
	CASE 5
		PRINTFORML 「As for %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%ー, she tells me stories a bunchー and plays with me a bunchー」
		PRINTFORMW 「She pats me on the head a bunchー, and hugs me a bunchー, she's super duper kind, you know～♪」
	CASE 6
		PRINTFORML 「Come to think of it, what kind of ability do you have, %CALLNAME:MASTER%?」
		PRINTFORMW 「If we fought each other for real, I wonder what would happen?」
	CASE 7
		IF TALENT:[[クラウンピース]]:恋人
			PRINTFORML 「I've heard that there's stories about humans and youkai falling in love.」
			PRINTFORML 「But I've never heard about a love story between a human and a fairy...」
			CALL HPH_PRINT,@"「I guess we're the first onesHPH」","W"
		ELSE
			PRINTFORML 「I'm a fairy, and you're a human...」
			PRINTFORMW 「Hmmm～ What do you think about that, %CALLNAME:MASTER%?」
		ENDIF
	CASE 8
		PRINTFORML 「Hey, %CALLNAME:MASTER%ー」
		PRINTFORMW 「Ehehe, I just called out to youー」
	CASE 9
		PRINTFORML 「Ahhhー, if you fell down into Hell, then it might get a little more fun down thereー」
		PRINTFORMW 「Oh! But but, I don't really want you to fall down into Hell, %CALLNAME:MASTER%...」
	CASE 10
		PRINTFORML 「They say that faries can't die here on the surface world, so they sure seem to get picked on a lot.」
		PRINTFORMW 「But you don't do any of that, right %CALLNAME:MASTER%?」
	CASE 11
		PRINTFORML 「I wanna go someplace where there's fun stuff to doー♪」
		PRINTFORMW 「Like a casino! Or an amusement park!」
	CASE 12
		PRINTFORML 「Hey, %CALLNAME:MASTER%...」
		PRINTFORMW 「I wonder, do you think I'm... cute? Or do you think I'm cool?」
		PRINTFORMW 「Whuh? Funkyー?」
	CASE 13
		PRINTFORMW 「Hoh hoh hoooーh♪」
	CASE 14
		IF ABL:MASTER:清掃技能 >= 4
			PRINTFORML 「I heard! %CALLNAME:MASTER%, you're a cleaner, right?」
			PRINTFORMW 「Okay then, I'll make sure to make plenty of messes for your sake♪」
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, do you have a job?」
			PRINTFORMW 「I work as %CFLAG:111:1099?"Goshujinsama"#"Master"%'s underling～」
		ENDIF
	CASE 15
		PRINTFORML 「Fwaaaah～...」
		PRINTFORMW 「Somehow, being with you makes me feel really peaceful and sleepy～」
	CASE 16
		IF TCVAR:111:空腹時刻 - TIME:1 <= 0
			PRINTFORMW 「I've got a hankering for a hamburger!」
			TCVAR:111:356 = 1
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, what toppings do you like on your burger?」
		ENDIF
	CASE 17
		PRINTFORML 「How come human guys don't play in Danmaku games?」
		PRINTFORMW 「Come to think of it, what kind of games do humans usually play in the first place?」
	CASE 18
		PRINTFORML 「People on the surface world sure are weak.」
		PRINTFORMW 「I mean, just seeing bugs or bones makes their knees turn to rubber!」
	CASE 19
		;20日以上会ってなかった
		IF CFLAG:111:1003 >= 20
			PRINTFORMW 「Hey, what have you been doing since we last saw each other? Have you been busy?」
		;昨日会ってなかった
		ELSEIF CFLAG:111:1003
			PRINTFORML 「%CALLNAME:MASTER%, what were you up to yesterdayー?」
			PRINTFORMW 「What I was doing was——」
		;昨日会った
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, we've been playing together a lot recently!」
			PRINTFORMW 「Let's play some more tomorrow～!」
		ENDIF
	CASE 20
		PRINTFORML 「Fairies here on the surface world are weak, but there sure are a lot of them, you know.」
		PRINTFORMW 「There aren't any on the moon, maybe it's a little too harsh there...」
	CASE 21
		PRINTFORML 「%CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"% is some kind of spirit, apparently.」
		PRINTFORMW 「Hey hey, what's the difference between a spirit and a ghost?」
	CASE 22
		PRINTFORML 「Recently, it seems that some type of Danmaku game with fighting is becoming popular.」
		PRINTFORMW 「%CALLNAME:MASTER%, let's try it! It's okay, I'll go easy on youー♪」
	CASE 23
		PRINTFORML 「Huhー, so shrines are where gods are worshiped...」
		PRINTFORMW 「Is there a shrine to %CFLAG:111:1099?"Goshujinsama"#"Master"% somewhere?」
	CASE 24
		PRINTFORML 「The other day I found this super weird toy!」
		PRINTFORMW 「But it was broken, so I couldn't do anything with it～」
	CASE 25
		PRINTFORML 「What's it like in the outside world?」
		PRINTFORML 「I mean, they say it's dangerous, so I shouldn't go there.」
		PRINTFORMW 「Are there really places in the outside world that are more dangerous than Hell?」
	CASE 26
		IF TIME >= 1200
			PRINTFORML 「Aww, it's nighttime already...」
			PRINTFORMW 「Time sure seems to fly by when you're with me, %CALLNAME:MASTER%!」
		ELSEIF TIME >= 900
			PRINTFORMW 「What should we play next?」
		ELSE
			PRINTFORMW 「What should we play today, I wonder～」
		ENDIF
	CASE 27
		PRINTFORML 「What do you think's the opposite of madness?」
		PRINTFORMW 「The answer's simple, right?」
	CASE 28
		PRINTFORML 「I wonder how big Gensokyo is...」
		PRINTFORMW 「I wonder if sometime I should try to fly alllll the way to the edge!」
	CASE 29
		PRINTFORML 「%CFLAG:111:1099?"Goshujinsama"#"Master"% taught me how to use moon Danmaku!」
		PRINTFORMW 「That's why there's three of them, you know～」
