					PRINTFORMW 「뭐, 그냥 달 위에서 배회하고 있는 거겠지~」
				ENDIF
			ELSEIF YOUBI_MATCH(DAY, "火")
				IF TALENT:MASTER:清掃中毒 || ABL:MASTER:清掃技能 >= 6
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%(는) 네가 온 이후로 우리 집이 정말 깨끗하고 정돈됐어, 알잖아.」
					PRINTFORMW 「네가 이렇게 결벽증일 줄은 상상도 못 했어...」
				ELSEIF ABL:MASTER:清掃技能 < 3 || TALENT:MASTER:汚臭耐性 > 0
					PRINTFORML 「%CALLNAME:MASTER%,왠지 네가 온 이후로 우리 집이 너무 지저분해진 것 같아...」
					IF TALENT:MASTER:汚臭耐性 > 0
						PRINTFORMW 「...제대로 목욕이라도 했어?」
					ELSE
						PRINTFORMW 「우리 둘 다 여기 있으니 어질러진 것들이 두 배가 됐지, 알잖아.」
					ENDIF
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%, 무슨 이유에서인지 당신이 온 뒤로 우리 집이 평소보다 더 깨끗해진 것 같아..」
					PRINTFORMW 「그럼 균형을 맞추려면 내가 더 지저분해져야겠네!」
				ENDIF
			ELSEIF YOUBI_MATCH(DAY, "水")
				PRINTFORML 「오늘 빨래 담당이야, %CALLNAME:MASTER%!」
				IF IS_FEMALE(MASTER) ;custom code
					PRINTFORMW 「모두의 옷을 한꺼번에 빨래통에 넣어도 괜찮을 것 같아~」
				ELSE
					PRINTFORMW 「우리 옷이랑 당신 옷을 섞으려고 하면, %CFLAG:111:1099?"Goshujinsama"#"Master"%'가 너를 죽일 거니까 알아둬?」
					;「『最初で最後の無名の弾幕』だからね」も捨てがたい……。
				ENDIF
			ELSEIF YOUBI_MATCH(DAY, "木")
				PRINTFORML 「오늘 저녁 식사 근무는 당신이야, %CALLNAME:MASTER%!」
				IF TALENT:[[クラウンピース]]:恋慕
					PRINTFORMW 「헤이 헤이, 같이 만들자ー♪」
				ELSE
					PRINTFORMW 「헤이 헤이, 뭘 만들 거야─?」
				ENDIF
			ELSEIF YOUBI_MATCH(DAY, "金")
				;純狐が恋慕だと家賃が無くなる
				IF TALENT:[[純狐]]:恋慕 && !FIRSTTIME("家賃", 1)
					IF FIRSTTIME("家賃カット")
						PRINTFORML 「흠~ 오늘이 월세 납부일인데 말이야...」
						PRINTFORMW 「%CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%'의 생각이었지만, 무슨 이유에서인지 %CALLNAME:MASTER%에게는 월세를 받지 않기로 했어!」
						IF TALENT:[[クラウンピース]]:恋人
							PRINTFORMW 「그럼 너도 이제 가족이 된 거네♪」
						ELSEIF TALENT:[[クラウンピース]]:恋慕
							PRINTFORMW 「그럼 그 말은... %조사처리(CALLNAME:MASTER,"가")% 이제 가족이라는 건가!?」
						ELSE
							PRINTFORMW 「그럼 너도 가족의 일원이란 거겠지...?」
						ENDIF
						;純狐とヘカーティアが恋慕だと逆に給料日になる,多すぎ？
					ELSEIF TALENT:[[ヘカーティア]]:恋慕
						PRINTFORML 「아, 맞아요! %CFLAG:111:1099?"Goshujinsama"#"Master"%이 이것을 당신에게 주라고 했어요, %CALLNAME:MASTER%!」
						PRINTL 
						PRINTFORMDL 그녀가 당신에게 두꺼운 봉투를 건넨다!
						PRINTW 
						PRINTFORMW 「크르릉... 불공평해, 아무것도 안 했잖아ー!」
						MONEY += 100000
					ELSE
						;TGIF
						PRINTFORML 「오늘도 금요일이네~」
						SELECTCASE RAND:2
							CASE 1
								PRINTFORMW 「음, 우리 둘 다 금요일 밤에는 편하게 지내온 것 같네!」
							CASEELSE
								PRINTFORMW 「그래서 "드디어 금요일이다"라는 말은 실제로 무슨 뜻이야?」
						ENDSELECT
					ENDIF
					;安すぎる家賃,まぁ現実的に考えたら給料も安いし（なお物価）
				ELSE
					PRINTFORML 「생각해 보니 오늘은 월세 납부일이네.」
					PRINTFORMW 「그래서 내가 돈을 받으러 온 거야!」
					IF MONEY < 10000
						PRINTFORML 「말하려고 했는데, 음... %CALLNAME:MASTER%, 돈이 없잖아!」
						PRINTFORMW 「이번엔 그냥 건너뛰어야 할 것 같아, 하지만 이 일을 %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%에게 보고할 거야!」
						CALL CHANGE_CFLAG(4, [[純狐]], -10)
						CALLF FIRSTTIME("家賃")
					ELSE
						PRINTL 
						PRINTFORMDL 월세로 %金額表示(10000)%를 지불했다!
						PRINTW 
						IF FIRSTTIME("家賃")
							PRINTFORMW 「아니 아니, %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%조차도 네가 여기서 공짜로 지내도록 내줄 만큼 순진하진 않지, 그렇지?」
						ELSE
							PRINTFORML 「알겠습니다, 지불해 주셔서 감사합니다♪」
							PRINTFORMW 「%CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%가 만족할 거라고 확신합니다!」
						ENDIF
						MONEY -= 10000
						CALL CHANGE_CFLAG(4, [[純狐]], 1 + ABL:[[純狐]]:親密)
					ENDIF
				ENDIF
			ENDIF
			;恋人になったばかりの話,一回だけ表示される
		CASE 25
			IF FIRSTTIME("恋人")
				PRINTFORML 「우리가 연인이 된 건 정말 멋지다고 생각하지만...」
				PRINTFORMW 「연인이라는 게 실제로 뭘 하는 건지 설명해 줄 수 있어?」
			ENDIF
			;眠いときの会話
		CASE 26
			PRINTFORML 「하아암~...」
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「졸려지는 것 같아...」
				CASE 2
					PRINTFORMW 「음... 피곤해...」
				CASEELSE
					PRINTFORMW 「으음~...」
			ENDSELECT
			;えっちした後（満足した）
		CASE 27
			SELECTCASE RAND:3
				CASE 1
					CALL HPH_PRINT,@"「키야하하~ 얼마 전에 했던 장난들 정말 굉장했어...큭큭」","W"
				CASE 2
					CALL HPH_PRINT,@"「쿠후후~ 다시 섹스하자...HPH」","W"
				CASEELSE
					CALL HPH_PRINT,@"「음~하프 정말 상쾌해~♪」","W"
			ENDSELECT
			;ほろ酔い
		CASE 28
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「술 더 줘!」
				CASE 2
					PRINTFORMW 「술 좀 더 마시고 싶어~♪」
				CASEELSE
					PRINTFORMW 「캬하하~ ♪ 훨씬 더 취했어!」
			ENDSELECT
	ENDSELECT
	SETBIT TCVAR:111:359, ARG
ENDIF
