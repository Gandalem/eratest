			PRINTFORMDL 당신의 눈과 클라운피스의 시선이 마주하고, 당신의 입술이 키스로 맞닿는다...
			PRINTW 
			CALL HPH_PRINT,@"「음~...? 음? ...츄우후ㅍ」","W"
			CALL HPH_PRINT,@" 「푸하하하헵이봐, 다시 하자!」","W"
			CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH」","W"
			IF TALENT:[[クラウンピース]]:恋人
				;無限キス
				LOCAL = EXP:111:キス経験 * 2
				LOCAL:1 = 0
				WHILE LOCAL < RAND:100
				PRINTL 
				PRINTFORMW 「다시 한번, 다시 한번♪」
				CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH 추우HPH」","W"
				LOCAL = LOCAL / 2
				LOCAL:1 ++
				;一応
				SIF LOCAL:1 >= 8
					BREAK
				WEND
				SIF LOCAL:1
					CALL HPH_PRINT,@"「케헤헤헵프ㅎ」","W"
			ELSE
				IF EXP:111:キス経験 * 2 < RAND:100
					PRINTL 
					PRINTFORMW 「다시 한번, 다시 한번♪」
					CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH 추우HPH」","W"
					CALL HPH_PRINT,@"「케헤헤헵프ㅎ」","W"
				ENDIF
			ENDIF
	ENDSELECT
ELSEIF ARGS == "その他"
	PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 입술을 자신의 것으로 막는다...
	PRINTW 
	SELECTCASE RAND:2
		CASE 1
			CALL HPH_PRINT,@"「츄우-후피」","W"
		CASEELSE
			CALL HPH_PRINT,@"「키스 키스HPH」","W"
	ENDSELECT
ENDIF
