;イラマチオ
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF !FLAG:時間停止
		IF FIRSTTIME("精液の味")
			PRINTFORMW 「크윽... 크헉, 크윽... 우으...」
		ELSE
			PRINTFORML 「흐읍... 크윽, 헉, 흐으음...」
			PRINTFORMW 「%CALLNAME:MASTER%, 너무 심했잖아!」
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
