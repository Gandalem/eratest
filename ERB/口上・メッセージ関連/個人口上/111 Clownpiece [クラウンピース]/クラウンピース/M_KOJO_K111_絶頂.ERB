@M_KOJO_MESSAGE_PALAMCNG_B_K111
SIF FLAG:時間停止
	RETURN 1
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	CALL HPH_PRINT,@"「M-내 가슴이...! 우유가 뿜어져 나온다~~BPB」","W"
