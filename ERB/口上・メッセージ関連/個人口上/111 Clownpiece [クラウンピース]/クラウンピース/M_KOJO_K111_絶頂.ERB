			CASE 0
				CALL HPH_PRINT,@"「아앙흐헵 아앙흐헵 아아아~ 갈 것 같아! C-가려고 있어~~ㅎㅍㅎㅍㅎ」","W"
			CASE 1
				CALL HPH_PRINT,@"「아응ㅎㅍ 정말 좋다ㅎㅍ」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%HPH 사정 HPH 쿠우웅~~HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「아앙흐프 그것은 안 좋아 프하 곧 오겠어, 곧 오겠어 프하」","L"
				CALL HPH_PRINT,@"「크으으으응~~~~~흐읍흐읍」","W"
			CASE 3
				CALL HPH_PRINT,@"「아와아ㅎㅍ 하아ㅎㅍ 커ㅁㅎㅍ 커밍ㅎㅍ 커미이이잉~~ㅎㅍ」","W"
