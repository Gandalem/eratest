@M_KOJO_MESSAGE_PALAMCNG_A_K111_20(ARG)
;-------------------------------------------------
;手淫フェラ
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF !FLAG:時間停止
		IF FIRSTTIME("精液の味")
			PRINTFORMW 「응?! 우으, 크윽... 이거 쓰네...」
			;精飲
		ELSEIF EXP_UP(15) == NOWEX:PLAYER:射精 * 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「응음응우... 꿀꺽.」
					CALL HPH_PRINT,@"「나아~ 후우. 이걸로 내 힘이 강해지는 기분이야!」","W"
				CASE 1
					PRINTFORML 「음~, 응구움응구... 핥핥...」
					PRINTFORMW 「모두 짜낼 거야~♪」
				CASE 2
					PRINTFORML 「냠냠... 꿀꺽.」
					CALL HPH_PRINT,@"「음... 맛있다」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「음~, %TOLOWER(RANDKISS("suck"))%♪ 휴~, 상쾌했나?」
				CASE 1
					PRINTFORML 「흠흠흠... 나블레—」
					PRINTFORMW 「와아! 엄청 많이 나왔네♪」
				CASE 2
					PRINTFORML 「음, 음... 핥기...」
					CALL HPH_PRINT,@"「음~ 당신도 맛보고 싶으신가요, %CALLNAME:MASTER%?」","W"
			ENDSELECT
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

