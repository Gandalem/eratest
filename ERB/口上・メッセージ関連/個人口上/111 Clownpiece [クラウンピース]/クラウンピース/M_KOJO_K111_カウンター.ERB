	LOCALS = glowing penis
ELSEIF TALENT:MASTER:形状 == 5
	LOCALS = brutal penis
ELSEIF TALENT:MASTER:形状 == 6
	LOCALS = gigantic penis
ELSE
	IF TALENT:MASTER:濃厚精液
		LOCALS = thick penis
	ELSE
		LOCALS = penis
