;==================================================
;5,手淫フェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K111_5
CALL M_KOJO_MESSAGE_SCOM_K111_5_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K111_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;フェラチオと同じ
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		RETURN 1
	ELSEIF NOWEX:MASTER:11
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「흐응흠 흐음흠 %FSYN("lips_over")%... 갈고 싶어하는 것 같아~」","W"
				CALL HPH_PRINT,@"「괜찮아, 내 입안에 싸줘 HPH NnmmnnmHPHHPH Nnhmmm～～～HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「흐응 흐응 아... 정액이 엄청 많이 나오고 있어... 후후」","W"
				CALL HPH_PRINT,@"「곧 사정할 것 같아? 그럼 이렇게 해봐... 음무, %TOLOWER(RANDKISS("suck"))%, %TOLOWER(RANDKISS("suck"))%... 응응음~~~흐읍」","W"
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「내가 HPH 끝을 핥을 때 기분이 좋아? 챱챱HPH」","W"
				CALL HPH_PRINT,@"「아암흠... 핥핥... %RANDKISS("suck")%흐읍」","W"
			CASE 1
				CALL HPH_PRINT,@"「아아-흐읍」","W"
				CALL HPH_PRINT,@"「핥는 소리... %RANDKISS("suck")%, %TOLOWER(RANDKISS("suck"))%HPH 기분 좋아? 핥는 소리-핥는 소리...HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「음... 츄, %TOLOWER(RANDKISS("빨아먹다"))%...큭」","W"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%」의 거시기, 정말 맛있어...흐읍","W"
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K111_{SELECTCOM}_1
RETURN 1
