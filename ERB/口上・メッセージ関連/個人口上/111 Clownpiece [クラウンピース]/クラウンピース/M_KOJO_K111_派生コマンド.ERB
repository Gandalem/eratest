;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K111_6
CALL M_KOJO_MESSAGE_SCOM_K111_6_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K111_6_1
;custom code, moved from M_KOJO_MESSAGE_COM_K111_72
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	IF FLAG:時間停止
		RETURN 1
	ELSE
		CALL HPH_PRINT,@"「후와아헵 거기! 너무 좋아헵 더해헵 나아항헵」","W"
	ENDIF
ENDIF
RETURN 1
