RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K111_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;２つあるけど？？コピペです
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		RETURN 1
		;種付けプレス
	ELSEIF TEQUIP:TARGET:体位 == POSE_MISSIONARY ;custom code
		CALL HPH_PRINT,@"「하안, 하아... HPH %CALLNAME:MASTER%, 안아줘 HPH」","W"
		CALL HPH_PRINT,@"「더 많은 HPH 더 많은 HPH 정액 잔뜩 주세요아아앙 HPH」","W"
		;交尾（後背位）
	ELSEIF GROUPMATCH(TEQUIP:TARGET:体位, POSE_DOGGYSTYLE, POSE_STANDING_FROM_BEHIND) ;custom code
		CALL HPH_PRINT,@"「하아, 하아, 하아, 하아HPH %CALLNAME:MASTER%, 더 깊이 HPH해줘」","W"
		CALL HPH_PRINT,@"「정액을 잔뜩 줘 HPH 모든 방울을 쏴내 HPH」","W"
	ELSE
		CALL HPH_PRINT,@"「아응, 아하햣ㅍ 오 누후ㅎㅍ 너무 거칠어ㅎㅍ」","W"
		CALL HPH_PRINT,@"「아흐, 아, 으음흐흣 %CALLNAME:MASTER%, %CALLNAME:MASTER%흐흣」","W"
	ENDIF
	RETURN 1
ENDIF
