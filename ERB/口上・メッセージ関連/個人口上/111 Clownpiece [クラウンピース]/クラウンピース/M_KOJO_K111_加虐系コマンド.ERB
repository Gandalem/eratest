;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K111_100
CALL M_KOJO_MESSAGE_COM_K111_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K111_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「히이이! 아파!!」
		PRINTFORMW 「도대체 왜 나를 때리는 거야...」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
	ELSE
		IF EXP:111:苦痛快楽経験 >= 50
			PRINTFORMW 「아, 아앗! 제발 그만해...」
		ELSE
			PRINTFORMW 「아이쿠! 왜 이러는 거야... 그만해, %CALLNAME:MASTER%...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
