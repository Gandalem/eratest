			PRINTFORMDW For some reason %HE_SHE_CHILD(111,,TALENT:111:育児中)% rarely bothers Papa for anything...
		CASE 2
			PRINTFORMW 「A doggie, lookie, a doggie!」
			PRINTFORMW 「Is it time for tasty din-din yet?」
			PRINTFORML 「I like the squishy squishy, so soft...」
			PRINTW 
			PRINTFORMDW %HE_SHE_CHILD(111,,TALENT:111:育児中)%'s getting pretty good at begging...
		CASEELSE
