PRINTL 
;親が分からない,思慕でも恋慕でもない
IF CFLAG:111:(1020 + (TALENT:111:育児中)) || (!TALENT:111:思慕 && !TALENT:111:恋慕)
	PRINTFORMDL %CALLNAME:(TALENT:111:育児中)% has gotten a lot more intelligent, and is now capable of doing many things on %HIS_HER_CHILD(111,,TALENT:111:育児中)% own.
	PRINTFORMDW In particular it seems %HE_SHE_CHILD(111,,TALENT:111:育児中)%'s developed a taste for pranks and mischief...
	PRINTFORMDW Clownpiece's frustration constantly threatens to boil over, but Hecatia gently holds her back and calms her nerves...
ELSE
	PRINTFORMDL %CALLNAME:(TALENT:111:育児中)% has gotten a lot more intelligent, and is now capable of doing many things on %HIS_HER_CHILD(111,,TALENT:111:育児中)% own.
	PRINTFORMDW In particular it seems %HE_SHE_CHILD(111,,TALENT:111:育児中)%'s developed a taste for pranks and mischief...
	PRINTFORMDL After all, it's the fundamental instinct of fairies...
	PRINTW 
	PRINTFORMW 「%CALLNAME:MASTER%～! %CALLNAME:(TALENT:111:育児中)%-tan hid my things again～!」
	;女の子
	IF TALENT:(TALENT:111:育児中):2 == 1
		CALL M_KOJO_COLOR_K111_CHILD(1)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 1
			PRINTFORML 「I wanna play with mama's things tooー!」
		CASE 2
			PRINTFORML 「No I didn't! Mama said I could have itー!」
		CASEELSE
			PRINTFORML 「But I was just borrowing it? Is it okay if I'm just borrowing?」
		ENDSELECT
	;男の子
	ELSEIF TALENT:(TALENT:111:育児中):2 == 2
		CALL M_KOJO_COLOR_K111_CHILD(2)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 11
			PRINTFORML 「No I didn't! I was just going along with the other fairies!」
		CASE 12
			PRINTFORML 「Buuuut, it's because you ate all my snacks, Mama!」
		CASEELSE
			PRINTFORML 「Ehehehe, you'll never find where I put it～」
		ENDSELECT
	ENDIF
	PRINTW 
	PRINTFORMDL It looks like it's getting pretty frustrating for both of them...
	PRINTFORMDL Come to think of it, you haven't been able to give %HIM_HER_CHILD(111,,TALENT:111:育児中)% new things to match %HIS_HER_CHILD(111,,TALENT:111:育児中)% increasing maturity.
	PRINTFORMDW Now's a good time to give %HIM_HER_CHILD(111,,TALENT:111:育児中)% something useful as a present.
	PRINTL 
	PRINTFORMDL What would be a good gift for %CALLNAME:(TALENT:111:育児中)%?
	IF TALENT:(TALENT:111:育児中):2 == 1
		PRINTDL [1] - A walking stick
	ELSEIF TALENT:(TALENT:111:育児中):2 == 2
		PRINTDL [1] - A sword
	ENDIF
	PRINTDL [2] - A hair accessory
	PRINTDL [3] - A book
	INPUT
	IF RESULT == 1
		CFLAG:111:(1040 + (TALENT:111:育児中)) = 1
	ELSEIF RESULT == 2
		CFLAG:111:(1040 + (TALENT:111:育児中)) = 2
	ELSE
		CFLAG:111:(1040 + (TALENT:111:育児中)) = 3
	ENDIF
	PRINTFORMDL You give %CALLNAME:(TALENT:111:育児中)% a new %M_KOJO_K111_CHILD_PRESENTNAME(TALENT:111:育児中)% as a present.
	PRINTFORMDL %CALLNAME:(TALENT:111:育児中)% is ecstatic, but for some reason Clownpiece looks jealous...
	PRINTFORMDW Hopefully this will reduce the "mischief" a little bit...
	;1/3の確率で性格変動
	SIF !RAND:3
		CALL M_KOJO_K111_CHILD_TYPE_SHIFT(TALENT:111:育児中, CFLAG:111:(1040 + (TALENT:111:育児中)))
ENDIF

;-------------------------------------------------
@M_KOJO_EVENT_K111_CHILD_RAISING_就学
;-------------------------------------------------
CALL M_KOJO_COLOR_K111
PRINTL 
;親が分からない,思慕でも恋慕でもない
IF CFLAG:111:(1020 + (TALENT:111:育児中)) || (!TALENT:111:思慕 && !TALENT:111:恋慕)
	PRINTFORMDL %CALLNAME:(TALENT:111:育児中)% has started attending temple school.
	PRINTFORMDW %HE_SHE_CHILD(111,,TALENT:111:育児中)% isn't the purest person, so there's bound to be troubles and hardships, but the teachers should be able to handle it.
	PRINTFORMDL Still, children sure do grow up fast...
	PRINTFORMDW They day %HE_SHE_CHILD(111,,TALENT:111:育児中)%'ll separate from %HIS_HER_CHILD(111,,TALENT:111:育児中)% parents will come before you know it...
ELSE
	PRINTFORMDL Starting from today, %CALLNAME:(TALENT:111:育児中)% will be attending temple school.
	PRINTFORMDL You were worried about how to handle the fact that %HE_SHE_CHILD(111,,TALENT:111:育児中)%'s a half-fairy.
	PRINTFORMDL In order to acclimate to human society, it's necessary to send %HIM_HER_CHILD(111,,TALENT:111:育児中)% so that %HE_SHE_CHILD(111,,TALENT:111:育児中)% can interact with other kids.
	PRINTFORMDL You've already consulted with the teacher, so everything should be fine.
	PRINTW 
	PRINTFORMW 「%CALLNAME:(TALENT:111:育児中)%-tan, come back safe～!」
	;女の子
	IF TALENT:(TALENT:111:育児中):2 == 1
		CALL M_KOJO_COLOR_K111_CHILD(1)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 1
			PRINTFORML 「Yeah! Mama, Papa, I'm leaving for schoolー!!」
			PRINTW 
			PRINTFORMDL With that, %CALLNAME:(TALENT:111:育児中)% flies off, headed to school.
			PRINTFORMDW When %HE_SHE_CHILD(111,,TALENT:111:育児中)% gets home today, you'll have to tell %HIM_HER_CHILD(111,,TALENT:111:育児中)% to make sure to walk from now on...
		CASE 2
			PRINTFORMW 「Okayー, I'm off!」
			PRINTFORML （Fufu, it's so exciting to be allowed to go out on my own!）
			PRINTFORML （I'll make sure to enjoy it to the fullest♪）
			PRINTW 
			PRINTFORMDL You worry that %CALLNAME:(TALENT:111:育児中)% might be thinking of temple school as just a playground...
			PRINTFORMDW However that's not a common misconception with children, so it's probably fine!
		CASEELSE
			PRINTFORMW 「Okay Mama, I'm going now!」
			PRINTFORML 「Papa, please take care of Mama while I'm gone!」
			PRINTW 
			PRINTFORMDL %CALLNAME:(TALENT:111:育児中)%'s smart enough to know which one is the real parent. No inaccuracies there.
			PRINTFORMDW Maybe %HE_SHE_CHILD(111,,TALENT:111:育児中)% really is a genius!
		ENDSELECT
	;男の子
	ELSEIF TALENT:(TALENT:111:育児中):2 == 2
		CALL M_KOJO_COLOR_K111_CHILD(2)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 11
			PRINTFORML 「Yeah! Mama, Papa, I'm leaving for schoolー!!」
			PRINTW 
			PRINTFORMDL With that, %CALLNAME:(TALENT:111:育児中)% flies off, headed to school.
			PRINTFORMDW When %HE_SHE_CHILD(111,,TALENT:111:育児中)% gets home today, you'll have to tell %HIM_HER_CHILD(111,,TALENT:111:育児中)% to make sure to walk from now on...
		CASE 12
			PRINTFORMW 「Haaah... Temple school sounds so boooring though...」
			PRINTFORML 「Off I go...」
			PRINTW 
			PRINTFORMDL %CALLNAME:(TALENT:111:育児中)% seems a bit reluctant to leave.
			PRINTFORMDW You might need to rethink this sometime.
		CASEELSE
			PRINTFORML 「Yeah～ I'm going now～」
			PRINTW 
			PRINTFORMDL %CALLNAME:(TALENT:111:育児中)% is obedient and quiet. No problems there.
			PRINTFORMDW You'll just need to make sure that %HE_SHE_CHILD(111,,TALENT:111:育児中)% doesn't get bullied...
		ENDSELECT
	ENDIF
	PRINTFORMDL Still, children sure do grow up fast.
	PRINTFORMDL They day %HE_SHE_CHILD(111,,TALENT:111:育児中)%'ll separate from %HIS_HER_CHILD(111,,TALENT:111:育児中)% parents will come before you know it...
	PRINTFORMDW You can't help but get a little sentimental.
ENDIF

;-------------------------------------------------
@M_KOJO_EVENT_K111_CHILD_RAISING_自立前
;-------------------------------------------------
CALL M_KOJO_COLOR_K111
PRINTL 
;親が分からない,思慕でも恋慕でもない
IF CFLAG:111:(1020 + (TALENT:111:育児中)) || (!TALENT:111:思慕 && !TALENT:111:恋慕)
	PRINTFORMDL %CALLNAME:(TALENT:111:育児中)%'s growing up fast, they're already almost the sam height as Clownpiece.
	PRINTFORMDL It won't bee long before they're out on their own.
	PRINTFORMDL When that time comes, how will %CALLNAME:(TALENT:111:育児中)% handle independence?
	PRINTFORMDW You're really not sure...
ELSE
	PRINTFORMDL %CALLNAME:(TALENT:111:育児中)%'s becoming a surprisingly sensible person.
	PRINTFORMDL And besides that, %HE_SHE_CHILD(111,,TALENT:111:育児中)%'s now almost the same height as Clownpiece.
	PRINTFORMDL Rather, %HE_SHE_CHILD(111,,TALENT:111:育児中)%'s still growing, so %HE_SHE_CHILD(111,,TALENT:111:育児中)%'ll overtake Clownpiece before long.
	PRINTFORMDL You're sure that when that happens――
	PRINTW 
	PRINTFORML 「%CALLNAME:(TALENT:111:育児中)%-tan, what do you plan to do when you grow up?」
	PRINTFORML 「Do you just plan to live with Mama forever?」
	PRINTW 
	;女の子
	IF TALENT:(TALENT:111:育児中):2 == 1
		CALL M_KOJO_COLOR_K111_CHILD(1)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 1
			PRINTFORMW 「Yeah... If possible, I'd just stay with you forever, Mama...」
			PRINTFORML 「But if I want to be an idol, I think that'd be bad, so I should go live on my own!」
			PRINTW 
			CALL M_KOJO_COLOR_K111
			PRINTFORML 「An idol?」
			PRINTW 
			CALL M_KOJO_COLOR_K111_CHILD(1)
			PRINTFORMW 「That's right! A suーperーstarー of singing and dancing!」
			PRINTFORML 「I may be a fairy, but I'm a human too, you know.」
			PRINTFORMW 「With my glamorous body and cute style, I'm sure to attract humans and fairies from all over the world and reach the peak of popularity!」
			PRINTFORML 「And besides, heart power and toughness are essential for an idol!」
			PRINTFORMW 「That's why, both as a human and a fairy, I think I have to stand on my own two feet.」
			PRINTFORML 「Sorry Mama, I'll really miss you, but I'll come back to play anytime!」
			PRINTW 
			PRINTFORMDW What, she's not gonna come back to visit Papa too...
			PRINTFORMDL You don't know a thing about idol power or cuteness, but at bare minimum you get that she wants to stand on her own.
			PRINTFORMDW You and Clownpiece have a long talk about letting her go find her way in the world.
		CASE 2
			PRINTFORMW 「Ummm, actually, I want to go back to Hell, where Mama used to live...」
			PRINTFORML 「I know Mama will say that it's too dangerous and painful there, but for me, it's just too peaceful and boring on the surface.」
			PRINTFORMW 「Besides, since I'm connected to Mama, Hecatia-sama will treat me well, right?」
			PRINTFORML 「That's why I want to go train in Hell, and someday I'll even surpass Mama♪」
			PRINTW 
			PRINTFORMDL To be honest, her words fill you with so much anxiety that you want to stop her.
			PRINTFORMDW But, you and Clownpiece have a long talk about letting her go find her way in the world...
		CASEELSE
			PRINTFORMW 「No, actually, I want to go traveling, and see places all around the world.」
			PRINTFORML 「Everyone in the human village learns all that they know from temple school, since they were kids.」
			PRINTFORMW 「When I saw that, I decided that fairies need to have their knowledge shared, too!」
			PRINTFORML 「So that's why, I've decided to go on a journey of enlightenment, and learn from fairies all over the world.」
			PRINTFORML 「I'm sorry, Papa, Mama, but I'll be leaving someday soon...」
			PRINTW 
			PRINTFORMDL You doubt if there's all that much to learn if your teachers are fairies...
			PRINTFORMDL But if anyone can do it, %CALLNAME:(TALENT:111:育児中)% can, and who knows? She just might discover something revolutionary.
			PRINTFORMDW Clownpiece doesn't seem to understand her motivations very well, but the two of you have a long talk about letting her follow her heart.
		ENDSELECT
	;男の子
	ELSEIF TALENT:(TALENT:111:育児中):2 == 2
		CALL M_KOJO_COLOR_K111_CHILD(2)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 11
			PRINTFORMW 「Hmmmー, of course, I'd love to stay here and protect Mama, but...」
			PRINTFORML 「I think it's not enough to just defend, you also have to attack!」
			PRINTW 
			CALL M_KOJO_COLOR_K111
			PRINTFORML 「Attack?」
			PRINTW 
			CALL M_KOJO_COLOR_K111_CHILD(2)
			PRINTFORMW 「That's right! I'm going to go on a journey to vanquish the evils that's running rampant through Gensokyo!」
			PRINTFORML 「So, once i've graduated from temple school, I'll be leaving home...」
			PRINTFORML 「Don't worry, it'll be okay, because after all Mama has Papa to protect her!」
			PRINTW 
			PRINTFORMDW %BREAKENG(@"You worry about whether %CALLNAME:(TALENT:111:育児中)% will be capable of exterminating youkai, but if that's his choice you'll have to accept it.")%
			PRINTFORMDW You and Clownpiece have a long talk about letting him go find his way in the world.
		CASE 12
			PRINTFORMW 「No, I'll be leaving home soon.」
			PRINTFORML 「I've learned about humans and fairies at temple school.」
			PRINTFORML 「That's when I realized that there's something I have to do in Gensokyo.」
			PRINTW 
			CALL M_KOJO_COLOR_K111
			PRINTFORML 「what are you planning to do?」
			PRINTW 
			CALL M_KOJO_COLOR_K111_CHILD(2)
			PRINTFORML 「...Sorry, Mama, but I can't tell you now.」
			PRINTFORMW 「But before long, I'm gonna surprise you.」
			PRINTFORML 「That's the reason why I have to leave home.」
			PRINTFORML 「You understand, don't you, Papa?」
			PRINTW 
			PRINTFORMDW He seems to have his own ideas about how to live his life, but since that's the case he should be free to pursue his dreams.
			PRINTFORMDW You and Clownpiece have a long talk about letting him go find his way in the world.
		CASEELSE
		ENDSELECT
	ENDIF
	PRINTFORMDW You'll have to cherish the time you have left with %HIM_HER_CHILD(111,,TALENT:111:育児中)%...
ENDIF

