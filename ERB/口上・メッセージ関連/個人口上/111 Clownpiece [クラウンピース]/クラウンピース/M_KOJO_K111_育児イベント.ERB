		CALL M_KOJO_COLOR_K111_CHILD(1)
		SELECTCASE CFLAG:111:(1010 + TALENT:111:育児中)
		CASE 1
			PRINTFORMW 「Mama, cuddle me!」
			PRINTFORMW 「Mama, juice, wanna drink!」
