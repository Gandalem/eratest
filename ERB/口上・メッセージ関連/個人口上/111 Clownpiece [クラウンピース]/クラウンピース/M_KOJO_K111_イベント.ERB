@M_KOJO_DAILY_EVENT_K111_12(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
;地の文を変えたければコメントアウト
;コメントアウトできるのはARG:1=1,2のみです
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG:1
		CASE 1
			;特訓を頼まれる
			;～から新技の訓練に付き合って欲しいと言われた
			PRINTFORML 「헤이 헤이, %CALLNAME:MASTER%님!」
			PRINTFORML 「와서 이 새로운 기교를 시험해 봐줘! 딱 1분밖에 안 걸릴 거야!」
		CASE 2
			;断る
			;～は残念そうだ
			PRINTFORML 「칫-! 너 이 못난 애야-!」
		CASE 3
			;～の攻撃！
			;※ここはWAITしないでください
			PRINTFORML 「좋아, 이거 먹어!!」
		CASE 4
			IF ARG:2
				;時間停止して回避
				PRINTFORML 「뭐야!? 방금 이상한 거 했어?」
			ELSE
				;回避成功
				PRINTFORML 「크윽! 제대로 하는 게 좀 어렵네!」
			ENDIF
		CASE 5
			;回避失敗
			PRINTFORML 「캬하하♪ 좋아, 아주 잘 작동하는 것 같아~!」
	ENDSELECT
ENDIF
RETURN 1
