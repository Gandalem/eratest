	PRINTFORMW 「G'niighhh～... Yaaawn...」
CASEELSE
	IF TALENT:[[クラウンピース]]:恋慕
		PRINTFORMW 「%CALLNAME:MASTER%, let's sleep togetherrr～...」
	ELSE
		PRINTFORMW 「Okay then～... Good night～...」
	ENDIF
ENDSELECT


