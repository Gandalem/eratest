@M_KOJO_EVENT_K111_ONABARE_1(ARG)
;-------------------------------------------------
SELECTCASE RAND:5
	CASE 0
		PRINTFORMW 「아... 정말 굉장하다...」
	CASE 1
		PRINTFORMW 「%CFLAG:111:1099?"Goshyujinshamaaa"#"Mashterrrr"%~... 저 구역은 출입 금지야... 흐으음...」
	CASE 2
