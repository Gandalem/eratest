@M_KOJO_EVENT_K111_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた＆TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2) && !TCVAR:111:358
		CALL M_KOJO_EVENT_K111_1_MAINMAP(ARG)
		RETURN 1
	ENDIF
;	;-------------------------------------------------
;	;TARGETが入ってきた
;	;記入チェック（=0, 非表示、1, 表示）
;	LOCAL:1 = 0
;	;-------------------------------------------------
;
;	;統合しました
;
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;恥薄いと大体入ってくる
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「Oh! It's %CALLNAME:MASTER%!」
		CALL HPH_PRINT,@"「Pfaha～BPB Let's go in together～BPB」","W"
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「Ah! It's %CALLNAME:MASTER%!」
		PRINTFORMW 「Sorry～ Didn't mean to intrude～」
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「Ah! It's %CALLNAME:MASTER%!」
		PRINTFORMW 「Fufuーn♪ It's my turn now, so you'd better finish up, %CALLNAME:MASTER%♪」
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && !TCVAR:111:358
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_EVENT_K111_1_HALLOWEEN
		;元旦（2年目以降）
		ELSEIF DAY:2 == 1 && DAY:3 == 1 && DAY != 1
			CALL M_KOJO_EVENT_K111_1_GANTAN
		;クリスマスイブ
		ELSEIF DAY:2 == 4 && DAY:3 == 24 && !TCVAR:[[クラウンピース]]:今日の贈り物
			CALL M_KOJO_EVENT_K111_1_XMAS
		ELSE
			PRINTFORML 「Oh! %CALLNAME:MASTER%!」
			IF TALENT:111:恋慕
				;月
				IF CFLAG:111:現在位置 >= 1000 && CFLAG:111:現在位置 < 1100
					;恋人
					IF TALENT:111:恋人
						PRINTFORMW 「You came to see me!?」
						CALL HPH_PRINT,@"「Yay♪ I love %CALLNAME:MASTER% so much～HPH」","W"
					ELSE
						PRINTFORMW 「What are you doing here?」
						PRINTFORMW 「Come on, since you're here let's play together!」
					ENDIF
				ELSE
					SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「What a coincidence to meet you in a place like this!」
					CASE 2
						PRINTFORMW 「Hey hey, wanna go someplace together?」
					CASE 3
						PRINTFORMW 「Are you going out by yourself? Then why don't you play with me～」
					CASE 4
						PRINTFORMW 「Hey, %CALLNAME:MASTER%～! If you're free, then why don't you play with meー?」
					CASEELSE
						PRINTFORMW 「Let's play, let's play♪」
					ENDSELECT
				ENDIF
			ELSE
				PRINTFORMW 「Hey hey, what're you doing?」
			ENDIF
			;バレンタイン
			SIF DAY:2 == 4 && DAY:3 == 14
				CALL M_KOJO_EVENT_K111_1_VALENTINE
		ENDIF
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7 && !TCVAR:111:358
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_EVENT_K111_1_HALLOWEEN
		;元旦（2年目以降）
		ELSEIF DAY:2 == 1 && DAY:3 == 1 && DAY != 1
			CALL M_KOJO_EVENT_K111_1_GANTAN
		;クリスマスイブ
		ELSEIF DAY:2 == 4 && DAY:3 == 24 && !TCVAR:[[クラウンピース]]:今日の贈り物
			CALL M_KOJO_EVENT_K111_1_XMAS
		ELSE
			PRINTFORML 「Ah! %CALLNAME:MASTER%!」
			IF TALENT:111:恋慕
				;ヘカーティアとデート
				IF FLAG:デート相手 == [[ヘカーティア]]
					PRINTFORML 「%CFLAG:111:1099?"Go-Goshujinsama"#"M-Master"%...!」
					PRINTFORMW 「Err... Umm... Is it okay if I stay here...?」
				;純狐とデート
				ELSEIF FLAG:デート相手 == [[純狐]]
					PRINTFORML 「%CFLAG:111:1099?"Yu-Yuujinsama"#"M-Mrs. Friend"%!」
					PRINTFORMW 「Err... Umm... Is it okay if I stay here?」
				;三月精orチルノとデート
				ELSEIF GROUPMATCH(FLAG:デート相手, [[サニー]], [[ルナ]], [[スター]], [[チルノ]])
					;ここはフルネーム
					PRINTFORML 「Hey, scram! %NAME:(FLAG:デート相手)%!」
					IF TALENT:[[クラウンピース]]:恋人
						PRINTFORMW 「%CALLNAME:MASTER%'s my darling! You go away, I'm not gonna shareー!」
					ELSE
						PRINTFORMW 「%CALLNAME:MASTER%'s gonna play with me right now! Get lost!」
					ENDIF
				;ラルバとデート,ちょっと仲良し
				ELSEIF FLAG:デート相手 == [[ラルバ]]
					PRINTFORMW 「Are you playing with %CALLNAME:(FLAG:デート相手)%?」
					IF TALENT:[[クラウンピース]]:恋人
						PRINTFORMW 「Just so you know, %CALLNAME:MASTER%'s my darling!」
					ELSE
						PRINTFORMW 「That looks so fun! Let me come, too!」
					ENDIF
				;妖精とデート
				ELSEIF TALENT:(FLAG:デート相手):妖精
					PRINTFORMW 「Who's that fairy? Are you two friends or something?」
					SIF TALENT:[[クラウンピース]]:恋人
						PRINTFORMW 「%CALLNAME:MASTER%'s my darling, you know!」
				;それ以外
				ELSE
					PRINTFORMW 「Grr, who's that girl you're with?」
					SIF TALENT:[[クラウンピース]]:恋人
						PRINTFORMW 「%CALLNAME:MASTER%'s my darling, you know!」
				ENDIF
			ELSE
				;ヘカーティアとデート
				IF FLAG:デート相手 == [[ヘカーティア]]
					PRINTFORML 「Geez, %CFLAG:111:1099?"Goshujinsama"#"Master"%!」
					PRINTFORMW 「What were you two doing together, anyway?」
				;純狐とデート
				ELSEIF FLAG:デート相手 == [[純狐]]
					PRINTFORML 「Geez, %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%!」
					PRINTFORMW 「What were you two doing together, anyway?」
				;三月精orチルノorラルバとデート
				ELSEIF GROUPMATCH(FLAG:デート相手, [[サニー]], [[ルナ]], [[スター]], [[チルノ]], [[ラルバ]])
					PRINTFORML 「Oh, %CALLNAME:(FLAG:デート相手)%'s here too!」
					PRINTFORMW 「What are you two doing together? Let me come tooー!」
				ELSE
					PRINTFORMW 「Hey hey, what are you doing?」
				ENDIF
			ENDIF
			;バレンタイン
			SIF DAY:2 == 4 && DAY:3 == 14
				CALL M_KOJO_EVENT_K111_1_VALENTINE
		ENDIF
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
;	;-------------------------------------------------
;	;MAIN_MAP上で一日最初の挨拶
;	;記入チェック（=0, 非表示、1, 表示）
;	LOCAL:1 = 0
;	;-------------------------------------------------
;	IF LOCAL:1 && ARG == 8
;		RETURN 1
;	ENDIF
;	;-------------------------------------------------
;	;外出先で一日最初の挨拶
;	;ARG:1にデート相手
;	;記入チェック（=0, 非表示、1, 表示）
;	LOCAL:1 = 0
;	;-------------------------------------------------
;	IF LOCAL:1 && ARG == 9
;	ENDIF
ENDIF

@M_KOJO_EVENT_K111_1_MAINMAP(ARG)
;バレンタイン機嫌補正
SIF DAY:2 == 4 && DAY:3 == 14
	TALENT:111:機嫌 = MAX(TALENT:111:機嫌, 0)
;ハロウィン
IF DAY:2 == 3 && DAY:3 == 30
	CALL M_KOJO_EVENT_K111_1_HALLOWEEN
;元旦（2年目以降）
ELSEIF DAY:2 == 1 && DAY:3 == 1 && DAY != 1
	CALL M_KOJO_EVENT_K111_1_GANTAN
;クリスマスイブ
ELSEIF DAY:2 == 4 && DAY:3 == 24 && !TCVAR:[[クラウンピース]]:今日の贈り物
	CALL M_KOJO_EVENT_K111_1_XMAS
;不機嫌
ELSEIF M_KOJO_K111_FUKIGEN([[クラウンピース]])
	PRINTFORMW 「Ah, %CALLNAME:MASTER%...」
;20日以上会ってない
ELSEIF DAY - CFLAG:111:1002 >= 20
	PRINTFORML 「Ah, %CALLNAME:MASTER%!」
	;恋人
	IF TALENT:111:恋人
		PRINTFORMW 「Wait upー! What the heck have you doing, leaving me all alone like this!」
		PRINTFORMW 「You meanie... I've really been missing you...」
	;恋慕
	ELSEIF TALENT:111:恋慕
		PRINTFORMW 「I haven't seen you around lately, so I was starting to miss you... Um, I mean, I was worried if something had happened to you!」
		PRINTFORMW 「Hey, mind if I give you a big 'ol hug...?」
	ELSE
		PRINTFORMW 「It's been a while, how've you been?」
	ENDIF
;MASTERが入ってきた or 同じ拠点
ELSEIF ARG == 2 || CFLAG:[[クラウンピース]]:神社在住
	;同じ拠点
	IF CFLAG:[[クラウンピース]]:神社在住
		SELECTCASE TIME
		;4時～10時
		CASE 240 TO 600
			SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「Ah, %CALLNAME:MASTER%, up and at 'em～」
			CASE 2
				PRINTFORML 「Good morning, %CALLNAME:MASTER%!」
			CASEELSE
				PRINTFORML 「Ah, %CALLNAME:MASTER%, g'morning♪」
			ENDSELECT
		;10時～18時
		CASE 601 TO 1080
			;遅起き（4時～10時以外）,迷ったけど10時は許す！
			IF !INRANGE(TIME:3, 240, 600)
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Good morning～ %CALLNAME:MASTER%, even though it's already noon～」
				CASE 2
					PRINTFORML 「Good morning, you sleepyheadー!」
				CASEELSE
					PRINTFORML 「Ah, %CALLNAME:MASTER%ー! Just how long do you sleep for, anyway～?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Ah, %CALLNAME:MASTER%, %M_KOJO_EVENT_K111_1_HELLO()%!」
				CASE 2
					PRINTFORML 「%M_KOJO_EVENT_K111_1_HELLO()%, %CALLNAME:MASTER%!」
				CASEELSE
					PRINTFORML 「Ah, %CALLNAME:MASTER%, good afternoon♪」
				ENDSELECT
			ENDIF
		;18時～
		CASEELSE
			;夜型？（4時～18時以外）
			IF !INRANGE(TIME:3, 240, 1080)
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Good morning, %CALLNAME:MASTER%～! Even though it's already nighttime～」
				CASE 2
					PRINTFORML 「Good morning, super sleepyhead!」
				CASEELSE
					PRINTFORML 「Ah, %CALLNAME:MASTER%ー, you sleep too muchー...」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Ah, %CALLNAME:MASTER%, %M_KOJO_EVENT_K111_1_HELLO()%!」
				CASE 2
					PRINTFORML 「%M_KOJO_EVENT_K111_1_HELLO()%, %CALLNAME:MASTER%!」
				CASEELSE
					PRINTFORML 「Ah, %CALLNAME:MASTER%, good evening～♪」
				ENDSELECT
			ENDIF
		ENDSELECT
	;来訪
	ELSE
		PRINTFORML 「Ah, %CALLNAME:MASTER%!」
	ENDIF
	;▲ここまで挨拶
	;まれにこける
	IF !RAND:200
		PRINTFORML 「Owwie!!」
		PRINTL 
		PRINTFORMDW As Clownpiece runs over to you she makes a magnificently dramatic show of falling over.
	;溜まってるとたまに
	ELSEIF TALENT:[[クラウンピース]]:恋慕 && CFLAG:111:溜まってる度 >= 750 && !RAND:5
		CALL HPH_PRINT,@"「Heyy～ %CALLNAME:MASTER%～ Let's do that kind of play～HPH」","W"
		PRINTL 
		PRINTFORMDW Clownpiece clings to you like a spoiled child.
	ELSE
		SELECTCASE RAND:12
		CASE 1
			PRINTFORMW 「Oh? You've got some rice stuck to your cheek!」
		CASE 2
			PRINTFORMW 「I wonder what games we should play today～」
		CASE 3
			PRINTFORMW 「Are you free right now? Hey, are you free??」
		CASE 4
			PRINTFORMW 「I was just thinking about playing with youー!」
		CASE 5
			PRINTFORMW 「Hey! Hey! Wanna go play together～?」
		CASE 6
