@M_KOJO_UPDATE_K111
#DIM VERSION
;口上独自のUPDATE用
;ENCOUNTER専用に独自分岐フラグを仕込んだ場合等にどうぞ
;UPDATE判定でCFLAGを使う場合、キャラ番号の指定が必要になります
VERSION = 202
CALL M_KOJO_COLOR_K111
IF !TALENT:111:キス未経験 || EXP:111:キス経験
	SIF FIRSTTIME("ファーストキス", 0, 111)
		PRINTFORML 클라운피스는 이 데이터에서 키스 경험이 있다.
ENDIF
IF EXP:111:精飲経験
	SIF FIRSTTIME("精液の味", 0, 111)
		PRINTFORML 클라운피스는 이 데이터에서 정액의 맛을 알고 있다.
ENDIF
RESETCOLOR
IF CFLAG:111:1100 == VERSION
	CALL M_KOJO_COLOR_K111
	PRINTFORML 이미 최신 버전이다 (버전.{CFLAG:111:1100 / 100}.{CFLAG:111:1100 % 100})
	RESETCOLOR
ELSE
	CFLAG:111:1100 = VERSION
	CALL M_KOJO_COLOR_K111
	PRINTFORML 업데이트 완료! (버전.{CFLAG:111:1100 / 100}.{CFLAG:111:1100 % 100})
	RESETCOLOR
ENDIF
SIF !CFLAG:111:1002
	CFLAG:111:1002 = DAY
;FIRSTTIME"お招き"は施しようがないので省略　そこまで重要ではないし
RETURN 1
