				CASE 1
					CALL HPH_PRINT,@"「내 광기에 그냥 몸을 맡겨 봐... HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「서로 하나가 되자 HPH」","L"
				CASEELSE
					CALL HPH_PRINT,@"「함께 지옥으로 떨어지자 HPH」","L"
			ENDSELECT
		ELSE
			CALL HPH_PRINT,@"「지옥HPH에 떨어지는 게 어떤 건지 보여주마」","L"
		ENDIF
