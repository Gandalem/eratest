	CASE 2
		RETURNF "Yahho～"
	CASE 3
		RETURNF "Heyaー"
	CASE 4
		RETURNF "Heya～"
	CASE 5
		RETURNF "Hiー"
	CASEELSE
		RETURNF "Hi～"
ENDSELECT
