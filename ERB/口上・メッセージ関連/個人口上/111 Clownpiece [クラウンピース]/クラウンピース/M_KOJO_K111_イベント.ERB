@M_KOJO_EVENT_K111_1_XMAS
PRINTFORMW 「메리～ ☆ 크리스마스～!!」
PRINTFORML 「서둘러, 산타 %CALLNAME:MASTER%♪ 뭘 해야 하는지 알잖아, 그렇지?」
PRINTDL [ 1] 그녀에게 선물을 주어라
PRINTDL [ 0] 그녀에게 선물을 요구해라
INPUT
IF RESULT
	RESETCOLOR
	PRINTFORMW 클라운피스를 위한 맞춤 선물을 만들어라!
	CALL GIFT_ORDER_MADE_FROM_MASTER_TR([[クラウンピース]])
	CALL M_KOJO_COLOR_K111
	;あげるのをやめた
	IF RESULT == -1
		PRINTFORMW 「응...?」
		PRINTFORMW 「뭐야, 도대체?! 다음엔 좀 더 배려해라! 흥!」
		TALENT:[[クラウンピース]]:機嫌 = -1
		;あげた
	ELSE
		PRINTL 
		PRINTFORMDL 당신은 Clownpiece에게 %RESULTS%을 준다.
		PRINTW 
		IF RESULT:1 >= 700
			PRINTFORML 「꺄아~♪ 정말 이걸 하나 얻다니!? 굉장해~!!」
			CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 고마워! 정말 좋아해」","W"
			TALENT:[[クラウンピース]]:機嫌 = 1
		ELSEIF RESULT:1 >= 400
			PRINTFORML 「오옷~♪ 멋지다~!」
			PRINTFORMW 「%CALLNAME:MASTER%, 고마워!」
			TALENT:[[クラウンピース]]:機嫌 = 1
		ELSE
			PRINTFORML 「으음―...!」
			PRINTFORMW 「좋아―…… 응, 나, 음, 정말 좋아…… 고마워―……」
			TALENT:[[クラウンピース]]:機嫌 = 0
		ENDIF
	ENDIF
ELSE
	IF TALENT:[[クラウンピース]]:恋慕 || TALENT:[[クラウンピース]]:恋人
		PRINTFORML 「응? 내가 선물 주는 사람이 될 리가 없잖아—!」
		PRINTFORMW 「에이, 나 정말 정말 선물 받고 싶었단 말이야!」
		;後日くれる
		CFLAG:[[クラウンピース]]:1006 = DAY
	ELSE
		PRINTFORML 「음? 내가 선물을 주는 쪽이라니?」
		PRINTFORMW 「뭐, 이렇게 될지도 모른다고 생각했거든~」
	ENDIF
	TALENT:[[クラウンピース]]:機嫌 = 0
ENDIF
;バレンタイン挨拶（通常挨拶後に追加）

@M_KOJO_EVENT_K111_1_VALENTINE
PRINTFORML 「아, 맞다!」
SELECTCASE CFLAG:[[クラウンピース]]:好感度
	CASE 1000 TO 3000
		;ブラックサンダー
		PRINTFORMW 「자, 이걸 받아!」
	CASE 3001 TO 5000
		;チョコレート
		PRINTFORMW 「여기, 이건 너를 위한 거야, 초콜릿이야!」
	CASE IS > 5000
		IF EXP:111:愛情経験 < 100
			;高級チョコ
			PRINTFORMW 「여기, 이건 당신을 위한 거야, 해피 발렌타인!」
		ELSE
			;手作りチョコ
			PRINTFORMW 「여기, 이거 당신을 위한 거예요! %CFLAG:111:1099?"Goshujinsama"#"Master"%께서 만드는 것을 도와주셨어요!」
			PRINTFORMW 「행복한 발렌타인 데이☆」
		ENDIF
ENDSELECT
;機嫌補正
TALENT:111:機嫌 = MAX(TALENT:111:機嫌, 0)
;挨拶口上終了処理
;口上が表示されなくても処理されます

@M_KOJO_EVENT_K111_1_END(ARG)
;最後に会った日
CFLAG:111:1002 = DAY
;一日一回
TCVAR:111:358 = 1
;最初から不機嫌かどうか
SIF TALENT:[[クラウンピース]]:機嫌 < 0
	TCVAR:[[クラウンピース]]:360 = 1
;ここから先は通常遭遇および単独外出先遭遇のみ
SIF !GROUPMATCH(ARG, 1, 2, 6)
	RETURN 1
;恋慕で、不機嫌ではなく、デート中ではなく、欲求不満が75%以上
IF TALENT:111:恋慕 && TALENT:111:機嫌 >= 0 && !FLAG:デート相手 && CFLAG:111:溜まってる度 >= 750
	PRINTL 
	PRINTFORMDL 클라운피스의 뺨이 붉어지고 그녀는 사랑스럽게 몸을 꿈틀거린다...
	PRINTW 
	SELECTCASE RAND:6
		CASE 1
			CALL HPH_PRINT,@"「아-아니에요! 그게 아니라, 음... 나 화장실 좀 가야 해... BPB」","W"
		CASE 2
			PRINTFORMW 「F-됐어! 나 그냥 생각하고 있었어 "와 오늘 덥네"!」
		CASE 3
			CALL HPH_PRINT,@"「아무튼, 음, 데이트하러 가자! 데이트 HPH 데이트 HPH」","W"
		CASE 4
			PRINTFORMW 「어떻게인지 심장이 두근거렸다 \@ CFLAG:[[クラウンピース]]:神社在住 ? 너를 봤을 때 # 너를 우연히 만났을 때 \@, %CALLNAME:MASTER%...」
		CASE 5
			PRINTFORMW 「음~... %CALLNAME:MASTER%님~ 좀 외로운걸요~...」
		CASEELSE
			PRINTFORMW 「후우~ 아무래도 오늘은 몸이 뭔가 짜릿하네~...」
	ENDSELECT
ENDIF
RETURN 1
;やっほーパターン

@M_KOJO_EVENT_K111_1_HELLO
