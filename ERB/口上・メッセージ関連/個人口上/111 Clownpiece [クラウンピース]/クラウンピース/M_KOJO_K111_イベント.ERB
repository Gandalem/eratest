;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K111_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた＆TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2) && !TCVAR:111:358
		CALL M_KOJO_EVENT_K111_1_MAINMAP(ARG)
		RETURN 1
	ENDIF
	;	;-------------------------------------------------
	;	;TARGETが入ってきた
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;
	;	;統合しました
	;
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;恥薄いと大体入ってくる
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「Oh! It's %CALLNAME:MASTER%!」
		CALL HPH_PRINT,@"「파하~ BPB 같이 들어가자~ BPB」","W"
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「Ah! It's %CALLNAME:MASTER%!」
		PRINTFORMW 「죄송해요~ 방해할 의도는 아니었어요~」
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「Ah! It's %CALLNAME:MASTER%!」
		PRINTFORMW 「후후~♪ 이제 내 차례니까 얼른 끝내는 게 좋을 거야, %CALLNAME:MASTER%♪」
		CALL M_KOJO_EVENT_K111_1_END(ARG)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && !TCVAR:111:358
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_EVENT_K111_1_HALLOWEEN
			;元旦（2年目以降）
		ELSEIF DAY:2 == 1 && DAY:3 == 1 && DAY != 1
			CALL M_KOJO_EVENT_K111_1_GANTAN
			;クリスマスイブ
		ELSEIF DAY:2 == 4 && DAY:3 == 24 && !TCVAR:[[クラウンピース]]:今日の贈り物
			CALL M_KOJO_EVENT_K111_1_XMAS
		ELSE
			PRINTFORML 「Oh! %CALLNAME:MASTER%!」
			IF TALENT:111:恋慕
				;月
				IF CFLAG:111:現在位置 >= 1000 && CFLAG:111:現在位置 < 1100
					;恋人
					IF TALENT:111:恋人
						PRINTFORMW 「나를 보러 왔어!?」
						CALL HPH_PRINT,@"「야호♪ 나는 %조사처리(CALLNAME:MASTER,"를")% 정말 많이 연모해~HPH」","W"
					ELSE
						PRINTFORMW 「여기에 뭐 하는 거야?」
						PRINTFORMW 「자, 왔으니 같이 놀자!」
					ENDIF
				ELSE
					SELECTCASE RAND:5
						CASE 1
							PRINTFORMW 「이런 곳에서 만나다니, 정말 우연이네요!」
