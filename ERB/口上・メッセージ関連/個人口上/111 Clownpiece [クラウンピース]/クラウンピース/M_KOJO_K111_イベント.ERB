	;MASTERがダウン（恋慕のみ,そのまま一日が終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW 「Oh geeze, are you okay, %CALLNAME:MASTER%?」
		IF BASE:MASTER:酒気 >= MAXBASE:MASTER:酒気
			PRINTFORML 「I'm surprised %CALLNAME:MASTER%, you're really weak to alcohol～♪」
			PRINTFORMW 「...No, that's not what I should be worrying about, umm... I guess should probably get %HIM_HER(MASTER)% to bed?」
		ELSE
			IF ARG:1
				;自室でダウン,（～が【MASTER】をベッド（布団）へと運んでくれた…）
				PRINTFORML 「Maybe you overdid it a little～♪」
				PRINTFORMW 「...No, that's not what I should be worrying about, umm... I guess should probably get %HIM_HER(MASTER)% to bed?」
			ELSE
				;部屋まで運ばれる,（～が【MASTER】を私室へと運んでくれた…）
				PRINTFORML 「Hmm, what should I do...」
				PRINTFORMW 「Should I carry %CALLNAME:MASTER% to %HIS_HER(MASTER)% room?」
			ENDIF
		ENDIF
		PRINTFORMW 「Heave ho! ...S-So heavyー!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た（【TARGET】が部屋に戻ってきた→寝間着へと着替え、寝床に潜った）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「Ah, %CALLNAME:MASTER%... I'm gonna go to bed～」
			CASE 2
				PRINTFORMW 「Ah, %CALLNAME:MASTER%... I'll head to bed first, I guess～...」
			CASEELSE
				PRINTFORMW 「Ah, %CALLNAME:MASTER%... Shorry, but I'm already too shleepy～」
			ENDSELECT
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出して寝た（眠そうな【TARGET】に追い出された…）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF CFLAG:[[クラウンピース]]:前ターン位置 == CFLAG:[[クラウンピース]]:現在位置
				;前のターンまで一緒に部屋にいた
				PRINTFORMW 「Yaaaaawn～... I'm gonna go to sleep now, so you need to get outta my room...」
			ELSE
				;寝るために部屋に帰ってきたところ
				PRINTFORMW 「Guh, %CALLNAME:MASTER%... What the heck are you doing in my room, anyway～?」
				PRINTFORMW 「I'm gonna go to sleep, so you need to get out...」
			ENDIF
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た（【TARGET】が部屋に戻ってきた→唇をとがらせる【TARGET】に、【MASTER】は渋々【Ｈの相手】から離れた）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			;寝ぼけてるということにしておく
			PRINTFORMW 「Huh? %CALLNAME:MASTER%... What the heck are you doing in my room...?」
			PRINTFORMW 「Well, whatever, I guess it's fine... I'm gonna go to sleep now～」
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;来訪キャラが拠点で休憩（～は疲れ切っている→ちょっと休んでいきなよ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 「Yaaaaawn～... Sorry, %CALLNAME:MASTER%, and thanks～...」
		PRINTFORMW 「Good night～...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝室に居る状態でその場で寝る（～は眠気に負け、眠りについた…）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF CFLAG:うふふ
			;うふふ中に寝る
			PRINTFORMW 「Nnnmyuu～...」
			PRINTFORMW 「Sorry %CALLNAME:MASTER%, but I'm really sleepy... Yawn...」
			PRINTL 
			PRINTFORMDW There's no helping it, so you cover up Clownpiece with her blanken as she drifts off to sleep.
		ELSE
			SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「Yaaaaawn～... Sho shleepy～...」
			CASE 2
				PRINTFORMW 「Yaaaaawn～... I'm feeling reeeally sleepy...」
			CASE 3
				PRINTFORMW 「Yaaaaawn～... I got really worn out today...」
			CASE 4
				PRINTFORMW 「Yaaaaawn～... Gonna go to shleeeep～... Count my sheepies～...」
			CASEELSE
				PRINTFORMW 「What should we do... Next... Yaaaawn...」
				PRINTFORMDL You tell Clownpiece that it's probably time for her to go to sleep.
				PRINTFORML 「Yaaaawnn～...」
			ENDSELECT
			PRINTFORMW 「Good night %CALLNAME:MASTER%, see you tomorrow～...」
			SIF TALENT:[[クラウンピース]]:恋慕
				PRINTFORMW 「...Or can you stay here tonight...?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		SELECTCASE RAND:3
		CASE 1
			PRINTFORMW 「Yaaaaawn～... I think I'm starting to get sleepy.」
		CASE 2
			PRINTFORMW 「Yaaaawnn～... Let's hurry up and get into bed～」
		CASEELSE
			PRINTFORMW 「Yaaaawnn～... I got so tired that I can hardly stand up straight～」
		ENDSELECT
		PRINTFORMW 「Okay then～... Good night～...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;クラウンピースのおやすみセット（拠点用）
@M_KOJO_EVENT_K111_3_OYASUMI
SELECTCASE RAND:4
