;==================================================
;デイリーイベント12,特訓
;信頼100以上で発生（拠点キャラのみ）
;==================================================
@M_KOJO_DAILY_EVENT_K111_12(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
;地の文を変えたければコメントアウト
;コメントアウトできるのはARG:1=1,2のみです
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG:1
	CASE 1
		;特訓を頼まれる
		;～から新技の訓練に付き合って欲しいと言われた
		PRINTFORML 「Hey hey, %CALLNAME:MASTER%!」
		PRINTFORML 「Come on and help me try out this new technique! It'll only take a minute!」
	CASE 2
		;断る
		;～は残念そうだ
		PRINTFORML 「Tchー! You meanieー!」
	CASE 3
		;～の攻撃！
		;※ここはWAITしないでください
		PRINTFORML 「Okay, eat this!!」
	CASE 4
		IF ARG:2
			;時間停止して回避
			PRINTFORML 「Whahuh!? Did you do something weird just now?」
		ELSE
			;回避成功
			PRINTFORML 「Guh! I guess it's a bit hard to do it right!」
		ENDIF
	CASE 5
		;回避失敗
		PRINTFORML 「Kyahaha♪ Okay, looks like it works pretty good～!」
	ENDSELECT
ENDIF
RETURN 1

