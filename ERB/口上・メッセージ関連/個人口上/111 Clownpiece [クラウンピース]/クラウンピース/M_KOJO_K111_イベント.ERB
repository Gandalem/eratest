@M_KOJO_EVENT_K111_5(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;純狐が入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[純狐]]
		PRINTFORMW 「Ah! %CFLAG:111:1099?"Yuujinsama"#"Mrs. Friend"%!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ヘカーティアが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[ヘカーティア]]
		PRINTFORMW 「Ah! %CFLAG:111:1099?"Goshujinsama"#"Master"%!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;三月精orチルノが入ってきた,ラルバに対しては言わない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, [[サニー]], [[ルナ]], [[スター]], [[チルノ]])
		PRINTFORML 「이봐, 꺼져! %NAME:(FLAG:デート相手)%!」
		IF TALENT:[[クラウンピース]]:恋人
			PRINTFORMW 「지금 내 연인이랑 놀고 있잖아~!」
		ELSE
			PRINTFORMW 「나 지금 %조사처리(CALLNAME:MASTER,"랑")% 놀고 있어ー!」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ラルバが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == [[ラルバ]]
		PRINTFORMW 「오, 라바가군요, %M_KOJO_EVENT_K111_1_HELLO()%!」
		RETURN 1
	ENDIF
	;その他
	PRINTFORML 「뭐야? %CALLNAME:MASTER%, 왜 떠나려고?」
ENDIF
RETURN 1
