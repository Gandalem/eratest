@M_KOJO_SPEVENT_MESSAGECHECK_K111_1
RETURN 1

@M_KOJO_SPEVENT_K111_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTL 
	PRINTFORMDL 두 사람이 데이트를 마치고 집으로 걸어갈 때, 클라운피스가 무슨 이유에서인지 천천히 손전등을 꺼내는 것을 알아차린다.
	PRINTW 
	PRINTFORMW 「헤이 헤이, 내가 진짜 내 힘을 너한테 사용하면 무슨 일이 일어날지 보고 싶어, %CALLNAME:MASTER%?」
	PRINTFORML 「좋아, 해보자ー...」
	PRINTL 
	PRINTFORMDW 그 말이 그녀의 입에서 나오는 순간, 클라운피스는 손전등을 높이 치켜들고 빛을 터뜨린다.
	PRINTFORMDW 당신은 본능적으로 눈을 꼭 감고 얼굴을 가리며, 미친 듯한 빛으로부터 자신을 보호하려 한다...
	PRINTL 
	PRINTL 
	FORCEWAIT
	SETCOLOR 255, 100, 255
	CALL HPH_PRINT,@"...츄ㅎㅍ","W"
	CALL M_KOJO_COLOR_K111
	PRINTL 
	CALL HPH_PRINT,@"「파하하~ 내가 잡았어- HPH」","W"
	IF FIRSTTIME("ファーストキス")
		;custom code
		CALL MUTUAL_KISS(TARGET, 1, 0)
		PRINTFORMW 「어때, 응? 내 첫 키스 계획 완벽했지, 안 그래♪」
		IF TALENT:111:恋慕
			PRINTFORMW 「왜냐면, 그러니까, 나 완전히~ 너 속였어, 그리고 음...」
			CALL HPH_PRINT,@"「게다가 네가 그걸 받아준 사람이었다는 것도 좀 좋았어, 있잖아HPH.」","W"
			CSTR:111:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, on the way home from the date at %DATENAME_PLACE()%, she mischievously gave her first kiss to her beloved %CALLNAME:MASTER%.
		ELSEIF TALENT:111:思慕
			PRINTFORMW 「왜냐면, 그러니까, 나 완전히~ 너 속였어, 그리고 음...」
			CALL HPH_PRINT,@"「게다가 그건 당신과였으니까, %CALLNAME:MASTER%, 알잖아HPH」","W"
			CSTR:111:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, on the way home from the date at %DATENAME_PLACE()%, she mischievously gave her first kiss to her best bud %CALLNAME:MASTER%.
		ELSE
			PRINTFORML 「당신은 사랑과 그런 것들로 가득 차 있으니까 말이야, %조사처리(CALLNAME:MASTER,"에게")%!」
			PRINTFORMW 「언제 또 일어날지 누가 알겠어~?」
			CSTR:111:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%, on the way home from the date at %DATENAME_PLACE()%, she gave %CALLNAME:MASTER% her first kiss as a prank.
		ENDIF
	ELSE
		PRINTFORML 「당신은 사랑과 그런 것들로 가득 차 있으니까 말이야, %조사처리(CALLNAME:MASTER,"에게")%!」
		PRINTFORMW 「언제 또 일어날지 누가 알겠어~?」
	ENDIF
	PRINTFORMW 「캬하하하~ ♪ 조만간 또 나가자!」
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K111_2
RETURN 1

@M_KOJO_SPEVENT_K111_2(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME("告白")
			PRINTL 
			PRINTFORMDL 데이트 후 집으로 돌아오는 길에 클라운피스는 평소와 달리 기운 없이 터벅터벅 걸었다.
			PRINTW 
			PRINTFORMW 「음, 저기 %CALLNAME:MASTER%, 있잖아요...」
			PRINTFORMDW 클라운피스는 걸음을 멈추고 당신에게 이전에 본 적 없는 망설임으로 말을 건다.
			PRINTFORMW 「이걸 꺼내기에 지금이 맞을지 모르겠지만...」
			PRINTFORMW 「음... 있잖아요! %CALLNAME:MASTER%!」
			PRINTFORML 「사랑해요, %CALLNAME:MASTER%!!」
			PRINTL 
			FORCEWAIT
			PRINTFORMW 「음, 나는 항상 당신과 잘 지냈는데, 최근에 뭔가 달라졌어!」
			PRINTFORMW 「랄까, 더 큰 연모라고 할 수 있지... 아니면 내가 거부할 수 없는 연모일지도 모르지...」
			PRINTFORMW 「응! 나 %조사처리(CALLNAME:MASTER,"를")% 정말로 사랑하게 됐어!」
			PRINTFORMW 「정말 이걸 속으로만 담아두고 싶지 않았어... 오랫동안 당신에게 말하고 싶었거든...」
			PRINTFORMW 「야, %CALLNAME:MASTER%, 나도... 나 좋아해 주니...?」
			PRINTL 
			;以降
		ELSE
			PRINTL 
			PRINTFORMDL 데이트를 마치고 집으로 돌아오는 길에, 클라운피스는 잠시 멈춰 당신을 탐색하듯 바라본 후 입을 연다...
			PRINTW 
			PRINTFORMW 「헤이, %CALLNAME:MASTER%...」
			PRINTFORMW 「너는 음... 아직 누구랑 사귀고 있지 않지, 맞지...?」
			PRINTL 
			PRINTFORMDL 당신 마음속의 흔들리는 불확실함에 놀라, 말문이 막힌 채 그저 서 있었다.
			PRINTFORMDL 당신의 망설임을 감지한 클라운피스는 먼저 입을 열며 주도권을 잡았다.
			PRINTW 
			PRINTFORMW 「나-나는 항상 좋아했어, %CALLNAME:MASTER%, 그때부터!」
			PRINTFORMW 「그래서, 그게 말이야... 네가 답을 준다면, 나는...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;初めての返答（お断りしてない）
		IF FIRSTTIME("返答")
			PRINTFORMW 「정말!?」
			PRINTFORMW 「나에게도 반했어, %CALLNAME:MASTER%!?」
		ELSE
			PRINTFORMW 「정말!?」
			PRINTFORMW 「%CALLNAME:MASTER%도 나를 좋아하게 된 거야!?」
		ENDIF
		PRINTFORMW 「키하아~ 정말 행복해~!!」
		PRINTL 
		PRINTFORMDL 그녀의 기쁨을 참지 못한 클라운피스는 얼굴 전체에 미소를 띠고 뛰어다녔다.
		PRINTFORMDL 넘치는 에너지를 발산하며, 그녀는 흥분해서 당신에게 달려들었다...
		PRINTFORMDL 당신은 양손으로 그녀를 받아내며 날아오는 태클을 막고 포옹으로 바꾸었다.
		PRINTFORMDL 클라운피스는 간절하게 그것을 되돌려주며 당신의 가슴에 얼굴을 묻고 볼을 앞뒤로 비볐다.
		PRINTW 
		CALL HPH_PRINT,@"「흐으으-하프 사랑해 %CALLNAME:MASTER%~하프 하하호호~♪」","W"
		PRINTFORMW 「저기, 이대로 조금 더 있어도 괜찮을까...?」
		PRINTL 
		;雪
		IF GROUPMATCH(天候, 8, 9, 10, 11, 12, 13)
			PRINTFORMDW 두 사람은 서로의 체온을 나누며 긴 순간 동안 함께 포옹한다--
			;雨
		ELSEIF GROUPMATCH(天候, 4, 5, 6, 7)
			PRINTFORMDW 두 사람은 서로를 끌어안고 비 소리를 들으며 긴 순간을 함께 보냈다--
			;早朝～昼
		ELSEIF INRANGE(TIME, 240, 899)
			PRINTFORMDL 두 사람은 서로의 행복을 만끽하며 긴 순간을 함께 보냈다.
			PRINTFORMDW 마치 당신들의 결합을 축복하듯, 태양은 둘만을 위한 하나의 그림자만을 드리웠다――
			;地の文に合わせるために勝手に天気を変える,まぁ変わるのほぼ曇りだけなんで
			天候 = 0
			;夕方
		ELSEIF INRANGE(TIME, 900, 1140)
			PRINTFORMDL 지는 태양에 길게 드리워진 너의 두 그림자가
			PRINTFORMDW 서로의 행복을 나누듯 하나로 합쳐진다――
			天候 = 0
			;夜
		ELSE
			PRINTFORMDL 두 사람은 서로의 행복을 나누며 긴 순간을 함께 보냈다...
			PRINTFORMDW 고요한 달빛 아래, 너희는 하나로 하나가 된다--
			天候 = 0
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;初めてのお断り
		IF FIRSTTIME("返答")
			PRINTFORMW 「알겠어... 음, 괜찮아...」
			PRINTFORMW 「적어도 내 감정을 솔직하게 표현할 수 있었으니까...」
			PRINTFORMW 「내 마음을 %조사처리(CALLNAME:MASTER,"에게")% 말할 수 있었잖아, 그러니까 가슴에 짐을 내려놓은 기분이야...」
			PRINTL 
			PRINTFORMDL 클라운피스는 눈이 울음으로 가득 차는 것을 막으려는 듯 계속 눈을 비빈다.
			PRINTFORMDL 그녀는 고개를 저으며 깊게 숨을 들이마시고 마음을 다잡는다.
			PRINTW 
			PRINTFORMW 「우-음 그건 안타깝네! 있잖아, 울지 않을 수가 없을 정도로 충격이야... 하지만...」
			PRINTFORMW 「하지만 동시에 기분 전환이 된 것 같아!」
			PRINTFORMW 「게다가, 아직 사랑하는 사람이 아무도 없잖아, 맞지 %CALLNAME:MASTER%?」
			PRINTFORMW 「그럼 내가 %조사처리(CALLNAME:MASTER,"가")% 나를 좋아할 때까지 계속 최선을 다할게!」
			PRINTFORMW 「그러니까 우리 앞으로도 많이 같이 놀자, 응!」
			;お断り二回目以降
		ELSE
			PRINTFORMW 「알겠어... 음, 괜찮아...」
			PRINTFORMW 「하지만 너 자신을 확신하지 못하고 있는 거잖아? 그렇다면 난 포기 안 할 거야!」
			PRINTFORMW 「%CALLNAME:MASTER%, 네가 계속 나와 함께 놀고 싶다면, 언젠가는 마음이 돌아올 거라고 믿을게!」
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
