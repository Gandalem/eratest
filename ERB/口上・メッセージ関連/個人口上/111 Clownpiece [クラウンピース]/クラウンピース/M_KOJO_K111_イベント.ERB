	PRINTFORMDW As soon as those words leave her mouth, Clownpiece hoists her torch high in the air and lets its light blaze forth.
	PRINTFORMDW You instinctually shut your eyes tight and cover your face, trying to protect yourself from the maddening light...
	PRINTL 
	PRINTL 
	FORCEWAIT
	SETCOLOR 255, 100, 255
	CALL HPH_PRINT,@"...ChuHPH","W"
	CALL M_KOJO_COLOR_K111
	PRINTL 
	CALL HPH_PRINT,@"「Pahaha～ I got youーHPH」","W"
	IF FIRSTTIME("ファーストキス")
		;custom code
		CALL MUTUAL_KISS(TARGET, 1, 0)
		PRINTFORMW 「What didja think, huh? Huh? My first kiss plan was perfect, wasn't it♪」
		IF TALENT:111:恋慕
			PRINTFORMW 「'Cuz, I mean, I totally～ tricked you, and, um...」
