		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			IF TALENT:[[クラウンピース]]:恋人
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「푸하하하, 오늘 나한테 사랑을 많이 주었네♪」
						CALL HPH_PRINT,@"「하지만 당신도 알잖아요 %CALLNAME:MASTER%, 저도 정말 많이 사랑해요 HPH」","W"
					CASE 2
