					ELSEIF CFLAG:111:生理周期 == 7 && !TALENT:111:妊娠 && CFLAG:111:生解禁 == 2
						PRINTFORML 「도망쳐... 말도 안 돼...」
						PRINTFORMW 「이 정도로는 턱없이 부족해!」
						;無限に催促
					ELSE
						SELECTCASE RAND:5
							CASE 0
								PRINTFORML 「도망쳐... 안 돼...」
								PRINTFORMW 「%CALLNAME:MASTER%너 정말 돈 밝히는 인간이구나! 못된 사람이네!」
							CASE 1
								PRINTFORML 「도망쳐... 벌써 끝이야～?」
								PRINTFORMW 「하지만 더 놀고 싶단 말이야~~!」
							CASE 2
								PRINTFORML 「후우... 끝난 거야...?」
								PRINTFORMW 「말도 안 돼! 난 더 재밌게 놀 거야—!」
							CASE 3
								PRINTFORML 「도망쳐... 하지만 왜~!」
								PRINTFORMW 「%CALLNAME:MASTER%, 마음에 들지 않았어...? 흐윽...」
							CASEELSE
								PRINTFORML 「도망쳐... 말도 안 돼...」
								PRINTFORMW 「하지만 우리는 아직 끝나지도 않았잖아ー!」
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「안 돼... 말도 안 돼...」
					PRINTFORMW 「이대로는 안 돼, 그걸로 만족할 수는 없어ー!」
				ENDIF
				;		CASE 1
				;		;抱き着きモード満足終了
				;			RETURN 1
				;		CASE 2
				;		;抱き着きモード強制終了
				;			RETURN 1
		ENDSELECT
		TCVAR:111:351 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
				;好きにして状態から抜け出せなかった
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「이길 방법이 없을 때는 싸우려고 애쓰지 않는 게 나을 거야, 그렇지?」
						CALL HPH_PRINT,@"「긴장 풀지 않으면 봐주기 힘들 거야... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「캬하하하헵」","L"
						CALL HPH_PRINT,@"「진심으로 %CALLNAME:MASTER%, 그거 정말 귀여운 응답이야, 알잖아HPH」","W"
					CASEELSE
						PRINTFORML 「이제 이제, %CALLNAME:MASTER%, 당신은 지금 나의 장난감이니까 그런 질문을 하는 건 소용없어~」
						PRINTFORMW 「장난감은 그냥 뒤에 앉아서 가지고 놀아주는 동안 귀여운 소리를 내야지!」
				ENDSELECT
				RETURN 1
			CASE 2
				;欲求不満が高くて抜け出せなかった
				SELECTCASE RAND:5
					CASE 0
						CALL HPH_PRINT,@"「아니야~ 이제 멈출 수 없어 HPH 아직 더 많은 것이 남아있어♪」","W"
					CASE 1
						PRINTFORML 「야, 그만 애쓰지 마!」
						CALL HPH_PRINT,@"「진정하고 나에게 좀 더 열렬하게 봉사해줘HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「소용없어~♪ %CALLNAME:MASTER%, 네 몸은 지금 내 장난감이야HPH」","W"
					CASE 3
						CALL HPH_PRINT,@"「캬하하하헵」","L"
						CALL HPH_PRINT,@"「미안해 %CALLNAME:MASTER%♪ 하지만 나는 당신의 슈퍼~ 귀여운 반응들을 연모해 HPH」","W"
					CASEELSE
						PRINTFORMW 「아! 잠깐 잠시만! 안 돼, 멈추지 마! 더 하자!」
				ENDSELECT
				RETURN 1
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;誘ってきた（人目につかない場所に行きたがるやつ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		SELECTCASE ARG:1
			CASE IS < 600
				PRINTFORML 「헤이, %CALLNAME:MASTER%... 우리 둘만 방에 갈까...♪」
			CASE IS < 800
				PRINTFORML 「헤이, %CALLNAME:MASTER%... 있잖아, 지금 내 심장이 정말 두근거려...♪」
			CASEELSE
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%... 더는 견딜 수가 없어...HPH」","L"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
