				CASEELSE
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 장난기 넘치는 액체가 흘러나오고 있다」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;愛液が垂れてきた
