@M_KOJO_EVENT_K111_2(ARG,ARG:1)
#DIM 分岐
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2)
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTL 
			PRINTFORMW 「좋은 아침! 잘 잤어?」
			分岐 = RAND:10
			IF GROUPMATCH(分岐, 1, 2, 3) || TALENT:111:機嫌 == 1 || CFLAG:111:1001 == DAY - 1
				;				;昨晩満足,ズレ修正したけどまだ懸念アリ
				IF CFLAG:111:1001 == DAY - 1
					CALL HPH_PRINT,@"「에헤~ 어제 정말 많은 연모를 받았어♪」","L"
					PRINTFORMW 「오늘은 더 음란한 짓을 하자♪」
					TALENT:111:機嫌 = 1
				ELSE
					PRINTFORMW 「파하하♪ %조사처리(CALLNAME:MASTER,"의")% 잠든 얼굴가 웃기다♪」
				ENDIF
			ELSEIF 分岐 == 0 || TALENT:111:機嫌 == -1
				PRINTFORML 「자면서 여자 이름 불렀어?」
				PRINTFORMW 「그게 무슨 소리야? 응?」
				TALENT:111:機嫌 = -1
			ELSEIF GROUPMATCH(分岐, 4, 5, 6)
				PRINTFORML 「파하하♪ %조사처리(CALLNAME:MASTER,"는")% 얼굴에 미소를 띠고 잠들어 있었어♪」
				PRINTFORMW 「무슨 꿈을 꾼 거야?」
			ELSE
				PRINTFORML 「히히... 키아하하하♪」
				PRINTFORMW 「미안해, 네 얼굴에 낙서했어!」
			ENDIF
			RETURN 1
		ENDIF
		;		;-------------------------------------------------
		;		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;		;記入チェック（=0, 非表示、1, 表示）
		;		LOCAL:1 = 1
		;		;-------------------------------------------------
		;
		;		よくわからんけど統合しました
		;
	ENDIF
	;	;-------------------------------------------------
	;	;同棲かつ相手が起きている
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 1
	;	;-------------------------------------------------
	;
	;	統合しました
	;
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「음냐~ 중얼중얼...」
			CASE 2
				PRINTFORMW 「음냐아~... 코 고는 소리~」
			CASE 3
				PRINTFORMW 「후우... %CALLNAME:MASTER%...」
			CASE 4
				PRINTFORMW 「음... 흐으...」
			CASEELSE
				PRINTFORMW 「음~... 음음~...」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTL 
			PRINTFORML 「좋은 아침～～ 하아암～～!」
			PRINTFORMW 「...뭐라고? 왜 여기 있는 거야, %CALLNAME:MASTER%?」
			PRINTFORMW 「아! 맞다, 내가 잠든 모양이네.」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTL 
			PRINTFORML 「좋은 아침~~ 하품~~!」
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「그럼 하루 종일 놀 준비 하자~」
				CASE 2
					PRINTFORMW 「음냐... 졸리네...」
				CASE 3
					PRINTFORMW 「아아...? %CALLNAME:MASTER%님... 좋은 아침이야...」
				CASE 4
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 정말 일찍 일어나네...」
				CASEELSE
					PRINTFORMW 「…다시 잠들 수 있을까요?」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;夜寝るとき（おやすみ口上）
;==================================================

@M_KOJO_EVENT_K111_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【キャラの自室】に戻りました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF ARG:1
			;デート中に眠くて帰って寝る（拠点キャラのみ）
			IF TALENT:[[クラウンピース]]:恋慕
				PRINTFORML 「하아암~... %CALLNAME:MASTER%, 나 정말 졸려...」
				PRINTFORMW 「내일 더 놀 수 있으면 좋겠어~?」
				PRINTL 
				PRINTFORMDW 당신은 그녀가 당신 품에서 졸아드는 동안 클라운피스를 그녀의 방으로 데려다준다.
			ELSE
				PRINTFORML 「하아암~... %CALLNAME:MASTER%, 나 너무 졸려...」
				PRINTFORMW 「이제 집에 갈 시간인가 봐~?」
				PRINTL 
				PRINTFORMDW 졸린 클라운피스를 이끌고 두 분은 집으로 향한다.
			ENDIF
		ELSEIF CFLAG:うふふ
			;うふふ中に眠くて自室に帰って寝る（拠点キャラのみ）
			PRINTFORMW 「민뉴우~...」
			PRINTFORMW 「죄송해요, %CALLNAME:MASTER%님, 하지만 너무 졸려서요... 하아암...」
			PRINTL 
			PRINTFORMDW 어쩔 수 없으니 당신은 졸고 있는 클라운피스를 안고 그녀의 방으로 돌아간다.
			;月在住
		ELSEIF MAIN_MAP == 10
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「하아암~... 졸리다...」
				CASE 2
					PRINTFORMW 「하아암~... 서둘러 침대에 들자~」
				CASE 3
					PRINTFORMW 「하아암~... 너무 피곤해서 똑바로 서 있기도 힘들 정도야~」
				CASE 4
					PRINTFORMW 「뭘 해야 할까... 다음은... 하아암...」
					PRINTFORMDL 클라운피스에게 잠잘 시간이라고 말한다.
					PRINTFORML 「하아암~...」
				CASEELSE
					PRINTFORML 「음~... 졸리네~...」
					PRINTFORMW 「Zzz... Zzz...」
					PRINTFORMDL 그녀가 이미 잠들었으니, 너는 클라운피스가 네 방에서 자도록 해라.
					PRINTFORML 「하아암~...」
			ENDSELECT
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0 ;custom code
					PRINTFORMW 「하아암~... 졸리다...」
				CASE 1 ;custom code
					PRINTFORMW 「하아암~... 피곤해서 이제 잠자리에 들 거야~」
				CASEELSE
					PRINTFORMW 「뭘 해야 할까... 다음엔... 하아...」
					PRINTFORMDL 클라운피스에게 이제 집에 가서 자야 할 시간이라고 말한다.
					PRINTFORML 「하아암~...」
			ENDSELECT
			PRINTFORMW 「안녕히 계세요 %CALLNAME:MASTER%, 나중에 봐～...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている（～は眠そうにしている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「하아암~... 너무 졸려...」
			CASE 2
				PRINTFORMW 「음... 냐~...」
			CASE 3
				PRINTFORMW 「음... 음흠...」
			CASE 4
				PRINTFORMW 「후아아... 졸리다...」
			CASEELSE
				PRINTFORMW 「음~... 졸리다...」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（～は眠っている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:7
			CASE 1, 2
				PRINTFORMW 「음~... 엄마...」
			CASE 3, 4
				PRINTFORMW 「쿨쿨...」
			CASE 5, 6
				PRINTFORMW 「음... 하품...」
			CASEELSE
				PRINTFORMW 「광기 어린 시간이야...」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱して寝る（体力500以下,うふふ時はうふふ強制終了）
	;（キャラの自室以外：～を【現在地】から【キャラの自室】に運びました）
	;（キャラの自室　　：～は疲れたと言って、横になりました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「하아, 하아암...」
		PRINTFORMW 「죄송해요 %CALLNAME:MASTER%, 정말 지쳤어요... 잘 자요...」
		IF M_KOJO_K111_HOUSE(CFLAG:MASTER:現在位置) != 1
			PRINTL 
			PRINTFORMDW 너는 축 늘어진 광대 조각을 그녀의 방으로 반쯤 부축하여 데려간다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（恋慕のみ,そのまま一日が終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW 「아이고, 괜찮으세요, %CALLNAME:MASTER%?」
		IF BASE:MASTER:酒気 >= MAXBASE:MASTER:酒気
			PRINTFORML 「%CALLNAME:MASTER%, 술에 그렇게 약하다니 정말 놀랐어～♪」
			PRINTFORMW 「...아니, 내가 걱정해야 할 건 그게 아니야, 음... %HIM_HER(MASTER)%를 재워줘야겠지?」
		ELSE
			IF ARG:1
				;自室でダウン,（～が【MASTER】をベッド（布団）へと運んでくれた…）
				PRINTFORML 「좀 과하게 했나 보네～♪」
				PRINTFORMW 「...아니야, 내가 걱정해야 할 건 그게 아니지. 음... %HIM_HER(MASTER)%를 재워야겠어?」
			ELSE
				;部屋まで運ばれる,（～が【MASTER】を私室へと運んでくれた…）
				PRINTFORML 「음, 뭘 해야 할까...」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% %HIS_HER(MASTER)% 방으로 안고 갈까?」
			ENDIF
		ENDIF
		PRINTFORMW 「허어... 너무 무거워―!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た（【TARGET】が部屋に戻ってきた→寝間着へと着替え、寝床に潜った）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「아, %CALLNAME:MASTER%... 나 이제 자러 갈 거야~」
				CASE 2
					PRINTFORMW 「아, %CALLNAME:MASTER%…… 먼저 잠자리에 들게~……」
				CASEELSE
					PRINTFORMW 「아, %CALLNAME:MASTER%... 미안하지만 벌써 너무 졸려~」
			ENDSELECT
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出して寝た（眠そうな【TARGET】に追い出された…）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF CFLAG:[[クラウンピース]]:前ターン位置 == CFLAG:[[クラウンピース]]:現在位置
				;前のターンまで一緒に部屋にいた
				PRINTFORMW 「하아암~ 이제 잘 거야. 그러니까 내 방에서 나가야 해...」
			ELSE
				;寝るために部屋に帰ってきたところ
				PRINTFORMW 「흐음, %CALLNAME:MASTER%... 도대체 내 방에 무슨 일이야～?」
				PRINTFORMW 「나 이제 잘 거야, 그러니까 나가줘야 해...」
			ENDIF
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た（【TARGET】が部屋に戻ってきた→唇をとがらせる【TARGET】に、【MASTER】は渋々【Ｈの相手】から離れた）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			;寝ぼけてるということにしておく
			PRINTFORMW 「응? %CALLNAME:MASTER%... 내 방에서 뭘 하는 거야...?」
			PRINTFORMW 「뭐, 됐어. 괜찮겠지... 이제 자러 갈게~」
			;おやすみセット
			CALL M_KOJO_EVENT_K111_3_OYASUMI
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;来訪キャラが拠点で休憩（～は疲れ切っている→ちょっと休んでいきなよ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 「하아암~... 죄송해요, %CALLNAME:MASTER%, 그리고 고마워요~...」
		PRINTFORMW 「잘 자요~...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝室に居る状態でその場で寝る（～は眠気に負け、眠りについた…）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF CFLAG:うふふ
			;うふふ中に寝る
			PRINTFORMW 「음냐아~...」
			PRINTFORMW 「죄송해요 %CALLNAME:MASTER%, 하지만 정말 졸려요... 하품...」
			PRINTL 
			PRINTFORMDW 어쩔 수 없으니 당신은 클라운피스를 이불로 덮어 그녀가 잠들도록 한다.
		ELSE
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「하아암~... 졸려어...」
				CASE 2
					PRINTFORMW 「하아암~... 정말 졸리네...」
				CASE 3
					PRINTFORMW 「하아암~ ... 오늘 정말 지쳤어...」
				CASE 4
					PRINTFORMW 「하아암~... 잠자러 갈 거야~... 양들을 세어보자~...」
				CASEELSE
					PRINTFORMW 「뭐 해야 할까... 다음은... 하아...」
					PRINTFORMDL 클라운피스에게 이제 잠자리에 들 시간일지도 모른다고 말한다.
					PRINTFORML 「하아암～...」
			ENDSELECT
			PRINTFORMW 「안녕 %CALLNAME:MASTER%님, 내일 봐~...」
			SIF TALENT:[[クラウンピース]]:恋慕
				PRINTFORMW 「...아니면 오늘 밤 여기에 있어 줄 수 있어...?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「하아암~... 졸리기 시작한 것 같아요.」
			CASE 2
				PRINTFORMW 「하아암~... 서둘러 침대에 들자~」
			CASEELSE
				PRINTFORMW 「하아암~... 너무 피곤해서 똑바로 서 있기도 힘들 정도야~」
		ENDSELECT
		PRINTFORMW 「알았어~... 잘 자~...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
