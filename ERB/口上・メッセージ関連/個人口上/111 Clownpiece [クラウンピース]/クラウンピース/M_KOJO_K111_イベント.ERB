				ENDSELECT
			ELSEIF TALENT:MASTER:恋人 && !GROUPMATCH(TALENT:MASTER:恋人, [[純狐]], [[ヘカーティア]]) && CFLAG:(TALENT:MASTER:恋人):現在位置 != CFLAG:[[クラウンピース]]:現在位置
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「푸하하하... %CALLNAME:MASTER%, 벌써 여자친구라도 있나?」
						PRINTFORMW 「입 다물긴 할게. 하지만 자네한테 무슨 일이 생길지 누군들 알겠어~?」
					CASE 2
						PRINTFORML 「크하하하... 사람들이 이걸 "바람피기"라고 부를 것 같네, 알지♪」
						PRINTFORMW 「캬하하♪ 왠지 기분이 나쁘진 않네～♪」
					CASEELSE
						PRINTFORML 「캬하하하♪ %CALLNAME:MASTER%, 정말 여자친구한테 못되게 구는구나♪」
						CALL HPH_PRINT,@"「걱정 마, 나도 네 공범이니까 우리가 함께 지옥에 갈 거야HPH」","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT,@"「파하, 당신과 음란한 짓을 하는 건 정말 재미있어, %CALLNAME:MASTER%, 기분이 너무 좋아～HPH」","L"
						PRINTFORMW 「또 몸을 부딪치고 싶을 때면 언제든 기다리고 있을게~♪」
					CASE 2
						PRINTFORML 「♪～～～♪～～～」
						PRINTFORMW 「충분해, 여운이 정말 기분 좋아~♪」
					CASEELSE
						PRINTFORML 「나랑 음란한 짓 하면서 즐거웠어, %CALLNAME:MASTER%?」
						CALL HPH_PRINT,@"「정말 재미있었고, 멋지게 느껴졌다~HPH」","W"
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
		;		;-------------------------------------------------
		;		;服を着る
		;		;記入チェック（=0, 非表示、1, 表示）
		;		LOCAL:1 = 0
		;		;-------------------------------------------------
		;		IF LOCAL:1 && ARG:1 == 4
		;			PRINTFORML
		;			RETURN 1
		;		ENDIF
	ENDIF
ENDIF
RETURN 1
