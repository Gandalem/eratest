@M_KOJO_EVENT_K111_15(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;	;-------------------------------------------------
	;	;小分岐
	;	;-------------------------------------------------
	;	;未実装（押し倒しコマンドに統合？
	;	;MASTERが押し倒した（ウフフ開始時）
	;	;記入チェック（=0, 非表示、1, 表示）
	;	;LOCAL:1 = 0
	;	;-------------------------------------------------
	;	;IF LOCAL:1 && ARG == 1
	;		;PRINTFORML
	;		;RETURN 1
	;	;ENDIF
	;-------------------------------------------------
	;逢瀬終了（ウフフ終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF FLAG:時間停止 || CFLAG:睡眠 ;fix
			RETURN 0
		ELSEIF TALENT:恋慕
			;満足
			IF TCVAR:111:355
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT,@"「하아, 하아...흐읍」","L"
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 굉장했어! 또 하자HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「파하하후후」","L"
						CALL HPH_PRINT,@"「정말 굉장했어♪ %CALLNAME:MASTER%, 고마워HPH ChuuHPH」","W"
					CASEELSE
						;ちんこ使わなくても言う
						CALL HPH_PRINT,@"「하아, 하아... HPH %CALLNAME:MASTER%... 정말 좋았어!」","L"
						SIF HAS_PENIS(MASTER)
							PRINTFORMW 「다음에 네 %ONEDARI_MASTER_TINKO()%에게 지지 않을 거야!」
				ENDSELECT
			ELSEIF CFLAG:111:溜まってる度 < 200
				PRINTFORML 「휴우, 나 지쳤어...」
				CALL HPH_PRINT,@"「에헤~ HPH 다음에 또 하자HPH」","W"
			ELSEIF CFLAG:111:溜まってる度 < 500
				PRINTFORML 「그게 다야?」
				CALL HPH_PRINT,@"「조금 더 갈 수 있어 HPH」","W"
			ELSEIF CFLAG:111:溜まってる度 < 800
				PRINTFORML 「도망쳐... 이게 끝인가?」
				CALL HPH_PRINT,@"「넌 더 할 수 있어, 알고 있어...HPH」","W"
			ELSE
				PRINTFORML 「아니, 벌써 끝이야...?」
				PRINTFORMW 「정말~~ 더 하자~!」
			ENDIF
		ELSE
			PRINTFORMW 「후우... 벌써 끝이야?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;事後描写
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;精液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			CALL HPH_PRINT,@"「푸하하하...큭큭 이리 봐줘...」","L"
			SELECTCASE RAND:3
				CASE 1
