;==================================================
;贈り物イベント
;==================================================
@M_KOJO_EVENT_K111_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Oh, wait wait! %CALLNAME:MASTER%!」
		PRINTFORMW 「I forgot, but I've got a really special gift for you today, %CALLNAME:MASTER%!」
	CASE 2
		PRINTFORMW 「I figured I'd surprise you with something, %CALLNAME:MASTER%!」
		PRINTFORMW 「Tadaahー!」
	CASEELSE
		PRINTFORMW 「Oh yeah! I got a present for you today, %CALLNAME:MASTER%!」
		PRINTFORMW 「Okay, here you go!」
	ENDSELECT
	PRINTL 
	PRINTFORMDL You unwrap the gift from Clownpiece. Looks like she got you a %GIFT_NAME%!
	PRINTW 
	IF STRCOUNT(SENSE, "(クレイジーな|地獄の|狂気の)")
		PRINTFORML 「Well? It looks pretty awesome, doesn't it～!」
		CALL HPH_PRINT,@"「Make sure to take really good care of it, okayHPH」","W"
	ELSEIF STRCOUNT(SENSE, "(かわいい|怖い)")
		PRINTFORML 「Well? It's really cute, isn't it～!」
		PRINTFORMW 「I picked it out especially for you, %CALLNAME:MASTER%ー!」
	ELSE
		PRINTFORML 「Well? Isn't it super cool～!」
		PRINTFORMW 「But I'm not sure if it's really up your alley, %CALLNAME:MASTER%～...」
	ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物を大事にする（700点以上）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	IF STRCOUNT(SENSE, "(地獄の|狂気の|クレイジーな|骨|妖術)")
		CALL M_KOJO_COLOR_K111_HECA
		PRINTFORML 「Oh, Piece, what's that you've got there? It looks pretty neat.」
		PRINTW 
		CALL M_KOJO_COLOR_K111
		PRINTFORML 「Ehehe～♪ It's super awesome～! I got it from %CALLNAME:MASTER%～♪」
		PRINTW 
		CALL M_KOJO_COLOR_K111_HECA
		IF TALENT:[[ヘカーティア]]:恋慕
			PRINTFORML 「Oh my～! Just as expected of %CALLNAME:MASTER%, %HE_SHE(MASTER)%'s got a good head on his shoulders♪」
		ELSEIF TALENT:[[ヘカーティア]]:思慕
			PRINTFORML 「Huh～ It seems %HE_SHE(MASTER)% knows what you like pretty well. I think my opinion of %HIM_HER(MASTER)% just went up!」
		ELSE
			PRINTFORML 「Hmmmー, it seems like %HE_SHE(MASTER)% has pretty good taste.」
		ENDIF
	ELSEIF STRCOUNT(SENSE, "(ポップ|ロリータ|かわいい)")
		CALL M_KOJO_COLOR_K111
		PRINTFORML 「Hey hey, %CFLAG:111:1099?"Goshujinsama"#"Master"%! Look at this thing!」
		PRINTW 
		CALL M_KOJO_COLOR_K111_HECA
		PRINTFORML 「Oh my, how cute. It fits you really well, Piece♪」
		PRINTW 
		CALL M_KOJO_COLOR_K111
		PRINTFORML 「Ehehe～! I got it from %CALLNAME:MASTER%～♪」
		PRINTW 
		CALL M_KOJO_COLOR_K111_HECA
