@M_KOJO_EVENT_K111_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		CASE 0
			;-------------------------------------------------
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「헤이 헤이, %CALLNAME:MASTER%, 모험을 떠나자♪」
				SELECTCASE STR:(5000 + ARG:1)
					CASE "博麗神社"
						PRINTFORMW 「하쿠레이 신사에 가고 싶어~♪」
					CASE "命蓮寺"
						PRINTFORMW 「명련사에 가고 싶어~♪」
					CASE "人間の里"
						PRINTFORMW 「마을에서 데이트하자! 데이트야, 데이트~♪」
					CASE "霧の湖～紅魔館"
						PRINTFORMW 「안개 호수로 가고 싶어~♪」
					CASE "迷いの竹林"
						PRINTFORMW 「길을 잃은 대나무 숲에 가고 싶어～♪」
					CASE "魔法の森"
						PRINTFORMW 「마법의 숲에 가고 싶어~♪」
					CASE "三途の川～冥界"
						PRINTFORML 「산즈 강을 함께 건너자!」
						PRINTFORMW 「괜찮을 거야~ 우리 같이 지옥에 갈 수 있잖아, %CALLNAME:MASTER%~」
					CASE "妖怪の山 (山麓)"
						PRINTFORMW 「요괴 산에 가고 싶어～♪」
					CASE "妖怪の山 (山頂)"
						PRINTFORMW 「산 등반을 해보고 싶어~♪」
					CASE "地底"
						PRINTFORMW 「지하로 가고 싶어~♪」
					CASE "夢の世界～月"
						PRINTFORMW 「달에 가자♪ 멀다고 생각해? 아니, 사실 여기서는 정말 가까워!」
				ENDSELECT
				RETURN 1
			ENDIF
		CASE 1
			;-------------------------------------------------
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「야호♪ %조사처리(CALLNAME:MASTER,"는")% 정말 착하네♪」
				RETURN 1
			ENDIF
		CASE 2
			;-------------------------------------------------
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「쳇, 이 못난 애야.」
				PRINTFORMW 「뭐 어때♪ 그럼 다음에 하자♪」
				RETURN 1
			ENDIF
		CASE 3
			;-------------------------------------------------
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「헤이 헤이, 오늘 우리 집에 가지 않을래?」
				IF FIRSTTIME("お招き", 1, 111)
					PRINTFORML 「지금 부모님 안 계셔!」
					PRINTFORMW 「...하지만 늘 그런 거지.」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「너에게 뭔가 보여주고 싶은 게 있어, %CALLNAME:MASTER%♪」
						CASE 1
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 집 요리를 해보고 싶어~! 푸하하, 농담이야~!」
						CASEELSE
							PRINTFORMW 「아, 음, 우리 둘만 있는 게 좀 좋을 것 같아서 말이야...」
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
		CASE 4
			;-------------------------------------------------
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF FIRSTTIME("お招き", 0, 111)
					PRINTFORML 「정말!? 야호♪」
					PRINTFORMW 「그게, 음, 좀 지저분할 수도 있지만 분명 마음에 들 거라고 확신해, %CALLNAME:MASTER%♪」
				ELSE
					;晴れ
					IF TIME:5 <= 1
						PRINTFORML 「야호!」
						PRINTFORML 「좋아, 내 손 꼭 잡아! 날아가자ー!」
						;TIME += -1 * TIME_REQUIRED(GET_MAPID(CFLAG:MASTER:現在位置), 10) / 2
						;遠いから時間短縮してあげようと思ったけど直後に出る地の文の表示と齟齬が出るのでやめ。-X分ってのは変だよね…
					ELSE
						PRINTFORML 「아, 다행이다!」
						PRINTFORMW 「방을 치우기로 한 게 잘됐어♪」
						;とか言ってるけど部屋の汚れは変化しません（ここではできない）
						;本人は精一杯部屋を片付けたつもりでいるのです！
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
		CASE 5
			;-------------------------------------------------
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORML 「보인다...」
				PRINTFORMW 「결국 달은 좀 멀고 뭐 그런 거겠지...」
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
