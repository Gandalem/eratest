@M_KOJO_MESSAGE_COM_K133_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		IF RAND:3 == 0
			PRINTFORMW 「んん읏%UNICODE(0x2665) *1%お前に嬲られると気持ちがいいな……%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
			PRINTFORMW 「더 세게 주물러 줘!!!」
		ELSE
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 엉덩이를 주무르는 게 이렇게 기분 좋을 줄이야……!」
		ENDIF
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「그만둬!」
		PRINTFORMW 사키는 %조사처리(CALLNAME:MASTER,"를")% 향해 뒤차기를 날렸다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「히힝!? 엉덩이를 쓸리는 것도 버릇이 되어버렸네!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「히잉!? 나의 엉덩이도 아직 단련되지 않았을까...」
		ELSE
			PRINTFORMW 「응, 히익!? 네가 만지는 걸로 느껴지잖아!!!」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「히힛!?……내 엉덩이는 그렇게 매력적인가?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽!?」
			PRINTFORMW 「...엉덩이는 단련하기 어렵거든...」
		ELSE
			PRINTFORMW 「응?!」
			PRINTFORMW 「……안 돼, 엉덩이를 쓰다듬는 걸 느껴버린다...!」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「너무 엉덩이를 만지지 마, 약하니까.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「미안하지만 내가 인정한 사람 외에는 만지게 해줄 생각 없어.」
			PRINTFORMW 사키는 '팍' 소리를 내며 손을 뿌렸다.
		ELSE
			PRINTFORMW 「내 엉덩이가 그렇게 매력적일까? 비싸게 받을 거야」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「……이렇게까지 할 수 있었구나」
			PRINTFORMW 사키는 날카롭게 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「차 죽고 싶어?」
		ELSE
			PRINTFORMW 「정말 바보들이 있었던 거야!」
			PRINTFORMW 사키는 엉덩이를 흔들며 화를 내고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
