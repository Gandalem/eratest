@M_KOJO_EVENT_K133_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「……죽인다!」
				ELSEIF TALENT:恋人
					PRINTFORMW 「！？」
					PRINTFORMW 「뭐 하는 거야 바보...!」
					PRINTFORMW 사키는 너무나 된 상황에 놀라 당황한다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「……우왓!?」
					PRINTFORMW 사키는 놀라서 이상한 소리가 나오고 있었다.
					PRINTFORMW 「뭔가 있는 거냐!・」
					PRINTFORMW 체면을 차리려 애쓰던 사키는 무슨 일인지 우리에게 물어왔다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「……！」
					PRINTFORMW 「놀라게 하지 마……!」
					PRINTFORMW 사키는 울 것 같은 표정을 짓고 있다.
				ELSE
					PRINTFORMW 「……엣!?」
					PRINTFORMW 「갑자기 들어오지 마!」
					PRINTFORMW 사키는 당황하며 허둥댔다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「……지금 죽인다!」
				ELSEIF TALENT:恋人
					PRINTFORMW 「도대체 무슨 용무야 정말……」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「……지금 본 건 잊어버려, 알겠지?」
					PRINTFORMW 사키는 잘 이해할 수 없는 변명을 하고 있다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「……너무 뚫어져라 보지 마라」
					PRINTFORMW 사키는 얼굴을 붉히며 당황하고 있다.
				ELSE
					PRINTFORMW 「……못 본 걸로 해줘」
					PRINTFORMW 사키는 얼굴을 새빨갛게 물며 그렇게 간청해왔다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「……이……!」
					PRINTFORMW 사키는 항의하면서 은밀한 부위에 손을 뻗고 있다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「응! %UNICODE(0x2665) *1%」
					PRINTFORMW 「이쪽이 더 좋네……. %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「변태 같으니라고...%UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「……그렇게 많이 보여지면 버겁네……」
				ELSE
					PRINTFORMW 「봐도 재미없다」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「......나가면 죽이지 않고 보내주마!」
					PRINTFORMW 사키는 소리치며 내쫓아왔다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「빨리 돌아가!」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「당장 돌아가!」
				ELSEIF TALENT:思慕
					PRINTFORMW 「당장 꺼져! 지금 당장!」
				ELSE
					PRINTFORMW 「......돌아가라!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「......무슨 생각을 하고 있는 거야!」
					;処女
				ELSEIF TCVAR:破瓜 == 1
					PRINTFORMW 「……처음이잖아? 부드럽게 해줘.」
				ELSEIF TALENT:恋人
					PRINTFORMW 「……이런 것도 흥분되네……%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「이대로 잠드는 것도 안 되니까……%UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「아무에게도 말하지 마.」
				ELSE
					PRINTFORMW 「이런 것도, 인간은 하는 거구나……」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「……죽어버려라……」
				ELSEIF TALENT:恋人
					PRINTFORMW 「……과연, 나쁘지 않았군……%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「역시 진짜에는 미치지 못하네 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「이렇게 좋다니 처음부터 할 걸 그랬네%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「……뭐, 나쁘지 않았네……!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「…무슨 생각을 하는 건지 이해할 수가 없어」
				ELSEIF TALENT:恋人
					PRINTFORMW 「......내일도 계속할까 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「이런 건 사람한테 할 게 아니야 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「아, 후련하다! 잘까!」
				ELSE
					PRINTFORMW 「정말 너는 변태구나……」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
