@M_KOJO_EVENT_K133_24(ARG,ARG:1)
;口上主はLOCAL
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「…………？」
		PRINTFORMW 사키는 태내의 생명의 고동을 느끼자 부드럽게 복부를 쓰다듬는다.
		PRINTFORMW 「후훗... 너의 아이인가, %CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……？」
		PRINTFORMW 사키는 태아 속 생명의 고동을 느끼자 부드럽게 복부를 쓰다듬는다.
		PRINTFORMW 「%CALLNAME:MASTER%……책임은 무겁다는 걸……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 사키는 태아의 심장 박동을 느끼자 부드럽게 복부를 쓰다듬었다.
		PRINTFORMW 「......말의 뼈로도 임신하는구나......」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「……윽……!?」
		PRINTFORMW 사키는 아랫배의 이상함에 고개를 갸웃거린다.
		PRINTFORMW 「뭐지……방금 건」
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
