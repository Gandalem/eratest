@M_KOJO_EVENT_K133_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「후훗, 좋은 근육이지?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「역시 단련해 두면 자신감이 생기네!」
					ELSE
						PRINTFORMW 「너에게 보여도 부끄럽지 않게 단련하고 있었던 거야?」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「이 쪽이 더 좋은 건가? 속옷의 좋고 나쁨을 잘 몰라서 말이야...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「마음껏 내 근육을 맛봐도 좋아!」
					ELSE
						PRINTFORMW 「어때? 멋진 복근이지?」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「인간의 취미는 모르겠네……」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이쪽 쪽이 더 흥분하는 건가?」
					ELSE
						PRINTFORMW 「나체 쪽이 편하긴 하지만 말이지……」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 팬티도 주면 좋지!」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「네 팬티랑 바꾸면 괜찮아! 소중히 다룰 테니까!」
							ELSE
								PRINTFORMW 「교환이라는 조건이라면 좋아!」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「소중히 해라!」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「나를 이걸로 기억해 주길 바란다!」
							ELSE
								PRINTFORMW 「이상하게 써도 나는 관대하니 용서해 주겠다!」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「어쩔 수 없네, %조사처리(CALLNAME:MASTER,"는")%」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「이걸로 괜찮은 걸까? 모르겠어……」
							ELSE
								PRINTFORMW 「소중히 신어라...?」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「싫지만?」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「그런 건 좋지 않다고 생각해!」
							ELSE
								PRINTFORMW 「무엇에 쓸 생각이지?」
							ENDIF
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
