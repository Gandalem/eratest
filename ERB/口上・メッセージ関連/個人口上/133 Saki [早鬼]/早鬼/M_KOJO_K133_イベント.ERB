@M_KOJO_EVENT_K133_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%、デートをしようじゃないか！」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%、お互い暇ならデートをしよう！」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%、付き合ってもらうぞ！」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 한가해?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「너랑 함께라면 어디든 갈 수 있어! 갈 수 있는 곳까지는 가보자고!」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「즐거운 하루가 될 것 같아!」
				ELSEIF TALENT:思慕
					PRINTFORMW 「지상의 일은 모르니 너에게 맡길게」
				ELSE
					PRINTFORMW 「우리로 패권을 가지러 가자고! ……농담이야」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「……바람인가? 그렇다면 상처받을 거다」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「거절당해 버렸네, 다음 기회로 할게」
				ELSEIF TALENT:思慕
					PRINTFORMW 「그건 유감하네, 둘이라면 어디든 갈 수 있을 거라고 생각했는데」
				ELSE
					PRINTFORMW 「그렇구나, 아쉽네.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「내 집에 오지 않겠어? 지금 아무도 없어.」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「내 방에 안 올래? 좋은 당근이 있거든!」
				ELSEIF TALENT:思慕
					PRINTFORMW 「같이 근력 운동 안 할래? 혼자 있으면 외롭거든」
				ELSE
					PRINTFORMW 「시간 있으면 내 방에서 놀지 않을래?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「좋아! 즐거운 걸 하자고%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「기대하고 있어, 먹으면 깜짝 놀랄걸!」
				ELSEIF TALENT:思慕
					PRINTFORMW 「나를 따라와! 격렬하게 운동할 테니까!」
				ELSE
					PRINTFORMW 「뭐 하면서 놀까? 주사위 게임인가... 팔굽혀펴기일까」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「……그런, 너무하다……」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「왜 그래, 당근 싫어해?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「나를 혼자 두다니 잔인한 녀석이네……」
				ELSE
					PRINTFORMW 「뭐야, 한가하지 않아? 아쉽네.」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
