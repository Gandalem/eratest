	IF LOCAL:1 && ARG
		IF TALENT:恋人 || TALENT:恋慕
			CALL EVENTEND_TSUBUYAKI
			IF RAND:3 == 0
				PRINTFORML 「아- 외롭네...... %CALLNAME:MASTER%......」
