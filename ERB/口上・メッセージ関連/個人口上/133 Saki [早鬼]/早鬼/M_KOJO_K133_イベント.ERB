@M_KOJO_SPEVENT_K133_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;地の文
IF LOCAL
	PRINTFORMW 「%CALLNAME:MASTER%, 오늘은 데이트해 줘서 고마워」
	PRINTFORMW 사키는 그렇게 말하며 %CALLNAME:MASTER%앞에 가로섰다.
	PRINTFORMW 「너에게 줄 것이 하나 있어, 잠시만 기다려 줘」
	PRINTFORMW 사키는 날개를 펼쳐 두 사람을 감싸 안고, %조사처리(CALLNAME:MASTER,"를")% 부드럽게 끌어안았다.
	PRINTFORMW 그리고 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 바라보더니―――
	PRINTFORMW 「음……」
	PRINTFORMW 「……미안하다, 이 정도밖에 줄 게 없어서」
	PRINTFORMW 키스를 끝내자 그녀는 조금 슬픈 듯 수줍게 돌아보더니 날아가 버렸다.
	PRINTFORMW 
	PRINTFORMW (......킷쵸라면 좀 더 현명하게 키스라도 할 수 있었을 텐데)
	PRINTFORMW (나는...... 잘할 것 같지도 않네)
	PRINTFORMW 그녀는 자조적인 기색으로 그렇게 생각하며 귀가했다.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K133_2
RETURN 1

@M_KOJO_SPEVENT_K133_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1133)
			PRINTFORMW 「저기, %CALLNAME:MASTER%, 나와 사귀어 주지 않을래?」
			PRINTFORMW 데이트를 마치고 돌아오는 길에 사키는 갑자기 고백했다.
			PRINTFORMW 「나는 좋아하는 사람에게 어떻게 고백해야 할지 모르겠어」
			PRINTFORMW 「그래서 이렇게 하는 수밖에 없는데, 하지만 말이야」
			PRINTFORMW 「나는 태어나서 죽은 후에도 누군을 좋아하게 된 건 셀 수도 없을 정도로 적어」
			PRINTFORMW 「그 마음은…… 분명 지금이니까 전할 수 있어!」
			PRINTFORMW 「나랑 연인이 되어줘, %CALLNAME:MASTER%!」
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 전보다 단련해 왔어」
			PRINTFORMW 사키는 가슴에 손을 대고 각오를 다진 듯 말을 이었다.
			PRINTFORMW 「게다가 나는 너를 좋아하는데 네가 나를 좋아하지 않는 건 비겁하지 않아?」
			PRINTFORMW 「그러니까…… 사귀어 줘!!!」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「응! 너라면 그렇게 말해줄 거라고 생각하고 있었어! %CALLNAME:MASTER%!?」
		PRINTFORMW 사키는 그렇게 말하며 잠시 망설이다가 %조사처리(CALLNAME:MASTER,"의")% 눈을 바라보기 시작한다.
		PRINTFORMW 「하지만 연인이 된 건 좋은데 뭘 하면 되는지 모르겠어!」
		PRINTFORMW 그렇게 말하면서도 사키는 그대로 입맞춤했다.
		PRINTFORMW 「음... 이대로 세상 끝까지 우리의 사랑을 보여주러 갈까!」
		PRINTFORMW 사키는 흥분한 모습으로 우렁차게 그렇게 선언했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……더 단련해서 언젠가 돌아보게 해주겠어, %CALLNAME:MASTER%!」
		PRINTFORMW 사키는 조금 어색한 미소를 짓고 있다.
		PRINTFORMW (마음이 전해지지 않는 건 언제나 괴롭네……)
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K133_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……이제 돌아갈게」
			PRINTFORMW 사키는 그렇게 말하고 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「오늘은 즐거웠어!」
			PRINTFORMW 「또, 내일 데이트하자!」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「오늘은 정말 즐거웠으니까, 또 내일 보러 올게!」
		ELSEIF TALENT:思慕
			PRINTFORMW 「후후후, 좋은 하루였어! 또 놀자!」
		ELSE
			PRINTFORMW 「사람이랑 데이트하는 것도 나쁘지 않네! 잘 가!」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K133_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;今日会ってない。
	IF !TCVAR:133:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:133:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「일 중이다, 나중에 해라」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K133
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「……나는 지금 기분이 나쁘다, 찰 것이다」
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕, %CALLNAME:MASTER%!」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「나를 보러 와 준 건가! 기쁘네!」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「일부러 만나러 와주다니 기쁘구나!」
					ELSEIF TALENT:思慕
						PRINTFORMW 「나를 보러 올 만큼 한가한 거냐? 뭐 기쁘긴 하지만 말이지.」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:133:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「일 중이다, 나중에 해라」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K133
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「……나는 지금 기분이 나쁘다, 찰 것이다」
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕, %CALLNAME:MASTER%!」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「네 냄새를 따라왔더니 이런 곳에 오고 말았군! 어떻게 해줄까?」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「네 있는 곳은 알기 쉽군! 숨지 않고 있어서 기쁘다!」
					ELSEIF TALENT:思慕
						PRINTFORMW 「후훗, 오늘은 뭘 하고 있는 거야?」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF TALENT:恋人
				PRINTFORMW 「뭐야 %CALLNAME:MASTER%, 같이 빨아 줄게!」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「좋은 기회야, 등을 쓸어주지.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「어? 선점자인가?」
				PRINTFORMW 「나는 신경 쓰지 않으니까 너도 신경 쓸 것 없어!」
			ELSE
				PRINTFORMW 「응? 먼저 들어있었나? 뭐 서로 신경 쓸 일은 없겠지!」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			IF TALENT:恋人
				PRINTFORMW 「혼자 있는 쪽이 좋은 모양이군, 실례했다.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「천천히 가는 게 좋아! 나는 인내심이 있으니까!」
			ELSEIF TALENT:思慕
				PRINTFORMW 「이거 실례야, 남의 구경하는 취미는 없어.」
			ELSE
				PRINTFORMW 「미안하다, 신경 쓰지 말고 계속 있어줘.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			IF TALENT:恋人
				PRINTFORMW 「조만간 등에 물러서게 해 줄 테니 신경 쓰지 마!」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「아직 내 등을 넘기엔 이르다!」
			ELSEIF TALENT:思慕
				PRINTFORMW 「유감스럽지만 여기가 나의 목욕탕이야, 나가 줄 수 있겠니?」
			ELSE
				PRINTFORMW 「내 나체에 흥미 따윈 없을 테지?」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:133:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「일 중이다, 나중에 해라」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K133
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「……나는 지금 기분이 나쁘다, 찰 것이다」
				ELSE
					;早朝
					IF TIME:2 == 1 || TIME:2 == 2
						PRINTFORMW 「안녕, %CALLNAME:MASTER%!」
						;昼
					ELSEIF TIME:2 == 3 || TIME:2 == 4
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
						;夕方・夜
					ELSEIF TIME:2 == 5 || TIME:2 == 6
						PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					ENDIF
					IF TALENT:恋人
						PRINTFORMW 「네 냄새를 따라왔더니 이런 곳에 오고 말았군! 어떻게 해줄까?」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「네 있는 곳은 알기 쉽군! 숨지 않고 있어서 기쁘다!」
					ELSEIF TALENT:思慕
						PRINTFORMW 「후훗, 오늘은 뭘 하고 있는 거야?」
					ENDIF
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			IF TALENT:恋人
				PRINTFORMW 「……」
				PRINTFORMW 「……아무것도 아니야!」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「멋진 남자네! 더욱 반해버렸어!」
			ELSE
				PRINTFORMW 「이것은 실례, 설마 만남이라니 말이야」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
