; Modular ERB: 個人口上/133 Saki [早鬼]/早鬼/M_KOJO_K133_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K133_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K133_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K133_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K133_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「시끄럽다, 너」
		;会話不能
	ELSEIF TCVAR:302
		IF RAND:5 == 0
			PRINTFORMW 「아, 그렇지」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「별로 화제가 안 되네」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「좀 더 화제를 들고 와라」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그 이야기는 이제 지긋지긋해!」
		ELSE
			PRINTFORMW (인간과의 대화는 어렵네...)
		ENDIF
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 더 안 마시는 거냐!」
			PRINTFORMW 「그럼 내가 마시게 해 주지! 안심해라!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「나에 %CALLNAME:MASTER%……」
			PRINTFORMW 사키는 취해서 달라붙는다.
			PRINTFORMW 「……좋은 눈을 하고 있네, 좋아해, 네 눈이」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「%CALLNAME:MASTER%」
			PRINTFORMW 사키는 얼굴을 상기시키며 말을 건다.
			PRINTFORMW 「좋은 이름이야, 나에게 어울리는구나... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 더 마시지 않나?」
			PRINTFORMW 「나에게 취한 거야? 별로 부끄러운 소리 하지 마, %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%……もっとお前に酔わせてくれ%UNICODE(0x2665) *1%」
		ENDIF
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「음...... 조금 너무 많이 마셨어......」
			PRINTFORMW 「뭐야, 정말 일이 생기면 네가 있잖아?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「말이라도 취하는 법이지, 장소랑 너한테.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「술도 좋지만, 너랑 마시는 게 더 좋다!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……%조사처리(CALLNAME:MASTER,"는")% 술에 강한가? 나는 강하지만, 나보다 먼저 쓰러지지 마라?」
		ELSE
			PRINTFORMW 「음... %CALLNAME:MASTER%도 마시고 있다면 나도 안 마시면 안 되겠네」
		ENDIF
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「음, 좋은 술이야. 너랑 마시고 있어서 그런가.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 술은 좋아하는 건가? 너와 마실 수 있다면 나는－」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후훗, 재미있어지기 시작했네.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「뭐야, 사람하고 술 마시는 거 익숙하지 않아. 별로 나 보지 마.」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 무너지지 마라?」
		ENDIF
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「세상이 비굴한 일뿐이라도 호쾌하게 나아가야 해!!!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「와하하하! 환상향도 우리의 것이다!!!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「너무 많이 마셨네...... 하지만 더 마실 수 있어!!!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「다음엔 비단뱀으로라도 환생할까! 기대된다!!」
		ELSE
			PRINTFORMW 「살아있을 때는 이렇지도 못했는데, 죽어서 다행일지도 모르겠군!」
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「후훗후후... 역시 술은 좋은 물이군!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「인간도 좋은 물건을 만드는군, 조금 부럽다.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「이렇게 기분이 좋아질 수 있다면 더 마셔야겠어!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「나는 몸이 강했으니까! 술도 당연히 세지!」
		ELSE
			PRINTFORMW 「와하하하, 유쾌유쾌!」
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「응, 너도 마음껏 즐기면 좋겠다!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「흥흥, 약간 냄새가 나네. 술 기운이 풍겨오고 있어.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「저 사람도 이런 느낌이었을까」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「늑대 레이무에게도 마시게 해 줄까, 아니 맛이 없으려나……」
		ELSE
			PRINTFORMW 「지금이라면 무엇을 해도 잘 풀릴 것 같은 기분이 들어!」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「후우... 목욕은 좋네, 인간이 만들어내는 것은 언제나 좋은 것이지」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「물을 싫어하는 동물도 많지? 나는 깔끔하니까 말이야, 그렇지 않으면 좋아하는 사람에게 돌아보지도 않는다고.」
		ELSE
			PRINTFORMW 「따뜻한 물이랑 차가운 물은 정말 다르다니까, 신기해.」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「봄은 운동하기 좋은 계절이네!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「쾌활한 계절에는 몸을 움직이는 게 최고야!」
					ELSE
						PRINTFORMW 「자, 산책이라도 갈까!」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「이런 더운 계절에는 운동해서 땀을 흘리는 게 최고지!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「수영도 좋네! 수영복을 사러 갈까」
					ELSE
						PRINTFORMW 「오늘은 땀을 잔뜩 흘렸으니까 빨리 목욕하고 싶네~」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「운동의 계절이군! 근력 운동이 잘 되네!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「아키는 맛있는 것이 많네! 더 일찍 지상에 올 걸 그랬어!」
					ELSE
						PRINTFORMW 「가을은 시원하니까 운동 후에 땀 안 닦으면 감에 걸릴 거야! 조심해!」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「추운 계절에는 몸을 움직여 따뜻하게 하는 게 최고지!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「겨울에는 제대로 땀 처리를 해야 한다고? 감기에 걸리니까!」
					ELSE
						PRINTFORMW 「철인 삼종 경주 같은 게 이 계절에는 있다고 들었는데... 꼭 참가해 보고 싶어!」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						PRINTFORMW 「너랑 있으면 지루할 게 아니라 즐거워지네!」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 지휘해 나를 사용해도 좋다」
						PRINTFORMW 「그 정도는 너를 신뢰하고 있다는 뜻이다」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「무슨 일이야? 나를 탈래?」
						PRINTFORMW 「농담이 아니야, 너를 태우고 달려나가고 싶은 거야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「지상 침공도 생각하고 있었지만, 이렇게 너와 보내는 것만으로도 행복한 걸지도 모르겠어.」
					ELSE
						PRINTFORMW 「응응, 네 이야기는 어렵지만, 듣고 있으면 두근거리네!」
						PRINTFORMW (......옛날 어딘가에서 느낀 것 같기도 하지만...... 착각이겠지)
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「응응, 네 이야기는 잘 모르겠지만 듣고만 있어도 재미있네!」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「평소에는 어떤 일을 하고 있냐고? 음, 역시 요즘 유행은 달리기지!」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「킷쵸는 음습해서 마음에 안 들지만 너는 시원시원해서 좋다!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「짐승 같은 세상의 인간들의 이야기도 들어둘 걸 그랬네……」
						PRINTFORMW 「……아니, 뭐 이런 식으로 인간들의 이야기가 재미있을 줄은 몰랐어」
					ELSE
						PRINTFORMW 「동경은 항상 멀지만 나는 이렇게 가까우니 축복받았네」
						PRINTFORMW 「뭐야, 혼잣말이야, %CALLNAME:MASTER%」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「지상은 화창해서 기분이 좋네!」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「인공 태양 같은 게 밖에 있나 보네」
						PRINTFORMW 「저 지옥계에도 그런 게 있으면 좋겠는데……. 역시 햇빛은 다르다니까」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 몸을 움직이는 거 좋아해?」
						PRINTFORMW 「나는 좋아해, 아무것도 생각할 필요가 없으니까.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「발이 빠르면 무조건 정의지, 그러니까 내가 정의라는 거잖아!」
					ELSE
						PRINTFORMW 「지상은 넓고 달리기에 좋고 즐겁네!」
					ENDIF
				ELSEIF CFLAG:2 >= 500
					IF RAND:5 == 0
						PRINTFORMW 「저 큰 다리 가진 녀석 엄청 강했지... 또 싸우고 싶다.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「너도 인간이라면 킷쵸에게 조심해라」
						PRINTFORMW 「저건 타인을 주저 없이 내던지는 녀다」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「내일 최선의 수를 두기보다 오늘 차선책이라도 실행하는 게 낫다는 말을 누가 했었는데, 좋은 말인 것 같아.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「너는 운동을 싫어하는 거냐? 몸 움직이는 건 기분 좋잖아~」
					ELSE
						PRINTFORMW 「너도 좋은 냄새가 난다. 딱히 먹진 않을 거다, 초식이라서 말이야.」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「무슨 말 했어?」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「네 이야기는 흥미롭군, 별로 모르겠지만.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「역시 인간은 우리들과는 두뇌가 다른 거구나」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「왜 그래? 달리기라도 할까? 지지 않을 거야!」
					ELSE
						PRINTFORMW 「지상도 지독한 곳이지, 야만계만큼은 아니지만.」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K133_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K133_301
CALL M_KOJO_MESSAGE_COM_K133_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K133_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「네가 차를 마실 생각은 없어!」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「...차 타는 법을 다음에 가르쳐 줄게」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응! 맛없네!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「내가 타는 게 더 맛있겠군!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「예전에 마셨던 차가 더 맛있었지?」
		ELSE
			PRINTFORMW 「...너는 차를 잘 우리는 편이 아니구나!」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 대단하네! 이렇게 맛있는 차는 마셔본 적 없어!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「후하아...! 네가 우려낸 차는 맛있구나!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응! 특별한 맛이네!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「꿀꺽... 제법 맛이 있군」
		ELSE
			PRINTFORMW 「후우... 맛있는 차를 마시니 마음이 놓인다!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K133_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K133_302
CALL M_KOJO_MESSAGE_COM_K133_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K133_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「나에게 손대지 마, 화가 나 있으니까!」
			PRINTFORMW 사키는 스킨십에 대해 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쉽게 만지지 마, 더러워...」
			PRINTFORMW 사키는 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「그만둬! 나는 지금 기분이 안 좋단 말이야!」
			PRINTFORMW 사키는 화난 표정으로 항의해 온다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「내가 등을 밀어 줄게... 뭐야, 긴장하네!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「목욕은 즐겁네! 자, 몸을 씻자!」
		ELSE
			PRINTFORMW 「내 등을 씻겨주지 않을래? 사람의 손으로 씻기는 게 좋거든.」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「너에게 쓰여지려고 트리트먼트를 바꿔왔단 말이야, 예쁘잖아?」
			PRINTFORMW 사키는 %조사처리(CALLNAME:MASTER,"에게")% 부드러운 머리를 쓰여지며 미소 짓고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 너에게 만져지면 기분이 좋아져 버린다구나... %UNICODE(0x2665) *1%」
