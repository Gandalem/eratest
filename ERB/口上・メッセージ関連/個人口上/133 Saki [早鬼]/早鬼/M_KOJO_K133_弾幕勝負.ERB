; Modular ERB: 個人口上/133 Saki [早鬼]/早鬼/M_KOJO_K133_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K133_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「네놈의... 죄는 무거워!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「나는 죽음을 지니고, 너는 생을 지니고 있어. 어느 쪽이 옳은지 지금 이 자리에서 답을 내라!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「さあ！お前の力、この漆黒の天馬に見せてみせよ！
		ELSEIF RAND:2 == 0
			PRINTFORMW 「강해지지 않으면 살 수 없다고들 하는데, 어느 정도 강해야 하는 걸까? 한번 시험해 보자!!!」
		ELSE
			PRINTFORMW 「킷쵸보다는 좀 맛이 있기를 바라.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「......하나하나 짜증나게 하네!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「꽤 하는군!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「왠지 상태가 좋지 않은 것 같군...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「킷쵸처럼 싫어하는 녀랑은 달라서 호전적이고 기분 좋다고!」
				ELSE
					PRINTFORMW 「푸하하하! 역시 만만치 않네!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……이럴 수가!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「이렇게까지 하다니!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「재미있어지기 시작했네!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아직은 더 즐겁게 해 주겠어!」
				ELSE
					PRINTFORMW 「아하하하! 웃을 수밖에 없군!!!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……죽인다……!!!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「위험이나 마이너라면 기폭제겠군!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「궁지에 몰린 들쥐가 고양이를 물었다고들 하지만... 나는 다리가 있으니까!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아직 멀었어! 이 순간이! 우리들의!」
				ELSE
					PRINTFORMW 「궁지에 몰렸다고? 아니, 어떨까!!!」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「너 같은 애에게 질 리 없잖아」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아직 진심을 다하지 않았겠지! 그렇지!!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「내 근육을 읽어! 그러면 피할 수 있을 거야!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아직 단련할 곳이 부족하다! 복근 100회부터다!」
				ELSE
					PRINTFORMW 「흠흠... 그럼 내가 단련시켜 주지! 스파르타지만 말이야!」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「흥, 마음에 들지 않아! 나에게 상처를 내다니!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「가벼운 상처라고 손상을 입히다니, 대단하군!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「킷쵸보다 약하군!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아직 약하군! 더 단련시켜 주마!」
				ELSE
					PRINTFORMW 「무엇보다 너에게는 빠름이 부족하다!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「…참 바보 같은 녀석이 있었구나」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「후후후후! 제법 즐거웠다!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「궁지에 몰렸을 때 비로소 본성이 나온다고들 하지만 나는 즐겁다!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「그 정도 할 수 있다면 어디까지라도 달려갈 것 같군!」
				ELSE
					PRINTFORMW 「우윽... 이런 강함이라니! 반해버릴 것 같아!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「크윽... 분하다...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「네 등은 따라잡을 수 없을 것 같구나……」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「……인간에게 이 정도의 힘이 있을 줄이야……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「짐승계에서도 쉽게 볼 수 없는 강함이다! 반했다!」
				ELSE
					PRINTFORMW 「이 정도면 어떤 적에게도 이길 수 있을 것 같아!」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
