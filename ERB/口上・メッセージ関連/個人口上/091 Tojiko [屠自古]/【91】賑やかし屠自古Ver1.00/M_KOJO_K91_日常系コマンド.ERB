;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;TARGETとデート
	IF CFLAG:同行
		IF FIRSTTIME(SELECTCOM)
			PRINTFORMW 「뭐... 당신은 나랑 데이트하고 싶다고 말하는 거야?!」
			PRINTFORMW 「...후... ...뭐야...」
			PRINTFORMDW  토지코는 얼굴을 붉히며 얼어붙는다...
			PRINTFORMDW  그리고 잠시 후...
			PRINTFORMW 「...그냥 이번 한 번만! 나랑 딱 이번 한 번만 데이트하는 거야! 다시는 그런 부탁 안 해줘!」
			PRINTFORMDW  그녀는 당신과 데이트하는 것에 마지못해 동의한다...
		ELSE
			IF DATENAME_PLACE(1) == "博麗神社"
				PRINTFORMW 「신사라니... 그-그 신사라고?!」
				PRINTFORMW 「아, 아니, 나 괜찮아... 그냥... 마치 편히 잠들기 좋은 방법처럼 들려서 궁금해졌어...」
			ELSEIF DATENAME_PLACE(1) == "命蓮寺"
				PRINTFORMW 「음음... 그 불교적인 곳에 가는 거야...」
				PRINTFORMW 「상관없지만... 놀림거리가 되지 않을까?」
				PRINTFORMDW  토지코는 부끄러워한다...
			ELSEIF DATENAME_PLACE(1) == "人間の里"
				PRINTFORMW 「호~하, 오늘 마을에 갈 거야, 응?」
				PRINTFORMW 「음, 그럼 이번에는 그들의 과자를 맛봐야겠어.」
				PRINTFORMW 「...그리고 예상대로, 네가 사야지.」
				PRINTFORMDW  토지코는 배를 문지르며 웃는다...
			ELSEIF DATENAME_PLACE(1) == "霧の湖～紅魔館"
				PRINTFORMW 「안개 낀 호숫가에 있는 악마의 저택이라니... 후후, 내 용모가 정말 분위기를 더해주겠어.」
				PRINTFORMDW  토지코는 기분이 아주 좋아 보인다...
			ELSEIF DATENAME_PLACE(1) == "迷いの竹林"
				PRINTFORMW 「우리 거기 가서 의사 볼 거야?」
				PRINTFORMW 「무슨 일 있어? 몸이 안 좋으면 바로 나한테 말해줘야 해!」
				PRINTFORMDW  토지코가 네 건강을 걱정하고 있단다...
			ELSEIF DATENAME_PLACE(1) == "魔法の森"
				PRINTFORMW 「이봐, 저 숲의 미아즈마는 인간에게 위험해.」
				PRINTFORMW 「...결국엔, 내 안으로 들어와. 적어도 공기청정기 역할은 해줄 테니까.」
			ELSEIF DATENAME_PLACE(1) == "三途の川～冥界"
				PRINTFORMW 「후후, 나를 배려해 주는 거야?」
				PRINTFORMW 「저쪽에 정원 같은 곳이 있어. 이쪽으로 내가 안내할게.」
			ELSEIF DATENAME_PLACE(1) == "妖怪の山 (山麓)"
				PRINTFORMW 「요괴 산이라니... 나 좀 신난다.」
				PRINTFORMW 「괜찮아, 걱정 마. 몇 마리만 박살 내면 돼.」
				PRINTFORMDW  대체 그게 뭐가 괜찮다는 거지...?
			ELSEIF DATENAME_PLACE(1) == "妖怪の山 (山頂)"
				PRINTFORMW 「음, 우리는 모리야 신사를 방문하는 거야?」
				PRINTFORMW 「나는 그냥 저 위로 떠오를 수 있으니 괜찮겠지만... 너는 어때? 필요한 체력이 있니?」
				PRINTFORMDW  토지코가 당신을 비웃고 있다...
			ELSEIF DATENAME_PLACE(1) == "地底"
				PRINTFORMW 「지하 세계라니... 나는 그 장소와 어떤 친밀감이 있는 것 같다.」
				PRINTFORMW 「그렇다면 집에 가는 길에 잠깐 목욕이라 할까?」
			ELSEIF DATENAME_PLACE(1) == "夢の世界～月"
				PRINTFORMW 「달,이라고 말하는 건가...? 이렇게 그냥 방문하기엔 정말 굉장한 곳이군.」
				PRINTFORMW 「뭐 어때. 달에 진짜 모찌를 두드리는 토끼들이 있는지 확인할 기회를 얻은 셈이니까.」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
