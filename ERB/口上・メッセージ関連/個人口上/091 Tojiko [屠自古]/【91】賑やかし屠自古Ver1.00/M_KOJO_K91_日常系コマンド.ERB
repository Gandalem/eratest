;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================
@M_KOJO_SUCCESS_COM_K91_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K91_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K91_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K91_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF TALENT:恋慕 && RAND:4
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「...Ah, n-nah... N-Never mind. It's nothing.」
			PRINTFORMDW  Tojiko seems a little nervous...
		ELSEIF LOCAL == 1
			PRINTFORMW 「Fufu... I lose track of time when I'm talking to you.」
			PRINTFORMW 「It would have been nice... if I met you when I was still alive.」
			PRINTFORMDW  Tojiko's eyes reflect a touch of loneliness...
		ELSE
			PRINTFORMW 「Hey, where should we go today?」
			PRINTFORMW 「Fufu, what's up～? I just thought it would be nice to walk around and see what's out there.」
			PRINTFORMDW  You want to point out that she doesn't have legs to walk around with, but decide to keep the witty remark to yourself...
		ENDIF
	ELSEIF TALENT:思慕
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「Ah, %CALLNAME:MASTER%...」
			PRINTFORMDW  Tojiko breaks out into a smile upon making eye contact with you...
		ELSEIF LOCAL == 1
			PRINTFORMW 「Still, you got some real strange tastes, don't you?」
			PRINTFORMW 「For you to care so much about this peerless and great vengeful spirit before you.」
			PRINTFORMW 「Or is it that you like to try out new things, hmm?」
			PRINTFORMDW  Tojiko nudges you teasingly...
		ELSE
			PRINTFORMW 「Even though I've been drifting aimlessly for countless years without rest...」
			PRINTFORMW 「...Fufu. Well, I'm still glad I got to live this long.」
			PRINTFORMDW  Tojiko smiles bashfully at you...
		ENDIF
	ELSEIF CFLAG:好感度 > 1000
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「Oh, I got an idea! How about we tell each other scary stories for a change?」
			PRINTFORMW 「...Actually, the only things I'm afraid of are manjuu.」
			PRINTFORMDW  You wonder if spirits are still capable of having an appetite...
		ELSEIF LOCAL == 1
			PRINTFORMW 「Oi, %CALLNAME:MASTER%!」
			PRINTFORMW 「No, it's nothing. I just wanted to try and call you by your name.」
			PRINTFORMDW  Tojiko suddenly turns away from you...
		ELSE
			PRINTFORMW 「Look, you're always bugging me, aren't you?」
			PRINTFORMW 「If you mess with me too much, you might just get cursed... Just kidding～」
		ENDIF
	ELSEIF CFLAG:好感度 > 500
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「Say, are you not interested in immortality?」
			PRINTFORMW 「No, it's just... Because you are a human and all. If you die so soon...」
		ELSEIF LOCAL == 1
			PRINTFORMW 「Kukuku... Is this what modern day man is like?」
			PRINTFORMDW  You spend some time having a lighthearted talk with Tojiko...
		ELSE
			PRINTFORMW 「Let me hear you talk for a change.」
			PRINTFORMW 「Not that I'm all that interested. It's just that's how conversations are supposed to go.」
		ENDIF
	ELSEIF CFLAG:好感度 > 300
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「Oh, %CALLNAME:MASTER%. Are you in good health?」
			PRINTFORMW 「...Kukukukuku. How does it feel to be asked about your well-being by a vengeful spirit?」
		ELSEIF LOCAL == 1
			PRINTFORMW 「My ability? I can cast lightning. You know, zap the bad guys.」
			PRINTFORMW 「Incidentally, it can also be used like an electric massager if you adjust the power. Very useful for stiff shoulders and the like.」
			PRINTFORMDW  Tojiko's right arm is vibrating with a faint electric charge...
		ELSE
			PRINTFORMW 「Do you prefer that Mononobe girl or me?」
			PRINTFORMW 「There's no ill will. It's just a combination of interest and harassment.」
			PRINTFORMDW  Tojiko grins broadly as your expression turns troubled.
		ENDIF
	ELSEIF CFLAG:好感度 > 100
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「Oh, it's %CALLNAME:MASTER%. I see you around a lot these days.」
			PRINTFORMW 「...Ku-ku-ku. It's really unlucky to meet a vengeful spirit so often.」
		ELSEIF LOCAL == 1
			PRINTFORMW 「Say, should I speak in an archaic way instead?」
			PRINTFORML 「I mean, I've already gotten used to speaking in the modern tongue. Like, making conscious effort to revise my speech and all.」
			PRINTFORMW 「It's just that Mononobe, on the other hand, seems awfully popular for her manner of talking.」
		ELSE
			PRINTFORMW 「I'llー curseー youー! No, wait, that won't do. I'mー resentfulー ...Hmmー?」
			PRINTFORMDW  Tojiko seems to be experimenting with her catchphrase...
		ENDIF
	ELSE
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「You're that human from the other day. What do you want?」
			PRINTFORMW 「You wanted to see me?」
		ELSEIF LOCAL == 1
			PRINTFORMW 「Haah? You wish to speak with me?」
			PRINTFORMW 「Hmph, what nonsense. Don't bother me too much or I'll curse you.」
			PRINTFORMDW  Tojiko dismissively waves her hand and tries to shoo you away...
		ELSE
			PRINTFORMW 「You, what's your religious belief? If you'd like you can join our Taoism and...」
			PRINTFORMW 「...Hmhm. All the kids these days are irreligious.」
		ENDIF
ENDIF
ENDIF
RETURN 1
