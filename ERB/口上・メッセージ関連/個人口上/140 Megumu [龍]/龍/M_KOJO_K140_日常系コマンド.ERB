; Modular ERB: 個人口上/140 Megumu [龍]/龍/M_KOJO_K140_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K140_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K140_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K140_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「후한 구석이 있군, 저 속물 같으니!」
		;会話不能
	ELSEIF TCVAR:302
		IF RAND:5 == 0
			PRINTFORMW 「좀 더 대화할 거리를 가지고 있어야겠지.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「그렇게 위축되지 말고 좀 더 편하게 말해도 돼.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「무슨 일이야? 긴장하고 있나?」
		ELSEIF RAND:2 == 0
			PRINTFORMW (흠... 역시 츠카사가 더 말이 많네...)
		ELSE
			PRINTFORMW (텐구랑 인간이랑 하는 이야기도 맞지 않는 걸까)
		ENDIF
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 말이야... 나한테 더 응석을 부려야 한다고 생각해」
			PRINTFORMDW 메구무는 취해서 달라붙는다.
		ELSEIF RAND:4 == 0
			CALL HPH_PRINT,@"「있잖아 %CALLNAME:MASTER%라면 뭐든 괜찮아... HPH」","L"
			PRINTFORMDW 메구무는 취한 채로 달라붙는다.
		ELSEIF RAND:3 == 0
			CALL HPH_PRINT,@"「옛 술은 마를 피하는 것이고, 내가 비늘뱀이 아니라는 것은 증명되어 버렸네 HPH」","L"
			PRINTFORMDW 메구무는 얼굴을 상기시키며 말을 건다.
			CALL HPH_PRINT,@"「아니면 %조사처리(CALLNAME:MASTER,"랑")% 있어서 취한 걸까…… HPH」","L"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%CALLNAME:MASTER%……呼んでみただけよ」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%……」
			PRINTFORMW 「전혀 읽기 힘든 이름이라 멋지네♪%CALLNAME:MASTER%!」
		ENDIF
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「후후후... 내가 인간이랑 마시면서 이런 기분이 될 줄은 몰랐네.」
			PRINTFORMW 「취한 거야, 너랑 마시는 걸 말이야 ♪」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 천공이 되고 싶다고 생각한 적 있어?」
			PRINTFORMDW 메구무는 취해서 말을 건다.
			PRINTFORMW 「분수에 넘치는 소리를 한다는 뜻은 아니지만… 나라면 이룰 수 있어」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「...... 무슨 일이야?」
			PRINTFORMW 「마시는 모습 너무 보지 말아줬으면 해... 부끄럽으니까」
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「%CALLNAME:MASTER%……좋은 이름이네 HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「그렇게 쳐다보지 마, 흥분해버릴 거야 HPH」","L"
		ENDIF
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「사람과 마시는 경험은 별로 없지만... 좋은 것이네.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「조금 취해 있지만 신경 쓸 필요 없어」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「음... 조금 취했네.」
			PRINTFORMW 「만일의 상황에는 간호해 줘?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「취기가 오르면 무슨 짓을 할지 모르니까... 각오해둬?」
		ELSE
			PRINTFORMW 「너도 마실 수 있는 입이냐? 텐구 사회는 마시지 못하는 자에게 인권이 없으니까.」
		ENDIF
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW 「텐구 사회도 결국 질서의 범위일 뿐, 예를 들면 너에게라도……」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「결국 자유주의 경제도 내버려 두면 파탄 나는 법이니까……」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「정말들, 전부 바보뿐이군... 혹은 허세 가득한 원숭이라거나...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「노리는 귀엽잖아, 부러워」
		ELSE
			PRINTFORMW 「조금 너무 많이 마셨네... 꽤 마셨구나...」
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW 「……음…」
			PRINTFORMW 「너도 마시면 좋겠어, 내가 따라줄까?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「이런 미인과 함께 있으면서 차가운 녀석이군 너는」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「무례하게 행동한다 해도 예의는 있는 편이 좋잖아……」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「샤메이마루 저 녀석도 좀 진지해져야 할 텐데」
		ELSE
			PRINTFORMW 「히메카이도는 좀 진정해 주지 않으면 내 머리가 안 돌아가...」
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW 「음음... 술은 싫을까?」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「너무 흥분하지 마라? 어디서 텐구(날아다니는 존재)가 보고 있을지 모르니까.」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「산의 신의 술도 여러 가지 있지만, 모야지 신사의 그것은... 캐묻는 것은 그만두는 게 좋겠군.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「바깥세상의 술이라는 것도 마셔보고 싶네」
		ELSE
			PRINTFORMW 「술 한 잔이라도 만들면 천공 사회에 혁명을 가져올 수 있을까?」
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「음... 좋은 물이네 HPH」","L"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「까마귀의 흐름? 말도 안 돼, 너랑 만날 거면 몸을 씻어야 하잖아?」
		ELSE
			PRINTFORMW 「이렇게 사람과 함께 목욕하는 것도 나쁘지 않네!」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「봄은 모두 활기차지고 지갑의 끈도 느슨해지니, 비즈니스 찬스네」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「벚꽃이 아름다운 계절이네, 다 같이 꽃놀이나 하자!」
					ELSE
						PRINTFORMW 「이런 계절이야말로 벚꽃으로 한 잔 하는 게 멋지겠어.」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 더우니 개방적이 되어버리네... 다 같이 수영 대회라도 할까!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「여름에는 덥지 않느냐고? 이것도 통풍이 잘 되는 소재이고, 게다가 아래는 얇게 입었으니까.」
					ELSE
						PRINTFORMW 「물놀이하기 좋은 계절이야, 토카시랑 같이 계곡에라도 나가볼까」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「텐구라고 하면 아키지만, 너는 나를 생각해 주었을까?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「단풍의 가을이라고 하면 단풍놀이 투어를 생각하고 있는데, 재미있을까?」
					ELSE
						PRINTFORMW 「가을의 미각도 장사가 되니, 멋대로 산에서 나는 작물을 가져가지 마라.」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「추운 계절에는 다 같이 전골이라도 먹는 게 최고지!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「엣, 재채기!!! 으윽... 재채기가 나와버렸어... 일교차가 심하네」
					ELSE
						PRINTFORMW 「까마귀 천개의 깃털 이불? …… 생각해 둘게」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:5 == 0
						CALL HPH_PRINT,@"「너와 이렇게 함께 있으니 나도 사람의 온기를 원하고 있었다고 느끼는구나 HPH」","L"
					ELSEIF RAND:4 == 0
						PRINTFORMW 「산의 신들에게도 너와의 사이를 놀림 받았어, 아이는 언제 생기려나 같은 건 무례하다고 생각하지 않아?」
						PRINTFORMDW 메구무는 그렇게 말하며 살짝 %조사처리(CALLNAME:MASTER,"의")% 손을 만졌다.
					ELSEIF RAND:3 == 0
						PRINTFORMW 「인간과의 비즈니스도 더 생각해 봐야겠어.」
						PRINTFORMW 「그렇게 되면 네 도움이 필요하게 되니까, 의지하고 있어.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「너와의 관계는 비즈니스가 아니야. 이렇게 대화하는 것만으로도 즐겁거든.」
					ELSE
						PRINTFORMW 「이번에는 산에서 데이트라도 하지 않을래?」
						PRINTFORMW 「다른 텐구들에게 사진 찍히는 게 귀찮아? 신경 쓸 일 없어, 그런 무리들은...」
						PRINTFORMDW 그녀는 그렇게 말하며 삼각대로 톡톡 어깨를 두드리고 있다.
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:5 == 0
						PRINTFORMW 「너도 신문을 써보지 않을래? 뭐야, 재미있는 걸 쓸 수 있으면 내가 밀어줄게!」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「츠카사도 귀엽지만, 당신도 만만치 않아요?」
						PRINTFORMW 「...텐구다운 소리? 그렇게 생각하지 않아, 아첨이나 그런 것도 아니야.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「레세페르도 결국 환상의 산물일 뿐, 누군가의 손길이 개입할 것을 전제로 시장을 움직이는 거야.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「아무리 애를 써도 텐구 사회도 환상향도 좁으니까, 시장을 통제하는 건 쉬운 일이다.」
					ELSE
						PRINTFORMW 「노리는 언제나 나를 위해 암약하고 있지만, 너에게도 장난을 걸 수도 있겠네」
						PRINTFORMW 「내가 너와 친하게 지낸다면…… 어떨까?」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:5 == 0
						PRINTFORMW 「텐구 복장을 입어주길 원해?」
						PRINTFORMW 「……생각해 둘게」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「요즘 바쁘고 어깨가 너무 뭉쳐서 견딜 수가 없어... 별 이상한 곳 보지 말라고?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「텐구 사회는 수직 사회라 고충이 끊이지 않으니까 너와 대화하는 것이 나의 치유가 된 거야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「텐구의 알? ……과연 그렇지만 그렇게 크진 않아」
					ELSE
						PRINTFORMW 「노리는 열심히 일해주지만 말이야, 나도 아무렇지 않게 전선에 나가야 할 일을 하니까 지쳐버려.」
					ENDIF
				ELSEIF CFLAG:2 >= 500
					IF RAND:5 == 0
						PRINTFORMW 「모야지 신사(守矢神社)는 산에 활기를 가져다주는 좋은 거래 상대야.」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「산의 풍기가 문란해졌다고? 뭐, 그쪽이 더 활기차니까 말이야. 그래도 숙청은 필요할까?」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「인간 세상에서도 여러 가지 비즈니스를 하는 사람들이 있으니까 참고가 될 거야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「인간의 시장은 여러 가지 참고가 되네, 우리 텐구들이나 요괴들은 수명이 길어서 어쩔 수 없이 보수적이 되기 쉽거든.」
					ELSE
						PRINTFORMW 「치마타는 금방 시장을 열고 싶어 하니까, 우리에게도 편리하지.」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「무슨 일이야?」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「음, 너랑 이야기하는 건 의외로 재미있네!」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「사람에게도 여러 가지가 있지만... 너는 유독 기묘하구나」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「너무 나랑 이야기하고 있으면 종이 위에 장식될 거야?」
					ELSE
						PRINTFORMW 「가끔은 인간과 이야기하는 것도 즐거운 것이네」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K140_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K140_301
CALL M_KOJO_MESSAGE_COM_K140_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW 「이런 걸 대천공에게 먹인다는 건 무례한 녀석이군」
	ELSEIF TFLAG:193 == -1
		IF RAND:5 == 0
			PRINTFORMW 「……츠카사가 내려준 게 맛있겠네」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응! 찻잎이 나쁜 걸까?」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「다음에 좋은 찻잎을 소개해 줄게, 그러면 더 맛있게 우릴 수 있을 거야?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「인간들 사이에서는 이런 차가 유행하는 거야? 별로 입에 안 맞네……」
		ELSE
			PRINTFORMW 「도, 독특한 맛이네!」
		ENDIF
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「음... 상당히 수고하시네.」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「요괴의 산에서도 또 맛볼 수 없는 맛이군!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「후루룩... 잘한다! 이걸 상품화하는 건 어때?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응, 네가 내려주는 차는 맛있네」
		ELSE
			PRINTFORMW 「대천공이 되어서 딱딱한 다도만 하게 되네」
			PRINTFORMW 「이렇게 편하게 차를 타주는 건 노리와 너 정도뿐이야」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K140_302
;成否判定
