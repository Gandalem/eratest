;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K140_80
CALL M_KOJO_MESSAGE_COM_K140_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「대천공에게 자위해줬으면 어때」 HPH","L"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「대천공의 손으로 가다니 사치네 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「이렇게 커지는 건 천둥이라도 좀 보기 힘든데 말이야 HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「벌써 나올 것 같아? 괜찮아, 내보내도 HPH」","L"
		ENDIF
		;技巧4以上
	ELSEIF ABL:技巧 > 3
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「좀 익숙해졌지, 응?」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응! HPH 냄새나... HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「후훗, 잘하는 편이잖아 HPH」","L"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「이렇게? 기분 좋게 잘 만들었어?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「정말 대천공에게 자위하게 하다니 말이야」
		ELSE
			PRINTFORMW 「이런 게 좋은 거야?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
