; Modular ERB: 個人口上/140 Megumu [龍]/龍/M_KOJO_K140_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K140_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	CALL M_KOJO_COLOR_K140
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「나에게 거스르다니, 어리석은 자 같으니!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「그럼 나의 시련을 받으러 와라!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「모처럼의 기회다, 실력을 보여주도록 하겠다!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그럼 가볍게 몸을 풀자!」
		ELSE
			PRINTFORMW 「자! 축제의 시간이다!」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	CALL M_KOJO_COLOR_K140
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「무례한 자 같으니.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「이 정도로는 아직 본심은 아닐 거야?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「정말 옷이 더러워지겠네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「나에게 맞을 정도면 실력이 대단하네.」
				ELSE
					PRINTFORMW 「흠, 방심했나?」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……손이 시리네」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「정말 만만치 않은 너는…!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「실력은 있는 것 같네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아직 시작이라고!」
				ELSE
					PRINTFORMW 「츠카사 정도에는 이길지도 모르겠네」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……っ！」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「대천공을 여기까지 몰아넣다니 너는 굉장하구나!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「축제는 이제 막 시작됐어!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「역시 대단하네! 정말 재미있는 인간이야!」
				ELSE
					PRINTFORMW 「후훗, 지고 말지도 모르겠네.」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	CALL M_KOJO_COLOR_K140
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이것에 교훈을 얻었다면 반성하는 거야.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아직 수련이 부족하네.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「결국은 인간이라는 거군.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「어라? 컨디션이 안 좋았던 걸까?」
				ELSE
					PRINTFORMW 「음, 몸 푸는 데 딱이네.」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「너무 사람을 화나게 하지 마라.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「뭐, 이 정도겠지.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「조금은 즐길 수 있었을까」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「백랑천공에게 훈련받는 게 좋겠어, 내가 말해둘게.」
				ELSE
					PRINTFORMW 「더 훈련하면 좋아, 그렇게 하면 더 강해질 수 있어」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이걸로 변태가 아니길...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아프다 아파… 역시 대단하네.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「츠카사에게도 배우게 하고 싶은 강함이네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「네 실력이면 산이라도 돌 수 있겠구나!」
				ELSE
					PRINTFORMW 「그 실력이라면 카라스텐구(까치천궁)라도 되어 볼래?」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……」
					PRINTFORMW 메구무는 벌레를 씹어 삼킨 듯한 표정을 하고 있다.
				ELSEIF RAND:4 == 0
					PRINTFORMW 「후훗후 후하다!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「순찰 천궁인가, 신문 기자라도 되어볼래? 너라면 뭐든 할 수 있어」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아팠다... 즐거웠네!」
				ELSE
					PRINTFORMW 「정말... 제법 진심이었단 말이다?」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
