;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	IF FLAG:70
		;	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「음……음음……츠카사 떨어져라……」
		PRINTFORMDW 메구무는 안겨 있으면서 %조사처리(CALLNAME:MASTER,"의")% 체온을 느끼고 있다.
	ELSEIF CFLAG:うふふ == 2
		CALL HPH_PRINT,@"「그렇게 밀착하지 마... HPH」","L"
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「그만둬!」
		PRINTFORMDW 메구무는 쾅 하고 %조사처리(CALLNAME:MASTER,"를")% 밀쳐냈다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「음~ 그렇게 어리광 부리지 마, 계속 떨어지기 싫어지는 HPH」","L"
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"를")% 안아주었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응?」
			PRINTFORMW 「착하다, 응. 애쓰는구나, 너는」
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"에게")% 안기자 기쁜 듯 그렇게 말했다.
		ELSE
			CALL HPH_PRINT,@"「이렇게 안고 있으면 기분 좋아져 온다네 HPH」","L"
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음... 츠카사 같네, 너는」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「어라... 그렇게 꼭 안는 건 혹시 무슨 싫은 일이라도 있었던 거야?」
		ELSE
			PRINTFORMW 「응? 왜 그래? 나보고 보고 싶어졌어?」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「어떻게 된 거야? 꽤 응석을 부리네」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「꽤 대담하네」
		ELSE
			PRINTFORMW 「응~? 무슨 일이야?」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「갑자기 안으면 놀라잖아」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응!? 무슨 일이야?」
		ELSE
			PRINTFORMW 「안아주는 건 괜찮지만 사람들 앞에서 그러지는 말아 줄래?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
