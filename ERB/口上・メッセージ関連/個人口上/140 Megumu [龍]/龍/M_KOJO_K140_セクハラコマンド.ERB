;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K140_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K140_310
CALL M_KOJO_MESSAGE_COM_K140_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K140_5_1
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「그만둬!」
		PRINTFORMDW 메구무는 '바시'하고 %조사처리(CALLNAME:MASTER,"의")% 뺨에 뺨을 때렸다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응! 흐읍」","L"
			CALL HPH_PRINT,@"「정말 너에게 만져지면 젖어버린다... HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「앗 흐읍! 응흐윽...」","L"
		ELSE
			CALL HPH_PRINT,@"「응 HPH 군의 잘못이다, 이렇게 느끼는 건 HPH」","L"
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응!? 이런 곳에서 치한이라니……. HPH」","L"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「！？」
			PRINTFORMW 「정말 큰 하늘의 꼬리를 마음에 들어 한 걸까?」
		ELSE
			PRINTFORMW 「……사람 눈에 띄지 않는 곳이라면 얼마든지 주물러도 되는데 말이야」
			PRINTFORMDW 메구무는 약간 난처한 듯 인적이 없는 곳으로 유인했다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「내 엉덩이는 크다고?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「너무 엉덩이를 만지지 마, 아니면 상품 가치라도 있는 거야?」
		ELSE
			PRINTFORMW 「응? 개한테라도 물렸나?」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「남의 엉덩이를 만지는 건 좋지 않아.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「정말 네 성욕은 하늘을 나는 원숭이 같구나?」
		ELSE
			PRINTFORMW 「그만둬.」
			PRINTFORMDW 메구무는 자신의 엉덩이를 더듬는%CALLNAME:MASTER%손을 뿌리쳤다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
