;==================================================

@M_KOJO_EVENT_K140_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K140
	;仕事中、今日会ってない。
	IF CFLAG:行動 == 5 && !TCVAR:140:今日会ったか
		PRINTFORMW 「음, 미안하지만 지금 수집 중이니까 인사는 간단하게 해줘.」
		;今日会ってない。
	ELSEIF !TCVAR:140:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;正月、バレンタイン、ハロウィン、クリスマスの場合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K140
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「...나는 지금 기분이 너무 안 좋아, 너랑 얘기하고 싶을 정도야.」
				;屋外かつ満月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「안녕, 좋은 달밤이네. 너도 달을 보고 있니?」
				IF TALENT:恋人
					PRINTFORMW 「마치 하늘이 %조사처리(CALLNAME:MASTER,"와")% 나의 관계를 축복해 주는 것 같잖아!」
					PRINTFORMW 「...거짓말 아니야, 내가 기뻐서 그래」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「이렇게 아름다운 우연이 있을 리가, 농담이야」
				ENDIF
			ELSE
				;早朝
				IF TIME:2 == 1 || TIME:2 == 2
					PRINTFORMW 「안녕, 좋은 아침이야, %CALLNAME:MASTER%」
					;昼
				ELSEIF TIME:2 == 3 || TIME:2 == 4
					PRINTFORMW 「안녕, %CALLNAME:MASTER%」
					;夕方・夜
				ELSEIF TIME:2 == 5 || TIME:2 == 6
					PRINTFORMW 「안녕, %CALLNAME:MASTER%」
				ENDIF
				IF TALENT:恋人
