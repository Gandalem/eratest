@M_KOJO_SPEVENT_K140_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K140
	PRINTFORMW 「%CALLNAME:MASTER%, 너랑 데이트한 건 즐거웠어」
	PRINTFORMDW 메구무는 그렇게 말하며 돌아 자신을 향해 몸을 돌렸고―――
	PRINTFORMW 「응……」
	PRINTFORMDW 기세 그대로 그녀는 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗았다.
	PRINTFORMW 「오늘 데이트에 대한 보답, 부족했나?」
	PRINTFORMW 「이것도 대천공의 키스는 비싼 거 알잖아? 그럼 오늘은 이걸로 헤어지자」
	PRINTFORMDW 그녀는 그렇게 말하며 데이트를 끝냈다.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================

@M_KOJO_SPEVENT_K140_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K140
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1140)
			PRINTFORMW 「%CALLNAME:MASTER%, 조금 할 말이 있어」
			PRINTFORMDW 데이트를 마치고 돌아오는 길, 메구무는 %CALLNAME:MASTER%쪽으로 몸을 돌리며 조심스럽게 말을 꺼냈다.
			PRINTFORMW 「처음에는 이상한 사람이라고 생각했어, 내 감은 좋은 편이니까」
			PRINTFORMW 「하지만 사귀면서 나는 너와... 더 함께 있고 싶다고 느끼게 되었어」
			PRINTFORMW 「나는 대천공으로서의 책무도 있고 처지도 있단 말이야」
			PRINTFORMW 「하지만 그것을 모두 버리더라도 너와 함께라면 행복해질 수 있어」
			PRINTFORMW 「건강할 때든 아플 때든 너와 함께라면...」
			PRINTFORMW 「...부디 나와 연인이 되어 주지 않겠니?」
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 너무 나에게 관심을 갖는 건 그만뒀으면 좋겠어」
			PRINTFORMDW 메구무는 가슴에 손을 대고 각오를 다진 듯 말을 이어나갔다.
			PRINTFORMW 「나랑 사귀어 주지 않을래?」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「응, 너라면 나를 받아줄 거라고 생각했어」
		PRINTFORMDW 메구무는 그대로 조금 얼굴을 가까이하고 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 응시했다.
		PRINTFORMW 「죽음이 우리를 갈라놓을 때까지...라고 해도 내가 더 너를 생각하게 될 거야」
		PRINTFORMW 「하지만 그때까지는――」
		PRINTFORMDW 그녀는 그대로 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 입술을 포개고,
		PRINTFORMW 「너와 함께 걷고 싶어」
		PRINTFORMDW 환한 미소를 지으며 떨어져 갔다.
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「후훗, 거절당해 버렸네」
		PRINTFORMDW 메구무는 약간 아쉬운 표정을 지었다.
		PRINTFORMW 「그럼 다음 기회까지 더 친교를 깊게 하자」
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K140_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K140
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……미안하지만 이제 그만할까」
			PRINTFORMDW 메구무는 그렇게 말하고 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「후후, 너와의 데이트는 언제나 즐겁네」
			PRINTFORMW 「그럼 또 보자, 다음엔 어디로 갈까?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「오늘은 이제 끝이지만, 또 데이트에 불러줬으면 좋겠어.」
		ELSEIF TALENT:思慕
			PRINTFORMW 「당신과의 데이트는 즐겁네, 츠카사에게 자랑하겠어.」
		ELSE
			PRINTFORMW 「사람과의 데이트도 즐거운 거네, 오늘은 즐거웠어.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
