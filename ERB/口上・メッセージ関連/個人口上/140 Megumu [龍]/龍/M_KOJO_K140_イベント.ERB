@M_KOJO_EVENT_K140_18(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL M_KOJO_COLOR_K140
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;避妊要求台詞
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:318 == 1
			PRINTFORMW 「네 아이 따위 원하지 않지만」
		ELSEIF TALENT:恋人
			PRINTFORMW 「생으로 하는 게 좋아?」
			PRINTFORMW 「음... 싫지는 않지만, 역시, 그렇지?」
			PRINTFORMDW 메구무는 피임 요구를 했다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……생으로 하는 건 기분 좋을지도 모르지만……」
			PRINTFORMW 「네가 더 훌륭하게 성장해서 보답할 수 있게 되면 해줄게」
		ELSE
			PRINTFORMW 「......적어도 고무를 말이지......」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:318 == 1
			PRINTFORMW 「……안 돼!」
			PRINTFORMDW 메구무는 필사적으로 거절하고 있다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「그래서... 아직 나의 준비가 안 됐어...」
			PRINTFORMDW 메구무는 여전히 거부했다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「그러니까 말이야... 이런 건 제대로 아이를 키울 계획을 세우고...」
			PRINTFORMDW 메구무는 여전히 거부했다.
		ELSE
			PRINTFORMW 「…좀 더 구슬리는 방법을 생각해라」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断ったのに粘られて切れた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「그만해라!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			PRINTFORMW 「만일의 경우엔 책임져 줘?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「그렇게 말한다면…… 하지만 위험일 이외는 안 된다!」
		ELSE
			PRINTFORMW 「……위험한 날은 안 돼!」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			CALL HPH_PRINT,@"「너에게라면 무엇을 당해도 괜찮아... HPH」","L"
		ELSEIF TALENT:恋慕
			PRINTFORMW 「음, 그럼 책임져 줘」
			PRINTFORMW 「이 정도까지 하는 거니까, 응?」
		ELSE
			PRINTFORMW 「그럼, 제대로 책임져 줘.」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
