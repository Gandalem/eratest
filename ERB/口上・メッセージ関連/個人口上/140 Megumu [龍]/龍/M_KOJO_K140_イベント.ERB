;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1
	SELECTCASE ARGS
		CASE "衝突"
			;-------------------------------------------------
			;場外に出てあなたがキャラと衝突した際の台詞
