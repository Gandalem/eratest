				PRINTFORMW 「인기 많네, %CALLNAME:MASTER%」
			ELSE
				PRINTFORMW 「후훗, 방해했네」
			ENDIF
			RETURN 1
		ENDIF
		;その他
		PRINTFORML  
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
