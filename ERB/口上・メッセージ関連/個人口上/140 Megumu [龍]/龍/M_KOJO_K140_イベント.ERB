CALL KOJO_OPTION_ITEM("Megumu's breast size", 1, "onetime", !FIRSTTIME("MegumuBreastSet", 1, 140))
;process the input portion

@KOJO_OPTION_K140_RESULT_1
PRINTFORMDL 메구무는 가슴이 큰가?
CALL ASK_YN("그녀는 위대한 텐구에게 걸맞은 가슴을 가지고 있다.", "그대로 괜찮다")
IF !RESULT
	TALENT:140:バストサイズ = 1
	PRINTFORMDW 메구무의 가슴사이즈가 조정되었다.
ELSE
	PRINTFORMDW 메구무의 가슴사이즈는 변하지 않았다.
ENDIF
CALLF FIRSTTIME("MegumuBreastSet", 0, 140)
