				CALL HPH_PRINT,@"「앗 흐으응! 흐으응! 흐으응」","L"
				PRINTFORMDW 질벽을 끔찍한 페니스로 파고들 때마다 신음 소리를 내며 산모형의 엉덩이가 음란하게 흔들리고 있다.
				PRINTFORMDW 뒤에서 덮치듯 범하고 있는 %조사처리(CALLNAME:MASTER,"의")% 눈에도 비칠 만큼 큰 가슴을 주무를 때마다 질이 조여 %조사처리(CALLNAME:MASTER,"의")% 페니스를 사정에 유도했다.
				CALL HPH_PRINT,@"「앗 흐읍 앗 흐읍 아아아아악 흐읍흐읍흐읍」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 힘차게 정액을 자궁구 쪽으로 사정하자 메구무도 절정에 도달하며 환희의 소리를 지른다.
				CALL HPH_PRINT,@"「후우......큭...큭......큭...큭」","L"
				PRINTFORMDW 메구무는 얼굴을 붉히며 상기된 얼굴로 돌아보니 자신의 질을 범하고 한참 사정 뒤의 페니스를 응시하고 있었다. 메구무는 그것이 자신의 몸과 마음까지 범했던 것인지 감상에 잠겼다.
				PRINTFORMDW 그녀의 남성적인 것을 향해 황홀한 표정을 바라보고 있자 %조사처리(CALLNAME:MASTER,"의")% 가학심은 조금 음경에 단단함을 되찾고 다시 발기를 시작하고 있었다.
				CALL HPH_PRINT,@"「!?......아, 흐읍」","L"
				PRINTFORMDW 메구무의 손질된―지금은 흐트러져 있지만―푸른빛이 도는 검은 머리카락을 잡아, %조사처리(CALLNAME:MASTER,"는")% 그로테스크한 물건을 깨끗하게 하라 말하는 듯 그녀의 입가에 페니스를 가까이 가져갔고
				PRINTFORMDW 그녀는 누군가에게 지시받은 것도 아닌 것처럼 정중하게 손을 대어 성기를 입에 넣었다. 이 강인한 남성의 상징에게 봉사해야만 한다, 그것만이 그녀의 머릿속에 있었다.
				CALL HPH_PRINT,@"「응응! 흐읍! 흐으으~흐읍」","L"
				PRINTFORMDW 요도에 남은 정액을 빨아들이면서 조심스럽게 그녀의 가는 손가락으로 성기를 쓸어 올리자 %조사처리(CALLNAME:MASTER,"의")% 음경은 다시 절정에 도달했고
				PRINTFORMDW 방금 전보다 진한, 커퍼액 없는 순수한 임신액을 메구무의 구강에 쏟아냈다.
				CALL HPH_PRINT,@"「……응! 후우」","L"
				PRINTFORMDW 이미 오나홀로서의 용무는 끝났다고 말이라도 하듯 힘차게 그녀의 입에서 성기를 빼내자, 그녀의 입술과 방금까지 키스를 나누고 있던 페니스 사이에 정액이 실처럼 이어져 거미줄처럼 늘어져 있다.
				CALL HPH_PRINT,@"「………HPHHPHHPH」","L"
				PRINTFORMDW 아쉬운 듯 촉촉해진 표정으로 페니스를 바라보는 그 얼굴은 대천공이 아니라 발정난 암컷이었고, 눈앞의 음경의 노예임을 증명하며 다시 무언가를 기대하듯 메구무는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 올려다보고 있다.
				PRINTFORMDW 그 정액으로 뒤덮인 아주 아름다운 얼굴을 보자 %조사처리(CALLNAME:MASTER,"는")% 메구무를 등을 대고 눕히고, 다시 범하기 시작했다.
				CALL HPH_PRINT,@"「아앗 후후응! 후후우웅! 후후우」","L"
				PRINTFORMDW 목소리조차 내지 못하는 환희의 신음을 지르며 정상위로 범당하고 있는 메구무는 완전히 페니스를 질 안으로 받아들인 채, 다리를 %조사처리(CALLNAME:MASTER,"의")% 허리에 감고 있다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그런 메구무를 밤이 깊도록 만족할 때까지 계속 범했다…….
				;IF CFLAG:318 == 1
				;	PRINTFORMW 「……鬼畜め……」
				;ELSEIF TALENT:恋人
				;	CALL HPH_PRINT,@"「ここまでしたのだから責任は取ってもらいたいのだけど……HPH」","L"
				;ELSEIF TALENT:恋慕
				;	CALL HPH_PRINT,@"「君は天狗よりも性欲が強いな……HPH」","L"
				;ELSEIF TALENT:思慕
				;	CALL HPH_PRINT,@"「……はぁ……HPH……んっHPH」","L"
				;ELSE
				;	CALL HPH_PRINT,@"「……人間とは思えないな……HPH」","L"
				;ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「......그 신경과 성기의 굵기만은 칭찬하고 싶은 것이군......」
				ELSEIF TALENT:恋人
					CALL HPH_PRINT,@"「그대로 같이 자자... HPH」","L"
				ELSEIF TALENT:恋慕
					CALL HPH_PRINT,@"「더 이상 이런 치태를 보게 되는 것도 나쁘지 않겠어... HPH」","L"
				ELSEIF TALENT:思慕
					PRINTFORMW 「......이불은 사용해, 나랑 같이 자고 싶다면 다른 건데?」
				ELSE
					PRINTFORMW 「…마음대로 하면 돼.」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
