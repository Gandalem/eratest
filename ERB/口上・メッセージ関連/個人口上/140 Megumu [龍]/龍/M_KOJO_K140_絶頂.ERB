; Modular ERB: 個人口上/140 Megumu [龍]/龍/M_KOJO_K140_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K140
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 메구무는 절정에 달했다.
	ELSE
		CALL HPH_PRINT,@"「응흐읍 HPH응흐읍 HPH」","L"
		CALL HPH_PRINT,@"「이렇게 많이 나오는 건 너에게 마셔줬으면 좋겠어 HPH」","L"
	ENDIF
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「응! 흐으윽... 아앗!」","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「아앗흐응! 아앗흐응! 아앗흐응!」","L"
			ELSE
				CALL HPH_PRINT,@"「응! 흐으읍...흐으읍...」","L"
			ENDIF
			;中
		CASE 2 TO 4
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「응앗 흐으읍흐으읍」","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「엣, HPH라고 하는 곳을 보지 마! HPH」","L"
			ELSE
				CALL HPH_PRINT,@"「응! HPH 안 돼! HPH」","L"
			ENDIF
			;弱
		CASE 1
			IF RAND:3 == 0
				CALL HPH_PRINT,@"「응! 흐읍」","L"
			ELSEIF RAND:2 == 0
				CALL HPH_PRINT,@"「응응!흐으윽」","L"
			ELSE
				CALL HPH_PRINT,@"「응! 하으윽 잠깐만!」","L"
			ENDIF
	ENDSELECT
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K140
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;あなたが射精したときに関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K140_00
RETURN 0

