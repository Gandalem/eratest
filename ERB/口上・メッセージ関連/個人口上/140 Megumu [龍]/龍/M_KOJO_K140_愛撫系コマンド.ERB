@M_KOJO_MESSAGE_COM_K140_0
CALL M_KOJO_MESSAGE_COM_K140_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「더 흥분시켜줘... HPH」","L"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			CALL HPH_PRINT,@"「응! 흐으윽흐윽」","L"
			RETURN 1
		ELSE
			CALL HPH_PRINT,@"「음응! 흐읍! 아앗! 흐읍!」","L"
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			CALL HPH_PRINT,@"「오옷 ㅎㅍㄴ앗 ㅎㅍ」","L"
			RETURN 1
		ELSE
			CALL HPH_PRINT,@"「음응흐읍아앗흐읍」","L"
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응! 흐으윽 더!! 흐으윽」","L"
			CALL HPH_PRINT,@"「더 괴롭혀줘 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응! 흐으, 더 만져줘! 흐으」","L"
		ELSE
			CALL HPH_PRINT,@"「아앗 흐읍! 아앗 흐읍!」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
