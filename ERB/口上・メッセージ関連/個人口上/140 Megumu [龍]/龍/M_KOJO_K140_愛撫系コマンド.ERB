;==================================================
;19,キスする
;==================================================

@M_KOJO_MESSAGE_COM_K140_19
CALL M_KOJO_MESSAGE_COM_K140_19_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_19_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;これ継続キスだから初めてはおかしいと思う。一応通常キスのコピペ。
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「응... 다정한 맛이 나네 HPH」","L"
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응흐읍 HPH응흐읍 HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「음~~~~ HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「응! 흐읍」","L"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응! 흐읍」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응응 흐으읍 흐으읍」","L"
		ELSE
			CALL HPH_PRINT,@"「응응!흐으윽」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
