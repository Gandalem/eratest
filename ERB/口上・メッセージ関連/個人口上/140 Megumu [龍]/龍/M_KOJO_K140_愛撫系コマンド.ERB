	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「응! HPH 핥아도 돼 HPH」","L"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「응! 끅, 간지러워어어어어어어어어어어어어어어어어어어어어어어어어어어어어어어어어어어」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「앗 흐으응흐읍흐읍」","L"
		ELSE
			CALL HPH_PRINT,@"「응! 흐으윽 더!! 흐으윽」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
