;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K140_140
CALL M_KOJO_MESSAGE_COM_K140_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「응으음~!」
		CALL HPH_PRINT,@"「응앗... 억지로라니... HPH」","L"
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「음~~~~ HPH」","L"
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목으로 능숙하게 그것을 부추긴다.
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응헉헉앗헉」","L"
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목으로 능숙하게 그것을 부추긴다.
		ELSE
			CALL HPH_PRINT,@"「응응ㅎㅍㅎ응응」","L"
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 목으로 능숙하게 그것을 부추긴다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음~!」
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 박히고 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응음~~~~!!!」
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 박히고 신음하고 있다.
		ELSE
			PRINTFORMW 「음~~!!!」
			PRINTFORMDW 메구무는 %조사처리(CALLNAME:MASTER,"에게")% 음경을 박히고 신음하고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
