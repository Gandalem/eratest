;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K140_150
CALL M_KOJO_MESSAGE_COM_K140_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K140_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CALL M_KOJO_COLOR_K140
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL HPH_PRINT,@"「음... 강행이네 HPH」","L"
		RETURN 1
	ENDIF
	;基本セット
	;胸3以上
	IF ABL:胸 > 2
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「억지로 하는 만큼 내 가슴은 좋았을까 HPH」","L"
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응응... 그렇게까지 가슴이 좋아?」
		ELSE
			CALL HPH_PRINT,@"「응! HPH 강제로 당하는 거 좋아할지도 몰라... HPH」","L"
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			CALL HPH_PRINT,@"「그렇게 강압적으로 하지 않아도 가슴은 도망가지 않는데... HPH」","L"
		ELSEIF RAND:2 == 0
			CALL HPH_PRINT,@"「응! 맘대로 해, 가슴을 범해줘!」","L"
		ELSE
			CALL HPH_PRINT,@"「그런 짓을 하지 않아도 대천공의 가슴은 네 것이야 HPH」","L"
		ENDIF
	ENDIF
ENDIF
RETURN 1
