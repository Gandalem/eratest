@M_KOJO_EN01_CHECK_K119_DAYEVENT_COND(ARGS, ARG, ARG:1)
SELECTCASE ARG
	CASE DAYEVENT_GENERAL ;initial, if the function is allowed to run at all
		SIF MARK:反発刻印 || CFLAG:ブチギレ
			RETURN -1
		SIF ARGS == "day" && CFLAG:初期位置 == CFLAG:MASTER:初期位置 ;Nemuno's morning events can trigger every day like it was before
			RETURN 2
	;per event
	CASE DAYEVENT_WAKEUP
		SIF !TALENT:恋人
			RETURN -1
		RETURN 1
	CASE NIGHTEVENT_DRINK
		SIF !(ABL:奉仕精神 >= 3 && EXP:奉仕快楽経験 >= 50)
			RETURN -1
		SIF (TALENT:妊娠 || TALENT:育児中)
			RETURN -1
		SIF	CFLAG:2 < 1500 ;allowed without love
			RETURN -1
		RETURN 1
	CASE NIGHTEVENT_MOONVIEWING, NIGHTEVENT_SLEEPOVER
		SIF !TALENT:恋慕
			RETURN -1
		RETURN 0 ;normal condition
	CASEELSE
		RETURN -1 ;no dialogue
ENDSELECT
RETURN 0

