RESULTS = _EN01
RESULTS:1 = /EGG/
RESULTS:2 = English OC.<br>A shy, kindhearted old lady with a lot of insecurities about her body.<br>Has a lot of lines for child PCs, but no /ss/ or /ll/ content.<br>Medium line count.
RETURN 1
