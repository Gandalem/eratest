@M_KOJO_EN01_SPEVENT_K119_7(ARG,ARG:1)
;口上主はTARGET
;共通メッセージ出力
;--------------------------------------------------
;The character has a drink with the player
;晩酌
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 1
	SELECTCASE IFRAND("0TO1", TALENT:119:恋人, "2", 1)
		CASE 0
			PRINTFORMW 「술을 너무 많이 마신 뒤에 네게 갚아야 할 것 같은 기분이 들어.」
			PRINTFORMW 「돈은 없지만, 대신 몇 끼 식사를 차 줄 수는 있어.」
			PRINTFORMDW 네무노가 희미하게 웃는다.
			PRINTFORMW 「아니면 어쩌면...」
			PRINTFORMDW 그녀는 너의 허벅지에 손을 올려 너의 사타구니 쪽으로 천천히 미끄러뜨리기 시작한다.
		CASE 1
			PRINTFORMW 「헤헤... 이 늙은 아줌마를 봐줘서 고마워.」
			PRINTFORMDW 네무노가 두 분이 같은 병을 나눠 마시자고 주장했다.
			PRINTFORMW ("우린 사귀는 사이잖아, 그렇지? 적어도 간접적인 키스는 나눠야지.")
		CASE 2
			PRINTFORMW 「아... 딱이야.」
			PRINTFORMDW 네무노는 컵을 내려놓고 당신에게 미소 짓는다.
			PRINTFORMW 「또 마실래? 밤은 아직 젊으니까...」
	ENDSELECT
	RETURN 1
ENDIF
;--------------------------------------------------
;The character invites the player to go moon-viewing
;夜風に当たる、お月見（分岐条件はEVENT_MESSAGE.ERB 377行目あたりを参照下さい）
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 2
	SELECTCASE IFRAND("0", TALENT:119:恋人, "1TO2", 1)
		CASE 0
			PRINTFORMW 「오늘 달 참 예쁘지, 안 그래?」
			PRINTFORMDW 네무노가 당신의 손을 잡는다.
			PRINTFORMW 「하지만 그건 당신만큼 아름답지는 않아...」
		CASE 1
			PRINTFORMW 「단고 더 먹을래? 잔뜩 있어.」
			PRINTFORMW 「사실, 너무 많이 만들었을지도 모르겠네...」
		CASE 2
			PRINTFORMW 「사람들이 달에 토끼처럼 생긴 무늬가 있다고 하던 것 같아.」
			PRINTFORMW 「하지만 난 한 번도 그걸 본 적이 없어.」
			PRINTFORMW 「네 눈이 내 눈보다 낫네. 볼 수 있니?」
	ENDSELECT
	RETURN 1
ENDIF
;--------------------------------------------------
;The character slips into the player's bed and falls asleep next to them
;添い寝
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 3
	SELECTCASE IFRAND("0TO1", TALENT:119:恋人, "2", !TALENT:119:恋人)
		CASE 0
			PRINTFORMW 「아우 %HE_SHE(MASTER)% 너무 귀여워 보이다 %HES_SHES(MASTER)% 자고 있을 때.」
			PRINTFORMDL 네 옆의 침대로 조심스럽게 기어 올라간다.
			PRINTFORMDW 그러자 그녀는 이불을 네 턱까지 끌어올리고 네 뺨에 입맞춘다.
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 「잘 자. 아침에 봐!」라고 말한다.」
		CASE 1
			PRINTFORMW 「헤헤... 여전히 누군가와 침대를 나눠 쓰는 건 이상해. 심지어 내 연인하고도!」
			PRINTFORMW 「내 연인이...」
			PRINTFORMDW 네무노는 혼자 미소 지었다.
		CASE 2
			PRINTFORMDW 네무노는 잠든 당신의 모습을 응시한다.
			PRINTFORMW 「가고 싶은데... 만약 %HE_SHE(MASTER)%이 나와 같은 침대에서 자길 원치 않으면 어떡하지?」
			IF CFLAG:119:既成事実 & 合意_うふふ
				PRINTFORMW 「우리가 사랑을 나눴다는 건 알지만... 만약 %HE_SHE(MASTER)%이 나를 그냥 섹프라고 생각한다면?」
			ELSEIF EXP:119:デート経験
				PRINTFORMW 「데이트는 해봤지만... 혹시 내가 너무 성급하다고 %HE_SHE(MASTER)%이 생각하면 어떡하지?」
			ELSE
				PRINTFORMW 「우리가 많은 시간을 함께 보냈다는 건 알지만... 만약 %HE_SHE(MASTER)%이 나를 그저 친구로만 본다면 어떡하지?」
			ENDIF
			PRINTFORMDW 그녀는 무엇을 해야 할지 결정하려 당신을 응시하다가, 이내 얼굴을 찡그리며 고개를 젓는다.
			PRINTFORMW 「뭐 %HE_SHE(MASTER)%이 하든 상관없어! 언젠가 %HIM_HER(MASTER)%에게 내가 마음에 있다는 걸 알려야 해!」
			PRINTFORMDW 네무노는 조심스럽게 당신 옆 침대에 몸을 눕힌다. 그녀는 편안한 자세를 찾기 위해 잠시 움직인다.
			PRINTFORMW 「아, 이 침대 너무 작잖아... 이런 곳에서 어떻게 자라는 거야?」
			PRINTFORMDW 그녀가 다시 나가려던 순간 당신이 꿈속에서 무언가를 중얼거리며 몸을 뒤척이고 팔을 그녀에게 걸었다.
			PRINTFORMDW 그녀는 얼굴이 새빨개진다.
			PRINTFORMW 「저... 저! 지금 이 침대에서 빠져나갈 수가 없잖아...」
			PRINTFORMDW 네무노는 부드럽게 당신의 손 위에 자신의 손을 얹고 눈을 감는다.
			PRINTFORMW 「하지만 이렇게 심장이 두근거리면서 잠들어야 할지 모르겠어...」
	ENDSELECT
	RETURN 1
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT" events
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;Encountering the character in a room
;部屋で遭遇
;==================================================

@M_KOJO_EN01_EVENT_K119_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The player enters a room the character's in
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		CALL K119_PLAYER_ENCOUNTERS_NEMUNO(0)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character enters a room the player's in
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		CALL K119_PLAYER_ENCOUNTERS_NEMUNO(1)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character enters a room the player's bathing in and joins them in the bath
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「자, 이제... 좋은 때를 만들어 줄 만큼 아이들을 많이 키웠어.」
				PRINTFORMW 「네 등을 내가 닦아줄게, 자기야....」
			CASE 1
				PRINTFORMW 「이 목욕탕은 내 영역이지만... 너랑 나눠 써도 상관없어.」
			CASE 2
				PRINTFORML 「뭐라고? 아니, 내 도끼 치우지 않을 거야!」
				PRINTFORMW 「만약 어떤 변태 요괴가 너를 나한테서 빼앗으려고 하면 어떡해?!」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character enters a room the player's bathing in and leaves
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF IS_CHILD(MASTER)
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「엄마랑 목욕하기엔 너무 나大了? 알았어, 너 혼자 하게 둘게.」
				CASE 1
					PRINTFORMW 「이제 스스로 몸을 씻을 나이가 됐지? 헤헤, 애들은 정말 빨리 크는구나...」
				CASE 2
					PRINTFORMW 「알아두라고 말하는데, 네 귀 뒤를 확인해 줄 거야... 그리고 아직 더러우면 다시 목욕시켜 주겠어!」
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「앗! 미안해!」
				CASE 1
					PRINTFORMDL 네무노는 얼굴을 새빨갛게 물고 얼어붙더니 당신에게 말을 건다.
					PRINTFORMDW 그러더니 그녀는 더듬거리며 사과하고 도망쳐 사라진다.
				CASE 2
					PRINTFORMW 「저기... 음, 그러니까, 당신이 안에 있는 줄 몰랐어요!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「아! 죄송해요!」
				CASE 1
					PRINTFORMW 「또 강에서 목욕해야겠군...」
				CASE 2
					PRINTFORMW 「네 영역에 침범하려던 건 아니었어. 이제 가볼게.」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character enters a room the player's bathing in and kicks them out of the bath
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF IS_CHILD(MASTER)
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「미안해, 얘야, 하지만 엄마가 목욕해야 해.」
					PRINTFORMW 「그리고 너도 그녀와 함께 조금 나이가 들고 있잖아.」
				CASE 1
					PRINTFORML 「걱정 마, 금방 할게.」
					PRINTFORMW 「그리고 떠나기 전에 뜨거운 물 좀 더 데워줄게.」
				CASE 2
					PRINTFORMW 「알고 있어, 알고 있지만... 강에서 목욕하는 것에 질렸어.」
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「나-같이 목욕하는 건 옳지 않아!」
					PRINTFORMW 「내 말은, 싫지는 않지만...」
					PRINTFORMDW 네가 네무노가 더 이상 창피해지기 전에 떠난다.
				CASE 1
					PRINTFORMW 「저희에 대해 사람들이 수군거리는 건 정말 싫어요, 아시잖아요?」
				CASE 2
					PRINTFORMW 「이리 와봐, 이젠! 나 같은 노파를 알몸으로 보고 싶지 않을 거잖아?」
					SIF CFLAG:119:既成事実 & 合意_うふふ
						PRINTFORMW 「우리 사랑하는 건 달랐잖아, 알겠지?!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「미모에 앞서는 나이, 사람들이 말하길.」
				CASE 1
					PRINTFORML 「강에서 목욕하는 건 지긋지긋해.」
					PRINTFORMW 「밖에 다른 목욕탕도 많아. 네가 원하는 걸 찾아봐.」
				CASE 2
					PRINTFORML 「부디 나 같은 불쌍한 할미를 위해 목욕을 포기해 주시겠지, 안 그래?」
					PRINTFORMDW 네무노는 그녀의 도마 손잡이에 손을 올렸다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Encountering the player while they're outside
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Encountering the player while they're on a date with another character
	;ARG:1 is the person the player's on a date with (if you want to have custom dialogue
	;for dating a specific character in front of this character, etc)
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF IS_CHILD(MASTER)
			SELECTCASE ARG
				CASE 14 ;Cirno
					PRINTFORMW 「음, 음, 음, 전설의 지배자가 반려를 찾았군.」
					PRINTFORMDW 네무노는 두 분께 깊이 고개를 숙인다.
					PRINTFORMW 「해지기 전에 집으로 돌아가도록 해, 알겠나?」
					PRINTFORMW 「겐소쿄는 어디 가지 않아. 하루 만에 전부 정복할 필요 없어.」
					PRINTFORMDW 그녀는 미소를 감추려고 애쓰는 듯하다.
				CASE 127 ;Eika
					PRINTFORMW 「어이쿠... %CALLNAME:MASTER%에리카쨩이랑 데이트라니?」
					PRINTFORMDW 네무노가 두 사람을 보며 미소 짓는다.
					PRINTFORMW 「다음 커플즈 디비전 경기가 언제인지 알려줘, 알았지? 너희 둘 응원하러 가고 싶으니까!」
				CASEELSE
					IF IS_CHILD(ARG)
						PRINTFORMW 「어? 너희 둘 감기 걸릴까 봐 무서워?」
						PRINTFORMDW 그녀는 킥킥거렸다.
						PRINTFORMW 「농담이야... 재밌게 놀아, 너희 둘!」
						PRINTFORMW 「하지만 너무 늦게까지 밖에 있지 마!」
					ENDIF
			ENDSELECT
		ELSEIF GROUPMATCH(ARG, 4, 26, 32, 55, 66, 68, 72, 102, 112, 124, 138) ;Mima, Yukari, Kanako, Byakuren, Yuyuko, Yuuka, Eirin, Shinki, Junko, Okina, Misumaru
			PRINTFORMDL 네무노는 %CALLNAME:ARG%을 노려본다.
			PRINTFORMW (저런 나이의 사람이 %CALLNAME:MASTER%같은 미남을 어떻게 사게 된 거지?)
		ELSEIF TALENT:ARG:妖怪 == 5 ;tengu
			PRINTFORML 「안녕, %CALLNAME:MASTER%!」
			PRINTFORMW 「...안녕, %CALLNAME:TARGET%.」
			PRINTFORMDW 네무노는 그녀에게 미간을 찌푸렸다.
		ELSE
			SELECTCASE ARG
				CASE 128 ;Urumi
					PRINTFORMW 「오! 너희 둘 데이트 중이야?」
					PRINTFORMDW 네무노는 미소 짓지만 \@ TALENT:119:恋慕 && !TALENT:119:恋人 ? , 하지만 그녀는 조금 슬퍼 보였다. # . \@
					IF TALENT:119:恋慕 && !TALENT:119:恋人
						PRINTFORMW (포기해야겠지, 응?)
						PRINTFORMW (%조사처리(CALLNAME:MASTER,"가")% 나 때문에 우루미에게 넘어갈 리가 없어...)
						PRINTFORMW (%HE_SHE(MASTER)%가 그렇다고 해도, 우루미는 분명 %HIM_HER(MASTER)%에게 완전히 반해있잖아.)
						PRINTFORMW (나는 친구의 행복을 망치지 않을 거야.)
					ELSE
