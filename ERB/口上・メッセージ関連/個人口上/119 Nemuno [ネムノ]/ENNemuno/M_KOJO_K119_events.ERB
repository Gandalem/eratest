;==================================================
;Confessing on the way home from a date
;デート帰りに告白（恋人が付く）
;==================================================
@M_KOJO_EN01_SPEVENT_K119_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;Confession
	;After this dialogue is displayed, the player will have a choice to become the character's lover or turn them down.
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMDW Nemuno looks like she has something on her mind.
		PRINTFORMDW She keeps glancing at you, blushing, and looking away again.
		PRINTFORMW 「You're about to ask her if something's wrong when she stops walking and puts a hand on your shoulder.」
		PRINTFORMW 「Hey, %CALLNAME:MASTER%...」
		PRINTFORMDW You turn to look at Nemuno. She's blushing harder than ever, and her hair's hanging over her eyes.
		PRINTFORMDW She swipes it away and takes a deep breath.
		PRINTFORMW 「D'ya... wanna start goin' steady?」
		PRINTFORMDW She swallows nervously.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Confession accepted (player and character become lovers)
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「Y... Y'really mean it?!」
		PRINTFORMDW You take her hand and nod.
		PRINTFORMDW Nemuno looks like she's about to start hyperventilating.
		PRINTFORMW 「Gods... I never thought this day'd come...」
		PRINTFORMW 「Thank you, %CALLNAME:MASTER%. No...」
		CALL HPH_PRINT, @"「Thank you, darlin'HPH」", "W"
		PRINTFORMDW Nemuno embraces you and joins her soft lips to yours.
		CALL MUTUAL_KISS()
		PRINTFORMDW You stay like that for a long time before Nemuno breaks the kiss and pulls away from you.
		PRINTFORMW 「Wow... it really does feel different when you're \@ IS_MALE(MASTER) ? boyfriend and girlfriend # girlfriends\@.」
		PRINTFORMW 「Wonder if the next kiss'll feel different too?」
		PRINTFORMDW .....
		PRINTFORMDW ...
		PRINTFORMDW .
		CALL AddEXP("愛情経験", MASTER, 10) 
		CALL AddEXP("愛情経験", ARG, 10) 
		PRINTFORMDW The two of you have kissed so many times you're getting lightheaded. Nemuno notices and giggles.
		PRINTFORMW 「I could keep goin', honestly...」
		PRINTFORMW 「But at my age I shouldn't be spendin' all night makin' out with my beau.」
		PRINTFORMW 「C'mon, darlin', let's get goin'. The night's still young...」
		PRINTFORMW 「The first night of the rest of our lives together!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Confession rejected
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「...」
		PRINTFORMW 「...I knew it.」
		PRINTFORMW 「...I knew I was too damn old n' ugly to find a lover.」
		PRINTFORMDW Nemuno turns away from you and hangs her head.
		PRINTFORMDW For a moment, she just stands there. Then she begins to run.
		PRINTFORMDW As she vanishes into the distance, you think you can hear her sob.
		CFLAG:119:現在位置 = KICKOUT()
		PRINTFORML
		PRINTFORMDW ―Nemuno will not attempt to confess to you again―
		SETBIT CFLAG:13, 1
		RETURN 1
	ENDIF

ENDIF
RETURN 1

