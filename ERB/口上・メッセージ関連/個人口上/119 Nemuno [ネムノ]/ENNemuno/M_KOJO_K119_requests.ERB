; Modular ERB: 個人口上/119 Nemuno [ネムノ]/ENNemuno/M_KOJO_K119_requests.ERB
;==================================================
;Common Request Dialogue
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_EN01_IRAI_K119(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
;The character making the request
#DIMS SCENE    ;セリフの表示されるタイミング
;When the dialogue appears
#DIM  IRAI_ID  ;依頼自体のID
;The request ID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;The requestee's ID
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
;The request type ID (cut some wood, water my flowers, etc.)
#DIMS IRAI_NAME;依頼名
;The name of the request
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_EN01_IRAI_%IRAI_NAME%_K119(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_EN01_IRAI_{CHK_ID}_K119(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;Here is the common opening statement for each request.
;If you display the common comments for each request, the common comments will not be displayed.
;The items circled by [ ] are the background sentences before and after the opening remarks and the processing that takes place.
;Please use this as a guideline for whether to WAIT or not (L and W stand for PRINTFORML and PRINTFORMW, respectively).
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		; ●When a request is made to you.
		; [w It seems that [she] has a favor to ask of [you].
		;-◆Dialogue
		; [Request Data Display].
		; [INPUT (Do you accept the request? Y/N)].
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		IF IS_CHILD(MASTER)
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「이거 좀 도와줄 수 있겠니?」
				CASE 1
					PRINTFORMW 「너에게 할 일들이 좀 있어.」
				CASE 2
					PRINTFORMW 「나한테 부탁 하나 좀 들어줄래.」
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「나 좀 도와줄 수 있어?」
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:セフレ || TALENT:[[ネムノ]]:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「아직 젊구나. 나를 위해 작은 거 좀 해 줄 수 있겠니?」
					SIF TALENT:MASTER:年齢 == 2
						PRINTFORMW 「아, 그런 소리 하지 마! 난 당신보다 나이가 많다고!」
				CASE 1
					PRINTFORMW 「도움이 필요해.」
					PRINTFORMDW 네무노는 당신의 표정을 보고 한숨을 쉬며 도끼를 집어넣는다.
					PRINTFORMW 「그렇게 할 수는 없다고, 이 바보야!」
				CASE 2
					PRINTFORMW 「나 좀 도와줄 수 있겠어?」
					PRINTFORMW 「걱정 마, 공짜로 해 줄 거 기대 안 하니까.」
			ENDSELECT
		ENDIF
		;●[366] When doing "Listen to Request" after accepting the request
		;◆Dialogue
		;-[Request Data Display].
		;[INPUT (Discard or Y/N)].
	CASE "依頼非受託時"
		;●When you saw only the contents and did not accept the request.
		;- [L [you] politely declined
		;-◆Dialogue
		;W She looks disappointed.
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
	CASE "依頼受託時"
		;●When [you] accepted [her] request
		;W [you] accepted [her] request
		;- [◆Dialogue
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		IF IS_CHILD(MASTER)
			PRINTFORML 「이제 잊지 마, 알겠지?」
			PRINTFORMW 「네 나이 정도면 아직 기억력이 좋을 텐데!」
		ELSEIF TALENT:[[ネムノ]]:恋人
			CALL PRINT_STRL, @"「멋지고 책임감 있나? 내가 너한테 빠진 것도 당연해.」"
		ELSE
			PRINTFORMW 「좋아, 다 되면 알려줘.」
		ENDIF
	CASE "依頼確認時"
		;●[366] When doing "Listen to Request" after accepting the request
		;◆Dialogue
		;-[Request Data Display].
		;[INPUT (Discard or Y/N)].
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		IF IS_CHILD(MASTER)
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「잊었어?」
					PRINTFORMDW 네무노가 미간을 찌푸린다.
					PRINTFORMW 「하지만 학교에서 아주 잘하고 있잖아!」
				CASE 1
					PRINTFORMW 「이번엔 적어두는 게 좋을 거야.」
					PRINTFORMW 「자꾸 잊어버리는 버릇을 들여서는 안 되니까.」
				CASE 2
					PRINTFORMW 「걱정 마, 난 너한테 화 안 났어.」
					PRINTFORMW 「하지만 이번 일은 기억해 둬, 알았지?」
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「잊었어?」
					PRINTFORMDW 네무노가 한숨을 내쉰다.
					PRINTFORMW 「우리 기념일 잊지 말아야 할 텐데...」
				CASE 1
					PRINTFORMW 「키스 한 번이 네 기억을 되살릴지도 모르지~?」
					PRINTFORMW 「안 돼? 어쨌든 내가 키스해도 상관없어?」
				CASE 2
					PRINTFORMW 「알았어, 다시 말해 줄게.」
					CALL HPH_PRINT, @"「하지만 네가 너무 귀엽기 때문에 말이야.」", "W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「그 기억을 다듬어야 할 거야.」
				CASE 1
					PRINTFORMDW 네무노가 팔짱을 낀다.
					PRINTFORMW 「이번엔 꼭 적어둬. 다시는 말 안 해줄 거니까.」
				CASE 2
					PRINTFORMW 「좋아, 다시 말해 주지.」
					PRINTFORMW 「하지만 이번엔 잘 들어야 해, 안 그러면 내 스튜에 들어갈 테니까!」
			ENDSELECT
		ENDIF
	CASE "依頼破棄時"
		;When you cancel a request you have been entrusted with.
		; [◆Dialogue].
		; W I have discarded the request.
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		IF IS_CHILD(MASTER)
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「지키지 못할 약속은 하지 말아야 해.」
					PRINTFORMDW 네무노는 실망한 듯 보인다.
				CASE 1
					PRINTFORMW 「너무 어려웠나? 생각했던 것보다...」
				CASE 2
					PRINTFORML 「정말?」
					PRINTFORMDW 네무노는 얼굴을 찌푸린다.
					PRINTFORMW 「내가 너를 그 정도까지 키우지는 않았다고 생각했는데.」
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「도와주겠다고 말해놓고 왜 안 하는 거야?」
					PRINTFORMW 「할 생각이 없다면 그냥 그러지 않겠다고 말해.」
				CASE 1
					PRINTFORMW 「좋아. 그럼 내가 직접 할게.」
				CASE 2
					PRINTFORMW 「부모님께서 "지킬 마음 없는 약속은 하지 마라"고 한 적 없었나?」
					PRINTFORMDW 네무노가 얼굴을 찌푸린다.
			ENDSELECT
		ENDIF
	CASE "依頼実行直前"
		;●[367]で依頼を実行する時、実行処理の前に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【◆口上】
		;【実行時の地の文・ソース等】
		;【▼下の口上に続く】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		ENDIF
	CASE "依頼実行直後"
		;●[367]で依頼を実行する時、実行処理の後に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【▲上の口上から続き】
		;【◆口上】
		;【達成時・CLIENT：▼下の口上に続く】
		;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ENDIF
	CASE "成功報告時"
		;Success
		;When the request is completed and reported: Continued from the above dialogue.
		;[◆Dialogue]
		; [Obtaining a source, obtaining a reward such as an item, etc.].
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		IF IS_CHILD(MASTER)
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「할 수 있을 줄 알았어.」
					PRINTFORMDW 네무노가 당신의 머리를 쓰다듬는다.
				CASE 1
					PRINTFORMW 「고마워요, %CALLNAME:MASTER%.」
					PRINTFORMDW 가끔 정말 피곤해질 때가 있어요. 당신처럼 저를 도와줄 사람이 있다는 것에 감사해요.
				CASE 2
					PRINTFORMW 「네가 자랑스러워.」
					PRINTFORMDW 네무노가 너를 향해 미소 지었다.
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「너를 단 한순간도 의심한 적 없어.」
					PRINTFORMDW 네무노가 당신에게 미소 짓는다.
				CASE 1
					PRINTFORMW 「보너스 보상을 해 줄게...」
					PRINTFORMDW 네무노는 앞으로 몸을 숙이며 당신에게 깊고 열정적인 키스를 한다.
					CALL MUTUAL_KISS
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「고마워요. 고맙게 생각해요.」
				CASE 1
					PRINTFORMW 「고마워, %CALLNAME:MASTER%.」
					PRINTFORMW 「내가 살고 있는 곳처럼 아무 데나 있으면 도움을 청하기란 쉽지 않거든.」
				CASE 2
					PRINTFORMW 「나 대신 그것을 돌봐줘서 고마워.」
			ENDSELECT
		ENDIF
	CASE "失敗報告時"
		;When a report is forgotten or expired, it is called up at the end of the encounter.
		;(During the encounter) [Greetings, etc.] → [Good or Bad Mood] → [Detection of Inferiority] → [Holiday Event] → [◆Coco! (In addition, the date invitation will not occur if the request is judged to have failed.)
		;◆Dialogue
		;(If the request is judged as a failure, a date invitation will not occur)
		; ○ Change of mood, additional penalties, etc. should be handled by the dialogue.
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
		;I don't think this is used anymore
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
ENDSELECT
RETURN 1
;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================

@M_KOJO_EN01_IRAI_1_K119(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼02：お花に水をあげて
;==================================================

@M_KOJO_EN01_IRAI_2_K119(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;【◆口上】
		;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
		;【▼そのまま下の口上へ】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			;この場合はそのまま下の口上へ続きます
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼03：いっしょにあそぼ
;※この依頼は[幼稚]を持っているキャラのみ発生します
;==================================================

@M_KOJO_EN01_IRAI_3_K119(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
