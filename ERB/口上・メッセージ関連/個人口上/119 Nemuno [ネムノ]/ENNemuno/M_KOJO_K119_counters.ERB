@M_KOJO_EN01_MESSAGE_COUNTER_K119_11_1
IF TALENT:[[ネムノ]]:恋人
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「도망쳐봤자 소용없어.」
			CALL HPH_PRINT, @"「어디에 숨든 자네를 찾아낼 수 있어 HPH.」", "L"
		CASE 1
