    CASE 152
        IF TALENT:119:恋人
            CALL CHARA_TEXT(152,@"「Nemuno-san! Is it true that you're dating %CALLNAME:MASTER%-san?」","w")
            PRINTFORMW 「That's right.」
            PRINTFORMDW Nemuno puffs out her chest proudly.
            PRINTFORMW 「%CALLNAME:MASTER%'n I are goin' steady, and %HE_SHE(MASTER)% means the world to me.」
            CALL CHARA_TEXT( ,@"「Oh, that's wonderful!」","w")
            PRINTFORMDW Kikuri beams at the two of you.
            CALL CHARA_TEXT(152,@"「Can I bless your marriage when you two get married? I haven't gotten to do it in so long...」","w")
        ELSE
