                PRINTFORMW 「Wh-Whaddya mean? Fer all you know, there might be a %PRINT_MALE("guy", MASTER)% I'm sweet on and I'm just waitin' to find the right way to tell %HIM_HER(MASTER)%!」
                CALL CHARA_TEXT(152,@"「There is?!」","w")
                PRINTFORMDW Kikuri leans out of her mirror with an eager expression on her face.
                CALL CHARA_TEXT(152,@"「Tell me everything!」","w")
                PRINTFORMW 「Hold on, now, I barely know ya!」
            ELSE
                PRINTFORMW 「Oi!」
                PRINTFORMDW Nemuno pulls her cleaver out and glares at Kikuri.
                PRINTFORMW 「I'm perfectly happy bein' single, awright?」
            ENDIF
        ENDIF

    ; CASE CHARANUM-1 ;Mob Girl

    CASEELSE
			;If there's no target character, abort so that another topic can be picked.
        RETURN 0
ENDSELECT
WAIT
RETURN 1

