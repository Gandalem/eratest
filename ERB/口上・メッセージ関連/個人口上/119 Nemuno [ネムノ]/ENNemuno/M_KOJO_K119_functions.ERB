@K119_CONVERSATION_INTERACTION
;Interactions with other characters present in the same location.
#DIM Character

SIF GET_TARGETNUM() < 2
	RETURN 0
DO
	Character = TARGET:RAND(1, GET_TARGETNUM()+1)
LOOP Character == [[ネムノ]]

SELECTCASE Character
	;If there's a target character, display their interaction.

    CASE 1
        PRINTFORMDW Nemuno frowns.
        PRINTFORMW 「Y'really ought to get that outfit o'yers repaired.」
        CALL CHARA_TEXT(1,@"「Huh? What's wrong with it?」","w")
        PRINTFORMW 「Whaddya mean, what's wrong with it?!」
        PRINTFORMDW Nemuno's frown depends.
        PRINTFORMW 「Both of yer sleeves've been torn right off!」
        PRINTFORMW 「Yer lucky that the god you worship ain't smited you!」
        CALL CHARA_TEXT(1,@"「Actually, it's supposed to look like that. The Hakurei Shrine Maidens have worn our outfits that way for millennia.」","w")
        PRINTFORMW 「Huh, really? I ain't never heard of a shrine that did that...」
        PRINTFORMW 「Yer god must have interesting tastes.」

    CASE 2
        PRINTFORMDW Nemuno looks at Ruukoto admiringly.
        PRINTFORMW 「I ain't never seen anyone with skin as smooth as yers. What's yer secret?」
        CALL CHARA_TEXT(2,@"「Well, it's because I'm a robot.」","w")
        PRINTFORMW 「A robot, huh? Do all robots have skin like that, or just you?」
        CALL CHARA_TEXT(2,@"「It really depends. More humanoid ones, like me, will have artificial skin, but industrial robots might not have any skin at all.」","w")
        PRINTFORML 「No skin?!」
        PRINTFORMDW Nemuno's eyes widen.
        PRINTFORMW 「Bet they don't have any trouble scarin' the pants off humans...」
        CALL CHARA_TEXT(2,@"「Huh?」","w")
        PRINTFORMDW Ruukoto looks confused.
        CALL CHARA_TEXT(2,@"「Why would they do that? Industrial robots are made to serve humans.」","w")
        PRINTFORMW 「Shouldn't they have skin, then? Friendly youkai ain't supposed to look scary.」
        CALL CHARA_TEXT(2,@"「Ohh...」","w")
        PRINTFORMDW Ruukoto chuckles.
        CALL CHARA_TEXT(2,@"「No, Nemuno-san, robots aren't youkai. We're a type of machine created by humans.」","w")
        PRINTFORMW 「Really? Well, I'll be... back in my day, the fanciest thing people were doin' with metal was makin' better swords.」

    CASE 3
        PRINTFORMW 「You ain't never had a mom?!」
        CALL CHARA_TEXT(3,@"「Nope.」","w")
        PRINTFORMDW Kana shakes her head.
        CALL CHARA_TEXT(3,@"「The closest thing I ever had to a mom was the girl who created me... and I don't know where she is or what she's doing now.」","w")
        PRINTFORMDW Nemuno looks aghast.
        PRINTFORMW 「That's horrible. No child should ever have t'go through that.」
        CALL CHARA_TEXT(3,@"「It's all right, Nemuno-san.」","w")
        PRINTFORMDW Kana gives Nemuno a reassuring smile.
        CALL CHARA_TEXT(3,@"「I'm happy living at the shrine with Mima-sama and the others.」","w")

    CASE 4
        PRINTFORMW 「Look, Mima, I ain't gonna tell ya again.」
        PRINTFORMW 「You trained Hideto up into a right fine magician, and I'm grateful for that, but stop tryin' to guilt trip him into helpin' you with yer stupid pranks.」
        PRINTFORMW 「I ain't lettin' you get my kids into trouble!」
        CALL CHARA_TEXT(4,@"「I'll do that... when YOU stop guilt tripping him into weeding your garden.」","w")
        PRINTFORMDW Nemuno scowls.
        PRINTFORMW 「That's different, and you know it!」
        CALL CHARA_TEXT(4,@"「Oh? How so?」","w")
        PRINTFORMDW Mima and Nemuno continue arguing...

    CASE 5
        CALL CHARA_TEXT(5,@"「Hey! You're that jerk who never lets her kids play with us!」","w")
        PRINTFORMDW Sunny glares at her.
        PRINTFORMW 「And yer the little brat who's gonna taste one o'my Spell Cards if you don't get outta my face!」
        PRINTFORMDW Sunny mutters something under her breath and flies a safe distance away.

    CASE 7
        CALL CHARA_TEXT(7,  @"「Nemuno-san, that cleaver of yours is so cool! Pleeeeeease?」","w")
        CALL CHARA_TEXT(7,@"「Can I borrow it? Pleeeeeease?」","w")
        PRINTFORMDW Star grabs at Nemuno's cleaver, but she yanks it away and glares at Star.
        PRINTFORMW 「Absolutely not! And yer gonna find it embedded in that thick skull of yers if y'don't behave yerself!」

    CASE 8
        PRINTFORMW 「I ain't never seen yer parents around. Is that Okazaki lady yer mom?」
        CALL CHARA_TEXT(8,@"「Haha, no way!」","w")
        PRINTFORMDW Chiyuri giggles.
        CALL CHARA_TEXT(8,@"「She's my boss!」","w")
        PRINTFORMW 「Yer boss, eh? What all do ya do?」
        CALL CHARA_TEXT(8,@"「Oh, lots of things! Revise her lecture notes, help with her experiments, help maintain the Hypervessel, remind her to eat and sleep...」","w")
        PRINTFORMW 「Hang on, what was that last part?」

    CASE 9
        CALL CHARA_TEXT(9,@"「Hey, Nemuno-san... let me see that cleaver of yours.」","w")
        PRINTFORMW 「Awright, but be careful.」
        PRINTFORMDW Nemuno hands her cleaver over to Yumemi. She examines it closely.
        CALL CHARA_TEXT(9,@"「It's a very impressive piece of work... but wouldn't you rather have a plasma cutter? It can cut things down to the very molecule.」","w")
        PRINTFORMW 「Look, I don't even know what a molecule is. So I ain't got no reason to want one o'them fancy gadgets yer sellin'.」
        PRINTFORMDW Yumemi keeps trying to persuade Nemuno...

    CASE 10
        PRINTFORML 「Umm...」
        PRINTFORMDW Nemuno looks awkwardly at Suika.
        PRINTFORMW （I hope she doesn't realize that one of my kids killed her all those centuries ago...）


    CASE 11
        CALL CHARA_TEXT( ,@"「Do any mushrooms grow in your territory, Nemuno-san?」","w")
        PRINTFORMW 「Ayup.」
        PRINTFORMDW Nemuno nods.
        PRINTFORMW 「There ain't that many, but if yer willin' to hunt 'em down, they taste damn good in a stew.」
        PRINTFORMDW Marisa looks thoughtful.
        CALL CHARA_TEXT(11,@"「I'm not really much of a chef%K11_ZE()%... but I'd love to get my hands on some of them for my experiments!」","w")

    CASE 12
        CALL CHARA_TEXT(12,@"「Nemuno-san, do you have anything to eat? I'm hungryyyy...」","w")
        PRINTFORMW 「Nothin' on me, no, but if you'll come back to my house I can fix you a little something.」
        CALL CHARA_TEXT(12,@"「Yayy! FLESH FLESH FLESH~」","w")
        PRINTFORMW 「O'course, I won't do it fer free. You'll have to clean up the kitchen afterwards.」
        PRINTFORMW 「You young people need to learn the value o'hard work!」
        CALL CHARA_TEXT(12,@"「Is that so-? Never mind then...」","w")
        PRINTFORMDW Nemuno sighs.
        PRINTFORMW 「（Back in my day, youkai weren't so damn lazy...）」

    CASE 15
        PRINTFORMW 「Yer one o'them maids, ain't ya?」
        CALL CHARA_TEXT(15,@"「That's correct. I serve my Mistress, Remilia Scarlet-sama.」","w")
        PRINTFORMW 「They say maids're a kind'a youkai that keep places clean... but I've been around, well, longer'n I care t'admit, and yer the only one I've ever met.」
        PRINTFORMW 「So is that really true?」
        PRINTFORMDW Sakuya tries to hide her amused smile.
        CALL CHARA_TEXT(15,@"「Oh no, Nemuno-san. \"Maid\" is a job, not a species of youkai. I'm just an ordinary human.」","w")
        PRINTFORMW 「Y'work fer a vampire, don't ya? Dunno if that counts as "ordinary"...」
        CALL CHARA_TEXT(15,@"「Touche. An extraordinary human, then.」","w")
        PRINTFORMDW Nemuno nods.
        PRINTFORMW 「So how does an extraordinary human end up workin' for a vampire anyway?」
        PRINTFORMDW Sakuya smiles serenely.
        CALL CHARA_TEXT(15,@"「Ah, well... it's quite a long story. I'd be all day telling it.」","w")
        PRINTFORMDW Nemuno snorts.
        PRINTFORMW 「Pah, y'really think that's an issue?!」
        PRINTFORMW 「To me, a single day's nothing!」
        CALL CHARA_TEXT(15,@"「Did I say a day? No, that's lowballing it. A week, perhaps.」","w")
        PRINTFORMDW Sakuya keeps evading the question...

    CASE 16
        PRINTFORMW 「So when did you n'yer mansion show up in Gensokyo again? 100 years ago? 200?」
        PRINTFORMDW Remilia laughs.
        CALL CHARA_TEXT(16,@"「Hardly. It's only been a few decades.」","w")
        PRINTFORMW 「No kiddin'!」
        PRINTFORMDW Nemuno whistles.
        PRINTFORMW 「I really oughta leave the mountains more...」

    CASE 48
        CALL CHARA_TEXT(48,@"「I just don't get it, Nemuno-san. How can you be happy staying in the same place all the time?」","w")
        CALL CHARA_TEXT(48,@"「I'd go nuts if I could never leave Pandemonium!」","w")
