@M_KOJO_EN01_EVENT_K119_666(ARG, ARG:1)
;口上主はTARGET
;ARGは催眠タイプ（0催眠キャンセル、1反発抑制、2合意誤認、3発情抑制/発情促進、4常識改変）
;ARG:1は催眠結果（-3大失敗、-2大失敗、-1失敗、0キャンセル、1成功、2大成功、3大成功）
;臨時素質（TALENT:反発抑制、TALENT:合意誤認、FLAG:催眠強度）
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF 顔絵付きメッセージ && ARG != 0 && ARG:1 > 0
		PRINTL 
	;催眠タイプ
	SELECTCASE ARG
		;催眠キャンセル　　Hypnosis Cancel
		CASE 0
			;催眠結果　　必ず0である　　そして記入を推奨しない
			;反発抑制　　Resistance Weakened
		CASE 1
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「너 지금 나 더 열 받게 하는 거 알지?」
						CASE 1
							PRINTFORMW 「손가락을 계속 꿈틀거릴 수 없다면, 내가 도와줄 수 있어.」
							PRINTFORMDW 네무노는 자신의 도끼를 꺼낸다.
						CASE 2
							PRINTFORMW 「그 쓸데없는 소리 가지고 시간 낭비하지 말고 그냥 사과하는 게 어때?」
					ENDSELECT
					PRINTFORMW 
					;成功　　Success
				CASE 1
					PRINTFORMW 「음... 모르겠어...」
					PRINTFORMDW 네무노의 흔들림. 그녀의 눈을 들여다보며 제안을 더욱 깊게 한다.
					PRINTFORMW 「오, 대체 뭐야. 딱 한 번은 그냥 넘어가 줄 수 있을 것 같아.」
					PRINTFORMW 「하지만 앞으로는 몸가짐 잘 해야 할 거야!」
				CASE 2, 3
					PRINTFORML 「흐윽, 제발 나한테 울지 마!%COND_STR(" Yer too old for that!", !IS_CHILD(MASTER))%」
					PRINTFORMW 「됐어, 됐어, 용서해 줄게!」
					PRINTFORMDW 네 얼굴에 있는 눈물 아닌 것을 흐트러지 않도록 더러운 손수건을 꺼내 닦아주었다.
			ENDSELECT
			;合意誤認　　Make Sex Acceptable
		CASE 2
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「그게 무슨 농담이야? 난 웃을 리가 없으니까.」
						CASE 1
							PRINTFORMDW 네무노가 당신을 노려본다.
							PRINTFORMW 「그런 더러운 변태짓 하지 마!」
						CASE 2
							PRINTFORMW 「"자위"라는 걸 들어본 적 없으신가요?」
					ENDSELECT
					PRINTFORMW 
					;成功　　Success
				CASE 1
					PRINTFORMW 「뭐... 안 돼, 그에게 그걸 물어볼 수는 없어. %HE_SHE(MASTER)%이 나를 비웃을 거야.」
					PRINTFORMW 「나는 %PRINT_MALE("man", MASTER)%를 얻기엔 너무 지긋한 나이야.」
					PRINTFORMW 「아마 %HIM_HER(MASTER)%에게 직접 묻지 않으면...」
					PRINTFORMDW 네무노가 목을 가다듬었다.
					PRINTFORMW 「저기, 음...」
					PRINTFORMDW 그녀는 침을 삼켰다.
					PRINTFORMW 「있잖아, 나 집에 비상시에 아껴뒀던 빈티지 와인이 좀 있어.」
					PRINTFORMDW 그녀는 잠시 말을 멈추고, 당신의 드레스 안쪽을 똑바로 볼 수 있을 정도로 몸을 앞으로 숙였다.
					PRINTFORMDW 그녀의 손이 당신의 손에 스쳤다.
					PRINTFORMW 「마실래? 나와 너만 둘만의 시간이야.」
				CASE 2, 3
					PRINTFORMDW 네무노의 눈이 풀리며 달콤한 미소가 얼굴에 번진다.
					CALL HPH_PRINT, @"「 %CALLNAME:MASTER%～HPH」", "W"
					PRINTFORMDW 그녀는 손을 뻗어 당신의 허벅지를 쓰다듬기 시작하고, 점점 당신에게 가까이 다가간다 \@ HAS_PENIS(MASTER) ? %FSYN("penis")% # %FSYN("vagina")% \@.
					PRINTFORMW 「있잖아... 여자들은 위에서부터 나이든다고들 하더라.」
					PRINTFORMW 「내 얼굴은 주름지고, 가슴은 처질지도 모르지...」
					PRINTFORMW 「하지만 내 보지는 내가 200살 때만큼 단단하거든.」
					CALL HPH_PRINT, @"「그리고 나를 믿지 않는다면... 내가 직접 보여주는 게 더 기쁠 거야」", "W"
			ENDSELECT
			;発情抑制/発情促進　　Estrus Control
		CASE 3
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2, -3
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2, 3
					PRINTFORML 
			ENDSELECT
			;常識改変　　Common-Sense Control
		CASE 4
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
			;Erogenous Zone Sensitivity
		CASE 5
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
			;Exhibitionist Sense
		CASE 6
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
			;Nudist Sense
		CASE 7
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
			;Hypno-Date
		CASE 8
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
			;Hypno-Orgasm Denial
		CASE 9
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
			;Hypno Trait Alteration
		CASE 10
			;催眠結果
			SELECTCASE ARG:1
				;失敗　　Fail
				CASE -1, -2
					PRINTFORMW 
					;成功　　Success
				CASE 1, 2
					PRINTFORML 
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
