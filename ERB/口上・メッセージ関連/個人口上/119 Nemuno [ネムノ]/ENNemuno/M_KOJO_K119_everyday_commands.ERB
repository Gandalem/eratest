;332,お酒をふるまう
;TFLAG:193(0=下戸飲み成功 -1=下戸飲み失敗 -2=下戸飲み大失敗 -5=下戸飲みあきらめ)
;TFLAG:194(51=どぶろく 52=清酒 53=鬼殺し)
;ALCOHOL_TASTE(TFLAG:194)(15以上=気に入る 9以下=口に合わない)
;==================================================
@M_KOJO_EN01_MESSAGE_COM_K119_332
CALL M_KOJO_EN01_MESSAGE_COM_K119_332_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K119_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL

	IF FIRSTTIME(SELECTCOM)
		IF IS_CHILD(MASTER)
			PRINTFORML 「Ah! Where the hell'd y'get that?!」
			PRINTFORMDW Nemuno snatches the bottle away from you.
			PRINTFORMW 「That's a grownup drink! Kids shouldn't touch it. It's bad for ya!」
			PRINTFORMW 「Oh? Y'just wanted to give me a gift?」
			PRINTFORMW 「I appreciate it... but y'really shouldn't be hangin' around anyone who'd give booze to a kid.」
		ELSE
			PRINTFORML 「Oh? Fer me?」
			PRINTFORMDW Nemuno grins and takes the bottle from you.
			PRINTFORMW 「Real kind of ya. I don't usually get t'drink anything stronger'n water.」
		ENDIF
	ELSE

		IF ALCOHOL_TASTE(TFLAG:194) > 15
			IF TALENT:[[ネムノ]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「Ahh...」
						PRINTFORMDW Nemuno swirls the liquor around in her mouth before she swallows.
						PRINTFORML 「This stuff's great! Here, have a taste...」
						PRINTFORMDW She leans forward and kisses you. You can taste a little of the drink on her lips.
						CALL MUTUAL_KISS
					CASE 1
						PRINTFORML 「This stuff's good! Damn good!」
						PRINTFORMDW Nemuno smiles at you.
						PRINTFORMW 「You spoil me, y'really do...」
					CASE 2
						PRINTFORMW 「Yer taste in booze's almost as good as yer looks...」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW Nemuno throws her head back and chugs her drink down.
						PRINTFORMDW She looks over at you and blushes a little.」
						PRINTFORMW 「I wanted to savor it... but it tasted so damn good I couldn't help myself.」
						PRINTFORMW 「...Y'got any more?」
					CASE 1
						PRINTFORMW 「Yer gonna have some too, ain't ya?」
						PRINTFORMW 「It'd be rude fer me to drink all yer booze myself. Specially when it's this good.」
					CASE 2
						PRINTFORMW 「This stuff's delicious!」
						PRINTFORMW 「Where'd ya get it? I might have t'leave the mountain more often...」
				ENDSELECT
			ENDIF
		ELSEIF ALCOHOL_TASTE(TFLAG:194) < 9
		ELSE
			IF TALENT:[[ネムノ]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 
					CASE 1
						PRINTFORML 
					CASE 2
						PRINTFORML 
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「This stuff ain't half bad.」
						PRINTFORMW 「Go on, pour yerself a glass too.」
					CASE 1
						PRINTFORMDW Nemuno turns to the side and coughs a few times.
						PRINTFORMW 「Hoo-wee.. that stuff's got a real kick t'it...」
					CASE 2
						PRINTFORML 
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
