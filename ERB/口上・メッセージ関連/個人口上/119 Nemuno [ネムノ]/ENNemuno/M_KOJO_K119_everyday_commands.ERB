RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K119_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	IF FIRSTTIME("NemunoCooking")
		PRINTFORML 「Ooh!」
		PRINTFORMDW Nemuno's eyes light up.
		PRINTFORMW 「Y'wanna do some cookin"?」
		PRINTFORMDW She immediately begins opening cabinets and pulling out pans and spices.
	ELSEIF FLAG:料理 == 519 ;Local Mountain Cuisine (Nemuno's special dish)
		IF FIRSTTIME("CookingLMT")
			PRINTFORML 「Y'wanna learn how t'cook my specialty, eh?」
			PRINTFORMDW Nemuno beams at you.
			PRINTFORMW 「It ain't nothin' special. Just local bits n' bobs over wild rice.」
			PRINTFORML 「Now we ain't got most a' the ingredients here, but we can make substitutes...」
			PRINTFORMW 「And I got the most important part on me.」
			PRINTFORMDW She reaches into one of her pockets and sets a crudely carved wooden box on the table.
			PRINTFORMW 「My special spice. Made from all natural mountain herbs.」
		ELSEIF CFLAG:MASTER:現在位置 != 736 ;not in Nemuno's house
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「Lessee here... we ain't got any locust meat, but chicken's pretty close...」
				CASE 1
					PRINTFORML 「Wild rice's better, but we can use domestic.」
					PRINTFORMW 「Just gotta add more spice to make up fer it.」
				CASE 2
					IF ABL:[[ネムノ]]:教養 < 3
						PRINTFORMW 「Adzuki... adzuki...」
						PRINTFORMDW Nemuno's going through everything in the cabinet. Opening them, looking inside, closing, and putting them back.
						PRINTFORMDW Why isn't she just checking the labels?
					ELSE
						PRINTFORMDL Nemuno skims over the labels, takes a jar out of the cabinet, and places it on the counter.
						PRINTFORMDW She turns to you and grins.
						PRINTFORML 「Really can't thank ya enough fer teachin' me how ta read.」
						PRINTFORMW 「This is way faster'n checkin' everything by hand...」
					ENDIF
				CASE 3
					PRINTFORML 「Seriously? They ain't got any nozawana leaf?」
					PRINTFORMDW Nemuno sighs and rubs her forehead.
					PRINTFORMW 「We'll just have to use daikon, then.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0

				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT

		ENDIF
	ELSE
		SELECTCASE IFRAND("0", 1, "1", CFLAG:MASTER:現在位置 != 736)
			CASE 0

			CASE 1
				PRINTFORMW 「Aw, hell... they ain't got a wood stove?」
				PRINTFORMDW Nemuno scowls.
				PRINTFORMW 「Everyone knows you gotta cook on a wood stove t'make yer food taste right.」
			CASE 2
				PRINTFORML 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
