@M_KOJO_EN01_MESSAGE_COM_K119_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	IF FIRSTTIME("NemunoCooking")
		PRINTFORML 「Ooh!」
		PRINTFORMDW Nemuno's eyes light up.
		PRINTFORMW 「Y'wanna do some cookin"?」
		PRINTFORMDW She immediately begins opening cabinets and pulling out pans and spices.
	ELSEIF FLAG:料理 == 519 ;Local Mountain Cuisine (Nemuno's special dish)
		IF FIRSTTIME("CookingLMT")
			PRINTFORML 「내 특선 요리하는 법 배우고 싶어, 응?」
			PRINTFORMDW 네무노가 당신을 향해 활짝 웃는다.
			PRINTFORMW 「별거 아니야. 그냥 야생 쌀 위에 지역에서 나는 것들 좀 올린 거지.」
			PRINTFORML 「우리가 여기 모든 재료를 구하긴 어렵지만, 대체품은 만들 수 있어...」
			PRINTFORMW 「그리고 제일 중요한 건 내가 가지고 있지.」
			PRINTFORMDW 그녀는 주머니에서 손을 넣어 투박하게 조각된 나무 상자를 테이블 위에 놓는다.
			PRINTFORMW 「나의 특별한 향신료야. 순수한 산의 허브로 만든 거야.」
		ELSEIF CFLAG:MASTER:現在位置 != 736 ;not in Nemuno's house
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「이곳의 세입자님께... 메뚜기 고기는 없지만, 닭고기가 아주 비슷합니다...」
				CASE 1
					PRINTFORML 「야생 쌀이 더 좋지만, 국내산도 사용할 수 있어.」
					PRINTFORMW 「그걸 보충하려면 향신료를 더 넣어야 해.」
				CASE 2
					IF ABL:[[ネムノ]]:教養 < 3
						PRINTFORMW 「팥…… 팥……」
						PRINTFORMDW 「팥…… 팥……」
						PRINTFORMDW 왜 그냥 라벨만 확인하지 않는 것일까?
					ELSE
						PRINTFORMDL 네무노는 라벨들을 훑어본 뒤, 캐비닛에서 병 하나를 꺼내 카운터에 놓는다.
						PRINTFORMDW 그녀는 당신에게 돌아보며 씨익 웃는다.
						PRINTFORML 「읽는 법 가르쳐 준 거 정말 고마워.」
						PRINTFORMW 「이거 손으로 전부 확인하는 것보다 훨씬 빠르네...」
					ENDIF
				CASE 3
					PRINTFORML 「정말? 노즈와나잎이 하나도 없어?」
					PRINTFORMDW 네무노는 한숨을 쉬며 이마를 문지른다.
					PRINTFORMW 「그럼 무를 써야겠네.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE IFRAND("0", 1, "1", CFLAG:MASTER:現在位置 != 736)
			CASE 0
			CASE 1
				PRINTFORMW 「아, 제기랄... 장작난로가 없다고?」
				PRINTFORMDW 네무노는 얼굴을 찡그린다.
				PRINTFORMW 「음식 맛을 제대로 내려면 장작난로에서 요리해야 한다는 건 누구나 알잖아.」
			CASE 2
				PRINTFORML 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
