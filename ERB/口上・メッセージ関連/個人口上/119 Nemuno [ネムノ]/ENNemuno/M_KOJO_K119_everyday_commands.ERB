@M_KOJO_EN01_MESSAGE_COM_K119_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 1
			IF TALENT:[[ネムノ]]:恋人
				PRINTFORMDW 네무노가 당신의 차를 한 모금 마신다. %HIS_HER(TARGET,1)% 눈이 빛난다.
				PRINTFORMW 「와, 정말 맛있다! 이거 굉장해!」
				PRINTFORMW 「어디서 그런 수준으로 차 만드는 법을 배웠어?」
			ELSEIF TALENT:[[ネムノ]]:セフレ || TALENT:[[ネムノ]]:愛欲
				PRINTFORML 
			ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
				PRINTFORMW 「이거 굉장하다!」
				PRINTFORMDW 네무노는 %HIS_HER(TARGET)% 컵을 내려놓고 당신에게 미소 짓는다.
				PRINTFORMW 「레슨이라도 받고 있는 거야?」
			ELSE
				PRINTFORMW 「블랙티? 내가 제일 좋아하는 거야!」
				PRINTFORMDW Nemuno는 한 모금 마시고 잠시 동안 %HIS_HER(TARGET)% 입안에서 차를 휘저은 뒤 삼킨다.
			ENDIF
		CASE 0
			IF TALENT:[[ネムノ]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW 네무노가 당신의 손에서 찻잔을 가져가려 몸을 기울이다... 그리고 이마에 키스한다.
						PRINTFORMW 「어우. 나도 나이 들수록 서툴러지는 건가 봐.」
						PRINTFORMDW %HE_SHE(TARGET,1)% 눈을 찡긋한다.
					CASE 1
						PRINTFORMW 「아... 맛있다.」
						PRINTFORMDW 네무노는 잔을 비우고 입술을 축였다.
					CASE 2
						PRINTFORML 「도대체 네 차는 어떻게 항상 이렇게 맛있게 느껴지는 거야?」
						PRINTFORMW 「"'사랑해서 만들었어' 같은 지겨운 소리 하는 거 아니지..."」
				ENDSELECT
			ELSEIF TALENT:[[ネムノ]]:セフレ || TALENT:[[ネムノ]]:愛欲
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 
					CASE 1
						PRINTFORML 
					CASE 2
						PRINTFORML 
				ENDSELECT
			ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「이번엔 무슨 것을 만들어냈을지 빨리 보고 싶어.」
						PRINTFORMDW 네무노가 당신에게 미소 짓는다.
					CASE 1
						PRINTFORMDW 네무노는 당신에게서 잔을 받을 때 잠시 그녀의 손이 당신의 손 위에 머무르는 것 같다.
					CASE 2
						PRINTFORMW 「네가 가는 속도라면, 내가 알기 전에 네 차가 내 것보다 더 좋아질 거야.」
						PRINTFORMW 「너를 이기려면 나도 더 열심히 일해야겠어!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「차, 응? 네가 우린 줄은 몰랐어...」
						PRINTFORMDW 네무노는 당신에게서 찻잔을 받으며 약간 어리둥절한 표정을 짓는다.
					CASE 1
						PRINTFORMW 「흠. 나쁘지 않군.」
						PRINTFORMW 「하지만 차 잎을 열 초 더 우려내면 훨씬 좋을 텐데.」
					CASE 2
						PRINTFORMW 「나한테요? 정말 친절하시네요.」
						PRINTFORMDW 네무노가 당신에게서 찻잔을 가져와 한 모금 마신다.
				ENDSELECT
			ENDIF
		CASE -1
			IF TALENT:[[ネムノ]]:恋人
				PRINTFORMDW 네무노는(가) %HIS_HER(TARGET)% 차를 마시다가 얼굴을 찡그리며 컵을 내려놓았다.
				PRINTFORMW 「에... 다들 컨디션이 안 좋은 날이 있는 거겠지.」
			ELSEIF TALENT:[[ネムノ]]:セフレ || TALENT:[[ネムノ]]:愛欲
				PRINTFORML 
			ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
				PRINTFORMDW 네무노가 한 모금 마시자 눈이 커졌다.
				PRINTFORMDW %HE_SHE(TARGET,1)%은 계속 작은 모금을 마셨지만, %HES_SHES(TARGET)%가 즐기지 못한다는 것을 알 수 있었다.
			ELSE
				PRINTFORMW 「네가 뭘 했는지는 모르겠지만, 이 차 맛이 영 별로야.」
				PRINTFORMDW 네무노는 \@ INROOM(CFLAG:MASTER:現在位置) ? 당신에게 찻잔을 돌려준다 # 바닥에 %HIS_HER(TARGET)% 차를 쏟고 빈 찻잔을 당신에게 돌려준다 \@.
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
