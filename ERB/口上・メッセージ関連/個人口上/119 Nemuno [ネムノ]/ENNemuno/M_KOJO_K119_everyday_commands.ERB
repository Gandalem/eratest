@M_KOJO_EN01_SUCCESS_COM_K119_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_EN01_MESSAGE_COM_K119_301
CALL M_KOJO_EN01_MESSAGE_COM_K119_301_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K119_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 1
			IF TALENT:[[ネムノ]]:恋人
				PRINTFORMDW Nemuno takes a sip of your tea. %HIS_HER(TARGET,1)% eyes light up.
				PRINTFORMW 「Hot damn! This is delicious!」
				PRINTFORMW 「Where'd ya learn to make tea like that?」
			ELSEIF TALENT:[[ネムノ]]:セフレ || TALENT:[[ネムノ]]:愛欲
				PRINTFORML 
			ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
				PRINTFORMW 「This is great!」
				PRINTFORMDW Nemuno sets %HIS_HER(TARGET)% cup down and grins at you.
				PRINTFORMW 「You been takin' lessons or somethin'?」
			ELSE
				PRINTFORMW 「Black tea? My favorite!」
				PRINTFORMDW Nemuno takes a sip and swirls the tea around in %HIS_HER(TARGET)% mouth for a moment before swallowing.
			ENDIF

		CASE 0
			IF TALENT:[[ネムノ]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDW Nemuno leans in to take the teacup from your hand... and kisses you on the forehead.
						PRINTFORMW 「Whoops. Guess I'm gettin' clumsy in my old age.」
						PRINTFORMDW %HE_SHE(TARGET,1)% winks.
					CASE 1
						PRINTFORMW 「Ahh... delicious.」
						PRINTFORMDW Nemuno drains the cup and smacks her lips.
					CASE 2
