;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗でもふりほどかれたりはしません
;==================================================

@M_KOJO_EN01_SUCCESS_COM_K119_603
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_EN01_MESSAGE_COM_K119_603
CALL M_KOJO_EN01_MESSAGE_COM_K119_603_1
RETURN RESULT

@M_KOJO_EN01_MESSAGE_COM_K119_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME("NemunoHandholding")
		PRINTFORMDW 당신은 손을 뻗어 네무노의 손을 잡는다.
		PRINTFORMDW 그녀는 얼굴을 붉히며 본능적으로 당신에게서 몸을 뺀다.
		PRINTFORMW 「아! 미안해...」
		PRINTFORMW 「그냥 놀랐고, 내 손이 얼마나 늙고 거친 건지 느끼게 하고 싶지 않아서 그래...」
		PRINTFORMDW 당신은 다시 네무노의 손을 잡고 꽉 쥐어준다.
		PRINTFORMDW 잠시 후, 그녀는 미소를 지으며 당신에게 되돌려 악수한다.
	ELSE
		IF TALENT:[[ネムノ]]:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「내가 쓰는 로션 마음에 들어?」
					PRINTFORMW 「케인 씨는 그것이 "나이 든 숙녀들의 피부에 기적을 가져다준다"고 해.」
				CASE 1
					PRINTFORMW 「젠장... 내가 맹세컨대, 네 손은 내가 잡을 때마다 더 부드러워지는 것 같아.」
					PRINTFORMW 「비결이 뭐야?」
				CASE 2
					PRINTFORMDW 너는 네무노에게 시선을 돌리며 웃음을 참는다.
					PRINTFORMDW 그녀는 토마토처럼 빨갛고, 네가 하는 건 손을 잡는 것뿐인데!
					PRINTFORMDW 그녀는 뒤돌아보더니 어떻게든 더 세게 홍조를 띤다.
					PRINTFORMW 「나 웃지 마! 네가 너무 귀여운 게 내 잘못 아니잖아!」
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:セフレ || TALENT:[[ネムノ]]:愛欲
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSEIF TALENT:[[ネムノ]]:思慕 || TALENT:[[ネムノ]]:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 
				CASE 1
					PRINTFORML 
				CASE 2
					PRINTFORML 
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
