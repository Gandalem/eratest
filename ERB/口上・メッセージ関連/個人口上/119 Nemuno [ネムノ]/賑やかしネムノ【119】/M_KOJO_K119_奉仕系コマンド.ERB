;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K119_80
CALL M_KOJO_MESSAGE_COM_K119_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K119_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF FLAG:70
		PRINTFORMW 네무노가 움직이지 않는 동안, 당신은 마음껏 그녀의 손을 당신의 %FSYN("penis")% 위로 문지른다...
		RETURN 1
	ENDIF
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「뭐야, 내 거 만지길 바라는 거야?」
		PRINTFORML 「잘 모르겠지만, 뭐, 알겠어. 너 이상한 사람이지 않아?」
		PRINTFORMW 네무노는 무심하게 그녀의 손을 위아래로 움직이며 당신의 %FSYN("penis")%...
		RETURN 1
	ENDIF
	IF NOWEX:PLAYER:射精
		PRINTFORML 「헤에, 너 떨고 있잖아. 나 무서워?」
		PRINTFORMW 네무노는 뭔가 오해하고 있는 것 같다...
	ENDIF
	PRINTFORML 「하지만 말해야겠어, 마치 감자를 문 것 같은 기분이야.」
	PRINTFORMW 갑자기 그녀가 그것을 강판으로 긁는 것을 상상하게 된다...
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K119_81
CALL M_KOJO_MESSAGE_COM_K119_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K119_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「입에 넣는 거 별로 신경 안 쓰는데, 내 이빨이 장식용은 아니거든.」
		PRINTFORMW 네무노의 날카로운 송곳니가 당신의 %FSYN("penis")% 전체를 스친다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORML 당신은 %FSYN("penis")%을 네무노의 조용한 입안에 넣는다...
		PRINTFORMW 그녀의 이빨에 스스로 상처를 내지 않도록 조심해야 한다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「음, 크윽... 실수로 깨물었다면 미안해.」
		PRINTFORMW Nemuno는 어색한 페라치오를 계속한다\@ NOWEX:PLAYER:射精 ? . # ... \@
	ENDIF
	IF NOWEX:PLAYER:射精
		PRINTFORML 「음흥, 음프... ...꿀꺽?」
		PRINTFORMW 당신은 뜨거운 정액을 네무노의 입안에 쏟아낸다...
	ENDIF
ENDIF
RETURN 1
