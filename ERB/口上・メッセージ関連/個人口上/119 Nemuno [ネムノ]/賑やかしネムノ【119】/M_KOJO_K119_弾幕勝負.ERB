; Modular ERB: 個人口上/119 Nemuno [ネムノ]/賑やかしネムノ【119】/M_KOJO_K119_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K119_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「탄막 매치라니, 에헤. 제일 잘하는 건 아니지만...」
		PRINTFORMW 겸손한 말과는 달리 네무노의 눈에는 전쟁 같은 빛이 서려 있었다.
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 「이게 네 몸에 닿으면 죽는다, 그러니 목숨 걸고 피하는 게 좋을 거다!」
				PRINTFORMW 수많은 도살용 칼들이 너를 향해 날아온다...!
			CASE 1
				PRINTFORML 「너 꽤 강하군, 하지만 이방자라는 게 유감이야.」
				PRINTFORML 「나만의 스펠 카드를 써야 할지도 모르겠군...」
				PRINTFORMW 당신 주위로 저주받은 폭우가 내리기 시작한다!
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3, 2, 1
				PRINTFORML 「이봐, 괜찮아?」
				PRINTFORML 「꽤 좋은 약을 가지고 있어.」
				PRINTFORMW 네 몸은 베인 상처들로 뒤덮여 있군...
			CASE 0
				PRINTFORML 「아, 이게 마지막이군.」
				PRINTFORML 「꽤 잘하잖아, 안 그래 %CALLNAME:MASTER%?」
				PRINTFORML 「그냥 널 차지해서 나만의 것으로 키우고 싶어지는걸.」
				PRINTFORMW 네무노는 새롭게 생긴 존경심으로 너를 바라본다.
		ENDSELECT
		IF 相手残機 >= 2
			PRINTFORML 「너무 약해서 죽여버릴까 생각했어.」
			PRINTFORML 「잘 먹고 다녔지?」
			PRINTFORMW 너는 죽음과 아슬아슬하게 맞았었다...
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
