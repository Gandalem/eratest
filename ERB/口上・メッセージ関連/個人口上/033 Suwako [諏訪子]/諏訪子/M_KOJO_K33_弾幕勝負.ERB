; Modular ERB: 個人口上/033 Suwako [諏訪子]/諏訪子/M_KOJO_K33_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K33_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ITEM:三粒の天滴
			PRINTFORMDL 셀 수 없이 많은 개구리들이 당신의 가슴에서 튀어나온다!
			PRINTFORML 「흠, 네가 나에게 준 축복을 나에게 사용하겠다는 거야?」
			PRINTFORMW 「농담은 너야, 나는 그런 무례함이 좋아♪ 가진 모든 것을 가지고 달려와 보라고!」
		ENDIF
		PRINTFORML 「어서 와라, 신들에게 바치는 의식인 카구라를 시작하자! 나를 즐겁게 해 주도록 해줘♪」
		PRINTL 
		PRINTFORMDL 파티 시작 "두 개의 활, 두 번의 박수, 그리고 하나의 활" 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTDATAW
					DATAFORM 「우와아, 꽤 대단한걸!♪」
					DATAFORM 「이제 막 시작하는 중이야... 더 준비해둬~! 」
					DATAFORM 「어머 이런, 망쳤나? 괜찮아, 지금부터가 내가 전력을 다할 차례니까!」
					DATAFORM 「그거 피했구나, 응... 너 좀 과소평가했나 보네, 응?」
				ENDDATA
				PRINTL 
				RESETCOLOR
				PRINTDATADW
					DATAFORM 네이티브 신 "긴 팔의 군주와 긴 다리의 군주"
					DATAFORM 신성한 도구 "모리야의 철고리"
					DATAFORM 철고리 "신화적인 고리"
					DATAFORM 봄 부적 "끔찍한 강철의 비취"
					DATAFORM 봄 부적 "스와의 맑은 물"
					DATAFORM 히메강 "공주 녹색 옥"
					DATAFORM 녹색 돌 "비취 파괴"
					;says snake hunt (蛇狩) in the original, intentional or just a typo? the rest is the same
					DATAFORM ――개구리 사냥 "뱀이 개굴거리는 개구리를 먹는다"
					DATAFORM ――토착 신 "일곱 돌과 일곱 나무"
					DATAFORM ――신성한 사쿠라 "만발의 사쿠라 눈보라"
					DATAFORM ――토착 신 "개굴이 바람과 비에 맞서다"
					DATAFORM ――토착 신 "후에이의 붉은 개구리 4"
					DATAFORM ――개구리 표식 "붉은 개구리의 피 묻은 언덕"
					DATAFORM ――"스와 전쟁 ～ 토착 신화 대 중앙 신화"
				ENDDATA
			CASE 1
				PRINTDATAW
					DATAFORM 「%SPLIT_G("Thaaat's the stuff:Nicely done")%... 후후후, 이거 내 혈액 펌프질하게 만드네!♪」
					DATAFORM 「너는 나를 여기까지 몰아붙이다니... 꽤 괜찮은 엔터테이너로군!」
					DATAFORM 「후후... 이제 제대로 말하는군! 신을 하려면 이런 정신이 있어야 해! %SPLIT_G("challenge:take on")% 신을 할 거라면!」
					;added
					DATAFORM 「오, 정말 오랜만에 이렇게 몰리는 기분이야! 마음에 들어!」
				ENDDATA
				PRINTL 
				RESETCOLOR
				PRINTDATADW
					;different kanji (祟 instead of 崇)
					DATAFORM -- 재앙의 표식 "미사구지님"
					DATAFORM -- 재앙의 신 "미사구치님"
					DATAFORM -- 토착신 "미사구지님"
				ENDDATA
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「푸하아～!」
				PRINTFORMDW 스와코는 땅속으로 뛰어들어 모든 탄막을 피했다... 뭐라고?!
				PRINTFORMW 「결국 '땅'도 나한테 쓸모 없는 원소는 아니었어, 알잖아. 자, 이제 다시 시작해볼까♪」
			CASE 1
				PRINTFORMDL 갑자기 거대한 간헐천이 폭발하며, 그 빛은 단막을 날려버리는 광경을 놀라 지켜보게 한다.
				PRINTFORMW 「대지의 힘은 가볍게 다뤄서는 안 돼, 이해해주길 바라～」
				PRINTFORMDL 그녀가 땅 위를 기어다니는 것은 단순히 과시하거나 괴짜처럼 보이려고 그러는 것이 아니야, 아니...
				PRINTFORMDW 그녀가 발을 디딘 바로 그 "땅"이 그녀의 가장 큰 무기인 거야!――
			CASE 2
				PRINTFORMW 「이건 그냥 이 철 고리를 사용하는 또 다른 방법일 뿐이야~♪」
				PRINTFORMDL 스와코는 놀라운 우아함으로 철 고리를 돌리며 활짝 웃는다.
				PRINTFORMDW 공격과 방어 모두에 사용될 수 있는 신성한 도구, 이것은 골치 아픈 일이 될 것이다...
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTDATAW
					DATAFORM 「흠, 솔직히 좀 더 만만치 않은 상대였으면 좋았을 텐데~」
					DATAFORM 「이렇게 약한 걸 괴롭하다니, 결국 신성하신 위엄에 먹칠하는군♪」
					DATAFORM 「으음~ 난 이제 막 시작된 줄 알았는데~」
				ENDDATA
			CASE 2
				PRINTDATAW
					DATAFORM 「분명 네게 장점이 있긴 하지만, 아직 나를 만족시키기엔 멀었어~」
					DATAFORM 「결국 저렇게 약한 것을 괴롭하는 것은 신성한 위엄에 좋지 않은 모습을 보여주는구나♪」
					DATAFORM 「%SPLIT_G("아직 준비 안 됐어: 네가 갈 길이 더 있어")%～ %SPLIT_G("이 후에 더 많은 훈련을 받길 바래: 좀 더 연습해야 해: 좀 더 연습해야 돼")%.」
				ENDDATA
			CASE 1
				PRINTDATAW
					DATAFORM 「이봐, 이봐, 아직 시간 남아있잖아, 다시 붙자――뭐라고, 안 돼? 부우～!」
					DATAFORM 「너 겨우 이 정도였구나, 그런 거겠지. 그래도 즐거웠어, 재미있었어♪」
					DATAFORM 「이만큼 해온 것만으로도 잘했어. 그 집념은 내 취향이야, 알잖아?」
					;added
					DATAFORM 「가까웠지만 실패야 %K33_BOY()%다음 기회를 노려봐, 기대하고 있을게!」
				ENDDATA
			CASE 0
				PRINTDATAL
					DATAFORM 「아하하하! %SPLIT_G("Brilliantly done:Splendid")%♪」
					DATAFORM 「멋지군... 자네는 놀라운 것들로 가득해, %CALLNAME:MASTER%.」
					DATAFORM 「아아, 즐거운 시간은 충분히 가졌고, 아주 만족스럽군!」
				ENDDATA
				IF !CFLAG:[[諏訪子]]:弾幕勝負勝利
					PRINTFORMW 「전성기 때 가졌던 힘과는 거리가 멀지만, 한때 온 나라를 지배했던 신인 나를 이겨냈구나.」
					PRINTFORMW 「응-응, 통과야! 정말 감동이야! 그래서 나는 언제나 환희의 세계에서 살고 싶어♪」
					PRINTFORML 「원한다면 다시 나와 놀아도 돼. 네가 내게 준 즐거움에 대해서는 언젠가 반드시 감사할 거야.」
					PRINTFORMDW 스와코는 커다란 미소를 지으며, 진심 어린 행복을 발산하고 있었다...
				ELSE
					PRINTDATAL
						DATAFORM 「다음에 또 너랑 결투하고 싶어~」
						DATAFORM 「그냥 빈둥거리며 아무것도 안 하고 있을 수는 없을 것 같아. 다시 운동을 시작해야 하나...」
						DATAFORM 「졌는데 기쁘다고? 음, 하지만 물론이지! 우리는 싸웠고, 경쟁했고, 정말 신나고 재미있었어♪」
						;added
						DATAFORM 「나중에 다시 한 판 더 붙자! 후회 안 하게 만들어 줄게♪」
					ENDDATA
					PRINTFORMDW 스와코는 귀에서 귀까지 웃으며 당신을 바라보는데, 마음속 깊은 곳부터 진심으로 행복해 보인다...
				ENDIF
		ENDSELECT
		IF 相手残機 >= 1
			PRINTFORML 「뭐, 어쨌든 가구라에 와줘서 고마워. 고맙게 생각해.」
			PRINTFORML 「결과가 어떻든, 이렇게 나와 함께 놀아주려는 것만으로도 난 행복해져♪」
			PRINTFORMDW 스와코는 활짝 웃으며 당신의 손을 잡는다...
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
