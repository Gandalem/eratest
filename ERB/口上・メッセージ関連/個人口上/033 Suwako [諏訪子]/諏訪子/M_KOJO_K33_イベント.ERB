					IF TALENT:MASTER:濃厚精液
						CALL PRINT_DIALOGUE, @"네 걸의 진득한 것이 뜨거운 접착제처럼 내 안쪽에 달라붙어 있네%UNICODE(0x2764)% 세상에, 이 시점에서 정말 나를 임신시키고 싶구나, 그렇지 않니%UNICODE(0x2764)%", "w"
					ELSE
						CALL PRINT_DIALOGUE, @"느껴져... 네 정액이 내 배에서 미친 듯이 헤엄치고 있어%UNICODE(0x2764)% 후후~ 이제 임신할지도 모르겠네, 누가 알겠어...%UNICODE(0x2764)%", "w"
					ENDIF
				ELSE
					PRINTFORMW 「너 정말 죽도록 일했어... 와, 이 못된 년아%UNICODE(0x2764)%」
				ENDIF
				;ＶＡ両穴の場合
			ELSEIF SOAKED_OR_NOT("V_SEMINAL") && SOAKED_OR_NOT("A_SEMINAL")
				PRINTDATAW
					DATAFORM 「%K33_MOAN("m")%%UNICODE(0x2764)%... 아아아앙... 내 엉덩이랑 이 가련한 작은 구멍이... 둘 다 완전히 흠뻑 젖었어...%UNICODE(0x2764)%」
					DATAFORM 「%K33_MOAN()%!%UNICODE(0x2764)% 좋은 비린내야... 온몸에 뒤덮였네... 내 모든 장난꾸러기 부위들이 네 색깔로 물들었어%UNICODE(0x2764)%」
				ENDDATA
			ELSEIF SOAKED_OR_NOT("V_SEMINAL")
				PRINTDATAW
					DATAFORM 「%K33_MOAN("m")%%UNICODE(0x2764)%... 아아앙... 안 돼애, 새어 나오고 있어애...%UNICODE(0x2764)%」
					DATAFORM 「%K33_MOAN()%!%UNICODE(0x2764)% 네 것들로 완전히 가득 차버렸어... %K33_BOY()%%UNICODE(0x2764)%」
				ENDDATA
			ELSE
				PRINTDATAW
					DATAFORM 「아우흥 %UNICODE(0x2764)% 내 잘못이야, %K33_BOY()%... 나 방금 소변 좀 실수한 것 같아 %UNICODE(0x2764)%」
					DATAFORM 「%K33_MOAN()%!%UNICODE(0x2764)% 내 엉덩이가 너무 망가져서, 엄청 뜨겁게 느껴져... %UNICODE(0x2764)%」
				ENDDATA
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;愛液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;事後のムード
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;服を着る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 4
			PRINTFORML
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
