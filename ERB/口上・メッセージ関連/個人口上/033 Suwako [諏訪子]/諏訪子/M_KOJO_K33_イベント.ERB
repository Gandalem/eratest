			DATAFORM 「후훗, %SPLIT_G("time for some offering payday now:now to get my well-deserved wrapped money offering")%～」
		ENDDATA
		PRINTW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
