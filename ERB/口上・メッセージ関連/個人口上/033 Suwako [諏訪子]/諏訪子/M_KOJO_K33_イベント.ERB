			CASE 0
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORMDW 졸린 대로 스와코는 %SPLIT_G("snuggles up to:leans against")% 너를...
				ELSE
					PRINTFORMDW 스와코는 상당히 졸려 보인다...
				ENDIF
			CASE 1
				PRINTFORMDW 스와코가 말하듯, 그녀의 눈꺼풀은 이미 감기 직전이었다...
			CASE 2
				PRINTFORMDW 스와코가 졸기 직전, 스와코는 몇 번 눈을 깜빡이고 힘겹게 눈을 크게 뜬다...
			CASE 3 ;added
				PRINTFORMDW 잠시 수와코가 그대로 잠이 들기 시작한 것 같았지만, 그녀는 금세 정신을 차린다...
			CASEELSE
				PRINTW 
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMDW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕付き拠点内キャラがMAIN_MAPで衰弱状態になった場合か、お招き部屋で相手が衰弱した場合に発生
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TCVAR:360 && K33_TATARI_BARE()
			PRINTFORML 「헤헤... 너무 심하게 몰아붙이는 것도 안 좋은 거더라고, 알고 보니.」
			PRINTFORMDW 크고 시끄러운 웃음소리가 네 두개골 속에서 거의 울부짖는다. 네 흐릿한 시야가 가장자리부터 순식간에 완전히 검게 변한다.
			PRINTFORML 「흠, 뭐 내가 할 말이 있겠니. 너의 욕정, 너의 식욕, 그리고 너의 그 순전한 결단력이 나를 계속 움직이게 하는 거니까. 행운을 빌어♪」
			PRINTFORMDL 의식을 잃기 직전에 네가 어떤 광경을 바라본다.
			PRINTFORMDW %BREAKENG(@"네 앞에 있던 소녀의 형체가 풀리면서 셀 수 없이 많은 거대한 흰색 뱀 같은 것들이 꿈틀거리며 기어 다니고 있었다--")%
		ELSEIF RAND:4 && (TALENT:恋慕 || TALENT:愛欲) ;added
			PRINTFORML 「헤이 %K33_BOY()%, 너 듣고 있니--」
			PRINTFORML 「오... 어쩌지...」
			PRINTFORML 「젠장, 이거 안 좋은데! %HE_SHE(MASTER,1)% 완전 이상해졌어!」
			PRINTFORMDW 스와코는 걱정스러운 듯 당신의 어깨를 빌려 방으로 돌아가는 것을 도와준다.
		ELSE
			PRINTFORML 「아이고, 네가 해낼 수 없을 것 같은데, 그렇지?」
			PRINTFORMDL 스와코는 이 모든 상황에 무심한 듯 평소처럼 기분 좋게 너를 어깨에 태웠다.
			PRINTFORMDW ...그녀의 작은 몸 안에 엄청난 힘이 담겨 있다는 생각이 경외감이 뒤섞인 생각으로 네 멍한 의식을 스쳤다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;非在住TARGETがMAIN_MAPで休憩
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;前のターンから一緒の部屋にいる状態で相手が寝る（お招き部屋含む（
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
RETURN 1
