			PRINTFORMDL 그녀가 %COND_STR(" first",CFLAG:33:LatestChildCount > 1)% 갓 태어난 아기의 첫 울음소리를 들으며 안는 순간, 온화한 어머니의 미소가 얼굴에 떠올랐다.
		ENDIF
		PRINTFORMDL 그녀의 체형은 따뜻하고 상냥하면서도 어딘가 신성한 것이 있어 위엄이 있었다――
		PRINTFORMDW 마치 오랫동안 전해 내려오는 초기 신화 속에서 살았던 위대한 대지의 어머니 여신처럼, 이 순간을 위해 그렇게 보였다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		GOTO SYUSSAN
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		GOTO SYUSSAN
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDL  
ENDIF
RETURN 1
