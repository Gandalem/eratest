			PRINTFORMDW ...아니 그렇게 생각했겠지.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
