@M_KOJO_MESSAGE_COM_K33_60_1
;-------------------------------------------------
;立位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			PRINTFORMW 
			RETURN 1
		ELSEIF FLAG:70
			CALL K33_TATARI_COUNTER(4)
			RETURN 1
		ELSE
			CALL INSERT_KOJO_K33(0, 0, 0)
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF FLAG:70
			CALL K33_TATARI_COUNTER(4)
			RETURN 1
			;前回射精した
		ELSEIF TCVAR:102
			CALL INSERT_KOJO_K33(0, 1, 0)
			RETURN 1
		ELSE
			CALL INSERT_KOJO_K33(0, 1, 0)
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		CALL K33_TATARI_COUNTER(4)
		RETURN 1
	ELSE
		CALL INSERT_KOJO_K33(0, 0, 0)
