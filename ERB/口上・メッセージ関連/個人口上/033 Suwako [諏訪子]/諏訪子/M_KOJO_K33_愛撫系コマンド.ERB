@M_KOJO_MESSAGE_COM_K33_0
IF TCVAR:抱き寄せ初回 == 10
	CALL K33_TRAIN_HATESEX("take")
ELSE
	CALL M_KOJO_MESSAGE_COM_K33_0_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		CALL K33_TATARI_COUNTER(2)
		RETURN 1
		;恋慕ほか
	ELSEIF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
		IF NOWEX:TARGET:Ｃ絶頂 || NOWEX:TARGET:Ｂ絶頂
			PRINTDATAW
				DATAFORM 「%SPLIT_G("Oh no:Dear me")%… 너는 그저 %FSYN("rub:ing")% 나일 뿐이고, 설령 그렇다 해도… 너무 부당해애!%UNICODE(0x2764)%」
				DATAFORM 「후으음… 혹시 네가 있어서… 이렇게 날카롭게 느껴지는 걸까… 있잖아, 알 수 있지?」
				DATAFORM 「네 손길이 너무 좋아, 나… 제발, 뭘 하든 그 손을 %SPLIT_G("don't stop:keep movin'")% 간청할게...!」
			ENDDATA
		ELSE
			PRINTDATAW
				DATAFORM 「후후... 정말로 나를 %SPLIT_G("take good care of:cherish:treasure")% me, 네 손길에서 느껴져... 정말 행복해!」
				DATAFORM 「%SPLIT_G("Ya sure are:Yer so")% 부드러워... 너도 할 수 있어 %SPLIT_G("go hard on me:put some strength into it:be fierce about it")% though, 괜찮아? 난 할 수 있어 %SPLIT_G("handle:take")% 그것을.」
				DATAFORM 「%K33_MOAN()%더... %SPLIT_G("Ya can keep touchin' me some more:Keep touchin' me:Just keep at it")% 좀 더, 알겠지...?」
			ENDDATA
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF NOWEX:TARGET:Ｃ絶頂 || NOWEX:TARGET:Ｂ絶頂
			PRINTFORMW 「당신의 손길이 너무 좋아, 나는 이제... 제발, 당신이 무엇을 하든, %SPLIT_G("don't stop:keep movin'")% 그 손을, 간청해...!」
		ELSE
			PRINTFORMW 「%K33_MOAN()%... 더... %SPLIT_G("Ya can keep touchin' me some more:Keep touchin' me:Just keep at it")% 좀 더, '알았지...?'」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
