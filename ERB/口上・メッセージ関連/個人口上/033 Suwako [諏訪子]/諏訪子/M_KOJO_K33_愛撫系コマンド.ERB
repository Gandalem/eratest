@M_KOJO_MESSAGE_COM_K33_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTDATAW
				DATAFORM 「...오, 날 청소할 작정이냐? %SPLIT_G(@"That makes me glad～:How... considerate of you, hehe%UNICODE(0x2764)%")%」
				DATAFORM 「후후... 네가 좋아하는 게 이런 거였구나, 후우... %K33_MOAN(,,2)%...! %UNICODE(0x2764)%」
				;added
				DATAFORM 「됐어, 그렇게까지 할 필요 없어. 역겹잖아, 그치? 하지만... 고마워%UNICODE(0x2764)%」
				DATAFORM 「그게... 음, 정말 네 자신을 맛보고 싶다면, 마음대로 해보라고 할게%UNICODE(0x2764)%」
			ENDDATA
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:Ｃ絶頂
		IF FLAG:70
			CALL K33_TATARI_COUNTER(2)
			RETURN 1
		ELSE
			PRINTDATAW
				DATAFORM 「%SPLIT_G(@"%K33_MOAN()%:Oh yesss")%!%UNICODE(0x2764)% %SPLIT_G("Don't stop:Keep at it:Do it, lick meee")%, 더, 더 세게!!!」
				DATAFORM 「%K33_MOAN()%, 바로 거기! 갈 것 같아--... 음ㅁ응흐윽!!!%UNICODE(0x2764)%」
				DATAFORM 「%SPLIT_G("Sooo good:Theeere it is")%, 바로 그곳이야! 계속 그 부분을 핥아줘...! %UNICODE(0x2764)%」
			ENDDATA
			IF NOWEX:Ｃ絶頂 > 1 ;added
				PRINTFORMDW 수와코의 바깥쪽 입술을 빨아들이고 안쪽 입술을 마사지하는 너의 흡입은 가련한 소녀를 오르가슴적인 광란으로 몰아넣는다.
				PRINTFORMDW 그녀는 네게 반사적으로 벽을 조이며, 황홀경 속에서 신음하며 크리미한 액체의 홍수를 네 목구멍으로 흘려보낸다.
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		CALL K33_TATARI_COUNTER(2)
		RETURN 1
	ELSEIF SELECTCOM == PREVCOM ;added, continuous
		PRINTDATAW
			DATAFORM 「쯧, 정말 열중하는구나%UNICODE(0x2764)%」
			DATAFORM 「%K33_MOAN()%! 부드럽게 해줘, 어디 가지 않을 거야%UNICODE(0x2764)%」
			DATAFORM 「그러니까 아까 이 일 때문에 여기서 눈을 못 떼고 있었던 거네, 응?%UNICODE(0x2764)%」
			DATAFORM 「이리 와, 힘 좀 써봐... 내 보지 맛 제대로 봐! %UNICODE(0x2764)%」
			DATAFORM 「헤헤, 그래, 아주 좋아... %K33_MOAN()%! 내 신성한 분비물을 계속 빨아들여%UNICODE(0x2764)%」
			DATAFORM 「이렇게 오랫동안 이걸 기다려왔구나, 알겠어%UNICODE(0x2764)%」
		ENDDATA
		PRINTDATADW
			DATALIST
				DATAFORM 당신은 스와코의 안팎을 핥으며 애타게 그녀의 물방울이 떨어지는 주름들을 핥으면서 신음한다,
				DATAFORM 그리고 당신의 혀로 빠르게 돌리며 그녀의 미숙한 틈새 안으로 파고든다.
			ENDLIST
			DATAFORM 스와코는 당신의 열렬한 봉사에 만족하며 여신 같은 매력적인 미소를 선물한다 그녀는.
			DATALIST
				DATAFORM 당신의 혀는 매끄럽고 털 없는 대음순을 따라 미끄러지며, 입술은 발기된 봉우리를 빨아들인다.
				DATAFORM 당신의 얼굴은 하늘의 진주문과 일치하며, 남성성을 삼키도록 설계된 작은 틈이다.
				DATAFORM 매끄럽고 축축한 그것이 당신의 혀를 어루만지는 동안, 당신의 혀끝은 섬세한 구멍을 건드리고 자극한다.
				DATAFORM 당신의 입술이 창백한 분홍빛 살을 집어삼키면서 압력이 증가한다.
			ENDLIST
			DATALIST
				DATAFORM 스와코의 질 분비물에서 나는 지독한 냄새가 당신의 콧속을 가득 채우고, 당신은 그 액들을 혀로 게으르게 핥는다;
				DATAFORM 그녀의 뜨겁고 축축하며 조이는 주름들이 당신 혀의 모든 움직임을 삼키고, 그녀의 다리가 당신의 머리를 감싸 고정한다;
				DATAFORM 그녀는 무릎으로 당신의 두피를 파고들며 당신의 머리를 자신의 가랑이에 단단히 붙잡는다.
			ENDLIST
			DATALIST
				DATAFORM 스와코의 입이 당신을 감싸며 조여오고, 당신이 그녀에게 응수하자 그 주름들이 당신의 혀를 간지럽힌다.
				DATAFORM 그녀의 진액은 거의 달콤한 맛이 나서 당신의 미뢰를 짜릿하게 만들고 더욱 더 핥도록 재촉한다.
				DATAFORM 마치 당신이 몰랐던 갈증을 해소해주려는 듯이 말이다.
			ENDLIST
		ENDDATA
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
		PRINTDATAW
			DATAFORM 「네 혀가 %SPLIT_G("crawling:swirling:twirling:roaming")% 사방팔방이어서 %SPLIT_G("wildly:naughtily:lewdly:desperately")%...%UNICODE(0x2764)%」
			DATAFORM 「후후... 만약 네가 나를 그렇게 철저히 할 거라면 %SPLIT_G("stimulate:tease:play with:work on")% 나를 그렇게 철저히 한다면 정말 나한테 영향을 줄지도 몰라%UNICODE(0x2764)%」
			DATAFORM 「어떻게 표현해야 할지 모르겠지만... 사랑받는 이 기분이랄까? 정말... 굉장하게 좋아!%UNICODE(0x2764)%」
		ENDDATA
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「네 혀가 온 사방에 있어 그래서 %SPLIT_G("crawling:swirling:twirling:roaming")%...%SPLIT_G("wildly:naughtily:lewdly:desperately")%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
