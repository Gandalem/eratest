@M_KOJO_MESSAGE_COM_K33_699
CALL M_KOJO_MESSAGE_COM_K33_699_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_699_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:[[諏訪子]]:睡眠
		;added
		PRINTFORML 「후우... 하아... 쿨쿨...」
		PRINTFORMDW 당신은 조용히 방을 나선다. 스와코의 잠을 방해하지 않도록 조심하며...
	ELSEIF TALENT:[[諏訪子]]:恋慕 || TALENT:[[諏訪子]]:愛欲 || TALENT:[[諏訪子]]:セフレ
		IF CFLAG:[[諏訪子]]:溜まってる度 >= 800 || TCVAR:[[諏訪子]]:発情 || PALAM:[[諏訪子]]:欲情 >= PALAMLV:5
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「에에~ 우리가 재미있는 부분에 도달한 거 아니야?」
					PRINTFORMDW 수와코는 열병 같은 눈으로 당신을 응시하며 설득하는 데 약간의 노력이 필요했다...
				CASE 1
					PRINTFORML 「그냥 나를 흥분시키고 떠날 거야? %K33_BOY()%, 너 정말 최악의 못된 애잖아～%UNICODE(0x2764)%」
					PRINTFORMDW 그녀의 입술을 핥으며, 스와코는 이 시점에서 포식자의 분위기에 완전히 뒤덮여 있는 듯했다...
			ENDSELECT
		ELSE
			GOTO EXIT
		ENDIF
	ELSE
		$EXIT
		IF !睡眠時間([[諏訪子]])
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「벌써 가버리는 거야? %SPLIT_G("Bummer:That's too baaad")%~」
					PRINTFORMDW 그렇게 말하며 스와코는 당신을 따라온다...
				CASEELSE
					PRINTDATAW
						DATAFORM 「돌아가니? 괜찮아, 내가 같이 가줄게.」
						DATAFORM 「떠날 시간이야? 알았어, 어디로 가고 싶어?」
					ENDDATA
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「벌써 떠나네? %SPLIT_G("Bummer:That's too baaad")%～」
					PRINTFORMDW "잘 가~", 스와코가 손을 흔들며 작별 인사를 건넨다.
				CASE 1
					PRINTFORML 「너 떠나는 거야? 아유, 뭐 %SPLIT_G("be sure to stay over when you get the chance, 'kay?:yer always welcome if you wanna come back!")%」
					PRINTFORMDW 수와코의 작별 인사를 뒤로한 채 방을 나선다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
