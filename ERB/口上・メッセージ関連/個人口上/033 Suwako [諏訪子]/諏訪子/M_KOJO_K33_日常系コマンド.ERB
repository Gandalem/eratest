;413,料理
;TFLAG:194(100以上=禁断のメニュー 3=デザート 2=主食 1=軽食
;==================================================

@M_KOJO_MESSAGE_COM_K33_413
;TFLAG:194が100以上の場合のみ
CALL M_KOJO_MESSAGE_COM_K33_413_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	SELECTCASE TFLAG:194
		CASE IS >= 100
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「...정말로 이걸 요리하는 거야? 정말로...?」
				CASE 1
					PRINTFORMDW 스와코는 말로 표현할 수 없는 표정을 지었다...
				CASE 2
					PRINTFORMW 「이거 먹어도 되는 걸까...? 정말 먹을 수 있는 건가...?」
			ENDSELECT
		CASE 3
			PRINTDATAL
				DATAFORM 「디저트가 결국은 %SPLIT_G("indispensable:a staple")%이잖아, 그렇지~」
				DATAFORM 「알았어%SPLIT_G("! I'll show you the ability befitting a goddess:leave it to me! Behold the divine power:! Let me show you what a goddess can do")%!」
				DATAFORM 「단것들은 언제나 제물로 특별하지 않아?」
			ENDDATA
		CASEELSE
			PRINTDATAL
				DATAFORM 「음 %SPLIT_G("you don't mind my help:would you like some help")%? 좋아아 %SPLIT_G("I'll take care of it:leave it to me:consider it done")%!」
				DATAFORM 「좋아 %SPLIT_G("! I'll show you the ability befitting a goddess:leave it to me! Behold the divine power:! Let me show you what a goddess can do")%!」
				DATAFORM 「가끔은 주방 일에 빠지는 것도 괜찮을 거라고 생각한다~」
				;added
				DATAFORM 「나 너무 녹슬어 있지 않게 해야 해! 난 여자니까~」
			ENDDATA
	ENDSELECT
	SELECTCASE ABL:[[諏訪子]]:料理技能
		CASE IS >= 4
			PRINTFORMDL 잘 조율된 방식으로 거의 완벽한 조화를 이루며, 당신 둘은 원하는 대로 주방을 지배했다...
		CASE 3
			PRINTFORMDL 어느 정도의 기술을 보여주며 스와코는 요리하는 것을 도와주었고 상당히 유용했다...
		CASE 2
			PRINTFORMDL 스와코는 그곳에서 자신의 미천한 능력으로 당신을 요리하는 것을 도왔다...
		CASEELSE
			PRINTFORMDL 그녀가 동기 부여가 되어 있었음에도 불구하고, 결국 스와코는 당신이 그 요리를 완전히 혼자 만드는 것을 지켜볼 수밖에 없었다...
	ENDSELECT
	PRINTFORMDW
ENDIF
RETURN 1
