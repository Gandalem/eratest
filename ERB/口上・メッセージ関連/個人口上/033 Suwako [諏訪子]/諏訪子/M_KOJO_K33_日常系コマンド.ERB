;==================================================
;431,お風呂でくつろぐ
;TFLAG:209(4=人里の銭湯で番台ちゃんを怒らせている 1=銭湯に入った
;TFLAG:211(4=地底の温泉で番台妖怪を怒らせている 1=温泉に入った
;TFLAG:194(1=連続入浴不可(表示しない可能性あり？
;==================================================

@M_KOJO_MESSAGE_COM_K33_431
CALL M_KOJO_MESSAGE_COM_K33_431_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_431_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:209 == 1
	ELSEIF TFLAG:211 == 1
	ELSE
		IF TALENT:[[諏訪子]]:恋慕 || TALENT:[[諏訪子]]:愛欲 || TALENT:[[諏訪子]]:セフレ
			IF (CFLAG:[[諏訪子]]:溜まってる度 >= 800 || TCVAR:[[諏訪子]]:発情 || PALAM:[[諏訪子]]:欲情 >= PALAMLV:5) || RAND:3 >= 1
				SELECTCASE IFRAND("0TO1", 1, "D1", !HAS_PENIS(MASTER))
					CASE 0
						PRINTFORML 「후후... 완전히 열려있잖아!♪」
						PRINTFORMDW 스와코는 재빨리 손을 네 사타구니 쪽으로 내리며 당신에게 더 가까이 미끄러져 들어왔다.
						PRINTFORML 「오 마이... 아래쪽이 꽤 뜨거워지고 있네%UNICODE(0x2764)%」
						PRINTFORMDW 그녀의 유혹적인 속삭임과 섬세한 손가락 움직임이 서서히 당신에게 영향을 주기 시작했다...
					CASE 1
						PRINTFORML 「있잖아, 내가 너한테 좀 더 가까이 다가가도 괜찮아?」
						PRINTFORMDW 대답하기도 전에 스와코가 앞에서 당신을 껴안고 몸 전체를 문지르기 시작했다.
						PRINTFORML 「...아하, 네 성기가 \@ BASE:MASTER:勃起 > 700 ? 벌써 단단하고 맥동하고 있네 # 매분 더 단단해지고 있어 \@%UNICODE(0x2764)%」
						PRINTFORMDW 그녀는 계속 움직이면서 말을 멈추지 않았다.
				ENDSELECT
				SIF HAS_PENIS(MASTER) && BASE:MASTER:勃起 < 1000
					BASE:MASTER:勃起 = LIMIT(BASE:MASTER:勃起 + 500, 0, MAXBASE:MASTER:勃起)
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아아... 충분히 적셔지고 있어...」
						PRINTFORMDL 스와코는 욕조 안에서 당신에게 몸을 밀착시키며 만족스러운 신음을 흘린다.
						PRINTFORMDW 두 사람의 용모 차이는 너무 커서 도저히 형용할 수 없을 정도다.
					CASE 1
						PRINTFORML 「후후!♪」
						PRINTFORMDW 스와코는 이 얕은 물에서 개구리처럼 능숙하게 헤엄친다...
						PRINTFORMDW ...잠깐, 욕조에서 그렇게 수영하면 안 돼!
						PRINTFORMW 「흥, 정말 재미없게 구네 %CALLNAME:MASTER%～」
					CASE 2
						PRINTFORML 「이제 따뜻해지는 기분이야~ 어쩌면 이게 이 소박함의 장점 중 하나일지도?」
						PRINTFORMDW 스와코는 히죽거리며 자만심에 찬 "히히-응!"을 내뱉는다.
				ENDSELECT
			ENDIF
		ELSE
			PRINTDATAW
				DATAFORM 「아아... 물에 흠뻑 젖는 기분이야...」
				DATAFORM 「이제 몸이 따뜻해지는 것 같아...」
				DATAFORM 「후우... 정말 상쾌하다!」
			ENDDATA
		ENDIF
	ENDIF
ENDIF
RETURN 1
