;FLAG:70(1=時間停止中
;TFLAG:193(0=見てるだけ 1=一緒に掃除)
;TFLAG:194(3=汚れ高 2=汚れ中 1=汚れ低 0=汚れ最小
;OUTROOF(CFLAG:現在位置)(野外掃除（冬は雪かき
;==================================================

@M_KOJO_MESSAGE_COM_K33_410
CALL M_KOJO_MESSAGE_COM_K33_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF CFLAG:睡眠
		RETURN 0
	IF FLAG:70
	ELSE
		IF TFLAG:193 == 0
			PRINTFORML 「우리 존경하는 청소 전문가가 무엇을 보여줄지 한번 보자~」
			PRINTFORMDW 스와코는 그저 지켜보며 가장 무심하게 "최선을 다해봐~"라고 응원한다...
		ELSEIF TFLAG:193 == 1
			PRINTDATAL
				DATAFORM 「좋아, %SPLIT_G("so be it:fffiiiiine")%, %SPLIT_G("I'll lend ya a hand:I'll help ya out")%!」
				DATAFORM 「나 %SPLIT_G("be useful once in a while:show others that I've still got it:prove my worth sometime")%해야 해~」
				DATAFORM 「%SPLIT_G("헤헤:후후")%, %SPLIT_G("같이 하면 훨씬 빨리 끝낼 수 있을 거라고 생각해: 함께 일하면 분명 더 빨라질 거야.")%!」
			ENDDATA
			PRINTFORMDL 빠르고 활기찬 수와코가 당신과 함께 힘차게 청소를 한다...
			IF ABL:[[諏訪子]]:清掃技能 >= 4
				PRINTFORMDW 그녀도 그 일에 있어서 상당히 꼼꼼했다... 그녀의 노력을 감탄하지 않을 수 없다.
			ELSE
				PRINTFORMDW 그녀가 그것에 대해 일관성 없게 끝날 수밖에 없다는 것을 깨닫고, 당신은 그녀의 뒤를 따라야 했다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
