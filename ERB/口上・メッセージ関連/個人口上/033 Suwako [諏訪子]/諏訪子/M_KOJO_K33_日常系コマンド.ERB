;414,食事を取る
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;TFLAG:194(1=ノーパンしゃぶしゃぶ 2=禁断のメニュー 31=ドーピングコンソメスープ 30=モッツァレラチーズとトマトのサラダ 34=ギンギー料理
;TCVAR:MASTER:308(bit0=濃い味 bit1=薄味 bit3=激辛 bit4=激甘 bit5=わさび bit6=激酸っぱ
;==================================================

@M_KOJO_SUCCESS_COM_K33_414
;成否判定
;TFLAG:192(-2=コマンド終了(非TARGET時強制失敗)、-1＝強制失敗、0=COM依存(非TARGET時強制成功)、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K33_414
CALL M_KOJO_MESSAGE_COM_K33_414_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_414_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
		RETURN 0
	;IF TASTE_REACTION("辛い") || TASTE_REACTION("甘い") || TASTE_REACTION("すっぱい")
	IF GETBIT(TCVAR:MASTER:308 ,3) || GETBIT(TCVAR:MASTER:308 ,4) || GETBIT(TCVAR:MASTER:308 ,6)
		PRINTDATAL
			DATAFORM 「...%SPLIT_G("흡흡:흐으음:음흠:크윽")%...?!」
			DATAFORM 「?! ...!!!?!?!」
			DATAFORM 「...... ...... ......」
		ENDDATA
		PRINTDATADL
			DATAFORM 스와코는 얼굴에 쓰라린 눈빛을 한 채 당신 쪽으로 돌아본다...
			DATAFORM 스와코는 눈을 이리저리 굴리며 당황한다...
			DATAFORM 스와코는 무언가 말을 걸고 싶은 듯 당신에게 시선을 고정한 채, 괴로워하며 입을 반복적으로 열었다 닫는다...
		ENDDATA
	ELSEIF TFLAG:193 >= 0
		;edit since this description now shares two actions
		IF SELECTCOM == 414 && !RAND:3
			PRINTFORML 「신에게 바친 음식을 먹음으로써 유대를 강화하는 것... 이것이 음식 봉헌이나 신센(神饌)의 모든 것이란 것이다!」
		ELSE
			PRINTDATAL LOCAL:99
				DATAFORM 「...%SPLIT_G("That sure is tasty:That hit the spot just right")%. 대접해줘서 고마워, %K33_BOY()%!」
				DATAFORM 「음-흠, 완벽해, 정말 훌륭하다고 말할 수 있지! 결국 음식으로 누군가를 끌어들이는 게 기본이니까♪」
			ENDDATA
		ENDIF
		SELECTCASE LOCAL:99
			CASE 0
				PRINTFORMDL 그렇게 말하면서 스와코가 온 얼굴에 기쁜 미소를 지었다.
			CASE 1
				PRINTFORMDL 다소 위엄 있고 고결해 보이지만 동시에 명랑한 수와코는 재빨리 젓가락을 움직인다...
			CASE 2
				PRINTFORMDL 만족스러운 후루룩 소리와 함께 식사를 급히 마친 스와코는 귀여운 미소를 지으며 빛난다.
		ENDSELECT
	ELSE
		PRINTFORML 「...%SPLIT_G("음...")%. %SPLIT_G("아직 좀 부족해:생으로 먹는 느낌이야:다음엔 더 잘해야지:아무래도 다음엔 조금만 더 노력해야 할 것 같아?")%～」
	ENDIF
	PRINTFORMDW
ENDIF
RETURN 1
