;417,昼寝をする
;TFLAG:193(0=MASTERを抱き枕にして寝ている 1=MASTERの膝を枕にして寝ている 2=寝顔にキスされた 3=寝顔をのぞき込まれた 4=MASTERが膝枕されてる 5=秘処orペニス揉み
;CFLAG:添い寝中(1=一緒に寝ている
;==================================================

@M_KOJO_MESSAGE_COM_K33_417
CALL M_KOJO_MESSAGE_COM_K33_417_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_417_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음냐아...」
					PRINTFORMDL 스와코가 천천히 일어나 눈을 비빈다.
				CASE 1
					IF DAY:2 == 4
						PRINTFORML 「음~... 몸의 온기는 겨울에 정말 갈망하는 거겠지, 응~%UNICODE(0x2764)%」
						PRINTFORMDL ...그게 그녀가 냉혈해서 그런 걸까?
					ELSEIF DAY:2 == 2
						PRINTFORML 「지금 기분 좋게 쌀쌀하지 않아? 후후, 편안한 낮잠 자는 거 도와줄까?」
					ELSE
						PRINTFORML 「하아암... 음음...」
						PRINTFORMDL 정말 일어나기가 힘든 모양이다...
					ENDIF
				CASEELSE
					PRINTFORML 「아우우우... 아직 너무 졸려...」
			ENDSELECT
		CASE 1
			PRINTDATAL
				DATAFORM 「음... 신에게서 이런 멋진 서비스를 받게 된 건 행운이야, 그러니 그에 대한 감사를 보여주길 바라!」
				DATAFORM 「정말 편안하지? 응, 나도 동의해... 정말로 이렇게 있으니 어떤 평온함이 느껴져.」
				DATAFORM 「하아, 좋은 꿈을 꾸고 있었는데 말이야...」
			ENDDATA
		CASE 2
			PRINTDATAL
				DATAFORM 「스스로에게 베푸는 거라고 할까. 그래.」
				DATAFORM 「...헤헤~%UNICODE(0x2764)%」
			ENDDATA
		CASE 3
			PRINTDATAL
				DATAFORM 「후후, 잠든 모습이 정말 재미있었어.」
				DATAFORM 「너 보는 거 지겹지도 않아? 뭐, 꽤 즐거웠다고 할 수 있지♪」
			ENDDATA
		CASEELSE
			WAIT
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;421,願掛けする
;条件が複雑なので、COMF421 願掛け.ERBおよび、EVENT_MESSAGE_COM400.ERBの願掛けするの項を参照のこと
;==================================================

@M_KOJO_MESSAGE_COM_K33_421
CALL M_KOJO_MESSAGE_COM_K33_421_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K33_421_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋慕 || TALENT:愛欲 || TALENT:思慕 || TALENT:セフレ
		IF CFLAG:1002
			PRINTFORML 「이 음탕한 신 대신 기도할 수 있는 훨씬 더 좋은 여신이 항상 있다는 거 알잖아...」
		ELSE
			PRINTFORML 「나 바로 앞에 있는 다른 신에게 기도하는 게 무슨 속셈이냐?」
		ENDIF
	ELSE
		PRINTFORML 「내 앞에서 다른 신에게 기도하다니, 정말 배짱이 두둑하군...」
	ENDIF
	SIF FLAG:願掛け内容
		PRINTFORMW 「......」
	SIF MESSKIP()
		FORCEWAIT
	SELECTCASE FLAG:願掛け内容
		CASE 200;精力絶倫
			IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
				PRINTFORML 「...우오? 그리고 뭐%SPLIT_G("ddya mean by this:t's that all 'bout")% 궁금할까~」
				PRINTFORMDW 스와코는 만족스러운 미소를 지으며, 주로 당신의 하체를 살피고 있었다...
			ELSE
				PRINTFORML 「...흥. 뭐, %SPLIT_G("suit yourself all you please, I s'pose:have fun with that one I guess:do what you gotta do, eh:you do you then, right")%인가?」
				PRINTFORMDW 스와코는 씨익 웃으며 어깨를 으쓱한다....
			ENDIF
		CASE 202;パンティーおくれ
			IF (TALENT:恋慕 || TALENT:愛欲) && CFLAG:1002
				PRINTFORML 「...%SPLIT_G("Call it being an irredeemable zealot, but...:That's quite the zealous attitude you got there.")% 말할 수 없어... 나를 조금이라도 질투하게 만들지는 않아.」
				PRINTFORMDW 스와코는 당신에게 바짝 다가가 살짝 입술을 내민다.
				PRINTFORMDW 그녀의 행동은 본질적으로 "이리 와서 나한테 좀 더 경배해줘!"라고 말하고 있음이 분명하다...
			ELSE
				PRINTFORML 「......」
				PRINTFORMDW 스와코는 당신을 마치 신발에 묻은 때라도 되는 양 흘겨본다.
			ENDIF
		CASE 203;桃色の風
			PRINTFORML 「...그렇게 소규모 사건을 일으킬 수 있을 줄은 몰랐다. 내 생각엔... 확실히 그렇다고 말해야겠군.」
			PRINTFORMDW 스와코는 다소 위협적인 눈빛으로 코웃음을 치며 말했다.
			PRINTFORMDW 당신이 %PantsuSama()%과 이상한 종류의 라이벌 관계를 갖게 만든 것 같다...
		CASE 206;子宝祈願
			IF FLAG:子宝祈願 == 33
				PRINTFORML 「...뭐, 그렇게 될 거라면 그냥 자초하는 거지%UNICODE(0x2764)%」
				PRINTFORMDW 이상하게도 스와코는 전혀 개의치 않는 것 같다...
			ENDIF
	ENDSELECT
	IF TFLAG:193
		PRINTFORMW 「......?!」
		IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
			PRINTFORML 「...뭐야? 네가 그런 짓을 하고 있었다면, 나도 내 방식으로 보답해야겠지♪」
			PRINTFORMDW 스와코는 유혹적으로 입술을 핥으며 쩝 소리를 낸다...
		ELSE
			PRINTFORML 「...뭐야? 그건 꽤 배짱 있는 행동이군...」
			PRINTFORMDW 스와코는 어두운 웃음을 흘리며 어깨를 으쓱했다...
		ENDIF
	ENDIF
ENDIF
RETURN 1
