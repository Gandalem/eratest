@M_KOJO_MESSAGE_COM_K33_626_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			;kourindou check
			LOCALS:0 = \@ (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ? 그를 # 그녀를 \@
			LOCALS:1 = \@ (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ? 그 # 그녀 \@
			PRINTFORML 「%SPLIT_G(@"아 정말, 당신이 %LOCALS:0%를 화나게 했어:아이고, %LOCALS:1%가 화났네:아이구, 너무 심하게 장난쳤잖아, %LOCALS:1% 완전히 열 받았어:오호, %LOCALS:1% 지금 화났구나")%～」
			;やっぱりやめる（見送り）
		CASE -1
			IF TALENT:[[諏訪子]]:恋慕 || TALENT:[[諏訪子]]:愛欲
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「평소에는 물질적인 것에 대해 특별한 욕심이 없다. 어쨌든 나는 여신이니까.」
						PRINTFORML 「하지만 그래도 공물이나 선물은 언제나 환영이다. 오히려 그것을 준비하는 마음을 고맙게 생각한다.」
						PRINTFORML 「모든 면에서 나는 여신이라는 것을 잊지 말아라?」
					CASE 1
						PRINTFORML 「물건을 사는 것보다는 자신의 생각과 감정을 나누는 것이 더 중요하단다.」
						PRINTFORML 「그게 바로 재미인 거지, 안 그래?」
						PRINTFORMDL 스와코가 당신의 팔을 잡고 저쪽도 보라고 재촉한다...
					CASE 2
						PRINTFORML 「오우! 이거 너한테 딱 어울릴 것 같은데 %K33_BOY()%뭐라고 생각해?」
					CASEELSE
						GOTO REPEATCASE
				ENDSELECT
			ELSE
				$REPEATCASE
				IF !RAND:3
					PRINTFORML 「우와, 나도 이거 좀 마음에 드네~♪」
					PRINTFORMDL 스와코의 눈이 반짝이며 무언가 새로운 것을 발견한다...
				ELSE
					PRINTDATAL
						DATAFORM 「아, 이거 너무 귀여워요!」
						DATAFORM 「I think I'll buy one for my Sanae too～」
					ENDDATA
				ENDIF
			ENDIF
			;400点未満（BAD）
		CASE 1
			IF TALENT:[[諏訪子]]:恋慕 || TALENT:[[諏訪子]]:愛欲
				SELECTCASE RAND:5 ;custom code
					CASE 0
						PRINTFORML 「네에... 적어도 그 마음은 고맙게 받을게.」
						PRINTFORMDL 마치 신에게 걸맞은 우아함에 휩쓸린 것만 같아...
					CASE 1
						PRINTFORML 「음~? 아니야, 욕 안 할게! 약속해, 하지 않을 거야~!」
						PRINTFORMDL "결국 난 바치는 것을 거절하지 않는 신이니까", 스와코가 힘든 웃음을 지으며 말했다...
					CASE 2
						PRINTFORML 「나의 유일한 %K33_BOY()%에게서 온 것이라면, 내가 그걸 거절할 수 있겠어?」
						PRINTFORMDL 스와코는 얼굴에 희미한 미소를 띠며 당신의 선물을 받는다...
					CASE 3
						PRINTFORML 「고맙지만... 그건 내 전문 분야가 아니라서.」
					CASE 4
						PRINTFORML 「에엣, 다른 게 더 좋았겠지만... 그래도 감사히 받을게.」
				ENDSELECT
			ELSE
				IF !RAND:3
					PRINTFORML 「음... 음, 뭐라고 해야 할지 모르겠네... 고마워, 그런 걸로 됐나?」
					PRINTFORMDL 스와코는 그 마음만으로도 감사하다고 말한다. 정말 그저 그 몸짓만으로도.
				ELSE
					PRINTDATAL
						DATAFORM 「...아마 카나코에게 주어야 할지도 모르겠어.」
						DATAFORM 「에에에, 그래도 다른 게 더 좋았을 텐데...」
					ENDDATA
				ENDIF
			ENDIF
			;400点～699点（NOMAL）
		CASE 2
			IF TALENT:[[諏訪子]]:恋慕 || TALENT:[[諏訪子]]:愛欲
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「정말 고마워요, %K33_BOY()%.」
						PRINTFORML 「나를 기쁘게 하는 건 물건 자체라기보다는 그것에 담긴 생각이에요.」
					CASE 1
						PRINTFORML 「나를 위한 선물이란가? 정말이야? 후후, 그럼 신의 뜻대로 다른 방식으로 갚아야겠지, 안 그래?」
						PRINTFORMDL 스와코는 스스로 만족한 듯 미소를 지으며 벌써 계획을 세우기 시작했다.
					CASEELSE
						GOTO REPEATCASE2
				ENDSELECT
			ELSE
				$REPEATCASE2
				IF !RAND:3
					PRINTFORML 「"제물은 하늘 높이 받들어야 한다!", 뭐 그런 속담이 있지. 후후~」
					PRINTFORMDL Suwako는 기쁨에 환하게 웃으며 자신의 선물을 들어 올린다...
				ELSE
					PRINTDATAL
						DATAFORM 「고마워요. 생각해 보면 선물 받는 거 좋네요.」
						DATAFORM 「아니에요, 그냥 갖고 싶을 것 같아서요. 정말 기뻐요~♪」
					ENDDATA
				ENDIF
			ENDIF
			;700点以上（GOOD）
		CASE 3
			IF TALENT:[[諏訪子]]:恋慕 || TALENT:[[諏訪子]]:愛欲
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「.........」
						PRINTFORMDL 평소 시끄러웠던 스와코가 이번에는 조용히 선물을 살펴본다...
						PRINTFORMDL 아무 말도 하지 않았지만, 그녀가 충분히 기뻐하고 있다는 것을 알 수 있었다.
					CASE 1
						PRINTFORML 「...이게 무슨 기분인지 모르겠어. 예전에도 많은 선물을 받았는데, 그런데...」
						PRINTFORML 「당신으로부터 온 진심 어린 선물 하나가 나를 이렇게 행복하게 만들 줄은 몰랐어, 알잖아?」
						PRINTFORMDL 스와코는 자신의 반응에 완전히 놀란 듯 살짝 웃으며 나를 올려다봤다.
					CASEELSE
						GOTO REPEATCASE3
				ENDSELECT
			ELSE
				$REPEATCASE3
				IF !RAND:3
					PRINTFORML 「있잖아, 신들은 가장 진심을 담고 정중하게 대하는 자들에게 보상을 주는 법이지.」
					PRINTFORML 「어쩌면 어느 날... 무슨 말인지 알겠지?」
					PRINTFORMDL 이 순간, 스와코의 부드러운 미소는 어딘가 신성해 보였다.
				ELSE
					PRINTDATAL
						DATAFORM 「...오, 이거 정말 나를 행복하게 만드네. 진심으로, 난 매우 기뻐.」
						DATAFORM 「내 취향까지 알아주다니, 응? 후후, 그게 나의 %K33_BOY()%야!」
					ENDDATA
				ENDIF
			ENDIF
	ENDSELECT
	WAIT
ENDIF
RETURN 1
