; Modular ERB: 個人口上/033 Suwako [諏訪子]/諏訪子/M_KOJO_K33_依頼.ERB
;added, this file only has og case for one action, the rest can be replaced in case of merging
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K33(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K33(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K33(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;==================================================
;依頼口上・一般依頼15_あなたに抱かれたい
;==================================================

@M_KOJO_IRAI_15_K33(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K33
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「야, 음, %K33_BOY()%... 거절할 수 없는 제안이 있단 말이야... 이리 와봐～」
		PRINTFORMDW 상당히 수상해 보이는 스와코가 당신에게 손짓하며 가까이 다가오게 한다. 그녀는 그리고는 당신의 귓가에 속삭이기 시작한다--
		PRINTFORMDW 알고 보니 온갖 저주어들이었다!!!
		PRINTFORMW 「제발 좀, 쉬잇...! 조용히 해... 이 나이 먹은 스와코 좀 도와줄 수 없어? 부탁이야?」
		PRINTFORMW 「돈 많이 줄 테니까... %UNICODE(0x2764)%」
	CASE "依頼非受託時"
		PRINTFORMW 「흐-허? 아... 그래, 내가 그런 걸 물어보지 말았어야 했는데...」
		PRINTFORMW 「미안해, 그냥... 나 스스로 어떻게든 처리할게.」
		PRINTFORMW 「쯧...」
		PRINTFORMDW 스와코가 혀를 차는 게 네 상상이었을까 하고 궁금해한다...
	CASE "依頼受託時"
		PRINTFORMW 「우와, 정말?! 도와줄 거야?! 잘됐다!」
		PRINTFORMW 「정말 고마워요... 큰 호의를 베풀어 주시는군요. 자, 더 지체하지 말고 시작해 볼까요...%UNICODE(0x2764)%」
	CASE "依頼確認時"
		PRINTFORML 「그래서... 우리가 여기서 해야 할 일이 이거야. 아주 간단해.」
		PRINTFORML 「뭐? 신들도 필요가 있는 거잖아! 어차피 내가 대부분의 일을 하게 될 테니까.」
	CASE "依頼破棄時"
		PRINTFORMW 「에엣?! 마음을 바꿨다고?! 아아아...」
		PRINTFORMW 「이건... 예상 밖이야... 충격적이야...」
		PRINTFORMDW 스와코는 울 것 같은 모습이다...
	CASE "依頼実行直前"
		LOCAL:99 = IS_DOUTEI(MASTER)
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		IF LOCAL:99
			PRINTFORML
			CFLAG:[[諏訪子]]:1900 = 1
			CALL K33_CHERRYPOPCONCLUSION, 2
		ELSE
			PRINTFORMW 「오호, 정말 굉장했어! 내 변덕에 맞춰준 것들 고마워, %K33_BOY()%%UNICODE(0x2764)%」
			PRINTFORMW 「앞으로도 너에게 기대게 될 거야... 일단은 이걸 보상으로 받아줘!」
		ENDIF
	CASE "失敗報告時"
		PRINTFORMW 「부어...」
		PRINTFORMDW 스와코는 상당히 시무룩해 보인다...
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
