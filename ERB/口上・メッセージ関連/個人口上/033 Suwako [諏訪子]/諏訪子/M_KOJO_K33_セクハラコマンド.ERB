;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		CALL K33_TATARI_COUNTER(2)
	ELSEIF CFLAG:睡眠
		CALL K33_TATARI_COUNTER(2)
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;スカートの中を見せる
			CASE 35
				PRINTDATAW
					DATAFORM 「좋아? 부끄러워할 만한 일은 아닌 것 같은데... %K33_MOAN("m")%, 그렇게 너무 세게 %FSYN("stir")%하지 마, 안 돼! %UNICODE(0x2764)%」
					DATAFORM 「더... 나한테 좀 더 손가락 넣어봐, 제발 %UNICODE(0x2764)%」
					DATAFORM 「후후, 벌써 완전히 빠졌네... 괜찮아, 더 해도 돼 %UNICODE(0x2764)%」
				ENDDATA
				RETURN 1
				;クンニ強制
			CASE 70
				IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
					IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂
						PRINTDATAW
							DATAFORM 「「%SPLIT_G(@"%K33_MOAN()%:Oh yesss")%!%UNICODE(0x2764)% %SPLIT_G("Don't stop:Keep at it:Do it, lick meee")%, 더, 더 세게!!!」
							DATAFORM 「네 혀랑 손가락 움직이는 거 너무 잘해서 나 싸버릴 것 같아--... 음큭!」
							DATAFORM 「오옷 그래, 정말 좋아! 그 부위 놓지 말고 계속 해줘...!」
						ENDDATA
						RETURN 1
					ELSE
						PRINTDATAW
							DATAFORM 「%K33_BOY(1)%... 너 천성이구나%UNICODE(0x2764)%」
							DATAFORM 「후후... 만약 나를 그렇게 철저히 %SPLIT_G("stimulate:tease:play with:work on")%할 거라면, 정말로 영향을 받을지도 몰라%UNICODE(0x2764)%」
							DATAFORM 「%K33_MOAN()%%UNICODE(0x2764)% 너는 나의 %SPLIT_G("such a riot:sooo relentless after all")%... 후후%UNICODE(0x2764)%」
						ENDDATA
						RETURN 1
					ENDIF
					;それ以外
				ELSE
					PRINTFORMW 「네 혀가 온 사방에 있어 그래서 %SPLIT_G("crawling:swirling:twirling:roaming")%...%SPLIT_G("wildly:naughtily:lewdly:desperately")%」
					RETURN 1
				ENDIF
				;Ａ挿入する、腰振りA
			CASE 87, 89
				CALL INSERT_KOJO_K33(1, 0, 1)
			CASEELSE
				IF NOWEX:TARGET:Ｖ絶頂
					PRINTDATAW
						DATAFORM 「%K33_MOAN()%!%UNICODE(0x2764)% 곧 가버릴 것 같아, 그러니까... %SPLIT_G("Keep it goin':Don't stooop:Finish iiittt")%...!!!%UNICODE(0x2764)%」
						DATAFORM 「후아아... 네 덕분인지... 이렇게 짜릿한 건지 모르겠네... 있잖아, 느껴지지?」
						DATAFORM 「%K33_MOAN("m")%!%UNICODE(0x2764)% 널 때문에 가버리겠어, 멈출 수가 없어...!♪」
					ENDDATA
				ELSE
					PRINTDATAW
						DATAFORM 「%K33_MOAN("m")%... 네 손가락은 너무 %FSYN("lewd")%...%UNICODE(0x2764)%」
						DATAFORM 「제발, 그런 %FSYN("lewd")% %TOLOWER(CONJUGATOR(SQUELCH() + ":ing", 1))% 소리 내지 마... 일부러 그러는 거잖아, %FSYN("geez")%!%UNICODE(0x2764)%」
						DATAFORM 「%K33_MOAN()%...! 아아앙... 점점 지저분하고 난장판이 되어가네...!%UNICODE(0x2764)%」
					ENDDATA
				ENDIF
				RETURN 1
		ENDSELECT
	ELSE
		IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ
			IF NOWEX:TARGET:Ｖ絶頂
				PRINTDATAW
					DATAFORM 「오 안돼어%UNICODE(0x2764)% 나... 갈 것 같아... 크으윽--... 아아핫!%UNICODE(0x2764)%」
					DATAFORM 「후우... 혹시 당신 때문에 이렇게 강렬하게 느끼는 건가... 있잖아, 느껴지지?」
					DATAFORM 「%K33_MOAN("m")%!%UNICODE(0x2764)% 이런 곳에서 절정에 다다르게 될 거야...!♪」
				ENDDATA
			ELSE
				PRINTDATAW
					DATAFORM 「%K33_MOAN()%... %CAPITALIZE(FSYN("geez"))%, 여기서 이런 걸 하는 건가...%UNICODE(0x2764)%」
					DATAFORM 「제발, 그렇게 %FSYN("lewd")% %TOLOWER(CONJUGATOR(SQUELCH() + ":ing", 1))% 소리 내지 마... 일부러 그러는 거겠지, %FSYN("geez")%!%UNICODE(0x2764)%」
					DATAFORM 「아우... 네가 일부러 질척하게 만드는 건 아닌지 생각하기 시작했어, 안 그래?%UNICODE(0x2764)%」
				ENDDATA
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			IF NOWEX:TARGET:Ｖ絶頂
				PRINTFORMW 「%K33_MOAN()%!%UNICODE(0x2764)% 곧 갈 것 같아, 그러니까... %SPLIT_G("Keep it goin':Don't stooop:Finish iiittt")%...!!!%UNICODE(0x2764)%」
			ELSE
				SELECTCASE ABL:Ｖ感覚
					CASE IS >= 5
						PRINTFORMW 「젠장, 그런 %FSYN("lewd")% %TOLOWER(CONJUGATOR(SQUELCH() + ":ing", 1))% 소리 계속 내지 마... 일부러 그러는 거겠지, %FSYN("geez")%!%UNICODE(0x2764)%」
					CASE IS >= 0 ;same edit as above
						PRINTFORMW 「와아-- 이런 곳에서 뭘 시작하려는 거야...?」
					CASEELSE
						PRINTFORMW 
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
