	IF FLAG:70
		CALL K33_TATARI_COUNTER(3)
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				PRINTDATAW
					DATAFORM 「헤레, 봐봐... 후후, 너 그렇게 빤히 보는 거 알아?」
					DATAFORM 「%CAPITALIZE(FSYN("geez"))%, 네 %SPLIT_G("perv:sleeze:letch")%야!%UNICODE(0x2764)%」
					DATAFORM 「...이게 다 필요한 거 확실해~? 음~~?」
				ENDDATA
			CASE 0
				PRINTDATAW
					DATAFORM 「헤이, 이봐 %K33_BOY()%... 나한테 방심할 시간도 주지 않고 전혀 기습하지 않아!」
					DATAFORM 「%CAPITALIZE(FSYN("geez"))%, 정말 대단하군 %SPLIT_G("perv:sleeze:letch")%!%UNICODE(0x2764)%」
					DATAFORM 「...네 주제를 좀 알아야지, 안 그래 %K33_BOY()%?」
				ENDDATA
			CASE -1
				PRINTDATAW
					DATAFORM 「...생각 없이 본능대로 행동하는 타입이겠지, 응 %K33_BOY()%?」
					DATAFORM 「들어보라고... 내 말은, 우리 둘 다 네가 어떤 사람인지 알지만 그래도 말이야.」
					DATAFORM 「...꽤 대담하군, 안 그래 %K33_BOY()%?」
				ENDDATA
			CASEELSE
				PRINTDATAL
					DATAFORM 「.........%SPLIT_G("네 용기가 여기선 유일하게 칭찬할 만한 거다: 너 엄청난 배짱을 가졌구나, 애야.")%.」
					DATAFORM 「이것이야말로 정점의 신성모독이다! 이제 내가 너를 저주해 죽인 것을 탓할 수 없을 거라는 걸 알겠지, 맞지?」
					DATAFORM 「하나의 두려움도 모르는 단순한 바보라니... 그게 전부인가?」
				ENDDATA
				PRINTDATADW
					DATAFORM 스와코는 끔찍하게 사악한 미소를 지으며 말한다...
					DATAFORM 지금 스와코 뒤에 무언가 소용돌이치는 것을 분명히 느낄 수 있다...
					DATAFORM 스와코에게서 미지근한 바람이 불어 나와 피부가 오싹해진다...
				ENDDATA
				CALL K33_TATARI_COUNTER(3)
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
