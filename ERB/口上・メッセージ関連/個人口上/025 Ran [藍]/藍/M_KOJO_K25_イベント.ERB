@M_KOJO_EVENT_K25_21(ARG,ARG:1)
;口上主はARG
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTL
		PRINTFORMDW 무거운 한숨이 넘쳐흐른다.
		PRINTFORMDW 그녀의 눈썹이 찌푸려졌고, 란은 죄책감에 가득 찬 듯했다.
		PRINTL
		PRINTFORMW 「나는 식신이다. 유카리님 명령을 따르는 것이 내가 존재하는 이유...」
		PRINTL
		PRINTFORMDW 특정 %PRINT_MALE("man", MASTER)%과 관계를 갖는 것은 그녀에게 감정과 정서적인 부담만 안겨줄 뿐이다.
		PRINTFORMDW 그녀는 자신을 돌보는 것을 그만두었고, 의무를 소홀히 하며, 시키가미인 Ran의 모습은 상처 입었다.
		PRINTFORMDW 개인적인 감정을 갖는 것은 완전히 용납할 수 없는 것이며, 그것이 약점이다.
		PRINTFORMDW 무력하게 사랑에 빠져, 그녀는 문제의 근원을 제거하는 것에 대해 깊이 생각한다.
		PRINTL
		PRINTFORMW 「괜찮다고 말하네... 유카리님은 어떻게 그렇게 가볍게 넘길 수 있는 거지? 만약 내가 일하기를 게을리하게 되면 어쩌지?」
		PRINTL
		PRINTFORMDL 아마 그녀의 마스터가 너무 쉽게 허락해 준 것이겠지만, 랜은 완전히 기력이 소진된 상태다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTL
		PRINTFORMDW 랜은 시키가미라서 자신의 감정과 마음이 변할 때를 알아채기 쉬웠다.
		PRINTFORMDW 호의, 증오, 혐오, 신뢰. 좋든 나쁘든 누구에게든 과도한 감정은 피해야 한다.
		PRINTFORMDW 그녀는 깊이 생각 중이었고, 관계들을 잘 관리했었다 다만—
		PRINTL
		PRINTFORMW 「...%CALLNAME:MASTER%, 도대체 이 %HIM_HER(MASTER,,1)%로 뭘 해야 하지...」
		PRINTL
		PRINTFORMDW 시키가미 중 가장 강하며 그녀의 몇 안 되는 귀찮은 존재 중 하나인 %PRINT_MALE("man", MASTER)%은 그녀를 가질 자격이 없다.
		PRINTL
		CALL PRINT_DIALOGUE, @"이 속박하는 감정들을 그냥 없애버릴까? 아니, 그렇게 한다면 근원까지 상대해야 할 테니. 심지어 %HE_SHE(MASTER)%조차도 고려해 줄 가치가 있으니까...", "w"
		PRINTL
		PRINTFORMDL 그녀가 얼마나 그것에 대해 생각하든, 해결책은 나타나기를 거부한다.
		PRINTFORMDW 그녀가 실제 문제가 무엇인지 깨닫는 순간, 그녀의 몸은 수치심으로 움츠러든다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛欲取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTL
		PRINTFORML 「크크크... %CALLNAME:MASTER%, 벌써 젖어버렸네...」
		PRINTFORML 「이 몸에 얼마나 많은 %PRINT_MALE("men_:people", MASTER)%들이 빠졌을까...? 하나 더 있어도 괜찮겠지?」
		PRINTFORML 「얼마나 상쾌한가 - 흥미로운 것. %HIM_HER(MASTER,,1)%에게 몇 년이나 허비할 수 있을지 궁금하군.」
		PRINTL
		PRINTFORMDL 랜의 눈은 욕망으로 이글거린다.
		PRINTFORMDL 빈번한 만남, 격렬한 교합이 여우의 몸속에 야성의 본능을 깨웠다.
		PRINTFORMDL 랜은 즉시 당신을 어떻게 사로잡을지 계획하기 시작한다.
		PRINTFORMDW 자신이 사로잡힐 수도 있다는 생각은 그녀에게 떠오르지도 않았다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛人取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTL
		PRINTFORML 「후후, 너 정말 귀엽구나. 네가 나를 쉽게 방해하다니.」
		PRINTL
		PRINTFORMDL 랜은 너와 함께 보낸 수많은 가벼운 순간들을 환하게 미소 지으며 회상했다.
		PRINTFORMDL 그저 서로의 몸만 관련된 단순한 육체적인 관계다. 그것은 랜에게 매우 만족스럽고 편리한 방식이다.
		PRINTL
		PRINTFORML 「다음에 무엇을 할까?」
		PRINTL
		PRINTFORMDW 여우는 혼잣말을 하며 미소를 짓는다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;セフレ取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTL
		PRINTFORMDL 마요히가에서, 란은 책상에 앉아 손으로 턱을 괴고 한숨을 쉬며 붓을 멈춘다.
		PRINTFORMDL 그녀의 표정은 진지하지만 생각은 흩어져 어떤 사람만을 떠올리고 있었다.
		PRINTFORMDL 그녀의 왼손이 천천히 아래로 움직이며 드레스 위 배를 더듬는다.
		PRINTL
		PRINTFORML 「...안 돼, 안 돼. 너무 심하게 놀았어.」
		PRINTL
		PRINTFORMDW 고개를 저으며, 란은 다시 일로 돌아갔다.
		RETURN 1
	ENDIF
	PRINTL
ENDIF
RETURN 1
;==================================================
;調教終了時に自慰
;==================================================

@M_KOJO_EVENT_K25_22(ARG,ARG:1)
;口上主はARG
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;恋慕だと激しいのが解禁、まだいくつかの重複有り。古めかしいアダルトグッズを登場させてみる
;そこそこ長くなったけれど、何度も見るのでクリック数削減
IF LOCAL
	PRINTL
	SELECTCASE RAND:5
		CASE 0
			IF TALENT:恋慕
				PRINTFORMDL 랜은 그녀와 함께 욕조에 딜도를 몰래 넣는 데 성공했다.
				PRINTFORMDL 그것은 두껍고 나사 모양이며, 머리는 넓게 퍼져 있고 돌기로 덮여 있다.
				PRINTFORMDL SM 플레이로 그녀의 사타구니를 대자, 랜은 날카롭게 숨을 들이마신 후 폭력적으로 그것을 안으로 밀어 넣었다.
				PRINTFORML 「좀 더... 깊이... 안에...」
				PRINTFORMDL 그것을 밀어 넣고 그녀의 허벅지를 붙잡은 시키가미는 그녀가 끝내고 욕조에서 나올 때까지 그것을 안에 두었다.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 2)
			ELSE
				PRINTFORMDL 랜은 흰색 속옷에 손가락을 넣고 스스로를 격렬하게 만지자 돌이 솟아올랐다.
				PRINTFORMDL 곧 그녀의 다른 한쪽 손이 내려 음순을 어루만졌다.
				PRINTFORMDL 두 개의 손가락이 질 안으로 파고들어 뒤섞는 동안 엄지손가락은 음핵을 누르고 있었다.
				PRINTFORMDL 랜은 입을 굳게 다물고, 절정에 이르렀을 때 조용히 가만히 앉아 있었다.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 1)
			ENDIF
		CASE 1
			IF TALENT:恋慕
				PRINTFORMDL Ran은 광택이 나는 막대기처럼 보이는 것을 그녀 안으로 밀어 넣는다. 그것은 아름다운 나뭇결을 가진 상록 활엽수 오크에서 나온 것이다.
				PRINTFORMDL 거친 고리가 있는 울퉁불퉁한 머리는 빠져나올 때 그녀의 벽을 긁어낸다.
				PRINTFORMDL 여우는 강하게 그녀의 아랫입으로 안팎으로 움직이며 연모즙이 튀게 한다.
				PRINTFORMDL 옷 속으로 비명을 지르며 울음을 막고, Ran은 조용하지만 격렬하게 자신을 위로한다...
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 2)
			ELSE
				PRINTFORMDL 랜은 흰색 속옷에 손가락을 넣고 스스로를 격렬하게 만지자 돌이 솟아올랐다.
				PRINTFORMDL 곧 그녀의 다른 한쪽 손이 내려 음순을 어루만졌다.
				PRINTFORMDL 두 개의 손가락이 질 안으로 파고들어 뒤섞는 동안 엄지손가락은 음핵을 누르고 있었다.
				PRINTFORMDL 랜은 입을 굳게 다물고, 절정에 이르렀을 때 조용히 가만히 앉아 있었다.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 1)
			ENDIF
		CASE 2
			IF TALENT:恋慕
				PRINTFORMDL 랜은 침대 위에서 등을 아치형으로 하고 은밀하게 자신을 어루만진다.
				PRINTFORMDL 그녀는 자신의 인상적인 기술을 스스로에게 사용하며, 그저 기분 좋게 만드는 것에 집중한다.
				PRINTFORMDL 그녀가 끝내기까지 몇 분밖에 걸리지 않아 침대 위에서 쓰러진다.
				PRINTFORML 「...같지 않아... 나 자신과 노는 건...」
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 2)
			ELSE
				PRINTFORMDL 랜은 등을 아치형으로 세우고 이불 위에서 몰래 자신을 애무한다.
				PRINTFORMDL 자신의 인상적인 기술을 스스로에게 사용하며, 그녀는 그저 기분 좋게 만드는 것에 집중했다.
				PRINTFORMDL 몇 분 만에 끝나자, 그녀는 침대에 쓰러졌다.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 1)
			ENDIF
		CASE 3
			IF TALENT:恋慕
				PRINTFORML 「첸이 날 봤다면 설명할 방법은 없었을 거야...」
				PRINTFORMDL 랜은 따뜻한 물이 담긴 쟁반을 응시하며, 자위 때문에 작업 시간이 사라지는 것을 생각하며 어깨를 축 늘어뜨렸다.
				PRINTFORMDL 그녀는 소매를 걷고 마른 채소 줄기들을 땋아 기둥 모양으로 만들었다.
				PRINTFORMDL 따뜻한 물이 섬유에 스며들어 그것을 데우고 어느 정도 탄력을 주었다. 진짜만큼 좋지는 않지만, 그렇게 멀진 않았다.
				PRINTFORML 「...뭐, 이미 준비를 해뒀으니까... 응...」
				PRINTFORMDL 여우가 중얼거리는 것은 단지 변명일 뿐이었다. 그녀는 불룩한 줄기를 자신의... 깊숙이 밀어 넣으며.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 2)
			ELSE
				PRINTFORMDL 벌거벗은 채, Ran은 자신의 긴 꼬리로 부드러운 피부를 애무한다.
				PRINTFORMDL 자극은 약하지만, 그녀는 손가락으로 단단한 유두를 만지면서 서서히 하지만 확실하게 흥분이 고조된다.
				PRINTFORMDL 여러 개의 동시적인 절정으로 뒤틀리며 그녀의 등이 아치형으로 휘어진다...
				PRINTFORML 「내가 대체 뭘 하고 있는 거지...」
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 1)
			ENDIF
		CASE 4
			IF TALENT:恋慕
				PRINTFORML 「%MOAN(,,4)%...」
				PRINTFORMDL 그녀의 다문 입술 사이로 숨을 몰아쉬며, Ran은 결연한 표정으로 허리를 능숙하게 흔든다.
				PRINTFORMDL 그녀는 좌석 중앙에 놓인 딜도를 타고 있고, 그녀의 보지가 그것을 간절히 삼키면서 큰 소리가 울려 퍼진다.
				PRINTFORMDL 귀두가 조금 어긋나 있지만, 그게 그녀에게 박힐 때마다 소녀의 분비물이 터져 나온다.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 2)
			ELSE
				PRINTFORMDL 방에서 글을 다 쓰고 난 Ran은 돌아 테이블 모서리에 자신의 가랑이를 기댄다.
				PRINTFORMDL 그것은 어린 소녀가 시행착오를 통해 발견할 만한 종류의 자위지만, 우아하게 행해진다.
				PRINTFORMDL 그녀는 그토록 천박한 것을 즐기는 수치심에 취하며 옷 속에서 가슴이 무겁게 흔들리다가 스스로 움켜쥔다.
				PRINTL 
				CALL AddEXP("自慰経験", TARGET, 1)
			ENDIF
	ENDSELECT
	PRINTW
ENDIF
RETURN 1
;==================================================
;浴場連れだし
;==================================================

@M_KOJO_EVENT_K25_23(ARG,ARG:1)
