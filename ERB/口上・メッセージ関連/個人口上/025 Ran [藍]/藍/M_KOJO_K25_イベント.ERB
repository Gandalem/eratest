;デート帰り
;==================================================

@M_KOJO_SPEVENT_K25_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTL
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「오늘은 또 한 번 즐거웠다. 고마워, 나의 \@ TALENT:恋人 ? 환상적인 남편 # 멋진 사랑하는 사람 \@.」
					PRINTFORMDW 란은 농담조로 말하지만, 숨기려는 홍조가 귀엽다.
				CASE 1
					IF TALENT:妻 ;custom code
						PRINTFORML 「오늘 고마워. 너와 커플로 시간을 보내는 게 정말 즐거웠어.」
					ELSE
						PRINTFORML 「오늘 고마워. 이제 다른 사람들은 우리를 부부로 생각하기 시작했을 거야.」
						PRINTFORMDL 물론, 데이트할수록 그런 일은 더 생길 테니 당연한 일이지.
					ENDIF
					PRINTFORMDW 랜은 조금 진지해진 것 같지만, 그 안에서 비치는 수줍음이 정말 사랑스럽고 소중하게 간직할 만하다.
				CASE 2
					PRINTFORMDL 즐거운 데이트 후 집에 가던 중 언덕을 지나 그리고 환상적인 이상향의 풍경과 마주한다.
					PRINTFORML 「...알았어, 유카리님은...」
					PRINTFORMDW 란이 한 말을 놓쳤지만 당신은 의아한 듯 고개를 기울이지만 그녀는 별일 아니라고 웃으며 넘긴다.
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「긴 산책이었네. 피곤해, %CALLNAME:MASTER%?」
					PRINTFORMDW 당신은 고개를 끄덕이며, 마치 부부처럼 랜에게 미소를 나눈다.
				CASE 1
					PRINTFORML 「이번에는 어디로 갈까? 환상소는 넓으니까...」
					PRINTFORMDW 두 사람이 서로 기대어 걸으며 빈 이야기를 나누며 시간을 보내는 것이 일상이 되어가고 있다.
				CASE 2
					PRINTFORML 「다음엔 모요히가에서 하루를 보내자. 하룻밤 머물러도 괜찮을 거야.」
					PRINTFORMDW 좋은 제안이지만, 그녀는 단지 당신의 벽에 균열을 내려고 노력하고 있다는 느낌이 들었어.
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...느긋한 날이네, 그렇지 않니, %CALLNAME:MASTER%?」
					PRINTFORMDW 란은 데이트에 만족한 듯했다.
				CASE 1
					PRINTFORML 「네 입장을 이해해 줄 거라고 생각해. 그냥 게으름을 피울 수는 없어.」
					PRINTFORMDW 머지않아, 랜은 능숙한 혀를 사용해서 너에게 자신의 일을 도와달라고 약속하게 만든다.
				CASE 2
					PRINTFORML 「아아, 재미있었어. 정말로 그랬지.」
					PRINTFORMDW 그녀가 말 그대로 여우라 할지라도, Ran의 미소를 조금도 의심하지 않는다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「그렇게 나쁘지 않았어. 다시 해볼 만할지도 몰라.」
					PRINTFORMDW 그녀가 데이트를 어떻게 생각했는지 알기 힘들었다.
				CASE 1
					PRINTFORML 「다음에 또 할 거라고 약속 못 해. 나도 해야 할 일들이 있어.」
					PRINTFORMDW 랜이 당신을 거리를 두는 것 같아.
				CASE 2
					PRINTFORML 「좋은 시간을 보냈기를 바란다.」
					PRINTFORMDW 당신은 그게 Ran에게도 사실인지 궁금해한다.
			ENDSELECT
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
