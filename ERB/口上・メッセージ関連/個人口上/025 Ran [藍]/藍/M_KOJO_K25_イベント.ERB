@M_KOJO_EVENT_K25_18(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;避妊要求台詞
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「잠깐만, 우리 피임약이 필요해.」
		PRINTFORMW 「미리 약이나 콘돔을 준비해 줘.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「그럴 일 없어. 아직 너의 아이를 가질 생각은 없어.」
		PRINTFORMW 「임신 확률은 낮지만... 나를 분위기 망치는 사람으로 생각하지는 말아줘, 알겠지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断ったのに粘られて切れた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「안 된다고 했다.」
		PRINTFORMW 「어쩔 수 없겠지. 오늘은 여기까지다.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「괜찮을 거라고 생각하지만. 안전한 날에만.」
		PRINTFORMDL 생으로 만든 Ran의 승리에 자신도 모르게 주먹을 살짝 불끈 쥐게 된다.
		PRINTFORMW 「하지만 만약 무슨 일이 생긴다면... 말할 필요도 없겠지, 그렇지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「...알겠다. 좋아, 나는 반대할 이유가 없다.」
		PRINTL 
		PRINTFORMDW 랜은 형용할 수 없는 표정으로 미소를 지었다.
		PRINTFORMDW 당신 앞에 무릎을 벌린 그녀는 갑자기 손을 사용하여 입술을 벌렸다.
		PRINTL 
		PRINTFORMW 「더 이상 체한 척하거나 허세를 부리지 않을게, 네 아이를 원해.」
		PRINTFORMW 「서로 참지 말고 위험한 날에 섹스를 해보자.」
		PRINTFORMW 「물론 첫 시도에 임신하더라도 멈출 필요는 없을 거겠지, 맞지?」
		PRINTFORMW 「당연히 네가 나를 첫 시도에 임신시키는 것에 개의치 않아.」
		PRINTL 
		PRINTFORMDW 당신의 정신은 그녀의 체리빛 질에 거의 잠식되고, 당신은 천불멸의 Ran의 몸 위로 천천히 올라간다.
		PRINTFORMDW 당신은 눈앞의 Ran의 맨살 같은 체리핑크 음부에 유혹되어 자신을 잃는다.
		PRINTL 
		CALL AddEXP("愛情経験", TARGET, 30)
		PRINTL 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;神社暮らしを承認して貰う
;==================================================

@M_KOJO_EVENT_K25_19(ARG,ARG:1)
;口上主はARG
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;認められる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「정말 감사합니다. 오늘부터 제가 은혜를 갚아야겠어요.」
		PRINTFORMDL 결정되자마자 Ran은 어디서 났는지 짐을 꺼내 새집으로 가져갔다.
		PRINTFORML 「직장과 당신에게 가까운 집이에요. 더 바랄 게 없네요.」
		PRINTFORML 「아, 맞아요. 비록 그렇게 보이지는 않지만, 이것도 약간 마요히가와 같은 점이 있죠, 그 외에는...」
		PRINTFORMDW 여우(Kitsune)는 무엇보다 기뻐하는 듯했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;認められない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 
		RETURN 1
	ENDIF
	PRINTL
ENDIF
RETURN 1
