@M_KOJO_EVENT_K25_5(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;紫様が入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 26
		IF TALENT:恋慕
			;紫様が恋慕持ち
			IF TALENT:26:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「유카리님. 저에게 필요하신가요?」
						PRINTFORML 「아니면, 어쩌면 %CALLNAME:MASTER%일까요?」
						PRINTFORMDW 그들은 서로 무언가를 확인한 뒤, 따뜻한 미소를 지으며 당신을 돌아본다.
					CASE 1
						PRINTFORML 「기다리게 해서 죄송해요, 유카리님.」
						PRINTFORMDL 랜은 거의 당신을 유카리 앞에서 끌고 나간다.
						PRINTFORMDW 두 여자는 포위 공격을 시작하며 수상하게 미소 짓는다.
					CASE 2
						PRINTFORMDL 당신 앞에 있는 것은 공백 요괴다. 당신 뒤에는 아홉 개의 꼬리를 가진 시키가미가 있다.
						PRINTFORML 「유감하군, %CALLNAME:MASTER%. 유카리님의 명령은 항상 우선이다.」
						PRINTFORMDW 주인과 하인이 꽤나 명랑해 보인다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「유카리님.」
						PRINTFORML 「...알겠습니다. 물론이죠. 그럼 저는 진행하겠습니다...」
						PRINTFORMDW 두 여자는 당신을 응시하며 알아들을 수 없는 무언가에 대해 이야기한다.
					CASE 1
						PRINTFORML 「아니, 아니, 그건 도저히 할 수 없어. 나는 유카리님의 시키가미니까.」
						PRINTFORMDW 란은 유카리의 말을 부드럽게 만든다.
					CASE 2
						PRINTFORML 「그건 절대 일어나지 않았어. 네가 그걸 볼 리 없어. 그런데 봤다고 말하는 거야?」
						PRINTFORMDW 유카리는 너와 란이 플러팅하는 걸 잡았다고 말하며, 얼굴이 새빨개지는 너를 가차 없이 놀리기 시작한다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕
			PRINTFORML 「아, 유카리님. 저에게 필요하신가요?」
			PRINTFORMDW 란은 평소와 다르게 불편해 보인다.
		ELSE
			PRINTFORML 「유카리님, 함께 하시겠습니까?」
			PRINTFORMDW 랜의 태도가 완전히 변했다. 그녀가 마스터에게 보이는 공순과 존경심이 분명하게 드러났다.
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;橙が入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 24
		IF TALENT:恋慕
			;橙が恋慕持ち
			IF TALENT:24:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아, 첸이 있네!」
						PRINTFORMDW 란은 네 팔을 등 뒤로 감았고, 첸은 그녀에게 다가가려 너 주위를 뛰어다녔다.
					CASE 1
						PRINTFORML 「오, 첸! 정말 절묘한 타이밍이군.」
						PRINTFORMDW 너희와 란은 첸이 두 사람 사이를 달려올 때 그녀를 반긴다.
					CASE 2
						PRINTFORML 「첸, 이쪽으로 와!」
						PRINTFORMDW 첸은 환하게 미소 지으며 당신에게 반쯤 달려왔다.
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「뭐야, 천? 나 특별히 이상한 거 안 하고 있어.」
						PRINTFORMDW 난 자기 식신한테 당황하는 건 드문데.
					CASE 1
						PRINTFORML 「와! 얼마나 거기 있었어?」
						PRINTFORMDW 랜은 문 뒤에서 응시하는 첸을 갑자기 알아차렸다.
					CASE 2
						PRINTFORML 「%CALLNAME:MASTER%. 반드시 예의를 지켜라. 내가 보고 있다.」
						PRINTFORMDW 첸이 바보 같은 것을 따라 하면 랜이 너를 고통받게 할 것이다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕
			PRINTFORML 「아, 무슨 일이야, 첸?」
			PRINTFORMDW 첸은 란의 팔을 붙잡고 당신에게 날카로운 시선을 보내고 있다.
		ELSE
			PRINTFORML 「오, 천.」
			PRINTFORMDW 란은 당신에게서 시키가미 쪽으로 시선을 돌렸다.
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
