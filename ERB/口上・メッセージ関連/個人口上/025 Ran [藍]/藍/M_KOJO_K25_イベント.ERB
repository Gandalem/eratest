@M_KOJO_EVENT_K25_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;四季ごとに朝昼晩
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		;一日一回
		SIF TCVAR:25:350 == 1
			RETURN 1
		IF TALENT:恋慕
			;DAY:2で季節を選択
			SELECTCASE DAY:2
				;春
				CASE 1
					;TIME:2で朝昼晩を選択
					SELECTCASE TIME:2
						;朝
						CASE 1,2
							PRINTFORML 「%CALLNAME:MASTER%-님. 좋은 아침이야.」
							PRINTFORML 「아니면 격식 있는 인사가 싫은 거야?」
							PRINTFORMDW 네가 어색하게 서 있는 것을 보고 란이 웃었다.
							;昼
						CASE 3,4
							PRINTFORML 「안녕, %CALLNAME:MASTER%.」
							PRINTFORMW 「이맘때는 정말 좋네. 밖에 나가기 딱 좋은 날씨야.」
							;夜
						CASE 5,6,7
							PRINTFORML 「좋은 저녁이에요, %CALLNAME:MASTER%.」
							PRINTFORMW 「춘분이 지났을지 몰라도 밤은 여전히 차네요. 부디 몸조심하세요.」
					ENDSELECT
					;夏
				CASE 2
					SELECTCASE TIME:2
						;朝
						CASE 1,2
							PRINTFORML 「좋은 아침이에요, %CALLNAME:MASTER%.」
							PRINTFORML 「요즘 낮과 밤 모두 더워졌는데, 밤에 잠자리에 드는 데 어려움이 있나요?」
							PRINTFORMDW 랜은 언제나 시원해.
							;昼
						CASE 3,4
							PRINTFORML 「좋은 오후네요. 오늘 좀 더운 것 같지 않아요?」
							PRINTFORML 「이런, 당신 정말 땀을 많이 흘렸군요. 제가 닦아드릴게요.」
							PRINTFORMDW 랜(Ran)은 당신의 이마에서 땀을 깨끗하게 닦아준다.
							;夜
						CASE 5,6,7
							PRINTFORML 「아, %CALLNAME:MASTER%. 더위 속에 시들지 않았군.」
							PRINTFORML 「드디어 하루가 끝나서 선선해졌어. 이제 즐길 시간이야～」
							PRINTFORMDW 여름 동안 그렇게 할 기회가 많지 않기에, 란은 당신 옆으로 다가섰다.
					ENDSELECT
					;秋
				CASE 3
					SELECTCASE TIME:2
						;朝
						CASE 1,2
							PRINTFORML 「만나서 반가워, %CALLNAME:MASTER%.」
							PRINTFORMW 「건강에 소홀히 하지 마. 가끔 대나무 숲의 의사에게 진찰을 받는 것은 좋은 생각이야.」
							;昼
						CASE 3,4
							PRINTFORML 「음... 바람에 은행나무 향이 나지 않아?」
							PRINTFORML 「나 이거 질려. 날 구해주길～」
							PRINTFORMDW 란은 네 목에 얼굴을 묻고, 사랑스럽게 코를 킁킁거리고 몸을 떨었다.
							;夜
						CASE 5,6,7
							PRINTFORML 「안녕, %CALLNAME:MASTER%.」
							PRINTFORML 「저것 좀 들어봐! 귀뚜라미들이 수다를 떨고 있어.」
							PRINTFORMDW 두 사람은 그 듣기 좋은 소리를 우아하게 듣는다.
					ENDSELECT
					;冬
				CASE 4
					SELECTCASE TIME:2
						;朝
						CASE 1,2
							PRINTFORML 「안녕, %CALLNAME:MASTER%... 어?」
							PRINTFORML 「좀 갑작스럽네. 하지만 상관없어.」
							PRINTFORMDW 당신은 Ran의 복슬복슬한 꼬리에 차가운 손을 파묻는다.
							;昼
						CASE 3,4
							PRINTFORML 「오늘 쌀쌀하네요, 그렇죠, %CALLNAME:MASTER%?」
							PRINTFORML 「음, 그럼 좀 더 가까이 와요. 마음을 따뜻하게 해줄 테니까.」
							PRINTFORMDW 랜의 복슬복슬한 꼬리 중 하나가 당신의 목을 감쌌다.
							;夜
						CASE 5,6,7
							PRINTFORML 「으음~ 추워졌네...」
							PRINTFORML 「털을 입고 있어도 뼈를 깎는 듯하다.」
							PRINTFORMW 「이런 때에는 인간의 피부가 최고지. 그렇지 않니?」
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORML 「%CALLNAME:MASTER%? 만나서 반갑다.」
			PRINTFORMDW 랜은 친근한 미소로 당신에게 인사한다.
		ELSE
			PRINTFORML 「안녕.」
			PRINTFORMDW 란이 당신을 알아보고 살짝 손을 흔든다.
		ENDIF
		TCVAR:25:350 = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTL
		IF TALENT:恋慕
			PRINTFORML 「오, 당신이군요, %CALLNAME:MASTER%.」
			PRINTFORML 「음. 보러 왔어요.」
			PRINTFORMDW 란은 밝은 표정으로 당신에게 다가온다.
		ELSEIF TALENT:思慕
			PRINTFORML 「Oh? %CALLNAME:MASTER%.」
			PRINTFORMDW 그녀를 보는 순간, 랜의 얼굴이 환해진다.
		ELSE
			PRINTFORML 「오랜만이야.」
			PRINTFORMDW Ran이 캐주얼하게 인사한다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTL
		IF TALENT:恋慕
			PRINTFORML 「어머, %조사처리(CALLNAME:MASTER,"가")% 아니면 안 되는데.」
			PRINTFORMDL 문이 열리더니 벌거벗은 랜이 목욕타월을 들고 들어왔다.
			PRINTFORMDL 그녀는 스스로 미소를 지으며 흔들리는 가슴을 숨기려 하지 않았다.
			PRINTFORML 「같이 들어가자, 이런 일 자주 있는 건 아니잖아. 반대 안 해?」
			PRINTFORMDW 당신은 망설임 없이 고개를 끄덕였다.
		ELSE
			PRINTFORML 「아, 벌써 누군가 여기 있네.」
			PRINTFORMDL 랜이 화장실 문을 연다.
			PRINTFORMDL 그녀의 수건은 통통한 몸을 조금도 가리지 못하고, 잘 익은 가슴이 자유롭게 흔들리며 당신에게 다가온다.
			PRINTFORML 「여기가 좀 비어 보이는데, 옆에 앉아도 괜찮겠지?」
			PRINTFORMDW 물론, 당신은 그녀에게 대답한다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMDL 문이 열리고 누군가 욕실로 들어온다.
		PRINTFORMDL 그곳은 몸에 작은 수건 하나만 걸친 Ran이었다.
		PRINTFORMDL 그 수건은 그녀의 모든 곡선이 담긴 통통한 몸에는 너무 작아서, 유두와 아래쪽 부분이 완전히 노출되어 있었다.
		PRINTFORML 「누군가 벌써 목욕 중이군요. 실례하겠습니다.」
		PRINTFORMDW 시키가미는 미동조차 없이 문을 뒤로 빠져나와 닫았다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
