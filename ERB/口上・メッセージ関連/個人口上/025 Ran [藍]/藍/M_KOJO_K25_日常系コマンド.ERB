;==================================================
;405,出掛ける(同行時デートに出掛ける
;==================================================

@M_KOJO_MESSAGE_COM_K25_405
;出掛けるにTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K25_405_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K25_405_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	SIF FLAG:時間停止 ;fix
		RETURN 0
	;デート。博麗神社が住まいの時は何故か読まれない
	IF CFLAG:同行
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「느긋하게 걸으면 결국 도착할 거야.」
					PRINTFORMDL 랜은 당신의 바로 뒤를 따른다.
					PRINTFORMDW 자, 오늘은 어디로 갈까?
				CASE 1
					PRINTFORML 「음... 안전하게 가려면 그 길은 피하는 게 좋겠어. 거기선 단막 배틀이 벌어지고 있는데, 그냥 구경할 수 있는 수준이 아니거든.」
					PRINTFORML 「아니면, 어쩌면 그게 더 재미있을지도?」
					PRINTFORMDW 데이트가 아닌 것이 될 테니 안전한 길을 선택한다.
				CASE 2
					PRINTFORML 「바깥세상으로 산책이라도 갈까?」
					PRINTFORML 「마치~ 네가 특혜를 받지 않을 것처럼.」
					PRINTFORMDW 그것이 성립되려면 어떤 준비를 해야 할 것이다.
			ENDSELECT
		ELSEIF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신이 그녀에게 데이트를 신청하면 Ran은 흔쾌히 동의한다.
					PRINTFORML 「그래서, 오늘은 어디로 갈까?」
					PRINTFORMDW 당신은 발끝을 길 쪽으로 돌려 대답했다.
				CASE 1
					PRINTFORML 「그거 좋네, 마침 시간이 좀 비었거든.」
					PRINTFORMDL 항상 바빠 보이는 Ran에게 정말 괜찮은지 물어봤다.
					PRINTFORMW 「나 자신을 위해 시간을 내는 건 쉬워. 괜찮아, 걱정하지 마.」
				CASE 2
					PRINTFORML 「당신이 마음껏 아름다운 것들을 볼 수 있는 장소들을 알고 있어요.」
					PRINTFORML 「그리고 두 사람이 함께 혼자 있을 수 있는 곳도 있고요.」
					PRINTFORMDW 근세 동안 환상향의 유지 보수를 해온 랜만이 그런 데이트 명소를 저렇게 잘 알 리가 없었다.
			ENDSELECT
		ELSE
			PRINTFORML 「데이트? 음, 내가 같이 가줄게.」
			PRINTFORMDL 당신이 자신의 스케줄에 맞는지 물어보자 랜은 고개를 끄덕인다.
			PRINTFORMDW 그녀와의 관계를 깊게 만들 좋은 기회다. 하지만 조심스럽고 정중하게 진행해야 한다.
		ENDIF
		;非同行時。此方の分岐は問題なく読まれる
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「무사히 돌아와야 해. 그렇지 않으면 나 울게 될 거야.」
			PRINTFORMDW 랜은 장난스럽게 손을 흔들었지만, 그녀의 말 속에는 어딘가 진지한 기운이 남아 있었다.
		ELSEIF TALENT:思慕
			PRINTFORML 「안전한 길로 가도록 해-」
			PRINTFORMDW 너는 Ran에게 외출한다고 말했고, 그녀는 너를 배웅한다.
		ELSE
			PRINTFORML 「외출하는 거야? 길 조심해.」
			PRINTFORMDW 랜은 손을 흔들며 당신을 배웅한다.
		ENDIF
	ENDIF
	PRINTL 
ENDIF
RETURN 1
;==================================================
;410,掃除
;==================================================

@M_KOJO_MESSAGE_COM_K25_410
CALL M_KOJO_MESSAGE_COM_K25_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K25_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMDL 약간의 상상력만 있다면 이 힘은 많은 일에 사용될 수 있다.
		PRINTFORMDW 움직이지 않는 먼지를 쓰레기봉투로 모았다.
	ELSEIF CFLAG:睡眠
		PRINTFORMDL 잠든 랜 주변을 정리한다.
		PRINTFORMDW 깨어있다면 스스로 치울 일이라 별것 아닌 친절이다.
	ELSEIF CFLAG:うふふ
		IF TALENT:恋慕
			PRINTFORMDL 어수선함이 당신을 불안하게 만들기 때문에, 당신은 청소하면서 Ran의 노려봄을 견딘다.
			PRINTFORML 「네 기분이 뭔지 모르겠어... 아니, 전혀 모르겠다고, 이 바보야.」
			PRINTFORMDW 그녀는 이런 방치극 형태를 감상할 수 없는 것 같았다.
		ELSE
			PRINTFORMDL 어지러움 때문에 불편해하는 당신은 청소하면서 Ran의 노려봄을 견딘다.
			PRINTFORML 「왜 이걸 하고 있는 거야?」
			PRINTFORMDW 여우의 꼬리가 바닥에 부딪히고, 먼지를 사방으로 날리니 그녀가 멈춰주기를 바라게 된다.
		ENDIF
	ELSE
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「좋아, 내가 도와줄게. 모든 걸 나한테 맡겨.」
					PRINTFORMDW 그녀가 그렇게 말했음에도 불구하고 너와 란은 소매를 걷는다.
					PRINTL 
					CALL AddEXP("清掃経験", TARGET, 1)
					CALL AddEXP("清掃経験", MASTER, 1)
				CASE 1
					PRINTFORML 「흥! 수 세기 동안 혼자 가사노동을 하며 재능을 연마했으니, 지켜보시지.」
					PRINTFORMDL 랜은 청소에 관해서는 당신에게 질 생각이 없는 모양이다.
					PRINTFORMDW 당신과 시키가미들이 누가 더 많이 치우는지 경쟁하는 것 같군.
					PRINTL 
					CALL AddEXP("清掃経験", TARGET, 1)
					CALL AddEXP("清掃経験", MASTER, 1)
				CASE 2
					PRINTFORML 「청소의 정수는... 이렇다. 일단 강의는 그만두자.」
					PRINTFORML 「모든 것은 그것을 어떻게 실천하느냐에 달려있다. 시작해라!」
					PRINTFORMDW 그리고 그렇게, 두 마스터 청소부들은 열정적인 청소 배틀을 시작했다...!
					PRINTL 
					CALL AddEXP("清掃経験", TARGET, 2)
					CALL AddEXP("清掃経験", MASTER, 2)
			ENDSELECT
		ELSE
			PRINTFORML 「열심히 일하되, 적당히 하라.」
			PRINTFORMDW 랜은 당신을 우아하게 도와준다.
		ENDIF
	ENDIF
	PRINTL 
ENDIF
RETURN 1
;==================================================
;411,戦闘訓練
;==================================================

@M_KOJO_MESSAGE_COM_K25_411
CALL M_KOJO_MESSAGE_COM_K25_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K25_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;各スペルカードごとにあなたの戦闘能力で分岐(4以上回避、3はギリギリ、2以下被弾)
	;真言は適当に検索したもの。カッコが付けばなんでもよし！
	IF TALENT:恋慕 || TALENT:恋人
		PRINTFORML 「좋아, 가자. 정신을 바짝 차릴 시간이야!」
		PRINTL 
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「반전의 은하수처럼 비상하라.」
				PRINTFORMW 「『솟아오르는 빛의 별』이다!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 초인적인 고속 돌진을 포착하고 그것을 제압한다.
					PRINTFORMW 「잘했어! 다음엔 전투 같은 연습이라도 해 볼까?」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 랜은 가속하며 점점 더 빨라지고, 나비 탄막으로 당신을 구석으로 몰아넣고 마침내 명중시킨다.
					PRINTFORMW 「끝까지 침착해야 해. 맞으면 아플 뿐이니까.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSE
					PRINTFORMDL 랜은 불가능한 속도로 날아오더니 당신을 날려버린다.
					PRINTFORMW 「걸어서 도망치려고? 꼭 그렇게 해보고 싶네!」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ENDIF
			CASE 1
				PRINTFORML 「나우마쿠 사만다 바자단 간。」
				PRINTFORMW 「『팔천만 고마 보드』!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 단막(弾幕)이 당신 주변 모든 것을 매력으로 가득 채우지만, 당신은 그것을 포착한다.
					PRINTFORMW 「완벽해. 단막에 관해서는, 대부분의 사람들은 천천히 받아들이는 방법을 모른다는 걸.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 계속해서 매력적인 공격들을 피했지만, 반격하는 것이 불가능하다.
					PRINTFORMW 「완벽하진 않아. 나쁘지는 않지만, 개선할 수 있는 몇 가지 부분이 있어.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSE
					PRINTFORMDL 거대한 부채 모양의 마법진 벽이 당신을 완전히 짓누른다.
					PRINTFORMW 「보시다시피, 안전지대는 내 뒤에 있다. 이놈을 어떻게 잡을 셈이지?」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ENDIF
			CASE 2
				PRINTFORML 「치라치라야 소와칼에게.」
				PRINTFORMW 「『이즈나공정의 강림』이다!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 다가오는 탄막을 헤치며 가능한 한 세게 집중한다.
					PRINTFORMW 「좋은 움직임이야. 목표를 더 높이 설정해 봐.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 총알이 당신에게 명중하기 전에 안전해지는 것이 한 걸음 남았군.
					PRINTFORMW 「유감이지만, 너는 나아지고 있어.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSE
					PRINTFORMDL 폭력적인 단막(彈幕)이 당신을 서서히 몰아넣은 후 완전히 압도한다.
					PRINTFORMW 「이것을 이길 비결은 없어, 그저 단순한 기술뿐이야. 계속 연습해서 실력을 향상시켜.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ENDIF
			CASE 3
				PRINTFORML 「나무 쿠비라다이쇼 나무 바사라다이쇼 나무 메키라다이쇼...」
				PRINTFORMW 「'열두 장군신의 만찬'!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 당신은 동시에 공격하고 자신감 있게 회피하며 그녀의 스펠 카드를 짧은 시간에 포획한다.
					PRINTFORMW 「훌륭하군. 하지만 목표를 더 높게 설정해라.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 당신은 단막을 향해 소리치며 도전하고, 약간의 운으로 그것을 피하는 데 성공한다.
					PRINTFORMW 「그래, 남자의 기개를 보여줘!」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSE
					PRINTFORMDL 엄청난 수의 총알이 당신을 혼란스럽게 하고, 당신은 맞는다.
					PRINTFORMW 「포기하면 피할 방법은 없어. 네 눈을 믿어.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ENDIF
		ENDSELECT
	ELSE
		PRINTFORML 「좋아, 가볍게 운동하자.」
		PRINTL 
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「오미 키리카쿠 소와카.」
				PRINTFORMW 「『다키니텐 채널링』!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 침착하게, 너는 구체의 틈을 빠져나간다.
					PRINTFORMW 「내 움직임을 알아챘다고? 그렇게 쉽지는 않을 텐데.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 여러 번 구석으로 몰렸음에도 불구하고, 당신은 단막을 피하는 데 성공한다.
					PRINTFORMW 「꽤 좋군. 자네가 그것을 포획할 수 있다는 건 의심의 여지가 없으니까.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ELSE
					PRINTFORMDL Ran의 움직임을 따라갈 수 없고, 격추당한다.
					PRINTFORMW 「포위되더라도 당황하지 말고, 탈출할 방법을 빠르게 생각해라.」
				ENDIF
			CASE 1
				PRINTFORML 「재미있게 놀아보자.」
				PRINTFORMW 「『최후의 불교』!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 패턴이 바뀌기 때문에 완전히 회피한다.
					PRINTFORMW 「우리는 아직 정상이다.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 너는 아무 문제 없이 회피한다.
					PRINTFORMW 「하나를 피했더라도 다음 공격에 방심하고 맞을 수 있다.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ELSE
					PRINTFORMDL 레이저가 갑자기 방향을 틀어 너를 맞춘다.
					PRINTFORMW 「후, 공포에 질렸니?」
				ENDIF
			CASE 2
				PRINTFORML 「이것으로 포기하게 만들 셈인가?」
				PRINTFORMW 「『사방에서 몰아치는 매혹적인 공성전』이다!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 계속 눈을 뜨고 큰 공들을 피하면서 역습을 퍼부었다.
					PRINTFORMW 「만점이다. 이 카드는 더 이상 통하지 않을 거다.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 보고 있는 것에 혼란스러워하면서도, 어떻게든 총알을 피한다.
					PRINTFORMW 「좀 불안했어. 충분히 경험이 많은 인상으로는 안 되는데.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ELSE
					PRINTFORMDL 즉시 피격당한다.
					PRINTFORMW 「네가 잘못된 곳을 보고 있는 것 같아. 적어도 나는 그렇게 생각하거든.」
				ENDIF
			CASE 3
				PRINTFORML 「너한테 살살 해 줄게.」
				PRINTFORMW 「'센코 사려 깊은 명상'!」
				PRINTW 
				IF ABL:MASTER:戦闘能力 >= 4
					PRINTFORMDL 당신은 공격 전체를 손쉽게 피한다.
					PRINTFORMW 「그건 너한테 너무 쉬웠어.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 2)
				ELSEIF ABL:MASTER:戦闘能力 == 3
					PRINTFORMDL 실제 위험에 처하지 않고 회피한다.
					PRINTFORMW 「후후, 너는 초보가 아니군.」
					PRINTL 
					CALL AddEXP("戦闘経験", MASTER, 1)
				ELSE
					PRINTFORMDL 거의 즉시 공격을 받는다.
					PRINTFORMW 「당신은 당황했나요? 단막에서 가장 중요한 것은 침착함을 유지하는 것입니다.」
				ENDIF
		ENDSELECT
	ENDIF
	PRINTL 
ENDIF
RETURN 1
