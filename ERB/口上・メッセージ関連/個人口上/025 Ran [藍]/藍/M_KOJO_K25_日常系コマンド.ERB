@M_KOJO_MESSAGE_COM_K25_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	;藍様の料理技能は初期で3
	IF ABL:MASTER:料理技能 >= 4
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「음흠.」
				PRINTFORML 「굉장한 기술이군. 연구해봐야겠어.」
			CASE 1
				PRINTFORML 「맛있다. 대체 어디서 이런 육수를 구한 거야?」
			CASE 2
				PRINTFORML 「무무무, 이건 어찌나 잘 익고 향이 풍기는 건지...?」
				PRINTFORML 「아마, 사케에 절인 과일 같은 거겠지... 감 견과류! 그거 맞지?」
			CASE 3
				PRINTFORML 「이봐, 부엌 구석에 있는 이 초록색 더미는 뭐야?」
				PRINTFORML 「이렇게 요리 재료를 보는 건 처음이야... 이름이 뭐지?」
				PRINTFORMDL 마타데.
			CASE 4
				PRINTFORML 「네, 완벽하게 익었어요.」
				PRINTFORML 「저도 요즘 좀 나아진 것 같아요.」
		ENDSELECT
		PRINTL 
		PRINTFORMDW 당신과 란은 서로의 요리기능을 비교했고, 둘 다 그 결과 향상되었다.
		PRINTL 
		CALL AddEXP("料理経験", MASTER, 2)
		CALL AddEXP("料理経験", TARGET, 2)
	ELSEIF ABL:MASTER:料理技能 == 3
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「소금 한 꼬집이 맛을 완전히 바꿀 수 있다. 그것이 일본 요리이다.」
			CASE 1
				PRINTFORML 「마법으로 얼리기 전에 자르지 않으면 안 되는 건가... 잠깐, 그럴 수는 없겠지, 그렇지?」
			CASE 2
				PRINTFORML 「중식은 화력이 전부다. 그건 나에게 맡기시게나.」
			CASE 3
				PRINTFORML 「맛을 좀 보자. 소금을 조금 더 넣어야 할까?」
			CASE 4
				PRINTFORML 「단순한 이론만으로는 맛있는 음식을 만들 수 없다. 좋은 요리로 가는 길은 흥미로운 것이다.」
				PRINTFORML 「물론, 연모만으로도 충분하지 않다.」
		ENDSELECT
		PRINTL 
		PRINTFORMDW 당신과 란은 나란히 서서 요리를 한다.
		PRINTL 
		CALL AddEXP("料理経験", MASTER, 1)
		CALL AddEXP("料理経験", TARGET, 1)
	ELSEIF ABL:MASTER:料理技能 == 2
		SELECTCASE RAND:3
