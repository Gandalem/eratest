;12,パイズリフェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K25_12
CALL M_KOJO_MESSAGE_SCOM_K25_12_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K25_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신의 애액이 그녀의 가슴을 타고 흐르며 그 사이로 미끄러져 들어간다.
					PRINTFORMDL 마지막으로 깊숙이 박아 넣으며, 당신은 그녀의 윗잇몸에 문지르면서 탁한 정액을 분출하기 시작한다.
				CASE 1
					PRINTFORMDL 당신은 랜의 가슴 구멍에서 빠져나와 벌어진 그녀의 입안으로 그것을 밀어넣는다.
					PRINTFORMDL 당신은 소변기 같은 곳에 오줌 싸듯 그녀의 입속에 사정한다.
				CASE 2
					PRINTFORMDL 당신은 만족할 정도로 랜의 가슴의 감촉을 즐긴 후, 자신의 정액을 배출하기 시작한다.
					PRINTFORMDL %BREAKENG(@"그녀의 입술에 대고, 너는 사정 후 또 사정을 그녀의 입안으로 밀어 넣고, 손을 사용해 네 자지에서 모든 것을 짜내면서 약간 새어 나오게 한다.")%
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 그녀의 가슴 사이로 밀고 들어가면서 손가락으로 랜의 단단한 유두를 문지르고, 당신의 끝이 그녀의 입술에 닿는다.
					PRINTFORMDL 자극에 만족하지 못하고, 당신은 그녀의 혀를 빼내 그것을 비비며 매끄러운 근육이 당신의 성기를 감싸게 한다.
				CASE 1
					PRINTFORMDL 예상대로, 란의 협조 없이는 좀 어렵다.
					PRINTFORMDL 당신은 그녀의 유두를 잡고 서로 비빈 후, 머리를 그녀의 입술에 부딪힌다.
				CASE 2
					PRINTFORMDL 당신은 랜의 가슴골 위로 거시기를 밀어 넣어 그녀의 입속으로 넣고, 마치 그녀가 당신을 핥는 것 같다.
					PRINTFORMDL 정액을 담기 위해 만들어진 그녀의 유두구의 질감을 음미하며, 당신은 마음껏 즐긴다.
			ENDSELECT
			RETURN 1
		ENDIF
	ELSEIF TALENT:恋慕 || MARK:不埒刻印 == 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 네가 절정에 다다르기 직전에, 랜은 가슴을 세게 움켜쥔다.
					PRINTFORMDL 그녀는 입술로 너의 머리를 감싸고 모든 정액을 빨아들인다...
				CASE 1
					PRINTFORMDL 절정에 달할 것 같은 느낌에 랜의 가슴을 움켜쥔다.
					PRINTFORMDL 그 길이 그녀의 부드러운 살에 감싸여 있고, 당신이 그녀의 입안으로 사정을 시작하자 그녀는 순종적으로 고개를 숙인다.
				CASE 2
					PRINTFORMDL 당신은 랜의 가슴으로 즐거워하며, 절정에 이를 것 같은 감각과 함께 당신의 길이가 완전히 감싸지는 것을 느낀다.
					PRINTFORMDL 여우는 정액이 그녀의 혀에 분출되기 시작하자 순종적으로 입을 연다.
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「네 성기가 좀 더 크면 쉬울 텐데-」
					PRINTFORMDL 란은 비웃듯이 웃으며 혀를 내밀고 네 요도 길이를 핥았다.
				CASE 1
					PRINTFORMDL %BREAKENG(@"네 가슴 사이에 네 성기가 잡혀 있고, 그녀는 손으로 그것을 위아래로 움직이며 입과 혀로 귀두를 감싸고 있다.")%
					PRINTFORMDL 훌륭하고 부드러운 서비스가 정말 신의 경지 같다.
				CASE 2
					PRINTFORML 「아직도 버티고 있나? 그렇다면, 내가 이걸 하면 어떨까?」
					PRINTFORMDL 란이 네 성기를 혀로 간지럽히고 단단해진 유두를 만진다. 내부의 부드러움과 대비되는 감각이 너를 자극한다.
			ENDSELECT
			RETURN 1
		ENDIF
	ELSE
		PRINTFORMDL 랜은 그녀의 탐스러운 가슴 전체의 무게를 당신의 사타구니에 기댄다.
		PRINTFORMDL 그녀는 계곡에서 살짝 보이는 당신의 성기 끝을 침착하게 핥는다.
		RETURN 1
	ENDIF
	PRINTW 
ENDIF
