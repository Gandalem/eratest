@M_KOJO_MESSAGE_SCOM_K25_7
CALL M_KOJO_MESSAGE_SCOM_K25_7_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K25_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 움직이지 않는 Ran과 연결을 심화시키며 그녀와 완전히 결합한다.
					PRINTFORMDL 그녀의 자궁경부는 입술을 오므리고 당신의 따뜻한 정액을 마음껏 받아들인다.
				CASE 1
					PRINTFORMDL 너는 방어 없는 랜의 살 구멍 깊숙이 박히면서 허리짓을 멈춘다.
					PRINTFORMDL 정액은 그녀의 자궁 속으로 분출되기 시작하며, 빠르게 네 씨앗으로 무거워진다.
				CASE 2
					PRINTFORMDL 당신의 거기는 흥분의 정점에 도달했고, 그 머리는 한계까지 부풀어 올랐다.
					PRINTFORMDL 너 역시 한계에 도달했기에, 온 힘을 다해 Ran의 자궁 속으로 쏟아낸다.
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 랜의 주름을 밀고 파고들며 끝으로 그녀의 자궁경부에 도달한다.
					PRINTFORMDL 당신은 여우의 약점을 두드리면서 그녀는 완전히 움직이지 않은 채로 있다.
				CASE 1
					PRINTFORMDL 랜의 몸은 떨리는 아랫입을 제외하고는 얼어붙어 있었는데, 그것은 지극히 음란한 대조를 이루었다.
					PRINTFORMDL 너는 길고 깊게 문지르며 그녀의 성기가 주변에 흘러내릴 때 자궁경부까지 도달한다.
				CASE 2
					PRINTFORMDL 그녀의 약점을 아무리 공격해도 랜은 완전히 태연하다.
					PRINTFORMDL 당신은 그녀의 난해한 문을 계속 두드리며 그녀의 황금빛 눈을 응시한다.
			ENDSELECT
			RETURN 1
		ENDIF
	ELSEIF TALENT:恋慕 || MARK:不埒刻印 == 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「Nn...」
					PRINTFORMDL 당신은 온 힘을 다해 랜의 자궁을 밀어붙이고, 물총으로 사정하듯 그 안에 사정한다.
				CASE 1
					PRINTFORMDL 도뷰우~ 도뷰우~ 도뷰우~ 도뷰우~ 도뷰우~
					PRINTFORMDL 쌓여 있던 사정이 힘을 과시하며 정액을 연의 자궁 속으로 반복해서 쏘아댄다.
				CASE 2
					PRINTFORMDL 충동이 밀려오자, 당신은 온 힘을 다해 Ran을 끌어안고 당신의 끝을 그녀의 자궁경부에 밀어붙인다.
					PRINTFORMDL 당신은 농후정액을 강렬한 힘으로 그녀에게 쏟아붓는다.
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 따뜻하고 포근한 그녀의 안쪽 구멍 깊숙이 난 란의 자궁 경부를 자극하기 시작한다.
					PRINTFORML 「아앗! 그-거기 말고, 하지 마......!」
				CASE 1
					PRINTFORML 「오, 우우, 아, 음... 으음...」
					PRINTFORMDL 네가 란의 자궁을 건드릴 때마다 또 다른 숨이 그녀의 입술 사이로 새어 나왔다.
				CASE 2
					PRINTFORMDL 리듬 없이 가능한 한 깊숙이 란의 안쪽을 박아 넣는다.
					PRINTFORMDL 그녀의 몸은 경직되고 벽들이 네 것을 감싸 조여온다.
			ENDSELECT
			RETURN 1
		ENDIF
	ELSE
		PRINTFORMDL 당신은 Ran의 내부에 깊숙이 박히고, 그녀의 벽은 당신을 초대하며 탐욕스럽게 빨아들인다.
		PRINTFORMDL Ran은 당신이 그녀 안으로 밀어 넣기 쉽게 골반을 살짝 들어 올리고, 당신이 피스톤질할수록 그녀의 매력적인 신음소리는 더 커진다.
		RETURN 1
	ENDIF
	PRINTW 
ENDIF
