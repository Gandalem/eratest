;==================================================
;5,手淫フェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K96_5
CALL M_KOJO_MESSAGE_SCOM_K96_5_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K96_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 라이코의 구강을 범하기 시작했다.
		ELSE
			PRINTFORMW 「...응츄...응...」
			PRINTFORMW 「앗... 잔뜩 내줘...%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 라이코의 손에 음경을 잡히게 한 채 구강을 범하기 시작했다.
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응... 츄...」
			PRINTFORMW 「...할래...? 나올 것 같은데...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽... 응...」
			PRINTFORMW 「...쭈욱... 음...」
		ELSE
			PRINTFORMW 「윽... 주부...」
			PRINTFORMW 「...응... 짜내 줄게...%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아... 으르릉...」
			PRINTFORMW 「...응... 츄...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭈욱... 음...」
			PRINTFORMW 「응... 괴로워...」
		ELSE
			PRINTFORMW 「...제대로 씻고 있니?」
			PRINTFORMW 「깨끗하게 해 줄게...」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「윽... 츄릅...」
			PRINTFORMW 「응... 이거...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……윽…」
			PRINTFORMW 「……응……주륵……」
		ELSE
			PRINTFORMW 「...음...」
			PRINTFORMW 「으르렁...음...」
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K96_{SELECTCOM}_1
RETURN 1
;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K96_6
CALL M_KOJO_MESSAGE_SCOM_K96_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K96_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 라이코의 질 안에 성기를 넣었다 빼고 있다.
		ELSE
			PRINTFORMW 「거기... 응...!」
			PRINTFORMW 「응... 아아... 앗...!」
			PRINTFORMDW 그 은밀한 곳에 %조사처리(CALLNAME:MASTER,"의")% 음경이 천천히 삽입되어 갔다...
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 라이코를 깊이 범하기 시작했다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 라이코의 질 안에 성기를 넣었다 빼고 있다.
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응아... 응...%UNICODE(0x2665) *1%」
			PRINTFORMW 「...앗...%UNICODE(0x2665) *1%」
			PRINTFORMDW 라이코는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽...!」
			PRINTFORMW 「...앗...흐읍...%UNICODE(0x2665) *1%」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「윽... 아... %UNICODE(0x2665) *1%」
			PRINTFORMW 「아... 응... %UNICODE(0x2665) *1%」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응 아...」
			PRINTFORMW 「...거기... 너무...!」
			PRINTFORMDW 라이코는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽…윽…」
			PRINTFORMW 「아…앗…!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「윽…아…」
			PRINTFORMW 「…아…응…!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「아... 응...」
			PRINTFORMW 「...후앗...!」
			PRINTFORMDW 라이코는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽…」
			PRINTFORMW 「……응읏…!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「...아...」
			PRINTFORMW 「윽...응...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K96_{SELECTCOM}_1
RETURN 1
