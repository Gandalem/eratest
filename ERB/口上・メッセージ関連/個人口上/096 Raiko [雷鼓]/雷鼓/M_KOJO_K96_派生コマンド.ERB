@M_KOJO_MESSAGE_SCOM_K96_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;時姦中
		IF FLAG:70
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 라이코의 비부에 음경을 삽입하기 시작했다.
		ELSE
			PRINTFORMW 「윽... 깊은 곳... 와 있어... %UNICODE(0x2665) *1%」
			PRINTFORMDW 그 은밀한 곳에 %조사처리(CALLNAME:MASTER,"의")% 음경이 천천히 삽입되어 갔다...
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 라이코를 깊이 범하기 시작했다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 라이코의 비밀 부위에 음경을 삽입하기 시작했다.
	ELSEIF NOWEX:PLAYER:11 && TEQUIP:体位 == 1
		IF RAND:6 == 0
			PRINTFORMW 「응읏%UNICODE(0x2661) *1%아앗%UNICODE(0x2661) *1%」
			PRINTFORMDW 라이코는 행위에 신음하고 있다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「앗%UNICODE(0x2661) *1%응앗%UNICODE(0x2661) *1%」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 「앙%UNICODE(0x2661) *1% 야아앗%UNICODE(0x2661) *1%」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「으응%UNICODE(0x2661) *1%후아앗%UNICODE(0x2661) *1%」
			PRINTFORMDW 라이코는 행위에 숨을 헐떡이고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗%UNICODE(0x2661) *1%응읏%UNICODE(0x2661) *1%」
			PRINTFORMDW 라이코는 격렬한 행위에 헐떡이고 있다.
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2661) *1% 후아앗%UNICODE(0x2661) *1%」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응아... 후우...」
			PRINTFORMW 「...응! 아앗!」
			PRINTFORMDW 라이코는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽... 크아...!」
			PRINTFORMW 「...안...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「아... 앗...」
			PRINTFORMW 「응 아... 윽...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아... 크...」
			PRINTFORMW 「...이거... 가장 깊숙한 곳까지... 아윽...!」
			PRINTFORMDW 라이코는 행위에 신음하고 있었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「윽...!」
			PRINTFORMW 「...응앗...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「...아...」
			PRINTFORMW 「...흐으...응...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응윽... 아...!」
			PRINTFORMW 「...앗...!」
			PRINTFORMDW 라이코는 행위에 신음하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흡...윽...」
			PRINTFORMW 「...앗...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ELSE
			PRINTFORMW 「앗... 응...」
			PRINTFORMW 「크윽... 히앗...!」
			PRINTFORMDW 라이코는 격렬한 행위에 신음하고 있다.
		ENDIF
	ENDIF
ENDIF
