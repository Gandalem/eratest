			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 이거 좋아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「윽%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응! %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「더 입으로…… %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
