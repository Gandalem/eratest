		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 라이코는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「엉덩이읏%UNICODE(0x2665) *1% 안 돼앳%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 엉덩이읏%UNICODE(0x2665) *1% 느껴버려앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「더 항문 자극해주고 싶어!! %UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「으응읏%UNICODE(0x2665) *1%엉덩이 더 괴롭혀 줘앗%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「좀 더엇%UNICODE(0x2665) *1% 엉덩이 기분 좋게 해줘엇%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 라이코는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「잠깐읏%UNICODE(0x2665) *1%가슴은 약하단 말이야앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%언니, 가슴은 약하니까앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「그렇게 가슴만...%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%%UNICODE(0x2665) *1%」
