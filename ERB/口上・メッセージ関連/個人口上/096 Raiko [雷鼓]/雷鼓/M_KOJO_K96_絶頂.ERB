		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 라이코는 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 갈 것 같아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 가버려앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1% 기분 좋아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 좀 더엇%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
