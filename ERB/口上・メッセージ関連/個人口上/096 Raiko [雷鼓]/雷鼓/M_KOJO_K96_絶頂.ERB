@M_KOJO_MESSAGE_PALAMCNG_A_K96_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 라이코의 구강에 정액을 토해냈다.
	ELSEIF TALENT:MASTER:濃厚精液
		IF RAND:3 == 0
			PRINTFORMW 「음... 많이 모아뒀었구나...」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...자위 금지 중에도 하고 있었어?」
			RETURN 1
		ELSE
			PRINTFORMW 「음... 잔뜩 말이야...%UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 벌써 내버린 거야?」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...임신할 것 같네」
			RETURN 1
		ELSE
			PRINTFORMW 「...맛있어 보인다...」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
