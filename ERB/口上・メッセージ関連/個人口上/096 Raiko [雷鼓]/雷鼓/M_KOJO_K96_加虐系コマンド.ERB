;==================================================
;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K96_100
CALL M_KOJO_MESSAGE_COM_K96_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K96_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 순간 속에서 라이코의 엉덩이를 때리기 시작했다.
			RETURN 1
		ELSE
			PRINTFORMW 「…응!?」
			PRINTFORMW 「잠깐…저기?! …응 아 %UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 순간 속에서 라이코의 엉덩이를 때리기 시작했다.
		RETURN 1
		;V挿入スパンキング
	ELSEIF LOCAL:1 && TEQUIP:50 == PLAYER
		IF RAND:3 == 0
			PRINTFORMW 「ん읏…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…싫어…이거…%UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%……응%UNICODE(0x2665) *1%」
			PRINTFORMW 「……넣은 채로……응%UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 「으아%UNICODE(0x2665) *1%…아앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「응… 이제…%UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
		;V挿入スパンキング
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		IF RAND:3 == 0
			PRINTFORMW 「ん%UNICODE(0x2665) *1%…읏…」
			PRINTFORMW 「…엉덩이…%UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「앗 %UNICODE(0x2665) *1%…ん…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…これ…気持ちいい…%UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 「앗%UNICODE(0x2665) *1%…응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「이제…%UNICODE(0x2665) *1%…바보야아…%UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응…%UNICODE(0x2665) *1%아…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…엉덩이… 망가져 버려…%UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗…%UNICODE(0x2665) *1%응읏…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…이건…%UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 「으앗…%UNICODE(0x2665) *1%이런 건…%UNICODE(0x2665) *1%」
			PRINTFORMW 「엉덩이 감각이 없어져 버려…%UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응%UNICODE(0x2665) *1%」
			PRINTFORMW 「...아%UNICODE(0x2665) *1%...엉덩이%UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「앗 %UNICODE(0x2665) *1%…ん…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…これ…あまり…ん읏%UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 「…으응%UNICODE(0x2665) *1%…히아%UNICODE(0x2665) *1%」
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음... 벌써...」
			PRINTFORMW 「...내 엉덩이는 때리는 게 아닌데...」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「너무... 때리지 말아줘...」
			PRINTFORMW 「...아픈 거니까... 그래도」
			RETURN 1
		ELSE
			PRINTFORMW 「...응...」
			PRINTFORMW 「아파...」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
