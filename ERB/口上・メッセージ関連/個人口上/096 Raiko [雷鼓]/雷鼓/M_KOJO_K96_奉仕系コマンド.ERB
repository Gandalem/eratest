;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K96_80
CALL M_KOJO_MESSAGE_COM_K96_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K96_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 라이코의 손에 성기를 쥐여주었다.
		ELSE
			PRINTFORMW 「응?」
			PRINTFORMW 「알았어, 해줄게」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 라이코의 손에 성기를 쥐여주었다.
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「응? 벌써 나올 거야?」
			PRINTFORMDW 그렇게 말하자 라이코는 더욱 격렬하게 움직이기 시작했다.
			PRINTFORMW 「귀엽네, 움찔거리고 있어 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응... 커지고 있어%UNICODE(0x2665) *1%」
			PRINTFORMDW 그렇게 말하자 라이코는 더욱 격렬하게 다루기 시작했다.
			PRINTFORMW 「자멘 내보내 버려라%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「슬슬 나올 것 같네」
			PRINTFORMDW 그렇게 말하자 라이코는 더욱 격렬하게 시작했다.
			PRINTFORMW 「많이 내줘... %UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응... 자」
			PRINTFORMW 「기분 좋게 해줄게... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응... 두껍고 단단해...」
			PRINTFORMW 「...하지만 금방 나올 것 같네」
		ELSE
			PRINTFORMW 「음… 버릇없는 분이시네요…」
			PRINTFORMW 「기분 좋게 해 드릴게요…%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응…… 기분 좋아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 건 별로 해본 적 없는데」
			PRINTFORMW 「나는 손재주가 뛰어난 편이야」
		ELSE
			PRINTFORMW 「잔뜩... 싸버려라」
			PRINTFORMW 「...내 손으로 기분 좋게 해줄게」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응... 역겹다니까」
			PRINTFORMW 「... 빨리 싸버려라」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 건 별로 좋아하지 않지만」
			PRINTFORMW 「좋아한다면 기분 좋게 해줄게」
		ELSE
			PRINTFORMW 「...응... 여기가 약점이야?」
			PRINTFORMW 「...커져 왔네...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
