RETURN RESULT

@M_KOJO_MESSAGE_COM_K96_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMDW 얼어붙은 시간 속에서 라이코의 구강을 범하기 시작했다.
		ELSE
			PRINTFORMW 「…응……」
			PRINTFORMW 「쪽! 쪽… 응…」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 라이코의 구강을 범하기 시작했다.
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응... 주루...」
			PRINTFORMW 「...레로... 응...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...쥬루...」
			PRINTFORMW 「...응...아무...!」
		ELSE
			PRINTFORMW 「쭈르... 음무...」
			PRINTFORMW 「음부... 레로...!」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「츄루...」
			PRINTFORMW 「...응...레로...!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아무...!」
			PRINTFORMW 「음...주륵...!」
		ELSE
			PRINTFORMW 「크윽... 받아라...」
			PRINTFORMW 「...받아라... 응...」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「앗... 응...」
			PRINTFORMW 「...먹어봐...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……주부……」
			PRINTFORMW 「……응……아……」
		ELSE
			PRINTFORMW 「...응...」
			PRINTFORMW 「흐으읍... 츄릅...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
