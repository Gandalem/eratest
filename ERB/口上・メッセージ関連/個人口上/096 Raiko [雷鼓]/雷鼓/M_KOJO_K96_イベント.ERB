@M_KOJO_SPEVENT_K96_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1096)
			PRINTFORMW 「오늘은 고마워, 나랑 사귀어줘서」
			PRINTFORMDW 그런 게 아니야, 나도 즐거웠어.
			PRINTFORMDW 라고 대답하자 왼쪽 다리를 축으로 빙그르 돌며, 약간 긴장한 표정으로――
			PRINTFORMDW 그러면서 애써 미소를 지으며 말을 꺼냈다.
			PRINTFORMW 「아니, 오늘뿐만이 아니야, 지금까지 계속 나에게 주었던」
			PRINTFORMW 「뭐, 네가 정말로... 나를 생각해주고 있었는지는 모르겠지만...」
			PRINTFORMW 「지금부터 그걸 시험해 보자.」
			PRINTFORMW 
			PRINTFORMW 「좋아해요」
			PRINTFORMW 「당신의 곁에 있게 해주세요...」
			PRINTFORMW 「당신의 고동... 더... 들려줘...」
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 「여보세요? 듣고 있어요?」
			PRINTFORMDW 갑작스러운 고백에 조금 얼어붙으면서 %조사처리(CALLNAME:MASTER,"는")% 말을 내뱉었다...
			;二回目の告白
		ELSE
			PRINTFORMW 「――저기, %MASTERNAME:96%」
			PRINTFORMDW 돌아갈 때, 갑자기 나를 뒤돌아보며 상당히 긴장한 모습으로 말이 흘러나왔다.
			PRINTFORMW 「좋아해요, 연인이 되어주세요」
			PRINTFORMDW 몸을 긴장으로 떨면서 필사적으로 목소리를 냈다.
			PRINTFORMW 「그 후로, 많이 당신 옆에 있을 수 있도록 노력했다고 생각하는데…」
			PRINTFORMW 「아니, 노력했는데―――」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 천천히 말을 음미하며 그에게 대답했다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTW
		PRINTW
		PRINTFORMW 「…」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕이자, 라이코는 한 번 고개를 떨구었다가 얼굴을 들고 입을 연다.
		PRINTFORMW 「좋았어... 거절당하면 어쩌지...」
		PRINTFORMDW 가슴에 손을 얹은 채 약간 눈물을 글썽이며 말을 이어나간다.
		PRINTFORMW 「나, 지금까지 이런 일 해본 적이 없어서...」
		PRINTFORMW 「잘 될지 모르겠어서...」
		PRINTFORMDW 뭐, 부속신이었으니까 하고 %조사처리(CALLNAME:MASTER,"가")% 생각하고 있을 때 라이코는 부끄러워하며 말을 이어나간다.
		PRINTFORMW 「오늘은 좋은 날이네... 고마워... 그리고...」
		PRINTFORMW 「앞으로도 잘 부탁해, %MASTERNAME:96%!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTW
		PRINTW
		PRINTFORMW  「…」
		PRINTFORMW  「……」
		PRINTFORMW  「………」
		PRINTFORMW  「후후후, 좋아, 기억해 두렴...」
		PRINTFORMW  「나, 당신에게 돌아보게 할 정도로 노력할 테니까...」
		PRINTFORMW  「――나는 포기하지 않을 거야?」
		PRINTFORMDW  그런 라이코는 쓸쓸하게 떠났다.
		PRINTW
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K96_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:恋人
			PRINTW
			PRINTFORMW 「음~ 즐거웠어!」
			PRINTFORMW 「당신과 함께라면 어디든 즐거운걸...」
			PRINTFORMW 「내일은 어떻게 할 거야? %MASTERNAME:96%는 어디에 가고 싶어?」
			PRINTFORMDW 쾌활하게 내일의 예정을 묻는 라이코는 즐거워 보인다.
			PRINTFORMW 「나? 나는―――」
			PRINTFORMW 「역시 내일 정하자, 기대하고 있다가 못 보게 될까 봐 싫으니까...」
		ELSEIF TALENT:恋慕
			PRINTW
			PRINTFORMW 「아~ 즐거웠어!」
			PRINTFORMW 「%MASTERNAME:96%는 어땠어?」
			PRINTFORMW 「나? 나는 당신과 함께 있어서 즐거웠어!」
			PRINTFORMW 「왜? 음... 왜일까...」
			PRINTFORMDW 라이코는 무언가 깨달은 듯 돌아가는 하늘을 바라보고 있다.
		ELSEIF TALENT:思慕
			PRINTW
			PRINTFORMW 「음... 오늘은 고마웠어...」
			PRINTFORMW 「만약 가능하다면... 내일도 같이 있어 줄 수 있겠니?」
			PRINTFORMDW 부쩍 조심스러워진 라이코는 그렇게 말하자 부끄러움에 고개를 숙였다.
			PRINTW
		ELSE
			PRINTW
			PRINTFORMW 「후우... 피곤하네...」
			PRINTFORMW 「음... 라이브 이벤트보다는 낫지, 기분 전환 같은 거 말이야」
			PRINTFORMW 「아니 라이브가 싫다는 게 아니라, 이건 어깨에 힘을 빼고 즐기는 느낌이라서랄까」
			PRINTFORMW 「벌써... 그럼 라이브 보러 올래? 라이브의 재미를 가르쳐 줄게」
			PRINTFORMDW 뭔가 생기가 넘친다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「이제, 너무 심한 짓 하지 말아줘?」
			PRINTFORMW 「나도 별로 화내고 싶지 않으니까...」
			PRINTFORMW 「하지 마? 장난이 아니니까.」
			RETURN 1
		ELSE
			PRINTFORMW 「좋아줄게」
			PRINTFORMDW 라이코는 아무렇지도 않게 미소로 용서해 주었다.
			PRINTFORMW 「하지만, 다음은 없으니까 말이야?」
			PRINTFORMDW 내밀어진 손을 잡자 정전기가 찌릿하고 흘렀다.
			PRINTW
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「좋아, 용서해 줄게」
			PRINTFORMW 「하지만 말이야, 이제 화나게 하지 마?」
			PRINTFORMW 「당신을 믿고 싶으니까...」
			PRINTFORMDW 어이없음 반 분노 반으로 용서해 주는 모양이다.
		ELSE
			PRINTFORMW 「뭐, 됐지만...」
			PRINTFORMW 「너무 사람 화나게 하지 마라」
			PRINTFORMDW 라이코는 대전시키면서 분노를 가라앉힌다.
			PRINTW
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
