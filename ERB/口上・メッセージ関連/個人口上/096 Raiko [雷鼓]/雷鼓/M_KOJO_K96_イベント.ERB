@M_KOJO_EVENT_K96_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「그럼 안녕」 
			PRINTFORMW 「오늘은 피곤해졌어... 하지만...」
			PRINTFORMW 「내일 또 즐기자...」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「후아아…」
			PRINTFORMW 「응? 괜찮아, 괜찮아 아직―――」
			PRINTFORMDW 무리하지 말라고 하자 라이코는 조금 지친 얼굴로 입을 열었다.
			PRINTFORMW 「고마워… 그럼 말씀에 응해서 물러갈게」
			PRINTFORMW 「그럼 내일 또 보자, 건강하게 잘 지내」
			PRINTFORMDW 그러더니 살짝 비틀거리며 라이코는 자신의 방으로 돌아갔다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「이제 슬슬 끝낼까?」
			PRINTFORMDW 라이코는 시계를 보고 확인하러 간다.
			PRINTFORMW 「미안해, 아쉬운데...」
			PRINTFORMW 「오늘은 이 정도로...」
		ELSE
			PRINTFORMW 「음... 그럼, 안녕히 주무세요」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「음...」 
			PRINTFORMW 「좀... 졸려지기 시작했네...」
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORMW 「하아...」
			PRINTFORMW 「졸려...져버렸어...」
		ELSEIF TALENT:思慕
			PRINTFORMW 「음... 안 되겠어...」
			PRINTFORMW 「조금... 졸리네...」
		ELSE
			PRINTFORMW 「하아... 졸려...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「음... 스으...」 
			PRINTFORMW 「…%CALLNAME:MASTER%…」
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...크으...」
			PRINTFORMW 「…%CALLNAME:MASTER%…」
		ELSEIF TALENT:思慕
			PRINTFORMW 「...스윽...응...」
			PRINTFORMW 「크으...」
		ELSE
			PRINTFORMW 「크으... 스윽...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕付き拠点内キャラがMAIN_MAPで衰弱状態になった場合か、お招き部屋で相手が衰弱した場合に発生
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「...미안해... 피곤해졌어...」
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORMW 「하아... 아무래도 피곤하네...」
		ELSE
			PRINTFORMW 「으음... 피곤해...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORMW 「ちょ…ちょっと…！？」
			PRINTFORMW 「大丈夫!?…じゃないか…よ읏…と」
			PRINTFORMDW そう言いながら%조사처리(CALLNAME:MASTER,"를")% 안아 올리자
			PRINTFORMW 「部屋どっちだっけ？」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 소위 공주님 안기로 방까지 데려가는 라이코는 어딘가 기뻐 보였다.
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORMW 「괜찮아?」
			PRINTFORMDW 그렇게 말하자 라이코는 어깨를 빌려주며 일어서려고 한다.
			PRINTFORMW 「야, 방까지 갈래?」
			PRINTFORMDW 그렇게 두 사람은 함께 방까지 가게 되었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;非在住TARGETがMAIN_MAPで休憩
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;前のターンから一緒の部屋にいる状態で相手が寝る（お招き部屋含む（
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
