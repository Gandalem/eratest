@M_KOJO_EVENT_K96_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORMW 「너무 빤히 보지 마... 부끄럽으니까 %UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORMW 「어머? 이런 쪽이 더 흥분하는 걸까 %UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
					PRINTFORMW 「이런 것도, 나 좋아해 %UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「있지, 속옷 갈자%UNICODE(0x2665) *1%」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「좋아, 뭘 사용할지는 모르겠지만 %UNICODE(0x2665) *1%」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「에-… 뭐, 됐지만…」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「에엑... 그건 좀 봐줘...」
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
