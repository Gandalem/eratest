@M_KOJO_EVENT_K96_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「저기, %MASTERNAME:96%, 데이트하자%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%MASTERNAME:96%、데이트하자!」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:96%、デートしない？」
				ELSE
					PRINTFORMW 「%MASTERNAME:96%、데이트할까?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「후훗 %UNICODE(0x2665) *1% 그럼 어디로 갈까요?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「그럼, 오늘은 어디로 갈까요?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「고마워, 그럼 가자!」
				ELSE
					PRINTFORMW 「오늘은 함께 즐기자%UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「오늘은 바빴니?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「후우, 아쉽네...」
				ELSEIF TALENT:思慕
					PRINTFORMW 「어라? 거절당해버렸어?」
				ELSE
					PRINTFORMW 「음... 안 됐어...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%MASTERNAME:96%, 집에 안 올래?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「저기, 집에 놀러 안 올래?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「우리 집에서 놀래?」
				ELSE
					PRINTFORMW 「있잖아, 우리 집에 안 올래?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「후훗%UNICODE(0x2665) *1% 그럼, 갈까%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「야호! 그럼 가자!」
				ELSEIF TALENT:思慕
					PRINTFORMW 「그럼, 따라와 줘 %UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「그럼, 가자!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「아, 정말 안됐네...」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「으음... 거절당해 버렸어」
				ELSEIF TALENT:思慕
					PRINTFORMW 「음, 아쉽네」
				ELSE
					PRINTFORMW 「어라라... 다음에 봐」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
