;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
@M_KOJO_SPEVENT_K96_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1096)
			PRINTFORMW 「今日はありがとうね、私に付き合ってくれて」
			PRINTFORMDW そんなことはない、こっちも楽しかった。
			PRINTFORMDW と、返事をすると左足を軸にくるりと振り返り、少し緊張した面持ちで――
			PRINTFORMDW それでいて努めてにこやかに話を切り出した。
			PRINTFORMW 「いいえ、今日だけじゃない、これまでずぅっと私に与えてくれた」
			PRINTFORMW 「ま、貴方が本当に…私を想ってくれていたのかは分からないけど…」
			PRINTFORMW 「今からそれを試しましょう。」
			PRINTFORMW 
			PRINTFORMW 「好きです」
			PRINTFORMW 「貴方の側に居させてください…」
			PRINTFORMW 「貴方の鼓動…もっと…聞かせて…」
			PRINTFORMW 
			PRINTFORMW 
			PRINTFORMW 「もしもーし？聞いてるー？」
			PRINTFORMDW 唐突な告白に少し固まりながら%CALLNAME:MASTER%は言葉をひり出した…
		;二回目の告白
		ELSE
			PRINTFORMW 「――ねぇ%MASTERNAME:96%」
			PRINTFORMDW 帰り際、唐突にこちらを振り返りかなり緊張した様子で言葉が紡がれる。
			PRINTFORMW 「好きです、恋人になってください」
			PRINTFORMDW からだを緊張で震わせながら、一生懸命に声を出す。
			PRINTFORMW 「あれから、いっぱい貴方の隣に居られるように努力したつもり…」
			PRINTFORMW 「いえ、努力したんだけど―――」
			PRINTFORMDW %CALLNAME:MASTER%はゆっくりと言葉を噛み締めながらそれに答えた…
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTW
		PRINTW
		PRINTFORMW 「…」
		PRINTFORMDW %CALLNAME:MASTER%は頷くと、雷鼓は一度俯いて顔を上げて口を開く。
		PRINTFORMW 「よかった…断られたらどうしようかと…」
		PRINTFORMDW 胸に手を当てながら少し涙声になりながら言葉を続けていく。
		PRINTFORMW 「私、今までこんなことしたことなかったから…」
		PRINTFORMW 「うまくいくか分かんなくて…」
		PRINTFORMDW まぁ付喪神だったしなぁと%CALLNAME:MASTER%が考えていると雷鼓は照れながら言葉を紡ぐ。
		PRINTFORMW 「今日はいい日ね…ありがとう…そして…」
		PRINTFORMW 「これからもよろしくね、%MASTERNAME:96%！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTW
		PRINTW
		PRINTFORMW  「…」
		PRINTFORMW  「……」
		PRINTFORMW  「………」
		PRINTFORMW  「ふふふ、いいわ、覚えておきなさい…」
		PRINTFORMW  「私、貴方に振り返ってもらえるぐらい努力するから…」
		PRINTFORMW  「――私、あきらめないからね？」
		PRINTFORMDW  そういうと雷鼓は寂しそうに去っていった。
		PRINTW
		RETURN 1
	ENDIF

ENDIF
RETURN 1

;==================================================
;デート帰り
;==================================================
@M_KOJO_SPEVENT_K96_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:恋人
			PRINTW
			PRINTFORMW 「う～ん、楽しかった！」
			PRINTFORMW 「貴方といられるならどこでも楽しいんだけど…」
			PRINTFORMW 「明日はどうする？%MASTERNAME:96%はどこへ行きたい？」
			PRINTFORMDW 朗らかに明日の予定を聞いてくる雷鼓は楽しそうだ。
			PRINTFORMW 「私？私は―――」
			PRINTFORMW 「やっぱり明日、決めましょう、楽しみにしていて会えなくなっても嫌だから…」
		ELSEIF TALENT:恋慕
			PRINTW
			PRINTFORMW 「あ～楽しかった！」
			PRINTFORMW 「%MASTERNAME:96%はどうだった？」
			PRINTFORMW 「私？私は貴方と一緒に居て楽しかったわ！」
			PRINTFORMW 「なんで？そうね…なんでかしらね…」
			PRINTFORMDW 雷鼓は何か達観したかのように帰りの空を眺めている。
		ELSEIF TALENT:思慕
			PRINTW
			PRINTFORMW 「ん…今日はありがとう…」
			PRINTFORMW 「できたら…明日も付き合ってくれないかしら？」
			PRINTFORMDW やけにしおらしくなった雷鼓はそういうと恥ずかしさから俯いてしまった。
			PRINTW
		ELSE
			PRINTW
			PRINTFORMW 「ふぅ…疲れたわね…」
			PRINTFORMW 「ん…ライブイベントよりかはマシよ、羽を伸ばすってやつね」
			PRINTFORMW 「いやライブが嫌とかじゃなくてねこっちは肩肘張らない楽しさって言うか」
			PRINTFORMW 「もう…じゃあライブに来る？ライブの楽しさっての教えてあげるわ」
			PRINTFORMDW なんだか元気そうである。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「もう、あんまり酷いことしないでね？」
			PRINTFORMW 「私もあんまり怒りたくない…から…」
			PRINTFORMW 「しないでよ？振りじゃないからね？」
			RETURN 1
		ELSE
			PRINTFORMW 「いいわよ」
			PRINTFORMDW あっさりと雷鼓は笑顔で許してくれた
			PRINTFORMW 「でも、次は無いからね？」
			PRINTFORMDW 差し出された手を取ると静電気がピリッと走った。
			PRINTW
		RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「いいわ、許したげる」
			PRINTFORMW 「でもね、もう怒らせないでよ？」
			PRINTFORMW 「貴方のこと信じていたいんだから…」
			PRINTFORMDW 呆れ半分怒り半分で許してくれるらしい。
		ELSE
			PRINTFORMW 「まぁいいけど…」
			PRINTFORMW 「あまり人を怒らせないでよ」
			PRINTFORMDW 雷鼓は帯電させながら怒りを鎮めていく。
			PRINTW
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「呆れたわね…」
			PRINTFORMW 「…まぁ許してあげないことも無いけど」
			PRINTFORMW 「電気椅子に水含めたスポンジ付けてあげる位には」
			PRINTFORMDW 一応は許してくれるらしい。苦しんで死ぬのが楽に死ねるぐらいには、だが。
			RETURN 1
		ELSE
			PRINTFORMW 「%MASTERNAME:96%」
			PRINTFORMW 「今回だけよ、それと二つ、言っておくわ」
			PRINTFORMW 「一つ目、仏の顔も三度までって言葉知ってる？」
			PRINTFORMW 「二つ目、普通、顔は一つしかない。二度も三度も人を怒らせることをしてはいけない、社会常識よ覚えておきなさい」
			PRINTFORMDW 大気が帯電してピリピリしているのが収まっていくのと同時に彼女の怒りも収まって行ったようだ。
			PRINTW
		ENDIF
		RETURN 1
	ENDIF
	PRINTFORMW
ENDIF
RETURN 1

