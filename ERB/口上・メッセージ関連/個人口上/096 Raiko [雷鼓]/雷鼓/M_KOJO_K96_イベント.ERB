@M_KOJO_EVENT_K96_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...뭐야」
					PRINTFORMDW 라이코는 동요하며 침입자를 노려보고 있다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「！」
					PRINTFORMW 「...뭐야...왜 그래...」
					PRINTFORMDW 그렇게 말하면서 라이코는 옷매무새를 가다듬는다.
					PRINTFORMW 「노크라도... 좀 해줘... 정말...」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「！？」
					PRINTFORMW 「뭐, 무슨 용무야? %MASTERNAME:96%?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「………」
					PRINTFORMW 「음...」
					PRINTFORMDW 잠시 멈췄던 시간이 지난 후, 라이코는 조심스럽게 대화를 시작했다.
				ELSE
					PRINTFORMW 「………」
					PRINTFORMW 「뭐...일까?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「………」
				ELSEIF TALENT:恋人
					PRINTFORMW 「…」
					PRINTFORMW 「저기... 돌아가 버리는 거야?」
					PRINTFORMDW 라이코는 그렇게 말하며 배웅했다.
					PRINTFORMW 「바보...」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...돌아가는 거야?」
					PRINTFORMW 「그래... 차갑네.」
				ELSEIF TALENT:思慕
					PRINTFORMW 「………」
					PRINTFORMW 「아니, 그게... 돌아가 버릴 거야?」
				ELSE
					PRINTFORMW 「………」
					PRINTFORMDW 라이코는 멍한 표정으로 바닥에 주저앉아 있다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「………」
					PRINTFORMDW 라이코는 고개를 숙인 채 말없이 행위를 하고 있다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「음... 보고 있어...%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「벌써... 변태잖아...」
					PRINTFORMDW 그렇게 말하면서도 라이코는 행위를 재개했다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「...음...」
					PRINTFORMDW 라이코는 말없이 행위를 재개하기 시작했다.
				ELSE
					PRINTFORMW 「………」
					PRINTFORMW 「…%MASTERNAME:96%…%UNICODE(0x2665) *1%」
					PRINTFORMDW 라이코는 %조사처리(CALLNAME:MASTER,"의")% 이름을 부르면서 행위를 재개했다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...나가라고...!」
					PRINTFORMDW 라이코는 목소리를 높여 내쫓았다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「미안해, 나중에 만회할게…」
					PRINTFORMW 「혼자 있게 해줘…」
					PRINTFORMDW 수치심이 너무 커서 라이코는 %조사처리(CALLNAME:MASTER,"를")% 내보냈다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...혼자 있게 해줘... 부탁이야」
					PRINTFORMDW 그렇게 말하며 라이코는 방에서 내쫓았다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「나가라!」
					PRINTFORMW 「부탁이야...」
					PRINTFORMDW 라이코는 수치심과 경악으로 소리를 지르며 내쫓아왔다.
				ELSE
					PRINTFORMW 「………」
					PRINTFORMW 「못 본 체할게…응…」
					PRINTFORMDW 라이코는 그렇게 말하고 방에서 내쫓았다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「………」
					PRINTFORMDW 라이코는 이곳을 노려보며 덮쳐졌다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「좋지만...」
					PRINTFORMW 「격렬하게... 응... %UNICODE(0x2665) *1%」
					PRINTFORMDW 그렇게 말하며 라이코는 허리에 손을 감아왔다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「아, 알았어」
					PRINTFORMW (사실은... 보여지는 것도 좋은데...)
					PRINTFORMDW 라이코는 얼굴을 살짝 붉히며 %조사처리(CALLNAME:MASTER,"에게")% 밀쳐졌다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「음...」
					PRINTFORMW 「부탁해... 기분 좋게 해줘...」
					PRINTFORMDW 그렇게 말하며 라이코는 몸을 맡겼다.
				ELSE
					PRINTFORMW 「…」
					PRINTFORMW 「아무에게도 말하지 말아줘?」
					PRINTFORMDW 라이코는 간청하듯 그렇게 말했다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「………」
					PRINTFORMDW 라이코는 아무 말 없이 엎드려 쓰러져 있다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「아……%UNICODE(0x2665) *1%……아……%UNICODE(0x2665) *1%」
					PRINTFORMW 「좋아해……%MASTERNAME:96%……%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「응윽...%UNICODE(0x2665) *1%」
					PRINTFORMW 「이제 안 돼... 한계야...」
				ELSEIF TALENT:思慕
					PRINTFORMW 「음...%UNICODE(0x2665) *1%」
					PRINTFORMW 「그럼 안녕... 다행이다」
				ELSE
					PRINTFORMW 「응...」
					PRINTFORMW 「후우...」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
