;==================================================
;相手が押し倒しを解除
;==================================================
@M_KOJO_EVENT_K96_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
	;疲れた
		PRINTFORMW 「ふぅ…疲れちゃった…%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
	;満足して解放
		PRINTFORMW 「ふぅ…気持ちよかったわ…%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
	;満足したところを押し倒された
		PRINTFORMW 「ああん…%UNICODE(0x2665) *1%…抵抗できないんだからぁ…%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
	;壊れるまでしてあげる
		PRINTFORMW 「お姉さん燃えちゃうわ…%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;デイリーイベント2,夢精
;濃厚精液状態で発生
;▼地の文--------------------------------------------------
;【MASTER】が夢精で汚した下着を洗っていると【TARGET】が飛んできた！
;【TARGET】はそんなもの他の洗濯物と一緒に洗わないでと抗議すると、【MASTER】の手に収まった下着をふんだくり戻っていった…
;【TARGET】　欲情の珠＋1000
;==================================================
@M_KOJO_DAILY_EVENT_K96_2(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
;地の文を変えたければコメントアウト
;※コメントアウトすると欲情の珠＋1000（JUEL:11 += 1000）もカットされるので注意
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	IF TALENT:恋慕
		PRINTFORMW 「%MASTERNAME:96%は…何でもないわ、お姉さんが洗っとくね！」
		PRINTFORMW 雷鼓は%CALLNAME:MASTER%が去った後%CALLNAME:MASTER%のパンツを洗い始めた。
	ELSE
		PRINTFORMW 「%MASTERNAME:96%も男の子だから、こういうこともあるよね」
		PRINTFORMW 雷鼓はどこか感心したように%CALLNAME:MASTER%のパンツを洗い始めた。
	ENDIF
ENDIF
RETURN 1



