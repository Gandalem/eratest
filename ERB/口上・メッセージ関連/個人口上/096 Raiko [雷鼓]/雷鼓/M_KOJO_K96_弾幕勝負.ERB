; Modular ERB: 個人口上/096 Raiko [雷鼓]/雷鼓/M_KOJO_K96_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K96_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「언니를 화나게 한 걸 후회하게 해 줄게%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「자, 지금이야말로 싸움의 비트를 새길 때다!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「자! 환상향에 시원의 비트를 울려라!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「자! 전례 없는 비트를 울려라!」
		ELSE
			PRINTFORMW 「자! 영혼의 비트로 시원의 감정을 일깨우자!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「흥, 이 정도야?」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「순수하게 탄막 파워로 밀어붙일 거야!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「그 정도로는 흥분하지 않아♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「더 나를 흥분시켜줘!」
				ELSE
					PRINTFORMW 「얕다니!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「신경을 거슬리게 하는 소리를 내겠어!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「어라? 격렬하네, 좋아, 그런 거!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「잘한다! %MASTERNAME:96%!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아직이야! 진짜 승리는 이제부터야!」
				ELSE
					PRINTFORMW 「더 %MASTERNAME:96%의 소리를 나에게 새겨줘!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...졌나」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「당했다!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아얏……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%MASTERNAME:96%의 소리, 굉장하네♪」
				ELSE
					PRINTFORMW 「내 소리가 졌어...!」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF RAND:4 == 0
			PRINTFORMW 「이것이 건곤일척의 일격이란 거야!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「내 소리를 들어라!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「타마야!」
		ELSE
			PRINTFORMW 「아직, 방심하지 말아야 해!」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이걸 계책 삼아 두 번 다시 화나게 하지 말거라.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「어라? 오늘은 컨디션이 안 좋았던 걸까?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「의외로 %MASTERNAME:96%, 약하네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「압승이네, 어때? 나의 소리는?」
				ELSE
					PRINTFORMW 「나의 소리, 어땠을까?」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「정말! 사람을 화나게 하면 이렇게 되는 거야!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아직 멀었네, %MASTERNAME:96%%UNICODE(0x2665) *1%」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「좀 더 격렬하게 해줬으면 했나♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「별로 기분 좋지는 않았네...」
				ELSE
					PRINTFORMW 「아직 여력이 남아있을까? 그런 기분이 드네.」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「분노에 몸을 맡겨서는 안 된다, 그건가」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아슬아팠어... 그래도 정말 즐거웠어♪」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%MASTERNAME:96%의 소리... 정말 격렬하네... ♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아슬아슬하게 질 뻔했어...」
				ELSE
					PRINTFORMW 「이번에는 모두를 초대해 줄까?」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...미안하지만 납득 못 했으니까 말이야」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「어라라라, 항복이야~」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%MASTERNAME:96%의 소리, 새겨져 버렸다...%UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「정말 즐거웠어~ 또 싸우자!」
				ELSE
					PRINTFORMW 「마력 조절에 과가 있네...」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
