@M_KOJO_MESSAGE_COM_K96_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:Ｃ絶頂
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 미동조차 없는 라이코의 클리토리스를 혀로 애무한다.
		PRINTFORMDW 점점 애액이 흘러나오지만 아랑곳하지 않고 색기를 풍기는 클리토리스를 계속 자극하고 있다.
		PRINTFORMDW 강한 자극을 받으면서 홍수처럼 라이코는 애액을 뿌리고 있다.
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「응!?」
		PRINTFORMW 「벌써 기분이 좋아지잖아...」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「앗, 앗, 후뮤!?」
		PRINTFORMW 「...이렇게 온몸을 농락당하다니... 기분 좋아지네... 사람의 몸이란 정말 좋구나...」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「흐응... 음... 안윽...」
		PRINTFORMDW 라이코는 음핵을 자극받아 몸부림치고 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
