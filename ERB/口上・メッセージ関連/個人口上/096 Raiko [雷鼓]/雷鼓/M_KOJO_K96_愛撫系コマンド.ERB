@M_KOJO_MESSAGE_COM_K96_0
CALL M_KOJO_MESSAGE_COM_K96_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K96_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORMDW 시간의 흐름이 멈춘 상황 속에서, 라이코의 몸을 애무한다.
			PRINTFORMDW 반응은 없었지만, 어딘가 몸을 떨고 있는 듯한 느낌을 받았다.
		ELSE
			PRINTFORMW 「응... 그렇게 만지고 싶어...?」
			PRINTFORMW 「좋아, 내 몸 마음대로 해줘...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 멈춘 순간에 라이코의 몸을 애무한다.
		PRINTFORMDW 색기 넘치는 몸에서는 희미하게 향수의 냄새가 난다.
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「응... 더... 만져줘...」
		PRINTFORMW 「흐읍... 으음... 앙...」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「이 몸은... 음... 딱히 당신에게 만져지기 위한 건 아니지만...」
		PRINTFORMW 「음... 벌써... 많이 만져졌어... ♪」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「아... 응...」
		PRINTFORMW 「더... 상냥하게... 음...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
