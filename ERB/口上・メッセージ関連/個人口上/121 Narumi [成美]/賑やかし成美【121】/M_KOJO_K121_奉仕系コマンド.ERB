;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K121_80
CALL M_KOJO_MESSAGE_COM_K121_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K121_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「......」
		PRINTFORML 당신은 나루미의 평소에 꼭 맞잡고 있는 손 안에 자신의 성기를 넣는다...
		PRINTFORMW 그녀는 눈치채지 못하는 척하고 있다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			CALL HPH_PRINT,@"「...이제 사정해도 돼, %CALLNAME:MASTER%...HPH」","L"
			PRINTFORMW 나루미는 손에 힘을 주며 낮은 목소리로 중얼거린다...
		ELSE
			PRINTFORML 「......♪」
			PRINTFORMW 나루미의 손이 당신을 스칠 때마다, 그것은 당신을 점점 더 %FSYN("orgasm:ing")%에 가깝게 이끈다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K121_81
CALL M_KOJO_MESSAGE_COM_K121_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K121_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「......」
		PRINTFORML 나루미가 조각상처럼 행동하는 동안, 너는 네 성기를 그녀의 입속으로 밀어 넣는다...
		PRINTFORMW 그녀는 당황한 듯 보이지만 지조처럼 연기를 계속한다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「......」
		PRINTFORMW 조각상처럼 나루미는 몸을 한 치도 움직이지 않는다. 하지만 안쪽에서는 그녀의 입이 음란하게 당신의 %FSYN("penis")% 주위를 감싼다...
		IF NOWEX:PLAYER:射精
			CALL HPH_PRINT,@"「음...흐읍......응흠......」","L"
			PRINTFORMW 나루미의 목에서 은밀한 소리가 들려온다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
