; Modular ERB: 個人口上/121 Narumi [成美]/賑やかし成美【121】/M_KOJO_K121_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K121_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1 ;custom code
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;kind of weird but alright
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「좋아, 단마쿠를 하고 싶다고?! 내가 원하던 바야ー!」
		PRINTFORML 나를 마주해 봐, 그 도착적인, 시간을 멈추는, 팬티 수집가 자식아ー!!」
		PRINTFORMW 이 쓸데없이 호전적인 태도... 네가 싫어하는 게 아니지. 오히려 네 최애잖아!
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORMW 오호호, 나 맞았어-
				PRINTFORMW 너무 쉽게 해서 벌을 받았다고!
			CASE 1
				PRINTFORML 「N-안 돼～! 네 계절 출시작을 쓰는 건 규칙 위반이라고ー!」
				PRINTFORML 그럼, 눈에는 눈으로 응징할 거야ー!!」
				PRINTFORMW 남은 힘을 다해 나루미가 모든 잔여 에너지로 단마쿠를 발사한다!
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3, 2, 1
				PRINTFORML 「드디어 이겼어~ 다음 생에 봐-!」
				PRINTFORMW 나루미는 승리의 미소를 지으며 당신을 바라본다.
			CASE 0
				PRINTFORML 「우와아, 이 마법 인간은 강하군--!!」
				PRINTFORMW 나루미는 당신에게 지게 될 것이라고 예상하지 못한 듯하다.
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
