;332,お酒をふるまう
;TFLAG:193(0=下戸飲み成功 -1=下戸飲み失敗 -2=下戸飲み大失敗 -5=下戸飲みあきらめ)
;TFLAG:194(51=どぶろく 52=清酒 53=鬼殺し)
;ALCOHOL_TASTE(TFLAG:194)(15以上=気に入る 9以下=口に合わない)
;==================================================

@M_KOJO_MESSAGE_COM_K22_332
CALL M_KOJO_MESSAGE_COM_K22_332_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K22_332_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF ALCOHOL_TASTE(TFLAG:194) >= 15
		PRINTFORMW 「마셔도 돼? 고마워... 맛있다」
	ELSEIF ALCOHOL_TASTE(TFLAG:194) <= 9
		PRINTFORMW 「음... 다른 누군가가 원할 터인데」
	ELSEIF TFLAG:193 >= -1
		PRINTFORMW 「이건 좀... 무리야」
	ELSE
		PRINTFORMW 「당신도 마셔봐, 자」
	ENDIF
ENDIF
RETURN 1
;==================================================
;333,愚痴を聞く
;TFLAG:193(6=大成功(酔い) 5=成功(酔い) 4=失敗(酔い) 3=大成功 2=成功 1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K22_333
CALL M_KOJO_MESSAGE_COM_K22_333_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K22_333_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 6
			;大成功（酔い）
			PRINTFORMW 「당신은 알아줄 거야, 믿고 있었어... 후-」
		CASE 5
			;成功（酔い）
			PRINTFORMW 「맞아, 알겠지? 네가 들어줘서 다행이야」
		CASE 4
			;失敗（酔い）
			PRINTFORML 「리리카도 메를랑도 엔터테이너로서의 자각이 부족해.」
			PRINTFORML 「기술도 중요하지만 그것을 마음껏 발휘할 수 있는 환경을 갖추는 건 나야, 너희 둘 다 세팅 같은 건 생각 안 하고 있어.」
			PRINTFORMW 「나를 좀 더 생각해줘... 아니, 우으...」
		CASE 3
			;大成功
