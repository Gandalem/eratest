;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K22_80
CALL M_KOJO_MESSAGE_COM_K22_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K22_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「...알았어. 그, 어디가 기분 좋은지 말해줬으면 좋겠어」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「이렇게 적시면서... %UNICODE(0x2764)%어머, 표정이 안 좋네 %UNICODE(0x2764)%」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「기분 좋아? 여기가 좋은 거야? 아프지 않겠지, 그렇지?」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
