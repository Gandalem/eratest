RETURN RESULT

@M_KOJO_MESSAGE_COM_K22_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「핥는 거야... 이걸? 응. 알겠어」
		PRINTFORMDW 루나사는 시험 삼아 그곳에 혀를 내밀고, 끝부분만 만진다.
		PRINTFORMDW 그대로 귀두를 쓰다듬다가, 이윽고 과감하게 입안으로 그것을 머금었다
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMDW 루나사의 혀가 칼목을 뜨겁게 끌어안고 놓지 않는다... 위 입의 취급도 익숙해진 것 같다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMDW 루나사는 입으로 귀두를 빨고, 혀로 방울구멍을 핥아대 왔다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
