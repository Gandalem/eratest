	ENDIF
	IF K2_BASIC_CONDITION_IN_MATING()
		;真正ヤリマンで小柄体型以上、かつ主人のペニスが普通より小さい、かつアイマスクなし
		IF CFLAG:1001 && TALENT:体型 >= -1 && TALENT:MASTER:性別 & 2 && TALENT:MASTER:形状 < 3 && !TEQUIP:アイマスク
			IF TALENT:サド && !TALENT:マゾ
				PRINTFORM 다시 한번 자세히 보니, 정말로 작은 성기였다. 
			ELSE
				PRINTFORM 정말 귀엽고 사랑스러운 작은 성기다. 
			ENDIF
			;フル勃起
			IF CFLAG:MASTER:勃起度 >= 1500
				IF TALENT:サド && !TALENT:マゾ
					PRINTFORML 그게 최대치야?
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 심문을 하면서 다리로 너를 놀린다.
				ELSE
					CALL K2_HPH_PRINT,@"네 한심한 성기를 계속 괴롭혀 주지.","W"
				ENDIF
				;挿入可能な勃起
			ELSEIF CFLAG:MASTER:勃起度 >= 1000
				IF TALENT:サド && !TALENT:マゾ
					PRINTFORML 당신에게 그런 \@ TALENT:MASTER:形状 == 1 ? 어린아이 같은 # 시시한 \@ 성기가 있음에도, 점점 더 딱딱해지고 있다.」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 끊임없이 당신을 학대한다.
				ELSE
					PRINTFORML 점점 더 힘들어져 가네. 좋아, 좋아♪
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 발로 네 %K2_EXPRESSION_VARIATION("PENIS")%를 쓸어내린다.
				ENDIF
				;半勃ち
			ELSEIF CFLAG:MASTER:勃起度 > 500
				IF TALENT:サド && !TALENT:マゾ
					PRINTFORML 내 다리에 비해서 너무 작다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그녀의 놀림으로 너를 더 단단하게 만든다.
				ELSE
					PRINTFORML 이렇게 작은 곳에 발을 대는 건 어렵네.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어려움을 겪고 있는 것 같다.
				ENDIF
				;ふにゃちん
			ELSE
				PRINTFORMW 너무 축 늘어져서 아기 거 같아.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
