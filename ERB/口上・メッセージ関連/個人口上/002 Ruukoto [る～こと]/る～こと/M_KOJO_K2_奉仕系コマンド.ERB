	ENDIF
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMD %조사처리(CALLNAME:TARGET,"가")% 자신의 밑에서 %K2_EXPRESSION_VARIATION("PENIS")%를 잡는다. 
					SIF !TEQUIP:アイマスク && !TEQUIP:シックスナイン
						PRINTFORMD 그리고 당신을 갈망하는 표정으로 바라본다.
					PRINTFORMDL 그녀는 당신을 열렬히 봉사한다.
					CALL K2_HPH_PRINT,@"「음... 으응... 우우... 후우후우흐... 흠... 주후후후」","W"
				CASEELSE
					PRINTFORMDL %CALLNAME:TARGET%그녀는 입을 오므리고 당신의 전체 %K2_EXPRESSION_VARIATION("PENIS")%를 빨아들였다.
					SIF !TEQUIP:シックスナイン
						PRINTFORMDL 그녀의 좁은 뺨과 콧구멍에서 천박한 소리가 나며 숨을 쉬려 애쓰고, 그 표정은 당신을 더욱 자극하여 욕정으로 가득 채운다.
					CALL K2_HPH_PRINT,@"「흐으... 부포... 홱... 하... 흠프... 주루... 부츄... 레로프하」","W"
			ENDSELECT
		ELSEIF TALENT:思慕 || TALENT:セフレ
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 온 입으로 너에게 봉사한다.
			PRINTFORMW 「아무... 주포... 음호... 주루!」
		ELSE
			PRINTFORMW 「쥬루, 주푸... 응우... 푸와아... 이거 힘드네!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
