;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K2_81
CALL M_KOJO_MESSAGE_COM_K2_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	$BLOWJOB_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:4
				CASE 1
					SELECTCASE ABL:舌
						CASE 0,1
							PRINTFORML 「흐으... 후와아... 음, 나 제대로 하고 있는 걸까?」
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 불안해 보였다. 그녀는 입으로 서비스를 제공하는 것에 익숙하지 않았다.
							PRINTFORMW 「나는 %CALLNAME:MASTER%-사마를 더 기분 좋게 해주고 싶어.」
						CASE 2,3
							CALL K2_HPH_PRINT,@"「츄포... 츄푸... 에헤헵 드디어 이해한 것 같아헵」","W"
						CASE IS >= 4
							PRINTFORMDL %CALLNAME:TARGET%그녀의 입술로 당신의 귀두를 자극하고 혀로 남은 페니스를 간지럽히면서
							CALL K2_HPH_PRINT,@"「구포... 주우, 추포힉프... 주루... 페로... 주파... 레호로힉프」","W"
					ENDSELECT
				CASE 2
					;フル勃起
					IF CFLAG:MASTER:勃起度 >= 1500
						CALL K2_HPH_PRINT,@"「거시기... 이 분비물을 마셔도 될까요? 원하신다면 제 안으로 사정하셔도 괜찮아요HPH」","W"
						;挿入可能な勃起
					ELSEIF CFLAG:MASTER:勃起度 >= 1000
						IF !TEQUIP:MASTER:コンドーム
							CALL K2_HPH_PRINT,@"「아, 당신의 정액이 새어 나오고 있어 HPH」","W"
						ELSE
							GOTO BLOWJOB_LOOP
						ENDIF
						;半勃ち
					ELSEIF CFLAG:MASTER:勃起度 > 500
						CALL K2_HPH_PRINT,@"「가슴을 써서 더 세게 해 줄게HPH」","W"
						;ふにゃちん
					ELSE
						CALL K2_HPH_PRINT,@"「축 처진 거를 가슴 사이에 비비는 게 즐겁네HPH」","W"
					ENDIF
				CASE 3
					IF TEQUIP:MASTER:コンドーム
						PRINTFORML 「사실 %CALLNAME:MASTER%-님의 거시기를 맛보고 싶었다...」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 콘돔을 사용하면서 당신을 빨아야 한다니 만족하지 못하는 듯하다.
					ELSE
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 네 폴을 밑부분까지 핥고 코로 끊임없이 네 거시기를 킁킁거린다.
						CALL K2_HPH_PRINT,@"「하...흐음 음란한 냄새야... 좀 더 맡고 싶어 흐음」","W"
					ENDIF
				CASEELSE
					CALL K2_HPH_PRINT,@"「츄읍... 르르... 쪽... 꿀꺽... 츄루우헵」","W"
			ENDSELECT
			IF NOWEX:MASTER:射精
				PRINTL
				SELECTCASE RAND:2
					CASE 1
						CALL K2_HPH_PRINT,@"「네 성기가 꿈틀거리고 있어 HPH 곧 사정할 거야? HPH 해봐 HPH」","L"
						IF EXP_UP(15,TARGET) == NOWEX:PLAYER:射精 * 3 && !TEQUIP:MASTER:コンドーム && ABL:精液中毒 >= 5 && TCVAR:精飲経験 >= 20
							CALL K2_HPH_PRINT,@"「이 정액을 사랑하는 메이드가 당신의 페니스 주스를 마시게 해주세요HPH」","W"
						ELSEIF !TEQUIP:MASTER:コンドーム && TCVAR:精飲経験 >= 20
							CALL K2_HPH_PRINT,@"「부탁이야, 네 정액을 %조사처리(CALLNAME:TARGET,"의")% 입안에 부어줘 HPH」","W"
						ELSE
							CALL K2_HPH_PRINT,@"「안에 사정해줘 HPH」","W"
						ENDIF
					CASEELSE
						PRINTFORMDL 당신의 %K2_EXPRESSION_VARIATION("PENIS")%은 사정 직전이다.
						IF EXP_UP(15,TARGET) == NOWEX:PLAYER:射精 * 3 && !TEQUIP:MASTER:コンドーム && ABL:精液中毒 >= 5 && TCVAR:精飲経験 >= 20
							CALL K2_HPH_PRINT,@"「고쿠유, 고그, 치파, 나한테 마시게 해줘 HPH 좋았지, 안 그래?HPH 네 아기 주스가 원해, 거부할 수 없어 HPH」","W"
						ELSEIF !TEQUIP:MASTER:コンドーム && TCVAR:精飲経験 >= 20
							CALL K2_HPH_PRINT,@"「아무, 주포, 주루, 누파, 니에프 푸그, 그웨허, 우르와합프」","W"
						ELSE
							CALL K2_HPH_PRINT,@"「응츄, 나아, 추햔 안에 사정해, 가장 깊은 곳에서 해 HPH」","W"
						ENDIF
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕 || TALENT:セフレ
			SELECTCASE RAND:4
				CASE 1
					IF ABL:舌 < 2
						PRINTFORMW 「츄... 페드로... 음... 이거 힘드네...」
					ELSE
						GOTO BLOWJOB_LOOP
					ENDIF
				CASE 2
					PRINTFORMW 「응, 주루... 쪽... 츄릅... 츕뽀...」
				CASE 3
					PRINTFORMW 「응... 하아, 어때? 기분 좋아?」
				CASEELSE
					PRINTFORMW 「흐음, 떨리고 있어. 절정에 다다르기 전에 경고해 줘.」
			ENDSELECT
		ELSE
			IF ABL:奉仕精神 >= 2
				;主人のペニスに、精液かアナルか粘液か血の汚れあり、かつコンドームなし
				IF STAIN:MASTER:Ｐ & 108 && !TEQUIP:MASTER:コンドーム
					PRINTFORML 「...더럽네... 그리고 냄새가 나... 응, 하무... 추루!」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 불평에도 불구하고, 그녀는 당신을 봉사하면서 무관심한 태도를 취한다.
				ELSE
					PRINTFORMW 「하으음, 응... 큭... 읏... 흐으... 츄루!」
				ENDIF
			ELSE
				PRINTFORMW 「내가 이걸 핥아야 해? 우우...」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
