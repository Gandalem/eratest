;83,素股
;==================================================

@M_KOJO_MESSAGE_COM_K2_83
CALL M_KOJO_MESSAGE_COM_K2_83_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_83_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	$FEMORAL_SEX_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲 || TALENT:ヤリマン
			SELECTCASE RAND:5
				CASE 1
					IF !TEQUIP:継続キス && !( TALENT:性別 & 2 ) && TALENT:MASTER:形状 != 2
						PRINTFORMDL %CALLNAME:TARGET% -로 존재한다 네가 그녀의 다리 사이에서 너의 %K2_EXPRESSION_VARIATION("PENIS")% 그녀의 다리 사이에
						CALL K2_HPH_PRINT,@"「후후햔, 네 거시기 아래에서 그렇게 솟아오르는 게 재미있네 후후햔」","L"
						SIF !TEQUIP:縄 && !TEQUIP:拘束
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 %K2_EXPRESSION_VARIATION("PENIS")%가 허벅지를 문지르는 방식에 매료된다.
						WAIT
					ELSE
						GOTO FEMORAL_SEX_LOOP
					ENDIF
				CASE 2
					IF !( CFLAG:育児人数 > 0 && !TEQUIP:MASTER:コンドーム && !TCVAR:ピル && CFLAG:生理周期 >= 3 )
						IF CFLAG:溜まってる度 >= 500 && PALAM:潤滑 >= PALAMLV:3
							PRINTFORML 「응? 넣지 않을 거야? 나 섹스 할 준비 다 됐었는데...」
							PRINTFORMDW %CALLNAME:TARGET% \@ TEQUIP:アイマスク ? 불만스러운 표정으로 보인다 # 불만스러운 표정을 짓는다 \@.
						ELSE
							PRINTFORMW 「정말로 넣지 않을 거야? 우리 섹스 하기로 하지 않았어?」
						ENDIF
					ELSE
						GOTO FEMORAL_SEX_LOOP
					ENDIF
				CASE 3
					IF K2_SEXUAL_FRANKNESS()
						CALL K2_HPH_PRINT,@"「흐으흣 음경에 문지러지고 있어. 이 음경 정말 좋다」","W"
					ELSE
						GOTO FEMORAL_SEX_LOOP
					ENDIF
				CASE 4
					CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-님의 성기가 내 가랑이를 비비고 있어 HPH 아아HPH 너무 좋아 HPH」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「내 골반 어때? HPH 너도 기분 좋아? HPH」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 위로 올라와 허벅지 작업을 해달라고 요청한다.
					PRINTFORMW 「정말 괜찮아?... 나, 네 거 짓눌까 봐 걱정돼...」
				CASE 2
					PRINTFORMW 「아... 음... 그윽하게 만지는... 음.」
				CASEELSE
					PRINTFORMW 「넣지 않을 거군요? 그렇군요.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
