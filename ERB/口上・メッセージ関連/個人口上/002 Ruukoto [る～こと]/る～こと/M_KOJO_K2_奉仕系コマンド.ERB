;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K2_80
CALL M_KOJO_MESSAGE_COM_K2_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && K2_BASIC_CONDITION_IN_MATING() && CFLAG:1001 && FIRSTTIME(SELECTCOM)
		PRINTFORM 후훗, 정말
		SELECTCASE TALENT:MASTER:形状
			CASE 1
				PRINTFORM  사랑스러운 
			CASE 2
				PRINTFORM  작은 
			CASE 3
				PRINTFORM  견고한 
			CASE 4
				PRINTFORM  눈부신 
			CASE 5
				PRINTFORM  이상하게 생긴 
			CASE 6
				PRINTFORM 비범한 
			CASE 10
				PRINTFORM 놀라울 정도로 큰 
			CASEELSE
				PRINTFORM 
		ENDSELECT
		PRINTFORMW 페니스.
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 한 손으로 네 성기를 가지고 놀며 음란한 미소를 짓는다.
		PRINTFORMW 「그럼 내가 해줄게.」
		RETURN 1
	ENDIF
	$HANDJOB_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:6
				CASE 1
					IF ABL:技巧 >= 4 && !NOWEX:MASTER:射精
						CALL K2_HPH_PRINT,@"「내 손이 기분 좋아? 네가 원할 때 언제든지 할 수 있어 HPH」","W"
					ELSE
						GOTO HANDJOB_LOOP
					ENDIF
				CASE 2
					IF ABL:指 >= 4
						CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-님, 계속 이렇게 하면 곧 사정할 거예요HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 능숙한 손짓으로 네 약한 스킬을 놀린다.
					ELSE
						GOTO HANDJOB_LOOP
					ENDIF
				CASE 3
					IF !TEQUIP:アイマスク && !TEQUIP:乳首吸い && !TEQUIP:継続キス && !TEQUIP:シックスナイン && ABL:マゾっ気 >= 3
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 무릎을 꿇고 손으로 자위를 해주며 당신의 얼굴을 응시한다.
						PRINTFORMW 「%CALLNAME:MASTER%님이 내가 이런 걸 하는 것을 내려다보실 때, 나는 \@ TALENT:MASTER:性別 == 2 ? 그를 # 그녀를 \@를 섬기는 기분이 든다.」
					ELSE
						GOTO HANDJOB_LOOP
					ENDIF
				CASE 4
					IF ABL:指 >= 2 && ABL:サドっ気 >= 4
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"가")% 강렬하게 유혹하자 자신도 모르게 등을 아치형으로 휘게 된다.
						CALL K2_HPH_PRINT,@"「아, 도망치려고 하지 마. 더 많이 줄게.」","L"
						SIF !TEQUIP:乳首吸い && !TEQUIP:胸揉み && !TEQUIP:拘束 && !TEQUIP:シックスナイン
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 뒤에서 당신에게 매달리며 도망가지 못하게 더욱 거세게 자극한다.
						WAIT
					ELSE
						GOTO HANDJOB_LOOP
					ENDIF
				CASE 5
					CALL K2_HPH_PRINT,@"「당신의 페니스가 맥동하는 게 느껴져 HPH」","W"
				CASEELSE
					SELECTCASE ABL:指
						CASE 0
							PRINTFORMW 「음, 이렇게 하는 게 맞나?」
						CASE 1,2
							PRINTFORMW 「어때? 기분 좋아?」
						CASE IS >= 3
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 능숙하게 속도를 높이며 네 사정을 애타게 기다린다.
							;フル勃起
							IF CFLAG:MASTER:勃起度 >= 1500
								CALL K2_HPH_PRINT,@"「아하, 엄청 단단해 HPH 뭘 선호해? 내 손에 싸는 거? 아니면 안에 하는 거?HPH」","W"
								;挿入可能な勃起
							ELSEIF CFLAG:MASTER:勃起度 >= 1000
								CALL K2_HPH_PRINT,@"「앤HPH 너무 힘들면서 사랑스러워요HPH 하지만 %CALLNAME:MASTER%-님은 더 단단해질 수도 있잖아요, 그렇죠?HPH」","W"
								;半勃ち
							ELSEIF CFLAG:MASTER:勃起度 > 500
								CALL K2_HPH_PRINT,@"「응슈우, 응쇼프 오게나와라, 더 커져줘, 나 섹스하고 싶어」","W"
								;ふにゃちん
							ELSE
								CALL K2_HPH_PRINT,@"아직도 축 늘어져 있어. 자, 더 단단해져 봐 HPH 더 단단하게 HPH」","W"
							ENDIF
					ENDSELECT
			ENDSELECT
			IF NOWEX:MASTER:射精 && ABL:技巧 >= 4
				PRINTL
				PRINTFORMDL %CALLNAME:TARGET%당신의 것을 움켜쥔다 %K2_EXPRESSION_VARIATION("PENIS")% 그녀의 손으로. 곧 절정에 이를 것 같은 느낌이다.
				SELECTCASE RAND:2
					CASE 1
						CALL K2_HPH_PRINT,@"「아핫, 사정할 거야? 아핫, 내 손으로 해줄까? 아핫」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「아, 사정할 것 같아? 좋아. 내 손에 정액을 뿌려줘」","W"
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕 || TALENT:セフレ
			IF ABL:指 >= 2
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「잘하고 있는 걸까? 이제 감이 잡히는 것 같아.」
					CASEELSE
						PRINTFORML 「흐읍... 흐읍... 괜찮아? 이거 고통스럽지 않아?」
						PRINTFORMDW 그녀의 빠른 손놀림으로 %CALLNAME:TARGET%당신을 자극하는 소리가 들렸다.
				ENDSELECT
			ELSE
				PRINTFORMW 「우으... 팔이 아파온다.」
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「내 손으로만 만질 거야. 알겠어.」
				CASEELSE
					PRINTFORML 「...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 소리 없이 손을 움직인다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
