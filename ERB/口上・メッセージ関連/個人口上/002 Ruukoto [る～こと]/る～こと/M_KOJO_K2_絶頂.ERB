	IF NOWEX:Ｃ絶頂
		;超強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｃ
		ELSEIF NOWEX:Ｃ絶頂 == 2
