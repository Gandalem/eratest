@M_KOJO_MESSAGE_PALAMCNG_B_K2
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		CALL K2_HPH_PRINT,@"「정말 좋아, 정말 최고야! 이거 진짜 굉장해」","L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 온몸이 연모액이 그녀에게서 쏟아져 나오자 경련한다.
		CALL K2_HPH_PRINT,@"「히이익, 아아우, 하하, 아-아-아아악 죽겠어」","L"
		CALL K2_HPH_PRINT,@"「흐읍, 후우, 하아, 하아, 하아하프」","L"
		PRINTFORMDW 흐트러진 %조사처리(CALLNAME:TARGET,"는")% 침을 흘리며 동물적으로 쾌감을 내뱉는다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		SELECTCASE RAND:2
			CASE 1
				CALL K2_HPH_PRINT,@"「흐으음, 안 돼아아안돼... 나, 나 갈 것 같아, 흐윽 아, 아아-또, 나 가버릴 것 같아, 흐윽」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 떨리는 몸이 강렬한 쾌감에 사로잡히며 분홍색으로 물든다. 
			CASEELSE
				CALL K2_HPH_PRINT,@"「나-난 안 돼, 더는 HPH 야아아, 나-내 몸 전체가 이상해 아하아HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 입을 크게 벌리고 숨을 헐떡인다.
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF K2_SEXUAL_FRANKNESS() && K2_CONSCIOUS_AND_TOLERANT() && !TALENT:無知
			SELECTCASE RAND:3
				CASE 1
					CALL K2_HPH_PRINT,@"「하아아! 아, 야아, 야아아아흐헵 나 곧 절정할 것 같아, 너무 많아 나는 절정에 다가고 있어 흐읍, 히이히헵」","W"
				CASE 2
					CALL K2_HPH_PRINT,@"「흐으, 아아, 너무 좋아, 후우, 흐아아아햣 나-나 사정할 것 같아햣」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「니히이, 나 기분 좋아져가-, 야하아, 이제 곧, 아하하프 하아, 하아, 하아아, 아아아아합」","W"
			ENDSELECT
		ELSE
			PRINTFORMW 「~~응-끄와아, 안 돼! 사정해버릴 것 같아, 아, 흐으~~!」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF K2_SEXUAL_FRANKNESS() && K2_CONSCIOUS_AND_TOLERANT() && !TALENT:無知
			SELECTCASE RAND:3
				CASE 1
					CALL K2_HPH_PRINT,@"「아, 안, 이히! 너무 좋다, 응흐햣 아핫, 후, 아하아아프」","W"
				CASE 2
					CALL K2_HPH_PRINT,@"「아, 기분이 좋아져... 흐으, 크으윽, 사정하는 중이야~~흐으」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「응, 음, 그래, 아하하하하아」","W"
			ENDSELECT
		ELSE
			PRINTFORMW 「하아, 하아, 냐아, 호구드, 아아아아」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;単部位の絶頂
	;-------------------------------------------------
	IF K2_SEXUAL_FRANKNESS() && K2_CONSCIOUS_AND_TOLERANT() && !TALENT:無知
		IF NOWEX:Ｃ絶頂
			;超強絶頂Ｃ
			IF NOWEX:Ｃ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K2_HPH_PRINT,@"「Anh Nha, 아아~~흐흑히이ㅎ프 노 모우르, 오고 있어, 나 오고 있어HPH」","W"
					CASE 2
						CALL K2_HPH_PRINT,@"「이히 아 나 내 1HPH로 오고 있어 \@ TALENT:性別 & 2 ? 성기 # 클리토리스 \@HPH 기분이 굉장해 HPH」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「NhiihHPH 내 \@ TALENT:性別 & 2 ? 페니스 # 클리토리스 \@, 멋지다, FwaahHPH 아, 하아, 아아아HPH」","W"
				ENDSELECT
				;強絶頂Ｃ
			ELSEIF NOWEX:Ｃ絶頂 == 2
				PRINTFORMW 「형, 나... 나 사정할 것 같아」
				;絶頂Ｃ
			ELSE
				PRINTFORMW 「하후우, 나, 니, 하아아」
			ENDIF
		ENDIF
		IF NOWEX:Ｖ絶頂
			;超強絶頂Ｖ
			IF NOWEX:Ｖ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K2_HPH_PRINT,@"「아앙, 내 질이여, 음 나의 부드러운 곳 아, 사정, 사정하고 있어」","W"
					CASE 2
						CALL K2_HPH_PRINT,@"「안, 으응, 아아, 하아아 내 보지, 보지, 너무 좋아」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「네가 내 보지에 문지르고 있구나, 놀랍다, 굉장하다 HPH 하, 하아, 사정하고 있어 HPH」","W"
				ENDSELECT
				;強絶頂Ｖ
			ELSEIF NOWEX:Ｖ絶頂 == 2
				PRINTFORMW 「오빠, 내 보지, 기분 좋아, 아후우, 후와아, 하아.」
				;絶頂Ｖ
			ELSE
				PRINTFORMW 「안 돼, 아잉.」
			ENDIF
		ENDIF
		IF NOWEX:Ａ絶頂
			;超強絶頂Ａ
			IF NOWEX:Ａ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K2_HPH_PRINT,@"「후우, 오호, 우와 내 엉덩이 구멍, 정말 굉장하다」","W"
					CASE 2
						CALL K2_HPH_PRINT,@"「내 엉덩이 속, 아, 맥박치고 있어 HPH 푸와아, 아, 내 정신이 하얘지고 있어 HPH」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「야아, 흐으읍 아, 거의 ~할 뻔했어, 나 사정할 것 같아아」","W"
				ENDSELECT
				;強絶頂Ａ
			ELSEIF NOWEX:Ａ絶頂 == 2
				PRINTFORMW 「내 엉덩이가 너무 뜨거워, 나 자꾸 사정해버릴 것 같아~~흐읍.」
				;絶頂Ａ
			ELSE
				PRINTFORMW 「내 배가 간지럽네, 이히, 응.」
			ENDIF
		ENDIF
		IF NOWEX:Ｂ絶頂
			;超強絶頂Ｂ
			IF NOWEX:Ｂ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K2_HPH_PRINT,@"「흐으으! 이 느낌HPH 내 가슴이 정말 좋아! 니히, 아, 아아—ㅎHPH」","W"
					CASE 2
						CALL K2_HPH_PRINT,@"「흐윽, 내 유두들이 HPH 타오르고 있어! 감각이 없어지네 HPH」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「후와아, 아아흐햣 내 가슴이 점점 짜릿해져」","W"
				ENDSELECT
				;強絶頂Ｂ
			ELSEIF NOWEX:Ｂ絶頂 == 2
				PRINTFORMW 「내 가슴이 정말 기분 좋아, 이히, 나아.」
				;絶頂Ｂ
			ELSE
				PRINTFORMW 「후와아, 아 흐으, 응.」
			ENDIF
		ENDIF
	ELSE
		IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「크윽, 하아, 흠.」
				CASE 2
					PRINTFORMW 「흐음, 후우아아.」
				CASEELSE
					PRINTFORMW 「아우, 이히, 쿠, 응으.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
