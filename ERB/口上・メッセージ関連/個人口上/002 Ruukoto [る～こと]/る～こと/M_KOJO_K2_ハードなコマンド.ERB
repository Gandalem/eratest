;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K2_140
CALL M_KOJO_MESSAGE_COM_K2_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	SELECTCASE RAND:2
		CASE 1
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 얼굴에 땀이 가득 차며 그녀는 필사적으로 당신의 %K2_EXPRESSION_VARIATION("PENIS")%를 빨아들인다.
			PRINTFORMW 「응으... 부호, 그루그... 하아... 하아... 흐윽... 고프후... 구포.」
		CASEELSE
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 아름다운 얼굴이 당신이 그녀의 목구멍으로 더욱 세게 밀어 넣자 일그러진다. 액체 점액이 천천히 코에서 나온다.
			PRINTFORMW 「크윽... 쿠포... 컥, 가하, 케호, 하아... 하... 응우... 구포...」
	ENDSELECT
ENDIF
RETURN 1
