;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K2_310
CALL M_KOJO_MESSAGE_COM_K2_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	$CARESS_HIP_LOOP
	IF CFLAG:うふふ != 2
		IF K2_CONSCIOUS_AND_TOLERANT()
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORMW 「하, 정말 무례하다! 그만해 주세요!」
				CASE 2,3
					IF TALENT:恋慕 || TALENT:愛欲
						SELECTCASE RAND:2
							CASE 1
								CALL K2_HPH_PRINT,@"「이건 괴롭힘으로 간주되지 않겠지... 침대에서 이걸 한다면... HPH」","W"
							CASEELSE
								CALL K2_HPH_PRINT,@"「야아, 계속 그러면... 일 못 하게 될 거야」","W"
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 1
								PRINTFORMW 「허-헤이, 왜 이렇게 갑자기 이러는 거야?」
							CASEELSE
								PRINTFORMW 「!? 야, 이봐, 그러시면 안 돼요.」
						ENDSELECT
					ENDIF
				CASE 4
					;無知でない、かつ恋慕or愛欲、かつ欲望10以上or人目がない
					IF !TALENT:無知 && ( TALENT:恋慕 || TALENT:愛欲 ) && ( ABL:欲望 >= 10 || !EYEWITNESS() )
						SELECTCASE RAND:3
							CASE 1
								IF BASE:ムード >= 750 && BASE:理性 < 800 && CFLAG:溜まってる度 >= 500
									CALL K2_HPH_PRINT,@"「나만 만지지 말고, 섹스하는 것도 괜찮아...후훗」","W"
								ELSE
									GOTO CARESS_HIP_LOOP
								ENDIF
							CASE 2
								CALL K2_HPH_PRINT,@"「AnhHPH 나를 성적으로 희롱하고 싶어?HPH」","W"
							CASEELSE
								CALL K2_HPH_PRINT,@"「NhHPH %CALLNAME:MASTER%-님은-HPH」","W"
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 1
								PRINTFORMW 「안 돼... 너를 도울 방법은 없어.」
							CASEELSE
								PRINTFORMW 「이야, 아키 %CALLNAME:MASTER%-님 잠깐만요, 그건 너무 음란해요.」
						ENDSELECT
					ENDIF
			ENDSELECT
		ELSEIF SHIRAHU(TARGET) && TFLAG:193 == 1
			PRINTFORMW 「히익, 뭐, 뭘 하는 거야? 변태 같아!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K2_311
CALL M_KOJO_MESSAGE_COM_K2_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_CONSCIOUS_AND_TOLERANT() && !K2_EXCESSIVE_STATURE_GAP()
		IF CFLAG:うふふ != 2
			IF TALENT:恋慕 && BASE:ムード >= 500 && BASE:理性 < 975
				SELECTCASE RAND:3
					CASE 1
						CALL K2_HPH_PRINT,@"「후후후 나를 더 꼭 안아줘 후후후」","W"
					CASE 2
						CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-님의 심장 박동이 느껴진다」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「너 나 너무 세게 안아」","W"
				ENDSELECT
			ELSEIF ( TALENT:思慕 && !TALENT:ヤリマン && BASE:ムード >= 750 && BASE:理性 < 700 ) || TALENT:恋慕
				PRINTFORMW 「아은 %CALLNAME:MASTER%-님, 이렇게 안으면 움직일 수가 없어요.」
			ELSEIF TALENT:思慕 && !TALENT:ヤリマン
				PRINTFORMW 「아우... 어쩐지 내 몸이 너무 기분 좋고 따뜻해지는 것 같아.」
			ELSEIF ABL:親密 >= 6
				IF ( TALENT:愛欲 || TALENT:ヤリマン )
					IF ( TALENT:愛欲 && BASE:ムード >= 500 && BASE:理性 < 975 ) || ( TALENT:ヤリマン && BASE:ムード >= 750 && BASE:理性 < 700 )
						SELECTCASE RAND:2
							CASE 1
								CALL K2_HPH_PRINT,@"「야한HPH 너 그냥 아이처럼 행동하는 거야? 아니면 기분이 좋은 거야?HPH」","W"
							CASEELSE
								CALL K2_HPH_PRINT,@"「어라? 그냥 포옹하는 거야, 아니면 섹스를 원하는 거야?HPH」","W"
						ENDSELECT
					ELSE
						PRINTFORMW 「갑자기. 무슨 일이야? 흥분했어?」
					ENDIF
				ELSE
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「히야아, 그게 간지러워.」
						CASEELSE
							PRINTFORMW 「으응... 너무 꽉 조여.」
					ENDSELECT
				ENDIF
			ELSE
				PRINTFORMW 「히익! 그, 그렇게 놀라게 하지 마요...」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K2_312
CALL M_KOJO_MESSAGE_COM_K2_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_BASIC_CONDITION_IN_MATING()
		;押し倒され中
		IF CFLAG:うふふ == 2
			IF TALENT:恋慕 || TALENT:愛欲
				IF !RAND:10
					PRINTFORMDL 당신과 혀를 얽는 것 외에도, %조사처리(CALLNAME:TARGET,"의")% 입술은 당신의 목과 쇄골을 더듬는다.
					CALL K2_HPH_PRINT,@"「아흣, 이런 곳에 흔적을 남기면 모두가 알아챌 거야흣」","W"
				ELSEIF !RAND:3
					CALL K2_HPH_PRINT,@"「하무... 응... 추우프 나추... 추푸... 누... 하아프」","W"
				ELSEIF RAND:2
					CALL K2_HPH_PRINT,@"「흐으읍... 쪽... 츄... 추루... 음... 츕후프」","W"
				ELSE
					CALL K2_HPH_PRINT,@"「츄... 쪽... 응... 하아헵 더 해줘헵 암무... 쪽...응힉헵」","W"
				ENDIF
			ELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「음... 쪽... 츄릅... 음...」
					CASEELSE
						PRINTFORMW 「음... 하아... 함무... 추푸...」
				ENDSELECT
			ENDIF
			;キス拒絶ではない
		ELSEIF TFLAG:193 != 99
			IF BASE:ムード >= 650 && BASE:理性 < 875
				IF TALENT:恋慕 || ( TALENT:愛欲 && ( ABL:親密 >= 5 || ABL:欲望 >= 5 ) )
					SELECTCASE RAND:2
						CASE 1
							CALL K2_HPH_PRINT,@"「츄...츄파헵... 페로... 나아헵」","W"
						CASEELSE
							CALL K2_HPH_PRINT,@"「하무... 응추... 레로... 추...츄파헵」","W"
					ENDSELECT
				ELSEIF ABL:親密 >= 5 || ABL:欲望 >= 5
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「응... 흐음... 추... 누구.」
						CASEELSE
							PRINTFORMW 「아... 츄우... 흐읍... 하아.」
					ENDSELECT
				ELSE
					PRINTFORMW 「아... 은... 추...」
				ENDIF
			ELSE
				IF TALENT:恋慕 || ( TALENT:愛欲 && ( ABL:親密 >= 5 || ABL:欲望 ) )
					PRINTFORMW 「아... 응... 너무 갑작스러웠어.」
				ELSE
					PRINTFORMW 「누구야?! 규우, 갑자기 왜 그래?」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;313,胸愛撫
;CFLAG:うふふ==2&&TCVAR:20(27=谷間を見せる 33=胸を揉ませる 53=パイズリ(小分岐は地の文EVENT_MESSAGE_COM_セクハラ.ERB参照) 73=ぱふぱふ 77=乳を吸わせる 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;ABL:Ｂ感覚(2未満=性的には感じてない 5未満=多少感じてる 5以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;乳のサイズでも変わる場合があるので、地の文EVENT_MESSAGE_COM_セクハラ.ERB参照
;==================================================

@M_KOJO_MESSAGE_COM_K2_313
CALL M_KOJO_MESSAGE_COM_K2_313_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_BASIC_CONDITION_IN_MATING()
		;非押し倒され
		IF CFLAG:うふふ != 2
			IF TALENT:恋慕 || TALENT:愛欲
				;ムード半分以上、理性半分未満
				IF BASE:ムード >= 750 && BASE:理性 < 500
					;人目があるか屋外
					IF EYEWITNESS() || OPENPLACE(CFLAG:MASTER:現在位置) >= 2
						SELECTCASE RAND:2
							CASE 1
								CALL K2_HPH_PRINT,@"「음... 휴. 아무튼, 좀 더 조용한 곳에서 이걸 해야 할 것 같아... 휴.」","W"
							CASEELSE
								CALL K2_HPH_PRINT,@"「야아, 여기 같은 곳에선 안 돼.」","W"
						ENDSELECT
					ELSE
						IF TEQUIP:上半身着衣状況 & 2 && RAND:2
							CALL K2_HPH_PRINT,@"「옷 입은 채로 괜찮아? HPH」","W"
						ELSE
							CALL K2_HPH_PRINT,@"「후후, 내 가슴 좋아해?HPH」","W"
						ENDIF
					ENDIF
				ELSE
					PRINTFORMW 「또 장난치는군. 그만둬.」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
