;==================================================
;315,クリ愛撫
;CFLAG:うふふ==2&&TCVAR:20(35=スカートの中を見せる 70=クンニ強制 85=Ｖ挿入する 86=だいしゅきホールド 87=Ａ挿入する 88=腰振りＶ 89=腰振り
;ABL:Ｃ感覚(4未満=くすぐったい 6未満=ちょっといいかも 6以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K2_315
CALL M_KOJO_MESSAGE_COM_K2_315_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_315_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_BASIC_CONDITION_IN_MATING()
		IF CFLAG:うふふ != 2
			IF TALENT:恋慕 || TALENT:愛欲
				IF BASE:ムード >= 750 && BASE:理性 < 500
					;人目があるか屋外
					IF EYEWITNESS() || OPENPLACE(CFLAG:MASTER:現在位置) >= 2
						;下半身丸出しかノーパンスカート、かつランダム３分の２
						IF TEQUIP:下半身着衣状況 <= 1 && RAND:3
							;人がいる、かつランダム２分の１
							IF ( GET_TARGETNUM() >= 2 || DATE_HITOGOMI(CFLAG:MASTER:現在位置) || WITH_MOB() ) && RAND:2
								CALL K2_HPH_PRINT,@"「아아, 정말 음란한 소리들 HPH 들리는구나 HPH」","W"
							ELSE
								CALL K2_HPH_PRINT,@"「나의 \@ TALENT:性別 & 2 ? 페니스 # 질 \@ 이 보인다 %COND_STR(@" by someone else", GET_TARGETNUM() >= 2)%HPH 야아, 나...HPH」","W"
							ENDIF
						ELSE
							CALL K2_HPH_PRINT,@"「안 돼아아, 그런 곳을 만지면 안 돼에에」","L"
							SIF ABL:Ｃ感覚 >= 4 && K2_SEXUAL_FRANKNESS()
								PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 틀렸다고 말했음에도, 당신은 계속 손으로 그녀의 가랑이를 문지른다.
							WAIT
						ENDIF
					ELSE
						;下半身丸出しかノーパンスカート
						IF TEQUIP:下半身着衣状況 <= 1
							IF ( CFLAG:1001 || TALENT:愛欲 ) && RAND:2
								SIF CFLAG:1001 && (TALENT:性別 & 2) == 0
									PRINTFORMDL 그녀의 큰 클리토리스는 더 이상 후드 안에 맞지 않으며, 피로 차오르면서 더욱 단단해진다.
								CALL K2_HPH_PRINT,@"「손가락만 쓰지 말고, 더 굵은 걸 나한테 줘 HPH」","W"
							ELSE
								CALL K2_HPH_PRINT,@"「아, 나, 느, 아후, 하안HP」","L"
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 거칠게 숨을 몰아쉬고, 당신의 눈빛은 앞으로 일어날 일들에 대한 기대감으로 그녀를 가득 채우며 그녀를 바라본다.
							ENDIF
						ELSE
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 초조해하는 것 같다.
							CALL K2_HPH_PRINT,@"「누쿠, 한프에이 나는 오직 %CALLNAME:MASTER%-님의 손가락을 느끼고 싶어」","W"
						ENDIF
					ENDIF
				ELSE
					PRINTFORMW 「말도 안 돼, 희망이 없어.」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
