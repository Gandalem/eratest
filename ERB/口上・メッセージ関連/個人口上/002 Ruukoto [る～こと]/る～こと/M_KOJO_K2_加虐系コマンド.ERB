;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K2_100
CALL M_KOJO_MESSAGE_COM_K2_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	$SPANKING_LOOP
	IF ( TALENT:恋慕 || TALENT:愛欲 || TALENT:思慕 || TALENT:セフレ ) && K2_BASIC_CONDITION_IN_MATING()
		IF ( ABL:マゾっ気 >= 4 || ( TALENT:マゾ && ABL:マゾっ気 >= 2 ) ) && ( !TALENT:サド || ABL:欲望 >= 20 )
			SELECTCASE RAND:4
				CASE 1
					IF CFLAG:1001 && !RAND:3
						IF TALENT:恋慕 || TALENT:恋人
							CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-님께 처녀성을 드리지 못한 것을 용서해 주세요」","L"
							CALL K2_HPH_PRINT,@"「두 번째로 온 로봇이 다른 성기를 그녀의 HPH 안에 허락한 것을 용서해 주세요」","W"
						ELSEIF ABL:清掃技能 + ABL:料理技能 < 4
							CALL K2_HPH_PRINT,@"「섹스 외에는 아무것도 모르는 무엄한 하녀를 벌해달라. 그녀의 임무가 무엇인지 상기시켜 주렴」","W"
						ELSE
							CALL K2_HPH_PRINT,@"「흐으, 하아... 다른 사람과 자버린 이 걸레 같은 메이드의 용서를 구합니다...하아...」","W"
						ENDIF
					ELSE
						GOTO SPANKING_LOOP
					ENDIF
				CASE 2
					CALL K2_HPH_PRINT,@"「아하후후 이 쓸모없는 하녀를 더 벌해주세요후후」","W"
				CASE 3
					CALL K2_HPH_PRINT,@"「흐읍흑 아아앗 아파요, 그런데 또 기분이 좋아요」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「아히이후 카아, 니후 나아, 하아... 후우... 끝난 거야?」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「우으... 맞으니까 아파...」
				CASEELSE
					PRINTFORMW 「응쿠... 내 엉덩이가 얼얼해...」
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「아야... 아파요, 그만해 주세요.」
			CASEELSE
				PRINTFORMW 「으윽, 읍, 하아, 하아... 그만해 주세요...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
