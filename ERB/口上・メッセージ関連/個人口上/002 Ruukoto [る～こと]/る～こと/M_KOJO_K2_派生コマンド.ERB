@M_KOJO_MESSAGE_SCOM_K2_7
IF K2_BASIC_CONDITION_IN_MATING() && CFLAG:1001 && TALENT:体型 >= -1 && TALENT:MASTER:性別 & 2 && TALENT:MASTER:形状 < 3
	RESETCOLOR
	DRAWLINE
	IF TEQUIP:乳首吸い
		CALL MESSAGE_EQUIP_COM11
	ELSEIF TEQUIP:胸揉み
		CALL MESSAGE_EQUIP_COM12
	ENDIF
	PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 자궁을 뚫으려고 열렬하게 골반을 흔든다.
	PRINTFORMDL 하지만 당신의 성기는 그 깊이까지 도달할 수 없었다.
	SIF !NOWEX:Ｖ絶頂
		PRINTFORMDL 그녀의 가장 깊은 곳에 겨우 닿을 수 있다는 것을 감지한 후, %조사처리(CALLNAME:TARGET,"는")%(는) \@ TEQUIP:アイマスク ? %" "%처럼 보인다 # 's 표정이 \@ %TEXTR("disappointed/unhappy/unsatisfied")%.
	PRINTW
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{TARGET}
	IF ( TALENT:サド && !TALENT:マゾ ) || ABL:サドっ気 >= 10
		IF TALENT:MASTER:形状 == 1
			LOCALS = %TEXTR("childish/small/immature/infantile")%
		ELSEIF TALENT:MASTER:形状 == 2
			LOCALS = %TEXTR("lame/little/thumb-sized/dwarfish")%
		ENDIF
	ELSE
		IF TALENT:MASTER:形状 == 1
			LOCALS = %TEXTR("small/childish/undersized")%
		ELSEIF TALENT:MASTER:形状 == 2
			LOCALS = %TEXTR("cute/short/teeny")%
		ENDIF
	ENDIF
	;今回Ｖ絶頂なし
	IF !NOWEX:Ｖ絶頂
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMDL %CALLNAME:TARGET%그리고 당신은 크게 골반을 흔든다. 그녀의 질에서 네 페니스를 빼자 그것은 %TEXTR("spurting/popping")% 소리.
				CALL K2_HPH_PRINT,@"「야한HP %CALLNAME:MASTER%-님의 성기가, 빠지고 있어!」","L"
				IF TEQUIP:体位 == 1 || TEQUIP:体位 == 2 || TEQUIP:縄 || TEQUIP:拘束
					CALL K2_HPH_PRINT,@"「응 HPH 당신의 %LOCALS% 성기를 다시 넣어 주세요 HPH」","L"
					IF TEQUIP:縄 || TEQUIP:拘束
						PRINTFORMD 그녀는 자신의 입구를 벌려 달콤한 곳을 드러냈다. 
					ELSEIF TEQUIP:体位 == 1
						PRINTFORMD %TEXTR("She widely spreads herself/She shows off her red insides")%. 
					ELSE
						PRINTFORMD 그녀는 초조하게 골반을 흔든다. 
					ENDIF
					PRINTFORMDW %CALLNAME:TARGET% %TEXTR("pleads to you/pesters you")% 네가 %K2_EXPRESSION_VARIATION("PENIS")%을 안에 삽입한 후에, 그렇게 한 뒤 그녀를 다시 거칠게 두들겨 때렸다.
				ELSE
					CALL K2_HPH_PRINT,@"「좋은 HPH 당신의 %LOCALS% 성기를 한 번 더 삽입하세요 HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 자신의 비밀스러운 곳을 드러내자, 당신의 %K2_EXPRESSION_VARIATION("PENIS")%가 다시 발기하고, 당신은 다시 한번 페니스를 삽입하며 허리를 끊임없이 흔든다.
				ENDIF
			CASE 2
				CALL K2_HPH_PRINT,@"「흐응, 더 깊이 원해HPH 더 세게 밀어줘HPH 최선을 다해줘, %LOCALS% 페니스HPH」","W"
			CASEELSE
				PRINTFORML 「아, %CALLNAME:MASTER%-님의 %LOCALS% 거시기 깊숙이 들어오지 않네요.」
				CALL K2_HPH_PRINT,@"「이리 와요 HPH 더 세게 밀어넣어야 해요, 제 안 깊숙이 전부 넣어주세요 HPH」","W"
		ENDSELECT
		;今回Ｖ絶頂
	ELSE
		SELECTCASE RAND:3
			CASE 1
				CALL K2_HPH_PRINT,@"「아앙, 아직 가장 깊은 곳까지는 도달하지 못했지만 그래도... 곧 사정할 거야HPH」","L"
				CALL K2_HPH_PRINT,@"「아, 아, %CALLNAME:MASTER%-님의 %LOCALS% 거시기 때문에 절 가버려요 HPH 나 갈 것 같아요 HPH」","W"
			CASE 2
				CALL K2_HPH_PRINT,@"「아하하pH %CALLNAME:MASTER%-님은 \@ TALENT:MASTER:性別 == 2 ? 그가 # 그녀가 \@ 절박할 때 귀엽다」","L"
				CALL K2_HPH_PRINT,@"「%조사처리(CALLNAME:TARGET,"는")% %CALLNAME:MASTER%님의 %LOCALS% 페니스로 만족하고 있다. 그러니 부디, 긴장을 풀어라」","W"
			CASEELSE
				CALL K2_HPH_PRINT,@"「하아앙후우 드디어. 네 %LOCALS% 페니스가 좋아졌어 HPH」","L"
				CALL K2_HPH_PRINT,@"「아아, 하아햔 나 곧 갈 것 같아햔 오고 있어햔」","W"
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K2_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	$PICK_OS_UTERI_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		SELECTCASE EXP:子宮口開発経験
			CASE IS < 25
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「오쿠하, 크후. 잠깐, 아파요, 니.」
					CASEELSE
						PRINTFORMW 「응, 크으윽. 쿠하, 하아, 콰악.」
				ENDSELECT
			CASE 25 TO 50
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「잠깐만, 아직 이 감각에 익숙해지지 않았어. 으윽.」
					CASEELSE
						PRINTFORMW 「오쿠, 음, 이상해, 응.」
				ENDSELECT
			CASE IS > 50
				IF TALENT:恋慕 || TALENT:愛欲 || ( TALENT:ヤリマン && ABL:Ｖ感覚 >= 5 )
					IF NOWEX:MASTER:射精 && ABL:膣射中毒 >= 4 && !TEQUIP:MASTER:コンドーム
						SELECTCASE RAND:2
							CASE 1
								CALL K2_HPH_PRINT,@"「아, 당신의 성기가 흥분한 것 같네요. HPH 아마 넣을 거죠, 그렇죠? HPH」","L"
								CALL K2_HPH_PRINT,@"「제발 저의 가장 깊은 곳까지 채워주세요」","W"
							CASEELSE
								CALL K2_HPH_PRINT,@"「당신의 페니스가 내 자궁을 치고 있어 HPH 계속 그렇게 해줘 부탁이야 HPH」","L"
								CALL K2_HPH_PRINT,@"「나의 사랑스러운 자궁을 네 씨로 가득 채워줘 HPH」","W"
						ENDSELECT
					ELSE
						SELECTCASE RAND:3
							CASE 1
								IF K2_SEXUAL_FRANKNESS()
									CALL K2_HPH_PRINT,@"「아아헵 말해야겠어, 정말 기분 좋아헵」","W"
								ELSE
									GOTO PICK_OS_UTERI_LOOP
								ENDIF
							CASE 2
								CALL K2_HPH_PRINT,@"「너무 깊숙이 내 안에 있어 HPH Nku, NfuuuHPH」","W"
							CASEELSE
								CALL K2_HPH_PRINT,@"「후와, 하아아프흐 온몸이 떨려, 흐으윽」","W"
						ENDSELECT
					ENDIF
				ELSE
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「흐읍, 아아, 내 자궁. 아아!」
						CASEELSE
							PRINTFORMW 「후와아, 박히네, 내 자궁이. 후우!」
					ENDSELECT
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
