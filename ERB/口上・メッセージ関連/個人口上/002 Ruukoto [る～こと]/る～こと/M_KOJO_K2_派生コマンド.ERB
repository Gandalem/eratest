;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K2_6
CALL M_KOJO_MESSAGE_SCOM_K2_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K2_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	$PICK_G_SPOT_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲 || ( TALENT:ヤリマン && ABL:Ｖ感覚 >= 5 )
			SELECTCASE RAND:4
				CASE 1
					;真正ヤリマン、Ｖ拡張経験あり、主人にペニスあり、ランダム６分の１
					IF CFLAG:1001 && EXP:Ｖ拡張経験 > 0 && TALENT:MASTER:性別 & 2 && !RAND:6
						PRINTFORML 「음, 내 보지가 풀릴까?」
						PRINTFORMDL 걱정할 것 없다고 불안해하는 %조사처리(CALLNAME:TARGET,"에게")% 말한 후, 그녀는 기쁘게 자신의 틈을 조여왔다.
						CALL K2_HPH_PRINT,@"「경험 많은 질로 당신을 기쁘게 해 드릴게요. 너무 심하게 다루지 말아 주세요 HPH」","W"
						;真正ヤリマン、主人の腰３以上、今回あたえる快Ｖが４０００以上
					ELSEIF CFLAG:1001 && ABL:MASTER:腰 >= 3 && CUP:快Ｖ >= 4000
						CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-님의 허리가 좋다HPH 당신은 이것을 정말 잘한다HPH」","W"
					ELSE
						GOTO PICK_G_SPOT_LOOP
					ENDIF
				CASE 2
					IF ABL:Ｖ感覚 >= 5
						CALL K2_HPH_PRINT,@"「흐음... 왜 이렇게 하는 게 이렇게 기분 좋을까? 히히, 니히히」","W"
					ELSE
						GOTO PICK_G_SPOT_LOOP
					ENDIF
				CASE 3
					IF K2_SEXUAL_FRANKNESS()
						CALL K2_HPH_PRINT,@"「정말 굉장해, 정말 멋져! 아아, 응, 하아아흐으읍」","W"
					ELSE
						GOTO PICK_G_SPOT_LOOP
					ENDIF
				CASEELSE
					CALL K2_HPH_PRINT,@"「나한테 비벼지고 있어, 내가 찢어지고 있어」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「응, 하아, 으음. 이상해, 아.」
				CASEELSE
					PRINTFORMW 「흐읍. 그게, 아아, 감각이 없어, 응」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2_{SELECTCOM}_1
RETURN 1
