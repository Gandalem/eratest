;5,手淫フェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K2_5
CALL M_KOJO_MESSAGE_SCOM_K2_5_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K2_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	$HAND_BLOWJOB_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:6
				CASE 1
					IF ABL:技巧 >= 4
						CALL K2_HPH_PRINT,@"「츄루, 너를 이렇게 아무렇지도 않게 만지다니」","L"
						CALL K2_HPH_PRINT,@"「큐우. 뜻밖에도 귀엽네HPH」","W"
					ELSE
						GOTO HAND_BLOWJOB_LOOP
					ENDIF
				CASE 2
					IF ABL:舌 >= 3 && ABL:指 >= 2
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 볼을 다람쥐처럼 부풀리며 당신의 귀두를 자신의 뺨 안쪽에 비빈다.
						CALL K2_HPH_PRINT,@"「흐으음... 하아... 츕... 후우읍... 음... 아아... 아... 으윽... 주르륵...」","L"
						PRINTFORMDW 그녀의 입에서 많은 양의 %조사처리(CALLNAME:TARGET,"가")% 넘쳐 바닥에 얼룩을 남겼다.
					ELSE
						GOTO HAND_BLOWJOB_LOOP
					ENDIF
				CASE 3
					IF !TEQUIP:MASTER:コンドーム
						CALL K2_HPH_PRINT,@"「팁에서 진액이 넘쳐흐른다」","W"
					ELSE
						GOTO HAND_BLOWJOB_LOOP
					ENDIF
				CASE 4
					IF !TEQUIP:MASTER:コンドーム
						CALL K2_HPH_PRINT,@"「함후... 추... 후후푸흐 코크, 오므후후프」","W"
					ELSE
						GOTO HAND_BLOWJOB_LOOP
					ENDIF
				CASE 5
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 미친 듯이 너를 빨아들인다.
					CALL K2_HPH_PRINT,@"「쥬루... 츄푸... 응... 쥬루루햎 쥬포... 쥬포햎」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「응, 주포, 응, 네 성기 밑부분 기분 좋아?」","W"
			ENDSELECT
			IF NOWEX:MASTER:射精 && ( TCVAR:精飲経験 > 0 || TEQUIP:MASTER:コンドーム )
				PRINTL
				PRINTFORMDL %CALLNAME:TARGET%당신의 고환을 움켜쥐고, 당신이 사정할 것을 감지하자 그녀는 절정에 이를 때까지 격렬하게 자극했다.
				CALL K2_HPH_PRINT,@"「아하후프 나의 손이 %CALLNAME:MASTER%-님의 거시기 위에 있는데, 정말 음란한 소리가 나네후프」","L"
				CALL K2_HPH_PRINT,@"「EiiHPH EiHPH \@ !TEQUIP:MASTER:コンドーム && RAND:2 ? 내 혀에 네 성기 정액을 싸줘 # 제발, 내게 흰 정액을 줘 \@HPH」","W"
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 1
					IF ABL:技巧 >= 4
						PRINTFORMW 「응츄, 응, 네 고환도 만져볼까? 알았어. 하암프.」
					ELSE
						PRINTFORMW 「응후, 하... 손이랑 입을 동시에 움직이기가 힘드네.」
					ENDIF
				CASEELSE
					PRINTFORMW 「아무... 츄파... 피차... 음... 후와」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2_{SELECTCOM}_1
RETURN 1
