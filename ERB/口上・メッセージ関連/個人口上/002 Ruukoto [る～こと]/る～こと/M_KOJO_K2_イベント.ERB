@M_KOJO_EVENT_K2_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;疲れた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:愛欲 || TALENT:ヤリマン
			PRINTFORMW 「하아... 아직 더 원했는데... 하지만 너무 지쳤어.」
		ELSE
			PRINTFORML 「하아... 하아... 용서해줘... 무슨 일이 일어난 것에 대해.」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 피곤함을 느끼고 당신의 몸을 놓는다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;満足して解放
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:愛欲 || TALENT:ヤリマン
			IF K2_SEXUAL_FRANKNESS() && !RAND:3
				CALL K2_HPH_PRINT,@"「하아햣, 그거 꽤 좋았어햣」","L"
			ELSEIF RAND:2
				CALL K2_HPH_PRINT,@"「하아, 하프 나는 당신의 사랑을 너무 많이 받았어, 하프」","L"
			ELSE
				CALL K2_HPH_PRINT,@"「당신의 연모를 주셔서 감사합니다.」","L"
			ENDIF
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 만족스럽게 미소 지으며 당신의 뺨에 키스한 뒤 놓아준다.
		ELSE
			PRINTFORML 「정말 미안해. 그건 너무...」
			PRINTFORMDW %CALLNAME:TARGET%그녀가 너를 공격하고 자신을 %TEXTR("desire/lust")% 차지하게 한 것에 대해 사과했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;満足したところを押し倒された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;壊れるまでしてあげる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
