						CALL K2_HPH_PRINT,@"「우응~ 아직 너랑 더 섹스하고 싶었는데... 우응」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 여전히 거칠게 숨을 몰아쉬면서 눈에 물기를 머금고 당신을 본다.
					ELSE
						CALL K2_HPH_PRINT,@"「...알겠어. 다음엔 더 잘할게HPH」","W"
					ENDIF
				ELSEIF TALENT:セフレ
					PRINTFORML 「아... 음... 만족해?」
					SIF CFLAG:溜まってる度 >= 300
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 아직 만족하지 못한 것 같다.
					WAIT
				ELSE
					PRINTFORML 「아... 내 쪽에서 불쾌한 행동을 한 것 같네... 용서해 주게.」
					SIF CFLAG:溜まってる度 >= 300
						PRINTFORMDL %CALLNAME:TARGET%떠나면서 아래를 내려다본다. 그녀는 욕망을 채우지 못한 것 같다.
					WAIT
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード満足終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード強制終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;好きにして状態から抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;欲求不満が高くて抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			RETURN 1
		ENDIF
		IF K2_CONSCIOUS_AND_TOLERANT() && !TALENT:無知
			IF TALENT:恋人 || TALENT:恋慕 || TALENT:愛欲 || TALENT:ヤリマン
				SELECTCASE RAND:2
					CASE 1
						CALL K2_HPH_PRINT,@"「야한HP 도망가지 마 HP 아직 만족 못 했어 HP」","W"
					CASEELSE
						CALL K2_HPH_PRINT,@"「소용없어. HPH 더 나를 사랑해줘. HPH」","W"
				ENDSELECT
			ELSE
				PRINTFORML 「...미안해... 하지만 난 아직 더 원해...」
				PRINTFORMDW %CALLNAME:TARGET%너를 놓치지 않으려고 꼭 안았다.
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
