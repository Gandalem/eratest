				IF TALENT:恋人 || TALENT:恋慕
					CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-samaHPH」","L"
					SIF !K2_EXCESSIVE_STATURE_GAP()
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그녀의 팔로 너의 몸을 움켜쥔다.
					IF !FLAG:甲斐性無 && RAND:2
						CALL K2_HPH_PRINT,@"「너와 함께 하고 싶어HPH」","W"
					ELSE
						CALL K2_HPH_PRINT,@"「에헤헤햣 난 너무 더러워졌네햣」","W"
					ENDIF
				ELSEIF TALENT:ヤリマン || TALENT:愛欲
					CALL K2_HPH_PRINT,@"「너무 흥분해서 HPH, %CALLNAME:MASTER%님께 진정하는 것을 도와달라고 하고 싶어 HPH」","W"
