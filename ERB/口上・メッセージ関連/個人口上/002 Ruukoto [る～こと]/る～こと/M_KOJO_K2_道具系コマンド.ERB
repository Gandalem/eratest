;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K2_50
CALL M_KOJO_MESSAGE_COM_K2_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF !TEQUIP:PLAYER:コンドーム ;for equip only
			RETURN 0
		ELSEIF K2_CONSCIOUS_AND_TOLERANT() && !TALENT:無知 && FIRSTTIME(SELECTCOM)
			IF !CFLAG:妊娠自覚状態 && !EXP:出産経験
				PRINTFORMW 「나는 로봇이니까 임신도 못 하고 무슨 질병에도 걸리지 않아...」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 네가 콘돔을 끼려고 하는 것을 보자 당황한 듯하다.
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;装着
	IF TEQUIP:MASTER:コンドーム
		IF K2_CONSCIOUS_AND_TOLERANT() && !TALENT:無知
			;育児中の子なし
			IF CFLAG:育児人数 == 0
				IF TALENT:恋慕 && CFLAG:生理周期 >= 3
					PRINTFORML 「아... 당신에게 끼워 줄게요, 거기...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 실망한 표정을 지었다.
				ELSEIF ( TALENT:恋慕 || TALENT:愛欲 ) && ABL:精液中毒 >= 5
					PRINTFORML 「나에게 너의 연모액을 먹여주지 않을래?」
					PRINTFORMDW %CALLNAME:TARGET%표정은 배고픈 강아지 같았다.
				ENDIF
			ENDIF
		ENDIF
		;外す
	ELSE
	ENDIF
ENDIF
RETURN 1
