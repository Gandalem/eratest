@M_KOJO_MESSAGE_COM_K2_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF !K2_EXCESSIVE_STATURE_GAP()
		;真正ヤリマン
		IF CFLAG:1001
			;同一対象にクンニを連続実行
			IF PREVCOM == SELECTCOM && MASTER_POSE(SET_C,SET_M,1) == TARGET
				PRINTFORMDL 당신의 뇌가 로봇의 여성스러운 냄새를 감지하자, 당신은 황홀경 속에서 %조사처리(CALLNAME:TARGET,"의")% 비밀스러운 곳을 음미하며 머리가 저릿해지는 것을 느낀다.
			ELSE
				PRINTFORMDL 당신은 두 손으로 로봇의 대음순을 넓게 벌렸고, 그녀의 분홍색 막이 확장되어 마름모꼴의 형상을 만들었다. 
				PRINTFORMDL 한 번 공개적으로 노출된 질 입구가 떨리며, 당신이 조심스럽게 핥자 그것에 반응했다.
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMDL 당신은 로봇의 치골 부위를 에로틱하게 핥는다.
				CASEELSE
					PRINTFORMD 당신은 그녀의 사랑스러운 하얀 피부를 양쪽으로 벌려 자신의 혀가 그녀의 분홍빛 안을 기어 다니게 했다. 
					SELECTCASE PALAM:潤滑
						CASE IS >= PALAMLV:5
							PRINTFORMDL 그녀는 완전히 %TEXTR("moist/soaked/wet")%해지면 강한 여성적인 향을 풍긴다. 
						CASE IS >= PALAMLV:3
							PRINTFORMDL 그녀는 천천히 젖으면서 여성스러운 향을 내기 시작한다. 
						CASEELSE
							PRINTFORMDL 네 타액으로 그녀를 적시자, 반짝이는 사랑의 진액이 그녀에게서 흘러나온다.
					ENDSELECT
			ENDSELECT
		ENDIF
		$CUNNILINGUS_LOOP
		IF K2_BASIC_CONDITION_IN_MATING()
			IF TALENT:恋慕 || TALENT:愛欲
				SELECTCASE RAND:7
					CASE 1
						IF CFLAG:1001 && ( ABL:露出癖 <= 2 || TALENT:羞恥心 >= 0 || !RAND:4 )
							CALL K2_HPH_PRINT,@"「내 가랑이, 아주 사랑스러워졌어... 좀 부끄럽네HPH」","L"
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 2
						IF ABL:MASTER:舌 >= 4 && ABL:Ｃ感覚 >= 5
							PRINTFORMDL 당신의 혀가 그녀에게 닿는다 \@ TALENT:性別 & 2 ? 음경 # 음핵 \@ 위쪽을 핥을 때마다 음란한 소리를 만들어낸다. 
							LOCALS:0 = 
							IF BEDROOM() && !TEQUIP:縄 && !TEQUIP:拘束
								LOCALS:0 '= @"시트를 움켜쥔다"
							ELSEIF !TEQUIP:縄 && !TEQUIP:拘束
								LOCALS:0 '= @"그녀는 손으로 당신을 움켜쥔다."
							ELSE
								LOCALS:0 '= @"이를 악물면서."
							ENDIF
							PRINTFORMDL %CALLNAME:TARGET% %LOCALS:0% 그녀는 작은 신음을 흘렸다.
							CALL K2_HPH_PRINT,@"「히이휴 히, 우와아,냐아, 하 후우후프」","L"
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 3
						IF K2_SEXUAL_FRANKNESS()
							CALL K2_HPH_PRINT,@"「아, 하아, 나하프 와-멋지다, 나하프」","L"
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 4
						PRINTFORMD 당신은 그녀와 놀았다 
						IF !(TALENT:性別 & 2) && RAND:2
							IF CFLAG:1001
								PRINTFORMD %TEXTR("big/fat/engorging")%%TEXTR("clit/clitoris")% 네 입을 사용해서 그것을 놀린다
							ELSE
								PRINTFORMD %TEXTR("swollen/hidden/lovely")% 당신의 입을 이용해서 그리고 그것을 %TEXTR("clit/clitoris")% 했다 %TEXTR("kiss/smooch/peck")% 
							ENDIF
						ELSE
							IF CFLAG:1001
								PRINTFORMD %TEXTR("big/large/lewd/obscene")% %TEXTR("flesh/entrance/labia")% 입을 사용해서 
							ELSE
								PRINTFORMD %TEXTR("stiff/excited/moist")% 네 입을 사용해서 그것을 %TEXTR("labia/flesh")% 하고 %TEXTR("kiss/smooch/peck")% 했다 
							ENDIF
						ENDIF
						PRINTFORMDL 당신의 혀와 입술로.
						CALL K2_HPH_PRINT,@"「햐안, 저기, 히이히호」 "
						SIF NOWEX:Ｃ絶頂
							PRINTFORM 나 가고 있어. 
						CALL K2_HPH_PRINT,@"응, 아아아아흐으읍","L"
					CASE 5
						LOCALS:1 = 
						IF TALENT:性別 & 2
							LOCALS:1 '= @"그녀의%COND_STR(@" hard", CFLAG:TARGET:勃起度 >= 1000)% 거시기가 완전히 발기한다."
						ELSE
							LOCALS:1 '= @"그녀의 %COND_STR(@" stiff", PALAM:欲情 >= PALAMLV:4)% 클리토리스가 팽창한다."
						ENDIF
						PRINTFORMDL 그녀의 입을 벌리자 %LOCALS:1% 네가 혀를 넣으면 %CALLNAME:TARGET%큰 신음소리를 낸다.
						CALL K2_HPH_PRINT,@"「야하아헵 테어헵」","L"
					CASE 6
						PRINTFORMDL %CALLNAME:TARGET%부드럽게 네 얼굴을 그녀의 허벅지 사이에 놓는다 \@ TEQUIP:アイマスク ? 네가 열정적으로 그녀를 섬길 때 # 그녀는 네가 그녀를 봉사하는 동안 즐거운 표정으로 너를 바라본다. \@.
						CALL K2_HPH_PRINT,@"「에헤헤ㅎㅍ %CALLNAME:MASTER%-님 감사해요 항상 저를 사랑해 주셔서요ㅎㅍ」","L"
					CASEELSE
						CALL K2_HPH_PRINT,@"「후후후 %CALLNAME:MASTER%-님은 나의 질을 핥고 있다, 조금 귀엽다 후후후」","L"
				ENDSELECT
			ELSEIF TALENT:ヤリマン
				SELECTCASE RAND:5
					CASE 1
						IF ABL:MASTER:舌 >= 3 && CFLAG:1001
							CALL K2_HPH_PRINT,@"「아아헵 너무 좋아헵 %CALLNAME:MASTER%-님, 정말 대단해요헵」","L"
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 2
						IF PALAM:潤滑 >= PALAMLV:4
							CALL K2_HPH_PRINT,@"「헤이, 벌써 충분히 젖었어. HPH 네가 혀만 넣지 마, 나도 느끼고 싶거든 \@ TALENT:MASTER:性別 & 2 ? 네 거 # 그 장난감 \@HPH」","L"
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 3
						IF PALAM:潤滑 < PALAMLV:3
							CALL K2_HPH_PRINT,@"「응 응 계속 나를 핥아줘 HPH」","L"
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 4
						CALL K2_HPH_PRINT,@"「아아핫! 더 거칠게 해줘, 네 모든 힘을 다해서 해줘! 아하핫!」","L"
					CASEELSE
						PRINTFORMDL 너는 %조사처리(CALLNAME:TARGET,"가")% 네 얼굴을 그녀의 은밀한 곳에 기댈 때 적극적으로 쾌락을 즐기는 것을 본다.
						CALL K2_HPH_PRINT,@"「더 주세요 HPH 계속 혀를 사용하세요 HPH」","L"
				ENDSELECT
			ELSE
				SELECTCASE RAND:7
					CASE 1
						IF ABL:MASTER:舌 >= 3 && K2_SEXUAL_FRANKNESS()
							PRINTFORML 「흐으음... 하아, 아아... 손가락을 쓰는 것보다 기분이 낫네...」
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 2
						IF ABL:MASTER:舌 >= 4 && K2_SEXUAL_FRANKNESS()
							PRINTFORML 「정말 좋다, 네 혀는 굉장해. 아, 니우.」
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 3
						IF ABL:MASTER:舌 >= 5 && !FIRSTTIME(SELECTCOM,1,2) && !K2_SEXUAL_FRANKNESS()
							PRINTFORML 「나한테 핥을 거야? 어쩐지, %CALLNAME:MASTER%-님의 혀가... 조금 무서워요...」
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 혀 기술을 떠올리자 홍당무처럼 얼굴이 붉어진다.
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 4
						IF !K2_SEXUAL_FRANKNESS()
							PRINTFORML 「... 음... 아, 하지 마... 그곳은...」
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 5
						IF ABL:MASTER:舌 >= 4
							PRINTFORMDL 당신의 혀 움직임은 너무 능숙해서 %조사처리(CALLNAME:TARGET,"는")% 신음 소리를 감추지 못한다.
							PRINTFORML 「크으,냐아, 아, 하아안」
						ELSE
							GOTO CUNNILINGUS_LOOP
						ENDIF
					CASE 6
						IF ABL:MASTER:舌 >= 2
							PRINTFORML 「에으... 핥히고 있어... 계속 그렇게 핥으면-... 응, 아, 후와아」
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 스스로를 자제하려 하고 당신이 그녀의 민감한 부분을 놀리자 침묵한다.
						ELSE
							PRINTFORML 「에엑... 하지만 거긴 더러운 곳이니까, 너무 심하게 하지 마, 알았지...?」
						ENDIF
					CASEELSE
						PRINTFORML 「아, 후와아, 후와아... 저 곳은...」
				ENDSELECT
			ENDIF
		ENDIF
		WAIT
	ENDIF
ENDIF
RETURN 1
