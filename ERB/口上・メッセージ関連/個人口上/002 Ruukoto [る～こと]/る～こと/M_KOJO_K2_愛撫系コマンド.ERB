;19,キス（継続）
;==================================================

@M_KOJO_MESSAGE_COM_K2_19
CALL M_KOJO_MESSAGE_COM_K2_19_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_19_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:2
				CASE 1
					CALL K2_HPH_PRINT,@"「츄파아... 추무... 주루... 으응흐프 ...레로... 냐... 주파... 하아프」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「츄루... 주푸우... 아아...냐아흐프... 아무우... 츄파아... ㄴ후프」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「츄파아... 추... 니... 나아...」
				CASEELSE
					PRINTFORMW 「응츄... 쪽... 응... 페로...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;20,キスする
;==================================================

@M_KOJO_MESSAGE_COM_K2_20
CALL M_KOJO_MESSAGE_COM_K2_20_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			IF !RAND:10
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 혀를 얽히게 하는 것 외에도, 그녀의 목과 쇄골 사이로 입술을 기어 다니게 한다.
				CALL K2_HPH_PRINT,@"「아아, 그런 곳에 흔적을 남기면 모두가 알아볼 거야」","W"
			ELSEIF !RAND:3
				CALL K2_HPH_PRINT,@"「흐읍... 음... 추후프 추... 취후푸... 느... 나아후프」","W"
			ELSEIF RAND:2
				CALL K2_HPH_PRINT,@"「응푸흐 아무... 추우푸... 은츄... 추루... 느... 주파아흐프」","W"
			ELSE
				CALL K2_HPH_PRINT,@"「츄... 추푸... 누... 하햣 부탁해, 더 해줘HPH 음... 추푸... 응ㅎPH」","W"
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「음...츄...흡...음...」
				CASEELSE
					PRINTFORMW 「응... 하아... 하아아... 쪽... 츄읍...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
