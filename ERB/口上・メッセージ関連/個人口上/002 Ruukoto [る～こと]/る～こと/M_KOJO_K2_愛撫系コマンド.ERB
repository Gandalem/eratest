@M_KOJO_MESSAGE_COM_K2_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	$PETTING_LOOP
	IF K2_BASIC_CONDITION_IN_MATING()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:5
				CASE 1
					IF EXP_UP(27,TARGET)
						CALL K2_HPH_PRINT,@"「츄읍... 추프 하프 하프 더 키스 미 모어」","W"
					ELSE
						GOTO PETTING_LOOP
					ENDIF
				CASE 2
					IF ABL:MASTER:指 >= 2 && K2_SEXUAL_FRANKNESS()
						CALL K2_HPH_PRINT,@"「아햣흐, 나아아햣흐 네 손가락이 너무 좋아.햣ㅎ」","W"
					ELSE
						GOTO PETTING_LOOP
					ENDIF
				CASE 3
					IF ABL:MASTER:指 >= 3
						CALL K2_HPH_PRINT,@"「아아아 아아아 안 돼, %CALLNAME:MASTER%-님의 손길이 나를 부숴버릴 것 같아아아」","W"
					ELSE
						GOTO PETTING_LOOP
					ENDIF
				CASE 4
					CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-사마에게 만져질 때마다 너무 뜨거워진다」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「에헤헤헵 만져줘... 사랑받는 기분이 들어헵」","W"
			ENDSELECT
		ELSEIF TALENT:ヤリマン
			SELECTCASE RAND:2
				CASE 1
					CALL K2_HPH_PRINT,@"「흐응 당신 너무 살살 다루는 거 아니에요? 하지만 더 거칠게 해줬으면 좋겠는데요」","W"
				CASEELSE
					CALL K2_HPH_PRINT,@"「정말 좋다 정말 좋으니 더 만져줘 정말 좋아」","W"
			ENDSELECT
		ELSE
			IF EXP_UP(27,TARGET) && RAND:2
				PRINTFORMW 「흐음... 추우... 츄읍... 아... 응」
			ELSE
				PRINTFORMW 「아... 응, 음... 거기...」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
