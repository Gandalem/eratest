;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	LOCAL = GETCOLOR()
	SETCOLOR 0xC0C070
	PRINTFORMDW 강렬한 쾌감이 %조사처리(CALLNAME:TARGET,"의")% 몸을 관통한다.
	PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그러한 놀라운 쾌감의 맛을 잊지 못한다.
	SETCOLOR LOCAL
	IF !CFLAG:睡眠姦
		IF TALENT:快感応答 < 0 && !TALENT:ヤリマン
			CALL K2_HPH_PRINT,@"「이건 안 돼. 흐윽, 더는 견딜 수가 없어. 흐윽」","W"
		ELSE
			CALL K2_HPH_PRINT,@"「너무 좋아서 이 느낌을 영원히 잊을 수가 없어HPH」","W"
		ENDIF
	ENDIF
ENDIF
