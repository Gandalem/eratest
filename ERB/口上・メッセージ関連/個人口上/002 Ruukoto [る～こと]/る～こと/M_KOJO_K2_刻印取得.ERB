	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
