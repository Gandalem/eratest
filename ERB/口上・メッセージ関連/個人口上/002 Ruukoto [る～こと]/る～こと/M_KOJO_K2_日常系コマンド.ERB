;304,仕事を手伝う
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:350(仕事内容(JOB_仕事内容.ERB参照のこと
;TCVAR:手伝えない(=2 手伝っても早くは終わらない、時間停止中不可 永琳の診察等)
;==================================================

@M_KOJO_MESSAGE_COM_K2_304
CALL M_KOJO_MESSAGE_COM_K2_304_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_304_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_CONSCIOUS_AND_TOLERANT()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「나를 도와주고 싶어? 고마워♪」
					CALL K2_HPH_PRINT,@"「오늘 밤 꼭 보답해 줄게... 에헤헤헵」","W"
				CASE 2
					PRINTFORML 「이렇게 같이 일하는 건 좋다.」
					CALL K2_HPH_PRINT,@"「왠지 팀워크 같은 기분이 들었어」","W"
				CASEELSE
					PRINTFORML 「당신 옆에 좀 더 가까이 있어도 될까요?」
					PRINTFORMDW %CALLNAME:TARGET%너무 가까워져서 일하기가 힘들어진다.
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 「와, 정말 멋진 일을 해냈네.」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 네 기술을 감탄한다.
				CASE 0
					PRINTFORMW 「이것으로 괜찮으신가요? 감사합니다.」
				CASE -1
					PRINTFORML 「아니. 이건 내 일이야.」
					PRINTFORMDW 그녀가 당신의 도움을 거절했음에도 불구하고, 당신은 %조사처리(CALLNAME:TARGET,"를")% 돕겠다고 시도한다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;305,膝枕してもらう
;TFLAG:193(-5=MASTERがTARGETよりも巨体の場合(TALENT:MASTER:体型 > TALENT:体型 + 2) 1=大成功 0=成功 -1=失敗)(-5以外は地の文分岐無し)
;ABL:親密(6以上=顔をのぞき込みながら頭を撫でてくれる 3以上=ただ頭を撫でてくれる 2以下=縮こまっている)
;==================================================

@M_KOJO_MESSAGE_COM_K2_305
CALL M_KOJO_MESSAGE_COM_K2_305_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_305_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_CONSCIOUS_AND_TOLERANT() && TFLAG:193 != -5
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 1
					CALL K2_HPH_PRINT,@"「좋아~ 베개처럼 편안하게 해 줄게HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 허벅지가 놀라울 정도로 부드럽다.
				CASE 2
					CALL K2_HPH_PRINT,@"「후후후, 일하느라 피곤할 거예요.」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 네 머리를 부드럽게 어루만지며 미소 짓는다.
				CASEELSE
					CALL K2_HPH_PRINT,@"「피곤해? 아니면 그저 편하게 있고 싶었을 뿐이야? 후후후」","W"
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					IF ABL:親密 >= 6
						PRINTFORMW 「항상 일하느라 지쳤을 거야. 이리 와♪」
					ELSE
						PRINTFORMW 「네, 알겠습니다. 결국 %CALLNAME:MASTER%-님께 신세 진 것이군요.」
					ENDIF
				CASE 0
					SELECTCASE ABL:親密
						CASE IS >= 6
							PRINTFORMW 「당신의 노력에 대한 감사로, 작은 휴식을 누릴 자격이 있습니다.」
						CASE 3 TO 5
							PRINTFORML 「나 이거 메이드들이 하는 거랑 같은 거야...?」
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그녀가 혼란스러워함에도 너에게 자신의 무릎 위에 머리를 기댈 수 있도록 허락한다.
						CASE IS <= 2
							PRINTFORML 「이렇게 하는 걸까...?」
							PRINTFORMDW %CALLNAME:TARGET%당황했다.
					ENDSELECT
				CASE -1
					PRINTFORMW 「우으... 다리가 저릿하네...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
