;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K2_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K2_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:ブチギレ || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMDW %CALLNAME:TARGET% %TEXTR("is so angry/has such a stern expression")% 그녀가 거의 답하지 않는다는 것
	ELSEIF TCVAR:泥酔
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 완전히 멍한 표정으로 홍당무처럼 빨개진다. 당신이 하는 말의 단 하나도 이해하지 못하는 듯하다.
		PRINTFORMW 「에헤? 뭐야~?」
	ELSEIF K2_CONSCIOUS_AND_TOLERANT()
		;博麗神社が拠点マップでその台所で仕事中のばあい
		IF MAIN_MAP == 0 && 仕事中チェック(TARGET) && CFLAG:MASTER:現在位置 == P8台所 ;"博麗神社" custom code
			IF TALENT:恋慕 || TALENT:愛欲
				SELECTCASE ABL:料理技能
					CASE IS >= 4
						CALL K2_HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"에게")% 맛있는 요리를 만들어 줄게」","W"
					CASE 2,3
						CALL K2_HPH_PRINT,@"「맛 좀 볼래? 사랑을 가득 담아 만들었어HPH」","W"
					CASE IS <= 1
						PRINTFORMW 「%CALLNAME:MASTER%님께 맛있는 요리를 해 드리고 싶어요.」
				ENDSELECT
			ELSE
				SELECTCASE ABL:料理技能
					CASE IS >= 4
						PRINTFORML 「그렇지. 그리고 네가~」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 요리를 능숙하게 하면서 대화한다.
					CASE 2,3
						PRINTFORMW 「맛보고 싶으세요?」
					CASE IS <= 1
						PRINTFORML 「음... 미소는 어디였더라~?」
						PRINTFORMDW %CALLNAME:TARGET%요리하느라 바쁜 것 같다.
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					IF TALENT:恋慕 || TALENT:愛欲
						SELECTCASE RAND:2
							CASE 1
								PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그녀의 몸을 당신에게 바짝 붙인다.
								PRINTFORML 「여기서 매일 일하는 건 재미있지만 거의 님과 외출할 기회가 없다는 게 아쉽다. %CALLNAME:MASTER%님.」
								CALL K2_HPH_PRINT,@"「그러니까, 이렇게 둘이서 함께 보낼 수 있는 시간을 소중히 하자 HPH」","W"
							CASEELSE
								;拠点が博麗神社
								IF MAIN_MAP == 0 ;"博麗神社" custom code
									PRINTFORML 「항상 집안일 도와줘서 정말 고마워.」
									PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 함께 일할 수 있어서 정말 기뻐.」
								ELSE
									PRINTFORML 「여기서 일하는 거 재미있어? 응, 난 정말 재밌다고 생각해.」
									PRINTFORMW 「%CALLNAME:MASTER%-님은 \@ TALENT:MASTER:性別 == 2 ? 그가 # 그녀가 \@ 청소하기 싫을 때 언제든지 내 도움을 요청해도 돼.」
								ENDIF
						ENDSELECT
					ELSE
						PRINTFORMW 「알겠어~. %조사처리(CALLNAME:MASTER,"는")% 정말 박식하네.」
					ENDIF
				CASE 0
					SELECTCASE RAND:7
						CASE 1
							IF FLAG:なりきり != 1 && FLAG:なりきり != 9
								PRINTFORML 「그렇다. 옛날에는 유메미 교수님과 레이무님은――」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 오래된 이야기를 들려준다.
							ELSE
								PRINTFORML 「그게 정말 그런 것이었어~」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그녀가 옛날이야기를 해주자 흥분한다.
							ENDIF
						CASE 2
							PRINTFORMW 「당신이 그 방을 떠나자마자 그곳은 믿을 수 없을 정도로 어질러졌다.」
						CASE 3
							SELECTCASE TIME:5
								CASE 0,1
									PRINTFORML 「오늘 날씨가 좋네요.」
									PRINTFORMW 「빨래하기 완벽하죠♪」
								CASE 2,3
									PRINTFORML 「하늘이 너무 흐리네.」
									PRINTFORMW 「어차피 빨래를 해볼까?」
								CASE IS >= 4
									PRINTFORML 「우우, 날씨가 안 좋네.」
									PRINTFORMW 「세탁을 못 하게 되다니 아쉽네...」
							ENDSELECT
						CASE 4
							PRINTFORML 「설거지 하고 있니?」
							PRINTFORMW 「음, 지면 안 돼, 더 열심히 해야 해.」
						CASE 5
							IF FLAG:なりきり == 9
								PRINTFORMW 「먹을 필요는 없는데, 내 힘의 원천이 무엇일까?」
							ELSE
								PRINTFORML 「유메미 교수가 나를 만들었다.」
								PRINTFORMW 「에? 나의 동력원? 음, 뭘까?」
							ENDIF
						CASE 6
							;清掃技能と料理技能の合計が４未満
							IF ABL:清掃技能 + ABL:料理技能 < 4
								PRINTFORML 「우으~. 왜 나는 내 일에 이렇게 못할까?」
								PRINTFORML 「이대로 계속하다가는 창고에 처박혀 버릴 거야...」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 생각하면 우울해진다.
								;清掃技能と料理技能の合計が４以上
							ELSE
								PRINTFORML 「일 조금씩 제 일에서 나아지고 있어요.」
								PRINTFORMW 「%CALLNAME:MASTER%-님 덕분이에요♪」
							ENDIF
						CASEELSE
							IF TALENT:恋慕 || TALENT:愛欲
								;拠点が博麗神社
								IF MAIN_MAP == 0 ;"博麗神社" custom code
									;午後6時以前
									IF TIME < 1080
										PRINTFORMW 「오늘 저녁은 뭘 드시고 싶으세요? 제가 %CALLNAME:MASTER%-님의 가장 좋아하시는 요리를 준비해 드릴게요.」
										;午後6時以降
									ELSE
										PRINTFORMW 「내일 메뉴로 뭘 할까. %CALLNAME:MASTER%-님의 가장 좋아하는 요리를 추가할까?」
									ENDIF
								ELSE
									;午後6時以前
									IF TIME < 1080
										PRINTFORMW 「오늘 저녁은 맛있을 거야~♪」
										;午後6時以降
									ELSE
										PRINTFORMW 「내일 메뉴는 뭘로 할까~♪」
									ENDIF
								ENDIF
							ELSE
								;午後6時以前
								IF TIME < 1080
									PRINTFORMW 「오늘 저녁으로 뭘 준비할까?」
									;午後6時以降
								ELSE
									PRINTFORMW 「내일 메뉴에 대해 이야기해 보자.」
								ENDIF
							ENDIF
					ENDSELECT
				CASE -1
					PRINTFORMW 「음. 네 이야기는 나에게 너무 어렵구나...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K2_301
CALL M_KOJO_MESSAGE_COM_K2_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_CONSCIOUS_AND_TOLERANT()
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORMW 「정말 맛있다! 나도 이렇게 맛있는 차를 만들고 싶어.」
			CASE 0
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「아, 나를 위해 차를 만들어 주었구나... 맛이 좋아? 정말 고마워.」
					CASE 2
						PRINTFORMW 「어떤 종류의 차예요? 달아요?」
					CASEELSE
						IF FLAG:なりきり == 11
							PRINTFORMW 「이곳이 신사라면 녹차를 마셔야 하지 않나? 나, 나는 이런 것이 존재한다고 생각 못 했어! 홍차가 정말 맛있구나!」
						ELSE
							PRINTFORMW 「내가 차를 마실 때마다 마리사님은 이곳이 신사니까 녹차여야 한다고 계속 말씀하신다.」
						ENDIF
				ENDSELECT
			CASE -1
				PRINTFORML 「으윽!...후우! 후우...」
				PRINTFORMDW 차가 아직 너무 뜨거웠던 것 같다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K2_302
RETURN 1

@M_KOJO_MESSAGE_COM_K2_302
IF K2_CONSCIOUS_AND_TOLERANT() && !K2_EXCESSIVE_STATURE_GAP() && BATHROOM()
	RESETCOLOR
	DRAWLINE
	PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%(는) %조사처리(CALLNAME:TARGET,"의")% 등을 씻긴다.
	PRINTW
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{TARGET}
	PRINTFORML 「당신의 등을 씻겨 드릴게요.」
	IF TALENT:MASTER:性別 == 2
		PRINTFORMW 「결국 남자는 더 튼튼한 등이 있는 경향이 있다.」
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%-님은 아름다운 등을 가지고 있다.」
	ENDIF
	RETURN 1
ENDIF
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_CONSCIOUS_AND_TOLERANT() && !K2_EXCESSIVE_STATURE_GAP()
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% %조사처리(CALLNAME:MASTER,"는")% 손을 잡고 서로의 어깨에 기댔다.
					PRINTFORMW 「...얼마나 편안한지...」
				CASE 2
					CALL K2_HPH_PRINT,@"「아아, 여기에…」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 특이하게 작은 신음을 낸다.
					IF BASE:ムード >= 750 && BASE:理性 < 800 && CFLAG:溜まってる度 >= 300
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 욕망 가득한 표정으로 당신을 바라보며 유혹하려 한다.
					ELSE
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 볼이 붉어지고 있다.
					ENDIF
				CASEELSE
					PRINTFORMDL 너는 %조사처리(CALLNAME:TARGET,"에게")% 가까이 다가가 그녀의 머리에서 향을 맡는다.
					PRINTFORMDL 그것은 좋은 향기를 지니고 있다.
					PRINTFORMW 「아, 얼마나 창피한지...」
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%(는) %조사처리(CALLNAME:TARGET,"를")% 마사지한다.
					PRINTFORML 「아... 기분이... 너무 좋다...」
					PRINTFORMDW 로봇은 즐거운 마사지를 받고 있는 것 같다.
				CASE 0
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%(는) %조사처리(CALLNAME:TARGET,"의")% 어깨를 주무른다.
							PRINTFORMW 「흐음, 그게... 간지러워.」
						CASEELSE
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%(는) %조사처리(CALLNAME:TARGET,"의")% 어깨를 마사지한다.
							PRINTFORMW 「흐으음... 바로 거기... 아아」
					ENDSELECT
				CASE -1
					PRINTFORMW 「야, 그렇게 이상한 곳에 손대지 마!」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
