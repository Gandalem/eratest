;306,お腹を撫でる
;TFLAG:193(1=ABL:親密6以上かつ妊娠時 0=成功 -1=ABL:親密5以下)
;==================================================

@M_KOJO_MESSAGE_COM_K2_306
CALL M_KOJO_MESSAGE_COM_K2_306_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_306_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
