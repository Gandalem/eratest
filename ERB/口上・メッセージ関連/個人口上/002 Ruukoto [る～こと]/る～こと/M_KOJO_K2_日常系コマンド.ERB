;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があってもムードが足りぬ）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先にキスぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外
;==================================================

@M_KOJO_MESSAGE_COM_K2_350
CALL M_KOJO_MESSAGE_COM_K2_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:泥酔
		PRINTFORMW 「후우?」
	ELSEIF SHIRAHU(TARGET) && TFLAG:194 == 4 && CFLAG:ブチギレ
		PRINTFORML 「네가 아무 일도 없었던 것처럼 행동할 수는 없어. 네 행동을 되돌아봐.」
		PRINTFORMDW 너는 성관계 기회를 망친 것 같구나.
	ELSE
		;失敗
		IF TFLAG:194
			SELECTCASE TFLAG:194
				CASE 1,2
					;うふふ既成事実あり
					IF CFLAG:既成事実 & 2
						PRINTFORML 「음...」
						PRINTFORMW 「Let's calm down a little and wait a bit longer.」
					ENDIF
				CASE 3
					;うふふ既成事実あり
					IF CFLAG:既成事実 & 2
						IF TALENT:恋慕 || TALENT:愛欲
							PRINTFORML 「다른 사람들과 함께 하는 것인가?」
							PRINTFORML 「음... 그건...」
							PRINTFORMDW %CALLNAME:TARGET%너와 단둘이 하고 싶다.
						ELSE
							PRINTFORMW 「그게... 다른 사람이랑은 할 수 없어...」
						ENDIF
					ENDIF
				CASE 4
					IF TALENT:恋慕 || TALENT:愛欲 || TALENT:思慕 || TALENT:セフレ
						PRINTFORMW 「음, 좀 더 기다리자. 알겠지?」
					ELSE
						PRINTFORML 「정말 미안해. 하지만 난 아직 청소 중이야...」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 아직 기분이 아니야.
					ENDIF
			ENDSELECT
			;初回
		ELSEIF TCVAR:抱き寄せ初回
			SELECTCASE TCVAR:抱き寄せ初回
				CASE 1
					IF TALENT:恋慕
						CALL K2_HPH_PRINT,@"「아하... 이해했어.」","W"
						PRINTFORMW 「오랫동안 이걸 기다려왔어...」
						PRINTFORMDW 당신이 그녀를 똑바로 바라보자 %조사처리(CALLNAME:TARGET,"는")% 얼굴을 붉힌다.
					ELSEIF TALENT:ヤリマン
						CALL K2_HPH_PRINT,@"「안흐프... 드디어ㅎ프」","W"
						CALL K2_HPH_PRINT,@"「이게 내가 항상 원했던 거야HPH」","W"
					ELSEIF TALENT:思慕
						PRINTFORMW 「Ah...」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"와")% %조사처리(CALLNAME:MASTER,"는")% 욕정에 사로잡힌 듯하다.
						PRINTFORMW 「...음. 전부 %CALLNAME:MASTER%-사마께 맡기겠어요.」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신에게 몸을 맡기며 중얼거렸다.
					ELSE
						PRINTFORMW 「응? 당신, 야아...」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그녀를 한동안 쳐다보고 있었다는 것을 알아채고 놀랐으며, 당신이 그녀의 몸을 아래로 밀어붙이자 완전히 숨이 넘어간다.
						PRINTFORMDW 그녀가 당신을 받아들이는 것 같다.
						PRINTFORMW 「부드럽게... 제발.」
					ENDIF
				CASE 2
					IF TALENT:ヤリマン
						CALL K2_HPH_PRINT,@"「오빠, 키스도 안 했는데 제대로 할 수 없어」","W"
						CALL K2_HPH_PRINT,@"「그 기분이 어떤 건지 알고 싶어 미칠 지경이었어 HPH」","W"
						IF !CFLAG:1001 && ( TALENT:処女 == 1 || TALENT:処女 == -1 )
							CALL K2_HPH_PRINT,@"「이게 사실은 제 첫 경험이에요... 그러니까 부드럽게 대해주세요HPH」","W"
						ELSE
							PRINTFORMW 「나쁜 짓은 하지 마.」
						ENDIF
					ELSE
						PRINTFORMW 「우-우리는 아직... 아니, 아무것도 아니야.」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 무언가 말하려 했던 것 같다. %조사처리(CALLNAME:TARGET,"는")% 당신에게 몸을 맡기며 눈을 감는다.
					ENDIF
				CASE 3
					PRINTFORMW 「하아... 하아... 내 몸이 너무 뜨거워.」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 뜨거운 몸은 당신을 거부할 수 없다.
				CASE 4
					PRINTFORMW 「이상한 기분이 들어... 하고 싶어... 이해가 안 돼.」
					PRINTFORMDW 그녀의 모르게 훈련된 %조사처리(CALLNAME:TARGET,"의")% 몸이 당신을 원하고 있어.
				CASE 5
				CASE 6
					PRINTFORMW 「미안하지만, 당신의 감정에 응답할 수는 없어.」
				CASE 7
					PRINTFORMW 「스-그만해 주세요. 저는 그저 로봇일 뿐이에요.」
					;霊夢とうふふ既成事実あり、かつ霊夢になりきりでない
					SIF CFLAG:1:既成事実 & 2 && FLAG:なりきり != 1
						PRINTFORMW 「그리고 게다가, %CALLNAME:MASTER%-님과 레이무-님은 벌써 사귀는 거 아닐까요?」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 차갑게 거절한다.
				CASE 8
					PRINTFORMW 「내가 무슨 섹스 기계라도 되는 줄 알아?」
					PRINTFORMDW %CALLNAME:TARGET%당신을 강하게 거부했다.
			ENDSELECT
			;成功二回目以降
		ELSE
			;押し倒され中に押し倒しかえす
			IF TFLAG:COMABLE管理 == 3
				IF TALENT:恋慕 || TALENT:思慕
					CALL K2_HPH_PRINT,@"「아하, 여기서 네가 주도해 줄래?」","L"
					PRINTFORMW 「후후, 이거 기대하고 있었어.」
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORML 「아아, 그럼 여기서 네가 주도할 거구나...」
					CALL K2_HPH_PRINT,@"「...알겠다. \@ K2_SEXUAL_FRANKNESS() ? 나 기분 좋게 해줘 # 네 마음대로 해 \@HPH」","W"
				ELSE
					PRINTFORML 「여기서부터 맡아줄래?」
					PRINTFORMW 「음... 내가 너에게 맡길게.」
				ENDIF
				;ふつうにMASTERから押し倒す
			ELSE
				;屋外
				IF OPENPLACE(CFLAG:MASTER:現在位置) >= 2
					IF ABL:露出癖 >= 6
						PRINTFORML 「대놓고 하는 거야?」
						PRINTFORMW 「후후, 물론이지. 분명 상쾌할 거야.」
					ELSE
						PRINTFORML 「우으... 이런 곳에?」
						PRINTFORMW 「나... 나는 이해한다.」
					ENDIF
					;屋内
				ELSE
					IF TALENT:恋慕 || TALENT:愛欲
						SELECTCASE RAND:6
							CASE 1
								PRINTFORML 「흥분했어? 후후, 괜찮아.」
								CALL K2_HPH_PRINT,@"「마음대로 사용해줘」","W"
							CASE 2
								PRINTFORMDL 너는 욕망에 지배당하도록 허용하자 %조사처리(CALLNAME:TARGET,"가")% 매혹적인 미소를 짓는다.
								PRINTFORMDW 그녀는 당신의 욕망을 채울 준비가 되었음을 보여주듯 조용히 뒤를 내민다.
							CASE 3
								PRINTFORMD 당신은 %조사처리(CALLNAME:TARGET,"의")% 흥분을 쉽게 느낄 수 있다.
								;スカートめくりできてズボンはいてない場合
								IF ( EQUIP:スカート || EQUIP:ワンピース || EQUIP:着物 ) && !EQUIP:ズボン
									PRINTFORMDL 그녀는 자신의 허벅지를 보여주려고 치마를 들어 올리며 당신을 유혹한다.
								ELSE
									PRINTFORMDL 그녀는 당신의 손을 잡고 자신의 가슴으로 이끈다.
								ENDIF
								CALL K2_HPH_PRINT,@"「부디 즐겨주세요」","W"
							CASE 4
								PRINTFORMDL 욕망을 느끼며, 당신은 뒤에서 %조사처리(CALLNAME:TARGET,"를")% 껴안는다.
								PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 자신의 엉덩이로 당신의 지팡이를 문지르며 미소 짓는다.
								CALL K2_HPH_PRINT,@"「나도 이제 그걸 원하기 시작했어HPH」","W"
							CASE 5
								PRINTFORMDL 너는 %조사처리(CALLNAME:TARGET,"가")% 너와 그녀에게 무엇을 할지 말한 후에 그녀가 즐겁게 웃는다.
								CALL K2_HPH_PRINT,@"「음. 나 잘 돌봐줘HPH」","W"
							CASEELSE
								PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 갑자기 네 등을 껴안는다.
								PRINTFORML 「형, 나 섹스하고 싶어!」
								CALL K2_HPH_PRINT,@"「괜찮아♪ 재미있게 놀자HPH」","W"
						ENDSELECT
					ELSEIF TALENT:ヤリマン
						SELECTCASE RAND:2
							CASE 1
								CALL K2_HPH_PRINT,@"「내 구멍을 또 쓰고 싶어? 어쩔 수 없잖아HPH」","W"
							CASEELSE
								IF TALENT:MASTER:性別 == 2 && RAND:2
									CALL K2_HPH_PRINT,@"「또? 흥, 인간은 정말 기회주의자들이야HPH」","W"
								ELSE
									CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%-sama은 정말 대식가다~HPH」","W"
								ENDIF
						ENDSELECT
					ELSEIF TALENT:思慕
						SELECTCASE RAND:2
							CASE 1
								PRINTFORML 「아... 또 하고 있네... 이해해.」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 얼굴을 붉히며 당신의 몸에 기대온다.
							CASEELSE
								PRINTFORML 「제발... 그렇게 거칠게 하지 마세요.」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신을 받아들이며 눈을 감는다.
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 1
								PRINTFORMW 「여기서 나를 사용해 봐. 상관없어.」
							CASEELSE
								PRINTFORMW 「또 하고 싶다고? 알겠다.」
						ENDSELECT
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
