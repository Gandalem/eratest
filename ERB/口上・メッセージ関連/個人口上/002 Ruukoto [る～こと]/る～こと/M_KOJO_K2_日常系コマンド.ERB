;60,耳かき
;前ターン膝枕後スキンシップコマンド
;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗するのはTARGET
;==================================================

@M_KOJO_MESSAGE_SCOM_K2_60
CALL M_KOJO_MESSAGE_SCOM_K2_60_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K2_60_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K2_CONSCIOUS_AND_TOLERANT()
		IF ( TALENT:恋慕 || TALENT:愛欲 ) && TFLAG:193 >= 0
			SELECTCASE RAND:2
				CASE 1
					CALL K2_HPH_PRINT,@"「도움이 되고 싶으니까, 당신의 귀를 청소해 드리고 싶어요HPH」","L"
					CALL K2_HPH_PRINT,@"「음, 다 했어. 하지만 더 하고 싶어, 다시 해보자 HPH」","L"
					PRINTFORMDW 부디 그녀가 과하게 하지 않기를 바란다.
				CASEELSE
					PRINTFORML 「제가 %CALLNAME:MASTER%-님의 귀를 청소해 드릴게요～」
					PRINTFORMDL 당신이 부탁하지 않았는데도 %조사처리(CALLNAME:TARGET,"가")% 귀 파는 도구를 꺼낸다.
					PRINTFORMW 「아, 들어갔네. 후후, 재미있다.」
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 기분이 얼마나 좋았는지 말한 뒤, 그녀는 안도하며 미소 짓는다.
					PRINTFORMW 「당신을 섬길 수 있어서 기뻐요.」
				CASE 0
					PRINTFORMW 「이건... 꽤 어렵네. 아프진 않지?」
				CASE -1
					PRINTFORMDL 너는 그녀가 아프다고 말하자 %조사처리(CALLNAME:TARGET,"가")% 사과한다.
					PRINTFORMW 「우으... 죄송해요... 저 정말 무능한 하녀예요...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
