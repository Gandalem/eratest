				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 2
				IF !TEQUIP:縄 && !TEQUIP:拘束 && !TEQUIP:継続キス && !TEQUIP:胸揉み && !TEQUIP:乳首吸い
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMD 무릎을 꿇은 채로, 
						CASEELSE
							PRINTFORMD 다리를 벌리면서 
					ENDSELECT
					PRINTFORMDL %CALLNAME:TARGET%그녀는 당신의 손가락과 얽힌다. 그녀는 상체를 돌리며 허리를 앞뒤로 흔든다.
					IF TEQUIP:下半身着衣状況 == 0 && !TEQUIP:アイマスク && RAND:3
						CALL K2_HPH_PRINT,@"「%CALLNAME:MASTER%님과 내가 연결되는 부분은... 완전히 노출되어 있어 HPH」","W"
					ELSE
						CALL K2_HPH_PRINT,@"「아, 나아, %CALLNAME:MASTER%-님HPH %CALLNAME:MASTER%-님이이이HPH」","W"
					ENDIF
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 3
				IF !TEQUIP:継続キス
					PRINTFORMDL 그녀가 골반을 흔들자 '%CALLNAME:TARGET%'의 침이 입에서 흘러내렸고, 그녀의 침방울이 당신의 몸에 스며들었다.
					CALL K2_HPH_PRINT,@"「후우, 냐아... 아 죄송해요, 제가 정신이 팔렸네요... 헉」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 4
				IF TEQUIP:継続キス
					CALL K2_HPH_PRINT,@"「츄... 음... 아뮤...츄프ㅎㅍ %CALLNAME:MASTER%-사마아ㅎㅍ 저를 더욱더 사랑해주세요ㅎㅍ」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 5
				IF TEQUIP:継続キス
					PRINTFORMDL %CALLNAME:TARGET%당을 타면서 당신이 도망가지 못하도록 목에 손을 감는다 그녀는 이내 끊임없이 키스를 요구한다
					CALL K2_HPH_PRINT,@"「츄푸... 응추... 챠아... 추... 나하프 이렇게 계속 키스하고 싶어HPH」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 6
				IF K2_SEXUAL_FRANKNESS()
					CALL K2_HPH_PRINT,@"「흐응, 하아, 내 %COND_STR(@"butt", ARGS == "A")%의 것으로 하고 있어. 나 변하고 있어, 응」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 7
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 강렬하게 골반을 흔들며 기꺼이 움직이고, 그녀의 피부는 붉게 변하며 금세 땀으로 뒤덮인다.
				CALL K2_HPH_PRINT,@"「하아, 하아, %CALLNAME:MASTER%-사마HPH 우리 기분 좋게 해줄게요HPH」","W"
			CASEELSE
				IF ABL:腰 >= 3
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 원을 그리며 엉덩이를 흔든다 %COND_STR(@" while holding onto your chest", !TEQUIP:縄 && !TEQUIP:拘束)%.
					CALL K2_HPH_PRINT,@"「기분 좋아? 네 입에서 사랑스러운 소리가 새어 나오는 걸 들었어HPH」","W"
				ELSE
					CALL K2_HPH_PRINT,@"「이렇게 골반을 움직이는 게 힘들지만... 그래도 %CALLNAME:MASTER%-사마를 위해 최선을 다할게요」","W"
				ENDIF
		ENDSELECT
	ELSEIF CFLAG:1001 && ABL:腰 >= 3
		CALL K2_HPH_PRINT,@"「위에서 내려오는 건가? 물론이지. 내 허리를 움직이는 데 얼마나 능숙한지는 자신 있거든.」","L"
		PRINTFORMDW %CALLNAME:TARGET%그녀는 과거 파트너들과의 경험에서 비롯된 많은 골반 기술을 가지고 있었고, 그 흥분을 기억하며 당신을 격렬하게 탐했다.
	ELSEIF ABL:腰 < 2 && RAND:3
		PRINTFORML 「위아래로 움직여야 하나?」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 자세가 익숙하지 않은 것 같았다.
	ELSE
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 열렬하게 골반을 내리면서 땀을 비 오듯 흘린다.
		PRINTFORMW 「아후, 푸운, 으응, 나아, 하아, 하, 하.」
	ENDIF
ENDIF
