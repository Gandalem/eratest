;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K11(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME '= STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K11
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K11(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K11(ROLE, SCENE, CLIENT_ID)
ENDIF
RESETCOLOR
SIF RESULT
	RETURN 1
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K11
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			;SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;CASE "一般依頼名"
			SELECTCASE SCENE
				CASE "依頼提示時"
					;依頼を持ちかけられる時
					PRINTDATAL
						DATAFORM 「미안해, 계속 귀찮게 하려던 건 아닌데, 혹시 나한테 작은 부탁 하나만 들어줄 수 있을까...」
						DATAFORM 「%PRINT_MALE("guy", MASTER)%이 일을 처리할 줄 아는 유능한 사람이라고 들었어.」
						DATAFORM 「네가 나를 위해 해줄 만한 아이디어가 생겼는데...」
						DATAFORM 「도움이 필요한 여자들이 있는지 궁금했다면, 더 찾을 필요 없어%K11_ZE("daze")%!」
						DATAFORM 「넌 이걸 처리하기에 충분히 믿을 만해 보이잖아? 어때?」
					ENDDATA
				CASE "依頼非受託時"
					;内容だけ見て受託しなかった時
					PRINTDATAL
						DATAFORM 「뭐야, 도대체?! 좋아, 그럼!」
						DATAFORM 「아이고...」
						DATAFORM 「거절당하는 거 짜증나잖아, 알지?」
						DATAFORM 「실패하는 것보다 시도조차 안 하는 게 나은가 보네.」
						DATAFORM 「너무 어려웠던 건가?」
					ENDDATA
				CASE "依頼受託時"
					;依頼を受託した時
					PRINTDATAW
						DATAFORM 「좋아, 정말 고마워!」
						DATAFORM 「좋은 소식이 기대돼!」
						DATAFORM 「최고야! 별로 어렵지 않겠지, 그렇지?」
						DATAFORM 「알았어, 나머지는 너한테 맡길게 %K11_ZE()%!」
					ENDDATA
				CASE "依頼確認時"
					;[366]で依頼内容を依頼人に確認した時
					PRINTDATAL
						DATAFORM 「음, 내가 뭐라고 부탁했더라? 음, 잘 생각해보자... 아, 맞다!」
						DATAFORM 「뭐... 나는 설명을 잘 못해서 말이야. 다시 한번 설명해 줄게%K11_ZE()%。」
					ENDDATA
				CASE "依頼破棄時"
					;受託した依頼を破棄する時
					PRINTDATAL
						DATAFORM 「만약 누군가 나를 거절할 때마다 돈을 받게 된다면...」
						DATAFORM 「이 속도라면 취소 수수료라도 받아야 할 것 같은데, 안 그래?」
						DATAFORM 「솔직히... 좀 화가 난 상태야.」
						DATAFORM 「정말 실망이야%K11_ZE()%...」
					ENDDATA
					CALL CHANGE_CFLAG(4, 11, -10)
				CASE "依頼実行直前"
					;[367]で依頼を実行する時、実行処理の前に呼び出される
				CASE "依頼実行直後"
					;[367]で依頼を実行する時、実行処理の後に呼び出される
				CASE "成功報告時"
					;報告時（成功）
					PRINTDATAL
						DATAFORM 「에헤헤~ 너는 절대 실망시키지 않아, %CALLNAME:MASTER%!」
						DATAFORM 「이걸 좀 익혀가는 것 같네 "도와주는 것" thing, 음음?」
						DATAFORM 「언제나처럼 믿을 수 있다는 게 내가 너를 좋아하는 이유야 %K11_ZE()%!」
					ENDDATA
				CASE "失敗報告時"
					;報告時（失敗）
					;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					PRINTDATAL
						DATAFORM 「젠장... 안됐군.」
						DATAFORM 「그럴 줄 알았어, 쿠우린에게 물어봤어야 했는데...」
						DATAFORM 「실패하면 보상도 못 받는다는 거 알고 있지?」
					ENDDATA
			ENDSELECT
			;ENDSELECT
			RETURN 1
		ENDIF
ENDSELECT
RESETCOLOR
