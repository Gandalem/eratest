;==================================================
;依頼口上・一般依頼06：誰か教えて！
;==================================================
@M_KOJO_IRAI_6_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Hey %CALLNAME:MASTER%, care to take a look at this?」
	PRINTFORML 「Hmmm, this looks like something complicated, and it ain't about magic, either...」
	PRINTFORML 「Not gonna lie, thinking deeply is not my strongest suit. I'm more of a doer type!」
	PRINTFORML 「So, um, could you perhaps help me with it? Not for free, of course, I'll get you something nice!」
	RETURN 1
CASE "依頼非受託時"
	RETURN 0
CASE "依頼受託時"

	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
	;［しらべもの］と［教えてあげる］が重なっている場合
	;【◆口上】
	;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
	;【L ここなら役に立つ資料が見つかりそうだ】
	;【INPUT（しらべもの/教えてあげる）】
	;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
	;【▼そのまま下の口上へ】
	;【教えてあげる＞［教えてあげる］へジャンプ】
		PRINTFORML 「Whoa, so you don't know either? Hmm, well, guess it's a good chance to borrow some books while we're at it...」
		RETURN 1
	ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
	;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
	;【◆口上】
	;【［あなた］は［現在地］で調べ物をした】
	;【▼そのまま下の口上へ】
		PRINTFORML 「You did good asking me for help%K11_ZE()%!」
		PRINTFORML 「Heck, I'll even do it for free! Let's see, what was the question again...?」
		RETURN 1
	ELSE
	;［教えてあげる］時（依頼主がTARGET）
	;【◆口上】
	;【L ［あなた］は［彼女］の疑問に答えた】
	;【成功：［彼女］の疑問は氷解した！】
	;【失敗：［彼女］は納得できなかったようだ……】
	;【▼そのまま下の口上へ】
		
		RETURN 0
	ENDIF
CASE "依頼実行直後"
	;【▲上の口上から続き】
	;【◆口上】
	SELECTCASE CFLAG:CLIENT_ID:依頼状況
	CASE 2
	;［しらべもの］をした時
		IF ROLE == "CLIENT"
		;一緒に［しらべもの］をした時
			PRINTFORML 「Ahh, that's it... Nah, I mean, I just got the book I wanted.」
			RETURN 1
		ELSEIF ROLE == "TARGET"
		;依頼主ではない口上主の前で［しらべもの］をした時
			PRINTFORML 「Oh, I know what's that all about.」
			PRINTFORML 「...So that gotta be this... and that...」
			PRINTFORML 「See, even the book says it! Ain't I smart?」
			RETURN 1
		ENDIF
	CASE 3
	;成功した時
	;【▼そのまま下の口上へ】
		SELECTCASE RAND:3
		CASE 1
			PRINTFORMW 「Hmm... Yeah, this makes sense.」
		CASE 2
			PRINTFORMW 「So in other words, you mean--」
		CASEELSE
			PRINTFORMW 「When you put it that way...」
			PRINTFORMW 「Wow, I feel stupid now.」
		ENDSELECT
		RETURN 1
	CASE 6
	;失敗した時
	;【▼そのまま失敗報告時の口上へ】
		SELECTCASE RAND:2
		CASE 0
			PRINTFORMW 「No, no, I thought of that already... It gotta be something else%K11_ZE()%.」
		CASE 1
			PRINTFORMW 「Yeah, that's what a layman would say. Doesn't really work in practice, though.」
		ENDSELECT
		RETURN 1
	ENDSELECT
CASE "成功報告時"
;報酬：\500
	PRINTFORMW 「Ah! That's it%K11_ZE()%!」
	PRINTFORMW 「I can't believe the answer was so simple! I have much to learn after all...」
	PRINTFORMW 「Well, I promised you something nice, so here! It's a special currency that got popular as of late.」
	PRINTFORMW 「I heard you can pay for various services with it and such. Gotta be useful, then!」
	CALL GET_MONEY_CM(10, 2)
	RETURN 1
CASE "失敗報告時"

	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼12：懲らしめて！
;==================================================
@M_KOJO_IRAI_12_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Hey, %CALLNAME:MASTER%! %SPLIT_G("Your timing is impeccable:Just in time")%, really%K11_ZE("daze")%.」
	PRINTFORML 「Care to do a little community service? I'm talking youkai extermination, of course!」
	PRINTFORML 「My hands are full at the moment, so I thought maybe you can give it a go.」
	PRINTFORML 「It's a good way to make money and get by, y'know? So I wholly recommend it.」
	PRINTFORML 「Whaddya think?」
	RETURN 1
CASE "依頼非受託時"
	PRINTFORML 「Oh well, it's your loss. I don't blame ya though!」
	PRINTFORML 「Not everyone is cut out for it, so it's perfectly fine%K11_ZE()%.」
	RETURN 1
CASE "依頼受託時"
	PRINTFORML 「Alright, here's your target...」
	PRINTFORML 「Eh? What did they do? Who cares! Prolly somethin' bad or whatever!」
	PRINTFORML 「Just get it done and come back, it'll be fine!」
	SELECTCASE ABL:MASTER:戦闘能力
		CASE 1, 2
			PRINTFORML 「...Now looking at your skills, you might have some trouble with it.」
			PRINTFORML 「No worries though, failure is a part of learning experience, you'll get better at it - I'm sure!」
		CASE 3, 4
			PRINTFORML 「You should be able to handle it... probably. Well, best of luck to ya%K11_ZE()%!」
		CASE IS > 4
			PRINTFORML 「I mean, you're a tough cookie, so it'll be piss easy anyway!」
	ENDSELECT
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼では討伐される側の口上です
	PRINTFORML 「Bwuh--?! Someone placed a hit... on *me*?!?!」

	IF CANNOT_DANMAKU() == 1
	;屋内のとき（勝負できない）
	;【◆口上】
	;【W 屋外で挑もう…】
		PRINTFORML 「...Think we should take it outside. Danmaku needs a lot of space! Who would've thunk it, eh?」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 2
	;仕事中（勝負できない）
	;【◆口上】
	;【W お取り込み中だ…】
		PRINTFORML 「That's good to know, but I'm in the middle of something right now.」
		PRINTFORML 「Gimme a few hours to settle this and I'll be right back with you!」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 3
	;あなたが疲労中（勝負できない）
	;【◆口上】
	;【W 今は疲れている…】
		PRINTFORML 「...Wow, hey, you alright? You seem kinda pale to me%K11_ZE()%.」
		PRINTFORML 「I don't think you can even fight right now! Go and get some sleep, we'll talk later 'bout this, 'kay?」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 4
	;口上主が疲労竜（勝負できない）
	;【◆口上】
	;【W 今挑むのはフェアじゃない…】
		PRINTFORML 「...Ugh, I'd be glad to take you on, but... Yaaawn, I ain't feelin' it right now...」
		PRINTFORML 「Yeah, that's my excuse, deal with it. Shoo!」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 5
	;既に今日一度弾幕勝負をしている（勝負できない）
	;【◆口上】
	;【W 今日はもう挑めない…】
		PRINTFORML 「Didn't I already mop the floor with you today?」
		PRINTFORML 「Heh, I'm glad that you're so eager, but you gotta know when to stop, y'know?」
		RETURN 1
	ELSE
	;【◆口上】
	;【W 勝負開始！！】
	;【以降はそのまま弾幕口上が呼ばれます】
		PRINTFORML 「Dunno who might be stupid 'nuff to do that, but I won't budge!」
		PRINTFORML 「Come then, you would-be-subjugator! Lemme teach ya how things are done in Gensokyo!」
		RETURN 1
	ENDIF
	;【▼そのまま下の口上へ】
CASE "依頼実行直後"
;○この依頼では討伐される側の口上です
	IF CFLAG:CLIENT_ID:依頼状況 == 2
		IF CANNOT_DANMAKU() == 0
			;負け犬
			;【▲上の口上から続き】
			;【L ［彼女］の討伐に失敗した……】
			;【W ……こうなったら後日出直すしかない】
			;【◆口上】
			PRINTFORML
			PRINTFORML 「Hehehe, I still got it～!」
			PRINTFORML 「Maybe when someone tells ya to mess with me next time, you should just nope outta there? Just a thought.」
			IF TALENT:恋慕
				PRINTFORML 「Oh, and here, a little something to help you with recovery. Hahaha!」
				CALL GET_ITEM("青汁", 3, 2)
			ENDIF
			RETURN 1
		ELSE
			;挑めなかった場合
			;【▲上の口上から続き】
			;【◆口上】
			RETURN 0
		ENDIF
	ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
	;勝利
	;【▲上の口上から続き】
	;【W ［彼女］を懲らしめた！】
	;【◆口上】
		PRINTFORML
		PRINTFORML 「A'ight, a'ight, you got me! I give!」
		PRINTFORML 「Now go and get your well-deserved bounty or whatever.」
		PRINTFORML 「I'll take a nap or somethin' for now, gotta take a minute to lick my wounds%K11_ZE()%...」
		RETURN 1
	ENDIF
CASE "成功報告時"
;報酬：賞金（時価）
	
	RETURN 0
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼15_あなたに抱かれたい
;==================================================
@M_KOJO_IRAI_15_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
