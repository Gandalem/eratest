;==================================================
;依頼口上・各依頼で共通の口上
;==================================================
@M_KOJO_IRAI_K11(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME '= STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K11
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K11(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K11(ROLE, SCENE, CLIENT_ID)
ENDIF
RESETCOLOR
SIF RESULT
	RETURN 1
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K11
SELECTCASE ROLE
CASE "CLIENT"
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		;SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
		;CASE "一般依頼名"
			SELECTCASE SCENE
			CASE "依頼提示時"
			;依頼を持ちかけられる時
				PRINTDATAL
					DATAFORM 「Sorry, I didn't mean to badger you, but if you could just do me a little favor...」
					DATAFORM 「I heard you're a capable %PRINT_MALE("guy", MASTER)% who knows how to get things done.」
					DATAFORM 「I got an idea for something you could do for me...」
					DATAFORM 「If you were wondering if there are girls in need, then look no further%K11_ZE("daze")%!」
					DATAFORM 「You seem trustworthy enough to handle this, aren'tcha? How about it?」
				ENDDATA
			CASE "依頼非受託時"
			;内容だけ見て受託しなかった時
				PRINTDATAL
					DATAFORM 「Wh-What the heck?! Fine then!」
					DATAFORM 「Aww man...」
					DATAFORM 「Being rejected sucks, you know that?」
					DATAFORM 「Better not try than to fail, I guess.」
					DATAFORM 「Was it too hard or something?」
				ENDDATA
			CASE "依頼受託時"
			;依頼を受託した時
				PRINTDATAW
					DATAFORM 「Great, thanks a lot!」
					DATAFORM 「I'm looking forward to good news!」
					DATAFORM 「Awesome! Shouldn't be too hard, right?」
					DATAFORM 「Alright, I'm leaving the rest to you then%K11_ZE()%!」
				ENDDATA
			CASE "依頼確認時"
			;[366]で依頼内容を依頼人に確認した時
				PRINTDATAL
					DATAFORM 「Uhh, what did I ask you to do again? Let's see 'ere... Oh, right!」
					DATAFORM 「Welp... I ain't very good at explaining things, so let's go over it again%K11_ZE()%.」
				ENDDATA
			CASE "依頼破棄時"
			;受託した依頼を破棄する時
				PRINTDATAL
					DATAFORM 「If I got a penny every time someone turns me down...」
					DATAFORM 「Maybe I should start charging cancellation fees at this rate, eh?」
					DATAFORM 「I'm... kinda ticked off, not gonna lie.」
					DATAFORM 「That's a letdown%K11_ZE()%...」
				ENDDATA
				CALL CHANGE_CFLAG(4, 11, -10)
			CASE "依頼実行直前"
			;[367]で依頼を実行する時、実行処理の前に呼び出される
			CASE "依頼実行直後"
			;[367]で依頼を実行する時、実行処理の後に呼び出される
			CASE "成功報告時"
				;報告時（成功）
				PRINTDATAL
					DATAFORM 「Ehehe～ You never disappoint, %CALLNAME:MASTER%!」
					DATAFORM 「Looks like you're getting a hang of this whole "helping out" thing, mhmm?」
					DATAFORM 「Reliable as ever, that's why I like you%K11_ZE()%!」
				ENDDATA
			CASE "失敗報告時"
			;報告時（失敗）
			;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
				PRINTDATAL
					DATAFORM 「Dang... That's unfortunate.」
					DATAFORM 「I knew it, I should've asked Kourin...」
					DATAFORM 「You do realize you're not getting paid if you fail, right?」
				ENDDATA
			ENDSELECT
		;ENDSELECT
		RETURN 1
	ENDIF
ENDSELECT
RESETCOLOR

