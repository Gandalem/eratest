@M_KOJO_IRAI_1_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		PRINTFORMW 「오, 그 마도서를 저기 두세요... 그리고 그 약병은 만지지 마시고요%K11_ZE("daze")%...」
		PRINTFORMW 「...웁! 뭐-뭐야, 라고 물으신다고요? 아, 어, 아무것도 아니니 걱정 마세요!」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		PRINTFORMW 「와아... 쓰레기 때문에 여기 이렇게 공간이 많을 줄은 몰랐어!」
		;【報酬獲得】
		PRINTFORMW 「잘했어, 너는 이 세계에서 최고의 청소부일 거야!」
		PRINTFORMW 「I think I owe you a little something, eh?」
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「헤이 %CALLNAME:MASTER%, 이거 좀 봐줄래요?」
		PRINTFORML 「음, 이건 복잡해 보이는 일이고 마법에 관한 것도 아니군...」
		PRINTFORML 「솔직히 말해서 깊이 생각하는 게 제 강점은 아니에요. 저는 행동파거든요!」
		PRINTFORML 「그래서 음, 혹시 이거 좀 도와주실 수 있나요? 물론 공짜는 아니고요, 멋진 걸 드릴게요!」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			PRINTFORML 「와, 너도 모르는 거야? 음, 그럼 기왕에 책 좀 빌려야겠네...」
			RETURN 1
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			PRINTFORML 「나에게 도움을 청해줘서 잘했어%K11_ZE()%!」
			PRINTFORML 「쳇, 심지어 공짜로 해줄게! 보자, 질문이 뭐였더라...?」
			RETURN 1
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORML 「아, 됐어... 아냐, 그러니까 내가 원하던 책을 구했다는 거지.」
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					PRINTFORML 「아, 무슨 소리인지 알겠어.」
					PRINTFORML 「...그러니까 이게 이거고 저거구나...」
					PRINTFORML 「봐, 책에도 나와 있잖아! 나 똑똑하지 않아?」
					RETURN 1
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「음... 그래, 말이 되네.」
					CASE 2
						PRINTFORMW 「그럼 다시 말해서, 당신은—」
					CASEELSE
						PRINTFORMW 「그렇게 말하니...」
						PRINTFORMW 「와, 나 지금 바보 같아.」
				ENDSELECT
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「아니, 아니, 그건 이미 생각해 봤어... 다른 뭔가가 있을 거야%K11_ZE()%.」
					CASE 1
						PRINTFORMW 「그래, 그게 일반인이 할 법한 말이겠지. 하지만 실제로는 별로 작동하지 않아.」
				ENDSELECT
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		PRINTFORMW 「아! 바로 그거군요%K11_ZE()%!」
		PRINTFORMW 「답이 그렇게 간단할 줄은 몰랐어! 아직 배울 게 많네...」
		PRINTFORMW 「음, 약속대로 좋은 걸 주려고 했지. 자, 여기! 요즘 인기 있는 특별한 통화야.」
		PRINTFORMW 「이걸로 여러 서비스를 결제할 수 있다고 들었어. 쓸모가 있겠군!」
		CALL GET_MONEY_CM(10, 2)
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_IRAI_12_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「이봐, %CALLNAME:MASTER%! %SPLIT_G("Your timing is impeccable:Just in time")%, 정말로%K11_ZE("daze")%.」
		PRINTFORML 「작은 봉사활동이라 해보는 건 어때? 물론 요괴 퇴치 말이야!」
		PRINTFORML 「지금은 내 손이 가득 차서, 네가 한번 해볼 수 있을 것 같아서 생각했지.」
		PRINTFORML 「돈을 벌고 먹고 살기에 좋은 방법이니까, 안 그래? 그래서 전 강력히 추천해.」
		PRINTFORML 「어떻게 생각해?」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORML 「에이, 네 손해지. 그래도 난 널 탓하지 않아!」
		PRINTFORML 「모두가 그 일을 할 수 있는 건 아니니까 괜찮아%K11_ZE()%.」
		RETURN 1
	CASE "依頼受託時"
		PRINTFORML 「좋아, 네 목표는 이거다...」
		PRINTFORML 「에? 뭘 했지? 누가 신경 써! 아마 나쁜 거거나 뭐 그런 걸겠지!」
		PRINTFORML 「그냥 처리하고 돌아와. 괜찮을 거야!」
		SELECTCASE ABL:MASTER:戦闘能力
			CASE 1, 2
				PRINTFORML 「...지금 당신의 스킬을 보니, 그것에 대해 좀 어려움을 겪을지도 모르겠군요.」
				PRINTFORML 「하지만 걱정 마세요, 실패는 학습 경험의 일부니까, 분명 더 잘하게 될 거예요!」
			CASE 3, 4
				PRINTFORML 「네가 해낼 수 있을 거다... 아마도. 뭐, 행운을 빌게%K11_ZE()%!」
			CASE IS > 4
				PRINTFORML 「뭐, 당신은 강한 사람이니까 어차피 식은 죽 먹기지!」
		ENDSELECT
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		PRINTFORML 「부우욱-?! 누군가 나한테 암살을 의뢰했단 말이야?!?!」
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			PRINTFORML 「...밖으로 빼는 게 좋겠어. 단마쿠가 공간을 많이 필요하잖아! 누가 그럴 줄 알았겠어, 응?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			PRINTFORML 「알게 되어 다행이지만, 지금 다른 일 중이야.」
			PRINTFORML 「이 일을 정리할 시간만 몇 시간 주면 바로 돌아올게!」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			PRINTFORML 「...와, 이봐, 괜찮아? 나한테 좀 창백해 보여%K11_ZE()%.」
			PRINTFORML 「지금은 싸울 수도 없을 것 같아! 가서 잠이나 자, 나중에 이거 얘기하자, 알겠지?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			PRINTFORML 「...으윽, 기꺼이 너를 상대해 줄 수 있지만... 하아암, 지금은 좀 아닌 것 같네...」
			PRINTFORML 「그래, 그게 내 변명이야. 알아서 처리해. 꺼져!」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			PRINTFORML 「오늘 너한테 이미 승리하지 않았어?」
			PRINTFORML 「흥, 네가 그렇게 열심인 건 기쁘지만, 언제 멈춰야 하는지도 알아야지, 알겠어?」
			RETURN 1
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			PRINTFORML 「누가 그럴 만큼 바보일지는 모르겠지만, 난 물러서지 않겠어!」
			PRINTFORML 「자, 이 정복하려는 자여! 내가 이 환상향에서 어떻게 하는 건지 가르쳐 주마!」
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORML
				PRINTFORML 「헤헤헤, 아직 나 남아있어～!」
				PRINTFORML 「다음번에 누군가 날 건드리라고 하면 그냥 거기서 사라지는 게 어때? 그냥 생각뿐이야.」
				IF TALENT:恋慕
					PRINTFORML 「아, 그리고 회복에 도움이 될 만한 작은 것도 여기 있단다. 하하하!」
					CALL GET_ITEM("青汁", 3, 2)
				ENDIF
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			PRINTFORML
			PRINTFORML 「알았어, 알았어, 나한테 맡겨! 내가 줄게!」
			PRINTFORML 「이제 네가 마땅히 받아야 할 포상금이나 뭐 그런 거나 받으러 가.」
			PRINTFORML 「난 일단 낮잠 좀 자거나 뭐 할 거야, 잠시 상처를 치유할 시간이 필요해서%K11_ZE()%...」
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
