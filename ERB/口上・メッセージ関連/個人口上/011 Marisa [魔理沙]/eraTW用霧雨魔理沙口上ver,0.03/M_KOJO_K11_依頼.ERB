	PRINTFORMW 「Aww, really? I don't know any other %PRINT_MALE("guy_:person", MASTER)% who'd help me with this!」
	PRINTFORMW 「That sucks... I've no idea what to do now...」
	PRINTFORMW 「If you're not comfortable doing it for money, maybe we can just, y'know...」
	PRINTFORMDW You refuse again, taken aback. Your mind goes blank for a second. Is this some sort of joke?
	PRINTFORMW 「Hmmm... Sorry, sorry. Just kidding! Well, I guess you wouldn't be interested in something like that, huh?」
	PRINTFORMDW Marisa quickly hides herself under her hat again, laughing nervously.
CASE "依頼受託時"
	PRINTFORMW 「Sorry for asking you like this, I got no other options.」
	PRINTFORMW 「C'mon, let's get going then%K11_ZE()%. We can't simply do it here, so let's head to the hotel when you're ready, yeah?」
CASE "依頼確認時"
	PRINTFORML 「D-Do I really have to explain this? Uhhh...」
	PRINTFORML 「Ahem... We're about to have a spontaneous, unprotected, penis-in-vagina sex, and you're the best person for the job that I know of.」
	PRINTFORML 「It's what a man and a woman do in the privacy of their bedroom%K11_ZE(,1)%, and y'know the rest.」
	PRINTFORML 「I'm sure I won't have to babysit you through it when we get there. Right...?」
CASE "依頼破棄時"
	PRINTFORMW 「That's odd... I thought we already had a deal! What's with the sudden change of plans?」
	PRINTFORMW 「Don't tease me like that, seriously... I don't know how long I can last.」
CASE "依頼実行直前"
	;LOCAL:99 = IS_DOUTEI(MASTER)

CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	
	RETURN 0
CASE "成功報告時"
;報酬：低級素材
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	PRINTFORMW 「Phew... That was refreshing, eh? Thanks a bunch.」
	PRINTFORMW 「I think I'll, uhh... contact you later if I need you again. Bye!」
	;IF LOCAL:99
	;ENDIF
CASE "失敗報告時"
	PRINTFORMW 「Where'd you go%K11_ZE()%? You just kinda disappeared.」
	PRINTFORMW 「Did you lose your nerve or something? C'mon now...」
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT
RETURN 1


;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================
@M_KOJO_IRAI_16_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Oh man... This question's been bothering me for some time, I need an advice%K11_ZE()%.」
	PRINTFORML 「Care to hear me out?」
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	
	RETURN 0
CASE "依頼実行直後"
	IF TFLAG:193 == 1
		;正解の選択肢
		PRINTFORMW 「You think so too? Fufu...」
	ELSEIF TFLAG:193 == 2
		;ハズレの選択肢だったが逆に正解
		PRINTFORMW 「You know what? This might actually work!」
		PRINTFORMW 「Why the heck not?! It surprised me, it's gonna surprise everyone else, too!」
	ELSEIF TFLAG:193 == -1
		;ハズレの選択肢
		PRINTFORMW 「Ugh, you jester... That's so lame, I don't even know where to begin%K11_ZE()%.」
	ELSEIF TFLAG:193 == -2
		;正解の選択肢だったが逆にハズレ
		IF RAND:2
			PRINTFORMW 「I mean, yeah, sure... But it's too obvious. Too safe. Stale, even. Gotta aim higher, y'know?」
		ELSE
			PRINTFORMW 「That's what Kourin would say, too. Ugh... Nope, rejected.」
		ENDIF
	ENDIF
	RETURN 1
CASE "成功報告時"
;報酬：野菜か果物
	PRINTFORMW 「Hehe, thank you so much, %CALLNAME:MASTER%!」
	PRINTFORMW 「You're pretty good when it comes to reading a girl's heart, eh?」
	RETURN 1
CASE "失敗報告時"
	PRINTFORMW 「Well, that was a waste of time, alright...」
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
CASE "口上委託率"
;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
	RESULT:100 = 0

;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
	RESULT:1 = 0
	RESULT:2 = 0
	RETURN 0
CASE "口上専用"
;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
;16,お悩み相談 の場合
;RESULT        発生判定,0だと発生しません
;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
;RESULTS:0     お悩み文章（自動で『』で囲まれます）
;RESULTS:1～3  選択肢１～３
;何も発生しない状態になると無限ループになるので注意してください
;●追記メモ
;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
;RESULT:1を7にするとどれも正解になります
;RESULT:1を8にするとどれもハズレになります
;1～3以外の場合は逆張り判定が自動で無くなります
	RESULT = 0

;▼サンプル
[SKIPSTART]
	SELECTCASE RAND:5
	CASE 0
		;このお悩みは、恋慕で発生し、親密によって正解が変わります
		SIF TALENT:恋慕
			RESULT = 1
		RESULTS:0 = 赤ちゃん作るなら何人がいいかな？
		RESULTS:1 = ５人でバスケチームを作ろう
		RESULTS:2 = ９人で野球チームを作ろう
		RESULTS:3 = １１人でサッカーチームを作ろう
		IF ABL:親密 >= 100
			RESULT:1 = 3
		ELSEIF ABL:親密 >= 20
			RESULT:1 = 2
		ELSE
			RESULT:1 = 1
		ENDIF
	CASE 1
		;このお悩みは、無条件で発生し、正解は絶対に2番で固定化されます
		SIF 1
			RESULT = 1
		RESULTS:0 = どのジョブがいいかな？
		RESULTS:1 = かっこいしナイト
		RESULTS:2 = シーフが便利だよ
		RESULTS:3 = 青魔道士最強！
		RESULT:1 = 2
		RESULT:2 = 1
	CASE 2
		;このお悩みは、夏の月に発生し、正解がランダムで変わります
		SIF DAY:2 == 2
			RESULT = 1
		RESULTS:0 = どの水着を買おうかな？
		RESULTS:1 = かわいいワンピース
		RESULTS:2 = クールなセパレート
		RESULTS:3 = 色っぽいビキニ
		RESULT:1 = RAND:3 + 1
	CASE 3
		;このお悩みは、無条件で発生し、1番と3番が正解になります（5 - 3 = 2番がハズレになります）
		SIF 1
			RESULT = 1
		RESULTS:0 = ワンちゃんの名前は何にしよう？
		RESULTS:1 = ボロンゴ
		RESULTS:2 = ゲレゲレ
		RESULTS:3 = プックル
		RESULT:1 = 5
	CASE 4
		;このお悩みは、無条件で発生し、どれを選んでも正解になります
		SIF 1
			RESULT = 1
		RESULTS:0 = 夕飯は何がいい？
		RESULTS:1 = 肉じゃが
		RESULTS:2 = コロッケ
		RESULTS:3 = 焼き魚
		RESULT:1 = 7
	ENDSELECT
[SKIPEND]

	SIF !RESULT
		RESTART
	RETURN 1
ENDSELECT


;help Marisa return her lost item
@M_KOJO_IRAI_魔理沙の忘れ物_K11(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	RETURN 0
CASE "依頼非受託時"
	RETURN 0
CASE "依頼受託時"
	RETURN 0
CASE "依頼確認時"
	RETURN 0
CASE "依頼破棄時"
	RETURN 0
CASE "依頼実行直前"
	;request when receiving 魔理沙の忘れ物 case 実行して成功/依頼実行時 - CFLAG:TARGET:依頼内容 = 1102
	IF CFLAG:1:現在位置 == CFLAG:現在位置 && CFLAG:現在位置 != SUKIMA() ;if reimu is right there
		PRINTFORMW 「...Hey, %CALLNAME:MASTER%.」
		PRINTFORMW 「Mind telling me what game is she playing? I mean, she's right over there, right?」
		PRINTFORMW 「And yet, she asked you to deliver it to me.」
		PRINTFORMDW Marisa glances at Reimu, but she turns away with a pout.
		PRINTFORMW 「Wuh-What the heck%K11_ZE()%?! D-Did I make her mad or something?! What'd I do?!」
		PRINTFORMW 「Reimu! Oiiii, Reimu! C'mon now, don't play hard to get with me!」
	ELSEIF GET_MAPID(CFLAG:現在位置) == 0 && CFLAG:現在位置 != SUKIMA() ;at hakurei shrine
		PRINTFORMW 「Oh, y-yeah... I mean, I wasn't looking for it in particular, but...」
		PRINTFORMW 「Thanks, I guess. You mentioned Reimu telling you to give it to me, right?」
		PRINTFORMW 「But she's somewhere around here though, isn't she? I wonder why she didn't just do it herself then.」
		PRINTFORMW 「...Are you her secretary?」
	ELSE
		PRINTFORMW 「Oh? Ooooh! It's the super important Macguffin I totally didn't forget about!」
		PRINTFORMW 「That's exactly what I've been looking for! Thank you so much, %CALLNAME:MASTER%!」
	ENDIF
	RETURN 1
CASE "依頼実行直後"
	
	RETURN 0
CASE "成功報告時"
;報酬：
	RETURN 0
CASE "失敗報告時"
	RETURN 0
	;IF !RESULT
	;	PRINTFORML
CASE "依頼報告不要"
	
	RETURN 0
ENDSELECT
