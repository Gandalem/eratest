				PRINTFORML 
			ENDIF
		CASE 10
			;▼釣り,（～はのんびり釣りをしている。）
			IF !ARG:1
				;行動中
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORML 
			ENDIF
		CASE 11
			;▼実験,（～は怪しい実験をしている。）
			IF !ARG:1
				;行動中
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORML 
			ENDIF
		CASE 12
			;▼のんびり,（～はのんびりしている。）
