;一日の終了時(AFTERTRAニーの前)、面識がなければ呼び出されない
;==================================================

@M_KOJO_EVENT_K11_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		IF ARG >= 10 && !IS_VIRGIN(TARGET) && STRLENS(CSTR:処女喪失履歴) && TALENT:恋慕 && !MARK:反発刻印 && FIRSTTIME("WhamBam")
			PRINTFORMDL 잠자리에 들기 전, 당신은 갑자기 마리사를 현관에서 본다.
			PRINTFORML 「야, %CALLNAME:MASTER%... 오랜만이야.」
			PRINTFORML 「그날 이후로 너 좀 사라졌더라. 우리가, 음, 있잖아... 침대에서 끝까지 갔던 그날 말이야.」
			CALL PRINT_DIALOGUE, @"나 걱정되기 시작했어, 있잖아? 혹시 날 싫어하게 된 건 아닐까, 뭐 그런 생각들... 이제 자꾸 그런 생각이 들어버리네."
			PRINTFORML 「...그냥 "화밤-감사합니다-부인" 같은 일은 아니었다고 말해줘.」
			PRINTFORML 「우리는 정말 잘 지내고 있었는데, 전부 다... 나 보러 와도 돼, 알겠지? 언제든지 환영이야%K11_ZE()%.」
			PRINTFORML 「음, 이제 가야 해. 안녕!」
			PRINTFORMDW 당신은 마리사와 잠시 대화를 나누다가 그녀가 떠난다...
			RETURN 1
		ELSE
			CALL K11_NIGHT
		ENDIF
		; IF !TALENT:75:恋慕 || !TALENT:75:恋人
		; ARG - days
		; ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		RETURN 1
	ENDIF
ENDIF
RETURN 1
