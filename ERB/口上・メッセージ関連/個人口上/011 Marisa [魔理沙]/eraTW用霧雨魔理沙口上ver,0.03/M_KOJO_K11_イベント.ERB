				CASE 1
					CALL PRINT_DIALOGUE, @"음, 이 시점에서 새로운 마도서를 써야 할지도 모르겠어%K11_ZE(,1)%... 지난번에 새로운 것을 하나 발견했거든%SPLIT_G("magic item:mushroom:artefact:tool:youkai type:animal type:vegetable type:plant type:fish type")%...", "w"
				CASE 2
					PRINTFORMW 「좋아, 내가 가진 것들로 좀 만져보자... 이걸 개선하거나 더 강력하게 만들 수 있는지 보자%K11_ZE(,1)%...」
				CASE 3
					CALL PRINT_DIALOGUE, @"얼마 전에 새로운 멋진 것(%SPLIT_G("Danmaku:technique:skill:combat move:martial arts move")%)을 봤는데, 그거에 대해 좀 조사해봐야겠다... 무언가를 적응시킬 수 있는지(%K11_ZE(,1)%).", "w"
				CASE 4
					PRINTFORMW 「가끔은 연구할 시간도 가져야지, 알잖아? 기본을 다지지 않으면 강해질 수 없으니까 %K11_ZE()%!!」
			ENDSELECT
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「휴, 오늘은 이만.」
		IF MAXBASE:仕事量 < (TCVAR:手伝った量 * 3) && TCVAR:お礼 ;if you helped a lot
			PRINTFORMW 「이봐, 도와줘서 고마워%COND_STR(@" again", TCVAR:390)% 너 정말 구세주야!」
			PRINTFORMW 「자, 별거 아니지만 \@ TCVAR:390 ? 다른 # 버섯 하나 받아. 팔거나 물약 만드는 데 쓸 수 있어%K11_ZE()%!」 \@
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Modded, added - invite to tag along
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 97
		IF CFLAG:職種 == 40
			PRINTFORML 「아, 그리고 있잖아, %CALLNAME:MASTER%? 나랑 같이 갈래?」
