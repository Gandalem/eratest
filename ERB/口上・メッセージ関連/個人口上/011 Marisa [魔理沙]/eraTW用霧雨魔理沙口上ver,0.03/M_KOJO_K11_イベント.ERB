@M_KOJO_EVENT_K11_2(ARG,ARG:1)
;CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			CALL K11_MORNING()
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「%SPLIT_G("Hey:Yo:What's up:Oi")%, %CALLNAME:MASTER%! 좋은 아침이야%K11_ZE()%!」
			IF TALENT:恋慕
				SELECTCASE IFRAND("0, 2", 1, "1", !TALENT:キス未経験 && !TALENT:MASTER:キス未経験)
					CASE 0
						PRINTFORMW 「이봐, 일어나, 잠꾸러기! 우리 인간들은 너무 잠자는 데 시간을 낭비할 여유가 없어!」
					CASE 1
						PRINTFORMW 「흥, 너 혹시 공주님 같은 존재야? 입술에 키스로 깨워줄까?」
						PRINTFORMW 「%RANDKISS("kiss")%! 헤헤~♪」
						CALL MUTUAL_KISS(TARGET)
					CASE 2
						PRINTFORMW 「좀 심심해서 네 %PRINT_MALE("boy", MASTER)%친구 보러 오기로 했어. 후훗, 기쁘지?♪」
				ENDSELECT
			ELSE
				PRINTDATAW
					DATAFORM 「아직도 자고 있었어? 하하, 내 잘못이야. 하지만 영원히 잘 수는 없잖아, 알지? 일어날 시간이야!」
					DATAFORM 「들어가다가 들렀더니 네게 인사하러 왔어%K11_ZE("daze")%. 어떻게 지내고 있어?」
					DATAFORM 「네가 여기 산다고 해서, 들러보려고 결정했어.」
					DATAFORM 「그러니까 여기가 네가 사는 곳이구나, 알고 다행이다. 밖에 기다리고 있을게%K11_ZE()%.」
				ENDDATA
			ENDIF
			RETURN 1
		ENDIF
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		CALL K11_MORNING()
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕
			PRINTFORMW 「음... %CALLNAME:MASTER%...」
			PRINTFORMW 「음~ 연모한다%K11_ZE("ze")%...」
