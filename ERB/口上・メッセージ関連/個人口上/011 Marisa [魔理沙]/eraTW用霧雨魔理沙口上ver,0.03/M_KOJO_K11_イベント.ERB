@M_KOJO_EVENT_K11_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		$CHEAT
		SELECTCASE ARG ;added
			CASE 4 ;Mima
				PRINTFORML 「M-미마님?!」
				PRINTFORMDL 마리사가 입을 벌린 채 외친다.
				IF TALENT:恋人
					PRINTFORML 「지금 내 %PRINT_MALE("boy", MASTER)%친구를 훔치고 있는 건 아니겠지?!」
					PRINTFORML 「에-엣? 그냥 연습이야? 난... 그런 것 같아...」
				ELSE
					PRINTFORML 「이건 너무 잘못된 기분이야... 어디서부터 말해야 할지 모르겠어...」
				ENDIF
			CASE 15 ;Sakuya
				PRINTFORML 「메이드 서비스가 진행 중이라니, 후후? 정말 좋은 타이밍이군! 좋아, 좋아, 난 갈게!」
				PRINTFORML 「그래도 사쿠야에 대한 내 의심은 사실이었던 것 같아, 결국%K11_ZE(,1)%...」
			CASE 17 ;Alice
				IF TALENT:恋人
					PRINTFORML 「아아알리이이...!」
					PRINTFORMDL 꿀꺽!
					PRINTFORML 「내가 얼마나 사물을 폭발시킬 수 있는지 알고 싶어? 내가 시범을 보여줄게%K11_ZE("daze")%!」
				ELSE
					PRINTFORML 「와, 알리스! 난 네가 그런 애일 거라고는 상상도 못 했는데, 뭐... 좋아.」
					PRINTFORML 「내 잘못이야, 방해하려던 건 아니었어. 하지만 걱정 마, 내가 가 있을게!」
				ENDIF
			CASE 52 ;Reisen
				RESETCOLOR
				CALL SET_KOJO_COLOR(52)
				LOCAL:9 = GETCOLOR()
				RESETCOLOR
				CALL SET_KOJO_COLOR(11)
				PRINTFORML 「우와아!」
				PRINTFORML 「What the heck are you doin' in here?!」
				CALL COLORMESSAGE(@"『우악! 마리--?!』",LOCAL:9,1,0)
				PRINTFORML 「혹시 그거 네 취향 같은 거니?」
				PRINTFORML 「나 말이야... 누구나 흥분시키는 자신만의 무언가가 있으니까, 지극히 정상이지, 안 그래?」
				PRINTFORML 「이 일이나 %조사처리(CALLNAME:MASTER,"와")% 여기서 뭘 했는지 절대 누구에게도 발설하지 않을 거야... 맹세해!」
				PRINTFORMDW 마리사는 웃으며 떠나고, 레이스는 눈에 눈물을 머금은 채 너를 응시한다.
			CASE 54 ;Patche
				PRINTFORML 「...움직이지 않는 도서관이 그곳에서 편하게 지내야 한다고 생각했지, 안 그래?」
				PRINTFORML 「오, 뭘 알겠어, 그렇지? 난 이걸 이해하기엔 너무 멍청하거든.」
				PRINTFORML 「아무튼, 내가 이 모든 곳을 폭파하기 전에 너희들에게 5분만 줄게, 좋아?」
			CASE 106 ;Sumireko
				IF TALENT:恋人
					PRINTFORML 「오... 아! 잠깐만, 내가 맞히자!」
					PRINTFORML 「안경 쓰는 여자애한테 진심이야? 나도 안경 써야 하나 봐...」
				ELSE
					PRINTFORML 「오호... 외부 세계의 여자들은 파트너들과 이런 식으로 지내는 거구나... 기억해 둘게.」
				ENDIF
			CASE 121 ;Narumi
				PRINTFORML 「나루미?! 솔직히 네가 그럴 수 있을 거라고는 상상도 못 했어...」
				PRINTFORML 「야, %CALLNAME:MASTER%! 그녀를 유혹해서 바람난 여자로 만들었다니 말하지 마!」
				PRINTFORML 「너는 그런 은둔하고 수줍음 많은 소녀들을 함부로 이용할 수 없어!」
				PRINTFORML 「게다가 그녀가 일종의 성녀라는 걸 모르나? 이런 종류의 게임을 하면 지옥에 갈 거야 %K11_ZE("daze")%.」
		ENDSELECT
		IF GROUPMATCH(ARG, 4, 15, 17, 54, 106, 121)
			IF TALENT:恋人
				PRINTFORML (그녀는 강한 사람이겠지만, 이 승리는 내가 가져갈 거야!)
				PRINTFORMW (나는 여전히 %조사처리(CALLNAME:MASTER,"의")% 연인으로서 모든 것을 감당할 수 있고, 'sides'에 있어서도 나의 %PRINT_MALE("boy", MASTER)% 친구를 믿어.)
			ELSEIF TALENT:恋慕
				PRINTFORML (이걸 질 수는 없어, 특히 %CALLNAME:ARG%%K11_ZE(,1)%한테는!)
				PRINTFORMW (나 정말 실력 올려야겠어...)
			ELSE
				WAIT
			ENDIF
			RETURN 1
		ENDIF
		IF TALENT:11:恋人
			;霊夢と
			IF ARG == 1
				PRINTFORML 「요, %CALLNAME:MASTER%, 레이무. 두 사람 즐기고 있네, 응?」
				PRINTFORML 「음, 이걸로 나한테 신세 진 거잖아%K11_ZE(,1)%」
				PRINTFORMDL 
				PRINTFORML (단막에서는 약간 열세일지도 모르지만, 이 승리는 내가 가져갈 거야!)
				PRINTFORMW (%조사처리(CALLNAME:MASTER,"의")% 연인으로서, 그리고 'sides'로서 나는 %PRINT_MALE("boy", MASTER)% 친구를 믿어.)
			ELSE
				PRINTFORML 「흥, 그런 거였나 보네. 벌써 나한테 있는데도 너는 여전히...」
				PRINTFORMW 「뭐 어때. 네 결정을 믿어%K11_ZE()%. 그 점만 명심해 두도록 해, 알겠지?」
			ENDIF
		ELSEIF TALENT:11:恋慕
			;霊夢と
			IF ARG == 1
				PRINTFORML 「야-, %조사처리(CALLNAME:MASTER,"와")%... 레이무.」
				PRINTFORML 「...」
				PRINTFORMDL 
				PRINTFORML (이건 절대 질 수 없어, 특히 레이무랑 붙는 거라면%K11_ZE(,1)%!)
				PRINTFORMW (나 제대로 실력 끌어올려야겠어...)
			ELSE
				PRINTFORML 「Ah...!」
				PRINTFORMW 「...나, 제대로 해봐야겠군...」
			ENDIF
		ELSE
			IF RAND:2 ;added
				PRINTFORML 「응? 음? 여기서 무슨 일이야? 와, 대체 뭐야!」
				PRINTFORML 「오 안 돼, 잠깐만, 이렇게 모르는 척해서 날 속이려 하지 마!」
				PRINTFORMW 「자, 얘들아, 괜히 소란 피우지 말고 체면 좀 차리라고! 정말이지...」
			ELSE
				PRINTFORMW 「저기 저기, 너희들이 잘 맞는 건 좋지만 다른 사람들이 너희를 이런 모습으로 보게 하지 마!」
			ENDIF
			;霊夢と
			IF ARG == 1
