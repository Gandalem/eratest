@M_KOJO_EVENT_K11_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		CALL K11_AFTERSEX_DEFLOWER
		SIF RESULT
			RETURN 1
		PRINTFORML 「하아, 하아, 이런, 정말 지쳤네%K11_ZE()%...」
		PRINTFORML 「오늘은 이만 끝내자%K11_ZE(,1)%...」
		PRINTFORMDW 마리사가 지친 기색을 보이며 너를 놓아준다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		CALL K11_AFTERSEX_DEFLOWER
		SIF RESULT
			RETURN 1
		PRINTFORML 「아, 정말 재미있었어.」
		PRINTFORML 「기분 좋았고, 네가 귀엽게 행동하는 걸 볼 수 있어서 그걸로 만족해.」
		PRINTFORMDW 마리사는 기분이 매우 좋아 보인다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORML 「워라밸! 아직 안 끝났어?」
		PRINTFORML 「아이고, 알았어. 일단 지금은 같이 해 주지%K11_ZE()%.」
		PRINTFORMW 「그래도, 그렇게 체력이 많을 줄은 몰랐네...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORML 「에? 계속 재미있게 놀고 싶어?」
		PRINTFORML 「후후후... %SPLIT_G(@"Be careful what you wish for, 'cause you might just get it!:Don't tell me I didn't warn ya!:Don't blame me for whatever happens next%K11_ZE()%!:You don't know what's coming, do you?")%」
		PRINTFORMDW 마리사는 너를 홀리는 듯 미소 지은 후 계속 나아갔다...
		RETURN 1
	ENDIF
ENDIF
RETURN 1
