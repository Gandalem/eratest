@K11_TRAIN()
#DIM 正解
#DIM 経験値
#DIM 制限時間
#DIM 倍率
#DIM FEINT
#DIM イカサマ
VARSET LOCAL
イカサマ = 0
制限時間 = 2000 - (ABL:11:戦闘能力 - ABL:MASTER:戦闘能力) * 100
SIF !ONCE("MarisaDanmaku") ;once a day
	RETURN 0
IF FIRSTTIME("MarisaDanmakuTrain")
	PRINTFORMW 「헤이 %CALLNAME:MASTER%, 새로운 기교를 시도해보고 싶어서 당신의 도움이 필요해요.」
	PRINTFORML 「진짜 상대가 있는 게 더 좋잖아, 있잖아.」
	PRINTFORMW 「모르겠지만, 책으로 배우는 것보다 당신이랑 마법에 대해 더 많이 배울 수 있을 것 같아. 어때? 한번 해볼래?」
	PRINTFORMDW 마리사는 이것을 아무렇지 않게 말하지만, 그녀는 진짜 마법을 사용하고 있다. 
	PRINTFORMDL 어떤 사고든 심각한 부상을 초래할 수도 있어...
ELSE
	PRINTFORMW 「오, 타이밍 좋네.」
	PRINTFORMW 「또 진지한 훈련 좀 할래?」
	PRINTFORMDL 진짜 마법으로 스파링을 하면 심각한 부상을 입을 수도 있어...
ENDIF
CALL ASK_YN("훈련에 도움이 필요한가", "아니, 너무 위험해")
IF RESULT == 1
	PRINTFORMW 「에헤? 너 뭐냐, 닭아?」
	PRINTFORMW 「Fine then, I'll practice alone.」
ELSE
	PRINTFORMW 「좋아, 이제 정해졌으니 나머지는 꽤 간단하다.」
	PRINTFORMW 「저쪽에 서 주세요... 응, 바로 저기.」
	PRINTFORMW 「자, 간다%K11_ZE()%!」
	PRINTFORMDL 마리사는 마법 투사체를 난사한다!
	正解 = RAND:4
	経験値 = MAX(ABL:64:戦闘能力 * 5, 5)
	SELECTCASE RAND:20
		CASE IS <= 11
			;普通に
			LOCALS:0 = ↑
			LOCALS:1 = →
			LOCALS:2 = ←
			LOCALS:3 = ↓
			倍率 = 100
		CASE 12 TO 15
			;ローマ字
			LOCALS:0 = UE
			LOCALS:1 = MIGI
			LOCALS:2 = HIDARI
			LOCALS:3 = SHITA
			倍率 = 160
			;英語
		CASE 16,17,18
			LOCALS:0 = UP
			LOCALS:1 = RIGHT
			LOCALS:2 = LEFT
			LOCALS:3 = DOWN
			倍率 = 120
			;Russian
		CASE 19
			LOCALS:0 = Вверх
			LOCALS:1 = Вправо
			LOCALS:2 = Влево
			LOCALS:3 = Вниз
			倍率 = 360
	ENDSELECT
	;あなたの戦闘能力が高いとフェイントかけてくる
	IF ABL:MASTER:戦闘能力 >= 5 && !RAND:5
		FEINT = 1
		制限時間 += 400
		倍率 += 80
	ELSE
		FEINT = 0
	ENDIF
	CALL FISHER_YATES_SHAFFLE(4)
	PRINTFORMDW 마리사의 공격을 피하고 반대 방향으로 회피하라 (클릭하여 시작)
	PRINTFORMD 마리사가 공격한다 
	SETCOLOR C_YELLOW
	IF FEINT
		PRINTFORM %LOCALS:(RAND:4)%
		RESETCOLOR
		PRINTFORM  하지만 실제로는 %LOCALS:(3 - 正解)%에서 온 것이다.
	ELSE
		PRINTFORM %LOCALS:(3 - 正解)%
		RESETCOLOR
	ENDIF
	PRINTFORML !
	$LOOP_IKASAMA
	FOR LOCAL:10,0,4
	LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
	PRINTFORML [{LOCAL}] - 회피한다 %LOCALS:LOCAL%
	NEXT
	SIF !イカサマ && BASE:MASTER:TSP > 500
		PRINTFORML [{4}] - 시간 정지
	TINPUT 制限時間, -1, 1
	IF RESULT == 正解
		PRINTFORML 공격을 피했다!
		IF !イカサマ
			CALL M_KOJO_COLOR_K11
			PRINTFORMW 「젠장... 힘을 안 빼고 했는데, 그렇게 쉽게 피하다니.」
			PRINTFORMW 「훨씬 더 연습해야겠어. 그래도 도와줘서 고마워%K11_ZE()%!」
			RESETCOLOR
		ELSE
			IF !FIRSTTIME("MarisaDanmakuCheat", 1)
				CALL M_KOJO_COLOR_K11
				PRINTFORML 「잡았다!!!」
				PRINTFORMDW %BREAKENG(@"시간을 다시 시작하는 순간, 마리사의 사방, 뒤, 앞, 옆에서 추가적인 난사가 일제히 너를 향해 날아온다!")%
				PRINTFORML 「하하하! 어때?! 그냥 잠시 시간을 끌면 나머지는 식은 죽 먹기지!」
				PRINTFORMW 「봐? 양쪽 다 똑같이 할 수 있잖아%K11_ZE("daze",1)%, %CALLNAME:MASTER%... 그러니까 다음엔 공정하게 하자, 그렇지?」
				PRINTFORMDW 아무래도 완전히 질 줄 몰랐나 보네... 네 몸이 아프고 타오르고 있어.
				RESETCOLOR
				CALL RECOVER(MASTER, -1000, "体力")
				SETCOLOR C_RED
				FONTBOLD
				PRINTFORMW 고통스러운 반격으로 인해 당신의 STA가 큰 타격을 입는다!
				RESETCOLOR
			ELSE
				CALL M_KOJO_COLOR_K11
				PRINTFORMDL 시간을 멈추고 마리사 옆을 지나 미니 하케로를 취한 뒤 시간을 다시 진행한다.
				PRINTFORML 「...우와, 뭐야--?! 어-어떻게 여기에 온 거야?!」
				PRINTFORML 「치트하는 거야?! 너 치트하고 있는 거지?! 그렇게 할 리가 없어!」
				PRINTFORMW 「크윽... 괜찮아. 더 지독한 걸 생각해낼 테니까 보라고! 그리고 그거 돌려줘%K11_ZE()%!」
				RESETCOLOR
				CALLF FIRSTTIME("MarisaDanmakuCheat")
			ENDIF
		ENDIF
		CALL RECOVER(MASTER, -(100 * (1 + ABL:戦闘能力)), "体力", " ")
		CALL RECOVER(MASTER, -(100 * (1 + ABL:戦闘能力)), "気力", " ")
		CALL RECOVER(MASTER, -(100 * (1 + ABL:戦闘能力)), "TSP", " ") ;added TSP
		経験値 = 経験値 * 倍率 / 100
		CALL AddEXP("戦闘経験", MASTER, 経験値)
		CALL AddEXP("戦闘経験", TARGET, 経験値 * 2)
		CALL CHANGE_CFLAG(2,TARGET,経験値 * 2)
		CALL CHANGE_CFLAG(4,TARGET,経験値 * 2)
	ELSEIF RESULT == 4 && !イカサマ && BASE:MASTER:TSP > 500
		イカサマ = 1
		倍率 /= 5
		PRINTFORMW 너는 시간 정지를 사용하여 공격을 간파한다!
		GOTO LOOP_IKASAMA
	ELSE
		CALL M_KOJO_COLOR_K11
		PRINTFORMDL 피할 수 없게 마리사의 난사가 당신을 강타하며 날려버린다!
		PRINTFORMDW 그 일격은 너무 강력해서 당신은 몇 번 공중에서 회전하다가 '쿵' 소리를 내며 땅에 쓰러졌다.
		PRINTFORMW 「어, 어라, 괜찮아?!」
		PRINTFORMW 「아, 미안... 그래도 덕분에 저 공격에 대한 자신감이 생겼네. 고마워!」
		PRINTFORMDW 마리사가 의료 지원을 받으러 달려간다...
		RESETCOLOR
		CALL RECOVER(MASTER, -(400 * (1 + ABL:戦闘能力)), "体力", " ")
		CALL RECOVER(MASTER, -(400 * (1 + ABL:戦闘能力)), "気力", " ")
		CALL AddEXP("戦闘経験", TARGET, 経験値)
		CALL CHANGE_CFLAG(2,TARGET,経験値 / 2)
		CALL CHANGE_CFLAG(4,TARGET,経験値 / 2)
	ENDIF
ENDIF
RETURN 1

