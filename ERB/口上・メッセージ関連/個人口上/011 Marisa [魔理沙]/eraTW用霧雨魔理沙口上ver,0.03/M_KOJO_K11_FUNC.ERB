@K11_ZE_ASK()
PRINTFORMDL 마리사가 말에서 "ze"를 사용하는 것을 보고 싶나요?
CALL ASK_YN
CFLAG:11:K11EN_ZE = !RESULT

@K11_ZE(ARGS, ARG, ARG:1)
#FUNCTIONS
SIF CFLAG:11:口上セレクタ ;Custom code, don't process if using an alternate dialogue.
	RETURNF
SELECTCASE ARGS
	CASE "daze"
		SIF !CFLAG:11:K11EN_ZE
			RETURNF
		LOCALS = da ze
	CASEELSE
		SIF !CFLAG:11:K11EN_ZE
			RETURNF
		LOCALS = ze
ENDSELECT
SIF ARG:1
	LOCALS '= CAPITALIZE(LOCALS)
IF ARG == 1
	RETURNF " " + LOCALS
ELSEIF ARG == 2
	RETURNF " " + LOCALS + "..."
ELSEIF ARG == 3
	RETURNF " " + LOCALS + "."
ELSEIF ARG == 4
	RETURNF " ..." + LOCALS
ELSEIF ARG == 5
	RETURNF "... da... ze"
ELSE
	RETURNF ", " + LOCALS
ENDIF

