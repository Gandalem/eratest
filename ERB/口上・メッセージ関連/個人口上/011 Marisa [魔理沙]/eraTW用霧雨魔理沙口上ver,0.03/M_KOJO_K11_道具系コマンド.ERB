			ENDSELECT
		ENDIF
		;解除
	ELSE
		IF TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「%MOAN()%...!」
					PRINTFORMDL 바이브레이터를 꺼낸 후에도 마리사의 소녀다운 표정은 한동안 계속 떨리고 떨렸다...
