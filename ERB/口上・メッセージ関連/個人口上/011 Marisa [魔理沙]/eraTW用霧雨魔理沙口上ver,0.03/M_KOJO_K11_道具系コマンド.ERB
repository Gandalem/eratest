@M_KOJO_MESSAGE_COM_K11_41_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「도대체 저게 뭐야? 뭐 하는 거야...?」
			PRINTFORMW 「저걸 보는 것만으로도... 뭔가 안 좋은 예감이 들어...」
			PRINTFORMW 「푸아아아아악?! 젠장, 너무 자극적이야!!!」
			PRINTFORMW 「네가 나를 위해 해주는 거라도, 부디 과하게 강한 건 피해주길%K11_ZE()% 바라...」
			PRINTFORMW 「저기, 내 말 듣고 있어? 내가 말하잖아, 잠시만-- 하아아아악?!」
		ELSE
			PRINTFORMW 「뭐야 저건? 나한테는 엄청 수상해 보이는데%K11_ZE()%...」
			PRINTFORMW 「마사지 도구라고? 뭐, 당연하지. 지금 어깨가 결린 것도 아니니까%K11_ZE()%.」
			PRINTFORMW 「잠깐, 어디를 밀고 있는 거야%K11_ZE("daze")%?! 설마... 히이이이?! ――――우으윽?!?!」
		ENDIF
		RETURN 1
	ENDIF
	IF RAND:6 ;filler moans
		FOR LOCAL, 0, 2
		PRINTFORML 「%MOAN("l" + (TALENT:恋慕 || ( MARK:不埒刻印 == 3 && !RAND:3) ? ":m" # ""),, (TALENT:恋慕 ? RAND(3,7) # RAND(2, 5 )), (TALENT:恋慕 ? "heart:name" # "rand") )%...%SPLIT_G("!:?!:!!!:::")%」
		NEXT
		WAIT
		RETURN 1
	ENDIF
	IF TALENT:恋慕
		PRINTDATAL
			DATALIST
				DATAFORM 「%MOAN("m")%! 크으으으윽! %MOAN("h")%――――!!!」
				DATAFORM 「그만둬! 멈춰! 드르르륵!! 자극이 너무 강해! %SPLIT_G("I'm losing consciousness!:It's frying my brains")%!!!」
			ENDLIST
			DATALIST
				DATAFORM 「%MOAN("m")%! %MOAN()%! %MOAN(,,2)%!」
				DATAFORM 「이-이건 그냥... %SPLIT_G("so... so mindblowing:so... so crazy:too... too intense")%! %MOAN("h")%!!!」
			ENDLIST
			DATALIST
				DATAFORM 「이거 좋다만, %SPLIT_G("I'd much rather have you satisfying me than this:I'd rather have you dote on me with your hands")%%K11_ZE()%……」
				DATAFORM 「%MOAN("m")%! 잠시만요, 너무 세요… 아-아니 더는 안 돼요! %MOAN("h")%!!!」
			ENDLIST
		ENDDATA
	ELSE
		PRINTDATAL
			DATALIST
				DATAFORM 「더는 안 돼! 이거 너무 자극적이야! 정말 나쁜 소리라고 말하는 거라고!」
				DATAFORM 「잠깐만, 안 돼, 그만해, 제발 그만해-- 크윽?! %MOAN("h")%――――!!!」
			ENDLIST
			DATAFORM 「그 느낌은 이제 충분히 받았으니, 좀 덜 자극적으로 해줄 수 있나요?」
			DATAFORM 「아아아악...! 지-이건 그저... 안 돼어어, 그만해!」
			DATAFORM 「아아아아아아?! 크윽, 그만해... 제발... 하아, 하아...」
		ENDDATA
	ENDIF
	WAIT
ENDIF
RETURN 1
