@M_KOJO_MESSAGE_COM_K11_40
CALL M_KOJO_MESSAGE_COM_K11_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「이건 뭐야...? 이거 뭐 하는 거야?」
			PRINTFORMW 「에, 잠깐, 히야아아아악?!」
			PRINTFORMW 「으윽... 이번엔 이 장난감들을 쓸 때인가 보네.」
			PRINTFORMW 「뭐, 기분은 좋지만, 가능하다면 네가 직접 해줬으면 더 좋을 것 같아.」
			PRINTFORMW 「나한테 이런 거 사용할 필요는 없잖아, 알잖아...」
			PRINTFORMDW 마리사는 노골적으로 불만스러운 표정을 지으며 한숨을 내쉰다.
		ELSE
			PRINTFORMW 「저게 뭐야? 저런 건 본 적이 없어.」
			PRINTFORMW 「오-어?! 어디서 뭘 누르고 있다고 생각하는 거야... 으윽?! 히야아아아아아악!!!」
			PRINTFORMW 「...크윽. 또 제일 이상한 도구들을 꺼냈네, 안 그래?」
		ENDIF
		RETURN 1
	ENDIF
	IF RAND:6 ;filler moans
		FOR LOCAL, 0, 2
		PRINTFORML 「%MOAN("l" + (TALENT:恋慕 || ( MARK:不埒刻印 == 3 && !RAND:3) ? ":m" # ""),, (TALENT:恋慕 ? RAND(3,7) # RAND(2, 5 )), (TALENT:恋慕 ? "heart:name" # "rand") )%...%SPLIT_G("!:?!:!!!:::")%」
		NEXT
		WAIT
		RETURN 1
	ENDIF
	IF TALENT:恋慕
		PRINTDATAL
			DATALIST
				DATAFORM 「히야아아아악!!!」
				DATAFORM 「제발 내 예민한 곳을 너무 세게 누르지 말아줘, 좀 쉬어줘...!!!」
			ENDLIST
			DATALIST
				DATAFORM 「%MOAN()%...! %FSYN("hii")%! %MOAN(,,2)%!」
				DATAFORM 「나, 나 절대 멈추지 않아-- %MOAN("h")%!!!」
			ENDLIST
			DATALIST
				DATAFORM 「이건 좋지만, 차라리 당신의 손으로 나를 애지중지해 주면 좋을 텐데...」
				DATAFORM 「%MOAN("m")%! 잠깐, 그렇게 갑자기...! %MOAN("h")%!」
			ENDLIST
			DATALIST
				DATAFORM 「내가 말하는데, 이런 섬뜩한 장난감은 필요 없어, 휴...」
				DATAFORM 「%K11_ZE()%!」 그녀가 나를 직접 만져준다면 훨씬 기분이 좋아질 것 같아.
			ENDLIST
			DATALIST
				DATAFORM 「나-나는 항상 이런 것들 스스로 할 수 있잖아, 있잖아...」
				DATAFORM 「네가 여기 있으니까, 그냥 나를 만지고 네 마음을 직접 가져주면 안 돼? 제발...?」
			ENDLIST
			DATALIST
				DATAFORM 「이-이게 네가 무언가를 보상하는 방식이야? 정말 바보 같아...」
				DATAFORM 「네 사랑스러운 손길과 온기를 느낄 때마다 항상 기분이 좋아져, 알잖아? 가끔은 이해가 안 돼...」
			ENDLIST
		ENDDATA
	ELSE
		PRINTDATAL
			DATALIST
				DATAFORM 「%SPLIT_G("또 그놈이네:하아, 또 시작이야:저기 또 있네")%...」
				DATAFORM 「너무 자극적이에요... 제발, 자비를 위해 진동을 약하게 해주세요... 아윽, %SPLIT_G("stooooooop:noooooo:dooooon't")%!!!」
			ENDLIST
			DATALIST
				DATAFORM 「장난감을 사용하는 것도 비교하면 나쁘지 않겠지...」
				DATAFORM 「적어도 만져지는 것보다는 천 배는 낫다.」
			ENDLIST
			DATAFORM 「%MOAN()%... 진동이, 그게... 안 돼, 안 돼...!」
			DATAFORM 「우와아아아... 크흡, 안 돼...! 하아, 하아...」
			DATAFORM 「하아――%MOAN()%!――%MOAN()%――!!!」
		ENDDATA
	ENDIF
	WAIT
ENDIF
RETURN 1
