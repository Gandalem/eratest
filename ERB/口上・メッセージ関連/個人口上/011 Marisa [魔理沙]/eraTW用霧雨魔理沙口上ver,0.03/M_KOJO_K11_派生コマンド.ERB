;一人目口上

@M_KOJO_MESSAGE_SCOM_K11_9_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ONCE(TFLAG:50 + 500)
		LOCAL = MASTER_POSE(4,1,1)
		IF TALENT:恋慕
			PRINTFORML 「그러니까 우리 둘 다 네 거 빨아주길 바라는 거야, 응? 알겠어.」
			PRINTFORMW 「좋아, %CALLNAME:LOCAL%가 나를 이기게 두진 않을 거야%K11_ZE()%!」
		ELSE
			PRINTFORML 「나와 %CALLNAME:LOCAL%가 너를 위해 이것을 함께 해주는 걸 원해?」
			PRINTFORMW 「...음, 핥는 행위가 절반으로 줄어든다면, 나는 언제든지 일반적인 블로우잡보다 이걸 택할 것 같아.」
		ENDIF
		RETURN 1
	ENDIF
	IF RAND:6 ;filler moans
		FOR LOCAL, 0, 2
		PRINTFORML 「%RANDLIPS(,(TALENT:恋慕 ? "heart:name" # "dot") )%...%SPLIT_G("!:?!:!!!")%」
		NEXT
		WAIT
		RETURN 1
	ENDIF
	LOCAL = MASTER_POSE(4,1,1)
	IF TALENT:恋慕
		PRINTFORMW 「어때? 내 혀가 %CALLNAME:LOCAL%의 것보다 백 배는 더 좋은 것 같지 않아?」
	ELSE
		PRINTFORML 「이렇게 함께 당신을 위해 봉사하게 되면서, %CALLNAME:LOCAL%에게 지고 싶지 않다는 기분이 들 수밖에 없네요.」
		PRINTFORMW 「...젠장, 내가 이 경쟁심 때문에 이용당하는 걸지도 모르겠군?」
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K11_{SELECTCOM}_1
RETURN 1
