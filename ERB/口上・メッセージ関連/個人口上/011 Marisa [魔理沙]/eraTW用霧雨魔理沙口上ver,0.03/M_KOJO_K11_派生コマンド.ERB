		LOCAL = MASTER_POSE(5,1,1)
		IF TALENT:恋慕
			PRINTFORML 「그러니까 너 우리 가슴 사이에 네 거 끼울 거야, 응? 알겠어.」
			PRINTFORMW 「좋아, 난 %CALLNAME:LOCAL%에게 지지 않을 거야 %K11_ZE()%!」
		ELSE
			PRINTFORML 「나와 %CALLNAME:LOCAL%가 너를 위해 같이 이걸 해주길 바라는 거야?」
			PRINTFORMW 「...내 가슴이 너에게 충분하지 않다는 돌려 말하는 거니?」
		ENDIF
		RETURN 1
	ENDIF
	IF RAND:6 ;filler moans
		FOR LOCAL, 0, 2
		PRINTFORML 「%MOAN("l" + (TALENT:恋慕 || ( MARK:不埒刻印 == 3 && !RAND:3) ? ":m" # ""),, (TALENT:恋慕 ? RAND(3,7) # RAND(2, 5 )), (TALENT:恋慕 ? "heart:name" # "rand") )%...%SPLIT_G("!:?!:!!!:::")%」
		NEXT
		WAIT
		RETURN 1
	ENDIF
	LOCAL = MASTER_POSE(5,1,1)
	IF TALENT:恋慕
		PRINTFORMW 「어때? 내 %FSYN("chest")%이 %CALLNAME:LOCAL%보다 백 배는 더 좋지, 안 그래?」
	ELSE
		PRINTFORML 「이렇게 함께 당신을 위해 봉사하게 되면서, %CALLNAME:LOCAL%에게 지고 싶지 않다는 기분이 들 수밖에 없네요.」
		PRINTFORMW 「...젠장, 내가 이 경쟁심 때문에 이용당하는 걸지도 모르겠군?」
	ENDIF
ENDIF
