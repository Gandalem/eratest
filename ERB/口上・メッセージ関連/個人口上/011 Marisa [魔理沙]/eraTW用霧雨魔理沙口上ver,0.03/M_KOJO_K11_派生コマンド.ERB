@M_KOJO_MESSAGE_SCOM_K11_12
CALL M_KOJO_MESSAGE_SCOM_K11_12_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K11_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF RAND:6 ;filler moans
		FOR LOCAL, 0, 2
		PRINTFORML 「%RANDLIPS(,(TALENT:恋慕 ? "heart:name" # "") )%...%SPLIT_G("!:?!:!!!:::")%」
		NEXT
		WAIT
		RETURN 1
	ENDIF
	IF TALENT:恋慕
		IF RAND:2
			PRINTFORML 「내 %FSYN("sandwich:ing")%과 내 %FSYN("chest")% 사이에 당신을 두고 동시에 핥아야 한다는 게 믿기지 않아...」
			PRINTFORMW 「내가 쏟는 이 모든 노력으로 기분 좋아해야 할 거야 %K11_ZE("daze")%!」
		ELSE
			PRINTFORML 「이거 너무 힘드네%K11_ZE()%... 정말 기분 좋은 거야...?」
			PRINTFORMW 「%FSYN("lips_muffle")%! 핥아-핥아... 음, 어때?」
		ENDIF
	ELSE
		IF RAND:2
			PRINTFORML 「좋아, 네가 시키는 대로 할게 %K11_ZE()%...」
			PRINTFORMW 「하아, 내가 지금 뭘 하고 있는 거지...」
		ELSE
			PRINTFORML 「슬럽-슬럽... 이걸로 만족하는 거지?」
			PRINTFORMW 「어이, 기다리게 하지 마! 빨리 사정하고 이 지긋지긋한 걸 끝내버려!」
		ENDIF
	ENDIF
ENDIF
