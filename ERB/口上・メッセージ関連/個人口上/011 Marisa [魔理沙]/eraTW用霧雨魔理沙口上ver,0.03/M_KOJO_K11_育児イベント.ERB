;育児イベント登下校時の地の文。
;-------------------------------------------------

@M_KOJO_EVENT_K11_CHILD_RAISING_登下校(ARGS,ARG,ARG:1)
IF !ARG
	;登校時
	PRINTFORML 
ELSE
	;下校時
	PRINTFORML 
ENDIF
;-------------------------------------------------
;育児イベント食事時。
;-------------------------------------------------

@M_KOJO_EVENT_K11_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
SIF (!TALENT:思慕 && !TALENT:恋慕) || (MARK:反発刻印 >= 3 || CFLAG:ブチギレ)
	RETURN 0
CALL M_KOJO_COLOR_K11
IF ARGS == "授乳"
	PRINTFORMDW %CALLNAME:11%은(는) %HIS_HER(11)% 아기를 모유 수유 중이다...
	PRINTFORMW 「음...! 괜찮아, 응 잘 먹고 있네 %PRINT_MALE("boy",TALENT:育児中)%...」
	PRINTFORMW 「...저기, 무슨 일이야 %CALLNAME:MASTER%? 너도 이거 좀 원해?」
	PRINTFORMDW 당신은 가능한 가장 빠르게 고개를 끄덕였다.
	PRINTFORMW 「에헤헤... 와, 여기 정말 희망 없는 %PRINT_MALE("daddy:mommy",MASTER)%가 있네, 응?」
	PRINTFORMDW %HIS_HER(11)%의 거친 말에도 불구하고, %CALLNAME:11%은 아기가 수유를 마쳤는지 확인한 후 다른 쪽 가슴을 드러냈다.
	PRINTFORMDW 당신은 %HIS_HER(11)%의 유두를 빨고 %HIS_HER(11)%의 모유를 음미했다...
	PRINTFORMDW ...정말 달콤하다...
ELSEIF ARGS == "離乳食"
	PRINTFORML 
ELSEIF ARGS == "幼少期"
	PRINTFORML 
ELSE
	PRINTFORML 
ENDIF
