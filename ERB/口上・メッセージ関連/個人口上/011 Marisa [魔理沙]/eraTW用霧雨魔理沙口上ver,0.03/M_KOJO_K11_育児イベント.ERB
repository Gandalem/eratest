;-------------------------------------------------
;育児イベント食事時。
;-------------------------------------------------
@M_KOJO_EVENT_K11_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
SIF (!TALENT:思慕 && !TALENT:恋慕) || (MARK:反発刻印 >= 3 || CFLAG:ブチギレ)
	RETURN 0
CALL M_KOJO_COLOR_K11
IF ARGS == "授乳"
	PRINTFORMDW %CALLNAME:11% is breastfeeding %HIS_HER(11)% baby...
	PRINTFORMW 「Mnn...! There-there, good %PRINT_MALE("boy",TALENT:育児中)%...」
	PRINTFORMW 「...Hey, what's up %CALLNAME:MASTER%? Could it be that you want some of this too?」
	PRINTFORMDW You quickly nod your head the fastest you could.
	PRINTFORMW 「Eeeehhh... Sheesh, that's one hopeless %PRINT_MALE("daddy:mommy",MASTER)% we got here, huh?」
	PRINTFORMDW Despite %HIS_HER(11)% harsh words, %CALLNAME:11% exposes the other boob after making sure the baby had finished nursing.
	PRINTFORMDW You suck on %HIS_HER(11)% nipple and savor %HIS_HER(11)% breast milk...
	PRINTFORMDW ...It's very sweet...
ELSEIF ARGS == "離乳食"
	PRINTFORML 
ELSEIF ARGS == "幼少期"
	PRINTFORML 
ELSE
	PRINTFORML 
ENDIF

