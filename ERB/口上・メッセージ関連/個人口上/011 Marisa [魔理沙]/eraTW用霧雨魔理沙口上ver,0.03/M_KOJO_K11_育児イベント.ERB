@M_KOJO_EVENT_K11_CHILD_RAISING_回復
;-------------------------------------------------
SIF (!TALENT:思慕 && !TALENT:恋慕) || (MARK:反発刻印 >= 3 || CFLAG:ブチギレ)
	RETURN 0
CALL M_KOJO_COLOR_K11
PRINTFORMW 「Oh, there you are, %CALLNAME:MASTER%. I see you came to check on me after all.」
PRINTFORMW 「Heeey, little %PRINT_MALE("guy",TALENT:育児中)%, %PRINT_MALE("daddy:mommy",MASTER)%'s here～!」
PRINTFORMDW Your %PRINT_MALE("son",TALENT:育児中)% reaches out %HIS_HER(TALENT:育児中)% little hand to you, saying "%PRINT_MALE("Dadaa:Mamaa",MASTER)%".
PRINTFORMDW You bring your index finger close and the baby grips it...

