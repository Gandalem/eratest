@M_KOJO_EVENT_K11_CHILD_RAISING_会話寸前
;-------------------------------------------------
SIF (!TALENT:思慕 && !TALENT:恋慕) || (MARK:反発刻印 >= 3 || CFLAG:ブチギレ)
	RETURN 0
CALL M_KOJO_COLOR_K11
PRINTFORMDW 『아아... %PRINT_MALE("Paa.. paa:Maa... maa",11)%...!』
PRINTFORMW 「너 들었어, %CALLNAME:MASTER%?! %HE_SHE(TALENT:育児中,1)%이 방금 %PRINT_MALE("Papa:Mama",11)%%K11_ZE()%라고 했잖아!」
PRINTFORMW 「자, 이제 %PRINT_MALE("Papa:Mama",MASTER)% 말해봐! %PRINT_MALE("Pa-pa:Ma-ma",MASTER)%!」
PRINTFORMDW 『우으... %PRINT_MALE("Paa:Maa",MASTER)%?』
PRINTFORMW 「응-응, 계속 해! %PRINT_MALE("Pa-pa:Ma-ma",MASTER)%!」
PRINTFORMDW 『%PRINT_MALE("Paa! Pa! Pa!:Maa! Ma! Ma!",MASTER)%』
PRINTFORMDW %PRINT_MALE("son",TALENT:育児中)%은(는) 아직 그것을 정말로 이해했는지 확신할 수 없다.
