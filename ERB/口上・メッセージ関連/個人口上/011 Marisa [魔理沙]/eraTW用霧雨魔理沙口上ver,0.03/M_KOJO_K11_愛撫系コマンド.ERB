@M_KOJO_MESSAGE_COM_K11_3
CALL M_KOJO_MESSAGE_COM_K11_3_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF IS_VIRGIN(TARGET) || TALENT:恋慕
			PRINTFORMW 「오... 손가락을 넣을 거야?」
			PRINTFORMW 「좋아, 하지만 예쁘게 행동해야 해%K11_ZE()%.」
			PRINTFORMW 「내 말은, 여기 다치면 \@ IS_VIRGIN(TARGET) ? 내 순결 전부가 허사로 날 거고 # 한동안 너를 만족시켜 주지 못할 거잖아 \@?」
		ELSE
			PRINTFORMW 「좋아, 됐어... 네가 하고 싶은 대로 해.」
			PRINTFORMW 「어차피 난 처녀도 아니니까...」
		ENDIF
		PRINTFORMDW 당신은 마리사의 음부에 손가락을 대고 그녀의 음순 위를 지나 음핵 주위를 돈다.
		PRINTFORMDW 그녀의 입구가 충분히 느슨해지자, 당신은 손가락 끝을 안으로 밀어 넣는다...
		PRINTFORMW 「%MOAN(,,4,"dot")%...!」
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		RETURN 1
	ELSE
		IF RAND:6 ;filler moans
			FOR LOCAL, 0, 2
			PRINTFORML 「%MOAN("l" + (TALENT:恋慕 || ( MARK:不埒刻印 == 3 && !RAND:3) ? ":m" # ""),, (TALENT:恋慕 ? RAND(3,7) # RAND(2, 5 )), (TALENT:恋慕 ? "heart:name" # "rand") )%...%SPLIT_G("!:?!:!!!:::")%」
			NEXT
			WAIT
			RETURN 1
		ENDIF
		SELECTCASE IFRAND("0TO5", 1, "D5", PALAM:潤滑 < PALAMLV:3)
			CASE 0
				PRINTFORMW 「응아아악! 당신의 손가락으로 %FSYN("stir:ed")%을 얻고 있어... 나한테 꽤 영향을 주고 있다고...!」
			CASE 1
				PRINTFORMW 「%MOAN("m")%! 야, 너의 손가락이... %SPLIT_G("entering me:moving inside")%... 느껴져...!」
			CASE 2
				PRINTFORMW 「흐윽- 기다려봐, 그냥 손가락으로만 자극하지 말고 좀 더 부드럽게 해줘... %MOAN(,,2)%, 흐으으읍...!!!」
			CASE 3
				PRINTFORML 「%MOAN()%...! 아아악...! 저-거야 내 약점이야... 바로 거기가...!」
				PRINTFORMW 「그, 그렇게 계속 손가락을 구부리고 나를 자극하면... 이 쾌감에 미쳐버릴 것 같아...!」
			CASE 4
				PRINTFORML 「더 나에게 손가락을 넣으면 더 많은 음란한 체액이 계속 나온다고 말하는 거야?」
				PRINTFORMW 「아-아니, 그런 뜻이 아니야! %SPLIT_G("That's absolutely... not the case:That's just... plain wrong:N-No such thing... is happening:That's totally... not the reason")%...!」
			CASE 5
				PRINTFORMDL 와... 마리사의 장난기 넘치는 곳은 지금 그녀의 분비물로 믿을 수 없을 만큼 미끄럽다.
				PRINTFORMDL 아주 쉽게 들어간다... 과연 그녀는 그것을 볼 수 있을까, 궁금해진다.
				PRINTFORML 「으응호오, 나한테 설명하지 마아... %FSYN("hii")%! 그리고 날 흥분시키지 마아...! %MOAN()%!」
				PRINTFORMDL 그녀의 클리토리스와 슬릿은 모두 준비를 마치고 갈 태세다! 저게 많은 이들이 따라올 수 없는 마녀의 경지 아니겠어, 그렇지 않아?
				PRINTFORMW 「히야아아안나!!!」
		ENDSELECT
	ENDIF
	;処女(処女喪失処理が既に終了しているので、V経験1の場合)
	IF !FLAG:70 && IS_VIRGIN(TARGET) && CFLAG:2 >= 1500 && FIRSTTIME("MarisaFingerPop")
		PRINTFORML
		PRINTFORMDL 마리사는 여전히 처녀이고, 그녀의 희미가 좀 방해가 되는 것 같다고 생각한다.
		PRINTFORMDL 아마 평소 방식대로 해주는 것을 선호하겠지만...
		PRINTFORMDL 이번에는 모면할 수 있지 않을까?
		CALL ASK_YN("그녀를 순결하지 못하게 해라!", "하지 마!")
		IF !RESULT
			LOCAL = 0
			IF (TALENT:セフレ || TALENT:愛欲) && !HAS_PENIS(MASTER)
				PRINTFORMW 「아... 올 줄 알았어.」
				PRINTFORMW 「결국 제대로 하려면 이 방법밖에 없잖아.」
				PRINTFORMW 「뭐, 괜찮아. 상관없어. 물론 진짜가 더 좋겠지만, 어쩔 수 없지 뭐...」
			ELSEIF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲
				PRINTFORMW 「저기, 잠깐만! 그렇게 깊이 들어갈 거라면, 내가 너를 위해 아껴왔던 처녀성을 잃게 될 거야!」
				PRINTFORMW 「응? 내 아래가 너무 작아서 진짜 무언가가 나를 갈기기라도 할까... 라고 말하는 거야...?」
				PRINTFORMW 「난 그런 건 상관없어! 네 것이라면 찢기는 것도 괜찮아! 그게 내가 항상 원했던 거니까...」
				PRINTFORMW 「크윽... 손가락이... 너무 깊숙이 들어와...! 아아... 크으으...!!!」
			ELSE
				PRINTFORMW 「기다려 봐! 나... 나는 처녀라서 계속 그렇게 깊숙이 넣으면, 난...!」
				PRINTFORMDW 마리사의 간청을 무시하고, 당신은 손가락을 그녀의 보속으로 더 깊이 밀어넣는다.
				PRINTFORMW 「흐윽...! 제발, 내 말 들어줘! 으악! 더 깊이 들어가면...! 아아악!!!」
				PRINTFORMDW %BREAKENG(@"잠시 손가락 끝이 무언가에 걸린 것을 느꼈고, 그 지점을 넘어 더 밀어 넣으려 준비하는 순간, 마리사가 온몸을 떨며 비명을 질렀다...")%
			ENDIF
			CALL ASK_YN("우리가 해내고 있어!", "마음을 바꿔 봐")
			IF !RESULT
				IF (TALENT:セフレ || TALENT:愛欲) && !HAS_PENIS(MASTER)
					PRINTFORMDW 마리사는 당신이 그녀의 안으로 손가락을 한 번에 밀어 넣자 이를 악물었다.
					PRINTFORMW 「윽, 끅... 하아... 흥.」
					PRINTFORMW 「그리고 끝났구나... 나의 처녀성에게 작별을 고해.」
					PRINTFORMDW 눈물이 그녀의 얼굴을 타고 흘렀지만, 고통 자체에 대해서는 그리 괴로워하는 것 같지 않았고, 오히려 불행한 상실을 애도하는 듯했다.
					PRINTFORMDW 더 좋았을 수도 있었는데...
				ELSEIF TALENT:恋慕 || TALENT:セフレ || TALENT:愛欲
					PRINTFORMW 「말도 안 돼... 말도 안 돼! 너랑 처음 하는 거 제대로 하고 싶었는데...」
					PRINTFORMW 「...으윽, 좋아, 네 마음대로 해. 하지만 적어도... 부드럽게 해줘, 알았지?」
					PRINTFORMDW 고개를 끄덕이고, 당신은 마리사의 순결을 한 번에 깨뜨린다.
					PRINTFORMW 「흐응...! 아파, 윽, 아아악...!」
				ELSE
					PRINTFORMW 「안 돼애, 그만해줘, 제발! 부탁이야! 우와아, 아아아악hhh!」
					PRINTFORMDW 당신은 저항하는 마리사를 붙잡고 시작한 것을 끝내 그녀의 순결을 한 번에 찢는다.
					PRINTFORMW 「오우와...! 이건... 너무 잔인해... 너무 비열해! 우으으윽...!!!」
					PRINTFORMDW 마리사는 눈물을 흘리며 무너져 내렸지만, 이제 당신에게는 더 이상 중요하지 않았다.
					PRINTFORMDW 그녀의 피가 당신의 손가락을 적시는 가운데, 당신은 이전에 온전했던 그녀의 처녀막 잔해를 긁어내고 격렬하게 손가락질하기 시작한다...
					CALL GET_ANGRY(TARGET, 1)
				ENDIF
				CALL COLORMESSAGE(@"처녀성 상실 (%CALLNAME:TARGET%)", 0xF7ABA6, 2)
				CALL SET_HISTORY_LOST_V(TARGET, MASTER, "指")
				STAIN:Ｖ |= 64
				STAIN:MASTER:手 |= 64
				PALAM:苦痛 += 500
				PALAM:反感 += 300
				PALAM:抑鬱 += 300
			ELSE
				LOCAL = 1
				GOTO CANCEL
			ENDIF
		ELSE
			$CANCEL
			PRINTFORMDW 어쩌면 나쁜 생각일지도 모른다. 하지 않는 게 좋겠다.
			SIF (TALENT:セフレ || TALENT:愛欲) && !HAS_PENIS(MASTER)
				CALL PRINT_DIALOGUE, @"D-다른 계획이라도 있어? 난 어느 쪽이든 상관없어, 우리가 선택의 여지가 없으니 말이야... 뭐, 네 마음대로 해.", "w"
			IF LOCAL
				PRINTFORMDW 마리사가 크게 안도의 한숨을 내쉬는 것을 알아차린다.
				CALL CHANGE_CFLAG(2, 11, 50) ;favor
				CALL CHANGE_CFLAG(4, 11, 10) ;trust
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
