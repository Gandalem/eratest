@M_KOJO_MESSAGE_COM_K11_23_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF FLAG:70
		;失敗
	ELSEIF TFLAG:193
		SELECTCASE IFRAND("0TO9", 1, "D3, D4, D5, D6, D9", TALENT:恋慕)
			CASE 0
				PRINTFORML 「버섯으로 자위해 본 적 있어...?」
				PRINTFORML 「뭐?! 안 돼! 무슨 소리를 하는 거야?」
				PRINTFORMW 「%K11_ZE()%은(는) 네의 그 병적인 판타지는 혼자 간직하라고!」
			CASE 1
				PRINTFORML 「에? 나 속옷 없으면 아무것도 아니라고? %SPLIT_G("Are you telling me you forgot about my hat? That's pretty important, y'know!:As in, you can't even tell that it's me?")%」
				PRINTFORML 「무례하네! 됐어, 사과하기 전까지는 더 이상 너랑 섹스 안 해!」
				PRINTFORMDW 마리사가 드디어 진정할 때까지 계속 사과해야 했다...
			CASE 2
				PRINTFORML 「너랑 그 큰 입이라니, 쯧...」
			CASE 3
				PRINTFORML 「...왜 그런 이상한 소리를 하는 거야, 변태 같아?!」
				PRINTFORMDW 마리사는 충격으로 눈을 크게 뜨며 소리친다.
			CASE 4
				PRINTFORML 「흥... 이상한 소리 안 할 때 더 좋아...」
			CASE 5
				PRINTFORML 「이런... 지금 꼭 그런 말을 해야 해?」
			CASE 6
				PRINTFORML 「우와아... 나 지금 너무 오글거려서 참을 수가 없어...」
				PRINTFORMW 「정말 그렇게 분위기를 망쳐야 했어?」
			CASE 7
				PRINTFORML 「...그런 말 같은 건 타이밍이 전부인 것 같아%K11_ZE("daze",1)%, 알잖아?」
				PRINTFORMW 「아니, 네가 그렇게 말해줘서 기쁘긴 하지만 여전히.」
			CASE 8
				PRINTFORML 「음... 이런 말을 이 시점에 하는 건 좀 무례하잖아%K11_ZE("daze")%.」
				PRINTFORMW 「그렇게 말할 수 있다고 해서 해야 한다는 뜻은 아니니까, 뭐...」
			CASE 9
				PRINTFORMW 「내 얼굴을 똑바로 보고 그런 말을 하다니, 나를 이렇게 느끼게 만드는 건 정말 대담하네 %SPLIT_G("grinding my teeth to dust:knocking your teeth out")%...」
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE IFRAND("0TO4", 1, "D0, D4", !TALENT:恋慕)
			CASE 0
				PRINTFORML 「…응, 나도 당신을 사랑해%K11_ZE()%!」
				PRINTFORMDW 마리사는 당신의 가슴에 파고들기 전에 말한다…
			CASE 1
				PRINTFORML 「오-아니... 그런 걸 들으니까 얼굴이 정말 빨개져 버려%K11_ZE()%...」
				PRINTFORMDW 마리사의 얼굴에서 김이 나는 게 거의 보일 지경이다...
			CASE 2
				PRINTFORML 「하하... 네가 나를 아첨하는 건 알지만, 그래도 기분은 좋아.」
				PRINTFORMDW 마리사는 얼굴을 상당히 붉히면서도 침착하게 말한다...
			CASE 3
				PRINTFORML 「그거 좀 별로였지만…」
				PRINTFORMW 「뭐, 괜찮겠지, 어쨌든%K11_ZE(,1)%。」
			CASE 4
				PRINTFORML 「흐-허? 내 이쪽 몸이... 당신 개인적인 용도로만 쓰여도 괜찮은 거야?」
				PRINTFORML 「내 말은... 당신이 내가 가진 유일한 연인이자, 내가 보는 유일한 %PRINT_MALE("boy", MASTER)%니까. 그리고 그건 조만간 변하지 않을 테니...」
				PRINTFORMW 「벌써 당신의 것이라는 뜻이야? 그게 네가 듣고 싶은 말이니 %K11_ZE()%? 뭐, 네가 행복하다면 됐어.」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
