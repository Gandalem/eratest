;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K11_140
CALL M_KOJO_MESSAGE_COM_K11_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORMW 「나를 강제로 삼키게 하고 싶어? 그럴 필요 없어. 난 그냥 보통 사람처럼 너에게 바람을 불어줄 수 있단 말이야%K11_ZE("daze",1)%, 알잖아?」
			PRINTFORMW 「하지만 강요당할 때 더 좋아해?... 정말이지.」
			PRINTFORMW 「%RANDLIPS()%...!!!」
		ELSE
			PRINTFORMDW 아무런 경고도 없이 마리사의 머리를 꽉 잡더니 %TINKO()% 그녀의 입 깊숙한 곳으로 밀어 넣는다!
			PRINTFORMW 「응?! %FSYN("lips_muffle")%~~!!! 크으윽, 콜록!! 응, 으음으음~!!!」
			PRINTFORMW (아, 싫어... 아파, 숨을 못 쉬겠어...)
			PRINTFORMW (%HIS_HER(MASTER,1)%의 성기가 내 목구멍 뒤쪽을 때리고 %HIS_HER(MASTER)%의 음부가 내 얼굴에 밀려 들어오는 게 구토할 것 같아...!?)
		ENDIF
		CALLF ONCE("DeepThroatLine")
		RETURN 1
	ENDIF
	IF TALENT:恋慕 && ONCE("DeepThroatLine") ;added
		PRINTFORMDL %BREAKENG(@"마리사는 한 손으로 네 %TINKO()%을 움켜쥐고 얼굴 가까이에 대고 바라보는데, 그 욕망과 감탄이 너무 커서 너는 조금 걱정되기 시작한다.")%
		PRINTFORMW 「와, 이거 정말 대단하다," 그녀가 말한다. "점점 커지고 있지 않아? 내 말은, 너무 힘들어%K11_ZE()%잖아」
		PRINTFORMDL 「와, 이거 정말 대단한데,"라고 그녀가 말한다. "점점 커지는 것 같지 않아? 내 말은, 정말 딱딱하게 굳었어%K11_ZE()%!」
		PRINTFORMDL %BREAKENG(@"그녀는 네 고환 중 하나를 입에 물고 부드럽게 깨문다. 그녀가 네 것을 얼굴에서 떼어내자 만족스러운 숨을 내쉬며 피부 위에 침 자국을 남긴다.")%
		PRINTFORMW 「좋아, 이제 본격적으로 시작하자, 네 최고의 실력을 보여줘!」
		PRINTFORMDW 마리사는 다시 당신의 성기에 입술을 대고, 당신은 골반을 앞으로 밀어내며 발기된 것을 그녀의 입안으로 밀어 넣는다.
		PRINTFORMDL 당신은 손으로 그녀의 머리를 제자리에 고정시키고, 그녀의 머리카락을 잡고 얼굴을 자신의 사타구니 쪽으로 밀어붙인다.
		PRINTFORMDL 그녀는 살짝 콜록거리며 바닥에 조금 토해내지만, 당신 전체를 삼키기 위해 최선을 다한다.
		PRINTFORMDL 마리사는 목을 조여 온 길이 완전히 들어갈 때까지 깊숙이 빨아들이고, 당신의 성기 밑부분만이 그녀의 따뜻하고 축축한 입 밖으로 남는다.
		PRINTFORMDW 그러고는 나머지 부분을 다시 아래로 밀어 넣으며 이번에는 더 빠르게 당신을 빨기 시작한다.
		PRINTFORML
	ENDIF
	IF RAND:6 ;filler
		FOR LOCAL, 0, 2
		PRINTFORMW 「%RANDLIPS(,(TALENT:恋慕 ? "heart:name" # "dot") )%...%SPLIT_G("!:?!:!!!")%」
		NEXT
		RETURN 1
	ENDIF
	IF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORML 「정말 강제로 받아들이는 걸 좋아하네... 뭐, 아무리 고통스럽더라도 내가 들어주지%K11_ZE(,1)%.」
			PRINTFORMW 「결국 나야말로 당신을 가장 사랑하는 사람이니까. 절대 잊지 마!」
		ELSEIF RAND:2
			$UP2
			PRINTFORML 「후후, 내가 처리해 줄게. 마음껏 밀어붙여 봐?」
			PRINTFORMDL 마리사는 입술을 깨물며 네 성기를 자극한다.
			PRINTFORMW 「%RANDLIPS()%...!」
		ELSE
			$UP
			PRINTFORML 「%RANDLIPS(, @"dot:name:charname_%GROAN()%_%GROAN()%_%GROAN()%_%GROAN()%")%...!」
			PRINTFORMDW 큰 불편함에도 불구하고 마리사는 당신을 배려하기 위해 최선을 다한다...
		ENDIF
	ELSE
		IF RAND:2
			SIF ABL:マゾっ気 >= 6
				GOTO UP2
			PRINTFORML 「응?! %FSYN("lips_muffle")%~~~~!!! 윽, 기침이야!!! 응, 으음으음~!!!」
			PRINTFORML (%HE_SHE(MASTER,1)%가 또 나를 몰아붙이고 있어... 정말 질렸어... 난 아무것도 원치 않아...!)
			PRINTFORMW (%HIS_HER(MASTER,1)%의 성기가 목구멍을 후벼 파고 %HIS_HER(MASTER)%의 음모가 내 얼굴에 밀려 들어와... 모든 게 구토하고 싶게 만들어...!)
		ELSE
			SIF ABL:マゾっ気 >= 6
				GOTO UP
			PRINTFORMW 「%FSYN("lips_muffle")%?! 기침... 크윽...! 뭐, 도대체 뭐야... %SPLIT_G("you think you're doing:was that for")%...?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;144,放尿
;==================================================

@M_KOJO_MESSAGE_COM_K11_144
CALL M_KOJO_MESSAGE_COM_K11_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF EXP:放尿経験 >= 30
		IF RAND:2
			PRINTFORMW 「하아... 아아... 후와아아...!」
			PRINTFORMW 「모두... 전부 네 잘못이야... 네가 나를 %K11_ZE()% 온통 소변을 지리게 만든 원인이니까...!」
			PRINTFORMW 「어쨌든, 다 네 잘못이라고, 알겠지? 그러니까 내가 너한테 책임을 돌릴 거야. 그리고 뒷정리는 네가 하게 될 거라고!」
		ELSE
			PRINTFORMW 「A-당신 괜찮으세요...? 제가 당신 앞에서 소변을 보는 수치스러운 여자라는 걸 개의치 않으셔도 되나요?」
			PRINTFORMW 「...알겠어요. 그렇게 말씀하시니, 원하신다면 마음껏 저를 보셔도 돼요%K11_ZE(,4)%。」
		ENDIF
	ELSE
		IF RAND:4 == 0
			PRINTFORML 「안 돼, 제발, 이런 건 싫어... 나 보지 마...!」
			PRINTFORMW 「소변을 멈출 수가 없어...! ...나를 이렇게 쳐다보지 마...!」
		ELSEIF RAND:3 == 0
			PRINTFORML 「나-나는 명령대로 소변을 볼 수 없어, 그렇게 작동하는 게 아니야%K11_ZE(,1)%!」
			PRINTFORML 「당신이 보고 있을 때 할 수가 없어-- 어떡해... 무언가 나오고 있어!!!」
			PRINTFORMW 「안 돼, 보지 마아...!!!」
		ELSEIF RAND:2
			PRINTFORML 「스-멈춰줘, 하지 마...! 돌아봐...!」
			PRINTFORMW 「흐윽, 훌쩍... 우에에히...! 이 나이에 내가 실수를 하다니 믿을 수가 없어...!」
		ELSE
			PRINTFORML 「나... 안 돼...! 쳐다보지 마...!」
			PRINTFORMW 「그게 네가 생각하는 게 아니야... 난 스스로 오줌 지리는 그런 더러운 애가 아니라고...!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K11_150
CALL M_KOJO_MESSAGE_COM_K11_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF RAND:6 ;filler moans
		FOR LOCAL, 0, 2
		PRINTFORML 「%MOAN("l" + (TALENT:恋慕 || ( MARK:不埒刻印 == 3 && !RAND:3) ? ":m" # ""),, (TALENT:恋慕 ? RAND(3,7) # RAND(2, 5 )), (TALENT:恋慕 ? "heart:name" # "rand") )%...%SPLIT_G("!:?!:!!!:::")%」
		NEXT
		WAIT
		RETURN 1
	ENDIF
	IF ABL:マゾっ気 >= 6 && RAND:3
		IF RAND:2 && TALENT:恋慕
			PRINTFORML 「더... 나에게 좀 더 폭력적으로 해줘%K11_ZE("daze")%!」
			PRINTFORMW 「천천히 해... 내가 바로잡을 테니, 나한테 맡겨도 돼, 알겠지?」
		ELSE
			PRINTFORML 「%MOAN()%...! 이렇게 난 내 가슴골을 야만적으로 범하는 게 기분 좋은 걸까?」
			PRINTFORMW (하지만 궁금해지기 시작했다... 왜 이렇게 못 대접받는 것이 그렇게 기분이 좋을까...?)
		ENDIF
	ELSEIF TALENT:恋慕
		PRINTDATAW
			DATAFORM 「흐읍-헤이, 진정해... 더 밀지 마...」
			DATAFORM 「하지만 평소처럼 할 수도 있어...」
			DATAFORM 「앗-아파... 부디, 좀 더 부드럽게 해줘%K11_ZE()%...」
			DATAFORM 「진정해, 아무도 %HIS_HER(MASTER)% 자신의 이익에 너무 목마른 %PRINT_MALE("man", MASTER)%를 좋아하지 않아...」
		ENDDATA
	ELSE
		PRINTDATAW
			DATAFORM 「안 돼, 그만해... 그렇게 많이 밀어 넣지 마!」
			DATAFORM 「아야, 아파...! 내 %FSYN("chest:non")%은 이게 아니야%K11_ZE()%!」
			DATAFORM 「내 %FSYN("chest")%으로 뭘 하려는 거야?」
			DATAFORM 「그게 여자들의 자존심과 기쁨인 그녀의 %FSYN("chest")%을 대하는 방식이야?」
		ENDDATA
	ENDIF
ENDIF
RETURN 1
