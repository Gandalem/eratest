;626,土産屋 gift shop
;added, based on hatate / lines from tohoJ/og
;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================
;映姫様口上作者様から拝借しました。いつもすみません
;==================================================
@M_KOJO_MESSAGE_COM_K11_626
CALL M_KOJO_MESSAGE_COM_K11_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;贈っていたら本体名と属性を取得しておく
	IF TFLAG:194 > 0
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:11:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 身につける
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
	ENDIF
	
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
		
	SELECTCASE TFLAG:194
	;ひやかし
	CASE -2
		IF (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou
			PRINTFORML 「Geh, Kourin, what's with the short fuse? You know how long I like to stick around when I swing by%K11_ZE("daze")%!」
			PRINTFORML 「Could it be that you're just jealous that I brought my date with me?」
			PRINTFORML 「...Oh boy, he's real pissed, his face got so wrinkly he looks like a Buddha now. Let's go, %CALLNAME:MASTER%.」
		ELSE
			PRINTFORML 「Uh oh! Run, %CALLNAME:MASTER%, ruuuuuun!」
			PRINTFORML 「She's pissed! She's soooo totally pissed%K11_ZE("daze")%!!!」
		ENDIF
	;やっぱりやめる（見送り）
	CASE -1
		IF MONEY >= 10000 && FIRSTTIME("MarisaMimaDolly")
			PRINTFORMDW Just before you're about to leave, Marisa finds a doll that looked oddly similar to Mima...
			PRINTFORMDW The price tag on it was rather expensive, so you decide it'd be better to put it back.
			PRINTFORMDW "Hand over the dolly," you plead with Marisa. But...
			PRINTFORML 「No!」
			PRINTFORMDW ...She yelps back like a child, squeezing the doll closer to her chest. Sigh...
			PRINTFORMDW Forced to make a purchase, you acquire the doll for her, as she grins from ear to ear. She's happy, at least...
			CALL PAY_MONEY_YEN(10000, 2)
			BASE:TARGET:ムード += 500
			CALL CHANGE_CFLAG(2, TARGET, 100)
			CALL CHANGE_CFLAG(4, TARGET, 30)
		ENDIF
	;400点未満（BAD）
	CASE 1
		IF nPrice >= 30000
			PRINTFORML 「Such an expensive thing to get... Still, I ain't sure how to react to this.」
			PRINTFORMW 「Well, I'll accept it out of courtesy at least%K11_ZE()%.」
		ELSEIF strReaction == "身につける"
			PRINTFORML 「By the way, did you choose these clothes from your own taste?」
			PRINTFORML 「.........」
			PRINTFORMDW Marisa turns her attention to you as if trying to find out your true intentions...
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「...This ain't really my thing though.」
				CASE 1
					PRINTFORML 「Oi-oi, this %strGift% is a little chipped here%K11_ZE()%...」
					PRINTFORMW 「Are you getting at something with this?」
				CASE 2
					PRINTFORMW 「Mmm... Gee, no offense, I appreciate a good gift, but this just seems lazy. Like a copout, you know?」
			ENDSELECT
		ENDIF
	;400点～699点（NOMAL）
	CASE 2
		IF nPrice >= 30000
			PRINTFORML 「Oh, thanks a bunch!」
			PRINTFORMW 「Maybe it's 'cause I've always been a loaner, but I ain't used to being given things, 'specially this expensive!」
		ELSEIF strReaction == "身につける"
			IF RAND:2
				PRINTFORML 「Good call. As you know, I basically only ever wear black and white.」
				PRINTFORMW 「So I'll try it on when I feel like it!」
			ELSE
				PRINTFORMW 「Weeell, I guess wearing clothes like this is good for you sometimes!」
			ENDIF
		ELSE
			IF RAND:2
				PRINTFORMW 「Uh, thanks!」
				PRINTFORMW 「I'll take good care of it%K11_ZE()%!」
			ELSE
				PRINTFORMW 「Hey, cheers!」
				PRINTFORMW 「I'm sorry to put you on the spot, but I appreciate it!」
			ENDIF
		ENDIF
	;700点以上（GOOD）
	CASE 3
		;形容詞+本体名を取得
		CALL GIFTNAME(TCVAR:11:今日の贈り物)
		IF nPrice >= 30000
			PRINTFORML 「Wow, isn't that pretty expensive? Who are you giving it to?」
			PRINTFORML 「Wha-- Me...? U-Um, th-thank you...」
			PRINTFORMDW Marisa seems unusually flustered.
		ELSE
			PRINTFORML 「Oooh, I've always wanted one of these!」
			PRINTFORMW 「Looks like you got a good grasp on my preferences, eh? Hehehe～」
		ENDIF
		PRINTFORML
		SELECTCASE strReaction
		CASE "眺める"
			IF GET_GIFTDATA(TCVAR:今日の贈り物, "形容詞") == 504 ;星型の
				PRINTFORML 「A star-shaped accessory, huh? It sure fits my image perfectly.」
				PRINTFORMW 「Well, uh... thank you.」
			ELSE
				PRINTFORMDW Marisa seems very happy and excited from the gift she has received from you.
			ENDIF
		CASE "抱く"
			PRINTFORML 「Waaaah! Thank you so much, %CALLNAME:MASTER%!」
			PRINTFORMDW Marisa exclaims, hugging the object to her chest.
		CASE "握る"
			PRINTFORMW 「Would this make me twice as attractive? Hehehe, I sure hope so!」
		CASE "身につける"
			PRINTFORML 「I always wear black and white, so it might be nice to change it up once in a while.」
			PRINTFORML 「It looks so cool and stylish, and snazzy to boot!」
			PRINTFORML 「What do you think? Does it look good on me?」
			PRINTFORMW 「Yeah? I-I, umm... Thank you.」
		ENDSELECT
	ENDSELECT
	PRINTW
	;good-great gift, see if special gifts weren't bought yet (they're all free actually)
	IF GROUPMATCH(TFLAG:194, 2,3) && ( FIRSTTIME("MarisaGiftClothes", 1) || FIRSTTIME("MarisaGiftApron", 1) || FIRSTTIME("MarisaGiftGrimoire", 1) || (FIRSTTIME("MarisaGiftLingerie", 1) && !FIRSTTIME(189, 1)) )
		PRINTFORMDW While you're at it, how about purchasing something special for Marisa?
		PRINTL 
		SIF FIRSTTIME("MarisaGiftClothes", 1)
			PRINTDL [ 0] Stylish clothes
		SIF FIRSTTIME("MarisaGiftApron", 1)
			PRINTDL [ 1] Maid apron
		SIF FIRSTTIME("MarisaGiftGrimoire", 1)
			PRINTDL [ 2] Grimoire
		SIF (FIRSTTIME("MarisaGiftLingerie", 1) && !FIRSTTIME(189, 1))
			PRINTDL [ 3] Lingerie
		PRINTDL
		PRINTDL [99] Cancel
		$INPUT_LOOPME
		INPUT
		;普通の服
		SELECTCASE RESULT
			CASE 0
				SIF !FIRSTTIME("MarisaGiftClothes", 1)
					GOTO INPUT_LOOPME
				PRINTFORML 
				PRINTFORMW 「Whoa, that fits me to a tee, doesn't it?」
				PRINTFORMDW You couldn't help but grin at Marisa wearing a different outfit than usual.
				PRINTFORMW 「What, you like it? Heh～」
				IF !FIRSTTIME("MarisaGiftApron", 1)
					PRINTFORMW 「Y'know, you gotta dress me in normal clothes like this some more.」
					PRINTFORMW 「I mean, it's not that I don't like maid outfits either, but it just feels refreshing somehow... Something like that.」
				ENDIF
				CALLF FIRSTTIME("MarisaGiftClothes")
			CASE 1
				SIF !FIRSTTIME("MarisaGiftApron", 1)
					GOTO INPUT_LOOPME
				PRINTFORML 
				PRINTFORMW 「I-Is this... what you want me to wear?」
				PRINTFORMDW Marisa turns red in the face after you present her with a maid outfit...
				PRINTFORMW 「W-Well, umm... I might wanna wear it... when I feel like it... yeah.」
				PRINTFORMDW It's odd how flustered she becomes, even though this outfit is not any different from the usual stuff she wears.
				PRINTFORMW 「...Look.」
				PRINTFORMW 「Even if you alter the color just a little bit, or tweak the shape slightly...」
				PRINTFORMW 「It carries a big difference, alright? Sheesh, look at you, you're one kinky "Master", ain'tcha?」
				PRINTFORMDW Now you're just even more confused...
				CALLF FIRSTTIME("MarisaGiftApron")
			CASE 2
				SIF !FIRSTTIME("MarisaGiftGrimoire", 1)
					GOTO INPUT_LOOPME
				PRINTFORMDW "Black magic and analytical philosophy"... This is a book Marisa might like.
				PRINTFORMDW Magicians sure spend a lot of time reading these kinds of difficult books, huh.
				PRINTFORMDW They must be really smart, because it all looks gibberish to you.
				PRINTFORMW 「Whoaaaa!!! That's the elusive grimoire I could never find at Patchouli's! How did it even get here?!」
				PRINTFORMW 「Truth is, I've had my eye on this book recently! And you're gifting it to me? Hehe, thank you sooo much, %CALLNAME:MASTER%～」
				PRINTFORMW 「I don't mind a person who knows how to get on my good side%K11_ZE("daze",1)%!」
				
				CALLF FIRSTTIME("MarisaGiftGrimoire")
			CASE 3
				SIF !FIRSTTIME("MarisaGiftLingerie", 1) || FIRSTTIME(189, 1)
					GOTO INPUT_LOOPME
				PRINTFORMDW Remembering your last session of Apron Play, you wonder if there are other things you can dress Marisa in.
				PRINTFORMDW And sure enough, there was... Oh, this is perfect!
				PRINTFORMW 「Hey, what are you... Hey!」
				PRINTFORMDW Marisa emerges shortly, flustered and bewildered, gritting her teeth and blushing to her ears.
				PRINTFORMDW %BREAKENG(@"Wearing nothing but an assortment of white belts, frills and ribbons on her naked frail body, with white gloves on her little hands and white stockings supported by garter belts - it looks scandalously arousing, but not any less cute at the same time.")%
				PRINTFORMDW %BREAKENG(@"It's made even cuter by the extraordinary reaction Marisa herself provides, hiding her inflamed, flushing cheeks with her hat while giving you a glare of thousand deaths, yet making no attempt to cover up her body or change.")%
				PRINTFORMW 「A-Are you... out of your mind? Do you honestly... intend me to wear all this?! Y-You perv--...」
				PRINTFORMDW But it does cover all the important bits. Whatever problem anyone may have with it is clearly within their own head.
				PRINTFORMW 「It sure does cover me up, but... it also makes me wanna drop dead on the spot! I ain't wearin' this in front of anyone else... but you!」
				PRINTFORMW 「That's my condition%K11_ZE()%!」
				PRINTFORMDW Even little princesses have their own little caprices. So be it, you sigh with a smile, feeling like you made a great purchase today.
				
				CALLF FIRSTTIME("MarisaGiftLingerie")
			CASE 99
				RETURN 1
		CASEELSE
			GOTO INPUT_LOOPME
		ENDSELECT
		BASE:TARGET:ムード += 350
	ENDIF
		
ENDIF
RETURN 1

