LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	;TARGETとデート
	IF CFLAG:同行
		IF TALENT:恋慕
			SIF CFLAG:ブチギレ || MARK:反発刻印 ;added
				GOTO ANGERY
			PRINTFORML 「Fufu, asking me out on a date I see...」
			PRINTFORML 「You graciously invited me, so of course I'll take you up on it!」
			PRINTFORMW 「Now then, where to?」
		ELSE
			IF FIRSTTIME("MarisaGoOut")
				PRINTFORML 「You wanna go out with me, just the two of us? Wait, isn't that...」
				PRINTFORMW 「But since you're insisting on inviting me... Alright, let's go%K11_ZE(,1)%!」
			ELSEIF CFLAG:ブチギレ || MARK:反発刻印
				$ANGERY
				PRINTFORML 「A date? With you? Hmph, normally I'd say thanks, but no thanks...」
				PRINTFORML 「But since you're trying to make it up to me, it'd be cruel to never give you a chance.」
				PRINTFORMW 「Alright, I'll bite. But you'll have to work extra hard this time, you hear%K11_ZE(,1)%?」
				RETURN 1
			ELSE ;added
				PRINTFORML 「Go out together like the last time?」
				PRINTFORMW 「Oh, I'd love to%K11_ZE()%! Let's go, there's plenty of places left unexplored!」
			ENDIF
		ENDIF
	;TARGET以外とデート
	ELSEIF CFLAG:MASTER:同行
		IF TALENT:恋人
			PRINTFORML 「Hell, even I'd have a problem seeing you asking another woman out on a date in front of your own girlfriend.」
			PRINTFORMW 「Sigh... Fine I guess, have it your way. But we better go on a date next time%K11_ZE(,1)%, alright?」
		ELSEIF TALENT:恋慕
			PRINTFORML 「Eh? Aah, I see, you're going on a date with that gal...」
			PRINTFORMW 「Hopefully you'll ask me out next time%K11_ZE()%! I'd love to hang out with you.」
		ELSE
			PRINTFORMW 「Humm, I see you're going on a date, eh? %SPLIT_G("Have a good time:Have fun:Enjoy yourselves out there")%!」
		ENDIF
	;お出かけお見送り
	ELSE
		IF TALENT:恋人
			PRINTFORML 「Eehh～? You're going out on your own?」
			PRINTFORMW 「I'd like to go with you, but... oh well, you better take me out on a date next time%K11_ZE()%!」
		ELSEIF TALENT:恋慕
			PRINTFORML 「Aww man, you're going out alone...?」
			PRINTFORMW 「%SPLIT_G("I'd love to come with you:I hoped you'd take me with you")%, but oh well... It's not like I have a say in these things.」
		ELSE
			PRINTFORMW 「Oh, going out somewhere? %SPLIT_G("Have a good time:Have fun:Enjoy yourself out there")%!」
		ENDIF
	ENDIF
	
	SIF !CFLAG:同行
		RETURN 1
	;added
	IF FIRSTTIME("DatingMarisa") && !(CFLAG:ブチギレ || MARK:反発刻印)
		PRINTFORML
		IF !EXP:MASTER:デート経験
			PRINTFORML 「Hey, what's with the rush, %CALLNAME:MASTER%? We're gonna make it in time just fine%K11_ZE(,1)%, relax!」
			PRINTFORML 「Oh, it's your first time dating a girl? Hmmm...」
			PRINTFORMDW Marisa giggles a little, slapping her knee with her palm.
			PRINTFORML 「Still, I can't believe you've never gone on a date before. I was sure you were quite popular!」
			PRINTFORML 「Come on, don't be afraid of me. I'm not the type of gal to go running out the door if you say anything bad to me, am I?」
			PRINTFORML 「Just treat me as you've always did. 'Sides, if you wanna mess up, you could at least try saying something funny... like a joke!」
			PRINTFORMDW Marisa says, smiling cheerfully. She really does have a way of calming you down. You notice her blush for some reason however.
			PRINTFORMW 「And, um, y'know... I've never gone on a date with anybody before either, so we're on the same boat, pretty much.」
			PRINTFORML
		ENDIF
		PRINTFORML 「Oh, and by the way, Gensokyo's pretty dangerous when it comes to some places.」
		PRINTFORML 「But worry not, no place is dangerous for today's me!」
		PRINTFORMW 「I'll protect you if it comes to that%K11_ZE()%! Leave it to me～!」
		RETURN 1
	ENDIF
	;added from tohoJ
	PRINTFORML
	;イベント判定
	;初詣（元旦かつ恋人or恋慕で博麗神社）
	IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 0 && DATENAME_PLACE(1) == "博麗神社"
		PRINTFORMDL You head to Hakurei shrine for a first shrine visit of New Year, with Marisa wearing an elegant kimono...
		PRINTFORML 「This shrine gets rather crowded during the first day of the year...」
		IF TALENT:恋人
			PRINTFORML 「Two bows and two claps... May I live happily with you, and not just this year alone, but for many years to come.」
			PRINTFORMDL You stand next to Marisa and clasp your hands, wishing for the same thing she did...
		ELSE
			PRINTFORML 「Two bows and two claps... May I live happily with you for another year.」
			PRINTFORMDL You stand next to Marisa and clasp your hands, wishing that you and her could have a good time together this year as well.
		ENDIF
		PRINTFORMW 「C'mon, let's go draw some Omikuji%K11_ZE()%!」
		RETURN 1
	;例大祭（例大祭の日かつ恋人or恋慕で博麗神社）
	ELSEIF DAY:2 == 1 && DAY:3 == 25 && DATENAME_PLACE(1) == "博麗神社"
		IF TALENT:恋人
			PRINTFORMDL You arrive at the Reitaisai, going hand in hand with Marisa dressed in a yukata...
			PRINTFORML 「There's all kinds of stalls this year too...」
			PRINTFORML 「Oh, a target practice! Why don't we have a match together?」
			PRINTFORMDL Still holding your hand, Marisa turns a big smile towards you...
		ELSE
			PRINTFORMDL You arrive at the Reitaisai with Marisa in a yukata...
			PRINTFORML 「There's all kinds of stalls this year too...」
			PRINTFORML 「Oh, takoyaki! And sauce crackers!」
			PRINTFORMDL Marisa yanks on your hand and dashes off...
		ENDIF
		PRINTFORMW 「It's a once-a-year festival, and you'd be remiss if you didn't enjoy it%K11_ZE(,1)%, you know?」
		RETURN 1
	ENDIF
	;ポニテ判定（服をプレゼントしたことがあるか）
	IF TALENT:恋慕 && RAND:2 && !FIRSTTIME("MarisaGiftClothes", 1)
		PRINTFORML 「...So-Sorry to keep you waiting.」
		PRINTFORMDW Marisa changed into the clothes that you had given her earlier and put her hair in a ponytail...
		PRINTFORML 「I should at least get dressed up for a d-date, yeah?」
		PRINTFORMDW Even though she was wearing a different outfit from the usual, she still looked very cute...
