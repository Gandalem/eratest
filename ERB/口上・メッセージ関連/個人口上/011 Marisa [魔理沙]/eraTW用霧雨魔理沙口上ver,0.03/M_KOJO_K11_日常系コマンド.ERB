;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================
@M_KOJO_MESSAGE_COM_K11_301
CALL M_KOJO_MESSAGE_COM_K11_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋慕 ;added
		PRINTFORML 「Your tea sure is nice.」
	ELSE
		PRINTFORML 「Hmm, tea, for me? Thanks, don't mind if I do%K11_ZE()%!」
	ENDIF
	IF TFLAG:193 == -1
		IF RAND:2 ;added
			PRINTFORML 「Though while I appreciate the sentiment, it's kind of a bummer%K11_ZE("daze")%...」
			PRINTFORMW 「Hmmm... I think I'd better make some myself at this rate.」
		ELSE
			PRINTFORML 「Humm, that's a bit too bitter for my taste.」
			PRINTFORMW 「Looks like you'll have to practice this one some more, %CALLNAME:MASTER%.」
		ENDIF
	ELSEIF TFLAG:193 == 0
		IF RAND:2 ;added
			PRINTFORML 「Hmm, not bad. I guess the stuff you serve to others ain't all that lacking.」
			PRINTFORMW 「I can make tea too%K11_ZE()%, though I'm more into Japanese cuisine.」
		ELSE
			PRINTFORMW 「Huh, this ain't half bad at all...」
		ENDIF
	ELSE
		IF RAND:2 ;added
			PRINTFORML 「Oooh, this is great, and the sweets and stuff are also a nice touch!」
			PRINTFORML 「This sure is nice, maybe I should get you to make me tea like this every day...」
			PRINTFORMW 「Hahaha, just kidding.」
		ELSE
			PRINTFORMW 「Ooh, this sure is delicious! I'm gonna like this one a lot%K11_ZE()%...」
		ENDIF
	ENDIF

ENDIF
RETURN 1
