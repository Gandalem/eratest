	ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置, 1) ;library
		PRINTFORML 「Ooh, %NAME_FROM_PLACE(CFLAG:MASTER:現在位置)% then, eh? I hear we can borr- Err, I mean, read some books there%K11_ZE("daze")%!」
		PRINTFORMW 「Well then, let's go!」
	ENDIF
