;==================================================

@M_KOJO_SUCCESS_COM_K11_356
;成否判定
;TFLAG:192(-1＝強制失敗、0=COM依存、1=強制成功
TFLAG:192 =0
SIF MARK:反発刻印 >= 3 || CFLAG:ブチギレ
	TFLAG:192 = -1

@M_KOJO_MESSAGE_COM_K11_356
CALL M_KOJO_MESSAGE_COM_K11_356_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_356_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTL
	IF TFLAG:192 == -1 || MARK:反発刻印 >= 3 || CFLAG:ブチギレ
		PRINTFORMDL 마리사는 아무 말 없이 당신을 그저 노려본다.
		PRINTFORMDW 하지만 그녀의 분노는 거의 느껴질 정도였다...
		TCVAR:11:392++
		RETURN 1
	ENDIF
	;失敗
	IF TFLAG:193 == -1
		PRINTFORML 「와 거기 서! 제발 좀 그만해! 이건 안 돼, 절대 안 돼!」
		PRINTFORMW 「그냥 방 하나 잡고 침대에서 편안하게 쉬자, 알았지?」
		;成功
	ELSE
		CALL K11_WOOHOO_SPOTCHECK
		IF RESULT
		ELSE
			;added from tohoJ
			PRINTFORMDL 당신은 마리사를 시선이 닿지 않는 외진 곳으로 데려간다.
			PRINTFORML 「너-넌 여기서 이걸 하고 싶어?」
			PRINTFORML 「하지만 %SPLIT_G("I don't think I can keep my voice down:They might hear me moan")% 너무 격하게 하면, 알잖아...」
			PRINTFORMDL 하지만 그녀 자신의 말에도 불구하고 마리사는 이 특이한 상황에 약간 흥분한 듯하다.
			PRINTFORMDW 그러고는 그녀는 옷을 벗기 시작하고, 당신도 벌거벗는다!
		ENDIF
	ENDIF
ENDIF
