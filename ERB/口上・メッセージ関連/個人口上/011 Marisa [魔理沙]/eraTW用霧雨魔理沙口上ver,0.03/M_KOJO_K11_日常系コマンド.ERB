;626,土産屋 gift shop
;added, based on hatate / lines from tohoJ/og
;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================
;映姫様口上作者様から拝借しました。いつもすみません
;==================================================

@M_KOJO_MESSAGE_COM_K11_626
CALL M_KOJO_MESSAGE_COM_K11_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;贈っていたら本体名と属性を取得しておく
	IF TFLAG:194 > 0
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:11:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 身につける
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
	ENDIF
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			IF (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou
				PRINTFORML 「이봐, 쿠우린, 왜 그렇게 성급해? 내가 들를 때 얼마나 오래 머물고 싶은지 너도 알잖아%K11_ZE("daze")%!」
				PRINTFORML 「혹시 내가 데리고 온 여자친구 때문에 질투하는 거야?」
				PRINTFORML 「...세상에, 정말 화가 많이 났네. 얼굴이 너무 잔주름으로 주름져서 지금 부처님처럼 생겼어. 가자, %CALLNAME:MASTER%.」
			ELSE
				PRINTFORML 「어쩌지! 도망쳐, %CALLNAME:MASTER%, 부르르릉!」
				PRINTFORML 「그녀가 화났어! 그녀가 정말로 완전 화났다고%K11_ZE("daze")%!!!」
			ENDIF
			;やっぱりやめる（見送り）
		CASE -1
			IF MONEY >= 10000 && FIRSTTIME("MarisaMimaDolly")
				PRINTFORMDW 떠나기 직전, 마리사는 미마와 기묘하게 닮은 인형을 발견한다...
				PRINTFORMDW 가격표가 상당히 비쌌기에, 당신은 그것을 제자리에 두는 편이 낫다고 결정한다.
				PRINTFORMDW "인형을 넘겨줘," 당신은 마리사에게 애원한다. 하지만...
				PRINTFORML 「No!」
				PRINTFORMDW 그녀는 아이처럼 움찔거리며 인형을 가슴 쪽으로 더 꼭 끌어안는다. 한숨...
				PRINTFORMDW 구매를 강요받아, 당신은 그녀가 귀에서 귀까지 미소 짓자 그녀를 위해 그 인형을 얻는다. 적어도 그녀는 행복해 보인다...
				CALL PAY_MONEY_YEN(10000, 2)
				BASE:TARGET:ムード += 500
				CALL CHANGE_CFLAG(2, TARGET, 100)
				CALL CHANGE_CFLAG(4, TARGET, 30)
			ENDIF
			;400点未満（BAD）
		CASE 1
			IF nPrice >= 30000
				PRINTFORML 「이렇게 비싼 걸 받다니... 그래도 어떻게 반응해야 할지 모르겠네.」
				PRINTFORMW 「뭐, 일단 예의상 받아야지%K11_ZE()%.」
			ELSEIF strReaction == "身につける"
				PRINTFORML 「그건 네 취향으로 고른 옷이야?」
				PRINTFORML 「.........」
				PRINTFORMDW 마리사는 당신의 진정한 의도를 알아내려는 듯 당신에게 시선을 돌린다.
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「...이건 정말 내 취향은 아닌 것 같아.」
					CASE 1
						PRINTFORML 「오이, 이 %strGift%는 여기 조금 깨졌네%K11_ZE()%……」
						PRINTFORMW 「이걸로 뭔가 하려는 거야?」
					CASE 2
						PRINTFORMW 「음... 있잖아, 기분 나쁘게 말하려는 건 아닌데, 좋은 선물은 고맙게 받지만 이건 좀 대충 만든 것 같아. 회피하는 느낌이랄까?」
				ENDSELECT
			ENDIF
			;400点～699点（NOMAL）
		CASE 2
			IF nPrice >= 30000
				PRINTFORML 「아, 정말 고마워!」
				PRINTFORMW 「내가 늘 빌려 쓰는 사람이었기 때문일지도 모르지만, 특히 이렇게 비싼 걸 받는 건 익숙하지 않아!」
			ELSEIF strReaction == "身につける"
				IF RAND:2
					PRINTFORML 「좋은 선택이야. 너도 알다시피 난 기본적으로 검은색이랑 흰색만 입거든.」
					PRINTFORMW 「그래서 기분 날 때 한번 입어볼게!」
				ELSE
					PRINTFORMW 「음, 이런 옷을 입는 것도 가끔은 너한테 좋을 거야!」
				ENDIF
			ELSE
				IF RAND:2
					PRINTFORMW 「어, 고마워!」
					PRINTFORMW 「내가 잘 돌볼게%K11_ZE()%!」
				ELSE
					PRINTFORMW 「안녕, 고마워!」
					PRINTFORMW 「갑자기 부탁해서 미안하지만, 정말 고맙게 생각해!」
				ENDIF
			ENDIF
			;700点以上（GOOD）
		CASE 3
			;形容詞+本体名を取得
			CALL GIFTNAME(TCVAR:11:今日の贈り物)
			IF nPrice >= 30000
				PRINTFORML 「와, 그거 엄청 비싼 거 아니야? 누구한테 주는 거야?」
				PRINTFORML 「뭐-- 나...? 음, 고마워...」
				PRINTFORMDW 마리사는 평소보다 유난히 당황한 듯했다.
			ELSE
				PRINTFORML 「오오, 난 항상 이런 걸 갖고 싶었어!」
				PRINTFORMW 「내 취향을 잘 파악하고 있네, 응? 헤헤헤~」
			ENDIF
			PRINTFORML
			SELECTCASE strReaction
				CASE "眺める"
					IF GET_GIFTDATA(TCVAR:今日の贈り物, "形容詞") == 504 ;星型の
						PRINTFORML 「별 모양의 액세서리라니? 정말 내 이미지에 딱 어울리는군.」
						PRINTFORMW 「음, 저기... 고마워요.」
					ELSE
						PRINTFORMDW 마리사는 당신에게 받은 선물에 대해 매우 행복하고 들뜬 듯했다.
					ENDIF
				CASE "抱く"
					PRINTFORML 「와아! 정말 고마워요, %CALLNAME:MASTER%!」
					PRINTFORMDW 마리사는 그 물건을 가슴에 안고 외쳤다.
				CASE "握る"
					PRINTFORMW 「이걸 하면 두 배로 매력적일까? 헤헤, 정말 그랬으면 좋겠어!」
				CASE "身につける"
					PRINTFORML 「나는 항상 흑백을 입으니까 가끔은 바꿔보는 것도 좋을 것 같아.」
					PRINTFORML 「정말 멋지고 스타일리시하고 게다가 세련되어 보여!」
					PRINTFORML 「어때? 나한테 잘 어울려 보이니?」
					PRINTFORMW 「응? 저... 음... 고마워.」
			ENDSELECT
	ENDSELECT
	PRINTW
	;good-great gift, see if special gifts weren't bought yet (they're all free actually)
	IF GROUPMATCH(TFLAG:194, 2,3) && ( FIRSTTIME("MarisaGiftClothes", 1) || FIRSTTIME("MarisaGiftApron", 1) || FIRSTTIME("MarisaGiftGrimoire", 1) || (FIRSTTIME("MarisaGiftLingerie", 1) && !FIRSTTIME(189, 1)) )
		PRINTFORMDW 이왕 온 김에 마리사에게 줄 특별한 걸 사보는 건 어때?
		PRINTL 
		SIF FIRSTTIME("MarisaGiftClothes", 1)
			PRINTDL [ 0] 스타일리시한 옷
		SIF FIRSTTIME("MarisaGiftApron", 1)
			PRINTDL [ 1] 메이드 앞치마
		SIF FIRSTTIME("MarisaGiftGrimoire", 1)
			PRINTDL [ 2] 그리모어
		SIF (FIRSTTIME("MarisaGiftLingerie", 1) && !FIRSTTIME(189, 1))
			PRINTDL [ 3] 란제리
		PRINTDL
		PRINTDL [99] 취소
		$INPUT_LOOPME
		INPUT
		;普通の服
		SELECTCASE RESULT
			CASE 0
				SIF !FIRSTTIME("MarisaGiftClothes", 1)
					GOTO INPUT_LOOPME
				PRINTFORML 
				PRINTFORMW 「와, 딱 맞지 않아?」
				PRINTFORMDW 당신은 마리사가 평소와 다른 옷을 입고 있는 모습을 보며 미소를 지을 수밖에 없었다.
				PRINTFORMW 「뭐야, 좋아? 헤헤～」
				IF !FIRSTTIME("MarisaGiftApron", 1)
					PRINTFORMW 「있잖아, 나 이런 평범한 옷을 좀 더 입혀주곤 해야 해.」
					PRINTFORMW 「뭐, 메이드 복장이 싫은 건 아니지만, 그냥 뭔가 상쾌한 느낌이랄까... 그런 거야.」
				ENDIF
				CALLF FIRSTTIME("MarisaGiftClothes")
			CASE 1
				SIF !FIRSTTIME("MarisaGiftApron", 1)
					GOTO INPUT_LOOPME
				PRINTFORML 
				PRINTFORMW 「이-이게 내가 입길 원하는 거야?」
				PRINTFORMDW 마리사는 메이드 복장을 건네자 얼굴을 붉혔다.
				PRINTFORMW 「저, 음... 기분이 들 때 입고 싶을지도 몰라... 응.」
				PRINTFORMDW 이 옷이 평소 그녀가 입는 것과 다를 바 없는데도 그녀가 당황하는 게 이상했다.
				PRINTFORMW 「...봐.」
				PRINTFORMW 「색깔을 조금 바꾸거나, 모양을 살짝 손보더라도...」
				PRINTFORMW 「큰 차이가 난다고? 이런, 너 정말 변태적인 "마스터"구나, 안 그래?」
				PRINTFORMDW 이제 당신은 더욱 혼란스러울 뿐이다...
				CALLF FIRSTTIME("MarisaGiftApron")
			CASE 2
				SIF !FIRSTTIME("MarisaGiftGrimoire", 1)
					GOTO INPUT_LOOPME
				PRINTFORMDW "흑마법과 분석철학"... 마리사가 좋아할 만한 책이네.
				PRINTFORMDW 마술사들은 이런 어려운 책들을 정말 많이 읽는구나, 그렇지.
				PRINTFORMDW 전부 너한테는 외계어처럼 보일 테니, 그들은 정말 똑똑한 게 틀림없어.
				PRINTFORMW 「우와아!!! 파츄리의 곳에서 절대 찾을 수 없었던 전설의 마도서잖아! 이게 어떻게 여기에?!」
				PRINTFORMW 「사실 나 요즘 이 책에 관심이 있었거든! 그리고 이걸 나에게 선물해 주는 거야? 헤헤, 정말 고마워, %CALLNAME:MASTER%～」
				PRINTFORMW 「내 비위를 맞출 줄 아는 사람은 마음에 들어, %K11_ZE("daze",1)%!」
				CALLF FIRSTTIME("MarisaGiftGrimoire")
			CASE 3
				SIF !FIRSTTIME("MarisaGiftLingerie", 1) || FIRSTTIME(189, 1)
					GOTO INPUT_LOOPME
				PRINTFORMDW 앞선 앞치마 놀이 세션을 기억하며, 마리사를 다른 옷으로 입힐 수 있는 것이 있는지 궁금해한다.
				PRINTFORMDW 그리고 정말로 있었던 것이다... 오, 이거 완벽하네!
				PRINTFORMW 「야, 너 뭐 하는 거야... 야!」
				PRINTFORMDW 마리사가 얼굴을 붉히고 당황한 채 이를 악물며 잠시 후 나타난다.
				PRINTFORMDW %BREAKENG(@"그녀의 나체인 연약한 몸에는 흰색 벨트, 프릴, 리본 등이 전부 걸려 있고, 작은 손에는 하얀 장갑을 끼고 가터벨트로 지지된 흰 스타킹을 신었는데 - 스캔들스럽게 야해 보이지만 동시에 그만큼 귀엽기도 하다.")%
				PRINTFORMDW %BREAKENG(@"마리사 자신이 보여주는 비범한 반응 덕분에 더욱 귀해졌는데, 그녀는 모자로 상기되고 홍조가 도는 뺨을 가린 채 수천 번 죽을 듯한 눈빛으로 당신에게 노려보면서도 몸을 가리거나 옷을 갈아입으려는 시도는 하지 않았다.")%
				PRINTFORMW 「A-너... 제정신이야? 나한테 이걸 다 입으라고 정말... 생각하는 거야?! 이 변태--...」
				PRINTFORMDW 하지만 중요한 부분들은 모두 가리고 있다. 누군가 이것에 대해 어떤 문제를 가지고 있든, 그건 분명 자기 머릿속의 문제일 뿐이다.
				PRINTFORMW 「분명 나를 가리긴 하는데... 당장이라도 죽고 싶을 지경이야! 다른 누구 앞에서는 절대 안 입을 거야... 너 빼고는!」
				PRINTFORMW 「그게 내 조건이야%K11_ZE()%!」
				PRINTFORMDW 심지어 어린 공주님들도 자기만의 변덕이 있는 법이다. 그러니 됐다고, 당신은 오늘 정말 좋은 물건을 산 것 같아 미소를 지으며 한숨을 쉬었다.
				CALLF FIRSTTIME("MarisaGiftLingerie")
			CASE 99
				RETURN 1
			CASEELSE
				GOTO INPUT_LOOPME
		ENDSELECT
		BASE:TARGET:ムード += 350
	ENDIF
ENDIF
RETURN 1
