;403,休憩
;CFLAG:TARGET:睡眠(1=TARGETが寝てる隣で休憩
;==================================================

@M_KOJO_MESSAGE_COM_K11_403
CALL M_KOJO_MESSAGE_COM_K11_403_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:TARGET:睡眠
	ELSE
		IF MARK:反発刻印 >= 3 || CFLAG:ブチギレ
			PRINTFORML 「흐음. 알겠다.」
			PRINTFORMW 「그럼 난 가볼게%K11_ZE()%!」
			CFLAG:同行 = 0
			CALL GETOUT(TARGET)
			RETURN 1
		ENDIF
		;added from tohoJ
		PRINTFORML 「음? 무슨 일이야, %CALLNAME:MASTER%, 피곤해?」
		IF TALENT:恋慕
			PRINTFORMW 「자, 좀 쉬게 해 줄 테니 네 무릎 위에 내가 너를 올려 놓을게%K11_ZE()%.」
		ELSE
			PRINTFORMW 「푹 쉬어. 괜찮아, 좀 쉬렴%K11_ZE()%。」
		ENDIF
		CALL K11_RelaxingTime
	ENDIF
ENDIF
RETURN 1
;==================================================
;405,出掛ける(同行時デート
;条件が厄介なので、COMF405 出掛ける.ERBを参照のこと
;==================================================

@M_KOJO_MESSAGE_COM_K11_405
;出掛けるにTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K11_405_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11_405_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	;TARGETとデート
	IF CFLAG:同行
		IF TALENT:恋慕
			SIF CFLAG:ブチギレ || MARK:反発刻印 ;added
				GOTO ANGERY
			PRINTFORML 「후훗, 나에게 데이트 신청을 하다니...」
			PRINTFORML 「기꺼이 초대해 주셨으니 물론 응해야죠!」
			PRINTFORMW 「자, 그럼 어디로 갈까요?」
		ELSE
			IF FIRSTTIME("MarisaGoOut")
				PRINTFORML 「우리 둘만 외출할래? 잠깐, 그거...」
				PRINTFORMW 「하지만 네가 나를 초대하겠다고 고집하니... 좋아, 가자%K11_ZE(,1)%!」
			ELSEIF CFLAG:ブチギレ || MARK:反発刻印
				$ANGERY
				PRINTFORML 「데이트? 너랑? 흥, 평소라면 고맙다고 말하겠지만, 됐어...」
				PRINTFORML 「하지만 네가 나에게 보상해주려는 거니까, 기회를 주지도 않고 끝내기엔 잔인하겠지.」
				PRINTFORMW 「좋아, 받아주지. 하지만 이번에는 더 열심히 노력해야 할 거야, 알겠어%K11_ZE(,1)%?」
				RETURN 1
			ELSE
				PRINTFORML 「지난번처럼 같이 외출할까?」
				PRINTFORMW 「오, 정말 좋지%K11_ZE()%! 가자, 아직 탐험되지 않은 곳이 많잖아!」
			ENDIF
		ENDIF
		;TARGET以外とデート
	ELSEIF CFLAG:MASTER:同行
		IF TALENT:恋人
			PRINTFORML 「젠장, 나조차도 네 여자친구 앞에서 다른 여자랑 데이트하는 걸 보면 문제겠어.」
			PRINTFORMW 「하아... 알았어, 네 뜻대로 해. 대신 다음엔 우리 꼭 데이트하자%K11_ZE(,1)%, 알겠지?」
		ELSEIF TALENT:恋慕
			PRINTFORML 「에? 아아, 알겠어, 그 여자랑 데이트하러 가는구나...」
			PRINTFORMW 「다음엔 나에게 사귀자고 해줬으면 좋겠어%K11_ZE()%! 너랑 어울리고 싶거든.」
		ELSE
			PRINTFORMW 「흠, 데이트를 하러 가는 거로군, 응?! %SPLIT_G("Have a good time:Have fun:Enjoy yourselves out there")%」
		ENDIF
		;お出かけお見送り
	ELSE
		IF TALENT:恋人
			PRINTFORML 「에헤~? 혼자 외출하는 거야?」
			PRINTFORMW 「너랑 같이 가고 싶은데... 뭐, 다음엔 데이트 신청해줘야 해%K11_ZE()%!」
		ELSEIF TALENT:恋慕
			PRINTFORML 「아이고, 혼자 외출하는 거야...?」
			PRINTFORMW 「%SPLIT_G("I'd love to come with you:I hoped you'd take me with you")%, 하지만 뭐... 내가 이런 일에 발언권이 있는 것도 아닌걸.」
		ELSE
			PRINTFORMW 「오, 어디 나가는 거야? %SPLIT_G("Have a good time:Have fun:Enjoy yourself out there")%!」
		ENDIF
	ENDIF
	SIF !CFLAG:同行
		RETURN 1
	;added
	IF FIRSTTIME("DatingMarisa") && !(CFLAG:ブチギレ || MARK:反発刻印)
		PRINTFORML
		IF !EXP:MASTER:デート経験
			PRINTFORML 「헤이, 왜 그렇게 서두르는 거야, %CALLNAME:MASTER%? 우리 시간 맞춰 도착할 수 있을 거야%K11_ZE(,1)%, 진정해!」
			PRINTFORML 「오, 여자랑 데이트하는 게 처음이야? 음...」
			PRINTFORMDW 마리사는 살짝 웃으며 손바닥으로 무릎을 탁 친다.
			PRINTFORML 「그래도 네가 한 번도 데이트를 해본 적이 없다는 건 믿기지 않아. 넌 꽤 인기 많을 거라고 확신했는데!」
			PRINTFORML 「에이, 나한테 겁먹지 마. 내가 무슨 나쁜 소리 하면 도망갈 타입은 아니잖아, 그렇지?」
