	IF ABL:マゾっ気 >= 6 || TALENT:マゾ
		IF RAND:3 == 0 && TALENT:恋慕
			PRINTFORML 「%SPLIT_G("아아, 더, 나를 더 때려줘! 아아아악!!!:미안해... 나는 맞으면서 즐거워하는 변태야――!!!")%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「%SPLIT_G(@"와-왜 이렇게 맞는 게 기분 좋을까...? 아하아... 그렇게 가차 없이 때리는 거 좋아해 %K11_ZE()%...")%」
		ELSE
			PRINTFORML 「%SPLIT_G(@"아프지만... 기분도 좋다%K11_ZE()%...!:%MOAN("l:m",,3)%! %GROAN()%")%」
		ENDIF
		PRINTFORMDW %BREAKENG(@"고통스러운 경험처럼 보이지만, 마리사는 예상보다 훨씬 흥분한 듯 연달아 관능적인 신음을 내뱉었다.")%
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORML 「%FSYN("ow")%, 그만둬! 갑자기 여기서 나를 때리지 마!」
			PRINTFORMW 「나는 고통받는 게 싫단 말이야, 모르겠어...?」
		ELSEIF RAND:2 == 0
			PRINTFORML 「저기, 내가 무슨 잘못을 했는지 말해줄 수 있어?」
			PRINTFORMW 「그거 흔적 남길 거야%K11_ZE(,1)%, 있잖아...」
		ELSE
			PRINTFORML 「제발, 저한테 좀 더 부드럽게 대해주세요... 이러고는 못 하겠어요%K11_ZE()%...」
			PRINTFORMW 「%FSYN("hii")%! 죄송해요, 죄송해요...! 그냥 때리지 말아 주세요...!」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORML 「뭐... 뭐야--?! 지옥같이 아프잖아, 제기랄!」
			PRINTFORMW 「진심으로, 너 진짜 개새끼야%K11_ZE("daze",1)%, 알고 있냐?」
		ELSEIF RAND:2 == 0
			PRINTFORML 「언젠가 이런 여자에게 상처 준 걸 후회하게 될 거야%K11_ZE()%...」
			PRINTFORMW 「나는 고통에 굴복하지 않을 거야...」
		ELSE
			PRINTFORML 「%GROAN()%...! 제발 그만해줘...」
			PRINTFORMW 「어떻게 나한테 이럴 수가 있어...? 흐윽, 훌쩍... 우와아...!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
