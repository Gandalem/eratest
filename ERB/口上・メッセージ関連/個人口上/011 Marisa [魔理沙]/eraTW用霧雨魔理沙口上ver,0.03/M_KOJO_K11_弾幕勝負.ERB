;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESSAGE_COM_K11_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIM nSeriousMode
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		nSeriousMode = 0
		IF MARK:反発刻印 >= 3
			PRINTFORMW 「You sure this is a good idea? Don't tell me I didn't warn ya%K11_ZE()%.」
			PRINTFORMDW Marisa grins defiantly. The look in her eyes is grim and determined.
			PRINTFORMDW You have a bad feeling about this...
			PRINTFORMW 「If you insist... If you're picking a fight with me... You've got one, %CALLNAME:MASTER%!」
			PRINTFORMW 「Nothing is ever certain, but... I still think I got it in me to kick your ass!」
			PRINTFORMDW Marisa focuses a huge amount of magic in her Mini-Hakkero...
			PRINTFORMW 「...I ain't gonna take it easy on you, you hear%K11_ZE(,1)%?」
			PRINTFORMW 「Now, lemme give you a little taste of my pain...」
			PRINTFORMDW She starts blasting hard!
			HANDICAP_FIXED = 3000
			HANDICAP_RAND = 3000
			nSeriousMode = 1
		ELSE
			IF TALENT:恋人
				PRINTFORMW 「Fighting my own %PRINT_MALE("boy", MASTER)%friend in Danmaku...」
				PRINTFORMW 「Never thought I'd live long enough to see this day%K11_ZE("daze",1)%.」
				IF ABL:戦闘能力 <= ABL:MASTER:戦闘能力 && RAND:3
					PRINTFORMW 「With practice, we could be the two strongest...」
					PRINTFORMDW Realizing what she just said, a blush works up from Marisa's jaw to warm up her cheeks.
				ELSE
					PRINTFORMW 「Now that's Love-Colored Danmaku, indeed!」
					PRINTFORMW 「...Why are you looking at me funny?」
				ENDIF
				PRINTFORML
			ENDIF

			IF TALENT:恋慕 && CFLAG:TARGET:溜まってる度 > 500
				PRINTFORMW 「Awright, %CALLNAME:MASTER%! I accept your challenge%K11_ZE("daze")%!」
				PRINTFORMW 「But how 'bout we make it a little interesting? Y'know...」
				PRINTFORMW 「What if we have the loser do whatever one thing the winner says?」
				PRINTFORMDW Sounds good. You just have to make sure to win. You got this!
				PRINTFORML
			ENDIF
			
			IF ABL:戦闘能力 > ABL:MASTER:戦闘能力
				PRINTFORMDW Gauging your skill at a glance, Marisa frowns.
				IF RAND:2
					PRINTFORMW 「Oi-oi, you sure you're gonna be okay like that?」
					PRINTFORMW 「For the record, in a real match, your opponent won't take it easy on you like I do%K11_ZE("daze", 1)%, you hear?」
				ELSE
					PRINTFORMW 「That's no way to fight me at all with skills like that%K11_ZE(,1)%, you know?」
					PRINTFORMW 「You're still a little untrained, trust me on this.」
				ENDIF
				PRINTFORMDW Still, it doesn't mean you have to back down!
				IF !RAND:3
					PRINTFORMW 「Gotta say, bravery in not a function of firepower!」
				ELSEIF RAND:2
					PRINTFORMW 「...Well, if you insist.」
					PRINTFORMW 「Lemme establish the pecking order!」
				ELSE
					PRINTFORMW 「Ooh, brave, I like that!」
					PRINTFORMW 「What is bravery without a dash of recklessness...」
				ENDIF
			ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
				PRINTFORMW 「Hehe... You're quite the powerhouse, ain'tcha? So this is what I have to fight against? Heh, been there, done that.」
				PRINTFORMW 「The stronger they are, the harder they fall: I promise this is true in Gensokyo%K11_ZE("daze")%!」
			ENDIF
			PRINTFORML
			PRINTFORML 「Alrighty then, let's get this party started!」
			PRINTFORML 「Here's something flashy and easy to dodge for ya!」
			PRINTFORML 『%SPLIT_G("Love Sign \"Non-Directional Laser\":Magic Sign \"Milky Way\"")%!』
		ENDIF
		CALLF SET_CEVENT("MarisaDanmakuFought", 11)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「Heh... I felt that a bit just now.」
					CASE 1
						PRINTFORML 「If I'm gonna do something, I'm gonna give it my all%K11_ZE()%. That's my motto!」
					CASE 2
						PRINTFORML 「Working up a good sweat like that, now we're talking%K11_ZE(,1)%!」
					CASE 3
						PRINTFORML 「You wanna see my cool magic spells in action, right?」
						PRINTFORML 「Be my guest%K11_ZE()%!」
				ENDSELECT
				PRINTFORML 『%SPLIT_G("Magic Sign \"Stardust Reverie\":Black Magic \"Event Horizon\":Loving Heart \"Double Spark\":Magic Space \"Asteroid Belt\"")%!』
			CASE 1
				LOCAL = IFRAND("0", ONCE("MarisaDanmaku1Life", 1), "1TO3", 1, "4", !FIRSTTIME("MarisaMima", 1))
				SELECTCASE LOCAL
					CASE 0
						PRINTFORML 「You gotta be kidding me! You're still standing!」
						PRINTFORML 「What do I have to do to bring you down, huh?!」
						PRINTFORML 「The gloves are off now%K11_ZE()%! Taste my ultimate technique, the peak of absolute firepower!!!」
						CALLF ONCE("MarisaDanmaku1Life")
						SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
							HANDICAP_RAND += 150
					CASE 1
						PRINTFORML 「Guhh...! Not bad, not bad at all, %CALLNAME:MASTER%!」
						PRINTFORML 「But still, I'm the number two in Gensokyo%K11_ZE("daze")%!!!」
						PRINTFORML 「It's like I say, if pushing doesn't work... Then push harder!」
						PRINTFORMDL Marisa goes on a full frontal assault!
						PRINTFORML 『"Blazing Star"!!!』
						SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
							HANDICAP_RAND += 100
					CASE 2
						PRINTFORML 「Uughh, don't make me get ugly with you!」
					CASE 3
						PRINTFORML 「Don't you look down on me%K11_ZE()%!」
					CASE 4
						PRINTFORML 「Here's a love letter from my former Master!」
						PRINTFORML 「I don't bust this one out very often, so be thankful!」
						PRINTFORML 『Celestial Apparatus "Orreries Solar System"!!!』
						SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
							HANDICAP_RAND += 200
				ENDSELECT
				SIF !GROUPMATCH(LOCAL, 0, 1, 4)
					PRINTFORML 『%SPLIT_G("Love Storm \"Starlight Typhoon\":Light Sign \"Earthlight Ray\":Light Blast \"Shoot the Moon\"")%!!!』
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF nSeriousMode
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「MASTEEEERRR SPAAAAAAAARK!!!」
					PRINTFORMDL BLAAAAAAAAAAAAMMM!!!
					CALL QUAKE(4)
					PRINTFORMDL A massive, blinding laser is fired at you.
					PRINTFORMDL ...Even if you escape the direct hit, you will sure to take a lot of damage...
					HANDICAP_FIXED += 1000
				CASE 1
					PRINTFORML 「DRAGON METEOR!!!」
					PRINTFORMDL BLAAAAAAAAAST!
					CALL QUAKE(4)
					PRINTFORMDL A massive, blinding laser is fired at you from the sky.
					PRINTFORMDL ...Taking that head-on will surely inflict a grave wound upon you...
					HANDICAP_FIXED += 500
				CASE 2
					PRINTFORML 「FINAL SPAAAAAAAAARK!!!」
					PRINTFORMDL KAPOOOOOOOOOOOOOOOOOOOOOOW!!!
					CALL QUAKE(4)
					PRINTFORMDL An impossibly massive, blinding laser is fired at you.
					PRINTFORMDL ...Escaping death never seemed so difficult...
					HANDICAP_FIXED += 1500
			ENDSELECT
		ELSE
			IF TALENT:恋慕 && 相手残機 == 1
				PRINTFORMW 「Step one, concentrate your mind...」
				PRINTFORMW 「Step two, mutter the name of your opponent tenderly...」
				PRINTFORMW 「Step three, aim at someone you like...」
				PRINTFORMW 「Step four, now unleash your annihilation of magic!!!」
				PRINTFORMW 『Magicannon...』
				PRINTFORMW 『★Final Magic Spark%COND_STR(@" dazeeeeeeeeee", CFLAG:11:K11EN_ZE)%!!!★』
				HANDICAP_FIXED += 300
			ELSEIF ABL:戦闘能力 > ABL:MASTER:戦闘能力
				PRINTFORML 「Fine, it's time I stop holding back! MASTER SPAAARK...!-like Flashlight.」
				HANDICAP_FIXED -= 100
			ELSE
				PRINTDATAL
					DATAFORM 「And now for the finisher!!!」
					DATAFORM 「Lasers... are all about firepower%K11_ZE("daze")%!」
					DATAFORM 「Alright, let's make some noise!」
					DATAFORM 「It's go time!」
					DATAFORM 「Hehe, I got something for ya!」
					DATAFORM 「Chew on this!」
					DATAFORM 「Your ass is grass%K11_ZE("daze",1)%, %CALLNAME:MASTER%!」
					DATAFORM 「I'd better watch out if I were you!」
					DATAFORM 「It's on now!」
				ENDDATA
				PRINTFORML 『Love Sign "Master Spark"!!!』
			ENDIF
			SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
				HANDICAP_RAND += 100
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		
	ENDIF
	
	IF ARGS == "Pichun"
		;RESULT:8 for player's lives
		
		IF nSeriousMode
			SELECTCASE RESULT:8
				CASE 3
					PRINTFORMW 「Oh? How interesting, I see you're packing some heat there.」
					PRINTFORMW 「I'm glad. I sure like it when my opponents struggle fiercely, it wouldn't be fun if it was any other way!」
					PRINTFORMW 「But soon, you'll realize how futile it is when you're facing a protagonist%K11_ZE("daze")%!」
				CASE 2
					PRINTFORMW 「How was it? I bet you felt that!」
					PRINTFORMDW Still, no matter what tricks she's using, surely you can prevail, she can be beaten!
					PRINTFORMW 「Is that so? I was still trying to hold back on you, y'know.」
					PRINTFORMW 「If I'm fighting you with parlor tricks, then you'll have no excuse for losing, will you?」
					PRINTFORMDW She doesn't seem to give you any mercy!
				CASE 1
					PRINTFORMW 「That's more like it!」
					PRINTFORMDW Even when you think that you stand a chance, she unleashes a new powerful attack!
					PRINTFORMDW She was right, after all... The futility of fighting a seasoned youkai exterminator is beginning to settle in.
					PRINTFORMW 「What's the matter? You don't look so good anymore, %CALLNAME:MASTER%.」
					PRINTFORMW 「You ain't about to cash it in from just that, are ya?」
			ENDSELECT
		ELSE
			SELECTCASE RESULT:8
				CASE 2
					IF RAND:2
						PRINTFORML 「Be terrified, be afraid! Let your fear nourish me for all eternity, ku-ku-ku...!」
						PRINTFORML 「Well, how's my youkai impression? Bet I scared ya%K11_ZE()%～」
					ELSE
						PRINTFORML 「Unexpected...」
						PRINTFORML 「Hip attaaaaaaaaaack!!!」
						PRINTFORMDL UUUUUUUGHHHHHHHHH!!!
						PRINTFORMDL Marisa rushes at you and rams you down with her waist!
						PRINTFORMDL It felt like getting hit by a sledgehammer!
						PRINTFORMDL Just how much did she train her ass there?!
					ENDIF
				CASE 1
					IF 相手残機 > RESULT:8
						PRINTFORML 「Maan, it's not even a contest anymore!」
						PRINTFORML 「I'm starting to feel bad for picking on you%K11_ZE()%.」
					ELSE
						PRINTFORML 「Hehehe... Looks like we're down to our last lives.」
						PRINTFORML 「It all comes down to a clutch, then. Let's see who wins this, %CALLNAME:MASTER%!」
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
	
	IF GROUPMATCH(ARGS,"エピタフ失敗", "エピタフ成功") && nSeriousMode
		IF ONCE("MarisaDanmakuDuelCheatSerious")
			PRINTFORMW 「...?」
			PRINTFORMW 「What was that? Some sleight of hand trick?」
			PRINTFORMDW Marisa rolls her eyes.
			PRINTFORMW 「No matter. I just have to hit you harder, that's all!」
		ELSE
			PRINTFORMW 「...I don't know who do you think you are or what you're thinking exactly, but...」
			PRINTFORMW 「I will beat you. With one shot.」
		ENDIF
		HANDICAP_RAND += 1000
	ELSEIF GROUPMATCH(ARGS,"エピタフ失敗", "エピタフ成功") && FIRSTTIME("MarisaDanmakuDuelCheat")
		PRINTFORMW 「The whosa-whatzit?! What just happened?!」
		PRINTFORMW 「Where the heck... did %HE_SHE(MASTER)% go...? I've lost sight of %HIM_HER(MASTER, , 1)% right away...」
		PRINTFORMW 「...Ah, I see, %HE_SHE(MASTER)%'s playing dirty! Then I need to think no more of this...」
		PRINTFORMW 「I just need to trust my intuition and fly forward... Heh, "trust my intuition", look at me go...」
		PRINTFORMW 「It's just what *she* would say...」
		PRINTFORMW 「There! I got it now! All I gotta do is to watch out for that%K11_ZE("daze")%!」
		SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
			HANDICAP_RAND += 100
	ELSEIF ARGS == "エピタフ失敗"
		PRINTDATAW
			DATAFORM 「Don't you toy with me!」
			DATAFORM 「Not so fast, big %PRINT_MALE("boy", MASTER)%!」
			DATAFORM 「If you disrespect Danmaku, you're gonna wind up hurting later!」
			DATAFORM 「Good, good! You might even hit me next time with that!」
			DATAFORM 「Huh, what, you thought you could just fool around and don't find out?」
		ENDDATA
		SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
			HANDICAP_RAND += 100
	ELSEIF ARGS == "エピタフ成功"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「Uwaaaaaaahhhh!!!」
				PRINTFORMW 「Ugh, no fair%K11_ZE(,1)%!」
			CASE 1
				PRINTFORMW 「Wow, this is such a power statement I felt as if I just got my knickers in a twist%K11_ZE()%!」
				PRINTFORMW 「Well, how about this?!」
			CASE 2
				PRINTFORMW 「Helloooo?! I thought that hit you for sure%K11_ZE("daze")%!」
				PRINTFORMW 「Dammit, if it comes to this, then I'm not gonna lose!!!」
		ENDSELECT
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		
		IF nSeriousMode
			IF 相手残機 > 0 ;you lost
				PRINTFORMDW Looks like Marisa is done playing around, as she prepares to release her ultimate spell!
				PRINTFORMW 「This is as far as you go!」
				PRINTFORMW 「I was planning on toying with you a bit more, but I ain't gonna hold back any longer!」
				PRINTFORMW 「Let it be a lesson for ya... Never hesitate in a fight, and destroy your enemy with all your strength%K11_ZE()%.」
				PRINTFORML
				PRINTFORML 「★FINAL MASTEEEEERRR SPAAAAAAAAAAAAAAAARK%COND_STR(@" DAZEEEEEEEEEEEE", CFLAG:11:K11EN_ZE)%!!!!!!★」
				PRINTFORMDL BLAREEEEEEEEEEE!!!
				CALL QUAKE(6)
				PRINTFORMDW A giant laser is unleashed right at you, powerful enough to burn you to a crisp and blow up your entire house.
				PRINTFORMDW For a moment, you almost embrace the very real possibility of being erased from the face of the earth...
				CALL ASK_M("Dodge", GetDodgeChance(MASTER) >= 30, "Don't dodge", 1)
				;on don't dodge you die
				IF RESULT
					CALL QUAKE(10)
					PRINTFORMDW You get caught in the blast and disappear...
					;force death on
					LOCAL:8 = nNecro
					nNecro = MAX(nNecro,1)
					CALLF BroadDamage(MASTER,"fullbody",10000,3,11,"Master Spark")
					CALL CrippleEffects(MASTER)
					IF IsDead:MASTER:0
						PRINTFORMDW ...You did not survive
						CALL DeathEval
						nNecro = LOCAL:8
						RETURN
					ENDIF
					nNecro = LOCAL:8
					LOADGLOBAL
					PRINTFORMDW You wake up, staring at a sky. A terrific amount of pain surges through your mangled body.
					PRINTFORMDW But somehow you're still alive.
					PRINTFORMDW You see Marisa, standing triumphant next to you. She leans over and stares at your face.
					PRINTFORMW 「Ooooi, %CALLNAME:MASTER%...? I thought you kicked the bucket there for sure.」
					PRINTFORMW 「Oh well, this must be a fluke on my part. Maybe it wasn't powerful enough...」
					PRINTFORMW 「Uhh, no, I mean, I got kinda scared. I didn't want to kill anybody, so I'm glad.」
					PRINTFORMW 「But you know what, I'm impressed. I think I'm just gonna go ahead and drop the whole issue right here and then.」
					PRINTFORMDW She reaches out and helps you stand up.
					PRINTFORMW 「...」
					PRINTFORMW 「Weeell, truth be told, I think I went overboard myself... Sorry for snapping at you like that.」
					PRINTFORMW 「Can we be friends again? Sure! But let's not forget the important lesson we both learned here today.」
					PRINTFORMW 「You're lucky it's just me, the Ordinary Magician, that you had a beef with!」
					PRINTFORMW 「Had you pissed off a wrong girl, you might've not been able to get off just as easy%K11_ZE("daze")%♪!」
					PRINTFORMDW Looks like Marisa is willing to forgive you.
					PRINTFORMDW But your body will forever bear the scars from this incident, no doubt about it...
					CALL RECOVER(MASTER, -10000, "体力", "Battle Ordeal")
					K = DT_SELECT(@"Hediff", @"chara = {MASTER} and owner = 11 and cause = \"Master Spark\"", , PartStack)
					FOR LOCAL,0,K
						DT_CELL_SET @"Hediff", PartStack:LOCAL, "permanent", 1, 1
					NEXT

					;IF MAXBASE:MASTER:0 >= 1000
					;	CALL COLORMESSAGE("Max STA-100",C_RED,2,1)
					;	MAXBASE:MASTER:体力 -= 100
					;ENDIF
					CALL COLORMESSAGE("Permanent Burn Wounds",C_RED,2,1)
					CALLF CALMME(TARGET)
					MARK:反発取得履歴 = 5
					TIME += 180
				ELSE
					PRINTFORMDW Mustering all your remaining strength, you propel yourself away from the blast with your bullets, making a crash landing on the ground beneath.
					;force death on
					nNecro = 1
					CALLF BroadDamage(MASTER,"fullbody",1500,3,11,"Master Spark")
					CALL CrippleEffects(MASTER)
					IF IsDead:MASTER:0
						PRINTFORMDW ...You did not survive
						CALL DeathEval
						RETURN
					ENDIF
					LOADGLOBAL
					CALL TRIPLEDOT("timed")
					PRINTFORMDW You wake up, staring at a sky. A terrific amount of pain surges through your mangled body.
					PRINTFORMDW But somehow you're still alive.
					PRINTFORMDW You see Marisa, standing triumphant next to you. She bends over and stares at your face.
					PRINTFORMW 「Tche, it barely hit you. But oh well, I think I'm satisfied with that.」
					PRINTFORMW 「Bye now!」
					PRINTFORMDW Marisa says just that before flying away.
					PRINTFORMDW You're not entirely sure, but she might be more willing to forgive you now.
					PRINTFORMDW At least the burning wound aching at your side tells you that this entire thing was real...
					CFLAG:同行 = 0
					CALL GETOUT(TARGET)
					CALL RECOVER(MASTER, -10000, "体力", "Battle Ordeal")
					MARK:反発刻印 --
					TIME += 180
				ENDIF
			ELSE ;you're not supposed to win, but just in case
				PRINTFORMDW It's over.
				PRINTFORMDW After a fierce battle with your life at a stake, you managed to prevail.
				PRINTFORMDW Marisa is ruffled and worn out, but her spirit remains undefeated.
				PRINTFORMW 「W-Who were you expecting to give up?」
				PRINTFORMDW She says, spitting out blood and vitriol while trying to stand, but her body can't quite keep up anymore.
				PRINTFORMW 「Ugh... I have no other choice then...」
				CALL COLORMESSAGE(@"☆You'll never take me alive%K11_ZE("daze")%!!!☆",C_YELLOW,1,1)
				CALL QUAKE(4)
				nNecro = 1
				CALLF BroadDamage(11,"fullbody",15000,3,11,"Suicide")
				CALL SET_HISTORY_DEATH(11,11,"MarisaSuicide")
				;WAIT
				;PRINTFORMW 「.........」
				;PRINTFORMDW Marisa grits her teeth as hard as she can... But nothing happens.
				;PRINTFORMW 「Ah crap, I forgot to wear my self-destruct Mini-Hakkero in my tooth, that sucks...」
				CALL COLORMESSAGE(@"Combat Exp+100",C_YELLOW,2,1)
				EXP:MASTER:戦闘経験 += 100
			ENDIF
			RETURN 1
		ENDIF

		SIF 相手残機 > 0
			PRINTFORMW 「Huh... What? That's it? Oh well...」
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				IF RAND:2
					PRINTFORMW 「Loser, loooser!」
					PRINTFORMW 「Nah, I'm just kidding. Good luck next time!」
				ELSE
					PRINTFORMW 「Alright, good effort!」
				ENDIF
			CASE 2
				PRINTFORMW 「C'mon, all you needed to do is just hit me more!」
				PRINTFORMW 「...Unfortunately, I'm pretty good at dodging.」
			CASE 1
				PRINTDATAW
					DATAFORM 「Phew... That was a close call!」
					DATAFORM 「Uhh, that's gonna leave a mark%K11_ZE()%.」
					DATAFORM 「N-Not even close, I wasn't scared there at all!」
				ENDDATA
			CASE 0
				;PRINTFORML 
		ENDSELECT
		PRINTFORML
		IF 相手残機 > 0
			PRINTFORMDW Realizing that she just had won, Marisa's lips curl up in smug self-satisfaction.
			IF FIRSTTIME("MarisaDanmakuGotDefeated")
				PRINTFORMW 「Hmm～? Did the loser say something? I can't hear ya～」
				PRINTFORMW 「Haha, sorry, that was a little mean. Well, better luck next time!」
				PRINTFORMDW Marisa says, patting you on the back with a grin.
				PRINTFORMDW Perhaps her teasing is her way of encouraging you to do better. It's certainly working...
			ELSEIF ABL:戦闘能力 > ABL:MASTER:戦闘能力
				;low power
				PRINTFORMDW At the end you realize that she was just messing around, not taking you seriously.
				PRINTFORMDW Most of her spells were simple flashlights that could never hit you.
				PRINTFORMDW You have to wonder what does it take to make her switch gears and treat you like a threat...
			ELSEIF 相手残機 == 1
				;low life
				PRINTFORMW 「Oi-oi, what happened, %CALLNAME:MASTER%?」
				PRINTFORMW 「You were doing so well until the end!」
				PRINTFORMW 「Could it be that you got nervous? I can relate%K11_ZE()%～」
				PRINTFORMW 「It sucks when you get overexcited and slip up at the last possible moment.」
				PRINTFORMW 「Well, better luck next time! I know you can do it!」
			ELSEIF ABL:戦闘能力 < ABL:MASTER:戦闘能力
				;you stronger
				PRINTFORMW 「Who the heck loses with that kinda difference in firepower?!」
				PRINTFORMW 「Are you holding back on me?! This won't stand%K11_ZE()%!」
				PRINTFORMW 「We're gonna have a proper rematch next time, you hear me %CALLNAME:MASTER%?!」
				PRINTFORMDW Apparently Marisa was somewhat disappointed in more ways than one...
			ENDIF
			
			IF TALENT:恋慕
				PRINTFORMW 「A young maiden in love is strong, you know!」
				PRINTFORMW 「...Though I had to beat up my own beloved for that.」
				PRINTFORMW 「Oi oi, are you okay %CALLNAME:MASTER%?! I'll bandage you up right away! Also I got this nice energy drink made from mushrooms...」
				PRINTFORMDW Marisa spends some time tending to your wounds, as insignificant as they may be.
				CALL RECOVER(MASTER, 600, "体力")
				CALL RECOVER(MASTER, 300, "気力")
			ELSE
				PRINTFORMW 「What's the secret to my success?」
				PRINTFORMW 「I just don't think about losing%K11_ZE()%.」
				PRINTFORMW 「Remember that, from the words of Marisa Kirisame, the Ordinary Magician!」
			ENDIF
		ELSE
			IF !CFLAG:弾幕勝負勝利 ;after first win
				PRINTFORMW 「Aww man, that was total defeat on my part! And I was sure I could've beaten you...」
				PRINTFORMW 「If I can't beat you, then... I guess no one can! But don't get too cocky, Gensokyo loves pulling the rug from under you in this occasion.」
				PRINTFORMW 「The fight's outcome, y'see, is a matter of fortune%K11_ZE()%.」
				PRINTFORMW 「Well, I can't complain though. "A beaten dog has no business barking", am I right?」
				PRINTFORMW 「This was a lot of fun! Let's do that again sometime%K11_ZE("daze")%.」
			ELSE
				IF TALENT:恋慕
					PRINTFORMW 「Holy crap, that hurt...」
					PRINTFORMW 「Well, we can compare bruises later%K11_ZE()%. But at least it was fun, right?」
					PRINTFORMDW %BREAKENG(@"Marisa spends some time tending to your wounds, as insignificant as they may be, despite the fact that she may need it more than you do...")%
					CALL RECOVER(MASTER, 600, "体力")
					CALL RECOVER(MASTER, 300, "気力")
				ELSE
					PRINTFORMW 「Ow-ow-ow-ow-ow-owwww!!!」
					PRINTFORMW 「Can't you be more gentle?!」
					PRINTFORMW 「This is the tender skin of a maiden you're treatin' here%K11_ZE()%!」
					PRINTFORMDW Hmmm... Looks like a sprain.
					PRINTFORMW 「Uuughhhh... If I die, you'll have to visit my grave!」
				ENDIF
			ENDIF
			IF HANDICAP_RAND >= 10
				PRINTFORML
				PRINTFORMDW Marisa was no joke, indeed...
				PRINTFORMDW You feel like you have learned quite a lot of useful techniques for the future encounters.
				LOCAL = LIMIT((HANDICAP_RAND / 10), 1, 100)
				CALL AddEXP("戦闘経験", MASTER, LOCAL)
				
				PRINTFORMDW Marisa, too, seemed to have learned quite a bit.
				CALL AddEXP("戦闘経験", TARGET, MULTIPLY(LOCAL, 150))
			ENDIF
		ENDIF
		PRINTFORML
		PRINTFORML
		PRINTFORML

		IF TALENT:恋慕 && CFLAG:TARGET:溜まってる度 > 500
			PRINTFORML
			PRINTFORML
			PRINTFORMW 「Now, I believe we had a little bet going on...」
			IF 相手残機 > 0 ;takes you into her house and pushes you down
				PRINTFORMDW Marisa looks at you with undisguised lust in her eyes. Uh oh...
				PRINTFORMW 「Well, you're at my mercy now, and for that... I want your body%K11_ZE()%!」
				PRINTFORMW 「I worked up quite the appetite during this duel, so I gotta do something about it!」
				PRINTFORMDW Without wasting any time, Marisa whisks you away from prying eyes and pushes you down...
				CFLAG:溜まってる度 = 999
				CFLAG:デート中 = -1
				CALL OMANEKI_ENTER(TARGET)
				CALL INSTANT_PUSHDOWN
			ELSE
				PRINTFORMW 「W-Well, go easy on me, please...」
				PRINTFORMDW Marisa closes her eyes with a blush, perhaps expecting something perverted.
				PRINTFORMDW But instead, you just lean over and kiss her on the lips.
				PRINTFORMW 「Ah... Hahaha, you got me there%K11_ZE()%. I was thinking you'd... Never mind.」
				PRINTFORMW 「Well, you certainly deserve it. Let's do it again sometime, eh? Ufufu～」
				CALL MUTUAL_KISS
			ENDIF
		ENDIF
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

