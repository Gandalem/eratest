; Modular ERB: 個人口上/011 Marisa [魔理沙]/eraTW用霧雨魔理沙口上ver,0.03/M_KOJO_K11_弾幕勝負.ERB
;added, oc
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K11_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIM nSeriousMode
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		nSeriousMode = 0
		IF MARK:反発刻印 >= 3
			PRINTFORMW 「이거 정말 좋은 생각이야? 내가 경고하지 않았다고 말하지 마%K11_ZE()%.」
			PRINTFORMDW 마리사는 도발적으로 미소 짓는다. 그녀의 눈빛은 엄숙하고 결의에 차 있었다.
			PRINTFORMDW 너 이거에 대해 안 좋은 예감이 들 거야...
			PRINTFORMW 「네가 고집한다면... 네가 나한테 시비를 건다면... 후회하게 될 거다, %CALLNAME:MASTER%!」
			PRINTFORMW 「아무것도 확실한 건 없지만... 난 그래도 너를 박살 낼 자신이 있어!」
			PRINTFORMDW 마리사는 자신의 미니-하케로에 엄청난 양의 마법을 집중한다...
			PRINTFORMW 「...너한테 봐주진 않을 거다, 알겠어%K11_ZE(,1)%?」
			PRINTFORMW 「자, 내 고통을 살짝 맛이나 보라고...」
			PRINTFORMDW 그녀가 강력하게 난사를 시작했다!
			HANDICAP_FIXED = 3000
			HANDICAP_RAND = 3000
			nSeriousMode = 1
		ELSE
			IF TALENT:恋人
				PRINTFORMW 「나 자신의 %PRINT_MALE("boy", MASTER)%친구와 단마쿠를 한다니...」
				PRINTFORMW 「이 날을 볼 만큼 오래 살 줄은 몰랐다%K11_ZE("daze",1)%.」
				IF ABL:戦闘能力 <= ABL:MASTER:戦闘能力 && RAND:3
					PRINTFORMW 「연습을 하면 우리는 두 명의 가장 강자가 될 수 있어...」
					PRINTFORMDW 그녀가 방금 한 말을 깨달은 마리사의 턱부터 뺨까지 홍조가 올라와 얼굴이 달아올랐다.
				ELSE
					PRINTFORMW 「지금이야말로 연모색 단마쿠라니, 정말!」
					PRINTFORMW 「...왜 나를 이상하게 봐?」
				ENDIF
				PRINTFORML
			ENDIF
			IF TALENT:恋慕 && CFLAG:TARGET:溜まってる度 > 500
				PRINTFORMW 「좋아, %CALLNAME:MASTER%! 네 도전을 받아들이겠어%K11_ZE("daze")%!」
				PRINTFORMW 「하지만 좀 더 흥미진진하게 만들어보는 건 어때? 있잖아...」
				PRINTFORMW 「패배자가 승자가 원하는 거 하나씩 해주면 어떨까?」
				PRINTFORMDW 좋아. 네가 이기기만 하면 돼. 할 수 있어!
				PRINTFORML
			ENDIF
			IF ABL:戦闘能力 > ABL:MASTER:戦闘能力
				PRINTFORMDW 한눈에 실력을 가늠한 마리사는 미간을 찌푸린다.
				IF RAND:2
					PRINTFORMW 「야, 너 정말 괜찮을 거라고 생각해?」
					PRINTFORMW 「기록해 두자면, 진짜 경기에서는 상대가 나처럼 봐주지 않을 거다%K11_ZE("daze", 1)%, 알겠어?」
				ELSE
					PRINTFORMW 「그런 기술로는 도저히 나랑 싸울 수 없어, 알잖아%K11_ZE(,1)%,」
					PRINTFORMW 「아직 좀 미숙해, 날 믿어봐.」
				ENDIF
				PRINTFORMDW 그렇다고 후퇴해야 한다는 뜻은 아니야!
				IF !RAND:3
					PRINTFORMW 「용기는 화력의 기능이 아니라고 말해야겠군!」
				ELSEIF RAND:2
					PRINTFORMW 「...뭐, 고집한다면 말이지.」
					PRINTFORMW 「서열을 정해주지!」
				ELSE
					PRINTFORMW 「오호, 용감하군, 마음에 들어!」
					PRINTFORMW 「무모함이 조금 없다면 그게 무슨 용기겠어…」
				ENDIF
			ELSEIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
				PRINTFORMW 「헤헤... 꽤 강한 상대군, 안 그래? 그래서 내가 싸워야 할 게 이거인가? 헤h, 한 번 해봤지.」
				PRINTFORMW 「강할수록 더 크게 무너진다: 이것은 환상향에서도 사실이라고 약속한다%K11_ZE("daze")%!」
			ENDIF
			PRINTFORML
			PRINTFORML 「좋아, 그럼 이 파티를 시작해 볼까!」
			PRINTFORML 「자네를 위해 화려하고 피하기 쉬운 걸 준비했지!」
			PRINTFORML 『%SPLIT_G("Love Sign \"Non-Directional Laser\":Magic Sign \"Milky Way\"")%!』
		ENDIF
		CALLF SET_CEVENT("MarisaDanmakuFought", 11)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「흥... 방금 그거 좀 느꼈어.」
					CASE 1
						PRINTFORML 「뭔가를 할 거라면 전 모든 걸 다 바칠 거야%K11_ZE()%. 그게 내 좌우명이야!」
					CASE 2
						PRINTFORML 「저렇게 흠뻑 땀을 흘리다니, 이제야 제대로 된 거야%K11_ZE(,1)%!」
					CASE 3
						PRINTFORML 「내 멋진 마법을 실전으로 보고 싶지?」
						PRINTFORML 「원하는 대로 해라 %K11_ZE()%!」
				ENDSELECT
				PRINTFORML 『%SPLIT_G("Magic Sign \"Stardust Reverie\":Black Magic \"Event Horizon\":Loving Heart \"Double Spark\":Magic Space \"Asteroid Belt\"")%!』
			CASE 1
				LOCAL = IFRAND("0", ONCE("MarisaDanmaku1Life", 1), "1TO3", 1, "4", !FIRSTTIME("MarisaMima", 1))
				SELECTCASE LOCAL
					CASE 0
						PRINTFORML 「농담하는 거겠지! 아직도 서 있잖아!」
						PRINTFORML 「널 쓰러뜨리려면 뭘 해야 하는 거지, 응?!」
						PRINTFORML 「%K11_ZE()%는 이제 장갑을 벗는다! 나의 궁극의 기교, 절대 화력의 정점을 맛봐라!!!」
						CALLF ONCE("MarisaDanmaku1Life")
						SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
							HANDICAP_RAND += 150
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%! 별로 안 나쁘군, 전혀 안 나빠!」
						PRINTFORML 「하지만 난 여전히 환상향의 2위인 %K11_ZE("daze")%이라고!!!」
						PRINTFORML 「내가 말했듯이, 밀어붙이는 게 효과가 없다면... 더 세게 밀어붙여라!」
						PRINTFORMDL 마리사가 전면적인 총공세를 펼친다!
						PRINTFORML 『"블레이징 스타"!!!』
						SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
							HANDICAP_RAND += 100
					CASE 2
						PRINTFORML 「으윽, 너 때문에 못생겨지게 하지 마!」
					CASE 3
						PRINTFORML 「나를 깔보지 마라%K11_ZE()%!」
					CASE 4
						PRINTFORML 「전 주인님께 온 연모 편이다!」
						PRINTFORML 「이런 건 자주 꺼내는 게 아니니 감사히 받아라!」
						PRINTFORML 『천체 장치 "태양계 오르레리"!!!』
						SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
							HANDICAP_RAND += 200
				ENDSELECT
				SIF !GROUPMATCH(LOCAL, 0, 1, 4)
					PRINTFORML 『%SPLIT_G("Love Storm \"Starlight Typhoon\":Light Sign \"Earthlight Ray\":Light Blast \"Shoot the Moon\"")%!!!』
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF nSeriousMode
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「마스터의 불꽃이야!!!」
					PRINTFORMDL 블라아아암!!!
					CALL QUAKE(4)
					PRINTFORMDL 거대하고 눈을 멀게 하는 레이저가 당신에게 발사된다.
					PRINTFORMDL ...직격은 피하더라도 분명 많은 피해를 입게 될 것이다...
					HANDICAP_FIXED += 1000
				CASE 1
					PRINTFORML 「드래곤 미티어!!!」
					PRINTFORMDL 블라아스트!
					CALL QUAKE(4)
					PRINTFORMDL 하늘에서 거대하고 눈부신 레이저가 당신을 향해 발사된다.
					PRINTFORMDL ...정면으로 맞으면 분명 심각한 상처를 입게 될 것이다...
					HANDICAP_FIXED += 500
				CASE 2
					PRINTFORML 「최후의 스파아아아아아크!!!」
					PRINTFORMDL 카포오오오오오오오오오우!!!
					CALL QUAKE(4)
					PRINTFORMDL 믿을 수 없을 만큼 거대하고 눈이 부신 레이저가 당신에게 발사된다.
					PRINTFORMDL ...죽음에서 벗어나는 것이 이렇게 어려울 줄은 몰랐다...
					HANDICAP_FIXED += 1500
			ENDSELECT
		ELSE
			IF TALENT:恋慕 && 相手残機 == 1
				PRINTFORMW 「첫 번째 단계, 정신을 집중하라...」
				PRINTFORMW 「두 번째 단계, 상대의 이름을 부드럽게 중얼거려라...」
				PRINTFORMW 「세 번째 단계, 좋아하는 사람을 목표로 삼아라...」
				PRINTFORMW 「네 번째 단계, 이제 너의 소멸 마법을 해방해라!!!」
				PRINTFORMW 『마지캐논...』
				PRINTFORMW 『★최종 마법 불꽃%COND_STR(@" dazeeeeeeeeee", CFLAG:11:K11EN_ZE)%!!!★』
				HANDICAP_FIXED += 300
			ELSEIF ABL:戦闘能力 > ABL:MASTER:戦闘能力
				PRINTFORML 「좋아, 이제 참을 필요는 없겠군! 마스터 스파크...!-같은 손전등.」
				HANDICAP_FIXED -= 100
			ELSE
				PRINTDATAL
					DATAFORM 「그리고 이제 피니셔다!!!」
					DATAFORM 「레이저는 전적으로 화력에 관한 것이지%K11_ZE("daze")%!」
					DATAFORM 「좋아, 시끄러워질 시간이다!」
					DATAFORM 「이제 시작이야!」
					DATAFORM 「헤헤, 너에게 줄 게 있어!」
					DATAFORM 「이걸 씹어봐!」
					DATAFORM 「네 뒤는 풀밭이야%K11_ZE("daze",1)%, %CALLNAME:MASTER%!」
					DATAFORM 「나라면 조심하는 게 좋을 거야!」
					DATAFORM 「이제 시작이다!」
				ENDDATA
				PRINTFORML 『연모의 징표 "마스터 스파크"!!!』
			ENDIF
			SIF ABL:MASTER:戦闘能力 >= ABL:戦闘能力
				HANDICAP_RAND += 100
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	IF ARGS == "Pichun"
		;RESULT:8 for player's lives
		IF nSeriousMode
			SELECTCASE RESULT:8
				CASE 3
					PRINTFORMW 「오? 흥미롭군, 자네가 불꽃을 품고 있구만.」
					PRINTFORMW 「기쁘군. 내 상대들이 격렬하게 발버둥 치는 걸 정말 좋아하거든, 그렇지 않으면 재미없잖아!」
					PRINTFORMW 「하지만 곧, 주인공%K11_ZE("daze")%을 마주했을 때 얼마나 부질없는 일인지 깨닫게 될 거야!」
				CASE 2
					PRINTFORMW 「어땠어? 분명 느꼈을 거야!」
					PRINTFORMDW 그래도 그녀가 어떤 속임수를 쓰든, 분명 너는 이길 수 있어, 그녀는 지게 되어 있다고!
					PRINTFORMW 「정말? 난 여전히 너한테 봐주려고 노력하고 있었다고, 있잖아.」
					PRINTFORMW 「내가 잔재주로 싸우고 있다면, 너에게 질 변명은 없을 거야, 알겠어?」
					PRINTFORMDW 그녀는 너에게 자비를 베풀지 않는 것 같아!
				CASE 1
					PRINTFORMW 「그게 더 맞지!」
					PRINTFORMDW 기회가 있다고 생각할 때조차 그녀는 새로운 강력한 공격을 퍼붓는다!
					PRINTFORMDW 결국 그녀가 옳았다... 노련한 요괴 사냥꾼과 싸우는 것의 허무함이 자리 잡기 시작한다.
					PRINTFORMW 「무슨 일이야? %CALLNAME:MASTER%씨, 영 안 좋아 보이는데.」
					PRINTFORMW 「그것 하나 가지고 끝낼 생각은 아니겠지?」
			ENDSELECT
		ELSE
			SELECTCASE RESULT:8
				CASE 2
					IF RAND:2
						PRINTFORML 「두려워해라, 겁먹어라! 너의 공포가 영원히 나를 키우도록 해라, 쿠쿠쿠...!」
						PRINTFORML 「음, 내 요괴 인상 어때? 분명 무섭게 만들었을 거야%K11_ZE()%～」
					ELSE
						PRINTFORML 「예상치 못했어...」
						PRINTFORML 「엉덩이 공격!!!」
						PRINTFORMDL 우우우우욱!!!!
						PRINTFORMDL 마리사가 너에게 돌진해 허리로 너를 찍어버렸다!
						PRINTFORMDL 마치 대형 망치에 맞은 것 같았다!
						PRINTFORMDL 대체 얼마나 그곳을 단련한 거지?!
					ENDIF
				CASE 1
					IF 相手残機 > RESULT:8
						PRINTFORML 「마안, 이건 더 이상 시합도 아니야!」
						PRINTFORML 「널 놀리는 게 좀 미안해지기 시작했어%K11_ZE()%.」
					ELSE
						PRINTFORML 「헤헤... 마지막 생명이 남은 것 같네.」
						PRINTFORML 「결국 클러치로 결정되는군. 누가 이길지 보자고, %CALLNAME:MASTER%!」
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
	IF GROUPMATCH(ARGS,"エピタフ失敗", "エピタフ成功") && nSeriousMode
		IF ONCE("MarisaDanmakuDuelCheatSerious")
			PRINTFORMW 「...?」
			PRINTFORMW 「뭐였지? 어떤 속임수 같은 거였나?」
			PRINTFORMDW 마리사는 눈을 굴린다.
			PRINTFORMW 「상관없어. 그냥 더 세게 때리면 돼, 그뿐이야!」
		ELSE
			PRINTFORMW 「...네가 누구라고 생각하는지, 혹은 정확히 무슨 생각을 하는지는 모르겠지만...」
			PRINTFORMW 「너를 쓰러뜨리겠다. 단 한 방으로.」
		ENDIF
		HANDICAP_RAND += 1000
	ELSEIF GROUPMATCH(ARGS,"エピタフ失敗", "エピタフ成功") && FIRSTTIME("MarisaDanmakuDuelCheat")
		PRINTFORMW 「저게 뭐야-뭐라고?! 방금 무슨 일이 일어난 거야?!」
		PRINTFORMW 「도대체... %HE_SHE(MASTER)%은 어디로 간 거지...? 금방 %HIM_HER(MASTER, , 1)%이 시야에서 사라졌어...」
		PRINTFORMW 「...아, 알겠다. %HE_SHE(MASTER)%이 비겁하게 행동하는구나! 그럼 더 이상 이 일에 대해 생각할 필요가 없겠군...」
