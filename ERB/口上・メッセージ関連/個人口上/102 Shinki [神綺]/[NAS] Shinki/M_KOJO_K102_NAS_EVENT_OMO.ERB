				CALL CUTSCENESPEAK_NAS(@"「나는 바꿔야 해, 여기에 앉아 있기 싫어.」", "通常:照れ", 102, 0)
				WAIT
			CASE 3, 4
				PRINTFORMDW %CALLNAME:102%의 사고 냄새가 공기를 가득 채우지만, %HE_SHE(102)%는 예전보다 그것에 대해 덜 역겹게 느낀다.
				CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%.... 매번 이렇게 망치다니 너무 창피하지만, 이 따뜻하고 포근한 기분이 들어.」", "発情", 102, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「적어도 기분이 좋아지기 시작했어.... 비록 냄새는 좀 아쉽지만.」/「나 바꿔야겠어.」", "発情", 102, 0)
				WAIT
			CASE 5, 6
				PRINTFORMDW %CALLNAME:102%의 사고 냄새가 공기를 가득 채우지만, %HE_SHE(102)%는 역겨워하기는커녕 비웃는다.
				CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%…… 나 기저귀 아기가 되어 가는 거야, 안 그래?」", "発情", 102, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「나 스스로 변을 했을 때 기분이 좋았다。」/「언젠가 이 냄새에 익숙해지게 될지도 모르겠다.」", "発情", 102, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「보호자들도 조금은 행동할 수 있지 않나?」", "発情", 102, 0)
				WAIT
			CASE IS < 10
				PRINTFORMDW %CALLNAME:102%의 사고 냄새가 공기를 가득 채우지만, 이번에는 %HE_SHE(102)%이 그것을 즐긴다.
				CALL CUTSCENESPEAK_NAS(@"「분명 중독이 되어가는 것 같다。」/「%PeeProtectType(102,3)%를 계속 채우는 걸 멈출 수가 없다.」", "発情", 102, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「그리고 나는 그 냄새가 마음에 들기 시작했어.」/「아마 잠시 내 난장판에 머물러야 할지도 모르겠네.」", "発情", 102, 0)
				WAIT
			CASE IS < 15
				CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%…… 정말 좋다❤」", "発情", 102, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「이거 더 해야겠어❤」", "発情", 102, 0)
				WAIT
			CASEELSE
				PRINTFORMDW %CALLNAME:102%의 사고 냄새가 %HIM_HER(102)%을 황홀경에 빠지게 한다.
				CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%...... %MOAN("h")%......」/「또 이렇게 큰 난장판을 만들었네❤」", "発情", 102, 0)
				WAIT
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
;==================================================
;Diarrhea Roulete
;ARG:0 = Scene
;ARG:1 = Item
;==================================================

@M_KOJO_PMONSTERGAME_K102_0(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Intro
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -99
		CALL SET_KOJO_COLOR([[Hourai]])
		PRINTFORMDW 순식간에 손을 등 뒤로 하고 변기에 구속된 채 변기 위에 앉게 된다.
		IF nOmutsu
			CALLF PANTY_REWORK_CHANGE(MASTER,104)
			PRINTFORMDW 당신의 하의와 속옷도 벗겨져서, %SHOW_BOTTOM(MASTER)%를 가득 드러내고 기저귀 차림으로 앉아 있다.
		ELSE
			CALLF PANTY_REWORK_CHANGE(MASTER,71)
			PRINTFORMDW 당신의 하의와 속옷도 모두 벗겨져서, %SHOW_BOTTOM(MASTER)%를 완전히 드러낸 채 앉아있다.
		ENDIF
		PRINTFORMDW 바람을 느끼기 시작하자, 당신은 그녀의 얼굴에 미소를 띠고 작게 웃으며 지켜보는 신키를 정면에서 발견한다.
		PRINTFORMDW 또한 당신을 똑바로 겨누고 있는 카메라가 보인다.
		CALL SET_KOJO_COLOR(102)
		PRINTFORMW 「작은 %조사처리(CALLNAME:MASTER,"를")% 봐.」
		PRINTFORMW 「네게 할 일에 대해 정말 미안해. 하지만 엄마는 지루했고, 너는 용변 보러 갈 참이었거든.」
		PRINTFORMW 「용변 보는 시간은 나와 함께일 때 훨씬 더 기억할 만하단다...」
		PRINTFORMW 「특히 네 새롭고 깨끗한 \@ nOmutsu ? pamps # pants \@를 걸고 『Desperation Roulette』을 할 때는 말이야!」
		PRINTFORMDW 너는 발버둥 치려고 하지만, 속박은 아주 단단하게 조여져 있다.
		PRINTL
		PRINTFORMW 「이기는 건 간단하다. \@ PottyMonsterGame_HasScat ? 대변을 싸지 # 오줌을 지리지 \@ 자책하지 마라. 하지만 그걸 안 하는 게 엄청 어려울 거다.」
		PRINTFORMW 「방광 바퀴와 장 바퀴 각각에서 아이템이 8개씩 나올 것이다.」
		PRINTFORMW 「하지만 지금 당장 배출해야 할 곳, 즉 %PeeAndPoo(PottyMonsterGame_HasPiss,PottyMonsterGame_HasScat, "bladder", "bowels")% 부분만 플레이하게 될 것이다.」
		SIF nOmutsu
			PRINTFORMW 「이미 기저귀를 씌웠으니, 네 지저분한 잠재력을 보여주고 싶다면 그렇게 해도 돼.」 
		PRINTFORMW 「이제 나를 위해 몇 가지 선물을 만들 수 있을까? 알아내 보자!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Desperation
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -80
		IF PeeBarStage(MASTER) > PottyMonsterGame_LastDesp:0
			SELECTCASE PeeBarStage(MASTER)
				CASE 6
				CASE 5
				CASE 4
			ENDSELECT
		ENDIF
		IF PooBarStage(MASTER) > PottyMonsterGame_LastDesp:1
			SELECTCASE PooBarStage(MASTER)
				CASE 6
				CASE 5
				CASE 4
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Accident
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -900
		IF PottyMonsterGame_Stats:4 >= PottyMonsterGame_Stats:6
			SELECTCASE PottyMonsterGame_Stats:4
				CASE IS >= 2600
				CASE IS >= 2000
				CASE IS >= 1500
				CASE IS >= 800
				CASEELSE
			ENDSELECT
		ELSEIF PeeBarStage(MASTER) > PottyMonsterGame_LastDesp:0
			SELECTCASE PottyMonsterGame_Stats:3
				CASE IS >= 2600
				CASE IS >= 2000
				CASE IS >= 1500
				CASE IS >= 1000
				CASE IS >= 800
				CASEELSE
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Bladder Wheel
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		SELECTCASE ARG:1
			CASE 0,1
			CASE 2
			CASE 3
			CASE 4
			CASE 5
			CASE 6
			CASE 7
			CASE 8
			CASE 9
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Bowel Wheel
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SELECTCASE ARG:1
			CASE 0
			CASE 1
			CASE 2
			CASE 3
			CASE 4
			CASE 5
			CASE 6
			CASE 7
			CASE 8
			CASE 9
			CASE 10
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
