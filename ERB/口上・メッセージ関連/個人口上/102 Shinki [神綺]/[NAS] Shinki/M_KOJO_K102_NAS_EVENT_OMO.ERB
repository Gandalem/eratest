        PRINTFORMDW In a flash, you're instantly put on the toilet with your hands behind your back and restrained to the toilet seat.
        IF nOmutsu
        CALLF PANTY_REWORK_CHANGE(MASTER,104)
        PRINTFORMDW Your bottom clothing and underwear has also been removed, leaving you sitting diapered with a %SHOW_BOTTOM(MASTER)% on full display.
        ELSE
        CALLF PANTY_REWORK_CHANGE(MASTER,71)
        PRINTFORMDW Your bottom clothing and underwear has also been removed, leaving you sitting with your %SHOW_BOTTOM(MASTER)% on full display.
        ENDIF
        PRINTFORMDW As you begin to catch wind, you spot Shinki in-front, a smirk forming on her face as she lets out a small laugh, watching.
        PRINTFORMDW Also visible is a camera, pointed straight at you.
        CALL SET_KOJO_COLOR(102)
        PRINTFORMW 「Look at the little %CALLNAME:MASTER%.」
        PRINTFORMW 「I'm so sorry on what I'm going to do to you. But mommy's bored, and you were going to go potty.」
        PRINTFORMW 「Potty time is much more memorable when it's with me...」
        PRINTFORMW 「And especially when we're playing 『Desperation Roulette』, with your new fresh \@nOmutsu?pamps#pants\@ on the line!」
        PRINTFORMDW You try to struggle, but the bindings are snug tight.
        PRINTL
        PRINTFORMW 「Winning is simple, don't \@ PottyMonsterGame_HasScat ? shit # piss\@ yourself. Its going to be super hard to not do that though.」
        PRINTFORMW 「There will be 8 items each from a bladder wheel and a bowel wheel.」
        PRINTFORMW 「However though, you'll only be playing with the sides where you need to go right now, which includes your %PeeAndPoo(PottyMonsterGame_HasPiss,PottyMonsterGame_HasScat, "bladder", "bowels")%.」
        SIF nOmutsu
            PRINTFORMW 「I already diapered you, so if you just want to show me your messy potential you can do that.」 
        PRINTFORMW 「Now how many gifts can you make for me? Let's find that out!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Desperation
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -80
        IF PeeBarStage(MASTER) > PottyMonsterGame_LastDesp:0
            SELECTCASE PeeBarStage(MASTER)
            CASE 6
            CASE 5
            CASE 4
            ENDSELECT
        ENDIF
        IF PooBarStage(MASTER) > PottyMonsterGame_LastDesp:1
            SELECTCASE PooBarStage(MASTER)
            CASE 6
            CASE 5
            CASE 4
            ENDSELECT
        ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Accident
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -900

        IF PottyMonsterGame_Stats:4 >= PottyMonsterGame_Stats:6
            SELECTCASE PottyMonsterGame_Stats:4
            CASE IS >= 2600
            CASE IS >= 2000
            CASE IS >= 1500
            CASE IS >= 800
            CASEELSE
            ENDSELECT
        ELSEIF PeeBarStage(MASTER) > PottyMonsterGame_LastDesp:0
            SELECTCASE PottyMonsterGame_Stats:3
            CASE IS >= 2600
            CASE IS >= 2000
            CASE IS >= 1500
            CASE IS >= 1000
            CASE IS >= 800
            CASEELSE
            ENDSELECT
        ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Bladder Wheel
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
        SELECTCASE ARG:1
        CASE 0,1
        CASE 2
        CASE 3
        CASE 4
        CASE 5
        CASE 6
        CASE 7
        CASE 8
        CASE 9
        ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Bowel Wheel
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
        SELECTCASE ARG:1
        CASE 0
        CASE 1
        CASE 2
        CASE 3
        CASE 4
        CASE 5
        CASE 6
        CASE 7
        CASE 8
        CASE 9
        CASE 10
        ENDSELECT
		RETURN 1
	ENDIF
ENDIF

