							CALL PRINT_GPC("L", @"「%HE_SHE(17,1)%는 항상 사고로부터 어떤 형태로든 보호받고 있었다, 기저귀나 %HIS_HER(17)%의 팬티에 붙이는 패드 같은 것으로 말이다.」 ", 102)
							CALL PRINT_GPC("W", @"「%HE_SHE(17)%이 배변 훈련을 할 때마다 %HE_SHE(17)%은 소변을 보고 싶은 충동을 느꼈지만, 이내 멍해지더니 사방에 소변을 싸버렸다.」 ", 102)
							CALL PRINT_GPC("L", @"「결국 나는 %HE_SHE(17)%가 바닥에 오줌을 싸서 내가 또 갈아줘야 하는 상황이 생기는 걸 막기 위해 나만의 기저귀를 만들게 되었다.」 ", 102)
							CALL PRINT_GPC("L", @"「내가 %HIM_HER(17)%에게 절제 칩을 줬기 때문에, %HE_SHE(17)%는 계속 %HIS_HER(17)%의 바지를 적시지 않았던 것이다.」 ", 102)
							CALL PRINT_GPC("L", @"「%HE_SHE(17,1)%'는 아직 기저귀를 차고 변기에 대한 문제가 있었지만, %HES_SHES(17)%은 이제 아주 잘하고 있고 대부분의 경우에 변기에 가는 빈도가 늘었다.」 ", 102)
						ELSE
