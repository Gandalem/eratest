@M_KOJO_SUCCESS_COM_K102_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 0

@M_KOJO_MESSAGE_COM_K102_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
CALL TRAIN_MESSAGE
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K102_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K102_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
