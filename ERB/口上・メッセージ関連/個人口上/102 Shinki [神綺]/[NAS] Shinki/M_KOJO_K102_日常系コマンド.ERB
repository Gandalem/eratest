		CALL PRINT_GP("W", @"You whirl around and see... ")
		PRINTFORMDW 
		PRINTFORMDW 
		PRINTFORMDW 
		CALL PRINT_GP("W", @"Nothing. ")
		PRINTFORMDL
		CALL PRINT_GP("W", @"What were you expecting to see, anyway? Nothing can move in stopped time except you. ")
		PRINTFORML
		CALL PRINT_GP("W", @"...right? ")
		IF BASE:102:TSP
			CALL PRINT_GPC("W", @"「ＴＨＥ・ＷＯＲＬＤ！！　ＳＴＯＰ・ＴＩＭＥ！」", 102)
			PRINTL
			CALL PRINT_GP("W", @"You were dead wrong. %CALLNAME:102% can see, hear, and interact with you as if time wasn't stopped.")
			CALL PRINT_GP("W", @"Seems like %HE_SHE(102)% can stop time too.")
		ELSE
		CALL PRINT_GP("W", @"Right. %CALLNAME:102%'s just another person frozen in this state.")
		ENDIF
	ELSE
		IF BASE:102:TSP
			SELECTCASE RAND:4
			CASE 0
				CALL PRINT_GPC("W", @"「Ufufu~ Just you and me, eh?」", 102)
			CASE 1
				CALL PRINT_GPC("W", @"「I see that your TSP is working.」", 102)
				CALL PRINT_GPC("W", @"「Just don't go and start violating others, okay.」", 102)
			CASE 2
				CALL PRINT_GPC("W", @"「Hehe. I know what you're going to do.」", 102)
				CALL PRINT_GPC("W", @"「Don't do it, okay.」", 102)
			CASE 3
				CALL PRINT_GP("W", @"%CALLNAME:102% gently pokes you on the cheek, causing you to turn around.")
				CALL PRINT_GPC("W", @"「Hehe~ You bet I wouldn't notice that?」", 102)
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
