		CASE 1
			CALL PRINT_GPC("W", @"「음? 또 무슨 소리지?」 ", 102)
			CALL PRINT_GPC("W", @"「잊어버렸어. 아무튼, 이게 일어난 적 없는 걸로 하자.」 ", 102)
