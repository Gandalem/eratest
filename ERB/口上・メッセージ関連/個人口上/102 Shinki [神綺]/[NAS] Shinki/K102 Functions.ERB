	CALL PRINT_GP("W", @"너는 그게 사고였다고 설명하려 하지만 %CALLNAME:102%는 그냥 %HIS_HER(TARGET)%의 눈을 굴린다.")
	CALL PRINT_GPC("W", @"「진심이야, %CALLNAME:MASTER%? 정말로?」", 102)
	LOCALS '= "「You were trying to "
	SELECTCASE PREVCOM
		CASE 300
			LOCALS += "talk to me"
		CASE 302
			LOCALS += "rub my arms"
		CASE 301
			LOCALS += "serve me \@ K102_TeaSucks ? your piss # tea\@"
	ENDSELECT
	CALL PRINT_GPC("W", @"「하지만 당신은 그 후 그냥 \"우연히\" \@ MISCLICK_TYPE == 310 ? 내 엉덩이를 만지기 시작했나 # 모두에게 내 %PeeProtectType(102,4)%을 보여주었다. \@ 대신?」", 102)
