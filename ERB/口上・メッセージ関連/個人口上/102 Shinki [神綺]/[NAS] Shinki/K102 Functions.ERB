;retard checks to see if weapon is invalid

@K102_WeaponIsInvalid(ARG)
#FUNCTION
SELECTCASE K102_UPDATE:9
	CASE IS >= 600000000000000000
		IF !DT_CELL_GET("WeaponInventory",K102_UPDATE:9,"id",1)
			RETURNF 1
		ENDIF
	CASE IS < 0
		RETURNF 1
	CASE IS > VAR_TEMP_MAX
		SIF !STRLENS(GET_STR(102, "WeaponPreset", K102_UPDATE:9,"Name"))
			RETURNF 1
	CASE 0 TO VAR_TEMP_MAX
		SIF !STRLENS(GET_STR(102, "Weapon", K102_UPDATE:9,"名前"))
			RETURNF 1
ENDSELECT
;default gun for Mommy Shinki

@K102_GetGun
#FUNCTION
IF K102_WeaponIsInvalid(K102_UPDATE:9)
	K102_UPDATE:9 = K102_DefaultGun
ENDIF
RETURNF K102_UPDATE:9
