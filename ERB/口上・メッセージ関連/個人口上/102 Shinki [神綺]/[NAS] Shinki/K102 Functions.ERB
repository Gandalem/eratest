@K102_PampPick(ARG)
#FUNCTION
#DIM PampPick
#DIM PampStage
IF nOmutsu
	FOR PampStage,0,4
	SELECTCASE PampStage
		CASE 0
			;ko-fantasta
			PampPick = 134
		CASE 1
			;fantastabab
			PampPick = 103
		CASE 2
			;dai-diaper
			PampPick = 104
		CASE 3
			;fantastabab+
			PampPick = 171
		CASE 4
			;dai-diaper+
			PampPick = 178
	ENDSELECT
	CALLF DiapeStats(ARG,PampPick,1,1)
	IF (MAXBASE:ARG:4+1000) > RESULT:1 || (MAXBASE:ARG:Poo+1000) > RESULT:2
		CONTINUE
	ENDIF
	BREAK
	NEXT
	RETURNF PampPick
ELSE
	RETURNF 161
ENDIF

