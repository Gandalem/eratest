	CALL PRINT_GPC("W", @"「아윽! 또 이런 짓을 하다니 믿을 수가 없어!」", 102)
	IF HasPoopedSelf
		CALL PRINT_GPC("W", @"「너 바지 더러워졌어!!!」", 102)
		CALL PRINT_GPC("W", @"「뒤가 얼마나 갈색인지 봐.」", 102)
	ELSE
		CALL PRINT_GPC("W", @"「네가 팬티를 적셨어!!!」", 102)
	ENDIF
	CALL PRINT_GP("W", @"신키가 살짝 역겹다는 듯 당신을 노려보다가 갑자기 영감을 받는다.")
ENDIF
PRINTL
CALL PRINT_GPC("W", @"「음, 네가 바지 안에서 실수를 하고 싶어 한다니....」", 102)
CALL PRINT_GPC("W", @"「너에게 아마 좋을 무언가가 있어.♥」", 102)
CALL PRINT_GPC("W", @"「바닥에 엎드려, 이 더러운 바지를 벗겨야겠어」", 102)
CALL PRINT_GP("W", @"당신은 자신의 지저분함을 무시하고 땅바닥에 주저앉아 등을 기대고 누웠다.")
CALL PRINT_GPC("W", @"「알잖아, 안 그래? 진짜 아기처럼 등을 대고 누워.」", 102)
PRINTL
CALL PRINT_GP("W", @"그녀는 아기 물티슈 한 봉지를 불러내 당신에게 보여준다.")
CALL PRINT_GPC("W", @"「네 더러운 엉덩이를 닦을 물티슈가 좀 있어.」", 102)
CALL PRINT_GP("W", @"그녀는 아기 물티슈를 내려놓고 가루가 가득 담긴 병을 불러낸다.")
CALL PRINT_GPC("W", @"「신선하고 깨끗함을 유지해 줄 신상 아기 파우더.」", 102)
IF HasPoopedSelf
	CALL PRINT_GPC("W", @"「그리고 당신의 모든 오물을 담아 줄 가장 좋고 최고인 기저귀.」", 102)
	CALL PRINT_GP("W", @"그녀는 손으로 기저귀를 만졌고, 각 접촉마다 플라스틱이 바스락거렸다.")
	CALL PRINT_GPC("W", @"「얼마나 바스락거리는지.」", 102)
ELSE
	CALL PRINT_GPC("W", @"「그리고 네가 원하는 곳에 소변을 볼 수 있는 가장 좋고 최고인 팬티형 기저귀.」", 102)
	CALL PRINT_GPC("W", @"「계속 지금처럼 하면 업그레이드까지 받을지도 모른다.」", 102)
	CALL PRINT_GP("W", @"뭘로의 업그레이드인가?")
	PRINTL
	CALL PRINT_GPC("W", @"「음... 이것들을 테이프로 상상해 봐...」", 102)
	CALL PRINT_GP("W", @"우으... 정말로 네 생각이 들지는 않겠지")
	CALL PRINT_GPC("W", @"「그리고 구겨진 비닐...」", 102)
	CALL PRINT_GP("W", @"시끄럽게 바스락거리는 플라스틱 같은 것들이 잔뜩 있네.")
	CALL PRINT_GPC("W", @"「그리고 너무나 귀여운 디자인들...」", 102)
	PRINTL
	CALL PRINT_GP("W", @"Oh.")
	CALL PRINT_GP("W", @"기저귀들. 테이프형 기저귀들.")
	CALL PRINT_GP("W", @"당신은 얼굴을 새빨갛게 물들이고, 그 깨달음이 당신을 굴욕감으로 가득 채운다.")
	CALL PRINT_GPC("W", @"「너 정말 애 같구나. 그것 때문에 그렇게 부끄러울 것 없어.」", 102)
	CALL PRINT_GPC("W", @"「금방 끝날 거야.」", 102)
ENDIF
CALL PRINT_GPC("W", @"「기저귀를 차고 가야 해, 알겠지.」", 102)
CALL PRINT_GPC("W", @"「냄새가 나거나 새기 시작하면 그냥 알려줘, 내가 갈아줄게.」", 102)

