@K102_DynamicDiaper(ARG, ARGS)
#FUNCTION
#DIM changingTo
SELECTCASE ARGS
	CASE "diaper"
		changingTo = 134
		CALLF DiapeStats(0,changingTo, 1, 1)
		IF (MAXBASE:ARG:4+1000) > RESULT:1 || (MAXBASE:ARG:Poo+1000) > RESULT:2
			changingTo = 103
			CALLF DiapeStats(0,changingTo, 1, 1)
			IF (MAXBASE:ARG:4+1000) > RESULT:1 || (MAXBASE:ARG:Poo+1000) > RESULT:2
				changingTo = 104
				CALLF DiapeStats(0,changingTo, 1, 1)
				IF (MAXBASE:ARG:4+1000) > RESULT:1 || (MAXBASE:ARG:Poo+1000) > RESULT:2
					changingTo = 171
				ENDIF
			ENDIF
		ENDIF
	CASE "pull-ups"
		changingTo = 135
		CALLF DiapeStats(0,changingTo, 1, 1)
		IF MAXBASE:ARG:4 > RESULT:1 || MAXBASE:MASTER:Poo > RESULT:2
			changingTo = 74
			CALLF DiapeStats(0,changingTo, 1, 1)
			IF MAXBASE:MASTER:4 > RESULT:1 || MAXBASE:MASTER:Poo > RESULT:2
				changingTo = 164
				CALLF DiapeStats(0,changingTo, 1, 1)
			ENDIF
		ENDIF
	CASEELSE
		changingTo = 161
ENDSELECT
RETURNF changingTo
