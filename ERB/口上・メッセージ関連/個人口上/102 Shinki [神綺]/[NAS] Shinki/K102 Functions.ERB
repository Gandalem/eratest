	CALL PRINT_GPC("W", @"「메타 월드에서는 그것을 미스클릭이라고 부르는데, 원치 않았던 옵션을 선택하는 것이 바로 그때다.」", 102)
	CALL PRINT_GPC("W", @"「그냥... 다시는 그러지 마.」", 102)
ELSEIF FIRSTTIME("ShinkiMisclick2")
	;second time
	CALL PRINT_GPC("W", @"「You \"accidentally\" \@ MISCLICK_TYPE ? grabbed my %COND_STR("diapered ",IsPadded(102))%ass # showed my %COND_STR("diapered ",IsPadded(102))%crotch\@ off to the world AGAIN?」", 102)
	IF CAN_ACCIDENT(MASTER,1) || CAN_ACCIDENT(MASTER,2)
		CALL PRINT_GPC("W", @"「다음번에 나는 \"우연히\" 너에게 사고를 치게 만들 거야!」", 102)
	ELSE
		CALL PRINT_GPC("W", @"「다음번에 난 \"실수로\" 너에게 교훈을 주게 만들 거야!」", 102)
	ENDIF
ELSE
