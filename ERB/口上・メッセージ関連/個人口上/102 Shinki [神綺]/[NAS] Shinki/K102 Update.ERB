@K102_CONFIGURE_STATE
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "MENTAL", "PHYSICAL", "FETISHES", "WORLD"
;
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
IF !K102_UPDATE:9
	K102_UPDATE:9 = 1
	CALLF K102_Defaults
ENDIF
FONTITALIC
FONTBOLD
PRINTFORMDL %CALLNAME:102% 투표 업데이트
IF VINUM_OMOGATARI_FEATURE_CHECK()
	PRINTFORMDL %NASTitleSTR_Only()% 에디션
ELSE
	PRINTFORMDL 네오데브 에디션
ENDIF
PRINTFORMDL 마카이 시티, 마카이
PRINTFORMDL %PRINT_DATE_F(DAY)%
FONTREGULAR
PRINTL
FONTITALIC
PRINTFORMDL 투표 기재 지침:
PRINTFORMDL A. 제공된 기기(marking device)를 이용하여 선택한 항목을 표시한다.
PRINTFORMDL B. 허가된 경우, 타 후보에게 기재할 수 있으며 원 안에 이름을 쓰고 'Write-in' 줄에 이름을 적는다.
PRINTFORMDL C. 이 투표지를 찢거나, 더럽히거나, 잘못 기재한 경우에는 교체를 요청하기 위해 반납한다.
FONTREGULAR
PRINTL
DRAWLINE
;CALL SET_KOJO_COLOR(60)
TRYCALLFORM K102_SETTING_%DISP_NAME:PAGE%
DRAWLINE
RESETCOLOR
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
PRINTBUTTON CAP_PROCESS(TOLOWER(REPLACE(DISP_NAME:LOCAL,"_"," ")),5), LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML 
PRINTBUTTON "[999] 양식 제출 ", 999
PRINTBUTTON "[998] 양식 초기화", 998
DO
INPUT
SELECTCASE RESULT
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE 998
		CALLF K102_DEFAULTS
	CASE 999 ;custom code
		RETURN 9999
	CASEELSE
		$RETRY
		;TRYCALLFORM K102_SETTING_RESULT_%DISP_NAME:PAGE%(RESULT)
		LOCAL:1 = RESULT/100
		LOCAL:2 = RESULT % 100
		K102_UPDATE:(LOCAL:1) = LOCAL:2
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

