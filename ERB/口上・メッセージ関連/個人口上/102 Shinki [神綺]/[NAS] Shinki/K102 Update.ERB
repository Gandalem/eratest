@K102_CONFIGURE_STATE
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "MENTAL", "PHYSICAL", "FETISHES", "WORLD"
;
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
IF !K102_UPDATE:9
	K102_UPDATE:9 = 1
	CALLF K102_Defaults
ENDIF

FONTITALIC
FONTBOLD
PRINTFORMDL %CALLNAME:102% Update Ballot
IF VINUM_OMOGATARI_FEATURE_CHECK()
PRINTFORMDL %NASTitleSTR_Only()% Edition
ELSE
PRINTFORMDL Neodev Edition
ENDIF
PRINTFORMDL Makai City, Makai
PRINTFORMDL %PRINT_DATE_F(DAY)%
FONTREGULAR
PRINTL
FONTITALIC
PRINTFORMDL BALLOT MARKING INSTRUCTIONS:
PRINTFORMDL A. With the marking device provided, select your choice as shown.
PRINTFORMDL B. Where authorized, you may write in a candidate by filling in the oval and writing the name on the Write-in line.
PRINTFORMDL C. If you tear, deface or wrongly mark this ballot, return it to request a replacement.
FONTREGULAR
PRINTL
DRAWLINE
;CALL SET_KOJO_COLOR(60)
TRYCALLFORM K102_SETTING_%DISP_NAME:PAGE%
DRAWLINE
RESETCOLOR
FOR LOCAL, 0, VARSIZE("DISP_NAME")
	SIF PAGE == LOCAL
		SETCOLOR 0x00FFFF
	PRINTBUTTON CAP_PROCESS(TOLOWER(REPLACE(DISP_NAME:LOCAL,"_"," ")),5), LOCAL + 8002
	RESETCOLOR
	PRINTFORM 　　
NEXT
PRINTFORML 
PRINTBUTTON "[999] Submit Form ", 999
PRINTBUTTON "[998] Reset Form", 998
DO
	INPUT
	SELECTCASE RESULT
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE 998
		CALLF K102_DEFAULTS
	CASE 999 ;custom code
		RETURN 9999
	CASEELSE
		$RETRY
		;TRYCALLFORM K102_SETTING_RESULT_%DISP_NAME:PAGE%(RESULT)
		LOCAL:1 = RESULT/100
		LOCAL:2 = RESULT % 100
		K102_UPDATE:(LOCAL:1) = LOCAL:2
	ENDSELECT
	BREAK
LOOP 1
GOTO REPRINT


