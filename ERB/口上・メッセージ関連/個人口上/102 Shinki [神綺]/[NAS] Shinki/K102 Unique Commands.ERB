@ShinkiCreate
#DIM nDiscount
#DIM nItem
VARSET nDiscount

CALL SET_KOJO_COLOR(102)
PRINTFORM 「Give me an Item ID, and if it corresponds to a valid item, I can create it for you for 

IF TALENT:102:221 || TALENT:102:222 || TALENT:102:Family || MASTER == 102
nDiscount = 100
ELSEIF TALENT:102:7
nDiscount = 90
ELSEIF TALENT:102:3
nDiscount = 80
ELSEIF TALENT:102:8
nDiscount = 50
ENDIF

SIF nDiscount
PRINTFORM {nDiscount}\% off 

PRINTFORML it's market value」
PRINTL
PRINTFORMDL [-1] - Cancel
INPUT
RESETCOLOR
nItem = RESULT
SELECTCASE RESULT
CASE -1
RETURN 0
CASE IS >= VARSIZE("ITEMNAME")
		CALL SET_KOJO_COLOR(102)
		PRINTFORMW 「That's out of my range.」
		RESTART
CASEELSE
	IF ITEMNAME_TR(nItem) == ""
		CALL SET_KOJO_COLOR(102)
		PRINTFORMW 「I do not know what {nItem} is meant to be.」
		RESTART
	ENDIF

	IF ITEM:nItem < 所持数制限
		ITEMSALES:nItem = 所持数制限
		CALL SET_KOJO_COLOR(102)
		PRINTFORML 「Creating one %ITEMNAME_TR(nItem)% will cost you %金額表示(ITEMPRICE:nItem * (100-nDiscount)/100)%\@ nDiscount ?  ({nDiscount}\% discount) # \@」
		PRINTFORMDL Available money: %金額表示(MONEY)%
		RESETCOLOR
		CALL ITEM_MATOMEGAI(nItem, nDiscount)
	ELSE
		CALL SET_KOJO_COLOR(102)
		PRINTFORMW 「It looks like you have too much of it already. I can't create any more if you can't carry it with you..」
		RESTART
	ENDIF
ENDSELECT


