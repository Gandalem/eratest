RESETCOLOR
nItem = RESULT
SELECTCASE RESULT
	CASE -1
		RETURN 0
	CASE IS >= VARSIZE("ITEMNAME")
		CALL SET_KOJO_COLOR(102)
		PRINTFORMW 「내 사정 밖이다.」
		RESTART
	CASEELSE
		IF ITEMNAME_TR(nItem) == ""
			CALL SET_KOJO_COLOR(102)
			PRINTFORMW 「내가 {nItem}이 무엇을 의미하는지 모르겠다.」
			RESTART
		ENDIF
		IF ITEM:nItem < 所持数制限
			ITEMSALES:nItem = 所持数制限
			CALL SET_KOJO_COLOR(102)
			PRINTFORML 「하나 만드는 것은 %ITEMNAME_TR(nItem)% 너에게 비용이 들 것이다 %金額表示(ITEMPRICE:nItem * (100-nDiscount)/100)%\@ nDiscount ? ({nDiscount}\% 할인) #  \@」
			PRINTFORMDL 사용 가능한 금액: %金額表示(MONEY)%
			RESETCOLOR
			CALL ITEM_MATOMEGAI(nItem, nDiscount)
		ELSE
			CALL SET_KOJO_COLOR(102)
			PRINTFORMW 「이미 너무 많이 가진 것 같아. 네가 그걸 들고 다닐 수 없다면 더 이상 만들 수가 없어..」
			RESTART
		ENDIF
ENDSELECT

