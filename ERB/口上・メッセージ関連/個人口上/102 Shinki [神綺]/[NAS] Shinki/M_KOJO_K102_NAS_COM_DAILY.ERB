;988, Doctoring
;==================================================
@M_KOJO_MESSAGE_CUSTOM_COM_K102_988
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_CUSTOM_COM_K102_988_1
RETURN RESULT

@M_KOJO_MESSAGE_CUSTOM_COM_K102_988_1
;-------------------------------------------------
;Enabled（=0, Disabled、1, Enabled）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
    ;-------------------------------------------------
    ;Sublevels
    ;-------------------------------------------------
    ;First Time
    ;Enabled
    LOCAL:1 = 0
    ;-------------------------------------------------
    IF LOCAL:1 && FIRSTTIME(Add_Custom_COM_To_Number(ADD_SELECTCUSTOMCOM))
		RETURN 1
    ENDIF
	;Set

	;Healing
	IF GETBIT(TFLAG:194,0)
	ENDIF
	;Bionic Add
	IF GETBIT(TFLAG:194,1)
	ENDIF
	;Natural Part Add
	IF GETBIT(TFLAG:194,2)
	ENDIF
	;Harvest Success
	IF GETBIT(TFLAG:194,3)
	ENDIF
	;Harvest Fail
	IF GETBIT(TFLAG:194,4)
	ENDIF
ENDIF
RETURN 1

