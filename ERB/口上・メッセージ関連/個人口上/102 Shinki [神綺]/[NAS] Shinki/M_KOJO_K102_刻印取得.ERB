	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	CALL HPH_PRINT(@"「%CALLNAME:MASTER% HPH %CALLNAME:MASTER% HPH %CALLNAME:MASTER% HPH %CALLNAME:MASTER% HPH %CALLNAME:MASTER%～～～～～～～HPHHPHHPHHPH」", "W")
	CALL HPH_PRINT(@"「이게... 내가 놓치고 있던 거였나 HPH」", "W")
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
