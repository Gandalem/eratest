	FOR LOCAL,0, 3
	CALL PlayFireSound(102)
	BASE:MASTER:0 -= charaWeaponInts:102:Damage
	CALLF BroadDamage(MASTER,"thorax",charaWeaponInts:102:Damage,1,102,TOSTR(EQUIP:102:Weapon))
	TWAIT 333, 1
	NEXT
	CFLAG:MASTER:現在位置 = KICKOUT()
	IF BASE:MASTER:0 < 500
		IF nNecro
			KilledBy:MASTER:0 = 102
			KilledWith:MASTER:0 = {EQUIP:102:Weapon}
			CALL M_KOJO_COLOR_K102
			PRINTFORMDW 고통이 당신을 바닥으로 내던진다. 총상에서 피를 흘리며 움직일 수 없게 된다.
			PRINTFORMW 「빌어먹을 한심함.」
			PRINTFORMW 「나의 몇 발에 버티지 못한다면, 레이에서도 살아남을지 모르겠군.」
			SETCOLOR C_RED
			CALL KEYTYPING(@"「술이나 마시며 편히 쉬어라.」", "W", 300)
			CALL M_KOJO_COLOR_K102
			PRINTFORMDW %CALLNAME:102%은(는) 당신의 머리 위에 %HIS_HER(102)%를/을 %GET_STR(102, "Weapon", EQUIP:102:Weapon, "名前")% 놓는다.
			PRINTFORMDW 사악한 미소를 지으며, %HE_SHE(102)%가 방아쇠를 당긴다. 
			VARSET LOCAL
			WHILE !IsDead:MASTER:0
			LOCAL ++
			IF LOCAL == 3
				FONTITALIC
				SETCOLOR C_RED
				CALL KEYTYPING(@"「ＷＨＹ　ＷＯＮＴ　ＹＯＵ　ＤＩＥ・・・・」", "W", 500)
				FONTREGULAR
			ELSEIF LOCAL == 6
				FONTITALIC
				SETCOLOR C_RED
				CALL KEYTYPING(@"「ＴＨＩＳ　ＩＳ　ＲＩＤＩＣＩＬＯＵＳ・・・・」", "W", 500)
				FONTREGULAR
			ENDIF
			CALL PlayFireSound(102)
			CALLF BroadDamage(MASTER,"head",charaWeaponInts:102:Damage,1,102,TOSTR(EQUIP:102:Weapon))
			TWAIT 1000, 1
			CALL CrippleEffects(MASTER)
			WEND
		ELSE
			PRINTFORMDW 고통이 당신을 바닥으로 내동댕이쳤고, 총상에서 피를 흘리며 움직일 수 없었다.
			PRINTFORMW 「나는 너를 이 세상에서 몰아내고 싶지만, 그것이 허락하지 않아 그럴 수 없어.」
			PRINTFORMDW %CALLNAME:102%은(는) 당신을 땅 위에서 피 흘리도록 내버려 둔다.
		ENDIF
	ELSE
		CALL M_KOJO_COLOR_K102
		PRINTFORMDW 도망치면서, 당신은 몇몇 다른 마카이 연합 병사들이 소환된 것을 알아차린다.
		PRINTFORMDW %HE_SHE(102,1)%는 그것에 대해 정말로 옳았다...
		PRINTFORMDW 그들의 소총은 당신을 향하고 있다. 한 병사가 당신에게 다가오기 위해 앞으로 움직였다.
		PRINTFORML ・
		PRINTFORML ・・		
		PRINTFORMW ・・・
		PRINTFORMW 「발포 정지!」
		PRINTFORMDW 연합군 병사들이 소총을 내린다. 홀로 남은 병사가 뒤로 물러난다.
		PRINTFORMW 「%NAME:MASTER%에 수배를 걸어라. 만약 %HIM_HER(MASTER)%를 본다면, 즉시 사격해라.」
		PRINTFORMW 「지금으로서는 %HIM_HER(MASTER)%를 놓아두자.」
	ENDIF
ELSEIF TFLAG:21 == 5
	SETCOLOR C_RED
	PRINTFORMDW %CALLNAME:102%은(는) %HIS_HER(102)% 팔꿈치로 당신의 목을 잡고 질식시키기 시작한다.
	PRINTFORMW 「너 같은 죄인이 나를 WORDS로 용서할 수 있다고 생각하나?」
	PRINTFORMW 「행동이 말보다 크게 들리고, 그것은 네가 이해할 수 없는 것이다.」
	PRINTL
	PRINTFORMW 「네 세계에 내가 뭘 할 수 있는지 알아!?」
	PRINTFORMW 「나는 모든 것을 바꿀 수 있다. 누구든. 어떤 방식으로든.」
	PRINTFORMW 「너의 여자들을 한 번에 모두 죽일 수 있다.」
	PRINTL
	PRINTFORMW 「나를 믿지 못하겠어?」
	PRINTFORMW 「이것을 봐!」
	FOR LOCAL, 0, CHARANUM
	SIF GROUPMATCH(LOCAL,102,MASTER) || CharaFamily:102:LOCAL
		CONTINUE
	MAXBASE:LOCAL:0 = -1
	BASE:LOCAL:0 = MAXBASE:LOCAL:0
	NEXT
	PRINTL
	PRINTFORMDW 당신과 %CALLNAME:102%를 제외한 모두가 쓰러진다...
	PRINTFORMDW 수백 명이 동시에 혼수상태로 쓰러지면서 근육조가 진동한다.
	PRINTFORMDL 당신은 공포에 질려, 당신의 세상에 무슨 일이 일어나고 있는지 이해할 수 없다...
	FORCEWAIT
	PRINTL
	PRINTFORMW 「네 빌어먹을 여자들 전부 불구로 만들어 버렸어」
