; Modular ERB: 個人口上/102 Shinki [神綺]/[NAS] Shinki/M_KOJO_K102_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K102_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIMS WeapUsed, 2
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		LOCAL:10 = ABL:MASTER:戦闘能力 - ABL:TARGET:戦闘能力
		IF LOCAL:10 < 0
			LOCAL:10 *= -2
		ELSE
			LOCAL:10 *= 2
		ENDIF
		HANDICAP_FIXED = LOCAL:10
		HANDICAP_RAND = 100
		IF lcIsLethal
		ELSE
			IF MARK:TARGET:反発刻印 > 0
				PRINTFORML 「단막(彈幕)?」
				PRINTFORMW 「네가 나에게 한 짓 이후로는 네 어리석은 단막 규칙을 따르지 않을 거야.」
				PRINTFORMW 「마카이에서는 그런 것들이 적용되지 않아.」
				PRINTFORMW 「"만약 네가 네 '규칙'대로 행동하려 한다면, 극단적인 퇴마를 해주러 갈지도 몰라."」 
				PRINTFORMDW %CALLNAME:102%는 차갑게 미소 짓는다.
				PRINTFORMW 「너는 방금 내 또 다른 실험의 먹잇감이 된 것뿐이야.」
				SIF MARK:TARGET:反発刻印 >= 3
					PRINTFORMW 「경고해 두겠다... 네 목숨이 걸려 있다.」
				;*War Season intensifies*
				HANDICAP_FIXED = HANDICAP_FIXED * (3 * MARK:TARGET:反発刻印)
			ELSE
				PRINTFORML 「단막?」
				PRINTFORML 「그거는 동방의 실제 전투 레벨과는 전혀 관련 없는 아이들 게임이야.」
				PRINTFORML 「너 같은 사람들이 나한테 싸달라고 조르다가 내가 안 된다고 하면 우는 것들 때문에 하는 거지.」
				PRINTFORML 「난 정말 하고 싶지 않지만, 그래도 할 거야.」
				PRINTFORML 「경고하는데, A랭크가 "A" 랭크라는 뜻은 아니야.」
				IF ABL:MASTER:戦闘能力 > ABL:TARGET:戦闘能力 + 3
					PRINTFORMW 「『강자는 약자를 해친다』고들 하지」
					PRINTFORMW 「음, 그건 바뀌게 될 거야. 아마도…」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 비열한 표정을 지으며 비웃는다.
					PRINTFORMW 「최악의 경우라면…」
				ELSEIF ABL:MASTER:戦闘能力 < ABL:TARGET:戦闘能力 - 3
					PRINTFORMW 「아우... 내 작은 자식은 단마쿠를 하고 싶어 하나?」
					PRINTFORMW 「%HE_SHE(MASTER)%는 %HIS_HER(MASTER)%의 장난감에 질려서 한 번쯤 큰 아이가 되고 싶은 걸까?」
					PRINTFORMDW %CALLNAME:102%는 당신에게 다시 말을 걸기 전에 %HIS_HER(102)%의 마음을 정리했다.
					PRINTFORMW 「그리고 이제, 너의 심판이 시작될 것이다... 지금.」
				ELSE
					PRINTFORML 「준비해라, 그렇지 않으면 전멸이다.」
				ENDIF
			ENDIF
			PRINTFORMW
			PRINTFORMDL %CALLNAME:102%가 공중에 떠서 %HE_SHE(102)%가 자세를 잡는다...
			PRINTFORML
			PRINTDATAW
				DATAFORM 「무슨 일이 있어도 대비해라!」
				DATAFORM 「나는 스펠 카드로 놀지 않아, 내가 스펠 카드를 만든다!」
				DATAFORM 「『병법』을 알든가, 아니면 네 다가오는 파멸을 알든가!」
				DATAFORM 「이걸 흥미진진하게 만들어야 할 거다!」
			ENDDATA
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't apply if the character's handicap is 0)
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 「이 전투를 위해 일부러 자신을 약하게 만든 거군.」
		PRINTFORMW 「그것 네가 내린 최선의 생각은 아니었어.」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Hit
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			;Lethal Combat:
			;3 -> > 66%
			;2 -> > 33%
			;1 -> > 0
			;0 -> Knockout (not kill)
			CASE 5
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「저기서 뭘 하고 있는 거니?」
						PRINTFORMDL %CALLNAME:102%는 날 엄격하게 바라본다.
					CASE 1
						PRINTFORML 「스스로 더럽히고 있니? 그래야지. 우후후~」
					CASE 2
						PRINTFORML 「그래, 네 구석에 가만히 있어라.」
						PRINTFORML 「내가 그냥 너를 공격해서 지금 끝낼 수 있는 것도 아니니까.」
					CASE 3
						PRINTFORML 「너는 흥미 없는 싸움꾼이군.」
						PRINTFORMDL %CALLNAME:102%가 한숨을 쉬었다.
					CASE 4
						PRINTFORML 「나는 너를 빙글빙글 돌릴 수 있고, 너는 가만히 서 있기만 하면 돼.」
				ENDSELECT
			CASE 4
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「와, 드디어 뭔가 하려고 결정한 거야, 응?」
					CASE 1
						PRINTFORML 「...」
						PRINTFORML 「더 노력해라.」
					CASE 2
						PRINTFORML 「Ow.」
						PRINTFORML 「네가 쓰는 완두콩 발사기 정말 아프잖아!」
						PRINTFORMDL %CALLNAME:102%는 그냥 %HES_SHES(102)%가 연기하는 것 같다.
					CASE 3
						PRINTFORML 「더 나은 것을 얻어라.」
					CASE 4
						PRINTFORML 「네가 쓰는 걸로 나를 막을 수 있을 거라고 생각하나, 응.」
					CASE 5
						PRINTFORML 「헤헤~ 간지러워.」
				ENDSELECT
			CASE 3
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「아! 그럼 나도 더 힘을 내야겠군.」
					CASE 1
						PRINTFORML 「아직 끝나지 않았어, 이걸 어때?」
					CASE 2
						PRINTFORML 「오우 오우 오우!」
						PRINTFORML 「정말 짜증 나기 시작했어.」
					CASE 3
						PRINTFORML 「흥! 이건 장난이 아닌 것 같군.」
						PRINTFORML 「이제 진지하게 임해야겠어.」
					CASE 4
						PRINTFORML 「윽!」
						PRINTFORML 「정말 아프기 시작했다.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아, 맞았다고?! 하지만 아직 끝나지 않았어!」
					CASE 1
						PRINTFORML 「아얏! 아프다」
						PRINTFORML 「하지만 아직 끝나지 않았다고 생각하지 마라.」
					CASE 2
						PRINTFORML 「나에게 꽤 많은 피해를 입혔군.」
						PRINTFORML 「계속해라, 아니면 하지 마라.」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「나 끝난 건가?」
					CASE 1
						PRINTFORML 「이걸 쓰게 만들지 마라!」
					CASE 2
						PRINTFORML 「아직이야, 아직 끝나지 않았어, %CALLNAME:MASTER%!!」
					CASE 3
						PRINTFORML 「뭐라고!? 불가능해!」
					CASE 4
				ENDSELECT
			CASE 0
				IF lcIsLethal
					SELECTCASE RAND:5
						CASE 0
							PRINTFORML 「갸아악~!!」
						CASE 1
							PRINTFORML 「N- 노오오오오~~!!」
						CASE 2
							PRINTFORML 「아아아악~~~~!!」
						CASE 3
							PRINTFORML 「이게 전부구나.... 이게 끝인가...」
						CASE 4
							PRINTFORML 「뭐라고?! 아윽... 내 상대가 나타났군...」
						CASE 5
							PRINTFORML 「아아아악 아프다아아아아!!!」
							PRINTFORMDL %CALLNAME:102%은 땅 위에서 구르며 고통에 몸부림친다.
					ENDSELECT
				ELSE
					PRINTFORML 「뭐라고?! 아윽... 내 상대가 나타났군...」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;Merciless
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;All in
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF lcIsLethal
		ELSE
			$AttackLOOP
			SELECTCASE RAND:10
				CASE 0
					PRINTFORMDW 소환 서명 「끝없는 도플갱어」!!!
					PRINTFORMDW 갑자기 %CALLNAME:102%가 2, 4, 8...로 분열한다.
					PRINTFORMDW 진짜 버전과 복제본을 구분할 수 있을 정도로 너무 많다.
					HANDICAP_FIXED += 3000
				CASE 1
					PRINTFORMDW 마법의 속박 「마법적 감금」!!!
					PRINTFORMDW 전투 아레나가 줄어들어 %CALLNAME:102%의 총알을 피하기가 더욱 어려워진다.
					HANDICAP_FIXED += 1000
				CASE 2
					PRINTFORMDW —사방으로 퍼지는 사격「옴니프레전트 샷건」!!!
					PRINTFORMDW %CALLNAME:102%와 %HIM_HER(102)% 주변의 지역이 전투 경기장 전체에 단막을 발사한다.
					PRINTFORMDW 당신에게 그렇게 많은 탄환이 난다 보니 %HIS_HER(102)%의 총알을 피하기가 극도로 어려워졌다.
					HANDICAP_FIXED += 2000
				CASE 3
					IF !nPee && !nScat
						GOTO AttackLOOP
					ENDIF
					PRINTFORMDW --사건 징조 「죽지 않는 절망」!!!
					PRINTFORMDW 방광과 장이 불편할 정도로 가득 차서 화장실을 갈 수가 없다.
					PRINTFORMDW 터질 것 같은 기분이 들지만, 고통스럽게 버텨야 한다...
					CALLF PeeMe(MASTER)
					HANDICAP_FIXED += 1000
				CASE 4
					PRINTFORMDW --장벽 부호 「화염폭탄」!!!
					PRINTFORMDW 전투장에 불덩이 세례가 퍼진다.
					PRINTFORMDW 그것은 경기장을 완전히 뒤덮어 모든 것을 보기가 극도로 어려워졌다.
					HANDICAP_FIXED += 200
				CASE 5
					PRINTFORMDW --산탄 「무한 가위 작업」!!!
					PRINTFORMDW 소유된 가위가 영역을 뒤덮고 스스로 열리고 닫힌다.
					PRINTFORMDW 그 가위에 부딪히는 것이 게임을 즉시 끝낼 것만 같다.
					HANDICAP_FIXED += 1000
				CASE 6
					CALL MESSAGE_COM355
					IF MAXBASE:MASTER:TSP
						PRINTFORMDW 당신과 %CALLNAME:102%를 제외한 모든 것이 멈춘다.
						PRINTFORMDW %CALLNAME:102%는 시간을 멈출 시간이 있는가?
						PRINTFORMDW 당신은 여전히 움직일 수 있지만, %CALLNAME:102%는 계속 움직이며 공격하고 있다.
						PRINTFORMDW 분명 이것은 %HE_SHE(102)%가 당신과 같은 힘을 가졌음을 확고히 하기 위함이다.
					ELSE
						PRINTFORMDW 방금 무슨 일이 일어난 거지?
						PRINTFORMDW %CALLNAME:102%가 사라졌어!
					ENDIF
				CASE 7
					PRINTFORMDW 파워 스틸 「에스퍼 드레인」!!!
					PRINTFORMDW 갑자기 마법 능력이 상당히 약해진 것처럼 느껴진다
					PRINTFORMDW 공중에 떠 있는 것이 힘들어한다.
					BASE:MASTER:TSP /= 2
					BASE:MASTER:7  /= 2
					HANDICAP_FIXED *= 2
				CASE 8
					PRINTFORMDW 심령의 시야 「암흑 전장」!!!
					PRINTFORMDW 세상이 암흑으로 변하며 아무것도 볼 수 없게 된다.
					PRINTFORMDW 하지만 무슨 일이 일어나고 있는지는 들을 수 있지만, 이것은 %CALLNAME:102%가 거의 불가능하게 만들 것이다.
					HANDICAP_FIXED += 5000
				CASE 9
					PRINTFORMW 「농담이야, 공짜 비마법 카드 한 번 줄게.」
					PRINTFORMW 「잘 써라, 이 기회를 헛되이 보내지 마.」
			ENDSELECT
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORMDW ――배리어 사인 「변칙, 힘, 무질서, 그리고 영혼」!!!
		PRINTFORMDW 그거 단마쿠 스킬의 일반적인 이름 아닌가?
		PRINTL
		PRINTFORMDW 상관없다. 그것이 %HIM_HER(102)%에게 총알이 맞지 않게 쉽게 막았기 때문이다.
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF lcIsLethal
		ELSE
			SELECTCASE 相手残機
				CASE 4
					PRINTFORML 「한 방도 못 맞췄군. 궁극의 마법사와 겨룰 만해지려면 몇 년은 더 필요할 거다.」
				CASE 3
					PRINTFORML 「나에게 단 한 번이라도 명중시키려 하다니... 너도 꽤 괜찮구나, 다음에 또 대결하자.」
				CASE 2
					PRINTFORML 「두 개를 얻어냈군.」
					PRINTFORML 「인상적이긴 하지만, 충분히 인상적이지 않아.」
				CASE 1
					PRINTFORML 「휴~... 조금만 더 버텼으면 끝났을 텐데.」
					PRINTFORML 「다음에 이길지도 몰라, 알잖아?」
				CASE 0
					PRINTFORML 「질 수 있다니......」
					PRINTFORML 「모든 것을 했고, 모든 것을 소환했건만, 당신은 용감하게 나를 뚫어냈군요.」
					PRINTFORML 「좋은 대전이었다. 다음에 또 하자.」
			ENDSELECT
		ENDIF
		IF HANDICAP_FIXED >= 10
			IF lcIsLethal
				IF STRCOUNT(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blunt") || STRCOUNT(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade")
					WeapUsed:0 '= "근접 공격"
				ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type"),"Firearm","Explosive","Bow") && EQUIP:MASTER:Weapon
					WeapUsed:0 '= "사격"
				ELSE
					WeapUsed:0 '= "전투 경험"
				ENDIF
				IF STRCOUNT(GET_STR(102, "Weapon", EQUIP:102:Weapon, "Class"), "Blunt") || STRCOUNT(GET_STR(102, "Weapon", EQUIP:102:Weapon, "Class"), "Blade")
					WeapUsed:1 '= "근접 공격"
				ELSEIF GROUPMATCH(GET_STR(102, "Weapon", EQUIP:102:Weapon, "Type"),"Firearm","Explosive","Bow") && EQUIP:102:Weapon
					WeapUsed:1 '= "사격"
				ELSE
					WeapUsed:1 '= "전투 경험"
				ENDIF
			ELSE
				WeapUsed:0 '= "전투 경험"
				WeapUsed:1 '= "전투 경험"
			ENDIF
			PRINTFORML
			PRINTFORMDW %CALLNAME:102%는 농담이 아니었어, 정말로...
			PRINTFORMDW 앞으로의 조우를 위해 상당히 많은 유용한 기교들을 배운 것 같아.
			LOCAL = LIMIT((HANDICAP_FIXED / 10), 1, 100)
			CALL AddEXP(@"%WeapUsed%", MASTER, LOCAL)
			PRINTFORMDW %CALLNAME:102%도 꽤 많은 것을 배운 것 같았다.
			CALL AddEXP(@"%WeapUsed:1%", 102, MULTIPLY(LOCAL, 150))
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
