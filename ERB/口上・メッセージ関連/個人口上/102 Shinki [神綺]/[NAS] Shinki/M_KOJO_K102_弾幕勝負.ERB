;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESSAGE_COM_K102_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIMS WeapUsed, 2
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
        HANDICAP_FIXED = 0
        HANDICAP_RAND = 0
        LOCAL:10 = ABL:MASTER:戦闘能力 - ABL:TARGET:戦闘能力
        IF LOCAL:10 < 0
            LOCAL:10 *= -2
        ELSE
             LOCAL:10 *= 2
        ENDIF
        HANDICAP_FIXED = LOCAL:10
        HANDICAP_RAND = 100

		IF lcIsLethal
		ELSE
			IF MARK:TARGET:反発刻印 > 0
				PRINTFORML 「Danmaku?」
				PRINTFORMW 「After what you did to me, I will NOT be abiding to your stupid danmaku rules.」
				PRINTFORMW 「They don't even apply here over at Makai.」
				PRINTFORMW 「I will probably go and give you an extreme exorcism if you do try to play by your "rules".」 
				PRINTFORMDW %CALLNAME:102% smiles coldly.
				PRINTFORMW 「You've just fallen for another one of my experiments.」
				SIF MARK:TARGET:反発刻印 >= 3
					PRINTFORMW 「Be warned... Your life is on the line.」
					;*War Season intensifies*
				HANDICAP_FIXED = HANDICAP_FIXED * (3 * MARK:TARGET:反発刻印)
			ELSE
				PRINTFORML 「Danmaku?」
				PRINTFORML 「It's a kids game that's completely unrelated to the actual combat level of a Touhou.」
				PRINTFORML 「I only do it because of guys like you asking to battle me and crying when I tell you no.」
				PRINTFORML 「I really don't like to play, but  but we'll do it anyway.」
				PRINTFORML 「Just be warned, A rank doesn't mean "A" rank.」
				IF ABL:MASTER:戦闘能力 > ABL:TARGET:戦闘能力 + 3
					PRINTFORMW 「『The strong prey off the weak』, as they say」
					PRINTFORMW 「Well, that is going to change. Most likely...」
					PRINTFORMDW %CALLNAME:TARGET% smirks, giving an evil face.
					PRINTFORMW 「For the worst...」
				ELSEIF ABL:MASTER:戦闘能力 < ABL:TARGET:戦闘能力 - 3
					PRINTFORMW 「Aww... Does my little wanna play Danmaku?」
					PRINTFORMW 「Does %HE_SHE(MASTER)% get tired of %HIS_HER(MASTER)% toys and wanted to be a big kid for once?」
					PRINTFORMDW %CALLNAME:102% clears up %HIS_HER(102)% mind before speaking to you again.
					PRINTFORMW 「And so, your reckoning will begin... now.」
				ELSE
					PRINTFORML 「Be ready, or be decimated.」
				ENDIF
			ENDIF
        PRINTFORMW
        PRINTFORMDL %CALLNAME:102% hovers in the air as %HE_SHE(102)% gets into position...
        PRINTFORML
        PRINTDATAW
            DATAFORM 「Be prepared for anything!」
            DATAFORM 「I don't play with spell cards, I make spell cards!」
            DATAFORM 「Know the『Art of War』, or know your imminent doom!」
            DATAFORM 「You'd better make this interesting!」
        ENDDATA		
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't apply if the character's handicap is 0)	
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 「You've purposely gimped yourself for this fight.」
		PRINTFORMW 「Not the best idea that you had.」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Hit
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			;Lethal Combat:
			;3 -> > 66%
			;2 -> > 33%
			;1 -> > 0
			;0 -> Knockout (not kill)
			CASE 5
				SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「What are you doing over there?」
					PRINTFORMDL %CALLNAME:102% gives you a stern look.
				CASE 1
					PRINTFORML 「Are you soiling yourself? You should be. Ufufu〜」
				CASE 2
					PRINTFORML 「Yea, stay at your corner and do nothing.」
					PRINTFORML 「It's not like I can just attack you and end this right now.」
				CASE 3
					PRINTFORML 「You are one uninteresting fighter.」
					PRINTFORMDL %CALLNAME:102% sighs.
				CASE 4
					PRINTFORML 「I can spin circles around you and all you're going to do is stand there.」
				ENDSELECT
			CASE 4
				SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「Wow, you finally decided to do something, huh?」
				CASE 1
					PRINTFORML 「...」
					PRINTFORML 「Try harder.」
				CASE 2
					PRINTFORML 「Ow.」
					PRINTFORML 「This peashooter you're using really is hurting!」
					PRINTFORMDL %CALLNAME:102% looks like %HES_SHES(102)% just playing an act.
				CASE 3
					PRINTFORML 「Get something better.」
				CASE 4
					PRINTFORML 「You think what your using is going to stop me, huh.」
				CASE 5
					PRINTFORML 「Hehe〜 It tickles.」
				ENDSELECT
			CASE 3
				SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「Ah! It's time for me to step it up then.」
				CASE 1
					PRINTFORML 「It's not over yet, how about this?」
				CASE 2
					PRINTFORML 「Ow ow ow!」
					PRINTFORML 「You're really starting to get on my nerves.」
				CASE 3
					PRINTFORML 「Nnngth~! This isn't child's play it seems.」
					PRINTFORML 「I gotta take this seriously now.」
				CASE 4
					PRINTFORML 「Ouch!」
					PRINTFORML 「It's starting to really hurt.」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「Ack?! I'm hit? But I'm not done yet!」
				CASE 1
					PRINTFORML 「Wawawa! It hurts」
					PRINTFORML 「Don't think it's over yet though.」
				CASE 2
					PRINTFORML 「You got quite the damage done to me.」
					PRINTFORML 「Keep it up, or don't.」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「Am I done for?」
					CASE 1
						PRINTFORML 「Don't make me use this!」
					CASE 2
						PRINTFORML 「Not yet, it's not over yet, %CALLNAME:MASTER%!!」
					CASE 3
						PRINTFORML 「What!? Impossible!」
					CASE 4
				ENDSELECT
			CASE 0
			IF lcIsLethal
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「Gyah～!!」
					CASE 1
						PRINTFORML 「N- Nooooooooo〜!!」
					CASE 2
						PRINTFORML 「AGGGGHHHhhhhh〜!!」
					CASE 3
						PRINTFORML 「This is it.... This is the end...」
					CASE 4
						PRINTFORML 「What?! Agh... I met my match...」
					CASE 5
						PRINTFORML 「AHHHHHH IT HURDZZZZ!!!!!!」
						PRINTFORMDL %CALLNAME:102% rolls on the ground, writheing in pain
				ENDSELECT
			ELSE
				PRINTFORML 「What?! Agh... I met my match...」
			ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;Merciless
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;All in
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	[SKIPSTART]
				PRINTDATAL
					DATAFORM ｢And now for the finisher!!!」
					DATAFORM ｢Lasers... are all about firepower%K11_ZE("daze")%!」
					DATAFORM ｢Alright, let's make some noise!」
					DATAFORM ｢It's go time!」
					DATAFORM ｢Hehe, I got something for ya!」
					DATAFORM ｢Chew on this!」
					DATAFORM ｢Your ass is grass%K11_ZE("daze",1)%, %CALLNAME:MASTER%!」
					DATAFORM ｢I'd better watch out if I were you!」
					DATAFORM ｢It's on now!」
				ENDDATA	
		[SKIPEND]
		IF lcIsLethal
		ELSE
			$AttackLOOP
			SELECTCASE RAND:10
			CASE 0
				PRINTFORMDW ――Summoning Sign 「Endless Doppelgangers」!!!
				PRINTFORMDW Suddenly, %CALLNAME:102% splits into 2, 4, 8...
				PRINTFORMDW There's too many to differentiate between the real version and the clones.
				HANDICAP_FIXED += 3000
			CASE 1
				PRINTFORMDW ―-Magical Confinement 「Magical Captivity」!!!
				PRINTFORMDW The battle arena shrinks, making it harder to dodge %CALLNAME:102%'s bullets.
				HANDICAP_FIXED += 1000
			CASE 2
				PRINTFORMDW ――Spread Shot「Omnipresent Shotgun」!!!
				PRINTFORMDW %CALLNAME:102% and the area around %HIM_HER(102)% fire Danmaku all over the battle arena.
				PRINTFORMDW It's getting extremely hard to dodge %HIS_HER(102)% bullets with so many firing at you.
				HANDICAP_FIXED += 2000
			CASE 3
				IF !nPee && !nScat
				GOTO AttackLOOP
				ENDIF
				PRINTFORMDW ――Accident Sign 「Undying Desperation」!!!
				PRINTFORMDW Your bladder and bowels get uncomfortably full, and you can't seem to be able to relieve yourself.
				PRINTFORMDW You feel like you're about to burst, but you have to painfully fight on...
				CALLF PeeMe(MASTER)
				HANDICAP_FIXED += 1000
			CASE 4
				PRINTFORMDW ――Barrier Sign 「Firebomb」!!!
				PRINTFORMDW A barrage of fire is cast upon the battle arena.
				PRINTFORMDW It completely engulfs the arena, making it extremely hard to see everything.
				HANDICAP_FIXED += 200
			CASE 5
				PRINTFORMDW ――Spread Shot 「Unlimited Scissor Works」!!!
				PRINTFORMDW Possessed scissors cover the area, opening and closing on their own.
				PRINTFORMDW You feel like running into them can end your game immediately.
				HANDICAP_FIXED += 1000
			CASE 6
				CALL MESSAGE_COM355
				IF MAXBASE:MASTER:TSP
				PRINTFORMDW Everything but you and %CALLNAME:102% stop.
				PRINTFORMDW Does %CALLNAME:102% have time stop?
				PRINTFORMDW You can still move, but %CALLNAME:102% is still moving around, attacking.
				PRINTFORMDW Certainly this is to solidify that %HE_SHE(102)% has the same power as you.
				ELSE
				PRINTFORMDW What just happened?
				PRINTFORMDW %CALLNAME:102% is gone!
				ENDIF
			CASE 7
				PRINTFORMDW ――Power Steal 「Esper Drain」!!!
				PRINTFORMDW You suddenly feel weaker, like your magical abilities got significantly gimped
				PRINTFORMDW You struggle to stay up in the air.
				BASE:MASTER:TSP /= 2
				BASE:MASTER:7  /= 2
				HANDICAP_FIXED *= 2
			CASE 8
				PRINTFORMDW ――Psychic Vision 「Pitch Black Battlefield」!!!
				PRINTFORMDW The world goes black, you can't see anything.
				PRINTFORMDW Though, you can still hear what's going on, but this will make %CALLNAME:102% nearly impossible to beat.
				HANDICAP_FIXED += 5000
			CASE 9
				PRINTFORMW 「Just kidding, I'll give you a free non-spell card turn.」
				PRINTFORMW 「Use it wisely, don't let this opportunity go to waste.」
			ENDSELECT
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORMDW ――Barrier Sign 「Anomalies, Strength, Disorder, and Spirits」!!!
		PRINTFORMDW Isn't that just the general name of the Danmaku skill?
		PRINTL
		PRINTFORMDW It doesn't matter, as it easily stopped the bullets from hitting %HIM_HER(102)%.
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF lcIsLethal
		ELSE
			SELECTCASE 相手残機
				CASE 4
					PRINTFORML 「Not even a hit. You got years before you can take on the ultimate magician.」
				CASE 3
					PRINTFORML 「To land even a single hit on me... You're not too bad yourself, let's have another match sometime.」
				CASE 2
					PRINTFORML 「You managed to get two.」
					PRINTFORML 「Impressive, but not impressive enough.」
				CASE 1
					PRINTFORML 「Whew～... Just a little more and that would've been it for me.」
					PRINTFORML 「You might actually win next time, you know?」
				CASE 0
					PRINTFORML 「To think I would lose......」
					PRINTFORML 「I did everything, I summoned everything, and yet you valiantly got through me.」
					PRINTFORML 「That was a good match, let's have another sometime.」
			ENDSELECT
		ENDIF
		IF HANDICAP_FIXED >= 10
			IF lcIsLethal
				IF STRCOUNT(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blunt") || STRCOUNT(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade") 
					WeapUsed:0 '= "Melee"
				ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type"),"Firearm","Explosive","Bow") && EQUIP:MASTER:Weapon    
					WeapUsed:0 '= "Shooting"   
				ELSE
					WeapUsed:0 '= "戦闘経験"     
				ENDIF

				IF STRCOUNT(GET_STR(102, "Weapon", EQUIP:102:Weapon, "Class"), "Blunt") || STRCOUNT(GET_STR(102, "Weapon", EQUIP:102:Weapon, "Class"), "Blade")
					WeapUsed:1 '= "Melee"              
				ELSEIF GROUPMATCH(GET_STR(102, "Weapon", EQUIP:102:Weapon, "Type"),"Firearm","Explosive","Bow") && EQUIP:102:Weapon
					WeapUsed:1 '= "Shooting"                
				ELSE
					WeapUsed:1 '= "戦闘経験"        
				ENDIF
			ELSE
				WeapUsed:0 '= "戦闘経験"
				WeapUsed:1 '= "戦闘経験"
			ENDIF

			PRINTFORML
			PRINTFORMDW %CALLNAME:102% was no joke, indeed...
			PRINTFORMDW You feel like you have learned quite a lot of useful techniques for the future encounters.
			LOCAL = LIMIT((HANDICAP_FIXED / 10), 1, 100)
			CALL AddEXP(@"%WeapUsed%", MASTER, LOCAL)
			
			PRINTFORMDW %CALLNAME:102%, too, seemed to have learned quite a bit.
			CALL AddEXP(@"%WeapUsed:1%", 102, MULTIPLY(LOCAL, 150))
		ENDIF		
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

