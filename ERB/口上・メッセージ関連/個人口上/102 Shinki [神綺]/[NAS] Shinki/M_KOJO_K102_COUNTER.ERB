		CALL PRINT_GPC("W", @"「%HE_SHE(147,1)%는」 발을 구르고 신음하며 울고 있었다.",102)
		CALL PRINT_GPC("W", @"「그러자 %HE_SHE(147)%이 나를 보더니, 예수를 향한 관심을 나에게 돌리게 만들며 나에게 말을 걸었다.」",102)
		CALL PRINT_GPC("W", @"「나는 가난한 작은 천사를 학대하던 모든 하급 예수회 신부들을 상대해야 했고, 그들은 이제 나를 때리려고 했다.」",102)
		CALL PRINT_GPC("W", @"「그들은 나에게 상대가 되지 않았고 나는 작은 치유 마법으로 천사를 치료했다.」",102)
		PRINTL
		CALL PRINT_GPC("W", @"「%HIM_HER(147)%을 일으켜 세운 후, %HE_SHE(147)%는 나에게 감사하며 길고 따뜻하게 안아주었다.」",102)
		CALL PRINT_GPC("W", @"「%HE_SHE(147)%가 이런 말을 한 것 같다:」",102)
		CALL PRINT_GPC("W", @"『나를 구해줘서 고마워. 네가 아니었다면 대천사 미카엘이 나를 존재하지 않게 만들었을 거야.』",147)
		CALL PRINT_GPC("W", @"『나는 성령의 거룩한 대천사 중 한 명인 %NAME:147%이다.』",147)
		CALL PRINT_GPC("W", @"『나는 그들이 '사탄'이라고 부르는 것에 대해 너무 많이 알고 있다고 했기 때문에 신과 바티칸으로부터 이탈했다.』",147)
		PRINTL
		CALL PRINT_GPC("W", @"「나도 나 자신을 소개하고 %HE_SHE(147)%가 머물 곳을 제공했었다고 기억한다.」",102)
		CALL PRINT_GPC("W", @"『나는 마왕 세계 %GET_MAPNAME(11)%의 여신이다.』",102)
		CALL PRINT_GPC("W", @"『그 성스러운 사람들에게서 숨을 곳과 머물 곳을 내가 마련해 줄 수 있어.』",102)
		CALL PRINT_GPC("W", @"「%HE_SHE(147,1)%은 내 제안을 즉시 알아차렸고 우리가 둘이서 %GET_MAPNAME(11)%로 이동했을 때 상당히 이야기를 나누었다.」",102)
	CASE 2
