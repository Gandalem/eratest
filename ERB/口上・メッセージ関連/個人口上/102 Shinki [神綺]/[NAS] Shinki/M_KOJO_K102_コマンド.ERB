;==================================================
;120,クンニ強制
;==================================================

@M_KOJO_MESSAGE_COM_K102_120
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K102_120_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K102_120_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「후후후~ 네가 내 보지 핥는 거 원해?」
		PRINTFORML 「너 정말 못 말린다~」
		PRINTFORMDW 살짝 떨며, %CALLNAME:102%은 %HIS_HER(102)%의 얼굴을 당신의 %FSYN("vagina")%에 더 가까이 가져간다.
		PRINTFORML 「어때...? 기분 좋아?」
		PRINTFORMDW 당신이 %CALLNAME:102%에게 얼마나 좋은지 확인해 주자, %HIS_HER(102)%의 얼굴에 안도감이 퍼진다.
		PRINTFORML 「그럼 계속 이대로 할게... 츄릅...」
		PRINTFORMDW %CALLNAME:102%은 %HIS_HER(102)%의 혀를 당신의 %FSYN("vagina")% 위로 계속 미끄러뜨린다.		
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「%FSYN("lips_muffle")%... 후루룩... 정말 아기 같구나...」
		PRINTFORMDL %CALLNAME:102%은 열정적으로 그녀의 혀로 너를 섬긴다.
		PRINTFORMDW %HE_SHE(102)%이 이렇게 말하는 동안, %CALLNAME:102%는 더욱 큰 정성과 헌신으로 너를 섬기기 시작한다.
		PRINTFORMDW 쾌감이 당신을 무의식적으로 비틀고 갈게 만든다 %FSYN("vagina")% ~안으로 %CALLNAME:102%입으로
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMDW %CALLNAME:102%은(는) 당신이 쾌감으로 움찔거리고 떨리는 것을 지켜보며, %HE_SHE(102)%가 중얼거린다.
		PRINTFORML 「재미없나?」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
