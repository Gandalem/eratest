;==================================================
;123,足コキする
;==================================================

@M_KOJO_MESSAGE_COM_K102_123
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K102_123_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K102_123_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「내 발로 당신을 섬기길 원해? 내 앞에서 누워봐.」
		PRINTFORML 「내 왼발이 위를 가로질러---... -어」
		PRINTFORMDL %CALLNAME:102%는 %HIS_HER(102)%의 발을 당신의 성기로 옮긴다.
		PRINTFORML 「그리고 다른 발도 위를 가로질러---... -여기～ 에헤헤.」
		PRINTFORMDL 당신의 페니스가 %HIS_HER(102)%의 발 사이에 끼이면서 발기하기 시작한다.
		PRINTFORML 「준비됐어～」
		PRINTFORMDL 대답하기도 전에, 발들이 당신의 거시기를 멋지게 즐기며 만족감으로 가득 채우기 시작한다.
		PRINTL
		PRINTFORML 「여기서 내 \@ !EQUIP:102:6 ? 보이지 않아 # %PeeProtectType(102,2)%?\@」
		PRINTFORMDL 실로, %CALLNAME:102%의 \@ !EQUIP:102:6 ? 벌거벗은 가랑이는 # %PeeProtectType(102,2)% \@ 너의 시선으로부터 넓게 보인다.
		IF IsPadded(102)
			PRINTFORMDL %CALLNAME:102%의 기저귀가 정말 자극적이면서도 편안해 보인다.
			PRINTFORML 「오... -세상에. 내 기저귀를 보고 거의 한계에 다다른 것 같네.」
		ELSEIF EQUIP:6
			PRINTFORMDL %CALLNAME:102%의 속옷이 상당히... 에로틱해 보인다.
		ELSE
			PRINTFORMDL %HIS_HER(102,1)%의 성기가 전부 노출되며, 장난기 가득한 부위까지 모두 보인다.
		ENDIF
		PRINTFORML 「음, 그냥 편하게 누워서 이 여정을 즐겨.」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMDW %CALLNAME:102%이(가) 당신이 쾌감에 움찔 떨고 있는 것을 지켜보며, %HE_SHE(102)%은 중얼거린다.
		PRINTFORML 「내 발 앞에 무릎을 꿇어라! 그것들이 네 탈을 기쁘게 할 테니!」
		PRINTFORMDW 탈?
		RETURN 1
	ENDIF
ENDIF
RETURN 1
