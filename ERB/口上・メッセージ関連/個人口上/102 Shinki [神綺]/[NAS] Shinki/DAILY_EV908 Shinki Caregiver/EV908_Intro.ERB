@EV908_Intro
CALL PRINT_GP("L", @"As you begin preparing for bed, a knocking at your door disturbs your actions.")
CALL PRINT_GP("L", @"(Answering the door will result in %CALLNAME:102% continuing to visit)")
CALL PRINT_GP("L", @"(Not answering will result in %CALLNAME:102% not visiting you and acting like a regular character)")
CALL ASK_GSetQ("Open the door", "Don't answer")
CALL ASK_GInput()
IF RESULT
    CALL PRINT_GP("L", @"You return to bed and go to sleep.")
    CALL PRINT_GP("W", @"As the footsteps go quiet, you feel a bit guilty for not answering the door...")
    CALL PRINT_GP("W", @"But at the same time, you feel like you avoided an ominous force....")
    K102_ATWMode = 1
    RESETCOLOR
    RETURN 1
ELSE 
    CALL PRINT_GP("W", @"Wondering who could be visiting you, not truly expecting anyone to be polite enough to knock first, you quickly make yourself presentable before answering the door.")
ENDIF
CALL PRINT_GP("W", @"Before you, much to your astonishment stands an older looking %PRINT_MALE("man",102)% with white hair and a prodigious set of breasts.")
CALL PRINT_GP("W", @"Dressed in a long sleeved floor-length red dress, %HE_SHE(102)% comes off as having an extremely old-fashioned style about %HIM_HER(102)%.")
CALL PRINT_GP("W", @"However, what catches you by surprise more than anything is that %HES_SHES(102)% carrying a plate of cookies and a glass of milk, one in each hand.")
SIF CharaQuestline:102:0:0
CALL PRINT_GP("W", @"Of course, you already have met this %PRINT_MALE("man",102)%, knowing %HIM_HER(102)% as %NAME:102%, the %PRINT_MALE("man",102)% who gave you \"The Devil's Deal\" and proceeded to proclaim %HIMSELF_HERSELF(102)% as your \"carer\".")

CALL PRINT_GPC("L", @"「Hello dear. It's a pleasure to meet you.」", 102)
CALL PRINT_GPC("L", @"「I'm %CALLNAME:102%, and I was wondering if it would be okay for me to come in and speak with you a moment?」", 102)
CALL PRINT_GPC("W", @"「I have some milk and cookies for you as a welcoming gift if that makes a difference to the answer.」", 102)

CALL PRINT_GP("L", @"Seeing no reason to be rude to %CALLNAME:102%, especially if %HES_SHES(102)% offering you treats, you step aside letting her pass.")
CALL PRINT_GP("W", @"You question why %HE_SHE(102)% came in so late as you watch her put her offering down on your desk before turning to face you.")

CALL PRINT_GPC("L", @"「Not to sound discourteous dear, but it's impolite to not say thank you when someone gives you a gift.」", 102)
CALL PRINT_GPC("L", @"「Now I know that you're probably rather off-kilter from having just arrived to Gensokyo, but remembering your manners will help you feel a lot more human around here.」", 102)
CALL PRINT_GPC("L", @"「But enough of that, I'm here today to inform you that I'll be your carer during your time here.」", 102)
CALL PRINT_GPC("W", @"「Don't worry, there's nothing sinister about it, I'll just be checking in on you from time to time, making sure you're well-fed, properly rested, and not being mistreated by anyone」", 102)
CALL PRINT_GP("L", @"Seemingly happy with the state of things, she smiles back at you.")

IF CharaQuestPath:102:0 == -1
CALL PRINT_GPC("W", @"「And you seem to feel a bit lost around here. Perhaps you might need some of my guidance.」", 102)
CALL PRINT_GPC("W", @"「Here, pick a card.」", 102)
CALL QUEST_LINE_CHANGE(102,0)
CALL PRINT_GP("W", @"You pick one of the cards from the three available.")
CALL PRINT_GPC("W", @"「Good choice, %CALLNAME:MASTER%, it'll serve you well.」", 102)
CALL PRINT_GPC("W", @"「Remember that you can always change your questline being pursued at any time.」 ", 102)
PRINTL
CALL K102_MiniShinki
ENDIF

IF !CFLAG:102:1145 == 1
CALL PRINT_GPC("W", @"「And also, you seem to haven't filled out the ballot form yet.」", 102)
CALL PRINT_GPC("W", @"「Perhaps it's your first time meeting me.」", 102)
CALL PRINT_GPC("W", @"「I'll give you a form just so you can get it out of the way as quickly as possible.」", 102)
CALL PRINT_GP("W", @"%CALLNAME:102% passes a form and a pen to you and tells you to complete it.")
CALL PRINT_GP("W", @"「No worries, just take your time.」 ")
RESETCOLOR
CALL K102_ENCOUNTER_CONFIGURING
CALL SET_KOJO_COLOR(102)
ENDIF

CALL PRINT_GPC("L", @"「Oh yea. I'd love to hear your opinion on my cookies.」", 102)
CALL PRINT_GPC("W", @"「They're my own creation, and it's always extremely lovely to hear what people think of them」", 102)
CALL ASK_GSetQ("Eat a cookie", "Refuse")
CALL ASK_GInput()
SELECTCASE RESULT
CASE 0
CALL PRINT_GP("W", @"Not wanting to upset the kindly older woman by ignoring her gift, you approach your desk, the smell of freshly baked chocolate chip cookies filling you sense tantalisingly.")
CALL PRINT_GP("L", @"Taking a tentative bite, you realize just how amazing they are, still warm and gooey from just being made.")
CALL PRINT_GP("L", @"There's a mild flavour to them that you can't quite place, but that's obviously to be expected with traditional recipes, so you give it little mind.")
CALL PRINT_GP("W", @"Chewing appreciatively, you can't help but hum happily as the chunks of chocolatey dough slide down your throat.")

CALL PRINT_GP("L", @"Eyes closed in relaxation as you savour the tasty treat, a damp soft texture begins to rub against your cheek, startling you.")
CALL PRINT_GP("W", @"Jumping in shock, to your astonishment you see that %CALLNAME:102% is now standing before you, a slightly damp handkerchief in hand.")
CALL PRINT_GPC("L", @"「Such a messy baby, so many stray crumbs.」", 102)
CALL PRINT_GPC("L", @"「Though, it seems you enjoyed them which makes me exceptionally happy, that messy cookie eating look is very adorable.」", 102)
CALL PRINT_GPC("L", @"「I might have to bring you some more next time as a nice reward for you being so well-behaved. Does that sound nice?」", 102)
CALL PRINT_GP("W", @"%CALLNAME:102% chuckles, preening over you a moment more before turning to leave.")
PRINTL
CALL PRINT_GP("L", @"Embarrassed from being cleaned by the matronly woman, you silently frown grumpily at her.")
CALL PRINT_GP("L", @"Though, deep down there's something extremely childish about someone taking the liberty to wipe your face, as if you're incapable of tidying up after your own messes.")
CALL PRINT_GP("L", @"Worse, you can't help but enjoy the attention a little, not that you'd ever admit that, instead bratty-ly fidgeting away from her attempts.")
CALL PRINT_GP("W", @"Curtly grumbling, you thank %HIM_HER(102)% for the cookies, but assert that you can clean yourself.")
PRINTL
CALL PRINT_GPC("L", @"「Of course, of course darling. You are just such an adorable little thing, I'll be taking special care of you from now on.」", 102)
CALL PRINT_GPC("L", @"「Think how much fun we'll have with all the \@ nOmutsu ? %"diapers and "% #\@games, you might even enjoy some of the punishments once you get used to them.」", 102)
CALL PRINT_GPC("L", @"「However, for now I have other business to attend to.」", 102)
CALL PRINT_GPC("L", @"「Goodnight dear, and remember to drink your milk, it's good for you especially just before bed」", 102)
CALL PRINT_GP("W", @"%CALLNAME:102% waves jovially as she leaves your room.")
PRINTL
CALL PRINT_GP("L", @"%CALLNAME:102% now left, you begin getting prepared for bed again, your stomach still warm and comforted by the delicious cookies she brought you.")
CALL PRINT_GP("W", @"Slowly drinking the refreshing glass of milk she also provided with, your mind runs back over what she said wondering what'll happen on her next visit.")
BASE:MASTER:4 += 250
BASE:MASTER:17 += 350
CASE 1
CALL PRINT_GP("W", @"You feel like eating before going to bed is a bad idea, and decide to not eat a cookie.")
CALL PRINT_GPC("L", @"「Aww. It's okay if you don't decide to eat the cookies.」", 102)
CALL PRINT_GPC("W", @"「I made them just for you, but its okay, that just means more for %CALLNAME:17%.」", 102)
PRINTFORML
CALL PRINT_GP("L", @"You hang around with %CALLNAME:102% for a good amount of time until it gets pitch dark. ")
CALL PRINT_GP("W", @"You thank %HIM_HER(102)% for kindly visting and offering you the gifts.")
PRINTL
CALL PRINT_GPC("L", @"「Of course, of course darling. You are just such an adorable little thing, I'll be taking special care of you from now on.」", 102)
CALL PRINT_GPC("L", @"「Think how much fun we'll have with all the \@ nOmutsu ? %"diapers and "% #\@games, you might even enjoy some of the punishments once you get used to them.」", 102)
CALL PRINT_GPC("L", @"「Goodnight dear, and remember to drink your milk, it's good for you especially just before bed」", 102)
CALL PRINT_GP("W", @"%CALLNAME:102% waves jovially as she leaves your room.")
PRINTL
CALL PRINT_GP("L", @"%CALLNAME:102% now left, you begin getting prepared for bed again.")
CALL PRINT_GP("W", @"Slowly drinking the refreshing glass of milk she also provided with, your mind runs back over what she said wondering what'll happen on her next visit.")
ENDSELECT

SETBIT K102_EV, 0
RETURN 1

