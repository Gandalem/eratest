@EV908_Intro
CALL PRINT_GP("L", @"잠자리에 들 준비를 시작할 때, 문을 두드리는 소리가 당신의 행동을 방해한다.")
CALL PRINT_GP("L", @"문을 열면 %CALLNAME:102%는 계속 방문하게 된다.")
CALL PRINT_GP("L", @"(대답하지 않으면 %CALLNAME:102%가 당신을 방문하지 않고 평범한 캐릭터처럼 행동할 것입니다)")
CALL ASK_GSetQ("Open the door", "Don't answer")
CALL ASK_GInput()
IF RESULT
	CALL PRINT_GP("L", @"당신은 침실로 돌아가 잠이 든다.")
	CALL PRINT_GP("W", @"발소리가 잦아들자, 문에 대답하지 않은 것에 대해 약간의 죄책감을 느낀다...")
	CALL PRINT_GP("W", @"하지만 동시에 불길한 힘을 피했다는 느낌이 들었다...")
	K102_ATWMode = 1
	RESETCOLOR
	RETURN 1
ELSE
	CALL PRINT_GP("W", @"누가 방문할지 궁금했고, 누군가 예의를 갖춰 노크해 주리라 진심으로 기대하지 않았기에, 문을 열기 전에 재빨리 단정하게 꾸몄다.")
ENDIF
CALL PRINT_GP("W", @"당신 앞에서 놀라운 광경으로 백발에 풍만한 가슴을 가진 나이 들어 보이는 %PRINT_MALE("man",102)%가 서 있다.")
CALL PRINT_GP("W", @"긴 소매의 바닥까지 내려오는 빨간 드레스를 입은 %HE_SHE(102)%는 %HIM_HER(102)%에게 매우 구식인 스타일로 보인다.")
CALL PRINT_GP("W", @"하지만 당신을 무엇보다 더 놀라게 하는 것은 %HES_SHES(102)%이 두 손에 각각 쿠키 접시와 우유 한 잔을 들고 있다는 사실이다.")
SIF CharaQuestline:102:0:0
	CALL PRINT_GP("W", @"물론 이 %PRINT_MALE("man",102)%알고 있는 %HIM_HER(102)% 로서 %NAME:102%, 그 %PRINT_MALE("man",102)% 너에게 주었던 \"악마의 거래\" 그리고 선언하기 시작했다 %HIMSELF_HERSELF(102)% 당신의 \"간병인\".")
CALL PRINT_GPC("L", @"「안녕하세요, 소중한 분. 만나서 반갑습니다.」", 102)
CALL PRINT_GPC("L", @"「저는 %CALLNAME:102%라고 하는데요, 잠시 당신과 이야기 나눌 수 있을까요?」", 102)
CALL PRINT_GPC("W", @"「답에 차이를 만든다면, 환영 선물로 우유와 쿠키를 좀 가지고 있어.」", 102)
CALL PRINT_GP("L", @"%CALLNAME:102%에게 무례하게 굴 이유를 찾지 못하고, 특히 %HES_SHES(102)%가 당신에게 간식을 건네고 있다면, 그녀가 지나갈 수 있도록 비켜준다.")
CALL PRINT_GP("W", @"당신은 그녀가 당신의 책상 위에 제물을 내려놓고 당신을 돌아보는 모습을 보면서 왜 %HE_SHE(102)%이 그렇게 늦게 왔는지 의문을 품는다.")
CALL PRINT_GPC("L", @"「실례가 되기 싫은 건데, 누군가 선물을 주었을 때 감사 인사를 하지 않는 것은 예의가 아니거든.」", 102)
CALL PRINT_GPC("L", @"「지금 당신이 막 환상향에 도착해서 아마 좀 어색할 거라는 건 알지만, 예의를 지키는 것이 이곳에서 훨씬 더 인간처럼 느끼는 데 도움이 될 거야.」", 102)
CALL PRINT_GPC("L", @"「하지만 그만하고, 나는 네가 이곳에 있는 동안 너의 간병인이 되어주기 위해 오늘 여기에 왔다.」", 102)
CALL PRINT_GPC("W", @"「걱정 마, 별로 나쁜 건 없어. 가끔 네 안부를 확인하고, 잘 먹고 제대로 쉬고 있는지, 누군가에게 부당하게 대우받지 않는지 살피기만 할 거야」", 102)
CALL PRINT_GP("L", @"상황이 마음에 들었는지 그녀는 당신에게 미소로 화답한다.")
IF CharaQuestPath:102:0 == -1
	CALL PRINT_GPC("W", @"「여기서 좀 길을 잃은 것 같군. 아마 내 안내가 필요할지도 모르지.」", 102)
	CALL PRINT_GPC("W", @"「여기서 카드 하나를 골라라.」", 102)
	CALL QUEST_LINE_CHANGE(102,0)
	CALL PRINT_GP("W", @"당신은 세 장의 카드 중에서 하나를 고른다.")
	CALL PRINT_GPC("W", @"「좋은 선택이야, %CALLNAME:MASTER%, 잘 써 줄 거야.」", 102)
	CALL PRINT_GPC("W", @"「언제든지 추적하는 퀘스트 라인을 바꿀 수 있다는 것을 기억해.」 ", 102)
	PRINTL
	CALL K102_MiniShinki
ENDIF
IF !CFLAG:102:1145 == 1
	CALL PRINT_GPC("W", @"「그리고 또 당신은 아직 투표 양식을 작성하지 않은 것 같네요.」", 102)
	CALL PRINT_GPC("W", @"「아마 나를 처음 보는 것 같네.」", 102)
	CALL PRINT_GPC("W", @"「빨리 끝낼 수 있도록 양식 하나를 줄게.」", 102)
	CALL PRINT_GP("W", @"%CALLNAME:102%가 양식과 펜을 당신에게 건네주며 작성하라고 말한다.")
	CALL PRINT_GP("W", @"「걱정 마, 천천히 해.」 ")
	RESETCOLOR
	CALL K102_ENCOUNTER_CONFIGURING
	CALL SET_KOJO_COLOR(102)
ENDIF
CALL PRINT_GPC("L", @"「오 예. 내 쿠키에 대한 네 의견을 듣고 싶어.」", 102)
CALL PRINT_GPC("W", @"「그것들은 나의 창조물이며, 사람들이 그것들에 대해 어떻게 생각하는지 듣는 것은 언제나 매우 사랑스럽다」", 102)
CALL ASK_GSetQ("Eat a cookie", "Refuse")
CALL ASK_GInput()
SELECTCASE RESULT
	CASE 0
		CALL PRINT_GP("W", @"친절한 나이 든 여인의 선물을 무시하여 기분을 상하게 하고 싶지 않아, 당신은 방금 구운 초코칩 쿠키의 향기가 감각을 자극하며 가득한 자신의 책상으로 다가간다.")
		CALL PRINT_GP("L", @"조심스럽게 한 입 베어 물자, 막 만들어져 따뜻하고 녹아있는 그 상태가 얼마나 놀라운지 깨닫는다.")
		CALL PRINT_GP("L", @"그것들에는 도무지 알 수 없는 은은한 풍미가 있지만, 전통적인 레시피에서는 당연한 것이니 대수롭지 않게 넘긴다.")
		CALL PRINT_GP("W", @"맛있게 음미하며, 초콜릿 반죽 조각들이 목을 넘어가는 것을 들으며 행복하게 흥얼거리지 않을 수 없다.")
		CALL PRINT_GP("L", @"편안함에 눈을 감고 맛있는 간식을 음미하고 있을 때, 축축하고 부드러운 질감이 당신의 뺨에 스치며 당신을 놀라게 한다.")
		CALL PRINT_GP("W", @"충격에 뛰어든 당신은 놀랍게도 %CALLNAME:102%이 지금 약간 축축한 손수건을 들고 당신 앞에 서 있는 것을 본다.")
		CALL PRINT_GPC("L", @"「정말 지저분한 아기군, 여기 부스러기가 너무 많아.」", 102)
		CALL PRINT_GPC("L", @"「비록 당신이 그것들을 즐긴 것 같아 나도 아주 기쁘지만, 그 지저분하게 쿠키 먹는 모습은 정말 사랑스럽네요.」", 102)
		CALL PRINT_GPC("L", @"「네가 그렇게 잘 행동해줘서 다음엔 더 좋은 보상을 가져와야 할지도 모르겠어. 괜찮을 것 같니?」", 102)
		CALL PRINT_GP("W", @"%CALLNAME:102%는 잠시 당신을 부추기며 웃다가 떠난다.")
		PRINTL
		CALL PRINT_GP("L", @"숙모 같은 여자에게 청소당한 것이 민망해서, 당신은 그녀를 투덜거리며 조용히 노려본다.")
		CALL PRINT_GP("L", @"하지만 마음 깊은 곳에는 마치 네가 네 지저분한 것을 치울 능력이 없는 것처럼 네 얼굴을 닦아주는 것이 극도로 유치하게 느껴지는 무언가가 있다.")
		CALL PRINT_GP("L", @"게다가 너는 그녀의 시도를 피해 짜증스럽게 몸을 움직이고 있지만, 그것을 인정하지 않으면서도 관심 자체를 조금 즐기고 있다는 것을 어쩔 수 없다.")
		CALL PRINT_GP("W", @"투덜거리며 당신은 %HIM_HER(102)%에게 쿠키에 대해 감사하지만 스스로 청소할 수 있다고 주장한다.")
		PRINTL
		CALL PRINT_GPC("L", @"「물론이지, 물론이지 자기야. 너는 정말 사랑스러운 작은 존재니까, 이제부터 내가 특별히 보살펴 줄게.」", 102)
		CALL PRINT_GPC("L", @"「모든 \@ nOmutsu ? %"diapers and "% #  \@게임들과 함께 얼마나 재미있을지 생각해 봐, 적응하면 벌칙도 즐길지도 모른다.」", 102)
		CALL PRINT_GPC("L", @"「하지만 당분간은 다른 볼일이 있다.」", 102)
		CALL PRINT_GPC("L", @"「잘 자렴, 그리고 우유 꼭 마시는 거 잊지 말고, 특히 자기 전에 좋단다」", 102)
		CALL PRINT_GP("W", @"%CALLNAME:102%는 당신의 방을 나서면서 명랑하게 손을 흔든다.")
		PRINTL
		CALL PRINT_GP("L", @"%CALLNAME:102%가 이제 남았고, 당신은 다시 잠자리에 들 준비를 시작한다. 그녀가 가져온 맛있는 쿠키로 아직 배가 따뜻하고 편안하다.")
		CALL PRINT_GP("W", @"그녀가 제공해 준 상쾌한 우유 한 잔을 천천히 마시며, 당신의 마음은 다음 방문 때 무슨 일이 일어날지 궁금해하며 그녀가 했던 말을 되짚었다.")
		BASE:MASTER:4 += 250
		BASE:MASTER:17 += 350
	CASE 1
		CALL PRINT_GP("W", @"잠자리에 들기 전에 먹는 것은 나쁜 생각인 것 같아 쿠키를 먹지 않기로 결정한다.")
		CALL PRINT_GPC("L", @"「아이고. 쿠키를 먹을지 결정하지 않아도 괜찮아.」", 102)
		CALL PRINT_GPC("W", @"「너를 위해 만들었지만 괜찮아, 그건 단지 %CALLNAME:17%에게 더 많은 의미일 뿐이야.」", 102)
		PRINTFORML
		CALL PRINT_GP("L", @"당신은 어두워질 때까지 %CALLNAME:102%과 오랜 시간 어울린다. ")
		CALL PRINT_GP("W", @"당신은 %HIM_HER(102)%에게 친절하게 방문하고 선물을 건네준 것에 대해 감사한다.")
		PRINTL
		CALL PRINT_GPC("L", @"「물론이지, 물론이지 자기야. 너는 정말 사랑스러운 작은 존재니까, 이제부터 내가 특별히 보살펴 줄게.」", 102)
		CALL PRINT_GPC("L", @"「모든 \@ nOmutsu ? %"diapers and "% #  \@게임들과 함께 얼마나 재미있을지 생각해 봐, 적응하면 벌칙도 즐길지도 모른다.」", 102)
		CALL PRINT_GPC("L", @"「잘 자렴, 그리고 우유 꼭 마시는 거 잊지 말고, 특히 자기 전에 좋단다」", 102)
		CALL PRINT_GP("W", @"%CALLNAME:102%는 당신의 방을 나서면서 명랑하게 손을 흔든다.")
		PRINTL
		CALL PRINT_GP("L", @"%CALLNAME:102%은(는) 이제 떠났고, 당신은 다시 잠자리에 들 준비를 하기 시작한다.")
		CALL PRINT_GP("W", @"그녀가 제공해 준 상쾌한 우유 한 잔을 천천히 마시며, 당신의 마음은 다음 방문 때 무슨 일이 일어날지 궁금해하며 그녀가 했던 말을 되짚었다.")
ENDSELECT
SETBIT K102_EV, 0
RETURN 1

