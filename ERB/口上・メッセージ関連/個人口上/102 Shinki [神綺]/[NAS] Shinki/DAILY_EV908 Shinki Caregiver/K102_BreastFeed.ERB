					CALL PRINT_GPC("W", @"「내가 기저귀를 갈아줘야 해... 그리고 나 자신도 갈아야겠어.」",102)
					CALL DiaperChangeDesc(MASTER,K102_PampPick(MASTER),102)
					GOTO GetOffYou
			ENDSELECT
		CASE 2
			IF IsPadded(MASTER)
				CALL PRINT_GPC("L", @"「그냥 당신의 %PeeProtectType(MASTER,3)%를 사용하세요, 실수하지 않을 거예요.」",102)
