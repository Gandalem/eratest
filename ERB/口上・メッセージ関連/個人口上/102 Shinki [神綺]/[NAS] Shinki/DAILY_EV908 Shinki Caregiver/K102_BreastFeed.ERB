						IF K102_PlayerLovesDiaperRubs > 0
							GOTO WetCummiesRub
						ELSEIF K102_PlayerLovesDiaperRubs < 0
							GOTO DoNotRubMCOff
						ENDIF
						CALL PRINT_GPC("W", @"「이거… 기분 좋아?...」",102)
						CALL ASK_M( "네", 1, "No", 1, "대답을 거부한다", 1, )
