				CALL PRINT_GP("L", @"소변기에 소변을 보는 당신의 귀에 큰 소리의 쉬익거리는 소리가 들리자 안도의 한숨이 당신을 감싼다.")
				CALL PRINT_GPC("W", @"「와, 그 우유가 정말 배가 고프게 만들었네, 응?」",102)
