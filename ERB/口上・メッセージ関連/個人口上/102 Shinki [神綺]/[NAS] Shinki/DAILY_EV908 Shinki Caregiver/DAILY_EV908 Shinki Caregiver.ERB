@EV908_Bedwetting(HasPiss,HasScat)
#DIM HasPiss
#DIM HasScat
#DIM sheetsState
;this is where it gets a bit fucky
;see here this event was only made with the player having an accident
;and i'm trying to add a scenario where the player makes it
CALL SET_KOJO_COLOR(102)
SELECTCASE MIN(PeeHold:MASTER:2,PooHold:MASTER:2)
	CASE IS > 0
		;aware, successfully gets to toilet
		CALL PRINT_GP("W", @"당신은 침대에서 뒤척이며 불편한 전율을 느끼고, 과도한 압박감에 갑자기 벌떡 일어난다.")
		CALL PRINT_GP("L", @"처음에는 졸린 상태에서 무슨 일이 일어나고 있는지 파악하기 어렵다. 갑작스러운 각성이 혼란스럽고 괴로운 감정을 남겼기 때문이다.")
		CALL PRINT_GP("W", @"하지만 네 내장이 크고 작은 소리를 내기 시작하자, 혹시 배탈이 났거나 식중독이라도 걸린 건 아닌지 하는 생각이 머릿속을 스치기 시작한다.")
		CALL PRINT_GP("W", @"사고를 치기 전에 화장실에 갈 시간이 몇 초밖에 없다는 것을 알면서, 당신은 여전히 졸린 채 침대에서 뛰어내린다.")
		CALL ASK_GSetQ("Run to a toilet", @"도움을 받기 위해 미니-%CALLNAME:102%를 호출한다.", @"%CAPITALIZE(PeeAndPoo(HasPiss,HasScat,"wet","mess"))% 당신의 %PeeProtectType(MASTER,2)%")
		CALL ASK_GInput()
		SELECTCASE RESULT
			CASE 0
				CALL PRINT_GP("L", @"가장 가까운 화장실로 걸어가는 동안, 당신의 %PeeandPoo(HasPiss,HasScat,"bladder","tummy")%가 배설물을 담을 공간이 다해 새기 시작한다.")
				SELECTCASE MIN(PeeHold:MASTER:2,PooHold:MASTER:2)
					CASE IS >= 3
						CALL PRINT_GP("W", @"%PeeandPoo(HasPiss,HasScat,"bladder","tummy")%가 터지기 직전 느낌이 들자, 화장실을 찾아 계속 새는 상태로 옷을 벗고 제자리에 앉았다. ")
						IF GETBIT(nPee,1) && GETBIT(nScat,2)
							CALL PRINT_GP("L", @"거대한 대변 덩어리가 당신의 항문에서 힘들이지 않고 빠져나오면서, 지친 방광에서 거의 끝없는 소변 줄기가 새기 시작한다.")
						ELSEIF GETBIT(nScat,2)
							CALL PRINT_GP("L", @"거대한 변덩어리가 당신의 항문에서 힘들이지 않고 꿈틀거리며 나와 변기에 끊임없이 나오는 역겨운 진흙으로 가득 채운다.")
						ELSE
							CALL PRINT_GP("L", @"지친 방광에서 끝없이 이어지는 소변이 새어 나오기 시작한다.")
