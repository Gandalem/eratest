@DAILY_INFO_EV908
#FUNCTION
DAILY_INFO_NAME '= @"%CALLNAME:102%는 간병인"
DAILY_INFO_DESC '= @"%GET_MAPNAME(11)%의 신에게 몸을 맡겨져 보살핌을 받는다."
DAILY_INFO_TYPE '= @"메이저"

@DAILY_CONDITION_EV908
#DIM DEBUG_MENU
VARSET LOCAL
[IF_DEBUG]
DEBUG_MENU = 1
[ENDIF]
FOR LOCAL:1, 0, 6
IF IRAI_SLOT:(LOCAL:1) == 102105
	CALL DAILY_EV_908(2)
	RETURN 1
	;check for active requests
ENDIF
NEXT
IF DEBUG_MENU
	CALL K102_EventDebugMenu
	SELECTCASE RESULT
		CASE 900
			GOTO BYPASS
		CASE 0
			RETURN 0
	ENDSELECT
ELSEIF DAY == 1 && !SaveIsEZB
	CALL DAILY_EV_908(0)
	RETURN 1
ENDIF
SIF GETBIT(K102_EV,0) && !CharaQuestline:102:0:0
	RETURN 0
;LoG: Only start after she has been defeated
SIF SaveIsEZB && !LoG_RivalWins(LoG_RivalID(102))
	RETURN 0
SIF RAND:5
	RETURN 0
$BYPASS
CALL DAILY_EV_908
RETURN 1

@DAILY_EV_908(BYPASS = -1)
#DIM BYPASS
CALL SET_KOJO_COLOR(102)
IF (BYPASS == -1 && !RAND:5) || BYPASS == 3
	SIF nOmutsu && nPantyPunish
		CALL EV908_RandomCheck
	RETURN 1
ENDIF
IF BYPASS != -1
	SELECTCASE BYPASS
		CASE 0
			CALL EV908_Intro
		CASE 1
			CALL EV908_IncreasedResponse
		CASE 2
			CALL EV908_CookieSpike
		CASE 3
		CASE 4
			CALL EV908_HypnoBallSuck
		CASE 5
		CASE 6
		CASE 7
		CASE 8
			CALL EV908_DiaperFeast
		CASE 9
			CALL K102_PlayerCompleteDiaperDependence
		CASE 100
			CALL K102_MysteryDiaper_Send
		CASE 101 TO 104
			TRYCALLFORM K102_MysteryDiaper_Guilt_{BYPASS-100}
	ENDSELECT
	RETURN 1
ENDIF
IF !GETBIT(K102_EV,0)
	CALL EV908_Intro
ELSEIF !GETBIT(K102_EV,1) && CharaQuestline:102:0:0
	CALL EV908_IncreasedResponse
ELSEIF HAS_REQUEST_OF_ID(102,105)
	CALL EV908_CookieSpike
ELSEIF CharaQuestline:102:0:0
	SELECTCASE RAND:10
		CASE 0
			CALL EV908_CookieSpike
	ENDSELECT
ENDIF

