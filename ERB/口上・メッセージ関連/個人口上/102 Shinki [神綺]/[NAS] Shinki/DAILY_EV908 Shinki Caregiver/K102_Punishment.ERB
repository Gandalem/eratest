@K102_Punishment_50Slaps
K102_PlayerPunishAutoClear = 1
CALL PRINT_GPC("L", @"「오늘 네 못된 행동에 대한 벌로, 네가 시키는 것을 무시하지 않도록 배우게 해줄 달콤하고 긴 엉덩이 때리기를 해주기로 결정했어, 나의 사랑스러운 %CALLNAME:MASTER%!」", 102)
CALL PRINT_GPC("W", @"「%K102_WhyAmIGettingPunished()%, 그러니 이제 기억하게끔 엉덩이가 아플 거야.」", 102)
PRINTL
CALL PRINT_GPC("L", @"「네가 다시는 잘못된 행동을 하지 않도록 제대로 된 손바닥으로 50번 때리는 게 충분할지도 모른다고 생각 중이야.」", 102)
CALL PRINT_GPC("L", @"「그래도 입고 있는 속옷은 그대로 두겠지만, 만약 큰 기저귀를 입고 있다면 아마 덜 따가울 거야.」", 102)
CALL PRINT_GPC("W", @"「이제 다 정리됐으니, 네 뒤를 좀 아프게 해주는 걸 받아들이는 게 좋겠어, 자기야.」", 102)
PRINTL
CALL PRINT_GP("W", @"50번의 체벌 소리라니, 안 좋군!")
CALL PRINT_GP("L", @"당신은 이 처벌이 치료의 건강 개선 속성조차도 빨리 치유하지 못할 만큼 당신의 불쌍한 엉덩이를 불쾌한 상태로 만들 것이라고 확신하는가.")
CALL PRINT_GP("L", @"더 나쁜 것은 그녀를 놓아주고 싶지 않지만, 깊은 곳에서는 상황을 악화시킬 뿐인 그녀의 행동에 저항하는 것이 선택의 여지가 없다는 것을 알고 있다는 것이다.")
CALL PRINT_GP("L", @"그러므로 당신이 할 수 있는 것은 그저 조용히 사과하는 것뿐이다, 그녀는 침대에 앉아 놀라울 정도로 유연한 동작으로 당신을 자신의 무릎 위로 끌어당긴다.")
PRINTL
CALL PRINT_GP("L", @"무릎 위로 쓸리자 짧은 비명을 지르고, 당신의 %OPPAI_DESCRIPTION_TR(MASTER)%는 부드러운 이불에 따뜻하게 눌렸다.")
CALL PRINT_GP("L", @"당신이 자세에 좀 더 편안해질 시간을 주며, %CALLNAME:102%는 옷을 벗고 재정리하여 그녀가 당신의 뒤를 가리지 않고 접근할 수 있게 한다.")
LOCALS '= @"당신이 "
IF EQUIP:MASTER:6
	LOCALS += @"%PeeProtectType(MASTER)%"
ELSE
	LOCALS += @"바닥에 아무것도 걸치지 않은 채 세상에 완전히 노출된 모습으로. "
ENDIF
CALL PRINT_GP("L", @"%LOCALS%가 공중에서 유혹적으로 흔들리며 벌을 받으려 할 때, 당신은 보호자가 경쾌한 멜로디를 흥얼거리는 소리를 듣는다.")
WAIT
PRINTL
CALL PRINT_GP("L", @"짧게 문질러 몸을 푸는 대로, %CALLNAME:102%은(는) 빠르게 첫 번째 타격을 준비한다.")
CALL PRINT_GP("L", @"그녀의 두꺼운 손이 당신의 %FSYN("ass")%에 우지끈 소리를 내며 내려앉자, 당신은 움찔하며 그녀의 허벅지에 밀착한다.")
CALL PRINT_GP("W", @"듣기에도 안 좋고 많이 아프지만, 그녀는 분명 힘을 좀 빼고 휘두르는 데 전력을 다하지 않고 있다.")
CALL PRINT_GP("W", @"대신 또 다른 둔탁한 소리와 함께, 그녀는 같은 부위에 다시 일격을 내리는데, 이번에는 너무나 강력해서 거의 그녀의 무릎에서 밀려날 정도다.")
CALL PRINT_GP("L", @"당신에게 관대해지지는 않지만, 빠르고 부드러운 손길 뒤에 점점 더 근육이 쑤시게 만든다.")
PRINTL
CALL PRINT_GPC("L", @"「원하면 울어도 괜찮다. 장난꾸러기 아기가 잘못했을 때 속상해하는 것은 지극히 정상적인 일이다.」", 102)
CALL PRINT_GPC("W", @"「하지만, 괜찮아 얘야, 벌을 받은 후에는 모든 것이 용서되기 때문이야.」", 102)
CALL PRINT_GP("L", @"그녀의 말을 듣느라 정신이 팔려 있는 동안 다음 몇 대를 때린 후, 그녀가 처방한 엄청난 양의 벌을 계속 받는다.")
PRINTL
CALL PRINT_GP("L", @"하나하나 천천히 가며, 각 타격 사이에 제대로 회복할 시간을 주니 시간이 좀 걸린다.")
CALL PRINT_GP("L", @"하지만, %CALLNAME:102%는 어린아이들을 어떻게 훈육하는지 확실히 훈련받았으며, 그녀의 타격은 정확하고 효과적이다.")
CALL PRINT_GP("W", @"당신의 뒤쪽 주된 살 부분부터 앉는 자리까지, 심지어 허벅지의 연약한 상단까지.")
CALL PRINT_GP("L", @"그녀가 나에게 너무 심하게 대하고 싶지 않아서 나중의 것들에게는 부드럽게 하려고 노력하고 있다는 것을 알 수 있다.")
CALL PRINT_GP("W", @"하지만 그것이 네 항문이 아프고 염증이 생기는 것을 막아주지는 못하며, 누군가 그걸 본다면 아마 빨갛고 자극적일 것이다.")
CALL PRINT_GP("W", @"당신은 뒤쪽에서도 극도로 뜨거워지는 것을 느끼며, 그 행동들이 섬세한 후면이 불타는 듯한 느낌을 받게 한다.")
PRINTL
CALL PRINT_GP("W", @"스무 번의 매에 눈물이 날 지경이다.")
CALL PRINT_GP("W", @"%CALLNAME:102%가 서른 대를 때리는 지점에서는 더 이상 참을 수 없어 코에서 콧물을 흘리며 눈물을 주르륵 흘리고 있다.")
CALL PRINT_GP("W", @"마흔 번의 타격으로 당신은 불편하고 따가우며 아픈 세상에 처해, 무엇이든 사과할 준비를 하고 있으며 다리가 통제 불능 상태로 풀린다.")
CALL PRINT_GP("W", @"하지만 50번째 타격에 당신은 남은 에너지가 없어 조용히 흐느끼며 때때로 자신의 행동에 대한 희미하고 거친 사과의 울음을 터뜨린다. ")
PRINTL
CALL PRINT_GP("L", @"따뜻한 보살핌을 받는 양육자의 어깨를 쓰다듬으며 들려오는 부드러운 지저귐과 위로의 말들 덕분에 고통스러운 안개 속에서 끝이 왔음을 깨달았다.")
CALL PRINT_GP("L", @"서서히 정신을 차리자, 당신은 부드러운 이불 위에 배를 깔고 누워 있고, 선명한 빨간색 뒤쪽이 당신의 등 뒤 세상에 노출되어 있음을 깨닫는다.")
CALL PRINT_GP("W", @"그래도 반대편으로는 시원한 공기가 닿아서 적어도 좀 나아지는 기분이 들긴 한다.")
CALL PRINT_GP("L", @"다시 돌아온 아픈 불편함과 축축한 감각에 당신은 뒤를 돌아보았고, 그곳에서 %CALLNAME:102%가 부어오른 당신의 엉덩이에 일종의 로션이나 크림을 바르는 것을 발견했다.")
CALL PRINT_GP("W", @"그녀의 행동은 당신에게 불필요한 고통을 주지 않기 위해 세심하지만 섬세하다. ")
PRINTL
CALL PRINT_GPC("W", @"「봐, 다 끝났어.」", 102)
CALL PRINT_GPC("L", @"「네가 그렇게 못되게 굴었으니 제대로 벌을 받아서 이제 훨씬 기분이 나아졌을 거라고 확신해.」", 102)
CALL PRINT_GPC("L", @"「그 네 짜증 나는 작은 엉덩이는 아마 잠시 동안, 확실히 하룻밤 동안 따끔거리겠지만 걱정할 건 없어.」", 102)
CALL PRINT_GPC("W", @"「그리고 무엇보다 모든 것이 용서받았으니 걱정할 것이 없지.」", 102)
CALL PRINT_GPC("L", @"「정말 좋지! 네 엉덩이에 진정 크림을 좀 발라줬으니까 더 빨리 나고 덜 아플 거야, 하지만 그래도 그 위에서 잠들지는 않을 걸.」", 102)
CALL PRINT_GPC("W", @"「더 오래 머물면서 네가 편안하게 잠들었는지 확인해 주고 싶지만, 안타깝게도 가봐야 해.」", 102)
CALL PRINT_GPC("W", @"「하지만 가기 전에 모든 것이 괜찮다는 걸 보여주려고 잘 자는 키스를 해줘야겠어」", 102)
PRINTL
CALL PRINT_GP("L", @"당신을 따뜻하게 안으며, 어쩌면 나이 많은 여자의 과도한 가슴이 조금 포함된 강렬한 포옹 속에서 %CALLNAME:102%는 당신의 이마에 일련의 축축한 키스를 남겼다.")
CALL PRINT_GP("L", @"방금 일어난 모든 일에도 불구하고, 당신은 연약한 만큼 위안을 갈망할 수밖에 없다.")
CALL PRINT_GP("W", @"그녀의 손아귀가 조금 느슨해지자, 대신 잠시 당신을 단장해주기 시작하며 이리저리 흐트러진 머리카락을 치우고 침으로 축축하게 적신 엄지손가락으로 얼굴에 묻은 얼룩들을 닦아냈다.")
CALL PRINT_GP("L", @"결국, 그녀는 당신을 자신이 원하는 상태로 만들었다고 느끼자, 떠나기 전에 이마에 마지막 따뜻하고 사랑스러운 키스를 해준다.")
CALL PRINT_GP("W", @"%CALLNAME:102%는 당신에게 즐겁게 손을 흔든 뒤 방을 나갔다.")
