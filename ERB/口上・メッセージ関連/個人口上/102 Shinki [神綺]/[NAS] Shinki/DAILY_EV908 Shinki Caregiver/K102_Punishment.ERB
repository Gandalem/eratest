@K102_WhyAmIGettingPunished(ARGS)
#FUNCTIONS
SIF !STRLENS(ARGS)
	ARGS '= K102_PlayerPunishedFor
SELECTCASE ARGS
	CASE "disobey"
		RETURNF @"너는 나의 지시를 잘 따르듯이 %PRINT_MALE("boy", MASTER)% 너의 가련한 %CALLNAME:102%"
	CASE "lawbreak"
		RETURNF @"너의 부족한 %CALLNAME:102% 때문에 지옥(Gensokyo)에 위협이 되는 행동을 멈춰야 한다."
	CASE "hornyBitch"
		RETURNF @"너는 네 불쌍한 %CALLNAME:102%를 위해 흥분을 어떻게 가라앉혀야 하는지 배워야 한다."
	CASE "pantyThief"
		RETURNF @"팬티를 어디서 훔치는지 더 조심해야 한다."
	CASE "delayingPunishment"
		RETURNF @"당신은 피할 수 없는 벌을 영원히 미룰 수는 없다, %CALLNAME:MASTER%"
	CASE "misclickGrope"
		RETURNF @"네가 얻는 게 바로 그거야 \"우연히\" 내 엉덩이를 세상으로 잡은 것에 대한 대가"
	CASE "misclickSkirt"
		RETURNF @"그게 네가 얻은 거야 \"실수로\" 내 드레스를 세상에 벗겨버린 것에 대한 대가"
	CASE "debug"
		RETURNF @"당신이 이것을 원했다"
	CASEELSE
		RETURNF @"너는 해야 한다 네 집안일을 잘 하는 것처럼 %PRINT_MALE("boy", MASTER)% 너의 불쌍한 %CALLNAME:102%"
ENDSELECT

@K102_WhyPunishTranslate(ARGS)
