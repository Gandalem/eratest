@K102_MysteryDiaper_Guilt_3
IF nOmutsu
LOCALS:2 '= "diaper"
ELSE
LOCALS:2 '= "panty"
ENDIF
CALL PRINT_GP("W", @"After a few weeks, you move the %LOCALS:2% again.")
CALL PRINT_GP("W", @"You were still seeing the %LOCALS:2% every time you went to get your diary, so you moved it into the desk.")
CALL PRINT_GP("W", @"Over the next week, the %LOCALS:2% is moved from the desk to the laundry basket, to the shrine in your bedroom, to the nightstand, and finally to your wardrobe.")
CALL PRINT_GP("W", @"Every time you move the %LOCALS:2%, you feel your guilt fall away, but it never lasts.")

@K102_MysteryDiaper_Guilt_4
CALL PRINT_GP("W", @"Your eyes open wide awake in the middle of the night from a deep sleep, depressed.")
CALL PRINT_GP("W", @"The feeling of guilt overtakes you, and you can't help but cry in your bed.")
CALL PRINT_GP("W", @"As you're crying up a river, %CALLNAME:102% opens the door and enters your room.")
CALL PRINT_GPC("W", @"「%CALLNAME:MASTER%....」", 102)
CALL PRINT_GPC("W", @"「Look what I have.」", 102)
CALL PRINT_GP("W", @"%CALLNAME:102% pulls out a rather thick diaper into her hands.")
CALL PRINT_GP("W", @"Weirdly enough, you feel your shame subside as %HE_SHE(102)% shows the diaper.")
CALL PRINT_GPC("W", @"「You want it, don't you?」", 102)
CALL PRINT_GP("W", @"You nod your head unconsciously.")
CALL PRINT_GPC("W", @"「Lets get you changed real quick.」", 102)
CALL DiaperChangeDesc(MASTER, 104, 102)
CALL PRINT_GPC("W", @"「You feel better?」", 102)
CALL PRINT_GP("W", @"You hope that wearing this normal diaper will give you the same peace as wearing %CALLNAME:102%'s diaper would, and it does.")
CALL PRINT_GP("W", @"The second %HE_SHE(102)% puts on your first diaper, you feel a wave of peace wash over you.")
CALL PRINT_GPC("W", @"「Get used them, %CALLNAME:MASTER%, you won't even need to go potty anymore.」", 102)
CALL PRINT_GP("W", @"%CALLNAME:102% gives you a kiss in the head, smiling as %HE_SHE(102)% opens the door and leaves the room.")

