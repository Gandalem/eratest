    ELSE
    LOCALS:3 '= "underwear bin"
    ENDIF
ELSE
    LOCALS:3 '= "trash can"
ENDIF
IF nOmutsu
LOCALS:2 '= "diaper"
ELSE
LOCALS:2 '= "panty"
ENDIF
CALL PRINT_GP("W", @"The box remains by your %LOCALS:3% for several weeks.")
CALL PRINT_GP("W", @"Each time you clean your room, you have a new excuse for why you don't also take out the box.")
CALL PRINT_GP("W", @"Your hands are too full, you're too tired to make a second trip, you're worried about someone discovering what's inside.")
CALL PRINT_GP("W", @"Once you run out of other excuses, you just resort to telling yourself that 『you forgot to grab it this time』.")

@K102_MysteryDiaper_Guilt_2
