@K102_MysteryDiaper_Send
IF Item:DiaperPail
    IF nOmutsu
    LOCALS:3 '= "diaper pail"
    ELSE
    LOCALS:3 '= "underwear bin"
    ENDIF
ELSE
    LOCALS:3 '= "trash can"
ENDIF
IF nOmutsu
LOCALS:2 '= "diaper"
ELSE
LOCALS:2 '= "panty"
ENDIF
IF STRLENS(nameArray:MASTER:na_LastName) && STRLENS(nameArray:MASTER:na_FirstName)
LOCALS:4 '= @"%nameArray:MASTER:na_LastName%, %nameArray:MASTER:na_FirstName%"
ELSE
LOCALS:4 '= @"%CALLNAME:MASTER%"
ENDIF

CALL PRINT_GP("W", @"A package arrives at your doorstep. It seems to have a label printed:")
LOCALS '= @"GENBU PRIORITY MAIL/"
LOCALS += @"Gensou-chan Global/"
LOCALS += @"1150 Pandemonium/"
LOCALS += @"Makai/"
LOCALS += @"SHIP TO: "
LOCALS += @"%LOCALS:4%/"
LOCALS += @"{CFLAG:MASTER:311} %STR_TR(8000+CFLAG:MASTER:311)%/"
SELECTCASE MAIN_MAP
CASE 10
LOCALS += @"Lunar Capital, Moon/"
CASE 11
LOCALS += @"Makai/"
CASEELSE
LOCALS += @"%GET_MAPNAME(GET_MAPID(CFLAG:MASTER:311))%, Gensokyo, Japan"
ENDSELECT
CALL PRINT_LETTER(@"%LOCALS%", , 40)  
SIF nVNGlobals
PRINTW
CALL PRINT_GP("W", @"Curious, you bring it inside your room.")
CALL PRINT_GP("W", @"You weren't expecting anything, but you're also not going to look a gift horse in the mouth. ")
CALL PRINT_GP("W", @"It's inside a generic, white box as expected, but once you unbox what it has, you're left with an elegantly decorated box with a happy devil at the front.")
CALL PRINT_GP("W", @"There's some nice handwriting on the box, looking at it, it seems to say:")
RESETCOLOR
CALL SET_KOJO_COLOR(102)
LOCALS '= @"Gensou-chan OyaTsumi/"
LOCALS += @"「That once ere thou die thou shall be mine.」/"
LOCALS += @"To: %NAME:MASTER%/"
LOCALS += @"From: %NAME:102%"
CALL PRINT_LETTER(@"%LOCALS%", , 40)    
SIF nVNGlobals
PRINTW
CALL PRINT_GP("W", @"You opening the box, you find a note written in pink ink. ")
LOCALS '= "I saw you-"
SETCOLOR C_RED
CALL PRINT_LETTER(@"%LOCALS%", , 40)
SIF nVNGlobals
PRINTW
CALL PRINT_GP("W", @"You drop the note. Immediately, you lock the door and close the blinds.")
CALL PRINT_GP("W", @"You scan your house to make sure no one is there before returning to the note.")

CALL SET_KOJO_COLOR(102)
LOCALS '= "I saw you take the chip./"
LOCALS += "And I felt it when you removed it without my permission./"
LOCALS += "I know your shame../"
LOCALS += "You took the devil's deal to learn magic, or to get forbidden tech, or for me to help you, but you were too weak./"
LOCALS += "You would rather bite the hand that fed you to undo what you did than to live with the consequences./"
LOCALS += "Now all you have is shame.//"

LOCALS += "I have a solution for you. A gift if you will./"
LOCALS += "All you have to do is put on my gift and pour your shame into it./"
LOCALS += "It will free you from your worries, free you from your shame, free you from your guilt./"
LOCALS += @"All you have to do is put it on.//- %NAME:102%"
CALL PRINT_LETTER(@"%LOCALS%", , 40)
SIF nVNGlobals
PRINTW
CALL PRINT_GP("W", @"Looking back into the box, you see a thick red and white %LOCALS:2% with several chibi drawings of the Makai devil all over.")
CALL PRINT_GP("W", @"On the back, the devil print continues, but you can see a drawn %CALLNAME:102% holding a sign, right over the wetness indicater, which says:")
RESETCOLOR
CALL SET_KOJO_COLOR(102)
CALL PRINT_LETTER(@"%LOCALS:4%", , 40)
SIF nVNGlobals
PRINTW
CALL PRINT_GP("W", @"You scoff and close the box.")
CALL PRINT_GP("W", @"Did %CALLNAME:102% really believe that you would put on a suspicious %LOCALS:2% %HE_SHE(102)% randomly sent you?")
CALL PRINT_GP("W", @"You set the box beside your %LOCALS:3%, you'll get rid of it the next time you clean your room.")
K102_DayOfDiaperSent = DAY

@K102_MysteryDiaper_Guilt_1
