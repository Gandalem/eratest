; Modular ERB: 個人口上/102 Shinki [神綺]/[NAS] Shinki/Shinki Questline 2.ERB

@M_KOJO_IRAI_UNIQUE_201_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「단막? 마법 카드 규칙으로 규제되는 비치사성 공중 마법 총격전이다.」
		PRINTFORML 「그것은 치명적인 전투와 비슷하지만, 캐릭터들이 【생명】을 가지고 있어서 그 생존 여부가 관건이다.」
		PRINTFORML 「게다가 단막 기반이 아닌 무기는 금지되므로, 우선 단막 레벨을 올리는 것이 좋다.」
		PRINTFORML 「전제는 상대방이 당신의 생명을 빼앗기 전에 상대방의 생명을 제거하는 것이다.」
		PRINTL
		PRINTFORML 「넓은 공터에서 연습할 수 있으니, 반드시 그렇게 해라.」
		PRINTFORML 「반감 지역으로 나가거나 들어올 때 종종 불량배들에게 도전받을 것이다.」
		PRINTL
		PRINTFORML 「아이디어는 적을 공격하고 적의 공격을 회피로 버티며 생존하는 것이다.」
		PRINTFORML 「명중한 탄환 하나가 동방 캐릭터에게 피해를 준다.」
		PRINTFORML 「마법 카드를 사용해 큰 대미지를 주거나 심지어 동방 캐릭터의【생명】까지 제거할 수 있지만, MP에 주의해야 한다.」
		RETURN 1
	CASE "Losing Lives"
		PRINTFORML 「전투원이 단막(Danmaku) 전투에서 체력을 모두 소진하면 생명 하나를 잃는다.」
		PRINTFORML 「만약 당신이 생명을 잃었다면, 피추운/비우 사운드가 공격받았음을 알려줄 것이다.」
		PRINTFORML 「모든 생명을 잃으면 매치에서 지게 되니 너무 부주의하지 않도록 주의해야 한다.」
		PRINTFORML 「적의 생명 전부를 잃게 만들면 그들은 전투에서 이탈하게 된다.」
	CASE "Losing"
		PRINTFORML 「모든 생명을 잃거나 자발적으로 항복하면, 그것은 경기를 패배했다는 의미이다.」
		PRINTFORML 「승리했을 때보다 패배했을 때 얻는 경험치는 훨씬 적을 것이다.」
		PRINTFORML 「단막(Danmaku) 매치 중 무슨 일이 일어나든, 사용된 MP는 경기 후에 자동으로 회복되지 않는다.」
	CASE "Winning"
		PRINTFORML 「적이 모든 생명을 잃으면, 그것은 당신이 승리했다는 뜻입니다.」
		PRINTFORML 「당신은 상당한 양의 경험치와 만약 상대가 가지고 있었다면 두루마리를 얻게 됩니다.」
		PRINTFORML 「단막(Danmaku) 매치 중에 어떤 일이 일어나더라도, 사용된 MP는 매치 후에 자동으로 회복되지 않습니다.」
	CASE "Misses"
		CALL SHOW_IRAI_MESSAGE(102, 202, "Misses")
	CASE "Dodged Hits"
		CALL SHOW_IRAI_MESSAGE(102, 202, "Dodged Hits")
	CASE "Your Turn"
		CALL SHOW_IRAI_MESSAGE(102, 202, "Your Turn")
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「감사합니다. 당신에게 제가 안내해 주길 바랄지도 안 된다는 것을 알고 있습니다.」
		ENDDATA
		IF !GETBIT(TALENT:MASTER:ESP,0)
			PRINTL
			PRINTFORMW 「오, 단막(彈幕) 사용하는 법도 모르나?」
			PRINTFORMW 「아, 외부인으로서 단막은 배워야 하는 것이지만 대부분의 근세현 출신들은 이미 단막을 할 줄 알 것이다.」
			PRINTFORMW 「계속하려면 필요할 테니 내가 쉽게 능력을 줄 수 있다.」
			PRINTFORMW 「단막이 있는 캐릭터라도 충분한 훈련이 없다면 없는 캐릭터보다 못할 수 있다는 점을 명심해라.」
			SETBIT TALENT:MASTER:ESP, 0
			MAXBASE:MASTER:7 = MAX(MAXBASE:MASTER:7,100)
			BASE:MASTER:7 = MAXBASE:MASTER:7
			CALL COLORMESSAGE(@"당신은 이제 【유술: 단막】을 가지게 되었다.", C_AQUA,2)
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 1
	CASE "依頼破棄時"
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

@M_KOJO_IRAI_UNIQUE_202_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「치명적인 전투는 처음에는 신규 주민들에게 약간 위협적으로 보일 수 있지만, 몇 가지 간단한 가이드라인이 당신을 전문가처럼 공격을 막고 땅을 지킬 준비가 되게 해줄 것이다.」
		PRINTFORML 「모든 총격전에는 기억해야 할 매우 중요한 생명을 구하는 규칙이 하나 있다:」
		FONTBOLD
		PRINTFORML 「항상 가능한 모든 위장술을 사용해라!」
		FONTREGULAR
		PRINTFORML 「전제는 상대 팀이 당신의 팀을 제거하기 전에 그들의 팀을 제거하는 것입니다.」
		PRINTFORML 「당신이 입히는 모든 피해는 상대방의 몸에 피해를 줍니다. 죽음이 활성화되어 있다면, 필수적인 부품 중 하나를 파괴함으로써 심지어 그들을 처치할 수도 있습니다.」
		PRINTL
		PRINTFORML 「당신의 기술과 당신의 무기가 성공을 가장 크게 결정한다.」
		PRINTFORML 「좋은 무기를 가졌을지라도, 그것을 보여줄 기술이 없다면 곡식 창의 넓은 면을 맞히지 못할 것이다.」
		PRINTFORML 「반대로, 사격 실력은 뛰어나지만 .22LR 권총만 가지고 있다면 당분간 아무것도 죽이지 못할 것이다.」
		PRINTFORML 「당신의 무기에 맞는 기술을 연마하는 것이 필수적이다.」
		PRINTFORML 「당신의 기술과 당신의 무기가 성공을 가장 크게 결정한다.」
		PRINTFORML 「단막은 단막 스킬에 해당하고, 화기는 사격 기술로 도움을 받으며, 근접 무기는 근접 스킬로 강화된다.」
		PRINTFORML 「하나의 전투 능력(단막, 사격 또는 근접)에서 뛰어나 있는 것이 세 가지 모두에서 그저 괜찮은 것보다 낫다.」
		PRINTL
		PRINTFORML 「넓은 공터에서 연습할 수 있으니, 반드시 그렇게 해라.」
		PRINTFORML 「반감 지역으로 나가거나 들어올 때 종종 불량배들에게 도전받을 것이다.」
		PRINTL
		PRINTFORML 「아이디어는 적을 공격하고 회피와 엄폐로 상대의 공격에 살아남는 것이다.」
		PRINTFORML 「명중하는 모든 타격은 토우호의 STA에 피해를 주고 그들의 신체 일부에 피해를 입힌다.」
		PRINTFORML 「마지막으로 남은 팀이 승리한다.」
		RETURN 1
	CASE "Out of HP"
		PRINTFORML 「치명적인 전투에서 전투원이 스태미나가 소진되면 기절한다.」
		PRINTFORML 「당신이 기절하면 즉시 패배하므로 너무 부주의하지 않도록 주의하라.」
	CASE "Losing"
		PRINTFORML 「기절하거나 기꺼이 항복한다면, 그것은 승리를 놓았다는 뜻이다.」
		PRINTFORML 「승리했을 때보다 패배하여 얻는 경험치는 훨씬 적을 것이다.」
		PRINTFORML 「치명적인 전투 중 무슨 일이 일어나든 입은 상처는 그대로 남아 치료가 필요하다.」
	CASE "Winning"
		PRINTFORML 「적이 모든 생명을 잃으면, 그것은 당신이 승리했다는 뜻이다.」
		PRINTFORML 「당신은 상당한 양의 경험치와 만약 그들이 소지하고 있었다면 두루마리를 얻게 될 것이다.」
		PRINTFORML 「치명적인 전투 동안 무슨 일이 일어나더라도 입은 상처는 그대로 남으며 치료가 필요하다.」
	CASE "Misses"
		PRINTFORML 「캐릭터가 공격을 빗나가면 수신자에게는 피해를 주지 않는다.」
	CASE "Dodged Hits"
		PRINTFORML 「캐릭터가 총알을 회피했다는 것은 그 총알이 명중해야 했으나, 수신자가 그것을 피했다는 의미이다.」
		PRINTFORML 「회피된 탄환은 빗나간 것과 같이 작용하며 피해를 주지 않는다.」
	CASE "Your Turn"
		PRINTFORML 「공격 우선순위는 상단에 표시되며, 누가 차례인지, 누가 다음에 갈지, 그리고 해당 턴 내에서 누가 이미 행동했는지 암시한다.」
		PRINTFORML 「차례는 설명이 필요 없다. 유일한 함정은 승자 없이 싸움을 강제로 끝내는 150턴의 최후통첩이 있다는 것이다.」
		PRINTFORML 「이는 보통 명중률이 낮은 무기나 무능력한 사수 대 무능력한 사수 같은 터무니없는 상황이 아니라면 발생하지 않는다.」
		PRINTL
		PRINTFORML 「너는 %TW_PORT_STR(@"Attack",1)%정상적으로 공격하거나 정밀하게 공격한다. 정상적인 공격은 무작위 신체 부위를 대상으로 하지만 대부분 몸통을 맞출 것이다.」
		PRINTFORML 「%TW_PORT_STR(@"Precise Shot",1)%은 대상을 죽이고 싶지 않거나 목표가 대상의 머리일 경우 신체 부위를 특정하여 공격할 수 있게 해준다.」
		PRINTFORML 「너는 「%TW_PORT_STR(@"Skills",1)%의 로드아웃에 있는 주문 카드 사용과 전투 중 단마쿠 아이템 사용을 허용한다.」」
		PRINTFORML 「너의 %TW_PORT_STR(@"Taking",1)% 커버가 널 무작위 커버 조각에 넣어서 일부 라운드를 막을 수 있다.」
		PRINTFORML 「너는 「%TW_PORT_STR(@"Tending",1)%의 상처가 현재 모든 너의 상처를 치료하고 500 STA를 주지만 이번 차례를 희생시킨다.」」
		PRINTFORML 「너는 「%TW_PORT_STR(@"Reloading",1)%이 네 탄창의 모든 탄약을 보충하는 데 너의 차례를 사용할 것이다.」」
		PRINTFORML 「%TW_PORT_STR(@"Switch Weapon",1)%은 이미 소유한 다른 무기로 무기를 교체할 수 있게 해준다.」
		PRINTFORML 「너는 적보다 더 강력하다면 「%TW_PORT_STR(@"Retreating",1)%이 싸움을 끝내지만, 그렇지 않다면 탈출하지 못할 가능성이 있다.」」
		PRINTFORML 「%TW_PORT_STR(@"Subdue",1)%이 적을 당신에게 항복시키려고 노력할 것이다. 이것은 당신의 %TW_PORT_STR("Speech",1)%에 근거한다.」
		PRINTFORML 「너는 %TW_PORT_STR(@"Submitting",1)%이 싸움을 끝내지만 너를 강간당하거나 강도를 당하게 하고 하루를 즉시 끝낸다.」
		PRINTFORML 「%TW_PORT_STR(@"NPC Direct Control",1)%을 사용하면 전투 중 모든 아군 NPC를 조종할 수 있다. 비활성화 시에는 자신만 조종하게 된다.」
	CASE "Armor"
		PRINTFORML 「방어구는 신체 부위가 손상되는 것을 막고, 체력과 신체에 가해지는 피해량을 줄이는 데 사용된다.」
		PRINTFORML
		PRINTFORML 「갑옷은 3가지 주요 스탯을 가지고 있다:」
		PRINTFORML 「%BREAKENG(@"방어구 강도: 무기가 방어구를 완전히 관통하고 최대 피해를 주기 위해 필요로 하는 관통력의 양이다. 총이 PM 등급 13의 방어구가 보호하는 신체 부위에 3회의 관통력을 가하면, 피해는 극적으로 감소한다. 방어구 강도는 유럽 VPAM 표준을 따른다. PM 1은 관통력 1과 같다.")%」
		PRINTFORML 「%BREAKENG(@"방어구 내구도: 방어구가 부서지기 전에 견딜 수 있는 피해량(kJ 단위)을 나타낸다. 방어구가 손상됨에 따라, 그것의 유효 강도는 파괴되거나 쓸모없어질 때까지 급격히 감소한다.")%」
		PRINTFORML 「%BREAKENG(@"방어구 범위: 방어구가 신체의 어느 부분을 보호할지 보여준다.")%」
		PRINTL
		PRINTFORML 장갑은 관통탄이나 더 높은 관통력을 가진 무기를 사용해서 대처할 수 있다.
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		RETURN 1
	CASE "依頼確認時"
		RETURN 1
	CASE "依頼破棄時"
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

@M_KOJO_IRAI_UNIQUE_203_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「이 세계의 'Health'는 각 상처에 피해 유형, 심각도, 그리고 출처를 나타내는 태그가 부여되어 모든 상처가 고유하게 취급되는 Hediff 시스템을 사용한다.」
		PRINTFORML 「각 부상은 캐릭터의 건강 중 다른 부분을 영향을 미치며, 해당 캐릭터의 'Health' 탭에서 확인할 수 있다.」
		PRINTFORML 「다양한 무기는 서로 다른 종류의 부상을 일으킨다. 예를 들어, 메이스는 분쇄하고, 장검은 베며, 불은 태운다.」
		PRINTFORML 「상처의 유형은 그것이 유발하는 고통의 양, 출혈 속도, 그리고 감염 확률에 영향을 준다.」
		PRINTFORML 「부상은 행동의 효율성과 신체 부위의 생존 가능성에 영향을 미친다.」
		PRINTL
		PRINTFORML 「이 튜토리얼을 위해 당신은 출혈이 시작될 정도로 피해를 입게 될 것입니다.」
		PRINTFORML 「즉시 【Doctoring】명령을 사용하여 부상을 치료해야 합니다. 그렇지 않으면 피로 죽을 수도 있습니다.」
		RETURN 1
	CASE "Tending"
		PRINTFORML 「부위가 HP를 회복하는 유일한 방법은 시간뿐이지만, '돌보기'는 그것의 효과를 엄청나게 증가시킨다.」
		PRINTFORML 「'상처 돌보기'는 또한 상처 감염이 발생할 확률을 낮추고 출혈을 멈춘다.」
		PRINTL
		PRINTFORML 「치료한 상처는 품질을 가지며, 이는 당신의 의술과 치료에 사용된 약품으로 결정된다.」
		PRINTFORML 「더 높은 품질의 치료는 상처를 더 빨리 치유하게 만든다.」
	CASE "Bleeding"
		PRINTFORML 「출혈은 특정 피해 유형으로부터 흔하게 발생한다.」
		PRINTFORML 「부상을 입고 출혈 상태일 경우, 캐릭터는 상처와 상처의 양에 비례하여 체력 손실을 얻는다.」
		PRINTFORML 「캐릭터가 더 이상 피를 가지고 있지 않으면 즉시 사망하며, 해당 처치는 마지막으로 토우호(Touhou)와 싸운 자에게 공로가 돌아간다.」
		PRINTFORML 「살아남고 싶다면 가능한 한 빨리 출혈을 멈추는 것이 가장 좋다.」
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMDW 가슴에 갑자기 고통을 느낀다.
		PRINTFORMW 「내가 준 응급 키트를 사용하여 【치료하기】 메뉴로 상처를 치료하라.」
		CALL GET_ITEM("FirstAidKit",3,2)
		CALLF DamageBodyPart(MASTER,40,TALENT:MASTER:40 ? 1000 # 500,3,102,"Tutorial Wound")
		RETURN 1
	CASE "依頼確認時"
		RETURN 1
	CASE "依頼破棄時"
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
