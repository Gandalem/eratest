@M_KOJO_IRAI_UNIQUE_401_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		$FIRSTSEE
		PRINTFORML 「이 세계의 대부분의 캐릭터들은 %TW_PORT_STR("Pee",1)%이라는 액체를 배출한다.」
		PRINTFORML 「%TW_PORT_STR("Pee",1)%은 방광에 저장되며, 마시거나 시간이 지남에 따라 축적된다.」
		PRINTFORML 「충분히 소변을 보면 화장실에 가고 싶은 욕구가 생기며, 그 결과 %TW_PORT_STR("Relieve Yourself",0)%할 방법을 찾아야 한다.」
		PRINTFORML 「소변을 보고 싶다는 갈망이 커질수록 집중할 수 없게 되고, 자신을 해소하기 전까지 훨씬 더 나쁜 행동들을 하게 된다.」
		PRINTL
		PRINTFORML 「필요할 때 『화장실』에 가서【배변】하는 것이 필수적이다.」
		PRINTFORML 「그것은 방광을 비우고 절제력을 높여줄 것이다.」
		PRINTFORML 「만약 화장실에 가거나 다른 방법으로 배변할 수 없다면,『요실금 사고』를 하게 될 것이다.」
		RETURN 1
	CASE "Levels of Desperation"
		PRINTFORML 「절망의 단계는 8단계가 있으며, 각 단계마다 참기가 점점 더 어려워진다.」
		PRINTFORML 「%PeeBarStageName(0)% : 당신의 방광은 완전히 비었으며, 페널티는 없다.」
		PRINTFORML 「%PeeBarStageName(2)% : 소변이 마렵기 시작한다. 이 단계부터 변기를 사용하기 시작한다. 페널티는 없다.」
		PRINTFORML 「%PeeBarStageName(3)% : 장소를 서성이기 시작한다. 경미한 페널티가 부과된다.」
		PRINTFORML 「%PeeBarStageName(4)% : 소변이 정말 마렵다고 느낀다. 중간 정도의 페널티가 부과된다.」
		PRINTFORML 「%PeeBarStageName(5)% : 방광이 터질 것 같은 느낌이다. 심각한 페널티가 부과된다.」
		PRINTFORML 「%PeeBarStageName(6)% : 방광이 담을 수 있는 한계에 도달했다. 심각한 페널티 + 소변이 새고 싶은 확률이 있다.」
		PRINTFORML 「%PeeBarStageName(7)% : 더 이상 참을 수 없고 방광 근육이 풀렸다. 사고는 피할 수 없다.」
		PRINTL
		PRINTFORML 「소변을 참는 것은 새기 시작할 때까지 소변 참기 EXP를 증가시키지만, 그 후에 EXP를 잃게 된다.」
		PRINTFORML 「실제로 절제력을 훈련하는 것은 새기 시작할 때까지 스스로를 참거나 제때 화장실을 이용하는 것을 포함한다.」
	CASE "Toileting"
		PRINTFORML 「어떤 화장실에는 몸을 비울 수 있는 %TW_PORT_STR("Toilet",1)%가 있다.」
		PRINTFORML 「변기를 사용하면 당신의 %PeeAndPoo(nPee,nScat,"bladder","bowels")%를 비우고 절망과 관련된 디버프를 제거한다.」
		PRINTFORML 「대부분의 변기는 %TW_PORT_STR("Private",1)%인데, 이는 한 번에 한 사람만 사용할 수 있다는 것을 의미한다.」
		PRINTFORML 「%TW_PORT_STR("Public",1)% 화장실은 더 많은 사람들이 그것들을 사용하도록 허용한다.」
		PRINTFORML 「일부 종교에서는 변기 사용을 금지할 수도 있음을 명심해야 한다.」
		PRINTL
		PRINTFORML 「화장실을 사용하려면 옷을 제때 벗을 만큼 손재주가 좋아야 한다.」
		PRINTFORML 「제때 옷을 벗지 못하면 화장실에 갈 때 사고를 치게 된다.」
		PRINTFORML 「충분한 소변 의존증이 있으면 변기에 앉았을 때 속옷을 내리는 데 실패할 수 있다.」
		PRINTFORML 「그 결과 기술적으로는 "해냈지만" 속옷을 더럽히게 된다.」
	CASE "Intake"
		PRINTFORML 「무언가를 마시면 수분 섭취량이 증가한다.」
		PRINTFORML 「이는 방금 마신 물을 소화하면서 생성되는 소변량을 늘린다. 또한 소변의 농도를 낮춘다.」
		PRINTFORML 「물을 더 많이 마실수록 소변은 옅어지고, 물을 적게 마시면 소변은 더 어두워진다.」
		PRINTFORML 「배뇨는 이후 소변의 농도를 감소시킨다는 점을 염두에 두어야 한다.」
		PRINTFORML 「농도가 낮은 소변이 농도가 높은 소변보다 더 많이 쌓인다.」
		PRINTFORML 「연한 노란색에서 연한 호박색의 소변은 당신이나 캐릭터가 건강하게 수분을 유지하고 있음을 의미한다. 더 어두운 색은 너무 진하며, 투명하다는 것은 물을 너무 많이 마셨다는 뜻이다.」
	CASE "Continence"
		PRINTFORML 「각 캐릭터는 방광 조절 수준과 방광 크기를 가지고 있으며, 이 둘이 합쳐져 효과적인 조절 수준을 만든다.」
		PRINTFORML 「더 높은 수치는 더 많은 소변을 참을 수 있음을 의미하고, 낮은 수치는 그 반대를 의미한다.」
	CASE "Public Urination"
		PRINTFORML 「통이 마르고 화장실이 없을 때, 그들은 공공장소에서 소변을 보는 것을 고려할 수 있다.」
		PRINTFORML 「이는 밖에 나가서 한적한 곳으로 이동하고, 속옷을 내리고, 소변을 보는 행위를 포함한다.」
		PRINTFORML 「사고를 일으키는 것보다는 처벌이 덜하지만, 공공장소에서 소변을 보는 것은 여전히 무례하며 목격자들에게 【배변 훈련 안됨】 평판을 받게 한다.」
	CASE "Accidents"
		PRINTFORML 「제때 용변을 보지 못하면 사고가 날 수 있다.」
		PRINTFORML 「이것은 옷을 더럽히고 배변 상태에 영향을 주며 목격자들에게 【배변 훈련이 안 된】 평판을 받게 만든다.」
		PRINTFORML 「만약 사고를 흡수할 만큼 용량이 큰 기저귀나 패드를 착용하고 있다면 아무도 눈치채지 못한다.」
		PRINTFORML 「만약 패드가 당신의 사고를 담기 부족하다면 보조 제품이 필요하거나 더 높은 등급의 패드로 올라가야 할지도 모른다.」
		PRINTFORML 「소변을 보는 것은 일반적으로 해당 캐릭터에게 당혹스러운 일이며 나쁜 기분을 유발할 수 있다.」
		PRINTL
		PRINTFORML 「여러 번의 사고가 발생하면 그 일이 일어날 때 쾌감을 느끼게 된다. 이것을 중독이라고 한다.」
		PRINTFORML 「또한 화장실에 갈 때 속이 넘쳐 팬티를 적시는 것을 막기가 더 힘들어지므로, 그런 점도 있다.」
		PRINTL
		PRINTFORML 「통제할 수 있다면 사고가 나지 않게 하는 것이 가장 좋고, 그렇지 않다면 보호 장비를 사용해야 한다.」
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「감사합니다. 당신에게 제가 안내해 주길 바랄지도 안 된다는 것을 알고 있습니다.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		GOTO FIRSTSEE
		RETURN 1
	CASE "依頼破棄時"
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

@M_KOJO_IRAI_UNIQUE_402_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		$FIRSTSEE
		PRINTFORML 「이 세계의 대부분의 생물은 %TW_PORT_STR("Poo",1)%이라 불리는 고형물을 배설한다.」
		PRINTFORML 「%TW_PORT_STR("Poo",1)%은 당신의 대장에 저장되며 먹는 것과 시간의 경과에 따라 축적된다.」
		PRINTFORML 「이것은 기본적으로 %TW_PORT_STR("Pee",1)% 시스템처럼 작동하지만, 이것은 고형 폐기물에 해당한다.」
		PRINTFORML 「%TW_PORT_STR("Pee",1)% 시스템에서 나오는 대부분의 사항들이 여기에도 적용된다.」
		RETURN 1
	CASE "Levels of Desperation"
		PRINTFORML 「절박함의 단계가 8단계로 존재하며, 각 단계는 유지하기가 더욱 힘들어집니다.」
		PRINTFORML 「%PooBarStageName(0)% : 당신의 대장은 완전히 비어있으며, 페널티 없음.」
		PRINTFORML 「%PooBarStageName(2)% : 배변 욕구를 느끼기 시작한다. 이것은 변기를 사용하기 시작하는 단계이다. 페널티 없음.」
		PRINTFORML 「%PooBarStageName(3)% : 압박감이 불편해지기 시작한다. 경미한 페널티.」
		PRINTFORML 「%PooBarStageName(4)% : 정말로 배변하고 싶다는 느낌이 든다. 중급 페널티」
		PRINTFORML 「%PooBarStageName(5)% : 당신의 대장이 터지기 직전인 것 같다. 심각한 페널티」
		PRINTFORML 「%PooBarStageName(6)% : 당신의 대장은 담아낼 수 있는 한계에 도달했다. 심각한 페널티 + 통제력을 잃을 확률.」
		PRINTFORML 「%PooBarStageName(7)% : 더 이상 참을 수 없고 항문 근육이 풀렸다. 사고는 불가피하다.」
		PRINTL
		PRINTFORML 「소변의 절박함과는 달리, 압력을 좀 해소하기 위해 조금 새어 나오는 것만으로는 안 된다.」
		PRINTFORML 「어떤 시도든 너는 완전히 망쳐버리게 될 것이다.」
	CASE "Toileting"
		PRINTFORML 「어떤 화장실에는 몸을 비울 수 있는 %TW_PORT_STR("Toilet",1)%가 있다.」
		PRINTFORML 「변기를 사용하면 당신의 %PeeAndPoo(nPee,nScat,"bladder","bowels")%를 비우고 절망과 관련된 디버프를 제거한다.」
		PRINTFORML 「대부분의 변기는 %TW_PORT_STR("Private",1)%인데, 이는 한 번에 한 사람만 사용할 수 있다는 것을 의미한다.」
		PRINTFORML 「%TW_PORT_STR("Public",1)% 화장실은 더 많은 사람들이 그것들을 사용하도록 허용한다.」
		PRINTFORML 「일부 종교에서는 변기 사용을 금지할 수도 있음을 명심해야 한다.」
		PRINTL
		PRINTFORML 「변기를 사용하려면 제 시간에 옷을 벗을 만큼 손재주가 있어야 한다.」
		PRINTFORML 「제 시간에 옷을 벗지 못하면 변기에 갈 때 사고를 치게 된다.」
		PRINTFORML 「충분한 오염 중독이 있으면 변기에서 속옷을 내리는 것을 시도하지 못할 수 있다.」
		PRINTFORML 「이렇게 되면 기술적으로는 "성공"했지만 속옷을 더럽히게 된다.」
	CASE "Intake"
		;todo: poopa rework
	CASE "Open Defecation"
		PRINTFORML 「동방 캐릭터가 변의를 느끼는데 화장실이 없을 경우, 공공장소에서 배변하는 것을 고려할 수 있다.」
		PRINTFORML 「이는 야외로 나가서 한적한 장소를 찾아 속옷을 내리고 배변하는 것을 포함한다.」
		PRINTFORML 「사고보다 처벌은 덜하지만, 공공장소에서 배변하는 것은 여전히 무례하며 목격자들에게 【배변 훈련이 안 된】 평판을 받게 한다.」
	CASE "Accidents"
		PRINTFORML 「지저분한 사고는 많은 면에서 소변 실수와 비슷하다.」
		PRINTFORML 「둘 다 옷을 더럽히고, 배변 조절에 영향을 주며, 목격자들에게 너에게 【배변 훈련 안 됨】이라는 평판을 준다.」
		PRINTFORML 「더러움은 아주 빨리 끝나지만, 젖은 사고는 약 1분 정도 지속될 수 있다.」
		PRINTFORML 「하지만 소변 실수의 경우 속옷이 그것을 버틸 수 있다면, 변으로 인해 생기는 냄새 때문에 노출될 수도 있다.」
		PRINTFORML 「대부분의 속옷은 사고를 막아주지만, 따라서 정상적인 장을 가진 사람에게는 속옷이 터지는 경우는 드물다.」
		PRINTFORML 「각 종류의 속옷은 같은 양의 대변을 담으므로 바지나 트렁크처럼 더 많이 덮어주는 유형을 찾는다.」
		PRINTFORML 「기저귀나 패드를 찾는다면 누출 방지 기능이 있는 것을 잡으라, 그것들이 속옷이 더 많은 대변을 지탱하도록 도와준다.」
		PRINTL
		PRINTFORML 「여러 번의 사고를 겪으면 그 일이 일어날 때 쾌감을 느끼게 된다. 이것을 중독이라고 부른다.」
		PRINTFORML 「그것들은 또한 화장실에 갈 때 속옷을 채우지 않기가 더 어렵게 만들어서, 그런 면도 있다.」
		PRINTL
		PRINTFORML 「통제할 수 있다면 사고가 나지 않게 하는 것이 가장 좋고, 그렇지 않다면 보호 장비를 사용해야 한다.」
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「감사합니다. 당신에게 제가 안내해 주길 바랄지도 안 된다는 것을 알고 있습니다.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		GOTO FIRSTSEE
		RETURN 1
	CASE "依頼破棄時"
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

@M_KOJO_IRAI_UNIQUE_403_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		$FIRSTSEE
		LOCALS =
		SIF nOmutsu
			LOCALS += "『Diaper』、"
		LOCALS += "『Pad』、"
		LOCALS:1 =
		SIF GETBIT(nPee,1)
			LOCALS:1 += "a slight amount of pee、"
		SIF GETBIT(nScat,2)
			LOCALS:1 += "almost a full colon's worth of poo、"
