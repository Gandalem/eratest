		ENDIF
		;PLAYERだけ射精
	ELSE
		;TARGETについてる
		IF GETBIT(TALENT:性別,1)
			PRINTFORMW
			RETURN 1
			;付いてない
		ELSE
			PRINTFORMW
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

