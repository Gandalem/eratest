@M_KOJO_DIARYSETTING_K102(ARG, ARG:1 = 1)
;日記発生処理の一括管理関数
;=============================
SIF DIARY:102:ARG != 0
	RETURN
;IF ARG:1 == 0 && CFLAG:102:K60EN_PARSEE_DIARY_WARNING == 2 && ABL:MASTER:教養 > 2
IF ARG:1 == 1
	DIARY:102:ARG = 2
ELSE
	DIARY:102:ARG = 3
	CALL CHARA_DIARY_PAGESETTING(102, ARG)
ENDIF
