@M_KOJO_MESSAGE_COM_K102_406_1
;コマンド口上
;TFLAG:194（誰の日記を読んでいるか）
;TFLAG:194が102でない場合は他人の日記なので注意。
;PAGEは書かれてあるページ数。
;SHIRAHU(102)はキャラ102の状態が正常かどうか。
;=============================
#DIM PAGE
;以下はサンプル
PAGE = 0
FOR LOCAL, 0, MAX_DIARY_PAGE:(TFLAG:194):0
IF GROUPMATCH(DIARY:(TFLAG:194):LOCAL, 1, 3)
	PAGE ++
ENDIF
NEXT
IF SHIRAHU(102) && TFLAG:194 == 102
	;日記を読み終わった後の反応
	IF PAGE > 2
		CALL SPTALK, 102,"通常",0,@"「일기를 보여준다고... 뭔가 부끄럽네...」// %CALLNAME:102%는 진지하게 이쪽을 바라보고 있다."
		;画像つきトークは最大６行まで。
	ELSE
		PRINTFORML 
	ENDIF
ENDIF
