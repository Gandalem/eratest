;==================================================
;Fist Fuck (unused)
;141,フィストファック
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K102_141
RETURN 0

@M_KOJO_MESSAGE_COM_K102_141
CALL M_KOJO_MESSAGE_COM_K102_141_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K102_141_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		CALL PRINT_GP("W", @"%CALLNAME:102%는 당신이 자신의 %HIS_HER(102)%의 음부에 주먹을 대자 당신을 바라본다.")
		CALL PRINT_GPC("W", @"「정말 거기 팔을 넣고 싶어? 엄청 두꺼워 보이는데.」", 102)
		IF CAN_ACCIDENT(102,1)
			CALL PRINT_GPC("W", @"「나는 당신에게 약간의 \"윤활\" 이것에」", 102)
			CALL PRINT_GP("W", @"%HIS_HER(102,1)%의 얼굴이 빨갛게 빛나기 시작하고 %HE_SHE(102)%는 당신의 팔에 소변을 보기 시작한다.")
			CALL PRINT_GP("W", @"분사액이 팔과 주변 지역을 노란 빛으로 적시고, %HIS_HER(102)%의 사고 냄새가 공기 중에 퍼진다.")
			CALL PRINT_GPC("W", @"「이 정도면 충분할 거야. 냄새는 신경 쓰지 말아 줘, 알겠지.」", 102)
			CALL PRINT_GP("W", @"음, 고마워. 그런가 봐.")
			CALLF PeeMe(102)
			TRYCALL OMORASHI_END(102,1,0,1,-1)
		ENDIF
		CALL PRINT_GP("W", @"%HE_SHE(102,1)%은(는) 걱정스러운 눈빛으로 당신의 팔을 바라본다.")
		CALL PRINT_GPC("W", @"「내 질이 아직 이렇게까지 열린 것 같지 않아.」", 102)
		CALL PRINT_GPC("W", @"「그냥 천천히, 그리고 조심스럽게 해아아아아악~」", 102)
		CALL PRINT_GP("W", @"당신은 문장 도중에 천천히 팔을 %CALLNAME:102%의 질 안으로 넣는다.")
		CALL PRINT_GP("W", @"구멍이 %HIS_HER(102)%의 질을 감싸며 커지고 움직일 때 쾌감의 진동을 보낸다.")
		CALL PRINT_GPC("W", @"「후우욱하아아... 뉴하아아아아흐으으~」", 102)
		CALL PRINT_GP("W", @"팔을 움직일 때, 황홀경의 물결이 계속해서 %TNAME(102)%를 과도하게 자극하여 %HIM_HER(102)%가 고통을 외치며 크게 비명을 지르게 만든다.")
		CALL PRINT_GPC("W", @"「아아아악... 흐으으아.... 나... 싸... 아아아악하아~」", 102)
		CALL PRINT_GP("W", @"%HIS_HER(102)% 질이 비명과 함께 수축하며 %HE_SHE(102)% 절정에 달하는 것을 느낄 수 있다.")
		CALL PRINT_GP("W", @"%HIS_HER(102,1)%의 몸은 쾌감에 뒤로 밀리며, 눈을 감고 혀를 내밀었다.")
		IF CAN_ACCIDENT(102,1)
			CALL PRINT_GP("W", @"%HIS_HER(102)%의 오르가슴의 힘이 가련한 신의 방광을 압도하며, 그 신은 %HIM_HER(102)%를 배신하기로 결정한다.")
			CALL PRINT_GP("W", @"강한 %URINE(102)%의 물웅덩이가 두 사람 주위를 흐르고 있었고, 그 사고의 강렬함은 오르가즘의 세기와 같았다.")
			CALLF PeeMe(102)
			TRYCALL OMORASHI_END(102,1,0,1,-1)
		ENDIF
		CALL PRINT_GP("W", @"오르가슴이 가라앉자, %CALLNAME:102%는 아직 %HIS_HER(102)%의 이성을 되찾지 못한 듯했다.")
		LOCALS '= "땀, 보지 주스,"
		SIF CAN_ACCIDENT(102,1)
			LOCALS += @"%URINE(102)%"
		CALL PRINT_GP("W", @"누워 있는 %HIS_HER(102)% 자신의 더미에 %LOCALS%, %CALLNAME:102% 여운 속에서 녹아내린다.")
		CALL PRINT_GPC("W", @"「아프다... 아프다.... 하하하....」", 102)
		CALL PRINT_GPC("W", @"「%CALLNAME:MASTER%, 왜 경고를 안 해줬어에에에에。」", 102)
		CALL PRINT_GPC("W", @"「하지만... 아아하아하... 정말 너무너무 좋았어.」", 102)
		RETURN 1
	ENDIF
	SELECTCASE ABL:TARGET:54
		CASE IS >= UniversalRank("Extra")
		CASE IS >= UniversalRank("S")
		CASE IS >= UniversalRank("A")
		CASE IS >= UniversalRank("B")
		CASE IS >= UniversalRank("C")
		CASE IS >= UniversalRank("D")
		CASE IS >= UniversalRank("G")
			CALL PRINT_GPC("W", @"「으악! 아프네.」", 102)
			CALL PRINT_GPC("W", @"「좀 더 부드럽게 해줘, 알겠지. 내 질은 아직 이게 익숙하지 않아.」", 102)
	ENDSELECT
ENDIF
RETURN 1
