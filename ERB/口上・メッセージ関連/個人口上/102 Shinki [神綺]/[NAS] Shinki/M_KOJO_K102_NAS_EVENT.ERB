@M_KOJO_EVENT_K102_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDL %CALLNAME:102%은 바닥에 생기 없이 쓰러져 있는 %CALLNAME:(ARG:1)%를 발견한다.
		PRINTFORMW 「%CALLNAME:(ARG:1)%에게 무슨 일이 일어난 거지... %HE_SHE(ARG:1)%는... 죽은 걸까?」
		PRINTFORMDL %CALLNAME:102%은 %HIS_HER(102)%의 손을 %CALLNAME:(ARG:1)%의 몸 위에 올려놓고, 그것이 차갑다는 것을 알게 된다.
		IF PermaDeath >= 2
			SELECTCASE RELATION:TARGET:(ARG:1)
				CASE IS >= 150
					PRINTFORMW 「이게 현실일 리가 없어!」
					PRINTFORMW 「%CALLNAME:(ARG:1)%!」
					PRINTFORMDW %HIS_HER(102)%의 얼굴에서 눈물이 흘러내리고 %HE_SHE(102)%는 %CALLNAME:(ARG:1)%를 더욱 흔들며 %HIM_HER(ARG:1)%를 깨우려 애썼지만 소용없었다.
					PRINTFORMW 「%CALLNAME:(ARG:1)%... 제발...」
					PRINTFORMW 「%CALLNAME:(ARG:1)%%SUBSTRING(CALLNAME:(ARG:1),STRLENS(CALLNAME:(ARG:1))-1)%～～～」
					PRINTFORMDW 
					SETCOLOR C_RED
					PRINTFORMW 「내가 %CALLNAME:(ARG:1)%를 죽이기로 결정한 그 새끼를 죽여주마」
					PRINTFORMW 「기다려 보시지.」
					RELATION:102:(KilledBy:(ARG:1):0) = MAX(RELATION:102:(KilledBy:(ARG:1):0)-50,1)
					RESETCOLOR
				CASE IS > 100
					PRINTFORMW 「No... No!」
					PRINTFORMW 「나에게 %HES_SHES(ARG:1)% 죽었다고 말하지 마...」
					PRINTFORMDW %HE_SHE(102)%이 %HIS_HER(102)%의 친구가 죽었음을 깨닫자 눈물이 %HIS_HER(102)%의 얼굴에서 흐른다.
				CASE 100
					PRINTFORMW 「젠장...」
					PRINTFORMW 「%HES_SHES(ARG:1,1)% 죽었다.」
				CASE IS < 100
					PRINTFORML 「%HE_SHE(ARG:1)%가 받아 마땅한 것을 얻었다.」
				CASE IS <= 50
					PRINTFORML 「속 시원하다.」
					PRINTFORMW 「%HE_SHE(ARG:1)%이 마카이의 신을 건드릴 수 있을 거라고 정말 생각하지 않았어.」
			ENDSELECT
		ELSE
			SELECTCASE RELATION:TARGET:(ARG:1)
				CASE IS >= 150
					PRINTFORMW 「No... No!」
					PRINTFORMW 「%HES_SHES(ARG:1)%가 죽었다고 말하지 마...」
					PRINTFORMW 「기다려, 내가 뭔가 할 수 있을 것 같아.」
					$ShinkiResurrects
					PRINTL
					PRINTFORMW 「리카름...」
					CALL PROCESS_YOUJUTSU_COMMAND(102,ARG:1,7,7)
				CASE IS > 100
					PRINTFORMW 「진심으로...」
					PRINTFORMW 「슬픈 게 아니라, 누군가 %CALLNAME:(ARG:1)%을 죽인 게 짜증 날 뿐이야.」
					PRINTFORMW 「또 죽은 다른 친구에게 재림(Recarm)을 시전할 시간이다.」
					GOTO ShinkiResurrects
				CASE 100
					PRINTFORMW 「젠장...」
					PRINTFORMW 「또?」
					GOTO ShinkiResurrects
				CASE IS < 100
					PRINTFORML 「%HE_SHE(ARG:1)%가 받아 마땅한 것을 얻었다.」
				CASE IS <= 50
					PRINTFORML 「잘 가라.」
					PRINTFORMW 「정말로 %HE_SHE(ARG:1)%이 마카이의 신을 건드릴 수 있을 거라고 생각하지 않았다.」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
