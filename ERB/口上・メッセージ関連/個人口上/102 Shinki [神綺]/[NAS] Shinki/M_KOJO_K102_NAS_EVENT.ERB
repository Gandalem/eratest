@M_KOJO_EVENT_K102_101(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	PRINTDATAL
		DATAFORM 「AAAAHHHAAAAAAAAA....」
		DATAFORM 「나 여기서 죽어가고 있어... 제발!」
		DATAFORM 「NNNNHAAAAAAH...」
		DATAFORM 「못 해... 갈 수 없어...」
		DATAFORM 「이 세상은... 나를 미워해...」
	ENDDATA
	PRINTFORML %CALLNAME:102%는 땅에 쓰러져, 흐느끼며 %HIS_HER(102)%의 마지막 말을 내뱉는다.
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Death by gunshot
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Cut to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Burned to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Crushed to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Electrocution
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
