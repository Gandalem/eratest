	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		SELECTCASE ARG:1
			CASE 1
				;wetting
				PRINTFORML 「이런, 이게 뭐야?!」
				PRINTFORML 「내 %조사처리(CALLNAME:MASTER,"가")% %HIMSELF_HERSELF(MASTER)%했나?」
