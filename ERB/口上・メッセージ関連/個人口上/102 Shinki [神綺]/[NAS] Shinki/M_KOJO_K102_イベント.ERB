	;-------------------------------------------------
	;Character returns to their room to sleep
	;自室に帰って寝る（～は【現在地】から【キャラの自室】に戻りました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF ARG:1
			;デート中に眠くて帰って寝る（拠点キャラのみ）
			PRINTFORML 「야아앙~ 미안해요 %CALLNAME:MASTER%, 하지만 너무 졸려서 더 머물 수가 없어요.」
			PRINTFORML 「이제 집에 가봐야 해요.」 
		ELSEIF CFLAG:うふふ
			;うふふ中に眠くて自室に帰って寝る（拠点キャラのみ）
			PRINTFORML 「흐읍... 흐읍... 이제... 그만...」
			PRINTFORML 「잘 자렴, 귀염둥이... 쪽」
		ELSE
			PRINTFORMW 「나 이제 들어가 봐야겠어, 눈이 더 이상 떠 있으려 하지 않아.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている（～は眠そうにしている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「음... 곧 자야겠어...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（～は眠っている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕
			IF GETBIT(VAR_OR_DEFAULT("nPee"),1) && !RAND:4
				PRINTFORML 「아아... %CALLNAME:MASTER%... 나... 소변 보는 중이야～... 쿨쿨.」
				PRINTFORMDL 당신은 %CALLNAME:102%가 또 다른 소변 꿈을 꾸는지 궁금해한다...
				PRINTFORMDW 그러다 %HIM_HER(102)%으로부터 들려오는 쉬익거리는 소리를 듣게 된다...
				PRINTFORMDW 잠든 %CALLNAME:102%는 %HIS_HER(102)%에서 %HIS_HER(102)+" "+PeeProtectType(MASTER)%이/가 %HE_SHE(102)%에 의해 넘쳐흐르는 것을 보고 얼굴을 붉힌다.
				TRYCALL OMORASHI_END(102,1)
			ELSE
				PRINTFORML 「%CALLNAME:MASTER%, 정말 나를 기쁘게 하는 방법을 아는구나~... 후후... 쿨쿨.」
				PRINTFORMDW 그녀가 꿈꾸고 있는 것은 바로 그것일까...
			ENDIF
		ELSEIF TALENT:184 || TALENT:185 || TALENT:3 || TALENT:142
			PRINTFORML 「음... 아아... 장난꾸러기 %CALLNAME:MASTER%... 만지작하는 아가야...」
			PRINTFORMDW %CALLNAME:102%의 음란한 수면의 말이 당신의 욕망을 깨우기 시작한다.
		ELSE
			PRINTFORML 「..분기 실적이 80\%이나 올랐어... 쿨쿨.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱して寝る（体力500以下,うふふ時はうふふ強制終了）
	;（キャラの自室以外：～を【現在地】から【キャラの自室】に運びました）
	;（キャラの自室　　：～は疲れたと言って、横になりました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:うふふ
			;うふふ中にダウン
			PRINTFORML 「하아, 하아... 더는... 나, 못...」
		ELSEIF TCVAR:102:797
			PRINTDATAL
				DATAFORM 「AAAAHHHAAAAAAAAA....」
				DATAFORM 「나 여기서 죽어가고 있어... 제발!」
				DATAFORM 「NNNNHAAAAAAH...」
				DATAFORM 「못 해... 갈 수 없어...」
				DATAFORM 「이 세상은... 나를 미워해...」
			ENDDATA
		ELSE
			PRINTFORML 「나... 나-나 할 수 없어...」
			PRINTFORML 「그냥... 여기에 누워서... 잠들 것 같아... 쿨쿨」
		ENDIF
		PRINTFORMDW %CALLNAME:102%은(는) 더 이상 몇 마디의 말을 중얼거리다가 쓰러졌다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（恋慕のみ,そのまま一日が終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;お酒でダウン
		IF BASE:MASTER:酒気 >= MAXBASE:MASTER:酒気
			IF ARG:1
				;自室でダウン,（～が【MASTER】をベッド（布団）へと運んでくれた…）
				PRINTFORMW 
			ELSE
				;部屋まで運ばれる,（～が【MASTER】を私室へと運んでくれた…）
				PRINTFORML 「아아앙......」
				PRINTFORML 「%HIS_HER(MASTER)%의」 몸을 위해 술을 너무 많이 마신 작은 아기.
				IF nOmutsu
					PRINTFORML 「당신을 방으로 데려다주고 기저귀를 갈아줄게요.」
					PRINTFORML 「침대는 스스로 깨끗해지지 않으니까, 따뜻한 사용된 기저귀가 차가운 침대보다 나아요.」
					TRYCALLF PANTY_REWORK_CHANGE(MASTER,103)
				ENDIF
			ENDIF
			;体力切れでダウン
		ELSE
			IF ARG:1
				;自室でダウン,（～が【MASTER】をベッド（布団）へと運んでくれた…）
				PRINTFORMW 
			ELSE
				;部屋まで運ばれる,（～が【MASTER】を私室へと運んでくれた…）
				PRINTFORML 「!!!」
				PRINTFORMDW %CALLNAME:102%은(는) 당신이 바닥에 쓰러져 있는 것을 발견한다.
				PRINTFORML 「괜찮아, 자기야...」
				PRINTFORMW 「방으로 돌아가면 바꿔 줄 수 있어...」
				TRYCALLF PANTY_REWORK_CHANGE(MASTER,103)
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが寝るために自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た（【TARGET】が部屋に戻ってきた→寝間着へと着替え、寝床に潜った）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出して寝た（眠そうな【TARGET】に追い出された…）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF CFLAG:前ターン位置 == CFLAG:現在位置
				;前のターンまで一緒に部屋にいた
				PRINTFORMW 
			ELSE
				;寝るために部屋に帰ってきたところ
				PRINTFORMW 
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た（【TARGET】が部屋に戻ってきた→唇をとがらせる【TARGET】に、【MASTER】は渋々【Ｈの相手】から離れた）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;来訪キャラが拠点で休憩（～は疲れ切っている→ちょっと休んでいきなよ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝室に居る状態でその場で寝る（～は眠気に負け、眠りについた…）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF CFLAG:うふふ
			;うふふ中に寝る
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;The player runs into the character on while on their way to somewhere else ("When going through LOCATION, you come across CHARACTER")
;移動時すれちがい
;==================================================

@M_KOJO_EVENT_K102_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;Stop
	;After this, display encounter text
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:3
			PRINTFORML 「Ah, %CALLNAME:MASTER%!」
			PRINTFORML 「내 작은 것 잘 지내니? 필요한 거 있어?」
			PRINTFORMDW 너를 보고 기쁜 %CALLNAME:102%가 열렬하게 손짓하며 부른다.
		ELSEIF TALENT:8
			PRINTFORML 「아, %CALLNAME:MASTER%, 무슨 일이야, 귀요미?」
			PRINTFORMDW 갑자기 멈춘 것을 보고, %CALLNAME:102%는 궁금하다는 듯 당신을 바라보며 희미하게 미소를 지었다.
		ELSEIF TALENT:184 || TALENT:185 || TALENT:4 || TALENT:142
			PRINTFORML 「무슨 일이야, 내 예쁜 아가? 진정시키고 싶으면 내 가슴을 빨고 싶니?」
			PRINTFORMDW %CALLNAME:102%은(는) 당신에게 제안하지만, 당신은 부드럽게 거절한다.
		ELSE
			PRINTFORML 「안녕하세요 %CALLNAME:MASTER%.」
			PRINTFORML 「Do you need something from me?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Greet in passing
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:3
			PRINTFORML 「너는 나의 작은 햇살이야♪」
			PRINTFORMDW 당신은 당신에게 조금 노래를 불러주는 %CALLNAME:102%에게 가볍게 인사한다.
		ELSEIF TALENT:8
			PRINTFORML 「오, 나의 사랑스러운 %CALLNAME:MASTER%.」
			PRINTFORMDW 당신은 %CALLNAME:102%에게 가볍게 인사하고, %HE_SHE(102)%도 그에 화답한다.
		ELSEIF TALENT:184 || TALENT:185 || TALENT:4 || TALENT:142
			PRINTFORML 「%CALLNAME:MASTER%...」
			PRINTFORMDW 당신은 %CALLNAME:102%에게 가볍게 인사하고, 그가 교활하게 눈짓으로 답한다.
		ELSE
			PRINTFORMW 「안녕.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Ignore and keep moving
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%! 아... %HE_SHE(MASTER, 1)%가 없어..」
		ELSEIF TALENT:8
			PRINTFORML 「아, %CALLNAME:MASTER%... 아니야... %HE_SHE(MASTER,1)%이/가 없어...」
			PRINTFORML 「어쩌면 %HE_SHE(MASTER)%가/이 바쁜 걸지도...」
		ELSEIF TALENT:184 || TALENT:185 || TALENT:4 || TALENT:142
			PRINTFORML 「아라, %CALLNAME:MASTER%... 아, 내 아기가 없어. 얼마나 추운 거야.」
			PRINTFORML 「어쩌면 %조사처리(CALLNAME:MASTER,"에게")% 또 다른 파트너가 있는 건지도 모르지.」
		ELSE
			PRINTFORML 「%HIM_HER(MASTER)%에게 신경 쓰지 않는 게 더 나아.」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
