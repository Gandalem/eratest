@M_KOJO_EVENT_K102_9(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		SETCOLOR C_RED
		PRINTFORMW 「갑작스러운 움직임은 안 돼!」
		PRINTFORMDW 당신은 갑자기 멈춰서 %CALLNAME:102%에게 붙잡힌다.
		PRINTFORMDW %HIM_HER(102)%의 움직임에 분명 위축되어, 당신은 순응한다. 
		CALL M_KOJO_COLOR_K102
		PRINTFORML 「금방 끝날 테니 가만히 있어, 저항하지 마.」
		PRINTFORMDW %CALLNAME:102%가 당신을 수색하기 시작하며 당신이 숨긴 것을 발견한다...	
		SELECTCASE K102_PantiesCaught
			CASE IS >= 3
				SETCOLOR C_RED
				CALL KEYTYPING(@"「땅에 엎드려!」", "L", 100)
				CALL KEYTYPING(@"「당신은 체포되었습니다!」", "W", 100)
				CALL M_KOJO_COLOR_K102
				CALL ASK_YN("저항하다","항복")
				SELECTCASE RESULT
					CASE 0
						PRINTFORMDL 너는 도망치려 한다.
						SETCOLOR C_RED
						PRINTFORML 「저항하지 마라!」
						PRINTFORMW 「ＳＴＯＰ　ＲＥＳＩＳＴＩＮＧ！！」
						PRINTFORMDL 당신이 달릴 때, %CALLNAME:102%은 날개를 돋우고 극도로 빠른 속도로 비행하기 시작한다.
						PRINTFORMDL %CALLNAME:102%을 따라잡지 못해, 당신은 벽에 몰려 빠져나갈 방법을 찾지 못하게 된다.
						PRINTFORMDW 되돌아싸우는 것만이 유일한 선택지로 남는다. 
						PRINTFORMW 「너 정말 망쳤어!」
						RESETCOLOR
						CALL KNIFE_FIGHT(102,MASTER,1,1)
						RETURN 1
					CASE 1
						PRINTFORMDW 당신은 두 손을 들고 %CALLNAME:102%에게 항복한다.
						PRINTFORMDW %CALLNAME:102%는 당신의 양손을 뒤로 보내 수갑으로 묶는다.
						K102_PantiesCaught ++
						$Miranda
						CALL M_KOJO_COLOR_K102
						PRINTFORMW 「당신은 사소 절도 {K102_PantiesCaught} 회로 체포되었다.」
						PRINTFORML
						PRINTFORML 「당신은 침묵할 권리가 있습니다.」
						PRINTFORML 「당신이 하는 모든 말은 법정에서 당신에게 불리하게 사용될 수 있습니다.」
						PRINTFORML 「우리가 질문하기 전에 변호사와 상담할 권리가 있습니다.」
						PRINTFORML 「질문하는 동안 변호사를 대동할 권리가 있습니다.」
						PRINTFORML 「변호사를 선임할 여유가 없다면, 원하실 경우 어떤 질문이 있기 전에 변호사가 배정될 것입니다.」
						PRINTFORML 「지금 변호사 없이 질문에 답하기로 결정한다면, 언제든지 답변을 중단할 권리가 있습니다.」
						PRINTFORML
						PRINTFORMW 「이해했나?」
						CALL ASK_YN()
						SELECTCASE RESULT
							CASE 0
								RESETCOLOR
								CALL PrisonSentence(MASTER,15*K102_PantiesCaught)
								RETURN 1
							CASE 1
								GOTO Miranda
						ENDSELECT
				ENDSELECT
			CASE 2
				PRINTFORML 「네 팬티는 이제 그만해라.」
				PRINTFORMW 「난 네 페티시보다는 네가 왜 그렇게 바보여서 팬티를 훔치다가 같은 여자에게 세 번이나 들리는지에 더 흥미롭군.」
				PRINTFORMDW %CALLNAME:102%에게 그게 페티시가 아니라 삶의 의지라고 말한다.
				CALL KEYTYPING(@"「ＴＨＲＥＥ　ＴＩＭＥＳ！！」", "L", 300)
				PRINTFORMW 「네가 영원히 바보이거나, 엄청나게 불운하거나, 아니면 내가 네 팬티를 다시 발견했을 때 어떻게 반응할지 보러 온 거겠지.」  
				PRINTFORMW 「그리고 나는 네 개소리를 믿지 않아, 넌 여전히 남의 것을 훔치고 있잖아.」
				PRINTFORMW 「이번 사건은 보고될 거야.」
				PRINTFORML 「마지막 경고야.」
				PRINTFORMW 「예외는 없어.」
			CASE 1
				PRINTFORML 「...또?」
				PRINTFORMW 「팬티 더 원해?」
				PRINTFORML 「너는 팬티에 무슨 집착이야?」
				PRINTFORMDW 그녀에게 네가 느끼는 팬티에 대한 매력을 다시 이야기하고 싶지 않다.
				PRINTFORML 「증거 보관소에 맡겨야겠어, 규정상 그래야 해.」
				PRINTFORML 「두 번째 경고다.」
				PRINTFORMW 「네게서 팬티를 한 번 더 발견하면, 마카이의 법률 시스템과 아주 멋진 경험을 하게 될 거다.」	
			CASE 0
				PRINTFORML 「...팬티라고?」
				PRINTFORMW 「어째서 팬티를 가지고 있는 거지...」
				PRINTFORMDW 당신은 그녀에게 팬티가 당신의 모든 희망과 꿈을 담고 있다고 신봉하며 말한다.
				PRINTFORML 「만약 네가 팬티에 그렇게 관심이 있다면 내가 직접 만들어 줄 수도 있어.」
				PRINTFORMDW 당신은 아무도 입지 않은 팬티는 그저 천 조각일 뿐이라고 그녀에게 말한다.
				PRINTFORMDL %CALLNAME:102%는 당신의 대답에 납득하지 못하고 노려본다.
				PRINTFORMW 「그건 여전히 절도야. 사소한 도둑질이지만, 내가 너와 팬티를 가진 것을 발견할 때마다 감옥에서 15일씩 복역하게 될 거야.」
				PRINTFORML 「이 팬티는 증거로 연방에 넘길 생각이야.」
				PRINTFORML 「첫 번째 경고야.」
				PRINTFORMW 「두 번 더 그러면 감옥행이다.」
		ENDSELECT
		K102_PantiesCaught ++
		RETURN 1
	ENDIF
	PRINTFORML  
ENDIF
RETURN 1
