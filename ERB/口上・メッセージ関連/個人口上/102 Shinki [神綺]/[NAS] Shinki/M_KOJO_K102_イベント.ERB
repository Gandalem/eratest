	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「음... 고마워?」
		PRINTFORML 「아직 너 좋아하지는 않지만, 다시 같이 어울릴 수는 있는 것 같아...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
