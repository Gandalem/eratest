@M_KOJO_EVENT_K102_22(ARG,ARG:1)
;口上主はARG
;ARG:0に自慰状況
;ARG:1に自慰種類
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;通常自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		$MasturbStart
		IF TALENT:102:20
			PRINTFORML 「이렇게 죄악스러운 짓이라니, 하지만 나에게 다른 선택지가 없어...」
		ELSE
			PRINTFORML 「나는 내 몸속에서 다시 분출할 수밖에 없다.」
		ENDIF
		PRINTL
		IF VINUM_OMOGATARI_FEATURE_CHECK("omutsu") && (PeeHold:102:2 <= -2 || PooHold:102:2 <= -2)
			PRINTFORMDL %HE_SHE(102)%이 오르가즘 중 통제 불가능한 배변 사고를 일으킨다는 것을 알고, %CALLNAME:102%는 %HIMSELF_HERSELF(102)%에게 기저귀를 채우기 시작한다.
			PRINTFORMW 「이제 제대로 패딩을 했으니, 시작하자.」
			PRINTFORMDL 침대에 누워, %CALLNAME:102%는 한 손으로 %HIS_HER(102)%의 치마를 천천히 들어 올리는 동안 %HE_SHE(102)%이 %HIS_HER(102)%의 패딩 아래에 팔을 넣고 %HIS_HER(102)%의 %PRINT_CLIT(102)% 위에 놓는다.
		ELSE
			PRINTFORMDL 침대에 누워, %CALLNAME:102%은 한 손으로 %HIS_HER(102)%의 치마를 천천히 들어 올리고 다른 한 손으로는 %HIS_HER(102)%의 팬티를 움직인다. 
			PRINTFORMDW %CAPITALIZE(FSYN("vagina"))%노출된 상태에서, %CALLNAME:102%의 손이 %HIS_HER(102)+" "+PRINT_CLIT(102)% 위를 자동으로 움직인다
		ENDIF
		SIF ARG == 7
			GOTO MasturbGaman
		PRINTFORML 「그냥... 하나를 비비게 될 것 같아...」
		PRINTFORMDW %CALLNAME:102%은/는 참을 수 없는 %HIS_HER(102)%의 신음과 함께 열정적으로 그것을 문지르기 시작한다.			
		PRINTFORMDW %CALLNAME:102%의 손가락에서 오는 쾌감은 %HIS_HER(102)%의 민감한 몸에 의해 증폭되고, %HIS_HER(102)%의 움직임은 더욱 거칠어진다.
		CALL HPH_PRINT,@"「하아, 아, 아... 나... 사정해... 흐읍」","L"
		PRINTFORMDW %CALLNAME:102%은(는) %HE_SHE(102)%가 즐거운 신음을 지르며 격렬하게 절정에 이른다.
		PRINTL
		;diapered
		IF VINUM_OMOGATARI_FEATURE_CHECK("omutsu")
			IF PeeHold:102:2 <= -2 && PooHold:102:2 <= -2
				PRINTFORMDW 대변 한 덩이가 %CALLNAME:102%의 패드 안으로 배출되면서, 동시에 %HIS_HER(102)%의 기저귀를 %FSYN("pee:n")%의 물줄기로 가득 채운다...
				CALL HPH_PRINT,@"「하아아... 아아아.... 하프 나는 정말 애 같아 하프」","L"
				CALL HPH_PRINT,@"「혼자만의 시간을 위해 기저귀가 필요해」","L"
				CALL HPH_PRINT,@"「너무 작게 느껴져... 흐으읍흐읍」","L"
			ELSEIF PooHold:102:2 <= -2
				PRINTFORMDW %CALLNAME:102%이 %HIS_HER(102)%의 장을 통제하지 못하고 실수로 %HIS_HER(102)%의 기저귀를 더럽혔다...
				CALL HPH_PRINT,@"「음... 하아... 아... 내 기저귀... 휴우」","L"
				CALL HPH_PRINT,@"「너무... HPH가 가득해... HPH」","L"
			ELSEIF PeeHold:102:2 <= -2
				PRINTFORMDW %CALLNAME:102%은 %HIS_HER(102)%의 방광을 제어하지 못하고, %HIS_HER(102)%의 기저귀를 적시기 시작했다...
				CALL HPH_PRINT,@"「음... 하아... 아... 나 또 해버렸네...」","L"
				CALL HPH_PRINT,@"「나 기저귀 갈아야 해 HPH」","L"
			ENDIF
		ELSE
			;not padded
			IF PeeHold:102:2 <= -2 && PooHold:102:2 <= -2
				;urine and bowel
				PRINTFORMDW 한 개의 대변이 %CALLNAME:102%의 항문에서 배출되면서, 동시에 %HIS_HER(102)%의 침대를 %FSYN("pee:n")%의 줄기로 채운다...
				CALL HPH_PRINT,@"「하아... 으음... 또, 아-사고 HP」","L"
				CALL HPH_PRINT,@"「내 오줌이랑 똥... 사방에 있어 HPH」","L"
				CALL HPH_PRINT,@"「나는 %CALLNAME:103%에게 이걸 보여줄 수 없어... 하프」","L"
			ELSEIF PooHold:102:2 <= -2
				;poop accident
				PRINTFORMDW %CALLNAME:102%는 %HIS_HER(102)%의 장을 제어하지 못하고 실수로 %HIS_HER(102)% 침대에 대변을 본다...
				CALL HPH_PRINT,@"「음... 하아... 아... 너무 역겨워... 흐읍」","L"
				CALL HPH_PRINT,@"「나 변했어... 또 HPH야... HPH」","L"
			ELSEIF PeeHold:102:2 <= -2
				;pee accident
				PRINTFORMDW %CALLNAME:102%은 %HIS_HER(102)%의 자제력을 잃고, %HIS_HER(102)%의 침대를 적시기 시작했다.
				CALL HPH_PRINT,@"「음... 하아... 아... 나 또 해버렸네...」","L"
				CALL HPH_PRINT,@"「나의 소변... 온통이야 HPH」","L"
			ELSE
				;normie
				CALL HPH_PRINT,@"「음... 이제 끝났네, HPH.」","L"
			ENDIF
		ENDIF
		WAIT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同室時自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;中だし精液自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無知持ち（自慰経験(調教自慰経験は差し引き)による分岐あり
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		LOCAL:2 = EXP:自慰経験 - EXP:調教自慰経験
		;無知消去イベントあり（表示は一度だけ
		IF LOCAL:1 >= 25
			;地の文分岐。書きたい場合は[SKIPSTART][SKIPEND]を削除してください
		ELSE
		ENDIF
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質あり自慰中毒高め
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;-------------------------------------------------
		;Ｃ敏感orＣ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;Ｖ敏感orＶ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;Ａ敏感orＡ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;Ｂ敏感orＢ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 4
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部位指定無し
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 5
			PRINTFORML  
			RETURN 1
		ENDIF
		;その他
		;上の分岐を一切書かずに、ここに書くことで陥落素質あり自慰中毒高め自慰の共通口上を表示することが出来ます
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;自慰中毒高め
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;-------------------------------------------------
		;尻穴膣腔同時
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;膣腔のみ
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML  
			RETURN 1
		ENDIF
		;その他
		;上の分岐を一切書かずに、ここに書くことで自慰中毒高め自慰の共通口上を表示することが出来ます
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;我慢
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		GOTO MasturbStart
		$MasturbGaman
		PRINTFORM 그냥 ~할 것 같은 기분이야... 
		SETCOLOR C_RED
		PRINTFORML 안 돼, 안 돼, 안 돼.
		PRINTFORMW 「나는 내 욕망이 그렇게 나를 지배하게 두지 않을 거야.」
		PRINTFORMW 「난 가져야 해...」
		PRINTL
		PRINTFORMW 「ＣＯＮＴＲＯＬ.」
		IF TALENT:102:20
			PRINTFORML 「나에게 자위하는 것은 너무나 죄스러운 일이다. 나는 욕망이 나를 이기도록 내버려 둘 수 없다.」
		ELSE
			PRINTFORML 「적어도 오늘은 욕망을 사로잡으러 갈 수 있다.」
		ENDIF
		IF VINUM_OMOGATARI_FEATURE_CHECK("omutsu") && (PeeHold:102:2 <= -2 || PooHold:102:2 <= -2)
			PRINTFORML 「왜 내가 기저귀를 차고 있는 거지?」
			PRINTFORMW 「나는 거대한 %PRINT_MALE("boy",102)%이야. 기저귀 같은 거 필요 없어!」
			PRINTFORMDW %HIS_HER(102)%의 기저귀 테이프를 풀자, %CALLNAME:102%는 참을 수 없는 욕망을 확인하지 못한 채 %HIS_HER(102)%와 함께 잠이 들었다.
			CALLF Panty_Rework_Change(102,0)
		ELSE
			PRINTFORMDW %CALLNAME:102%은(는) %HIS_HER(102)%의 팬티를 다시 정돈하고, 참을 수 없는 욕정을 제어하지 못한 채 잠자리에 들었다.
		ENDIF
		RETURN 1
	ENDIF
	;その他
	;上の分岐を一切書かずに、ここに書くことで自慰の共通口上を表示することが出来ます
	PRINTFORML  
	RETURN 1
ENDIF
RETURN 1
