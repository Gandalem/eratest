@M_KOJO_EVENT_K102_シナリオ_200000(第m選択肢)
#DIM 第m選択肢
SELECTCASE 第m選択肢
	;----------------------------------------------------------------------------
	;通常ルート「第1章　はじめまして」			イベントID:0
	;第1章第1選択肢(初対面時イベント)
	;			A選択肢	粗茶ですが				イベントID:1
	;			B選択肢	初接触					イベントID:2
	;----------------------------------------------------------------------------
	CASE 0
	CASE 1
		CALL SET_KOJO_COLOR(102)
		FONTSTYLE 1
		PRINTFORMW -제2장.0A 「%K102_ChapterNames(200001)%」-
		PRINTL 
		FONTREGULAR
		SKIPDISP 1
		RESETCOLOR
		BASE:MASTER:4 += 1500
		CALL BEDWETTING(1,0,0,2)
		SKIPDISP 0
		CALL PRINT_GP("W", @"눈을 뜨고 의식을 되찾자, 강한 소변 냄새가 코를 찔렀다.")
		CALL PRINT_GP("W", @"역한 냄새가 나지만 신선한 소변 냄새도 난다. 무슨 일이 일어났는지 확신할 수 없다.")
		LOCALS '= @"당신이 %PeeProtectType(MASTER,2)%에 손을 대자 그것이 "
		IF IsPadded(MASTER) && DiapeCharges:MASTER:0 > 0
			LOCALS += @"매우 따뜻하고 부어 있으며 당신의 %URINE(MASTER)%로 가득 차 있다."
		ELSEIF IsPadded(MASTER)
			LOCALS += @"너무 흠뻑 젖어서 당신의 %PeeProtectType(MASTER,2)%를 뚫고 소변을 봤고 침대를 적셨다."
		ELSE
			LOCALS += @"따뜻하고 축축하며 이상할 정도로 기분 좋은 느낌이다. 당신의 시트도 똑같은 운명을 맞이했다."
		ENDIF
		CALL PRINT_GP("W", LOCALS)
		CALL PRINT_GP("W", @"뭔가... 잘못됐다.")
		PRINTL
		IF IsPadded(MASTER) && DiapeCharges:MASTER:0 > 0
			CALL PRINT_GP("W", @"당신은 보통 밤에 이렇게 많이 소변을 보지 않는데, %PeeProtectType(MASTER,3)%를 이 정도로 적시네.")
			CALL PRINT_GP("W", @"터져서 온 사방에 새어 나올 것만 같다.")
		ELSEIF IsPadded(MASTER)
			CALL PRINT_GP("W", @"당신은 보통 밤에 이렇게 많이 소변을 보지 않는데, %PeeProtectType(MASTER,3)%를 이 정도로 적시네.")
			CALL PRINT_GP("W", @"그리고 그것이 끔찍하게 새어 나올 정도는 결코 충분하지 않았다.")
		ELSEIF Qol_Info_Count_Array:MASTER:Qol_Count_BedWetting > 1
			CALL PRINT_GP("W", @"물론, 당신도 적당히 젖은 침대는 있었지만 이번 것은 달랐다.")
			CALL PRINT_GP("W", @"당신은 평소에 잠에서 깨서 화장실을 가지만, 오늘은 그것을 모르고 푹 잤다.")
		ELSE
			CALL PRINT_GP("W", @"이것은 당신이 한동안 침대에서 소변을 본 첫 번째 일이었다.")
			CALL PRINT_GP("W", @"잠들기 전에 화장실에 갔음에도 불구하고, 침대는 결국 젖어 있었다.")
		ENDIF
		PRINTL
		CALL PRINT_GP("W", @"당신은 소변을 적신 옷을 입은 채 침대에서 일어난다. 무엇을 해야 할지 고민한다.")
		CALL PRINT_GP("W", @"또 그런 일이 생길 경우를 대비해서 야뇨증 매트(bedwetter mat)%COND_STR(" or some thick diapers",nOmutsu)%를 구하는 게 좋을지도 모른다.")
		SIF CFLAG:72:18
			CALL PRINT_GP("W", @"어쩌면 당신의 몸에 무슨 일이 일어나고 있는지 보러 %nameArray:72:na_LastName%를 방문해 볼 수 있을 것이다.")
		CALL PRINT_GP("W", @"아니면 %CALLNAME:102%, %HE_SHE(102,1)%가 당신에게 무슨 일이 일어나고 있는지에 대한 단서를 가지고 있을지도 모른다.")
		CFLAG:102:3100 += 1
		RETURN
		;-----------------------------------------------------------------------
		;通常ルート「第1章　はじめまして」			イベントNo.0
		;第2選択肢(好感度100以上で会話)
		;			A選択肢	守矢の風祝				イベントNo.3
		;			B選択肢	信じても鰯は鰯			イベントNo.4
		;-----------------------------------------------------------------------
	CASE 2
		CALL SET_KOJO_COLOR(102)
		FONTSTYLE 1
		PRINTFORMW -제2장 2.0.1A「%K102_ChapterNames(201001)%」-
		PRINTL 
		FONTREGULAR
		RESETCOLOR
		CALL PRINT_GP("W", @"방광에서 예상치 못한 따끔거림이 발생해 화장실로 달려가며 손으로 당신의 %PeeProtectType(MASTER,2)%를 급히 감싸게 된다.")
		CALL PRINT_GP("W", @"매우 가득 차서, %URINE(MASTER)%로 넘치고 있으며, 상당히 아프기 시작한다.")
		CALL PRINT_GP("W", @"당신은 몰래 화장실을 찾으려고 참아보려 하지만, 장소를 찾으려는 순간, 당신의 %URINE(MASTER)%이 당신의 %PeeProtectType(MASTER,1)%로 분출되는 것을 느낀다.")
		CALL PRINT_GP("W", @"더 이상 새지 않게 하려고 노력하지만 방금 안도감을 느꼈기 때문에 듣고 싶어 하지 않는다.")
		PRINTL
		LOCALS '= @"%URINE(MASTER)%의 홍수가 당신의 방광에서 전력으로 비워지기 시작한다. "
		IF IsPadded(MASTER)
			LOCALS += @"부풀어 오르는 당신의 %PeeProtectType(MASTER,2)% 안에서 고이고 쉬는 소리가 들린다."
		ELSE
			LOCALS += @"당신의 바닥에 %URINE(MASTER)%로 소변 접시를 만들면서 옷을 적신다."
		ENDIF
		CALL PRINT_GP("W", LOCALS)
		SKIPDISP 1
		CALLF Peeme(MASTER)
		BASE:MASTER:4 += 1500
		CALL OMORASHI_END(MASTER,1)
		SKIPDISP 0
		IF DiapeCharges:MASTER:0 > 0
			CALL PRINT_GP("W", @"당신의 %PeeProtectType(MASTER,3)%는 흠뻑 젖었고 사고를 많이 흡수했다.")
			CALL PRINT_GP("W", @"이제 눈에 띄게 부어 있고, 새기 전에 변화가 절실해 보인다.")
		ELSEIF IsPadded(MASTER)
			CALL PRINT_GP("W", @"당신의 %PeeProtectType(MASTER,3)%은 사고를 최대한 흡수했지만, 충분하지 않았다.")
			CALL PRINT_GP("W", @"바닥에 %URINE(MASTER)%의 웅덩이가 생기고, 당신의 옷은 신선한 %URINE(MASTER)%로 더러워진다.")
		ELSE
			CALL PRINT_GP("W", @"당신은 바닥을 심하게 적시고 옷에는 약간의 노란 얼룩이 생겼다.")
		ENDIF
		PRINTL
		CALL PRINT_GP("W", @"당신은 자신의 몸에 무슨 일이 일어나고 있는지 답답하고 혼란스럽다.")
		CALL PRINT_GP("W", @"왜 그걸 참지 못했어? 너는 충분히 스스로를 붙잡을 수 있었잖아.")
		CALL PRINT_GP("W", @"우선 네가 무작위로 침을 적셨고, 이제 낮에도 방광 경련이 일어난다.")
		CALL PRINT_GP("W", @"방광에 분명 문제가 생겨서 이런 사고를 치게 된 것이다.")
		IF IsPadded(MASTER)
			CALL PRINT_GP("W", @"아마 더 두꺼운 라이너인 %COND_STR(" or diaper",nOmutsu)%을 사용하는 것이 좋은 생각이 될지도 모른다.")
		ELSE
			CALL PRINT_GP("W", @"네 팬티에 라이너 %COND_STR(" or wearing a diaper",nOmutsu)%을 넣는 게 좋은 생각일지도 모른다.")
		ENDIF
		SIF CFLAG:72:18
			CALL PRINT_GP("W", @"어쩌면 %nameArray:72:na_LastName%가 당신에게 무슨 일이 일어나고 있는지 알고 그것을 고칠 수 있을지도 모른다.")
		CFLAG:102:3100 += 100
		RETURN
	CASE 3
		;WIP WIP WIP
		CALL SET_KOJO_COLOR(102)
		FONTSTYLE 1
		PRINTFORMW -제2장 2.0.2A 「%K102_ChapterNames(201002)%」-
		PRINTL 
		FONTREGULAR
		RESETCOLOR
		CALL PRINT_GP("W", @"배에서 예상치 못한 포만감이 당신의 복부 전체에 날카로운 통증을 일으킨다.")
		CALL PRINT_GP("W", @"갑작스러운 고통을 예상하지 못하고, 당신은 무의식적으로 엉덩이를 낮추고 크고 물컹하며 지저분한 것을 %PeeProtectType(MASTER,1)%안으로 내보냈다.")
		LOCALS '= @"슬러지가 그것으로 길을 찾는다 "
		IF IsPadded(MASTER)
			LOCALS += @"당신의 %PeeProtectType(MASTER,2)% 안쪽의 편안한 패딩이 당신의 오줌으로 불룩하게 튀어나와 있다."
		ELSE
			LOCALS += @"너의 속옷이 네 지독한 놀라움을 위해 늘어나고 있다."
		ENDIF
		IF CAN_ACCIDENT(MASTER,1)
			CALL PRINT_GP("W", @"아직도 황홀경 속에 있는 채로 안도의 한숨을 내쉰다%COND_STR(@" as you begin peeing your %PeeProtectType(MASTER,2)%",CAN_ACCIDENT(MASTER,1))%.")
			LOCALS '= @"%URINE(MASTER)%의 홍수가 당신의 방광에서 전력으로 비워지기 시작한다. "
			IF IsPadded(MASTER)
				LOCALS += @"부풀어 오르는 당신의 %PeeProtectType(MASTER,2)% 안에서 고이고 쉬는 소리가 들린다."
			ELSE
				LOCALS += @"당신의 바닥에 %URINE(MASTER)%로 소변 접시를 만들면서 옷을 적신다."
			ENDIF
		ENDIF
		CALL PRINT_GP("W", @"이미 당신의 %PeeProtectType(MASTER,1)%에 상당한 양의 %PeeAndPoo(CAN_ACCIDENT(MASTER,1),CAN_ACCIDENT(MASTER,2),"pee","poop")%를 넣었으니 멈출 이유가 없다.")
		PRINTL
		CALL PRINT_GP("W", LOCALS)
		SKIPDISP 1
		CALLF Peeme(MASTER)
		CALLF Poome(MASTER)
		BASE:MASTER:4 += 1500
		BASE:MASTER:17 += 1500
		CALL OMORASHI_END(MASTER,CAN_ACCIDENT(MASTER,1),CAN_ACCIDENT(MASTER,2))
		SKIPDISP 0
		CALL PRINT_GP("W", @"당신의 사고에서 나는 냄새가 의식을 되찾게 하고, 그러고 나서 당신이 저지른 피해를 보고 느끼게 된다.")
		IF IsPadded(MASTER)
			IF DiapeCharges:MASTER:0 > 0 && DiapePooCharges:MASTER:0 > 0
				CALL PRINT_GP("W", @"당신의 %PeeProtectType(MASTER,3)%은(는) %PeeAndPoo(CAN_ACCIDENT(MASTER,1),CAN_ACCIDENT(MASTER,2) && GETBIT(nScat,5),"drenched","packed")% 상태이며 당신의 사고들을 매우 많이 막아주었다.")
				CALL PRINT_GP("W", @"지금은 %PeeProtectType(MASTER,2)%에서 무슨 일이 일어났는지 매우 명백하게 보이고 냄새가 난다.")
			ELSE
				$C3DiaperCompleteFailure
				IF CAN_ACCIDENT(MASTER,1)
					SIF DiapeCharges:MASTER:0 <= 0 && DiapePooCharges:MASTER:0 <= 0
						CALL PRINT_GP("W", @"당신의 %PeeProtectType(MASTER,3)%는 완전히 재앙이다. 당신이 %PeeAndPoo(CAN_ACCIDENT(MASTER,1),CAN_ACCIDENT(MASTER,2) && GETBIT(nScat,5),"pee","poop")%를 참지 못한다.")
					IF DiapeCharges:MASTER:0 <= 0
						CALL PRINT_GP("W", @"바닥에 %URINE(MASTER)%의 웅덩이가 생기고, 당신의 옷은 신선한 %URINE(MASTER)%로 더러워진다.")
					ELSE
						CALL PRINT_GP("W", @"당신의 %PeeProtectType(MASTER,3)%는 흠뻑 젖고 부어 있으며, 새로운 오줌으로 가득하다.")
					ENDIF
				ENDIF
				IF CAN_ACCIDENT(MASTER,2)
					IF DiapePooCharges:MASTER:0 <= 0
						IF GETBIT(nScat,5)
							CALL PRINT_GP("W", @"네가 저지른 지저분함을 담을 공간이 부족해져서, 이제 앞쪽과 뒤쪽, 그리고 옆에 모두 변기가 있다.")
						ELSE
							CALL PRINT_GP("W", @"당신의 지저분한 것으로 가득 차서 더 이상 담을 공간이 없는 것 같지만, 여전히 그것은 담아낼 수 있다.")
						ENDIF
					ELSE
						CALL PRINT_GP("W", @"당신의 %PeeProtectType(MASTER,3)%는 방금 대변을 참아 매우 가득 차고 축축해졌다.")
					ENDIF
				ENDIF
			ENDIF
		ELSE
			SIF CAN_ACCIDENT(MASTER,1)
				CALL PRINT_GP("W", @"당신은 바닥을 심하게 적시고 옷에는 약간의 노란 얼룩이 생겼다.")
			IF CAN_ACCIDENT(MASTER,2)
				IF GETBIT(nScat,5)
					CALL PRINT_GP("W", @"당신의 팬티는 이제 갈색 얼룩으로 더러워졌고, 밖으로 불룩하게 튀어나와 변 조각들을 떨어뜨리고 있다.")
				ELSE
					CALL PRINT_GP("W", @"당신의 팬티는 이제 갈색 얼룩으로 더러워져 있고, 움직이면 터질 듯이 밖으로 불룩하게 튀어나와 있다.")
				ENDIF
			ENDIF
		ENDIF
		PRINTL
		CALL PRINT_GP("W", @"우선은 잠자리에서 소변을 참는 것에 대해 통제력을 잃었다.")
		CALL PRINT_GP("W", @"둘째로, 깨어 있을 때 소변을 참는 것에 대해 통제력을 잃었다.")
		CALL PRINT_GP("W", @"그리고 이제, 당신은 양쪽 모두에서 통제력을 잃었다... 너무 늦을 때까지 그것을 알지 못한 채로.")
		CALL PRINT_GP("W", @"당신의 방광과 장에 분명 뭔가 문제가 있고, 그것이 이런 사고를 치게 만들고 있다.")
		CALL PRINT_GP("W", @"변기까지 갈 수 있을지 자기 자신조차 믿을 수가 없구나...")
		PRINTL
		CALL PRINT_GP("W", @"이 상황에서 정말 필요한 것은 기저귀다.")
		SIF CFLAG:72:18
			CALL PRINT_GP("W", @"%nameArray:72:na_LastName%는 이 시점에 그것을 고치지 못할지도 모른다.")
		CFLAG:102:3100 += 100
		RETURN
	CASE 8000
		;-----------------------------------------------------------------------
		;通常ルート「第1章　はじめまして」			イベントNo.0
		;第3選択肢(仕事中で会話、あなたがデート中でない)
		;			A選択肢	信者ではないけれど		イベントNo.5
		;			B選択肢	やっぱり鰯				イベントNo.6
		;-----------------------------------------------------------------------
	CASE 3
		PRINTFORMDL [0]-그녀를 돕는다
		PRINTFORMDL [1]-아니에요
		INPUT
		;まあ、大半の人はこっちを選ぶんでしょうねー
		IF !RESULT
			CFLAG:102:3100 += 100
			;いやどす(迫真)
			;こっちだと早苗さんの会話がねぇじゃねーかっ！作者のTUGUNAI案件ですなぁ！これはぁ！
		ELSE
			CFLAG:102:3100 += 200
		ENDIF
		RETURN
		;-----------------------------------------------------------------------------
		;通常ルート「第1章　はじめまして」				イベントNo.0
		;第4選択肢(好感度500信頼度50を満たす+会話)
		;			Aルート	守矢さんちの現人神			イベントNo.10
		;			Bルート	信者獲得大作戦				イベントNo.20
		;-----------------------------------------------------------------------------
	CASE 4
		;勧誘手伝いまでの流れを文章で補完
		CALL COLORMESSAGE("코치야 사나에와의 관계가 『지인』이 되었다.",C_YELLOW,2,1)
		;2章解放　おめでとう！
		A = CFLAG:102:3100 % 10
		B = (CFLAG:102:3100 / 10) % 10
		C = (CFLAG:102:3100 / 100) % 10
		;通常第2章Aルート分岐「守矢さんちの現人神」No.10
		IF A+B+C < 5
			CFLAG:102:3102 = 10
			PRINTL 
			PRINTFORMDW -제2장 「모야사 씨네 현인신」-
			;通常第2章Bルート分岐「信者獲得大作戦」No.20
		ELSE
			CFLAG:102:3102 = 20
			PRINTL 
			PRINTFORMDW -제2장 「신자 확보 대작전」-
		ENDIF
		FONTREGULAR
	CASE 8
		CALL SET_KOJO_COLOR(102)
		FONTSTYLE 1
		PRINTFORMW -제2장 2.0.1A 「%K102_ChapterNames(200001)%」-
		PRINTL 
		FONTREGULAR
		SKIPDISP 1
		RESETCOLOR
	CASEELSE
		PRINTL 오류 (@M_KOJO_EVENT_K102_시나리오_0)
ENDSELECT

