;makai tour
@M_KOJO_IRAI_UNIQUE_101_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	CALL PRINT_GPC("L", @"「Ah, %CALLNAME:MASTER%. You're finally here.」", 102)
	CALL PRINT_GPC("L", @"「You must be unfamiliar with Gensokyo and how it works and where everything is.」", 102)
	CALL PRINT_GPC("W", @"「You might not even know what or where Makai is.」", 102)
	PRINTL
	CALL PRINT_GPC("W", @"「My main ability is creating things from nothing. And when I mean things, I mean anything.」", 102)
	CALL PRINT_GPC("W", @"「Makai is a special realm, isolated from the rest of Gensokyo, created by me.」", 102)
	CALL PRINT_GPC("W", @"「It has hot and cold biomes, as well as one that's completely habitable.」", 102)
	CALL PRINT_GPC("W", @"「And also, this place, it's my home.」", 102)
	CALL PRINT_GPC("W", @"「I made it this way so I could hide, regroup, all safe from the Jesuits, the holy ones who want to kill me.」", 102)
	PRINTL
	CALL PRINT_GPC("W", @"「We can go on a tour so you can see where everything is.」", 102)
	CALL PRINT_GPC("W", @"「I'll even allow you to come back afterwards.」", 102)
	RETURN 1
CASE "依頼非受託時"
	PRINTDATAL
		DATAFORM 「Well... If you want to start the tour, I'm always here.」
	ENDDATA
	RETURN 1
CASE "依頼受託時"
	PRINTFORMW 「Well, hop on over.」
	CALL PRINT_GP("W", @"In a flash, you're teleported from where you are to the entrance of a rather big gated city.")

	CALL SET_DATE(11, 102, 0, 0)
	TFLAG:デート道中 = 0
	CFLAG:MASTER:現在位置 = GET_ENTRANCE(11)
	CFLAG:(102):現在位置 = GET_ENTRANCE(11)
	RETURN 1
CASE "依頼確認時"
	PRINTFORML 「Are you lost? Do you want me to take you back to the city?」
	RETURN 1
CASE "依頼破棄時"
	PRINTFORML 「Reconsidering your choice?」
	PRINTFORML 「Well... If you're willing to go back, I'm always here.」
	RETURN 1
CASE "依頼実行直前"
	RETURN 0
CASE "依頼実行直後"

CASE "Makai City"
	CALL PRINT_GP("L", @"The ground feels unusual, like asphalt but much grippier")
	CALL PRINT_GP("L", @"The skies are dark, tinted with a red hue.")
	CALL PRINT_GP("L", @"Buildings cast bright xenon lighting, brightening the streets while also highlighting the monolithic structures.")
	CALL PRINT_GP("L", @"Cars from various brands such as Chevalier, Dash, Franklin, and Masterson litter the roads, driving on the right.")
	CALL PRINT_GP("L", @"A skyscraper with the sign \"Gensou-chan MakaiTech\" stands out, being the tallest building of the city.")
	CALL PRINT_GP("L", @"The city definitely looks more advanced than the rest of Gensokyo.")
	PRINTL
	CALL PRINT_GPC("W", @"「This is Makai City, the bustling business center of the demon world.」", 102)
	CALL PRINT_GPC("L", @"「A place where strong youkai mingle, shop, and otherwise live their lives.」", 102)
	CALL PRINT_GPC("W", @"「Do you like it? The city's certainly quite busy.」", 102)
	PRINTL
	CALL PRINT_GP("L", @"Before you can respond, a Makai citizen walks over and greets %CALLNAME:102%.")
	CALL PRINT_GPC("L", @"「Hello Mother. I see that you brought a new recruit.」")
	CALL PRINT_GPC("L", @"「Indeed. This %PRINT_MALE("boy",MASTER)% is my latest.」", 102)
	CALL PRINT_GP("L", @"%CALLNAME:102% shakes the citizen's hand in agreement.")
	CALL PRINT_GP("L", @"The citizen walks away, %CALLNAME:102% looking at you with glee.")
	PRINTL
	CALL PRINT_GPC("W", @"「Oh yea, I forgot. Makai Citizens usually call me Mother, for being the creator of this world and the Makai species.」", 102)
	RETURN 1
CASE "World of Ice and Snow"
	CALL PRINT_GP("L", @"As you first step into the area, you notice that it's freezing cold, with the ground and foliage layered in snow.")
	CALL PRINT_GPC("W", @"「Welcome to the World of Ice and Snow.」", 102)
	CALL PRINT_GP("L", @"%CALLNAME:102%'s breath is visible as %HE_SHE(102)% talks.")
	CALL PRINT_GPC("L", @"「This is the intermediary between most areas of Makai.」", 102)
	CALL PRINT_GPC("W", @"「It's in a rather... extreme environment due to the sub-zero temperatures and high snowfall.」", 102)
	PRINTL
	CALL PRINT_GPC("L", @"「It's designed to keep the visitors safe in the city and not wander out into places that they're not supposed to be.」", 102)
	RETURN 1
CASE "Vina (or at least, the ruins of it)"
	CALL PRINT_GP("L", @"You stumble upon a derelict facility, caked in snow as it's been left to time and the elements.")
	CALL PRINT_GP("L", @"Parts of the building are destroyed, crumbled in attacks, causing some snow to gather inside as well.")
	CALL PRINT_GPC("L", @"「I think you might've found one of the abandoned projects in the snow.」", 102)
	CALL PRINT_GPC("L", @"「Lets go inside. I don't want you catching a cold.」", 102)
	CALL PRINT_GP("W", @"%CALLNAME:102% opens the door and leads you inside, before entering the building and closing the door.")
	PRINTL
	CALL PRINT_GPC("W", @"「This is Project Vina. Or at least, the ruins of it.」", 102)
	CALL PRINT_GPC("W", @"「This was meant to be a project to power the city from one building.」", 102)
	CALL PRINT_GPC("W", @"「But as time and research advanced, and decentralized vanometric power became standard, Vina was abandoned as it was no longer needed.」", 102)
	CALL PRINT_GPC("W", @"「Perhaps with your help, you could restore it to its former glory.」", 102)
	CALL PRINT_GPC("W", @"「Maybe turn it into a home or even a town perhaps.」", 102)
	RETURN 1
CASE "Pandemonium"
	CALL PRINT_GP("L", @"You enter a grandiose temple and find yourself impressed by the design.")
	CALL PRINT_GP("L", @"The grand size of the hallway makes the two of you look tiny as the bright lighting highlights you and %CALLNAME:102%.")
	CALL PRINT_GPC("W", @"「And this, is the heart of Makai.」", 102)
	CALL PRINT_GPC("W", @"「This is where negotiations are made, the high-ranking people live, and where I rest.」", 102)
	PRINTL
	CALL PRINT_GP("L", @"%CALLNAME:102% leads you around until %HE_SHE(102)% stops at a statue in the hall.")
	CALL PRINT_GP("L", @"The statue depicts a petite woman wearing traditional shrine maiden clothes holding a purification rod.")
	CALL PRINT_GPC("L", @"「This statue here is of a previous Hakurei shrine maiden, the one wearing purple hair.」", 102)
	CALL PRINT_GPC("L", @"「She was one of the first non-Jesuit Gensokyan residents to enter the demon world.」", 102)
	CALL PRINT_GPC("W", @"「She beat up my people pretty bad, but as we transitioned into the New Era, she was what our military was based off of.」", 102)
	PRINTL
	CALL PRINT_GP("L", @"%CALLNAME:102% leads you to another statue.")
	IF CFLAG:55:面識
		CALL PRINT_GP("L", @"The statue depicts %CALLNAME:55%\@ ABL:MASTER:43 >= UniversalRank("B") ? , the Buddhist %PRINT_MALE("man",55)% sealed in Hokkai years ago # .\@")
	ELSE
		CALL PRINT_GP("L", @"The statue depicts a tall Buddhist woman with long hair wearing a dress.")
	ENDIF
	CALL PRINT_GPC("L", @"「The New Era had us under the radar for many years, until the Buddhists showed up.」", 102)
	CALL PRINT_GPC("L", @"「They came in a ship and fought in Hokkai to grab whatever was in there, however they were unsuccessful.」", 102)
	CALL PRINT_GPC("L", @"「After the commotion, I negotiated with the girl to allow outsiders access to Makai using the ship, and so hence why there's many visitors in the demon world now.」", 102)
	IF ABL:MASTER:43 >= UniversalRank("B")
		{
			CALL ASK_M(
				@"...", 1,
				@"[Knowledge {ABL:MASTER:43}/{UniversalRank("B")}] That's not how it went. She was sealed and they were trying to free her.", 1,
			)
		}
		SELECTCASE RESULT
		CASE 0
			CALL PRINT_GP("L", @"You have a gut feeling that what %HES_SHES(102)% saying makes no sense, but you don't call %HIM_HER(102)% out.")
		CASE 1
			CALL PRINT_GPC("L", @"「Huh? Is that true?」", 102)
			CALL PRINT_GPC("L", @"「I honestly don't really care about what happens in Hokkai, it's pretty much just a combat zone.」", 102)
			CALL PRINT_GPC("L", @"「But I'll keep it since it also ultimately caused the Outsiders to invade.」", 102)
		ENDSELECT
	ENDIF
	RETURN 1
CASE "Hokkai"
	CALL PRINT_GPC("W", @"「Hokkai is where scores are settled in Makai.」", 102)
	CALL PRINT_GPC("W", @"「It is a combat zone filled with abandoned buildings, souls lost to the environment and war, and an infamous red mist.」", 102)
	CALL PRINT_GP("L", @"A red fog begins to glaze over the sky, casting a dark shadow.")
	CALL PRINT_GPC("W", @"「Not really a place where people come to chitchat, huh?」", 102)
	PRINTL
	CALL PRINT_GPC("W", @"「I don't really give Hokkai a lot of attention, hence the state that its in.」", 102)
	CALL PRINT_GPC("W", @"「Really though, I just don't want conflicts breaking out throughout the city.」", 102)
	CALL PRINT_GPC("W", @"「Makes the tourist experience way less enjoyable.」", 102)
CASE "Wonderland"
	CALL PRINT_GPC("W", @"「Ah Wonderland, got me thinking about an American that did a rendition of my daughter.」", 102)
	CALL PRINT_GPC("W", @"「It's a experimental place, meaning that it doesn't have set features.」", 102)
	CALL PRINT_GPC("W", @"「Today it's a lush, sparkly field, but tomorrow it could be a district of the city, or even a volcanic mountain.」", 102)
	CALL PRINT_GPC("W", @"「Whatever sticks becomes a part of Makai, like Hokkai or the ice and snow world.」", 102)
	CALL PRINT_GPC("W", @"「Others are well, better left in my mind.」", 102)
	RETURN 1
CASE "Fallen Temple"
	CALL PRINT_GPC("W", @"「This temple was a truce building built during the wee ending years of the Holy Wars.」", 102)
	CALL PRINT_GPC("W", @"「Here people worshipped JESUIT gods like the aforementioned God and Furesuzu.」", 102)
	IF ABL:MASTER:43 >= UniversalRank("B")
		{
			CALL ASK_M(
				@"...", 1,
				@"[Knowledge {ABL:MASTER:43}/{UniversalRank("B")}] You mean Jesus?", 1,
			)
		}
		SELECTCASE RESULT
		CASE 0
			CALL PRINT_GP("L", @"%HES_SHES(102,1)% misremembering a lot of things, even Jesus' name, but you don't call %HIM_HER(102)% out.")
		CASE 1
			CALL PRINT_GPC("L", @"「Oh. I'm so sorry.」", 102)
			CALL PRINT_GPC("L", @"「Its been hundreds of years since I've interacted with them.」", 102)
			CALL PRINT_GPC("L", @"「Here people worshipped JESUIT gods like the aforementioned God and Jesus.」", 102)
		ENDSELECT
	ENDIF
	PRINTL
	CALL PRINT_GPC("W", @"「However due to hundreds of years of neglect, the temple had fallen into a state of disrepair.」", 102)
	CALL PRINT_GPC("W", @"「Fallen shingles, damaged bricks, rotten doors, and even a broken statue.」", 102)
	CALL PRINT_GPC("W", @"「In the time since creation of the Federation, the temple was converted to a housing place for some.」", 102)
	CALL PRINT_GPC("W", @"「I've even got an angel who got kicked out and nearly killed housed here along with her friend Elis.」", 102)
	CALL PRINT_GPC("W", @"「I've also restored the chapel, but now its more than just a place to worship the JESUIT God.」", 102)
	CALL PRINT_GPC("W", @"「Although I replaced the broken statue with a statue of myself. It was no use broken.」", 102)
	PRINTL
	CALL PRINT_GPC("W", @"「If you need a place to pray, repent your sins, or worship the god you believe in, this is probably a better place than most in Gensokyo」", 102)

CASE "成功報告時"
;報酬：
	CALL PRINT_GPC("W", @"「Well, how was Makai? Was it interesting at least?」", 102)
	{
		CALL ASK_M(
			@"Yeah, it was fun.", 1,
			@"Not really, I've seen more.", 1,
		)
	}
	SELECTCASE RESULT
	CASE 0
	CALL PRINT_GPC("W", @"「Glad that you enjoyed what my world has to offer.」", 102)
	CALL PRINT_GP("L", @"%CALLNAME:102%'s makes a small smile afterwards")
	CASE 1
	CALL PRINT_GPC("W", @"「Well, at least you gave it a chance.」", 102)
	CALL PRINT_GP("L", @"%CALLNAME:102%'s makes a small smile afterwards, though with a slight concern on %HIS_HER(102)% face.")
	ENDSELECT
	PRINTL
	CALL PRINT_GPC("L", @"「As for getting to Makai, head to the ship in the temple.」", 102)
	CALL PRINT_GPC("L", @"「I have an agreement with an interstellar transport company which allows them to transport people like you to here and back.」", 102)
	CALL PRINT_GPC("W", @"「Just be warned, its a bit expensive, and it only covers one way.」", 102)
	PRINTL
	CALL PRINT_GPC("L", @"「I have some other work that I would want you to do later, but for now, lets part ways.」", 102)
	CALL PRINT_GP("W", @"%CALLNAME:102% gives you a kiss in the cheek, before walking off.")
	RETURN 1
CASE "失敗報告時"
	PRINTDATAL
		DATAFORM 「Chickened out?」
	ENDDATA
	RETURN 1
	;IF !RESULT
	;	PRINTFORML
CASE "依頼報告不要"
	
	RETURN 0
ENDSELECT

@PlayerSaysTheMakaiOath
CALL PRINT_GPC("W", @"「Repeat after me.」", 102)
$Oath01
CALL PRINT_GPC("W", @"「I, %NAME:102%, am a member of the Federation;」", 102)
{
	CALL ASK_M(
		@"[Leave] No. I'm not doing your oath.", 1,
		@"I, %NAME:MASTER%, am a member of the Federation;", 1,
		@"I, %NAME:102%, am a member of the Federation;", 1,
	)
}
SELECTCASE RESULT
CASE 0
CASE 1
CASE 2
	CALL PRINT_GPC("W", @"「Silly %CALLNAME:MASTER%, say your name, not mine. Try again.」", 102)
	GOTO Oath01
ENDSELECT

CALL PRINT_GPC("W", @"「I acknowledge that the FEDERATION of MAKAI to be a free, independent, and sovereign state;」", 102)
{
	CALL ASK_M(
		@"[Leave] Actually, on second thought...", 1,
		@"I acknowledge that the FEDERATION of MAKAI to be a free, independent, and sovereign state;", 1,
	)
}

CALL PRINT_GPC("W", @"「And I do swear that I will, to the utmost of my power, support, maintain, and defend the Federation against opposing Gensokyan, Lunarian, and other Outside forces.」", 102)
{
	CALL ASK_M(
		@"[Leave] No. I'm not doing your oath.", 1,
		@"And I do swear that I will, to the utmost of my power, support, maintain, and defend the Federation against opposing Gensokyan, Lunarian, and other Outside forces.;", 1,
	)
}


