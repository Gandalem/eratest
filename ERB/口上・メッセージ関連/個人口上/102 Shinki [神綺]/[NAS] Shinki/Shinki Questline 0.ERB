@M_KOJO_IRAI_UNIQUE_103_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF GETBIT(nUnfair,0)
			PRINTFORMW 「%CALLNAME:MASTER%, 나는 더 많은 오버더월 쿨러를 만들어야 하는데 부품이 다 떨어졌어.」
			PRINTFORMW 「30개를 가져다줄 수 있어? 정말 빨리 필요해. 내 호화로운 식사들이 곧 상할 거야.」
		ELSE
			PRINTFORML 「좋은 하루예요, %CALLNAME:MASTER%.」
			PRINTFORML 「좀 더 실험적인 것들에서 잠시 벗어나서 말이죠. 저는 당신에게 간단한 사냥 퀘스트를 해줬으면 할 뿐이에요.」
			PRINTFORML 「구성품 30개를 무지개 용의 동굴이나 비나에게서 가져와 주세요.」	
			PRINTFORML 「더 많은 기술을 알기 위해 연구할 양이 필요해요.」
			PRINTL
			PRINTFORML 「사용자가 무엇을 좋아하든 이 일은 할 수 있는 임무라고 생각하기 때문에 대체 임무는 없습니다.」
		ENDIF
		PRINTFORML 「다 끝나면 경험치를 얻기 쉬운 빠르고 간단한 방법을 알려주지.」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「음... 만약 부품을 나에게 던져 줄 의향이 있다면, 나는 언제나 여기 있어.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「그럴 거예요? 잘 풀리면 정말 기쁠 것 같아요.」
			DATAFORM 「고마워요. 당신을 믿게 되어 다행이에요.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「작업은 한 번에 30개의 부품을 나에게 가져오는 것을 포함한다.」
		PRINTFORML 「보상으로, 너는 스킬 트레이너의 청사진을 받게 될 것이다.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「네 선택을 재고하고 있나요?」
		PRINTFORML 「음... 돌아갈 의향이 있다면 언제든 여기 있어요.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		SELECTCASE TFLAG:144
			CASE 0
				PRINTFORMDW 당신은 구성품들을 %CALLNAME:102%에게 가져다준다.
				PRINTFORML 「완벽해, 딱 내가 필요했던 거야.」
				PRINTFORMDL %CALLNAME:102%는 구성품들 사이를 뒤지다가 %HIM_HER(102)%의 흥미를 끄는 특이한 것을 발견한다.
				PRINTFORMW 「이게 뭐야? 이걸 몇 년 동안 찾아다녔는데.」
		ENDSELECT
		PRINTL
		PRINTFORMDW 몇 초 만에 %CALLNAME:102%가 이상하게 생긴 주사기를 건넨다.
		PRINTFORMW 「이것은 스킬 트레이너이다.」
		PRINTFORML 「특정 스킬을 훈련시키는 메카나이트의 일회성 과다 투여물이다.」
		PRINTFORML 「그 용량은 눈 주변을 통해 투여된다.」
		PRINTFORMW 「뇌에 방출되면, 메카나이트는 필요에 따라 신경 조직으로 변하면서 대상의 특정 분야 스킬을 빠르게 향상시킨다.」
		PRINTFORML
		PRINTFORMW 「이걸 스스로에게 시도해봐.」
		PRINTFORMDL %CALLNAME:102%가 알려준 대로 스킬 트레이너를 사용하여 눈 중 하나에 올려놓는다.
		PRINTFORMDW 마법이 당신을 통해 흘러들어, 당신은 ... 노출벽의 유입을 얻게 된다?
		JUEL:MASTER:恥情 += 20000
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「겁먹었나?」
			DATAFORM 「또 다른 망설이는 테스터라니. 훌륭해!」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

@M_KOJO_IRAI_UNIQUE_104_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「안녕, 나의 큰 아가야.」
		PRINTFORML 「요실금 칩은 너에게 어떻게 작용하고 있니?」
		IF (GETBIT(nPee,1) || GETBIT(nScat,2))
			SELECTCASE MIN(PeeHold:MASTER:2,PooHold:MASTER:2)
				CASE IS >= 2
					PRINTFORMDW 당신은 %CALLNAME:102%에게 자신이 평균적인 외부인보다 더 배변 훈련이 잘 되어 있다고 말한다.
					PRINTFORML 「너한테는 충분히 효과가 없었니? 어차피 너한테는 상관없을 거라고 생각해」
					PRINTFORMW 「기저귀 훈련을 조금 하는 게 그 고집 센 방광 근육을 약화시키는 데 도움이 될 거야.」
				CASE IS >= 0
					PRINTFORMDW 당신은 %CALLNAME:102%에게 여전히 완전히 배변 훈련이 되어 있다고 말한다.
					PRINTFORML 「"완벽하게 배변 훈련이 되었다"... 그럼 운이 좋았던 거겠지.」
					PRINTFORMW 「기저귀 훈련을 조금 하면 칩이 작동하는 데 도움이 될 거야.」
				CASE -1, -2
					PRINTFORMDW 당신은 %CALLNAME:102%에게 화장실에 문제가 좀 있다고 말한다.
					PRINTFORML 「제 역할은 하는 것 같은데, 완벽하진 않네요.」
					PRINTFORML 「내 작은 %조사처리(CALLNAME:MASTER,"는")% 사고를 친 적이 있나요?」
					GOTO AccidentCheck
				CASE -3, -4
					PRINTFORMDW 당신은 %CALLNAME:102%에게 당신의 배변 훈련이 유아 수준으로 퇴행했다고 말한다.
					PRINTFORML 「완벽해. 자주 실수도 한다는 거지?」
					$AccidentCheck
					IF !Qol_Info_Dates_Array:MASTER:Qol_Dates_Wetting && !Qol_Info_Dates_Array:MASTER:Qol_Dates_Messing
						PRINTFORMDW 그것을 가지고도 사고가 없었다고 말하는군.
						PRINTFORML 「너는 아주 큰 %PRINT_MALE("boy",MASTER)%처럼 행동하는 것 같아.」
						PRINTFORMW 「불행하게도, 네 무사고 기록을 깨야 할 시기인 것 같군...」
					ELSE
						PRINTFORMDL 고개를 끄덕이지 않을 수 없다.
						PRINTFORMDW 그 임플란트가 네가 여러 번 실수하게 만든 데 정말 일조했구나.
						PRINTFORMW 「괜찮아 %CALLNAME:MASTER%, 그건 네가 훈련을 잘하고 있다는 뜻이야.」
					ENDIF
				CASE IS <= -5
					PRINTFORMDW 너는 %CALLNAME:102%에게 네가 완전히 실금하게 만들었다고 말한다.
					PRINTFORML 「아후... 나의 사랑스러운 %조사처리(CALLNAME:MASTER,"는")% 변기에 갈 수 없었던 거니?」
					PRINTFORML 「괜찮아, 결국 더러워지면 내가 기저귀를 갈아줄게.」
			ENDSELECT
			PRINTL
			IF nOmutsu
				PRINTFORML 「네가 그 커다란 기저귀 찬 아기인 걸 좋아하니까, 너에게 딱 맞는 정말 귀여운 기저귀를 주었어.」
				PRINTFORML 「이건 배변 훈련을 하지 않은 사람들이 사용하는 다이-기저귀 중 하나야.」
				PRINTFORMW 「가득 채워봐, 큰 홍수와 더러움이 어떻게 되는지 보고 싶거든.」
			ELSE
				PRINTFORML 「안타깝게도 그 임무는 기저귀 사용에 동의해야 하는데, 당신은 계약서의 그 부분을 서명하지 않았습니다.」
			ENDIF
		ELSE
			PRINTFORMDL 당신은 %CALLNAME:102%에게 대신 돈을 다 지불했다고 말한다.
			PRINTFORML 「아. 네가 그런 종류의 것을 좋아하지 않는 걸 잊었어.」
			PRINTFORML 「원래 임무는 자네가... 상당히 유치한 일들을 하는 거였는데, 당연히 자네 같은 사람은 그럴 타입이 아니겠지.」
			PRINTFORML 「대신, 똑같은 보상을 받을 수 있는 대체 임무를 준비해 두었어」
		ENDIF
		PRINTL
		PRINTFORML 「대안은 평이한 %金額表示(150000)%의 비용을 포함합니다.」
		PRINTFORML 「당신은 어떤 페티시를 가지고 있느냐에 따라 돈, 무기 및 기타 물건들이 담긴 월간 케어 패키지를 받게 됩니다.」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「음... 돈을 던져주거나 보충해 줄 의향이 있다면, 난 언제나 여기 있어.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		IF (GETBIT(nPee,1) || GETBIT(nScat,2)) && nOmutsu
			PRINTFORMW 「아우... 나의 달콤한 %조사처리(CALLNAME:MASTER,"는")% 진짜 작아지고 싶지 않아 %HE_SHE(MASTER)%?」
			PRINTFORMDW 당신은 등을 대고 누운다, %CALLNAME:102%가 아주 부피 큰 기저귀를 집어 들면서.
			PRINTFORMDL %CALLNAME:102%는 당신의 %PeeProtectType(MASTER)%를 벗기고 기저귀를 등 아래에 놓는다.
			PRINTFORMDW 기저귀를 당신의 %FSYN("crotch")% 주위에 감고 테이프를 채우자, %CALLNAME:102%는 아기 분유가 담긴 병을 건네주고 유두를 당신의 입에 갖다 댄다.
			PRINTFORMW 「이 맛있는 간식 먹어, 나의 작은 자기야.」
			PRINTL
			PRINTFORMDL 저항할 수 없어, 당신은 열정적으로 병의 유두를 빨기 시작한다.
			PRINTFORMDL 우유는 달콤하고 부드러우며, 매우 따뜻하지만 어딘가 이상하게 느껴진다...
			PRINTFORMDW 당신은 한 번에 병 전체를 마시지 않을 수 없다.
			PRINTFORMDW 하지만 %CALLNAME:102%이(가) 이제 빈 병을 당신의 입에서 %HIS_HER(102)%의 가방으로 옮기자, 당신의 배가 이상해지기 시작한다...
			PRINTL
			PRINTFORMDL 그것을 특정할 수는 없지만, 당신의 %PeeAndPoo(GETBIT(nPee,1), GETBIT(nScat,2), "bladder", "tummy")%이 빠르게 팽창하는 것을 느낄 수 있다...
			PRINTFORMDW %PARSE("You begin")%더 숨을 쉬기 위해, 배설하고 싶은 갑작스러운 충동이 %PARSE("your")% 눈에 눈물을 고이게 만들고 %PARSE("you try")% 그것을 참도록 만든다...	
			CALLF RINYOUME(MASTER, 600, 10000, 0)
			CALLF GERIME(MASTER, 600,10000,,0)
			CALLF PANTY_REWORK_CHANGE(MASTER,104)
		ELSE
			PRINTFORMDW 「주겠다고? 기회가 될 때 나에게 돈을 넘겨줘.」「그 돈은 이 실험을 해줄 다른 자발적인 테스터를 확보하는 데 사용될 거야.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		IF GETBIT(nPee,1) || GETBIT(nScat,2)
			PRINTFORML 「그 작전은 당신의 배설물로 매우 부피가 큰 기저귀를 채우는 것을 포함할 것이다.」
		ENDIF
		PRINTFORML 「대안은 일정한 %金額表示(175000)%의 비용이 발생한다.」
		PRINTFORML 「당신의 보상으로, 매일 받는 급여 외에 정기적인 월간 보상을 받게 된다.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「네 선택을 재고하고 있나요?」
		PRINTFORML 「음... 돌아갈 의향이 있다면 언제든 여기 있어요.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		SELECTCASE TFLAG:144
			CASE 0
				PRINTFORMDW 당신은 %CALLNAME:102%에게 너무 많이 소변을 봐서 새게 되었다고 말한다.
				SIF SoiledDiaper(MASTER,2)
					PRINTFORMDW 거기에 그것에 대변을 눴다는 것까지 말할 것도 없군...
				PRINTL
				PRINTFORMDW %CALLNAME:102%는 당신의 주장을 확인하기 위해 기저귀를 살짝 확인하며, 그것을 꽉 눌러 매우 물컹한지 찾는다%PeeAndPoo(0, GETBIT(nScat,2), "", " 그리고 지독하게")%.
				PRINTFORMW 「와. 그 아기 분유가 금방 너한테 도달했나 봐. 방광이랑 장을 다 거쳐서 완전히 채웠어.」
				PRINTFORML 「그거 하고 나면 정말 기저귀를 갈아야 할 만하네. 이렇게 심하게 새 줄은 몰랐는데...」
				PRINTFORMW 「뭐, 기저귀라는 게 원래 다 새긴 법인데, 이렇게 대참사 수준으로 새는 건 처음이네.」
				PRINTL
				PRINTFORML 「네가 얼마나 많이 담았는지 보자. 바닥에 누워봐.」
				PRINTFORMDL 너는 우아하게 등에 대고 눕는다. 네 %PeeAndPoo(SoiledDiaper(MASTER,1), SoiledDiaper(MASTER,2), "soggy", "messy")% 기저귀의 내용물이 짓눌리지 않도록 조심하며 몸을 낮춘다.
				PRINTFORMDW %CALLNAME:102%는 그러고 나서 네 부피가 크고 매우 더러워진 기저귀에서 테이프를 떼어내, 패딩에 일어난 일을 %HIS_HER(102)% 자신의 눈앞에 드러낸다.
				PRINTFORML
				PRINTFORMW 「거기 안에 있는 저 모든 걸 봐. %PeeAndPoo(SoiledDiaper(MASTER,1), SoiledDiaper(MASTER,2), "pee", "poop")%」
				IF SoiledDiaper(MASTER,2)
					PRINTFORML 「그 기저귀들로 정말 대참사를 만들었구나, 완전히 넘칠 때까지 채웠어.」
				ELSE
					PRINTFORML 「거기 오줌이 너무 많이 차서 네 소변을 더 흡수할 공간이 없어.」
					PRINTFORML 「그냥 기저귀 주변에 고여 있다가 새어 나올 틈을 기다리고 있었어.」
				ENDIF
				PRINTFORMW 「아마 당신의 %FSYN("crotch")% 주변도 볼링공처럼 느껴졌을 것이다.」
				PRINTFORML 
				PRINTFORMW 「내 작은 기저귀를 새 기저귀로 갈아주자, 완하제가 아직 너에게 강하게 작용하고 있을지도 몰라.」
				PRINTFORMDL %CALLNAME:102%는 더러워진 기저귀를 사라지게 하고 네 사타구니에 아기의 힘을 가한 뒤 새롭고 깨끗한 기저귀를 소환한다.
				PRINTFORMDW 뒷부분 시트를 너의 사타구니에 대고, %CALLNAME:102%는 패드를 너에게 감싸고 테이프를 고정하여 꼭 맞게 만든다.
				PRINTFORML
				PRINTFORMDW 일어설 때, 당신은 자신이 처음에 있던 것과 똑같은 종류의 기저귀라는 것을 알아차릴 수밖에 없다. 
				CALLF PANTY_REWORK_CHANGE(MASTER,104)
		ENDSELECT
		PRINTFORMW 「즐겨라. 나는 네 심장도 인공 대체품으로 교체했고 곧 너에게 관리 패키지를 보내기 시작할 것이다.」	
		PRINTFORML 「심장은 내 아키테크 대체품 중 하나인데, 자연스러운 부위처럼 보이지만 손상시키기가 극도로 어렵고 혈액 순환을 훨씬 더 잘 해준다.」
		PRINTFORMW 「또한 동맥경화나 심장병, 암에도 면역이 된다. 전반적으로 움직임이 조금 더 빨라질 것이다.」
		PRINTL
		PRINTFORMW 「아, 그리고 케어 패키지도 말이야.」
		PRINTFORML 「한 달에 한 번 정도, 상당한 금액의 급여와 총, 기저귀, 그리고 내가 직접 개조한 부품 세트가 들어있는 케어 패키지를 받게 될 거야.」
		PRINTFORML 「계약서의 특정 부분에 동의하지 않으면 목록에 있는 일부 항목을 받지 못할 수도 있다는 점을 명심해둬.」
		PRINTFORML 「주어진 개조 부품 역시 내가 너에게 맡긴 것들뿐이야.」 
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「겁먹었나?」
			DATAFORM 「첫 번째 테스트를 할 만큼 용기가 없었던 건가?」
			DATAFORM 「또 망설이는 테스터라니. 굉장해!」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
;spiked cookies

@M_KOJO_IRAI_UNIQUE_105_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
