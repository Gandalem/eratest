; Modular ERB: 個人口上/102 Shinki [神綺]/[NAS] Shinki/Shinki Questline 0.ERB
;makai tour

@M_KOJO_IRAI_UNIQUE_101_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		CALL PRINT_GPC("L", @"「아, %CALLNAME:MASTER%. 드디어 오셨군요.」", 102)
		CALL PRINT_GPC("L", @"「당신은 환상향과 그것이 어떻게 작동하고 모든 것이 어디에 있는지 모르는 것 같군요.」", 102)
		CALL PRINT_GPC("W", @"「마카이가 무엇인지, 어디에 있는지조차 모를지도 모른다.」", 102)
		PRINTL
		CALL PRINT_GPC("W", @"「나의 주 능력은 무(無)로부터 무언가를 창조하는 것이다. 그리고 내가 말하는 '무언가'란 무엇이든 의미한다.」", 102)
		CALL PRINT_GPC("W", @"「마카이는 나의 창조물이며, 다른 환상의 세계와 격리된 특별한 영역이다.」", 102)
		CALL PRINT_GPC("W", @"「뜨겁고 차가운 생물군계뿐만 아니라 완전히 거주 가능한 곳도 있다.」", 102)
		CALL PRINT_GPC("W", @"「그리고 이곳도 나의 집이다.」", 102)
		CALL PRINT_GPC("W", @"「내가 이렇게 만든 건 나를 죽이려는 예수회 신들로부터 숨고 재정비하기 위해서였다.」", 102)
		PRINTL
		CALL PRINT_GPC("W", @"「모든 것이 어디에 있는지 볼 수 있도록 투어를 할 수 있습니다.」", 102)
		CALL PRINT_GPC("W", @"「나중에 돌아오는 것도 허락해 주지.」", 102)
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「음... 투어를 시작하고 싶다면 난 언제나 여기 있어.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「자, 이리 와서 앉아 보게.」
		CALL PRINT_GP("W", @"눈 깜짝할 사이에 당신은 현재 있는 곳에서 꽤 큰 게이트가 쳐진 도시의 입구로 순간이동한다.")
		CALL SET_DATE(11, 102, 0, 0)
		TFLAG:デート道中 = 0
		CFLAG:MASTER:現在位置 = GET_ENTRANCE(11)
		CFLAG:(102):現在位置 = GET_ENTRANCE(11)
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「길을 잃었나요? 도시로 다시 모셔다 드릴까요?」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「네 선택을 재고하고 있나요?」
		PRINTFORML 「음... 돌아갈 의향이 있다면 언제든 여기 있어요.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
	CASE "Makai City"
		CALL PRINT_GP("L", @"땅이 비정상적으로 느껴진다. 아스팔트 같지만 훨씬 더 미끄러움이 적다.")
		CALL PRINT_GP("L", @"하늘은 어둡고, 붉은 빛으로 물들어 있다.")
		CALL PRINT_GP("L", @"건물들은 밝은 제논 조명을 드리우며 거리를 환하게 비추는 동시에 기념비적인 구조물들을 부각시켰다.")
		CALL PRINT_GP("L", @"체발리에, 대시, 프랭클린, 마스터슨 등 다양한 브랜드의 차들이 도로를 가득 메우고 오른쪽으로 주행한다.")
		CALL PRINT_GP("L", @"간판이 있는 고층 빌딩 \"겐소우짱 마카이테크\" 눈에 띄는데, 도시에서 가장 높은 건물이다.")
		CALL PRINT_GP("L", @"그 도시는 웬만한 환상향보다 확실히 더 발달해 보인다.")
		PRINTL
		CALL PRINT_GPC("W", @"「이곳은 악마 세계의 번화한 비즈니스 중심지인 마카이 시티다.」", 102)
		CALL PRINT_GPC("L", @"「강한 요괴들이 어울리고, 상점을 열고, 그저 삶을 살아가는 곳이다.」", 102)
		CALL PRINT_GPC("W", @"「마음에 들어요? 도시는 확실히 꽤 바쁘네요.」", 102)
		PRINTL
		CALL PRINT_GP("L", @"당신이 응답하기도 전에 마카이 시민 한 명이 다가와 %CALLNAME:102%에게 인사를 건넨다.")
		CALL PRINT_GPC("L", @"「안녕하세요 어머니. 새로운 신입을 데려오셨군요.」")
		CALL PRINT_GPC("L", @"「정말로. 이 %PRINT_MALE("boy",MASTER)%은 나의 최신작이다.」", 102)
		CALL PRINT_GP("L", @"%CALLNAME:102%는 시민의 손을 맞잡으며 동의를 표한다.")
		CALL PRINT_GP("L", @"시민은 즐거운 표정으로 당신을 바라보며 걸어간다, %CALLNAME:102%.")
		PRINTL
		CALL PRINT_GPC("W", @"「아 맞다. 마카이 시민들은 이 세계와 마카이 종족의 창조주인 나를 보통 어머니라고 부른다.」", 102)
		RETURN 1
	CASE "World of Ice and Snow"
		CALL PRINT_GP("L", @"당신이 그 지역에 첫발을 내딛자, 땅과 나뭇잎들이 눈으로 뒤덮여 얼음장처럼 차갑다는 것을 알아차린다.")
		CALL PRINT_GPC("W", @"「얼음과 눈의 세계에 오신 것을 환영합니다.」", 102)
		CALL PRINT_GP("L", @"%CALLNAME:102%의 숨결이 보이며 %HE_SHE(102)%가 말한다.")
		CALL PRINT_GPC("L", @"「이것은 마카이 대부분 지역 사이의 중간 지점이다.」", 102)
		CALL PRINT_GPC("W", @"「그것은 영하의 기온과 많은 눈으로 인해 상당히... 극한의 환경에 있다.」", 102)
		PRINTL
		CALL PRINT_GPC("L", @"「그것은 방문객들이 안전하게 도시에 머물고, 허가되지 않은 장소로 벗어나지 않도록 설계되었다.」", 102)
		RETURN 1
	CASE "Vina (or at least, the ruins of it)"
		CALL PRINT_GP("L", @"당신은 세월과 자연의 힘에 방치되어 눈으로 뒤덮인 버려진 시설을 우연히 발견한다.")
		CALL PRINT_GP("L", @"건물의 일부는 공격으로 파괴되어 무너졌고, 그 안에도 눈이 쌓였다.")
		CALL PRINT_GPC("L", @"「눈 속에서 버려진 프로젝트 중 하나를 발견했을지도 모른다고 생각한다.」", 102)
		CALL PRINT_GPC("L", @"「안으로 들어가자. 감기 걸릴까 봐 걱정이야.」", 102)
		CALL PRINT_GP("W", @"%CALLNAME:102%가 문을 열고 안으로 안내한 뒤 건물로 들어가 문을 닫는다.")
		PRINTL
		CALL PRINT_GPC("W", @"「이것은 프로젝트 비나다. 아니면 적어도 그 유적지겠지.」", 102)
		CALL PRINT_GPC("W", @"「이것은 한 건물에서 도시의 동력을 공급하기 위한 프로젝트로 만들어졌다.」", 102)
		CALL PRINT_GPC("W", @"「하지만 시간과 연구가 발전하고 분산된 기압 동력이 표준이 되면서, 비나는 더 이상 필요 없게 되어 버려졌다.」", 102)
		CALL PRINT_GPC("W", @"「아마 당신의 도움으로 그것을 예전 영광으로 되돌릴 수 있을 거예요.」", 102)
		CALL PRINT_GPC("W", @"「아마 집이나 심지어 마을로 만들 수도 있을지도 모르겠다.」", 102)
		RETURN 1
	CASE "Pandemonium"
		CALL PRINT_GP("L", @"당신은 장엄한 사원에 들어서고 그 디자인에 감탄하게 된다.")
		CALL PRINT_GP("L", @"복도의 거대한 크기 때문에 두 분은 작아 보이며, 밝은 조명이 당신과 %CALLNAME:102%를 비춘다.")
		CALL PRINT_GPC("W", @"「그리고 이것이 바로 마카이의 심장이다.」", 102)
		CALL PRINT_GPC("W", @"「여기가 협상이 이루어지고, 고위층이 살고, 내가 쉬는 곳이다.」", 102)
		PRINTL
		CALL PRINT_GP("L", @"%CALLNAME:102%가 당신을 안내하다가 %HE_SHE(102)%이 홀의 조각상 앞에서 멈춘다.")
		CALL PRINT_GP("L", @"그 조각상은 정화의 지팡이를 들고 전통적인 신사 계집 옷을 입은 작은 여성을 묘사한다.")
		CALL PRINT_GPC("L", @"「이 조각상은 보라색 머리를 한 이전의 하쿠레이 신사 마에다.」", 102)
		CALL PRINT_GPC("L", @"「그녀는 예수회 소속이 아닌 최초의 근세 요괴 거주민 중 한 명으로 악마계에 들어갔다.」", 102)
		CALL PRINT_GPC("W", @"「그녀는 내 사람들을 꽤 심하게 때렸지만, 우리가 새로운 시대로 넘어감에 따라 그녀는 우리 군대가 기반을 두게 된 존재였다.」", 102)
		PRINTL
		CALL PRINT_GP("L", @"%CALLNAME:102%가 당신을 다른 조각상으로 이끈다.")
		IF CFLAG:55:面識
			CALL PRINT_GP("L", @"그 조각상은 묘사한다 %CALLNAME:55%\@ ABL:MASTER:43 >= UniversalRank("B") ? 불교적인 %PRINT_MALE("man",55)% 호카이에서 수년 전에 봉인된 # . \@")
		ELSE
			CALL PRINT_GP("L", @"그 조각상은 긴 머리를 한 드레스를 입은 키가 큰 불교 여성을 묘사한다.")
		ENDIF
		CALL PRINT_GPC("L", @"「새로운 시대는 불교도들이 나타날 때까지 수년 동안 우리를 감시하고 있었다.」", 102)
		CALL PRINT_GPC("L", @"「그들은 배를 타고 와서 거기에 있는 것을 차지하기 위해 호카이에서 싸웠지만 성공하지 못했다.」", 102)
		CALL PRINT_GPC("L", @"「소동이 끝난 후, 나는 소녀와 협상하여 배를 이용해 이계에 외부인의 출입을 허용했고, 그래서 지금 악마 세계에 천객만래가 생긴 것이다.」", 102)
		IF ABL:MASTER:43 >= UniversalRank("B")
			CALL ASK_M( @"...", 1, @"[Knowledge {ABL:MASTER:43}/{UniversalRank("B")}] 그렇게 진행되지 않았어. 그녀는 봉인되어 있었고, 그들은 그녀를 해방시키려고 노력하고 있었다.", 1, )
			SELECTCASE RESULT
				CASE 0
					CALL PRINT_GP("L", @"당신은 %HES_SHES(102)%가 하는 말이 말이 되지 않는다는 직감이 들지만, %HIM_HER(102)%를 지적하지 않는다.")
				CASE 1
					CALL PRINT_GPC("L", @"「어라? 그게 사실이야?」", 102)
					CALL PRINT_GPC("L", @"「나는 정직하게 호라이에서 무슨 일이 일어나는지는 별로 신경 쓰지 않는다. 그곳은 거의 전투 지역일 뿐이다.」", 102)
					CALL PRINT_GPC("L", @"「하지만 그것이 결국 아웃사이더들이 침공하게 만들었으니 나는 그것을 간직할 것이다.」", 102)
			ENDSELECT
		ENDIF
		RETURN 1
	CASE "Hokkai"
		CALL PRINT_GPC("W", @"「호카이는 마카이에서 점수가 결정되는 곳이다.」", 102)
		CALL PRINT_GPC("W", @"「그것은 버려진 건물들, 환경과 전쟁에 잃은 영혼들, 그리고 악명 높은 붉은 안개로 가득 찬 전투 지역이었다.」", 102)
		CALL PRINT_GP("L", @"붉은 안개가 하늘을 뒤덮으며 어두운 그림자를 드리웠다.")
		CALL PRINT_GPC("W", @"「사람들이 수다 떨러 오는 곳은 아닌 것 같아, 응?」", 102)
		PRINTL
		CALL PRINT_GPC("W", @"「나는 '호카이'에 별로 신경을 쓰지 않아서 지금의 상태인 것이다.」", 102)
		CALL PRINT_GPC("W", @"「정말로, 나는 도시 전체에 분쟁이 일어나길 원하지 않는 것뿐이야.」", 102)
		CALL PRINT_GPC("W", @"「관광객 경험을 훨씬 즐겁지 않게 만든다.」", 102)
	CASE "Wonderland"
		CALL PRINT_GPC("W", @"「아, 원더랜드라니, 내 딸의 커버를 했던 미국인이 생각나네.」", 102)
		CALL PRINT_GPC("W", @"「이곳은 실험적인 장소라 정해진 특징이 없다는 뜻이다.」", 102)
		CALL PRINT_GPC("W", @"「오늘은 무성하고 반짝이는 들판이지만, 내일은 도시의 지구이거나 심지어 화산 산이 될 수도 있다.」", 102)
		CALL PRINT_GPC("W", @"「무엇이든 마카이의 일부가 된다, 호카이처럼 혹은 얼음과 눈의 세계처럼.」", 102)
		CALL PRINT_GPC("W", @"「다른 이들은 잘 지내고 있지, 내 마음속에 두는 게 나을 거야.」", 102)
		RETURN 1
	CASE "Fallen Temple"
		CALL PRINT_GPC("W", @"「이 신전은 성전의 막바지 해에 지어진 휴전 건물이었다.」", 102)
		CALL PRINT_GPC("W", @"「이곳에서는 앞서 언급된 신과 후루스즈 같은 예수회 신들을 사람들이 숭배했다.」", 102)
		IF ABL:MASTER:43 >= UniversalRank("B")
			CALL ASK_M( @"...", 1, @"[지식 {ABL:MASTER:43}/{UniversalRank("B")}] 당신은 예수님을 말씀하시는 건가요?", 1, )
			SELECTCASE RESULT
				CASE 0
					CALL PRINT_GP("L", @"%HES_SHES(102,1)%은 많은 것을 잘못 기억하고 심지어 예수의 이름조차 못 하지만 당신은 %HIM_HER(102)%을 언급하지 않는다.")
				CASE 1
					CALL PRINT_GPC("L", @"「아, 정말 미안해.」", 102)
					CALL PRINT_GPC("L", @"「그들과 교류한 지 수백 년이 되었다.」", 102)
					CALL PRINT_GPC("L", @"「이곳에서 사람들은 언급된 신과 예수와 같은 예수회 신들을 숭배했다.」", 102)
			ENDSELECT
		ENDIF
		PRINTL
		CALL PRINT_GPC("W", @"「하지만 수백 년간의 방치로 인해 그 사원은 황폐해진 상태였다.」", 102)
		CALL PRINT_GPC("W", @"「무너진 기와들, 손상된 벽돌들, 썩은 문들, 심지어 부서진 조각상까지.」", 102)
		CALL PRINT_GPC("W", @"「연합이 창설된 이래, 그 사찰은 누군가를 위한 주거 공간으로 개조되었다.」", 102)
		CALL PRINT_GPC("W", @"「나는 추방당하고 거의 죽을 뻔한 천사 한 명과 그녀의 친구 엘리스를 이곳에 머물게 했어.」", 102)
		CALL PRINT_GPC("W", @"「나는 예배당도 복구했지만, 이제 그곳은 단순히 예수회 신을 숭배하는 장소 이상이다.」", 102)
		CALL PRINT_GPC("W", @"「내가 부서진 조각상을 나 자신의 조각상으로 바꿨지만, 그것은 소용이 없었다.」", 102)
		PRINTL
		CALL PRINT_GPC("W", @"「기도할 곳이 필요하거나 죄를 속죄하고 믿는 신을 숭배하려면, 이곳은 아마 대부분의 장소보다 나은 곳일 것이다.」", 102)
	CASE "成功報告時"
		;報酬：
		CALL PRINT_GPC("W", @"「음, 마카이는 어땠어? 적어도 재미있진 않았니?」", 102)
		CALL ASK_M( @"응, 재미있었어.", 1, @"별로, 더 많이 봤어.", 1, )
		SELECTCASE RESULT
			CASE 0
				CALL PRINT_GPC("W", @"「내 세계가 제공하는 것을 즐겨 주셔서 기쁘다.」", 102)
				CALL PRINT_GP("L", @"%CALLNAME:102%는 그 후에 작은 미소를 지었다")
			CASE 1
				CALL PRINT_GPC("W", @"「뭐, 적어도 시도는 해봤네.」", 102)
				CALL PRINT_GP("L", @"%CALLNAME:102%은(는) 그 후 작은 미소를 짓지만, %HIS_HER(102)%의 얼굴에는 약간의 걱정이 서려 있었다.")
		ENDSELECT
		PRINTL
		CALL PRINT_GPC("L", @"「마카이로 가려면 사원의 배로 가라.」", 102)
		CALL PRINT_GPC("L", @"「나는 당신과 같은 사람들을 이곳에 오고 다시 돌아갈 수 있게 해주는 성간 운송 회사와 계약을 맺었다.」", 102)
