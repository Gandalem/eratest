@M_KOJO_IRAI_UNIQUE_111_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「안녕 내 아가 %CALLNAME:MASTER%.」
		PRINTFORML 「누군가에게 시험해보고 싶은 술이 있어.」
		PRINTFORML 「%NAME:60%를 위해 특별히 새로 만든 칵테일이야.」	
		PRINTFORML 「강한 사케, 약간의 레드 와인, 설탕 조금, 그리고 나만의 향신료가 들어갔어.」
		PRINTFORML 「시간 날 때 %CALLNAME:60%에게 이걸 줘.」
		PRINTL
		PRINTFORML 「사용자가 무엇에 관심이 있든 할 수 있는 일이라고 생각해서 다른 임무는 없습니다.」
		PRINTFORML 「끝내면 아름다운 변신을 시켜주겠어.」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「음... 돈을 던져주든 임무를 수행하든 난 항상 여기 있어.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「그럴 거예요? 잘 풀리면 정말 기쁠 것 같아요.」
			DATAFORM 「고마워요. 당신을 믿게 되어 다행이에요.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「%NAME:60%에게 칵테일을 대접하라.」
		PRINTFORML 「당신의 보상으로 미적인 형상 임플란트를 주겠다.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「자, 이건 내 선물이야.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 1
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORMDW 당신은 %CALLNAME:102%에게 발견한 것을 보고한다.
		IF GETBIT(nPee,1) || GETBIT(nScat,2)
			PRINTFORML 「... %HIS_HER(60)%의 하반부에 이상한 느낌을 보고했다...」
			PRINTFORMW 「... 마신 후에 통제할 수 없는 사고를 쳤다...」
			PRINTL
			PRINTFORMW 「음, 그게 성공이라고 부를 만한 일이지.」 
			PRINTL 
			PRINTFORMW 「%CALLNAME:60%은(는) 나의 새 약인 익스크리멘토리움의 테스트였다.」
			PRINTFORML 「그것은 사람의 소화 및 배뇨 시스템을 비가역적으로 활성화하는 강력한 완하제다.」
			PRINTFORML 「그것 때문에 먹고 마시면서 화장실도 가야 할 것이다.」
			PRINTFORML 「대부분의 경우, 이것을 마신 사람들은 그 징후를 알지 못하다가 결국 실금에 이르게 된다.」
			PRINTFORML 「지금 바로 제조법을 주겠다:」
			PRINTFORML 「이뇨제 1개, 완하제 1개, 그리고 나의 액체 생성 병 하나다.」
			PRINTFORML 「대안으로, 너의 유주술 능력을 사용해서 그것을 소환해도 된다.」
		ELSE
			PRINTFORML 「... 이상은 보고되지 않았다...」
			PRINTFORMW 「... 음료는 좋다고 말했다...」
			PRINTL
			SETCOLOR C_RED
			PRINTFORMW 「Ｄａｍｎｉｔ.」
			PRINTFORML 「왜 이 세상은 나에게 이렇게 잔인한 걸까. 재미있는 일을 하고 싶었는데 세상은 술이 정상이어야 한다고 말하네.」
			PRINTFORMW 「내 실험 약 중 하나였는데, 정말로 내 실험을 하게 해주고 싶지 않은 것 같아.」	
			PRINTL
			PRINTFORML 「이 세상은 나를 놀리고 있는 게 틀림. 기꺼이 테스트해 줄 사람 대신, 나에게 돈을 주고  연인 역할을 시키는 홍보꾼을 얻었지. %HIS_HER(MASTER)% lover.」
			PRINTFORMW 「내가 소중히 여기는 것에 대한 사랑을 표현하는 대신 비웃음당하고 영원히 괴롭힘을 당한다.」
			PRINTFORMW 「그들은 나를 퇴폐인이라 부르고, 악하다고 부르며, 지구의 쓰레리라고 부른다.」
			PRINTFORMW 「동성애자가 아님에도 어떤 이들은 나를 포티이라고 부르거나, 이 세계가 망한 유일한 이유라고 한다.」
			PRINTFORMW 「그들이 생각해 낼 수 있는 모든 빌어먹을 욕설을 내게 던진다.」
			PRINTFORMW 「단지 내가 이 세상의 99\%이 싫어하는 대체 속옷을 좋아한다는 것 때문인가?」
			PRINTFORML
			PRINTFORMW 「그리고 이제 내가 가진 건 진짜 나를 놓치게 될 누군가뿐이고, 아마 내가 가진 걸로 %HIS_HER(MASTER)%을 대가를 치르게 하고, 내가 충분하지 않다고 생각하게 만들겠지.」
			PRINTFORMW 「내가 갖는 것은 가장 타락한 자들에게만 어필할 뿐이겠지만, 제발.」
			PRINTFORMW 「제발 기회를 줘, 빌어먹을.」
			RESETCOLOR
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「흥. 돈이 부족해? 괜찮아, 다음에 하면 되지.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
