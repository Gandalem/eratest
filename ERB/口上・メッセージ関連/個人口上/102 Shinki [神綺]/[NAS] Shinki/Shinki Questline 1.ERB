@M_KOJO_IRAI_UNIQUE_301_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
    $FIRSTSEE
	PRINTFORML 「The main way of making the girls or boys fall for you involves conversastions.」
	PRINTFORML 「Serving tea is also a good way of making friends as well. Let's try both.」
	RETURN 1
CASE "Conversastions"
    PRINTFORML 「Conversing with another Touhou is a great way of building relationships」
    PRINTFORML 「Remember that there is a limit amount of conversastions that you can do, so be sure to stop once you can't bring up any more topics.」
    PRINTFORML 「After a short amount of time, you'll be able to converse with the character again.」
    PRINTFORML 「The chance of a successful conversastion depends on the condition of your mouth and your speech skill」
    PRINTFORML 「There is a low chance that you may be able to have a better than usual conversastion and have a better outcome as a result.」
CASE "Serving Tea"
    PRINTFORML 「Serving tea is an important thing that is needed if you want a girl to fall for you.」
    PRINTFORML 「Tea cooking is dependent on your cooking skill and your success chances increase the higher it is.」
    PRINTFORML 「Everyone will take the tea and gain some Favor with you as a result.」
    PRINTFORML 「You can only serve tea to a person once per hour, but this can be circumvented if you serve tea to another person in the area.」
    PRINTFORML 「Everyone will take the tea and gain some Favor with you as a result.」

CASE "依頼非受託時"
	PRINTDATAL
		DATAFORM 「You don't have to come with me, though you're better off if you do.」
	ENDDATA
	RETURN 1
CASE "依頼受託時"
	PRINTDATAW
		DATAFORM 「Thank you. I know you probably need me to guide you.」
	ENDDATA
	RETURN 1
CASE "依頼確認時"
    GOTO FIRSTSEE
	RETURN 1
CASE "依頼破棄時"
	RETURN 1
CASE "依頼実行直前"
    RETURN 0
CASE "依頼実行直後"
	RETURN 0
CASE "成功報告時"
;報酬： 
	RETURN 1
CASE "失敗報告時"
	PRINTDATAL
		DATAFORM 「Ah, you can always do another then.」
	ENDDATA
	RETURN 1
	;IF !RESULT
	;	PRINTFORML
CASE "依頼報告不要"
	RETURN 0
ENDSELECT

