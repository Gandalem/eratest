@M_KOJO_IRAI_UNIQUE_301_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		$FIRSTSEE
		PRINTFORML 「소녀들이나 소년들이 당신에게 반하게 만드는 주요 방법은 대화에 관여하는 것이다.」
		PRINTFORML 「차를 대접하는 것도 친구를 사귀는 좋은 방법이다. 둘 다 시도해 보자.」
		RETURN 1
	CASE "Conversastions"
		PRINTFORML 「다른 동방 캐릭터와 대화하는 것은 관계를 쌓는 좋은 방법이다.」
		PRINTFORML 「할 수 있는 대화의 양에는 한계가 있다는 것을 기억하고, 더 이상 주제를 꺼낼 수 없을 때 반드시 멈추도록 하라.」
		PRINTFORML 「짧은 시간이 지나면 다시 캐릭터와 대화할 수 있게 된다.」
		PRINTFORML 「성공적인 대화의 확률은 네 입의 상태와 너의 화술기능에 달려 있다.」
		PRINTFORML 「평소보다 더 나은 대화를 나누고 그 결과 더 좋은 결과를 얻을 가능성이 낮게 존재한다.」
	CASE "Serving Tea"
		PRINTFORML 「차를 대접하는 것은 소녀가 당신에게 빠지게 하려면 필요한 중요한 일이다.」
		PRINTFORML 「차 요리는 당신의 요리기능에 달려 있으며, 성공 확률은 높을수록 증가한다.」
		PRINTFORML 「모든 사람이 차를 마시고 그 결과로 당신에게 호의를 얻는다.」
		PRINTFORML 「당신은 한 시간 동안 한 사람에게만 차를 대접할 수 있지만, 주변의 다른 사람에게 차를 대접하면 이를 우회할 수 있다.」
		PRINTFORML 「모든 사람이 차를 마시고 그 결과로 당신에게 호의를 얻는다.」
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「감사합니다. 당신에게 제가 안내해 주길 바랄지도 안 된다는 것을 알고 있습니다.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		GOTO FIRSTSEE
		RETURN 1
	CASE "依頼破棄時"
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

@M_KOJO_IRAI_UNIQUE_302_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
