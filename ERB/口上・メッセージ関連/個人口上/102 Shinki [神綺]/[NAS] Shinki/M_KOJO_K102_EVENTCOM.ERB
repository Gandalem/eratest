;triggers on every command before the command itself is processed
@M_KOJO_EVENT_K102_EVENTCOM(ARGS,ARG,ARG:1)
;do whatever
	
;triggers on every command after the command itself is processed, but before other EVENTCOMEND triggers
@M_KOJO_EVENT_K102_EVENTCOMEND_PRI(ARGS,ARG,ARG:1)
;do whatever

;triggers on every command after the command itself is processed
@M_KOJO_EVENT_K102_EVENTCOMEND(ARGS,ARG,ARG:1)
;do whatever

;overlaps with event 31, but does not require the player to have met the character
;clear trailing flags/etc
@M_KOJO_EVENT_K102_AFTERTRAIN_BEGIN(ARGS,ARG,ARG:1)
;do whatever

@M_KOJO_EVENT_K102_AFTERTRAIN_END(ARGS,ARG,ARG:1)
;do whatever

@M_KOJO_EVENT_K102_BEFORETRAIN_END(ARGS,ARG,ARG:1)
;do whatever
IF !ITEM:MiniShinki && DAY > 1 && !GETBIT(K102_EV,0) && !SaveIsEZB
    CALL K102_MiniShinkiDropOff
    SETBIT K102_EV, 0
ENDIF

;triggers on a new month
@M_KOJO_EVENT_K102_MONTH_CHANGE(ARGS,ARG,ARG:1)
