CASE 301
	SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Your First Conversastion")
	CASE "依頼内容表示"
		LOCALS '= @"Learn about Conversing"
		{
		LOCALS += IRAI_CHECKLIST(
			@"Talk to someone",GETBIT(CharaQuestLine:102:1:1,1),
			@"Serve someone tea",GETBIT(CharaQuestLine:102:1:1,2),
		)
		}
		CALLF MAKE_STR(V_NAME, LOCALS)
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"+30 Knowledge Exp + Favor")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, "Turn In")
		
	CASE "依頼内容"
		;
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "tutorial"))
	CASE "依頼サブ"
	CASE "依頼期限"
	CALLF MAKE_INT(V_NAME, YearLength)	
	CASE "依頼発生率"
	;これは他の固有依頼との相対確率なんで10％ではありません
		CALLF MAKE_INT(V_NAME, 10)
	CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
	;実行可能は@COM_ABLE367も確認のこと
	[IF_NDEBUG]
		IF QUEST_LINE_QUEST_IS_COMPLETED(102,ARG % 1000) || CharaQuestPath:102:0 != 1
			CALLF MAKE_INT(V_NAME, 0)
		ELSE
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	[ELSE]
		CALLF MAKE_INT(V_NAME, 1)
	[ENDIF]
	CASE "Line Requirements"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "Pass Requirements"
		LOCAL:5 = 0
		SETBIT LOCAL:5,1
		SETBIT LOCAL:5,2
		CALLF MAKE_INT(V_NAME, CharaQuestLine:102:1:1 >= LOCAL:5)
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE "依頼消滅条件"
	;30％で消失
	SIF Add_Request_Should_Discard(ARG)
			CALLF MAKE_INT(V_NAME, 1)
	ENDSELECT
