;bladder therapy
@M_KOJO_IRAI_UNIQUE_901_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Hello dear. It's a pleasure to meet you.」
	PRINTFORMDW The matronly %CALLNAME:102% smiles with glee at you.
	PRINTFORML 「You're new to Gensokyo, yes?」
	PRINTFORMDW You nod your head, having recently arriving in Gensokyo.
	PRINTFORML 「Do you need some guidance on what to do now that you're here?」
	PRINTFORMDW You nod your head again.
	PRINTL
	PRINTFORMW 「Ah, I can get you used to life here, and perhaps even prosper.」
	PRINTFORMW 「I know you're probably overwhelmed with what you can do here in this world.」
	PRINTL
	PRINTFORMW 「Perhaps you might need some of my guidance.」
	PRINTFORMW 「I have a few cards that you can pick that'll guide you through this world.」
	RETURN 1
CASE "依頼非受託時"
	PRINTDATAL
		DATAFORM 「You don't have to come with me, though you're better off if you do.」
	ENDDATA
	RETURN 1
CASE "依頼受託時"
	PRINTDATAW
		DATAFORM 「Thank you. I know you probably need me to guide you.」
	ENDDATA
	RETURN 1
CASE "依頼確認時"
	PRINTFORML 「Let us get a private room first shall we.」
	PRINTFORML 「Your reward's a secret.」
	RETURN 1
CASE "依頼破棄時"
	PRINTFORML 「Hopefully you'll know your way then.」
	RETURN 1
CASE "依頼実行直前"
	PRINTFORML 「Here are three cards, pick the one that suits you the best.」
	RETURN 0
CASE "依頼実行直後"
	RETURN 0
CASE "成功報告時"
;報酬： 
	PRINTFORMW 「Ufufu～ You can aways change it at any time.」
	IF !ITEM:MiniShinki
	PRINTL
	PRINTFORMW 「Oh, and I almost forgot!」
	CALL K102_MiniShinki
	ENDIF
	RETURN 1
CASE "失敗報告時"
	PRINTDATAL
		DATAFORM 「Ah, you can always do another then.」
	ENDDATA
	RETURN 1
	;IF !RESULT
	;	PRINTFORML
CASE "依頼報告不要"
	RETURN 0
ENDSELECT


