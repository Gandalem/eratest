@M_KOJO_IRAI_UNIQUE_901_K102(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「안녕하세요, 소중한 분. 만나서 반갑습니다.」
		PRINTFORMDW 숙녀 같은 %CALLNAME:102%는 당신을 보고 기쁜 듯 미소 지었다.
		PRINTFORML 「당신은 환상향에 새로 온 거군요?」
		PRINTFORMDW 당신은 최근 환상향에 도착하여 고개를 끄덕였다.
		PRINTFORML 「여기 오셨으니 무엇을 해야 할지 안내가 필요하신가요?」
		PRINTFORMDW 당신은 다시 한번 고개를 끄덕였다.
		PRINTL
		PRINTFORMW 「아, 여기 생활에 익숙해지고 어쩌면 번성할 수도 있게 해줄 수 있어.」
		PRINTFORMW 「네가 이 세상에서 할 수 있는 일들에 압도되었을 거라는 걸 알아.」
		PRINTL
		PRINTFORMW 「혹시 내 안내가 필요할지도 모르겠군.」
		PRINTFORMW 「이 세계를 헤쳐나갈 수 있도록 도와줄 몇 장의 카드가 있네.」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「같이 오지 않아도 되지만, 함께 오는 편이 더 나을 테니 말이야.」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「감사합니다. 당신에게 제가 안내해 주길 바랄지도 안 된다는 것을 알고 있습니다.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「우선 조용한 방을 잡는 게 좋겠어.」
		PRINTFORML 「네 보상은 비밀이야.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「부디 길을 찾길 바라네.」
		RETURN 1
	CASE "依頼実行直前"
		PRINTFORML 「여기에 세 장의 카드가 있어, 가장 잘 맞는 것을 골라.」
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORMW 「후후후~ 언제든지 바꿀 수 있어.」
		IF !ITEM:MiniShinki
			PRINTL
			PRINTFORMW 「아, 그리고 깜빡할 뻔했네!」
			CALL K102_MiniShinki
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「아, 언제든지 또 할 수 있어.」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT

