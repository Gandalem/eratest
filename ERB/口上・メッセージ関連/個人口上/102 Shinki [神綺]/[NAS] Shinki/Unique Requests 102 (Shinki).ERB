; Modular ERB: 個人口上/102 Shinki [神綺]/[NAS] Shinki/Unique Requests 102 (Shinki).ERB

@固有依頼102(ARG, O_DATA, V_NAME)
#FUNCTION
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
	CASE 901
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "The Devil's Deal")
			CASE "依頼内容表示"
				CALLF MAKE_STR(V_NAME, @"할 퀘스트 라인을 선택하세요.")
			CASE "依頼報酬表示"
				CALLF MAKE_STR(V_NAME, @"미니 %CALLNAME:102%")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, "Request")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
			CASE "依頼サブ"
			CASE "依頼期限"
				CALLF MAKE_INT(V_NAME, YearLength)
			CASE "依頼発生率"
				;これは他の固有依頼との相対確率なんで10％ではありません
				CALLF MAKE_INT(V_NAME, 10)
			CASE "依頼発生条件"
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼受託可能条件"
				;受託可能は@COM_ABLE366も確認のこと
				;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼実行可能条件"
				;実行可能は@COM_ABLE367も確認のこと
				[IF_NDEBUG]
				IF CharaQuestPath:102:0 != -1
					CALLF MAKE_INT(V_NAME, 0)
				ELSE
					CALLF MAKE_INT(V_NAME, 1)
				ENDIF
				[ELSE]
				CALLF MAKE_INT(V_NAME, 1)
				[ENDIF]
				;成功/失敗処理はCARRYOUTで直接書く
				;SOURCEやITEM入手など、内容が複雑なので
			CASE "依頼消滅条件"
				;30％で消失
				SIF Add_Request_Should_Discard(ARG)
					CALLF MAKE_INT(V_NAME, 1)
		ENDSELECT
	CASE 101
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "A tour of Makai")
			CASE "依頼内容表示"
				LOCALS '= @"마계 관광\n"
				LOCALS += IRAI_CHECKLIST( @"도시를 둘러라",GETBIT(CharaQuestLine:102:0:1,0), @"얼음과 눈의 세계를 여행하라",GETBIT(CharaQuestLine:102:0:1,1), @"비나 유적을 둘러라",GETBIT(CharaQuestLine:102:0:1,2), @"팬데모니엄을 둘러라",GETBIT(CharaQuestLine:102:0:1,3), @"원더랜드(Wonderland)를 여행한다.",GETBIT(CharaQuestLine:102:0:1,4), @"토르 호카이",GETBIT(CharaQuestLine:102:0:1,5), )
