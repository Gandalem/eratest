@M_KOJO_MESSAGE_COM_K37_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == 2
		IF TALENT:恋慕
			PRINTFORML 「에헤헤ー」
			PRINTFORML 「이걸 나에게 준다면 용서해 줄게ー♪」
			PRINTFORMW 
		ELSE
			PRINTFORML 「에? 괜찮아?」
			PRINTFORML 「냐후후~♪ 아흠, 아흠!」
			PRINTFORMDL 오쿠가 너무 빨리 씹다가 기침을 하기 시작했다.
			PRINTFORMW 
		ENDIF
	ELSEIF TFLAG:193 == 1
		IF TALENT:恋慕
			PRINTFORML 「좋아! 그 정도면 충분해!」
			PRINTFORML 「하자! ....하자~♪」
			PRINTFORMW 
		ELSE
			PRINTFORML 「괜찮아!」
			PRINTFORML 「하자! 즐겁게 놀자!!」
			PRINTFORMW 
		ENDIF
	ELSEIF TFLAG:193 == 0
		IF TALENT:恋慕
			PRINTFORML 「음~」
			PRINTFORML 「알겠어!」
			PRINTFORMW 
		ELSEIF TALENT:思慕
			PRINTFORML 「우으음... 우으...」
			PRINTFORML 「좋아! 용서해 줄게!」
			PRINTFORMW 
		ELSE
			PRINTFORML 「...? 무슨 소리 하는 거야?」
			PRINTFORML 「아! 이제 기억났다! 우으ー!」
			PRINTFORML 「하지만 내가 그것에 대해 어떻게 느꼈었는지 까먹었어! 그래서 용서해 줄게!」
			PRINTFORMW 
		ENDIF
	ELSEIF TFLAG:193 == -1
		IF TALENT:恋慕
			PRINTFORML 「No! No!!」
			PRINTFORMW 
		ELSEIF TALENT:思慕
			PRINTFORML 「으음ー, 아직 용서 못 해ー!」
			PRINTFORMW 
		ELSE
			PRINTFORML 「...」
			PRINTFORML 「안 돼! 용서 못 해.」
			PRINTFORMW 
		ENDIF
	ELSEIF TFLAG:193 == -2
		PRINTFORML 「안 돼! 안 돼!... 파괴해!」
		PRINTFORMDW 그녀의 제어봉에서 열기가 느껴진다...
		PRINTFORMW 
	ENDIF
ENDIF
RETURN 1
