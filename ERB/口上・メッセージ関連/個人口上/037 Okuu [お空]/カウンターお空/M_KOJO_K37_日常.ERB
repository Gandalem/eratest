;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K37_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K37_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K37_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;ここに口上書いて下さい
	;大成功
	IF TFLAG:193 == 1
		IF TALENT:恋慕 || TALENT:愛欲
			IF RAND:2
				PRINTFORML 「재미있는 거 들으면 나한테도 알려줘!」
				PRINTFORMDL 오쿠는 활기차게 말했지만, 같은 이야기를 반복해서 듣는 것에 만족하고 있었다.
				CFLAG:TARGET:溜まってる度  += 1000
			ELSE
				;not sure if I like just outright stating game mechanics in dialogue
				PRINTFORML 「...! 대단해! 응!」
				PRINTFORMDL 오쿠는 네 지식에 감명받았지만, 그것을 이해한 자신에게도 감명받는다.
				;PRINTFORMDL Her Favor towards you has increased by 200.
				CFLAG:TARGET:好感度 += 200
			ENDIF
		ELSEIF TALENT:思慕 || TALENT:セフレ
			IF RAND:2
				PRINTFORML 「당신이 말하는 것들을 서서히 이해하기 시작했어, %CALLNAME:MASTER%!」
				PRINTFORMDL 너는 오쿠에게 이해받은 것 같아.
			ELSE
				PRINTFORML 「사토리님께 이 얘기는 한 번도 들어본 적이 없어!」
				PRINTFORMDL 오쿠의 눈이 빛나고 있었다.
			ENDIF
		ELSE
			PRINTFORML 「이해했다!」
			PRINTFORMDW 오쿠우는 주제를 이해한 것에 기뻐하며 고개를 끄덕였다.
		ENDIF
		;失敗
	ELSEIF TFLAG:193 == -1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「아! 나를 놀리고 있는 거야?!」
			PRINTFORMDW 오쿠우가 잘못 이해하고 있는 것 같다.
		ELSEIF TALENT:思慕 || TALENT:セフレ
			PRINTFORML 「그게 무슨 뜻이지?」
			PRINTFORMDW 오쿠우는 잘 이해하지 못하는 것 같다.
		ELSE
			PRINTFORML 「...? 음...??」
			PRINTFORMDW 오쿠우는 대화를 이해하지 못하고 혼란스럽게 고개를 기울인다...
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:2 == 0
			PRINTFORMW 「후후후~♪ 기분이 좋다~♪」
			PRINTFORMDW 오쿠우는 술에 취했다.
			CFLAG:TARGET:溜まってる度  += 1000
		ELSE
			PRINTFORMW 「♪～ %CALLNAME:MASTER%, 너무 많이 마시네－!」
			PRINTFORMDW 오쿠는 기쁜 듯 술잔을 건넨다. 
			PRINTFORMDW 이게 간접 키스라는 걸까...?
			CFLAG:TARGET:溜まってる度 += 20
		ENDIF
		;通常
	ELSEIF TALENT:恋慕
		IF TALENT:恋人
			PRINTFORMD 오쿠우가 당신의 말에 응답한다. 
			IF CHK_DATENOW(CFLAG:TARGET:デート中)
				IF RAND:2 == 0
					PRINTFORMW 
					PRINTFORML 「그렇게 말해주니 기쁘네~♪」
					PRINTFORMW 「우뉴~♪」
					PRINTFORMW 
					PRINTFORMW 
				ELSE
					PRINTFORMW 
					PRINTFORMW 「음~♪ 사랑해~♪ 응유~♪」
					PRINTFORMW 
					PRINTFORMW 
				ENDIF
			ELSEIF CFLAG:TARGET:添い寝中
				PRINTFORMDL 부드러운 미소를 지으며, 그녀는 아무렇지도 않게 당신의 몸에 기댄다.
				PRINTFORML 「음~ ... 같이 자자...?」
				PRINTFORML 
			ELSEIF BATHROOM()
				PRINTFORMDL 그녀는 편안한 표정으로 자신의 뜨거운 몸을 당신에게 맡긴다.
			ELSE
				PRINTFORMDL 그녀는 당신에 대한 신뢰를 보여주는 표정을 짓고 있다.
			ENDIF
		ELSE
			PRINTFORMD 오쿠우 
			IF CHK_DATENOW(CFLAG:TARGET:デート中)
				PRINTFORMDL 조용히 당신의 손을 자신의 손가락으로 감싼다.
				PRINTFORML 「감겨버렸어, 감겨버렸어~♪」
				PRINTFORML 
			ELSEIF CFLAG:TARGET:添い寝中
				PRINTFORMDL 그녀는 당신에게 미소 지으며 이불 속으로 기어든다.
			ELSEIF BATHROOM()
				PRINTFORMDL 피가 머리로 몰리자 당신과 대화를 나눈다.
			ELSE
				PRINTFORMDL 기분 좋고 다정한 미소를 보여준다.
				PRINTFORML 「재미있어♪」
				PRINTFORML 
			ENDIF
		ENDIF
		SELECTCASE RAND:5
			CASE 0
				;季節分岐
				SELECTCASE DAY:2
					;春
					CASE 1
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「지상 위가 봄이라고? 정말이야—?」
								PRINTFORML 「사토리님께서 이 계절의 꽃가루는 무섭다고 말씀하셨어요!」
							CASEELSE
								PRINTFORML 「지금은 아래보다 표면이 더 상쾌하게 느껴지는 것 같지, 그렇지?」
								PRINTFORML 「가끔 산책이라도 하고 싶다는 생각이 들어, 있잖아―」
								PRINTFORMDW 오쿠는 더 상쾌한 표면을 상상하고 있다.
						ENDSELECT
						;夏
					CASE 2
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「지상에는 여름이라고? 그게 뭐였더라?」
								PRINTFORML 「오린이 말하길 지하 깊은 곳 같다고!」
								PRINTFORMDW 오쿠는 지옥과 같은 표면을 상상하고 있었다.
							CASE 1
								PRINTFORML 「이맘때는 시체들이 더 많은 것 같아.」
								PRINTFORMW 「그러니까 오린이 얼마나 빨리 달리는지 봐!」
							CASEELSE
								PRINTFORML 「사토리는 지하에 오길 기쁘다고 말했다!」
								PRINTFORML 「그녀는 지상으로 가면 일사병이 온다고 했다...」
								PRINTFORMW 「그녀는 또한 탈수될 수도 있다고 말했다.」
						ENDSELECT
						;秋
					CASE 3
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「표면은 가을이라고?」
								PRINTFORML 「보아하니 무언가를 하기 좋은 계절이군ー!」
								PRINTFORMW 「많이 먹고 싶어!」
							CASE 1
								PRINTFORML 「지상에 가지 않아도 가을이라는 걸 알 수 있어!」
								PRINTFORML 「오린의 손수레바퀴에 예쁜 낙엽들이 잔뜩 달려있거든!」
								PRINTFORMDW 생각해 보니 당신은 오린의 화려하게 장식된 손수레바퀴를 분명 생생하게 기억하고 있다.
							CASEELSE
								PRINTFORML 「모두가 음식을 많이 가져오네요!」
								PRINTFORML 「저뿐만이 아니라 사토리님께요.」
								PRINTFORML 「하지만 사토리님은 그렇게 많이 드시지 않으니, 제가 배불리 먹어요.」
								PRINTFORMDW 그래서 당신의 몸이...
						ENDSELECT
						;冬
					CASE 4
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「지표면에는 겨울이 있다고요? 그게 뭐예요ー?」
								PRINTFORML 「추운 곳은 별로 없어서 잘 모르겠어요.」
								PRINTFORMDW 오쿠는 자신의 기억을 뒤지며 겨울을 상상하려고 노력했다.
							CASEELSE
								PRINTFORML 「모두들 기분이 안 좋아 보여.」
								PRINTFORML 「평소에 내가 말을 거는 사람들조차 평소와 달라.」
								PRINTFORML 「왜 그럴까?」
								PRINTFORMDW 당신도 왜 그런지 궁금해한다.
						ENDSELECT
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:12
					CASE 0
						PRINTFORML 「신이 나에게 이 힘을 준 건 다행이지만,」
						PRINTFORMW 「그곳을 관리하는 게 너무 힘들어!」
					CASE 1
						PRINTFORML 「핵융합을 위해 이 제어봉이 필요하지, 응?」
						PRINTFORMDW 오쿠는 수줍은 표정으로 자신의 팔에 달린 캐논을 흔들며 흥얼거린다.
					CASE 2
						PRINTFORML 「때로는 핵융합이 잘 되지 않기도 한다...」
						PRINTFORML 「모두가 정말 패닉에 빠진다...」
						PRINTFORMDW 오쿠우는 치정스러운 경험을 떠올린다.
					CASE 3
						PRINTFORML 「사토리님은 정말 많이 알고 계시네요!」
						PRINTFORMW 「당신도 알고 있어요, %CALLNAME:MASTER%!」
					CASE 4
						PRINTFORML 「오린은 항상 뭔가 밀어붙이잖아, 그렇지?」
						PRINTFORMW 「뭐인지 궁금하네...?」
					CASE 5
						PRINTFORML 「가끔 표면으로 가기도 하지만...」
						PRINTFORML 「사토리님은 늘 나에게 경고하셔...」
						PRINTFORML 「혹시 날 믿어주지 않는 건가 싶네...」
						PRINTFORMDW 오쿠는 고개를 숙인 채 말한다.
					CASEELSE
						PRINTFORML 「생각해보니, %CALLNAME:MASTER%너는 어디서 온 거니?」
						PRINTFORML 「...어라, 저번에 이미 물어봤었나? 음.」
						PRINTFORMDW 오쿠는 당신이 마지막으로 그녀에게 말했던 때를 떠올리려고 애썼다.
				ENDSELECT
		ENDSELECT
	ELSEIF TALENT:思慕
		PRINTFORMD 오쿠우 
		IF CHK_DATENOW(CFLAG:TARGET:デート中)
			PRINTFORMDL 몸을 돌려 행복한 표정으로 당신을 바라본다.
		ELSEIF CFLAG:TARGET:添い寝中
			PRINTFORMDL 그녀는 당신 쪽으로 몸을 돌리며 다소 긴장한 듯하다.
		ELSEIF BATHROOM()
			PRINTFORMDL 그녀는 당신에게 조금 더 가까이 다가와서 이야기한다.
		ELSE
			PRINTFORMDL 당신을 향해 아무렇지 않게 미소 짓는다.
		ENDIF
		SELECTCASE RAND:3
			CASE 0
				SELECTCASE RAND:6
					CASE 0
						PRINTFORML 「이봐, 봐봐!」
						PRINTFORMDL 그녀는 왼손을 들어 올린다.
						PRINTFORMW 「미니어처 선―!」
						PRINTFORMDW ...그녀가 마침내 멈출 때까지 너는 열기에 죽을 것만 같았다.
					CASE 1
						PRINTFORML 「이 제어봉은 제거할 수 있어, 알잖아!」
						PRINTFORMDL 그렇게 말하며 그녀는 그것을 덜컹거리며 제거했다.
						PRINTFORMW 「하지만 핵융합 실패율이 엄청나게 올라가버려—...」
					CASE 2
						PRINTFORML 「저기, 봐봐ー!」
						PRINTFORMDL 그녀는 몸을 돌려 망토를 나부끼게 한다.
						PRINTFORMW 「정말 멋진 망토야~♪」
						PRINTFORMDW 오쿠우가 미소를 지으며 말한다.
					CASE 3
						PRINTFORML 「내 오른발이 파괴를 상징한다니!」
						PRINTFORMW 「하지만 좀 거칠어 보이기도 하고...」
					CASEELSE
						PRINTFORML 「이것 좀 봐ー」
						PRINTFORMDL 그녀는 가슴을 내민다.
						PRINTFORML 「이게 나의 제3의 눈이야!」
						PRINTFORMW 「정확히 이해하진 못하지만 멋지다!」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「이것을 사토리님께 들었다!」
					CASEELSE
						PRINTFORMDW 당신이 그녀에게 말을 거는 동안 오쿠는 고개를 끄덕인다.
				ENDSELECT
		ENDSELECT
	ELSE
		PRINTFORMDL 오쿠는 당신이 그녀에게 이야기를 해줄 때 가끔 자신의 의견을 덧붙인다.
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「우와~ 하지만 잘 모르겠어.」
			CASE 1
				PRINTFORMW 「당신 이야기는 좀 따라가기 어렵지만... 정말 흥미롭네요!」
			CASE 2
				PRINTFORMDW 오쿠는 고개를 끄덕이며 당신의 말에 관심을 보인다.
		ENDSELECT
		PRINTFORML
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「그리고 그 다음엔 무슨 일이 일어난 거야?!」
			CASE 1
				PRINTFORML 「그리고 그리고 또―?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
