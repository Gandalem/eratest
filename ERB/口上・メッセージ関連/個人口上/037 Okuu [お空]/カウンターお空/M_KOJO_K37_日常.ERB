;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K37_303
CALL M_KOJO_MESSAGE_COM_K37_303_1
