	IF LOCAL:1 && ARG == 2
		SELECTCASE K88_KYOKO_TRYENDURE(TARGET)
			; 確率100だとまたすぐに押し倒されるよね……
			CASE 100
				PRINTFORMW 「하지만 우리는 아직 아무것도 하지 않았어…」
