	LOCAL:1 = 1
	IF LOCAL:1 && ARG == 6
		PRINTFORMW 「헤이 %MASTERNAME:88%... 아, %HE_SHE(MASTER)%는 이미 자고 있네, 그렇지 %HE_SHE(MASTER)%.」
