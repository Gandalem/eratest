		PRINTBUTTON "[お\@ TALENT:MASTER:性別 == 2 ? 兄 # 姉 \@さんと呼んでほしい]", @"お\@ TALENT:MASTER:性別 == 2 ? 兄 # 姉 \@さん"
	SIF ABL:親密 > 7
		PRINTBUTTON "[お\@ TALENT:MASTER:性別 == 2 ? 兄 # 姉 \@様と呼んでほしい]", @"お\@ TALENT:MASTER:性別 == 2 ? 兄 # 姉 \@様"
	SIF ABL:従順 > 7 && ABL:奉仕精神 > 7
		PRINTBUTTON "[ご主人様と呼んでほしい]", "ご主人様"
	SIF TALENT:恋人 && TALENT:恋慕
		PRINTBUTTON "[旦那様と呼んでほしい]", "旦那様"
	[SKIPEND]

	INPUTS
	; 行頭行尾の空白文字削除
	LOCALS = %RESULTS%
	REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
	; 2文字未満
	IF STRLENS(LOCALS) < 2
		PRINTFORMW 「I can't hear you!」
		CONTINUE
	; 10文字(全角5文字)超えた
	ELSEIF STRLENS(LOCALS) > 16
		PRINTFORMW 「Isn't it a bit long? Make it shorter!」
		CONTINUE
	; 音無響子 Maison Ikkoku reference apparently
	ELSEIF CONTAINS_NAME(LOCALS, "otonashi", "chigusa")
		PRINTFORMW 「Manager, is that you?」
		PRINTFORML
	; 惣一郎さん
	ELSEIF CONTAINS_NAME(LOCALS, "otonashi", "souichirou")
		PRINTFORMW 「Souichirou-san!!!」
		PRINTFORML
	; 五代裕作
	ELSEIF CONTAINS_NAME(LOCALS, "yuusaku", "godai")
		PRINTFORMW 「I'd rather be a bit more decisive.」
		PRINTFORML
	; 同姓同名
	ELSEIF FLAG:なりきり != [[響子]] && CONTAINS_NAME(LOCALS, "kasodani", "kyouko")
		PRINTFORMW 「Same name as me, really? It's confusing, I want to call you something else!」
		CONTINUE
	; 白蓮が主人ではなく、白蓮というフレーズが含まれている。もしくは
	; ☆が主人ではなく、寅丸もしくは星というフレーズが含まれている
	ELSEIF (FLAG:なりきり != [[白蓮]] && CONTAINS_NAME(LOCALS, "byakuren", "hijiri")) || (FLAG:なりきり != [[星]] && CONTAINS_NAME(LOCALS, "toramaru", "shou"))
		PRINTFORMW 「Are you making fun of me? That can't possibly be right!」
		CONTINUE
	; 命蓮寺勢はじき
	; うんそうだね多々良勝五郎とか教える人もいるかもしれないもんね
	ELSEIF (FLAG:なりきり != [[ナズーリン]] && CONTAINS_NAME(LOCALS, "nazrin")) || (FLAG:なりきり != [[小傘]] && CONTAINS_NAME(LOCALS, "tatara", "kogasa")) || (FLAG:なりきり != [[一輪]] && CONTAINS_NAME(LOCALS, "kumoi", "ichirin")) || (FLAG:なりきり != [[ムラサ]] && CONTAINS_NAME(LOCALS, "minamitsu", "murasa"))
		PRINTFORMW 「Are you trying to pick a fight?!」
		CONTINUE
	ELSEIF (FLAG:なりきり != [[ぬえ]] && CONTAINS_NAME(LOCALS, "nue", "houjuu")) || (FLAG:なりきり != [[マミゾウ]] && CONTAINS_NAME(LOCALS, "futatsuiwa", "mamizou"))
		PRINTFORMW 「Is it one of your disguises...? There is no way, right?」
		CONTINUE
	; 道教勢力はじき
	ELSEIF (FLAG:なりきり != [[芳香]] && CONTAINS_NAME(LOCALS, "miyako", "yoshika")) || (FLAG:なりきり != [[青娥]] && CONTAINS_NAME(LOCALS, "kaku", "seiga")) || (FLAG:なりきり != [[屠自古]] && CONTAINS_NAME(LOCALS, "soga", "tojiko")) || (FLAG:なりきり != [[布都]] && CONTAINS_NAME(LOCALS, "mononobe", "futo")) || (FLAG:なりきり != [[神子]] && CONTAINS_NAME(LOCALS, "toyosatomimi", "shoutoku", "taishi", "miko"))
		PRINTFORMW 「Aah, an invader! Repel the invaders!!!」 
		CONTINUE
	; 博麗霊夢というフレーズが含まれてる。もしくは
	; 東風谷早苗というフレーズが含まれている
	ELSEIF CONTAINS_NAME(LOCALS, "hakurei", "kochiya", "reimu", "sanae")
		PRINTFORMW 「Eeh, are you really that shrine maiden? You didn't look like one.」
		PRINTFORML
	; 霧雨魔理沙というフレーズが含まれてる。
	ELSEIF CONTAINS_NAME(LOCALS, "kirisame", "marisa")
		PRINTFORMW 「Oh, the human that seemed so unenthusiastic last time. You've got to say 'hello' louder.」
		PRINTFORML
	; 魂魄妖夢というフレーズが含まれてる。
	ELSEIF CONTAINS_NAME(LOCALS, "konpaku", "youmu")
		PRINTFORMW 「Have you stopped wielding swords?」
		PRINTFORML
	; 直接入力ならいけると思ったか？弾くぜ！
	ELSEIF ABL:親密 < 4 && STRCOUNT(LOCALS, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$")
		PRINTFORMW 「Even a yamabiko has the right to choose what to say.」
		CONTINUE
	ELSEIF ABL:親密 < 7 && STRCOUNT(LOCALS, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$")
		PRINTFORMW 「Even a yamabiko has the right to choose what to say.」
		CONTINUE
	ELSEIF (ABL:従順 < 7 || ABL:奉仕精神 < 7) && STRCOUNT(LOCALS, "((?i)master|lord|god)$")
		PRINTFORMW 「Even a yamabiko has the right to choose what to say.」
		CONTINUE
	ELSEIF (!TALENT:恋人 || !TALENT:恋慕) && STRCOUNT(LOCALS, "(?i)(husband|dear|darling|honey|hubby)$")
		PRINTFORMW 「Even a yamabiko has the right to choose what to say.」
		CONTINUE
	ENDIF
	
	PRINTFORML 「So "%RESULTS%", right?」
	CALL ASK_YN
	IF RESULT == 0
		;あなたの名前を%MASTERNAME:41%に格納
		CSTR:88:20 = %LOCALS%
		; CSTR:20とMASTERNAME:88を同期
		CALLF K88_KYOKO_CALLNAME(MASTER)
		PRINTFORMDL 
		BREAK
	ELSEIF RESULT == 1
		CONTINUE
	ENDIF
LOOP 1
RETURN 1


