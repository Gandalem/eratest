;===========================================================
; "EVENT"系イベント
;===========================================================
; 部屋で遭遇
;=================================================
@M_KOJO_EVENT_K88_1(ARG, ARG:1)
;口上主はTARGET
LOCAL = 1
IF LOCAL
	; 互換処理呼び出し
	SIF !TCVAR:351
		CALL K88_KYOKO_UPDATE
	; 書き分けが大変なのでどっちが入ってきた場合もまとめとく
	; 内部ではARGで分岐する可能性もある
	LOCAL:1 = 1
	IF LOCAL:1 && ARG
		; 仕事中(まだいっぱい)
		IF CFLAG:行動 == 5 && BASE:仕事量 > MAXBASE:仕事量 / 2 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			PRINTFORMW Kyouko is cleaning while chanting sutras rhythmically.
			PRINTFORMW It seems a bit more time is needed to finish the job.
			TCVAR:351++
		; 仕事中(もうすぐ終わる)
		ELSEIF CFLAG:行動 == 5 && BASE:仕事量 > 0 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			PRINTFORMW Kyouko is cleaning while humming a song.
			PRINTFORMW Looks like the job will end soon.
			TCVAR:351++
		; それ以外
		ELSE
			; まだ朝の挨拶してない
			IF TIME:2 <= 2 && TCVAR:今日会ったか == 1
				IF TALENT:恋慕 && RAND:2
					PRINTFORML 「Good morning!
					PRINTFORMW 　Good morning!」
					PRINTFORMW Kyouko jumps at you with a cheerful greeting like a playful puppy.
					PRINTFORMW Should you refer to her as the Good Morning Dog? You think to yourself.
					TCVAR:今日会ったか = 2
				ELSE
					PRINTFORMW 「Good morning!」
					PRINTFORMW Oh, good morning to you too.
					PRINTFORMW You also seem to be feeling pretty energetic this morning.
					TCVAR:今日会ったか = 2
				ENDIF
			; まだ昼の挨拶してない
			ELSEIF TIME:2 > 2 && TIME:2 <= 4 && TCVAR:今日会ったか <= 2
				IF TALENT:恋慕 && RAND:2
					PRINTFORMW 「Yo!!」
					PRINTFORMW %BREAKENG(@"As you admonish her for using an improper expression like that, she responds that villagers who come to the shrine to pray use it, so she was imitating them.")%
					PRINTFORMW How could someone say those kind of things around such an innocent girl?!
					IF TCVAR:今日会ったか == 2
						TCVAR:今日会ったか = 4
					ELSE
						TCVAR:今日会ったか = 3
					ENDIF
				ELSE
					PRINTFORMW 「Hello!!」
					PRINTFORMW Greetings that can make everyone smile echo around the area today as well.
					IF TCVAR:今日会ったか == 2
						TCVAR:今日会ったか = 4
					ELSE
						TCVAR:今日会ったか = 3
					ENDIF
				ENDIF
			; まだ夜の挨拶してない
			ELSEIF TIME:2 > 4 && TCVAR:今日会ったか <= 4
				IF TALENT:恋慕 && RAND:2
					PRINTFORMW 「Good evening!」
					SIF TCVAR:今日会ったか == 4
						PRINTFORMW 「Today we had a good morning and a good evening!」
					PRINTFORMW You couldn't help but admire Kyouko's smiling face.
					TCVAR:今日会ったか = 5
				ELSE
					PRINTFORMW 「Good evening-woof～!」
					PRINTFORMW %BREAKENG(@"You wonder if it would be okay to politely return her greeting with the little bark she just made, but maybe you shouldn't confuse yamabiko with strange greetings.")%
					PRINTFORMW It would definitely feel like you are stealing her identity as a yamabiko, so you greet her without barking back.
					TCVAR:今日会ったか = 5
				ENDIF
			; 既に挨拶済み
			ELSE
				IF TCVAR:351 > 8
					PRINTFORMW 「I sure am meeting you a lot today.」
					IF ARG == 2
						PRINTFORMW It seems as if Kyouko is tilting her head, but that might just be because she keeps moving around.
					ELSE
						PRINTFORMW （Maybe they are following me around?）
						PRINTFORMW For some reason, Kyouko seems to have a \@ TALENT:恋慕 ? happy # troubled \@ expression.
					ENDIF
				ELSEIF TCVAR:351 > 4
					; <工事中> 何か思いついたら後で書き直すよ
					PRINTFORMW ＼Google!／
				ELSEIF TCVAR:351 > 2
					; <工事中> 何か思いついたら後で書き直すよ
					PRINTFORMW ＼Excite!／
				ELSE
					; <工事中> 何か思いついたら後で書き直すよ
					PRINTFORMW ＼YAHOO!／
				ENDIF
			ENDIF
			TCVAR:351++
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;=================================================
; 朝起きたとき（おはよう口上）
;---------------------------------------
; 口上主はTARGET
;=================================================
@M_KOJO_EVENT_K88_2(ARG, ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	; 互換処理呼び出し
	SIF !TCVAR:351
		CALL K88_KYOKO_UPDATE
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 「Hmm... Good morning...」
			PRINTFORMW Kyouko greets you sleepily as she hides a small yawn with her hand.
			PRINTFORMW Is she half asleep? You have the impression she didn't quite recognize you.
			SETBIT TCVAR:350, (TIME:2 - 1)
			TCVAR:351++
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 「Hmm... Good morning...」
			PRINTFORMW You pat Kyouko gently on the head as she greets you sleepily with a yawn.
			PRINTFORMW 「H-Hey! What are you doing?!」
			PRINTFORMW Thanks to you she's awake, but now she's giving you a sulky look.
			SETBIT TCVAR:350, (TIME:2 - 1)
			TCVAR:351++
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

;=================================================
; 夜寝るとき（おやすみ口上）
;---------------------------------------
; 口上主はTARGET
;=================================================
@M_KOJO_EVENT_K88_3(ARG, ARG:1)
LOCAL = 1
IF LOCAL
	;自室に帰る（定時になって寝る）
	LOCAL:1 = 1
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「Good night, %MASTERNAME:88%.」
		PRINTFORMW You wish good night to each other before seeing her off to her \@ FLAG:住み込みキャラ == TARGET ? room # home \@.
		RETURN 1
	ENDIF
	
	;眠そうにしている
	LOCAL:1 = 1
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「Uuh... I'm not sleepy...」
		PRINTFORMW Kyouko responds, slurring and nodding off when you wonder if she's getting sleepy.
		PRINTFORMW No matter how you look at it, she is clearly dozing off.
		RETURN 1
	ENDIF
	
	;睡眠中（起きていないので会話というよりは寝言？）
	LOCAL:1 = 0
	IF LOCAL:1 && ARG == 3
		PRINTFORML 
		RETURN 1
	ENDIF
	
	;イタズラ中
	LOCAL:1 = 0
	IF LOCAL:1 && ARG == 4
		PRINTFORML 
		RETURN 1
	ENDIF
	
	;衰弱中
	LOCAL:1 = 1
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋慕 && FLAG:住み込みキャラ == TARGET
			PRINTFORMW 「I can't do it anymore... Can't someone carry me?」
			PRINTFORMW Kyouko slumps down and starts glancing at you with sparkling eyes.
			PRINTFORMW You chuckle a bit at her predictable behavior and proceed to carry the very light Kyouko to her room.
		ELSE
			PRINTFORMW 「I can't... Anymore...」
			PRINTFORMW Seeing Kyouko go back \@ FLAG:住み込みキャラ == TARGET ? to her room # home \@ on unsteady legs makes you a little worried.
		ENDIF
		RETURN 1
	ENDIF
	
	;MASTERがダウン（部屋まで運ばれる）
	LOCAL:1 = 1
	IF LOCAL:1 && ARG == 6
		PRINTFORMW 「Hey %MASTERNAME:88%... Ah, %HE_SHE(MASTER)%'s already asleep, isn't %HE_SHE(MASTER)%.」
