	;小分岐
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 「음... 좋은 아침이야...」
			PRINTFORMW 쿄코는 작은 하품을 손으로 감추며 졸린 듯 당신에게 인사한다.
			PRINTFORMW 그녀는 반쯤 잠들어 있는 걸까? 당신은 그녀가 당신을 완전히 알아보지 못한 것 같은 인상을 받았다.
			SETBIT TCVAR:350, (TIME:2 - 1)
			TCVAR:351++
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 「음... 좋은 아침이야...」
			PRINTFORMW 당신은 하품을 하며 졸린 목소리로 인사하는 쿄코의 머리를 부드럽게 쓰다듬는다.
			PRINTFORMW 「저-저기! 뭐 하는 거야?!」
			PRINTFORMW 덕분에 그녀는 깨어났지만, 지금은 심술궂은 눈으로 당신을 바라보고 있다.
			SETBIT TCVAR:350, (TIME:2 - 1)
			TCVAR:351++
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
