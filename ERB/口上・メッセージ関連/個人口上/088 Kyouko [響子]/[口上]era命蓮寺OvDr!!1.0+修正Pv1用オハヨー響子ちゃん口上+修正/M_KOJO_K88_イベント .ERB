@M_KOJO_EVENT_K88_1(ARG, ARG:1)
;口上主はTARGET
LOCAL = 1
IF LOCAL
	; 互換処理呼び出し
	SIF !TCVAR:351
		CALL K88_KYOKO_UPDATE
	; 書き分けが大変なのでどっちが入ってきた場合もまとめとく
	; 内部ではARGで分岐する可能性もある
	LOCAL:1 = 1
	IF LOCAL:1 && ARG
		; 仕事中(まだいっぱい)
		IF CFLAG:行動 == 5 && BASE:仕事量 > MAXBASE:仕事量 / 2 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			PRINTFORMW 쿄코는 경전을 리듬에 맞춰 외우며 청소하고 있다.
			PRINTFORMW 일을 끝내려면 시간이 좀 더 필요한 것 같다.
			TCVAR:351++
			; 仕事中(もうすぐ終わる)
		ELSEIF CFLAG:行動 == 5 && BASE:仕事量 > 0 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
			PRINTFORMW 쿄코는 노래를 흥얼거리며 청소하고 있다.
			PRINTFORMW 일이 곧 끝날 것 같다.
			TCVAR:351++
			; それ以外
		ELSE
			; まだ朝の挨拶してない
			IF TIME:2 <= 2 && TCVAR:今日会ったか == 1
				IF TALENT:恋慕 && RAND:2
					PRINTFORML 「좋은 아침!」
					PRINTFORMW 　좋은 아침!」
					PRINTFORMW 쿄코는 장난기 넘치는 강아지처럼 활기찬 인사와 함께 당신에게 뛰어든다.
					PRINTFORMW 그녀를 '좋은 아침 개'라고 부른다고 생각할까? 당신은 스스로 생각한다.
					TCVAR:今日会ったか = 2
				ELSE
					PRINTFORMW 「좋은 아침이야!」
					PRINTFORMW 오, 당신에게도 좋은 아침이에요.
					PRINTFORMW 오늘 아침에도 상당히 활기차 보이는군요.
					TCVAR:今日会ったか = 2
				ENDIF
				; まだ昼の挨拶してない
			ELSEIF TIME:2 > 2 && TIME:2 <= 4 && TCVAR:今日会ったか <= 2
				IF TALENT:恋慕 && RAND:2
					PRINTFORMW 「Yo!!」
					PRINTFORMW %BREAKENG(@"당신이 그녀에게 그런 부적절한 표현을 사용했다고 꾸짖자, 그녀는 신사에 기도하러 오는 마을 사람들이 그것을 사용한다고 답하며 자신은 그들을 흉내 냈다고 말했다.")%
					PRINTFORMW 어떻게 그런 순수한 여자 주변에서 그런 말을 할 수 있지?!
					IF TCVAR:今日会ったか == 2
						TCVAR:今日会ったか = 4
					ELSE
						TCVAR:今日会ったか = 3
					ENDIF
				ELSE
					PRINTFORMW 「안녕!!」
					PRINTFORMW 오늘 이곳에도 모두를 미소 짓게 할 인사가 울려 퍼진다.
					IF TCVAR:今日会ったか == 2
						TCVAR:今日会ったか = 4
					ELSE
						TCVAR:今日会ったか = 3
					ENDIF
				ENDIF
				; まだ夜の挨拶してない
			ELSEIF TIME:2 > 4 && TCVAR:今日会ったか <= 4
				IF TALENT:恋慕 && RAND:2
					PRINTFORMW 「좋은 저녁이에요!」
					SIF TCVAR:今日会ったか == 4
						PRINTFORMW 「오늘 우리는 좋은 아침과 좋은 저녁을 보냈어!」
					PRINTFORMW 유코는 교코의 미소 짓는 얼굴을 감탄하지 않을 수 없었다.
					TCVAR:今日会ったか = 5
				ELSE
					PRINTFORMW 「좋은 저녁이에요-멍~!」
					PRINTFORMW %BREAKENG(@"그녀가 방금 한 작은 짖음으로 정중하게 인사로 답하는 것이 괜찮을지 궁금해하지만, 아마 야마비코를 이상한 인사와 혼동해서는 안 될 것이다.")%
					PRINTFORMW 당신이 야마비코의 정체를 훔치는 것 같아 분명 기분이 나쁘므로, 당신은 그녀에게 짖지 않고 인사한다.
					TCVAR:今日会ったか = 5
				ENDIF
				; 既に挨拶済み
			ELSE
				IF TCVAR:351 > 8
					PRINTFORMW 「오늘 정말 많이 만나네요.」
					IF ARG == 2
						PRINTFORMW 교코가 고개를 기울이는 것 같지만, 그저 계속 움직이고 있기 때문일지도 모른다.
					ELSE
						PRINTFORMW (어쩌면 그들이 나를 따라다니는 걸지도?)
						PRINTFORMW 무슨 이유에서인지, 쿄코는 \@ TALENT:恋慕 ? 행복한 # 괴로운 \@ 표정을 짓고 있다.
					ENDIF
				ELSEIF TCVAR:351 > 4
					; <工事中> 何か思いついたら後で書き直すよ
					PRINTFORMW 구글!
				ELSEIF TCVAR:351 > 2
					; <工事中> 何か思いついたら後で書き直すよ
					PRINTFORMW 흥분되네!
				ELSE
					; <工事中> 何か思いついたら後で書き直すよ
					PRINTFORMW 야호!
				ENDIF
			ENDIF
			TCVAR:351++
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
