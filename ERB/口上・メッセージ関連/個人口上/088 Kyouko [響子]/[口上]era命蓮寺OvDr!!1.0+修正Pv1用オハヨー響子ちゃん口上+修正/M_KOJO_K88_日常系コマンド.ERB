;=================================================
; 414, 食事を取る
;---------------------------------------
; 414と415って差が分かりにくいよね
; あと、414も415も多人数がありえること
;=================================================
@M_KOJO_MESSAGE_COM_K88_414
CALL M_KOJO_MESSAGE_COM_K88_414_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K88_414_1
LOCAL = 1
IF LOCAL
	; 混ぜ物してない
	IF TCVAR:MASTER:308 < 8
		; 好みの味(失敗しない)
		IF CFLAG:味覚嗜好 & TCVAR:MASTER:308
			PRINTFORMW 「As I thought, the lack of proper seasoning is making the dish rather bland.」
			PRINTFORMW You finish the meal together as Kyouko was evaluating your cooking.
		; 成功
		ELSEIF TFLAG:193 == 1
			PRINTFORMW You invite Kyouko to a meal as she kept staring at you with envy.
			PRINTFORMW 「Is it fine for me to eat this? Don't mind if I do. Thanks for the food!」
		; 失敗
		ELSE
			PRINTFORMW 「%MASTERNAME:88%... Did you taste this?」
			PRINTFORMW You admit that you didn't, and Kyouko returns the plate with a stiff expression.
			PRINTFORMW 「You should really taste it next time. It's wrong to waste food like this!」
		ENDIF
	; イ・タ・ズ・ラ
	ELSE
		; 平気(甘酸)
		IF CFLAG:TARGET:味覚嗜好 & TCVAR:MASTER:308
			PRINTFORMW You watch intently with a pounding heart as Kyouko brings the food to her mouth.
			PRINTFORMW 「It was delicious. Is there something wrong, %MASTERNAME:88%?」
			PRINTFORMW You tell her you were surprised at being praised in such a calm manner.
		; ダメ(辛わさび)
		ELSE
			PRINTFORMW Kyouko lets out a shrill scream the moment she realizes that the food is \@ TCVAR:MASTER:308 & 8 ? very spicy # full of wasabi \@.
			PRINTFORMW You thought it would be funny at first, but you never thought she would really eat it...
			PRINTFORMW You decide to think about an excuse for when she calms down.
			SETBIT TCVAR:352, 2
		ENDIF
	ENDIF
ENDIF
RETURN 1

