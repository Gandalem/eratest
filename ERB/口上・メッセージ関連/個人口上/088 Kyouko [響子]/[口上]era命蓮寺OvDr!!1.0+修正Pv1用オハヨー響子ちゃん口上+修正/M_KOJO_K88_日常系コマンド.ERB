;===========================================================
; 日常系コマンド
;===========================================================
; 300, 会話
;=================================================
@M_KOJO_MESSAGE_COM_K88_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K88_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K88_300_1
LOCAL = 1
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	; 仕事中
	IF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORMW 「I'm happy to be able to talk with you, but work is important too!」
			PRINTFORMW 「Or are you going to help me?」
		ELSE
			PRINTFORMW 「If you have time to interrupt me, why don't you help me finish this faster?」
			PRINTFORMW Maybe you should help her out a bit?%COND_STR(@" Even though she really doesn't mind you distracting her...", TFLAG:193)%
		ENDIF
	; 成功
	ELSEIF TFLAG:193 != -1
		; まだ今日は一度も挨拶してない
		IF !GETBIT(TCVAR:350, 0) && !GETBIT(TCVAR:350, 1) && !GETBIT(TCVAR:350, 2)
			; <工事中> 条件。恋慕でもない時にこんなことしてたらおかしいかもしれないからね
			PRINTFORMW 「I can't believe *I* of all people forgot to greet you today!」
			PRINTFORMW Kyouko claps her hands together and pricks up her ears as she suddenly turns around to face you.
			PRINTFORMW You stare for a while at her green eyes that match the color of her hair.
			; ここから
			SELECTCASE TIME:2
				CASE 1,2
					PRINTFORMW 「Good morning!」
				CASE 3,4
					PRINTFORMW 「Hello!」
				CASEELSE
					PRINTFORMW 「Good evening!」
			ENDSELECT
			PRINTFORMW You both greet each other with a smile.
			; ここまで一文
			; 挨拶フラグたてる
			SETBIT TCVAR:350, (TIME:2 - 1)
;		; 添い寝中
		ELSEIF CFLAG:添い寝中
			; 呼び名変更はここに放り込むことにした
			IF TCVAR:353 == 0
				PRINTFORMW 「Hey %MASTERNAME:88%, don't you feel like changing your name once in a while?」
				PRINTFORMW What do you think about Kyouko's idea?
				$INPUT_LOOP_KYO0
				PRINTBUTTON "[ 0] Not really.", 0
				PRINTBUTTON "[ 1] Yeah, I do.", 1
				INPUT
				SELECTCASE RESULT
					CASE 0
						PRINTFORMW 「Okay, okay.」
						PRINTFORMW Hearing you say that you didn't feel like changing it, Kyouko accepts it without any problem.
					CASE 1
						CALL K88_KYOKO_INPUT_CALLNAME
						PRINTFORMW 「So %MASTERNAME:88% then? Got it.」
						PRINTFORMW Kyouko changes the way she refers to you.
					CASEELSE
						SIF STRLENS(@"{RESULT}")
							CLEARLINE 1
						REUSELASTLINE 
						GOTO INPUT_LOOP_KYO0
				ENDSELECT
				SETBIT TCVAR:353, 0
			ELSE
				; <工事中>
;				PRINTFORML 
			ENDIF
		; 恋慕
		ELSEIF TALENT:恋慕
			; <工事中>
;			PRINTFORML 
		; その他
		ELSE
			SELECTCASE RAND(3)
				CASE 0
					PRINTFORMW 「Why chanting sutras? Well, it's because it feels like what an initiate should do.」
					PRINTFORMW 「I can teach you if you want to!」
				CASE 1
					PRINTFORMW 「My job is to clean up at the gate. I need to be extra careful because people sometimes come in the early hours of the day.」
					PRINTFORMW 「What kind of people? Well, it could be that shrine maiden, or a magician, or even that dodgy person wielding a sword!」
				CASEELSE
					PRINTFORMW 「Everyone often get their rooms dirty, but I can't really help them all.」
					IF MAIN_MAP == 2 ;custom code
						PRINTFORMW 「But now that you live here with us too, maybe you can give them a hand once in a while?」
					ELSE
						PRINTFORMW 「Ah, if only there was someone living with us who could've helped me...」
					ENDIF
			ENDSELECT
		ENDIF
	; 失敗
	ELSE
		;good job on this one
		PRINTFORMW When you greet her, she responds in kind.
		PRINTFORMW When you chant a mantra, she responds with one of her own.
		PRINTFORMW When you ask her if she doesn't get bored, she asks you the same.
		PRINTFORMW Later, when you get uncomfortable by yourself, you try apologizing.
		PRINTFORMW When you say you're sorry, she parrots you back.
		PRINTFORMW Are you talking with your echo? No, it's Kyouko-chan!
		; 挨拶フラグたてる
		SETBIT TCVAR:350, (TIME:2 - 1)
	ENDIF
ENDIF
RETURN 1

;=================================================
; 301, お茶を淹れる
;---------------------------------------
; これも信頼が入る
; 時間制限はやっぱり初めて会ったときは辛いくらい
;=================================================
@M_KOJO_MESSAGE_COM_K88_301
CALL M_KOJO_MESSAGE_COM_K88_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K88_301_1
LOCAL = 1
IF LOCAL
	PRINTFORMW 「Are you having \@ CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ? a work break tea? # tea? \@ I will have some too!」
	PRINTFORMW Kyouko sips the teacup you hand her without hesitation.
	; 成功
	IF TFLAG:193 != -1
		PRINTFORMW 「\@ TFLAG:193 ? It was delicious # It was okay \@. Make me some more when you get the chance!」
		PRINTFORMW It seems Kyouko \@ TFLAG:193 ? really liked # liked \@ the tea.
	; 失敗
	ELSE
		PRINTFORMW ...But soon after, her face goes pale.
		PRINTFORMW 「I'm sorry, I cannot finish it.」
	ENDIF
ENDIF
RETURN 1

;=================================================
; 302, スキンシップ
;=================================================
@M_KOJO_MESSAGE_COM_K88_302
CALL M_KOJO_MESSAGE_COM_K88_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K88_302_1
LOCAL = 1
IF LOCAL
	SIF TFLAG:193 == -1
		RETURN 1
	; 仕事中
	IF CFLAG:行動 == 5
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORMW 「I'm glad to spend time with you, but I'm busy right now...」
			PRINTFORMW When you stop the skinship she frowns and complains, but when you resume her expression melts away.
			PRINTFORMW ...That's an interesting reaction, so you keep playing around with her like that.
		ELSE
			PRINTFORMW 「If you have time to interrupt me, why don't you help me finish this faster?」
			PRINTFORMW Maybe you should help her out a bit?%COND_STR(@" Even though she really doesn't mind you distracting her...", TFLAG:193)%
		ENDIF
	; 無視した
	ELSEIF GETBIT(TCVAR:352, 0)
		PRINTFORMW Kyouko is acting standoffishly, probably remembering that time you ignored her as you rushed past her.
		PRINTFORMW You make a quick excuse, claiming that you were in a hurry back then.
		PRINTFORMW 「I know you are busy, but I still miss you, you know...」
		PRINTFORMW Seeing Kyouko muttering with her ears drooping, you realize it's not a good idea to ignore her, even if you are in a hurry.
		CLEARBIT TCVAR:352, 0
	; お風呂
	; 追い出されないということはそれなりに親しいはずなので
	ELSEIF BATHCHECK(CFLAG:現在位置) ;CFLAG:現在位置 == 112 ;custom code, apply universal bath check
		PRINTFORMW As you wash Kyouko's hair, she starts making a fuss.
		PRINTFORMW 「Don't pull my ears! They are delicate! Be more gentle!」
		PRINTFORMW It's not like her hair got tangled up or something, she just wants you to take care of her ears properly.
		PRINTFORMW This time, as you gently wash every corner of her ears, her moans start echoing around the bathroom. She's clearly enjoying it.
		PRINTFORMW Honestly, it's starting to \@ GETBIT(TALENT:MASTER:性別, 1) ? give you an erection # make you all flushed \@, so she'd better give you a break here, or else...
	; 恋慕
	; <工事中>
	ELSEIF TALENT:恋慕
;		PRINTFORML 
	; 他
	; <工事中>
	ELSE
;		PRINTFORML 
	ENDIF
ENDIF
RETURN 1

