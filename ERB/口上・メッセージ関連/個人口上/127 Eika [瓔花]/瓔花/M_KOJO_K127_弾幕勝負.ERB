; Modular ERB: 個人口上/127 Eika [瓔花]/瓔花/M_KOJO_K127_弾幕勝負.ERB
;戦闘能力を上げれば戦えるはず！
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K127_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(127) == "酔いどれ" || ALCOHOL_FACE(127) == "ぐでぐで"
			PRINTFORMW 「에~? 탄막 놀이 하는 거야~?」
		ELSEIF TALENT:127:機嫌 == -1 || CFLAG:127:ブチギレ || MARK:127:反発刻印 >= 3
			PRINTFORMW 「돌 쌓는 걸 우습게 봤나아! 용서 못 해, 죽어버려!」
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「쌓아 올린 돌만큼은 자신 없는데……」
				CASE 2
					PRINTFORMW 「쌓인 돌탄을 보여줄게!」
				CASEELSE
					PRINTFORMW 「돌멩이는 맞으면 아프다고. 함부로 대하다가는 아픈 걸 보게 될 테니까!」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 0
			IF ALCOHOL_FACE(127) == "酔いどれ" || ALCOHOL_FACE(127) == "ぐでぐで"
				PRINTFORML 「아앗! 아파아아아!」
			ELSEIF TALENT:127:機嫌 == -1 || CFLAG:127:ブチギレ || MARK:127:反発刻印 >= 3
				PRINTFORML 「흐윽 흐윽 흐윽……」
			ELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「아파…… 눈물이 멈추질 않아……」
					CASEELSE
						PRINTFORML 「지... 강해...」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(127) == "酔いどれ" || ALCOHOL_FACE(127) == "ぐでぐで"
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「우갸!?」
					CASE 2
						PRINTFORML 「아우윽!?」
					CASEELSE
						PRINTFORML 「아얏! 아파아앗!」
				ENDSELECT
			ELSEIF TALENT:127:機嫌 == -1 || CFLAG:127:ブチギレ || MARK:127:反発刻印 >= 3
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「크윽...」
					CASE 2
						PRINTFORML 「너무해……」
					CASEELSE
						PRINTFORML 「우윽……」
				ENDSELECT
			ELSE
				SELECTCASE RAND:7
					CASE 1
						PRINTFORML 「앗!」
					CASE 2
						PRINTFORML 「앗!!」
					CASE 3
						PRINTFORML 「앗!」
					CASE 4
						PRINTFORML 「우와아앗!」
					CASE 5
						PRINTFORML 「꺄앗!」
					CASE 6
						PRINTFORML 「꺄악!」
					CASEELSE
						PRINTFORML 「앗!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(127) == "酔いどれ" || ALCOHOL_FACE(127) == "ぐでぐで"
				PRINTFORMW 「음~? 혹시 내가 진 거야~?」
			ELSEIF TALENT:127:機嫌 == -1 || CFLAG:127:ブチギレ || MARK:127:反発刻印 >= 3
				PRINTFORMW 「사과하는 게 먼저 아니야?」
			ELSE
				IF TALENT:127:恋慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 도깨비보다 강한 사람이잖아!」
						CASE 2
							PRINTFORMW 「크윽... %조사처리(CALLNAME:MASTER,"는")% 역시 강하네」
						CASEELSE
							PRINTFORMW 「좋아! 싸움은 끝났으니까 다음은 같이 쌓는 시간이야!」
					ENDSELECT
				ELSEIF TALENT:127:思慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「다음엔, 지지 않을 거야!……아마도」
						CASE 2
							PRINTFORMW 「오늘은 쌓기 연습 말고 탄막 대결 특훈도 해볼까아」
						CASEELSE
							PRINTFORMW 「쌓은 돌로 승부한다면 이길 수 있을 텐데!」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「너무 강해……」
						CASE 2
							PRINTFORMW 「도깨비 같은 강함이야……」
						CASEELSE
							PRINTFORMW 「크윽... 당했어...」
					ENDSELECT
				ENDIF
			ENDIF
		ELSE
			IF ALCOHOL_FACE(127) == "酔いどれ" || ALCOHOL_FACE(127) == "ぐでぐで"
				PRINTFORML 「응응~? 설마 %조사처리(CALLNAME:MASTER,"가")% 지는 거야~?」
			ELSEIF TALENT:127:機嫌 == -1 || CFLAG:127:ブチギレ || MARK:127:反発刻印 >= 3
				PRINTFORML 「승리야! 후련하다앗!」
			ELSE
				IF TALENT:127:恋慕
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「에헤? %조사처리(CALLNAME:MASTER,"를")% 이기다니」
						CASEELSE
							PRINTFORMW 「내가 이겼으니까 오늘은 같이 쌓기 놀이 하자!」
					ENDSELECT
				ELSEIF TALENT:127:思慕
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「어라? %CALLNAME:MASTER%약해졌나?」
						CASEELSE
							PRINTFORMW 「이겼다! 다음에 같이 쌓는 돌 놀이 하자」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「에헤헤……? 돌담 물아이에게 지는 게 어때?」
						CASEELSE
							PRINTFORMW 「돌의 강함을 실감하게 해주마앗!」
					ENDSELECT
				ENDIF
				TALENT:127:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
