@M_KOJO_SPEVENT_K127_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF FIRSTTIME("初告白")
			PRINTFORMW 「있잖아 %CALLNAME:MASTER%」
			PRINTFORMW 「나는 미즈코의 영이라 잘 모르는데」
			PRINTFORML 「살아있는 사람들은 함께 있으면 즐거운 사람이랑」
			PRINTFORMW 「연인이 된다는 거지?」
			PRINTFORMW 「나는 %조사처리(CALLNAME:MASTER,"랑")% 있는 게 즐거워요?」
			PRINTFORMW 「함께 쌓고 싶은 것도 있고... 그 외의 일도 같이 하면 즐겁거든요」
			PRINTFORMW 「이건 분명 사랑인 것 같아」
			PRINTFORML
			PRINTFORMW 「그러니까 만약 %조사처리(CALLNAME:MASTER,"가")% 나랑 같이 있는 게 즐겁다면」
			PRINTFORMW 「어떨까...?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「야호옷!!」
		PRINTFORMDW 에이카는 두 손을 들고 기뻐했다.
		PRINTFORMW 「이걸로 더 많은 즐거운 추억을 쌓을 수 있겠네」
		PRINTFORMW 「미즈코라서 사랑이나 연애 같은 건 모르지만」
		PRINTFORMW 「지금 %조사처리(CALLNAME:MASTER,"에게")% 느끼는 게 분명 그런 거겠지……」
		IF TALENT:127:81 == 3
			TALENT:127:81 = 0
			CALL COLORMESSAGE(@"에이카는 【인간불신】을 잃었다.",C_YELLOW,1)
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「흑흑흑... 고백이 실패하다니...」
		PRINTFORMW 「어쩔 수 없지. 다시 처음부터 쌓아 올릴 뿐이야」
		PRINTFORMW 「%CALLNAME:MASTER%……앞으로도 잘 부탁해」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
