				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSE
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「왠지 나만 주는 건 불공평하다고 생각한다.」
							PRINTFORMW 「... %조사처리(CALLNAME:MASTER,"와")%의 교환이라면 괜찮다.」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「정말 변태라니까...」
							PRINTFORMW 「네, 여기 있습니다 %UNICODE(0x2764)%」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「으으으…… 변태야……」
							PRINTFORMW 「도대체 몇 장의 팬티를 쌓아왔는지 궁금하네… 어서 해봐」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「헤, 변태! 싫다고 했잖아!」
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
