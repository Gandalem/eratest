@M_KOJO_EVENT_K127_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【キャラの自室】に戻りました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF ARG:1
			;デート中に眠くて帰って寝る（拠点キャラのみ）
			PRINTFORML 「미안해 %CALLNAME:MASTER%이제 한계다…」
			PRINTFORMW 「졸으니까 오늘은 여기까지… 후아아…」
		ELSEIF CFLAG:うふふ
			;うふふ中に眠くて自室に帰って寝る（拠点キャラのみ）
			PRINTFORML 「미안해 %CALLNAME:MASTER%, 벌써 한계야...」
			PRINTFORMW 「졸으니까 에치(애정행각)는 이제 끝이야... 후아아...」
		ELSE
			PRINTFORML 「있잖아, 졸려서 돌아갈게……」
			PRINTFORMW 에이카는 졸린 듯이 돌아갔다
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「네…… 졸려…….」
		PRINTFORMW 에이카는 이미 잠에 지쳐 눈꺼풀이 반쯤 감겨 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:9
			CASE 0
				PRINTFORML 「더는 못 쌓겠어어…… 즈즈」
			CASE 1
				PRINTFORML 「칠 코... 여덟 코... 아홉 코... 한 걸음만 더 있으면 되는데... 즈즈」
			CASE 2
				PRINTFORML 「왜…… 버린 거야…… 뼈가 없으니까...?」
			CASE 3
				PRINTFORML 「나는…… 내 이름은…… 즈즈」
			CASE 4
				PRINTFORML 「%CALLNAME:MASTER%……zzz」
			CASE 5
				PRINTFORML 「왜 안 돼…… 계속 쌓여버려…… 즈즈」
			CASE 6
				PRINTFORML 「따뜻해…… 즈즈」
			CASE 7
				PRINTFORML 「해파리……zzz」
			CASE 8
				PRINTFORML 「엄마…… 아빠…… 즈즈즈」
		ENDSELECT
		PRINTFORMW 에이카는 말다툼을 하고 있다
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;衰弱して寝る（体力500以下,うふふ時はうふふ強制終了）
	;（キャラの自室以外：～を【現在地】から【キャラの自室】に運びました）
	;（キャラの自室　　：～は疲れたと言って、横になりました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:うふふ
			;うふふ中にダウン
			PRINTFORML 「하아... 지쳤어... 더는 못 하겠어... 자고 싶어...」
		ELSE
			PRINTFORML 「피곤해읏... 자고 싶어...」
		ENDIF
		PRINTFORMW 에이카는 흙빛 피부색을 더욱 나쁘게 하고 있었다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「괜, 괜찮아?! 시체처럼 되어버렸잖아?!」
		PRINTFORML 「아…… 이건 안 되네. 어쩔 수 없지. 데리고 가 줄게」
		PRINTFORMW 쓰러진 %조사처리(CALLNAME:MASTER,"는")% 에이카에게 방까지 운반되었다
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			PRINTFORML 「잘 자요~」
			PRINTFORMDW 에이카는 아끼는 해파리 파자마로 갈아입고 옆으로 누워 몸을 동그랗게 말고 있었다.
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORML 「음~ 좀 더 놀고 싶은데…… 졸려……」
				PRINTFORMW 「잘 자요—」
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				PRINTFORML 「음~ 조금 더 야한 거 하고 싶은데... 졸려...」
				PRINTFORMW 「잘 자요~」
			ELSE
				PRINTFORML 「음~ 좀 더 놀고 싶은데…… 졸려……」
				PRINTFORMW 「그럼 나중에 나가서 봐, 잘 자~」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			IF TALENT:恋人
				PRINTFORMW 「저기 %CALLNAME:MASTER%. 뭐 하는 거야?」
				PRINTFORMW 정사 도중에 익숙한 목소리가 들려 돌아보니 그곳에는 에이카가 있었다.
				PRINTFORML 「저기, 여기 내 방인데…… 연인의 방에 다른 애를 데려오다니… 너무 심했잖아」
				PRINTFORML 「…… 그리고 혹시 아이 같은 건 만들지 않겠지?」
				PRINTFORMW 어떻게든 사과하며 그 자리를 무마했지만, 에이카는 토라져서 잠들어 버렸다.
			ELSEIF TALENT:恋慕
				PRINTFORMW 「저기 %CALLNAME:MASTER%. 뭐 하는 거야?」
				PRINTFORMW 정사 도중에 익숙한 목소리가 들려 돌아보니 그곳에는 에이카가 있었다.
				PRINTFORML 「저기, 여기 제 방인데… 여긴 유흥업소가 아니잖아요?」
				PRINTFORMW 어떻게든 사과하며 상황을 수습했지만, 에이카는 토라진 채 잠들어 버렸다.
			ELSE
				PRINTFORMW 「있잖아 %CALLNAME:MASTER%. 뭐 하고 있는 거야?」
				PRINTFORMW 정사 도중에, 익숙한 목소리가 들려 돌아보니 그곳에는 에이카가 있었다.
				PRINTFORML 「저기, 여기 제 방인데… 뭐 하는 거예요?」
				PRINTFORML 「남의 방이라며 거리낌 없이 몰아붙이면 원치 않는 아이라도 생길 것 같아」
				PRINTFORMW 「그런 불쌍한 아이들을 늘리지 않도록 자제해 줘」
				PRINTFORMW 에이카는 이쪽에게 설교를 한 뒤, 지쳤는지 잠이 들었다.
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;来訪キャラが拠点で休憩（～は疲れ切っている→ちょっと休んでいきなよ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝室に居る状態でその場で寝る（～は眠気に負け、眠りについた…）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF TALENT:愛欲 || TALENT:セフレ
			PRINTFORML 「음~ 조금 더 야한 거 하고 싶은데... 졸려...」
			PRINTFORMW 「잘 자요~」
		ELSE
			PRINTFORML 「음~ 좀 더 놀고 싶은데…… 졸려……」
			PRINTFORMW 「잘 자요—」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
