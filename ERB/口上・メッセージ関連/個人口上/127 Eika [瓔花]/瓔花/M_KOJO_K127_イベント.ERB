	CALL ASK_YN("네","지금은 안 돼")
	SELECTCASE RESULT
		CASE 0
			PRINTFORML
			CALL ASK_M("그녀가 사산이라면 그렇게 클 리 없잖아, 그치? (기본값)", 1, "그녀는 사산된 영혼들의 지도자이니, 엄마 같은 큰 가슴을 가지고 있어야 한다!", 1, "그녀는 작고 아기라서 모두가 아기는 납작하다고 알고 있다!", 1, "음, 그녀가 조금 활기차다고 할까, 어때?", 1)
			SELECTCASE RESULT
				CASE 0
					PRINTFORMW 에이카의 가슴은 크지도 작지도 않고 그냥 평범하다.
					TALENT:127:バストサイズ = 0
				CASE 1
					PRINTFORMW 가슴 큰 에리카!
					TALENT:127:バストサイズ = 1
				CASE 2
					PRINTFORMW 맛있는 평평한 가슴!
					TALENT:127:バストサイズ = -2
				CASE 3
					PRINTFORMW 이제 제대로 말하는군! 통통하고 작네!
					TALENT:127:バストサイズ = -1
			ENDSELECT
		CASE 1
			PRINTFORMW 이카의 가슴 크기는 나중에 정하자.
	ENDSELECT
ENDIF
