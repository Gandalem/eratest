;デート帰り
;==================================================

@M_KOJO_SPEVENT_K127_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF TALENT:127:機嫌 == -1 || CFLAG:127:ブチギレ || MARK:127:反発刻印 >= 3
			PRINTFORMW 「변! 너 같은 건 지옥에나 떨어져라―!」
			PRINTFORMW 에이카는 헤어지기 직전에도 기분이 좋지 않았다...
		ELSEIF TALENT:恋慕
			PRINTFORMW 「후후후... 오늘은 쌓아 올린 돌보다 더 즐거웠을지도」
			PRINTFORMW 에이카는 아쉬운 듯 %조사처리(CALLNAME:MASTER,"를")% 한 번 바라본 뒤, 안쪽 길 쪽으로 향했다.
			PRINTFORMW 「잘 가~!」
		ELSEIF TALENT:思慕
			PRINTFORMW 「오늘은 즐거웠어. 또 불러줘!」
			PRINTFORMW 에이카는 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들며, 중의 길 쪽으로 향했다
		ELSE
			PRINTFORMW 「오늘은 즐거웠어. 다음엔 쌓기 놀이도 하자!」
			PRINTFORMW 에이카는 그렇게 말하며, 안쪽의 길 쪽으로 향했다
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「어쩔 수 없지. 용서해 줄게」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「어쩔 수 없네. 조금은 용서해 주지」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「어쩔 수 없네. 아주 조금 용서해 줄게」
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
