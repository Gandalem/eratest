				PRINTFORMW 
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORML 「무겁다…….」
				PRINTFORML 「이것이 %조사처리(CALLNAME:MASTER,"의")% 나에 대한 사랑인가…….」
				PRINTFORMW 
				RETURN 1
			ELSE
				PRINTFORML 「대단하네……」
