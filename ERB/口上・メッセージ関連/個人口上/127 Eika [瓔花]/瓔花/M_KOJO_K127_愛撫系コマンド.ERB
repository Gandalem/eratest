@M_KOJO_MESSAGE_COM_K127_0
CALL M_KOJO_MESSAGE_COM_K127_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K127_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「햐앙%UNICODE(0x2764)%쿠... 간지러워...」
			PRINTFORML 「야앗%UNICODE(0x2764)%는 가려우니까 만지지 마...」
			PRINTFORMW 에이카는 머리를 세차게 흔들며 애무를 거부하려 했다.
			PRINTFORML 「얀%UNICODE(0x2764)%은 윽%UNICODE(0x2764)%」
			PRINTFORMW 그 거부를 무시하고 애무를 계속하자, 에이카의 목소리가 달콤해져 갔다...
			PRINTFORMW 「힝%UNICODE(0x2764)% 뭔가 이상한 느낌이야...」
		ELSE
			PRINTFORML 「꺅! 간... 가려워...」
			PRINTFORML 에이카는 갑자기 몸을 만지자 몸을 비틀며 괴로워한다.
			PRINTFORMW 잠시 몸을 경직하고 있었지만, 이내 몸의 힘을 풀었다.
			PRINTFORML 「하아~ 마음껏 만져도 돼」
			PRINTFORMW 그 말을 기다렸다는 듯, %조사처리(CALLNAME:MASTER,"는")% 애무를 재개했다.
			PRINTFORMW 수자 특유의 흙빛 피부 위로 손가락을 움직이자, 체념한 듯한 표정과는 달리 목소리가 달콤해져 간다...
			PRINTFORMW 「히끅%UNICODE(0x2764)% 뭔가 이상해...」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「얀읏……%UNICODE(0x2764)% 핥는 거 간지러워요%UNICODE(0x2764)%」
				PRINTFORMW 에이카의 차가운 몸을 애무하며 핥자, 에이카는 움찔하며 몸을 떨었다.
			CASE 1
				PRINTFORMW 「앙! %UNICODE(0x2764)%는 으윽! 만지는 방식이 야해...」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 질척하게, 미즈코의 소녀의 피부를 만끽했다...
			CASE 2
				PRINTFORMW 「응읏…%UNICODE(0x2764)%거기! %UNICODE(0x2764)%재촉하지 마아앗%UNICODE(0x2764)%」
				PRINTFORMW 미즈코 특유의 흙빛 피부를 손가락으로 쓸어내리며, 성감대는 건드리지 않고 주변을 자극했다…
			CASE 3
				PRINTFORMW 「앙! %UNICODE(0x2764)%응응%UNICODE(0x2764)%더 만져줘…%UNICODE(0x2764)%」
				PRINTFORMW 부드러운 에이카의 몸을 즐기듯 전신을 애무해 나갔다.
			CASEELSE
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 손…… 따뜻해…… 그리고 축축해…… %UNICODE(0x2764)%」
				PRINTFORMW 에이카의 차가운 몸을 즐기듯 온몸을 애무하기 시작했다…
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「큭…%UNICODE(0x2764)% 핥아주는 거 즐거워...?」
				PRINTFORMW 에이카의 차가운 몸을 애무하며 핥자, 에이카는 움찔과 함께 몸을 떨었다.
				PRINTFORMW 「후우…… 기분은 좋지만 역겨워……」
			CASE 1
				PRINTFORMW 「응앗%UNICODE(0x2764)%은 으윽%UNICODE(0x2764)% 만지는 방식이 야해……」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 질척하게, 물의 소녀의 피부를 마음껏 음미했다…
			CASE 2
				PRINTFORMW 「하아…… 조금은 신뢰하고 있었는데 말이야……응읏%UNICODE(0x2764)%」
				PRINTFORMW 에이카는 소소한 반항으로 소리를 내지 않으려고 했지만, 그럼에도 %조사처리(CALLNAME:MASTER,"의")% 애무에 목소리는 새어 나오고 있었다…
			CASE 3
				PRINTFORMW 「응앗%UNICODE(0x2764)%응ㅇ%UNICODE(0x2764)%미즈코의 몸 같은 거 만져봤자 재미없잖아……」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 그런 적 없다고 말하며, 부드러운 에이카의 몸을 즐기듯 온몸을 애무해 나갔다…
			CASEELSE
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 손... 따뜻해... 그리고 축축해...」
				PRINTFORMW 에이카는 차가운 몸을 즐기듯 온몸을 애무했다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
