@M_KOJO_MESSAGE_COM_K127_1
CALL M_KOJO_MESSAGE_COM_K127_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K127_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「소, 거긴 안 돼!」
			PRINTFORMW 에이카는 제지하려 손으로 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 밀쳐내려고 했다.
			PRINTFORMW 「더럽다고… 응앗%UNICODE(0x2764)% 안 돼!%UNICODE(0x2764)%」
			PRINTFORMW 하지만 쾌락에 져버린 것인지, 정신 차려보니 제지를 멈추고 쾌락에 몸을 맡기고 있었다.
		ELSE
			PRINTFORMW 「저, 거긴 안 돼앳!」
			PRINTFORMW 에이카는 제지하려 손으로 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 밀쳐내려 했다.
			PRINTFORMW 「더럽다니……응앗%UNICODE(0x2764)%」
			PRINTFORMW 하지만 소용없다는 것을 깨달았는지 곧 제지를 멈췄다…
		ENDIF
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「야응%UNICODE(0x2764)% 굉장하게 질척거리는 소리가 나…….」
				PRINTFORMW 「음란한 애 같아서 부끄럽네……」
			CASE 1
				PRINTFORMW 「괜찮아? 그…… 맛 같은 건……」
				PRINTFORMW 「맛있지 않아? 최악이야! 그런 부분은 좀 얼버무려야 하는 거잖아!」
			CASE 2
				PRINTFORMW 「응읏... %UNICODE(0x2764)%거기... %UNICODE(0x2764)%재촉하지 말아줘읏%UNICODE(0x2764)%」
				PRINTFORMW 「그래... 핥는 거라면... 거기이... %UNICODE(0x2764)%」
			CASE 3
				PRINTFORMW 「앙! %UNICODE(0x2764)%응응! %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 「안쪽까지 혀가 들어와버렸어… 응! %UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「싫어어... 간지러워...」
				PRINTFORMW 「기분은 좋지만... 이상한 기분이야......」
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「굉장히 축축한 소리가 난다...」
				PRINTFORMW 「에치한 아이 같아서 조금 부끄러울지도 모르겠다...」
			CASE 1
				PRINTFORMW 「괜찮아? 그…… 맛 같은 거……」
				PRINTFORMW 「맛있진 않은 거야? 후우, 그럼 핥는 거 그만두면 좋을 텐데…」
			CASE 2
				PRINTFORMW 「하아... 조금은 믿고 있었는데 말이야... 설마 이럴 줄은 몰랐어... 읍!%UNICODE(0x2764)%」
				PRINTFORMW 에이카는 작은 반항심으로 소리를 내지 않으려 노력했으나, 그럼에도 %조사처리(CALLNAME:MASTER,"의")% 혀놀림에 목소리는 새어나오고 있었다...
			CASE 3
				PRINTFORMW 「앗……응응읏%UNICODE(0x2764)%」
				PRINTFORMW 「안까지 혀가 들어와서…응읏%UNICODE(0x2764)%」
			CASEELSE
				PRINTFORMW 「싫어어... 간지러워...」
				PRINTFORMW 「기분 좋냐고 하면 뭐 그렇긴 한데... 이상한 느낌이야...」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
