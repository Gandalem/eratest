@M_KOJO_MESSAGE_COM_K127_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			IF TALENT:バストサイズ > 0
				PRINTFORMW 미즈코에게 너무 어울리지 않는 가슴을 %조사처리(CALLNAME:MASTER,"는")% 만지작거렸다.
				PRINTFORMW 「역시 다들 가슴 좋아하는구나~」
				PRINTFORMW 「나도… 아니, 미즈코는 모두 좋아해」
				PRINTFORMW 「우유 마시고 싶어도 죽어버렸으니까 말이야」
				PRINTFORMW 「그래서 괜찮아! 마음껏 만져줘%UNICODE(0x2764)%好きなだけ弄て%UNICODE(0x2764)%」
			ELSE
				PRINTFORMW 에이카는 적당한 크기의 가슴을 %조사처리(CALLNAME:MASTER,"가")% 만지작거렸다.
