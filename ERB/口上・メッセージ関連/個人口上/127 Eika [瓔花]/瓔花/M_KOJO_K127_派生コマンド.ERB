; Modular ERB: 個人口上/127 Eika [瓔花]/瓔花/M_KOJO_K127_派生コマンド.ERB
;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K127_6
CALL M_KOJO_MESSAGE_SCOM_K127_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K127_6_1
;custom code, moved from M_KOJO_MESSAGE_COM_K127_72
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「응, 응! 거기야...」
				PRINTFORML 「너무 기분 좋아져 버리니까 안 돼...」
				PRINTFORMW 
			CASE 1
				PRINTFORML 「흐으응, %UNICODE(0x2764)%%UNICODE(0x2764)%음! 너무 기분 좋아서 이상한 목소리가 나와버렸어...」
			CASE 2
				PRINTFORML 「아앗%UNICODE(0x2764)%%UNICODE(0x2764)%아앗%UNICODE(0x2764)%%UNICODE(0x2764)%거기욧%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%거기욧」
				PRINTFORMW 
			CASEELSE
				CALL EIKA_SEX
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「응읏%UNICODE(0x2764)%응읏%UNICODE(0x2764)%네치고 기분 좋은 곳을 노리고……」
				PRINTFORMW 
			CASE 1
				PRINTFORML 「하아응%UNICODE(0x2764)%음!%UNICODE(0x2764)%이상한 소리가 나버렸어……」
				PRINTFORMW 
			CASE 2
				PRINTFORML 「후우… %UNICODE(0x2764)%응읏%UNICODE(0x2764)%……응읏%UNICODE(0x2764)%」
				PRINTFORMW 
			CASEELSE
				CALL EIKA_SEX
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
