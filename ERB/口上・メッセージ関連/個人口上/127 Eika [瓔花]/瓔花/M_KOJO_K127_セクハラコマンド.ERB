@M_KOJO_SUCCESS_COM_K127_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K127_310
CALL M_KOJO_MESSAGE_COM_K127_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K127_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……혹시 하고 싶은 거야?」
				PRINTFORML 에이카는 %조사처리(CALLNAME:MASTER,"를")% 올려다보며 중얼거렸다.
				PRINTFORMW 어딘가 기대하는 듯한 눈으로 응시하고 있다...
			CASE 1
				PRINTFORML 에이카의 작고 부드러운 엉덩이를 쓰다듬으며 그녀를 끌어안았다.
				PRINTFORMW 「엣찌…… 벌써…… 어쩔 수 없네」
			CASEELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 엉덩이를 쓰다듬자 에이카는 몸을 맡겼다...
				PRINTFORMW 「나 만지고 싶어...? ……좋아」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「야한 건…… 안 돼...?」
				PRINTFORMW 에이카는 양손의 검지 손가락을 얼굴 앞에서 작게 교차시켰다.
			CASE 1
				PRINTFORML 「꺅! 이제…… 방심하면 안 되네……」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 에이카의 조금 큰 엉덩이를 만끽했다…
			CASEELSE
				PRINTFORML 「앉아 있는 사람도 엉덩이 쓰다듬는 기술을 다른 데 쓰는 게 좋을 것 같은데…」
				PRINTFORMW 돌에 앉은 에이카는 엉덩이를 쓰다듬는 %조사처리(CALLNAME:MASTER,"에게")% 어이없다는 표정이다
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「캬앗! 뭐 하는 거야!」
				PRINTFORMW 에이카는 화를 내며 작은 돌멩이를 던져 왔다……
			CASE 1
				PRINTFORML 「그런 짓을 하는 거구나…… 지옥에라도 떨어져 버려라……」
				PRINTFORMW 에이카는 꾸짖는 듯한 눈으로 응시하고 있다.
			CASEELSE
				PRINTFORML 「돌에 앉아 있는데 엉덩이를 쓰다듬는 듯한 감촉이…!? 어떻게…?」
				PRINTFORMW 에이카는 놀란 얼굴로 이쪽을 보고 있다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
