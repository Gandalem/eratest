; Modular ERB: 個人口上/127 Eika [瓔花]/瓔花/M_KOJO_K127_依頼.ERB

@M_KOJO_IRAI_K127(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				CASE "一般依頼名"
					SELECTCASE SCENE
						CASE "依頼提示時"
							;依頼を持ちかけられる時
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")% 부탁하고 싶은 게 있는데 괜찮아?」
							PRINTFORML 「이런 걸 부탁하고 싶어서……」
						CASE "依頼非受託時"
							;内容だけ見て受託しなかった時
							PRINTFORML 「착한 일을 꾸준히 쌓지 않으면 분명 후회하게 될 거야…… 죽을 때 같은 순간에 말이야」
						CASE "依頼受託時"
							;依頼を受託した時
							PRINTFORML 「나는 아이들 상태 봐야 해서 바쁘니까 잘 부탁해~」
						CASE "依頼確認時"
							;[366]で依頼内容を依頼人に確認した時
							PRINTFORML 「벌써 끝났어? 응? 한 번 더 듣고 싶은 거야? 미즈코보다 기억력이 없다는 소리는 심한데」
						CASE "依頼破棄時"
							;受託した依頼を破棄する時
							PRINTFORML 「하아~ %CALLNAME:MASTER%에게는 무리였나아……」
						CASE "依頼実行直前"
							;[367]で依頼を実行する時、実行処理の前に呼び出される
						CASE "依頼実行直後"
							;[367]で依頼を実行する時、実行処理の後に呼び出される
						CASE "成功報告時"
							;報告時（成功）
							PRINTFORML 「네! 고마워요. 선행을 쌓는 건 사후를 위해 중요하니까…… 뭐, 아무리 선행해도 부모님보다 먼저 죽으면 삼도강 확정인데」
						CASE "失敗報告時"
							;報告時（失敗）
							;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
							PRINTFORML 「……%조사처리(CALLNAME:MASTER,"를")% 믿고 부탁했는데」
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		;固有依頼
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;個々の依頼名で分岐
			;SCENEのWAITに関する仕様
			;WAIT無しでよい　　　　："依頼提示時", "依頼非受託時", "依頼確認時", "依頼破棄時", "成功報告時", "失敗報告時"
			;
			;以下の2つは実際にはCARRYOUTでの地の文処理との比較検討が必要
			;WAITを入れたほうが適切："依頼実行直前", "依頼実行直後"
			CASE "固有依頼名"
				SELECTCASE SCENE
					CASE "依頼提示時"
						;依頼を持ちかけられる時
					CASE "依頼非受託時"
						;内容だけ見て受託しなかった時
					CASE "依頼受託時"
						;依頼を受託した時
					CASE "依頼確認時"
						;[366]で依頼内容を依頼人に確認した時
					CASE "依頼破棄時"
						;受託した依頼を破棄する時
					CASE "依頼実行直前"
						;[367]で依頼を実行する時、実行処理の前に呼び出される
					CASE "依頼実行直後"
						;[367]で依頼を実行する時、実行処理の後に呼び出される
					CASE "成功報告時"
						;報告時（成功）
					CASE "失敗報告時"
						;報告時（失敗）
						;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
				ENDSELECT
		ENDSELECT
	CASE "TARGET"
		;ここで表示されるSCENEは"依頼実行直前", "依頼実行直後"だけです
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
					;人物が鍵になっていた・もしくは場所にたまたま居合わせた
					SELECTCASE SCENE
						;TARGETが呼ばれるのはこのタイミングだけ
						CASE "依頼実行直前"
						CASE "依頼実行直後"
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE CSVCALLNAME(CLIENT_ID)
			;依頼者のCALLNAMEによる分岐（CSV準拠）
			CASE "依頼者"
				SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
					CASE "固有依頼名"
						SELECTCASE SCENE
							CASE "依頼実行直前"
							CASE "依頼実行直後"
						ENDSELECT
				ENDSELECT
		ENDSELECT
	CASE "NO_REPORT"
		;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
		;ここで表示されるSCENEは"依頼報告不要"だけです
		;SCENEが一つしか無いので分岐は不要
		;また、必ず依頼主の口上が呼ばれます
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
				CASE "お花に水をあげて"
				CASE "誰かの落とし物"
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			CASE "固有依頼名"
		ENDSELECT
ENDSELECT
