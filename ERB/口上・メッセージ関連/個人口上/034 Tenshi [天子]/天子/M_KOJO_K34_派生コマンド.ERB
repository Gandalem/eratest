;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K34_6
CALL M_KOJO_MESSAGE_SCOM_K34_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K34_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「바로 거기야%UNICODE(0x2764)% 정말 좋아~%UNICODE(0x2764)% 나 받아낼 수 있어, 머리가 다 이상해져가네%UNICODE(0x2764)%%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORML 「나 터질 거야%UNICODE(0x2764)% 와르르 무너져 내려～%UNICODE(0x2764)%」
			PRINTFORML 「거기 있어, 괜찮아%UNICODE(0x2764)% 안 돼%UNICODE(0x2764)% 나 괴롭히지 마%UNICODE(0x2764)%%UNICODE(0x2764)%」
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	IF TCVAR:140
		PRINTFORML 「하아우%UNICODE(0x2764)% 그 느낌 너무 좋아~%UNICODE(0x2764)% 더 괴롭혀봐%UNICODE(0x2764)%%UNICODE(0x2764)%」
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「나의 약한 스폿을 핥아줘, 응~」
			CASE 1
				PRINTFORML 「좋아, 미치도록 오르려고 해%UNICODE(0x2764)% 이상한 기분이야... 또 갈 것 같아%UNICODE(0x2764)%%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K34_{SELECTCOM}_1
RETURN 1
