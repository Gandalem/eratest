;7,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K34_7
CALL M_KOJO_MESSAGE_SCOM_K34_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K34_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「정말 굉장해, 내 자궁에 키스하는구나」
		RETURN 1
	ENDIF
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORML 「하아ㄴ호오%UNICODE(0x2764)% 방금 왔는데 거기다 나한테 하면 미쳐버릴 거야 아아아흐으%UNICODE(0x2764)%%UNICODE(0x2764)%」
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	IF TCVAR:140
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「히아아악?! 너무 깊숙이 들어와 있어...%UNICODE(0x2764)%」
				PRINTFORMW 「이거 굉장해, %MOAN("h")%%UNICODE(0x2764)%」
				PRINTFORMW 「후아아앙! 이대로 가다간 미치겠어%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 1
				PRINTFORMW 「흐으, %MOAN("h")%, 히야아아%UNICODE(0x2764)%」
				PRINTFORMW 「내 자궁이, 널 밀어 올리고 있어%UNICODE(0x2764)%」
				PRINTFORMW 「흐으으! 나 이상해지고 있어%UNICODE(0x2764)%%UNICODE(0x2764)%」
		ENDSELECT
	ELSEIF TALENT:78
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「아아, %MOAN("h")%, 나의 자궁이 침범당하고 있어...」
				PRINTFORMW 「히아안, %MOAN("h")%... 푸아안!」
				PRINTFORMW (너무 커... 더는 못 견디겠어...)
			CASE 1
				PRINTFORMW 「%MOAN("h")%! 너무 깊숙이 들어왔어!」
				PRINTFORMW 「너무 좋아! 더 깊이 박아줘!」
			CASE 2
				PRINTFORMW 「후아아앙! 내 배 깊숙한 곳에! 너무 뜨거워, 정말 기분 좋아!」
				PRINTFORMW 「%MOAN("h")%, 하아아악!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「아아음 깊게―」
			CASE 1
				PRINTFORML 「쇼 비그%UNICODE(0x2764)% 더 모~%UNICODE(0x2764)% 소 구우드%UNICODE(0x2764)% 아이 러브 잇%UNICODE(0x2764)%%UNICODE(0x2764)%」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K34_{SELECTCOM}_1
RETURN 1
