@M_KOJO_MESSAGE_COM_K34_20
CALL M_KOJO_MESSAGE_COM_K34_20_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「흐응, 무...음!」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「음... %RANDKISS("kiss")%... 하아앙...%UNICODE(0x2764)%」
		PRINTFORMW 「아니야... 전혀 부족해...」
		PRINTFORMW 「더... 더 줘...%UNICODE(0x2764)%%UNICODE(0x2764)%」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
