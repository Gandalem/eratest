@M_KOJO_MESSAGE_COM_K34_0
CALL M_KOJO_MESSAGE_COM_K34_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORMDW 시간이 멈춘 고요한 세계가 당신을 감싸자, 당신은 천사의 몸을 어루만진다.
			PRINTFORMDW 응답은 없었지만, 당신은 그녀의 몸이 조금 떨리고 있음을 겨우 느낄 수 있다고 생각한다...
		ELSE
			PRINTFORMW 「스-그곳이 이--하아...! 하안%UNICODE(0x2764)%」
			PRINTFORMDW 천사는 모든 건드림과 자극에 민감하게 반응했다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 「하아우%UNICODE(0x2665) *1% 아안%UNICODE(0x2665) *1% 아아%UNICODE(0x2665) *1%」
			PRINTFORMDL 천사는 자신의 온몸에 주어지는 쾌감에 달콤하게 반응한다.
			PRINTFORMDW 정액이 그녀의 자궁에서 넘쳐흘러, 복부 아래와 다리를 끈적한 페인트 코트로 뒤덮는다...
			PRINTFORMW 「%CALLNAME:MASTER%%UNICODE(0x2665) *1% %CALLNAME:MASTER%%UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 「후우... 그만해~ %UNICODE(0x2665) *1%... 저-거리가 내 약한 곳이야...%UNICODE(0x2665) *1%」
			PRINTFORMDW 천사의 항의를 들으며, 당신은 그 부위에 집중하기로 결정한다...
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「아아아악...」
			PRINTFORMW 「당신의 손만으로는 더는 견딜 수가 없어...%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쿠우... 더... 많이 만져줘...」
		ELSE
			PRINTFORMW 「야, 하아... 아앙!」
			PRINTFORMW 「그만해... 부서질 것 같아...」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「흐으, 나 한계야...」
			PRINTFORMW 「서두르지 마, 그냥 안아줘...%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMDW 그녀를 어루만지는 것을 멈추면, 천사는 계속해 달라고 애원한다...
			PRINTFORMW 「멈추고 싶지 않아... 더 원해...」
		ELSE
			PRINTFORMW 「히이! 아니, 거긴 안 돼... 너무 좋아...%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「잠깐, 어디를 만지는 거야...아운~」
			PRINTFORMDW 그녀에게 좀 더 공격적으로 애무하면 천사의 저항이 녹는다...
		ELSEIF RAND:2 == 0
			PRINTFORMW 「나 너무 거칠게 하지 마...」
		ELSE
			PRINTFORMW 「음... 좀 더 부드럽게 부탁해...」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
