;23,ピロートーク
;==================================================

@M_KOJO_MESSAGE_COM_K34_23
CALL M_KOJO_MESSAGE_COM_K34_23_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_23_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;失敗
	IF TFLAG:193
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		SELECTCASE IFRAND("0TO3", 1, "D3", !EX:膣内精液 && !EX:アナル内精液) ;make sure tenshi has some cum in her
			CASE 3
				PRINTFORML 
				PRINTFORMW 「하아, 하아... 잠깐 쉬고 싶어?」
				PRINTFORMW 「응... 그럼 잠시 쉬자...」
				PRINTFORMW 「...아무튼... 후후, 내 배가 속까지 가득 차 버렸어...」
				PRINTFORMDW 텐시는 기쁘게 그녀의 아랫배를 누른다...
				PRINTFORMDW 꾸르륵 소리와 함께 정액이 그녀의 아래 구멍에서 넘쳐흐른다...
				PRINTFORMW 「아, 아깝네...」
				PRINTFORMDW 그녀는 흘러넘치는 정액을 손가락으로 떠서 입에 가져간다...
				PRINTFORMW 「음... 맛있다...」
			CASE 2
				PRINTFORML 
				PRINTFORML 「우후후... 정말 따뜻해...」
				PRINTFORMDW 당신은 천사를 무릎에 안고 그녀의 머리를 쓰다듬었다.
				PRINTFORMDW 그녀는 뒤로 기대며 당신에게 미소를 지었고, 자신을 당신에게 맡겼다.
				PRINTFORMDW 잠시 당신을 바라본 후, 그녀는 수줍게 눈을 감고 얼굴을 당신 쪽으로 가까이 가져왔다...
				PRINTFORMDW 그리고 두 사람 사이의 거리는 제로가 되었다...
				PRINTFORML 「음... 음...? 우우... 장난치지 마...」
				PRINTFORMDW 당신은 은밀하게 천사의 입술에 검지손가락을 갖다 댔다...
			CASE 1
				PRINTFORML 
				PRINTFORMDW 당신과 텐시는 서로 몸을 얽고 앉아 서로의 눈을 응시한다...
				PRINTFORMW 「...우후후.」
				PRINTFORMDW 결국, 텐시는 눈을 감고 얼굴을 당신에게 가까이 가져온다...
				PRINTFORMDW 당신도 똑같이 하고, 이내 두 사람의 입술이 맞닿는다.
			CASE 0
				PRINTFORML 
				PRINTFORMDW 당신은 센시를 무릎에 앉히고 그녀는 기분 좋게 놀란 표정을 짓는다.
				PRINTFORMDW 그녀는 즉시 당신을 끌어안으며 눈에 즐거운 빛을 띠고 당신을 올려다본다.
				PRINTFORMW 「음, 따뜻해... 이렇게 해주니까 너무 행복해진다...」
				PRINTFORMDW 그리고 만족스럽게 몸을 파묻는 그녀의 작은 몸을 느끼며 당신은 센시의 심장이 조금 더 빠르게 뛰기 시작하는 것을 느낀다...
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 3
				PRINTFORML 
				PRINTFORMW 「우후후, 이거 정말 좋다♪」
				PRINTFORMDW 천사는 당신의 무릎 베개를 행복하게 즐긴다...
			CASE 2
				PRINTFORML 
				PRINTFORMW 「너의 몸은, 따뜻해...」
				PRINTFORMDW 센시는 만족스럽게 너에게 기대어, 너의 체온을 받는다...
			CASE 1
				PRINTFORML 
				PRINTFORMW 「음? ...우후후♪」
				PRINTFORMDW 당신은 그녀의 머리를 쓰다듬고, 천사의 눈이 기쁨에 절반쯤 감긴다...
			CASE 0
				PRINTFORML 
				PRINTFORMDW 당신은 천사의 길고 호화로운 머리카락을 부드럽게 쓰다듬는다...
				PRINTFORMW 「우후후... ...어떻게 된 일인지, 나를 예뻐해 주면 정말 행복해져요...」
		ENDSELECT
	ELSEIF TALENT:思慕
		PRINTFORMW 「흠, 무슨 일이야?」
		PRINTFORMW 「아니, 난 싫지 않아... 기쁘니까 네가 이걸 더 자주 해주길 바라는 거야...」
	ELSE
		PRINTFORMW 「...쉬는 건 좋지만, 알몸으로 있을 때는 긴장을 풀기 힘들다...」
	ENDIF
ENDIF
RETURN 1
