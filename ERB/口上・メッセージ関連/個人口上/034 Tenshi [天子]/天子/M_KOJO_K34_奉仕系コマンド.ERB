;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K34_80
CALL M_KOJO_MESSAGE_COM_K34_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「내 손이요? 내 손으로 당신의 그것을 문지르길 원해요?」
		PRINTFORMW 「Y-Yes, I'll give it a try...」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「괜찮아, 파프파파~♪」
		PRINTFORMW 「음, 기분 좋지 않니? 원할 때 언제든지 올 수 있어, 알겠어?」
		PRINTFORMDW 천사가 즐겁게 네 페니스를 위아래로 문질러준다...
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「손으로 문지르는 것만으로는 좀 지루하네...」
		PRINTFORMW 「이건 어때, 후후~. 비비비~♪」
		PRINTFORMDW 천사가 볼을 부풀린 채 당신의 귀두에 비빈다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
