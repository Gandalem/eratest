;301,お茶を淹れる
;==================================================

@M_KOJO_MESSAGE_COM_K34_301
CALL M_KOJO_MESSAGE_COM_K34_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋慕
		PRINTFORML 「...차 기둥이야...」
		PRINTFORMW 「그건 행운을 의미한다고들 하지만, 왜 하필 지금 이런 일이 일어난 거지...」
	ELSE
		PRINTFORML 「오호, 당신은 안목이 있군요.」
		PRINTFORMW 「아~... 이 차 정말 맛있다.」
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;==================================================

@M_KOJO_MESSAGE_COM_K34_302
CALL M_KOJO_MESSAGE_COM_K34_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;背中を流す
	IF BATHROOM(CFLAG:現在位置)
		PRINTFORMW 「이봐 %CALLNAME:MASTER%, 내 등 좀 닦아줘.」
		PRINTFORMDW 텐시가 요청하여 당신은 그녀의 등을 향해 손을 뻗는다.
		PRINTFORMDW 손에 거품을 가득 쥔 채, 당신은 손가락으로 그녀의 아름답고 부드러운 피부를 마사지한다.
		PRINTFORMW 「음~ 기분 좋다~♪」
		PRINTFORMW 「다음엔 네 몸을 씻겨줄까? 자, 돌아봐!」
		PRINTFORMDW 당신은 그녀에게 등을 돌려주었고, 텐시는 활기차게 그것을 문지른다.
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 
					PRINTFORMDL 천사는 당신의 몸에 기대어 편안함을 느낀다. 
					PRINTFORMW 「이거 정말 좋다, 안전하다고 느끼게 해줘...」
				CASE 2
					PRINTFORML 
					PRINTFORMW 「꺅! 제발... 어디에 손대는 거야?」
					PRINTFORMW 「나도 그 게임 할 수 있거든...!」
					PRINTFORMDW 두 사람은 그렇게 서로에게 열 시간을 어울리며 농담을 주고받았다.
				CASE 1
					PRINTFORML 
					PRINTFORMW 「쿠우... 쿠우...」
					PRINTFORMDW 천사는 당신의 품에서 평화롭게 잠이 든다.
					PRINTFORMDW 당신은 그녀의 뺨을 부드럽게 어루만지고, 그녀는 만족스럽게 몸을 꿈틀거린다.
				CASE 0
					PRINTFORML 
					PRINTFORMW 「하하하! 간지러워!」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 
					PRINTFORMDW 당신은 조심스럽게 천사의 뺨을 찌른다.
					PRINTFORMW 「뭐야? 나를 건드인다고 뭐가 얻어지지도 않을 거야, 알겠지?」
				CASE 2
					PRINTFORML 
					PRINTFORMDW 당신은 사랑스럽게 천사를 품에 안는다.
					PRINTFORMW 「아아, 졸리다...」
				CASE 1
					PRINTFORML 
					PRINTFORMDL 당신은 텐시에게 큰 포옹을 한다.
					PRINTFORML 「저기, 잠깐만... 그만해...」
					PRINTFORMDW 그녀의 항의에도 불구하고, 텐시는 얼굴이 붉어지며 홍조를 띤다.
				CASE 0
					PRINTFORML 
					PRINTFORMW 「잠깐만, 잠깐 기다려봐... 그냥 가벼운 스킨십을 하려는 거라는 건 알아...」
					PRINTFORMW 「하지만 이건 너무 심하잖아...」
					PRINTFORMDW 그래서 그녀가 그렇게 말했지만, 너는 그녀가 저항하는 것을 보지 못한다...
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 
					PRINTFORMW 「뭐, 괜찮을 거라고 생각하네.」
					PRINTFORMW 「꺅! 낯선 곳에 손대지 마세요!」
				CASE 2
					PRINTFORML 
					PRINTFORMW 「좀 더 부드럽게 해줘.」
				CASE 1
					PRINTFORML 
					PRINTFORMW 「음, 뭔가 이상한 기분이야... 살짝 간지러워...」
				CASE 0
					PRINTFORML 
					PRINTFORMW 「흐음, 그런 종류의 간지러움이라니...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 
					PRINTFORMW 「기다려, 너무 친근해지는 거 아니야...」
				CASE 0
					PRINTFORML 
					PRINTFORMW 「그냥 부드럽게 쓰다듬어 주면 괜찮아.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
