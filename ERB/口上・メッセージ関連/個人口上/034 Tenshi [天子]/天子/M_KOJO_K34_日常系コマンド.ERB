;==================================================
;312,キスする
;==================================================

@M_KOJO_MESSAGE_COM_K34_312
CALL M_KOJO_MESSAGE_COM_K34_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K34_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDW 시간이 멈춘 동안 당신은 천사의 키스를 훔친다.
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...Mn...」
		PRINTFORMDW 당신이 그녀에게 키스하면 천사가 작은 한숨을 내쉰다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「음, %RANDKISS("kiss")%... 우선 분위기를 잡을까?」
			PRINTFORMW 「에헤헤, 얼마나 행복할까♪」
			PRINTFORMDW 그렇게 말하며, 천사가 당신의 키스를 되돌려준다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... %RANDKISS("kiss")%...」
			PRINTFORMW 「저기... 더...」
			PRINTFORMDW 천사는 골골거리는 목소리로 당신의 키스를 애원한다.
		ELSE
			PRINTFORMW 「음...」
			PRINTFORMDW 천사의 표정은 멍해지고, 당신이 키스하자 그녀의 눈은 욕망으로 풀린다.
			PRINTFORMW 「으응... 사랑해... 정말 많이 사랑해...%UNICODE(0x2665) *1%」
			PRINTFORMDW 그 천사는 당신에게 몸을 맡기고, 당신은 그녀의 입술을 거듭 빼앗는다...
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「영원히... 영원히 나와 함께 있어줘...%UNICODE(0x2665) *1%」
			PRINTFORMDW 당신이 물러나려고 할 때마다, 텐시는 당신의 머리를 단단히 잡고 입술을 맞댄 채 계속 키스를 한다.
			PRINTFORMDW 두 사람은 서로의 입 안에서 혀를 얽으며 끝에는 둘 다 숨이 차게 된다...
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%RANDKISS("kiss")%...」
			PRINTFORMW 「저기... 괜찮다면 계속하고 싶어... 어쩌면...?」
		ELSE
			PRINTFORMW 「음...%UNICODE(0x2665) *1%」
			PRINTFORMDW 천사는 당신에게 키스하며 입술을 더욱 가까이 맞댄다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「하늘이시여... 벌써 뜨거워지고 신경질적이 되는 것 같아요...%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 당신의 입술은... 정말 따뜻하네...%UNICODE(0x2665) *1%」
			PRINTFORMW 「헤이... 더, 더 키스하자...」
			PRINTFORMDW 그 후, 두 사람은 서로의 입술을 다시 정신없이 반복해서 맞댔다.
		ELSE
			PRINTFORMW 「음~ %UNICODE(0x2665) *1%」
			PRINTFORMW 「...이거 좋아하기 시작하는 걸지도 몰라요.」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...음...?!」
