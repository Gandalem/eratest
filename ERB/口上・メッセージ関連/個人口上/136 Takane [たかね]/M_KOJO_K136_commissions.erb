@M_KOJO_COLOR_K136
	;Remove this if Takane ever gets a dialogue. Gives her a text color in her commissions.
SETCOLOR 0x679D4F

@K136_SAWMILL_EVENT(Commission,ARGS)
#DIM DYNAMIC COMMISSION
IF !RAND:20
		;Small chance of getting two days ahead of schedule.
	PRINTFORMDL At the new %ARGS% sawmill, the kappa and yamawaro are working as though inspired.
	PRINTFORML 「Who knows why they're so motivated, but I guess I'll take advantage while I can.」
	PRINTFORMDW In a sudden burst of mania, development surges ahead!
	COMMISSION_PROGRESS:Commission += 300
	RETURN
ENDIF
	;There will be no problems at all for the first five scheduled days, but afterwards, there is a small chance of issues.
SIF COMMISSION_PROGRESS:Commission < 752
	RETURN
SELECTCASE RAND:14
	CASE 0
		PRINTFORML 「Huh, we're over budget?!」
		PRINTFORMDL While directing the construction of the new %ARGS% sawmill, Takane discovers there aren't enough materials.
		PRINTFORML 「Did those river rats sneak off and build something that wasn't in the plans again?!」
		PRINTFORML 「How do I explain this to the investor...?!」
		PRINTFORMDW The construction project has come to a halt.
		CALL COMMISSION_STALL(Commission)
	CASE 1
		PRINTFORMDL At the new %ARGS% sawmill's construction site, the kappa are growing restless.
		IF !RAND:2
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「Huh, so we're just following the plans now?」","")
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「Maybe we should build it like this instead...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「Hey, guys, I drew up a new addition plan!」","l")
			PRINTFORML 「Don't get distracted! Can't you people stay on task?!」
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「We're still working on it!」","")
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「Won't %HE_SHE(MASTER)% be happier if we add this?」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「I'm boooredー...」","l")
			PRINTFORML 「Gaaah, these scum-toads are impossible!」
		ELSE
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「I forgot what the plan said we should do...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「Who cares? Let's just improvise.」","")
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「Hey, tree-monkey, what are we supposed to do?」","l")
			PRINTFORML 「Why didn't you write down the plans like I told you?! This is exactly why I hate working with you idiotic amphibians!」
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「Boring...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「So boring...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「Why are you so boring...?」","l")
			PRINTFORML 「Gaaaaah!」
		ENDIF
		PRINTFORMDW They start playing around, and fall behind schedule...
		COMMISSION_PROGRESS:Commission -= 200
ENDSELECT

@COMMISSION_STATUS_K136
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(136)
IF !Commission
	PRINTFORML 「If you want something done right, do it through the yamawaro. We know our business!」
	PRINTFORML 「A small extra overhead cost is no big deal for peace of mind, wouldn't you agree?」
	SIF VAR_OR_DEFAULT("nSpoilerMode")
		PRINTFORML 「An extra up-front expense for our expert management, along with time taken to ensure quality, will guarantee a stable project.」
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「I-It's the kappa! It's all their fault, I tried to rein them in, but...!」
		CASE 1
			PRINTFORML 「We're still setting up.」
		CASE IS < COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「We're a little behind, but we'll get it done!」
		CASE IS > COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「We're ahead of schedule! We'll knock this thing out in no time!」
		CASEELSE
			PRINTFORML 「The job's underway, no need to worry!」
	ENDSELECT
ENDIF

@COMMISSION_ABLE_2_K136
RETURN 1

@COMMISSION_COST_2_K136(ARG)
SELECTCASE ARG
	CASE 0
		RESULT:1 = 90
		RETURN -5
	CASE 1
		RESULT:1 = 1010000
		RETURN -3
ENDSELECT

@COMMISSION_RATE_2_K136
RETURN 100

@COMMISSION_DESCRIPTION_2_K136
PRINTFORML 「Another sawmill? ...Considering supply and demand, it's not what I'd call a worthwhile investment for us.」
PRINTFORML 「Well, if you really want it, I can reach out to the kappa and arrange something. Can you pay for the materials and the overhead costs?」
PRINTFORML 「We'll make it a branch of the mountain sawmill, so we can get a bigger stake in the kappas' industry. It's better if we manage it, anyway.」

@COMMISSION_ACCEPT_2_K136
PRINTFORML 「Got it. I'll contact the necessary people right away.」
PRINTFORMDL The sawmill will be built in Hakurei Shrine - Approach.
SIF MAIN_MAP
	PRINTFORMDL You'll be able to reach it from Hakurei Shrine - Cherry Blossom Archway.

@COMMISSION_RESOLVE_2_K136
PRINTFORMW 「This is good enough. We'll resume operation right away!」

@COMMISSION_CANCEL_2_K136
PRINTFORML 「Really? ...Your loss, I suppose.」

@COMMISSION_WORK_SITE_2_K136(Location)
	;Hakurei Shrine - Approach.
#DIM DYNAMIC Location
SIF Location != GET_MAP_REPLACEMENT(22)
	RETURN 0
SELECTCASE COMMISSION_PROGRESS:2
	CASE IS < 0
		PRINTFORMDL Kappa and yamawaro are %SPLIT_G(@"sitting:loafing:hiding:building random machines:playing")% around the unfinished work site...
	CASE 1
		PRINTFORMDL Kappa and yamawaro are gathering around the work site...
	CASE IS < 160
		PRINTFORMDL Kappa and yamawaro are constructing the new sawmill's foundation...
	CASE IS < 400
		PRINTFORMDL Kappa and yamawaro are assembling the frame of the new sawmill...
	CASE IS > 700
		PRINTFORMDL Kappa and yamawaro are installing the new sawmill's machinery...
	CASEELSE
		PRINTFORMDL Kappa and yamawaro are busily working on the new sawmill...
ENDSELECT

@COMMISSION_EVENT_2_K136
CALL K136_SAWMILL_EVENT(2,"Hakurei Shrine")

@COMMISSION_COMPLETE_2_K136
PRINTFORML 「Finally, it's done! And the soundproofing should take care of any noise complaints from the shrine.」
PRINTFORMDL The Hakurei Shrine branch of the mountain sawmill is now complete in the Approach.
SIF MAIN_MAP
	PRINTFORMDL You'll be able to reach it from Hakurei Shrine - Cherry Blossom Archway.
WAIT

