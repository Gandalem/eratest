; Modular ERB: 個人口上/136 Takane [たかね]/M_KOJO_K136_commissions.erb

@M_KOJO_COLOR_K136
;Remove this if Takane ever gets a dialogue. Gives her a text color in her commissions.
SETCOLOR 0x679D4F

@K136_SAWMILL_EVENT(Commission,ARGS)
#DIM DYNAMIC COMMISSION
IF !RAND:20
	;Small chance of getting two days ahead of schedule.
	PRINTFORMDL 새로운 %ARGS% 제재소에서 카파와 야마와로는 영감을 받은 듯 일하고 있다.
	PRINTFORML 「왜 저렇게 의욕적인지 모르겠지만, 기회가 있을 때 이용해야겠어.」
	PRINTFORMDW 갑작스러운 광란 속에서 개발이 앞서 나간다!
	COMMISSION_PROGRESS:Commission += 300
	RETURN
ENDIF
;There will be no problems at all for the first five scheduled days, but afterwards, there is a small chance of issues.
SIF COMMISSION_PROGRESS:Commission < 752
	RETURN
SELECTCASE RAND:14
	CASE 0
		PRINTFORML 「뭐라고, 예산을 초과했다고?!」
		PRINTFORMDL 새로운 %ARGS% 제재소 건설을 지휘하던 타카네는 자재가 충분하지 않다는 것을 발견한다.
		PRINTFORML 「또 저 개구리들이 계획에 없던 걸 몰래 지어버린 건가?!」
		PRINTFORML 「이걸 투자자에게 어떻게 설명해야 하지...?!」
		PRINTFORMDW 건설 프로젝트가 중단되었다.
		CALL COMMISSION_STALL(Commission)
	CASE 1
		PRINTFORMDL 새로운 %ARGS% 제재소 건설 현장에서 카파들이 초조해하고 있다.
		IF !RAND:2
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「흐음, 이제 그냥 계획대로 진행하는 건가?」","")
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「대신 이렇게 지어야 할지도 모르겠어...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「얘들아, 나 새로운 추가 계획을 세웠어!」","l")
			PRINTFORML 「딴 데 정신 팔지 마! 너희들 일에 집중 좀 못 하겠어?!」
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「아직 작업 중입니다!」","")
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「이걸 추가하면 %HE_SHE(MASTER)%가 더 행복하지 않을까?」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「지루해ー...」","l")
			PRINTFORML 「크아악, 이 벌레 같은 두꺼비들은 말도 안 돼!」
		ELSE
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「우리가 뭘 해야 한다고 계획에 적혀 있었는지 잊어버렸어...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「누가 신경 써? 그냥 즉흥적으로 하자.」","")
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「이봐, 나무 원숭이, 우리 뭐 해야 해?」","l")
			PRINTFORML 「내가 말했잖아, 계획들을 왜 적지 않은 거야?! 네놈 같은 바보 양서류와 일하는 게 딱 이 이유 때문에 싫다고!」
			TRYCALL K51_EGG_KAPPA_TEXT(1,@"「지루해...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(2,@"「너무 지루해...」","")
			TRYCALL K51_EGG_KAPPA_TEXT(0,@"「왜 그렇게 지루한 거야...?」","l")
			PRINTFORML 「크아악!」
		ENDIF
		PRINTFORMDW 그들은 빈둥거리기 시작하며 일정을 놓친다...
		COMMISSION_PROGRESS:Commission -= 200
ENDSELECT

@COMMISSION_STATUS_K136
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(136)
IF !Commission
	PRINTFORML 「제대로 하고 싶다면 야마와로를 통하세요. 저희는 우리 일에 대해 알고 있습니다!」
	PRINTFORML 「조금의 추가 비용은 마음의 평화를 위해 아무것도 아니라고 생각하지 않으세요?」
	SIF VAR_OR_DEFAULT("nSpoilerMode")
		PRINTFORML 「저희 전문가 팀의 초기 비용과 품질을 보장하기 위해 소요되는 시간을 고려하면 프로젝트가 안정적으로 진행될 것입니다.」
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「이-카파다! 전부 그들의 잘못이야, 내가 제지하려고 했지만...!」
		CASE 1
			PRINTFORML 「아직 설정 중입니다.」
		CASE IS < COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「조금 지연되었지만 끝낼 거예요!」
		CASE IS > COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「우리는 예정보다 앞서고 있어! 금방 이걸 끝낼 거야!」
		CASEELSE
			PRINTFORML 「일은 진행 중이야, 걱정할 필요 없어!」
	ENDSELECT
ENDIF

@COMMISSION_ABLE_2_K136
RETURN 1

@COMMISSION_COST_2_K136(ARG)
SELECTCASE ARG
	CASE 0
		RESULT:1 = 90
		RETURN -5
	CASE 1
		RESULT:1 = 1010000
		RETURN -3
ENDSELECT

@COMMISSION_RATE_2_K136
RETURN 100

@COMMISSION_DESCRIPTION_2_K136
PRINTFORML 「또 제재소라고? ...수요와 공급을 고려하면 우리에게 가치 있는 투자는 아닐 것 같군.」
PRINTFORML 「음, 정말 원한다면 내가 카파들에게 연락해서 무언가를 마련할 수는 있어. 자재비랑 간접 비용은 네가 지불해 줄 수 있겠어?」
PRINTFORML 「산 제재소의 지점을 만들어서 카파들의 산업에서 더 큰 지분을 얻을 거야. 어차피 우리가 관리하는 게 나아.」

@COMMISSION_ACCEPT_2_K136
PRINTFORML 「알았어. 필요한 사람들에게 바로 연락할게.」
PRINTFORMDL 제재소는 학수리 신사-접근에 지어진다.
SIF MAIN_MAP
	PRINTFORMDL 해쿠레이 신사에서 체리 블로섬 아치웨이를 통해 도달할 수 있다.

@COMMISSION_RESOLVE_2_K136
PRINTFORMW 「이것으로 충분하다. 즉시 작전을 재개하겠다!」

@COMMISSION_CANCEL_2_K136
PRINTFORML 「정말?... 당신의 손해겠지, 아마도.」

@COMMISSION_WORK_SITE_2_K136(Location)
;Hakurei Shrine - Approach.
#DIM DYNAMIC Location
SIF Location != GET_MAP_REPLACEMENT(22)
	RETURN 0
SELECTCASE COMMISSION_PROGRESS:2
	CASE IS < 0
		PRINTFORMDL 카파와 야마와로는 %SPLIT_G(@"sitting:loafing:hiding:building random machines:playing")% 미완성된 공사 현장 주변에...
	CASE 1
		PRINTFORMDL 카파와 야마와로는 작업장 주변에 모여 있었다...
	CASE IS < 160
		PRINTFORMDL 카파와 야마와로는 새 제재소의 기초를 건설하고 있다...
	CASE IS < 400
		PRINTFORMDL 카파와 야마와로는 새로운 제재소의 틀을 조립하고 있다...
	CASE IS > 700
		PRINTFORMDL 카파와 야마와로는 새로운 제재소의 기계를 설치하고 있다...
	CASEELSE
		PRINTFORMDL 카파와 야마와로는 새로운 제재소에서 바쁘게 일하고 있다...
ENDSELECT

@COMMISSION_EVENT_2_K136
CALL K136_SAWMILL_EVENT(2,"Hakurei Shrine")

@COMMISSION_COMPLETE_2_K136
PRINTFORML 「드디어 끝났어! 그리고 방음으로 신사에서 나올 수 있는 모든 소음 불만은 처리될 거야.」
PRINTFORMDL 산림 제재소의 하쿠레이 신사 지부가 접근로에 완성되었다.
SIF MAIN_MAP
	PRINTFORMDL 해쿠레이 신사에서 체리 블로섬 아치웨이를 통해 도달할 수 있다.
WAIT

