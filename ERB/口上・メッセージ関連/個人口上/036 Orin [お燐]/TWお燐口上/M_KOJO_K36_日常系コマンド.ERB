LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「하냐아...」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 쓰다듬어지고 있으니... 왠지... 졸리네...」
			CASE 1
				PRINTFORML 「꼬리 쓰다듬는 거 즐거워?」
				PRINTFORMW 「괜찮다면 손질 좀 도와줄 수 있겠니?」
			CASE 2
				PRINTFORML 「～♪～♪」
				PRINTFORMW 쓰다듬자 기분 좋게 목울림을 울리고 있다.
				PRINTFORML 「야옹 더 쓰다듬어줘~」
				PRINTFORMW 완전히 고양이 모드가 되어버렸다.
		ENDSELECT
	ELSEIF TALENT:思慕 || TALENT:セフレ
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「정말! 아까부터 너무 만지잖아!」
				PRINTFORMW 그렇게 말하고는 있지만, 다가오는 건 오린 쪽이다
			CASE 1
				PRINTFORML 「후훗! 예쁜 꼬리잖아」
				PRINTFORMW 「조금만이라면... 만져도 돼?」
			CASE 2
				PRINTFORML 「～♪～♪」
				PRINTFORMW 쓰다듬자 기분 좋게 목울림을 하고 있다.
				PRINTFORML 「핫! 저 벌써 안 되겠어!」
				PRINTFORMW 오린에게는 목소리 내는 것을 들키는 것이 부끄러웠던 모양이다.
		ENDSELECT
	ELSEIF CFLAG:2 >= 500
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「귀가 신경 쓰여? 만져 볼래?」
			CASE 1
				PRINTFORML 「후훗! 예쁜 꼬리잖아」
				PRINTFORMW 「사토리님께 손질 받고 있는 거야」
			CASE 2
				PRINTFORML 「예쁜 손톱이지. 매일 아침 갈고 있거든~」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「냐! 꼬리는 안 돼!」
			CASE 1
				PRINTFORMW 「그 옷의 반짝이는 부분이... 신경 쓰여...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
