@M_KOJO_SUCCESS_COM_K36_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K36_300
RETURN 0

@M_KOJO_MESSAGE_COM_K36_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K36_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K36_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORMW
		;会話失敗
	ELSEIF TFLAG:193 < 0
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「음... 시체 쪽이 더 재미있게 말해줘」
			CASE 1
				PRINTFORMW 「아, 미안. 생각하고 있었어.」
		ENDSELECT
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW
		ELSEIF RAND:4 == 0
			PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW
		ELSEIF RAND:4 == 0
			PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW
		ELSEIF RAND:4 == 0
			PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF RAND:5 == 0
			PRINTFORMW
		ELSEIF RAND:4 == 0
			PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		IF RAND:5 == 0
			PRINTFORMW
		ELSEIF RAND:4 == 0
			PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF RAND:5 == 0
			PRINTFORMW
		ELSEIF RAND:4 == 0
			PRINTFORMW
		ELSEIF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW
		ELSEIF RAND:2 == 0
			PRINTFORMW
		ELSE
			PRINTFORMW
		ENDIF
	ELSE
		;この場合季節会話を0として0～4のランダムに表示される。つまり5分の1の確率で季節会話。
		SELECTCASE RAND:4
			CASE 0
				;春
				IF DAY:2 == 1
					PRINTFORMW 「이렇게 햇살이 기분 좋으니 낮잠 자고 싶어지네-」
					;夏
				ELSEIF DAY:2 == 2
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「역시 여름은 덥네-」
							PRINTFORMW 「염열 지옥은 원래도 더운데 게더 더워지니까.」
							PRINTFORMW 「뭐, 오쿠의 곁이 제일 덥지만 말이야.」
						CASE 1
							PRINTFORML 「여름은 더위로 쓰러지는 사람이 많아서 매우 바빠.」
							PRINTFORMW 「너도 제대로 수분 보충하고 쓰러지지 않도록 해.」
					ENDSELECT
					;秋
				ELSEIF DAY:2 == 3
					PRINTFORML 「나는 가을를 좋아한다니까」
					PRINTFORMW 「단풍잎은 나뭇잎이 타는 것 같아서 예쁘지 않아?」
					;冬
				ELSEIF DAY:2 == 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「떡에는 조심해라」
							PRINTFORMW 「저걸로 쓰러진 놈들을 여러 명 운반했으니까 말이야」
						CASE 1
							PRINTFORML 「오늘도 춥네~ 연료를 더 가지고 가야 해」
					ENDSELECT
				ENDIF
				;その他
			CASEELSE
				IF TALENT:恋慕 || TALENT:愛欲
					SELECTCASE RAND:8
						CASE 0
							PRINTFORML 「하냐... 어라, 긴장이 풀리고 있었네」
							PRINTFORMW 「뭐 %CALLNAME:MASTER%라면 괜찮겠지」
						CASE 1
							PRINTFORML 「쓰고 싶으니까 고양이 모습이 되어줬으면 해?」
							PRINTFORMW 「이 상태로 쓰면서 만져줘도 괜찮아?」
						CASE 2
							PRINTFORML 「나를 좋아해?」
							PRINTFORMW 「후후, 나도 그래!」
							PRINTFORMW 그런 그녀의 뺨은 머리카락과 같은 색으로 물들어 있었다
						CASE 3
							PRINTFORML 「고양이 차에 탈래?」
							PRINTFORMW 「아니면... 나한테 타고 싶어?」
							PRINTFORMW ………
							PRINTFORML 「후후 어깨동무라는 뜻이야」
							PRINTFORMW 「뭘 상상했으려나~?」
						CASE 4
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 영원히 널 놓지 않을 테니까!」
							PRINTFORMW 「응, 영원히 말이야.」
						CASEELSE
							PRINTFORMW 오린은 %조사처리(CALLNAME:MASTER,"의")% 이야기를 꼬리를 흔들며 듣고 있다.
					ENDSELECT
				ELSEIF TALENT:思慕 || TALENT:セフレ
					SELECTCASE RAND:8
						CASE 0
							PRINTFORMW 「냐아... 어라, 방심하고 있었네」
						CASE 1
							PRINTFORML 「쓰다듬고 싶으니까 고양이 모습이 되어줬으면 해?」
							PRINTFORMW 「에헤, 어쩔 수 없네.」
						CASE 2
							PRINTFORML 「레이무의 무릎은 꽤 편하거든」
							PRINTFORMW 「네가 무릎 베개를 해줄지는 모르겠지만 말이야」
							PRINTFORMW 「아니면, 내가 무릎 베개를 해 줄까?」
						CASE 3
							PRINTFORML 「고양이 차를 타고 어디까지든～♪」
							PRINTFORMW 고양이 차를 탄 당신을, 오린은 노래하며 어딘가로 데려간다.
							PRINTFORMW ...이대로 계속 타 있어도 괜찮을까.
						CASE 4
							PRINTFORML 「첸과는 고양이끼리 사이가 좋단다」
							PRINTFORMW 「아직 변신하는 것도 서툴지만 그게 또 귀엽단 말이야」
						CASE 5
							PRINTFORML 「시체로 변할 거면 나한테 와 줘!」
							PRINTFORMW 「소중하게 다뤄줄 테니까」
							PRINTFORMW 불행하게도 아직 죽을 생각은 없어
						CASEELSE
							PRINTFORMW 오린은 %조사처리(CALLNAME:MASTER,"의")% 이야기를 꼬리를 흔들며 듣고 있다.
					ENDSELECT
				ELSEIF CFLAG:2 >= 500
					SELECTCASE RAND:8
						CASE 0
							PRINTFORMW 「냐아... 어라, 방심하고 있었네」
						CASE 1
							PRINTFORML 「당신 꽤 재미있네요」
							PRINTFORMW 「어때? 같이 펫이 되어 볼래?」
						CASE 2
							PRINTFORML 「레이무의 무릎은 꽤 편하거든」
							PRINTFORMW 「네가 무릎 베개 해줄지는 모르겠지만 말이야」
						CASE 3
							PRINTFORML 「이 고양이 차가 궁금해?」
							PRINTFORMW 「근처라면 운반해주고도 괜찮아.」
						CASE 4
							PRINTFORML 「첸과는 고양이끼리 사이가 좋단다」
							PRINTFORMW 「아직 변신하는 것도 서툴지만 그게 또 귀엽단 말이야」
						CASEELSE
							PRINTFORMW 오린은 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 감탄하고 있다.
					ENDSELECT
				ELSE
					SELECTCASE RAND:6
						CASE 0
							PRINTFORML 「당신, 가끔 사라졌다가 이동하는 것 같아.」
							PRINTFORMW 「저는 동체 시력에는 자신이 있거든요~」
						CASE 1
							PRINTFORML 「이미 사토리님께 인사했어?」
							PRINTFORMW 「저희들의 주인님이셔.」
						CASE 2
							PRINTFORML 「무엇을 운반하고 있는지 궁금한 거니?」
							PRINTFORMW 「후후후, 모르는 편이 좋을지도 모르겠네」
						CASEELSE
							PRINTFORMW 오린은 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
					ENDSELECT
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
