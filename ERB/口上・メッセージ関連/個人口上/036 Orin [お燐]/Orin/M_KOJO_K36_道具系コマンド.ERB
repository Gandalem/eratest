@M_KOJO_EGG_MESSAGE_COM_K36_43_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「흥, 정말 이상하게 생긴 관이군... 응? 내 성기가 안으로 들어간다고?」
		PRINTFORMW 「후아아안!? 응? 이거 뭐지? 굉장해!」
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:オナホール
		;恋慕
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「흐아아안!? 이건 나를 떨고 문지르는 방식이 너무 안 좋아...」
					PRINTFORMW 「흐으윽, 곧 터질 것 같아. 더는 견딜 수가 없어...」
				CASE 1
					PRINTFORML 「아... 후미야아아안!?」
					PRINTFORMDW 당신이 오나홀을 그녀의 샤프트 위로 미는 순간, 린의 골반은 저절로 움찔거리며 공중으로 들썩이기 시작했다.
				CASE 2
					PRINTFORML 「흐으음... 이건... 나를 미치게 만들고 있어...」
					PRINTFORMW 「아프우훗... 아아앙...」
			ENDSELECT
			RETURN 1
		ENDIF
		;解除
	ELSE
		;時姦中
		IF FLAG:70
			;PRINTFORMW
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음... 크아아앙!」
					PRINTFORMDW 너는 한 번의 빠르고 강력한 움직임으로 린의 맥동하는 성기를 움켜쥐고, 자극의 충격이 몸을 타고 퍼지면서 그녀의 몸은 떨렸다.
				CASE 1
					PRINTFORMW 「후냐아아앗!... 아... 내... 내 거...」
				CASE 2
					PRINTFORML 「우와아앙... 하아... 끅... 너무 잔인해!」
					PRINTFORMW 「하지만 지금은 더 자극하지 말아줘... 냐아흣!?」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
