@M_KOJO_EGG_MESSAGE_COM_K36_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「뭐지...? ...장난감이야?」
		PRINTFORML 「굉장히 흥미로워 보인다ー! 어떻게 가지고 노는 거야?」
		PRINTFORMW 「...궁금하네, 왜 그렇게 수상한 미소를 짓고 있는 거지? ...와이——푼야아아안!?」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「후우운, 흐읍, 푸아아, 하아안...!」
				PRINTFORML 「%PRINT_MALE("B-Boyo:S-Sis", MASTER)%, 너 스스로 나랑 놀아주지 않을 거니?」
				PRINTFORMW 「너는 그저 장난감을 사용하고 있을 뿐이야... 후아아안, 야아앙!」
			CASE 1
				PRINTFORML 「꽤 기분이 좋다...」
				PRINTFORMW 「네가 그것을 만지는 방식이... 우냐아앗...」
			CASE 2
				PRINTFORMW 「흠... 크릉... 너무 윙윙거려... 냐아앙!」
			CASE 3
				PRINTFORMW 「결국 기계에 의지하기로 결정했구나... 후우~」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
