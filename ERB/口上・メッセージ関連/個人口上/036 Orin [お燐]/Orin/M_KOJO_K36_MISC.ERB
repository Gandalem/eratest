;3,Gスポット刺激
;==================================================

@M_KOJO_EGG_MESSAGE_SCOM_K36_3
CALL M_KOJO_EGG_MESSAGE_SCOM_K36_3_1
RETURN 1

@M_KOJO_EGG_MESSAGE_SCOM_K36_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		RETURN 1
	ENDIF
	IF !FLAG:70 && NOWEX:Ｖ絶頂
		IF RAND:2
			PRINTFORML 「냐아아앙... 그만... 후와, 히이얀...」
			PRINTFORMW (안 돼... 나는 %HIM_HER(MASTER)%가 평소대로 하길 원해... %HIS_HER(MASTER,1)% 손들이... 나를 절정에 이르게 할 거야!)
		ELSE
			PRINTFORML 「흐으응... 왜 그래... 네가 그 깊은 곳을 만지면... 너무 미치도록 기분이 좋아져 버려!」
			PRINTFORMW 「이봐, 그 부분을 더 괴롭혀 봐... 후와앙... 나 이제 곧... 호오... 더!」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
	ELSE
		PRINTDATAW
			DATAFORM 「냐후우... 우와아앙... 거기를 누르면... 이상해질 거야... 히야안!?」
			DATAFORM 「응흥... 냐아아앙... 아마... 후와, 응기... 기분 좋을지도...」
			DATAFORM 「응흥... 후와, 히인ㅎ... 느낌이... 좀 뜨거워...」
		ENDDATA
	ENDIF
ENDIF
