;100,スパンキング
;==================================================

@M_KOJO_EGG_MESSAGE_COM_K36_100
CALL M_KOJO_EGG_MESSAGE_COM_K36_100_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「응가아, 그만해! 아파! 아프다고, %K36_BOYO()%!」
		IF ABL:マゾっ気 >= 5
			PRINTFORMDW 린의 몸이 가볍게 떨리고, 그녀의 미간에는 당혹감이 잡힌다.
			PRINTFORMW 「냐우훗?... 아파도... 후우, 기분이... 좋아?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「혹시 무슨 이유로 나를 증오하기 시작한 건 아니겠지?」
			PRINTFORMDW 린은 눈에 눈물을 머금고, 네 행동 뒤에 숨겨진 이유를 알려고 너를 바라본다.
		ELSEIF MARK:不埒刻印 >= 2
			PRINTFORMDW 눈에 눈물을 머금은 채, 린은 고통을 견디며 필사적으로 버티려 노력했다.
		ELSE
			PRINTFORMW 「이게 왜 누군가 재미있다고 생각하는지 모르겠어... 난 절대 이해 못 하겠어. 크윽...」
			PRINTFORMDW 린은 너에게 날카로운 눈빛을 보낸다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
	ELSEIF ABL:マゾっ気 >= 5
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「크윽... 아프지만... 너무 좋아서 좋아! 이거 중독될지도 모르겠어!」
				PRINTFORMDW 린은 당신의 모든 벌을 기꺼이 받아들이며 행복하게 엉덩이를 흔든다.
			CASE 1
				PRINTFORML 「...흐으응! ...냐아아앙그!?」
				PRINTFORMDW 린은 고통스러운 쾌감에 몸을 맡기며 때리기 더 쉽게 뒤쪽으로 엉덩이를 내민다.
			CASE 2
				PRINTFORML 「흐응... 이상해... 이런 게... 후아아안!?」
				PRINTFORMDW 잠시 휴식을 취하는 동안, 린은 기회를 잡아 자신의 꼬리로 실험 삼아 엉덩이를 때렸다.
			CASE 3
				PRINTFORML 「...쿠아하앙! 냐푸우~! ...왜 이렇게 좋은 거야!?」
				PRINTFORMDW 린은 네 손바닥이 그녀의 엉덩이를 흔들고 붉게 만들 때마다 밀려오는 쾌감을 이해하려고 애쓴다.
		ENDSELECT
	ELSEIF PALAM:欲情 >= PALAMLV:4
		PRINTFORML 「...응!? ...기분 좋게 가고 있었는데, 왜 그런 짓을 한 거야? 바보 같긴.」
		PRINTFORMDW Rin은 조금 기분이 상한 듯했고, 복수심에 당신의 엉덩이를 때리며 꼬리를 휘둘렀다.
	ELSEIF TALENT:恋慕
		PRINTFORML 「크으... 나는 괜찮아! 네가 있다면 뭐든지 해낼 수 있어!」
		PRINTFORMW 「...하지만, 너무 무리하지 않았으면 좋겠다는 생각이 들 때도 있어... 우와앙...」
	ELSEIF MARK:反発刻印
		PRINTFORML 「네가 감히 그런 짓을 한다면, 죽음을 각오해야 할 것이다! ...응!」
		PRINTFORMDW Rin의 눈은 타오르고 그녀의 몸은 네 손길이 닿을 때마다 분노로 떨렸다.
	ELSE
		IF RAND:2
			PRINTFORMW 「흥... 나한테는 재미가 없어... 그만해 줄 수 있겠어?」
		ELSE
			PRINTFORMW 「아파, 아파, 아파! 날 시체로 만들려는 거야!?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;104,アイマスク
;==================================================

@M_KOJO_EGG_MESSAGE_COM_K36_104
CALL M_KOJO_EGG_MESSAGE_COM_K36_104_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF MARK:不埒刻印 == 3
			PRINTFORMW 「오냐아~, 이거 재밌을 것 같은데!」
			PRINTFORMDW 당신이 그녀에게 안대를 보여주자 린의 눈이 빛났다.
			PRINTFORMW 「어때! 정말 깜깜하네. 그럼 이제 뭘 할 거야?」
			PRINTFORMDW 안대를 채운 후에도 그녀는 전혀 긴장하는 기색을 보이지 않았다.
		ELSE
			PRINTFORMW 「그리고, 이 장난감은 어디에 쓰는 거야?」
			PRINTFORMDW 린은 네가 시키는 대로 안대를 쓰지만, 조금 불안해 보인다.
			PRINTFORMW 「냐호, 완전히 깜깜해! ...그래서, 음... 이제 뭘 할 거야...?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		IF ABL:マゾっ気 >= 5
			IF TALENT:恋慕
				PRINTFORML 「또 이러는 거야? 이 안대 놀이, 정말 좋아하지...?」
				PRINTFORML 「아니면 내 사랑스러운 시선이 너무 긴장하게 만드는 걸까?」
				PRINTFORMDW 리는 당신이 그녀의 머리에 천을 두르는 동안 당신을 놀린다. 여전히 평정심을 유지하고 있는 것 같다...
			ELSE
				PRINTFORML 「정말, 또 내 눈을 가려고 하는 거야?」
				PRINTFORMDW 린은 어쩐지 엄청나게 즐기는 것 같다.
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORML 「흠ー... 얼굴을 볼 수 없으니 좀 슬프네, 있잖아.」
			PRINTFORMW 「나에게 조금 더 존중을 해줬으면 좋겠어, %K36_BOYO()%.」
		ELSEIF MARK:反発刻印
			PRINTFORML 「그만둬...」
			PRINTFORMDL 너는 눈이 멀어가는 린의 유두를 꼬집었고, 그녀는 네 손가락을 피하려 몸을 비틀고 움찔거렸다.
			PRINTFORMDW 그녀의 항의와 달리, 너는 그녀의 목소리에서 희미한 쾌감의 기색을 감지할 수 있다고 생각했다.
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORML 「있잖아, 내 고양이 눈으로도 볼 수 없는 이런 눈가림을 당하는 건 좀 답답하네.」
			PRINTFORMW 「하지만, 조금은 설레기도 해...」
			;それ以外
		ELSE
			PRINTFORMW 「아무것도 보이지 않아... 좀 불안하네, 있잖아.」
			RETURN 1
		ENDIF
		;解除
	ELSE
		IF TALENT:恋慕
			PRINTFORML 「음... 계속 내 옆에 있었구나, %K36_BOYO()%～」
			PRINTFORMDW 당신이 안대를 벗자, 린은 자신의 옆에서 당신의 얼굴을 보고 행복하게 미소 짓는다.
		ELSE
			PRINTFORMDW 빛이 갑자기 그녀의 예민한 눈으로 쏟아져 들어오자, 린은 자신도 모르게 얼굴을 찌푸렸다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;105,縄
;==================================================

@M_KOJO_EGG_MESSAGE_COM_K36_105
CALL M_KOJO_EGG_MESSAGE_COM_K36_105_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF MARK:不埒刻印 == 3
			PRINTFORMW 「...우와, 이건 어떤 마술 같은 거네! 숨겨진 함정이 없어야 할 텐데!」
			PRINTFORMW 「그럼... 내가 어떻게 여기서 빠져나가지? 뭘 해야 할지 알려주면 정말 고맙겠어...」
			PRINTFORMDW Rin은 당신이 자신에게 하는 일이 무엇인지 제대로 이해하지 못하는 것 같다.
		ELSE
			PRINTFORMW 「오호라, 나를 묶어버리면 뭘 할 작정이지?」
			PRINTFORMW 「단두대에서 처형할 건가? 십자가에 못 박을 건가? 피웅덩이에 던져 넣을 건가? 아니면 어쩌면 네 기량을 과시하듯 나를 전부 환상향 곳곳으로 끌고 다니려는 걸까?」
			PRINTFORMW 「하지만 솔직히 말하자면, 아무것도 하지 말고 그저 나를 풀어주길 간절히 바란다...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		IF ABL:マゾっ気 >= 5
			IF TALENT:恋慕
				PRINTFORML 「아아, 당신의 이 특별한 재주가 너무 마음에 들어요!」
				PRINTFORML 「묶여있는 게 정말 짜릿해요. 저는 당신을 거스를 방법이 전혀 없어요, 완전히 무력하네요～」
				PRINTFORMW 「게다가... 기분도 정말 좋아요! 최고예요!」
			ELSE
				PRINTFORML 「나를 그렇게 단단히 묶으면 근육 하나 움직일 수도 없어.」
				PRINTFORML 「그러니 나를 기분 좋게 만드는 건 모두 당신에게 달렸어!」
				PRINTFORMDW Rin은 당신이 자신에게 할 모든 것을 기대하며 간절하게 당신을 바라본다.
			ENDIF
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORML 「당신이 이런 장난을 치는 건 정말 싫어요.」
			PRINTFORMW 「내 말은, 이렇게 당신을 품에 안고 있을 수도 없다는 거예요...」
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORML 「흐음... 너무 많이 움직이려고 하면 조금 아프네.」
			PRINTFORMDW Rin은 저항 없이 자신을 묶이도록 내버둔다.
			RETURN 1
		ELSEIF MARK:反発刻印
			PRINTFORML 「어쨌든 네가 이걸 왜 즐기는지 궁금하네.」
			PRINTFORMW 「이렇게 묶인 나를 피의 연못에 던진다면, 나는 옛 지옥의 오니처럼 되어버릴 거야.」
			;それ以外
		ELSE
			PRINTFORML 「애벌레...」
			PRINTFORMDW 린은 애벌레의 가장 완벽한 흉내를 냈다.
			PRINTFORML 「아니, 거기 서서 구경만 하지 마. 벌써 나 풀어줄 수 없니?」
			PRINTFORMDW 린은 스스로 움직일 수 없는 것에 빠르게 인내심을 잃어가는 듯했다.
			RETURN 1
		ENDIF
		;解除
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「좋아, 드디어 자유로워졌어. 진정한 재미를 볼 시간이야!」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「윽, 아파... 저 밧줄들이 정말 내 피부를 파고드는군...」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
