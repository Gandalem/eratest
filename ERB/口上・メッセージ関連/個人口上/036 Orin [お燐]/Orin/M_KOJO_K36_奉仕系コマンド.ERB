@M_KOJO_EGG_MESSAGE_COM_K36_81
CALL M_KOJO_EGG_MESSAGE_COM_K36_81_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「여기 봐, %K36_BOYO()%... 왜 그렇게 내게 네 것을 핥으라고 계속 조르는 거야?」
		PRINTFORMW 「넌 정말로, 정말로 그걸 원한다고 말하잖아... 그리고 분명히 말하는데, 네가 나를 그렇게 원하는 게 기쁘다...」
		PRINTFORMW 「하지만 내 혀가 그것을 피가 날 정도로 거칠게 문질러도 괜찮다고 확신해?」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORML 「오, 이거 안 좋은데... 냄새가 너무 강해서 어질어지네... 흠으윽...」
		PRINTFORMW 「냠냠... %FSYN("lips_muffle")%... 도시임 피우 구브?」 
		RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「%FSYN("lips_gulp")%... 푸위안... %FSYN("lips_muffle")%... 아프지 않아?」
		PRINTFORMDW 린은 당신의 성기를 자극하기 위해 최선을 다하며 거친 부분으로 상처를 주지 않으려고 혀를 비틀고 돌리려 노력한다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
