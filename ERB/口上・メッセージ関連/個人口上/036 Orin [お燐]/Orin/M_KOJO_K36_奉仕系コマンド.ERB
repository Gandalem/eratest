@M_KOJO_EGG_MESSAGE_COM_K36_80
CALL M_KOJO_EGG_MESSAGE_COM_K36_80_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「아... 당신의 그것... 꽤 심하게 움직이고 있네요, 그렇죠!」
		PRINTFORMW 「있잖아요, 지금 당신의 성기 거의 고양이 장난감 같아서 귀여워요!」
		PRINTFORMDW Rin은 손바닥 안에서 당신의 살덩이가 격렬하게 꿈틀거리는 것을 느끼며 즐겁게 웃었다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 && RAND:3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「뉴푸후후～ ...음흠...」
				PRINTFORMDL Rin은 몸을 숙여 네 성기에 침을 몇 방울 떨어뜨린 뒤, 손으로 위아래로 문질러 침으로 완전히 미끌거리게 만들었다.
				PRINTFORML 「정말 민감한 부위잖아, 그렇지? 그러니까 아주 미끌미끌하게 만들어야겠어...」
				PRINTFORML 「더 세게 문질러도 괜찮을까? ...음, 내가 어떻게 하든 즐기고 있는 것 같네...」
				PRINTFORML 「봐, 벌써 이렇게 크고 단단해졌잖아... 그리고 맥동하고 있어...」
				PRINTFORMW 「원할 때 언제든지 싸버려, %K36_BOYO()%. 전부 짜낼 수 있도록 해줄게...」
			CASE 1
				PRINTFORMW 「흠... 오늘도 평소처럼 활기가 넘치는 것 같네.」
				PRINTFORMW 「다 끝나면 나한테도 좀 잘해줘야 해, 알겠지?」
			CASE 2
				PRINTFORMW 「......냐아―」
				PRINTFORMDW 린은 당신의 고동치는 기관을 마치 고양이 장난감인 양 부드럽게 휘두르며 가지고 논다.
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「여기서 그렇게 심하게 떨고 있네... 정말 기분이 좋은 거야?」
		PRINTFORMW 「후우... 그저 너를 문질러 줄 뿐인데... 냄새가 나한테도 이상한 느낌을 주기 시작했어...」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「음... 여기서 제대로 씻고 있었니?」
		PRINTFORMW 「어떤 종류의 액체가 나오고 있어... 그리고 점점 더 걸쭉해지고 있어... 하아...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
