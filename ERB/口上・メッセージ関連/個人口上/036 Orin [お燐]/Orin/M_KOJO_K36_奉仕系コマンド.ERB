@M_KOJO_EGG_MESSAGE_COM_K36_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「우와아... 이건 예상했던 것과는 정말 다른 느낌이야...」
		PRINTFORML 「네 열기가 느껴져, 내 가슴을 통해 직접 전해지는 게...」
		PRINTFORMW 「마치 이상한 기운이 내 가슴에서 퍼져나오는 것 같아...」
		PRINTFORMW 「다음에 뭘 해야 하지..? 움직여야 하나? 좋아 그럼...」
		PRINTFORML 「...후아아... 음, 아아앙...」
		PRINTFORML 「...느껴졌어, %K36_BOYO()%? ...사실 나도 느끼기 시작했어...」
		PRINTFORMW 「...뭔가 이상한 게 오고 있어...! ...흐으응!?」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕 && RAND:3
		IF RAND:2
			PRINTFORML 「믿기 힘든 일이지만, 이렇게 하는 건... 내 가슴마저 뜨거워지고 심장이 두근거리네...」
			PRINTFORML 「너는 어때, 네 마음은 어떤지? 터질 것 같을 만큼 세게 뛰고 있니?」
			PRINTFORML 「여기 아래쪽이 곧 터져버릴 것 같은 게 분명해～」
			PRINTFORMDW Rin은 가슴골 사이로 튀어나온 당신의 귀두에 입맞춤하며 고개를 숙여 쪼았다.
		ELSE
			PRINTFORML 「음... 알겠다...」
			PRINTFORMDL 그녀의 침으로 당신의 성기를 윤활시킨 후, 린은 당신의 몸을 위아래로 움직이기 시작한다.
			PRINTFORML 「...칫... 왜 내 가슴이 "놀라울 정도로" 크다고 계속 말하는 거야...」
			PRINTFORML 「그런 종류의 %K36_BOYO()%은 약간의... 훈육이 필요하다고 생각해!」
			PRINTFORMDL 그녀가 그렇게 말하자, 린은 당신의 성기 머리에 입술을 가져다 댄다.
			PRINTFORML 「...후우... 방금 움찔했지?」
			PRINTFORML 「괜찮아... 혀로 할 생각 없어...」
			PRINTFORMW 「...혹은... 네가 원하는 거려나?」
			PRINTFORMDL 쾌감에 숨이 차서, 당신은 그저 모호하고 불분명한 소리를 낼 뿐이다.
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「좋아, 네 정직함에 대한 보상으로 주지...♪」
				CASE 1
					PRINTFORML 「음...? 내가 너한테 화난 건 아니야...?」
					PRINTFORML 「만약 네가 기분이 좋을 거라고 생각한다면, 난 그걸 해줄 수 있어서 기뻐...」
				CASE 2
					PRINTFORML 「흥~... 그렇게 고집을 부리다니, 더 단련시켜줘야겠어!」
			ENDSELECT
			PRINTFORML 「...츄우! %RANDKISS("suck")%, %TOLOWER(RANDKISS("suck"))%... 음음... 후우...」
			PRINTFORMW 「괜찮아... 쪽... 만약 느끼기 시작하면... 원할 때 언제든지 해... 음음...」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「너도 이거 정말 즐기고 있지～」
		PRINTFORML 「내 가슴을 그렇게 좋아하게 된 거야?」
		PRINTFORML 「괜찮아... 나도 점점 이게 아주 마음에 들기 시작했어...」
		PRINTFORML 「결국, %K36_BOYO()%, 너의 귀여운 표정들을 많이 볼 수 있잖아... 흥프...!」
		PRINTFORML 「...아후우...냐하... 말랑말랑해...」
		PRINTFORML 「...내가 말했듯이, 정말 귀여운 응답이야♪」
		PRINTFORML 「...그리고 네 그 어쩔 수 없는 표정을 보면... 나도 모르게...」
		PRINTFORMW 「느냐한...! 흥프, 전부 내게 쏟아내줘...! 네가 가진 모든 것을...!」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「음~ 인간들은 여전히 이해하기 어렵다고 생각한다...」
		PRINTFORMDW 린은 그것을 별로 즐기지 않는 것 같다. 아마도 네 성기를 자신의 가슴 사이에 가두는 것이 힘들기 때문일 것이다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
