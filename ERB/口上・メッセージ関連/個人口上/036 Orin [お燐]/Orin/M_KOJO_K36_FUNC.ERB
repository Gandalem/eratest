; Modular ERB: 個人口上/036 Orin [お燐]/Orin/M_KOJO_K36_FUNC.ERB

@K36_BOYO(ARG)
#FUNCTIONS
LOCALS '= PRINT_MALE("boyo:sis", MASTER)
RETURNF ARG ? CAPITALIZE(LOCALS) # LOCALS

@K36_DATEPLACE ;called at "date" (405) and "explore" (604, once per location)
SELECTCASE DATENAME_PLACE(1)
	;人里でデート
	CASE "人間の里"
		IF TALENT:恋人
			PRINTFORML 「여기는 지하세계보다 훨씬 밝고 활기차지 않아요.」
			PRINTFORML 「다음에는 제가 '오래된 지옥'의 메인 거리를 같이 구경해 보시겠어요?」
			PRINTFORMW 「제가 속속들이 다 아니까 최고의 장소들을 전부 보여드릴 수 있어요♪」
		ELSEIF TALENT:恋慕
			PRINTFORML 「음 아니, 여기선 사실 정말 재미있게 지낼 수 있어.」
			PRINTFORML 「하지만 평소엔 일 때문에 여기 오는 거라, 뭐...」
			PRINTFORMW 「그 이유는 아주 많이 다르니까, 이렇게 방문하는 건 기분 전환이 되네♪」
		ELSE
			PRINTFORML 「아이고... 여기 오니까 정말 내 카샤 피가 끓어오르는 것 같아!」
			PRINTFORML 「오냐? 괜찮아, 괜찮아! 시체 사냥하러 도망갈 생각은 없어.」
			PRINTFORMW 「지금 당장은 아니지만 말이야. 그래도 잠시 정찰이라도 할 수는 있겠지... 농담이야, 농담♪」
		ENDIF
		;博麗神社でデート
	CASE "博麗神社"
		IF TALENT:恋人
			PRINTFORML 「소문으로는 들었는데, 이 신사가 정말 행운으로 축복받은 곳인가?」
			PRINTFORML 「너와 이렇게 멋진 분위기 속에서 혼자 시간을 보내다니...」
			PRINTFORMW 「우리 이런 기회가 별로 없는데, 그렇지 않아?」
		ELSE
			PRINTFORML 「지옥에서 온 요괴가 신사에서 데이트를 하다니...」
			PRINTFORML 「참 이상한 상황이지, 동의하지 않나?」
			PRINTFORMW 「하지만 이 특정 신사에 대해서 말하자면, 그리 특이해 보이지는 않는다...」
		ENDIF
		;霧の湖でデート
	CASE "霧の湖～紅魔館"
		IF TALENT:恋人 && DAY:2 != 4
			PRINTFORML 「야아아~나!」
			PRINTFORML 「내 눈을 즐겨 %K36_BOYO()%, 나 너한테 자랑하려고 이 새 수영복 샀어!」
			PRINTFORMW 「음, 귀여워 보여? 아니면 더 섹시하다고 할 거야~?」
		ELSEIF TALENT:恋慕
			PRINTFORML 「다시 생각해 보니, 이곳은 정말 멋지고 상쾌한 분위기가 있네.」
			PRINTFORML 「잠시 조용히 앉아서 풍경을 감상하는 건 어때?」
			PRINTFORMW 「이렇게 편안한 데이트를 하는 것도 가끔은 좋지.」
		ELSE
			PRINTFORML 「소문으로는 들었는데, 여기 근처에 인상적일 정도로 멍청한 요정들이 산다는 게 사실이야?」
			PRINTFORML 「그리고 얼음 요정도 있대...」
			PRINTFORMW 「여기는 수영하러 오기엔 가장 안전하지 않은 장소야! 여러 가지 이유로 말이지...」
		ENDIF
		;花畑でデート
	CASE "迷いの竹林"
		IF TALENT:恋人
			PRINTFORML 「%K36_BOYO(1)%, 우리 이제 도시락 먹을까?」
			PRINTFORML 「에? 내가 만든 건데.」
			PRINTFORMW 「냐하아... 솔직히, 이걸 끝내려고 밤늦게까지 깨 있었어. 그러니 한 입 한 입 음미해야 할 거야♪」
		ELSEIF TALENT:恋慕
			PRINTFORML 「후우... 무슨 이유에선지, 오늘 아주 귀여워 보이네... 그리고 향도 정말 멋지고...」
			PRINTFORML 「후냐아... 조금 졸려지는 것 같아...」
			PRINTFORMW 「%K36_BOYO(1)%, 네 무릎에 머리를 좀 기대게 해줘? 잠깐만? ...Zzzzz...」
		ELSE
			PRINTFORML 「냐헤헤... 여기서 일광욕을 하고 싶은 충동이 드네!」
			PRINTFORML 「하지만 확신할 수는 없어... 마음 한구석에 불길한 예감이 떠오거든...」
			PRINTFORMW 「그럼에도 불구하고, 여기에 누워있는 게 아주 편안하게 느껴져♪」
		ENDIF
		;白玉楼
	CASE "三途の川～冥界"
		IF TALENT:恋人
			PRINTFORML 「헤이, 나를 여기로 데려온 특별한 이유가 있는 건 아니겠지?」
			PRINTFORML 「나 같은 카샤가 이런 말을 한다는 게 얼마나 이상한지는 알지만...」
			PRINTFORMW 「%K36_BOYO()%, 오래 살았으면 좋겠어.」
		ELSEIF TALENT:恋慕
			PRINTFORML 「사실 너에게 말하자면 난 이 장소에 오는 걸 별로 안 좋아해.」
			PRINTFORML 「내 사업을 노리는 경쟁자들이 여기 어딘가에 숨어 있거든. 정확히는 열심히 일하는 사신들이 말이야.」
			PRINTFORMW 「"그런 건 없어"? 니하하, 네가 그렇게 말했잖아 %K36_BOYO()%! 나는 진심으로 동의해♪」
		ELSE
			PRINTFORML 「냐후? %K36_BOYO(1)%, 나한테 죽을 작정이야?」
			PRINTFORML 「어쩌면 네가 날 이곳으로 데려온 건 아주 신선한 시체를 선물하려는 거겠지...」
			PRINTFORMW 「내가 틀렸나? 음, 솔직히 말하면 그냥 농담이었어♪」
		ENDIF
		;月の都
	CASE "夢の世界～月"
		IF TALENT:恋人
			PRINTFORML 「나는 지하세계 출신인데, 여기 달의 수도에 있네, 후후.」
			PRINTFORML 「어떻게 된 일인지 이곳은 매우 신비롭다. 나는 늘 달이 괴물 같은 미트볼 같을 거라고 생각했었는데...」
			PRINTFORMW 「어쨌든 그것이 무엇으로 만들어졌든 상관없어, 재미있으면 됐지♪」
		ELSEIF TALENT:恋慕
			PRINTFORML 「달이라고...? 잠깐, 그 달 말이야?」
			PRINTFORML 「...도대체 어떻게 여기에 오게 된 거지...」
			PRINTFORMW 「가끔 네가 정말 누군지 의심하게 만들어, %K36_BOYO()%...」
		ELSE
			PRINTFORML 「.........」
			PRINTFORML 「.........?」
			PRINTFORMW 「이봐, %K36_BOYO()%... 우리... 어디에 있는 거지...?」
		ENDIF
		;妖怪の山
	CASE "妖怪の山 (山麓)", "妖怪の山 (山頂)"
		IF TALENT:恋人
			PRINTFORML 「유기-오네에상(Yuugi-onee-san)은 아주 오래전에 이곳에 살았고, 저 테็ง구도 여기에 있어.」
			PRINTFORML 「이 산의 물속에 사람들을 그렇게 느긋하게 만드는 무언가가 있을까...」
			PRINTFORMW 「"모든 것은 환상향(Gensokyo)이 다 그런가? 아아, 생각해보니 정말 그렇네."」
		ELSEIF TALENT:恋慕
			PRINTFORML 「여기 근처 어딘가일 거야, 맞지? 예전에 오쿠에 이상한 것들을 넣어뒀던 그 신의 집 말이야?」
			PRINTFORML 「......흠~...」
			PRINTFORMW 「우리가 가서 그들에게 좀 문제를 일으킬까?」
		ELSE
			PRINTFORML 「이곳은 인간들에게 상당히 위험하다고들 하던 곳인데, 그렇지 않아?」
			PRINTFORML 「그래서 %K36_BOYO()%, 너는 이런 곳에 무모하게 발을 들일 만한 그런 사람이군...」
			PRINTFORMW 「...어쩌면 이제 걱정해도 너무 늦었을지도 모르지.」
		ENDIF
		;地霊殿
	CASE "地底"
		IF TALENT:恋人
			PRINTFORML 「만약 우리가 너무 큰 소동을 일으키면, 사토리님께서 매우 화내실 거야...」
			PRINTFORML 「알았어! 그냥 내 방으로 가면 돼!」
			PRINTFORMW 「그리고 분명히 말하는데, 부끄러운 건 절대 안 돼!」
		ELSEIF TALENT:恋慕
			PRINTFORML 「집에 왔어～♪」
			PRINTFORML 「하지만 사실은 아니지, 이번엔 외출 중이니까.」
			PRINTFORMW 「음, 여기까지 왔으니 편히 쉬렴, %K36_BOYO()%♪」
		ELSE
			PRINTFORML 「치레이덴에 온 걸 환영해!」
			PRINTFORML 「...우리가 그냥 우리 집을 방문하는 거라, 이건 정말 데이트 같지는 않네...」
			PRINTFORMW 「뭐, 적어도 이 근처를 구경시켜 줄 수는 있겠지...」
		ENDIF
		;魔法の森
	CASE "魔法の森"
		IF TALENT:恋人
			PRINTFORML 「저 마법사 누나랑 인형 누나가 이 숲에 살고 있지, 그렇지?」
			PRINTFORML 「그걸 감안하면, 여기는 꽤 조용해 보인다.」
			PRINTFORMW 「아, 알겠어. 지금은 근처에 없는 모양이야! 보통은...일 것 같은데.」
		ELSEIF TALENT:恋慕
			PRINTFORML 「여기는 좀 음침하고 불길하네요.」
			PRINTFORML 「사실 저는 이런 곳이 참 좋아요~」
			PRINTFORMW 「신비로운 분위기도 있군요. 오히려 이곳이야말로 요괴에게 완벽한 장소라고 말할 수 있어요!」
		ELSE
			PRINTFORML 「여기가 쉬고 긴장을 풀기에 좋은 장소인 것 같아.」
			PRINTFORML 「가끔 요정이나 요괴를 마주칠 수도 있지만...」
			PRINTFORMW 「대부분 하찮은 존재들이니까 내가 있는 한 모든 게 괜찮을 거야!」
		ENDIF
		;命蓮寺
	CASE "命蓮寺"
		IF TALENT:恋人
			PRINTFORML 「아, 이제 기억났어!」
			PRINTFORML 「맞아, 이건 예전에 타던 배야.」
			PRINTFORMW 「그리고 이건, 니아후우... 놀랍네, 또 이상한 우연이야!」
		ELSEIF TALENT:恋慕
			PRINTFORML 「냐후, 애초에 배였단 말이야?」
			PRINTFORML 「게다가 하늘을 날고 지하세계에 묻혀 있었다니?」
			PRINTFORMW 「절들은 정말 굉장하네...」
		ELSE
			PRINTFORML 「...흠~。」
			PRINTFORML 「저 빨간색이랑 흰색인 언니의 신사와는 다르네. 여기는 어쩐지 불친절한 느낌이야...」
			PRINTFORMW 「요괴를 거부하는 건 아닌 것 같아, 오히려 어떻게 표현해야 할까... 아주 엄숙한 기운이 감돌고 있지?」
		ENDIF
ENDSELECT
