@K36_BOYO(ARG)
#FUNCTIONS
LOCALS '= PRINT_MALE("boyo:sis", MASTER)
RETURNF ARG ? CAPITALIZE(LOCALS) # LOCALS

@K36_DATEPLACE ;called at "date" (405) and "explore" (604, once per location)
SELECTCASE DATENAME_PLACE(1)
;人里でデート
CASE "人間の里"
	IF TALENT:恋人
		PRINTFORML 「It certainly is a lot brighter and more lively around here than in the Underworld, isn't it.」
		PRINTFORML 「Next time, would you like to visit the main street in Old Hell with me?」
		PRINTFORMW 「I know it like the back of my hand, so I can show you all the best spots♪」
	ELSEIF TALENT:恋慕
		PRINTFORML 「Well no, you can actually have a lot of fun here.」
		PRINTFORML 「But normally, I only get to come here for work, and well...」
		PRINTFORMW 「The reason for that is very much different, so visiting like this is a nice change of pace♪」
	ELSE
		PRINTFORML 「Oh boy... Visiting here really gets my kasha blood boiling!」
		PRINTFORML 「Ohnya? It's fine, it's fine! I'm not going to run off on a hunt for corpses.」
		PRINTFORMW 「Not right now, at least. But perhaps I could still do a little reconnaissance... I kid, I kid♪」
	ENDIF
;博麗神社でデート
CASE "博麗神社"
	IF TALENT:恋人
		PRINTFORML 「I've heard through the grapevine, but is this shrine actually blessed with good fortune?」
		PRINTFORML 「Spending some time alone with you, in such a nice atmosphere...」
		PRINTFORMW 「We seldom have a chance to do this, do we?」
	ELSE
		PRINTFORML 「A youkai from Hell going on a date at a shrine...」
		PRINTFORML 「'Tis very much the strange situation, don't you agree?」
		PRINTFORMW 「But, if we're talking about this particular shrine, it doesn't seem quite as outlandish...」
	ENDIF
;霧の湖でデート
CASE "霧の湖～紅魔館"
	IF TALENT:恋人 && DAY:2 != 4
		PRINTFORML 「Jyajyaaaa～n!」
		PRINTFORML 「Feast your eyes %K36_BOYO()%, I bought this new swimsuit just to show off for you!」
		PRINTFORMW 「Well, does it make me look cute? Or, would you say it's more sexy～?」
	ELSEIF TALENT:恋慕
		PRINTFORML 「Now that I think about it some more, this place actually has a cool, refreshing atmosphere.」
		PRINTFORML 「Shall we sit quietly and take in the scenery for a while?」
		PRINTFORMW 「Having a relaxing date like this can be nice, once in a blue moon.」
	ELSE
		PRINTFORML 「I've heard through the grapevine, but isn't it true that some impressively stupid fairies live around here?」
		PRINTFORML 「And one's an ice fairy, as well...」
		PRINTFORMW 「This is not the safest place to go for a swim! For multiple reasons...」
	ENDIF
;花畑でデート
CASE "迷いの竹林"
	IF TALENT:恋人
		PRINTFORML 「%K36_BOYO(1)%, shall we have our bento now?」
		PRINTFORML 「Eh? I'm the one who made it.」
		PRINTFORMW 「Nyahaa... Truthfully, I ended up staying up late to finish it. So you had better savor every bite♪」
	ELSEIF TALENT:恋慕
		PRINTFORML 「Fwuuh... For some reason, you look very much cute today... And you smell very much wonderful...」
		PRINTFORML 「Funyaaa... I'm getting, a little sleepy...」
		PRINTFORMW 「%K36_BOYO(1)%, let me rest my head in your lap? Just for a bit? ...Zzzzz...」
	ELSE
		PRINTFORML 「Nyaheh... I get an urge to sunbathe here!」
		PRINTFORML 「But, I'm not certain... There's an ominous premonition in the back of my mind...」
		PRINTFORMW 「Even still, lounging here feels very much relaxing♪」
	ENDIF
;白玉楼
CASE "三途の川～冥界"
	IF TALENT:恋人
		PRINTFORML 「Hey, you don't mean anything in particular by bringing me here, do you?」
		PRINTFORML 「I know how odd it is for a kasha like me to say something like this, but...」
		PRINTFORMW 「I want you to live a long life, %K36_BOYO()%.」
	ELSEIF TALENT:恋慕
		PRINTFORML 「To tell you the truth, I don't very much like coming to this place.」
		PRINTFORML 「Because there's competitors for my business lurking around here. A hard-working shinigami, to be precise.」
		PRINTFORMW 「"There's no such thing"? Nyahaha, you said it %K36_BOYO()%! I wholeheartedly agree♪」
	ELSE
		PRINTFORML 「Nyahuh? %K36_BOYO(1)%, are you planning to kick the bucket on me?」
		PRINTFORML 「Perhaps the fact you brought me here is because you're planning to gift me a particularly fresh corpse...」
		PRINTFORMW 「I'm wrong? Well, to tell you the truth, I was just kidding♪」
	ENDIF
;月の都
CASE "夢の世界～月"
	IF TALENT:恋人
		PRINTFORML 「I'm from the Underworld, but here I am in the Lunar Capitol, huh.」
		PRINTFORML 「Somehow, it's very much mysterious here. I always assumed the moon was like a monstrous meatball...」
		PRINTFORMW 「Anyway, there's no matter what it's made of, as long as it's fun♪」
	ELSEIF TALENT:恋慕
		PRINTFORML 「The moon, you say... Wait, THE moon?」
		PRINTFORML 「...How in the world did we even get here...」
		PRINTFORMW 「Sometimes you make me question just who you really are, %K36_BOYO()%...」
	ELSE
		PRINTFORML 「.........」
		PRINTFORML 「.........?」
		PRINTFORMW 「Hey, %K36_BOYO()%... Where... are we...?」
	ENDIF
;妖怪の山
CASE "妖怪の山 (山麓)", "妖怪の山 (山頂)"
	IF TALENT:恋人
		PRINTFORML 「Yuugi-onee-san used to live here long ago, and that tengu is here, as well.」
		PRINTFORML 「I wonder if there's something in the water on this mountain that makes people have such easygoing personalities...」
		PRINTFORMW 「"All of Gensokyo's like that"? Ahhh, now that I think about it, that's very much true.」
	ELSEIF TALENT:恋慕
		PRINTFORML 「It's somewhere around here, right? The home of that god that stuck weird stuff in Okuu back then?」
		PRINTFORML 「......Hmmmm～...」
		PRINTFORMW 「Should we go and make a little trouble for them?」
	ELSE
		PRINTFORML 「It's said that this place is quite dangerous for humans, isn't it?」
		PRINTFORML 「So %K36_BOYO()%, you're the kind of guy who would recklessly trespass in a place like this...」
		PRINTFORMW 「...Maybe it's a little too late to be worried about that.」
	ENDIF
;地霊殿
CASE "地底"
	IF TALENT:恋人
		PRINTFORML 「If we make too much of a mess, Satori-sama will be very angry...」
		PRINTFORML 「I've got it! We can just go to my room!」
		PRINTFORMW 「And just so it's clear, absolutely no naughty stuff!」
	ELSEIF TALENT:恋慕
		PRINTFORML 「I'm home～♪」
		PRINTFORML 「But not actually, since it's a day out this time.」
		PRINTFORMW 「Well, since you came all this way, go ahead and make yourself comfortable, %K36_BOYO()%♪」
	ELSE
		PRINTFORML 「Welcome to Chireiden!」
		PRINTFORML 「...This doesn't really feel like a date, since we're just visiting my home...」
		PRINTFORMW 「Well, I can at least show you around the place, I suppose...」
	ENDIF
;魔法の森
CASE "魔法の森"
	IF TALENT:恋人
		PRINTFORML 「Both that magician onee-san and that doll onee-san live in this forest, right?」
		PRINTFORML 「Taking that into consideration, it seems pretty quiet here.」
		PRINTFORMW 「Ah, I get it. They must not be around right now! I bet usually, it's...」
	ELSEIF TALENT:恋慕
		PRINTFORML 「It seems a bit gloomy and foreboding around here, doesn't it.」
		PRINTFORML 「I'm actually quite fond of places like this～」
		PRINTFORMW 「There's an air of mystery, too. If anything, I'd say this place is a perfect fit for youkai!」
	ELSE
		PRINTFORML 「This seems like it might be a good place to kick back and relax.」
		PRINTFORML 「You might bump into some fairies or youkai from time to time, but...」
		PRINTFORMW 「They're mostly small fry, so as long as I'm here everything will be fine!」
	ENDIF
;命蓮寺
CASE "命蓮寺"
	IF TALENT:恋人
		PRINTFORML 「Ah, now I remember!」
		PRINTFORML 「That's right, this is the ship from back then.」
		PRINTFORMW 「And this is, nyahuuh... How surprising, another strange coincidence!」
	ELSEIF TALENT:恋慕
		PRINTFORML 「Nyahuh, it was a ship all along?」
		PRINTFORML 「And even more, it flies in the sky, and it used to be buried in the Underworld?」
		PRINTFORMW 「Temples certainly are incredible...」
	ELSE
		PRINTFORML 「...Hmmm～.」
		PRINTFORML 「It's different from that red-and-white onee-san's shrine. This one feels somehow unfriendly...」
		PRINTFORMW 「It's not that it rejects youkai, it's more like, how best to put it... It has a very solemn air about it?」
	ENDIF
ENDSELECT
