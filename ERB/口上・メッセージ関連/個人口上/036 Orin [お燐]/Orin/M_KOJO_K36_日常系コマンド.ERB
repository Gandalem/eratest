;==================================================
@M_KOJO_EGG_SUCCESS_COM_K36_302
;成否判定
;TFLAG:192(-2=指令終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_EGG_MESSAGE_COM_K36_302
CALL M_KOJO_EGG_MESSAGE_COM_K36_302_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「%K36_BOYO(1)%, I'll give you special permission to pet me!」
		PRINTFORML 「So, with Satori-sama, Okuu, and Koishi-sama... And now you, that makes four.」
		PRINTFORMW 「You're the only members of an elite club, so consider yourself honored!」
	ELSE
		IF TALENT:恋人 && RAND:4
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「Nyaaaーn♪」
					PRINTFORMDL Rin lets out a delighted meow as she uses your lap for her pillow, even though she's still in human (?) form.
					PRINTFORML 「Nyehehe... This time it's your turn to be the pillow～」
					PRINTFORMDW She gives a noncommittal comment about "next time we can switch" as she indulges in rubbing her cheeks all over your thighs.
				CASE 1
					PRINTFORML 「～♪ ～～♪」
					PRINTFORMDL Rin sticks to you like glue, her limber body curving and coiling to maximize the amount of contact area.
					PRINTFORML 「Mm? Tight spaces very much suit me. It's a cat thing.」
					PRINTFORMW 「Besides, this isn't so bad, is it? It seems appropriate for lovers～」
				CASE 2
					PRINTFORML 「%K36_BOYO(1)%ー, you really think of me as nothing more than you cute little pet kitty, don't you?」
					PRINTFORML 「Well, I suppose you aren't completely off the mark.」
					PRINTFORML 「But even still, I would very much prefer for you to treat me like a proper lover.」
					PRINTFORMDW Maybe she says that, but her purring is so loud that it seems to contradict herself.
				CASE 3
					PRINTFORML 「Hmmphー... Staying in human form all the time is very much tiring. What a pain～」
					PRINTFORMDL Rin transforms back into a cat and shamelessly steals your lap.
					PRINTFORMDW You've got no choice, you start softly stroking her as she lies there purring.
			ENDSELECT
		ELSEIF CFLAG:2 >= 1500
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%K36_BOYO(1)%, %K36_BOYO()%!」
					PRINTFORMDL Rin calls out to you repeatedly, while patting on the floor beside her with a brook-no-compromises expression.
					PRINTFORMDW Curious what's the matter, you oblige her and sit down. Then she immediately transforms into a cat and crawls into your lap...
				CASE 1
					PRINTFORML 「Come・here・%PRINT_MALE("bo・yo:sis", MASTER)%～」
					PRINTFORMDL Rin hugs you, deliberately pressing her chest into you with an impish grin on her face.
					PRINTFORML 「Hmphー, that wasn't very much of a reaction...」
					;this line had to be altered, since we're going with "boyo" for her way of addressing the player rather than "onii-san"
					PRINTFORML 「Wah!? Could it be, that you're a dog person!?」
					PRINTFORMDW Hey now, what a bald-faced accusation...
				CASE 2
					PRINTFORML 「...Sniff sniff...」
					PRINTFORML 「%K36_BOYO(1)%, could that be perfume I smell?」
					;there are a couple of living situations for which this isn't true, but I'm not interested in working out the code to handle the exceptions
					PRINTFORML 「Well, I suppose you are living under the same roof as a girl, after all.」
					PRINTFORMW 「And I don't dislike the scent, in fact I think it's nice for you to be considerate like this♪」
				CASE 3
					PRINTFORMDW You lightly pet Rin, stroking her cheek and tickling her under her chin.
					PRINTFORMDW She fawns over you in return, purring like a motorboat.
			ENDSELECT
		ELSE
			IF RAND:2
				PRINTFORML 「Purr purr purr...」
				PRINTFORML 「Whaa!?」
				PRINTFORML 「I am not a cat!」
				PRINTFORMW 「Well, fine, I'm a cat, but I'm also a hell-born corpse-cart driver!」
			ELSE
				PRINTFORMDL You try waving around a fluffy cat toy in front of Rin while she's in cat form.
				PRINTFORMDW She can't resist and desperately chases after it, trying to catch the tip between her paws.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
