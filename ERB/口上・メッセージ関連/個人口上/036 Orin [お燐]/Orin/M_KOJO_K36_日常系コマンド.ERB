;CFLAG:性格傾向による地の文分岐あり
;==================================================
@M_KOJO_EGG_MESSAGE_COM_K36_626
CALL M_KOJO_EGG_MESSAGE_COM_K36_626_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:194 >= 1
		PRINTFORML 「Fueh? A present?」
		PRINTFORML 「Now we're both indebted to each other...」
		PRINTFORMW 「But, I'm very much happy about it. Thank you, %K36_BOYO()%♪」
		
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:36:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 装飾
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
	ENDIF

	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
		;(GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
		;やっぱりやめる（見送り）
		CASE -1
		
		;400点未満（BAD）
		CASE 1
		
		;400点～699点（NOMAL）
		CASE 2, 3
			IF STRFIND(RESULTS:1, "装飾") >= 0
				IF TALENT:恋人
					PRINTFORML 「Nyaha～...」
					PRINTFORML 「You remembered when I asked for a bell a while back, didn't you!」
					PRINTFORMW 「Whenever I wear this, it'll show that I belong to you♪」
				ELSEIF TALENT:恋慕
					PRINTFORML 「Hmmnyaー, I should make sure to keep this locked away, so it doesn't get stolen...」
					PRINTFORMW 「But, I want to wear it, because having something only matters if you use it... Hmmm... What a pickle...」
				ELSE
					PRINTFORML 「I think this kind of flashy thing is much more suited to Okuu...」
					PRINTFORMW 「But, I'm still pleased. Thank you, %K36_BOYO()%♪」
				ENDIF
			ELSEIF strReaction == "身につける"
				IF TALENT:恋人
					PRINTFORML 「Ohnya, hey hey! Next time let's shop together!」
					PRINTFORML 「That way I can get a gift for you at the same time!」
					PRINTFORMW 「I think that would be a wonderful idea. It can double as a date♪」
				ELSEIF TALENT:恋慕
					PRINTFORML 「Jyajyaaaa～n!」
					PRINTFORMW 「Well? Is it cute? Is it cute??」
				ELSE
					PRINTFORML 「If this is for me to wear, you must have needed to get it custom-tailored to accommodate my tail.」
					PRINTFORMW 「Thank you so much for going to the trouble, %K36_BOYO()%♪」
				ENDIF
			ELSE
				IF TALENT:恋人
					PRINTFORML 「Little by little, my room is filling with presents...」
					PRINTFORMW 「But but, I'm very much worried about them getting broken, and I don't want to throw them away!」
				ELSEIF TALENT:恋慕
					PRINTFORML 「Yeah, I'll treasure this.」
					PRINTFORMW 「It's so nice to get a gift from you, and it's also very practical. Just like killing two birds with one stone♪」
				ELSE
					PRINTFORML 「This one from the surface definitely feels more modern than the one back at home.」
					PRINTFORMW 「Thanks. This will be very much useful!」
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

