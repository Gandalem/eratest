;626,土産屋
;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================

@M_KOJO_EGG_MESSAGE_COM_K36_626
CALL M_KOJO_EGG_MESSAGE_COM_K36_626_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:194 >= 1
		PRINTFORML 「에헤? 선물이란 거야?」
		PRINTFORML 「이제 우리 둘 다 서로에게 신세야...」
		PRINTFORMW 「하지만 난 정말 기뻐. 고마워, %K36_BOYO()%♪」
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:36:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 装飾
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
	ENDIF
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			;(GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
			;やっぱりやめる（見送り）
		CASE -1
			;400点未満（BAD）
		CASE 1
			;400点～699点（NOMAL）
		CASE 2, 3
			IF STRFIND(RESULTS:1, "装飾") >= 0
				IF TALENT:恋人
					PRINTFORML 「냐하～...」
					PRINTFORML 「예전에 벨 달라고 했을 때 기억하고 있었지!」
					PRINTFORMW 「이걸 하고 있으면 내가 당신의 것이라는 걸 보여주게 될 거야♪」
				ELSEIF TALENT:恋慕
					PRINTFORML 「음냐ー, 이걸 꼭 숨겨둬야 할 것 같아, 도둑맞지 않게...」
					PRINTFORMW 「하지만 입고 싶어, 무언가는 사용해야 가치가 있으니까... 음... 난감하네...」
				ELSE
					PRINTFORML 「이런 화려한 건 오쿠우에게 훨씬 더 어울린다고 생각하는데...」
					PRINTFORMW 「하지만 그래도 기쁘다. 고마워, %K36_BOYO()%♪」
				ENDIF
			ELSEIF strReaction == "身につける"
				IF TALENT:恋人
					PRINTFORML 「오냐, 헤이헤이! 다음엔 같이 쇼핑하자!」
					PRINTFORML 「그렇게 하면 나도 너한테 선물 사줄 수 있잖아!」
					PRINTFORMW 「정말 멋진 생각인 것 같아. 데이트로도 할 수 있으니까♪」
				ELSEIF TALENT:恋慕
					PRINTFORML 「야야아~n!」
					PRINTFORMW 「어때? 귀엽지? 귀여워??」
				ELSE
					PRINTFORML 「이게 나한테 입으려면 내 꼬리에 맞게 특별히 재단해야 했을 거 아냐.」
					PRINTFORMW 「수고해 주셔서 정말 고마워, %K36_BOYO()%♪」
				ENDIF
			ELSE
				IF TALENT:恋人
					PRINTFORML 「조금씩, 내 방이 선물들로 가득 차고 있어...」
					PRINTFORMW 「하지만, 혹시나 부서질까 봐 너무 걱정되고, 버리고 싶지도 않아!」
				ELSEIF TALENT:恋慕
					PRINTFORML 「응, 이거 소중히 간직할게.」
					PRINTFORMW 「당신에게 선물 받으니 정말 기쁘고 실용적이기도 해. 일석이조네♪」
				ELSE
					PRINTFORML 「이쪽 표면에서 온 건 집에서 먹던 것보다 확실히 더 현대적인 느낌이다.」
					PRINTFORMW 「고맙다. 이거 아주 유용할 거야!」
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
