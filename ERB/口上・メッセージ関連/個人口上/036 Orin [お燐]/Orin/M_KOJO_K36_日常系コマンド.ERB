;==================================================
@M_KOJO_EGG_SUCCESS_COM_K36_301
;成否判定
;TFLAG:192(-2=指令終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_EGG_MESSAGE_COM_K36_301
CALL M_KOJO_EGG_MESSAGE_COM_K36_301_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_301_1
#DIM 给K36初次泡茶
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 给K36初次泡茶 == 0
		PRINTFORML 「Tea for me? I appreciate it, %K36_BOYO()%. I was a bit thirsty after all.」
		给K36初次泡茶 = 1
		RETURN 0
	ENDIF
	IF TFLAG:193 > -1
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「Nyaa～～ This goes down so very well～」
				PRINTFORML 「You must be skilled at serving tea, aren't you %K36_BOYO()%?」
			CASE 1
				PRINTFORML 「Nyaammm～～ It wouldn't hurt to have a sip of tea.」
				PRINTFORML 「A cup of hot tea after work is wonderfully refreshing～」
			CASE 2
				PRINTFORML 「Nyaammm～～ Your tea is always so great, %K36_BOYO()%～」
				PRINTFORML 「I wonder how you prepare tea this well. Please spare a little for Okuu some time.」
			CASE 3
				PRINTFORML 「Ohnya? Thank you very much for the tea, %K36_BOYO()%～」
				PRINTFORML 「There's no tea cultivation to speak of in the Underworld, so you may not find any there.」
				PRINTFORML 「Although, the palace is an exception.」
			CASE 4
				PRINTFORML 「Ahnya, a bit of tea? Thank you, %K36_BOYO()%～」
				PRINTFORMDL Rin drinks the entire cup...
				PRINTFORML 「Haaa～～」
				PRINTFORML 「This tea is great! Much much better than the middling tea served at the shrine.」
				PRINTFORML 「%K36_BOYO(1)%, make some more so that I may bring back a bit for Satori-sama, I beg you!」
		ENDSELECT
	ELSE
		PRINTFORML 「Tea? Don't mind if I do～」
		PRINTFORMDW Rin takes a sip. 
		PRINTFORMDL Suddenly hissing, Rin jumps back and wipes her mouth.
		PRINTFORML 「Ehhh... This may be a bit too bitter, don't you think?」
	ENDIF
ENDIF
RETURN 1
