;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:烂醉(1=通常成功or大失敗)
;==================================================
@M_KOJO_EGG_SUCCESS_COM_K36_300
;成否判定
;TFLAG:192(-2=指令終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_EGG_MESSAGE_COM_K36_300
;指令共通メッセージ(TRAIN_MESSAGE) 
;削除すると 「～说着话。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_EGG_MESSAGE_COM_K36_300_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF TFLAG:193 == -1
		SELECTCASE RAND:3 ;custom code
			CASE 0
				PRINTFORML 「You mustn't force yourself to talk to me, %K36_BOYO()%～」
				PRINTFORML 「Wait a while. You'll have a topic in no time.」
			CASE 1
				PRINTFORMDL You want to say something, but your mind draws a blank.
				PRINTFORML 「Nyahaha～! It's alright, %K36_BOYO()%.」
				PRINTFORML 「Just relax, we have plenty of time to talk over tea.」
			CASE 2
				PRINTFORML 「There's no need to try to force a conversation, %K36_BOYO()%.」
				PRINTFORML 「Nobody's born with some innate gift for endless wit.」
				PRINTFORML 「Give yourself a bit of time.」
		ENDSELECT
	ELSE
		IF TALENT:恋人 && RAND:6
			SELECTCASE RAND:6
				CASE 0
					PRINTFORML 「Lovers... We're lovers, hmmm...」
					PRINTFORML 「Nyafu～... Nyaaa～...aaaaahn!?」
					PRINTFORMDL It seems like you might have interrupted her in the midst of some fantasizing.
					PRINTFORMDW If she's that wrapped up about your relationship, it'll start to make you embarrassed too...
				CASE 1
					PRINTFORML 「Hmmm, %K36_BOYO()%...」
					PRINTFORML 「About how I've always called you %K36_BOYO()%, do you very much mind if I keep calling you that?」
					PRINTFORML 「But any way I look at it, %K36_BOYO()% just seems to suit you, so I suppose it must be fine...」
					PRINTFORMW 「Ahnya, %K36_BOYO()%♪」
				CASE 2
					PRINTFORML 「At this point, I might as well just move up to the surface to be with you.」
					PRINTFORML 「Satori-sama's pets are more or less already free-range, so she should find it acceptable.」
					PRINTFORML 「But, I suppose I might not get to see Okuu very often anymore...」
					PRINTFORMW 「What about it, %K36_BOYO()%? Throw in your two cents?」
				CASE 3
					PRINTFORML 「I wonder %K36_BOYO()%, what are your thoughts about...」
					PRINTFORML 「......You know, animal features?」
					PRINTFORML 「Ah, let me clarify. It's not my intent to look down on your humanity or any such thing.」
					PRINTFORMW 「It's just... I'm "that kind" of youkai, after all. I was merely curious!」
				CASE 4
					PRINTFORML 「Just suppose, if I were to move up to the surface world with you.」
					PRINTFORML 「I have a feeling that red shrine maiden would speak up about it...」
					PRINTFORML 「But if we ply her with alcohol on the regular, that should appease her.」
					PRINTFORML 「And if you toss a coin or two into her offertory box, it'll be perfect！ I'm certain of it.」
					PRINTFORMDW What a terrible thing to say. It's hard to argue with her reasoning, though...
				CASE 5
					PRINTFORML 「I've been in a bind until now, because corpses have always been the only company I keep.」
					PRINTFORML 「I haven't had very many opportunities to have a proper chat like this with someone...」
					PRINTFORML 「If I had gotten in the habit of getting out and socializing sooner, I wonder if I would have already had a lover before you came along?」
					PRINTFORMW 「Ahnya～ Did that rub you the wrong way, %K36_BOYO()%? I kid, I kid♪」
			ENDSELECT
		ELSEIF TALENT:恋慕 && RAND:6
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「Ahnya, %K36_BOYO()%!」
					PRINTFORML 「Why don't you come have some fun in the Underworld one of these days?」
					PRINTFORML 「I'll introduce you to Satori-sama and everyone... Ah, wait...」
					PRINTFORMDW Suddenly, she lets out a flummoxed groan. What's that about?
				CASE 1
					PRINTFORML 「%K36_BOYO(1)%! %K36_BOYO(1)%～ %K36_BOYO(1)%!」
					PRINTFORMDL Out of nowhere, Rin suddenly clings to your arm and calls out to you repeatedly.
					PRINTFORML 「Ahnya...? I can't remember now, it completely slipped my mind... Oh well, no matter♪」
					PRINTFORMDW Seemingly satisfied with that excuse, she ignores your bewilderment and keeps your arm trapped firmly in her clutches.
				CASE 2
					PRINTFORML 「To tell the truth, life down in the Underworld is very much pleasant!」
					PRINTFORML 「With thanks to Okuu, hot springs are near to hand...」
					PRINTFORML 「Eh? Do I really like hot springs?」
					PRINTFORMW 「Why, do you think that's something strange?」
				CASE 3
					PRINTFORML 「Anyway, I was very much worried what would happen to Okuu after she became like that.」
					PRINTFORML 「I'm glad the inhabitants of Gensokyo tend to be so open-minded these days.」
					PRINTFORML 「Many of the residents of Old Hell were unpopular to start with, so it's nice when people are understanding.」
					PRINTFORMW 「Even still, I never imagined a human as open-minded as you could exist.」
				CASE 4
					;The Japanese line here has a pun that's just impossible to translate
					PRINTFORML 「I'm a hell-for-leather cart cat! Now that red shrine maiden on the other hand, she's just hellishly broke.」
					PRINTFORML 「So, %K36_BOYO()%, you don't have to worry your pretty little head, I'll always keep you safe and sound♪」
					PRINTFORMDW ...You're not sure how exactly that's supposed to be reassuring...
			ENDSELECT
		ELSE
			SELECTCASE RAND:15
				CASE 0
					PRINTFORML 「Nyaa～ Nothing interesting has happened recently.」
					PRINTFORMDL Rin arches her back with a stretch.
				CASE 1
					PRINTFORML 「There are always more and more pets in the palace! Satori-sama keeps taking them home!」
					PRINTFORMDL You ponder if any of them are like Rin.
					PRINTFORML 「Ohnya? There are other felines, but I'll have you know I'm Satori-sama's favorite!」
				CASE 2
					PRINTFORMDL You wonder why it is that of all Satori's pets you only ever see Rin and Utsuho around.
					PRINTFORML 「Ohnya? There are very few pets that can turn human like Okuu and I can.」
					PRINTFORML 「Not all animals have the energy to. It certainly is difficult to stay human for any great length of time.」
				CASE 3
					PRINTFORMDW You muse about how Rin can live in the hot climate of the palace.
					PRINTFORML 「Nyahaha～ That scorching heat must be unbearable for an ordinary human.」
					PRINTFORML 「It must really seem to you as if it were summer all year round, eh %K36_BOYO()%?」
				CASE 4
					PRINTFORMDL You wonder how Rin came to join the Komeiji household.
					PRINTFORML 「Well, Okuu and I were originally strays on the streets of Old Hell.」
					PRINTFORML 「Satori-sama found the crow and the cat, and brought them into the palace.」
					PRINTFORML 「Ah, but this hobby of Satori-sama's has become a bit of a problem...」
				CASE 5
					PRINTFORML 「Ohoho-nya, daring to try some local liquor, %K36_BOYO()%?」
					PRINTFORML 「Onikoroshi——the oni slaying sake～～ The Oni love to down it dry, but you may meet your doom after just a drop!」
				CASE 6
					PRINTFORML 「Hm? Ahnya, these wisps are what you humans refer to as 'vengeful spirits'. It's my job to keep them under control.」
					PRINTFORMDL You wonder what it's like being a vengeful spirit.
					PRINTFORML 「Eh? Well, for starters, you can never re-enter the karmic cycle of reincarnation.」
					PRINTFORML 「If you ever seriously consider it, you would certainly be safe, sheltered and secure.」
				CASE 7
					PRINTFORML 「Is my work much too difficult, %K36_BOYO()%? Hmmm... I suppose I'm never in any terrible trouble.」
					PRINTFORML 「Ahnya, but are you familiar with those who meet death by drowning?」
					PRINTFORML 「Their bodies fill up with water and expand like bread. It's weary work to wring the bodies dry before wheeling them away.」
					PRINTFORML 「Nevertheless, such is the duty of a corpse-carting kasha!」
				CASE 8
					PRINTFORML 「My work is very much easier in the winter～」
					PRINTFORML 「Exposure to the summer elements leaves bodies to rapid rot.」
					PRINTFORML 「By comparison, it's a simple task to fetch then when frozen finely.」
				CASE 9
					PRINTFORML 「Now that I think about it... You're very much weird %K36_BOYO()%～」
					PRINTFORML 「Normal humans find matters of the dead horrifying.」
					PRINTFORML 「But it seems this little kitten has no fear of the kasha?」
				CASE 10
					PRINTFORML 「Nyaa? What I would like to eat?」
					PRINTFORML 「There's a sweets shop in the village that serves the most sugary sponge cakes～～」
					PRINTFORMDW Rin twirls her tails around, drooling at the thought of them.
					PRINTFORML 「Surprised that the answer wasn't souls or skeletons? Bleh, I would never!」
				CASE 11
					PRINTFORMW 「Tell you a story about the Underworld? Well then, how about you tell me a story about the surface world first? It's a fair trade～」
				CASE 12
					PRINTFORML 「Up here on the surface, the sun sure is snug and satisfying, isn't it.」
					PRINTFORMW 「That incident regarding Okuu, that was a little different...」
				CASE 13
					PRINTFORML 「Come to think of it, that ship phantom did first appear in the underground, didn't she?」
					PRINTFORML 「Yeah, I was aware. But my responsibility was to manage the vengeful spirits.」
					PRINTFORMW 「Furthermore, since she was so strong and still had her sense of self, there was nothing I could do about her.」
				CASE 14
					PRINTFORML 「Satori-sama has many pets you know, even aside from myself and Okuu.」
					PRINTFORML 「I lend a hand to take care of them, but...」
					PRINTFORML 「For a pet to take care of other pets is a bit...」
					PRINTFORMDW Neither of you say it aloud, but you can tell the next like would be "not to mention the bird-brain shikigami of the shikigami"...
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
