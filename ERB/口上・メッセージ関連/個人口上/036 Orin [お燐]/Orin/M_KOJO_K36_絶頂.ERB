;-------------------------------------------------
;After reaching certain threshold for palams for the first time
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;don't show if unconscious
SIF FLAG:70 || !SHIRAHU(TARGET)
	RETURN 0
SIF CFLAG:うふふ != 1 ;don't show stuff below unless having sex
	RETURN 0
;-------------------------------------------------
;初めて潤滑がLV2超えた
;-------------------------------------------------
IF PALAM:潤滑 + UP:潤滑 > PALAMLV:2 && FIRSTTIME("潤滑V2")
	IF IS_SELECTCOM("ローション")
		PRINTFORMW 「으윽... 너무 끈적해...」
		PRINTFORMDW 린은 비에 흠뻑 젖은 작은 고양이처럼 몸을 떨었다.
	ELSEIF TALENT:恋慕
		PRINTFORMW 「냐하하하, 나를 봐... 벌써 완전히 흠뻑 젖었어... 정말 귀찮아~」
		PRINTFORMDW 린의 넥타르는 이미 너무 넘쳐서 허벅지를 타고 흘러 바닥에 작은 물웅덩이를 만들었다.
	ELSE
		PRINTFORMW 「흐음... 후와... 조금 기분이 좋아지는 것 같아...」
		PRINTFORMDW 린은 얼굴이 붉어지는 것을 숨기려 당황하며 몸을 뒤척였다.
	ENDIF
ENDIF
;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
IF PALAM:欲情 + UP:欲情 > PALAMLV:3 && FIRSTTIME("欲情V2")
	IF IS_SELECTCOM("媚薬")
		PRINTFORMW 「흐으음... 야아... 기분이 좋아져, 아앙... 뜨거워... 후와아앙...」
		PRINTFORMDW 당신은 린의 눈이 풀리고 그녀의 표정이 욕망으로 점점 더 취해가는 것을 알아챈다.
	ELSE
		PRINTFORMW 「흐응... 이거 안 좋은데... 나 이것에 너무 깊이 빠지고 있는 것 같아...」
	ENDIF
ENDIF
;-------------------------------------------------
;初めて恥情がLV2超えた
;-------------------------------------------------
IF PALAM:恥情 + UP:恥情 > PALAMLV:3 && FIRSTTIME("恥情V2")
	PRINTFORML
	PRINTFORMDW 어쩌면 네 눈이 너를 속이고 있는 것일지도 모르지만, 린의 뺨은 머리카락과 맞설 정도로 깊은 붉은빛으로 물들어 보인다.
ENDIF
;-------------------------------------------------
