;==================================================
;91,アナル舐めされる
;==================================================

@M_KOJO_EGG_MESSAGE_COM_K36_91
CALL M_KOJO_EGG_MESSAGE_COM_K36_91_1
RETURN RESULT

@M_KOJO_EGG_MESSAGE_COM_K36_91_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「크으... 거기 핥아주는 건 상관없는데, 네 엉덩이가 더러워진 건 내 잘못은 아니니까 알겠지?」
		PRINTFORMW 「이제부터 화장실 갈 때마다 고통스러울 수도 있어... 냐하...」 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:2
			PRINTFORMW 「음~ 흠.... 더 깊숙이 파고들어서, 안쪽까지 기분 좋게 해줄 거야아아～」
			PRINTFORMW 「내가 이렇게 하는 걸 정말 좋아하나 봐... 쪽!」
		ELSE
			PRINTFORMW 「%FSYN("lips_over")%, 네 엉덩이... 너무 귀여워서 미칠 것 같아~」
			PRINTFORMW 「Nlamn... 추우, 주우... 핥기-핥기...」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「음... 푸안, 밀름ㄴㄴ... 후우!」
		PRINTFORMW 「어때, %K36_BOYO()%? 기분 좋아?」 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「음흠, 후우... 꿀꺽... 핥는 소리...」
		PRINTFORMW 「이게... 정말 기분이 좋아지게 하는 걸까?」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
