	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲惫
		PRINTFORML 「냐아아... 후와아...」
		PRINTFORML 「냐하하하, 이번엔 우리가 좀 심하게 나갔던 것 같아!」
		PRINTFORMDW 가쁜 숨을 몰아쉬는 와중에도 Rin은 여전히 너에게 이를 드러내며 미소 지을 힘을 짜낸다.
		PRINTFORMW 「있지, 잠깐만 빌릴게, 응?」
		PRINTFORMDL 허락을 기다리지 않고 Rin은 네 팔을 잡아 베개 삼아 너에게 파고든다.
		PRINTFORMW 「음... 이렇게 좀 더 있어도 될까...」
		PRINTFORMDW 머지않아 그녀의 숨소리가 옆에서 느리고 평화롭게 들린다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		PRINTFORML 「시체 나르는 건 상관없지만...」
		PRINTFORMDL 린은 너의 구겨진 옷을 만지작거리며 조금 다듬어주고는 미소를 지으며 너를 바라본다.
		PRINTFORML 「%K36_BOYO(1)%, 너랑 함께 있는 게 훨씬 더 재미있잖아.」
		PRINTFORMDW 너는 그녀의 턱 밑을 가볍게 간지럽히자, 그녀의 눈이 즐거움으로 뒤집히며 깊은 골골송을 낸다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを被逆推た
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
