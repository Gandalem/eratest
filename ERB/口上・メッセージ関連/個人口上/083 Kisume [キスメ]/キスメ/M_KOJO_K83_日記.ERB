CALL M_KOJO_DIARYSETTING_K83(14)
CALL M_KOJO_DIARYSETTING_K83(15)
CALL M_KOJO_DIARYSETTING_K83(16)
;汎用
SIF ABL:[[キスメ]]:親密 >= 1 && ABL:[[ヤマメ]]:親密 >= 1
