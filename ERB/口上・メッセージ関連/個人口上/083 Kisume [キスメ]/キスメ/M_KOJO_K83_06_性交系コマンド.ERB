;61,後背位
;==================================================

@M_KOJO_MESSAGE_COM_K83_61
CALL M_KOJO_MESSAGE_COM_K83_61_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_61_1
;-------------------------------------------------
;後背位＆立ち位共通
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF TCVAR:[[キスメ]]:破瓜 == 1
		CALL M_KOJO_K83_VIRGIN
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%」
		CALL M_KOJO_K83_NAKADASHI
	ELSE
		PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%」
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「흐으윽…… 기분 좋아서…… 안 돼...!」
			CASE 2
				PRINTFORMW 「응아앗, 더...!! 박아줘...!」
			CASE 3
				PRINTFORMW 「흐윽! 헉, 깊은……앗!」
			CASE 4
				PRINTFORMW 「흐윽, 흐윽, 더, 더……!」
			CASEELSE
				PRINTFORMW 「앗, 하윽, 거칠어……!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
