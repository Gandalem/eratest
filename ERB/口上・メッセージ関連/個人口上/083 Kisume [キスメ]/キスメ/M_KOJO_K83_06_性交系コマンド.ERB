@M_KOJO_MESSAGE_COM_K83_72_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%%M_KOJO_K83_AUTO("単刺激…！")%」
		CALL M_KOJO_K83_NAKADASHI
	ELSE
		PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%%M_KOJO_K83_AUTO("単刺激…！")%」
	ENDIF
ENDIF
RETURN 1
;==================================================
;73,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_COM_K83_73
CALL M_KOJO_MESSAGE_COM_K83_73_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_73_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		;種付けプレス
	ELSEIF NOWEX:MASTER:射精
		SELECTCASE RAND:5
			CASE 1
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激")% 큥, 자극츄욱! 아기 생겨버릴 것 같아읏HPH」", "W")
			CASE 2
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激")% %CALLNAME:MASTER%나를 자극해줘 히끅, 으윽, 내 가장 깊은 곳에서 절정해 줘」", "W")
			CASE 3
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激")% %CALLNAME:MASTER%읏, %CALLNAME:MASTER%~앗 HPH 이키우옷HPH」", "W")
			CASE 4
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激")% 와줘…읏! %CALLNAME:MASTER%, 전부 줘앳HPH」", "W")
			CASEELSE
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激")% 좋아! HPH 자궁에 가득 뿌려버릴 거야 HPH」", "W")
		ENDSELECT
	ELSE
		PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 윽, 아파……! %M_KOJO_K83_AUTO("単刺激")%」
	ENDIF
ENDIF
RETURN 1
