; Modular ERB: 個人口上/083 Kisume [キスメ]/キスメ/M_KOJO_K83_06_性交系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;性交系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;中出し（挿入中に射精するとき）
;==================================================

@M_KOJO_K83_NAKADASHI
;一応暴発防止
SIF !M_KOJO_K83_UFUFU([[キスメ]])
	RETURN
SIF !NOWEX:MASTER:射精
	RETURN
SIF FLAG:時間停止
	RETURN
SELECTCASE RAND:7
	CASE 1
		CALL HPH_PRINT(@"「그럼, 나올 거야? 괜찮아읏, 안에……! 아앗 HPH」", "W")
	CASE 2
		CALL HPH_PRINT(@"「줘봐요... %조사처리(CALLNAME:MASTER,"의")% 정자... 잔뜩 줘요 HPH」", "W")
	CASE 3
		CALL HPH_PRINT(@"「싸줘…… 정액 잔뜩…… 내 안에 넣어줘 HPH」", "W")
	CASE 4
		CALL HPH_PRINT(@"「꽉 안아줘...! %CALLNAME:MASTER%…… 좋아해애…… HPH」", "W")
	CASE 5
		CALL HPH_PRINT(@"「괜찮아...! 깊숙이... 많이 싸줘 HPH」", "W")
	CASE 6
		CALL HPH_PRINT(@"「큭, 읏, 싸줘... 안에서 싸줘 HPH」", "W")
	CASEELSE
		CALL HPH_PRINT(@"「앗, 으윽, 그, 그대로 싸줘...! 가장 깊숙이읏 HPH」", "W")
ENDSELECT
;==================================================
;破瓜
;==================================================

@M_KOJO_K83_VIRGIN
;一応
SIF TCVAR:[[キスメ]]:破瓜 != 1
	RETURN
SIF !M_KOJO_K83_UFUFU([[キスメ]])
	RETURN
SIF FLAG:時間停止
	RETURN
PRINTFORMW 「넣을 수 있어...? 괜찮아...」
PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 하고 싶은 대로 해줘...」
;==================================================
;60,正常位
;==================================================

@M_KOJO_MESSAGE_COM_K83_60
CALL M_KOJO_MESSAGE_COM_K83_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_60_1
;-------------------------------------------------
;正常位＆立ち位共通
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF TCVAR:[[キスメ]]:破瓜 == 1
		CALL M_KOJO_K83_VIRGIN
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%」
		CALL M_KOJO_K83_NAKADASHI
	ELSE
		PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%」
		SELECTCASE RAND:5
			CASE 1
				CALL HPH_PRINT(@"「%CALLNAME:MASTER%……좋아해애……흐으응」", "W")
			CASE 2
				PRINTFORMW 「앗... 뜨거우읏...!」
			CASE 3
				PRINTFORMW 「윽, 잠시만... 너무 격렬해...!」
			CASE 4
				PRINTFORMW 「아앗…… 깊숙이…… 와버렸어...!」
			CASEELSE
				PRINTFORMW 「기분 좋아…… 더……!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
