;65,騎乗位
;==================================================

@M_KOJO_MESSAGE_COM_K83_65
CALL M_KOJO_MESSAGE_COM_K83_65_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_65_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF TCVAR:[[キスメ]]:破瓜 == 1
		PRINTFORMW 「넣어주는구나…… 괜찮아, 무섭지 않아」
		PRINTFORMW 「%CALLNAME:MASTER%, 잘 봐줘……」
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")%」
		CALL M_KOJO_K83_NAKADASHI
	ELSE
		SELECTCASE RAND:5
			CASE 1
				CALL HPH_PRINT(@"「후후…… 범해 줄게…… HPH」", "L")
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激…！")% %M_KOJO_K83_AUTO("二連刺激")%이야, 안 돼앳, 멈, 멈추지 않아앗!」
			CASE 2
				CALL HPH_PRINT(@"「괜찮아…… 기분 좋게 해 줄게…… HPH」", "L")
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激…！")% %M_KOJO_K83_AUTO("二連刺激")% 아하핫 HPH, 내 보지 기분 좋아?」", "W")
			CASE 3
				CALL HPH_PRINT(@"「그럼……잘, 먹겠습니다……후으윽」", "L")
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激…！")% %M_KOJO_K83_AUTO("二連刺激")% 좋아앗! %조사처리(CALLNAME:MASTER,"의")% 자지, 좋아앗!」
			CASE 4
				CALL HPH_PRINT(@"「내가 %CALLNAME:MASTER%위에…… HPH」", "L")
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激…！")% %M_KOJO_K83_AUTO("二連刺激")%하아, 하아, 더, 더……!」
			CASEELSE
				CALL HPH_PRINT(@"「%CALLNAME:MASTER%…… 힘낼게…… HPH」", "L")
				CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("単刺激…！")% %M_KOJO_K83_AUTO("二連刺激")% 하으앗! %CALLNAME:MASTER%읏…%CALLNAME:MASTER%읏……HPH」", "W")
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
