;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_IRAI_12_K83(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「우으으... 아무것도 안 했는데...」
				CASE 2
					PRINTFORMW 「지상은 무서워……」
				CASE 3
					PRINTFORMW 「우으…… 분해…….」
				CASEELSE
					PRINTFORMW 「흐윽…… 완전히 박살 나버렸어……」
			ENDSELECT
		ELSE
			PRINTFORMW 「끅……」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			PRINTFORMW 「응, 괜찮아…… 위험하니까……」
		ELSE
			PRINTFORMW 「별로……」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「응원하고 있어……!」
				CASE 2
					PRINTFORMW 「힘내……!」
				CASE 3
					PRINTFORMW 「지지 마아……!」
				CASEELSE
					PRINTFORMW 「조, 조심해...!」
			ENDSELECT
		ELSE
			PRINTFORMW 「정말……?」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			PRINTFORMW 「응, 괜찮아…… 위험하니까……」
		ELSE
			PRINTFORMW 「별로……」
		ENDIF
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			PRINTFORMW 「에엣!? 나, 왜 내가……」
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORMW 「휴……」
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%~, 봐줘어……」
			ELSEIF TALENT:[[キスメ]]:思慕
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 강하네……」
			ELSE
				PRINTFORMW 「무, 무리야……」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			PRINTFORMW 「고마워요...! 이제 안심이 되네요...」
		ELSE
			PRINTFORMW 「아, 고마워……!」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
