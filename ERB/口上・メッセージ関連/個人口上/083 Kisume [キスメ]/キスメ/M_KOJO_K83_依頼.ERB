			PRINTFORMW 「앗! 그거 내 거잖아...!」
		ENDIF
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「이거 있으면 잘 잠들 수 있어...!」
				CASE 2
					PRINTFORMW 「와, 저의 최애...!」
				CASEELSE
					PRINTFORMW 「이거 없으면 안 불안해……!」
			ENDSELECT
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：上級素材
		IF TALENT:[[キスメ]]:恋慕 || TALENT:[[キスメ]]:思慕
			PRINTFORMW 「앗, 찾았구나…… 다행이다」
		ELSE
			PRINTFORMW 「아, 찾았구나……」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
