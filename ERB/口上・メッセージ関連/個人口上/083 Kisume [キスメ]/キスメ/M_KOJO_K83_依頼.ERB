;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K83(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%, 가르쳐줘……」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 묻고 싶은 게 있어요……」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%…… 알고 있어……?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					RETURN 0
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「흐으음……」
					CASE 2
						PRINTFORMW 「과연……」
					CASEELSE
						PRINTFORMW 「헤에에……」
				ENDSELECT
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「음, 뭔가 다르다고 하는 건가……」
					CASE 2
						PRINTFORMW 「그거 정말……?」
					CASEELSE
						PRINTFORMW 「음……」
				ENDSELECT
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「고마워…… %조사처리(CALLNAME:MASTER,"는")% 박식해……」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「고마워…… 후련해졌어……」
		ELSE
			PRINTFORMW 「아, 고마워……」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「뭐, 참고는 됐을까……」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「%CALLNAME:MASTER%, 사실은 모르겠어……?」
		ELSE
			PRINTFORMW 「…………」
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
