;依頼口上・一般依頼04：料理上手になりたい
;==================================================

@M_KOJO_IRAI_4_K83(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「하, 힘낼게...!」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「저, 긴장돼버렸나 봐……」
		ELSE
			PRINTFORMW 「음…… 일단은……」
		ENDIF
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%, 맛보고 싶어...!」
				CASE 2
					PRINTFORMW 「%CALLNAME:MASTER%, 이거 어떻게 할 거야……?」
				CASE 3
					PRINTFORMW 「그, 그런 식으로 자르는 거야……」
				CASEELSE
					PRINTFORMW 「그렇구나……!」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「그렇구나……!」
		ELSE
			PRINTFORMW 「도, 어떡해……」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		;料理口上のコピペ
		IF ABL:[[キスメ]]:料理技能 >= 2 && TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「완성했어……♪」
				CASE 2
					PRINTFORMW 「완성했어……♪」
				CASEELSE
					PRINTFORMW 「완성……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「이, 이렇게 하면 될까……」
				CASE 2
					PRINTFORMW 「이걸로 괜찮을까……?」
				CASEELSE
					PRINTFORMW 「맛있어졌어……?」
			ENDSELECT
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼05：特訓につきあって
;==================================================

@M_KOJO_IRAI_5_K83(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「%CALLNAME:MASTER%, 저도 강해지고 싶어요...!」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「저도 할 수 있을까요……?」
		ELSE
			PRINTFORMW 「나…… 약하니까……」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「흐으윽…… 어차피 전면 중보스인데……」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「우으윽…… 역시……」
		ELSE
			PRINTFORMW 「뭐…… 그렇겠지……」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「유기 씨 정도는 강하게…… 에, 그건 무리……?」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「요정에게 이길 수 있도록……」
		ELSE
			PRINTFORMW 「으윽…… 긴장돼버렸어……」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
		;【▼そのまま下の口上へ】
		;戦闘訓練のコピペ
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「흡, 이제 안 돼읏! 괴이 '츠게오토시의 괴'」
			CASE 2
				PRINTFORMW 「햐앗! 낚싯대 '날아올라 우물 속으로'!」
			CASEELSE
				PRINTFORMW 「무, 무리야! 낚싯대 『웰디스트랙터』!」
		ENDSELECT
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 조언을 해보았다.
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「에……? 오줌에서 나오는 건…… 좀……」
				CASE 2
					PRINTFORMW 「오, 오니비의 수도 한계가 있네……」
				CASEELSE
					PRINTFORMW 「옆으로 움직이는 건…… 서툴러……」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「하아, 하아…… 어땠을까……?」
		ELSE
			PRINTFORMW 「하아, 하아…… 오늘은…… 고마워……」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
