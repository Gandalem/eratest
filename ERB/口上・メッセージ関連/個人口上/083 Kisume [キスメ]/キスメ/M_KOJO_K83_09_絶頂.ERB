;-------------------------------------------------
;素股
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:5
		CASE 1
			CALL HPH_PRINT(@"「후후, 축축해져 버렸어…… HPH」", "W")
		CASE 2
			CALL HPH_PRINT(@"「후우…… 기분 좋았어…… 흐읍」", "W")
		CASE 3
			CALL HPH_PRINT(@"「흐으윽…… 지, 지쳤어…… %CALLNAME:MASTER%, 쪽 해줘… HPH」", "W")
		CASE 4
			PRINTFORMW 「하아, 하아…… %CALLNAME:MASTER%, 기분 좋아 보이네……」
		CASEELSE
			IF TALENT:[[キスメ]]:処女 == 1 || TALENT:[[キスメ]]:処女 == -1
				PRINTFORMW 「하아, 하아…… 본, 본격적으로 하고 있는 것 같아…… \/\/\/」
			ELSE
				CALL HPH_PRINT(@"「하아, 하아…… 다음엔 안에 넣어줘…… HPH」", "W")
			ENDIF
	ENDSELECT
	RETURN 1
ENDIF
RETURN 1
