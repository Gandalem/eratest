; Modular ERB: 個人口上/083 Kisume [キスメ]/キスメ/M_KOJO_K83_09_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K83
#DIM TotalEX
SIF FLAG:時間停止
	RETURN 1
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 「안, 안 돼…… \/\/\/ 가슴이…… %M_KOJO_K83_AUTO("単刺激…！")%」
ENDIF
;;-------------------------------------------------
;;射精した
;;記入チェック（=0, 非表示、1, 表示）
;LOCAL = 0
;;-------------------------------------------------
;IF LOCAL && NOWEX:射精
;	PRINTFORMW
;ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 「흐으읍…… 오줌으로 나와버릴 것 같아……읏!」
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	IF M_KOJO_K83_UFUFU([[キスメ]])
		SELECTCASE NOWEX:TotalEX
			;強
			CASE 5 TO 15
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("二連刺激")%, 안 돼앳, %M_KOJO_K83_AUTO("単刺激")%! 간다 간다 간다앗HPH 아아아아앗HPHHPH」", "W")
					CASE 2
						CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("二連刺激")%, 와버려, %M_KOJO_K83_AUTO("単刺激")%! 응아아앗HPH 가버려어어~~읏HPHHPH」", "W")
					CASEELSE
						CALL HPH_PRINT(@"「%M_KOJO_K83_AUTO("二連刺激")%, 꺄앗, %M_KOJO_K83_AUTO("単刺激")%! 가버려어~읏HPH 미안해애애~~읏HPHHPH」", "W")
				ENDSELECT
				;中
			CASE 2 TO 4
				PRINTFORM 「%M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")% 
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT(@"갈 거 같아읏! 갈 거야앗 HPH", "W")
					CASE 2
						CALL HPH_PRINT(@"라, 라메엣! 이큐옷HPH.", "W")
					CASEELSE
						CALL HPH_PRINT(@"으윽! 으아앙!!", "W")
				ENDSELECT
				;弱
			CASE 1
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 해버릴 것 같아……!」
					CASE 2
						PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 야, 안 돼앳…!」
					CASEELSE
						PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 아, 갈 것 같아...!」
				ENDSELECT
		ENDSELECT
	ELSE
		SELECTCASE NOWEX:TotalEX
			;強
			CASE 5 TO 15
				PRINTFORMW 「%M_KOJO_K83_AUTO("二連刺激")%%M_KOJO_K83_AUTO("単刺激")% 가아앗!」
				;中
			CASE 2 TO 4
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 가버릴 것 같아읏!」
				;弱
			CASE 1
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激…！")% 가앗…!」
		ENDSELECT
	ENDIF
ENDIF
