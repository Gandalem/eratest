@M_KOJO_MESSAGE_PALAMCNG_A_K83_20(ARG)
;-------------------------------------------------
;手淫フェラ
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	;精飲
	IF EXP_UP(15) == NOWEX:PLAYER:射精 * 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응읏! 응군그…… 꿀꺽읏」
				CALL HPH_PRINT(@"「푸하…… 전부 마실 수 있었어…… HPH」", "W")
			CASE 2
				PRINTFORML 「응읏! 응구그…… 주르륵……」
				CALL HPH_PRINT(@"「푸아…… 맛있었어 HPH」", "W")
			CASEELSE
				PRINTFORML 「응읏! 응으음……응구……꿀꺽읏」
				CALL HPH_PRINT(@"「푸하…… 잘 먹었다 HPH」", "W")
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				CALL HPH_PRINT(@"「응윽...! 푸하... 많이 나왔네... HPH」", "W")
			CASE 2
				PRINTFORMW 「응응...! 아아... %CALLNAME:MASTER%, 기분 좋아 보여...」
			CASEELSE
				PRINTFORMW 「응우욱...! 큭... 조금 시큼해......」
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
RETURN 1
