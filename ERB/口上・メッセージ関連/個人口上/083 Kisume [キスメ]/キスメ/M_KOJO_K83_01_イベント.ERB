			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 나, 우리 집에 안 올래……?」
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
