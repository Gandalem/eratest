@M_KOJO_EVENT_K83_20(ARG,ARG:1)
;口上主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:[[キスメ]]:恋人
			PRINTFORMW 「아아…… 돌아가야 해…… 또 봐, %CALLNAME:MASTER%……」
		ELSEIF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「이제 돌아가야 해…… 또 봐, %CALLNAME:MASTER%」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「후아…… 또 봐」
		ELSE
			PRINTFORMW 「졸려……. 안녕……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート中帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;自室うふふ中
		IF CFLAG:[[キスメ]]:現在位置 == OMANEKIBEYA()
			IF TALENT:[[キスメ]]:恋人
				PRINTFORMW 「후와아…… 미, 미안해, %CALLNAME:MASTER%…… 나……」
			ELSEIF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「후아아…… %CALLNAME:MASTER%…… 저…… 이제……」
				;普通恋慕じゃないと入れないけど
			ELSE
				PRINTFORMW 「후아아…… 나…… 졸려…….」
			ENDIF
			;以外
		ELSE
			IF TALENT:[[キスメ]]:恋人
				PRINTFORMW 「미안해, 이제 집에 가야 해서…… 또 봐, %CALLNAME:MASTER%……」
			ELSEIF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「앗, 이제 돌아가야 해……. 또 보자, %CALLNAME:MASTER%……」
			ELSEIF TALENT:[[キスメ]]:思慕
				PRINTFORMW 「후와아…… 이제 집에 갈게……」
			ELSE
				PRINTFORMW 「졸려버렸나 봐…… 잘 가……」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;玄関先でお見送り
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;自室
		IF CFLAG:[[キスメ]]:現在位置 == OMANEKIBEYA()
			IF TALENT:[[キスメ]]:恋人
				PRINTFORMW 「후와아…… 미, 미안해, %CALLNAME:MASTER%…… 나……」
			ELSEIF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%…… 나 이제……」
				;普通恋慕じゃないと入れないけど
			ELSE
				PRINTFORMW 「앗…… 시간이……」
			ENDIF
		ELSE
			IF TALENT:[[キスメ]]:恋人
				PRINTFORMW 「오늘은 즐거웠어…… 또 데이트하자~♪」
			ELSEIF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「오늘은 즐거웠어…… 뭐, 또 놀자~」
			ELSEIF TALENT:[[キスメ]]:思慕
				PRINTFORMW 「오늘은 즐거웠다…… 또 보자……」
			ELSE
				PRINTFORMW 「보내줬어...? 아, 고마워……」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
