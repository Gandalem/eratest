@M_KOJO_EVENT_K83_29(ARG,ARG:1)
;口上主はTARGET
;ARGはTARGETの度胸で分岐
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;	;-------------------------------------------------
	;	;小分岐
	;	;-------------------------------------------------
	;	;怒らせてしまった
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARG == 1
	;		RETURN 1
	;	ENDIF
	;-------------------------------------------------
	;泣かせてしまった　[臆病]持ち
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORML 「%CALLNAME:MASTER%……너무해……흐윽……으응……」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORML 「%CALLNAME:MASTER%……너무해…… 우으윽…… 끅……」
		ELSE
			PRINTFORML 「너무해…… 으윽…… 흑……」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
