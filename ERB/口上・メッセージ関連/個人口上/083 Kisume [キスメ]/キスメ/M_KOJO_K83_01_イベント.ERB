@M_KOJO_EVENT_K83_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE STR:(5000 + ARG:1)
					CASE "博麗神社"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 같이 신사에 안 갈래?」
					CASE "命蓮寺"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 같이 절에 가지 않을래?」
					CASE "人間の里"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%……같이 마을에 가지 않을래?」
					CASE "霧の湖～紅魔館"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 같이 호수 안 갈래?」
					CASE "迷いの竹林"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 같이 대나무 숲에 가지 않을래?」
					CASE "魔法の森"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 같이 숲에 가지 않을래?」
					CASE "三途の川～冥界"
						PRINTFORMW 「있잖아, %CALLNAME:MASTER%…… 같이 강에 가지 않을래?」
					CASE "妖怪の山 (山麓)"
