@M_KOJO_K83_ENCOUNT(ARGS)
SELECTCASE ARGS
	CASE "ハロウィン"
		;機嫌補正
		TALENT:[[キスメ]]:機嫌 = MAX(TALENT:[[キスメ]]:機嫌, 0)
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMDW 이런 곳에 호박 랜턴이 떨어진 것 같았다.
			PRINTFORMDL 하고 생각하니 안에는 키스메가!!
			PRINTW 
			PRINTFORMW 「에헤헤…… 놀랐어?」
			PRINTFORMW 「야마메쨩이 만들어 준 거야……♪」
		ELSE
			PRINTFORMDW 이런 곳에 양동이가 떨어져 있네.
			PRINTFORMDL 하고 생각하니 안에는 키스메가!!
			PRINTW 
			PRINTFORMW 「깜짝 놀랐어……?」
			PRINTFORMW 「오늘은 깜짝 놀라게 해도 되는 날이래……」
		ENDIF
	CASE "バレンタイン"
		;機嫌補正
		TALENT:[[キスメ]]:機嫌 = MAX(TALENT:[[キスメ]]:機嫌, 0)
		SELECTCASE CFLAG:[[キスメ]]:好感度
			CASE 1000 TO 3000
				;ブラックサンダー
				PRINTFORMW 「이거…… 남자한테 건네줘라고 야마메쨩이……」
			CASE 3001 TO 5000
				;チョコレート
				PRINTFORMW 「이, 이거…… 받아주세요……」
			CASE IS > 5000
				IF EXP:[[キスメ]]:愛情経験 < 100
					;高級チョコ
					PRINTFORMW 「이, 이거…… 받아줘……」
				ELSE
					;手作りチョコ
					PRINTFORMW 「쿄, 오늘은 발렌타인이라는 날이라서…… 그게……」
					PRINTFORMW 「초콜릿…… 만들었으니까, %조사처리(CALLNAME:MASTER,"에게")% 먹어줬으면 해……\/\/\/」
				ENDIF
		ENDSELECT
		;通常
	CASEELSE
		;地底 or 同じ拠点
		IF INRANGE(CFLAG:[[キスメ]]:現在位置, 900, 1000) || CFLAG:MASTER:初期位置 / 100 == CFLAG:[[キスメ]]:初期位置 / 100
			IF TALENT:[[キスメ]]:恋人 || TALENT:[[キスメ]]:恋慕
				PRINTFORML 「앗, %CALLNAME:MASTER%읏\@ TALENT:[[キスメ]]:恋人 ? 헉 # …… \@!」
				SELECTCASE RAND:6
					CASE 0
						PRINTFORMW 「보고 싶다고 생각하고 있었어……\/\/\/」
					CASE 1
						PRINTFORMW 「지금 한가해……?」
					CASE 2
						PRINTFORMW 「자, 요즘 바빠 보이네……」
					CASE 3
						PRINTFORMW 「……오쿠우라미라도 해볼까?」
					CASE 4
						PRINTFORMW 「아까 야마메쨩이랑 %CALLNAME:MASTER%얘기하고 있었는데……」
					CASEELSE
						PRINTFORMW 「저기……. 지하 세계는 언제나 날씨가 좋아요……!」
				ENDSELECT
			ELSEIF TALENT:[[キスメ]]:思慕
				PRINTFORMW 「앗, %CALLNAME:MASTER%……」
				PRINTFORMW 「저기, 안, 안녕하세요……」
			ELSE
				PRINTFORMW 「앗! 안, 안녕하세요……」
