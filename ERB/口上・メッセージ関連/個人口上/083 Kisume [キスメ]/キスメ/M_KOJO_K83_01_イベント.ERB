;相手が押し倒しを解除
;==================================================

@M_KOJO_EVENT_K83_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORML 「하아, 하아…… 지, 지쳤다……」
		PRINTFORMW 「미, 미안해…… %CALLNAME:MASTER%……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		PRINTFORMW 「하아, 하아…… 그만, 이제 충분해……」
		PRINTFORMW 「%CALLNAME:MASTER%…… 아, 고마워……」
		TCVAR:[[キスメ]]:351 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORMW 「힉!!」
		IF TALENT:[[キスメ]]:恋人
			SELECTCASE RAND:2
				CASE 1
					CALL HPH_PRINT(@"「응…… 벌을 내려줘……흐읍」", "W")
				CASEELSE
					CALL HPH_PRINT(@"「응…… 번갈아 가면서…… HPH」", "W")
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「으윽…… 죄, 죄송해요……!」
				CASEELSE
					PRINTFORMW 「우으윽…… 그, 그만해줘……!」
			ENDSELECT
		ENDIF
		TCVAR:[[キスメ]]:351 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		IF TALENT:[[キスメ]]:恋人
			SELECTCASE RAND:2
				CASE 1
					CALL HPH_PRINT(@"「%CALLNAME:MASTER%…… 좋아해주는 거구나…… HPH」", "W")
				CASEELSE
					CALL HPH_PRINT(@"「그럼, 잔뜩 놀아 줄게…… HPH」", "W")
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					CALL HPH_PRINT(@"「후회해도 이미 늦었어…… HPH」", "W")
				CASEELSE
					CALL HPH_PRINT(@"「후후…… 그럼 사양 안 할게…… HPH」", "W")
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
