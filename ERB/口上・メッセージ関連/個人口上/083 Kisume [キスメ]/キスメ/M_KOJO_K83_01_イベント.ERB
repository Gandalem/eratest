;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K83_1
RETURN 1

@M_KOJO_SPEVENT_K83_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTL 
	PRINTFORMDW 데이트를 마치고 돌아오는 길, 키스메는 평소처럼 욕조에 몸을 담그고 말랑하게 떠다니며 뒤따라온다.
	IF TALENT:[[キスメ]]:恋慕
		PRINTFORMDW 이제 곧 도착하려던 참에, %조사처리(CALLNAME:MASTER,"는")% 스윽 치맛자락을 잡아당겨졌다.
	ELSE
		PRINTFORMDW 곧 도착하나 싶을 때, %조사처리(CALLNAME:MASTER,"는")% 콕콕 찔렸다.
	ENDIF
	PRINTFORMDL 얼굴을 돌리자, 키스메는 어색한 미소로 자신을 바라보았다.
	PRINTW 
	IF TALENT:[[キスメ]]:恋慕
		PRINTFORMW 「아, 저기, %CALLNAME:MASTER%……. 오늘은 즐거웠다…….」
		PRINTFORMW 「그래서, 그……. 감사 인사를 하고 싶어서…….」
		PRINTFORMW 「%CALLNAME:MASTER%……. 눈을 감고…….」
		PRINTW 
		SETCOLOR 255, 100, 255
		PRINTFORML 추...%UNICODE(0x2764)%
		CALL M_KOJO_COLOR_K83
		PRINTW 
		PRINTFORMW 「미, 미안해 갑자기…… 그게 말이야, 나는 그냥…… 음……」
		PRINTL 
		PRINTFORMDL 키스메는 얼굴을 새빨갛게 물들이고 혼란스러워하고 있어서, 일단 머리를 쓰다듬어 주었다.
		PRINTW 
		PRINTFORMW 「아, 고마워…… 그래도 이러면…… 역으로…… \/\/\/」
		;フラグ用
		IF FIRSTTIME("ファーストキス")
			PRINTFORMW (용, 용기를 낼 수 있었어……. %CALLNAME:MASTER%앞이라면 나라도 용기가 날 수 있어……!)
		ENDIF
		;日記を書く
		CALL M_KOJO_DIARYSETTING_K83(43)
	ELSE
		PRINTFORMW 「아, 저기, %CALLNAME:MASTER%……오늘은 즐거웠다……」
		PRINTFORMW 「그래서, 그게……. 음…….」
		PRINTFORMW 「아, 고마워……. 다음엔 꼭 뭔가 사례를…….」
		PRINTL 
		PRINTFORMW (우으…… 용기가 안 나……)
		TCVAR:[[キスメ]]:キスキャンセル = 1
		;日記を書く
		CALL M_KOJO_DIARYSETTING_K83(42)
	ENDIF
ENDIF
RETURN 1
