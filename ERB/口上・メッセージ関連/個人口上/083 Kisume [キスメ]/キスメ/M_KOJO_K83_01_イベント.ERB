			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMW 「그렇구나……」
				TALENT:[[キスメ]]:機嫌 = MIN(TALENT:[[キスメ]]:機嫌, 0)
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
