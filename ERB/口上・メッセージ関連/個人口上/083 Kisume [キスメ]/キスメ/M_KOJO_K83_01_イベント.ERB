IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2) && !TCVAR:[[キスメ]]:352
		;バレンタイン機嫌補正（先に処理）
		SIF DAY:2 == 4 && DAY:3 == 14
			TALENT:[[キスメ]]:機嫌 = MAX(TALENT:[[キスメ]]:機嫌, 0)
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_K83_ENCOUNT("ハロウィン")
			;不機嫌
		ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
			SIF !TCVAR:[[キスメ]]:352
				PRINTFORMW 「안녕하세요……」
		ELSE
			CALL M_KOJO_K83_ENCOUNT("通常")
		ENDIF
		;バレンタインチョコ
		SIF DAY:2 == 4 && DAY:3 == 14
			CALL M_KOJO_K83_ENCOUNT("バレンタイン")
		CALL M_KOJO_EVENT_K83_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;統合しました
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「ひゃ읏!! %CALLNAME:MASTER%……!」
		PRINTFORMW 「あの……こ、これは……その……」
		PRINTFORMW 「え…？ い、一緒に、って……う……」
		PRINTFORMW 「じゃ、じゃあ……遠慮なく……\/\/\/」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：強")% 죄, 죄송해요옷!!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：強")% 로, 나가라고!!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && !TCVAR:[[キスメ]]:352
		;ハロウィン
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_K83_ENCOUNT("ハロウィン")
		ELSE
			CALL M_KOJO_K83_ENCOUNT("通常")
			;バレンタイン
			SIF DAY:2 == 4 && DAY:3 == 14
				CALL M_KOJO_K83_ENCOUNT("バレンタイン")
		ENDIF
		CALL M_KOJO_EVENT_K83_1_END
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7 && !TCVAR:[[キスメ]]:352
		;ハロウィン優先
		IF DAY:2 == 3 && DAY:3 == 30
			CALL M_KOJO_K83_ENCOUNT("ハロウィン")
		ELSE
			IF TALENT:[[キスメ]]:恋人
				PRINTFORMW 「엣, %CALLNAME:MASTER%……그 사람은……」
