						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「에…… 그, 그건 좀……」
							RETURN 1
						ENDIF
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
