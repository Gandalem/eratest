;==================================================

@M_KOJO_SUCCESS_COM_K83_352
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K83_352
CALL M_KOJO_MESSAGE_COM_K83_352_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_352_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;告白した
	IF TFLAG:SELECTCOMの分岐
		PRINTFORMW 「에, 에엣…… 잠시만요…… 무슨 소리를 하고 있는 거예요……」
		PRINTL 
		PRINTFORMDL 키스메는 혼란 상태가 되어버려서, %조사처리(CALLNAME:MASTER,"는")% 침착하게 다시 마음을 전했다.
		PRINTW 
		PRINTFORMW 「진심이야...? 저기, 그러니까 나…… 나는……」
		PRINTL 
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 진심과 열정을 담아, 세 번의 마음을 전했다.
		PRINTW 
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「……저, 저도…… %조사처리(CALLNAME:MASTER,"가")% 좋아요……」
			PRINTFORMW 「하지만, 저는 별 볼 일 없는 사람이라고 생각했어요……. 제가 안 된다고……」
			PRINTFORMW 「그래서…… 기뻐요…… %조사처리(CALLNAME:MASTER,"에게")% 말해줘서, 정말 기뻐요……」
			PRINTL 
			PRINTFORMDW 키스메의 눈에서는 커다란 눈물이 흘러, 주르륵 떨어져 내린다.
			PRINTFORMDW 평소 같으면 몸을 숨고 말았을 상황이었지만, 부끄러워하면서도 마주하고 있다.
			PRINTFORMDW 그러자 갑자기 키스메가 일어섰다.
			PRINTFORMDW 손도 발도 떨고 있었기에 그 모습은 갓 태어난 아기 사슴처럼 위태로웠다.
			PRINTFORMDL 그대로 흔들거리며 %CALLNAME:MASTER%아래로, 천천히 걸어온다…….
			PRINTW 
			PRINTFORMDL 　꽉
			PRINTW 
			PRINTFORMW 「아, 고마워...! 저도 말하게 해줘...」
			PRINTFORMW 「%CALLNAME:MASTER%, 정말 좋아해...」
			PRINTL 
			PRINTFORMDW 키스메는 목에 팔을 감고, %조사처리(CALLNAME:MASTER,"를")% 끌어당긴다.
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 그것에 응하여 몸을 숙이고, 두 사람은 서로를 바라보며 얼굴을 가까이했다. 그리고――
			PRINTW 
			EXP:[[キスメ]]:Ｍ経験 += 1
			EXP:MASTER:Ｍ経験 += 1
			CALL MUTUAL_KISS
			;日記を書く
			CALL M_KOJO_DIARYSETTING_K83(46)
		ELSE
			PRINTFORMW 「……저, 저는 아직 잘 모르겠어요……」
			PRINTFORMW 「그렇지만 기뻐요…… %조사처리(CALLNAME:MASTER,"는")% 저한테 다정하시니까……」
			PRINTFORMW 「더 함께 있을 수 있다면 좋겠다고 생각하고 있었어요……」
			PRINTFORMW 「그래서…… 이래도 괜찮다면……」
		ENDIF
		;言葉に詰まる
	ELSE
		PRINTFORMW 「? ……무슨 일이야?」
	ENDIF
ENDIF
RETURN 1
