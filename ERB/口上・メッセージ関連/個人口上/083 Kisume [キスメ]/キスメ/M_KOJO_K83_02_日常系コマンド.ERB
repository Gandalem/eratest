			IF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「함, 같이 할래……」
			ELSEIF TALENT:[[キスメ]]:思慕
				PRINTFORMW 「그, 도와줄게……」
			ELSE
				PRINTFORMW 「……나도 할래」
			ENDIF
		ELSE
			WAIT
		ENDIF
	ENDIF
ENDIF
RETURN 1
