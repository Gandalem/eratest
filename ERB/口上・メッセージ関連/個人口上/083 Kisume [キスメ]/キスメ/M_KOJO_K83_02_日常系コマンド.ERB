;621,釣りをする
;TFLAG:193(0=釣れない 1～4=魚 11～15=うまい魚 610=木材 131=守矢の守札 21=ローター 609=氷の鱗 606=龍の爪)
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K83_621
RETURN 1

@M_KOJO_MESSAGE_COM_K83_621
CALL M_KOJO_MESSAGE_COM_K83_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文をカットしてるのでMESSAGE処理を内蔵する
IF LOCAL
	CALL M_KOJO_COLOR_K83
	SELECTCASE TFLAG:193
		;釣れない
		CASE 0
			PRINTFORMDW 아무것도 안 잡혔다…….
			IF TALENT:[[キスメ]]:恋慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「……느긋하게 지낼 수 있어서, 좋아해」
					CASE 2
						PRINTFORMW 「저, 저의 도구는 낚시용이 아니라고욧!」
					CASEELSE
						PRINTFORMW 「천천히 기다리면 분명……」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「오, 통에 넣지 말아줘……」
					CASEELSE
						PRINTFORMW 「안 잡히네……」
				ENDSELECT
			ENDIF
			RETURN 1
			;木片
		CASE 610
			IF TFLAG:194 > 1000
				PRINTFORMW 「앗!」
				PRINTL 
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(1)가 나뭇조각을 낚았다...
				PRINTW
				PRINTFORMW 「……시무룩」
			ELSE
				PRINTFORMDL 나뭇조각이 잡혔다……
				PRINTW
				PRINTFORMW 「아라라……」
			ENDIF
			RETURN 1
			;紙切れ
		CASE 131
			IF TFLAG:194 > 1000
				PRINTFORML 「앗!」
			ELSE
				PRINTFORMDL 종잇조각이 낚였다
			ENDIF
			PRINTDW 
			PRINTDL ┌─────────────┐
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL | 모리야부적 |
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 다섯 장을 모으면 쿠지 한 회를 뽑을 수 있다.
			PRINTDL ｜　　　くじを一回引けます　｜
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL | 고효능은 보장할 수 없습니다 |
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL | 모야 신사 |
			PRINTDL └─────────────┘
			PRINTW 
			PRINTFORMW 「이거, 뭐야?」
			RETURN 1
		CASE 1 TO 20, 22 TO 60
			LOCALS = %FISH_NAME(TFLAG:193)%
		CASE 21
			LOCALS = ローター
		CASEELSE
			LOCALS = %ITEMNAME:(TFLAG:193)%
	ENDSELECT
	;キスメが釣った
	IF TFLAG:194 > 1000
		PRINTFORMW 「앗!」
		PRINTL 
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %LOCALS%를 낚았다!
		RESETCOLOR
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORML %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORML %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K83
		SELECTCASE LOCALS
			CASE "ローター"
				PRINTFORMW 「이거... \/\/\/」
			CASE "カエル"
				PRINTFORMW 「뭐야 개구리인가……」
			CASE "氷の鱗", "龍の爪"
				PRINTFORMW 「와, 아름다워……!」
			CASE "龍涎香"
				PRINTFORMW 「이 돌은 뭐지……?」
			CASE "ガーパイク", "カムルチー", "シーラカンス", "チョウザメ", "イトウ", "ピラルクー", "タキタロウ"
				PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：強")% 어, 무거워읏! %CALLNAME:MASTER%, 도와줘……!」
			CASE "ヤマメ"
				PRINTFORMW 「야마메쨩……에헤헤……」
			CASE "ウナギ", "ヤツメウナギ", "ナマズ"
				PRINTFORMW 「미끌미끌하네……」
			CASEELSE
				PRINTFORMW 「잡, 잡혔다...!」
		ENDSELECT
		;MASTERが釣った
	ELSE
		RESETCOLOR
		PRINTFORMDL %LOCALS%가 잡혔다!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORML 　사이즈: {LOCAL:1}cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORML 　지금까지 잡은 %LOCALS% 중에서 최대 사이즈야!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORML %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORML %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K83
		SELECTCASE LOCALS
			CASE "ローター"
				IF TALENT:[[キスメ]]:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 뭐 하고 있었어...?」
				ELSE
					PRINTFORMW 「이, 이거... \/\/\/」
				ENDIF
			CASE "カエル"
				PRINTFORMW 「개구리 귀여워……」
			CASE "氷の鱗", "龍の爪"
				PRINTFORMW 「예쁘다……!」
			CASE "龍涎香"
				PRINTFORMW 「그, 그건…… 뭐야?」
			CASE "ヤマメ"
				PRINTFORMW 「앗, 야마메쨩……」
			CASE "ウナギ", "ヤツメウナギ", "ナマズ"
				PRINTFORMW 「미끌미끌하네……」
			CASEELSE
				IF LOCAL:1 >= 80
					PRINTFORMW 「스, 대단해……!」
				ELSEIF INRANGE(TFLAG:193, 11, 20) || INRANGE(TFLAG:193, 24, 60)
					PRINTFORMW 「맛있겠다……!」
				ELSEIF TALENT:[[キスメ]]:恋慕
					PRINTFORMW 「잡았네……!」
				ELSEIF TALENT:[[キスメ]]:思慕
					PRINTFORMW 「좋겠다아……」
				ELSE
					PRINTFORMW 「오우……」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
