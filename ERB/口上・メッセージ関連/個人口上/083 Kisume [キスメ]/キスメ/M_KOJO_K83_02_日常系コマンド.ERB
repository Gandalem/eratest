@M_KOJO_MESSAGE_COM_K83_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	IF TALENT:[[キスメ]]:恋慕
		PRINTFORML 「저도……!」
