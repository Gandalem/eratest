				PRINTFORMW 「그럼, 그럼…… 부탁해……\/\/\/」
		ENDSELECT
		;初回
	ELSEIF FIRSTTIME("スキンシップ")
		PRINTFORMW 「헉!!」
		PRINTFORMW 「미, 미안해…… 깜짝 놀랐을 뿐이야……」
		;通常
	ELSE
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:8
				CASE 1
					PRINTFORMW 「음... \/\/\/」
				CASE 2
					PRINTFORMW 「저도……」
				CASE 3
					PRINTFORMW 「앗, 잠깐…… 간, 간지러워읏\/\/\/」
				CASE 4
					PRINTFORMW 「%CALLNAME:MASTER%손, 따뜻해……」
				CASE 5
					PRINTFORMW 「하, 부끄러워……」
				CASE 6
					PRINTFORMW 「흐아앙……」
				CASE 7
					PRINTFORMW 「기, 기분 좋을지도……」
				CASEELSE
					PRINTFORMW 「후후, 즐거워……」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「내 몸…… 차가워, 그치……」
				CASE 2
					PRINTFORMW 「흐, 간지러워……」
				CASE 3
					PRINTFORMW 「거, 거기는……」
				CASEELSE
					PRINTFORMW 「응……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「우……」
				CASE 2
					PRINTFORMW 「뭐, 왜 만지는 거야……?」
				CASEELSE
					PRINTFORMW 「아, 아니야……」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
