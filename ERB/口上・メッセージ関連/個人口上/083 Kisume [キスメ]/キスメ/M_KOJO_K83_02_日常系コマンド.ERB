@M_KOJO_SUCCESS_COM_K83_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K83_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K83_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;ここに口上書いて下さい
	CALL M_KOJO_COLOR_K83
	;酔ってる
	IF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
		;会話不能
	ELSEIF TCVAR:[[キスメ]]:会話不能
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「그, 그러네……」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「뭐, 뭐야……?」
		ELSE
			PRINTFORMW 「…………」
		ENDIF
		;不機嫌
	ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]]) || TFLAG:193 == -3 ;custom code, hate mark 3
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「응…… 응……」
		ELSE
			PRINTFORMW 「응……으음……」
		ENDIF
		;	;デート会話,未定
		;	ELSEIF TALENT:[[キスメ]]:恋慕 && FLAG:デート相手 == [[キスメ]] && DATENAME_SPOT() != "道中" && !デート会話:(CFLAG:[[キスメ]]:現在位置 / 10)
		;くしゃみ
	ELSEIF !RAND:200
		PRINTFORMW 「쪽! ……쭈욱」
		;通常
	ELSE
		;失敗
		IF TFLAG:SELECTCOMの分岐 == -1
			IF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「그, 그런 건……」
			ELSE
				PRINTFORMW 「아, 그래……」
			ENDIF
			;恋慕
		ELSEIF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:14
				CASE 1
					PRINTFORMW 「후후…… %조사처리(CALLNAME:MASTER,"와")% 얘기하는 거, 즐거워……」
				CASE 2
					PRINTFORMW 「그, 뼈를 모으는 게…… 취미……」
				CASE 3
					PRINTFORML 「지상은 종종 이상한 일들이 일어나는데…… 지하세계는 언제나 변하지 않아서……」
					PRINTFORMW 「거기가 좋아……」
				CASE 4
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 사람인데 강하네……」
				CASE 5
					PRINTFORMW 「바깥세상에서 우물이 사라지고 있으니까, 여기에는 우물이 많이 있는 거야……」
				CASE 6
					PRINTFORML 「요즘은 양동이가 유행이라고 한다……」
					PRINTFORMW 「저, 저에게는 조금……」
				CASE 7
					PRINTFORMW 「바람이 불면 대장간이 돈을 번다니...? 대장간...?」
				CASE 8
					PRINTFORMW 「좁은 곳은 마음이 놓여서 좋아……」
				CASE 9
					PRINTFORMW 「오니비라는 건…… 그게…… 불……」
				CASE 10
					PRINTFORML 「가끔 우물로 바깥세상과 연결되는 기분이야……」
					PRINTFORMW 「흐, 비밀로 해줘……」
				CASE 11
					PRINTFORMW 「어, 어떻게 하면 강해질 수 있을까……?」
				CASE 12
					CALL M_KOJO_K83_TALKSET("汎用")
				CASE 13
					CALL M_KOJO_K83_TALKSET("思慕")
				CASEELSE
					CALL M_KOJO_K83_TALKSET("キャラ")
			ENDSELECT
			;思慕
		ELSEIF TALENT:[[キスメ]]:思慕
			IF !RAND:6
				CALL M_KOJO_K83_TALKSET("汎用")
			ELSE
				CALL M_KOJO_K83_TALKSET("思慕")
			ENDIF
			;それ以外
		ELSE
			;地底住まい
			IF MAIN_MAP == 9
				SELECTCASE RAND:6
					CASE 1
						PRINTFORMW 「밖에서 온 거구나…… 후응……」
					CASE 2
						PRINTFORMW 「별로 이야기하는 거…… 서툴러……」
					CASE 3
						PRINTFORMW 「지, 지하세계는…… 어때?」
					CASE 4
						PRINTFORMW 「그, 여러 가지 있었구나……」
					CASE 5
						PRINTFORMW 「사람이 여기에 있는 건 위험하다고 생각해……」
					CASEELSE
						CALL M_KOJO_K83_TALKSET("汎用")
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:6
					CASE 1
						PRINTFORMW 「밖에서 온 거구나…… 후응……」
					CASE 2
						PRINTFORMW 「별로 이야기하는 거…… 서툴러……」
					CASE 3
						PRINTFORMW 「저, 저는 지하에 살고 있어요……」
					CASE 4
						IF TIME >= 1200 || TIME < 360
							PRINTFORMW 「이, 이렇게 늦은 시간에 어디 나가고 있는 거야……?」
						ELSEIF !AT_HOME(MASTER)
							PRINTFORMW 「뭐, 뭐 하러 온 거야……?」
						ELSE
							PRINTFORMW 「이, 여기에 살고 있는 거야……」
						ENDIF
					CASE 5
						IF !AT_HOME(MASTER)
							PRINTFORMW 「사람이 여기에 있는 건 위험하다고 생각해……」
						ELSE
							PRINTFORMW 「아, 아무래도 그냥 온 것뿐인데……」
						ENDIF
					CASEELSE
						CALL M_KOJO_K83_TALKSET("汎用")
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;会話セット
;==================================================

@M_KOJO_K83_TALKSET(ARGS)
SELECTCASE ARGS
	CASE "汎用"
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「나도 옛날에는……」
				CASE 2
					PRINTFORMW 「저기…… 아마……」
				CASE 3
					PRINTFORMW 「응…… 그렇네」
				CASE 4
					PRINTFORMW 「어제 이런 일이……」
				CASEELSE
					PRINTFORMW 「있잖아, %CALLNAME:MASTER%……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「저기…… 그게……」
				CASE 2
					PRINTFORMW 「우... 응……」
				CASE 3
					PRINTFORMW 「저기…… 그러니까……」
				CASEELSE
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")%……」
			ENDSELECT
		ENDIF
	CASE "キャラ"
		SELECTCASE RAND:7
			CASE 1
				PRINTFORMW 「야마메는…… 내가 태어났을 때부터 같이 있어 주는…… 소중한 사람이야」
			CASE 2
				PRINTFORMW 「파르시는…… 근본은 상냥한 사람이야. 나한테도 다정하게 대해줘……」
			CASE 3
				PRINTFORML 「유기 씨는…… 누구나 똑같이 대해주시는군요……」
				PRINTFORMW 「하지만, 저는 약하니까…… 너무 많이……」
			CASE 4
				PRINTFORMW 「사토리 씨는…… 밖에 나오지 않아서 별로 안 봐……」
			CASE 5
				PRINTFORMW 「린쨩은…… 가끔 신경 써 주곤 해……」
				PRINTFORMW 「하지만, 그 고양이 차에는 태워달라고 할 수 없어……」
			CASE 6
				PRINTFORMW 「소라쨩은…… 뭘 생각하는 건지 잘 모르겠어……」
			CASEELSE
				PRINTFORMW 「코, 코이시쨩은…… 아, 별로 본 적 없어……」
		ENDSELECT
	CASE "思慕"
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「그, 바깥세상 일들…… 듣고 싶어……」
			CASE 2
				PRINTFORMW 「이 그릇은…… 나의 일부 같은 거야……」
			CASE 3
				IF MAIN_MAP == 9
					PRINTFORMW 「지, 지하에서의 생활은 어때……?」
				ELSE
					PRINTFORMW 「지, 지하세계는 즐거워…… 아마…….」
				ENDIF
			CASE 4
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 인간인데…… 이상해」
			CASEELSE
				PRINTFORMW 「낚시 미끼는…… 오니비 같은 걸 내보내는 거야……」
		ENDSELECT
	CASE "酔いどれ"
		SELECTCASE RAND:4
			CASE 1
				PRINTFORML 「헤헤헤…… 후후」
			CASE 2
				PRINTFORML 「에헤헤헤……」
			CASE 3
				PRINTFORML 「후헤헤…… 끅!」
			CASEELSE
				PRINTFORML 「후훗, 아하하핫!」
		ENDSELECT
		PRINTFORMDW 키스메는 취해 있어…….
ENDSELECT
