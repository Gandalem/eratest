RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;押し倒され値	ENDURE([[キスメ]]) >= RAND:300 + 300で真,しかしRANDの値は変化するのでここでは400を超えたら押し倒されることにする
	IF FLAG:時間停止
		;野外失敗
	ELSEIF TFLAG:194 == 2
		IF ENDURE([[キスメ]]) > 400
			PRINTFORMW 「엣, 여기서는 좀…… 안돼……」
		ELSE
			PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：弱")% 야, 그만해……!」
		ENDIF
		;人目失敗
	ELSEIF TFLAG:194 == 1
		IF ENDURE([[キスメ]]) > 400
			PRINTFORMW 「안, 안 돼…… 사람이 있잖아……」
		ELSE
			PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：弱")% 야, 그만해……!」
		ENDIF
		;乱交失敗
	ELSEIF TFLAG:194 == 3
		PRINTFORMW 「엣!? 그, 그런 건…… 싫어……」
		;ムード失敗
	ELSEIF TFLAG:194 == 4
		PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：弱")% 미, 미안해……」
		;泥酔失敗
	ELSEIF TFLAG:194 == 5
		CALL M_KOJO_K83_TALKSET("酔いどれ")
		PRINTL 
		PRINTFORMDW 옷 벗은 걸 목격자가 있는데 술에 취해 범할 수는 없잖아
		;泥酔
	ELSEIF TCVAR:[[キスメ]]:泥酔 == 1
		PRINTFORMW 「흐윽…… 뭐, 뭘 하시는 거야……?」
		;乱交
	ELSEIF GET_TARGETNUM() > 1
		IF CFLAG:[[キスメ]]:現在位置 == CFLAG:[[ヤマメ]]:現在位置
			PRINTFORMW 「야, 야마메쨩도……? %조사처리(CALLNAME:MASTER,"가")% 하고 싶다면……뭐……」
		ELSE
			PRINTFORMW 「에…… 미, 모두랑 같이 해줘…… %조사처리(CALLNAME:MASTER,"가")% 하고 싶다면…… 뭐……」
		ENDIF
		;それ以外
	ELSEIF !TCVAR:[[キスメ]]:351
		IF M_KOJO_K83_UFUFU([[キスメ]])
			PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")%」
		ELSE
			PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：弱")%」
		ENDIF
	ENDIF
	;先に押し倒された
	IF TCVAR:[[キスメ]]:351
		IF M_KOJO_K83_UFUFU([[キスメ]])
			PRINTL 
			PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 죄, 죄송해요…… 상냥하게 해줘……」
		ENDIF
		;通常押し倒し
	ELSEIF !FLAG:時間停止 && !TFLAG:194
		PRINTL 
		SELECTCASE TCVAR:[[キスメ]]:抱き寄せ初回
			;普通の初回,キスがまだ
			CASE 1, 2
				PRINTFORMW 「%CALLNAME:MASTER%……이거 있잖아…… 그게……」
				SIF M_KOJO_K83_UFUFU([[キスメ]])
					PRINTFORMW 「……야, 상냥하게 해줘…… 응?」
				;媚薬or発情
			CASE 3
				PRINTFORMW 「아... 좋아, %CALLNAME:MASTER%... 하고 싶은 대로 해봐... \/\/\/」
				;時姦
			CASE 4
				PRINTFORMW 「에엣, 싫어읏…… 어째서…… 왜……」
				;臆病
			CASE 5
				PRINTFORMW 「그, 그럴 리가…… 으윽……」
				;もうちょっと
			CASE 6
				PRINTFORMW 「%CALLNAME:MASTER%……나……아직……」
				;ダメ
			CASE 7
				PRINTFORMW 「저기……. 그, 이런 건……」
				;早すぎ
			CASE 8
				PRINTFORMW 「싫어, 싫다고오~!!」
				;初回以降
			CASEELSE
				;酔ってる
				IF M_KOJO_K83_YOIDORE([[キスメ]])
					PRINTFORMW 「후아~, %CALLNAME:MASTER%~~읏!」
					;不機嫌
				ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
					PRINTFORMW 「흐읍……」
					;屋外
				ELSEIF OUTROOF(CFLAG:MASTER:現在位置)
					IF M_KOJO_K83_UFUFU([[キスメ]])
