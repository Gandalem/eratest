;315,クリ愛撫
;CFLAG:うふふ==2&&TCVAR:20(35=スカートの中を見せる 70=クンニ強制 85=Ｖ挿入する 86=だいしゅきホールド 87=Ａ挿入する 88=腰振りＶ 89=腰振り
;ABL:Ｃ感覚(4未満=くすぐったい 6未満=ちょっといいかも 6以上=カイカン)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K83_315
CALL M_KOJO_MESSAGE_COM_K83_315_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_315_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;時間停止中
	IF FLAG:時間停止
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「응~……!」
		;押し倒され中
	ELSEIF CFLAG:[[キスメ]]:うふふ == 2
		SIF !M_KOJO_K83_UFUFU([[キスメ]])
			RETURN 1
		SELECTCASE TCVAR:[[キスメ]]:カウンター行動
			;スカートの中を見せる
			CASE 35
				PRINTFORMW 「앙! 좋아, 거기! 하으윽! 더! 응큐옷!」
				;クンニ強制
			CASE 70
				PRINTFORMW 「아앗, 좋아읏, 더 해줘. 쭈욱쭈욱하게……읏!」
				;Ｖ挿入,だいしゅきホールド,Ａ挿入,Ｖ腰振り,Ａ腰振り
			CASE 85, 86, 87, 88, 89
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% 라메읏! 어, 오카히쿠나앗햣햐우윽!! 응아앗!」
				;それ以外
			CASEELSE
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% %M_KOJO_K83_AUTO("二連刺激")% 좋아읏!」
		ENDSELECT
		;酔ってる
	ELSEIF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
		;不機嫌
	ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「싫어…… 싫다고……」
		ELSE
			PRINTFORMW 「싫다아~앗!」
		ENDIF
		;通常
	ELSE
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「앙……」
				CASE 2
					PRINTFORMW 「응앗! 안, 안 돼……」
				CASE 3
					PRINTFORMW 「하으읏…… %CALLNAME:MASTER%~……」
				CASE 4
					PRINTFORMW 「아우으…… 기분… 좋아……」
				CASEELSE
					PRINTFORMW 「앗, 아앗……! 시러어……\/\/\/」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「아……」
				CASE 2
					PRINTFORMW 「응응……」
				CASEELSE
					PRINTFORMW 「흐으…」
			ENDSELECT
		ELSE
			PRINTFORML 「%M_KOJO_K83_AUTO("悲鳴：弱")%」
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「에…… 뭐야……」
				CASEELSE
					PRINTFORMW 「아... 그만해줘……」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
