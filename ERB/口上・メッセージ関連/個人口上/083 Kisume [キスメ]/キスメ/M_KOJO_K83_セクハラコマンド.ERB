			;		CASE 85, 87, 88, 89
			;			PRINTFORMW 「」
			CASE 86
				PRINTFORML 「앗, 그, 그럴 리가……히얀읏!」
				CALL HPH_PRINT(@"「좋아…… 해봐! 잔뜩 싸버려…… HPH」", "W")
				;それ以外
			CASEELSE
				PRINTFORMW 「앙! 더…… 해줘……」
		ENDSELECT
		;酔ってる
	ELSEIF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
