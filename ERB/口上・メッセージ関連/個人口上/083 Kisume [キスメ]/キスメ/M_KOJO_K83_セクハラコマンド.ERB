	ELSEIF CFLAG:睡眠
		PRINTFORMW 「하아아~……!」
		;押し倒され中
	ELSEIF CFLAG:[[キスメ]]:うふふ == 2
		SIF !M_KOJO_K83_UFUFU([[キスメ]])
			RETURN 1
		SELECTCASE TCVAR:[[キスメ]]:カウンター行動
			;		;胸を揉ませる
			;		CASE 33
			;			PRINTFORMW 「」
			;		;パイズリ
			;		CASE 53
			;			PRINTFORMW 「」
			;		;ぱふぱふ
			;		CASE 73
			;			PRINTFORMW 「」
			;		;乳合わせ
			;		CASE 74
			;			PRINTFORMW 「」
			;		;乳を吸わせる
