	ELSE
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「응앗……」
				CASE 2
					PRINTFORMW 「응……. %조사처리(CALLNAME:MASTER,"는")%……. 야한 거구나……」
				CASE 3
					PRINTFORMW 「후와아~! 간, 간지러워……」
				CASE 4
					PRINTFORMW 「하아……. 기, 기분 좋아…….」
				CASEELSE
