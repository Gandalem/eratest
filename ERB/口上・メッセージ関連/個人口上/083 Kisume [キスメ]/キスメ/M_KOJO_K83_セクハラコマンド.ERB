@M_KOJO_MESSAGE_COM_K83_316_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;時間停止中
	IF FLAG:時間停止
		;押し倒され中
	ELSEIF CFLAG:[[キスメ]]:うふふ == 2
