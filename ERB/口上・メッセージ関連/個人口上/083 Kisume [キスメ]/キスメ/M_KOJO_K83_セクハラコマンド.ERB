;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K83_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K83_310
CALL M_KOJO_MESSAGE_COM_K83_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;時間停止中
	IF FLAG:時間停止
		;睡眠中
	ELSEIF CFLAG:睡眠
		;押し倒され中
	ELSEIF CFLAG:[[キスメ]]:うふふ == 2
		SIF !M_KOJO_K83_UFUFU([[キスメ]])
			RETURN 1
		PRINTFORMW 「후후…… 기다려 봐……」
		;酔ってる
	ELSEIF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
		;不機嫌
	ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 심술이……」
		ELSE
			PRINTFORMW 「으응…… 하, 하드아……」
		ENDIF
		;通常
	ELSE
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：弱")%」
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「에…… 에치!」
				CASE 2
					PRINTFORMW 「……바보」
				CASE 3
					PRINTFORMW 「키, 갑자기 그러지 마요……」
				CASE 4
					PRINTFORMW 「깜짝, 놀랐어……」
				CASEELSE
					PRINTFORMW 「이제……」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「%M_KOJO_K83_AUTO("悲鳴：強")%」
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「뭐, 뭐야……?」
				CASE 2
					PRINTFORMW 「왜…… 왜 이러는 거야……?」
				CASEELSE
					PRINTFORMW 「싫, 싫어……」
			ENDSELECT
		ELSE
			PRINTFORMW 「히아앗!!」
			PRINTFORMW 「야, 그만해줘...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K83_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K83_311
CALL M_KOJO_MESSAGE_COM_K83_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;時間停止中
	IF FLAG:時間停止
		;睡眠中
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「응…… 헤헤……」
		;押し倒され中
	ELSEIF CFLAG:[[キスメ]]:うふふ == 2
		SIF !M_KOJO_K83_UFUFU([[キスメ]])
			RETURN 1
		SELECTCASE TCVAR:[[キスメ]]:カウンター行動
			;		;前から抱きつく
			;		CASE 32
			;			PRINTFORMW 「」
			;ディープキス
			CASE 60
				PRINTFORML 「츄우욱……음……퍄」
				PRINTFORMW 「응…… 안고 하면서 하는 키스…… 좋아……\/\/\/」
				;		;ぱふぱふ
				;		CASE 73
				;			PRINTFORMW 「」
				;		;乳合わせ
				;		CASE 74
				;			PRINTFORMW 「」
				;		;乳を吸わせる
				;		CASE 77
				;			PRINTFORMW 「」
				;Ｖ挿入,Ａ挿入,Ｖ腰振り,Ａ腰振り
			CASE 85, 87, 88, 89
				PRINTFORMW 「%M_KOJO_K83_AUTO("単刺激")% %CALLNAME:MASTER%……꽉……읏!」
				;だいしゅきホールド
			CASE 86
				PRINTFORML 「%M_KOJO_K83_AUTO("単刺激")% %CALLNAME:MASTER%읏! 놓지 마아……읏!」
				CALL HPH_PRINT(@"「안에 싸줘……읏! 잔뜩……! 잔뜩 줘요옷 HPH」", "W")
				;それ以外
			CASEELSE
				PRINTFORMW 「%CALLNAME:MASTER%…… 따뜻해서…… 좋아……」
		ENDSELECT
		;添い寝
	ELSEIF CFLAG:[[キスメ]]:添い寝中
		CALL HPH_PRINT(@"「응…… %CALLNAME:MASTER%, 따뜻해…… 흐으윽」", "W")
		;酔ってる
	ELSEIF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
		;不機嫌
	ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「음~ %CALLNAME:MASTER%~」
		ELSE
			PRINTFORMW 「우에엥……」
		ENDIF
		;通常
	ELSE
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%…… 좋아해……」
				CASE 2
					PRINTFORMW 「응…… 마음이 놓여……」
				CASE 3
					PRINTFORMW 「%CALLNAME:MASTER%, 안아줘……」
				CASE 4
					PRINTFORMW 「따뜻하다아……」
				CASEELSE
					PRINTFORMW 「더, 더 꽉 안아줘……」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「꽉……」
				CASE 2
					PRINTFORMW 「흣……」
				CASEELSE
					PRINTFORMW 「에헤……」
			ENDSELECT
		ELSE
			PRINTFORML 「%M_KOJO_K83_AUTO("悲鳴：弱")%」
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「싫어…… 싫다고……」
				CASE 2
					PRINTFORMW 「……뭐, 뭐야」
				CASEELSE
					PRINTFORMW 「흐으윽…… 숨이 막혀……」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K83_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
SIF M_KOJO_K83_FUKIGEN([[キスメ]]) && !M_KOJO_K83_YOIDORE([[キスメ]])
	TFLAG:192 = -2

@M_KOJO_MESSAGE_COM_K83_312
CALL M_KOJO_MESSAGE_COM_K83_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL M_KOJO_COLOR_K83
	;時間停止中
	IF FLAG:時間停止
		;睡眠中
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「음…… 후우……」
		;押し倒され中
	ELSEIF CFLAG:[[キスメ]]:うふふ == 2
		IF FIRSTTIME("ファーストキス")
			PRINTFORML 「ひゃ읏!」
			PRINTFORMW 「えへへ……キスしたの……はじめて\/\/\/」
		ELSE
			SIF !M_KOJO_K83_UFUFU([[キスメ]])
				RETURN 1
			SELECTCASE TCVAR:[[キスメ]]:カウンター行動
				;前から抱きつく
				CASE 32
					PRINTFORML 「쪽……」
					PRINTFORMW 「응…… 안아주면서 하는 키스…… 기뻐…… \/\/\/」
					;手淫
				CASE 50
					PRINTFORML 「음촉…츄우욱……퍄」
					PRINTFORMW 「어때…? 기분 좋아?」
					;ディープキス
				CASE 60
					PRINTFORML 「응읏... 아ㅁ... 쪽쪽... 츄릅...」
					PRINTFORMW 「하아, 하아... 더, 더...」
					;Ｖ挿入,Ａ挿入,Ｖ腰振り,Ａ腰振り
				CASE 85, 87, 88, 89
					CALL HPH_PRINT(@"「키스하면서…… 가자아아앗」", "L")
					PRINTFORMW 「응츄윽... 함욱, 응읏, 음음음!!」
					;だいしゅきホールド
				CASE 86
					PRINTFORML 「츄읍, 아앗, 라메엣…… 더!!」
					CALL HPH_PRINT(@"「이대로 가버려…… 후헸」", "W")
					;それ以外
				CASEELSE
					PRINTFORMW 「츄…… 파아…… 또, 한 번만 더…… 츄우우……」
			ENDSELECT
		ENDIF
		;添い寝
	ELSEIF CFLAG:[[キスメ]]:添い寝中
		IF FIRSTTIME("ファーストキス")
			PRINTFORMW 「엣?!」
			PRINTFORMW 「저... 저 처음이야... \/\/\/」
		ELSE
			PRINTFORMW 「음... \/\/\/」
		ENDIF
		;酔ってる
	ELSEIF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
		;拒絶
	ELSEIF TFLAG:SELECTCOMの分岐 == 99 || TFLAG:192 == -2
		PRINTFORMW 「안, 안돼애……!」
		;ファーストキス
	ELSEIF FIRSTTIME("ファーストキス")
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「쪽……!!」
			PRINTFORMW 「와아…… %조사처리(CALLNAME:MASTER,"와")% 키스, 해버렸어…… \/\/\/」
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORMW 「응, 흐읍...!!」
			PRINTFORMW 「저, 저의... 처음이에요\/\/\/」
		ELSE
			PRINTFORMW 「응윽……!!」
			PRINTFORMW 「저, 저 처음이에요……」
		ENDIF
		;通常
	ELSE
		IF TALENT:[[キスメ]]:恋慕
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「응츄……. 파아……」
				CASE 2
					PRINTFORMW 「쪽…… 에헤헤……\/\/\/」
				CASE 3
					PRINTFORMW 「후아아……」
				CASE 4
					PRINTFORMW 「응아…… 멍해져 버려……」
				CASEELSE
					PRINTFORMW 「츄우……. 응, 더……」
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「음... \/\/\/」
				CASE 2
					PRINTFORMW 「흐으……」
				CASEELSE
					PRINTFORMW 「츄읍……」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「응응!? ……」
				CASEELSE
					PRINTFORMW 「아우윽……」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
