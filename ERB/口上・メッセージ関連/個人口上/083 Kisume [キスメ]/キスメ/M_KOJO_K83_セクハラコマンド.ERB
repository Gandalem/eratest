			CASEELSE
				PRINTFORMW 「%M_KOJO_K83_AUTO("二連刺激")%응응, 더……읏!」
		ENDSELECT
		;酔ってる
	ELSEIF M_KOJO_K83_YOIDORE([[キスメ]])
		CALL M_KOJO_K83_TALKSET("酔いどれ")
