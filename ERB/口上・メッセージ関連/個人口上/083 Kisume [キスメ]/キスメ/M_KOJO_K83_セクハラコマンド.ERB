	ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORMW 「자…… 그만해줘……」
		ELSE
			PRINTFORMW 「우에~……」
		ENDIF
		;通常
	ELSE
		IF TALENT:[[キスメ]]:恋慕
			PRINTFORM 「%M_KOJO_K83_AUTO("単刺激")% 
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 저…… 쇼코는…….
				CASE 2
					PRINTFORMW 후우윽... 후우윽!
				CASE 3
					PRINTFORMW 하아, 하아……읏!
				CASE 4
					PRINTFORMW 헤, 변태...!
				CASEELSE
					PRINTFORMW 어, 왜 이래아……
			ENDSELECT
		ELSEIF TALENT:[[キスメ]]:思慕
			PRINTFORM 「%M_KOJO_K83_AUTO("単刺激")%
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 안, 안돼……
				CASE 2
					PRINTFORMW 아, 안 돼……
				CASEELSE
					PRINTFORMW 야, 싫어……읏
			ENDSELECT
		ELSE
			PRINTFORML 「%M_KOJO_K83_AUTO("悲鳴：強")%」
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「싫어어~읏!」
				CASEELSE
					PRINTFORMW 「그만해……!!」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
