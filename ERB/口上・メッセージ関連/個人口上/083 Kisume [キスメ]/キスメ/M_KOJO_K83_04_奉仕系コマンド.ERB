;82,パイズリ
;==================================================

@M_KOJO_MESSAGE_COM_K83_82
CALL M_KOJO_MESSAGE_COM_K83_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORML 「무, 가슴……」
		PRINTFORMW 「%CALLNAME:MASTER%……저한테 화풀이하는 거예요?」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		;イきそう
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「후후, %CALLNAME:MASTER%, 갈 것 같구나……」
		CALL HPH_PRINT(@"「엄청 기분 좋아 보이네…… 기쁘다…… HPH」", "W")
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「으윽…… 무, 무거워……」
			CASE 2
				PRINTFORMW 「하아... 하아... 뜨거워...」
			CASEELSE
				IF TALENT:[[キスメ]]:バストサイズ < 0
					PRINTFORMW 「……좀 더 컸으면 좋았을텐데…… 미안해……」
				ELSE
					PRINTFORMW 「어때……. 나, 잘하고 있어?」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
