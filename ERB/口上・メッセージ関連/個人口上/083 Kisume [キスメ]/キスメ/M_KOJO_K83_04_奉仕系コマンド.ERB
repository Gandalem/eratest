;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K83_80
CALL M_KOJO_MESSAGE_COM_K83_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		;未成熟,粗チン
		IF TALENT:MASTER:形状 == 1 || TALENT:MASTER:形状 == 2
			PRINTFORMW 「쥐고 비벼주는 거야……?」
		ELSE
			PRINTFORMW 「오, 커……. 잡고 비비는 거야...?」
		ENDIF
		PRINTFORMW 「이, 이대로 괜찮을까...? 어떡하지...」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		;イきそう
	ELSEIF NOWEX:MASTER:射精
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 「엄청 부풀었네…… 갈 것 같구나……」
				CALL HPH_PRINT(@"「괜찮아…… 잔뜩 뿜어줘…… HPH」", "W")
			CASEELSE
				PRINTFORML 「갈 것 같아? 그럼 더 빨리 해줄게……」
				CALL HPH_PRINT(@"「괜찮아…… 잔뜩 뿜어줘…… HPH」", "W")
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 1
				PRINTFORML 「어, 어때……?」
				PRINTFORMW 「많이 기분 좋아졌으면 좋겠네……」
			CASE 2
				PRINTFORML 「쓰담쓰담 해 줄게…」
				PRINTFORMW 「후후… 귀엽네…」
			CASE 3
				PRINTFORML 「잘 되어가고 있나? 정말로?」
				PRINTFORMW 「다행이다……. 더 노력하겠다…….」
			CASE 4
				PRINTFORML 「스윽, 기분 좋아……?」
				PRINTFORMW 「괜찮아, 더 기분 좋아져 봐……」
			CASEELSE
				;未成熟,粗チン
				IF TALENT:MASTER:形状 == 1 || TALENT:MASTER:形状 == 2
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 거시기……. 작고 귀엽다…….」
					PRINTFORMW 「괜찮아, 나의 몸에는 딱 맞을 거야……」
					;発光,イボ付き
				ELSEIF TALENT:MASTER:形状 == 4 || TALENT:MASTER:形状 == 5
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 거시기……. 그……」
					PRINTFORMW 「헤, 이상하다고 생각해……. 역시…….」
				ELSE
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 거시기…… 크네……」
					PRINTFORMW 「이렇게 큰 게…… 내 안에…… 꿀꺽」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
