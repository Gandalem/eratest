@M_KOJO_MESSAGE_COM_K83_83
CALL M_KOJO_MESSAGE_COM_K83_83_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_83_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORMW 「저, 소모... 좋아야……. 해볼게……」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		;イきそう
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「하아... 하아... %CALLNAME:MASTER%, 갈 거야?」
		CALL HPH_PRINT(@"「그럼 이대로 가버릴까…… HPH」", "W")
	ELSE
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「하아... 하아... 아, 이거... 기분 좋아...!」
			CASE 2
				PRINTFORML 「%CALLNAME:MASTER%…… 어떡해……?」
				PRINTFORMW 「나도…… 응, 기분 좋아……」
			CASE 3
				PRINTFORMW 「아우으윽…… 하아, 미끌미끌해서…… 좋다……」
			CASEELSE
				PRINTFORMW 「응읏... 아앗, 응읏……. 하, 들어가 버릴 것 같아……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
