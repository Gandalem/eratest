;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K83_81
CALL M_KOJO_MESSAGE_COM_K83_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K83_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = M_KOJO_K83_UFUFU([[キスメ]])
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM) && !FLAG:時間停止
		PRINTFORML 「오, 커……. 이런 건 들어가지 않을지도 몰라…….」
		PRINTFORMW 「아니야, 해, 해볼게……!」
		RETURN 1
	ENDIF
	IF FLAG:時間停止
		;イきそう
	ELSEIF NOWEX:MASTER:射精
		PRINTFORML 「음프, 음……」
		CALL HPH_PRINT(@"「갈 것 같아? 그럼 이대로, 입안에 잔뜩 넣을게…… HPH」", "W")
	ELSE
		SELECTCASE RAND:5
			CASE 1
				PRINTFORML 「응, 응구……푸하아」
				PRINTFORMW 「미, 미안해, 역시 커서……」
			CASE 2
				PRINTFORML 「응구... 츄읍... 쩝」
				PRINTFORMW 「하아... 하아.... 낼름」
			CASE 3
				PRINTFORML 「흐, 입으로 해줄게……. 응으……응구윽……」
				PRINTFORMW 「기, 기분 좋아……?」
			CASE 4
				PRINTFORML 「뻬로... 뻬로... 아구... 구쥬...」
				PRINTFORMW 「오, 오힝힝, 오이히이...」
			CASEELSE
				PRINTFORML 「꾸윽... 꾸윽... 퍄」
				PRINTFORMW 「기, 기분 좋았어? 헤헤……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
