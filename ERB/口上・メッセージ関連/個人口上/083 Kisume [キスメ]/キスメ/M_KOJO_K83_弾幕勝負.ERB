; Modular ERB: 個人口上/083 Kisume [キスメ]/キスメ/M_KOJO_K83_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K83_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;酔ってる
		IF M_KOJO_K83_YOIDORE([[キスメ]])
			CALL M_KOJO_K83_TALKSET("酔いどれ")
			;不機嫌
		ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
			PRINTFORMW 「네에…… 알겠습니……」
			;通常
		ELSE
			IF TALENT:[[キスメ]]:恋人
				PRINTFORMW 「자, 지지 않을 거야...!」
			ELSEIF TALENT:[[キスメ]]:恋慕
				PRINTFORMW 「하, 힘낼게...!」
			ELSEIF TALENT:[[キスメ]]:思慕
				PRINTFORMW 「잘 부탁해……」
			ELSE
				PRINTFORMW 「저, 저 약하단 말이야……」
			ENDIF
		ENDIF
		RETURN 0
	ENDIF
	;	;-------------------------------------------------
	;	;ハンデ
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARGS == "ハンデ"
	;		;ハンデつけなかったら表示されないので無記入でよい
	;		PRINTFORML
	;		RETURN 0
	;	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			;酔ってる
			IF M_KOJO_K83_YOIDORE([[キスメ]])
				PRINTFORML 「응…?」
				;不機嫌
			ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
				PRINTFORML 「…………」
				;通常
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「아, 당했어……」
					CASE 2
						PRINTFORML 「강해……읏」
					CASEELSE
						PRINTFORML 「모, 이제 안 돼……」
				ENDSELECT
			ENDIF
		ELSE
			;酔ってる
			IF M_KOJO_K83_YOIDORE([[キスメ]])
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「흐읍!?」
					CASE 2
						PRINTFORML 「응?!」
					CASEELSE
						PRINTFORML 「……！？」
				ENDSELECT
				;不機嫌
			ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「이제 그만하고 싶어……」
					CASE 2
						PRINTFORML 「아파……」
					CASEELSE
						PRINTFORML 「우으……」
				ENDSELECT
				;通常
			ELSE
				PRINTFORML 「%M_KOJO_K83_AUTO("被弾")%」
			ENDIF
		ENDIF
	ENDIF
	;	;-------------------------------------------------
	;	;戦闘中
	;	;TARGETの【残忍酷薄】発動時
	;	;ARGはTARGETの残機
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARGS == "残忍酷薄"
	;
	;	ENDIF
	;	;-------------------------------------------------
	;	;戦闘中
	;	;TARGETの【乾坤一擲】発動時
	;	;ARGはTARGETの残機
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARGS == "乾坤一擲"
	;
	;	ENDIF
	;	;-------------------------------------------------
	;	;戦闘中
	;	;TARGETの【怪力乱神】発動時
	;	;ARGはTARGETの残機
	;	;記入チェック（=0, 非表示、1, 表示）
	;	LOCAL:1 = 0
	;	;-------------------------------------------------
	;	IF LOCAL:1 && ARGS == "怪力乱神"
	;
	;	ENDIF
	;
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			;酔ってる
			IF M_KOJO_K83_YOIDORE([[キスメ]])
				PRINTFORMW 「저기……?」
				;不機嫌
			ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
				PRINTFORMW 「너무해……」
				;通常
			ELSE
				IF TALENT:[[キスメ]]:恋人
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%CALLNAME:MASTER%~, 봐줘~」
						CASE 2
							PRINTFORMW 「즐거웠어...♪」
						CASEELSE
							PRINTFORMW 「또 놀자~♪」
					ENDSELECT
				ELSEIF TALENT:[[キスメ]]:恋慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「강한 사람은 좋겠네……」
						CASE 2
							PRINTFORMW 「상대가 안 돼……」
						CASEELSE
							PRINTFORMW 「졌지만, 즐거웠어……」
					ENDSELECT
				ELSEIF TALENT:[[キスメ]]:思慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 강하네……」
						CASE 2
							PRINTFORMW 「크윽, 분하다……」
						CASEELSE
							PRINTFORMW 「져버렸어……」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「마, 졌어……」
						CASE 2
							PRINTFORMW 「무, 무리야……」
						CASEELSE
							PRINTFORMW 「%CALLNAME:MASTER%, 강해……」
					ENDSELECT
				ENDIF
			ENDIF
			;キスメ勝利
		ELSE
			;酔ってる
			IF M_KOJO_K83_YOIDORE([[キスメ]])
				PRINTFORMW 「아하하! 재미있었어~」
				;不機嫌
			ELSEIF M_KOJO_K83_FUKIGEN([[キスメ]])
				PRINTFORMW 「……바보」
				;通常
			ELSE
				IF TALENT:[[キスメ]]:恋人
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「%CALLNAME:MASTER%, 나보다 약하다니……」
						CASE 2
							PRINTFORMW 「아, 아팠어...? 미안해……」
						CASEELSE
							PRINTFORMW 「다음에 특별 훈련하자~♪」
					ENDSELECT
				ELSEIF TALENT:[[キスメ]]:恋慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「우, 운이 좋았어...!」
						CASE 2
							PRINTFORMW 「%CALLNAME:MASTER%도 강했네……」
						CASEELSE
							PRINTFORMW 「후후, 즐거워……」
					ENDSELECT
				ELSEIF TALENT:[[キスメ]]:思慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「어라…… 이겨버렸네……」
						CASE 2
							PRINTFORMW 「좋은 승부였어……」
						CASEELSE
							PRINTFORMW 「미, 미안해……」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORMW 「약해……」
						CASE 2
							PRINTFORMW 「에…… 끝이야…?」
						CASEELSE
							PRINTFORMW 「얌전히 있는 게……」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
