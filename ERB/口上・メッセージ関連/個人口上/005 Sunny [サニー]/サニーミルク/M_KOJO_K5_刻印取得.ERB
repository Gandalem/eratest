; Modular ERB: 個人口上/005 Sunny [サニー]/サニーミルク/M_KOJO_K5_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K5
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K5
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「아앗! 아파! 아파!」
	ENDIF
ELSEIF TFLAG:22 == 2
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「윽…… 흐윽……」
	ENDIF
ELSEIF TFLAG:22 == 3
	IF FLAG:時間停止
	ELSE
		PRINTFORMW 「그만둬요... 읏, 부탁이에요... 그만해...」
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 「왠지…… 기분이 포근해지는 걸」
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 「앗앗... 이게 뭐야 %UNICODE(0x2665) *1%」
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 「에헤헤~ 더 해줬으면 좋겠다%UNICODE(0x2665) *1%」
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 「좀 더 하자앗%UNICODE(0x2665) *1% 응?%UNICODE(0x2665) *1%」
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 말대로 하면 되는 거예요?」
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 「저기, 다음엔 저는 어떻게 하면 좋을까요? 뭘 해야 할까요?」
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「나한테는 이제 %CALLNAME:MASTER%밖에 없어……」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 「우와아! 그런 거 하면 나도 화낼 거야!」
ELSEIF TFLAG:21 == 2
	PRINTFORMW 「%CALLNAME:MASTER%같은 거 싫어!」
ELSEIF TFLAG:21 == 3
	PRINTFORMW 「언젠가 정말 고통스러운 경험을 시켜줄 거야...!」
ENDIF
