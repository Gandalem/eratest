;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K5_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K5_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K5_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, curiosity event.
	RESULT = 0
	TRYCALL K5_SANGETSUSEI_CURIOSITY
	SIF RESULT
		RETURN 1
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「그 얘기는 벌써 질렸어~!」
	ELSEIF CFLAG:TARGET:溜まってる度 > 500 && TALENT:5:SexKnow == -1 && EXP:5:絶頂経験 > 10
		SELECTCASE RAND:4
			;CASE 3
			;PRINTFORML
			;PRINTFORMW
			CASE 1
				PRINTFORML 「응… 아냐, 아무것도 아니야……」
				PRINTFORMW 서니는 애처로운 듯 %조사처리(CALLNAME:MASTER,"의")% 사타구니를 응시하고 있다.
			CASE 0
				PRINTFORML 「오늘은 안 하는 거야?」
				PRINTFORMW 서니는 몸을 쭈뼛거리며 가랑이를 비비고 있다.
			CASEELSE
				PRINTFORML 「……에? 아, 무슨 얘기하고 있었지...?」
				PRINTFORMW 서니는 뺨을 붉게 물들이며 %조사처리(CALLNAME:MASTER,"를")% 보고 있다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:5
			CASE 3
				PRINTFORML 「그래서 말이야! 그래서 말이야!」
				PRINTFORMW 서니는 몸을 흔들며 기분 좋게 수다를 계속하고 있다.
			CASE 2
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 나 어떤 점이 좋아?」
				PRINTFORML 「태양 같은 미소? %CALLNAME:MASTER%앞에서는 저절로 웃음이 나잖아! 좋아하는 만큼 마음껏 해도 돼!」
				PRINTFORMW 서니는 처지는 뺨을 가리키며 이쪽을 올려다보았다.
			CASE 1
				PRINTFORML 「이 스마트폰이라는 게 가챠 같은 게 들어있는 거잖아. 그걸로 돈을 빨아먹는다고 하더라!」
				PRINTFORMW 「그런데 비벼봐도, 내버려 놔도 아무 소리도 안 나…… 가짜인가 봐?」
			CASE 0
				PRINTFORML 「루나는 최근 밤을 재배하고 있거든」
				PRINTFORMW 「스타도 버섯 분재를 키우고 있고, 나도 뭔가 키워볼까나」
			CASEELSE
				PRINTFORML 「지옥에 가 본 적 있어? 정말 무섭고 겁나는 곳이야!」
				PRINTFORMW 「온천...? 오니...? 그게 뭐야?」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「비가 오고 있을 때 모습을 사라지게 해도 발견되는구나. 어째서일까?」
			CASE 0
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 계시면 평소엔 안 넣어주던 곳도 당당하게 넣을 수 있으니까 좋아!」
			CASEELSE
				PRINTFORMW 「장난이야말로 요정의 본분이자 사명이자, 살아가는 양식이라고!」
				PRINTFORMW 「%CALLNAME:MASTER%라면 알잖아요?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「레이무 씨가 요즘 장난에 걸리지 않는 거 아니야~」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 뭔가 좋은 아이디어 있어?」
			CASE 0
				PRINTFORMW 「요정낚시 같은 건 말도 안 되는 게 유행이래도, 나는 그렇게 쉽게 걸려들지 않아!」
				PRINTFORMW 「에? 과자가 떨어져 있으면 어쩌겠다는 거야? 그런 건 금방 달려들 수밖에 없잖아!」
			CASEELSE
				PRINTFORMW 「저는 햇빛의 요정이니까 태양이 뜨면 기운이 넘쳐요!」
				PRINTFORMW 「근데 안 떴으니까 벌써 축 늘어졌어…… 체력적으로도, 정신적으로도……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
