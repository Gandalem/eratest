@M_KOJO_SUCCESS_COM_K5_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K5_302
CALL M_KOJO_MESSAGE_COM_K5_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
	ELSEIF CFLAG:TARGET:溜まってる度 > 500 && TALENT:5:SexKnow == -1 && EXP:5:絶頂経験 > 10
		SELECTCASE RAND:4
			;CASE 3
			;PRINTFORML
			;PRINTFORMW
			;CASE 2
			;PRINTFORML
			;PRINTFORMW
			CASE 1
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 서니의 허벅지에 무릎을 대고 힘껏 밀어 넣는다.
				PRINTFORML 「야…… 그렇게 문지르면 싫어……%UNICODE(0x2665) *1%」
				PRINTFORMW 서니는 눈동자를 촉촉하게 하며 %조사처리(CALLNAME:MASTER,"의")% 무릎을 떼어내려 했지만, 그 힘은 미약했다.
			CASE 0
				PRINTFORML 「여기 문지르니 기분 좋은가 봐. 응……%UNICODE(0x2665) *1%」
				PRINTFORML 서니는 남의 시선도 신경 쓰지 않고 %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 팬티 너머 자신의 은밀한 곳에 손가락을 스치게 했다.
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 황급히 서니의 치태를 멈추게 했다.
			CASEELSE
				PRINTFORML 「응읏… 더 쓰다듬어줘……%UNICODE(0x2665) *1%」
				PRINTFORMW 서니는 열이 오르는 듯한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 가슴에 머리를 기대왔다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 2
				PRINTFORML 서니는 %조사처리(CALLNAME:MASTER,"의")% 목덜미에 매달려 다리를 흔들고 있다.
				PRINTFORMW 「후방령이라기보다는 후방 요정!」
			CASE 1
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 서니의 가느다란 하얀 다리를 쓰다듬었다.
				PRINTFORML 서니는 움찔하며 어깨를 떨었지만, 꾸민 듯한 분노의 얼굴로 %조사처리(CALLNAME:MASTER,"를")% 노려보았다.
				PRINTFORMW 「햐앗!... 벌써, 기쁘긴 한데 갑자기 만지면 깜짝 놀라잖아!」
			CASE 0
				PRINTFORML 서니를 안은 채 마음껏 쓰다듬었다.
				PRINTFORML 서니는 쓰다듬어지는 동안 %조사처리(CALLNAME:MASTER,"의")% 한 팔에 매달렸다.
				PRINTFORMW 「이렇게 하고 있으면, 너무 안심되는 거 있죠!」
			CASEELSE
				PRINTFORML 「사라진 나를 잡을 수 있어?」
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 아무렇지 않은 듯 보이지 않는 공간을 껴안자, 보이지 않는 서니를 쉽게 찾아냈다.
				PRINTFORMW 「정답! 역시 %CALLNAME:MASTER%네」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 망치 던지기처럼 서니의 양손을 잡고 휘둘렀다.
				PRINTFORMW 「우햐아!! 눈, 눈이 돌아가!」
			CASE 0
				PRINTFORML 「아하핫하하하햐햐!!」
				PRINTFORMW 「하, 날개 만지면 안 돼! 간질간져 아야야!!」
			CASEELSE
				PRINTFORML 골리앗 인형을 흉내 내면서 서니를 어깨에 태웠다.
				PRINTFORMW 「아하하하! 간다~!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4 ;custom code
			CASE 2 ;custom code
				PRINTFORML 서니를 쓰다듬으려고 하자, 후와리하고 가벼운 몸놀림으로 피했다.
				PRINTFORML 「후분 나를 잡을 생각이야?」
				PRINTFORMW 「요정 같은 존재가 그렇게 쉽게 잡힐 거라고 생각하지 마아!」
			CASE 1
				PRINTFORML 「내 힘이 보고 싶어?」
				PRINTFORML 「나는 그런 값싼 요정 아니거든!」
				PRINTFORMW 「응…… 어깨를 주물러도 안 돼!」
			CASE 0
				PRINTFORML 서니와 동전 맞추기 게임을 했다.
				PRINTFORML 「어느 손에 동전이 들어있냐고? 간단해, 여기 있잖아!」
				PRINTFORMW 「어라, 틀렸잖아……」
			CASEELSE
				PRINTFORML 「어때? 지금 눈앞에 있는데 전혀 안 보이지?」
				PRINTFORMW 「히익! 어디 만지는 거야!?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
