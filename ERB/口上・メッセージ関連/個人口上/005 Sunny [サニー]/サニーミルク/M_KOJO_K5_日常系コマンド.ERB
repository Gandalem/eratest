;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K5_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K5_301
CALL M_KOJO_MESSAGE_COM_K5_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 2
				PRINTFORML 「쩝…… 응, 맛있다아!」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 우려준 거라면, 뭐든지 맛있잖아!」
			CASE 1
				PRINTFORMW 「있지, 다음에 나한테도 맛있는 차 우려내는 법 가르쳐 줘!」
			CASE 0
				PRINTFORML 「내가 타주려고 했는데~」
				PRINTFORMW 그렇게 말하면서도 서니는 차를 마셔주었다.
			CASEELSE
				PRINTFORMW 「장난을 끝내고 마시는 차는 정말 뭐라고 말해야 할지 모르겠어!」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「이번에는 달콤한 만쥬가 무섭네」
			CASE 0
				PRINTFORML 「루나는 커피파인 거지?」
				PRINTFORMW 「항상 아침에 커피를 마시는구나. 안색이 검게 될지도 모르겠네」
			CASEELSE
				PRINTFORMW 「장난 사이에 마시는 차는 최고야!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「장난 전의 차는 특별하지 않아?」
			CASE 0
				PRINTFORML 「차 같은 거 신경 써주다니……앗 뜨거!」
				PRINTFORMW 「차가 너무 뜨거워! 배려심이 없잖아!」
			CASEELSE
				PRINTFORMW 「아아~ 따뜻해진다」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
