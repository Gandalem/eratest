;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K5_303
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K5_303
CALL M_KOJO_MESSAGE_COM_K5_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0,1,2
			IF TALENT:恋慕
				PRINTFORML 「……진심이라는 걸 보여줬으면 좋겠어!」
				PRINTFORML 서니는 입술을 오 모양으로 만들며 이쪽으로 고개를 돌리고 있다.
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 서니를 껴안으며 금발을 쓰다듬어 주자, 서니의 표정이 누그러져 간다.
				PRINTFORMW 「응응, 이걸로 교훈 얻었으면 두 번 다시는 하지 말아 줘!」
			ELSEIF TALENT:思慕
				PRINTFORML 「별것 아닌 걸로 용서 못 해……!」
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 사과의 물품으로 과자 가게의 단고를 바쳤다.
				PRINTFORMW 「오물오물…… 별것 아닌 맛이 아니네…… 용서할게!」
			ELSE
				PRINTFORML 「이번만큼은 용서해 줄게……」
				PRINTFORMW 「이제 이런 거 하지 마」
			ENDIF
		CASEELSE
			IF TALENT:恋慕
				PRINTFORML 「…………………쭈웅」
				PRINTFORMW 서니는 투명해져서 등을 돌리고 있다.
			ELSEIF TALENT:思慕
				PRINTFORML 「저는 아직 화났단 말이야……」
				PRINTFORML 서니는 뺨을 부풀리며 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다.
				PRINTFORMW 「제대로 사과해주지 않으면 용서 못 할 거니까」
			ELSE
				PRINTFORML 「뭐라고ー! 할 거야아!」
				PRINTFORMW …서니는 소매를 걷어붙이고 언제라도 때려올 것만 같다.
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
