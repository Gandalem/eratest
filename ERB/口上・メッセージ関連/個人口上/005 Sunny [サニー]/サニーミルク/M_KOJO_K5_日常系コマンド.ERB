;304,仕事を手伝う
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:350(仕事内容(JOB_仕事内容.ERB参照のこと
;TCVAR:手伝えない(=2 手伝っても早くは終わらない、時間停止中不可 永琳の診察等)
;==================================================

@M_KOJO_SUCCESS_COM_K5_304
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K5_304
CALL M_KOJO_MESSAGE_COM_K5_304_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_304_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		;通常
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 서니 일행과 함께 숨바꼭질을 했다.
				PRINTFORML 「몸을 감추면 %조사처리(CALLNAME:MASTER,"와")% 함께 있어도 들키지 않아」
				PRINTFORMW 「에헤헤~ %CALLNAME:MASTER%~♪」
			CASE 0
				PRINTFORML 서니와 신혼놀이를 했다.
				PRINTFORMW 「자, 달링, 아앙%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「있잖아, 몰래 빠져나와 우리끼리 놀지 않을래?」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 서니 등과 트럼프로 바바누키를 했다.
				PRINTFORML 「저기, 남은 두 장 중에 어느 것이 유카리 씨인지 알아?」
				PRINTFORMW 「아! 저쪽을 가져가면 안 돼, 안 된다니까!」
			CASE 0
				IF CFLAG:5:現在位置 == CFLAG:13:現在位置 && CFLAG:5:現在位置 == CFLAG:14:現在位置
					PRINTFORML 서니 등과 소꿉놀이를 했다.
					PRINTFORMW 「안 돼애요, 쌀 장수님! 저한테는 %조사처리(CALLNAME:MASTER,"와")% 강아지 한 마리가 있다고요!」
					SETCOLOR COLOR("緑")
					PRINTFORMW 「오, 부인…… 저, 저는 남편보다 당신을 아, 사랑하고 있는데……」
					RESETCOLOR
					SETCOLOR COLOR("青")
					PRINTFORMW 「멍멍!」
					RESETCOLOR
				ELSE
					PRINTFORML 서니들과 소꿉놀이를 했다.
					PRINTFORMW 「%CALLNAME:MASTER%! 이제 도박은 그만해! 이건 이 아이의 키우쇼쿠히나잖아!」
				ENDIF
			CASEELSE
				PRINTFORML 서니 등과 풍요 기원 놀이를 했다.
				PRINTFORML 「카시키미~ 카시키미~」
				PRINTFORMW 「은빛 바람~ 창세의 힘~」
		ENDSELECT
	ELSE
