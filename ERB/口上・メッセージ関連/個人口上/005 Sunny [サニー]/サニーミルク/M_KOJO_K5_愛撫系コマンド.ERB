@M_KOJO_MESSAGE_COM_K5_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「흥, 그렇게 빤히 쳐다보지 마아……」
		PRINTFORML 서니는 얼굴을 새빨갛게 물들이고, 누구에게도 보여준 적 없는 은밀한 곳을 다리를 벌려 열어 보이고 있었다.
		PRINTFORML 그녀의 허벅지 사이에 얼굴을 가까이 대자 은은한 달콤한 향기가 풍기고, 부끄러움 때문인지 사타구니가 축축하게 젖어 온다.
		PRINTFORML 부드러운 살로 꽉 닫힌 음부를 상냥하게 열 듯이, %조사처리(CALLNAME:MASTER,"는")% 혀를 주름 사이로 기어들게 했다.
		PRINTFORML 「아우윽, 크, 으으으……」
		PRINTFORML 서니의 몸에 마비될 듯한 쾌락이 흐른다. 꾹꾹 자극하자 투명한 액체가 음부 깊은 곳에서 스며 나오기 시작한다.
		PRINTFORML 「응, 크, 으으으…… 이거, 굉장한 거네요…」
		PRINTFORMW 긴장감에 물들어 있던 서니의 표정은 자신의 은밀한 곳처럼 녹아내리기 시작했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「앗…… 깨끗하게 해줄 거야...? ...히아으응!」
				CASE 0
					PRINTFORML 「그렇게 많이 빨면 또 이상해지잖아…… 아앗」
				CASEELSE
					PRINTFORML 「흐윽... 응읏 다른 곳을 빨려가지 않아서, 이상한 기분이 드네」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「앗, 앗, 아아, 대단해%UNICODE(0x2665) *1%」
				PRINTFORMW 서니는 눈을 풀리게 하며 쾌락을 받아들이고 있다.
			CASE 0
				PRINTFORMW 「이런 꼴로 된 건 %조사처리(CALLNAME:MASTER,"가")% 한 거니까…… 응응읏%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「이야앗! 하아, 아아앗」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 서니의 살진 엉덩이를 들어 올리며 탐욕스럽게 와레메를 물어뜯는다.
				PRINTFORMW 「냐앗?! 아! 히아아아!!」
			CASE 0
				PRINTFORML 혀가 음육에 조여들자, 헤집어 가며 질 안을 유린했다.
				PRINTFORMW 「아앗%UNICODE(0x2665) *1% 좀 거칠다니까앗%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「있잖아, 더 빨리 해줘. 내 아랫배 깊숙한 곳까지……%UNICODE(0x2665) *1%」
				PRINTFORMW 혀로 서니의 와레메를 헤집고, 충분히 풀어진 질 내부를 주루주루 소리를 내며 빨아들인다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「히끅!?」
				PRINTFORMW 「야아, 너무 세잖아요...!」
			CASE 0
				PRINTFORML 「아우우우... 이게 뭐야...」
				PRINTFORMW 서니는 익숙지 않은 쾌락에 당황하며, %조사처리(CALLNAME:MASTER,"의")% 머리를 붙잡는다.
			CASEELSE
				PRINTFORML 「응읏…… 응읏」
				PRINTFORMW 서니는 부끄러운 듯 눈을 피하며 %조사처리(CALLNAME:MASTER,"의")% 쿠니를 받아들이고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
