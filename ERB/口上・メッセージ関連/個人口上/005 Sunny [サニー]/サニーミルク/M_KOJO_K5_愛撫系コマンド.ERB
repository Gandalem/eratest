@M_KOJO_MESSAGE_COM_K5_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「아프게 하지 마! 절대니까!」
		PRINTFORML 긴장했는지 서니의 허벅지는 떨리고, 부드러운 살갗이 땀에 젖어 있다.
		PRINTFORML 진정시키기 위해 한 손으로 허벅지 안쪽을 따라 훑고
		PRINTFORML 다른 한 손은 질에 갖다 댔다.
		PRINTFORML 「아우윽…… 응윽」
		PRINTFORML 눈을 꽉 감은 서니. 그녀의 질로 몇 번 손가락을 움직인 후, 내부 깊숙이 파고들게 했다.
		PRINTFORMW 꽉 조이는 손가락 하나하나에 외부 침입을 거부하려는 듯 질벽이 미끌거리고 꿈틀거린다….
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「앗, 아아아%UNICODE(0x2665) *1%」
				PRINTFORMW 서니의 질내를 두 손가락으로 휘저으며, 달콤한 액체를 끌어내고 있다….
			CASE 0
				PRINTFORML 「큰 거 좋아해~%UNICODE(0x2665) *1%」
				PRINTFORMW 서니의 질벽을 엄지손가락으로 세게 쓰다듬었다.
			CASEELSE
				PRINTFORML 뜨겁고 어린 질벽은 뜨거운 코타츠 속에 박혀 있는 것 같다.
				PRINTFORMW 「%CALLNAME:MASTER%니까 이렇게 달아오르는 거잖아…… %UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 엉망진창이 된 서니의 질내를 용서 없이 손가락으로 휘저었다.
				PRINTFORMW 「아앗, 야앙! 아, 아아%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORMW 「아앗, 거기... 거기, 거기 너무 좋아요읏」
			CASEELSE
				PRINTFORMW 「더, 더 깊게읏, 깊은 곳……%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응우…… 응우웅……」
				PRINTFORMW 「잠깐, 그렇게 깊이 넣으면…… 응읏!」
			CASE 0
				PRINTFORML 「앗, 안 돼…… 또…… 응우웅…」
				PRINTFORMW 서니의 약한 부분을 찾아내어, 정성스럽게 손가락을 스쳤다.
			CASEELSE
				PRINTFORML 「히으읏, 응우우……야아」
				PRINTFORMW 아직 저항이 있는 것인지, 서니의 몸은 경직되어 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
