@M_KOJO_MESSAGE_COM_K5_0
CALL M_KOJO_MESSAGE_COM_K5_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 어린 살결을 더듬으며, 촉촉한 피부를 정성스럽게 애무하기 시작했다.
		PRINTFORML 「얏... 아하하하! 간지러워 죽겠어!」
		PRINTFORML 간질거려 하는 서니를 뒤로한 채 미숙한 몸을 부드럽게 풀어간다.
		PRINTFORML 「후후, 햐하하... 하... 아, 어라? 음... %UNICODE(0x2665) *1%」
		PRINTFORML 짜릿한 쾌감이 흐르자, 웃고 있던 서니의 얼굴이 당혹감과 혼란으로 변해간다.
		PRINTFORML 「아, 어라? 간질거리는 게 아니라 왠지 기분이 좋아져서... 햐아아—!?」
		PRINTFORML 서니의 봉오리를 정성껏 따라 그리며, 꼿꼿이 선 유두를 까딱거리듯 주무른다.
		PRINTFORMW 「음... 음... %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「――――～ッッ」
					PRINTFORMW 서니의 리듬감 있는 사정의 쾌감에 몸이 움찔거리게 했다.
				CASE 0
					PRINTFORML 「앗, 배 속이 은근히 따뜻해지는 게 느껴져……%UNICODE(0x2665) *1%」
					PRINTFORMW 서니의 정액을 흘린 듯 볼록한 배를 원을 그리듯 쓰다듬었다.
				CASEELSE
					PRINTFORML 「하앗, 아앗…… 돼, 돼는 거야아」
					PRINTFORMW 사정할 때마다 서니의 작은 몸은 파르르 떨리며 경련했다.
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「응읏, 아아앗…… 야앗, 아아」
					PRINTFORMW 서니의 질내를 밀어 넣는 것에 맞춰, 손바닥으로 아랫배를 스윽 문질러 주었다.
				CASE 0
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 서니의 질내를 페니스로 꾸욱꾸욱 비비며 만지작거렸다.
					PRINTFORMW 「우, 크으윽……응읏%UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 서니의 작으면서도 둥근 엉덩이를 잡고, 부드러운 감촉을 즐기며 페니스를 밀어 넣는다.
					PRINTFORMW 「히이이익!」
			ENDSELECT
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
