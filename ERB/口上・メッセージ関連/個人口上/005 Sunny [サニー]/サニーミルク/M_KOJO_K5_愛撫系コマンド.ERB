@M_KOJO_MESSAGE_COM_K5_2
CALL M_KOJO_MESSAGE_COM_K5_2_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「이걸 입에 넣는 거야? 어, 오줌 같은 거 하지 마라!」
		PRINTFORML 서니는 움찔움찔 떨리는 성기를 잡으면서, 윤기가 흐르는 입술로 페니스를 입에 물었다.
		PRINTFORML 「음뭇응… 함뭇…」
		PRINTFORML 다 삼키지 못하는 건지 귀두만을 중심으로 입을 앞뒤로 움직이며 사정을 유도하려 한다.
		PRINTFORML 「휴우, 현햐호?… 휴뭇」
		PRINTFORMW 무언가 말하려 입을 움직일 때마다 혀끝이 안쪽 주름이나 기둥을 스치며 기분 좋은 쾌감을 가져다준다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 서니의 혀끝이 정액을 짜내듯 미끌거리며 감싸온다….
				PRINTFORMW 「후우%UNICODE(0x2665) *1%후우%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 서니는 목줄에 걸린 것처럼 입을 오므리고, 입 전체를 사용해 사정감을 부추긴다.
				PRINTFORMW 「후훗, 기분 좋은 얼굴 하고 있는 거 알잖아 %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「쥬누읏, 흣, 주르륵……」
				PRINTFORMW 서니는 혀끝으로 요도를 자극하며, 흘러넘치는 가만즙을 한 방울도 남기지 않으려 짜내듯 빨아들였다.
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「츄우우우%UNICODE(0x2665) *1%」
				PRINTFORMW 아기가 젖을 빠는 것처럼 쪽쪽거리며 남근을 빨아들이려고 한다.
			CASE 0
				PRINTFORML 「훗, 음응, 후, 음응, 후, 음응, 후우」
				PRINTFORMW 서니는 부드러운 입술로 남근을 쓸어내린다.
				PRINTFORML 격렬하게 스트로크하며 철저히 짜내는 듯이…….
			CASEELSE
				PRINTFORML 「음……윽 %UNICODE(0x2665) *1% 음후, 음ㅁㅁ %UNICODE(0x2665) *1%」
				PRINTFORMW 서니는 입안에서 페니스를 해방하고 남근을 혀만으로 정성껏 핥아 돌았다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「아—……응, 음」
				PRINTFORMW 서니는 입안을 오물거리며 남근을 빨고 있다.
			CASE 0
				PRINTFORML 「하무……, 우우웅……」
				PRINTFORMW 서툰 페라치오는 간지러움을 느끼게 하고, 옅은 쾌감을 가져다준다.
			CASEELSE
				PRINTFORML 「음후우…… 츄릅」
				PRINTFORMW 서니의 입가에서 침이 몇 방울 떨어져 그녀의 무릎을 적신다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
