				PRINTFORMW 
			CASE 0
				PRINTFORML 「배 속 깊은 곳을 자극당하는 게 너무 좋아요……%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「하앗%UNICODE(0x2665) *1%아아…%UNICODE(0x2665) *1%응힛%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「으윽, 히아……!」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「히이익!」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「하아앗, 아으…… 응흣!」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
