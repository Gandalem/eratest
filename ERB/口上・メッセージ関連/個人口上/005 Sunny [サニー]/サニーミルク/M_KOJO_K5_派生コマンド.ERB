;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K5_6
CALL M_KOJO_MESSAGE_SCOM_K5_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K5_6_1
;custom code, moved from M_KOJO_MESSAGE_COM_K5_72_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「흐윽, 아우… 야%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「아앗, 거기만 자꾸 괴롭히지 마, 바보잖아%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「안 돼, 지금 거기 문지르면…… 히유%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응윽, 으아……%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「흐, 아앗, 오오옷%UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「아앗, 거기... 거기 너무 좋아%UNICODE(0x2665) *1%」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「앗, 지금 눈앞이 새하얘져…… 으응!」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「너무 세게 하지 말라구~!」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「흐윽... 으에…」
				PRINTFORMW 
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
