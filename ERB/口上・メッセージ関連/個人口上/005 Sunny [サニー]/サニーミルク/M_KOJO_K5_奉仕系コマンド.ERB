@M_KOJO_MESSAGE_COM_K5_83_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「고쿠……」
		PRINTFORMW 서니는 솟아오른 남근을 앞에 두고 숨을 삼킨다.
		PRINTFORML 조심스럽게 맥동하는 그것에 손을 대자, 자신의 미숙한 와레메로 유도한다.
		PRINTFORML 「햐앗!?」
		PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 먼저 움직여 허리를 내밀자, 부드러운 치골 위로 미끄러져 들어가 뜨거운 욕정을 서니에게 밀어붙였다.
		PRINTFORML 아기 같은 열기와 남성기에 닿은 여성기에서 흘러나온 달콤한 체액으로 남근은 더욱 부풀어 오른다.
		PRINTFORML 「안에 넣을 수는 없는 거잖아...? 그렇다면 괜찮을까라」
		PRINTFORML 「응후우읏, 응으……」
		PRINTFORMW 밀어붙여지는 남성기에 겁먹으면서도, 서니는 천천히 몸을 움직이기 시작했다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「이렇게 하면 정말 삽입한 것 같지 않아?... 파앗%UNICODE(0x2665) *1%」
				PRINTFORMW 서니
			CASE 0
				PRINTFORML 살과 살이 철썩철썩 부딪히는 소리가 방 안에 울려 퍼진다….
				PRINTFORMW 「자, %CALLNAME:MASTER%%UNICODE(0x2665) *1%좀 더%UNICODE(0x2665) *1% 좀 더 힘내%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 서니는 남근을 와레메로 끼우고, 체중을 실어 문질러 올렸다.
				PRINTFORMW 「응... 어때? 감을 잡으면... 아앗, 기분 좋지?」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 서니는 허리를 그라인드시키며, 맛보듯이 남근을 골반 사이에 끼워 넣었다.
				PRINTFORMW 「하앗, 음으으……」
			CASE 0
				PRINTFORML 「응읏... 응후... 흐흐우우...」
				PRINTFORMW 「있잖아, 넣어주지 않을 거야?」
			CASEELSE
				PRINTFORML 「앗…… 에치…… %UNICODE(0x2665) *1%」
				PRINTFORMW 선주액과 서니의 애액이 뒤섞여, 질척거리는 소리를 야하게 내고 있다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「……앗」
				PRINTFORMW 서니의 뺨이 열을 띠고, 부끄러워하면서도 복숭아빛으로 물들어 간다.
			CASE 0
				PRINTFORML 「앗……이것도 나도 좀 기분 좋다……%UNICODE(0x2665) *1%」
				PRINTFORMW 서니는 어색하지만 허리를 움직이며 쾌락을 찾기 시작했다.
			CASEELSE
				PRINTFORML 「앗…… 으흣…」
				PRINTFORMW 남자 성기가 클리토리스를 스칠 때마다, 서니는 음란한 신음을 참아내려 하고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
