@M_KOJO_MESSAGE_COM_K5_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「이걸 입에 넣는 거야? 우웩……」
		PRINTFORML 서니는 싫어하면서도 혀로 %조사처리(CALLNAME:MASTER,"의")% 단단함을 핥기 시작한다.
		PRINTFORMW 「레로…… 치로…… 추……」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「무츄…… 하뭇…… 어때, 기분 좋아?」
				PRINTFORMW 서니는 작은 입으로 %조사처리(CALLNAME:MASTER,"의")% 페니스를 애무하고 있다.
			CASE 0
				PRINTFORML 서니는 페니스를 혀로 쓰다듬으며, 무는 듯 입으로 안쪽 주름을 자극한다….
				PRINTFORMW 「응읏… 츄… 함윽…」
			CASEELSE
				PRINTFORMW 「응음, 츄왑……」
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「앗, 이게 원했던 거야~ %UNICODE(0x2665) *1%」
				PRINTFORMW 「응츄 주붓, 주루읏%UNICODE(0x2665) *1%」
			CASE 0
				PRINTFORML 서니는 탐욕스럽게 페니스를 입으로 잡아 흔들며 쾌감을 끌어올려 간다.
				PRINTFORMW 「응읏, 으무우%UNICODE(0x2665) *1% 츄우읏%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「응, 음ㅊ읏 %UNICODE(0x2665) *1% 하아」
				PRINTFORMW 「하햣푸 %UNICODE(0x2665) *1%라히테 %UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「음……. 이렇게 하는 게 좋을까?」
				PRINTFORMW 「아무앗, 음츄」
			CASE 0
				PRINTFORML 「응읏…… 응읏……」
				PRINTFORMW 서니는 어색하게 페니스를 입에 머금고 혀끝을 움직인다.
			CASEELSE
				PRINTFORML 서니는 혀끝으로 귀두를 핥는다.
				PRINTFORMW 「아직 안 끝난 거야? 빨리 해줘~」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
