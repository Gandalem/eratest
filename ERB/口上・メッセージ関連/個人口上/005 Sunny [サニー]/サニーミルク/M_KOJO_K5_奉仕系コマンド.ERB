@M_KOJO_MESSAGE_COM_K5_80
CALL M_KOJO_MESSAGE_COM_K5_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K5_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「이거 가지고 움직이면 되는 거야?」
		PRINTFORML 「자, 자」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「아, 점점 커지고 있어」
				PRINTFORMW 「내 손이 기분 좋은가 봐……」
			CASE 0
				PRINTFORML 「나 같은 경우는 양손으로 안 하면 참지 못할지도 몰라」
				PRINTFORMW 「응읏, 응읏」
			CASEELSE
				PRINTFORML 「자, 자, 어서 사정해 버려」
				PRINTFORMW 서니는 일부러 손의 긴장을 풀며 %조사처리(CALLNAME:MASTER,"의")% 페니스를 가지고 논다.
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「야, 빨리 크게 해줘…… %UNICODE(0x2665) *1%」
				PRINTFORMW 
			CASE 0
				PRINTFORML 서니는 %조사처리(CALLNAME:MASTER,"의")% 단단한 성기를 주무르며 혀로 핥고 있다.
				PRINTFORMW 「빨리 이것을 내 안에……%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「이제 됐잖아, 빨리... 빨리하자%UNICODE(0x2665) *1%」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「생(콘돔없이) 따뜻하고 이상한 느낌이네」
			CASE 0
				PRINTFORMW 「앗, 파르르 떨었잖아!」 
			CASEELSE
				PRINTFORMW 「음~, 아직 안 돼?」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
