@M_KOJO_MESSAGE_COM_K5_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;サニーが貧乳
	IF TALENT:5:105 < 0
		IF LOCAL:1 && FIRSTTIME(SELECTCOM)
			PRINTFORML 「이걸로 기분이 좋아지는 거야?…정말로?」%조사처리(CALLNAME:MASTER,"는")% 매끄러운 부드러운 살에 페니스를 비볐다.
			PRINTFORML 「…응」
			PRINTFORMW 촉촉한 피부에 가끔 유두를 비빌 때마다 서니의 입에서 작게 신음소리가 흘러나왔다.
			RETURN 1
		ENDIF
		;基本セット
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「나도 이렇게 하면…… 요트」
					PRINTFORMW 서니는 작은 가슴 주변의 살을 모아 페니스를 끼워 넣었다.
				CASE 0
					PRINTFORML 「이렇게 하면 기분이 좋아지려나?」
					PRINTFORMW 서니가 작은 유두를 모아 귀두를 자극한다...
				CASEELSE
					PRINTFORML 「자, 나도 움직이는 편이 더 기분 좋지?」
					PRINTFORMW 서니는 적극적으로 몸을 페니스에 비볐다.
			ENDSELECT
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「레로오……」
					PRINTFORMW 서니는 입가에서 침을 흘려, 앞뒤로 움직이는 귀두에 떨어뜨린다.
					PRINTFORML 미끈거리는 감촉으로 윤활함이 생겨나, 페니스에 더욱 큰 쾌감을 선사한다.
				CASE 0
					PRINTFORMW 「후훗, %CALLNAME:MASTER%냄새에 숨이 넘어갈 것 같아…%UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 「빨리, 빨리… %UNICODE(0x2665) *1%」
					PRINTFORMW 서니는 비비대는 페니스를 바라보며 뺨을 홍조지게 물들이고 있다. 이미 기다리기 힘들어 보인다.
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「아, 끝 부분이 젖어 올라오고 있어……」
				CASE 0
					PRINTFORML 「응읏……」
					PRINTFORMW 아래에서 오르내리는 %조사처리(CALLNAME:MASTER,"의")% 페니스로부터 서니는 무의식적으로 시선을 돌린다.
				CASEELSE
					PRINTFORML 「우와, 뭔가 커져왔다」
					PRINTFORMW 서니는 비빌 때마다 단단해지는 그것을 응시하고 있다.
			ENDSELECT
			RETURN 1
		ENDIF
		;サニーが普乳以上
	ELSE
		IF LOCAL:1 && FIRSTTIME(SELECTCOM)
			PRINTFORML 서니는 작은 몸에 어울리지 않는 가슴을 흔들어 보인다.
			PRINTFORML 「에헤헤~ 실은 가슴에는 자신이 있거든」
			PRINTFORML 「요정 중에서 가슴 큰 애는 드문 법이잖아」
			PRINTFORMW 「이렇게 끼워서, 응윽… 응윽」
			PRINTFORML 서니의 요정답지 않은 가슴 안에 끼여 따뜻하고 촉촉한 감촉이 페니스를 감싼다.
			PRINTFORMW 「이걸로 움직이는 거야? 후우응... 훗」
			RETURN 1
		ENDIF
		;基本セット
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 서니는 크게 빠르고 위아래로 움직이며 %CALLNAME:MASTER%에게서 정액을 짜내려고 한다.
					PRINTFORMW 「아직 버틸 수 있어? 더 세게 해줄 거야!」
				CASE 0
					PRINTFORML 서니는 양손으로 가슴을 감싸 안고 격렬하게 페니스를 주무르며 짜 올린다.
					PRINTFORMW 「%CALLNAME:MASTER%, 정말 기분이 좋아 보이는 표정을 짓고 있잖아」
				CASEELSE
					PRINTFORML 서니가 어깨로 가슴을 기대자 페니스는 풍만한 유방에 눌리며 형언할 수 없는 쾌감에 압박당한다.
					PRINTFORMW 「자, 자, 어서 사정해 버려라%UNICODE(0x2665) *1%」
			ENDSELECT
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「어때? %조사처리(CALLNAME:MASTER,"가")% 이렇게 야한 아가씨로 만든 거니까♪」
				CASE 0
					PRINTFORML 서니는 가슴을 크게 움직이며 강약을 조절해 페니스 깊숙이 박아 넣는다.
					PRINTFORMW 「벌써 %CALLNAME:MASTER%냄새에 현기증 날 것 같아……%UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 서니의 풍만한 가슴에 파묻힌 음경은 기분 좋은 듯 맥동하고 있다.
					PRINTFORMW 「우후후, 좀 더 힘내%UNICODE(0x2665) *1%힘내%UNICODE(0x2665) *1%」
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「아, 빠져버렸어……. 응슉」
					PRINTFORMW 「상당히 어려운 거네」
				CASE 0
					PRINTFORMW 「후후-, 내 가슴 기분 좋지?」
				CASEELSE
					PRINTFORML 「아, 가슴 속에서 커지는 것이 느껴져」
					PRINTFORMW 「엣! 에이읏!」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
