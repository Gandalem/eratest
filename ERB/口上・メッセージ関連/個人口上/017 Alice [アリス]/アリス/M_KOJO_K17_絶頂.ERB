; Modular ERB: 個人口上/017 Alice [アリス]/アリス/M_KOJO_K17_絶頂.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K17
#DIM DYNAMIC iType = 0
#DIM DYNAMIC iSub_TARGET = 0
#DIM DYNAMIC iABLnum,2 = -1,-1
#DIM DYNAMIC iCount = 0
VARSET LOCALS
SIF FLAG:時間停止
	RETURN 1
;喘ぎタイプの決定
iType = CFLAG:K17C_ID:K17C_CF_喘ぎタイプ
;強制変換
;怒りつく すでに無理矢理
SIF K17_CHECK_ANGER_COM(TARGET) || TCVAR:無理矢理
	iType = K17C_受け_無理矢理系
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;絶頂部位選出
	FOR i,4,-1,-1
	IF NOWEX:i
		iABLnum:iCount = i
		iCount++
	ENDIF
	SIF iCount >= 2
		BREAK
	NEXT
	;他TARGETを取得
	iSub_TARGET = K17_GET_TARGETS_ID()
	IF iSub_TARGET
		IF CFLAG:うふふ
			LOCALS += @"%K17_CNAME(iSub_TARGET)%이 지켜보고 있음에도 불구하고 "
		ELSEIF K17_GET_FRIENDS(iSub_TARGET)
			;友人
			LOCALS += @"비록 %K17_CNAME(iSub_TARGET)%이 알게 될 것이지만 "
		ELSE
			LOCALS += @"누군가 알아낼 것이라고 해도 "
		ENDIF
	ENDIF
	;挿入系
	IF (NOWEX:Ｖ絶頂 && TEQUIP:Ｖセックス != -1) || (NOWEX:Ａ絶頂 && TEQUIP:Ａセックス != -1)
		IF NOWEX:PLAYER:射精
			IF iType & K17C_喘ぎF_襲い && !(iType & K17C_喘ぎF_攻め)
				PRINTFORML 「%K17_RS("No/Stop")%%K17_喘ぎ_繋ぎ(iType,ABL:K17C_部位V)%... 안에 싸지 마, %K17_RS("pull out/not inside")% %K17_喘ぎ声(iType,ABL:Ｖ感覚,-1,1)%」
			ELSE
				PRINTFORML 「%K17_RS("It's okay/Cum")%%K17_喘ぎ_繋ぎ(iType,ABL:K17C_部位V)%... 함께, 괜찮아...? %K17_喘ぎ声(iType,ABL:Ｖ感覚,-1,1)%」
			ENDIF
		ENDIF
		;挿入部位と絶頂の合致
		LOCALS += @"%K17_CNAME()%'의 %K17_CALL_G(TEQUIP:Ｖセックス!=-1 ? TEQUIP:Ｖセックス#TEQUIP:Ａセックス,0,1)%, "
	ENDIF
	;	;舐められ系
	;	ELSEIF (SELECTCOM == 1 && (NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂)) || (SELECTCOM == 11 || NOWEX:Ｂ絶頂)
	;		LOCALS += @"%K17_CNAME()%にぺろぺろされて、\n　"
	;
	;	;その他
	;	ELSEIF NOWEX:Ｖ絶頂  ||  TEQUIP:Ａセックス
	;		;LOCALS += @"\n　%K17_CNAME()%の%K17_RS("手/指")%で、"
	;	ENDIF
	;
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:五重絶頂
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:四重絶頂
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:三重絶頂
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		LOCALS += @"「\@ LOCALS == "" ? 나의 # 내 \@」 "+K17_CALL_P(iABLnum:1)+" and "
	ENDIF
	;どこも絶頂してなければ戻し
	SIF !iCount
		RETURN 1
	;どこか絶頂してたらテキスト
	IF NOWEX:Ｍ絶頂 || (!CFLAG:うふふ && iSub_TARGET) || DATE_HITOGOMI(CFLAG:PLAYER:現在位置) || (FLAG:異常気象 == 6 && !CFLAG:うふふ)
		PRINTFORML （%K17_喘ぎ_絶頂(iType,iABLnum:0,LOCALS)%）
	ELSE
		PRINTFORML 「%K17_喘ぎ_絶頂(iType,iABLnum:0,LOCALS)%」
	ENDIF
	;うふふ以外など
	IF FLAG:異常気象 == 6 && !CFLAG:うふふ
		;スカートめくりイき
		IF SELECTCOM == 330 && TFLAG:現在のTARGET == TARGET
			PRINTL
			PRINTFORML (뭐지?! 왜?! 치마를 뒤집어쓰기만 해도... 흐윽)
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 자신의 사타구니를 움켜쥐고 바닥으로 쓰러지며, 몸이 떨리고 경련을 일으킨다.
		ENDIF
		;疑いあり　誤解だけどｗ
		IF CFLAG:K17C_ID:K17C_CF_疑い
			CFLAG:K17C_ID:K17C_CF_疑い = MIN(CFLAG:K17C_ID:K17C_CF_疑い +5,100)
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신을 날카로운 눈으로 노려본다... 그녀의 당신에 대한 불신이 깊어진 것 같다.
		ENDIF
	ELSEIF !CFLAG:うふふ
		;日常
		PRINTL
		PRINTFORML 「너무 심했어... %K17_RS("Dummy/Pervert")%.」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 섹스가 아닌 곳에서 오르가즘에 도달한 것에 항의하며 볼을 부풀린다.
		PRINTFORMDL 당신에게서 등을 돌린 그녀는 옷을 다시 정리하기 시작한다.
	ENDIF
	PRINTW
ENDIF
