IF K17_GET_CLOTHNAME_BOTTOM_UNDER(TARGET) != ""
	;下着あり
	cB_Action:1 = 그녀의 %K17_GET_CLOTHNAME_BOTTOM_UNDER(TARGET)%을 통해 %FSYN("vagina")%로 %cWet%
ELSE
	cB_Action:1 = 노출된, %cWet% %FSYN("labia")%
ENDIF
;-------------------------------------------------
;感覚判定　アクション
;-------------------------------------------------
IF TALENT:処女 == 1
	cAction = 조심스럽게 손가락을 ~에 넣는다
ELSE
	;感覚判定
	IF ABL:Ｖ感覚 < 1
		cAction = 천천히 손가락을 ~에 삽입한다.
	ELSEIF ABL:Ｖ感覚 <= 2
		cAction = 손가락을 집어넣고 천천히 안에서 꿈틀거린다.
	ELSE
		;5から
		cAction = 손가락을 넣고 %K17_RS("churn up/vigorously wriggle it inside/begin probing inside")%
	ENDIF
ENDIF
;-------------------------------------------------
;感覚判定　リアクション
;-------------------------------------------------
IF TALENT:処女
	cReAction = %CALLNAME:TARGET%굳어지더니 불편한 표정으로 당신에게 돌아온다...
ELSE
	;感覚判定実数値
	IF ABL:Ｖ感覚 < 1
		cReAction = %조사처리(CALLNAME:TARGET,"의")% 몸이 이물질의 삽입으로 굳는다.
	ELSEIF ABL:Ｖ感覚 <= 4
		cReAction = 너는 %조사처리(CALLNAME:TARGET,"의")% 몸을 어루만지자 뜨겁고 김 서린 신음을 내뱉는다.
	ELSE
		;5から
		cReAction = %조사처리(CALLNAME:TARGET,"는")% 더 많은 쾌감을 찾으며 입을 벌린 채 노골적으로 침을 흘리며 골반을 밀어 넣는다.
	ENDIF
ENDIF
