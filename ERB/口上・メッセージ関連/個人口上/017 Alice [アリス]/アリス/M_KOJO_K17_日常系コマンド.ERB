;*********************************************************
;お風呂スキンシップ　別にした
;
;お風呂に一緒に入れるのはRTの恋慕↑
;一応汚れ取りあるけど、くつろいだほうが早い
;洗う系は便利すぎたので3時間間隔でいいかな（お風呂が6時間
;洗えてなくてもスキンシップはできるってことで
;経験数も試しに足してみた
;1時間周期でB経験+1とかで3時間ごとに綺麗になるってだけのかんじ
;
;	引数1	：GRT_EXの値
;*********************************************************

@M_KOJO_MESSAGE_COM_K17_302_1_選択肢_お風呂(ARG)
#DIM iExFlag,2		;拡張選択肢フラグ
#DIMS cEx,2			;拡張選択肢文字列
#DIM iRand			;ランダム値の入れ物
VARSET iExFlag
VARSET cEx
VARSET iRand
IF ARG >= K17C_恋慕生解禁
	cEx:0 = Have her wash your front too
	cEx:1 = Wash her front too
ENDIF
SIF !FIRSTTIME(@"風呂スキンシップ1",1)
	iExFlag:0 = 1
SIF !FIRSTTIME(@"風呂スキンシップクリア2",1)
	iExFlag:1 = 1
IF TCVAR:K17C_ID:K17C_TC_スキンシップ == 0
	CALL K17_ASK_M( "그녀에게 물을 끼얹는다",1, "그녀에게 당신의 등을 씻게 하라",1, "그녀의 등을 씻긴다",!FLAG:甲斐性無, "그녀에게 네 머리를 감게 해라",1, cEx:0,iExFlag:0, cEx:1,iExFlag:1 && !FLAG:甲斐性無, "무작위로 선택한다.",1, "무작위로 선택한다 (하루 종일)",1 )
ENDIF
;ランダム時
IF RESULT == 6 || RESULT == 7 || TCVAR:K17C_ID:K17C_TC_スキンシップ
	SIF RESULT == 7
		TCVAR:K17C_ID:K17C_TC_スキンシップ = 1
	;選択雑ぅ（恐れ
	WHILE 1
	RESULT=RAND:5
	SELECTCASE RESULT
		CASE 0,1,3
			BREAK
		CASE 2
			SIF !FLAG:甲斐性無
				BREAK
		CASE 4
			SIF ARG >= K17C_恋慕生解禁 && iExFlag:0
				BREAK
		CASE 5
			SIF ARG >= K17C_恋慕生解禁 && iExFlag:1 && !FLAG:甲斐性無,
				BREAK
	ENDSELECT
	WEND
ENDIF
SELECTCASE RESULT
	;---------------------------
	;パチャパチャする
	;---------------------------
	CASE 0
		PRINTFORMDL 두 분은 물을 서로에게 뿌리며 즐거운 시간을 보낸다.
		PRINTW
		;同性として入ってる場合
		IF !GETBIT(TALENT:MASTER:2,1) && HETEROSEX(MASTER,TARGET) && !TALENT:TARGET:恋慕
			PRINTFORML 「캬아, 오, 이제 해버렸네, 이거 받아둬~」
			RETURN 1
		ENDIF
		;初回
		IF FIRSTTIME(@"風呂スキンシップ0")
			PRINTFORML 「꺄아, 이리 와, 애처럼 굴지 마...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 같이 놀아주지 않자 조금 토라지고, 그녀에게 목욕물을 잔뜩 뿌린다.
			PRINTFORML 「이리와, 진정해, 목욕탕에서 장난치지 마... 자, 이거 봐ー!」
			PRINTFORML 「아하하, 방심한 대가를 치르는 거지~ 정말 한심하다~」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "야, 양동이 쓰는 건 반칙이야!"
			ELSE
				PRINTFORMDL 당신은 양동이를 사용하는 것이 반칙이라고 항의한다.
			ENDIF
			CALL HPH_PRINT,"「흠흠, 사랑과 전쟁 모두 공평하지. 브이비. 이봐, 그만둬, 내가 말하는 동안은 안 돼!」", "L"
			PRINTFORMDL 두 사람은 한동안 목욕하면서 노는 것을 즐긴다.
			PRINTW
			PRINTFORML 「이렇게 목욕하면서 장난치는 게 생각보다 더 재미있구나.」
			;custom code
