RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り状態
	IF CFLAG:TARGET:ブチギレ == 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;初めて
	;選んだ瞬間にFIRSTTIME記録されるので怒り状態で初回されるとスキップされる
	;自前で用意してもいいけど、仕様ってことでひとつ……
	;必要な場合口上つけて保存してみるテスト
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上")
		PRINTFORML 「오, 차를 내려주었네.」
		PRINTFORML 「귀찮게 해드려서 미안하군요. 제가 직접 우려야 했는데.」
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 다른 걸 해줄 게 별로 없으니 자신이 그것을 하게 내버려 두는 편이 좋겠다고 말한다.
		PRINTFORML 「음ー. 그럼 그 제안을 받아들이도록 하지.」
		PRINTFORML 「하지만 저는 차에 대해 상당히 까다롭다는 점을 미리 경고해두죠.」
		PRINTFORMDL 앞으로는 최선을 다하는 게 좋을 거다.
		PRINTW
	ENDIF
	;仕事中
	IF CFLAG:TARGET:行動 == 5
		PRINTDATAL
			DATAFORM 「잠깐 쉬려고 했어.」
			DATAFORM 「딱 잘됐네.」
			DATAFORM 「오, 정말 반가운 놀라움이네.」
		ENDDATA
	ENDIF
	;成功判定
	IF TFLAG:193 == 1
		PRINTFORML 「당신의 차는 특히 %K17_RS("잘 만들어졌다/황홀하다/향이 좋다")%. 아마 그 연습이 보상받고 있는 것 같군.」
		PRINTFORMDL 통과 점수를 받은 것 같네.
		;失敗
	ELSEIF TFLAG:193 == -1
		SELECTCASE K17_GRT(TARGET)
			CASE IS >= K17C_恋慕
				PRINTFORML 「...Nn...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 잠시 얼굴을 찡그리지만, 아무 말 없이 차를 계속 마신다.
			CASE IS >= K17C_思慕
				PRINTFORML 「...음~? 이거 별로네.」
			CASE K17C_知り合い
				PRINTFORML 「...방금, 이걸 뭘 넣은 거야...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 차에 뭔가를 타서 이상해 보인다.
		ENDSELECT
		PRINTFORMDL 네가 실수한 것 같군. 다음엔 더 잘하겠다고 다짐한다.
	ENDIF
	;感想
	SELECTCASE K17_GRT_EX(TARGET)
		CASE IS >= K17C_恋慕
			PRINTFORML 「나에게는 이것이 「%K17_RS("일상/습관/평범한 삶/본능")%」처럼 되어버렸어...」
			PRINTFORML 「언제나 고마워, %K17_CNAME(MASTER,1)%씨.」
		CASE IS >= K17C_思慕
			PRINTFORML 「언제나처럼 고마워요, %K17_CNAME(MASTER,1)%.」
		CASE IS >= K17C_知り合い
			PRINTFORML 「우리가 이 루틴을 얼마나 더 계속할 수 있을지 궁금하네, 후후.」
	ENDSELECT
ENDIF
RETURN 1
