	CALL K17_SET_AUTO_PVOICE(iRT,K17C_部位B,K17C_受け_無理矢理系)
	cAction:1 = %조사처리(CALLNAME:TARGET,"의")% 저항에 흥분하여,
	;服装チェック
	;上半身上着
	SIF TEQUIP:上半身着衣状況
