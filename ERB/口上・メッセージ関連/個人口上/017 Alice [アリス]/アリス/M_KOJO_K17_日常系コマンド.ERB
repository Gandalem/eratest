	;通常処理
	PRINTFORML 「%K17_AP_NUM(2)%... 이, 너무 %K17_RS("forceful/rough")%해, %K17_RS("no/stop/I don't want to")% %K17_AP_NUM(2,1)%」
	PRINTFORMDL %cAction:1%
