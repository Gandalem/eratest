@M_KOJO_MESSAGE_COM_K17_614_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;614,食材の買い出し
;買わなかった（口上呼ばれなかった
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193 == -1

	SELECTCASE K17_MAX_LIMIT_RAND(K17_GRT_EX(TARGET),K17C_恋慕,K17C_恋人)
		CASE IS >= K17C_恋人
			PRINTFORMDL You hear someone asking in a teasing voice when the two of you are going to get married, already.
			PRINTFORMDL Feeling awkward, you leave without buying anything...
		CASE IS >= K17C_恋慕
			PRINTFORML 「...Hmm? You're not buying anything?」
			PRINTW
			PRINTFORML 「...?!」
			PRINTFORML （Ah, is %HE_SHE(MASTER)% being considerate of me by not creating any bags we need to hold...?）
			PRINTFORMDL %CALLNAME:TARGET% suddenly looks away with a blush, tightly holding your %K17_RS("arm/hand")%.
		CASEELSE
			PRINTFORMDL %CALLNAME:TARGET% seems to be %K17_RS("discussing something/chatting")% with %K17_RS("a female salesclerk/an elderly staff member/the owner")%.
			IF TALENT:MASTER:性別 == 2 && RAND:2
				PRINTFORMDL You hear something like "the quickest way to a %PRINT_MALE("man", MASTER)%'s heart is through %HIS_HER(MASTER)% stomach"...
			ELSE
				PRINTFORMDL You hear that a local woman recently got married, and other such gossip...
			ENDIF
			PRINTFORMDL This might take a while...
			PRINTFORMDL ...
			PRINTFORMDL ......
			PRINTFORMDL .........
			PRINTW
			PRINTFORML 「...Hmm? You're not buying anything?」
			PRINTFORMDL You ended up forgetting to do what you came here for!
	ENDSELECT
	
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;614,食材の買い出し
;買った（成功
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE K17_MAX_LIMIT_RAND(K17_GRT_EX(TARGET),K17C_恋慕,K17C_恋人)
		CASE IS >= K17C_恋人
			PRINTFORML 「What have we been eating lately... Hmmー...」
			PRINTFORMDL As you casually chat, %K17_RS("a female salesclerk/an elderly staff member/the owner")% teases you about looking like a married couple...
			PRINTW
			PRINTFORML 「Going shopping together like this is rather nice...」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "I hope it wasn't too bothersome."
			ELSE
				PRINTFORMDL You tell her you hope it wasn't too bothersome.
			ENDIF
			CALL HPH_PRINT,"「Come on, I just said I'm happy doing thisBPB」", "L"
			PRINTFORMDL Maybe she's right, you think to yourself.
		CASE IS >= K17C_恋慕
			PRINTFORML 「What should we make... %K17_CNAME()%, what do you think? I'll make something you like.」
			PRINTFORML 「Ahー, and don't you dare say "anything's fine".」
			PRINTFORMDL She read you like a book... You really are fine with anything if %CALLNAME:TARGET% is making it for you...
			PRINTFORML 「Fufu, thinking about things like this together is nice, isn't it?」
		CASEELSE
			PRINTFORML 「I guess you really are cooking decent meals for yourself... I'm a little relieved.」
			PRINTFORMDL She's treating you like a child...
	ENDSELECT
ENDIF
RETURN 1
