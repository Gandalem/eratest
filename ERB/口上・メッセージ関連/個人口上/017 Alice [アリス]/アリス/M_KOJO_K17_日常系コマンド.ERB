	PRINTFORML 「%K17_AP_NUM(2)%%cALICE%%K17_AP_NUM(3,1)%」
	;濡れ具合見るぐっしょりから 非処女　屋内　限定
	IF PALAM:潤滑 > PALAMLV:4 && !TALENT:処女 && INROOM(CFLAG:現在位置)
