;追加条件式
;-------------------------------------------------
iExFlag = 0
;Ｃ感覚5以上＆思慕逢引以上
SIF ABL:Ｖ感覚 >= 5 && iRT >= K17C_思慕逢引 && BASE:ムード >= 500 && !iMOB
	iExFlag = 1
;5未満なら　愛でカバー
SIF iRT >= K17C_恋慕 && BASE:ムード >= 500 && !iMOB
	iExFlag = 2
;-------------------------------------------------
;服装判定
;-------------------------------------------------
;濡れ具合の描写
IF PALAM:潤滑 > PALAMLV:4
	cWet += "완전히 흠뻑 젖었다."
ELSEIF PALAM:潤滑 > PALAMLV:2
	cWet += "축축한"
ENDIF
IF TEQUIP:下半身着衣状況 & 1
	;スカートあり
	cB_Action:0 += @"그녀의 %K17_GET_CLOTHNAME_BOTTOM(TARGET)%을 말아 올린다 그리고 "
ENDIF
