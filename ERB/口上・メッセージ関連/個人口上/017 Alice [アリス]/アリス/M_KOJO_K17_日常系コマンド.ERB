@M_KOJO_MESSAGE_COM_K17_617_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;617,甘味処に誘う
;初回
LOCAL = 1
;-------------------------------------------------
IF LOCAL && FIRSTTIME(@"{SELECTCOM}口上")
	PRINTFORML 「Are we going in?」
	;custom code
	IF CFLAG:K17C_ID:1092
		PRINTFORMDL "Are you not interested in a Japanese-style sweets shop...?"
	ELSE
		PRINTFORMDL You wonder if she's not interested in a Japanese-style sweets shop...
	ENDIF
	PRINTFORML 「That's not it at all. I've had my eye on this shop but didn't want to go in alone, so this is my first time actually entering.」
	PRINTFORML 「I'm rather excited, I'm sure it'll be fun.」
	PRINTFORMDL ...
	PRINTFORMDL ......
	PRINTFORMDL .........
	PRINTW
	PRINTFORML 「The bitter taste of tea really pairs well with sweets... Japanese sweets are good too.」
	PRINTFORMDL It seems the store was to %CALLNAME:TARGET%'s liking.
	PRINTFORML 「Thanks, %K17_CNAME()%... I'd love to come here again sometime.」
	RETURN 1
