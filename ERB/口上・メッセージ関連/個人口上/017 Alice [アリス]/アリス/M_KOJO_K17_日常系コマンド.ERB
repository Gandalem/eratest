RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_604_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && FLAG:デート相手 == K17C_ID
	SIF FLAG:時間停止 || CFLAG:睡眠 || !CFLAG:同行 ;custom code
		RETURN 0
		
	;移動先の名称を取得
	LOCALS = %DATENAME_SPOT()%
	
	;二人の移動方式を選択
	IF !FIRSTTIME(@"311デート移動",1)
		;腕抱き経験済み
		PRINTFORMDL %CALLNAME:TARGET% presses her %K17_RS("breasts/chest")% against your arm and walks with you to %LOCALS%.
	ELSEIF !FIRSTTIME(603,1) || !FIRSTTIME(@"スキンシップ0",1)
		;手を繋ぐ経験済み
		PRINTFORMDL You take %CALLNAME:TARGET%'s hand and walk side-by-side to %LOCALS%.
	ELSE
		;まだやってない
		PRINTFORMDL The two of you walk to %LOCALS% together.
	ENDIF
	
	;移動先がもう入ってるはず
	SELECTCASE CFLAG:MASTER:現在位置
		CASE 連れ込み宿, ラブホ ;custom code
			IF CFLAG:既成事実 & 合意_うふふ
				CALL HPH_PRINT,@"「...So %K17_RS("you want to...do it?/we're going to...do it...")%BPB」", "L"
			ELSE
				PRINTFORML （I ended up...coming here with %HIM_HER(MASTER,,1)%... That means, we're going to...）
				CALL HPH_PRINT,"「...BPB」", "L"
			ENDIF
			PRINTFORMDL %CALLNAME:TARGET% lowers her gaze with a fierce blush.
			
		CASE 大図書館
			PRINTFORML 「Were you thinking of doing some %K17_RS("studying/reading")%? I come here often, myself.」
		;その他
		CASEELSE
			IF K17_PERCENT(40)
				SELECTCASE K17_GRT_EX()
					CASE IS >= K17C_思慕
						PRINTFORML 「%K17_RS("Oho～/Hmm? Oh/Oh")%, %K17_RS("that/this")% way, is it...」
					CASEELSE
						PRINTFORML 「Nn... %K17_RS("That/This")% way, is it...」
				ENDSELECT
			ENDIF
	ENDSELECT
	
	PRINTW
ENDIF
RETURN 1
