	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(TARGET),-1,K17C_受け_お手伝い系)
	TCVAR:K17C_ID:K17C_TC_うふふ主導権 = -1
	TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:TARGET:溜まってる度
	PRINTFORML 「여기서 그걸 하고 싶다고...? 너 정말 %K17_RS("변태/이상한 애")%구나...」
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 주변을 조심스럽게 살피다가 초조하게 당신에게 몸을 %K17_RS("giving/yielding")%.
	PRINTW
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;350,押し倒す
;成功　友人部屋（初期位置）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:194 == 0 && iFriends_Room
	CALL HPH_PRINT,@"「너는 여기서 그런 걸 하고 싶어? %K17_RS("Ahn/Yahn/Hyahn")%HPH %K17_RS("No/We can't")%...」", "L"
	PRINTFORML 「잠깐, 이러지 말자... 내 방에서 하면 안 될까? 제발?」
	PRINTFORML (이프렌즈룸(%K17_CNAME(iFriends_Room)%)이 분명 알아버릴 거야...)
	PRINTW
	;-----------
	;開始時の主導権
	;溜まってる度の一時保存
	;-----------
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(TARGET),-1,K17C_受け_合意襲い系)
	TCVAR:K17C_ID:K17C_TC_うふふ主導権 = -1
	TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:TARGET:溜まってる度
	PRINTFORMDL 비록 %조사처리(CALLNAME:TARGET,"가")% 약하게 항의하지만, 당신은 그녀를 밀어눕힌다.
	PRINTFORML 「%K17_RS("Ahn/Yahn/Hyahn")%, 너는 변태야...」
	PRINTW
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;350,押し倒す
;成功　汎用
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:194 == 0
	;-----------
	;開始時の主導権
	;溜まってる度の一時保存
	;-----------
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(TARGET),-1,K17C_受け_おねだり系)
	TCVAR:K17C_ID:K17C_TC_うふふ主導権 = -1
	TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:TARGET:溜まってる度
	;機嫌悪くても押したせたので無理矢理に
	IF TALENT:機嫌 == -1
		CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(TARGET),-1,K17C_受け_無理矢理系)
		PRINTFORML 「미안해, 기분 안 좋아서~ 히야!」
		PRINTFORMDL 그녀의 토라짐을 무시하고, 당신은 %조사처리(CALLNAME:TARGET,"를")% 밀어붙인다.
		PRINTW
		RETURN 1
	ENDIF
	;二回目以降　通常処理
	SELECTCASE K17_GRT_EX()
		CASE IS >= K17C_恋人
			;喘ぎ選択つくる
			CALL K17_押し倒し喘ぎタイプ選択
			SIF RESULT
				RETURN 1
			CALL HPH_PRINT,"「할래? 나는 괜찮아...HPH」", "L"
			PRINTFORML 「%K17_RS("오늘도 나에게 많은 사랑을 해줘 / 나에게 많은 사랑을 줘 / 나를 기분 좋게 만들어줘")%」, %K17_CNAME(MASTER,1)%...
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 욕망으로 가득 찬 눈과 그녀의 %K17_RS("욕망으로 풀린 얼굴/흥분으로 상기된 뺨/기대감으로 뜨거운 시선/갈망으로 뜨거운 숨")%로 당신에게 몸을 맡긴다.
		CASE IS >= K17C_恋慕
			PRINTFORML 「우리가... 또 하는 거야...?」
			PRINTFORML 「%K17_RS("나에게 많은 사랑을 베풀어줘/많은 사랑을 줘/기분 좋게 해줘")% 오늘도, %K17_CNAME(MASTER,1)%...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신에게 자신의 몸을 내어주고, 그녀의 눈은 갈망으로 가득 차 있으며, 그녀의 %K17_RS("욕망으로 풀린 얼굴/흥분으로 상기된 뺨/기대감으로 달아오른 시선/욕망으로 뜨거운 숨")%를 보여준다.
		CASE IS >= K17C_思慕
			PRINTFORML 「다시... 하고 싶어...?」
			PRINTFORML 「%K17_RS("오-좋아/...좋아")%... 당신과 함께라면...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 떨리는 듯 고개를 끄덕이며 몸을 당신에게 맡긴다, %K17_RS("긴장으로 뻣뻣하게/당신의 손길에 몸이 움찔하며/살짝 떨면서")%.
			CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(TARGET),-1,K17C_受け_お手伝い系)
		CASEELSE
			PRINTFORML 「너는 정말 %K17_RS("그런 야만인/그런 변태/항상 이런 것만 생각하는")%구나...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 초조하게 몸을 뒤척이며 항의했다.
			CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(TARGET),-1,K17C_受け_お手伝い系)
	ENDSELECT
	PRINTW
ENDIF
RETURN 1
;====================================================================================================
;351,連れ出す
;====================================================================================================

@M_KOJO_MESSAGE_COM_K17_351
;連れ出しにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K17_351_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_351_1
#DIM iFriends = 0
#DIM iMOB = 0
#DIMS cMove
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:時間停止
	PRINTL
	;泥酔
	IF TCVAR:(TARGET:LOCAL):泥酔
		PRINTFORML 「후우~... 어디로 가는 거야~ 에헤헤...」
		PRINTW
		RETURN 1
	ENDIF
	;友達優先で同行している人を探す
	iFriends = 0
	iMOB = 0
	;MASTERに同行がついてる場合　誰かを探す
	IF CFLAG:MASTER:同行
		;友達を見る
		FOR i,0,K17C_友人人数
		IF CFLAG:(K17C_友人ID:i):同行
			iFriends = K17C_友人ID:i
			BREAK
		ENDIF
		NEXT
		;普通に見る
		IF !iFriends
			FOR i,1,CHARANUM
			IF (CFLAG:(TARGET:i):同行) && TARGET:i != K17C_ID
				iMOB = TARGET:i
				BREAK
			ENDIF
			NEXT
		ENDIF
	ENDIF
	;二人の移動方式を選択
	VARSET cMove
	IF ( !FIRSTTIME(@"311デート移動",1) && K17_LUCKY_SUKEBE(30) ) && (!iFriends && !iMOB)
		;腕抱き経験済み
		cMove = %조사처리(CALLNAME:TARGET,"는")% 아무렇지도 않게 그녀의 팔을 네 팔에 걸었고, 그녀의 %K17_RS("breasts/chest")%는 너에게 밀착한다.
	ELSEIF ( !FIRSTTIME(603,1) || !FIRSTTIME(@"スキンシップ0",1) ) && (!iFriends && !iMOB)
		;手を繋ぐ経験済み
		IF K17_LUCKY_SUKEBE(40)
			cMove = %조사처리(CALLNAME:TARGET,"는")% 네 손을 잡자 살짝 홍조를 띤다.
		ELSE
			cMove = 당신은 %조사처리(CALLNAME:TARGET,"의")% 손을 잡고, 그녀는 되잡으며 살짝 홍조를 띤다.
		ENDIF
	ELSEIF iFriends || iMOB
		;他に同行がいる
		cMove = %조사처리(CALLNAME:TARGET,"는")% 너와 함께 가기 전에 서둘러 %CALLNAME:(iFriends!=0 ? iFriends#iMOB)%에게 %K17_RS("says/bows")% 인사를 한다.
	ELSE
		;まだやってない
		cMove = 너는 %조사처리(CALLNAME:TARGET,"를")% 이끌기 시작한다.
	ENDIF
	;反応と描写
	SELECTCASE K17_GRT_EX(TARGET)
		CASE IS >= K17C_恋慕
			PRINTFORML 「%K17_RS("자, 그럼 어디로 갈까/나를 데려가고 싶었어?")%」
			PRINTFORMDL %cMove%
		CASE IS >= K17C_思慕逢引
			PRINTFORML 「%K17_RS("자, 그럼 어디로 갈까/나를 데려가고 싶었어?")%」
			PRINTFORMDL %cMove%
		CASE IS >= K17C_思慕
			PRINTFORML 「자, 그럼 어디로 가는 거야?」
			PRINTFORMDL %cMove%
		CASEELSE
			PRINTFORML 「...음... 이상한 곳에 데려가지 말아줘, 알겠지?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신을 조금 경계하는 것 같다.
	ENDSELECT
	;他同行者への反応
	IF iFriends
		PRINTFORML (…%K17_CNAME(iFriends)%도 오고 있어… %K17_RS("무슨 일이야/지금 궁금해졌어")%….)
	ELSEIF iMOB
		PRINTFORML (다른 사람도 오고 있다... %HE_SHE(MASTER)%는 무슨 계획을 하고 있는 걸까...)
	ELSE
		;同行者が他にいない時はうふふ合意基準
		SELECTCASE K17_GRT()
			CASE IS >= K17C_思慕うふふ
				PRINTFORML (…어딘가로 가는 거야 %K17_RS("조용히/사적으로/남의 눈을 피해")%…?)
			CASE IS >= K17C_思慕逢引
				PRINTFORML (%HE_SHE(MASTER,1)%은 나를 수상한 곳에 데려가는 게 아니지...?
		ENDSELECT
		;同行者がアリスだけで他の人がその場にいる場合
		SIF GET_TARGETNUM() > 1
			PRINTFORMDL 당신이 그녀를 다른 이들로부터 데리고 나갈 때, %조사처리(CALLNAME:TARGET,"는")% 조금 당황한 표정을 짓는다.
	ENDIF
ENDIF
PRINTW
RETURN 1
;====================================================================================================
;352,告白する
;====================================================================================================

@M_KOJO_MESSAGE_COM_K17_352
CALL M_KOJO_MESSAGE_COM_K17_352_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_352_1
;-------------------------------------------------
;成功
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193
	;アリス告白イベ前
	IF !CFLAG:K17C_ID:K17C_CF_告白イベント
		PRINTFORML 「...」
		PRINTFORML 「...나... 정말로... 나를 선택하는 게 괜찮은 거야...?」
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "그것에 대해서는 의심의 여지가 없어. 우리 연인이 되고 싶어."
			PRINTFORMDL "그래서 고백하는 거야."
		ELSE
			PRINTFORMDL 연인이 되고 싶다면, 당연하지.
			PRINTFORMDL 결국 네가 고백하는 이유가 그렇다고 그녀에게 말한다.
		ENDIF
		;アリス告白イベ後
	ELSE
		PRINTFORML 「...」
		PRINTFORML 「...저... 어... 네? 에에에?」
		IF CFLAG:K17C_ID:K17C_CF_告白イベント >= 5
			PRINTFORML 「이미 나를 그렇게 여러 번 거절하지 않았나...?」
		ELSE
			PRINTFORML 「이미 나를 거절하지 않았어...?」
		ENDIF
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "음, 그건 부정할 수 없네."
			PRINTFORMDL "하지만 그건 과거의 일이야. 지금은 우리가 연인이 되었으면 좋겠어."
		ELSE
			PRINTFORMDL Well, 당신은 그것을 부정할 수 없지...
			PRINTFORMDL But 그건 과거의 일이야. 지금 네가 원하는 건 연인이 되는 거니까.
		ENDIF
	ENDIF
	PRINTW
	SELECTCASE K17_GRT(TARGET)
		CASE IS >= K17C_恋慕告白
			PRINTFORML 「저...열심히 할게요! 더 귀엽고 예뻐지기 위해서!」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "벌써 충분히 귀엽다고 생각해..."
			ELSE
				PRINTFORMDL 벌써 충분히 귀엽다...
			ENDIF
			PRINTFORML 「당신의 연인이 될 자격이 있는 사람이 되고 싶어요.」
			PRINTFORML 「%K17_CNAME()%에게 고마워요. 당신을 위해 최선을 다할게요.」
			PRINTW
			CALL HPH_PRINT,@"「%K17_CNAME()%은(는) 당신을 연모해요HPH」", "L"
			PRINTFORMDL 그녀의 감정이 이성을 압도하자, %조사처리(CALLNAME:TARGET,"는")%(는) 환한 미소를 지으며 당신의 품으로 뛰어든다.
		CASEELSE
			PRINTFORML 「좋아... 적응하는 데 시간이 좀 걸릴지도 모르지만... 네 연인이 되어줄게.」
			;デートイベで気持ちを伝えているか見る
			SIF CFLAG:K17C_ID:K17C_CF_デートイベント
				CALL HPH_PRINT,@"「%K17_CNAME()%, 사랑해 BPB」", "L"
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 따뜻한 미소를 지으며 이렇게 말한다.
	ENDSELECT
	PRINTFORMDL 당신은 그것이 본 적이 있는 가장 멋진 미소라고 느낀다.
	;恋人フラグの保存
	CALL K17_RELATION_EV(K17C_RTF_恋人)
	RETURN 1
ENDIF
;-------------------------------------------------
;失敗
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193 == 0
	;失敗 恐らく失敗する程度でコマンド表示されないかな
	PRINTFORML 「...저, 음... 그렇게 생각해 주셔서 감사하지만... 죄송해요.」
	RETURN 1
ENDIF
RETURN 1
