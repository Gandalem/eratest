@M_KOJO_MESSAGE_COM_K17_302_1_選択肢
#DIM iRT = 0		;関係性　GRT_EXで取る
#DIM BathFlag = 0	;お風呂フラグ
#DIM iHoldHands = 0	;手を握る選択肢フラグ ほーるどはんど？知るか日本語で書け
#DIM iExFlag,5		;拡張選択肢フラグ
#DIMS cDoll			;人形の表示テキスト
#DIMS cEx,5			;拡張選択肢文字列
#DIM iRand=0		;ランダム値の入れ物
;各種初期化
iRT=K17_GRT_EX()
VARSET BathFlag
VARSET iHoldHands
VARSET iExFlag
VARSET cDoll
VARSET cEx
VARSET iRand
;お風呂チェック
SIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
	BathFlag = 1
;成功or宴会時　普段より大胆に
;note: this is a neat idea but it can lead to some out-of-place lines due to jumping a relationship threshold.
;I've decided to leave this one in to add some flavor, but I disabled the "good mood" bonus to avoid stacking
;with this.
SIF TFLAG:193 == 1 || CFLAG:TARGET:職種 == 49
	iRT++
PRINTL
PRINTFORMDL 이제, 어떻게 해야 할지...
PRINTL
;お風呂時
IF BathFlag
	TRYCALL M_KOJO_MESSAGE_COM_K17_302_1_選択肢_お風呂(iRT)
	RETURN 1
ENDIF
;----選択肢場所とかの判定　長くなりそうなので変数に入れる
;甲斐性無しだと全部だめ
IF !FLAG:甲斐性無
	;耳、首は特になし
	iExFlag:0=1
	iExFlag:1=1
	;太もも　デート中歩きながら手を握る(コマンド出てるはずなので)、太もも触るのはやめよう
	IF !(CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA() && (CFLAG:TARGET:現在位置 % 100) % 10)
		iExFlag:2 = 1
		iHoldHands = 1
	ENDIF
	;内もも　部屋で二人きり
	SIF INROOM(CFLAG:現在位置) && GET_TARGETNUM()==1
		iExFlag:3 = 1
ENDIF
;人形は特になし　テキストの変更はあり
iExFlag:4 = 1
;----選択肢表示判定　関係性判定
SIF iRT >= K17C_思慕
	cEx:0 = Blow into her ear
SIF iRT >= K17C_思慕キス
	cEx:1 = Kiss the nape of her neck
SIF iRT >= K17C_思慕うふふ
	cEx:2 = Rub her thighs
SIF iRT >= K17C_恋慕
	cEx:3 = Stroke her inner thighs from behind
;人形表現処理　上海優先で
cDoll = %K17_GET_DOLL_CNAME(0)%
cEX:4 = Be cheeky and touch %cDoll%
;通常スキンシップ処理
;関係性で条件を満たしていればテキスト表示
;場所的に無理なら選択できない表示
IF !BathFlag && TCVAR:K17C_ID:K17C_TC_スキンシップ == 0
	CALL K17_ASK_M( "손을 잡는다",iHoldHands, "그녀의 몸을 만져라",1, "그녀의 머리를 쓰다듬는다",1, "그녀의 어깨를 마사지한다.",1, cEx:0,iExFlag:0, cEX:1,iExFlag:1, cEX:2,iExFlag:2, cEX:3,iExFlag:3, cEX:4,iExFlag:4, "무작위로 선택한다.",1, "무작위로 선택한다 (하루 종일)",1)
ENDIF
;ランダム時
IF !BathFlag && (RESULT == 9 || RESULT == 10 || TCVAR:K17C_ID:K17C_TC_スキンシップ)
	SIF RESULT == 10
		TCVAR:K17C_ID:K17C_TC_スキンシップ = 1
	;選択雑ぅ（恐れ
	WHILE 1
	RESULT=RAND:9
	SELECTCASE RESULT
		CASE 0
			SIF iHoldHands
				BREAK
		CASE 1 TO 3
			BREAK
		CASE 4
			SIF iRT >= K17C_思慕 && iExFlag:0
				BREAK
		CASE 5
			SIF iRT >= K17C_思慕キス && iExFlag:1
				BREAK
		CASE 6
			SIF iRT >= K17C_思慕うふふ && iExFlag:2
				BREAK
		CASE 7
			SIF iRT >= K17C_思慕うふふ && iExFlag:3
				BREAK
		CASE 8
			SIF iExFlag:4
				BREAK
	ENDSELECT
	WEND
ENDIF
SIF TCVAR:K17C_ID:K17C_TC_スキンシップ != 1
	PRINTL
;---------------------------
;各スキンシップの描写　初回とRT判定　いちゃこらやりすぎた……長い
;---------------------------
SELECTCASE RESULT
	;---------------------------
	;手を握る　手をつなぐと一緒
	;---------------------------
	CASE 0
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 손을 잡는다.
		SIF TFLAG:193 == 1
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 손을 행복하게 되잡으며 얼굴을 붉힌다.
		PRINTW
		CALL M_KOJO_MESSAGE_COM_K17_603_1
		CALLF FIRSTTIME(@"스킨십{RESULT}")
		RETURN 1
		;---------------------------
		;身体をつんつん
		;---------------------------
	CASE 1
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 몸을 가볍게 찌른다.
		PRINTW
		;初回
		IF FIRSTTIME(@"スキンシップ{RESULT}")
			CALL HPH_PRINT,"「히아흔 BPB가 간지럽다.」", "L"
			PRINTFORML 「다른 사람에게 만져지는 것은 상당히 새로운 경험이다.」
			PRINTFORML 「이제 내 차례야... 여기, 네가 열렸어~... 아, 예상보다 더 재미있군.」
			PRINTFORMDL 두 사람은 서로의 옆구리를 찔렀다.
			RETURN 1
		ENDIF
		;二回目以降
		SELECTCASE iRT
			CASE IS >= K17C_恋慕
				CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyann/Yahnn")% BPB」", "L"
				PRINTFORML 「이제 내 차례야, %K17_RS("there/poke poke")%!」
				PRINTFORMDL 서로 계속 장난치다 보면 흥분해서 %조사처리(CALLNAME:TARGET,"의")% %K17_RS("breasts/chest/nipples")%를 장난치게 된다.
				CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyann/Yahnn/Ahnn")% 힉힉... 변태 BPB」", "L"
				PRINTFORMDL 그녀는 보복으로 당신의 %K17_RS("가슴/유두")%를 찌른다.
			CASE IS >= K17C_知り合い
				PRINTFORML 「응~ %K17_RS("That tickles/Ahahaha")%!」
				PRINTFORMDL 두 사람은 한동안 서로를 계속 건드린다.
		ENDSELECT
		;---------------------------
		;髪を撫でる
		;---------------------------
	CASE 2
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 머리를 쓰다듬는다.
		PRINTW
		;初回
		IF FIRSTTIME(@"スキンシップ{RESULT}")
			PRINTFORML 「음... 내 머리를 만지는 건 잘 모르겠어...」
			PRINTFORMDL 그녀의 금발은 너무 섬세해서 맨손으로 만지기조차 두렵다.
			PRINTFORML 「인간 마을 아이들은 항상 내 머리카락을 잡아당기려고 해. 정말 그렇게 이상한 걸까...」
			PRINTFORML 「게다가, 내 머리가 꽤 제멋대로거든...」
			PRINTFORMDL 아래에서 머리를 쓸어 올릴 때 부드러운 탄력이 느껴지고, 그것은 고운 실처럼 반짝인다.
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "이 몸은 이것을 만지는 것에 질리지 않을 거라고 생각한다."
			ELSE
				PRINTFORMDL 그녀의 머리를 만지는 것에 질릴 일이 없을 것 같은 기분이 들었다.
			ENDIF
			CALL HPH_PRINT,"「오, 너... 브브브브」", "L"
			RETURN 1
		ENDIF
		iRand = K17_LOWER_LIMIT_RAND(iRT,K17C_思慕うふふ,K17C_恋慕告白)
		;二回目以降
		SELECTCASE iRand
			CASE IS >= K17C_恋慕告白
				PRINTFORMDL 기분 좋은 향기가 코끝을 간지럽히고, 당신은 그녀의 머리를 킁킁거리게 된다.
				CALL HPH_PRINT,@"「와, 너 뭐야... BPB 그렇게 맡지 마 BPB」", "L"
				CALL HPH_PRINT,@"「무슨 뜻이야, 좋은 냄새가 난다... 그건 너무 %K17_RS("이상해/치정스럽네")%야」", "L"
			CASE IS >= K17C_思慕うふふ
				PRINTDATAL
					DATAFORM 「Nn, %K17_RS("don't touch it so much/that tickles")%... %K17_BLUSH()%」
					DATAFORM 「음~ ...내 머리 정말 좋아해 주는구나... %K17_BLUSH()%」
					DATAFORM 「나는 네 인형이 아니야, 알고 있잖아... %K17_BLUSH()%」
				ENDDATA
				PRINTFORML 「듣고 있니? 진심으로...」
				PRINTFORMDL 너는 %조사처리(CALLNAME:TARGET,"의")% 머리카락에 완전히 사로잡혀 있어...
				PRINTFORML 「대신 네 머리를 내가 빗겨줄게.」
			CASE IS >= K17C_知り合い
				PRINTFORML 「음... 너는 인간 마을의 아이들을 떠올리게 해.」
				PRINTFORML 「이제 네 머리카락도 부풀려 줄 거야.」
		ENDSELECT
		;---------------------------
		;肩を揉む
		;---------------------------
	CASE 3
		;初回
		IF FIRSTTIME(@"スキンシップ{RESULT}")
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 어깨를 주무른다.
			PRINTW
			PRINTFORML 「푸흡... 아하하하하, 미-미안해, 간지러워.」
			PRINTFORMDL 하지만 그녀의 어깨는 전혀 굳어 있지 않았다.
			PRINTFORML 「나는 결국 마술사니까, 내 몸은 젊게 유지하고 꼭 정기적으로 인형 조종 연습을 해.」
			PRINTFORMDL 그건 좀 불공평한 기분이야...
			RETURN 1
		ENDIF
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 어깨를 부드럽게 문질러준다.
		PRINTW
		;二回目以降
		SELECTCASE iRT
			CASE IS >= K17C_思慕うふふ
				PRINTDATAL
					DATAFORM 「음, 고마워.」
					DATAFORM 「그 정도의 힘이 완벽해...」
				ENDDATA
				PRINTFORML 「%K17_RS("대신 멋진/부드러운 마사지를 해줄게.")%」
			CASE IS >= K17C_知り合い
				PRINTFORML 「흐음... %K17_RS("간지러워/아하하하")%...」
				PRINTFORML 「대신 %K17_RS("고통스러운/힘든")% 마사지를 해줄게.」
		ENDSELECT
		;---------------------------
		;耳に息を吹きかける　思慕↑
		;---------------------------
	CASE 4
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 귀에 바람을 불어넣는다.
		PRINTW
		;初回
		IF FIRSTTIME(@"スキンシップ{RESULT}")
			CALL HPH_PRINT,"「하와아! BPB, 너 지금 뭐 하는 거야...」", "L"
			PRINTFORMDL 그녀는 당신이 예상했던 것보다 훨씬 더 놀란 듯하다.
			PRINTFORML 「오호~, 내가 뭘 돌려줘야 할까...」
			PRINTFORMDL 결국 그녀는 가볍게 당신의 귀를 잡아당긴다.
			RETURN 1
		ENDIF
		;二回目以降
		IF iRT >= K17C_恋慕 && K17_RT_FG() & K17C_RTF_キス
			PRINTFORMDL 마침내, 당신은 그녀의 귀 끝을 살짝 깨물었다.
			CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyahnn/Yahnn")% HPH」", "L"
			PRINTFORML 「이제 내 차례야... %K17_RS("음/냠/음")%.」
			IF K17_RT_FG() & K17C_RTF_告白
				PRINTFORML 「...사랑해.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신의 귓가에 속삭인다.
			ENDIF
		ELSEIF iRT >= K17C_思慕
			CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyahnn/Yahnn")% BPB」", "L"
			PRINTFORML 「흥, 그만해줘. 이상한 소리 나게 하잖아...」
		ENDIF
		;---------------------------
		;首筋にキス　思慕キス↑
		;---------------------------
	CASE 5
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 목덜미에 입을 맞춘다.
		PRINTW
		;初回
		IF FIRSTTIME(@"スキンシップ{RESULT}")
			CALL HPH_PRINT,"「히안 브이피비...」", "L"
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 간지러운 듯 몸을 꿈틀거린다.
			IF CFLAG:既成事実 & 合意_キス
				CALL HPH_PRINT,"「음... 음 뽀삐... 뭐야, 나한테 표시하려고 하는 거야? 후후.」", "L"
			ELSE
				PRINTFORML 「뭐... 뭐... 뭐야...? 네가 뭘 하고 있는지 알고나 있니?」
			ENDIF
			PRINTW
			CALL HPH_PRINT,"「아, BPB 그만해, 멍 들 거야...」", "L"
			CALL HPH_PRINT,"「다른 사람이 보고 오해하면 창피할 거야... BPB」", "L"
			PRINTFORMDL 그녀는 복수로 당신을 주먹으로 가볍게 때린다.
			RETURN 1
		ENDIF
		;ここは実値で見るかな　ノリで選択できても反応は実際の関係性
		SELECTCASE K17_GRT()
			CASE IS >= K17C_恋慕告白
				CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyahnn/Yahnn")% HPH」", "L"
				PRINTFORML 「이리 와봐~, 입술 자국 남길 거야. 정말 그렇게 %K17_RS("나를 표시해/너무 소유욕 강해/영토 표시를 해")% 해야 할까?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 네가 흔적을 남기는 동안 가볍게 머리를 쓰다듬는다.
			CASE IS >= K17C_思慕キス
				CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyahnn/Yahnn")% BPB」", "L"
				PRINTFORML 「대신 내 입술에 제대로 키스해 주면 안 돼?」
				PRINTFORMDL 그녀가 그렇게 말하는 와중에도, 당신은 계속해서 %조사처리(CALLNAME:TARGET,"의")% 목에 키스를 퍼붓는다.
			CASEELSE
				;キス前
				CALL HPH_PRINT,@"「...%K17_RS("Nnkuh/Kuh/Mmm")% BPB」", "L"
				PRINTFORML 「자, 그럼 내가 보답할 건 뭘 해야 할까?」
				PRINTFORMDL 그녀는 당신의 목덜미를 손톱으로 파고든다. 아프다.
		ENDSELECT
		;仕返しキスマーク
		IF TALENT:恋慕
			CALL K17_CHOICE(@"「그럼 나도 되니까 키스 자국 남겨도 괜찮지?」","네","No")
			IF !RESULT
				;いいよ
				CALL HPH_PRINT,"「음~~ 음프~~큭큭퍽 아파하지 않지? 핥고, 질척...」", "L"
				;キスマークコピペ
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 당신을 끌어안고 목덜미 아래를 격렬하게 빨기 시작하며, 흔적을 남겼다...
				PRINTFORMDL 그게 사라질 때까지 다른 여자들은 피하는 게 좋을 거야...
				TFLAG:キスマーク = TARGET
				IF CFLAG:TARGET:弱み握り > 0
					;弱みがある場合処理
					CFLAG:TARGET:弱み握り--
					IF CFLAG:TARGET:弱み握り > 0
						PRINTFORMDL  당신에 대한 %조사처리(CALLNAME:TARGET,"의")% 협박 자료가 조금 가벼워졌다.
					ELSE
						PRINTFORMDL 당신에 대한 %조사처리(CALLNAME:TARGET,"의")% 협박 자료가 삭제되었다.
					ENDIF
				ELSE
					;弱みなしでもキスマークつけるとか……縛りプレイいや縛られプレイ
					PRINTFORMDL 당신은 자신이 %조사처리(CALLNAME:TARGET,"의")% 독점적인 %K17_RS("possession/territory")%로 표시된 것 같은 기분이 든다.
				ENDIF
			ELSE
				;やめて
				PRINTFORML 「아니, 제발... 정말 그렇게 반대하는 거야...?」
			ENDIF
		ENDIF
		;---------------------------
		;ふとももすりすり　思慕うふふ↑
		;---------------------------
	CASE 6
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 허벅지를 문지른다.
		PRINTW
		;初回
		IF FIRSTTIME(@"スキンシップ{RESULT}")
			CALL HPH_PRINT,"「아... 음, 브이비피...」", "L"
			CALL HPH_PRINT,"「이거 너무 부끄러워, 비피비... 이봐...」", "L"
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "무슨 일이야, 얼굴이 많이 빨개졌네."
			ELSE
				PRINTFORMDL 너는 그녀의 얼굴이 비트처럼 빨갛기 때문에 무슨 일인지 묻는다.
			ENDIF
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 당신의 얼굴에 가까이 다가와 귀에 속삭인다.
			PRINTW
			CALL HPH_PRINT,"「...마치 당신이 나를 성추행하는 것만 같다 BPB」", "L"
			PRINTFORMDL 문지르기 문지르기 문지르기...
			PRINTFORMDL 조금 흥분해서, 그녀가 당신의 허벅지를 아프게 꼬집는 것을 느낀다.
			RETURN 1
		ENDIF
		;二回目以降　GET_TARGETNUM
		;服装制限(スカートをめくる抜粋)&屋内二人きり
		IF iRT >= K17C_恋慕 && iExFlag:3 && (EQUIP:スカート || EQUIP:ワンピース || EQUIP:着物)
			PRINTFORMDL 두 분이 단둘이 있으니, 그녀의 %K17_GET_CLOTHNAME_BOTTOM(TARGET)% 아래로 손을 넣어 맨 허벅지를 쓰다듬었다.
			PRINTFORML 「에... 저기...」
			CALL HPH_PRINT,@"「...%K17_RS("햐안/냐안/야안")% BPB ...헤이~」", "L"
			CALL HPH_PRINT,@"「%K17_RS("Hyahnn/Nyahnn/Yahnn")% 뽀뽀... %K17_RS("Hyahnn/Nyahnn/Yahnn")% 후후 ...벌거벗은 피부는 아니야...」", "L"
			PRINTFORMDL 문지르기 문지르기 문지르기...
