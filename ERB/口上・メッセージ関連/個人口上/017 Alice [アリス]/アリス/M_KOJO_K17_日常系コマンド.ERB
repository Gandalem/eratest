@M_KOJO_MESSAGE_COM_K17_怒り

SIF !CFLAG:TARGET:ブチギレ
	RETURN 0

SELECTCASE RAND:3
	CASE 0
		PRINTFORM 「...」
		TRYCALL K17_人形台詞(-1,1,K17_RS("Are you stupidー/Quit itー/She's angryー"))
		PRINTFORMDL %CALLNAME:TARGET% doesn't even look your way.
	CASE 1
		PRINTFORM 「...Hmph.」
		TRYCALL K17_人形台詞(-1,1,K17_RS("Are you stupidー/Quit itー/She's angryー"))
		PRINTFORMDL %CALLNAME:TARGET% looks away in displeasure.
	CASEELSE
		PRINTFORM 「...Fuu.」
		TRYCALL K17_人形台詞(-1,1,K17_RS("Are you stupidー/Quit itー/She's angryー"))
		PRINTFORMDL %CALLNAME:TARGET% sighs quietly in exasperation.
ENDSELECT
RETURN 1
