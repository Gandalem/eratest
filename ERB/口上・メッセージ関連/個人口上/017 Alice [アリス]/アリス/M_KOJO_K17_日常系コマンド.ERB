;デート系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;====================================================================================================
;603,手を繋ぐ
;====================================================================================================

@M_KOJO_MESSAGE_COM_K17_603
CALL M_KOJO_MESSAGE_COM_K17_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_603_1
#DIM DYNAMIC iRT = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	iRT = K17_GRT_EX(TARGET)
	;初回
	IF FIRSTTIME(SELECTCOM) || FIRSTTIME(@"スキンシップ0")
		PRINTFORML 「음... 생각했던 것보다 더 창피하네.」
		PRINTFORML 「나는 바느질이나 마법, 인형 조종처럼 내 일에 손을 많이 사용해서, 만지면 거칠고 불쾌할 거라고 확신해...」
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "전혀 그렇지 않아."
			PRINTFORMDL "오히려 이 손들이 저 인형들을 얼마나 능숙하게 조종하는지 생각하면, 마치 값진 보물을 다루는 기분이 들어."
		ELSE
			PRINTFORMDL 그녀에게 전혀 개의치 않는다고 말한다.
			PRINTFORMDL 오히려 이 손들이 저 인형들을 얼마나 능숙하게 다루는지 생각하면, 마치 값진 보물을 다루는 기분이 들었다.
		ENDIF
		PRINTFORML 「아첨으로는 아무것도 얻을 수 없어... 하지만 고마워요, %K17_CNAME()%.」
		PRINTFORMDL 살짝 홍당무가 된 %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 손을 꽉 잡는다.
		CALLF FIRSTTIME(@"스킨십0")
		RETURN 1
	ENDIF
	;思慕あれば下限切り上げ
	iRT = K17_MAX_LIMIT_RAND(iRT,K17C_思慕,K17C_恋慕告白)
	;二回目以降
	SELECTCASE iRT
		CASE IS >= K17C_恋慕告白
			PRINTFORML 「아니, 부끄러워하지 마～～ 이래야 더 좋지 않아?」
			PRINTFORMDL 당신은 그녀의 손가락과 깍지를 끼지만 %조사처리(CALLNAME:TARGET,"는")% 당신의 팔 전체를 붙잡는다.
			PRINTFORML 「오늘 좀 따뜻한 기분이야... 응? 무슨 일이야?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 말을 하는 동안, 그녀는 계속해서 가슴을 당신의 팔에 바짝 기댄다.
			PRINTFORML 「%K17_RS("you'd still blush like that/that still makes your heart race")%」라니, 이 모든 시간이 지난 후에... 정말 귀엽네.
		CASE IS >= K17C_思慕うふふ
			PRINTFORML 「당신의 손이 %K17_RS("따뜻하다/조금 차갑다")%하게 느껴진다.」
			PRINTFORML 「이렇게 손잡는 거 좋아해? ...나도 그래.」
		CASE IS >= K17C_思慕
			PRINTFORML 「음... 이것 때문에 조금 %K17_RS("치정스럽다/어색하다/자신감이 없다")%한 기분이 들어.」
		CASE IS >= K17C_知り合い
			PRINTFORML 「음... 당신의 손이 조금 %K17_RS("차가운/땀에 젖은")%.」
			;男性で体型が普通以上　女性の場合体型が大きければ
			IF (TALENT:MASTER:性別 == 2 && TALENT:MASTER:体型 > -1) || (TALENT:MASTER:性別 & 1 && TALENT:MASTER:体型 > TALENT:TARGET:体型)
				PRINTFORML 「음~ 확실히 내 것보다 더 커.」
			ELSEIF (TALENT:MASTER:性別 == 2 && TALENT:MASTER:体型 < -1) || (TALENT:MASTER:性別 & 1 && TALENT:MASTER:体型 < TALENT:TARGET:体型)
				PRINTFORML 「음~ 내 것보다 조금 작고 귀하네.」
			ELSE
				PRINTFORML 「음~ 이렇게 가까이서 보니까 형상이나 홈이 나랑 다르네.」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
