@M_KOJO_MESSAGE_COM_K17_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り状態　失敗時はすぐ戻す
	IF CFLAG:TARGET:ブチギレ == 1 || TFLAG:193 == -1
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 어떤 스킨십을 시도한다...
		PRINTW
		;失敗
		IF TFLAG:193 == -1
			PRINTFORMDL 그녀를 가볍게 만지지만, 지금은 적절한 때가 아니라는 것을 느낀다.
			PRINTFORMDL 그녀가 화내기 전에, 일단 그만두기로 결정한다.
			PRINTW
			RETURN 1
			;怒り
		ELSE
			TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
			RETURN 1
		ENDIF
	ENDIF
	;成功or宴会時orデート中　普段より大胆に
	IF TFLAG:193 == 1 || CFLAG:TARGET:職種 == 49 || FLAG:デート相手 == K17C_ID
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")%의 스킨십에서 유난히 대담해진다.
	ELSE
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 어떤 스킨십을 시도한다.
	ENDIF
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上") ;|| STRCOUNT(CSTR:K17C_ID:0,"スキンシップ[0-9]") == 0
		PRINTFORML 「캬?!」
		PRINTFORML 「기-기다려, 대체 어디를 만지고 있다고 생각하는 거야...」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 갑작스러운 신체 접촉에 놀란 듯하다.
		PRINTFORML 「음ー... 그렇게 갑자기 내 몸에 스치는 건 심장에 안 좋아.」
		PRINTW
		PRINTFORML 「반면에, 나도 네 몸에 조금 관심이 있어...」
		PRINTFORMDL 응...?
		PRINTFORML 「하지만 지금 네가 생각하는 그런 방식은 아닐걸.」
		PRINTW
		PRINTFORML 「차라리 내 인형 만들기에 도움이 될 거라고 생각해.」
		PRINTFORML 「결국 나 자신의 몸으로부터 얻을 수 있는 데이터는 한계가 있으니까.」
		PRINTFORML 「그 점을 염두에 두고, 내가 제안하고 싶은 것이 있어. 어느 정도의 신체 접촉을 허용할게.」
		PRINTFORML 「하지만 네가 날 만질 때마다, 나도 그에 상응하는 반응을 보일 거야.」
		PRINTW
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "가령 내가 '여기'나 '거기'를 만진다면 어떨까...?"
		ELSE
			PRINTFORMDL 당신은 "여기"나 "저기"를 만지는 것에 대해 묻는다...
		ENDIF
		PRINTFORML 「그 손은 마지막으로 닿았던 곳에 만족했을 거야, 안 그래?」
		PRINTFORML 「어차피 자기 몸과는 더 이상 연결되어 있지 않으니까.」
		PRINTFORMDL 우륵...
		PRINTW
		PRINTFORML 「후후, 농담이야. 하지만 숙녀를 대하는 올바른 방법을 염두에 두렴.」
		PRINTFORMDL 그녀의 눈에는 웃음기 한 점 없었다...
	ENDIF
	;通常、お風呂判定して選択
	TRYCALL M_KOJO_MESSAGE_COM_K17_302_1_選択肢
	;成功時
	SIF TFLAG:193 == 1
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 약간 행복해 보인다...
	PRINTW
