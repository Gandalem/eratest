;301,お茶を淹れる
;====================================================================================================
@M_KOJO_MESSAGE_COM_K17_301
CALL M_KOJO_MESSAGE_COM_K17_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL

	;怒り状態
	IF CFLAG:TARGET:ブチギレ == 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
		RETURN 1
	ENDIF
	
	;-------------------------------------------------
	;初めて
	;選んだ瞬間にFIRSTTIME記録されるので怒り状態で初回されるとスキップされる
	;自前で用意してもいいけど、仕様ってことでひとつ……
	;必要な場合口上つけて保存してみるテスト
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上")
		PRINTFORML 「Oh, you made tea.」
		PRINTFORML 「I'm sorry you had to go to the trouble, I should have been the one to brew it.」
		PRINTFORMDL You tell %CALLNAME:TARGET% you'd rather she let you do it, since there's not much else you can do for her.
		PRINTFORML 「Hmmー. Perhaps I'll take you up on that offer, then.」
		PRINTFORML 「I should warn you that I'm quite particular about my tea, however.」
		PRINTFORMDL You'd better do your best from now on, then.
		PRINTW
	ENDIF
	
	;仕事中
	IF CFLAG:TARGET:行動 == 5
		PRINTDATAL
			DATAFORM 「I was just about to take a short break.」
			DATAFORM 「Perfect timing.」
			DATAFORM 「Oh, what a nice surprise.」
		ENDDATA
	ENDIF
	
	;成功判定
	IF TFLAG:193 == 1
		PRINTFORML 「Your tea is particularly %K17_RS("well made/delightful/fragrant")%. Maybe all that practice is paying off.」
		PRINTFORMDL Looks like you got passing marks.
		
	;失敗
	ELSEIF TFLAG:193 == -1
		SELECTCASE K17_GRT(TARGET)
			CASE IS >= K17C_恋慕
				PRINTFORML 「...Nn...」
				PRINTFORMDL %CALLNAME:TARGET% grimaces for a moment, but continues to drink the tea without comment.
			CASE IS >= K17C_思慕
				PRINTFORML 「...Mmmー? This isn't very good.」
			CASE K17C_知り合い
				PRINTFORML 「...Just, what did you put in this...」
				PRINTFORMDL %CALLNAME:TARGET% seems suspicious that you spiked the tea with something.
		ENDSELECT
		PRINTFORMDL Looks like you messed up. You resolve to do better next time.
	ENDIF
	
	;感想
	SELECTCASE K17_GRT_EX(TARGET)
		CASE IS >= K17C_恋慕
			PRINTFORML 「This has become like %K17_RS("daily routine/a habit/everyday life/second nature")% for me...」
			PRINTFORML 「Thank you as always, %K17_CNAME(MASTER,1)%.」
		CASE IS >= K17C_思慕
			PRINTFORML 「Thank you as always, %K17_CNAME(MASTER,1)%.」
		CASE IS >= K17C_知り合い
			PRINTFORML 「I wonder how longer we'll continue this routine, fufu.」
	ENDSELECT
	
ENDIF
RETURN 1
