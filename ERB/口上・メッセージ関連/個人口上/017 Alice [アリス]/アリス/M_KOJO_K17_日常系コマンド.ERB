		PRINTW
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "Was there really something stuck to my cheek...?"
		ELSE
			PRINTFORMDL You wonder if there was really anything stuck to your cheek...
		ENDIF
		CALL HPH_PRINT,"「There was, really...――MmphHPH There's still, some more... Chuu～HPH MmmHPH」", "L"
		;経験値
		CFLAG:K17C_ID:K17C_CF_FKアリス = MIN(CFLAG:K17C_ID:K17C_CF_FKアリス+1,10000)
		EXP:Ｍ経験 += 1
		EXP:MASTER:Ｍ経験 += 1
		CALL MUTUAL_KISS
		
	ELSEIF iRT >= K17C_恋慕
		PRINTW
