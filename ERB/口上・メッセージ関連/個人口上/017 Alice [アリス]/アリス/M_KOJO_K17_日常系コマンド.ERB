@M_KOJO_MESSAGE_COM_K17_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
IF CFLAG:行動 == 5 && !(DAY % 14) && TIME <= 720
	CALL K17_SKIP_TRAIN_MESSAGE
ELSE
	CALL TRAIN_MESSAGE
ENDIF
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K17_300_1
PRINTW
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_300_1
#DIM CONST 話題数 = 6	;最大話題数定義しとく
#DIM DYNAMIC iRTnum=0
#DIM DYNAMIC iRand=0
RESULT=0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:時間停止
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		LOCAL:9 = CFLAG:TARGET:ブチギレ
		CFLAG:TARGET:ブチギレ = 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
		CFLAG:TARGET:ブチギレ = LOCAL:9
		RETURN
	ENDIF
	;関係性をセット
	iRTnum = K17_GRT_EX(TARGET)
	;DEBUGPRINTFORML 【M_KOJO_MESSAGE_COM_K17_300_1 iRTnum({iRTnum})】
	;------------優先判定するもの---------------------
	;-----------------------------
	;仕事中
	;-----------------------------
	IF CFLAG:行動 == 5
		;人形劇中
		IF CFLAG:職種 == JOB_会話
			IF TIME >= 720
				;後片付け
				PRINTFORM 「미안하지만, 이것을 아직 끝내야 해...」
				TRYCALL K17_人形台詞(-1,1,K17_RS("Let's helpー/Good workー"))
			ELSE
				;公演中
				PRINTL
				TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇
			ENDIF
			;家事
		ELSE
			PRINTFORML 「죄송해요, 집안에 해야 할 일들이 좀 있어서요...」
		ENDIF
		RETURN 1
	ENDIF
	;-----------------------------
	;お友達認定フラグ保存
	;イベントフラグ持たせるのも微妙……ちゃんとしたの作るか
	;-----------------------------
	IF !CFLAG:K17C_ID:K17C_CF_お友達イベント
		IF ABL:親密 >= 5
			PRINTFORML 「음~ 최근에 이렇게 이야기하는 게 꽤 된 것 같아...」
			PRINTFORML 「음, 네가 이상한 짓을 하지 않는 한, 나도 조금 마음을 열어줄 수 있을 것 같아.」
			CFLAG:K17C_ID:K17C_CF_お友達イベント=1
			TRYCALL K17_RELATION_EV(K17C_RTF_お友達)
			RETURN 1
		ENDIF
	ENDIF
	;-----------------------------
	;パンツ罠 疑い50超えてたらベース50で判定
	;ほぼバレるはず
	;-----------------------------
	IF K17_CHECK_時間停止バレ(TARGET,50,50)
		CALL M_KOJO_MESSAGE_COM_K17_300_1_会話_時間停止バレ
		TFLAG:好感度マイナス = 2
		RETURN 1
	ENDIF
	;-----------------------------
	;人形劇見たその日の会話
	;-----------------------------
	IF TCVAR:K17C_ID:K17C_TC_人形劇
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇感想
		TCVAR:K17C_ID:K17C_TC_人形劇 = 0
		RETURN 1
	ENDIF
	;怒り状態
	IF CFLAG:TARGET:ブチギレ == 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
		;会話不能時
	ELSEIF (TCVAR:会話不能 || MARK:反発刻印 >= 3) && !TALENT:TARGET:恋慕
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_不能
		;酔い 60%で入る　泥酔なら必ず
	ELSEIF (BASE:17:酒気 >= 1 && K17_PERCENT(60)) || TCVAR:泥酔
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_酔い(iRTnum)
		;成功判定
	ELSEIF TFLAG:193 >= 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_成功(iRTnum)
		;失敗
	ELSEIF TFLAG:193 <= -1
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_失敗(iRTnum)
	ELSE
		RESULT=0
	ENDIF
	;--------------通常会話の話題ランダム-------------------
	;そのうち場所についても入れる予定
	;CFLAG:TARGET:デート中は行き先入っちゃうのでFLAG:デート相手==17で取るか
	;通常会話ランダム検索へ　仮置き
	i=0
	WHILE RESULT == 0
	iRand= RAND:話題数
	TRYCALLFORM M_KOJO_MESSAGE_COM_K17_300_1_話題_{iRand}(iRTnum)
	SIF RESULT
		BREAK
	IF i>=3
		iRTnum--
		i=0
	ENDIF
	SIF iRTnum<0
		BREAK
	i++
	WEND
ENDIF
RETURN 1
;*********************************************************
;会話	：人形劇
;会話不能でも優先的に選ばれる
;アリスが勝手に喋ってる感じ
;10時開演～12時終演 12時からは片付けの手伝いができる
;*********************************************************

@M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇
PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 인형극 공연을 즐긴다...
SIF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 8)
	PRINTW
;-------------------
;上海の好感度上げる
;-------------------
CFLAG:K17C_ID:K17C_CF_上海好感度 = MIN(CFLAG:K17C_ID:K17C_CF_上海好感度 + 10,10000)
;-------------------
;公演中
;公演時間で見る　30分ごとに4分割
;-------------------
SELECTCASE (720 - TIME) / 30
	CASE IS >= 3
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 1)
			PRINTFORML 「여러분, 오늘 와 주셔서 정말 감사합니다.」
			PRINTFORM 「그럼, 시작해 볼까요...」
			TRYCALL K17_人形台詞(K17C_上海,0,"Boys and girlsー")
			TRYCALL K17_人形台詞(K17C_蓬莱,1,"Gather 'roundー")
			PRINTW
			PRINTFORML 「착한 아이들을 위한 재미있는 이야기가 있어...그리고 나쁜 소년들과 소녀들을 위한 아주 무서운~ 이야기들도 있지...」
			PRINTFORML 「%CALLNAME:TARGET%」의 인형극 시간이 시작될 시간이야~
			PRINTFORMDL 모인 아이들이 환호하기 시작하는 것이 들렸다.
			PRINTW
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 1
		ENDIF
		PRINTFORML 「아주아주 옛날에 나쁜, 정말 나쁜 마녀를 두려워하며 살던 왕국이 있었다...」
		PRINTFORML 「그 사악한 마녀는 갑자기 나타나 아무도 모르는 곳으로 아이들을 납치하곤 했다.」
		PRINTFORML 「사악한 마녀가 무서웠던 왕국의 사람들은 왕에게 마녀를 물리쳐 달라고 간청했다.」
		TRYCALL K17_人形台詞(K17C_上海,1,"Your majesty! Please defeat the evil witch!")
		PRINTFORML 「하지만 왕은 백성들의 간청을 외면했다.」
		PRINTFORML 「마침내 어느 날 성 안의 공주님마저 납치되었다...」
		TRYCALL K17_人形台詞(K17C_蓬莱,1,"Kyaaahー! Someone, please helpー!")
	CASE 2
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 2)
			PRINTFORML 「드디어 왕이 행동을 취하기 시작했다.」
			PRINTFORML 「그는 온 나라에서 가장 용감하고 정의로운 전사인 젊은 기사 피노에게 왕국을 구하라고 요청했다.」
			PRINTFORML 「백성들의 희망을 어깨에 짊어진 피노는 사악한 마녀를 물리치고 공주님을 구하기로 결심했다.」
			TRYCALL K17_人形台詞(K17C_上海,1,"Accursed witch! I will never forgive you!")
			PRINTW
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 2
		ENDIF
		PRINTFORML 「그리고 젊은 기사는 공주를 구하기 위해 여정을 떠났다...」
		TRYCALL K17_人形台詞(K17C_上海,1,"Princess! I am coming to save you.")
	CASE 1
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 4)
			PRINTFORML 「피노는 그의 모험에서 많은 어려움을 극복해야 했다.」
			PRINTFORML 「한때, 그는 봄의 축복을 단 한 번도 받지 못한 영원한 겨울의 숲을 건너야 했다...」
			PRINTFORML 「또 다른 때에는, 그는 영원한 밤에 싸인 대나무 숲을 헤쳐나가야 했다.」
			PRINTFORML 「동굴에서 오니들과 싸우고, 하늘에 닿은 산에서 천상(celestials)들을 만났다... 그것은 장대한 모험이었다.」
			PRINTFORML 「그리고 마침내, 젊은 기사는 사악한 마녀를 찾았다.」
			TRYCALL K17_人形台詞(K17C_上海,1,"Witch! We finally meet!")
			PRINTW
			PRINTFORML 「젊은 기사 피노는 마녀에게 공주를 돌려달라고 요구했지만, 마녀는 거절했다.」
			PRINTFORM 『악마 같은 마녀여! 내가 너를 물리치겠다!』
			TRYCALL K17_人形台詞(K17C_上海,1,"It's time! Witch!")
			PRINTFORML 「그리고 그 선언과 함께 기사와 마녀는 격렬한 전투를 시작했다...」
			PRINTW
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 4
		ENDIF
		PRINTFORMDL 인형들이 서로 부딪히며 사방으로 빛의 불꽃이 날아간다... 그녀가 마법의 한 조각을 던진 건지 궁금해진다.
		PRINTFORMDL 결국 작은 폭발과 함께 연기가 피어오른다.
		PRINTFORML 「긴 투쟁 끝에, 악한 마녀는 마침내 패배했다.」
		PRINTW
		PRINTFORML 『노오오~!! 당신이 나를 물리쳤어~!!』
		TRYCALL K17_人形台詞(K17C_上海,0,"Princess! You're safe!")
		TRYCALL K17_人形台詞(K17C_蓬莱,1,"Thank you for saving me!")
		PRINTFORML 「그리고 젊은 기사는 성공적으로 공주를 구했다.」
	CASE 0
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 8)
			PRINTFORML 「젊은 기사가 공주와 함께 왕국으로 돌아왔을 때, 그는 즉시 영웅이 되었다.」
			PRINTFORML 「그 후, 그는 공주와 결혼했고 두 사람은 함께 정착했다...」
			TRYCALL K17_人形台詞(K17C_上海,0,"Princess, I will make you the happiest woman in all the land!")
			TRYCALL K17_人形台詞(K17C_蓬莱,1,"I will love you forever, Prince!")
			PRINTFORML 「그리고 그들은 영원히 행복하게 살았다...」
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 8
		ELSE
			PRINTFORMDL 인형극은 이미 끝난 것 같고, %조사처리(CALLNAME:TARGET,"는")% 아이들에게 둘러싸여 있다.
			PRINTW
			PRINTFORML 「소년들과 소녀들, 항상 착하게 굴고 부모님 말씀을 들으세요.」
			PRINTFORML 「그렇지 않으면 사악한 마녀가 와서 여러분을 멀리 데려갈 거예요...」
		ENDIF
ENDSELECT
;custom code: reset these to prevent "out of topics" from turning the button orange
TCVAR:会話累計値 = 0
TCVAR:会話不能 = 0
