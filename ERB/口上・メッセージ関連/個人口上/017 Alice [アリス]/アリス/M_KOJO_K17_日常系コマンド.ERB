@M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇感想
#DIM DYNAMIC iFlagNum = 0
#DIMS DYNAMIC cEX=""
;何個見たか数える
FOR i,0,4
SIF GETBIT(TCVAR:K17C_ID:K17C_TC_人形劇,i)
	iFlagNum ++
NEXT
PRINTFORM 「...아, 인형극을 봤구나... 좀 부끄럽네.」
TRYCALL K17_人形台詞(-1,1,"How embarrassingー")
PRINTW
;適当に好感度うｐ
;読んだ数*10
TFLAG:好感度管理 += 10*iFlagNum
;見た数で判定
IF iFlagNum < 4
	;全部見られなかった
	PRINTFORML 「그래서, 음, 어떻게 생각하는 거야...?」
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 당신에게 의견을 묻지만, 전체를 놓쳤기 때문에 모호한 대답만 할 수 있다.
	PRINTFORML 「음~... 뭐, 다음엔 처음부터 다시 봐봐.」
ELSE
	SIF K17_GRT() >= K17C_思慕
		cEX = "If it were me, I would have saved the witch too"
	CALL K17_CHOICE("「그래서, 음, 어떻게 생각했어...?」","괜찮았다.","마음에 들었다.",cEX)
	SELECTCASE RESULT
		CASE 0
			;普通
			PRINTFORML 「음~ 그렇게 솔직한 건 드물지.」
			PRINTFORML 「내가 듣고 싶은 말만 해주는 것보다는 그게 더 좋으니 고마워.」
		CASE 1
			;よかった
			PRINTFORML 「음~ 정말로...?」
			PRINTFORML 「너 예상외로 유치한 면이 있네, 그렇지 않아? 후후.」
		CASE 2
			;魔女も助けた
			PRINTFORML 「Eh...」
			PRINTFORML 「음, 좀 예상치 못했네... 뭐라고 해야 할지 모르겠어...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 어떤 이유에선 얼굴을 붉히며 발밑을 내려다봤다.
			TFLAG:好感度ボーナス += 100
			CFLAG:K17C_ID:K17C_CF_上海好感度 = MIN(CFLAG:K17C_ID:K17C_CF_上海好感度 + 100,10000)
	ENDSELECT
ENDIF
RETURN 1
