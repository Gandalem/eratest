@M_KOJO_MESSAGE_COM_K17_604
;散策するにはTRAIN_MESSAGEが無い
CALL K17_SKIP_TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K17_604_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_604_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && FLAG:デート相手 == K17C_ID
	SIF FLAG:時間停止 || CFLAG:睡眠 || !CFLAG:同行 ;custom code
		RETURN 0
	;移動先の名称を取得
	LOCALS = %DATENAME_SPOT()%
	;二人の移動方式を選択
	IF !FIRSTTIME(@"311デート移動",1)
		;腕抱き経験済み
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그녀의 %K17_RS("breasts/chest")%를 당신의 팔에 밀착시키고 당신과 함께 %LOCALS%으로 걸어간다.
	ELSEIF !FIRSTTIME(603,1) || !FIRSTTIME(@"スキンシップ0",1)
		;手を繋ぐ経験済み
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 손을 잡고 %LOCALS%로 나란히 걸어간다.
	ELSE
		;まだやってない
		PRINTFORMDL 두 사람은 함께 %LOCALS%로 걸어간다.
	ENDIF
	;移動先がもう入ってるはず
	SELECTCASE CFLAG:MASTER:現在位置
		CASE 連れ込み宿, ラブホ ;custom code
			IF CFLAG:既成事実 & 合意_うふふ
				CALL HPH_PRINT,@"「...So %K17_RS("you want to...do it?/we're going to...do it...")%BPB」", "L"
			ELSE
				PRINTFORML (나는 결국... %HIM_HER(MASTER,,1)%와 여기에 오게 되었네... 그건, 우리가...)
				CALL HPH_PRINT,"「...BPB」", "L"
			ENDIF
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 격렬한 홍조와 함께 시선을 내리깐다.
		CASE 大図書館
			PRINTFORML 「%K17_RS("공부하기/읽기")%」를 할 생각이었어? 나도 여기 자주 와.
			;その他
		CASEELSE
			IF K17_PERCENT(40)
				SELECTCASE K17_GRT_EX()
					CASE IS >= K17C_思慕
						PRINTFORML 「%K17_RS("오호~ / 음? 오 / 아아")%, %K17_RS("저것/이것")% 쪽으로 가고 있는 건가...」
					CASEELSE
						PRINTFORML 「음... %K17_RS("그것/이것")% 쪽인가...」
				ENDSELECT
			ENDIF
	ENDSELECT
	PRINTW
ENDIF
RETURN 1
