;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;410,掃除
;通常処理
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !CFLAG:ブチギレ && TALENT:機嫌 != -1
	IF FIRSTTIME(@"{SELECTCOM}口上")
		;初回
		PRINTFORML 「청소, 하겠어. 같이 하자.」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 열정적으로 소매를 걷는다.
		PRINTFORML 「음 음음~♪」
		IF CFLAG:TARGET:初期位置 != CFLAG:MASTER:初期位置
			;同居してないときのみ
			PRINTW
			PRINTFORML 「아, %K17_CNAME()% 씨도 자기 방을 깨끗하게 정리하고 있나요?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 갑자기 당신에게 잔소리를 하기 시작한다.
			IF TALENT:MASTER:性別 == 2
				;男性
				PRINTFORML 「혼자 사는 사람에 대해 걱정하지 않을 수가 없네...」
			ELSE
				;女性
				PRINTFORML 「어쨌든 당신은 여자니까, 그렇게 되길 바랄게요.」
			ENDIF
			PRINTFORM 「자주 치우지 않으면 금세 모든 것이 엉망이 되어버린다...」
			TRYCALL K17_人形台詞(-1,1,K17_RS("Let's goー/Time to cleanー/Let's cleanー"))
		ENDIF
	ELSE
		;二回目以降
		PRINTFORM 「자, 청소하자.」
		TRYCALL K17_人形台詞(-1,1,K17_RS("Let's goー/Time to cleanー/Let's cleanー"))
	ENDIF
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 완전히 흥분해 있다...
	;ラッキースケベ 40%+幸運補正*10%+関係性*3%　全裸なら100%入る
	IF (K17_LUCKY_SUKEBE(40) && (EQUIP:スカート || EQUIP:ワンピース || EQUIP:着物) ) || (!TEQUIP:下半身着衣状況 && !TEQUIP:上半身着衣状況)
		;-------------
		;各種初期化
		;-------------
		iRT = K17_GRT_EX(TARGET)
		cPants = %PANTS_DESCRIPTION_TR(EQUIP:下半身下着２, TARGET)%
		SIF cPants == ""
			cPants = %FSYN("vagina")%가 노출되었다.
		PRINTW
		PRINTDATAL
			DATAFORM 「%K17_RS("Phew.../Mmmー/...There.")%」
			DATAFORM 「%K17_RS("Hmm hmmhmmー/Hmmhmm～/Hmm～")%...♪」
		ENDDATA
		IF TEQUIP:下半身着衣状況 || TEQUIP:上半身着衣状況
			;服あり
			PRINTFORMD 당신의 시선은 갑자기 %조사처리(CALLNAME:TARGET,"에게")% 향한다. 
			PRINTDATADL
				DATAFORM 그녀는 가슴골이 선명하게 드러난 채 청소하기 위해 몸을 숙였다.
				DATAFORM 움직일 때마다 그녀의 %OPPAI_DESCRIPTION_TR(TARGET,1)%가 출렁거린다.
				DATAFORM 그녀는 네 발로 기어 다니며 %K17_GET_CLOTHNAME_BOTTOM(TARGET)% 아래에 있는 %cPants%를 드러낸다.
				DATAFORM 그녀가 좁은 공간을 청소하기 위해 손을 뻗자, 그녀의 %HIP_TR(TARGET)%가 튀어나온다.
				DATAFORM 그녀는 청소를 하면서 %K17_GET_CLOTHNAME_BOTTOM(TARGET)%(치마/바지 등)를 말아 올렸고, 부드러운 허벅지가 드러난다.
				DATAFORM 그녀는 잠시 쉬면서 땀에 젖은 %K17_RS("underarms/neck/collarbones")%를 닦는다.
			ENDDATA
		ELSE
			;服なし
			PRINTFORMDL 그녀는 완전히 알몸으로 청소하며 당신을 크게 흥분시킨다.
		ENDIF
		;関係性みる
		SELECTCASE iRT
			CASE IS  >= K17C_恋慕
				;恋慕から
				CALL HPH_PRINT,@"「도대체 어디를 보고 있다고 생각하는 거야, 이 자식아... BPB 너는 %K17_RS(@" 변태/성욕 넘치는 작은 %PRINT_MALE("boy",MASTER)%")%야.」", "L"
				PRINTFORML 「나중에 받을 보상이란... 무슨 말인지 알겠다면.」
				PRINTFORMDL 당신은 새로운 활력으로 남은 작업을 끝내기 시작한다.
				PRINTFORMDL ...
				PRINTFORMDL ......
				PRINTFORMDW .........
				PRINTFORML 「후우, 수고했어, %K17_CNAME()%…… 자 그럼, 보상에 대해 말인데……」
				TRYCALL K17_甘やかし
			CASEELSE
				PRINTFORML 「...%K17_RS("Hmm?/Eh?/?")%」
				PRINTFORML (에... %HE_SHE(MASTER)%은 더러운 걸 생각하고 있는 건가...?)
				CALL HPH_PRINT,"「～～～～～BPB」", "L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 갑자기 시선을 내리며 얼굴이 진홍색으로 빛난다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
