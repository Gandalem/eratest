@M_KOJO_MESSAGE_COM_K17_313_1
;-------------------------------------------------
;313,胸愛撫
;時間停止、カウンターうふふ、睡眠以外
;各種初期化
;-------------------------------------------------
#DIM iRT		;EXでとって
#DIMS cAction,2	;感度による行動
#DIMS cReAction	;感度による反応
#DIM iBust		;胸の状態　服上からなら0 はだけ下着上なら1 生2
#DIM iFriends	;知り合いがいるか見る
#DIM iMOB		;他人がいるか見る
#DIM iExFlag	;追加条件フラグ
#DIM iAnger		;このコマンド選択で怒るかどうか
iRT = K17_GRT_EX()
iAnger = K17_CHECK_ANGER_COM(TARGET)
;DEBUGPRINTFORML 【M_KOJO_MESSAGE_COM_K17_313_1 関係性値({iRT})】
;-----------------
;喘ぎタイプ選択
;-----------------
CALL K17_SET_AUTO_PVOICE(iRT,K17C_部位B)
VARSET cAction
cReAction =
iBust = 0
iFriends = 0
iMOB = 0
iExFlag = 0
;他人もしくはモブがいるか見る　ついでに知り合いかどうかもみる
IF DATE_HITOGOMI(CFLAG:PLAYER:現在位置) || GET_TARGETNUM() > 1
	iMOB = 1
	iFriends = K17_GET_FRIENDS_TARGET(TARGET)
ENDIF
;追加条件式
;Ｂ感覚4以上＆思慕逢引以上
SIF ABL:Ｂ感覚 >= 4 && iRT >= K17C_思慕逢引 && BASE:ムード >= 500
	iExFlag = 1
;4未満なら　愛でカバー
SIF iRT >= K17C_恋慕 && BASE:ムード >= 500
	iExFlag = 2
;怒り付くようなら無理矢理に
SIF iAnger && iRT >= K17C_思慕逢引
	iExFlag = 2
;カウンター&脱ぎ条件
IF TCVAR:カウンター行動 == 27 && iExFlag && !iMOB && !FIRSTTIME(@"{SELECTCOM}口上",1)
	;通常カウンター優先
	IF TALENT:TARGET:バストサイズ >= 1
		cAction += @"당신은 %조사처리(CALLNAME:TARGET,"의")% 노출된 %OPPAI_DESCRIPTION_TR(TARGET,1)% 사이에 손을 넣었다. "
	ELSE
		cAction += @"당신은 %조사처리(CALLNAME:TARGET,"의")% 드러나고 위로 올라간 %OPPAI_DESCRIPTION_TR(TARGET,1)% 사이에 손을 넣었다. "
	ENDIF
	;カウンターあり優先
ELSEIF TCVAR:カウンター行動 == 27
	;谷間見せ　胸サイズ見る
	IF TALENT:TARGET:バストサイズ >= 1
		cAction += @"당신이 %조사처리(CALLNAME:TARGET,"의")% 가슴골에 손을 넣었다. "
	ELSE
		cAction += @"당신은 %조사처리(CALLNAME:TARGET,"의")% 볼륨 있는 가슴골에 손을 넣는다. "
	ENDIF
	;以下カウンターなし　脱ぎ条件
ELSEIF iExFlag && !iMOB && !FIRSTTIME(@"{SELECTCOM}口上",1)
	cAction = 당신은 %조사처리(CALLNAME:TARGET,"의")% 드러난 %OPPAI_DESCRIPTION_TR(TARGET,1)%%" "% 쪽으로 손을 움직인다.
	;はだけあり
ELSEIF !iMOB && !iFriends
	;TEQUIP:4 = 1
	cAction = 당신
	;服装チェック
	IF EQUIP:上半身上着１ || EQUIP:上半身上着２ || EQUIP:ワンピース || EQUIP:着物
		;上半身上着の検索
		IF EQUIP:着物
			cAction += @" %K17_RS("disrobe/put a hand into")% %CALLNAME:TARGET%'s %K17_GET_CLOTHNAME_TOP(TARGET)%"
		ELSEIF EQUIP:ワンピース == 1
			cAction += @" %K17_RS("undo the front of/put a hand into")% %CALLNAME:TARGET%'s %K17_GET_CLOTHNAME_TOP(TARGET)%"
		ELSE
			cAction += @" %조사처리(CALLNAME:TARGET,"의")% %K17_GET_CLOTHNAME_TOP(TARGET)%을 연다."
		ENDIF
	ENDIF
	cAction += "그녀를 잡으면서 "
	IF EQUIP:TARGET:上半身下着１ || EQUIP:TARGET:上半身下着２ || EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ
		cAction += @"그녀의 속옷을 통해 %OPPAI_DESCRIPTION_TR(TARGET,1)%이. "
		iBust = 1
	ELSEIF TEQUIP:上半身着衣状況 == 0
		;着てない
		cAction = 당신은 %조사처리(CALLNAME:TARGET,"의")% 드러난 %OPPAI_DESCRIPTION_TR(TARGET,1)%%" "% 쪽으로 손을 움직인다.
		iBust = 2
	ELSE
		;上着あり　下着なし
		SIF !(EQUIP:TARGET:上半身下着１ || EQUIP:TARGET:上半身下着２ || EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ)
			cAction += "맨살로, "
		cAction += @"노출된 %OPPAI_DESCRIPTION_TR(TARGET,1)% "
		iBust = 2
	ENDIF
	;はだけなし
ELSEIF iMOB || iFriends
	cAction = 너는 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET,1)%를 잡는다
	cAction += " "
	;服装チェック
	IF EQUIP:上半身上着１ || EQUIP:上半身上着２ || EQUIP:ワンピース
		;上半身上着の検索
		FOR i,GETNUM(EQUIP,"着物"),GETNUM(EQUIP,"上半身１"),-1
		IF EQUIP:TARGET:i
			cAction += @"그녀의 %CLOTHNAME(i,EQUIP:TARGET:i)% 위로 "
			BREAK
		ENDIF
		NEXT
	ENDIF
	iBust = 0
ENDIF
;感度別アクション
IF ABL:Ｂ感覚 <= 1
	cAction += "그리고 부드럽게 "
ELSEIF ABL:Ｂ感覚 <= 3
	cAction += "그리고 부드럽게 "
ELSE
	cAction += "그리고 단단하게 "
ENDIF
cAction += "그것들을 만져봐..."
;感度別リアクション
IF ABL:Ｂ感覚 <= 1
	cReAction = %조사처리(CALLNAME:TARGET,"가")% 간질거리며 몸을 꿈틀거린다.
ELSEIF ABL:Ｂ感覚 <= 4
	cReAction = %조사처리(CALLNAME:TARGET,"가")% 약간 거칠게 숨을 쉬기 시작한다.
ELSE
	cReAction = %조사처리(CALLNAME:TARGET,"는")% 행복한 표정으로 네가 원하는 대로 하게 해준다.
ENDIF
;-------------------------------------------------
;313,胸愛撫
;地の文開始
;-------------------------------------------------
PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 가슴 쪽으로 손을 뻗는다...
;-------------------------------------------------
;313,胸愛撫
;記入チェック（=0, 非表示、1, 表示）
;失敗　怒りが付く
LOCAL = 1
;-------------------------------------------------
IF LOCAL && ( iAnger || CFLAG:ブチギレ ) && !iExFlag
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 팔로 가슴을 재빨리 감싸며 당신의 손을 뿌리쳐 버린다.
	PRINTW
	PRINTFORM 「안 돼... 그만해...」
	TRYCALL K17_人形台詞(-1,1,K17_RS("Molester/Enemy of women/Pervert"))
