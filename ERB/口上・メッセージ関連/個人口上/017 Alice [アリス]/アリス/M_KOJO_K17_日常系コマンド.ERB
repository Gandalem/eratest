			RETURN 1
		ENDIF
		;経験UP
		EXP:K17C_ID:奉仕快楽経験++
		;初回
		IF FIRSTTIME(@"風呂スキンシップ1")
			PRINTFORML 「후우... 여기서 사람들이 서로 몸을 깨끗하게 해주는 게 관례인가 보네.」
