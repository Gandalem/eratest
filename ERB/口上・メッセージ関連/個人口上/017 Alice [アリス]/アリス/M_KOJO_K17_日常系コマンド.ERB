@M_KOJO_MESSAGE_COM_K17_615_1
#DIM iRT = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;615,お弁当を食べる
;失敗 or 技能不足
LOCAL = 1
;-------------------------------------------------
IF LOCAL && (TFLAG:193 == -1 || ABL:料理技能 < 2)
	IF FIRSTTIME(@"{SELECTCOM}口上-失敗")
		;初回
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 요리 맛은 뭐라고 해야 할까... 평범하다고밖에 못 하겠군, 구식이라고 하기엔 아쉽고, 뭔가 부족해.
		PRINTFORML 「혹시 입에 맞지 않았던 건가...?」
		PRINTFORML 「아아, 괜찮아. 솔직하게 말해도 돼.」
		PRINTFORMDL 그녀가 물었으니, %조사처리(CALLNAME:TARGET,"에게")% 진심을 담은 의견을 전한다.
		PRINTW
		PRINTFORML 「오랜 시간 나만을 위해 요리했기에... 다른 사람이 어떻게 생각할지는 전혀 고려하지 못했어요.」
		PRINTFORML 「아직 갈 길이 멀지만... 최선을 다할게요.」
	ELSE
		;二回目以降
		PRINTFORML 「음~, %K17_RS("아직 갈 길이 멀어/더 연습해야 해/다음엔 더 노력할게")%...」
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;615,お弁当を食べる
;成功 料理技能2以上
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 「...어때? 맛있어? 후후, %K17_RS("네가 먹는 모습이 귀여워/집에서 만든 음식을 먹이는 게 기분 좋아/빨리 먹을 필요가 없어")%.」
	iRT = K17_GRT_EX(TARGET)
	IF EXP:キス経験 && iRT >= K17C_恋慕告白 && K17_PERCENT(50) && !FIRSTTIME(@"{SELECTCOM}口上-成功",1)
		;二回目以降 かつ50%
		PRINTW
		CALL HPH_PRINT,"「아, 볼에 뭔가 붙어 있네―― 추우후」", "L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 갑자기 얼굴을 당신에게 가까이 가져다 대고 키스를 훔친다.
		PRINTFORMDL 당신의 입술이 벌어지자, %조사처리(CALLNAME:TARGET,"는")% 장난스럽게 혀를 내밀며 부끄러운 듯 당신을 흘긋 본다.
		PRINTW
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "내 뺨에 정말 무언가 붙어 있었을까...?"
		ELSE
			PRINTFORMDL 혹시 볼에 정말로 뭐가 붙어 있었는지 궁금해한다...
		ENDIF
		CALL HPH_PRINT,"「정말로...――음프흐ㅍ 아직 더 있어... 추우~ㅎㅍ 음므ㅎㅍ」", "L"
		;経験値
		CFLAG:K17C_ID:K17C_CF_FKアリス = MIN(CFLAG:K17C_ID:K17C_CF_FKアリス+1,10000)
		EXP:Ｍ経験 += 1
		EXP:MASTER:Ｍ経験 += 1
		CALL MUTUAL_KISS
	ELSEIF iRT >= K17C_恋慕
		PRINTW
		IF FIRSTTIME(@"{SELECTCOM}口上-成功")
			;初回
			PRINTFORML 「아, 늘 시도해 보고 싶었던 게 있어... 음, 여기...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 대나무젓가락으로 음식을 집어 당신에게 내밀며 얼굴을 붉히고 위를 올려다본다.
			PRINTFORML 「이거 정말 창피하니까 어서 입 벌려!」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 표정이 당혹감과 기대감이 뒤섞인 가운데, 그녀가 청하자 당신은 입을 연다.
			PRINTW
		ENDIF
		CALL HPH_PRINT,"「Come onHPH Say \"Ahhnnn\"～HPHHPH」", "L"
		PRINTFORML 「후훗, %K17_RS(@"작은 동물을 먹이는 기분이야/귀여운 아기 같아 보여/더 민망할 줄 알았는데 꽤 즐겁네")%.」
	ENDIF
ENDIF
RETURN 1
