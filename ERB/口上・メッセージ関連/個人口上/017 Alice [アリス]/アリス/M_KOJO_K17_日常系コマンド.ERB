;地の文開始
;-------------------------------------------------
PRINTFORMDL 당신은 %cB_Action:0%이 %조사처리(CALLNAME:TARGET,"의")% %cB_Action:1%을 향해 손을 뻗는다...
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;316,指挿入れ
;失敗　怒り付くやつ
LOCAL = 1
;-------------------------------------------------
IF LOCAL && iAnger
	;タイプの変更
	CALL K17_SET_AUTO_PVOICE(iRT,K17C_部位V,K17C_受け_無理矢理系)
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 손을 그녀의 \@ TEQUIP:下半身着衣状況 & 1 ? %K17_GET_SKIRT(TARGET)% # 가랑이 \@로 빠르게 움직여 당신을 멈춘다.
	PRINTW
	;描写変え
	;下着判定　あだめだこれ
	;IF TEQUIP:0 & 2
	IF K17_GET_CLOTHNAME_BOTTOM_UNDER(TARGET) != ""
		;下着あり
		cB_Action:1 = %cWet%과 %FSYN("vagina")%는 그녀의 %K17_GET_CLOTHNAME_BOTTOM_UNDER(TARGET)%를 옆으로 밀어내며,
	ELSE
		cB_Action:1 = 노출된 채로, %cWet% %FSYN("vagina")%
	ENDIF
	PRINTFORML 「%K17_AP_NUM(2)%너 너무 %K17_RS("rough/forceful")%... %K17_AP_NUM(3,1)%」
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 저항에 흥분한 너는 그녀의 %cB_Action:1%에 손가락을 강제로 밀어 넣고 휘젓는다.
	PRINTFORML 「꺄아! %K17_AP_NUM(2)%%K17_RS("Stop/No/Don't")%, %K17_AP_NUM(3,1)%」
	IF TALENT:処女
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 손가락을 막듯이 허벅지를 단단히 조인다.
	ELSEIF K17_ABL_RT_EX(iRT,K17C_部位V)
		;補正付き感覚数値が0以外
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 원치 않는데 즐거워하는 것 같다...
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;316,指挿入れ
;初回　EX前 人いるなど
LOCAL = 1
;-------------------------------------------------
IF LOCAL && (FIRSTTIME(@"{SELECTCOM}口上",1) || !iExFlag)
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 손길에 움찔하며, 그녀의 \@ TEQUIP:下半身着衣状況 & 1 ? %K17_GET_SKIRT(TARGET)% # 가슴 부위에 당신의 손을 얹는다 \@.
	PRINTW
	;人がいれば喘ぎタイプ変更
	IF iMOB
		CALL K17_SET_AUTO_PVOICE(iRT,K17C_部位V,K17C_受け_無理矢理系)
		cALICE = 지금은 안 된다
	ELSEIF TALENT:処女 != 0 &&  TALENT:処女 != -1
		CALL K17_SET_AUTO_PVOICE(iRT,K17C_部位V,K17C_受け_合意襲い系)
		cALICE = %K17_RS("rub/stroke")%의 음부를 건드리지 말아라.
	ELSEIF !TALENT:処女
		CALL K17_SET_AUTO_PVOICE(iRT,K17C_部位V,K17C_受け_合意襲い系)
		;感覚判定口上
		SELECTCASE ABL:Ｖ感覚
			CASE IS < 1
				cALICE = %K17_RS("That feels weird/That hurts a little")%
			CASE IS <= 4
				cALICE = 그렇게 네 손가락 움직이지 마.
