;-------------------------------------------------
;313,胸愛撫
;記入チェック（=0, 非表示、1, 表示）
;失敗　怒りが付く がEX条件満たしてる時　強引にレイプっぽく
LOCAL = 1
;-------------------------------------------------
IF LOCAL && ( iAnger || CFLAG:ブチギレ ) && iExFlag
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 팔로 가슴을 재빨리 감싸며 당신의 손을 막는다.
	PRINTW
