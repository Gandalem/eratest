;初回
LOCAL = 1
;-------------------------------------------------
IF LOCAL && FIRSTTIME(@"{SELECTCOM}口上")
	PRINTFORML 「들어가 볼까?」
	;custom code
	IF CFLAG:K17C_ID:1092
		PRINTFORMDL "일본식 디저트 가게에는 관심 없으신가요...?"
	ELSE
		PRINTFORMDL 그녀가 일본식 과자점에 관심이 없을까 궁금해한다면...
	ENDIF
	PRINTFORML 「전 전혀 그런 게 아니에요. 이 가게는 계속 눈여겨보고 있었는데 혼자 들어가는 게 좀 망설여져서 이번이 처음으로 들어가 보는 거예요.」
	PRINTFORML 「꽤 설레네요, 분명 재미있을 거예요.」
	PRINTFORMDL ...
	PRINTFORMDL ......
	PRINTFORMDL .........
	PRINTW
	PRINTFORML 「차의 쓴맛은 단것과 정말 잘 어울린다... 일본 과자도 맛있군.」
	PRINTFORMDL 가게가 %조사처리(CALLNAME:TARGET,"에게")% 마음에 들었던 것 같다.
	PRINTFORML 「%K17_CNAME()%」 고맙다... 다음에 여기 또 오고 싶네.
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;617,甘味処に誘う
;二回目以降
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALLF K17_RS("dango/manjuu/youkan/sweet bean mochi/daifuku/dumpling zenzai/fried mochi/chestnut zenzai","/",2)
	PRINTFORML 「오늘, 나는... 어쩌면 %RESULTS%일까... 아아, 하지만 %RESULTS:1%도 좋아 보이는걸...」
	PRINTFORMDL 행복하게 단 것을 고민하는 %조사처리(CALLNAME:TARGET,"의")% 모습이 (%K17_RS("reminds you of a little child/is unexpectedly cute")%)고 생각난다.
	CALL HPH_PRINT,"「아, 미안해. 너랑 여기 오면 내가 좀 너무 흥분해서 말이야 BPB」", "L"
	PRINTFORMDL 결국 그녀는 둘 다 주문해서 당신과 나누게 된다.
	PRINTFORMDL ...
	PRINTFORMDL ......
	PRINTFORMDL .........
	PRINTW
	IF TFLAG:193 >= 0
		;成功
		PRINTFORML 「그것은 %K17_RS("filling/fun/good")%였어, 고마워, %K17_CNAME()%…… 다음에 또 오자.」
		PRINTFORMDL 달콤한 것들이 %조사처리(CALLNAME:TARGET,"의")% 취향이었던 것 같아.
	ELSEIF TFLAG:193 == -1
		;失敗
		PRINTFORML 「에... 우리가 원했던 게 다 팔렸을 줄은 몰랐어... 다음에 다시 시도하자.」
		PRINTFORMDL 오늘 운이 없는 날인 것 같네...
	ENDIF
	RETURN 1
ENDIF
RETURN 1
