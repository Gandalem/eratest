@M_KOJO_MESSAGE_COM_K17_300_1_会話_酔い(ARG)
;-----------------
;泥酔処理　戻す
;-----------------
IF TCVAR:泥酔 && ARG >= K17C_恋慕
	PRINTFORML 「후우~ %K17_CNAME()%은(는) %K17_RS("shomethingg dirty/of asshaultingg me")%을 생각하고 있는 거 아냐ー」
	RETURN 1
ELSEIF TCVAR:泥酔
	PRINTDATAL
		DATAFORM 「...%K17_RS("Shanghaiii/Houraiii")%～ 너 엄청 커졌네」
		DATAFORM 「...%K17_RS("Mari...shaaa?/Mommm...?")%」
	ENDDATA
	RETURN 1
ENDIF
;-----------------
;通常処理
;-----------------
SELECTCASE K17_MAX_LIMIT_RAND(ARG,K17C_思慕,K17C_恋人)
	CASE IS >= K17C_恋人
		CALL HPH_PRINT,@"「후우우~~ %K17_CNAME(0,1)%~ 사랑해애애 흐읍~~ 에헤헤 브프ㅂ」", "L"
		CALL HPH_PRINT,"「나 정말 부드러워~ ...안녕, 보이지? 정말 부드럽잖아~」", "L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 당신에게 가슴을 비비기 시작한다.
		PRINTFORMDL ...그녀는 부드럽다!
	CASE IS >= K17C_恋慕
		CALL HPH_PRINT,"「여기 덥지 않아...? 그렇지 않아? HPH」", "L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 음란하게 그녀의 %K17_RS("cleavage/"+K17_GET_CLOTHNAME_TOP(TARGET,1)+"/collarbones")%를 드러내기 시작한다.
		PRINTFORMDL 당신은 필사적으로 그녀를 가리려고 애쓰기 시작한다...
	CASE IS >= K17C_思慕うふふ
		PRINTFORML 「...내가 취했을 때 뭘 할 계획이야, 흐음～?」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 취하고 초점이 풀린 시선에는 특유의 육감적인 매력이 있다...
	CASE IS >= K17C_思慕
		PRINTFORML 「...후우, 무슨 일이야~? 나를 그렇게 보고 있어...」
		PRINTFORMDL 뜨겁고 술에 취한 숨결이 %조사처리(CALLNAME:TARGET,"의")% 매혹적인 입술 사이로 새어 나왔다...
	CASEELSE
		PRINTFORML 「...미안해, 술을 잘 못 마시겠어... 좀 어지러워져서 그래.」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 비틀거리며 한숨을 내쉰다.
ENDSELECT
SIF ALCOHOL_FACE(TARGET) == "ほろ酔い"
	PRINTFORMDL 그녀가 술을 거의 마시지 않은 것으로 보아, %조사처리(CALLNAME:TARGET,"는")% 술에 그다지 익숙하지 않은 것 같다.
SIF ALCOHOL_FACE(TARGET) == "酔いどれ"
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 균형이 이미 불안정하다.
SIF ALCOHOL_FACE(TARGET) == "ぐでぐで"
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 완전히 취해있다.
RETURN 1
