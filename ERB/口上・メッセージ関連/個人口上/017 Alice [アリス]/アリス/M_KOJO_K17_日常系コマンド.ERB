	CALLF K17_RS("dango/manjuu/youkan/sweet bean mochi/daifuku/dumpling zenzai/fried mochi/chestnut zenzai","/",2)
	PRINTFORML 「Today, I'll have... Maybe the %RESULTS%... Ahh, but the %RESULTS:1% looks good too...」
	PRINTFORMDL The sight of %CALLNAME:TARGET% happily agonizing over the sweets %K17_RS("reminds you of a little child/is unexpectedly cute")%.
	CALL HPH_PRINT,"「Ah, sorry, it's just that when I come here with you, I get a little too excitedBPB」", "L"
	PRINTFORMDL In the end, she ends up ordering both and sharing it with you.
	PRINTFORMDL ...
	PRINTFORMDL ......
	PRINTFORMDL .........
	PRINTW
	IF TFLAG:193 >= 0
		;成功
		PRINTFORML 「That was %K17_RS("filling/fun/good")%, thank you, %K17_CNAME()%... Let's come again sometime.」
		PRINTFORMDL It seems the sweets were to %CALLNAME:TARGET%'s liking.
	ELSEIF TFLAG:193 == -1
		;失敗
		PRINTFORML 「Geh... I can't believe what we wanted was sold out... Let's try again another time.」
		PRINTFORMDL Looks like today's not your lucky day...
	ENDIF
	RETURN 1
ENDIF

RETURN 1
