;====================================================================================================
;603,手を繋ぐ
;====================================================================================================
@M_KOJO_MESSAGE_COM_K17_603
CALL M_KOJO_MESSAGE_COM_K17_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_603_1
#DIM DYNAMIC iRT = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	iRT = K17_GRT_EX(TARGET)
	;初回
	IF FIRSTTIME(SELECTCOM) || FIRSTTIME(@"スキンシップ0")
		PRINTFORML 「Nn... This is more embarrassing than I thought.」
		PRINTFORML 「I use my hands a lot for my work, like sewing and magic and doll manipulation, so I'm sure they're rough and unpleasant to touch...」
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "Not at all."
			PRINTFORMDL "On the contrary, when I think about how these hands can control those dolls so skillfully, it feels like I'm handling some priceless treasure."
		ELSE
			PRINTFORMDL You tell her you don't mind at all.
			PRINTFORMDL Rather, when you think about how these hands control those dolls so skillfully, you feel like you're handling some priceless treasure.
		ENDIF
		PRINTFORML 「F-Flattery won't get you anywhere... But thank you, %K17_CNAME()%.」
		PRINTFORMDL With a little blush, %CALLNAME:TARGET% grasps your hand tightly.
		CALLF FIRSTTIME(@"スキンシップ0")
		RETURN 1
	ENDIF
	
	;思慕あれば下限切り上げ
	iRT = K17_MAX_LIMIT_RAND(iRT,K17C_思慕,K17C_恋慕告白)
	;二回目以降
	SELECTCASE iRT
		CASE IS >= K17C_恋慕告白
			PRINTFORML 「Ahnn, come on, don't be shy～～ Shouldn't it be more like this?」
			PRINTFORMDL You intertwine your fingers with hers, but %CALLNAME:TARGET% latches onto your whole arm.
			PRINTFORML 「Today feels a little warm... Hmm? What's the matter?」
			PRINTFORMDL As %CALLNAME:TARGET% speaks, she constantly presses her chest tightly against your arm.
			PRINTFORML 「To think %K17_RS("you'd still blush like that/that still makes your heart race")%, after all this time... That's so adorable.」
		CASE IS >= K17C_思慕うふふ
			PRINTFORML 「Your hand feels %K17_RS("warm/a little cold")%.」
			PRINTFORML 「Do you like holding hands like this? ...Me too.」
		CASE IS >= K17C_思慕
			PRINTFORML 「Nn... This makes me feel a little %K17_RS("embarrassed/awkward/self-conscious")%.」
		CASE IS >= K17C_知り合い
			PRINTFORML 「Nn... Your hand is a little %K17_RS("cold/sweaty")%.」
			;男性で体型が普通以上　女性の場合体型が大きければ
			IF (TALENT:MASTER:性別 == 2 && TALENT:MASTER:体型 > -1) || (TALENT:MASTER:性別 & 1 && TALENT:MASTER:体型 > TALENT:TARGET:体型)
				PRINTFORML 「Mmmー, it definitely feels bigger than mine.」
			ELSEIF (TALENT:MASTER:性別 == 2 && TALENT:MASTER:体型 < -1) || (TALENT:MASTER:性別 & 1 && TALENT:MASTER:体型 < TALENT:TARGET:体型)
				PRINTFORML 「Mmmー, it's a little smaller and cuter than mine.」
			ELSE
				PRINTFORML 「Mmmー, looking at it up close like this, the shape and grooves are different from mine.」
			ENDIF
	ENDSELECT


ENDIF
RETURN 1

