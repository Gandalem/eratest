@K17_SHUFFLE_寝言(ARGS)
#FUNCTIONS
#DIMS DYNAMIC 寝言,3="...","...",
寝言:2= %ARGS%
FOR i,0,2
	r = RAND(i,3)
	SWAP 寝言:i,寝言:r
NEXT
RETURNF 寝言:0+寝言:1+寝言:2

;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;
;基本地の文の分岐に合わせて(もういっそコピペしちゃって)書く
;
;※※※※※※※※※※※※※※※※※※※※※※※※※
;====================================================================================================
;300,会話
;
;	現在の構成
;	会話→関係査定→話題ランダム→関係性別に口上表示
;			↓		↓
;			↓		場所・デート中の会話予定）
;		優先判定→関係性別に口上表示
;
;	話題を番号追加して関係性別に答えを書いていく
;	拾えたらRETURN 1なかったら0で返して再抽選
;====================================================================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K17_300
RETURN 1

@M_KOJO_MESSAGE_COM_K17_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます
IF CFLAG:行動 == 5 && !(DAY % 14) && TIME <= 720
	CALL K17_SKIP_TRAIN_MESSAGE
ELSE
	CALL TRAIN_MESSAGE
ENDIF
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K17_300_1
PRINTW
RETURN RESULT

@M_KOJO_MESSAGE_COM_K17_300_1
#DIM CONST 話題数 = 6	;最大話題数定義しとく
#DIM DYNAMIC iRTnum=0
#DIM DYNAMIC iRand=0
RESULT=0

;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:時間停止

	IF TFLAG:193 == -3 ;custom code, hate mark 3
		LOCAL:9 = CFLAG:TARGET:ブチギレ
		CFLAG:TARGET:ブチギレ = 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
		CFLAG:TARGET:ブチギレ = LOCAL:9
		RETURN
	ENDIF

	;関係性をセット
	iRTnum = K17_GRT_EX(TARGET)
	;DEBUGPRINTFORML 【M_KOJO_MESSAGE_COM_K17_300_1 iRTnum({iRTnum})】
	
	;------------優先判定するもの---------------------
	;-----------------------------
	;仕事中
	;-----------------------------
	IF CFLAG:行動 == 5
		;人形劇中
		IF CFLAG:職種 == JOB_会話
			IF TIME >= 720
				;後片付け
				PRINTFORM 「I'm sorry, I still need to finish this up...」
				TRYCALL K17_人形台詞(-1,1,K17_RS("Let's helpー/Good workー"))
			ELSE
				;公演中
				PRINTL
				TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇
			ENDIF
		;家事
		ELSE
			PRINTFORML 「I'm sorry, there are some errands I need to do around the house...」
		ENDIF
		RETURN 1
	ENDIF
	
	;-----------------------------
	;お友達認定フラグ保存
	;イベントフラグ持たせるのも微妙……ちゃんとしたの作るか
	;-----------------------------
	IF !CFLAG:K17C_ID:K17C_CF_お友達イベント
		IF ABL:親密 >= 5
			PRINTFORML 「Mmmー, it feels like we've been talking like this a lot lately...」
			PRINTFORML 「Well, as long as you're not up to anything funny, I suppose I can open up to you a little.」
			CFLAG:K17C_ID:K17C_CF_お友達イベント=1
			TRYCALL K17_RELATION_EV(K17C_RTF_お友達)
			RETURN 1
		ENDIF
	ENDIF
	
	;-----------------------------
	;パンツ罠 疑い50超えてたらベース50で判定
	;ほぼバレるはず
	;-----------------------------
	IF K17_CHECK_時間停止バレ(TARGET,50,50)
		CALL M_KOJO_MESSAGE_COM_K17_300_1_会話_時間停止バレ
		TFLAG:好感度マイナス = 2
		RETURN 1
	ENDIF
	;-----------------------------
	;人形劇見たその日の会話
	;-----------------------------
	IF TCVAR:K17C_ID:K17C_TC_人形劇
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇感想
		TCVAR:K17C_ID:K17C_TC_人形劇 = 0
		RETURN 1
	ENDIF
	
	;怒り状態
	IF CFLAG:TARGET:ブチギレ == 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_怒り
	;会話不能時
	ELSEIF (TCVAR:会話不能 || MARK:反発刻印 >= 3) && !TALENT:TARGET:恋慕
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_不能
	;酔い 60%で入る　泥酔なら必ず
	ELSEIF (BASE:17:酒気 >= 1 && K17_PERCENT(60)) || TCVAR:泥酔
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_酔い(iRTnum)
	;成功判定
	ELSEIF TFLAG:193 >= 1
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_成功(iRTnum)
	;失敗
	ELSEIF TFLAG:193 <= -1
		TRYCALL M_KOJO_MESSAGE_COM_K17_300_1_会話_失敗(iRTnum)
	ELSE
		RESULT=0
	ENDIF
	
	;--------------通常会話の話題ランダム-------------------
	;そのうち場所についても入れる予定
	;CFLAG:TARGET:デート中は行き先入っちゃうのでFLAG:デート相手==17で取るか
	;通常会話ランダム検索へ　仮置き
	i=0
	WHILE RESULT == 0
		iRand= RAND:話題数
		TRYCALLFORM M_KOJO_MESSAGE_COM_K17_300_1_話題_{iRand}(iRTnum)
		SIF RESULT
			BREAK
		IF i>=3
			iRTnum--
			i=0
		ENDIF
		SIF iRTnum<0
			BREAK
		i++
	WEND

ENDIF
RETURN 1

;*********************************************************
;会話	：人形劇
;会話不能でも優先的に選ばれる
;アリスが勝手に喋ってる感じ
;10時開演～12時終演 12時からは片付けの手伝いができる
;*********************************************************
@M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇

PRINTFORMDL You enjoy %CALLNAME:TARGET%'s puppet performance...
SIF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 8)
	PRINTW

;-------------------
;上海の好感度上げる
;-------------------
CFLAG:K17C_ID:K17C_CF_上海好感度 = MIN(CFLAG:K17C_ID:K17C_CF_上海好感度 + 10,10000)
;-------------------
;公演中
;公演時間で見る　30分ごとに4分割
;-------------------
SELECTCASE (720 - TIME) / 30
	CASE IS >= 3
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 1)
			PRINTFORML 「Everyone, thank you so much for coming today as well.」
			PRINTFORM 「Then, let's begin...」
			TRYCALL K17_人形台詞(K17C_上海,0,"Boys and girlsー")
			TRYCALL K17_人形台詞(K17C_蓬莱,1,"Gather 'roundー")
			PRINTW
			PRINTFORML 「I have a fun story for good children...and a very scaaary～ story for bad boys and girls...」
			PRINTFORML 「It's time for %CALLNAME:TARGET%'s puppet performance to begin～」
			PRINTFORMDL You hear the gathered children begin cheering.
			PRINTW
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 1
		ENDIF
		PRINTFORML 「A long, loonng～ time ago, there was once a kingdom that lived in fear of a bad, baaaad～ witch...」
		PRINTFORML 「The evil witch would suddenly appear and snatch children away to somewhere no one knew.」
		PRINTFORML 「Afraid of the evil witch, the people of the kingdom begged to their king to defeat the witch.」
		TRYCALL K17_人形台詞(K17C_上海,1,"Your majesty! Please defeat the evil witch!")
		PRINTFORML 「But the king turned a deaf ear to the pleas of his people.」
		PRINTFORML 「Finally, one day, the princess in the castle was also kidnapped...」
		TRYCALL K17_人形台詞(K17C_蓬莱,1,"Kyaaahー! Someone, please helpー!")
		
	CASE 2
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 2)
			PRINTFORML 「So at last, the king began to take action.」
			PRINTFORML 「He asked the bravest, most righteous warrior in all the land, the young knight Pino, to save the kingdom.」
			PRINTFORML 「Taking the hopes of all the people onto his shoulders, Pino was determined to defeat the evil witch and save the princess.」
			TRYCALL K17_人形台詞(K17C_上海,1,"Accursed witch! I will never forgive you!")
			PRINTW
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 2
		ENDIF
		PRINTFORML 「And so the young knight set off on a journey to save the princess...」
		TRYCALL K17_人形台詞(K17C_上海,1,"Princess! I am coming to save you.")
		
	CASE 1
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 4)
			PRINTFORML 「Pino had to overcome many hardships on his adventure.」
			PRINTFORML 「Once, he had to cross a forest of eternal Winter, never once blessed by Spring...」
			PRINTFORML 「Another time, he had to navigate a bamboo grove shrouded in eternal night.」
			PRINTFORML 「Battling onis in a cave, and meeting celestials on a mountain that reached the heavens... It was a grand adventure.」
			PRINTFORML 「And finally, the young knight found the evil witch.」
			TRYCALL K17_人形台詞(K17C_上海,1,"Witch! We finally meet!")
			PRINTW
			PRINTFORML 「The young knight Pino demanded that the witch return the princess, but the witch refused.」
			PRINTFORM 『Evil witch! I shall defeat you!』
			TRYCALL K17_人形台詞(K17C_上海,1,"It's time! Witch!")
			PRINTFORML 「And with that declaration, the knight and the witch began their fierce battle...」
			PRINTW
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 4
		ENDIF
		PRINTFORMDL The dolls clash together, sparks of light flying in all directions... You wonder if she's thrown in a pinch of magic.
		PRINTFORMDL Eventually, there is a small explosion and a puff of smoke.
		PRINTFORML 「After a long struggle, the evil witch is finally beaten.」
		PRINTW
		PRINTFORML 『Noooo～! You have defeated meee～!』
		TRYCALL K17_人形台詞(K17C_上海,0,"Princess! You're safe!")
		TRYCALL K17_人形台詞(K17C_蓬莱,1,"Thank you for saving me!")
		PRINTFORML 「And so the young knight successfully rescued the princess.」
	CASE 0
		IF !(TCVAR:K17C_ID:K17C_TC_人形劇 & 8)
			PRINTFORML 「When the young knight returned to the kingdom with the princess, he instantly became a hero.」
			PRINTFORML 「Afterwards, he married the princess, and the two of them settled down together...」
			TRYCALL K17_人形台詞(K17C_上海,0,"Princess, I will make you the happiest woman in all the land!")
			TRYCALL K17_人形台詞(K17C_蓬莱,1,"I will love you forever, Prince!")
			PRINTFORML 「And they lived happily ever after...」
			TCVAR:K17C_ID:K17C_TC_人形劇 |= 8
		ELSE
			PRINTFORMDL The puppet performance already appears to have ended, and %CALLNAME:TARGET% is surrounded by children.
			PRINTW
			PRINTFORML 「Boys and girls, always be good and listen to your parents.」
			PRINTFORML 「Otherwise, the evil witch will come and take you far away...」
		ENDIF
		
ENDSELECT

;custom code: reset these to prevent "out of topics" from turning the button orange
TCVAR:会話累計値 = 0
TCVAR:会話不能 = 0
RETURN 1

;*********************************************************
;会話	：人形劇感想
;会話不能でも優先的に選ばれる
;仕事終わり13時くらいか？からの人形劇を1度でも見ているときの会話
;*********************************************************
@M_KOJO_MESSAGE_COM_K17_300_1_会話_人形劇感想
#DIM DYNAMIC iFlagNum = 0
#DIMS DYNAMIC cEX=""
;何個見たか数える
FOR i,0,4
	SIF GETBIT(TCVAR:K17C_ID:K17C_TC_人形劇,i)
		iFlagNum ++
NEXT

PRINTFORM 「...Ah, so you saw the puppet performance... That's a little embarrassing.」
TRYCALL K17_人形台詞(-1,1,"How embarrassingー")
PRINTW

;適当に好感度うｐ
;読んだ数*10
TFLAG:好感度管理 += 10*iFlagNum

;見た数で判定
IF iFlagNum < 4
	;全部見られなかった
	PRINTFORML 「So, umm, what did you think...?」
	PRINTFORMDL %CALLNAME:TARGET% asks you for your opinion, but since you didn't catch the whole thing, you can only give a vague answer.
	PRINTFORML 「Hmmmー... Oh well, try and watch from the beginning next time.」
ELSE
	SIF K17_GRT() >= K17C_思慕
		cEX = "If it were me, I would have saved the witch too"
	CALL K17_CHOICE("「So, umm, what did you think...?」","It was okay","I liked it",cEX)
	SELECTCASE RESULT
		CASE 0
			;普通
			PRINTFORML 「Hmmー, that's pretty candid of you.」
			PRINTFORML 「I prefer that to just telling me what I want to hear, so thanks.」
		CASE 1
			;よかった
			PRINTFORML 「Mmmー, really...?」
			PRINTFORML 「You have an unexpectedly childish side, don't you? Fufu.」
		CASE 2
			;魔女も助けた
			PRINTFORML 「Eh...」
			PRINTFORML 「That's uh, rather unexpected... I'm not sure, what to say...」
			PRINTFORMDL %CALLNAME:TARGET% blushes for some reason and looks at her feet.
			TFLAG:好感度ボーナス += 100
			CFLAG:K17C_ID:K17C_CF_上海好感度 = MIN(CFLAG:K17C_ID:K17C_CF_上海好感度 + 100,10000)
	ENDSELECT
ENDIF
RETURN 1

;*********************************************************
;会話	：時間停止バレ
;疑い+50％でランダム　かつアリスのパンツを持っている場合のみ
;咲夜の場合100％バレ
;*********************************************************
@M_KOJO_MESSAGE_COM_K17_300_1_会話_時間停止バレ

PRINTFORML 「...Do you see these threads?」
PRINTFORMDL Saying this, %CALLNAME:TARGET% lifts up her fingers, where her magic thread is connected to the underwear you just stashed away...

SIF CFLAG:K17C_ID:K17C_CF_パンツ没収
	PRINTFORML 「This isn't the first time I've had my underwear stolen...」
PRINTFORML 「Looks like you were too careless... I was planning to let you off lightly if this is just a silly prank, but...」
PRINTFORML 「Would you mind telling me...just how you managed to do this?」
PRINTW
PRINTFORMDL Your stolen panties were confiscated.
PRINTFORMDL It looks like you'd best prepare for the worst.
PRINTL
PRINTFORMDW %CALLNAME:TARGET% has discovered your ability to stop time!
PRINTL
CALL K17_時間停止バレ

;後処理
SIF !CFLAG:弱み握り
	PRINTFORMDW %CALLNAME:TARGET% can use this to blackmail you.
CFLAG:TARGET:弱み握り += 5
VARSET PANTS_TEMP
FLAG:パンツ輸送 = 0
RETURN 1
;*********************************************************
;会話	：不能
;*********************************************************
@M_KOJO_MESSAGE_COM_K17_300_1_会話_不能
SELECTCASE RAND:3
	CASE 0
		PRINTFORM 「......」
		TRYCALL K17_人形台詞(K17C_上海,0)
		TRYCALL K17_人形台詞(K17C_蓬莱,1)
		PRINTFORMDL %CALLNAME:TARGET% is fidgeting idly with her dolls.
	CASE 1
		PRINTFORM 「...I'm bored.」
		TRYCALL K17_人形台詞(-1,1,"Boredー")
		PRINTFORMDL %CALLNAME:TARGET% mumbles something to herself.
	CASEELSE
		PRINTFORM 「……Fuu.」
		TRYCALL K17_人形台詞(-1,1,@"%K17_RS("Fuu/Alice")%ー")
		PRINTFORMDL %CALLNAME:TARGET% sighs quietly to herself.
ENDSELECT
RETURN 1
;*********************************************************
;会話	：酔い　泥酔
;参照	：BASE:17:酒気 
;引数	：RELATION_TYPE
;*********************************************************
@M_KOJO_MESSAGE_COM_K17_300_1_会話_酔い(ARG)


;-----------------
;泥酔処理　戻す
;-----------------
