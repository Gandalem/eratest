@K17_SHUFFLE_寝言(ARGS)
#FUNCTIONS
#DIMS DYNAMIC 寝言,3="...","...",
寝言:2= %ARGS%
FOR i,0,2
r = RAND(i,3)
SWAP 寝言:i,寝言:r
NEXT
RETURNF 寝言:0+寝言:1+寝言:2
