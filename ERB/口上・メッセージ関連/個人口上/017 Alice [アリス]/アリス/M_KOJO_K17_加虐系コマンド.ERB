;==================================================
;105,縄
;縄→拘束×
;拘束→縄○
;==================================================

@M_KOJO_MESSAGE_COM_K17_105
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL M_KOJO_MESSAGE_COM_K17_睡眠
ELSE
	CALL M_KOJO_MESSAGE_COM_K17_105_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_105_1
#DIM iType = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TEQUIP:縄 && !TEQUIP:拘束
		;縄が入った時　つまり装着した時タイプ一時保存
		iType = CFLAG:K17C_ID:K17C_CF_喘ぎタイプ
		CFLAG:K17C_CF_喘ぎタイプ = K17C_受け_合意襲い系
	ELSE
		;縄が入ってないでここ来た場合は外した時
		;拘束もなかったらタイプ戻す
		SIF !TEQUIP:拘束
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = iType
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初回　装着時
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上") && TEQUIP:縄
		PRINTFORML 「뭐... 나를 묶고 싶다고... 말도 안 돼, 난 절대 그렇게 동의하지 않아.」
		PRINTFORMDL 그녀는 그렇게 말하지만, %조사처리(CALLNAME:TARGET,"는")%(는) 별로 저항하는 것 같지 않다.
		PRINTFORML (결국 %HE_SHE(MASTER)%은 나를 묶고... 내 의지와 상관없이 %HIS_HER(MASTER)%이 나와 함께하기를 원하는 건가...)
		PRINTFORMDL 어찌 됐든, 당신은 %조사처리(CALLNAME:TARGET,"의")% 몸을 단단히 묶는다.
	ELSEIF TEQUIP:縄
		;装着二回目以降
		IF TEQUIP:拘束
			;拘束縄　無理矢理になる
			PRINTFORML 「나를 더 묶고 싶어하는 거야, 이미 해놓은 것 이상으로... 너 정말 대단한 %K17_RS("변태/괴물/야만인")%네!」
			PRINTFORML (나-나는... %K17_RS("폭행당할/침해당할")% 거야...)
		ELSE
			;縄のみ
			PRINTFORML 「말 안 하고 싶다고 했었나...?」
			PRINTFORML （%K17_RS("You're so into this sort of thing/I'm going to end up getting into this sort of thing too")%...）
		ENDIF
	ELSE
		;外した時
		IF TEQUIP:拘束
			;まだ拘束はあり
			PRINTFORML 「이 구속도 풀라고 했잖아...」
		ELSE
			PRINTFORML 「후우... 이제 정상적으로 하고 있는 거죠...?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
