;==================================================
;107,拘束プレイ
;==================================================
@M_KOJO_MESSAGE_COM_K17_107
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL M_KOJO_MESSAGE_COM_K17_睡眠
ELSE
	CALL M_KOJO_MESSAGE_COM_K17_107_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_107_1
#DIM iType = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	
	;-------------------------------------------------
	;タイプ保存
	;-------------------------------------------------
	IF TEQUIP:拘束
		;拘束のみが入った時　つまり装着した時タイプ一時保存
		iType = CFLAG:K17C_ID:K17C_CF_喘ぎタイプ
		CFLAG:K17C_CF_喘ぎタイプ = K17C_受け_無理矢理系
	ELSE
		;拘束が入ってないでここ来た場合は外した時
		;縄ありなら先に解除しないとこっちもできないみたい
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = iType
	ENDIF
	;-------------------------------------------------
	;泥酔先処理
	;-------------------------------------------------
	IF TCVAR:泥酔
		IF TEQUIP:拘束
			PRINTFORML 「I'm trapped～ Ahahaha～」
		ELSE
			PRINTFORML 「Hmmmー... You're letting me go...」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初回　装着時
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上") && TEQUIP:拘束
		PRINTFORML 「Wha... Restraints...? Wow, I really...can't move, at all...」
		PRINTFORMDL %CALLNAME:TARGET% obediently lets you put her body into restraints.
		PRINTFORML 「To think you were into this sort of thing... Pervert...」
		PRINTW
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "Well, if you really don't want to..."
		ELSE
			PRINTFORMDL Maybe she really doesn't want to...
		ENDIF
		PRINTFORML 「Kuh... Just do whatever you want, already...」
		PRINTFORML （I'm going to be...violated, and I won't be able to resist...）
	ELSEIF TEQUIP:拘束
		;無理矢理中出ししたことあるか見る
		IF CFLAG:無理矢理膣射
			PRINTFORML 「Fine, it's not like you'll listen, anyway... %K17_RS("Pervert/Weirdo/Savage")%!」
		ELSE
			PRINTFORML 「Restraints, again... Even if I refuse, you'll do it anyway... %K17_RS("Pervert/Weirdo/Savage")%!」
		ENDIF
		PRINTFORML （So %HE_SHE(MASTER)% wants to... %K17_RS(@"have %HIS_HER(MASTER)% way with me while I'm helpless/treat me like a tied-up doll")%...）
	ELSE
		;外した時
		PRINTFORML 「Phew... %K17_RS("Those restraints sure are tight./I'm finally free./Did you get cold feet?")%」
	ENDIF
ENDIF
RETURN 1

