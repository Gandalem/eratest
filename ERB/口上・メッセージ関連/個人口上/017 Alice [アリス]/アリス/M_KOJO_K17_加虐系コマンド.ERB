;==================================================
;105,縄
;縄→拘束×
;拘束→縄○
;==================================================
@M_KOJO_MESSAGE_COM_K17_105
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL M_KOJO_MESSAGE_COM_K17_睡眠
ELSE
	CALL M_KOJO_MESSAGE_COM_K17_105_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_105_1
#DIM iType = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	
	IF TEQUIP:縄 && !TEQUIP:拘束
		;縄が入った時　つまり装着した時タイプ一時保存
		iType = CFLAG:K17C_ID:K17C_CF_喘ぎタイプ
		CFLAG:K17C_CF_喘ぎタイプ = K17C_受け_合意襲い系
	ELSE
		;縄が入ってないでここ来た場合は外した時
		;拘束もなかったらタイプ戻す
		SIF !TEQUIP:拘束
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = iType
	ENDIF
	
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初回　装着時
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上") && TEQUIP:縄
		PRINTFORML 「Wha... You want to tie me up... That's absurd, I'd never agree to that.」
		PRINTFORMDL Or so she says, but %CALLNAME:TARGET% doesn't really seem to be resisting.
		PRINTFORML （So %HE_SHE(MASTER)% wants to tie me up...and have %HIS_HER(MASTER)% way with me...against my will...）
		PRINTFORMDL Either way, you bind %CALLNAME:TARGET%'s body tightly.
	ELSEIF TEQUIP:縄
		;装着二回目以降
		IF TEQUIP:拘束
			;拘束縄　無理矢理になる
			PRINTFORML 「You want to tie me up me further than you already have... You're such a %K17_RS("pervert/weirdo/savage")%!」
			PRINTFORML （I-I'm...going to be %K17_RS("assaulted/violated")%...）
		ELSE
			;縄のみ
			PRINTFORML 「I thought I said I didn't want to...?」
			PRINTFORML （%K17_RS("You're so into this sort of thing/I'm going to end up getting into this sort of thing too")%...）
		ENDIF
	ELSE
		;外した時
		IF TEQUIP:拘束
			;まだ拘束はあり
			PRINTFORML 「Undo these restraints too, already...」
		ELSE
			PRINTFORML 「Phew... We're doing it normally now, right...?」
		ENDIF
		
	ENDIF
	
ENDIF
RETURN 1

