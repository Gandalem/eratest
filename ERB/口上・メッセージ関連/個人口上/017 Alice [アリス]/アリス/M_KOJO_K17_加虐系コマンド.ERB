;==================================================
;107,拘束プレイ
;==================================================

@M_KOJO_MESSAGE_COM_K17_107
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL M_KOJO_MESSAGE_COM_K17_睡眠
ELSE
	CALL M_KOJO_MESSAGE_COM_K17_107_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_107_1
#DIM iType = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;タイプ保存
	;-------------------------------------------------
	IF TEQUIP:拘束
		;拘束のみが入った時　つまり装着した時タイプ一時保存
		iType = CFLAG:K17C_ID:K17C_CF_喘ぎタイプ
		CFLAG:K17C_CF_喘ぎタイプ = K17C_受け_無理矢理系
	ELSE
		;拘束が入ってないでここ来た場合は外した時
		;縄ありなら先に解除しないとこっちもできないみたい
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = iType
	ENDIF
	;-------------------------------------------------
	;泥酔先処理
	;-------------------------------------------------
	IF TCVAR:泥酔
		IF TEQUIP:拘束
			PRINTFORML 「나 갇혔어~ 아하하하~」
		ELSE
			PRINTFORML 「흠... 나를 놓아주는 거냐...」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初回　装着時
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上") && TEQUIP:拘束
		PRINTFORML 「뭐... 구속...? 와, 정말... 전혀 움직일 수가 없어...」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신이 그녀의 몸을 구속 장치 안에 넣도록 순순히 허락한다.
		PRINTFORML 「네가 이런 종류의 것에 관심이 있었다니... 변태 같아...」
		PRINTW
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "음, 정말로 원하지 않는다면..."
		ELSE
			PRINTFORMDL 어쩌면 그녀는 정말로 원하지 않는 걸지도 모르지...
		ENDIF
		PRINTFORML 「크윽... 네 마음대로 해버려도 상관없어, 이미...」
		PRINTFORML (나는... 침범당할 거고, 저항할 수 없을 거야...)
	ELSEIF TEQUIP:拘束
		;無理矢理中出ししたことあるか見る
		IF CFLAG:無理矢理膣射
			PRINTFORML 「좋아, 어차피 네가 들을 리 없잖아... %K17_RS("변태/이상한 놈/야만인")%!」
		ELSE
			PRINTFORML 「구속이라니, 또... 거부하더라도 결국 하게 될 거야... %K17_RS("변태/이상한 사람/야만인")%!」
		ENDIF
		PRINTFORML (그래서 %HE_SHE(MASTER)% 원한다... %K17_RS(@"have %HIS_HER(MASTER)% way with me while I'm helpless/treat me like a tied-up doll")%...)
	ELSE
		;外した時
		PRINTFORML 「휴... %K17_RS("Those restraints sure are tight./I'm finally free./Did you get cold feet?")%」
	ENDIF
ENDIF
RETURN 1
