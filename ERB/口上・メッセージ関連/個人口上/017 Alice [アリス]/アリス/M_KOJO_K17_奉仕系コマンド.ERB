@M_KOJO_MESSAGE_COM_K17_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_性技_胸)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && K17_GRT(TARGET) >= K17C_恋慕 && CFLAG:K17C_CF_喘ぎタイプ == K17C_受け_おねだり系 && FIRSTTIME(@"{SELECTCOM}口上",1)
		CALLF FIRSTTIME(@"{SELECTCOM}구상")
		;性別判定
		IF TALENT:MASTER:性別 == 2
			PRINTFORML 「내 가슴 사이에 넣어주길 원해...? 남자들이 이걸 좋아한다고 들었는데, 그렇지 않아?」
		ELSE
			;フタナリの女
			PRINTFORML 「가슴 사이에 넣어주길 원해...?」
		ENDIF
	ENDIF
	;二回目以降
	IF !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)
		;ねだり系
		;汎用　性技判定
		CALL K17_MESSAGE
		CALL K17_CLL_COUNTER_REACTIONMESSAGE
		;パイズリフェラの時喘ぎ箇所を変える
		IF TCVAR:カウンター行動の派生 == 4
			CALL K17_SET_AUTO_PVOICE(-1,K17C_部位M_フェラ)
		ELSE
			SELECTCASE ABL:TARGET:胸
				CASE IS < 2
					PRINTFORML 「%K17_SPLIT_SHUFFLE(@"%K17_RS("This is pretty hard/I'm not sure I'm doing this right")%...\\%K17_AP_NUM(2)%\\%K17_AP_NUM(1)%","\\")%%K17_AP_NUM(1,1)%」
				CASE IS  > 2
					PRINTFORML 「%K17_SPLIT_SHUFFLE(@"%K17_RS("This feels good/I've gotten better")%, right? ...\\%K17_AP_NUM(2)%\\%K17_AP_NUM(1)%","\\")%%K17_AP_NUM(1,1)%」
				CASEELSE
					PRINTFORML 「%K17_SPLIT_SHUFFLE(@"%K17_RS("I've gotten used to this/I've gotten a lot better at this")%...\\%K17_AP_NUM(2)%\\%K17_AP_NUM(1)%","\\")%%K17_AP_NUM(1,1)%」
			ENDSELECT
		ENDIF
	ELSE
		;襲い系
		PRINTFORMDL 당신은 %TINKO(PLAYER)%를 %조사처리(CALLNAME:TARGET,"의")% 가슴 사이에 넣고 골반을 흔들기 시작한다.
		;カウンター追加
		IF TCVAR:カウンター行動の派生
			PRINTFORMDL 동시에 당신은 %조사처리(CALLNAME:TARGET,"가")% 입을 벌리고 그것을 밀어 넣고 있다.
			CALL K17_SET_AUTO_PVOICE(-1,K17C_性技_舌)
			TCVAR:カウンター行動の派生 = 0
		ENDIF
	ENDIF
	PRINTFORML 「%K17_AUTO_PVOICE()%」
	PRINTW
	;汎用　感覚判定
	PRINTFORMDL %CALLNAME:TARGET%또한 즐기고 있는 것 같다 %K17_RS("stimulation/friction")% 당신의 %TINKO(PLAYER)% 그녀의 안쪽에서 %OPPAI_DESCRIPTION_TR(TARGET)%.
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_部位B)
	PRINTFORML 「%K17_AUTO_PVOICE()%」
ENDIF
RETURN 1
