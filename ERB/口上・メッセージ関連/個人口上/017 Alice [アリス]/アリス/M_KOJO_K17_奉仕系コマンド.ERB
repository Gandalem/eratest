;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K17_85
RETURN 1

@M_KOJO_MESSAGE_COM_K17_85
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL TRAIN_MESSAGE
	CALL M_KOJO_MESSAGE_COM_K17_睡眠愛撫
ELSE
	CALL K17_SET_KOJO_COLOR
	CALL M_KOJO_MESSAGE_COM_K17_85_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_85_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_性技_なし)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上",1) && K17_GRT() >= K17C_恋慕 && CFLAG:K17C_CF_喘ぎタイプ == K17C_受け_おねだり系
		PRINTFORML 「내 이 F-발로...? 그리고 당신의 곳에 비비는 건가... 음, 이렇게...?」
	ENDIF
	;ニーソあるか見とく
	IF EQUIP:靴下 == 2 || CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い
		IF EQUIP:靴下 == 2
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 다리를 잡고, 당신의 %TINKO(PLAYER)%를 그녀의 양말 사이에 넣은 뒤 골반을 움직이기 시작한다.
		ELSE
			PRINTFORMDL 너는 %조사처리(CALLNAME:TARGET,"의")% 다리를 잡고, 네 %TINKO(PLAYER)%를 그녀의 닫힌 다리 사이에 밀어 넣으며 골반을 움직이기 시작한다.
		ENDIF
		IF !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)
			;ねだり系
			PRINTFORML 「에, 에헤... %K17_RS("거기에 넣고 싶어/기분 좋아?")%...?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 부끄러운 표정으로 당신을 올려다본다.
		ELSE
			;襲い系
			PRINTFORML 「%K17_RS("Pervert/Dummy/Weirdo")%... Nn%K17_AP_DEC(1)%」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 부끄러워하며 자신의 %K17_RS("crotch/face")%를 숨기려 한다.
		ENDIF
	ELSEIF !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)
		;ねだり系
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 예민한 곳이 당신에게 스칠 때마다 그녀의 골반은 떨리고 다리는 활짝 벌린다.
				PRINTFORMDL 마치 무언가를 간청하는 것 같다...
				PRINTFORML 「다리 대신... 여기는 어때...? %K17_RS("당신을 원해/넣어줘/나와 사랑을 해줘")%...」
			CASE 1
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당황해서 다리를 오므리려 하자, 당신은 그것들을 잡아 활짝 벌린다.
				PRINTFORML 「야안... 이건, 정말 %K17_RS("indecent/shameful")%이야...」
				PRINTFORML (%HE_SHE(MASTER,1)%가 내 %K17_CALL_G(TARGET,1)%를 바라보고 있어... %HE_SHE(MASTER)%는 이걸로 흥분하고 있는 거야...?)
		ENDSELECT
		;汎用
		CALL K17_MESSAGE
		CALL K17_CLL_COUNTER_REACTIONMESSAGE
	ENDIF
	PRINTFORML 「%K17_AUTO_PVOICE()%」
ENDIF
RETURN 1
