@M_KOJO_MESSAGE_MESSAGECHECK_COM_K17_80
RETURN 1

@M_KOJO_MESSAGE_COM_K17_80
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL TRAIN_MESSAGE
	CALL M_KOJO_MESSAGE_COM_K17_睡眠愛撫
ELSE
	CALL K17_SET_KOJO_COLOR
	CALL M_KOJO_MESSAGE_COM_K17_80_1
	PRINTW
ENDIF
TCVAR:カウンター行動の派生 = 0
RETURN 1

@M_KOJO_MESSAGE_COM_K17_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_性技_指)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && K17_GRT(TARGET) >= K17C_恋慕 && CFLAG:K17C_CF_喘ぎタイプ == K17C_受け_おねだり系 && FIRSTTIME(@"{SELECTCOM}口上",1)
		PRINTFORML 「내 손으로... 좋아, 한번 해볼게... 하지만...」
		PRINTFORML 「...책에서 이런 걸 읽어봤는데, 이렇게 만지는 건 너무 역겹다고 생각했거든...」
		PRINTFORML 「하지만 네 것이라는 걸 생각하면, 그게...왠지 너무 사랑스럽게 느껴져...」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 %TINKO(PLAYER)%를 다정한 손길로 쓰다듬기 시작한다.
		PRINTW
		PRINTFORML 「...이렇게, 생각하는 건가...? ...음, 하아... 기분이 어때?」
		;通常あるけど一応
		IF ABL:指 >= 5
			CALL HPH_PRINT,"「흐읍 흐읍 흐윽...」", "L"
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 손가락은 믿을 수 없을 정도로 능숙하다...
			PRINTFORMDL 몸을 가로지르는 쾌감 때문에 골반에 힘을 유지하기 어렵다.
			PRINTW
			PRINTFORML 「에? 에헤? 이거 정말... 이렇게 좋은 거야?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 의심스러운 표정으로 당신에게 몸을 더 가까이 움직이며 묻는다.
			PRINTFORMDL 주의가 분산된 상태에서도 그녀의 손가락들은 복잡하고 매혹적인 패턴으로 계속 움직였다.
			PRINTFORML 「음... 내가 생각했던 것만큼 이것에 서툴지 않은지도 모르겠어...」
			PRINTW
			CALLF FIRSTTIME(@"{SELECTCOM}구상")
		ENDIF
		;汎用　性技判定
		CALL K17_MESSAGE
		CALL K17_CLL_COUNTER_REACTIONMESSAGE
	ELSE
		;二回目以降
		IF CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い
			;襲い系
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%/가 당신의 %TINKO(PLAYER)%를 움켜쥐고 손가락으로 그것을 만지기 시작한다.
			IF TCVAR:カウンター行動の派生
				PRINTFORMDL 당신이 %TINKO(PLAYER)%을 %조사처리(CALLNAME:TARGET,"의")% %FSYN("vagina")%에 대고 밀어붙이자, 그녀의 손가락에 몸을 비빈다...
				TCVAR:カウンター行動の派生 = 0
			ENDIF
		ELSE
			;合意系
			;汎用　性技判定
			CALL K17_MESSAGE
			CALL K17_CLL_COUNTER_REACTIONMESSAGE
		ENDIF
	ENDIF
	PRINTFORML 「%K17_AUTO_PVOICE()%」
ENDIF
RETURN 1
