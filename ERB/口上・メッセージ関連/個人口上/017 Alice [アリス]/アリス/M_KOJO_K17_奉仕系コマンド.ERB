@M_KOJO_MESSAGE_COM_K17_83_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_部位C)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && K17_GRT(TARGET) >= K17C_恋慕 && CFLAG:K17C_CF_喘ぎタイプ == K17C_受け_おねだり系 && FIRSTTIME(@"{SELECTCOM}口上",1)
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 허벅지 위에 걸터앉아 당신을 마주한다.
		IF !FIRSTTIME(@"311膝乗せ-恋慕",1)
			;日常コマンド　膝乗せ経験済み
			PRINTFORML 「이건, 아아으음%K17_AP_DEC()% 우리가 평소에 하던 것과 같은 거야... 어때?」
			PRINTFORMDL 서로 포옹할 때처럼 당신 위에 앉은 %조사처리(CALLNAME:TARGET,"는")% 천천히 골반을 움직여 당신의 민감한 부위들을 자극한다.
		ELSE
			;未経験
			PRINTFORML 「이거, 아아앙 %K17_AP_DEC()% 마치...정말로 하고 있는 것 같아ー」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신 위에서 머리를 망설이며 움직이기 시작했고, 두 곳의 민감한 부위를 자극했다.
		ENDIF
		CALLF FIRSTTIME(@"{SELECTCOM}구상")
		PRINTFORML 「%K17_AP_NUM(2)%나의 %K17_CALL_P(K17C_部位C)%느낌이 좋아 %K17_AP_NUM(3,1)%」
		PRINTFORML (마치 내가 사용하고 있는 것 같아 %K17_CNAME()%, 자위하는 데 사용하고 있어...))
		PRINTW
		PRINTFORMDL 당신은 잠시 엉덩이를 쉬며 약간 피곤함을 느끼지만, %조사처리(CALLNAME:TARGET,"는")% 향락에 미쳐 계속해서 그것을 흔든다.
		PRINTFORMDL 그녀가 그렇게 음란하게 행동하는 것을 보자, 당신은 입술을 %조사처리(CALLNAME:TARGET,"의")% 귀에 가져가 살짝 놀린다.
		PRINTFORML 「%K17_AP_NUM(2)%... 푸쉭? 아-아니, 그냥... 네가 기분 좋은지 걱정돼서 그래... 너 정말 못된 애야, 이 바보 같으니...」
		PRINTFORML 「같이 하자... 응? 우리가 이걸 함께 즐겨야 하니까...」
		PRINTW
		;汎用
		CALL K17_MESSAGE
		CALL K17_CLL_COUNTER_REACTIONMESSAGE
		PRINTFORML 「%K17_AUTO_PVOICE()%」
	ELSE
		;二回目以降
		IF !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)
			;ねだり系
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 너를 마주 보며 네 허리를 가로질러 앉는다.
			PRINTFORML 「%K17_RS("It feels good/I love this")%함께 하는 것, %K17_AP_DEC()% %K17_AP_NUM(2,1)%」
			;汎用
			CALL K17_MESSAGE
			CALL K17_CLL_COUNTER_REACTIONMESSAGE
			PRINTFORML 「%K17_AUTO_PVOICE()%」
		ELSE
			;襲い系
			PRINTFORMDL 당신은 그녀가 당신을 마주 보는 채 위에 %CALLNAME:TARGET%앉는다.
			PRINTFORML 「하지 마, 그렇게 비비지 마ー %K17_RS("Yahnn/No")%, %K17_AP_DEC()% %K17_AP_NUM(2,1)%」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 허리를 비틀어 벗어나려 하지만, 당신은 그녀를 아래로 누르고 반복해서 자신의 골반을 그녀의 골반에 문지른다.
			;追加
			SIF TCVAR:カウンター行動の派生
				PRINTFORMDL 그리고는 당신은 %조사처리(CALLNAME:TARGET,"의")% 양쪽 다리를 잡고 넓게 벌려 그녀의 은밀한 부분을 드러낸다.
			TCVAR:カウンター行動の派生 = 0
			PRINTFORML 「%K17_AUTO_PVOICE()%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
