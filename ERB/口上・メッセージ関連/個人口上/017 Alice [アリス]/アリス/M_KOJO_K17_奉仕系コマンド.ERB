@M_KOJO_MESSAGE_COM_K17_81_1
CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_部位M_フェラ)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;81,フェラチオ
;初回　ねだり系の通常時
LOCAL = 1
;-------------------------------------------------
IF LOCAL && K17_GRT(TARGET) >= K17C_恋慕 && CFLAG:K17C_CF_喘ぎタイプ == K17C_受け_おねだり系 && FIRSTTIME(@"{SELECTCOM}口上",1)
	PRINTFORML 「ㅁ-내 입으로...」
	PRINTFORMDL 손으로 당신의 %TINKO(PLAYER)%을 잡은 채, %조사처리(CALLNAME:TARGET,"는")% 그것을 가까이 자세히 들여다보기 시작한다.
	PRINTFORML 「이렇게 한 것을 내 입에 넣을 수 있을 거라고는 생각지도 못했는데, 하지만...」
	PRINTFORML (그것이 %K17_CNAME()%의 것이라고 생각하니... 놓지 않고 싶어진다...)
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신의 %TINKO(PLAYER)%을 커다란 눈으로 계속 응시하며 크게 삼키는 소리가 거의 들릴 정도였다.
	PRINTW
	PRINTFORMDL 긴 침묵 끝에 당신이 마침내 멈추자고 제안하지만, %조사처리(CALLNAME:TARGET,"는")% 고집스럽게 당신의 허리를 붙잡는다.
	PRINTFORML 「잠깐만! 내가 할 수 있어, 해볼게!...음흣.」
	PRINTFORMDL 그녀가 당신의 %TINKO(PLAYER)%를 입속에 밀어 넣는 기세에 안전을 걱정하게 되고, 본능적으로 물러나려 한다.
	PRINTFORML 「왜 그래, 지금 빠지려고 하지 마! 안 물 거야... 아마도...」
	PRINTFORMDL 당신의 %TINKO(PLAYER)%를 애무하는 동안, %조사처리(CALLNAME:TARGET,"는")% 마치 허락을 구하듯 당신을 올려다본다.
	PRINTW
	PRINTFORML 「제가 핥아도 되죠? 괜찮겠죠? 기분 좋게 해드릴 테니까...」
	PRINTFORMDL 당신이 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"는")% 이번에는 부드럽게 당신의 %TINKO(PLAYER)%를 받아들이기 위해 입을 벌렸다.
	PRINTFORML (%HE_SHE(MASTER,1)%가 괜찮다고 말했다...!)
	PRINTFORML (음... 냄새가 너무 강해서 어지러울 것 같아... 하지만 난... 좋아지고 있는 것 같아.)
	CALLF FIRSTTIME(@"{SELECTCOM}구상")
	PRINTW
	;汎用
	CALL K17_MESSAGE
	CALL K17_CLL_COUNTER_REACTIONMESSAGE
	PRINTFORML 「%K17_AUTO_PVOICE()%」
	SIF PALAM:潤滑 >= PALAMLV:2
		PRINTFORMDL 그녀가 당신을 섬기기 시작하자, %조사처리(CALLNAME:TARGET,"는")% 무언가를 원하는 듯 골반을 흔들기 시작했다...
	RETURN 1
ENDIF
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
;81,フェラチオ
;二回目以降　ねだり系　汎用
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)
	;汎用
	CALL K17_MESSAGE
	CALL K17_CLL_COUNTER_REACTIONMESSAGE
	PRINTFORML 「%K17_AUTO_PVOICE()%」
	;初回見たか見る
	IF !FIRSTTIME(@"{SELECTCOM}口上",1)
		;初回見たあと
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML (%HE_SHE(MASTER,1)% 너무 행복해 보인다... %K17_RS(@"Does %HE_SHE(MASTER)% like this that much/Is this that good/Does this feel that good")%?)
			CASE 1
				PRINTFORML (이것 때문에 나는... %K17_RS("다른 모든 것을 보지 못하게 된다/멈추고 싶지 않다/영원히 계속하고 싶을 뿐이다")%) ... )
		ENDSELECT
	ENDIF
	SIF PALAM:潤滑 >= PALAMLV:2
		PRINTFORMDL 그녀가 당신을 봉사하기 시작하자, %조사처리(CALLNAME:TARGET,"의")% 골반은 마치 무언가를 갈망하는 듯 %K17_RS("움직이기/앞뒤로 흔들기/초조하게 떨기")% 했다.
	RETURN 1
ENDIF
RETURN 1
