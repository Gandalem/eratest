SELECTCASE p
	CASE K17C_お友達
		IF ABL:K17C_ID:親密 >= 5
			cHINT:p += CALLNAME:K17C_ID+" would like to engage in a little conversation..."
		ELSE
			cHINT:p += CALLNAME:K17C_ID+@" 여전히 당신을 친구로 보지 않는다..."
		ENDIF
	CASE K17C_思慕
		IF (ABL:17:欲望 - ABL:K17C_ID:親密) >= 1
			;セフレルート
			cHINT:p += CALLNAME:K17C_ID+"'s body has yet to be fully developed..."
		ELSE
			;純愛ルート
			cHINT:p += CALLNAME:K17C_ID+@" 아직 당신에게 호감을 품은 것 같지 않다..."
		ENDIF
	CASE K17C_思慕キス
		cHINT:p += @"너는 키스조차 하지 않았어 "+CALLNAME:K17C_ID+" yet..."
	CASE K17C_思慕逢引
		cHINT:p += CALLNAME:K17C_ID+@" 데이트 중에 그녀의 말을 들어주길 바란다..."
	CASE K17C_思慕うふふ
		cHINT:p += CALLNAME:K17C_ID+@" 아직 당신과 성관계를 가질 것에 동의하지 않았습니다..."
	CASE K17C_恋慕
