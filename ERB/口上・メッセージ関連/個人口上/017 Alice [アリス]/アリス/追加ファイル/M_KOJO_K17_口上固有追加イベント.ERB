;*********************************************************************************
;	うふふ終了イベント
;	主導権が途中で変わることもあるので
;	押し倒しがどっちだったか関係なく終わった時の処理
;	合意取得のRTF保存などもここで一括処理する
;
;	引数0	：開始時の主導権　恐らく乱交でTARGETになってない時もあるので乱交時は別に返す
;	引数1	：開始時の溜まってる度
;*********************************************************************************

@K17_うふふ感想戦(ARG,ARG:1)
#DIM DYNAMIC iRT	= 0		;EXで取る方
#DIM DYNAMIC iReview = 0	;評価
#DIM DYNAMIC iFriends = 0	;友達保存
#DIM DYNAMIC iTNum = 0		;TARGET人数
iTNum = GET_TARGETNUM()
PRINTL
IF TCVAR:泥酔
	;泥酔時
	PRINTFORML 「어쩐지 그게 평소보다 더 사실적으로 느껴졌어...」
	PRINTFORML  (마치... 정말 섹스를 한 것 같아...)
	PRINTFORMDL 그녀의 기억은 여전히 흐릿했고, %조사처리(CALLNAME:TARGET,"는")% 방금 일어난 일이 꿈이었다고 생각하는 듯했다...
	RETURN 1
	;ELSEIF TCVAR:泥酔姦バレ
	;	;泥酔姦バレ　あっれーないや
	;	PRINTFORML 「……えっ……えっ……どういう……なんで！？」
ENDIF
;無理矢理フラグ見る
CALL K17_無理矢理中出し(TARGET)
SIF RESULT
	RETURN 1
;初回感想飛ばし
IF !(CFLAG:K17C_ID:K17C_CF_RTF & K17C_RTF_うふふ) && CFLAG:TARGET:既成事実 & 合意_うふふ
	;うふふ合意初回限定
	SELECTCASE K17_GRT()
		CASE IS >= K17C_恋慕
			PRINTFORML 「있잖아... 생각해보니 말이야...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%/는 얼굴을 당신의 귓가에 가까이 대고 속삭인다.
			PRINTFORML 「우리 계속 이렇게 하자, 점점 더 함께... 알겠지?」
			PRINTFORMDL 그러면서 %조사처리(CALLNAME:TARGET,"는")%/는 당신의 뺨에 키스하고 미소 짓는다.
			PRINTFORML (그리고 어쩌면 우리는... 더 음란한 것들을 할지도...)
		CASE IS >= K17C_思慕
			PRINTFORML 「저기, 음... %K17_CNAME()%, 이거... 다시 할래?」
			PRINTFORML 「이-이해했어요... 그럼 그렇게 하죠...」
			PRINTFORMDL 더 이상 말하지 않고, %조사처리(CALLNAME:TARGET,"는")% 시선을 아래로 떨구고 홍당무처럼 빨개진다.
			PRINTFORML (다음에는 좀 더 준비하고, 스스로를 더 보기 좋게 만들어야겠어...)
		CASEELSE
			PRINTFORML 「음... 끝난 건가...?」
			PRINTFORML (생각했던 것만큼 특별하지 않았다...)
	ENDSELECT
ELSE
	iRT = K17_GRT_EX(TARGET)
	IF (!(CFLAG:K17C_ID:K17C_CF_喘ぎタイプ & K17C_喘ぎF_攻め) && !(CFLAG:K17C_ID:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)) || CFLAG:K17C_ID:K17C_CF_喘ぎタイプ & K17C_喘ぎF_攻め
		;関係性別後戯　アリスはなんか優しそうな気がする（願望
		SELECTCASE K17_LOWER_LIMIT_RAND(iRT,K17C_思慕,K17C_恋慕)
			CASE IS >= K17C_恋慕
				CALL HPH_PRINT,"「음~ 추후프, 너한테 좋았어...?」", "L"
			CASE IS >= K17C_思慕
				CALL HPH_PRINT,"「음~후후... 그럼 정리하자...」", "L"
			CASEELSE
				PRINTFORML 「음... 끝난 것 같아...」
		ENDSELECT
	ELSE
		;受けの襲い系
		SELECTCASE K17_LOWER_LIMIT_RAND(iRT,K17C_思慕,K17C_恋慕)
			CASE IS >= K17C_恋慕
				CALL HPH_PRINT,@"「으음~~ 추우프... 나 침범당했어HPH 너는 %K17_RS("변태/짐승/대멍청이")%야.」", "L"
