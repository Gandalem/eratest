				CALL HPH_PRINT,@"「그들이 밀어붙이고 있나...? 응, 내가 너를 벽에 밀어붙이는 거야. 야안HPH 넌 움직일 수 없어 BPB」", "L"
				PRINTFORMDL 그녀의 %OPPAI_DESCRIPTION_TR(ARG,1)%를 잠시 느껴볼 수 있다.
			CASE IS >= 1
				PRINTFORMDL 그녀가 당신의 손을 잡는다.
				PRINTFORML 「살짝만 봐도 괜찮아...응?」
				PRINTFORMDL 시선을 돌려 눈을 질끈 감은 채, %CALLNAME:ARG%는 가슴을 가리고 있던 팔을 천천히 내린다.
				PRINTFORMDL 당신은 그녀의 %NIPPLE_DESCRIPTION(ARG,1)%를 언뜻 본다.
		ENDSELECT
		PRINTFORMD 마지막으로, 
	ENDIF
	PRINTFORMDL \@ iRand ? 너는 # 당신은 %K17_RS("뺨/이마/가슴/목")%에 키스를 느낀다. \@
	CALL HPH_PRINT,"「이건 우리의 비밀이야, 알겠지? BPB」", "L"
	CALL HPH_PRINT,"「좋아... 여기서 마무리하자 BPB」", "L"
	TIME += 10
	RETURN 2
	;-----------------------------
	;じっくり見たい　失敗
	;-----------------------------
ELSEIF RESULT == 1 && CFLAG:ARG:合意判定 <= 視姦必要値
	PRINTFORMDL 그 말을 듣자마자 %CALLNAME:ARG%의 몸을 타고 한 줄기 전율이 흐른다.
	PRINTFORML 「바보! 네 의도에 너무 치정적이야!」
	PRINTFORMDL 그녀가 당신을 때리려고 손을 드는 순간, 그녀의 %K17_RS("nipples/chest/crotch")%가 노출된다.
	PRINTFORML 「꺅ーー」
	PRINTFORMDL 그녀는 몸을 숨기려 다시 공처럼 말린다.
	PRINTFORML 「너-넌 최악이야...」
	SIF MARK:ARG:反発刻印 < 3
		MARK:ARG:反発刻印 ++
	TIME += 5
	RETURN 3
	;-----------------------------
	;じっくり見たい　成功
	;-----------------------------
ELSEIF RESULT == 1 && CFLAG:ARG:合意判定 > 視姦必要値
	IF ABL:ARG:露出癖 >=5
		iRand = RAND(0,6)
	ELSEIF ABL:ARG:露出癖
		iRand = RAND(0,ABL:ARG:露出癖+1)
	ENDIF
	;露出判定　恥じらいは持っておこう
	SELECTCASE iRand
		CASE IS >= 5
			PRINTFORML 「그냥 보는 걸 괜찮다고 말하는 건… 그게 네 계획의 일부야?」
			PRINTW
			PRINTFORMDL %CALLNAME:ARG%은(는) 자신의 가슴을 만지기 시작하며 당신에게 그것들을 보여준다.
			PRINTFORML (%HE_SHE(MASTER)%가 나를 그 %K17_RS("fixed/lewd/animalistic")% 눈빛으로 본다면... 나는 %K17_RS("excited/wet/aroused")%할 거야...)
			PRINTFORMDL 당신의 바로 밖에 머무르며, 그녀는 상기된 표정으로 몸을 위아래로 흔든다.
			PRINTFORMDL 그녀의 숨은 흥분으로 인해 약간 거칠다.
		CASE IS >= 3
			PRINTFORML 「오늘은 정말 볼 수만 있어... 알겠지?」
			PRINTW
			PRINTFORMDL 너는 팔로 %CALLNAME:ARG%의 가슴을 모아 당신이 볼 수 있도록 가슴골을 만든다.
			PRINTFORML (%K17_RS(@"Making %HIM_HER(MASTER,,1)% look at me lewdly like that/Teasing %HIM_HER(MASTER,,1)% like this/Making %HIM_HER(MASTER,,1)% wait like this")%...꽤 재미있네...
			PRINTFORMDL %CALLNAME:ARG%은 당신을 자극하려는 의도로 몇 가지 암시적인 포즈를 취한다.
			PRINTFORMDL 그녀의 숨소리가 흥분으로 인해 조금 거칠다.
		CASE IS >= 1
			CALL HPH_PRINT,"「이건 그저 내 감사를 표현하기 위해서야...BPB」", "L"
			PRINTW
			PRINTFORMDL 몸을 돌리고 눈을 질끈 감은 채, %CALLNAME:ARG%는 그녀의 가슴을 가리고 있던 팔을 천천히 내린다.
			PRINTFORML 「크윽... 쳐봐도 되는 곳만 봐... 알겠지?」
			PRINTFORMDL %CALLNAME:ARG%의 숨이 긴장으로 떨리고 있다.
		CASEELSE
			;これがやりたかっただけってはっきりわかんだね
			PRINTFORML 「알고 있었어... 이건 너무 창피하지만...」
			PRINTW
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 우물쭈물할 때, 당신은 그녀의 양 손목을 잡아 등 뒤 벽에 고정시킨다.
			PRINTFORML 「꺅! 잠깐만... 진심이야... 볼 수만 있어... 알았지?」
			PRINTFORMDL %CALLNAME:ARG%의 몸과 숨결이 불안함으로 떨리고 있다.
	ENDSELECT
	PRINTFORMDL 숨을 쉴 때마다 그녀의 %OPPAI_DESCRIPTION_TR(ARG,1)%가 위아래로 흔들린다.
	PRINTW
	PRINTFORMDL 아까 그녀가 숨기려 했던 %NIPPLE_DESCRIPTION(ARG,1)%이 이제는 온몸에 노출되어 있다.
	PRINTFORMDL 당신은 서로의 숨결을 느낄 정도로 그녀의 몸을 응시하고, %CALLNAME:ARG%는 간지러운 듯 몸을 비튼다.
	PRINTFORMDL 당신의 시선이 가슴에서 배꼽까지 내려가자, 그녀는 하체를 돌린다.
	PRINTFORMDL 그녀의 %HIP_TR(ARG)%를 자세히 들여다보니, 아까 바닥에 닿았던 부분이 붉게 물들어 있는 것을 깨닫는다.
	PRINTFORMDL 당신의 시선이 그녀의 나머지 몸을 모두 둘러본 후, 마침내 가장 중요한 부위에 머문다.
	PRINTW
	;	;長いカット　現在の状態（汚れや相手の性格など）を考えた描写する　そのうち
	;	PRINTW
	;	CALL HPH_PRINT,@"「%K17_RS("ひゃん/にゃん/やっん/あんっ")%BPB　ってちょっと！　触るっのは、だめぇんHPH」", "L"
	;	PRINTFORMDL 触診のつもりで優しく撫でたつもりだったが、%CALLNAME:ARG%は敏感に反応して声を上げていた
	;	CALL HPH_PRINT,"「触るのはっ、なしぃBPB」", "L"
	;	PRINTFORMDL それから一周してようやく表側に戻るが、%CALLNAME:ARG%が腰を引いてしまっていて肝心な部分がよく見えない
	;	PRINTFORMDL 尻を掴まれるのと自分で脚を開くのどちらがいいかと聞くと、観念したように%CALLNAME:ARG%自ら脚を少しだけ開いてみせた
	IF ABL:ARG:露出癖 >= 3
		CALL HPH_PRINT,"「...HPH」", "L"
		PRINTFORMDL %CALLNAME:ARG%은 가볍게 한숨을 쉬며 천천히 다리를 벌리고 앉는다.
		;くぱぁですねわかりますかね
		PRINTFORMDL 두 손가락을 사용해 그녀는 벌리며 %FSYN("labia")% 그리고 그녀의 전체 깊이를 드러낸다 %FSYN("vagina")%.
		PRINTFORMDL 그녀의 여성적인 구멍은 %K17_RS("glistening with moisture/wriggling as if inviting you inside")%.
	ELSE
		CALL HPH_PRINT,"「...BPB」", "L"
		PRINTFORMDL %CALLNAME:ARG%은(는) 당황하여 어색하게 허벅지를 비빈다...
		PRINTFORMDL 축축한 소리가 들리는 듯하다.
	ENDIF
	PRINTFORMDL 당신은 %CALLNAME:ARG%의 나체 몸을 충분히 감상하는 시간을 보낸다...
	PRINTW
	PRINTFORML 「그, 그게 다야, 이제...」
	;オナバレのコピペ　要精査
	CFLAG:ARG:好感度 += ABL:ARG:欲望 * CFLAG:ARG:溜まってる度 / 200 * ABL:ARG:露出癖
	;恥情を自慰中毒レベル準拠で上げるよ
	CALL JUEL_UP_SPECIAL(ARG,"恥情","自慰中毒",30,1)
	;欲情を自慰中毒準拠で上げるよ
	CALL JUEL_UP_SPECIAL(ARG,"欲情","自慰中毒",30,1)
	EXP:ARG:露出快楽経験 += CFLAG:ARG:溜まってる度 / 200 * ABL:ARG:露出癖
	PALAM:ARG:潤滑 += 1000
	;プライド下げ
	CALL K17_TALENT_UPDOWN(ARG,K17C_TALENT_プライド,-1)
	TIME += 30
	RETURN 4
ENDIF
