;*********************************************************************************
;		DATE_EVENTをコピペ、改造
;
;	この口上では本体の条件から外れても
;	M_KOJO_SPEVENT_K17_3　から　M_KOJO_SPEVENT_K17_1　M_KOJO_SPEVENT_K17_2　に入る
;
;	本体既存のDATE_EVENTにちょっと手入れ
;	SP_EVENT3、引数0(通常帰宅)の頭に入れて、イベント通過フラグ(CFLAG:17:1004,1005)で判定再度呼び出し
;	もうファーストキスキスした場合、イベントをキャンセルした場合などの救済
;	告白して恋人になるイベントもMASTERに恋人がいても発生（2人目の恋人になるとかはできない）
;	この判定に入るトリガーはTCVAR:17:351
;	完走判定はTCVAR:17:350
;	一日一回だけどちらかのイベントを完走できる、判定は何度でも
;
;	デートイベント全体の流れ
;	SPEVENT_K17_1判定(デートキス)→SPEVENT_K17_3(反発刻印消去)→SPEVENT_K17_2判定(告白)→
;	SPEVENT_K17_3(通常終了)→K17_DATE_EVENT_RELIEF(ここ)→SPEVENT_K17_3(通常終了の残り以降)
;
;	告白イベは元ファイルからCALLされてる以上逃れられないのでSPEVENT_K17_1内選択肢スキップ仕様
;	こちらから呼ばれてデートイベントへ戻った時は通常通り
;	大丈夫かこれかなり複雑になりすぎてる
;
;*********************************************************************************
;FileName_DATE_CMN.ERB ----------------------------- Rev1.01
;デート帰りイベント (CFLAG:13)
;CALL		USER
;ARG		キャラNO
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@K17_DATE_EVENT_RELIEF(ARG)
TCVAR:K17C_ID:キスキャンセル=0

VARSET LOCAL
;キャンセルフラグ（外部参照にて使用のこと 例:LOCAL@DATE_EVENT:99 = 1
;LOCAL:99 = 0
;パラメータによる発生基礎値生成

LOCAL = MARK:ARG:不埒刻印 * 10 + MARK:ARG:快楽刻印 * 10
IF TALENT:ARG:恋慕
	LOCAL += MIN(ABL:ARG:親密 * 10, 100) + MIN(ABL:ARG:欲望 * 10,100) + MIN(ABL:ARG:奉仕精神 * 10,100)
	LOCAL += MIN(EXP:ARG:デート経験,100) + MIN(EXP:ARG:愛情経験,100)
ELSEIF TALENT:ARG:思慕
	LOCAL += MIN(ABL:ARG:親密 * 10, 50) + MIN(ABL:ARG:欲望 * 10,50) + MIN(ABL:ARG:奉仕精神 * 10,50)
	LOCAL += MIN(EXP:ARG:デート経験,50)
ENDIF
LOCAL += GETPALAMLV(PALAM:ARG:欲情,10) * 5 + GETPALAMLV(PALAM:ARG:好意,10) * 5 + GETPALAMLV(PALAM:ARG:恭順,10) * 5
;60
LOCAL += BASE:ARG:ムード / 50 + (1000 - BASE:ARG:理性) / 30
LOCAL += TALENT:ARG:度胸 * 10 + TALENT:ARG:性的興味 * 10 - TALENT:ARG:自制心 * 10 - TALENT:ARG:無関心 * 10 

;この判定とキス関係除去
;合意無し（キス成功してない）
;ELSEIF !(CFLAG:ARG:1 & 1) && !(CFLAG:ARG:13 & 1)

;成功判定
IF (LOCAL > 220 + TALENT:ARG:一線越えない * 30 + TALENT:ARG:キス未経験 * 20) && CFLAG:ARG:合意判定 > 180 && (TALENT:ARG:思慕 || TALENT:ARG:恋慕) && !CFLAG:K17C_ID:K17C_CF_デートイベント
	CALL KOJO_MESSAGE_SEND("SP_EVENT",1,ARG,0)
	;キャンセルフラグ
	IF !TCVAR:ARG:キスキャンセル
		IF TALENT:MASTER:キス未経験
			CALL SET_FIRSTKISS(MASTER, ARG, 1)
			EXP:ARG:愛情経験 += 10
		ENDIF
		IF TALENT:ARG:キス未経験
			CALL SET_FIRSTKISS(ARG, MASTER, 1)
			EXP:ARG:キス経験 ++
			EXP:MASTER:キス経験 ++
		EXP:ARG:愛情経験 += 10
		ENDIF
		SETBIT CFLAG:ARG:既成事実 , 0
		SETBIT CFLAG:ARG:デート後イベントフラグ , 0
	ENDIF
	RETURN 1
;告白していない（MASTERに恋人が居ない）
;ELSEIF !(CFLAG:ARG:1 & 4) && !(CFLAG:ARG:13 & 2) && !TALENT:MASTER:恋人
;告白イベント	;成功判定
ELSEIF CFLAG:K17C_ID:K17C_CF_デートイベント && (LOCAL > 530 + TALENT:ARG:一線越えない * 20)

	CALL KOJO_MESSAGE_SEND("SP_EVENT",2,ARG,0)
	;恋人になる選択肢はこっちに　上のイベントでも判定しておく
	IF !(CFLAG:ARG:1 & 4) && !TALENT:MASTER:恋人
		PRINTFORML How do you respond to %CALLNAME:ARG%'s confession?
		PRINTFORM [1] - Accept
		PRINTFORML 　- You can only have {FLAG:追加恋人枠 + 1} lover\@FLAG:追加恋人枠?s#\@ -
		PRINTFORM [2] - Refuse
		$INPUT_LOOP
		INPUT
		IF RESULT > 2 || RESULT < 1
			CLEARLINE 1
			GOTO INPUT_LOOP
		ELSEIF RESULT == 1
			SETBIT CFLAG:ARG:既成事実 , 2
			SETBIT CFLAG:MASTER:既成事実, 2
			TALENT:MASTER:恋人 = NO:ARG
			TALENT:ARG:恋人 = 1
			SETBIT CFLAG:ARG:デート後イベントフラグ , 1
			CALL KOJO_MESSAGE_SEND("SP_EVENT",2,ARG,RESULT)
			PRINTL
			PRINTFORM You and %CALLNAME:ARG% are now 
			SETCOLOR C_PINK
			PRINT Lovers
			RESETCOLOR
			PRINTW !			
			RETURN 1
		ELSE
			CALL KOJO_MESSAGE_SEND("SP_EVENT",2,ARG,RESULT)
			RETURN 1
		ENDIF
	ENDIF

ELSEIF !MARK:ARG:反発刻印
	;改造前のこの地点に入ったものをもう一度ここで再評価する
	;ここで戻るので一回判定のみ一度外す
	;普通に失敗
	TCVAR:K17C_ID:K17C_TC_デートイベ判定=1
	RETURN 0
	;CALL KOJO_MESSAGE_SEND("SP_EVENT",3,ARG,0)
ENDIF
;反発ありで消し失敗
;フラグリセ
TCVAR:K17C_ID:K17C_TC_デートイベ判定=1
RETURN 0



;*********************************************************************************
;	素質の操作
;	
;	概要
;	口上内イベントで上下
;	書き換えフラグ忘れそうになるのでここで一括処理
;	素質に対して1～-1(素直 なし 反抗的　など)範囲で操作
;	今のところ対応してる番号
;	・プライド	13	K17C_TALENT_プライド	1プライド高い～0なし～プライド低い
;	・態度		11	K17C_TALENT_態度		1素直～0なし～-1反抗的
;
;	09/05	0の時の-2とか考えてオーバーフロー対策追記　色々考えすぎて汚い
;	09/08	LIMITにした←便利！
;
;	変数	：CFLAG:17:1001　口上全体で書き換えを行うかのフラグ　0、1で書き換え、-1でしない
;	引数0	：キャラID
;	変数1	：書き換える素質番号
;	変数2	：書き換える数値
;	戻り値	：書き換えたら1　書き換えなかったら0
;*********************************************************************************
@K17_TALENT_UPDOWN(ARG=K17C_ID,ARG:1,ARG:2)
VARSET LOCAL
;書き換えフラグ
SIF CFLAG:K17C_ID:K17C_CF_素質変化フラグ < 0 || ARG!=K17C_ID
	RETURN 0
;現在既に最高値なら返す	
SIF TALENT:ARG:(ARG:1) == -1 && ARG:2 < 0
	RETURN 0
SIF TALENT:ARG:(ARG:1) == 1 && ARG:2 > 0
	RETURN 0

;元の値を保存
LOCAL = TALENT:ARG:(ARG:1)

PRINTL
SELECTCASE ARG:1
	;プライド　1でも2でも失う⇔取り戻しでいいか
	CASE  K17C_TALENT_プライド
		LIMIT (TALENT:ARG:(ARG:1))+ARG:2,-1,1
		TALENT:ARG:(ARG:1) = RESULT
		;正負を見る
		IF ARG:2<0
			PRINTFORMD %CALLNAME:ARG% is no longer [Prideful]!
			
		ELSEIF ARG:2>0
			PRINTFORMD %CALLNAME:ARG% became [Prideful]!
		ENDIF
		
	;態度
	CASE K17C_TALENT_態度
		LIMIT (TALENT:ARG:(ARG:1))+ARG:2,-1,1
		TALENT:ARG:(ARG:1) = RESULT
		;下げる時
		IF ARG:2<0
			;反抗的→消滅
			SIF TALENT:ARG:(ARG:1) <= 0 && LOCAL==1
				PRINTFORMD %CALLNAME:ARG% is no longer [Defiant]!
			SIF !LINEISEMPTY()
				PRINTW
			;なし→素直
			SIF TALENT:ARG:(ARG:1) == -1 && LOCAL>=0
				PRINTFORMD %CALLNAME:ARG% became [Docile]!
		ELSEIF ARG:2>0
			;上げる時
			SIF TALENT:ARG:(ARG:1) >= 0 && LOCAL==-1
				PRINTFORMD %CALLNAME:ARG% is no longer [Docile]!
			SIF !LINEISEMPTY()
				PRINTW
			SIF TALENT:ARG:(ARG:1) == 1 && LOCAL!=1
				PRINTFORMD %CALLNAME:ARG% became [Defiant]!
		ENDIF
	;追加したらここへCASE作る
	CASEELSE
		PRINTFORMDL An unexpected talent (ID {ARG:1}) has been passed into K17_TALENT_UPDOWN.
		CALL HPH_PRINT,"「An error occurred, so report this, okay?HPH」", "L"
ENDSELECT
SIF !LINEISEMPTY()
	PRINTW
RETURN 1

;*********************************************************************************
;	ファーストキスイベント
;	初めてキスが呼ばれた時の口上をここに書いとく
;	経験に関係なくMASTER（プレイヤーから）能動的に意識ありで呼んだ用
;
;	09/05	微妙な場面なので名前呼びに固定
;
;	引数0	：キャラID
;	戻り値	：通過初回のみ1　二度目以降0
;*********************************************************************************
@K17_FIRSTKISS(ARG)

IF CFLAG:K17C_ID:K17C_CF_FKマスター
	CFLAG:K17C_ID:K17C_CF_FKマスター = MIN(CFLAG:K17C_ID:K17C_CF_FKマスター+1,10000)
	RETURN 0
ELSE
	SELECTCASE K17_GRT(ARG)
		CASE IS >= K17C_恋慕
			PRINTFORML 「You want to kiss?」
			CALL HPH_PRINT,"「Nnー... ChuuHPH」", "W"
			CALL HPH_PRINT,"「More... MmphHPH ...NnchuuHPH」", "L"
			CALL HPH_PRINT,"「Haa...HPH We finally...did thisHPH」", "L"
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "Did I make you wait...?"
			ELSE
				PRINTFORMDL Looks like you made her wait...
			ENDIF
			PRINTFORML 「It's fine now, don't worry about it.」
			PRINTFORML 「Let's do this a lot more from now on, okay?」
		CASE IS >= K17C_思慕
			IF ABL:ARG:親密 >= 7
				PRINTFORML 「You...want to kiss?」
				CALL HPH_PRINT,@"「Nn... %CALLNAME:MASTER%... ChuuHPH」", "W"
				PRINTFORML 「Ehe... Ehehe...」
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "I just suddenly felt the urge to do that, but was it okay...?"
				ELSE
					PRINTFORMDL You just suddenly felt the urge to do that, but was it okay...
				ENDIF
				CALL HPH_PRINT,"「Well, it...it was a little embarrassingBPB」", "L"
			ELSE
				PRINTFORML 「Eh? A k-kiss?」
				CALL HPH_PRINT,"「Ah...BPB」", "W"
				PRINTFORML 「Th-That was too sudden...」
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "I just suddenly felt the urge to do that, did you not like it...?"
				ELSE
					PRINTFORMDL You just suddenly felt the urge to do that, but maybe she didn't like it...
				ENDIF
				CALL HPH_PRINT,"「I'd been thinking of doing that someday, but not so suddenlyBPB」", "L"
			ENDIF
		CASE IS >= K17C_お友達
			PRINTFORML 「Eh, %K17_CNAME()%, so you...wanted to do this kind of thing...」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "I just did it without thinking, did you not like it...?"
			ELSE
				PRINTFORMDL You just did it without thinking, but maybe she didn't like it...
			ENDIF
			PRINTFORML 「...」
		CASEELSE
			PRINTFORMW 「Kuh...」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "I just did it without thinking, did you not like it...?"
			ELSE
				PRINTFORMDL You just did it without thinking, but maybe she didn't like it...
			ENDIF
			PRINTFORML 「...Jerk.」
			
	ENDSELECT
	
	
	
	;正真正銘ファーストキス
	
	IF K17_GRT(ARG)>=K17C_思慕 && !CFLAG:K17C_ID:K17C_CF_FK && !TALENT:ARG:キス未経験
		;思慕↑
		PRINTW
		;時間停止中のキスでキス経験上がっちゃうんだよねどうしよう
		;未経験は口上呼ばれる前に消えちゃう……未経験だったかとっとくか
		;今のところヤリマンでもキス未経験のままなので放置かな
		IF EXP:ARG:キス経験 == 1
			PRINTFORML 「That was...my first kiss.」
			PRINTFORMDL Despite her appearances, your kiss with %CALLNAME:TARGET% was surprisingly innocent and awkward.
			PRINTW
		ENDIF
		IF (EXP:MASTER:キス経験 == 1)
			PRINTFORML 「It was your first kiss, too?」
			PRINTFORML 「Oh...（I'm glad...）」
			PRINTFORMDL You feel you were able to connect your feelings with hers.
			PRINTW
		ENDIF
		
	ELSEIF !CFLAG:K17C_ID:K17C_CF_FK && (EXP:MASTER:キス経験 == 1)
		;知り合い程度
		PRINTW
		IF K17_GRT(ARG) >= K17C_お友達
			;仲良くなり始め
			PRINTFORML 「I wanted...my first kiss...to be more romantic.」
			PRINTFORMDL %CALLNAME:TARGET% seems rather dissatisfied.
			IF (EXP:MASTER:キス経験 == 1)
				PRINTFORML 「It was your first kiss, too?」
				IF TALENT:MASTER:性別 == 2
					PRINTFORML 「I see... Maybe men don't really think much of it...」
				ELSE
					PRINTFORML 「...You're rather casual about it, even though you're a woman...」
				ENDIF
			ENDIF
			SIF !CFLAG:K17C_ID:K17C_CF_デートイベント
				PRINTFORML 「So much for my plans...」
		ELSE
			;他人
			PRINTFORML 「...!」
			PRINTFORMDL Slap! Her hand comes flying across your cheek.
			SIF CFLAG:TARGET:弱み握られ
				PRINTFORML 「Even if you know my dark secrets, I'm not your doll...」
			PRINTFORMDL You can see tears pooling in %CALLNAME:TARGET%'s eyes...
			BASE:ARG:怒り += 1000
		ENDIF
	ENDIF
	
	;ムード評価
	IF K17_GRT(ARG) >= K17C_思慕
		SELECTCASE BASE:ARG:ムード
			CASE IS >= 750
				PRINTFORML 「The atmosphere was perfect...」
			CASE IS >= 500
				PRINTFORML 「The mood could've been a little better, though.」
			CASEELSE
				PRINTFORML 「But next time, think of the mood a little, okay?」
		ENDSELECT
	ENDIF
	
	
	
	;どっちからしたかを保存
	SIF CFLAG:K17C_ID:K17C_CF_FK == 0
		CFLAG:K17C_ID:K17C_CF_FK = -1
	
	CFLAG:K17C_ID:K17C_CF_FKマスター++
	TRYCALL K17_RELATION_EV( K17C_RTF_キス )
	RETURN 1
ENDIF

RETURN 0

;*********************************************************************************
;	ファーストキス（アリス）イベント
;	呼ぼ出しがM_KOJO_SPEVENT_K17_1、カウンターコマンドとあるので
;	初めてキスが呼ばれた時の口上をここに書いとく
;	経験に関係なくアリスから初めてした時用
;
;	09/05	微妙な場面なので名前呼びに固定
;
;	引数0	：キャラID
;	戻り値	：通過初回のみ1　二度目以降0
;*********************************************************************************
@K17_FIRSTKISS_ALICE(ARG)

IF CFLAG:K17C_ID:K17C_CF_FKアリス
	CFLAG:K17C_ID:K17C_CF_FKアリス = MIN(CFLAG:K17C_ID:K17C_CF_FKアリス+1,10000)
	RETURN 0
ELSE
	SELECTCASE K17_GRT(ARG)
		CASE IS >= K17C_恋慕
			PRINTFORML 「I love you...」
			CALL HPH_PRINT,"「Let's kiss, shall we? Nnn... ChuuHPH」", "L"
			PRINTFORMDL You accept %CALLNAME:TARGET%'s kiss...
			PRINTFORML 「Fufu, that's the first kiss from me, isn't it?」
		CASE IS >= K17C_思慕
			CALL HPH_PRINT,"「I like you... ChuuHPH」", "L"
			PRINTFORMDL %CALLNAME:TARGET% kisses you unexpectedly...
			PRINTFORML 「That's the first kiss from me, isn't it?」
		CASEELSE
			PRINTFORML 「Chuu.」
			PRINTFORMDL %CALLNAME:TARGET% kisses you unexpectedly...
			PRINTFORML 「Getting me to kiss you... Just what kind of sneaky magic did you use?」
	ENDSELECT
	
	;正真正銘ファーストキス思慕以上
	IF K17_GRT(ARG)>=K17C_思慕 && !CFLAG:K17C_ID:K17C_CF_FK && !TALENT:ARG:キス未経験
		;コマンド呼び出し用　M_KOJO_SPEVENT_K17_1は別途用意
		IF EXP:MASTER:キス経験 == 1
			PRINTFORML 「Looks like I took your first kiss.」
			PRINTFORML 「I'm glad you were my first kiss, too...」
			PRINTFORMDL You feel like you were able to convey your emotions for each other.
			
		ELSE
			PRINTFORML 「That was my first kiss.」
			PRINTFORMDL Despite her appearances, %CALLNAME:TARGET%'s kiss was a bit awkward.
		ENDIF
	ENDIF
	
	
	
	;どっちからしたかを保存
	SIF CFLAG:K17C_ID:K17C_CF_FK == 0
		CFLAG:K17C_ID:K17C_CF_FK = 1
	
	CFLAG:K17C_ID:K17C_CF_FKアリス++
	TRYCALL K17_RELATION_EV( K17C_RTF_キス )
	RETURN 1
ENDIF

RETURN 0

;*********************************************************************************
;	時間停止バレの条件式
;
;	ちょっと複雑になったので新設
;	あくまでこのアリスの口上のみの条件式
;
;	引数0	：キャラID 一応いれてアリス以外かみとく
;	引数1	：ランダム基本値
;	引数2	：疑い閾値
;	戻り値	：真偽
;*********************************************************************************
@K17_CHECK_時間停止バレ(iID=K17C_ID,iRand_Base=20,iDoubt_Base=0)
#FUNCTION
#DIM iID
#DIM iRand_Base
#DIM iDoubt_Base

;キャラIDチェック
SIF iID != K17C_ID
	RETURNF 0
;すでにバレてるか
SIF CFLAG:iID:時間停止バレ == 1
	RETURNF 0
SIF FLAG:なりきり == K17C_咲夜ID
	RETURNF 1
;あげたものか見る
SIF CFLAG:iID:ノーパン == 2
	RETURNF 0
;疑い50以上か見る
SIF CFLAG:iID:K17C_CF_疑い < iDoubt_Base
	RETURNF 0
;アリスのパンツあるか見る
SIF !K17_CHECK_輸送パンツ(iID)
	RETURNF 0
;ランダム通過
SIF !(K17_PERCENT(iRand_Base + CFLAG:iID:K17C_CF_疑い))
	RETURNF 0
	

RETURNF 1


;*********************************************************************************
;	MASTERの時間停止バレ時のテキスト
;
;	引数0	：キャラID
;	戻り値	：疑い0で1　疑いありで2
;*********************************************************************************
@K17_時間停止バレ(ARG=K17C_ID)
#DIM DYNAMIC iDown_好感度=0
#DIM DYNAMIC iDown_信頼度=0
RESULT = 0
IF CFLAG:ARG:K17C_CF_疑い == 0
	PRINTFORML 「Fuu... Having such an ability, yet doing such fairy-like pranks.」
	PRINTFORML 「Don't you understand that you're just squandering your talent?」
	PRINTFORML 「The only other person I know that has such an incredible ability is %K17_CNAME(K17C_咲夜ID)%.」
	PRINTFORMDW Blah blah...
	PRINTFORMDW ...Nag nag...
	PRINTFORMDW ...Blah blah... Nag nag...
	PRINTFORMDW You reconsider your life choices a little...!
	RESULT = 1
ELSE
	;疑い中
	PRINTFORML 「...So you've been behind all this recent mischief with my body...」
