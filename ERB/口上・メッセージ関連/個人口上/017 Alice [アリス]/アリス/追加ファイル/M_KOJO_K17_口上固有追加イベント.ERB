	SIF TCVAR:K17C_ID:K17C_TC_中出しカウント > 1 && !CFLAG:妊娠自覚状態
		PRINTFORML (%HE_SHE(MASTER,1)%은/는) %K17_RS("come inside me/shoot it inside me/seed me")% %NUM_ADVERB(TCVAR:K17C_ID:K17C_TC_中出しカウント)%... 했다.
	;解禁具合セレクト
	SELECTCASE RAND(0,(CFLAG:K17C_ID:生解禁)+1)
		CASE 0
			PRINTFORML (어쩌면 %K17_RS(@"being filled up/doing it raw/letting %HIM_HER(MASTER)% cum inside me")% 그렇게 느끼는 게 더 나을지도 모르지...?)
		CASE 1
			PRINTFORML (내가 궁금해한다면 %HE_SHE(MASTER)% 원하는지 %K17_RS("fertilize/impregnate/make a baby with")% 나를 원할지?)
		CASE 2
			PRINTFORML (%K17_RS("임신했어/아기를 가졌어")%라면?) 궁금해하다...
	ENDSELECT
ENDIF
