; Modular ERB: 個人口上/017 Alice [アリス]/アリス/追加ファイル/M_KOJO_K17_口上固有追加イベント.ERB
;*********************************************************************************
;
;
;	K17口上内で使うイベント系関数群
;
;	□目次	^[ \t]*(@)	でアウトライン絞込
;
;K17_DATE_EVENT_RELIEF			デートイベント再判定用
;K17_TALENT_UPDOWN				素質の操作
;K17_FIRSTKISS					ファーストキス-MASTER用
;K17_FIRSTKISS_ALICE			ファーストキス-アリス用
;K17_CHECK_時間停止バレ			時間停止バレの条件式
;K17_時間停止バレ				MASTERの時間停止バレ時のテキスト
;K17_乱交開始					各所の乱交開始テキストを合体
;K17_押し倒し喘ぎタイプ選択		押し倒し時のタイプ選択
;K17_処女喪失					処女喪失した時のイベント
;K17_うふふ感想戦				うふふの終了時のイベント
;K17_無理矢理中出し				ガチレイプ時
;K17_RELATION_EV				関係性が進んだ時に呼ぶ用　ヒント表示あり
;K17_RELATION_ANNOUNCE			RELATION_EVが呼ばれた時に実際表示する用
;K17_HINT						ヒントの表示
;K17_お風呂イベント				他でも使えるようにちょっと手入れしたい
;K17_上海イベント				おまけ
;K17_オナバレ追加イベント		オナバレイベントの追加拡張イベント
;K17_ONABARE					本体のものを改造したもの　同居自慰で使う
;K17_NASIKUZUSI					同上
;
;*********************************************************************************
;*********************************************************************************
;		DATE_EVENTをコピペ、改造
;
;	この口上では本体の条件から外れても
;	M_KOJO_SPEVENT_K17_3　から　M_KOJO_SPEVENT_K17_1　M_KOJO_SPEVENT_K17_2　に入る
;
;	本体既存のDATE_EVENTにちょっと手入れ
;	SP_EVENT3、引数0(通常帰宅)の頭に入れて、イベント通過フラグ(CFLAG:17:1004,1005)で判定再度呼び出し
;	もうファーストキスキスした場合、イベントをキャンセルした場合などの救済
;	告白して恋人になるイベントもMASTERに恋人がいても発生（2人目の恋人になるとかはできない）
;	この判定に入るトリガーはTCVAR:17:351
;	完走判定はTCVAR:17:350
;	一日一回だけどちらかのイベントを完走できる、判定は何度でも
;
;	デートイベント全体の流れ
;	SPEVENT_K17_1判定(デートキス)→SPEVENT_K17_3(反発刻印消去)→SPEVENT_K17_2判定(告白)→
;	SPEVENT_K17_3(通常終了)→K17_DATE_EVENT_RELIEF(ここ)→SPEVENT_K17_3(通常終了の残り以降)
;
;	告白イベは元ファイルからCALLされてる以上逃れられないのでSPEVENT_K17_1内選択肢スキップ仕様
;	こちらから呼ばれてデートイベントへ戻った時は通常通り
;	大丈夫かこれかなり複雑になりすぎてる
;
;*********************************************************************************
;FileName_DATE_CMN.ERB ----------------------------- Rev1.01
;デート帰りイベント (CFLAG:13)
;CALL		USER
;ARG		キャラNO
;RETURN		VOID
;COMMENT
;-----------------------------------------------------------

@K17_DATE_EVENT_RELIEF(ARG)
TCVAR:K17C_ID:キスキャンセル=0
VARSET LOCAL
;キャンセルフラグ（外部参照にて使用のこと 例:LOCAL@DATE_EVENT:99 = 1
;LOCAL:99 = 0
;パラメータによる発生基礎値生成
LOCAL = MARK:ARG:不埒刻印 * 10 + MARK:ARG:快楽刻印 * 10
IF TALENT:ARG:恋慕
	LOCAL += MIN(ABL:ARG:親密 * 10, 100) + MIN(ABL:ARG:欲望 * 10,100) + MIN(ABL:ARG:奉仕精神 * 10,100)
	LOCAL += MIN(EXP:ARG:デート経験,100) + MIN(EXP:ARG:愛情経験,100)
ELSEIF TALENT:ARG:思慕
	LOCAL += MIN(ABL:ARG:親密 * 10, 50) + MIN(ABL:ARG:欲望 * 10,50) + MIN(ABL:ARG:奉仕精神 * 10,50)
	LOCAL += MIN(EXP:ARG:デート経験,50)
ENDIF
LOCAL += GETPALAMLV(PALAM:ARG:欲情,10) * 5 + GETPALAMLV(PALAM:ARG:好意,10) * 5 + GETPALAMLV(PALAM:ARG:恭順,10) * 5
;60
LOCAL += BASE:ARG:ムード / 50 + (1000 - BASE:ARG:理性) / 30
LOCAL += TALENT:ARG:度胸 * 10 + TALENT:ARG:性的興味 * 10 - TALENT:ARG:自制心 * 10 - TALENT:ARG:無関心 * 10
;この判定とキス関係除去
;合意無し（キス成功してない）
;ELSEIF !(CFLAG:ARG:1 & 1) && !(CFLAG:ARG:13 & 1)
;成功判定
IF (LOCAL > 220 + TALENT:ARG:一線越えない * 30 + TALENT:ARG:キス未経験 * 20) && CFLAG:ARG:合意判定 > 180 && (TALENT:ARG:思慕 || TALENT:ARG:恋慕) && !CFLAG:K17C_ID:K17C_CF_デートイベント
	CALL KOJO_MESSAGE_SEND("SP_EVENT",1,ARG,0)
	;キャンセルフラグ
	IF !TCVAR:ARG:キスキャンセル
		IF TALENT:MASTER:キス未経験
			CALL SET_FIRSTKISS(MASTER, ARG, 1)
			EXP:ARG:愛情経験 += 10
		ENDIF
		IF TALENT:ARG:キス未経験
			CALL SET_FIRSTKISS(ARG, MASTER, 1)
			EXP:ARG:キス経験 ++
			EXP:MASTER:キス経験 ++
			EXP:ARG:愛情経験 += 10
		ENDIF
		SETBIT CFLAG:ARG:既成事実 , 0
		SETBIT CFLAG:ARG:デート後イベントフラグ , 0
	ENDIF
	RETURN 1
	;告白していない（MASTERに恋人が居ない）
	;ELSEIF !(CFLAG:ARG:1 & 4) && !(CFLAG:ARG:13 & 2) && !TALENT:MASTER:恋人
	;告白イベント	;成功判定
ELSEIF CFLAG:K17C_ID:K17C_CF_デートイベント && (LOCAL > 530 + TALENT:ARG:一線越えない * 20)
	CALL KOJO_MESSAGE_SEND("SP_EVENT",2,ARG,0)
	;恋人になる選択肢はこっちに　上のイベントでも判定しておく
	IF !(CFLAG:ARG:1 & 4) && !TALENT:MASTER:恋人
		PRINTFORML %CALLNAME:ARG%의 고백에 어떻게 반응할 건가요?
		PRINTFORML [1] - 수락- {FLAG:追加恋人枠 + 1} 연인을 가질 수 있어요\@ FLAG:追加恋人枠 ? s #  \@ -
		PRINTFORM [2] - 거절
		$INPUT_LOOP
		INPUT
		IF RESULT > 2 || RESULT < 1
			CLEARLINE 1
			GOTO INPUT_LOOP
		ELSEIF RESULT == 1
			SETBIT CFLAG:ARG:既成事実 , 2
			SETBIT CFLAG:MASTER:既成事実, 2
			TALENT:MASTER:恋人 = NO:ARG
			TALENT:ARG:恋人 = 1
			SETBIT CFLAG:ARG:デート後イベントフラグ , 1
			CALL KOJO_MESSAGE_SEND("SP_EVENT",2,ARG,RESULT)
			PRINTL
			PRINTFORM 당신과 %CALLNAME:ARG%은(는) 이제 
			SETCOLOR C_PINK
			PRINT 연인들
			RESETCOLOR
			PRINTW !			
			RETURN 1
		ELSE
			CALL KOJO_MESSAGE_SEND("SP_EVENT",2,ARG,RESULT)
			RETURN 1
		ENDIF
	ENDIF
ELSEIF !MARK:ARG:反発刻印
	;改造前のこの地点に入ったものをもう一度ここで再評価する
	;ここで戻るので一回判定のみ一度外す
	;普通に失敗
	TCVAR:K17C_ID:K17C_TC_デートイベ判定=1
	RETURN 0
	;CALL KOJO_MESSAGE_SEND("SP_EVENT",3,ARG,0)
ENDIF
;反発ありで消し失敗
;フラグリセ
TCVAR:K17C_ID:K17C_TC_デートイベ判定=1
RETURN 0
;*********************************************************************************
;	素質の操作
;
;	概要
;	口上内イベントで上下
;	書き換えフラグ忘れそうになるのでここで一括処理
;	素質に対して1～-1(素直 なし 反抗的　など)範囲で操作
;	今のところ対応してる番号
;	・プライド	13	K17C_TALENT_プライド	1プライド高い～0なし～プライド低い
;	・態度		11	K17C_TALENT_態度		1素直～0なし～-1反抗的
;
;	09/05	0の時の-2とか考えてオーバーフロー対策追記　色々考えすぎて汚い
;	09/08	LIMITにした←便利！
;
;	変数	：CFLAG:17:1001　口上全体で書き換えを行うかのフラグ　0、1で書き換え、-1でしない
;	引数0	：キャラID
;	変数1	：書き換える素質番号
;	変数2	：書き換える数値
;	戻り値	：書き換えたら1　書き換えなかったら0
;*********************************************************************************

@K17_TALENT_UPDOWN(ARG=K17C_ID,ARG:1,ARG:2)
VARSET LOCAL
;書き換えフラグ
SIF CFLAG:K17C_ID:K17C_CF_素質変化フラグ < 0 || ARG!=K17C_ID
	RETURN 0
;現在既に最高値なら返す
SIF TALENT:ARG:(ARG:1) == -1 && ARG:2 < 0
	RETURN 0
SIF TALENT:ARG:(ARG:1) == 1 && ARG:2 > 0
	RETURN 0
;元の値を保存
LOCAL = TALENT:ARG:(ARG:1)
PRINTL
SELECTCASE ARG:1
	;プライド　1でも2でも失う⇔取り戻しでいいか
	CASE K17C_TALENT_プライド
		LIMIT (TALENT:ARG:(ARG:1))+ARG:2,-1,1
		TALENT:ARG:(ARG:1) = RESULT
		;正負を見る
		IF ARG:2<0
			PRINTFORMD %CALLNAME:ARG%는 더 이상 [자존심이 강하지 않다]!
		ELSEIF ARG:2>0
			PRINTFORMD %CALLNAME:ARG%가 자존심이 되었다!
		ENDIF
		;態度
	CASE K17C_TALENT_態度
		LIMIT (TALENT:ARG:(ARG:1))+ARG:2,-1,1
		TALENT:ARG:(ARG:1) = RESULT
		;下げる時
		IF ARG:2<0
			;反抗的→消滅
			SIF TALENT:ARG:(ARG:1) <= 0 && LOCAL==1
				PRINTFORMD %CALLNAME:ARG%는 더 이상 [반항적]이지 않다!
			SIF !LINEISEMPTY()
				PRINTW
			;なし→素直
			SIF TALENT:ARG:(ARG:1) == -1 && LOCAL>=0
				PRINTFORMD %CALLNAME:ARG%이(가) [온순해졌다]!
		ELSEIF ARG:2>0
			;上げる時
			SIF TALENT:ARG:(ARG:1) >= 0 && LOCAL==-1
				PRINTFORMD %CALLNAME:ARG%는 더 이상 [온순하다]가 아니다!
			SIF !LINEISEMPTY()
				PRINTW
			SIF TALENT:ARG:(ARG:1) == 1 && LOCAL!=1
				PRINTFORMD %CALLNAME:ARG%은(는) [반항적]이 되었다!
		ENDIF
		;追加したらここへCASE作る
	CASEELSE
		PRINTFORMDL 예상치 못한 재능(ID {ARG:1})이 K17_TALENT_UPDOWN으로 전달되었다.
		CALL HPH_PRINT,"「오류가 발생했습니다. 보고해 주세요, 알겠죠? HPH」", "L"
ENDSELECT
SIF !LINEISEMPTY()
	PRINTW
RETURN 1
;*********************************************************************************
;	ファーストキスイベント
;	初めてキスが呼ばれた時の口上をここに書いとく
;	経験に関係なくMASTER（プレイヤーから）能動的に意識ありで呼んだ用
;
;	09/05	微妙な場面なので名前呼びに固定
;
;	引数0	：キャラID
;	戻り値	：通過初回のみ1　二度目以降0
;*********************************************************************************

@K17_FIRSTKISS(ARG)
IF CFLAG:K17C_ID:K17C_CF_FKマスター
	CFLAG:K17C_ID:K17C_CF_FKマスター = MIN(CFLAG:K17C_ID:K17C_CF_FKマスター+1,10000)
	RETURN 0
ELSE
	SELECTCASE K17_GRT(ARG)
		CASE IS >= K17C_恋慕
			PRINTFORML 「키스하고 싶어?」
			CALL HPH_PRINT,"「음... 추후프」", "W"
			CALL HPH_PRINT,"「더... 음프흐프... 으응츄후프」", "L"
			CALL HPH_PRINT,"「하아... 하프, 드디어... 이거 했어.」", "L"
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "기다리게 했나...?"
			ELSE
				PRINTFORMDL 그녀를 기다리게 만들었나 보네...
			ENDIF
			PRINTFORML 「이제 괜찮아, 걱정하지 마.」
			PRINTFORML 「앞으로도 이런 거 많이 하자, 알겠지?」
		CASE IS >= K17C_思慕
			IF ABL:ARG:親密 >= 7
				PRINTFORML 「너... 키스하고 싶어?」
				CALL HPH_PRINT,@"「음... %CALLNAME:MASTER%... 추우한가」", "W"
				PRINTFORML 「에헤... 에헤헤...」
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "갑자기 그런 충동이 들었는데, 괜찮을까...?"
				ELSE
					PRINTFORMDL 갑자기 그런 충동이 들었지만 괜찮았던 걸까...
				ENDIF
				CALL HPH_PRINT,"「음, 그게... 좀 창피했어 BPB」", "L"
			ELSE
				PRINTFORML 「에? 키스라고?」
				CALL HPH_PRINT,"「Ah...BPB」", "W"
				PRINTFORML 「그, 너무 갑작스러웠어...」
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "나 갑자기 그런 충동이 들었어, 싫었니...?"
				ELSE
					PRINTFORMDL 갑자기 그런 충동이 들었지만, 어쩌면 그녀는 그것을 좋아하지 않았을지도 모른다...
				ENDIF
				CALL HPH_PRINT,"「나도 언젠가 그렇게 하고 싶다고 생각했었는데, 이렇게 갑자기 할 줄은 몰랐어 BPB.」", "L"
			ENDIF
		CASE IS >= K17C_お友達
			PRINTFORML 「어라, %K17_CNAME()%, 너는... 이런 걸 하고 싶었던 거야...」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "그냥 생각 없이 해버렸는데, 마음에 안 들었어...?"
			ELSE
				PRINTFORMDL 너는 생각하지 않고 방금 그랬지만, 어쩌면 그녀는 그것을 좋아하지 않았을지도 모른다...
			ENDIF
			PRINTFORML 「...」
		CASEELSE
			PRINTFORMW 「크윽...」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "그냥 생각 없이 해버렸는데, 마음에 안 들었어...?"
			ELSE
				PRINTFORMDL 너는 생각하지 않고 방금 그랬지만, 어쩌면 그녀는 그것을 좋아하지 않았을지도 모른다...
			ENDIF
			PRINTFORML 「...바보 같군.」
	ENDSELECT
	;正真正銘ファーストキス
	IF K17_GRT(ARG)>=K17C_思慕 && !CFLAG:K17C_ID:K17C_CF_FK && !TALENT:ARG:キス未経験
		;思慕↑
		PRINTW
		;時間停止中のキスでキス経験上がっちゃうんだよねどうしよう
		;未経験は口上呼ばれる前に消えちゃう……未経験だったかとっとくか
		;今のところヤリマンでもキス未経験のままなので放置かな
		IF EXP:ARG:キス経験 == 1
			PRINTFORML 「그게... 나의 첫 키스였어.」
			PRINTFORMDL 그녀의 용모에도 불구하고, 당신과 %조사처리(CALLNAME:TARGET,"의")% 키스는 놀라울 정도로 순수하고 어색했다.
			PRINTW
		ENDIF
		IF (EXP:MASTER:キス経験 == 1)
			PRINTFORML 「너도 첫 키스였어?」
			PRINTFORML 「아... (다행이다...)」
			PRINTFORMDL 그녀와 자신의 감정을 연결할 수 있었다고 느낀다.
			PRINTW
		ENDIF
	ELSEIF !CFLAG:K17C_ID:K17C_CF_FK && (EXP:MASTER:キス経験 == 1)
		;知り合い程度
		PRINTW
		IF K17_GRT(ARG) >= K17C_お友達
			;仲良くなり始め
			PRINTFORML 「나는... 나의 첫 키스가... 더 로맨틱하기를 바랐어.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 상당히 불만족스러워 보인다.
			IF (EXP:MASTER:キス経験 == 1)
				PRINTFORML 「너도 첫 키스였어?」
				IF TALENT:MASTER:性別 == 2
					PRINTFORML 「알겠다... 어쩌면 남자들은 별로 생각 안 하는 걸지도...」
				ELSE
					PRINTFORML 「...여성인데 그것에 대해 꽤 가볍게 행동하네...」
				ENDIF
			ENDIF
			SIF !CFLAG:K17C_ID:K17C_CF_デートイベント
				PRINTFORML 「내 계획은 물 건너졌군...」
		ELSE
			;他人
			PRINTFORML 「...!」
			PRINTFORMDL 찰싹! 그녀의 손이 당신의 뺨을 가로질러 날아온다.
			SIF CFLAG:TARGET:弱み握られ
				PRINTFORML 「내 어두운 비밀을 안다 해도, 나는 당신의 인형이 아니야...」
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 눈에 고이는 눈물을 볼 수 있다...
			BASE:ARG:怒り += 1000
		ENDIF
	ENDIF
	;ムード評価
	IF K17_GRT(ARG) >= K17C_思慕
		SELECTCASE BASE:ARG:ムード
			CASE IS >= 750
				PRINTFORML 「분위기가 완벽했다...」
			CASE IS >= 500
				PRINTFORML 「그래도 분위기는 좀 더 좋았으면 좋았을 텐데.」
			CASEELSE
				PRINTFORML 「하지만 다음에는 기분을 좀 생각하고 말이야, 알겠지?」
		ENDSELECT
	ENDIF
	;どっちからしたかを保存
	SIF CFLAG:K17C_ID:K17C_CF_FK == 0
		CFLAG:K17C_ID:K17C_CF_FK = -1
	CFLAG:K17C_ID:K17C_CF_FKマスター++
	TRYCALL K17_RELATION_EV( K17C_RTF_キス )
	RETURN 1
ENDIF
RETURN 0
;*********************************************************************************
;	ファーストキス（アリス）イベント
;	呼ぼ出しがM_KOJO_SPEVENT_K17_1、カウンターコマンドとあるので
;	初めてキスが呼ばれた時の口上をここに書いとく
;	経験に関係なくアリスから初めてした時用
;
;	09/05	微妙な場面なので名前呼びに固定
;
;	引数0	：キャラID
;	戻り値	：通過初回のみ1　二度目以降0
;*********************************************************************************

@K17_FIRSTKISS_ALICE(ARG)
IF CFLAG:K17C_ID:K17C_CF_FKアリス
	CFLAG:K17C_ID:K17C_CF_FKアリス = MIN(CFLAG:K17C_ID:K17C_CF_FKアリス+1,10000)
	RETURN 0
ELSE
	SELECTCASE K17_GRT(ARG)
		CASE IS >= K17C_恋慕
			PRINTFORML 「당신을 연모합니다...」
			CALL HPH_PRINT,"「키스하자, 응? 음... 추우흐프」", "L"
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 키스를 받아들인다...
			PRINTFORML 「후후, 그게 나에게서 받은 첫 키스지, 그렇지?」
		CASE IS >= K17C_思慕
			CALL HPH_PRINT,"「나는 너를 좋아해... 추우피」", "L"
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 예기치 않게 당신에게 키스한다...
			PRINTFORML 「나로부터의 첫 번째 키스지, 그렇지?」
		CASEELSE
			PRINTFORML 「츄우.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신에게 예기치 않게 키스한다...
			PRINTFORML 「나를 키스하게 만든 건... 도대체 무슨 교활한 마법을 사용한 거야?」
	ENDSELECT
	;正真正銘ファーストキス思慕以上
	IF K17_GRT(ARG)>=K17C_思慕 && !CFLAG:K17C_ID:K17C_CF_FK && !TALENT:ARG:キス未経験
		;コマンド呼び出し用　M_KOJO_SPEVENT_K17_1は別途用意
		IF EXP:MASTER:キス経験 == 1
			PRINTFORML 「네가 나의 첫 키스를 받은 것 같아.」
			PRINTFORML 「나도 네가 나의 첫 키스라서 기뻐...」
			PRINTFORMDL 서로의 감정을 전달할 수 있었다고 느껴진다.
		ELSE
			PRINTFORML 「그것이 나의 첫 키스였어.」
			PRINTFORMDL 그녀의 용모에도 불구하고, %조사처리(CALLNAME:TARGET,"의")% 키스는 조금 어색했다.
		ENDIF
	ENDIF
	;どっちからしたかを保存
	SIF CFLAG:K17C_ID:K17C_CF_FK == 0
		CFLAG:K17C_ID:K17C_CF_FK = 1
	CFLAG:K17C_ID:K17C_CF_FKアリス++
	TRYCALL K17_RELATION_EV( K17C_RTF_キス )
	RETURN 1
ENDIF
RETURN 0
;*********************************************************************************
;	時間停止バレの条件式
;
;	ちょっと複雑になったので新設
;	あくまでこのアリスの口上のみの条件式
;
;	引数0	：キャラID 一応いれてアリス以外かみとく
;	引数1	：ランダム基本値
;	引数2	：疑い閾値
;	戻り値	：真偽
;*********************************************************************************

@K17_CHECK_時間停止バレ(iID=K17C_ID,iRand_Base=20,iDoubt_Base=0)
#FUNCTION
#DIM iID
#DIM iRand_Base
#DIM iDoubt_Base
;キャラIDチェック
SIF iID != K17C_ID
	RETURNF 0
;すでにバレてるか
SIF CFLAG:iID:時間停止バレ == 1
	RETURNF 0
SIF FLAG:なりきり == K17C_咲夜ID
	RETURNF 1
;あげたものか見る
SIF CFLAG:iID:ノーパン == 2
	RETURNF 0
;疑い50以上か見る
SIF CFLAG:iID:K17C_CF_疑い < iDoubt_Base
	RETURNF 0
;アリスのパンツあるか見る
SIF !K17_CHECK_輸送パンツ(iID)
	RETURNF 0
;ランダム通過
SIF !(K17_PERCENT(iRand_Base + CFLAG:iID:K17C_CF_疑い))
	RETURNF 0
RETURNF 1
;*********************************************************************************
;	MASTERの時間停止バレ時のテキスト
;
;	引数0	：キャラID
;	戻り値	：疑い0で1　疑いありで2
;*********************************************************************************

@K17_時間停止バレ(ARG=K17C_ID)
#DIM DYNAMIC iDown_好感度=0
#DIM DYNAMIC iDown_信頼度=0
RESULT = 0
IF CFLAG:ARG:K17C_CF_疑い == 0
	PRINTFORML 「후우…… 이런 능력을 가지고도 요정 같은 장난이나 치다니.」
	PRINTFORML 「자신의 재능을 그저 낭비하고 있다는 걸 모르겠어?」
	PRINTFORML 「내가 아는 사람 중 그렇게 엄청난 능력을 가진 사람은 %K17_CNAME(K17C_咲夜ID)%인 사쿠야뿐이야.」
	PRINTFORMDW 어쩌고저쩌고……
	PRINTFORMDW ……잔소리 잔소리……
	PRINTFORMDW ……어쩌고저쩌고…… 잔소리 잔소리……
	PRINTFORMDW 자신의 인생 선택을 조금은 재고하게 된다……!
	RESULT = 1
ELSE
	;疑い中
	PRINTFORML 「……결국 내 몸으로 저지른 이 모든 최근의 장난 뒤에는 네가 있었던 거구나……」
	SELECTCASE K17_GRT(ARG)
		CASE IS >= K17C_恋慕
			PRINTFORML 「후우…… 모르는 누군가가 내 몸을 가지고 노는 것에 대해 얼마나 걱정했는지 알고 있니...?」
			PRINTFORML 「너 말고 아무도 내 몸에 손대지 않았으면 좋겠어…… 바보야……」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 가슴에 얼굴을 묻고 주먹으로 두드린다.
			PRINTFORMDL 그녀의 안도감이 분노보다 더 큰 것 같다.
			PRINTW
			PRINTFORML 「아니, 오해하지 마, 난 너한테 화난 거 아니야.」
			PRINTFORMDL 그렇게 확신할 수 있을까.
			CALL K17_MARK_反発刻印()
		CASE IS >= K17C_思慕逢引
			PRINTFORML 「……네가 그렇게 생각한다면 평범하게 지내는 것도…… 아니, 어쩌면 우리가 서로에 대해 오해하고 있는 것뿐이겠지……」
			iDown_好感度 = CFLAG:ARG:好感度/6
			iDown_信頼度 = CFLAG:ARG:信頼度/6
			CALL K17_MARK_反発刻印(1)
		CASE IS >= K17C_思慕
			PRINTFORML 「……너무 배신당한 기분이야…… 아니, 희망을 갖는 건 내 잘못이라고 생각하겠지.」
			PRINTFORML 「정말 유감이군……」
			iDown_好感度 = CFLAG:ARG:好感度/4
			iDown_信頼度 = CFLAG:ARG:信頼度/4
			CALL K17_MARK_反発刻印(2)
		CASEELSE
			PRINTFORML 「그래서 그런 사람이었군요...」
			PRINTFORML 「얼마나 유감인지...」
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 모든 신뢰를 잃은 것 같다.
			iDown_好感度 = CFLAG:ARG:好感度
			iDown_信頼度 = CFLAG:ARG:信頼度
			CALL K17_MARK_反発刻印(3)
	ENDSELECT
	RESULT = 2
ENDIF
;好感度と信頼度の変化
IF iDown_好感度 || iDown_信頼度
	PRINTL
	CALL CHANGE_CFLAG(2, K17C_ID, -iDown_好感度)
	CALL CHANGE_CFLAG(4, K17C_ID, -iDown_信頼度)
ENDIF
;停止バレ
CFLAG:ARG:時間停止バレ = 1
;疑いがあり、無自覚処女喪失していれば自覚
SIF TALENT:ARG:処女  == -1 && CFLAG:ARG:K17C_CF_疑い
	TALENT:ARG:処女 = 0
RETURN RESULT
;*********************************************************************************
;	乱交が開始されたときのイベント
;	アリスから乱交相手に対する反応
;	情事発覚とか一緒に押し倒し、押し倒されなどの反応は各所でやる
;	そのあとこれをくっつける感じ
;
;	引数0	：乱交相手のID
;*********************************************************************************

@K17_乱交開始(ARG)
SELECTCASE ARG
	;気安い系
	CASE K17C_霊夢ID,K17C_魔理沙ID,K17C_パチュリーID,K17C_幽香ID,K17C_咲夜ID,K17C_メディスンID
		;アリスが恋人な場合
		IF TALENT:TARGET:恋人
			PRINTFORML 「...음, 이게 뭐지? %K17_CNAME(ARG)%, %K17_RS("are you blushing?/are you embarrassed?/you're blushing.")%」
			PRINTFORML 「자, 그럼 %K17_CNAME(ARG)%, %K17_RS("come/join me/come this way")%하고 함께 %K17_RS("love/drain")% %K17_CNAME()%하자.」
			PRINTFORML 「아, 하지만 %HE_SHE(MASTER)%는 결국 내 것이라는 걸 잊지 말아줘.」
			PRINTFORMDL 너는 상당히 미친 상황에 휘말린 것 같은 기분이 들 것이다...
			;相手が恋人か見る　あわわわ……
		ELSEIF TALENT:ARG:恋人
			PRINTFORML 「내가 여기에 있는 게...정말로 괜찮을까? %K17_CNAME(ARG)%... 그렇게 말한다면... 하지만 참지 않을 거야, 알겠지?」
			PRINTFORMDL 그녀가 그렇게 말하지만, %조사처리(CALLNAME:TARGET,"는")% 여전히 약간의 망설임을 가진 것 같다.
		ELSE
			PRINTFORML 「자, 이제 %K17_CNAME(ARG)%, %K17_RS("come/join me/come this way")%와 함께 %K17_RS("love/drain")% %K17_CNAME()%해 보자.」
			PRINTFORMDL 당신은 꽤나 미친 상황에 빠진 것 같은 기분이 들 것이다...
		ENDIF
		;尊敬系
	CASE K17C_魅魔ID,K17C_ルイズID,K17C_神綺ID,K17C_夢子ID
		;アリスが恋人な場合
		IF TALENT:TARGET:恋人
			PRINTFORML 「만약 %K17_CNAME(ARG)%이 진지해진다면, 어차피 난 기회가 없을 거야.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신에게 바짝 다가가 귀에 속삭인다.
			PRINTFORML 「%K17_CNAME(ARG)%... 나는 그냥 %K17_CNAME(MASTER)%가 나의 %PRINT_MALE("boy", MASTER)% 친구라는 걸 친절하게 상기시켜주고 싶을 뿐이야.」
			;相手が恋人か見る　あわわわわわわ……
		ELSEIF TALENT:ARG:恋人
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 서둘러 정중한 자세를 취한다.
			PRINTFORML 「...%K17_CNAME(ARG)%, 제가 머물게 해주시겠어요?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 평소와 다른 정도의 존경심을 보이고 있다.
		ELSE
			PRINTFORML 「%K17_CNAME(ARG)%… 음, 그럼 나도 너희에게 합류할게.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 평소와 다르게 공손하다.
		ENDIF
		PRINTW
		PRINTFORML 「그런 표정은 뭐야, %K17_CNAME()%… %K17_CNAME(ARG)%의 가슴을 그렇게 쳐다보지 마, 바보야…」
		PRINTFORML (%HE_SHE(MASTER)%는 방금 우리를 비교하고 있었던 것 같아… 아휴.)
		;知らない人
	CASEELSE
		;アリスが恋人な場合
		IF TALENT:TARGET:恋人
			PRINTFORML 「...나는 그저 %K17_CNAME()%가 내 것이라는 걸 상기시켜주고 싶었을 뿐이야.」
			PRINTFORML 「아, 미안해, 참을 필요는 없다는 뜻이었어. 결국, %HE_SHE(MASTER)%는 그런 사람이잖아, 그렇지?」
			PRINTFORML 「음, %K17_CNAME(ARG)%였나...?」
			PRINTFORML 「...세상에, 어떻게 그렇게 멋진 %PRINT_MALE("boy", ARG)%를 얻을 수 있지.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% %CALLNAME:(ARG)%를 꼭 안는다.
			;相手が恋人
		ELSEIF TALENT:ARG:恋人
			PRINTFORML 「이 %PRINT_MALE("man", ARG)%... %HE_SHE(ARG)%는 네 %PRINT_MALE("boy", ARG)% 친구잖아, 그렇지?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 너의 귀에 속삭인다.
			PRINTFORML 「음, %K17_CNAME(ARG)%, 그랬었나...?」
			PRINTFORML 「알겠어, 고마워...」
			PRINTFORMDL 그렇게 말하며, %조사처리(CALLNAME:TARGET,"는")% 약간 주저하는 듯하다.
			;お互い恋人じゃない場合
		ELSE
			PRINTFORML 「음, %K17_CNAME(ARG)%, 그게...?」
			PRINTFORML 「어쩌면 우리 둘은 호환이 되는 걸지도 몰라?」
			PRINTFORML 「후후, 결국 우리는 같은 사람을 좋아하잖아, 그렇지?」
		ENDIF
ENDSELECT
RETURN 1
;*********************************************************************************
;	押し倒し喘ぎタイプ選択
;
;	最低条件はRTの恋人
;	押し倒され経験済み
;	押し倒しで通常以外の喘ぎタイプを経験済み
;*********************************************************************************

@K17_押し倒し喘ぎタイプ選択
IF FIRSTTIME("押し倒し喘ぎタイプ選択")
	PRINTFORML 「아, 미안해, 잠시만... 음...」
	PRINTFORML 「이렇게 늘 나랑 친밀하게 지내줘서 기쁘지만... 가끔 내가 질리지 않을까 걱정돼...」
	PRINTFORML 「그러니까 망설이지 마... 네가 하고 싶은 거 뭐든지 괜찮아... 알겠지?」
ELSE
	PRINTFORML 「음, 오늘 뭐 하고 싶어?」
ENDIF
PRINTL
CALL K17_ASK_M ("우리가 늘 하던 것처럼 사랑을 하자...",1, @"나는 당신이 나의 욕정을 받아들이기를 원해...",CFLAG:K17C_CF_受け_お手伝い系, @"거친 플레이를 시도해 보고 싶어...",CFLAG:K17C_CF_受け_合意襲い系, @"저항하는 당신을 격렬하게 탐하고 싶어...",CFLAG:K17C_CF_受け_無理矢理系, @"당신이 주도해줬으면 해...",1)
SELECTCASE RESULT
	CASE 0
		CALL K17_SET_AUTO_PVOICE(,,K17C_受け_おねだり系)
		PRINTFORML 「언제나 하듯이... 후후.」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 뺨이 장밋빛으로 물든다.
		PRINTFORMDL 그녀는 당신 옆으로 다가와 당신의 귓가에 속삭인다.
		CALL HPH_PRINT,@"「%K17_RS("당신과 열정적/달콤한 연모를 하는 것... 나에게도 괜찮아HPH")%」", "L"
		PRINTW
	CASE 1
		CALL K17_SET_AUTO_PVOICE(,,K17C_受け_お手伝い系)
		PRINTFORML 「당신은 원한다 %K17_RS("to do as you please with me/to use me like a sexual outlet")%...%K17_RS(" Like I'm a doll/")%」
		PRINTFORMDL 요청을 듣고 나서 %CALLNAME:TARGET%안절부절못하며 허벅지를 비빈다.
		PRINTFORML 「좋아, 이리 와...」
		PRINTW
	CASE 2
		CALL K17_SET_AUTO_PVOICE(,,K17C_受け_合意襲い系)
		PRINTFORML 「그냥 놀이일 뿐이야, 알겠지? 여자를 절대로 해서는 안 되는 일들이 있단 말이야...」
		PRINTFORMDL 당신의 손가락이 %조사처리(CALLNAME:TARGET,"를")% 가볍게 스치자, 그녀는 과장된 몸짓으로 뒤로 움츠러든다.
		CALL HPH_PRINT,"「안 돼아, 아파하지 마...」", "L"
		PRINTFORMDL 죄책감이 가슴을 조여오지만 %조사처리(CALLNAME:TARGET,"가")%(가) 네게 다가와 부드럽게 속삭인다.
		PRINTW
		CALL HPH_PRINT,@"「%K17_RS("It's okay/I'm fine")%, 그냥 놀이일 뿐이야... 그러니 %K17_RS("mess me up/treat me roughly/violate me")%HPH」", "L"
		PRINTW
	CASE 3
		CALL K17_SET_AUTO_PVOICE(,,K17C_受け_無理矢理系)
		PRINTFORML 「안 돼...! 말도 안 돼! 너 진짜 괴물이야!」
		PRINTFORMDL 당신은 그녀의 갑작스러운 폭발에 반사적으로 %CALLNAME:TARGET%에게서 움츠러든다.
		PRINTFORMDL 당신의 반응을 본 %조사처리(CALLNAME:TARGET,"는")% 당신에게 다가와 귀에 속삭인다.
		PRINTW
		CALL HPH_PRINT,"「걱정 마... 마음대로 해줘 HPH」", "L"
		PRINTW
	CASE 4
		CFLAG:うふふ = 2
		CALL K17_CHOICE( "오호... 그리고 내가 당신에게 무엇을 해주길 원해요?", @"당신 마음대로 나를 해줬으면 좋겠어...", @"나는 당신을 완전히 바치고 싶어...", @"나를 공격해 주길 원해...", @"나를 벌해줬으면 해...")
		;タイプ決めてから呼べばいい
		SELECTCASE RESULT
			CASE 0
				CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_お手伝い系
			CASE 1
				CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
			CASE 2
				CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_合意襲い系
			CASE 3
				CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_無理矢理系
		ENDSELECT
		CALL M_KOJO_EVENT_K17_10(1,0)
ENDSELECT
RETURN 1
