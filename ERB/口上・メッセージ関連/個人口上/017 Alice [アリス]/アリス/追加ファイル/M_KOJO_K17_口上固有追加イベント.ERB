	ENDIF
ENDIF
;----------------
;後処理
;----------------
;中出しのカウンター
IF TCVAR:K17C_ID:K17C_TC_中出しカウント
	PRINTW
	CALL HPH_PRINT,@"「%K17_SPLIT_SHUFFLE(@"%K17_RS("Hyahn/Nyan/Hiie/Kyaa")%BPB\\...","\\")%」", "L"
	PRINTFORML (%HIS_HER(MASTER,1)%가 내 안쪽에 무언가를 넣었다... 새어 나오고 있어...)
