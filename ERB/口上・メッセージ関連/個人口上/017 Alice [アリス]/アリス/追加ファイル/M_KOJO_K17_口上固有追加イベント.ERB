SIF CFLAG:TARGET:既成事実 & 合意_うふふ
	TRYCALL K17_RELATION_EV( K17C_RTF_うふふ )
;恋慕未満感想飛ばし
SIF iRT < K17C_恋慕 || RESULT || TFLAG:抱きつきモード
	RETURN 1
PRINTW
;----------------
;乱交時の対応
;初回はありえないはず
;----------------
IF iTNum > 1
	;とりあえず友達優先で取る
	iFriends = K17_GET_TARGETS_ID()
	PRINTFORML 「%K17_CNAME(iFriends)%도 고마워...」
	;知り合い反応
	SIF K17_GET_FRIENDS(iFriends)
		PRINTFORML (\@ ARG==-1 ? 사랑받는 것 # 그것을 하는 것 \@ %K17_CNAME(iFriends)% 앞에서 그런 식으로...%K17_RS("부끄럽다/얼굴이 화끈거린다/긴장된다")%, 어쨌든.)
	RETURN 1
ENDIF
;----------------
;感想戦
;----------------
IF ARG == -1 || TALENT:MASTER:性別 == 1
	;アリスを押し倒した時の評価
	;MASTERが竿なしの女性の場合もこっち
	;----------------
	;評価計算
	;----------------
	;開始時の溜まってる度から、どれ位の割合減ったか取得
	iReview =   K17_ROUND( LIMIT(CFLAG:TARGET:溜まってる度,0,1000)*100 , LIMIT(ARG:1,0,1000))
	iReview = 100-iReview
	SELECTCASE iReview
		;満足
		CASE IS >= 70
			PRINTDATAL
				DATAFORM (음... 머리가... 이제 정말 맑아졌어%K17_HEART()% )
				DATAFORM (정말... 즐거웠어%K17_HEART()% )
				DATAFORM (아아%K17_HEART()% 너무 좋아...)
			ENDDATA
			PRINTFORML 「%K17_RS("I thought... /...")%그게 %K17_RS("was really good/felt really good/was so satisfying")%...」
			PRINTDATADL
				DATAFORM %조사처리(CALLNAME:TARGET,"는")%(는) 당신을 보며 만족감에 실실 빛나고 미소 짓는다.
				DATAFORM %조사처리(CALLNAME:TARGET,"는")%(는) 수줍게 아래를 내려다보며 당신의 손가락과 자신의 손가락을 깍지 낀다.
				DATAFORM %조사처리(CALLNAME:TARGET,"는")%(는) 만족스러운 미소를 지으며 당신에게 바싹 기댄다.
			ENDDATA
			;もうちょっと
		CASE IS >= 45
			PRINTDATAL
				DATAFORM (...조금만 더... 하아, %K17_RS("I mustn't think like that/how shameless")%%K17_BLUSH()%)
				DATAFORM (음ー... 그냥 %K17_RS("a little more/a little longer/one more time")%, 좀 더 있으면 좋았을 텐데... 뭐.)
				DATAFORM (%K17_RS("wasn't quite enough/a little more would have been nice")%라고 생각하니... %HIS_HER(MASTER)%의 변태적인 기질이 나에게 옮고 있는지 모르겠네...)
			ENDDATA
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 얼굴에 %K17_RS("blushing/reddening/flushed")%가 떠서 약간 생각에 잠긴 듯하다.
			;不満
		CASEELSE
			PRINTDATAL
				DATAFORM (...궁금해...만약 %HE_SHE(MASTER)% ~인지 %K17_RS("just teasing me/putting me off/telling me to wait")%...?)
				DATAFORM (우린 이미 끝났어... %K17_RS(@"What's going on...?/Is %HE_SHE(MASTER)% tired...?/Is %HE_SHE(MASTER)% tired of me...?/If only I had more feminine appeal...")%))
				DATAFORM (뭐가 문제야 %HIM_HER(MASTER,,1)%... ~하는 것이 %K17_RS("being/making love")% 나랑 조금 더 있어 주는 게 그렇게 나쁜 일이었을까?))
			ENDDATA
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 약간의 불만족과 함께 %K17_RS(@"뺨을 부풀린다/당신을 올려다본다/허벅지를 문지른다")%.
	ENDSELECT
ELSEIF ARG == K17C_ID
	;竿ありMASTERでアリスが押し倒した時
	;----------------
	;評価計算
	;----------------
	;開始時の精力から、どれ位の割合減ったか取得
	;TODO: the dependence of iReview on remaining player vigor might lead to some weird cases the session ends due to Alice's
	;stamina, or she hits 0 sexual frustration, but she still complains because the player has remaining vigor. Might happen if
	;the AI doesn't choose many player service actions.
	iReview =   K17_ROUND( LIMIT(BASE:MASTER:精力,0,MAXBASE:MASTER:精力)*100 , LIMIT(ARG:1,0,MAXBASE:MASTER:精力))
	iReview = 100-iReview
	SELECTCASE iReview
		;満足
		CASE IS >= 60
			PRINTDATAL
				DATAFORM (내가 조금 과했나 모르겠네%K17_HEART()% )
				DATAFORM (%HE_SHE(MASTER,1)%가 아주 만족스러워 보여...%K17_HEART()% )
				DATAFORM (%HIS_HER(MASTER,1)%의 얼굴은 만족감으로 가득해... 정말 귀여워%K17_HEART()% )
			ENDDATA
			PRINTFORML 「%K17_RS("어땠니/무슨 생각을 했니/")%～? 후후...」
			PRINTFORMDL %K17_RS("자만심에 가득 찬/흡족하게/음란하게")% 미소 짓는 %조사처리(CALLNAME:TARGET,"에게")% 기운을 빼앗긴 채, 당신은 잠시 허공을 응시한다.
			;もうちょっと
		CASE IS >= 30
			PRINTDATAL
				DATAFORM (주도권이 없으면 어떨까...%K17_RS(@"was embarrassing/made %HIM_HER(MASTER,,1)% feel uneasy/wasn't to %HIS_HER(MASTER)% liking")%...)
				DATAFORM (조금 더 가고 싶었는데... 어쩌면 이 %K17_RS(@"was embarrassing/made %HIM_HER(MASTER,,1)% feel uneasy/wasn't to %HIS_HER(MASTER)% liking")%... %K17_RS("Hauu/Uuu/Hmph")%.)
				DATAFORM (음... 그냥 %K17_RS("a little more/a little longer/one more time")%... 뭐 됐어.)
			ENDDATA
			PRINTFORMDL 당신은 그녀가 약간의 불확실함을 담아 고개를 들고 있는 동안 %조사처리(CALLNAME:TARGET,"의")% 머리를 쓰다듬는다.
			;不満
		CASEELSE
			PRINTDATAL
				DATAFORM (혹시... %K17_RS(@"it wasn't good/%HE_SHE(MASTER)% didn't like it/%HE_SHE(MASTER)%'s holding it in")%...?)
				DATAFORM (우린 이미 끝났어... %K17_RS(@"What's going on...?/Is %HE_SHE(MASTER)% tired...?/Is %HE_SHE(MASTER)% tired of me...?/If only I had more feminine appeal...")%))
				DATAFORM （What's with %HIM_HER(MASTER,,1)%... Would %K17_RS("being/making love")% with me a little longer...have been such a bad thing?）
			ENDDATA
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 약간의 불만족과 함께 %K17_RS(@"뺨을 부풀린다/당신을 올려다본다/허벅지를 문지른다")%.
	ENDSELECT
ENDIF
RETURN 1
;*********************************************************************************
;	無理矢理中出しした場合の怒り→うふふ解除
;	また普通にうふふ終了できたパターンに対応
;
;	中出しカウントと無理矢理フラグを初期化して戻す
;
;	引数0	：キャラID　略アリス
;	戻り値	：無理矢理フラグを見て表示したら1　表示しなかったら0
;*********************************************************************************

@K17_無理矢理中出し(iID=K17C_ID)
#DIM iID
SIF !TCVAR:iID:無理矢理
	RETURN 0
PRINTFORML 「내가 %K17_RS("안 돼/넌 그럴 수 없어/그만해")%라고 말했는데도... %K17_RS("넌 최악이야/거짓말쟁이/믿을 수가 없어")%...」
;中出し
IF TCVAR:K17C_ID:K17C_TC_中出しカウント
	;危険日見る
	IF ESTRUS_CYCLE(iID) >= 7
		PRINTFORML (뭐, 뭐, 뭘 해야 하지?! ...%K17_RS("오늘은 위험해/임신할 거야")%...)
	ELSE
		PRINTFORML (%K17_RS("Today's not too dangerous/I wouldn't get pregnant today")%, 그치...?)
	ENDIF
ENDIF
PRINTFORMDL %CALLNAME:iID%은 짜증으로 투덜거리기 시작한다...
;TCVAR:iID:無理矢理 = 0
TCVAR:K17C_ID:K17C_TC_中出しカウント = 0
RETURN 1
;*********************************************************************************
;	関係性を評価する
;
;	09/08	あれこれなんか頭弱くね　初回限定をどうするかあとで考える
;	09/09	なんとかスッキリ 実際上がるタイミングに差異があるので呼ぶときに初回判定
;	09/10	結局CFLAG使うことに 動的判定でフラグ立っててもここへ来た時に初回判定できるはず
;			フラグ上げてから呼んであげて
;	11/24	フラグ値の加算をor演算に　動的とグローバルに差異がある場合UPDATEすることに
;
;	引数0	：取得フラグ（K17C_RTF_
;	引数1	：キャラID 省略でアリス
;	戻り値	：書き換えたら1　グローバルにもう追加されていたら0
;*********************************************************************************

@K17_RELATION_EV(ARG:0,ARG:1=K17C_ID)
#DIM iRTnum
#DIM iRTF
iRTF = K17_RT_FG(K17C_ID)
SIF CFLAG:K17C_ID:K17C_CF_RTF & ARG:0
	RETURN 0
iRTnum = FINDELEMENT (K17C_RTF,ARG:0)
SIF iRTnum == -1
	THROW 引数({ARG:0})不正なフラグを取得
;取得フラグ保存
CFLAG:K17C_ID:K17C_CF_RTF |= K17C_RTF:iRTnum
;UPTATE
SIF iRTF != CFLAG:K17C_ID:K17C_CF_RTF
	CFLAG:K17C_ID:K17C_CF_RTF = iRTF
