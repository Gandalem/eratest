;-------------------------------------------
;刻印取得
;-------------------------------------------
@M_KOJO_MESSAGE_MARKCNG_K17
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
IF !FLAG:時間停止

	;苦痛刻印
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORMW 「Agh... Keh... Stop! I'm not your doll!」
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORMW 「Nooo! Stop, I said stop! I'm not...a doll...」
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORMW 「...Please... Stop... I'll be...your doll, so...」
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,2)
	ENDIF
	
	;時姦刻印
	IF TFLAG:時姦刻印取得 == 1
		PRINTFORMW 
	ELSEIF TFLAG:時姦刻印取得 == 2
		PRINTFORMW 
	ELSEIF TFLAG:時姦刻印取得 == 3
		PRINTFORMW 
	ENDIF
	
	;快楽刻印
	IF TFLAG:快楽刻印取得 == 1
		PRINTL
		PRINTFORML 「Haa, haa... I can't believe... Uuu... This is so embarrassing...」
		PRINTW
	ELSEIF TFLAG:快楽刻印取得 == 2
		PRINTL
		PRINTFORML 「...Haa... More... Let's do that...more...」
		PRINTFORML 「Come on, again? Please?」
		PRINTW
	ELSEIF TFLAG:快楽刻印取得 == 3
		PRINTL
		PRINTFORML 「Haa, haa... I don't think... I can live without you anymore.」
		CALL HPH_PRINT,"「You've gone and done it now! I'm won't let you get away from meHPH」", "L"
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-2)
		CALL K17_RELATION_EV(K17C_RTF_恋人)
		SIF !RESULT
			PRINTW
	ENDIF
	
	;不埒刻印
	;快楽による刻印
	;LV1
	IF TFLAG:屈服刻印取得 == 11
		PRINTL
		PRINTFORML 「Hyahn!」
		CALL HPH_PRINT,"「～～...!BPB」", "L"
		PRINTFORMDL Surprised by her own voice, %CALLNAME:TARGET% quickly muffles it with her hands.
		PRINTW
	;LV2
	ELSEIF TFLAG:屈服刻印取得 == 12
		PRINTL
		PRINTFORML 「Hauu... Uuu... I-I, umm...」
		PRINTFORML 「N-Never mind, it's nothing...」
		PRINTFORML 「C-Cute?! Come on, don't tease me like that...」
		PRINTW
	;LV3
	ELSEIF TFLAG:屈服刻印取得 == 13
		PRINTL
		PRINTFORML 「Haa, haa... H-Hey...」
		PRINTFORML 「You'll take responsibility for making my body like this, right...?」
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-1)
		PRINTW
	;屈服、恭順による刻印
	;LV1
	ELSEIF TFLAG:屈服刻印取得 == 31
		PRINTL
		PRINTFORML 「%K17_CNAME()%... Fufu.」
		PRINTFORML 「You know... Hmmー... Mmmー... No, never mind.」
		PRINTFORMDL After tilting her head and thinking for a moment, %CALLNAME:TARGET% finally just gives a cute little giggle.
		PRINTW
	;LV2
	ELSEIF TFLAG:屈服刻印取得 == 32
		PRINTL
		PRINTFORML 「%K17_CNAME()%, how are you feeling? Are you tired? Shall I massage your shoulders?」
		PRINTFORMDL What's gotten into her, all of a sudden...?
		PRINTW
	;LV3
	ELSEIF TFLAG:屈服刻印取得 == 33
		PRINTL
		PRINTFORML 「%K17_CNAME()%, how are you feeling? Are you tired? Do you want to massage my boobs?」
		PRINTFORMDL What's gotten into her again, so suddenly?
		PRINTW
		PRINTFORMDL ...Wait, what was that last thing she said?
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-1)
		PRINTW
	ENDIF
	
	;反発刻印
	IF TFLAG:反発刻印取得 == 1
		PRINTL
		PRINTFORML 「Your behavior is simply horrible, and that's putting it lightly.」
		PRINTFORML 「Are you trying to make others hate you by bothering them like that?」
		PRINTFORML 「If so, what you're doing is wrong.」
		PRINTFORML 「Do you understand? Don't say I didn't warn you.」
		PRINTFORML 「I would recommend taking this as a chance for self-improvement.」
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,1)
		PRINTW
	ELSEIF TFLAG:反発刻印取得 == 2
		PRINTL
		PRINTFORML 「...Do you really see me as just some typical, stupid little girl?」
		PRINTFORML 「A puppeteer of my caliber easily has the grip strength to crush a person's skull with my bare hands.」
		PRINTFORMDL Fixing you with a cold stare, %CALLNAME:TARGET% makes a squeezing motion with her hand.
		PRINTFORML 「I'd recommend changing how you behave in the future.」
		PRINTFORML 「Consider this your final warning.」
		PRINTW
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,2)
		
	ELSEIF TFLAG:反発刻印取得 == 3
		PRINTL
		PRINTFORML 「...」
		PRINTFORMDL %CALLNAME:TARGET% simply stares into the distance.
		PRINTFORMDL She doesn't seem to respond to your presence in the slightest.
		PRINTFORMDL It seems she doesn't even consider you worth a cold stare anymore.
		PRINTW
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,2)
		
	ENDIF
	
ENDIF

