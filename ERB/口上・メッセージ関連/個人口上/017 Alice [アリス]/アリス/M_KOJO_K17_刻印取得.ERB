; Modular ERB: 個人口上/017 Alice [アリス]/アリス/M_KOJO_K17_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K17
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
IF !FLAG:時間停止
	;苦痛刻印
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORMW 「아악... 크윽... 그만둬! 나는 네 인형이 아니야!」
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORMW 「안 돼! 그만둬, 내가 그만하라고 했잖아! 나는... 인형이 아니야...」
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORMW 「...부탁해... 멈춰줘... 나는... 네 인형이 될 테니...」
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,2)
	ENDIF
	;時姦刻印
	IF TFLAG:時姦刻印取得 == 1
		PRINTFORMW 
	ELSEIF TFLAG:時姦刻印取得 == 2
		PRINTFORMW 
	ELSEIF TFLAG:時姦刻印取得 == 3
		PRINTFORMW 
	ENDIF
	;快楽刻印
	IF TFLAG:快楽刻印取得 == 1
		PRINTL
		PRINTFORML 「하아, 하아... 믿을 수가 없어... 우우... 너무 창피해...」
		PRINTW
	ELSEIF TFLAG:快楽刻印取得 == 2
		PRINTL
		PRINTFORML 「...하아... 더... 그렇게 하자...더...」
		PRINTFORML 「어서, 다시? 부탁해?」
		PRINTW
	ELSEIF TFLAG:快楽刻印取得 == 3
		PRINTL
		PRINTFORML 「하아, 하아... 더는 당신 없이 살 수 없을 것 같아.」
		CALL HPH_PRINT,"「너 결국 해버렸구나! 내가 너를 놓아줄 리 없어HPH」", "L"
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-2)
		CALL K17_RELATION_EV(K17C_RTF_恋人)
		SIF !RESULT
			PRINTW
	ENDIF
	;不埒刻印
	;快楽による刻印
	;LV1
	IF TFLAG:屈服刻印取得 == 11
		PRINTL
		PRINTFORML 「야한!」
		CALL HPH_PRINT,"「～～...!BPB」", "L"
		PRINTFORMDL 자신의 목소리에 놀란 %조사처리(CALLNAME:TARGET,"는")%(는) 재빨리 손으로 그것을 막는다.
		PRINTW
		;LV2
	ELSEIF TFLAG:屈服刻印取得 == 12
		PRINTL
		PRINTFORML 「하아우... 우웅... 저, 그게...」
		PRINTFORML 「아니야, 아무것도 아니야...」
		PRINTFORML 「귀엽다고?! 자, 그렇게 놀리지 마...」
		PRINTW
		;LV3
	ELSEIF TFLAG:屈服刻印取得 == 13
		PRINTL
		PRINTFORML 「하아, 하아... 저기...」
		PRINTFORML 「내 몸을 이렇게 만든 건 네가 책임져야 하는 거지...?」
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-1)
		PRINTW
		;屈服、恭順による刻印
		;LV1
	ELSEIF TFLAG:屈服刻印取得 == 31
		PRINTL
		PRINTFORML 「%K17_CNAME()%... 후후.」
		PRINTFORML 「너는 알잖아... 음ー... 음ー... 아니, 됐어.」
		PRINTFORMDL 고개를 기울이고 잠시 생각한 뒤, %조사처리(CALLNAME:TARGET,"는")% 마침내 귀여운 작은 웃음을 터뜨렸다.
		PRINTW
		;LV2
	ELSEIF TFLAG:屈服刻印取得 == 32
		PRINTL
		PRINTFORML 「%K17_CNAME()%, 기분이 어때? 피곤해? 어깨를 주물러 줄까?」
		PRINTFORMDL 갑자기 그녀에게 무슨 일이 생긴 걸까...?
		PRINTW
		;LV3
	ELSEIF TFLAG:屈服刻印取得 == 33
		PRINTL
		PRINTFORML 「%K17_CNAME()%, 기분이 어때? 피곤해? 내 가슴 마사지 받고 싶어?」
		PRINTFORMDL 또 무슨 변화가 생긴 거야, 갑자기 왜 이러는 거지?
		PRINTW
		PRINTFORMDL …잠깐, 그녀가 마지막에 뭐라고 했지?
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-1)
		PRINTW
	ENDIF
	;反発刻印
	IF TFLAG:反発刻印取得 == 1
		PRINTL
		PRINTFORML 「당신의 행동은 그저 끔찍하고, 그것을 가볍게 말하는 것이에요.」
		PRINTFORML 「그렇게 다른 사람들을 괴롭히면서 남들이 당신을 미워하게 만들려는 건가요?」
		PRINTFORML 「만약 그렇다면, 당신이 하는 일은 잘못된 거예요.」
		PRINTFORML 「이해했나요? 제가 경고하지 않았다고 말하지 마세요.」
		PRINTFORML 「저는 이것을 자기 계발의 기회로 삼기를 추천하고 싶네요.」
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,1)
		PRINTW
	ELSEIF TFLAG:反発刻印取得 == 2
		PRINTL
		PRINTFORML 「...나를 그저 평범하고 어리석은 어린애로만 보는 거야?」
		PRINTFORML 「내 정도의 수준이라면 맨손으로 사람의 두개골을 부술 만한 악력은 충분히 가지고 있지.」
		PRINTFORMDL 차가운 시선으로 상대를 고정시키며, %조사처리(CALLNAME:TARGET,"는")% 손으로 움켜쥐는 동작을 취한다.
		PRINTFORML 「앞으로는 행동 방식을 바꾸라고 추천해 줄게.」
		PRINTFORML 「이것을 마지막 경고로 생각해 두도록 해.」
		PRINTW
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,2)
	ELSEIF TFLAG:反発刻印取得 == 3
		PRINTL
		PRINTFORML 「...」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 그저 먼 곳을 응시한다.
		PRINTFORMDL 그녀는 네 존재에 조금이라도 반응하지 않는 듯하다.
		PRINTFORMDL 그녀는 이제 너를 차갑게 바라볼 가치조차 없는 것 같다.
		PRINTW
		;素質も変えちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,2)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,2)
	ENDIF
ENDIF
