@M_KOJO_EVENT_K17_5(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;うふふ中はとりあえず飛ばして情事を見られたほうだけ表示
IF LOCAL && !CFLAG:うふふ
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;知り合いが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && K17_GET_FRIENDS(ARG)
		PRINTFORML 「Uu... %K17_GT()%, %K17_CNAME(ARG)%.」
		;アリスが恋人な場合
		IF TALENT:TARGET:恋人 == 1
			PRINTFORML 「우리는 이상한 짓을 하는 게 아니야. %K17_CNAME(ARG)%, 그렇게 우리를 %K17_RS("놀리다/조롱하다")% 하지 마.」
			;相手がマスターの恋人　はわわ……
			;とりあえず相手馴れ合い強度０以下はないみたいだから呼ばれないはず　どっか別に作る
			;自分が入った時用のをつくればいいのか
		ELSEIF TALENT:ARG:恋人 == 1
			SELECTCASE ARG
				CASE K17C_神綺ID,K17C_夢子ID,K17C_ルイズID,K17C_魅魔ID
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 힘차게 자세를 바로잡고 똑바로 선다.
					PRINTFORML 「...그냥 %NAME:MASTER%-상하고 조금 이야기 나누던 것뿐이에요.」
					PRINTFORMDL 당신은 결국 모르는 사람 취급을 받는다...
				CASEELSE
					PRINTFORML 「오해하지 말아줘, %K17_CNAME(ARG)%, 우리는 그냥 평범하게 대화했을 뿐이야...」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:ARG%의 용모에 잠시 당황한 것 같다.
			ENDSELECT
		ENDIF
		;-------------------------------------------------
		;知らない人が入ってきた
		;-------------------------------------------------
	ELSE
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) %CALLNAME:ARG%에게 옆눈으로 흘겨본다.
	ENDIF
	;-------------------------------------------------
	;共通処理
	;-------------------------------------------------
	SELECTCASE K17_GRT()
		CASE IS >= K17C_恋慕
			CALL HPH_PRINT,@"「...이대로 어디선가 더 할까 %K17_RS("private/quiet/we can relax")%...HPH」", "L"
			PRINTFORMDL 당신의 귓가에 이것을 속삭이며, %조사처리(CALLNAME:TARGET,"는")%(는) 당신 옆에서 한 걸음 물러난다.
		CASE IS >= K17C_思慕
			PRINTFORML 「...%K17_RS("미안해/정말 미안해/유감스럽지만")%, 일단 여기서 그만둬야 할 것 같아...」
			PRINTFORMDL 당신의 귀에 속삭이며, %조사처리(CALLNAME:TARGET,"는")%(는) 당신 옆에서 한 걸음 물러선다.
		CASEELSE
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 퉁명스럽게 등을 돌린다.
	ENDSELECT
	PRINTW
ENDIF
RETURN 1
