@M_KOJO_EVENT_K17_9(ARG,ARG:1)
;口上主はTARGET
;ARG:1 == 1		同じ場所に居てパンツを回収された
;ARG:1 == 2		遠距離移動中にパンツを回収された
;--------------------------------------------------
#DIM DYNAMIC iDoll		;人形フラグ
#DIM DYNAMIC iPants_Num	;輸送中のアリスのパンツ枚数
VARSET iDoll
iPants_Num = 0
CFLAG:K17C_ID:K17C_CF_パンツ没収 = MIN(CFLAG:K17C_ID:K17C_CF_パンツ没収,9999)
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;--------------------------------------------------
	;初回限定
	;--------------------------------------------------
	iPants_Num = K17_CHECK_輸送パンツ(TARGET)
	IF FIRSTTIME("パンツ没収")
		PRINTL
		PRINTFORML 「자, 이제 뭘 숨기고 있는 거지...」
		PRINTW
		;手持ちに自分のパンツがあるか見る　仕様変更に対応
		IF iPants_Num
			PRINTFORML 「말도 안 돼... 이거 내 속옷이라고?」
			PRINTFORML 「어떻게! ...아니, 왜?!」
			PRINTFORML 「에...? 설마...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 무언가를 생각하며 의심스러운 눈길을 당신에게 보낸다.
			CFLAG:K17C_ID:K17C_CF_パンツ没収++
		ELSE
			PRINTFORML 「오호... 이건... 여자 속옷인가?!」
			PRINTFORML 「에? 에?! 왜 이런 걸 가지고 있는 거야?」
		ENDIF
		PRINTFORMDL 그녀가 당신을 더 비난할 거라고 생각했지만, 그녀의 반응은 놀라울 정도로 차분하다.
		PRINTFORMDL 그녀는 이런 종류의 일에 익숙하지 않은 건가?
		PRINTW
		PRINTFORML 「...이 속옷으로 도대체 뭘 할 생각이야?」
		;custom code
		SIF CFLAG:K17C_ID:1092
			PRINTFORMDL "그게, 뭐... 있잖아?"
		PRINTFORMDL 너는 위에서 %조사처리(CALLNAME:TARGET,"에게")% 팬티의 거부할 수 없는 매력을 설명한다.
		PRINTFORMDL ...
		PRINTFORMDL ......
		PRINTFORMDW .........
		PRINTFORML 「어, 음... 그거 꽤나 굉장한... 취미를 가지고 있군요.」
		;アリスパンツあり　海外の人は下着ドロあんま理解できないらしいです
		IF iPants_Num
			PRINTFORML 「처음에 그것을 성희롱으로 정확히 이해하지 못해서 미안해.」
			PRINTFORML 「아, 사과할 필요는 없는 거겠지... 그냥 아직 좀 충격이 남아있어.」
		ENDIF
		PRINTFORML 「...내가 이걸 이해하기 어려운 건 그저 문화적 장벽 때문이라고 생각한다.」
		PRINTFORML 「게다가 다른 사람의 소지품을 훔치는 것은 애초에 아주 바람직한 행동이 아니다.」
		PRINTFORML 「어쨌든, 너는 이런 종류의 유치한 장난은 정말 자제해야 한다.」
		;--------------------------------------------------
		;二回目以降
		;--------------------------------------------------
	ELSE
		PRINTL
		PRINTFORML 「또 무언가를 숨기고 있군... 넘겨라.」
		PRINTW
		;手持ちに自分のパンツがあって時間停止バレしてるとき
		IF iPants_Num && CFLAG:時間停止バレ == 1
			;アリスパンツ2回目以降
			PRINTFORML 「이건... 또 내 속옷이네, 안 그래?」
			;思慕前だとビンタ
			IF K17_GRT(TARGET) < K17C_思慕
				PRINTFORML 「이거 그만하라고 말했잖아!」
				PRINTFORMDL 그녀가 당신에게 쩌적 소리를 내며 손바닥으로 때린다.
				RETURN 1
			ELSE
				PRINTFORML 「정말이지, %K17_RS("다른 여자들한테도 훔쳐? / 이대로 얼마나 더 할 작정이야? / 항상 이렇게 해?")%?」
				PRINTFORMDW 흥얼흥얼...
				PRINTFORMDW ...나그네...
				PRINTFORMDW ...흥얼흥얼... 나그네...
				PRINTFORMDW 여성들에 대한 네 태도를 좀 재고해...!
			ENDIF
			;アリスのパンツだけあったとき
		ELSEIF iPants_Num
			PRINTFORML 「이건... 나의...」
			PRINTFORML 「어라... 설마...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 무언가를 생각하며 의심스러운 눈길을 당신에게 보낸다.
			CFLAG:K17C_ID:K17C_CF_パンツ没収++
			;その他のパンツ
		ELSE
			PRINTFORML 「역시 여자들의 속옷이군.」
		ENDIF
	ENDIF
	;--------------------------------------------------
	;時間停止バレ もうちょい条件緩くするか考え中 とりあえず20％でいいか 咲夜さん即バレ仕方ないね
	;現行犯なので疑いなくてもバレる
	;--------------------------------------------------
	IF K17_CHECK_時間停止バレ(TARGET,20)
		PRINTFORML 「이것은... 내 속옷이야...」
		PRINTFORML 「이제 확실해졌어. 내가 알아차리지 못할 거라고 생각했나?」
		PRINTFORML 「자, 그렇다면 도대체 이걸 어떻게 훔쳤지, 음...?」
		PRINTFORMDL 최악의 상황을 대비하는 게 좋을 것 같군.
		PRINTL
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 시간 정지 능력을 발견했다!
		PRINTW
		CALL K17_時間停止バレ
	ENDIF
	PRINTW
	PRINTFORML 「어쨌든, 이것들은 내가 가지겠어.」
	PRINTFORML 「그리고 네 생각에 대해 내 의견을 바꿔야 할 것 같아.」
	;パンツ没収でアリスのプライドと態度が復活するのだ
	CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,1)
	CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,1)
	;疑いあれば追加なし　バレてるなら恋慕未満でなし
	IF CFLAG:K17C_ID:K17C_CF_疑い || (CFLAG:時間停止バレ && K17_GRT(TARGET) < K17C_恋慕)
		SIF RESULT == 0
			PRINTW
		RETURN 1
	ENDIF
	;--------------------------------------------------
	;思慕以上あれば追加イベ
	;--------------------------------------------------
	IF K17_GRT(TARGET) >= K17C_思慕
		PRINTFORML 「진심으로... 정말 이것들을 원한다면 그냥 줄 수도 있었을 텐데.」
		PRINTFORMDL 뭐...?!
		PRINTW
		PRINTFORML 「나는 내 인형들을 위해 정기적으로 옷을 만들어주므로, 나의 바느질 실력에 꽤 자신 있다.」
		SELECTCASE RAND:3
			CASE 0
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "수제라니! 대단하네."
					PRINTFORMDL "하지만 물론, 네가 입고 있는 걸 원해."
				ELSE
					PRINTFORMDL 직접 만든 거야! 굉장해.
					PRINTFORMDL 하지만 그녀에게 지금 입고 있는 게 더 좋다고 말한다.
				ENDIF
				PRINTFORML 「하아아?! 너 분명 새 걸 얻고 있잖아!」
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "하지만 그러면 소용이 없잖아!"
				ELSE
					PRINTFORMDL 그럼 그게 무슨 소용이야?!
				ENDIF
			CASE 1
				PRINTFORML 「지금 좀 가지고 있어. ...여기 있네.」
				PRINTFORMD 그녀가 건네주는 팬티 
				PRINTDATADL
					DATAFORM 정교하게 만들어졌다.
					DATAFORM 진짜처럼 보인다.
					DATAFORM 귀엽게 제작되었다.
					DATAFORM 장인의 영혼으로 빛난다.
				ENDDATA
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "...잠깐, 이건 그냥 인형 옷이야!"
				ELSE
					PRINTFORMDL …잠깐, 이건 그냥 인형 옷일 뿐이야!
				ENDIF
				iDoll = K17_GET_DOLL(0)
				IF iDoll && RAND:2
					iDoll = K17_GET_DOLL(-1)
					PRINTFORM 「아라, 그것들은 %K17C_人形名:iDoll%의 것이야.」
					TRYCALL K17_人形台詞(K17C_人形:iDoll,1,"How embarrassingー")
				ELSE
					PRINTFORM 「아라, 그것들은 ~을 위한 거야」 
					PRINTDATA
						DATAFORM 런던의 한 곳
						DATAFORM 프랑스인 한 명
						DATAFORM 교토의 한 곳
						DATAFORM 네덜란드인 한 명
						DATAFORM 러시아인 한 명
						DATAFORM 오를레앙의 한 곳
					ENDDATA
					PRINTFORML  인형.
				ENDIF
				PRINTFORMDL 어떻게 반응해야 할지 모르겠군...
			CASE 2
				PRINTFORML 「지금 좀 가지고 있어. ...자 여기 있어.」
				PRINTFORMD 그녀는 "
				PRINTDATAD
					DATAFORM 상하이
					DATAFORM 호라이
					DATAFORM 런던
					DATAFORM 프랑스어
					DATAFORM 교토
					DATAFORM 네덜란드어
					DATAFORM 러시아어
					DATAFORM 오를레앙
					DATAFORM 골리앗
				ENDDATA
				PRINTFORMDL  doll" embroidered on it.
				PRINTFORMDL ...You're happy to take this, but...
				PRINTFORML 「Hmm? Isn't it fine as long as it's a woman's? It's newly made, too.」
				;custom code
				IF CFLAG:K17C_ID:1092
					PRINTFORMDL "그것이 정말 문제인 건 아니다."
				ELSE
					PRINTFORMDL 그게 진짜 문제는 아니다.
				ENDIF
		ENDSELECT
		PRINTW
	ENDIF
ENDIF
RETURN 1
