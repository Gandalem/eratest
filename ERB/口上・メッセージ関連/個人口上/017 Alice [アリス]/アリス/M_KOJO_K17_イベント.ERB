		ENDIF
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 재빨리 손을 입에 가져다 대고 목소리를 막는다.
		IF K17_AP_FINISH() != ""
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_受け_お手伝い系
			PRINTFORML （%K17_AP_FINISH()%）
		ENDIF
		;-------------------------------------------------
		;時間停止バレ
		;-------------------------------------------------
		IF CFLAG:時間停止バレ
			SELECTCASE iRT
				CASE IS >= K17C_思慕うふふ
					PRINTFORML 「...그냥 평소처럼 할 수 있잖아... 바보 같아.」
				CASE IS >= K17C_思慕
					PRINTFORML 「뭐... 뭘 한다고 생각하는 거야...」
				CASEELSE
					PRINTFORML 「너야말로...최악이야...」
			ENDSELECT
			;-------------------------------------------------
