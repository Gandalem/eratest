			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "What's with you, all of a sudden..."
			ELSE
				PRINTFORMDL What's this, all of a sudden...
			ENDIF
			PRINTFORMDL %CALLNAME:TARGET% makes a determined pose as if she's made up her mind about something.
			CALL HPH_PRINT,"「...Uu... Uuu～～～BPB」", "L"
			PRINTFORMDL But as she turns to you, her whole face turns beet red up to the tips of her ears and she lowers her gaze.
			PRINTFORML 「～～～Ahhh, arrgghhhー」
			PRINTFORMDL She starts beating on you with her fists.
			PRINTFORMDL It doesn't really hurt, and it's kind of cute.
			PRINTW
			CALLF FIRSTTIME("告白イベント")
		ENDIF
		
		;-------------------------------------------------
		;二回目以降ここから
		;-------------------------------------------------
		PRINTFORML 「Nn, let me...do this for a little...」
		PRINTFORMDL %CALLNAME:TARGET% suddenly stops, pulls your %K17_RS("arm/hand")% towards her, and %K17_RS("buries her face in your chest/embraces you")%.
		PRINTFORMDL She stays like that for a while, nuzzling her face against your chest.
		PRINTW
		
		;MASTERに恋人がいてアリスではないとき　本家からはこない
		IF !(CFLAG:TARGET:1 & 4) && TALENT:MASTER:恋人
			SELECTCASE iRT
				CASE IS >= K17C_恋慕
					IF K17_GET_FRIENDS(TALENT:MASTER:恋人)
						PRINTFORML 「...I know I'm doing something %K17_RS("bad/inexcusable")% towards %K17_CNAME(TALENT:MASTER:恋人)%.」
					ELSE
						PRINTFORML 「...I know I'm doing something %K17_RS("bad/inexcusable")% towards your lover.」
					ENDIF
					PRINTFORML 「But I can't help but %K17_RS("like/love/want to be with")% you.」
					PRINTFORML 「I'm fine with just being %K17_RS("a member of your harem/your mistress/your concubine")%, so remember this...」
					PRINTFORML 「...I love you.」
				CASE IS >= K17C_思慕
					PRINTFORML 「Maybe...this is %K17_RS("a bad thing to/something I shouldn't")% do...」
					PRINTFORML 「But I can't stop myself...」
					PRINTFORML 「...I like you.」
			ENDSELECT
			PRINTFORMDL You can't do anything but continue to stroke %CALLNAME:TARGET%'s head.
			
		ELSEIF TALENT:K17C_ID:恋人 == 1
			;恋人同士
			PRINTFORML 「Fuu... I'm sorry. Ah, I should say thank you, instead.」
			PRINTFORML 「My hair... Ahh... Auu...」
			PRINTFORMDL As Alice allowing herself to be spoiled like this is pretty rare, you take the opportunity and stroke her hair.
			PRINTFORML 「Even though we've already become lovers, you still go out on dates with me.」
			SELECTCASE iRT
				CASE IS >= K17C_性癖
					CALL HPH_PRINT, @"「%K17_CNAME(0,1)%, I love youHPH I love youHPHHPH So muchHPH」", "L"
					PRINTFORML 「Why do you love me so much, seriously...」
					PRINTFORML 「Thank you for everything, really. I love you, %K17_CNAME(MASTER,1)%.」
				CASE IS >= K17C_恋慕告白
					PRINTFORML 「Thank you for always %K17_RS("taking care of/loving/caring for")% me.」
					PRINTFORML 「I love you.」
				CASE IS >= K17C_思慕うふふ
					PRINTFORML 「%K17_CNAME()%, you like me, right...?」
					PRINTFORML 「Fufu, no, I like you even more.」
				CASE IS >= K17C_思慕
					PRINTFORML 「Fufu... %K17_RS("You get full marks/That's the spirit/You really get me, don't you")%.」
					PRINTFORML 「I've fallen for you all over again.」
			ENDSELECT
			PRINTFORMDL You're just glad %CALLNAME:TARGET% is happy.
			PRINTFORMDL You spend a blissful moment with your %K17_RS("beloved/dear/precious lover")% %CALLNAME:TARGET%.
			
			
		;-------------------------------------------------
		;お互いまだ誰とも付き合ってない時 本来の仕様
		;-------------------------------------------------
		ELSEIF !TALENT:MASTER:恋人
			
			;-------------------------------------------------
			;告白　初回
			;-------------------------------------------------
			IF CFLAG:K17C_ID:K17C_CF_告白イベント == 1
				PRINTFORML 「Hey, what exactly are we...?」
				SIF iRTF & K17C_RTF_キス
					PRINTFORML 「We've already kissed...」
				SIF iRTF & K17C_RTF_うふふ
					PRINTFORML 「We already have...a physical relationship...」
				SIF !FIRSTTIME("オナバレ",1)
					PRINTFORML 「You've already seen me...d-doing that, in my home...」
				
				PRINTFORMDL That's certainly true... Your relationship with her is still unclear.
				PRINTFORML 「You're not going out with anyone right now, right?」
