	PRINTFORM 대화 버전 차이가 감지되어 자가 진단을 시작한다.
	;------------
	;Ver 0.02
	;------------
	IF CFLAG:K17C_ID:K17C_CF_VER < 002
		;スカートめくりで与えた既読を取り消し修正 動作テストおｋ
		;CSTRから指定文字列を検索して削除　/切り詰め
		TEMP = K17_AUTO_SPLIT_NUM(CSTR:K17C_ID:0,"/","330口上")
		;既読＆現条件式を見る
		IF CFLAG:K17C_ID:好感度 <= 5000 && TEMP != -1
			;既読を取り消し
			CSTR:K17C_ID:0 = %K17_CHANGE_SPLIT(CSTR:K17C_ID:0,"/",TEMP)%/
			;修正アナウンス
			CALL COLORMESSAGE("\n이 이미 실행했던 명령어 [치마 뒤집기]는 초기화되었다.",K17C_蓬莱COLOR,1)
			CALL COLORMESSAGE("판단 기준이 이전 버전과 변경되었으니 다시 선택해 주세요...",K17C_蓬莱COLOR,1)
		ENDIF
	ENDIF
	;------------
	;Ver 0.03
	;------------
	IF CFLAG:K17C_ID:K17C_CF_VER < 003
		;新フラグの初期設定　しなくてもいいけど一応
		IF !CFLAG:K17C_ID:K17C_CF_喘ぎRT
			PRINTFORM \n새 플래그를 초기화하는 중…
			CALL K17_SET_AUTO_PVOICE(-1,-1,K17C_受け_おねだり系)
			PRINTFORMW  초기화되었다.
		ENDIF
	ENDIF
	;------------
	;Ver 0.10
	;------------
	IF CFLAG:K17C_ID:K17C_CF_VER < 010
		;新フラグの初期設定　喘ぎタイプの保存
		PRINTFORML \nVer0.10 업데이트…
		IF CFLAG:K17C_ID:既成事実 & 合意_うふふ
			PRINTFORM 성적 동의가 확인되었습니다…
			PRINTFORM \n새 플래그를 초기화하는 중… 
			CALL K17_SET_AUTO_PVOICE(,,K17C_受け_おねだり系)
			PRINTFORMW 설정이 적용되었다.
		ENDIF
		;セクハラ
		IF !FIRSTTIME("(313|315|316)口上",1,K17C_ID)
			PRINTFORM 성희롱 명령어 사용 경험 감지됨…
			PRINTFORM \n새 플래그 초기화 중… 
			CALL K17_SET_AUTO_PVOICE(,,K17C_受け_合意襲い系)
			PRINTFORMW 설정이 적용되었다.
		ENDIF
		;オナバレックス経験してれば無理矢理系保存
		IF !FIRSTTIME("オナバレックス初回",1,K17C_ID)
			PRINTFORM " 자위 이벤트(오나바레) 섹스"가 목격되었다.
			PRINTFORM \n 새로운 플래그들을 초기화한다. 
			CALL K17_SET_AUTO_PVOICE(,,K17C_受け_無理矢理系)
			PRINTFORMW 설정이 적용되었다.
		ENDIF
		;押し倒されたことあれば基本を保存
		IF !FIRSTTIME("押し倒され",1,K17C_ID)
			PRINTFORM 플레이어는 이전에 앨리스에게 밀쳐진 적이 있다……
			PRINTFORM \n새 플래그를 초기화하는 중이다…… 
			CALL K17_SET_AUTO_PVOICE(,,K17C_攻め_お手伝い系)
			PRINTFORMW 설정이 적용되었다.
		ENDIF
	ENDIF
	;------------
	;Ver 0.13
	;------------
	IF CFLAG:K17C_ID:K17C_CF_VER < 013
		;MIN内でインクリメントしていたバグがあったため
		;経験していても、フラグ値が加算されていないデータ用
		IF CFLAG:K17C_ID:K17C_CF_上海イベント == 0 && !FIRSTTIME("上海イベント",1,K17C_ID)
			PRINTFORM 상하이 이벤트가 있는지 확인한다...
			CFLAG:K17C_ID:K17C_CF_上海イベント++
			PRINTFORM \n플래그는 설정되었지만, 이건 어쩌면 수정할 수 없을지도 모른다. 미안하다\n
		ENDIF
		IF CFLAG:K17C_ID:K17C_CF_告白イベント == 0 && !FIRSTTIME("告白イベント",1,K17C_ID)
			PRINTFORM 고백 이벤트가 있는지 확인한다...
			CFLAG:K17C_ID:K17C_CF_告白イベント++
			PRINTFORM \n플래그는 설정했지만, 이건 수정할 수 없을지도 모릅니다. 죄송합니다\n
			IF K17_RT_FG(K17C_ID) != CFLAG:K17C_ID:K17C_CF_RTF
				PRINTFORM 저장 플래그에 차이가 감지되었다... 
				CFLAG:K17C_ID:K17C_CF_RTF = K17_RT_FG(K17C_ID)
				PRINTFORMW 플래그가 업데이트되었다!
				PRINTFORML 힌트를 표시한다.
				PRINTL
				TRYCALL K17_HINT()
				PRINTW
			ENDIF
		ENDIF
	ENDIF
	;------------
	;口上バージョンの更新
	;------------
	CFLAG:K17C_ID:K17C_CF_VER = K17C_VER
	PRINTFORMW 버전이 업데이트되었다.
ELSEIF CFLAG:K17C_ID:K17C_CF_VER  == K17C_VER
	PRINTFORML 현재 최신 버전을 실행 중이다.
ELSE
	PRINTFORML 저장 데이터가 대화 버전에 일치하지 않습니다.
	PRINTFORML 저장 데이터 Ver. {CFLAG:K17C_ID:K17C_CF_VER/100}.{CFLAG:K17C_ID:K17C_CF_VER%100/10}{CFLAG:K17C_ID:K17C_CF_VER%10}
	PRINTFORML 현재 대화 Ver. {K17C_VER/100}.{K17C_VER%100/10}{K17C_VER%10}
ENDIF
CALL COLORMESSAGE(@"망상의산물 에로틱 걸 앨리스 설정・업데이트 시작",K17C_アリスCOLOR,1)
;なんだこの計算は（驚愕 あっれーなんかこういう命令なかったっけ
PRINTFORMW 버전. {K17C_VER/100}.{K17C_VER%100/10}{K17C_VER%10}
RETURN 1
