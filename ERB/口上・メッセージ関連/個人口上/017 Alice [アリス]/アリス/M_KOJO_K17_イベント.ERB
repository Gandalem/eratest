			;-------------------------------------------------
		ELSEIF !CFLAG:K17C_ID:K17C_CF_疑い
			;自分のパンツ没収未経験
			SIF !FIRSTTIME("時間停止解除")
				PRINTFORML (%K17_CNAME()%이/가) 주변에 있을 때 이런 일이 자주 일어나는 것 같아...
			PRINTFORML (이건 ... 나의 몸이 ... %K17_CNAME()%을 욕정한다는 뜻인가...?)
		ENDIF
		;時間停止経験保存
		CALLF FIRSTTIME("時間停止解除")
	ENDIF
	;-------------------------------------------------
	;パンツ紛失のみ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「%K17_RS("Wha/Eh/Fweh")%...?!」
