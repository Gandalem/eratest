				ENDIF
			ELSE
				PRINTFORML 「아, 내가 방해하는 것 같군요.」
			ENDIF
		ENDIF
		IF K17_GET_FRIENDS(FLAG:デート相手) && K17_RT_FG(TARGET) == 0
			;アリスにフラグが立ってない時　デート相手がアリスの知り合い
			SELECTCASE FLAG:デート相手
				CASE K17C_魔理沙ID,K17C_霊夢ID,K17C_咲夜ID
					PRINTFORML 「%K17_CNAME(FLAG:デート相手)%와 즐거운 시간 보내.」
				CASE K17C_幽香ID,K17C_パチュリーID,K17C_メディスンID
					PRINTFORML 「%K17_CNAME(FLAG:デート相手)%는 조금 어려울 수 있지만, %HIM_HER(FLAG:デート相手,,1)%와 잘 지내려고 최선을 다해라.」
				CASE K17C_神綺ID,K17C_夢子ID,K17C_ルイズID,K17C_魅魔ID
					PRINTFORML (%K17_CNAME(FLAG:デート相手)%도 데이트를 하는 건가...)
					PRINTFORML (%HE_SHE(FLAG:デート相手)%'은 결혼에 관심이 있을지 궁금하네...)
				CASEELSE
					PRINTFORML (저 %PRINT_MALE("boy", FLAG:デート相手)%는 꽤 행복해 보였다...)
			ENDSELECT
		ENDIF
		PRINTW
		;他キャラとデート中に遭遇した終端
	ENDIF
ENDIF
RETURN 1
