;==================================================
;他者介入でムード変化
;==================================================
@M_KOJO_EVENT_K17_5(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;うふふ中はとりあえず飛ばして情事を見られたほうだけ表示
IF LOCAL && !CFLAG:うふふ
	
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;知り合いが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && K17_GET_FRIENDS(ARG)
		
		PRINTFORML 「Uu... %K17_GT()%, %K17_CNAME(ARG)%.」
		
		;アリスが恋人な場合
		IF TALENT:TARGET:恋人 == 1
			PRINTFORML 「We're not doing anything strange. %K17_CNAME(ARG)%, don't %K17_RS("tease/make fun of")% us like that.」
		
		;相手がマスターの恋人　はわわ……
		;とりあえず相手馴れ合い強度０以下はないみたいだから呼ばれないはず　どっか別に作る
		;自分が入った時用のをつくればいいのか
		ELSEIF TALENT:ARG:恋人 == 1
			SELECTCASE ARG
				CASE K17C_神綺ID,K17C_夢子ID,K17C_ルイズID,K17C_魅魔ID
					PRINTFORMDL %CALLNAME:TARGET% vigorously corrects her posture and stands up straight.
					PRINTFORML 「...I was just chatting a little with %NAME:MASTER%-san.」
					PRINTFORMDL You end up getting treated like a stranger...
				CASEELSE
					PRINTFORML 「Please don't get the wrong idea, %K17_CNAME(ARG)%, we were just chatting normally...」
					PRINTFORMDL %CALLNAME:TARGET% seems to be momentarily flustered by %CALLNAME:ARG%'s appearance.
			ENDSELECT
		ENDIF
	;-------------------------------------------------
	;知らない人が入ってきた
	;-------------------------------------------------
	ELSE
		PRINTFORMDL %CALLNAME:TARGET% gives %CALLNAME:ARG% a sidelong glance.
	ENDIF
	;-------------------------------------------------
	;共通処理
	;-------------------------------------------------
	SELECTCASE K17_GRT()
		CASE IS >= K17C_恋慕
			CALL HPH_PRINT,@"「...Let's continue this somewhere %K17_RS("private/quiet/we can relax")%...HPH」", "L"
			PRINTFORMDL Whispering this into your ear, %CALLNAME:TARGET% takes a step away from your side.
		CASE IS >= K17C_思慕
			PRINTFORML 「...%K17_RS("Sorry/I'm sorry/Unfortunately")%, it looks like we'll have to stop for now...」
			PRINTFORMDL Whispering this into your ear, %CALLNAME:TARGET% takes a step away from your side.
		CASEELSE
			PRINTFORMDL %CALLNAME:TARGET% curtly separates from you.
	ENDSELECT
	PRINTW
ENDIF
RETURN 1

