@M_KOJO_EVENT_K17_10(ARG,ARG:1)
#DIM DYNAMIC iRT = 0
#DIM DYNAMIC iFriends = 0
;----------
;アリス以外のTARGETを取得　友人優先
;----------
iFriends = K17_GET_TARGETS_ID()
iRT = K17_GRT_EX(TARGET)
;--------------------------------------------------
;口上主はTARGET
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;MASTERを押し倒した（開始時）
	;二人きり
	;押し倒された瞬間には既成事実入ってない　すぐ抜け出すと合意を得ない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------
		;開始時の保存
		;喘ぎタイプ決定
		;開始時の主導権
		;溜まってる度の一時保存
		;-------------------------
		TCVAR:K17C_ID:K17C_TC_うふふ主導権 = TARGET
		TCVAR:K17C_ID:K17C_TC_中出しカウント = 0
		IF TALENT:MASTER:性別 >= 2
			TCVAR:K17C_ID:K17C_TC_溜まってる度 = BASE:MASTER:精力
		ELSE
			TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:溜まってる度
		ENDIF
		;-----------
		;抱きつきモード
		;-----------
		IF ARG:1 || CFLAG:K17C_ID:K17C_CF_喘ぎタイプ == K17C_攻め_おねだり系
			CALL K17_SET_AUTO_PVOICE(iRT,-1,K17C_攻め_おねだり系)
			PRINTFORML 「후후... 응석받이가 되고 싶어지네... %K17_RS("Nyaau/Funyaa")%～」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 팔을 당신에게 감고 몸을 비빕니다.
			PRINTW
			RETURN 1
		ENDIF
		;-----------
		;弱み握りのお仕置き
		;-----------
		IF CFLAG:弱み握り || CFLAG:K17C_ID:K17C_CF_喘ぎタイプ == K17C_攻め_無理矢理系
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 그녀의 외모와는 어울리지 않는 믿을 수 없는 힘으로 당신을 아래로 밀어붙인다.
			PRINTFORML 「후후... 이제 너의 벌 시간이야... 준비하고 있길 바라.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 눈에 비치는 특이한 빛과 함께 당신의 귓가에 가르릉거리자, 등골을 타고 차가운 전율이 흐른다...
			CALL K17_SET_AUTO_PVOICE(iRT,-1,K17C_攻め_無理矢理系)
			PRINTW
			RETURN 1
		ENDIF
		;-----------
		;通常カウンターうふふ初回
		;-----------
		IF CFLAG:既成事実 & 合意_うふふ && FIRSTTIME("押し倒され",1)
			PRINTFORML 「흐, 저기... 생각해 봤는데... 오늘, 어쩌면... 음...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 어떤 이유로 당신에게 매달리며 초조하게 허벅지를 비빈다.
			PRINTFORML (뭐 하는 거지... 평소 같으면 하지 않을 텐데... 망설이고 있어... 우우...)
			PRINTW
			PRINTFORML 「나-나는 아이디어가 있었어, 만약 네가 원한다면, 물론이지...」
			PRINTFORML 「결국 나는 마녀니까...」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 이렇게 말하며 손을 휘두르고, 마법의 실타래를 만들어 날려 너를 묶는다.
			PRINTFORMDL 그것들이 너 주위로 조여오지만, 고통스러운 구속이라기보다는 부드러운 포옹처럼 느껴진다.
			PRINTFORML 「후후... 어때? ...아, 아파? 괜찮아?」
			PRINTW
			PRINTFORML 「나 비웃지 마아~」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "그렇게 귀여운 마녀에게 공격받는 것도 나쁘지 않을지도 모른다."
			ELSE
				PRINTFORMDL 그렇게 귀여운 마녀에게 공격당하는 것도 나쁘지 않다고 느낀다.
			ENDIF
			PRINTFORML 「조심하지 않으면 너를 먹어버릴 거야... 크윽...」
			PRINTFORMDL 얼굴을 붉히며 %조사처리(CALLNAME:TARGET,"는")%(는) 마치 잠들게 하려는 듯 당신을 부드럽게 밀어눕힌다.
			CALLF FIRSTTIME("押し倒され")
			CALL K17_SET_AUTO_PVOICE(iRT,-1,K17C_攻め_お手伝い系)
			;-----------
			;合意無しでカウンターうふふ初回にきた場合　もったいないので溜まってる度半分超えててもこれで
			;-----------
		ELSEIF !(CFLAG:既成事実 & 合意_うふふ) || CFLAG:溜まってる度 >= 500 || CFLAG:K17C_ID:K17C_CF_喘ぎタイプ == K17C_攻め_合意襲い系
			PRINTFORML 「후우... 후우...」
			PRINTFORML 「%K17_CNAME()%, 나... 나는 꽤 참았다고 생각해... 이해하지? 」
			PRINTFORMDL 정신을 차리려 할 때, 엄청난 힘에 아래로 밀쳐진다.
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 빛으로 된 인형 줄이 너를 단단히 묶고, 아무리 애써도 근육 하나 움직일 수 없다.
			PRINTW
			PRINTFORML 「미안해, 너를 놀라게 하려는 건 아니야... 하지만 이 감정들이 내 안에서 계속 차오르고 있어...」
			PRINTFORML 「그래서 내가... 널 강제로 취할 거야...」
			PRINTFORMDL 격렬한 홍조와 미세한 땀이 이마에 맺힌 채, %조사처리(CALLNAME:TARGET,"는")% 너 위로 올라탄다.
			CALL K17_SET_AUTO_PVOICE(iRT,-1,K17C_攻め_合意襲い系)
			;-----------
			;二回目以降　通常処理
			;-----------
		ELSE
			CALL K17_SET_AUTO_PVOICE(iRT,-1,K17C_攻め_お手伝い系)
			iRT = K17_LOWER_LIMIT_RAND(iRT,K17C_思慕,K17C_恋慕)
			SELECTCASE iRT
				CASE IS >= K17C_恋慕
					;台詞
					PRINTDATAL
						DATAFORM 「저기, 음... 우리...%K17_RS("do it/have sex")%?%K17_RS(" Please?/")%%K17_HEART()%」
						DATAFORM 「네가 내 몸을 이렇게 %K17_RS("lewd/obscene/lecherous")%하게 만든 이유야... 그러니까 책임 좀져줘...」
						DATAFORM 「나-나는... 너를 %K17_RS("d-do it with/a-assault/r-ravish")%할 거야... 그래서...」
					ENDDATA
					;情景
					PRINTDATAD
						DATAFORM %조사처리(CALLNAME:TARGET,"는")%(는) 몸을 비비며 그녀에게 다가갔다. 
						DATAFORM %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 손을 그녀의 %K17_RS("chest/cheek/thigh")%에 가져다 대고, 
						DATAFORM %조사처리(CALLNAME:TARGET,"는")%(는) 몸을 떨며 자신의 %K17_RS("crotch/chest")%를 당신에게 비비며 당신의 무릎 위에 앉았다. 
					ENDDATA
					PRINTFORMDL %K17_RS("gently/slowly")% %K17_RS("pushes you down/embraces you")%.
				CASE IS >= K17C_思慕
					;台詞
					PRINTDATAL
						DATAFORM 「...하자, 알았지? %K17_RS("부탁해?/")%%K17_HEART()%」
						DATAFORM 「...아니야 아무것도 안 할 거야? 안 한다면 난...」
						DATAFORM 「나-나는...%K17_RS("할 거야/네 기분 맞춰줄게")%...」
					ENDDATA
					;情景
					PRINTDATAD
						DATAFORM %조사처리(CALLNAME:TARGET,"는")% 당신의 몸에 기대어 그녀를 쓰다듬는다. 
						DATAFORM %조사처리(CALLNAME:TARGET,"는")% 당신의 손을 그녀의 %K17_RS("가슴/뺨/허벅지")%에 대고 누른다. 
						DATAFORM %조사처리(CALLNAME:TARGET,"는")% 그녀가 %K17_RS("당신의 허벅지를 문지른다/그녀의 가슴을 당신의 머리에 기댄다/당신의 뺨을 쿡 찌른다")%할 때 
					ENDDATA
					PRINTFORMDL %K17_RS("gently/slowly")% %K17_RS("pushes you down/embraces you")%.
				CASEELSE
					PRINTFORML 「이것으로... 괜찮은 거지? 나 좀... 답답해서... 그래서...」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) %K17_RS("gently/slowly")%로 너를 밀어눕힌다.
			ENDSELECT
			PRINTFORML 「%K17_RS("This is all your fault/You've made me like this")%, 그래서 이제 이 %K17_RS("bad/naughty/lewd")% %K17_RS("magician/witch")%이 당신을 공격할 겁니다... %K17_RS("Grrrー/Fufu./Fufufu～")%」
		ENDIF
		;----------------------------
		;乱交
		;----------------------------
		IF iFriends
			PRINTW
			SELECTCASE iFriends
				CASE K17C_霊夢ID,K17C_魔理沙ID,K17C_パチュリーID,K17C_幽香ID,K17C_咲夜ID,K17C_メディスンID
					;アリスが恋人な場合
					IF TALENT:TARGET:恋人
						PRINTFORML 「%K17_CNAME()%, 부디 %K17_CNAME(iFriends)%도 연모해 주길 바라요.」
					ENDIF
				CASE K17C_魅魔ID,K17C_ルイズID,K17C_神綺ID,K17C_夢子ID
					IF TALENT:TARGET:恋人
						PRINTFORML 「이번엔 같이 할 거야, 하지만... 나를 %K17_CNAME(iFriends)%랑 너무 비교하지 말아 줘, 알겠지?」
					ENDIF
				CASEELSE
					;アリスが恋人な場合
					IF TALENT:TARGET:恋人
						PRINTFORML 「%K17_CNAME()%, 너도 그들에게 연모를 주렴.」
					ENDIF
			ENDSELECT
			TRYCALL K17_乱交開始(iFriends)
			CALL K17_SET_AUTO_PVOICE(iRT,-1,K17C_攻め_おねだり系)
		ENDIF
		PRINTW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抱きつきモード満足
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2 && ARG:1 == 1
		PRINTFORML 「음~ 기분이 좋다... 후후.」
		PRINTW
		;タイプリセ
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
		TCVAR:K17C_ID:K17C_TC_うふふ主導権 = 0
		TCVAR:K17C_ID:K17C_TC_溜まってる度 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抱きつきモード強制終了
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2 && ARG:1 == 2
		PRINTFORML 「왜 그래, 그렇게 차울 필요는 없잖아...」
		PRINTW
		;タイプリセ
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
		TCVAR:K17C_ID:K17C_TC_うふふ主導権 = 0
		TCVAR:K17C_ID:K17C_TC_溜まってる度 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（うふふ終了時）
	;押し倒されたけどすぐに抜け出した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2 && !ARG:1 && !(CFLAG:既成事実 & 合意_うふふ)
		PRINTFORML 「우우... 하아... 미안해, 내가 상상했던 걸 그랬나 봐...」
		PRINTFORMDL 당신에게 거절당한 후, %조사처리(CALLNAME:TARGET,"는")% 눈에 눈물을 담고 시선을 돌린다.
		PRINTFORMDL 그녀에게 꽤 큰 충격이었던 모양이다...
		PRINTW
		;タイプリセ
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
		TCVAR:K17C_ID:K17C_TC_うふふ主導権 = 0
		TCVAR:K17C_ID:K17C_TC_溜まってる度 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（通常終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;弱みまだ残ってるか見る
		IF CFLAG:弱み握り
			PRINTFORML 「오늘은 이 정도로 넘어가 주지...」
			PRINTW
			RETURN 1
		ENDIF
		;感想戦
		TRYCALL K17_うふふ感想戦( TCVAR:K17C_ID:K17C_TC_うふふ主導権 , TCVAR:K17C_ID:K17C_TC_溜まってる度 )
		TCVAR:K17C_ID:K17C_TC_うふふ主導権 = 0
		TCVAR:K17C_ID:K17C_TC_溜まってる度 = 0
		;タイプリセ
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
		PRINTW
		RETURN 1
	ENDIF
ENDIF
RETURN 1
