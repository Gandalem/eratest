					;そのうちここで感想をプレイヤーに訊いてタイプチョイスの仕方を変えるか
				ELSEIF K17_GRT(TARGET) >= K17C_恋慕
					SELECTCASE iType
						CASE K17C_受け_無理矢理系
							CALL HPH_PRINT,"「하아, 하아... 믿을 수가 없어, 정말로」", "L"
							PRINTFORML 「이 것에 중독되면... 어쩌지...」
							PRINTFORMDL 너희 둘 다 좀 흥분했나 보네...
						CASE K17C_受け_おねだり系
							PRINTFORML 「하아, 하아... 아아...」
							CALL HPH_PRINT,"「당신 정말 나를 공격했어 HPH」", "L"
							PRINTFORMDL 방어 시도가 전혀 없을 때 그것을 정말로 "폭행"이라고 할 수 있나요...
						CASE K17C_受け_合意襲い系
							CALL HPH_PRINT,"「하아, 하아... 내 손실이군 HPH」", "L"
							PRINTFORML 「너무 흥분한 것 같은데... 진심으로...」
							PRINTFORMDL 그녀는 그것에 대해 별로 불행해 보이지 않는다...
						CASE K17C_受け_お手伝い系
							PRINTFORML 「드디어 만족했어...? 정말 나를 마음대로 했네...」
							PRINTFORML 「하지만 동시에 좀 귀여웠어...」
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 그렇게 말하며 당신을 올려다보자, 그녀 자신도 꽤 귀여워 보인다.
					ENDSELECT
				ENDIF
				;一回セットしてフラグ保存
				CALL K17_SET_AUTO_PVOICE(,,iType)
				;自主トレがばれてアリスのプライド 態度が下がる
				CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-2)
				CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,-2)
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 0
