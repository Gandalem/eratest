					CASE IS >= K17C_思慕
						
						PRINTFORMW 「%K17_CNAME()%, I like you.」
						PRINTFORML 「Please go out with me.」
						PRINTFORML 「H-How's that? I said properly this time without getting embarrassed.」
				ENDSELECT
				
