		PRINTFORMDL You feel it's a more dazzling smile than any other she's given you until now.
		;フラグチェック
		CALL K17_RELATION_EV(K17C_RTF_恋人)
		TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
		PRINTW
		RETURN 1
