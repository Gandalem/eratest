;情事を目撃した
;==================================================
@M_KOJO_EVENT_K17_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	PRINTL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORML 「?!?! %K17_RS("Wha/Eh")%...!」
		PRINTFORMDL %CALLNAME:TARGET% trembles in place with a furious blush.
		PRINTW
		;知り合いか見る
		SIF K17_GET_FRIENDS(ARG)
			PRINTFORML （Ack... %K17_CNAME(ARG)% is...doing that sort of thing...）
			
		IF K17_GRT() >= K17C_思慕
			PRINTFORML （%K17_CNAME()% likes that sort of thing...）
			PRINTFORML （I can see...everything...）
			PRINTFORML （Oh no... My imagination's going to run wild for a while...）
			PRINTW
		ENDIF
		PRINTFORML 「Ahem, doing that, umm, somewhere like this...」
		PRINTFORML 「Anyway, be more prudent!」
		PRINTFORMDL You get scolded by %CALLNAME:TARGET%.
		
		;思慕以上でMASTERに恋人がいないorアリスが恋人
		SIF K17_GRT() >= K17C_思慕 && (!(CFLAG:MASTER:既成事実 & 合意_恋人) || CFLAG:TARGET:既成事実 & 合意_恋人)
			CFLAG:TARGET:情事目撃 = ARG
		
		;弱みがつくはずなのでプライドと態度もあげちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,1)
	ENDIF
	;-------------------------------------------------
	;負けじと参加（馴れ合い度:高）
	;恋人同士相手には乱入できないみたい
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		;-----------
		;開始時の主導権
		;溜まってる度の一時保存
		;情事相手のうふふ状態をみる
		;-----------
		IF CFLAG:MASTER:うふふ == 1
			;MASTER主導権
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_受け_お手伝い系
			TCVAR:K17C_ID:K17C_TC_うふふ主導権 = -1
			TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:TARGET:溜まってる度
			TCVAR:K17C_ID:K17C_TC_中出しカウント = 0
		ELSE
			;キャラ主導権
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
			TCVAR:K17C_ID:K17C_TC_うふふ主導権 = TARGET
			TCVAR:K17C_ID:K17C_TC_中出しカウント = 0
			IF TALENT:MASTER:性別 >= 2
				TCVAR:K17C_ID:K17C_TC_溜まってる度 = BASE:MASTER:精力
			ELSE
				TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:溜まってる度
			ENDIF
		ENDIF
		
		;知り合いか見る
		SELECTCASE K17_GET_FRIENDS(ARG)
			;気安い系
			CASE K17C_霊夢ID,K17C_魔理沙ID,K17C_パチュリーID,K17C_幽香ID,K17C_咲夜ID,K17C_メディスンID
				PRINTFORML 「%K17_RS("Why～ you～/Ahhh～/Gahhh～")%! %K17_CNAME(ARG)%, keeping %K17_CNAME(MASTER)% to yourself is unfair! I'm joining, too!」
				
			;尊敬系
			CASE K17C_魅魔ID,K17C_ルイズID
				PRINTFORML 「%K17_RS("Oh dear/Oh myー/Ahhー")%, you can't keep %K17_CNAME(MASTER)% to yourself, %K17_CNAME(ARG)%.」
				PRINTFORML 「I'll be joining in, too.」
				
			;神綺様　夢子限定
			CASE K17C_神綺ID,K17C_夢子ID
				
				;アリスが恋人な場合
				IF TALENT:TARGET:恋人
					IF FIRSTTIME(@"修羅場{ARG}")
						;初回
						PRINTFORML 「Eh... No way... %K17_CNAME(ARG)%?!」
						PRINTFORMDL In a rare moment of shock, %CALLNAME:TARGET%'s knees are shaking as she struggles to stand.
						PRINTW
						PRINTFORML 「Of all the... To think you'd lay your hands on even %K17_CNAME(ARG)%... Someday, I'll...」
						PRINTFORMDL 『%CALLNAME:TARGET%\@ARG==K17C_神綺ID ? -chan #\@, it's not what you think!』says %CALLNAME:ARG%, trying to explain %HIM_HER(ARG,,1)%self...
						PRINTFORMDL The atmosphere has changed completely...
						PRINTFORMDL ...
						PRINTFORMDL ......
						PRINTFORMDW .........
						;勝手に想像して　親子丼とか浮気とかそんな感じのあれそれ
						PRINTFORML 「Very well... So this is, what do you call it...」
						PRINTFORMDL %CALLNAME:TARGET% tightly pinches your thigh.
						PRINTFORML 「Well... Rather than you doing it...secretly... I'll join in.」
						;PRINTFORMDL %CALLNAME:TARGET% seems to be harboring a sense of defiance towards %CALLNAME:ARG%.
						PRINTFORML 「Anyway, monopolizing %K17_CNAME(MASTER,1)% like this is forbidden!」
						PRINTW
						
					ELSE
						;二回目以降
						PRINTFORML 「Ughh... Again...」
						PRINTFORMDL %CALLNAME:TARGET% exhales a long, exasperated sigh, and moves between %CALLNAME:ARG% and you.
						PRINTFORMDL 『%CALLNAME:TARGET%\@ARG==K17C_神綺ID ? -chan #\@, this isn't...』says %CALLNAME:ARG%, making the same excuse...
						PRINTW
					ENDIF
				ELSE
					PRINTFORML 「Good grief... To find you with %K17_CNAME(ARG)%, of all people...」
				ENDIF
			;知らない人
			CASEELSE
				PRINTFORML 「...I'll be joining in too, okay?」
		ENDSELECT
		TRYCALL K17_乱交開始(ARG)
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	;してる方が恋人だった場合、そそくさと立ち去る（恋人が混じっている多人数プレイかつTARGETが恋人でない場合も立ち去る
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		
		PRINTFORML 「Ah, I'm sorry for interrupting...」
		;知り合いか見る
		SIF K17_GET_FRIENDS(ARG)
			PRINTFORML （Ack... %K17_CNAME(ARG)% is...doing that sort of thing...）
		;恋人か見る
		SIF TALENT:ARG:恋人
			PRINTFORML （I suppose they're lovers, so doing this sort of thing is natural...）
		
		;思慕以上でMASTERに恋人がいないorアリスが恋人
		SIF K17_GRT() >= K17C_思慕 && (!(CFLAG:MASTER:既成事実 & 合意_恋人) || CFLAG:TARGET:既成事実 & 合意_恋人)
			CFLAG:TARGET:情事目撃 = ARG
		
		
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて参加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG:1 == 4
		;PRINTFORML
		;RETURN 1
	;ENDIF
	;その他
	PRINTW
ENDIF
RETURN 1

