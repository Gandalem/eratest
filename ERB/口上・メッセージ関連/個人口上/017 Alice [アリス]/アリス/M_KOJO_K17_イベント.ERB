@M_KOJO_EVENT_K17_26(ARG,ARG:1)
#DIM Virgin = 0		;まんまの意味　行ったり来たりするので保護しておく
#DIM iRand = 0		;受け妄想の一時受け渡し
#DIM iType = 0		;タイプの保存
#DIM iRes = 0		;初回かどうか見とく
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間 通常オナバレ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF FIRSTTIME("オナバレ",1) && ARG:1==0
					SELECTCASE K17_GRT(TARGET)
						;うふふ経験なし
						CASE IS<K17C_思慕うふふ
							PRINTFORML 「?!?! ...%K17_RS("Hiiiieeeee～～～/Kyaaahhhh/Fweeeehhh")%?!」
							;うふふ+キス経験あり
						CASEELSE
							PRINTFORML 「...%K17_RS("Hyah/Kyaa/Fweehhh/Ahhh")%?!」
					ENDSELECT
					PRINTFORML 「Ah... No... Uh...」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 평소의 침착한 모습과는 전혀 다르게 어리둥절한 목소리로 말을 더듬는다.
					PRINTFORML 「그건... 아-아-안 그런 거야...」
					PRINTFORML 「이건, 음... 연구라고? 그래, 인형 연구지! 그리고 내가 그 일에 휘말렸을 뿐이야...」
					PRINTFORMDL 그게 최선이었던 걸까...?
				ELSEIF ARG:1==0
					SELECTCASE K17_GRT(TARGET)
						;うふふ経験なし
						CASE IS<K17C_思慕うふふ
							PRINTFORML 「?!?! ...%K17_RS("Uu～～～/Kyaaahhhh/Fweeeehhh")%?!」
							;うふふ+キス経験あり
						CASEELSE
							PRINTFORML 「...%K17_RS("Hyah/Kyaa/Fweehhh/Ahhh")%?!」
					ENDSELECT
					PRINTFORML 「아... 안 돼... 어... 에... 또... 당신이?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 평소의 침착한 모습과는 전혀 다르게 당황한 목소리로 비명을 지른다.
					;custom code
					IF CFLAG:K17C_ID:1092
						PRINTFORMDL "당신은 자신의 '연구'에 꽤 열정적이지 않나요?"
					ELSE
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"가")% "연구"에 대한 열정을 보이는 것을 칭찬한다.
					ENDIF
					PRINTFORML 「저, 저건...」
				ENDIF
				;-------------------------------------------------
				;追加イベ
				;同居自慰　見られた瞬間
				;-------------------------------------------------
				IF ARG:1==1
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 절정에 다다르면서 갑자기 당신의 손을 꽉 잡고, 당신은 본능적으로 힘을 주어 되눌렀다.
					PRINTFORML 「...? Eh...」
					PRINTFORMDL 그녀의 몸이 격렬한 쾌감으로 떨리자, %조사처리(CALLNAME:TARGET,"는")%(는) 당신이 깨어있는 것을 알아차리고 사과처럼 얼굴을 붉힌다.
					PRINTW
					PRINTFORML 「에, 뭐, 안 돼, 잠깐... %K17_喘ぎ_絶頂(K17C_受け_無理矢理系,-1,"Even though I'm being watched... ")%」
					PRINTFORMDL 패닉 상태이지만 쾌락의 파도를 %K17_RS("멈추다/견디다/버티다")% 할 수 없어, %조사처리(CALLNAME:TARGET,"는")% 절정에 몸을 떨고 있다.
					PRINTFORMDL 비록 그녀는 치정으로 자신의 몸을 말고 있지만, 중요한 부분들은 당신이 볼 수 있도록 노출되어 있었다...
					PRINTFORMDL ...
					PRINTFORMDL ......
					PRINTFORMDW .........
				ENDIF
				IF FIRSTTIME("オナバレ",1) && ARG:1==1
					PRINTFORML 「이건...음...」
					PRINTFORMDL 절정 후 정신을 차린 %조사처리(CALLNAME:TARGET,"는")%(는) 변명하려 애쓰며 말을 더듬기 시작한다.
					PRINTFORML 「그거...아-안...」
					PRINTFORML 「이건, 어...연구? 응, 인형 연구야! 그리고 내가 거기에 빠져버렸어...」
					PRINTFORMDL 그게 할 수 있는 최선이었을까...?
				ELSEIF ARG:1==1
					PRINTFORML 「아... 안 돼... 이건... 우우ㅡ」
					PRINTFORMDL 절정에 이른 후 정신을 차린 %조사처리(CALLNAME:TARGET,"는")% 시트를 머리 위로 끌어당기고 치정하며 신음한다.
					;custom code
					IF CFLAG:K17C_ID:1092
						PRINTFORMDL "당신은 자신의 '연구'에 꽤 열정적이지 않나요?"
					ELSE
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"가")% "연구"에 대한 열정을 보이는 것을 칭찬한다.
					ENDIF
					PRINTFORML 「저, 저건...」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1 && ARG:1==0
				IF FIRSTTIME("オナバレ",1)
					SELECTCASE K17_GRT(TARGET)
						CASE IS<K17C_思慕うふふ
							PRINTFORML 「나, 저기... 어서 나가!!」
						CASE IS < K17C_恋慕生解禁
							CALL HPH_PRINT,"「...아, 이런. 당신은 나의 꽤나 민망한 모습을 보게 되었군요...」", "L"
							PRINTFORML 「네가 애초에 이것의 일부 책임이 있어..」
						CASE IS >= K17C_恋慕生解禁
							PRINTFORML 「...에? 진심이야... 정말 그냥... 떠나려고?」
					ENDSELECT
				ELSE
					;見たりしたりした以降
					PRINTFORML 「가, 나가! ...아...」
					SELECTCASE K17_GRT(TARGET)
						CASE IS<K17C_思慕うふふ
							PRINTFORML 「아마 %HE_SHE(MASTER)%는 지난번 일 때문에 아직도 어색할지도 모르지...」
						CASE IS < K17C_恋慕生解禁
							PRINTFORML 「...어라... 너무 강하게 말했나...?」
							PRINTFORML 「아니면 혹시 %HE_SHE(MASTER)%는 지난번 일 때문에 아직도 어색한 걸지도...」
						CASE IS >= K17C_恋慕生解禁
							PRINTFORML 「...에? 진심일 리가 없어... 정말로 그저... 떠나려고 하는 거야?」
							PRINTFORML 「어쩌면 %HE_SHE(MASTER)%는 이 패턴에 질린 걸지도 몰라...」
					ENDSELECT
				ENDIF
				PRINTFORML 「너... 바보냐!!」
				;自主トレがばれてアリスのプライドが下がる
				CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,-1)
