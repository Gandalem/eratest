@M_KOJO_EVENT_K17_11(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;仲良くなる前反応
		PRINTFORML 「~~!?!? 이리서 나가!」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 벌거벗은 채 안에 있다.
		PRINTFORMDL 그녀는 당신에게 미친 듯이 양동이를 휘두른다.
		IF !TCVAR:K17C_ID:K17C_TC_お風呂イベント && !CFLAG:MASTER:同行 && K17_CHECK_RANDOM_EVENT(TARGET)
			;れっつとらぶる
			TRYCALL K17_お風呂イベント(TARGET)
			SIF RESULT
				PRINTFORMDL 더는 말하지 않고, 그녀는 당신을 내쫓는다.
		ELSE
			PRINTFORMDL 쫓겨나면서 그녀의 %K17_RS(HIP_TR(TARGET)+"/"+OPPAI_DESCRIPTION_TR(TARGET,1)+"/voluptuous thighs")%를 언뜻 본다.
			;追い出しは連打禁止
