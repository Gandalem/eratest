@M_KOJO_EVENT_K17_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常起床（定時になって起きる等）
	;非神社在住キャラで恋慕未満の場合は、勝手に部屋に入り込んできてる状態
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTL
		IF TALENT:TARGET:恋慕
			SELECTCASE K17_GRT(TARGET)
				CASE IS >= K17C_恋慕
					;現在位置でランダムイベント振る　もしくは生解禁（危険日も）で追加イベ
					IF (K17_CHECK_RANDOM_EVENT() || K17_GRT(TARGET) >= K17C_恋慕生解禁) && TCVAR:K17C_ID:K17C_TC_朝フェラ==0 && CFLAG:K17C_ID:K17C_CF_オナニーフラグ == 0
						TRYCALL K17_朝フェライベント(TARGET)
					ENDIF
					IF RESULT == 0
						IF !TCVAR:K17C_ID:K17C_TC_朝フェラ && !TCVAR:TARGET:今日会ったか
							;定時起床
							IF TALENT:MASTER:性別 >= 2
								PRINTFORM 「좋은 아침이야... 아, %K17_RS("정말 끔찍한 머리 모양이네/옷이 다 구겨졌어/얼굴이 엉망이야/아래쪽이 상당히 생기가 넘치군")%... 이리 와 봐.」
							ELSE
								PRINTFORM 「좋은 아침이야... 아, %K17_RS("얼마나 엉망인 머리/옷이 다 구겨져 있어/얼굴이 헝클어져 있어")%... 이쪽으로 와.」
							ENDIF
							TRYCALL K17_人形台詞(-1)
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%/가 당신의 하루를 시작할 때 당신을 보살핀다.
							SIF CFLAG:MASTER:初期位置 != CFLAG:TARGET:初期位置
								PRINTFORMDL 만약 당신이 같은 지붕 아래서 살았다면, 그녀는 아마 매일 아침 이렇게 당신을 돌봐주었을 것이다.
							PRINTW
							CALL HPH_PRINT,"「됐다... 다 끝났다, 추우호」", "L"
						ELSE
							;倒れて起きた時など定時ではない場合
							PRINTFORML 「후우... 좋은 아침이야.」
						ENDIF
					ENDIF
				CASEELSE
					IF !TCVAR:K17C_ID:K17C_TC_朝フェラ && !TCVAR:TARGET:今日会ったか
						PRINTFORML 「좋은 아침...」
						PRINTFORML 「잠잘 때 예상외로 귀엽네, 후후.」
					ELSE
						PRINTFORML 「후아... 좋은 아침이야.」
					ENDIF
			ENDSELECT
		ELSE
			PRINTFORML 「아... 깨셨군요...」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "무슨 짓을 하고 있는 거지..."
			ELSE
				PRINTFORMDL 이 사람이 지금 뭐 한다고 생각하는 걸까...
			ENDIF
			PRINTFORML 「그냥 인형 관련 연구 좀 하는 거야, 후후.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;添い寝起床
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 2
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;その他
	PRINTL
	TCVAR:K17C_ID:K17C_TC_朝フェラ = 1
ENDIF
RETURN 1
