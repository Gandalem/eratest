;目撃した情事を問い詰める
;==================================================
@M_KOJO_EVENT_K17_8(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERだけ問い詰め
	;CFLAG:TARGET:情事目撃
	;思慕以上でMASTERに恋人がいないorアリスが恋人
	;参加してない時だけだから非情にレアケースじゃないですかね
	;これ誰得なんだ！？　削除予定地
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		;恋慕以上＆知り合いのとき
		IF (K17_GRT() >= K17C_恋慕 || CFLAG:TARGET:既成事実 & 合意_恋人) && K17_GET_FRIENDS(CFLAG:TARGET:情事目撃)
			PRINTFORML 「Have you...%K17_RS("already grown tired of/come to hate/already abandoned")% me?」
			PRINTFORMDL As %CALLNAME:TARGET% suddenly says this with an agonized expression, you're taken aback.
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "No, of course not."
			ELSE
				PRINTFORMDL You fervently deny that.
			ENDIF
			PRINTW
			;嘘だ！
			PRINTFORML 「Ahhh, I'm sorry. I don't mean to criticize you.」
			PRINTFORML 「I just thought maybe you wouldn't look my way anymore...」
			PRINTFORMDL As she continues looking down at her feet, she runs forward and buries her face into your chest.
			PRINTFORML 「I'm sorry, for being such a bothersome woman...」
			PRINTFORMDL You can't do anything but gently pat %CALLNAME:TARGET%'s head for a while...
			PRINTW
			PRINTFORML 「I, I don't care if you're with other women, or you only think of me as a stand-in for %K17_CNAME(CFLAG:TARGET:情事目撃)%.」
			PRINTFORML 「Just, just please... Don't forget about me...」
			PRINTFORMDL She tries to smile as she says that, but you can tell she's forcing herself.
			PRINTFORMDL Maybe you should consider %CALLNAME:TARGET%'s feelings a little more from now on...
		ELSE
			;うふふ前　研究材料に使いました
			PRINTFORML 「Ummー... About before...」
			PRINTFORML 「I guess I overreacted a little, so I'm sorry.」
