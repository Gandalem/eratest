	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「흐읍-저기... 저... 다시 임신한 것 같아요. \@ EXP:出産経験 ? 임신했어 # 임신해. \@」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 망설이며 당신 쪽을 바라보지만, 이내 시선을 돌린다.
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;詰問はきつい
		PRINTFORML 「나를 잡았어 \@ EXP:出産経験 ? 다시 임신했네... # 임신이야... \@ 이제 어떻게 할 거야?」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 자신의 임신에 대해 상당히 괴로워 보인다.
		PRINTFORMDL 눈가에 눈물이 고이자, 당신이 할 수 있는 것은 그녀의 머리를 쓰다듬어 달래주는 것뿐이다...
		PRINTW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML (내 몸이... 이상하다.)
		PRINTW
		RETURN 1
	ENDIF
	;報告陥落あり　出産経験を見る
