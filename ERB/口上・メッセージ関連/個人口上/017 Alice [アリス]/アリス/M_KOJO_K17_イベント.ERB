;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_K17_1
RETURN 1

@M_KOJO_SPEVENT_K17_1(ARG,ARG:1)
#DIM DYNAMIC 人気 = 0
#DIM DYNAMIC スキップカウント = 0
#DIM DYNAMIC MAX好感度 = 0
#DIM DYNAMIC 恋人ID = -1
#DIM DYNAMIC MAX好感度ID = -1
#DIM DYNAMIC 順位 = 1
#DIM DYNAMIC iID_Count = 0

;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:時間停止

PRINTL
	IF FIRSTTIME("デートイベント")
		;初回限定
		PRINTFORMW 「Hey, umm...」
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "What is it?", you ask while turning around.
		ELSE
			PRINTFORMDL You turn and ask her what's on her mind.
		ENDIF
		PRINTFORMDL %CALLNAME:TARGET% is staring at the ground, blushing a little.
		PRINTFORML 「Yes... Well, I was just thinking...」
		PRINTFORML 「I went along with you all day, right?」
		PRINTFORML 「So go along with me for a little, okay?」
		PRINTFORMDL ...
		PRINTFORMDL ......
		PRINTFORMDW .........
		PRINTFORML 「This is, uh... You know, what they'd call, uh... A date, right?」
		PRINTFORML 「Is it enjoyable to do this sort of thing with me?」
		IF TCVAR:TARGET:キスキャンセル == 1
			PRINTFORML 「I wanted to ask you properly what you thought of this.」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "I had fun, of course."
			ELSE
				PRINTFORMDL Without hesitation, you tell her you had fun.
			ENDIF
			RESULT =0
		ELSE
			{
			CALL K17_CHOICE("「I wanted to ask you properly what you thought of this.」",
							"I had fun, of course","To be honest...","More importantly, give me your panties")
			}
		ENDIF
	ELSE
		IF TCVAR:TARGET:キスキャンセル == 1
			PRINTFORMW 「Hey, what did you think of today...?」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "I had fun, of course."
			ELSE
				PRINTFORMDL Without hesitation, you tell her you had fun.
			ENDIF
			RESULT =0
		ELSE
			$DATE_INPUT_LOOP1
			CALL K17_CHOICE("「Hey, what did you think of today...?」","I had fun, of course","To be honest...","More importantly, give me your panties")
		ENDIF
	ENDIF
	
	
	SELECTCASE RESULT
		CASE 0
			PRINTFORML 「I see, thank you. I had fun, too.」
		CASE 1
			PRINTFORML 「I see, okay then...」
			PRINTFORML 「...I guess it was just me.」
			PRINTFORMDL %CALLNAME:TARGET% mutters something to herself before erasing the emotion from her face.
			PRINTFORML 「I'm sorry, it's nothing.」
			PRINTW
			TCVAR:TARGET:キスキャンセル = 1
			TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
			RETURN 1
		CASEELSE
			スキップカウント++
			IF スキップカウント >= 3
				PRINTFORML 「Never mind...」
				PRINTW
				TCVAR:TARGET:キスキャンセル = 1
				TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
				RETURN 1
			ENDIF
			PRINTFORML 「%K17_RS("I'm being serious./Please answer seriously.")%」
			GOTO DATE_INPUT_LOOP1
	ENDSELECT
	
	;custom code
	IF CFLAG:K17C_ID:1092
		PRINTFORMDL "Then it looks like this date was a success."
	ELSE
		PRINTFORMDL It seems like this date was a success, then.
	ENDIF		
	PRINTW
	PRINTFORML 「I wouldn't...go on a date with just anyone, you know.」
	PRINTFORML 「I thought I would always be alone, here in this forest, with just my dolls...」
	PRINTFORML 「But deep down, I wanted to meet someone special someday, and fall in love with them...」
	PRINTFORMDL %CALLNAME:TARGET% is practically staring a hole into you.
	
	;人気チェック ついでに恋人が誰か探す　アリスちゃんまじこわい
	MAX好感度 = CFLAG:K17C_ID:好感度
	MAX好感度ID = K17C_ID
	FOR iID_Count,1,CHARANUM
		;出禁　アリス以外を見る
		SIF CFLAG:iID_Count:出禁 || iID_Count == K17C_ID
			CONTINUE
		IF MAX好感度 <= CFLAG:iID_Count:好感度
			MAX好感度 = CFLAG:iID_Count:好感度
			MAX好感度ID = iID_Count
		ENDIF
		SIF CFLAG:K17C_ID:好感度 <= CFLAG:iID_Count:好感度
			順位++
		SIF TALENT:iID_Count:恋慕
			人気 += 3
		SIF TALENT:iID_Count:思慕
			人気 += 1
		IF TALENT:iID_Count:恋人
			恋人ID = iID_Count
			人気 += 10
		ENDIF
	NEXT
	
	;MASTERに恋人がいてアリスではないとき
	IF !TALENT:恋人 && TALENT:MASTER:恋人 ;custom code, lover check patch
		;誰が恋人か見る
		IF K17_GET_FRIENDS(恋人ID)
			;ｈ参照
			PRINTFORML 「But for that person to end up being %K17_CNAME(恋人ID)%'s lover, of all people...」
			PRINTFORML 「How could this have happened...」
		;その他の人
		ELSE
			PRINTFORML 「But you already have a lover, don't you?」
			PRINTFORML 「Are you just toying with me, after all?」
		ENDIF
		
	;それ以外
	ELSE
		;最大好感度か、すでに恋人ならここ
		IF MAX好感度ID == K17C_ID || TALENT:K17C_ID:恋人 == 1
			PRINTFORML 「But I'm not confident I can stay the number one girl in your heart.」
		ELSE
			;あわわわ……
			IF 順位 <= 5
				PRINTFORML 「But I probably only have the number {順位} spot in your heart right now...」
			ELSE
				PRINTFORML 「But I'm probably just another member of your harem at this point...」
			ENDIF
		ENDIF
		
		;人気を見る
		SELECTCASE 人気
			CASE IS >= 10
				PRINTFORML 「After all, it seems like you're already close with so many other women.」
			CASE IS >= 4
				PRINTFORML 「After all, you're already close with other women.」
			CASE IS >= 1
				PRINTFORML 「After all, you've already got your sights on another woman or two, right?」
			CASE 0
				PRINTFORML 「I'm not sure why you spend all of your time with just me.」
		ENDSELECT
	ENDIF
	
	IF 人気 != 0
		PRINTFORMDL Certainly, your fidelity towards %CALLNAME:TARGET% might not be rock-solid.
		;うそだ！
		PRINTFORML 「I'm sorry, I don't mean to criticize you.」
		PRINTFORML 「I'm just the high-maintenance, bothersome type...」
		
		
		
		IF TCVAR:TARGET:キスキャンセル==0
			$DATE_INPUT_LOOP2
			CALL K17_CHOICE("「Even so, would you invite me out again?」","Of course I would","Yeah, that is a little heavy","More importantly, give me your panties")
		ELSE
			PRINTFORML 「Even so, would you invite me out again?」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "Of course I would"
			ELSE
				PRINTFORMDL You nod without hesitation.
			ENDIF
			RESULT = 0
		ENDIF
		
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「Nn, thank you. You're going to spoil with me with your kindness.」
			CASE 1
				PRINTFORML 「...So I'm bothersome, after all.」
				PRINTFORMDL %CALLNAME:TARGET% mutters something to herself before erasing the emotion from her face.
				PRINTFORML 「I'm sorry, you don't have to bother inviting me out again.」
				PRINTW
				TCVAR:TARGET:キスキャンセル = 1
				TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
				RETURN 1
				
			CASEELSE
				スキップカウント++
				IF スキップカウント >= 3
					PRINTFORML 「Never mind...」
					PRINTW
					TCVAR:TARGET:キスキャンセル = 1
					TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
					RETURN 1
				ENDIF
				PRINTFORML 「I'm being serious.」
				GOTO DATE_INPUT_LOOP2
		ENDSELECT
		PRINTFORML 「Then, I'll say it properly...」
	ELSE
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "You're the most important person to me, so of course I'd do that."
		ELSE
			PRINTFORMDL You tell her she's the most important person to you, so it's a matter of course.
		ENDIF
		PRINTFORML 「Uu... Ah, no, thank you. You really are dedicated, aren't you.」
		PRINTFORML 「Th-Then, I'll, umm, I'll answer those feelings.」
	ENDIF
	
	PRINTW
	
	;アリスからキス
	CALL K17_FIRSTKISS_ALICE(TARGET)
	IF RESULT == 0
		;もうアリスからのファーストキスをしてもらっていた場合
		SELECTCASE K17_GRT(TARGET)
			CASE IS >= K17C_恋慕
				PRINTFORML 「I love you...」
			CASE IS >= K17C_思慕
				PRINTFORML 「I like you...」
		ENDSELECT
		CALL HPH_PRINT, "「Nn...HPH」", "L"
		PRINTFORML 「That makes {CFLAG:K17C_ID:K17C_CF_FKアリス} kisses from me.」
		PRINTW
	ENDIF
	
	IF TALENT:MASTER:キス未経験 && TALENT:TARGET:キス未経験
		PRINTFORML 「Looks like I took your first kiss.」
		PRINTFORML 「I'm glad you were my first kiss, too...」
		PRINTFORMDL You feel like you were able to convey your emotions for each other.
		PRINTW
	ELSEIF TALENT:TARGET:キス未経験
		PRINTFORML 「That was my first kiss.」
		PRINTFORMDL Despite her appearances, %CALLNAME:TARGET%'s kiss was a bit awkward.
		PRINTW
	ELSEIF TALENT:MASTER:キス未経験
		PRINTFORML 「Looks like I stole your first kiss.」
		PRINTFORMDL %CALLNAME:TARGET%'s kiss felt exceptionally gentle.
		PRINTW
	ENDIF
	
	PRINTFORML 「I wanted to properly convey my feelings to you... Did they reach you?」
	PRINTFORMDL You certainly did feel them on your lips...
	PRINTW
	
	IF CFLAG:TARGET:弱み握られ
		PRINTFORML 「You can also consider this an exchange for keeping quiet about..."that".」
		PRINTFORMDL Now that she mentions it, you do have some dirt on her.
		PRINTW
	ELSE
		;つまり誘い
		SIF TALENT:TARGET:恋慕
			PRINTFORML 「I'll always be waiting... So come and see me again.」
		SIF TALENT:TARGET:思慕
			PRINTFORML 「I'll always be waiting... So please come and see me again.」
	ENDIF
	
	IF 人気 == 0 && 恋人ID == -1
		PRINTFORML 「...Yes, this is a good beginning.」
	ELSEIF 人気 >= 1 && 恋人ID != -1
		PRINTFORML 「...I won't lose to anyone.」
	ELSEIF 人気 >= 1
		PRINTFORML 「...Yes, this will do as a beginning.」
	ENDIF
	
	;恋人がすでにいる場合
	IF !(CFLAG:TARGET:既成事実 & 合意_恋人) && TALENT:MASTER:恋人
		IF K17_GET_FRIENDS(恋人ID)
			PRINTFORML 「...Not even to %K17_CNAME(恋人ID)%.」
		;その他の人
		ELSEIF !(恋人ID == -1)
			PRINTFORML 「...Not even to your lover.」
		ENDIF
	ENDIF
	PRINTFORMDL %CALLNAME:TARGET% whispers quietly into your ear.
	
	;完走マジおつかれ　口上側から呼ぶのも考えて終了処理
	TCVAR:TARGET:キスキャンセル = 0
	CFLAG:K17C_ID:K17C_CF_デートイベント =1
	SETBIT CFLAG:TARGET:デート後イベントフラグ,0
	TCVAR:K17C_ID:K17C_TC_デートイベ完走 = 1
	CALL K17_RELATION_EV(K17C_RTF_逢引)
	SIF !RESULT
		PRINTW
ENDIF
RETURN 1


