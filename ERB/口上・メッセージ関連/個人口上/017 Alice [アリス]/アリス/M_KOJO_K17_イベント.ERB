			SELECTCASE K17_GRT_EX()
				CASE IS >= K17C_思慕
					PRINTFORML 「I've got some chores to do around the house today... I'll see you later, %K17_CNAME()%.」
				CASEELSE
					PRINTFORML 「Nn, I need to do some work around the house... I'll be leaving.」
			ENDSELECT
			TRYCALL K17_人形台詞(K17C_上海,0,"Let's do choresー")
			TRYCALL K17_人形台詞(K17C_蓬莱,1,"Yeahー")
		ENDIF
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:職種 == K17C_職種_人形劇 && TIME <= 720
			;人形劇　公演中
			;
			PRINTFORMDL You can hear children shouting and cheering.
			SIF !(TCVAR:K17C_TC_人形劇 & 8)
				PRINTFORML 「Now, what's going to happen next～?」
		ELSE
			;家事＆片付け
			PRINTFORML 「%K17_RS("Hmm hmm mmmー/Hmmhmm～/Mmm～")%♪」
			PRINTFORMDL You can hear %CALLNAME:TARGET% humming.
		ENDIF
		
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:職種 == K17C_職種_人形劇
			;人形劇片付け終了
			PRINTFORML 「Okay, look forward to next time～」
			PRINTFORML 「Until then, everyone be good little boys and girls, okay?」
			PRINTFORMDL %CALLNAME:TARGET% waves goodbye to the remaining handful of children.
		ELSE
			;家事＆片付け
			PRINTFORML 「%K17_RS("Hmm hmm mmmー/Hmmhmm～/Mmm～")%...♪」
			PRINTFORMDL You can hear %CALLNAME:TARGET% humming.
		ENDIF
		
	ENDIF
	
	PRINTW
ENDIF
RETURN 1

