;"SP_EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;デート帰りにファーストKISS（合意も付く）
;基本キャンセルされる、ファーストキスを終えると
;二度と見られなくなりますが
;本口上では救済される……はず
;テスト成功　多分行けます
;告白イベントと連動開始
;1度キスキャンセルしたら選択肢はパスする形に
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K17_1
RETURN 1

@M_KOJO_SPEVENT_K17_1(ARG,ARG:1)
#DIM DYNAMIC 人気 = 0
#DIM DYNAMIC スキップカウント = 0
#DIM DYNAMIC MAX好感度 = 0
#DIM DYNAMIC 恋人ID = -1
#DIM DYNAMIC MAX好感度ID = -1
#DIM DYNAMIC 順位 = 1
#DIM DYNAMIC iID_Count = 0
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:時間停止
	PRINTL
	IF FIRSTTIME("デートイベント")
		;初回限定
		PRINTFORMW 「저기, 음...」
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL 뒤돌아보며 당신은 "뭐야?"라고 묻는다., you ask while turning around.
		ELSE
			PRINTFORMDL 당신은 몸을 돌려 그녀에게 무슨 생각을 하는지 묻는다.
		ENDIF
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 약간 얼굴을 붉히며 땅을 응시하고 있다.
		PRINTFORML 「응... 뭐, 그냥 생각하고 있었어...」
		PRINTFORML 「나 하루 종일 너희들 따라다녔잖아, 그렇지?」
		PRINTFORML 「그러니까 나 좀 따라와 줄래, 알았지?」
		PRINTFORMDL ...
		PRINTFORMDL ......
		PRINTFORMDW .........
		PRINTFORML 「이게, 음... 뭐랄까, 어... 데이트라고 부르는 거겠지?」
		PRINTFORML 「나랑 이런 걸 하는 게 즐거워?」
		IF TCVAR:TARGET:キスキャンセル == 1
			PRINTFORML 「이거에 대해 네가 어떻게 생각하는지 제대로 물어보고 싶었어.」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "물론 즐거웠다."
			ELSE
				PRINTFORMDL 망설임 없이 그녀에게 즐거웠다고 말한다.
			ENDIF
			RESULT =0
		ELSE
			CALL K17_CHOICE("「이거에 대해 네가 어떻게 생각하는지 제대로 물어보고 싶었어.」", "물론 즐거웠어","솔직히 말하면...","더 중요한 건 네 팬티를 내는 거야")
		ENDIF
	ELSE
		IF TCVAR:TARGET:キスキャンセル == 1
			PRINTFORMW 「오늘 어땠어...?」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "물론 즐거웠다."
			ELSE
				PRINTFORMDL 망설임 없이 그녀에게 즐거웠다고 말한다.
			ENDIF
			RESULT =0
		ELSE
			$DATE_INPUT_LOOP1
			CALL K17_CHOICE("「오늘 어땠어...?」","물론 즐거웠어","솔직히 말하면...","더 중요한 건 네 팬티를 내는 거야")
		ENDIF
	ENDIF
	SELECTCASE RESULT
		CASE 0
			PRINTFORML 「알겠어, 고마워. 나도 즐거웠어.」
		CASE 1
			PRINTFORML 「알았어, 그럼...」
			PRINTFORML 「...나 혼자였던 것 같아.」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 얼굴에서 감정을 지우며 혼잣말을 중얼거린다.
			PRINTFORML 「미안해, 아무것도 아니야.」
			PRINTW
			TCVAR:TARGET:キスキャンセル = 1
			TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
			RETURN 1
		CASEELSE
			スキップカウント++
			IF スキップカウント >= 3
				PRINTFORML 「됐어...」
				PRINTW
				TCVAR:TARGET:キスキャンセル = 1
				TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
				RETURN 1
			ENDIF
			PRINTFORML 「%K17_RS("I'm being serious./Please answer seriously.")%」
			GOTO DATE_INPUT_LOOP1
	ENDSELECT
	;custom code
	IF CFLAG:K17C_ID:1092
		PRINTFORMDL "그럼 이 데이트는 성공한 것 같다."
	ELSE
		PRINTFORMDL 이 데이트는 성공적이었던 것 같다.
	ENDIF
	PRINTW
	PRINTFORML 「나는 아무나랑 데이트하지 않을 거거든, 알잖아.」
	PRINTFORML 「난 항상 이 숲에서 내 인형들만 가지고 혼자 있을 거라고 생각했어...」
	PRINTFORML 「하지만 깊은 곳에서는 언젠가 특별한 사람을 만나 사랑에 빠지고 싶었어...」
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 거의 당신을 뚫어지게 쳐다보고 있어.
	;人気チェック ついでに恋人が誰か探す　アリスちゃんまじこわい
	MAX好感度 = CFLAG:K17C_ID:好感度
	MAX好感度ID = K17C_ID
	FOR iID_Count,1,CHARANUM
	;出禁　アリス以外を見る
	SIF CFLAG:iID_Count:出禁 || iID_Count == K17C_ID
		CONTINUE
	IF MAX好感度 <= CFLAG:iID_Count:好感度
		MAX好感度 = CFLAG:iID_Count:好感度
		MAX好感度ID = iID_Count
	ENDIF
	SIF CFLAG:K17C_ID:好感度 <= CFLAG:iID_Count:好感度
		順位++
	SIF TALENT:iID_Count:恋慕
		人気 += 3
	SIF TALENT:iID_Count:思慕
		人気 += 1
	IF TALENT:iID_Count:恋人
		恋人ID = iID_Count
		人気 += 10
	ENDIF
	NEXT
	;MASTERに恋人がいてアリスではないとき
	IF !TALENT:恋人 && TALENT:MASTER:恋人 ;custom code, lover check patch
		;誰が恋人か見る
		IF K17_GET_FRIENDS(恋人ID)
			;ｈ参照
			PRINTFORML 「하지만 그 사람이 하필 '%K17_CNAME(恋人ID)%'의 연인이 될 줄이야...」
			PRINTFORML 「어떻게 이런 일이 일어날 수 있었을까...」
			;その他の人
		ELSE
			PRINTFORML 「하지만 당신에게는 이미 연인이 있잖아요, 그렇죠?」
			PRINTFORML 「결국 나를 가지고 노는 건가요?」
		ENDIF
		;それ以外
	ELSE
		;最大好感度か、すでに恋人ならここ
		IF MAX好感度ID == K17C_ID || TALENT:K17C_ID:恋人 == 1
			PRINTFORML 「하지만 네 마음속에서 최고가 될 수 있을지는 확신이 없어.」
		ELSE
			;あわわわ……
			IF 順位 <= 5
				PRINTFORML 「하지만 지금 내 마음속에서 내가 차지할 수 있는 자리는 아마 {順位}번째일 뿐이겠지...」
			ELSE
				PRINTFORML 「하지만 이 시점에서 나는 아마 당신 하렘의 또 다른 구성원에 불과할 거야...」
			ENDIF
		ENDIF
		;人気を見る
		SELECTCASE 人気
			CASE IS >= 10
				PRINTFORML 「결국 당신은 이미 많은 다른 여성들과 가까운 것 같네요.」
			CASE IS >= 4
				PRINTFORML 「결국, 당신은 이미 다른 여자들과 가까워졌잖아요.」
			CASE IS >= 1
				PRINTFORML 「결국 너는 이미 다른 여자 몇 명에게 눈을 돌리고 있는 거잖아?」
			CASE 0
				PRINTFORML 「당신이 왜 온 시간을 나랑만 보내는지 잘 모르겠어.」
		ENDSELECT
	ENDIF
	IF 人気 != 0
		PRINTFORMDL 확실히 당신이 %조사처리(CALLNAME:TARGET,"에게")% 보이는 충성심은 완벽하지 않을지도 모른다.
		;うそだ！
		PRINTFORML 「너를 비난하려는 건 아니야.」
		PRINTFORML 「나는 그냥 손이 많이 가고 귀찮은 타입일 뿐이야...」
		IF TCVAR:TARGET:キスキャンセル==0
			$DATE_INPUT_LOOP2
			CALL K17_CHOICE("「그럼에도 불구하고, 저를 또 데리고 나가 주시겠어요?」","물론이지","응, 그건 좀 무겁네","더 중요한 건 네 팬티를 내는 거야")
		ELSE
			PRINTFORML 「그럼에도 불구하고, 저를 또 데리고 나가 주시겠어요?」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "물론이지"
			ELSE
				PRINTFORMDL 당신은 주저 없이 고개를 끄덕인다.
			ENDIF
			RESULT = 0
		ENDIF
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「응, 고마워. 너의 친절함으로 나를 감동시켜 줄 거야.」
			CASE 1
				PRINTFORML 「...결국 내가 귀찮은 거였네.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 표정에서 그 감정을 지우며 혼잣말을 중얼거린다.
				PRINTFORML 「미안해, 나 또 데이트에 초대할 필요 없어.」
				PRINTW
				TCVAR:TARGET:キスキャンセル = 1
				TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
				RETURN 1
			CASEELSE
				スキップカウント++
				IF スキップカウント >= 3
					PRINTFORML 「됐어...」
					PRINTW
					TCVAR:TARGET:キスキャンセル = 1
					TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
					RETURN 1
				ENDIF
				PRINTFORML 「진심이야.」
				GOTO DATE_INPUT_LOOP2
		ENDSELECT
		PRINTFORML 「그럼, 제대로 말해볼게...」
	ELSE
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "당신은 나에게 가장 소중한 사람이니까, 당연히 그렇게 하겠지."
		ELSE
			PRINTFORMDL 그녀에게 당신에게 가장 중요한 사람이라고 말하니 당연한 일이 되었다.
		ENDIF
		PRINTFORML 「흐으... 아, 아니에요, 괜찮아요. 정말 헌신적이시네요.」
		PRINTFORML 「그럼, 저도, 음, 그 감정에 응답할게요.」
	ENDIF
	PRINTW
	;アリスからキス
	CALL K17_FIRSTKISS_ALICE(TARGET)
	IF RESULT == 0
		;もうアリスからのファーストキスをしてもらっていた場合
		SELECTCASE K17_GRT(TARGET)
			CASE IS >= K17C_恋慕
				PRINTFORML 「당신을 연모합니다...」
			CASE IS >= K17C_思慕
				PRINTFORML 「좋아해...」
		ENDSELECT
		CALL HPH_PRINT, "「Nn...HPH」", "L"
		PRINTFORML 「그것은 나에게서 {CFLAG:K17C_ID:K17C_CF_FKアリス}개의 키스를 만들어낸다.」
		PRINTW
	ENDIF
	IF TALENT:MASTER:キス未経験 && TALENT:TARGET:キス未経験
		PRINTFORML 「네가 나의 첫 키스를 받은 것 같아.」
		PRINTFORML 「나도 네가 나의 첫 키스라서 기뻐...」
		PRINTFORMDL 서로의 감정을 전달할 수 있었다고 느껴진다.
		PRINTW
	ELSEIF TALENT:TARGET:キス未経験
		PRINTFORML 「그것이 나의 첫 키스였어.」
		PRINTFORMDL 그녀의 용모에도 불구하고, %조사처리(CALLNAME:TARGET,"의")% 키스는 조금 어색했다.
		PRINTW
	ELSEIF TALENT:MASTER:キス未経験
		PRINTFORML 「네 첫 키스를 훔친 것 같아.」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 키스는 유난히 부드럽게 느껴졌다.
		PRINTW
	ENDIF
	PRINTFORML 「당신에게 내 감정을 제대로 전달하고 싶었어... 전해졌을까?」
	PRINTFORMDL 분명 그 감정들이 당신의 입술에서 느껴졌지...
	PRINTW
	IF CFLAG:TARGET:弱み握られ
		PRINTFORML 「"이것을 '그 일'에 대해 입 다물어 주는 대가로 생각할 수도 있어."」
		PRINTFORMDL 이제 그녀가 언급했으니, 너도 그녀에 대한 약간의 비밀을 가지고 있네.
		PRINTW
	ELSE
		;つまり誘い
		SIF TALENT:TARGET:恋慕
			PRINTFORML 「언제나 기다리고 있을게... 그러니 다시 나를 보러 와줘.」
		SIF TALENT:TARGET:思慕
			PRINTFORML 「언제나 기다리고 있을게... 그러니 다시 나를 보러 와줘.」
	ENDIF
	IF 人気 == 0 && 恋人ID == -1
		PRINTFORML 「...응, 좋은 시작이네.」
	ELSEIF 人気 >= 1 && 恋人ID != -1
		PRINTFORML 「나는 누구에게도 지지 않을 거야.」
	ELSEIF 人気 >= 1
		PRINTFORML 「...응, 이걸로 시작하기에 충분하겠어.」
	ENDIF
	;恋人がすでにいる場合
	IF !(CFLAG:TARGET:既成事実 & 合意_恋人) && TALENT:MASTER:恋人
		IF K17_GET_FRIENDS(恋人ID)
			PRINTFORML 「...심지어 %K17_CNAME(恋人ID)%에게도 아니었다.」
			;その他の人
		ELSEIF !(恋人ID == -1)
			PRINTFORML 「연인에게조차 아니라고.」
		ENDIF
	ENDIF
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%/가 조용히 당신의 귀에 속삭인다.
	;完走マジおつかれ　口上側から呼ぶのも考えて終了処理
	TCVAR:TARGET:キスキャンセル = 0
	CFLAG:K17C_ID:K17C_CF_デートイベント =1
	SETBIT CFLAG:TARGET:デート後イベントフラグ,0
	TCVAR:K17C_ID:K17C_TC_デートイベ完走 = 1
	CALL K17_RELATION_EV(K17C_RTF_逢引)
	SIF !RESULT
		PRINTW
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K17_2
RETURN 1

@M_KOJO_SPEVENT_K17_2(ARG,ARG:1)
;口上主はTARGET
#DIM EVck=0	;デートイベントに行ってたかチェック
#DIM iRT=0
#DIM iRTF=0
EVck = 0
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:時間停止
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;-------------------------------------------------
		;デートイベント前に告白に入る場合もあるので先消化
		;-------------------------------------------------
		IF !CFLAG:K17C_ID:K17C_CF_デートイベント
			TCVAR:TARGET:キスキャンセル = 1
			EVck=1
			CALL M_KOJO_SPEVENT_K17_1(TARGET)
			SETBIT CFLAG:ARG:デート後イベントフラグ , 0
		ENDIF
		;各種初期化
		CFLAG:K17C_ID:K17C_CF_告白イベント = MIN(CFLAG:K17C_ID:K17C_CF_告白イベント + 1,10000)
		iRT = K17_GRT(TARGET)
		iRTF = K17_RT_FG(TARGET)
		;-------------------------------------------------
		;初回
		;-------------------------------------------------
		IF FIRSTTIME("告白イベント",1) && EVck==0
			;初回限定　デートイベント経由も飛ばし
			PRINTFORML 「... (나 간다.)」
			;custom code
			IF CFLAG:K17C_ID:1092
				PRINTFORMDL "갑자기 왜 그래..."
			ELSE
				PRINTFORMDL 이게 무슨 일이야, 갑자기...
			ENDIF
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 무언가 결심한 듯 단호한 포즈를 취한다.
			CALL HPH_PRINT,"「...우우... 우웅~~BPB」", "L"
			PRINTFORMDL 하지만 그녀가 당신에게 돌아설 때, 그녀의 얼굴 전체는 귀 끝까지 새빨개지고 시선을 내린다.
			PRINTFORML 「～～～아아, 엉그흐으ー」
			PRINTFORMDL 그녀는 주먹으로 당신을 때리기 시작한다.
			PRINTFORMDL 별로 아프지 않고, 왠지 귀엽다.
			PRINTW
			CALLF FIRSTTIME("告白イベント")
		ENDIF
		;-------------------------------------------------
		;二回目以降ここから
		;-------------------------------------------------
		PRINTFORML 「음, 내가... 이걸 조금... 해줄게...」
		PRINTFORMDL %CALLNAME:TARGET%갑자기 멈추고 당신의 %K17_RS("arm/hand")%를 자신 쪽으로 끌어당긴 뒤 %K17_RS("buries her face in your chest/embraces you")%.
		PRINTFORMDL 그녀는 잠시 그렇게 머물며 얼굴을 당신의 가슴에 비볐다.
		PRINTW
		;MASTERに恋人がいてアリスではないとき　本家からはこない
		IF !(CFLAG:TARGET:1 & 4) && TALENT:MASTER:恋人
			SELECTCASE iRT
				CASE IS >= K17C_恋慕
					IF K17_GET_FRIENDS(TALENT:MASTER:恋人)
						PRINTFORML 「...내가 %K17_RS("bad/inexcusable")%을 향해 %K17_CNAME(TALENT:MASTER:恋人)% 무언가를 하고 있다는 걸 알아.」
					ELSE
						PRINTFORML 「...나는 당신의 연인에게 %K17_RS("나쁜 것/용납할 수 없는 것")%을 하고 있다는 것을 알고 있다.」
					ENDIF
					PRINTFORML 「하지만 나는 당신을 %K17_RS("좋아해/사랑해/함께 있고 싶어")% 하지 않을 수 없어.」
					PRINTFORML 「나는 그저 %K17_RS("당신의 하렘의 일원/당신의 정부/당신의 후궁")%인 것으로 만족할 테니, 이것을 기억해...」
					PRINTFORML 「...사랑해.」
				CASE IS >= K17C_思慕
					PRINTFORML 「어쩌면... 이건 %K17_RS("나에게 나쁘거나/해서는 안 될 일")%일지도 몰라...」
					PRINTFORML 「하지만 스스로를 멈출 수가 없어...」
					PRINTFORML 「...나는 너를 좋아해.」
			ENDSELECT
			PRINTFORMDL 당신은 그저 %조사처리(CALLNAME:TARGET,"의")% 머리를 쓰다듬을 수밖에 없다.
		ELSEIF TALENT:K17C_ID:恋人 == 1
			;恋人同士
			PRINTFORML 「후우... 미안해. 아, 대신 고마워야겠어.」
			PRINTFORML 「내 머리... 아아... 우우...」
			PRINTFORMDL 앨리스가 이렇게 응석받이처럼 대접받는 것은 드문 일이었기에, 당신은 그 기회를 놓치지 않고 그녀의 머리를 쓰다듬는다.
			PRINTFORML 「벌써 연인이 되었는데도, 여전히 나랑 데이트를 해줘.」
			SELECTCASE iRT
				CASE IS >= K17C_性癖
					CALL HPH_PRINT, @"「%K17_CNAME(0,1)%, 사랑해HPH 사랑해HPHHPH 정말 많이HPH」", "L"
					PRINTFORML 「왜 나를 그렇게 많이 사랑하는 거야, 진심으로...」
					PRINTFORML 「모든 것에 대해 정말 고마워. 사랑해, %K17_CNAME(MASTER,1)%.」
				CASE IS >= K17C_恋慕告白
					PRINTFORML 「항상 나를 「%K17_RS("보살펴주거나/사랑해주거나/배려해주는")%」 대해 고마워.」
					PRINTFORML 「사랑해.」
				CASE IS >= K17C_思慕うふふ
					PRINTFORML 「%K17_CNAME()%, 나를 좋아해 주지, 그렇지...?」
					PRINTFORML 「후후, 아니, 나는 너를 더 좋아해.」
				CASE IS >= K17C_思慕
					PRINTFORML 「후훗... %K17_RS("만점이야/바로 그거야/정말 날 이해하는구나, 그렇지 않아")%.」
					PRINTFORML 「또 너에게 빠졌어.」
			ENDSELECT
			PRINTFORMDL 당신은 그저 %조사처리(CALLNAME:TARGET,"가")% 행복하다는 사실에 안도할 뿐이다.
			PRINTFORMDL 당신은 당신의 %K17_RS("사랑하는/소중한 연인")% %조사처리(CALLNAME:TARGET,"와")% 황홀한 순간을 보낸다.
			;-------------------------------------------------
			;お互いまだ誰とも付き合ってない時 本来の仕様
			;-------------------------------------------------
		ELSEIF !TALENT:MASTER:恋人
			;-------------------------------------------------
			;告白　初回
			;-------------------------------------------------
			IF CFLAG:K17C_ID:K17C_CF_告白イベント == 1
				PRINTFORML 「저기, 우리는 정확히 뭐야...?」
				SIF iRTF & K17C_RTF_キス
					PRINTFORML 「우린 이미 키스했어...」
				SIF iRTF & K17C_RTF_うふふ
					PRINTFORML 「우리 이미 ...육체적인 관계가 있어...」
				SIF !FIRSTTIME("オナバレ",1)
					PRINTFORML 「벌써 나를 봤어... 그게 하는 걸, 내 집에서...」
				PRINTFORMDL 그건 확실히 사실이야... 그녀와의 관계는 아직 불분명해.
				PRINTFORML 「지금 누구랑도 사귀고 있지 않지, 맞지?」
				PRINTFORML 「...」
				PRINTFORMDL 그녀는 말이 없어지고, 당신은 그녀가 다음 말을 찾고 있는지, 아니면 당신의 응답을 기다리고 있는지 확신할 수 없다.
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그저 말없이 당신의 소매를 계속 붙잡는다.
				PRINTW
				SELECTCASE iRT
					CASE IS >= K17C_恋慕
						PRINTFORML 「그러니까... 나와 진도를 맞춰줘...」
						PRINTFORMDL 그녀는 당신을 똑바로 바라보며 고백한다.
						PRINTFORMW 「나... 나는 당신을 사랑해...」
						PRINTFORML 「당신 없이 사는 건 더 이상 상상할 수 없어...」
					CASE IS >= K17C_思慕
						PRINTFORML 「그러니까... 나랑 사귀어 줄래...?」
						CALL HPH_PRINT,@"「...%K17_CNAME()%... 나... 좋아해 BPBBPBBPB」", "W"
						PRINTFORMDL 그녀는 얼굴을 새빨갛게 물린 채 가냘픈 목소리로 당신에게 고백한다.
						PRINTFORML 「%K17_CNAME()%, 이것에 대한 책임 좀 지용, 응...?」
				ENDSELECT
				;-------------------------------------------------
				;告白　二回目以降　アリス練習してきた！
				;-------------------------------------------------
			ELSE
				PRINTFORML 「후우... 뭐야, 아직도 모르겠어? 내가 다음에 할 말은...」
				PRINTFORML 「네가 누군가를 사귀기 시작할 때까지 계속 말해줄 거야.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신을 향해 돌아보며 당신의 눈을 똑바로 바라보고 말을 건넨다.
				SELECTCASE iRT
					CASE IS >= K17C_恋慕
						CALL HPH_PRINT,@"「%K17_CNAME()%은(는) 당신을 연모해요HPH」", "W"
						;口説き文句　あれこれ重くね？
						PRINTDATAL
							DATAFORM 「나는 매일 당신을 위해 요리하는 것도 괜찮아.」
							DATAFORM 「그리고... 매일 당신과 어른스러운 일을 하는 것도 괜찮아.」
							DATAFORM 「나는 매일 아침 당신 옆에서 일어나고 싶어...」
							DATAFORM 「언제 어디서든, 영원히 항상 당신 곁에 있고 싶어.」
						ENDDATA
						PRINTFORML 「그냥 포기하고 내 것이 되어줘, 벌써...」
					CASE IS >= K17C_思慕
						PRINTFORMW 「%K17_CNAME()%, 나는 당신을 좋아해요.」
						PRINTFORML 「저와 데이트해 주세요.」
						PRINTFORML 「어때요? 이번에는 부끄러워하지 않고 제대로 말했어요.」
				ENDSELECT
				;嘘だ！
				PRINTFORML 「음, 벌써 이렇게 기다렸으니까 바로 대답해 주길 기대하지 않아.」
				PRINTFORML 「그냥... 잘 생각해 줘, 알았지?」
			ENDIF
		ENDIF
		;フラグチェック
		CALL K17_RELATION_EV(K17C_RTF_告白)
		TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
		PRINTW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「...」
		PRINTFORML 「...너는... 정말 나랑 괜찮은 거니...?」
		PRINTFORMDL 물론이지. 연인이 되자.
		PRINTFORMDL 그게 네가 말하려는 것이지만...
		PRINTW
		PRINTFORML 「나... 나는 지금보다 더 귀여운 소녀가 될 거야!」
		;custom code
		IF CFLAG:K17C_ID:1092
			PRINTFORMDL "지금쯤 너 귀엽다고 생각한다..."
		ELSE
			PRINTFORMDL 그녀는 있는 그대로도 충분히 귀엽다고 생각한다...
		ENDIF
		PRINTFORML 「네 여자친구가 될 자격이 있는 사람이 되고 싶어.」
		PRINTFORML 「%K17_CNAME()%에게 고마워. 최선을 다할게.」
		PRINTW
		CALL HPH_PRINT, @"「%K17_CNAME()%은(는) 당신을 연모해요HPH」", "L"
		PRINTFORMDL 영감으로 넘쳐흐르며, %조사처리(CALLNAME:TARGET,"는")%(는) 당신을 꼭 안으며 미소 짓는다.
		PRINTFORMDL 당신은 그것이 지금까지 그녀가 보여준 그 어떤 미소보다 더 눈부시다는 것을 느낀다.
		;フラグチェック
		CALL K17_RELATION_EV(K17C_RTF_恋人)
