@M_KOJO_SPEVENT_K17_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:時間停止
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL = 1
	;-------------------------------------------------
	IF LOCAL && ARG == 0
		;デートイベントを再判定　SP再突入は一日一回
		IF TCVAR:K17C_ID:K17C_TC_デートイベ完走==0 && TCVAR:K17C_ID:K17C_TC_デートイベ判定==0 && !FLAG:時間停止
			CALL K17_DATE_EVENT_RELIEF(TARGET)
			IF TCVAR:K17C_ID:K17C_TC_デートイベ完走
				RETURN 1
			ENDIF
		ENDIF
		SELECTCASE K17_GRT(TARGET)
			CASE IS>=K17C_思慕うふふ
				PRINTFORML 「벌써 집에 갈 시간이야...」
				PRINTFORML 「참 안됐네... 당신과 함께 있을 때는 시간이 항상 너무 빨리 지나가.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 파고들며 당신의 %K17_RS("손/몸/팔")%를 놓기 싫어하는 듯하다.
			CASE IS>=K17C_思慕
				PRINTFORML 「응, 오늘 고마웠어.」
				PRINTFORML 「너랑 함께 있는 게 즐거웠어.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 항상 침착해 보이지만 오늘은 %K17_RS("얼굴이 살짝 붉어져 있다/계속 손을 잡고 있다/꽤 몰두한 듯하다")%.
			CASEELSE
				PRINTFORML 「음, 나중에 봐.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 아무 말 없이 성큼성큼 자리를 떠버렸다.
		ENDSELECT
		;戻ってきたので判定のみ戻し
		;一度目判定失敗（通常帰宅）してもイベント完走してなければ同じ日でもイベント見れるはず
		;ただし本家仕様は考慮されない仕方ないね
		;キスキャンセルした場合も完走としてみなし、翌日から
		TCVAR:K17C_ID:K17C_TC_デートイベ判定=0
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「내가 말한 대로 태도가 변한 것 같군.」
		PRINTFORML 「또 흥분하지 마라.」
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「오늘 합격 점수는 받을 수 있겠지.」
		PRINTFORML 「네 실수를 만회하기 위해 계속 열심히 해.」
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「오늘 이후로 당신에 대한 내 인상이 높아졌어.」
		PRINTFORML 「하지만 이것 하나만으로 내가 용서했다고 생각하지 마.」
	ENDIF
ENDIF
PRINTW
RETURN 1
