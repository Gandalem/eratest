				;尊敬系
			CASE K17C_魅魔ID,K17C_ルイズID,K17C_神綺ID,K17C_夢子ID
				PRINTFORML 「ー?! %K17_CNAME(ARG)%?!」
				PRINTFORML 「...내가 %K17_CNAME(ARG)%에게 문제를 일으킬 거라 상상하다니.」
				;その他
			CASEELSE
				PRINTFORML 「—?! ...우리가 목격당했어...」
