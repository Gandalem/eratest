@M_KOJO_EVENT_K17_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORML 「?!?! %K17_RS("Wha/Eh")%...!」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 분노에 찬 홍조와 함께 제자리에 떨었다.
		PRINTW
		;知り合いか見る
		SIF K17_GET_FRIENDS(ARG)
			PRINTFORML (%K17_CNAME(ARG)%이 그런 종류의 일을 하고 있다...)
		IF K17_GRT() >= K17C_思慕
			PRINTFORML (%K17_CNAME()%은 그런 종류의 것이 좋다...)
			PRINTFORML (나는 볼 수 있다... 모든 것을...)
			PRINTFORML (오 안 돼... 내 상상이 한동안 날뛰겠어...)
			PRINTW
		ENDIF
		PRINTFORML 「아hem, 그런 행동을 하다니, 음, 이런 곳에서 말이야...」
		PRINTFORML 「어쨌든, 좀 더 신중해!」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 꾸중을 듣는다.
		;思慕以上でMASTERに恋人がいないorアリスが恋人
		SIF K17_GRT() >= K17C_思慕 && (!(CFLAG:MASTER:既成事実 & 合意_恋人) || CFLAG:TARGET:既成事実 & 合意_恋人)
			CFLAG:TARGET:情事目撃 = ARG
		;弱みがつくはずなのでプライドと態度もあげちゃう
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_プライド,1)
		CALL K17_TALENT_UPDOWN(TARGET,K17C_TALENT_態度,1)
	ENDIF
	;-------------------------------------------------
	;負けじと参加（馴れ合い度:高）
	;恋人同士相手には乱入できないみたい
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		;-----------
		;開始時の主導権
		;溜まってる度の一時保存
		;情事相手のうふふ状態をみる
		;-----------
		IF CFLAG:MASTER:うふふ == 1
			;MASTER主導権
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_受け_お手伝い系
			TCVAR:K17C_ID:K17C_TC_うふふ主導権 = -1
			TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:TARGET:溜まってる度
			TCVAR:K17C_ID:K17C_TC_中出しカウント = 0
		ELSE
			;キャラ主導権
			CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = K17C_攻め_おねだり系
			TCVAR:K17C_ID:K17C_TC_うふふ主導権 = TARGET
			TCVAR:K17C_ID:K17C_TC_中出しカウント = 0
			IF TALENT:MASTER:性別 >= 2
				TCVAR:K17C_ID:K17C_TC_溜まってる度 = BASE:MASTER:精力
			ELSE
				TCVAR:K17C_ID:K17C_TC_溜まってる度 = CFLAG:溜まってる度
			ENDIF
		ENDIF
		;知り合いか見る
		SELECTCASE K17_GET_FRIENDS(ARG)
			;気安い系
			CASE K17C_霊夢ID,K17C_魔理沙ID,K17C_パチュリーID,K17C_幽香ID,K17C_咲夜ID,K17C_メディスンID
				PRINTFORML 「%K17_RS("Why～ you～/Ahhh～/Gahhh～")%! %K17_CNAME(ARG)%~을 혼자 두는 것은 %K17_CNAME(MASTER)% 혼자 두는 건 불공평해! 나도 끼겠어!」
				;尊敬系
			CASE K17C_魅魔ID,K17C_ルイズID
				PRINTFORML 「%K17_RS("Oh dear/Oh myー/Ahhー")%은(는) %K17_CNAME(MASTER)%을(를) 혼자 간직할 수 없어, %K17_CNAME(ARG)%.」
				PRINTFORML 「나도 함께 할 거야.」
				;神綺様　夢子限定
			CASE K17C_神綺ID,K17C_夢子ID
				;アリスが恋人な場合
				IF TALENT:TARGET:恋人
					IF FIRSTTIME(@"修羅場{ARG}")
						;初回
						PRINTFORML 「에... 말도 안 돼... %K17_CNAME(ARG)%?!」
						PRINTFORMDL 드문 충격의 순간, %조사처리(CALLNAME:TARGET,"는")% 서려고 애쓰며 무릎을 떨고 있다.
						PRINTW
						PRINTFORML 「모든 것 중에서... 심지어 %K17_CNAME(ARG)%에게 손을 대다니... 언젠가, 나는...」
						PRINTFORMDL 『%CALLNAME:TARGET%\@ ARG==K17C_神綺ID ? -짱 #  \@, 네가 생각하는 게 아니야!』라고 %CALLNAME:ARG%는 자신의 상황을 설명하려 한다...
						PRINTFORMDL 분위기가 완전히 바뀌었다...
						PRINTFORMDL ...
						PRINTFORMDL ......
						PRINTFORMDW .........
						;勝手に想像して　親子丼とか浮気とかそんな感じのあれそれ
						PRINTFORML 「좋아... 그렇다면 이것은, 뭐라고 불러야 할까...」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 네 허벅지를 꽉 움켜쥔다.
						PRINTFORML 「음... 네가 혼자 비밀리에 하는 것보다는... 내가 같이 할게.」
						;PRINTFORMDL %CALLNAME:TARGET% seems to be harboring a sense of defiance towards %CALLNAME:ARG%.
						PRINTFORML 「Anyway, monopolizing %K17_CNAME(MASTER,1)% like this is forbidden!」
						PRINTW
					ELSE
						;二回目以降
						PRINTFORML 「흐으... 또...」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 길고 짜증 난 한숨을 내쉬며 %CALLNAME:ARG%와 당신 사이를 움직인다.
						PRINTFORMDL 『%CALLNAME:TARGET%\@ ARG==K17C_神綺ID ? -chan #  \@, 이건...』라고 말하는 %CALLNAME:ARG%는 같은 변명을 한다...
						PRINTW
					ENDIF
				ELSE
					PRINTFORML 「맙소사... 당신을 가장 예상치 못한 사람인 %K17_CNAME(ARG)%와 함께 발견하다니...」
				ENDIF
				;知らない人
			CASEELSE
				PRINTFORML 「나도 같이 할게, 알겠지?」
		ENDSELECT
		TRYCALL K17_乱交開始(ARG)
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	;してる方が恋人だった場合、そそくさと立ち去る（恋人が混じっている多人数プレイかつTARGETが恋人でない場合も立ち去る
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORML 「아, 방해해서 죄송합니다...」
		;知り合いか見る
		SIF K17_GET_FRIENDS(ARG)
			PRINTFORML (%K17_CNAME(ARG)%이 그런 종류의 일을 하고 있다...)
		;恋人か見る
		SIF TALENT:ARG:恋人
			PRINTFORML (그들이 연인이라고 치자, 그러니 이런 짓을 하는 건 자연스러운 거겠지...)
		;思慕以上でMASTERに恋人がいないorアリスが恋人
		SIF K17_GRT() >= K17C_思慕 && (!(CFLAG:MASTER:既成事実 & 合意_恋人) || CFLAG:TARGET:既成事実 & 合意_恋人)
			CFLAG:TARGET:情事目撃 = ARG
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて参加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG:1 == 4
	;PRINTFORML
	;RETURN 1
	;ENDIF
	;その他
	PRINTW
ENDIF
RETURN 1
