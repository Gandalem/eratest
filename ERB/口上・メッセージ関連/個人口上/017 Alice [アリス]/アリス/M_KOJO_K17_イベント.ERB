LOCAL = 1
;-------------
IF LOCAL && !FLAG:時間停止
	PRINTL
	;知り合いのなりきり　ドッペルギャンガー未対応
	IF FLAG:なりきり && K17_GET_FRIENDS(FLAG:なりきり)
		PRINTFORML 「%K17_GT()%, %K17_CNAME()%.」
