@M_KOJO_EVENT_K17_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMD %CALLNAME:TARGET% 
		SELECTCASE K17_GRT()
			CASE IS >= K17C_恋慕
				PRINTFORMD 너에게 손을 흔들고, 
				PRINTFORMD %K17_RS("윙크한다/미소 짓는다/몽환적으로 바라본다")%, 그리고 
			CASE IS >= K17C_思慕
				PRINTFORMD 당신을 향해 가볍게 손을 들고, 
				PRINTFORMD %K17_RS("살짝 얼굴이 붉어진다/조금 부끄러워 보인다/당신의 눈과 마주치자 시선을 피한다")%, 그리고 
		ENDSELECT
		PRINTFORMDL %K17_RS("approaches/greets")%당신에게 다가와 인사한다.
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		LOCALS:0 = 
		SELECTCASE K17_GRT()
			CASE IS >= K17C_恋慕
				LOCALS:0 = %K17_RS("lightly waves/winks/smiles")%당신에게 가볍게 손을 흔들거나 눈짓하거나 미소 짓고
			CASE IS >= K17C_思慕
				LOCALS:0 = %K17_RS("가볍게 손을 들거나/흘겨보거나/가볍게 인사한다")% 당신에게 그리고
		ENDSELECT
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %LOCALS:0%가 당신을 배웅한다.
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		LOCALS:1 = 
		SELECTCASE K17_GRT()
			CASE IS >= K17C_恋慕
				LOCALS:1 = %K17_RS("looks warmly at you, and/stares intently at you, and/seems to want to say something to you, but wordlessly")%당신을 따뜻하게 바라보거나, 혹은 강렬하게 응시하거나, 무언가 하고 싶어 하는 듯 보이지만 말은 하지 못한다.
			CASE IS >= K17C_思慕
				LOCALS:1 = %K17_RS("exchanges glances with/glances at")%당신에게 눈을 마주치거나 바라본다.
		ENDSELECT
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %LOCALS:1%가 당신을 배웅했다.
	ENDIF
ENDIF
RETURN 1
