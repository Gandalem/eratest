@M_KOJO_EVENT_K17_23(ARG,ARG:1)
#DIM DYNAMIC iMOB = 0
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;断られた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「아니요, 그런 관계는 아닌 것 같아요.」
	ENDIF
	;-------------------------------------------------
	;一緒に入ってくれた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「여기는 정말 사람들이 함께 목욕하는 걸 좋아하네...」
		PRINTFORML 「너무 많이 쳐다보지 말아줘, 알겠지?」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 망설이며 몸을 뒤척이지만, 당신은 아무렇지도 않게 옷을 벗는다.
		PRINTFORML 「저기- 먼저 들어가도 돼.」
		PRINTW
		PRINTFORMDL 당신은 %CALLNAME:TARGET%보다 먼저 욕조에 들어갔지만, 그녀는 따라오는 것 같지 않다.
		PRINTFORMDL 여러 번 그녀를 부른 후에야 %조사처리(CALLNAME:TARGET,"는")% 몸을 숨기려 조심스럽게 욕조에 발을 들인다.
		;アリスの他に同行者がいるかチェック
		FOR i,1,CHARANUM
		SIF !TARGET:i
			BREAK
		IF (CFLAG:(TARGET:i):同行) && TARGET:i != K17C_ID
			iMOB = TARGET:i
			BREAK
		ENDIF
		NEXT
		;連れ出しは先MASTERだけ移動するのが現仕様なので、その位置で他TARGETが居ないか見とく
		;アリスの位置では他TARGETを考慮しない
		;設定して気づいたけどお風呂に他キャラいると、そっちが先に読まれてここはこないっぽい
		IF K17_CHECK_RANDOM_EVENT(TARGET,-1,0) && K17_GET_CHARA_POSNUM(MASTER) == 0 && !iMOB
			;れっつとらぶる
			TRYCALL K17_お風呂イベント(TARGET)
			SIF RESULT
				PRINTFORMDL 더 이상 아무 말도 하지 않고 그녀는 얼굴을 새빨갛게 물린 채 목욕물 속에 몸을 담갔다.
		ENDIF
		IF !RESULT
			PRINTFORMDL 너는 그녀의 %K17_RS(HIP_TR(TARGET)+"/"+OPPAI_DESCRIPTION_TR(TARGET,1)+"/smooth thighs")%를 언뜻 본다.
		ENDIF
	ENDIF
	PRINTW
ENDIF
RETURN 1
