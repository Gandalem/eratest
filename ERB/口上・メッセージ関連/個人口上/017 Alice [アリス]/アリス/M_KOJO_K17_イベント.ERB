		ENDIF
	ENDIF
	;-------------------------------------------------
	;目が合った（追い出されない）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「꺄아!?」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 벌거벗은 채 안에 있다.
		PRINTFORML 「오, 당신뿐이군요, 다른 사람일까 봐 걱정했어요.」
		PRINTFORMDL 그녀는 애타게 당신에게 다가간다.
		IF !TCVAR:K17C_ID:K17C_TC_お風呂イベント && !CFLAG:MASTER:同行 && K17_CHECK_RANDOM_EVENT(TARGET)
			;れっつとらぶる
			TRYCALL K17_お風呂イベント(TARGET)
			SIF RESULT
				PRINTFORMDL 더 이상 아무 말도 하지 않고 그녀는 얼굴을 새빨갛게 물린 채 목욕물 속에 몸을 담갔다.
		ELSE
			PRINTFORMDL 당신은 그녀의 한쪽 모습을 스쳐 본다 %K17_RS(HIP_TR(TARGET)+"/"+OPPAI_DESCRIPTION_TR(TARGET,1)+"/voluptuous thighs")%.
		ENDIF
	ENDIF
	PRINTW
ENDIF
RETURN 1
