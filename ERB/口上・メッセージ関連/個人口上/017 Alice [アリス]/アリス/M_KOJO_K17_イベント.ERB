	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;振られた回数によって分岐
		SELECTCASE CFLAG:K17C_ID:K17C_CF_告白イベント
			CASE IS >= 10
				PRINTFORML 「벌써 열 번 넘게 나를 거절했어...」
				PRINTFORML 「...바보 같아...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 눈에서 쓰디쓴 눈물이 흘러내린다.
				PRINTFORML 「...하지만... 난 너를 사랑해...」
			CASE IS >= 5
				PRINTFORML 「후우...」
				PRINTFORML 「알아... 알아, 그러니까 말 안 해도 돼...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 그렇게 말하며 시선을 돌린다. 그녀는 상당히 풀이 되어 보인다...
			CASEELSE
				PRINTFORML 「후우... 괜찮아. 괜찮아.」
				PRINTFORML 「계속 노력할 거고, 언젠가 반드시 네 관심을 얻을 거야...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 용감한 표정을 지으려 하지만, 눈가에는 눈물이 살짝 고여 있다.
		ENDSELECT
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 어울리는 단어를 찾을 수 없다...
		TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
		PRINTW
		RETURN 1
	ENDIF
	TCVAR:K17C_ID:K17C_TC_デートイベ完走=1
ENDIF
RETURN 1
