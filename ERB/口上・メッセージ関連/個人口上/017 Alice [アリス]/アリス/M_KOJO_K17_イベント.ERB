					LOCALS += " in my "+K17_CALL_P(K17C_部位A)+" and "+K17_CALL_P(K17C_部位V)+"... "
				CASE 2
					LOCALS += " in "
					ABLnum = K17C_部位V
				CASEELSE
					LOCALS += "... "
			ENDSELECT
		ENDIF
		;-------------------------------------------------
		;喘ぎ
		;-------------------------------------------------
		TRYCALL K17_H妄想_喘ぎ(iType,ARG==6 ? 1#0)
		;-------------------------------------------------
		;絶頂処理
		;-------------------------------------------------
		;部位
		PRINTFORML 「%K17_喘ぎ声(iType,6,1)%... %K17_快楽_喘ぎ声(iType,8000,ABLnum)%... %K17_喘ぎ声(iType,6,1,1)%...」
		PRINTFORML 「%K17_喘ぎ_絶頂(iType,ABLnum,LOCALS)%...」
		PRINTW
		;感想戦
		CALL HPH_PRINT,"「하아... 흐읍」", "L"
		PRINTFORMDL %CALLNAME:TARGET%'의 몸은 정신을 잃을 정도로 강렬한 오르가슴 후에 힘이 빠져, 그녀는 멍하니 그곳에 누워 있었다.
		PRINTFORMDL 그녀는 이마에 손을 대고 호흡을 가다듬으려고 애썼다.
		PRINTFORML (어쩌면 %K17_RS("답답해/좀 됐어/생리 기간이 다가")%...)
		SELECTCASE iType
			;受け
			CASE K17C_受け_おねだり系
				PRINTFORML (%K17_RS("begging/pleading/being pampered")% 같은 것을 상상하다...)
			CASE K17C_受け_合意襲い系
				PRINTFORML (%HIM_HER(MASTER,,1)%을 유혹하고 그렇게 %K17_RS("violated/ravished/raped")%당하는 것을 상상한다...)
			CASE K17C_受け_無理矢理系
				PRINTFORML (그렇게 %K17_RS("침해당하다/약탈당하다/강간당하다")%되는 것을 상상한다...)
			CASE K17C_受け_お手伝い系
				PRINTFORML (그렇게 %K17_RS("거칠게 사용당하거나/강간당하거나/엉망으로 만들어진")% 된 것을 상상한다...)
				;攻め
			CASE K17C_攻め_おねだり系
				PRINTFORML (%K17_RS("처럼 ")%을 %HIM_HER(MASTER,,1)%에게 해주는 것을 상상하며...)
			CASE K17C_攻め_合意襲い系,K17C_攻め_無理矢理系
				PRINTFORML （Fantasizing about %K17_RS("violating/assaulting/raping")% %HIM_HER(MASTER,,1)% like that...）
			CASE K17C_攻め_お手伝い系
				PRINTFORML (%K17_RS("처럼 ")%을 %HIM_HER(MASTER,,1)%하는 것을 상상하며...)
		ENDSELECT
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 자기혐오에 빠져 허우적거린다.
		SIF CFLAG:TARGET:初期位置 != CFLAG:MASTER:初期位置
			CFLAG:K17C_ID:K17C_CF_オナニーフラグ = 1
		;無知以外自慰終端
	ENDIF
ENDIF
RETURN 1
