;夜寝るとき（おやすみ口上）
;==================================================

@M_KOJO_EVENT_K17_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;自室がMASTERと同じでもでちゃうので条件追加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1 && (CFLAG:TARGET:初期位置 != CFLAG:MASTER:初期位置)
		SELECTCASE K17_GRT_EX(TARGET)
			CASE IS >= K17C_恋慕
				PRINTFORML 「머물고 싶지만, %K17_RS("오늘은 정말 집에 돌아가야 해/돌아가야지/집에 가야겠어")%...」
			CASE IS >= K17C_思慕
				PRINTFORML 「%K17_RS("나도 이제 집에 갈 때가 됐어/집에 가야 할 시간이야/하루를 마무리할 시간이야.")%」
			CASEELSE
				PRINTFORML 「응, 나중에 봐.」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE K17_GRT_EX(TARGET)
			CASE IS >= K17C_思慕うふふ
				PRINTFORML 「...음... 후아... 미안해... 졸려졌어.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 기대며 졸린 듯 고개를 떨구기 시작한다.
			CASEELSE
				PRINTFORML 「...후와아... 실례합니다, 잠을 자야 할 것 같아요.」
				PRINTFORMDL 그녀가 하품을 참으려고 애쓰는 모습이 좀 귀엽다.
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3 || LOCAL:1 && ARG == 4
		SELECTCASE K17_GRT(TARGET)
			CASE IS >= K17C_恋慕生解禁
				PRINTFORML 「...%K17_CNAME()%... 에헤헤... %K17_RS("사랑해/더 하자/나 좀 더 사랑해줘")%...」
			CASE IS >= K17C_思慕
				PRINTFORML 「...%K17_CNAME()%... %K17_RS("Love you.../Pervert.../Dummy～")%」
			CASEELSE
				PRINTFORML 「...%K17_RS("Nnn/Fuuー/Fwaa")%... %K17_RS("Marisa～/Shang...hai/Mom")%? ...」
		ENDSELECT
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 행복하게 잠들어 있으며 평소보다 %K17_RS("더 유치하다/귀엽다/더 솔직하다")%해 보인다.
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「미안해, 더는 갈 수 없어...」
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「어? 괜찮아...?」
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			IF !CFLAG:MASTER:睡眠
				PRINTFORML 「너무 늦게까지 깨어 있지 마...」
				PRINTFORMDL 그녀는 아무 말 없이 서둘러 잠자리에 든다.
			ELSE
				;マスターが寝てる場合
				PRINTFORML 「...벌써 자고 있네.」
				PRINTFORML 「후후, 꽤 귀엽구나...」
			ENDIF
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「착한 아이들과 여자아이들에게는 이제 잠잘 시간이야.」
			PRINTFORML 「그러니 자러 가렴.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;非在住TARGETがMAIN_MAPで休憩
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 「음~ 조금만 쉬려고 해.」
	ENDIF
	;その他
	PRINTW
ENDIF
RETURN 1
