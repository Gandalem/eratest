				PRINTFORMDL The way she tries to stifle her yawns is kind of cute.
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3 || LOCAL:1 && ARG == 4
		SELECTCASE K17_GRT(TARGET)
			CASE IS >= K17C_恋慕生解禁
				PRINTFORML 「...%K17_CNAME()%... Ehehe... %K17_RS("Love you/Let's do it, more/Love me, more")%...」
			CASE IS >= K17C_思慕
				PRINTFORML 「...%K17_CNAME()%... %K17_RS("Love you.../Pervert.../Dummy～")%」
			CASEELSE
				PRINTFORML 「...%K17_RS("Nnn/Fuuー/Fwaa")%... %K17_RS("Marisa～/Shang...hai/Mom")%? ...」
		ENDSELECT
		PRINTFORMDL %CALLNAME:TARGET% is happily sleeping, and she seems %K17_RS("more childish/cuter/more honest")% than usual.
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
		;PRINTFORMW 
		;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「I'm sorry, I can't go any longer...」
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「Hey?! Are you okay...?」
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			IF !CFLAG:MASTER:睡眠
				PRINTFORML 「Don't stay up too late...」
				PRINTFORMDL Without another word, she quickly goes to bed.
			ELSE
				;マスターが寝てる場合
				PRINTFORML 「...So you're already sleeping.」
				PRINTFORML 「Fufu, you're rather cute...」
			ENDIF
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「It's bedtime for good boys and girls.」
			PRINTFORML 「So shoo, shoo.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;非在住TARGETがMAIN_MAPで休憩
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 「Nnnー, I'm going to rest for just a little bit.」
	ENDIF
	;その他
	PRINTW
ENDIF
RETURN 1

