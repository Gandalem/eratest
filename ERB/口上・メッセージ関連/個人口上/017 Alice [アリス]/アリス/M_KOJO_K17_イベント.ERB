		IF !FIRSTTIME("(313|315|316)口上",1,K17C_ID)
			PRINTFORM Experience with sexual harassment commands detected...
			PRINTFORM \nInitializing new flags... 
			CALL K17_SET_AUTO_PVOICE(,,K17C_受け_合意襲い系)
