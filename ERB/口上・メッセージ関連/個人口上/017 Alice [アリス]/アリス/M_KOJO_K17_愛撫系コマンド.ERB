@M_KOJO_MESSAGE_COM_K17_0_1
#DIM iABLnum = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:時間停止 && !CFLAG:睡眠
	;-----------------
	;フラグ初回チェック
	;-----------------
	IF !CFLAG:K17C_ID:K17C_CF_FKマスター
		CALL K17_FIRSTKISS(TARGET)
		RETURN 1
	ENDIF
	SELECTCASE RAND:3
		CASE 0
			iABLnum = K17C_部位C
		CASE 1
			iABLnum = K17C_部位B
		CASE 2
			iABLnum = K17C_部位M
	ENDSELECT
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),iABLnum)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	PRINTFORML 「%K17_AUTO_PVOICE()%」
	PRINTW
ENDIF
RETURN 1
