@M_KOJO_MESSAGE_COM_K17_9
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL TRAIN_MESSAGE
	CALL M_KOJO_MESSAGE_COM_K17_睡眠愛撫
ELSE
	CALL K17_SET_KOJO_COLOR
	CALL M_KOJO_MESSAGE_COM_K17_9_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_9_1
#DIM iType = 0
#DIMS cText
VARSET cText
;-------------------------------------------------
;感覚部位を選定
;-------------------------------------------------
IF TEQUIP:バイブ
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_部位V)
ELSEIF TEQUIP:アナルバイブ
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_部位A)
ELSEIF TEQUIP:シャワー
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),K17C_部位C)
ELSE
	CALL K17_SET_AUTO_PVOICE(K17_GRT_EX(),RAND:2?K17C_部位C#K17C_部位B)
ENDIF
;-------------------------------------------------
;9,自慰
;性癖あり
;-------------------------------------------------
IF K17_RT_FG() & K17C_RTF_性癖 && !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い) && GET_TARGETNUM() == 1
	;性癖あり　ねだり系　二人きり
	;妄想発表
	;一旦タイプ切り替え
	iType = CFLAG:K17C_CF_喘ぎタイプ
	cText = %K17_H妄想()%
	CALL K17_SET_AUTO_PVOICE(,,K17_喘ぎタイプ_H妄想(RESULT:0,RESULT:1))
	; [AUTO-NEUTRALIZED] PRINTFORMDL 너는 말한다 %CALLNAME:TARGET% 네가 그녀를 보고 싶다고 말해줘 %K17_RS("masturbate/\"research\")% 그녀가 혼자 있을 때 평소에 하는 방식대로
	IF FIRSTTIME(@"{SELECTCOM}口上")
		;初回
		PRINTFORML 「에엣?! 우우... 내 어두운 비밀을 그렇게 이용하다니...」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 부끄러움에 몸을 비틀며 투덜거리지만, 결국 당신의 요청에 응한다.
		PRINTW
		PRINTFORML 「음, 할게... 하지만... 먼저 말하고 싶은 건, 혼자 할 때는 정말 외롭다는 거야...」
		PRINTFORML 「그러니까 나중에 꼭 사랑받는 기분을 느끼게 해줘... 응?」
		PRINTFORMDL 그녀의 머리를 부드럽게 쓰다듬으며, 당신은 %조사처리(CALLNAME:TARGET,"를")% 무릎 위에 앉힌다.
	ELSE
		;二回目以降
		PRINTFORML 「또...? 너 정말 %K17_RS("변태/괴물")%구나...」
		PRINTFORMDL 비록 %조사처리(CALLNAME:TARGET,"는")%(는) %K17_RS("부끄러워 몸을 움츠리거나 투덜거린다")%, 결국 당신의 요청에 동의한다.
		CALL HPH_PRINT,@"「%K17_RS("네가 ~하지 않으면 용서 못 해/하지만 네가 ~할 때만")% 나에게 %K17_RS("사랑받는 듯한/좋은")% 느낌을 준다면」", "L"
		PRINTFORMDL 부드럽게 %K17_RS("그녀의 머리를 쓰다듬으며 그녀를 가까이 안는다")%, 당신은 %조사처리(CALLNAME:TARGET,"를")% 자신의 무릎 위 홈 포지션으로 들어 올린다.
	ENDIF
	PRINTW
	CALL K17_MESSAGE
	CALL K17_CLL_COUNTER_REACTIONMESSAGE
	PRINTFORML 「%K17_AUTO_PVOICE()%」
	PRINTFORMDL 그녀의 "연구 모드"로 접어들며, %조사처리(CALLNAME:TARGET,"는")% 눈을 감고 자신의 환상 속으로 빠져든다...
	PRINTW
	PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 귓가에 속삭이며 그녀에게 무슨 생각을 하고 있는지 묻는다.
	PRINTFORML 「%cText%」
	CALL HPH_PRINT,"「그게 내가 선택한 설정이야 BPB」", "L"
	PRINTW
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%/가 격렬하게 얼굴을 붉히며 자신의 판타지를 고백하지만, 당신은 흥분의 기미 또한 느낄 수 있다.
	PRINTFORMDL 그녀의 판타지의 대상 앞에서 자위하는 이 패턴은 두 사람에게 또 다른 성적인 시나리오가 되었다...
	CFLAG:K17C_CF_喘ぎタイプ = iType
	RETURN 1
	;-------------------------------------------------
	;9,自慰
	;汎用
	;-------------------------------------------------
ELSE
	;性癖なしor襲い系
	CALL K17_MESSAGE
	CALL K17_CLL_COUNTER_REACTIONMESSAGE
	PRINTFORML 「%K17_AUTO_PVOICE()%」
	IF !(CFLAG:K17C_CF_喘ぎタイプ & K17C_喘ぎF_襲い)
		;ねだり系
		PRINTFORMDL 그녀가 쾌락에 잠겨 있을 때, %조사처리(CALLNAME:TARGET,"의")% 손동작에서 상당한 숙련도를 느낄 수 있다...
	ELSE
		;襲い系
		PRINTFORMDL 비록 %조사처리(CALLNAME:TARGET,"는")% 당신의 명령에 저항하며 따르지만, 그녀의 손이 이것에 꽤 익숙하다는 것을 느낀다.
	ENDIF
	RETURN 1
ENDIF
