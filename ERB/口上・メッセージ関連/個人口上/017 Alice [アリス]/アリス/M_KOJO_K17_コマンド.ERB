;==================================================
;189,新妻プレイ
;==================================================

@M_KOJO_MESSAGE_COM_K17_189
IF FLAG:時間停止 || CFLAG:TARGET:睡眠
	CALL M_KOJO_MESSAGE_COM_K17_睡眠
ELSE
	CALL M_KOJO_MESSAGE_COM_K17_189_1
	PRINTW
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K17_189_1
#DIM iType = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;タイプ保存
	;-------------------------------------------------
	IF TEQUIP:新妻プレイ
		;拘束のみが入った時　つまり装着した時タイプ一時保存
		iType = CFLAG:K17C_ID:K17C_CF_喘ぎタイプ
	ELSE
		;拘束が入ってないでここ来た場合は外した時
		;縄ありなら先に解除しないとこっちもできないみたい
		CFLAG:K17C_ID:K17C_CF_喘ぎタイプ = iType
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初回　装着時
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(@"{SELECTCOM}口上") && TEQUIP:新妻プレイ
		;初回　付けた時
		PRINTFORML 「앞치마요? 그냥 이렇게 쓰면 되나요?」
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 신혼부부처럼 행동하라고 말한다.
		CALL HPH_PRINT,"「신혼부부라니... BPB 좋아, 한번 해볼게.」", "L"
	ELSEIF TEQUIP:新妻プレイ
		;二回目以降　付けた時
		CALL HPH_PRINT,@"「이 %K17_RS("apron/newlyweds")% 시나리오 또인가...흐읍흑」", "L"
	ELSE
		;外した時
		PRINTFORML 「후우... 끝난 거야?」
		RETURN 1
	ENDIF
	;現在の服装検査
	CALLF K17_GET_CLOTHNAME_TOP(TARGET,1)
	IF RESULT == 2
		;服着てる
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그녀의 %K17_GET_CLOTHNAME_TOP(TARGET)% 위에 앞치마를 쓴다.
		PRINTFORML 「%K17_RS("usual/I usually wear during house chores")%처럼 말이다.」
	ELSEIF RESULT == 1
		;下着のみ
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 자신의 %K17_GET_CLOTHNAME_TOP_UNDER()% 위에 앞치마를 두었다.
		PRINTFORML 「이-이거 좀 %K17_RS("breezy/strange")%한 기분이 드네... 이런 거 좋아해?」
		PRINTFORML (맨몸인 것보다 뭔가 더 도착적인 느낌이야...)
	ELSE
		;上半身裸
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 벌거벗은 몸 위에 앞치마를 두른다.
		PRINTFORML 「나는 %K17_RS("이런 것을 책에서 읽었거나 여기 사람들이 이런 종류의 것을 좋아한다고 들었지만")%, 하지만... 정말로 이걸 하고 있다니 믿을 수가 없어...」
		PRINTFORML (이것은 어떻게든 벌거벗고 있는 것보다 더 도착적으로 느껴진다...)
	ENDIF
ENDIF
RETURN 1
