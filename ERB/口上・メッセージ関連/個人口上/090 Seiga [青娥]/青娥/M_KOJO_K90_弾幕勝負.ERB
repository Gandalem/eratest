; Modular ERB: 個人口上/090 Seiga [青娥]/青娥/M_KOJO_K90_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K90_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「상냥하게 죽여드리겠어요...%UNICODE(0x2665) *1%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「그럼 잘 부탁드려요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「요시카쨩! 나갈 차례야!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아아, %조사처리(CALLNAME:MASTER,"의")% 실력을 볼 수 있군요...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「충실한 나의 소년아, 대도를 거부하는 자는 뿌리째 제거해라!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「큭!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아앙%UNICODE(0x2665) *1%격렬하네요%UNICODE(0x2665) *1%」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「맞아버렸네요 %UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...이 정도로는 부족하단다?」
				ELSE
					PRINTFORMW 「의외로 잘 하시네요.」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...이런 힘이 있다는 게 정말 역겹습니다」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「이렇게까지 나를 궁지에 몰아넣다니... 흥분해져 버리겠어요...」 %UNICODE(0x2665) *1%
				ELSEIF RAND:3 == 0
					PRINTFORMW 「그렇게 격렬하게 몰아붙여지면 곤란합니다%UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「요시카쨩~! 어떻게든 해줘!」
				ELSE
					PRINTFORMW 「싫어어%UNICODE(0x2665) *1% 이대로 지고 말겠어요%UNICODE(0x2665) *1%」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……정말 귀찮네……」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「훌륭해요%UNICODE(0x2665) *1%」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「졌네요.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「어라? 어라라라라?」
				ELSE
					PRINTFORMW 「후훗 재미있네요 %UNICODE(0x2665) *1%」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		IF RAND:4 == 0
			PRINTFORMW 「방심해서는 안 돼요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「어머, 그냥 눈감아주길 바랐나?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그냥 일어나 주지 않으면 곤란하겠네요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「이것이 진정한 기상 압박%UNICODE(0x2665) *1%이다%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		IF RAND:4 == 0
			PRINTFORMW 「선인은 아쉽게도 아주 힘이 세시답니다%UNICODE(0x2665) *1%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「그 정도 가지고 나를 쓰러뜨릴 수 있다고 생각하는 거야?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「연단으로 단련한 이 몸이라면 이 정도는」
		ELSE
			PRINTFORMW 「후훗, 아프지도 가렵지도 않네요%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「기대 이하로군, 분수에 맞지 않은 바보 같아」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아이고, 기대에 못 미쳤네요」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「압승이네요 %UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「살아있는 몸으로 나와 싸울 수 있다는 게 다행이라고 할 수 있겠네요.」
				ELSE
					PRINTFORMW 「의외로 약했네요」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「성가시다는 건 인정해 주도록 하지」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「……좀 유행이 되었네요.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아직 실력을 다 보여주지 못했나?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「조금 더 진심을 보여주시면 흥분할 텐데요...」
				ELSE
					PRINTFORMW 「별일 없었네요.」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「정말... 이렇게까지 고집을 부리다니...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「한 걸음만 더 남았었네요 %UNICODE(0x2665) *1%」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「상당히 강하셨어요, %CALLNAME:MASTER%, 좋아하게 될지도 모르겠어요%UNICODE(0x2665) *1%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...까지 하게 되다니... 예상치 못한 수확이네요%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「...조금 더 있으면 제가 당할 뻔했어요...」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...마음대로 해주세요」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아라라라, 대단하시네요. 역시 환상향 사람들은 실력이 있군요.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「훌륭하네, 당신은 범상치 않은 사람이군요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「아앙%UNICODE(0x2665) *1% 점점 더 흥미로워졌어요%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「아앙%UNICODE(0x2665) *1%져버렸어요%UNICODE(0x2665) *1%」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
