;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K90_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K90_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「...무슨 용무인가요...?」
		PRINTFORMW 청아는 분노가 담긴 목소리로 돌아보았다.
		;会話不能
	ELSEIF TCVAR:302
		PRINTFORMW 「...뭐라도 이야기 하지 않을래요?」
		PRINTFORMW 청아는 어색한 분위기를 견딜 수 없는 듯하다.
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「으음%UNICODE(0x2665) *1%천국이 따로 없네요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좋은 물이네요. %UNICODE(0x2665) *1% 명탕을 자랑하는 온천인가요?」
		ELSE
			PRINTFORMW 「온천 여행도 나쁘지 않네요%UNICODE(0x2665) *1%언젠가 좀 더 먼 곳으로 가볼까요%UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 아름다우니 지루하네요 %UNICODE(0x2665) *1%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「봄의 풍경은 신비롭네요%UNICODE(0x2665) *1%」
					ELSE
						PRINTFORMW 「따뜻하니까 어디든 같이 가볼까요%UNICODE(0x2665) *1%」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 더우면 요시카쨩이 상해버릴 거야... 빨리 정비해야 해...」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「물놀이를 하고 싶으시군요... 아, 물론 %CALLNAME:MASTER%도 같이요 %UNICODE(0x2665) *1%」
					ELSE
						PRINTFORMW 「여름은 생명의 넘치는 계절이고 음과 양의 균형이 매우 무너지기 쉬우니까... 아무것도 아니에요%UNICODE(0x2665) *1%」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「요시카쨩이 노래하고 있었나? ... 나중에 들으러 갈까」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「가을은 금전운이 오르기 쉬운 계절이라고들 합니다. 지금이라면 이 사륜(四猿)이 금전운을... 그렇게 의심하지 말아 주세요!」
					ELSE
						PRINTFORMW 「가을밤 긴 밤에 한잔하는 건 어때? 둘이서 오래 이야기하지 않겠어%UNICODE(0x2665) *1%」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「이렇게 추우니까 요시카쨩이 얼어버려 버리네...!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「어머? 이렇게 추운데 더 가까이 와도 괜찮아요?」
					ELSE
						PRINTFORMW 「이 계절은 제 차례랍니다! 왜냐고요? 그건 비밀이에요♪입니다%UNICODE(0x2665) *1%」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:4 == 0
						PRINTFORMW 「오늘은 %조사처리(CALLNAME:MASTER,"는")% 무엇을 하고 싶어?」
						PRINTFORMW 청아는 그렇게 말하며 상냥하게 담소를 시작했다.
						PRINTFORMW 「뭐든지 해줄 수 있지만... 재미있는 것이 좋겠어요♪」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「나, 이렇게 있는 게 제일 즐거워」
						PRINTFORMW 「적어도 1400년 중에서, 제일이야 %UNICODE(0x2665) *1%」
						PRINTFORMW 청아는 감격한 표정으로 그렇게 말했다.
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 죽으면 무엇을 상대해서라도 되살려 줄 거예요 %UNICODE(0x2665) *1%」
						PRINTFORMW 청아는 요염하게 미소 지었다.
					ELSE
						PRINTFORMW 「이 환상향에 %CALLNAME:MASTER%같은 사람을 만날 수 있을 거라고는 생각 못 했어.」
						PRINTFORMW 「...흥미롭다는 의미만이 아니라 연인으로서 말이야.」
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:4 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 정말 신비해요」
						PRINTFORMW 「잡을 수 없는 느낌이라고 해야 하나... 구름을 잡는 것 같다고 할까...」
						PRINTFORMW 청아는 그렇게 말하며 가만히 자신을 응시한다.
						PRINTFORMW 「...나중에 자세히 들려주세요... %UNICODE(0x2665) *1%」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「이 환상향에는 아직 더 많은 신기한 일들이 있답니다」
						PRINTFORMW 「예를 들면 그런 것들... %CALLNAME:MASTER%같은 거 말이에요...」
						PRINTFORMW 「...어머, 다른 뜻은 없어요 %UNICODE(0x2665) *1%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「1000년 있으면 세상은 변하겠지만 환상향은 어떨까?」
					ELSE
						PRINTFORMW 「연인이 산타클로스~♪」
						PRINTFORMW 청아는 의미심장한 노래를 부르고 있다.
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:4 == 0
						PRINTFORMW 「...응?」
						PRINTFORMW 「평소와는 달리 말솜씨가 좋으시네요...」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 이야기는 실로 흥미롭네요」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「...술에 좋고 나쁨도 없어요」
						PRINTFORMW 「있잖아, 사귈 사람은 생각하는 게 더 좋을 거야」
					ELSE
						PRINTFORMW 「도덕으로 사람은 구할 수 없고, 바른 길이 항상 올바른 도리는 아니란다.」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「어머, 어머」
						PRINTFORMW 「더 재미있는 이야기를 하지 않겠어?」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「후훗, 그렇군요」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「아아, 1400년 동안 무엇을 하고 있었냐고요?」
						PRINTFORMW 「여자는 비밀이 많은 편이 좋다는 것이 정해져 있거든요.」
						PRINTFORMW 「궁금해할 필요 없어요 %UNICODE(0x2665) *1%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「여러 가지 재미있는 일들이 일어나고 있군요…」
					ELSE
						PRINTFORMW 「...헤에, 그런 거군요」
						PRINTFORMW 청아는 흥미 없어 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
						PRINTFORMW 「그것보다 %조사처리(CALLNAME:MASTER,"에게")% 관심이 있어요... %UNICODE(0x2665) *1%」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K90_301
CALL M_KOJO_MESSAGE_COM_K90_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		PRINTFORMW 「...꾸윽...」
		PRINTFORMW 「맛없네요... 진흙 쪽이 낫겠어요.」
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「...고마워」
			PRINTFORMW 청아는 조심스럽게 차를 받았다
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응, 다들 잘 지냈어」
			PRINTFORMW 청아는 그렇게 말하며 천천히 마저 마셨다.
			PRINTFORMW 「차 솜씨가 나쁘지 않네요...」
		ELSE
			PRINTFORMW 
			PRINTFORMW 「…이런 것도 나쁘지 않네요」
			PRINTFORMW 청아는 내밀어진 차를 단숨에 마셨다.
			PRINTFORMW 「맛있는 차라는 것도 흔하게 마실 수 있는 물건은 아니죠」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「...응...」
			PRINTFORMW 「꽤 괜찮은 정성으로...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음... 맛있었습니다...」
			PRINTFORMW 청아는 건네진 차를 미소 지으며 다 마셨다.
		ELSE
			PRINTFORMW 「...음... 좋은 차네」
			PRINTFORMW 청아는 기쁜 듯이 차에 손을 댄다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「………」
			PRINTFORMW 「나쁘지 않네.」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...쪽쪽...」
			PRINTFORMW 「별로 제 취향은 아니네요」
		ELSE
			PRINTFORMW 「음, 받겠어요.」
			PRINTFORMW 청아는 차를 다 마시고 나서
			PRINTFORMW 「뭐... 합격점이에요.」
			PRINTFORMW 그렇게 감상을 말했다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「... 감사히 받을게요...」
			PRINTFORMW 청아는 조금 의심스러운 듯 차를 마셔치웠다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 
			PRINTFORMW 「...꽤 괜찮은 점전이었습니다」
			PRINTFORMW 청아는 조금 정중하게 그렇게 대답했다.
		ELSE
			PRINTFORMW 「...어머? 차 자국이 서 있네요」
			PRINTFORMW 청아는 그렇게 말하며 차를 다 마셨다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K90_302
CALL M_KOJO_MESSAGE_COM_K90_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;Custom code, tease event.
	RESULT = 0
	TRYCALL K90_SKINSHIP_TEASE
	SIF RESULT
		RETURN 1
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「...너무 달라붙지 말아 줄 수 있나요?」
			PRINTFORMW 청아는 스킨십에 대해 노려보고 있었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...그만두세요!」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「...변태이시네요...」
			PRINTFORMW 청아는 화난 표정으로 항의해 온다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「등을 쓸어드려 드릴게요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후후, 간지러워? 그럼 약한 부분은 다 보고 있으니까 말이야%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「앞쪽도 다 씻겨 드릴게요, 자 긴장하지 마세요...」 %UNICODE(0x2665) *1%
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「...더... 더 교감해요♪」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 즐기고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아……그런 곳에……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「...후훗, 이런 것도 사랑의 형태일까 %UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「...별로... 이런 일은 익숙하지 않아요...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...누구에게나 이런 걸 하시는 건가요?」
		ELSE
			PRINTFORMW 「더... 만져도 괜찮아요 %UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「...이렇게 하는 게 보통일까」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…이런 건 연인끼리 하는 거…인가 봐?」
		ELSE
			PRINTFORMW 「밖에서 보면 우리가 연인처럼 보이나?」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...이런 건 보통 더 친해지고 나서 하는 거야?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…뭐, 딱히 이런 게 싫지 않지만」
		ELSE
			PRINTFORMW 「너무 야하게 만져주지 않아도 되나요?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
