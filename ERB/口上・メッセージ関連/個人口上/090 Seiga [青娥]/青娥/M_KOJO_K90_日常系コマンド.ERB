;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K90_303
CALL M_KOJO_MESSAGE_COM_K90_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0,1,2
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 청아에게 실례를 사과하자
			PRINTFORMW 「…네, 용서해 드릴게요. 저는 관대하니까」
			PRINTFORMW 청아는 그렇게 미소를 지으며 용서했다.
		CASEELSE
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 청아에게 무례를 사과하자
			PRINTFORMW 「…용서해 주지 않겠어요♪」
			PRINTFORMW 청아는 웃고 있지 않은 눈으로 그렇게 말했다.
	ENDSELECT
ENDIF
RETURN 1
