;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K90_310
CALL M_KOJO_MESSAGE_COM_K90_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K90_5_1
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「그만두십시오!」
		PRINTFORMW 청아는 찰싹 %조사처리(CALLNAME:MASTER,"의")% 뺨에 소리를 지르게 한다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「아앙! %UNICODE(0x2665) *1%」
			PRINTFORMW 「더 주물러 주세요 %UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 주무르는 것을 기뻐하는 듯하다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...응앗... 얼마든지 주물러 주세요...%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 그렇게 말하면서도 전혀 싫지 않은 표정을 짓는다.
		ELSE
			PRINTFORMW 「내 엉덩이, 그렇게 매력적일까?」
			PRINTFORMW 청아는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 손에 엉덩이를 밀어붙인다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「...응 윽%UNICODE(0x2665) *1%이...」
			PRINTFORMW 「스킬 %UNICODE(0x2665) *1%을 %UNICODE(0x2665) *1%하고 %UNICODE(0x2665) *1%한다」
			PRINTFORMW 청아는 엉덩이를 주무르면서도 시큰둥하지 않게 그렇게 중얼거린다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...갑자기 만지지 말아주세요%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 얼굴을 붉히며 엉덩이를 쓰다듬어지고 있다.
		ELSE
			PRINTFORMW 「으아앗%UNICODE(0x2665) *1%치한이에요%UNICODE(0x2665) *1%당하고 말겠어요%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 그렇게 말하면서도 기쁜 듯 엉덩이를 쓰다듬게 하고 있다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「...음...」
			PRINTFORMW 「들키지 않으리라 생각했던 것일까?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「너무 만지지 말아주세요...」
			PRINTFORMW 「허리를 만지는 것도 안 돼요 %UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 살짝 일그러진 얼굴로 손을 뿌리친다.
		ELSE
			PRINTFORMW 「...별로 좋은 취미는 아닌 것 같네요」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리친다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...성욕에 충실한 건 싫지 않지만...」
			PRINTFORMW 청아는 안산형 엉덩이를 주무르는 것을 싫어한다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...음, 어느 쪽이든 제가 엉덩이를 만지는 게 싫은 게 문제일지도 모르겠네요...」
			PRINTFORMW 청아는 별로 웃지 않는 얼굴로 엉덩이에 달라붙는 손을 뿌리친다.
		ELSE
			PRINTFORMW 「그만두세요」
			PRINTFORMW 청아는 자신의 엉덩이를 더듬던 %CALLNAME:MASTER%손을 뿌리쳤다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
