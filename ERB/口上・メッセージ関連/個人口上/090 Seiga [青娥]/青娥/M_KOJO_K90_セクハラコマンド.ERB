;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K90_312
CALL M_KOJO_MESSAGE_COM_K90_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 청아의 입술을 빼앗았다.
		PRINTFORMW 그 입술은 부드럽고 어른스러운 맛이 났다.
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...음...---...스으」
		PRINTFORMW 청아는 키스를 받자 조금 흐릿한 목소리로 누군가의 이름을 불렀다.
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K90_20_1
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응…%UNICODE(0x2665) *1%…읏…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…조금만 더… 이어져 있어 줘…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…응!...!」
			PRINTFORMW 「……강압적이네 %UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 그렇게 말하면서도 %조사처리(CALLNAME:MASTER,"의")% 입술을 되찾았다.
		ELSE
			PRINTFORMW 「...윽... %UNICODE(0x2665) *1%」
			PRINTFORMW 青아는 입맞춤을 당한 채 무방비 상태가 되어 있다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응!?」
			PRINTFORMW 「후우... 정말 갑작스럽네 %UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 키스를 받자 얼굴을 붉히며 고개를 숙이고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응...%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 키스를 당하고 있다.
		ELSE
			PRINTFORMW 「...음응 %UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 키스를 당하면 말없이 입술을 맞댔다.
			PRINTFORMW (…이런 건… 태연하게 하는 걸까…)
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「...응...」
			PRINTFORMW 「...뭐, 뭐... 싫지는 않아요%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 키스를 받으면 마냥 싫어하지 않는 듯 얼굴을 붉히고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「～～～%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 입술을 빼앗긴 채 연약하게 저항하고 있다.
		ELSE
			PRINTFORMW 「음~%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 입맞춤을 당하면서 힘없이 저항하고 있다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...응...%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 입맞춤을 당해 당황하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…！？」
			PRINTFORMW 「그만두세요!」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 행위에 항의하고 있다.
		ELSE
			PRINTFORMW 「…！？」
			PRINTFORMW 「...키스 같은 건... 별로...」
			PRINTFORMW 청아는 입술을 빼앗은 %조사처리(CALLNAME:MASTER,"를")% 힘없이 노려보고 있다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
