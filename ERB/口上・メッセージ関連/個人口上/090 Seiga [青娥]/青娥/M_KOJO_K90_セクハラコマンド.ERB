;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K90_311
CALL M_KOJO_MESSAGE_COM_K90_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 청아의 몸에 안겼다.
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 잠시 청아의 낮은 체온을 느끼고 있었다.
		;	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
		PRINTFORMW 「...스으... 아부...님...」
		PRINTFORMW 청아는 누군가와 착각하며 %조사처리(CALLNAME:MASTER,"의")% 체온을 느끼고 있다.
	ELSEIF CFLAG:うふふ == 2
		PRINTFORMW 「이렇게 하고 있으니 정말 행복하네요%UNICODE(0x2665) *1%」
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「...따뜻하다」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"를")% 껴안았다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...좋아해」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 안기자 작게 그렇게 말했다.
		ELSE
			PRINTFORMW 「…」
			PRINTFORMW 청아는 어쩌나 하며 안아주는 것에 응하면서 얼굴을 붉히고 있다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「...괜찮을까?」
			PRINTFORMW 청아는 조심스럽게 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...숨소리가 거칠어지고 있네요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「...조금 더... 이대로도 괜찮아요」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「...응?」
			PRINTFORMW 「이런 것이 취향이신가요?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「어머? 애교쟁이시네요」
		ELSE
			PRINTFORMW 「...떨어져 주세요... 아, 별로 이렇게... 익숙하지 않아서...」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...벌써!」
			PRINTFORMW 청아는 어느 쪽이든 당황한 듯 안겨 있었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW (...무슨 일인가...?)
			PRINTFORMW 청아는 안겨온 %CALLNAME:MASTER%에 당황하고 있다.
		ELSE
			PRINTFORMW 「뭐, 이런 것도 나쁘지 않네요…」
		ENDIF
	ENDIF
ENDIF
RETURN 1
