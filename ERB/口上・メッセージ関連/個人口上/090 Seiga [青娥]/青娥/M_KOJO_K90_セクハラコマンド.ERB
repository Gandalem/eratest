@M_KOJO_MESSAGE_COM_K90_313_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:うふふ == 2
		CALL M_KOJO_MESSAGE_COM_K90_6_1
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「...공짜로는 용서 못 해요」
		PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 뺨에 손바닥을 가져다 대며 때린다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「아앗%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「그렇게 주무르면 부끄럽사와%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 가슴을 주물림당하는 것을 기뻐하는 듯하다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…응읏%UNICODE(0x2665) *1%…으앗%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 가슴을 주물림당하면서도 싫지는 않은 듯한 표정을 짓고 있다.
		ELSE
			PRINTFORMW 「남자들은 정말로 가슴을 좋아하시는군요%UNICODE(0x2665) *1%」
			PRINTFORMW 「더 마음껏 해주셔도 괜찮아요%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 그렇게 말하며%CALLNAME:MASTER%손에 가슴을 밀착시킨다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「…아앙%UNICODE(0x2665) *1%안 돼요%UNICODE(0x2665) *1%이런 곳에서%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 가슴을 주물림당하면서도 싫지만은 않은 듯 그렇게 말했다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앙읏%UNICODE(0x2665) *1%좀 더 상냥하게 주물러 주시와요%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 얼굴을 붉힌 채 가슴을 주물림당하고 있다.
		ELSE
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%가슴만으로%UNICODE(0x2665) *1%만족하려나%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 그렇게 말하면서 기뻐하며 가슴을 쓰다듬어 주는 대로 두고 있다.
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「...응... %UNICODE(0x2665) *1%」
			PRINTFORMW 「음란한 손길이네요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 것이 유행하고 있는 건가요?」
			PRINTFORMW 「환상향의 풍기는 어떻게 되어 있는 걸까요...」
			PRINTFORMW 청아는 약간 당황한 표정으로 손을 뿌리친다.
		ELSE
			PRINTFORMW 「...그렇게 주무셔도 곤란해요...%UNICODE(0x2665) *1%」
			PRINTFORMW 그렇게 말하며 청아는 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리친다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...조금 더 편안한 사람의 가슴을 주물러야 했네요」
			PRINTFORMW 청아는 가슴을 주무르며 차갑게 말했다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…그런 분들은 별로 믿지 않기로 하고 있어요…」
			PRINTFORMW 청아는 웃고 있지 않은 얼굴로 가슴에 달라붙은 손을 뿌리친다.
		ELSE
			PRINTFORMW 「모두들 내 가슴이 좋으시군요」
			PRINTFORMW 청아는 자신의 가슴을 주무르는 손을 차갑게 바라본다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
