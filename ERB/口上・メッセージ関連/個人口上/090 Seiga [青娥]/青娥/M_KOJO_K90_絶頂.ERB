				PRINTFORMW 「...기분 좋았을까...%UNICODE(0x2665) *1%」
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORMW 「더 더 주세요...%UNICODE(0x2665) *1%」
				RETURN 1
			ELSE
				PRINTFORMW 「야한 거... 더 주세요... %UNICODE(0x2665) *1%」
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
