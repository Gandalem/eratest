	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음... 가슴 페라 기분 좋아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1% 야한 냄새가 가슴에 배어버려요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「앗%UNICODE(0x2665) *1%빨리 진한 정액을 마시게 해주시와요%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「정말……%UNICODE(0x2665) *1%어서 자지즙을 싸 주세요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응츄읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%어서 자지를 삼키게 해주시와요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「앞서 나오는 액체... 골짜기에 고여 있어요%UNICODE(0x2665) *1% 진심의 액체도 주세요%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「음~ 어렵네요...」 %UNICODE(0x2665) *1%
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앙읏%UNICODE(0x2665) *1%말썽꾸러기 자지가 먼저 비벼져서…%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「낼름%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%수컷 냄새가 나서 이상한 맛이에요%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
