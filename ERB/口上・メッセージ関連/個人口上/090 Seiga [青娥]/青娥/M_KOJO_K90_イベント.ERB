@M_KOJO_EVENT_K90_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「저기, 데이트해 줄 수 없을까, %CALLNAME:MASTER%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「저기, %조사처리(CALLNAME:MASTER,"가")% 괜찮으시다면 데이트해 주지 않으실래요」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%, 지금 시간 되신다면…」
					PRINTFORMW 「잠깐 동행해 주셨으면 하는데… 결코 수상한 일을 하려는 건 아니에요」
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 잠깐 같이 있어 주지 않겠어」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「고마워, 자, 가자 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「후훗... 고마워」
				ELSEIF TALENT:思慕
					PRINTFORMW 「그럼 가보죠」
				ELSE
					PRINTFORMW 「감사 표시로 뭘 사 드릴게요」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「유감이야, 또 청할 테니 그때는 부탁할게 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「유감이네요...」
				ELSEIF TALENT:思慕
					PRINTFORMW 「음... 유감이네요.」
				ELSE
					PRINTFORMW 「인색하네요-」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%, 우리 집에 놀러 오지 않을래?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%, 나의 집에 오지 않겠소?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%, 시간 괜찮으면 우리 집에 안 올래?」
				ELSE
					PRINTFORMW 「저기, 혹시 시간 되세요?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「오늘은 하루를 느긋하게 보내도록 하자%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「너무 자꾸 쳐다보지 말아주세요... 이상한 게 있으니까」
				ELSEIF TALENT:思慕
					PRINTFORMW 「...재미있는 것을 볼 수 있으면 좋겠네요 ♪」
				ELSE
					PRINTFORMW 「후후, 후회해도 이미 늦었어요%UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「그럼, 다음에 다시 보자고... 약속이야?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「어머? 아쉽네요... 차도 준비해 두었는데...」
				ELSEIF TALENT:思慕
					PRINTFORMW 「음... 모처럼의 기회라고 생각했는데...」
				ELSE
					PRINTFORMW 「어라? 의외로 몸가짐이 단단하시네요%UNICODE(0x2665) *1%」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
