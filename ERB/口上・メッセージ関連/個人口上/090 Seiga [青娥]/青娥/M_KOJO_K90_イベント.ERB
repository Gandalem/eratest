@M_KOJO_EVENT_K90_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;今日会ってない。
	IF !TCVAR:90:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF !CFLAG:行動 == 5 && !TCVAR:90:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「아라? %CALLNAME:MASTER%, 유감스럽게도 지금 손을 뗄 수가 없어서...」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K90
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「...아아, %CALLNAME:MASTER%씨가 아니신가요」
					PRINTFORMW 「너무 저를 쳐다보지 말아주세요. 기분 나쁘니까。」
				ELSEIF TALENT:恋人
					PRINTFORMW 「어라? %조사처리(CALLNAME:MASTER,"가")% 아니신가요 %UNICODE(0x2665) *1%」
					PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 작게 손을 흔들며 활기차게 인사했다.
					PRINTFORMW 「오늘은 뭘 하고 계실까... %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「어라, %CALLNAME:MASTER%씨?」
					PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 다가왔다.
					PRINTFORMW 「오늘은 무엇을 하고 계신…?」
					PRINTFORMW 숨결이 닿을 듯한 거리에서 %조사처리(CALLNAME:MASTER,"의")% 옆에 팔을 감고 있다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「하이! %CALLNAME:MASTER%씨♪」
					PRINTFORMW 「지금 한가하신가요? 꼭 차라도 한잔…」
					PRINTFORMW 청아는 수상한 미소를 지으며 다가오고 있다.
				ELSE
					PRINTFORMW 「어머, %CALLNAME:MASTER%씨, 건강해 보여서 다행이네요.」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中、今日会ってない。
			IF !CFLAG:行動 == 5 && !TCVAR:90:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「아라? %CALLNAME:MASTER%, 유감스럽게도 지금 손을 뗄 수가 없어서...」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K90
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「...아아, %CALLNAME:MASTER%씨」
					PRINTFORMW 「여전히 불쾌하네요.」
				ELSEIF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%, 이런 곳에 있었네」
					PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 작게 손을 흔들며 인사했다.
					PRINTFORMW 「오늘은 뭘 해줄 수 있을까%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「어머, %CALLNAME:MASTER%씨 아니신가요」
					PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"를")% 알아보고 다가왔다.
					PRINTFORMW 「저기, 지금 뭐 하고 계세요?」
					PRINTFORMW 숨결이 닿을 듯한 거리에서 %CALLNAME:MASTER%옆에 팔을 감고 있다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「야! %CALLNAME:MASTER%씨!」
					PRINTFORMW 「여전히 한가해 보이네요.」
					PRINTFORMW 청아는 수상한 미소를 지으며 인사했다.
				ELSE
					PRINTFORMW 「어라, %CALLNAME:MASTER%씨, 이런 곳에」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF CFLAG:318 == 1
				PRINTFORMW 「...저쪽을 보지 말아 주십시오」
			ELSEIF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%, 목욕하고 있었구나」
				PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 몸을 팔로 가리면서 함께 들어왔다.
				PRINTFORMW 「...등을 ... 받아 드릴게요 %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「어머, %CALLNAME:MASTER%님, 들어오셨군요」
				PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 목욕하러 왔다.
				PRINTFORMW 「...너무 보지 말아 주세요... 흥분해 버릴 거예요...%UNICODE(0x2665) *1%」
				PRINTFORMW 청아는 얼굴을 붉히며 몸을 꿈틀거리고 있다.
			ELSEIF TALENT:思慕
				PRINTFORMW 「%CALLNAME:MASTER%씨, 이런 곳에서 만나다니 의외네요」
				PRINTFORMW 「게다가... 생각보다 크시네요... %UNICODE(0x2665) *1%」
				PRINTFORMW 청아는 얼굴을 붉히며 %조사처리(CALLNAME:MASTER,"의")% 몸을 옆눈으로 바라봤다.
			ELSE
				PRINTFORMW 「어머, 먼저 들어와 계셨나요」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			IF CFLAG:318 == 1
				PRINTFORMW 「……아, 실례.」
			ELSEIF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%, 먼저 안에 계셨군요」
				PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 문을 닫고 나가려고 했다.
				PRINTFORMW 「실례, 편하게 쉬세요 %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%씨, 여기였군요」
				PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 욕조에서 나왔다.
				PRINTFORMW 「별로 시간되는 취미가 없어서요... %UNICODE(0x2665) *1%」
				PRINTFORMW 청아는 얼굴을 붉히며 문을 닫았다.
			ELSEIF TALENT:思慕
				PRINTFORMW 「%CALLNAME:MASTER%씨, 들어오셨군요...」
				PRINTFORMW 「너무 방해하고 싶지 않아서요...%UNICODE(0x2665) *1%」
				PRINTFORMW 청아는 얼굴을 붉히며 목욕탕에서 나왔다.
			ELSE
				PRINTFORMW 「아아, 실례.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			IF CFLAG:318 == 1
				PRINTFORMW 「…죄송하지만, 나가주시지 않겠어요?」
			ELSEIF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%, 죄송해요... 혼자 들어가고 싶은데...」
				PRINTFORMW 청아는 미안한 듯 %조사처리(CALLNAME:MASTER,"를")% 내보냈다.
				PRINTFORMW 「이 보상은 꼭 할게요... 그렇죠, %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%씨, 들어오셨군요」
				PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 %조사처리(CALLNAME:MASTER,"를")% 내보내려 했다.
				PRINTFORMW 「오늘은 혼자 있고 싶은 기분이라고... 응♪」
				PRINTFORMW '그럴 리가'라고 생각하며 %조사처리(CALLNAME:MASTER,"는")% 욕실에서 쫓겨났다.
			ELSEIF TALENT:思慕
				PRINTFORMW 「어머, 선점자가...」
				PRINTFORMW 「가능하다면... 저에게 양보해 주시지 않겠어요?」
				PRINTFORMW 청아는 전라의 %조사처리(CALLNAME:MASTER,"에게")% 몸을 기댄 채 목욕실에서 내쫓았다.
			ELSE
				PRINTFORMW 「저에게 욕조를 양보해 주지 않으시겠어요?」
				PRINTFORMW 청아는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"를")% 내쫓았다.
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			;仕事中、今日会ってない。
			IF !CFLAG:行動 == 5 && !TCVAR:90:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「아라? %CALLNAME:MASTER%, 유감스럽게도 지금 손을 뗄 수가 없어서...」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K90
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「...어머, 우연이네요」
					PRINTFORMW 청아는 이곳을 노려보면서 인사해왔다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%, 건강해 보여서 다행이네」
					PRINTFORMW 청아는 작게 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
					PRINTFORMW 「있잖아, 오늘은... 뭘 하실 거예요 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%님, 잘 지내셨어요?」
					PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 기운차게 인사했다.
					PRINTFORMW 「오늘은 저… 시간이 있어요, 데이트라도 해주실 수 없을까요…」
				ELSEIF TALENT:思慕
					PRINTFORMW 「아아, %CALLNAME:MASTER%씨, 건강해 보여서 다행이에요.」
					PRINTFORMW 「시간 있으시면 같이 안 해주실래요? %조사처리(CALLNAME:MASTER,"랑")% 있으면 지루하지 않으니까요.」
				ELSE
					PRINTFORMW 「이야! 건강해 보이네요」
					PRINTFORMW 청아는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 귀에 숨을 불어넣었다.
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			;仕事中、今日会ってない。
			IF !CFLAG:行動 == 5 && !TCVAR:90:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「아라? %CALLNAME:MASTER%, 유감스럽게도 지금 손을 뗄 수가 없어서...」
			ELSE
				IF CFLAG:318 == 1
					PRINTFORMW 「...흥, 인기 있구나」
					PRINTFORMW 청아는 이쪽을 노려보며 빈말을 했다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%, 바람피는 거야?」
					PRINTFORMW 청아는 슬픈 표정으로 주먹을 쥐고 있다.
					PRINTFORMW 「뭐, 영웅적인 면을 좋아한다고들 하니... 제가 부족하다는 건 슬프네요...」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%... 데이트 중인가요?」
					PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"를")% 알아차리자 살짝 미소를 지으며 웃었다.
					PRINTFORMW 「부럽네요」
				ELSEIF TALENT:思慕
					PRINTFORMW 「아라, 실례네요」
					PRINTFORMW 청아는 그렇게 말하면서도 수상한 미소를 짓고 있다.
				ELSE
					PRINTFORMW 「야호! 뜨겁네요♪」
					PRINTFORMW 청아는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 팔에 매달린다.
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
