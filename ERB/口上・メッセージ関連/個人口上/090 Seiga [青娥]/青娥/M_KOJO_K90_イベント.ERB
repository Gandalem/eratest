@M_KOJO_SPEVENT_K90_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1090)
			PRINTFORMW 돌아가는 길에 청아는 %조사처리(CALLNAME:MASTER,"의")% 소매를 잡아 걸음을 멈추게 했다.
			PRINTFORMW 「있잖아, %CALLNAME:MASTER%,」
			PRINTFORMW 「나 좋아하는 사람이 있어」
			PRINTFORMW 「농담이 아니야, 거짓말도 아냐」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 좋아하게 되어―――」
			PRINTFORMW 「…나 같은 여자가라고 생각될지도 모르겠어」
			PRINTFORMW 「하지만 말이야, 이제 이런 감정은 원하지 않아. 사람을 사랑하는 것 따위는 하고 싶지 않다고 생각해도」
			PRINTFORMW 「%CALLNAME:MASTER%에게만은―――」
			PRINTFORMW 「…제대로 말을 못 해서 미안해」
			PRINTFORMW 「하지만 오늘은 진심을 말할 수 있을 것 같아」
			PRINTFORMW 「나, %조사처리(CALLNAME:MASTER,"를")% 좋아해」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 다른 누구를 좋아해도 상관없어」
			;				PRINTFORMW 「もしかしたら私は%CALLNAME:MASTER%を捨てるかもしれない」
			;				PRINTFORMW 「%CALLNAME:MASTER%を玩具にするかもしれない」
			PRINTFORMW 「하지만...」
			PRINTFORMW 「계속 곁에 있을 거라고」
			PRINTFORMW 「속삭여주지 않겠어, 나, 그것만으로도 괜찮아...」
			PRINTFORMW 「...그것만으로...」
			PRINTFORMW 청아는 소매에서 손을 떼고 가슴을 누르며 그렇게 고백했다.
			;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%、あのね」
			PRINTFORMW 귀로에 도착하자 청아는 조심스럽게 입을 열었다.
			PRINTFORMW 「포기할 때마다 포기할 수 없어서」
			PRINTFORMW 「다시 한번 고백할 거야」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 좋아」
			PRINTFORMW 「나랑 사귀어 주지 않을래...?」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 위해서라면 뭐든지 할게」
			PRINTFORMW 「...부탁이야」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「...나는」
		PRINTFORMW 청아는 그대로%조사처리(CALLNAME:MASTER,"의")% 가슴으로 뛰어들었다.
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")%... 무슨 일이 있어도 사랑합니다...」
		PRINTFORMW 잠시 동안 그대로%조사처리(CALLNAME:MASTER,"의")% 품에 안겨 있었다.
		PRINTFORMW 「설령... 죽어 헤어진다 하더라도...」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 살짝 오한을 느끼면서도 그녀를 끌어안고 있었다.
		PRINTFORMW 「단 한 번이라서―――」
		;PRINTFORMW 「死体になってしまえば、もう死なないもの」
		PRINTFORMW 그녀는 뭔가 말한 것 같지만 %조사처리(CALLNAME:MASTER,"는")% 놓쳐버렸다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「...그렇구나, 알겠어...」
		PRINTFORMW 청아는 눈물을 보이지 않으려고 뒤돌아섰다.
		PRINTFORMW (광대네, 나)
		PRINTFORMW 박수가 없는 별빛 아래 그녀는 한동안 그 자리에 서 있었다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K90_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「…마치 끝이네요」
		ELSEIF TALENT:恋人
			PRINTFORMW 「오늘은 즐거웠어요%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 그렇게 말하며 천진난만하게 미소 지었다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...그럼 이걸로 마무리할게...」
			PRINTFORMW 「또, 이런 거 하자」
		ELSEIF TALENT:思慕
			PRINTFORMW 「오늘은 좋은 날이네」
			PRINTFORMW 「또 데이트하자」
		ELSE
			PRINTFORMW 「후우... 피곤하네.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「다른 일로도 이제 화 안 내고 있어」
			PRINTFORMW 「%CALLNAME:MASTER%에 대해서, 나도 고집을 부렸어…」
			PRINTFORMW 「미안해」
		ELSE
			PRINTFORMW 「이제 화 안 했으니까 신경 쓰지 않아도 돼」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「…」
			PRINTFORMW 「아직 나 화났으니까...」
			PRINTFORMW 청아는 싱글벙글 웃으며 그렇게 말해버렸다.
		ELSE
			PRINTFORMW 「조금만 용서해 주지만, 아직 화가 나 있으니까.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「…그렇게 쉽게 용서할 수는 없지만」
			PRINTFORMW 「아주 조금만 용서해 줄게」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 가슴을 손가락으로 찌르며 그렇게 말했다.
		ELSE
			PRINTFORMW 「...뭐, 봐주지 않을 수도 없잖아」
		ENDIF
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
