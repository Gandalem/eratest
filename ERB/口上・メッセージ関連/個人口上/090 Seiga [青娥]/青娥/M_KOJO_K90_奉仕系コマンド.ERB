		IF RAND:3 == 0
			PRINTFORMW 「츄르릅%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「츄릅%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「으응%UNICODE(0x2665) *1%음음%UNICODE(0x2665) *1%」
