;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K90_80
CALL M_KOJO_MESSAGE_COM_K90_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「네에%UNICODE(0x2665) *1% 자지 꼬옥꼬옥 문질러 드릴 테니까 잔뜩 퓻퓻 해주세요%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「어라? 벌써 나올 것 같네 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후훗%UNICODE(0x2665) *1%쿠퍼액이 흘러넘치고 있네… 참지 않아도 돼%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「정액 잔뜩 싸라%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「빨리 정액을 내라 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「ん읏%UNICODE(0x2665) *1%シコシコされるの好き?」
		ELSE
			PRINTFORMW 「응! %UNICODE(0x2665) *1% 날뛰어서 잡기 힘든 거예요 %UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「미끈미끈한 거%UNICODE(0x2665) *1%잔뜩 내주세요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%남자 냄새가 짙네요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「좆물... 빨리 주세요%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「많이 내주세요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「벌벌 떨고 있네요%UNICODE(0x2665) *1% 빨리 부르부해 주세요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「그럼... 상냥하게 자극해 드리겠습니다%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
