;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K90_81
CALL M_KOJO_MESSAGE_COM_K90_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K90_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음... 지독한 걸 많이 주세요%UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「음~~~%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 사정을 감지하고 혀를 사용해 능숙하게 그것을 부추기고 있다.
			PRINTFORMW 「빨리 진한 걸 주세요%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭈르…%UNICODE(0x2665) *1%…응…%UNICODE(0x2665) *1%…내줘…%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼고 혀를 사용해 능숙하게 그것을 재촉하고 있다.
		ELSE
			PRINTFORMW 「…츄루…%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 %조사처리(CALLNAME:MASTER,"의")% 사정을 느끼자 혀를 사용해 능숙하게 그것을 부추기고 있다.
			PRINTFORMW 「…응…레로…츕…참지 마시고 진한 정액 많이 주세요%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음... %UNICODE(0x2665) *1%... 삼켜줘... %UNICODE(0x2665) *1%」
			PRINTFORMW 「...이거... 정말 맛있다... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읏… 츄웁…%UNICODE(0x2665) *1%…응읏…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…쿠퍼액…%UNICODE(0x2665) *1%…만으로는 부족한 거야…%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「츄릅……%UNICODE(0x2665) *1%……핥아앗……%UNICODE(0x2665) *1%」
			PRINTFORMW 「입 안을 정액으로 가득 채워 주세요……%UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「음... 맛있어%UNICODE(0x2665) *1%」
			PRINTFORMW 청아는 기세 좋게 음경에 달라붙는다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응츄... %UNICODE(0x2665) *1%」
			PRINTFORMW 「레로옷 %UNICODE(0x2665) *1% 사정해 주세요 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「입으로 해도 괜찮아요 %UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「윽... 음... 츄루루...%UNICODE(0x2665) *1%」
			PRINTFORMW 「... 농후한 수컷의 맛이네요 %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...해라...천박한 자지...깨끗하게 해 줄게%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「...음...」
			PRINTFORMW 청아는 어딘가 서툴게 성기를 입에 넣었다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
