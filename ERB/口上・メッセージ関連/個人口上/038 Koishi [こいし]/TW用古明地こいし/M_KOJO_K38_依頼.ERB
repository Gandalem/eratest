;;依頼口上・一般依頼03：いっしょにあそぼ
;;※この依頼は[幼稚]を持っているキャラのみ発生します
;;==================================================
;@M_KOJO_IRAI_3_K38(ROLE, SCENE, CLIENT_ID)
;#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
;#DIMS SCENE    ;セリフの表示されるタイミング
;#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;;--------------------------------------------------
;;RETURN 0 の部分は共通の口上が表示されます
;;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「있잖아, 같이 놀래?」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と遊んだ】
		;【▼そのまま下の口上へ】
		PRINTFORMDL 코이시는 즐거운 듯 신나게 떠들고 있다.
		PRINTW 
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「아하하하, 타노시이~♪」
			CASE 2
				PRINTFORMW 「여보세요~ 지금 당신이랑 즐겁게 놀고 있단 말이야~♪」
			CASE 3
				PRINTFORMW 「꺄아아♪ 나쁜 사람한테 잡혀버렸어~♪」
			CASEELSE
				PRINTFORMW 「자아! 아하하하하, 이상한 표정이야~♪」
		ENDSELECT
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		PRINTFORMW 「후우, 만족만족♪」
		RETURN 1
	CASE "成功報告時"
		;報酬：好感度と信頼度のみ（機嫌が良くなる）
		;【▲上の口上から続き】
		;【◆口上】
		PRINTFORMW 「아~ 즐거웠어♪」
		RETURN 1
		;CASE "失敗報告時"
		;
		;	RETURN 0
		;;CASE "依頼報告不要"
		;;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
