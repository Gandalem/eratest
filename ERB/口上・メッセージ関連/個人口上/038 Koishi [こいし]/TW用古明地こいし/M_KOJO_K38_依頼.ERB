;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_IRAI_12_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:38:恋慕 || TALENT:38:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「우으음, 당해버렸네에……」
				CASE 2
					PRINTFORMW 「부탁하고 싶은 게 있는데, %CALLNAME:MASTER%, 들어줄래?」
				CASE 3
					PRINTFORMW 「저번에 완전히 당해버렸지 뭐야……」
				CASEELSE
					PRINTFORMW 「음~ 좀 거슬리긴 하는데~」
			ENDSELECT
		ELSE
			PRINTFORMW 「있잖아 %CALLNAME:MASTER%, 조금 협력해 주지 않을래?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:38:恋慕 || TALENT:38:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「부탁이야……」
				CASE 2
					PRINTFORMW 「에헤헤, 고마워」
				CASE 3
					PRINTFORMW 「파이팅, 힘내라~♪」
				CASEELSE
					PRINTFORMW 「다 다치지 않게 해줘야 돼~」
			ENDSELECT
		ELSE
			PRINTFORMW 「사랑에 목마른 듯한 음산한 결말을 기다리고 있어~♪」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			IF TALENT:38:恋慕 || TALENT:38:思慕
				PRINTFORML 「에엣!? 왜 왜~!!?」
				PRINTFORMW 「모오!! %CALLNAME:MASTER%바보아~!!」
			ELSE
				PRINTFORML 「아하하하♪ 오케이, 받아줄게♪」
				PRINTFORMW 「너한테 원한은 없지만, 여기서 길거리에 나뒹굴다 죽을 미래를 줄게」
				PRINTFORMW 「괜찮아 괜찮아, 시체는 고양이한테 갖다 주면 돼. 평생 내 집에서 살 수 있을 거야!」
			ENDIF
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORMW 「만약 말이야, 지금 당신의 시체를 넘어 미래로 향하려는 거야♪」
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:38:恋慕 || TALENT:38:思慕
				PRINTFORML 「에엣!? 왜 왜~!!?」
				PRINTFORMW 「모오!! %CALLNAME:MASTER%바보아~!!」
			ELSE
				PRINTFORML 「아하하하♪ 오케이, 받아줄게♪」
				PRINTFORMW 「너한테 원한은 없지만, 여기서 길거리에 나뒹굴다 죽을 미래를 줄게」
				PRINTFORMW 「괜찮아 괜찮아, 시체는 고양이한테 갖다 주면 돼. 평생 내 집에서 살 수 있을 거야!」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		IF TALENT:38:恋慕 || TALENT:38:思慕
			PRINTFORMW 「역시 %CALLNAME:MASTER%♪ 정말 좋아해요%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「오옷! %조사처리(CALLNAME:MASTER,"는")% 꽤 강한 거네~」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
