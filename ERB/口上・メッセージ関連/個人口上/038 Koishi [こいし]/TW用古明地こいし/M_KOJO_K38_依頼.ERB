;依頼口上・一般依頼04：料理上手になりたい
;==================================================

@M_KOJO_IRAI_4_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「다음에 언니한테 요리를 대접하고 싶어서♪」
			CASE 2
				PRINTFORMW 「있잖아 %CALLNAME:MASTER%, 요리 가르쳐 주고 싶어~♪」
			CASEELSE
				PRINTFORMW 「나도 요리 배워볼까 해서」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「에헤헷~♪ 요리♪ 요리~♪ 기대된다~♪」
			CASE 2
				PRINTFORMW 「야호오~♪」
			CASEELSE
				PRINTFORMW 「정말? 헤헤~ 기쁘다아~♪」
		ENDSELECT
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		PRINTFORMW 「자아, 애타게 기다려지는 요리를 만들어 보여줄 테니까!」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「아, 이거 설탕이 아니라 소금이었네」
			CASE 2
				PRINTFORMW 「에헤헤~? 뭔가 넣은 기억도 없는 게 들어있는 것 같은데……」
			CASE 3
				PRINTFORMW 「오옷... 프라이팬이 불타버렸네」
			CASEELSE
				PRINTFORML 「채소 자르는 거, 정원사 망령 같은 느낌으로 해도 괜찮을까?」
				PRINTFORMDW ……보고 있으려니 조마조마해져…….
		ENDSELECT
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		;料理口上のコピペ
		IF ABL:38:料理技能 >= 3
			SELECTCASE RAND:4
				CASE 1
					PRINTFORML 「에헤헤♪ 완성♪」
					PRINTFORML 「응응, 맛있겠다♪」
				CASE 2
					PRINTFORML 「응응, 잘 됐어」
					PRINTFORML 「어때? 맛있어?」
				CASE 3
					PRINTFORML 「에헤헤♪ 나, 열심히 했지?」
					PRINTFORML 「칭찬해줘~♪」
				CASEELSE
					PRINTFORML 「응, 완성이다~♪」
					PRINTFORML 「무의식 중에도 제대로 실력이 늘나 보네~」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORML 「피곤하다…….」
					PRINTFORML 「요리란 이렇게 힘들구나……」
				CASE 2
					PRINTFORML 「음~?」
					PRINTFORML 「왠지… 별로야」
				CASE 3
					PRINTFORML 「응, 해냈어!」
					PRINTFORML 「……왠지 잘 기억이 안 나는데!」
				CASEELSE
					PRINTFORML 「어라? 이걸로 완성이야?」
					PRINTFORML 「좀 더 자극적이고 음산한 양념 같은 거 넣어보는 건 어때?」
			ENDSELECT
		ENDIF
		WAIT
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
