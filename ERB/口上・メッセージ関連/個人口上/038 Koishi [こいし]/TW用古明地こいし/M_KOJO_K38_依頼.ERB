@M_KOJO_IRAI_6_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「있잖아, 물어보고 싶은 게 있는데 말이야~」
			CASE 2
				PRINTFORMW 「잠깐 잊어버렸는데, %조사처리(CALLNAME:MASTER,"는")% 알고 있어?」
			CASEELSE
				PRINTFORMW 「저기 말이야, %조사처리(CALLNAME:MASTER,"에게")% 물어보고 싶은 게 있는데―」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					RETURN 0
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「호오, 그렇구나 그렇구나... 그런 거였구나!」
					CASE 2
						PRINTFORMW 「과연, 완벽하게 이해했어!」
					CASEELSE
						PRINTFORMW 「알았어! 완벽해~♪」
				ENDSELECT
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「헤에……」
						PRINTFORMW 코이시는 전혀 모르겠다는 표정으로 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
					CASE 2
						PRINTFORMW 「……알겠어! ……알겠-, 어?」
					CASEELSE
						PRINTFORMW 「음…… 모르겠어!」
				ENDSELECT
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「고마워! %CALLNAME:MASTER%덕분에 완벽해졌어!」
			CASE 2
				PRINTFORMW 「고마워, %조사처리(CALLNAME:MASTER,"는")% 의외로 박식한 사람이네~♪」
			CASEELSE
				PRINTFORMW 「고마워~ %조사처리(CALLNAME:MASTER,"가")% 가르기 좋아서 도움이 됐어~」
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「음…… 미안, 잘 모르겠어……」
			CASE 2
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 말하는 거 서툴러?」
			CASEELSE
				PRINTFORMW 「있잖아, 혹시 %CALLNAME:MASTER%도 모르는 거 아닐까?」
		ENDSELECT
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
