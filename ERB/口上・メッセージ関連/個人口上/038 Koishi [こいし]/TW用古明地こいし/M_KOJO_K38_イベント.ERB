@M_KOJO_EVENT_K38_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERを押し倒した（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「에헤헤…… 미안해」
				PRINTFORML 「나 더는 참을 수 없어 %CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
			CASE 1
				PRINTFORML 「여보세요~」
				PRINTFORML 「나, 지금부터 %조사처리(CALLNAME:MASTER,"를")% 먹어버릴 거야…… 하고 말이야%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「음후훗, %CALLNAME:MASTER%……」
				PRINTFORML 「정말 기분 좋은 거 해줄게 %UNICODE(0x2665) *1%」
		ENDSELECT
		IF TALENT:38:恋慕
			PRINTFORMW 「있잖아…… %CALLNAME:MASTER%, 나한테 사랑의 감정을 주세요%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「함께, 깊고 깊은 무의식의 심연으로 떨어지자 %UNICODE(0x2665) *1%」
		ENDIF
		;妊娠中
		IF TALENT:38:妊娠 && CFLAG:38:妊娠自覚状態 == 1
			PRINTFORML 
			PRINTFORMW 「임신한 사람한테 제멋대로 당하는 거…… 재미없으려? %UNICODE(0x2665) *1%」
			;危険日
		ELSEIF CFLAG:38:生理周期 == 7 && !TALENT:38:妊娠 && CFLAG:38:生解禁 == 2
			PRINTFORML 
			PRINTFORMW 「오늘은 마음껏 나에게 쏟아줘♪」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 아이를 갖고 싶은 기분이야%UNICODE(0x2665) *1%」
		ENDIF
		TCVAR:38:351 = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
				;抜け出した
				IF TALENT:38:恋慕
					;妊娠中
					IF TALENT:38:妊娠 && CFLAG:38:妊娠自覚状態 == 1
						PRINTFORML 「부우부웅, 안 돼읏……」
						PRINTFORMW 「응…… 그래도 어쩔 수 없나……」
						;我慢しません
						;危険日
					ELSEIF CFLAG:38:生理周期 == 7 && !TALENT:38:妊娠 && CFLAG:38:生解禁 == 2
						PRINTFORML 「이봐…… 도망가서는 안 돼……」
						PRINTFORMW 「음…… 아직 만족하지 못했는데—」
					ELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「엣……, 그럴 리가……」
								PRINTFORMW 「으음, 내 몸에 매력이 없는 걸까아」
							CASE 1
								PRINTFORML 「아앙, 그럴 리가……」
								PRINTFORMW 「더 즐거운 거 하자」
							CASEELSE
								PRINTFORML 「아차……」
								PRINTFORMW 「음, 혹시 별로 기분 좋지 않았어?」
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「음음…… 도망쳐 버렸네……」
					PRINTFORMW 「혹시나~ 내 몸으로는 만족 못 해?」
				ENDIF
			CASE 1
				;抱き着きモード満足終了
				RETURN 1
			CASE 2
				;抱き着きモード強制終了
				RETURN 1
		ENDSELECT
		TCVAR:38:351 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
				;好きにして状態から抜け出せなかった
				PRINTFORML 「안 돼, 놓아주지 않을 거야~」
				PRINTFORMW 「이렇게 나를 흥분시킨 책임, 받아내게 해줄 테니까♪」
				RETURN 1
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「안돼, 더 나를 기분 좋게 해줘…… 응?」
					CASE 1
						PRINTFORML 「이제, 날뛰고 있잖아, 귀엽단 말이야♪」
						PRINTFORMW 「괜찮아…… 같이 기분 좋아지자♪ 응 %UNICODE(0x2665) *1%」
					CASEELSE
						PRINTFORMW 「자아 잡았다! 도망치려고 해도 그럴 수 없다고♪」
				ENDSELECT
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;浴場で遭遇
;==================================================

