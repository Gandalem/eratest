@M_KOJO_EVENT_K38_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SIF FLAG:時間停止 ;fix
			RETURN 0
		LOCALS:0 = 
		IF TALENT:恋人
			LOCALS:0 '= @"뺨을 주홍빛으로 물들이며"
		ELSEIF TALENT:恋慕
			LOCALS:0 '= @"부끄러워하는 듯이"
		ELSEIF GETBIT(CFLAG:1,0)
			LOCALS:0 '= @"손을 휘저으면서"
		ENDIF
		PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"를")% 발견하자 %LOCALS:0% 쪽으로 걸어왔다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「아, %조사처리(CALLNAME:MASTER,"를")%……」
			PRINTFORMW 코이시는 아쉬운 듯 %조사처리(CALLNAME:MASTER,"를")% 바라보며 배웅했다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「아, %조사처리(CALLNAME:MASTER,"를")%」
			PRINTFORMW 코이시는 조금 아쉬운 듯 %조사처리(CALLNAME:MASTER,"를")% 배웅했다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「안녕, %CALLNAME:MASTER%!」
			PRINTFORMW 코이시는 반짝반짝 손을 흔들며 자신을 배웅했다.
		ELSE
			PRINTFORMW 「혹시~ 지금 당신이랑 스쳐 지나갔어요~♪」
			PRINTFORMW 코이시는 깔깔 웃으며 손을 흔들었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SIF FLAG:時間停止 ;fix
			RETURN 0
		LOCALS:1 = 
		IF TALENT:恋人
			LOCALS:1 = 「혹시~ 저기... 혹시 바빠? ...아쉽다」
		ELSEIF TALENT:恋慕
			LOCALS:1 = 「여보세요…… 어라아…… 혹시 안 보여?」
		ELSEIF GETBIT(CFLAG:1,0)
			LOCALS:1 = 「여보세요~ 지금 당신이 나 무시했어~♪」
		ENDIF
		PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"를")% 발견하자 %LOCALS:1%와 말을 이어나갔다.
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
