@M_KOJO_EVENT_K38_15(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;未実装（押し倒しコマンドに統合？
	;MASTERが押し倒した（ウフフ開始時）
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 1
	;PRINTFORML
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;逢瀬終了（ウフフ終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SIF CFLAG:睡眠 ;fix
			RETURN 0
		IF FLAG:時間停止
			PRINTFORMW 머무는 동안, 아직 어린 기운이 남아있는 소녀의 몸을 만끽했다.
			PRINTFORMW 아직 미성숙한 소녀를 범하는 죄책감과 그 싱그러운 감촉에 아쉬움을 느끼면서도
			PRINTFORMW 다음에도 마음껏 맛보면 된다고 그 자리를 떠났다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「…츄%UNICODE(0x2764)%」
			PRINTFORMW 「에헤헤, 많이 사랑받았네%UNICODE(0x2764)%」
			PRINTFORMW 코이시는 키스를 하면서 유메미처럼 중얼거리고 있었다
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……에헤헤, 굉장했어……%UNICODE(0x2764)%」
			PRINTFORMW 코이시는 몸에 남은 열을 음미하듯 중얼거린 후, 조용히 %조사처리(CALLNAME:MASTER,"에게")% 입술을 포갰다.
			PRINTFORMW 「응……쪽%UNICODE(0x2764)%」
		ELSEIF TALENT:思慕
			PRINTFORMW 「……에헤헤, 잔뜩 해버렸네%UNICODE(0x2764)%」
			PRINTFORMW 코이시는 행위가 끝나자 체온을 확인하듯 %조사처리(CALLNAME:MASTER,"에게")% 기대었다
		ELSE
			PRINTFORMW 「……에헤헤, 조금 부끄러울지도 몰라%UNICODE(0x2764)%」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
	;-------------------------------------------------
	;事後描写
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;精液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			SELECTCASE RAND:5
				CASE 1
					PRINTFORML 「응읏%UNICODE(0x2764)% …%조사처리(CALLNAME:MASTER,"의")% 정액이 흘러버렸네%UNICODE(0x2764)%」
					SELECTCASE RAND:3
						CASE 1
							PRINTFORML 「이렇게 깊숙이 안에 싸서, 그렇게 내 몸이 좋았어? %UNICODE(0x2764)%」
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 야수%UNICODE(0x2764)%」
						CASE 2
							PRINTFORML 「이렇게 깊숙이 안에 사정해줘서, 그렇게 내 몸이 기분 좋았어? %UNICODE(0x2764)%」
							PRINTFORMW 「에헤헤... 잘 먹었어%UNICODE(0x2764)%」
						CASEELSE
							PRINTFORML 「이렇게 많이 안에 싸주니까, 그렇게 내 몸이 기분이 좋았어? %UNICODE(0x2764)%」
							PRINTFORMW 「그렇다면 기쁠 거야 %UNICODE(0x2764)%」
					ENDSELECT
				CASE 2
					PRINTFORML 「응... %UNICODE(0x2764)% 세액, 흘러버렸네...♪」
					PRINTFORML 「벌써... 너무 많이 내줬어%UNICODE(0x2764)%」
				CASE 3
					PRINTFORML 「에헤헤%UNICODE(0x2764)% 잔뜩 사랑받아서, %조사처리(CALLNAME:MASTER,"가")% 흘러버렸어%UNICODE(0x2764)%」
					PRINTFORMW 「…다시 한번, 나에게 속까지 받아줘%UNICODE(0x2764)%」
				CASE 4
					PRINTFORML 「하아... %UNICODE(0x2764)% 배, 가득 차버렸다%UNICODE(0x2764)%」
					PRINTFORMW 「아하하... 흘러넘쳐서 와버렸다%UNICODE(0x2764)%」
				CASEELSE
					PRINTFORML 「아하♪ 잔뜩 받아버렸네%UNICODE(0x2764)%」
					PRINTFORMW 「흘러내 버리는 건 좀 아깝구나…」
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;愛液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML 「봐줘 %UNICODE(0x2764)% 나, 이렇게 기분 좋아져버렸어 %UNICODE(0x2764)%」
			PRINTFORMW 「몇 번이나 사정당해서, 야한 즙이 멈추지 않아버렸어 %UNICODE(0x2764)%」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;事後のムード
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			IF TALENT:恋人
				PRINTFORML 「있잖아, 조금만 더……네%UNICODE(0x2764)%」
				PRINTFORMW 「조금만, 이대로 있고 싶어……」
				PRINTFORMW 「좋아해, %CALLNAME:MASTER%……사랑해」
			ELSE
				PRINTFORML 「있잖아, 조금만 더... 응?%UNICODE(0x2764)%」
				PRINTFORMW 「조금 더 이대로 있고 싶다…」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;服を着る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 4
			PRINTFORML 「응... 땀 흘렸네 %UNICODE(0x2764)%」
			PRINTFORML 「뭐 했는지, 냄새로 들켜버릴지도 몰라」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
