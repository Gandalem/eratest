@M_KOJO_MESSAGE_SCOM_K38_2
CALL M_KOJO_MESSAGE_SCOM_K38_2_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K38_2_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORMW
		ELSEIF TALENT:恋慕
			PRINTFORML 「에헤헤~♪ 이렇게 하면 도망칠 수 없겠지?」
			PRINTFORML 「코이시의 오만코, 핥짝핥짝 해줘서 기분 좋게 해줬으면 좋겠어~%UNICODE(0x2764)%」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 얼굴 위로 올라타자, 코이시는 굳게 닫힌 은밀한 곳을 핥듯이 간청했다
		ELSE
			PRINTFORML 「응…… 이거, 이상한 기분이야…… 힉!!? %UNICODE(0x2764)%」
			PRINTFORMW  등을 대고 누운 %조사처리(CALLNAME:MASTER,"는")% 자신의 얼굴에 코이시를 앉히고, 올라온 소녀의 비밀을 혀로 맛보듯 핥기 시작했다.
		ENDIF
		RETURN 1
	ENDIF
	;膣内射精直後
	IF TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORML 「응, 하, 아앗……%UNICODE(0x2764)% 후후, ……맛있나요 %CALLNAME:MASTER%?%UNICODE(0x2764)%」
			PRINTFORML 코이시는 %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에 올라타, 방금 질 내에 쏟아낸 정액이 질구에서 애액과 뒤섞여 흘러넘치는 은밀한 곳을 짓눌렀다.
			PRINTFORMW 은밀한 곳에서 넘쳐흐르는 두 사람의 체액을 맛보려는 듯 빨아들이는 %조사처리(CALLNAME:MASTER,"의")% 모습에, 소녀는 가학적인 미소를 지으며 놓치지 않도록 머리를 붙잡았다.
			PRINTFORML 「앗, 아앗, 굉장해앳%UNICODE(0x2764)% 뭔가, 평소보다……읏%UNICODE(0x2764)% 하아아아아아앗%UNICODE(0x2764)%」
			PRINTFORMW 정액과 애액이 뒤섞인 음란한 향기에 두 사람은 도착적인 감정에 지배되어, 정신없이 그 행위에 빠져들었다.
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		RETURN 1
	ELSEIF TALENT:恋慕
		IF ABL:Ｃ感覚 > 9
			PRINTFORML 「후후후~ %UNICODE(0x2764)% 코이시의 야하고 녹아내리는 오만코…… 잔뜩 맛봐줘? %UNICODE(0x2764)%」
			PRINTFORMW 코이시는 부끄러워할 생각도 없이 누워있는 %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에 올라타, 침처럼 애액을 흘리는 와레메를 눌렀다.
			PRINTFORML 「후아아~ %UNICODE(0x2764)% 응응%UNICODE(0x2764)% 는…… 하앗…… 맛있어? %UNICODE(0x2764)%」
			PRINTFORMW 음순에서 떨어지는 달콤한 액을 탐하는 %조사처리(CALLNAME:MASTER,"의")% 모습을 시야에 담은 채, 코이시는 쾌감에 몸을 떨며 황홀하게 미소 지었다.
		ELSEIF ABL:Ｃ感覚 > 4
			PRINTFORML 「후후후, 이렇게…… %조사처리(CALLNAME:MASTER,"가")% 핥아주는 것도 익숙해져 버렸네……%UNICODE(0x2764)%」
			PRINTFORMW 아름다운 분홍색 단지(蜜壺)를 보여주듯 손가락으로 벌리고 천천히 %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에 올라탄 코이시는 황홀한 듯 중얼거렸다.
			PRINTFORML 「하아앗%UNICODE(0x2764)% 아앗%UNICODE(0x2764)% 좋아어...! %UNICODE(0x2764)% 햐우옷%UNICODE(0x2764)% 더, 핥아줘ッ%UNICODE(0x2764)% 읏~~%UNICODE(0x2764)%」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 비밀스러운 곳에 혀를 가져가 단지를 음미하자, 코이시는 매혹적인 몸짓으로 허리를 흔들며 음란하게 신음했다.
		ELSEIF ABL:Ｃ感覚 > 2
			PRINTFORML 「앗…… 응읏, 짜릿해…… 응%UNICODE(0x2764)%」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 혀로 은밀한 살결의 주름을 부드럽게 핥아 올리자, 코이시는 %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에서 벌벌 떨며 몸을 떨었다
		ELSE
			PRINTFORML 「응…… 하, 아…… %UNICODE(0x2764)%」
			PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에 걸터앉아, 은밀한 곳을 핥는 감각에 몸을 맡기고 있다
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「햐앗%UNICODE(0x2764)% 응읏%UNICODE(0x2764)% 더, 핥아줘%UNICODE(0x2764)% 기분, 좋아아%UNICODE(0x2764)%」
		PRINTFORMW 코이시는 정욕에 몸을 맡긴 채, %조사처리(CALLNAME:MASTER,"가")% 주는 쾌감에 휘둘리고 있다.
		PRINTFORML 「응햐!? %UNICODE(0x2764)% 응읏%UNICODE(0x2764)% 물, 멈추면 안 돼애%UNICODE(0x2764)%%UNICODE(0x2764)%」
		PRINTFORMW 코이시의 은밀한 곳은 %조사처리(CALLNAME:MASTER,"가")% 핥을 때마다 걸쭉한 애액을 흘리며, 아래에 있는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 적신다.
		;それ以外
	ELSE
		PRINTFORML 「응윽…… 응윽, 읏…… 이상한, 느낌」
		PRINTFORMW 비밀스러운 입술을 혀가 더듬으며 감도는 불쾌감에, 코이시는 복잡한 표정으로 %조사처리(CALLNAME:MASTER,"의")% 얼굴 위에 올라타 있다.
		PRINTFORML 「아아…… 안 돼읏…… 그렇게, 핥지 마…… 하아」
		PRINTFORMW 혀를 비밀스러운 입안으로 가져갈 때마다, 소녀의 입에서도 답답한 소리가 새어 나오고 있다.
	ENDIF
ENDIF
RETURN 1
