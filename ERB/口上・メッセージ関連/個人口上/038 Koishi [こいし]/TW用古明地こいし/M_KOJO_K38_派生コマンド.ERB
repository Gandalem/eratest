@M_KOJO_MESSAGE_SCOM_K38_1
CALL M_KOJO_MESSAGE_SCOM_K38_1_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K38_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF ABL:舌 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「응…… 같이, 기분 좋아지자 %CALLNAME:MASTER%%UNICODE(0x2764)% 츄릅%UNICODE(0x2764)%%UNICODE(0x2764)% 음응!? %UNICODE(0x2764)% 주르륵……%UNICODE(0x2764)%」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 구강성교를 받으며, 코이시는 기쁜 듯 성기를 혀로 애무하며 목구멍 깊숙한 곳까지 받아들였다……
					PRINTFORML 「푸하앗……%UNICODE(0x2764)% 얘야, 기분 좋아%UNICODE(0x2764)% 음츄%UNICODE(0x2764)%」
					PRINTFORMW 서로의 성기를 맛보는 것에 몰두하며, 몸을 관통하는 쾌감과 정욕에 몸을 맡겼다.
				CASE 1
					PRINTFORML 「꺄!? ……이제, 지지 않을 거니까 %UNICODE(0x2764)% 응츳, 쪽……질척%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 음란함의 되갚음이라도 하듯, %조사처리(CALLNAME:MASTER,"의")% 남근을 입에 물고 구강으로 그 성기를 애지작하기 시작했다.
					PRINTFORML 「응그%UNICODE(0x2764)% 츄릅%UNICODE(0x2764)% 쪽……!%UNICODE(0x2764)% 후후, 나도 놀아줄 테니까 %UNICODE(0x2764)% 응츳%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 손으로 자위하면서 성기를 혀로 애무하고, 비어있는 손으로 고환을 주무르며 %조사처리(CALLNAME:MASTER,"를")% 몰아붙였다.
				CASE 2
					PRINTFORML 「츄릅%UNICODE(0x2764)% 츄푸%UNICODE(0x2764)% 응%UNICODE(0x2764)% 응응!!?%UNICODE(0x2764)%」
					PRINTFORML 페라치오에 몰두하고 있던 코이시는 갑자기 클리토리스를 맛보듯 핥아지자, 쾌감에 몸을 움찔하며 떨었다.
					PRINTFORMW 그것을 기회로 삼은 %조사처리(CALLNAME:MASTER,"는")% 꿀이 흐르는 음순을 손가락으로 쓸어내리며, 귀여운 클리토리스를 혀로 맛보고 있다.
					PRINTFORML 「응%UNICODE(0x2764)% 응츄루……%UNICODE(0x2764)% 아, 안돼……%UNICODE(0x2764)% 내가, %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해줄 거야%UNICODE(0x2764)% 햐아아!?%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 주어지는 쾌감에 몸을 떨며 어떻게든 봉사하려 하지만, %조사처리(CALLNAME:MASTER,"의")% 혀놀림에 휘둘리고 있다.
				CASE 3
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 거시기, 맛있어%UNICODE(0x2764)% 응츄%UNICODE(0x2764)% 츄르륵%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"의")% 쿠니를 받으면서, 귀밑이나 자지의 뒷부분 등 정성껏 페니스를 혀끝으로 핥아 나간다.
					PRINTFORML 「응츄읏%UNICODE(0x2764)% 하후, 음무……%UNICODE(0x2764)% %CALLNAME:MASTER%도, 나의 오만코 맛있어?%UNICODE(0x2764)% 히야아아아아아아%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 정욕에 녹아버린 듯한 모습으로 묻는 코이시에게 화답하듯, %조사처리(CALLNAME:MASTER,"는")% 꿀을 다 마셔버릴 기세로 음순을 빨아들였고 소녀는 참지 못하고 커다란 교성(嬌聲)을 질렀다.
				CASE 4
					PRINTFORML 「아무……%UNICODE(0x2764)% 음음, 쪽, 츄읍...!! 주벅, 주푸푸, 츄읍%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"의")% 쿠니를 받으면서 눈에 하트를 띄운 채 강직을 물고, 음란한 소리를 내며 정신없이 페라를 계속하고 있다.
					PRINTFORML 「음츄%UNICODE(0x2764)% 응쥬, 주루륵!%UNICODE(0x2764)% 파%UNICODE(0x2764)% 원하는 거%UNICODE(0x2764)% %조사처리(CALLNAME:MASTER,"의")% 자멘 밀크, 코이시에게 줘?%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 정욕에 몸을 맡기며, 녹아내린 듯한 모습으로 %조사처리(CALLNAME:MASTER,"의")% 정액을 애원하고 있다.
			ENDSELECT
		ELSEIF ABL:舌 >= 2
			PRINTFORML 「아후! %UNICODE(0x2764)% 거시기%UNICODE(0x2764)% 츄릅%UNICODE(0x2764)%」
			PRINTFORMW 내밀어진 남근을 보고 코이시는 실실 웃으며, 요염한 표정으로 당황하지 않고 입에 물었다.
			PRINTFORML 「츄르, 음츄…… 아무, 주루루…… 후후, 맛있다%UNICODE(0x2764)% 있잖아, 내 것도…… 응? %UNICODE(0x2764)%」
			PRINTFORMW 코이시는 황홀한 모습으로 허리를 흔들며 %조사처리(CALLNAME:MASTER,"의")% 구강성교를 애원하고 있다.
		ELSE
			PRINTFORML 「으읍……음, 음츄……아후%UNICODE(0x2764)% 기분, 좋아%UNICODE(0x2764)%」
			PRINTFORMW 코이시는 군니를 받으며, 정성스럽게 혀를 움직이며 페니스에게 봉사하고 있다.
			PRINTFORML 「아, 야아%UNICODE(0x2764)% 응, 추츄%UNICODE(0x2764)% 츄릅%UNICODE(0x2764)%」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 군니에 몰리는 쾌감에 휘둘리면서도, 코이시는 지지 않고 페라를 재개했다.
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「아하, 굉장한 냄새%UNICODE(0x2764)% ……음치ゅ, 츄루%UNICODE(0x2764)% 오만코도 기분 좋다%UNICODE(0x2764)%」
		PRINTFORMW 남근의 냄새에 황홀해하며 페라를 하고, 코이시는 쿠니의 쾌감에 몸을 떨었다.
		PRINTFORML 「츄루……아후%UNICODE(0x2764)% 주루%UNICODE(0x2764)% 주루루루%UNICODE(0x2764)%」
		PRINTFORMW 서로 정욕에 이끌리며, 탐닉하듯 성기를 핥고 있었다.
		;それ以外
	ELSE
		PRINTFORML 「흐윽……응, 햣%UNICODE(0x2764)% 그,렇게…… 핥는 건 안 돼읏%UNICODE(0x2764)%」
		PRINTFORMW 페라치에 애원하지만 코이시는 %조사처리(CALLNAME:MASTER,"의")% 구니에게 휘둘리며 제대로 봉사하지 못하고 있다.
		PRINTFORML 「……흐윽 %조사처리(CALLNAME:MASTER,"는")% 헉!? %UNICODE(0x2764)% 응, 흐으…… 하아!? %UNICODE(0x2764)%」
		PRINTFORMW 그럼에도 필사적으로 봉사하려는 코이시를 비웃듯이, %조사처리(CALLNAME:MASTER,"는")% 클리토리스에 달라붙어 소녀를 농락하고 있다.
	ENDIF
ENDIF
RETURN 1
