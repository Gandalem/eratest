@M_KOJO_MESSAGE_SCOM_K38_12
CALL M_KOJO_MESSAGE_SCOM_K38_12_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K38_12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「가슴으로 하면서 핥으면 되는 거야? 응, 해 볼게」
			PRINTFORMW 코이시는 가슴으로 남근을 자극하며 귀두에 혀를 갖다 댔다.
		ELSE
			PRINTFORML 「에? 가슴으로 하면서 핥는 거야? 으윽…… 할 수 있을까아」
			PRINTFORMW 코이시는 가슴으로 페니스를 자극하면서, 조심스러운 듯 귀두에 혀를 가져갔다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
		;ひんにゅー
	ELSEIF TALENT:バストサイズ < 0
		IF ABL:胸 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「응읏…… 응읏…… 혀로, 응%UNICODE(0x2764)%」
					PRINTFORMW  코이시는 작은 가슴에도 젖꼭지로 남성의 몸을 쓸어내리듯 문지르며 소변길을 자극하듯 혀를 움직인다.
					PRINTFORML 「후후%UNICODE(0x2764)% 여기가 약한 거 알고 있잖아%UNICODE(0x2764)%」
					PRINTFORML 「사고 싶어지면, 언제든지 코이시 얼굴에 핥아줘%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 도발적인 미소를 지으며 다시 혀를 내밀어 귀두를 괴롭혔다.
				CASE 1
					PRINTFORML 「응…… 냐, 응…… 츄…%UNICODE(0x2764)%」
					PRINTFORMW 코이시가 가녀린 가슴을 밀착시키며 단단함을 자극하고, 필사적으로 혀를 놀려 움찔거리는 남성 성기를 핥고 있다.
					PRINTFORML 「하아…… 조금 더, 가슴이 컸다면, 더 기분 좋게 해줄 수 있었을까……」
					PRINTFORMW 소녀의 중얼거림에 쓴웃음을 지으며, %조사처리(CALLNAME:MASTER,"는")% 상냥하게 코이시의 머리를 쓰다듬어 주었다.
				CASE 2
					PRINTFORML 「음, 음……이렇게 하면, 요령만 터뜨릴 수 있다면……츄, 레로%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 얇은 가슴으로 능숙하게 페니스를 자극하며 끝을 입맞춤하듯 혀를 움직였다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 기분 좋음에 허리를 들자, 소녀는 만족스러운 듯 미소 지으며 봉사를 계속했다.
				CASE 3
					PRINTFORML 「응ー, 츄릅……츄……음후, 하후%UNICODE(0x2764)%」
					PRINTFORML 「……맛있어%UNICODE(0x2764)% 함, 츄릅……렐로%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 가녀린 가슴으로 봉사하며, 정신없이 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥고 있다.
				CASE 4
					PRINTFORML 「자, 힘내봐 힘내~%UNICODE(0x2764)% 먹어, 쮸%UNICODE(0x2764)% 츄루……%UNICODE(0x2764)%」
					PRINTFORMW 소녀는 놀리듯 말을 하면서 능숙하게 가슴을 밀착시켜 남근을 감싸고 부드럽게 자극하며 끝에 혀를 갖다 댄다. 
					PRINTFORML 「츄루…… 쮸, 먹어%UNICODE(0x2764)% 후후, 움찔움찔 거리는 거야…… 귀여워%UNICODE(0x2764)%」
					PRINTFORMW 쾌락에 페니스가 파르르 떨리는 모습을 시야에 담고, 코이시는 크크 웃으며 봉사를 재개했다.
			ENDSELECT
		ELSEIF ABL:胸 >= 2
			PRINTFORML 「흡…… 핥아봐…… 드디어 익숙해져 온지도」
			PRINTFORMW 코이시는 가녀린 가슴으로 어떻게든 남근을 자극하면서, 애쓰며 귀두에 혀를 가져가고 있다.
		ELSE
			PRINTFORML 「음, 음음…… 이거, 더 가슴 큰 사람 아니면 어렵지 않아?」
			PRINTFORMW 코이시는 고군분투하며 어떻게 하면 가슴을 이용해 페라를 해야 할지 고개를 갸웃거리고 있다.
		ENDIF
		;きょにゅー
	ELSEIF TALENT:バストサイズ > 0
		IF ABL:胸 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「음쇼트……아하하! 끝부분만 얼굴 내밀고, 귀여운%UNICODE(0x2764)% 게. 게다가 %조사처리(CALLNAME:MASTER,"는")% 기분 좋아 보여%UNICODE(0x2764)%」
					PRINTFORMW  쿠쿠스 웃으며 놀리는 코이시의 말대로 풍만한 가슴에 감싸져 남근을 문지는 쾌감은 형언할 수 없다.
					PRINTFORML 「그럼, 더 기분 좋게 해 줄게%UNICODE(0x2764)%」
					PRINTFORML 「츄…… 핥아봐…… 츄릅%UNICODE(0x2764)% 쭉, 츄…… 핥아봐%UNICODE(0x2764)% 흘러넘쳐%UNICODE(0x2764)% 자, 축축해서 기분 좋지?%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 침을 바르듯 귀두에 혀를 갖다 대고, 이윽고 미끌미끌해진 성기 전체를 압박하듯이 가슴으로 문질러 올렸다.
				CASE 1
					PRINTFORML 「음……레로, 음……츄……%UNICODE(0x2764)%」
					PRINTFORMW 코이시가 메론 같은 가슴을 밀착시키며 강직함을 자극하고, 필사적으로 혀를 날려 파르르 떨리는 남근을 핥고 있다.
					PRINTFORML 「음, 레로……아무, 츄루%UNICODE(0x2764)% %CALLNAME:MASTER%, 기분 좋아?」
					PRINTFORML 소녀의 불안한 중얼거림에 쓴웃음을 지으며, %조사처리(CALLNAME:MASTER,"는")% 부드럽게 코이시의 머리를 쓰다듬어 주었다.
					PRINTFORMW 그것이 기분 좋았는지 코이시는 눈을 가늘게 뜨며 받아들이면서, 그 거유와 능숙한 혀놀림으로 봉사를 계속하고 있다.
				CASE 2
					PRINTFORML 「츄…… 르릉%UNICODE(0x2764)% 츄프……츄…… 르릉%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 풍만한 가슴으로 페니스를 압박하듯 감싸 안은 채, 가슴골 사이로 얼굴만 내민 귀두에 혀를 갖다 대며 은구멍을 자극하고 있다.
					PRINTFORML 「여기, 기분 좋지?%UNICODE(0x2764)% 코이시의 가슴 속에서, 파르르 떨고 있는 거%UNICODE(0x2764)%」
					PRINTFORMW 어딘가 기쁜 듯 입에 담으며 소녀는 귀두에 키스를 하고 다시 봉사를 재개했다.
				CASE 3
					PRINTFORML 「음~, 츄릅……츄…… 흠후, 하후%UNICODE(0x2764)%」
					PRINTFORML 「……맛있%UNICODE(0x2764)% 해먹어, 츄릅…… 낼름%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 손에 모자랄 정도의 거유로 단단하게 감싸 안으며, 정신없이 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥고 있다.
				CASE 4
					PRINTFORML 「자, 힘내봐 힘내~%UNICODE(0x2764)% 먹어라, 츄%UNICODE(0x2764)% 츄르……%UNICODE(0x2764)%」
					PRINTFORMW 소녀는 놀리듯 말을 하면서 풍만한 가슴으로 남근을 감싸고, 부드럽게 자극하면서 골짜기에서 얼굴을 내민 귀두에 혀를 가져갔다. 
					PRINTFORML 「츄르…… 츄, 먹어라%UNICODE(0x2764)% 후후, 파르르 떨리고 있어…… 귀여워%UNICODE(0x2764)%」
					PRINTFORMW 쾌락에 페니스가 움찔거리는 것을 가슴으로 느끼면서, 코이시는 쿠스쿠스 웃으며 봉사를 재개했다.
			ENDSELECT
		ELSEIF ABL:胸 >= 2
			PRINTFORML 「이렇게, 감싸 안으면…… 으응%UNICODE(0x2764)%」
			PRINTFORMW 코이시는 풍만한 가슴으로 페니스를 감싼 뒤, 얼굴을 내민 귀두에 혀를 가져갔다
		ELSE
			PRINTFORML 「가슴을 끼고 있으니까…… 음무, 너무 깊이 넣으면 가슴 속에 숨어버릴 거야」 
			PRINTFORML 「음~ 이렇게…… 렴... 츄」
			PRINTFORMW 코이시는 익숙하지 않은 행위에 고전하면서, 가슴 사이에 성기를 끼우고 귀두에 혀를 갖다 댔다
		ENDIF
	ELSE
		;ふにゅー
		IF ABL:胸 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「음쇼…… 이렇게, 가슴으로 감싸서 움직여 봐…… 읏%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 유방으로 페니스를 감싼 뒤, 천천히 상하로 움직이기 시작했다.
					PRINTFORML 「그럼, 받아볼게♪ 함무…… 츄%UNICODE(0x2764)% 웩%UNICODE(0x2764)%」
					PRINTFORMW 소녀는 가슴으로 자지를 다루면서, 움찔거리는 귀두에 엿을 핥듯이 혀를 가져갔다.
				CASE 1
					PRINTFORML 「이렇게, 꽉 조여줘…… 으응…… 쪽%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 아름다운 가슴을 모아 남근을 감싼 뒤, 그대로 가슴을 위아래로 움직이며 귀두에 혀를 핥았다.
					PRINTFORML 「응, 응…… 쪽%UNICODE(0x2764)% 이거, 나도 기분 좋아지려나 모르겠어%UNICODE(0x2764)%」
					PRINTFORMW 상기된 듯한 모습으로 코이시는 중얼거리며, 때때로 유두로 성기의 밑부분을 자극했다.
				CASE 2
					PRINTFORML 「흐으, 쪽…… 응, 쪽…… %UNICODE(0x2764)% 아후%UNICODE(0x2764)%」
					PRINTFORML 코이시는 적당한 크기의 가슴으로 페니스를 감싼 뒤, 위아래로 움직이며 귀두를 핥는다.
					PRINTFORMW 필사적으로 봉사하는 그 모습에 %조사처리(CALLNAME:MASTER,"는")% 일그러진 정복감을 느끼며 봉사를 통한 쾌락을 만끽했다.
				CASE 3
					PRINTFORML 「응~, 츄릅…… 츄…… 음후, 하후%UNICODE(0x2764)%」
					PRINTFORML 「……맛있어%UNICODE(0x2764)% 응, 츄릅…… 혀로%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 가슴으로 봉사하며, 정신없이 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥고 있다.
				CASE 4
					PRINTFORML 「자, 힘내 힘내~ %UNICODE(0x2764)% 받아라, 쪽%UNICODE(0x2764)% 쪽쪽……%UNICODE(0x2764)%」
					PRINTFORMW 소녀는 놀리듯 말을 하면서, 아름다운 가슴을 모아 남근을 감싸고 느긋하게 자극하며 끝에 혀를 갖다 댄다. 
					PRINTFORML 「쪽…… 쪽, 받아라%UNICODE(0x2764)% 후후, 움찔움찔하고 있네…… 귀여워%UNICODE(0x2764)%」
					PRINTFORMW 쾌락으로 페니스가 파르르 떨리는 모습을 시야에 담고, 코이시는 크크 웃으며 봉사를 재개했다.
			ENDSELECT
		ELSEIF ABL:胸 >= 2
			PRINTFORML 「응, 읏…… 잠깐, 이렇게…… 핥을게」
			PRINTFORMW 코이시는 적당한 크기의 가슴을 이용해 페니스를 만지면서 귀두에 혀를 댔다.
		ELSE
			PRINTFORML 「응, 시…… 흠흠, 이거 어려울지도」
			PRINTFORMW 코이시는 악전고투하며 가슴으로 페니스를 감싼 채 조심스럽게 혀를 움직였다.
		ENDIF
		;それ以外
	ENDIF
ENDIF
