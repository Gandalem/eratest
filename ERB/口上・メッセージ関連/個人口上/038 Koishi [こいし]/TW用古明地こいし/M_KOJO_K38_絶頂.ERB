					PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")% 사랑받았다는 증거가, 나를 가득 채워가는 게 느껴져…%UNICODE(0x2764)%」
					PRINTFORMW
				CASEELSE
					IF EX:膣内精液 >= 1200
						PRINTFORML 「스, 정%UNICODE(0x2764)%말 대단한 정액 때문에, 코이시의 배가…… 부풀어 버렸어%UNICODE(0x2764)%」
						PRINTFORML 「……%조사처리(CALLNAME:MASTER,"의")% 짐승%UNICODE(0x2764)%」
						PRINTFORMW 
					ELSE
						PRINTFORML 「아……%UNICODE(0x2764)% %조사처리(CALLNAME:MASTER,"에게")% 속으로 들키는 건…… 좋아%UNICODE(0x2764)%」
						PRINTFORMW 
					ENDIF
			ENDSELECT
		ENDIF
	ELSE
		IF TALENT:MASTER:濃厚精液
			IF RAND:3 == 0
				PRINTFORML 「아, ……안에……」
				PRINTFORML 코이시는 멍한 눈으로 사정이 계속되는 결합부에 시선을 향하고 있다.
				PRINTFORMW 
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORML 「하아…… 임신해 버릴까 봐……」
				PRINTFORMW 
				RETURN 1
			ELSE
				PRINTFORML 「아…… 아앗…… 아직, 안…… 나와……」
				PRINTFORMW 
				RETURN 1
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「아, 하아…… 배가 두근두근하고 있어」
				PRINTFORML 「……뜨거워…… 스며들어 오는 것 같아」
				PRINTFORMW 
				RETURN 1
			ELSEIF RAND:2 == 0
				PRINTFORML 「하아… 아, 대단해……읏」
				PRINTFORMW 
				RETURN 1
			ELSE
				PRINTFORML 「하앗…… 하큭…… 하아…… 아앗」
				PRINTFORML 「대단해…… 내 안에서, 아직, 사정하고 있어……」
				PRINTFORMW 
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
