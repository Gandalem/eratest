;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K38_310
CALL M_KOJO_MESSAGE_COM_K38_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K38_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW 멈춘 시간 속에서, 코이시의 부드러운 엉덩이를 주무르고 있었다.
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 기분 좋은 감촉에 정신을 빼앗겼다.
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「……이제 그만!」
		PRINTFORMW 코이시는 참지 못하고 %조사처리(CALLNAME:MASTER,"를")% 밀쳐냈다
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「……앙! %UNICODE(0x2665) *1%」
			PRINTFORMW 「……아하♪ %CALLNAME:MASTER%에게라면, 괜찮아 %UNICODE(0x2665) *1%」
			PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 주무르며, 몽롱한 표정으로 말을 이었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……이제, 변태%UNICODE(0x2665) *1%」
			PRINTFORMW 코이시는 입으로는 그렇게 말하면서도, 전혀 싫지 않은 듯 밀쳐내는 행동은 하지 않았다.
		ELSE
			PRINTFORMW 「앗%UNICODE(0x2665) *1%」
			PRINTFORMW 움찔 몸을 떨며, 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 주무르면서 점차 표정을 녹여갔다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……앙앗」
			PRINTFORMW 「……이제, 어쩔 수 없으니까♪」
			PRINTFORMW 코이시는 엉덩이를 주무르며, 마뜩찮아하지 않는 듯 미소 지었다
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……이제 그만해줘」
			PRINTFORMW 코이시는 뺨을 붉게 물들이면서도 저항하는 듯한 행동은 하지 않았다.
		ELSE
			PRINTFORMW (어떡하지, 좀 기분 좋은지도……)
			PRINTFORMW 코이시는 엉덩이를 쓰다듬어지자, 이따금 몸이 움찔하며 반응하고 있었다
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「……아후」
			PRINTFORMW 「이제, ……야한 거 하지 마」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……안돼」
			PRINTFORMW 코이시는 아이를 타이르는 듯한 말투로 손을 뿌리쳤다.
		ELSE
			PRINTFORMW 「……저기요」
			PRINTFORMW 코이시는 아이를 꾸짖는 듯한 말투로 손을 뿌리쳤다.
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「……캬우!?」
			PRINTFORMW 코이시는 엉덩이를 쓰다듬히며 귀여운 비명을 질렀다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……안 돼!」
			PRINTFORMW 코이시는 엉덩이를 쓰다듬자마자 재빨리 거리를 두었다.
		ELSE
			PRINTFORMW 「……윽!!」
			PRINTFORMW 코이시는 엉덩이를 주무르며 소리 없는 비명을 지르고 날아올랐다.
		ENDIF
	ELSE
		PRINTFORMW 「……이제 그만!」
		PRINTFORMW 코이시는 불만스러운 목소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 손을 뿌리쳤다
	ENDIF
ENDIF
RETURN 1
