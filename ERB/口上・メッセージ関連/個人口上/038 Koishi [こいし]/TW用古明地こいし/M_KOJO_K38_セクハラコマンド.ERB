;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K38_312
CALL M_KOJO_MESSAGE_COM_K38_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K38_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW 멈춰버린 시간 속에서, 코이시의 입술을 빼앗았다
		PRINTFORMW 생기 넘치는 입술은 부드러웠고, 은은한 단맛을 느낄 수 있었던 것 같다
	ELSEIF CFLAG:TARGET:睡眠
		PRINTFORMW 「……응읏……후윽%UNICODE(0x2665) *1%」
		PRINTFORMW 긴장을 풀고 깊이 잠든 코이시의 입술을 빼앗았다.
		PRINTFORMW 조금 숨쉬기 힘들어하는 듯했지만, 아주 살짝 뺨이 붉게 물든 것 같은 기분이 들었다.
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「……이제 그만!」
		PRINTFORMW 코이시는 참지 못하고 %조사처리(CALLNAME:MASTER,"를")% 밀쳐냈다
	ELSEIF TALENT:恋人
		IF RAND:6 == 0
			PRINTFORMW 「……응읏%UNICODE(0x2665) *1%　……아무읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「하후……아무%UNICODE(0x2665) *1%」
			PRINTFORMW 「에헤헤…… 더, 키스 해줘%UNICODE(0x2665) *1%」
			PRINTFORMW 코이시는 녹아내린 표정으로 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗았다.
		ELSEIF RAND:5 == 0
			PRINTFORMW 「아앗…… 츄릅!」
			PRINTFORMW 「……이제 그만해, 돌려줘%UNICODE(0x2665) *1%」
			PRINTFORMW 코이시는 장난스럽게 웃으며 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗아 진한 키스를 나누었다.
		ELSEIF RAND:4 == 0
			PRINTFORMW 「……츄%UNICODE(0x2764)%」
			PRINTFORMW 「아하하하! %조사처리(CALLNAME:MASTER,"를")% 말이야, 얼빠져서 재미있어~♪」
			PRINTFORMW 갑작스러운 입맞춤에 당황하는 %조사처리(CALLNAME:MASTER,"를")% 보며, 코이시는 즐거운 듯 웃고 있다.
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응……, 쪽%UNICODE(0x2764)% ……푸하%UNICODE(0x2764)%」
			PRINTFORMW 「헤헤, 가끔은 나한테 키스해도 괜찮잖아?」
			PRINTFORMW 코이시는 볼을 물들이며 눈짓 하나 하고 소악마 같은 미소를 띠고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음……, 쪽%UNICODE(0x2764)% ……앙%UNICODE(0x2764)%」
			PRINTFORMW 코이시에게 갑작스러운 키스를 당하고, %조사처리(CALLNAME:MASTER,"는")% 놀라 눈을 크게 뜬다.
			PRINTFORMW 그 모습에 만족한 듯 눈을 가늘게 뜨며, 코이시는 %조사처리(CALLNAME:MASTER,"의")% 목에 팔을 감고 농밀한 키스를 이어간다.
		ELSE
			PRINTFORMW 「……에헤헤, 키스 좋아해%UNICODE(0x2665) *1%」
			PRINTFORMW 눈에 하트를 띄운 채로, 코이시는 키스를 청하고 있다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……아후윽%UNICODE(0x2665) *1%」
			PRINTFORMW 「…이제, 조금 더 부드럽게%UNICODE(0x2665) *1%」
			PRINTFORMW 코이시는 그렇게 말하면서도 완전히 완성된 듯 눈에 하트를 담고 표정을 녹이고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응!?」
			PRINTFORMW 코이시는 키스를 받아들이며 팔을 %조사처리(CALLNAME:MASTER,"의")% 등에 감고 있다.
		ELSE
			PRINTFORMW 「……아후%UNICODE(0x2665) *1%」
			PRINTFORMW 코이시는 키스로부터 해방되자 꿈을 꾸는 듯한 모습으로 입술에 손가락을 갖다 댔다.
			PRINTFORMW (…좋아…)
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「……응!?」
			PRINTFORMW 「……아직, 일러요」
			PRINTFORMW 코이시는 그런 종류의 것이지만, 뺨을 붉게 물들인 그 표정은 전혀 나쁘지 않아 보였다
		ELSEIF RAND:2 == 0
			PRINTFORMW 「！？！？！？？？」
			PRINTFORMW 코이시는 입술을 빼앗기고 저항하고는 있지만, 그 저항은 나약했고 표정은 점차 녹아갔다.
		ELSE
			PRINTFORMW 「아……」
			PRINTFORMW 코이시는 유메미처럼 숨을 내뱉으며 입술을 빼앗기고 있다.
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「……무우~, 안 돼」
			PRINTFORMW 코이시는 키스당하는 것을 싫어하는 듯하다
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……와아!?」
			PRINTFORMW 코이시는 키스당하는 것에 당황한 듯하다
		ELSE
			PRINTFORMW 「……이제, 키스하는 건……」
			PRINTFORMW 코이시는 입술을 빼앗긴 %조사처리(CALLNAME:MASTER,"에게")% 불쾌한 시선을 보내고 있다.
		ENDIF
	ELSE
		PRINTFORMW 「……앗!」
		PRINTFORMW 코이시는 참지 못하고 %조사처리(CALLNAME:MASTER,"를")% 밀쳐버렸다.
	ENDIF
ENDIF
RETURN 1
