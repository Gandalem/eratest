;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K38_311
CALL M_KOJO_MESSAGE_COM_K38_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K38_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW 멈춰버린 시간 속에서 코이시의 몸에 안기다
		PRINTFORMW 코이시의 몸은 빈틈없이 팔 안에 안겼고, %조사처리(CALLNAME:MASTER,"는")% 신비로운 편안함을 느끼고 있었다
	ELSEIF CFLAG:TARGET:睡眠
		PRINTFORMW 「……스우…… 응……」
		PRINTFORMW 코이시는 편안한 모습으로 푹 잠들어 있다.
		PRINTFORMW 적당히 작은 몸은 안고 있으면 이상하게 잘 맞는 느낌을 받을 수 있었다.
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 「……안돼!」
		PRINTFORMW 코이시는 달려드는 %조사처리(CALLNAME:MASTER,"를")% 쾅 하고 밀쳐냈다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응……」
			PRINTFORMW 「에헤헤…… 따뜻해」
			PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 안겨 꿈속을 유영하고 있다
		ELSEIF RAND:2 == 0
			PRINTFORMW 「에헤헤, 어서 와~♪」
			PRINTFORMW 코이시는 즐거운 듯 끌어안고 되받아왔다
		ELSE
			PRINTFORMW 「……응, 이대로 조금 더」
			PRINTFORMW 코이시는 마주 안아주며 볼을 붉게 물들이고 눈을 감은 채 %조사처리(CALLNAME:MASTER,"의")% 체온을 느끼고 있었다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「……에헤헤」
			PRINTFORMW 「……이렇게 안아지는 거, 좋아해」
			PRINTFORMW 코이시는 뺨을 진홍색으로 물들이며 %조사처리(CALLNAME:MASTER,"의")% 포옹을 받아들인다
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……왠지 좋다, 이런 거」
			PRINTFORMW 코이시는 포옹을 받아들이며 눈을 감고 %조사처리(CALLNAME:MASTER,"의")% 체온을 느꼈다.
		ELSE
			PRINTFORMW 「…… %조사처리(CALLNAME:MASTER,"에게")% 안겨 있는 거, 왠지 마음이 놓여」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「……응」
			PRINTFORMW 「……따뜻해」
			PRINTFORMW 코이시는 약간 당황하면서도 포옹을 받아들이고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……우와앗!?」
			PRINTFORMW 코이시는 깜짝 놀란 듯 몸을 경직하고 있다.
		ELSE
			PRINTFORMW 「어쩔 수 없네에」
			PRINTFORMW 코이시는 난처한 듯 중얼거리며, 순순히 포옹을 받아들이고 있다.
		ENDIF
	ELSEIF CFLAG:2 >= 500
		IF RAND:3 == 0
			PRINTFORMW 「……이제, 이런 거 안 되는 거야」
			PRINTFORMW 코이시는 끌어안기에는 저항을 느끼는 듯하다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……모- 됐으니까 좀…… 떨어져 봐아!」
			PRINTFORMW 코이시는 힘껏 %조사처리(CALLNAME:MASTER,"의")% 몸을 밀쳐내려 하고 있다.
		ELSE
			PRINTFORMW 「안 된다고 했잖아……읏!」
			PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"를")% 밀쳐내며 거리를 두었다.
		ENDIF
	ELSE
		PRINTFORMW 「우와……」
		PRINTFORMW 코이시는 %CALLNAME:MASTER%로부터 거리를 두었다.
	ENDIF
ENDIF
RETURN 1
