@M_KOJO_MESSAGE_COM_K38_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORML 
