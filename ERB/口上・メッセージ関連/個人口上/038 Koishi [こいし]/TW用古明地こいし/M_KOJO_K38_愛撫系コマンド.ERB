		ENDIF
		RETURN 1
	ENDIF
	;膣内射精直後
	IF TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORML 「응…%UNICODE(0x2764)%는, 아……응%UNICODE(0x2764)%」
			PRINTFORMW 「나랑 %조사처리(CALLNAME:MASTER,"가")% 하는 게……%UNICODE(0x2764)% 아아…%UNICODE(0x2764)%」
