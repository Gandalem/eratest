; Modular ERB: 個人口上/038 Koishi [こいし]/TW用古明地こいし/M_KOJO_K38_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K38_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
			PRINTFORMW 「탄막 놀이~? 좋아아…… 큭」
		ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
			PRINTFORMW 「여보세요~ 지금 당신을 처치하러 갈 거야~♪」
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「저기~ 지금 당신 뒤에 있어♪」
				CASE 2
					PRINTFORMW 「좋아, 상대해 줄게~♪」
				CASEELSE
					PRINTFORMW 「나를 잡을 수 있을까아~♪」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORML 「……히에?」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORML 「아……」
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「……꺄아!?」
					CASE 2
						PRINTFORML 「……어라?」
					CASEELSE
						PRINTFORML 「……뭐야아?」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「말도 안 돼~!!」
					CASE 2
						PRINTFORML 「히야아~앗!」
					CASEELSE
						PRINTFORML 「아앗! 아파아아!!」
				ENDSELECT
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「크윽...!」
					CASE 2
						PRINTFORML 「아하하하하!! 아파 죽겠네 정말!!」
					CASEELSE
						PRINTFORML 「아하핫하! 산산조각 내 줄 테니까 기다리고 있어?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:10
					CASE 1
						PRINTFORML 「아얏!」
					CASE 2
						PRINTFORML 「꺄아악!」
					CASE 3
						PRINTFORML 「잡혔다고!?」
					CASE 4
						PRINTFORML 「꺄앗!」
					CASE 5
						PRINTFORML 「꺅!」
					CASE 6
						PRINTFORML 「혹시, 보여!?」
					CASE 7
						PRINTFORML 「~~~~읏!」
					CASE 8
						PRINTFORML 「잠깐… 타임타임~!!」
					CASE 9
						PRINTFORML 「야, 해버리네읏!」
					CASEELSE
						PRINTFORML 「이얏!」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「그거! 무의식 '탄막의 로르샤흐'!!」
			CASE 2
				PRINTFORML 「피할 수 있을까아~? 반응 『요괴폴리플라프』!!」
			CASEELSE
				PRINTFORML 「간다! 『서브태리니안 로즈』!!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORMW 「우에에, 취기가 돌아서 기분 나빠아……」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORMW 「안 돼~ %조사처리(CALLNAME:MASTER,"에게")% 지다니이~」
			ELSE
				PRINTFORML 「흐읍 흐읍……읏」
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「모, 더는 못 하겠어~!! 손가락 하나 움직일 수가 없어~...」
					CASE 2
						PRINTFORMW 「아아, 지고 말았네……」
					CASE 3
						PRINTFORMW 「나를 이렇게 완벽하게 이해하다니――」
					CASE 4
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 의외로 강했네……」
					CASEELSE
						PRINTFORMW 「혹시나~ 지금 당신 앞에 쓰러져 있는 건가아... 가쿠리」
				ENDSELECT
			ENDIF
			;こいし勝利
		ELSE
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORMW 「아하하핫! 이상한 멋짐~♪」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORMW 「이대로 언제 죽을지 시험해보고 싶다아~♪」
			ELSE
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「와아, 재밌다~!! 이거 중독되겠는데」
					CASE 2
						PRINTFORMW 「좀 더 본능적으로 싸우면 되는걸요」
					CASE 3
						PRINTFORMW 「에헤? 시원찮네~」
					CASE 4
						PRINTFORMW 「혹시나~ 지금 당신 등 위에 있는 나야」
					CASEELSE
						PRINTFORMW 「야호! 내가 이겼다!! %CALLNAME:MASTER%, 아직 멀었네~♪」
				ENDSELECT
				TALENT:38:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
