;==================================================

@M_KOJO_SUCCESS_COM_K38_363
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K38_363
CALL M_KOJO_MESSAGE_COM_K38_363_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K38_363_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;添い寝中		%CALLNAME:PLAYER%は\@ INROOM(CFLAG:MASTER:現在位置) == 2 ? ベッド # ふとん \@の中で本を読んであげた
	;膝の上			%CALLNAME:PLAYER%は%CALLNAME:TARGET%を膝の上に乗せながら本を読んであげた
	;%CALLNAME:PLAYER%は%CALLNAME:TARGET%に本を読んであげた
	;読み聞かせ初回
	IF PREVCOM != 363
		PRINTFORMW 「있잖아 %CALLNAME:MASTER%, 나 말이야, %CALLNAME:MASTER%한테 이 책을 읽어줬으면 좋겠단 거야!」
		PRINTFORM 코이시가 읽어주길 바랐던 그 책의 내용은
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 그리무 동화 같은 건 아이들용 그림책 같아
			CASE 1
				PRINTFORMW 깜짝 놀랄 만한 표지를 한, 사실은 무서운 그림 동화 같은 것이었다
			CASE 2
				PRINTFORML 심리학, 심층심리를 소재로 한 서적이었다.
				IF ABL:MASTER:教養 >= 3
				ELSE
					PRINTFORMW %CALLNAME:PLAYER%에게는 너무 어려워……!
				ENDIF
		ENDSELECT
		;連続実行
	ELSE
		PRINTFORML 「에헤헤~ %CALLNAME:PLAYER%, 계속 들려줘?」
		PRINTFORMW 즐거워하는 코이시에게 미소 짓는 기분이 되면서, %조사처리(CALLNAME:MASTER,"는")% 책을 더 읽기로 했다.
	ENDIF
	PRINTL
	;添い寝中
	IF CFLAG:TARGET:添い寝中
		PRINTFORMW 코이시는 %조사처리(CALLNAME:PLAYER,"와")% 함께 있는 \@ INROOM(CFLAG:MASTER:現在位置) == 2 ? 침대 # 이불 \@ 안에서 책을 읽어주었다.
		IF TFLAG:193 == 0
			PRINTFORMW 처음에는 두근거리는 모습으로 본의 내용을 듣고 있던 코이시였지만, 졸음에 이끌려 꾸벅꾸벅 졸고 있다.
		ENDIF
		;膝の上
	ELSEIF TALENT:MASTER:体型 > TALENT:TARGET:体型 && INROOM(CFLAG:MASTER:現在位置)
		PRINTFORMW 코이시는 무릎 위에 엉덩이를 올리고, 파타파타 발을 흔들며 %조사처리(CALLNAME:PLAYER,"에게")% 책을 읽어달라고 했다.
		PRINTFORML
		PRINTFORML 책을 읽어주면서 %조사처리(CALLNAME:MASTER,"는")%
		PRINTFORM 코이시에게 들키지 않도록,
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 소녀의 따뜻한 살결의 온기를 느끼며 두근거리고 있다.
			CASE 1
				PRINTFORMW 옷 위로 느껴지는 엉덩이의 부드러운 감촉을 즐겼다.
			CASE 2
				PRINTFORMW 살짝 풍겨오는 소녀의 좋은 냄새를 만끽했다
		ENDSELECT
		;あなたが勃起
		IF (TALENT:PLAYER:2 & 2) && BASE:MASTER:勃起 >= 1000
			PRINTFORML
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 발기하고 있어...
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 발기한 가랑이가 코이시의 부드러운 엉덩이에 닿자, 아랫배에서부터 뜨거운 욕정이 피어오른다.
			IF TFLAG:193 >= 0
				PRINTFORMW 「……응~? 뭔가, 단단한 게 엉덩이에 있는 것 같아?」
				PRINTFORML 코이시는 엉덩이에 닿는 이질감을 확인하듯 엉덩이를 흔들자, 뜻밖에도 옷 위로 느껴지는 엉덩이 자극 같은 형태가 되어 %조사처리(CALLNAME:MASTER,"를")% 괴롭게 만들었다.
				PRINTFORMW 이윽고 그것이 무엇인지 알아챈 듯 얼굴을 새빨갛게 물들이며 고개를 숙이고 말았다.
				;失敗
			ELSEIF TFLAG:193 == -1
				PRINTFORML 「……이거 말이야」
				PRINTFORML 코이시가 엉덩이에 느껴지는 위화감을 눈치챈 듯, 부풀어 오르는 볼로 %조사처리(CALLNAME:MASTER,"를")% 바라보았다.
				PRINTFORMW 「……변태, 색골」
				PRINTFORMW 볼을 붉게 물들이고 그렇게 내뱉은 코이시는 무릎에서 내려왔다.
				PRINTFORMW 코이시는 빙그레 %CALLNAME:MASTER%쪽으로 돌아보더니, 「베에」 하고 손을 모으는 시늉을 했다.
			ENDIF
		ENDIF
	ELSE
	ENDIF
ENDIF
RETURN 1
