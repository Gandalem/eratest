;604,散策する
;デート中の場合、CFLAG:現在位置に移動先の場所が既に入ってる
;==================================================

@M_KOJO_MESSAGE_COM_K38_604
;散策するにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K38_604_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K38_604_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠 || !CFLAG:同行 ;custom code
		RETURN 0
	;次の移動先で分岐
	SELECTCASE CFLAG:MASTER:現在位置
		;大衆浴場(人間の里)
		CASE 大衆浴場
			;初めて
			IF FIRSTTIME("大衆浴場",0)
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「아, 목욕하러 가는구나. 에헤헤, 슬슬 개운하게 하고 싶었는데~♪」
					PRINTFORMW 코이시는 신나는 모습으로 %조사처리(CALLNAME:MASTER,"와")% 함께 걸어간다
					PRINTFORML 「평소에도 자주 오는데…… 있잖아, 나는 눈에 띄지 않으니까 돈만 두고 목욕하는 거야」
					PRINTFORML 그건 뭐, 본인이 모르는 돈이 놓여 있어서 가게 주인도 당황하겠지 하고 %조사처리(CALLNAME:MASTER,"는")% 쓴웃음을 지었다
					PRINTFORMW 그런 소녀의 이야기에 귀 기울이며, %조사처리(CALLNAME:MASTER,"는")% 다정하게 함께 걸어간다
				ELSE
					PRINTFORML 
					PRINTFORML 「좋아, 슬슬 목욕할 기분이었으니까」
					PRINTFORMW 코이시는 즐거운 듯 대중목욕탕으로 발걸음을 옮겼다
				ENDIF
			ELSE
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「응, 목욕하고 깨끗하게 해두고 싶으니까, 산책하러 가자!」
					PRINTFORML 「이거 끝나고 즐거운 것도 기다리고 있잖아…… 응♪」
					PRINTFORMW 코이시는 색기를 머금은 눈빛으로 놀리듯 입을 열더니, 스스름 웃으며 %조사처리(CALLNAME:MASTER,"에게")% 기대왔다.
				ELSE
					PRINTFORML 
					PRINTFORML 「앗 목욕, 아~ 목욕~♪」
					PRINTFORMW 코이시는 온천에 간다고 듣고 즐거운 듯 걸어가고 있다.
				ENDIF
			ENDIF
			;連れ込み宿(人間の里)
		CASE 連れ込み宿
			;初めて
			IF FIRSTTIME("連れ込み宿",0)
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「저기…… 여기, 혹시 그런 곳이야?」
					PRINTFORML 일반적인 료칸과는 분위기가 다른, 음흉함이 감도는 건물에 코이시는 눈을 동그랗게 뜨고 있다.
					PRINTFORMW 이윽고 %조사처리(CALLNAME:MASTER,"가")% 지금부터 자신과 「그런 행위」를 할 생각이라는 것을 깨닫고 얼굴을 새빨갛게 물린다.
					PRINTFORML 「……벌써…… 에치네」
					PRINTFORMW 입으로는 그렇게 말하면서도, 소녀는 전혀 거부하는 기색 없이 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡겼다.
					PRINTFORML 「…… 기분 좋게 해줘?」
					PRINTFORMW 부끄러운 듯 말을 이어가는 코이시를 어쩔 줄 모르며, %조사처리(CALLNAME:MASTER,"는")% 코이시의 어깨를 감싸 안고 연내 숙소로 들어갔다.
				ELSE
					PRINTFORML 
					PRINTFORML 「여기는 어디야? 뭔가 좀 다르네」
					PRINTFORMW 이곳이 어떤 장소인지 잘 모르겠는지, 코이시는 어리둥절한 표정으로 고개를 기울이고 있다.
					PRINTFORML 「저기, 야한 거 하는…… 장소? 에? 에에에에에에엣!?」
					PRINTFORMW 코이시는 놀라서 소리를 지르지만, 그 사이에 %조사처리(CALLNAME:MASTER,"에게")% 이끌려 들어와 버렸다
				ENDIF
			ELSE
				IF TALENT:恋慕
					;溜まっている度の状態で分岐
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「응, 좋아…… 야한 거 할까? %UNICODE(0x2764)%」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 요구에 코이시는 전혀 꺼리지 않는 듯 고개를 끄덕였다.
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「에헤헤……%UNICODE(0x2764)% 저, 이제부터 야한 숙소로 끌려가는 거야」
						PRINTFORMW 입으로는 그렇게 말하면서도 요염하게 웃으며 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡겼다.
					ELSEIF CFLAG:TARGET:溜まってる度 < 1000
						PRINTFORML 
						PRINTFORML 「부탁이야, %CALLNAME:MASTER%나를…… 범해줘%UNICODE(0x2764)%」
						PRINTFORMW 코이시는 발정하여 유혹하듯 %조사처리(CALLNAME:MASTER,"에게")% 몸을 밀착시키며 속삭였다
					ELSE
						PRINTFORML 
						PRINTFORML 「부탁이야 %CALLNAME:MASTER%, 나 이제 더는 참을 수 없어%UNICODE(0x2764)%」
						PRINTFORMW 얼굴을 새빨갛게 물들이며 간청하는 코이시의 표정은 욕정에 완전히 잠긴 듯 숨을 내쉬고 있다
					ENDIF
				ELSE
					;溜まっている度の状態で分岐(恋慕より分岐少なめ)
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「이쪽 방향 말이야, 분명……」
						PRINTFORMW 어디로 향하는지 눈치챈 듯, 코이시는 긴장된 표정으로 발걸음을 옮기고 있다.
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「정말, 어쩔 수 없네……」
						PRINTFORMW 코이시는 자신이 쌓여있음을 감추려는 듯 말하며 %조사처리(CALLNAME:MASTER,"에게")% 이끌려 숙소로 들어갔다.
					ELSE
						PRINTFORML 
						PRINTFORML 「하아……핫……우으, 나 이런 천박한 애가 아닌데」
						PRINTFORMW 코이시는 뜨거운 숨을 내쉬며 변명하듯 숙으로 들어갔다
					ENDIF
				ENDIF
			ENDIF
			;ラブホ(地底)
		CASE ラブホ
			;初めて
			IF FIRSTTIME("ラブホ",0)
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「이런 곳은 알고 있어. 고향이니까, 야한 일을 하기 위한 장소라는 것도」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 이끌려 화려하고 호화로운 건물로 안내된 코이시가 그렇게 말을 잇는다.
					PRINTFORML 『숙박』『휴식』 요금이 적힌 간판, 공간을 감도는 음탕한 공기
					PRINTFORMW 무엇보다 그녀 자신이 지하 거주자라면, 알고 있는 것이 당연하다고 할 수 있을까
					PRINTFORML 「있잖아, %조사처리(CALLNAME:MASTER,"는")% 여기서 나랑 섹스하고 싶은 거야?」
					PRINTFORMW 코이시의 물음에 %조사처리(CALLNAME:MASTER,"는")% 「물론」 하고 고개를 끄덕인다.
					PRINTFORML 「나는 %조사처리(CALLNAME:MASTER,"와")% 야한 일을 하는 것도…… 뭐, 싫지는 않지만」
					PRINTFORML 「여기에 들어온 일, 아마 누군가의 입을 통해 언니 귀에 들릴지도 모르는데, 괜찮아?」
					PRINTFORMW 그녀의 언니에게 노려지는 모습을 상상해 몸을 떨었지만, 그래도 여기서 그녀와 야한 것을 하고 싶었다.
					PRINTFORML 「……후후, 어쩔 수 없네. 나한테 맡겨줘♪」
					PRINTFORMW 코이시에게 손을 이끌려, 그녀의 능력 덕분인지 누구의 눈에도 들키지 않고 러브호텔로 들어갔다.
				ELSE
					PRINTFORML 
					PRINTFORML 「……」
					PRINTFORMW 고향이라 그런지, 이곳이 어떤 장소인지 알고 있던 코이시는 얼굴을 새빨갛게 물리고 건물을 올려다보고 있다.
					PRINTFORML 「아, 잠깐만 기다려 봐! 여긴 위험하다고! 누나한테 들키면 어떡해!!?」
					PRINTFORMW 코이시의 걱정은 전혀 개의치 않고, %조사처리(CALLNAME:MASTER,"는")% 소녀의 손을 잡고 러브호로 들어갔다.
				ENDIF
			ELSE
				IF TALENT:恋慕
					;溜まっている度の状態で分岐
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「있잖아, 저기서 '쉬자'…… 하고 갈래? %UNICODE(0x2764)%」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 손을 살며시 잡고, 코이시는 얼굴을 붉히며 다가섰다.
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「지금부터 저기서, %조사처리(CALLNAME:MASTER,"에게")% 사랑받는 거구나, 나%UNICODE(0x2764)%」
						PRINTFORMW 코이시는 그렇게 말하며 쿠슷 웃고, 욕정에 물든 모습으로 %조사처리(CALLNAME:MASTER,"에게")% 기대었다.
					ELSEIF CFLAG:TARGET:溜まってる度 < 1000
						PRINTFORML 
						PRINTFORML 「……누나 있는 곳 근처에서 야한 짓 하는 거 생각하니까, 좀 흥분해버릴지도 모르겠어%UNICODE(0x2764)%」
						PRINTFORMW 러브호 건너편으로는 지령전이 보였고, 코이시는 배덕감인지 욕정이 뒤섞인 표정을 짓고 있었다.
					ELSE
						PRINTFORML 
						PRINTFORML 「하아%UNICODE(0x2764)% 하아%UNICODE(0x2764)% 부탁이야, 저기서 나를, 엉망진창으로 범해줘%UNICODE(0x2764)%」
						PRINTFORMW 성욕을 더 이상 참을 수 없게 되었는지, 코이시는 체면도 염치도 없는 모습으로, 허벅지를 애액으로 뚝뚝 적시며 욕정에 물든 숨을 내뱉고 있다.
					ENDIF
				ELSE
					;溜まっている度の状態で分岐(恋慕より分岐少なめ)
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「우으…… 부디 언니 귀에 들리지 않도록」
						PRINTFORMW 러브호에 들어가면서, 코이시는 기도하듯 중얼거리고 있다.
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「……우으…… 누나에게 들키는 건 싫어, 싫지만……」
						PRINTFORMW 코이시는 성욕이 쌓였는지 몸을 꿈틀거리며 러브호로 끌려갔다.
					ELSE
						PRINTFORML 
						PRINTFORML 「하아앗%UNICODE(0x2764)% 아앗%UNICODE(0x2764)% 부탁이야, %CALLNAME:MASTER%%UNICODE(0x2764)%」
						PRINTFORMW 욕정에 들뜬 코이시는 뚝뚝 허벅지를 애액으로 적셨고, 언니에게 들킬지도 모른다는 생각은 사고의 깊은 곳으로 밀려나 버린 듯했다.
					ENDIF
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
