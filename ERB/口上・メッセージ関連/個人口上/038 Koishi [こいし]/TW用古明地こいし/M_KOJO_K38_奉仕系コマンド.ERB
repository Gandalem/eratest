@M_KOJO_MESSAGE_COM_K38_81
CALL M_KOJO_MESSAGE_COM_K38_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K38_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「우으... %조사처리(CALLNAME:MASTER,"의")% 것은 좋아하지만, 이것을 핥는 것은 아직 조금 무섭다고 할까...」
			PRINTFORMW 페니스를 만지며 코이시는 수줍어하고 있었고, 약간 주저하다가 결심한 듯 귀두를 살짝 핥았다.
		ELSE
			PRINTFORML 「에에…… 거기를 핥는 거야? 우우, 이런 걸 생각한 사람은 절대로 변태일 거야아」
			PRINTFORMW 코이시는 약간 눈물이 그렁해진 채 그렇게 당연한 말을 흘리며, 조심스럽게 노출된 남성기에 얼굴을 가까이 가져갔다
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕
		IF ABL:舌 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「에헤헤…… %조사처리(CALLNAME:MASTER,"의")% 거시기%UNICODE(0x2764)% 받아갈게요%UNICODE(0x2764)%%UNICODE(0x2764)% 음쪽……츄릅%UNICODE(0x2764)% 쭈왑……%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 기분 좋게 %조사처리(CALLNAME:MASTER,"의")% 성기를 입에 물고, 혀로 애무하며 목구멍 깊숙한 곳까지 받아들였다……
					PRINTFORML 「푸하앗……%UNICODE(0x2764)% %조사처리(CALLNAME:MASTER,"의")% 정액 우유, 언제든지 코이시에게 입으로 내놓아도 괜찮으니까%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 페니스를 핥는 것에 주저하던 모습은 이미 사라졌고, 음란하게 미소를 띤 소녀는 머리를 쓸어 넘기며 다시 단단한 것을 목구멍까지 받아들였다.
				CASE 1
					PRINTFORML 「핥짝, 츄릅, 음읏……%UNICODE(0x2764)% 음읏, 쩝!……아후%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"의")% 성기를 귀두, 뒷줄, 고환까지 정성껏 핥으며, 외설적인 그것을 입으로 봉사하고 있다.
					PRINTFORML 「그럼 슬슬 여기서 주물러 줄게%UNICODE(0x2764)% 쪽……%UNICODE(0x2764)% 아무, 응, 츄릅! 쭈읍, 쮸읍……!」
					PRINTFORMW 요염하게 웃으며 목을 손가락으로 톡톡 두자, 코이시는 귀두에 키스한 후 뿌리까지 삼키고 얼굴을 앞뒤로 움직이며 몰아붙였다.
				CASE 2
					PRINTFORML 「후후, 이상하네. 처음에는 그렇게 당황하고 있었는데, 지금은 이렇게 사랑스럽게 느껴지잖아」
					PRINTFORMW 코이시는 쓴웃음을 지으며 페니스를 손가락으로 만지고, 이내 망설임 없이 끝에 키스를 한다
					PRINTFORML 「오늘은 천천히, 다정하게 애무해 줄게%UNICODE(0x2764)% 음츄르……%UNICODE(0x2764)% 치쯧, 함읏……%UNICODE(0x2764)% 음무, 응! 주루옷, 주루루룻%UNICODE(0x2764)% 츄폰, 푸하앗…!」
					PRINTFORMW 말 그대로 코이시는 단단한 것을 입에 물고 격렬하지는 않지만 정성스럽게 혀로 핥아 올리듯 애무하며, 황홀한 모습으로 봉사를 계속하고 있다
				CASE 3
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 거시기, 코이시가 입으로 예쁘게 해줄게%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 그렇게 말하고는 귀두나 기둥 뒤쪽 등을 정성스럽게 페니스를 혀끝으로 핥아 나간다.
					PRINTFORML 「음츄!%UNICODE(0x2764)% 후, 음무……%UNICODE(0x2764)% 에헤헤, 이런 거 하고 있으면 언니한테 혼나버리잖아%UNICODE(0x2764)%」
					PRINTFORMW 상당히 무서운 이야기를 하면서도 코이시는 페라를 멈출 기미가 보이지 않고, 오히려 더 적극적으로 입으로 페니스를 봉사하고 있다.
				CASE 4
					PRINTFORML 「암무…… %UNICODE(0x2764)% 음무앗, 츄프옷, 츄폰옷...! 주부, 주푸뿌, 츄프우%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 눈에 하트를 떠올리고 강직을 물어버리며, 음란한 소리를 내면서 열중하여 페라를 계속하고 있다.
					PRINTFORML 「음무앗……!!? 응!? 응구앗!? 햣호, 하게히……%UNICODE(0x2764)% 은쥬, 주루룻!%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 그 모습에 참지 못한 %조사처리(CALLNAME:MASTER,"는")% 코이시의 머리를 움켜쥐고 스스로도 허리를 흔들며 절정에 다다랐다.
			ENDSELECT
		ELSEIF ABL:舌 >= 2
			PRINTFORML 「음훗%UNICODE(0x2764)% 또 나에게 거시기, 봉사받고 싶구나? %UNICODE(0x2764)%」
			PRINTFORMW 내밀어진 남근에 코이시는 작게 웃더니, 요염한 표정을 지으며 망설임 없이 입에 물었다.
