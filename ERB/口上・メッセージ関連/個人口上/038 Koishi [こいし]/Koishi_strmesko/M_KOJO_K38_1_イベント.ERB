			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTL 
				PRINTFORML 「에헤헤, 역시 생각했던 대로%UNICODE(0x2665) *1%」
				PRINTFORMW 「서로 가장 완벽하게 %SPLIT_G("love:enjoy with")% 해보자%UNICODE(0x2665) *1%」
				GOTO FINISH
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTL 
				PRINTFORML 「하하……후……그건 %KOISYN_MESKO("good")%……%UNICODE(0x2665) *1%였어」
				PRINTFORMW 「…………다시 해보자♪」
				GOTO FINISH
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTL 
				PRINTFORML 「하아%UNICODE(0x2665) *1% 생각했던 대로%UNICODE(0x2665) *1%」
				PRINTFORMW 「헤이, 나는 %KOISYN_MESKO("succumbed")%가 더%UNICODE(0x2665) *1% 되고 싶어」
