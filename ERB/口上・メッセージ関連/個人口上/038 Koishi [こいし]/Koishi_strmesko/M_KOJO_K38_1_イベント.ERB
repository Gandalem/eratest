@M_KOJO_MESKO_EVENT_K38_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF FIRSTTIME("オナバレ")
					PRINTFORMW 「헤이… %CALLNAME:MASTER%……왜 여기 있는 거야…?」
