@M_KOJO_MESKO_EVENT_K38_23(ARG,ARG:1)
;口上主はLOCAL
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The character kicks the player out
	;断られた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORML 「이건 부끄러워…… 다른 사람들이 못 본다고 해도……」
			PRINTFORML 코이시가 짜증 섞인 목소리로 %KOISYN_MESKO("mumble:s")% 한다.
			PRINTFORMW 그녀의 말과는 달리, 그녀의 %KOISYN_MESKO("green")% 눈은 함께 해달라고 애원하고 있지만, 이내 %KOISYN_MESKO("younggirl")% 손바닥으로 그것들을 가린다.
		ELSEIF TALENT:愛欲 || TALENT:セフレ
		ELSE
			PRINTFORML 「%KOISYN_MESKO("dame")%, 변태 손님. 공중목욕탕은 당신에게는 안 돼~♪」
			PRINTFORMW 그녀의 명랑한 미소와 함께, 코이시는 %조사처리(CALLNAME:MASTER,"를")% 공중목욕탕에서 쫓아냈다
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character agrees to take a bath together
	;一緒に入ってくれた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF IS_HERE(36) && IS_HERE(37) && IS_HERE(49)
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「마침내 우리는 가족들과 함께 모인다 %UNICODE(0x2665) *1%.」
				PRINTFORMW 사토리와 그녀의 반려동물들을 함께 보게 되어 신나며 코이시는 %CALLNAME:MASTER%목욕을 시키면서 팔을 잡고 %HIS_HER(MASTER)% 팔
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				PRINTFORML 「음... 그들은 우리 사이의 모든 것을 이미 알고 있을 거야...」
				PRINTFORML 「내가 바라… 내 가족도 너를 받아들여 주길...」
				PRINTFORMW 만남에 대한 걱정으로 코이시는 스스로를 끌어안고 함께 목욕을 위해 들어갔다.
			ELSE
				PRINTFORMW 코이시는 골치 아픈 듯, 자신을 %KOISYN_MESKO("누나")% 뒤에 숨기려 노력한다. %SPLIT_G("오쿠의 날개:오린의 등:우츠호의 등")%
			ENDIF
		ELSEIF IS_HERE(49) ;satori
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「음... 우리 사이의 일들을 이미 알고 있는 건 %KOISYN_MESKO("sister")%야...」
				PRINTFORMW 코이시는 활기찬 미소로 %조사처리(CALLNAME:MASTER,"를")% 바라보며 %HIM_HER(MASTER)%를 욕조 안으로 안내했다.
			ELSE
				CALL CHARA_TEXT(49,"「어이쿠, 어이쿠...」","l")
				PRINTFORMW 엄격한 목소리가 문을 통해 들려온다.
				PRINTFORML 「그녀가 여기 있어… 그녀는 이미 알고 있어…… 나를 벌할 거야……」
				PRINTFORMW 코이시는 두려움에 얼어붙어 공허한 눈으로 바닥을 응시하며 중얼거린다.
				PRINTFORMW 그녀의 상태와 상관없이 그녀는 시선을 따라 %조사처리(CALLNAME:MASTER,"와")% 여동생 사이에 함께 앉는다.
			ENDIF
		ELSEIF IS_HERE(36) && IS_HERE(37)
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「에헤헤, 안녕 %CALLNAME:MASTER%, 우리랑 함께 해%UNICODE(0x2665) *1%」
				PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들며 오린과 오쿠우를 약간 불안하게 만든다
			ELSE
				PRINTFORML 「에헤헤, 목욕탕이 북적거리네, 재밌다!%UNICODE(0x2665) *1%」
				PRINTFORMW 오린이나 우츠호와 달리 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 즐겁게 인사하며 %HIM_HER(MASTER)%를 욕조로 초대한다.
			ENDIF
		ELSEIF IS_HERE(36)
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「에헤헤, 안녕하세요 %CALLNAME:MASTER%, 우리와 함께 해요%UNICODE(0x2665) *1%」
				PRINTFORMW 코이시는 갑자기 기운을 차리고 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들며 우츠호가 약간 질투하게 만든다.
			ELSE
				CALL CHARA_TEXT(36,"「What are you forgot there, "+K36_BOYO()+"?」","l")
				PRINTFORML 「에헤헤, 걱정 마. 내가 전에 말해줬던 그 사람. %HE_SHE(MASTER)%가 나를 볼 수 있어~♪」
				CALL CHARA_TEXT(36,"「정말로 그렇구나. 그게 네 친구구나」","l")
				PRINTFORMW 오린은 %조사처리(CALLNAME:MASTER,"에게")% 호기심을 느끼고 %HIM_HER(MASTER)%가 목욕에 참여하는 것을 허락한다.
			ENDIF
		ELSEIF IS_HERE(37)
			IF TALENT:恋慕 || TALENT:恋人
				PRINTFORML 「에헤헤, 안녕 %CALLNAME:MASTER%, 우리와 함께하자%UNICODE(0x2665) *1%」
				PRINTFORMW 코이시는 갑자기 기운을 차리며 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들었고, 오쿠가 조금 질투하게 되었다.
			ELSE
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 욕실에 들어서면 코이시와 오쿠우는 욕조에서 함께 놀고 있다.
				CALL CHARA_TEXT(49,"「이거 받아라! 우츠호 태풍 공격!」","l")
				PRINTFORMW 오쿠가 날개로 물을 뿜자 코이시는 완전히 피한다.
				PRINTFORML 「에헤헤, 아 %CALLNAME:MASTER%! 같이 하자!%UNICODE(0x2665) *1%」
				PRINTFORMW 즐거운 미소를 지으며 코이시가 %조사처리(CALLNAME:MASTER,"를")% 함께 목욕하자고 초대한다.
			ENDIF
		ELSEIF IS_HERE(25) ;ran
			PRINTFORML 코이시는 공용 목욕탕에서 알몸으로 하는 것을 거부한다.
			PRINTFORML 「%KOISYN_MESKO("dame")%, 안 돼. 벌써 여기 너무 붐비잖아……」
			PRINTFORMW 하지만 그때 %KOISYN_MESKO("younggirl")% Rans의 복슬복슬한 꼬리를 보고 마음을 바꾼다
			PRINTFORML 「저 꼬리들 정말 복슬복슬해... 그렇게 많은데... 난 정말 %KOISYN_MESKO("want")% 그것들을 부풀리고 싶다…」
			PRINTFORML Ran의 뒤를 집착적으로 지켜보며 주문을 중얼거리던 코이시는 여기서 결심을 바꾸고 %CALLNAME:MASTER%목욕에 합류한다
		ELSE
			IF TALENT:恋慕 || TALENT:恋人
			ELSEIF TALENT:愛欲 || TALENT:セフレ
			ELSE
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
