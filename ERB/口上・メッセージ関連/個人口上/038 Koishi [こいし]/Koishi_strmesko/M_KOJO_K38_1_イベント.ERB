@M_KOJO_MESKO_EVENT_K38_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERを押し倒した（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「에헤헤……미안해」
				PRINTFORML 「더는 못 참겠어 %CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
			CASE 1
				PRINTFORML 「안녕―」
				PRINTFORML 「지금은……. 너를 먹겠다, %CALLNAME:MASTER% %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「후후후 %CALLNAME:MASTER%……」
				PRINTFORML 「너에게 %KOISYN_MESKO("good")%%UNICODE(0x2665) *1%을 느끼게 해 줄 거야」
		ENDSELECT
		IF TALENT:38:恋慕
			PRINTFORMW 「헤이……%CALLNAME:MASTER%, 나에게 당신의 사랑을 %UNICODE(0x2665) *1% 주세요」
		ELSE
			PRINTFORMW 「함께 깊고 공허한 무의식의 심연으로 떨어져 보자 %UNICODE(0x2665) *1%」
		ENDIF
		;妊娠中
		IF TALENT:38:妊娠 && CFLAG:38:妊娠自覚状態 == 1
			PRINTFORML 
			PRINTFORMW 「임신한 여성은 자신이 원하는 모든 것을 할 것이다... 관심 있나? %UNICODE(0x2665) *1%」
			;危険日
		ELSEIF CFLAG:38:生理周期 == 7 && !TALENT:38:妊娠 && CFLAG:38:生解禁 == 2
			PRINTFORML 
			PRINTFORMW 「%KOISYN_MESKO("shoot")%가 오늘 나에게 많이 쏟아내 줘♪」
			PRINTFORMW 「%CALLNAME:MASTER%아이들아, 나 임신하고 싶어%UNICODE(0x2665) *1%」
		ENDIF
		TCVAR:38:351 = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
				;抜け出した
				IF TALENT:38:恋慕
					;妊娠中
					IF TALENT:38:妊娠 && CFLAG:38:妊娠自覚状態 == 1
						PRINTFORML 「후우, 죄송해요...」
						PRINTFORMW 「그래... 하지만 어쩔 수 없지...」
						;我慢しません
						;危険日
					ELSEIF CFLAG:38:生理周期 == 7 && !TALENT:38:妊娠 && CFLAG:38:生解禁 == 2
						PRINTFORML 「여기…… 도망가지 마……」
						PRINTFORMW 「흠…… 아직 만족 못 했어ー」
					ELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「응... 맞아...」
								PRINTFORMW 「음, 내 몸은 그렇게 매력적이지 않아」
							CASE 1
								PRINTFORML 「아아, 그게 맞나……」
								PRINTFORMW 「더 재미있게 놀자」
							CASEELSE
								PRINTFORML 「이건……」
								PRINTFORMW 「음, 어쩌면 그렇게 '%KOISYN_MESKO("좋다")%'라고 느끼지 못했을지도 모르겠는데?」
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORML 「음…, %HE_SHE(MASTER)%가 도망갔어……」
					PRINTFORMW 「여보세요, 내 몸이 너에게 충분하지 않은 거야-?」
				ENDIF
			CASE 1
				;抱き着きモード満足終了
				RETURN 1
			CASE 2
				;抱き着きモード強制終了
				RETURN 1
		ENDSELECT
		TCVAR:38:351 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
				;好きにして状態から抜け出せなかった
				PRINTFORML 「%KOISYN_MESKO("dame")%～, 너를 놓아주지 않을 거야ー」
				PRINTFORMW 「나를 흥분하게 만든 것에 대한 책임을 지게 될 거야♪」
				RETURN 1
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「%KOISYN_MESKO("dame")%—, 나 기분 좀 풀어줘……그치?」
					CASE 1
						PRINTFORML 「너의 고군분투는 너무 귀엽다♪」
						PRINTFORMW 「걱정 마…… %KOISYN_MESKO("good")%을 함께 느껴보자♪%UNICODE(0x2665) *1%」
					CASEELSE
						PRINTFORMW 「너를 잡았다―! 도망은 없어♪%UNICODE(0x2665) *1%」
				ENDSELECT
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
