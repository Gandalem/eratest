	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SIF FLAG:時間停止 ;fix
			RETURN 0
		LOCALS:0 = 
		IF TALENT:恋人
			LOCALS:0 = 볼이 %KOISYN_MESKO("blush:s")%로 물들었다.
		ELSEIF TALENT:恋慕
			LOCALS:0 = 부끄러운 표정으로
		ELSEIF GETBIT(CFLAG:1,0)
			LOCALS:0 = 허공에 손을 흔들면서
		ENDIF
		PRINTFORMW 코이시가 %조사처리(CALLNAME:MASTER,"를")% %LOCALS:0%에서 발견했을 때 그녀는 앞으로 나섰다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「Ah, %CALLNAME:MASTER%……」
			PRINTFORMW ~을 가지고 %SPLIT_G("regret on her face:frustrated look")%코이시 %KOISYN_MESKO("watch:es")% 에서 %CALLNAME:MASTER%사라져 가는
		ELSEIF TALENT:恋慕
			PRINTFORMW 「Ah, %CALLNAME:MASTER%」
			PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"가")% 죽었을 때 실망한 표정을 짓는다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「유~후우,%CALLNAME:MASTER%님!」
			PRINTFORMW 코이시는 허공에 손을 흔들며 시선을 돌렸다.
		ELSE
			PRINTFORMW 「안녕, 방금 지나갔어~♪」
			PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들며 웃었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SIF FLAG:時間停止 ;fix
			RETURN 0
		LOCALS:1 = 
		IF TALENT:恋人
			LOCALS:1 = 「여보세요... 그러니까, 혹시 바쁜 건가요? ... 슬프네요」
		ELSEIF TALENT:恋慕
			LOCALS:1 = 「여보세요... 저를 볼 수 있을까요?」
		ELSEIF GETBIT(CFLAG:1,0)
			LOCALS:1 = 「어이, 나 너한테 무시당했잖아~♪」
		ENDIF
		PRINTFORMW 코이시가 %조사처리(CALLNAME:MASTER,"를")% %LOCALS:1%에서 발견하면 그녀는 말을 돌리고 있었다.
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;Atmosphere shifts when someone else enters ("As CHARACTER arrives, the atmosphere suddenly shifts...")
;他者介入でムード変化
;==================================================

@M_KOJO_MESKO_EVENT_K38_5(ARG,ARG:1)
;口上主はTARGET
;ARGに入ってきたキャラ（人数が膨大なので、自己把握自己責任で
;ARG is whatever characters arrived
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;さとりが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 49
		PRINTFORMW 「아, 저건 %KOISYN_MESKO("sister")%네」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;こころが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 57
		PRINTFORML 「아. 코코로짱이네」
		PRINTFORMW 「우와아... 이 가면엔 무슨 감정이지?」
		RETURN 1
	ENDIF
	;その他（キャラ指定なし
	IF TALENT:恋人
		PRINTFORML 「후후, 누가 이쪽을 보고 있는 거지」
		PRINTFORML 코이시가 팔로 %HIM_HER(MASTER)%를 감싸 안고 %HIM_HER(MASTER)%가 %KOISYN_MESKO("hug")%로부터 멀어지는 것을 허용하지 않는다.
		PRINTFORMW 「나랑 %조사처리(CALLNAME:MASTER,"는")% 플러팅 중이야, 마음껏 보여주자♪」
	ELSEIF TALENT:恋慕
		PRINTFORML 제삼자의 시선을 끌자 코이시는 소매를 잡아당겼다.
		PRINTFORMW 「싫어... 우리 혼자 있을 수 있는 곳으로 가자~」
	ELSEIF TALENT:思慕
		PRINTFORML 코이시는 다른 누군가의 시선을 감지하고 %조사처리(CALLNAME:MASTER,"를")% 눈에 띄지 않게 하려 한다.
		PRINTFORMW 「하지 마~……불운이야」
	ELSE
		PRINTFORMW 무의식적으로 코이시는 날아갔다.
	ENDIF
ENDIF
RETURN 1
;==================================================
;情事を目撃した
;==================================================

@M_KOJO_MESKO_EVENT_K38_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		IF TALENT:恋人
			PRINTFORML 「…………%SPLIT_G("살해:살인")%」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 코이시가 미소 지으며 칼을 꺼내는 것을 보고 서둘러 옷을 갈아입었다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「흥~ 재미있어?」
			PRINTFORMW 코이시의 표정은 평소와 같았지만, 그 한기가 %조사처리(CALLNAME:MASTER,"의")% 등줄기를 타고 흘렀다.
		ELSE
			PRINTFORML 「와아... %CALLNAME:MASTER%, 너무 잔인해...」
			PRINTFORML 그가 알아차리기 전에, 코이시는 이 상황을 지켜보고 있었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;負けじと参加（馴れ合い度:高）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF TALENT:恋人
			PRINTFORMW 「하지 마아, 하지 마!!!」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 나의 연인이야―!!」
			PRINTFORMW 코이시는 부풀고 %KOISYN_MESKO("blushed")% 뺨
		ELSEIF TALENT:恋慕
			PRINTFORML 「알았어 나도 %KOISYN_MESKO("think")% 너에게도 방해되어서 미안해~♪」
			PRINTFORMW 코이시가 합류한다.
		ELSE
			PRINTFORML 「좀 재미있어 보이네? 어떻게 느껴지는지 %KOISYN_MESKO("생각해봐")%ー」
			PRINTFORMW 코이시는 합류한다
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		IF TALENT:恋人
			PRINTFORML 「여보세요, 메리예요~」
			PRINTFORML 「제가 바로 뒤에 있어요~」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% %HIS_HER(MASTER)% 연인의 목소리를 듣고 돌아봤을 때, 그녀는 미소를 지으며 %HIM_HER(MASTER)%를 내려다본다.
			PRINTFORML 「저기 %CALLNAME:MASTER%, 나중에 꼭 해야 할 말이 있어ーーーー아주 중요한 거니까 준비해 둬, 알겠지?」
			PRINTFORMW 그런 말들을 입에서 내뱉은 후, 코이시는 터벅터벅 걸어갔다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「……아무것도―」
			PRINTFORMW 다소 우울한 코이시는 입에서 한 마디를 내뱉고 나가버린다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「와... 이건 어른이네!」
		ELSE
			PRINTFORML 「아, 걱정하지 마~」
			PRINTFORMDW 코이시는 전혀 걱정하는 기색 없이 멀어져 갔다. 
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
