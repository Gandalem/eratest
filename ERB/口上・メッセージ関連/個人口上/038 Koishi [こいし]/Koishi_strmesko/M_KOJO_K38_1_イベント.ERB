@M_KOJO_MESKO_EVENT_K38_12(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The character is awake and pissed off
	;追い出される（怒り）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「이건 꿈이 아니라고ー! 내 방에서 떨어져ー!」
			CASE 1
				PRINTFORMW 「가짜 조상이라니! %SPLIT_G("Murder:Kill")%……」
				PRINTFORML 코이시는 눈을 뜨지만 그녀의 %KOISYN_MESKO("시계")%는 지독하게 차갑고 공허했다.
				PRINTFORMW 가능한 한 빨리 방에서 나오는 편이 낫다.
			CASE 2
				PRINTFORMW 「꿈은…… 내가 가진 게 없더라도 방해하지 마……」
				PRINTFORML 그러자 코이시는 비명을 질렀다.
				PRINTFORMW 「나 가지고 재미있어 하지 마! 이건 창피하잖아!」
			CASE 3
				PRINTFORML 「……」
				PRINTFORMW 코이시 %KOISYN_MESKO("watch:es")% 끔찍하게 차갑고 공허한 눈으로 칼을 들고
			CASEELSE
				PRINTFORMW 「꺄아악- 당신은 내 조상이 아니야! 떨어져!」
		ENDSELECT
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;You successfully sneak in
	;寝床に侵入
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		IF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%…… 사랑…… 스……」
		ELSEIF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%…… 스…… 스……」
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%KOISHI_SHIZO_NOUN_MESKO()%…… %KOISHI_SHIZO_VERB_MESKO(RAND:3)%…… 수……」
				CASEELSE
					PRINTFORML 「수... 수...」
			ENDSELECT
		ENDIF
		SELECTCASE RAND:10
			CASE 0
				PRINTFORML 코이시는 %SPLIT_G("a pillow:her third eye")%을(를) 행복하게 껴안은 채 잠들었다.
			CASE 1
				PRINTFORML 코이시는 잠든 채 침대 위에서 무의식적으로 눈송이 천사를 만들고 있었다.
			CASE 2
				PRINTFORML 코이시는 무의식적으로 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 하지만 여전히 눈을 감고 자고 있다.
			CASEELSE
		ENDSELECT
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character is awake and has love, so they're happy to see you
	;寝床に侵入（相手が恋慕）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 코이시는 자신도 모르게 손을 %CALLNAME:MASTER%쪽으로 기어간다.
				PRINTFORMW %HIS_HER(MASTER)%의 온기를 느끼고 %KOISYN_MESKO("younggirl")% 행복하게 그녀의 %KOISYN_MESKO("green")% 눈을 뜬다.
			CASE 1
				PRINTFORML 코이시는 무의식적으로 얼굴을 %CALLNAME:MASTER%쪽으로 기어가며 자신의 입술로 %HIS_HER(MASTER)%의 입술을 더듬는다.
				PRINTFORML 그러고는 %조사처리(CALLNAME:MASTER,"에게")% 부드럽게 키스하고 그녀의 %KOISYN_MESKO("green")% 눈을 바라본다.
				CALL addEXP("Ｍ経験", MASTER, 1)
				CALL addEXP("Ｍ経験", 38, 1)
				PRINTFORMW
			CASE 2
				PRINTFORML 코이시는 무의식적으로 손을 %CALLNAME:MASTER%쪽으로 기어온다.
				PRINTFORML 그러고는 그녀의 손은 %HIS_HER(MASTER)%의 몸 위를 기어 올라가 부드럽게 자신에게 당긴다.
				PRINTFORMW 느리고 부드러운 포옹과 함께, %KOISYN_MESKO("younggirl")%는 눈을 뜨고 미소 짓는다.
			CASEELSE
				PRINTFORML 코이시는 자신도 모르게 %조사처리(CALLNAME:MASTER,"에게")% 기어가서 %HIM_HER(MASTER)%와 껴안기 시작한다.
				PRINTFORML 그녀의 포옹은 한쪽에서는 느리고 부드럽지만, 다른 쪽에서는 가능한 한 많이 만지려고 노력한다.
				PRINTFORMW 따뜻한 미소를 지으며 %KOISYN_MESKO("younggirl")%가 자신의 것으로 %조사처리(CALLNAME:MASTER,"의")% 코를 찌르고 %KOISYN_MESKO("green")% 눈을 뜬다.
		ENDSELECT
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%……좋은 아침이야~%UNICODE(0x2665) *1%」
			CASE 1
				PRINTFORMW 「%CALLNAME:MASTER%…… 네 용감함과 함께 깨어나다 %KOISYN_MESKO("good")%%UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORMW 「%CALLNAME:MASTER%……%UNICODE(0x2665) *1%」
		ENDSELECT
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character is awake, has love, and is exhausted, so they're happy to see you and go back to sleep
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORML 「음...」
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 기대어 그녀의 코를 %HIM_HER(MASTER)%에 비빈다.
				PRINTFORMW 「%CALLNAME:MASTER%…… 다시 만나서 기뻐……」
				PRINTFORMW 그녀는 눈을 감은 채 행복한 목소리로 중얼거렸다.
				PRINTFORMW 몇 분간의 애정 표현 끝에 코이시는 다시 잠이 들었다.
			CASE 1
				PRINTFORMW 코이시는 팔다리로 %조사처리(CALLNAME:MASTER,"를")% 감싸며 무의식적으로 %HIM_HER(MASTER)%와 애정을 나눈다.
				PRINTFORMW 「%CALLNAME:MASTER%~수…… 코이시는 정말 기뻐요~수…… 하지만 조금 더 자야 해요~수……」
				PRINTFORMW 그녀는 비슷하지만 따뜻한 목소리로 무의식 중에 중얼거리며 잠을 계속 잔다.
			CASEELSE
				PRINTFORMW 코이시는 눈을 뜨고 %KOISYN_MESKO("watch:es")%를 %조사처리(CALLNAME:MASTER,"에게")% 한다.
				PRINTFORML 얼굴을 알아본 그녀는 양손바닥으로 %조사처리(CALLNAME:MASTER,"의")% 뺨을 밀어붙인다.
				PRINTFORMW 「%CALLNAME:MASTER%…… 안녕……」
				PRINTFORML 그녀는 행복으로 가득 찬 눈빛으로 응시했다.
				PRINTFORMW 하지만 갑자기 다시 잠이 들었다.
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character is awake and throws you out
	;追い出される
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		PRINTFORML 「%SPLIT_G("에에엑")%?!!」
		PRINTFORMW 코이시는 자신의 방에 있는 %조사처리(CALLNAME:MASTER,"의")% 존재에 깜짝 놀란다.
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 하지만 그녀의 표정은 평소의 미소로 변했다.
				PRINTFORMW 「변태들은 내 방에서 나가야 해~♪」
				PRINTFORML 아무 일도 없었다는 듯, 코이시는 %조사처리(CALLNAME:MASTER,"를")% 방에서 밀어내고 문을 닫았다.
			CASE 1
				PRINTFORMW 「……너는 그런 것들 중 하나가 아니야」
				PRINTFORMW 코이시는 %KOISYN_MESKO("watch:es")% 에서 %CALLNAME:MASTER%끔찍하고 텅 빈 눈으로 칼을 들고
				PRINTFORMW 내부로부터 무언가가 %HIS_HER(MASTER)% 꿰뚫는다 %HIS_HER(MASTER)% 몸을 꿰뚫고 『도망쳐』라고 말했다
				PRINTFORML 도전하지 않고 %HIS_HER(MASTER)% 운 %CALLNAME:MASTER%우리에게서 그녀의 술을 급히 도망친다
			CASE 2
				PRINTFORMW 「……………이곳은 여자들의 사적인 영역이야, 변태 씨~♪」
				PRINTFORMW 노래를 흥얼거리며 코이시가 %조사처리(CALLNAME:MASTER,"를")% 자신의 방에서 내쫓았다.
			CASEELSE
				PRINTFORMW 「……………여보세요, 메리예요」
				PRINTFORML 코이시가 양손으로 베개를 움켜쥐고 바라본다 %CALLNAME:MASTER% 끔찍한 미소로
				PRINTFORMW 내부에서부터 무언가가 %HIS_HER(MASTER)% 꿰뚫는다 %HIS_HER(MASTER)% 몸을 꿰뚫고 『도망쳐』라고 말했다
				PRINTFORML 도전하지 않고 %HIS_HER(MASTER)% 운 %CALLNAME:MASTER% 우리에게서 그녀의 술을 급히 도망친다
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character is awake and exhausted, so they throw you out and go back to sleep
	;追い出される（衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「미안해, 쉬어야 할 것 같아-」
			CASE 1
				PRINTFORMW 「너무 피곤해……. 더 자야겠어-」
			CASE 2
				PRINTFORMW 「제발 좀 쉬게 해줘... 난 %KOISYN_MESKO("wish")% 플레이하고 싶지만 너무 피곤해」
			CASEELSE
				PRINTFORMW 「……………여보세요, 메리가 지금 너무 %SPLIT_G("부지럽다:피곤하다")% 해요ー 나중에 다시 와요ー」
		ENDSELECT
		PRINTFORML
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
