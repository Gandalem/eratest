;情事を見られた
;==================================================

@M_KOJO_MESKO_EVENT_K38_7(ARG,ARG:1)
;口上主はTARGET
;ARGに目撃者
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The character gets embarrassed and leaves
	;情事を見られた（目撃者の馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORML 「여보세요, 메리예요.」
		PRINTFORML 소녀들 사이에 섬뜩한 분위기가 감돈다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が負けじと参加（目撃者の馴れ合い度:高）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		PRINTFORML
		IF TALENT:恋人
			IF ARG == 36 ;orin
				PRINTFORML 「에헤...? 오린이 %KOISYN_MESKO("wish:es")% 합류하기를 원하는 거야?」
				PRINTFORMW 오린은 죽을 듯 조용한 분위기 속에서 방 안에 한동안 계속 정신을 못 차렸다.
				SIF TALENT:36:恋人
					CALL CHARA_TEXT(36,"「That's not fair! I like " + CALLNAME:MASTER + SPLIT_G("too: same as you!") + "!」","l")
				PRINTFORMW 그들의 욕망을 무의식적으로 이해하며 코이시가 %KOISYN_MESKO("slowly")% 오린에게 다가가 그녀를 껴안고 속삭인다
				PRINTFORML 「%KOISYN_MESKO("daijobu")%, 당신이 우리에게 합류할 수 있다면 %KOISYN_MESKO("wish")%~에 참여할 수 있다면」
				PRINTFORMW 저항할 수 없었던 오린은 코이시에게 키스하며 파티에 합류한다.
			ELSEIF ARG == 37 ;Okuu
				PRINTFORML 「에에엥? 오쿠우가 '%KOISYN_MESKO("wish:es")%' 합류한다고?」
				PRINTFORMW 오쿠우는 죽음처럼 고요한 분위기 속에서 잠시 동안 방 안에 멍하니 서 있었다.
				PRINTFORML 그들의 욕망을 무의식적으로 이해하며, 코이시는 '%KOISYN_MESKO("slowly")%' 오린에게 다가가 그녀를 꼭 안았다.
				PRINTFORMW 행복한 미소를 지으며 오쿠우도 그녀를 되안고 검은 날개로 둘을 감싼 뒤, 두 사람은 %조사처리(CALLNAME:MASTER,"에게")% 다가갔다.
			ELSEIF ARG == 57 ;Kokoro
				PRINTFORML 「코코로쨩?」
				PRINTFORML 코이시는 코코로를 의아하게 바라본다.
				PRINTFORMW 둘 다 낯선 표정이다: 그들의 뺨은 %KOISYN_MESKO("brushes")%, 그들은 혼란스러움 속에서 서로를 %KOISYN_MESKO("watch")% 바라본다.
				PRINTFORMW ……
				PRINTFORMW …
				SELECTCASE RAND:3
					CASE 0
						CALL CHARA_TEXT(57,"「" + CALLNAME:MASTER + SPLIT_G("…: is mine!") + "………」","l")
						PRINTFORMW 코코로가 %KOISYN_MESKO("thecouple")%를 바라보다가 홍조와 흥분한 가면으로 바꾸며 계속 그들에게 다가갔다.
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 내 거야!!! 절대로 %HIM_HER(MASTER)%를 너에게 주지 않을 거야!!」
						PRINTFORMW 두 사람 사이의 경쟁 분위기가 뜨거워진다. 장난기 어린 눈빛 속에서 코이시와 코코로가 %조사처리(CALLNAME:MASTER,"를")% 바라본다.
					CASEELSE
						PRINTFORMW 코코로(Kokoro)는 여전히 침묵한 채, 좌절하며 서로의 다리를 비비고 %KOISYN_MESKO("thecouple")%를 바라본다.
						PRINTFORMW 「에헤헤 참여해도 돼~ %UNICODE(0x2665) *1% 하지만 기억해, %조사처리(CALLNAME:MASTER,"는")% 내 거야!!!」
						PRINTFORMW 코이시(Koishi)는 볼을 부풀리며 세 번째 눈에서 나온 관들을 이용해 코코로를 그들에게 더 가깝게 밀어붙인다.
				ENDSELECT
			ELSEIF ARG == 49 ;Satori
				PRINTFORML 「%KOISYN_MESKO("sister")%?!!」
				PRINTFORMW 그녀의 여동자(sister)가 갑자기 나타난 후, 코이시는 두려움 때문에 경직된 상태에 빠졌다.
				PRINTFORMW 하지만 투덜거리는 대신 사토리는 마치 황홀경에 빠진 듯 침묵하며, 피해자를 향해 실행자처럼 천천히 앞으로 걸어왔다.
				PRINTFORML 「%KOISYN_MESKO("dame")%! %KOISYN_MESKO("dame")%! %KOISYN_MESKO("dame")%! %KOISYN_MESKO("dame")%!! %조사처리(CALLNAME:MASTER,"는")% 내 거야!! 난 %HIM_HER(MASTER)%를 사랑해」
				PRINTFORMW 코이시는 불평을 시작했지만, 그녀의 여동자는 계속 걸어왔고 사토리는 계속해서 그녀에게 다가섰다.
				PRINTFORMW 사토리는 의식을 잃은 자신의 여동자(%KOISYN_MESKO("watch:es")%)를 엄격하게 바라보며 눈빛으로 『나는 알고 있다』는 것을 보여주었다.
				PRINTFORMW 잠시 역겹다는 듯 %조사처리(CALLNAME:MASTER,"를")% 흘겨본 후, 사토리는 그녀의 어린 여동자에게 깊이 키스하며 자신의 의도를 솔직하게 답했다.
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 자매들의 %KOISYN_MESKO("thin")% 몸이 서로의 애무 속에서 뒤엉켰다.
						PRINTFORMW 그들의 움직임은 마치 같은 사람인 것처럼 대칭적이었다.
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 그들에 대해 생각하는 것을 눈치채고, 사토리는 고개를 살짝 숙여 코이시의 목덜미를 핥으며 장난스럽게 %KOISYN_MESKO("watch:ing")%에 %HIM_HER(MASTER)%한다.
						PRINTFORMW 코이시는 저항할 수 없었고, %KOISYN_MESKO("charming:ly")% 숨을 몰아쉬며 눈을 감은 채 자매에게 몸을 맡겼다.
						CALL CHARA_TEXT(49,"「이리 와, 이 변태야. 네가 유일하게 책임져야 할 거야」","w")
						PRINTFORMW 그 말들 이후, 사토리는 열정적인 포옹 속에서 %조사처리(CALLNAME:MASTER,"의")% 팔을 잡았다.
					CASE 1
						PRINTFORML 그들의 제3의 눈의 관들이 몸을 뒤엉켜 감금하지만 팔은 자유롭게 유지한다.
						PRINTFORML 묶인 존재에게서 오는 압력을 무시한 채, 자매들은 서로에게 %KOISYN_MESKO("집중:하고")% 있으며 키스와 애정으로 즐기고 있다.
						PRINTFORMW 그 트랜스 상태에서 %조사처리(CALLNAME:MASTER,"는")% 약간 어색함을 느끼며 자매들 사이의 즐거움을 %KOISYN_MESKO("지켜보고")% 있다.
						SIF RAND:15 == 0
							PRINTFORMW 그들의 제3안은 합쳐지기 시작하며 틈에서 소름 끼치는 검은 액체를 빨아들이지만, 그러더니 다시 변한다.
						PRINTFORMW 언니들은 %조사처리(CALLNAME:MASTER,"의")% 좌절을 눈치채고 손을 %HIM_HER(MASTER)%에게 가져가 함께 하자고 유혹한다.
					CASE 2
						PRINTFORMW 갑자기 코이시는 주도권을 잡고 자신의 사지를 이용해 언니를 붙잡는다, 그리고 그녀의 세 번째 눈에 있는 관들로.
						PRINTFORMW 사토리는 발버둥 치지만, 마치 %KOISYN_MESKO("wish:es")%할 의지가 없는 것처럼 온 힘을 다하지 못한다.
						PRINTFORMW 「에헤헤, %KOISYN_MESKO("sister")%는 자기 자신에게 정직하지 않네. 얼마나 더 자신의 욕망에게 거짓말을 하고 있는 거야?」
						CALL CHARA_TEXT(49, "「나, 너희 둘처럼 떨어지고 싶은 욕정이 없어……」","l")
						PRINTFORMW 사토리는 짜증스러운 표정으로 말하지만, 그녀의 숨은 깊어지고 볼은 %KOISYN_MESKO("blush:es")%했다.
						PRINTFORML 그녀의 말에서 만족을 얻지 못한 코이시는 마치 사토리의 능력이 없어도 읽을 수 있는 『Lair』라고 말하듯 그녀를 노려봤다.
						PRINTFORML 여동생의 %KOISYN_MESKO("thin")% 몸을 뒤에서 붙잡고, 코이시는 %조사처리(CALLNAME:MASTER,"에게")% 계속 %KOISYN_MESKO("sex")% 하라고 권유했다.
					CASEELSE
						PRINTFORML 사토리의 관들이 코이시를 휘감아 둘 뿐이다. 그들 모두 움직일 수 없게 되었다.
						PRINTFORMW 「%KOISYN_MESKO("sister")%?!! 왜 이러는 거야?!! 키야아아악!!!」
						PRINTFORMW 코이시는 %KOISYN_MESKO("charming")% 목소리로 소리를 지르며 깊게 숨을 들이마셨다.
						PRINTFORML 여동생은 발버둥 치지만, 도망치고 싶은 마음은 없다.
