					TCVAR:38:352 = 2
				ENDIF
				;			PRINTFORMW 「あん……んもぅ、今いい所だったのに……」
				;			PRINTFORML どこか不満げに呟きながら、こいしははだけた衣服を直すこともせず
				;			PRINTFORMW 余韻がまだ残っているのかよろよろとこちらに歩み寄ってきた
				;			PRINTFORML 「はい、今日はここまで」
				;			PRINTFORMW 「デリカシーのないヘンタイさんはあちらよ」
				GOTO FINISH
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTL 
				;初回,恋慕なしor合意まだ
				IF TCVAR:38:352 == 1 || TCVAR:38:352 == 2
					PRINTFORMW 「이쪽으로 돌아가는 길 말이야—」
					;恋慕＋合意
				ELSEIF TCVAR:38:352 == 3
					PRINTFORMW 「어라~? 떠나는 거야?」
					;久しぶり
				ELSEIF TCVAR:38:352 == 4
					PRINTFORMW 「………아, ……잠깐……이건」
				ENDIF
				GOTO FINISH
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTL 
				;初回,恋慕なしor合意まだ
