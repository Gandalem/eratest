@M_KOJO_MESKO_IRAI_4_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「언젠가 %KOISYN_MESKO("sister")%이랑 같이 요리하고 싶었어♪」
			CASE 2
				PRINTFORMW 「야 %CALLNAME:MASTER%, 나는 %KOISYN_MESKO("think")% 요리하는 법 가르쳐 줄 수 있어~♪」
			CASEELSE
				PRINTFORMW 「요리하는 것에 대해 잠시 배우고 싶습니다.」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「에헤헤~♪ 요리♪ 요리~♪ 기대돼요~♪」
			CASE 2
				PRINTFORMW 「야아~♪」
			CASEELSE
				PRINTFORMW 「정말? 에헤헤~, 너를 위해 너무 행복하다~♪」
		ENDSELECT
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		PRINTFORMW 「자, 내가 무슨 요리를 하고 있는지 보여주지 %SPLIT_G("that you will feel in love with:with a power of love")%!」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		SELECTCASE RAND:6
			CASE 1
				PRINTFORMW 「오, 이건 설탕이 아니라 소금이야」
			CASE 2
				PRINTFORMW 「에엥~? 내가 빠뜨린 게 있나…」
			CASE 3
				PRINTFORMW 「오... 프라이팬이 불타는 팬으로 변했어」
			CASE 4
				PRINTFORMW 「%SPLIT_G("sulfuric acid:soap:nitroglycerine:noosey")%을 추가한 것은 나쁜 생각이었다」
			CASE 5
				PRINTFORMW 「우웁… 나도 자르는 게 너무 즐거워서 말이야… 하지만 이걸 씹을 필요는 없어 %SPLIT_G("pulp:mess")%」
			CASEELSE
				PRINTFORML 「정신 나간 정원사처럼 채소를 써도 괜찮을까?」
				PRINTFORMDW ...꽤 위험해 보인다...
		ENDSELECT
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		;料理口上のコピペ
		IF ABL:38:料理技能 >= 3
			SELECTCASE RAND:4
				CASE 1
					PRINTFORML 「에헤헤♪ 다 됐어♪」
					PRINTFORML 「냠냠～♪」
				CASE 2
					PRINTFORML 「응 응, 성공했어」
					PRINTFORML 「어때? 맛이 좋아?」
				CASE 3
					PRINTFORML 「에헤헤♪ 최선을 다했지, 응?」
					PRINTFORML 「나를 칭찬해 줘, 칭찬해 줘~♪」
				CASEELSE
					PRINTFORML 「응, 다 됐어♪」
					PRINTFORML 「몰라, 몰라도 진전할 수 있잖아ー」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 1
					PRINTFORML 「피곤해~……」
					PRINTFORML 「요리하는 데 얼마나 일이 필요한지 날 믿어주지 않았잖아—……」
				CASE 2
					PRINTFORML 「N～？」
					PRINTFORML 「뭔가... 좋지 않다」
				CASE 3
					PRINTFORML 「응, 맞았어!」
					PRINTFORML 「나는 %SPLIT_G("dont remember:forgor:forgot")% 정확히 무엇인지!」
				CASEELSE
					PRINTFORML 「응? 뭔데?」
					PRINTFORML 「재미있는 걸 좀 추가해 보는 건 어때, %KOISYN_MESKO("creepy")%?」
			ENDSELECT
		ENDIF
		WAIT
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
