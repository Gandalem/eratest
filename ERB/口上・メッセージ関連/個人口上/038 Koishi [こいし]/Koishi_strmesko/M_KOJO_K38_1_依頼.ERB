;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_MESKO_IRAI_6_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「이봐, 이봐, 뭔가 부탁할 게 있는데―」
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%」은(는) 나 좀 기억해 줄 수 있어?
			CASEELSE
				PRINTFORMW 「음~ 말해봐, 뭔가 말해 줄 수 있어, %CALLNAME:MASTER%ー?」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					RETURN 0
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「호호, 그게... 당신이 말한 것이군요!」
					CASE 2
						PRINTFORMW 「알겠다, 이제 알겠어!」
					CASEELSE
						PRINTFORMW 「알겠어! 완벽해~♪」
				ENDSELECT
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「와아―……」
						PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"의")% 대답을 들으니 너무 혼란스러웠다.
					CASE 2
						PRINTFORMW 「……알겠다! ……내가 이해한 게 맞나?」
					CASEELSE
						PRINTFORMW 「음…… 모르겠어!」
				ENDSELECT
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「고마워요, %CALLNAME:MASTER%! 이거 완벽해요!」
			CASE 2
				PRINTFORMW 「고마워, %조사처리(CALLNAME:MASTER,"가")% 그렇게 많이 알고 있다니 놀랐어~♪」
			CASEELSE
				PRINTFORMW 「고마워요♪ %조사처리(CALLNAME:MASTER,"는")% 현명한 분이라 기뻐요♪」
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「음……미안해요, 이해가 안 가요……」
			CASE 2
				PRINTFORMW 「가르치는 것이 당신의 강점이 아닌 건가요 %CALLNAME:MASTER%?」
			CASEELSE
				PRINTFORMW 「이봐, 이봐, %CALLNAME:MASTER%, 네가 무슨 말을 하는지 모르는 것 같은데?」
		ENDSELECT
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
