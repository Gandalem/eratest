;==================================================
;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_MESKO_IRAI_12_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:38:恋慕 || TALENT:38:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「흠~, 나 지쳤어...」
				CASE 2
					PRINTFORMW 「부탁 하나 들어주실 수 있나요, %CALLNAME:MASTER%?」
				CASE 3
					PRINTFORMW 「저번에 너무 심하게 'bap'을 당했어—」
				CASEELSE
					PRINTFORMW 「흠~ 이거 좀 별로네~」
			ENDSELECT
		ELSE
			PRINTFORMW 「헤이 헤이, %CALLNAME:MASTER%, 나 좀 도와주러 와줄래?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:38:恋慕 || TALENT:38:思慕
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「부탁이야-」
				CASE 2
					PRINTFORMW 「에헤헤, 고마워」
				CASE 3
					PRINTFORMW 「플레 플레, 최선을 다해봐~♪」
				CASEELSE
					PRINTFORMW 「스스로 다치지 마-」
			ENDSELECT
		ELSE
			PRINTFORMW 「끔찍한 결말을 가진 이야기를 기다리고 있어, 난 그게 너무 사랑스러워~♪」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			RETURN 0
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			RETURN 0
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			IF TALENT:38:恋慕 || TALENT:38:思慕
				PRINTFORML 「뭐라고!? 왜, 왜~!!?」
				PRINTFORMW 「그리고~!! %조사처리(CALLNAME:MASTER,"는")% 바보야~!!」
			ELSE
				PRINTFORML 「하하하♪ 알겠어, 내가 가져갈게♪」
				PRINTFORMW 「너에 대해 불만은 없어. 네가 죽을 미래를 줄게 %SPLIT_G("here like a warrior:with honor")%」
				PRINTFORMW 「걱정 마, 내 키티가 네 시체를 데려다줄 테니. 너는 내 저택에서 영원히 살 수 있어!」
			ENDIF
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				PRINTFORMW 「여보게, 네 시체 위를 가로질러 미래로 들어가려 해♪」
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:38:恋慕 || TALENT:38:思慕
				PRINTFORML 「뭐라고!? 왜, 왜~!!?」
				PRINTFORMW 「그리고~!! %조사처리(CALLNAME:MASTER,"는")% 바보야~!!」
			ELSE
				PRINTFORML 「하하하♪ 알았어, 내가 가지지♪」
				PRINTFORMW 「너에게 반대할 건 없어, 네가 죽을 미래를 줄게 %SPLIT_G("here like a warrior:with honor")%」
				PRINTFORMW 「걱정 마, 내 키테(kitteh)가 네 시체를 데려갈 테니. 너는 영원히 내 저택에서 살 수 있어!」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		IF TALENT:38:恋慕 || TALENT:38:思慕
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 기대대로예요♪ 당신을 사랑해요%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「오옷! %CALLNAME:MASTER%정말 강하네~」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
