;==================================================
;依頼口上・一般依頼04：料理上手になりたい
;==================================================
@M_KOJO_MESKO_IRAI_4_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「I wanted to cook with %KOISYN_MESKO("sister")% sometime♪」
	CASE 2
		PRINTFORMW 「Hey, %CALLNAME:MASTER%, I %KOISYN_MESKO("think")% can you teach me how to cookー♪」
	CASEELSE
		PRINTFORMW 「I hope to learn about the cooking for a bit」
	ENDSELECT
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Ehehe～♪ Cooking♪ Cooking～♪ I am looking forward to it～♪」
	CASE 2
		PRINTFORMW 「Yayー♪」
	CASEELSE
		PRINTFORMW 「Really？ Ehehe～、I am so happy for you～♪」
	ENDSELECT
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
;【◆口上】
;【L ［あなた］は［彼女］と一緒に料理をした】
;【W ［料理名］を作ります】
;【▼そのまま下の口上へ】
	PRINTFORMW 「Come on, I'll show you what I am cooking %SPLIT_G("that you will feel in love with:with a power of love")%！」
	RETURN 1
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	SELECTCASE RAND:6
	CASE 1
		PRINTFORMW 「Oh, this is not a sugar, this is a salt」
	CASE 2
		PRINTFORMW 「Eeeh～？ Is there something what i forgot to putting in…」
	CASE 3
		PRINTFORMW 「Oh…The frying pan is turns into a flaming pan」
	CASE 4
		PRINTFORMW 「Adding some %SPLIT_G("sulfuric acid:soap:nitroglycerine:noosey")% was a bad idea」
	CASE 5
		PRINTFORMW 「Ooops… I am enjoyed with the cutting too much… But there is no need to chew this %SPLIT_G("pulp:mess")%」
	CASEELSE
		PRINTFORML 「Is it okay to cut vegetables like a possessed gardener？」
		PRINTFORMDW ……Looking pretty dangerous……
	ENDSELECT
	RETURN 1
CASE "成功報告時"
;報酬：\500
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
;【L できた料理は二人でいっしょに頂いた】
;【食事効果（料理採点）】
	;料理口上のコピペ
	IF ABL:38:料理技能 >= 3
		SELECTCASE RAND:4
		CASE 1
			PRINTFORML 「Ehehe♪ it'sーdone♪」
			PRINTFORML 「Yum yum～♪」
		CASE 2
			PRINTFORML 「Yep yep, it's worked」
			PRINTFORML 「How is it？ Is it tastes good？」
		CASE 3
			PRINTFORML 「Ehehe♪ I did my best, right？」
			PRINTFORML 「Praise me, praise me～♪」
		CASEELSE
			PRINTFORML 「Yep, it's finished♪」
			PRINTFORML 「I dunno you can make progress even if you don't know about itー」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
		CASE 1
			PRINTFORML 「I'am tired～……」
			PRINTFORML 「You didn't believe me how much work is needed to cookー……」
		CASE 2
			PRINTFORML 「N～？」
			PRINTFORML 「Something is… not so good」
		CASE 3
			PRINTFORML 「Yep, you got it！」
			PRINTFORML 「I'am %SPLIT_G("dont remember:forgor:forgot")% exactly what …… is！」
		CASEELSE
			PRINTFORML 「Huh？ Whot is it？」
			PRINTFORML 「Why don't you add something funny and %KOISYN_MESKO("creepy")% into it？」
		ENDSELECT
	ENDIF
	WAIT
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼05：特訓につきあって
;==================================================
@M_KOJO_MESKO_IRAI_5_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Hey Hey, 一Let's play a game, it's danmaku♪」
	CASE 2
		PRINTFORMW 「Hey %CALLNAME:MASTER%, I love you as a practice danmaku %SPLIT_G("target:target dummy:hitting bag")%ー♪」
	CASEELSE
		PRINTFORMW 「Hey %CALLNAME:MASTER%,一Why don't play danmaku together？」
	ENDSELECT
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Yayー♪ Let's fun and play♪」
	CASE 2
		PRINTFORMW 「That's why I'am talking about♪ I am not gonna go easy on youー♪」
	CASEELSE
		PRINTFORMW 「You asked for it♪ Don't worry, I won't hurt you♪」
	ENDSELECT
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
;【◆口上】
;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
;【▼そのまま下の口上へ】
	SELECTCASE RAND:6
	CASE 1
		PRINTFORMW 「He～re！ Unconscious『Rorschach in Danmaku』！！」
	CASE 2
