;==================================================
;依頼口上・各依頼で共通の口上
;==================================================
@M_KOJO_MESKO_IRAI_K38(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_MESKO_IRAI_%IRAI_NAME%_K38(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_MESKO_IRAI_{CHK_ID}_K38(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
;●依頼を持ちかけられる時
;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
;【◆口上】
;【依頼データ表示】
;【INPUT（受託するかY/N）】
	IF TALENT:38:恋慕
		PRINTFORMW 「Allo, I have a favor to ask you, %CALLNAME:MASTER%～」
	ELSEIF TALENT:38:思慕
		PRINTFORMW 「Allo, I am just have a favor to ask you, %CALLNAME:MASTER%ー」
	ELSE
		PRINTFORMW 「Allo, Can you do me a favorー？」
	ENDIF
CASE "依頼非受託時"
;●内容だけ見て受託しなかった時
;【L ［あなた］は丁重にお断りした】
;【◆口上】
;【W ［彼女］は残念そうな顔をしている】
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Eehー……Enough, too bad」
	CASE 2
		PRINTFORMW 「Really？ That's not so bad」
	CASEELSE
		PRINTFORMW 「Eeh？ Oke i will ask someone else then」
	ENDSELECT
CASE "依頼受託時"
;●依頼を受託した時
;【W ［あなた］は［彼女］の依頼を受けた】
;【◆口上】
	PRINTFORMW 「Hoorayー！ Please do your best！」
CASE "依頼確認時"
;●[366]で依頼内容を依頼人に確認した時
;【◆口上】
;【依頼データ表示】
;【INPUT（破棄するかY/N）】
	PRINTFORML 「So so so, I am asking you to do me a favorー……」
CASE "依頼破棄時"
;●受託した依頼を破棄する時
;【◆口上】
;【W 依頼を破棄しました。】
	SELECTCASE RAND:3
	CASE 1
		PRINTFORMW 「Eehー……Already, too bad」
	CASE 2
		PRINTFORMW 「Really？ That's not too bad」
	CASEELSE
		PRINTFORMW 「Really？ Oke i will ask someone else then」
	ENDSELECT
CASE "依頼実行直前"
;●[367]で依頼を実行する時、実行処理の前に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【◆口上】
;【実行時の地の文・ソース等】
;【▼下の口上に続く】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		
	ENDIF
CASE "依頼実行直後"
;●[367]で依頼を実行する時、実行処理の後に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【▲上の口上から続き】
;【◆口上】
;【達成時・CLIENT：▼下の口上に続く】
;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ENDIF
CASE "成功報告時"
;●報告時（成功）
;【依頼実行と報告が同時の時：▲上の口上から続き】
;【◆口上】
;【ソースの入手・アイテム等の報酬獲得】
	IF TALENT:38:恋慕
		PRINTFORMW 「Thanksー, %CALLNAME:MASTER%！ I am so happy♪」
	ELSEIF TALENT:38:思慕
		PRINTFORMW 「Yayー！ Thanks uー♪」
	ELSE
		PRINTFORMW 「You did it, tiger！」
	ENDIF
CASE "失敗報告時"
;○直接失敗報告は現在「06_誰か教えて！」のみ
;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
;【◆口上】
;○機嫌の変化や追加のペナルティ等は口上側で処理してください
	SELECTCASE RAND:3
	CASE 1
		;たまに忘れる
		PRINTFORMW 「EEh？ How did it happen……？」
		PRINTFORMW 「Did i asked when i was unconscious or something？」
	CASE 2
		PRINTFORMW 「Thenー%CALLNAME:MASTER%！ I asked for itー」
	CASEELSE
		PRINTFORMW 「Too baaaadー……%CALLNAME:MASTER% is %KOISYN_MESKO("baka")%」
	ENDSELECT
	TALENT:38:機嫌 = MIN(TALENT:38:機嫌, 0)
CASE "依頼報告不要"
;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
;○地の文はありません
;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
	
ENDSELECT
RETURN 1

;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================
@M_KOJO_MESKO_IRAI_1_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;まだ（住み込み以外で）自室ないけど
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORMW 「%KOISYN_MESKO("sister")% told me to clean this…… mess, this is a torture to do it alone, help meー」
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
	IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
	;先に掃除してしまっていた場合
	;【◆口上】
	;【W ［彼女］の部屋は十分にきれいだ】
	;【▼そのまま下の口上へ】
		PRINTFORMW 「Hey, is this looking unexpectedly beautiful…？」
		PRINTFORMW 「I dunno if I will did some cleaning…… %KOISYN_MESKO("reflex:ly")%」
		RETURN 1
	ELSE
	;一緒に掃除する場合
	;【◆口上】
	;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
	;【▼そのまま下の口上へ】
		PRINTFORMDL Koishi's room is rambling with stuff, Pets are rushing to help with large room cleaning
		PRINTW 
		SELECTCASE RAND:4
		CASE 1
			PRINTFORMW 「Oke, i will clean here and you will clean there～」
		CASE 2
			PRINTFORMW 「Allo, I am right behind you～」
			PRINTFORMW 「……Huh？ Can you stop playing and clean up？」
			PRINTFORMW 「Suーre」
		CASE 3
			PRINTFORMW 「Emmーmm, I am a messy person, is a being messy is a……kind of talent？」
			PRINTFORMW 「What？ You don't want to be gifted with this？」
		CASEELSE
			PRINTFORMW 「Let'sーsee, if there's a hope side……agh, I don't wanna to throw this one away tooー…」
			PRINTFORMW 「Wot？ I can't get rid of it all」
		ENDSELECT
		RETURN 1
	ENDIF
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	
	RETURN 0
CASE "成功報告時"
;報酬：低級素材
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	PRINTFORMW 「Yep Yep, %KOISYN_MESKO("dontworry")%！」
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT
;
