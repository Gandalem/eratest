;;依頼口上・一般依頼03：いっしょにあそぼ
;;※この依頼は[幼稚]を持っているキャラのみ発生します
;;==================================================
;@M_KOJO_MESKO_IRAI_3_K38(ROLE, SCENE, CLIENT_ID)
;#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
;#DIMS SCENE    ;セリフの表示されるタイミング
;#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;;--------------------------------------------------
;;RETURN 0 の部分は共通の口上が表示されます
;;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「헤이-헤이-, 일 %SPLIT_G("Let's play together:How about some 【hide and seek】:It's play time, are you wanna join")%?」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と遊んだ】
		;【▼そのまま下の口上へ】
		PRINTFORMDL 코이시는 %SPLIT_G("excited:satisfied")%해 보이고 행복하다
		PRINTW 
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「아하하하함 FーFUNー♪」
			CASE 2
				PRINTFORMW 「안녕, 너랑 놀아서 즐거워~♪」
			CASE 3
				PRINTFORMW 「캬아~ 괴물들이 나를 잡았어~♪」
			CASEELSE
				PRINTFORMW 「여기 있어! 아하하하하하, 잡았다~♪」
		ENDSELECT
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		PRINTFORMW 「후우-, %SPLIT_G("excited:satisfied")% 완전히 ♪」
		RETURN 1
	CASE "成功報告時"
		;報酬：好感度と信頼度のみ（機嫌が良くなる）
		;【▲上の口上から続き】
		;【◆口上】
		PRINTFORMW 「아- 그거였네 ♪ %SPLIT_G("fun:so funny:exciting:awesome:awesin")%♪」
		RETURN 1
		;CASE "失敗報告時"
		;
		;	RETURN 0
		;;CASE "依頼報告不要"
		;;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
