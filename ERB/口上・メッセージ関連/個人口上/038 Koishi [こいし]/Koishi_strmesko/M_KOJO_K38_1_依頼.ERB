			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して徹底的に部屋を掃除した】
			;【▼そのまま下の口上へ】
			PRINTFORMDL 코이시의 방은 물건들로 어수선했고, 반려동물들은 넓은 방 청소를 돕기 위해 달려왔다.
			PRINTW 
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「좋아, 내가 여기 치울게, 너는 저기 치워～」
				CASE 2
					PRINTFORMW 「야, 나 바로 뒤에 있어～」
					PRINTFORMW 「……어? 장난 그만두고 치워줄래?」
					PRINTFORMW 「응」
				CASE 3
					PRINTFORMW 「음... 나는 지저분한 사람인데, 지저분하다는 건 일종의 재능인가?」
					PRINTFORMW 「뭐라고? 이걸 가진 게 싫다는 거야?」
				CASEELSE
					PRINTFORMW 「한번 볼까, 희망의 면이 있는지……아아, 이걸 또 포기하고 싶지 않아―…」
					PRINTFORMW 「뭐라고? 전부 버릴 수가 없어」
			ENDSELECT
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\1500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		PRINTFORMW 「그래, 그래, 괜찮아!」
		PRINTFORMW 「이 난장판을 도와줘서 정말 고마워~♪」
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
