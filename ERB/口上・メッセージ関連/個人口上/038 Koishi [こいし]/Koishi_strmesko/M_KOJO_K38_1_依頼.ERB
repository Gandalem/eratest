@M_KOJO_MESKO_IRAI_5_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「헤이 헤이, 한 번 게임을 해보자고, 단마쿠야♪」
			CASE 2
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"야")%, 나는 연습용 단마쿠인 %SPLIT_G("target:target dummy:hitting bag")%로서 널 사랑해~♪」
			CASEELSE
				PRINTFORMW 「헤이 %CALLNAME:MASTER%, 같이 단마쿠 하지 않겠어?」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「야호~♪ 재미있게 놀자♪」
			CASE 2
				PRINTFORMW 「그렇기 때문에 말이야 ♪ 나는 너에게 자비를 베풀 생각은 없어ー♪」
			CASEELSE
				PRINTFORMW 「네가 원했잖아♪ 걱정 마, 난 너에게 상처 주지 않아♪」
		ENDSELECT
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
		;【▼そのまま下の口上へ】
		SELECTCASE RAND:6
			CASE 1
				PRINTFORMW 「그가~ 여기! 의식 없는 『단마쿠 속의 로르샤흐』!!」
			CASE 2
				PRINTFORMW 「이걸 피할 수 있어～? 응답 『요괴 폴리그래프』!!」
			CASE 3
				PRINTFORMW 「이거 재미있겠다~ 심연『무의식의 유전학』!」
			CASE 4
				PRINTFORMW 「나의 연모를 느껴보자~! 다시 타오르는 『사랑의 잔불』!」
			CASE 5
				PRINTFORMW 「%SPLIT_G("Aware about:Hear:Listen")% 속삭임들~!! 연출 『네 침대 옆에 선 모든 조상』!」
			CASEELSE
				PRINTFORMW 「간다! 『지하의 장미』!!」
		ENDSELECT
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「하아~ ♪ 재미있었어♪」
			CASE 2
				PRINTFORMW 「헤헤헤♪ 저랑 연습해 주셔서 감사해요, %CALLNAME:MASTER%♪」
			CASEELSE
				PRINTFORMW 「음~!! 나 잘했어 %SPLIT_G("workout:training")%~♪」
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
