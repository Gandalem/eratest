;依頼口上・一般依頼01：掃除を手伝って
;==================================================

@M_KOJO_MESKO_IRAI_1_K38(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;まだ（住み込み以外で）自室ないけど
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「%KOISYN_MESKO("sister")%이 이 지저분한 걸 치라고 했는데... 혼자 하긴 고문이야, 도와줘ー」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			PRINTFORMW 「헤이, 예상외로 아름답게 보이는데...?」
			PRINTFORMW 「청소를 좀 한 건지 모르겠어... %KOISYN_MESKO("reflex:ly")%」
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			PRINTFORMDL 코이시의 방은 물건들로 어수선했고, 반려동물들은 넓은 방 청소를 돕기 위해 달려왔다.
			PRINTW 
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 「좋아, 내가 여기 치우고 당신이 저기 청소해~」
				CASE 2
					PRINTFORMW 「야, 나 바로 뒤에 있어～」
					PRINTFORMW 「……어? 장난 그만두고 치워줄래?」
					PRINTFORMW 「응」
				CASE 3
					PRINTFORMW 「음... 나는 지저분한 사람인데, 지저분하다는 건 일종의 재능인가?」
					PRINTFORMW 「뭐라고? 이걸 가진 게 싫다는 거야?」
				CASEELSE
					PRINTFORMW 「한번 볼까, 희망의 면이 있는지……아아, 이걸 또 포기하고 싶지 않아―…」
					PRINTFORMW 「뭐라고? 전부 버릴 수가 없어」
			ENDSELECT
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		PRINTFORMW 「응 응, %KOISYN_MESKO("dontworry")%!」
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;
