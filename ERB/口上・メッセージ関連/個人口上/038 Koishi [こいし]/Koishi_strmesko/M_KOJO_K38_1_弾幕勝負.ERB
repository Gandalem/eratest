; Modular ERB: 個人口上/038 Koishi [こいし]/Koishi_strmesko/M_KOJO_K38_1_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESKO_MESSAGE_COM_K38_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_MESKO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
			PRINTFORMW 「단마쿠 배틀~? 오케이~......히크」
		ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
			PRINTFORMW 「여보세요, 저는 %SPLIT_G("murder you:kill you:stab your heart:dive my knife into your heart:slaughter you")%～♪ 할 거예요」
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「여보세요, 바로 뒤에 있어♪」
				CASE 2
					PRINTFORMW 「좋아, 그럼 네 파트너가 되어 줄게♪」
				CASEELSE
					PRINTFORMW 「나를 잡아봐~♪」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORML 「......뭐야?」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORML 「a……」
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「……아악!?」
					CASE 2
						PRINTFORML 「……어라?」
					CASEELSE
						PRINTFORML 「……이게 도대체 뭐야?」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「유피~!」
					CASE 2
						PRINTFORML 「햐아~!」
					CASEELSE
						PRINTFORML 「나~ 너 좋아해~~!」
				ENDSELECT
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「칫......!」
					CASE 2
						PRINTFORML 「아하하하!! 너무 아프다!!」
					CASEELSE
						PRINTFORML 「아하! 나는 너를 %KOISYN_MESKO("break")% 너를 조각내 줄게, 뭘 기다리니?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:10
					CASE 1
						PRINTFORML 「연모―그것을!」
					CASE 2
						PRINTFORML 「와아!」
					CASE 3
						PRINTFORML 「그들이 날 잡았어!?」
					CASE 4
						PRINTFORML 「휴!」
					CASE 5
						PRINTFORML 「아악!」
					CASE 6
						PRINTFORML 「나 보이지!?」
					CASE 7
						PRINTFORML 「~~~~와우!」
					CASE 8
						PRINTFORML 「갈 시간이야～!」
					CASE 9
						PRINTFORML 「네, 할게요!」
					CASEELSE
						PRINTFORML 「아야!?」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		SELECTCASE RAND:6
			CASE 1
				PRINTFORMW 「그가~ 여기! 의식 없는 『단마쿠 속의 로르샤흐』!!」
			CASE 2
				PRINTFORMW 「이걸 피할 수 있어～? 응답 『요괴 폴리그래프』!!」
			CASE 3
				PRINTFORMW 「이거 재미있겠다~ 심연『무의식의 유전학』!」
			CASE 4
				PRINTFORMW 「나의 연모를 느껴보자~! 다시 타오르는 『사랑의 잔불』!」
			CASE 5
				PRINTFORMW 「속삭임에 주의해라~ 이상 『모든 조상들이 네 침대 옆에 서 있다』!」
			CASEELSE
				PRINTFORMW 「간다! 『수더레니언 로즈』!!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORMW 「아아음 %SPLIT_G("i am so drunk:my head is dizzy:the world spins around")%~……」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORMW 「말도 안 돼—. 당신 같은 %KOISYN_MESKO("baka")%에게 패배하다니 믿을 수가 없어, %CALLNAME:MASTER%—」
			ELSE
				PRINTFORML 「아하하하하……」
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「나, 더는 못 하겠어~! 손가락 하나 움직일 수가 없어~…」
					CASE 2
						PRINTFORMW 「오호... 지고 말았어...」
					CASE 3
						PRINTFORMW 「나를 그렇게 완벽하게 본다니 믿을 수가 없어―」
					CASE 4
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 놀라울 정도로 강했다...」
					CASEELSE
						PRINTFORMW 「여기에 지금 바로 누워있다─...」
				ENDSELECT
			ENDIF
			;こいし勝利
		ELSE
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORMW 「하하하! 이상한 표정이네~♪」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORMW 「이런 식으로 죽을 때가 언제인지 시험해보고 싶어~♪」
			ELSE
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「야아~ 야아~! 정말 신난다」
					CASE 2
						PRINTFORMW 「그냥 더 싸우기만 하면 돼 %KOISYN_MESKO("reflex:ly")%」
					CASE 3
						PRINTFORMW 「응? 너무 쉽네」
					CASE 4
						PRINTFORMW 「이봐, 바로 뒤에 있어」
					CASEELSE
						PRINTFORMW 「해냈어-! 내가 이겼다!! %CALLNAME:MASTER%님, 아직 끝나지 않았어♪」
				ENDSELECT
				TALENT:38:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
