;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESKO_MESSAGE_COM_K38_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_MESKO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
			PRINTFORMW 「Danmaku fight～？ OOookay～……Hick」
		ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
			PRINTFORMW 「Allo, I will %SPLIT_G("murder you:kill you:stab your heart:dive my knife into your heart:slaughter you")%～♪」
		ELSE
			SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「Allo, I'm right behind you♪」
			CASE 2
				PRINTFORMW 「Okay, i will be your partner then♪」
			CASEELSE
				PRINTFORMW 「Try to catch me～♪」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;最後
		IF 相手残機 == 0
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORML 「……Whaat？」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORML 「a……」
			ELSE
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「……Aaah！？」
				CASE 2
					PRINTFORML 「……Huh？」
				CASEELSE
					PRINTFORML 「……What the hell is that？」
				ENDSELECT
			ENDIF
		ELSE
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Yuppi～！」
				CASE 2
					PRINTFORML 「hyaaah～！」
				CASEELSE
					PRINTFORML 「Iーlikeーu～～！」
				ENDSELECT
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Tsk……！」
				CASE 2
					PRINTFORML 「Ahahaha！！ That hurts so much！！」
				CASEELSE
					PRINTFORML 「Ah-ha！ I will %KOISYN_MESKO("break")% you into pieces, what are you waiting？」
				ENDSELECT
			ELSE
				SELECTCASE RAND:10
				CASE 1
					PRINTFORML 「Loveーit！」
				CASE 2
					PRINTFORML 「Waah！」
				CASE 3
					PRINTFORML 「They've got me！？」
				CASE 4
					PRINTFORML 「Phew！」
				CASE 5
					PRINTFORML 「Aaah！」
				CASE 6
					PRINTFORML 「you can see me！？」
				CASE 7
					PRINTFORML 「～～～～wow！」
				CASE 8
					PRINTFORML 「Time…to go～！」
				CASE 9
					PRINTFORML 「Yes, I'll do it！」
				CASEELSE
					PRINTFORML 「Ouch！？」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	SELECTCASE RAND:6
	CASE 1
		PRINTFORMW 「He～re！ Unconscious『Rorschach in Danmaku』！！」
	CASE 2
		PRINTFORMW 「Can you dodge this～？ Response『Youkai Polygraph』！！」
	CASE 3
		PRINTFORMW 「This one would be fun～ Depths『Genetics of the Unconscious』！」
	CASE 4
		PRINTFORMW 「Let's feel my love～！ Rekindled『The Embers of Love』！」
	CASE 5
		PRINTFORMW 「Be aware about the whispers～！ Representation『All Ancestors Standing Beside Your Bed』！」
	CASEELSE
		PRINTFORMW 「Here i go！ 『Sudterranean Rose』！！」
	ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		;あなた勝利
		IF 相手残機 == 0
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORMW 「AAahhm %SPLIT_G("i am so drunk:my head is dizzy:the world spins around")%～……」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORMW 「No wayー。I can't believe I am lost to such a %KOISYN_MESKO("baka")% like you, %CALLNAME:MASTER%ー」
			ELSE
				PRINTFORML 「Ahahahhaha……」
				SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「I, I can't do it anymore～！ I can't move a finger～…」
				CASE 2
					PRINTFORMW 「Ohーno, I've lost…」
				CASE 3
					PRINTFORMW 「I can't believe that you see me so perfectly―」
				CASE 4
					PRINTFORMW 「%CALLNAME:MASTER% was a surprisingly strong…」
				CASEELSE
					PRINTFORMW 「Allo, I am lying in the front of you right nowー……」
				ENDSELECT
			ENDIF
		;こいし勝利
		ELSE
			IF ALCOHOL_FACE(38) == "酔いどれ" || ALCOHOL_FACE(38) == "ぐでぐで"
				PRINTFORMW 「Hahaha！ Weird look～♪」
			ELSEIF TALENT:38:機嫌 == -1 || CFLAG:38:ブチギレ || MARK:38:反発刻印 >= 3
				PRINTFORMW 「I want to try and see when I die likeーthis♪」
			ELSE
				SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「Yayー Yayー！ I'm so excited」
				CASE 2
					PRINTFORMW 「You just have to fight more %KOISYN_MESKO("reflex:ly")%」
				CASE 3
					PRINTFORMW 「Huhー？ It's so easy」
				CASE 4
					PRINTFORMW 「Allo, I'm right behind you」
				CASEELSE
					PRINTFORMW 「I did itー！ I win！！ %CALLNAME:MASTER%, is not done yet♪」
				ENDSELECT
				TALENT:38:機嫌 = 1
			ENDIF
		ENDIF
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

