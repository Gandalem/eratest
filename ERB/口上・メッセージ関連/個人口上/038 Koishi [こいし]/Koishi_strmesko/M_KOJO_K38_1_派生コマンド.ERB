					PRINTFORMW 코이시는 그녀의 손바닥 사이에 있는, 너무 큰 %KOISYN_MESKO("penis")%, 그리고 핥는 %KOISYN_MESKO("penis")% 위에서 %KOISYN_MESKO("focused")%가 되기 위해 %KOISYN_MESKO("sandwich:es")% 그 %KOISYN_MESKO("sturdy")% %KOISYN_MESKO("penis")%에 집중한다.
				CASE 4
					PRINTFORML 「%KOISYN_MESKO("hora")%, 최선을 다할게, 최선을 다할게~ %UNICODE(0x2764)% 레로, 추루 %UNICODE(0x2764)% 추루... %UNICODE(0x2764)%」
					PRINTFORMW 그 %KOISYN_MESKO("younggirl")% 이었다 %KOISYN_MESKO("teasing:ly")% 구두로, 그녀는 %KOISYN_MESKO("sandwich:es")% 그 %KOISYN_MESKO("penis")% 그녀의 %KOISYN_MESKO("chest_describe")% 그리고 그것을 관리하면서 %KOISYN_MESKO("slowly")%그녀는 자신의 클리비지에서 드러난 귀두 위로 혀를 가져간다 %KOISYN_MESKO("lewd")% 틈
					PRINTFORML 「추루……츄우, 레로%UNICODE(0x2764)% 후후, 이건 %KOISYN_MESKO("twitch:ing")%…… 그러니 %KOISYN_MESKO("cute")%%UNICODE(0x2764)%」
					PRINTFORMW 느끼며 %KOISYN_MESKO("throb")% 의 %TINKO(PLAYER)% 그녀의 %KOISYN_MESKO("lewd")% 그녀의 「3」에서 「1」을 느끼며 코이시는 킥킥거리며 봉사를 재개했다
			ENDSELECT
		ELSEIF ABL:胸 >= 2
			PRINTFORML 「%KOISYN_MESKO("sandwich")% 이렇게 넣어봐……르로……으음 %UNICODE(0x2764)%」
			PRINTFORMW 코이시가 넣었다 %조사처리(CALLNAME:MASTER,"의")% %TINKO(PLAYER)% 그녀의 사이에 %KOISYN_MESKO("chest_describe")% 그리고 그녀의 얼굴에서 솟아난 귀두 위로 혀를 훑었다
		ELSE
			PRINTFORML 「나의 %KOISYN_MESKO("chest")%을 가로질러……음, 너무 많이 빼면 내 %KOISYN_MESKO("chest_describe")% 사이에 숨어버려」 
			PRINTFORML 「느으……이렇게……레로……츄우」
			PRINTFORMW 코이시는 익숙하지 않은 행동으로 애쓰며 자신의 %TINKO(PLAYER)%를 그녀의 %KOISYN_MESKO("chest_describe")% 사이 깊숙이 넣고 혀로 귀두 위를 핥았다
		ENDIF
	ELSE
		;ふにゅー
		IF ABL:胸 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「음……이렇게, 내 %KOISYN_MESKO("chest_describe")%과 사이에 넣고 움직여도 돼……%UNICODE(0x2764)%」
					PRINTFORMW 코이시 %KOISYN_MESKO("sandwich:ed")% %조사처리(CALLNAME:MASTER,"의")% %KOISYN_MESKO("penis")% 그녀 사이에서 %KOISYN_MESKO("chest_describe")% 그리고 움직이기 시작했다 %KOISYN_MESKO("slowly")% 그것들을 위아래로 움직이기 시작했다
					PRINTFORML 「그러자 %KOISYN_MESKO("itadakimasu")%♪ 하암...츄우%UNICODE(0x2764)% 레로%UNICODE(0x2764)%」
					PRINTFORMW %KOISYN_MESKO("younggirl")%은 자신의 %KOISYN_MESKO("chest")%으로 %KOISYN_MESKO("penis")%를 만지며 떨리는 귀두 위를 사탕을 핥듯이 혀로 쓸었다.
				CASE 1
					PRINTFORML 「%KOISYN_MESKO("sandwich:ing")% 이런 식으로…… 리로, 냠ㅁ……츄우%UNICODE(0x2764)%」
					PRINTFORMW 코이시가 그녀의 %KOISYN_MESKO("chest_describe")% 함께 모아 넣고 %조사처리(CALLNAME:MASTER,"의")% %TINKO(PLAYER)% 그들 사이에 넣고 그녀는 %KOISYN_MESKO("grind:s")% 그녀의 %KOISYN_MESKO("chest")% 위아래로 움직이며 귀두를 혀로 쓸었다
					PRINTFORML 「Nnn, Nnnn……츄우%UNICODE(0x2764)% 이것은 나에게 느끼게 할지도 모른다 %KOISYN_MESKO("good")% 도%UNICODE(0x2764)%」
					PRINTFORMW 코이시 %KOISYN_MESKO("mumble:s")% 활기차게 때로는 %KOISYN_MESKO("rub:ing")% 뒤쪽을 %SPLIT_G("shaft:pole")% 그녀의 젖꼭지로
				CASE 2
					PRINTFORML 「헤로, 추루……음, 추우……아후」
					PRINTFORML 코이시는 %CALLNAME:MASTER%'의 %KOISYN_MESKO("penis")%를 자신의 %KOISYN_MESKO("chest_descrbe")% 사이에 넣고 위아래로 움직이며 혀끝으로 귀두를 핥았다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 코이시의 서비스에서 오는 쾌감에 만족했다. 왜곡된 정복감을 느끼는 것이 그녀를 더욱 부추었고, 그녀의 움직임을 더욱 %KOISYN_MESKO("intense")%하게 만들었다.
				CASE 3
					PRINTFORML 「음... 츄루우... 츄우... 음프, 와아후%UNICODE(0x2764)%」
					PRINTFORML 「...%KOISYN_MESKO("tasty")%%UNICODE(0x2764)% 아무, 추루우... 레로%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥고 있으며, 그녀는 자신의 %KOISYN_MESKO("chest_describe")%으로 %KOISYN_MESKO("sandwich:ing")% 위에서 %KOISYN_MESKO("focused")%를 하고 있다.
				CASE 4
					PRINTFORML 「%KOISYN_MESKO("hora")%, 최선을 다할게, 최선을 다할게～%UNICODE(0x2764)% 레로, 추루%UNICODE(0x2764)% 추루……%UNICODE(0x2764)%」
					PRINTFORMW 그 %KOISYN_MESKO("younggirl")% %KOISYN_MESKO("teasing:ly")% 말을 하면서 그녀를 당기다 %KOISYN_MESKO("chest_describe")% 함께 당기면서  %KOISYN_MESKO("sandwich:ing")% 그 %TINKO(PLAYER)% 그들 사이에서 혀로 끝을 핥으며
					PRINTFORML 「추루……츄우, 레로%UNICODE(0x2764)% 후후, 그것은 %KOISYN_MESKO("twitch:ing")%…… 그래서 %KOISYN_MESKO("cute")%%UNICODE(0x2764)%」
					PRINTFORMW 코이시는 다시 그녀의 %KOISYN_MESKO("hj")% 그녀가 웃으며 지켜보면서 %HIS_HER(MASTER)%의 %KOISYN_MESKO("penis")% 그것을 %KOISYN_MESKO("throb:ing")% 즐거움과 함께
			ENDSELECT
		ELSEIF ABL:胸 >= 2
			PRINTFORML 「음, 초... 그리고 이렇게... 르로」
			PRINTFORMW 코이시는 %KOISYN_MESKO("chest_describe")%을 사용해 %TINKO(PLAYER)%를 처리했고, 그녀는 자신의 혀를 귀두 위에서 움직였다.
		ELSE
			PRINTFORML 「음, 초... 음. 그건 ~일 수 있어 %SPLIT_G("difficult:tricky")%」
			PRINTFORMW 코이시는 얻으려고 애썼다 %조사처리(CALLNAME:MASTER,"의")% %KOISYN_MESKO("penis")% 그녀의 사이에 %KOISYN_MESKO("chest_describe")% 그리고는 두려움에 떨며 그것 위로 혀를 갖다 댔다
		ENDIF
		;それ以外
	ENDIF
ENDIF
