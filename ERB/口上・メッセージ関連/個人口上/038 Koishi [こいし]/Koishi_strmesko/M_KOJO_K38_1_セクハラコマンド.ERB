;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW %CALLNAME:MASTER% %KOISYN_MESKO("rub:s")% 시간이 멈춘 동안 코이시의 아래쪽 복숭아 볼
