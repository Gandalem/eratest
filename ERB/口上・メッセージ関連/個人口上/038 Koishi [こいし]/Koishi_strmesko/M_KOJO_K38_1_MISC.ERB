			LOCALS = %SPLIT_G("Is " + CALLNAME:MASTER + " knows about:Whot are u thinking about:Is " + CALLNAME:MASTER + " loves:How about:Let's talk about:I dunno about:the:Whot am I thinking about:What is")% %TOPIC_SUBJECT%?
		CASE 1
			SELECTCASE RAND:3
				CASE 0
					LOCALS = %SPLIT_G("Maybe:Perhabs")% %TOPIC_SUBJECT% %SPLIT_G("is so: most likely to be so:is not:is really:is very:are so:luuks like so")% %KOISHI_SHIZO_NOUN_MESKO()% %SPLIT_G("but:but also:but i dont think so:it isn't:this is wrong")%, %TOPIC_SUBJECT% %SPLIT_G("is so: most likely to be so:is not:is really:is very:are so:luuks like so")% %KOISHI_SHIZO_OBJECTIVE_MESKO()%
				CASE 1
					LOCALS = %TOPIC_SUBJECT% %SPLIT_G("is so: most likely to be so:is not:is really:is very:are so:luuks like so")% %KOISHI_SHIZO_OBJECTIVE_MESKO()%, %KOISHI_SHIZO_NOUN_MESKO()% %KOISHI_SHIZO_NOUN_MESKO()% and %KOISHI_SHIZO_NOUN_MESKO()%
				CASEELSE
					LOCALS = %TOPIC_SUBJECT% %SPLIT_G("is so: most likely to be so:is not:is really:is very:are so:luuks like so")% %KOISHI_SHIZO_OBJECTIVE_MESKO()%
			ENDSELECT
		CASE 2
			SELECTCASE RAND:3
				CASE 1
					LOCALS = I %KOISYN_MESKO("think")% %TOPIC_SUBJECT% is %KOISHI_SHIZO_VERB_MESKO(0)% %KOISHI_SHIZO_NOUN_MESKO()%, %TOPIC_SUBJECT% %SPLIT_G("did nothing wrong:is so " + KOISHI_SHIZO_OBJECTIVE_MESKO() + " :is doing righ:is doing wrong:because " + TOPIC_SUBJECT + " is " + KOISHI_SHIZO_OBJECTIVE_MESKO())%
				CASEELSE
					LOCALS = I %KOISYN_MESKO("think")% %TOPIC_SUBJECT% %SPLIT_G("are not like:are simiiar to:are same as:are not similar to")% %KOISHI_SHIZO_NOUN_MESKO()% %SPLIT_G("do u think so:right:isn't it:do u agreed")%?
			ENDSELECT
		CASEELSE
			LOCALS = "WRONG CHIZO"
	ENDSELECT
	PRINTFORML 「%LOCALS%」
NEXT
PRINTFORMW

@KOISHI_SHIZO_OBJECTIVE_MESKO()
#FUNCTIONS
RETURNF KOISYN_MESKO(SPLIT_G("good:skillful:developed:absolutely:forbidden:impossible:onverge:succumbed:fragile:hollow:little:creepy:sturdy:voluptuous:baka"))

@KOISHI_SHIZO_NOUN_MESKO()
#FUNCTIONS
RETURNF SPLIT_G(KOISYN_MESKO(SPLIT_G("random_flower:meal:bowels:baby:mind:flurry:agony:fear")) + ":youkai:chupacabra:nigger:kappa:chirikadama:fairy:human:tengu:vampire:my sister:your mom:war crimes:politics:namanicha:shrine maiden:morya shrine:underworld:rabbits:habits:ice cream:mayo")

@KOISHI_SHIZO_VERB_MESKO(verbtime) 
#FUNCTIONS
#DIMS LINER
#DIMS LINERS
#DIM verbtime ;0 continuous, 1 simple, 2 past
LINER = %SPLIT_G(KOISYN_MESKO(SPLIT_G("mark:respond:stir:sandwich")) + "eat:plap:slap:drink:play:fly:dicapicate:walk:grow:stab:bleed:mince:bounce:shred:talk:fight:cook:clean:depress:read:kill:murder:shoot:teach:collect:reflect:bean:suck:interest:beat:snap:sleep:daydream:watch:jump:drill:respect")%
SELECTCASE verbtime
	CASE 0
		LINERS = %LINER%:ing
	CASE 1
		LINERS = %LINER%:s
	CASE 2
		LINERS = %LINER%:ed
ENDSELECT
RETURNF  KOISHI_PRONOUNCE_CHECK_MESKO(LINERS, 0, 0, LINER)

@KOISHI_PRONOUNCE_CHECK_MESKO(ARGS:0, ARG:0, nThirdPerson, LOCALS:0)
#DIM nThirdPerson
#FUNCTIONS
LOCALS:0 = %SPLIT_G(LOCALS:0)%

IF SPLIT_CHECK(ARGS:0, "ing")
	LOCALS:0 '= VERBT_CONTINUOUS(LOCALS:0, nThirdPerson)
ELSEIF (SPLIT_CHECK(ARGS:0, "s") || SPLIT_CHECK(ARGS:0, "es")) && ARG:0 <= 1
	LOCALS:0 '= VERBT_SIMPLE(LOCALS:0, nThirdPerson)
ELSEIF SPLIT_CHECK(ARGS:0, "ed") && ARG:0 <= 1
	LOCALS:0 '= VERBT_PAST(LOCALS:0)
;pluralize
ELSEIF ARG:0 > 1
	LOCALS:0 '= PLNOUN(LOCALS:0, 2)
ENDIF

RETURNF LOCALS:0