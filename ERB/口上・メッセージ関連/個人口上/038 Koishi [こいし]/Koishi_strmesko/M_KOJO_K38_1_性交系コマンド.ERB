				PRINTFORMW 코이시는 자신의 %KOISYN_MESKO("rub:s")% 위에서 %KOISYN_MESKO("chest_describe")%를 즐기며 그녀의 내부에 있는 %KOISYN_MESKO("sturdy:ness")%를 받아들인다 %KOISYN_MESKO("vagina")%
				PRINTFORML 「아아아……아아아NNnn%UNICODE(0x2764)% Nnnn%UNICODE(0x2764)% 나는 %KOISYN_MESKO("think")%, 할 거야 %KOISYN_MESKO("melt")%%UNICODE(0x2764)%」
				PRINTFORMW 너무 웃어서 %KOISYN_MESKO("lewd:ly")%, %KOISYN_MESKO("younggirl")%는 %KOISYN_MESKO("left")%하고, 그녀의 %KOISYN_MESKO("thin")% 몸을 %KOISYN_MESKO("passion")%에게 내어준다 %CALLNAME:MASTER%
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「난~나, ……아후~수……%UNICODE(0x2764)% 더 %KOISYN_MESKO("hug:s")%?%UNICODE(0x2764)%」
				PRINTFORML 코이시는 손을 얹는다 %조사처리(CALLNAME:MASTER,"의")% 팔을 잡고 있는 %KOISYN_MESKO("thin")% 뒤에서 그녀의 몸을 감싸 안고 %KOISYN_MESKO("thrust:ing")% %HIS_HER(MASTER)% %KOISYN_MESKO("penis")% 그녀의 안쪽 깊숙이 %KOISYN_MESKO("vagina")%
				PRINTFORML 열로부터 온 따뜻함을 찾으며 %KOISYN_MESKO("younggirl")% ~에게 기대다 %CALLNAME:MASTER%그리고 받아들인다 %TINKO(PLAYER)% 그녀에게 너무 큰 %KOISYN_MESKO("think")% %KOISYN_MESKO("womb")%
				PRINTFORMW 그 %KOISYN_MESKO("younggirl")% 뜨겁고 %KOISYN_MESKO("charming")% 숨을 내쉬며 %CALLNAME:MASTER%시작했다 %KOISYN_MESKO("rub")% 코이시의 몸을 천천히 이완시키기 위해
			CASE 1
				PRINTFORML 「푸아아……응음…%KOISYN_MESKO("bottom")%, %KOISYN_MESKO("hot")%……와아, 아아……」
				PRINTFORML 느끼면서 %KOISYN_MESKO("penis")% 밀어붙이는 %KOISYN_MESKO("bottom")%, 코이시는 깊게 숨을 쉬며 %KOISYN_MESKO("take a little break:calm her down")%
				PRINTFORMW 그녀가 뒤에서 %KOISYN_MESKO("hug:ed")% 뒤에서부터 시작하며 골반을 흔들기 시작했고 %KOISYN_MESKO("grind")% 그녀의 골반을 %KOISYN_MESKO("slowly")% 그리고 어색하게, 하나의 %KOISYN_MESKO("lewd")% 관절에서 삐걱거리는 소리가 울렸다
			CASE 2
				PRINTFORML 「아아암 nnnnn~수%UNICODE(0x2764)% …나를 때려줘 %SPLIT_G("in the back:from behind")%…%UNICODE(0x2764)% 키유우…nnnnn%UNICODE(0x2764)%」
				PRINTFORML ~을 가지고 %KOISYN_MESKO("charming")% %KOISYN_MESKO("pant:s")%, 코이시가 받아들인다 %KOISYN_MESKO("sturdy")% %KOISYN_MESKO("penis")% ~하는 %KOISYN_MESKO("thrust:s")% ~까지 %KOISYN_MESKO("bottom")%
				PRINTFORMW ~할 때 %CALLNAME:MASTER% %KOISYN_MESKO("grind:ed")% %HIS_HER(MASTER)% 엉덩이가 풀기 위해 %KOISYN_MESKO("younggirl:s")% 단단함의 %KOISYN_MESKO("walls")% 그녀의 %KOISYN_MESKO("vagina")%코이시의 목소리가 슬픔으로 새어 나오고 그녀는 자신의 몸을 기대며 %KOISYN_MESKO("thin")% 몸을 기대어 휴식하는 %CALLNAME:MASTER%따뜻함
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
