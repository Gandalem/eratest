				PRINTFORML 「에헤헤. 나는 %KOISYN_MESKO("want")% 실제로 확인해 보다~♪」
				PRINTFORMW 
			CASE 6
				;薄い高い本
				PRINTFORML 「！？！？！？！？」
				PRINTFORML 코이시는 %KOISYN_MESKO("watch:es")% ~에게 %조사처리(CALLNAME:MASTER,"의")% 발치에서 잠시 동안 조용히 그 얼굴을 한 채로 %KOISYN_MESKO("blush:ed")% 얼굴
				PRINTFORMW 「변태...!」
			CASE 7
				;保健体育
				PRINTFORML 「……！？」
				PRINTFORMW 
			CASE 8
				;カーマスートラ
				PRINTFORML 「이건 ~처럼 보인다... 어떻게 저렇게 서로 껴안고 있는 거지?」
				PRINTFORMW 코이시는 묻는다 %CALLNAME:MASTER%그리고 그녀의 호기심을 가리려고 손바닥으로 얼굴을 가리며 %KOISYN_MESKO("blush:ed")% 손바닥으로 가린 얼굴
			CASEELSE
				PRINTFORMW 「에헤... 보기만 해도 너무 지루해」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%. 너는 %SPLIT_G("this reads:to read this")%를 어떻게 아느냐?」
				PRINTFORMW 
			CASE 0
