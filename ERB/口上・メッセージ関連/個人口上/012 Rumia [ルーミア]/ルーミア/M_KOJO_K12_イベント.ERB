;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K12_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 1 || ARG == 2)
		IF TCVAR:今日会ったか
		ELSEIF CFLAG:好感度 < 1
			PRINTFORMW 「음. 어디서 만난 적 있는 것 같은데? 뭐 됐어.」
			;バレンタイン
			;ELSEIF DAY:2 == 4 && DAY:3 == 14
			;CALL SAIJITU_K12
		ELSE
			PRINTFORML 「앗, %CALLNAME:MASTER%!」
			SELECTCASE RAND:5
				CASE 1
					PRINTFORML 「음식 가져다준 거야~?」
					SIF DISHNAME == ""
						PRINTFORML 「아니구나. 대체 뭐야」
					PRINTFORMW 
				CASE 2
					PRINTFORMW 「마침 심심했거든. 놀아줘.」
				CASE 3
					PRINTFORMW 「%CALLNAME:MASTER%아, 시간 되면 같이 놀러 갈래?」
				CASE 4
					PRINTFORMW 「배고파~ 뭔가 만들어줘~」
				CASEELSE
					PRINTFORMW 「무슨 일이야? 무슨 용건 있어?」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 1
	;-------------------------------------------------
	;↑と統合
	;IF LOCAL:1 && ARG == 2
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋慕  || TALENT:恋人
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%도 있었구나. 같이 들어가도 돼?」
					PRINTFORMW 「자, 꽉 채워서 넣어봐 ♪」
				CASEELSE
					PRINTFORML 「%CALLNAME:MASTER%아, 나도 목욕할래~」
					PRINTFORMW 「…뜨거워! 물, 물~…」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 「음... %CALLNAME:MASTER%라면 괜찮겠지.」
					PRINTFORMW 「너무 빤히 보지 마~?」
				CASEELSE
					PRINTFORML 「선객이라니... 뭐야, %CALLNAME:MASTER%인가」
					PRINTFORMW 「나도 들어갈게. 괜찮지?」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋慕  || TALENT:恋人
			SELECTCASE RAND:2
				CASE 1
					PRINTFORML 「후우... 상쾌하다-」
					PRINTFORMW 「혹시 같이 들어가고 싶었어? 헤헤」
				CASEELSE
					PRINTFORML 「%CALLNAME:MASTER%아, 나는 이제 올라갈게.」
					PRINTFORMW 「같이 들어오지 않을래? 싫어~ 흐물흐물해질 거야.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「아, %CALLNAME:MASTER%인가. 이제 올라갈 테니, 저쪽을 보고 있어」
				CASEELSE
					PRINTFORML 「응? %CALLNAME:MASTER%도 목욕이야?」
					PRINTFORMW 「같이 안 할래? 야, 변태 같네」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
