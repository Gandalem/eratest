;7,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K12_7
CALL M_KOJO_MESSAGE_SCOM_K12_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K12_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
	;	PRINTFORMW 「」
	;	GOTO _SIKYUUKOU
	;	RETURN 1
	;ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;射精1ターン後。射精するときの口上はNOWEX:MASTER:射精
	ELSEIF TCVAR:102 && !NOWEX:MASTER:射精
		IF (TALENT:恋慕 || TALENT:恋人) && CFLAG:生解禁 > 0
			SELECTCASE RAND:5
				CASE 1
					CALL HPH_PRINT("「거기로 자궁을 막고 있네... 그렇게 임신시키고 싶은 거야? 흐음 HPH」","L")
				CASE 2
					CALL HPH_PRINT("「지금 박히면 안 돼, HPH. 자궁이 기뻐하고 있잖아... HPH」","L")
				CASE 3
					CALL HPH_PRINT("「이렇게 안쪽만 계속 공격당하면... 아기가 갖고 싶어지잖아 HPH」","L")
				CASE 4
					CALL HPH_PRINT(@"「에헤헤-HPH %CALLNAME:MASTER%맛있어. 한 그릇 더 줘 HPH」","L")
				CASEELSE
					CALL HPH_PRINT("「세에키 HPH, 배 깊숙이 밀려와 버릴 것 같아... HPH」","L")
			ENDSELECT
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 루미아의 질은 %CALLNAME:MASTER%부터 더욱 정액을 짜내려고 페니스에 달라붙어 있다...
				CASEELSE
					PRINTFORMW 루미아의 자궁구는 %조사처리(CALLNAME:MASTER,"의")% 정액을 빨아들이려 귀두를 물고 있다...
			ENDSELECT
		ELSEIF CFLAG:既成事実 >= 1
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「방금 쌌는데... 너무 활발하잖아.」
				CASE 2
					PRINTFORMW 「아까 싼 게 넘쳐흘러오고 있어... 엄청 야하네♪」
				CASE 3
					PRINTFORMW 「야아, 안에서 웅얼거리고 있어...」
				CASE 4
					PRINTFORMW 「일단 빼지 않으면, 정액이 안으로 들어가 버릴 거야」
				CASEELSE
					PRINTFORMW 「아직 더 못 해? 변태네...」
			ENDSELECT
		ENDIF
		RETURN 1
	ELSEIF TALENT:恋慕 || TALENT:恋人
		IF EXP:子宮口開発経験 >= 50
			SELECTCASE RAND:5
				CASE 1
					CALL HPH_PRINT(@"「거기 막 만지는 거 좋아해 HPH 더 해줘 HPH」","L")
				CASE 2
					CALL HPH_PRINT(@"「안쪽 입으로 %조사처리(CALLNAME:MASTER,"의")% 거시기 먹어버렸어 HPH 이대로 잔뜩 내줘 HPH」","L")
				CASE 3
					IF TALENT:妊娠
						CALL HPH_PRINT("「자궁이 열려버릴 거야... 아기한테 정액이 묻어버리잖아... HPH」","L")
					ELSE
						CALL HPH_PRINT("「자궁이 열려버릴 것 같아... 거시기 들어갈 거야... HPH」","L")
					ENDIF
				CASE 4
					CALL HPH_PRINT("「마음껏 밀어 넣어줘 HPH 자궁 깊은 곳까지 도달할 수 있을 정도로... HPH」","L")
				CASEELSE
					CALL HPH_PRINT(@"「보지 전부 %조사처리(CALLNAME:MASTER,"의")% 것이 되어버렸어 HPH」","L")
					CALL HPH_PRINT("「가장 깊은 곳에서 섹스하는 거, 기분 좋지 HPH」","L")
			ENDSELECT
			SELECTCASE RAND:4
				CASE 1
					PRINTFORMW 루미아는 쾌락에 물든 얼굴로 %조사처리(CALLNAME:MASTER,"의")% 박아넣기를 받아들이고 있다...
				CASE 2
					PRINTFORMW 루미아는 달콤한 소리를 내며 %조사처리(CALLNAME:MASTER,"의")% 페니스에게 유린당하고 있다...
				CASE 3
					PRINTFORMW 루미아의 질 속살은 가장 깊숙한 곳을 찔릴 때마다 %조사처리(CALLNAME:MASTER,"의")% 페니스를 부드럽게 조여온다...
				CASEELSE
					PRINTFORMW 루미아의 자궁구가 페니스를 환영하듯 부드럽게 감싸온다...
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"를")% 전부 받아낼 수 있어서 기뻐...♪」
				CASE 2
					PRINTFORML 「좀 딱하네. %조사처리(CALLNAME:MASTER,"는")% 안 아파?」
				CASE 3
					PRINTFORML 「%CALLNAME:MASTER%엄청 크네. 배꼽까지 와 있네」
				CASE 4
					PRINTFORML 「%CALLNAME:MASTER%라서 배가 빵빵해. 꼭 임신한 것 같아...♪」
				CASEELSE
					PRINTFORML 「가장 안쪽은 아직 아프지만, 조금 짜릿한 느낌이야...」
			ENDSELECT
			PRINTFORMW 루미아의 질벽은 박혀버린 페니스를 꽉 조이고 있다...
		ENDIF
		RETURN 1
	ELSEIF CFLAG:既成事実 >= 1
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「배가 아파...」
			CASE 2
				PRINTFORMW 「더 이상 들어가지 않는다고...」
			CASE 3
				PRINTFORMW 「아, 거기 아파-」
			CASE 4
				PRINTFORMW 「아아... 깊숙이 들어와 버렸어...」
			CASEELSE
				PRINTFORMW 「아기의 방, 부서져 버려……!」
		ENDSELECT
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;$_SIKYUUKOU
