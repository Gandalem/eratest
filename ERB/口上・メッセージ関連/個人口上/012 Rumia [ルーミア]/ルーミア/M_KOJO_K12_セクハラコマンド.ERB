LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:TARGET:添い寝中 && !TFLAG:193 == 99
		IF TALENT:恋慕 || TALENT:恋人
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「헤헤. 이걸로 좋은 꿈을 꿀 수 있을 것 같아…」
				CASE 2
					CALL HPH_PRINT("「잘 자는 뽀뽀, 고마워~ 나도 답례로 뽀뽀 HPH」","W")
				CASEELSE
					PRINTFORMW 「잘 자... 내일도 잔뜩 놀아줘...」
			ENDSELECT
		ELSE
		ENDIF
	ELSEIF TFLAG:193 == 99
		IF TCVAR:発情
			CALL HPH_PRINT(@"(지금은 안 돼... 참아야 해 %조사처리(CALLNAME:MASTER,"의")% 걸 먹어버릴 것 같아... HPH)","W")
		ELSEIF TALENT:恋慕 || TALENT:恋人
			PRINTFORMW 「방금 고기 먹었으니까... 양치하고 나서 하면 안 돼?」
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%... 뭔가 얼굴 무서워?」
				CASE 2
					PRINTFORMW 「갑자기 얼굴 가까이 오지 마. 깜짝 놀라잖아.」
				CASEELSE
					PRINTFORMW 「키스? 그건 좀, 싫어...」
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕 || TALENT:恋人
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 키스 좋아~♪ 더 하자. 응?」
			CASE 2
				PRINTFORMW 「내 일을 더 좋아하게 되도록 잔뜩 키스해 줄게-」
			CASE 3
				CALL HPH_PRINT("「오늘도 잔뜩 어른들의 키스를 가르쳐 줘... HPH」","W")
			CASE 4
				CALL HPH_PRINT(@"「닿지 않아~!! %CALLNAME:MASTER%참아줘... 쪽 HPH」","W")
			CASEELSE
				CALL HPH_PRINT("「ふわ아... 머리가 몽롱해져... 중독될 것 같아 HPH」","W")
		ENDSELECT
	ELSEIF TALENT:思慕 || ABL:欲望 >= 5
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「달콤한 맛이 나네... 혹시 몰래 과자 먹은 거야~? 부럽다~」
			CASE 2
				PRINTFORMW 「역시 부끄럽네... 눈 감고 있어도 돼?」
			CASE 3
				PRINTFORMW 「얼굴이 달아오르네... 물 좀 줘. 차가운 걸로.」
			CASEELSE
				PRINTFORMW 「얼굴 보이면 부끄러운데. 어둠 속에 숨기면 안 돼?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 1
				PRINTFORMW 「이런 건 좋아하는 사람이랑 하는 거 아니야?」
			CASE 2
				PRINTFORMW 「별로 기분 안 좋아. 그만하지 않을래?」
			CASE 3
				PRINTFORMW 「왠지 간질간질해서 기분이 나빠-」
			CASE 4
				PRINTFORMW 「끈적하게 만지는 거 싫어~ 다른 애랑 하면 되잖아~」
			CASEELSE
				PRINTFORMW 「……! 갑자기 뭐 하는 거야-」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
