@M_KOJO_MESSAGE_PALAMCNG_A_K12_5(ARG)
;-------------------------------------------------
;パイズリ
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF TALENT:恋慕 || TALENT:恋人
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「에헤헤. 가슴 속이 질척해졌어」
			CASE 2
				CALL HPH_PRINT("「아직 움직이지 마. 끝까지 짜 줄게... HPH」","W")
			CASE 3
				CALL HPH_PRINT("「어린 애의 가슴으로 자극받았어? 크큭HPH」","W")
			CASEELSE
				CALL HPH_PRINT("「가슴이 정액투성... 흥분해 버려... HPH」","W")
		ENDSELECT
	ELSEIF CFLAG:既成事実 >= 1
