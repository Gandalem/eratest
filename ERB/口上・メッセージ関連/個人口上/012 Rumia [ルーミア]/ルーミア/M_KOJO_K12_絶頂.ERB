; Modular ERB: 個人口上/012 Rumia [ルーミア]/ルーミア/M_KOJO_K12_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K12
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF TCVAR:発情
		IF TALENT:恋慕
			IF ABL:Ｂ感覚 >= 10
				SELECTCASE RAND:4
					CASE 1
						CALL HPH_PRINT("「응... HPH, 가슴 나오는 거... 기분 좋아아 HPH」","W")
					CASE 2
						CALL HPH_PRINT("「부비부비... 하고 HPH 에헤헤 HPH」","W")
					CASE 3
						CALL HPH_PRINT("「더 짜줘... HPH 자... 아직 더 나올 테니까아 HPH」","W")
					CASEELSE
						CALL HPH_PRINT("「기분 좋아... HPH 더 내줘... HPH」","W")
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT("「야안... 가슴이 멈추질 않아... HPH」","W")
					CASE 2
						CALL HPH_PRINT("「하아... HPH 가슴이 나와버렸다...」","W")
					CASEELSE
						CALL HPH_PRINT("「또, 흘러버려...!! HPH」","W")
				ENDSELECT
			ENDIF
			;ELSEIF TALENT:思慕
		ELSE
			SELECTCASE RAND:3
				CASE 1
					CALL HPH_PRINT("「싫어... 멈추지 않아... HPH」","W")
				CASE 2
					CALL HPH_PRINT("「가슴이 간질거려서... 응, 음음! HPH」","W")
				CASEELSE
					CALL HPH_PRINT("「보지 마... 부끄럽단 말이야... HPH」","W")
			ENDSELECT
		ENDIF
	ELSE
		IF TALENT:恋慕
			IF ABL:Ｂ感覚 >= 10
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「응우... 가슴 내는 거, 좀 기분 좋을지도...」
					CASE 2
						PRINTFORMW 「에헤헤... 이렇게 나와버렸네. 마셔볼래?」
					CASE 3
						PRINTFORMW 「언제든 엄마가 될 수 있어~ 후훗♪」
					CASE 4
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 아기, 갖고 싶네~?」
					CASEELSE
						PRINTFORMW 「아직 단단한 느낌이 들어. 좀 더 짜줬으면 좋겠어~」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「조금 괴롭지만, %조사처리(CALLNAME:MASTER,"가")% 해준다면…」
					CASE 2
						PRINTFORMW 「익숙해지면 자연스럽게 나올 수 있는 걸까…」
					CASEELSE
						PRINTFORMW 「어때? 흥분했어~? 후후...♪」
				ENDSELECT
			ENDIF
			;ELSEIF TALENT:思慕
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「이제... 빨리 그만둬 주지 않을래...」
				CASE 2
					PRINTFORMW 「가슴은 아프고 옷도 더러워지고... 좋은 일 없네.」
				CASEELSE
					PRINTFORMW 「이상한 눈으로 보지 마...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	;口
	IF TCVAR:2 == 4
		IF TCVAR:発情
			IF TALENT:恋慕
				IF ABL:Ｃ感覚 >= 10
					SELECTCASE RAND:5
						CASE 1
							CALL HPH_PRINT("「내 정액 좋아해? 좋잖아 HPH 지금 줄 테니까... 받아줘 HPH」","W")
						CASE 2
							CALL HPH_PRINT(@"「%조사처리(CALLNAME:MASTER,"의")% 입 좋아아 HPH 더 내고 싶어...HPH」","W")
						CASE 3
							CALL HPH_PRINT("「빨아줘! 세에키 빨아줘 HPH 아... 벌써 나올 것 같아 HPH」","W")
						CASE 4
							CALL HPH_PRINT("「입에 정액을 싸줄게 HPH 좋지? 마셔! 전부 마셔 HPH」","W")
						CASEELSE
							CALL HPH_PRINT(@"「한 번 더 빨아줘, HPH. %CALLNAME:MASTER%도 또 원하잖아?」","W")
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							CALL HPH_PRINT(@"「もう 한계야...! %조사처리(CALLNAME:MASTER,"의")% 입으로 가게 해줘엣 HPH」","W")
						CASE 2
							CALL HPH_PRINT("「끝을 핥아지면... 벌써 갈 것 같아아 HPH」","W")
						CASEELSE
							CALL HPH_PRINT("「아... 정액을 꿀꺽 삼키고 있어, 후후」","W")
					ENDSELECT
				ENDIF
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT("「거시기 기분 좋아서... 참을 수가 없어... HPH」","W")
					CASE 2
						CALL HPH_PRINT("「이대로는 싸버릴 것 같아...? 약을 강제로 먹게 될 거야... HPH」","W")
					CASEELSE
						CALL HPH_PRINT("「기분 좋아... 멈출 수 없어아 HPH」","W")
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						CALL HPH_PRINT("「벌써 나올 것 같으니까, 입에서 빼줘 HPH」","W")
					CASE 2
						CALL HPH_PRINT("「지금은 방금 갔으니까... 핥지 마요... HPH」","W")
					CASEELSE
						CALL HPH_PRINT("「흐으... 참을 수 없었어, 흐읍」","W")
				ENDSELECT
			ENDIF
		ELSE
			;IF TALENT:恋慕
			;	SELECTCASE RAND:5
			;		CASE 1
			;			PRINTFORMW 「」
			;		CASE 2
			;			PRINTFORMW 「」
			;		CASE 3
			;			PRINTFORMW 「」
			;		CASE 4
			;			PRINTFORMW 「」
			;		CASEELSE
			;			PRINTFORMW 「」
			;	ENDSELECT
			IF TALENT:思慕
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「맛없지? 무리하지 않아도 괜찮아~」
					CASE 2
						PRINTFORMW 「말해버렸어... 미안해」
					CASEELSE
						PRINTFORMW 「하아... 거시기, 굉장했다...」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「그거, 맛없지 않아어?」
					CASE 2
						PRINTFORMW 「사정까지 시키다니... 악취미네」
					CASEELSE
						PRINTFORMW 「정액을 마시다니... 변태」
				ENDSELECT
			ENDIF
		ENDIF
	ELSEIF TCVAR:2 == 1
		;PRINTFORMW 膣
	ELSE
		;PRINTFORMW 他
	ENDIF
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
