;素股
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF (TALENT:恋慕 || TALENT:恋人) && CFLAG:生解禁 == 2 && TALENT:処女 == 0 && TALENT:妊娠 == 0
		PRINTFORML 
