						CALL HPH_PRINT("「거시기랑 정액이 폭주하고 있어 HPH, 정말 기분 좋아... HPH」","L")
					CASE 4
						CALL HPH_PRINT("「질 안이 정액으로 가득해 HPH, 흘러버리겠어…」","L")
					CASEELSE
						CALL HPH_PRINT("「전부 짜 줄게 HPH 많이 사정해 줘...HPH」","L")
				ENDSELECT
				PRINTFORMW 루미아는 만족스러운 듯 배를 쓰다듬고 있다...
			ELSE
				$_NAKADASI12
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「남자가 갈 때의 얼굴이란, 재미있네~」
						PRINTFORMW 「한 번 더 해 줄까?」
					CASE 2
						PRINTFORMW 「속에 싸는 건 별로 안 좋아. 뒷정리가 귀찮으니까.」
					CASEELSE
						PRINTFORMW 「어차피 임신 안 할 거니까, 마음껏 내도 돼.」
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
		RETURN 1
	ENDIF
	RETURN 1
ENDIF
RETURN 1
