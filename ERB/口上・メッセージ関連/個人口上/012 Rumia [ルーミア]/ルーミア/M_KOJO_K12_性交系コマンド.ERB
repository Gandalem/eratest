						PRINTFORMW 「방금 쌌는데... 너무 활발하잖아.」
					CASE 2
						PRINTFORMW 「아까 싼 게 넘쳐흘러오고 있어... 엄청 야하네♪」
					CASE 3
						PRINTFORMW 「야아, 안에서 웅얼거리고 있어...」
					CASE 4
						PRINTFORMW 「일단 빼지 않으면, 정액이 안으로 들어가 버릴 거야」
					CASEELSE
						PRINTFORMW 「아직 더 못 해? 변태네...」
				ENDSELECT
			ENDIF
		ELSE
			IF TALENT:恋慕 || TALENT:恋人
				SELECTCASE RAND:5
					CASE 1
						CALL HPH_PRINT(@"「%CALLNAME:MASTER%HPH %CALLNAME:MASTER%HPH 더 박고 싶어 HPH」","L")
					CASE 2
						CALL HPH_PRINT(@"「%조사처리(CALLNAME:MASTER,"의")% 거시기 HPH 기분 좋잖아 HPH」","L")
					CASE 3
						CALL HPH_PRINT("「꽉 안아줘, HPH 함께 기분 좋아지자~ HPH」","L")
					CASE 4
						CALL HPH_PRINT("「거시기 조여 줄게 HPH 헤헤, 좋은 반응이야... HPH」","L")
					CASEELSE
						CALL HPH_PRINT("「그렇게 상냥하게 대해지면... 머릿속이 녹아버릴 것 같아 HPH」","L")
				ENDSELECT
				PRINTFORMW 루미아의 질살은 %CALLNAME:MASTER%에 빨아대고 놓으려 하지 않는다...
			ELSEIF CFLAG:既成事実 >= 1
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「아직 계속할 거야... 야, 소리 내버릴 것 같아...」
					CASE 2
						PRINTFORMW 「좀 격렬하잖아... 부드럽게 해줘...」
					CASE 3
						PRINTFORMW 「안에서 퍼지고 있는 것 같아. 좀 좋을지도...♪」
					CASE 4
						PRINTFORMW 「어때? 나한테 기분 좋아?」
					CASEELSE
						PRINTFORMW 「야안, 좀 쉬게 해줘어」
				ENDSELECT
			ENDIF
		ENDIF
	ELSEIF PALAM:潤滑 < 3000
		PRINTFORMW 「아직 일러. 좀 더 적셔주고 나서 해야지... 아파, 아파! 무리하지 마!」
	ELSEIF TALENT:恋慕 || TALENT:恋人
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 안겨서 섹스하는 건, 정말 행복해...」
			CASE 2
				PRINTFORML 무릎 위에서 허리를 흔드는 루미아의 가슴을 뒤쪽에서 주무르다...
				IF TALENT:バストサイズ >= 0
					CALL HPH_PRINT(@"「가슴도 거기도 전부 %CALLNAME:MASTER%것이니까, 마음대로 해도 좋아 HPH」","W")
				ELSE
					PRINTFORMW 「이렇게 작은 가슴을 열심히 주물러서... 야한걸~♪」
				ENDIF
			CASEELSE
				PRINTFORMW 「이렇게 허리를 비틀었더니... 후훗, 효과 만점이야...♪」
		ENDSELECT
		RETURN 1
	ELSEIF CFLAG:既成事実 >= 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「더 기대도 돼? 등 따뜻해서 좋아.」
			CASE 2
				PRINTFORML 무릎 위에 앉은 루미아의 가슴을 뒤에서 주물렀다...
				IF TALENT:バストサイズ >= 0
					PRINTFORMW 「찌르면서 가슴 만지는 거... 반칙이잖아, 야!」
				ELSE
					PRINTFORMW 「야- 안 돼, 가슴 만지면 안 돼-」
				ENDIF
			CASEELSE
				PRINTFORMW 「떨어지지 않게, 제대로 지탱해 줘.」
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
$_HAIMEN
RETURN 1
