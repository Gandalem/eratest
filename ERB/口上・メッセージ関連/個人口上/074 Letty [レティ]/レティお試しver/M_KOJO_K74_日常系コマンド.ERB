@M_KOJO_SUCCESS_COM_K74_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K74_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K74_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K74_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	IF TALENT:恋人
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"와")% 함께 있으면 어떤 계절이든 기운이 나네」
			PRINTFORMW 레티는 기쁜 듯 기대왔다.
			PRINTFORMW 「무겁다고? 음, 여자애한테 그런 소리 할까」
		ELSEIF LOCAL == 1
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 이야기는 언제 들어도 재미있네」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 팔을 잡고, 즐거워 보인다.
			PRINTFORMW 「더, 이야기해요♪」
		ELSE
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 있는 곳이라면, 여름의 더위라도 괜찮아」
		ENDIF
	ELSEIF TALENT:恋慕
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「최근에는 여러 계절을 만끽하는 일이 많았어.」
			PRINTFORMW 「그것도 다, %CALLNAME:MASTER%덕분일까?」
		ELSEIF LOCAL == 1
			PRINTFORMW 「쾌활한 봄에, 음식의 가을. 이렇게 경험해보니 둘 다 포기하기 어렵네.」
			PRINTFORMW 「그래도 역시 여름은 싫어...」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%랑은 자꾸 이야기하다가 시간 가는 줄 모르겠네」
			PRINTFORMW 레티는 쓴웃음을 짓는다.
			PRINTFORMW 「하지만, 즐거우니까 괜찮아」
		ENDIF
	ELSEIF TALENT:思慕
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「역시 제일 좋아하는 건 겨울이야. 눈이 쌓인 날은 들떠버려.」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 좋아하는 계절은 뭐야?」
		ELSEIF LOCAL == 1
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 의외로 멋있지 않아? 말 안 해줄래?」
			PRINTFORMW 「음... 기분 탓은 아닌 것 같은데.」
		ELSE
			PRINTFORMW 「저번에 쿠로시로를 만났어. 겨울이었으면 계속 따라다녔을 거야, 저 사람」
			PRINTFORMW  레티는 시무룩해하고 있다.
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")%, 겨울이 길어서 나를 따라오지 않는 거지? 그런 사람이 아니잖아♪」
		ENDIF
	ELSEIF CFLAG:好感度 > 1000
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「하늘을 나는 메이드에게 만나면 조심해야 한다」
			PRINTFORMW 「눈 속에 묻힐 거야」
			PRINTFORMW 「……에? 나만?」
		ELSEIF LOCAL == 1
			PRINTFORMW 「겨울 외에는 집에 박혀 있거나, 햇빛이 들지 않는 곳에 있어」
			PRINTFORMW 「여름 같은 건 최악이야. 쓰러질 것 같아」
		ELSE
			PRINTFORMW 「홍백에 겨울 이외의 때라면 엄청난 대형 사건을 겪었어.」
			PRINTFORMW 「겨울이 빨리 온다니, 참 황당한 소리네.」
		ENDIF
	ELSEIF CFLAG:好感度 > 500
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「겨울이 계속된다고 생각할 때가 있지.」
			PRINTFORMW 「하지만 그건 자연의 이치에서 벗어난 일이라는 것도 알고 있어.」
			PRINTFORMW 「그러니까 겨울이 아닌 날은 방에서 이불을 덮자!」
		ELSEIF LOCAL == 1
			PRINTFORMW 「겨울이 되면 가끔 나를 찾아오는 사람이 있단다.」
			PRINTFORMW 「겨울이 싫다면, 집에서 가만히 있으면 되는걸.」
			PRINTFORMW 「그런데 너는 대체 무슨 일로 나를 보러 온 거니?」
		ELSE
			PRINTFORMW 「나는 당신과 겨울을 즐기고 싶어」
		ENDIF
	ELSEIF CFLAG:好感度 > 300
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「음, 인간은 솔직히 취향이 아니네」
			PRINTFORMW 「겨울을 즐기고 있을 뿐이야, 퇴치! 라고 할 수 없어.」
		ELSEIF LOCAL == 1
			PRINTFORMW 「가장 최악의 경험을 한 건, 봄맞이 축제야」
			PRINTFORMW 기억해낸 것인지, 초췌해 보인다.
			PRINTFORMW 「주머니 취급을 당하고, 정신 차려보니 목까지 눈에 파묻혀 있었어」
		ELSE
			PRINTFORMW 「추운 게 싫은 건 알겠어」
			PRINTFORMW 「내가 여름을 못 견디는 거랑 감각적으로 같지 않아?」
			PRINTFORMW 「하지만 겨울이랑 나를 동등하게 취급하는 건, 이해가 안 가네」
		ENDIF
	ELSEIF CFLAG:好感度 > 100
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「……봄여름가을겨울 겨울」
			PRINTFORMW 「언젠가 여름여름여름겨울겨울이 된다고 생각하면 무섭네」
		ELSEIF LOCAL == 1
			PRINTFORMW 「요괴라고 해도 다양하네」
			PRINTFORMW 「나는 겨울을 즐기고 싶을 뿐이야」
		ELSE
			PRINTFORMW 「햇빛이 들지 않는 생활」
			PRINTFORMW 「사이코~」
		ENDIF
	ELSE
		LOCAL = RAND:3
		IF LOCAL == 0
			PRINTFORMW 「말하기 좋아.」
			PRINTFORMW  
		ELSEIF LOCAL == 1
			PRINTFORMW 「수다 떨다가 지치지 않아?」
		ELSE
			PRINTFORMW 「그렇구나.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K74_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K74_301
CALL M_KOJO_MESSAGE_COM_K74_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K74_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;小傘のお茶の口上いいよね。
	IF TALENT:恋人
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「차를 내려준 거네. 어머, 이건 보리차네」
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「차가운 보리차는 최고지. 사계절 내내 언제든 즐길 수 있는 거니까.」
						PRINTFORMW 「물론, %조사처리(CALLNAME:MASTER,"랑")% 같이 마실 수 있다면 더욱 특별하겠지.」
					CASE 1
						PRINTFORML 「따뜻하네. 안심이 돼……」
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 같이 마시기 때문일까?」
					CASE 2
						PRINTFORML 「뜨거워. 후후, 녹아버릴 것 같아……」
						PRINTFORML 「농담이야. 진심으로 받아들이지 마」
						PRINTFORML 「하지만 나는 %조사처리(CALLNAME:MASTER,"랑")% 함께라면 녹아도 괜찮아」
						PRINTFORMDW 레티는 차를 마시며 쿠스쿠스 웃고 있다.
					CASE 3
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 마시는 보리차는 맛있어. 왜일까?」
						PRINTFORML 「애정을 담아 넣어주기 때문일까?」
						PRINTFORMDL 보리차에 애정 같은 건 없는 것 같다.
						PRINTFORML 「……이런 건, 기분도 중요한 거란다」
						PRINTFORMDW 시무룩한 레티에게 이마를 톡 맞았다.
				ENDSELECT
			CASE 1
				PRINTFORMW 「이것은, 녹차네」
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「역시, 일본의 마음이라 좋지 않아?」
						PRINTFORML 「뭐야. 내가 '와(和)'를 말하는 게 이상한 걸까?」
						PRINTFORML 「외래어라고 바보 취급하면 이렇게 되어버리는 거야♪」
						PRINTFORMDW 레티는 기쁜 듯 안겨왔다.
					CASE 1
						PRINTFORML 「음……♪ 후후♪」
						PRINTFORMDL 어느새 옆에 있던 레티에게 입을 막혔다.
						CALL HPH_PRINT,@" 「흐읍... 흐으음... ...쪽!흐읍」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 입안으로 레티가 마시던 차가 흘러들어갔다.
						PRINTFORMDL 쌉싸름한 차여야 할 곳이 어쩐지 달게 느껴졌다.
						CALL HPH_PRINT,@" 「푸하앗 HPH 잘 먹었습니다 HPH」","W"
						CALL MUTUAL_KISS
					CASE 2
						PRINTFORML 「따뜻한 녹차라 마음이 놓인다」
						PRINTFORMDL 그렇게 말하자, 레티가 다가왔다.
						PRINTFORML 「후후, %조사처리(CALLNAME:MASTER,"와")% 함께 차를 마시는 이 시간」
						PRINTFORMDL 그녀는 후 하고 숨을 내쉬며 기쁜 듯 미소 지었다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 레티와 여유로운 시간을 보냈다.
					CASE 3
						PRINTFORML 「음~ 좋은 깊은 맛이네」
						PRINTFORML 「역시, %CALLNAME:MASTER%에 넣어 마시는 녹차는 특별해. 혹시 비결이라도 있는 걸까」
						PRINTFORMDW 차 잎부터 우리는 방법까지 공들인 이야기를 하자, 그녀는 진지하게 들어주었다.
				ENDSELECT
			CASE 2
				PRINTFORML 「어머, 좋은 향기. 홍차를 넣어 준 걸까?」
				PRINTFORML 「나는 잘 모르지만, 맛있게 마실 수 있을까」
				PRINTFORMDW 레티에게 맛없는 경험을 시키지 않겠다고 하자, 그녀는 미소 지었다.
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「헤에, 이건 메이드에게서 물려받은 거구나」
						PRINTFORML 「괜찮아? 그, 하늘을 나는 메이드는 조금 장난쳤다가 몰아붙이니까」
						PRINTFORML 「친절하게 대해준 거야...? 헤에...」
						PRINTFORMDW 레티는 약간 불쾌해 보인다.
					CASE 1
						PRINTFORML 「아로즈 그레이라는 거야?」
						PRINTFORML 「유명한 블렌딩 티구나. 차잎과의 조합에 따라 향이나 맛이 달라지는 거네.」
						PRINTFORMDW 레티는 향을 음미하며 마시고 있다.
					CASE 2
						PRINTFORML 「다즐링? 얼그레이랑은 어떻게 다른 걸까?」
						PRINTFORML 「헤에, 엄밀히 말하면 다즐링이 차잎이고, 얼그레이는 차잎에 감귤류의 플레이버가 더해진 거구나」
						PRINTFORMW 「다음에 다즐링 얼그레이도 넣어주지 않을래?」
					CASE 3
						PRINTFORML 「세계 삼대 명차?」
						PRINTFORML 「다즐링에 키맨과 우바……」
						PRINTFORMDL 레티 앞에, 각각 다른 홍차를 세 가지 넣어 보았다.
						PRINTFORMDL 그녀는 비교하며 마셨지만, 고개를 갸웃거렸다.
						PRINTFORML 「나에게는 맛의 차이는 모르겠지만, 정말 맛있다는 것만은 알겠어」
						PRINTFORMDL 레티라면 어떤 차라도 맛있다고 마실 것 같았다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 쓴웃음을 지었지만, 레티의 아련하면서도 눈부신 미소에 치유되었다.
				ENDSELECT
			CASE 3
				PRINTFORML 「오늘은 내가 차를 우려볼게」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 차를 우려내려고 하자, 레티는 이미 차를 준비해 두었다.
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「어때?」
						PRINTFORMDW 맛있다고 하자, 레티는 수줍게 웃었다.
					CASE 1
						PRINTFORMDL 차를 받자, 입을 맞춘다.
						PRINTFORML 「후후♪」
						PRINTFORMDL 알아차렸을 때는 그녀의 얼굴이 바로 눈앞에 있었다.
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 뺨에 손을 대자, 그녀는 키스해왔다.
						SELECTCASE RAND:3
							CASE 0
								CALL HPH_PRINT,@" 「음... 음... HPH 츄루, 음츄HPH」","L"
								PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 입술을 벌리고 혀를 집어넣자, 구강 내부를 유린한다.
							CASE 1
								CALL HPH_PRINT,@" 「츄우후헵 츄우후헵」","L"
								PRINTFORMDW 레티는 %조사처리(CALLNAME:MASTER,"의")% 입안의 차를 빨아들이듯 키스를 탐한다.
							CASE 2
								CALL HPH_PRINT,@" 「음... 큭, 쪽, 꿀꺽」","L"
								CALL HPH_PRINT,@" 「잘 먹었습니다 HPH」","L"
								PRINTFORMDW 레티는 매혹적인 미소를 지으며 자신의 입술을 핥았다.
						ENDSELECT
						CALL MUTUAL_KISS
					CASE 2
						PRINTFORML 「%CALLNAME:MASTER%처럼, 맛있다고는 할 수 없지만」
						PRINTFORMDL 불안한 듯 올려다보며 바라보는 그녀.
						PRINTFORMDW 맛있다니까, 그녀는 기쁜 듯 다가왔다.
				ENDSELECT
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:11
			CASE 0
				PRINTFORML 「차를 타준 거야? 고마워.」
				PRINTFORML 「역시 차가운 차는 회복시켜 주는군~♪」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 같이 마시면, 맛이 두 배로 좋아질 거야♪」
			CASE 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 식은 차를 마시다」
				PRINTFORML 「후후, 이보다 더한 사치는 없겠네」
				PRINTFORMW 「하아, 이런 사치를 누릴 수 있다면, %CALLNAME:MASTER%에게서 떨어지고 싶지 않아♪」
			CASE 2
				PRINTFORML 「차가운 차라도 나의 연심은 가라앉지 않아♪」
				PRINTFORMDW 레티는 이쪽으로 흘겨온다.
			CASE 3
				PRINTFORML 「둘이 마시는 차는 특별하네♪」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 넣은 차라면, 뜨거워도 괜찮아♪」
			CASE 4
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 타준 차라면, 매일이라도 마시고 싶어♪」
				PRINTFORMDL 레티는 이쪽을 바라본다.
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 타준 차라면, 매일이라도 마시고 싶어♪」
				PRINTFORMDW 소중한 것이 모양이다.
			CASE 5
				PRINTFORML 「하아~, 온몸에 스며든다~♪」
				PRINTFORMDW 레티는 힘을 풀고 완전히 무방비한 모습을 드러낸다.
			CASE 6
				PRINTFORML 「봄도 가을도 겨울도 역시, 차갑게 식힌 보리차만 최고라니까.」
				PRINTFORMDL 여름은 그녀 안에서 어디로 갔을까?
				PRINTFORMW 「여름은 에어컨이 나오는 곳에서의 시원한 아이스크림이야.」
			CASE 7
