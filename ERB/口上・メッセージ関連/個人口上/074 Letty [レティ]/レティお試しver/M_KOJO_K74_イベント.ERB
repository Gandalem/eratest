;デート帰り
;==================================================

@M_KOJO_SPEVENT_K74_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「꽤 즐거웠어.」
			PRINTFORMW 레티는 고개를 가볍게 숙이고 그대로 날아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「즐거웠어. 다음에 또 데이트하자」
			PRINTFORMW 그럼, 내일 또 보자 하고 농담처럼 말한다.
			PRINTFORMW 「후후, 기대하고 있을 테니까」
			PRINTFORMW 「또 봐」
			PRINTFORMW (다음에 또 보겠지... 만날 수 있겠지?)
		ELSEIF TALENT:恋慕
			PRINTFORMW 「오늘도 즐거웠어」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 데리고 갈 때마다, 내 안에서 여러 가지가 펼쳐지는 거야」
			PRINTFORMW 그녀는 쿠스쿠스 웃는다.
			PRINTFORMW 「다음에도 기대해도 될까?」
		ELSEIF TALENT:思慕
			PRINTFORMW 「오늘은 즐거웠어」
			PRINTFORMW 「또, 수다 정도는 불러주세요」
			PRINTFORMW 레티는 웃고 있다.
		ELSE
			PRINTFORMW 「그럼, 안녕」
		ENDIF
		RETURN 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
