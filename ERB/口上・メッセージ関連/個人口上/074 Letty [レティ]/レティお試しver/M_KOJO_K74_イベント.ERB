@SPECIALDAY_EVENT_K74
;-------------------------------------------------
;謹賀新年
IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1
	IF TALENT:恋人
		PRINTFORMW 「새해 복 많이 받아」
		PRINTFORMW 「시간이 빨리 흐르는 것 같아」
