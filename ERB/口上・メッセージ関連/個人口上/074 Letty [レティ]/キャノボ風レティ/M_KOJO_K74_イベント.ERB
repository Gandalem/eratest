SELECTCASE RESULT
	;許可する場合
	CASE 0
		CFLAG:74:1001 = 1
		PRINTFORMW 변경 사항이 적용되었다.
		TALENT:74:処女 = 1
		TALENT:74:SexKnow = -1
		EXP:74:Ｖ経験 = 0
