@M_KOJO_CB風_SUCCESS_COM_K74_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_CB風_MESSAGE_COM_K74_301
CALL M_KOJO_CB風_MESSAGE_COM_K74_301_1
RETURN RESULT

@M_KOJO_CB風_MESSAGE_COM_K74_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;無からお茶を出せるあなたなら他の飲み物も出せるはず
;レティさんは冷たいもの好きだけどあったかい飲み物もそれはそれで好きだよ
IF LOCAL
	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「이게 커피……!」
				PRINTFORMW 레티에게 아이스커피를 내려주었다.
				PRINTFORMW 「쓰다~!」
				PRINTFORMW ……우유와 설탕을 넣지 않았다.
			CASE 1
				PRINTFORML 「역시, %조사처리(CALLNAME:MASTER,"가")% 타는 차가 최고야~♪」
				PRINTFORMW 레티는 찻잔을 양손으로 들고 행복하게 웃었다.
				PRINTFORMW 「언제나 고마워, %CALLNAME:MASTER%♪」
			CASE 2
				PRINTFORML 「그런데, 항상 어디서 음료를 꺼내는 거야?」
				PRINTFORMW 「비법이 있다면 나한테도 알려줬으면 좋겠네~」
				PRINTFORMW 그것은 기업 비밀이다.
			CASE 3
				PRINTFORML 「왠지 청량해졌네~」
				PRINTFORMW 주머니에 콜라를 따라보았다.
				PRINTFORMW 「우으~ 이 탄산은 익숙하지 않을지도.」
				PRINTFORMW 탄산은 취향이 아닌 모양이다...
			CASE 4
				PRINTFORML 「밀크티는 맛있지~ 부드럽고, 달콤하고!」
				PRINTFORMW 레티가 마음에 들어 한 것 같다.
				PRINTFORMW 「바깥 세상에서는 밀크티를 그대로 파는 거야? 부러워~」
			CASE 5
				PRINTFORML 「이게……밀크셰이크…!」
				PRINTFORMW 레티에게 밀크셰이크를 만들어 주었다.
				PRINTFORMW 「아이스크림을 마시고 있는 것 같아!」
				PRINTFORMW 매우 마음에 들어 하는 듯하다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「허브티는 정말 좋은 향이 난다~」
				PRINTFORMW 레티는 잠시 허브의 향을 즐겼다.
				PRINTFORMW ……이렇게 하고 있으면 성숙한 여성으로 보인다고 한다.
			CASE 1
				PRINTFORML 「이렇게 %조사처리(CALLNAME:MASTER,"에게")% 차를 내려주면, 왠지 마음이 편안해져~」
				PRINTFORMW 레티는 차를 마시면서 %조사처리(CALLNAME:MASTER,"에게")% 몸을 기댔다...
				PRINTFORMW 「노는 것도 좋지만, 이렇게 느긋하게 있는 것도 멋지네!」
			CASE 2
				PRINTFORML 「우롱차는 여러 종류가 있잖아」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 내려준다면 무엇이든 맛있어♪」
			CASE 3
				PRINTFORML 「코코아는 안심되는 맛이지!」
				PRINTFORMW 레티는 따뜻한 코코아를 홀짝이며 마시고 있다...
				PRINTFORMW 「모르겠어, 아까워서 조금씩 마셔버리네~」
		ENDSELECT
		;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「보리차야~!」
				PRINTFORMW 「여름 음료 같은 느낌이 나지만, 언제 마셔도 맛있지~」
				PRINTFORMW 열사병에 걸리지 않는 요괴에게 보리차의 효능은 그다지 중요하지 않은 모양이다.
			CASE 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%, 차를 우리는 게 능숙하네~」
				PRINTFORMW 녹차를 마신 레티는 안도의 한숨을 내쉬었다.
			CASE 2
				PRINTFORML 「홍차는 환상향에서는 코우마칸 외에는 별로 보지 못하죠.」
				PRINTFORMW 「이 홍차도 코우마칸에서 받아온 거예요?」
				PRINTFORMW 역시 붉은 흡혈귀의 저택답네, 좋은 찻잎을 사용하고 있어.
			CASE 3
				PRINTFORML 「우메콘부차... 평소엔 별로 안 마시는데, 가끔 마시면 맛있지.」
				PRINTFORMW 「하지만, 다시마는... 어디서 사 온 거야?」
		ENDSELECT
		;通常
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「따뜻한 차도 좋지~」
				PRINTFORMW 식히면 안 되는 거라고 생각했지만, 그렇지 않은 모양이다.
			CASE 1
				PRINTFORML 「나를 시원하게 해줬어? 고마워!」
				PRINTFORMW 레티는 그린티를 기쁜 듯 마셨다.
		ENDSELECT
	ENDIF
ENDIF
