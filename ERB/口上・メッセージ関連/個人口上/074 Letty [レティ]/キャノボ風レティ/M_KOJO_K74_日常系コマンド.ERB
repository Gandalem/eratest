;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_CB風_SUCCESS_COM_K74_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_CB風_MESSAGE_COM_K74_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_CB風_MESSAGE_COM_K74_300_1
RETURN RESULT

@M_KOJO_CB風_MESSAGE_COM_K74_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;コンセプトは楽しいことが大好きなぽわぽわお姉ちゃん
;言動はどことなく幼く、浮世離れした感じで
;大まかなレティさんの態度
;陥落無し：普通の友達
;思慕：仲のいい友達
;恋慕：今までにない感情が芽生えたことに戸惑っている
;恋慕(告白経験有)：恋心を自覚するようになる
;恋人：大好きな人と一緒にいられて楽しい～！って無敵になる
IF LOCAL
	;怒り
	IF CFLAG:ブチギレ > 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「후우!」
		PRINTFORMW 레티는 입을 삐죽 내밀고 등을 돌리고 있다.
		;失敗
		;退屈なのであなたの話を意に介さない言動をとる
		;会話累積値が閾値を超えての失敗
	ELSEIF TCVAR:302
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「……」
				PRINTFORMW 레티는 머리카락을 손가락으로 빙글빙글 만지작거린다. 지루한 모양이다.
			CASE 1
				PRINTFORML 「그 이야기, 벌써 들었어?」
				PRINTFORMW 레티는 살짝 고개를 기울이며 말했다.
		ENDSELECT
		;通常失敗
	ELSEIF TFLAG:193 < 0
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「저기, 더 재미있는 이야기는 없어?」
				PRINTFORMW 레티의 말은 직설적이었다. %조사처리(CALLNAME:MASTER,"는")% 조금 상처받았다.
			CASE 1
				PRINTFORML 「아, 저기 나비가 있었어!」
				PRINTFORMW 레티는 %조사처리(CALLNAME:MASTER,"의")% 말을 끊고 그쪽을 가리켰다.
			CASE 2
				PRINTFORML 「뭐 할까~」
				PRINTFORMW 레티는 멍한 채 다음 일정을 생각하는 듯하다...
		ENDSELECT
		;酔っ払い
		;ぐでぐで
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「우후후, 후후후후훗♪」
				PRINTFORMW 레티는 %조사처리(CALLNAME:MASTER,"의")% 품에 파고들어 웃고 있다...
			CASE 1
				PRINTFORML 「헤에...? %조사처리(CALLNAME:MASTER,"가")% 네 명이야~♪」
				PRINTFORMW 아무래도 눈이 빙글빙글 도는 것 같다...
			CASE 2
				PRINTFORML 「더워라~……후훗, 우후후……」
				PRINTFORMW 레티는 가슴팍을 늘어뜨린 채 킬킬 웃고 있다……
			CASE 3
				PRINTFORMW 「세상이 돌아가고 있어! 이건 이변이네~」
				PRINTFORMW 누워서 무언가를 말하고 있다...
		ENDSELECT
		;酔いどれ
	ELSEIF TALENT:恋慕 && BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「조금 더워진 것 같아~」
				PRINTFORMW 레티는 목도리를 느슨하게 풀고, 파타파타 가슴을 부채질했다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%도 마시고 있나~?」
				PRINTFORMW 레티는 빙글빙글 돌고 있었다.
				PRINTFORMW ……자세히 보니 종아리만 벌어진 상태였다.
			CASE 2
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 마시는 술은 맛있다ね♪」
				PRINTFORMW 꽤 빠른 속도다. 괜찮을까...?
		ENDSELECT
		;ほろ酔い
	ELSEIF TALENT:恋慕 && BASE:酒気 >= 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「즐거운 기분이 되어 왔어~」
				PRINTFORMW 평소보다 더 명랑한 목소리다.
			CASE 1
				PRINTFORML 「술은 즐거워지니까 나도 모르게 너무 많이 마셔버린다~」
				PRINTFORMW 그렇게 말하면서도 별로 조심하고 있는 것 같지는 않다.
			CASE 2
				PRINTFORML 「음후후~♪」
				PRINTFORMW 레티는 기분이 좋다. 약간 얼굴이 붉어져 있다...
		ENDSELECT
		;ぐでぐで
		;ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		;酔いどれ
		;ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		;ほろ酔い
		;ELSEIF BASE:酒気 >= 1
		;デート中
		;添い寝中
		;大成功
		;たぶんレティさんの話のツボはどこにあるか分かりにくい
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「후훗, 그거 재미있네!」
				PRINTFORMW 이야기를 마음에 들어 해 준 것 같다.
			CASE 1
				PRINTFORML 「헤에~……멋진 이야기네!」
				PRINTFORMW 레티의 수정 같은 눈이 더욱 빛나고 있다.
		ENDSELECT
		;通常会話
		;キャノボ会話での雰囲気を出したい…
		;恋人
	ELSEIF TALENT:恋人
		SELECTCASE RAND:9
			CASE 0
				PRINTFORML 「있잖아%CALLNAME:MASTER%, 나 좋아해?」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, 레티는 두 손으로 뺨을 감싸고 기쁜 듯 웃었다.
				PRINTFORMW 「나도~♪」
			CASE 1
				PRINTFORML 「옛 지옥에는 작열하는 지옥의 흔적이 있어서 온천이 샘솟는대! 다음에 같이 가보자!」
				PRINTFORMW 두 사람이 함께 온천에 갈 계획을 세웠다.
				PRINTFORMW 「엣!? 같이 들어가면 안 되는 거야?」
				PRINTFORMW 유감스럽게도, 안 된다.
			CASE 2
				PRINTFORML 「獏に会ったことはある？」
				PRINTFORMW 「お願いしたら、%CALLNAME:MASTER%と一緒にいる夢を見せてくれないかなって思ったの」
				PRINTFORMW 「夢でも%CALLNAME:MASTER%に会えたら、きっと素敵だわ！」
			CASE 3
				PRINTFORML 「어디서 놀까아~. %CALLNAME:MASTER%, 어디가 좋을까?」
				PRINTFORMW 레티는 그렇게 말한 후, 문득 깨달았다.
				PRINTFORMW 「맞아! %조사처리(CALLNAME:MASTER,"랑")% 놀면, 뭘 해도 즐겁잖아!」
			CASE 4
				PRINTFORML 「겨울은 좋지. 눈 덮인 풍경도 예쁘고, 즐거운 놀이도 많으니까」
				PRINTFORMW 「그러니까, %조사처리(CALLNAME:MASTER,"랑")% 겨울을 보낼 수 있으면 최고일 거야!」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 레티와 어떤 놀이를 할지 이야기를 나누었다.
			CASE 5
				PRINTFORML 「있잖아 %CALLNAME:MASTER%, 이야기 속의 눈의 여신은 갑자기 사라져 버리잖아」
				PRINTFORMW 「나? 나는 그런 일 안 해?」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 만날 수 없게 된다니, 싫어!」
			CASE 6
				PRINTFORML 「에헤헤~♪ %조사처리(CALLNAME:MASTER,"랑")% 이야기하고 있으면, 볼이 풀려버린다~♪」
				PRINTFORMW 레티는 행복해 보이는 미소를 지었다.
			CASE 7
				PRINTFORMW 「%CALLNAME:MASTER%、耳を貸して？」
				PRINTFORML 「大好き읏%UNICODE(0x2665) *1%」
				PRINTFORMW 레티는 귀 옆에서 기쁘게 속삭였다.
				PRINTFORMW 「こっそり言わないと、恥ずかしくて顔が赤くなっちゃうからね♪」
			CASE 8
				PRINTFORML 「주사위~♪」
				PRINTFORMW 레티와 보드게임을 하며 놀았다.
				PRINTFORMW ......왠지 모르게 향수를 느끼는 건......
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		;告白前
		IF CFLAG:74:1002 == 0
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「저번에 설녀 이야기를 읽었어.」
					PRINTFORMW 「슬픈 이야기가 많았어. 나까지 슬퍼지네.」
					PRINTFORMW 레티는 잠시 어두운 표정이 되었지만, 금세 밝은 미소를 지었다.
					PRINTFORMW 「하지만 나와 %조사처리(CALLNAME:MASTER,"는")% 사이가 좋으니까, 이야기처럼 되지는 않겠지?」
				CASE 1
					PRINTFORMW 레티는 멍하니 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 바라보고 있었다...
					PRINTFORML 「어라? 왜 보고 있었지...?」
					PRINTFORMW 신기하다는 듯, 다시 한번 %조사처리(CALLNAME:MASTER,"를")% 바라보았다.
				CASE 2
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 있으면, 정말 즐겁네!」
					PRINTFORMW 레티는 꽃이 피는 듯한 미소를 지었다.
					PRINTFORMW 「좀 더 같이 있을 수 있으면 좋을 텐데~……」
				CASE 3
					PRINTFORML 「겨울 이외의 계절은 자꾸 졸려져 버리곤 해. 안 졸리게 하는 좋은 방법 없을까?」
					PRINTFORMW 「차나 커피를 마시면 졸음에 좋아? %조사처리(CALLNAME:MASTER,"가")% 내려준다는 거야?」
					PRINTFORMW 「그렇다면 일석이조잖아!」
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"랑")% 놀고 싶으니까, 더 깨어있고 싶단 말이야!」
				CASE 4
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 노는 게 제일 즐겁네~♪」
					PRINTFORMW 레티는 기분이 좋아 노래하기 시작했다.
			ENDSELECT
			;告白後
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「어디론 놀러 갈까아~. %조사처리(CALLNAME:MASTER,"는")% 어디가 좋다고 생각해?」
					PRINTFORMW 레티는 생각하는 표정으로 물었다.
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 좋아하는 장소가 있다면, 나도 그곳을 좋아하고 싶어.」
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 어떤 요리를 좋아해?」
					PRINTFORMW 「나는 말이야, 차가운 거라든다 달콤한 거 같은 걸 좋아해!」
					PRINTFORMW 「하지만 역시 겨울 요리가 최고지 않아!」
				CASE 2
					PRINTFORML (좀 더 돌아봐 주지 않을까……)
					PRINTFORMW 레티의 눈동자가 애틋하게 %조사처리(CALLNAME:MASTER,"를")% 비추고 있다…….
				CASE 3
					PRINTFORML 「있잖아 %CALLNAME:MASTER%, 저쪽으로 가도 돼?」
					PRINTFORMW 레티는 %조사처리(CALLNAME:MASTER,"의")% 어깨에 기대며 만족스러운 듯 팔을 감았다.
					PRINTFORMW 「이렇게 좋아하는 사람에게 신경 써주는 거, 기쁘네♪」
				CASE 4
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 손은 크네~」
					PRINTFORMW 레티는 %조사처리(CALLNAME:MASTER,"의")% 손을 만지고 있다……
					PRINTFORMW 「에헤헤~♪」
					PRINTFORMW 자신의 손과 맞추어 왔다……
			ENDSELECT
		ENDIF
		;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「지루할 때는 치르노랑 자주 놀아!」
				PRINTFORMW 「그 애는 일 년 내내 한가해 보이거든, 놀이 상대가 되어 주니까.」
			CASE 1
				PRINTFORMW 레티는 %조사처리(CALLNAME:MASTER,"가")% 열변하는 차 우리는 법을 감탄하며 듣고 있다……
				PRINTFORMW 「차는 온도와 시간이 중요하구나. 그럼 녹차를 우릴 때는 내가 뜨거운 물을 식혀줄게」
				PRINTFORMW 「어라, 그런데 %조사처리(CALLNAME:MASTER,"가")% 뜨거운 물을 준비하는 모습은 본 적이 없는데……」
			CASE 2
				PRINTFORMW 레티는 %조사처리(CALLNAME:MASTER,"가")% 열변하는 청소 방법을 감탄하며 듣고 있다……
				PRINTFORMW 「과연, 물에 적신 신문지를 말아서 두면 먼지가 생기지 않는구나……」
				PRINTFORMW 「텐구들이 나눠주는 신문은 이렇게 사용하면 되는 거네!」
			CASE 3
				PRINTFORML 「요정의 아이들은 잘 놀아주기 때문에 사이가 좋아졌어」
				PRINTFORMW 「인간들에게 장난치러 가거나, 탄막 놀이를 하기도 해! 정말 즐겁단다~」
				PRINTFORMW 「다음엔 %CALLNAME:MASTER%도 같이 놀자고!」
			CASE 4
				PRINTFORML 「겨울에는 여러 가지 놀이가 있지. 스키라든가, 스케이트, 눈싸움 같은 것도…」
				PRINTFORMW 레티와 겨울 스포츠에 대해 이야기했다.
				PRINTFORMW 「후훗, 나 겨울 놀이는 잘하거든?」
		ENDSELECT
		;セフレ
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		;陥落無し
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「이야기해 줄 거야? 어떤 이야기?」
				PRINTFORMW 레티에게 옛날이야기를 들려주었다.
				PRINTFORMW ......꽤 마음에 들어 한 것 같다.
			CASE 1
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 잡학을 선보였다.
				PRINTFORML 「헤에~, 몰랐네~」
				PRINTFORMW 레티는 감탄하며 듣고 있다.
			CASE 2
				PRINTFORML 「아, 같이 놀아 줄 거야?」
				PRINTFORMW 레티의 놀이에 한동안 함께 했다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
