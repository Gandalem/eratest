;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K118_80
CALL M_KOJO_MESSAGE_COM_K118_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K118_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「이게 네가 하는 방식이야...?」
		PRINTFORML 「...그게 내 안테나랑 좀 닮았어...」
		PRINTFORMDW 유충은 몸을 가다듬고, 소중한 손으로 당신의 거시기를 조심스럽게 만지기 시작했다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMDW 움직이지 않는 유충의 겨드랑이를 이용해 원하는 만큼 당신의 성기를 애무한다...
		RETURN 1
		;それ以外
	ELSE
		IF NOWEX:PLAYER:射精
			PRINTFORML 「%CALLNAME:MASTER%, 기분 좋아...?」
			PRINTFORMDW 라바가 예상치 못하게 수음의 속도를 높인다...
		ELSE
			PRINTFORML 「내가 그것을 잡으면, 안도감을 느껴...」
			PRINTFORMDW 유충은 당신에게 계속 자위를 하면서 귀가 더 빨개진다...
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K118_81
CALL M_KOJO_MESSAGE_COM_K118_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K118_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「이걸 핥아서 노는 거야...? 내 안테나랑 비교하면 좀 이상한 냄새가 나는데...」
		PRINTFORMDW 유충은 당황해 보이지만, 당신의 귀두를 충실하게 핥기 시작한다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDL 당신은 라바의 움직이지 않는 입속으로 자신의 성기를 밀어넣는다...
		PRINTFORMDW 그녀의 작은 이빨에 비비는 것이 굉장하게 느껴진다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「%RANDKISS("suck")%-%RANDKISS("suck")%... 이 꿀을 좀 핥고 싶어...」
		PRINTFORMDW 유충이 당신의 요도에 혀를 붙이고 페라치오한다...
		IF NOWEX:PLAYER:射精
			PRINTFORML 「...!! ...음...%UNICODE(0x2764)%」
			PRINTFORMDW 유충은 정액의 쓴맛을 즐기는 듯하다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
