; Modular ERB: 個人口上/118 Larva [ラルバ]/賑やかしラルバ【118】/M_KOJO_K118_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K118_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;ここでハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 「단마쿠를 할 거야ー? 좋아ー!!」
		PRINTFORML 「이 게임이 새로운 세계의 신을 결정할 것이다!」
		PRINTFORMDW 라바는 주문 카드를 꺼내며 눈을 빛냈다.
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		PRINTFORML 
		;残機別に表示したい場合は下のコメントアウト外してね、別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORMW 「후후후ー 이건 쉽네ー!」
				PRINTFORML 「그럼 이걸 어때!!」
				PRINTFORMW 『Sputtering Summer』!!
				PRINTFORML 「그럼 이걸 어때!!!」
				PRINTFORMW 「『Sputtering Summer』!!!」
				PRINTFORMDW 유충의 비늘 총알이 하늘로 날아간다!
			CASE 1
				PRINTFORML 「우와와... 이대로 가야 한다면, 오버드라이브를 걸 수밖에 없어!」
				PRINTFORML 「구시대 신의 힘을 알아라!」
				PRINTFORMDW 라바에게서 특이한 힘의 기운이 흘러나오기 시작했다!
			CASE 0
				PRINTFORML 「꺄아악! 나 끝났어~!!!」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 1 TO 3
				PRINTFORML 「에헤헤~ 나는 신세계의 신이다ー!」
				PRINTFORML 「정말 즐거웠어, %CALLNAME:MASTER%아!」
				PRINTFORMDW 유충은 너와 놀고 난 뒤 매우 만족하는 듯하다.
				IF 相手残機 >= 2
					PRINTFORML 「아하하! %조사처리(CALLNAME:MASTER,"는")%(는) 너무 약해!」
					PRINTFORML 「잠깐 연습 모드를 해보는 건 어때?」
					PRINTFORMDW 유충이 새드한 눈빛을 보낸다...
				ENDIF
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%인간치고는 정말 강하네ー!」
				PRINTFORML 「어떻게 나를 뛰어넘었어? 저 총알들은 어떻게 없앤 거야? 가르쳐 줘!」
				PRINTFORMDW 유충은 너를 강렬하게 존경의 눈빛으로 바라봤다.
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
