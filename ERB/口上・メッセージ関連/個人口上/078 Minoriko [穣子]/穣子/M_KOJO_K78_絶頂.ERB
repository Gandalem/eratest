@M_KOJO_MESSAGE_PALAMCNG_B_K78
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K78_CONSCIOUS_AND_TOLERANT() && TALENT:SexKnow > -1
		;-------------------------------------------------
		;五重絶頂
		;-------------------------------------------------
		IF NOWEX:五重絶頂
			SELECTCASE RAND:3
				CASE 1
					CALL K78_HPH_PRINT,@"「앗, 음아흐읍 하아ㅎㅍ 아아, 앗, 아아아악ㅎㅍ 이, 이구우우으ㅎㅍ」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 큰 비명을 지른 후, 실이 끊어진 것처럼 온몸을 느슨하게 이완시키고 헉헉거리며 숨을 몰아쉰다.
					PRINTFORMW 「후히유, 후우, 후우 ……이제… 이제… 놓아줘…」
				CASE 2
					CALL K78_HPH_PRINT,@"「큿, 아아앗, 아 HPH 응아아앗 HPH 응이, 응히이이이 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 눈물과 콧물, 침투성이 뒤덮인 얼굴 그대로, 파르르 떨면서도 신음하고 있다.
					CALL K78_HPH_PRINT,@"「하아, 헉, 하에 HPH 오, 우아, 하아HPH 후우, 후우HPH 음으HPH」","W"
				CASEELSE
					CALL K78_HPH_PRINT,@"「죽을, 죽어버릴 것 같아 HPH 안 돼 HPH 안 돼 HPH 후우, 음호오오오HPH」","L"
					PRINTFORMDL 비명 같은 소리를 지른 %조사처리(CALLNAME:TARGET,"는")% 기진맥진하여 %조사처리(CALLNAME:MASTER,"에게")% 기대어 있었다.
					CALL K78_HPH_PRINT,@"「하아, 하아... 대, 대단해어 HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;四重絶頂
		;-------------------------------------------------
		IF NOWEX:四重絶頂
			SELECTCASE RAND:3
				CASE 1
					CALL K78_HPH_PRINT,@"「야아, 안 돼... 흐으윽, 이제 그만해줘... 하앗, 으응 아아앗...」","W"
				CASE 2
					CALL K78_HPH_PRINT,@"「이제 무리야 HPH 기분 너무 좋아서 이상해지겠어 HPH 머리가 새하얘져 버릴 테니까아 HPH」","W"
				CASEELSE
					CALL K78_HPH_PRINT,@"「그만해애... HPH 벌써 갔으니까아 HPH 너무 기분 좋아서 HPH 날아갈 것 같아 HPH 날아가 버릴 거야 HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;三重絶頂
		;-------------------------------------------------
		IF NOWEX:三重絶頂
			SELECTCASE RAND:3
				CASE 1
					CALL K78_HPH_PRINT,@"「야앗 HPH 이거 대단해 HPH 아, 응 아아 HPH 아히, 응 히잇 HPH」","W"
				CASE 2
					CALL K78_HPH_PRINT,@"「응, 응하아 HPH다, 안 돼 HPH 갈 거야 HPH 잔뜩 가버릴 거야 HPH」","W"
				CASEELSE
					CALL K78_HPH_PRINT,@"「응히익 HPH 히익 HPH 안 돼, 안 돼 HPH 응, 이잇~~ HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;二重絶頂
		;-------------------------------------------------
		IF NOWEX:二重絶頂
			SELECTCASE RAND:3
				CASE 1
					CALL K78_HPH_PRINT,@"「앗, 하윽, 으응 HPH 갈 것 같아 갈 것 같아 으응 HPH」","W"
				CASE 2
					CALL K78_HPH_PRINT,@"「하아, 좋아어 HPH 하앗, 아, 후아앗 가버릴 것 같아 HPH」","W"
				CASEELSE
					CALL K78_HPH_PRINT,@"「응하앗, 하안옷, 좋아! HPH %CALLNAME:MASTER%치 기분 좋아아 HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;単部位の絶頂
		;-------------------------------------------------
		IF NOWEX:Ｃ絶頂
			;超強絶頂Ｃ
			IF NOWEX:Ｃ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K78_HPH_PRINT,@"「\@ TALENT:性別 & 2 ? 거기 # 클리 \@기분 좋아아 HPH 안쪽 HPH 응,응이쪽 HPH」","W"
					CASE 2
						CALL K78_HPH_PRINT,@"「응후우 HPH 음음HPH 어, \@ TALENT:性別 & 2 ? 고추 # 클리 \@해버릴 것 같아아 HPH」","W"
					CASEELSE
						CALL K78_HPH_PRINT,@"「\@ TALENT:性別 & 2 ? 거시기 # 클리 \@대박, 대단해애 HPH 아아, 하아앗, 한으옷HPH」","W"
				ENDSELECT
				;強絶頂Ｃ
			ELSEIF NOWEX:Ｃ絶頂 == 2
				CALL K78_HPH_PRINT,@"「후아앗, 하윽, 가, 갈 것 같아으윽 HPH」","W"
				;絶頂Ｃ
			ELSE
				PRINTFORMW 「앗, 응아, 핫 거기, 좋아, 좋아요」
			ENDIF
			RETURN 1
		ENDIF
		IF NOWEX:Ｖ絶頂
			;超強絶頂Ｖ
			IF NOWEX:Ｖ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K78_HPH_PRINT,@"「응으윽, 보지가 굉장해 HPH 응앗, 냐아 HPH」","W"
					CASE 2
						CALL K78_HPH_PRINT,@"「대단해어 HPH 보지가 가버리는 거야아 HPH 응, 큭, 윽~~HPH」","W"
					CASEELSE
						CALL K78_HPH_PRINT,@"「꿈틀거리면서 기분 좋아! HPH 보지 더 문질러주고 싶어! HPH」","W"
				ENDSELECT
				;強絶頂Ｖ
			ELSEIF NOWEX:Ｖ絶頂 == 2
				CALL K78_HPH_PRINT,@"「흐읍, 아앗, 후아... 속이, 기분 좋아 HPH」","W"
				;絶頂Ｖ
			ELSE
				PRINTFORMW 「응, 아, 좋은 곳, 맞았어읏」
			ENDIF
			RETURN 1
		ENDIF
		IF NOWEX:Ａ絶頂
			;超強絶頂Ａ
			IF NOWEX:Ａ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K78_HPH_PRINT,@"「응! 흐윽, 나올 것 같아... 엉덩이 정말 굉장해 미칠 것 같아!」","W"
					CASE 2
						CALL K78_HPH_PRINT,@"「음, 으히이 HPH 엉덩이 만코 HPH 엉덩이 만코 갈 거야아앙 HPH」","W"
					CASEELSE
						CALL K78_HPH_PRINT,@"「앗, 야아핫 HPH 변의 구멍에서 하는 거야 HPH 하앙, 음아앗 HPH」","W"
				ENDSELECT
				;強絶頂Ａ
			ELSEIF NOWEX:Ａ絶頂 == 2
				CALL K78_HPH_PRINT,@"「앗, 엉덩이가, 후아, 아하앗 HPH」","W"
				;絶頂Ａ
			ELSE
				PRINTFORMW 「아후, 응, 윽, 아, 하앗」
			ENDIF
			RETURN 1
		ENDIF
		IF NOWEX:Ｂ絶頂
			;超強絶頂Ｂ
			IF NOWEX:Ｂ絶頂 == 3
				SELECTCASE RAND:3
					CASE 1
						CALL K78_HPH_PRINT,@"「아하아 HPH, 기, 기분 좋네 HPH 가슴 기분 좋아」","W"
					CASE 2
						CALL K78_HPH_PRINT,@"「유두가 저릿저릿한 HPH 굉장해어어HPH 으응, 으~~읏HPH」","W"
					CASEELSE
						CALL K78_HPH_PRINT,@"「가슴이, 가슴이 뜨거워 HPH 갈 것 같아, 가슴으로 갈 거야 HPH」","W"
				ENDSELECT
				;強絶頂Ｂ
			ELSEIF NOWEX:Ｂ絶頂 == 2
				CALL K78_HPH_PRINT,@"「응앗 아, 가슴 좋다, 좋아 HPH」","W"
				;絶頂Ｂ
			ELSE
				PRINTFORMW 「응, 하아, 응, 아앙」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
