;305,膝枕してもらう
;TFLAG:193(-5=MASTERがTARGETよりも巨体の場合(TALENT:MASTER:体型 > TALENT:体型 + 2) 1=大成功 0=成功 -1=失敗)(-5以外は地の文分岐無し)
;ABL:親密(6以上=顔をのぞき込みながら頭を撫でてくれる 3以上=ただ頭を撫でてくれる 2以下=縮こまっている)
;==================================================

@M_KOJO_MESSAGE_COM_K78_305
CALL M_KOJO_MESSAGE_COM_K78_305_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_305_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K78_CONSCIOUS_AND_TOLERANT() && TFLAG:193 > -5
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 1
					CALL K78_HPH_PRINT,@"「네네, 또 무릎 베개네 HPH 수고했어 HPH」","W"
				CASE 2
					CALL K78_HPH_PRINT,@"「피곤해졌어? 괜찮아. 자, 받아.」","W"
				CASEELSE
					PRINTFORMDL 달콤한 향에 감싸인 채 누워 있으니 졸음이 몰려왔다.
					CALL K78_HPH_PRINT,@"「졸려? 잠시 자 있어도 돼. 계속 이렇게 있어 줄 테니까 HPH」","W"
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE IS >= 0
					SELECTCASE ABL:親密
						CASE IS >= 6
							PRINTFORML 「또 달라붙네... 당신은 누구에게나 이런 거 하는 거야?」
							PRINTFORMDW 입으로는 그렇게 말하지만, %조사처리(CALLNAME:TARGET,"는")% 미소를 띠고 있다.
						CASE 3 TO 5
							IF TALENT:MASTER:幼稚
								PRINTFORML 「어차피 애니까, 어쩔 수 없지」
							ELSE
								PRINTFORML 「%CALLNAME:MASTER%하고 가끔 아이 같아…」
							ENDIF
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어이없다는 듯 머리를 쓰다듬어 주었다.
						CASE IS <= 2
							PRINTFORMW 「이, 이거 아무리 그래도 너무 부끄러운데...」
					ENDSELECT
				CASE -1
					PRINTFORMW 「...다리 아프고 부끄럽고, 이제 그만해」
			ENDSELECT
		ENDIF
	ENDIF
