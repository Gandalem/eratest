;421,願掛けする
;条件が複雑なので、COMF421 願掛け.ERBおよび、EVENT_MESSAGE_COM400.ERBの願掛けするの項を参照のこと
;==================================================

@M_KOJO_MESSAGE_COM_K78_421
CALL M_KOJO_MESSAGE_COM_K78_421_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_421_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:78:1099 != 0
		LOCAL:1 = GETCOLOR()
		SETCOLOR GETDEFCOLOR()
		CALL ASK_M(@"겸해서 %조사처리(CALLNAME:TARGET,"의")% 엉덩이 관리나 유두에 대해서도 소원을 빌었다.",1,"간절히 바라는 것은 이것뿐이다",1)
		IF RESULT == 0
			PRINTL
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 겸사겸사 %조사처리(CALLNAME:TARGET,"의")% 엉덩이 관리와 유두에 대해 부탁할 일이 생겼다.
			$PRAYER_LOOP
			VARSET LOCALS
			SELECTCASE CFLAG:78:1001
				CASE 0
					LOCALS:0 '= @"변하지 않는다"
				CASE 1
					LOCALS:0 '= @"출산 전후에만 변화한다."
				CASE 2
					LOCALS:0 '= @"임신 여부와 관계없이 모유 체질에 따라 변화한다."
				CASEELSE
					LOCALS:0 = ※CFLAG:78:1001の値が不正※
			ENDSELECT
			SELECTCASE CFLAG:78:1002
				CASE 0
					LOCALS:1 '= @"스카트로 없음"
				CASE 1
					LOCALS:1 '= @"스카트로 있음"
				CASEELSE
					LOCALS:1 = ※CFLAG:78:1002の値が不正※
			ENDSELECT
			PRINTL
			PRINTFORMDL 유두 변화의 현재 설정: %LOCALS:0% 스카토 표현의 현재 설정: %LOCALS:1%
			PRINTL
			CALL ASK_M("유두 변화 설정을 변경한다",1,"스카트로 표현 설정을 변경한다.",1,"이걸로 됐어",1)
			SELECTCASE RESULT
				CASE 0
					IF CFLAG:78:1001 >= 2
						CFLAG:78:1001 = 0
					ELSE
						CFLAG:78:1001 += 1
					ENDIF
					PRINTL
					GOTO PRAYER_LOOP
				CASE 1
					CFLAG:78:1002 = !CFLAG:78:1002
					PRINTL
					GOTO PRAYER_LOOP
				CASE 2
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 유두가 %LOCALS:0%하게 된 기분이 든다.
					LOCALS:2 = 
					IF CFLAG:78:1002 == 0
						LOCALS:2 '= @"엉덩이를 깨끗하게 하고 항문 섹스 준비를 게을리하지 않는다."
					ELSE
						LOCALS:2 '= @"애널 섹스 전에도 엉덩이를 그대로 두었다."
					ENDIF
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% %LOCALS:2%가 된 것 같다.
					PRINTL
			ENDSELECT
		ENDIF
		SETCOLOR LOCAL:1
	ENDIF
	IF K78_CONSCIOUS_AND_TOLERANT()
		SELECTCASE RAND:9
			CASE 1 TO 4
				PRINTFORMW 「무엇을 빌었니?」
			CASE 5 TO 8
				PRINTFORMW 「꽤 열성적으로 기도하고 있었네」
			CASEELSE
				PRINTFORMW 「음... 당신이 기도하는 신님, 어쩐지 수상한 느낌이 드는 것 같아...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
