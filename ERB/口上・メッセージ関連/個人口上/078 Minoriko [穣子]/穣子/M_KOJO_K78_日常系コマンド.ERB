;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K78_300
;現在地が浴場で恋慕or愛欲でしらふのときは体毛指定関数を呼び出す
IF BATHROOM() && (TALENT:恋慕 || TALENT:愛欲) && SHIRAHU(TARGET)
	RESETCOLOR ;custom code
	CALL K78_HAIR_TREATMENT
	;体毛関係のイベントを選んだ場合は通常の会話口上無し
	SIF RESULT == 1
		RETURN 1
ENDIF
CALL M_KOJO_MESSAGE_COM_K78_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:ブチギレ || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMDW 화난 %조사처리(CALLNAME:TARGET,"는")% 등을 돌리고 있다.
	ELSEIF TCVAR:泥酔
		IF TALENT:機嫌 >= 0
			PRINTFORMDL 기분이 좋은지 %조사처리(CALLNAME:TARGET,"는")% 헤헤거리며 웃고 있다.
			PRINTFORMW 「뭐야? 괜찮아, 걱정 마」
		ELSE
			PRINTFORML 「잠깐, 나 말 듣고 있어? 잘 들어!」
			PRINTFORMDW 아무래도 좋지 않은 취기로 취한 것 같다.
		ENDIF
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				IF ( TALENT:恋慕 || TALENT:愛欲 ) && RAND:3
					SELECTCASE RAND:2
						CASE 1
							CALL K78_HPH_PRINT,@"「밥을 많이 먹고, 이렇게 당신과 함께 있을 수 있다니... 나 정말 행복한 사람이야... HPH」","W"
						CASEELSE
							PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 아름다움을 칭찬했다.
							CALL K78_HPH_PRINT,@"「이제 그만해 봐, 아무것도 안 나오잖아 HPH」","L"
							SIF CFLAG:既成事実 & 2
								CALL K78_HPH_PRINT,@"「하지만, 오늘 밤은 좀 서비스 해줘도 괜찮을까 HPH」","L"
							WAIT
					ENDSELECT
				ELSE
					PRINTFORML 「아하하핫♪ %조사처리(CALLNAME:MASTER,"는")% 재미있네.」
					PRINTFORMDW 아주 잘 받아들인 것 같다.
				ENDIF
			CASE 0
				;天気の話題
				IF GET_MAPNAME(GET_MAPID(CFLAG:MASTER:現在位置)) != "Underworld" && !RAND:5
					SELECTCASE TIME:5
						;晴れ
						CASE 0
							;１９時以降
							IF TIME:0 >= 1140
								PRINTFORMW 「오늘은 별이 정말 아름다워」
								;冬
							ELSEIF DAY:2 == 4
								;７～１７時
								IF BETWEENTIME(420,1020)
									PRINTFORMW 「해가 떠 있어서 다니기 편하네」
								ELSE
									PRINTFORMW 「겨울 하늘의 건조함에는 주의해.」
								ENDIF
							ELSE
								PRINTFORMW 「응, 날씨 좋네. 작물도 쑥쑥 자랐으면 좋겠어.」
							ENDIF
							;快晴
						CASE 1
							;夏
							IF DAY:2 == 2
								;起床～７時
								IF BETWEENTIME(CFLAG:起床時間,420)
									PRINTFORMW 「오늘은 더워질 것 같으니, 시원할 때 일을 끝내는 게 좋겠어.」
									;７～１９時
								ELSEIF BETWEENTIME(420,1140)
									PRINTFORMW 「햇볕이 강하네. 더위 때문에 쓰러지지 않도록 조심해야 해.」
									;１９時以降
								ELSE
									PRINTFORMW 「해가 지는데도 여전히 더워서 싫어지네」
								ENDIF
								;冬
							ELSEIF DAY:2 == 4
								PRINTFORMW 「날씨는 아주 좋지만, 서리가 내리지 않을까 걱정이야」
							ELSE
								PRINTFORMW 「구름 하나 없는 좋은 날씨네. 기분이 좋구나.」
							ENDIF
							;薄曇、曇り
						CASE 2,3
							;曇りで１９時以降
							IF TIME:5 == 3 && TIME:0 >= 1140
								PRINTFORMW 「오늘은 흐려서 별이 잘 보이지 않는 게 아쉽네...」
								;冬の起床～１７時
							ELSEIF DAY:2 == 4 && BETWEENTIME(CFLAG:起床時間,1020)
								PRINTFORMW 「춥네. 해가 나와주면 좋겠는데.」
								;夏の起床～１７時
							ELSEIF DAY:2 == 2 && BETWEENTIME(CFLAG:起床時間,1020)
								PRINTFORMW 「구름이 생겼네. 농사짓기 좋은 날씨네」
								;曇り
							ELSEIF TIME:5 == 3
								PRINTFORMW 「구름이 짙네. 비가 올지도.」
							ELSE
								LOCALS:0 = 
								SELECTCASE RAND:4
									CASE 1
										LOCALS:0 '= @"죽순"
									CASE 2
										LOCALS:0 '= @"가지"
									CASE 3
										LOCALS:0 '= @"주먹밥"
									CASEELSE
										LOCALS:0 '= @"고구마"
								ENDSELECT
								PRINTFORMW 「저 구름, %LOCALS:0% 같아서 맛있어 보여...」
							ENDIF
							;雨、霧雨、みぞれ
						CASE 4,6,12
							;夏
							IF DAY:2 == 2
								PRINTFORMW 「징그럽고 기분 나빠...」
							ELSE
								PRINTFORMW 「날씨가 안 좋네. 집에서 느긋하게 지내는 것도 좋을지도.」
							ENDIF
							;大雨
						CASE 5
							;台風
							IF FLAG:異常気象 == 9
								PRINTFORMW 「심한 바람과 비... 작물은 괜찮을까...」
							ELSE
								PRINTFORMW 「엄청난 비네. 외출하지 않는 게 좋을 거야」
							ENDIF
							;霧
						CASE 7
							PRINTFORMW 「안개가 짙네. 외출할 거면 조심해.」
							;雪、細雪、霧雪
						CASE 8,10,11
							PRINTFORMW 「눈이 내리고 있네. 춥겠어.」
							;吹雪、あられ
						CASE 9,13
							PRINTFORMW 「날씨가 너무 안 좋네. 오늘은 집에 있는 게 좋겠어.」
					ENDSELECT
					;季節の話題
				ELSEIF RAND:2
					SELECTCASE DAY:2
						CASE 1
							SELECTCASE RAND:4
								CASE 1
									PRINTFORMW 「봄이라고 하면 죽순이지. 죽순밥~ 죽순밥~」
								CASE 2
									PRINTFORML 「산나물의 계절이야. 봄나물, 가리비꽃눈, 산수유, 야구치」
									PRINTFORMW 「...술이 마시고 싶어져 버렸어.」
								CASE 3
									PRINTFORMW 「봄이 되면 마음이 들뜨지 않아?」
								CASEELSE
									PRINTFORMW 「슬슬 모내기구나. '모내기'라고 할 만큼 이 시기의 모종 만들기가 중요한 거란다.」
							ENDSELECT
						CASE 2
							SELECTCASE RAND:4
								CASE 1
									PRINTFORML 「여름 하면 토마토, 가지, 오이, 피망 같은 맛있는 채소지!」
									PRINTFORMW 「건강에도 좋으니까 잘 챙겨 먹어야 해.」
								CASE 2
									PRINTFORML 「여름 논일은 잡초 뽑기와 벌레 구제, 물 관리지」
									PRINTFORMW 「덥고 힘들지만, 더위도 냉해보다는 훨씬 낫잖아」
								CASE 3
									PRINTFORMW 「덥네. 빙수라도 먹고 싶다.」
								CASEELSE
									PRINTFORMW 「여름에는 태풍을 조심해. 하루 종일 집에만 틀어박혀야 하잖아.」
							ENDSELECT
						CASE 3
							SELECTCASE RAND:4
								CASE 1
									PRINTFORML 「완전히 가을이네. 이름에 걸맞은, 나의 계절이야」
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 가슴을 쓸어내린다.
								CASE 2
									PRINTFORML 「수확의 시기네. 올해도 첫 수확의 쌀을 잔뜩 먹을 수 있겠어」
									PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 포슬포슬한 얼굴이다.
								CASE 3
									PRINTFORMW 「금빛 이삭도 단풍에 뒤지지 않고 아름답다고 생각하지 않아?」
								CASEELSE
									PRINTFORMW 「가을이 제철이라면 버섯이지. 볶아도 좋고, 튀겨도 좋고, 끓여도 좋아서 아주 유용하단다.」
							ENDSELECT
						CASE 4
							SELECTCASE RAND:4
								CASE 1
									PRINTFORMW 「겨울은 기분이 가라앉아. 빨리 봄이 오지 않을까」
								CASE 2
									PRINTFORMW 「추운 겨울에는 군고구마. 달콤하고 좋은 냄새가 나서 정말 좋아♪」
								CASE 3
									PRINTFORMW 「우으, 춥네. 계속 코타츠 안에 있고 싶어...」
								CASEELSE
									PRINTFORMW 「겨울은 역시 뿌리채소지. 맛있는 조림으로 해서 따뜻하게 먹고 싶어.」
							ENDSELECT
					ENDSELECT
					;その他の話題
				ELSE
					IF ( TALENT:恋慕 || TALENT:愛欲 ) && RAND:2
						SELECTCASE RAND:4
							CASE 1
								PRINTFORML 「있잖아, 네가 좋아하는 음식은 뭐야?」
								PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 갑자기 질문을 받았다.
								PRINTFORMW 「후우, 그럼 그 재료를 키워볼까나」
							CASE 2
								PRINTFORMW 「응? 이 향기? 후훗, 풍요의 신 특제 향수야♪」
							CASE 3
								PRINTFORML 「있잖아, 저번에 재미있는 일이 있었어.」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 몸이 닿을 정도로 가까이 다가와 즐거운 듯 이야기를 이어갔다.
							CASEELSE
								PRINTFORMW 「아, 벌써 이런 시간. 당신과 이야기하다 보니 시간이 순식간에 지나가네」
						ENDSELECT
					ELSE
						IF FLAG:なりきり != 77 && !RAND:4
							PRINTFORML 「단풍 같은 건 먹을 수 없다고 누나에게 말했더니, 단풍 튀김이 있다고 대답받았어」
							PRINTFORMW 「맛있으려나?」
						ELSEIF FLAG:なりきり != 77 && !RAND:3
							PRINTFORML 「저 말이야, 언니는 %TEXTR("すごい/ひどい/おもしろい")% 같은 사람이거든. 저번에 말이야...」
							PRINTFORMDW %CALLNAME:77%이야기를 하는 것%조사처리(CALLNAME:TARGET,"는")% 매우 즐거워 보인다.
						ELSEIF RAND:2
							PRINTFORML 「저기 %CALLNAME:MASTER%, 어느 계절이 제일 좋아?」
							PRINTFORMDW 가을이라고 답할 수밖에 없는 분위기다.
						ELSE
							;農民でなく園芸用品をもっていない
							IF !FLAG:地主 && !ITEM:園芸用品一式
								PRINTFORMW 「흙 만지는 건 좋지. 당신도 가정 텃밭 한번 해보면 어때?」
							ELSE
								PRINTFORMW 「밭 상태는 어때? 풍년은 매일의 손질뿐이야」
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			CASE -1
				PRINTFORML 「후우...」
				PRINTFORMDW %CALLNAME:TARGET%에게는 흥미 없는 화제였던 모양이다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K78_301
CALL M_KOJO_MESSAGE_COM_K78_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K78_CONSCIOUS_AND_TOLERANT()
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORMW 「정말 맛있어. 내려주는 법 가르쳐줬으면 할 정도야」
			CASE 0
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「고마워. 마침 목이 말랐어.」
					CASE 2
						PRINTFORMW 「맛있네, 고양이의 차. 나도 차를 재배해 볼까.」
					CASEELSE
						PRINTFORMW 「차 마시면서 고구마 구운 거라도 먹고 싶어지네」
				ENDSELECT
			CASE -1
				PRINTFORMW 「……지독하네」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
