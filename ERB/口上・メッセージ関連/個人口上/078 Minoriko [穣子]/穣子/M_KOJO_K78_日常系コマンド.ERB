;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K78_302
CALL M_KOJO_MESSAGE_COM_K78_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K78_CONSCIOUS_AND_TOLERANT() && !K78_EXCESSIVE_STATURE_GAP()
		$PHYSICAL_CONTACT_LOOP
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:3
				CASE 1
					CALL K78_HPH_PRINT,@"「뭐야? 응석 부리고 싶은 거야? HPH」","W"
				CASE 2
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 어깨를 맞대자 고구마처럼 달콤한 향이 났다.
					CALL K78_HPH_PRINT,@"「야, 너무 냄새 맡잖아」","W"
				CASEELSE
					PRINTFORMDL 자주 들판에 나오는데 %조사처리(CALLNAME:TARGET,"의")% 팔다리는 매끈하고 예쁘다.
					CALL K78_HPH_PRINT,@"「나도 여자애니까, 이것저것 노력하고 있는 거야 HPH」","W"
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 1
					SELECTCASE RAND:2
						CASE 1
							IF TALENT:思慕 || TALENT:セフレ
								PRINTFORMDL 정신을 차려보니 %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 어느 쪽에서든 어깨를 맞대고 있었다.
								PRINTFORMW 「언제부턴가... 정말 가까워졌네...」
							ELSE
								GOTO PHYSICAL_CONTACT_LOOP
							ENDIF
						CASEELSE
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 전신 마사지를 해 주었다.
							PRINTFORMDL 가냘파 보이지만 제대로 여성스러운 부드러움을 갖춘 몸이다.
							PRINTFORMW 「음…아아… 잘하네, %CALLNAME:MASTER%. 고마워」
					ENDSELECT
				CASE 0
					SELECTCASE RAND:3
						CASE 1
							IF ( TALENT:思慕 || TALENT:セフレ ) && !TALENT:恋人
								PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"의")% 손을 잡자, %조사처리(CALLNAME:TARGET,"는")% \@ CHK_DATENOW(CFLAG:TARGET:デート中) ? 뺨을 붉히며 # 조금 놀란 듯했지만 \@ 다시 잡아주었다.
								PRINTFORMW 「나, 뭔가 연인 같네...」
							ELSE
								GOTO PHYSICAL_CONTACT_LOOP
							ENDIF
						CASE 2
							PRINTFORMDL 어깨를 주물러 줄까 하고 %CALLNAME:TARGET%에 제안했다.
							PRINTFORMW 「기왕 이렇게 된 거 부탁해 볼까」
						CASEELSE
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 허리를 주물러 주었다.
							PRINTFORMW 「밭일은 허리를 숙이는 일이 많아서 뭉치곤 하지 않아?」
					ENDSELECT
				CASE -1
					PRINTFORML 「잠깐! 어디 만지는 거야!」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 마사지를 해주려고 했지만, 실패한 것 같다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
