				ELSE
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 부드럽고 윤기 나는 금발에 감탄했다.
					PRINTFORMW 「내 머리, 그렇게 좋아? 헤헤」
				ENDIF
			CASE 0
				IF ABL:親密 >= 6
					IF TALENT:恋慕 || TALENT:愛欲
						SELECTCASE RAND:3
							CASE 1
								IF TALENT:MASTER:性別 == 2 && TALENT:MASTER:体型 >= 0
									CALL K78_HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 손이 크네. 역시 남자니까 그렇지 HPH」","W"
								ELSE
									GOTO HEAD_PATTING_LOOP
								ENDIF
							CASE 2
								PRINTFORML 「벌써, 끝이야?」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 아쉬운 표정으로 올려다보았다.
							CASEELSE
								PRINTFORML 「당신에게 쓰다듬어지는 것 같아서, 왠지 안심돼...」
								PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈을 감고 평온한 미소를 짓고 있다.
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 1
								PRINTFORMW 「나 아이는 아닌데... 뭐... %CALLNAME:MASTER%라면 됐겠지」
							CASEELSE
								PRINTFORML 「말해두지만, 나도 이치오우 신님이거든!」
								PRINTFORMDW 그렇게 말하며 위엄을 보이려 하지만, 쓰다듬어진 채였다.
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORMW 「저, 저기. 부끄럽잖아요. 정말」
				ENDIF
			CASE -1
				PRINTFORMW 「갑자기 머리를 만지다니 실례잖아!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
