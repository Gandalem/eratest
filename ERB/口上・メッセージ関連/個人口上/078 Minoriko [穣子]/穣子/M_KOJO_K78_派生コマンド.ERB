;==================================================
;5,手淫フェラ
;==================================================

@M_KOJO_MESSAGE_SCOM_K78_5
CALL M_KOJO_MESSAGE_SCOM_K78_5_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K78_5_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF K78_BASIC_CONDITION_IN_MATING()
		$HANDJOB_AND_FELLATIO_LOOP
		IF TALENT:恋慕 || TALENT:愛欲
			IF NOWEX:MASTER:射精 && !TEQUIP:MASTER:コンドーム && EXP:精飲経験 > 0
				SELECTCASE RAND:3
					CASE 1
						;咥えたまま
						IF EXP_UP(15,TARGET) == NOWEX:PLAYER:射精 * 3
							CALL K78_HPH_PRINT,@"「응? 벌써 나올 거야? HPH 괜찮아 HPH 입안에 잔뜩 싸줘 HPH」","W"
						ELSE
							GOTO HANDJOB_AND_FELLATIO_LOOP
						ENDIF
					CASE 2
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 사정할 것이 가깝다는 것을 감지하고 손에 힘을 주며 거칠게 주물러 올렸다.
						CALL K78_HPH_PRINT,@"「자, 싸봐 HPH 내 손이랑 입으로 가득 싸는 거 보여줘 HPH」","W"
					CASEELSE
						CALL K78_HPH_PRINT,@"「아, 꿈틀거리고 있어 HPH 그럼 이대로 해버릴까 HPH 음... 쭉... 쫩」","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						CALL K78_HPH_PRINT,@"「참지 않아도 돼. HPH 하고 싶을 때는 해도 괜찮으니까 HPH」","W"
					CASE 2
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 등 근육부터 목덜미 주변을 혀끝으로 파고들 듯 자극하고 있다.
						CALL K78_HPH_PRINT,@"「음, 혀로, 쪽. 여기 기분 좋아? 아니면 이쪽이 더 좋을까? 음, 혀로.」","W"
					CASEELSE
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 꾸축꾸축 소리를 내며 뿌리 부분을 격렬하게 주무르면서 귀두를 먹고 있다.
						CALL K78_HPH_PRINT,@"「응, 흥으햣 우, 끄윽, 음흐햣 끄윽, 축축, 질질흐햣」","W"
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:3
				CASE 1
					IF TALENT:思慕 || TALENT:セフレ
						PRINTFORMW 「흐응... 츄... 핥아... 쮸빠... 점점 열중해오는걸, 이거」
					ELSE
						PRINTFORMW 「응... 음, 응츄... 후우, 입이랑 손이 지쳐버렸네」
					ENDIF
				CASE 2
					IF ABL:指 + ABL:舌 >= 3
						PRINTFORMW 「핥아... 츄... 츄루... 어때? 꽤 잘해졌지?」
					ELSE
						PRINTFORMW 「아, 안 아파? 조절을 잘 모르겠어...」
					ENDIF
				CASEELSE
					PRINTFORMW 「나올 것 같을 때 말해줘. 갑자기 하면 놀라니까」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K78_{SELECTCOM}_1
RETURN 1
