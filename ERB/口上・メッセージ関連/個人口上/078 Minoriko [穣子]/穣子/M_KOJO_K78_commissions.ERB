@COMMISSION_WORK_SITE_5_K78(Location)
	;Garden on the main map.
#DIM DYNAMIC Location
SIF !家庭菜園可(Location)
	RETURN 0
SELECTCASE COMMISSION_PROGRESS:5
	CASE 1
		PRINTFORMDL There's a faint divine presence surrounding the garden...
	CASEELSE
		PRINTFORMDL There's a strong divine presence surrounding the garden...
ENDSELECT

@COMMISSION_COMPLETE_5_K78
PRINTFORMDL The harvest goddess's blessing has invigorated your garden!
LOCAL:1 = 0
LOCAL:2 = 0
	;Get an accurate plot count without using modding branch functions.
LOCAL:3 = FLAG:畑拡張
SIF VAR_OR_DEFAULT("nGardenPlots")
	LOCAL:3 = VAR_OR_DEFAULT("nGardenPlots")
IF TALENT:MASTER:採集Lv > 5
	LOCAL:4 = 1 + 4
ELSEIF TALENT:MASTER:採集Lv > 4
	LOCAL:4 = 1 + 3
ELSEIF TALENT:MASTER:採集Lv > 2
	LOCAL:4 = 1 + 2
ELSEIF TALENT:MASTER:採集Lv > 0
	LOCAL:4 = 1 + 1
ELSE
	LOCAL:4 = 1
ENDIF
LOCAL:4 = LOCAL:4+LOCAL:3
	;Feed and grow up all of the plants a little bit.
FOR LOCAL,0,LOCAL:4
	IF PLANT_TYPE:LOCAL && !PLANT_DRY:LOCAL
		PLANT_GROW:LOCAL = MIN(PLANT_GROW:LOCAL+2,10)
		PLANT_FOOD:LOCAL = 1
		LOCAL:1 = 1
	ELSEIF !PLANT_TYPE:LOCAL && !RAND:4
			;Chance for empty plots to spawn fall crops.
		IF !RAND:2
			PLANT_TYPE:LOCAL = 171
			HATAKE_NAME:LOCAL = eggplant
		ELSE
			PLANT_TYPE:LOCAL = 173
			HATAKE_NAME:LOCAL = pumpkin
		ENDIF
		PLANT_GROW:LOCAL = 1
		PLANT_FOOD:LOCAL = 1
		LOCAL:2++
	ENDIF
NEXT
SIF LOCAL:1
	PRINTFORMDL Your crops are growing faster!
IF LOCAL:2 > 1
	PRINTFORMDL New crops have appeared!
ELSEIF LOCAL:2
	PRINTFORMDL A new crop has appeared!
ENDIF
WAIT
COMMISSION_PROGRESS:5 = 0
COMMISSION_EXPECTED_PROGRESS:5 = 0
COMMISSION_CHARACTER:5 = 0