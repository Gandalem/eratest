@COMMISSION_STATUS_K78
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(78)
IF !Commission
	PRINTFORML 「Make an offering to the gods, and you'll receive good fortune.」
	PRINTFORML 「Since it's fall, I suppose I can lend you an extra blessing or two.」
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「I'm terribly sorry, but with the soil like this, I just can't make the delivery...」
		CASE 1
			PRINTFORML 「Don't worry, I'll take care of it.」
		CASE IS < COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「I'm sorry it's taking so long! I just need a little more time.」
		CASEELSE
			IF Commission == 1
				PRINTFORML 「It's almost ready, just a little more!」
			ELSEIF Commission == 5
				PRINTFORML 「Can you feel your garden growing happier? You'll see the results quite soon.」
			ENDIF
	ENDSELECT
ENDIF

@COMMISSION_ABLE_1_K78
SIF DAY:2 != 3
		;Only available in fall.
	RETURN 0
RETURN 1

@COMMISSION_DESCRIPTION_1_K78
PRINTFORML 「That's right, for this season, I can provide you with bountiful ingredients. The delivery will be... Maybe two days?」
PRINTFORML 「In exchange, how about delivering a load of fertilizer? I can use that to help increase my worshippers.」

@COMMISSION_ACCEPT_1_K78
PRINTFORML 「Thank you! I'll get started on it soon.」

@COMMISSION_RESOLVE_1_K78
PRINTFORMW 「Thank you! I'll get you the delivery right away.」

@COMMISSION_CANCEL_1_K78
PRINTFORML 「Really? That's disappointing... but all right.」

@COMMISSION_COST_1_K78(ARG)
SELECTCASE ARG
	CASE 0
		RESULT:1 = 50
		RETURN 636
ENDSELECT

@COMMISSION_RESOLVE_COST_1_K78(ARG)
SELECTCASE ARG
	CASE 0
		RESULT:1 = 10
		RETURN 636
ENDSELECT

@COMMISSION_RATE_1_K78
RETURN 500

@COMMISSION_EVENT_1_K78
SELECTCASE RAND:20
	CASE 0
		PRINTFORMDL While rushing to fill your order, Minoriko makes a terrible discovery.
		PRINTFORML 「Oh, no! The soil is overburdened!」
		PRINTFORML 「I can't cultivate the crops like this... What should I do...?」
		PRINTFORMDW Delivery of your order has been indefinitely postponed...
		CALL COMMISSION_STALL(1)
	CASE 1
		PRINTFORMDL Minoriko finds herself unexpectedly busy.
		PRINTFORML 「Aaah, I have more orders than usual... I can't keep up!」
		PRINTFORMW 「I hope %CALLNAME:MASTER% doesn't mind %HIS_HER(MASTER)% delivery being a day late...」
		COMMISSION_PROGRESS:1 -= 500
	CASE 2
		PRINTFORMDL Minoriko's garden is flourishing unexpectedly!
		PRINTFORML 「The faith is quite strong this year... All right! I'm going to work even harder on that commission!」
		COMMISSION_PROGRESS:1 += 500
ENDSELECT

@COMMISSION_COMPLETE_1_K78
PRINTFORMDL Minoriko delivers you a package of fresh autumn ingredients!
LOCAL = 10+(RAND:11)
PRINTFORMDW Received {LOCAL} great ingredients.
ITEM:高級食材 = MIN(ITEM:高級食材+LOCAL,100)
COMMISSION_PROGRESS:1 = 0
COMMISSION_EXPECTED_PROGRESS:1 = 0
COMMISSION_CHARACTER:1 = 0

