;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K78_311
CALL M_KOJO_MESSAGE_COM_K78_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K78_BASIC_CONDITION_IN_MATING()
		IF CFLAG:うふふ == 2
		ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
		ELSE
			IF BASE:ムード >= 500 && BASE:理性 < 975
				;嬉しそうに抱き返してきた…
				IF TALENT:恋慕
					SELECTCASE RAND:2
						CASE 1
							CALL K78_HPH_PRINT,@"「나도 꼭 안아 줄게 HPH」","W"
						CASEELSE
							CALL K78_HPH_PRINT,@"「음후후 후훗, 뭔가 안심이 되는 것 같아... 후훗」","W"
					ENDSELECT
					;照れくさそうにしながらも、満更でもないようだ…
				ELSEIF TALENT:思慕
					SELECTCASE RAND:2
						CASE 1
							PRINTFORML 「흐, 움직일 수 없는데...」
							PRINTFORMDW 그렇게 말하면서도 %조사처리(CALLNAME:TARGET,"의")% 뺨은 풀려있다.
						CASEELSE
							PRINTFORMW 「또 달라붙어서... 에, 부끄럽잖아.」
					ENDSELECT
					;恥ずかしそうにしている…
				ELSE
					IF TALENT:愛欲
						SELECTCASE RAND:2
							CASE 1
								CALL K78_HPH_PRINT,@"「외롭다면 위로해 줄까 HPH」","W"
							CASEELSE
								CALL K78_HPH_PRINT,@"「이대로 밀려버리는 걸까, 후후」","W"
						ENDSELECT
					ELSE
						PRINTFORMW 「이, 갑자기 뭐야... 부끄러워...」
					ENDIF
				ENDIF
			ELSE
				IF TALENT:恋慕 || TALENT:愛欲
					PRINTFORMW 「갑자기 왜 그래?」
				ELSEIF TALENT:思慕 || TALENT:セフレ
					PRINTFORMW 「음... 뜨겁다워」
				ELSE
					PRINTFORMW 「아, 그만둬요. 너무 뜨거워요.」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K78_312
CALL M_KOJO_MESSAGE_COM_K78_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF K78_BASIC_CONDITION_IN_MATING()
		IF CFLAG:うふふ == 2
			IF TALENT:恋慕 || TALENT:愛欲
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"와")% %조사처리(CALLNAME:TARGET,"는")% 마치 연체동물의 교미처럼 혀를 얽으며, 끊임없이 분비되는 타액으로 질척거리는 구강을 탐했다.
						CALL K78_HPH_PRINT,@"「츄... 쪽... 쯧... 응 하아 HPH %CALLNAME:MASTER%, 좋아해, 사랑해 HPH」","W"
					CASE 2
						PRINTFORMDL 지독하게 달콤한%CALLNAME:TARGET%숨결에 노출되어, 반쯤 흐릿해진 정신 속에서 계속 혀를 움직였다.
						CALL K78_HPH_PRINT,@"「음... 츄읍, 응, 음후우... 쪽... 하아 HPH 아직, 더...」","W"
					CASEELSE
						PRINTFORMDL 과실처럼 달콤한 %조사처리(CALLNAME:TARGET,"의")% 타액에 빠진 %조사처리(CALLNAME:MASTER,"는")%, 시간이 흐르는 것도 잊고 무심하게 맛을 음미했다.
						CALL K78_HPH_PRINT,@"「음무... 쭉... 츄ㅍㅎ ...졸, 졸르륵... 츄파ㅍㅎ」","W"
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「쪽... 음... 하아... 음무... 쪽... 응...」
					CASEELSE
						PRINTFORMW 「음... 쪽... 음쪽... 응... 흠... 쪽」
				ENDSELECT
			ENDIF
			;キス拒絶ではない
		ELSEIF TFLAG:193 != 99
			IF BASE:ムード >= 650 && BASE:理性 < 875
				IF TALENT:恋慕 || ( TALENT:愛欲 && ( ABL:親密 >= 5 || ABL:欲望 >= 5 ) )
					SELECTCASE RAND:2
						CASE 1
							CALL K78_HPH_PRINT,@"「쪽, 쪽... 음쪽, 움음... 흠후 HPH 벌써 끝이야? HPH」","W"
						CASEELSE
							CALL K78_HPH_PRINT,@"「음마... 응츄... 핥아... 쪽... 쪽파 HPH 헤헤, 키스라니 좋네 HPH」","W"
					ENDSELECT
				ELSEIF ABL:親密 >= 5 || ABL:欲望 >= 5
					SELECTCASE RAND:2
						CASE 1
							PRINTFORMW 「응... 음... 츄... 하아...」
						CASEELSE
							PRINTFORMW 「응츄... 추... 음무... 응...」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 1
							PRINTFORML 「음, 음... 쪽... 하앗, 하아...」
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 말없이 얼굴을 새빨갛게 하고 있다.
						CASEELSE
							PRINTFORML 「응응... 츄... 응... 츄...」
							PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 잠시 저항하려 했지만, %조사처리(CALLNAME:MASTER,"가")% 어깨를 감자 가만히 그 것을 받아들였다.
					ENDSELECT
				ENDIF
			ELSE
				IF TALENT:恋慕 || ( TALENT:愛欲 && ( ABL:親密 >= 5 || ABL:欲望 ) )
					PRINTFORMW 「응... 쪽... 쪽... 응, 너무 거칠잖아」
				ELSE
					PRINTFORMW 「응!? 갑, 갑자기 뭐 하는 거야!」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
