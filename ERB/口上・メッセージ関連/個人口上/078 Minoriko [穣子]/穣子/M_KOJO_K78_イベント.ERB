;Custom dialogue settings, custom code
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;made it as a way to speed up the update process and separate simple flag updates from various customization options
;note: options start from 1!

@KOJO_OPTION_K78
SELECTCASE CFLAG:78:1001
	CASE 0
		LOCALS:0 '= @"정상"
	CASE 1
		LOCALS:0 '= @"출산"
	CASE 2
		LOCALS:0 '= @"모유 의존적인"
	CASEELSE
		LOCALS:0 = ※CFLAG:78:1001の値が不正※
ENDSELECT
SELECTCASE CFLAG:78:1002
	CASE 0
		LOCALS:1 '= @"스캐터 없음"
	CASE 1
		LOCALS:1 '= @"산발 존재"
	CASEELSE
		LOCALS:1 = ※CFLAG:78:1002の値が不正※
ENDSELECT
CALL KOJO_OPTION_ITEM(@"내용 설정 유두 색소침착: %LOCALS:0% 항문 성관계 상세: %LOCALS:1%")
;process the input portion

@KOJO_OPTION_K78_RESULT_1
PRINTFORMDL %CALLNAME:78%의 유두 색깔이나 항문 성 중 배설물 존재 등이 변경 가능하다.
$UPDATE_LOOP
VARSET LOCALS
SELECTCASE CFLAG:78:1001
	CASE 0
		LOCALS:0 '= @"변경하지 마라"
	CASE 1
		LOCALS:0 '= @"출산 후에만 변경한다"
	CASE 2
		LOCALS:0 '= @"출산 여부와 관계없이 모유 수유에 따라 변경한다."
	CASEELSE
		LOCALS:0 = ※CFLAG:78:1001の値が不正※
ENDSELECT
SELECTCASE CFLAG:78:1002
	CASE 0
		LOCALS:1 '= @"스캐터 없음"
	CASE 1
		LOCALS:1 '= @"산발 존재"
	CASEELSE
		LOCALS:1 = ※CFLAG:78:1002の値が不正※
ENDSELECT
PRINTL
PRINTFORMDL 현재 유두 설정: %LOCALS:0% 현재 스캣 설정: %LOCALS:1%
PRINTL
CALL ASK_M("유두 설정 변경",1,"스케치 설정을 변경한다",1,"확인",1)
SELECTCASE RESULT
	CASE 0
		IF CFLAG:78:1001 >= 2
			CFLAG:78:1001 = 0
		ELSE
			CFLAG:78:1001 += 1
		ENDIF
		PRINTL
		GOTO UPDATE_LOOP
	CASE 1
		CFLAG:78:1002 = !CFLAG:78:1002
		PRINTL
		GOTO UPDATE_LOOP
	CASE 2
		PRINTFORMDL 유두 설정은 [%LOCALS:0%]으로 설정된다.
		PRINTFORMDL 흩뿌리기 설정이 [%LOCALS:1%]으로 변경되었다.
		PRINTFORMDW 이 설정들은 또한 $ll$1$gg$으로 기도할 때 접근 가능합니다. %CALLNAME:78%.
ENDSELECT
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"ENCOUNTER"系イベント（エクストラ構文）
