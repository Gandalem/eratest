;==================================================

@M_KOJO_EVENT_K78_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL K78_HAIR_GROWTH,78
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		CALL DIALOGUE_K78_GREET_ONCE_A_DAY
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		CALL DIALOGUE_K78_GREET_ONCE_A_DAY
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF K78_CONSCIOUS_AND_TOLERANT()
			PRINTFORMW 「아, %조사처리(CALLNAME:MASTER,"가")% 있었네. 있잖아, 같이 들어가도 돼?」
		ENDIF
		SIF SHIRAHU(TARGET)
			TCVAR:78:352 = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		CALL DIALOGUE_K78_GREET_ONCE_A_DAY
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TCVAR:353 != ARG:1 && K78_CONSCIOUS_AND_TOLERANT()
			;静葉とデート
			IF ARG:1 == 77 && FLAG:なりきり != 77
				IF TALENT:恋人 || ( TALENT:恋慕 && !TALENT:77:恋人 )
					PRINTFORML 「우~ 누님, 너무 달라붙어 버려요」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:77%에 대한 대항심을 드러내며 따졌다.
				ELSE
					PRINTFORMW 「누나랑 외출? 잘 다녀와.」
				ENDIF
				;さっきと違う相手とデート
			ELSEIF TCVAR:353 != 0
				IF TALENT:恋慕 || TALENT:恋人
					PRINTFORML 「또 여자를 바꿔치기하고...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 노려졌다.
				ELSE
					PRINTFORML 「왜 데이트 상대가 아까랑 다르다는 거야...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 질책당했다.
				ENDIF
			ELSE
				IF TALENT:恋慕 || TALENT:恋人
					PRINTFORML 「참 사이가 좋아 보이네……」
					PRINTFORMDW 여자 동행을 한 %조사처리(CALLNAME:MASTER,"를")% 본 %조사처리(CALLNAME:TARGET,"는")% 재미없어 보이는 모습이다.
				ELSEIF TALENT:思慕
					PRINTFORML 「후우. %조사처리(CALLNAME:MASTER,"는")% 얼굴이 넓구나...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 무뚝뚝한 모습으로 %조사처리(CALLNAME:MASTER,"와")% %CALLNAME:(ARG:1)%를 한 번 힐끗 보았다.
				ELSE
					PRINTFORM 「あ、%CALLNAME:MASTER%。
					SELECTCASE TIME:0
						CASE IS <600
							PRINTFORMW 「안녕」
						CASE 600 TO 1139
							PRINTFORMW 「안녕하세요」
						CASE IS >= 1140
							PRINTFORMW こんばんは」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
		IF SHIRAHU(TARGET)
			TCVAR:78:352 = 1
			TCVAR:78:353 = ARG:1
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;### その日の初対面時あいさつ口上用関数 ################
;遭遇口上で呼び出される

@DIALOGUE_K78_GREET_ONCE_A_DAY
IF !TCVAR:352 && K78_CONSCIOUS_AND_TOLERANT()
	PRINTFORM 「あ、%CALLNAME:MASTER%。
	;非同棲
	IF CFLAG:MASTER:初期位置 != CFLAG:初期位置
		SELECTCASE TIME:0
			CASE IS <600
				PRINTFORMW 「안녕」
			CASE 600 TO 1139
				PRINTFORMW 「안녕하세요」
			CASE IS >= 1140
				PRINTFORMW こんばんは」
		ENDSELECT
		;同棲orお招き
	ELSE
		PRINTFORML ここにいたんだ」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯한 모습으로 %조사처리(CALLNAME:MASTER,"에게")% 다가왔다.
	ENDIF
ENDIF
SIF SHIRAHU(TARGET)
	TCVAR:78:352 = 1
;==================================================
;朝起きたとき（おはよう口上）
;==================================================

@M_KOJO_EVENT_K78_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF SHIRAHU(TARGET)
		TCVAR:78:352 = 1
	CALL K78_HAIR_GROWTH,78
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF K78_CONSCIOUS_AND_TOLERANT()
				IF TALENT:恋慕 || TALENT:愛欲
					CALL K78_HPH_PRINT,@"「미안, 깨웠을까……. 왠지 당신이 보고 싶어져서 HPH」","W"
				ELSEIF TALENT:思慕 || TALENT:セフレ
					PRINTFORML 「아, 안녕」
					PRINTFORMDL 왜 %조사처리(CALLNAME:TARGET,"가")% 있는 걸까.
					PRINTFORMW 「뭐, 그냥 슬쩍 들러봤을 뿐이야」
				ELSE
					PRINTFORMW 「일어났어? 잠깐 물건 좀 빌릴게」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF K78_CONSCIOUS_AND_TOLERANT()
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「안녕%CALLNAME:MASTER%. 자, 오늘은 밭 가꾸기라도 할까나」
				CASE 2
