@M_KOJO_EVENT_K78_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF K78_BASIC_CONDITION_IN_MATING()
					;「下着姿にする」を経由せずに全裸になった場合
					IF !TEQUIP:上着脱衣済み
						;腋毛ありかつ全裸になる前から腋が見えている
						IF CFLAG:1007 && K78_ARMPIT_EXPOSURE()
							IF CFLAG:1007 >= 3
								PRINTFORMDL 방금부터 팔을 내리고 있어도 겨드랑이의 거친 털이 조금씩 드러나 있었지만, 옷을 벗으면서 겨드랑이를 벌리자 어쩔 줄 몰라 하는 그것이 그대로 드러난다.
							ELSE
								PRINTFORMDL 벗기 전부터 겨드랑이의 \@ CFLAG:1007 == 2 ? 털 # 남은 것 \@がチラチラと見えていたが、服を脱ぐ際に腕をあげると\@ CFLAG:1007 == 2 ? 덥수룩한 # 혹들 \@한 것이 선명하게 보인다.
							ENDIF
							SIF !TEQUIP:アイマスク
								PRINTFORML 「이제 그만, 계속 겨드랑이만 보고 있잖아. 계속 보고 있다는 걸 알고 있었다고.」
							PRINTL
						ENDIF
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%, %조사처리(CALLNAME:TARGET,"가")% 벗어가는 것을 가만히 감상하며 조금씩 피부가 드러나는 모습을 즐겼다.
						IF ( TALENT:恋慕 || TALENT:愛欲 || TALENT:思慕 || TALENT:セフレ ) && ABL:露出癖 >= 2 && TALENT:機嫌 >= 0 && BASE:ムード >= 900 && BASE:理性 < 500
							PRINTFORMDL %CALLNAME:TARGET%도 흥미로운 듯, 자랑하듯이 천천히 옷을 벗었다.
							SIF !TEQUIP:アイマスク
								CALL K78_HPH_PRINT,@"「코 밑에 거뭇하게 자라고 있어 HPH %조사처리(CALLNAME:MASTER,"의")% 섹시한 HPH」","L"
						ELSEIF TALENT:恋慕 || TALENT:愛欲
							PRINTFORMDL 옷을 벗자 달콤한 향기가 더욱 강해졌고, 드러나는 요염한 자태와 어우러진 색기에 %조사처리(CALLNAME:MASTER,"는")% 정신을 잃을 정도였다.
							CALL K78_HPH_PRINT,@"「나만 이러면 부끄럽잖아 HPH, 당신도 벗어줘 HPH」","L"
						ELSEIF !TEQUIP:アイマスク
							PRINTFORML 「그렇게 많이 보여지면 부끄러운데」
						ENDIF
						;「下着姿にする」を経由して全裸になった場合
					ELSE
						PRINTFORMDL 속옷을 벗고 모든 것을 드러낸%조사처리(CALLNAME:TARGET,"의")% 육체는 조각처럼 균형이 잡혀 아름답다.
						PRINTFORM 「네, 전부 벗었어요」
						IF TALENT:恋慕 || TALENT:愛欲
							CALL K78_HPH_PRINT,@"HPH라면, 더 좋은 일 하자 HPH","L"
						ELSE
							PRINTFORML 」
						ENDIF
					ENDIF
					;全裸になってはじめて腋が露出した、かつ腋汗ジミあり
					IF !K78_ARMPIT_EXPOSURE() && K78_SWEATY_UNDERARMS()
						PRINTL
						SELECTCASE CFLAG:1007
							CASE 0,1
								PRINTFORMDL 축축해져서 겨드랑이에 얼룩이 생긴 옷을 벗자, 땀으로 번들거리는 겨드랑이가 드러났다.
							CASE 2,3
								PRINTFORMDL 털이 자라고 있는 탓도 있는지 옷에 얼룩이 생길 정도로 축축한 겨드랑이는 벗자마자 진한 냄새를 풍기기 시작했다.
						ENDSELECT
						PRINTFORML 「...조금 더워서 땀이 나버렸어」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 살짝 얼굴을 붉히고 있다.
						;全裸になってはじめて腋が露出した、かつ腋毛あり
					ELSEIF !K78_ARMPIT_EXPOSURE() && CFLAG:1007
						PRINTL
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 전라가 되자, %K78_ARMPIT_HAIR_MODIFIER()%의 겨드랑이가 드러났다.
						CALL K78_HPH_PRINT,@"「말해준 대로 하고 있잖아 HPH 어때? 기뻐?」","L"
					ENDIF
					WAIT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF K78_BASIC_CONDITION_IN_MATING()
					;腋毛ありかつ下着姿になる前から腋が見えている
					IF CFLAG:1007 && K78_ARMPIT_EXPOSURE()
						IF CFLAG:1007 >= 3
							PRINTFORMDL 방금부터 팔을 내리고 있어도 겨드랑이의 거친 털이 조금씩 드러나 있었지만, 옷을 벗으면서 겨드랑이를 벌리자 어쩔 줄 몰라 하는 그것이 그대로 드러난다.
						ELSE
							PRINTFORMDL 벗기 전부터 겨드랑이의 \@ CFLAG:1007 == 2 ? 털 # 남은 것 \@がチラチラと見えていたが、服を脱ぐ際に腕をあげると\@ CFLAG:1007 == 2 ? 덥수룩한 # 혹들 \@한 것이 선명하게 보인다.
						ENDIF
						SIF !TEQUIP:アイマスク
							PRINTFORML 「이제 그만, 계속 겨드랑이만 보고 있잖아. 계속 보고 있다는 걸 알고 있었다고.」
						PRINTL
					ENDIF
					PRINTFORMDL 상의를 벗어 내려가는%CALLNAME:TARGET%모습은 굉장한 색기를 풍기면서도, 늘씬한 사지에는 소녀다움이 남아 있었다.
					IF TALENT:恋慕 || TALENT:愛欲
						;ノーパンでなくパンツ指定もなし
						IF !CFLAG:ノーパン && !CFLAG:指定パンツ
							CALL K78_HPH_PRINT,@"「오늘 속옷 어때? HPH 이런 거 좋아해? HPH」","L"
						ELSE
							CALL K78_HPH_PRINT,@"「속옷 안 입는 게 더 좋아? 알겠어 HPH 너 이런 거 좋아하는구나 HPH」","L"
						ENDIF
					ELSE
						PRINTFORML 「전부 벗지 않고 속옷 차림이 좋은 거야? 후훗, 알았어」
					ENDIF
					;下着姿になってはじめて腋が露出した、かつ腋汗ジミあり
					IF !K78_ARMPIT_EXPOSURE() && K78_ARMPIT_EXPOSURE(TARGET,1) && K78_SWEATY_UNDERARMS()
						PRINTL
						SELECTCASE CFLAG:1007
							CASE 0,1
								PRINTFORMDL 축축해져서 겨드랑이에 얼룩이 생긴 옷을 벗자, 땀으로 번들거리는 겨드랑이가 드러났다.
							CASE 2,3
								PRINTFORMDL 털이 자라고 있는 탓도 있는지 옷에 얼룩이 생길 정도로 축축한 겨드랑이는 벗자마자 진한 냄새를 풍기기 시작했다.
						ENDSELECT
						PRINTFORML 「...조금 더워서 땀이 나버렸어」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 살짝 얼굴을 붉히고 있다.
						;下着姿になってはじめて腋が露出した、かつ腋毛あり
					ELSEIF !K78_ARMPIT_EXPOSURE() && K78_ARMPIT_EXPOSURE(TARGET,1) && CFLAG:1007
						PRINTL
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 상의를 벗자, %K78_ARMPIT_HAIR_MODIFIER()%가 드러났다.
						CALL K78_HPH_PRINT,@"「말해준 대로 하고 있잖아 HPH 어때? 기뻐?」","L"
					ENDIF
					WAIT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				IF K78_BASIC_CONDITION_IN_MATING()
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 0
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
