SIF !K78_CONSCIOUS_AND_TOLERANT(ARG)
	RETURNF 0
SIF TALENT:ARG:SexKnow == -1
	RETURNF 0
SIF K78_EXCESSIVE_STATURE_GAP(ARG)
	RETURNF 0
RETURNF 1
