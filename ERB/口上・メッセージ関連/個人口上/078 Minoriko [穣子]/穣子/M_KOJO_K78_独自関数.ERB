;以下、体毛関係の関数
;### 体毛変更用メイン関数 ################
;しらふかつ恋慕or愛欲のある状態で浴場で会話すると呼び出される

@K78_HAIR_TREATMENT
#DIM 陰毛or腋毛 ;1=陰毛について 2=腋毛について
#DIM CFL番号変換 ;CFLAG番号用 0=陰毛 4=腋毛
$HAIR_TREATMENT_LOOP
CALL ASK_M("음모에 대해 부탁하다", 1, "겨드랑이 털에 대해 부탁한다", 1, "평범하게 대화한다", 1)
IF RESULT < 2
	陰毛or腋毛 = RESULT + 1
	CFL番号変換 = (陰毛or腋毛 - 1) * 4
	;毛の状態を表示
	CALL K78_HAIR_STATUS,陰毛or腋毛
	;どの毛に変えてもらうか選択肢
	IF 陰毛or腋毛 == 1
		CALL ASK_M("매끈하게 만들다", CFLAG:1004 != -2, "면도 후 잔여물을 남긴다.", CFLAG:1004 != -1, "보통으로 정리한다.", CFLAG:1004 != 0, "풍성하게 만든다", CFLAG:1004 != 1, "보풀이 되게 하다", CFLAG:1004 != 2, "역시 그만둘까", 1)
		SIF RESULT == 5
			GOTO HAIR_TREATMENT_LOOP
		;どの陰毛に変更するかが決まる
		CFLAG:78:1004 = RESULT - 2
	ELSE
		CALL ASK_M("매끈하게 만들다", CFLAG:1008 != 0, "면도 후 잔여물을 남긴다.", CFLAG:1008 != 1, "풍성하게 만든다", CFLAG:1008 != 2, "보풀이 되게 하다", CFLAG:1008 != 3, "역시 그만둘까", 1)
		SIF RESULT == 4
			GOTO HAIR_TREATMENT_LOOP
		;どの腋毛に変更するかが決まる
		CFLAG:78:1008 = RESULT
	ENDIF
	;毛を伸ばす場合
	IF CFLAG:(1003 + CFL番号変換) < CFLAG:(1004 + CFL番号変換)
		;情景描写
		CALL K78_HAIR_TREATMENT_DESCRIPTIVE_TEXTS,陰毛or腋毛,1
		;毛の生長の計算のために現時点の毛の状態と現時点の総日数を保存
		CFLAG:78:(1005 + CFL番号変換) = CFLAG:(1003 + CFL番号変換)
		CFLAG:78:(1006 + CFL番号変換) = DAY:0
		;伸ばすのをやめて現状維持に切り替える場合
	ELSEIF CFLAG:(1003 + CFL番号変換) == CFLAG:(1004 + CFL番号変換)
		;情景描写
		CALL K78_HAIR_TREATMENT_DESCRIPTIVE_TEXTS,陰毛or腋毛,-1
		;毛を剃る場合
	ELSE
		;主人が剃るか調教対象に剃らせるか選択
		CALL ASK_YN(@"%조사처리(CALLNAME:MASTER,"가")% 깎는다",@"%조사처리(CALLNAME:TARGET,"에게")% 깎게 하다")
		;選択に応じて情景描写
		CALL K78_HAIR_TREATMENT_DESCRIPTIVE_TEXTS,陰毛or腋毛,(RESULT + 2)
		;剃るときは伸ばす場合と違い変更がすぐに反映される
		CFLAG:78:(1003 + CFL番号変換) = CFLAG:(1004 + CFL番号変換)
	ENDIF
	RETURN 1
ENDIF
;「普通に会話する」を選んだばあい返り値を０にして通常の会話口上に移行する
RETURN 0
;### 体毛の状態表示用関数 ##################
;ARG 1=陰毛 2=腋毛

@K78_HAIR_STATUS,ARG
VARSET LOCALS
VARSET LOCAL
PRINTL
IF ARG == 1
	;陰毛の状態の名称を設定（現在の分と目標の分のふたつ）
	FOR LOCAL,0,2
	SELECTCASE CFLAG:TARGET:(1003 + LOCAL)
		CASE -2
			LOCALS:LOCAL = 깔끔하게 매끈하다
		CASE -1
			LOCALS:LOCAL = 면도 자국이 거칠다
		CASE 0
			LOCALS:LOCAL = 보통(기본값)
		CASE 1
			LOCALS:LOCAL = 자연스러운 풍성함
		CASE 2
			LOCALS:LOCAL = 부스스하고 지저분하다
		CASEELSE
			LOCALS:LOCAL = ※CFLAG:{TARGET}:{1003 + LOCAL}의 값이 부정함※
	ENDSELECT
	NEXT
	;現在の陰毛の状態を表示する。いま伸ばしてもらっているところなら、目標の陰毛と生えきるまでの残り日数も表示する。
	PRINTFORMDL 현재의 음모: %LOCALS:0% \@ CFLAG:1003 == CFLAG:1004 ? 당신의 지정: 현재의 음모를 유지한다 # 당신의 지정: %LOCALS:1% 자라날 때까지 앞으로 {(CFLAG:1004 - CFLAG:1005) * 2 - (DAY:0 - CFLAG:1006)}일 \@
ELSEIF ARG == 2
	;腋毛の状態の名称を設定（現在の分と目標の分のふたつ）
	FOR LOCAL,0,2
	SELECTCASE CFLAG:TARGET:(1007 + LOCAL)
		CASE 0
			LOCALS:LOCAL = 매끄러움(기본값)
		CASE 1
			LOCALS:LOCAL = 면도 자국이 거칠다
		CASE 2
			LOCALS:LOCAL = 자연스러운 풍성함
		CASE 3
			LOCALS:LOCAL = 부스스하고 지저분하다
		CASEELSE
			LOCALS:LOCAL = *CFLAG:{TARGET}:{1007 + LOCAL}의 값이 부정함*
	ENDSELECT
	NEXT
	;現在の腋毛の状態を表示する。いま伸ばしてもらっているところなら、目標の腋毛と生えきるまでの残り日数も表示する。
	PRINTFORMDL 현재의 겨드랑이털 : %LOCALS:0% \@ CFLAG:1007 == CFLAG:1008 ? 당신의 지정 : 현재의 겨드랑이털을 유지한다 # 당신의 지정 : %LOCALS:1% 자라날 때까지 앞으로 {(CFLAG:1008 - CFLAG:1009) * 2 - (DAY:0 - CFLAG:1010)}일 \@
ENDIF
PRINTL
;### 体毛変更の情景描写用関数 ##################
;ARG:0 1=陰毛 2=腋毛
;ARG:1 -1=伸ばすのをやめて現状維持に切り替える 1=伸ばす 2=主人が剃る 3=調教対象が自分で剃る

@K78_HAIR_TREATMENT_DESCRIPTIVE_TEXTS,ARG:0,ARG:1
DRAWLINE
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{TARGET}
;陰毛関係
IF ARG:0 == 1
	SELECTCASE ARG:1
		;現状維持に切り替える場合
		CASE -1
			PRINTFORMDW 지금의 음모 그대로 있어 달라고 %조사처리(CALLNAME:TARGET,"에게")% 부탁했다.
			;伸ばす場合
		CASE 1
			PRINTFORMD 음모를
			;指定した陰毛による分岐
			SELECTCASE CFLAG:1004
				CASE -1
					PRINTFORMD 조리조리한 감촉이 어느 정도 생겨서
				CASE 0
					PRINTFORMD 아주 평범하게 해줘
				CASE 1
					PRINTFORMD 그다지 손질하지 않아 진하게 만들고
				CASE 2
					PRINTFORMD 복슬복슬한 정글이 될 때까지 기르세요
			ENDSELECT
			PRINTFORMDL 받고 싶다고 %조사처리(CALLNAME:TARGET,"에게")% 부탁했다.
			PRINTW
			;台詞表示（伸ばすお願い）
			TRYCCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,1,1
			PRINTL
			CATCH
			ENDCATCH
			PRINTFORMDW 아무래도 자랄 때까지 {(CFLAG:1004 - CFLAG:1003) * 2}일 정도 걸리는 것 같다.
			;主人が剃る場合
		CASE 2
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")%, 음모를 면도해 달라고 부탁했다.
			PRINTW
			;台詞表示（剃らせてもらうお願い）
			TRYCCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,1,2,1
			PRINTL
			CATCH
			ENDCATCH
			PRINTFORMD %조사처리(CALLNAME:MASTER,"는")%
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMD 게처럼 네 발로 기는 %조사처리(CALLNAME:TARGET,"의")% 다리 밑으로 파고들자,
				CASE 2
					PRINTFORMD 등을 대고 누운 %조사처리(CALLNAME:TARGET,"의")% 다리를 벌리자,
				CASEELSE
					PRINTFORMD 네 발로 기어 있는 %조사처리(CALLNAME:TARGET,"의")% 사타구니를 들여다보니,
			ENDSELECT
			;剃毛前の陰毛による分岐
			SELECTCASE CFLAG:1003
				CASE -1
					PRINTFORMD 희미하게 돋아난 음모를
				CASE 0
					PRINTFORMD 깔끔하게 정리된 음모를
				CASE 1
					PRINTFORMD 손질되지 않아 짙게 무성해진 음모를
				CASE 2
					PRINTFORMD 항문 주변까지 빽빽하게 자란 강모를
			ENDSELECT
			;剃毛後の陰毛による分岐
			SELECTCASE CFLAG:1004
				CASE -2
					PRINTFORMDL 면도하고 아이처럼 매끄러운 가랑이로 만들었다.
				CASE -1
					PRINTFORMDL 자신 취향대로 면도 자국이 남도록 정성껏 면도했다.
				CASE 0
					PRINTFORMDL 깔끔하게 정돈해 주었다.
				CASE 1
					PRINTFORMDL 손질했지만, 그래도 아직 은밀한 곳을 덮는 털은 짙다.
			ENDSELECT
			PRINTW
			;台詞表示（MASTERが剃ったあと）
			TRYCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,1,2,2
			;調教対象が自分で剃る場合
		CASE 3
			PRINTFORMDL 음모를 면도하는 것을 보여달라고 %조사처리(CALLNAME:TARGET,"에게")% 부탁했다.
			PRINTW
			;台詞表示（剃るのを見せてもらうお願い）
			TRYCCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,1,3,1
			PRINTL
			CATCH
			ENDCATCH
			PRINTFORMD 유카에 놓인 손거울을 가로지르듯이 웅크렸다.
			;剃毛前の陰毛による分岐
			SELECTCASE CFLAG:1003
				CASE -1
					PRINTFORMD 피부 위에 조금만 나오는 딱딱한 털을 밀어 올린다.
				CASE 0
					PRINTFORMD 음모를 깎는다
				CASE 1
					PRINTFORMD 음부를 덮는 많은 털을 면도한다.
				CASE 2
					PRINTFORMD 밀림처럼 우거진 머리에 손을 넣는다.
			ENDSELECT
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 모습에, %조사처리(CALLNAME:MASTER,"는")% 흥분을 느꼈다.
			PRINTW
			;台詞表示（TARGETが剃ったあと）
			TRYCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,1,3,2
	ENDSELECT
	;腋毛関係
ELSEIF ARG:0 == 2
	SELECTCASE ARG:1
		;現状維持に切り替える場合
		CASE -1
			PRINTFORMDW 지금의 겨드랑이털 그대로 있어 달라고 %조사처리(CALLNAME:TARGET,"에게")% 부탁했다.
			;伸ばす場合
		CASE 1
			PRINTFORMD 겨드랑이털을
			;指定した腋毛による分岐
			SELECTCASE CFLAG:1008
				CASE 1
					PRINTFORMD 깎고 난 후에 희미하게 색이 돌 정도의
				CASE 2
					PRINTFORMD 생기게 하여
				CASE 3
					PRINTFORMD 길러 두었다
			ENDSELECT
			PRINTFORMDL 갖고 싶다고 %조사처리(CALLNAME:TARGET,"에게")% 부탁했다.
			PRINTW
			;台詞表示（伸ばすお願い）
			TRYCCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,2,1
			PRINTL
			CATCH
			ENDCATCH
			PRINTFORMDW 아무래도 자라기까지 {(CFLAG:1008 - CFLAG:1007) * 2}일 정도 걸리는 것 같다.
			;主人が剃る場合
		CASE 2
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")%, 겨드랑이 털을 밀어 달라고 부탁했다.
			PRINTW
			;台詞表示（剃らせてもらうお願い）
			TRYCCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,2,2,1
			PRINTL
			CATCH
			ENDCATCH
			PRINTFORMD %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 팔을 올리게 하자,
			;剃毛前の腋毛による分岐
			SELECTCASE CFLAG:1007
				CASE 1
					PRINTFORMD 거칠게 느껴지는 면도 잔여물을
				CASE 2
					PRINTFORMD 겨드랑이털을
				CASE 3
					PRINTFORMD 흐트러지게 자란 겨드랑이털을
			ENDSELECT
			;剃毛後の腋毛による分岐
			SELECTCASE CFLAG:1008
				CASE 0
					PRINTFORMDL 완전히 밀어버렸다.
				CASE 1
					PRINTFORMDL 주의 깊게 면도하고, 원하는 면도 자국을 남겼다.
				CASE 2
					PRINTFORMDL 다듬었다. 하지만 아직 머리카락이 남아있다.
			ENDSELECT
			PRINTW
			;台詞表示（MASTERが剃ったあと）
			TRYCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,2,2,2
			;調教対象が自分で剃る場合
		CASE 3
			PRINTFORMDL 겨드랑이털을 밀어주는 것을 보여달라고 %조사처리(CALLNAME:TARGET,"에게")% 부탁했다.
			PRINTW
			;台詞表示（剃るのを見せてもらうお願い）
			TRYCCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,2,3,1
			PRINTL
			CATCH
			ENDCATCH
			PRINTFORMD %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"가")% 한쪽 팔을 들고
			;剃毛前の腋毛による分岐
			SELECTCASE CFLAG:1007
				CASE 1
					PRINTFORMD 겨드랑이의 불필요한 털을
				CASE 2
					PRINTFORMD 겨드랑이털을
				CASE 3
					PRINTFORMD 겨드랑이의 굵은 털을
			ENDSELECT
			PRINTFORMDL 자르는 모습을 거울을 통해 자세히 관찰했다.
			PRINTW
			;台詞表示（TARGETが剃ったあと）
			TRYCALLFORM DIALOGUE_K{TARGET}_HAIR_TREATMENT,2,3,2
	ENDSELECT
ENDIF
;### 体毛変更の台詞用関数 ##################
;ARG:0 1=陰毛 2=腋毛
;ARG:1 1=伸ばす 2=主人が剃る 3=調教対象が自分で剃る
;ARG:2 表示タイミング 1=剃毛をお願いしたとき 2=剃ったとき

@DIALOGUE_K78_HAIR_TREATMENT,ARG:0,ARG:1,ARG:2
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;陰毛の変更
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:0 == 1
		;-------------------------------------------------
		;伸ばすお願い
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:2 = 1
		;-------------------------------------------------
		IF LOCAL:2 && ARG:1 == 1
			SELECTCASE CFLAG:1004
				CASE -1
					PRINTFORML 「주문이 까다롭네……」
				CASE 1
					PRINTFORML 「진한 게 좋은 거야?」
				CASE 2
					IF FIRSTTIME("陰毛をボーボーにする",0,78)
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 조금 주저했지만, %조사처리(CALLNAME:MASTER,"의")% 끈질긴 부탁에 어떻게든 승낙해 주었다.
						PRINTFORMW 「그렇게 자유롭게 자라는 게 좋은 거야...? 뭐, 나는 풍요의 신이니까 못 할 건 없지만...」
						PRINTFORMW 「뭐, 원래 진한 거 아니야. 수확의 힘으로 만들어낼 수는 없다고 말하는 거야읏」
						RETURN 1
					ENDIF
					PRINTFORML 「또 멍하니 있는 거야? 너도 참 좋아...」
			ENDSELECT
			PRINTFORMW 「알았어. 하지만 시간이 걸릴 테니까 기다려줘.」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERが剃る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:2 = 1
		;-------------------------------------------------
		IF LOCAL:2 && ARG:1 == 2
			;-------------------------------------------------
			;剃らせてもらうお願い
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 1
				IF FIRSTTIME("主人に剃毛される（陰毛）",0,78)
					PRINTFORMW 「저쪽 털 관리? 별로 상관없는데……. 에, 당신이 지금부터 면도하는 거야?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 부끄러워하는 %조사처리(CALLNAME:TARGET,"를")% 달래주며, 제모에 착수했다.
					RETURN 1
				ENDIF
				PRINTFORML 「당신이 해주지 않아도, 스스로 할 수 있는데…….」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 말을 흘려듣고 음모 제모에 착수했다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
			;MASTERが剃ったあと
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 2
				SELECTCASE CFLAG:1004
					CASE -2
						PRINTFORMW 「개운하긴 했는데, 왠지 마음이 편치 않아.」
					CASE -1
						PRINTFORMW 「사각사각해서 이상한 감촉이야」
					CASE 0
						PRINTFORMW 「응, 좋아. 면도 잘하는구나」
					CASE 1
						PRINTFORMW 「역시 너무 진했을까」
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
		;-------------------------------------------------
		;TARGETが剃る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:2 = 1
		;-------------------------------------------------
		IF LOCAL:2 && ARG:1 == 3
			;-------------------------------------------------
			;剃るのを見せてもらうお願い
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 1
				IF FIRSTTIME("自分で剃毛する（陰毛）",0,78)
					PRINTFORMW 「저기 그 털을 깎는 걸 보고 싶어? 싫어. 부끄럽잖아」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 거부하는 %조사처리(CALLNAME:TARGET,"를")% 필사적으로 설득했다.
					PRINTFORMW 「알, 알았어……. 하아, 이런 게 뭐가 재미있다는 거야?」
					RETURN 1
				ENDIF
				PRINTFORML 「또 볼 생각이야? 뭐 됐어. 얼른 끝내버릴 테니까」
				RETURN 1
			ENDIF
			;-------------------------------------------------
			;TARGETが剃ったあと
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 2
				PRINTFORML 「네, 밀었어요. 이걸로 됐나요?」
				PRINTFORMW 「정말이지. 이런 일엔 괜히 까다롭긴」
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;腋毛の変更
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:0 == 2
		;-------------------------------------------------
		;伸ばすお願い
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:2 = 1
		;-------------------------------------------------
		IF LOCAL:2 && ARG:1 == 1
			IF FIRSTTIME("腋毛を生やす",0,78)
				PRINTFORMW 「겨드랑이털? 그런 게 좋아하는 거야?」
				PRINTFORMW 「음, \@ FLAG:なりきり == 77 ? 다른 애들 # 누나 같은 거 \@에게 보여지면 부끄럽잖아...」
				PRINTFORMDW 한참 %CALLNAME:TARGET%동안 %조사처리(CALLNAME:MASTER,"는")% 계속 졸랐다.
				PRINTFORMW 「그, 그렇게 많이 자라줬으면 하는 거야? %조사처리(CALLNAME:MASTER,"가")% 그 정도 말한다면...」
				RETURN 1
			ENDIF
			SELECTCASE CFLAG:1008
				CASE 1
					PRINTFORML 「사각거리는 게 좋아? 대체 그 이상한 고집은 뭐지……」
				CASE 2
					PRINTFORML 「역시 기르는 건 부끄럽지만…」
				CASE 3
					PRINTFORML 「멍청하다니 참 특이하네...」
			ENDSELECT
			PRINTFORMW 「뭐, 괜찮아. 시간이 좀 걸릴 것 같으니까 기다리고 있어.」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERが剃る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:2 = 1
		;-------------------------------------------------
		IF LOCAL:2 && ARG:1 == 2
			;-------------------------------------------------
			;剃らせてもらうお願い
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 1
				IF FIRSTTIME("主人に剃毛される（腋毛）",0,78)
					PRINTFORMW 「겨드랑이털을 밀고 싶다고…… 정말 이상한 사람」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 어이없어하는 듯 겨드랑이 제모를 시작했다.
					PRINTFORMW 「당신의 얼굴이 가까워서…… 조금 부끄러울지도…」
					RETURN 1
				ENDIF
				PRINTFORML 「네, 네 또 밀 거야.」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 체념한 듯한 표정으로 겨드랑이를 드러냈다.
				RETURN 1
			ENDIF
			;-------------------------------------------------
			;MASTERが剃ったあと
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 2
				SELECTCASE CFLAG:1008
					CASE 0
						PRINTFORMW 「응, 개운해」
					CASE 1
						PRINTFORMW 「면이 남았어... 다른 애들에게 흐트러져 보일 거야」
					CASE 2
						PRINTFORMW 「좀 더 밀어줘도 되는데」
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
		;-------------------------------------------------
		;TARGETが剃る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:2 = 1
		;-------------------------------------------------
		IF LOCAL:2 && ARG:1 == 3
			;-------------------------------------------------
			;剃るのを見せてもらうお願い
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 1
				IF FIRSTTIME("自分で剃毛する（腋毛）",0,78)
					PRINTFORMW 「또 이상한 소리를 시작했어……」
					PRINTFORMW 「…좋긴 하지만 별로 즐거운 건 아니야.」
					RETURN 1
				ENDIF
				PRINTFORML 「보는 건 괜찮지만 방해하지 말아줘.」
				RETURN 1
			ENDIF
			;-------------------------------------------------
			;TARGETが剃ったあと
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:3 = 1
			;-------------------------------------------------
			IF LOCAL:3 && ARG:2 == 2
				PRINTFORML 「네, 끝났어요」
				PRINTFORMW 「%CALLNAME:MASTER%, 계속 보고 있었던 것 같은데, 잘 안 질리네요.」
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;### 体毛生長処理用関数 ##################
;遭遇、起床、すれ違いの口上で呼び出される
;ARG=キャラ番号（省略不可）

@K78_HAIR_GROWTH,ARG
FOR LOCAL,0,8,4
;現在の体毛が目標の体毛に満たない場合、経過日数に応じた増加後の値を計算し現在の体毛に代入する
IF CFLAG:ARG:(1003 + LOCAL) < CFLAG:ARG:(1004 + LOCAL)
	CFLAG:ARG:(1003 + LOCAL) = CFLAG:ARG:(1005 + LOCAL) + (DAY:0 - CFLAG:ARG:(1006 + LOCAL)) / 2
	;目標の体毛を超えることはない
	SIF CFLAG:ARG:(1003 + LOCAL) > CFLAG:ARG:(1004 + LOCAL)
		CFLAG:ARG:(1003 + LOCAL) = CFLAG:ARG:(1004 + LOCAL)
ENDIF
NEXT
;### 陰毛描写用式中関数 ##################
;ARG=キャラ番号

@K78_GENITAL_HAIR_MODIFIER(ARG)
#FUNCTIONS
VARSET LOCALS
SIF ARG == 0
	ARG = TARGET
SELECTCASE CFLAG:ARG:1003
	CASE -2
		SELECTCASE RAND:3
			CASE 1
				LOCALS = 無毛の
			CASE 2
				LOCALS = 子供のようにツルツルの
			CASEELSE
				LOCALS = 毛の生えていない
		ENDSELECT
	CASE -1
		SELECTCASE RAND:3
			CASE 1
				LOCALS = 生えかけの毛でブツブツの
			CASE 2
				LOCALS = じょりじょりした毛の生えた
			CASEELSE
				LOCALS = 剃り残しの毛のある
		ENDSELECT
	CASE 0
		LOCALS =
	CASE 1
		SELECTCASE RAND:3
			CASE 1
				LOCALS = 毛の濃い
			CASE 2
				LOCALS = 毛が多めの
			CASEELSE
				LOCALS = 毛深い
		ENDSELECT
	CASE 2
		SELECTCASE RAND:3
			CASE 1
				LOCALS = 密林の下の
			CASE 2
				LOCALS = 剛毛に隠れてほとんど見えない
			CASEELSE
				LOCALS = モジャモジャの縮れ毛に覆われた
		ENDSELECT
	CASEELSE
		LOCALS = ※CFLAG:{ARG}:1003の値が不正※
ENDSELECT
RETURNF LOCALS
