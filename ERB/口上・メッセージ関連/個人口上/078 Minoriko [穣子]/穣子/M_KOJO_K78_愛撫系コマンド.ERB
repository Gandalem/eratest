		RETURN 1
	ENDIF
	IF !TEQUIP:乳首吸い && !K78_EXCESSIVE_STATURE_GAP() && ( TEQUIP:上半身着衣状況 == 0 || ( TEQUIP:上半身はだけ状態 && ( TEQUIP:上半身着衣状況 & 4 ) == 0 ) )
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMDL %K78_NIPPLE_MODIFIER()%유두 주위에 감싼 손가락을 새끼손가락부터 검지까지 리듬감 있게 구부렸다 펴며, \@ TALENT:母乳体質 ? 모유를 짜내기 위해 # 젖을 짜듯이 \@마사지했다.
			CASE 2
				PRINTFORMDL \@ TALENT:母乳体質 ? 유선의 발달로 탄력 있는 가슴을 주무르듯이 만지며 # 부드러운 가슴을 마음껏 주물러 감상하면서 \@들, %K78_NIPPLE_MODIFIER()%젖꼭지를 손끝으로 집어 올렸다.
			CASEELSE
				PRINTFORMDL %K78_NIPPLE_MODIFIER()%유두를 부지런히 자극하자, \@ TALENT:母乳体質 ? 모유를 먹게 하자 #  \@유두가 점차 %TEXTR("ピンと/固く/ムクムクと")% 발기해왔다.
		ENDSELECT
	ENDIF
	IF K78_BASIC_CONDITION_IN_MATING()
		$NIPPLE_KNEADING_LOOP
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:5
				CASE 1
					IF TALENT:母乳体質
						CALL K78_HPH_PRINT,@"「더 만져줘 HPH 가슴을 비비고 싶어 HPH」","L"
					ELSE
						GOTO NIPPLE_KNEADING_LOOP
					ENDIF
				CASE 2
					IF TALENT:母乳体質
						CALL K78_HPH_PRINT,@"「젖꼭지 엄청나다아 HPH 가슴이 쭈욱쭈욱 HPH 하앙 HPH」","L"
					ELSE
						GOTO NIPPLE_KNEADING_LOOP
					ENDIF
				CASE 3
					CALL K78_HPH_PRINT,@"「응, 음음흐으... 하아흐으 유두인데... 왜 이렇게 느껴지는 걸까 흐으」","L"
				CASE 4
					CALL K78_HPH_PRINT,@"「응아 HPH 아...앗 HPH 당신의 손가락이라 정말 기분 좋아 HPH」","L"
				CASEELSE
					CALL K78_HPH_PRINT,@"「끝이 좋아아앙 HPH 더 만지고 싶어애 HPH」","L"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					IF ABL:MASTER:指 >= 4
						PRINTFORML 「앗, 응아, 음... 왜 그렇게 잘하는 거야...」
					ELSE
						GOTO NIPPLE_KNEADING_LOOP
					ENDIF
				CASE 2
					PRINTFORML 「아, 후앗, 유두가 간질간질해... 음응」
				CASEELSE
					PRINTFORML 「아, 응! 강해, 기분 좋아... 아앗」
			ENDSELECT
		ENDIF
	ENDIF
	SIF ( !TEQUIP:乳首吸い && !K78_EXCESSIVE_STATURE_GAP() && ( TEQUIP:上半身着衣状況 == 0 || ( TEQUIP:上半身はだけ状態 && ( TEQUIP:上半身着衣状況 & 4 ) == 0 ) ) ) || K78_BASIC_CONDITION_IN_MATING()
