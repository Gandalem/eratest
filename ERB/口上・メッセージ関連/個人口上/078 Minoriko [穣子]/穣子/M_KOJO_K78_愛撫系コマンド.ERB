	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF CFLAG:1003
		PRINTFORMDL %K78_GENITAL_HAIR_MODIFIER()%비밀스러운 곳이 %조사처리(CALLNAME:TARGET,"의")% 손에 드러나자, 달콤한 향기가 퍼져왔다.
		SELECTCASE CFLAG:1003
			CASE -2
				PRINTFORMDL 털이 전혀 없는 그곳은 소녀의 신성한 순수함을 두드러지게 한다.
			CASE -1
				PRINTFORMDL 치열 주변의 거칠고 단단해 보이는 짧은 털이 생생하게 역겹다.
			CASE 1
				PRINTFORMDL 비밀을 헤집는 무성함은 특별히 감미로운 향을 풍긴다.
			CASE 2
				PRINTFORMDL 울창한 수풀 깊은 곳에 어렴풋이 보이는 붉은 점막이 %조사처리(CALLNAME:MASTER,"의")% 정욕을 간지럽힌다.
		ENDSELECT
	ENDIF
	IF K78_CONSCIOUS_AND_TOLERANT() && TALENT:SexKnow > -1
		IF TALENT:恋慕 || TALENT:愛欲
			IF ABL:露出癖 - TALENT:羞恥心 >= 3
				IF TCVAR:Vに中出しされたフラグ
					;主人以外が直前に中出し
					IF TCVAR:Vに中出ししたキャラの番号 > 0 && FLAG:なりきり != TCVAR:Vに中出ししたキャラの番号
						CALL K78_HPH_PRINT,@"「봐 HPH \@ TCVAR:Vに中出ししたキャラの番号 == 77 ? 누나 # %CALLNAME:(TCVAR:Vに中出ししたキャラの番号)% \@에게 나온 정액이 이렇게 HPH」","L"
						;主人にペニスあり
						SIF TALENT:MASTER:性別 & 2
							CALL K78_HPH_PRINT,@"「당신 이외의 정액, 당신의 거시기(오친치)로 다 짜내버릴 거야 HPH 당신의 정액으로 덮어씌워 버려 HPH」","L"
					ELSE
						;ピルなし、非安全日
						IF !TCVAR:ピル && CFLAG:生理周期 >= 3
							CALL K78_HPH_PRINT,@"「피임 안 하고 이렇게 많이 내다니... 정말 아기 생길지도 몰라 HPH」","L"
						ELSE
							CALL K78_HPH_PRINT,@"「아하 HPH 당신의 정액이 넘쳐온다 HPH」","L"
						ENDIF
					ENDIF
				ELSE
					IF ABL:膣 >= 2 && PALAM:潤滑 >= PALAMLV:3 && RAND:2
						CALL K78_HPH_PRINT,@"「안 할 거야? 여긴 벌써 준비됐다고, HPH」","L"
					ELSE
						CALL K78_HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"에게")% 보이면... 몸이 떨려와요... HPH」","L"
					ENDIF
				ENDIF
			ELSE
				IF TCVAR:Vに中出しされたフラグ
					CALL K78_HPH_PRINT,@"「야아 HPH 넘쳐버릴 것 같아 HPH」","L"
				ELSEIF !TEQUIP:アイマスク && RAND:2
					CALL K78_HPH_PRINT,@"「그렇게 뚫어지게 쳐다보지 마, 후후.」","L"
				ELSE
					CALL K78_HPH_PRINT,@"「응... 너무 부끄러워어어 HPH」","L"
				ENDIF
			ENDIF
		ELSE
			IF ABL:露出癖 >= 2
				PRINTFORML 「보고만 있는 것 같아서... 뭔가 마음이 놓이지 않아...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 만져주길 바라는 듯, 기대에 찬 눈을 %조사처리(CALLNAME:MASTER,"에게")% 향하고 있다.
			ELSE
				PRINTFORML 「그런 곳을 보는 게 그렇게 즐거운 거야?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 눈살을 찌푸리면서도 마지못해 %조사처리(CALLNAME:MASTER,"의")% 말에 따랐다.
			ENDIF
		ENDIF
	ENDIF
	SIF CFLAG:1003 || ( K78_CONSCIOUS_AND_TOLERANT() && TALENT:SexKnow > -1 )
		WAIT
ENDIF
RETURN 1
