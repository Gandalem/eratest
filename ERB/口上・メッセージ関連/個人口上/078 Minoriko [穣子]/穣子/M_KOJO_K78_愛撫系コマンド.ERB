@M_KOJO_MESSAGE_COM_K78_4
CALL M_KOJO_MESSAGE_COM_K78_4_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_4_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF K78_BASIC_CONDITION_IN_MATING()
			PRINTFORMW 「잠, 잠깐! 어디를 핥는 거야」
			PRINTFORMDW 불결한 구멍을 헤집고 나온 %조사처리(CALLNAME:MASTER,"에게")% %조사처리(CALLNAME:TARGET,"는")% 소리쳤다.
			PRINTFORMW 「거긴 다르다고 했잖아 하앗... 후아... 아, 안, 아앙!」
			PRINTFORMDW 거부하는 %조사처리(CALLNAME:TARGET,"의")% 팔을 붙잡고 집요하게 계속 핥자, 점차 저항이 약해지며 요염한 목소리가 새어 나왔다.
		ENDIF
		RETURN 1
	ENDIF
	IF !K78_EXCESSIVE_STATURE_GAP()
		IF CFLAG:1002 && TCVAR:351 && RAND:2
			SELECTCASE RAND:9
				CASE 1 TO 4
					PRINTFORMDL 배변 후의 %TEXTR("肛門/アヌス/尻の穴")%은 강렬한 악취를 풍기고 있다.
				CASE 5 TO 8
					PRINTFORMDL 배설물의 잔재를 핥는다는 뒤틀린 행위가 %조사처리(CALLNAME:MASTER,"의")% 흥분에 박차를 가했다.
				CASEELSE
					PRINTFORMDL 소화되지 않고 남은 %TEXTR("コーンの皮/ニラ/トマトの皮")%이 항문에 붙어 있었다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMDL 몸속으로 침입하려는 혀에 반응하여 %TEXTR("肛門/アヌス/尻の穴")%이 움찔거리며 움직이고 있다.
				CASE 2
					PRINTFORMDL \@ CFLAG:1003 == 2 && RAND:3 ? %TEXTR("だらしなく/下品な/豊かな")%털에 스치면서 #  \@%TEXTR("肛門/アヌス/尻の穴")%%TEXTR("に舌を這わせる/をねぶる")%と, \@ CFLAG:1002 && !TCVAR:351 ? 대변의 냄새가 은은하게 느껴졌다. # %조사처리(CALLNAME:TARGET,"의")% 숨결이 헉헉하고 얕고 빠르게 변해왔다. \@
				CASEELSE
					SELECTCASE ABL:アナル
						CASE IS >= 4
							PRINTFORMD %TEXTR("ほぐれきった/開発されきった/使い込まれた")%
						CASE 2,3
							PRINTFORMD %TEXTR("開発途上の/ほぐれはじめた/性器へと変わりつつある")%
						CASE IS <= 1
							PRINTFORMD %TEXTR("キュッとすぼまった/かたく閉じた/まだまだ未開発の")%
					ENDSELECT
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% %TEXTR("肛門/アヌス/尻の穴")%는 침으로 젖어 야릇하게 빛나고 있다.
			ENDSELECT
		ENDIF
		IF K78_BASIC_CONDITION_IN_MATING()
			IF TALENT:恋慕 || TALENT:愛欲
				SELECTCASE RAND:3
					CASE 1
						CALL K78_HPH_PRINT,@"「싫어, 응가하는 곳을 핥으면 안 돼 HPH」","L"
					CASE 2
						CALL K78_HPH_PRINT,@"「더럽다고 HPH 안 돼도 HPH 아, 큭, 하아응 HPH」","L"
					CASEELSE
						CALL K78_HPH_PRINT,@"「아, 하프 키, 기분 좋지만... 역시 이런 건 안 돼어, 하프」","L"
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「그런 곳을 핥는 건, 아앗, 그, 역시 변태 너무 심해, 응윽」
					CASEELSE
						PRINTFORML 「더러워라고, 이제 그만둬요. 아, 응아앗」
				ENDSELECT
			ENDIF
		ENDIF
		WAIT
	ENDIF
ENDIF
RETURN 1
