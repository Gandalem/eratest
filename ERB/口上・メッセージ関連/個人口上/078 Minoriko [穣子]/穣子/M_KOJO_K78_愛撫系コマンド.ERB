@M_KOJO_MESSAGE_COM_K78_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「핥는 거야? 그, 더럽지 않아? 냄새 같은 거... 괜찮을까?」
		PRINTFORMDW 얼굴이 붉어진 %조사처리(CALLNAME:TARGET,"의")% 곳을 핥자 평소의 달콤한 좋은 향기가 느껴졌다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;陰毛が非デフォルトで大きな体格差なし
	IF CFLAG:1003 && !K78_EXCESSIVE_STATURE_GAP()
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 가랑이에 얼굴을 파묻고, %K78_GENITAL_HAIR_MODIFIER()% 외음부에 혀를 갖다 댄다.
		SELECTCASE CFLAG:1003
			CASE -2
				PRINTFORMDL 매끄러운 감촉이 기분 좋다.
			CASE -1
				PRINTFORMDL 자라나는 음모가 코끝에 간질거리는 것이 느껴진다.
			CASE 1
				PRINTFORMDL 부드러운 털이 %조사처리(CALLNAME:MASTER,"의")% 뺨을 쓸었다.
			CASE 2
				PRINTFORMDL 볼륨감 있는 털에 얼굴을 반쯤 파묻고 정글 속을 혀로 탐험했다.
		ENDSELECT
		PRINTL
	ENDIF
	IF K78_BASIC_CONDITION_IN_MATING()
		$CUNNILINGS_LOOP
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:9
				CASE 1
					IF NOWEX:Ｃ絶頂
						CALL K78_HPH_PRINT,@"「앗 HPH 그거 굉장해! HPH 미쳐버릴 것 같아, 미쳐버릴 거야 HPH」","L"
						PRINTFORMDL 절정을 맞이하려는 %조사처리(CALLNAME:TARGET,"는")%, %조사처리(CALLNAME:MASTER,"의")% 얼굴을 허벅지로 꽉 눌렀다.
					ELSE
						GOTO CUNNILINGS_LOOP
					ENDIF
				CASE 2
					IF ABL:MASTER:舌 >= 3
						CALL K78_HPH_PRINT,@"「앗, 야아 HPH 혀, 굉장해서 HPH 안 돼애 HPH」","L"
					ELSE
						GOTO CUNNILINGS_LOOP
					ENDIF
				CASE 3
					IF !TEQUIP:縄 && !TEQUIP:拘束 && !TEQUIP:シックスナイン
						PRINTFORMDL 쿤니링스를 하고 있자 %조사처리(CALLNAME:TARGET,"에게")% 머리를 쓰다듬어졌다.
						CALL K78_HPH_PRINT,@"「음? 괜히 쓰다듬고 싶어졌어, HPH」","L"
					ELSE
						GOTO CUNNILINGS_LOOP
					ENDIF
				CASE 4
					IF !TEQUIP:アイマスク && !TEQUIP:シックスナイン
						PRINTFORMDL 민감한 부분을 혀로 애무하자 질 입구뿐만 아니라 항문도 움찔거리며 귀엽다.
						CALL K78_HPH_PRINT,@"「저기, 어디 보고 있는 거야 HPH」","L"
					ELSE
						GOTO CUNNILINGS_LOOP
					ENDIF
				CASE 5
					IF PALAM:潤滑 >= PALAMLV:4
						PRINTFORMDL 은밀한 곳에서는 달콤한 꿀 같은 액체가 멈추지 않고 넘쳐흐르고, 핥아도 핥아도 끝이 없다.
						CALL K78_HPH_PRINT,@"「야, HPH 하지 말고 HPH 소리, 부끄럽단 말이야 HPH」","L"
					ELSE
						GOTO CUNNILINGS_LOOP
					ENDIF
				CASE 6
					IF PALAM:潤滑 < PALAMLV:3
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 잠들어 있는 사이에, 질이 조금씩 애액을 흘리기 시작했다.
						CALL K78_HPH_PRINT,@"「앗 HPH 오츠유가...HPH」","L"
					ELSE
						GOTO CUNNILINGS_LOOP
					ENDIF
				CASE 7
					IF ( EXP:絶頂経験 - EXP:無自覚絶頂経験 ) >= 35
						CALL K78_HPH_PRINT,@"「후훗, 고마워 HPH. 언제나 기분 좋게 해줘서 HPH.」","L"
					ELSE
						PRINTFORML 「아, 너무 세게 하지 말아줘」
					ENDIF
				CASE 8
					CALL K78_HPH_PRINT,@"「응! 하아앙! 아아앙! \@ TALENT:性別 & 2 ? 거시기 # 클리 \@좋아!하아앙!」","L"
				CASEELSE
					CALL K78_HPH_PRINT,@"「하아, 응하아... 좋아! HPH %CALLNAME:MASTER%HPH 기분 좋아!」","L"
			ENDSELECT
		ELSE
			IF ( TALENT:思慕 || TALENT:セフレ ) && !RAND:5
				PRINTFORML 「또 애무해 줄 거야? 기쁘지만, 무리하지 않아도 괜찮으니까.」
				PRINTFORMDL 배려할 필요 없다는 듯 충분히 봉사했다.
			ELSE
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「응... 하아...... 아, 거기는...!」
					CASEELSE
						PRINTFORML 「앗, 하아윽 거기, 기분 좋아」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	SIF ( CFLAG:1003 && !K78_EXCESSIVE_STATURE_GAP() ) || K78_BASIC_CONDITION_IN_MATING()
		WAIT
ENDIF
RETURN 1
