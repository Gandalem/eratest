		PRINTL
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMDL %K78_NIPPLE_MODIFIER()%유두를 입에 물고 유두를 혀끝으로 건드리자, 점차 단단하게 솟아오른다.
			CASE 2
				PRINTFORMDL 드러난 %조사처리(CALLNAME:TARGET,"의")% 젖꼭지에 빨아들이자, %K78_NIPPLE_MODIFIER()% 그것은 은은하게 달콤한 맛이 난다.
			CASEELSE
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%, %K78_NIPPLE_MODIFIER()% 유두를 유륜째 통째로 삼키듯 빨아들였고, 붉은 자국이 남을 정도로 강하게 빨았다.
		ENDSELECT
		IF TALENT:母乳体質
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMDL 유두에서 흘러나온 달콤한 모유가 %조사처리(CALLNAME:MASTER,"의")% 목을 촉촉하게 적셨다.
				CASE 2
					PRINTFORMDL 부풀어 오른 정맥이 도드라지고 단단하게 솟은 가슴에서 힘차게 모유가 분출되어, %조사처리(CALLNAME:MASTER,"의")% 입안 가득 독특한 달콤한 맛이 퍼졌다.
				CASEELSE
					PRINTFORMDL 부글부글하고 분수처럼 뿜어져 나온 많은 모유가 %조사처리(CALLNAME:MASTER,"의")% 입에서 넘쳐, 하얀 물방울이 떨어졌다.
			ENDSELECT
		ENDIF
	ENDIF
	IF K78_BASIC_CONDITION_IN_MATING()
		$NIPPLE_SUCKING_LOOP
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE RAND:6
				CASE 1
					IF TALENT:母乳体質 && TALENT:母性
						CALL K78_HPH_PRINT,@"「네네 HPH 정말 좋아하는 가슴이야~ HPH 아하하♪ 귀여울지도」","L"
					ELSE
						GOTO NIPPLE_SUCKING_LOOP
					ENDIF
				CASE 2
					IF TALENT:母乳体質
						CALL K78_HPH_PRINT,@"「응! HPH 마셔줘 HPH 내 가슴 쪽쪽 해줘 HPH」","L"
					ELSE
						GOTO NIPPLE_SUCKING_LOOP
					ENDIF
				CASE 3
					IF TALENT:母乳体質
						CALL K78_HPH_PRINT,@"「아, 굉장해 HPH 가슴이 쭉쭉 나오네 HPH 잔뜩 나오는걸요 HPH」","L"
					ELSE
						GOTO NIPPLE_SUCKING_LOOP
					ENDIF
				CASE 4
					IF !TALENT:母乳体質
						CALL K78_HPH_PRINT,@"「야 HPH 그렇게 빨아도 가슴은 안 나온다고 했잖아 HPH」","L"
					ELSE
						GOTO NIPPLE_SUCKING_LOOP
					ENDIF
				CASE 5
					CALL K78_HPH_PRINT,@"「유두를 핥아주니, 아아 하아 기분 정말 좋아」","L"
				CASEELSE
					CALL K78_HPH_PRINT,@"「유두가 간지러워요 HPH 더 세게 빨아줘 HPH 쪽쪽 해줘 HPH」","L"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					IF EXP:出産経験 == 0
						PRINTFORML 「아기가 태어나면 이런 느낌일까」
					ELSE
						GOTO NIPPLE_SUCKING_LOOP
					ENDIF
				CASE 2
					PRINTFORML 「응으윽, 하앗... 응... 유두로 느껴져... 안!」
				CASEELSE
					PRINTFORML 「응, 아, 응쿠읏... 핥아주지 마, 응으읏」
			ENDSELECT
		ENDIF
	ENDIF
	SIF ( !K78_EXCESSIVE_STATURE_GAP() && ( TEQUIP:上半身着衣状況 == 0 || ( TEQUIP:上半身はだけ状態 && ( TEQUIP:上半身着衣状況 & 4 ) == 0 ) ) ) || K78_BASIC_CONDITION_IN_MATING()
		WAIT
