LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF CFLAG:1002 && TCVAR:Aに中出しされたフラグ
		PRINTFORMDL 항문에서 흘러나오는 정액은 장 속의 분비물과 섞여 마블 모양으로 색을 띠고 있다.
	ELSEIF CFLAG:1003 >= 2
		PRINTFORMDL 벌거장이 된 %조사처리(CALLNAME:TARGET,"의")% 항문 주변에는 털이 저속하게 무성해져 음탕함을 더하고 있었다.
	ENDIF
	IF K78_CONSCIOUS_AND_TOLERANT() && TALENT:SexKnow > -1
		IF TALENT:恋慕 || TALENT:愛欲
			SELECTCASE ABL:露出癖
				CASE IS >= 5
					IF TCVAR:Aに中出しされたフラグ
						IF TALENT:MASTER:性別 & 2 && RAND:2
							CALL K78_HPH_PRINT,@"「정액으로 축축해진 엉덩이, 분명 정말 기분 좋을 거야 HPH. 그렇지? 또 거시기 넣을게 HPH」","L"
						ELSE
							CALL K78_HPH_PRINT,@"「\@ TCVAR:Aに中出ししたキャラの番号 == MASTER ? 당신의 #  \@ 정액으로 질척거리는 엉덩이 구멍을 보고 싶어 HPH」","L"
						ENDIF
					ELSE
						IF ABL:アナル >= 2 && RAND:2
							CALL K78_HPH_PRINT,@"「보는 것만으로는 안 돼, HPH 엉덩이 만져줬으면 좋겠어 HPH」","L"
						ELSE
							CALL K78_HPH_PRINT,@"「내 더러운 변 구멍 보고 흥분하고 있어? HPH 변태니까 HPH」","L"
						ENDIF
					ENDIF
				CASE 3,4
					IF TCVAR:Aに中出しされたフラグ
						CALL K78_HPH_PRINT,@"「\@ TCVAR:Aに中出ししたキャラの番号 == MASTER ? %조사처리(CALLNAME:MASTER,"에게")% #  \@가 잔뜩 흘러넘쳐버리는 HPH」","L"
					ELSE
						CALL K78_HPH_PRINT,@"「그렇게까지 엉덩이 구멍 보고 싶은 거야? 냄새 같은 거 맡으면 안 돼 HPH.」","L"
					ENDIF
				CASE IS <= 2
					CALL K78_HPH_PRINT,@"「당신이니까 하는 거잖아, 음란하다고 생각하지 마요」 HPH","L"
			ENDSELECT
		ELSE
			SELECTCASE ABL:露出癖
				CASE IS >= 5
					PRINTFORMDL 부끄러운 곳을 보이고 흥분했는지, %조사처리(CALLNAME:TARGET,"는")% 참지 못하는 듯 클리토리스를 만지작거렸다.
					PRINTFORML 「있잖아... 보기만 할 거야?」
				CASE 3,4
					PRINTFORML 「여자아이에게 이런 수치스러운 차림을 입히다니…」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 미간을 찌푸리면서도 스스로 엉덩이 살을 옆으로 밀어 항문을 드러냈다.
				CASE IS <= 2
					PRINTFORMDL 아니 아니 하고 고개를 저었던 %CALLNAME:TARGET%였지만, %조사처리(CALLNAME:MASTER,"의")% 간청에 져 눈물 그렁해진 채 항문을 열어 보였다.
					PRINTFORML 「이런 건... 너무 부끄러워...」
			ENDSELECT
		ENDIF
	ENDIF
	SIF ( CFLAG:1002 && TCVAR:Aに中出しされたフラグ ) || CFLAG:1003 >= 2 || ( K78_CONSCIOUS_AND_TOLERANT() && TALENT:SexKnow > -1 )
		WAIT
ENDIF
RETURN 1
