@M_KOJO_MESSAGE_COM_K78_0_1
#DIM 腋フラグ
腋フラグ = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF !TEQUIP:継続キス && !TEQUIP:乳首吸い && !K78_EXCESSIVE_STATURE_GAP() && !RAND:3
		;腋汗ジミあり
		IF K78_SWEATY_UNDERARMS()
			PRINTFORMDL \@ K78_ARMPIT_SWEAT() == 2 ? 성적 흥분 때문인지 # 겨드랑이가 축축해져서 \@, %조사처리(CALLNAME:TARGET,"의")% 겨드랑이에 땀으로 인한 얼룩이 짙게 생겼다.
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 거기에 얼굴을 가까이 대고 농후한 향기를 즐겼다.
			腋フラグ = 1
			;腋が露出してる
		ELSEIF K78_ARMPIT_EXPOSURE()
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 전신을 애무하면서, %K78_ARMPIT_HAIR_MODIFIER()% 겨드랑이를 핥아 올렸다.
			SELECTCASE CFLAG:1007
				CASE 0,1
					PRINTFORMDL \@ CFLAG:1007 == 0 ? 매끄러워 # 거칠어 \@\@ K78_ARMPIT_SWEAT() ? 그곳은 달콤한 향이 나는 땀으로 촉촉하게 젖어 있다. # 그 감촉이 기분 좋다. \@
				CASE 2,3
					PRINTFORMD \@ CFLAG:1007 == 2 ? 부드러운 겨드랑이털 # 보송보송한 겨드랑이털 \@
					IF K78_ARMPIT_SWEAT()
						PRINTFORMDL 그녀는 땀으로 축축해졌고, 평소의 군고구마 같은 달콤한 향과는 다른 체취를 풍기고 있다.
					ELSE
						PRINTFORMDL 얼굴을 파고들어, 혀로 헤치면서 %조사처리(CALLNAME:TARGET,"의")% 겨드랑이를 맛본다.
					ENDIF
			ENDSELECT
			腋フラグ = 1
		ENDIF
	ENDIF
	IF K78_BASIC_CONDITION_IN_MATING()
		$PETTING_LOOP
		IF TALENT:恋慕 || TALENT:愛欲
			IF 腋フラグ
				SELECTCASE RAND:4
					CASE 1
						IF K78_ARMPIT_SWEAT()
							CALL K78_HPH_PRINT,@"「안 돼, 흐으... 지금 땀 흘리고 있으니까 맡지 마아!」","L"
						ELSE
							GOTO PETTING_LOOP
						ENDIF
					CASE 2
						CALL K78_HPH_PRINT,@"「얀, 겨드랑이는 부끄러워」","L"
					CASE 3
						CALL K78_HPH_PRINT,@"「또 이상한 곳을 핥고 있네 HPH」","L"
					CASEELSE
						CALL K78_HPH_PRINT,@"「겨드랑이는 간지럽기만 하네 HPH」","L"
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 1
						IF EXP_UP(27,TARGET)
							CALL K78_HPH_PRINT,@"「아후, 응. 더 키스 받고 싶어... HPH」","L"
						ELSE
							GOTO PETTING_LOOP
						ENDIF
					CASE 2
						CALL K78_HPH_PRINT,@"「당신의 손가락에 만져지는 게 너무 좋아 HPH」","L"
					CASE 3
						CALL K78_HPH_PRINT,@"「응, 기분 좋아...... 더 해줘 HPH」","L"
					CASE 4
						CALL K78_HPH_PRINT,@"「아흐으, 가슴이 좋다. 음... 그래, 부드럽게 해줘.」","L"
					CASEELSE
						CALL K78_HPH_PRINT,@"「\@ TALENT:性別 & 2 ? 좆 # 클리 \@좋아! 더 만져줘어!」","L"
				ENDSELECT
			ENDIF
		ELSE
			IF 腋フラグ
				PRINTFORML 「잠깐! 겨드랑이는 그만둬요!」
			ELSEIF EXP_UP(27,TARGET) && RAND:2
				PRINTFORML 「음... 응... 쪽... 아, 하아-」
			ELSE
				PRINTFORML 「아... 응, 흠, 하앗 으응앗」
			ENDIF
		ENDIF
	ENDIF
	SIF 腋フラグ || K78_BASIC_CONDITION_IN_MATING()
		WAIT
ENDIF
RETURN 1
