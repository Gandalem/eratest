;==================================================
;45,アナルバイブ
;==================================================

@M_KOJO_MESSAGE_COM_K78_45
CALL M_KOJO_MESSAGE_COM_K78_45_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K78_45_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	IF K78_BASIC_CONDITION_IN_MATING()
		;装着
		IF TEQUIP:アナルバイブ
			IF TALENT:恋慕 || TALENT:愛欲
			ELSE
			ENDIF
			;解除
		ELSE
			IF 充填率(TARGET,2) >= 60 && !RAND:3
				IF CFLAG:1002
					IF ( TALENT:恋慕 || TALENT:愛欲 ) && !TCVAR:351 && !RAND:5
						PRINTFORMDL 이마에 식은땀을 흘리며 변의를 참던 %CALLNAME:TARGET%였지만, 마침내 한계를 맞았다. 항문은 순식간에 입을 벌리더니 부추부추 하는 격렬한 소리와 함께 정액이 섞인 대변을 사방으로 뿌렸다.
						CALL DIALOGUE_K78_DEFECATION_IN_MATING
					ELSEIF !TCVAR:351 && RAND:2
						PRINTFORMDL 넘치도록 사정을 항문에 흘려 넣었는지, %조사처리(CALLNAME:TARGET,"의")% 배가 꾸르륵 울렸다.
						PRINTFORMDL 변의를 느끼면서도 필사적으로 참는 듯하다.
					ELSE
						PRINTFORMDL \@ 充填率(TARGET,2) >= 100 ? 배가 부풀 정도로 # 대량의 \@정액을 주입당한%조사처리(CALLNAME:TARGET,"는")%, 장액이 섞여 독특한 냄새를 풍기는%TEXTR("정액/자멘/씨물/백탁액")%을%TEXTR("항문/아누스/똥구멍")%에서 흘려내고 있다.
					ENDIF
				ELSE
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 항문에서 바이브를 빼자, 직장에 대량 주입되었던 %TEXTR("精液/ザーメン/子種汁/白濁液")%가 천천히 흘러내렸다.
				ENDIF
			ELSE
				IF CFLAG:1002 && ( TALENT:恋慕 || TALENT:愛欲 ) && !TCVAR:351 && !RAND:20
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 문득 안절부절못하기 시작하더니, 큰 방귀 소리와 함께 질척한 설사 기미가 있는 변을 항문에서 분출했다.
					CALL DIALOGUE_K78_DEFECATION_IN_MATING
				ELSEIF CFLAG:1002 && !RAND:5
					PRINTFORMDL 바이브의 진동에 자극받아 장이 연동하기 시작했는지, %조사처리(CALLNAME:TARGET,"는")% %TEXTR("ぷすぅー/ブウゥ/ボバッ/ぶぴっ")%와 방귀를 뀌어버렸다.
					CALL DIALOGUE_K78_FARTING_IN_MATING
				ELSE
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")%%TEXTR("항문/아누스/엉덩이 구멍")%은\@ TALENT:MASTER:性別 & 2 ? %TEXTR("육봉/음경/페니스/물건")% # 딜도 \@가 빠져나간 뒤에도 여전히%TEXTR("활짝/뻐끔뻐끔/실룩실룩")% 입을 벌린 채,%TEXTR("항문 안쪽의 붉은 살/번들번들한 점막")%을 드러내고 있다.
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
