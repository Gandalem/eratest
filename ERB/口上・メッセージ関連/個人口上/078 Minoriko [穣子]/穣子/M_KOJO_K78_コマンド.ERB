;SOURCEやNOWEXを使ってSELECTCOMに依存しない口上があってもいいんじゃない

@M_KOJO_MESSAGE_COM_K78_00
;性交処女喪失をRETURN 100して
;IF RESULT == 100 でまとめるとか
;苦痛や快楽のSOURCEをトリガーとして汎用あえぎ口上を作るとか
;いろいろ利用方法は考えられますが適当にやってください
;-------------------------------------------
;調教後のテキスト
;TFLAG:8 (1=TARGETがお掃除 2=ASSIがお掃除 3=TARGETとASSIがお掃除)
;-------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_C_K78
IF K78_BASIC_CONDITION_IN_MATING()
	;処女喪失
	IF TCVAR:破瓜
		;正真正銘処女喪失
		IF TCVAR:破瓜 == 1
			;再生処女喪失
		ELSEIF TCVAR:破瓜 == 2
			;無自覚非処女喪失
		ELSEIF TCVAR:破瓜 == -1
		ENDIF
	ENDIF
	;Ａ処女喪失
	IF TCVAR:Ａ破瓜
		;正真正銘Ａ処女喪失
		IF TCVAR:Ａ破瓜 == 1
			;無自覚Ａ処女喪失
		ELSEIF TCVAR:Ａ破瓜 == -1
		ENDIF
	ENDIF
	;フェラで射精後のお掃除
	IF (TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2) && SELECTCOM == 81
		PRINTFORML 
	ENDIF
	;前のターンでTARGETのアヌスに主人のペニスorペニバンを挿入していてたが今はそうでない、かつうふふ中
	IF MASTER_POSE(SET_A,SET_P,1) == TARGET && MASTER_POSE(SET_A,SET_P,0) != TARGET && CFLAG:うふふ
		IF TCVAR:Aに中出しされたフラグ && TCVAR:Aに中出ししたキャラの番号 == MASTER
			IF CFLAG:1002 && ( TALENT:恋慕 || TALENT:愛欲 ) && 充填率(TARGET,2) >= 30 && !TCVAR:351 && !RAND:5
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 항문에서 %TEXTR("肉棒/陰茎/ペニス/イチモツ")%를 빼내자, 풀린 그곳은 방금 주입된 정액의 자극에 마침내 폭발했고, 걸쭉한 대변을 힘차게 흘려보냈다.
				CALL DIALOGUE_K78_DEFECATION_IN_MATING
			ELSEIF CFLAG:1002 && !TCVAR:351 && RAND:3
				PRINTFORMDL 방금 주입된%TEXTR("정액/자멘/종자즙")%이%조사처리(CALLNAME:TARGET,"의")%%TEXTR("항문/애널/엉덩이 구멍")%에서 흘러넘친다.
				PRINTFORMDL 약간의 분변이 섞인 그것은 옅은 황토색으로 물들어 있다.
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 항문에서 %TEXTR("육봉/음경/페니스/자지")%를 빼내자, 방금 주입된 %TEXTR("정액/자멘/씨물/백탁액")%이 흘러넘쳐 나왔다.
			ENDIF
		ELSEIF 充填率(TARGET,2) >= 60 && !RAND:3
			IF CFLAG:1002
				IF ( TALENT:恋慕 || TALENT:愛欲 ) && !TCVAR:351 && !RAND:5
					PRINTFORMDL 이마에 식은땀을 흘리며 변의를 참던 %CALLNAME:TARGET%였지만, 마침내 한계를 맞았다. 항문은 순식간에 입을 벌리더니 부추부추 하는 격렬한 소리와 함께 정액이 섞인 대변을 사방으로 뿌렸다.
					CALL DIALOGUE_K78_DEFECATION_IN_MATING
				ELSEIF !TCVAR:351 && RAND:2
					PRINTFORMDL 넘치도록 사정을 항문에 흘려 넣었는지, %조사처리(CALLNAME:TARGET,"의")% 배가 꾸르륵 울렸다.
					PRINTFORMDL 변의를 느끼면서도 필사적으로 참는 듯하다.
				ELSE
					PRINTFORMDL \@ 充填率(TARGET,2) >= 100 ? 배가 불러올 만큼 # 대량의 \@정액을 주입당한%조사처리(CALLNAME:TARGET,"는")%, 장액이 섞여 독특한 냄새를 풍기는%TEXTR("정액/자멘/씨앗즙/백탁액")%을 %TEXTR("항문/아누스/엉덩이 구멍")%에서 질질 흘리고 있다.
				ENDIF
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 항문에서 \@ TALENT:MASTER:性別 & 2 ? %TEXTR("肉棒/陰茎/ペニス/イチモツ")% # 팽이 모양 \@을 빼내자, 직장에 대량으로 주입되었던 %TEXTR("精液/ザーメン/子種汁/白濁液")%가 천천히 흘러내렸다.
			ENDIF
		ELSE
			IF CFLAG:1002 && ( TALENT:恋慕 || TALENT:愛欲 ) && !TCVAR:351 && !RAND:20
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 문득 안절부절못하기 시작하더니, 큰 방귀 소리와 함께 질척한 설사 기미가 있는 변을 항문에서 분출했다.
				CALL DIALOGUE_K78_DEFECATION_IN_MATING
			ELSEIF CFLAG:1002 && !RAND:5
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 삽입에 자극받아 장이 연동하기 시작했는지, %조사처리(CALLNAME:TARGET,"는")% %TEXTR("ぷすぅー/ブウゥ/ボバッ/ぶぴっ")%와 방귀를 뀌고 말았다.
				CALL DIALOGUE_K78_FARTING_IN_MATING
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% %TEXTR("항문/애널/엉덩이 구멍")%은 \@ TALENT:MASTER:性別 & 2 ? %TEXTR("육봉/음경/페니스/고추")% # 발기한 모양 \@이 빠져나간 뒤에도 %TEXTR("활짝/뻐끔뻐끔/실룩실룩")% 입을 벌린 채, %TEXTR("항문 안쪽의 붉은 살/미끈미끈한 점막")%을 드러내고 있다.
			ENDIF
		ENDIF
		PRINTW
	ENDIF
ENDIF
