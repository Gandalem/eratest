@DIALOGUE_K78_VA_COWGIRL,ARGS
IF K78_BASIC_CONDITION_IN_MATING()
	$VA_COWGIRL_LOOP
	IF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:9
			CASE 1
				IF !TEQUIP:縄 && !TEQUIP:拘束 && !TEQUIP:継続キス && ( ( ABL:欲望 >= 8 && ABL:露出癖 - TALENT:羞恥心 * 2 >= 4 ) || ( !( CFLAG:1007 && K78_ARMPIT_EXPOSURE() ) && !K78_SWEATY_UNDERARMS() && ABL:欲望 >= 4 && ABL:露出癖 - TALENT:羞恥心 >= 1 ) )
					IF ABL:欲望 >= 8 && ABL:露出癖 - TALENT:羞恥心 * 2 >= 4
						IF CFLAG:1007 && K78_ARMPIT_EXPOSURE()
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 두 손을 머리 뒤에서 모으고, %K78_ARMPIT_HAIR_MODIFIER()%는 겨드랑이를 드러내며 골반을 흔들었다.
							CALL K78_HPH_PRINT,@"「네엣 HPH %조사처리(CALLNAME:MASTER,"가")% 좋아하는 겨드랑이털 여기 있어요HPH」","W"
						ELSEIF K78_SWEATY_UNDERARMS()
							PRINTFORMDL 두 손을 머리 뒤에 모으고 허리를 흔드는 %조사처리(CALLNAME:TARGET,"의")% 겨드랑이 아래에는 커다란 땀 자국이 생기고 있었다.
							CALL K78_HPH_PRINT,@"「야앙 HPH, 엄청난 땀이야 HPH, 부끄러워!」","W"
						ELSE
							PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 양손을 머리 뒤로 모으고 다리를 크게 벌린 음란한 자세로 격렬하게 골반을 흔들었다.
							IF ABL:欲望 >= 20 && RAND:2
								CALL K78_HPH_PRINT,@"「응, 하아! 음탕한 나를 봐줘어엣!」","W"
							ELSE
								CALL K78_HPH_PRINT,@"「하아, 하앙 HPH 추한 나를 봐줘 HPH」","W"
							ENDIF
						ENDIF
					ELSE
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 양손을 머리 뒤에서 모은 채 허리를 흔들었다.
						CALL K78_HPH_PRINT,@"「이런 야한 차림, 좋아하지? HPH」","W"
					ENDIF
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 2
				IF ( EQUIP:スカート || EQUIP:着物 || EQUIP:ワンピース ) && !TEQUIP:縄 && !TEQUIP:拘束 && !TEQUIP:継続キス && ABL:露出癖 - TALENT:羞恥心 >= 2
					PRINTFORMD %조사처리(CALLNAME:TARGET,"는")% 스스로 치맛자락을 움켜쥐고 들어 올린다.
					IF CFLAG:ノーパン
						IF CFLAG:1003 && RAND:3
							PRINTFORMD %K78_GENITAL_HAIR_MODIFIER()%가랑이를
						ELSE
							PRINTFORMD \@ TALENT:MASTER:性別 & 2 ? 페니스 # 발기형 \@をくわえこんだ\@ ARGS == "V" ? 성기 # 배설구 \@을
						ENDIF
					ELSE
						PRINTFORMD 팬티를 입은 채 이어졌던 두 사람의 결합부를
					ENDIF
					PRINTFORMDL 보여주었다.
					CALL K78_HPH_PRINT,@"「저기, 봐봐 HPH 야해하지?」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
			CASE 3
				IF ABL:腰 >= 3 && ( ( ARGS == "V" && ABL:膣 >= 3 ) || ( ARGS == "A" && ABL:アナル >= 3 ) ) && TALENT:MASTER:性別 & 2 && !TEQUIP:アイマスク
					IF ARGS == "A"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 허리를 흔들며 골반저근을 긴장시키고, 오므라든 항문관으로 능숙하게 칼집을 자극했다.
					ELSE
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 질은 허리 움직임에 맞춰 일렁이며, %조사처리(CALLNAME:MASTER,"의")% 씨앗을 짜내려고 하는 듯하다.
					ENDIF
					CALL K78_HPH_PRINT,@"「후훗 후후, 느끼는 얼굴 귀엽네 후후」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
