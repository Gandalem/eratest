				CALL K78_HPH_PRINT,@"「앙! 후후, 간지러워라 후후」","W"
			CASE 8
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 숨을 크게 내쉬면서 \@ TALENT:MASTER:性別 & 2 ? 페니스 # 팽 모양 \@을 물어, 조금이라도 깊이 받아들이려는 듯 쿵 하고 허리를 밀어붙인다.
				CALL K78_HPH_PRINT,@"「하아, 헉, 하앙 HPH 깊은 곳에읏 HPH 넣어줘, 굉장해어 HPH」","W"
			CASEELSE
				PRINTFORMDL 필사적으로 골반을 흔드는 %조사처리(CALLNAME:TARGET,"의")% 몸에서 관능적인 향과 함께 땀이 흘러내려 %조사처리(CALLNAME:MASTER,"의")% 몸을 적셨다.
				CALL K78_HPH_PRINT,@"「아앗 HPH 야하HPH 땀이, 나버릴 HPH 하앙, 음응HPH」","W"
		ENDSELECT
	ELSE
		IF ARGS == "A" && !RAND:5
			PRINTFORMW 「엉덩이 구멍을 사용해서... 게다가 스스로 한다는 건, 잘 생각해 보면 엄청난 일을 하고 있는 것 같아」
		ELSEIF !RAND:4
			IF ABL:腰 >= 3
				PRINTFORMW 「익숙해지면 스스로 하는 것도 나쁘지 않을 거야. 당신을 조종하는 것 같아서 즐거울지도 몰라♪」
			ELSE
				PRINTFORMW 「앗, 하아. 스스로 하는 건 꽤 어렵네... 응.」
			ENDIF
		ELSEIF !RAND:3
			IF ABL:腰 >= 3
				PRINTFORMW 「하아, 하아... 후우... 응? 이 움직임, 나 발전한 것 같지 않아?」
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 조심스러운 허리 움직임이 답답해서, %조사처리(CALLNAME:MASTER,"는")% 허리를 밀어 올렸다.
				PRINTFORMW 「큭! 갑자기 움직이지 마. 놀라잖아」
			ENDIF
		ELSEIF RAND:2
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 쾌감을 탐하듯 확 끌어당기며 거친 스트로크를 가했다.
			PRINTFORMW 「앗, 야헵, 격해... 응, 음음읏」
		ELSE
			PRINTFORML 「응, 응아… 아, 하아, 하앗」
			PRINTFORMDW 이마에 땀을 흘리며 살짝 얼굴을 찡그리는 채 허리를 움직이는 모습이 가학적인 마음을 자극했고, %조사처리(CALLNAME:MASTER,"는")% 더욱 격렬하게 허리를 밀어 올렸다.
		ENDIF
	ENDIF
ENDIF
