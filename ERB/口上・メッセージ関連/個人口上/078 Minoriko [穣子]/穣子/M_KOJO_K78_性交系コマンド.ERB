@DIALOGUE_K78_VA_FACE_TO_FACE_SITTING,ARGS
IF K78_BASIC_CONDITION_IN_MATING()
	$VA_FACE_TO_FACE_SITTING_LOOP
	IF TALENT:恋慕 || TALENT:愛欲
		SELECTCASE RAND:6
			CASE 1
				IF !TEQUIP:縄 && !TEQUIP:拘束 && !TEQUIP:継続キス && !TEQUIP:乳首吸い && ( K78_ARMPIT_EXPOSURE() || K78_SWEATY_UNDERARMS() )
					IF K78_ARMPIT_EXPOSURE()
						LOCALS:0 = 
						IF K78_ARMPIT_SWEAT() && RAND:10 >= 7
							LOCALS:0 = 땀으로 축축하게 젖었다.
						ELSE
							LOCALS:0 = %K78_ARMPIT_HAIR_MODIFIER()%
						ENDIF
						PRINTFORMDL 무릎 위에서 허리를 흔들게 하고 %CALLNAME:TARGET%팔을 들어, %LOCALS:0% 겨드랑이에 혀를 가져갔다.
						CALL K78_HPH_PRINT,@"「응흐으 후후 간지러운데, 기분 좋을지도 HPH 응아 하아 HPH」","W"
					ELSE
						PRINTFORMDL 무릎 위에 앉힌 %조사처리(CALLNAME:TARGET,"에게")% 한쪽 팔을 들게 하고, 땀으로 젖은 겨드랑이에 얼굴을 파묻으며 허리를 움직였다.
						CALL K78_HPH_PRINT,@"「저, 야안 HPH 정말 변태 같잖아 HPH 아, 냄새 너무 맡았어 HPH」","W"
					ENDIF
				ELSE
					GOTO VA_FACE_TO_FACE_SITTING_LOOP
				ENDIF
			CASE 2
				IF TEQUIP:継続キス
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 꿈틀거리며 허리를 흔들면서 %조사처리(CALLNAME:MASTER,"에게")% 몸을 밀착시키고, 계속해서 입맞춤을 갈구해 왔다.
					CALL K78_HPH_PRINT,@"「음, 응... 음츄... 하아 HPH 츄큭HPH 츄파... 아무... 응, 더...」","W"
				ELSE
					GOTO VA_FACE_TO_FACE_SITTING_LOOP
				ENDIF
			CASE 3
				IF !TEQUIP:継続キス
					CALL K78_HPH_PRINT,@"「하아, 하아... 흐음, 아하, 하아, 하앙...」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 입술에서 평소보다 더 달콤한 향기가 나는 숨결이 새어 나와 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 닿았다.
				ELSE
					GOTO VA_FACE_TO_FACE_SITTING_LOOP
				ENDIF
			CASE 4
				IF !TEQUIP:縄 && !TEQUIP:拘束
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% %조사처리(CALLNAME:TARGET,"의")% 허리에 팔을 감아 꽉 껴안자, 그것에 응하듯 %CALLNAME:TARGET%도 팔을 목에 두르고 왔다.
					CALL K78_HPH_PRINT,@"「에헤헤♪ 꽉 안아주는 거 좋다 HPH %조사처리(CALLNAME:MASTER,"의")% 심장이 두근거리는 것도 느낄 수 있는 것 같아 HPH」","W"
				ELSE
					GOTO VA_FACE_TO_FACE_SITTING_LOOP
				ENDIF
			CASE 5
				PRINTFORMDL 서로 몸을 많이 움직일 수 없는 답답함이 더욱 열정을 고조시켰고, 귀 옆에서 끊임없이 사랑을 속삭였다.
				CALL K78_HPH_PRINT,@"「하아, 하아... 좋아, 정말 좋아 HPH 사랑해 HPH 당신과 계속 이렇게 있고 싶어 HPH」","W"
			CASEELSE
				PRINTFORMDL 꾸이크꾸이 하고 허리를 그라인드하는 %조사처리(CALLNAME:TARGET,"의")% 아찔한 모습이, %조사처리(CALLNAME:MASTER,"의")% 욕정을 고조시킨다.
				CALL K78_HPH_PRINT,@"「에헤히 이 움직임 어때? 기분 좋아져 준다면 기쁠 거야HPH」","W"
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				IF ABL:腰 >= 3
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 천천히 그리고 온화하게 움직이면서도 확실하게 %조사처리(CALLNAME:MASTER,"의")% 쾌감을 높여간다.
					PRINTFORMW 「이런 여유로운 섹스도 나쁘지 않네」
				ELSE
					PRINTFORMW 「나도 움직이는 거야? 우, 응. 하지만 쉽지 않네…」
				ENDIF
			CASE 2
				PRINTFORML 「괜찮아? 어, 무겁지 않을까?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 나이에 걸맞게 체중에 신경을 쓰고 있는 듯하다.
			CASEELSE
				PRINTFORMW 「이, 이런 모습으로는 얼굴이 가까워서... 조금 부끄러워...」
		ENDSELECT
	ENDIF
ENDIF
