				IF !TEQUIP:縄 && !TEQUIP:拘束 && !TEQUIP:継続キス && !TEQUIP:アイマスク
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"의")% 손을 잡고, 손가락을 깍지 끼며 기쁜 듯 얼굴을 들여다보았다.
					CALL K78_HPH_PRINT,@"「당신의 얼굴을 잘 보고 싶어 HPH 부끄러워하지 말고 제대로 이쪽을 봐 HPH」","W"
				ELSE
					GOTO VA_COWGIRL_LOOP
				ENDIF
