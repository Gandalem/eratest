; Modular ERB: 個人口上/094 Benben [弁々]/弁々/M_KOJO_K94_CUSTOM_CHECKS.ERB
;custom code
;determines if a specific event/command has timestop dialogue
;overrides CFLAG:時間停止口上有

@M_KOJO_K94_TIMESTOP_ALLOWED(ARGS, ARG, ARGS:1)
SELECTCASE ARGS
	CASE "COM"
		SIF GROUPMATCH(ARG, 316)
			RETURN -1
	CASE "SCOM"
	CASE "CUSTOM_COM"
	CASE "CUSTOM_SCOM"
	CASE "EVENT"
	CASE "PALAM"
	CASE "COUNTER"
	CASE "COM_ASSISTANT"
	CASE "SCOM_ASSISTANT"
	CASE "CUSTOM_COM_ASSISTANT"
	CASE "CUSTOM_SCOM_ASSISTANT"
ENDSELECT
RETURN 0
