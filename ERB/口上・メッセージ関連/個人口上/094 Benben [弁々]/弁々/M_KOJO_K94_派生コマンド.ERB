		IF RAND:3 == 0
			PRINTFORMW 「츄릅%UNICODE(0x2665) *1%쭈욱%UNICODE(0x2665) *1%푸욱%UNICODE(0x2665) *1%음뭇%UNICODE(0x2665) *1%츄릅%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...응, %UNICODE(0x2665) *1% 이상한 냄새가 나... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응츄%UNICODE(0x2665) *1%낼름%UNICODE(0x2665) *1%」
			PRINTFORMW 「잔뜩 내줘…%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
