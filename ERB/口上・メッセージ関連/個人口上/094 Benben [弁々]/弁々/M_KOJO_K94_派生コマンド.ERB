			PRINTFORMW 「%MASTERNAME:94%의 즙, 잔뜩 마시게 해줘%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「츄욱%UNICODE(0x2665) *1%んふず읏%UNICODE(0x2665) *1%んぷ읏…%UNICODE(0x2665) *1%…ん읏%UNICODE(0x2665) *1%ず읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「읍%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%츄읍%UNICODE(0x2665) *1%주읍%UNICODE(0x2665) *1%주읍%UNICODE(0x2665) *1%푹%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%음무%UNICODE(0x2665) *1%」
		ELSE
