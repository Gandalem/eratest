		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭉%UNICODE(0x2665) *1%츄푹%UNICODE(0x2665) *1%쭉%UNICODE(0x2665) *1%움푹%UNICODE(0x2665) *1%즈즉%UNICODE(0x2665) *1%쭉%UNICODE(0x2665) *1%」
