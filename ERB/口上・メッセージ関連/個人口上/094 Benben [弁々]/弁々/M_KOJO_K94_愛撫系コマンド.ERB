		IF RAND:3 == 0
			PRINTFORMW 「음…%UNICODE(0x2665) *1%」
			PRINTFORMW 「…가슴…큰 것도 나쁘지는 않네…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「………%UNICODE(0x2665) *1%」
