		ELSE
			PRINTFORMW 「！？」
			PRINTFORMW 「...응... 이제... %UNICODE(0x2665) *1%」
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...남자들은... 가슴 좋아하는 거야?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...변태...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「싫어...%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
