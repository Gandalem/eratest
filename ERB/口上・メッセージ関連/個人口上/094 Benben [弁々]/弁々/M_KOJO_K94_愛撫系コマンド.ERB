		ELSE
			PRINTFORMW 「앗 %UNICODE(0x2665) *1%」
			PRINTFORMW 「...가슴... 민감해져 있어... %UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「...아...싫어...가슴...」
			PRINTFORMW 「응...%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「가슴... 부끄러워... %UNICODE(0x2665) *1%」
		ELSE
