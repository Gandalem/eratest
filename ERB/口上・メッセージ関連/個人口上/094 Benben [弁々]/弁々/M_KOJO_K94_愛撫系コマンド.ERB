RETURN RESULT

@M_KOJO_MESSAGE_COM_K94_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「앗…%UNICODE(0x2665) *1%…%MASTERNAME:94%…%UNICODE(0x2665) *1%愛撫…して…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응…%UNICODE(0x2665) *1%…읏…%UNICODE(0x2665) *1%아앗…%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「%MASTERNAME:94%에게 만져지는 거……%UNICODE(0x2665) *1% 정말 기분 좋아……%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「으응…%UNICODE(0x2665) *1%…%MASTERNAME:94%…%UNICODE(0x2665) *1% 이런 거 잘하는구나…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏…%UNICODE(0x2665) *1%…아앗…%UNICODE(0x2665) *1%좀 더 애무해 줘어…%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「%MASTERNAME:94%…%UNICODE(0x2665) *1%으앗…%UNICODE(0x2665) *1%…야한 손놀림이네…%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「응읏…%UNICODE(0x2665) *1%…%MASTERNAME:94%…%UNICODE(0x2665) *1%정말 좋아앗…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏…%UNICODE(0x2665) *1%…더엇…%UNICODE(0x2665) *1%좀 더 애무해 줘…%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「%MASTERNAME:94%…%UNICODE(0x2665) *1%아앗…%UNICODE(0x2665) *1%꺄앗…%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
