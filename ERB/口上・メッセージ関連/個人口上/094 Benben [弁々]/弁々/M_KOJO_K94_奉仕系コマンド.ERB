RETURN RESULT

@M_KOJO_MESSAGE_COM_K94_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「...덜덜 떨면서... 지금 당장 사정할 것 같아...%UNICODE(0x2665) *1%」
			PRINTFORMW 「후훗 이대로 싸버려%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「벌써... 발기해서 단단해지고 있어...%UNICODE(0x2665) *1%」
			PRINTFORMW 「내줘...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「...아직 싸면 안 돼...%UNICODE(0x2665) *1%」
			PRINTFORMW 「참하는 편이 기분 좋은 거잖아...%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「크다... 남자들은 모두 이렇게 커지는 걸까」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「뜨거워져서... 나쁜 거시기는 이렇게 해 줄게...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응… 기분 좋아 보이는 얼굴네」
			PRINTFORMW 「더 격렬하게 비벼 줄게… %UNICODE(0x2665) *1%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「이쪽 부분이 %MASTERNAME:94%의 약한 부분인 걸까♪」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...응... 이상한 냄새...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「손 안에서 부들부들 떨고 있는 게... 재미있네... %UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「더러운 게 잔뜩 붙어 있어... 깨끗하게 해야겠어...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...이렇게 하니 기분 좋은 걸까?」
		ELSE
			PRINTFORMW 「...음... 이렇게 하면 되는 거야?」
			PRINTFORMW 「손... 축축해져 버렸어... %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
