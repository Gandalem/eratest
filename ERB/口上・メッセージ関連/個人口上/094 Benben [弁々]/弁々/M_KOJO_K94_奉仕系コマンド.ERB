			PRINTFORMW 「난츄%UNICODE(0x2665) *1%んぐ읏%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응츄%UNICODE(0x2665) *1% 쥬웁%UNICODE(0x2665) *1% 앙읏%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「츄읍%UNICODE(0x2665) *1% 쭈욱%UNICODE(0x2665) *1% 즈읍%UNICODE(0x2665) *1% 음뭇%UNICODE(0x2665) *1% 츄읍%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...음? %UNICODE(0x2665) *1%이상한 냄새가 나네...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「응츄%UNICODE(0x2665) *1% 핥아앗%UNICODE(0x2665) *1%」
			PRINTFORMW 「잔뜩 내줘…%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
