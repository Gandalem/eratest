RETURN RESULT

@M_KOJO_MESSAGE_COM_K94_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「…！」
			PRINTFORMDW 벤벤은 스킨십에 대해 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좀... 기분 나쁜데」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「...그만두렴」
			PRINTFORMDW 벤벤은 화난 표정으로 항의해 온다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「등을 쓸어줄게, %MASTERNAME:94%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……남자아이의 몸은 역시 우리와는 다르네.」
		ELSE
			PRINTFORMW 「같이 목욕하고 있는 거니까, 등 정도는 씻겨 줄게.」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「뭐야? 그렇게 내 몸을 만지고 싶어?」
			PRINTFORMDW 벤벤은 그렇게 말하면서도 전혀 싫지 않은 듯 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 즐기고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「후후, 연인 같네, %MASTERNAME:94%과 나」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"의")% 스킨십에 얼굴을 붉히며 그렇게 말했다.
		ELSE
			PRINTFORMW 「음~? 무슨 일이야?」
			PRINTFORMDW 벤벤은 그렇게 말하며 안아왔다.
			PRINTFORMW 「후후, 특등석이네, %MASTERNAME:94%의 가슴」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응」
			PRINTFORMDW 벤벤은 천천히 %조사처리(CALLNAME:MASTER,"의")% 팔에 안겼다.
			PRINTFORMW 「이렇게 하고 있으면, 마음이 편해져」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「저기, %MASTERNAME:94%~」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"에게")% 말을 걸며 안겼다.
			PRINTFORMW 「후후, 따뜻하네, %MASTERNAME:94%」
		ELSE
			PRINTFORMW 「...응... 뭐야?」
			PRINTFORMDW 벤벤은 얼굴을 새빨게 물면서 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 하고 있다.
			PRINTFORMW 「이런 거, 좋아하는 거야, 나」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「응, 이상한 곳 만지지 마」
			PRINTFORMDW 벤벤은 그렇게 말하면서도 %조사처리(CALLNAME:MASTER,"에게")% 순순히 몸을 만지고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...무슨 일이야? 애무해 주고 있는 거라고 생각하는 거야?」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"와")%의 스킨십에 당황하고 있다.
		ELSE
			PRINTFORMW 「너무 달라붙지 말아 줄 수 있겠니?」
			PRINTFORMDW 스킨십을 시도하자 벤벤이 지적했다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...나를 연주하려고 하다니 열 살은 이르구나」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「너무, 당신이랑 스킨십 하는 거, 남한테 보이고 싶지 않아.」
			PRINTFORMDW 벤벤은 스킨십을 하려고 하지만 %조사처리(CALLNAME:MASTER,"에게")% 조금 물러난다.
		ELSE
			PRINTFORMW 「...응? 당신 너무 달라붙지 않아?」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 당황하며 받아들이고 있다.
			PRINTFORMW (이 사람 어떤 사람에게든 이렇단 걸까...)
		ENDIF
	ENDIF
ENDIF
