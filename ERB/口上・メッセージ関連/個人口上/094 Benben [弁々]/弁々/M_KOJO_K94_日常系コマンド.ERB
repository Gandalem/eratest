RETURN RESULT

@M_KOJO_MESSAGE_COM_K94_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:325 == 5 && TFLAG:193 != -3 ;custom code
		IF RAND:3 == 0
			PRINTFORMW 「...바빠서, 나중에 또 봐」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「미안해, 다음에 해 줄래?」
		ELSE
			PRINTFORMW 「지금 바쁘니까 방해하지 말아 줄래?」
		ENDIF
		;怒り
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「………」
		PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"를")% 마치 무시하고 있다.
		;会話不能
	ELSEIF TCVAR:302
		PRINTFORMW 「………」
		PRINTFORMW (어떡하죠...)
		PRINTFORMDW 벤벤은 어색한 분위기에 입을 다물었다.
	ELSEIF CFLAG:2 >= 2000 && CFLAG:4 >= 100 && CFLAG:94:1901 == 0 ;custom code, changed the way flags are handled
		PRINTFORMW 「있잖아, %MASTERNAME:94%」
		PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 가만히 응시하며 그렇게 중얼거렸다.
		PRINTFORMW 「%MASTERNAME:94%을 오빠라고 불러도 돼?」
		PRINTFORMW 「딱히 모르는 사이도 아니고, 우리 남매가 되어보지 않을래?」
		PRINTFORMW 「나는 한 번이라도 동생이 되어보고 싶었어, 응, 부탁이야」
		PRINTFORMW 「...귀여운 여동생의 부탁을 들어줄 수 있을까?」
		PRINTFORMW 「아니면... 다르게 불러줬으면 하는 호칭 같은 거 있어?」
		$INPUT_LOOP1
		PRINTDL [0] 오빠
		PRINTDL [1] 형님
		PRINTDL [2] 이대로 괜찮아
		INPUT
		SELECTCASE RESULT
			CASE 0
				CFLAG:94:1900 = 1
				PRINTFORMW 「후훗, 알겠어」
				PRINTFORMW 「%MASTERNAME:94%…응…좋네, 이거」
				PRINTFORMDW 벤벤은 환한 미소로 그렇게 말했다.
				PRINTFORMW 「그럼 앞으로도 잘 부탁해, %MASTERNAME:94%」
			CASE 1
				CFLAG:94:1900 = 2
				PRINTFORMW 「%MASTERNAME:94%…나쁘지 않네」
				PRINTFORMW 「%MASTERNAME:94%, 이걸로 남매네, 우리들」
				PRINTFORMDW 벤벤은 만면의 미소로 그렇게 말했다.
			CASE 2
				PRINTFORMW 「...유감이네」
				PRINTFORMW 벤벤은 조금 아쉬운 듯 고개를 숙였다.
			CASEELSE
				GOTO INPUT_LOOP1
		ENDSELECT
		CFLAG:94:1901 = 1
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「벌거벗은 사이라니, 서로 더 알아가자」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「목욕탕이라 소리가 울리네, 나도 당신도 메아리칠까?」
		ELSE
			PRINTFORMW 「인간은 이런 문화도 가지고 있구나, 이 몸이 아니었으면 몰랐을 거야」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「봄에는 벚꽃이 아름답네, 꽃은 사랑하는 거야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이런 계절은 소리의 울림이 좋단다」
					ELSE
						PRINTFORMW 「야츠하시 벌써 낮잠 자고 있을까?」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「덥지 않아? 이 천 얇단 말이야, 여름 옷 사줄 거야?%MASTERNAME:94%♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이 옷은 시스루라서 보기보다 시원하단 말이야?」
					ELSE
						PRINTFORMW 「여름 축제에는 어떤 음악이 좋을까?」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「가을이니까, 기합 넣어서 연주해야지.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「예술의 가을은 라이벌이 많으니까 질 수 없지!」
					ELSE
						PRINTFORMW 「어떤 음악이라도 울려 퍼지는 좋은 계절이네!」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「추워... 제대로 따뜻하게 해 줘.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이런 계절에는 맨발은 춥네...」
					ELSE
						PRINTFORMW 「야츠하시와 몸을 녹이자, 그렇게 하자」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:4 == 0
						PRINTFORMW 「있잖아, %MASTERNAME:94%는 먹고 싶은 거 같은 거 있어?」
						PRINTFORMDW 벤벤은 그렇게 말하며 상냥하게 대화를 시작했다.
						PRINTFORMW 「다음에 만들어 줄게, %MASTERNAME:94%를 위해서야 %UNICODE(0x2665) *1%」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「그러고 보니 말이야, 저번에 야츠하시랑 얘기하고 있었는데」
						PRINTFORMW 「남자들은 역시 가슴 큰 사람이 좋아하는 거야?」
						PRINTFORMW 「왜냐면 그렇지 않잖아, %MASTERNAME:94%, 계속 내 가슴을 보고 있잖아요.」
						PRINTFORMDW 벤벤은 어딘가 황홀하게 그렇게 말해버렸다.
					ELSEIF RAND:2 == 0
						PRINTFORMW 「후후, 다음에 나를 이겨볼래? %MASTERNAME:94%?」
						PRINTFORMDW 벤벤은 살짝 요염하게 미소지었다.
					ELSE
						PRINTFORMW 「있잖아, %MASTERNAME:94%에 대해 더 들려줘」
						PRINTFORMDW 벤벤은 싱글벙글 웃으며 %조사처리(CALLNAME:MASTER,"에게")% 물어왔다.
						PRINTFORMW 「당신에 대해서, 나 아무것도 모른다는 건 슬프니까…」
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:4 == 0
						PRINTFORMW 「저기... %MASTERNAME:94%는 말이야」
						PRINTFORMW 「어떤 여자애가 좋아?」
						PRINTFORMDW 벤벤은 문득 물었다.
						PRINTFORMW 「...후훗, 그냥 들어보려고.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「있잖아... %MASTERNAME:94%는 평소에 뭐 하고 있어?」
						PRINTFORMW 「취미든 뭐든 %MASTERNAME:94%에 대해 알고 싶어.」
						PRINTFORMW 「...나는 아무것도 모르니까.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「부종신이 되면서, 이런 것도 나쁘지 않다고 생각하게 된 거야」
					ELSE
						PRINTFORMW 「나의 꿈?」
						PRINTFORMW 「그렇네… %MASTERNAME:94%의 신부일까?」
						PRINTFORMDW 벤벤은 장난스럽게 웃으며 그렇게 대답했다.
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:4 == 0
						PRINTFORMW 「……응?」
						PRINTFORMW 「미안해, 잘 못 듣고 있었어.」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「...후훗」
						PRINTFORMW 「%MASTERNAME:94%의 이야기는 언제 들어도 재미있네♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「...별로 재미있는 걸 이야기할 수가 없어」
						PRINTFORMW 「결국 태어난 지 아직 얼마 안 된 거네, 나」
					ELSE
						PRINTFORMW 「요즘 야츠하시 말이야, 라이코 씨 라이코 씨라니, 조금 외롭네.」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「헤에」
						PRINTFORMW 「세상은 넓구나」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「최근 라이코 씨가 라이브에서 멋있어서 말이야」
						PRINTFORMW 「질투하게 될 것 같아, 나」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「%MASTERNAME:94%는 평소에 어디에 살고 있어?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「후우, 당신의 이야기는 재미있네요」
						PRINTFORMDW 벤벤은 감탄하며 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
					ELSE
						PRINTFORMW 「...헤에」
						PRINTFORMDW 벤벤은 흥미롭다는 듯이 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
						PRINTFORMW 「...세상에는 여러 가지 일을 하는 사람이 있구나...」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
