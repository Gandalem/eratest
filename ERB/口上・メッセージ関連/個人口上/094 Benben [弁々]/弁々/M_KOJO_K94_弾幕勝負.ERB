; Modular ERB: 個人口上/094 Benben [弁々]/弁々/M_KOJO_K94_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K94_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「부숴주마...!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「나의 실력, 보여주겠어!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「나랑 상대해 줄 거야?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「당신의 상대는 나야!」
		ELSE
			PRINTFORMW 「내 음악의 상대가 되어 줄 수 있을까♪」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「이...!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아직 끝나지 않았어!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「그냥 스쳤을 뿐이야!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이 정도로는!」
				ELSE
					PRINTFORMW 「흥, 아직 멀었어!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「얄팍하군!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「내가 궁지에 몰리고 있다고!?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「의외로 잘하잖아」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이제 끝이다…」
				ELSE
					PRINTFORMW 「적당히 가라!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...바보...!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「...당했네」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「졌구나...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「그런...」
				ELSE
					PRINTFORMW 「…강하다」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「사람들에게 시비를 걸면서 약하구나」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「이걸로 나의 천하에 한 걸음 가까워졌을까?」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「뭐야, 약골이네, %MASTERNAME:94%…」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후음, 의외로 대단한 게 아니네」
				ELSE
					PRINTFORMW 「이걸로 끝이야? 허무하네.」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「헤매게 해버리고 말았어...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「...노미스는 아니었네...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「음, 별로 못했네」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%MASTERNAME:94%, 진심을 내보았나?」
				ELSE
					PRINTFORMW 「더 나를 즐겁게 해줬으면 좋았을 텐데」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「힘들다...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「좀 더 가면 질 뻔했어...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%MASTERNAME:94%... 의외로 하는구나...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...아파...」
				ELSE
					PRINTFORMW 「아직 천하에는 멀었나...」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「싫어, %MASTERNAME:94%, …」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「음, 난 어떡하지, 항복이야-」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「역시 %MASTERNAME:94%, 보통 사람이 아니네...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「나로는 안 되겠어...」
				ELSE
					PRINTFORMW 「이번에는 야츠하시도 데려올까?」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
