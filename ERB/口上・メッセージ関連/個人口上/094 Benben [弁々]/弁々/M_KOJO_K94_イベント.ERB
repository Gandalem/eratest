@M_KOJO_EVENT_K94_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...에... 변태!」
					PRINTFORMDW 벤벤은 동요하면서도 웅크리고 몸을 팔로 가리며 근처에 있던 것을 던져왔다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「잠깐!?」
					PRINTFORMW 「...들여다보는 건 그만둬...」
					PRINTFORMDW 그렇게 말하며 벤벤은 옷을 가다듬는다.
					PRINTFORMW 「그래서, 뭐야, 벌써...」
					PRINTFORMDW 벤벤은 얼굴을 붉히며 체면을 차리고 있다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「！？」
					PRINTFORMW 「노크도 못 하는 거야?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「노크 정도는 하라고, 인간 주제에...」
					PRINTFORMDW 벤벤은 그렇게 말하면서 얼굴을 붉히고 있다.
				ELSE
					PRINTFORMW 「………」
					PRINTFORMW 「…바보!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...쓸모도 없구나」
					PRINTFORMDW 벤벤은 그렇게 말하며 노려본다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「...이제 그만!」
					PRINTFORMW 「...뭐, 나쁘지는 않지만...」
					PRINTFORMDW 벤벤은 그렇게 중얼거렸다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...어라?」
					PRINTFORMDW 벤벤은 얼굴을 새빨갛게 물린 채 방치되는 굴욕을 맛보고 있다.
					PRINTFORMW 「...이런 거, 짜릿하네...%UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「...어라, 안 돼」
					PRINTFORMW (귀찮은 일만 생기지 않으면 좋겠는데...)
					PRINTFORMDW 벤벤은 얼굴을 새파랗게 만들며 그렇게 생각했다.
				ELSE
					PRINTFORMW 「...야네...」
					PRINTFORMW 「방치 플레이라는 건가?... 뭐, 살았다고 말해도 될지도 모르겠지만...」
					PRINTFORMDW 방치된 벤벤은 당혹스러워 그렇게 중얼거렸다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「……이런 건 변태가 하는 짓이지…!?」
					PRINTFORMDW 벤벤은 욕을 하며 노려보고 왔다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「……응…괜찮아…」
					PRINTFORMW 「……봐줘…기분 좋아지니까읏…%UNICODE(0x2665) *1%」
					PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"에게")% 보이다가 흥분을 느끼고 있다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「…%MASTERNAME:94%…지켜봐 줘…%UNICODE(0x2665) *1%」
					PRINTFORMDW 벤벤은 얼굴을 새빨갛게 물들인 채 추태를 계속하고 있다.
					PRINTFORMW 「좋아해…%UNICODE(0x2665) *1%…아앗…%UNICODE(0x2665) *1%…응읏…%UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「...응! 이런 거...좋아...%UNICODE(0x2665) *1%」
					PRINTFORMW (지켜봐 줘...%UNICODE(0x2665) *1%)
				ELSE
					PRINTFORMW 「...응윽...%UNICODE(0x2665) *1%」
					PRINTFORMDW 벤벤은 입을 막은 채 자위행위를 계속하고 있다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...나가라!」
					PRINTFORMDW 벤벤은 화를 내며 내쫓았다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「...나가줘!」
					PRINTFORMW 「...혼자 있게 해줄 수 없을까?」
					PRINTFORMW 벤벤은 더듬거리며 쫓아냈다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...나가라」
					PRINTFORMDW 벤벤은 얼굴을 새빨갛게 물며 내쫓았다.
					PRINTFORMW (이런 곳에 보여지고 싶지 않았어...!)
				ELSEIF TALENT:思慕
					PRINTFORMW 「...나가줘」
					PRINTFORMW 「...지금은... 지금은 안 돼...!」
					PRINTFORMDW 벤벤은 얼굴을 새빨갛게 물면서 그렇게 말하고 내쫓았다.
				ELSE
					PRINTFORMW 「노크라도 하고 오시지!」
					PRINTFORMDW 벤벤은 화를 내며 쫓아냈다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「………！」
					PRINTFORMDW 벤벤은 아무 말도 하지 않고 억눌려 있다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「……좋아……」
					PRINTFORMW 「……%MASTERNAME:94%……엉망으로 해줘……%UNICODE(0x2665) *1%」
					PRINTFORMW 「후훗, 나 %MASTERNAME:94%의 소유물인데……%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...응?」
					PRINTFORMDW 벤벤은 잠시 생각한 후.
					PRINTFORMW 「...이런 것도, 나쁘지 않을지도 모르겠어」
					PRINTFORMDW 정사를 허가했다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「당신, 이 상황에서... 별로 상관없지만」
					PRINTFORMDW 벤벤은 각오를 다진 듯 관계를 허락했다.
				ELSE
					PRINTFORMW 「...네 마음대로 해버려도 돼」
					PRINTFORMDW 벤벤은 체념한 듯 덮쳐져 있다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...싫어...이제 그만!」
					PRINTFORMDW 벤벤은 아무 말 없이 쓰러져 있다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「…응앗…%UNICODE(0x2665) *1%」
					PRINTFORMW 「…%MASTERNAME:94%…정말 좋아…%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...%MASTERNAME:94%... 좋아...%UNICODE(0x2665) *1%」
					PRINTFORMDW 벤벤은 얼굴을 새빨갛게 물린 채 누워있다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「음~%UNICODE(0x2665) *1%」
					PRINTFORMW 「당신, 잘하네요...%UNICODE(0x2665) *1%」
					PRINTFORMDW 벤벤은 얼굴을 새빨갛게 상기시키며 그렇게 말했다.
				ELSE
					PRINTFORMW 「やだ…%UNICODE(0x2665) *1%…んもう…%UNICODE(0x2665) *1%」
					PRINTFORMW （こっちの方がいいわね…%UNICODE(0x2665) *1%）
					PRINTFORMDW 벤벤은 행위의 흐느낌을 아직 토해내면서 그 행위에 대해 생각하고 있었다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF CFLAG:318 == 1
					PRINTFORMW 「...버티고 강도라니?」
					PRINTFORMDW 벤벤은 마지못해 %조사처리(CALLNAME:MASTER,"의")% 숙박을 허락했다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「...좋아해...%MASTERNAME:94%...조금 더 이대로...%UNICODE(0x2665) *1%」
					PRINTFORMW 「오늘은 돌아가지 못하게 할 거야...%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「…%MASTERNAME:94%…조금 더 이대로…%UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「응?」
					PRINTFORMW 「묵는 건 상관없지만...」
				ELSE
					PRINTFORMW 「...별로 상관없지만」
					PRINTFORMW 「방 정리 정도는 시켜주겠어」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
