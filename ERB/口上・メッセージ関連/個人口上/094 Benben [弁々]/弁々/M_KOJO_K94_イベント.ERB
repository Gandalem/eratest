@M_KOJO_SPEVENT_K94_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1094)
			PRINTFORMW 「ねえ、%CALLNAME:MASTER%」
			PRINTFORMW 「%CALLNAME:MASTER%は好きな人とかいる？」
			PRINTFORMW 「私、%CALLNAME:MASTER%に恋しちゃった」
			PRINTFORMW 「%CALLNAME:MASTER%と一緒にいるとドキドキするの」
			PRINTFORMW 「%CALLNAME:MASTER%のことを考えると夜眠れなくなって」
			PRINTFORMW 「八橋や雷鼓さんと一緒に演奏している時も%CALLNAME:MASTER%のことが頭から離れないの」
			PRINTFORMW 「%CALLNAME:MASTER%が他の女と一緒にいると嫉妬しちゃうし」
			PRINTFORMW 「%CALLNAME:MASTER%が誰かと話をしていると私も%CALLNAME:MASTER%ともっと話をしたいと思っちゃう」
			PRINTFORMW 「%CALLNAME:MASTER%と一緒になりたい」
			PRINTFORMW 「%CALLNAME:MASTER%のモノになりたい」
			PRINTFORMW 「%CALLNAME:MASTER%を私のモノにしたい」
			PRINTFORMW 「そんな想いが毎晩%CALLNAME:MASTER%の顔と一緒に夢に出て来るの」
			PRINTFORMW 「私を」
			PRINTFORMW 「%CALLNAME:MASTER%の恋人にしてください」
			PRINTFORMDW 弁々は%CALLNAME:MASTER%の袖を掴みながらそう告白した。
		;二回目の告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%」
			PRINTFORMDW 帰路に着くと弁々は意を決したように口を開いた。
			PRINTFORMW 「私、やっぱり%CALLNAME:MASTER%のこと好きだわ」
			PRINTFORMDW 弁々はそう言って%CALLNAME:MASTER%に告白した。
			PRINTFORMW 「%CALLNAME:MASTER%のこと、諦めきれない」
			PRINTFORMW 「独占欲が強いのね、私」
			PRINTFORMW 「私とは付き合ってもらえないかしら？」
			PRINTFORMW 「…駄目？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「…」
		PRINTFORMDW 弁々は黙って顔を近づけると
		PRINTFORMW 「ちゅっ…」
		PRINTFORMDW 優しくキスをしてきた。
		PRINTFORMW 「ふふっ、私、%CALLNAME:MASTER%のモノになっちゃった…」
		PRINTFORMDW %CALLNAME:MASTER%はあっけに取られながらも弁々を抱きとめた。
		PRINTFORMW （下克上だなんだと言ってたこともあったけど…これも幸せね）
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「…」
		PRINTFORMW 「諦めないから」
		PRINTFORMDW 弁々はそれだけ言ってその場を後にした。
		PRINTFORMW （これで諦めるぐらいなら…）
		RETURN 1
	ENDIF

ENDIF
RETURN 1

;==================================================
;デート帰り
;==================================================
@M_KOJO_SPEVENT_K94_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「ふんっ…！」
			PRINTFORMDW 弁々は怒りながらぷいっと顔を背けて帰っていった。
		ELSEIF TALENT:恋人
			PRINTFORMW 「じゃあね、%MASTERNAME:94%」
			PRINTFORMDW 弁々はそう言いながら%CALLNAME:MASTER%の方へ向き直って礼を言った。
			PRINTFORMW 「また、明日、%MASTERNAME:94%とデートできるの、楽しみにしているわよ」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「今日はもうお開きね」
			PRINTFORMW 「%MASTERNAME:94%、貴方も早く帰りなさい」
			PRINTFORMW 「…じゃあね、バイバイ」
			PRINTFORMDW 弁々はそう言って名残惜しげに手を振って去っていった。
		ELSEIF TALENT:思慕
			PRINTFORMW 「それじゃあ、また明日ね、%MASTERNAME:94%も元気でね」
			PRINTFORMDW 弁々はそう言ってそそくさと帰っていった。
			PRINTW
		ELSE
			PRINTFORMW 「そろそろ帰るわ」
			PRINTFORMW 「%MASTERNAME:94%もあんまり遊んでると痛い目見るわよ」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「…いいわ、許してあげる」
			PRINTFORMW 「でもね…あんまり変なことしちゃ駄目よ？」
			PRINTFORMW 「%MASTERNAME:94%のこと、信頼してあげるからね」
		ELSE
			PRINTFORMW 「ん、わかった」
			PRINTFORMW 「あんまり人を怒らせることをしちゃ駄目よ」
			PRINTFORMW 「私は優しいからね、許してあげる」
			PRINTFORMDW 弁々はどこか怒気を含んだ笑顔でそう言った。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「いいわ、少しだけ許してあげる」
			PRINTFORMW 「まあまだ怒ってるけどね」
			PRINTFORMW 「%MASTERNAME:94%、もう少し誠意を見せなさい」
		ELSE
			PRINTFORMW 「…」
			PRINTFORMW 「そう簡単に許してあげないわ」
			PRINTFORMW 「少しだけなら許してあげてもいいけど」
			PRINTFORMDW 弁々はどこかぎこちない笑顔でそう言った。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「…わかったわ」
			PRINTFORMW 「でもまだ怒ってるからね」
			PRINTFORMW 「%MASTERNAME:94%、もうちょっと信用できる態度を取りなさい」
		ELSE
			PRINTFORMW 「…」
			PRINTFORMW 「まだ怒ってるんだけど」
			PRINTFORMDW 弁々は%CALLNAME:MASTER%を睨みつけながらそう言った。
		ENDIF
	ENDIF
	PRINTFORML
ENDIF
RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K94_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;仕事中ではなく、今日会ってない。
	IF !TCVAR:94:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:94:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「ごめんねー今ライブ中なの♪」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K94
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「…あら、お元気そうね」
					PRINTFORMDW 弁々は怒気を含めた声でそう挨拶した。
				ELSEIF TALENT:恋人
					PRINTFORMW 「あら、%MASTERNAME:94%」
					PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと小さく手を振って挨拶をしてきた。
					PRINTFORMW 「今日は何をするの？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「ん？%MASTERNAME:94%じゃない」
					PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと
					PRINTFORMW 「今日は何をしてくれるの？」
					PRINTFORMDW 少し顔を赤らめて部屋に迎え入れた。
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:94%、元気？」
					PRINTFORMDW 弁々は%CALLNAME:MASTER%の姿を確認するとこちらを振り向いて挨拶してきた。
					PRINTFORMW 「%MASTERNAME:94%、今日はどうしたの？」
				ELSE
					PRINTFORMW 「あら、%MASTERNAME:94%、元気だった？」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:94:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「ごめんねー今ライブ中なの♪」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K94
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「…あら？」
					PRINTFORMW 「なんだ、%MASTERNAME:94%なの」
				ELSEIF TALENT:恋人
					PRINTFORMW 「あら、%MASTERNAME:94%じゃない」
					PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと小さく手を振って元気に挨拶をしてきた。
					PRINTFORMW 「何やってるの？私も混ぜてもらえないかしら」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%MASTERNAME:94%は今日なにか予定あるの？」
					PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと呼びかけてきた。
					PRINTFORMW 「私、今暇なのよね」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:94%、元気そうね」
					PRINTFORMDW 弁々は%CALLNAME:MASTER%の姿を確認すると近づきながら挨拶してきた。
					PRINTFORMW 「今日は%MASTERNAME:94%、予定とかあるの？」
				ELSE
					PRINTFORMW 「あら、%MASTERNAME:94%、元気そうね」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF CFLAG:318 == 1
				PRINTFORMW 「…変態…」
				PRINTFORMDW 弁々は胸を腕で隠しながら睨みつけて抗議している。
			ELSEIF TALENT:恋人
				PRINTFORMW 「%MASTERNAME:94%…」
				PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと一度湯船に体を沈めながら呆れつつも招き入れた。
				PRINTFORMW 「まあ、あんたにならいいけどさ…体、洗ってあげようか？」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「んえ！？%MASTERNAME:94%！？」
				PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと
				PRINTFORMW 「…あんたも体、見せなさい！」
				PRINTFORMDW そう言って湯船に招き入れた。
			ELSEIF TALENT:思慕
				PRINTFORMW 「%MASTERNAME:94%…」
				PRINTFORMDW 弁々は%CALLNAME:MASTER%に気づくと慌てた様子で湯船に沈んだ。
				PRINTFORMW 「覗きなんてあまりいい趣味とは思えないけど…%MASTERNAME:94%が一緒にお風呂入りたいっていうのならまあいいわ…」
			ELSE
				PRINTFORMW 「%MASTERNAME:94%…あんたねえ…まあいいわ、入りなさい」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
