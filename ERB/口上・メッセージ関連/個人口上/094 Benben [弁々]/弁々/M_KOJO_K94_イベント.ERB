@M_KOJO_EVENT_K94_17(ARG,ARG:1)
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ARG=1～3は排他
	;謎の快感
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕
			PRINTFORMW 「아읏%UNICODE(0x2665) *1%아아앗%UNICODE(0x2665) *1%」
			PRINTFORMDW 벤벤은 갑작스러운 쾌감에 몸부림치고 있다.
			PRINTFORMW 「아…%UNICODE(0x2665) *1%…아무것도 아니야…%UNICODE(0x2665) *1%」
			PRINTFORMDW 벤벤은 쾌락을 견디며 필사적으로 아무렇지도 않은 척하고 있다.
			PRINTFORMW (이거… 기분 좋아서…%UNICODE(0x2665) *1%)
		ELSE
			PRINTFORMW 「～～～%UNICODE(0x2665) *1%」
			PRINTFORMDW 벤벤은 몸을 움찔 떨며
			PRINTFORMW 「괜찮아, …평온해…」
			PRINTFORMW (…지금의… 대체 뭘까…)
			PRINTFORMDW 벤벤은 그다지 경험해보지 못한 쾌락에 눈이 촉촉해져 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕
			PRINTFORMW 「～%UNICODE(0x2665) *1%～%UNICODE(0x2665) *1%～%UNICODE(0x2665) *1%」
			PRINTFORMDW 벤벤은 순식간에 힘이 빠져버렸고 무슨 일이 일어났는지 이해하지 못하는 듯했다.
			PRINTFORMW 「...뭐... 뭐야... 벌써... %UNICODE(0x2665) *1%」
			PRINTFORMDW 그녀는 비틀거리면서도 일어섰다.
		ELSE
			PRINTFORMW 「ん읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「…や…ぁ…%UNICODE(0x2665) *1%」
			PRINTFORMDW 갑자기 쾌락을 주입당한 벤벤은 웅크리고 말았다.
			PRINTFORMW 「何だってのよ…もう…%UNICODE(0x2665) *1%」
			PRINTFORMDW 벤벤은 당혹스러워하며 몸에 손을 두르고 울고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;パンツ紛失
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「...응!?」
		PRINTFORMDW 벤벤은 갑자기 양손으로 치마를 눌렀다!
		PRINTFORMDW 아무래도 속옷을 도난당해서 위화감을 느낀 것 같다.
		PRINTFORMW 「...저기...뭐가...!」
		PRINTFORMDW 벤벤은 속옷이 없는 것에 당황하고 있다.
		PRINTFORMDW 적어도 그녀에게 노팬(속옷 미착용)은 처음이었던 모양이다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚口内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;精液中毒低精飲
		IF ARG:1 == 1
			IF EXP:精液経験 == 0
				PRINTFORMW 「우에에!?」
				PRINTFORMDW 벤벤은 입안으로 흘러들어온 정액에 놀라고 있다.
				PRINTFORMW 「...뭐...!?」
				PRINTFORMW 「...싫어...이제...」
				PRINTFORMDW 벤벤은 지극히 불쾌한 표정으로 천천히 어떻게든 정액을 삼켰다.
			ELSE
				PRINTFORMW 「……응!?」
				PRINTFORMDW 벤벤은 갑자기 입을 막고 몸을 떨며 무릎부터 주저앉았다.
				PRINTFORMW 「으...응...」
				PRINTFORMDW 입안에 남은 씨앗을 어떻게든 처리할지 잠시 망설인 후
				PRINTFORMW 「음...윽...」
				PRINTFORMDW 삼키기로 한 모양이다.
				PRINTFORMW 「뭐야... 벌써...」
			ENDIF
			;精液中毒低吐き出し
		ELSEIF ARG:1 == 2
			PRINTFORMW 「우에!?」
			PRINTFORMW 「응앗...」
			PRINTFORMDW 벤벤은 갑자기 입안에 나타난 자멘의 냄새와 쓴맛에 얼굴을 찡그리며 기침했다.
			PRINTFORMW 「뭐가... 갑자기...」
			;精液中毒低手で覆う
		ELSEIF ARG:1 == 3
			PRINTFORMW 「！？」
			PRINTFORMW 「음...윽...컥...」
			PRINTFORMDW 벤벤은 아무 일도 없던 것처럼 꾸미면서 입을 막고 있다...
			;精液中毒高精飲
		ELSEIF ARG:1 == 4
			PRINTFORMW 「……응!?」
			PRINTFORMDW 벤벤은 갑자기 입안으로 흘러들어 온 자어멘을 조심스럽게 삼켰다.
			PRINTFORMW 「……흡… 이상해……」
			;濃厚精液＆精液中毒低吐き出し
		ELSEIF ARG:1 == 5
			PRINTFORMW 「...응!?」
			PRINTFORMDW 벤벤은 갑자기 입안으로 흘러 들어온 진한 정액을 토해냈다.
			PRINTFORMW 「...우에...어우...」
			;濃厚精液＆精液中毒高精飲
		ELSEIF ARG:1 == 6
			PRINTFORMW 「...응!?」
			PRINTFORMDW 벤벤은 갑자기 입안으로 흘러들어 온 농후한 정액을 조심스럽게 삼켰다.
			PRINTFORMW 「...응윽... 맛있어... %UNICODE(0x2665) *1%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚顔面射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;幼稚持ち＆精液経験100未満
		IF ARG:1 == 1
			;通常ぬぐい取り
		ELSEIF ARG:1 == 2
			PRINTFORMW 「...에!?」
			PRINTFORMDW 벤벤은 얼굴에 달라붙은 정액을 알아차리고
			PRINTFORMW 「뭐야...? ...뭐라고 하는 거야...」
			PRINTFORMDW 당황하며 그것을 닦아냈다.
			;顔射精液舐めとり
		ELSEIF ARG:1 == 3
			PRINTFORMW 「…！？」
			PRINTFORMDW 벤벤은 얼굴에 달라붙은 정액을 알아차리고
			PRINTFORMW 「...아라... 맛있다...%UNICODE(0x2665) *1%」
			PRINTFORMDW 맛있게 핥았다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚手淫射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;ぬぐい取り
		IF ARG:1 == 1
			PRINTFORMW 「...윽!?」
			PRINTFORMDW 벤벤은 손에 달라붙은 정액을 알아차리고
			PRINTFORMW 「...이게 뭐야...」
			PRINTFORMDW 당황하며 닦아냈다.
			;舐めとり
		ELSEIF ARG:1 == 2
			PRINTFORMW 「...응...」
			PRINTFORMDW 벤벤은 손에 달라붙은 정액을 알아차리고
			PRINTFORMW 「음... 으윽... 이상한 맛... %UNICODE(0x2665) *1%」
			PRINTFORMDW 요염하게 핥았다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚アナル射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;Ａ感覚0
		IF ARG:1 == 1
			PRINTFORMW 「이, 이게 뭐야!?」
			PRINTFORMDW 벤벤은 항문에 이질감을 느꼈지만, 그 정체까지는 알 수 없는 듯하다.
			;ソレ以外
		ELSEIF ARG:1 == 2
			PRINTFORMW 「...흐읍!?」
			PRINTFORMDW 벤벤은 아나루의 이질감에 눈치채고
			PRINTFORMW 「...뭐야!? 뭐가...」
			PRINTFORMDW 엉덩이를 누르며 주변을 노려보고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚処女喪失】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 「...윽!?」
		PRINTFORMDW 벤벤은 하복부의 둔통에 얼굴을 찡그리며
		PRINTFORMW 「...뭐...무슨...?」
		PRINTFORMDW 입술을 깨물며 오한에 식은땀을 흘리고 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚膣内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;非処女膣内射精ピルなし
		IF ARG:1 == 1
			PRINTFORMW 「…！？」
			PRINTFORMDW 벤벤은 질 내부의 위화감에 눈치채고
			PRINTFORMW 「뭐... 뭐야... 벌써...」
			PRINTFORMDW 당황하며 하복부를 누르고 있다.
			;非処女膣内射精ピルあり
		ELSEIF ARG:1 == 2
			PRINTFORMW 「엣!?」
			PRINTFORMDW 벤벤은 하반신의 위화감을 느끼고
			PRINTFORMW 「...괜찮...겠지... 마시고 있으니까...」
			PRINTFORMDW 어쩐지 약을 복용하고 있는 것 같다.
			;処女膣内射精
		ELSEIF ARG:1 == 3
			PRINTFORMW 「...뭐라고!?」
			PRINTFORMDW 벤벤은 하반신의 둔통과 이질감을 느끼고
			PRINTFORMW 「...뭐야...싫어...!」
			PRINTFORMDW 하반신에서 새어 나오는 정액에 당황하며 반쯤 울먹이고 있다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;ナマでやらせろ時
;==================================================

@M_KOJO_EVENT_K94_18(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;避妊要求台詞
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「생으로 하고 싶어?」
			PRINTFORMW 「그런 건 아직 %MASTERNAME:94%에게는 이르다고 생각해.」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...생으로 하는 거?」
			PRINTFORMW 「%MASTERNAME:94%이, 나를 더 좋아해 준다면 생각해 줄게.」
		ELSE
			PRINTFORMW 「...생으로 하고 싶어?」
			PRINTFORMW 「...그런 거, 싫거든...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「안 돼」
			PRINTFORMW 「아직, 제 마음의 준비가, 이런 건 몰라서...」
			PRINTFORMDW 벤벤은 여전히 거부했다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...안 돼」
			PRINTFORMW 「이런 건 무서우니까...」
			PRINTFORMDW 벤벤은 살짝 고개를 숙인 채 거절했다.
		ELSE
			PRINTFORMW 「...안 돼」
			PRINTFORMDW 벤벤은 단호하게 거절했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;断ったのに粘られて切れた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「안 된다고 말하고 있잖아」
			PRINTFORMW 「말을 듣지 않는 사람은 싫어」
			PRINTFORMDW 야츠하시 벤벤은 여전히 거부했다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...몇 번을 말해야 알아줘?」
			PRINTFORMW 「안 된다고 말하고 있잖아!」
			PRINTFORMDW 벤벤은 노려보며 거절했다.
		ELSE
			PRINTFORMW 「...안 돼, 정말 안 돼!」
			PRINTFORMDW 벤벤은 목소리를 높이며 단호하게 거절했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日以外許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			PRINTFORMW 「좋지만」
			PRINTFORMW 「위험한 날은 안 돼」
			PRINTFORMDW 벤벤은 타협했다.
			PRINTFORMW 「…%MASTERNAME:94% 뿐이니까 말이야? 이런 건 하는 거」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……이런 건 나쁘지 않지만 말이야」
			PRINTFORMW 「좋아, 이쪽 쪽이 더 기분 좋을 것 같아」
		ELSE
			PRINTFORMW 「...별로 상관없지만」
			PRINTFORMW 「어린 애는 싫어」
			PRINTFORMDW 벤벤은 잠시 생각한 후 타협하기로 했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;危険日許可
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「...알았어」
			PRINTFORMW 「아이를 만들자」
			PRINTFORMDW 벤벤은 각오를 다진 듯 표정을 굳히면서도 미소를 지었다.
		ELSEIF TALENT:恋慕
