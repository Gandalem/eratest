@M_KOJO_EVENT_K94_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;仕事中ではなく、今日会ってない。
	IF !TCVAR:94:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:94:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「미안해~ 지금 라이브 중이야♪」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K94
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「...아, 잘 지내는 것 같네」
					PRINTFORMDW 벤벤은 분노를 담은 목소리로 그렇게 인사했다.
				ELSEIF TALENT:恋人
					PRINTFORMW 「어라, %MASTERNAME:94%」
					PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 작게 손을 흔들며 인사해 왔다.
					PRINTFORMW 「오늘은 뭘 할 거니?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「응? %MASTERNAME:94%가 아니네.」
					PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고
					PRINTFORMW 「오늘은 뭘 해줄 거야?」
					PRINTFORMDW 살짝 얼굴을 붉히며 방으로 맞이했다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:94%, 잘 지냈어?」
					PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"의")% 모습을 확인하고 이쪽을 돌아 인사해 왔다.
					PRINTFORMW 「%MASTERNAME:94%, 오늘은 무슨 일이야?」
				ELSE
					PRINTFORMW 「아, %MASTERNAME:94%, 잘 지냈어?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中、今日会ってない。
			IF CFLAG:行動 == 5 && !TCVAR:94:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
