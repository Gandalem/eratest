@M_KOJO_EVENT_K94_14(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;持っていた食物を食べられた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -1
		IF TALENT:恋人
			PRINTFORMW 「어라, 맛있겠다. 받아갈게, %MASTERNAME:94%」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"가")% 가지고 있던 것을 먹어버렸다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「그거... 주실 수 있어요?」
			PRINTFORMDW 그렇게 말하자 벤벤은 %조사처리(CALLNAME:MASTER,"가")% 가지고 있던 것을 먹어버렸다.
			PRINTFORMW 「...죄송해요, 배가 고파서요... 부끄럽네요」
		ELSEIF TALENT:思慕
			PRINTFORMW 「…오물오물…응?」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"가")% 가지고 있던 것을 먹어버렸다!
		ELSE
			PRINTFORMW 「...응...꿀꺽...」
			PRINTFORMDW 벤벤은 어느새 %조사처리(CALLNAME:MASTER,"가")% 가지고 있던 것을 먹어버렸다!
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;MASTERが押し倒した
