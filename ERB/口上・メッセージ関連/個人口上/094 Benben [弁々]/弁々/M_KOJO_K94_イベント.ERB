;デート帰り
;==================================================

@M_KOJO_SPEVENT_K94_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「흥...!」
			PRINTFORMDW 벤벤은 화를 내며 휙 돌아선 채 돌아갔다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「잘 가, %MASTERNAME:94%」
			PRINTFORMDW 벤벤은 그렇게 말하며 %CALLNAME:MASTER%쪽으로 몸을 돌려 인사했다.
			PRINTFORMW 「또 내일, %MASTERNAME:94%이랑 데이트할 수 있기를 기대하고 있을게」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「오늘은 이제 끝이야.」
			PRINTFORMW 「%MASTERNAME:94%, 너도 어서 돌아가렴.」
			PRINTFORMW 「...잘 가, 안녕.」
			PRINTFORMDW 벤벤은 그렇게 말하며 아쉬운 듯 손을 흔들고 떠났다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「그럼, 또 내일 봐, %MASTERNAME:94%도 건강하게 지내.」
			PRINTFORMDW 벤벤은 그렇게 말하고 서둘러 돌아갔다.
			PRINTW
		ELSE
			PRINTFORMW 「이제 돌아갈게」
			PRINTFORMW 「%MASTERNAME:94%도 너무 놀고 있으면 힘든 일을 겪을 거야.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「...좋아, 용서해 줄게」
			PRINTFORMW 「하지만 말이야... 너무 이상한 짓은 하면 안 돼?」
			PRINTFORMW 「%MASTERNAME:94%를 믿어줄 테니까」
		ELSE
			PRINTFORMW 「응, 알았어.」
			PRINTFORMW 「사람을 너무 화나게 하는 일은 하면 안 돼.」
			PRINTFORMW 「나는 상냥하니까 용서해 줄게.」
			PRINTFORMDW 벤벤은 어딘가 분노를 담은 미소로 그렇게 말했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「좋아, 조금만 용서해 주지」
			PRINTFORMW 「뭐 아직 화는 나 있지만 말이야」
			PRINTFORMW 「%MASTERNAME:94%, 좀 더 성의를 보여라」
		ELSE
			PRINTFORMW 「…」
			PRINTFORMW 「그렇게 쉽게 용서해 주지는 않을 거야」
			PRINTFORMW 「조금 정도라면 용서해 줄 수도 있지만」
			PRINTFORMDW 벤벤은 어딘가 어색한 미소로 그렇게 말했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「...알았어」
			PRINTFORMW 「하지만 아직 화가 나 있잖아」
			PRINTFORMW 「%MASTERNAME:94%, 좀 더 신뢰할 수 있는 태도를 취해라」
		ELSE
			PRINTFORMW 「…」
			PRINTFORMW 「아직 화났는데」
			PRINTFORMDW 벤벤은 %조사처리(CALLNAME:MASTER,"를")% 노려보며 그렇게 말했다.
		ENDIF
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
