@M_KOJO_EVENT_K94_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「데이트하자, %CALLNAME:MASTER%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...있잖아, 데이트 안 할래? %MASTERNAME:94%이 좋다면 말이야...」
				ELSEIF TALENT:思慕
					PRINTFORMW 「너, 지금 한가해?」
					PRINTFORMW 「잠깐 같이 있어줬으면 하는데... 안 될까?」
				ELSE
					PRINTFORMW 「저기, 잠깐 같이 있어 줄래?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「고마워, 좋아해, %MASTERNAME:94%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%MASTERNAME:94%는 친하게 지내는구나, 다른 아이들에게도 비슷한 건가 궁금하네?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「후훗, 데이트 같네 이거」
					PRINTFORMW 「...너무 들뜨지 마?」
				ELSE
					PRINTFORMW 「고마워, 내가 뭐라도 사줄게」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「아아, 아쉽네」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「그렇구나... 유감이야」
				ELSEIF TALENT:思慕
					PRINTFORMW 「...그렇네, 바빠 보이네. 미안해」
				ELSE
					PRINTFORMW 「아, 바쁜 거구나」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
