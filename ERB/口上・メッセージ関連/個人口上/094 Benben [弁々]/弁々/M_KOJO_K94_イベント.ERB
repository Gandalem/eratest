@M_KOJO_EVENT_K94_24(ARG,ARG:1)
;口上主はLOCAL
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;恋慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「...후훗, %MASTERNAME:94%의 아이...인가」
		PRINTFORMDW 벤벤은 태내의 생명의 고동을 느끼며 부드럽게 복부를 쓰다듬는다.
		PRINTFORMW 「당신 아이... 잘 낳아줄 테니까...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;思慕
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「...%MASTERNAME:94%의 아이...」
		PRINTFORMDW 벤벤은 태내 생명의 고동을 느끼자 상체를 부드럽게 쓰다듬는다.
		PRINTFORMW 「...부소신이라도 어머니가 될 수 있는 거구나」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質無し
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「…%MASTERNAME:94%… 임신시킨 책임은 지게 할 테니까…」
		PRINTFORMDW 벤벤은 태내의 생명의 고동을 느끼며 부드럽게 복부를 쓰다듬는다.
		PRINTFORMW 「후훗… 지금, 움직였다…」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「윽...흐읍...」
		PRINTFORMDW 벤벤은 기억에 없는 흐느낌과 함께 불쾌감을 드러낸다.
		PRINTFORMW 「싫어... 뭐야...!」
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
