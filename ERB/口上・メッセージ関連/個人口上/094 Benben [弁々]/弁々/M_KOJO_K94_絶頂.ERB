LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMDW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 콘돔에 정액을 뱉어냈다.
	ELSEIF TALENT:MASTER:濃厚精液
		IF RAND:3 == 0
			PRINTFORMW 「음... 고무 안에 가득 차 있다 %UNICODE(0x2665) *1%」
