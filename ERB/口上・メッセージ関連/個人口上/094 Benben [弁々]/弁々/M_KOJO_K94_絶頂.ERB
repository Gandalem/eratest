		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「정자 가득이네%UNICODE(0x2665) *1%」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그렇게 기분 좋았어%UNICODE(0x2665) *1%」
			RETURN 1
		ELSE
