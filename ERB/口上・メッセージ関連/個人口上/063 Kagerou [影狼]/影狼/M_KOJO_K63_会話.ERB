			CASE 3
				PRINTFORMDW Pfff!
				PRINTL
				PRINTFORML 「What are you saying, geez! Cough-cough!」
				PRINTFORMW 「I-I wasn't asking about that! You dummy!」
			CASEELSE
				GOTO INPUT_LOOP_09
			ENDSELECT
		CASE 30
