@K63_TALK_DATING
SELECTCASE CFLAG:63:現在位置
	;道中
	CASE ROAD_TO(CFLAG:TARGET:デート中)
		SELECTCASE RAND:10
			CASE 0,1,2
				PRINTFORMW 「후후후, 당신과 데이트할 생각에 너무 신나♪」
			CASE 3,4,5
				PRINTFORMW 「아직 갈 길이 멀어, 괜찮아? 피곤하지 않아?」
			CASE 6,7,8
				PRINTFORMW 「아, 잠시만요!」
				PRINTFORMW 「정말이지, 여자를 두고 가는 건 좀 무례한 거 아닌가요?」
			CASE 9
				PRINTFORMW 「어라? 이제 어디로 가야 하지? 음...」
		ENDSELECT
		;到着後
	CASEELSE
		;デート慣れ
		IF EXP:63:デート経験 > 49 && TALENT:恋慕
			SELECTCASE RAND:13
				CASE 0,1,2
					;場所の話,気が向いたら詳細分岐
