		CASE 2
			PRINTFORMW 「...Zzz... Zzz...」
		CASE 3
			PRINTFORML 「%CALLNAME:MASTER%... Are you awake...?」
			PRINTFORMW 「Fufu... Thank you...」
		CASE 4
			PRINTFORML 「I've never had anyone to lay next to until now...」
			PRINTFORMW 「I'm... so happy...」
		ENDSELECT
