	;会話不能
	ELSEIF TCVAR:302
		PRINTFORMW 「Hmm? %SPLIT_G("What is it:What's wrong")%?」
		PRINTFORMW 「........」
	;普段の会話
	ELSE
		SELECTCASE RAND:32 ;custom code
		CASE 0
