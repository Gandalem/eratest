;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
;発情中は必ず失敗
IF TCVAR:発情
	TFLAG:192 = -1
	CALL COLORMESSAGE(@"Sexual Frustration raised.",C_YELLOW,1)
	CFLAG:溜まってる度 += 50
	IF PALAM:TARGET:潤滑 < 3000
		CALL COLORMESSAGE(@"Lubrication raised.",C_YELLOW,1)
		PALAM:TARGET:潤滑 += 100
	ENDIF
ENDIF
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K63_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_300_1
;-------------------------------------------------
