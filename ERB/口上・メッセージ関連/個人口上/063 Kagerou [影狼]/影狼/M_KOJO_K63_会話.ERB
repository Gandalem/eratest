				PRINTFORML 「A-And I'm not saying it out of envy or anything!」
			WAIT
		CASE 27
			PRINTFORML 「You think this dress is pretty? Why thank you!」
			PRINTFORML 「Do you know what this pattern is based off?」
			$INPUT_LOOP_01
			PRINTDL [0] I do [1] I don't
			INPUT
			SELECTCASE RESULT
			CASE 0
				PRINTFORMW 「Great! Indeed, it's from hanafuda. The Susuki [pampas] Grass suit, Full Moon 20-point card.」
				PRINTFORMW 「I love this design!」
			CASE 1
				PRINTFORMW 「It's referenced from Hanafuda's Susuki [pampas] Grass suit, Full Moon card.」
				PRINTFORMW 「I don't actually own it, but if I find someone who does I'll have them show you.」
			CASEELSE
				GOTO INPUT_LOOP_01
			ENDSELECT
		CASE 28
			PRINTFORML 「Hey, which do you prefer, day or night?」
			$INPUT_LOOP_02
			PRINTDL [0] Day [1] Night
			INPUT
			SELECTCASE RESULT
			CASE 0
				PRINTFORMW 「Well, it's only a given. The night is the domain of us youkai, so beware!」
			CASE 1
				PRINTFORMW 「Contrarian much? Are you sure you're not reversing your days and nights by any chance? It's bad for your skin, you know.」
			CASEELSE
				GOTO INPUT_LOOP_02
			ENDSELECT
		CASE 29
			PRINTFORML 「Sniff-sniff... I'm a wolf, so... Sniff-sniff...」
			PRINTFORML 「My sense of smell is quite effective... Sniff-sniff...」
			CALL KUNKUN_KAGEROU
		CASE 30
			PRINTFORML 「Have you ever heard of a youkai under the willows who appears in the Human Village?」
			CALL ASK_M("I do",1,"Never heard of it",1,"I know who you're talking about",ABL:[[蛮奇]]:親密 >= 2)
			SELECTCASE RESULT
				CASE 0
					PRINTFORMW 「Wow! So even an outsider like you knows that much, I'm impressed!」
				CASE 1
					PRINTFORMW 「I knew it was obscure despite what she lead me to believe...」
				CASE 2
					PRINTFORML 「Uwaa... Even humans fresh from outside already figured it out...」
					PRINTFORMW 「I wonder if she's really doing well, living in the Village.」
			ENDSELECT
		CASE 31
			;ref to Animal Doctor vol 8 ch 72
			PRINTFORML 「Even though I'm a wolf, my mouth doesn't have any rubber gasket!?」
			PRINTFORML 「...Ohhh, I see, you're talking about that black part in the mouth of wolves and dogs. That's just our lips!」
			PRINTFORML 「It just doesn't look that way now because I'm not transformed.」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1


