@M_KOJO_EVENT_K63_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	;PRINTFORMW 「%GIFT_NAME%をあげるから大事に使って」
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物を大事にする（700点以上）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	PRINTFORML 「음~~~...」
	PRINTFORMDW 카게로우는 %GIFT_NAME%을 가지고 여기저기서 바라보며 만지작거렸다.
	PRINTFORML 「%TEXTR("Sure enough it's good!/It's nice!/It's exciting!/It's adorable!")%」
	IF STRCOUNT(GIFT_NAME, "(?i)(of the wolf|of full moon)")
		PRINTFORMW 「딱 맞는 선택이었지, 거의.」
	ELSEIF STRCOUNT(GIFT_NAME, "(?i)(claw|fang)")
		PRINTFORMW 「나도 이렇게 스스로 이런 것을 키울 수 있다면 좋겠는데...」
	ELSEIF STRCOUNT(SENSE, "(シンプル/|芸術的/)") && RAND:3
		PRINTFORMW 「이것을 선택했을 때 %HE_SHE(MASTER)%이 무엇을 하고 있었는지 알고 있는 것 같아.」
	ELSEIF STRCOUNT(SENSE, "(シック/|繊細/)") && RAND:3
		PRINTFORMW 「정말 품격 있네요, 안 그래요?」
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%정말 %TEXTR("a good taste/good eyes/a good sense of style")%하구나!」
	ENDIF
	K63_WADAI:0 = 贈り物
	K63_WADAI:1 '= GIFT_NAME
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	;IF STRCOUNT(SENSE, "身につける/")
	;	PRINTFORMW 「明日からこれを付けて行こうっと」
	;ELSE
	;	PRINTFORMW 「明日からこれを持って行こうっと」
	;ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	PRINTFORML 「흠~~~...」
	PRINTFORMDW 카게로우는 %GIFT_NAME%을 가지고 여기저기 각도에서 바라보며 가지고 논다.
	PRINTFORM 「나쁘지는 않은데, 하지만...」 
	IF STRCOUNT(SENSE, "(威厳/|壮大/)")
		PRINTFORMW 좀 너무 %TEXTR("pompous/grand")% 나한테는 좀 과한 것 같아...」
	ELSEIF STRCOUNT(SENSE, "派手/")
		PRINTFORMW 아마 좀 %TEXTR("gaudy/flashy/obtrusive/flamboyant")%하기에는 너무 과한 걸지도 모른다.
	ELSEIF STRCOUNT(SENSE, "(かわいい/|ロリータ/)")
		PRINTFORMW 조금 어린애 같달까……」
	ELSEIF STRCOUNT(SENSE, "金属/")
		PRINTFORMW 질감이 말이지……」
	ELSE
		PRINTFORMW %TEXTR("Somehow it doesn't quite fit me, after all/I just don't think it's my style")%...」
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	PRINTFORML 「음~~... %SPLIT_G(@"And what am I supposed to do with this... \"thing\"...?:I just don't know what %HE_SHE(MASTER)% was thinking with this one.")%」
	RETURN 1
ENDIF
RETURN 1
;セフレ契約用
;"補正"でRETURNした数値が理性判定に加算されるので、
;簡単にセフレにしたいならマイナス、難易度を上げたかったり実質不可能にしたいならプラスすべし

@KOJO_SF_CONTRACT_EVENT_K63(ARGS)
SELECTCASE ARGS
	CASE "導入"
		PRINTFORML 「섹프라고? 그게 무슨 소리야?」
		PRINTFORML 「응? 그냥 육체적인 관계?」
	CASE "補正"
		PRINTFORMW 「나를 바보로 보는 거야?」
		FONTBOLD
		PRINTFORMW 「내가 야수이고 평범한 요괴라는 이유만으로...」
		PRINTFORMW 「이런 식으로 내 눈을 속일 수 있다고 생각하나?! 대답해라!!!」
		FONTREGULAR
		SOURCE:反感 += 5000
		RETURN 5000
	CASE "成功"
		;PRINTFORML 「いいよー」
	CASE "失敗"
		;PRINTFORML 「おことわりだー」
ENDSELECT
