		PRINTFORMW 「You can pull the wool over my eyes like this, huh?! Answer me!!!」
		FONTREGULAR
		SOURCE:反感 += 5000
		RETURN 5000
	CASE "成功"
		;PRINTFORML 「いいよー」
	CASE "失敗"
		;PRINTFORML 「おことわりだー」
ENDSELECT