			PRINTFORMW 「그냥, 음... 목소리를 누르려고 베개로... 하려던 참이었어...」
			PRINTFORMDW 그녀의 송곳니 때문에 그 안에 커다란 두 개의 구멍이 남았어...
		ELSEIF TCVAR:360 >= 10
			PRINTFORMW 「음, 안 하고 싶지 않아서가 아니라... 너무 세게 오르지 말아주세요...」
			PRINTFORMW 「그냥 감당할 수 없을 것 같아요...%K17_BLUSH(2)%」
			CALL JUEL_UP_SPECIAL([[影狼]],"恥情","露出癖",2,1)
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
	;-------------------------------------------------
	;事後描写
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;精液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;愛液が垂れてきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;事後のムード
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			IF !TALENT:妊娠 && 充填率(TARGET,4) >= 10 && EXP:Ｖ性交経験 > 15
				IF !EXP:出産経験
					PRINTFORMW 「후후, 이거 먹고 임신할 수 있을까...」
					SIF !RAND:4
						PRINTFORMW 「나는 늑대 같기보다는 인간에 가깝기 때문에 당신의 아이를 가질 수 있을 거라고 확신해, %CALLNAME:MASTER%.」
				ELSEIF !RAND:4
					PRINTFORMDW 카게로우는 천천히 배 위로 손을 뻗는다.
					PRINTFORMW 「음, 당신의 씨앗, 내 안에서 느껴져...」
					PRINTFORMW 「최선을 다해줘, 작은 것들아, 그리고 \@ PREGNANCY_MULTIPLES(63) ? 아기들 # 아이를 \@...!」
				ELSEIF !RAND:4
					PRINTFORMW 「이 정도 양이면 곧 \@ PREGNANCY_MULTIPLES(63) ? 더 # 또 다른 아이가 생길 거라고 확신해.」 \@
					PRINTFORMW 「%TEXTR(@"지금부터 \@ PREGNANCY_MULTIPLES(63) ? 이름들 # 이름을 지어볼까? / 돈 잘 챙겨둬, 알겠지?\@")%」
				ELSE
					PRINTFORMW 「나는 정말로 많은 아이를 갖고 싶다...」
					PRINTFORMW 「%TEXTR(@"우리 무리 만들어서 사슴이랑 큰 고기 같이 사냥할 거야! / 온갖 꽃무늬 옷으로 꾸미고 그 모습처럼 보이게 할 거야! / 가족처럼 줄 서서 달에 울부짖을 거야! 물론 너도 마찬가지야, %CALLNAME:MASTER%.")%」
				ENDIF
			ENDIF
			IF ABL:奉仕精神 >= 3 && ABL:舌 >= 2 && ABL:精液中毒 >= 3 && STAIN:PLAYER:2 & 汚れ_精液 && !(STAIN:PLAYER:2 & 汚れ_アナル)
				STAIN:0 |= STAIN:PLAYER:2
				PRINTFORML 「잠깐만 기다려요.」
				PRINTFORMW 「제대로 치워 드릴게요～」
				CALL HPH_PRINT,@"「%RANDLIPS()%～～～!HPH」","W"
				PRINTFORMW 「%FSYN("lips_over")%...! 자, 다 했다～」
				PRINTFORMW 「후후, 또 만나길 바라♪」
				PRINTFORMD 늑대인간이 당신의 끝에 부드러운 키스를 새기자, 당신의 성기는 
				IF BASE:MASTER:精力 > 300
					PRINTFORMDL 빠르게 활력을 회복하고 다시 일어난다.
					PRINTFORMW 「정말 고집이 세구나, 응? 하지만 이번엔 네 스스로 감당해야 해, 끝났다고 말했잖아.」
				ELSE
					PRINTFORMDW 힘없이 축 늘어져, 완전히 짜여 있었다.
				ENDIF
				CALL JUEL_UP_SPECIAL([[影狼]],"恭順","奉仕精神",1,1)
				CALL AddEXP("精液経験", TARGET, 1)
				CALL AddEXP("口淫経験", TARGET, 1)
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;服を着る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 4
			IF INRANGE(DAY:3,13,17)
				IF FIRSTTIME("毛深着衣")
					PRINTFORMW 「나 보지 마, 절대 안 볼 거라고 맹세해!」
					PRINTFORMW 「만약 본다면 정말 화낼 거야.」
				ELSE
					PRINTFORMW 「...엿보지 않았지, 그렇지?」
				ENDIF
			ELSE
				PRINTFORMW 「우리 이미 다 했고 지나간 일인 건 알지만, 나를 그렇게 많이 쳐다보지 않았으면 좋겠어...」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
