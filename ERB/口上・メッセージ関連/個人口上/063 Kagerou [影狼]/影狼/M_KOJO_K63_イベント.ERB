;※※※※※※※※※※※※※※※※※※※※※※※※※※
;━━━━━━━━━━━━━━━━━━━━━━━━━━
;満月になると帰っちゃう（消えちゃう）
;外出中だと移動させても何故か戻っちゃうので凍結
;━━━━━━━━━━━━━━━━━━━━━━━━━━
@KAGEROU_ESCAPE
PRINTDW Kagerou suddenly leaves somewhere in a hurry...
;CFLAG:63:現在位置 = 99
;CFLAG:63:同室 = 0
;RETURN 1
CALL RUNOFF(63) ;custom code restored

;----------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K63_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
;1,2はまとめる 
;挨拶は一回だけ
IF LOCAL && !FLAG:70 && LOCAL:1 && (ARG == 1 || ARG == 2 || ARG == 6) && !TCVAR:350 ;edit
	;住み込み
	IF FLAG:住み込みキャラ == 63
		;満月の日
		SELECTCASE DAY:3
		CASE 15
			;満月の下
			IF MOON_WATCH(DAY:3) == 9
				;しかも中秋の名月
				SELECTCASE DAY:2
				CASE 3
					PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
					PRINTFORMW 「Tonight is... the harvest moon...」
					PRINTFORMW 「Umm, would you like to come look at the moon with me...?」
					PRINTFORML 「I-I'm really embarrassed, but if it's with you, then...」
					PRINTFORMW 「I'd like you to see my bare form...」
					PRINTFORMW 「And if you're with it, we could, umm...」
					PRINTFORMW 「No, that can wait! First off, let's just go watch the moon together!」
					BASE:63:理性 = 0
					TCVAR:発情 = 1
				;普通の満月
				CASEELSE
					PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
					PRINTFORMW 「Look, tonight is a full moon!」
					PRINTFORML 「It's embarrassing, but if it's with you then...」
					PRINTFORMW 「I want you to look at me now...」
					PRINTFORMW 「Fufu, I never thought something like this would happen, it's a mysterious feeling.」
					BASE:63:理性 = 0
					TCVAR:発情 = 1
				ENDSELECT
			;まだ昼で晴れてない
			ELSEIF TIME:2 >=1 && TIME:2 <= 4 && TIME:5 > 1
				PRINTFORMW 「Oh, %CALLNAME:MASTER%! Good morning.」
				PRINTFORMW 「Umm... Tonight is a full moon...」
				PRINTFORMW 「I'm not sure how the weather will turn out, but...」
				PRINTFORMW 「If it clears up, will you go moon-viewing with me?」
				CALL K63_ASK_OTSUKIMI
			;まだ昼
			ELSEIF TIME:2 >=1 && TIME:2 <= 4
				PRINTFORMW 「Oh, %CALLNAME:MASTER%, good morning.」
				PRINTFORMW 「Umm... Today's a full moon...」
				PRINTFORMW 「I'm not sure how the weather will turn out, but...」
				PRINTFORMW 「For now, let's hope it clears up soon.」
			;夜だけど晴れてない
			ELSEIF TIME:5 > 1
				;中秋の名月
				SELECTCASE DAY:2
				CASE 3
					PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
					PRINTFORMW 「Even though it's finally the harvest moon, what unfortunate weather...」
					PRINTFORMW 「Say, if it clears up, will you go moon-viewing with me?」
					CALL K63_ASK_OTSUKIMI
				;普通の満月
				CASEELSE
					PRINTFORMW 「Oh, %CALLNAME:MASTER%! Good evening.」
					PRINTFORMW 「Even though it's a full moon, what unfortunate weather...」
					PRINTFORML 「...Well, this is a physiological cycle, so...」
					PRINTFORMW 「I can still shapeshift, and even now some fur is still...」
					PRINTFORMW 「Hey, where are you looking?!」
				ENDSELECT
			;夜で晴れてるけど室内（秋）
			ELSEIF DAY:2 == 3
				PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
				PRINTFORMW 「Tonight is... the harvest moon...」
				PRINTFORMW 「Umm, will you go moon-viewing with me...?」
				PRINTFORML 「It, it's quite embarrassing, but if it's with you, then...」
				PRINTFORMW 「I don't mind showing you my bare form...」
				PRINTFORMW 「And if you'd like...」
				PRINTFORMW 「No, first let's just go watch the moon together!」
			;夜で晴れてるけど室内
			ELSE
				PRINTFORMW 「Ah... %CALLNAME:MASTER%...」
				PRINTFORMW 「Hey, tonight is a full moon.」
				PRINTFORML 「It's embarrassing, but if it's with you, then...」
				PRINTFORMW 「Right now, I wonder if it's okay to show you...」
				PRINTFORMW 「But then, maybe...」
				PRINTFORMW 「N-Never mind, it's nothing!」
			ENDIF
		;満月以外の日
		CASEELSE
			CALL K63_GREETING
		ENDSELECT

	;恋慕
	ELSEIF TALENT:恋慕
		;満月の日
		SELECTCASE DAY:3
		CASE 15
			;満月の下
			IF MOON_WATCH(DAY:3) == 9
				;しかも中秋の名月
				SELECTCASE DAY:2
				CASE 3
					PRINTFORMW 「Ah... %CALLNAME:MASTER%...」
					PRINTFORMW 「Tonight is, umm... The harvest moon...」
					PRINTFORML 「It, it's quite embarrassing, but if it's with you, then...」
					PRINTFORMW 「I'd like us to enjoy the harvest moon together...」
					PRINTFORMW 「And if you'd like...」
					PRINTFORML 「No! Never mind!」
					PRINTFORMW 「Rather than that, let's just go view the moon together!」
					BASE:63:理性 = 0
					TCVAR:発情 = 1
				;普通の満月
				CASEELSE
					PRINTFORMW 「Ah... %CALLNAME:MASTER%...」
					PRINTFORMW 「Look, tonight's a full moon...」
					PRINTFORML 「It's embarrassing, but if it's with you, then...」
					PRINTFORMW 「Right now, I wonder if it's okay to show you...」
					PRINTFORMW 「But then, maybe...」
					PRINTFORMW 「N-Never mind, it's nothing!」
					BASE:63:理性 = 0
					TCVAR:発情 = 1
				ENDSELECT
			;まだ昼で晴れてない
			ELSEIF TIME:2 >=1 && TIME:2 <= 4 && TIME:5 > 1
				PRINTFORMW 「Oh, %CALLNAME:MASTER%! Good morning.」
				PRINTFORMW 「Umm... Tonight's a full moon...」
				PRINTFORMW 「I still don't know how the weather will turn out, but...」
				PRINTFORMW 「If it clears up, will you go moon-viewing with me?」
				CALL K63_ASK_OTSUKIMI
			;まだ昼
			ELSEIF TIME:2 >=1 && TIME:2 <= 4
				PRINTFORMW 「Ah... %CALLNAME:MASTER%, umm... Good morning...」
				PRINTFORMW 「...Eh? I-Is something bothering me?」
				PRINTFORMW 「N-Nothing in particular, ahahaha...」
			;夜だけど晴れてない
			ELSEIF TIME:5 > 1
				;中秋の名月
				SELECTCASE DAY:2
				CASE 3
					PRINTFORMW 「Oh, %CALLNAME:MASTER%, good evening.」
					PRINTFORMW 「Even though it's finally the harvest moon, what unfortunate weather...」
					PRINTFORMW 「Say, if it clears up, will you go moon-viewing with me?」
					CALL K63_ASK_OTSUKIMI
				;普通の満月
				CASEELSE
					PRINTFORMW 「Oh, %CALLNAME:MASTER%, good evening!（Smile）」
					PRINTFORMW 「Today's weather's a bit unfortunate!（Smile）」
					PRINTFORML 「...Well, this is a physiological cycle, but...」
					PRINTFORMW 「I can just barely hold it together today...」
				ENDSELECT
			;夜で晴れてるけど室内（秋）
			ELSEIF DAY:2 == 3
				PRINTFORMW 「Ah... %CALLNAME:MASTER%...」
				PRINTFORMW 「Tonight is, umm... The harvest moon...」
				PRINTFORML 「It, it's embarrassing, but if it's with you, then...」
				PRINTFORMW 「I'd like us to enjoy the harvest moon together...」
				PRINTFORMW 「And if you'd like, umm...」
				PRINTFORML 「No! It's nothing!」
				PRINTFORMW 「More importantly, let's go moon-viewing together!」
			;夜で晴れてるけど室内
			ELSE
				PRINTFORMW 「Ah... %CALLNAME:MASTER%...」
				PRINTFORMW 「Hey, tonight's a full moon...」
				PRINTFORML 「It's embarrassing, but if it's with you, then...」
				PRINTFORMW 「Right now, I wonder if it's okay to show you...」
				PRINTFORMW 「But then, maybe...」
				PRINTFORMW 「N-Never mind, it's nothing!」
			ENDIF
		;満月以外の日
		CASEELSE
			CALL K63_GREETING
		ENDSELECT

	;恋慕じゃない
	ELSE
	;	;満月の日
		;custom code uncommented
		SELECTCASE DAY:3
		CASE 15
			;満月の下
			IF MOON_WATCH(DAY:3) == 9
				PRINTFORMW 「Gyaaa! %CALLNAME:MASTER%?!」
				PRINTFORML 
				PRINTFORMDL Do−−−−−−−−n!!!
				PRINTFORMW 
				PRINTFORMDW You get blinded before you know it!
			;まだ昼or夜だけど晴れてない
			ELSEIF TIME:2 >=1 && TIME:2 <= 4 || TIME:5 > 1
				PRINTFORMW 「Uugh! You're %CALLNAME:MASTER%!」
			;夜で晴れてるけど室内
			ELSE
				PRINTFORMW 「Gyaaa! %CALLNAME:MASTER%?!」
				PRINTFORML 
				PRINTFORMDL Do−−−−−−−−n!!!
				PRINTFORMW 
				PRINTFORMDW You get blinded before you know it!
			ENDIF
			CALL KAGEROU_ESCAPE
		;それ以外の日
		CASEELSE
			CALL K63_GREETING
		ENDSELECT
	ENDIF
	TCVAR:350 = 1
	RETURN 1
ENDIF
RETURN 1

;==================================================
;朝起きたとき（おはよう口上）
;==================================================
@M_KOJO_EVENT_K63_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
;コピペで無駄に長い
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;共通
		CALL 影狼起床
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		CALL 影狼起床
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

