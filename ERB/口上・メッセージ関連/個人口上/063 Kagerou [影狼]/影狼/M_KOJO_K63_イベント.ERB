	;-------------------------------------------------
	IF LOCAL:1 && ARG > 1 && !RAND:4
		IF ARG >= 7
			IF TALENT:[[影狼]]:恋慕
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
				PRINTFORML 「우리 더 많은 시간을 보내지 못하는 것 같아, %CALLNAME:MASTER%...」
				PRINTFORMW 「너를 더 보고 싶어—...」
				CFLAG:[[影狼]]:1004 ++
			ELSEIF TALENT:[[影狼]]:思慕 && !RAND:2
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
				PRINTFORMW 「꽤 오랜만에 보는군. 그동안 어떻게 지냈어, %CALLNAME:MASTER%?」
				CFLAG:[[影狼]]:1004 ++
			ELSEIF ABL:[[影狼]]:親密 >= 3 && !RAND:3
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
				PRINTFORMW 「그나저나, 요즘 너 못 봤어, %CALLNAME:MASTER%.」
			ENDIF
		ELSEIF !RAND:2
			CALL EVENTEND_TSUBUYAKI
			CALL 草の根と雑談
		ELSE
			CALL KAGEROU_LIFE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:思慕 && !RAND:5
			CALL EVENTEND_TSUBUYAKI() ;custom code
			PRINTFORML 「아아-」
			PRINTFORMW 「가끔은 내가 %조사처리(CALLNAME:MASTER,"가")% 늑대인간이었으면 좋겠어... 그러면 우리는...」
		ENDIF
		RETURN 1
	ENDIF
	IF !RAND:20 && TALENT:恋慕 && !TALENT:妊娠 && !TALENT:育児中
		CALL EVENTEND_TSUBUYAKI() ;custom code
		PRINTFORML 「흐으~~~...!」
		PRINTFORMDW 카게로우는 거울 앞에서 하품을 한다.
		IF !RAND:3
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 받아들일 만한 것을 피하기 위해 애쓰는 것조차 ... 뭔가 잘못된 기분이다.」
		ELSE
			PRINTFORML 「최근에 꾸미는 데 시간을 많이 쓰고 있는데, 내 원칙을 거스르는 것 같아...」
			PRINTFORMDW 그녀의 방침은 스스로를 위해 아름답게 보일 때만 그렇게 하라는 것이다.
			PRINTFORMW 「%CALLNAME:MASTER%앞에서 최대한 아름답게 보이고 싶어. 하지만 여전히 좀 잘못된 기분이야...」
		ENDIF
		PRINTFORMW 「흐으으응~~~~...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
