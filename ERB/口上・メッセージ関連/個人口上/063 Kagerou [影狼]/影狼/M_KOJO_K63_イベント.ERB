;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG > 1 && !RAND:4
		IF ARG >= 7
			IF TALENT:[[影狼]]:恋慕
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
				PRINTFORML 「I don't feel like we spend enough time with each other anymore, %CALLNAME:MASTER%...」
				PRINTFORMW 「I want to see you moreー...」
				CFLAG:[[影狼]]:1004 ++
			ELSEIF TALENT:[[影狼]]:思慕 && !RAND:2
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
				PRINTFORMW 「I haven't seen you in quite a while. What have you been up to, %CALLNAME:MASTER%?」
				CFLAG:[[影狼]]:1004 ++
			ELSEIF ABL:[[影狼]]:親密 >= 3 && !RAND:3
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
				PRINTFORMW 「By the way, I haven't seen you recently, %CALLNAME:MASTER%.」
			ENDIF
		ELSEIF !RAND:2
			CALL EVENTEND_TSUBUYAKI
			CALL 草の根と雑談
		ELSE
			CALL KAGEROU_LIFE
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:思慕 && !RAND:5
			CALL EVENTEND_TSUBUYAKI() ;custom code
			PRINTFORML 「Ahhー」
			PRINTFORMW 「Sometimes I wish %CALLNAME:MASTER% was a werewolf... Then we could...」
		ENDIF
		RETURN 1
	ENDIF
	IF !RAND:20 && TALENT:恋慕 && !TALENT:妊娠 && !TALENT:育児中
		CALL EVENTEND_TSUBUYAKI() ;custom code
		PRINTFORML 「Hnn～～～～...!」
		PRINTFORMDW Kagerou yawns in front of the mirror.
		IF !RAND:3
			PRINTFORMW 「Going out of my way to avoid things %CALLNAME:MASTER% might find acceptable also feels... kinda wrong.」
		ELSE
			PRINTFORML 「I've been spending a lot more time grooming recently, but it feels like I'm going against my own principles...」
			PRINTFORMDW Her policy is that you should only make yourself look good for yourself.
			PRINTFORMW 「I want to look as beautiful as possible in front of %CALLNAME:MASTER%. But it still feels a bit wrong...」
		ENDIF
		PRINTFORMW 「Hnnnnnhhh～～～～...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

