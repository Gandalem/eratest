;==================================================
;デート帰りにファーストKISS（合意も付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_K63_1
RETURN 1

@M_KOJO_SPEVENT_K63_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:70 && TALENT:恋慕
	PRINTFORMW 「Hey, %CALLNAME:MASTER%...」
	PRINTFORMW 「I have something to ask... I wonder if you'll listen...」
	PRINTFORMW 「Would you close your eyes for me?」
	PRINTL 
	CALL ASK_YN("Agree", "Refuse")
	IF !RESULT
		PRINTFORMDW ――You hear a soft whisper near your ear.
		PRINTL
		PRINTFORMW 「I'm going to... kiss you...」
		PRINTFORMW 「......」
		PRINTFORMW 「...」
		PRINTFORMW 「...」
		PRINTW
		PRINTFORMDW ――Chuu
		PRINTW
		PRINTFORMW 「...」
		PRINTFORMW 「Fufu... Thank you...%CALLNAME:MASTER%...」
		IF TALENT:MASTER:キス未経験
			PRINTFORMW 「Looks I've taken your first kiss.」
		ELSEIF TALENT:キス未経験
			PRINTFORMW 「That's my... first kiss...」
		ENDIF
		PRINTFORMW 「Let's do this again♪」
	ELSE
		PRINTFORMW 「You won't?」
		PRINTFORMW 「Hmph...」
		PRINTFORMW 「......」
		TCVAR:キスキャンセル = 1
	ENDIF
ELSE
	;キスをキャンセルしたい場合は以下を開放
	TCVAR:キスキャンセル = 1
ENDIF
RETURN 1

;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_K63_2
RETURN 1

@M_KOJO_SPEVENT_K63_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:70 ;&& TALENT:恋慕
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1013)
			PRINTFORMW 「Hey, %CALLNAME:MASTER%.」
			PRINTFORMW 「Do you, umm... h-have a... special someone...?」
			PRINTFORMW 「Oh, so you don't... I see...」
			PRINTFORMW 「To tell you the truth... You know, well...」
			PRINTFORMW 「I-I'm in love with you, %CALLNAME:MASTER%!」
			PRINTL
			PRINTFORMW 「I-I know it's weird, coming out of nowhere...」
			PRINTFORMW 「Even though I'm a werewolf, to fall in love with a human is just... totally ridiculous...」
			PRINTFORMW 「That's why at first, I kept telling myself I was a little confused...」
			PRINTFORMW 「But before I realized it... Even knowing it was strange... You were the only thing on my mind...」
			PRINTFORMW 「I can't think of anything except you, and...」
			PRINTFORMW 「And then... I had no idea what to do anymore...」
			PRINTL
			PRINTFORMW 「But... today, after spending my time with you, I realized.」
			PRINTFORMW 「I love you... It may sound silly, but it's true...」
			PRINTFORMW 「So, please... Will you let me be your girlfriend...?」
		;諦めきれない
		ELSE
			PRINTFORMW 「Hey, %CALLNAME:MASTER%...」
			PRINTFORMW 「Umm... Actually, I...」
			PRINTFORMW 「I just can't give up... I...love you...」
			PRINTFORMW 「Since then, I've told myself countless times to let it go, to forget...」
			PRINTFORMW 「But I can't... no matter what, I don't want to part with you...」
			PRINTFORMW 「I can't think of anything except you...」
			PRINTFORMW 「I know I'm repeating myself... And I know this isn't how things usually go...」
			PRINTFORMW 「But, please... I want to be your girlfriend...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「...Really?!」
		PRINTFORMW 「Is it really okay? Even though I'm a werewolf?」
		PRINTFORMW 「...I'm so happy...! I've...always...loved you...」
		PRINTFORMW 「I wanted... To always be with you... To have you accept me...」
		PRINTFORMW 「But I'm a youkai... I'm a werewolf, so I thought it was hopeless...」
		PRINTFORMW 「Thank you, %CALLNAME:MASTER%... Thank you...」
		PRINTFORMW 「From now on... Please take care of me, %CALLNAME:MASTER%...♪」
		;告白時に経験が入らないのは納得いかないので
		CALL MUTUAL_KISS(TARGET, 1, 0)
		EXP:愛情経験 += 10
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;エミリアの台詞が好きなので借りてます
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「I see... That's right...」
		PRINTFORMW 「Yes... I understand...」
		PRINTFORMW 「Sorry... for saying useless things...」
		PRINTFORMW 「It's fine, I figured that's what you'd respond with...」
		PRINTFORMW 「I was prepared, so... I'm fine... I'm okay...」
		PRINTFORMW 「But right now, let me cry a little for a bit...」
		PRINTW
		PRINTFORMW 「Yeah, I'm fine. Now that I've let it all out, I feel refreshed.」
		PRINTFORMW 「Come, let's head back...」
		;振っておいて告白するという畜生用フラグ
		CFLAG:1002 = 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1
