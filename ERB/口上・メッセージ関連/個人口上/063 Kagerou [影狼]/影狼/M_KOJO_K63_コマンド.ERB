RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;一緒に掃除する時だけ
IF LOCAL && !FLAG:70 && ABL:親密 * 500 + ABL:従順 * 500 + ABL:清掃技能 * 1000 > CFLAG:310 - CFLAG:MASTER:310
	;寝てる時
	IF CFLAG:睡眠
		PRINTFORMW 「Suu...suu...nn... Keho Keho...」
	;寝てない
	ELSE
	;掃除前口上
		SELECTCASE YOGORE:(CFLAG:MASTER:現在位置)
		;清潔度：高
		CASE IS < 500
			PRINTFORMW 「We should be able to finish up this much in a flash.」
		;清潔度：中
		CASE IS < 2000
			PRINTFORMW 「It's gotten quite messy, hasn't it...」
		;清潔度：低
		CASE IS < 5000
			PRINTFORMW 「Uwah! This is terrible!」
		;清潔度：ゴミの山
		CASEELSE
			PRINTFORMW 「Now, let's clean, clean! Let's disinfect all of this filth!」
		ENDSELECT
		PRINTFORMDW ...
		;恋慕
		IF TALENT:恋慕
			SELECTCASE CFLAG:現在位置
			;縁側
			CASE 10
				PRINTFORML 「This is the shrine's parlor.」
				PRINTFORMW 「If we don't keep it clean, it'll leave a bad impression.」
			;Reimu私室
			CASE 15
				PRINTFORML 「But why am I cleaning that Shrine Maiden's room...?」
				PRINTFORMW 「Well, since you're the one asking, I guess I have little choice.」
			;参道
			CASE 22
				PRINTFORML 「The shrine's main entrance is quite a busy area.」
				PRINTFORMW 「I come here a lot too, so we have to properly keep it maintained.」
			;ボロ小屋
			CASE 16
				;影狼の小屋
				IF FLAG:住み込みキャラ == 63
					PRINTFORML 「Sorry... Having you help me, when I should be doing it myself...」
					PRINTFORMW 「B-But, don't clean it when I'm not around!」
				;誰かの小屋
				ELSEIF FLAG:住み込みキャラ
					PRINTFORMW 「%CALLNAME:(FLAG:住み込みキャラ)% should thank me for this.」
				;ボロいまま
				ELSE
					;住みたい
					IF EXP:愛情経験 >= 200 
						PRINTFORML 「Hmーm, If it was fixed up a little, I could probably live here.」
						PRINTFORMW 「Hey, we're the ones cleaning it, so I wonder if that would be okay...」
					;まだ住みたくはない
					ELSE
						PRINTFORML 「Why are we cleaning this worn-out shed?」
						PRINTFORMW 「Ah! I see! Someone is moving in!」
					ENDIF
				ENDIF
			;台所掃除
			CASE 8
				PRINTFORML 「I don't usually use the kitchen so I'm not too sure, but...」
				PRINTFORMW 「Does this place get dirty that often?」
			;トイレ掃除
			CASE 14
				PRINTFORMW 「Why do I have to clean the toilet～!」
			;風呂掃除
			CASE 13,24
				PRINTFORML 「Geez! I finally came to relax, so why do I have to clean.」
				PRINTFORMW 「It's because %CALLNAME:MASTER% likes to clean, isn't it.」
			;鎮守の森
			CASE 25
				PRINTFORML 「This is more like a woods than a grove.」
				PRINTFORML 「Even if you tried to clean a place like this, it'd never end.」
				PRINTFORMW 「Ah, I wonder if I'll bring divine punishment for saying that.」
			;賽銭箱
			CASE 3
				PRINTFORML 「I wonder how much is in that offering box...」
				PRINTFORMW 「Kidding kidding, it was a joke %CALLNAME:MASTER%, don't look at me like that.」
			;それ以外
			CASEELSE
			ENDSELECT
			PRINTL 
			PRINTFORML 「Fuuー I'm tired!」
			PRINTFORMW 「Anyway, this should be good enough for now.」
			IF EXP:MASTER:異常清掃経験 > 500
				PRINTFORML 「Oiー %CALLNAME:MASTER%, are you done?」
				PRINTFORMW 「Eh... Your eyes are bloodshot, are you okay?」
			ENDIF
		;恋慕じゃない
		ELSE
			PRINTFORML 「I'd like it to be a little bit cleaner, but...」
			PRINTFORMW 「Well, this should be good enough for now.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
