						PRINTFORML 「아하... 하지만...」
						PRINTFORMW 「따뜻하고 기분이 좋아...」
					CASE 1
						PRINTFORML 「응...」
						PRINTFORML 「...푸하...」
						PRINTFORMW 「후우... 더, 더...」
					CASE 2
						PRINTFORML 「아우... 추...」
						PRINTFORML 「츄 츄...」
						PRINTFORMW 「머리가 하얘져가네...」
				ENDSELECT
			CASE IS > 70
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「음...!」
						PRINTFORML 「츄우... 레로...」
						PRINTFORMW 「...푸하... 후후... 얼마나 격렬해♪」
					CASE 1
						PRINTFORML 「아하... 헤로...츄...」
						PRINTFORMW 「응... 더...?」
				ENDSELECT
			CASE IS > 20
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「응... 츄...」
						PRINTFORMW 「후후... 기분 좋아...」
					CASE 1
						PRINTFORML 「아...ㄴ...」
						PRINTFORML 「츄...」
						PRINTFORMW 「후아... 따뜻해...」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「Nn...」
						PRINTFORML 「...후우...」
						PRINTFORMW 「미-미안해... 아직 익숙하지 않아서...」
					CASE 1
						PRINTFORML 「아...응...」
						PRINTFORMW 「정말, 너무 갑작스럽게 했기 때문에 그래...」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
