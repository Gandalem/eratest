	CASEELSE
		PRINTFORML 「%TEXTR("What? What are you looking for?/Kun kun... Maybe this way.../Nnー, there's not much of a smell...")%」
	ENDSELECT
	IF !RAND:4
		SELECTCASE RAND:4
		CASE 0
			PRINTFORMDW When working outdoors, Kagerou is vivacious and sometimes even wildly cool.
		CASE 1
			PRINTFORMDW Kagerou never breaks her stride, even on bad roads and in the bush.
		CASE 2
			PRINTFORM 「Yotto!」
			PRINTFORMDW  Kagerou effortlessly jumps over obstacles with grace and poise.
		CASE 3
			PRINTFORM 「I'm going to dig a little right here...」
			PRINTFORMDW  She starts digging a hole at great speed.
		ENDSELECT
	ENDIF
	CALL TRAIN_MESSAGE
	IF !TFLAG:193 && (CFLAG:MASTER:今日の運勢 / 20 - 25 + TFLAG:幸運補正 * 10 < 0)
		PRINTFORML 「Maybe my luck isn't so good today...」
		RETURN 1
	ENDIF
	;低確率でオマケ獲得
	IF TFLAG:193 && TALENT:採集Lv * 2 >= RAND:100
		PRINTFORMW 「Wait, I smell the same thing from over there!」
		PRINTFORMDW ...
		CALL COLORMESSAGE(@"Kagerou has found another %ITEMNAME_TR(TFLAG:193)%!",0x00FF00,1)
		ITEM:(TFLAG:193) ++
		EXP:採集経験 ++
		PRINTFORMW 「Aren't you glad I'm helping you out?」
	ELSEIF TALENT:採集Lv * 2 >= RAND:100
		PRINTFORMW 「Ah!」
		CALL SPTALK, [[影狼]], "笑顔", 0, @"「This stone looks like something that Waggy-chan would enjoyー」", 1 
		;CFLAG:[[影狼]]:1006 = 1
		CALL KIGEN_CHANGE(TARGET,100,1)
	ENDIF
ENDIF
RETURN 1
