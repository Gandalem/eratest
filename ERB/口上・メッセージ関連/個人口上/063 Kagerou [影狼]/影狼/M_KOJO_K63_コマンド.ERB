;302,スキンシップ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K63_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
IF TCVAR:発情
	IF TALENT:恋慕
		TFLAG:192 = 1
	ELSE
		TFLAG:192 = -1
	ENDIF
ELSEIF (TALENT:恋慕 || TALENT:思慕) && DAY > K63_EYEBROW && AT_HOME(MASTER)
	TFLAG:192 = 1
ELSE
	RETURN 0
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K63_302
CALL M_KOJO_MESSAGE_COM_K63_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70 
	;初回
	IF FIRSTTIME(302)
		PRINTFORMW 「H-Hey! Don't just nonchalantly touch me!」
		PRINTFORMW 「Ah, sorry... It was so sudden I was surprised...」
		SIF TALENT:思慕
			PRINTFORMW 「Well... If it's you, then I don't mind... maybe just for a bit...」
		RETURN 1
	ENDIF
	
	;恋慕（お風呂）
	IF TALENT:恋慕 && BATHROOM()
		PRINTFORML 「You'll wash my back?」
		PRINTFORMW 「Thank you...」
		PRINTL
		SELECTCASE RAND:3
		CASE 0
			PRINTFORMW 「Umm... Please don't stare too much...」
		CASE 1
			PRINTFORMW 「Aha♪ I-I'm ticklish there! Fufu.」
		CASE 2
			PRINTFORMW 「Okay, I'm next...」
		ENDSELECT
		RETURN 1
	ENDIF
	IF TCVAR:発情
		FONTBOLD
		CALL HPH_PRINT,@"「Hyahn～HPH」","W"
		FONTREGULAR
		IF TALENT:恋慕
			CFLAG:溜まってる度 += 100
			PALAM:TARGET:潤滑 += 500
			BASE:TARGET:ムード += 500
			PRINTFORMW 「I-I'm sorry... I just don't want to be touched right now... It's not that I don't like it, it's just...」
			PRINTFORMW （Uuu, when %CALLNAME:MASTER% touches me, my body starts preparing itself for mating...）
			IF TALENT:自己愛 >= 0
				CFLAG:TARGET:同行 = 60
				CFLAG:MASTER:同行 = 60
				PRINTFORMW 「Hora... You know, right? Hey, let's go over there?」
				PRINTFORMDW %CALLNAME:TARGET% grabs %CALLNAME:MASTER% by the sleeve...
			ENDIF
		ELSEIF TALENT:思慕
			PRINTFORMW 「I-I'm sorry... But I think I'd like you to leave me alone for now...」
		ELSE
			PRINTFORMW 「Hey, don't touch me! Get off me!」
			CFLAG:ブチギレ = 1
		ENDIF
		CALL COLORMESSAGE(@"Frustration increased",C_YELLOW,1)
		CFLAG:溜まってる度 += 100
		IF PALAM:TARGET:潤滑 < 3000
			CALL COLORMESSAGE(@"Lubrication has increased",C_YELLOW,1)
			PALAM:TARGET:潤滑 += 500
		ENDIF
		RETURN 1
	ENDIF
	IF (TALENT:恋慕 || TALENT:思慕) && DAY > K63_EYEBROW && AT_HOME(MASTER)
		CALL K63_眉カット
		RETURN 1
	ENDIF
	CALL KAGEROU_SKINSHIP
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RESULT
		;手を握る
		CASE 0
			IF !RAND:3
				PRINTFORML 「Ah so %CALLNAME:MASTER%'s hands are different from mine after all.」
				PRINTFORMW 「They're human hands, meant for making and handling tools.」
			ELSEIF RAND:2
				PRINTFORML 「Ah... Wai...」
				PRINTFORMW 「My hands...my claws are quite sharp, so be careful...」
			ELSE
				PRINTFORML 「Fufu, It's faint, but I can feel your warmth...」
				PRINTFORML 「With our fingers entwined like this...」
				PRINTFORMW 「Ah, It's a bit embarrassing, so let's leave it at that...」
			ENDIF
		;頬を撫でる
		CASE 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「Ah... What is it, %CALLNAME:MASTER%...?」
					PRINTFORMW 「Fufu, let me return the favor!」
				CASE 1
					PRINTFORML 「Wah! That was unexpected, you caught me off guard.」
					PRINTFORMW 「D-Don't pinch, okay?」
				CASE 2
					PRINTFORML 「Mm...」
					PRINTFORMDW Kagerou closes her eyes and leans into your hand, tilting her head towards you as if wishing to be petted.
			ENDSELECT
		;耳に触る
		CASE 2
			IF RAND:2
				PRINTFORML 「These ears are the real thing.」
				PRINTFORMW 「It's a basic principle for beast-type Ayakashi♪」
			ELSE
				PRINTFORML 「These ears are moveable, look!」
				PRINTFORMW 「When I need to hide them, I can flatten them, just like this...」
			ENDIF
		;顎を擽る
		CASE 3
			IF RAND:2
				PRINTFORML 「Ah, that feel good...」
				PRINTFORMW 「B-But it's a bit ticklish.」
			ELSE
				PRINTFORML 「Fuaa... It tickles...」
				PRINTFORMW 「Aah... Also, it's a bit embarrassing being treated like a puppy...」
			ENDIF
		;髪に触る
		CASE 4
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「I try to keep it well groomed, but...」
					PRINTFORMW 「When you examine it closely like this, I'm strangely nervous...」
				CASE 1
					PRINTFORML 「Don't sniff it like that～...」
					PRINTFORMW 「It's embarrassing...」
				CASE 2
					PRINTFORML 「Does it feel good touching them?」
					PRINTFORMW 「Fufu, this is something I have some confidence in.」
			ENDSELECT
			PRINTFORMDW You enjoy the touch of her glossy black hair...
		;肩を揉む
		CASE 5
			PRINTFORMW 「Ah～ Feels good～♪」
			IF RAND:2
				PRINTFORML 「You're pretty good at this.」
				PRINTFORMW 「Were you trained by Reimu?」
			ELSE
				PRINTFORMW 「This time I'll do it for you.」
				PRINTL 
				PRINTFORML 「Customer is quite stiff～」
				PRINTFORMW 「How is it? Am I doing well?」
			ENDIF
		;背を撫でる
		CASE 6
			IF RAND:2
				PRINTFORML 「Fuaah～...!」
				PRINTFORMW 「For some reason, this really relaxes me.」
			ELSE
				PRINTFORML 「Aaah... Somehow, I feel relaxed...」
				PRINTFORMW 「I feel at ease... Like I'm about to fall asleep...」
			ENDIF
		;脇腹をつつく
		CASE 7
			IF RAND:2
				PRINTFORML 「Ahaha! That tickles!」
				PRINTFORML 「I'll do it to you as well.」
				PRINTFORMW 「Here! Take this and that!」
			ELSE
				PRINTFORML 「Hey, that tickles! Ahaha!」
				PRINTFORML 「Kyaa! No more!」
				PRINTFORMW 「It tickles, I said～!」
			ENDIF
		;鼻を擽る
		CASE 8
			IF RAND:2
				PRINTFORML 「Fua... It feels itchy～...」
				PRINTFORMW 「Apchoo!」
			ELSE
				PRINTFORML 「Fufu, what are you trying to do?」
				PRINTFORML 「I'll do it to %CALLNAME:MASTER% too.」
				PRINTFORMW 「How is it? Feels weird, doesn't it?」
			ENDIF
		;ぺたぺた
		CASE 9
			PRINTFORML 「Why are you patting me all of a sudden?」
			IF RAND:2
				PRINTFORML 「It's not like I hate it, you can do it as much as you'd like, but...」
				PRINTFORMW 「It's a bit suspicious... %CALLNAME:MASTER%.」
			ELSE
				PRINTFORML 「If you want to touch me that much... Umm...」
				PRINTFORMW 「If we go someplace we can be alone, then...」
			ENDIF
		CASE 10
			IF FIRSTTIME("肉球")
				PRINTFORMW 「You want to touch the sole of my paws? Well, if I transform then...」
				PRINTFORMDL Kagerou puts her right hand in her left sleeve and wiggles it about.
				PRINTFORMDL And when she pulls it out, it's the paw of a wolf.
				PRINTFORMW 「So, go ahead.」
				PRINTFORMDL It's... not soft, it's like the sole of a shoe...
				PRINTFORMW 「Yeah, Waggy and my other friends were disappointed as wellー...」
			ELSE
				PRINTFORML 「%TEXTR("I don't get what's to interesting.../Again? Fine, very well...")%」
				PRINTFORMDL You are allowed to touch her transformed hand.
				IF !RAND:3
					PRINTFORML 「You've seen mitten-sized beast hands in a book? Is that what you're expecting?」
					PRINTFORMW 「Ah, that's a fox... That is not a wolf...」
				ELSE
					PRINTFORMDW %TEXTR("These are not her usual feminine hands, but these too are Kagerou's./A beast's powerful forelimb made for scratching the ground and kicking.")%
				ENDIF
			ENDIF
		;人狼
		CASE 100
			CALL ERATOHO_JINROU_GAME
		ENDSELECT
	;恋慕じゃない
	ELSE
		SELECTCASE RESULT
		;手を握る
		CASE 0
			PRINTFORML 「Oh my, your nails are quite clean.」
			PRINTFORMW 「Do you trim them every day, perchance?」
		;頬を撫でる
		CASE 1
			PRINTFORML 「What what whatー?!」
			PRINTFORMW 「Geez, it's always so sudden, you surprised me!」
		;耳に触る
		CASE 2
			PRINTFORML 「These are also real ears.」
			PRINTFORMW 「How do they work? Fufufu, that's a secret♪」
		;顎を擽る
		CASE 3
			PRINTFORML 「...Do you think I'm just like a dog?」
			PRINTFORMW 「I'll get mad, you know?」
		;髪に触る
		CASE 4
			PRINTFORML 「Do you like my hair...?」
			PRINTFORML 「Well, a woman's hair is her life, after all.」
			PRINTFORMW 「What, is that odd for a Youkai to say?」
		;肩を揉む
		CASE 5
			PRINTFORML 「Ahー That's nice. That feels good.」
			PRINTFORMW 「If you want to do more, go ahead～」
		;背を撫でる
		CASE 6
			PRINTFORML 「Kyaa! What was that for?! Geez.」
			PRINTFORMW 「That gave me chills～～」
		;脇腹をつつく
		CASE 7
			PRINTFORML 「Wawah! What are you doing!」
			PRINTFORMW 「You...! You!」
		;鼻を擽る
		CASE 8
			PRINTFORML 「Fuah... What... Apchoo!」
			PRINTFORMW 「Geezー! What was that forー!」
		;ぺたぺた
		CASE 9
			PRINTFORML 「Why are you petting me?」
			PRINTFORML 「Since you live at the shine, youkai shouldn't be that rare for you.」
			PRINTFORMW 「If you do things like that, you can't complain even if you get eaten, you know?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
