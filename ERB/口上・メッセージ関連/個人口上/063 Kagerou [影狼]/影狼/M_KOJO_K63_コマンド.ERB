;301,お茶を淹れる
;==================================================
@M_KOJO_MESSAGE_COM_K63_301
CALL M_KOJO_MESSAGE_COM_K63_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70 
	;初回
	IF FIRSTTIME(301)
		PRINTFORML 「My, you even bothered to make some tea for me. Thank you!」
		SELECTCASE DAY:2
		;夏
		CASE 2
			PRINTFORML 「Cold tea on a hot day really is the best～」
			PRINTFORML 「I'd drink hot tea too, though.」
		;夏じゃない
		CASEELSE
			PRINTFORML 「Am I alright with hot tea?」
		ENDSELECT
		PRINTFORML 「It's true that wild wolves all have sensitive, cat tongues.」
		PRINTFORML 「But if you think a Youkai werewolf is the same, you're making a huge mistake.」
		PRINTFORMW 「Still, I wonder why it's called a cat's tongue... Sip-sip...」
	;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:6
		CASE 0
			PRINTFORML 「As expected of %CALLNAME:MASTER%, how thoughtful♪」
			PRINTFORMW 「Nn～ Delicious～♪」
		CASE 1
			PRINTFORML 「My, thank you♪ Now let's take a sip...」
			PRINTFORMDW Suu Suu...
			PRINTFORML 「Humans use fire so they don't have cat tongues.」
			PRINTFORML 「From nature's point of view, humans' tastes are quite weird.」
			PRINTFORML 「In other words we have human tongues, both me and you.」
			PRINTFORMW 「Huh? But I'm a Youkai, so it's a Youkai tongue, huh.」
		CASE 2
			PRINTFORML 「Kyaa～! I was just feeling thirsty! Thank you, %CALLNAME:MASTER%♪」
			PRINTFORML 「You can't get drunk off tea, so unlike sake you can drink as much as you want.」
			PRINTFORML 「But you shouldn't drink too much of either.」
			PRINTFORMW 「If you drink too much tea you won't be able to sleep!」
		CASE 3
			PRINTFORML 「I've thought about this before, but...」
			PRINTFORML 「Just when did you make this tea, I wonder?」
			PRINTFORMW 「You sometimes do some mysterious things!」
		CASE 4
			PRINTFORML 「I'm just so glad that you make me tea♪」
			PRINTFORMW 「As always, I appreciate the gesture♪」
		CASE 5
			SELECTCASE DAY:2
			CASE 1
				PRINTFORML 「My, how unusual, it's matcha this time. I'll receive it gratefully.」
				PRINTFORMW 「Uu, it's a bit bitter...」
			CASE 2
				PRINTFORML 「After all, summer means barley tea.」
				PRINTFORMW 「Always remember to stay hydrated!」
			CASE 3
				PRINTFORML 「My, today's a black tea, it seems. I'll receive it gratefully.」
				PRINTFORMW 「Hmー The taste is good, but the aroma is the best.」
			CASE 4
				PRINTFORML 「Waa～ Thank you!」
				PRINTFORMW 「It's warm and delicious～!」
			ENDSELECT
		ENDSELECT
	;恋慕じゃない
	ELSE
		SELECTCASE RAND:6
		CASE 0
			PRINTFORML 「My, how thoughtful. Thank you very much!」
			PRINTFORMW 「Nn～ Delicious～」
		CASE 1
			PRINTFORMW 「My, thank you. Let's dig in!」
			PRINTL 
			PRINTFORML 「Humans are the only animals who don't have cat tongues.」
			PRINTFORMW 「Although I'm not sure about the shapeshifting animal Youkai.」
		CASE 2
			PRINTFORML 「Nnー! I was just feeling thirsty. Thank you.」
			PRINTFORMW 「No matter what species, everyone finds tea and sake delicious.」
		CASE 3
			PRINTFORML 「I've wondered this before, but...」
			PRINTFORML 「Just when did you make this tea?」
			PRINTFORMW 「Could it be black magic?!」
		CASE 4
			PRINTFORML 「For taking the trouble, I'm grateful.」
			PRINTFORMW 「Aah, both the tea and your kindness are spreading through me～」
		CASE 5
			SELECTCASE DAY:2
			CASE 1
				PRINTFORMW 「Ara, how unusual, it's matcha this time. I'll receive it gratefully.」
				PRINTFORMW 「Uu, it's a bit bitter...」
			CASE 2
				PRINTFORML 「After all, summer means barley tea.」
				PRINTFORMW 「Always remember to stay hydrated!」
			CASE 3
				PRINTFORML 「My, today's a black tea, it seems. I'll receive it gratefully.」
				PRINTFORMW 「Hmー The taste is good, but the aroma is the best.」
			CASE 4
				PRINTFORML 「Waa～ Thank you!」
				PRINTFORMW 「It's warm and delicious～!」
			ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
