SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
	RETURN RESULT
;幸運補正をリセット
TFLAG:幸運補正 -= TCVAR:355
TCVAR:355 = 0
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_445_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠 ;custom code
		RETURN 0
	SELECTCASE CFLAG:デート中
		;竹林
		CASE 4
			PRINTFORML 「이 지역은 익숙하다.」
			;森
		CASE 5
			PRINTFORML 「여기는 여전히 버섯 냄새가 나네...」
			;山
		CASE 7, 8
			PRINTFORML 「이 장소들에서는 냄새를 따라가기가 쉽다.」
		CASEELSE
			PRINTFORML 「%TEXTR("What? What are you looking for?/Kun kun... Maybe this way.../Nnー, there's not much of a smell...")%」
	ENDSELECT
	IF !RAND:4
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW 야외에서 활동할 때, 카게로우는 활기차고 때로는 매우 멋있다.
			CASE 1
				PRINTFORMDW 카게로우는 나쁜 길이나 수풀 속에서도 걸음을 멈추지 않는다.
			CASE 2
				PRINTFORM 「요토옷!」
				PRINTFORMDW  카게로우는 우아함과 평정심으로 장애물 위를 힘들이지 않고 뛰어넘는다.
			CASE 3
				PRINTFORM 「여기서 조금 파볼 생각이야...」
				PRINTFORMDW  그녀는 빠른 속도로 구덩이를 파기 시작한다.
		ENDSELECT
	ENDIF
	CALL TRAIN_MESSAGE
	IF !TFLAG:193 && (CFLAG:MASTER:今日の運勢 / 20 - 25 + TFLAG:幸運補正 * 10 < 0)
		PRINTFORML 「오늘 운이 별로 아닌가 봐...」
		RETURN 1
	ENDIF
	;低確率でオマケ獲得
	IF TFLAG:193 && TALENT:採集Lv * 2 >= RAND:100
		PRINTFORMW 「잠깐만, 저쪽에서도 똑같은 냄새가 나!」
		PRINTFORMDW ...
		CALL COLORMESSAGE(@"카게로우가 또 다른 %ITEMNAME_TR(TFLAG:193)%을 찾았다!",0x00FF00,1)
		ITEM:(TFLAG:193) ++
		EXP:採集経験 ++
		PRINTFORMW 「내가 도와주고 있어서 기쁘지 않니?」
	ELSEIF TALENT:採集Lv * 2 >= RAND:100
		PRINTFORMW 「Ah!」
		CALL SPTALK, [[影狼]], "笑顔", 0, @"「이 돌은 와기짱이 좋아할 만한 것 같아~」", 1
		;CFLAG:[[影狼]]:1006 = 1
		CALL KIGEN_CHANGE(TARGET,100,1)
	ENDIF
ENDIF
RETURN 1
