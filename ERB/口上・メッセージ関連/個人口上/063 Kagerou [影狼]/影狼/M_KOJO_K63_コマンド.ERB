@M_KOJO_MESSAGE_COM_K63_301
CALL M_KOJO_MESSAGE_COM_K63_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;初回
	IF FIRSTTIME(301)
		PRINTFORML 「저런, 나를 위해 차까지 타다니. 고마워!」
		SELECTCASE DAY:2
			;夏
			CASE 2
				PRINTFORML 「더운 날 차가운 차가 정말 최고지~」
				PRINTFORML 「하지만 나는 뜨거운 차도 마실 거야.」
				;夏じゃない
			CASEELSE
				PRINTFORML 「뜨거운 차 괜찮아?」
		ENDSELECT
		PRINTFORML 「야생 늑대들은 모두 예민한 고양이혀를 가진 건 사실이야.」
		PRINTFORML 「하지만 요괴 늑대는 같다고 생각한다면, 큰 실수를 하는 거야.」
		PRINTFORMW 「그래도 왜 '고양이의 혀'라고 불리는지 궁금하네... 쪽-쪽...」
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「역시 %CALLNAME:MASTER%답네, 참 다정하구나♪」
				PRINTFORMW 「음~ 맛있다~♪」
			CASE 1
				PRINTFORML 「음, 고마워♪ 이제 한 모금 마시자...」
				PRINTFORMDW 스윽스윽...
				PRINTFORML 「인간들은 고양이혀가 없도록 불을 사용한다.」
				PRINTFORML 「자연의 관점에서 보면 인간들의 취향은 상당히 이상하다.」
				PRINTFORML 「다시 말해 우리 둘 다 인간의 혀를 가지고 있다.」
				PRINTFORMW 「응? 하지만 나는 요괴니까, 요괴의 혀겠지, 응.」
			CASE 2
				PRINTFORML 「꺅～! 목마를 뿐이었어요! 고마워요, %CALLNAME:MASTER%♪」
				PRINTFORML 「차로는 취할 수 없으니 사케와 달리 원하는 만큼 마실 수 있어요.」
				PRINTFORML 「하지만 둘 다 너무 많이 마시면 안 돼요.」
				PRINTFORMW 「차를 너무 많이 마시면 잠을 못 자게 될 거예요!」
			CASE 3
				PRINTFORML 「전에 생각해 본 적이 있지만...」
				PRINTFORML 「언제 이 차를 만든 건지 궁금하네?」
				PRINTFORMW 「가끔 이상한 짓을 하는구나!」
			CASE 4
				PRINTFORML 「그냥 당신이 나에게 차를 만들어줘서 정말 기뻐요♪」
				PRINTFORMW 「언제나처럼, 그 몸소에 감사해요♪」
			CASE 5
				SELECTCASE DAY:2
					CASE 1
						PRINTFORML 「음, 이번엔 말차네. 감사히 받겠어요.」
						PRINTFORMW 「우으, 좀 쓰고...」
					CASE 2
						PRINTFORML 「결국 여름은 보리차를 의미한다.」
						PRINTFORMW 「항상 수분을 유지하는 것을 기억해!」
					CASE 3
						PRINTFORML 「음, 오늘은 블렌딩 티인 것 같네요. 감사히 받겠습니다.」
						PRINTFORMW 「흠~ 맛은 좋지만 향이 최고예요.」
					CASE 4
						PRINTFORML 「와아~ 고마워!」
						PRINTFORMW 「따뜻하고 맛있어~!」
				ENDSELECT
		ENDSELECT
		;恋慕じゃない
	ELSE
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「오, 정말 사려 깊으시네요. 정말 감사합니다!」
				PRINTFORMW 「음~ 맛있다~」
			CASE 1
				PRINTFORMW 「음, 고마워요. 먹자!」
				PRINTL 
				PRINTFORML 「인간만이 고양이혀를 가지지 않은 동물이다.」
				PRINTFORMW 「형상 변화가 가능한 요괴인지 잘 모르겠지만.」
			CASE 2
				PRINTFORML 「음~!! 목이 말랐을 뿐이야. 고마워.」
				PRINTFORMW 「종족에 상관없이 모두 차와 사케를 맛있게 생각한다.」
			CASE 3
				PRINTFORML 「이거 예전에 궁금했었는데...」
				PRINTFORML 「언제 이 차를 만든 거지?」
				PRINTFORMW 「혹시 검은 마법인가?!」
			CASE 4
				PRINTFORML 「수고해 주셔서 감사합니다.」
				PRINTFORMW 「아아, 차와 당신의 친절함이 저에게 퍼지고 있어요~」
			CASE 5
				SELECTCASE DAY:2
					CASE 1
						PRINTFORMW 「아라, 참 특이하네, 이번엔 말차로군. 감사히 받겠어.」
						PRINTFORMW 「우으, 좀 쓰네...」
					CASE 2
						PRINTFORML 「결국 여름은 보리차를 의미한다.」
						PRINTFORMW 「항상 수분을 유지하는 것을 기억해!」
					CASE 3
						PRINTFORML 「음, 오늘은 블렌딩 티인 것 같네요. 감사히 받겠습니다.」
						PRINTFORMW 「흠~ 맛은 좋지만 향이 최고예요.」
					CASE 4
						PRINTFORML 「와아~ 고마워!」
						PRINTFORMW 「따뜻하고 맛있어~!」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;302,スキンシップ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K63_302
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
IF TCVAR:発情
	IF TALENT:恋慕
		TFLAG:192 = 1
	ELSE
		TFLAG:192 = -1
	ENDIF
ELSEIF (TALENT:恋慕 || TALENT:思慕) && DAY > K63_EYEBROW && AT_HOME(MASTER)
	TFLAG:192 = 1
ELSE
	RETURN 0
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K63_302
CALL M_KOJO_MESSAGE_COM_K63_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;初回
	IF FIRSTTIME(302)
		PRINTFORMW 「흐읍, 저기요! 그냥 아무렇게나 만지지 말아 주세요!」
		PRINTFORMW 「아, 죄송해요... 너무 갑작스러워서 놀랐어요...」
		SIF TALENT:思慕
			PRINTFORMW 「음... 네가 그렇다면 상관없어... 잠시 정도는 말이야...」
		RETURN 1
	ENDIF
	;恋慕（お風呂）
	IF TALENT:恋慕 && BATHROOM()
		PRINTFORML 「나의 등을 씻겨 줄 거야?」
		PRINTFORMW 「Thank you...」
		PRINTL
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「음... 너무 많이 쳐다보지 말아줘...」
			CASE 1
				PRINTFORMW 「아하♪ 거긴 간지러워! 후후.」
			CASE 2
				PRINTFORMW 「좋아, 나 차례야...」
		ENDSELECT
		RETURN 1
	ENDIF
	IF TCVAR:発情
		FONTBOLD
		CALL HPH_PRINT,@"「현~HPH」","W"
		FONTREGULAR
		IF TALENT:恋慕
			CFLAG:溜まってる度 += 100
			PALAM:TARGET:潤滑 += 500
			BASE:TARGET:ムード += 500
			PRINTFORMW 「저기-미안해... 지금은 손대지는 않았으면 좋겠어... 싫어서가 아니라 그냥...」
			PRINTFORMW (우으, %조사처리(CALLNAME:MASTER,"가")% 나를 만지면 내 몸이 교미를 준비하기 시작해...)
			IF TALENT:自己愛 >= 0
				CFLAG:TARGET:同行 = 60
				CFLAG:MASTER:同行 = 60
				PRINTFORMW 「호라... 알잖아? 저쪽으로 갈까?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")%/가 %조사처리(CALLNAME:MASTER,"의")% 소매를 잡는다.
			ENDIF
		ELSEIF TALENT:思慕
			PRINTFORMW 「저, 저기 죄송하지만 지금은 혼자 있게 해줬으면 해요...」
		ELSE
			PRINTFORMW 「야, 만지지 마! 떨어져!」
			CFLAG:ブチギレ = 1
		ENDIF
		CALL COLORMESSAGE(@"좌절감이 증가했다.",C_YELLOW,1)
		CFLAG:溜まってる度 += 100
		IF PALAM:TARGET:潤滑 < 3000
			CALL COLORMESSAGE(@"윤활도가 증가했다.",C_YELLOW,1)
			PALAM:TARGET:潤滑 += 500
		ENDIF
		RETURN 1
	ENDIF
	IF (TALENT:恋慕 || TALENT:思慕) && DAY > K63_EYEBROW && AT_HOME(MASTER)
		CALL K63_眉カット
		RETURN 1
	ENDIF
	CALL KAGEROU_SKINSHIP
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RESULT
			;手を握る
			CASE 0
				IF !RAND:3
					PRINTFORML 「아, 그래서 %조사처리(CALLNAME:MASTER,"의")% 손은 결국 나와 다르구나.」
					PRINTFORMW 「그것들은 도구를 만들고 다루기 위한 인간의 손이다.」
				ELSEIF RAND:2
					PRINTFORML 「아... 와이...」
					PRINTFORMW 「내 손... 내 발톱은 상당히 날카로우니 조심해...」
				ELSE
					PRINTFORML 「후후, 희미하지만 당신의 온기가 느껴져요...」
					PRINTFORML 「이렇게 손가락을 맞잡고 있으니...」
					PRINTFORMW 「아, 조금 부끄럽네요. 이대로 마무리하죠...」
				ENDIF
				;頬を撫でる
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아... 무슨 일이야, %CALLNAME:MASTER%...?」
						PRINTFORMW 「후후, 보답해 주지!」
					CASE 1
						PRINTFORML 「와! 예상 못 했어, 갑자기 잡히네.」
						PRINTFORMW 「만지지 마, 알았지?」
					CASE 2
						PRINTFORML 「Mm...」
						PRINTFORMDW 카게로우는 눈을 감고 당신의 손에 기댄 채, 마치 쓰다듬어 달라고 비는 듯 고개를 당신 쪽으로 기울인다.
				ENDSELECT
				;耳に触る
			CASE 2
				IF RAND:2
					PRINTFORML 「이 귀들은 진짜야.」
					PRINTFORMW 「짐승형 아야카시의 기본 원리랄까♪」
				ELSE
					PRINTFORML 「이 귀는 움직일 수 있어, 봐!」
					PRINTFORMW 「숨기고 싶을 땐 이렇게 납작하게 만들면 돼...」
				ENDIF
				;顎を擽る
			CASE 3
				IF RAND:2
					PRINTFORML 「아, 기분 좋다...」
					PRINTFORMW 「그-, 그런데 좀 간지럽다.」
				ELSE
					PRINTFORML 「후아... 간지러워...」
					PRINTFORMW 「아아... 게다가 강아지처럼 취급받는 것도 좀 부끄럽네...」
				ENDIF
				;髪に触る
			CASE 4
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「잘 관리하려고 노력하는데…」
						PRINTFORMW 「이렇게 자세히 살펴보시면, 이상하게 긴장돼요…」
					CASE 1
						PRINTFORML 「그렇게 냄새 맡지 마~...」
						PRINTFORMW 「부끄러워...」
					CASE 2
						PRINTFORML 「그들을 만지는 게 기분이 좋아?」
						PRINTFORMW 「후후, 이건 내가 자신 있는 일이야.」
				ENDSELECT
				PRINTFORMDW 당신은 그녀의 윤기 나는 검은 머리카락의 손길을 즐긴다...
				;肩を揉む
			CASE 5
				PRINTFORMW 「아~ 기분 좋다~♪」
				IF RAND:2
					PRINTFORML 「너 이거 꽤 잘하는구나.」
					PRINTFORMW 「레이무에게 배운 거야?」
				ELSE
					PRINTFORMW 「이번에는 너를 위해 해 줄게.」
					PRINTL 
					PRINTFORML 「손님이 꽤 뻣뻣하네~」
					PRINTFORMW 「어때? 내가 잘하고 있어?」
				ENDIF
				;背を撫でる
			CASE 6
				IF RAND:2
					PRINTFORML 「후아아~...!」
					PRINTFORMW 「왠지 모르게 이게 정말 긴장을 풀어줘.」
				ELSE
					PRINTFORML 「아아... 어쩐지 마음이 편안해져...」
					PRINTFORMW 「마음이 놓여... 잠이 들 것 같아...」
				ENDIF
				;脇腹をつつく
			CASE 7
				IF RAND:2
					PRINTFORML 「아하하! 간지러워!」
					PRINTFORML 「나도 너에게 해줄게.」
					PRINTFORMW 「여기! 이거랑 저거 받아!」
				ELSE
					PRINTFORML 「헤이, 간지러워! 아하하!」
					PRINTFORML 「꺄아! 그만해줘!」
					PRINTFORMW 「간지럽다고 했잖아~!」
				ENDIF
				;鼻を擽る
			CASE 8
				IF RAND:2
					PRINTFORML 「후아... 가렵네~...」
					PRINTFORMW 「에취!」
				ELSE
					PRINTFORML 「후후, 뭐 하려는 거야?」
					PRINTFORML 「나도 %조사처리(CALLNAME:MASTER,"에게")% 해줄 수 있어.」
					PRINTFORMW 「어때? 이상하지 않아?」
				ENDIF
				;ぺたぺた
			CASE 9
				PRINTFORML 「갑자기 왜 나를 쓰다듬는 거야?」
				IF RAND:2
					PRINTFORML 「싫다는 건 아닌데, 네가 하고 싶은 만큼 해도 괜찮아. 하지만...」
					PRINTFORMW 「좀 수상해 보여... %CALLNAME:MASTER%.」
				ELSE
					PRINTFORML 「나를 그렇게 만지고 싶다면... 음...」
					PRINTFORMW 「우리가 혼자 있을 수 있는 곳에 간다면, 그럼...」
				ENDIF
			CASE 10
				IF FIRSTTIME("肉球")
					PRINTFORMW 「내 발바닥을 만지고 싶어? 음, 내가 변신하면 말이야...」
					PRINTFORMDL 카게로는 오른손을 왼팔 소매 속에 넣고 그것을 흔든다.
					PRINTFORMDL 그리고 그것을 꺼냈을 때, 그것은 늑대의 발이었다.
					PRINTFORMW 「그러니까, 해봐.」
					PRINTFORMDL 부드럽지 않아, 신발 밑창 같아...
					PRINTFORMW 「응, 와기랑 내 다른 친구들도 실망했어—.」
				ELSE
					PRINTFORML 「%TEXTR("I don't get what's to interesting.../Again? Fine, very well...")%」
					PRINTFORMDL 당신은 그녀의 변신한 손을 만져도 된다.
					IF !RAND:3
						PRINTFORML 「책에서 주먹만 한 괴물 손을 본 적 있나? 그게 네가 기대하는 모습인가?」
						PRINTFORMW 「아, 저건 여우야... 늑대가 아니라고...」
					ELSE
						PRINTFORMDW %TEXTR("These are not her usual feminine hands, but these too are Kagerou's./A beast's powerful forelimb made for scratching the ground and kicking.")%
					ENDIF
				ENDIF
				;人狼
			CASE 100
				CALL ERATOHO_JINROU_GAME
		ENDSELECT
		;恋慕じゃない
	ELSE
		SELECTCASE RESULT
			;手を握る
			CASE 0
				PRINTFORML 「어머, 네 손톱이 아주 깨끗하네.」
				PRINTFORMW 「혹시 매일 다듬니?」
				;頬を撫でる
			CASE 1
				PRINTFORML 「뭐 뭐 뭐야—?!」
				PRINTFORMW 「Geez, it's always so sudden, you surprised me!」
				;耳に触る
			CASE 2
				PRINTFORML 「이것들도 진짜 귀야.」
				PRINTFORMW 「어떻게 작동하는 거지? 후후후, 그건 비밀이야♪」
				;顎を擽る
			CASE 3
				PRINTFORML 「…내가 그냥 개 같다고 생각해?」
				PRINTFORMW 「나 화낼 거야, 알잖아?」
				;髪に触る
			CASE 4
				PRINTFORML 「내 머리 좋아...?」
				PRINTFORML 「뭐, 여자의 머리는 결국 목숨이니까.」
				PRINTFORMW 「뭐야, 요괴가 그런 말을 하다니 이상하네?」
				;肩を揉む
			CASE 5
				PRINTFORML 「아- 기분 좋다. 기분이 좋아진다.」
				PRINTFORMW 「더 하고 싶으면, 마음대로 해~」
				;背を撫でる
			CASE 6
				PRINTFORML 「꺅! 그건 뭐야?! 정말이지.」
				PRINTFORMW 「소름이 돋았어~~」
				;脇腹をつつく
			CASE 7
				PRINTFORML 「와아! 뭐 하는 거야!」
				PRINTFORMW 「너...! 너!」
				;鼻を擽る
			CASE 8
				PRINTFORML 「푸하... 뭐지... 에취!」
				PRINTFORMW 「아이고~! 뭐야, 그거 왜 그랬어—!」
				;ぺたぺた
			CASE 9
				PRINTFORML 「왜 나를 쓰다듬는 거야?」
