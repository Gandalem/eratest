LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70 
	SIF CFLAG:睡眠 ;custom code
		RETURN 0
	TCVAR:[[影狼]]:353 = FLAG:20 + 1
	CALL K63_PRINT_IMG("63_cooking")
	;初回
	IF FIRSTTIME(413)
		;料理人
		IF TALENT:恋慕 && ABL:MASTER:料理技能 > 2
			PRINTFORMW 「Oh, you're going to teach me how to cook, right!」
			PRINTFORMW 「Thank you! I've actually been looking forward to this quite a bit♪」
		;初回通常,やりようによっちゃ経験豊富にもできる
		ELSE
			PRINTFORMW 「We'll be cooking, huh.」
			PRINTFORMW 「I've never done it before, but I've always wanted to try.」
			PRINTFORMW 「Would you mind teaching me?」
		ENDIF
		RETURN 1
	ELSEIF DISHNAME == "ジビエ料理"
		IF FIRSTTIME("固有料理練習")
			PRINTFORMW 「You want me to tell you how to cook, huh. I wonder if there's anything I can teach you?」
			PRINTFORMW 「Oh, I bet I could show you the way to properly dress a hawfinch!」
		ELSEIF STRCOUNT(DISH_TASTE, "練習")
			{
			PRINTFORMW 「%TEXTR("If you pull up here, the joint will come loose and it will be easier to pull apart./
			If you peel the skin from the neck side to here, it will come off cleanly./If you slice the cartilage right here, it will come off really easily./
			Don't cut too deeply there, or you'll sever the leg.")%」
			}
		ELSE
			PRINTFORMW 「The way you're handling it, it's really impressive!」
		ENDIF
		RETURN 1
	ELSEIF ABL:料理技能 >= 2
		PRINTFORML 「%TEXTR("Ah, you're cooking?/It's fun to try and cook something, am I right?")%」
	ENDIF
	IF STRCOUNT(DISH_TASTE, "スパイス/")
		PRINTFORML 「Whoa! Don't make it spicy!」
		PRINTFORMDL Do you make it without the spices?
		CALL ASK_YN
		IF !RESULT
			DISH_TASTE '= REPLACE(DISH_TASTE, "スパイス\/", "")
			DISH_TASTE += "スパイス抜き/"
			PRINTFORMW 「Thank you...」
		ELSE
			PRINTFORMW 「Now my sinuses are all burning～...」
		ENDIF
		PRINTFORML 
	ENDIF
	;恋慕
	IF TALENT:恋慕
		;調理前口上
		SELECTCASE DISH_NAME
		;最初に例外群
		;"義大莉而鳥苗鳥肉"はこっちに移動
		CASE "モッツァレラチーズとトマトのサラダ", "ドーピングコンソメスープ", "義大莉而鳥苗鳥肉"
			$KINDAN
			PRINTFORMW 「S...Somehow, it feels like it's giving off a strange presence......」
		CASE "ギンギー料理"
			PRINTFORMW 「What the heck is Gingy?」
		
		;お魚系、天麩羅は唯一、魚料理がつかないので先に分岐
		;まー、TASTEにはついてないが内実は想像にまかせるということで
		CASE "天ぷら"
			$OSAKANA
			PRINTFORML 「A seafood dish!」
			PRINTFORMW 「Seafood is my second favorite, after meat.」
		;主食肉
		;カエル料理もこの区分だが……
		;だってこの娘、蛙肉だろうが喜んで食いそうなんだもん
		CASE "ハンバーグ", "しゃぶしゃぶ", "生姜焼き", "ステーキ", "油淋鶏", "カエルのから揚げ", "カエルカレー", "カエルのソテー", "カエルの塩焼き"
			PRINTFORML 「Kyaa～♪ Meat～♪」
			PRINTFORMW 「I'll make it with my full power!」
		;軽食肉
		CASE "ハンバーガー", "シウマイ", "肉まん"
			$ONIKU
			PRINTFORMW 「Oh! This is a meat dish, right!」
		;お手軽系、主食系を先に判定して軽食系はあとでまとめて判定します
		CASE "雑炊", "卵かけご飯", "やまもりごはん"
			$OTEGARU
			PRINTFORMW 「Ara, In that case we can finish quite quickly.」
			GOTO COOKINGEND
		[SKIPSTART]
		;仕様変更とともに闇に消えたっぽいのでコメントアウト
		;ビールと枝豆
		CASE 79
			PRINTFORMW 「This is such a good summer dish～♪」
			PRINTFORMW 「...But you didn't actually need to cook any of this right?」
			GOTO COOKINGEND
		;おでん
		CASE 86
			PRINTFORMW 「This is such a good winter dish～♪」
			PRINTFORMW 「What dishes are your favorites, %CALLNAME:MASTER%?」
			PRINTFORMW 「I prefer...」
		[SKIPEND]
		
		CASEELSE
			IF STRCOUNT(DISH_TASTE, ESCAPE("ローター/"))
				GOTO KINDAN
			ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("麺類/"))
				PRINTFORML 「Are you cooking a noodle dish?」
				PRINTFORMW 「Let's put a pickled egg in at the end and see the moon♪」
				DISH_TASTE += "卵/月見/"
			ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("魚料理/"))
				GOTO OSAKANA
			ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("肉料理/"))
				GOTO ONIKU
			ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("デザート/"))
				PRINTFORML 「Something smells sweet～ Iya, I've been craving some of this!」
				PRINTFORMW 「I wonder if I can learn to cook these...?」
			ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("野菜/"))
				PRINTFORML 「Uu...」
				PRINTFORML 「If possible, meat would be better than vegetables...」
				PRINTFORMW 「Well... If you say so, %CALLNAME:MASTER%...」
				GOTO COOKINGEND
			ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("軽食/"))
				GOTO OTEGARU
			ENDIF
		ENDSELECT
		PRINTL
		SELECTCASE RAND:6
		CASE 0
			PRINTFORML 「Umm, take this and... Ouch!」
			PRINTFORMW 「Uuu... I'm bad with fire...」
		CASE 1
			PRINTFORML 「Scale? Ah, you mean this.」
			PRINTFORML 「How do you use this?」
			PRINTFORMW 「Ah! This is fun! It's all springy!」
		CASE 2
			PRINTFORML 「If it's this much, I don't even need to use a knife...」
			PRINTL
			PRINTFORMDW Shhp Shhpｰ
			PRINTL
			PRINTFORMW 「It came out a bit rough, maybe?」
		CASE 3
			PRINTFORML 「Uuー... Not ready yet～?」
			PRINTFORMW 「I want to start already...」
		CASE 4
			PRINTFORML 「It was a lot of work, but it was fun♪」
			PRINTFORMW 「I wonder if it's because I was with %CALLNAME:MASTER%?」
		CASE 5
			PRINTFORML 「Hey hey, can I help you with anything?」
			PRINTFORMDL She hovers behind you restlessly...
		ENDSELECT
		$COOKINGEND
		PRINTL
		SIF ABL:MASTER:料理技能 > 2
			PRINTFORMW 「As expected of %CALLNAME:MASTER%. It looks delicious♪」

	;恋慕じゃない
	ELSE
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「Something like this?」
			PRINTFORMW 「Hopefully it turns out all right...」
		CASE 1
			PRINTFORML 「A tablespoon is about this much, right?」
			PRINTL 
			PRINTFORMDW Dobaa-
			PRINTL 
			PRINTFORMW 「...Did I do something wrong?」
		CASE 2
			PRINTFORML 「Sugar and mirin to taste...」
			PRINTFORMW 「How much is to taste?!」
		ENDSELECT
		PRINTL
		SIF ABL:MASTER:料理技能 > 2
			PRINTFORMW 「Oh, you're quite skilled～ Good job, good job♪」
	ENDIF
ENDIF

RETURN 1
