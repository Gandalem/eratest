RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;一方的に「抱かれたい」「あなたのモノにされたい」のではなく双方向性を強調
	IF !TCVAR:抱き寄せ初回
		IF TALENT:63:自己愛 < 0
			PRINTFORML 「%TEXTR("Ahh... You want to do it?/Ummm... Okay, but be gentle, please.../Again? I don't really mind, I guess...")%」
			;ELSEIF TALENT:MASTER:濃厚精液
		ELSEIF BASE:ムード < 500
			CALL PRINT_FACE, [[影狼]], "怒り","服", "",""
			PRINTFORML 「흥, 진심이야? 분위기 좀 더 살릴 수도 있잖아, 알잖아?」
			PRINTFORML 「짝짓기만 관심 있다면 벌레들도 그건 할 수 있어!」
		ELSEIF TCVAR:発情 || CFLAG:溜まってる度 >= 800
			TCVAR:発情 = 1
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응, 나도... 우리 사랑을 완성하고 싶은 기분이야... HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「흐으으음~~~~~~아앗, 못 참겠어...아앗」","W"
					PRINTFORMDL 카게로우는 당신의 목에 얼굴을 묻고 당신의 %PRINT_MALE("masculine musk:feminine odor", MASTER)%을 깊게 냄새 맡는다...
					PRINTFORMDL 그녀는 옷 위로 당신의 목덜미를 아래위로 핥으며 가슴과 배를 움켜쥐고 문지른다...
					PRINTFORML 「%CALLNAME:MASTER%, 나도 만져 보고 싶어?」
				CASE 2
					PRINTFORMW 「후후, 나를 그렇게 원했구나? 음, 나도 그래.」
					CALL HPH_PRINT,@"「왜냐면 말이야? 내 몸이 타오르고 있어... 너를 원해, %CALLNAME:MASTER%...HPH」","W"
					PRINTFORMDL 그녀가 말하는 것처럼, 카게로우의 체온은 그 어느 때보다 높다. 땀방울이 피부를 타고 흘러내리고, 그녀의 숨소리는 거칠고 무겁다...
			ENDSELECT
		ELSEIF CFLAG:溜まってる度 < 250
			PRINTFORML 「%TEXTR("Alright, but you know I hate it when you're crude, right?/Again? Humans just don't know when to quit, do they.")%」
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「너무 무리하지 마.」
					PRINTFORML 「구애에는 제대로 된 예법이 있다는 거 알잖아, 안 그래?」
					CALL ASK_YN("그녀의 뺨에 손을 대고 얼굴에서 머리카락을 쓸어 넘긴다.","당신은 그녀의 손등에 입을 맞추며 무릎을 꿇는다.")
					CALL HPH_PRINT,@"「후훗...히히. 그것은 통과 점수군...히히」","L"
				CASE 1
					PRINTFORML 「다행이야!」
					PRINTFORML 「네가 꺼내지 않았다면, 내가 부탁해야 할까 봐 걱정했어.」
				CASE 2
					PRINTFORML 「응, 네가 물어주길 기다리고 있었어...」
				CASE 3
					PRINTFORML 「후후.」
					PRINTFORML 「이렇게 제안받는 건 정말 기분 좋네.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
