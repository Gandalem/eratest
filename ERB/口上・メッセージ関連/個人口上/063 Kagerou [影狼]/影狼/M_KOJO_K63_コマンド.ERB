;411,戦闘訓練
;==================================================
@M_KOJO_MESSAGE_COM_K63_411
CALL M_KOJO_MESSAGE_COM_K63_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;影狼は変身できない日は弾幕使えないのか？？？
IF LOCAL && !FLAG:70 
	;初回
	IF FIRSTTIME(411)
		PRINTFORMW 「Oh ho! So you want to practice with me!」
		PRINTFORMW 「Fine, bring it on!」
	;恋慕
	ELSEIF TALENT:恋慕
		;夜
		IF TIME:2 >= 5 && TIME:2 <= 7
			SELECTCASE MOON_WATCH(DAY:3)
			;曇り
			CASE -1
				;晴れたら満月,これが不可能弾幕（インポッシブルスペルカード）！
				IF DAY:3 == 15
					PRINTFORMW 「Kuh, if only the weather wasn't like this...!」
					PRINTFORMW 「Can't be helped, I'll have to use *that*!」
					PRINTL
					PRINTFORMW 「Full Moon『Full Moon Roar』!!!」
					PRINTL
					PRINTFORMDW When the long, long howl ends, somehow the light of the full moon breaks through!!
					TIME:5 = 1
				;ただの曇り
				ELSE
					PRINTFORMW 「Kuh, If there was some moonlight I could bring out a little more power...!」
				ENDIF
			;月が出ていない時or新月,1ボムで決めたい弾幕。初見殺しでもある
			CASE 0,1
				PRINTFORML 「Just because there's no moon doesn't mean I can't fight!」
				PRINTFORMW 「Wolf Sign『Star Ring Pounce』!!!」
			;満月,ちょっと原作台詞混ぜ。Lunaticは咲夜Aですら2ボムまであり得るから怖い
			CASE 9
				PRINTFORML 「Fufufu... So %CALLNAME:MASTER% thinks he can beat me?」
				PRINTFORML 「Tonight is a full moon. There's no way to defeat the blessed me!」
				PRINTFORMW 「Sirius『High-Speed Pounce』!!!」
			;その他の月,月下の犬歯むずすぎる。影狼は強い
			CASEELSE
				PRINTFORML 「Tonight's moon is quite beautiful! How's this?!」
				PRINTFORMW 「Fang Sign『Moonlit Canine Teeth』!!!」
			ENDSELECT
			PRINTL
		;昼はスペルカードなし
		ENDIF
		;あなたのが強い
		IF ABL:MASTER:戦闘能力 > ABL:戦闘能力
			PRINTFORML 「Fuu... %CALLNAME:MASTER% is as strong as alwaysー」
			PRINTFORMW 「I guess it's to be expected from a resident of that shrine.」
		;影狼以下
		ELSE
			PRINTFORML 「Weak, weaaーk!」
			PRINTFORMW 「Watch the trajectory, find the safe spots!」
		ENDIF
	;恋慕じゃない
	ELSE
		;あなたのが強い
		IF ABL:MASTER:戦闘能力 > ABL:戦闘能力
			PRINTFORML 「Kuh! Not bad!」
			PRINTFORMW 「If I transformed it wouldn't turn out like this, though!」
		;影狼以下
		ELSE
			PRINTFORML 「Hoi Hoi Hoi Hoーi!」
			PRINTFORMW 「I've got power to spare even without transforming.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
