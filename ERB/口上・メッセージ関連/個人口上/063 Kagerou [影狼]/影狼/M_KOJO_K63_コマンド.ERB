CALL K63_PRINT_IMG("63_alchemy")
IF FIRSTTIME("調合")
	PRINTFORML 「Mixing concoctions? Yeah, I do it once in a while, I guess.」
	PRINTFORMW 「Making candles out of tallow, and making perfumed oil out of wild herbs, and stuff like that.」
	PRINTFORMW 「...What? You thought a wild wolf couldn't do things like that? Even those rabbits do it a lot.」
ENDIF
;ユキマイ口上を参考に
IF LOCAL
	SELECTCASE TFLAG:193
	;失敗
	CASE 0
		PRINTFORML 「I guess it's no useー」
		PRINTFORML 「The ingredients... We probably %TEXTR("left them on the fire too long/didn't heat them enough/ground them up too fine/diluted them with too much water/didn't add enough water")%, or something like that...」
	;コンドーム
	CASE 45
	;媚薬
	CASE 41
		PRINTFORML 「This is a drug that makes you feel more aroused, isn't it?」
		IF TALENT:恋慕
			PRINTFORML 「Well, it's really nice to feel good when we do that, but should you really rely on drugs?」
			PRINTFORMW 「I mean, look...」
			PRINTFORMDW Kagerou stalks up behind you, and snatches you up in a big hug...
			PRINTFORMW 「Isn't it plenty to just feel each other's warmth like this? Don't you think?」
		ELSE
			PRINTFORML 「If you have to use this, isn't it something that's unrelated to actual sexual feelings for someone?」
		ENDIF
	CASE 501, 503, 505
		IF !TALENT:恋慕 && !TALENT:思慕
			PRINTFORML 「Do you have to keep doing your best to rely on performance-enhancing drugs? I think it's always best to just eat and sleep right!」
			PRINTFORML 「Humans sure have it tough...」
		ELSE
			PRINTFORML 「Wait, are you making this stuff because you're having a hard time at work? Let me help you out sometime!」
		ENDIF
	;精力剤
	CASE 502, 506
		IF GETBIT(CFLAG:既成事実 , 1)
			IF ABL:欲望 >= 10
				PRINTFORML 「...By any chance, have I been pushing you too hard lately? If that's the case——」
				PRINTFORML 「I don't need to hold back, even if it's for your sake? Really, are you sure?」
			ELSE
				PRINTFORML 「No, you don't need this, you're already super amazing...」
			ENDIF
		ELSE
			PRINTFORML 「Do you need this medicine for something? It's said some people have a certain constitution, I get itー」
			PRINTFORML 「For instance, if there were a medicine that could do something about my hair, I'd definitely make it...」
		ENDIF
	;ポーション
	CASE 507
		PRINTFORML 「They call it a "magic potion", but to me it tastes like tea for some reason.」
	;マジックポーション
	CASE 508
		PRINTFORML 「I get the sense that this is what they'd call a real magic potion!」
		PRINTFORML 「Do you think this will work for weaker youkai?」
	CASE 505, 509
		PRINTFORML 「Isn't it best to just sleep when you feel sleepy? Staying up isn't good for your beauty...」
	;エリクサー
	CASE 511
		PRINTFORML 「An elixir that can heal any injury? Wow, that's amazing!」
		PRINTFORML 「If you get hurt, don't be stingy and just drink it right away, alright? Even a minor injury can get infected and eventually become fatal.」
	CASE 512, 515
		PRINTFORML 「A potion that strengthens your body for a short time... It sounds like something that'd be good to take right before a big job.」
	;魚粕, 肉骨粉
	CASE 642,648
		PRINTFORML 「That smells really good, you know...」
		PRINTFORML 「Is it some kind of seasoning? Something you put on food?」
	CASE 641
		PRINTFORML 「Frog toxins, ugh, they really make my nose sting...」
	CASE 513
	CASE 514, 515
	CASE 516, 517
		PRINTFORML 「That stuff smells pretty dangerous!」
		PRINTFORML 「Isn't this some kind of super strong poison?」
	CASE 575
		PRINTFORML 「You can make a kind of alcohol from crushed grapes, right?」
	CASE 661
		PRINTFORML 「Raspberries sure smell good, don't they...」
		PRINTFORML 「I crush them up with vinegar and oil to make a kind of make-up, but you can make alcohol from them too, can't you?」
	;お酒系
	CASE 58, 560, 663, 664
	;食べ物系
	CASE 576, 669
	;弾幕系
	CASE 850, 851, 852, 853, 854, 855
		PRINTFORML 「I thought only magicians could make items for use in Danmaku games, but surprisingly that's not the case!」
	;スタンド系
	CASE 870, 871
	;ほか
	CASEELSE
		SELECTCASE PHARMACY_RANK(TFLAG:193)
		ENDSELECT
	ENDSELECT
ENDIF
RETURN 1

