;クラピ口上を参考に

@M_KOJO_MESSAGE_COM_K63_621_1
#DIM CHARA
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文をカットしてるのでMESSAGE処理を内蔵する
IF LOCAL
	;CALL M_KOJO_COLOR_K63
	SELECTCASE TFLAG:193
		;釣れない
		CASE 0
			PRINTFORMDW 아무것도 잡지 못했어...
			PRINTFORMW 「%TEXTR("I can't catch one, it seems./Fuwaah～～～")%...」
			IF !RAND:4 && !GROUPMATCH(TIME:2, 1, 4, 5, 6)
				PRINTFORML 「어쩌면 시간이 잘못되었을지도 몰라.」
				PRINTFORML 「아침 일찍이나 늦은 오후가 좋을 것 같아.」
			ELSEIF CFLAG:MASTER:今日の運勢 / 10 - 50 + TFLAG:幸運補正 * 10 < 0
				PRINTFORML 「오늘 내가 그냥 운이 없는 걸지도...」
			ENDIF
			RETURN 1
			;木片
		CASE 610
			IF TFLAG:194 > 1000
				PRINTL 
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) 나무 조각 하나를 잡았다...
				PRINTW
				PRINTFORMW 「...원해? 여기...」
			ELSE
				PRINTFORMDL 당신은 나무 조각을 잡았습니다...
				PRINTW 
			ENDIF
			RETURN 1
			;紙切れ
		CASE 131
			IF TFLAG:194 > 1000
				PRINTFORML 「잠깐만, 이건 뭐야?」
			ELSE
				PRINTFORMDL 당신은 종이 조각 하나를 잡는다...
			ENDIF
			PRINTDW 
			PRINTDL ┌─────────────┐
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 부적
			PRINTDL 복권
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 부적 5개를 모아라
			PRINTDL 복권 한 개를 얻어라
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 기적은 보장되지 않는다.
			PRINTDL ｜　　　　　　　　　　　　　｜
			PRINTDL 모리야 신사
			PRINTDL └─────────────┘
			PRINTW 
			PRINTFORMW 「모리야 신사에 대해 뭔가 있나?」
			RETURN 1
		CASE 1 TO 20, 22 TO 60
			LOCALS = %FISH_NAME_TR(TFLAG:193)%
		CASE 21
			LOCALS = rotor
		CASEELSE
			LOCALS = %ITEMNAME_TR(TFLAG:193)%
	ENDSELECT
	;影狼が釣った
	IF TFLAG:194 > 1000
		PRINTFORMW 「!」
		PRINTFORMW 「여기 온다!」
		SELECTCASE LOCALS
			;CASE "ガーパイク", "カムルチー", "シーラカンス", "チョウザメ", "イトウ", "ピラルクー", "タキタロウ"
			CASE "garpike", "northern snakehead", "coelacanth", "sturgeon", "sakhalin taimen", "pirarucu", "takitaro"
				PRINTFORMW 「멋진 조과야! 와기짱을 잡은 이후로 저런 건 못 봤어!」
				PRINTFORMW 「%CALLNAME:MASTER%아, 내가 도와줄게!」
		ENDSELECT
		PRINTL 
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")%(가) %LOCALS%를 잡았다!
		RESETCOLOR
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORMDL %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORMDL %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		;MASTERが釣った
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%, 당겨라, 당겨라!」
		RESETCOLOR
		PRINTFORMDL 당신은 %LOCALS%를 잡았다!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORMDL 　크기: {LOCAL:1}cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORMDL 　지금까지 잡은 것 중 가장 큰 %LOCALS%이다!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
		;説明を流す
		SELECTCASE TFLAG:193
			CASE 1 TO 20, 22 TO 60
				DRAWLINE
				PRINTFORMDL %LOCALS%
				CALL FISHING_EXPLANATION(TFLAG:193)
			CASE IS > 61
				DRAWLINE
				PRINTFORMDL %LOCALS%
				PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K63
	ENDIF
	SELECTCASE TFLAG:193
		CASE 11 TO 20, 24 TO 60
			IF TIME_PROGRESS(TCVAR:MASTER:空腹時刻) && TIME_PROGRESS(TCVAR:TARGET:空腹時刻)
				PRINTFORMW 「헤이, %CALLNAME:MASTER%, 배고파?」
				CALL ASK_YN("여기서 그것을 먹어라","그것을 먹지 마라")
				IF !RESULT
					CALL PRINT_FACE, [[影狼]], "笑顔", "服", "", ""
					PRINTFORMW 「야호!」
					PRINTFORMDW 두 사람은 불 위에서 %LOCALS%을 구워 먹는다.
					CALL LOST_ITEM("うまい魚", 1, 1)
					TCVAR:[[影狼]]:空腹時刻 = 1440 * DAY + TIME + 200
					CALL RECOVER_PERMIL([[影狼]], 400, "体力", 0, "Recover via meal")
					CALL RECOVER_PERMIL([[影狼]], 400, "気力", 0, "Recover via meal")
					TCVAR:MASTER:空腹時刻 = 1440 * DAY + TIME + 200
					CALL RECOVER_PERMIL(MASTER, 400, "体力", 0, "Recover via meal")
					CALL RECOVER_PERMIL(MASTER, 400, "気力", 0, "Recover via meal")
					CALL RECOVER_PERMIL(MASTER, 200, "精力", 0, "Recover via meal")
					TIME += 20
					CFLAG:1004 += 3
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
