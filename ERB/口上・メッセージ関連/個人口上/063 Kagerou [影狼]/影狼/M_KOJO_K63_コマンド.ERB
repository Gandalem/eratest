;クラピ口上を参考に
@M_KOJO_MESSAGE_COM_K63_621_1
#DIM CHARA
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;地の文をカットしてるのでMESSAGE処理を内蔵する
IF LOCAL
	;CALL M_KOJO_COLOR_K63
	SELECTCASE TFLAG:193
	;釣れない
	CASE 0
		PRINTFORMDW You couldn't catch anything...
		PRINTFORMW 「%TEXTR("I can't catch one, it seems./Fuwaah～～～")%...」
		IF !RAND:4 && !GROUPMATCH(TIME:2, 1, 4, 5, 6)
			PRINTFORML 「Maybe it's the wrong time of day.」
			PRINTFORML 「I think early morning and late afternoon are good.」
		ELSEIF CFLAG:MASTER:今日の運勢 / 10 - 50 + TFLAG:幸運補正 * 10 < 0
			PRINTFORML 「Maybe I'm just not lucky today...」
		ENDIF
		RETURN 1
	;木片
	CASE 610
		IF TFLAG:194 > 1000
			PRINTL 
			PRINTFORMDL %CALLNAME:TARGET% caught a piece of wood...
			PRINTW
			PRINTFORMW 「...Want it? Here...」
		ELSE
			PRINTFORMDL You caught a piece of wood...
			PRINTW 
		ENDIF
		RETURN 1
	;紙切れ
	CASE 131
		IF TFLAG:194 > 1000
			PRINTFORML 「Wait a minute, what is this?」
		ELSE
			PRINTFORMDL You catch a piece of paper...
		ENDIF
		PRINTDW 
		PRINTDL ┌─────────────┐
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　　 Moriya Talisman 　 　｜
		PRINTDL ｜　　　　　Lottery 　　　　｜
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　　Gather 5 Talismans  　｜
		PRINTDL ｜　　　Get a lottery roll　｜
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　Miracle not guaranteed　｜
		PRINTDL ｜　　　　　　　　　　　　　｜
		PRINTDL ｜　　　　　　Moriya Shrine ｜
		PRINTDL └─────────────┘
		PRINTW 
		PRINTFORMW 「Something about the Moriya Shrine?」
		RETURN 1
	CASE 1 TO 20, 22 TO 60
		LOCALS = %FISH_NAME_TR(TFLAG:193)%
	CASE 21
		LOCALS = rotor
	CASEELSE
		LOCALS = %ITEMNAME_TR(TFLAG:193)%
	ENDSELECT
	;影狼が釣った
	IF TFLAG:194 > 1000
		PRINTFORMW 「!」
		PRINTFORMW 「Here it comes!」
		SELECTCASE LOCALS
			;CASE "ガーパイク", "カムルチー", "シーラカンス", "チョウザメ", "イトウ", "ピラルクー", "タキタロウ"
			CASE "garpike", "northern snakehead", "coelacanth", "sturgeon", "sakhalin taimen", "pirarucu", "takitaro"
				PRINTFORMW 「Awesome catch! I haven't seen one like that since I caught Waggy-chan!」
				PRINTFORMW 「I'll help you, %CALLNAME:MASTER%!」
		ENDSELECT
		PRINTL 
		PRINTFORMDL %CALLNAME:TARGET% caught a %LOCALS%!
		RESETCOLOR
		;説明を流す
		SELECTCASE TFLAG:193
		CASE 1 TO 20, 22 TO 60
			DRAWLINE
			PRINTFORMDL %LOCALS%
			CALL FISHING_EXPLANATION(TFLAG:193)
		CASE IS > 61
			DRAWLINE
			PRINTFORMDL %LOCALS%
			PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
	;MASTERが釣った
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%, pull, pull!」
		RESETCOLOR
		PRINTFORMDL You caught a %LOCALS%!
		;ローター以降を弾いてサイズと漁獲数の処理
		IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
			;サイズの出力
			LOCAL:1 = FISHING_SIZE(TFLAG:193)
			PRINTFORMDL 　Size: {LOCAL:1} cm
			;ここまでの最高サイズと比較して大きければ記録
			IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
				SETCOLOR C_YELLOW
				SIF FISH_EXP:(TFLAG:193)
					PRINTFORMDL 　It's the largest %LOCALS% you've caught yet!
				RESETCOLOR
				FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
			ENDIF
			;漁獲数の加算
			FISH_EXP:(TFLAG:193) ++
		ENDIF
		;説明を流す
		SELECTCASE TFLAG:193
		CASE 1 TO 20, 22 TO 60
			DRAWLINE
			PRINTFORMDL %LOCALS%
			CALL FISHING_EXPLANATION(TFLAG:193)
		CASE IS > 61
			DRAWLINE
			PRINTFORMDL %LOCALS%
			PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
		ENDSELECT
		PRINTW 
		CALL M_KOJO_COLOR_K63
	ENDIF
	SELECTCASE TFLAG:193
		CASE 11 TO 20, 24 TO 60
			IF TIME_PROGRESS(TCVAR:MASTER:空腹時刻) && TIME_PROGRESS(TCVAR:TARGET:空腹時刻)
				PRINTFORMW 「Hey, %CALLNAME:MASTER%, are you hungry?」
				CALL ASK_YN("Eat it here","Don't eat it")
				IF !RESULT
					CALL PRINT_FACE, [[影狼]], "笑顔", "服", "", ""
					PRINTFORMW 「Yay!」
					PRINTFORMDW The two of you roast the %LOCALS% over a fire and eat it.
					CALL LOST_ITEM("うまい魚", 1, 1)
					TCVAR:[[影狼]]:空腹時刻 = 1440 * DAY + TIME + 200
					CALL RECOVER_PERMIL([[影狼]], 400, "体力", 0, "Recover via meal")
					CALL RECOVER_PERMIL([[影狼]], 400, "気力", 0, "Recover via meal")
					TCVAR:MASTER:空腹時刻 = 1440 * DAY + TIME + 200
					CALL RECOVER_PERMIL(MASTER, 400, "体力", 0, "Recover via meal")
					CALL RECOVER_PERMIL(MASTER, 400, "気力", 0, "Recover via meal")
					CALL RECOVER_PERMIL(MASTER, 200, "精力", 0, "Recover via meal")
					TIME += 20
					CFLAG:1004 += 3
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
