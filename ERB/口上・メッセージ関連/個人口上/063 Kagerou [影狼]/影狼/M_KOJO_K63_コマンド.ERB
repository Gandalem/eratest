		ELSE
			PRINTFORMW 「요리할 거야, 응.」
			PRINTFORMW 「전에 해본 적은 없지만 항상 해보고 싶었어.」
			PRINTFORMW 「가르쳐 줄 수 있어?」
		ENDIF
		RETURN 1
	ELSEIF DISHNAME == "ジビエ料理"
		IF FIRSTTIME("固有料理練習")
			PRINTFORMW 「요리법을 알려주길 바라는 거야, 응. 내가 가르쳐 줄 만한 게 있을까?」
			PRINTFORMW 「오, 나는 머리사슴을 제대로 손질하는 법을 보여줄 수 있을 것 같은데!」
		ELSEIF STRCOUNT(DISH_TASTE, "練習")
			PRINTFORMW 「%TEXTR("If you pull up here, the joint will come loose and it will be easier to pull apart./ If you peel the skin from the neck side to here, it will come off cleanly./If you slice the cartilage right here, it will come off really easily./ Don't cut too deeply there, or you'll sever the leg.")%」
		ELSE
			PRINTFORMW 「당신이 다루는 방식은 정말 인상적이다!」
		ENDIF
		RETURN 1
	ELSEIF ABL:料理技能 >= 2
		PRINTFORML 「%TEXTR("Ah, you're cooking?/It's fun to try and cook something, am I right?")%」
	ENDIF
	IF STRCOUNT(DISH_TASTE, "スパイス/")
		PRINTFORML 「우와! 맵게 만들지 마!」
		PRINTFORMDL 향신료 없이 만들어 줄 수 있어?
		CALL ASK_YN
		IF !RESULT
			DISH_TASTE '= REPLACE(DISH_TASTE, "スパイス\/", "")
			DISH_TASTE += "スパイス抜き/"
			PRINTFORMW 「고맙다...」
		ELSE
			PRINTFORMW 「이제 내 부비동이 다 타오르는 것 같아~...」
		ENDIF
		PRINTFORML 
	ENDIF
	;恋慕
	IF TALENT:恋慕
		;調理前口上
		SELECTCASE DISH_NAME
			;最初に例外群
			;"義大莉而鳥苗鳥肉"はこっちに移動
			CASE "モッツァレラチーズとトマトのサラダ", "ドーピングコンソメスープ", "義大莉而鳥苗鳥肉"
				$KINDAN
				PRINTFORMW 「스...왠지 이상한 기운을 풍기는 것 같다......」
			CASE "ギンギー料理"
				PRINTFORMW 「진짜 이게 뭐야, 긴기?」
				;お魚系、天麩羅は唯一、魚料理がつかないので先に分岐
				;まー、TASTEにはついてないが内実は想像にまかせるということで
			CASE "天ぷら"
				$OSAKANA
				PRINTFORML 「해산물 요리!」
				PRINTFORMW 「고기 다음으로 해산물을 제일 좋아한다.」
				;主食肉
				;カエル料理もこの区分だが……
				;だってこの娘、蛙肉だろうが喜んで食いそうなんだもん
			CASE "ハンバーグ", "しゃぶしゃぶ", "生姜焼き", "ステーキ", "油淋鶏", "カエルのから揚げ", "カエルカレー", "カエルのソテー", "カエルの塩焼き"
				PRINTFORML 「꺄아~♪ 고기~♪」
				PRINTFORMW 「온 힘을 다해 만들 거야!」
				;軽食肉
			CASE "ハンバーガー", "シウマイ", "肉まん"
				$ONIKU
				PRINTFORMW 「오! 이건 육류 요리 맞죠!」
				;お手軽系、主食系を先に判定して軽食系はあとでまとめて判定します
			CASE "雑炊", "卵かけご飯", "やまもりごはん"
				$OTEGARU
				PRINTFORMW 「아아, 그럼 꽤 빨리 끝낼 수 있겠네요.」
				GOTO COOKINGEND
			CASEELSE
				IF STRCOUNT(DISH_TASTE, ESCAPE("ローター/"))
					GOTO KINDAN
				ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("麺類/"))
					PRINTFORML 「면 요리를 하고 있나요?」
					PRINTFORMW 「마지막에 장조림 계란을 넣고 달을 보자♪」
					DISH_TASTE += "卵/月見/"
				ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("魚料理/"))
					GOTO OSAKANA
				ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("肉料理/"))
					GOTO ONIKU
				ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("デザート/"))
					PRINTFORML 「뭔가 달콤한 냄새가 나네~ 안 돼, 이거 너무 먹고 싶었어!」
					PRINTFORMW 「이것들을 요리하는 법을 배울 수 있을까...?」
				ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("野菜/"))
					PRINTFORML 「Uu...」
					PRINTFORML 「가능하면 채소보다 고기가 더 좋겠어...」
					PRINTFORMW 「음... 네가 그렇게 말한다면, %CALLNAME:MASTER%...」
					GOTO COOKINGEND
				ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("軽食/"))
					GOTO OTEGARU
				ENDIF
		ENDSELECT
		PRINTL
		SELECTCASE RAND:6
			CASE 0
				PRINTFORML 「음, 이거 받아보고... 아얏!」
				PRINTFORMW 「우으... 난 불 다루는 게 서툴러...」
			CASE 1
				PRINTFORML 「스케일? 아, 이걸 말씀하시는군요.」
				PRINTFORML 「이건 어떻게 사용하는 건가요?」
				PRINTFORMW 「아! 이거 재미있어요! 전부 탄력이 있네요!」
			CASE 2
				PRINTFORML 「이 정도면 칼조차 쓸 필요가 없네...」
				PRINTL
				PRINTFORMDW 슈슈 슈슈-
				PRINTL
				PRINTFORMW 「조금 거칠게 나왔나?」
			CASE 3
				PRINTFORML 「음~ 아직 준비 안 됐어~?」
				PRINTFORMW 「벌써 시작하고 싶어...」
			CASE 4
				PRINTFORML 「꽤 힘들었지만, 즐거웠어♪」
				PRINTFORMW 「혹시 내가 %조사처리(CALLNAME:MASTER,"랑")% 있었기 때문일까?」
			CASE 5
				PRINTFORML 「어이, 뭐 도와줄 거 있나요?」
				PRINTFORMDL 그녀는 초조하게 당신 뒤에 머뭇거린다...
		ENDSELECT
		$COOKINGEND
		PRINTL
		SIF ABL:MASTER:料理技能 > 2
			PRINTFORMW 「역시 %CALLNAME:MASTER%답다. 맛있어 보인다♪」
		;恋慕じゃない
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「이런 것 같은 거야?」
				PRINTFORMW 「잘 되기를 바라야지...」
			CASE 1
				PRINTFORML 「한 큰술 정도면 이 정도겠지?」
				PRINTL 
				PRINTFORMDW 도바아-
				PRINTL 
				PRINTFORMW 「...내가 뭔가 잘못했나?」
			CASE 2
				PRINTFORML 「설탕과 미림은 기호에 따라...」
				PRINTFORMW 「얼마나 넣는 게 기호란 거야?!」
		ENDSELECT
		PRINTL
		SIF ABL:MASTER:料理技能 > 2
			PRINTFORMW 「오, 실력이 있네~ 잘했어, 잘했어♪」
	ENDIF
ENDIF
RETURN 1
