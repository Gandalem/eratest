;==================================================
;6,胸愛撫
;==================================================

@M_KOJO_MESSAGE_COM_K63_6
CALL M_KOJO_MESSAGE_COM_K63_6_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「내 가슴을 만지고 싶어? ...좋아, 왜 안 돼.」
		PRINTFORMW 「인간 수컷들이 큰 가슴에 완전히 집착한다는 걸 한 번 들었는데, 그게 사실과 크게 다르지 않은 것 같네.」
		PRINTFORMW 「사실 그거 떠올리니까, 네가 이전에 몰래 훔쳐보던 거 확실히 봤어!」
		RETURN 1
	ENDIF
	IF ABL:Ｂ感覚 <= 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「...재미있니?」
			CASE 1
				PRINTFORMW 「내 가슴 또야?」
			CASE 2
				PRINTFORMDW 아마 할 일이 없기 때문일 것이다. 카게로우가 당신의 얼굴을 쓰다듬는다...
		ENDSELECT
		RETURN 1
	ELSEIF TALENT:Ｂ感度 < 0
		PRINTFORMW 「%TEXTR(@"...%MOAN()%~ 정말 그걸 좋아하는구나, 그렇지?/%MOAN()%... 기분이 좋아지기 시작해, 느껴...")%」
		RETURN 1
	ELSE
		PRINTFORML 「%MOAN(,,4,"rand")%～!」
		IF !RAND:2
			CALL HPH_PRINT,@"「%SPLIT_G("Keep going:More:Don't stop")%...HPH」","L"
		ELSE
			CALL HPH_PRINT,@"「세상에, %SPLIT_G("my turn:two can play at this game")%!HPH」","L"
			IF !RAND:2
				;胸愛撫or乳首吸い
				TCVAR:次回カウンター = 58 + RAND:2
			ELSEIF !RAND:2
				;ディープキス
				TCVAR:次回カウンター = 60
			ELSEIF TEQUIP:50 == PLAYER
				TCVAR:次回カウンター = 88
			ELSE
				TCVAR:次回カウンター = 50
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
