@M_KOJO_MESSAGE_COM_K63_0
CALL M_KOJO_MESSAGE_COM_K63_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	;IF FLAG:70 ;custom code, so far these can appear during ts
	;PRINTFORMW
	;RETURN 1
	;それ以外
	;ELSE
	SELECTCASE RAND:4 ;custom code
		CASE 0
			PRINTFORMDW 그녀의 체형을 대부분 가리는 옷을 입고 있음에도 불구하고, 당신은 그 아래에 있는 카게로우의 매우 우아한 몸매를 감상하게 된다.
		CASE 1
			PRINTFORMDW 그녀를 만지는 것이 정말 굉장하게 느껴진다 %TEXTR("supple belly/tight behind")%.
		CASE 2
			PRINTFORMDL 카게로우의 연약한 부위들은 예상대로 유연하지만, 과도한 체중은 단 한 올도 없다.
			PRINTFORMDW 그것은 그저 영양분 저장과 장기 보호를 위한 층 역할을 할 뿐이며, 실용적인 지방처럼 느껴진다.
		CASE 3
			PRINTFORMDL 비록 제자리에 있다는 것은 분명하지만, 이 부드러움 아래 단단한 근육을 느낄 수 있다.
			PRINTFORMDW 이 몸이 야생의 짐승에게 속해 있다는 증거다.
	ENDSELECT
	RETURN 1
	;ENDIF
ENDIF
RETURN 1
;==================================================
;1,クンニ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K63_1
RETURN 1

@M_KOJO_MESSAGE_COM_K63_1
;初めて
IF !FLAG:70 && FIRSTTIME("初クンニ")
	PRINTFORMW 「우에에엥?! 나를 핥고 싶다고?! 아래쪽을?!」
	PRINTFORML 「하지만 더럽고 너에게 이런 걸 시키는 게 미안할 것 같아...」
	PRINTFORML 「음, 깨끗하지 않다는 건 아니야 (그런 일은 절대 없을 테니까), 난 스스로 씻거든!」
	PRINTFORML 「하지만 이건... 우리가 짝짓기 하게 된다고 해서 네가 일부러 애쓸 필요는 없다는 뜻이지, 알잖아...」
	CALL ASK_YN("내가 멈추길 바라나요?","정말로 그것을 핥고 싶다.")
	IF !RESULT
		PRINTFORMW 「그만하라고 말하는 건 아니지만...」
	ELSE
		PRINTFORMW 「고집한다면... 좋아...」
	ENDIF
	PRINTFORMW 「음, 음... 저를 잘 돌봐 주세요...」
ENDIF
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K63_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW (뭐지, 이제 어떡하지?! 일이 통제 불능 상태가 될 것 같은 기분이 들어!)
		PRINTFORMW (%조사처리(CALLNAME:MASTER,"는")%/는 내 다리 사이에 기꺼이 머리를 박고, 나를 기분 좋게 해주려고 거기서 핥으려고 해!)
		CALL HPH_PRINT,@"(우와아~~~~!히피)","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;恋慕
		;ELSEIF TALENT:恋慕
		;	PRINTFORMW
		;	RETURN 1
		;屈服3
		;ELSEIF MARK:不埒刻印 == 3
		;	PRINTFORMW
		;	RETURN 1
		;それ以外
	ELSE
		IF ABL:Ｃ感覚 < 2
			PRINTFORML 「%TEXTR(@"%MOAN(,,2)%.../%MOAN()%... 기분 좋아진 것 같아...")%」
		ELSE
			CALL HPH_PRINT,@"「%MOAN(,,4,"heart:HPH")%HPH」","L"
			IF RAND:2
				PRINTFORML (%조사처리(CALLNAME:MASTER,"가")% 나를 아주 진심으로 핥는다...)
				PRINTFORMW (%조사처리(CALLNAME:MASTER,"가")% 나를 정말 열심히 핥고 있어……)
			ELSE
				CALL HPH_PRINT,@"（%TEXTR(@"%MOAN()%ー Soo goodー...HPH I'm feeling lightheaded/%MOAN()%...HPH %HE_SHE(MASTER,1)%'s gulping down my juices %SPLIT_G(@"nonstop:like %HIS_HER(MASTER)% life depends on it")%")%...HPH）","W"
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
