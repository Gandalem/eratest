@KAGEROU_SKINSHIP
SIF CFLAG:1001
	RETURN RAND:10
PRINTDL [0]손을 잡는다 [1]뺨을 쓰다듬는다 [2]귀를 만진다 [3]턱을 간지럽힌다 [4]머리를 만진다 [98]무작위로 선택한다
PRINTDL [5]어깨를 문지른다 [6]그녀의 등을 쓸어내린다 [7]옆구리를 쿡 찌른다 [8]코를 간지럽힌다 [9]톡톡 두드린다 [99]매번 무작위로 선택한다
PRINTDL [10]그녀의 발바닥을 만진다
CALL D_LINE ;custom code
PRINTFORMDL [999] 카게로우의 비밀 (이벤트 및 스포일러 힌트!)
INPUT
SELECTCASE RESULT
	CASE 0 TO 9
		RETURN RESULT
	CASE 10
		IF TALENT:[[影狼]]:恋慕
			RETURN 10
		ELSE
			PRINTL 「아니, 난 그게 싫어.」
			RETURN RAND:10
		ENDIF
	CASE 98
		RETURN RAND:10
	CASE 99
		CFLAG:1001 = 1
		PRINTDW (이 옵션을 초기화하려면 신사에서 함께 기도하라)
		PRINTL 
		RETURN RAND:10
		;手入力で人狼ゲームを呼び出せます
	CASE 999
		CALL K63_SECRET
	CASE 100
		RETURN 100
	CASEELSE
ENDSELECT
RESTART
