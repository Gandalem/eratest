@影狼起床
SIF TCVAR:63:372
	RETURN
;満月の日
SELECTCASE DAY:3
	CASE 15
		;満月の下
		IF MOON_WATCH(DAY:3) == 9
			;しかも中秋の名月
			SELECTCASE DAY:2
				CASE 3
					PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
					PRINTFORMW 「오늘 밤은... 추수달이야...」
					PRINTFORMW 「음, 나와 함께 달을 보러 와 줄래...?」
					PRINTFORML 「나-나는 정말 부끄럽지만, 당신과 함께라면...」
					PRINTFORMW 「내 벌거벗은 모습을 보고 싶어...」
					PRINTFORMW 「그리고 네가 함께 해준다면, 우리가 어쩌면, 음...」
					PRINTFORMW 「아니야, 그건 나중에! 우선, 그냥 같이 달을 보러 가자!」
					BASE:63:理性 = 0
					TCVAR:発情 = 1
					;普通の満月
				CASEELSE
					PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
					PRINTFORMW 「봐, 오늘 밤은 보름달이야!」
					PRINTFORML 「부끄럽지만 당신과 함께라면...」
					PRINTFORMW 「지금 나를 봐주었으면 해...」
					PRINTFORMW 「후훗, 이런 일이 일어날 거라고는 생각 못 했어. 신비로운 기분이야.」
					BASE:63:理性 = 0
					TCVAR:発情 = 1
			ENDSELECT
			;まだ昼で晴れてない
		ELSEIF TIME:2 >=1 && TIME:2 <= 4 && TIME:5 > 1
			PRINTFORMW 「아, %CALLNAME:MASTER%! 좋은 아침이야.」
			PRINTFORMW 「음... 오늘 밤은 보름달이 뜨네...」
			PRINTFORMW 「날씨가 어떻게 될지는 모르겠지만...」
			PRINTFORMW 「만약 맑아진다면 나랑 같이 달 구경 갈래?」
			CALL K63_ASK_OTSUKIMI
			;まだ昼
		ELSEIF TIME:2 >=1 && TIME:2 <= 4
			PRINTFORMW 「오, %CALLNAME:MASTER%, 좋은 아침이야.」
			PRINTFORMW 「음... 오늘은 보름달이네...」
			PRINTFORMW 「날씨가 어떻게 될지 모르겠지만...」
			PRINTFORMW 「일단은 금방 갤 거라고 바라자.」
			;夜だけど晴れてない
		ELSEIF TIME:5 > 1
			;中秋の名月
			SELECTCASE DAY:2
				CASE 3
					PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
					PRINTFORMW 「드디어 추석이지만, 안타깝게도 날씨가...」
					PRINTFORMW 「있잖아, 날씨가 풀리면 나랑 같이 달 보러 갈래?」
					CALL K63_ASK_OTSUKIMI
					;普通の満月
				CASEELSE
					PRINTFORMW 「오, %CALLNAME:MASTER%! 좋은 저녁이야.」
					PRINTFORMW 「보름달인데, 참 안 좋은 날씨구나...」
					PRINTFORML 「...음, 이건 생리적인 주기라서...」
					PRINTFORMW 「나는 여전히 형상 변화를 할 수 있고, 지금도 약간의 털이 남아있어...」
					PRINTFORMW 「야, 어디 보고 있는 거야?!」
			ENDSELECT
			;夜で晴れてるけど室内（秋）
		ELSEIF DAY:2 == 3
			PRINTFORMW 「Oh, %CALLNAME:MASTER%...」
			PRINTFORMW 「오늘 밤은... 추수달이야...」
			PRINTFORMW 「음, 나랑 같이 달 구경하러 가줄래...?」
			PRINTFORML 「그게, 좀 부끄럽긴 한데 너와 함께라면...」
			PRINTFORMW 「네 맨 모습을 보여줘도 괜찮아...」
			PRINTFORMW 「그리고 원한다면...」
			PRINTFORMW 「아니, 일단 같이 달을 보러 가자!」
			;夜で晴れてるけど室内
		ELSE
			PRINTFORMW 「Ah... %CALLNAME:MASTER%...」
			PRINTFORMW 「헤이, 오늘 밤은 보름달이야.」
			PRINTFORML 「창피하지만, 네 거라면...」
			PRINTFORMW 「지금, 너에게 보여줘도 괜찮을지 궁금해...」
			PRINTFORMW 「하지만 그러면 어쩌지...」
			PRINTFORMW 「아-아니야, 아무것도 아니야!」
		ENDIF
		;それ以外の日
	CASEELSE
		IF TCVAR:63:371 == 1
			PRINTFORMW 「좋은 아침이야, %K63_SAILOR_CALLNAME%～」
			TCVAR:350 = 1
			RETURN 1
		ELSEIF TCVAR:63:370
			PRINTFORMW 「좋은 아침이야, %CALLNAME:MASTER%!」
			PRINTFORMDL 오늘은 어떤 이유에서인지 카게로우가 유난히 매력적으로 보인다...
			CALL ASK_M("그녀의 머리를 보완한다",1,"그녀의 향기를 보완하다",1,"그녀의 손톱을 보완한다",1)
			LOCAL = RESULT + 1
			IF LOCAL == TCVAR:63:370
				PRINTFORML 「아, 결국 눈치챘구나?」
				PRINTFORML 「나에게 신경 써주려고 노력해주는 모습이 정말 좋아!」
				CALL KIGEN_CHANGE(TARGET,100,1)
			ELSE
				PRINTFORML 「음, 고마워!」
			ENDIF
			TCVAR:63:370 = 0
			TCVAR:350 = 1
			RETURN 1
		ENDIF
		SELECTCASE TIME:2
			;朝は寝てるんで死に分岐ですが
			CASE 1,2
				PRINTFORML 「좋은 아침이야~ 음...」
				PRINTFORML 「누군가 이른 시간에 정말 활발하네, 응...」
				PRINTFORMW 「아침이 싫어...」
				;昼
			CASE 3,4
				PRINTFORMW 「오, %CALLNAME:MASTER%, 좋은 아침이야!」
				PRINTFORMW 「어차피 정오가 하루가 진정으로 시작되는 때지.」
				SIF TIME:0 < 901
					PRINTFORMW 「...하아암~... 아직 좀 졸리네...」
				;夜は分岐
			CASE 5,6,7
				SELECTCASE TIME:0
					;19～22時
					CASE 1140 TO 1320
						SELECTCASE TIME:3
							;18時以降起き
							CASE 1080 TO 1320
								PRINTFORMW 「오, %CALLNAME:MASTER%, 일어나서 빛을 발해! 하지만 아침이라 딱 그렇네, 그렇지?」
								PRINTFORMW 「후후, 역시 너는 밤에 활동하는 타입이구나.」
								PRINTFORMW 「설마 나 만나려고 무리하고 있는 건 아니겠지, 맞지?」
								PRINTFORML 「나-나는 물론 기쁘다! 하지만 그런 건 건강에 좋지 않아 보여.」
								PRINTFORMW 「적당히 하고 몸을 잘 돌보렴.」
								;朝～昼起き
							CASEELSE
								PRINTFORMW 「오, %CALLNAME:MASTER%, 좋은 아침이야!」
								PRINTFORMW 「Fufu, what a time to start the day, the sun is setting and night is just beginning.」
						ENDSELECT
						;22～28時
					CASEELSE
						SELECTCASE TIME:3
							;22～27時起き
							CASE 1320 TO 1440,0 TO 180
								PRINTFORMW 「오, %CALLNAME:MASTER%, 일어나 빛을 발해! 하지만 아침 같지는 않네, 응?」
								PRINTFORMW 「후후, 역시 너는 올빼미형이구나.」
								PRINTFORMW 「설마 나를 만나려고 무리하는 건 아니겠지, 그렇지?」
								PRINTFORMW 「나-나는 기쁘지만 말이야! 이렇게 늦게 일어나는 건 정말 좋지 않아.」
								PRINTFORMW 「나조차도 정오쯤 일어나려고 노력하는데.」
							CASEELSE
								PRINTFORMW 「오, %CALLNAME:MASTER%, 좋은 아침이야!」
								PRINTFORMW 「그렇다고 해도 이미 자정이 지났잖아, 그렇지 않아?」
								PRINTFORMW 「여기부터는 우리 요괴들의 시간이니까, 불필요하게 외출하는 건 삼가는 게 좋을 것 같아.」
						ENDSELECT
				ENDSELECT
		ENDSELECT
ENDSELECT
TCVAR:350 = 1
RETURN 1
