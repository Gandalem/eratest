@KUNKUN_KAGEROU
#LOCALSIZE キャラクタ数上限
#DIM LOCAL_ID
;一緒に作った料理は食べない
IF FLAG:20 && !TCVAR:353 && !ITEM:保温ジャー ;can't steal from the thermos, custom code
	PRINTFORMW 「음! 저거 %DISHNAME_TR()% 냄새가 나네!」
	;custom code
	RESULT = 0
	TRYCALL Com_Food_Check(TARGET, 1) ;com custom code
	IF RESULT
		PRINTFORMW 「...음, 다시 생각해보니, 안 하는 게 나으려나?」
		RETURN 1
	ENDIF
	PRINTL 
	PRINTFORMDW 카게로우는 당신이 반응하기도 전에 접시를 낚아채 순식간에 해치워 버린다!
	;EVENTCOMENDからコピペ。変更があったら対応の事。
	IF DISH_DRG
		CALL MESSAGE_EAT_DISH_DRG(TARGET)
		WAIT
	ENDIF
	;CALL KOJO_MESSAGE_SEND("EVENT",14,TARGET,-1,-1)
	CALL 食事(TARGET)
	CALL RESET_DISH
ELSE
	CALLF FUNC_FISHER_YATES_SHAFFLE(LOCAL, CHARANUM)
	;影狼ちゃんとモブ娘とMASTERは抽選対象から外します
	ARRAYREMOVE LOCAL, FINDELEMENT(LOCAL, 63), 1
	ARRAYREMOVE LOCAL, FINDELEMENT(LOCAL, MASTER), 1
	ARRAYREMOVE LOCAL, FINDELEMENT(LOCAL, RANDOM_CHARANUM), 1
	;FUNC_FISHER_YATES_SHAFFLE内で-1で初期化されるのでこれで全配列対象処理になる
	;場所判定がよくわからんことになってたのでとりあえず近場のキャラ？にしてみるよ
	FOR LOCAL_ID, 0, FINDELEMENT(LOCAL, -1)
	;同じマップにいるキャラ限定
	SIF GET_MAPID(CFLAG:(LOCAL:LOCAL_ID):現在位置) != GET_MAPID(CFLAG:63:現在位置)
		CONTINUE
	;同じ場所のキャラは除外
	SIF CFLAG:(LOCAL:LOCAL_ID):現在位置 == CFLAG:63:現在位置
		CONTINUE
	PRINTFORMW 「킁킁... 저건 %CALLNAME:(LOCAL:LOCAL_ID)%의 체취야!」
	BREAK
	NEXT
ENDIF
RETURN 1
