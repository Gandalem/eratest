;==================================================
;73,挿入子宮口責め
;==================================================

@M_KOJO_MESSAGE_COM_K63_73
CALL M_KOJO_MESSAGE_COM_K63_73_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K63_73_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;恋慕
	IF EXP:子宮口開発経験 < 25
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「흐으응... 천천히 해줘, 아프다고 말하고 있잖아!」
			PRINTFORML 「너무 거칠게 하지 마, 그곳은 아기가 자라야 하는 특별한 곳이야!」
		ELSE
			PRINTFORML 「응, 크으윽, 흐으으읍...」
			PRINTFORMDL 그녀를 화나게 하지 않도록 조심하며, 당신은 카게로우의 가장 깊은 곳을 천천히 자극하고 조금씩 발달시킨다.
			SIF EXP:子宮口開発経験 > 10
				PRINTFORML 그녀에게는 아직 약간 고통스러워 보이지만, 곧 마음껏 할 수 있을 것 같다.
		ENDIF
		EXP:子宮口開発経験 ++
		;ELSEIF EXP:子宮口開発経験 < 50
		;	PRINTFORML
	ENDIF
ENDIF
RETURN 1
