@KAGERO_SEX_V(posture)
#DIMS posture
IF TCVAR:[[影狼]]:破瓜 == 1
	;処女分岐（まだない）
	RETURN
ENDIF
;TCVAR:100 == PLAYERで挿入継続分岐も作るべきだけどまだない
;体位分岐もまだない、今のところ全部一括
;最初の15回
IF CFLAG:1100 < 15
	SELECTCASE RAND:4
		CASE 0
			PRINTFORMW （Uuhh... It feels weird to have something moving around inside your body...）
		CASE 1
			PRINTFORMW （My special place is being pried open by %CALLNAME:MASTER%...!）
