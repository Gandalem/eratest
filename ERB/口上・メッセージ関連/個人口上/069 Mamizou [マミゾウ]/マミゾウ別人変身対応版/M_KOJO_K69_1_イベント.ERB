@M_KOJO_別人変身版_SPEVENT_K69_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	K69_1_TNAME = \@ CFLAG:69:変化先 != 0 ? %CALLNAME:(CFLAG:69:変化先)%の姿をした # \@マミゾウ
	IF LOCAL:1 && ARG == 0
		PRINTW 
		IF TALENT:恋人
			PRINTDATAL
				DATAFORM 「다녀왔어, 자노。」
				DATAFORM 「……저기, 이대로 좀 더 있어도 괜찮을까? %MASTERNAME:69%……?」
				DATAFORM 「……좋은 거야, 이런 것도」
			ENDDATA
			PRINTFORMW 팔을 감고, %K69_1_TNAME%은 조금 아쉬운 듯 그런 말을 했다...
		ELSEIF TALENT:恋慕
			PRINTDATAL
				DATAFORM 「오늘은 즐거웠어. %MASTERNAME:69%」
				DATAFORM 「벌써 끝인가……. 또 데려가 줄 거지? %MASTERNAME:69%?」
			ENDDATA
			PRINTFORMW 기울어지듯 밀착하는 %K69_1_TNAME%은 미소 지으며 그런 말을 했다...
		ELSEIF TALENT:愛欲
			PRINTDATAL
				DATAFORM 「저기, 당신. 설마 이걸로 끝나는 건 아니겠죠?」
				DATAFORM 「저기... 나는 슬슬 참을 수 없게 되었는데... ♪」
			ENDDATA
			PRINTFORMW %K69_1_TNAME%이 요염하게 웃으며 이쪽을 보고 그렇게 말했다…
		ELSEIF TALENT:思慕
			PRINTDATAL
				DATAFORM 「흠, 가끔은 이런 것도 좋은 거 아니겠어」
				DATAFORM 「꽤 유익했네, 자네.」
			ENDDATA
			PRINTFORMW %K69_1_TNAME%는 즐거워 보인다...
		ELSE
			PRINTFORML 「후우, 수고했어」
			PRINTFORMW %K69_1_TNAME%은 크게 기지개를 켜고 있다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「무슨 일이지? 내 얼굴에 뭔가 붙었나?」
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「......뭐, 나도 오니는 아니니까.」
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「하아, 정말이지……. 자네도 실망스러운 것이로군.」
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
