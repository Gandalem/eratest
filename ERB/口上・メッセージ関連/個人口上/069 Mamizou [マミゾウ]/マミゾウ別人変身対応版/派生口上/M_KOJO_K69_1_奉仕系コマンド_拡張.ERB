					CALL HPH_PRINT,@"「응응! HPH ……쭈르륵, 쭈르르르루욱 HPH」","L"
			ENDSELECT
			PRINTFORMW 사정의 기척을 느낀 마미조는, 라스트 스퍼트라고 할 수 있는 듯 \@ TRANSAFTER == K69_CNUM ?  # %CALLNAME:TRANSAFTER%의 \@ 목구멍으로 음경을 빨아들였다...
		ELSE
			LOCAL:99 = RAND:2
			SELECTCASE LOCAL:99
				CASE 0
					CALL HPH_PRINT,@"「음... 츄르, 주무... HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「쭉, 쭉, 쭉......흡」","L"
			ENDSELECT
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 마미조는 \@ TRANSAFTER == K69_CNUM ? 그 # %CALLNAME:TRANSAFTER%의 \@\@ TALENT:K69_CNUM:体型 < 0 ? 작은 #  \@ 입과 목 전체로, %조사처리(CALLNAME:MASTER,"의")% 음경에게 봉사하고 있다…
				CASE 1
					PRINTFORMW 마미조는 \@ TRANSAFTER == K69_CNUM ?  # %CALLNAME:TRANSAFTER%의 모습으로 \@\@ TALENT:K69_CNUM:体型 < 0 ? 작은 입으로는 도저히 들어가지 않을 듯한 #  \@%조사처리(CALLNAME:MASTER,"의")% 성기를 단단히 물고, 구강과 목으로 봉사하고 있다…
			ENDSELECT
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF NOWEX:MASTER:射精
			CALL HPH_PRINT,@"「음윽... 주르륵 HPH」","W"
		ELSE
			CALL HPH_PRINT,@"「음... 줄, 줌...」","W"
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
