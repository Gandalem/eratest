;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@別人変身版_MESSAGE_COM_K69_300
#DIMS VALUE
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	K69_1_TNAME = \@CFLAG:K69_CNUM:変化先 ? %CALLNAME:(CFLAG:K69_CNUM:変化先)%の姿で# \@
	IF TALENT:K69_CNUM:体型 < 0
		IF TALENT:K69_CNUM:バストサイズ < 0
			VALUE = つるぺたボディ
		ELSEIF TALENT:K69_CNUM:バストサイズ > 0
			VALUE = ロリ巨乳
		ELSE
			VALUE = ロリボディ
		ENDIF
	ELSE
		IF TALENT:K69_CNUM:バストサイズ < 0
			VALUE = 貧乳
		ELSEIF TALENT:K69_CNUM:バストサイズ > 0
			VALUE = 豊満な身体
		ELSE
			VALUE = 身体
		ENDIF
	ENDIF
	IF !CFLAG:K69_CNUM:1003
		MASTERNAME:K69_CNUM = お前さん
		PRINTFORML 「......그런데 당신 이름이 뭐였더라......」
		CALL ASK_YN("이름을 밝히다","이름 부르지 않는다")
		IF !RESULT
			SIF NAME:MASTER != "あなた"
				CFLAG:K69_CNUM:1002 = 1
			PRINTFORML 「흠, 그렇게 되어버렸다고... 딱히 바보가 된 건 아니라고?」
		ELSE
			PRINTFORML 「흠, 그렇게 되어버렸다고... 딱히 바보가 된 건 아니라고?」
		ENDIF
		PRINTL
		SIF (TALENT:K69_CNUM:恋慕 || TALENT:K69_CNUM:愛欲) && CFLAG:K69_CNUM:1002
			MASTERNAME:K69_CNUM = %CALLNAME:MASTER%どの
		CFLAG:K69_CNUM:1003 = 1
	ENDIF
	IF CFLAG:K69_CNUM:ブチギレ > 0 || TALENT:K69_CNUM:機嫌 == -1 || MARK:K69_CNUM:反発刻印 >= 3
		PRINTFORML 「…………」
		PRINTFORMW 마미조는 %조사처리(CALLNAME:MASTER,"를")% 흘긋 볼 뿐이었다...
		;失敗時
	ELSEIF TFLAG:193 == -1
		IF TALENT:恋慕 || TALENT:愛欲
			PRINTFORML 「……응? 미안, 무슨 일이었지」
			PRINTFORML 마미조가 그렇게 대답한다.
			PRINTFORMW 멍하게 있어서 내 말을 듣고 있지 않았던 것 같다...
		ELSEIF TALENT:思慕 || TALENT:セフレ
			PRINTFORML 「……응? 미안, 무슨 일이었지」
			PRINTFORML 마미조가 그렇게 대답한다.
			PRINTFORMW 멍하게 있어서 내 말을 듣고 있지 않았던 것 같다...
		ELSE
			PRINTFORML 「……응? 뭔가 말했나?」
			PRINTFORML 마미조가 그렇게 대답한다.
			PRINTFORMW 별로 흥미가 없는 것 같다...
		ENDIF
		;デート時
		;ランダム分岐
	ELSE
		$RETALK
		SELECTCASE RAND:6
			CASE 0,1	;陥落強め
				IF TALENT:恋慕 || TALENT:愛欲
					;欲情度が高いor欲求不満度が高い時
					IF CFLAG:K69_CNUM:溜まってる度 >= 800 || TCVAR:K69_CNUM:発情 || PALAM:K69_CNUM:欲情 >= PALAMLV:5
						GOTO ESTRUS
					ELSE
						;変身中
						IF CFLAG:K69_CNUM:変化先
							;人里
							IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
								SELECTCASE RAND:4
									CASE 0
										CALL PRINTCOLORL(COLOR("LIGHT-GRAY"),@"「......정말, 이렇게 사람이 많은 곳에서 %CALLNAME:(CFLAG:K69_CNUM:変化先)%으로 변신한 채라니......」")
										CALL PRINTCOLORL(COLOR("LIGHT-GRAY"),@"　본인에게라도 들키면 어쩌려고……. 그때는 감싸줘? %MASTERNAME:K69_CNUM%")
										PRINTFORMW 마미조가 주변을 살피며 작은 목소리로 그렇게 속삭였다...
									CASE 1
										CALL PRINTCOLORL(COLOR("LIGHT-GRAY"),@"(......뭐, 이왕 온 김에 즐겨볼까)")
										PRINTFORML 「저기, 저쪽으로 가고 싶은데, 에스코트해 주지 않을래♪」
										PRINTFORMW 마미조는 %CALLNAME:(CFLAG:K69_CNUM:変化先)%인 척 그렇게 말을 걸어왔다
									CASE 2
										PRINTFORML 「……있잖아, 나 그거 사줬으면 좋겠어~♪」
										CALL PRINTCOLORL(COLOR("LIGHT-GRAY"),@"「……거절하면, 알겠지?」")
										PRINTFORMW 마미조는 %CALLNAME:(CFLAG:K69_CNUM:変化先)%인 척하며 기념품을 조르러 왔다...
										PRINTFORMW ...%조사처리(CALLNAME:MASTER,"의")% 귓가에 속삭이듯 위협하면서...
									CASE 3
										PRINTFORML 「이왕 온 김에, \@ RAND:2 == 0 ? 스즈나안 # 게인노테이 \@라도 구경하러 갈까……♪」
										PRINTFORML 「……자, 같이 가요, %CALLNAME:MASTER%♪」
										PRINTFORMW %CALLNAME:(CFLAG:K69_CNUM:変化先)%의 척한 마미조가, %조사처리(CALLNAME:MASTER,"의")% 손을 즐겁게 잡아끌었다…
								ENDSELECT
								;人里以外
							ELSE
								SELECTCASE RAND:4
									CASE 0
										PRINTFORML 「음, %MASTERNAME:K69_CNUM%는 이런 아가씨를 좋아하는 건가?」
										PRINTFORMW 마미조는 %CALLNAME:(CFLAG:K69_CNUM:変化先)%의 모습으로 그 몸을 톡톡 만지며 그렇게 물어왔다…
									CASE 1
										PRINTFORML 「흠, 모처럼 왔으니 이 몸으로 인간이라도 속여 보러 갈 수 있겠지♪」
										PRINTFORMW 마미조는 %CALLNAME:(CFLAG:K69_CNUM:変化先)%의 모습으로 그렇게 중얼거리며 킬킬 웃고 있다...
									CASE 2
										PRINTFORML 「흠, 모처럼 이 몸으로 인간이라도 속여보러 갈까나.」
										PRINTFORML 　……여기에 딱 좋은 먹잇감도 있는 것 같군♪」
										PRINTFORMW 마미조는 %CALLNAME:(CFLAG:K69_CNUM:変化先)%의 모습으로 그렇게 중얼거리더니, %CALLNAME:MASTER%쪽을 보며 크크 웃고 있다…
									CASE 3
										PRINTFORML 「……있잖아, %MASTERNAME:K69_CNUM%♪ 신경 써줘ー♪」
										PRINTFORMW 마미조는 %CALLNAME:(CFLAG:K69_CNUM:変化先)%의 모습과 목소리로, 거친 흉내를 내면서 그 %VALUE%으로 뒤에서 \@ TALENT:K69_CNUM:体型 > 0 ? 덮쳐왔다... # 달라붙어 왔다... \@
								ENDSELECT
							ENDIF
							;非変身中
						ELSE
							;人里
							IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
								SELECTCASE RAND:5
									CASE 0
										PRINTFORMW 「이 모습, 잘 어울리나? 후후, 그렇구나♪」
									CASE 1
										PRINTFORML 이렇게 사람 사는 곳을 어슬렁거리는 게 취미야.
										PRINTFORML 　뭐, 딱히 뭘 하려는 건 아니고, 단지 심심할 뿐이야.
										PRINTFORML 그렇게 말하면서 마미조는 주위를 서성거렸다.
										PRINTFORMW ……%조사처리(CALLNAME:MASTER,"에게")% 그녀가 희미하게 주의를 기울이고 있는 것처럼 보였다…
									CASE 2
										PRINTFORMW 「……누에에게, 선물이라도 사다 줄까……」
									CASE 3
										PRINTFORML 그러고 보니 조금 전에 시오야시키의 남편이 돌아가셨을 때
										PRINTFORMW 　그거 안타까웠지... 아니? 이건 내 얘기잖아.
									CASE 4
										PRINTFORML 밤의 계룡탕에는 벌써 갔나?
										PRINTFORMW 　만약 아직 안 갔다면 한번 가 보는 게 좋아, 재미있는 걸 볼 수 있을 테니.
								ENDSELECT
								;人里以外
							ELSE
								SELECTCASE RAND:4
									CASE 0
										PRINTFORML 「나의 능력은 변신하는 능력이 아니란다?」
										PRINTFORML 　올바르게 말하면, 괴물로 만드는 능력이지. 자, %MASTERNAME:K69_CNUM%도 괴물로 만들어 줄까?... 호호, 농담이야」
									CASE 1
										PRINTFORML 「내가 일부러 환상향에 온 건 누에\@ CFLAG:41:面識 ? 의 # 이라는 \@ 녀석에게 요괴의 위기라 불렸기 때문이란 말이지.」
										PRINTFORML 　내가 도착했을 때는 이미 모든 일이 끝나버린 모양이군……
										PRINTFORMW 　뭐, 그냥 그 흐름대로 정착한 것이지.
									CASE 2
										PRINTFORML 「뭐야, 내 꼬리가 신경 쓰이나?」
										PRINTFORMW 「자자, %MASTERNAME:K69_CNUM%라면 만져도 좋아...♪」
									CASE 3
										PRINTFORML 「나는 비교적 신참이지만, 요괴로서의 연륜에는 자신이 있다네.」
										PRINTFORML 　뭐 그런 이유로, 이곳 요괴들의 얼굴 같은 것도 하고 있지.
										PRINTFORMW 　……%MASTERNAME:K69_CNUM%는 인간이지만, 뭐 특별하니 곤란한 일이 있으면 나에게 말하거라……♪」
								ENDSELECT
							ENDIF
						ENDIF
					ENDIF
				ELSE
					GOTO RETALK
				ENDIF
			CASE 2		;天候＆季節
				;地表以外なら再抽選
				SIF (CFLAG:K69_CNUM:現在位置 / 100) == 6 || (CFLAG:K69_CNUM:現在位置 / 100) == 9 || (CFLAG:K69_CNUM:現在位置 / 100) == 10
					GOTO RETALK
				IF TALENT:恋慕 || TALENT:愛欲
					;大雨,台風
					IF (GROUPMATCH(天候, 5) || FLAG:異常気象 == 9) && TCVAR:351 != 5
						;人里でばったり
						IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
							PRINTFORML 「정말, 날씨가 안 좋네……」
							PRINTFORML 　이런 날은 \@ RAND:2 ? 단것 파는 곳에서 느긋하게 보내는 게 최고야 # 스즈나안에서 어슬렁거릴까……. \@」
							PRINTFORMW 마미조는 %K69_1_TNAME% 에라 모르겠다 하는 듯 중얼거렸다…
							;人里以外
						ELSE
							PRINTFORML 정말, 안 좋은 날씨로군…….
							CALL HPH_PRINT,@"　\@OUTROOF(CFLAG:K69_CNUM:現在位置) ? 이런 날은 어서 돌아와 서로 몸을 녹이는 것이 좋겠지? %MASTERNAME:K69_CNUM%# ……자, 이리 와서 우리 둘이 함께 따뜻하게 있자\@HPH","L"
							PRINTFORMW 마미조는 %K69_1_TNAME%\@ OUTROOF(CFLAG:K69_CNUM:現在位置) ? %조사처리(CALLNAME:MASTER,"에게")% 몸을 기대며 귓가에 그렇게 속삭여왔다... # %조사처리(CALLNAME:MASTER,"를")% 휙 끌어당기자 그대로 몸을 기댔다... \@
						ENDIF
						TCVAR:351 = 5
						;雨,霧雨
					ELSEIF GROUPMATCH(天候, 4, 6) && TCVAR:351 != 4
						;人里でばったり
						IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
							PRINTFORML 「우으... 오늘은 쌀쌀하네...」
							PRINTFORML 　이런 날은 \@ RAND:2 ? 계룡정에서 따뜻한 걸 먹고 싶네... # 스즈나안에서 어슬렁거릴까... \@」
							PRINTFORMW 마미조는 %K69_1_TNAME% 몸을 움츠리며 그렇게 중얼거렸다...
							;人里以外
						ELSE
							PRINTFORML うう…… 오늘은 쌀하네…….
							CALL HPH_PRINT,@"　\@OUTROOF(CFLAG:K69_CNUM:現在位置) ? 이런 날은 어서 돌아와 서로 몸을 녹이는 것이 좋겠지? %MASTERNAME:K69_CNUM%# ……자, 이리 와서 우리 둘이 함께 따뜻하게 있자\@HPH","L"
							PRINTFORMW 마미조는 %K69_1_TNAME%\@ OUTROOF(CFLAG:K69_CNUM:現在位置) ? %조사처리(CALLNAME:MASTER,"에게")% 몸을 기대며 귓가에 그렇게 속삭여왔다... # %조사처리(CALLNAME:MASTER,"를")% 휙 끌어당기자 그대로 몸을 기댔다... \@
						ENDIF
						TCVAR:351 = 4
						;霧
					ELSEIF GROUPMATCH(天候, 7) && TCVAR:351 != 7
						;人里でばったり
						IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
							PRINTFORML 「오늘은 유난히 짙은 안개로군……」
							PRINTFORML 　몸을 떨지 않게 조심하거라? %MASTERNAME:K69_CNUM%」
							PRINTFORMW 마미조는 %K69_1_TNAME%%조사처리(CALLNAME:MASTER,"에게")% 상냥하게 그렇게 말을 건넸다…
							;人里以外
						ELSE
							PRINTFORML 「오늘은 유난히 짙은 안개로군……」
							PRINTFORML 　몸을 떨지 않도록 조심해라?%MASTERNAME:K69_CNUM%」
							PRINTFORMW 마미조는 %K69_1_TNAME%%조사처리(CALLNAME:MASTER,"에게")% 상냥하게 그렇게 말을 건넸다…
						ENDIF
						TCVAR:351 = 7
						;吹雪,猛吹雪
					ELSEIF (GROUPMATCH(天候, 9) || FLAG:異常気象 == 10) && TCVAR:351 != 9
						;人里でばったり
						IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
							PRINTFORML 「오오, 오늘은 유난히 눈보라가 치는구나……」
							PRINTFORML 　나는 추위에 강해서 괜찮지만, %MASTERNAME:K69_CNUM%에게는 좀 버거울까?」
							PRINTFORMW 마미조는 %K69_1_TNAME% 몸을 움츠리며 그렇게 중얼거렸다…
							;人里以外
						ELSE
							PRINTFORML 오, 오늘은 유난히 눈보라가 치는군……
							CALL HPH_PRINT,@"　\@OUTROOF(CFLAG:K69_CNUM:現在位置) ? 이런 날은 어서 돌아와 서로 몸을 녹이는 것이 좋겠지? %MASTERNAME:K69_CNUM%# ……자, 이리 와서 우리 둘이 함께 따뜻하게 있자\@HPH","L"
							PRINTFORMW 마미조는 %K69_1_TNAME%\@ OUTROOF(CFLAG:K69_CNUM:現在位置) ? %조사처리(CALLNAME:MASTER,"에게")% 몸을 기대며 귓가에 그렇게 속삭여왔다... # %조사처리(CALLNAME:MASTER,"를")% 휙 끌어당기자 그대로 몸을 기댔다... \@
						ENDIF
						TCVAR:351 = 9
						;春
					ELSEIF DAY:2 == 1 && TCVAR:351 != 1
						;人里でばったり
						IF (CFLAG:K69_CNUM:現在位置 / 100) == 2
