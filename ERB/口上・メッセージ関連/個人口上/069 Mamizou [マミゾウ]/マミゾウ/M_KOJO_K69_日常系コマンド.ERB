;==================================================
;309,頭を撫でる
;==================================================

@M_KOJO_MESSAGE_COM_K69_309
;口上メイン呼出
IF FLAG:70
ELSE
	CALL M_KOJO_MESSAGE_COM_K69_309_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K69_309_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF CFLAG:TARGET:睡眠
		IF 陥落状態() >= 4
			PRINTFORML 「음... Zzz... 에헤헤...」
			PRINTFORMDL 당신이 그녀의 머리를 부드럽게 쓰다듬자, 마미조의 표정이 미소로 풀린다.
			PRINTFORML 「Zzz... %MASTERNAME%... 사랑해...」
			PRINTFORMDW 그녀의 편안한 표정과 귀여운 잠꼬대가 당신의 심장 박동을 빠르게 만든다.
		ELSE
			PRINTFORML 「zzz... 더... zzz...」
			PRINTFORMDW 그녀의 행복한 표정과 조용한 잠꼬리에 격려받아, 당신은 계속해서 부드럽게 그녀의 머리를 쓰다듬는다.
		ENDIF
	ELSEIF CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2)
		SIF ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 != 220) || (MAIN_MAP == 2 && CFLAG:MASTER:現在位置 != 213))
			PRINTFORMDL 두 분이 우연히 코스즈를 마주친다.
		IF ABL:親密 > 5
			IF 陥落状態() >= 4
				PRINTFORML 「... 이건 정말 공공연한 활동이 아니야.」
				CALL SET_KOJO_COLOR(70)
				PRINTFORML 『하지만 너는 정말 행복해 보이고 침착해 보인다.』
				PRINTFORMDL 코스즈가 웃음을 터뜨렸고 마미조는 그녀에게 비꼬는 미소를 지었다.
				CALL SET_KOJO_COLOR(69)
				PRINTFORML 「그것이 %CALLNAME:MASTER%이기 때문이야.」
				CALL SET_KOJO_COLOR(70)
				PRINTFORML 『후후, 정말 멋진 관계네요.』
				PRINTFORMDW 두 사람이 함께 웃는 모습을 보다가 어느새 당신도 미소 짓게 된다.
			ELSEIF 陥落状態() >= 2
				PRINTFORML 「얌전히 있으라고 한 것 같은데... 얼마나 치정할 수 있는 거야?」
				CALL SET_KOJO_COLOR(70)
				PRINTFORML 『하지만 당신은 그것에 대해 정말 행복해 보이네요. 얼마나 멋진지...』
				PRINTFORMDW 마미조는 짜증을 내며 한숨을 쉬고 당신에게 못된 눈길을 보낸다.
				CALL SET_KOJO_COLOR(69)
				;ELSEIF 陥落状態() == 1
			ENDIF
		ELSEIF ABL:親密 > 2
			IF 陥落状態() >= 2
				PRINTFORML 「이 어린 것아, 나를 공개적으로 창피하게 하는 게 재미있니?」
				CALL SET_KOJO_COLOR(70)
				PRINTFORML 『그래도 당신은 그것에 대해 행복해 보이네요. 두 분 정말 잘 지내는군요.』
				PRINTFORMDW 코스즈에게 진심이 드러난 마미조는 부끄러워 고개를 돌립니다.
				CALL SET_KOJO_COLOR(69)
				;ELSEIF 陥落状態() == 1
			ELSE
				PRINTFORML 「그만둬 이 바보야, 코스즈 앞에서 그러면 안 돼.」
				CALL SET_KOJO_COLOR(70)
				PRINTFORMW 『아, 신경 쓰지 마요.』
				CALL SET_KOJO_COLOR(69)
			ENDIF
		ELSE
			PRINTFORML 「닥쳐, 이 바보야!」
			CALL SET_KOJO_COLOR(70)
			PRINTFORMW 『데이트 상대에게 그렇게 장난치면 안 돼.』
			CALL SET_KOJO_COLOR(69)
		ENDIF
	ELSEIF (TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)) || GET_TARGETNUM() >= 2
		IF ABL:親密 > 5
			IF 陥落状態() >= 4
				PRINTFORML 「그만하라고 말했잖아, 바보야.」
				PRINTFORMDL 마미조가 짜증을 내며 한숨을 쉬지만, 이내 장난스럽게 웃는다.
				PRINTFORML 「후훗, 너 정말 희망이 없구나.」
				PRINTFORMDW 두 사람은 주변의 조용한 불평들을 태연하게 무시한다.
			ELSEIF 陥落状態() >= 2
				PRINTFORML 「야, 사람들이 우리 보고 있어.」
				PRINTFORMDW 당신은 주변의 차가운 시선들을 무시하고 계속 마미조우의 머리를 쓰다듬는다.
				;ELSEIF 陥落状態() == 1
			ENDIF
		ELSEIF ABL:親密 > 2
			IF 陥落状態() >= 2
				PRINTFORML 「야, 공공장소에서 그런 거 하지 말라고 내가 말했잖아.」
				PRINTFORMDW 그녀의 불평에도 불구하고 마미조는 너를 막으려는 노력을 전혀 하지 않아서, 너는 계속 그녀의 머리를 쓰다듬었다.
			ELSEIF 陥落状態() == 1
			ELSE
				PRINTFORMW 「야, 그만해. 사람들도 주변에 있잖아...」
			ENDIF
		ELSE
			PRINTFORMW 「여기는 공공장소야! 예의를 지켜!」
		ENDIF
	ELSE
		IF ABL:親密 > 5
			IF 陥落状態() >= 4
				PRINTFORML 「후훗, 이런 애정 넘치는 것들이 의외로 기분 좋네.」
				PRINTFORMDL 마미조를 향해 고개를 살짝 기울였다.
				PRINTFORML 「아니야, 아무것도 아니야. 계속해, 알았지?」
				PRINTFORMDW 두 사람은 따뜻한 미소를 주고받았다.
			ELSEIF 陥落状態() >= 2
				PRINTFORML 「음, 괜찮긴 한데 이상한 패배감이 떨쳐지지 않아.」
				PRINTFORMDW 이 말을 한 직후, 마미즈도 당신의 머리를 쓰다듬기 시작한다.
				;ELSEIF 陥落状態() == 1
			ELSE
				PRINTFORMW 「후후, 가끔 이럴 때가 좋겠지.」
			ENDIF
		ELSEIF ABL:親密 > 2
			IF 陥落状態() >= 2
				PRINTFORML 「야, 너 지금 뭐 하는 건 줄 알아?」
				PRINTFORMDW 그녀의 불평에도 불구하고 마미조우는 미소를 짓는다.
				;ELSEIF 陥落状態() == 1
			ELSE
				PRINTFORMW 「흥, 내가 네 선배라는 걸 잊지 마라...」
			ENDIF
		ELSE
			PRINTFORMW 「... 갑자기 이게 뭐야? 그렇게 함부로 만지지 마.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;310,尻を撫でる
;==================================================

@M_KOJO_MESSAGE_COM_K69_310
;口上メイン呼出
IF FLAG:70
ELSE
	CALL M_KOJO_MESSAGE_COM_K69_310_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K69_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF CFLAG:TARGET:睡眠 == 1
		IF 陥落状態() >= 4
			PRINTFORML 「Zzz... 음... 기분... 좋다....」
			PRINTFORMDL 그녀의 잠꼬임에 자극받아, 너는 더 힘을 주었다.
			PRINTFORMDL 당신은 손가락 아래 부드러운 탄력을 느끼며 마미조의 엉덩이를 거칠게 문지른다.
			PRINTFORMW 「... Zzz... %MASTERNAME%...」
		ELSE
			PRINTFORML 「즈즈...? ...변태...」
			PRINTFORMDW 그녀의 잠꼬리에 흥분하여 마음껏 엉덩이를 쓰다듬는다.
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		IF 陥落状態() >= 4
			PRINTFORML 「후후, 내 엉덩이가 정말 기분 좋으려나?」
			PRINTFORMDL 당신은 그녀의 엉덩이 아래에서 느껴지는 부드러운 감각을 온전히 즐기며 고개를 끄덕인다.
			PRINTFORML 「아후우... 저기... 좀... 장난치는 거 아니야, 그렇지 않아?」
			PRINTFORMDW 마미조는 그 느낌을 즐기는 듯했고, 당신은 더욱 외설적인 방식으로 손을 움직이기 시작한다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「후와아! 음... 후후, 이거 재미있지 않아.」
			PRINTFORMDW 두 사람은 암시하는 듯한 미소를 주고받는다.
			;ELSEIF 陥落状態() == 1
		ENDIF
	ELSEIF CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2)
		SIF ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 != 220) || (MAIN_MAP == 2 && CFLAG:MASTER:現在位置 != 213))
			PRINTFORMDL 두 분이 우연히 코스즈를 마주친다.
		IF FIRSTTIME("310A")
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『아라, 무슨 일이야?』
			CALL SET_KOJO_COLOR(69)
			PRINTFORMW 「아, 아하하하, 아무것도 아니야. 네 작은 머리 쓸 필요 없어.」
			PRINTFORMDL 코스즈에게 억지로 웃음을 유발한 그녀는 당신의 갈비뼈를 고통스럽게 팔꿈치로 친다.
			PRINTFORMDL 그녀를 무시하고, 당신은 계속해서 그녀의 엉덩이를 쓰다가, 그녀가 마침내 당신의 귓가에 바짝 다가온다.
			PRINTFORMW 「... 저녁 식사가 되고 싶어?」
			PRINTFORMDL 마미조의 목소리는 낮은 그르렁거림이었고, 당신은 본능적으로 손을 뗀다.
			PRINTFORML 『아, 연인의 말인가? 정말 꿈만 같네.』
			PRINTFORMDW 마미조는 흥미로 반짝이는 눈의 코스즈에게 서둘러 설명하려 애썼고, 당신은 그저 힘없이 미소 지을 뿐이다.
			CALL SET_KOJO_COLOR(69)
