;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K69_334
RETURN 1

@M_KOJO_MESSAGE_COM_K69_334
IF !CFLAG:ブチギレ
	CALL TRAIN_MESSAGE
ELSE
	PRINTFORML 
	PRINTFORML 「...」
	PRINTFORMDW 마미조는 당신에게서 시선을 돌렸다 %SPLIT_G("sullenly:with an angry expression")%.
	RETURN 1
ENDIF
;口上メイン呼出
IF FLAG:70
ELSE
	CALL M_KOJO_MESSAGE_COM_K69_334_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K69_334_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF 陥落状態() >= 4 && TFLAG:193 >= 1 ;critical success
		PRINTFORML 「후후, 마실래? 그럼 이리 와 봐.」
		PRINTFORMDL Mamizou는 술잔에 담긴 사케를 입으로 들이킨 다음, 삼키지 않고 당신의 입술에 자신의 입술을 가져다 댄다.
		PRINTFORML 「%RANDLIPS(,"kiss")%...」
		PRINTFORMDW 당신은 키스로 술을 나누고, 비로소 두 사람은 주변의 홍조를 띤 손님들을 알아차린다...
		CALL MUTUAL_KISS
	ELSEIF 陥落状態() >= 2 || TFLAG:193 >= 1
		PRINTFORML 「이 연회는 사람이 많을수록 더 즐겁지 않나, 응?」
		PRINTFORMDW 당신은 마미조에게 열렬히 동의했다.
		;ELSEIF 陥落状態() == 1
	ELSEIF TFLAG:193 == 0
		PRINTFORMW 「후후, 가끔 이렇게 모두와 함께 술 마시는 것도 나쁘지 않네.」
	ELSE
		PRINTFORMW 「미안하지만 정말로 %SPLIT_G("spend this time in my own company:drink alone")%하고 싶었어. 괜찮겠니?」
		PRINTFORMDW 마미조는 당신을 무시하며 자신의 술로 시선을 돌린다.
	ENDIF
ENDIF
RETURN 1
