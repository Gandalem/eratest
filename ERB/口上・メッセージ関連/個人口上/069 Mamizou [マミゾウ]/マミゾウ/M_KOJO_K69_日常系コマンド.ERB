@M_KOJO_MESSAGE_COM_K69_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
IF (CFLAG:ブチギレ  || TFLAG:193 == -3) && !FLAG:70 ;custom code, hate mark 3
	PRINTFORML 
	PRINTFORML 「...」
	PRINTFORMDL 마미조는 당신에게서 시선을 돌렸다 %SPLIT_G("sullenly:with an angry expression")%.
	RETURN 1
ELSE
	CALL TRAIN_MESSAGE
ENDIF
;口上メイン呼出
IF FLAG:70
ELSE
	CALL M_KOJO_MESSAGE_COM_K69_300_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K69_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF 陥落状態() >= 4
		IF CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2) && (!TALENT:70:恋慕 || !TALENT:70:恋人) ;if suzu isn't involved romantically yet to make more sense
			SELECTCASE RAND:2
				CASE 0
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『언제나처럼 행복한 커플처럼 보인다.』
					CALL SET_KOJO_COLOR(69)
					PRINTFORML 「후후, 연모는 삶의 양념이지, 알잖아.」
					PRINTFORMDW 마미조가 당신에게 행복하게 몸을 기댄다.
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『정말 로맨틱하게 들린다. 나도 그런 사람일 수 있었으면 좋겠다!』
					CALL SET_KOJO_COLOR(69)
					PRINTFORML 「오, 좀 꾸미면 파트너를 찾을 수 있을 거야. 하지만 내 것만큼은 안 될걸.」
					PRINTFORMDW 코스즈는 두 사람이 애정을 나누는 모습을 질투하는 기색으로 바라본다.
				CASE 1
					PRINTFORML 「사랑을 찾아보는 것에 대해 생각해 본 적 없나요, 아가씨?」
					PRINTFORMDL 마미조가 팔로 당신의 팔을 감고 있는 것을 보자 코스즈는 어색한 미소를 지었다.
					CALL SET_KOJO_COLOR(70)
					PRINTFORMW 『아, 별로 깊이 생각해 본 적 없어요. 게다가 저 같은 책벌레한테 관심 가질 사람이 있을 리가 없다고 생각해요.』
					CALL SET_KOJO_COLOR(69)
					PRINTFORML 「흠, 그런 태도로는 안 돼. 하지 않은 기회들은 모두 놓치는 법이지.」
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『음~ 할 만한 흥미로운 것들이 정말 많아.』
					PRINTFORMDW 하지만 그녀가 이렇게 말하면서도 코스즈는 당신들 둘을 약간 부러운 듯 바라봤다.
					CALL SET_KOJO_COLOR(69)
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「후훗, 나 지금 그냥 지루하게 떠드는 것뿐이겠지.」
					PRINTFORMDL 당신은 그녀의 이야기가 정말 흥미롭다고 진심으로 말한다.
					PRINTFORML 「음, 너 참 능숙한 소악마로군. 기분이 좋네.」
					PRINTFORMDW 마미조는 살짝 홍당무처럼 빨개지고, 당신의 가슴이 두근거리는 것을 느낀다.
				CASE 1
					PRINTFORML 「아, 내 이야기를 들었나 보군. ... 절대로 그렇게 할 리가 없어. 아니, 진심이야.」
					PRINTFORMDL 당신은 그녀에게 더 자세히 물으려는 충동을 자제하고, 그저 아는 듯한 미소만을 건넨다.
					PRINTFORML 「흥, 날 못 믿겠지? 난 그냥 도망칠 기회를 만들려고 했을 뿐이야.」
					PRINTFORMDW 그녀가 저렇게 방어적으로 나오는 것을 보며, 당신은 그녀가 정말 진실을 말하고 있는지 궁금해한다.
				CASE 2
					PRINTFORML 「후후, 긴 수명에도 나 자신에게 또 다른 파트너를 얻을 줄은 몰랐어.」
					PRINTFORMDL 마미조는 미소 짓지만 그 안에는 슬픔의 그림자가 드리워져 있다.
					PRINTFORML 「음? 무슨 걱정스러운 표정을 짓고 있는 거야? 내 얼굴에 뭐가 있나?」
					PRINTFORMDW 당신은 아무것도 아니라고 말하며 오히려 그녀에게 미소를 돌려준다.
			ENDSELECT
		ENDIF
	ELSEIF 陥落状態() >= 2
		IF CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2)
			SELECTCASE IFRAND("0TO1", 1, "D0", TALENT:70:恋慕 || TALENT:70:恋人) ;remove if suzu involved romantically to make more sense
				CASE 0
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『아, 안녕하세요. 오늘 무언가를 찾으시는 건가요?』
					CALL SET_KOJO_COLOR(69)
					PRINTFORML 「후후, 데이트잖아, 질투해? 너도 누군가랑 진지하게 사귀어야지.」
					PRINTFORMDW 마미조는 당신의 팔을 감싸 안고, 코스즈는 그저 어색하게 미소만 지었다.
				CASE 1
					CALL PRINT_DIALOGUE, @"아, 코스즈. \@ ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || (MAIN_MAP == 2 && CFLAG:MASTER:現在位置 == 213)) ? 그렇게 꾸미고 어디 가는 거야? # 이렇게 밖에 나와 있는 걸 만나는 건 드문데. 어디로 가니? \@"
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『아, 안녕. 친구 집 잠깐 다녀오는 거야.%COND_STR(@" Do you need something first, though?", GET_MAP_REPLACEMENT(CFLAG:MASTER:現在位置) == P213鈴奈庵)%』
					PRINTFORMDW 둘이 그렇게 아무렇지도 않게 이야기하는 것을 보며, 당신은 약간 소외감을 느낀다.
					CALL SET_KOJO_COLOR(69)
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「후훗, 만나서 정말 좋았어. 내 인생에서 좋은 일 중 하나였거든.」
					PRINTFORMDW 네 뺨이 달아오르는 것을 느끼며, 당신은 얼버무린 대답을 더듬거리며 내뱉는다.
				CASE 1
					PRINTFORML 「음, 긴소쿄가 나를 잘 대해주는 것 같아.」
					PRINTFORMDW 마미조는 즐기고 있는 듯하고, 머지않아 너도 미소를 짓게 된다.
				CASE 2
					PRINTFORML 「여기로 이사 온 건 분명 옳은 선택이었어.」
					PRINTFORMDW 마미조가 나지막이 말하며 눈에 아련한 빛을 담는다.
			ENDSELECT
		ENDIF
	ELSE
		IF CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2)
			SELECTCASE RAND:2
				CASE 0
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『아, 요즘 좀 특이한 책들을 발견했어. 너도 관심 있어?』
					CALL SET_KOJO_COLOR(69)
					PRINTFORMW 「흠, 어쩌면 \@ CFLAG:MASTER:現在位置 == 280 ? 들러볼까. # 가서 들여다볼까. \@」
				CASE 1
					CALL SET_KOJO_COLOR(70)
					PRINTFORML 『안녕, 너희 둘은 언제나처럼 잘 지내는 것 같구나.』
					CALL SET_KOJO_COLOR(69)
					PRINTFORMW 「후후, 이제 그런 건가요? 궁금하네요.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「흠, 환상의 나라(겐소쿄)는 상당히 흥미로운 곳이군.」
				CASE 1
					PRINTFORMW 「바깥세상이라니? 사실 그렇게 이상한 건 아니야.」
				CASE 2
					PRINTFORMW 「솔직히 말해서, 환상향 밖에서는 인간이 요괴보다 더 무섭다.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
