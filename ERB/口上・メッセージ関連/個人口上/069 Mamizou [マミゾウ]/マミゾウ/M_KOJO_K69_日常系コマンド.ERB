;604,散策する
;==================================================

@M_KOJO_MESSAGE_COM_K69_604
;散策するにはTRAIN_MESSAGEが無い
;口上メイン呼出
IF FLAG:時間停止 || CFLAG:睡眠 || !CFLAG:同行 ;custom code
ELSE
	CALL M_KOJO_MESSAGE_COM_K69_604_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K69_604_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALL D_LINE ;custom code
	;Custom code
	PRINTFORMDL 당신은 %STR_TR(6000 + (CFLAG:MASTER:現在位置 / 10))%에 도착한다.
	IF FIRSTTIME("604A") && CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2)
		PRINTFORML 「헤이, 나 들어간다.」
		CALL SET_KOJO_COLOR(70)
		;todo - logical inconsistency if she saw you before?
		PRINTFORML 『아아, 어서 오세요... 아라, 두 분이 함께 계신 걸 전에는 본 적이 없네요.』
		CALL SET_KOJO_COLOR(69)
		IF 陥落状態() >= 4
			PRINTFORML 「후후, 우리는 제대로 된 커플이네.」
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『아, 정말 멋지다.』
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「우리는 좋은 친구야.」
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『잘 지내서 기쁘다.』
		ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORML 「우리는 그냥 아는 사이일 뿐이야.」
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『음, 그 이상인 것 같다...』
		ENDIF
		CALL SET_KOJO_COLOR(69)
		PRINTFORMDL 당신은 재빨리 인사를 건네고, 마미조와 코스즈는 즐겁게 담소를 나누기 시작한다.
		PRINTFORML 「후후, 이곳엔 언제나 흥미로운 것이 있단다. 너도 둘러보렴.」
		CALL SET_KOJO_COLOR(70)
		PRINTFORML 『당신의 미래에도 계속 이용해 주시기를 바랍니다.』
		PRINTFORMDL 코스즈가 최고의 비즈니스 미소를 지어주는 것을 보고, 당신도 미소로 화답하며 그녀에게 다시 한번 가볍게 고개를 숙인다.
		CALL SET_KOJO_COLOR(69)
		SETBIT CFLAG:1904,0
	ELSEIF CFLAG:MASTER:現在位置 == 280
		CALL SET_KOJO_COLOR(70)
		PRINTFORML 『환영한다. 아, 오늘 특이한 책을 찾았네.』
		CALL SET_KOJO_COLOR(69)
		PRINTFORML 「오호, 내 주의를 끌었군.」
		PRINTFORMDL 갑자기 할 일이 없어지자, 마미조와 코스즈가 잠시 대화하는 것을 지켜본다.
	ELSE
		PRINTFORML 「거닐면서 풍경을 감상하는 것도 좋았다.」
	ENDIF
ENDIF
RETURN 1
