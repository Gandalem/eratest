@M_KOJO_MESSAGE_COM_K69_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF BATHROOM()
		IF 陥落状態() >= 4
			PRINTFORML 「음, 여기도 씻어줄 수 있어?」
			PRINTFORMDL 마미조는 몸을 돌려 다리를 벌리고 손가락으로 %FSYN("vagina")%하며 가슴을 흔든다.
			PRINTFORML 「모든 구석구석 깨끗하게 청소해야 할 거야, 알겠지? 후와아! 푸후, 함께 목욕하는 거 정말 재미있네.」
			PRINTFORMDW 욕정을 다스리려 하며 마미조의 몸 구석구석을 청소한다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「음... 후후, 등에 누가 씻겨주는 건 꽤 편리하네.」
			PRINTFORMDW 두 사람은 마미조의 등 위로 욕조 물을 흘리며 서로 장난스럽게 미소 지었다.
			;ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORMW 「... 이상한 짓은 하지 않는 게 좋을 거야.」
		ENDIF
	ELSEIF CFLAG:MASTER:現在位置 == CFLAG:70:現在位置 && ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 == 220) || MAIN_MAP == 2)
		SIF ((MAIN_MAP != 2 && CFLAG:MASTER:現在位置 != 220) || (MAIN_MAP == 2 && CFLAG:MASTER:現在位置 != 213))
			PRINTFORMDL 두 분이 우연히 코스즈를 마주친다.
		IF 陥落状態() >= 4
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『두 분은 항상 즐거운 시간을 보내는 것 같네요.』
			CALL SET_KOJO_COLOR(69)
			PRINTFORML 「후후, 이게 바로 커플이 하는 거지. 그렇지, %MASTERNAME%?」
			PRINTFORMDW 마미조가 장난스럽게 웃고, 당신은 고개를 끄덕인다.
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『나 자신에게 말할 수 있는 누군가가 있었으면 좋겠어.』
			CALL SET_KOJO_COLOR(69)
			PRINTFORML 「책들이 당신의 취향인 연인 같군요.」
			PRINTFORMDW 마미조와 코스즈가 장난치는 모습을 어색하게 미소로 바라본다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「헤이, 그만해, 코스즈 앞에서 그러지 마.」
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『비록 네가 그것에 별로 신경 쓰지 않는 것 같지만...』
			PRINTFORMDW 코스즈는 앙탈을 부리는 마미조에게 장난스럽게 웃는다.
			CALL SET_KOJO_COLOR(69)
		ELSEIF 陥落状態() == 1
		ELSE
			CALL SET_KOJO_COLOR(70)
			PRINTFORML 『두 분 정말 잘 어울리시네요.』
			CALL SET_KOJO_COLOR(69)
			PRINTFORMW 「이 멍청이는 공공장소에서 절제할 수가 없군. 그만해.」
		ENDIF
	ELSEIF (TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)) || GET_TARGETNUM() >= 2
		IF 陥落状態() >= 4
			PRINTFORML 「후후, 이렇게 우리 관계를 과시하는 것이 묘하게 재미있네.」
			PRINTFORMDL 마미조는 당신에게 능글맞게 몸을 비비며 주변 사람들에게 못마땅한 시선을 받는다.
			PRINTFORML 「자, 서로 즐기자.」
			PRINTFORMDW 주변 사람들을 무시하고, 당신은 그녀의 허리를 감싸 안고 손을 움직인다. 그러자 그녀는 자신의 뺨을 당신에게 비빈다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「하아... 공공장소에서 그렇게 달라붙지 마, 이 바보야.」
			PRINTFORMDW 그녀의 불만에도 불구하고 마미조는 당신과 떨어지려 하지 않는다.
			;ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORML 「공공장소에서는 몸가짐을 단정히 하는 게 좋을 거야.」
		ENDIF
	ELSE
		IF 陥落状態() >= 4
			PRINTFORML 「... 우린 커플이잖아, 그렇게 부끄러워할 필요 없어, 알잖아?」
			PRINTFORMDL 그녀에게 약한 미소를 지으며, 너는 가벼운 스킨십으로만 계속 머물렀다.
			PRINTFORML 「알잖아, 그게 네가 할 전부라면, 내가 직접 널 밀어버릴 테니까.」
			PRINTFORMDW 그렇게 생각하며 함께 웃었다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「후훗, 그렇게 매달리는 거 귀엽잖아.」
			PRINTFORMDW 마미즈는 신체 접촉을 받아들이며 당신을 향해 미소 지었다.
			;ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORMW 「적당한 거리를 두자, 너무 달라붙지 마.」
		ENDIF
	ENDIF
ENDIF
RETURN 1
