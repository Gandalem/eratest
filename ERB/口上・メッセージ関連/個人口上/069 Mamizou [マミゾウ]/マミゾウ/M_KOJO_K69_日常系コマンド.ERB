;305,膝枕してもらう
;==================================================

@M_KOJO_MESSAGE_COM_K69_305
;口上メイン呼出
IF FLAG:70
ELSE
	CALL M_KOJO_MESSAGE_COM_K69_305_1
ENDIF
RETURN RESULT

@M_KOJO_MESSAGE_COM_K69_305_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORML 
	IF ABL:TARGET:親密 > 5
		IF 陥落状態() >= 4
			PRINTFORML 「후후후, 이렇게 내 무릎에 앉혀서 머리를 쓰다듬어 주는 거야. 우리가 전형적인 사랑꾼이 되려면 키스만 더 있으면 될 텐데.」
			PRINTFORMDL 마미조는 천천히 당신에게 얼굴을 가까이 가져가 속삭였다.
			PRINTFORML 「음? 어떻게 생각해?」
			PRINTFORMDW 당신은 달콤한 연인의 입맞춤을 기대하며 기다렸지만, 대신 그녀는 당신의 코끝에 키스했다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「... 음, 정말 편한가?」
			PRINTFORMDW 마미조가 자신의 무릎 위에서 아래를 내려다보는 것을 보며, 당신은 열렬히 동의한다.
			;ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORMW 「음? 후후, 이번 한 번만 그냥 해볼까.」
		ENDIF
	ELSEIF ABL:TARGET:親密 > 2
		IF 陥落状態() >= 4
			PRINTFORML 「후후, 어린아이 같네.」
			PRINTFORMDL 그녀가 부드럽게 머리를 쓰다듬자 당신의 표정은 자연스럽게 미소로 풀린다.
			PRINTFORML 「이런 것도 가끔은 나쁘지 않겠어.」
			PRINTFORMDW 마미조는 계속해서 당신의 머리를 쓰다듬으며 장난스럽게 미소 짓는다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「후후, 너 정말 귀엽다.」
			PRINTFORMDW 마미조는 당신의 머리를 부드럽게 쓰다듬으며 즐거워하는 것 같다.
			;ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORMW 「참 치정스러운 친구로군. 이리 와보렴.」
		ENDIF
	ELSE
		IF 陥落状態() >= 2
			PRINTFORML 「뭐야, 갑자기 이게...」
			PRINTFORMDW Mamizou의 허벅지가 긴장으로 인해 약간 뻣뻣하다.
			;ELSEIF 陥落状態() == 1
		ELSE
			PRINTFORMW 「어때?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
