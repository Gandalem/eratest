@M_KOJO_EVENT_K69_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF GETBIT(CFLAG:1690,3)
	LOCAL = 0
	SETBIT CFLAG:1690,3
ENDIF
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;特殊
	IF (ARG == 1 || ARG == 2 || ARG == 6) && (GETBIT(CFLAG:1690,0) || GETBIT(CFLAG:1690,1))
		;初遭遇が人里かつ、人里以外ではまだあってない
		IF GETBIT(CFLAG:1690,0) && (GET_MAPID(CFLAG:MASTER:現在位置) != 2)
			PRINTFORML 「Oh, %MASTERNAME:69%.」
			PRINTFORMDL 요괴 한 마리가 아무렇지도 않게 당신에게 말을 걸자, 당신은 의아해하며 고개를 기울였다.
			PRINTFORMDL %BREAKENG(@"전에 만난 적 없는, 둥근 테 안경과 모자 같은 커다란 나뭇잎 모양의 물건, 그리고 크고 복슬복슬한 꼬리를 가진 젊은 요괴 여성인 것 같다.")%
			PRINTFORML 「그런 표정은 뭐지? ... 아, 이렇게 된 적은 없었나 보네.」
			PRINTFORMDL 갑작스러운 연기 속에서 그 요괴는 마미조라고 인식할 수 있는 모습으로 변신했다.
			PRINTFORML 「이것으로 오해가 풀렸으면 좋겠군.」
			PRINTFORMDL 더 이상 아무 말 없이, 마미조는 원래의 모습으로 되돌아갔다.
			CLEARBIT CFLAG:1690,0
			;初遭遇が人里以外かつ、人里ではまだあってない
		ELSEIF GETBIT(CFLAG:1690,1) && (GET_MAPID(CFLAG:MASTER:現在位置) == 2)
			PRINTFORML 「오, %MASTERNAME:69%, 여기서 만나다니 우연이네요.」
			PRINTFORMDL 둥근 테 안경과 긴 머리에 작은 나뭇잎 모양의 장식을 한 매력적인 여인이 당신을 부른다.
			PRINTFORML 「... 무슨 표정이에요? 아, 이 모습은 처음 보셨군요.」
			PRINTFORMDL 그 여인은 우아하게 공중으로 도약했고, 순간 익숙한 마미조의 요괴 형태로 변신한다.
			PRINTFORML 「이것으로 설명이 되었으면 좋겠어요. 자, 현지인들 속에 섞이는 게 가장 좋을 거예요.」
			PRINTFORMDL 마미조가 가볍게 다시 발을 디디자, 당신은 그것이 최선이라고 동의한다.
			CLEARBIT CFLAG:1690,1
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF 陥落状態() >= 4
			;初回
			IF FIRSTTIME("EV1K")
				PRINTFORML 「%MASTERNAME:69%, 네가 여기 있구나.」
				PRINTFORMDL 마미조는 재빨리 너에게 다가와 널 끌어안는다.
				PRINTFORML 「뭐 때문에 얼굴이 빨개지는 거야, 이건 커플들이 하는 거지.」
				PRINTFORMDL 미소 지으며 웃는 마미조를 보며, 너는 작은 체념의 한숨을 내쉰다.
				PRINTFORML 「뭐야, 이거 신경 쓰여?」
				PRINTFORMDL 너는 그녀의 귀여움에 매료되었을 뿐이라고 말한다.
				PRINTFORMDL 이번에는 마미조가 얼굴을 새빨갛게 물리기 시작하고, 당황해서 서둘러 시선을 돌린다.
				PRINTFORML 「부-부끄럽다니까, 이 멍청아!」
			ELSE
				PRINTFORML 「오, %MASTERNAME:69%, 드디어 왔구나.」
				PRINTFORMDL 마미조가 당신에게 다가와 팔을 자신의 팔로 감싼다.
				PRINTFORML 「후후, 어떠니? 연인의 몸에서 느껴지는 온기는?」
				PRINTFORMDL 망설임 없이 당신은 그게 꽤 편하다고 말하고, 그녀는 얼굴을 붉히며 재빨리 시선을 돌린다.
			ENDIF
		ELSEIF 陥落状態() >= 2
			;初回
			IF FIRSTTIME("EV1R")
				PRINTFORML 「흠, 이거 상당히 난처한 상황이군.」
				PRINTFORMDL 당신이 의아해하며 고개를 기울이자 마미조는 느긋하게 미소를 지으며 당신에게 바짝 다가온다.
				PRINTFORML 「아, 아무것도 아니에요, 걱정하지 말아요.」
				PRINTFORMDL 그녀는 더욱 당신에게 가까이 몸을 기댄다.
				PRINTFORML 「후후, 정말로, 신경 쓸 필요 없어요.」
				PRINTFORMDL 마미조가 그렇게 행복하게 웃는 것을 보자, 당신은 이런 일도 나쁘지 않다고 생각한다.
			ELSE
				PRINTFORML 「후후, 나 보러 왔어?」
				PRINTFORMDL 마미조가 조금 기운을 차리는 것을 보고, 당신은 미소 지으며 고개를 끄덕인다.
			ENDIF
		ELSEIF 陥落状態() == 1
			;初回
			IF FIRSTTIME("EV1S")
				PRINTFORML 「오, %MASTERNAME:69%이 아니신가. 이쪽으로 오게나.」
				PRINTFORMDL 의아한 듯 고개를 기울인 채, 당신은 즐겁게 손짓하는 마미조를 따라간다.
				PRINTFORML 「평소 같으면 늦은 걸로 술을 더 시켰겠지만, 이번 한 번은 봐주지.」
				PRINTFORMDL 당신은 마미조가 왜 이렇게 기분이 좋은 건지 궁금해하며 가볍게 대답한다.
			ELSE
				PRINTFORML 「아, 여기 있었네. 이리 와, 부끄러워하지 마.」
			ENDIF
		ELSE
			PRINTFORML 「오, 네가 여기 있었구나.」
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF 陥落状態() >= 4
			;初回
			IF FIRSTTIME("EV1K")
				PRINTFORML 「후후, 네가 여기 있었구나. 아가씨를 그렇게 찾게 해서 미안해.」
				PRINTFORMDL 마미조는 갑자기 당신을 껴안으며 환하게 웃는다.
				PRINTFORML 「무슨 불만스러운 표정이야? 내가 귀찮게 하는 거야, 응?」
				PRINTFORMDL 그녀가 입술을 삐죽거리자, 당신은 그저 조금 부끄럽다고 말한다.
				PRINTFORML 「흥, 그런 걸로 부끄러워하다니, 네가 내 연인이라고 스스로 생각하는 거야?」
				PRINTFORMDL 당신이 대답하기도 전에 마미조는 당신의 얼굴을 자신의 가슴에 묻는다.
				PRINTFORML 「자, 이제 편하지 않아? 음?」
				PRINTFORMDL 편하다고 말하면서, 당신은 그녀의 품에서 빠져나가려고 몸부림친다.
			ELSE
				PRINTFORML 「오, 여기가 네가 있던 곳이구나.」
				PRINTFORMDL 순식간에 마미조는 너에게 다가와 안아버린다.
				PRINTFORML 「후훗, 연인이라는 건 확실히 장점이 있지 않나?」
				PRINTFORMDL 그렇게 말하며 그녀는 네 코끝에 가볍게 입을 맞춘다.
			ENDIF
		ELSEIF 陥落状態() >= 2
			;初回
			IF FIRSTTIME("EV1R")
				PRINTFORML 「오, 네가 있던 곳이 여기였구나. 후후, 내가 너를 데리러 왔어 %UNICODE(0x2764)%」
				PRINTFORMDL 어떤 이유에서인지 마미즈의 비정상적으로 명랑한 태도가 경계심을 갖게 했다.
				PRINTFORML 「%MASTERNAME:69%, 그런 표정을 짓는다고 좋은 일은 없을 거야, 알잖아?」
				PRINTFORMDL 즐겁게 웃으며 마미즈는 너에게 바짝 다가왔다.
				PRINTFORML 「이리 와서 차라도 좀 타줘, 적어도 말이야.」
				PRINTFORMDL 그녀는 유혹적인 눈빛을 보냈고, 너는 결국 그녀의 부탁에 굴복했다.
			ELSE
				PRINTFORML 「후후, 보러 왔어.」
				PRINTFORMDL 마미조가 그렇게 명랑한 표정으로 있는 것을 보고 당신도 미소로 응답했다.
			ENDIF
		ELSEIF 陥落状態() == 1
			;初回
			IF FIRSTTIME("EV1S")
				PRINTFORML 「이봐, 방문하러 왔어.」
				PRINTFORMDL 마미조는 밝게 웃으며 당신이 익숙한 것보다 조금 더 가까이 다가온다.
				PRINTFORML 「음, 사케를 마시고 싶은데, 차가 좀 겸손한 선택일지도 모르겠네.」
				PRINTFORMDL 당신은 그녀 쪽을 자주 흘겨보며 둘 다 괜찮다고 말한다.
			ELSE
				PRINTFORML 「아, 그래서 네가 여기 있었구나.」
			ENDIF
		ELSE
			PRINTFORML 「음? 아, 너였구나.」
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF 陥落状態() >= 4
			PRINTFORML 「... 알았어, 알았어, 계속해 봐. 내가 그렇게 볼 만한 흥미로운 존재일 거라고는 상상도 못 하겠지만.」
			PRINTFORMDL 그녀에게 네가 그녀가 아름답다고 생각한다고 말하자 마미조가 얼굴을 새빨갛게 물리기 시작한다.
			PRINTFORML 「나를 그렇게 놀리다니... 참 대담한 어린애로군.」
			PRINTFORMDL 혼잣말을 중얼거리며, 마미조는 너에게 자신의 몸을 숨기려는 노력을 하지 않는다.
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「뭐야, 내가 그렇게 볼 만하게 흥미로운 존재인가?」
			PRINTFORMDL 그녀에게 당신이 그녀가 아름답다고 말하자, 그녀는 당신을 향해 눈을 굴린다.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「... 아, 벌써 누군가 있네. 미안해.」
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「여기서 당장 나가! 저리 가!」
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF 陥落状態() >= 4
			;初回
			IF FIRSTTIME("EV1K")
				PRINTFORML 「후후, 여기서 만나다니, %MASTERNAME:69%!」
				PRINTFORMDL 마미조의 얼굴이 환해지며 당신에게 달려와 꼭 안는다.
				PRINTFORML 「음? 뭘 그렇게 부끄러워하는 거야? 정말 우리가 노출되는 게 그렇게 걱정돼?」
				PRINTFORMDL 당신은 그녀의 질문에 응하며 크게 한숨을 내쉰다.
				PRINTFORML 「%MASTERNAME:69%, 우리 연인 아니었어?」
				PRINTFORMDL 당신은 망설임 없이 그녀에게 그렇다고 말한다.
				PRINTFORML 「그럼 그런 건 걱정하지 마, 바보야.」
				PRINTFORMDL 그렇게 말하며 그녀는 당신의 코끝에 가볍게 입을 맞춘다.
			ELSE
				PRINTFORML 「오, 정말 우연이네, 오늘 좋은 날인 것 같아.」
				PRINTFORMDL 마미조가 빠르게 당신에게 다가와 당신을 세게 안는다.
				PRINTFORML 「뭐야, 부끄러워? 별일 아닌데 뭘 그래.」
				PRINTFORMDL 그렇게 말하며 그녀는 당신을 더욱 세게 안았다.
			ENDIF
		ELSEIF 陥落状態() >= 2
			;初回
			IF FIRSTTIME("EV1R")
				PRINTFORML 「오, 오늘 당신을 만날 줄은 몰랐는데, 운명에 묶인 모양이군요.」
				PRINTFORMDL 마미조는 당신의 팔에 팔을 두르며 즐겁게 웃었다.
				PRINTFORML 「흥? 그냥 이렇게 하고 싶었을 뿐이에요. 좀 더... 사적인 곳으로 갈까요?」
				PRINTFORMDL 당신은 그녀가 자신을 초대해 준 것에 기쁘지만, 먼저 생각해 볼 시간이 필요하다고 말한다.
				PRINTFORML 「흥, 아가씨의 초대를 거절하다니, 주제를 알아야지.」
				PRINTFORMDL 마미조는 마지못해 당신에게서 떨어지며 쓸쓸한 미소를 지었다.
			ELSE
				PRINTFORML 「오, 내가 떠나려 할 때 마주치다니. 후후, 오늘 좋은 날이 될 것 같네.」
				PRINTFORMDL 왜 그런지 너무 깊게 캐묻지 않기로 결정한다...
			ENDIF
		ELSEIF 陥落状態() == 1
			;初回
			IF FIRSTTIME("EV1S")
				PRINTFORML 「오, 여기서 만나다니.」
				PRINTFORMDL 마미조가 밝은 표정으로 당신에게 다가온다.
			ELSE
				PRINTFORML 「후후, 우연이네. 좀 더... 사적인 곳으로 갈까?」
			ENDIF
		ELSE
			PRINTFORML 「음? 아, %MASTERNAME:69%, 너였구나.」
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF ARG:1 == 70
			IF FIRSTTIME("EV1C")
				PRINTFORML 「오늘 너를 보게 될 줄은 몰랐어.」
				SETCOLOR 0xEE827C
				PRINTFORML 『아, 음, 죄송해요.』
				SETCOLOR 0xF4A460
				PRINTFORML 「아니, 아니야, 네 잘못이 아니야. 난 네가 나쁜 의도를 가지고 있지 않다는 걸 알아.」
				PRINTFORMDL 그렇게 말하며 그녀는 너에게 날카로운 눈빛을 보낸다.
				PRINTFORML 「... 알겠어. 하지만 그녀에게 무슨 장난이라도 치려고 생각하는 건 현명하지 않을 거야.」
				PRINTFORMDL 등골에 소름이 돋자 너는 서둘러 고개를 끄덕인다.
			ELSE
				IF 陥落状態() >= 4
					PRINTFORML 「… 네가 연인보다 코스즈의 동반을 더 선호하는 걸 보니, 내 심기가 조금 불편해지네.」
					SETCOLOR 0xEE827C
					PRINTFORML 『아, 음...』
					PRINTFORMDL 마미조의 짜증 난 표정과 코스즈가 움츠러드는 모습을 번갈아 보다가 갑자기 마미조의 어깨를 잡는다.
					SETCOLOR 0xF4A460
					PRINTFORML 「뭐 하는 거야, 이 멍청아?! %RANDLIPS(,"kiss")%... 뭐, 그만둬... 추우...」
					SETCOLOR 0xEE827C
					PRINTFORML 『하아... 정말 흥미진진해...』
					SETCOLOR 0xF4A460
					PRINTFORMDL 당신이 강제로 마미조의 입술을 빼앗자, 어쩐 일인지 코스즈가 당신을 집중해서 지켜보고 있다...
				ELSEIF 陥落状態() >= 2
					PRINTFORML 「하아... 너무 오래 머무르면 %HIM_HER(MASTER,,1)%의 무례함이 너에게도 스며들 테니.」
					SETCOLOR 0xEE827C
					PRINTFORML 『그럼 같이 갈까? 많을수록 좋지.』
					PRINTFORMDL 코스즈의 제안에 너와 마미조는 짧게 눈을 맞추고 서로에게 희미하게 미소 지었다.
					SETCOLOR 0xF4A460
				ELSEIF 陥落状態() == 1
					PRINTFORML 「... 코스즈, 나는 %HIM_HER(MASTER,,1)% 같은 사람들과 너무 많은 시간을 보내지 않는 것을 추천한다.」
					SETCOLOR 0xEE827C
					PRINTFORML 『후후, 당신의 조언을 고려해 볼게요.』
					SETCOLOR 0xF4A460
				ELSE
					PRINTFORML 「흠, 참 이상한 한 쌍이군.」
					SETCOLOR 0xEE827C
					PRINTFORML 『음, %HE_SHE(MASTER)%도 단골이군.』
					SETCOLOR 0xF4A460
				ENDIF
			ENDIF
		ELSEIF 陥落状態() >= 4
			PRINTFORML 「... 연인의 여자를 가까이 두다니.」
			PRINTFORMDL 마미조는 고통스럽고 무거운 목소리로 말을 내뱉는다.
			PRINTFORML 「연인 대신 여자와 시간을 보내다니... 당신이 이런 사람이리라곤 몰랐어, %MASTERNAME:69%.」
			PRINTFORMDL 입술을 굳게 다문 채 상처받은 표정으로 그녀는 고개를 숙이고 당신에게 %CALLNAME:(ARG:1)%...
		ELSEIF 陥落状態() >= 2
			PRINTFORML 「... 뭐, 나한테 무슨 의무도 없잖아, 그러니까 막을 수도 없는 거겠지.」
			PRINTFORMDL 마미조는 당신과 %CALLNAME:(ARG:1)%에게 짧게 목례를 하고 쓸쓸한 표정으로 등을 돌린다...
		ELSEIF 陥落状態() == 1
			PRINTFORML 「오, 데이트 중에 너를 잡았나? 음, 인기 많네.」
		ELSE
			PRINTFORML 「음? 아, %MASTERNAME:69%인가? 아, 미안해, 방해하는 것 같네.」
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
