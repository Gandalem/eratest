;==================================================

@M_KOJO_MESSAGE_COM_K173_90
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K173_90_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K173_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「항문에 대다니...?」
		PRINTFORMW 선대의 거친 손가락이 %조사처리(CALLNAME:MASTER,"의")% 항문에 들어가 직장 안에서 휘저었다...
		PRINTFORMW 「응... 역시 아직 익숙하지 않네.」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「아직 좀 익숙하지 않지만……」
		PRINTFORMW 선대의 거친 손가락이 %조사처리(CALLNAME:MASTER,"의")% 항문에 깊숙이 들어갔다…
		PRINTFORMW 「하지만 네 항문 감촉이 너무 좋아……」
		PRINTFORMW 갑작스러운 이물감에 %조사처리(CALLNAME:MASTER,"는")% 본능적으로 몸을 비틀어 도망치려 했지만 선대에게 붙잡혀 더욱 깊이 파고들었다…
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「……하지만 말이야……」
		PRINTFORMW 「너의 항문은 내가 가지고 놀았던 최고의 구멍이야……」
		PRINTFORMW 전임자가 손가락을 %조사처리(CALLNAME:MASTER,"의")% 항문에 넣었다……
		PRINTFORMW 너무 깊어, 너무 깊어.
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 힘없이 몸부림치다가 오히려 전임자의 흥미를 자극했다……
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「엉덩이에 와라……」
		PRINTFORMW 「……됐어……」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
