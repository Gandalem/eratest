; Modular ERB: 個人口上/173 Sendai Hakurei [先代]/【158】先代/M_KOJO_K158_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K173_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
ENDIF
;-------------------------------------------------
;小分岐
;-------------------------------------------------
;戦闘前
HANDICAP_FIXED = 0
HANDICAP_RAND = 0
;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘前"
	IF ALCOHOL_FACE([[Sendai]]) == "酔酒" || ALCOHOL_FACE([[Sendai]]) == "不省人事"
		PRINTFORMW 「탄막 게임...? 그럼 시작하자」
		PRINTFORMW 취한 선대는 의외로 침착했다.
	ELSEIF TALENT:[[Sendai]]:15 == -1 || CFLAG:[[Sendai]]:ブチギレ || MARK:[[Sendai]]:反発刻印 >= 3
		PRINTFORMW 「탄막 게임? 시작해, 대가는」
		PRINTFORMW 「너의 생명이다.」
		PRINTFORMW 선대는 냉담하게 %조사처리(CALLNAME:MASTER,"를")% 바라보았다. 선대의 주먹 아래 죽어가는 요괴들의 비명이 귓가에 메아리치는 듯했다...
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 선대 갑자기 %조사처리(CALLNAME:MASTER,"의")% 뒤에 나타났다.
				PRINTFORMW 「뒤를 조심해! 탄막 게임은 외부의 작은 놀이처럼 간단하지 않아!」
			CASE 2
				PRINTFORMW 「나의 탄막 기술을 네 몸으로 받아라」
				PRINTFORMW 선대는 일부러 심각하게 %조사처리(CALLNAME:MASTER,"를")% 바라봤다...
			CASEELSE
				PRINTFORMW 「위력이 큰 공격은, 맞히지 못하면 아무 의미가 없다!」
		ENDSELECT
	ENDIF
	RETURN 0
ENDIF
;-------------------------------------------------
;ハンデ
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "ハンデ"
	;ハンデつけなかったら表示されないので無記入でよい
	PRINTFORML 
	RETURN 0
ENDIF
;-------------------------------------------------
;戦闘中TARGET被弾時口上
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
;戦闘中
;被弾、残り残機2
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "被弾" && 相手残機 == 2
	;勝利済みフラグ
	IF CFLAG:[[Sendai]]:1800
		PRINTFORML 「아주 좋아, 네 모든 실력을 발휘해 봐」
		PRINTFORML 「이기고 싶다면 마음껏 전력을 다해 봐」
	ELSE
		PRINTFORML  「이젠 진지해져야겠어.」
		PRINTFORMW 선대는 영력을 모두 오른손에 모았고, 마치 불타오르는 것 같았다.
		PRINTFORML 「내 오른손이 활활 타오르고 있어! 승리를 붙잡으라고 외치고 있어!」
		PRINTFORMW 조금의 거리%CALLNAME:MASTER%만 있어도 그 뜨거움을 느낄 수 있었다.
		PRINTFORMW 「폭열·하쿠레이 신장! 받아라!」
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;被弾、残り残機1
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "被弾" && 相手残機 == 1
	;勝利済みフラグ
	IF ABL:MASTER:戦闘能力 < 4
		PRINTFORMW 「유파·동방불패!」
		PRINTFORMW 선대 전신 근육이 긴장하며, %CALLNAME:MASTER%도 자신도 모르게 긴장했다.
		PRINTFORMW 「왕자의 풍모! 새로운 시리즈!」
		PRINTFORMW 선대의 주먹에서 눈부신 빛이 뿜어져 나왔고, 주변 공기마저 뒤틀렸다.
		PRINTFORMW 「천파(天破), 협란(侠乱)!」
		PRINTFORMW 그 찬 금빛은 하늘마저 진홍빛으로 물들였다.
		PRINTFORMW 「보아라! 동방이 선명하게 타오르고 있다!」
		PRINTFORMW 그리고 선대는 그 주먹을 휘둘렀다.
		PRINTFORMW 「내 손은 선홍색 불꽃처럼 뜨겁다!」
		PRINTFORMW 「마지막 일격! 필살! 석파(石破)! 천경(天惊)—권!」
	ELSE
		PRINTFORML 「최종 패배자는 누구인지, 곧 밝혀질 것이다!」
		PRINTFORMW 「유파·동방불패!」
		PRINTFORMW 선대는 온몸의 근육이 긴장하며, %CALLNAME:MASTER%도 자신도 모르게 긴장했다.
		PRINTFORMW 「왕자의 기상! 새로운 시리즈!」
		PRINTFORMW 선대의 주먹에서 눈부신 빛이 뿜어져 나왔고, 주변 공기마저 일그러졌다.
		PRINTFORMW 「하늘을 깨고, 협객들이 난무한다!」
		PRINTFORMW 그 찬란한 금빛은 하늘까지 진홍색으로 물들였다.
		PRINTFORMW 「보아라! 동방이 선홍색으로 타오르고 있다!」
		PRINTFORMW 그리고 선대는 그 주먹을 휘둘렀다.
		PRINTFORMW 「나의 손은 선홍빛 불꽃처럼 뜨겁다!」
		PRINTFORMW 「마지막 일격! 필살! 석파! 천경—권!」
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;被弾、残り残機0
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "被弾" && 相手残機 == 0
	;勝利済みフラグ
	IF CFLAG:[[Sendai]]:1800
		PRINTFORML 「정말... 멋진 전투였어」
	ELSE
		PRINTFORML 「역시…… 시대는 신인들에 의해 개척되는 거구나.」
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【残忍酷薄】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "残忍酷薄"
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【乾坤一擲】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "乾坤一擲"
	IF 相手残機 == 3
		PRINTFORML 「아주 좋아! 이 기세로 계속 싸워나가자!」
	ELSEIF 相手残機 == 2
		PRINTFORML 「부... 이렇다는 거야, 네 결의.」
	ELSEIF 相手残機 == 1
		PRINTFORML 「최종 패배자는 누가 될지, 곧 알게 될 것이다!」
		PRINTFORMW 선대는 영력을 모두 오른손에 모았고, 마치 불타오르는 듯했다.
		PRINTFORML 「내 오른손이 활활 타오르고 있다! 승리를 잡으라고 외치고 있어!」
		PRINTFORMW 「폭열·하쿠레이 신장의 기술이다! 받아라!」
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【怪力乱神】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "怪力乱神"
ENDIF
;-------------------------------------------------
;戦闘後
;先代の残機3
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後" && 相手残機 == 3
	;勝利済みフラグ
	IF CFLAG:[[Sendai]]:1800
		PRINTFORMW 네 실력, 이 정도밖에 안 될 리가 없잖아……
	ELSE
		PRINTFORMW 「더 많이 단련해야 한다.」
	ENDIF
	IF TALENT:[[Sendai]]:恋人 || TALENT:[[Sendai]]:恋慕
		PRINTFORMW 「사실... 네가 걸어야 할 길은 아직 아주 멀어.」
		PRINTFORMW 「나도 언제 그 시대로 돌아갈지 모르겠어... 그러니, 그 순간이 오기 전에... 내가 너에게 싸우는 법을 가르쳐 줄게.」
		CALL CHANGE_CFLAG(2, TARGET, 50)
	ELSE
		PRINTFORMW 「지는 자에게도 패배자의 모습이라는 게 있어야지……. 청주 한 잔 사면 끝이야.」
		PRINTFORMW 선대분은 전혀 개의치 않는 듯하다…….
		CALL GET_ITEM("清酒", 1, 1)
		CALL CHANGE_CFLAG(2, TARGET, 10)
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘後
;先代の残機2
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後" && 相手残機 == 2
	;勝利済みフラグ
	IF CFLAG:[[Sendai]]:1800
		PRINTFORMW 「약간의 실력은 있지만, 많지는 않아.」
		PRINTFORMW 선대로 농담을 했다.
	ELSE
		PRINTFORMW 「하지만... 너의 발전 가능성은 아직 크다고.」
	ENDIF
	IF TALENT:[[Sendai]]:恋人 || TALENT:[[Sendai]]:恋慕
		PRINTFORMW 「그렇구나……아직 조금 부족하지만, 너의 힘이라면 이 세계에서 잘 살아갈 수 있을 거야,」
		PRINTFORMW 선대는 무언가 말하려 한 듯했지만…… 그저 씁쓸한 표정으로 잠시 멈췄다.
		PRINTFORMW 「나도 내가 언제 그때로 돌아갈지 모르겠어…… 그렇다면, 그전에, 너를 더 강한 사람으로 가르쳐 줄게…… 뭔가 질문 있니?」
		PRINTFORMW 상처투성이의 주먹을 통해, %CALLNAME:MASTER%홀로 싸워 피 흘리며 길을 개척했던 선대를 본 듯했다…….
	ELSE
		PRINTFORMW 「점수 차가 크지만, 이 정도까지 해낸 건 꽤 대단하네요. 다음에도 힘내세요.」
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘後
;先代の残機1
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後" && 相手残機 == 1
	;勝利済みフラグ
	IF CFLAG:[[Sendai]]:1800
		PRINTFORMW 「너의 성장은 정말 눈에 띄게 빠르구나.」
	ELSE
		PRINTFORMW 「이 정도... 너도 한 번도 포기하지 않았지, 수고했어」
		CALL AddEXP("戦闘経験", TARGET, 15)
	ENDIF
	PRINTFORML 「승자의 보상... 그런 건 사실 별로 관심 없네」
	IF TALENT:[[Sendai]]:恋人 || TALENT:[[Sendai]]:恋慕
		PRINTFORMW 「너를 기다리고, 너를 나보다 앞서도록 지켜볼 거야」
	ELSE
		PRINTFORMW 「너와 싸우는 것도 즐거운 일이야.」
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘後
;先代の残機0
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後" && 相手残機 == 0
	;勝利済みフラグ
	IF CFLAG:[[Sendai]]:1800
		PRINTFORML 「네 실력은 벌써 충분히 강해졌구나……」
	ELSE
		PRINTFORMW 「에? 승자의 보상이라니?」
		PRINTFORML 「아……. 괜찮아. 네가 원하는 게 뭔데?」
		$INPUT_LOOP2
		RESETCOLOR
		CALL ASK_M("그냥 그만두자",1,"돈",1,"패",1,"팡츠",1,"사랑",1)
		LOCAL:2 = RESULT
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「그렇다면 이것을 네게 주어 체력을 회복하도록 해 주지.」
				CALL GET_ITEM("大回復薬", 2, 1)
				RESETCOLOR
				RETURN -1
			CASE 1
				IF TALENT:[[Sendai]]:恋人 || TALENT:[[Sendai]]:恋慕
					PRINTFORMW 「……돈?……」
					PRINTFORMW 선대는 드물게 난처한 표정을 지었지만, 금세 평소대로 돌아왔다.
					PRINTFORMW 「필요하다면 줄 수 있어, 네가니까」
					PRINTFORMW 선대는 주머니에서 돈을 조금 꺼내 %조사처리(CALLNAME:MASTER,"에게")% 건넸다.
					PRINTFORMDW \\2500원 얻음
					MONEY += 2500
					PRINTFORMW 「하지만, 이상한 물건들은 사지 마.」
				ELSE
					PRINTFORMW	「돈? 어...」
					PRINTFORMW  선대는 난처한 표정으로 지갑을 뒤지더니, 탁 소리를 내며 돈 한 뭉치를 꺼낸다.
					PRINTFORMW  「죄송해요... 저도 자금 출처가 없어서요...」
					PRINTFORMDW \\1000전 얻는다
					MONEY += 1000
					PRINTFORMW 「다른 요괴들을 계속 약탈하던 무녀마저 당하다니……」
				ENDIF
				TCVAR:[[Sendai]]:398 = 1
				RETURN 1
			CASE 2
				PRINTFORML 「칩? 그게 뭐야... 잠시만... 나 뭔가 주운 적이 있는 것 같은데」
				SETCOLOR C_GREEN
				PRINTFORMW 10cm의 칩을 얻었다.
				RESETCOLOR
				MONEY:2 += 10
				TCVAR:[[Sendai]]:398 = 2
				RETURN 1
			CASE 3
				IF TALENT:[[Sendai]]:恋人 || TALENT:[[Sendai]]:恋慕 || TALENT:[[Sendai]]:愛欲
					PRINTFORMW 「팬티...? 안 되는 건 아니야. 네 요구라면 나도 상관없지만...」
					PRINTFORMDL %CALLNAME:MASTER%치마를 말아 올리고 보지 쪽을 이쪽으로 향하게 하여 팬티를 벗으라는 명령을 내렸고 선대는 무표정하게 따랐다%조사처리(CALLNAME:MASTER,"의")% 명령대로 그저 소중한 곳을 이쪽으로 향하게 하여 천천히 팬티를 벗었다, 비록 선대의 표정은 차분했지만 그 붉은 기는 그녀의 내면을 드러냈다
					PRINTFORMW 「후우... 이렇게 하면 될까요?」
					PRINTFORMDW 팬티가 벗겨지며 작은 구멍이 드러나자, %조사처리(CALLNAME:MASTER,"는")% 순간 선대의 작은 구멍을 응시한다.
					PRINTFORMW 「……」
					PRINTFORMW 선대가 애써 태연한 척하고 있다는 것이 훤히 보였다.
					PRINTFORMDL 선대는 %PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%을 완전히 벗은 뒤, %조사처리(CALLNAME:MASTER,"로")% 그녀의 분홍빛으로 촉촉이 젖은 소음부를 계속 집요하게 훔쳐보고 있었다. 그 표정은 보고 나면 멀쩡히 서서 떠나기 힘들 정도였다.
					PRINTFORMDW 선대는 벗은 %PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%을 얌전히 건네왔다……
				ELSE
					PRINTFORMW 「팬티……? 취향이 좀 특이하네……」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 치마를 걷어 올리고 작은 구멍이 이쪽을 향하도록 팬티를 벗으라는 명령을 내렸고, 선대는 무표정하게 팬티를 벗었다.
					PRINTFORMDW 선대는 그렇게 이쪽을 노려보며 거리를 둔 뒤, 치마를 이쪽으로 뒤집어 올려 안쪽의 %PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%를 드러냈다.
					PRINTFORMW 「내기에서 졌으니 어쩔 수 없지…… 그냥 가져가면 돼」
					PRINTFORMDW 선대는 한숨을 내쉬고, 한 손으로 매끈한 다리에서 %PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%를 천천히 벗겨 내렸다. %조사처리(CALLNAME:MASTER,"는")% 아무렇지도 않은 선대의 모습을 보자 갑자기 맥이 빠지는 것을 느꼈다.
					PRINTFORML 「보지를 보는 건 추가 서비스야…… 보수는 따로 지불해야 하는데?」
					PRINTFORMDW 팬티를 내리자 보지가 드러났고, 보지가 보이는 순간 %조사처리(CALLNAME:MASTER,"는")% 그곳을 뚫어져라 바라보았다. 선대는 그 시선을 무시한 채 계속 팬티를 벗었다.
					PRINTFORMDL 선대가 %PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%를 완전히 벗을 때까지, %조사처리(CALLNAME:MASTER,"는")% 그녀의 분홍빛으로 축축한 보지를 줄곧 집요하게 바라보았다.
					PRINTFORMDW 선대는 벗어 낸 %PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%를 %조사처리(CALLNAME:MASTER,"에게")% 묵직하게 건넸다
				ENDIF
				;兜襠布でも怒らないでね
				PRINTFORMDW %CALLNAME:MASTER%선대의%PANTSNAME(EQUIP:[[Sendai]]:6, [[Sendai]])%를 얻었다!
				RESETCOLOR
				CALL PANTS_GET([[Sendai]], "收下")
				SIF FLAG:口上色
					TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
				PRINTFORMW 「가져갔으면 어서 가거라, 내가 더 화내기 전에.」
			CASE 4
				IF TALENT:[[Sendai]]:恋人 || TALENT:[[Sendai]]:恋慕
					PRINTFORMW 「……사랑?……」
					PRINTFORMW 선대는 미소 지으며 %조사처리(CALLNAME:MASTER,"를")% 바라본다.
					PRINTFORMW 「언제든지 괜찮아.」
					PRINTFORMW 선대가 %조사처리(CALLNAME:MASTER,"를")% 안는다.
					PRINTFORMW 선대에게서 나는 은은한 향기와 땀 냄새가 뒤섞여, %조사처리(CALLNAME:MASTER,"의")% 욕망을 자극한다.
					PRINTFORMW 「하지만 지금 밖에선 곤란해……」
					PRINTFORMW  선대는 %조사처리(CALLNAME:MASTER,"의")% 머리를 감싸 안아, %조사처리(CALLNAME:MASTER,"의")% 얼굴이 부드러움을 충분히 느끼게 한다.
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 호흡이 거칠어진다.
					PRINTFORMW 선대는 손을 %조사처리(CALLNAME:MASTER,"의")% 등에 대고 주무르기 시작한다.
					PRINTFORMW 「수고 많았지? 스트레스 좀 풀어봐.」
					PRINTFORMW 등 쪽은 여전히 거칠었지만, 어딘가 부드러운 느낌이 있었고, 선대의 마사지에 %조사처리(CALLNAME:MASTER,"는")% 편안하게 신음을 흘린다.
					PRINTFORMW 선대가 약간 이상한 숨소리를 내는 것을 듣고, %조사처리(CALLNAME:MASTER,"는")% 고개를 들어 바라본다.
					PRINTFORMW 선대 전신에서 금빛 광채가 뿜어져 나왔고, 이 빛이 %조사처리(CALLNAME:MASTER,"의")% 피로를 씻어준다...
					PRINTFORMW 「하고 싶은 건 집에 가서 얘기하자.」
					PRINTFORMW 선대는 무언가를 감지한 듯하다.
					PRINTFORMW 「지금, 나 좀 더 안아줘.」
					PRINTFORMW 따뜻한 햇살과 산들바람의 배경 아래, %조사처리(CALLNAME:MASTER,"의")% 욕망은 많이 가라앉는다...
					PRINTFORMW 정말로, 계속 이렇게 있고 싶다...
					CALL RECOVER(MASTER, 1000, "体力", "선대의 독특한 마사지")
				ELSE
					PRINTFORMW	「사랑...?」
					PRINTFORMW  선대는 잠시 생각하더니 %조사처리(CALLNAME:MASTER,"를")% 품에 안는다.
					PRINTFORMW  「응... 괜찮아.」
					PRINTFORMW  선대는 손가락 끝으로 %조사처리(CALLNAME:MASTER,"의")% 배를 누른다.
					PRINTFORMW 선대의 몸은 매우 부드러웠고 특별한 향이 있었다.
					PRINTFORMW 손가락에 들어가는 힘도 딱 적당했다.
					PRINTFORMW  %조사처리(CALLNAME:MASTER,"는")% 자신의 피로가 사라지는 것을 느낀다.
					PRINTFORMW 선대의 몸에서 나는 따스함, 선대의 몸의 부드러움이 모두 %조사처리(CALLNAME:MASTER,"를")% 빠지게 한다...
					PRINTFORMW 「이것이 바로... 나의 사랑이야.」
					PRINTFORMW 따스한 햇살 아래서, 선대는 마치 오랫동안 보지 못했던 어머니 같았다.
					PRINTFORMW 선대는 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬으며 부드럽게 %조사처리(CALLNAME:MASTER,"를")% 바라본다...
					CALL RECOVER(MASTER, 500, "体力", "선대의 독특한 마사지")
				ENDIF
				RESETCOLOR
				RETURN 1
				;勝負済みフラグをオン
				CFLAG:[[Sendai]]:1801 = 1
				;勝利済みフラグをオン
				CFLAG:[[Sendai]]:1800 = 1
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
