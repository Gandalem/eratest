;快楽刻印
IF TFLAG:23 == 1
	CALL HPH_PRINT(@"「아...후우. 이게 처음이야... 느껴봐... 후우」", "L")
	CALL HPH_PRINT(@"「더... 더 많이, 더 많이 HPH!」", "L")
ELSEIF TFLAG:23 == 2
	CALL HPH_PRINT(@"「아아아아아아악! 잠깐...흐으, 안 돼... 흐으, 나 가버려... 다시 가고 있어! 머리가 미쳐가고 있어...」", "L")
	CALL HPH_PRINT(@"「내 머리가 아파... 아아아아아아아아아아아아아아!!!」", "L")
	PRINTFORMDW 사쿠야가 비명을 지르며 의식을 잃었다. 강렬한 쾌감이 그녀의 뇌를 단락시킨 것 같다.
ELSEIF TFLAG:23 == 3
	CALL HPH_PRINT(@"「하아아.... HPH 더는 없어... HPH 너무 많이 싸서 죽을 것 같아 HPH 멈출 수가 없어... 싸는 걸 멈출 수 없어 HPH! 아아아아 HPH!」", "L")
	PRINTFORMW (아, 이제 끝인 것 같아.)
	CALL HPH_PRINT(@"「아아아아흐읍.... 아으... 아... 아흡... 윽... 응...흐읍」", "L")
	PRINTFORMDW 사쿠야의 눈이 뒤집히며 그녀는 다리를 넓게 벌린다. 그녀의 입에서 나오는 소리는 더 이상 알아들을 수 없게 되었다.
ENDIF
;不埒刻印
;快楽による刻印 ＆ 屈服、恭順による刻印
;LV1
IF TFLAG:24 == 11 || TFLAG:24 == 31
	PRINTFORMW 「아, 마스터?!」
	PRINTFORMDW 어떤 이유에선지 사쿠야는 당신을 바라보며 미간을 살짝 찌푸렸다.
	PRINTFORMW (레밀리아님 말고 '마스터'라고 부를 뻔했어... 그게... 그럴 리가...)
	;LV2
ELSEIF TFLAG:24 == 12 || TFLAG:24 == 32
	PRINTFORMW 「%CALLNAME:MASTER%-sama, 여기 차가 있습니다.」
	PRINTFORMDW 사쿠야의 태도는 이상하게 굴복적이다, 마치 주인에게 봉사하는 메이드처럼.
	PRINTFORMW (나... 아직 인정하지 않았다.... 적어도 소리 내지는 않겠지만...)
	;LV3
ELSEIF TFLAG:24 == 13 || TFLAG:24 == 33
	CALL HPH_PRINT(@"「마스터, 꼭 화장실을 사용해야 한다면 저를 대신 이용해주세요! 소변이든 정액이든 마지막 한 방울까지 제가 치우겠습니다HPH」", "L")
	CALL HPH_PRINT(@"「이제부터는 개인적인 성적 해소 메이드인 사쿠야를 영원히 이용해라...HPH」", "L")
ENDIF
