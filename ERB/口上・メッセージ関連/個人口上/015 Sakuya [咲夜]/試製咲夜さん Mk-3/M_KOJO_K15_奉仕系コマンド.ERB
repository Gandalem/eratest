;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K15_80
CALL M_KOJO_MESSAGE_COM_K15_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K15_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 제때 멈추고 당신은 백조의 목처럼 가늘고 고운 사쿠야의 섬세한 손에 자신의 성기를 문지른다.
		PRINTFORMDL 그녀의 부드럽고 우아한 손바닥을 탐닉할 생각에 매우 흥분된 채,
		PRINTFORMDW 당신은 더 많은 쾌감을 즐기기 위해 그녀의 손가락으로 자신의 전체를 움켜쥐도록 더욱 감싼다...
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「손으로 하고 싶어?」
		PRINTFORMDW 사쿠야는 양손에 침을 바르고 즉시 한 손으로는 네 성기를 잡고 다른 한 손으로는 고환을 주무른다.
		PRINTFORMDW 게다가 그녀는 입을 벌려 네 귀두를 핥는다...
		PRINTFORMW 「음... 언제든지 싸도 돼, 알잖아...」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		CALL HPH_PRINT(@"「수음? 이해한다HPH」", "L")
		PRINTFORMDW 사쿠야는 네 봉에 침을 흘리며 손으로 그것을 만지고, 정교한 힘으로 다룬다. 
		PRINTFORMDW 만족하지 못한 그녀는 입을 벌려 혀로 네 귀두를 애무하기 시작한다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「수음... 알겠어.」
		PRINTFORMDL 사쿠야는 침을 양손에 바르고 한 손으로 네 성기를 잡으며 다른 손으로는 네 고환을 주무르기 시작한다. 
		PRINTFORMDW while kneading your testicles with the other.
		PRINTFORMW 「...」
		PRINTFORMDW 사쿠야는 아무렇지도 않게 당신의 억눌린 욕정을 풀어준다...
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K15_81
CALL M_KOJO_MESSAGE_COM_K15_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K15_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 사쿠야의 입을 오나홀로 사용하기로 결정하고, 당신은 그녀의 턱을 잡고 시간이 멈춘 동안 그녀의 입을 벌렸다.
		PRINTFORMDW 아무런 고려 없이 당신이 그녀의 입속으로 성기를 밀어 넣자, 그녀의 보호받지 못한 혀가 당신의 성기를 맞았다.
		PRINTFORMDW 당신의 성기는 조이고 미끄러운 느낌과 약간의 끈적임이 있는 사쿠야의 부드러운 오나홀 입을 즐기며 움찔거렸다...
		PRINTFORMDW 신경 쓰지 않고, 당신은 마치 자신의 골반을 그녀의 얼굴에 부딪치려는 것처럼 사쿠야의 목을 강간했다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF PREVCOM == 81
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT(@"「쥬루호프 쥬루호프 레로호프」", "L")
					PRINTFORMDW 사쿠야는 모든 것을 바치며 당신의 성기를 페라치오한다.
				CASEELSE
					CALL HPH_PRINT(@"「암푸 쿠프, 음...흐흣」", "L")
					PRINTFORMDW 그녀의 목구멍 뒤에 막을 대고 사쿠야는 자신의 혀로 밑부분을 어루만지고 온 목구멍으로 귀두를 감쌌다.
			ENDSELECT
		ELSE
			CALL HPH_PRINT(@"「실례합니다... HPH」", "L")
			PRINTFORMDL 당신이 다리를 벌리면 사쿠야는 지시받지 않고 당신을 섬기기 시작한다.
			;CALL HPH_PRINT(@"「ん……ぷはっ、すぅ～～っ……HPH」", "L")
			PRINTFORMDL 그녀는 당신의 바지 지퍼를 입으로 내리고 노출된 성에서 나는 냄새를 들이마시며 얼굴에 매료된 표정을 짓는다.
			CALL HPH_PRINT(@"(정말 강한 냄새야... HPH 이 *남성적인* 향이 내가 정말 여자라는 걸 상기시켜 주네... HPHHPH)", "W")
			PRINTFORML
			CALL HPH_PRINT(@"「그럼 나는 HPH를 맛보도록 하지. 음...HPH」", "L")
			PRINTFORMDL 사쿠야는 귀두를 빨아들여 당신의 남성기를 뿌리까지 삼키면서 혀로 콜러스 아래쪽을 핥는다...
			RETURN 1
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「흐음... 어때? 기분 좋아? 흐응!」
		PRINTFORMDW 네가 자신의 얼굴을 네 사타구니에 파묻는 것이 얼마나 좋은지 말했을 때, 그녀는 너의 페니스를 씹으며 행복하게 미소 지었다.
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDW 당신은 사쿠야에게 자신의 성기를 빨아달라고 요청하기로 결정했다.
				PRINTFORMW 「음... 피차... 레로...」
				PRINTFORMDW 사쿠야의 구강성교는 즐거운 경험이어야 한다는 것은 사실이지만, 너는 기분이 좋지 않다.
				PRINTFORMDW 사쿠야가 당신을 만족시키기 위해 노력을 기울이고 있지 않은 것 같다...
			CASEELSE
				PRINTFORMW 「흐으... 제대로 닦고 있는 거야?」
				PRINTFORMDW 사쿠야는 당신의 남성기에서 나는 냄새에 미간을 찌푸리며 얼굴을 당신의 성에 가까이 가져갔다.
				PRINTFORMW 「...알겠어... 음, 르로... 추우...」
				PRINTFORMDW 사쿠야가 당신의 성을 응시하며 얼어붙어 있는 동안, 당신은 그녀에게 봉사를 시작하라고 재촉했다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
