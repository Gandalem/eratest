;夜寝るとき（おやすみ口上）
;==================================================

@M_KOJO_EVENT_K15_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORML 「후와아, 벌써 이렇게 늦었네...」
			PRINTFORMW 「이 순간을 영원히 보존하기 위해 시간을 멈출 수 있다면 좋을 텐데.」
			PRINTFORML 「결국 나는 %조사처리(CALLNAME:MASTER,"와")% 함께 있을 때 가장 행복해♪」
			PRINTFORMDL 그녀의 시선이 서로를 바라보는 당신에게 부드러워진다.
			PRINTFORMW 「음, 잘 자요, %CALLNAME:MASTER%.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「어머나, 벌써 이렇게 늦었네?」
			PRINTFORML 「오늘은 여기서 실례해야겠어요.」
			PRINTFORMDL 사쿠야는 잠이 덜 깬 목소리로 중얼거리며 더 깨어 있고 싶다는 듯한 기색을 보였다.
			PRINTFORMW 「내일 봐요.」
		ELSE
			PRINTFORML 「자, 이제 거의 잠잘 시간이야. 나 여기서 먼저 가봐야겠어.」
			PRINTFORML 「%CALLNAME:MASTER%님, 좋은 밤 보내세요.」
			PRINTFORMDW 사쿠야는 아무 말 없이 떠난다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「음... 좀 졸리네.」
				PRINTFORMDW 그녀의 무게 중심이 잠기듯 흔들리는 모습에서 졸림을 느낄 수 있다...
			CASEELSE
				PRINTFORML 「푸와아... 졸리다.」
				PRINTFORMDW 사쿠야는 하품을 참으며 손으로 입을 가했다.
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;中身の文は美鈴用関数置き場に。共通なのは朝起きた時、夜寝るとき（睡眠中）、仕事中居眠り
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「응... 아... 하아...」
				CASE 1
					PRINTFORMW 「아... 하아...」
				CASEELSE
					PRINTFORMW 「음... 이게 좋아... 음... 아!」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「...후우...히이...」
				CASE 1
					PRINTFORMW 「무냐아...? 아... 응!」
				CASEELSE
					PRINTFORMW 「음... 아... 거기 없어...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「문유우... 응...」
				CASE 1
					PRINTFORMW 「...하아... 으음...」
				CASEELSE
					PRINTFORMW 「...음냐?... 아...?」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕付き拠点内キャラがMAIN_MAPで衰弱状態になった場合か、お招き部屋で相手が衰弱した場合に発生
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「...아... 오... 음... 하아....」
			PRINTFORMW 「우으... 아... 아응... 에헤에...」
			PRINTFORMDW 말을 제대로 할 수 없는 사쿠야를 그녀의 방으로 데려간다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...응... 아아... 굉장해... 하아...」
			PRINTFORMW 「...하아, 하아... 응, 아!」
			PRINTFORMDW 당신은 온몸이 진홍색 광택으로 물든 사쿠야를 그녀의 방으로 부축한다.
		ELSE
			PRINTFORMW 「...하아... 하아... 나... 더는 못 가겠어... 하아.. 하아...」
			PRINTFORMDW 그녀를 지탱해 준 후, 사쿠야가 비틀거리며 떠나는 것을 지켜본다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%?... %CALLNAME:MASTER%?!」
			PRINTFORML 「괜찮으세요, %CALLNAME:MASTER%?! ... 응? 그저 피곤하시다고요?」
			PRINTFORMDL 진정하고 당신의 안부를 확인한 사쿠야는 안도의 한숨을 내쉰다.
			PRINTFORML 「나... 뭘 어떻게 하려고 이러는 거야?」
			PRINTFORML 「너무 걱정시키지 마, 바보야...」
			PRINTFORMDW 사쿠야는 당신을 부드럽게 안고 방으로 데려가며 한숨을 내쉰다.
		ELSEIF TALENT:恋慕
			PRINTFORML 「괜찮아?」
			PRINTFORML 「너무 무리하고 있어... 정말이지.」
			PRINTFORML 「어쩔 수 없지. 네 방까지 내가 데려다줄게, 어디인지 말만 해줘.」
			PRINTFORMDW 사쿠야는 당신을 품에 안고 방으로 돌아가며 한숨을 내쉬었다.
		ELSE
			PRINTFORML 「괜찮아?」
			PRINTFORML 「이거... 그냥 과로인 것 같아.」
			PRINTFORMDL 사쿠야는 무심하게 어깨로 당신을 지지해준다.
			PRINTFORMW 「나조차도 누군가를 땅에 쓰러져 있는 채로 그냥 두고 갈 수는 없으니까...」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
