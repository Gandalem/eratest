@M_KOJO_EVENT_K15_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;うふふ==2（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;MASTERを押し倒した（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF TALENT:恋人
				PRINTFORML 「...더 이상 참을 수 없어.」
				PRINTFORML 「먼저 나를 놀린 건 %CALLNAME:MASTER%잖아... 알겠지?」
				PRINTFORMDL 눈 깜짝할 사이에 부드럽게 밀쳐진 당신은 사쿠야의 머리를 사랑스럽게 쓰다듬는다.
				PRINTFORML 「정말, 너의 그 특성은 정말 불공평해... 그거 알고 있지?」
				PRINTFORMDL 사쿠야의 눈은 욕망으로 흐릿했고, 그녀는 한순간도 지체하지 않고 당신의 옷을 벗기 시작했다.
				PRINTFORML 「미안해, %CALLNAME:MASTER%, 하지만 내가 만족할 때까지 참아줘야 해.」
				CALL HPH_PRINT(@"「이거 하고 나서 네가 일어날 수 없을 거니까... 알겠지? HPH」", "L")
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「...휴, 으윽...」
				PRINTFORML 「미안해... 할 수가 없어...」
				PRINTFORMDL 사쿠야는 눈 깜짝할 사이에 당신을 밀어눕히고, 그녀의 눈은 탐욕스럽게 당신을 삼킨다.
				PRINTFORMDL 그녀의 뜨거운 숨결이 당신의 목 위를 스치고, 그녀의 사이가 당신의 허벅지에 닿는다.
				PRINTFORMW 「모두 %CALLNAME:MASTER%네 잘못이야...」
			ELSE
				PRINTFORML 「...더 이상 참을 수 없어.」
				PRINTFORMDL 사쿠야의 목소리가 들리자마자, 몸이 그녀에게 짓눌리는 것을 느낀다.
				PRINTFORML 「후후후, 이렇게 나를 유혹한 건 당신의 잘못이야, %CALLNAME:MASTER%...」
				PRINTFORMDL 그녀의 혀가 살짝 벌어진 입술 위를 스치고, 은발이 창백한 피부를 감싼다.
				PRINTFORMDW 그녀의 표정과 말에서, 곧 무슨 일이 일어날지 깨닫는다.
			ENDIF
			RETURN 1
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
				;抜け出した
				IF TALENT:恋人
					PRINTFORML 「음... 하아... 하아... 벌써 끝났어?」
					PRINTFORML 「하지만 당신의 손길을 좀 더 느끼고 싶었단 말이야, %CALLNAME:MASTER%...」
					PRINTFORMDL 그녀의 분홍빛 가슴이 당신에게 밀착하고 있지만, 당신은 다음으로 미루라고 그녀에게 말한다.
					PRINTFORML 「...알겠어.」
					PRINTFORMW 「다음엔 내가 의식을 잃을 때까지 나를 사랑해줘, 알았지?」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「하아... 하아... 벌써 끝이야?」
					PRINTFORML 「조금만 더 계속할 수 없어...?」
					PRINTFORMDL 사쿠야는 당신의 사타구니를 손가락으로 쓸며 애원한다.
					PRINTFORMDL 당신은 그 손을 꽉 움켜쥐어 사쿠야가 접근하는 것을 포기하게 한다.
					PRINTFORMW 「...다음엔 끝까지 하자, 알았지?」
				ELSE
					PRINTFORML 「내, 벌써 끝난 거야?」
					PRINTFORMW 「I can still go on but... I guess it can't be helped.」
				ENDIF
				RETURN 1
			CASE 1
				;抱き着きモード満足終了
				IF TALENT:恋慕
					PRINTFORML 「...감사합니다, %CALLNAME:MASTER%.」
					PRINTFORMDW 사쿠야는 당신의 품에 얼굴을 묻고 당신의 향기를 들이마신 뒤 몸을 풀었다.
				ELSE
					PRINTFORML 「...후우. 덕분에 훨씬 기분이 나아졌어. 정말 고마워.」
					PRINTFORMW 「다음에도 잘 부탁해, 알겠지 %CALLNAME:MASTER%♪?」
				ENDIF
				RETURN 1
			CASE 2
				;抱き着きモード強制終了。
				;誰かが入ってきた中断時？っぽいんだけど振り払われた時で書いてる感じの口上も有るしよく分からん
				IF TALENT:恋慕
					PRINTFORML 「...이번에도 침입자가 있었나 보네.」
					PRINTFORML 「다음엔 제대로 하자, %CALLNAME:MASTER%. 약속해?」
					PRINTFORMDW 사쿠야는 일부러 당신을 보여주려는 듯 과장되게 입술을 핥는다...
				ELSE
					PRINTFORML 「침입자가 생긴 것 같아.」
					PRINTFORMDW 사쿠야는 아무 일도 없었다는 듯 자리를 떠난다.
				ENDIF
				RETURN 1
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
				;好きにして状態から抜け出せなかった
				IF TALENT:恋慕
					CALL HPH_PRINT(@"「음~ 나에게서 벗어날 수 없을 거야HPH」", "L")
					CALL HPH_PRINT(@"「내 힘을 잊었나? 음흥흐프」", "L")
					PRINTFORMDL 사쿠야에게서 벗어났다고 생각했을 때, 다시 사쿠야에게 붙잡혀 있는 자신을 발견한다.
					CALL HPH_PRINT(@"「어서, 최선을 다해 탈출해」", "L")
					PRINTFORMDW 사쿠야의 얼굴에 악마 같은 미소가 떠올랐다. 그녀에게서 벗어날 수 없을 것 같았다.
				ELSE
					PRINTFORML 「아라, 난 너를 놓아주지 않을 거야.」
					PRINTFORML 「이런 내가 된 건 %CALLNAME:MASTER%때문이야,」
					PRINTFORML 「그러니 책임져, 알겠지?」
					PRINTFORMDW 사쿠야에게 도전적인 미소를 지으며 제압당한다. 도망칠 곳은 없는 듯하다.
				ENDIF
				RETURN 1
			CASE 2
				;欲求不満が高くて抜け出せなかった
				IF TALENT:恋慕
					CALL HPH_PRINT(@"「하아...후웁 하아...후웁 하아...후웁...」", "L")
					PRINTFORMDL 사쿠야는 자신의 힘을 사용해 원치 않게 당신을 제압한다. 그녀는 명백히 이성을 잃었다.
					PRINTFORMDL 입가에서 침이 흘러내리고, 그녀의 허니팟에서는 연모의 진액이 흐른다.
					PRINTFORMDW 당신은 그녀의 현재 상태에서 벗어날 수 없다 - 그것은 평소의 그녀에게서 상상조차 할 수 없었던 것이다.
				ELSE
					CALL HPH_PRINT(@"「아직이야... HPH 나 아직 충분히 못 가졌어 HPH」", "L")
					CALL HPH_PRINT(@"「어서 와, 나 마음대로 써도 되니까 좀 더 채워줘... HPH」", "L")
				ENDIF
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
