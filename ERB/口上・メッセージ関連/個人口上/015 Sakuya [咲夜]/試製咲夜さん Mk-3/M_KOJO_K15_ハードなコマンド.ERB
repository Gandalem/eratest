;==================================================

@M_KOJO_MESSAGE_COM_K15_140
CALL M_KOJO_MESSAGE_COM_K15_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K15_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;PRINTFORMW
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		;PRINTFORMW
		RETURN 1
		;それ以外
	ELSE
		;PRINTFORMDW %CALLNAME:MASTER%は唐突に咲夜の口内をペニスで蹂躙した
		PRINTFORMDW 당신의 성기를 사용해 사쿠야의 입안을 갑자기 침범한다.
		PRINTFORMW 「―――구우?! %RANDLIPS()%?!」
		PRINTFORMDW 당신의 성기가 갑자기 관통하려는 그녀의 저항 계획에도 불구하고, 그녀는 그것을 실행하지 않았다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;141,フィストファック
;==================================================

@M_KOJO_MESSAGE_COM_K15_141
CALL M_KOJO_MESSAGE_COM_K15_141_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K15_141_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		CALL HPH_PRINT(@"「후우, 우우, 으음... 히...큭」","L")
		PRINTFORMDW 보아하니 사쿠야는 자신의 질에 주먹이 들어오는 것을 받아들이면서 어떤 쾌감을 느끼고 있다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		CALL HPH_PRINT(@"「이건 HPH를 더 부술 거고, HPH하게 나를 망칠 거야」","L")
		PRINTFORMDW 사쿠야는 당신의 주먹이 그녀의 질 속으로 밀고 들어올 때 야수처럼 신음한다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「아아아악?!!」
		PRINTFORMDW 사쿠야는 주먹이 그녀의 질에 밀어 넣이자 야수처럼 비명을 질렀다.
		PRINTFORMDW 그녀의 몸은 고통으로 떨리며 등은 최대한 뒤로 젖혀졌다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
