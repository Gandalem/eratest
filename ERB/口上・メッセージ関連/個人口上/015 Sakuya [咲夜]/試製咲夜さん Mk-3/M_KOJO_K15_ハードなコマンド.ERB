;==================================================
;145,アナル奉仕強制
;==================================================

@M_KOJO_MESSAGE_COM_K15_145
CALL M_KOJO_MESSAGE_COM_K15_145_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K15_145_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「에, 그곳? ...어쩔 수 없지.」
		PRINTFORMDW 당신이 사쿠야에게 항문을 핥아달라고 요청했고 그녀는 마지못해 승낙했다.
		PRINTFORMW 「음, 르로, 추우... 레류...」
		PRINTFORMDW 사쿠야는 사랑하는 사람을 위해서 하는 것이라 그런지 역겹다는 기색 없이 당신의 항문을 핥는다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		CALL HPH_PRINT(@"「항문 청소, 이해했습니다HPH」", "L")
		PRINTFORMDW 당신이 사쿠야에게 당신의 항문을 핥으라고 지시하자, 그녀는 즉시 당신의 등 뒤에 나타나 당신의 항문을 빨았다.
		CALL HPH_PRINT(@"「주루흐프 헤로프 음, 추우... 프ㅎ」", "L")
		PRINTFORMDW 사쿠야는 그녀의 혀로 당신의 구멍 주위를 더듬다가 안으로 넣어 당신을 자극했다.
		PRINTFORMDW 게다가, 그녀가 혀를 빼냈을 때 항문을 빨아들였다.
		PRINTFORMDW 그녀의 턱에서 침이 떨어지면서 상상할 수 있는 모든 방식으로 그것에게 봉사했다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「그곳...! 나... 알아들었어...」
		PRINTFORMDW 당신은 그녀가 복종을 거부하자 강한 어조로 항문 봉사를 강요했다.
		PRINTFORMW 「구...레로, 너는... 너...」
		PRINTFORMDW 사쿠야는 눈을 감고 당신의 항문을 섬기면서 아무 생각도 하지 않으려 애썼다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
