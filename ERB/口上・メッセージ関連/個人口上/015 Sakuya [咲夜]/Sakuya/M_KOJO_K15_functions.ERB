@K15_HATE(ARG)
#FUNCTION
SIF CFLAG:K15C_SETTING_DISABLE_HATE_DIALOG && !ARG
	RETURNF 0
SIF K15_FALLEN()
	RETURNF 0
;hate mark 3
RETURNF MARK:反発刻印 == 3
