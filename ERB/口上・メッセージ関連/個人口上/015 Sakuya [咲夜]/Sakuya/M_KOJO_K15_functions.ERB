@K15_FALLEN(ARG)
#FUNCTION
;pleasure mark + pain mark + lewd mark + timerape > 10
RETURNF (MARK:快楽刻印 + MARK:苦痛刻印 + MARK:不埒刻印 + MARK:時姦刻印) >= 10
;==================================================
;Timed Greeting
;==================================================

@GREETING_K15(ARG)
#FUNCTIONS
#DIMS iGreeting
SELECTCASE TIME:2
	CASE 1,2
		iGreeting = Good morning
	CASE 3,4
		iGreeting = Good afternoon
	CASE 5,6,7
		iGreeting = Good evening
	CASEELSE
		iGreeting = Greetings
ENDSELECT
RETURNF iGreeting
