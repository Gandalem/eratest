@K15_BED_ROOM(ARG)
#FUNCTION
;living in the same room
IF CFLAG:現在位置 == CFLAG:初期位置 && CFLAG:初期位置 == CFLAG:PLAYER:初期位置
	RETURNF 3
	;player bedroom
ELSEIF CFLAG:現在位置 == CFLAG:PLAYER:初期位置
	RETURNF 2
	;sakuya room
ELSEIF CFLAG:現在位置 == 320
	RETURNF 1
ENDIF
RETURNF 0

