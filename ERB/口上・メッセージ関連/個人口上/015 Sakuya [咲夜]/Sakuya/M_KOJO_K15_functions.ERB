@K15_NUMBER_OF_PEOPLE(ARG)
#FUNCTION
#DIM iNumOfPeople
iNumOfPeople = 0
FOR LOCAL,1,CHARANUM
SIF CFLAG:LOCAL:同室
	iNumOfPeople ++
NEXT
RETURNF iNumOfPeople
