@M_KOJO_ENG01_EVENT_K15_29(ARG,ARG:1)
;口上主はTARGET
;ARGはTARGETの度胸で分岐
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:70
		RETURN 1
	SIF CFLAG:うふふ == 2
		RETURN 1
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;怒らせてしまった
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF K15_HATE()
			PRINTFORMDL 그녀는 살기 어린 눈으로 칼을 뽑고 있었다.
			IF K15_NUMBER_OF_PEOPLE() == 1
				CALL K15_KNIFEATTACK_STEALTH
			ENDIF
		ELSEIF TALENT:恋慕
			PRINTFORMDL 그녀는 당신을 향해 마지못해 화난 표정을 지으며 칼을 뽑았다.
		ELSE
			PRINTFORMDL 그녀는 칼을 뽑고 눈에 죽이려는 의도가 느껴진다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;泣かせてしまった　[臆病]持ち
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDL %CALLNAME:15%는 칼을 뽑고 있지만 울고 있는 것이 보인다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
