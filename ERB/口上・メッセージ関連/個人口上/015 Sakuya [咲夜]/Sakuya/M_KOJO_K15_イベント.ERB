	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF K15_HATE_ANGER()
			PRINTFORMDL 당신은 %CALLNAME:15%에게서 차갑고 날카로운 시선을 느낀다.
		ELSE
			PRINTFORMDL %CALLNAME:15%가 눈가에서 당신을 알아본다.
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
