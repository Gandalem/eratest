@M_KOJO_ENG01_EVENT_K15_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			IF K15_HATE_ANGER()
				PRINTFORML 「에엣?!」
				PRINTFORMDL 그녀는 홍당무처럼 얼굴이 달아오른 채 당신을 노려본다.
			ELSEIF TALENT:恋慕
				PRINTFORML 「에엥?! %CALLNAME:MASTER%?!」
				PRINTFORMW 「I was just... thinking about you...」
			ELSE
				PRINTFORML 「에헤?! %CALLNAME:MASTER%?!」
				PRINTFORML 「저, 저기... 그냥...」
				PRINTFORMW 「누군가의 방에 들어갈 때는 노크하는 법을 배우지 못했나?」
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			IF TALENT:恋慕
				PRINTFORMW 「모우~」
			ELSE
				PRINTFORMW 「너무 창피해...」
			ENDIF
			;-------------------------------------------------
		CASE 2
			;そのまま続行
			IF K15_HATE_ANGER()
				PRINTFORML 「이것을 기억할 것이다!」
				PRINTFORMDW %CALLNAME:15%는 계속 자위를 하면서 노려보고 당신을 무시했다.
			ELSEIF TALENT:恋慕
				PRINTFORML 「좀 부끄럽지만 당신을 위해서 해줄게요.」
				PRINTFORML 「부디 즐겨주세요, %CALLNAME:MASTER%～」
				PRINTFORMDW %CALLNAME:15%는 당신의 이름을 말하며 당신을 바라보며 계속 자위했다.
			ELSE
				PRINTFORML 「정말 창피해...」
				PRINTFORMDW %CALLNAME:15%는 부끄러워하며 당신을 노려보며 자위 행위를 계속했다.
			ENDIF
			;-------------------------------------------------
		CASE 3
			;追い出し
			PRINTFORML 「나가라!」
			PRINTFORMDW %CALLNAME:15%가 칼 한 자루를 당신에게 던졌지만 다행히 당신을 비껴갔다.
			;-------------------------------------------------
		CASE 4
			;やっちゃう
			IF K15_HATE_ANGER()
				PRINTFORML 「뭐 하는 거니?... 안 돼, 지금은...」
			ELSEIF TALENT:恋慕
				PRINTFORML 「Ah♪ %CALLNAME:MASTER%～」
				PRINTFORMDL 그녀는 당신을 품에 안으라고 두 팔로 환영한다.
				PRINTFORMW 「사랑해요.」
			ELSE
				PRINTFORML 「뭐 하는 거야? 가까이 오지 마!」
				PRINTFORMDL 그녀는 칼을 준비했지만, 당신에게 다가왔을 때 그것들을 던지지 않았다.
				PRINTFORMDL 당신이 그녀의 뜨거운 몸을 껴안자, 그녀는 얼굴을 붉히며 수줍게 시선을 돌렸다.
				PRINTFORMW 「나에게 부드럽게 해주겠다고 약속해줘.」
			ENDIF
			;-------------------------------------------------
		CASE 5
			;事後
			;-------------------------------------------------
		CASE 6
			;事後お泊り
			IF K15_HATE_ANGER()
				PRINTFORML 「하룻밤 머물고 싶으신가요?」
				PRINTFORMW 「물론이죠, 신문 더미 위에서 주무시면 돼요.」
			ELSEIF TALENT:恋慕
				PRINTFORML 「하룻밤 머물래?」
				PRINTFORMDL 그녀는 애정 어린 방식으로 미소 지었다.
				PRINTFORMW 「우리 같이 자도 괜찮을까... 그리고 좀 안아줘도.」
			ELSE
				PRINTFORML 「하룻밤 머물래?」
				PRINTFORML 「음, 저택에 이불이 없네.」
				;I don't know the name of this
				PRINTFORMDL 그녀는 수줍게 검지 손가락들을 서로 맞대기 시작한다.
				PRINTFORMW 「네가 괜찮기를 바라... 내 침대에서 자도...」
			ENDIF
			;-------------------------------------------------
	ENDSELECT
ENDIF
