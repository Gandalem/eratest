;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		;誘い文句
		CASE 0
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%, 내일 만들고 싶은 요리가 있는데, 재료가 좀 부족해서 말이야.」
					PRINTFORMW 「나랑 같이 가줄 수 있을까?」
