@K15_KNIFEATTACK_STEALTH_DODGE
PRINTFORMDW 당신은 어떻게든 자신에게 날아온 칼을 피했다.
EXP:MASTER:戦闘経験 += 1
EXP:戦闘経験 += 1
RETURN 0
;==================================================
;stealth attack - dodge
;==================================================

@K15_KNIFEATTACK_DODAMAGE(ARG)
SIF BASE:MASTER:体力 <= 0
	RETURN 1
;full damage
IF ARG == 9999
	BASE:MASTER:体力 = 0
	BASE:MASTER:気力 = 0
ELSE
	;damage
	BASE:MASTER:体力 -= ARG
	;SETCOLOR C_RED
	;PRINTFROMW STA {ARG}
	;RESETCOLOR
ENDIF
RETURN 1
