;85,足扱き
;==================================================

@M_KOJO_ENG01_MESSAGE_COM_K15_85
CALL M_KOJO_ENG01_MESSAGE_COM_K15_85_1
RETURN RESULT

@M_KOJO_ENG01_MESSAGE_COM_K15_85_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「내가 그걸 해주길 원해?」
		PRINTFORMDL %CALLNAME:15%는 얼굴에 우쭐한 표정으로 당신을 바라본다.
		PRINTFORML 「음, 나는 네가 계속 그것들을 쳐다보는 걸 알아.」
		PRINTFORMDW %CALLNAME:15%는 다리를 과시하며 발로 당신의 사타구니를 놀리기 시작한다.
		IF NOWEX:MASTER:射精
			PRINTFORMW 「벌써 오고 있어? 기분 좋았어?」
		ELSE
			PRINTFORMW 「아, 이렇게까지 즐길 줄은 몰랐어. 떨리고 있어.」
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	IF FLAG:70
	ELSEIF K15_HATE_ANGER()
		IF NOWEX:MASTER:射精
			PRINTFORML 「벌써 오려나? 크윽, 내 발을 더럽히고 싶지 않아...」
			PRINTFORMW 「네가 그런 도착적인 개답게 깨끗하게 핥아 치워야 해.」
		ELSE
		ENDIF
	ELSEIF TALENT:恋慕
		IF NOWEX:MASTER:射精
			PRINTFORMW 「올 거야~ 괜찮아, 내 다리 위에 전부 싸도 돼~」
		ELSE
		ENDIF
	ELSE
		IF NOWEX:MASTER:射精
			PRINTFORMW 「벌써 오고 있어? 기분 좋았어?」
		ELSE
		ENDIF
	ENDIF
ENDIF
RETURN 1
