;80,手淫
;==================================================

@M_KOJO_ENG01_MESSAGE_COM_K15_80
CALL M_KOJO_ENG01_MESSAGE_COM_K15_80_1
RETURN RESULT

@M_KOJO_ENG01_MESSAGE_COM_K15_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	IF FLAG:70
	ELSEIF K15_HATE_ANGER()
		IF NOWEX:MASTER:射精
			PRINTFORMW 「흐윽...」
		ELSE
			;lewds
		ENDIF
	ELSEIF TALENT:恋慕
		IF NOWEX:MASTER:射精
			PRINTFORMW 「내 손이 점점 힘들어져~ 나를 위해 와줘~」
		ELSE
			;lewd text
		ENDIF
	ELSE
		IF NOWEX:MASTER:射精
			PRINTFORMW 「내 손이 점점 힘들어진다. 갈 거야, %CALLNAME:MASTER%?」
		ELSE
			;lewd text
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_ENG01_MESSAGE_COM_K15_81
CALL M_KOJO_ENG01_MESSAGE_COM_K15_81_1
RETURN RESULT

@M_KOJO_ENG01_MESSAGE_COM_K15_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;first time
	IF !FLAG:70 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「%CALLNAME:MASTER%, 당신을 섬기길 원하시나요?」
		PRINTFORMDW %CALLNAME:15%는 당신의 가랑이 쪽으로 움직인다.
		PRINTFORML 「아, 가까이서 보니 더 크네.」
		PRINTFORML 「그리고 그 냄새... 나를 좀 어지럽게 만드는군.」
		PRINTFORMDL %CALLNAME:15%는 잠시 당신의 성기를 응시한 후, 혀로 장난을 치기 시작하며 그것을 입 안으로 넣는다.
		IF NOWEX:MASTER:射精
			PRINTFORMW 「아, 너무 힘들어서...」
			PRINTFORMDW 그녀의 서비스는 폭발 직전인 당신에게 너무 과했고 당신은 입안에 사정을 했다.
			PRINTFORMW 「아아♪... 벌써 나왔어? 정말 따뜻해...」
			PRINTFORMDW 그녀는 정액으로 가득 찬 입으로 당신을 응시했다.
		ELSE
			PRINTFORMW 「아, 벌써 떨리고 있네.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	IF FLAG:70
	ELSEIF K15_HATE_ANGER()
		IF NOWEX:MASTER:射精
			PRINTFORMW 「윽, 역겨워...」
		ELSE
		ENDIF
	ELSEIF TALENT:恋慕
		IF NOWEX:MASTER:射精
			PRINTFORMW 「아~ 떨리고 있어~ 나에게 와줘♪~ %CALLNAME:MASTER%~」
		ELSE
			;lewd text
		ENDIF
	ELSE
		IF NOWEX:MASTER:射精
			PRINTFORMW 「올 거야, %CALLNAME:MASTER%?」
		ELSE
			;lewd text
		ENDIF
	ENDIF
ENDIF
RETURN 1
