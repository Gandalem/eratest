;82,パイズリ
;==================================================

@M_KOJO_ENG01_MESSAGE_COM_K15_82
CALL M_KOJO_ENG01_MESSAGE_COM_K15_82_1
RETURN RESULT

@M_KOJO_ENG01_MESSAGE_COM_K15_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	IF !FLAG:70 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「%CALLNAME:MASTER%, 내가 가슴으로 당신을 섬기길 원하나요?」
		PRINTFORMDW 그녀는 당신의 사타구니 쪽으로 움직여 자신의 가슴으로 당신의 성기를 감싼다.
		PRINTFORML 「아, 벌써 떨리고 있네요. 제 가슴이 그렇게 마음에 들어요?」
		PRINTFORMDL %CALLNAME:15%가 당신의 성기를 가슴으로 비비면서 장난기 어린 눈빛을 보낸다.
		IF NOWEX:MASTER:射精
			PRINTFORMW 「꺄! 벌써 사정했어? 기분이 그렇게 좋았어?」
		ELSE
			PRINTFORMW 「제 서비스를 즐겨주세요.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	IF FLAG:70
	ELSEIF K15_HATE_ANGER()
		IF NOWEX:MASTER:射精
			PRINTFORMW 「윽, 역겨워...」
		ELSE
		ENDIF
	ELSEIF TALENT:恋慕
		IF NOWEX:MASTER:射精
			PRINTFORMW 「올 거야, %CALLNAME:MASTER%?～ 나를 위해 사정해줘～」
		ELSE
		ENDIF
	ELSE
		IF NOWEX:MASTER:射精
			PRINTFORMW 「올 거야, %CALLNAME:MASTER%?」
		ELSE
		ENDIF
	ENDIF
ENDIF
RETURN 1
