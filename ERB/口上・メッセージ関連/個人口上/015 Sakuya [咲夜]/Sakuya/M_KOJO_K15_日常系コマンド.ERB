@M_KOJO_MESSAGE_COM_K15_300_OTHER
IF TALENT:機嫌 == -1
	PRINTFORMDW 그녀는 말할 때 조금 화가 나 있다.
ENDIF
IF TFLAG:193 == 1
	;loves
	IF TALENT:恋慕
		SELECTCASE RAND:8
