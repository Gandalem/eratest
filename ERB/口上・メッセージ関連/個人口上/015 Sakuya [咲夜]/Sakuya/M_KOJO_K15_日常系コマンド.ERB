@M_KOJO_ENG01_MESSAGE_COM_K15_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_ENG01_MESSAGE_COM_K15_300_1
RETURN RESULT

@M_KOJO_ENG01_MESSAGE_COM_K15_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;first time
	;IF FIRSTTIME(SELECTCOM)
	;TODO
	;ENDIF
	IF TFLAG:193 == -3 ;hate mark 3
		;custom code
		IF K15_LIKES_PLAYER()
			PRINTFORMW 「우리가 말하는 건 좋지 않다고 생각해.」
			PRINTFORMW 「나는 여전히 너에게 매우, 매우 화가 난 상태야.」
		ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中)
			PRINTFORMW 「No.」
			PRINTFORMW 「"우리가 '사귀고 있다'는 이유만으로 무슨 말을 할 수 있다고 생각하지 마."」
			PRINTFORMW 「애초에 시간 낭비였으니, 빨리 일이나 하게 해줘.」
		ELSEIF FIRSTTIME("HateSpeech")
			PRINTFORMW 「혹시 죽고 싶어 하는 건가?」
			PRINTFORMW 「더 이상 나랑 어울리지 마.」
			PRINTFORMW 「벌을 충분히 받았다고 생각하지 않아?」
			PRINTFORMW 「아니면 내가 정말 너를 불구로 만들어야 할까?」
		ELSE
			PRINTFORMW 「%TEXTR("You're annoying. Shut up.", "Can I plug your mouth with this I wonder?", @"...\n...\n...!", "What did I tell you?")%」
			CALL K15_KNIFEATTACK_STEALTH
		ENDIF
		;Drunk
	ELSEIF TCVAR:泥酔
		CALL M_KOJO_MESSAGE_COM_K15_300_DRUNK
		;Date
	ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中)
		CALL M_KOJO_MESSAGE_COM_K15_300_DATE
		;in bed
	ELSEIF CFLAG:TARGET:添い寝中
		CALL M_KOJO_MESSAGE_COM_K15_300_SLEEP
		;in bath
	ELSEIF BATHROOM()
		CALL M_KOJO_MESSAGE_COM_K15_300_BATH
		;other
	ELSE
		CALL M_KOJO_MESSAGE_COM_K15_300_OTHER
	ENDIF
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K15_300_DATE
IF TFLAG:193 == 1
	SELECTCASE RAND:10
		CASE 0
			IF K15_LOVER_LOVE()
				PRINTFORML 「나의 미래 계획이라니?」
				PRINTFORMW 「너와 함께 보내는 것 외에는 다른 건 생각할 수가 없어.」
			ELSEIF TALENT:恋慕
				PRINTFORML 「미래에 대한 나의 계획은?」
				PRINTFORMW 「저는 마스터를 섬기면서 당신과 행복하게 보내고 싶어요.」
			ELSEIF K15_LIKES_PLAYER()
				PRINTFORML 「나의 미래 계획이라니?」
				PRINTFORML 「남은 삶을 마님께 바치는 것도 상관없다.」
				PRINTFORML 「그리고 어쩌면...」
				PRINTFORMW 「아, 미안. 됐어.」
			ELSE
				PRINTFORML 「나의 미래에 대한 계획이라고?」
				PRINTFORMW 「미스에게 봉사하는 것 외에는 다른 것을 생각할 수 없다.」
			ENDIF
		CASE 1
			IF TALENT:恋慕
				PRINTFORML 「당신과 이야기하는 것이 좋아, %CALLNAME:MASTER%.」
				PRINTFORMDW %CALLNAME:15%는 따뜻한 미소로 당신의 눈을 깊이 들여다본다.
			ELSEIF K15_LIKES_PLAYER()
				PRINTFORML 「조금 더 이야기해도 상관없어.」
				PRINTFORMDW %CALLNAME:15%는 부드러운 미소로 당신을 바라본다.
			ELSE
				PRINTFORMW 「다른 생각은 주인님께 봉사하는 것 외에는 할 수 없습니다.」
			ENDIF
		CASE 2
			IF K15_LIKES_PLAYER()
				PRINTFORMW 「언젠가 당신을 위해 좀 만들어 주고 싶어요.」
			ELSE
				PRINTFORMW 「가장 좋아하는 차는 무엇인가요?」
			ENDIF
		CASEELSE
			PRINTDATAW
				DATAFORM 「좋아하는 차가 뭐야?」
				DATAFORM 「너도 그렇게 생각해?」
				DATAFORM 「꽤 좋은 이야기였어.」
				DATAFORM 「저 꽃들이 아주 예쁜 것 같아.」
				DATAFORM 「재미있는 이야기를 하나 했는데, 들어볼래?」
				DATAFORM 「괜찮다면 좀 더 이야기 나누고 싶어.」
				DATAFORM 「그건 비밀이야♪」
				DATAFORM 「오, 감명받았네.」
				DATAFORM 「더 많은 이야기를 듣고 싶어, 정말 흥미롭거든.」
			ENDDATA
	ENDSELECT
ELSEIF TFLAG:193 == -1
	IF TALENT:恋慕
		PRINTFORMDW %CALLNAME:15%는 개의치 않는 듯 네 손을 잡으며 미소 짓는다.
	ELSEIF K15_LIKES_PLAYER()
		PRINTFORMW 「계속하자.」
	ELSE
		PRINTFORMW (여기서 시간을 낭비하는 것 같아...)
	ENDIF
ELSE
	SELECTCASE RAND:14
		CASE 0
			PRINTFORML 「꽃밭을 만났으면 좋겠어.」
			PRINTFORMW 「I could use some ingredients.」
		CASE 1
			PRINTFORML 「날씨가 좀 걱정되네.」
			PRINTFORMW 「옷이랑 여분의 나이프만 사 왔어.」
		CASE 2
			PRINTFORML 「흠... 흥미롭군.」
			PRINTFORMW 「We will have to take a look around.」
		CASE 3
			PRINTFORML 「나는 보통 이 장소를 마담과 함께 방문한다.」
			PRINTFORMW 「양산을 들고 있지 않으니 좀 이상하게 느껴진다.」
		CASE 8,9,10,11
			PRINTDATAW
				DATAFORM 「여기 한참 동안 안 왔어.」
				DATAFORM 「이 장소에 대해 좋은 이야기가 있어.」
				DATAFORM 「여기 한참 동안 안 왔어.」
				DATAFORM 「이곳은 이맘때 되니 꽤 매력적이네.」
			ENDDATA
		CASEELSE
			CALL M_KOJO_MESSAGE_COM_K15_300_GENERICS
	ENDSELECT
ENDIF
RETURN 1

@M_KOJO_MESSAGE_COM_K15_300_SLEEP
IF TFLAG:193 == -1
	PRINTFORMDW %CALLNAME:15%은(는) 당신을 가끔 엿보며 잠들려고 눈을 감았다.
ELSE
	IF TFLAG:193 == 1
		PRINTFORMDL %CALLNAME:15%는 당신과 서로 이야기하는 동안 부드럽게 머리를 쓰다듬는다.
	ENDIF
	SELECTCASE RAND:15
		CASE 0,1
			PRINTFORML 「좀 부끄럽네...」
			PRINTFORMDW %CALLNAME:15%는 잠옷을 만지작하며 얼굴이 새빨개진다.
		CASE 2,3
			PRINTFORML 「당신과 함께 있는 한 잘 모르겠어요.」
			PRINTFORMDW %CALLNAME:15%는 당신을 따뜻하게 바라보며 껴안는다.
		CASE 13
			IF K15_LOVER_LOVE()
				PRINTFORML 「나의 미래 계획이라니?」
				PRINTFORMW 「너와 함께 보내는 것 외에는 다른 건 생각할 수가 없어.」
			ELSE
				PRINTFORML 「미래에 대한 나의 계획은?」
				PRINTFORMW 「저는 마스터를 섬기면서 당신과 행복하게 보내고 싶어요.」
			ENDIF
		CASE 14
			;child talking
			IF CFLAG:妊娠自覚状態
				PRINTFORML 「응, 우리 %BABYPLNOUN("child",15)%도 건강하게 자랐으면 좋겠어.」
				PRINTFORMW 「이미 선택한 %BABYCONDSTR(" a",15,1)% %BABYPLNOUN("name",15)%가 있는지 궁금하네?」
				;birth talk
				;already had children
			ELSEIF EXP:出産経験
				PRINTFORMW 「확실하진 않지만, 네가 원한다면 기꺼이 \@ PREGNANCY_MULTIPLES(15) ? 더 많은 # 다른 \@도 말이야.」
				;no children yet
			ELSE
				PRINTFORML 「자식이라는 걸 진지하게 생각해 본 적이 없어.」
				PRINTFORMW 「«하지만 네 것이라면 상관없어...»」
			ENDIF
		CASE 5
			PRINTFORML 「그 드레스가 저택에 어울릴지 잘 모르겠어요... 좀 부끄럽네요.」
			PRINTFORMDW %CALLNAME:15%는 잠옷을 만지작거리며 얼굴을 크게 붉힌다.
		CASEELSE
			PRINTDATAW
				DATAFORM 「당신과 이야기하는 것이 좋아요, %CALLNAME:MASTER%.」
				DATAFORM 「내가 당신이 잠들도록 도와줄까요?」
				DATAFORM 「백까지 세면서 당신이 잠들도록 도와줄까요?」
				DATAFORM 「후후후~ 기꺼이 할 거예요.」
				DATAFORM 「그건 너무 부끄러워요, %CALLNAME:MASTER%!」
				DATAFORM 「당신이 책임을 진다면 말이죠.」
				DATAFORM 「그건 비밀이에요♪」
				DATAFORM 「정말 그렇게 하고 싶어요.」
				DATAFORM 「당신도 그렇게 생각해요?」
			ENDDATA
	ENDSELECT
ENDIF
RETURN 1

