;==================================================

@M_KOJO_ENG01_MESSAGE_COM_K15_403
CALL M_KOJO_ENG01_MESSAGE_COM_K15_403_1
RETURN RESULT

@M_KOJO_ENG01_MESSAGE_COM_K15_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;asleep
	IF CFLAG:睡眠
		;asleep in same bed
	ELSEIF CFLAG:添い寝中
	ELSEIF K15_HATE_ANGER()
		IF BASE:15:体力 <= 900
			PRINTFORMDW %CALLNAME:15%는 당신을 무시하고 잠시 휴식을 취하며, 거의 잠이 들 지경이다.
		ELSEIF BASE:15:気力 <= 300
			PRINTFORMDW %CALLNAME:15%은(는) 당신을 무시하고 잠시 휴식을 취한다.
		ELSE
			PRINTFORML (시간을 낭비하는 것 같아...)
			PRINTFORMDW %CALLNAME:15%는 당신을 무시하고 가벼운 청소를 한다.
		ENDIF
	ELSEIF TALENT:恋慕 || K15_PLAYER_LOVER_REMILIA()
		IF BASE:15:体力 <= 900
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%(는) 좀 지쳤어. 괜찮다면...」
			PRINTFORMDW 그녀는 당신에게 기대며 안기고, 거의 잠이 들 것 같았다.
			RETURN 1
		ELSEIF BASE:15:気力 <= 300
			PRINTFORML 「나도 잠시 쉴 수 있어요, %CALLNAME:MASTER%님.」
		ENDIF
		PRINTFORML 「괜찮다면 내가 우려낸 이 차를 맛보고 싶니?」
		PRINTFORMDW 그녀의 차는 매우 진정되고 편안했다.
		;is a resident
	ELSEIF K15_PLAYER_IS_SDM_RESIDENT()
		IF BASE:15:体力 <= 900
			PRINTFORML 「%CALLNAME:MASTER%... 오늘 할 일은 다 끝냈나?... 상관없어...」
			IF K15_LIKES_PLAYER()
				PRINTFORMDW 그녀는 거의 잠이 들다 당신의 어깨 쪽으로 몸을 기댄다.
			ELSE
				PRINTFORMDW 그녀는 쉬면서 거의 잠이 들었다.
			ENDIF
		ELSEIF BASE:15:気力 <= 300
			PRINTFORML 「%CALLNAME:MASTER%, 오늘 할 일은 다 끝냈나?」
			PRINTFORMW 「음, 허락해 주지. 나도 잠시 쉬어도 괜찮을 것 같아.」
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 오늘 할 일은 끝났나요?」
			PRINTFORMW 「그렇다면 허락하겠어요.」
		ENDIF
		;other
	ELSE
		IF BASE:15:体力 <= 900
			IF K15_LIKES_PLAYER()
				PRINTFORML 「잠깐 쉬고 싶으신가요, %CALLNAME:MASTER%?... 상관없어요...」
				PRINTFORMDW 그녀는 당신의 어깨 쪽으로 바싹 다가와 거의 잠이 들었다.
			ELSE
				PRINTFORML (시간을 낭비하는 기분이야... 주인님 정말 죄송해요.)
				PRINTFORMDW %CALLNAME:15%는 마지못해 잠시 쉬며, 거의 잠들 뻔했다.
			ENDIF
		ELSEIF BASE:15:気力 <= 300
			IF K15_LIKES_PLAYER()
				PRINTFORML 「잠시 쉬고 싶으신가요, %CALLNAME:MASTER%?」
				PRINTFORMW 「음, 저도 좀 쉴 수 있을 것 같아요.」
			ELSE
				PRINTFORML (시간을 낭비하는 기분이야...)
				PRINTFORMDW %CALLNAME:15%는 마지못해 잠시 쉬었다.
			ENDIF
		ELSE
			IF K15_LIKES_PLAYER()
				PRINTFORML 「잠시 쉬고 싶으신가요, %CALLNAME:MASTER%?」
				PRINTFORML 「그렇다면 차라도 대접해 드릴까요?」
			ELSE
				PRINTFORML (시간을 낭비하고 있는 것 같아...)
				PRINTFORMDW %CALLNAME:15%는 조금 안절부절못하며 가벼운 청소를 했다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
