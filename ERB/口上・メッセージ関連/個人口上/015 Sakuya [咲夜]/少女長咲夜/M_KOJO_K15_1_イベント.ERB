@M_KOJO_少女長_EVENT_K15_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 1, 6) ;edit
		;時姦バレファーストイベント
		IF GETBIT (CFLAG:1151,0) && !GETBIT (CFLAG:1151,1) && !TALENT:恋人
			CALL 咲夜時姦バレ()
			;少女恋人モード
		ELSEIF 陥落状態() == 5
			PRINTFORML 「어머 %MASTERNAME:15%? 무슨 일로 왔니?」
			PRINTFORMDL 미소를 지으며 사쿠야가 가까이 다가온다.
			PRINTFORMW 「후훗, 사랑하는 연인의 뒤를 쫓으러 온 걸까?」
			IF !RAND:6
				PRINTFORMDL 그렇다고 대답한 순간, 사쿠야의 얼굴이 새빨갛게 물들었다.
				PRINTFORML 「……하아, 졌어, 나의 패배야, 이제」
				PRINTFORMDW 두 손을 가볍게 들고 항복의 뜻을 드러내면서, 사쿠야가 달려와 안겼다.
			ELSE
				PRINTFORMDL 우연이라고 대답하는 %조사처리(CALLNAME:MASTER,"에게")%, 사쿠야의 히죽거림이 깊어진다.
				PRINTFORML 「구,우,즈,ㄴ네~~~~~~~」
				PRINTFORMDW 놀리는 분위기를 흘려보내면서, 사쿠야 옆에 몸을 붙였다.
			ENDIF
			;メイド恋人モード
		ELSEIF 陥落状態() == 4
			PRINTFORML 「아, %MASTERNAME:15%. 이런 곳에 무슨 용무로 오셨나요?」
			PRINTFORMD 아무 말 없이 옆에 서 있는 사쿠야에게, 특별한 용무는 없다고 답하는 %CALLNAME:MASTER%
			PRINTFORMW 「그렇군요. 저를 찾아주지는 않으신 거네요」
			PRINTFORMDL 어딘가 쓸쓸해 보이는 듯 중얼거리며, 사쿠야가 가만히 나를 바라본다
			PRINTFORML 「일도 중요하지만, %MASTERNAME:15%와 같은 시간을 보내고 싶다고 생각하고 있는데요」
			PRINTFORMDW 일에 방해할 생각은 없다고 중얼거리는 %조사처리(CALLNAME:MASTER,"에게")%, 사쿠야는 그런 말을 꺼냈다
			;恋慕or時姦バレ思慕
		ELSEIF 陥落状態() == 3
			PRINTFORML 「あら、%MASTERNAME:15%。何しに来たの\@ GETBIT(CFLAG:1150,0) ? かしら # ですか \@」
			PRINTFORMDL 부드러운 미소를 짓는 사쿠야에게 목적은 없다고 대답하는 %CALLNAME:MASTER%
			PRINTFORML 「\@ GETBIT(CFLAG:1150,0) ? だ읏 # でし \@たら、しばらく私と\@ GETBIT(CFLAG:1150,0) ?  # お \@話でもし\@ GETBIT(CFLAG:1150,0) ? ない # ません \@?」
			PRINTFORMDW 사쿠야의 제안에 가끔은 괜찮다고 고개를 끄덕이는 %CALLNAME:MASTER%였다
			;思慕or時姦バレ
		ELSEIF 陥落状態() == 1
			PRINTFORML 「%MASTERNAME:15%? 무슨 용건이라도 있나 \@ GETBIT(CFLAG:1150,0) ? 했거나 # 말한 걸까?」\@
			PRINTFORMDW 특별히 없다며 대답하고 사쿠야 옆으로 이동했다.
		ELSE
			PRINTFORMW 「…………뭔가 있니?」
		ENDIF
		;CALL 時姦返し
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;時姦バレファーストイベント
		IF GETBIT (CFLAG:1151,0) && !GETBIT (CFLAG:1151,1) && !TALENT:恋人
			CALL 咲夜時姦バレ()
			;少女恋人モード
		ELSEIF 陥落状態() == 5
			PRINTFORML 「이런 곳에 있었구나」
			PRINTFORMDL 바로 뒤에서 안기자, %조사처리(CALLNAME:MASTER,"는")% 깊은 한숨을 내쉰다.
			PRINTFORMW 「어머, 상당히 성대한 인사네」
			IF !RAND:6
				PRINTFORMDL 사쿠야의 포옹을 뿌리치고 돌아본 %조사처리(CALLNAME:MASTER,"는")% 지체 없이 사쿠야를 끌어안았다.
				PRINTFORML 「캬응! ……%MASTERNAME:15%, 갑자기 뭐 하는 거야」
				PRINTFORMDW 기쁜 듯 볼을 부드럽게 풀면서 꾸짖는 말투의 사쿠야에게 변덕이라고 대답하는 %CALLNAME:MASTER%였다.
			ELSE
				PRINTFORMDL 갑자기 뒤에서 안기는 건 심장에 안 좋다고 대답하는 %CALLNAME:MASTER%
				PRINTFORML 「시간을 멈추고 에로 행위를 하는 쪽이 훨씬 더 심장에 안 나쁘잖아」
				PRINTFORMDW 당하는 상대는 그럴 테니, 그렇게 답하며 사쿠야의 포옹에서 벗어났다
			ENDIF
			;メイド恋人モード
		ELSEIF 陥落状態() == 4
			PRINTFORML 「%MASTERNAME:15%, 이런 곳에 계셨나요」
			PRINTFORMDL 기쁘게 웃은 사쿠야가 천천히 옆으로 걸어오는 것에, 고개를 갸웃거린다.
			PRINTFORMW 「후후, %MASTERNAME:15%와 함께 있을 수 있는 동안 정도는 시간 정지는 하지 않겠습니다」
			PRINTFORMDL 그렇게 말하고는 그대로 팔을 감아왔다.
			PRINTFORML 「이렇게 하면 안심돼요」
			PRINTFORMDW 부끄러워하는 미소를 짓는 사쿠야에게, %조사처리(CALLNAME:MASTER,"의")% 입가에도 미소가 떠올랐다.
			;恋慕or時姦バレ思慕
		ELSEIF 陥落状態() == 3
			PRINTFORML 「아라, %MASTERNAME:15%. 어째서 이런 곳에 있는 거야 \@ GETBIT(CFLAG:1150,0) ?뭐지#것인가?\@?」
			PRINTFORMDL 왠지 모른다는 듯 대답하는 %조사처리(CALLNAME:MASTER,"에게")% 사쿠야가 쓴웃음을 짓는다.
			PRINTFORML 「\@ GETBIT(CFLAG:1150,0) ?이었다#~였을까?\@たら、しばらく私と\@ GETBIT(CFLAG:1150,0) ?  # お \@話でもし\@ GETBIT(CFLAG:1150,0) ?없다.#없습니다.\@?」
			PRINTFORMDW 사쿠야의 권유에, 가끔은 괜찮다고 대답하는 %CALLNAME:MASTER%였다.
			;思慕or時姦バレ
		ELSEIF 陥落状態() == 1
			PRINTFORML 「%MASTERNAME:15%? 후후, 마침 잘 됐어요\@ GETBIT(CFLAG:1150,0) ?  # 이에요 \@와」
			PRINTFORMDW 그런 사쿠야가 어딘가 기쁜 듯 옆에 왔다.
		ELSE
			PRINTFORMW 「……%MASTERNAME:15%？」
		ENDIF
		;CALL 時姦返し
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;時姦バレファーストイベント
		IF GETBIT (CFLAG:1151,0) && !GETBIT (CFLAG:1151,1) && !TALENT:恋人
			CALL 咲夜時姦バレ()
			PRINTFORMDW 한순간에 나이프를 어딘가로 사라지게 한 사쿠야가 알몸으로 옆에 앉았다.
			;少女恋人モード
		ELSEIF 陥落状態() == 5
			PRINTFORML 「%MASTERNAME:15%는 목욕 좋아하지」
			PRINTFORMDL 깊이 생각하며 가만히 이쪽을 응시하는 사쿠야
			PRINTFORML 「그래서, 사랑스러운 연인에게 건넬 말은 없는 걸까?」
			IF !RAND:6
				PRINTFORMDL 볼을 붉히며 다리를 벌려 은밀한 곳을 드러내는 사쿠야에게 '에로하다'고 되받았다.
				PRINTFORML 「%MASTERNAME:15%가 에로럽게 만드는 거잖아」
				PRINTFORMDL ぺ치んと 가볍게 머리를 맞고, %조사처리(CALLNAME:MASTER,"는")% 쓴웃음을 지었다.
			ELSE
				PRINTFORMDL 여전히 아름다운 몸이라고 중얼거리는 %조사처리(CALLNAME:MASTER,"에게")%, 사쿠야가 입술을 삐죽 내민다.
				PRINTFORML 「몸만?」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 얼굴도 몸의 일부라고 답하자, 사쿠야가 웃는 것을 지켜보았다.
			ENDIF
			;メイド恋人モード
		ELSEIF 陥落状態() == 4
			PRINTFORML 「%MASTERNAME:15%, 그, 함께 있어도 될까요」
			PRINTFORMDL 조심스럽게 물어오는 사쿠야를 손짓으로 불러 모았다.
			PRINTFORML 「감사합니다. 후후, 그럼 %MASTERNAME:15%의 몸을 가꾸겠습니다わ」
			PRINTFORMDL 그것은 조금 나중에 괜찮다고 말하며 강제로 사쿠야의 어깨를 끌어당겼다.
			PRINTFORML 「후후, 맨살이 맞닿으면 안심돼요」
			PRINTFORMDL 황홀한 표정으로 사쿠야가 이쪽을 바라보고 있었다.
			;恋慕or時姦バレ思慕（恋慕のみだと思う
		ELSEIF 陥落状態() == 3
			PRINTFORML 「아라, 들어 있었던 거예요\@ GETBIT(CFLAG:1150,0) ?  # 인가요 \@? 옆에, 실례\@ GETBIT(CFLAG:1150,0) ? 할 # 합니다 \@네」
			PRINTFORMDL 나체인 채 숨기지도 않고 옆에 온 사쿠야가 그대로 몸을 기울여 왔다.
			PRINTFORML 「후후, 이런 것도 좋은 거예요\@ GETBIT(CFLAG:1150,0) ?  # 인가요 \@? 와」
			PRINTFORMDL 쿠스쿠스 즐겁게 웃는 사쿠야에게 되받을 말이 나오지 않았다.
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;時姦バレファーストイベント

@咲夜時姦バレ()
PRINTFORML 「변명할 여지를 주\@ GETBIT(CFLAG:1150,0) ? る # ます \@와」
PRINTFORMDL 그 목소리와 동시에, 목덜미에 딱 칼날이 대진 %조사처리(CALLNAME:MASTER,"는")% 움직일 수 없었다.
PRINTFORML 「%MASTERNAME:15%라는 건 알고 있\@ GETBIT(CFLAG:1150,0) ? るのよ # ますわ \@, 시간을 멈추고 내 몸을 가지고 논 건」
PRINTFORMDW 시간을 멈추고 도망치려던 순간, 눈앞에 사쿠야의 얼굴이 있었다.
PRINTFORMDL 아니, 사쿠야에게 입술을 맞고 있었다.
PRINTFORMDL 예상치 못한 사쿠야의 행위에 당황하는 %CALLNAME:MASTER%.
PRINTFORMDL 스르륵, 입술을 깨고 혀가 들어왔다.
PRINTFORMDW 질척거리는 소리가 귓불과 구강에 울리고, 황홀한 표정으로 바라보는 사쿠야.
PRINTFORMDL 그 기분 좋은 것에 도망칠 수 없었다.
PRINTFORML 「푸핫…… 후후, 죽는 줄 알았나\@ GETBIT(CFLAG:1150,0) ? 셨나요 # いました \@?」
PRINTFORML 「드디어 찾은 동류\@ GETBIT(CFLAG:1150,0) ? 이 # です \@もの、そんなことする筈\@ GETBIT(CFLAG:1150,0) ? ない # 없습니다 \@와」
PRINTFORML 「앞으로 잘 부탁해」
PRINTFORMDW 그렇게 말하며 웃는 사쿠야를 잠시 바라보던 %CALLNAME:MASTER%였다.
IF !GETBIT(CFLAG:既成事実 , 1)
	IF !GETBIT(CFLAG:既成事実 , 0)
		CALL SET_FIRSTKISS(15)
		;最後が奪われたになるのを抑制するのに、わざわざ書き直してみる
		CSTR:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、同類である%CALLNAME:MASTER%に%CSTR:ファーストキス位置%で時姦に対する宣戦布告としてファーストキスを押しつけた
	ENDIF
	SETBIT CFLAG:既成事実 , 1
	CALL COLORMESSAGE("사쿠야의 동의를 얻었다",C_YELLOW,2)
ENDIF
SETBIT CFLAG:1151,1
RETURN 1

@時姦返し()
;時姦された際のＡソースのお返し
SIF CFLAG:1152
	SOURCE:MASTER:快Ａ += CFLAG:1152
;時姦された際のＢソースお返し（MASTERが♂ならＣに振り分け
IF CFLAG:1153
	IF GETBIT(TALENT:MASTER:性別,1)
		SOURCE:MASTER:快Ｂ += CFLAG:1153
	ELSE
		SOURCE:MASTER:快Ｃ += CFLAG:1153
	ENDIF
ENDIF
;時姦された際のＣソースお返し
SIF CFLAG:1154
	SOURCE:MASTER:快Ｃ += CFLAG:1154
;時姦された際のＶソースお返し（MASTERが♂ならＡに振り分け
IF CFLAG:1155
	IF GETBIT(TALENT:MASTER:性別,1)
		SOURCE:MASTER:快Ｖ += CFLAG:1154
	ELSE
		SOURCE:MASTER:快Ａ += CFLAG:1154
	ENDIF
ENDIF
;時姦された際のＭソースお返し
SIF CFLAG:1156
	SOURCE:MASTER:快Ｍ += CFLAG:1156
FOR LOCAL,1152,1157
CFLAG:LOCAL = 0
NEXT
RETURN 1

@時姦反応()
;咲夜さんに時姦した場合のあれこれ
;ただし手加減する模様
SIF !GETBIT (CFLAG:1151,0)
	SETBIT CFLAG:1151,0
SIF !CFLAG:時間停止バレ
	CFLAG:時間停止バレ = 1
SIF SOURCE:快Ａ
	CFLAG:1152 += SOURCE:快Ａ / 5
SIF SOURCE:快Ｂ
	CFLAG:1153 += SOURCE:快Ｂ / 5
SIF SOURCE:快Ｃ
	CFLAG:1154 += SOURCE:快Ｃ / 5
SIF SOURCE:快Ｖ
	CFLAG:1155 += SOURCE:快Ｖ / 5
SIF SOURCE:快Ｍ
	CFLAG:1156 += SOURCE:快Ｍ / 5
SIF !GETBIT(CFLAG:1151,0)
	SETBIT CFLAG:1151,0
SIF GROUPMATCH(SELECTCOM,21,50,51,104)
	RETURN 1
IF GROUPMATCH(SELECTCOM,312,313,314,315,316)
	PRINTFORML 얼어붙은 시간 속에서, %조사처리(CALLNAME:MASTER,"는")% 사쿠야의 몸을 만끽했다.
ELSEIF !GETBIT(CFLAG:1151,1)
	PRINTFORML 시간이 멈춘 가운데, 때때로 사쿠야의 몸이 쾌감에 떨리는 듯한 기분이 들었다.
	PRINTFORML 그저 착각이라고 생각하면서도, %조사처리(CALLNAME:MASTER,"는")% 사쿠야의 몸을 탐하기를 계속했다.
ELSE
	PRINTFORML 파르르 떨며 몸을 가늘게 떨고 있는 사쿠야
	PRINTFORML 그것이 사쿠야의 한계겠지, 얼음 속에서 미세한 반응에 %조사처리(CALLNAME:MASTER,"는")% 미소를 지었다.
ENDIF
RETURN 1
