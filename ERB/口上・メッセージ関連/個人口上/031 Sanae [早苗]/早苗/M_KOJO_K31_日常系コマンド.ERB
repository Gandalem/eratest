;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;メモ
;本口上にて使用しているCFLAG・TCVAR等
;CFLAG:31:3100～CFLAG:31:3199までは予約しておきます
;CFLAG:31:3100 各選択肢で何を選択したか(10進数管理)
; 000 000 000 000 000
;5章、4章、3章、2章、1章の順、未選択なら0、Aルート選択だと1、Bルート選択だと2
;現状6章がゴールなので選択肢の記録が必要なのは5章まで
;CFLAG:31:3101 本口上の1章のシナリオ(未到達時は-1)
;CFLAG:31:3102 本口上の2章のシナリオ(未到達時は-1)
;CFLAG:31:3103 本口上の3章のシナリオ(未到達時は-1)
;CFLAG:31:3104 本口上の4章のシナリオ(未到達時は-1)
;CFLAG:31:3105 本口上の5章のシナリオ(未到達時は-1)
;CFLAG:31:3106 本口上の6章のシナリオ(未到達時は-1)
;TCVAR:31:350  料理を作っているとこを早苗は見たか？(YES:FLAG:料理の値 NO:0)
;==================================================
;300,会話
;多分ここが一番選択回数が多いので一番力をいれねば
;メモ
;FIRSTTIME(300)…初回判定
;TCVAR:302…会話累積値
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;反発刻印3の場合RETURN -1(実行自体がされない？)
;TFLAG:193 == 1 …大成功
;TFLAG:193 == 0 …成功
;TFLAG:193 == -1…失敗した(会話しすぎと通常の失敗は同一視)
;TFLAG:193 == -2…失敗した(教養が違いすぎて会話にならない)（TARGETがMASTERより教養が4以上高い)
;TCVAR:泥酔(1=通常成功or大失敗)
;停止中…不可
;==================================================

@M_KOJO_MESSAGE_COM_K31_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K31_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K31_300_1
#DIM CONST 第1章イベントセリフ出現確率 = 20
#DIM CONST 第2章イベントセリフ出現確率 = 17
#DIM CONST 第3章イベントセリフ出現確率 = 0
#DIM CONST 第4章イベントセリフ出現確率 = 0
#DIM CONST 第5章イベントセリフ出現確率 = 0
#DIM CONST 第6章イベントセリフ出現確率 = 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193 >= 0
	;=======================================================
	;第6章解放 関係性:恋人(好感度A信頼度A)
	;=======================================================
	IF CHAPTER_今何章？_K31() == 6
		;=======================================================
		;第5章解放 関係性:恋慕(好感度B信頼度B)
		;=======================================================
	ELSEIF CHAPTER_今何章？_K31() == 5
		;=======================================================
		;第4章解放 関係性:思慕(好感度C信頼度C)
		;=======================================================
	ELSEIF CHAPTER_今何章？_K31() == 4
		;=======================================================
		;第3章解放 関係性:友人(好感度D信頼度D)
		;=======================================================
	ELSEIF CHAPTER_今何章？_K31() == 3
		;=======================================================
		;第2章解放 関係性:知人(好感度E信頼度E)
		;2章はひとつの会話につき4行ぐらいを目安に
		;=======================================================
	ELSEIF CHAPTER_今何章？_K31() == 2
		;********************************************************************************
		;第2章シナリオ
		;********************************************************************************
		;通常ルート「第2章　守矢さんちの現人神」
		IF CHAPTER_攻略中_K31(10)
			;----------------------------------------------------------------------------
			;通常ルート「第2章　守矢さんちの現人神」				イベントID:10
			;第2章第1選択肢(好感度500以上で会話)
			;			A選択肢	守矢ファミリーズ					イベントID:11
			;			B選択肢	あくまでも協力員					イベントID:12
			;----------------------------------------------------------------------------
			IF EVENT_次の選択肢_K31() == 1 && CFLAG:31:2 >= 500
				CALL M_KOJO_EVENT_K31_シナリオイベント(2,1)
				;----------------------------------------------------------------------------
				;通常ルート「第2章　守矢さんちの現人神」				イベントID:10
				;第2章第4選択肢(好感度1000信頼度100を満たす+会話)
				;			Aルート	信者と神のアヤシイ関係				イベントID:100
				;			Bルート	3年B組サナエさん					イベントID:110
				;----------------------------------------------------------------------------
				;ELSEIF EVENT_次の選択肢_K31() == 4 && CFLAG:31:2 >= 1000 && CFLAG:31:4 >= 100
				;CALL M_KOJO_EVENT_K31_シナリオイベント(2,4)
			ELSE
				GOTO 「300_会話」第2章汎用セリフ
			ENDIF
			;通常ルート「第2章　信者獲得大作戦」
		ELSEIF CHAPTER_攻略中_K31(20)
			;----------------------------------------------------------------------------
			;通常ルート「第2章　信者獲得大作戦」					イベントID:20
			;第2章第1選択肢(好感度500以上で会話)
			;			A選択肢	風祝としての力						イベントID:21
			;			B選択肢	信じてと言われても…				イベントID:22
			;----------------------------------------------------------------------------
			IF EVENT_次の選択肢_K31() == 1 && CFLAG:31:2 >= 500
				CALL M_KOJO_EVENT_K31_シナリオイベント(2,1)
				;----------------------------------------------------------------------------
				;通常ルート「第2章　信者獲得大作戦」					イベントID:20
				;第2章第4選択肢(好感度1000信頼度100を満たす+会話)
				;			Aルート	信者と神のアヤシイ関係				イベントID:100
				;			Bルート	妖怪バスターズ						イベントID:120
				;----------------------------------------------------------------------------
				;ELSEIF EVENT_次の選択肢_K31() == 4 && CFLAG:31:2 >= 1000 && CFLAG:31:4 >= 100
				;CALL M_KOJO_EVENT_K31_シナリオイベント(2,4)
			ELSE
				GOTO 「300_会話」第2章汎用セリフ
			ENDIF
			;レアルート「第2章　くじで繋がる縁」
		ELSEIF CHAPTER_攻略中_K31(10010)
			;----------------------------------------------------------------------------
			;レアルート「第2章　くじで繋がる縁」					イベントID:10010
			;第2章第1選択肢(好感度500以上で会話)
			;			A選択肢	満更でもなかったり					イベントID:10011
			;			B選択肢	布教のススメ						イベントID:10012
			;----------------------------------------------------------------------------
			IF EVENT_次の選択肢_K31() == 1 && CFLAG:31:2 >= 500
				CALL M_KOJO_EVENT_K31_シナリオイベント(2,1)
				;----------------------------------------------------------------------------
				;レアルート「第2章　くじで繋がる縁」					イベントID:10010
				;第2章第2選択肢(好感度700以上で会話)
				;			A選択肢	人のうわさも…						イベントID:10013
				;			B選択肢	幻想報道○キシャ					イベントID:10014
				;----------------------------------------------------------------------------
			ELSEIF EVENT_次の選択肢_K31() == 2 && CFLAG:31:2 >= 700
				CALL M_KOJO_EVENT_K31_シナリオイベント(2,2)
				;----------------------------------------------------------------------------
				;レアルート「第2章　くじで繋がる縁」					イベントID:10010
				;第2章第3選択肢(好感度900以上で会話)
				;			A選択肢	えれめんたりぃ、まいでぃあさなえ	イベントID:10015
				;			B選択肢	真ん中中央９５点					イベントID:10016
				;----------------------------------------------------------------------------
			ELSEIF EVENT_次の選択肢_K31() == 2 && CFLAG:31:2 >= 900
				CALL M_KOJO_EVENT_K31_シナリオイベント(2,3)
				;----------------------------------------------------------------------------
				;レアルート「第2章　くじで繋がる縁」					イベントID:10010
				;第2章第3選択肢(好感度1000信頼度100を満たす+会話)
				;			Aルート	どっちの的を射抜いたの？			イベントID:10100
				;			Bルート	3年B組サナエさん					イベントID:110
				;----------------------------------------------------------------------------
				;ELSEIF EVENT_次の選択肢_K31() == 4 && CFLAG:31:2 >= 1000 && CFLAG:31:4 >= 100
				;CALL M_KOJO_EVENT_K31_シナリオイベント(2,4)
			ELSE
				GOTO 「300_会話」第2章汎用セリフ
			ENDIF
			;レアルート「第2章　奇跡のおこしかた」
		ELSEIF CHAPTER_攻略中_K31(10020)
			;----------------------------------------------------------------------------
			;レアルート「第2章　奇跡のおこしかた」					イベントID:10020
			;第2章第1選択肢(好感度500以上で会話)
			;			A選択肢	ガールズ＆パンティー				イベントID:10021
			;			B選択肢	ｑ！！								イベントID:10022
			;----------------------------------------------------------------------------
			IF EVENT_次の選択肢_K31() == 1 && CFLAG:31:2 >= 500
				CALL M_KOJO_EVENT_K31_シナリオイベント(2,1)
			ELSE
				GOTO 「300_会話」第2章汎用セリフ
			ENDIF
			;ファッ？
		ELSE
			PRINTFORML 오류 죄송합니다 에러가 발생했습니다
			PRINTFORML 번거로우시겠지만 아래 메시지와 함께 발생 상황을 스레에 보고해 주십시오
			PRINTFORML 에러 「300_대화」 제2장
		ENDIF
		RETURN 1
		;********************************************************************************
		;第2章シナリオ終わり
		;********************************************************************************
		$「300_会話」第2章汎用セリフ
		;********************************************************************************
		;第2章汎用
		;********************************************************************************
		;==========================================================
		;特殊セリフ(特定のイベントを踏んでいる場合にのみ出現)
		;「第2章　守矢さんちの現人神」			イベントID:10
		;==========================================================
		;「守矢ファミリーズ」No.11選択
		IF EVENT_CHECK_K31(11) && !RAND(第2章イベントセリフ出現確率)
			PRINTFORMW 「좀 의문이 들었는데, %CALLNAME:MASTER%씨는 가끔 이상한 것에 대해 잘 아시잖아요?」
			PRINTFORMW 「저기, 지난번 카나코님이나 스와코님의 정보 같은 거, 왠지 사적인 것까지 알고 계시고」
			PRINTFORMW 「도대체 어디서 그런 정보를 얻으시는 거예요?」
			PRINTFORMDW 알려달라고 사나에에게 졸여지는 %조사처리(CALLNAME:MASTER,"는")% 난감해했다.
			RETURN 1
		ENDIF
		;「あくまでも協力員」No.12選択
		IF EVENT_CHECK_K31(12) && !RAND(第2章イベントセリフ出現確率)
			PRINTFORMW 「역시, 비가 오면 바깥세상하고 달라서 힘들죠-」
			PRINTFORMW 「건조기 같은 것도 없으니까 기본적으로 빨래는 안 마르고, 누수도 하고...」
			PRINTFORMW 「응? 누수요? 해요?」
			PRINTL 
			PRINTFORMDW ...빗물 누수라는 이로움(웅얼거린다)
			PRINTFORMW 「그거, 아직도 말씀하세요!? 저희 집에는 비가 새지 않는 이로움 같은 건 없어요!」
			PRINTFORMW 「……스즈코님이 '그거, 가능할지도'라며 말씀하셨지만, 그런 이로움을 제가 인정 못 해요!」
			RETURN 1
		ENDIF
		;「奇跡のありがたみ」No.13選択
		IF EVENT_CHECK_K31(13) && !RAND(第2章イベントセリフ出現確率 - 1)
			IF !RAND(2)
				PRINTFORMW 「'힘'이란 대체 뭘까? 요즘 그런 생각이 들어요」
				PRINTFORMW 「힘이 필요해서 이곳에 왔는데, 힘을 보여주지 않으면 권유할 수 없잖아...」
				PRINTFORMW 「뭐랄까요, 저희가 하고 있는 일 자체가 자기모순을 안고 있다는 걸요」
			ELSE
				PRINTFORMW 「그러고 보니, %조사처리(CALLNAME:MASTER,"는")% 일반인이시죠?」
				PRINTFORMW 「어째서... 그게... 죄송해요, 이런 걸 가볍게 물어볼 사이가 아니었네요. 잊어주세요.」
			ENDIF
			RETURN 1
		ENDIF
		;「お手伝いさん？」No.14選択
		IF EVENT_CHECK_K31(14) && !RAND(第2章イベントセリフ出現確率 - 1)
			PRINTFORMW 「권유할 때 건네는 종이도 얼마 남지 않았네요.」
			PRINTFORMW 「어디서 인쇄하냐고요? 텐구 쪽 시설을 빌려서 하고 있어요!」
			PRINTFORMW 「요괴들의 기술에 감사하게 되네요.」
			RETURN 1
		ENDIF
		;「神としての早苗さん」No.15選択
		IF EVENT_CHECK_K31(15) && !RAND(第2章イベントセリフ出現確率 - 2)
			PRINTFORMW 「그렇답니다, 저도 일응 신이니까요?」
			PRINTFORMW 「뭐, 그렇게까지 경배하실 필요는 없고, 경배받고 싶지도 않지만.」
			PRINTFORMW 「지금 정도의 거리감으로 대화하는 게 편해요, %CALLNAME:MASTER%씨도 그렇게 생각하지 않으세요?」
			RETURN 1
		ENDIF
		;「人としての早苗さん」No.16選択
		IF EVENT_CHECK_K31(16) && !RAND(第2章イベントセリフ出現確率 - 2)
			PRINTFORMW 「그거 사실인가요!?」
			PRINTFORMDW 거짓말이야.
			PRINTFORMW 「무슨 거짓말이세요... 또, 저를 놀리고 가지고 놀았던 거네요!? 그만두세요ー」
			PRINTL 
			PRINTFORMDW ...역시 사나에를 놀려대는 건 즐겁다.
			PRINTFORMW 「지금 '사나에를 놀려대는 건 즐겁다'라고 생각하고 있었죠!? 얼굴을 보면 알 수 있다고요!」
			RETURN 1
		ENDIF
		;==========================================================
		;特殊セリフ(特定のイベントを踏んでいる場合にのみ出現)
		;「第2章　信者獲得大作戦」				イベントID:20
		;==========================================================
		;「風祝としての力」No.21選択
		IF EVENT_CHECK_K31(21) && !RAND(第2章イベントセリフ出現確率)
			PRINTFORMW 「그 침대, 잠은 어때요?」
			PRINTFORMW 「이름에 '행복'이라고 붙어 있으니, 물을 필요도 없겠죠.」
			PRINTFORMW 「그렇게 좋다면, 저도 써 보고 싶네요.」
			RETURN 1
		ENDIF
		;「信じてと言われても…」No.22選択
		IF EVENT_CHECK_K31(22) && !RAND(第2章イベントセリフ出現確率)
			PRINTFORMW 「그나저나 소원 건 말인데, %CALLNAME:MASTER%님이 바보 같은 소리를 하고 얼버렸지만」
			PRINTFORMW 「슬슬 진정한 소원을 알려주지 않겠어? 설마 그게 진짜 소원이 아니겠지?」
			PRINTFORMDW 설마 정말 팬티가 갖고 싶다고 말 못 하는 %CALLNAME:MASTER%였나
			RETURN 1
		ENDIF
		;「儚き信仰のために」No.23選択
		IF EVENT_CHECK_K31(23) && !RAND(第2章イベントセリフ出現確率 - 1)
			PRINTFORMW 「확실히, 권유하고 있는 것은 신앙을 통해 힘을 얻기 위함이긴 하지만…」
			PRINTFORMW 「무엇보다 첫째는 여러분들이 행복해지기 위해서니까요?」
			PRINTFORMW 「그 점은 착각하지 않도록 항상 마음먹고 있습니다!」
			RETURN 1
		ENDIF
		;「力であつめる信仰」No.24選択
		IF EVENT_CHECK_K31(24) && !RAND(第2章イベントセリフ出現確率 - 1)
			PRINTFORMW 「내가 하고 있는 권유 같은 활동은 속칭 '계몽'이라고들 하지만, '망(蒙)' 따위는 절대 아닙니다.」
			PRINTFORMW 「여러분, 독선적인 권유는 한 번에 간파할 수 있으니까요.」
			PRINTFORMW 「조심하지 않으면, 다음은 나 자신입니다.」
			RETURN 1
		ENDIF
		;「信者獲得？」No.25選択
		IF EVENT_CHECK_K31(25) && !RAND(第2章イベントセリフ出現確率 - 2)
			PRINTFORMW 「최근, 뭔가 멍한 일이 많지 않으신가요?」
			PRINTFORMW 「저기, 지난번 권유 때도 빠지셨잖아요...」
			PRINTFORMW 「사나에에게 정신 팔려 있었다니... 우우... 부끄러워서 이 이야기는 여기서 끝내겠습니다!」
			RETURN 1
		ENDIF
		;「外から支える屋台骨」No.26選択
		IF EVENT_CHECK_K31(26) && !RAND(第2章イベントセリフ出現確率 - 2)
			PRINTFORMDW 최근 사나에의 권유는 상당히 좋아졌다.
			PRINTFORMW 「정말인가요!? 기뻐요, 언제나 가까이 있는 %CALLNAME:MASTER%님의 목소리라서 더욱 그렇네요!」
			PRINTL 
			PRINTFORMW 「그나저나, 어느 쪽이 좋아졌나요?」
			PRINTFORMW 「……'수상하지 않게 되었다'는 게 칭찬받고 있는 건가요...?」
			RETURN 1
		ENDIF
		;==========================================================
		;特殊セリフ(特定のイベントを踏んでいる場合にのみ出現)
		;「第2章　くじで繋がる縁」			イベントID:10010
		;==========================================================
		;「満更でもなかったり」No.10011選択(3章以降では選択させないように)
		IF EVENT_CHECK_K31(10011) && !RAND(第2章イベントセリフ出現確率) && CHAPTER_今何章？_K31() == 2
			PRINTFORMW 「어쨌든, 평소처럼 지내면 언젠가는 이상한 소문도 사라질 거예요.」
			PRINTFORMW 「%CALLNAME:MASTER%님께 폐를 끼치게 되었지만, 조금만 더 참아주세요.」
			PRINTFORMW 「그래도... 천공 분들에게 '기사에 올리지 말라'고 말했던 건 지금 생각하니 실패였네요...」
			PRINTFORMW 「뭔가 있을 거라고 말하고 있었던 거죠.」
