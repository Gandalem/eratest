@M_KOJO_MESSAGE_COM_K31_414
;早苗さん口上に関しては地の文はこちらで書くのでオミット
CALL M_KOJO_MESSAGE_COM_K31_414_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K31_414_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;#####################################################
	;地の文表示
	;EVENT_MESSAGE_COM400から
	;TFLAG:194系のを表示させないように(口上とかぶっちゃう)
	;#####################################################
	IF TARGET > 0 && !CFLAG:TARGET:睡眠
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")%\@ GET_TARGETNUM() > 1 ? 모두 #  \@를 식사에 초대했다.
		;ELSEIF TARGET > 0 && CFLAG:TARGET:衰弱
		;	PRINTFORML %CALLNAME:PLAYER%は%CALLNAME:TARGET%に食事を取らせた
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 혼자 말없이 식사를 했다...
	ENDIF
	;第6章解放 関係性:恋人(好感度A信頼度A)
	IF CFLAG:31:3106 != -1
		;第5章解放 関係性:恋慕(好感度B信頼度B)
		;第4章解放 関係性:思慕(好感度C信頼度C)
	ELSEIF CFLAG:31:3104 != -1
		;第3章解放 関係性:友人(好感度D信頼度D)
		;第2章解放 関係性:知人(好感度E信頼度E)
		;第1章解放 関係性:他人(好感度G信頼度G)
	ELSEIF CFLAG:31:3101 != -1
		;#####################################################
		;口上表示
		;
		;#####################################################
		;1章(料理する主体はあなた)
		;===============================
		;料理するところを見てた早苗さん
		;===============================
		IF TCVAR:31:350
			;料理技能
			SELECTCASE ABL:MASTER:44
				;0漫画レベルのメシマズ
				CASE 0
					PRINTFORMW 「……헉, ……아, 그걸 드시는 건가요...?」
					PRINTFORMDW 사나에는 겁먹은 듯 %조사처리(CALLNAME:MASTER,"에게")% 묻는다.
					;外見が特徴的なもの(外見すらヤバいもの)をピックアップ
					SELECTCASE DISHNAME
						;1:冒涜的なサンドイッチ
						;2:米が紫のおにぎり
						CASE "おにぎり"
							PRINTFORMW 「왜냐면, 쌀이 보라색이라는 건 들어본 적 없어요!」
							;3:お肉が青いハンバーガー
						CASE "ハンバーガー"
							PRINTFORMW 「……아, 저 파란 고기는 어떻게 된 거죠!?」
							;4:バターの代わりに××をいれたスコーン
						CASE "スコーン"
							PRINTFORMW 「아까 맛을 봤는데, 이상했어요.」
							PRINTFORMW 「...절대 버터 안 넣으셨죠?」
							;5:ひと目見ただけでわかるシウマイ
						CASE "シウマイ"
							PRINTFORMW 「아무리 봐도 '먹지 마, 위험해'잖아요」
							PRINTFORMW 「...어느 각도에서 보더라도 안 된다는 걸 알게 되는 건, 어떤 의미에서는 대단하지만.」
							;6:前衛芸術『肉まん』
						CASE "肉まん"
							PRINTFORMW 「요리와 미술을 뒤섞고 있는 %CALLNAME:MASTER%님은 모르시겠지만!」
							PRINTFORMW 「......저걸 먹겠다고 하는 사람은 없는 게 아닐까요? ......아, 여기 한 분 계신가...」
							;7:本場(のまずいとこ)を忠実に再現したフィッシュ＆チップス
							;8:生地が石のタコス
							;9:かつてない新食感のたこ焼き
							;汎用セリフ
						CASEELSE
							PRINTFORMW 「……어떻게 하면 이런 색이 되는 건가요!?」
							PRINTFORMDW 어차피 위 속에 들어가면 색 같은 건 상관없을 텐데 잔소리하는 무녀다
							PRINTFORMW 「……그런 문제가 아니라고요!?」
					ENDSELECT
					;スコーンはすでに味見済みなので口上が変化
					IF FLAG:料理 == 4
						PRINTFORMDW 운 나쁘게 실패한 것을 먹었을 뿐이라고 사나에를 달래며 억지로 요리를 먹였다.
					ELSE
						PRINTFORMDW 외모가 나쁠 뿐 맛은 별거 없다고 사나에를 달래며 억지로 요리를 먹였다.
					ENDIF
					;-----------------------------------
					;ここからは食べた後の反応
					;TFLAG:193 ==  1 …大成功
					;TFLAG:193 ==  0 …成功
					;TFLAG:193 == -1 …失敗
					;-----------------------------------
					SELECTCASE TFLAG:193
						CASE 1
							PRINTFORMW 「…어라? 평범하게... 맛있다니?」
							PRINTFORMW 「대단해요, 이거! 눈을 감고 먹으면 그저 맛있는 요리예요!」
