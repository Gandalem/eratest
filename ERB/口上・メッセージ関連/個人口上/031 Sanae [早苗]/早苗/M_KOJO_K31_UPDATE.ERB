;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"UPDATE判定"
;※※※※※※※※※※※※※※※※※※※※※※※※※※

@M_KOJO_UPDATE_K31
;口上独自のUPDATE用
;ENCOUNTER専用に独自分岐フラグを仕込んだ場合等にどうぞ
;UPDATE判定でCFLAGを使う場合、キャラ番号の指定が必要になります
;現在のverはver0.03です
#DIM CONST 早苗口上ver = 3
#DIM 現在のver整数
#DIM 現在のver小数
#DIM 早苗口上ver整数
#DIM 早苗口上ver小数
;ver0.02以前にはこのUPDATE CHECKはなかったので
SIF !CFLAG:31:K31_CFLAG_SYSTEM_VERSION
	CFLAG:31:K31_CFLAG_SYSTEM_VERSION = 2
;PRINTFORM中に%を登場させて変な感じにさせたくないのでここで変換
現在のver整数 = CFLAG:31:K31_CFLAG_SYSTEM_VERSION / 100
現在のver小数 = CFLAG:31:K31_CFLAG_SYSTEM_VERSION % 100
早苗口上ver整数 = 早苗口上ver / 100
早苗口上ver小数 = 早苗口上ver % 100
CALL M_KOJO_COLOR_K31
;アップデート時の頭の文章
PRINTL 
PRINTL --사나에 대화 업데이트 확인--
RESETCOLOR
;『素質の変更』を行っている場合早苗の清掃技能は0になるが
;本体のUPDATEによってCSVの値が読み込まれてしまうため再修正を行う
;ほんとはUPDATE書き換えて、早苗だけ無効にしたいけどバグの温床になりそうなんでやめる
IF CFLAG:31:3121 == 1
	;---清掃技能　( D 1 → E 0)---
	;---清掃経験　( 20 → 4)---
	;流石に、料理までつけると素質盛りすぎ状態なので（技能にEがひとつもないとかいう状態）清掃技能に下方修正
	;既に技能,経験が育っている場合は変更しない
	IF ABL:31:40 == 1 && EXP:31:70 < 21
		PRINTL 
		PRINTL 이 업데이트로 인해 사나에의 스킬이 수정된다.
		PRINTL 
		PRINT 	청소 레벨(
		CALL PRINT_RANK(ABL:31:40,"MAX_6")
		PRINTFORM  {ABL:31:40} →
		CALL PRINT_RANK(0,"MAX_6")
		RESETCOLOR
		PRINTL  0)
		PRINTFORML 	청소경험({EXP:31:70} → 4)
		ABL:31:40 = 0
		EXP:31:70 = 4
	ENDIF
ENDIF
;--------------------------------------------------------------------------------------------
;早苗口上のバージョンチェック
;--------------------------------------------------------------------------------------------
;同じバージョンの場合
IF 早苗口上ver == CFLAG:31:K31_CFLAG_SYSTEM_VERSION
	PRINTL 
	PRINTFORML %"Current: Ver " + TOSTR(現在のver整数) + "." + TOSTR(現在のver小数,"D2")%
	PRINTFORML %"New    : Ver " + TOSTR(早苗口上ver整数) + "." + TOSTR(早苗口上ver小数,"D2")%
	PRINTL 
	PRINTFORML 최신 버전이 적용되었습니다. 업데이트가 필요하지 않습니다.
	RETURN 1
ENDIF
;ダウングレードしようとしてる～
IF 早苗口上ver < CFLAG:31:K31_CFLAG_SYSTEM_VERSION
	PRINTL 
	SETCOLOR C_RED
	PRINTFORML 【경고!】현재 적용된 버전보다 이전 버전이 적용되려고 합니다!
	RESETCOLOR
	PRINTL 
	PRINTFORML %"Current: Ver " + TOSTR(現在のver整数) + "." + TOSTR(現在のver小数,"D2")%
	SETCOLOR C_RED
	PRINTFORML %"New    : Ver " + TOSTR(早苗口上ver整数) + "." + TOSTR(早苗口上ver小数,"D2")%
	RESETCOLOR
	PRINTL 
	PRINTL 업데이트를 계속 진행하시겠습니까?
	PRINTL -YES는 자신이 무엇을 하는지 알고 있을 때만 사용해야 합니다-
	PRINTL *버그가 발생하면 당신 책임입니다*
	PRINTFORML [0]-YES(해당 버전으로 강제 변경)
	PRINTFORML [1]-NO
	INPUT
	IF !RESULT
		PRINTL 업데이트를 계속하겠습니다. 버그에 유의해 주십시오.
	ELSE
		PRINTL 업데이트를 중단합니다. 최신 버전을 받아주세요.
		RETURN 1
	ENDIF
ENDIF
IF 早苗口上ver > CFLAG:31:K31_CFLAG_SYSTEM_VERSION
	PRINTL 
	SETCOLOR C_YELLOW
	PRINTFORML 이제 새로운 버전으로 업데이트합니다.
	RESETCOLOR
	PRINTL 
	PRINTFORML %"Current: Ver " + TOSTR(現在のver整数) + "." + TOSTR(現在のver小数,"D2")%
	CALL M_KOJO_COLOR_K31
	PRINTFORML %"New    : Ver " + TOSTR(早苗口上ver整数) + "." + TOSTR(早苗口上ver小数,"D2")%
	RESETCOLOR
ENDIF
;####################################################
;ここからバージョンのアップデートが始まる
;####################################################
;----------------------------------------------------
;面識の剥奪(Ver 0.01より)
;----------------------------------------------------
;口上的には「最初から」みたいなもの　バージョンアップで仕様が変わった場合や、他のルートに行きたい時とかにどうぞ
;本当はフラグ等のリセットは初対面時に行っている
IF CFLAG:31:18 != 0
	PRINTL 
	PRINTL -----지인 관련-----
	PRINTL 사나에 씨는 이미 만났다.
	PRINTL 업데이트라면 지인 초기화를 강력히 권장한다.
	PRINTL 초기화하면 모든 플래그도 리셋된다.
	PRINTL 번역되지 않은 「readme.txt」를 읽어보면 업데이트 시 도움이 될 수도 있다.
	PRINTL 업데이트할 때 플래그가 변경될 가능성이 있다.
	PRINTL (따라서, 플래그를 초기화하지 않으면 버그가 발생할 수 있다)
	PRINTL 
	PRINTFORML [0]-다시 초기화한다
	PRINTFORML [1]-문제없다
	INPUT
	IF !RESULT
		CFLAG:31:18 = 0
		PRINTL 지인 관계가 초기화됩니다.
	ELSE
		PRINTL 친분은 초기화되지 않는다.
	ENDIF
ENDIF
CFLAG:31:3120 = 早苗口上ver
;PRINTFORM中に%を登場させて変な感じにさせたくないのでここで変換
現在のver整数 = CFLAG:31:K31_CFLAG_SYSTEM_VERSION / 100
現在のver小数 = CFLAG:31:K31_CFLAG_SYSTEM_VERSION % 100
PRINTL 
PRINTL 업데이트가 완료되었다.
CALL M_KOJO_COLOR_K31
PRINTFORML 현재는 %"Ver " + TOSTR(現在のver整数) + "." + TOSTR(現在のver小数,"D2")%
RESETCOLOR
PRINTL 
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;Custom dialogue settings, custom code
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;made it as a way to speed up the update process and separate simple flag updates from various customization options
;note: options start from 1!

@KOJO_OPTION_K31
CALL KOJO_OPTION_ITEM("Set stats to match the dialogue", 1, "cond", (ABL:31:44 < 2 || EXP:31:79 < 200 || EXP:31:76 < 50 || EXP:31:70 < 50))
;process the input portion
;----------------------------------------------------
;素質の変更(Ver 0.03より)
;----------------------------------------------------

@KOJO_OPTION_K31_RESULT_1
PRINTL 
;要するに、今のままだと口上の内容と技能・素質が噛み合わない場合があるのでそれが気になる人はどうぞ
PRINTL 사나에 씨의 능력과 경험은 대화에 맞춰 변경될 수 있다.
PRINTL 그 변경은 실제로 대화에 영향을 주지 않는다. 단지 몰입감을 위한 것이다.
;PRINTL 『この子メシマズのくせになんか語ってる…』が気になる方は変更をどうぞ
PRINTL 
PRINTL 변경될 능력들
;---[音楽知識]付与(正確には、楽器知識)---
;音楽技能がBであることにともなって追加
;流石にみすちーとか九十九姉妹と同じレベルで何もないというのも
;なんか[演奏する]の地の文が変化するらしいのでコメントアウト
;自力で取れるらしいので頑張ろう(演奏経験1000+技巧4以上)
;IF !TALENT:31:音楽知識
;	PRINTL [音楽知識]追加
;	PRINTL
;ENDIF
;---演奏経験　( 0 → 200)---
;音楽技能がBであることにともなって追加
SIF EXP:31:79 < 200
	PRINTFORML 	음악 공연 경험치({EXP:31:79} → 200)
;---料理技能　( E 0 → C 2)---
;音楽技能と間違えられたクッソ哀れな子
;流石に可哀想なので追加
IF ABL:31:44 < 2
	PRINT 	요리 레벨(
	CALL PRINT_RANK(ABL:31:44,"MAX_6")
	PRINTFORM  {ABL:31:44} →
	CALL PRINT_RANK(2,"MAX_6")
	RESETCOLOR
	PRINTL  2)
ENDIF
;---料理経験　( 0 → 50)---
;料理技能がCであることにともなって追加
;料理技能をつけようとして音楽技能がついてるっぽい早苗さんに料理技能及び料理経験をつける
;3人揃って技能0のメシマズ神社救済法案
SIF EXP:31:76 < 50
	PRINTFORML 	요리경험({EXP:31:76} → 50)
;---清掃技能　( D 1 → E 0)---
;---清掃経験　( 20 → 4)---
;流石に、料理までつけると素質盛りすぎ状態なので（技能にEがひとつもないとかいう状態）清掃技能に下方修正
;既に技能,経験が育っている場合は変更しない
IF ABL:31:40 == 1 && EXP:31:70 < 21
	PRINT 	청소 레벨(
	CALL PRINT_RANK(ABL:31:40,"MAX_6")
	PRINTFORM  {ABL:31:40} →
	CALL PRINT_RANK(0,"MAX_6")
	RESETCOLOR
	PRINTL  0)
	PRINTFORML 	청소경험({EXP:31:70} → 4)
ENDIF
PRINTL 
PRINTL 변경 사항을 적용할까요?
CALL ASK_YN
SELECTCASE RESULT
	;変更しました
	CASE 0
		CFLAG:31:3121 = 1
		PRINTL 변경됨.
		;変更内容はここに記述
		;SIF !TALENT:31:音楽知識
		;	TALENT:31:音楽知識 = 1
		SIF EXP:31:79 < 200
			EXP:31:79 = 200
		SIF ABL:31:44 < 2
			ABL:31:44 = 2
		SIF EXP:31:76 < 50
			EXP:31:76 = 50
		IF ABL:31:40 == 1 && EXP:31:70 < 21
			ABL:31:40 = 0
			EXP:31:70 = 4
		ENDIF
		PRINTW 
		;変更させません
	CASEELSE
		CFLAG:31:3121 = -1
		PRINTL 변경되지 않았다.
		PRINTW 
ENDSELECT
;============================================================
;[1]、[2]を選んだけれどもどうしてももう一度選択肢を選びたい時
;1.CFLAG:31:3121 = 0 にする
;============================================================
