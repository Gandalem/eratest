;90,アナル愛撫される
;==================================================

@M_KOJO_早苗追加_MESSAGE_COM_K31_90
CALL M_KOJO_早苗追加_MESSAGE_COM_K31_90_1
RETURN RESULT

@M_KOJO_早苗追加_MESSAGE_COM_K31_90_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕 || TALENT:恋人
		IF ABL:MASTER:Ａ感覚 <= 1
			PRINTFORML 「아직 위화감이 있나요? 천천히 개발해 나가도록 해요 %UNICODE(0x2665) *1%」
			PRINTFORML 「우선 힘을 빼고, 쾌감에 집중해 보세요」
			PRINTFORML 「%CALLNAME:MASTER%님이 엉덩이로 가버리는 부끄러운 모습, 저 기대하고 있을게요... %UNICODE(0x2665) *1%」
		ELSEIF ABL:MASTER:Ａ感覚 <= 3
			PRINTFORML 「꽤 기분 좋아 보이네요 %UNICODE(0x2665) *1% 표정에서 다 보여요 %UNICODE(0x2665) *1%」
			PRINTFORML 「여기가 좋은 건가요? %UNICODE(0x2665) *1% 아니면 여기가 좋을까요? 이쪽은 어떤가요? %UNICODE(0x2665) *1%」
			PRINTFORML  사나에는 당신의 가장 약한 부분을 찾고 있는 것 같다...
			PRINTFORML 「앗, 방금 움찔했네요 %UNICODE(0x2665) *1% 여기가 좋은 거군요, 후후후 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「아하하핫 %UNICODE(0x2665) *1% 부들부들 떨고 있어서 정말 귀엽네요 %UNICODE(0x2665) *1%」
			PRINTFORML  너무나 큰 쾌감에 몸을 비틀며 도망치려 했지만 붙잡히고 말았다...
			PRINTFORML 「놓아주지 않을 거예요 %UNICODE(0x2665) *1% 기분 좋죠? %UNICODE(0x2665) *1% 자 %UNICODE(0x2665) *1% 자 %UNICODE(0x2665) *1%」
			PRINTFORML 「오고 싶다면 언제 와도 괜찮으니까요…… %UNICODE(0x2665) *1%」
		ENDIF
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:思慕
		IF ABL:MASTER:Ａ感覚 <= 1
			PRINTFORML 「아직 이질감이 있나요? 천천히 개발해 나갑시다 %UNICODE(0x2665) *1%」
			PRINTFORML 「우선 힘을 빼고, 쾌감에 집중해 보세요」
		ELSEIF ABL:MASTER:Ａ感覚 <= 3
			PRINTFORML 「꽤 기분 좋아 보이네요 %UNICODE(0x2665) *1% 표정에서 다 보여요 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「아하하! %UNICODE(0x2665) *1% 벌벌 떨고 있네요 %UNICODE(0x2665) *1%」
		ENDIF
		PRINTFORMW 
		RETURN 1
	ELSE
		PRINTFORML 「후후, 어때요?」
		PRINTFORMW 
		RETURN 1
	ENDIF
	CALL K31_MASTER逆転経験取得(1)
ENDIF
RETURN 1
