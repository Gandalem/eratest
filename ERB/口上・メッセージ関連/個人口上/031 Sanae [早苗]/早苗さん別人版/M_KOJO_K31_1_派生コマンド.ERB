;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_早苗追加_MESSAGE_SCOM_K31_6
CALL M_KOJO_早苗追加_MESSAGE_SCOM_K31_6_1
RETURN 1

@M_KOJO_早苗追加_MESSAGE_SCOM_K31_6_1
;custom code, moved from M_KOJO_早苗追加_MESSAGE_COM_K31_72
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「하아... 응응윽... 쿠우... %UNICODE(0x2665) *1% 거기는! %UNICODE(0x2665) *1%」
				PRINTFORML 「무우... %UNICODE(0x2665) *1% 꽤 적절한 움직임을... %UNICODE(0x2665) *1%」
			CASE 2
				PRINTFORML 「거기... 응... 으앗앗... %UNICODE(0x2665) *1%」
				PRINTFORML 「후우... %UNICODE(0x2665) *1% 후후... 그 기세예요... 아앗 %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「응아… %UNICODE(0x2665) *1% 후후…… 그래요… 거기가 기분 좋은 거예요… %UNICODE(0x2665) *1%」
				PRINTFORML 「알겠어요 %UNICODE(0x2665) *1% 제대로 기억해 주세요 %UNICODE(0x2665) *1% 후훗 %UNICODE(0x2665) *1%」
		ENDSELECT
	ELSEIF TALENT:思慕
		PRINTFORML 「하아... 응응윽... 쿠우... %UNICODE(0x2665) *1% 거기는! %UNICODE(0x2665) *1%」
		PRINTFORML 「무우... %UNICODE(0x2665) *1% 꽤 적절한 움직임을... %UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「하아앗... 으응! 크윽... %UNICODE(0x2665) *1% 거기는! %UNICODE(0x2665) *1%」
	ENDIF
	PRINTFORMW
ENDIF
RETURN 1
;==================================================
;7,挿入子宮口責め
;==================================================

@M_KOJO_早苗追加_MESSAGE_SCOM_K31_7
CALL M_KOJO_早苗追加_MESSAGE_SCOM_K31_7_1
RETURN 1

@M_KOJO_早苗追加_MESSAGE_SCOM_K31_7_1
;custom code, moved from M_KOJO_早苗追加_MESSAGE_COM_K31_73
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF EXP:子宮口開発経験 > 30
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「奥にぃ…入て읏…くぅ… %UNICODE(0x2665) *1% ううう읏 %UNICODE(0x2665) *1%」
					PRINTFORML 「あ읏…… %UNICODE(0x2665) *1% だめです… %UNICODE(0x2665) *1% 降りてこられない읏… %UNICODE(0x2665) *4%」
				CASE 2
					PRINTFORML 「거기읏%UNICODE(0x2665) *1%……으응읏!%UNICODE(0x2665) *1%……대단해앳…%UNICODE(0x2665) *1%」
					PRINTFORML 「아앗…%UNICODE(0x2665) *1%　　아하아앗%UNICODE(0x2665) *1%……이거앗…정말 안 돼요읏%UNICODE(0x2665) *3%」
				CASEELSE
					PRINTFORML 「응아... %UNICODE(0x2665) *1% 이것은... 강렬하네요...윽 %UNICODE(0x2665) *2%」
					PRINTFORML 「몇 번이나 찔려서 %UNICODE(0x2665) *1% 개발되어 버렸어요 %UNICODE(0x2665) *1% 아하아아 %UNICODE(0x2665) *2%」
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORML 「안쪽으로... 들어가줘...끄으윽...%UNICODE(0x2665) *1% 우우욱%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORML 「하아앗... 응응읏... 크윽... %UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF EXP:子宮口開発経験 > 15
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「안... 들어와 있어...... 우으 %UNICODE(0x2665) *1%」
					PRINTFORML 「앗...... %UNICODE(0x2665) *1% 점점... 기분 좋아져... %UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORML 「거기는앗%UNICODE(0x2665) *1%……응%UNICODE(0x2665) *1%……어라…%UNICODE(0x2665) *1%」
					PRINTFORML 「어째서……괴로운데도앗%UNICODE(0x2665) *1%……이렇게앗%UNICODE(0x2665) *1%」
				CASEELSE
					PRINTFORML 「んぁ…%UNICODE(0x2665) *1% これは………읏%UNICODE(0x2665) *2%」
					PRINTFORML 「ふぅ읏……%UNICODE(0x2665) *1% %CALLNAME:MASTER%さんが何度も突くせいで…%UNICODE(0x2665) *1% 開発されてきて읏%UNICODE(0x2665) *2%」
			ENDSELECT
		ELSE
			PRINTFORML 「하아... 응응! 크윽...」
		ENDIF
	ELSE
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「뒤에......이건윽...」
					PRINTFORML 「아무리 그래도... 괴롭습니다...」
				CASE 2
					PRINTFORML 「응? 으윽...! 아, 아파요...」
				CASEELSE
					PRINTFORML 「앗...후우...좀, 너무 깊어요...」
					PRINTFORML 「여기는...아직...그렇게...」
			ENDSELECT
		ELSE
			PRINTFORML 「크윽... 우으...」
		ENDIF
	ENDIF
	PRINTFORMW
ENDIF
RETURN 1
