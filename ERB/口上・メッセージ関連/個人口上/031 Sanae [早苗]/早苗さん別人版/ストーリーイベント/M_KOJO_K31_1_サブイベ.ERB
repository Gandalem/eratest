; Modular ERB: 個人口上/031 Sanae [早苗]/早苗さん別人版/ストーリーイベント/M_KOJO_K31_1_サブイベ.ERB

@K31_サブイベント1_表示条件(ARGS)
;IFの条件がストーリ表示条件
;ARGSはコマンドの名前（口上の各コマンド部分で引数として手動で持ってきてるので注意）（←ガバガバコーディング）
;RETURN1で表示フラグON
IF ARGS == "会話" && CFLAG:31:1012 >= 5 && CFLAG:31:1001 > 1
	;ストーリー2話以降で発生、発生後5日以上経つと再発生
	CFLAG:31:1012 = 0
	;CFLAG:31:1012は口上イベントERBで毎日1増える
	RETURN 1
ENDIF
RETURN 0

@K31_サブイベント1_出力
;ストーリーはここにゴリゴリ書く
;LOCALに今の所持金を退避
FONTSTYLE 1
PRINTFORMDW 　　◆서브 이벤트◆「술 정기 납품」
PRINTL 
FONTREGULAR
IF CFLAG:31:1011 == 0
	PRINTFORMW 「앗, %CALLNAME:MASTER%씨」
	PRINTFORMW 「%CALLNAME:MASTER%씨의 주조 솜씨는 대단하다고 들었습니다」
	PRINTFORMW 「만약 술이 남는 게 있다면 정기적으로 사 가겠습니다」
	PRINTFORMW 「물론 여유가 없을 때는 거절하셔도 괜찮아요」
	PRINTFORMW 「그럼, 그쪽으로 잘 부탁드립니다!」
	CFLAG:31:1011 = 1
ELSEIF CFLAG:31:1011 == 1
	PRINTFORML 「아, %CALLNAME:MASTER%씨」
	PRINTFORMW 「남은 술이 있다면 팔아주실 수 있나요?」
	PRINTFORML
	PRINTFORMDL [0] 괜찮아
	PRINTFORMDL [1] 다음에 하자
	INPUT
	PRINTFORML
	IF RESULT == 0
		LOCAL = MONEY
		PRINTFORML 뭘 팔까...소지금:%金額表示(MONEY)%
		CALL 酒一覧表示(0, "売却", 70)
		IF RESULT == 0
			PRINTFORML 「역시 그만두시게요?」
			PRINTFORML 「알겠습니다!」
			PRINTFORMW 「다음에 다시 여쭤볼게요!」
			RETURN -1
		ENDIF
		IF ITEM:RESULT == 0
			PRINTW 물건이 없어서 팔려고 해도 팔 수 없다.
			PRINTFORML 「물건이 없는 것 같네요...」
			PRINTFORMW 「급한 것도 아니라, 다음에 다시 여쭤볼게요!」
			RETURN -1
		ENDIF
		SIF ALC_NAME(RESULT) != ""
			PRINTFORMW 「오, %ALC_NAME(RESULT)%인가요」
		SELECTCASE RESULT
			CASE 51,56;どぶろく・甘酒
				PRINTFORMW 「이 정도라면 저도 마실 수 있을 것 같아요」
			CASE 52,55;清酒・御神酒
				PRINTFORMW 「제물로 바치기 좋겠네요, 감사합니다」
			CASE 59;薬酒
				PRINTFORMW 「건강 증진에 효과가 있을 것 같네요」
			CASE 53,58;鬼殺し・蒸留酒
				PRINTFORMW 「저에게는 강하지만, 좋아하는 사람도 많네요」
			CASEELSE
				PRINTFORMW 「오오...? 이건 꽤나 희귀한 것을...」
		ENDSELECT
		ITEM:RESULT -= 1
		;CALL GET_MONEY_YEN(1000, 2)
		MONEY += ITEMPRICE:RESULT * 70 / 100
		PRINTL
		PRINTFORML 소지금:%金額表示(LOCAL)% → %金額表示(MONEY)%
		PRINTL
		PRINTFORMW 「감사했습니다, 또 부탁드려요」
		CALL CHANGE_CFLAG(2, 31, 50)
		CALL CHANGE_CFLAG(4, 31, 30)
		CALL KIGEN_CHANGE(31,100,1)
	ELSEIF RESULT == 1
		PRINTFORML 「알겠습니다!」
		PRINTFORMW 「다음에 또 여쭤볼게요.」
	ENDIF
ENDIF
RETURN 1
