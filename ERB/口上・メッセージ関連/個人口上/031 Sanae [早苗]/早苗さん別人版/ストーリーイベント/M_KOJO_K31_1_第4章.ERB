@K31_ストーリー_第4章_第1節_出力
;ストーリーはここにゴリゴリ書く
IF CFLAG:31:1411 == 0
	CFLAG:31:1411 = 1
	CALL K31_ストーリー_第4章_第1節_出力_開始時
	RETURN 1
ELSE
	CALL K31_ストーリー_第4章_第1節_出力_終了後
	CFLAG:31:1411 = 2
ENDIF
RETURN 1

