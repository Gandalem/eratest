;刻印取得
;-------------------------------------------

@M_KOJO_早苗追加_MESSAGE_MARKCNG_K31
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW (이런 건, 버릇이 되어버릴 것 같아요……%UNICODE(0x2665) *1%)
ELSEIF TFLAG:23 == 2
	PRINTFORMW (아, 이제…… %UNICODE(0x2665) *1% 돌아가지 못할지도…… %UNICODE(0x2665) *1%)
ELSEIF TFLAG:23 == 3
	PRINTFORMW (이제………%UNICODE(0x2665) *1%　안 돼요……%UNICODE(0x2665) *1%)
	PRINTFORMW 「좀 더……읏%UNICODE(0x2665) *1%좀 더 부탁드려요……%UNICODE(0x2665) *3%」
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW (어라, 뭔가... %UNICODE(0x2665) *1%)
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW (음... 이 느낌... 뭐, 괜찮은 걸까....%UNICODE(0x2665) *1%)
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 「후후, 뭘까요... %UNICODE(0x2665) *1% 이거... %UNICODE(0x2665) *1%」
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 「……나를 화나게 하고 싶은 건가요?」
ELSEIF TFLAG:21 == 2
	PRINTFORMW 「......나는 넘어서는 안 되는 선이 있다고 생각해요」
ELSEIF TFLAG:21 == 3
	PRINTFORML 「이제 한계예요... 사라져 주세요」
	PRINTFORMDW 사나에가 무표정하게 중얼거렸을 때, 응답하듯 주변 일대가 소란스러운 분위기에 싸였다...
ENDIF
