;-------------------------------------------------
;立位
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && TFLAG:193 && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			IF TALENT:恋人
				PRINTFORMW 「……결국 이렇게 되는 건가요」
				PRINTFORMW 「이렇게까지 기다려 줄 거라고 솔직히 예상 못 했지만…」
				PRINTFORMW 「좋아요, %CALLNAME:MASTER%씨……」
				PRINTFORMW 「%CALLNAME:MASTER%씨라면, 바랄게요……」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「……아…후후…」
				PRINTFORMW 「……아뇨, 괜찮습니다…」
				PRINTFORMW 「%CALLNAME:MASTER%님과라면, 바랄 수 있습니다……」
			ELSE
				PRINTFORMW 「아...... 아니에요, 괜찮아요...」
				PRINTFORMW 「%CALLNAME:MASTER%님하고라면, 각오는 되어 있으니까...」
			ENDIF
			PRINTFORML 
			PRINTFORMW 애처로운 말에 %조사처리(CALLNAME:MASTER,"는")% 흥분을 참지 못하고 천천히 성기를 박아 넣었다.
			PRINTFORMW 단단하게 질 내부를 관통한 순간, 사나에는 표정을 일그러뜨리며 작게 신음했고 눈을 감았다.
			PRINTFORMW 갑자기 처음을 빼앗았다는 죄책감이 밀려왔지만, 따뜻하게 감싸 안는 쾌감 앞에 그런 기분은 순식간에 사라졌다.
			RETURN 1
		ELSE
			PRINTFORMW 
			;RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF TCVAR:100 == PLAYER ;挿入継続
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「앗, 또 연속으로…… 이 자세는!」
				PRINTFORMW 「후훗, 음음%UNICODE(0x2665) *1% 후우윽……」
			CASE 1
				PRINTFORML 「하아, 또 와버렸어……응, 크윽……아아……」
				PRINTFORMW 「아앗 %UNICODE(0x2665) *1% 음음! ...우아 %UNICODE(0x2665) *1%」
		ENDSELECT
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「정말, 참을 수 없으신 건가요...%UNICODE(0x2665) *1%」
			PRINTFORMW 「어쩔 수 없네요...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「정말, 참을 수 없는 건가요... %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
	RETURN 1
ENDIF
