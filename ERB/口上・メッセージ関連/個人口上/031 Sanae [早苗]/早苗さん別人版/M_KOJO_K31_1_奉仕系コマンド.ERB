@M_KOJO_早苗追加_MESSAGE_COM_K31_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70 ;時姦
	IF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「후후, 기분 좋으세요? %UNICODE(0x2665) *1%」
				PRINTFORML 「갈 때는 제대로 「갑니다」라고 말해야 해요 %UNICODE(0x2665) *1%」
			CASE 2
				PRINTFORML 「아하하, 기분 좋으시군요? %UNICODE(0x2665) *1%」
				PRINTFORML 「궁지에 몰린 표정의 %CALLNAME:MASTER%씨... 귀여워요 %UNICODE(0x2665) *1%」
			CASEELSE
				PRINTFORML 「좋은 얼굴이네요%UNICODE(0x2665) *1%」
				PRINTFORML 「자%UNICODE(0x2665) *1% 해봐%UNICODE(0x2665) *2% 가봐%UNICODE(0x2665) *3%」
		ENDSELECT
	ELSEIF TALENT:思慕
		PRINTFORML 「후후, 기분 좋으세요? %UNICODE(0x2665) *1%」
		PRINTFORML 「갈 때는 제대로 「갑니다」라고 말해야 해요 %UNICODE(0x2665) *1%」
	ELSE
		PRINTFORML 「후후, 기분 좋으세요?」
	ENDIF
	PRINTFORMW
ENDIF
RETURN 1
