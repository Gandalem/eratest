		CASE 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「음... 배려심이 깊으시네요」
					PRINTFORML 「이 과자, 괜찮으면 드세요」
				CASE 1
					PRINTFORML 「마침 목이 말랐는데, 감사합니다♪」
				CASE 2
					PRINTFORML 「음, 감사합니다」
					PRINTFORML (......어라? 지금 어디서 차를...?)
			ENDSELECT
		CASE 1
			PRINTFORML 「아, 이 차 맛있다……」
			PRINTFORML 「도대체 어디서 이런 기술을 배운 걸까…」
	ENDSELECT
	PRINTFORMW
ENDIF
RETURN 1
