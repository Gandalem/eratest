@M_KOJO_早苗追加_MESSAGE_COM_K31_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 멈춘 시간 속에서, %조사처리(CALLNAME:TARGET,"를")% 성 처리의 도구로 사용하기로 결정했다...
		RETURN 1
	ELSEIF TCVAR:泥酔
		PRINTFORML 「어라, 이건 뭐야...? ...우웩...」
		RETURN 1
	ENDIF
	;失敗
	IF TFLAG:194 != 0
		IF TFLAG:194 == 100
			CALL M_KOJO_早苗追加_COLOR_K31
			PRINTFORML 「사실은 공격받는 걸 좋아하는 거죠? 알고 있어요 %UNICODE(0x2665) *1%」
			PRINTFORML 「후훗 %UNICODE(0x2665) *1% 그런 기대하는 표정을 지으시면 저…… %UNICODE(0x2665) *1%」
			PRINTL
			RESETCOLOR
			RETURN 1
		ENDIF
		PRINTFORML 「잠깐!? 떨어져 주세요!」
		SELECTCASE TFLAG:194
			CASE 1 ;人目がある
				PRINTFORMW 「사람 눈에 띄는 곳에서는 안 돼요」
			CASE 2 ;野外は嫌
				PRINTFORMW 「여기, 밖에 있는데요……」
			CASE 3 ;多人数は嫌
				PRINTFORMW 「다인으로라니... 그건 아무리 그래도...」
			CASE 4 ;ムード不足
				PRINTFORMW 「……무드 같은 건, 생각하죠.」
		ENDSELECT
		RETURN 1
	ELSEIF TCVAR:抱き寄せ初回 >= 6 && TCVAR:抱き寄せ初回 <= 8
		SELECTCASE TCVAR:抱き寄せ初回
			CASE 6 ;まんざらでもない
				PRINTFORMW 「저기... 그게... 그런 건, 조금만 시간을 주세요...」
			CASE 7 ;ダメ
				PRINTFORML 「그런 것은 별로 좋지 않다고 생각해요」
				PRINTFORMW 「놔주세요」
			CASE 8 ;論外
				PRINTFORMW 「무슨 생각 하시는 거예요, 적당히 좀 해 주세요」
		ENDSELECT
		RETURN 1
	ENDIF
	;初回成功
	IF TCVAR:抱き寄せ初回 >= 1 && TCVAR:抱き寄せ初回 <= 5
		SELECTCASE TCVAR:抱き寄せ初回
			CASE 1 ;普通に合意ゲット
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「아…… 드디어, 말이죠」
					PRINTFORMW 「저, 기다리고 있었잖아요?」
				ELSEIF TALENT:思慕
					PRINTFORML 「...아...」
					PRINTFORMW 「잘, 잘 부탁드려요...?」
				ELSE
					PRINTFORML 「음……잠깐……」
					PRINTFORMDW 말만으로 큰 저항도 없다...
				ENDIF
			CASE 2 ;先にキスぐらいしろよ
				IF TALENT:恋人 || TALENT:恋慕
					PRINTFORML 「아……드디어, 그렇네요」
					PRINTFORMW 「단계, 너무 건너뛰는 것 같기도 하지만……」
				ELSEIF TALENT:思慕
					PRINTFORML 「...아... 에... 먼저 이쪽인가요...?」
					PRINTFORMW 「뭐, 괜찮지만...」
				ELSE
					PRINTFORML 「음……잠깐……」
					PRINTFORMDW 말만으로 큰 저항도 없다...
				ENDIF
			CASE 3 ;媚薬or発情には勝てなかったよお…
				PRINTFORML (뭔가 이상해요... 어떻게 하죠)
				PRINTFORMW 「응... 잠깐... 아...」
			CASE 4 ;悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
				PRINTFORML (저기... 왜 이럴까)
				PRINTFORML (몸이 저절로 반응해버려서...)
				PRINTFORMW 「왜... 이런 일이...」
			CASE 5 ;強引に迫られると断れぬ(素質臆病持ち専用)
				PRINTFORML
		ENDSELECT
		RETURN 1
	ENDIF
	;成功
	IF TALENT:恋人
		PRINTFORML 「음... %UNICODE(0x2665) *1%, 좋아요」
		PRINTFORML 「제대로 기분 좋게 해주세요 %UNICODE(0x2665) *1%」
		PRINTFORMW 「오늘은, 어떤 식으로 할까요...? %UNICODE(0x2665) *1%」
	ELSEIF TALENT:恋慕
		IF TALENT:MASTER:恋人
			PRINTFORML 「아...... %UNICODE(0x2665) *1% ......헤에...... %UNICODE(0x2665) *1%」
			PRINTFORML 「연인을 두고 바람이라니, 나쁜 사람이군요」
			PRINTFORMW (그걸 받아들이는 나도 대단하긴 하지만 말이야...)
		ELSE
			PRINTFORML 「음... %UNICODE(0x2665) *1%, 좋아요」
			PRINTFORML 「제대로 기분 좋게 해주세요 %UNICODE(0x2665) *1%」
			PRINTFORMW 「오늘은, 어떤 식으로 할까요...? %UNICODE(0x2665) *1%」
		ENDIF
	ELSEIF TALENT:思慕
		IF TALENT:MASTER:恋人
			PRINTFORML 「벌써... %UNICODE(0x2665) *1% 연인을 두고 바람이라니, 나쁜 사람이네요」
			PRINTFORMW (그걸 받아들이는 저도 제법 그렇지만요...)
		ELSE
			PRINTFORML 「아... %UNICODE(0x2665) *1% 또... %UNICODE(0x2665) *1%」
			PRINTFORMW 「네, 잘 부탁드립니다...」
		ENDIF
	ELSE
		PRINTFORML 「아...... %UNICODE(0x2665) *1%」
		PRINTFORMDL 전혀 저항할 기색이 없다...
	ENDIF
ENDIF
RETURN 1
