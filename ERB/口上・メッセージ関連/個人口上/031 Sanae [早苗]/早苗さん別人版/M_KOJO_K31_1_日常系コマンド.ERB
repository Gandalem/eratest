@M_KOJO_早苗追加_MESSAGE_COM_K31_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;ここに口上書いて下さい
	;デバッグ用
	;PRINTFORML 「現在ストーリー_第{CFLAG:31:1001}章_第{CFLAG:31:1002}節」
	;CALL K31_特殊会話フラグの確認と出力("デバッグ")
	;PRINTFORML 「現在ストーリー_第{CFLAG:31:1001}章_第{CFLAG:31:1002}節」
	;=======================
	;怒り、失敗、泥酔分岐を先に書いておく、RETURNさせる
	;=======================
	;怒り
	IF CFLAG:ブチギレ || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「…………」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 화가 난 것 같다...
		RETURN 1
		;失敗
	ELSEIF TFLAG:193 == -1
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「……뭡니까?」
			PRINTFORMW 「죄송합니다, 멍하니 있었습니다.」
		ELSE
			PRINTFORML 「.........아, 그게...」
			PRINTFORMW 「화제가 되었습니다...」
		ENDIF
		RETURN 1
		;泥酔
	ELSEIF TCVAR:泥酔
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 술이 너무 많이 들어서 그런지 기분이 안 좋아 보인다...
		PRINTFORMW 「으윽... 기분 나빠요...」
		RETURN 1
	ENDIF
	;===================================================================
	;ストーリーイベント発生判定、詳細はユーザー関数.ERBを参照
	;===================================================================
	CALL K31_特殊会話フラグの確認と出力("会話")
	SIF RESULT
		RETURN 1
	;==========================================================================================
	;1/3で日付会話発生、確率ちょい高めに、通常会話は発生させない（RETURN消して発生させることもできる）
	;==========================================================================================
	IF !RAND(2)
		SELECTCASE DAY:2
			CASE 1
				;元日
				IF DAY:3 == 1
					PRINTFORML 「새해 복 많이 받으세요」
					PRINTFORMW 「올 한 해도 잘 부탁드려요」
					RETURN 1
				ENDIF
				;ホワイトデー
				IF DAY:3 == 14
					PRINTFORML 「오늘은 화이트데이네요」
					PRINTFORMW 「그러니까 뭔~ 이라는 건 아니지만요」
					RETURN 1
				ENDIF
				;例大祭
				IF DAY:3 == 25
					PRINTFORML 「오늘은 예이타마츠리입니다」
					PRINTFORMW 「이 기회에 신자가 늘어났으면 좋겠는데요」
					RETURN 1
				ENDIF
			CASE 2
				;七夕
				IF DAY:3 == 7
					PRINTFORML 「오늘은 견우와 요네즈의 날이네요」
					PRINTFORMW 「단자에는 무엇을 적으시겠어요?」
					RETURN 1
				ENDIF
			CASE 3
				;お月見
				IF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- "
					PRINTFORML 「오늘은 보름달입니다.」
					PRINTFORMW 「달 구경이라도 할까요?」
					RETURN 1
				ENDIF
				;風神「二百十日」
				IF DAY:3 == 1
					PRINTFORML 「오늘은 입춘으로부터 이백십 일째」
					PRINTFORMW 「태풍 등 날씨가 거칠기 쉽다고들 하는 날이네요」
					RETURN 1
				ENDIF
				;ハロウィン
				IF DAY:3 == 30
					PRINTFORML 「오늘은 할로윈이에요」
					PRINTFORMW 「사탕이나 장난, 둘 중 뭐가 좋아요?」
					RETURN 1
				ENDIF
			CASE 4
				;バレンタインデー
				IF DAY:3 == 14
					PRINTFORML 「오늘은 발렌타인데이입니다」
					PRINTFORMW 「기왕이니까, 초콜릿 먹을까요」
					RETURN 1
				ENDIF
				;節分
				IF DAY:3 == 3
					PRINTFORML 「오늘은 절분이다」
					PRINTFORMW 「귀신은 밖으로, 복은 안으로, 라는 거겠지」
					RETURN 1
				ENDIF
				;クリスマス
				IF DAY:3 == 25
					PRINTFORML 「오늘은 크리스마스입니다」
					PRINTFORMW 「케이크, 먹고 싶네요」
					RETURN 1
				ENDIF
				;大晦日
				IF DAY:3 == 31
					PRINTFORML 「오늘은 연말입니다」
					PRINTFORMW 「일 년의 마무리가 되겠네요」
					RETURN 1
				ENDIF
		ENDSELECT
	ENDIF
	;=======================
	;ここから通常会話
	;=======================
	IF TALENT:恋人 || TALENT:恋慕
		LOCAL = 10
	ELSEIF TALENT:思慕
		LOCAL = 7
	ELSE
		LOCAL = 5
	ENDIF
	SELECTCASE RAND(LOCAL)
		CASE 0
			PRINTFORML 「어떻게 날고 있냐고요?」
			PRINTFORML 「뭐... 기적의 힘이라고 생각해주세요.」
		CASE 1
			PRINTFORML 「환상향은 연회가 많다 보니 술을 잘 마시는 사람이 많은데, 저는 사실 술이 약해요」
			PRINTFORML 「바로 취하지 않는 상토(上戸) 같은 분들이 부러워질 때도 있어요」
			PRINTFORML 「그러고 보니 대주(大酒飲み)를 표현하는 방법에는 여러 가지가 있던 것 같은데, %CALLNAME:MASTER%님은 어떤 표현을 사용하시나요?」
			PRINTFORML 「상토? 우와바미? 자루? 사토우나 와쿠 같은 말도 있는 것 같은데요」
		CASE 2
			PRINTFORML 「실물 크기의 거대 로봇 같은 거 보고 싶네요」
			PRINTFORML 「네? 바깥세상에는 있는 건가요? 빨리 환상에 들어왔으면 좋겠어요...」
		CASE 3
			PRINTFORML 「능력으로 날씨 조작해 주길 바라? 너무 대규모면 주문 같은 게 힘들잖아요...」
			PRINTFORML 「뭐, 기회가 되면 생각해 둘게요」
		CASE 4
			PRINTFORML 「신앙은 인간에게 매우 소중한 것입니다」
			PRINTFORML 「신앙이 없다면 신의 힘은 약해지고 사람들에게 은혜를 베풀기도 어려워집니다」
			;ここから思慕以上で表示
		CASE 5
			PRINTFORML 「이사 왔을 때 여러 가지 불안한 점도 있었지만, 이곳에서의 생활도 나쁘지 않은 것 같아요.」
			PRINTFORML 「즐거운 이야기 상대도 있고, 그렇죠?」
		CASE 6
			PRINTFORML 「%CALLNAME:MASTER%님도 그렇지만, 제가 아는 인간들은 요괴 같은 쪽뿐이네요…」
			PRINTFORML 「나도 언젠가 그렇게 되어버리는 걸까요…」
			PRINTFORMDL 이미 그렇게 되고 있는 건가? 라는 말을 %조사처리(CALLNAME:MASTER,"는")% 간신히 삼켰다...
		CASE 7
			PRINTFORML 「%CALLNAME:MASTER%씨는 대화 주제가 많으시네요」
			PRINTFORML 「비결 같은 거 가르쳐 주실 수 있나요? 신앙 모으기에는 역시 말솜씨도 중요하니까요」
			;ここから恋慕以上で表示
		CASE 8
			PRINTFORML 「후훗... %CALLNAME:MASTER%님과의 대화는 즐거워서 좋아요」
			PRINTFORML 「물론, %CALLNAME:MASTER%님에 대해서도...」
		CASE 9
			PRINTFORML 「최근, 무언가에 몰두해서 시간을 잊어버릴 때가 있어요」
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 있을 때는 특히요」
			;ねんのため
		CASEELSE
			PRINTFORML 「****예상치 못한 분기점에 도달했습니다****」
	ENDSELECT
	PRINTFORMW
ENDIF
RETURN 1
