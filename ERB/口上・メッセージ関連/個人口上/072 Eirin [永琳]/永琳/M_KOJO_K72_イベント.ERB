							ELSE
								PRINTFORMDL 에린은 옷을 조각조각 벗어내며 도발적인 시선을 보낸다. 들리는 소리는 천이 부드럽게 스치는 소리뿐이다.
								PRINTFORMDW 그녀는 당신의 호흡 변화를 통해 반응을 판단하는 것을 즐기는 듯 침묵을 유지한다.
								PRINTFORMDL 하나씩, 그녀의 몸을 덮고 있던 옷가지들이 부드러운 '툭' 소리를 내며 바닥에 떨어진다.
								CALL HPH_PRINT,@"「...자, 마음껏 드세요HPH」","L"
								PRINTFORMDW 그녀의 나체로 빛나는 몸을 당신의 눈앞에 들고, 에이린은 매혹적인 미소를 지으며 당신을 돌아본다.
								PRINTFORMW 
							ENDIF
							;通常
						ELSE
							SELECTCASE RAND:2
								CASE 1
									PRINTFORML 「음...후후~ 키스도 나쁘지 않네.」
									PRINTFORMDW 당신의 입술과 에리린의 입술이 서로를 물고 핥으며 서로의 옷을 벗긴다.
									PRINTFORMW 
								CASE 0
									CALL HPH_PRINT,@"「음, 정말 음란한 손길을 가졌네... HPH」","L"
									PRINTFORMDW 당신은 에이린의 옷을 관능적으로 벗어내며 그녀의 반응을 즐긴다.
									PRINTFORMW 
							ENDSELECT
						ENDIF
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					IF FIRSTTIME("時間停止下着")
						PRINTFORMDW 에리노의 마지막 옷을 벗기자 그녀가 입고 있는 속옷이 드러난다.
						PRINTFORMDW 그 보잘것없는 천 조각들이 그녀의 풍만하고 가득 찬 가슴과 매혹적인 아랫배를 모두 가리고 있었다.
						PRINTFORMDW 당신은 오직 당신의 눈을 위해 존재하는 이 신성한 광경을 바라보며 저절로 미소를 짓는다.
						PRINTFORML 
					ELSE
						PRINTFORMDW 당신은 능숙하게 에이린의 옷을 벗겨 그녀가 익숙한 속옷을 드러낸다.
						PRINTFORMDW 그녀의 속옷이 단순하든 화려하든, 그것은 특별한 의미를 지니지 않았다.
						PRINTFORMDW 그러한 천 따위는 그녀의 나신이 주는 압도적인 충격에 비할 바가 되지 못한다.
						PRINTFORML 
					ENDIF
					;通常
				ELSE
					;天元突破。
					IF TCVAR:発情
						CALL HPH_PRINT,@"「너무 빤히 보지 마...흐읍」","L"
						PRINTFORMDW 에린은 당신의 시선 아래서 당황하며 몸을 비튼다.
						PRINTFORML 
						;泥酔。
					ELSEIF TCVAR:泥酔
						PRINTFORML 「당신 눈이 나를 뚫어보는 것 같아, 좀 창피하네.」
						PRINTFORMDW 그녀가 말하는 동안, 에린은 뜨거운 한숨을 내쉰다.
						PRINTFORML 
					ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
						PRINTFORML 「이거 좋아...?」
						PRINTFORMDW 에리인의 뺨에 홍조가 막 피어나는 것이 보였다.
						PRINTFORML 
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						CALL HPH_PRINT,@"「이게 네가 원하는 거겠지, 궁금하네?HPH」","L"
						PRINTFORMDW 에리나는 당신에게 매혹적인 미소를 지어준다.
						PRINTFORML 
					ELSEIF TALENT:思慕 && TALENT:セフレ == 2
						CALL HPH_PRINT,@"「이게 네가 원하는 거겠지, 궁금하네?HPH」","L"
						PRINTFORMDW 에리나는 당신에게 매혹적인 미소를 지어준다.
						PRINTFORML 
						;通常
					ELSE
						PRINTFORML 「이게 될까...」
						PRINTFORMDW 에이린은 침착하게 옷을 바닥으로 떨군다.
						PRINTFORML 
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					PRINTFORMDL 당신은 에리신의 옷을 옆으로 치웠다.
					PRINTFORMDW 이 상태에서 그녀의 반쯤 드러난 몸은 그저 물건일 뿐이지만, 당신은 그녀의 차갑고 마네킹 같은 모습이 이상하게 자극적으로 느껴진다.
					PRINTFORML 
					;通常
				ELSE
					;天元突破。
					IF TCVAR:発情
						CALL HPH_PRINT,@"「아직 다 벗지 않았어. 확실해...? HPH」","L"
						PRINTFORMDW 에린은 의아한 표정을 지었다.
						PRINTFORML 
						;泥酔。
					ELSEIF TCVAR:泥酔
						PRINTFORML 「하늘의 별들 위에서. 너 정말 이 이상은 못 견디겠구나?」
						PRINTFORMDW 에린의 입에서 장난기 어린 웃음이 새어 나왔다.
						PRINTFORML 
					ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
						PRINTFORML 「이런 식으로? ...뭐, 네가 원한다면 나도 그래.」
						PRINTFORMDW 에린은 부드러운 미소를 지어준다.
						PRINTFORML 
					ELSEIF TALENT:愛欲 || TALENT:セフレ
						CALL HPH_PRINT,@"「옷 입은 채로 하고 싶다고, 정말... 흐으」","L"
						PRINTFORMDW 에리노 입가에 음란한 미소가 걸린다.
						PRINTFORML 
					ELSEIF TALENT:思慕 && TALENT:セフレ == 2
						CALL HPH_PRINT,@"「옷 입은 채로 하고 싶다고, 정말... 흐으」","L"
						PRINTFORMDW 에리노 입가에 음란한 미소가 걸린다.
						PRINTFORML 
						;通常
					ELSE
						PRINTFORML 「있잖아, 옷을 더럽히고 싶지 않아...」
						PRINTFORMDW 에린의 눈썹이 찌푸려졌다.
						PRINTFORML 
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							;時姦疑惑あり
							IF CFLAG:72:1002 > 1
								PRINTFORML 「...알겠어. 그럼 그 대신 속옷을 줄 수 있니?」
								PRINTFORMDW 잠시 생각한 후, 당신은 에이린의 제안에 동의하며 고개를 끄덕였다.
								PRINTFORML 「――정말 고마워～」
								PRINTFORMDW 에이린의 얼굴에 넓고 치어스 같은 미소가 떠올랐다.
								PRINTFORMDL 그 미소...
								PRINTFORMDW 어떤 이유에서인지, 그것을 생각하면 배 속이 불길한 기분으로 가득 찬다...
								PRINTFORML 
								;動かぬ証拠が…。
								CFLAG:72:1002 += 100
								;天元突破。
							ELSEIF TCVAR:発情
								CALL HPH_PRINT,@"「...%CALLNAME:MASTER%'s...HPH」","L"
								PRINTFORMDW 방금 벗어둔 속옷을 집는 에리노의 목소리가 떨린다.
								PRINTFORMDW 그녀는 열에 들뜬 표정으로 그것을 코에 대고 자신의 콧구멍을 그 향으로 가득 채웠다.
								CALL HPH_PRINT,@"「Hn...HPH」","L"
								PRINTFORMDW 그녀는 취한 듯한 신음을 흘린다.
								PRINTFORMDW 당신의 속옷에 완전히 정신이 팔린 그녀의 마음을 채, 당신은 서둘러 그것을 움켜쥐고 숨긴다.
								PRINTFORML 
								;疑惑なし
							ELSE
								PRINTFORMW 「...알았어. 그럼 교환하자. 내 것을 네 것으로.」
								PRINTFORML 「네 속옷으로 뭘 하려고? 음, 뭐 이것저것이겠지 아마.」
								PRINTFORMDW 그녀의 얼굴에 떠오른 수상한 미소로 질문을 회피하는 모습은 불길한 예감으로 당신을 채운다...
								PRINTFORML 
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							;時姦疑惑あり
							IF CFLAG:72:1002 > 1
								PRINTFORML 「물론이다. ――자, 여기 있다.」
								PRINTFORMDW 에이린은 불평 없이 그녀의 속옷을 당신에게 기쁘게 건넨다. 그녀의 표정은 완전히 침착하고 동요하지 않은 상태로 유지된다.
								PRINTFORML 「그렇게 물으신다면, 내가 넘겨주는 것이 당연한 것 아닌가. ...동감하지 않나?」
								PRINTFORMDW 그녀는 부드럽게 말을 이어가며, 입술을 천천히 넓은 치어스처럼 미소 짓는다...
								PRINTFORML 
								;天元突破。
							ELSEIF TCVAR:発情
								CALL HPH_PRINT,@"「분명하게 HPH... 음, 가능하다면――」","L"
								PRINTFORMDL 에린은 무언가 말하려는 듯했지만, 정신을 차리고 당황하며 고개를 저었다.
								CALL HPH_PRINT,@"「음...아니야. 아무것도 아니야...후후」","W"
								PRINTFORML 
								;疑惑なし
							ELSE
								PRINTFORML 「물론이지. ――자, 여기 있다.」
								PRINTFORMDW 에린은 불평 없이 당신에게 속옷을 기쁘게 건넨다. 그녀는 씁쓸하게 미소 짓는다.
								PRINTFORMW 「참 번거로운 종교로군. 다른 사람들에게 너무 많은 폐를 끼쳐선 안 돼.」
								PRINTFORML 「그래서――만약 정말 필요하다면, 내가 해줄게. 알겠지?」
								PRINTFORMDW 장난기 어린 표정으로 한쪽 눈을 감고 그녀는 당신의 귓가에 속삭인다.
								PRINTFORML 
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF CFLAG:72:1002 > 1
								PRINTFORML 「...어쩔 수 없겠지.」
								PRINTFORMDW 에린은 시큰둥한 표정으로 당신에게 속옷을 건넨다.
								PRINTFORML 
								;天元突破。
							ELSEIF TCVAR:発情
								CALL HPH_PRINT,@"「정말 그렇게 원하긴 하는 건가...?후우, 그럼...」","L"
								PRINTFORMDW 비록 그녀는 분명 당황한 것 같지만, 에이린은 당신에게 속옷을 건넨다.
								;疑惑なし
							ELSE
								PRINTFORML 「...적어도 나에게 이상한 일에 쓰지 않겠다고 약속해 줄 수 있겠니?」
								PRINTFORMDW 에이린은 얼굴에 찡그림을 띠고 속옷을 당신에게 건넸다.
								PRINTFORML 
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF CFLAG:72:1002 > 1
								PRINTFORML 「답은 아니라는 게 분명해야 한다.」
								PRINTFORMDW 에린은 단호하게 거절한다.
								PRINTFORML 「이유? ...너 자신의 마음을 들여다보지 않니?」
								PRINTFORMDW 설명을 요구하자, 그녀는 더욱 차가운 말로 상대를 밀어낸다.
								PRINTFORML 
								;天元突破。
							ELSEIF TCVAR:発情
								CALL HPH_PRINT,@"「정말... HPH 너무 과하다...」","L"
								PRINTFORMDW 에리노의 눈썹이 찌푸려지고 입술을 삐죽 내밀며 의아한 미소를 짓는다.
								PRINTFORML 
								;疑惑なし
							ELSE
								PRINTFORML 「답은 아니라는 것이 명백해야 한다.」
								PRINTFORMDW 에린이 단호하게 거절한다.
								PRINTFORML 
							ENDIF
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
