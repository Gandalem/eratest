@M_KOJO_EVENT_K72_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		CALL HPH_PRINT,@"「...후우, 하아... 예상대로, 조금 지쳤군...」","L"
		PRINTFORMDW 그녀의 머리가 당신의 가슴에 부드럽게 '쿵' 소리를 내며 내려앉자, 에린은 부드럽게 미소 짓는다.
		PRINTFORML 「고맙습니다, %CALLNAME:MASTER%. ...나와 함께 있어 줘서.」
		PRINTFORMDW 대답하는 대신 당신은 그녀의 머리를 쓰다듬었다. 고양이처럼, 그녀는 즐거움으로 눈을 가늘게 떴다.
		PRINTFORMDW 당신들은 잠시 그렇게 있다가, 방금 나누었던 애정의 여운 속에서 둘 다 졸음에 빠졌다.
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		CALL HPH_PRINT,@"「후우...흡」","L"
		PRINTFORMDW 에린은 깊이 만족스러운 한숨을 내쉬며 따뜻한 담요처럼 당신의 몸을 덮고 나른하게 누워 있었다.
		CALL HPH_PRINT,@"「정말 멋졌다...HPH」","L"
		PRINTFORMDW 그녀의 머리를 쓰다듬으면 만족스럽게 눈을 가늘게 뜬다.
		PRINTFORMW 「후훗～ ...고마워요, %CALLNAME:MASTER%. 저와 함께 있어 주셔서.」
		CALL HPH_PRINT,@"「내가 뒷정리는 할게. ...너는 이제 편히 쉬어, 이제...」 HPH","L"
		PRINTFORMDW 그녀의 말을 마음에 새기고, 당신은 등을 대고 에이린의 서비스를 만끽한다.
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORML 「꺅――」
		PRINTFORMDW 에이린이 만족스러운 한숨과 함께 마침내 속도를 늦추기 시작하자, 당신은 그 순간을 놓치지 않고 그녀를 밀어붙인다.
		PRINTFORMDL 당신은 지쳐 거칠게 숨을 몰아쉬는 그녀의 몸을 제압하고, 거친 핥음과 키스를 쏟아내며 공격을 시작한다.
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%...? 이미... HPH야」","W"
		CALL HPH_PRINT,@"「아아――큭, 잠깐만요. 좀 쉬어도 되죠――하안!큭」","L"
		PRINTFORMDW 너는 그녀가 저항할 수 없이 무력한 동안 그녀에게 복수를 퍼부으며 에리노의 야릇한 비명을 즐긴다.
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORMW 「나 자신에게 말하건대, 그냥 그렇게 말해도 괜찮을까...?」
		PRINTFORMDL 에이린은 눈을 가늘게 떴다.
		PRINTFORMW 「음... %CALLNAME:MASTER%, 네가 원하는 대로 해줄게~」
		PRINTFORMDL 그녀는 유혹적으로 미소 지으며 혀끝을 당신에게 내민다. 입술을 축인 채, 그녀는 얼굴을 당신의 귀 가까이 가져갔다.
		PRINTFORMW 「――걱정하지 마. 네 약은 제대로 준비해 줄게~」
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 무슨 일이 일어나더라도... 내가 즉시 너를 치료해줄게...HPH」","L"
		PRINTFORMDW 에이린은 당신의 등골에 공포의 전율을 보내는 듯 눈부시게 사랑스러운 목소리로 부드럽게 속삭였다.
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;一日の終了時(AFTERTRAニーの前)、面識がなければ呼び出されない
;==================================================

@M_KOJO_EVENT_K72_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;映姫様口上を参照
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		;映姫様口上に同意して頻度を少なく。
		IF ARG % 30 == 0 && ARG != 0 && !TALENT:72:恋慕 && !TALENT:72:思慕 && !TALENT:72:愛欲 && !TALENT:72:セフレ == 2 && !TALENT:72:セフレ
			CALL EVENTEND_TSUBUYAKI
			PRINTFORML 「곰곰이 생각해보니――」
			PRINTFORMDW 그녀가 잠들기 전에, %조사처리(CALLNAME:MASTER,"의")% 얼굴이 갑자기 에리노 머릿속에 떠올랐다.
			PRINTFORMW 「%HIM_HER(MASTER)%를 한동안 보지 못했네, %HE_SHE(MASTER)%는 어떻게 지낼까...」
			PRINTDATADL
				DATAFORM 「...%HE_SHE(MASTER)%가 아프지 않았으면 좋겠어.」
				DATAFORM 「...혹시 %HE_SHE(MASTER)%가 %HIM_HER(MASTER)% 자신을 다치게 했는지 궁금하네?」
				DATAFORM 「...%HE_SHE(MASTER)%가 무슨 사건에 휘말리지 않았으면 좋겠어.」
			ENDDATA
			PRINTFORMDW 잠시 걱정하던 후 그녀는 잠이 들었다.
			PRINTFORML 
			;愛欲は十日に一度。
		ELSEIF ARG % 10 == 0 && ARG != 0 && TALENT:72:愛欲
			CALL EVENTEND_TSUBUYAKI
			PRINTFORMW 「음, %CALLNAME:MASTER%... %HE_SHE(MASTER)%는 뭘 하고 있을까?」
			PRINTFORML 「나는 %HIM_HER(MASTER)%가 나를 안아주었으면 좋겠어... 아니면 이건 날 괴롭히려는 시도인가? 후후후~ 정말, 얼마나 끔찍한 사람일까――」
			PRINTFORMDW 열이 나는 듯 한숨을 쉬며 에이린은 잠에 빠졌다.
			PRINTFORML 
			;愛人も十日に一度。
		ELSEIF ARG % 10 == 0 && ARG != 0 && TALENT:72:セフレ == 2 && TALENT:72:思慕
			CALL EVENTEND_TSUBUYAKI
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 왜 나를 보러 오지 않는 건지 궁금하다...」
			PRINTFORML 「그럼 나 자신을 위로해야겠네――아니, 어쩌면 %HIM_HER(MASTER)%에게 갈지도 모르지. 후후~ 이제 아이디어가 떠올랐어!」
			PRINTFORMDW 그녀의 상상력이 마음껏 날아가며 에린은 잠이 들었다.
			PRINTFORML 
			;セフレも十日に一度。
		ELSEIF ARG % 10 == 0 && ARG != 0 && TALENT:72:セフレ
			CALL EVENTEND_TSUBUYAKI
			PRINTFORMW 「왜 %조사처리(CALLNAME:MASTER,"가")% 나를 보러 오지 않는 건지 모르겠어...」
			PRINTFORML 「혹시 %HE_SHE(MASTER)%가 내 몸에 흥미를 잃은 걸지도 몰라. 만약 그렇다면, 외로울 거야...」
			PRINTFORMDW 가만히 한숨을 쉬며 에이린은 잠이 들었다.
			PRINTFORML 
			;思慕は十四日に一度。
		ELSEIF ARG % 14 == 0 && ARG != 0 && TALENT:72:思慕 && !TALENT:72:セフレ == 2
			CALL EVENTEND_TSUBUYAKI
			PRINTFORML 「%CALLNAME:MASTER%――」
			PRINTFORMDW 오랫동안 연모의 얼굴을 보지 못했다는 것을 깨달은 에이린은 한숨을 내쉰다.
			PRINTFORMW 「혹시 %HE_SHE(MASTER)%가 아픈 건가? 아니면 다친 건가? %HE_SHE(MASTER)%가 괜찮기를 바란다.」
			PRINTFORML 「만약 %HE_SHE(MASTER)%가 잠시 들러 건강한 모습을 보여준다면, 나는 기쁠 텐데...」
			PRINTFORMDW 괴로워하던 에이린은 천천히 잠이 들었다.
			PRINTFORML 
			;恋慕は七日に一度。
		ELSEIF ARG % 7 == 0 && ARG != 0
			IF TALENT:72:恋人
				CALL EVENTEND_TSUBUYAKI
				PRINTFORML 「...%조사처리(CALLNAME:MASTER,"가")% 잘 지내고 있을까?」
				PRINTFORMW 「아마 쉬는 날에 %HIM_HER(MASTER)%를 보러 갈지도 모르겠어. 아니면 환자 집을 방문할 때 잠깐 들릴 수도 있겠지.」
				PRINTFORML 「그리고 샘플도 채집할 좋은 기회가 되겠네. ...응, 그렇게 하자.」
				PRINTFORMDW 몇 가지 변명을 생각해낸 에리나는 잠이 들었다.
				PRINTFORML 
			ELSEIF TALENT:72:恋慕
				CALL EVENTEND_TSUBUYAKI
				PRINTFORMW 「...%조사처리(CALLNAME:MASTER,"가")% 잘 지내고 있는지 궁금하다?」
				PRINTFORMW 「...그냥 한동안 %HIS_HER(MASTER)%의 얼굴을 못 봤다는 이유로 이렇게 걱정하고 있다는 게 믿기지 않는다.」
				PRINTFORML 「지금 와서 깨닫긴 좀 늦었지만, 정말 미치도록 사랑하게 되었구나――」
				PRINTFORMDW 자조적인 미소를 지으며 에이린은 눈을 감고 잠이 들었다.
				PRINTFORML 
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:72:1000 >= 100
			IF FIRSTTIME("母乳発覚")
				CALL EVENTEND_TSUBUYAKI
				CALL PRINT_FACE, [[永琳]], "発情", "服", "", ""
				PRINTFORML 「이것은――」
				PRINTFORMDW 어느 날 밤 한복판에. 에린은 특정 신체 부위에서 느껴지는 낯선 불편함을 감지하며 미간을 찌푸렸다.
				PRINTFORMDW 그녀는 손가락으로 단단해진 유두 끝을 부드럽게 문지르고, 분비물을 살핀 뒤 냄새를 맡고――숨을 내쉬었다.
				PRINTFORMDL 상황을 이해한 그녀는 수건으로 몸을 닦았다.
				PRINTFORMW 「내일은 %조사처리(CALLNAME:MASTER,"에게")% 가봐야겠다.」
				IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「후후후~ %HE_SHE(MASTER)%는 아마 놀랄 거라고 상상해...」
					PRINTFORMDW 그녀는 사랑하는 사람의 얼굴을 떠올리며 잠이 들었다.
					PRINTFORML 
				ELSEIF TALENT:愛欲 || TALENT:セフレ
					CALL HPH_PRINT,@"「후후후~ %HE_SHE(MASTER)%는 놀랄 거야...히히」","L"
					PRINTFORMDW 그녀는 사랑하는 사람의 얼굴을 떠올리며 잠이 들었다.
					PRINTFORML 
				ELSEIF TALENT:セフレ == 2 && TALENT:思慕
					CALL HPH_PRINT,@"「후후후~ %HE_SHE(MASTER)%는 놀랄 거야...히히」","L"
					PRINTFORMDW 그녀는 사랑하는 사람의 얼굴을 떠올리며 잠이 들었다.
					PRINTFORML 
				ELSE
					PRINTFORML 「우선, 나에게 몇 가지 선택할 단어들이 있다 %HIM_HER(MASTER)%에게...」
					PRINTFORMDW 그녀는 마음속에 특정한 얼굴을 한 채 잠이 들었다.
					PRINTFORML 
				ENDIF
				CFLAG:72:1010 = 1
			ELSE
			ENDIF
		ELSE
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;自由行動中
;ARG:1      0=行動中,1=完了時
;技能系の行動は技能レベルが1以上なら発生
;==================================================

@M_KOJO_EVENT_K72_32(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		CASE 0
			;▼考え事,（～は考えに耽っている。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「최근 너무 자주 일어나던 그 이상한 일들이 말이야, 정말로—」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「음, 상황이 어떻게 흘러갈지 조금 더 지켜봐야겠어.」
				PRINTFORML 
			ENDIF
		CASE 1
			;▼遊ぶ,（～は走り回っている。）
			;※[幼稚]持ちのみ
			IF !ARG:1
				;行動中
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORML 
			ENDIF
		CASE 2
			;▼食事,（～は食事を摂っている。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「음. 맛들이 잘 어우러지네, 맛있어.」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「식사 감사합니다.」
				PRINTFORML 
			ENDIF
		CASE 3
			;▼つまみ食い（～はこっそりつまみ食いをしている。）
			;※[妖精]持ちとルーミア、こいし、幽々子、紫苑のみ
			IF !ARG:1
				;行動中
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORML 
			ENDIF
		CASE 4
			;▼掃除,（～はテキパキと部屋の掃除をしている。）
			;※[掃除係]持ちまたは汚臭耐性-1以下のみ
			IF !ARG:1
				;行動中
				PRINTFORMW 「가끔은 리젠에게 좀 쉬게 해줘야 할까 생각한다...」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「자, 청소는 다 끝났어~」
				PRINTFORML 
			ENDIF
		CASE 5
			;▼運動,（～は張り切って運動している。）
			;※[音楽知識]持ちは除く（演奏になる）
			IF !ARG:1
				;行動中
				PRINTFORMW 「가끔은 이런 것들을 하는 게 좋아. 몸을 움직여봐――알지?~」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「휴. 꽤 땀을 흘렸네.」
				PRINTFORML 
			ENDIF
		CASE 6
			;▼読書,（～は黙々と本を読んでいる。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「흠... 흥미로운 사건이군...」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「――나 자신에게. 너무 독서에 몰두한 것 같아, 바보 같아.」
				PRINTFORML 
			ENDIF
		CASE 7
			;▼料理,
			IF !ARG:1
				;行動中
				IF Activity_Duration:TARGET > 30
					;料理中（～は軽快に料理をしている。）
					PRINTFORMW 「가끔은 요리하는 것도 재미있지.」
					PRINTFORML 
				ELSE
					;食事中（～は作った料理を食べている。）
					PRINTFORMW 「흠. 재료의 품질을 고려하면 꽤 잘 해낸 것 같다.」
					PRINTFORML 
				ENDIF
			ELSE
				;完了時
				PRINTFORML 
			ENDIF
		CASE 8
			;▼演奏
			;※[音楽知識]持ちのみ（TALENT:音楽知識で変化）
			;1,～は小気味よく演奏している。
			;2,～は気ままに歌っている。
			;3,～は華麗に踊っている。
			IF !ARG:1
				;行動中
				PRINTFORMW 「후훗~ 이런 것도 재미있네――」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「아아. 즐거웠다♪」
				PRINTFORML 
			ENDIF
		CASE 9
			;▼採集,（～使える素材を探している。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「음, 저 근처에 좀 있나....」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「...후우. 여기서 그만둘 생각이야.」
				PRINTFORML 
			ENDIF
		CASE 10
			;▼釣り,（～はのんびり釣りをしている。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「...♪ ――♪」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「음, 이쯤에서 끝내도록 하지.」
				PRINTFORML 
			ENDIF
		CASE 11
			;▼実験,（～は怪しい実験をしている。）
			IF !ARG:1
				;行動中
				SELECTCASE RAND:10
					CASE 9
						PRINTFORMW 「좋아, 이걸로――」
						PRINTFORML 
					CASE 8
						PRINTFORMW 「...아, 저 저울은 어디 있지?」
						PRINTFORML 
					CASE 7
						PRINTFORMW 「이것은 다른 종류의 약으로도 사용될 수 있을 것 같지만...」
						PRINTFORML 
					CASE 6
						PRINTFORMW 「이것을 더 진행하려면 임상 시험이 필요할 것이다...」
						PRINTFORML 
					CASE 5
						PRINTFORMW 「음. 이 반응――」
						PRINTFORML 
					CASE 4
						PRINTFORMW 「나에게. 이렇게 변할 줄은 몰랐어...」
						PRINTFORML 
					CASE 3
						PRINTFORMW 「음... 온도를 좀 더 높여야 할까.」
						PRINTFORML 
					CASE 2
						PRINTFORMW 「후훗~ 이쪽은 괜찮을 것 같은 기분이 드네...」
						PRINTFORML 
					CASE 1
						PRINTFORMW 「이건 좀 예상치 못했네...」
						PRINTFORML 
					CASE 0
						PRINTFORMW 「음, 약 복용량 숫자를 어디에 적어뒀더라...」 하고 생각했다.
						PRINTFORML 
				ENDSELECT
			ELSE
				;完了時
				PRINTFORMW 「오늘은 여기까지 하는 게 좋겠어.」
				PRINTFORML 
			ENDIF
		CASE 12
			;▼のんびり,（～はのんびりしている。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「아아~~ 이게 삶이지...」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「음, 그렇다면. 너무 장난치면 안 되겠지.」
				PRINTFORML 
			ENDIF
		CASE 13
			;▼晩酌,（～はまったりとお酒を飲んでいる。）
			;※酒耐性0以上のみ
			IF !ARG:1
				;行動中
				PRINTFORMW 「음... 후후후~ 이 술 맛있다.」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「너무 많이 마시는 것은 건강에 좋지 않다.」
				PRINTFORML 
			ENDIF
		CASE 14
			;▼買い物,（～は気ままに買い物している。）
			IF !ARG:1
				;行動中
				PRINTFORMW 「이제, 내가 구매하고 싶었던 물건은 어디에 있는 거지--」
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORMW 「쇼핑은 다 끝났어. 이제 집에 가자.」
				PRINTFORML 
			ENDIF
		CASE 15
			;▼説教,（～はじっと聞いている…）
			;※神霊・蓬莱人は除く
			IF !ARG:1
				;行動中
				PRINTFORML 
			ELSE
				;完了時
				PRINTFORML 
