@M_KOJO_EVENT_K72_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;見られた瞬間
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;天元突破。
				;状況としてありえるか不明だけど念の為に。
				IF TCVAR:発情
					CALL HPH_PRINT,@"「흐읍...흐으 %CALLNAME:MASTER%, 이거는, 음--흐으」","L"
					PRINTFORMDL 에이린은 당신에게 목격되어 분명 당황한다.
					PRINTFORMDW 하지만 그녀는 계속해서 자신의 가랑이를 만지고 있는 손가락들을 멈추지 못하는 것 같다.
					PRINTFORMDL 이를 깨달은 에이린의 얼굴은 치정으로 일그러지고, 그녀는 당신에게 애원하는 눈빛을 보낸다.
					CALL HPH_PRINT,@"「안 돼--HPH 보지 마...HPH」","W"
					PRINTFORML 
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					IF FIRSTTIME("恋人オナバレ")
						CALL HPH_PRINT,@"「아아... 음... 흠! %CALLNAME:MASTER%...흐윽」","L"
						PRINTFORMDW 당신이 문을 열고 엿보는 바로 그 순간, 에이린은 자위의 희미한 상태에서 당신의 이름을 부른다.
						PRINTFORMDL 그러고 나서 그녀는 문 움직임을 알아차리고 당신 쪽을 바라보더니 충격으로 굳는다.
						PRINTFORMDW 자신의 자기애에 완전히 몰두해 있던 그녀의 얼굴이 순식간에 굳으면서 뺨 가득 홍조가 퍼진다.
						PRINTFORML 「%CALLNAME:MASTER%...? 왜――」
						PRINTFORMDW 잘 익은 사과처럼 붉어진 얼굴로 그녀는 황급히 노출된 은밀한 곳을 가리려 한다.
						PRINTFORML 
					ELSE
						CALL HPH_PRINT,@"「응, 후으... 푸우하—흐흣」","L"
						PRINTFORMDL 문을 열자마자 에리노의 관능적인 신음 소리가 즉시 당신을 맞는다.
						PRINTFORMDW %BREAKENG(@"그녀는 눈을 꼭 감고 우아한 미간에 힘줄이 서 있으며, 나이트가운은 손이 모든 곳에 쉽게 닿도록 활짝 열려 누워 있었다.")%
						PRINTFORMDL 잠시 후 그녀는 당신의 존재를 알아차리고 당신을 똑바로 바라본다.
						CALL HPH_PRINT,@"「Ah, %CALLNAME:MASTER%...HPH」","L"
