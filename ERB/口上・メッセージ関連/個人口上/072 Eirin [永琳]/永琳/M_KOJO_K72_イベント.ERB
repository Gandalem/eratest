				PRINTFORML 
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;誘ってきた（人目につかない場所に行きたがるやつ）
	;記入チェック（=0, 非表示、1, 表示）
