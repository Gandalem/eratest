					CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 같이 나가자 HPH」","W"
					PRINTFORML 
				ELSEIF TALENT:思慕 && TALENT:セフレ == 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 같이 나가자 HPH」","W"
					PRINTFORML 
					;通常
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%, 그냥 궁금했는데... 혹시 괜찮다면 나랑 데이트하는 거 어때?」
					PRINTFORML 
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;天元突破。
				IF TCVAR:発情
					CALL HPH_PRINT,@"「정말 행복해...후우 좋아, 쓸 시간이 없어--후우」","L"
					PRINTFORMDW 에리노의 얼굴이 황홀한 미소로 환해진다.
