@M_KOJO_EVENT_K72_15(ARG,ARG:1)
#DIM 絶頂回数合算
#DIM ＶＡ絶頂回数判定
#DIM 被射精箇所合算
;口上主はTARGET
;はたて口上、ドレミー口上、映姫様口上、輝夜口上、美鈴口上を参照
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;未実装（押し倒しコマンドに統合？
	;MASTERが押し倒した（ウフフ開始時）
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 1
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 1
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;逢瀬終了（ウフフ終了時）
	;輝夜口上、美鈴口上を完全に参照しています。
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;絶頂回数カウント
		絶頂回数合算 = 0
		絶頂回数合算 += EX:Ｃ絶頂
		絶頂回数合算 += EX:Ｖ絶頂
		絶頂回数合算 += EX:Ａ絶頂
		絶頂回数合算 += EX:Ｂ絶頂
		絶頂回数合算 += EX:Ｍ絶頂
		;絶頂箇所判定(V、A)
		ＶＡ絶頂回数判定 = 0
		SIF EX:Ｖ絶頂 > 0
			ＶＡ絶頂回数判定 += EX:Ｖ絶頂 ;bugfix custom code
		SIF EX:Ａ絶頂 > 0
			ＶＡ絶頂回数判定 += EX:Ａ絶頂 ;bugfix custom code
		;通常時に射精されたかの判定。上から順に膣内、アナル、口、顔(胸？)、手
		被射精箇所合算 = 0
		SIF CFLAG:膣内射精 == 1
			被射精箇所合算 += 1
		SIF CFLAG:アナル射精 == 1
			被射精箇所合算 += 1
		SIF CFLAG:口に精液 == 1
			被射精箇所合算 += 1
		SIF CFLAG:顔に精液 == 1
			被射精箇所合算 += 1
		SIF CFLAG:手に精液 == 1
			被射精箇所合算 += 1
		IF FLAG:時間停止
			PRINTFORMDL 정지된 세계에서 그녀의 몸을 마음껏 가지고 놀다가 만족스러운 한숨을 내뱉었다.
			PRINTFORMDW 모든 어지러움을 깨끗이 닦아내고 옷을 정리했다.
			PRINTFORMDW 조용한 장난감으로 변한 에리린은 이 얼어붙은 순간에 공허한 공간을 향해 공허한 시선을 던진다.
			PRINTFORML 
		ELSEIF CFLAG:睡眠 ;custom code
			;すぐに押し倒される時用。
		ELSEIF CFLAG:TARGET:溜まってる度 > 300 && BASE:気力 > 500 && BASE:体力 > 1000
			;天元突破。
			IF TCVAR:発情
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%...HPH」","L"
				PRINTFORMDW 에리노의 골반이 앞뒤로 꿈틀거리고, 그녀는 절박한 시선으로 당신을 바라본다.
				CALL HPH_PRINT,@"「음. 나는...아직――하프」","L"
				PRINTFORMDW 그녀는 깊고 뜨거운 한숨을 내쉬며, 채워지지 않은 타오르는 열기가 몸의 심장 깊은 곳에 남아 있음을 분명히 했다.
				PRINTFORML 
				;泥酔。
