LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;天元突破。
		IF TCVAR:発情
			PRINTFORML 
			CALL HPH_PRINT,@"「%CALLNAME:MASTER%...HPH」","W"
			CALL HPH_PRINT,@"「이대로라면――정신이 나갈 것 같아...HPH」","W"
			CALL HPH_PRINT,@"「그러니까 말이야? 내가 무슨 말 하는지 이해해야 돼. HPH 제발――HPH」","W"
