@M_KOJO_EVENT_K72_20(ARG,ARG:1)
;口上主はLOCALS or RESULT
;輝夜口上、映姫様口上、クラウンピース口上を参照
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;うふふ中に眠くて帰る
		IF CFLAG:うふふ
			;天元突破。
			IF TCVAR:発情
				CALL HPH_PRINT,@"「안 되겠어... HPH는 깨어있을 수 없어――」","L"
				PRINTFORMDW 에린은 축 처진 머리를 오른손으로 받으며 얼굴을 찡그렸다.
				CALL HPH_PRINT,@"「오늘 밤은 집에 갈 거야... HPH 그럼 다음에 만나자... HPH」","W"
				PRINTFORML 
				;泥酔。
			ELSEIF TCVAR:泥酔
				PRINTFORMW 「정말 죄송해요, %CALLNAME:MASTER%. 발이 거의 잠들 지경이에요.」
				PRINTFORMDL 에이린은 당신에게 미안한 듯 입 맞추며 무거운 눈꺼풀을 들어 올리려고 애썼다.
				PRINTFORMW 「...다음에 만났을 때, 많이 사랑해요?」
				PRINTFORML 
			ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「%CALLNAME:MASTER%님, 사과드립니다.」
				PRINTFORMW 「다음에 만날 때 저에게 많은 사랑을 뿌려 주시지 않겠어요?」
				PRINTFORML 
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				PRINTFORMW 「%CALLNAME:MASTER%께 사과드립니다.」
				PRINTFORMW 「다음에 만날 때 마음껏 나를 보듬어 주시겠죠?」
				PRINTFORML 
			ELSEIF TALENT:思慕 && TALENT:セフレ == 2
				PRINTFORMW 「%CALLNAME:MASTER%께 사과드립니다.」
				PRINTFORMW 「다음에 만날 때 마음껏 나를 보듬어 주시겠죠?」
				PRINTFORML 
				;通常
			ELSE
				PRINTFORMW 「미안해, %CALLNAME:MASTER%.」
				PRINTFORMDL 졸기 직전에 자신을 알아차린 에이린은 사과하듯 고개를 숙인다.
				PRINTFORMW 「...다음에 계속할 수 있을까?」
				PRINTFORML 
			ENDIF
		ELSE
			;天元突破。
			IF TCVAR:発情
				CALL HPH_PRINT,@"「――음... 미안합니다HPH」","L"
				PRINTFORMDW 정신이 없는 듯한 에린에게 부르자 그녀는 깜짝 놀라 혼란스러운 듯 고개를 저었다.
				CALL HPH_PRINT,@"「벌써 이렇게 늦었네... 오늘은 이제 집에 가야겠어...HPH」","W"
				PRINTFORML 
				;泥酔。
			ELSEIF TCVAR:泥酔
				PRINTFORML 「졸리기 시작하는 시점이야...」
				PRINTFORMDW 에이린은 작은 하품을 감추기 위해 입을 가했다.
				PRINTFORMW 「그럼 오늘은 이쯤에서 끝내자. 다음에 또 보자, %CALLNAME:MASTER%.」
				PRINTFORML 
