	WAIT
	PRINTFORMDW 정말?! 대단하네!
	CALL SPTALK, 97, "発情", 0, @"「응, 별거 아니야--...」/「크윽, 그렇게 세게 안아주면 나 부서질 것 같아...!」", 1
	WAIT
	CALL SPTALK, 97, "通常", 0, @"「아무튼, 예전 지인들과 마을에서 카페라도 하게 되겠지...」/「그래도 일주일에 한 번은 계속 돌아다닐 거야!」", 1
	WAIT
	PRINTFORMDW 괜찮은 거래인 것 같군.
	CALL SPTALK, 97, "通常", 0, @"「...그래서? 만약을 위해 물어보는데, 이거 정말 괜찮겠어?」/「나는 의문이 들고 내 직감은 말해주고 있어...」", 1
	WAIT
	CALL SPTALK, 97, "怒り", 0, @"「너는 나와 함께 다른 여자들을 얻기 더 쉬워지길 바라면서 이런 식으로 하려는 거구나... 변태.」", 1
	WAIT
	PRINTFORMDW 자, 이제...
	CALLF 最大好感度() ;check highest favor
	IF RESULT:1 == 97
		CALL SPTALK, 97, "笑顔", 0, @"(뭐, 어쨌든 난 네 최고니까. 아무도 그걸 나에게서 빼앗을 수 없을 거야.)", 1
		WAIT
	ENDIF
	CALL SPTALK, 97, "通常", 0, @"「다시 화제로 돌아가서...」/「만약 마음을 바꾼다면 메인 메뉴의 그 편리한 캐릭터 설정 화면을 이용하면 돼...」/「어라, 제4의 벽을 부쉈네요. 이제 없애둘게요.」", 1
	WAIT
	CLEARLINE 14
	PRINTFORML
	CALL SPTALK, 97, "笑顔", 0, @"「자.」", 1
	WAIT
	CALL SPTALK, 97, "通常", 0, @"「어떻게 할 거야, 보스?」", 1
	WAIT
	CALL ASK_YN("해라", "하지 마라")
	IF !RESULT
		CALL SPTALK, 97, "笑顔", 0, @"「잡았어. 네가 알아주길 바라.」", 1
		WAIT
		CFLAG:97:1093 = 1
		CALL K97_SCHEDULE(1)
	ELSE
		CALL SPTALK, 97, "通常", 0, @"「네가 결정하면 내가 말했던 걸 해라.」", 1
		WAIT
		CFLAG:97:1093 = 0
		CALL K97_SCHEDULE()
	ENDIF
	RETURN 1
ENDIF
