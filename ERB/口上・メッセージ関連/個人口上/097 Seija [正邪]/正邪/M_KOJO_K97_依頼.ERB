;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K97(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME '= STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K97
RESULT = 0
TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K97(ROLE, SCENE, CLIENT_ID)
RESETCOLOR
SIF RESULT
	RETURN RESULT
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K97
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			;SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;CASE "一般依頼名"
			SELECTCASE SCENE
				CASE "依頼提示時"
					;依頼を持ちかけられる時
					PRINTFORML 「오, 안녕. 딱 제 시간에 왔네.」
					PRINTFORML 「이봐, 나 작은 일 하나 맡았는데. 관심 있어?」
					PRINTFORMW 「물론 수고한 만큼 보상해 줄 거야.%COND_STR(@" 하지만 팬티는 안 줄게, 아쉽지만.", CFLAG:1302)%」
				CASE "依頼非受託時"
					;内容だけ見て受託しなかった時
					PRINTFORMW 「...말이 안 통하는군.」
					PRINTFORMW 「음, 그럼 어떻게든 내가 알아서 처리해야겠어.」
				CASE "依頼受託時"
					;依頼を受託した時
					PRINTFORMW 「잘됐다, 네가 구원자구나. 그럼 제때 해 주길 바라네.」
					PRINTFORMW 「행운을 빌게, %CALLNAME:MASTER%.」
				CASE "依頼確認時"
					;[366]で依頼内容を依頼人に確認した時
					PRINTFORML 「뭐라고? 처음 들었을 때 잘 들었어야지...」
					PRINTFORML 「들어봐, 마지막으로 한 번 더 말해줄 테니 꼭 기억하도록 해.」
				CASE "依頼破棄時"
					;受託した依頼を破棄する時
					PRINTFORMW 「뭐, 별거 아니었겠지, 귀찮기만 했던 일이었나 보네.」
					PRINTFORMW 「혹시 폐를 끼쳤다면 미안해. 다음엔 그때 보자.」
				CASE "依頼実行直前"
					;[367]で依頼を実行する時、実行処理の前に呼び出される
				CASE "依頼実行直後"
					;[367]で依頼を実行する時、実行処理の後に呼び出される
				CASE "成功報告時"
					;報告時（成功）
					PRINTFORMW 「잘했어, %CALLNAME:MASTER%. 네가 해낼 줄 알았어.」
					PRINTFORMW 「큰 도움이 됐어. 적절한 보상을 해줄게.」
					IF !(TALENT:キス未経験 + TALENT:MASTER:キス未経験) && TALENT:恋人
						PRINTFORML 「그리고, 음... 작은 선물이랄까.」
						PRINTFORMDW 세이가 몸을 기울여 당신의 입술에 키스를 한다!
						CALL MUTUAL_KISS
					ENDIF
				CASE "失敗報告時"
					;報告時（失敗）
					;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					PRINTFORMW 「...오, 그거... 유감이군.」
					PRINTFORMW 「그 소식 들으니 안됐네. 뭐, 네가 좀 실망스럽긴 하지만 큰일은 아니야.」
					PRINTFORMW 「다음엔 바로 처리해, 알았지? 실패해서 자랑할 건 아무것도 없어.」
			ENDSELECT
			;ENDSELECT
			RETURN 1
		ENDIF
ENDSELECT
RESETCOLOR
;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================

@M_KOJO_IRAI_1_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF CFLAG:97:初期位置 == CFLAG:MASTER:初期位置
			PRINTFORML 「야, 너무 늦기 전에 서둘러서 해야 할 것 같아.」
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 내 방이 얼마나 지저분해질 수 있는지 알잖아?」
			PRINTFORML 「그래서... 나 좀 도와줄 생각 없어?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF CFLAG:97:初期位置 == CFLAG:MASTER:初期位置
			PRINTFORMW 「빨리 끝내자. 네가 시도하면 할 수 있다는 걸 알아.」
		ELSE
			PRINTFORMW 「그래, 고마워. 이런 사소한 일로 폐를 끼쳐서 미안해.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			PRINTFORML 「어라...? 쓰레기들이 다 어디로 갔지?」
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			RETURN 1
		ELSE
			;一緒に掃除する場合
			PRINTFORML 「같이 청소하면 이 정도는 재미있을 것 같다. 게다가 빠르기도 하다.」
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		IF CFLAG:97:初期位置 == CFLAG:MASTER:初期位置 || TALENT:恋人
			PRINTFORML 「여기 깨끗하게 유지해야지, 알잖아.」
		ELSE
			PRINTFORML 「헤이, 고마워. 오늘 기분이 정말 안 좋아서 도움이 좀 필요했거든.」
		ENDIF
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		IF CFLAG:97:初期位置 == CFLAG:MASTER:初期位置 || TALENT:恋人
			PRINTFORMW 「적어도 이제 내 방은 그렇게 역겹지 않아.」
			PRINTFORMW 「좋아, 여기 네가 노력해서 얻은 보상이야.」
		ELSE
			PRINTFORMW 「이제 좋은 냄새가 나네. 그리고 주변에 쓰레기도 안 보여.」
			PRINTFORMW 「응, 보상을 받을 자격이 있지.」
		ENDIF
		;【報酬獲得】
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼02：お花に水をあげて
;==================================================

@M_KOJO_IRAI_2_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「저기요, %CALLNAME:MASTER%... 집에 물을 줘야 하는 꽃들이 좀 있어서 말이에요...」
		PRINTFORML 「뭐라고? 안 보여도 나도 꽃이 있거든, 알겠어?」
		PRINTFORML 「그리고 아니야, 잔디가 아니라고. 조용히 해.」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;【◆口上】
		;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
		;【▼そのまま下の口上へ】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF ROLE == "CLIENT"
			;水やりした時、依頼主である口上主がTARGETの場合
			;この場合はそのまま下の口上へ続きます
			RETURN 0
		ELSEIF ROLE == "TARGET"
			;水やりした時、依頼主ではない口上主がTARGETの場合
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼04：料理上手になりたい
;==================================================

@M_KOJO_IRAI_4_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「요리 좀 도와주실래요?」
		IF TALENT:97:恋慕
			PRINTFORML 「...내 말은, 실제로 이걸 더 잘하고 싶어. 너와 나 자신을 위해서.」
			PRINTFORML 「나한테 애정 가득한 샌드위치 먹고 싶지? 그러니까 시작하자.」
		ELSE
			PRINTFORML 「계속 라면이나 다른 쓰레기 같은 것만 먹는 게 지겨져서, 뭔가 개선하고 싶어졌어.」
			PRINTFORML 「게다가 같이 하면 더 좋잖아, 그렇지?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		PRINTFORML 「아, 고마워요. 당신의 시간이 소중하다는 걸 알지만 최선을 다할게요.」
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF ABL:97:料理技能 < 2
			PRINTFORML 「일단 내가 처리할 수 있는 것부터 시작해야겠군...」
		ELSEIF ABL:97:料理技能 < 4
			PRINTFORML 「흠, 어째서 전보다 훨씬 쉬워 보이네.」
		ELSE
			PRINTFORML 「흥, 사실 네 도움이 필요하지 않았어.」
			PRINTFORML 「그냥 너랑 요리하고 싶었을 뿐이야.」
		ENDIF
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		IF ABL:97:料理技能 < 2
			PRINTFORML 「음, 생각보다 어렵지 않네. 먹을 만해 보이기도 하고, 헤헤.」
		ELSEIF ABL:97:料理技能 < 4
			PRINTFORML 「누군가와 요리하는 건 정말 재미있지 않아.」
		ELSE
			PRINTFORML 「그래, 이게 되어야지!」
			PRINTFORML 「내가 보기엔 고급 레스토랑에서 내놓아도 될 정도야.」
		ENDIF
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		PRINTFORML 「이 일에 시간을 내서 도와줘서 고마워.」
		PRINTFORML 「수고한 것에 대한 작은 선물이 여기 있어.」
		PRINTFORML 「주된 보상에 대해서 말하자면... 물론, 그 요리 자체가 되겠지!」
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
