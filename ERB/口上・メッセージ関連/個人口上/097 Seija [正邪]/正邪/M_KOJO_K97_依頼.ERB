			PRINTFORML 「...자, 여기서 난장판 만들 거니까. 나가고 싶으면 밖에 나가서 하자.」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			PRINTFORML 「아니, 안 돼. 지금 다른 일 중이야.」
			PRINTFORML 「...나를 비겁자라고 불러봤자 네 주장에 도움이 되진 않아. 나중에 다시 와.」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			PRINTFORML 「이런 것들을 하기엔 너무 지쳐 보이는군... 하지만 네가 가장 약할 때 나를 앞서려 드는 그 결정을 존중해.」
			PRINTFORML 「안타깝게도 이 땅의 규칙은 그것을 허용하지 않아. 아쉽지?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			PRINTFORML 「이런 확률, 별로 안 좋은 것 같아. 도저히 승산이 없는 기분이야.」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			PRINTFORML 「또? 패배를 인정 못 하는 건 그만둬. 충분히 했잖아. 이제 집에 가라.」
			RETURN 1
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			PRINTFORML 「뭐라고?! 전면적인 결투라니? 너랑 나라고?」
			PRINTFORML 「좋아, 해보시지! 하지만 진흙을 먹게 될 때 나한테 울지는 마!」
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				IF TALENT:97:恋慕
					PRINTFORML 「...미안하지만 당신에게조차 쉽게 해주지는 않을 거예요.」
					PRINTFORML 「최선을 다해야 할 겁니다, %CALLNAME:MASTER%.」
				ELSE
					PRINTFORML 「오호, 나를 노리고 있었나? 오늘은 안 될 것 같군!」
					PRINTFORML 「캬하하, 다음에 봐, 너 같은 바보야!」
				ENDIF
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:97:恋慕
				PRINTFORML 「…윽. 너무 거칠었어, %K97_DUDE()%.」
				PRINTFORML 「나중에 다른 방식으로 나에게 보답하게 해 줄게.」
				PRINTFORMDL 세이가 눈을 찡긋하며 당신의 무릎이 풀리게 만든다...
			ELSE
				PRINTFORML 「아악, 젠장! 방금 저렇게 질 줄은 몰랐어!」
				PRINTFORML 「이걸 기억할 거야... 언젠가 다시 붙자, 약속해!」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
