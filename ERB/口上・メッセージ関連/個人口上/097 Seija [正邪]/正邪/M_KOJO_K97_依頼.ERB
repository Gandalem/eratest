;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「헤이, 당신은 나한테 똑똑해 보이는 사람이군.」
		PRINTFORML 「내가 혼자서는 해결할 수 없는 문제가 하나 있어.」
		PRINTFORML 「혹시 그것에 대해 아는 게 있는지 궁금하네, 음?」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			PRINTFORML 「흠... 음, 혹시 의심되는 게 있다면 도서관을 확인해보는 것도 좋은 생각인 것 같아.」
			RETURN 1
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			PRINTFORML 「흠, 이 주제에 대해 내가 뭘 알 거라고 생각하는 거지?」
			PRINTFORML 「음, 내 머릿속은 관심 없는 선전물들로 가득 차 있지만, 한번 해볼 수 있을지 보자...」
			RETURN 1
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORML 「글쎄... 그게 우리에게 어느 정도 도움이 됐으면 좋겠어.」
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					PRINTFORML 「이봐, 노력해봤어. 네가 뭘 하든 행운을 빌게.」
					RETURN 1
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「음... 그래, 말이 되네.」
					CASE 2
						PRINTFORMW 「그럼 다시 말해서, 당신은—」
					CASEELSE
						PRINTFORMW 「그렇게 말하니...」
						PRINTFORMW 「와, 나 지금 바보 같아.」
				ENDSELECT
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「잠깐... 응? 뭔가 이상한 것 같은데.」
					CASE 2
						PRINTFORMW 「아니, 아니, 이미 그걸 시도해 봤어... 그건 안 될 거야.」
					CASEELSE
						PRINTFORMW 「...지금 지어내는 거잖아, 그렇지 않아?」
						PRINTFORMW 「네 수준을 벗어났다고 인정해.」
				ENDSELECT
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「응, 정말 고마워. 나중에 또 네게 의지할지도 몰라, %K97_DUDE()%.」
			CASE 2
				PRINTFORMW 「인간치고는 꽤 아는 것 같군. 잘됐네.」
			CASEELSE
				PRINTFORMW 「응, 이제 모든 걸 알겠어. 고마워.」
		ENDSELECT
		PRINTFORMW 「훌륭한 작업이었다. 지식은 내가 정말 부러워하는 부분이니 보상받아야 한다고 생각한다.」
		PRINTFORMW 「이 작은 선물을 내 감사함으로 받아줘. 나 지금 돈이 없어서, 당장은 이게 줄 수 있는 전부야, 미안해.」
		RETURN 1
	CASE "失敗報告時"
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「정말로 네 지능에 대해 그렇게 잘난 체할 필요는 없어.」
			CASE 2
				PRINTFORMW 「...만약 그 주제에 대해 아는 것이 없다면, 그냥 조용히 있는 게 좋을지도 모릅니다?」
			CASEELSE
				PRINTFORMW 「봐, 나는 일화나 소문을 필요로 하지 않아. 확실한 사실이 필요해.」
		ENDSELECT
		PRINTFORMW 「칫. 물어보지 말았어야 했는데. 귀찮게 해서 미안해.」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
