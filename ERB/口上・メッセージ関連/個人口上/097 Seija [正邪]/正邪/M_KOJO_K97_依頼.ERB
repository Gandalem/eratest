@M_KOJO_IRAI_15_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORMW 「%CALLNAME:MASTER%...」
		PRINTFORMDW 세이야는 어쩐 일인지 매우 수줍어 보인다.
		PRINTFORMW 「\@ CFLAG:1302 ? 정말 당신 같은 사람에게 부탁하기 싫지만 # 방해해서 미안해요, 그냥 \@... 기운을 좀 차리고 싶어서요.」
		PRINTFORMW 「좀 역겹다는 건 알지만, 그래도 말이죠. 그 기분 아시잖아요, 그렇죠?」
		PRINTFORMW 「자, 시간 값은 해 드릴게요. 어때요?」
	CASE "依頼非受託時"
		PRINTFORMW 「그래, 체형이라니...」
		PRINTFORMW 「그냥 잊어줘. 내가... 처리할게.」
		PRINTFORMDW 세이가 다소 우울한 듯 걸어간다...
	CASE "依頼受託時"
		PRINTFORMW 「헤이, 고마워. 난 그걸 감사하게 생각해.」
		PRINTFORMW 「네가 나를 거절할 줄은 예상하고 있었지. 뭐, 그렇다면...」
		PRINTFORMW 「시간 낭비하지 말자고, 응?」
	CASE "依頼確認時"
		PRINTFORML 「설명할 것도 없잖아...」
		PRINTFORML 「네가 그걸 넣으면 내가 기분이 좋아지고, 우리 둘 다 한동안 서로의 시간을 즐길 수 있을 거야...」
		PRINTFORML 「다 알고 있잖아.」
	CASE "依頼破棄時"
		PRINTFORMW 「네? 포기하기로 결정했어?」
		PRINTFORMW 「음... 뭐, 그게... 적어도 좀 골치 아프다고 할 수 있겠네요.」
		PRINTFORMDW 세이가 어색하게 몸을 움직이며 허벅지를 비빈다.
	CASE "依頼実行直前"
		LOCAL:99 = IS_DOUTEI(MASTER)
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		PRINTFORMW 「음, 정말 좋았어. 내가 원하던 걸 얻었거든.」
		PRINTFORMW 「%CALLNAME:MASTER%씨, 정말 감사합니다. 나중에 봐요.」
		IF LOCAL:99
			PRINTFORMW 「그리고, 음... 네 첫 경험치고 이렇게 해야 해서 미안해.」
			PRINTFORMW 「아니, 너 놀리려는 거 아니야, 긴장 풀어. 빨리 끝났지만... 더 나아질 거야.」
			CALL M_KOJO_DIARYSETTING_K97(47)
		ENDIF
	CASE "失敗報告時"
		PRINTFORMW 「와, 그걸 정말 잊고 있었어?」
		PRINTFORMW 「에이, %K97_DUDE()%……」
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "Moan"
		IF !TALENT:恋慕
			LOCALS =
			SIF !TALENT:妊娠
				LOCALS += @"너무 많은 정액이네, 쯧... 왜 그렇게 애써 날 임신시키려고 하는 거야? 절대 네 %PLNOUN("kid", PREGNANCY_MULTIPLES(97))%, %K97_IDIOT_RUDE()%는 갖지 않을 거야..."
			LOCALS += "We're not here to make love, y'know... Just get it over with quickly...!:"
			LOCALS += "Quit clinging to me so much... It's disgusting!:"
			LOCALS += @"너 정말 이거 못하네, %K97_IDIOT_RUDE()%…"
			LOCALS += @"%K97_IDIOT(1)%은(는)! 너 정말 못 참겠어...!"
			LOCALS += @"너 온몸으로 절정에 달해서 나를 완전히 %K97_PERV()%처럼 가득 채우는 걸 봐..."
			LOCALS += @"나를 가질 수 있다고 자만하지 마라, %K97_IDIOT()%…"
			LOCALS += @"내가 이걸 돈 내고 한다니 믿을 수가 없어... 너 정말 형편없구나, %K97_DUDE()%이야."
			CALL K97_SEX_VOICE()
			PRINTFORML 「%SPLIT_G(LOCALS)%」
			PRINTFORMDL 세이가 신음 사이로 욕설을 늘어놓으며 즐기지 않는 것처럼 보이려고 최선을 다한다...
			RESULT:100 = 1
			RETURN 1
		ENDIF
		RETURN 0
ENDSELECT
RETURN 1
;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================

@M_KOJO_IRAI_16_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「야 %K97_DUDE()%, 너한테 뭔가 물어볼 게 있어.」
		PRINTFORML 「이 문제에 대해 외부인의 시각이 필요해서, 네 생각을 듣고 싶어.」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		IF TFLAG:193 == 1
			;正解の選択肢
			PRINTFORMW 「그렇지? 내가 알고 있었어!」
			PRINTFORMW 「물론 내가 먼저 생각해냈기 때문에 모든 공로는 내 것이지만, 피드백은 고맙게 받아들일게.」
			PRINTFORMW 「정말 고마워.」
		ELSEIF TFLAG:193 == 2
			;ハズレの選択肢だったが逆に正解
			PRINTFORMW 「그건... 잠깐, 뭐라고 했지?」
			PRINTFORMW 「어쩌면 잘 될지도 몰라! 나랑 같은 파장을 가질 줄이야, 너 정말 흥미로운 %PRINT_MALE("guy", MASTER)%야, 알고 있니?」
		ELSEIF TFLAG:193 == -1
			;ハズレの選択肢
			PRINTFORMW 「%SPLIT_G(@"I thought you were a shrewd %PRINT_MALE("guy", MASTER)%. Guess I was mistaken.:Nope. Try something less lame next time.:Is that all you could think of? ...Whatever.")%」
		ELSEIF TFLAG:193 == -2
			;正解の選択肢だったが逆にハズレ
			PRINTFORMW 「이런, 이미 생각해냈다고! 여기 좀 새로운 게 필요해.」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：野菜か果物
		PRINTFORMW 「이런 수고에 채소 좀 가져왔다.」
		PRINTFORMW 「상해서는 안 되도록 신경 썼으니 걱정 마라.」
		RETURN 1
	CASE "失敗報告時"
		PRINTFORMW 「흥, 내가 왜 수고를 들었을까...」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "口上委託率"
		;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
		RESULT:100 = 30
		;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
		;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
		;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
		;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
		RESULT:1 = 0
		RESULT:2 = 0
		RETURN 0
	CASE "口上専用"
		;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
		;16,お悩み相談 の場合
		;RESULT        発生判定,0だと発生しません
		;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
		;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
		;RESULTS:0     お悩み文章（自動で『』で囲まれます）
		;RESULTS:1～3  選択肢１～３
		;何も発生しない状態になると無限ループになるので注意してください
		;●追記メモ
		;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
		;RESULT:1を7にするとどれも正解になります
		;RESULT:1を8にするとどれもハズレになります
		;1～3以外の場合は逆張り判定が自動で無くなります
		RESULT = 0
		SELECTCASE RAND:2
			CASE 0
				SIF 1
					RESULT = 1
				RESULTS:0 = How should I try and conquer Gensokyo?
				RESULTS:1 = Why conquer now? Lay low and wait for an opportunity
				; [AUTO-NEUTRALIZED] RESULTS:2 = 1) Cause an incident 2) ????????? 3) Profit!
				RESULTS:3 = Rally the weak, strike the strong!
				RESULT:1 = 2
				RESULT:2 = 1
			CASE 1
				SIF 1
					RESULT = 1
				RESULTS:0 = How can I improve my fashion sense concerning my dress?
				RESULTS:1 = Shorter skirt!
				RESULTS:2 = More frills!
				RESULTS:3 = Transparent skirt!
				RESULT:1 = 1
				SIF ABL:親密 >= 10
					RESULT:1 = 3
		ENDSELECT
		;▼サンプル
		SIF !RESULT
			RESTART
		RETURN 1
ENDSELECT
