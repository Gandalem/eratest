;依頼口上・一般依頼05：特訓につきあって
;==================================================

@M_KOJO_IRAI_5_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「더 강해져야 해... 지금보다 훨씬 더...」
		PRINTFORML 「헤이 %CALLNAME:MASTER%, 결투 어때? 걱정 마, 사실 스파링 같은 거니까.」
		PRINTFORML 「우리 약골들은 최대한 많이 훈련해야겠지? 같이 하면 일석이조잖아.」
		PRINTFORML 「자!」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		PRINTFORML 「좋아! 그럼 적절한 곳을 찾아보자.」
		PRINTFORMW 「어차피 별다른 주목을 받고 싶지도 않으니까 말이야.」
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		PRINTFORML 「자, 시작해 보자!」
		;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		PRINTFORML 
		PRINTFORMDL 당신은 다음 한 시간 동안 세이가와 스파링을 했고, 그녀가 말한 대로 힘을 아끼는 것 같았다. …겨우 그랬다.
		PRINTFORMDW 그래도 혹시라도 낮은 공격을 사용할까 봐 경계를 늦출 수는 없었다.
		PRINTFORMD …그 결과, 
		IF RAND:2
			PRINTFORMDW 너 %SPLIT_G("had her completely beat:barely managed to win:managed to pull a come from behind victory and snowball it from there")% 끝에서!
			PRINTDATAW
				DATAFORM 「흥, 나쁘지 않아. 뭘 해야 할지 알겠군. 덕분에 꽤 깨달음을 얻었어, 고마워.」
				DATAFORM 「제기랄, 네가 참 대단하구나. 비록 힘을 아끼고 있었을 때조차도... 요즘 인간들은 정말 강해졌어.」
				DATAFORM 「...너 거의 노력한 것 같지 않아? 나에게는 아직 갈 길이 멀다는 게 느껴지는군.」
			ENDDATA
		ELSE
			PRINTFORMDW 세이가 %SPLIT_G("had you completely beat:barely managed to win:managed to turn the tables on you")% 끝에!
			PRINTDATAW
				DATAFORM 「아야. 진짜 아까웠어, 솔직히 말해서. 다음에 또 하자.」
				DATAFORM 「음, 스파링에서 이기는 게 대단한 건 아니지만... 응, 기분 좋아.」
				DATAFORM 「...게 따라가려면 여전히 온갖 비겁한 수법을 써야 했어. 와, 정말 필사적이네.」
			ENDDATA
		ENDIF
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
