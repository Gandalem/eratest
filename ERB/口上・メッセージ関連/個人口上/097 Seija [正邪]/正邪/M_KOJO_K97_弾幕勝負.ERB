; Modular ERB: 個人口上/097 Seija [正邪]/正邪/M_KOJO_K97_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K97_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;戦闘前
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
		;added
		IF CFLAG:弾幕勝負勝利 && ABL:MASTER:戦闘能力 > ABL:戦闘能力 ;if beat and you're stronger
			IF FIRSTTIME("SeijaAblFlip")
				PRINTFORMW 「인정하겠어, 너 엄청 강하구나...」
				PRINTFORMW 「아니, 이쯤 되면 날 망신시키고 싶어서 그러는 거잖아?」
				PRINTFORMW 「우리 좀 공평하게 겨뤄보는 건 어때?」
				PRINTFORML
				PRINTFORMW 역으로 "하늘 아래 모든 것을 뒤엎다"
				PRINTFORMDW 세이가 당신의 전투 능력을 뒤집으며 손가락을 내밀었다!
				PRINTFORMDW 무슨 비열함이...
				PRINTFORML
				PRINTFORMW 「아아... 훨씬 낫군. 정말 효과가 있었다니 믿을 수가 없네.」
				PRINTFORMW 「보라고, 이게 내가 말하는 균형이야.」
				PRINTFORMW 「...그럼에도 불구하고 이 힘은 터무니없어. 대체 어떻게 그렇게 강해질 수 있었지...?」
				PRINTFORML
				PRINTFORMW 「자, 그럼 시작해 볼까?」
				BASE:体力 -= 300
				LOCAL = ABL:戦闘能力
				LOCAL:1 = ABL:MASTER:戦闘能力
				ABL:MASTER:戦闘能力 = LOCAL
				ABL:戦闘能力 = LOCAL:1
				TCVAR:390 = 1
			ELSE
				PRINTFORMW 「벌써 질렸나?」
				PRINTFORMW 「음, 어떻게 할지는 네가 결정하게 해 주지.」
				CALL ASK_YN("플립 모드", "일반 모드")
				IF RESULT ;normal
					PRINTFORMW 「또 나를 때려봐 줄래?」
					PRINTFORMW 「정말 잔인하군...」
					PRINTFORML
					GOTO COMBAT
				ELSE
					PRINTFORMW 「오, 도전을 좋아하는군? 나도 상관없어!」
					PRINTFORMW 「네 돈을 걸고 한번 해보지, 그 점은 확실히 하겠다...」
					PRINTFORMW 「하지만 이건 나한테 꽤 지루한 일이니까, 잘 즐겨줘야 할 거야!」
					BASE:体力 -= 300
					LOCAL = ABL:戦闘能力
					LOCAL:1 = ABL:MASTER:戦闘能力
					ABL:MASTER:戦闘能力 = LOCAL
					ABL:戦闘能力 = LOCAL:1
					TCVAR:390 = 1
				ENDIF
			ENDIF
		ELSE
			$COMBAT
			;怒り
			IF CFLAG:318 == 1
				PRINTFORMW 「나를 화나게 한 대가를 치르게 될 거야!」
			ELSEIF RAND:4 == 0
				PRINTFORMW 「자, 시작하자! 너무 세게 하지 말아줘, %K97_DUDE()%!」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「모든 것이 뒤집히는 세상에 빠져버려라!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「%SPLIT_G("내가 약점의 진정한 의미를 보여주지: 네가 얼마나 약한지를 보여줄게")%!」
			ELSE
				PRINTFORMW 「%SPLIT_G("Too bad, but this is as far as you go:Sorry not sorry, but this is where it ends for you")%, 이 자식아!」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				IF TCVAR:390 ;added, during flip mode
					PRINTFORMW 「후우, 좋은 시작이군!」
					PRINTFORMW 「좋아, 이제 진지해질 시간이야! 강한 자에게 괴롭힘을 당하는 기분이 어떤 건지 배울 시간이다!」
					HANDICAP_FIXED += 50
					;怒り
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「나랑 건방지게 굴지 마, 이 녀석아!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「허, 나쁘지 않네.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「흐음? 이 반쯤 제대로 된 패턴은 뭐야? 나를 가볍게 보는 거야?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「흥, 아직은 하지 마! %SPLIT_G("get your hopes up:get your knickers in a twist:be so sure")% 아직은!」
				ELSE
					PRINTFORMW 「%SPLIT_G("헤에, 너 그렇게 대단한 존재 아니야: 신경 쓸 가치 없어")%!」
				ENDIF
			CASE 1
				IF TCVAR:390 ;added, during flip mode, last ditch effort
					PRINTFORMW 「정말 또 지고 싶지 않아, 그래서...」
					PRINTFORMW 방향 전환 "역 위계"!!!
					PRINTFORMW 「이번에는 불가능한 스펠 카드 맛을 보여줄까?」
					PRINTFORMDW 세이가 상징적인 포즈를 취하며 외친다!
					PRINTFORMW (젠장, 치트 아이템들이 아직 내 옆에 있었으면 좋겠는데...)
					LOCAL = RAND(30, 61)
					HANDICAP_FIXED += LOCAL
					HANDICAP_RAND += LOCAL * ABL:戦闘能力
					;怒り
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「젠장! 빌어먹을!」
				ELSEIF RAND:5 == 0 ;added
					PRINTFORMW 「크윽, 이게 끝인가...? 안 돼! 아직이야!」
					PRINTFORMW 「이 진심 어린 좌절을 맛보게 해주마!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「하! 이게 그들이 말하는 궁지인가?! 최고의 기분이군!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「구석에 몰린 아만오자쿠는 사나울 수 있어, 모르나! 그리고 난 이제 익숙해졌어!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「솔직히 말해서 너한테 전할 게 있는데, 난 싸움에서 단 한 번도 이득을 본 적이 없어! 넌 날 겁먹게 못 해!」
				ELSE
					PRINTFORMW 「남은 생명 하나뿐이군, 상황이 정말 좋네... 내가 판을 뒤집어 주마!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「아, 꺼져, 농담이지...!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「...%SPLIT_G("저주: 이 망할 자식: 제기지")%...!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「...잘 해내네. 잘했어, %K97_DUDE()%이(가).」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「...」
				ELSE
					PRINTFORMW 「%SPLIT_G("아냐, 나 걱정 마:괜찮아")%. %SPLIT_G("늘 있는 일이야: 나한테는 평범한 일이지: 그냥 똑같아")%...」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		IF RAND:5 == 0 ;added
			PRINTFORMW 「너는 지옥에 갈 것이다!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「가장 비겁하고, 부당하며, 불합리하고, 터무니없다!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「절대로 경계를 풀지 마라, 강자여!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「거기에 아무것도 떨어뜨린 게 없는지 확인해 보는 편이 좋을 거야, 알잖아?」
		ELSE
			PRINTFORMW 「그냥 계속 던지면 되잖아?」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				IF TCVAR:390
					PRINTFORMW 「지금 너 정말 한심하다. 이게 네가 할 수 있는 전부인가?」
					;怒り
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「흥, 이걸 교훈으로 삼아라. 다시 나를 화나게 하기 전에 두 번 생각하길 바란다.」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「하하하! 나한테 지게 둘 순 없어! 이대로는 절대 못 버틸 거야!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아니, 결국 그렇게 대단한 존재가 아니었구나? 예상했던 바는 아니네.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「음, 정말 실망이군.」
				ELSE
					PRINTFORMW 「흥, 그러니까 당신은 우리 쪽 사람이란 거군요?」
				ENDIF
			CASE 2
				IF TCVAR:390
					PRINTFORMW 「너는 발버둥 치고 싸웠지만, 충분하지 않았다! 내 입장이 되어보니 어떤 기분이지, 응?」
					;怒り
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「흥... 나한테 고생을 시키다니, 빌어먹을...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「주석을 달 가치가 없는 수준의 강함이라고 말해야겠군.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%SPLIT_G("그거 생각보다 약하네:너 생각보다 약하다:이렇게 약할 줄은 몰랐어")%.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「약자 편도 들고 싶어?」
				ELSE
					PRINTFORMW 「그건... 흥미로운 게 있었지, %K97_DUDE()%.」
				ENDIF
			CASE 1
				IF TCVAR:390
					PRINTFORMW 「오 그래, 거의 다 왔어! 하지만 충분하지 않아. 왜 이렇게, 너무나 좌절스러운지 이제 이해했니?」
					;怒り
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「젠장... 네가 나보다 더한 개자식이라니, 그렇지 않아...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「...정말 나한테 힘든 걸 주네. 그게 내가 말하는 바야!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「오우-오우-오우... 야, 이거 너무 지루했잖아!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「이게 내가 겪은 가장 재미없는 일일 거야!」
				ELSE
					PRINTFORMW 「...네가 할 때는 정말 대단한 힘을 보여주는군, 응.」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「꺼져라! 이걸 절대 못 잊을 거야!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「...흥. 할 수 있는 한 계속 다시 시도해 봐야지.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「와, 잘했어! 최고야, %K97_DUDE()%!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「쿠, 망했어! 너무 성급했군... 확실히 너무 일찍 욕심을 부렸어.」
				ELSE
					PRINTFORMW 「언젠가 이 걸 꼭 이길 테니까 기억해라, 이 바보야!」
				ENDIF
				;added, after first win
				IF !CFLAG:弾幕勝負勝利
					PRINTFORML
					PRINTFORMW 「우와 와, 젠장... 내가 실수했나 보네?」
					PRINTFORMW 「언제부터 그렇게 강해진 거야? 너는 온통 미스터리뿐이야, 정말...」
					PRINTFORMW 「그리고 난 그 모든 것을 풀어낼 생각으로 가득 차 있어!」
					PRINTFORMW 「다음번엔 만반의 준비를 해 둘 테니 두고 봐라...」
				ENDIF
		ENDSELECT
		;added
		IF TCVAR:390
			PRINTFORML
			LOCAL = ABL:戦闘能力
			LOCAL:1 = ABL:MASTER:戦闘能力
			ABL:MASTER:戦闘能力 = LOCAL
			ABL:戦闘能力 = LOCAL:1
			TCVAR:390 = 0
			IF 相手残機 == 0
				PRINTFORMW 「크윽, 제기랄! 그 모든 힘으로도 여전히 부족했군...」
				PRINTFORMW 「잘 해줬네, 뭐... 나를 약하다고 생각할지도 모르겠지만 나는 수완이 좋아! 그리고 포기하는 시점을 모른단 말이야!」
				PRINTFORMW 「연구해서 다음엔 반드시 이길 테니 지켜봐!」
			ELSE
				IF CFLAG:弾幕勝負勝利 && FIRSTTIME("SeijaWon")
					PRINTFORMW 「아우, 이겼다! 자업자 격이지!」
					PRINTFORMW 「하아, 이런 게 당신 같은 사람을 이기려면 필요한 거구나.」
					PRINTFORMW 「뭐, 적어도 내가 완전히 압도하지는 않았다는 건 다행이군. 그 점에 감사한다.」
					PRINTFORMW 「자, 일어나. 금방 괜찮아질 거야. 맥주라도 한잔 사줄게.」
				ELSE
					IF TALENT:恋慕
						PRINTFORMW 「아, 뭐 안됐네. 이번엔 안 될 것 같아.」
						PRINTFORMW 「그래도 잘했어, 정말로. 자, 이제 맛있는 거 먹거나 목욕이라도 하자.」
						PRINTFORMW 「나중에 원하면 언제든 다시 붙을 수 있어.」
					ELSE
						PRINTFORMW 「네가 감당할 수 있는 것 이상을 물어뜯은 모양이군, 멍청아!」
						PRINTFORMW 「이제 내가 네 실패를 비웃고 자화자찬하는 순간이 온 거야! 카하하하!」
						PRINTFORMDW 세이가 의기양양하게 깔깔 웃는다...
					ENDIF
				ENDIF
			ENDIF
			IF 相手残機 == 0 ;bonus exp for winning during flip mode
				PRINTFORML
				LOCAL = LIMIT((HANDICAP_FIXED / 10) * 3, 1, 50)
				CALL COLORMESSAGE(@"보너스 전투경험+{LOCAL}",C_YELLOW,2,1)
				EXP:MASTER:戦闘経験 += LOCAL
				PRINTFORMDW 세이야도 꽤 많은 것을 배운 것 같았다.
				EXP:戦闘経験 += LOCAL*2
			ENDIF
			IF FIRSTTIME("SeijaReverseFight")
				PRINTFORML
				PRINTFORMW 「아, 맞다. 너한테 능력 돌려줘야 하는데... 안 돼!」
				PRINTFORMDW 세이야가 악당처럼 당신을 보고 웃는다...
				PRINTFORMDW 하지만 이내 멈춘다.
				PRINTFORMW 「...에이, 농담이었어. 나 이거 오래 유지 못 하거든, 알잖아.」
				PRINTFORMW 「기분 나빠하지 마, 알았지? 그냥 장난친 것뿐이야.」
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
