;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K97_100
CALL M_KOJO_MESSAGE_COM_K97_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「...나아아?!」
		PRINTFORMW 「아아악...! 응아아?! 이봐, 그만두라고 이 개자식아! 죽고 싶어?」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 시간을 멈춘 상태에서 그녀의 엉덩이를 드러낸 채 당신은 시자(Seija)를 무릎 위에 앉히고 엉덩이를 때리고 두드린다.
	ELSE
		PRINTFORMW 「%GROAN(,,RAND(1, 4))%...\@ ABL:マゾっ気 >= 5 ? %UNICODE(0x2764)% ...%SPLIT_G(@"%MOAN()%Kyahn:아아앙")%! # %SPLIT_G(" Hiiii?!: Eeeekkk?!: Ahiiii?!: Ighiii?!: Aghhaaa?!: ...?!:::")%\@」
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「...%SPLIT_G("내 엉덩이가 너무 아파:봐, 너:들어봐, 너:이봐 이제 그만해:제발, 그만 좀 해줘:아이고:젠장")%...%SPLIT_G("!::")%」
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「...%SPLIT_G("하아... 정말 지금?: 아악... 제발 좀 하지 마라: 제발 그만하라고 했잖아: 아얏!: 아이야 아이야: 우와아앙: 고통")%...%SPLIT_G("!::")%」
			;それ以外
		ELSE
			PRINTFORMW 「...%SPLIT_G("제기랄, 왜 이래: 그만 좀 때려, 아파잖아:아프다고, 빌어먹을:난 고통 느끼는 거 아무렇지도 않으니까 그만해:나 지금 아프단 말이야, 제발")%...%SPLIT_G("!::")%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
