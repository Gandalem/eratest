;==================================================
;104,アイマスク
;==================================================

@M_KOJO_MESSAGE_COM_K97_104
CALL M_KOJO_MESSAGE_COM_K97_104_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_104_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 &&  LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음... 아 맞다, 그 소위 안대 말이지...」
		PRINTFORMW 「...그래서 그걸로 뭘 할 셈이야?」
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		;時姦中
		IF FLAG:70
			PRINTFORMDW 당신은 시간 정지 중에 세이가의 눈에 안대를 씌운다.
		ELSE
			PRINTFORMW 「%SPLIT_G("아:오:뭐야--:음:어이:오, 저거:흠:쳇:허")%...%COND_STR(@"%UNICODE(0x2764)%", ABL:マゾっ気 >= 5)%」
			;恋慕
			IF TALENT:恋慕
				PRINTFORMW 「...%SPLIT_G("좀 신나는 것 같아, 아주 조금이라도: 너 이거 정말 공을 많이 들였구나, 안 그래?: 제발... 내 시간 들일 만하게 만들어 봐")%...」
				;屈服3
			ELSEIF MARK:不埒刻印 == 3
				PRINTFORMW 「...%SPLIT_G("음, 그냥 좀... 괜찮은 것 같아: 뭐, 네가 하고 싶은 대로 해: 이 정도면 나쁘지 않은 것 같네.")%...」
				;それ以外
			ELSE
				PRINTFORMW 「...%SPLIT_G("너 같은 애들은 정말 변태적이구나. 난 딱히 상관 안 하지만 말이야.")%...」
			ENDIF
		ENDIF
		;解除
	ELSE
		PRINTFORMW 「%SPLIT_G("음:어? 아:아")%...」
		PRINTFORMW 「...%SPLIT_G("벌써 다 했어:끝난 거야:다 끝냈어:확실해:벗어버릴까:벌써 지겨워")%...?」
	ENDIF
ENDIF
RETURN 1
;==================================================
;105,縄
;==================================================

@M_KOJO_MESSAGE_COM_K97_105
CALL M_KOJO_MESSAGE_COM_K97_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_105_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		;elaborated a bit
		PRINTFORMW 「아, 너 같은 애들...」
		PRINTFORMW 「자, 나를 붙였구나. 이제 어쩔 거야?」
		PRINTFORMW 「그냥... 무슨 짓이라도 하면 둘 다 후회할 테니 그런 거 하지 마.」
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:縄
		;時姦中
		IF FLAG:70
			PRINTFORMDW 시간 정지 중 당신은 밧줄로 세이가의 몸을 구속한다.
		ELSE
			PRINTFORMW 「%SPLIT_G("아:오:뭐야--:음:어이:오, 저거:세상에:젠장, 너:흠:야")%...%COND_STR(@"%UNICODE(0x2764)%", ABL:マゾっ気 >= 5)%」
			;恋慕
			IF TALENT:恋慕
				PRINTFORMW 「...%SPLIT_G("상관없어. 뭐든 하고 싶은 대로 해봐. 흥, 별로 불평할 것도 없네.")%...」
				;屈服3
			ELSEIF MARK:不埒刻印 == 3
				PRINTFORMW 「...%SPLIT_G("이거 정말 멀리 갔네, 응: 이런 취향을 가졌구나, 응: 설마 나를 일방적으로 범할 계획인 건 아니겠지")%...?」
				;それ以外
			ELSE
				PRINTFORMW 「...%SPLIT_G(@"너 같은 애가 왜 그랬냐고: 네가 얼마나 변태적인지 말이야:%K97_WHATEV()%, 알잖아")%...」
			ENDIF
		ENDIF
		;解除
	ELSE
		PRINTFORMW 「...%SPLIT_G("치, 쯧, 큭, 아, 하")%.」
		PRINTFORMW 「%SPLIT_G("나 솔직히... 이거 별로 안 좋아해. 알아둬: 이제 끝났어: 너 끝이야, 씨발 다행이다: 있잖아, 이런 거 말이야... 팔이 완전히 저려 죽겠어")%...」
	ENDIF
ENDIF
RETURN 1
