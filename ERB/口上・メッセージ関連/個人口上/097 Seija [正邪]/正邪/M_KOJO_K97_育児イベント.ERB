; Modular ERB: 個人口上/097 Seija [正邪]/正邪/M_KOJO_K97_育児イベント.ERB
;custom added
;-------------------------------------------------
;デイリーイベント：子供が寺子屋で
;ARG	子供の番号（例：子供の名前は『%CHILDNAME:X:ARG%』）
;-------------------------------------------------

@M_KOJO_EVENT_K97_CHILD_DAIRY_寺子屋(ARGS,ARG,ARG:1)
IF ARGS == "怪我させた"
	IF FIRSTTIME("ChildPunishment", 0, 97)
		PRINTFORMW 「아, 이런.」
		PRINTFORMW 「우리 \@ CHILD_SEX:97:ARG == 1 ? 딸 # 아들이 나쁜 행동을 하기까지 이렇게 오래 걸릴 줄은 몰랐다. 부모로서 실패한 것 같군~」 \@
		PRINTFORMDW 이건 웃을 일이 아니다... 아마노자쿠의 아이가 애초에 사찰 학교에 다닐 수 있었다는 게 기적이다.
		PRINTFORMW 「%CHILDNAME:97:ARG%이 열심히 하고 있어...」
		CALL PRINT_DIALOGUE, @"그래, %HE_SHE_CHILD(97, 0, ARG)%가 너한테서 그걸 얻은 게 확실해 보여. 이봐, 내가 %HIM_HER_CHILD(97, 0, ARG)%랑 얘기해 볼게, 알았지? %HIM_HER_CHILD(97, 0, ARG)%한테 조용히 지내라고 말할 거야.", "w"
		CALL PRINT_DIALOGUE, @"아니면 반대쪽이 더 나을지도? 내가 %HIS_HER_CHILD(97, 0, ARG)% 정도의 연령이었을 때, 나도 장난치기 시작했거든. 나는 항상 들은 것과 정반대로 행동했어.", "w"
		PRINTFORMDW 그러면 %HIM_HER_CHILD(97, 0, ARG)%은 더 나빠지겠군...
		PRINTFORMDW 세이야는 꽤 기뻐하는 것 같지만, 너는 네 아이의 행동에 대한 모든 책임을 떠안아야 했어...
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「흥, 잘했다 %CHILDNAME:97:ARG%어!」
				PRINTFORML 「잠깐, 아니야, 그거 말고! 이쪽으로 와!」
			CASE 1
				PRINTFORML 「젠장, 이 자식아!」
				PRINTFORML 「내가 가서 부모처럼 대해주게 만들지 마라!」
			CASE 2
				PRINTFORML 「봐라, 내 아이야...」
				PRINTFORML 「네가 빌어먹을 바보라는 거 알아도, 아빠 말을 듣고 %HE_SHE(MASTER)%가 시키는 대로 해야 한다.」
				PRINTFORML 「왜냐하면 %HE_SHE(MASTER)%는 항상 제일 잘 알거든, 알겠지?!」
		ENDSELECT
		PRINTFORMDW 세이가 도망치는 %CHILDNAME:97:ARG%을 붙잡고, 자신의 무릎 위에 %HIS_HER_CHILD(97, 0, ARG)%의 자식을 앉히고 %HIM_HER_CHILD(97, 0, ARG)%에게 소름 끼치는 이유를 알려준다...
	ENDIF
ELSEIF ARGS == "褒められた"
	;PRINTFORML
ENDIF
