;-------------------------------------------------
;デイリーイベント：子供が寺子屋で
;ARG	子供の番号（例：子供の名前は『%CHILDNAME:X:ARG%』）
;-------------------------------------------------
@M_KOJO_EVENT_K97_CHILD_DAIRY_寺子屋(ARGS,ARG,ARG:1)
IF ARGS == "怪我させた"
	IF FIRSTTIME("ChildPunishment", 0, 97)
		PRINTFORMW 「Oh boy, oh dear.」
		PRINTFORMW 「It took this long for our \@ CHILD_SEX:97:ARG == 1? daughter # son \@ to misbehave. I think we have failed as parents～」
		PRINTFORMDW This is no laughing matter... It's a miracle that they've let a child of amanojaku to attend temple school in the first place.
		PRINTFORMW 「%CHILDNAME:97:ARG%'s working hard...」
		CALL PRINT_DIALOGUE, @"Yeah, %HE_SHE_CHILD(97, 0, ARG)% got that from you, I bet. Look, I'll talk with %HIM_HER_CHILD(97, 0, ARG)%, alright? I'll tell %HIM_HER_CHILD(97, 0, ARG)% to lay low.", "w"
		CALL PRINT_DIALOGUE, @"Or maybe the other way around is better? When I was %HIS_HER_CHILD(97, 0, ARG)% age, that's when I started to get mischievous too. I did the opposite of what I was told all the time.", "w"
		PRINTFORMDW That'll just encourage %HIM_HER_CHILD(97, 0, ARG)% then...
		PRINTFORMDW Seija seems quite elated, while you had to bear the whole responsibility for your child's actions...
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「Heh, good job %CHILDNAME:97:ARG%!」
				PRINTFORML 「Wait, no, not that! Get over here!」
			CASE 1
				PRINTFORML 「Dammit you brat!」
				PRINTFORML 「Don’t make me come over there and be a parent!」
			CASE 2
				PRINTFORML 「Look, my child...」
				PRINTFORML 「I know you're fuckin' stupid, but you should listen to your father and do as %HE_SHE(MASTER)% tells you.」
				PRINTFORML 「Because %HE_SHE(MASTER)% always knows best, got it?!」
		ENDSELECT
		PRINTFORMDW Seija catches the fleeing %CHILDNAME:97:ARG%, puts %HIS_HER_CHILD(97, 0, ARG)% offspring across her knee and knocks sound reason into %HIM_HER_CHILD(97, 0, ARG)%...
	ENDIF
ELSEIF ARGS == "褒められた"
	;PRINTFORML 
ENDIF
