@M_KOJO_MESSAGE_COM_K97_144
CALL M_KOJO_MESSAGE_COM_K97_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「...좋아, 알겠어... 내가 할게...」
		PRINTFORMW 「음... 후우... 그렇게 뚫어져라 쳐다보지 마...」
		PRINTFORML
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「...후우...」
		PRINTFORMW 「...뭐야? 너한테 흥미로웠어, 응?」
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「나 그냥 소변 좀 봐야겠어, 안 그래...?! 제기랄...」
		PRINTFORMW 「...이제 만족해?」
		;それ以外
	ELSE
		PRINTFORMW 「...%K97_PERV(1)%.」
	ENDIF
ENDIF
RETURN 1
