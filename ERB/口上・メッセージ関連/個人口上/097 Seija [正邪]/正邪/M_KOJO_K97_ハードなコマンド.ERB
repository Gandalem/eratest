;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K97_140
CALL M_KOJO_MESSAGE_COM_K97_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		;replaced
		PRINTFORMW 「당신은 뭐... 윽!」
		PRINTFORMW 「크윽, 아아아, 헉!」
		PRINTFORMW 「콜록콜록, 헛기침, 크하아!!! ...하아, 이런...」
		IF TALENT:恋慕 || TALENT:服従
			PRINTFORMW 「알았어... 뭐, 도움이 될 거면 내 뿔을 마음껏 사용해도 돼... 아, 그리고 또...」
			PRINTFORMW 「주저하지 마!」
		ELSE
			PRINTFORMW 「크아악, 날 죽으려고 얼굴로 박는 거야, 이 망할 자식아-- 음흠!!」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;this action actually doesn't work in ts
		PRINTFORMDW 당신은 그것을 시작하면서 세이야의 입 깊숙한 곳에 %FSYN("thrust")% %TINKO()% %FVERB("ing")% 한다.
	ELSE
		LOCALS = %SPLIT_G(@"Nghh_Ack_Aghaah_Nghoo_Guhh_Mnghh_Nghaa_Ough_Gahh_Haah_Uhhh_Urk_Ulp_...?!_...?!_%RANDKISS("suck")%_%RANDKISS("suck")%_%RANDKISS("suck")%", "_")%
		PRINTFORMW 「%RANDLIPS(, "suck:name:charname_" + LOCALS)%...%SPLIT_G("?!:!:!!!")%」
	ENDIF
ENDIF
RETURN 1
