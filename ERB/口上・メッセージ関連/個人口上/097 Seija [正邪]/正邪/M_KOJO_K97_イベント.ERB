@M_KOJO_EVENT_K97_16(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;添い寝を始めた（開始時）(存在せず
	;記入チェック
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 1
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;添い寝を終了した（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:TARGET:衰弱
			PRINTFORMDW 세이가 완전히 지친 모습으로 깊이 잠들어 있다.
			PRINTFORMW 「크으... 쿨쿨...」
			PRINTFORMDW 이대로 그녀를 내버려 두는 것이 더 좋을 것이다.
		ELSEIF CFLAG:318 == 1 || MARK:反発刻印 == 3
			PRINTFORMW 「...좋은 아침이야.」
			PRINTFORMDW 세이가 입술을 삐죽 내밀며 시무룩하게 당신에게 인사한다.
		ELSEIF CFLAG:1304 == 1 && TALENT:恋人
			PRINTFORMW 「헤이, 좋은 아침. 깨어 있어?」
			PRINTFORMW 「어서 와, %CALLNAME:MASTER%, %SPLIT_G("get ready and be quick about it:be short with your preparations")%.」
			PRINTFORMDW 세이가 말하며 당신으로부터 몸을 돌린다.
		ELSEIF CFLAG:1306 == 1 && TALENT:恋人
			PRINTFORMW 「...%CALLNAME:MASTER%.」
			PRINTFORMW 「이제 일어날 것 같아.」
			PRINTFORMDW 세이가 약간 실망한 듯이 황급히 일어났다.
		ELSEIF TALENT:恋人
			PRINTFORMW 「음... 지금쯤 일어나야겠어...」
			PRINTFORMDW 세이가 잠에서 깨어나 서둘러 몸을 단장했다.
			PRINTFORMW 「?」
			PRINTFORMW 「그래, 뭐, 나 오래 도망 다녀서 그런 거고 말이야.」
			PRINTFORMW 「내가 잠에서 깨는 순간 준비해야만 하는 지경이 됐지.」
			PRINTFORMDW 세이가 초식동물 같은 생활방식이 꽤 흥미로워 보인다.
			PRINTFORMW 「뭐, 걱정할 필요 없어. 어차피 해도 아무런 변화도 없을 테니까.」
			PRINTFORMDW 그녀가 아예 자는 건지, 아니면 그 압박감 때문에 더 대담해진 건지 궁금해지기 시작했다.
		ELSEIF CFLAG:1307 == 1 && TALENT:恋慕
			PRINTFORMW 「안녕, 이 자식아.」
			PRINTFORMW 「이봐, 일어나! 네 바보 같은 짓 때문에 내가 문제 생길까 봐 싫으니까.」
			PRINTFORMDW 너보다 먼저 잠에서 깬 세이가 욕을 퍼부으며 옷을 입는다.
		ELSEIF CFLAG:1302 == 1 && TALENT:恋慕
			PRINTFORMW 「이봐, %K97_PERV()% 일어나!」
			PRINTFORMW 「문제가 생기기 전에 빨리 도망치는 게 좋을 거야.」
			PRINTFORMDW 세이가 준비하며 옷을 입으면서 말했다.
		ELSEIF CFLAG:1302 == 1 && TALENT:思慕
			PRINTFORMW 「야, 너 정말 멋지다, %K97_PERV()%이냐?」
			PRINTFORMW 「네 몸을 준비해라.」
			PRINTFORMDW 세이가 재빨리 자신도 준비하며 말한다.
		ELSEIF CFLAG:1302 == 1
			PRINTFORMW 「좋은 아침이군, 이 개같은 변태 자식아.」
			PRINTFORMW 「...너 벌써 일어난 거야?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「좋은 아침이야, 나의 소중한 darling%UNICODE(0x2764)%」
			PRINTFORMDW 세이가 장난기 가득한 미소를 지으며 너를 깨운다.
			PRINTFORMW 「하하하, 그냥 놀리는 거야, 보스. 나한테 화내지 마.」
			PRINTFORMDW 약간 부끄러워진 세이는 바보 같은 농담에 대해 사과했다.
		ELSE
			;added
			PRINTFORMW 「...뭐야, 도대체 여기서 뭐 하는 거야?」
			PRINTFORMW 「어떻게 이런 일이 벌어진 거지? 믿을 수가 없어...」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORMDW 
ENDIF
RETURN 1
;==================================================
;時止め終了時
;==================================================

@M_KOJO_EVENT_K97_17(ARG,ARG:1)
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;added, diary entry
	IF ARG == 3
		CALL M_KOJO_DIARYSETTING_K97(8)
	ELSEIF ARG
		CALL M_KOJO_DIARYSETTING_K97(9)
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ARG=1～3は排他
	;謎の快感
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL
		IF CFLAG:1304 == 1 && TALENT:恋人
			PRINTFORMW 「%SPLIT_G("잠깐만.")%...」
			PRINTFORMW 「%CALLNAME:MASTER%, %SPLIT_G("다시 그거 하고 있는 거야: 농담이지: 또 무슨 짓 꾸미고 있어: 이번엔 뭘 한 거야")%...?!」
			PRINTFORMDW 세이가 목소리에 약간의 분노를 담아 당신에게 질문을 외친다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...?!?!?!?!」
			PRINTFORMDW 시야가 정지된 시간에서 풀려난 순간, 그녀의 몸은 갑자기 통제할 수 없이 떨렸다.
			PRINTFORMW 「%SPLIT_G("뭐야, 이게. 세상에... 젠장. 뭐... 이거... 씨발.")%...?!」
			PRINTFORMW 「응... 잠시만... 많은 일들이 일어났으니 잠깐 시간을 줘...」
			PRINTFORMW (방금 뭐였지...)
		ELSE
			PRINTFORMW 「?!」
			PRINTFORMDW 세이가 땀으로 흠뻑 젖어 몸을 떨고 있다.
			PRINTFORMW 「아무것도 아니야... 나 걱정 마... 응...」
			; [AUTO-NEUTRALIZED] PRINTFORMW 「이리 와, %SPLIT_G("which part of \"it's nothing\" did you not get?!:I already told you, it's nothing...!")%」
			PRINTFORMDW 플레이어가 세이에게 방금 무슨 일이 있었는지 묻고자 하자, 그녀는 모든 것이 괜찮다는 것을 필사적으로 보이려 한다.
			PRINTFORMDW ...어쩌면 그녀는 자신의 약점을 보이고 싶지 않은 것일지도 모른다. 그녀처럼 호탕한 타입은 언제나 볼거리다 정말로.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDL
		IF CFLAG:1304 == 1 && TALENT:恋人
			PRINTFORMW 「～～～?!?!」
			PRINTFORMW 「...%CALLNAME:MASTER%, %SPLIT_G("들어봐, 너, 이 작은 것아, 아 진짜 너 농담하는 거겠지?")%...?!」
			PRINTFORMDW 시야가 약간 놀란 듯 목소리를 높여 질문한다.
