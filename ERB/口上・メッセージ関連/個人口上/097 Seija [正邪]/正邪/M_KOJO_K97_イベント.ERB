	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:1304 == 1 && TALENT:恋人
			PRINTFORMW 「그게 전부인가 보네.」
			PRINTFORMW 「%CALLNAME:MASTER%, 다음에 또 하자.」
