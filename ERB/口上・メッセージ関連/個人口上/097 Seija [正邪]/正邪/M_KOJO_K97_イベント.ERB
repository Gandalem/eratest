@M_KOJO_EVENT_K97_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		IF ARG > 7
			;don't spam too often
			IF TALENT:恋慕 && RAND:3
				RETURN 0
			ELSEIF CFLAG:1302 == 1 && RAND:4
				RETURN 0
			ELSEIF TALENT:思慕 && RAND:4
				RETURN 0
			ELSE
				RETURN 0
			ENDIF
			PRINTFORML
			CALL PRINT_FACE, 97, "通常", "服", "", ""
			IF CFLAG:1304 == 1 && TALENT:恋人
				PRINTFORMW 「Hm.」
				PRINTFORMW 「왠지 우리 친구 %조사처리(CALLNAME:MASTER,"가")% 사라졌어. %HE_SHE(MASTER)% 괜찮아?」
				PRINTFORMW 「가서 확인해 봐야겠어. 그리고, 응... %HIM_HER(MASTER,,1)%도 보고 싶어.」
				CFLAG:97:翌日来訪 = 1
			ELSEIF CFLAG:1306 == 1 && TALENT:恋人
				PRINTFORMW 「크르릉, %CALLNAME:MASTER%...」
				PRINTFORMW 「연인들은 가끔 서로에게 휴식이 필요하다는 건 알아, 하지만 제발...」
				PRINTFORMW 「적어도 안부라도 들러주면 좋겠어... 더 이상 혼자 있고 싶지 않아...」
				PRINTFORMW 「됐어, 내일 무슨 일이 있어도 %HIM_HER(MASTER,,1)% 만나러 갈 거야!」
				CFLAG:97:翌日来訪 = 1
			ELSEIF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%...」
				PRINTFORMW 「왠지 우리 사이가 멀어지는 것 같아.」
				PRINTFORMW 「그럴 순 없지. 난 결국 %HIS_HER(MASTER)% 여자니까.」
				PRINTFORMW 「내일 %HIM_HER(MASTER,,1)%에게 깜짝 방문을 할 거야...」
				CFLAG:97:翌日来訪 = 1
			ELSEIF CFLAG:1307 == 1 && TALENT:恋慕
				PRINTFORMW 「흥... %CALLNAME:MASTER%...」
				PRINTFORMW 「또 내 감정 가지고 장난치네... 뭐, 너도 지옥에나 가라!」
			ELSEIF CFLAG:1302 == 1 && TALENT:恋慕
				PRINTFORMW 「또 다른 시간, 내가 %조사처리(CALLNAME:MASTER,"를")% 전혀 보지 못한 또 다른 날이군. 대단해.」
				PRINTFORMW 「뭐, 그럴 만도 하겠지, 하지만... 좀 외롭네. 이런.」
			ELSEIF CFLAG:1302 == 1 && TALENT:思慕
				PRINTFORMW 「%K97_PANTY()%는 내 인생에서 빠질 리 없어. 절대 안 돼.」
			ELSEIF CFLAG:1302 == 1
				PRINTFORMW 「...이상하네, %조사처리(CALLNAME:MASTER,"를")% 한동안 못 봤는데.」
				PRINTFORMW 「나 %HE_SHE(MASTER)%가 박살 나고 %HIS_HER(MASTER)%가 두들겨 맞았으면 좋겠다. 그거 정말 멋질 텐데.」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%... 이봐, 나한테 이렇게 무시해도 된다고 생각한다면 정말 최악의 연인이군.」
				PRINTFORMW 「뭐 어때, 난 혼자 있는 것에 익숙하거든.」
			ELSEIF TALENT:思慕
				PRINTFORMW 「저 인간 말이야, %CALLNAME:MASTER%... 어떻게 지내는지 궁금하네?」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		RETURN 1
	ENDIF
ENDIF
RETURN 1
