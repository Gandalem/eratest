	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;霊夢が入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;added
		PRINTFORMW 「아, 우리 경계심 많은 신사 마이가 아니신가.」
		PRINTFORMW 「아니요, 저는 잘 지내고 있어요. 아직은 저를 몰살할 필요 없어요...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;る～ことが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW
		RETURN 1
	ENDIF
	;added
	LOCAL:1 = 1
	IF LOCAL:1 && GROUPMATCH(ARG, 3, 26, 32, 68, 69, 72)
		PRINTFORMW 「젠장, 마녀들이 도착했어... 아, 듣지 않았으면 좋겠는데.」
		PRINTFORMDW 세이가 일부러 코를 막은 뒤 몸을 돌렸다.
		IF ARG == 26 && ONCE("YukariBeh")
			RESETCOLOR
			CALL SET_KOJO_COLOR(26)
			PRINTFORMDW 유카리가 깊은 생각에 잠긴 듯하다...
			PRINTFORMW (내 상상이었을까, 아니면 누군가 나를 '할멈'이라고 불렀던 걸까...?)
			PRINTFORMW (아, 그 작은 아마노자쿠... 그녀를 없애는 건 문제없겠지만...)
			IF TALENT:恋人
				PRINTFORMW (그런 그녀 같은 사람이 %PRINT_MALE("man_:lover", MASTER)%을 가졌다니... \@ !TALENT:26:恋人 ? 나는 아직 싱글이라고! # 사실 내 %PRINT_MALE("man_:lover", MASTER)%이잖아! \@)
				PRINTFORMW (어찌 이리 터무니없는 일인가... 저렇게 행복하고 온화한 척하는 걸 보니... 절대 용납 못 하겠어!)
			ENDIF
			RESETCOLOR
		ENDIF
		RETURN 1
	ENDIF
	IF LOCAL:1 && ARG == 41
		PRINTFORMW 「야, 누에, 안녕? 잘 지내?」
		PRINTFORMDW 두 사람은 인사를 나누고 웃음이 섞인 대화를 잠시 나눈 뒤 세이가 돌아온다.
		RETURN 1
	ENDIF
	IF LOCAL:1 && ARG == 71
		PRINTFORMW 「오, 안녕하세요, 공주님...」
		PRINTFORMDW 두 사람은 잠시 동안 말없이 서로를 응시했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		PRINTFORMW 「음... %SPLIT_G("Someone's comin':It's getting crowded:Well, speak of the devil and she doth appear")%...」
		PRINTFORMDW 약간 실망한 듯, 세이가 물어보기 전에 당신을 놓아준다.
		PRINTFORMW 「So %SPLIT_G("계획이 뭐야: 우리 뭐 해: 이제 어떡하지")%?」
	ENDIF
	RETURN 1
	;その他
	PRINTFORMDW 
ENDIF
RETURN 1
