@M_KOJO_CHECK_K97_DAYEVENT_COND(ARGS, ARG, ARG:1)
SELECTCASE ARG
	CASE DAYEVENT_GENERAL ;initial, if the function is allowed to run at all, 0 is disallowed, 1 is allowed
		SIF MARK:反発刻印 || CFLAG:ブチギレ
			RETURN -1
		RETURN 1
		;per event
		;RETURN -1 - means disallowed, 0 - fall back to original condition, 1 - allowed
	CASE DAYEVENT_ORAL
		SIF !TALENT:恋人
			RETURN -1
		SIF !HAS_PENIS(MASTER) ;bj only
			RETURN -1
		RETURN 0 ;og cond
	CASE DAYEVENT_COWGIRL, NIGHTEVENT_YOBAI
		SIF !TALENT:恋人
			RETURN -1
		SIF !HAS_PENIS(MASTER) ;penis only
			RETURN -1
		SIF !(ABL:欲望 >= 5)
			RETURN -1
		SIF !(!TALENT:処女 && !IS_DOUTEI(MASTER)) ;must be experienced
			RETURN -1
		RETURN 1
	CASE NIGHTEVENT_KISS, NIGHTEVENT_DRINK ;allow before lover
		SIF CFLAG:2 < 1500
			RETURN -1
		RETURN 0
	CASE NIGHTEVENT_MOONVIEWING ;disabled, no dialogue
		RETURN -1
	CASEELSE
		SIF !TALENT:恋人
			RETURN -1
		RETURN 0
ENDSELECT
RETURN 0
