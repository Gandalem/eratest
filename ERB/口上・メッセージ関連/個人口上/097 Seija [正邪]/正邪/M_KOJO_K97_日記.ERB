@M_KOJO_K97_適当日付設定(ARG)
;日記用に作った適当に日付を付ける関数
;=============================
SELECTCASE ARG % 12
	CASE 1, 2, 3
		PRINT 월 ○
	CASE 4, 5, 6
		PRINT 달 □
	CASE 7, 8, 9
		PRINT 월 △
	CASEELSE
		PRINT 월 ☆
ENDSELECT
PRINT , 
SELECTCASE ARG % 10
	CASE 1
		PRINT 날짜 ×
	CASE 2
		PRINT 날짜 ■
	CASE 3
		PRINT 날짜 ●
	CASE 4
		PRINT 날짜 ▲
	CASE 5
		PRINT 낮 ★
	CASE 6
		PRINT 날
	CASE 7
		PRINT 날짜☆
	CASE 8
		PRINT 날짜 □
	CASE 9
		PRINT 날짜 △
	CASE 0
		PRINT 날짜 ○
ENDSELECT
