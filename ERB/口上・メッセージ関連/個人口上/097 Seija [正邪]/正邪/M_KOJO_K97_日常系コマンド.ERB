;621,釣りをする
;added, based on hatate
;TFLAG:193(0=釣れない 1～4=魚 11～15=うまい魚 610=木材 131=守矢の守札 21=ローター 609=氷の鱗 606=龍の爪)
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================

@M_KOJO_MESSAGE_COM_K97_621
CALL M_KOJO_MESSAGE_COM_K97_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;釣った
	IF TFLAG:194 >= 1000
		PRINTDATAW
			DATAFORM 「와, 잠깐만! 뭐라도 잡을 것 같아!」
			DATAFORM 「됐다, 왔다! 한번 보자!」
			DATAFORM 「미끼를 물었어! 이제 내가 할 일은 감기뿐이야...」
			DATAFORM 「좋아, 해냈어! 오라, 뭔가 좋은 거 내놔봐!」
		ENDDATA
		SELECTCASE TFLAG:193
			CASE 1 TO 4
				PRINTFORML 「헤에, 펄쩍 뛰는 걸 봐라. 미안하지만 친구, 이제 네 차례가 내 먹이가 될 거다.」
			CASE 11 TO 15
				PRINTFORML 「오, 굉장해, 이거 뭔가 큰 게 확실히 잡힌 것 같아.」
				PRINTFORML 「낚시 정말 재밌다!」
			CASE 610
				PRINTFORML 「잠깐, 이건 그냥 나무판이잖아.」
				PRINTFORML 「하아, 아무것도 아닌 걸 기대하게 만들다니...」
			CASE 131
				PRINTFORML 「크윽, 누가 물에 이 쓰레기들을 계속 버리는 거야?!」
			CASE 21
				PRINTFORML 「잠깐... 내가 생각하는 게 그거인가...?」
				PRINTFORML 「누가 쓰던 걸 버렸나? 역겹다, 정말...」
			CASE 609
				PRINTFORML 「어라, 이건 물고기가 아니군. 이상하네, 평범한 얼음 같지도 않아.」
			CASE 606
				PRINTFORML 「흥, 무슨 발톱인가?」
				PRINTFORML 「꽤 흥미롭군. 그걸 얼마에 팔 수 있을지 궁금하네.」
		ENDSELECT
		;あなたが釣った
	ELSE
		SELECTCASE TFLAG:193
			CASE 0
				PRINTDATAW
					DATAFORM 「실패는 학습 과정의 일부일 뿐이니까, 그렇지 않아?」
					DATAFORM 「...오늘은 안 되는 날지도 모르지, 누가 알겠어.」
					DATAFORM 「그런데 분명 주변에 물고기들을 본 것 같은데 말이야.」
					DATAFORM 「아, 아쉽네. 다음 기회에 다시 해 봐야겠다.」
				ENDDATA
				;ウグイ
			CASE 1, 5, 6
				PRINTFORML 「잡기 쉬운 물고기다. 나조차 가끔 그것들을 잡는다.」
				;アマゴ
			CASE 2
				PRINTFORML 「흥, 이건 그냥 같은 마스 연어인데, 홍점이라고도 불리네.」
				PRINTFORML 「원래 것도 이미 홍점이 있는데, 이건 전혀 빨간 점이 없잖아! 참 이상해.」
				PRINTFORML 「그냥 아마고라고 부르자. 어쨌든 우리 땅에 서식하는 토종 생선이니까.」
				;ヤマメ
			CASE 3
				PRINTFORML 「좋은 주력 생선이군. 그런데 원래 이름은 야마메인데, 지옥에서 온 그 이상한 거미 요괴랑 같아.」
				PRINTFORML 「하지만 대신 이건 인간들에게 먹히게 되는 거지. 참 아이러니하군.」
				;イワナ
			CASE 4
				PRINTFORML 「얼마나 긴지 봐. 한 번에 다 삼킬 수 있을지 궁금하네.」
				PRINTFORML 「나중에 구워서 먹어보자!」
				;フナ
			CASE 7
				PRINTFORML 「좋아, 이거 마음에 들어. 술이랑 같이 먹으니까 맛이 아주 좋네.」
				PRINTFORML 「얘들은 배도 많이 가지고 있더라고. 살짝만 구우면 사실 되게 맛있어!」
				;ピラニア
			CASE 8
