;TFLAG:194(行動結果(-2=ひやかし -1=ウィンドウショッピング 1=400点未満（BAD） 2=～699点（NOMAL） 3=700点以上（GOOD）
;CFLAG:性格傾向による地の文分岐あり
;==================================================
;映姫様口上作者様から拝借しました。いつもすみません
;==================================================

@M_KOJO_MESSAGE_COM_K97_626
CALL M_KOJO_MESSAGE_COM_K97_626_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K97_626_1
#DIMS strGift
#DIMS strReaction
#DIM nPrice
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;贈っていたら本体名と属性を取得しておく
	IF TFLAG:194 > 0
		CALL GIFTDATA_MAIN(GET_GIFTDATA(TCVAR:97:今日の贈り物, "本体"))
		strGift = %RESULTS%
		nPrice = RESULT:1
		IF STRFIND(RESULTS:1, "抱く") >= 0
			strReaction = 抱く
		ELSEIF STRFIND(RESULTS:1, "眺める") >= 0
			strReaction = 眺める
		ELSEIF STRFIND(RESULTS:1, "握る") >= 0
			SIF STRFIND(RESULTS:1, "装飾") >= 0
				strReaction = 身につける
			strReaction = 握る
		ELSE
			strReaction = 身につける
		ENDIF
	ENDIF
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	SELECTCASE TFLAG:194
		;ひやかし
		CASE -2
			IF !RAND:4 && (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;kourindou check
				PRINTFORML 「좋은 선물 고르는 데 시간이 걸린다는 거, 네가 실제로 사귀고 있었다면 알았을 텐데, 이 빌어먹을 안경 쓴 처녀야!」
				PRINTFORML 「...이런, 그 사람이 검을 잡으려고 해, 도망쳐 %K97_DUDE()%, 붑ーーー!!」
				PRINTFORMDW 그냥 자기 일을 하려던 사람에게 모욕을 준 건 아마 좋은 생각이 아니었을 것이다...
			ELSEIF RAND:3 == 0
				PRINTFORMW 「하하! 저들이 잔뜩 짜증내는 거 봐, 웃기다!」
			ELSEIF RAND:2 == 0
				PRINTFORML 「흥, 저기 \@ (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ? 얼굴을 만드는 네 눈알 아저씨 봤어? 완전 패배자네. # 점원? 완전히 화가 나 있었어.\@」
				PRINTFORMW 「뭐, 어쩔 수 없지.」
			ELSE
				PRINTDATAW
					DATAFORM 「자, 이제 가자! 너무 오래 머물지 말자.」
					DATAFORM 「이제 가 볼까?」
					DATAFORM 「우리 이제 떠나야 할 것 같아.」
					DATAFORM 「음, 원하는 걸 못 찾았다면, 그럼 가자.」
					DATAFORM 「뭐 됐어. 여기에서 시간 낭비하지 말자.」
				ENDDATA
			ENDIF
			;やっぱりやめる（見送り）
		CASE -1
			IF TALENT:恋慕 || TALENT:恋人
				IF RAND:2
					PRINTFORML 「뭐야, 나한테 줄 거라도 사려고 했어?」
					PRINTFORML 「Well, I've got some specific tastes. Finding what I like would be difficult.」
				ELSE
					PRINTFORML 「그게 제일 좋아. 어차피 쓸모없는 장신구 같은 거 갖고 싶지도 않아.」
					PRINTFORML 「나한테 무언가를 사려고 애쓸 필요 없어, 알잖아.」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「아무것도 안 살 거야? 정말 한심하네.」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「벌써 떠나다니? 정말 시시하군.」
				ELSE
					PRINTFORMW 「하지만 놀라울 정도로 좋은 선택지가 있었다.」
				ENDIF
			ENDIF
			;400点未満（BAD）
		CASE 1
			IF nPrice >= 30000
				PRINTFORML 「어라, 이거 나한테 주는 거야?」
				PRINTFORML 「...말하기 싫지만, 아마 버릴 것 같아.」
				PRINTFORML 「아니면 그냥 전당포에 맡길지도. 뭐, 그래도 고마워.」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「취향이 좋네, %K97_DUDE()%님.」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「감사히 받겠어요.」
			ELSE
				PRINTFORMW 「꽤 괜찮은 선물이네요. 꼭 사겠습니다.」
			ENDIF
			PRINTFORMDW 세이가 딱히 만족해하는 것 같지는 않지만...
			;400点～699点（NOMAL）
		CASE 2
			IF nPrice >= 30000
				IF TALENT:恋慕 || TALENT:恋人
					PRINTFORML 「와, 나한테 이걸 주는 거야?」
					PRINTFORML 「...고마워, 소중히 간직할게.」
					PRINTFORML 「네가 내가 정말 좋아하는 걸 골랐구나, 잘했어. 너라면 할 수 있을 거라고 믿었거든.」
				ELSE
					PRINTFORML 「뭐야, 이거 나한테 주는 거야? 정말로?」
					PRINTFORML 「음... 응, 그냥... 가질게.」
					PRINTFORML 「하지만 있잖아, 이런 물건에 그렇게 돈을 많이 쓰는 건 좀 그래.」
					PRINTFORML 「그거 아무도 감동 안 받는데.」
				ENDIF
			ELSEIF RAND:3 == 0
				PRINTFORMW 「뭐, 왜 안 되는데? 내가 가져갈게.」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아하, 그러니까 당신의 물건 중 하나군요...」
			ELSE
				PRINTFORMW 「그걸 그냥 지나칠 이유를 모르겠군, 하지만 다음엔 더 좋은 걸 내놔.」
			ENDIF
			PRINTFORMDW 세이가 다소 당황한 듯 미소를 짓는다.
			;700点以上（GOOD）
		CASE 3
			;形容詞+本体名を取得
			IF nPrice >= 30000
				CALL GIFTNAME(TCVAR:97:今日の贈り物)
				PRINTFORML 「저기, 저게 %RESULTS%...? 나한테 주는 거야? 정말이야?」
				PRINTFORML 「고마워요, %CALLNAME:MASTER%. 진심이에요.」
				PRINTFORML
				SELECTCASE strReaction
					CASE "眺める"
						PRINTFORML 「영원히 감상할 만한 것 같아.」
						PRINTFORML 「분명 소중히 간직할 거야.」
					CASE "抱く"
						PRINTFORML 「와, 나 이 물건한테 반한 것 같아.」
						PRINTFORML 「내 인생에 이런 게 필요할 줄은 몰랐어.」
					CASE "握る"
						PRINTFORML 「아아, 손에 들고 있으니 더 보기 좋네.」
						PRINTFORML 「사실 이거 한때 정말 갖고 싶었거든. 응, 정말 조심해서 다닐게.」
					CASE "身につける"
						PRINTFORML 「음, 이거 몸에 걸어야 하는 거야? 좋아... 돌아서자.」
						PRINTFORML 「자, 어때 보여? 괜찮아? ...흥, 그럴 줄 알았어.」
						PRINTFORML 「굉장한 물건이네, 이제 어디를 가든 자랑할게.」
				ENDSELECT
				PRINTFORML
				PRINTFORML 「…잠깐, 이거 엄청 비쌌을 텐데.」
				PRINTFORML 「이런 걸 나한테 주셔도 괜찮으시겠어요? 제가 받을 만한 게 아닌데…」
				PRINTFORML 「선물이라고 해서 무조건 값비싼 것만이 좋은 건 아니니까.」
				IF TALENT:恋人
					PRINTFORML 「별거 아닌 걸 알지만... 쪽!%UNICODE(0x2665) *1%」
					PRINTFORML 「나에게 주는 작은 감사 표시야. 볼에 하는 건 좀 그렇겠지만, 나중에 더 해줄게...」
				ENDIF
			ELSEIF RAND:3 == 0
				PRINTFORMW 「오호! ...지금 전혀 기분이 좋지 않아!」
				PRINTFORMDW 세이가 행복해 보이고 볼이 상기되어 있었다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「나를 그렇게 잘 이해하다니 믿을 수가 없어! 이 선물을 겸허히 받으마.」
				PRINTFORMDW 세이가 행복해 보이며 볼이 상기되었다.
			ELSE
				PRINTFORMW 「...야, 나 지금... 완전 신나. 정말 고마워.」
				PRINTFORMDW 세이가 볼이 발그레해지며 네 선물을 품에 안고 매우 기뻐한다.
			ENDIF
	ENDSELECT
	PRINTFORML
ENDIF
RETURN 1
