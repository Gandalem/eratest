; Modular ERB: 個人口上/076 Komachi [小町]/小町/M_KOJO_K76_依頼.ERB

@M_KOJO_IRAI_K76(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K76(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K76(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
SELECTCASE ROLE
	CASE "CLIENT"
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				CASE "一般依頼名"
					SELECTCASE SCENE
						CASE "依頼提示時"
							;依頼を持ちかけられる時
						CASE "依頼非受託時"
							;内容だけ見て受託しなかった時
						CASE "依頼受託時"
							;依頼を受託した時
						CASE "依頼確認時"
							;[366]で依頼内容を依頼人に確認した時
						CASE "依頼破棄時"
							;受託した依頼を破棄する時
						CASE "依頼実行直前"
							;[367]で依頼を実行する時、実行処理の前に呼び出される
						CASE "依頼実行直後"
							;[367]で依頼を実行する時、実行処理の後に呼び出される
						CASE "成功報告時"
							;報告時（成功）
						CASE "失敗報告時"
							;報告時（失敗）
							;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		;固有依頼
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			;個々の依頼名で分岐
			;SCENEのWAITに関する仕様
			;WAIT無しでよい　　　　："依頼提示時", "依頼非受託時", "依頼確認時", "依頼破棄時", "成功報告時", "失敗報告時"
			;
			;以下の2つは実際にはCARRYOUTでの地の文処理との比較検討が必要
			;WAITを入れたほうが適切："依頼実行直前", "依頼実行直後"
			CASE "固有依頼名"
				SELECTCASE SCENE
					CASE "依頼提示時"
						;依頼を持ちかけられる時
					CASE "依頼非受託時"
						;内容だけ見て受託しなかった時
					CASE "依頼受託時"
						;依頼を受託した時
					CASE "依頼確認時"
						;[366]で依頼内容を依頼人に確認した時
					CASE "依頼破棄時"
						;受託した依頼を破棄する時
					CASE "依頼実行直前"
						;[367]で依頼を実行する時、実行処理の前に呼び出される
					CASE "依頼実行直後"
						;[367]で依頼を実行する時、実行処理の後に呼び出される
					CASE "成功報告時"
						;報告時（成功）
					CASE "失敗報告時"
						;報告時（失敗）
						;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
				ENDSELECT
		ENDSELECT
	CASE "TARGET"
		;ここで表示されるSCENEは"依頼実行直前", "依頼実行直後"だけです
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
					;人物が鍵になっていた・もしくは場所にたまたま居合わせた
					SELECTCASE SCENE
						;TARGETが呼ばれるのはこのタイミングだけ
						CASE "依頼実行直前"
						CASE "依頼実行直後"
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE CSVCALLNAME(CLIENT_ID)
			;依頼者のCALLNAMEによる分岐（CSV準拠）
			CASE "依頼者"
				SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
					CASE "固有依頼名"
						SELECTCASE SCENE
							CASE "依頼実行直前"
							CASE "依頼実行直後"
						ENDSELECT
				ENDSELECT
		ENDSELECT
	CASE "NO_REPORT"
		;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
		;ここで表示されるSCENEは"依頼報告不要"だけです
		;SCENEが一つしか無いので分岐は不要
		;また、必ず依頼主の口上が呼ばれます
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
				;個々の依頼名で分岐してください
				CASE "一般依頼名"
				CASE "お花に水をあげて"
				CASE "誰かの落とし物"
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
			CASE "固有依頼名"
		ENDSELECT
ENDSELECT
;custom code, copied from Eiki's dialogue and moved to Komachi's dialogue to make it functional
;==================================================
;依頼口上・固有依頼101：
;固有依頼の仕様はキャラによって異なりますが依頼番号は101～で共通です
;"依頼名"部分に依頼名を入れて下さい
;==================================================

@M_KOJO_IRAI_お説教たいむ_K76(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;サボりが一瞬でバレるくらいだし、場所だって丸わかりでいいんじゃないかと
SELECTCASE SCENE
	CASE "依頼提示時"
		RETURN 0
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;These are lines from Komachi, so if she ever gets translated, make sure the style is consistent
		;書いたはいいけどここには飛ばない
		IF TALENT:[[小町]]:恋人
			PRINTFORML 「...%CALLNAME:MASTER%, 당신의 귀엽고 아름다운 여자친구에게 도움을 주는 게 더 기쁠 거라고 확신해, 안 그래?」
		ELSEIF TALENT:[[小町]]:恋慕
			PRINTFORML 「...있잖아, 우리 아름답고 친밀한 우정인 거 알지?」
		ELSE
			PRINTFORML 「...%CALLNAME:MASTER%, %TEXTR("I'd like to ask a favor from you/I've got a real serious request for you/")%.」
		ENDIF
		PRINTDATAL
			DATAFORM 「이 편지가 존재하지 않았던 것처럼 그냥 모르는 척할 수 있을까...」
			DATAFORM 「내 대신 혼나러 가줄래...」
		ENDDATA
		RESETCOLOR
		RETURN 1
	CASE "依頼実行直後"
		;ここにも飛ばない
		PRINTDATAL
			DATAFORM 「시키님께 죽을 만큼 무서워하는 건가? 봤어, 충분히 그럴 거라고 생각했지...」
			DATAFORM 「그렇게 못 하는 거야? 처음부터 당연한 거였나 보네...」
			DATAFORM 「가끔은 나 자신을 되돌아봐야 하나? 에이, 그렇게 차갑게 굴지 마...」
			DATALIST
				DATAFORM 「하아... 시키님에게 또 설교를 들었네...」
				DATAFORM 「...어쩌면 내가 게을렀던 걸 전부 당신에게 돌릴 수도 있을 텐데...」
				DATAFORM 「...안 되겠지, 결국?」
			ENDLIST
		ENDDATA
		RESETCOLOR
		RETURN 1
	CASE "成功報告時"
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
