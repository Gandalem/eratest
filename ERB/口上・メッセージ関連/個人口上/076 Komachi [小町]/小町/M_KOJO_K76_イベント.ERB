@M_KOJO_EVENT_K76_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕 || TALENT:恋人
					IF RAND:2 == 0
						PRINTFORML 「아흐음... 그렇게 빤히 보지 마~」
						CALL HPH_PRINT,@"「나조차도 %PRINT_MALE("guy", MASTER)%이 앞에서 알몸으로 있는 게 부끄럽다...HPH」","L"
						CALL HPH_PRINT,@"「하지만 나를 이런 기분으로 만들 수 있는 건 너밖에 없어, 있잖아... HPH」","L"
						CALL HPH_PRINT,@"「나 당신에게 옷을 벗는 것에 대한 책임을 지게 하고, 나를 온통 뜨겁고 들뜨게 만든 것에 대해 만회하게 해야 할 것 같아...HPH」","L"
					ELSE
						PRINTFORML 「내 벌거벗은 몸이... 아름답다고 생각해?」
						PRINTFORML 「후후~ 내 인생에서 누군가 나한테 그런 말을 해주는 건 처음이야!」
						CALL HPH_PRINT,@"「내 얼굴에 어리석은 미소가 떠 있나? 뭐, 참을 수가 없어! 입술이 저절로 올라갈 정도로 너무 행복하거든 HPH」","L"
						CALL HPH_PRINT,@"「어디서나 나를 봐, 어디에서든 나에게 손대줘 HPH 지금 이 순간 내 온몸은 네 차지야...HPH」","L"
					ENDIF
				ELSE
					PRINTFORML 「내 몸에 대한 갈망이라도 있니, 아니면 뭐 그런 거?」
					PRINTFORML 「너무 쳐다보지 마~ 난 그래도 아가씨잖아!」
					PRINTFORML 「왜냐면 말이야, 누가 너무 자세히 보면 엄청 부끄러울 만한 곳들이 있으니까...♪」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕 || TALENT:恋人
					IF RAND:2 == 0
						CALL HPH_PRINT,@"「에헤헤~ 완전히 벌거벗는 것보다 더 흥분되네...HPH」","L"
						PRINTFORML 「하지만 물론, 나에게서 이것을 벗겨보는 것도 즐길 생각이지, 그렇지?」
						CALL HPH_PRINT,@"「아니면 내가 직접 해주고 쇼를 보여주길 원해...? HPH」","L"
					ELSE
						PRINTFORML 「내 속옷이 그렇게 귀엽다고 할 수 없잖아, 그치?」
						PRINTFORML 「네가 그걸 그렇게 좋아할 줄 알았다면, 상황에 더 어울리는 걸 입었을 텐데! 에헤헤～」
						CALL HPH_PRINT,@"「어떤 종류의 속옷이든 괜찮아, 내가 입고 있는 한? 훗, 그게 뭐야, 그거 내 칭찬으로 받아들여야 하는 거야?」","L"
					ENDIF
				ELSE
					PRINTFORML 「여자가 스키비 같은 걸 입고 있는 게 더 흥분돼?」
					PRINTFORML 「어쩌면 그럴지도 모르지... 무슨 이유에서인지 나 벌거벗었을 때보다 심장이 더 빨리 뛰네...」
				ENDIF
				PRINTW 
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕 || TALENT:恋人
					IF RAND:2 == 0
						PRINTFORML 「아흑... 내 가슴이 흘러내렸어...」
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%, 왜 전부 벗지 않겠어?」
						PRINTFORML 「Though I guess I've got no complaints if you prefer me this way, too.」
						CALL HPH_PRINT,@"「이런 상태가 좀 좋은 것 같아... 반쯤 옷을 벗고 안겨 있는 게.」","L"
					ENDIF
				ELSE
					PRINTFORML 「아, 여기저기 만지면서 내 옷이 다 엉망이 됐잖아.」
					PRINTFORML 「더 나를 망치려는 거 생각해? 그렇다면 조금은 괜찮을지도 모르는데...♪」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「물론 괜찮지만, 부탁 하나 해도 될까?」
							PRINTFORML 「응, 이 바보야. 네 속옷을 내 걸로, 동등한 교환이야～」
							PRINTFORML 「뭘 쓰려고 하는 거지? 음, 있잖아...」
							IF ABL:自慰中毒 > 2 && ABL:欲望 > 4
								CALL HPH_PRINT,@"「물론 나 혼자 위로할 때 쓸 거야...후헸」","L"
							ELSE
								PRINTFORML 「비밀이야♪ 걱정 마, 내가 나쁜 짓은 안 할 테니까♪」
							ENDIF
							PRINTW 
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							SELECTCASE RAND:3
								CASE 0
									PRINTFORML 「상관없을 것 같은데, 그거 가지고 뭘 할 건데?」
									PRINTFORML 「...! 아아 당신은 그걸 ~에 쓰는 것 같네요 "뭔가~"알겠다 알겠어♪」
								CASE 1
									PRINTFORML 「너희가 그걸로 뭘 할지는 모르겠지만, 마음껏 해봐도 괜찮을 것 같아.」
									PRINTFORML 「근데 그거 쓰인다는 게 좀 역겹지 않아? 그렇게 쓰는 걸 선호해?」
								CASEELSE
									CALL HPH_PRINT,@"「여기 내 방금 벗은, 아직 따뜻한 팬티들이다」","L"
									CALL HPH_PRINT,@"「마음대로 써도 돼, HPH 심지어 자위용이라 해도...♪」","L"
							ENDSELECT
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							SELECTCASE RAND:2
								CASE 0
									PRINTFORML 「음, 좋아, 그런데 그걸 가지고 뭘 할 건데?」
									PRINTFORML 「이건 재판매용이 아니거든, 알잖아. 역겹다고! 게다가 사용된 거라 더 말이야!」
									PRINTFORML 「사실 새것이라도 여전히 문제일 것 같아, 아무래도.」
									PRINTW 
								CASE 1
									PRINTFORML 「좋아, 이상한 용도로 쓰지는 말아 줘, 알겠지?」
									PRINTFORML 「그럼 그걸로 뭘 해야 하냐고? 음... 뭐랄까...」
									PRINTFORML 「스-스스로 생각해 봐! 나한테 묻지 마!」
									PRINTW 
							ENDSELECT
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「네에... 그건 모르겠어. 네가 그걸로 뭘 할지 누가 알겠어. 그래서 난 거절해야 해.」
							PRINTFORML 「사실, 네가 그것들을 원할 만한 건강한 이유를 하나도 생각할 수 없어.」
							PRINTFORML 「만약 건강하게 사용할 생각이 있었다면 어쩌면 그럴 수도 있겠지만...」
							PRINTW 
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
