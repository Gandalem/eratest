;402,就寝
;TFLAG:193(0=通常 1=子供と一緒に川の字で寝る)
;==================================================

@M_KOJO_MESSAGE_COM_K76_402
;就寝にTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K76_402_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K76_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		;通常
		CASE 0
			PRINTFORML 「나는 외로워서 밤마다 베개에 얼굴을 파묻고 울 타입은 아니지만 그래도...」
			PRINTFORML 「밤에 누군가 나를 따뜻하게 해주는 게 정말 행복해, 혼자 있는 것보다 훨씬 낫잖아!」
			CALL HPH_PRINT,@"「아무튼, 오늘 나랑 함께 있어줘서 고마워. 잘 자, %CALLNAME:MASTER%...」","L"
			;親子川の字
			;条件として小町が先に寝ていることはあり得ないのでこの書き方で大丈夫なはず
		CASE 1
			PRINTFORML 「오케이, 자자. 이불 위에서 뒹굴지 마ー」
			PRINTFORML 「내일 뭐 하고 싶어? 구슬치기? 해키색(Hacky sack)?」
			CALL HPH_PRINT,@"「아빠가 너를 아주 높이 들어 올릴 때 좋아해? 아, 정말 재미있지, 안 그래HPH」","L"
			PRINTW 
			PRINTFORML 「우리 세 명이 가족처럼 잠드는 거... 이렇게 단순한 일인데도 나를 정말 행복하게 만들어.」
			CALL HPH_PRINT,@"「오늘 수고 많았어. 안녕...HPH」","L"
			PRINTW 
	ENDSELECT
ENDIF
RETURN 1
