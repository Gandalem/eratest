;==================================================
;421,願掛けする
;条件が複雑なので、COMF421 願掛け.ERBおよび、EVENT_MESSAGE_COM400.ERBの願掛けするの項を参照のこと
;穣子口上様の願掛けを参考にさせていただきました
;==================================================

@M_KOJO_MESSAGE_COM_K76_421
CALL M_KOJO_MESSAGE_COM_K76_421_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K76_421_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:1100 == 1
		PRINTFORML 「무슨 일이야?」
		PRINTFORML 「Do you prefer the old me after all?」
		CALL ASK_M("그게 맞다 (자신의 자궁 수치와 전반적인 음란함을 초기화한다)", 1,"아니, 괜찮아.", 1,"이키님을 흥분시키고 싶다.", CFLAG:1101 == 0,"나는 에이키님의 성욕을 거절하고 싶다", CFLAG:1101 == 1)
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「나를 이런 식으로 좋아하지 않았던 거네, 그렇지?」
				CALL HPH_PRINT,@"「하지만 다시 나를 그렇게 원한다면, 그냥 물어보면 돼... HPH」","L"
				PRINTW 
				;スケベスイッチOFF
				CFLAG:1100 = 0
				SIF TEQUIP:子宮 == 1
					TEQUIP:子宮 = 0
				SIF TCVAR:発情 == 1
					TCVAR:発情 = 0
			CASE 1
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%… 그런 종류의 게 취향이군요, 안 그래요?」","L"
				PRINTW 
			CASE 2
				PRINTFORML 「그녀가 화나면 내 근처에도 오지 마...」
				CFLAG:1101 = 1
			CASE 3
				PRINTFORML 「좋아, 아마 그게 가장 안전한 전략일 거야...」
				CFLAG:1101 = 0
		ENDSELECT
	ELSE
		IF TALENT:恋慕 || TALENT:恋人 && CFLAG:76:1010 >= 50 && CFLAG:76:1020 >= 50 && CFLAG:生解禁 == 2 && EXP:Ｃ絶頂経験 >= 30 && EXP:Ｖ絶頂経験 >= 30 && EXP:Ａ絶頂経験 >= 30 && EXP:Ｂ絶頂経験 >= 30 && EXP:Ｍ絶頂経験 >= 30
			PRINTFORMDW 코마치가 무언가 말하려는 것 같다...
			PRINTFORMDL [0] 그녀에게 마음속에 있는 것을 말해달라고 물어보세요.
			PRINTFORMDL [1] 나중에 그 이야기를 꺼내라고 말하세요.
			$INPUT_LOOP_onegai
			INPUT
			IF RESULT == 0
				PRINTFORML 「음, %CALLNAME:MASTER%...」
				PRINTFORMDL 코마치에게는 드문 일인데, 그녀가 말을 제대로 꺼내는 데 어려움을 겪고 있었다.
				PRINTW 
				;Ed. note: added virgin Komachi check here
				IF CFLAG:76:1099 == 1
					PRINTFORML 「음, 처음에는 그런 장난스러운 것에 대한 경험이 없었지만, 어느 정도 관심은 있었지...」
				ELSE
					PRINTFORML 「음, 처음에는 약간의 장난스러운 경험만 있었지만 좀 더 해보고 싶긴 했어...」
				ENDIF
				PRINTFORML 「하지만 그때는 당신이 나에게 온갖 더러운 일들을 함께 하게 만든 사람이었어.」
				CALL HPH_PRINT,@"「너는 나를 모든 방식으로 절정에 이르게 했고, 심지어 밖에서도 해봤잖아...HPH」","L"
				PRINTFORML 「우리는 시키님의 방에서도 했었다...」
				PRINTW 
				PRINTFORML 「네가 나에게 이런 모든 것을 가르쳐줘서, 내가 변태가 된 것 같아...」
				PRINTFORML 「하지만 그게 네가 원하는 거라면, 더 음란한 여자가 되어도 상관없어...」
				PRINTFORML 「그래서, 뭘 원하는 거야?」
				PRINTW 
				CALL ASK_M("주저할 필요 없어.", 1,"예전 모습 그대로 있어라.", 1,"대신 에이키님의 흥분을 되돌려라!", CFLAG:1101 == 1)
				SELECTCASE RESULT
					CASE 0
						CALL HPH_PRINT,@"「...HPH」","L"
						CALL HPH_PRINT,@"「좋아, 너를 위해서라면 가장 음란한 여자가 되어 줄게... HPH」","L"
						PRINTW 
						IF !TALENT:恋人
							IF TALENT:30:恋人
								PRINTFORML 「시키님조차 하기 두려워하는 모든 것들을 내가 해드릴게요...♪」
							ELSEIF TALENT:MASTER:恋人
								PRINTFORML 「당신의 연인이 하지 못할 모든 것을 내가 할 거야...♪」
							ELSE
								PRINTFORML 「다른 여자들이 안 하는 온갖 것들을 해 줄게...♪」
							ENDIF
							CALL HPH_PRINT,@"「무엇이든 나에게 부탁해도 괜찮아...HPH」","L"
							CALL HPH_PRINT,@"「당신을 위해서라면 뭐든지 해 줄게요 HPH」","L"
							PRINTW 
						ELSE
							CALL HPH_PRINT,@"「부디 다른 여자에게는 절대 시키지 않을 모든 것들을 나한테 해달라고 말해줘... HPH」","L"
							CALL HPH_PRINT,@"「나는 당신의 여인이니까, 당신이 원하는 건 뭐든지 해줄게HPH」","L"
							PRINTW 
						ENDIF
						PRINTFORMDL 코마치는 사람들 앞에서 좀 더 대담해질 것이다.
						PRINTFORMDL 그녀를 원래대로 되돌리고 싶다면 이 기도를 다시 해달라.
						PRINTW 
						;スケベスイッチＯＮ
						;ed. note: I'm pretty sure the += here was a coding mistake, if this runs multiple times it could have resulted in CFLAG:1100 > 1 and all the checks are for CFLAG:1100 == 1
						CFLAG:1100 = 1 ;custom code
						PRINTFORML 「더 바라는 것 없어?」
						CALL ASK_YN("에이키님도 음란하게 만들 수 있을까요?","특별한 건 없다.")
						IF !RESULT
							PRINTFORML 「음... 그런 걸 물어보긴 했지만, 내가 할 수 있는 건 별로 없어...」
							PRINTFORML 「...법정에서 그녀 앞에서 키스를 해보면, 그녀가 어떻게 반응하는지 볼 수 있을지도 모르겠어♪」
							PRINTW 
							PRINTFORMDL 그 순간, 제단이 눈부시게 빛나며 신성한 목소리가 당신의 정신 속에서 울려 퍼진다...
							SETCOLOR C_AQUA
							PRINTFORML 「네... 욕심 많은 심판도 괜찮아요...」
							CALL SET_KOJO_COLOR(76)
							PRINTL 
							PRINTFORMDL 만약 에이키가 일하는 동안 성희롱 명령을 실행하면 이제 그녀가 반응한다.
							PRINTFORMDL 게다가 그녀의 성적 좌절감과 분노가 올라간다. 그리고 상황에 따라 에이키는...???
							PRINTW 
							;映姫様ムラムラスイッチＯＮ
							CFLAG:1101 = 1
						ELSE
							PRINTFORML 「음. 좋아.」
							PRINTW 
						ENDIF
					CASE 1
						PRINTFORML 「응-그래...」
						PRINTFORML 「네가 그렇게 말할 줄 알았어... 역시, 바람 피우는 여자는 아무도 좋아하지 않아...」
						PRINTFORMDL 코마치의 실망감이 분명하다.
						PRINTW 
					CASE 2
						PRINTFORML 「생각해봤는데, 시키님을 음란하게 만들까...? 아니, 이게 최고의 계획이야!」
						PRINTFORML 「카미사마나 부처님께... 예전의 시키님으로 돌려주세요...」
						PRINTFORML 「그리고 그 김에, 그녀가 나에게 설교하는 걸 좀 덜 하게 해주시면 안 될까요...」
						PRINTL 
						PRINTFORML 너와 코마치가 제단에서 소원을 마치자, 신성한 목소리가 네 정신 속에서 울려 퍼진다...
						SETCOLOR C_AQUA
						PRINTFORML 「그래... 원본을 능가하는 에로티시즘은 없지...」
						CALL SET_KOJO_COLOR(76)
						PRINTFORMDL 아이키가 일하는 모습 앞에서 성희롱 명령을 실행하면 그녀는 더 이상 화를 내거나 흥분하지 않는다.
						PRINTW 
						;映姫様ムラムラスイッチＯＮ
						CFLAG:1101 = 0
				ENDSELECT
			ELSEIF RESULT == 1
				PRINTFORML 「아, 저-저 알겠어요. 당신은 꽤 바쁜 분인 것 같네요, %CALLNAME:MASTER%...」
				PRINTFORMDL 코마치는 평소처럼 친근한 미소를 짓고 있지만, 무언가가 분명 그녀를 괴롭히고 있었다.
				PRINTW 
			ELSE
				GOTO INPUT_LOOP_onegai
			ENDIF
		ELSE
			PRINTFORML 「뭘 빌었어?」
			PRINTFORML 「오, 내가 맞춰볼게! "여자 팬티를 줘!" 맞지? 흐음, 틀렸나?」
			PRINTW 
		ENDIF
	ENDIF
ENDIF
RETURN 1
