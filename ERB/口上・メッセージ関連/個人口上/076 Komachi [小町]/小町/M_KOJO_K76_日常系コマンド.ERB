									PRINTW 
							ENDSELECT
					ENDSELECT
			ENDSELECT
			;屋内掃除
		ELSE
			;こまっちゃんの部屋
			IF CFLAG:MASTER:現在位置 == 616
				SELECTCASE TFLAG:193
