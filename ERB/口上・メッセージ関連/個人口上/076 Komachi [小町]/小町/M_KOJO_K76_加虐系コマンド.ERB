;==================================================
;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K76_100
CALL M_KOJO_MESSAGE_COM_K76_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K76_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;PRINTFORMW
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF TEQUIP:Ｖセックス
			CALL HPH_PRINT,@"「아앗, 히익! HPH 용서해줘, 용서해줘어! 끅, 히이이익! HPH」","L"
			PRINTL 
			PRINTFORML 코마치의 뜨겁고 촉촉한 살결을 헤치면서, 입에 넣고 싶어지는 엉덩이살을 손바닥으로 때린다.
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 그럴 때마다 질벽은 급격하게 수축했고, 애원하듯 삽입을 반복하는 성기에 달라붙어 떨어지려 하지 않았다...
				CASE 1
					PRINTFORML 그럴 때마다 질구와 남성 성기 사이의 틈으로 정액이 푸슉, 푸슉하고 튀었고, 코마치가 가학적인 행위에 기뻐하고 있음을 보여주었다…
			ENDSELECT
			PRINTW 
		ELSE
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「히익! HPH 히이잇! HPHHPH」","L"
					CALL HPH_PRINT,@"「용서해 줘 HPH 용서해 줘 제발 HPH」","L"
					PRINTL 
					PRINTFORML 사내라면 욕망대로 거시기(성기)를 박고 싶게 만드는 통통한 뒤에, 몇 번이고 손바닥으로 때린다.
					PRINTFORML 충격을 받을 때마다 엉덩이는 출렁출렁하고, 아첨하는 듯 눈앞에서 흔들린다…
					PRINTW 
				CASE 1
					CALL HPH_PRINT,@"「꺅! 큭, 꺅! 큭!」","L"
					CALL HPH_PRINT,@"「아, 아타이, 기뻐하는 건... 꺅! HPH」","L"
					PRINTL 
					PRINTFORML 무의식인지, 도발하는 것인지... 큰 엉덩이에 괴로움을 받고 있을 터인 코마치의 목소리에는 분명 색기가 섞여 있었다...
					PRINTFORML 그것을 뒷받침하듯, 성숙한 암컷의 구멍에서는 질척한 꿀이 흘러내리고 있었다...
					PRINTW 
			ENDSELECT
		ENDIF
		RETURN 1
	ELSEIF ABL:マゾっ気 >= 3
		IF TEQUIP:Ｖセックス
			PRINTFORML 「꺅!?」
			PRINTFORML 움찔♥
			PRINTFORML 풍만한 엉덩이를 맞은 순간, 코마치의 질이 급격히 수축했고, %조사처리(CALLNAME:MASTER,"는")% 아슬아슬하게 사정할 뻔했다...
			PRINTW 
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「꺅, 꺅」
					PRINTFORML 「저, 엉덩이를 맞아서 기쁘다니...」
					PRINTFORML 그렇게 말하면서도 코마치의 큰 엉덩이는 다음 것을 기대하며 눈앞에서 흔들리고 있다...
					PRINTW 
				CASE 1
					PRINTFORML 「아앗, 히이익!」
					PRINTFORML 남자라면 누구나 탐하고 싶어 할 엉덩이에, 평평한 손바닥 자국들이 여러 개 겹쳐 있었다.
					PRINTFORML 하지만 그것이 고통만이 아님을 증명하듯, 질구에서 한 줄기 음액이 흘러내렸다...
					PRINTW 
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		PRINTFORML 「꺅!?」
		PRINTFORML 「뭐, 뭘 하는 거야. 아픈 건 그냥 넘어가 줘.」
		PRINTW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
