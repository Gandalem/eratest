@M_KOJO_MESSAGE_COM_K76_68_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;前回射精した
		IF TCVAR:102
			IF TALENT:恋慕 || TALENT:恋人
				IF CFLAG:1100 == 1
					CALL HPH_PRINT,@"「아아앙ㅎㅍ 당신의 거시기, 여전히 그렇게 단단하네ㅎㅍ」","L"
					CALL HPH_PRINT,@"「이미 내 보지에 충분히 쏴주지 않았어? HPH 너무 좋아 HPH 정말 좋아 HPH 응이 HPH」","L"
					CALL HPH_PRINT,@"「내 보지에 박아 넣어 HPH 내 자궁에 또 도움을 줘 HPH 응하하안 HPHHPH」","L"
					PRINTW 
				ELSE
					CALL HPH_PRINT,@"「계속 이렇게 안고 있는 채로 한 잔 더 하고 싶어?」","L"
					CALL HPH_PRINT,@"「오케이이이ㅎ 계속 아래쪽으로 나를 찌르고 있어 ㅎㅍㅎ」","L"
					PRINTW 
				ENDIF
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				CALL HPH_PRINT,@"「벌써 잔뜩 쏟아내지 않았어? 이 탐욕스러운 변태 같으니.」","L"
				CALL HPH_PRINT,@"「좋아아아아, 그럼 내 구멍을 더 깊고 더 깊게 파줘아아아아아아아아」","L"
				PRINTW 
			ELSEIF TALENT:思慕
				CALL HPH_PRINT,@"「아응 괜찮아... 응. 내 보지가 수준에 도달한 것 같아」","L"
				CALL HPH_PRINT,@"「당신은 내 안에 넣었던 모든 정액을 뒤섞고 있어 HPH 그것이 정말 더러운 소리를 내고 있어 HPHHPH」","L"
				PRINTW 
			ELSE
				CALL HPH_PRINT,@"「아아...후후. 아직 부족하단 거야...? 후후」","L"
				CALL HPH_PRINT,@"「나한흐프젠장, 아직도 단단하네 흐엉」","L"
				PRINTW 
			ENDIF
			RETURN 1
		ELSE
			IF TALENT:恋慕 || TALENT:恋人
				IF CFLAG:1100 == 1
					CALL HPH_PRINT,@"「이익ㅎㅍ 당신의 거 당신의 것이 뒤쪽까지 다 박히고 있어」","L"
					CALL HPH_PRINT,@"「내 보지를 너무 깊이 파고 있어, 아오옹ㅎㅍㅎ 아히이이ㅎㅍ 아웅ㅎㅍㅎㅎㅎ」","L"
					PRINTW 
				ELSE
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%, %조사처리(CALLNAME:MASTER,"의")% HP 좋아. 계속 더 밀어 넣어줘어어」","L"
					CALL HPH_PRINT,@"「이렇듯 두들겨지는 게 너무 좋아, 정말 사랑해 HPH」","L"
					PRINTW 
				ENDIF
			ELSEIF TALENT:愛欲 || TALENT:セフレ
				CALL HPH_PRINT,@"「안흐프 하아프 하아프 아하앙프」","L"
				CALL HPH_PRINT,@"「네 거 완전 최고야 HPH 이 거 정말 믿을 수 없을 정도로 기분 좋아 HPH」","L"
				PRINTW 
			ELSEIF TALENT:思慕
				CALL HPH_PRINT,@"「아항ㅎㅍ 아안ㅎㅍ 아, 하항ㅎㅍㅎㅍ」","L"
				CALL HPH_PRINT,@"「믿을 수 없는HPH %CALLNAME:MASTER%HPH 더HPH 내게 더많이HPH 하아앙HPH」","L"
				PRINTW 
			ELSE
				CALL HPH_PRINT,@"「안흐프 안흐프 안흐프」","L"
				CALL HPH_PRINT,@"「네 거시기 머리가 내 안쪽을 너무 많이 긁어서아아앙」","L"
				PRINTW 
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	IF TALENT:恋慕 || TALENT:恋人
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「우리가 서로 안고 있는 상태에서 나에게 해 줄 거야...?」
				CALL HPH_PRINT,@"「아아, 정말 좋다...후후 꽉 안아줘...후후」","L"
				PRINTW 
			CASE 1
				CALL HPH_PRINT,@"「당신이 안팎으로 얼마나 뜨거운지 느껴져요 HPH NhahHPH」","L"
				PRINTW 
		ENDSELECT
		RETURN 1
	ELSEIF TALENT:愛欲 || TALENT:セフレ
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「다리를 넓게 벌리고 나에게 박아줘~ 흥분 수치를 최고로 끌어올리자~」","L"
				CALL HPH_PRINT,@"「네 건 우람한 거기로 나를 더 박아줘HPH」","L"
				PRINTW 
			CASE 1
				PRINTFORML 「바하하... 우린 연인들처럼 보이잖아♪」
				CALL HPH_PRINT,@"「좋아, 일단은 네 연인이 되어줄게, %CALLNAME:MASTER%HPH KyahaaanHPH」","L"
				PRINTW 
		ENDSELECT
		RETURN 1
	ELSEIF TALENT:思慕
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「우리가 서로 안고 있는 상태에서 나에게 해 줄 거야...?」
				CALL HPH_PRINT,@"「바하하, 물론이지. 네 마음에 드는 대로 해라... 아아앙흐프」","L"
				PRINTW 
			CASE 1
				CALL HPH_PRINT,@"「나도 이 자세가 좋아, 두우호피」","L"
				CALL HPH_PRINT,@"「안흐프 하아프 나한테 너무 세게 파고들잖아하프」","L"
				PRINTW 
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「우야아앙... 이 자세 정말 치정해 보이네...」
				CALL HPH_PRINT,@"「하지만 있잖아, 무슨 이유에서인지 심장이 두근거려...후후」","L"
				PRINTW 
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%, 나 당신한테 너무 무겁지 않겠어?」
				CALL HPH_PRINT,@"「몸무게가 더 적으면 쉬울 텐데, 하지만 아아응ㅎㅍㅎ 이래도 내 좋은 부위들을 다 때리네ㅎㅍ」","L"
				PRINTW 
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
