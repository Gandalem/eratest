				CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 거시기 HPH 너무 맛있다 HPH)","L"
				CALL HPH_PRINT,@"(그냥 이걸 빨면 너무 흥분돼 HPH)","L"
			CASE 3
				CALL HPH_PRINT,@"「%RANDKISS("suck")%HPH %RANDKISS("suck")%HPH %RANDKISS("suck")%HPHHPH」","L"
				PRINTFORMDL 코마치가 당신의 허리를 필사적으로 붙잡고 얼굴을 당신의 가랑이에 밀어 넣으며 움직임을 봉쇄한다.
				CALL HPH_PRINT,@"「아앙~ 도망치려고 하지 마, 제대로 빨아줄게...후햣」","L"
			CASEELSE
				CALL HPH_PRINT,@"「%RANDKISS("kiss")%HPH %RANDKISS("suck")%HPH %RANDKISS("kiss")%HPHHPH」","L"
				CALL HPH_PRINT,@"「기분이 좋아? 여기 있어, 나한테 더 많은 걸 보여줄래? %RANDKISS("suck")%~~」","L"
		ENDSELECT
		PRINTW 
		RETURN 1
		;それ以外
	ELSE
