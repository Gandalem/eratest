@M_KOJO_MESSAGE_COM_K76_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSEIF TALENT:恋慕
		;現在位置
		IF BATHROOM()
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「음, 내 포옹은 어때?」
					CALL HPH_PRINT,@"「부드럽고 편안해? 그렇게 들으니 기쁘네, HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「헤이 %CALLNAME:MASTER%, 이리 와 봐. 너를 꼭 안아줄게～HPH」","L"
					PRINTFORMDL 코마치는 당신을 자신의 품으로 맞이할 준비를 하며 두 팔을 활짝 벌린다.
					CALL HPH_PRINT,@"「좋은 %PRINT_MALE("boy", MASTER)%, 좋은 %PRINT_MALE("boy", MASTER)%...후후. 정말 행복해 보여, 알잖아...후후」","W"
				CASE 2
					PRINTFORMDL 당신은 코마치를 뒤에서 안는다.
					CALL HPH_PRINT,@"「빨리~ 이 못된 녀석, 내 가슴을 만지려고 방해를 이용하려 했구나...흐응」","L"
					PRINTFORMDW 하지만 그럼에도 코마치는 당신을 막지 않고, 당신은 마음껏 그녀의 가슴을 만진다.
				CASE 3
					PRINTFORMDL 당신은 코마치를 뒤에서 안는다.
					CALL HPH_PRINT,@"「너무 따뜻해...후후 정말 행복해 후후」","W"
				CASE 4
					CALL HPH_PRINT,@"「내 사랑이 그렇게 당겨? 네가 원하는 만큼 세게 껴안아봐 HPH」","L"
					PRINTFORMDW 코마치는 부드러운 미소로 당신의 얼굴을 자신의 풍만한 가슴에 묻고 머리를 쓰다듬기 시작한다.
			ENDSELECT
		ELSE
			;２人以上いる
			IF GET_TARGETNUM() >= 2
				;2022/04/25更新分
				;現在位置が法廷かつ映姫が仕事中
				IF CFLAG:現在位置 == 612 && 仕事中チェック(30) && CFLAG:30:現在位置 == 612
					;問題なければセクハラするたびに映姫の怒りが増加していく処理を入れてみたい
					;IF BASE:30:怒り >= 600
					;ELSEIF BASE:30:怒り >= 300
					;ELSE
					;ENDIF
					;BASE:30:怒り += 50
					;とりあえずただの分岐で
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML (안 돼. 시키님 바로 거기 계셔!)
							PRINTFORMDL 코마치가 에이키가 자신에게 천둥을 내릴까 두려움에 떨었다...
							PRINTW 
						CASE 1
							PRINTFORML (저기, 우리 법정 안에 있잖아...)
							PRINTFORMDL 코마치는 약하게 당신을 꾸짖는다.
							PRINTW 
						CASE 2
