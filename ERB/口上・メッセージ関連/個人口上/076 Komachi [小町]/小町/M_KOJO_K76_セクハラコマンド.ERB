@M_KOJO_SUCCESS_COM_K76_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K76_310
CALL M_KOJO_MESSAGE_COM_K76_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K76_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
		PRINTFORMDL 당신은 코마치의 엉덩이를 두 손 가득 움켜쥔다.
		PRINTFORMDW 반응이 없는 건 조금 슬프지만, 그래도 통통한 감각을 즐길 수 있다.
	ELSEIF TALENT:恋慕
		;現在位置
		IF BATHROOM()
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「...후후, 이거 좋아?」","L"
					PRINTFORMDL 코마치는 목욕탕에서 당신에게 등을 돌리고 엉덩이를 내밀고 있었으며, 두 볼은 갓 삶아 껍질을 벗긴 달걀처럼 빛나고 있었다.
					CALL HPH_PRINT,@"「아니이이~ 당신 눈앞에서 내 몸의 많은 부분이 다 드러나버렸어...흐읍」","W"
				CASE 1
					CALL HPH_PRINT,@"「자, 어서~ %CALLNAME:MASTER%, 당신이 그토록 사랑하는 엉덩이야HPH」","L"
					PRINTFORMDL 코마치는 목욕탕에서 당신에게 등을 돌리고 엉덩이를 내밀고 있었으며, 두 볼은 갓 삶아 껍질을 벗긴 달걀처럼 빛나고 있었다.
					CALL HPH_PRINT,@"「당신...흐으, 당신의 숨결이 내 보지에 느껴져요~흐으」","W"
				CASE 2
					PRINTFORMDL 당신은 코마치의 엉덩이를 잡는다 그녀가 간절하게 당신에게 몸을 밀착하며.
					CALL HPH_PRINT,@"「있잖아, 이 느낌은 질릴 것 같지 않아...후훗」","L"
					CALL HPH_PRINT,@"「아니, 그곳은 내 엉덩이가 아니야」","W"
				CASE 3
					CALL HPH_PRINT,@"「내 엉덩이를 그렇게까지 연모하는 거야? 어쩔 수 없겠지...후훗」","L"
					PRINTFORMDW 당신은 그녀의 저항 없는 상태를 완전히 이용하고 그녀의 동그란 엉덩이를 마사지하기 시작한다.
				CASE 4
					PRINTFORMDL 당신은 그녀의 귀엽지만 금지된 입구인 항문에 손가락을 넣어 더듬는다.
					CALL HPH_PRINT,@"「오온, 너무 욕심을 부리는구나...흐읍」","W"
			ENDSELECT
		ELSE
			;２人以上いる
			IF GET_TARGETNUM() >= 2
				;2022/04/25更新分
				;現在位置が法廷かつ映姫が仕事中
				IF CFLAG:現在位置 == 612 && 仕事中チェック(30) && CFLAG:30:現在位置 == 612
					;問題なければセクハラするたびに映姫の怒りが増加していく処理を入れてみたい
					;IF BASE:30:怒り >= 600
					;ELSEIF BASE:30:怒り >= 300
					;ELSE
					;ENDIF
					;BASE:30:怒り += 50
					;とりあえずただの分岐で
					;スケベスイッチ
					IF CFLAG:1100 > 0
						SELECTCASE RAND:12
							CASE 0
								CALL HPH_PRINT,@"(이런 곳에서 나를 만지고 있다니 믿을 수가 없어... HPH)","L"
								PRINTFORMDL 코마치조차 꽤 주저하는 듯하지만, 그녀는 여전히 그에 응한다.
								PRINTW 
							CASE 1
								CALL HPH_PRINT,@"(흐음, 계속 그렇게 만지면... 흥분하지 않을 수가 없겠어HPH)","L"
								PRINTW 
							CASE 2
								CALL HPH_PRINT,@"(제기랄, 그렇게 음란하게 나를 쓰다듬어야 해...흐읍)","L"
								PRINTW 
							CASE 3
								CALL HPH_PRINT,@"(진심으로 내 엉덩이를 만지고 있어...HPH)","L"
								PRINTW 
							CASE 4
								CALL HPH_PRINT,@"(저기... 시키님께서 안 보신다고 내 엉덩이를 만지려고 하지 마... HPH)","L"
							CASE 5
								CALL HPH_PRINT,@"(이런 곳에서 그렇게 저속하게 나를 만지다니... 내 엉덩이가 정말 이리 거부할 수 없을 정도로 매력적인 걸까...? (HPH))","L"
							CASE 6
								CALL HPH_PRINT,@"(당신은 나를 이렇게 만지게 할 유일한 사람이니까...HPH)","L"
							CASE 7
								CALL HPH_PRINT,@"(으음... 이봐, 그곳에 손가락 넣지 마 HPH)","L"
							CASE 8
								CALL HPH_PRINT,@"(괜찮을 거야, 아마... 몰래 해주는 게 중요해. 시키님께 들키고 싶지 않으니까(HPH))","L"
							CASE 9
								CALL HPH_PRINT,@"(흥, 이런 곳에서 나를 만지다니... 정말 음탕하군... HPH)","L"
							CASE 10
								CALL HPH_PRINT,@"(아마 괜찮을 거야... 시키님은 절대 알 리 없어... HPH)","L"
							CASE 11
								CALL HPH_PRINT,@"(시키님께서 저 같은 곳에서 엉덩이를 만지고 있다는 걸 아시면 어떤 표정을 지으실지 궁금하다.)","L"
						ENDSELECT
					ELSE
						IF TALENT:恋人
							SELECTCASE RAND:5
								CASE 0
									PRINTFORML (헤이—! 그런 건 때와 장소가 있는 거야.)
									PRINTFORMDL 코마치, 네 부적절한 행동에 대해 작게 꾸짖는다. 
									PRINTW 
								CASE 1
									PRINTFORML (우리 방에서 그런 걸 해야 한다니... 제발!)
									PRINTW 
								CASE 2
									PRINTFORML (이런 곳에서 그런 걸 하다니... 정말 참을 수가 없으신가요?)
									PRINTW 
								CASE 3
									PRINTFORML (헤이, 이 모든 일이 벌어지는 한복판에서 내 엉덩이에 손대지 마!)
									PRINTFORMDL 평소에는 느긋한 편이지만, 코마치는 법정 앞에서 만져지는 것에 패닉에 빠진다. 특히 보스 앞에서 그렇다.
									PRINTW 
								CASE 4
									PRINTFORML (음... 네 엉덩이를 쓰다듬는 건 상관없지만, 지금은 참아주세요...)
									PRINTW 
							ENDSELECT
						ELSE
							SELECTCASE RAND:5 ;custom code
								CASE 0
									PRINTFORML (헤이, 헤이, 왜 몰래 나를 만지고 있는 거야?)
									PRINTW 
								CASE 1
									PRINTFORML (저기, 우리 법정 안에 있잖아...)
									PRINTFORMDL 코마치는 약하게 당신을 꾸짖는다.
									PRINTW 
								CASE 2
									PRINTFORML (저기, 들키지 않을 거라고 생각한다고 그걸 하면 안 돼...)
									PRINTFORMDL 코마치가 에이키가 네 부적절한 행동을 알아차리기 전에 네 손을 조심스럽게 쳐낸다.
									PRINTW 
								CASE 3
									PRINTFORML (왜 이런 곳에서 나를 만지고 싶어 하는 거지...)
									PRINTW 
								CASE 4
									PRINTFORML (아니 아니, 그만둬, 그만해! 무슨 생각이야? 우린 법정에 있잖아!)
									PRINTW 
							ENDSELECT
						ENDIF
					ENDIF
					SIF CFLAG:1101 == 1
						CALL EIKI_REACTION
				ELSE
					SELECTCASE RAND:5
						CASE 0
							PRINTFORML 「저기, 사람들 주변에 있잖아! 눈이 멀었어?」
							PRINTFORMW 「집중할 수가 없어, 그만해...」
						CASE 1
							PRINTFORML 「야, 주변에 사람 많아! 눈 먼 거야?」
							CALL HPH_PRINT,@"「만약 나를 놀리려면, 적어도 들키지 않게 해줘... HPH」","W"
						CASE 2
							PRINTFORMDL 주변을 전혀 신경 쓰지 않고 코마치의 엉덩이를 한 움큼 잡는다.
							CALL HPH_PRINT,@"「아아, 제발 네가 하고 싶은 대로 해, 이 엉덩이 좋아하는 광인아」","L"
							PRINTFORMDW 그녀는 당신의 엉덩이에 대한 연모가 너무 커서 더 이상 비난하는 것이 불가능하다는 사실을 깨달은 것 같다...
						CASE 3
							CALL HPH_PRINT,@"「내 엉덩이 그렇게 좋아해? 어쩔 수 없는 거겠지... HPH」","L"
							PRINTFORMDW 당신은 그녀의 거대하고 둥근 엉덩이를 주먹으로 쓰다듬기 시작하며, 저항이 없는 상태를 최대한 이용한다.
						CASE 4
							PRINTFORMDL 당신은 그녀의 귀엽지만 금지된 입구인 항문에 손가락을 넣어 더듬는다.
							CALL HPH_PRINT,@"「음... 공공장소에서 좀 너무 노골적인 거 아니라고 생각해...? HPH」","W"
					ENDSELECT
				ENDIF
			ELSE
				SELECTCASE RAND:4
					CASE 0
						PRINTFORMDL 주변을 전혀 신경 쓰지 않고 코마치의 엉덩이를 한 움큼 잡는다.
						CALL HPH_PRINT,@"「아아, 제발 네가 하고 싶은 대로 해, 이 엉덩이 좋아하는 광인아」","L"
						PRINTFORMDW 그녀는 당신의 엉덩이에 대한 연모가 너무 커서 더 이상 비난하는 것이 불가능하다는 사실을 깨달은 것 같다...
					CASE 1
						CALL HPH_PRINT,@"「내 엉덩이 그렇게 좋아해? 어쩔 수 없는 거겠지... HPH」","L"
						PRINTFORMDW 당신은 그녀의 거대하고 둥근 엉덩이를 주먹으로 쓰다듬기 시작하며, 저항이 없는 상태를 최대한 이용한다.
					CASE 2
						PRINTFORMDL 당신은 코마치의 귀엽지만 금지된 입구인 항문에 손가락을 넣어 탐색한다.
						CALL HPH_PRINT,@"「음... 너무 서두르는 것 같지 않아... HPH」","W"
					CASE 3
						PRINTFORMDL 코마치에게 당신 쪽으로 엉덩이를 내밀고 치마를 들어 올리라고 말한다.
						PRINTFORMDW 코마치는 얼굴을 붉히지만, 반항 없이 그것을 해준다.
						PRINTL
						IF EQUIP:TARGET:下半身下着１ || EQUIP:TARGET:下半身下着２
							PRINTFORML 「나의 팬티도 치워주길 원해? 좋아, 해줄게...」
							PRINTFORMDW 코마치는 자신의 속옷을 무릎까지 내리며 분홍색 음순과 갈색 보조개를 당신이 볼 수 있도록 드러냈다.
							PRINTL 
							CALL HPH_PRINT,@"「이거 좋아? 야아?! 이, 잠깐만! 아하안헵」","L"
							PRINTFORMDW 당신은 그녀의 엉덩이를 움켜쥐고, 코마치가 숨을 헐떡이며 신음하는 동안 마음껏 맨살인 엉덩이를 만진다.
						ELSE
							CALL HPH_PRINT,@"「음, 뭐 할 거야... 오오옹~후프」","L"
							PRINTFORMDW 코마치가 통통하고 방어할 수 없는 엉덩이를 쓰다듬자 귀여운 비명을 지른다.
						ENDIF
				ENDSELECT
			ENDIF
		ENDIF
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「흐윽! 그럼 마음대로 해봐.」
				PRINTFORMDW 짜증 섞인 말투에도 불구하고 코마치는 네가 계속 그녀의 엉덩이를 쓰다듬는 것을 허락한다.
			CASE 1
				PRINTFORML 「음... 당신이 나를 만지는 방식이 좀, 아, 알잖아...」
				PRINTFORMDW 코마치는 네가 그녀의 민감한 엉덩이 부분을 쓸어내릴 때 부드럽게 손을 밀쳐낸다.
			CASE 2
				PRINTFORML 「네가 엉덩이를 좋아하는 건 알지만, 진심으로 말이야.」
				PRINTFORMW 「도대체 언제까지 나를 만지작거릴 작정이야?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「그만둬!」
				PRINTFORMDW 네가 계속 그녀의 엉덩이를 부드럽게 쓰다듬자, 코마치가 너를 밀쳐낸다.
			CASE 1
				PRINTFORML 「꺄아앙!?」
				PRINTFORMDW 그녀의 엉덩이 골을 손으로 쓸어내리자 코마치가 귀여운 비명을 질렀다.
			CASE 2
				PRINTFORML 「아니, 그만둬! 누군가를 만질 때는 좀 더 자제심을 보이는 게 정상 아니야?」
				PRINTFORMDW 코마치는 당신의 대담함에 놀란 표정을 짓는다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
