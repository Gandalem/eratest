@M_KOJO_MESSAGE_COM_K76_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「후훗~」
		PRINTFORMDL 코마치가 뜻밖에도 웃음을 터뜨린다.
		PRINTW 
		PRINTFORML 「미안해, 미안해! 내가 기분 나쁘게 하진 않았을까?」
		;Ed. note: restored deleted content here, and added alternative for virgin Komachi
		IF CFLAG:76:1099 == 1
			PRINTFORML 「정말 행복했어! 이렇게 부드럽게 애무받을 줄은 상상도 못 했지...」
		ELSE
			PRINTFORML 「정말 행복했어! 이렇게 부드럽게 나를 어루만져 주는 건 네가 처음이야...」
			PRINTW 
			PRINTFORML 「내가 지금까지 만났던 모든 남자들은 그냥 전희로 자기들만 만족시키려고 했어, 알잖아.」
			PRINTFORML 「음, 나도 별반 다르지 않은 것 같아, 이렇게 당신에게 응석을 부리는 거. 하지만 우리 둘 다 즐기고 있다면 괜찮아♪」
		ENDIF
		PRINTW 
		PRINTFORMDL 코마치는 당신의 손을 잡고 자신의 통통한 가슴 위에 올려놓는다.
		PRINTFORML 「그건 그렇고, 내가 깨달음을 얻었어!」
		PRINTW 
		PRINTFORML 「이제 알겠어, 그냥 넣거나 박히는 것만이 기분 좋은 게 아니라는 걸!」
		CALL HPH_PRINT,@"「그래서, 내 몸을 많이많이 느끼해줬으면 해! 나를 구석구석 만져줘, %CALLNAME:MASTER%HPH」","L"
		PRINTFORMDW 코마치는 당신의 뺨에 부드러운 입맞춤을 하고 부드럽게 미소 짓는다.
		PRINTW 
		CALL HPH_PRINT,@"「네가 얼마나 굉장한지 보여줘 HPH」","L"
		PRINTW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		IF TALENT:恋慕 || TALENT:恋人
			;射精した
			IF NOWEX:PLAYER:11
				CALL HPH_PRINT,@"「안, 하아, 나 안아줘애 HPH 안에 가득 채워줘, 음프 HPH 그 정액을 뿜어내 HPH」","W"
				RETURN 1
			ELSE
				CALL HPH_PRINT,@"「하아앙! 당신이 나를 만지는 방식이 좋아HPH 더 해줘, 나를 점점 더 느끼게 해줘!HPH」","L"
				CALL HPH_PRINT,@"「나, 정말 행복해. 이게 바로 황홀함이야」","W"
				RETURN 1
			ENDIF
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				CALL HPH_PRINT,@"「아, 만약 분출할 거라면 밖에 해! 아으읍 하-저기, 그만해. 안 돼。」","W"
				RETURN 1
			ELSE
				CALL HPH_PRINT,@"「흐으음, 지금 나를 만지는 방식이 너무 강렬해 HPH NnfHPH 잠깐, 천천히 해줘 HPH 너무 심해 HPH」","W"
				RETURN 1
			ENDIF
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ELSE
		SELECTCASE RAND:19 ;custom code
			CASE 0
				CALL HPH_PRINT,@"「온몸이 만져지고 당신의 입술이 내 목에 키스할 때, 후와후와 나는 그것을 사랑해」","L"
			CASE 1
				CALL HPH_PRINT,@"「응~~! 네가 나를 만지는 방식 때문에 떨려 HPH」","L"
			CASE 2
				CALL HPH_PRINT,@"「아흐프 노후, 내 귀를 핥지 마!」","L"
			CASE 3
				CALL HPH_PRINT,@"「아현! HPH 내 귀에 바람 불지 마...HPH」","L"
			CASE 4
				CALL HPH_PRINT,@"「내 옆구리, 흐윽, 거기서 키스하면 좀 이상해HPH」","L"
			CASE 5
				PRINTFORML 「음, 내 배꼽이 아니야... 간지러워!」
			CASE 6
				PRINTFORML 「흐으, 내 겨드랑이 핥지 마, 으응! 너무 이상해!」
				CALL HPH_PRINT,@"「거짓말 그만해, 저건 절대 맛있을 리 없어, 아, 우아안HPH 안, 아, 아아아!HPH」","L"
			CASE 7
				PRINTFORML 「우후우!? 내 등 아래로 손가락을 더 쓰지 마, 이상해!」
			CASE 8
				CALL HPH_PRINT,@"「아하, 아아, 내 귀를 핥지 마... 온몸이 간질간질해져 버리잖아HPH」","L"
			CASE 9
				CALL HPH_PRINT,@"「음음흐음 그곳이 정말... 느낌이 좋아」","L"
				PRINTFORMDL 코마치의 몸이 움찔거린다, 당신이 그녀의 쇄골선을 따라 혀를 움직이자.
			CASE 10
				CALL HPH_PRINT,@"「이렇게 내 몸 전체를 어루만지니... 너무 기분 좋아...흐으」","L"
			CASE 11
				PRINTFORMDW 그녀의 유두를 피하기 위해, 당신은 코마치의 가슴 곡면 위로 손가락을 미끄러뜨리며 부드러운 살결을 겨우 스친다.
				CALL HPH_PRINT,@"「후후, 후후, 음음...흐읍 흐으, 응, 흠흠...흐읍」","L"
				PRINTFORMDL 코마치의 신음은 간지러운 웃음으로 시작하지만 점차 황홀한 울음소리로 변한다.
			CASE 12
				PRINTFORMDL 당신은 코마치의 음부와 허벅지 안쪽을 앞뒤로, 위아래로 혀를 핥는다.
				CALL HPH_PRINT,@"「아앙, 으음...흐읍 헤이, 헤에, %CALLNAME:MASTER%...흐읍」","L"
				CALL HPH_PRINT,@"(%HE_SHE(MASTER)%는 좀 더 아래쪽을 핥아주지 않을 건가...? 이거 좀 답답하네... 나는 내 특별한 부위HPH를 원해)","L"
			CASE 13
				CALL HPH_PRINT,@"「아하, 아하하하, 간지러워♪ 하안!HPH 그만둬!♪」","L"
				PRINTFORMDL 당신은 코마치를 허리부터 겨드랑이까지 간지럽히고, 코마치는 벗어나려고 몸을 비틀며 무력하게 웃는다.
			CASE 14
				CALL HPH_PRINT,@"「아아, 당신이 얼마나 부드러운지 좋아...후후」","L"
				PRINTFORMDL 코마치는 마치 벌레를 구걸하는 아기 새처럼 당신이 그녀의 목에 작은 입맞춤을 하는 것을 보며 행복하게 미소 짓는다.
			CASE 15
				PRINTFORML 「이상해, 이상한 곳은 전혀 만지지 않았는데, 여전히 소름이 돋아...」
				PRINTFORMDL 그녀의 어깨뼈부터 팔뚝까지 부드럽게 마사지해주자, 코마치 몸에 희미하지만 느껴지는 쾌감이 흐른다.
			CASE 16
				PRINTFORMDL 당신은 정성스럽고 사랑스럽게 코마치의 허벅지를 어루만지며 그녀의 부드러운 곡선들에 마땅히 받아야 할 관심을 아낌없이 베푼다.
				PRINTFORML 「음... 음ㅁ프♪」
				PRINTFORMDL 당신은 마사지로 시작하여 점차 열 손가락을 안쪽 허벅지까지 위로, 위로, 위로 움직인다...
				PRINTW 
				CALL HPH_PRINT,@"「으응!? 후우.... 음...흐읍」","L"
				PRINTFORMDL 하지만 당신은 결승선에 닿기 직전에, 손을 다시 움직이며 그녀를 희롱한다...
				PRINTW 
				CALL HPH_PRINT,@"「아, 아아~흐응 후후우~~흐응」","L"
				CALL HPH_PRINT,@"(하아, 이 즐거움과 좌절감의 혼합이 나를 이상하게 만들고 있어...흐으)","L"
			CASE 17
				PRINTFORML 「그런 곳에 코를 박지 마! 하얀!」
				PRINTFORMDL 당신이 그녀의 겨드랑이와 가슴팍에 파고들며 온 힘을 다해 숨을 몰아쉬자 코마치는 얼굴을 새빨갛게 물들였다.
			CASEELSE
				CALL HPH_PRINT,@"「흐으, 내 항문골을 손가락으로 헤집지 마...큭」","L"
				PRINTFORMDL 코마치는 숨을 참으려 손가락을 깨물고 당신에게 원망스러운 눈빛을 보냈다.
		ENDSELECT
		PRINTW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
