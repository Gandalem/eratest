@M_KOJO_MESSAGE_COM_K76_20
CALL M_KOJO_MESSAGE_COM_K76_20_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K76_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			CALL HPH_PRINT,@"(아아, %조사처리(CALLNAME:MASTER,"의")% 키스는 머리를 하얗게 만들어버려...후흑)","L"
			PRINTFORML 「다른 여자랑 키스해 본 적 있어? 짜증 나네. 네 첫 키스를 하고 싶었는데...」
			CALL HPH_PRINT,@"「하지만, 너는 여전히 나의 첫 키스를 가졌으니 나는 행복해HPH」","L"
			PRINTW 
		ELSE
			CALL HPH_PRINT,@"「츄우... 에헤헤, 제대로 키스해줬네, 안 그래?HPH」","L"
			PRINTFORML 「예쁜 머리 걱정 마, 넌 키스 정말 잘하잖아♪」
			CALL HPH_PRINT,@"「하지만 있잖아, 한 번으로는 확실히 알 수 없을 수도 있으니까, 다시 하는 게 좋겠어HPH」","L"
			PRINTW 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		;TEQUIP:体位　TARGETの体位　1:正常位　2:後背位　3:騎乗位　4:対面座位　5:背面座位
		;騎乗位しながらイくときにべろちゅー
		IF TEQUIP:体位 == 3
			IF NOWEX:MASTER:射精
				PRINTFORMDL 정액이 고환에서 차오르는 것을 느끼고 자신도 모르게 신음한다.
				PRINTFORMDL 임박한 사정을 감지하고 코마치가 몸으로 당신을 덮는다.
				PRINTW 
				PRINTFORMDL 그녀는 당신의 손을 자신의 것으로 움켜쥐고 당신의 입술을 봉인하며, 당신이 계속 골반을 흔드는 동안 열정적으로 키스한다.
				CALL HPH_PRINT,@"(내 안에 사정해줘, 내 보지에!)","L"
				PRINTFORMDL 쾌감에 압도되어, 당신은 절정에 이를 수밖에 없다.
				PRINTW 
			ELSE
				PRINTFORML 
				PRINTW 
			ENDIF
		ELSEIF TEQUIP:体位 == 1
			PRINTFORMDL 당신의 손바닥으로 코마치의 뺨을 감싸 쥔 채, 그녀의 입안 깊숙한 곳을 혀로 침범한다.
			PRINTFORMDL 뒤처지지 않으려는 듯, 코마치도 그 열정에 맞서 당신의 입술을 탐하며 되갚는다.
			PRINTW 
			CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 키스들... 내 온몸이 녹아내릴 것만 같다...HPH)","L"
			CALL HPH_PRINT,@"(당신의 거시기도, 당신의 키스도, 당신의 어떤 부분이 나를 기분 좋게 하지 않는 거지...HPH)","L"
			PRINTW 
		ELSEIF TEQUIP:体位 == 2
			CALL HPH_PRINT,@"「아앙, 아아아아흐헵 제발 흐헵 나에게 키스해줘, 아응헵 더 많은 키스를 줘헵」","L"
			PRINTFORMDL 코마치는 고개를 뒤로 젖히며 키스를 애원한다.
			PRINTFORMDL 그녀의 토라진 입술과 강아지 같은 눈에 이끌려, 당신은 열정적인 키스로 그녀를 달래준다.
			PRINTW 
		ELSEIF TEQUIP:体位 == 4
			CALL HPH_PRINT,@"「음음흐으읍 음음흡음 %RANDKISS("kiss")%흡음, 멈추지 마... 제발 아직은 멈추지 말아줘HPH」","L"
			PRINTFORMDL 코마치가 당신의 목을 두 팔로 감싸고 공격적으로 혀를 얽는다.
			PRINTFORMDL 당신의 입술이 벌어질 때, 하나의 가느다란 타액 실이 잠시 둘을 연결한다...
			PRINTW 
		ELSEIF TEQUIP:体位 == 5
			CALL HPH_PRINT,@"「음, 하아...흐으 몸의 여러 곳이 너무 기분 좋아... 정신 못 차릴 것 같아 흐으」","L"
			PRINTFORMDL 코마치는 당신의 목을 한 손으로 감싸고 몸을 비틀어 키스를 애원한다.
			PRINTFORMDL 당신은 마치 어미 새가 새끼들에게 먹이를 주듯 그녀에게 입맞춤을 퍼붓고, 그녀의 표정은 황홀함으로 변한다...
			PRINTW 
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「헤에이, 더, 더, 나한테 더 줘~~」
					PRINTFORMDL 평소엔 저렇게 애처롭게 구걸하는 코마치가 얼굴을 내밀며 당신에게 매달린다.
					PRINTW  
				CASEELSE
					CALL HPH_PRINT,@"「여기 봐, 혀 더 내밀어라HPH」","L"
					PRINTFORMDL 코마치가 열정적으로 당신의 혀와 자신의 혀를 얽는다.
					PRINTFORMDL 축축한 소리와 찰싹거리는 소리가 두 입이 맞닿아 갈릴 때 새어 나온다...
					PRINTW  
			ENDSELECT
		ENDIF
		RETURN 1
	ELSEIF TALENT:思慕
		CALL HPH_PRINT,@"「응, 음프, 음프...흐읍」","W"
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「음, %TOLOWER(RANDKISS("kiss"))%...」
		PRINTFORML 「바하하~ 심장이 두근거려, 알겠지♪」
		PRINTW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
