@M_KOJO_MESSAGE_COM_K76_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「하아, 생각했던 것보다 더 창피해...」
		PRINTFORMDL 코마치는 당신이 그녀의 은밀한 곳을 천천히 감상하는 동안 두 손으로 얼굴을 가린다.
		PRINTW 
		PRINTFORML 「～～～～제발 내 보지가 아름답다고 그런 이상한 소리 하지 마!」
		PRINTFORML 「부-부끄러워... 히안!?」
		PRINTFORMDL 코마치의 항의를 가로막듯, 갑자기 그녀의 전체 대음순을 입술로 빨아들였다.
		PRINTW 
		IF ABL:Ｃ感覚 > 0
			CALL HPH_PRINT,@"「~~~~!! 오은흐프 우우흐프」","L"
			PRINTFORMDW 코마치의 정신이 당신의 기습 공격으로 인한 갑작스러운 쾌감에 잠시 하얗게 변한다.
			CALL HPH_PRINT,@"(뭐야? 도대체 뭐야!? 내 보지가 너무 좋아!HPH)","L"
		ELSE
			CALL HPH_PRINT,@"「에엑...헵」","L"
			PRINTFORMW 「아니, 아무것도 아니야! 난 괜찮으니까 계속 가!」
			PRINTFORML (내 갈라진 곳을 핥는 게 정말 엄청나게 느껴진다니 믿을 수가 없어...)
		ENDIF
		PRINTW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORML 「아, 내 몸에서 흘러나오고 있어... 닦아야 한다고 말하려 했는데, %조사처리(CALLNAME:MASTER,"는")% 뭐 하는 거야!?」
			PRINTFORMDL 강한 성적인 악취를 맡으며, 당신은 코마치의 사타구니에 머리를 파묻고 자신의 정액과 그녀의 연모즙을 혀로 핥아 치운다.
			PRINTW 
			PRINTFORML 「아아앙, %CALLNAME:MASTER%, 아래가 더럽네...」
			PRINTFORML 「게다가, 왜 네 정액 맛을 보고 싶으겠어? 그걸 %PRINT_MALE("guys_:people", MASTER)% 싫어하지 않아?」
			PRINTFORMDL 코마치는 미안해하면서도 수치심으로 가득 찬 표정을 짓는다.
			PRINTW 
			CALL HPH_PRINT,@"「음...후우, 나를 청소해줘서 고마워 후우」","L"
			PRINTFORMDL 코마치가 감사하는 마음으로 당신에게 키스한다.
			PRINTW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		IF PALAM:欲情 >= PALAMLV:4
			CALL HPH_PRINT,@"「아앗!? 곤, 갈 것 같아음흐프 응! 곧 갈 것 같아음흐프 하지마음흐프 아한음흐프 오오~~음흐프ㅎ」","L"
			PRINTFORMDL 그녀가 절정에 도달한 후에도 당신은 가차 없이 그녀의 클리토스를 빨아들이고, 코마치의 엉덩이는 비명처럼 높아지는 목소리와 함께 침대에서 떠오른다.
		ELSE
			CALL HPH_PRINT,@"「아, 당신의 혀, 안을 빙글빙글 핥고 있네요! HPH 나 가버릴 것 같아 HPH」","L"
			PRINTFORMDL 코마치는 절정에 도달해 당신을 단단히 조이며 허벅지를 경련시킨다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF PALAM:欲情 >= PALAMLV:4
		SELECTCASE RAND:4 ;custom code
			CASE 0
				CALL HPH_PRINT,@"「앙ㅎㅍ 오오ㅎㅍ 내 클리티ㅎㅍ 너 빨고 있네 오후우ㅎㅍ」","L"
				PRINTFORMDL 코마치는 당신이 그녀의 쾌락콩의 후드를 혀로 벗겨내고 그것을 직접 빨아들이자 압도적인 쾌감의 고통 속에서 몸을 비튼다.
			CASE 1
				CALL HPH_PRINT,@"「네 혀로 나 괴롭히지 마!」","L"
				CALL HPH_PRINT,@"「아앙흐으응 아앙흐으응 너무 빨고 쩝쩝거리네에ㅔㅎ」","L"
				CALL HPH_PRINT,@"「못된 짓 하지 마~ HPH NohooHPH 하지만 제발 멈추지 말아줘 HPHHPH」","L"
			CASE 2
				CALL HPH_PRINT,@"「아흔피 하아흔피 기운 좀 내봐, 휴식 좀 갖자 HPHHPH」","L"
				PRINTFORMDL 당신은 코마치의 허벅지를 아래로 눌러 그녀가 도망치지 못하게 하고, 저속한 흡입 소리를 내며 그녀의 보지에서 장난스러운 넥타(nectar)를 빨아들인다.
				PRINTW 
				CALL HPH_PRINT,@"「히이픙 우우픙 나하픙 하, 하안픙 누우픙 스토빗픙」","L"
				PRINTFORMDL 당신의 공격을 피할 수 없자, 코마치의 얼굴이 찡그려지고 그녀는 그 쾌감을 견디려는 듯 고개를 좌우로 흔들었다.
			CASEELSE
				PRINTFORML 「기분이 어떨지 어떻게 물어본단 말이야! 물론 좋지!」
				CALL HPH_PRINT,@"「나를 보고도 알 수 있지. 물어볼 필요는 없잖아.」","L"
				CALL HPH_PRINT,@"「너무 좋다 HPH 너무 좋다, 좀 더 천천히 해줘... HPH」","L"
		ENDSELECT
		PRINTW 
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아아, 그렇게 부드럽게 나를 핥을 때...」
				PRINTFORMDL 코마치의 몸이 떨린다. 당신은 그녀의 질 입구와 대음순을 핥았다.
			CASE 1
				PRINTFORML 「아아, 계속 그렇게 집요하게 나를 핥으면...」
