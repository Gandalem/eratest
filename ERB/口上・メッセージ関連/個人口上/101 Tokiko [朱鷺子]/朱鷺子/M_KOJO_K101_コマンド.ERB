;==================================================
;120,クンニ強制
;==================================================

@M_KOJO_MESSAGE_COM_K101_120
CALL M_KOJO_MESSAGE_COM_K101_120_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_120_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「음응... 챱... 핥짝...」
				PRINTFORMW 「후훗... 무슨 일이야? 기분 좋아? 괴로워 보이네」
				PRINTFORMW 「더 기분 좋게 해 줄게... 챱... 혀를 놀려봐」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 토키코의 혀 사용에 참지 못하고 애달픈 소리를 내고 있다.
			CASE 1
				PRINTFORMW 「기분 좋게 신음하는 %조사처리(CALLNAME:MASTER,"는")%… 귀여워…」
				PRINTFORMW 「으응…? 그만둬…? 이제 그런 목소리로 말해도 설득력 없어… 핥짝…」
				PRINTFORMW 토키코의 혀에 의해 %조사처리(CALLNAME:MASTER,"는")% 마음대로 당하고 있다.
				PRINTFORMW 「찰싹… 후훗, 스스로 허리를 밀어붙이다니… 귀여워…」
				PRINTFORMW 토키코의 중얼거림은 쾌락의 물결에 휩싸인 %CALLNAME:MASTER%에게는 닿지 않았다.
			CASE 2
				PRINTFORMW 「응응… 으윽……… 후훗 기분 좋아 보여……」
				PRINTFORMW 「점점 기분 좋은 액이 흘러넘치고 있잖아」
				PRINTFORMW 심술궂은 미소를 짓는 토키코를 향해 %조사처리(CALLNAME:MASTER,"의")% 얼굴은 홍조를 띤다.
				PRINTFORMW 「%CALLNAME:MASTER%부끄러? 후후, 부끄럽다는 생각 할 겨를 없이 난 완전히 망쳐줄게%UNICODE(0x2764)%」
				PRINTFORMW 토키코의 혀는 더욱 민감한 부분을 자극하듯 움직여간다.
			CASE 3
				PRINTFORMW 「참지 않아도 괜찮단 말이야……?」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 토키코에게 은밀한 곳을 농락당하고 있다.
				PRINTFORMW 「기분 좋으면 제대로 말해줘야 해……%UNICODE(0x2764)%」
				PRINTFORMW 토키코의 혀가 민감한 부위에 닿자 무심코 %조사처리(CALLNAME:MASTER,"는")% 신음을 흘린다.
				PRINTFORMW 「그래, 그래 그 느낌 그대로야%UNICODE(0x2764)% 아무 생각도 못 하게 해줄게%UNICODE(0x2764)%」
				PRINTFORMW 그 틈을 놓치지 않고 더욱 격렬해지는 군니를 앞에 %조사처리(CALLNAME:MASTER,"의")% 목소리는 점점 커져 간다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;121,貝あわせ
;==================================================

@M_KOJO_MESSAGE_COM_K101_121
CALL M_KOJO_MESSAGE_COM_K101_121_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_121_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「엣? 좀 더 천천히 해줬으면 좋겠어?」
			PRINTFORMW 「음…… 안 돼%UNICODE(0x2764)% %조사처리(CALLNAME:MASTER,"가")% 흐트러지는 모습, 더 보여줘♪」
			PRINTFORMW 「응읏%UNICODE(0x2764)% %CALLNAME:MASTER%……귀여워%UNICODE(0x2764)%」
			PRINTFORMW 토키코는 %CALLNAME:MASTER%위에 덮치면서 서로의 은핵을 비비고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응앗! %UNICODE(0x2764)% 몸을 떨고 있어서 귀엽네…… %UNICODE(0x2764)%」
			PRINTFORMW 「더욱…… 격렬하게 해줄게…… 응아앗! %UNICODE(0x2764)%」
			PRINTFORMW 「%CALLNAME:MASTER%읏! %UNICODE(0x2764)% %CALLNAME:MASTER%읏! %UNICODE(0x2764)%」
			PRINTFORMW 토키코는 쾌감에 견디지 못하고 고개를 저으며 몸을 움직이고 있는 %조사처리(CALLNAME:MASTER,"에게")% 신경 쓰지 않고, 몸을 움직이고 있다.
		ELSE
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")%…… 기분 좋아?」
			PRINTFORMW 「에헤헤, 얼굴도 그곳도 녹아내리네♪」
			PRINTFORMW 「함께…… 더……. %UNICODE(0x2764)% 응아아아앗%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
			PRINTFORMW 토키코와 %조사처리(CALLNAME:MASTER,"는")% 함께 쾌감의 바다에 잠겨 있다.
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응응읏%UNICODE(0x2764)%……조금만 더 빨리 움직여 봐……」
			PRINTFORMW 「있잖아, %조사처리(CALLNAME:MASTER,"는")% 움직이지 마아앗%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
			PRINTFORMW 「헉, 아아아악%UNICODE(0x2764)%%UNICODE(0x2764)%」
			PRINTFORMW 토키코는 %조사처리(CALLNAME:MASTER,"의")% 움직임에 지배당하고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「힉, 아아아악%UNICODE(0x2764)%」
			PRINTFORMW 「잠깐!? 더, 조금만 천천히……응우웅%UNICODE(0x2764)%」
			PRINTFORMW 토키코의 제지를 듣지 않고 %조사처리(CALLNAME:MASTER,"는")% 몸을 맞대어 나아간다.
			PRINTFORMW 「하아…%UNICODE(0x2764)% 하아…%UNICODE(0x2764)% 정말 자비가 없잖아……%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「앗, 음! 굉장해......」
			PRINTFORMW 토키코는 %조사처리(CALLNAME:MASTER,"와")% 부딪히며 느껴지는 은밀한 감각에 몸을 맡기고 있다.
			PRINTFORMW 「더, 더 격렬하게 움직여도 괜찮아...?」
		ENDIF
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
