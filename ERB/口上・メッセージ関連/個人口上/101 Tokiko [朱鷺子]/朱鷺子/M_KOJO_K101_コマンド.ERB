;==================================================
;126,乳の揉み合い
;==================================================

@M_KOJO_MESSAGE_COM_K101_126
CALL M_KOJO_MESSAGE_COM_K101_126_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_126_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「내 가슴 별로 크지 않은데… 라는 말도 안 듣고 만져오다니… 응윽%UNICODE(0x2764)%」
				PRINTFORMW 「……앗%UNICODE(0x2764)% 이, 이걸 돌려줄 거야!」
				PRINTFORMW 「응응%UNICODE(0x2764)%%조사처리(CALLNAME:MASTER,"의")% 유두가 단단해지고 있어… 흥분하고 있네」
				PRINTFORMW 「응 아앗%UNICODE(0x2764)%… 같이 더 하자%UNICODE(0x2764)%」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 토키코는 서로의 가슴을 주무르며 숨을 거칠게 몰아쉬고 있다.
			CASE 1
				PRINTFORMW 「응응...%UNICODE(0x2764)% 벌써 내 가슴 만지고 있잖아♪」
				PRINTFORMW 「앗! %UNICODE(0x2764)% 나도 주물러 줄 거야!」
				PRINTFORMW 「어라? 유두 딱딱하게 만들었네%UNICODE(0x2764)% 기대하고 있는 걸까?」
				PRINTFORMW 「응응%UNICODE(0x2764)% 좋아, 기대대로 기분 좋게 해줄게%UNICODE(0x2764)%」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 가슴에 토키코의 가는 팔이 뻗는다.
			CASE 2
				PRINTFORMW 「내가 가슴 약한 거 알고 하고 있는 거잖아!」
				PRINTFORMW 「응앗%UNICODE(0x2764)% 이렇게 된 거 %조사처리(CALLNAME:MASTER,"는")% 것도 민감하게 해줄 테니까!」
				PRINTFORMW 「라고 내 건 만지지 마아%UNICODE(0x2764)%%UNICODE(0x2764)% 우우, 각오해라!」
				PRINTFORMW 토키코와 %조사처리(CALLNAME:MASTER,"는")% 서로의 가슴을 주무르며 맞섰다.
		ENDSELECT
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「앗, 고동이 점점 빨라지고 있어... 흥분하고 있네」
		PRINTFORMW 「뭐 나도 마찬가지지만... 응! 아, 갑자기 만려해!」
		PRINTFORMW 「정말이지, 내가 가슴 약한 거 알고 이러는 거지!」
		PRINTFORMW 토키코와 %조사처리(CALLNAME:MASTER,"는")% 서로의 가슴을 주무르며 애틋하게 있다
		RETURN 1
