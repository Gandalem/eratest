@M_KOJO_MESSAGE_SCOM_K101_1
CALL M_KOJO_MESSAGE_SCOM_K101_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K101_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「이런 것도 있는 거네……응! %UNICODE(0x2764)%도, 나도... 응윽」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「누가 먼저 갈지 내기 안 할래?」
		PRINTFORMW 「라니, 플랭킹은 반칙이야! 응응읏%UNICODE(0x2764)%... 이제 용서 못 해! 화으윽... 읍」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「응 아앗%UNICODE(0x2764)%… 지지 않을 거야…… %CALLNAME:MASTER%도 기분 좋아졌으면 좋겠으니까…」
		PRINTFORMW 「응 응앗%UNICODE(0x2764)%… 으윽… 응 아앗%UNICODE(0x2764)%」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「저기…… 좀 하기 힘들다구……. 읍!」
		RETURN 1
	ENDIF
ENDIF
