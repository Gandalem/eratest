@M_KOJO_MESSAGE_COM_K101_80
CALL M_KOJO_MESSAGE_COM_K101_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 토키코의 손에 음경을 잡게 했다.
			PRINTFORMW 저항하지 않는 부드러운 손을 움직여 나간다……
			PRINTFORMW 표정 변화 없이 봉사하는 모습이 된 토키코를 보며 %조사처리(CALLNAME:MASTER,"는")% 더욱 흥분해 간다
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 토키코의 손에 음경을 쥐여주었다.
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「응? 나올 것 같아?」
			PRINTFORMW 그렇게 말하자 토키코는 더욱 격렬하게 몸을 움직이기 시작했다.
			PRINTFORMW 「대단하네, 벌벌 떨고 있어」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「음… 커지고 있네, 흥분하고 있었구나」
			PRINTFORMW 그렇게 말하자 토키코는 더욱 거칠게 몰아붙이기 시작했다.
			PRINTFORMW 「어서 가버리렴」
		ELSE
			PRINTFORMW 「슬슬 싸줄까~」
			PRINTFORMW 그렇게 말하자 토키코는 더욱 격렬하게 몰아붙였다.
			PRINTFORMW 「많이 해줘, %UNICODE(0x2764)%」
		ENDIF
		;恋人
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「후훗, 귀여운 %UNICODE(0x2764)%」
				PRINTFORMDW 토키코는 애틋하게 %조사처리(CALLNAME:MASTER,"의")% 성기를 쥐고 있다.
				PRINTFORMW 「후훗, 망설이지 않고 내보내도 괜찮아?」
				PRINTFORMDW 토키코는 히죽거리며 장난스럽게 웃어 보이고 있다.
			CASE 1
				PRINTFORMW 「아, 단단해졌다! 기분 좋은 거네」
				PRINTFORMW 「지금은 자비 없으니까, 언제나 당하고 싶어 하니까 말이야!」
				PRINTFORMDW 토키코는 부드러운 손으로 페니스를 감싸고 있다
			CASE 2
				PRINTFORMW 「참지 말고 내줘? 자, 더 기분 좋아져 봐?」
				PRINTFORMDW 토키코는 상냥하면서도 격렬하게 애무하고 있다.
				PRINTFORMW 「견디지 말고 솔직해져야 해읏%UNICODE(0x2764)%」
				PRINTFORMDW 토키코는 귓가에 속삭이며 견딜 수 없는 쾌감을 선사한다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「귀엽다…… 더 귀여워해 주겠다」
			PRINTFORMW 「어때? 기분 좋아?»」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「두껍고 단단해……」
			PRINTFORMW 「……하지만 자극하면 금방 나올 것 같아」
		ELSE
			PRINTFORMW 「만지는 거 기분 좋아?」
			PRINTFORMW 「더 격렬하게, 기분 좋게 해 줄게…%UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「응…… 기분 좋아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「별로 자신은 없는데……」
			PRINTFORMW 「잘 하고 있어?」
		ELSE
			PRINTFORMW 「많이……내도 괜찮아」
			PRINTFORMW 「더 기분 좋아져 봐……」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「으응, 역시 기분 나쁘네…」
			PRINTFORMW 「빨리 내놓을 뿐이야」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이런 거 잘 못하는데……」
			PRINTFORMW 「뭐, 이걸로 괜찮다면 할게……」
		ELSE
			PRINTFORMW 「아, 커졌네」
			PRINTFORMW 「이런 게 좋은 거야?」
		ENDIF
	ENDIF
ENDIF
RETURN 1
