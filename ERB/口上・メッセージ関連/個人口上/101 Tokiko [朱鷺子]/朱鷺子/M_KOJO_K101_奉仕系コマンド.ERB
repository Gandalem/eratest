@M_KOJO_MESSAGE_COM_K101_82
CALL M_KOJO_MESSAGE_COM_K101_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 얼어붙은 시간 속에서 토키코의 가슴을 범하기 시작했다.
		PRINTFORMW 평범한 가슴에 %조사처리(CALLNAME:MASTER,"는")% 페니스를 비벼 나간다.
		PRINTFORMW 상식적으로 생각하면 있을 수 없는 행동이지만, 시간이 멈춘 토키코는 일절 반응을 보이지 않는다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 토키코의 가슴을 범하기 시작했다.
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「후훗, 이게 좋다니 %조사처리(CALLNAME:MASTER,"가")% 참 변덕쟁이네에」
				PRINTFORMDW 토키코는 %조사처리(CALLNAME:MASTER,"가")% 자신의 가슴에 페니스를 비비고 있는 것을 보며 중얼거린다.
				PRINTFORMW 「뭐 기뻐해 준다면 나도 기쁘지만 말이야」
			CASE 1
				PRINTFORMW 「자, %조사처리(CALLNAME:MASTER,"가")% 좋아하는 내 가슴이야%UNICODE(0x2764)%」
				PRINTFORMW 「……일단 조금은 부풀어 있긴 하니까 파이즈리 할 정도의 크기는 아니지만」
				PRINTFORMW 「아니, 사실 크기 같은 건 아무래도 상관없어. 오히려 %조사처리(CALLNAME:MASTER,"가")% 기뻐해 준다면 이 크기로 괜찮다고 생각할 거야」
				PRINTFORMDW 토키코는 육봉에게 범해지는 자신의 가슴을 보며 중얼거렸다
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%……%UNICODE(0x2764)% 나의 몸을 하얗게 물들여도 괜찮은 거야?」
				PRINTFORMDW 토키코는 요염하게 미소 지으며 가슴을 내밀고 있다.
				PRINTFORMW 「자, 더 나의 가슴으로 기분 좋아지도록 해%UNICODE(0x2764)%!」
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「나의 가슴은 거의 없는 수준인데, 기분 좋아?」
			PRINTFORMW 「……그렇구나, 기분이 좋구나. 다행이다...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「비비기만 하는 걸 정말로 이걸로 괜찮은 거야?」
			PRINTFORMW 「...응? 오히려 가슴이 빈 것에서야 할 수 있는 게 이거 좋은 거야?... 바보...」
		ELSE
			PRINTFORMW 「...가슴으로?」
			PRINTFORMW 「기분 좋아? 다행이야...」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「앗……」
			PRINTFORMW 「…매끄럽고 기분 좋아? 그렇다면 다행이야」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……어때? 갈 것 같아?」
		ELSE
			PRINTFORMW 「윽…응…」
			PRINTFORMW 「가슴에 담아내라…!」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「이거 진짜 기분 좋아?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏……」
			PRINTFORMW 「……빨리 싸줘」
		ELSE
			PRINTFORMW 「……인간이란 참 모르겠어……」
			PRINTFORMW 「스스로 말하기 민망하지만, 판에 비비고 있는 거나 마찬가지야, 이건」
		ENDIF
	ENDIF
ENDIF
RETURN 1
