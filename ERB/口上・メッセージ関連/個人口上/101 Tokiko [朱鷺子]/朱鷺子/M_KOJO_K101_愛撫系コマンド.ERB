@M_KOJO_MESSAGE_COM_K101_0
CALL M_KOJO_MESSAGE_COM_K101_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 멈춰 선 시간 속에서 토키코가 주장하는 한 부위를 주무르기 시작한다.
		PRINTFORMW 자극을 가하자 몸이 파르르 떨리며 절정감이 새어 나오지만 본인은 그대로의 자세로 저항하지 않는다.
		PRINTFORMW 그럼에도 불구하고, 더 만져주길 바라는 듯 단단해지는 페니스에 더욱 자극을 가한다……
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「더는 참을 수 없어…… 어서 만져줘……… 응아%UNICODE(0x2764)%」 
					PRINTFORMW 토키코는 더는 참지 못하고 내밀고 있다.
				CASE 0
					PRINTFORMW 「흐, 아……%UNICODE(0x2764)% 굉장해…… 응아아%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 민감한 페니스를 만지며 허리가 부서질 듯하다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「응읏%UNICODE(0x2764)% 크, 으음…… 잘하네……ッ%UNICODE(0x2764)%」
					PRINTFORMW 「앗%UNICODE(0x2764)% 그렇게 움직이면…… 나와버릴 것 같아ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 사정감을 간신히 참으려 노력하고 있다.
				CASE 0
					PRINTFORMW 「히, 아%UNICODE(0x2764)% 응응……%UNICODE(0x2764)%」
					PRINTFORMW 「그런……이런 건……안 돼읏%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 %조사처리(CALLNAME:MASTER,"의")% 손길에 떨고 있다.
					RETURN 1
			ENDSELECT
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「응읏%UNICODE(0x2764)% 히, 아으……%UNICODE(0x2764)%」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「응읏%UNICODE(0x2764)% 히, 아으……%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
