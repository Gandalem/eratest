@M_KOJO_MESSAGE_COM_K101_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:Ｃ絶頂
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 세계에서 미동조차 없는 토키코의 클리토리스를 혀로 애무한다.
		PRINTFORMW 점점 애액이 틈새로 흘러넘치지만 아랑곳하지 않고 클리토리스를 계속 자극하고 있다.
		PRINTFORMW 강렬한 자극을 받으면서 홍수처럼 토키코는 애액을 사방에 뿌리고 있다.
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「흐아아앗%UNICODE(0x2764)%」
					PRINTFORMW 「더!! %UNICODE(0x2764)% 더해줘…… %UNICODE(0x2764)%」 
					PRINTFORMW 토키코는 망설임 없이 자신의 욕망을 마음껏 허리를 밀어붙이고 있다
				CASE 0
					PRINTFORMW 「흐, 으……%UNICODE(0x2764)% 굉장해…… 응아아%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 은밀한 곳을 핥는 쾌감에 사로잡혀 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「앗%UNICODE(0x2764)% 히, 응……%UNICODE(0x2764)%」
					PRINTFORMW 「거기 핥아주면……. 음, 으으……%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 허리를 가끔 들썩이고 있다.
				CASE 1
					PRINTFORMW 「응읏%UNICODE(0x2764)%…아앗%UNICODE(0x2764)% 거기……응응읏%UNICODE(0x2764)%」
					PRINTFORMW 「…더……%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 스스로 허리를 밀어붙였다.
				CASE 2
					PRINTFORMW 「히, 아아………응응읏%UNICODE(0x2764)%」
					PRINTFORMDW 혀로 음핵을 쓸자 그에 맞춰 토키코의 몸이 흔들린다.
					PRINTFORMW 「거기……안돼읏%UNICODE(0x2764)% 히우옷%UNICODE(0x2764)%」
				CASE 3
					PRINTFORMW 「아……히, 아……응읏%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 몸을 작게 떨었다.
					PRINTFORMW 「앗…… 핥지 마! %UNICODE(0x2764)% 응읏%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「흐아아앗%UNICODE(0x2764)%」
					PRINTFORMW 「더!! %UNICODE(0x2764)% 더해줘…… %UNICODE(0x2764)%」 
					PRINTFORMW 토키코는 망설임 없이 자신의 욕망을 마음껏 허리를 밀어붙이고 있다
				CASE 0
					PRINTFORMW 「흐, 으……%UNICODE(0x2764)% 굉장해…… 응아아%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 은밀한 곳을 핥는 쾌감에 사로잡혀 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「응응읏%UNICODE(0x2764)%」
					PRINTFORMW 「잘하네…… %CALLNAME:MASTER%」
				CASE 1
					PRINTFORMW 「응읏%UNICODE(0x2764)%…아앗%UNICODE(0x2764)% 거기……응응읏%UNICODE(0x2764)%」
					PRINTFORMW 「…더……%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 스스로 허리를 밀어붙였다.
				CASE 2
					PRINTFORMW 「히, 아아………응응읏%UNICODE(0x2764)%」
					PRINTFORMDW 혀로 음핵을 쓸자 그에 맞춰 토키코의 몸이 흔들린다.
					PRINTFORMW 「거기……안돼읏%UNICODE(0x2764)% 히우옷%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「앗%UNICODE(0x2764)%응읏%UNICODE(0x2764)%」
		PRINTFORMW 「기분 좋았어」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「응읏%UNICODE(0x2764)%…후훗%UNICODE(0x2764)%」
		PRINTFORMW 토키코는 음핵을 자극받아 몸을 떨고 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
