;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K101_140
CALL M_KOJO_MESSAGE_COM_K101_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「응으으읍!? 응읏~~~~」
		PRINTFORMW 토키코는 괴로운 듯 %조사처리(CALLNAME:MASTER,"의")% 성기를 물고 있다.
		RETURN 1
		;基本セット
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 1
				PRINTFORMW 「응으읍~~~~~……응응읏…푸하앗…컥퉤」
				PRINTFORMW 토키코는 눈물 가득한 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
			CASE 0
				PRINTFORMW 「응!? ~~~~~~읏!!!」
				PRINTFORMW 토키코는 갑자기 입안에 들어온 단단한 것에 눈을 크게 뜨고 있다.
		ENDSELECT
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「흐윽… 으응… 응~~~~~」
		PRINTFORMW 토키코는 괴로워하면서도 어떻게든 %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해주려고 하고 있다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「으응으응으~~」
		PRINTFORMW 「콜록콜록헉…… 너무하잖아...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
