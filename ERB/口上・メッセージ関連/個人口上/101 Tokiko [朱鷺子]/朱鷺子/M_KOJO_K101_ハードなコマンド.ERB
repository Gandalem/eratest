;141,フィストファック
;==================================================

@M_KOJO_MESSAGE_COM_K101_141
CALL M_KOJO_MESSAGE_COM_K101_141_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_141_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「저기, 무슨 생각 하는 거야!? 정말 멈춰줘... 죽을 것 같아... 아앗?! 아아아아아아악!!!」
		PRINTFORMW 토키코는 너무나 큰 고통에 절규하고 있다.
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「역시……아아아아아악!!!…우으윽… 역시 멈춰줄 리가 없겠네……」
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「... %조사처리(CALLNAME:MASTER,"가")% 하고 싶다면…… 응윽!? 우와아아아앙!」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「야, 그만해…… 우아아아아악!!!」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
