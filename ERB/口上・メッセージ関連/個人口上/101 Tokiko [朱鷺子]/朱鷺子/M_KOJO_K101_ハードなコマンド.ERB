;==================================================
;144,放尿
;==================================================

@M_KOJO_MESSAGE_COM_K101_144
CALL M_KOJO_MESSAGE_COM_K101_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「앗…… 그만해! 보지 마아! 부끄러워……」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 방뇨 장면을 자세히 보여진 토키코는 손으로 얼굴을 가리고 있다.
		RETURN 1
	ENDIF
	;基本セット
	;恋人
	IF TALENT:恋人
		PRINTFORMW 「우으~…… %조사처리(CALLNAME:MASTER,"는")% 정말 심술쟁이잖아………」
		PRINTFORMDW 토키코는 아랫배를 누르면서도 몸을 꿈틀거리고 있다.
		PRINTFORMW 「최대한 참으라고 해도, 한계라는 게……앗, 안 돼!? 벌써…… 나와버릴 것 같아...!」
		PRINTFORMW 「파아아아아……… 멈출 수가 없어………」
		PRINTFORMDW 토키코는 소변 욕구로부터의 해방 때문인지, 아니면 배뇨당하고 있는 것 때문인지, 황홀한 표정으로 요도에서 흘러넘치는 아치를 바라보고 있다.
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「아... 멈추지 않아... 역시 부끄럽네...」
		PRINTFORMW 토키코에게서 나오는 포물선을 자세히 바라보았다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「응응... 내 소변 봐줘... %UNICODE(0x2764)%」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「싫어! 보지 마아아!!」
		PRINTFORMW 아무리 싫다고 해도, 그 아치는 멈추지 않는다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
