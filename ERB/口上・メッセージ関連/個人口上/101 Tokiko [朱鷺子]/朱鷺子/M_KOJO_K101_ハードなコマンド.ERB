;146,浣腸器＋プラグ
;==================================================

@M_KOJO_MESSAGE_COM_K101_146
CALL M_KOJO_MESSAGE_COM_K101_146_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_146_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「에엣…… 코, 이거 뭐야……」
		PRINTFORMW 굳어 있는 토키코에게 관장을 삽입했다.
		RETURN 1
	ENDIF
	;基本セット
	;浣腸液注入
	IF TEQUIP:浣腸
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「앗%UNICODE(0x2764)%…응응읏……엄청나아……」
			PRINTFORMW 토키코는 장으로 액체가 흘러들어 오는 감각에 떨고 있다.
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「오옷%UNICODE(0x2764)%… 으, 빙글빙글…… 해애……」
			PRINTFORMW 토키코는 관장을 당한 것에 흥분하고 있는 듯하다.
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「하, 부끄러워…… 우욱…」
			RETURN 1
		ENDIF
		;解除
	ELSE
		PRINTFORMW 「응윽…… 하아앗%UNICODE(0x2764)%……!」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
