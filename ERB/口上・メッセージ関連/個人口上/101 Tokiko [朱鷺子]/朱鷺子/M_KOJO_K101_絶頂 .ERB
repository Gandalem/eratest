RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K101_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTL
		PRINTFORMW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 기분 좋은 토키코의 질 안에 정액을 쏟아냈다.
		PRINTFORMW 자궁을 정액으로 물들이는 쾌감에 취해 있다
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응응... 배가 따뜻해……」
			RETURN 1
			IF RAND:2 == 0
				PRINTFORMW 「이제 정말 많이 내줬네……」
				PRINTFORMW 
				PRINTFORMW 「더 흘려도 괜찮아?」
				RETURN 1
			ELSE
				PRINTFORMW 「기분 좋았어? 더 내봐……」
				RETURN 1
			ENDIF
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응!앗%UNICODE(0x2764)%」
			PRINTFORMW 「내버려 두면 안 되겠지?♪」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…！」
			PRINTFORMW 「아직 더 나올 수 있어?」
			RETURN 1
		ELSE
			PRINTFORMW 「후훗 배가 두근두근거려~」
			RETURN 1
		ENDIF
	ENDIF
	IF RAND:3 == 0
		PRINTFORMW 「앗... 싸버린 거야...?」
		PRINTFORMW 「이제, 조심해 두렴.」
		RETURN 1
	ELSEIF RAND:2 == 0
		PRINTFORMW 「응읍!?」
		PRINTFORMW 「이거 괜찮을까……?」
		RETURN 1
	ELSE
		PRINTFORMW 「그만! 너무 많이 내보냈잖아!」
		PRINTFORMW 「다음엔 더 잘 생각해 줘」
	ENDIF
ENDIF
RETURN 1
