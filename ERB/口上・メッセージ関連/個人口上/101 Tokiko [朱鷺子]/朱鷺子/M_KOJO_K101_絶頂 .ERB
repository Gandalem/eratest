RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K101_2(ARG)
;-------------------------------------------------
;アナル
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTL
		PRINTFORMW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 상태 좋은 토키코의 항문에 정액을 쏟아냈다.
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「응응읏%UNICODE(0x2764)%… 전 쪽은 괜찮아……?」
			RETURN 1
			IF RAND:2 == 0
				PRINTFORMW 「한 잔 내줬네…… 후폭풍이 꽤 심하단 말이야」
				PRINTFORMW 
				PRINTFORMW 「…… %조사처리(CALLNAME:MASTER,"가")% 뒤쪽을 좋아한다면 참해 주겠지만」
				RETURN 1
			ELSE
				PRINTFORMW 「후훗 기분 좋았어?」
				RETURN 1
			ENDIF
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「엉덩이 구멍으로 임신해버릴 것 같아~♪」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「…！」
			PRINTFORMW 「따뜻해……」
			RETURN 1
		ELSE
			PRINTFORMW 「한 잔 나왔는데…… 그렇게 좋았어?」
			RETURN 1
		ENDIF
	ENDIF
	IF RAND:3 == 0
		PRINTFORMW 「거기 쪽을 좋아하다니 이상한걸……」
		RETURN 1
	ELSEIF RAND:2 == 0
		PRINTFORMW 「거긴 임신 안 하니까 너무 많이 내뱉지 마!」
		RETURN 1
	ELSE
		PRINTFORMW 「많이 나오고 있어……」
	ENDIF
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

