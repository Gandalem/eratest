;手淫
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 %조사처리(CALLNAME:MASTER,"는")% 토키코의 손 안에서 사정했다.
	ELSEIF TALENT:MASTER:濃厚精液
		IF RAND:3 == 0
			PRINTFORMW 「...나, 뭐야 이거...」
			PRINTFORMW 「쉽게 얻어지지 않는다...」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「엄청 진한 게 나왔네……」
			RETURN 1
		ELSE
			PRINTFORMW 「끈적끈적하네……」
			PRINTFORMW 「기분 좋았으면 됐지만…… 곤란해졌잖아……」
			RETURN 1
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「앗! 굉장한 기세…… 그렇게 기분 좋았구나……」
			RETURN 1
		ELSEIF RAND:2 == 0
			PRINTFORMW 「자, 내보내 봐!」
			PRINTFORMW 「한 잔 나왔네, 내 손에도 흥건하게 묻어버렸어」
			RETURN 1
		ELSE
			PRINTFORMW 「기분 좋았어? 한 번 더 할래?」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
