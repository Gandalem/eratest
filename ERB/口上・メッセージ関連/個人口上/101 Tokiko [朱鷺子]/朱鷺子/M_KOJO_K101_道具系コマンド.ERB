@M_KOJO_MESSAGE_COM_K101_44
CALL M_KOJO_MESSAGE_COM_K101_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:破瓜 == 1
			PRINTFORMW 「으음... 모처럼이라면 도구가 아닌 게 좋았을 텐데……」
			RETURN 1
		ELSE
			PRINTFORMW 「이거 뭐야... 엄청 진동하고 있는데... 에엣!? 그거 넣는 거야?」
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 바이브는 토키코의 질 안에서 계속 진동하고 있다.
			PRINTFORMW 당연히 반응은 없지만, 점차 물소리가 커져 간다……
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 주변에 흩뿌려진 토키코의 애액을 보며, 해제 후의 반응이 기대되었다.
			RETURN 1
			;恋人
		ELSEIF TALENT:恋人
			IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「야아…… 응응읏%UNICODE(0x2764)% 아, 푸아아아악! %UNICODE(0x2764)%%UNICODE(0x2764)%」 
						PRINTFORMW 토키코는 이성을 잃고 자신의 은밀한 곳에 삽입된 바이브를 응시하고 있다.
					CASE 0
						PRINTFORMW 「아앗%UNICODE(0x2764)% 히, 아아아아아아아악%UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORMW 강렬한 쾌감에 소리를 지르는 것 외에는 할 수 없다
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「히아아아악%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)% 저, 전부 다……윽%UNICODE(0x2764)%」
						PRINTFORMDW 토키코는 질구에 딱 맞게 박힌 바이브를 보고 눈을 크게 뜨고 있다.
						PRINTFORMW 「이, 이거 위험해……. 으히이이이악%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
					CASE 1
						PRINTFORMW 「아, 히으…… 응아……… 후, 아…%UNICODE(0x2764)%」
						PRINTFORMW 「앙! %UNICODE(0x2764)% 음음ッ%UNICODE(0x2764)%」
						PRINTFORMDW 토키코는 주어지는 쾌감을 만끽하고 있다.
					CASE 2
						PRINTFORMW 「크, 히이이이잇%UNICODE(0x2764)% 안 돼, 흔들지 말아 줘…… 아앗%UNICODE(0x2764)%」
						PRINTFORMW 「응응, 응응응응응응ッッ%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORMDW 토키코는 허리를 들고 느끼고 있다.
				ENDSELECT
			ENDIF
			;恋慕
		ELSEIF TALENT:恋慕
			IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMW 「야아…… 응응읏%UNICODE(0x2764)% 아, 푸아아아악! %UNICODE(0x2764)%%UNICODE(0x2764)%」 
						PRINTFORMW 토키코는 이성을 잃고 자신의 은밀한 곳에 삽입된 바이브를 응시하고 있다.
					CASE 0
						PRINTFORMW 「아앗%UNICODE(0x2764)% 히, 아아아아아아아악%UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORMW 강렬한 쾌감에 소리를 지르는 것 외에는 할 수 없다
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「아앗 %UNICODE(0x2764)% 굉장하다 %UNICODE(0x2764)% 심하게 흔들리고 있다 %UNICODE(0x2764)%」
					CASE 1
						PRINTFORMW 「응응읏%UNICODE(0x2764)%%UNICODE(0x2764)% 움직이지 말아줘…… 응아」
					CASE 2
						PRINTFORMW 「안 돼ッ%UNICODE(0x2764)% 아, 후우……%UNICODE(0x2764)% 음응읏%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
						RETURN 1
				ENDSELECT
			ENDIF
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 「응아앗 %UNICODE(0x2764)%더 휘저어줘 %UNICODE(0x2764)%」
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 「응응읏%UNICODE(0x2764)%」
			RETURN 1
		ENDIF
		;解除
	ELSE
		PRINTFORMW
	ENDIF
ENDIF
RETURN 1
