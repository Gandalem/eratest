@M_KOJO_MESSAGE_COM_K101_40
CALL M_KOJO_MESSAGE_COM_K101_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「뭐...? 이걸 거기로...?」
		PRINTFORMW 「앗! 응읏... 간지러워」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 로터의 진동으로 토키코의 클리토리스가 흔들린다.
		PRINTFORMW 토키코 자신의 표정은 변하지 않지만, 은밀한 곳은 점차 젖기 시작하며……
		PRINTFORMW 깨닫고 보니, 그녀의 발밑에는 작은 물웅덩이가 생겨 있었다.
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「ん읏%UNICODE(0x2764)% んぅ……이런 걸로는, 부족해……%UNICODE(0x2764)%」 
					PRINTFORMW 발정심에 찬 토키코는 로터로는 만족하지 못하는 듯하다.
				CASE 0
					PRINTFORMW 「흐으윽…… %UNICODE(0x2764)% 아, 응응읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 눈을 감고 진동이 주는 자극을 느끼고 있다.
					PRINTFORMW 「다음은 도구가 아니라 직접 만져줘…… %UNICODE(0x2764)%」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「흐, 으윽... 응! %UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 로터의 진동에 맞춰 자신도 모르게 신음이 새어 나온다.
					PRINTFORMW 「응... 음, 아앗, 응%UNICODE(0x2764)%」
				CASE 1
					PRINTFORMW 「얏%UNICODE(0x2764)% 부르르……응응읏%UNICODE(0x2764)%」
					PRINTFORMW 「하아… 하아……히으앗%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 뜨거운 숨을 내쉬며 쾌감을 받아들이고 있다.
				CASE 2
					PRINTFORMW 「파아앗%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)% 이거……응응읏%UNICODE(0x2764)%」
					PRINTFORMW 「흐윽, 히아……~~~~~ッ%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 눈을 감고 쾌감에 순응하고 있다.
				CASE 3
					PRINTFORMW 「이런 걸로…… 응읏%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 로터의 진동에 몸을 작게 흔든다
					PRINTFORMW 「앗, 더…… %UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「ん읏%UNICODE(0x2764)% んぅ……이런 걸로는, 부족해……%UNICODE(0x2764)%」 
					PRINTFORMW 발정심에 찬 토키코는 로터로는 만족하지 못하는 듯하다.
				CASE 0
					PRINTFORMW 「흐으윽…… %UNICODE(0x2764)% 아, 응응읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 눈을 감고 진동이 주는 자극을 느끼고 있다.
					PRINTFORMW 「다음은 도구가 아니라 직접 만져줘…… %UNICODE(0x2764)%」
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「…앗 %UNICODE(0x2764)% 그렇게 당하다니 %UNICODE(0x2764)% …응응읏 %UNICODE(0x2764)%」
				CASE 1
					PRINTFORMW 「히으읏%UNICODE(0x2764)% 이런 도구로…… 아앙!%UNICODE(0x2764)%」
				CASE 2
					PRINTFORMW 「떨리고 있어……읏%UNICODE(0x2764)% 응, 으응%UNICODE(0x2764)%」
					PRINTFORMW 「……～～～～～ッ%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
				CASE 3
					PRINTFORMW 「……읏%UNICODE(0x2764)% 응, 으……%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「응읏%UNICODE(0x2764)%…큭%UNICODE(0x2764)%…아아앗%UNICODE(0x2764)%」
		PRINTFORMW 「대단해… 클리 쪽이 짜릿짜릿해져 있어%UNICODE(0x2764)%…」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「응읏%UNICODE(0x2764)%…앗%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
