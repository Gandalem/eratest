			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「응응응응응읏%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 E 마사지기가 닿자 몸을 움찔 움직였다.
					PRINTFORMW 「하, 아…… 이거, 좋아……%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 황홀한 표정으로 달콤한 쾌락을 느끼고 있다.
				CASE 1
					PRINTFORMW 「응, 하아…… 아… %UNICODE(0x2764)%」
					PRINTFORMW 「더…… 더 해줘…… %UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 무의식적으로 허리를 밀어붙이고 있다.
				CASE 2
					PRINTFORMW 「대단해…… 이거, 좋아읏%UNICODE(0x2764)%」
					PRINTFORMW 「흐윽…… 히잉ッ%UNICODE(0x2764)% ～～～～ッ%UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMDW 토키코는 E 마사지기의 쾌감에 떨고 있다.
			ENDSELECT
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF TCVAR:媚薬 || TCVAR:発情 || CFLAG:TARGET:溜まってる度 > 850
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「아아앗%UNICODE(0x2764)%%UNICODE(0x2764)% 응응응으윽%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」 
					PRINTFORMW 토키코는 눈을 크게 뜨고 진동에 맞춰 몸을 떨고 있다.
				CASE 0
					PRINTFORMW 「아앗 %UNICODE(0x2764)% 이거 안 돼욧 %UNICODE(0x2764)%%UNICODE(0x2764)% ～～～～～～～읏%UNICODE(0x2764)%」
					PRINTFORMW 토키코는 E 마사지기를 바라보며 소리를 지르고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「응 아앗 %UNICODE(0x2764)% 응읏 %UNICODE(0x2764)%… 더 격렬하게 해도 괜찮아%UNICODE(0x2764)%」
				CASE 1
					PRINTFORMW 「응응읏%UNICODE(0x2764)% 이거 좋아읏%UNICODE(0x2764)% 흐, 아아아%UNICODE(0x2764)%」
				CASE 2
					PRINTFORMW 「히, 우으... %UNICODE(0x2764)% 안읏%UNICODE(0x2764)% 쿠... 아앗%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「안! %UNICODE(0x2764)%… 중독될 것 같아…%UNICODE(0x2764)%%UNICODE(0x2764)%」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「응읏%UNICODE(0x2764)%……앗%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
