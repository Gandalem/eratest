							PRINTFORMW 「의외로 한가하지 않아~」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 2
							PRINTFORMW 「……다음에도 또 와줘」
						CASE 1
							PRINTFORMW 「그렇다면 어쩔 수 없네……」
						CASE 0
							PRINTFORMW 「……바쁘면 어쩔 수 없지」
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
