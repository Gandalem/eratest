@M_KOJO_SPEVENT_K101_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「잠깐만, %CALLNAME:MASTER%」
		PRINTFORMW 토키코에게 불려 멈춘다. 그 눈은 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 똑바로 응시하고 있었다.
		PRINTFORMW 「요즘 가끔 가슴이 뜨거워질 때가 있어. 재미있는 책을 읽고 있을 때조차 비할 수 없을 정도로」
		PRINTFORMW 「그리고 가슴이 뜨거워지는 순간마다 항상 %조사처리(CALLNAME:MASTER,"의")% 얼굴이 떠올라」
		PRINTFORMW 「처음엔 몰랐어. 하지만 만날 때마다 스스로 깨닫게 되었지」
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 좋아한다는 걸」
		PRINTFORMW 바라보니 토키코의 얼굴이 붉게 물들어 간다. 그럼에도 그녀는 시선을 돌리지 않았다. 그리고 작게 숨을 고르고, 무언가 결심한 표정으로 다시 입을 열었다.
		PRINTFORMW 
		PRINTFORMW 「나랑…… 나랑 사귀어 주세요……!」
		PRINTFORMW 　
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 순간의 정적이 흐른 뒤, %조사처리(CALLNAME:MASTER,"는")% 자신의 마음을 토키코에게 전했다.
		PRINTFORMW 「에… 정말? 그, 정말 사귀어 줄 거야……?」
		PRINTFORMW 놀라 굳어 있는 토키코를 부드럽게 포옹했다.
		PRINTFORMW 「에헤헤…… 기뻐」
		PRINTFORMW 토키코는 눈에 눈물을 머금은 채, %조사처리(CALLNAME:MASTER,"의")% 품 안에서 미소 지었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……미안해, 갑자기 말하면 곤란하겠지」
		PRINTFORMW 토키코는 시선을 아래로 떨군 채, 언제 사라져도 이상하지 않을 듯한 목소리로 말했다.
		PRINTFORMW 「이상한 분위기 만들어서 미안해. 정말 미안해……」
		PRINTFORMW 토키코는 그렇게 말하고는 달려가 버렸다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K101_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「……그럼 안녕」
			PRINTFORMW 토키코는 그렇게 말하고 돌아갔다.
		ELSEIF TALENT:恋人
			SELECTCASE RAND:5
				CASE 4
					PRINTFORMW 「%CALLNAME:MASTER%, 또 데이트해요♪」
					PRINTFORMW 「그럼 이것으로 끝이라고 할까.」
				CASE 3
					PRINTFORMW 「오늘도 즐거웠다♪」
					PRINTFORMW 「그럼 오늘은 고마워」
				CASE 2
					PRINTFORMW 「역시 %조사처리(CALLNAME:MASTER,"와")% 놀면 즐겁네~」
					PRINTFORMW 「다음 데이트 기대하고 있을게」
				CASE 1
					PRINTFORMW 「오늘은 고마웠어, 정말 즐거웠어!」
					PRINTFORMW 「또 곧 데이트하러 가자♪」
				CASE 0
					PRINTFORMW 「아, 즐거웠어~♪」
					PRINTFORMW 「또 어디론가 가자」
					PRINTFORMW 토키코는 즐거운 듯 손을 흔들었다.
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「앗, 그…… 오늘은 고마웠다」
					PRINTFORMW 「즐거웠다」
				CASE 1
					PRINTFORMW 「음, 그게……. 즐거웠다」
					PRINTFORMW 「또 초대해 줘!」
				CASE 0
					PRINTFORMW 「다음엔 언제 데이트 신청해 줄 거야?」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「또 불러줘!」
				CASE 1
					PRINTFORMW 「오늘은 즐거웠어!」
				CASE 0
					PRINTFORMW 「즐거웠어. %CALLNAME:MASTER%」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「오늘은 고마웠어!」
				CASE 1
					PRINTFORMW 「오늘은 즐거웠어!」
				CASE 0
					PRINTFORMW 「오늘은 고마웠어, 다음에 또 불러줬으면 좋겠어」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW (…제대로 반성하고 있네. 나도 생각을 고쳐야겠어)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW (의외로 그런 면도 있는 거네……)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW (혹시 내가 생각하는 것보다는 나쁜 사람이 아닐까……?)
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K101_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;TARGETが入ってきた
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARG == 2
	PRINTFORML
	RETURN 1
ENDIF
;-------------------------------------------------
;TARGETが風呂に入ってきて一緒に入る
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 3
	IF TALENT:恋人
		PRINTFORMW 「같이 들어가도 돼?」
		PRINTFORMW 「자, 등을 돌려봐. 내가 씻겨 줄게」
	ELSEIF TALENT:恋慕
		PRINTFORMW 「저기…… 들어가도 돼?」
		PRINTFORMW 「음, 등 같은 거 씻어줬으면 해?」
	ELSEIF TALENT:思慕
		PRINTFORMW 「먼저 있었던 거야?」
		PRINTFORMW 「……이런 것도 나쁘지 않네」
	ELSE
		PRINTFORMW 「%CALLNAME:MASTER%, 같이 목욕해도 돼?」
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;TARGETが風呂に入ってきて出て行った
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 4
	IF TALENT:恋人
		PRINTFORMW 「미안, 방해됐어……?」
	ELSEIF TALENT:恋慕
		PRINTFORMW 「방해야……」
	ELSEIF TALENT:思慕
		PRINTFORMW 「먼저 있었어? 미안해」
	ELSE
		PRINTFORMW 「……방해했네」
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;TARGETが風呂に入ってきて追い出された
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 5
	IF TALENT:恋人
		PRINTFORMW 「우왓! 깜짝이야. ……저기…… 미안, 오늘은 그런 기분이 아니야」
	ELSEIF TALENT:恋慕
		PRINTFORMW 「앗! 깜짝이야!... 지금 내가 안에 있으니까 나중에 해줘」
	ELSEIF TALENT:思慕
		PRINTFORMW 「우와앗!…… 지금은 내가 안에 있으니까 나가줘」
	ELSE
		PRINTFORMW 「좀 나중에 해 줄 수 있어?」
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;外出先で遭遇した
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && GROUPMATCH(ARG, 1, 2, 6) ;edit
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일이야 이런 곳에서」
				PRINTFORMW 토키코가 기쁜 듯이 이쪽으로 다가왔다.
			CASE 1
				PRINTFORMW 「와아! %조사처리(CALLNAME:MASTER,"다")%!」
				PRINTFORMW 미소 짓는 토키코가 이쪽으로 다가왔다.
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%…♪」
				PRINTFORMW 토키코가 갑자기 거리를 좁혀왔다.	
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「설마 %조사처리(CALLNAME:MASTER,"를")% 만날 수 있을 줄은 몰랐네~」
			CASE 1
				PRINTFORMW 「앗, %CALLNAME:MASTER%……」
				PRINTFORMW 약간 토키코의 뺨이 붉어진 것 같았다.
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일로 이런 곳에 있나」
				PRINTFORMW 토키코가 이쪽으로 다가왔다.	
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「오옷, %CALLNAME:MASTER%~」
			CASE 1
				PRINTFORMW 「앗, %CALLNAME:MASTER%네」
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일이야 여기서」	
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「저기…… 무슨 용무니?」
			CASE 1
				PRINTFORMW (……어디선가 만난 건 기억나는데 이름이 뭐였더라………?)
			CASE 0
				PRINTFORMW 「왜 이 곳에서 이러고 있어」	
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
;-------------------------------------------------
;他キャラとデート中に遭遇した
;ARG:1にデート相手
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARG == 7
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%, 무슨 일이야――」
				PRINTFORMW 기뻐하며 다가왔던 토키코의 표정이 순식간에 굳는다.
				PRINTFORMW 「이번엔 나랑 안 하면 화낼 거야……」
