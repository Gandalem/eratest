		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 토키코를 속옷 차림으로 만들었다.
