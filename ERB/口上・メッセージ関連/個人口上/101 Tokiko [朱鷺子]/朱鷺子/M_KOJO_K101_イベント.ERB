							IF RAND:3 == 0
								PRINTFORMW 「좋아 줄게. 대신 바꿔 줄래?」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「……교환이라면…… 에? 뭘 쓰는 거야? 바, 바보! 뭐든지 상관없잖아!」
							ELSE
								PRINTFORMW 「갈 속옷에 %조사처리(CALLNAME:MASTER,"의")% 팬티 좀 줄래?」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「괜찮아. 자, 여기 있어」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「이걸로 괜찮을까?」
							ELSE
								PRINTFORMW 「뭐에 쓸지는 모르겠지만, 괜찮아」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「뭐에 쓰는 거야……?」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「음…… 음……. 뭐, 됐나」
							ELSE
								PRINTFORMW 「……이상한 일에는 쓰지 말아줘」
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF RAND:3 == 0
								PRINTFORMW 「헤, 변태! 변태! 변태! 무슨 생각 하는 거야아!」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「안 되게 정해져 있잖아!?」
							ELSE
								PRINTFORMW 「우와아……」
							ENDIF
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
