				IF FLAG:70
					;通常
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「이상한 기분이야……」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「뭐랄까…… 오히려 전부 벗는 것보다 부끄러운 기분이 드네……」
					ELSE
						PRINTFORMW 「반쪽만……?」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
