;100,スパンキング
;==================================================

@M_KOJO_MESSAGE_COM_K101_100
CALL M_KOJO_MESSAGE_COM_K101_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K101_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「아파읏! 우윽... 나 나쁜 거 했어?... 그렇게 때리지 마요...」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 얼어붙은 순간 속에서 토키코의 엉덩이를 때렸다.
		RETURN 1
		;マゾッ気4以上
	ELSEIF ABL:マゾっ気 >= 4
		SELECTCASE RAND:5
			CASE 4
				PRINTFORMW 「엉덩이 때리지 마아……%UNICODE(0x2764)% 이상한 기분 나니까……%UNICODE(0x2764)%」
				PRINTFORMW 「윽! %UNICODE(0x2764)% 음냐앗! %UNICODE(0x2764)% 아아우……. 하아, 하아」
				PRINTFORMW 「……가능하다면 여기서 경멸의 눈빛이라도 보내주면 기쁠 텐데……?」
				PRINTFORMW 바람대로 차가운 시선을 보내자 토키코는 더욱 흥분한 듯 계속 때려 달라고 조르기 시작했다.
			CASE 3
				PRINTFORMW 「벌이야읏%UNICODE(0x2764)% 벌이야읏%UNICODE(0x2764)% 더해줘읏%UNICODE(0x2764)% 더해줘읏%UNICODE(0x2764)%」
				PRINTFORMW 토키코는 새빨개진 엉덩이를 내밀고 있다.
			CASE 2
				PRINTFORMW 「앗%UNICODE(0x2764)% 응, 으응읏%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 「엉덩이 아픈데……%UNICODE(0x2764)% 기분 좋아용……%UNICODE(0x2764)%」
				PRINTFORMW 「벌써 이런 거 안 된다는 거 알고 있는데……히끅!? ～～～읏%UNICODE(0x2764)%%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 토키코는 엉덩이를 쓰다듬으며 흥분으로 몸을 미세하게 떨고 있다.
			CASE 1
				PRINTFORMW 「아, 아아앗%UNICODE(0x2764)%%UNICODE(0x2764)% 우, 우히이……」
				PRINTFORMW 「죄송해요… 죄송해요…… 엉덩이를 맞고 흥분하는 변태라서……%UNICODE(0x2764)%」
				PRINTFORMW 「그러니까 더 때려줘……%UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 토키코는 혀를 늘어뜨린 채 붉게 부어오른 엉덩이를 흔들고 있다.
			CASE 0
				PRINTFORMW 「아앙읏%UNICODE(0x2764)% 더! 세게욧!」
				PRINTFORMW 「아히이, 엉덩이, 더…… 나한테 벌을 줘요%UNICODE(0x2764)%」
				PRINTFORMW 토키코는 %조사처리(CALLNAME:MASTER,"에게")% 아첨하듯 애원하고 있다.
		ENDSELECT
		RETURN 1
		;マゾッ気2以上
	ELSEIF ABL:マゾっ気 >= 2
		SELECTCASE RAND:3 ;custom code
			CASE 2
				PRINTFORMW 「우으…… 이런 거……. 이런 거……. 음응읏%UNICODE(0x2764)%」
				PRINTFORMW 「아, 아플 뿐이야……. 아힉%UNICODE(0x2764)%」
			CASE 1
				PRINTFORMW 「우으…… 이런 건 아플 뿐이야…… 아플 뿐이라고……」
				PRINTFORMW 토키코는 희미하게 느껴지기 시작한 쾌감을 부정하듯 계속 중얼거린다.
			CASE 0
				PRINTFORMW 「아파… 그렇게 세게… 응응읏%UNICODE(0x2764)%」
				PRINTFORMW (……이상해? 아프다고 해야 하는데……)
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 토키코의 비명 속에 다른 감정도 섞여 있었다는 것을 놓치지 않았다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 「아니, 찰싹거리지 마... 아파...」
		PRINTFORMW 「이제 좀 익숙해졌다고 해도, 그만해줘...」
		PRINTFORMW 토키코는 붉어진 엉덩이를 쓰다듬고 있다.
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 「...히익... 아파아...」
		PRINTFORMW 토키코는 고통을 참으며 버틴다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「너무해……. 아아앗… 으윽…」
		PRINTFORMW 토키코는 고통으로 눈시울이 붉어진 채 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
