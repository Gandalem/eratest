		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:アイマスク
		;時姦中
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
			;マゾッ気4以上
		ELSEIF ABL:マゾっ気 >= 4
			PRINTFORMW 「깜깜해……. 뭐 하는 거야……?」
			PRINTFORMW 토키코는 그렇게 말하면서 입꼬리를 올리고 거친 숨을 몰아쉬며 흥분하고 있다.
			RETURN 1
			;マゾッ気2以上
