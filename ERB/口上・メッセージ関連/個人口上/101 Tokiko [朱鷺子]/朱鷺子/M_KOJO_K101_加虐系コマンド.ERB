		PRINTFORMW 「음후~앗%UNICODE(0x2764)%음후~앗%UNICODE(0x2764)%」
		PRINTFORMW 토키코는 흥분해서 거친 숨을 몰아쉬며 자신을 향해 아첨하듯 바라본다.
		RETURN 1
		;マゾッ気2以上
	ELSEIF ABL:マゾっ気 >= 2
		PRINTFORMW 「응응읏……」
		PRINTFORMW 토키코는 숨쉬기 힘든 듯 얼굴을 붉히고 있지만, 그것만이 이유인 것 같지는 않다.
		;恋慕
		IF TALENT:恋慕
			RETURN 1
			;屈服3
		ELSEIF MARK:不埒刻印 == 3
			PRINTFORMW 
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;解除
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
