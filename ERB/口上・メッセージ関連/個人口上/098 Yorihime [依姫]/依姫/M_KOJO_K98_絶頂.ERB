@M_KOJO_MESSAGE_PALAMCNG_A_K98_1(ARG)
;-------------------------------------------------
;膣内
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTL 
	;膣技術３以上または恋人
	IF ABL:膣 >= 3 || TALENT:恋人
		;危険日生解禁済（妊娠中とピル服用時は非表示）
		IF CFLAG:生解禁 >= 2 && !TALENT:妊娠 && !TCVAR:ピル
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아...... 아......! HPH 자궁이...... 채워져버렸어......!」","L"
					CALL HPH_PRINT,@"(이것이라면... 분명... HPH)","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 조용히, 자신의 아랫배를 쓰다듬었다…….
				CASE 1
					CALL HPH_PRINT,@"「더…… 부어 주세요…… HPH」","L"
					CALL HPH_PRINT,@"「확실히…… 임신하도록…… HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 꽉 질을 조이며, 계속하라고 재촉하고 있다...
				CASE 2
					CALL HPH_PRINT,@"「아이... 가질 수 있을까요... HPH」","L"
					PRINTFORMDL 애틋하게 하복부를 쓰다듬는 %CALLNAME:TARGET%
					PRINTFORMDW 그녀와의 아이가 생기는 건 그리 멀지 않은 것 같았다
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하앗 HPH 하아아큿 HPH 사정... 질 안에... 윽 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 완전히 녹아내린 표정으로 자궁에 스며드는 정액의 열을 느끼고 있다.
					PRINTFORMDW 정액을 다 마시려는 듯 떨림을 반복하는 질의 감촉에, 당신은 황홀하게 내쉬는 숨결을 떨었다.
				CASE 1
					CALL HPH_PRINT,@"「흐으... 하아... 큭, 후우... 하아...」","L"
					PRINTFORMDL 사정이 가라앉고 절정의 파도가 잦아들어도 두 사람은 연결된 채로 있었다.
					PRINTFORMDW 계속 이렇게 있고 싶다. 그런 기분 좋은 감각이었다.
				CASE 2
					CALL HPH_PRINT,@"「――으, 굉장한 목소리였다고……HPH」","L"
					CALL HPH_PRINT,@"「그건... 말하지 말아주세요... HPH」","L"
					PRINTFORMDW 두 사람은 연결된 채, 잠시 여운에 잠겼다…….
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;危険日生解禁済（妊娠中とピル服用時は非表示）
		IF CFLAG:生解禁 >= 2 && !TALENT:妊娠 && !TCVAR:ピル
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 연결된 채로, 가능하다면 좋겠다고 귓가에 속삭였다.
					PRINTFORML 「……그렇네요」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 배를 쓰다듬어오는 당신의 손에, 자신의 손을 포갰다…….
				CASE 1
					PRINTFORML (정말로 해버릴지도……)
					PRINTFORML (……%조사처리(CALLNAME:MASTER,"와")%의, 아이……)
					PRINTFORMDW 아이를 가진 부푼 배를 상상하며, %조사처리(CALLNAME:TARGET,"는")% 가슴이 저릿하게 느껴졌다
				CASE 2
					CALL HPH_PRINT,@"「하아... 후우... 응, 하아... HPH」","L"
					PRINTFORMDL 두 사람은 말없이 이어진 채, 아이를 만든 여운에 몇 번이고 허리를 떨었다.
					PRINTFORMDW 그리고 어느 쪽에서인지 다시 허리를 흔들기 시작했다…….
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「안 된다고 했는데... 윽... 정말 질 안에 사정하다니... 윽」
					PRINTFORMDL 질 안에 쏟아져 들어오는 쾌감에 %조사처리(CALLNAME:TARGET,"는")% 허리를 움찔거리고 있다.
					PRINTFORMDW 가볍게 몸을 뒤로 빼자, 다 담기지 않았던 정액이 꿀꺽... 하고 결합부에서 흘러나왔다...
				CASE 1
					PRINTFORML 「――에? 아주 기분 좋아 보였다고...」
					PRINTFORML 「……윽, 그, 그럴 리가! ……없잖아요...」
					PRINTFORMDW 마지막 부분의 대사는 알아들을 수 없을 정도로 작은 목소리였다
				CASE 2
					PRINTFORML 「하아... 하아...윽」
					PRINTFORML 「끝인가요...?」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어깨로 크게 숨을 몰아쉬고 있다...
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
