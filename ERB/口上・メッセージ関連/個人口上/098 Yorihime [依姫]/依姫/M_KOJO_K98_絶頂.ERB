@M_KOJO_MESSAGE_PALAMCNG_A_K98_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;挿入時射精のみ表示
	IF TCVAR:MASTER:12 == 1 || TCVAR:MASTER:12 == 2
		PRINTL 
		;膣orアナル技術３以上または恋人
		IF ABL:膣 >= 3 || ABL:アナル >= 3 || TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「……별로 고무 없이도……」
					PRINTFORML 「아…… 아, 아무것도 아니에요……」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 고무에 모인 정액을 아쉬워하며 바라보고 있다……
				CASE 1
					PRINTFORMDL 질척하게 페니스를 빼낸다. 콘돔 끝에는 다량의 정액이 고여 있다.
					CALL HPH_PRINT,@"「하아... 하아... 큭, 하아... 큭」","L"
					PRINTFORMDW 당신은 고무를 빼자, 입을 막고 %조사처리(CALLNAME:TARGET,"의")% 아랫배에 툭 올려놓았다…
				CASE 2
					CALL HPH_PRINT,@"(이렇게……많은 정액……HPH)","L"
					CALL HPH_PRINT,@"(만약... 안에 사정되어 있다면... HPH)","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 풍부하게 정액이 고인 콘돔에서 눈을 떼지 못하는 것 같다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML (내 몸으로... 그렇게...)
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 고무를 매고 있는 당신을 말없이 바라보고 있다.
					PRINTFORMDW 시선에 눈치챈 당신이 얼굴을 돌리자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 얼굴을 돌렸다.
				CASE 1
					PRINTFORML (고무를 통해서라도... 이렇게 뜨겁다...)
					PRINTFORML (만약... 고무가 없었다면...)
					PRINTFORMDW 몸속에 더러움이 가득 찬다. 소름 끼쳐야 하는데, 몸은 그것을 원하는 것처럼 저릿했다
				CASE 2
					PRINTFORML 「보, 보여주지 말아 주세요…… 그런 것들……」
					PRINTFORMDL 그렇게 말해도 신경 쓰이는 건지, %조사처리(CALLNAME:TARGET,"는")% 침으로 가득 찬 콘돔을 자꾸 쳐다본다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 안쪽이 기분 좋았던 것도 있지만, 이렇게 사정하게 된 것은 자신도 놀랐다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
