	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 참지 못하게 된 당신은, %조사처리(CALLNAME:TARGET,"에게")% 애교를 부리며 그녀의 목덜미에 얼굴을 묻었다.
				PRINTFORML 「꺅!? 저기, 간지러워! 아하하♪」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 즐거운 듯 웃고 있다……
			CASE 1
				PRINTFORML 「――에, 냄새?」
				PRINTFORML 「혹시 저…… 냄새나요?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 킁킁거리며 자신의 몸을 냄새 맡고 있다.
			CASE 2
				PRINTFORML 「왠지 좋은 냄새가 납니다. 이건...」
				PRINTFORMDL 정말 좋은 냄새야. 마치 복숭아 같은...
				PRINTFORMW 「맞아요, 향긋한 숯불의 향기가... 에?」
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 좋은 냄새가 나는 것 같아서, %조사처리(CALLNAME:TARGET,"가")% 우물우물 무언가를 먹고 있었다.
				PRINTFORML 「이것입니까? 마침 저기에 포장마차가 있어서...」
				PRINTFORMDW 뭔가 치사하다. 너는 포장마차까지 달려가서, %조사처리(CALLNAME:TARGET,"와")% 똑같은 것을 주문했다.
			CASE 1
				PRINTFORML 「잠시만 기다려 주세요. 머리를 다시 묶어야 해요...」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 리본을 입에 물고 뒷머리를 모으고 있다
				PRINTFORMW 「기다리게 해서 죄송해요. ...? %CALLNAME:MASTER%?」
			CASE 2
				PRINTFORML 「――향수? 언니는 사용하고 있지만, 저는……」
				PRINTFORMDL 향수를 사용하지 않는데 이렇게 좋은 냄새가 나는 건가
				PRINTFORMDW 여자라는 것은 신비한 생명체다…….
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「후우……」
				PRINTFORMDL 옆을 걷는 %조사처리(CALLNAME:TARGET,"가")% 손으로 뒷머리를 쓸어 넘겼다.
				PRINTFORMDW 부드럽게, 달콤한 향기가 당신의 콧구멍을 간질였다.
			CASE 1
				PRINTFORML 「――좋은 냄새인가? 그건 무슨……」
				PRINTFORMDL 망했다. 무심코 생각한 것을 입 밖으로 내버리고 말았다
				PRINTFORMDW 당신은 황급히, 도시락에 관한 일이라고 둘러댔다
			CASE 2
				PRINTFORMDL 당신은 스윽 깊게 숨을 쉬고, %조사처리(CALLNAME:TARGET,"의")% 좋은 냄새를 폐 속에 담았다.
				PRINTFORML 「…………？」
				PRINTFORMDW 앞을 걷고 있던 %조사처리(CALLNAME:TARGET,"가")% 돌아본다. 당신은 휘파람을 불며 아무렇지 않은 바람인 척했다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
