@M_KOJO_MESSAGE_COUNTER_MESSAGECHECK_K98_1
;ラブホは地の文だけ表示
IF CFLAG:MASTER:現在位置 == 連れ込み宿 || CFLAG:MASTER:現在位置 == ラブホ
	RETURN 2
	;それ以外は普通に表示
ELSE
	RETURN 0
ENDIF

@M_KOJO_MESSAGE_COUNTER_K98_1
CALL M_KOJO_MESSAGE_COUNTER_K98_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COUNTER_K98_1_1
IF FLAG:デート相手 == [[依姫]]
	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「와줘서 다행이야. 당신도 같은 기분이라면 기쁠 거야」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 즐겁게 당신에게 웃어 보인다
				PRINTFORMDW 그녀도 오늘 데이트를 즐기고 있는 것 같다
			CASE 1
				PRINTFORML 「저기에 있는 건, 혹시……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 손을 잡고 여러 장소를 둘 뿐이다.
				PRINTFORMDW 연인다운 거리감으로, 두 사람은 데이트를 즐겼다.
			CASE 2
				PRINTFORML 「――왠지 거리가 가깝다고 생각하는 거야?」
				PRINTFORML 「연인 사이라면 당연하지 않나요?」
				PRINTFORMDW 무엇을 당연한 일이라고 생각했는지 %조사처리(CALLNAME:TARGET,"는")% 고개를 기울였다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 손을 잡지 않겠냐고 말을 걸었다.
				PRINTFORML 「그렇네요. 헤매지 않도록……」
				PRINTFORMDW 연인들의 손잡음은 아니었지만, 당신은 %조사처리(CALLNAME:TARGET,"와")% 손을 잡는 데 성공했다.
			CASE 1
				PRINTFORMDL 나란히 걸어가자, 지나가던 %TEXTR("사람/요괴/")%에게 커플로 오해받았다.
				PRINTFORML 「아니에요, 저희는...앗」
				PRINTFORMDW 굳이 부정할 필요도 없을 텐데. 그렇게 말하며 당신은 %조사처리(CALLNAME:TARGET,"의")% 손을 잡았다.
			CASE 2
				PRINTFORML 「――거리가 가깝다고? 당신을 지키기 위해서니까」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 너무 잘생긴 발언에 위태롭게 빠져들 것 같다
				PRINTFORMDW ……아니, 벌써 반해버린지도 모르겠다……
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아, 저런 곳에 고양이가 있네……」
				PRINTFORMDL '%CALLNAME:TARGET%'의 입에서 '고양이'라는 귀여운 단어가 나올 줄은 몰랐다
				PRINTFORMDW 나이에 걸맞다고 말할 수 있는지는 모르겠지만, %CALLNAME:TARGET%도 여자다운 면이 있는 것 같다
			CASE 1
				PRINTFORML (정말 잘 웃는 사람이네……)
				PRINTFORMDL 즐겁게 말하는 당신을 옆눈으로 보는 %CALLNAME:TARGET%
				PRINTFORMDW 자연스레, 그 거리도 가까워져 있었다
			CASE 2
				PRINTFORML 「함정이 있을지도 모릅니다. 발밑을 조심해 주세요」
				PRINTFORMDL 그런 게 있겠어
				PRINTFORMDW ……하지만, 절대 없다고 말할 수 없는 것이 환상향의 무서운 점이다
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
