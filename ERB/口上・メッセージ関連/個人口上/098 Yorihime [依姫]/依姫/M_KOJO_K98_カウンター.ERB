@M_KOJO_MESSAGE_COUNTER_K98_2_1
IF FLAG:デート相手 == [[依姫]]
	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 수줍어하는 %조사처리(CALLNAME:TARGET,"를")% 보고, 당신은 푸스스 웃고 말았다.
				PRINTFORML 「왜 웃으시는 거예요?」
				PRINTFORMDW 그것은, 수줍어하는 %조사처리(CALLNAME:TARGET,"가")% 아주아주 귀여워서이다.
			CASE 1
				PRINTFORML 「손을…… 잡지 않겠어요?」
				PRINTFORMDL 눈이 마주치자, %조사처리(CALLNAME:TARGET,"가")% 부끄러워하며 그렇게 말했다.
				PRINTFORMDW 당신이 손을 잡자, %조사처리(CALLNAME:TARGET,"는")% 단단하게 손가락을 얽어왔다.
			CASE 2
				PRINTFORML 「무슨 일이야?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 눈이 마주치자 그녀는 기쁜 듯 미소 지었다.
				PRINTFORMDW 『아무것도 아니야』 당신은 그렇게 말하고, %조사처리(CALLNAME:TARGET,"의")% 머리를 톡톡 쓰다듬었다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「――엿쨩 말인가요?」
				PRINTFORML 「아아, 네. 잘 먹겠습니다」
				PRINTFORMDW 눈이 마주쳤기에 당신은 %조사처리(CALLNAME:TARGET,"에게")% 엿을 주었다
			CASE 1
				PRINTFORML 「아, 그…… %CALLNAME:MASTER%?」
				PRINTFORMDL 수줍어하는 %조사처리(CALLNAME:TARGET,"가")% 귀여워서 당신은 무심코 %조사처리(CALLNAME:TARGET,"의")% 머리를 쓰다듬는다.
				PRINTFORMDW 톡톡, 톡톡 하고. 그렇게 하는 사이에 %조사처리(CALLNAME:TARGET,"는")% 부끄러움에 고개를 숙이고 말았다.
			CASE 2
				PRINTFORMDL 자꾸 %조사처리(CALLNAME:TARGET,"가")% 힐끔거리는 것이 보여, 너는 타이밍을 맞춰 번쩍 %CALLNAME:TARGET%쪽으로 고개를 돌렸다.
				PRINTFORML 「아, 어...!?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 매우 깜짝 놀라 있다...
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「앗……」
				PRINTFORMDL 슬쩍 %CALLNAME:TARGET%쪽을 보니 그녀와 완벽하게 눈이 마주쳤다.
				PRINTFORMDW 당신이 미소 짓자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 얼굴을 돌렸다……
			CASE 1
				PRINTFORML 「별로 보고 있었던 건……」
				PRINTFORMDL 들통날 거짓말이지만, 그걸로 얼버릴 수 있다고 생각하는 %조사처리(CALLNAME:TARGET,"가")% 귀엽다.
				PRINTFORMDW 그 후에도 가끔 %CALLNAME:TARGET%쪽에서 시선을 느꼈다.
			CASE 2
				PRINTFORML 「……윽」
				PRINTFORMDL 모처럼 눈이 마주쳤는데, %조사처리(CALLNAME:TARGET,"는")% 바로 시선을 돌려버렸다.
				PRINTFORMDW 뭐, 지금은 이 서투른 반응을 즐기도록 하지.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
