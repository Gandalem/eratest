		CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
		PRINTFORML 「헤……?」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 스커트 안에 손을 넣어 속옷 위로 부드럽게 은밀한 곳에 닿는다.
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 한순간 정지된 후, 살기 가득한 눈으로 당신의 뺨을 때렸다.
		BASE:MASTER:体力 -= 250
		;通常
	ELSE
		;発情顔絵を表示（オプションでオンにしていないと表示されない）
		CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
		;恋慕orＣ感覚が１０以上
		IF TALENT:恋慕 || ABL:Ｃ感覚 > 9
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「코, 이런 곳에서……윽 HPH」","L"
					PRINTFORMDL 그렇게 말하는 %조사처리(CALLNAME:TARGET,"지만")%, 만족한 건 아닌 것 같다.
					PRINTFORMDW 실제로 그녀는 넣어진 손을 거부하려 하지 않고 있다…….
				CASE 1
					CALL HPH_PRINT,@"「하아... 하아... 윽 HPH %CALLNAME:MASTER%... 윽 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 촉촉하게 빛나는 눈으로 이쪽을 바라본다.
					PRINTFORMDW 목덜미에 키스를 하자, 쭉 애액이 허벅지를 타고 흘러내렸다.
				CASE 2
					CALL HPH_PRINT,@"「――아앗 HPH」","L"
					PRINTFORMDL 꾸욱, %조사처리(CALLNAME:TARGET,"의")% 엉덩이에 단단한 것이 밀착되었다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 꿀꺽 침을 삼키더니, 당신의 것을 옷 위로 쓸어내렸다...
			ENDSELECT
			;思慕orＣ感覚が６以上
		ELSEIF TALENT:思慕 || ABL:Ｃ感覚 > 5
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 손을 움직이면서, %조사처리(CALLNAME:TARGET,"의")% 귓가에 『어때』라고 속삭였다.
					CALL HPH_PRINT,@"「――윽, 안 돼요... 기분 좋게 같은 건... 으흣」","L"
					PRINTFORMDW 나는 「어때」라고밖에 말하지 않았는데, %조사처리(CALLNAME:TARGET,"는")% 쉽게 자백해 주었다.
				CASE 1
					CALL HPH_PRINT,@"「음응! 흐으윽, 후우흐읍 응응!」","L"
					PRINTFORMDL 벽에 %조사처리(CALLNAME:TARGET,"를")% 밀어붙이고, 스커트 안으로 손을 집어넣는다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 소리가 새지 않도록 스스로 입을 막고 있다...
				CASE 2
					CALL HPH_PRINT,@"「그, 누가 오면 어떡하죠......큭」","L"
					PRINTFORMDL 「%조사처리(CALLNAME:TARGET,"를")% 사랑스럽게 만지고 있을 뿐이니까 아무 문제 없어」라고 당신은 말했다.
					CALL HPH_PRINT,@"「그런 건, 문제밖에 없는데... 아아흐햣 기다려줘... 흐윽」","W"
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「저, 잠깐만요... 멈춰주세요...!」
					PRINTFORMDL 치마 속으로 손을 넣자 %조사처리(CALLNAME:TARGET,"는")% 거부하듯 다리를 오므렸다.
					PRINTFORMDW 하지만 당신은 신경 쓰지 않고 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳 주변을 계속 쓸었다...
				CASE 1
					PRINTFORML 「――윽, 왜 싫다고 하는 거야……윽」
					PRINTFORML 「지난번엔 어쩔 수 없이 몸을 겹쳤을 뿐인데……응응」
					PRINTFORMDW 섹스는 OK지만 성희롱은 NG라니, 잘 모르는 아이네……
				CASE 2
					PRINTFORML 「――윽」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳을 가볍게 쓰자, 손끝에 미끈거리는 감촉이 있었다.
					PRINTFORMDW 당신은 일부러 그것을 지적하지 않고, %조사처리(CALLNAME:TARGET,"에게")% 애무를 이어갔다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
