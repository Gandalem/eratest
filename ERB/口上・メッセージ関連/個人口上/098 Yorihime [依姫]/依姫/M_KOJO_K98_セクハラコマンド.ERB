					PRINTFORML 「윽!!」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신에게서 떨어지자, 서둘러 옷의 흐트러짐을 정리했다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「흡, 부디 지금은……읏」
