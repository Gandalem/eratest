; Modular ERB: 個人口上/098 Yorihime [依姫]/依姫/M_KOJO_K98_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K98_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;初回
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「……그럼」
			PRINTFORML 「나도 달의 사자로서 최대한 아름답게……」
			PRINTFORMDW 요리히메는 칼을 뽑고, 느릿하게 당신을 향해 자세를 잡았다……
			;勝ったことがある
		ELSEIF CFLAG:[[依姫]]:弾幕勝負勝利 == 1
			PRINTFORML 「......지난번처럼는 되지 않습니다」
			PRINTFORMDW 요리히메는 빠르게 칼을 뽑아 당신을 향해 자세를 잡았다...
			;まだ勝ったことがない
		ELSE
			PRINTFORML 「변이라고 하게 만들어 주마」
			PRINTFORMDW 요리히메는 자신이 질 것이라고는 조금도 생각하지 않는 것 같다...
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		;依姫の残機で分岐
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 「크윽, 꽤나……!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 나머지 한 발 날아온 탄을 간신히 튕겨냈다…….
			CASE 2
				PRINTFORML 「내가 부주의하다니……윽」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 찢어진 옷을 붙잡고 있다……
			CASE 1
				PRINTFORML 「질 수 없어……!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어깨로 숨을 몰아쉬고 있다. 찢어진 옷을 신경 쓸 여유도 없는 듯하다
			CASE 0
				PRINTFORML 「크윽!」
				PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"를")% 크윽 하고 말하게 하는 데 성공했다!
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		;依姫の残機で分岐
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 「무슨 일이세요? 아직 신들을 내려보내지도 않았는데요?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 땀 한 방울 흘리지 않고 있다...
			CASE 2
				PRINTFORML 「나에게는 팔백만 가지의 기술이 있다. 하지만 당신에게는 그 정도까지 필요 없는 모양이네요」
				PRINTFORMDW 방금 건 우연이었을까. 하고, 당신은 마음이 부서질 듯했다……
			CASE 1
				PRINTFORML 「쓸데없는 피가 흐르기 전에, 항복해라.」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신을 향해 칼끝을 겨누고 있다...
			CASE 0
				PRINTFORML 「……자, 일어나라」
				PRINTFORMDL 땀이 요리히메의 뺨을 타고 흘러 턱끝에서 떨어졌다.
				PRINTFORMDW 이제 조금만 더 하면 이길 수 있다. 당신은 어떻게든 스스로를 북돋았다.
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		;依姫の残機で分岐
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 「달콤해!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 탄막을 베어내고, 당신에게 돌격했다.
			CASE 2
				PRINTFORML 「야오요로즈노 카미가미노 치카라를, 지금!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 신을 자신의 몸에 내리자, 크게 칼을 휘둘렀다……
			CASE 1
				PRINTFORML 「크, 이렇게 된 이상은...」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 수많은 신들을 그 몸에 내리고 당신의 탄막을 맞섰다.
			CASE 0
				PRINTFORML 「――윽, 자폭 각오야!」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 당신의 탄막을 아슬아슬하게 피하며 다가온다...!
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORML 「――『카나야마 히코미』로다」
		PRINTFORML 「내 주위를 날아다니는 시끄러운 파리들을 모래로 돌려라!」
		PRINTFORMDW 맞았어야 할 당신의 탄막은 요리히메에게 도달하기 전에 사르륵 모래가 되어 사라졌다……
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 「――압도적으로 실전 경험 부족」
				PRINTFORML 「떡찧는 담당 토끼라도, 조금 더 버텨줄 수 있잖아요?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어이없다는 듯 허리에 손을 얹고 있다……
			CASE 3
				PRINTFORML 「어느 정도는 할 수 있지만, 아직 경험이 부족하네요.」
				PRINTFORMDL 무릎을 꿇고 땀을 닦는 당신을 %조사처리(CALLNAME:TARGET,"가")% 내려다본다.
				PRINTFORMDW 한 방은 맞출 수 있었던 것이 다행인가……
			CASE 2
				PRINTFORML 「후우… 수고하셨습니다」
				PRINTFORMDL 이마의 땀을 닦는 %조사처리(CALLNAME:TARGET,"의")% 발밑에는, 당신이 대자로 쓰러져 있다.
				PRINTFORMDW 무언가 말해야 할지도 모르지만, 숨이 가빠서 그럴 상황이 아니다……
			CASE 1
				PRINTFORML 「하아… 하아…」
				PRINTFORML (위험했다... 정말로...)
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 건조한 목으로 억지로 침을 삼키더니, 크게 숨을 내쉬었다...
			CASE 0
				PRINTFORML 「크윽...!」
				PRINTFORMDL 무릎을 꿇은 %조사처리(CALLNAME:TARGET,"를")% 당당하게 내려다본다.
				PRINTFORMDW 내가 최강이라고, 당신은 자신 있게 그렇게 생각할 수 있었다.
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
