@M_KOJO_MESSAGE_COM_K98_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;奉仕精神が１０以上または恋人
		IF ABL:奉仕精神 > 9 || TALENT:恋人
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「레우, 응... 하윽... 하윽... HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 꽉 가슴을 끌어올리며, 혀끝으로 방울 입구를 간지럽히고 있다.
						PRINTFORMDW 그것이 참 기분이 좋아서, 당신은 금세 절정에 도달해 버렸다.
					CASE 1
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 가슴의 부드러움을 느끼며 사정했다.
						CALL HPH_PRINT,@"「응앗 후우, 아…… 뜨거워……후우」","L"
						PRINTFORMDW 떨어지는 정액의 뜨거움에, %조사처리(CALLNAME:TARGET,"는")% 어딘가 넋을 놓고 신음했다...
					CASE 2
						CALL HPH_PRINT,@"「그대로 사정하시는 건가요...? HPH」","L"
						CALL HPH_PRINT,@"「아니면, 더......응응 HPH」","L"
						PRINTFORMDW 대답 대신, 당신은 %조사처리(CALLNAME:TARGET,"의")% 가슴을 움켜쥐고 격렬하게 허리를 움직였다...
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「언니처럼 되지는 못하겠지만... HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 가슴과 혀를 사용해서 당신에게 봉사하고 있다.
						PRINTFORMDW 엿을 핥듯이, 천천히. %조사처리(CALLNAME:TARGET,"는")% 당신에게 기분 좋은 쾌감을 주었다.
					CASE 1
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 젖꼭지를 페니스에 비비도록 명령했다.
						CALL HPH_PRINT,@"「아... 응... 윽 HPH 이거, 스쳐서... 윽 HPH」","L"
						PRINTFORMDW 살짝 허리를 흔들어 주겠다. 그러자 %조사처리(CALLNAME:TARGET,"는")% 쾌감을 참는 듯 꽉 입을 다물었다.
					CASE 2
						CALL HPH_PRINT,@"「―상당히 익숙해졌네……. 이 정도만 하면, 싫어도 익숙해질 거야……. 큭」","L"
						PRINTFORMDL 얼굴을 붉히는 %조사처리(CALLNAME:TARGET,"지만")%, 봉사의 손은 느슨해지지 않는다.
						PRINTFORMDW 정말로, 많이 익숙해진 것이군.
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
