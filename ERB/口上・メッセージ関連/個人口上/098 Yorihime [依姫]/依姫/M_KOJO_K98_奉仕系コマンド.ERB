;81,フェラチオ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_81
RETURN 0

@M_KOJO_MESSAGE_COM_K98_81
CALL M_KOJO_MESSAGE_COM_K98_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「이걸, 핥으면 되는 거군요……?」
		PRINTFORML 「……응……음……」
		PRINTFORML (그의 맛이 나의 입안에 퍼져나간다……)
		PRINTFORML 「음프……윽, 푹……쿠포……츄……」
		PRINTFORML (뜨거워……게다가 맥박이 뛰고 있어……)
		PRINTFORMDL 형태와 맛……그것을 확인하듯이 %조사처리(CALLNAME:TARGET,"가")% 혀를 핥아 내려간다.
		PRINTFORMDW 당신이 봉사의 방법을 가르쳐 주자, %조사처리(CALLNAME:TARGET,"는")% 그것을 금세 흡수했다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;奉仕精神が１０以上または恋人
		IF ABL:奉仕精神 > 9 || TALENT:恋人
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「큭, 음... HPH 쪽쪽, 쭉쭉HPH」","L"
						CALL HPH_PRINT,@"「그대로... 빨아줘, 끝내줘... 헉!」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 페니스를 문 채, 혀로 뒤쪽의 살을 거칠게 애태우고 있다...
					CASE 1
						CALL HPH_PRINT,@"「쿠프핫 HPH 쿠폿 HPH 음, 후훗 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 허벅지에 손을 대고 격렬하게 페니스에 빨아들이고 있다.
						PRINTFORMDW 어떻게 남자를 사정에 이르게 할 수 있을까. %조사처리(CALLNAME:TARGET,"는")% 그것을 잘 숙지하고 있었다.
					CASE 2
						CALL HPH_PRINT,@"「이대로……. 쪽……. 내 입에……. HPH」","L"
						PRINTFORMDL 당신을 위해서라면, 정액을 삼키는 것에 주저함은 없다.
						PRINTFORMDW 말하지 않아도 그렇게 말하는 %조사처리(CALLNAME:TARGET,"의")% 입안에, 당신은 쌓아두었던 더러움을 풀어놓았다.
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응, 으윽……후후 쿠큭, 응! 후후」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 페니스를 음미하듯 천천히 얼굴을 앞뒤로 움직이고 있다.
						PRINTFORMDW 그곳의 어떤 창녀를 상대하는 것 이상으로, 그 봉사는 당신을 만족시켰다.
					CASE 1
						PRINTFORML (확실히, 언니는 여기를 핥으면 좋다고……)
						CALL HPH_PRINT,@"「흐으, 응흐윽... HPH 중... 읏... HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 혀끝으로 링 입구를 자극하고, 흐르는 후루후루를 빨아들이고 있다……
					CASE 2
						CALL HPH_PRINT,@"「하아……응……흐읍 츄……쪽……큭흐읍」","L"
						PRINTFORMDL 정신없이 육봉에게 봉사하는 %조사처리(CALLNAME:TARGET,"를")% 바라본다.
						PRINTFORMDW 그녀의 어딘가 행복해 보이는 얼굴을 보고, 자신도 모르게 입꼬리가 풀려버린다……
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「하아앗, 응윽, 흐으, 츕」
						PRINTFORML 「――윽, 음프, 음, 음응읏」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 필사적인 혀 놀림에, 당신은 마침내 한계에 도달했다……
					CASE 1
						PRINTFORML 「참을 필요 같은 건 없습니다……」
						PRINTFORML 「당신은 그저……응윽……끝내는 것만 생각하면 되는 겁니다……」
						PRINTFORMDL 기둥에 혀를 감기며, %조사처리(CALLNAME:TARGET,"는")% 당신에게 사정을 재촉한다.
						PRINTFORMDW 당신이 의식을 집중시키자, 그 순간은 곧 찾아왔다
					CASE 2
						PRINTFORML 「쪽, 후우……음무, 응옷」
						PRINTFORMDL 스즈쿠치에게 키스한 후, %조사처리(CALLNAME:TARGET,"는")% 끝부분만 입에 물었다.
						PRINTFORMDL 그렇게 하자 %조사처리(CALLNAME:MASTER,"가")% 기분 좋아 보이는 반응을 보였다. %조사처리(CALLNAME:TARGET,"는")% 익힌 기술을 무의식적으로 실천하고 있었다.
						PRINTFORML 「쿠푸…… 쿠푸…… 고쿠옷, 응옷」
						PRINTFORMDL 그저 필사적으로 입으로 귀두를 애무당한다. 그녀의 촉촉한 입술이 여러 번 더러워진 페니스에 비벼진다.
						PRINTFORMDW 당신이 한계를 호소하자, %조사처리(CALLNAME:TARGET,"는")% 꽉 입을 오므리고 훌륭하게 뿌리까지 페니스를 물어왔다.
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「응푸욱……응윽……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 페니스를 입으로 다루고 있다
						PRINTFORMDL 『스승에게 배운 건가?』 호기심에 그렇게 묻자,
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 페니스를 입에 물고, 날카롭게 위를 올려다보며 노려왔다
					CASE 1
						PRINTFORML 「음……후……윽, 후우……무……앗」
						PRINTFORML (그냥 핥고 있을 뿐인데…… 그뿐인데……)
						PRINTFORML (어째서, 이렇게나……)
						PRINTFORMDL 저릿하다. 육봉의 열기에 맞으며 몸이 괴로워져 간다
						PRINTFORMDW 그것이 어찌인지는 모르겠다. 하지만, 몸을 맡겨서는 안 된다. %조사처리(CALLNAME:TARGET,"는")% 그런 기분이 들었다
					CASE 2
						PRINTFORML 「또, 핥으면 되는 거군요……」
						PRINTFORML 「……응, 흐윽……넣어줘……츄……읏」
						PRINTFORMDL 아래에서부터 기어가듯 혀를 움직여 끝에 도달하면 입에 물었다.
						PRINTFORMDW 당신이 가르쳐 준 대로의 동작으로, %조사처리(CALLNAME:TARGET,"는")% 페니스를 기분 좋게 해주고 있다……
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
