				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「음후우... HPH 쪽, 응, 츄루쪽 HPH」","L"
						PRINTFORMDL 그대로 음낭까지 입에 넣을 듯한 기세로, %조사처리(CALLNAME:TARGET,"는")% 페니스에 허겁지겁 달려들고 있다.
						PRINTFORMDW 긴장을 풀면 금방 가버릴 것 같다……
					CASE 1
						CALL HPH_PRINT,@"「흐으... 큭, 어때...? 큭」","L"
						CALL HPH_PRINT,@"「――다행이야……하아음, 응응……흐읍」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신을 만족시키고 있다는 사실에 기쁨을 느끼는 것 같다...
					CASE 2
						CALL HPH_PRINT,@"(아아... 맛있다... HPH)","L"
						CALL HPH_PRINT,@"(지금까지 먹어본 것 중 무엇보다 훨씬... HPH)","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 목이 메지 않고, 격렬한 기세로 페니스에 달라붙어 있다...
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「흡, 음, 윽, 뿜!?」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리를 꽉 잡고 기분 좋게 사정한다.
						PRINTFORMDW 토닥토닥 손으로 두드려오는 %조사처리(CALLNAME:TARGET,"를")% 무시하고, 당신은 쌓인 것을 전부 토해냈다.
					CASE 1
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 페니스를 물게 한 후, 그대로 사정했다.
						PRINTFORML 「……응, 윽……훗……우붓……」
						PRINTFORMDW 목구멍 깊숙한 곳을 때리는 뜨거운 탁류에, %조사처리(CALLNAME:TARGET,"는")% 구토할 것 같은 것을 필사적으로 참아가고 있다……
					CASE 2
						PRINTFORML (윽……욕정이 부풀어 오르면서……)
						PRINTFORML (알아버린다…… 그가 나를 더럽히려 하고 있다는 걸……)
						PRINTFORMDW 사정한다. 그렇게 말하며 머리를 잡자, %조사처리(CALLNAME:TARGET,"는")% 저항하지 않고 체념한 듯 눈을 감았다
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「후우...... 쪽...... 음...... 콜록」
						PRINTFORML 「하아...... 하아...... 괜찮아요......」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 호흡을 가다듬고 다시 봉사를 시작했다...
					CASE 1
						PRINTFORML 「흐읍, 음……쭉……쪽……」
						PRINTFORML 「쭈욱, 주즈즈윽, 응쿠……」
						PRINTFORMDW 『맛있나?』라고 물어오는 당신을 %조사처리(CALLNAME:TARGET,"는")% 무시했다
					CASE 2
						PRINTFORML 「음... 쭉, 쮸푹」
						PRINTFORMDL 시간을 거는 것보다 빨리 가게 해주는 편이 편하다고 판단했을 것이다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신의 허리에 손을 대고, 볼을 오목하게 만들며 격렬하게 육봉에 빨아들였다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
