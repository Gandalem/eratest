;80,手淫
;==================================================
;==================================================
;（任意）:通常の地の文を表示するかスキップするか決定する。
;MESSAGECHECK関数は、以下のような戻り値を返す
;RETURN 0;通常地の文と口上を表示
;RETURN 1;口上のみ表示
;RETURN 2;通常地の文のみ表示
;RETURN 3;どちらも表示しない
;以下原文
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_80
RETURN 0

@M_KOJO_MESSAGE_COM_K98_80
CALL M_KOJO_MESSAGE_COM_K98_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;奉仕精神が１０以上または恋人
		IF ABL:奉仕精神 > 9 || TALENT:恋人
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「네, 이대로--응앗 HPH」","L"
						PRINTFORMDL 육봉의 끝에서 터져 나오는 정액에 %조사처리(CALLNAME:TARGET,"는")% 반사적으로 눈을 감는다.
						PRINTFORMDW 손을 놓아버린 %조사처리(CALLNAME:TARGET,"를")% 대신하여, 당신은 스스로 페니스를 다루어 그녀의 얼굴 가득 정액을 뿌렸다.
					CASE 1
						CALL HPH_PRINT,@"「여기군요... HPH 아무... 후윽 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 가슴에 얼굴을 묻고, 고환을 빨면서 성기를 다루고 있다.
						CALL HPH_PRINT,@"「응푸, 쪽...... 하프 후우...... 쪽...... 윽 하프」","L"
						PRINTFORMDW 가끔 위를 올려다보는 그녀는 마치 「빨리 사정해」라고 재촉하는 듯했다.
					CASE 2
						CALL HPH_PRINT,@"「대단해, 미끌미끌하게 미끄러져서... HPH」","L"
						CALL HPH_PRINT,@"「하아... HPH 냄새도 이렇게나... HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 황홀하게, 사정 직전의 페니스를 만지고 있다...
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「단단하고, 뜨거워... HPH」","L"
						CALL HPH_PRINT,@"「이것이, 내 안에……HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%, 마치 연인의 뺨을 어루만지듯 당신의 페니스를 쓰다듬고 있다...
					CASE 1
						CALL HPH_PRINT,@"「응... 기분 좋아...? HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 위를 보며 당신을 응시하면서 페니스를 다루고 있다.
						PRINTFORMDW 당신은 대답 대신, %조사처리(CALLNAME:TARGET,"의")% 머리를 부드럽게 쓰다듬었다.
					CASE 2
						CALL HPH_PRINT,@"「흐으... 하아... 윽, 흐읍」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 손으로 자지(竿)를 만지면서, 아주 가까운 거리에서 페니스의 냄새를 맡고 있었다.
						PRINTFORMDW 분명 무의식적인 행동일 것이다. 하지만 그녀가 보면 안 되는 부분을 본 것 같아 매우 흥분했다.
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「――벌써 사정할 것 같아? 음, 어떻게 하면 좋을까?」
						PRINTFORMDL 더 강하게, 격렬하게 다뤄주길 원해. 그렇게 당신은 부탁했어
						PRINTFORMW 「더 세게…… 아, 떨려……!?」
					CASE 1
						PRINTFORML 「――그대로라니, 에, 아!?」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 손 안에서 페니스가 뛰더니 끝에서 정액을 분출했다.
						PRINTFORMDW 세차게 흩뿌려진 그것이 질척하게 실을 이어서 그녀의 얼굴에서 무겁게 흘러내렸다.
					CASE 2
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 페니스를 잡게 한 채 그대로 사정했다.
						PRINTFORML 「앗! ……굉장하다, 이렇게……」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 손에 묻은 정액을 가만가만 바라보고 있었다…….
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML (이렇게 더럽고 추한 것이지만……)
						PRINTFORML (어째서…… 눈을 뗄 수가 없어……)
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 시선은, 적흑으로 부풀어 오른 성기의 끝에 향하고 있다……
					CASE 1
						PRINTFORML 「이, 넘쳐흐르는 것을 멈춰주세요」
						PRINTFORML 「미끌거리고, 미끄러져 버려서......」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 손을 움직일 때마다 니츄니츄하고 음란한 소리가 난다……
					CASE 2
						PRINTFORML 「――조금 더 변화를…… 이렇게 할까요……?」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신의 반응을 보며 불규칙하게 손을 움직이고 있다.
						PRINTFORMDW 기분 좋다. 라고 말해주자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 시선을 돌렸다.
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
