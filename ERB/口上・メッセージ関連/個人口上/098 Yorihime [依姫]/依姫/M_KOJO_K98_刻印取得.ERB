; Modular ERB: 個人口上/098 Yorihime [依姫]/依姫/M_KOJO_K98_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K98
RETURN 0

@M_KOJO_MESSAGE_MARKCNG_K98
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
;時間停止中は非表示
IF !FLAG:70
	;Lv1
	IF TFLAG:22 == 1
		PRINTFORML 「흐윽, 크윽... 하아... 윽」
		PRINTFORML (이 정도라면... 아직 견딜 수 있어...)
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 조금이라도 고통을 완화시키려고 호흡에 의식을 집중하고 있다...
		;Lv2
	ELSEIF TFLAG:22 == 2
		PRINTFORML 「아...... 크윽...!」
		PRINTFORMDL 처음에는 견딜 수 있어도, 고통이 바로 사라지는 건 아니다.
		PRINTFORMDW 파도처럼 밀려오는 고통이 %조사처리(CALLNAME:TARGET,"의")% 이성을 조금씩 깎아 나간다...
		;Lv3
	ELSEIF TFLAG:22 == 3
		PRINTFORML (견딜 수 있을 거라고 생각했는데......!)
		PRINTFORML (이렇게...... 이렇게 아프다니......!)
		PRINTFORMDW 견디기 힘든 고통에, %조사처리(CALLNAME:TARGET,"는")% 소리를 지르지도 못한 채 웅크리고 있다...
	ENDIF
ENDIF
;時姦刻印
;Lv1
IF TFLAG:時姦刻印取得 == 1
	PRINTFORML 한 번 새겨진 쾌락의 각인은 결코 지워지지 않는다.
	PRINTFORML 아무것도 몰랐던 시절의 몸으로는 이미 돌아갈 수 없을 것이다.
	PRINTFORMW 시간 정지를 해제했을 때의 반응이 기대된다……
	;Lv2
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 신체는 순조롭게 개발되고 있다.
	PRINTFORML 물론 그녀의 본심은 아닐 테지만, 상관할 바가 아니다.
	PRINTFORMW 당신은 휴식을 마치고 다시 그녀의 몸에 손을 뻗었다...
	;Lv3
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORML 시간 정지 중에 빨아먹힌 %조사처리(CALLNAME:TARGET,"의")% 몸은 이제 완전히 당신에게 굴복하고 있다.
	PRINTFORML 살짝 성감대를 쓰다듬어 주는 것만으로도 순식간에 도달해 버릴 듯한 지경이다.
	PRINTFORML 침착한 표정을 하고 있지만, %CALLNAME:TARGET%역시 이 상황을 즐기고 있을 것이다.
	PRINTFORMW 그런 확신에 찬 예감이 지금의 당신에게는 있었다.
ENDIF
SIF FLAG:時間停止  ;custom code
	RETURN 0
;快楽刻印
IF !CFLAG:MASTER:イタズラ
	;Lv1
	IF TFLAG:23 == 1
		CALL HPH_PRINT,@"(이런 건... 몰라...! HPH)","L"
		PRINTFORMDL 자위를 하는 것과는 전혀 다른, 몸이 뜨겁고 녹아내리는 듯한 감각
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그날, 진정한 쾌락이라는 것을 처음 알았다
		;Lv2
	ELSEIF TFLAG:23 == 2
		CALL HPH_PRINT,@"(이렇게... 굉장하다니...윽 HPH)","L"
		PRINTFORMDL 아직 절정의 여운이 가시지 않는 건지, 때때로 %조사처리(CALLNAME:TARGET,"의")% 몸이 움찔 떨린다.
		PRINTFORMDW 구르듯, %조사처리(CALLNAME:TARGET,"의")% 몸은 성적인 환희를 받아들이고 있다……
		;Lv3
	ELSEIF TFLAG:23 == 3
		CALL HPH_PRINT,@"「하아... 하아... HPH」","L"
		PRINTFORMDL 어깨로 숨을 쉬는 %조사처리(CALLNAME:TARGET,"의")% 표정은 어딘가 기쁜 듯 풀려 있었다.
		PRINTFORMDW 몸의 중심까지 타버린 이 감각을, %조사처리(CALLNAME:TARGET,"는")% 평생 잊지 못할 것이다……
	ENDIF
ENDIF
;不埒刻印
;快楽による刻印 ＆ 屈服、恭順による刻印
;LV1
IF TFLAG:24 == 11 || TFLAG:24 == 31
	;行為中
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「――윽!흐읍」","L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 눈을 피한 채, 부끄러운 듯 입가를 손으로 가리고 있다.
		PRINTFORMDW 예쁘다고 당신이 말하자, 빨갰던 %조사처리(CALLNAME:TARGET,"의")% 얼굴이 더욱 새빨개져 버렸다.
		;それ以外
	ELSE
		PRINTFORML 「......저기」
		PRINTFORML 「아, 아니에요. 아무것도 아니에요......」
		PRINTFORMDW 눈이 마주치자 %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 시선을 피했다......
	ENDIF
	;LV2
ELSEIF TFLAG:24 == 12 || TFLAG:24 == 32
	;行為中
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"(몸 속이... 뜨거워서... 하지만, 그리워서... HPH)","L"
		CALL HPH_PRINT,@"(언니도…… 이 감각을……? HPH)","L"
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신을 바라본 채, 무언가 말하고 싶다는 듯 입에서 숨을 내쉬고 있다...
		;それ以外
	ELSE
		PRINTFORML (나도 그에게 뭔가 해주는 편이...)
		PRINTFORML (...하지만 한다니 뭘...)
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 어려운 표정으로 고개를 숙이고 있다...
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 13 || TFLAG:24 == 33
	;行為中
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「……모……토……윽」","L"
		PRINTFORMDL 「응?」하고 당신이 일부러 듯 고개를 기울이자, %조사처리(CALLNAME:TARGET,"는")% 꿀꺽 침을 삼켰다.
		CALL HPH_PRINT,@"「부탁드려요... 더...!! HPH」","L"
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부끄러움도 체면도 내던지고, 당신에게 행위의 계속을 간청했다……
		;それ以外
	ELSE
		PRINTFORML 「이런 말을 하는 건 이상할지도 모르겠지만……」
		PRINTFORML 「……그, 무언가 해줬으면 하는 것 같은 게……」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 더 당신과 『친하게』 되고 싶은 모양이다……
	ENDIF
ENDIF
;反発刻印
;LV1
IF TFLAG:21 == 1
	PRINTFORML 「당신은 그저 변덕으로 생명을 유지하고 있을 뿐이다」
	PRINTFORML 「……아직 모르겠습니까?」
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 목소리로 그녀가 진심이라는 것을 알 수 있다.
	PRINTFORMDW 이 이상은 멈춰 두는 편이 좋을 것 같다……
	;LV2
ELSEIF TFLAG:21 == 2
	PRINTFORML (이 남자를... 믿겠다고 생각했던 내가 바보였어...)
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신에게 적의를 품고 있다.
	PRINTFORMDW 아무래도, 그녀를 화나게 해버린 것 같다...
	;LV3
ELSEIF TFLAG:21 == 3
	PRINTFORMDL 격노한 %조사처리(CALLNAME:TARGET,"에게")% 세게 뺨을 맞았다.
	PRINTFORML 「――――」
	PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 무슨 소리를 지르고는 있지만, 통증이 너무 심해서 잘 알아들을 수 없었다...
ENDIF
