	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;恋人
		IF TALENT:恋人
			;笑顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "笑顔", "服", "", ""
			PRINTFORML 「하아…… 즐거웠다」
			PRINTFORML 「또 가요. %CALLNAME:MASTER%」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며, 아이처럼 천진난만한 미소를 당신에게 보냈다
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORML 「――다음엔 언제 데이트하러 갈까?」
			PRINTFORML 「방금 다녀왔는데, 벌써 다음 이야기예요?」
			PRINTFORMDW 그런 가벼운 농담을 주고받으며 두 사람은 집으로 향했다.
			;思慕
		ELSEIF TALENT:思慕
			PRINTFORML 「아……벌써 도착했군요」
			PRINTFORML 「――아니요, 그럼 또 봐요」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 『또』라고 말해 주었다. 다시 유도해야겠다고 당신은 생각했다
			;それ以外
		ELSE
			PRINTFORML 「그럼, 나는 여기서」
			PRINTFORMDW 『집까지 바래다줄까?』라고 말하기도 전에, %조사처리(CALLNAME:TARGET,"는")% 걸어갔다
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================

@M_KOJO_EVENT_K98_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		$YORIHIME_ENCOUNTER
		IF !TCVAR:[[依姫]]:今日会ったか
			;恋人
			IF TALENT:恋人
				;TIME:2で朝昼晩を選択
				;笑顔絵を表示（オプションでオンにしていないと表示されない）
				CALL PRINT_FACE, [[依姫]], "笑顔", "服", "", ""
				SELECTCASE TIME:2
					;朝
					CASE 1,2
						PRINTFORML 「안녕하세요. %CALLNAME:MASTER%」
						PRINTFORML 「자, 이쪽으로 오세요. 아침 식사 준비가 되어 있습니다」
						PRINTFORMDW 그럴 생각은 없었는데, 아침 식사를 대접받고 말았다
						;昼～夕
					CASE 3,4,5
						PRINTFORML 「수고하셨습니다. %CALLNAME:MASTER%」
						PRINTFORML 「잠시만 기다려 주세요. 이것을 정리하고 나면……」
						PRINTFORMDW 당신은 앉아서 %조사처리(CALLNAME:TARGET,"의")% 일이 끝나는 것을 기다렸다
						;夜
					CASE 6,7
						PRINTFORML 「――앗」
						PRINTFORML 「%CALLNAME:MASTER%. 오늘은 벌써 안 계신가 해서……」
						PRINTFORMDW 어딘가 어두운 표정이었던 %CALLNAME:TARGET%였지만, 당신을 발견하자 금세 밝은 표정이 되었다
				ENDSELECT
				;恋慕
			ELSEIF TALENT:恋慕
				PRINTFORML 「%CALLNAME:MASTER%, 기다리고 있었어요」
				PRINTFORMDL 인사를 하자, %조사처리(CALLNAME:TARGET,"가")% 이쪽까지 와 주었다.
				PRINTFORMDW 어딘가 기뻐 보이는 건 내 착각일까?
				;思慕
			ELSEIF TALENT:思慕
				PRINTFORML 「다음 수련은……어라」
				PRINTFORML 「%CALLNAME:MASTER%, 무슨 용무이신가요?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 이쪽을 돌아 미소를 지었다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"와")% 이야기하고 있던 타마우는 꾸벅 고개를 숙이고 서둘러 가버렸다
				;それ以外
			ELSE
				PRINTFORML 「아, 오셨군요」
				PRINTFORML 「누님이 당신을 찾고 있었습니다」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그것만 말하고 자신의 일로 돌아갔다
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF !TCVAR:[[依姫]]:今日会ったか
			;恋慕
			IF TALENT:恋慕
				PRINTFORML 「여기에 계셨군요」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신을 바라보더니 달려왔다
				PRINTFORMDW 『시녀 같아』라고 당신이 말하자, %조사처리(CALLNAME:TARGET,"는")% 고개를 기울였다
				;思慕
			ELSEIF TALENT:思慕
				PRINTFORML 「%CALLNAME:MASTER%? 오늘은 안 오신다고」
				PRINTFORMDL 어려운 표정을 짓고 있던 %CALLNAME:TARGET%였지만, 당신을 보자 곧 그것도 누그러졌다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 가볍게 손을 들고, %조사처리(CALLNAME:TARGET,"에게")% 인사를 건넸다.
				;それ以外
			ELSE
				PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 『안녕』이라고 인사했다.
				PRINTFORML 「좋은 아침입니다」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 무뚝뚝하게 당신에게 인사를 되돌려주었다.
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;恋慕
		IF TALENT:恋慕
			PRINTFORMDL 한 치의 옷도 걸치지 않은 %조사처리(CALLNAME:TARGET,"에게")%, 당신은 무심코 시선을 빼앗긴다.
			PRINTFORML 「……%CALLNAME:MASTER%? 들어가도 될까요?」
			PRINTFORMDW 당신이 고개를 끄덕이자, %조사처리(CALLNAME:TARGET,"가")% 자리를 비켜주었다.
			;それ以外
		ELSE
			PRINTFORML 「아, 아무도 같이 들어가고 싶다고 말하지 않았어요」
			PRINTFORML 「저, 저는! 언니께 당신의 등을 흘려보내라고 지시받아서요……」
			PRINTFORMDW 알았어 알았어. 그렇게 말하며 당신은 %조사처리(CALLNAME:TARGET,"에게")% 손짓을 했다
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;恋慕
		IF TALENT:恋慕
			PRINTFORML 「아……」
			PRINTFORMDL 전라의 두 사람의 눈이 마주친 순간, 따뜻한 목욕탕의 공기가 한순간에 얼어붙었다.
			PRINTFORMDW 『음』 당신이 그렇게 말한 순간, %조사처리(CALLNAME:TARGET,"는")% 얼굴을 새빨게 물리고 문을 닫았다.
			;それ以外
		ELSE
			PRINTFORML 「저, 잠금이라도 걸어주세요!」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 쾅 하고 문을 닫는다.
			PRINTFORMDW 탈의실 정도면 알 만한 것 같은데……
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;恋慕
		IF TALENT:恋慕
			PRINTFORMDL ……어쩔 수 없어. 라고, 당신은 욕조에서 일어섰다
			PRINTFORML 「엣!? 자, 앞을 가리세요!」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 얼굴을 새빨갛게 하고 당황하고 있다. 이걸로 승산이네
			;それ以外
		ELSE
			PRINTFORML 「……나가라」
			PRINTFORMDL 가슴과 하체를 손으로 가린 %조사처리(CALLNAME:TARGET,"가")%, 당신을 똑바로 노려본다.
			PRINTFORMDW 당신은 대야로 하체를 가한 채, 바스락바스락하며 몸을 숙이고 물러났다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		GOTO YORIHIME_ENCOUNTER
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;既に会っている場合は非表示
		IF !TCVAR:[[依姫]]:今日会ったか
			;霊夢とデート
			IF FLAG:デート相手 == 1
				PRINTFORMDL 레이무가 손을 빼자 그 자리를 떠나려고 하자……
				PRINTFORML 「――%CALLNAME:MASTER%? 라고, 거기에 있는 건……」
				PRINTFORMDW 레이무는 『귀찮은데 들켰나』라고 말하고 싶은 듯한 표정을 짓고 있다……
				;永琳とデート
			ELSEIF FLAG:デート相手 == 72
				PRINTFORML 「엣!?」
				PRINTFORML (야이님께서......어째서......)
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 무심코 떨군 서류를 주우면서, 슬쩍 두 사람을 바라보고 있다...
				;豊姫とデート
			ELSEIF FLAG:デート相手 == 99
				PRINTFORML 「누님. 아니, 문제는 일어나지 않았어요」
				PRINTFORML 「……아니, 일어난다면 일어났지만……」
				PRINTFORMDW 당신과 팔짱을 낀 토요히메를 보며, %조사처리(CALLNAME:TARGET,"는")% 「하아…」 하고 한숨을 내쉬었다
				;鈴仙orレイセンとデート
			ELSEIF FLAG:デート相手 == 52 || FLAG:デート相手 == 100
				PRINTFORML 「하아…… 의무도 다하지 않고 놀고 있다니」
				PRINTFORML 「또 수련을 시켜줘야 할 것 같네요」
				PRINTFORMDW \@ FLAG:デート相手 == 52 ? 레이센 # 레이센 \@는 부르르 떨고 있다. 불렀으니, 조금 미안했다
				;清蘭or鈴瑚とデート
			ELSEIF FLAG:デート相手 == 107 || FLAG:デート相手 == 108
				PRINTFORML 「……최근, 토끼들의 기율이 느슨해지고 있다고 생각은 했지만」
				PRINTFORML 「하아…… 설마 당신들까지라니」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 지친 모습으로 눈가를 누른다. \@ FLAG:デート相手 == 107 ? 세이란 # 링고 \@는 어째선지 휘파람을 불고 있다…….
				;純狐orヘカーティアとデート
			ELSEIF FLAG:デート相手 == 112 || FLAG:デート相手 == 113
				PRINTFORML 「뭐...」
				PRINTFORML (어째서... %조사처리(CALLNAME:MASTER,"가")% 『그것』을...)
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 놀라 눈을 크게 뜨고 있다...
				;それ以外
			ELSE
				;恋慕
				IF TALENT:恋慕
					CALL PRINT_FACE, [[依姫]], "通常", "服", "", ""
					PRINTFORML 「그렇게 사이좋게……」
					CALL PRINT_FACE, [[豊姫]], "笑顔", "服", "", ""
					CALL M_KOJO_COLOR_K99
					PRINTFORML 「부럽네…….」
					CALL PRINT_FACE, [[依姫]], "怒り", "服", "", ""
					CALL M_KOJO_COLOR_K98
					PRINTFORML 「아니, 딱히…」
					PRINTFORMDW 타인과 데이트를 하는 당신을 보며, %조사처리(CALLNAME:TARGET,"는")% 모호한 것을 느끼고 있었다
					RESETCOLOR
					;それ以外
				ELSE
					PRINTFORML 「…………」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 나랑 상관없는 일을 하고 있다
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;朝起きたとき（おはよう口上）
;==================================================

@M_KOJO_EVENT_K98_2(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		TCVAR:今日会ったか = 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			;恋慕
			IF TALENT:恋慕
				GOTO YORIHIME_OHAYO
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			;恋慕
			IF TALENT:恋慕
				GOTO YORIHIME_OHAYO
			ENDIF
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		$YORIHIME_OHAYO
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「좋은 아침입니다」
				PRINTFORML 「자, 어서 옷 갈아입는 것을 끝내세요」
				PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"에게")% 재촉받으며 아침 준비를 마쳤다
			CASE 1
				PRINTFORML 「자, 드세요. 이제 깨셨어요」
				PRINTFORMDL 당신은 고맙다고 말하고 %CALLNAME:TARGET%에게서 컵을 받았다
				PRINTFORMDW 그것을 단숨에 들이켰다. 차가운 물이 흐릿했던 머리를 샤크하게 만들어 주었다
			CASE 2
				PRINTFORML 「늦잠 자고 있네요, %CALLNAME:MASTER%」
				PRINTFORMDL 하아~ 하고 큰 하품을 하며 배를 문지른다.
				PRINTFORMDW 그것을 %조사처리(CALLNAME:TARGET,"가")% 방정맞다고 꾸짖는다. 늘 있는 일상이다.
		ENDSELECT
		TCVAR:今日会ったか = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 당신은 이불을 다시 덮고 %조사처리(CALLNAME:TARGET,"의")% 머리를 부드럽게 쓰다듬었다.
				PRINTFORML 「음... 흐으...」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 싫다는 듯 몸을 뒤척이더니, 다시 잠꼬리를 내기 시작했다…….
			CASE 1
				PRINTFORML 「스윽… 스윽…」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 조용히 숨을 쉬고 있다
				PRINTFORMDW 이불에서 빠져나온 당신은 %조사처리(CALLNAME:TARGET,"를")% 깨우지 않도록 하루의 준비를 시작했다
			CASE 2
				PRINTFORML 「……%CALLNAME:MASTER%……」
				PRINTFORMDL 이름을 불렀더니 돌아보니 %조사처리(CALLNAME:TARGET,"는")% 아직 잠꼬리를 하고 있었다
				PRINTFORMDW 꿈이라도 꾸고 있는 걸까. %조사처리(CALLNAME:TARGET,"의")% 자는 얼굴은 아주 행복해 보인다
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		TCVAR:今日会ったか = 1
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;共通
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「안녕하세요……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 어쩐지 잠이 부족해 보인다
					PRINTFORMDW 당신은 컵에 차가운 차를 따르고, 그녀에게 내밀었다
				CASE 1
					PRINTFORML 「…………」
					PRINTFORMDL 아직 머리가 몽롱한 건지, %조사처리(CALLNAME:TARGET,"는")% 멍하게 바닥을 바라보고 있다.
					PRINTFORML 「……좋아, 하고」
					PRINTFORMDW 하지만 그것도 몇 초 만에, 뺨을 두드리고 곧바로 준비를 시작했다.
				CASE 2
					PRINTFORML 「좋은 아침입니다」
					PRINTFORML 「……저기, %CALLNAME:MASTER%?」
					PRINTFORMDL 당신은 『계속할래?』라며 %조사처리(CALLNAME:TARGET,"에게")% 옷을 갈아입으라고 재촉했다.
					PRINTFORMW 「정말……」
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「……부끄러운 모습을 보여드렸습니다……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 매우 민망해하고 있다
					PRINTFORMDW 귀여운 잠든 얼굴을 볼 수 있었기에, 나로서는 정말 좋았다
				CASE 1
					PRINTFORML 「…………」
					PRINTFORMDL 잠시 후 문을 열자, %조사처리(CALLNAME:TARGET,"가")% 이불 위에서 어색하게 정좌하고 있었다.
					PRINTFORMDW 뭐랄까, 너무 진지하다…….
				CASE 2
					PRINTFORML 「저기, 이 일은 언니에게는……」
					PRINTFORMDL 별로 퍼뜨리거나 하지 않을 테니까 안심해도 돼.
					PRINTFORMDW 그렇게 말하자, %조사처리(CALLNAME:TARGET,"는")% 안도의 한숨을 내쉬었다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
