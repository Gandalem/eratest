RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_189_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:新妻プレイ
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「저기... 밥 먹을래요? 목욕할까요?」
					PRINTFORML 「아니면... 그, 아니... 역시 말 못 하겠어요.」
					PRINTFORMDW 이 고백은 %CALLNAME:TARGET%에게는 높은 장벽인 것 같다.
				CASE 1
					PRINTFORML 「신부 플레이라는 것이 잘 모르겠는데요……」
					PRINTFORML 「즉, 당신의 아내로서 행동하면 되는 건가요?」
					PRINTFORMDW 그런 것이다. 그렇게 말하며, 당신은 %조사처리(CALLNAME:TARGET,"에게")% 에이프런을 건넸다
				CASE 2
					PRINTFORML 「이걸 입으면 되는 거군요」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 받은 에이프런을 척척 걸쳤다
					PRINTFORMDW 뭐랄까, 이대로 요리를 시작할 것 같은 기세였다
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「에이프런을? 입기만 하면 되는 건가요?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 새하얀 에이프런을 착용한다.
					PRINTFORMDW 응, 역시 에이프런은 좋은 물건이야
				CASE 1
					PRINTFORML 「새 아내, 플레이? 당신의 아내가 된 기억은 없지만」
					PRINTFORMDL 단순한 플레이. 역할극 같은 것이다
					PRINTFORMDW 그렇게 설명하자, %조사처리(CALLNAME:TARGET,"는")% 조금 물러섰다...
				CASE 2
					PRINTFORML 「일단 걸어봤는데……」
					PRINTFORMDL 에이프런을 두르게 된 %조사처리(CALLNAME:TARGET,"가")% 의심스러운 듯 고개를 기울인다.
					PRINTFORMDW 꽤 잘 어울린다. 말 그대로 새 신부 같은 느낌이다.
			ENDSELECT
		ENDIF
		;終了
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORML 「그게…… 잘 어울렸나요?」
			PRINTFORMDL 아주 잘 어울렸다. 또 입어줬으면 좋겠어
			PRINTFORMDW 그렇게 말하자, %조사처리(CALLNAME:TARGET,"는")% 만족스러운 듯한 반응을 보였다
			;それ以外
		ELSE
			PRINTFORML 「같이 당하는 쪽의 입장이 되어주세요」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 에이프런을 벗고 당신에게 돌려주었다
			PRINTFORMDW 마음에 들어 줄 거라고 생각했는데……
		ENDIF
	ENDIF
ENDIF
RETURN 1
