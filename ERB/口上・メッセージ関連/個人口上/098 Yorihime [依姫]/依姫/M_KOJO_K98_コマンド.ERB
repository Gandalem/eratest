;=================================================
;特殊コマンド
;=================================================
;-------------------------------------------------
;180,ローション
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_180
RETURN 0

@M_KOJO_MESSAGE_COM_K98_180
CALL M_KOJO_MESSAGE_COM_K98_180_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		GOTO YORIHIME_LUBRICANT
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;発情顔絵を表示（オプションでオンにしていないと表示されない）
		IF !TEQUIP:0 && !TEQUIP:1
			CALL PRINT_FACE, [[依姫]], "発情", "裸", "", ""
		ELSE
			CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
		ENDIF
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응... 응... 큭흐읍」","L"
					CALL HPH_PRINT,@"(굉장히... 만지는 방식이 음란해... HPH)","L"
					PRINTFORMDL 잔뜩 흘린 로션을 %조사처리(CALLNAME:TARGET,"의")% 몸에 펴 바른다.
					PRINTFORMDW 기어 다니는 손의 감촉에, %조사처리(CALLNAME:TARGET,"는")% 작게 숨을 몰아쉬고 있다……
				CASE 1
					CALL HPH_PRINT,@"「그런 곳까지……크윽 HPH 바르지 않아도……응 HPH」","L"
					PRINTFORMDL 당신은 겨드랑이나 엉덩이의 갈라진 틈까지 로션을 바르고 있다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부끄러운지, 얼굴을 홍조하게 물들이고 있다……
				CASE 2
					CALL HPH_PRINT,@"「아, 아직 하시는 건가요...? HPH」","L"
					PRINTFORMDL 손바닥에 로션을 듬뿍 떨어뜨려 %조사처리(CALLNAME:TARGET,"의")% 몸에 발라나간다.
					PRINTFORMDW 물론 중요한 곳은 꼼꼼하게. 당신은 %조사처리(CALLNAME:TARGET,"의")% 몸을 로션 범벅으로 만들었다.
			ENDSELECT
			;それ以外
		ELSE
			$YORIHIME_LUBRICANT
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 자신에게도 발라달라고 %조사처리(CALLNAME:TARGET,"에게")% 로션 병을 건넸다.
					PRINTFORML 「알겠습니다...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 손바닥에 로션을 떨어뜨리고, 바르듯이 당신의 피부를 손으로 쓰다듬었다...
				CASE 1
					PRINTFORML 「음……」
					PRINTFORMDL 로션을 떨어뜨리자 %조사처리(CALLNAME:TARGET,"가")% 작게 소리를 냈다.
					PRINTFORMDW 품에서 따뜻하게 해 두었지만, 아직 차가웠을지도 모른다.
				CASE 2
					PRINTFORMDL 온몸을 로션 범벅으로 만들면서 %조사처리(CALLNAME:TARGET,"를")% 완전히 사용해 버렸다
					PRINTFORML 「……나중에 생각하면 머리가 아프네요」
					PRINTFORMDW 그건 말하지 않기로 약속한 거다
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;181,媚薬
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_181
RETURN 0

@M_KOJO_MESSAGE_COM_K98_181
CALL M_KOJO_MESSAGE_COM_K98_181_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_181_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		GOTO YORIHIME_APHRODISIAC
		RETURN 1
	ENDIF
	;基本セット
	;発情顔絵を表示（オプションでオンにしていないと表示されない）
	IF !TEQUIP:0 && !TEQUIP:1
		CALL PRINT_FACE, [[依姫]], "発情", "裸", "", ""
	ELSE
		CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
	ENDIF
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하읏…… 하읏…… 흐윽」","L"
				CALL HPH_PRINT,@"(이런 것... 쓰지 않아도... HPH)","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 무언가 말하고 싶다는 듯 당신을 보고 있다...
			CASE 1
				PRINTFORMDL 당신은 혀 위에 미약의 태블릿을 올리고, 그대로 %조사처리(CALLNAME:TARGET,"에게")% 키스했다.
				CALL HPH_PRINT,@"「응, 후우......! 하으윽... 하아......! 하으윽...」","L"
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 입으로 넘긴 미약을 삼킨다. 효과는 곧 나타났다.
			CASE 2
				CALL HPH_PRINT,@"「또... 이 약이... 윽 HPH」","L"
				PRINTFORMDL 몸이 뜨거워져 간다. 그 열에 이성이 녹아간다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"와")% 교감하고 싶어서, 참을 수 없게 되어 버린다……
				CALL HPH_PRINT,@"「흐읍, 크윽... 하아아... 큭」","L"
				PRINTFORMDW 질척하게, 마지막까지 남아있던 이성이 %조사처리(CALLNAME:TARGET,"의")% 마음속에서 녹아내렸다.
		ENDSELECT
		;それ以外
	ELSE
		$YORIHIME_APHRODISIAC
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아…… 하아……읏ㅎ」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 스스로의 몸을 끌어안는다. 호흡이 빠르고 거칠어진다.
				PRINTFORMDW ……아무래도, 효과가 나타난 것 같다.
			CASE 1
				CALL HPH_PRINT,@"「쿠, 약은... 그만둬, 라고... 윽 HPH」","L"
				PRINTFORMDL 초점이 없는 눈으로 %조사처리(CALLNAME:TARGET,"가")% 노려본다.
				PRINTFORMDW 한마디 한마디를 짜내야 할 정도, 그녀의 이성은 한계에 가까운 듯하다.
			CASE 2
				PRINTFORMDL 그런 더러운 약은 마실 수 없다고, %조사처리(CALLNAME:TARGET,"는")% 입을 열려고 하지 않는다.
				PRINTFORML 「――윽!? 푸하, 음무!?」
				PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"의")% 코를 잡아, 벌린 입에 억지로 미약을 밀어 넣었다……
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
