;==================================================
;188,シャワー
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_188
RETURN 0

@M_KOJO_MESSAGE_COM_K98_188
CALL M_KOJO_MESSAGE_COM_K98_188_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_188_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:シャワー
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「함께 목욕하지 않겠어?」
					PRINTFORMDL 물론 그럴 생각으로, 당신은 %조사처리(CALLNAME:TARGET,"의")% 옆에 나란히 선다.
					PRINTFORMDW 물의 온도는 딱 좋다. 정말 기분이 좋았다.
				CASE 1
					PRINTFORMDL 샤워를 하는 %조사처리(CALLNAME:TARGET,"를")% 가만히 바라본다.
					PRINTFORML 「……%CALLNAME:MASTER%？」
					PRINTFORMDL 물에 젖은 연보라색 긴 머리카락이, 투명한 도자기 같은 피부에 달라붙어 있다.
					PRINTFORMDW 선녀와 같은 아름다움이라고 하지만, 그녀에게는 그 말조차 부족할 것이다.
				CASE 2
					PRINTFORML 「하아……따뜻해……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 편안한 모습으로 샤워를 하고 있다.
					PRINTFORMDW 당신은 뒤에서 %조사처리(CALLNAME:TARGET,"를")% 끌어안고 함께 샤워했다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「차가워!? 저기, 나올 때는 한 마디 정도 해줘」
					PRINTFORMDL 미안미안 하고 온도를 조절한다.
					PRINTFORMDW 잠시 기다리니 겨우 적당한 온도의 물이 나왔다.
				CASE 1
					PRINTFORML 「하아……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 눈을 감고 샤워를 하고 있다.
					PRINTFORMDW 당신이 뒤에서 안자, %조사처리(CALLNAME:TARGET,"는")% 몸을 살짝 경직시켰다.
				CASE 2
					PRINTFORML 「……안 받으실 건가요?」
					PRINTFORMDL 샤워를 하는 %조사처리(CALLNAME:TARGET,"가")% 돌아보며 물어온다.
					PRINTFORMDW 당신은 고개를 끄덕이고, %CALLNAME:TARGET%옆에 나란히 서서 함께 샤워했다.
			ENDSELECT
		ENDIF
		;終了
	ELSE
		PRINTFORMDL 만족한 당신은 샤워 수전을 꽉 잠갔다.
		PRINTFORML 「후우...」
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 젖은 머리를 모아 가볍게 손으로 짜고 있다...
	ENDIF
ENDIF
RETURN 1
