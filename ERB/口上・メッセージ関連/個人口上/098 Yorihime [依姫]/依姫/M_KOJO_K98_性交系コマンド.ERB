@M_KOJO_MESSAGE_COM_K98_68_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:破瓜 == 1
		PRINTFORMW 「응, 크윽……아아……읏!」
		PRINTFORMDL 남자를 몰랐던 %조사처리(CALLNAME:TARGET,"의")% 몸에, 당신의 일부가 삼켜져 들어간다
		PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"를")% 끌어안고, 더욱 깊숙이 허리를 밀어 넣었다
		PRINTFORMW 「――윽, 하아……하아……읏」
		PRINTFORMW 「이걸로……하아……전부……?」
		PRINTFORMDL 숨을 고르는 %조사처리(CALLNAME:TARGET,"에게")% 당신은 끄덕임을 돌려준다
		PRINTFORMDW 그러자 %조사처리(CALLNAME:TARGET,"는")% 안심한 듯 살짝 표정을 부드럽게 만들었다
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		;膣技術３以上または恋人
		IF ABL:膣 >= 3 || TALENT:恋人
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精 && !TEQUIP:MASTER:コンドーム
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDL 당신은 허리를 밀어 올리며 어디를 만져줬으면 하고 귓가에 속삭였다.
						CALL HPH_PRINT,@"「가슴, 더 HPH 아앗 HPH 거기, 더 HPH 앙 HPH 전부, 부우 HPH HPH HPH」","L"
						PRINTFORMDW 바라던 대로 양손을 총동원해서 애무해 주자, %조사처리(CALLNAME:TARGET,"는")% 황홀한 몸을 몇 번이나 떨었다…….
					CASE 1
						CALL HPH_PRINT,@"「흐윽, 가버려요, 저도 이제...」","L"
						CALL HPH_PRINT,@"「――앗 하프 아아아악 하프 하프 하프」","L"
						PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"를")% 꽉 껴안고, 그녀의 안에서 모든 욕망을 해방했다.
					CASE 2
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"를")% 세게 껴안고, 질 깊숙이 성기를 밀어 넣어 사정했다.
						CALL HPH_PRINT,@"「크하아아악 HPH 아아... HPH 열, 안 돼... HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 귀를 들고 멍하니 침을 흘리고 있다...
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「저도……응! 움직이면 되는 거군요……? 응!」","L"
						CALL HPH_PRINT,@"「흐으... 하프 하아, 안쪽 하프 음, 응응 하프」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 힘주어 엉덩이를 밀착시키고, 당신의 성기로 질 깊숙한 곳을 주무르고 있다...
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%......여기......큭흐윽」","L"
						CALL HPH_PRINT,@"「흐, 가슴을......윽 HPH 아, 후아앗 HPH」","L"
						PRINTFORMDW 물론 잊고 있지 않다고, 당신은 뒤에서 %조사처리(CALLNAME:TARGET,"의")% 탄력 있는 가슴을 주무르며...
					CASE 2
						PRINTFORMDL 당신은 허리를 움직이면서, %조사처리(CALLNAME:TARGET,"의")% 발기된 유두를 손가락 끝으로 까닥까닥 문질렀다.
						CALL HPH_PRINT,@"「흐, 끅 HPH 힝! HPH 응! HPH 아앗! HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 질과 유두의 자극에 허리를 비틀며 신음하고 있다...
				ENDSELECT
				RETURN 1
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精 && !TEQUIP:MASTER:コンドーム
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「동시에, 핫 HPH 아핫 HPH 크으, 음응 HPH」","L"
						PRINTFORMDL 가슴과 질을 동시에 몰아붙이면서, 당신도 사정감을 높여간다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 질이 강하게 조여온 순간, 당신도 가장 깊숙이 허리를 박았다.
					CASE 1
						CALL HPH_PRINT,@"「잠, 잠시만, 아앗 HPH 하앙! HPH 아아앗 HPH」","L"
						PRINTFORMDL 허리를 들려고 해도, 당신에게 단단히 붙잡혀 빠져나갈 수 없다.
						PRINTFORMDW 어디에 이런 힘이 있을까 생각하는 동시에, 타오르는 듯한 뜨거운 감각이 %조사처리(CALLNAME:TARGET,"의")% 아랫배에 퍼졌다.
					CASE 2
						CALL HPH_PRINT,@"「그런 거! 흐윽! 아아앙!」","L"
						PRINTFORMDL 탄 것처럼 허리를 들썩이며, %조사처리(CALLNAME:TARGET,"의")% 약한 곳을 철저하게 괴롭힌다.
						PRINTFORMDW 양쪽 유두를 꽉 움켜쥐자, %조사처리(CALLNAME:TARGET,"는")% 벌벌 떨며 등을 돌렸다.
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「큭, 아아흐읍 깊, 아앗 흐응」","L"
						PRINTFORMDL 느긋하게 허리를 움직이며 질의 감촉을 음미하면서, 빈 손으로 %조사처리(CALLNAME:TARGET,"의")% 가슴을 농락했다.
						PRINTFORMDW 단단한 유두를 만져주자, 그것에 연동하듯이 질의 조임이 강해졌다.
					CASE 1
						CALL HPH_PRINT,@"「아, 다리를 벌리게 되잖아... 흐윽! 히얏!」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"를")% 밀어붙이면서, 그녀의 목덜미에 키스를 한다.
						CALL HPH_PRINT,@"「거, 거기... 후으... 안쪽...」","W"
					CASE 2
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 연결된 채, 그녀의 하복부를 쓰다듬었다.
						CALL HPH_PRINT,@"「뭐, 뭐... 아앗 HPH 음후, 응... 윽 HPH」","L"
						PRINTFORMDL 질이 꽉 조여들면서 페니스에 강한 자극을 주고 있다.
						PRINTFORMDW 연결되어 있다는 걸 의식시키려고 했지만, 너무 많이 의식시켜 버린 것 같다……
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;膣技術３以上または恋人
	IF ABL:膣 >= 3 || TALENT:恋人
		CALL HPH_PRINT,@"「응, 크윽 HPH 하아……큭HPH」","L"
		PRINTFORMDL 둘이 되자마자, 두 사람은 참아왔던 숨을 후우 하고 내뱉었다.
		CALL HPH_PRINT,@"「정말로…… 모든 것이 들어가는 거군요…… HPH」","L"
		PRINTFORMDL 이 체위에서는 삽입되는 부분이 잘 보일 것이다.
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며, 애틋하게 하복부를 쓰다듬었다...
		RETURN 1
