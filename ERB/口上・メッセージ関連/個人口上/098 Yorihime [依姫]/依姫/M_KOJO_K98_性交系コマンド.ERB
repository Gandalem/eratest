	ELSE
		;膣技術３以上または恋人
		IF ABL:膣 >= 3 || TALENT:恋人
			CALL HPH_PRINT,@"「아, 하아……윽 HPH 아아, 앙……윽 HPH」","L"
			PRINTFORMDL 단단히 밑바닥까지 성기를 넣자, %조사처리(CALLNAME:TARGET,"는")% 황홀하게 숨을 내쉬었다
			CALL HPH_PRINT,@"「움직이네요...윽 HPH 흐응...하아...」","W"
			RETURN 1
			;それ以外
		ELSE
			CALL HPH_PRINT,@"「저, 스스로... 할 수 있으니까... 윽 하아아... 윽 하아아...」","L"
			PRINTFORMDL 천천히, 천천히 허리를 낮추며 마침내 당신의 물건이 모두 삼켜진다.
			PRINTFORMDW 조급해진 탓인지 %조사처리(CALLNAME:TARGET,"의")% 질은 기다려온 개처럼 페니스에 달라붙어 온다...
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
