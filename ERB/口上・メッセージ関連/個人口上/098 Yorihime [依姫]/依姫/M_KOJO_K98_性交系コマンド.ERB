	ELSE
		CALL HPH_PRINT,@"「이 자세, 체중이......윽 HPH 아아앗 HPH」","L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 허리에 손을 대고, 조금씩 힘을 실었다.
		PRINTFORMDW 저항하듯 떠 있던 %조사처리(CALLNAME:TARGET,"의")% 허리는 그것으로 완전히 당신의 살과 밀착했다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
