						PRINTFORMDL 위아래로 흔들리는 %조사처리(CALLNAME:TARGET,"를")% 꼭 끌어안고 허리를 밀어 올렸다.
						PRINTFORMDW 그리고 그대로 페니스를 빼지 않은 채 당신은 %조사처리(CALLNAME:TARGET,"와")% 연결된 채 사정했다.
					CASE 1
						CALL HPH_PRINT,@"「응흐읍 HPH 멈춰줘 HPH 주륵 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 입을 막고, 혀를 얽히게 하면서 허리를 움직였다.
						PRINTFORMDW 괴로워하며 두드려오는 것을 무시하고, 당신은 %조사처리(CALLNAME:TARGET,"의")% 질을 갈았다.
					CASE 2
						CALL HPH_PRINT,@"「야응! 흐으윽, 이거 사정이야...!」","L"
						PRINTFORMDL 질 안에서 굵은 성기가 파르르, 파르르 떨리며 귀두에서 정액이 뿜어져 나갔다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 그 열은 아타기님의 불보다 더 뜨겁게 느껴지는 것이었다.
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「음... 음... 큭 히히 하아... 응... 큭」","L"
						PRINTFORMDL 조심스럽게 허리를 움직이며, %조사처리(CALLNAME:TARGET,"와")% 하나가 된 감각을 즐긴다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 안은 매우 뜨겁고, 그렇기에 기분이 좋다……
					CASE 1
						CALL HPH_PRINT,@"「음... 츄... HPH 파... 음... HPH」","L"
						PRINTFORMDL 얼굴이 가까이에 있으니 어쩔 수 없이 끌려간다.
						PRINTFORMDW 당신은 느긋하게 허리를 움직이며, %조사처리(CALLNAME:TARGET,"의")% 입술도 맛보았다.
					CASE 2
						CALL HPH_PRINT,@"「아, 응으윽 HPH 흥, 하앙 HPH」","L"
						PRINTFORMDL 조금 더 격렬하게 허리를 밀어붙이며, %조사처리(CALLNAME:TARGET,"의")% 반응을 본다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신의 어깨를 꽉 잡고, 쾌감에 견디고 있다……
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;膣技術３以上または恋人
	IF ABL:膣 >= 3 || TALENT:恋人
		CALL HPH_PRINT,@"「하아...윽 HPH 안쪽까지, 도달하고 있어...윽 HPH」","L"
		PRINTFORMDL 이 체위에서는 쾌락에 일그러지는 %조사처리(CALLNAME:TARGET,"의")% 얼굴이 잘 보인다.
		PRINTFORMDW 당장이라도 거칠게 골반을 흔들고 싶은 충동을 누르면서, 당신은 천천히 허리를 움직이기 시작했다……
		RETURN 1
		;それ以外
	ELSE
		CALL HPH_PRINT,@"「아, 너무 얼굴을 보지 말아 주세요...윽 HPH」","L"
		PRINTFORMDL 남성과 연결되고, 게다가 여유 없는 얼굴까지 보여지고 만다.
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부끄러워서... 부끄러워서 견딜 수 없을 것 같다.
		RETURN 1
	ENDIF
ENDIF
