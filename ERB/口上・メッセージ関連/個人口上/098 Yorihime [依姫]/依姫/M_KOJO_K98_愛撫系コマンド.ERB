; Modular ERB: 個人口上/098 Yorihime [依姫]/依姫/M_KOJO_K98_愛撫系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;愛撫系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;0,愛撫
;==================================================
;==================================================
;（任意）:通常の地の文を表示するかスキップするか決定する。
;MESSAGECHECK関数は、以下のような戻り値を返す
;RETURN 0;通常地の文と口上を表示
;RETURN 1;口上のみ表示
;RETURN 2;通常地の文のみ表示
;RETURN 3;どちらも表示しない
;以下原文
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_0
RETURN 0

@M_KOJO_MESSAGE_COM_K98_0
CALL M_KOJO_MESSAGE_COM_K98_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;ＶorＡに挿入中
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;依姫が絶頂
		IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ｍ絶頂
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「흐윽, 끄윽 하아아아앗 하프 하프 하프」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 도달한 것과 동시에, 당신도 허리를 밀어 넣고 사정했다.
						CALL HPH_PRINT,@"「아아......사정해......윽 HPH 하아......윽 HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「흐윽, 지금은 하아큿 하앙! 하프 하프 하프」","L"
						PRINTFORMDL 절정에 빠지지 않도록 %조사처리(CALLNAME:TARGET,"의")% 점막을, 뒤로 젖혀지는 남근으로 구츄구츄 비볐다.
						PRINTFORMDW 계속 참아왔던 만큼, 당신의 가차 없는 피스톤질로 %조사처리(CALLNAME:TARGET,"를")% 몰아붙였다.
					CASE 2
						CALL HPH_PRINT,@"「크하앗 HPH 아앗 HPH 응아앗 HPH HPH HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 혀를, 당신은 허리를 밀어내며 동시에 절정에 달했다
						CALL HPH_PRINT,@"「하아... 하아... 큭, 츄... 큭」","L"
						PRINTFORMDW 절정의 여운이 가라앉자, 두 사람은 말없이 그저 입술을 포개었다…….
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「흐아, 아앗 흐으응 하아아앗 흐으응 흐으응 흐으응」","L"
						PRINTFORMDL 등을 돌리고 몸을 떨며 %조사처리(CALLNAME:TARGET,"가")% 절정에 이른다.
						PRINTFORMDW 삽입된 당신의 것이, %조사처리(CALLNAME:TARGET,"의")% 안에서 단단하게 조여진다……
					CASE 1
						CALL HPH_PRINT,@"「흐읍, 안! 힉, 음음! 힉 힉 힉」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 절정에 달하고, 큥 하고 육봉이 조여왔다.
						PRINTFORMDW 이대로 가버릴 것 같았다. 당신은 부드럽게 움직이고 있던 허리의 움직임을 멈췄다.
					CASE 2
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 절정에 달하는 타이밍을 노리고, 당신은 훅 허리를 밀어넣었다.
						CALL HPH_PRINT,@"「흐윽 하아앗! 아앗!? 하아앗 하아앗 하아앗」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 가라앉지 않는 절정감에 벌벌 떨며 몸을 떨고 있다...
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;膣orアナル技術が３以上
			IF ABL:膣 > 2 || ABL:アナル > 2
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「히아, 음으윽 HPH 아, 하앗 HPH」","L"
						PRINTFORMDL 당신의 손이 닿을 때마다, %조사처리(CALLNAME:TARGET,"의")% 안쪽이 황홀함에 조여온다.
						PRINTFORMDW 녹아내리는 듯한 감각 속에서, 두 사람은 육욕 그대로 서로를 끌어안는다...
					CASE 1
						CALL HPH_PRINT,@"「그런, 깊다아아앙」","L"
						PRINTFORMDL 그렇게 말하는 %조사처리(CALLNAME:TARGET,"지만")%, 허리를 밀어붙이고 있는 건 그녀 쪽이다
						CALL HPH_PRINT,@"「캬앗 HPH 안 돼, 엣 HPH 아아응 HPH」","W"
					CASE 2
						CALL HPH_PRINT,@"「응쿠후으읍 하아, 어앗 하아 안쪽, 응! 하아」","L"
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 요구에 응하여 허리를 깊숙이 박아 넣었다
						CALL HPH_PRINT,@"「크으아앗 HPH 파, 아앗 HPH 아앙 HPH」","W"
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「히아...응...윽 HPH 아앗 HPH 응하아...윽 HPH」","L"
						PRINTFORMDL 일정한 페이스로 허리를 움직이며, %조사처리(CALLNAME:TARGET,"의")% 피부에 손을 가져간다.
						PRINTFORMDW 안팎으로 애무당하며, %조사처리(CALLNAME:TARGET,"의")% 몸은 완전히 뜨거워지고 있다……
					CASE 1
						CALL HPH_PRINT,@"「하아......응으......큭, 크윽......큭」","L"
						PRINTFORMDL 가슴 아프게 신음하는 %조사처리(CALLNAME:TARGET,"에게")% 얼굴을 가까이 대고 입술을 빼앗는다.
						CALL HPH_PRINT,@"「푸하...츄...후우...응...윽 HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈을 감고, 당신과 혀를 얽히게 하고 있다...
					CASE 2
						CALL HPH_PRINT,@"「흐아, 아아……읏 HPH 이, 으응……읏 HPH」","L"
						PRINTFORMDL 종족을 찾는 것처럼 육구멍이 수축하고, 당신도 자신도 모르게 허리가 움직인다.
						PRINTFORMDW 의식을 돌리기 위해, 당신은 %조사처리(CALLNAME:TARGET,"의")% 흔들리는 가슴으로 손을 뻗었다.
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;依姫が絶頂
	ELSEIF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ｍ絶頂
		;ＣorＢorＭ感覚が１０以上
		IF ABL:Ｃ感覚 > 9 || ABL:Ｂ感覚 > 9 || ABL:Ｍ感覚 > 9
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「저, 벌써 가버려 HPH 히안! HPH」","L"
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"를")% 절게 하기 위해, 끊임없이 애무를 이어나간다...
					CALL HPH_PRINT,@"「얏HPH 또HPH 또HPH 가, 크으윽HPH HPH HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「좋아앗 HPH 아, 아아앗 HPH ――아하아…… HPH」","L"
					PRINTFORMDL 큐욱 다리를 오므리고 %조사처리(CALLNAME:TARGET,"가")% 절정에 도달한다.
					PRINTFORMDW 여운 속에서 %조사처리(CALLNAME:TARGET,"가")% 행복해하는 사이에, 당신은 손가락에 묻은 애액을 핥았다.
				CASE 2
					CALL HPH_PRINT,@"「아, 크으응ㅎㅍㅎ ㅎㅍ ㅎㅍ —앗, 하아...ㅎㅍ」","L"
					PRINTFORMDL 「가버렸나?」라고 당신은 %조사처리(CALLNAME:TARGET,"의")% 귓가에서 속삭였다.
					CALL HPH_PRINT,@"「하아... 하아... 에...? 하프」","L"
					PRINTFORMDW 아주 절정에 깊이 빠졌던 것인지, %조사처리(CALLNAME:TARGET,"는")% 당신의 말을 듣지 못한 모양이다...
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「아, 잠깐... 하헵-윽, 음응! 하헵」","L"
					PRINTFORMDL 벌벌 떨며 몸을 떨면서 %조사처리(CALLNAME:TARGET,"가")% 절정에 이른다.
					PRINTFORMDW 당신은 애무하는 손을 멈추고, 절정의 물결이 가라앉을 때까지 %조사처리(CALLNAME:TARGET,"의")% 머리를 계속 쓰다듬었다.
				CASE 1
					CALL HPH_PRINT,@"「야, 응! 후우... 크윽, 아, 아아앗!」","L"
					PRINTFORMDL 절정에 도달한 %조사처리(CALLNAME:TARGET,"가")% 신음소리를 주변에 울리게 한다.
					CALL HPH_PRINT,@"(나, 목소리... 흑흑 부끄러워... 흑흑)","W"
				CASE 2
					CALL HPH_PRINT,@"「거기, 아앗 HPH 안 돼, 엣 HPH」","L"
					PRINTFORMDL 여기가 맞다라며 당신은 그 부분을 집중적으로 자극했다.
					CALL HPH_PRINT,@"「안 돼, 큭흐읍 흐윽 아아앗 흐윽」","W"
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;ＣorＢorＭ感覚のどれかが１０以上
		IF ABL:Ｃ感覚 > 9 || ABL:Ｂ感覚 > 9 || ABL:Ｍ感覚 > 9
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「윽, 하앗 HPH 아앗 HPH 응아앗 HPH」","L"
					PRINTFORMDL 어디를 어떻게 만져도, %조사처리(CALLNAME:TARGET,"는")% 민감하게 반응해준다
					PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"가")% 금방 가지 않도록, 강약을 조절하며 애무를 계속했다
				CASE 1
					CALL HPH_PRINT,@"「하아......응......큭, 음......크윽......」","L"
					PRINTFORMDL 민감한 곳은 일부러 피하며, 애태우는 듯한 애무를 계속한다.
					CALL HPH_PRINT,@"(말할 수 없어... 하지만, 아아... 조금만 더인데... 헉)","W"
				CASE 2
					CALL HPH_PRINT,@"「응흥흡 흐으, 츄... 주르... 흡흥」","L"
					PRINTFORMDL 입이 마른 듯했던 %조사처리(CALLNAME:TARGET,"의")% 입술을 빼앗아, 질척하게 혀를 얽히게 했다.
					PRINTFORMDW 그대로 애무를 재개하자, %조사처리(CALLNAME:TARGET,"는")% 목구멍 깊은 곳에서 참지 못하는 신음을 흘렸다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음... 크윽... 하프 아... 음... 하프」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 가슴 꼭대기에 키스하며, 은밀한 곳을 부드럽게 손가락으로 문지른다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%, 간지러운 듯 몸을 비틀고 있다…….
				CASE 1
					CALL HPH_PRINT,@"(그저... 그가 만지고 있을 뿐인데... 큭흐)","L"
					CALL HPH_PRINT,@"(어째서... 이렇게 짜릿한 거지... 큭큭)","L"
					PRINTFORMDW %TEXTR("음핵/유두/")%를 손가락으로 집어 올리자, %조사처리(CALLNAME:TARGET,"는")% 움찔하며 몸을 떨었다.
				CASE 2
					CALL HPH_PRINT,@"「윽, 으응……흐읍 흐읍 하아……음……흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 무언가를 참는 듯 눈썹을 팔자 모양으로 일그러뜨리고 있다.
					PRINTFORMDW 좀 더 솔직해졌으면 좋겠다. 그렇게 생각하며 당신은 애무를 계속했다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
