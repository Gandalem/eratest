					CALL HPH_PRINT,@"「더 세게……격렬하게……윽 HPH」","L"
					CALL HPH_PRINT,@"「부탁이야... 그러니까... 아앗 HPH」","L"
					PRINTFORMDW 당신이 손에 힘을 주자, %조사처리(CALLNAME:TARGET,"는")% 기쁨의 신음을 터뜨렸다.
				CASE 1
					PRINTFORMDL 당신은 힘을 풀고, 쓸어내리듯이 가슴을 쓰다듬는다.
					CALL HPH_PRINT,@"「아……으윽…큭 흐읍…」","L"
					CALL HPH_PRINT,@"「오, 가슴... 애태우는 거야... 싫어... 헉」","L"
					PRINTFORMDW 부끄러움에 얼굴을 새빨갛게 물린 채, %조사처리(CALLNAME:TARGET,"는")% 당신에게 그렇게 애원했다.
				CASE 2
					PRINTFORMDL 당신은 천천히, 마치 음식을 씹듯이 가슴을 주무른다
					CALL HPH_PRINT,@"「음후……파……윽 HPH 하아……%CALLNAME:MASTER%……윽 HPH」","L"
					PRINTFORMDW 먹히고 있는 %조사처리(CALLNAME:TARGET,"는")%, 황홀하게 숨을 내쉬고 있다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「그게... 윽, 하아 너무... 세게 주무르면... 윽, 하아」","L"
					PRINTFORMDL 숨소리가 섞인 목소리를 내며, %조사처리(CALLNAME:TARGET,"가")% 가볍게 몸을 움직인다.
					CALL HPH_PRINT,@"「조금... 하아앗 HPH 들어줘... 응응! HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「응……힉! HPH 더……상냥하게……큭HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 반응을 보면서, 강약을 주어 가슴을 주무른다.
					PRINTFORMDW 당신의 애무 하나하나에, %조사처리(CALLNAME:TARGET,"는")% 귀엽게 반응하고 있다.
				CASE 2
					CALL HPH_PRINT,@"「흡... 후우... 후우... 헉, 하아」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 목소리가 새지 않도록 검지로 깨물어 참는다.
					PRINTFORMDW 하지만 새어 나오는 숨결은 완전히 녹아 달콤한 것이 되어버렸다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
