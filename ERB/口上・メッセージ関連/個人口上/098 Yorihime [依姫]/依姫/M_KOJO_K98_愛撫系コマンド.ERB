;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_1
RETURN 0

@M_KOJO_MESSAGE_COM_K98_1
CALL M_KOJO_MESSAGE_COM_K98_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER && TCVAR:102
		;膣射中毒が５以上の場合に２分の１で表示
		IF ABL:膣射中毒 > 4 && !RAND:2
			PRINTFORML (......아깝다......)
			PRINTFORML (나, 대체 무슨 생각을 하고 있는 거야......!)
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 내가 이미 질사중독이 되어버렸다는 것을 눈치채지 못하고 있다......
			;それ以外
		ELSE
			CALL HPH_PRINT,@"「하아... 하아... 흑 앙... 음... 흑」","L"
			PRINTFORMDL 코포코포하고 정액을 흘리는 %조사처리(CALLNAME:TARGET,"의")% 질을, 당신은 보살피듯이 핥아 부드럽게 만들었다.
			PRINTFORMDW 두 사람의 사랑이 뒤섞인 체액은, 도저히 형언할 수 없는 맛이었다…….
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;Ｃ感覚が１０以上
		IF ABL:Ｃ感覚 > 9
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「더, 아앗 HPH 좋아아아아 HPH HPH HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 질에 입을 대고 일부러 저속한 소리를 내며 꿀을 빨았다.
					PRINTFORMDW 「싫어」라고도 「그만해」라고도 말하지 않고, %조사처리(CALLNAME:TARGET,"는")% 「더」라며 당신을 계속 원했다.
				CASE 1
					CALL HPH_PRINT,@"「스, 아앗 HPH 나카, 안! HPH 까지... HPH HPH」","L"
					PRINTFORMDL 거친 혀가 질 속을 자기 것인 양 헤집고 다닌다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 허리를 들썩이며, 몇 번이고 또 절정에 이르고 있다……
				CASE 2
					CALL HPH_PRINT,@"「아앙! 으윽, 기분 좋아, 응! 흐읍 하하하」","L"
					PRINTFORMDL 당신의 혀 기술에 %조사처리(CALLNAME:TARGET,"는")% 완전히 사로잡혔다.
					PRINTFORMDW 볼록한 음핵을 달콤하게 깨물자, %조사처리(CALLNAME:TARGET,"는")% 신음을 내며 절정에 이르렀다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「뭐, 삼키지 마... 큭 아앙!」","L"
					PRINTFORMDL 절정에 달한 %조사처리(CALLNAME:TARGET,"의")% 질 입구가 파닥파닥 열리고 닫힌다.
					PRINTFORMDW 당신은 숨결이 닿을 정도의 거리에서, 그 모습을 관찰했다.
				CASE 1
					CALL HPH_PRINT,@"「야아앗 HPH 히, 크윽 HPH 음으음 HPH」","L"
					CALL HPH_PRINT,@"(나... 놀림당해서, 가버려... 큭큭)","L"
					PRINTFORMDW 절정의 파도가 물러가자, %조사처리(CALLNAME:TARGET,"는")% 축 늘어졌다...
				CASE 2
					CALL HPH_PRINT,@"「잠깐, 기다려! 하아... 그 이상은, 아앗!」","L"
					PRINTFORMDL 도망치는 허리를 누르며, 축축하게 젖은 비단 입술을 우적우적 물어뜯는다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 도달해도, 당신은 핥는 것을 멈추지 않았다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚が１０以上
	ELSEIF ABL:Ｃ感覚 > 9
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「히안! HPH 아아! HPH 음후, 아아!」","L"
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 다리로 당신의 머리를 감싸 안고, 거칠게 은밀한 곳에 밀어붙이고 있다.
				PRINTFORMDW 무의식적인 행동이겠지만, 괴로우니 자제해 주었으면 해……
			CASE 1
