		;それ以外
	ELSE
		;Ｍ感覚が１０以上
		IF ABL:Ｍ感覚 > 9
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음, 후...큭 HPH 키스...쪽...큭 HPH」","L"
					CALL HPH_PRINT,@"(키스를 하자... 머리가 아찔해져서... HPH)","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 순종적으로 당신에게 입술을 바치고 있다...
				CASE 1
					CALL HPH_PRINT,@"「흐읍, 하후... 흠흥... 쪽... 흠흥」","L"
					PRINTFORMDL 끌어안으며 키스를 하고, 아랫입술을 가볍게 깨물었다.
					PRINTFORMDW 그렇게 하자, 이번에는 %CALLNAME:TARGET%쪽에서 입술을 찾았다.
				CASE 2
					CALL HPH_PRINT,@"「음후, 츄릅 HPH 후우, 음후옷 HPH」","L"
					PRINTFORMDL 한번 성감대로 의식해버리면 더는 멈출 수 없어.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 쾌락을 얻기 위해, 스스로 당신의 입술을 원했다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음... 읍... HPH 후우... 츄... 윽 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"를")% 끌어안으며 몇 번이고 입맞춤을 나눈다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 긴장하여, 완전히 마음대로 되어버렸다...
				CASE 1
					CALL HPH_PRINT,@"「음후... 츄... HPH 음쪽!? HPH 주루... 윽 HPH」","L"
					PRINTFORMDL 살짝 벌어진 입안에 혀를 집어넣고, 도망치려는 혀를 얽매다
					PRINTFORMDW 그대로 자신 쪽으로 끌어당겨 침과 함께 빨아들였다
				CASE 2
					CALL HPH_PRINT,@"「흡헉 하아... 하아...윽 하프」","L"
					PRINTFORMDL 그저 입술을 맞대는 것과는 다른, 살과 살이 뒤얽히는 농밀한 키스
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 입 주변을 침으로 적긴 채, 멍하니 당신을 바라보고 있다……
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
