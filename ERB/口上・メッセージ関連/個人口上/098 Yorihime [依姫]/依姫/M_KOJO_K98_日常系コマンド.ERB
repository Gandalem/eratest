		ELSEIF TALENT:恋慕
			;顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "通常", "裸", "", ""
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「평소에는 어딘가 의지할 수 없어 보이는데……」
					PRINTFORML 「이렇게 보니, 크네요. 당신의 등은」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 그렇게 말해져, 당신은 조금 부끄러워졌다
				CASE 1
					PRINTFORMDL 당신은 등을 닦아준 %조사처리(CALLNAME:TARGET,"에게")% 감사를 표했다.
					PRINTFORML 「――감사하다고 내 등을...? 아, 아니에요, 저는읏」
					PRINTFORMDW 뭐 아무튼 %조사처리(CALLNAME:TARGET,"를")% 욕조 의자에 앉히고, 당신은 그녀의 등을 닦아주었다.
				CASE 2
					PRINTFORML 「――조금 더 세게? 이 정도인가요?」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 거칠게 당신의 등을 문지른다.
					PRINTFORMDW 역시, 스스로 씻는 것보다 누군가에게 씻김을 받는 쪽이 기분이 좋다…….
			ENDSELECT
			;それ以外
		ELSE
			;発情顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "発情", "裸", "", ""
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「어째서 제가 이런 것을…」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 거품을 내며 당신의 등을 씻기고 있다.
					PRINTFORMDW 전에도 부탁했지만, 아무래도 그것은 거절당하고 말았다.
				CASE 1
					PRINTFORML 「――언니랑 같이 들어갈 거야?」
					PRINTFORML 「뭐, 가끔은... 라고, 왜 이런 걸 당신에게 말해야 하는 거지...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 중얼거리며 당신의 등을 씻기고 있다...
				CASE 2
					PRINTFORML 「하아……」
