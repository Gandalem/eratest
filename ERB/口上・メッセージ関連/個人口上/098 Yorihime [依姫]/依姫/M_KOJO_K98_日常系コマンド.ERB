IF LOCAL
	SELECTCASE Activity_Type:TARGET
		CASE 0
			;▼考え事［なに考えてるの］
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 무슨 고민이 있는지 물었다.
			PRINTFORMDW 
			;恋慕
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「사실은, 이번 연회의 주최를 맡게 되어……」
						PRINTFORML 「하아…… 원래는 언니가 할 예정이었는데」
						PRINTFORMDW 노라리쿠리토 토요히메가 도망치자 결국 %조사처리(CALLNAME:TARGET,"가")% 하게 된 모양이다……
					CASE 1
						PRINTFORML 「%TEXTR("토끼들의 수련/달의 방위/누나의 몸무게/")%」에 대해 조금……
						PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 고민을 상담받았다.
						PRINTFORMDW 자신 나름의 의견을 전하자, %조사처리(CALLNAME:TARGET,"는")% 납득한 듯 고개를 끄덕였다.
					CASE 2
						PRINTFORML 「고민이랄까...」
						PRINTFORML 「...저는 토끼들에게 미움받는 걸까요?」
						PRINTFORMDW 무슨 일이 있었는지는 모르지만, 그런 일은 없다고 %조사처리(CALLNAME:TARGET,"를")% 위로했다
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아니, 별거 아니거든」
						PRINTFORML 「――신경 쓰이나? 그러니까 대단한 게 아니라고 말하고 있잖아.」
						PRINTFORMDW 뭔가 고민하는 것 같지만 %조사처리(CALLNAME:TARGET,"는")% 알려주지 않았다
					CASE 1
						PRINTFORML 「당신에게 말할 필요는 없을 것 같지만」
						PRINTFORML 「......대단한 일은 아닙니다. 정말이에요」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"에게")% 얼버무려 버렸다……
					CASE 2
						PRINTFORML 「달의 방위, 토끼들의 수련, 언니님의 영양 관리」
						PRINTFORML 「게다가 당신에 대한 감시. 네, 확실히 고민거리들이 있습니다. 그것도 산더미처럼요」
						PRINTFORMDW 「그러니 조용히 있어 주세요」라고 %조사처리(CALLNAME:TARGET,"에게")% 못 박혀버렸다
				ENDSELECT
			ENDIF
		CASE 2
			;▼食事［一緒に食事する］
			PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 같이 식사를 하기로 했다
			PRINTFORMDW 
			;恋慕
			IF TALENT:恋慕
