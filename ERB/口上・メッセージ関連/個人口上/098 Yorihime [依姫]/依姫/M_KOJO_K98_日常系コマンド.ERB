			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「흐으음... 흠... 읍 HPH 음... 후우... 읍 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"를")% 품에 안고, 마음껏 입술을 탐했다.
					PRINTFORMDW 입술만으로는 만족할 수 없어, 두 사람은 곧 혀를 얽었다.
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……그게……저도……HPH」","L"
					CALL HPH_PRINT,@"「음... 츄...윽 HPH 츄... 음후...윽 HPH」","L"
					PRINTFORMDW 드물게 적극적인 %조사처리(CALLNAME:TARGET,"의")% 입술 감촉을 당신은 즐겼다……
