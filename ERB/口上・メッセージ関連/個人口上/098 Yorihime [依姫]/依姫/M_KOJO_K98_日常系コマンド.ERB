@M_KOJO_MESSAGE_COM_K98_605_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMDL 지나가던 길에, 아름다운 털을 가진 고양이가 발밑으로 다가왔다.
				PRINTFORML (어, 귀엽다……하지만 데려가는 건……)
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 쪼그리고 앉아 고양이의 머리를 쓰다듬고 있다.
				PRINTFORMDW 사람에게 익숙한 것 같다. 지역 고양이 같은 존재일까.
			CASE 1
				PRINTFORMDL 들르는 도중에 길 잃은 아이를 발견했다
				PRINTFORML 「자, 울지 마. 남자아이잖아?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 그렇게 말하자, 남자아이는 흥건하게 콧물 범벅인 얼굴을 비볐다
				PRINTFORMDW 일단 마을까지 데려다주자……
			CASE 2
				PRINTFORMDL 잠시 들러 둘이서 풍경을 바라보았다.
				PRINTFORML 「이루어지지 않을지도 모르겠지만……」
				PRINTFORML 「언젠가 언니나 야쿠모님, 당신도 포함해서 모두 함께……」
				PRINTFORMDW 환상향의 풍경은 오늘도 매우 좋았다.
			CASE 3
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 길에서 만난 강아지를 귀여워하고 있다.
				PRINTFORMW 「저, 저기! 거기는...윽」
				PRINTFORMDL 강아지는 요리히메를 밀치고는 놀랍게도 치마 속으로 얼굴을 파묻고 냄새를 맡기 시작했다!
				PRINTFORMDW '이런 못된 녀석!' 하고 강아지를 보자, 설마 수컷이 아니라 암캐였다.
				PRINTFORMW 「히얏! 크, 크큭! 그만둬라 정말!」
				PRINTFORMDL 강아지는 여전히 킁킁거리며 냄새를 맡고 있다.
				PRINTFORMDW %CALLNAME:TARGET%싫어하지 않는 것 같으니, 뭐 괜찮겠지...
			CASE 4
				;１日１回だけストーキング中の豊姫と遭遇
				IF !TCVAR:[[依姫]]:350
					PRINTFORMDW 길을 들르는 도중에 어째선지 토요히메와 스쳐 지나갔다.
					;笑顔絵を表示（オプションでオンにしていないと表示されない）
					CALL PRINT_FACE, [[豊姫]], "笑顔", "服", "", ""
					CALL M_KOJO_COLOR_K99
					PRINTFORMW 「어머, 우연이네. 두 사람 다 데이트 즐기고 있어?」
					;顔絵を表示（オプションでオンにしていないと表示されない）
					CALL PRINT_FACE, [[依姫]], "通常", "服", "", ""
					CALL M_KOJO_COLOR_K98
					PRINTFORMW 「아니, 뭐……」
					PRINTFORMW 「그렇지 않아, 언니. 토끼들의 연습을 보고 계실 터잖아?」
					CALL PRINT_FACE, [[豊姫]], "通常", "服", "", ""
					CALL M_KOJO_COLOR_K99
					PRINTFORMW 「그랬었을까? 그런 약속도 했던 것 같은데……」
					CALL PRINT_FACE, [[依姫]], "怒り", "服", "", ""
					CALL M_KOJO_COLOR_K98
					PRINTFORMW 「방금 한 얘기예요……. 벌써……」
					PRINTFORMDL 토요히메는 %조사처리(CALLNAME:TARGET,"의")% 설교를 「네네」 하고 대충 흘려듣고 있다.
					PRINTFORMDW 정말 골치 아픈 언니구나…….
					TCVAR:[[依姫]]:350 = 1
					RESETCOLOR
					;以降は下を読み込む
				ELSE
					GOTO YORIHIME_YORIMICHI
				ENDIF
		ENDSELECT
		;それ以外
	ELSE
		$YORIHIME_YORIMICHI
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「지상은 더러움으로 가득 차 있고, 동시에 소란스럽기도 하다. 당신은 아무것도 느끼지 못하나요?」
				PRINTFORMDL 주변을 산책하고 있자 바람에 실려 여러 가지 소리가 들려온다
				PRINTFORMDW 당신은 아무것도 느끼지 않지만, %조사처리(CALLNAME:TARGET,"는")% 어딘가 불안해하는 모습이다
			CASE 1
				PRINTFORML 「그런데, 도대체 어디까지……」
				PRINTFORMDL 딱히 정해진 목적은 없지만, 조금이라도 길게 데이트를 즐기고 싶다.
				PRINTFORMDW 당신은 적당히 둘러대면서 %조사처리(CALLNAME:TARGET,"와")% 함께 주변을 산책했다.
			CASE 2
				PRINTFORML 「――길을 벗어나? 어디로 가는 거야?」
				PRINTFORMDL 잠깐 거기까지만. 당신은 %조사처리(CALLNAME:TARGET,"와")% 함께 걸었다
				PRINTFORMDW ……특별히 눈에 띄는 것은 없었다
			CASE 3
				PRINTFORML 「――? 뭔가 신경 쓰이는 일이라도 있어?」
				PRINTFORMDL 신경 쓰인다면, 옆에서 걷는 %조사처리(CALLNAME:TARGET,"의")% 일이 매우 신경 쓰인다.
				PRINTFORMDW 그녀는 이 데이트를 즐기고 있을까……
			CASE 4
				PRINTFORML 「――칼은 무겁지 않나?」
				PRINTFORML 「익숙하니까, 그다지 그렇지 않아」
				PRINTFORMDW 당신과 %조사처리(CALLNAME:TARGET,"는")% 걸으면서 여러 가지 이야기를 나누었다……
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
