@M_KOJO_MESSAGE_COM_K98_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:睡眠
		PRINTFORML 
		RETURN 1
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「슬슬 토끼들 상태를 보러 가야겠어.」
					PRINTFORML 「당신은 쉬고 계세요. 금방 돌아올게요.」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 비워진 물통을 내려놓고, 수련장으로 향했다.
					PRINTFORMDW 그녀에게는 당연한 일일 테지만, 역시 관리직은 힘들다……
				CASE 1
					PRINTFORMDL 당신은 휴식 삼아 %조사처리(CALLNAME:TARGET,"와")% %TEXTR("오셀로/장기/바둑/")%으로 놀았다.
					PRINTFORML 「%TEXTR("くっ……こんな筈では……/勝負あり、といったところでしょうか/")%」
					PRINTFORMDW %CALLNAME:TARGET%도 즐거워해 준 것 같다. 또 불러주자
				CASE 2
					PRINTFORMDL 휴식 중에도 %조사처리(CALLNAME:TARGET,"는")% 단련을 게을리하지 않는다.
					PRINTFORML 「후우……」
					PRINTFORMDL 기본 동작을 마친 %조사처리(CALLNAME:TARGET,"가")% 땀을 닦는다.
					PRINTFORMDW 문득 눈이 마주친다. 미소 짓는 %조사처리(CALLNAME:TARGET,"에게")% 당신은 가볍게 손을 흔들며 응답했다.
			ENDSELECT
			;思慕
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 한가해서, 당신은 %조사처리(CALLNAME:TARGET,"와")% 장기를 두며 놀았다.
					PRINTFORML 「언니도 가끔 토끼들과 함께 장기를 두고 있다고 들었습니다」
					PRINTFORML 「연전 연승이라던걸요. 뭐, 언니라면 당연하겠죠」
					PRINTFORMDW -- %TEXTR("감사합니다/졌어요/")%. 꽤나 치열했던 싸움이었다...
				CASE 1
					PRINTFORML 「쉬고 계세요. 차를 타 오겠습니다.」
					PRINTFORMDL 말씀에 응해 앉아 있자, %조사처리(CALLNAME:TARGET,"가")% 차와 과자를 가져왔다.
					PRINTFORMDW 정말 배려심이 깊네. 누나에게 받고 싶을 정도야.
				CASE 2
					PRINTFORMDL 나란히 쉬고 있자 %조사처리(CALLNAME:TARGET,"가")% 기대왔다.
					PRINTFORML 「……스으……스으……」
					PRINTFORMDW ……조금만 재워주자.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「훗! 훗!」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 조용히 검의 소리 연습을 하고 있다.
					PRINTFORMDW 뭐, 기분 전환이 된다면 무엇이든 괜찮겠지…….
				CASE 1
					PRINTFORML 「아무것도 하지 않고, 그저 몸을 쉬게 한다. 시간을 낭비하고 있는 기분이 들어 견딜 수가 없다」
					PRINTFORML 「――그럼 놀까? 어째서 그렇게 되는 거죠……」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 한숨을 내쉰다. 이대로라면 언젠가 부서져 버릴 것 같다
				CASE 2
					PRINTFORML 「――언니가 나한테 쉬라고?」
					PRINTFORML 「하아…… 그렇다면, 조금은 일을 대신 해 줄 수도 있을 텐데」
					PRINTFORMDW 너무 타당해서, 당신은 아무 말도 할 수 없었다
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
