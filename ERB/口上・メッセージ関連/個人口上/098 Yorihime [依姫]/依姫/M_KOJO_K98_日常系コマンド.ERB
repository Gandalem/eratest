			;笑顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "笑顔", "服", "", ""
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「……좀, 가렵네요」
					PRINTFORMDL 입술을 떼자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 미소 지었다.
					PRINTFORMDW 이 사랑스러운 표정은 분명 언니에게도 보여준 적이 없을 것이다
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%, 조금 더 머리에……」
					PRINTFORML 「응, 그대로……응윽……」
					PRINTFORMDW 당신이 키스하자, %CALLNAME:TARGET%도 답례로 키스를 해 주었다
				CASE 2
					PRINTFORML 「…………♪」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 눈을 감고, 가만히 무언가를 기다리고 있었다.
					PRINTFORMDW 아, 잊고 있었다. 당신이 그렇게 말하자, %조사처리(CALLNAME:TARGET,"의")% 이마에 살며 입맞춤했다.
			ENDSELECT
			;恋慕
		ELSEIF TALENT:恋慕
			;発情顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML (......딱 그쪽이 아니어도......)
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 만족한 듯 얼굴을 붉히고 있다.
					PRINTFORMDW 독차지하고 싶다고 생각할 정도로, 그 반응은 귀엽다.
				CASE 1
					PRINTFORML 「아……」
					PRINTFORML (입술이 아니었다……)
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 더 다른 무언가를 당신에게 바라고 있는 것 같다……
				CASE 2
					PRINTFORMDL 당신은 %CALLNAME:TARGET%에게도 이마에 키스해 달라고 애원했다.
					PRINTFORML 「네, 알겠습니다... 그, 눈을...」
					PRINTFORMDW 당신이 눈을 감자, 몇 초 뒤 이마에 부드러운 것이 닿는 감촉이 느껴졌다.
			ENDSELECT
			;思慕
		ELSEIF TALENT:思慕
			;発情顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「뭐... 뭐야...?」
					PRINTFORMDL 지금 자신이 무슨 일을 당했는지
					PRINTFORMDW 그것을 이해하는 동시에, %조사처리(CALLNAME:TARGET,"의")% 얼굴이 확 붉어졌다
				CASE 1
					PRINTFORML 「앗, 흐윽...」
					PRINTFORML 「이렇게... 부끄럽지 않으신가요...?」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 이마를 감싸고 있다...
				CASE 2
					PRINTFORML 「아……거기, 말인가요……」
					PRINTFORMDL 안심한 듯하면서도, 조금 아쉬운 듯하다.
					PRINTFORMDW 당신이 고개를 기울이자, %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 얼굴을 돌렸다
			ENDSELECT
			;それ以外
		ELSE
			;発情顔絵を表示（オプションでオンにしていないと表示されない）
			CALL PRINT_FACE, [[依姫]], "発情", "服", "", ""
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리에 손을 감싸고, 이마에 가볍게 키스한다.
					PRINTFORML 「엣...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 작게 소리를 냈을 때는, 이미 당신의 입술은 떨어져 있었다
				CASE 1
					PRINTFORML 「저, 갑자기 무슨 소리예요!」
					PRINTFORMDL 이마에 키스를 하자, %조사처리(CALLNAME:TARGET,"는")% 눈에 띄게 당황했다.
					PRINTFORMW 「――안 된다니…… 안 될 리가 있잖아요!」
				CASE 2
					PRINTFORMDL 당신이 이마에 키스하자, %조사처리(CALLNAME:TARGET,"에게")% '짝' 소리와 함께 뺨을 맞았다.
					PRINTFORML 「조, 조금은 반성하렴...!」
					PRINTFORMDW 빨개진 뺨을 문지른다. 이 정도로는 %조사처리(CALLNAME:TARGET,"에게")% 키스할 수 있는 게 쉽군.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
