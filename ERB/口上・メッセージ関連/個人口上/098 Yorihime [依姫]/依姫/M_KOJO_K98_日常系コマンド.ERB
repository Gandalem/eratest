;==================================================
;603,手を繋ぐ
;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗でもふりほどかれたりはしません
;==================================================

@M_KOJO_SUCCESS_COM_K98_603
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_603
RETURN 0

@M_KOJO_MESSAGE_COM_K98_603
CALL M_KOJO_MESSAGE_COM_K98_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「자, %CALLNAME:MASTER%. 나의 손을」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 손을 잡고 연인답게 손가락을 얽는다.
				PRINTFORMDW 옆에서 걷는 %조사처리(CALLNAME:TARGET,"는")% 또래 소녀 같은 어리숙한 미소를 짓고 있다.
			CASE 1
				PRINTFORML 「――좀 더 가까이? 이렇게 할까요」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 팔짱을 끼면서 손을 잡는다
				PRINTFORMDW ……조금 걷기 힘들지만, 만족도는 매우 높다
			CASE 2
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 연인처럼 손을 잡고 걸었다.
				PRINTFORML 「――앗」
				PRINTFORMDL 사람이 지나가자, 부끄러웠는지 %조사처리(CALLNAME:TARGET,"는")% 깍지 낀 손가락을 풀었다.
				PRINTFORMDW 하지만 결코, 잡았던 손을 놓지는 않았다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「저, 혹시 폐가 되지 않는다면……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 잡은 손을 움찔거린다
				PRINTFORMDW 당신은 고개를 끄덕이고 연인처럼 맞잡은 손을 감쌌다
			CASE 1
				PRINTFORML 「――오해받을지도 몰라?」
				PRINTFORML 「나는 별로……앗, 아니, 그런 의미라면」
				PRINTFORMDW 무슨 뜻일까. %조사처리(CALLNAME:TARGET,"는")% 혼자 어쩔 줄 몰라하고 있었다
			CASE 2
				PRINTFORMDL 당신이 『손을 잡고 싶다』라고 말하자, %조사처리(CALLNAME:TARGET,"는")% 자연스럽게 손을 내밀어왔다
				PRINTFORML 「――? 잡지 않으시나요?」
				PRINTFORMDW 당신이 손을 잡자, %조사처리(CALLNAME:TARGET,"는")% 단단하게 그 손을 잡아주었다
		ENDSELECT
		;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「――손을? ……조금만이라면」
				PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 손을 잡았다.
				PRINTFORMDW ……그녀의 손은, 조금 촉촉했다.
			CASE 1
				PRINTFORML 「저, 손 앞뒤로 흔들지 말아 주세요」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 손을 잡고 걷는다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부끄러운 듯 주변의 시선을 신경 쓰고 있다…….
			CASE 2
				PRINTFORML 「손을 잡는 것이 그렇게 기쁜 건가요?」
				PRINTFORML 「……역시, 누나와 닮았네요.」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며 당신의 손을 다정하게 잡아주었다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「――아, 얼굴이 빨간가?」
				PRINTFORML 「……착각인 거 아닐까요?」
				PRINTFORMDW 애써 손을 잡고 있는데, %조사처리(CALLNAME:TARGET,"는")% 고개를 돌려버렸다
			CASE 1
				PRINTFORML (그냥 손을 잡고 있을 뿐인데……)
				PRINTFORML (그래…… 그저 붙잡고 있을 뿐인데……)
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 가슴이 빠르게 울린다. 들키지 않았다고 생각하는 것 같지만, 보통은 티가 난다
			CASE 2
				PRINTFORML 「손을…… 손을!?」
				PRINTFORML 「――윽, 잡은 적도 있습니다! ……어렸을 때」
				PRINTFORMDW 마지막 부분은 뒤에 가려 잘 들리지 않았다
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
