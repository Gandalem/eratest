					PRINTFORMDW 『나쁘지 않아?』 당신의 말에 %조사처리(CALLNAME:TARGET,"는")% 작게 끄덕였다
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
