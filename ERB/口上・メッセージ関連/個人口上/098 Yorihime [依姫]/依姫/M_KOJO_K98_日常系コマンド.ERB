;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K98_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;（任意）:通常の地の文を表示するかスキップするか決定する。
;MESSAGECHECK関数は、以下のような戻り値を返す
;RETURN 0;通常地の文と口上を表示
;RETURN 1;口上のみ表示
;RETURN 2;通常地の文のみ表示
;RETURN 3;どちらも表示しない
;以下原文
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_300
RETURN 0

@M_KOJO_MESSAGE_COM_K98_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K98_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;会話不能
	IF TCVAR:302
		;顔絵を表示（オプションでオンにしていないと表示されない）
		;お風呂
		IF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
			CALL PRINT_FACE, [[依姫]], "通常", "裸", "", ""
			;それ以外
		ELSE
			CALL PRINT_FACE, [[依姫]], "通常", "服", "", ""
		ENDIF
		;親密５以上
		IF ABL:親密 > 4
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「그게……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 무언가 화제를 꺼내려고 하지만
					PRINTFORMDW 결국 어색한 분위기가 되어버렸다……
				CASE 1
					PRINTFORML 「――좋아하는 음식이라니요?」
					PRINTFORML 「어…… 복숭아는, 자주 먹곤 하지만……」
					PRINTFORMDW 어색한 분위기를 어떻게든 풀려고 했지만, 오히려 더 어색해져 버렸다……
				CASE 2
					PRINTFORML 「조금... 목이 마르네요」
					PRINTFORMDL 그렇구나. 당신은 %조사처리(CALLNAME:TARGET,"에게")% 맞장구를 친다.
					PRINTFORMDW ...왠지, %조사처리(CALLNAME:TARGET,"가")% 한숨을 쉬는 것을 들었다...
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이야기는 끝났나요?」
					PRINTFORMDW 지상에서의 경험을 이것저것 이야기해 보았지만, 요리히메는 흥미를 갖지 못한 것 같다…….
				CASE 1
					PRINTFORML 「…………」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 말하는 당신에게 눈길도 주지 않고 손에 들고 있던 고서형 단말기를 만지고 있다...
				CASE 2
					PRINTFORML 「――어색해? 그런 기분을 느끼고 있는 건 너뿐인 건가?」
					PRINTFORMDL 그럼 요리히메는 즐기고 있는 것은 아닌 것 같다……
					PRINTFORMDW 분명, 아무래도 상관없는 거겠지……
			ENDSELECT
		ENDIF
		;通常
	ELSE
		;恋人
		IF TALENT:恋人
			SELECTCASE RAND:10
				CASE 0
					PRINTFORML 「당신은 내가 지켜줄게요. 반드시, 이 몸을 바쳐서라도」
					PRINTFORMDL 연인이 된 %조사처리(CALLNAME:TARGET,"는")% 다시 한번 당신에게 그렇게 선언했다
					PRINTFORMDW 누구에게 들었기 때문이 아니라, 이것이 그녀의 의지일 것이다
				CASE 1
					PRINTFORML 「조금은 누나에게도 제대로 해줬으면 좋겠어요」
					PRINTFORML 「……그렇게 되면, 당신에게 기대어 있을 시간이 더 많아질 텐데」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며, 애원하듯 당신의 어깨에 기댔다
				CASE 2
