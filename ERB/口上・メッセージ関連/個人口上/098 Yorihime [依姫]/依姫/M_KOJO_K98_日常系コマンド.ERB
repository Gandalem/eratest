@M_KOJO_MESSAGE_COM_K98_615_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 도시락을 먹기로 했다.
	PRINTFORMDW 
	;依姫の料理技能が２以上
	IF ABL:料理技能 > 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 오늘 도시락은 주먹밥뿐이었다. 조금 외롭네
				PRINTFORML 「사실 반찬도 가져올 예정이었는데…… 그게, 누님이」
				PRINTFORMDW 간식거리만 좀 먹어버린 것 같다. 정말 손이 가는 습관이 나쁜 언니구나
			CASE 1
				PRINTFORMDL %CALLNAME:TARGET%の持ってきてくれたお弁当の中に、一つだけ不格好なおにぎりがあった
				PRINTFORML 「レイセンが握ったものです。貴方に食べてもらいたいそうですよ」
				PRINTFORMDL あの子が握ってくれたものか、きっと美味し……うわ、しょっぱ
				PRINTFORML 「……大丈夫ですか？ 顔色が優れないようですが……」
				PRINTFORMDW 大丈夫大丈夫。そう言いながらあなたは水筒のお茶を口の中に流し込んだ
			CASE 2
				PRINTFORML 「부디, 드셔 주세요」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 만들어 온 도시락은 매우 맛있어 보인다
				PRINTFORMDW 당신은 손을 모으고, 바로 도시락에 손을 댔다
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 준비한 도시락은... 뭐라고 해야 할지 작다. 여성용으로 해도 좀 더 양이 많은 것 같은데...
				PRINTFORML 「아아 이것은... 누님께서 맛을 너무 많이 보셔서」
				PRINTFORMDW ...과연, 대충 이해했다
			CASE 1
				PRINTFORML 「이것은 제가 만든 것이고, 이것은 언니가……」
				PRINTFORMDL 중박 속 내용물을 %조사처리(CALLNAME:TARGET,"가")% 하나하나 소개한다.
				PRINTFORMDW 미인 자매가 자신을 위해 만들어 준 것이다. 어떤 맛이라도, 맛있게 먹자
			CASE 2
				PRINTFORML 「――조금 맛이 싱거운가?」
				PRINTFORML 「혀가 익숙하지 않은 거겠지. 지상의 식문화는 달처럼 세련되지 않았으니까」
				PRINTFORMDL 네 혀가 바보라고 말하는 것 같아서 조금 분하다
				PRINTFORMDW 다음에 맛있는 요리를 대접해서, 달의 요리로는 만족 못 하는 몸으로 만들어 주겠다……
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
