;402,就寝
;TFLAG:193(0=通常 1=子供と一緒に川の字で寝る)
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_402
RETURN 0

@M_KOJO_MESSAGE_COM_K98_402
;就寝にTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K98_402_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;お招き部屋で依姫が恋慕じゃないor依姫が睡眠中・衰弱中・あなたの部屋にお泊りの場合はこれ
	IF (!TALENT:恋慕 && CFLAG:MASTER:現在位置 == OMANEKIBEYA()) || (CFLAG:睡眠 || CFLAG:衰弱 || FLAG:一時滞在 == [[依姫]])
		PRINTFORML 「......크으」
		PRINTFORMDW 당신은 스르륵 잠든 %CALLNAME:TARGET%옆에서 눈을 감았다...
		;一緒に寝る
	ELSEIF CFLAG:MASTER:現在位置 == CFLAG:[[依姫]]:初期位置
		;判定
		SELECTCASE TFLAG:193
			;通常
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「스르륵... 스르륵...」
						PRINTFORMDW 당신은 잠든 %조사처리(CALLNAME:TARGET,"의")% 뺨에 키스를 하고 방의 불을 껐다.
					CASE 1
						PRINTFORML 「……안녕히 주무세요, %CALLNAME:MASTER%」
						PRINTFORMDL 당신이 잠든 것을 확인하자, %CALLNAME:TARGET%도 눈을 감았다.
						PRINTFORMDW ……%조사처리(CALLNAME:TARGET,"는")% 그날, 중간에 깨지 않고 푹 잠들 수 있었다.
					CASE 2
						PRINTFORMDL 당신이 불을 끄려고 손을 뻗자, %조사처리(CALLNAME:TARGET,"가")% 잠옷을 잡아당겼다.
						PRINTFORML 「저기, 조금만 더……」
						PRINTFORML 「――아, 만약 당신이 잠들고 있다면……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 좀 더 이야기하고 싶어하는 것 같다.
						PRINTFORMDW 당신이 뻗었던 손을 거두자, %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 몸을 가까이 붙였다…….
						PRINTFORMDL ……………
						PRINTFORMDL ………
						PRINTFORMDW …
						;昨日はよく眠れなかったフラグON
						CFLAG:MASTER:徹夜 = 1
						;好感度５０上昇
						CALL CHANGE_CFLAG(2, [[依姫]], 50)
				ENDSELECT
				;子供と一緒に川の字で寝る
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「…………스으」
						PRINTFORMDL %CHILDNAME:[[依姫]]:(TALENT:[[依姫]]:育児中)%와%조사처리(CALLNAME:TARGET,"는")% 벌써 잠이 들었다.
						PRINTFORMDW 당신은 두 사람을 깨우지 않도록 이불 속으로 파고들었고, 눈을 감았다.
					CASE 1
						PRINTFORML 「……～～♪」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% %CHILDNAME:[[依姫]]:(TALENT:[[依姫]]:育児中)%를 재우고 있다.
						PRINTFORMDW 완전히 엄마답게 되었다. 자신도 아버지로서의 자각을 가져야 한다…….
					CASE 2
						PRINTFORMDW 
						PRINTFORMDW 세 사람이 잠든 무렵... 방에 몰래 들어오는 그림자가 있었다.
						PRINTFORMDW 
						CALL PRINT_FACE, [[豊姫]], "笑顔", "服", "", ""
						CALL M_KOJO_COLOR_K99
						PRINTFORML 「후후, 곤히 자고 있네」
						PRINTFORMW 「안심해. 당신들의 기록은 내가 확실하게 남겨둘 테니까♪」
						PRINTFORMDW 그것은 여동생을 너무 사랑한 나머지 미쳐버린 언니의 모습이었다
						PRINTFORMDL 물론, 이 일은 아무도 모른다
						PRINTFORMDW 토요히메의 사적인 방에 벽 전체에 여동생 사진이 붙어 있는 숨겨진 방이 있다는 사실조차…….
						PRINTFORMW 「하아…… 귀엽네…… 먹어버리고 싶을 정도라……」
						PRINTFORMDL 도촬이라고 비난받더라도 상관없다
						PRINTFORMDW 이것이 나의 사랑이라고, 토요히메는 진심으로 그렇게 생각하고 있었다
						PRINTFORMDL ……………
						PRINTFORMDL ………
						PRINTFORMDW …
						RESETCOLOR
						;昨日はよく眠れなかったフラグON
						CFLAG:MASTER:徹夜 = 1
				ENDSELECT
		ENDSELECT
		;通常
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「오늘도 하루 수고하셨습니다」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 빛을 끄고, 방을 나갔다
				CASE 1
					PRINTFORML 「그럼 저도 이제 순찰이 있어서요」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 이쪽으로 가볍게 목례를 하고 떠났다.
				CASE 2
					PRINTFORML 「너무 밤늦게까지 깨지 않도록」
					PRINTFORML 「나중에 상태를 보러 갈 테니까.」
					PRINTFORMDW 당신은 '네네' 하고 손을 흔들며 어머니 같은 말을 하는 %조사처리(CALLNAME:TARGET,"를")% 돌려보냈다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「그럼, 나도 이만」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 일어서서 방을 떠났다.
				CASE 1
					PRINTFORML 「이불도 깔지 않고 잔다니……」
					PRINTFORML 「……어쩔 수 없네」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 붙박이장으로부터 담요를 꺼내, 잠자는 당신에게 살며시 덮어주었다……
				CASE 2
					PRINTFORML 「――나랑 같이 자지 않을래?」
					PRINTFORML 「거절하겠어. 정말로 원한다면, 다른 사람을 준비하겠지만」
					PRINTFORMDW 다마네 토끼 아저씨한테라도 맡겨지면 귀찮아질 거야. 너는 순순히 잠자기로 했다
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
