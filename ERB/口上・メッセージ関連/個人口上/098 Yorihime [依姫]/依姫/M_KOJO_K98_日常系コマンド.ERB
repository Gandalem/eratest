@M_KOJO_MESSAGE_COM_K98_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「후우……」
				PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 나란히 앉아 차를 마셨다.
				PRINTFORMDW 조금 우려내는 방식을 바꿔봤지만, %조사처리(CALLNAME:TARGET,"는")% 마음에 들어 한 것 같다.
			CASE 1
				PRINTFORML 「감사합니다」
				PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"에게")% 찻잔을 건네고 그녀 옆에 앉았다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 차에 후후 하고 숨을 불어넣고 있다……
			CASE 2
				PRINTFORML 「잠시만 기다려 주세요. 분명 선물 받은 과자가...」
				PRINTFORML 「...어라? 확실히 여기에... 헉, 설마 언니...?!」
				PRINTFORMDW 유감스럽게도, 먼저 오신 분이 과자를 다 드셔버린 것 같다...
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「평소와는 다른 차의 맛이네요」
				PRINTFORMDL 그렇게 묻는 %조사처리(CALLNAME:TARGET,"에게")% 당신은 차의 봉투를 보여주었다.
				PRINTFORML 「익숙한 맛이라고 생각했는데, 그럴 만했죠」
				PRINTFORML 「또 멋대로 부엌에서 가져온 건가요?」
				PRINTFORMDL 남는 게 있어서. 당신은 자신의 찻잔에 차를 따르며 그렇게 대답했다.
				PRINTFORML 「뭐 괜찮지만, 메모는 해두세요.」
				PRINTFORML 「죄 없는 토끼를 상대로 범인 찾기는 하고 싶지 않으니까요.」
				PRINTFORMDW 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% 다시 찻잔에 입을 댔다.
			CASE 1
				PRINTFORML 「즈즈... 후우...」
				PRINTFORMDL 바쁜 %조사처리(CALLNAME:TARGET,"를")% 위해 피로 회복 효과가 있다고 하는 차를 내려보았다
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 안도하는 표정을 보니, 효과는 있었던 것 같다
			CASE 2
				PRINTFORML 「당신에게 영향을 받았는지, 레이센이 차 공부를 시작한 것 같아서…….」
				PRINTFORML 「나는 우선 수련 쪽을 열심히 해줬으면 하는데…….」
				PRINTFORMDW 당신은 차를 마시며 %조사처리(CALLNAME:TARGET,"와")% 잡담을 했다
		ENDSELECT
		;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……깊이가 있군. 하지만 그것만이 아닌 맛이야」
				PRINTFORML 「세련되지 않은, 지상의 차네요」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 비워진 찻잔을 옆에 두고 후 하고 한숨을 내쉬었다
			CASE 1
				PRINTFORML 「확실히 당신의 기술은 굉장하다. 하지만 완벽하지는 않아」
				PRINTFORML 「신농이여! 나를 대신하여 이 자에게 지고한 차를 내려라!」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 능력에 의해 소환된 신이 귀찮다는 듯 차를 따른다.
				PRINTFORMDL 그리고 찻잔에 차를 따르자, 여기를 한 번도 쳐다보지 않고 사라져 버렸다.
				PRINTFORML 「자, 어서 드세요. 식기 전에」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 권유받은 대로 찻잔을 기울인다. 정말 맛있다.
				PRINTFORMDW ……하지만 엄청난 능력을 낭비하고 있다. 혹시 평소에도 이렇게 부려먹고 있는 걸까……
			CASE 2
				PRINTFORML 「그렇네요, 잠시 휴식을 취하죠」
				PRINTFORMDL 갓 우려낸 차를 찻잔에 따서 %조사처리(CALLNAME:TARGET,"에게")% 건넸다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신에게 감사 인사를 하고 찻잔을 받아 입을 댔다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「저도 돕겠습니다」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 손바닥에 작은 불꽃을 나타낸다. 가까이에 있던 당신은 그 열기에 나도 모르게 뒷걸음질 쳤다
				PRINTFORML 「이것은 아타기노님의 불이다. 지상에는 이토록 뜨거운 불은 거의 없다」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 주전(유리병)에 손을 댄다. 직후, 끓음을 알리는 경적 소리가 날카로운 소리를 주변에 울렸다
				PRINTFORML 「이 정도면 될까요. 나머지는 당신에게 맡깁니다」
				PRINTFORMDW %CALLNAME:TARGET%로부터 주전을 받는다. 편리한 능력지만, 이런 데 사용해도 괜찮을까……
			CASE 1
				PRINTFORMDL 차분하게 토토토……
				PRINTFORML 「어디서 우리는 법을 배웠나요?」
				PRINTFORMDW 설명서를 읽었으니까.
			CASE 2
				PRINTFORML 「후우……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 함께 차를 마시며 잠시 숨을 돌린다.
				PRINTFORMDW ……조용하다. 어색해질 정도로
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
