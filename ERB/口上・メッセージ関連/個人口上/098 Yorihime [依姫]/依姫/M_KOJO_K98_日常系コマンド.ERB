			ENDSELECT
		ENDIF
		;通常
	ELSE
		IF CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
			PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"와")% \@ (CFLAG:TARGET:現在位置 % 100) % 10 ? 걸으면서 # 가볍게 \@스킨십을 시도했다
		ELSEIF CFLAG:TARGET:350 == 49
			PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% 평소보다 대담하게 %조사처리(CALLNAME:TARGET,"와")% 스킨십을 시도했다.
		ELSE
			PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"와")%의 스킨십을 시도했다.
		ENDIF
		;恋人
		IF TALENT:恋人
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 볼을 물들이며 기쁜 듯하고 있다...
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 어깨에 팔을 둘고, 뺨에 키스했다.
					PRINTFORML 「애써 연인이 되었는데, 버릇 나쁜 건 여전하네요」
					PRINTFORMDW 허벅지에 뻗었던 손을, %조사처리(CALLNAME:TARGET,"에게")% 꽉 잡혔다……
				CASE 1
					PRINTFORMDL 최근에는 %CALLNAME:TARGET%쪽에서도 자연스럽게 스킨십을 시도하는ようになて왔다.
					PRINTFORML 「데이트라고 하면, 지난번의...」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신의 손등 위에 자기 손을 포개고 즐거운 듯 이야기하고 있다...
				CASE 2
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"와")% 연인 같은 스킨십을 했다.
					PRINTFORML 「……당신만 괜찮다면, 이대로……」
					PRINTFORMDW 서로 사랑하는 두 사람 사이에 매우 달콤한 공기가 흘렀다…….
			ENDSELECT
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 매우 기뻐하는 듯하다...
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 관심을 끌기 위해 그녀의 어깨에 손을 댔다.
					PRINTFORML 「――? 무슨 일이죠?」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신 쪽으로 고개를 돌리더니, 부드러운 미소를 지었다……
				CASE 1
					PRINTFORML 「언니와도, 야이님과도 달라……」
					PRINTFORML 「당신의 손은, 크고 따뜻해……」
					PRINTFORMDW 볼에 놓인 당신의 손 위에 %조사처리(CALLNAME:TARGET,"는")% 자신의 손을 포갰다.
				CASE 2
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 귓가에 얼굴을 가까이 대고 달콤한 말을 속삭였다
					PRINTFORML 「아, 응...... 놀리고 계신 건가요...?」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부끄러움에 얼굴을 새빨갛게 물들이고 있다……
			ENDSELECT
			;思慕
		ELSEIF TALENT:思慕
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 만만치 않은 것 같다...
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「당신도 누님은 너무 심한 거 아닐까요...」
					PRINTFORMDL 싫다면 도망치면 돼. 그렇게 말하자 %조사처리(CALLNAME:TARGET,"는")% 「하아...」 하고 한숨을 내쉬었다
					PRINTFORMW 「그런 점까지 누님이랑 똑같아요. 정말... 저 옆구리 간지럽히는 거 그만해주세요!」
				CASE 1
					PRINTFORML 「아, 저기요, %CALLNAME:MASTER%?」
					PRINTFORML 「조금 거리가 가까운 것 같아...」
					PRINTFORMDW 괜찮잖아. 당신은 어깨가 밀착할 정도의 거리에서 %조사처리(CALLNAME:TARGET,"와")% 대화했다
				CASE 2
					PRINTFORML 「흐윽… 힘을 빼라고 해도…」
					PRINTFORMDL 당신에게 어깨를 안긴 %조사처리(CALLNAME:TARGET,"는")% 몸을 뻣뻣하게 경직시키고 있다.
					PRINTFORMDL 벌써 꽤 오래 알고 지냈는데, 언제까지나 어린 소녀 같은 반응이다.
					PRINTFORMW (언니… 역시 나는 언니처럼 될 수 없어요…!)
			ENDSELECT
			;それ以外
		ELSE
			PRINTFORMDL ...아무래도 조금 너무 친근하게 대해버린 것 같아...
			PRINTFORMDW 
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「손이 습한 거군요」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신의 손을 잡는다
					PRINTFORMW 「지상의 인간들은 모두 이렇습니까?」
				CASE 1
					PRINTFORMDL 당신은 뒤에서 %조사처리(CALLNAME:TARGET,"에게")% 다가가 그녀의 어깨를 부드럽게 주물렀다.
					PRINTFORML 「언니, 장난은 적당히……」
					PRINTFORML 「――에? 아…… 나한테 용무라도?」
					PRINTFORMDL 평소에 편하게 스킨십을 해오는 건 언니 토요히메 정도겠지.
					PRINTFORMDW 당신이 만지고 있었다는 것을 알고, %조사처리(CALLNAME:TARGET,"는")% 눈에 띄게 표정을 굳혔다.
				CASE 2
					PRINTFORML 「……어째서 그렇게 아무렇지도 않게 만지는 것인가요?」
					PRINTFORMDW 차갑게 거절해도 포기하지 않고 다가오는 당신에게 %조사처리(CALLNAME:TARGET,"는")% 당황하고 있다.
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
