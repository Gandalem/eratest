;411,戦闘訓練
;TFLAG:194(3=夏の昼間 2=ヤバい天気 1=悪天候 0=屋内or通常天気
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_411
RETURN 1

@M_KOJO_MESSAGE_COM_K98_411
CALL M_KOJO_MESSAGE_COM_K98_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_411_1
#DIM 正解
#DIM 経験値
#DIM 制限時間
#DIM 倍率
#DIM FEINT
#DIM イカサマ
VARSET LOCAL
イカサマ = 0
制限時間 = 2000 - (ABL:[[依姫]]:戦闘能力 - ABL:MASTER:戦闘能力) * 100
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特訓デイリーからお借りしました
	CALL M_KOJO_COLOR_K98
	PRINTFORMDL 목검을 손에 든 당신과 요리히메가 대치한다.
	PRINTFORML 「연습이라고 해서 긴장을 풀지 않도록 해라」
	PRINTFORML 「실전이라 생각하고, 본심으로 상대해 오렴」
	PRINTFORMDW %CALLNAME:TARGET%도 진심인 것 같다. 자……
	RESETCOLOR
	PRINTFORML 
	CALL ASK_YN("훈련 시작!","도망쳐!")
	IF RESULT
		CALL M_KOJO_COLOR_K98
		PRINTFORML 「에엣!?」
		PRINTFORMDL 도망치는 게 이기는 거다. 즉 승자는 나다.
		PRINTFORMDW 당신은 멍하니 있는%조사처리(CALLNAME:TARGET,"를")% 내버려 두고, 전속력으로 도망쳐 버렸다…….
		RESETCOLOR
	ELSE
		正解 = RAND:4
		経験値 = MIN(ABL:[[依姫]]:戦闘能力 * 5, 5)
		SELECTCASE RAND:20
			;custom code - switch Japanese and English
			CASE IS <= 11
				;普通に
				LOCALS:0 = UP
				LOCALS:1 = RIGHT
				LOCALS:2 = LEFT
				LOCALS:3 = DOWN
				倍率 = 100
			CASE 12 TO 15
				;ローマ字
				LOCALS:0 = UE
				LOCALS:1 = MIGI
				LOCALS:2 = HIDARI
				LOCALS:3 = SHITA
				倍率 = 160
				;英語
			CASE 16,17,18
				LOCALS:0 = 上
				LOCALS:1 = 右
				LOCALS:2 = 左
				LOCALS:3 = 下
				倍率 = 120
				;スペイン語
			CASE 19
				LOCALS:0 = encima de
				LOCALS:1 = a la derecha
				LOCALS:2 = a la izquierda
				LOCALS:3 = abajo de
				倍率 = 300
		ENDSELECT
		;あなたの戦闘能力が高いと５分の一の確率でフェイントをかけてくる
		IF ABL:MASTER:戦闘能力 >= 5 && !RAND:5
			FEINT = 1
			制限時間 += 400
			倍率 += 80
		ELSE
			FEINT = 0
		ENDIF
		CALL FISHER_YATES_SHAFFLE(4)
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 공격을 피한다 (클릭으로 시작)
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SETCOLOR C_YELLOW
		IF FEINT
			PRINTFORM %LOCALS:(RAND:4)%
			RESETCOLOR
			PRINTFORM 하고 보이면서 %LOCALS:(3 - 正解)%
		ELSE
			PRINTFORM %LOCALS:(3 - 正解)%
			RESETCOLOR
		ENDIF
		PRINTFORML 저쪽으로부터의 공격!
		$LOOP_IKASAMA
		FOR LOCAL:10,0,4
		LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
		PRINTFORML [{LOCAL}] ｛로컬｝ - %LOCALS:LOCAL%에게 피한다
		NEXT
		SIF !イカサマ && BASE:MASTER:TSP > 500
			PRINTFORML [{4}] - 시간 정지
		TINPUT 制限時間, -1, 1
		IF RESULT == 正解
			CALL M_KOJO_COLOR_K98
			IF !イカサマ
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 공격을 회피했다!
				PRINTFORMDL ……………
				PRINTFORMDL ………
				PRINTFORMDW …
				PRINTFORML 「감사했습니다」
				PRINTFORMDL 수련을 마치고 서로 마주 보고 고개를 숙인다.
				PRINTFORMDL 땀범벅인 당신에게, 단정한 표정의 %조사처리(CALLNAME:TARGET,"는")% 땀 한 방울 흘리지 않았다.
				;うどんげっしょーネタ
				PRINTFORML 「기본기는 나쁘지 않지만, 몇 가지 부족한 점이 있네요.」
				PRINTFORML 「힘과 기술에, 속도와 의지에...」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 손가락을 꼽는다. 아무튼, 모든 것이 부족하다는 것을 알았다...
			ELSE
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 공격을 회피하려 했다……
				PRINTFORML 「――당신도 이상한 술을 쓰는군요」
				PRINTFORMDL 시간을 멈추고, 행동을 선지하며――
				PRINTFORMDL 뒤를 잡았다고 생각했는데, 당신은 땅에 쓰러져 있었다
				PRINTFORML 「뭐, 마술의 비법을 알고 있다면 아무것도 아니지만……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 내놓은 이름. 그것은 당신과 같은 능력을 가진 메이드의 이름이었다
				PRINTFORMDW 싸우기 전부터 승부는 정해져 있었던 모양이다. 다음부터는 정정당당하게 할 필요가 있을 것 같다……
				BASE:MASTER:体力 -= 1000
			ENDIF
			RESETCOLOR
			BASE:MASTER:体力 -= 100 * (1 + ABL:[[依姫]]:戦闘能力)
			BASE:MASTER:気力 -= 100 * (1 + ABL:[[依姫]]:戦闘能力)
			経験値 = 経験値 * 倍率 / 100
			EXP:MASTER:戦闘経験 += 経験値
			EXP:[[依姫]]:戦闘経験 += 経験値 * 2
			CFLAG:[[依姫]]:好感度 += 経験値 * 2
			CFLAG:[[依姫]]:信頼度 += 経験値 * 2
			PRINTFORML 전투 경험 +{経験値}(%CALLNAME:MASTER%)
			PRINTFORML 전투 경험 +{経験値 * 2}(%CALLNAME:TARGET%)
			PRINTFORML 호감도 +{経験値 * 2}(%CALLNAME:TARGET%)
			PRINTFORML 신뢰도 +{経験値 * 2}(%CALLNAME:TARGET%)
		ELSEIF RESULT == 4 && !イカサマ && BASE:MASTER:TSP > 500
			イカサマ = 1
			倍率 /= 5
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 시간 정지 능력으로 공격을 간파했다!
			GOTO LOOP_IKASAMA
		ELSE
			CALL M_KOJO_COLOR_K98
			PRINTFORMDW 실패했다……
			PRINTFORMDL 숨을 헐떡이며 무릎 꿇은 당신에게%조사처리(CALLNAME:TARGET,"가")% 목검을 겨눈다.
			PRINTFORMDL 항복이다. 당신은 목검을 버리고, 등을 대고 쓰러졌다.
			PRINTFORML 「쉬고 있을 여유는 없어요. 다음은 달리기입니다. 휴식은 그 후에예요」
			PRINTFORMDW 오니다, 오니가 있다. 당신은 비명을 지르는 토끼들의 기분이 조금은 이해된 것 같았다.
			RESETCOLOR
			BASE:MASTER:体力 -= 500 * (1 + ABL:[[依姫]]:戦闘能力)
			BASE:MASTER:気力 -= 500 * (1 + ABL:[[依姫]]:戦闘能力)
			PRINTFORML 전투 경험 + {経験値}(%CALLNAME:TARGET%)
			EXP:[[依姫]]:戦闘経験 += 経験値
			CFLAG:[[依姫]]:好感度 += 経験値 / 2
			CFLAG:[[依姫]]:信頼度 += 経験値 / 2
			PRINTFORML 호감도 +{経験値}(%CALLNAME:TARGET%)
			PRINTFORML 신뢰도 +{経験値}(%CALLNAME:TARGET%)
		ENDIF
	ENDIF
ENDIF
RETURN 1
