;※※※※※※※※※※※※※※※※※※※※※※※※※
;ハードな調教コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;140,イラマチオ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K98_140
RETURN 0

@M_KOJO_MESSAGE_COM_K98_140
CALL M_KOJO_MESSAGE_COM_K98_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K98_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;奉仕精神が１０以上
	IF ABL:奉仕精神 > 9
		;このコマンドであなたが射精
		IF NOWEX:MASTER:射精
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 사정의 순간, 당신은 %조사처리(CALLNAME:TARGET,"를")% 임신시킬 생각으로 허리를 밀어넣었다.
					CALL HPH_PRINT,@"「으윽흐읍 HPH 응므... 크윽... HPH」","L"
					PRINTFORMDW 너무 많은 양에 다 마시지 못한 것일까, 헛기침하는 순간 %조사처리(CALLNAME:TARGET,"의")% 코에서 정액이 튀어나왔다...
				CASE 1
					CALL HPH_PRINT,@"「으윽 HPH 음 HPH 흐아앗 HPH 움프 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리를 단단히 붙잡고 사정하기 위해 격렬하게 허리를 내리친다.
					PRINTFORMDW 눈물과 콧물, 그리고 봉사할 수 있다는 기쁨으로, %조사처리(CALLNAME:TARGET,"의")% 표정은 완전히 무너져 있다……
				CASE 2
					PRINTFORMDL 당신은 몇 번이고 허리를 부딪친 후, 허리를 내밀어 안쪽 깊숙이 페니스를 비틀었다.
					CALL HPH_PRINT,@"「흐으윽! HPH 끄윽 HPH 음, 팍 HPH」","L"
					PRINTFORMDW 흘리면 벌이라고 당신이 말하니, %조사처리(CALLNAME:TARGET,"는")% 눈물을 흘리며 고개를 끄덕였다….
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음즈루, 음! HPH 음부! HPH 푸! HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 얼굴을 움직여, 난폭하게 박혀온 페니스를 빨고 있다...
					CALL HPH_PRINT,@"(그에게…… 기쁘게 해 줄 수 있다면……! HPH)","W"
				CASE 1
					CALL HPH_PRINT,@"「고후훗 HPH 음... 후- HPH 주르... 윽 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 난폭하게 밀어 넣어진 페니스를 다시 물고,
					PRINTFORMDW 입을 오므리며 천천히 얼굴을 앞뒤로 흔들었다...
				CASE 2
					PRINTFORMDL 당신은 오나홀처럼 %조사처리(CALLNAME:TARGET,"의")% 목구멍을 범한 후, 페니스를 빼고 %조사처리(CALLNAME:TARGET,"에게")% 입을 열게 했다.
					CALL HPH_PRINT,@"「흐아... 하아... 아... 큭」","L"
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 빈둥거리며 침을 흘리면서, 물건을 원하는 듯 목구멍을 꿀꺽거리고 있다...
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;このコマンドであなたが射精
		IF NOWEX:MASTER:射精
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「――음무부훗!?」
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 목구멍 깊숙이 페니스를 밀어 넣고 그대로 기분 좋게 사정했다.
					PRINTFORMDW 다량의 정액이 %조사처리(CALLNAME:TARGET,"의")% 식도를 지나 위로 흘러 들어간다……
				CASE 1
					PRINTFORML 「퍽――」
					PRINTFORMDL 난폭하게 페니스를 밀어 넣고, 아무 말 없이 사정한다.
					PRINTFORMDW 욕망이라는 더러움을, 당신은 한 방울도 남김없이 %조사처리(CALLNAME:TARGET,"의")% 위 속에 부었다……
				CASE 2
					PRINTFORMDL 거칠게 페니스를 목구멍 깊숙이 밀어 넣고 몇 번 피스톤한 뒤 사정한다.
					PRINTFORML 「윽……윽……」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 눈물과 콧물로 얼굴을 범벅으로 한 채, 흰자만 드러내고 있다…….
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「크윽!? 응, 으읍앗!」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 머리를 단단히 붙잡고 몇 번이나 허리를 부딪치며 목구멍 깊은 곳을 파고든다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 괴로워하며 당신의 허리를 때리고 있다...
				CASE 1
					PRINTFORML 「윽, 에에……흐으……큭……윽」
					PRINTFORMDL 부딪혔던 허리를 천천히, 아주 천천히 뒤로 빼 나간다
					PRINTFORMDW 목이 조여오는 감촉에 당신은 황홀하게 숨을 내쉬었다
				CASE 2
					PRINTFORML (숨,이... 쉴 수 없어...)
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 의식을 잃기 직전에, 당신은 쑥 페니스를 빼냈다
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 목을 손으로 누른 채, 격렬하게 울고 있다...
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
