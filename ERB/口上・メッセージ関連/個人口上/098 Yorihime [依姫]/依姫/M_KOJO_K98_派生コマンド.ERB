; Modular ERB: 個人口上/098 Yorihime [依姫]/依姫/M_KOJO_K98_派生コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;派生コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;1,シックスナイン
;==================================================
;==================================================
;（任意）:通常の地の文を表示するかスキップするか決定する。
;MESSAGECHECK関数は、以下のような戻り値を返す
;RETURN 0;通常地の文と口上を表示
;RETURN 1;口上のみ表示
;RETURN 2;通常地の文のみ表示
;RETURN 3;どちらも表示しない
;以下原文
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K98_1
RETURN 0

@M_KOJO_MESSAGE_SCOM_K98_1
CALL M_KOJO_MESSAGE_SCOM_K98_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K98_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		CALL HPH_PRINT,@"「어째서…… 이런 자세로……윽 HPH」","L"
		PRINTFORMDL 이런 상황이라면, 당신은 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳을 핥아 올렸다.
		CALL HPH_PRINT,@"「――윽, 후우…… 저도, 핥으라고…… 그런 것입니까…… 윽, 후우」","L"
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 눈앞에 있는, 단단하게 부풀어 오른 수컷의 성기
		PRINTFORMDW 서둘러라라고 말하는 듯 맥동하는 그것에, %조사처리(CALLNAME:TARGET,"는")% 조심스럽게 혀를 내밀었다
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;通常
	ELSE
		;奉仕精神が１０以上または恋人
		IF ABL:奉仕精神 > 9 || TALENT:恋人
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「즈즈... 줄... 큭 하아... 음후... 큭」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 혀나 입술, 목구멍까지 사용해서 당신의 페니스를 기분 좋게 하고 있다.
						PRINTFORMDW 참지 못하고 사정하면, %조사처리(CALLNAME:TARGET,"는")% 멍한 듯 눈꼬리를 내리며 입안에 고여가는 정액을 삼켰다.
					CASE 1
						CALL HPH_PRINT,@"「음흠... 큭... HPH 음... 응... 윽 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 아무 말도 하지 않고, 그저 황홀하게 페니스를 빨고 있었다.
						PRINTFORMDW 당신이 사정해도, %조사처리(CALLNAME:TARGET,"는")% 살짝 숨을 가쁘게 한 뒤 곧바로 목소리를 내기 시작했다.
					CASE 2
						PRINTFORMDL 당신이 사정을 예고하자, %조사처리(CALLNAME:TARGET,"는")% 단단히 깊숙이 페니스를 물었다.
						CALL HPH_PRINT,@"「――응, 응, 부...음, 음...윽 HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 토해지는 정액을 흘리지 않으려고, 꽉 입술을 다물고 있다...
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응으음……읏큭」","L"
						PRINTFORMDL 당신이 숨을 쉬기 위해 입을 떼자, %조사처리(CALLNAME:TARGET,"가")% 불만스럽게 은밀한 곳을 밀어붙였다.
						PRINTFORMDW 당신은 「미안 미안」 하며 엉덩이를 쓰다듬어 주자, 다시 %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳을 혀로 핥았다.
					CASE 1
						CALL HPH_PRINT,@"「응, 응으윽 HPH 아아... 혀가... 윽 HPH」","L"
						PRINTFORMDL 질에 혀를 넣자, %조사처리(CALLNAME:TARGET,"는")% 기쁨으로 허리를 떨었다.
						PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"의")% 허리를 감싸 안고, 상냥하게 쓰다듬듯 혀의 배를 질벽에 문질렀다...
					CASE 2
						CALL HPH_PRINT,@"「그럼……이번에는 내가 아래에……HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 아래에, 당신이 위에 되어 서로 핥는 것을 재개한다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 마치 젖을 먹는 송아지처럼, 당신의 페니스에 달라붙어 있다…….
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;このコマンドであなたが射精
			IF NOWEX:MASTER:射精
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「크큭... 츄... 헉, 응으음 헉」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 질에 혀를 침입시키고, 거친 혀의 배로 여러 번 점막을 쓸어 올린다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 즐거움을 조금이라도 놓치지 않으려고 강하게 당신의 다리를 붙잡고 있다……
					CASE 1
						CALL HPH_PRINT,@"「하아……음……윽 HPH 음, 응……윽 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 중간까지 페니스를 물고, 얼굴을 상하로 흔들기 시작했다.
						PRINTFORMDW 당신은 하반신이 뜨거워지는 감각을 느끼며, 지지 않고 %조사처리(CALLNAME:TARGET,"의")% 비열에 혀를 가져갔다……
					CASE 2
						CALL HPH_PRINT,@"「――더……핥아줘, 라고……윽 HPH」","L"
						CALL HPH_PRINT,@"「그렇게 해줬으면 한다면…… 당신이야말로, 핥는 걸……. 헉!」","L"
						PRINTFORMDL 뭔가 부족했냐고, 당신은 %조사처리(CALLNAME:TARGET,"의")% 질에 혀를 밀어 넣었다.
						CALL HPH_PRINT,@"「아, 아니야 HPH 음윽 HPH 크흡 HPH 하앙 HPH」","W"
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「음, 음...윽 후우... 움프...윽 후우」","L"
						PRINTFORMDL 서로 앞에 성기를 드러내고 그것을 핥아주는 행위
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 아직 부끄러운 건지, 허리가 약간 뒤로 물려있다……
					CASE 1
						CALL HPH_PRINT,@"「츄……푸핫! 잠깐만…… 조용히 해줘…… 큭!」","L"
						PRINTFORMDL 따뜻한 혀가 기어 다니는 감촉에 도저히 허리가 움직여버린다.
						PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"에게")% 사과하고, 눈앞의 비열함을 핥는 데 의식을 집중시켰다.
					CASE 2
						CALL HPH_PRINT,@"「후우......음후......큭 HPH 음푸......츄......큭 HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 페니스 끝 쪽을 물고, 입술로 귀두를 만지고 있다.
						PRINTFORMDW 안쪽까지 물기는 거부감이 있어서 그렇게 하고 있는 거겠지만, 이게 의외로 기분 좋다…….
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
