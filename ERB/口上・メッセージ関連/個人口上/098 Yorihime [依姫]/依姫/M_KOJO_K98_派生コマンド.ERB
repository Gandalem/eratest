RETURN 0

@M_KOJO_MESSAGE_SCOM_K98_7
CALL M_KOJO_MESSAGE_SCOM_K98_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K98_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		CALL HPH_PRINT,@"「카히유---쪽!? HPH HPH HPH」","L"
		PRINTFORMDL 깊숙이 삽입된 페니스의 끝이 쿵 하고 자궁 입구를 때린다.
		PRINTFORMDW 거부하듯 질의 조임이 심해지지만, 당신은 개의치 않고 허리를 계속 움직였다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;子宮陥落済
	ELSEIF TALENT:ポルチオ性感
		;今射精した
		IF NOWEX:MASTER:射精
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「음으윽 후우읍 으응 끄응 후아압 후프 후프 후프」","L"
					PRINTFORMDL 완전히 굴복한 %조사처리(CALLNAME:TARGET,"의")% 자궁이 추욱추욱하고 살덩이에 달라붙어 온다.
					PRINTFORMDW 당신의 아이를 품을 준비는 이미 오래전에 되어 있었다.
				CASE 1
					CALL HPH_PRINT,@"「하아, 아햔 HPH 자궁, 좋아햔 HPH 괜찮아햔」","L"
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 완전히 자궁 성교의 노예가 되어 있다
					PRINTFORMDW 이대로 사정하겠다고 귓가에 속삭이자, %조사처리(CALLNAME:TARGET,"는")% 기쁜 듯 몇 번이고 고개를 끄덕였다
				CASE 2
					CALL HPH_PRINT,@"「낳을게요... 아기, 낳을 테니까... 큭」","L"
					CALL HPH_PRINT,@"「제발…… 씨앗을…… 자비를…… 아아앙 HPH HPH HPH」","L"
					PRINTFORMDW 두근. 자궁을 관통하는 동시에, 두 사람은 깊고 깊은 절정에 도달했다
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 당신은 허리를 그라인드로 만들며 귀두로 %조사처리(CALLNAME:TARGET,"의")% 자궁구를 쓰다듬었다.
