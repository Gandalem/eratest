; Modular ERB: 個人口上/143 Yuuma [尤魔]/尤魔/M_KOJO_K143_絶頂.ERB
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K143
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B2_K143
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;睡眠絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし。
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			PRINTFORMW 
			;中
		CASE 2 TO 4
			PRINTFORMW 
			;弱
		CASE 1
			PRINTFORMW 
	ENDSELECT
ENDIF
;-------------------------------------------------
;あなたが射精したときに関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K143_00
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K143_00(ARG)
;-------------------------------------------------
;TARGETの手による射精で、射精対象が非TARGET
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:1000 >= 1
		IF TALENT:MASTER:濃厚精液
			PRINTFORML 「하핫♪ 이게 뭐야, 이거」
			PRINTFORML 「마치 풀 같은 거네. 봐봐, 손으로 집어도 안 떨어져」
			PRINTL 
		ELSE
			IF BASE:MASTER:精力 >= MAXBASE:MASTER:精力 / 2
				PRINTFORML 「크흡흡, 방금 건 꽤 기세가 좋았네」
				PRINTFORML 「봐, 내 손에 잔뜩 튀었잖아」
			ELSE
				PRINTFORML 「뭐야, 기세가 약해져 왔나」
				PRINTFORML 「시시하네, 더 격렬하게 해봐라」
			ENDIF
		ENDIF
	ELSE
		PRINTFORML 「크큭크큭, 내 손이 그렇게 기분 좋았나?」
		IF TALENT:130:恋人
			PRINTFORML 「키쵸우의 그 자식하고 누가 더 잘하는지? 이리, 가르쳐 봐」
		ELSEIF TALENT:133:恋人
			PRINTFORML 「코마는 이런 걸 해주는 건가? 난 네가 원한다면 언제든지 해줄 수 있는데」
		ENDIF
		PRINTL 
	ENDIF
	RETURN 1
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K143_0
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_A_K143_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:MASTER:濃厚精液
		;貪欲
		IF CFLAG:1000 >= 1
			IF CFLAG:K143C_鬼傑組 == 1 ||  CFLAG:K143C_勁牙組 == 1
				PRINTFORML 「하하읏, 꽤 진한 걸 내놓았네」
				IF TALENT:130:恋人
					PRINTFORML 「요시우라보다, 내 보지가 훨씬 더 기분이 좋겠지?」
					PRINTFORML 「괜찮아, 요시우라에서 나로 바꿔도. 쿠쿠쿠크」
					PRINTW 
				ELSEIF TALENT:133:恋人
					PRINTFORML 「코마보다, 내 보지가 훨씬 기분이 좋겠지?」
					PRINTFORML 「괜찮아, 코마한테서 나로 갈아타도. 크크큭」
					PRINTW 
				ELSEIF TALENT:恋人
					PRINTFORML 「부모님 몰래 라이벌 조직의 수장하고 섹스하는 거 흥분되지 않아? 응응?」
					PRINTFORML 「크큭, 말 안 해도 네 거에 매달려 있는 물풍선 같은 콘돔만 봐도 티가 나거든」
					PRINTFORML 「물론, 이걸로 끝나는 건 아니겠지?」
					PRINTFORML 유마는 새로운 콘돔을 손가락 사이에 끼우며 씨익 웃었다...
					PRINTW 
				ENDIF
			ELSEIF CFLAG:K143C_剛欲同盟 == 1
				PRINTFORML 「크크큭. 마치 나를 임신시킬 것처럼 양도 농도도 엄청나네, 어때」
				PRINTFORML 「『임신시키다』라는 말을 듣고 거기가 반응했어. 크크큭, 솔직한 녀네」
				PRINTFORML 「어쩔래? 이 몸이랑 생으로 하고 싶어? 응응?」
				PRINTW 
			ELSE
				PRINTFORML 「크큭. 봐, 이 양을. 조금만 더 했으면 넘칠 뻔했지」
				PRINTFORML 「마치 물풍선 같잖아. 이렇게 많이 내보내면 한 방에 임신할 것 같네. 크큭」
				PRINTW 
			ENDIF
			;貪欲でない
		ELSE
		ENDIF
	ELSE
	ENDIF
	RETURN 1
ENDIF
RETURN 1
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_A_K143_23
RETURN 0

