;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K143_50
CALL M_KOJO_MESSAGE_COM_K143_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K143_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		SELECTCASE TALENT:MASTER:形状
			CASE 6,10;巨根、馬並み
				PRINTFORML 「진심이야… 거의 끝부분밖에 못 끼는데」
				PRINTFORML 「도중에 빠지면 어떡해, 이거…」
			CASE 1,2;粗チン
				PRINTFORML 「너... 콘돔 쪽이 좀 더 큰 것 아닌가?」
				PRINTFORML 「질 안에서 빠지면 나중에 귀찮아진다만...」
			CASEELSE
				PRINTFORML 「스스로 거는 것이 귀찮단 말이냐? 너, 그 정도는 제대로 하도록 해라…」
				PRINTFORML 「…자, 이걸로 괜찮은가?」
		ENDSELECT
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕 || TALENT:恋人
		IF CFLAG:K143C_妊娠レベル <= 7
			PRINTFORML 「너무 비꼬는 건 하지 말아줘……」
			PRINTFORML 자신의 불임 체질을 떠올리며 유마의 표정에 그림자가 드리웠다.
			PRINTW 
		ELSEIF CFLAG:K143C_妊娠レベル >= 8
			PRINTFORML 「겨우 불임이 해소되었는데… 또 임신시키는 건가?」
			PRINTFORML 유마는 사랑하는 %CALLNAME:MASTER%에게서 아이의 씨를 받을 수 있을 것이라 기대하고 있었기에, 쓸쓸한 표정을 짓고 있다.
			PRINTW 
		ELSE
			IF CFLAG:生理周期 == 7
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「분명 오늘은 위험한 날이긴 하지만... 여자의 몸을 배려하다니. 다시 생각해 봤어」
					CASE 1
						IF CFLAG:K143C_鬼傑組 == 1 ||  CFLAG:K143C_勁牙組 == 1
							PRINTFORML 「크큭. 라이벌 조직의 수장을 임신시키다니, 망설여지는 건가?」
							PRINTFORML 「욕망대로 범하면 되는 거잖아. 의외로 점잖네, 너는」
							PRINTW 
						ELSEIF CFLAG:K143C_剛欲同盟 == 1
							PRINTFORML 「크큭. 아무래도 부모를 임신시키기는 좀 망설여지나?」
							PRINTFORML 「딱히 난 네가 괜찮은데 말이야……」
							PRINTW 
						ELSE
							PRINTFORML 「뭐야, 나를 임신시켜 주지 않는 건가」
							PRINTFORML 「너와의 아이라면 출산하는 것도 아깝지 않다. 뭐, 부하들이 시끄럽긴 하겠지만 말이다」
							PRINTW 
						ENDIF
				ENDSELECT
			ELSEIF CFLAG:生理周期 == 1 || CFLAG:生理周期 == 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「쉽게 할 수 있는 일은 아닐 테지만… 뭐, 피임은 중요하다」
						PRINTFORML 「게다가, 이쪽이 순수하게 섹스를 즐길 수 있다는 점이다. 크크큭」
						PRINTW 
					CASE 1
						PRINTFORML 「괜찮은 거야? 손꼽아 기다렸던 안전일인데 말이야?」
						PRINTFORML 「아니면 만일의 사태가 두려운 건가? 너, 정말 진지한 아이구나. 뭐, 그게 나쁘다고는 안 하겠지만」
						PRINTW 
					CASE 2
						IF CFLAG:K143C_鬼傑組 == 1 ||  CFLAG:K143C_勁牙組 == 1
							PRINTFORML 「크큭. 라이벌 조직의 수장을 임신시키다니, 망설여지는 건가?」
							PRINTFORML 「욕망대로 범하면 되는 거잖아. 의외로 점잖네, 너는」
							PRINTW 
						ELSEIF CFLAG:K143C_剛欲同盟 == 1
							PRINTFORML 「크흡. 아무래도 부모님을 임신시키는 건 좀 꺼려지는 걸까?」
							PRINTFORML 「딱히 나는 너라면 괜찮은데…….」
							PRINTFORML 「게다가 오늘은 임신하기 힘든 날이야. 망설이지 않아도 돼?」
							PRINTW 
						ELSE
							PRINTFORML 「뭐야, 나를 임신시켜 주지 않는 건가」
							PRINTFORML 「너와의 아이라면 출산하는 것도 아깝지 않다. 뭐, 부하들이 시끄럽긴 하겠지만 말이다」
							PRINTW 
						ENDIF
				ENDSELECT
			ELSE
				PRINTFORML 「오늘은 위험한 날이라고 할 수도 없지만… 뭐, 만일의 경우도 있겠지」
				PRINTFORML 「임신 중이다 보니 여러모로 불편하다. 지금은 순수하게 섹스를 즐기자고, 응?」
				PRINTW 
			ENDIF
		ENDIF
		;それ以外
	ELSE
		IF CFLAG:143:K143C_性に貪欲 > 0
			PRINTFORML 「나한테 피임하려고 하는 게 제정신이야?」
			PRINTFORML 「이렇게 센 걸 차는 사람 마음을 모르겠네. 아니면, 이쪽이 더 흥분하는 거야?」
			PRINTFORML 「과연, 순수하게 섹스를 즐기고 있는 기분에 빠질 수 있구나... 재미있는 해석이야」
			PRINTW 
		ELSE
			PRINTFORML 「내가 인간의 씨앗으로 임신할 거라고는 생각 못 하지만, 만일의 경우도 있을 수 있어」
			PRINTFORML 「게다가, 배가 불러지면 여러 가지로 불편하니까. 미안하지만 피임해 주길 바라」
			PRINTW 
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
