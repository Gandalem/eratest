;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K143_80
CALL M_KOJO_MESSAGE_COM_K143_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K143_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;初めてのペニス
		IF CFLAG:K143C_ちんぽ初見せ == 0
			SELECTCASE TALENT:MASTER:形状
				CASE 6,10
					PRINTFORML 「！！！」
					PRINTFORML 「하, 뭐야, 이거……」
					PRINTFORML 「내 팔보다 안 굵어? 이거」
					IF BASE:MASTER:勃起 >= 1000
						PRINTFORML 「혈관까지 솟아있네… 이쪽은 식감이 있겠어」
						PRINTFORML 「크쿠크, 농담이야, 장난. 이걸 가지고 놀면 되는 거지?」
					ELSE
						PRINTFORML 「단단해지지 않았는데, 이런 크기를 하고 있는 거야……」
						PRINTFORML 「이게 더 커지는 걸까? 꼭 보고 싶어」
					ENDIF
				CASE 1,2
					PRINTFORML 「흐음, 꽤나 귀여운 게 있네」
					PRINTFORML 「뭐야, 부끄러워할 것 없어. 내 몸에 딱 맞을 테니까」
					PRINTFORML 「자, 우선 만져주도록 하겠어」
				CASE 5
					PRINTFORML 「크흡, 상당히 흉악한 인상을 하고 있다」
					PRINTFORML 「이것으로 여자들을 울렸다고 하는 건가. 그리고 나 또한 그렇게 만들 생각인가?」
					IF TALENT:MASTER:非童貞 == 0
						PRINTFORML 「뭐…… 한 번도 그런 경험이 없다고...?」
						PRINTFORML 「……」
						PRINTFORML 「뭐야…… 그게……. 미안했다」
					ELSE
						PRINTFORML 「기대돼. 하지만 우선 애무부터 시작하지 않을래?」
						PRINTFORML 「……」
						PRINTFORML 「하지만 이거, 뭔가 잡기 힘드네……」
					ENDIF
				CASE 4
					PRINTFORML 「...저기, 있잖아」
					PRINTFORML 「이 눈부신 거 좀 어떻게 해줄 수 없어?」
					PRINTFORML 「딴생각만 나고 의욕이 안 생기는데...」
				CASEELSE
					PRINTFORML 「오호……이게 네 페니스라는 거구나」
					PRINTFORML 「생김새는 어딘가 소시지 같고 맛있어 보이네……. 먹으면 안 되나?」
					PRINTFORML 「쿠쿠크, 농담이야, 농담」
					PRINTL 
			ENDSELECT
			;ペニス2回目以降
		ELSE
			SELECTCASE TALENT:MASTER:形状
				CASE 6,10
					PRINTFORML 「여전하네, 정말 크다……」
					IF TALENT:130:恋人
						PRINTFORML 「이 거대한 걸로, 키요토를 요가시키고 있는 거야?」
					ELSEIF TALENT:133:恋人
						PRINTFORML 「딱 고코마가 좋아할 만한 크기네」
					ENDIF
					IF BASE:MASTER:勃起 >= 1000
						PRINTFORML 「혈관까지 솟아나고…… 이놈은 먹을 맛이 나겠어」
						PRINTFORML 「크흡, 농담이야, 농담. 자, 내가 해줄 테니까 가만히 있어」
					ELSE
						PRINTFORML 「이게 더욱 커진다고 말이다... 놀랍다」
						PRINTFORML 「자, 어서 발기시켜 보라」
					ENDIF
					PRINTL 
				CASE 1,2
					PRINTFORML 「쿠크큭, 여전히 귀여운 외모를 하고 있네」
					IF TALENT:130:恋人
						PRINTFORML 「키토우는 이런 게 취향인 거야?」
					ELSEIF TALENT:133:恋人
						PRINTFORML 「이렇게 작아도 코마를 만족시키고 있는 건가? 대단하네」
					ENDIF
					PRINTFORML 「자자, 단단함이랑 지속력은 어떤 걸까...?」
					PRINTL 
				CASE 5
					PRINTFORML 「크큭, 여전히 사납게 생겼네」
					IF TALENT:130:恋人
						PRINTFORML 「이런 걸 박히고도 주저하다니, 키치오의 취향은 좋은 건지 나쁜 건지 모르겠네」
					ELSEIF TALENT:133:恋人
						PRINTFORML 「코마는 평범한 것으로 만족할 수 없는 거야?」
					ENDIF
					PRINTL 
				CASE 4
					PRINTFORML 「……여전히 눈부시네」
					PRINTFORML 「하기가 좀 힘들어서 그래읏」
					PRINTL 
				CASEELSE
					PRINTFORML 「크크큭, 여전히 맛있어 보이는 모습이네~」
					PRINTFORML 「끝 부분만 먹어도 안 될까? 괜찮잖아, 끝부분 정도는」
					PRINTL 
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF K143C_鬼傑組 == 1
		ELSEIF K143C_勁牙組 == 1
		ELSEIF K143C_剛欲同盟 == 1
		ELSE
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
