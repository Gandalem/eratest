;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K143_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K143_310
CALL M_KOJO_MESSAGE_COM_K143_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K143_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF FIRSTTIME(SELECTCOM)
			;ねだるな、勝ち取れ！
			IF CFLAG:好感度 <= 200
				IF CFLAG:1000 == 1
					PRINTFORML 「호오……♪」
					PRINTFORML 「울고 있는 아이도 침묵하게 만드는 강욕동맹의 수장인 뒤를 거리낌 없이 쓰다듬을 줄이야……」
					PRINTL 
					PRINTFORML 「그래, 욕망에 솔직한 녀석은 싫지 않아」
					PRINTFORML 「나를 따르는 건 있었지만, 나한테 해를 끼치려는 놈은 없었으니까」
					PRINTFORML 「그 비겁함과 간 볼 만한 용기에 봐서 마음껏 만져주도록 하지」
					PRINTFORML 「나도 그런 거 정말 좋아하니까 말이야」
					PRINTL 
					CFLAG:1002 = 2
				ELSE
					PRINTFORML 「이봐 이봐……」
					PRINTFORML 「혹시, 그게 네 욕망이라는 거야?」
					PRINTL 
					PRINTFORML 「뭐, 욕망을 억누르는 것들보다는 훨씬 호감이 가네」
					PRINTFORML 「게다가 지상의 욕망을 받아들인 나에게도 네 마음 정도는 이해할 수 있을 테니까」
					PRINTFORML 「그 빌어먹을 배짱과 대범함에 감명받아 만지는 걸 허락해 주지」
					PRINTL 
					CFLAG:1002 = 1
				ENDIF
			ELSE
				IF CFLAG:1000 == 1
					PRINTFORML 「호오...♪」
					PRINTFORML 「울고 있는 아이도 조용하게 만드는 강욕동맹의 장님의 엉덩이를 쓰다듬다니 말이야...」
					PRINTL 
					PRINTFORML 「뭐, 엉덩이 하나쯤 만진다고 뭐가 달라지지도 않을 테니까」
					PRINTFORML 「어차피 그렇다면 조심스럽게 만지는 것보다, 욕망을 드러내고 만져줬으면 좋겠는데 말이야」
					PRINTL 
					CFLAG:1002 = 1
				ELSE
					PRINTFORML 「이봐 이봐……」
					PRINTFORML 「혹시, 그게 네 욕망이라는 거야?」
					PRINTL 
					PRINTFORML 「두려움보다 열정이 앞섰던 건가, 그저 나의 무서움을 모르는 바보인가……」
					PRINTFORML 「어느 쪽이든, 만진 상대가 나라서 다행이네」
					PRINTFORML 「오니케츠의 게이가의 엉덩이라도 만지려고 했다면, 순식간에 갈기갈기 찢겨 버렸을지도 모르는데」
					PRINTL 
				ENDIF
			ENDIF
			;2回目以降
		ELSE
			IF K143C_セクハラに貪欲 == 2
			ELSEIF K143C_セクハラに貪欲 == 1
			ELSE
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K143_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K143_311
CALL M_KOJO_MESSAGE_COM_K143_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K143_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
		IF CFLAG:K143C_鬼傑組 == 1
			IF TALENT:[[八千慧]]:恋人
			ELSE
				IF TALENT:恋慕 || TALENT:恋人
				ELSE
				ENDIF
			ENDIF
		ELSEIF CFLAG:K143C_勁牙組 == 1
			IF TALENT:[[早鬼]]:恋人
			ELSE
				IF TALENT:恋慕 || TALENT:恋人
				ELSE
				ENDIF
			ENDIF
		ELSEIF CFLAG:K143C_剛欲同盟 == 1
			IF TALENT:[[八千慧]]:恋人
				IF TALENT:恋慕
					SELECTCASE RAND:6
						CASE 0
							PRINTFORML 「내 마음을 알면서, 키요시토와 엮이고 이런 짓을 하다니……」
							PRINTFORML 「너야말로 정말 짐승이구나」
							PRINTFORML 「그리고 그런 네가 나한테 어울려」
						CASE 1
							PRINTFORML 「키토와 비교해서 안아주기 편한 건 어때?」
							PRINTFORML 「나 쪽이 더 좋은 여자잖아? 지금이라도 바꿔도 전혀 상관없을걸?」
						CASE 2
							PRINTFORML 「키치오라는 여자가 있으면서, 대단한 일을 하는구나…」
							PRINTFORML 「아니, 그런 너에게 매달리는 나 자신도 동류다. 지금은 이 시간을 소중히 하자고 하지 않겠나」
						CASE 3
							PRINTFORML 「...있잖아, 키요시랑은 그만두고……」
						CASE 4
							PRINTFORML 「방심한 사이에 엉덩이를 만지려고 하지 마」
							PRINTFORML 「요시토라랑 헤어지면 만져주마? 어쩔래? 쿠큭쿠큭」
						CASE 5
							PRINTFORML 「키토우는 낯가림이 심하니까. 이런 걸 용서해 주지 않을 거야?」
							PRINTFORML 「뭐라고? 아, 보면 굉장히 귀여운 면이 있어? 쳇, 저 자식 둘만 있으면 녹아버리는 타입인가...」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「너 말이다... 언젠가 찔리게 될 거다」
							PRINTFORML 「아마, 여러 곳으로부터」
						CASE 1
							PRINTFORML 「너, 나한테 소속되어 있는데 라이벌 조직의 우두머리랑 연애하고 게다가 나한테까지 와서 안기는 거야……?」
							PRINTFORML 「뭐랄까…… 너 정말 대단하다」
						CASE 2
							PRINTFORML 「너…… 코마의 연인이지?」
							PRINTFORML 「이런 거 해도 되는 걸까……. 아니, 내가 복잡한 기분이랄까……」
					ENDSELECT
				ENDIF
			ELSEIF TALENT:[[早鬼]]:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「너 말이다... 언젠가 찔리게 될 거다」
						PRINTFORML 「아마, 여러 곳으로부터」
					CASE 1
						PRINTFORML 「너, 나한테 소속되어 있는데 라이벌 조직의 우두머리랑 연애하고 게다가 나한테까지 와서 안기는 거야……?」
						PRINTFORML 「뭐랄까…… 너 정말 대단하다」
					CASE 2
						PRINTFORML 「너…… 코마의 연인이지?」
						PRINTFORML 「이런 거 해도 되는 걸까……. 아니, 내가 복잡한 기분이랄까……」
				ENDSELECT
				PRINTW 
			ELSEIF TALENT:[[袿姫]]:恋人
			ELSE
				IF TALENT:恋慕 || TALENT:恋人
					IF TALENT:恋人
						PRINTFORML 「정말, 연인 사이인데 대놓고 안아주지 않는 것도 생각할 만하네」
						PRINTFORML 「당당하게 끌어안을 수 있는 건 이럴 때뿐이야. 조금 더, 이렇게 있어줘……」
						PRINTW 
					ELSE
						PRINTFORML 「몰래 만나지 않으면, 이런 것도 편하게 할 수 없으니까 말이야.」
						PRINTFORML 「이대로 둘이서 어딘가 멀리 떠나버릴까?」
						PRINTFORML 「...뭐랄까. 한번 맡겨진 가마니까. 동맹이 사라질 때까지 내가 동맹장을 다해야 해.」
						PRINTW 
					ENDIF
				ELSE
					SELECTCASE RAND:6
						CASE 0
							PRINTFORML 「너, 꽤 대담한 녀구나...」
							PRINTFORML 「적어도 나도 여자란다...」
						CASE 1
							PRINTFORML 「아니야, 너무 성급한 거 아니야」
							PRINTFORML 「우리는 그런 관계가 아닌걸?」
						CASE 2
							PRINTFORML 「이봐, 너……」
							PRINTFORML 「……뭐, 됐어. 지금은 데이트 중이니까. 특별히 용서해 주지」
						CASE 3
							PRINTFORML 「마주 껴안아 달라고, 주문이 너무 많은 사람이네……」
							PRINTFORML 「……자, 이걸로 됐을까?」
						CASE 4
							PRINTFORML 「너, 거절도 없이……」
							PRINTFORML 「칫, 난 그렇게 값싼 여자가 아니거든」
						CASE 5
							PRINTFORML 「데이트라고 해서 너무 거리낌이 없다고 생각하는 것이겠지」
							PRINTFORML 「...오늘만 특별하게 해주는 것이다」
					ENDSELECT
					PRINTW 
				ENDIF
			ENDIF
			;所属なし
		ELSE
			IF TALENT:[[八千慧]]:恋人
			ELSEIF TALENT:[[早鬼]]:恋人
			ELSEIF TALENT:[[袿姫]]:恋人
			ELSE
				IF TALENT:恋慕 || TALENT:恋人
				ELSE
				ENDIF
			ENDIF
		ENDIF
	ELSEIF CFLAG:睡眠
	ELSE
		IF BASE:MASTER:勃起 >= 1000 && CFLAG:TARGET:溜まってる度 > 200 && TALENT:機嫌 > -1 && CFLAG:ブチギレ == 0
			CALL 勃起処理
		ELSE
		ENDIF
	ENDIF
ENDIF
RETURN 1
