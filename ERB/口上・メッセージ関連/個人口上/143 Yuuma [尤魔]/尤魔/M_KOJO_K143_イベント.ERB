@M_KOJO_EVENT_K143_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:MASTER:現在位置 == 653 || CFLAG:MASTER:現在位置 == 654
			PRINTFORML 「응, 뭐냐. 너였나」
		ELSEIF CFLAG:K143C_鬼傑組 == 1 ||  CFLAG:K143C_勁牙組 == 1
			PRINTFORML 「무슨 일이야? 목숨이라도 얻으러 온 거야?」
		ELSEIF CFLAG:K143C_剛欲同盟 == 1
			PRINTFORML 「무슨 일이야? 뭔가 보고할 거라도 있어?」
		ELSE
			PRINTFORML 「이런 곳까지 일부러 찾아올 정도면 수고가 많구나」
			PRINTFORML 「뭐, 편하게 쉬다 가렴」
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「크쿠쿠, 너냐」
		PRINTFORML 「딱 좋네. 너도 같이 들어가. 벌거벗은 관계라는 거야」
		IF CFLAG:K143C_鬼傑組 == 1 ||  CFLAG:K143C_勁牙組 == 1
			PRINTFORML 「아니면, 적대 조직의 장과 함께 들어가는 게 무서운 거야?」
			IF BASE:MASTER:勃起 >= 1000
				PRINTFORML 「……크흐흐, 거기서 그 물건을 세우고 있다니 대단한 녀로군」
			ENDIF
		ELSEIF CFLAG:K143C_剛欲同盟 == 1
			IF CFLAG:TARGET:溜まってる度 > 600
				PRINTFORML 「꼼꼼하게 씻겨줘. 진주 같은 피부니까 말이야」
			ELSE
				PRINTFORML 「부모의 등을 받드는 것은 자식의 도리일 테지」
			ENDIF
		ELSE
			PRINTFORML 「별로 가져 먹거나 안 하니까 안심하고 들어와도 돼」
		ENDIF
		PRINTL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「뭐야, 선점자인가」
		IF CFLAG:K143C_剛欲同盟 == 1
			PRINTFORML 「나는 지금 혼자 있고 싶은 기분이야. 빨리 나가줘」
			PRINTFORML 「……너, 부모님께 기다리라고 할 배짱이 있구나」
		ELSEIF CFLAG:K143C_鬼傑組 == 1 ||  CFLAG:K143C_勁牙組 == 1
			PRINTFORML 「이봐, 적대 조직의 수장이 무방비한 모습을 보이고 있잖아. 기습할 좋은 기회 아닐까?」
			IF BASE:MASTER:勃起 >= 1000
				PRINTFORML 「……너, 다른 걸로 나를 박고 싶다고 생각하고 있지」
			ENDIF
