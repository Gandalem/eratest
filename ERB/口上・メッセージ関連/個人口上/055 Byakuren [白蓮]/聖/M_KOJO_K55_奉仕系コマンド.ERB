;82,パイズリ
;==================================================

@M_KOJO_MESSAGE_COM_K55_82
CALL PRINT_IMAGE("55_パイズリ0")
CALL M_KOJO_MESSAGE_COM_K55_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K55_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			IF RAND:2 == 0
				PRINTFORMW 잠들어 있는 뱌쿠렌의 가슴골에 페니스를 밀어 넣고, 절정에 도달하기 위해 부드러운 가슴을 주무른다...
			ELSE
				PRINTFORMW 고조된 욕망을 토해내기 위해, 귀두를 뱌쿠렌의 젖꼭지에 대고 비비듯이 자극했다...
			ENDIF
			IF RAND:3 == 0
				PRINTFORMW 「응... 음응! 하아...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응으…… 응… 후우읏…」
			ELSE
				PRINTFORMW 「응음……윽…아…」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 뱌쿠렌의 풍만한 가슴을 양쪽에서 밀어붙이고, 그 틈에 페니스를 삽입했다...
			ELSEIF RAND:2 == 0
				PRINTFORMW 규칙적으로 오르내리는 가슴팍과 밑가슴 사이에 귀두를 미끄러져 넣고, 무게감을 즐겼다……
			ELSE
				PRINTFORM 귀두를 뱌쿠렌의
				SIF PALAM:欲情 >= PALAMLV:4
					PRINTFORM 단단하게 응축된
				PRINTFORMW 유두에 밀착시키고, 깊숙이 파고드는 듯한 가슴 살의 감촉을 음미했다...
			ENDIF
			IF RAND:3 == 0
				PRINTFORMW 「후우……응……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「흡... 으응...」
			ELSE
				PRINTFORMW 「응응……」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;初めてチンコを間近で観察
		IF CFLAG:1209 == 0
			IF TALENT:恋慕
				PRINTFORMW 「……이게, %조사처리(CALLNAME:MASTER,"의")%……」
			ELSE
				PRINTFORMW 「우와아…… 꽤나 멋진 것을 가지고 계시네요……」
			ENDIF
			PRINTFORMW 뱌쿠렌은 잔뜩 긴장한 당신의 페니스를 바라보며, 긴장으로 고인 침을 꿀꺽 삼켰다.
			PRINTFORML
			PRINTFORML 「가슴으로 해줬으면, 하고…… 이렇게 할까……」
			PRINTFORMW 뱌쿠렌의 풍만한 가슴은 페니스를 빈틈없이 감싸버렸다.
			PRINTFORML 「아, 뜨거워…… 이대로 문지르면 되는 거야?」
			PRINTFORMW 그렇게 말하자, 뱌쿠렌은 힘을 주며 유방 봉사를 시작했다.
			PRINTFORML 부드러운 가슴이 자극에서 귀두까지 고루 쓸어 올리며 예상 이상의 쾌락을 선사한다.
			PRINTFORMW 너무나 큰 감각에 당신은 자신도 모르게 신음 소리를 냈다.
			PRINTFORML 「아…… 혹시, 뭔가 마음에 안 들었을까……」
			PRINTFORMW 뱌쿠렌은 한 번 손을 멈추고 당신의 얼굴을 들여다보았다.
