;==================================================
;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K55_80
CALL M_KOJO_MESSAGE_COM_K55_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K55_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 뱌쿠렌은 %조사처리(CALLNAME:MASTER,"와")% 마주 보는 형태로, %조사처리(CALLNAME:MASTER,"의")% 성기에 손가락을 움직였다.
		PRINTFORML 부드럽고 열기를 머금은 나체와 밀착하며, 뜨겁고 축축한 숨결과 뱌쿠렌의 머리에서 풍겨오는 향기가 %조사처리(CALLNAME:MASTER,"의")% 이성을 파괴해 간다…
		PRINTFORMW 뱌쿠렌의 입술에 달라붙어 엉덩이 살을 움켜쥐고 끌어당기자, 단단함이 하복부에 닿으며 앞서 나온 애액이 그녀의 손가락을 더럽힌다…
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;技巧3以上
			IF ABL:技巧 >= 3
				;精液中毒3以上
				IF ABL:精液中毒 >= 3 && RAND:2 == 0
					IF RAND:2 == 0
						PRINTFORML 「하아, 하아, 아, 부풀어서……%UNICODE(0x2665)% 벌써 나오는 거예요? 터져버리는 건가요?」
						PRINTFORML 「괜찮아요……%UNICODE(0x2665)% 이대로 저에게…… 당신의 진한 정액을 뿌려주세요……」
						PRINTFORMW 뱌쿠렌은 사정 전조를 느끼자, 음란한 표정을 지으며 성기를 비비는 손의 움직임을 빠르게 했다…
					ELSE
						PRINTFORML 「하아, 앗……%UNICODE(0x2665)% 저갈 것 같아?」
						PRINTFORML 「있잖아, 쌀 때는 최대한 참았다가 싸줄 수 있을까」
						PRINTFORMW 「나 나올 때까지 잔뜩 참았다가 나온, 당신의 가장 진한 걸 원해……%UNICODE(0x2665)%」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「아하…… 손안에서, 파르르 떨면서 발버둥 치고 있네…… 벌써 한계인가요……」
						PRINTFORMW 「괜찮아요…… 그대로 끝이 나고, 내 손을 질척하게 더럽혀도…… %UNICODE(0x2665)%」
					ELSE
						PRINTFORML 「……여기, 엄청 뜨거워지고 있어요…. 갈 것 같으시네요…」
						PRINTFORMW 「괜찮아요, %CALLNAME:MASTER%… 잔뜩, 싸 주세요…%UNICODE(0x2665)%」
					ENDIF
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「에…… 갈 것 같아…? 알겠다, 이대로 손으로…」
					PRINTFORMW 사정을 예고받은 뱌쿠렌은 페니스를 문 손의 속도를 높였다.
				ELSE
					PRINTFORML 「아, 몸이 떨리고... 갈 것 같으시네요...?」
					PRINTFORMW 뱌쿠렌은 사정의 전조를 느끼고 숨을 들이켰다.
				ENDIF
			ENDIF
			;射精しない
		ELSE
			DRAWLINE
			PRINTFORML 뱌쿠렌은 손을 사용하지 않고 \@ PREVCOM == SELECTCOM ? 계속 봉사를 이어가고 있다 # 당신에게 봉사하기 시작했다 \@...
			PRINTFORML 　
			;勃起しきっていない
			IF BASE:MASTER:勃起 < 1000
				IF RAND:2 == 0
					PRINTFORML 어라, 아직 커지지 않았군요...
					PRINTFORMW 　이렇게 작을 때는… 후후. 조금 귀여울지도 몰라요.
					PRINTFORMW 「아, 커졌네... %UNICODE(0x2665)% 아하핫, 칭찬받아서 기뻤어요?」
				ELSE
					PRINTFORML 뱌쿠렌은 완전히 발기하지 않은 성기를 손가락으로 만지작거리며 가지고 논다.
					PRINTFORMW 「후후후. 착하다, 착해……%UNICODE(0x2665)%… 아, 단단해졌네」
					PRINTFORMW 「솔직한 좋은 아들이네요, %CALLNAME:MASTER%♪」
				ENDIF
				;普通の
			ELSE
				;指のLv2以上か技巧4以上で分岐2つ追加
				;精液中毒3以上でランダム分岐4つ追加
				IF RAND:9 == 0 && ABL:精液中毒 >= 3
					PRINTFORMW 「스으읍~… 하아, 이 냄새 참을 수가 없어…… %UNICODE(0x2665)%」
					PRINTFORMW 뱌쿠렌은 당신의 가슴팍에 코를 가까이 대고 심호흡하듯 성스러운 향기를 맡았다.
					PRINTFORML 「변태 같다니… 대체 누가 그런 생각을 하게 만든 건가요」
					PRINTFORMW 「책임을 지고, 잔뜩 내주세요…… %UNICODE(0x2665)%」
				ELSEIF RAND:8 == 0 && ABL:精液中毒 >= 3
					PRINTFORMW 「이제. 내 손이 앞서 나가서 질척질척해져 버렸잖아요. 하아, 응류, 레로오...」
					PRINTFORMW 뱌쿠렌은 손에 묻은 쿠퍼선액을 정성스럽게 핥으면서, 손바닥을 타액투성이로 만들어 간다...
					PRINTFORML 「있잖아요, 이대로 손으로 비비면... 봐요, 내 타액과 당신의 앞서 나간 것이 섞여서...」
					PRINTFORMW 　후후, 질척질척해져서... 생각했던 것보다 굉장한 소리가 나네요. 정말, 외설적이에요...」
				ELSEIF RAND:7 == 0 && ABL:精液中毒 >= 3
					PRINTFORMW 「하아, 하아... 후후... 그래, 그대로, 꾹 참아서... 흥분시켜줘...」
					PRINTFORMW 「가장 진해진 걸 나한테 주세요... %UNICODE(0x2665)%」
				ELSEIF RAND:6 == 0 && ABL:精液中毒 >= 3
					PRINTFORMW 「하아, 하아, 아아...%UNICODE(0x2665)% 이 냄새, 좋다...%UNICODE(0x2665)%」
					PRINTFORMW 뱌쿠렌은 숨이 막힐 정도로 얼굴을 가까이하며 음경을 다루고 있다.
				ELSEIF RAND:5 == 0 && (ABL:指 >= 2 || ABL:技巧 >= 4)
					PRINTFORMW 「후후, 초라한 얼굴 하고 있네……. 그렇게 내 손이 좋은가 보네?」
				ELSEIF RAND:4 == 0 && (ABL:指 >= 2 || ABL:技巧 >= 4)
					PRINTFORML 「자, 이렇게 목덜미를 만져주는 것도 좋지 않나요?」
					PRINTFORMW 「당신이 느끼는 곳은 정확히 파악하고 있다고 생각합니다.」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「……아아, 이렇게까지 뜨겁고, 단단해서……%UNICODE(0x2665)%」
					PRINTFORMW 뱌쿠렌은 욕정에 잠긴 눈으로 손안의 페니스를 응시하고 있다…
				ELSEIF RAND:2 == 0
					PRINTFORMW 「있잖아, %CALLNAME:MASTER%. 내 손, 기분 좋아…?」
					PRINTFORMW 흥분에 눈을 촉촉하게 적신 채 뱌쿠렌이 물었다.
				ELSE
					PRINTFORMW (아아, %조사처리(CALLNAME:MASTER,"의")% 것이 내 손안에...)
					PRINTFORMW (더, 기분 좋게 해주고 싶어……)
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
		;恋慕なし
	ELSE
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			IF RAND:2 == 0
				PRINTFORMW 「엣... 갈 것 같아...? 아, 부풀었어...!?」
			ELSE
				PRINTFORMW (덜덜 떨면서…… 나올 것 같아…….?)
			ENDIF
			;射精しない
		ELSE
			DRAWLINE
			PRINTFORML 뱌쿠렌은 손을 사용하지 않고 \@ PREVCOM == SELECTCOM ? 계속 봉사를 이어가고 있다 # 당신에게 봉사하기 시작했다 \@...
			PRINTFORML 　
			;勃起しきっていない
			IF BASE:MASTER:勃起 < 1000
				IF RAND:2 == 0
					PRINTFORMW 「와…… 손 안에서, 점점 커지고 있어……」
				ELSE
					PRINTFORML 뱌쿠렌은 완전히 발기하지 않은 성기를 만지작거리며 가지고 논다.
					PRINTFORMW 「아아, 점점 단단해져…」
					PRINTFORMW 「이렇게 하면 흥분하는 거예요? %CALLNAME:MASTER%……」
				ENDIF
				;普通の
			ELSE
				IF MARK:不埒刻印 == 3
					IF RAND:3 == 0
						PRINTFORMW 「손으로 해줬으면 하는 거야?... 후후, 알았어」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「후후, %조사처리(CALLNAME:MASTER,"가")% 내 손안에서 날뛰고 있어……」
					ELSE
						PRINTFORMW 「후훗…♪ 흐트러진 얼굴을 하고 있네… %UNICODE(0x2665)%」
					ENDIF
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「저기…… 이대로 괜찮은 걸까」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「아, 뜨겁고, 단단해……」
					ELSE
						PRINTFORMW 「손으로...? 뭐, 괜찮지만...」
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K55_81
CALL PRINT_IMAGE("55_フェラチオ0")
CALL M_KOJO_MESSAGE_COM_K55_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K55_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「넣는 거군요…… 알겠어요……」
		PRINTFORMW 뱌쿠렌은 시험 삼아 그곳에 혀를 내밀고, 끝부분만 살짝 건드린다.
		PRINTFORMW 그대로 귀두를 쓰다듬더니, 이윽고 과감하게 입안으로 그것을 머금었다
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;浴場
	ELSEIF BATHROOM(CFLAG:現在位置)
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 욕조에 몸을 담근 뱌쿠렌은 열기와 흥분으로 뺨을 붉히며 %조사처리(CALLNAME:MASTER,"의")% 가랑이 쪽으로 얼굴을 가까이 가져갔다.
				PRINTFORMW 새로운 장난감을 발견한 강아지처럼 %조사처리(CALLNAME:MASTER,"의")% 페니스를 바라보며 음경에 혀를 갖다 대고 핥아 올린다.
				PRINTFORMW 목욕탕에 울려 퍼지는 음란한 물소리와 뜨거운 물에 젖은 뱌쿠렌의 나체, 가랑이를 감싸는 입과 질의 감촉을 만끽하는 %CALLNAME:MASTER%
				PRINTFORMW 위로하듯 뺨을 쓰다듬어 주자 기쁜 듯 눈을 가늘게 뜨며 %조사처리(CALLNAME:MASTER,"의")% 허벅지에 축축한 상체를 밀착시켰다.
			CASEELSE
				PRINTFORML 뱌쿠렌의 재촉에, %조사처리(CALLNAME:MASTER,"는")% 욕조 가장자리에 걸터앉았다.
				PRINTFORMW 물방울이 떨어지는 뱌쿠렌의 나신에 흥분을 주체하지 못하고, 페니스는 아플 정도로 발기해 있다.
				PRINTFORMW 김에 뒤섞여 독특한 향을 풍기는 그것에게, 뱌쿠렌은 얼굴을 가까이 가져가 망설임 없이 입에 물고 귀두를 핥아댔다.
		ENDSELECT
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:2 == 0
			PRINTFORML 「응읏, 음훗... 거시기 냄새……」
			PRINTFORML 헌신적인 페라치오임에도 쾌감은 가차 없다.
			PRINTFORML 「하... 주루... 응으... 흘러...」
			PRINTFORMW 더 맛보고 싶지만, 얼마나 버틸 수 있을지는 알 수 없다.
		ELSE
			PRINTFORML 「츄, 츄읏, 추우…… 읍, 쩔어, 쩔어……읏」
			PRINTFORML 카리의 옆면을 핥으며 손으로 애지럽힌다.
			PRINTFORMW 뱌쿠렌의 타액으로 만질 때마다 '츄', '츄' 하는 소리가 난다.
			PRINTFORML 「츄읏…… 소리, 야해……」
			PRINTFORMW 그렇게 말하면서 기쁜 듯 다시 카리를 핥기 시작한다.
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「츄, 쭉, 아무……츄읍, 파아……♪」
		PRINTFORML 물고 있는 뱌쿠렌도 흥분했는지, 볼이 새빨갛게 물들어 있다.
		PRINTFORML 「쿠츳, 주, 주우웅……아앙……윽!」
		PRINTFORMW 봉사하는 와중에도 고조되어 오는지, 더욱 거친 숨소리가 된다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 뱌쿠렌은 시행착오를 거치며 올려다보는 눈빛으로 당신을 살피며 봉사한다.
		PRINTFORMW 「윽…응…」
		PRINTFORMW 「…맡겨줘…」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
