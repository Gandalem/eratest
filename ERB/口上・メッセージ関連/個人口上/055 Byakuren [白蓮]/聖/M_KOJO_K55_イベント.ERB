@M_KOJO_EVENT_K55_22(ARG,ARG:1)
;口上主はARG
;ARG:0に自慰状況
;ARG:1に自慰種類
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;通常自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同室時自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「쪽, 쭉, 응, 좋아, 좋아……읏」
		PRINTFORMW 온몸을 감싸는 압박감과 하반신의 달콤한 저림에 %조사처리(CALLNAME:MASTER,"는")% 눈을 떴다.
		PRINTFORMW 어두운 실내에서 눈을 가늘게 뜨자 눈앞에는 %CALLNAME:MASTER%위에 올라타 정신없이 허리를 흔드는 뱌쿠렌의 모습이 있었다.
		PRINTFORMW 옷을 벗어던지고 탐욕스러운 표정을 지은 채, 때때로 %조사처리(CALLNAME:MASTER,"에게")% 몸을 겹치며 혀를 내밀어 뒤엉키게 한다.
		PRINTFORMW 「아……! 죄송해요, 깨웠죠……?」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 각성에 알아차리고 몸을 빼려던 뱌쿠렌을 붙잡고, 사그라들 줄 모르는 분노로 자궁을 밀어붙이며 질내를 탐했다.
		PRINTFORMW 「아, 응, 응응응응!! %CALLNAME:MASTER%, 갑자기, 격렬하게읏!!」
		PRINTFORMW 「좋아, 좋아……! 더, 더 찔러줘애애엣♪」
		PRINTFORML …
		PRINTFORMW 몇 번의 절정 끝에 소원을 이룬 두 사람은 서로를 끌어안은 채 깊은 잠에 빠졌다...
		CALL ADD_SAMEN_V(55, BASE:MASTER:精力)
		EXP:55:精液経験 += 5
		EXP:55:膣射経験 += 5
		EXP:55:Ｖ性交経験 += 5
		EXP:55:絶頂経験 += 4
		EXP:MASTER:絶頂経験 += 4
		EXP:MASTER:射精経験 += 5
		EXP:MASTER:挿入経験 += 5
		TALENT:MASTER:120 = 0
		CFLAG:MASTER:徹夜 = 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;中だし精液自慰
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無知持ち（自慰経験(調教自慰経験は差し引き)による分岐あり
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		LOCAL:2 = EXP:自慰経験 - EXP:調教自慰経験
		;無知消去イベントあり（表示は一度だけ
		IF LOCAL:1 >= 25
			;地の文分岐。書きたい場合は[SKIPSTART][SKIPEND]を削除してください
		ELSE
		ENDIF
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;陥落素質あり自慰中毒高め
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;-------------------------------------------------
		;Ｃ敏感orＣ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;Ｖ敏感orＶ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;Ａ敏感orＡ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 3
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;Ｂ敏感orＢ感覚10以上
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 4
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部位指定無し
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 5
			PRINTFORML  
			RETURN 1
		ENDIF
		;その他
		;上の分岐を一切書かずに、ここに書くことで陥落素質あり自慰中毒高め自慰の共通口上を表示することが出来ます
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;自慰中毒高め
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;-------------------------------------------------
		;尻穴膣腔同時
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML  
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;膣腔のみ
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML  
			RETURN 1
		ENDIF
		;その他
		;上の分岐を一切書かずに、ここに書くことで自慰中毒高め自慰の共通口上を表示することが出来ます
		PRINTFORML  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;我慢
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 
		RETURN 1
	ENDIF
	;その他
	;上の分岐を一切書かずに、ここに書くことで自慰の共通口上を表示することが出来ます
	PRINTFORML  
	RETURN 1
ENDIF
RETURN 1
