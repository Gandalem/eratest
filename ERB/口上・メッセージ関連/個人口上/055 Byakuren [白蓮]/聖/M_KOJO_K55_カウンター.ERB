;MASTERについている
IF TALENT:PLAYER:2 & 2
	IF TALENT:恋慕
		;これでMASTERが射精する
		IF NOWEX:MASTER:11
			;精飲経験19以下
			IF TCVAR:精飲経験 <= 19
				IF RAND:3 == 0
					PRINTFORMW 「아후…… 응, 나올 것 같아...?」
				ELSEIF RAND:2 == 0
					PRINTFORML 「음, 쪽, 쭉~윽……」
					PRINTFORMW 「……?……응……읏!」
				ELSE
					PRINTFORML 「츄릅, 츄쥬우... 츄읍, 레루...」
					PRINTFORMW 「……~~~~읏!?」
				ENDIF
			ELSE
				;精液中毒 >= 3で分岐4つ追加。
				IF RAND:8 == 0 && ABL:精液中毒 >= 3
					PRINTFORMW 「푸줏, 츄쥬우웅%UNICODE(0x2665)% 후우큭, 후우큭%UNICODE(0x2665)% , 추, 츄무, 추부우욱%UNICODE(0x2665)%」
				ELSEIF RAND:7 == 0 && ABL:精液中毒 >= 3
					PRINTFORML 「응, 쪽……%UNICODE(0x2665)% 후후, 나올 것 같네…. 좋아, 입안에, 전부, 내게 싸줘들어……」
					PRINTFORMW 뱌쿠렌은 다시 음경을 구강 안으로 받아들이고, 마지막 스퍼트처럼 움직임을 빠르게 했다.
				ELSEIF RAND:6 == 0 && ABL:精液中毒 >= 3
					PRINTFORMW 「응읏… %UNICODE(0x2665)% 이리, 주르륵, 나와봐…… %UNICODE(0x2665)%」
				ELSEIF RAND:5 == 0 && ABL:精液中毒 >= 3
