@M_KOJO_MESSAGE_SCOM_K55_6
CALL M_KOJO_MESSAGE_SCOM_K55_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K55_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「후와앗%UNICODE(0x2764)%!응……뭡니까……방금 그거……」
		PRINTFORML 당신이 뱌쿠렌의 약한 곳을 발견하자 여러 번 괴롭히듯이 콕콕 건드린다.
		PRINTFORML 「거기읏%UNICODE(0x2764)% 기분 좋아아앙%UNICODE(0x2764)% 안 돼! 머리 좀 넓게 해줘어어%UNICODE(0x2764)%%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		;媚薬フラグ有
	ELSEIF TCVAR:140
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「히아우우%UNICODE(0x2764)%거기 조아아아%UNICODE(0x2764)%모로이 히메테에%UNICODE(0x2764)%%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「응야아읏%UNICODE(0x2764)%후그큭%UNICODE(0x2764)%입구 구르르르%UNICODE(0x2764)%죽겠어읏%UNICODE(0x2764)%」
				PRINTFORMW 미약의 강렬한 효과에 빠져, 뱌쿠렌은 추태를 부리며 요란하게 신음을 내고 있다…
		ENDSELECT
		;前回射精した
	ELSEIF TCVAR:102
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「그, 그럴 수가… 방금, 사정한 지 얼마 안 됐는데…!? 윽%UNICODE(0x2764)%으아앗%UNICODE(0x2764)%너무 거칠어, 윽…%UNICODE(0x2764)%」
				PRINTFORML 육봉을 뱌쿠렌의 질 내에 넣은 채, 방금 내뿜은 정액을 그녀의 약점에 문질러 바른다.
				PRINTFORML 어디를, 어떻게 당하면 느끼게 될까. 선명한 육욕의 기억을, 아름다운 굴곡을 지닌 극상의 여체에 새겨 나간다.
				PRINTFORMW 「히잉, 윽, 아아아앗%UNICODE(0x2764)%안 돼, 안 돼… 으앗%UNICODE(0x2764)%으아, 응으으윽%UNICODE(0x2764)%%CALLNAME:MASTER%읏…%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「아쿠앗, 하앙……%UNICODE(0x2764)% 그, 그런 소 내지 말아주세요…」
				PRINTFORML 허리를 살짝 뒤로 빼고 뱌쿠렌의 입구를 귀두로 집요하게 비비자, 가슴팍이 질벽을 꾹꾹 밀어내며,
				PRINTFORMW 안에 있던 정액을 조금씩 짜내 축축하고 음탕한 물소리를 자아낸다.
				PRINTFORML 
				PRINTFORML 「응으으윽... 아우, 그만해……!~~~~~윽…%UNICODE(0x2764)%」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 풍만한 엉덩이를 흔들며 공격에서 벗어나려 하는 뱌쿠렌의 허리를 붙잡고 단숨에 가장 깊은 곳을 관통했다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응읏%UNICODE(0x2764)%큭%UNICODE(0x2764)%후우우우읏%UNICODE(0x2764)%…이거, 응응… 이건, 안 돼…%UNICODE(0x2764)%응우욱%UNICODE(0x2764)%」
				PRINTFORMW 음핵 뒤쪽의 신경을 압박하며 풀어주는 듯한 얕은 피스톤질에, 뱌쿠렌은 자신의 손가락을 물면서 필사적으로 버티고 있다.
				;これで絶頂する
				IF NOWEX:TARGET:Ｖ絶頂
					PRINTFORML 
					PRINTFORML 「하아, 후우…… 갈 걸 참으려는 모습이 귀엽다고…? 정말 무슨 소리를 하고 있는 건지 모르겠군…」
					PRINTFORML 「윽%UNICODE(0x2764)%～～～～읏%UNICODE(0x2764)%」
					PRINTFORMW 수줍게 한 틈을 노려 허리를 들자, 뱌쿠렌은 사랑스러운 소리를 내며 몸을 뒤틀었다.
				ENDIF
			CASE 1
				PRINTFORML 「아앗, 아아아앗…%UNICODE(0x2764)%거기, 굉장해요…%UNICODE(0x2764)%이런 거, 못 참겠어어…」
				PRINTFORML 입구와 가까운 곳을 짓누르듯 헤집어 주자, 뱌쿠렌은 견딜 수 없다는 듯 어깨를 떨었다.
				PRINTFORML 「%CALLNAME:MASTER%…%CALLNAME:MASTER%…%UNICODE(0x2764)%…더, 부탁드려요…」
			CASE 2
				PRINTFORML 「하아아앙읏%UNICODE(0x2764)%앗, 앗, 아앗%UNICODE(0x2764)%응읏…%UNICODE(0x2764)%」
				PRINTFORML 약점을 찔리는 것이 견딜 수 없는 것인지, 뱌쿠렌은 스스로도 허리를 작게 흔들며 %조사처리(CALLNAME:MASTER,"의")% 피스톤질에 응하고 있다.
				PRINTFORMW 「안이, 굉장해요…%UNICODE(0x2764)%아하앗, 좋아…%UNICODE(0x2764)%이상해져 버릴 것 같아…%UNICODE(0x2764)%」
				;長いし頻出しないように　女の子の方から乱れてくれるのが嬉しいというご意見がありましたので
				IF ABL:Ｖ感覚 >= 5 && RAND:3 == 0 && (TALENT:恋慕 || TALENT:愛欲)
					PRINTFORML 
					PRINTFORML 「하아앗, 아, 아%UNICODE(0x2764)%응, 아아…?」
					PRINTFORML 서로의 타이밍이 맞지 않았던 것인지, 문득 접합부가 떨어져 버린다.
					PRINTFORMW 활짝 입을 연 뱌쿠렌의 밀랍 구멍에서는 \@ 充填率(TARGET,1) >=100 ? 거품이 일어난 점액이 백탁과 섞여 # 시토도에 넘치는 이슬이 \@ 떨어지려 하고 있었다.
					PRINTFORML
					PRINTFORML 「……저기, %조사처리(CALLNAME:MASTER,"가")%?」
					PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 비밀스러운 입술을 관찰하고 있자, 뱌쿠렌은 조금 난처한 듯 이쪽을 바라본다.
					PRINTFORMW ……조금 장난기가 발동하여 그녀가 어떻게 할지 그대로 지켜보기로 했다.
					PRINTFORML 
					PRINTFORML 「……후훗. 그런 거였구나」
					PRINTFORML 뱌쿠렌은 무언가 납득한 듯 가볍게 고개를 끄덕이더니, 당신의 페니스에 조심스럽게 손을 댄다.
					PRINTFORMW 「후후, 정말 뜨겁고 단단하고 듬직해, 나의 사랑스러운 사람」
					PRINTFORML
					PRINTFORML 남근을 부드럽게 움켜쥐고, 츄읍 하고 작은 물소리를 내며 음구와 질구를 입 맞춘다.
					PRINTFORML 그 상태로 뱌쿠렌은 허리를 느릿하게 상하로 움직이며 서로의 점액을 섞은 뒤, 쭈욱 그것을 삼켜 내려갔다.
					PRINTFORMW 「……응읏%UNICODE(0x2764)%」
					PRINTFORML
					PRINTFORML 「저…… 완전히, 당신의 성기에 빠져버렸나 봐요」
					PRINTFORM 「이렇게 입구를 비벼지는 것도」
					SIF ABL:精液中毒 > 3
						PRINTFORM , 마셔도 받을 수 있을까
					SIF ABL:肛射中毒 > 3
						PRINTFORM 엉덩이에 주어지는 것도
					IF ABL:膣射中毒 > 3
						PRINTFORML 질내를 가득 채워지는 것도……
					ELSE
						PRINTFORML 깊은 곳을 괴롭힘 당하는 것도……
					ENDIF
					PRINTFORML 　당신에게 받는 모든 것이 좋아하는 거야」
					PRINTFORMW 뜨거운 말투로 애정의 말을 토해내며, 느릿느릿 골반을 움직여 당신에게 아첨하는 뱌쿠렌.
					PRINTFORML 
					PRINTFORML 이끌리듯, %조사처리(CALLNAME:MASTER,"는")% 꽉 허리를 밀어 넣어 그녀를 기쁘게 한다.
					PRINTFORMW 「그래, 그래어…… 아앗, 응응! 당신과 이렇게 있는 게 제일 좋아... %UNICODE(0x2764)% %CALLNAME:MASTER%, %CALLNAME:MASTER%읏...%UNICODE(0x2764)%」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
