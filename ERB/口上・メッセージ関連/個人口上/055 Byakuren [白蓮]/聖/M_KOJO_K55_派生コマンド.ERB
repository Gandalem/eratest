ELSEIF TEQUIP:体位２ == 3
	CALL PRINT_IMAGE("55_騎乗位種付0")
ENDIF
CALL M_KOJO_MESSAGE_SCOM_K55_7_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K55_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「응구우%UNICODE(0x2764)%굉장해읏%UNICODE(0x2764)%깊숙한 곳까지 키스당하고 있어읏%UNICODE(0x2764)%」
		RETURN 1
	ENDIF
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORML 「하아 안 돼 %UNICODE(0x2764)% 사정하고 바로 박히면 어떡해 히야우우 %UNICODE(0x2764)%%UNICODE(0x2764)%」
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	IF TCVAR:140
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「응, 응구으윽~~%UNICODE(0x2764)% 아, 아주 깊숙이 와버렸어~~%UNICODE(0x2764)%」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 귀두와 뱌쿠렌의 자궁구가 부딪히는 말랑한 살결의 감각에, 뱌쿠렌은 완전히 취해버렸다…….
				PRINTFORML 「아아아앗~~%UNICODE(0x2764)% 하후, 하아앗%UNICODE(0x2764)% %CALLNAME:MASTER%읏, %CALLNAME:MASTER%읏~~%UNICODE(0x2764)%」
				PRINTFORMW 자궁구부터 자궁 전체를 몇 번이고 흔들리며, 뱌쿠렌의 마음은 여자로서 최고의 환희로 가득 차버렸다…….
			CASE 1
				PRINTFORML 「후아앗%UNICODE(0x2764)% 아우읏, 윽, 아아아앗%UNICODE(0x2764)% 응응, 아아아앗~~%UNICODE(0x2764)%」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 단단함이 뱌쿠렌의 부드러운 자궁경부를 비틀 때마다, 뱌쿠렌은 황홀한 비명을 지르고 있다…….
				PRINTFORML 「읏, 쉬욱옷%UNICODE(0x2764)% 아아앗, 쉬욱가앗, 히이이%UNICODE(0x2764)% 기분 좋아어~~%UNICODE(0x2764)%」
