@M_KOJO_MESSAGE_SCOM_K55_1
CALL M_KOJO_MESSAGE_SCOM_K55_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K55_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		A = RAND:3
		IF A == 0
			PRINTFORML 「함께…… 기분 좋아지자구네」
			PRINTFORML 식스나인의 형태로 변해, 서로의 성기를 핥아내린다.
			PRINTFORML 「응…… 챱, 쪽, 츄릅……앗」
			PRINTFORML 남성기가 뱌쿠렌의 입 속으로 삼켜져 들어간다.
			PRINTFORMW %CALLNAME:MASTER%도 뱌쿠렌이 움찔거리며 움직이는 은밀한 곳을 혀로 핥아 올린다.
		ELSEIF A == 1
			PRINTFORML 「응읏, 응으으윽, 주, 주파앗, 주루루룻!!」
			PRINTFORML 두 사람의 움직임은 점점 고조된다.
			PRINTFORML 한 치의 망설임 없이 서로를 최고로 끌어올리며 절정에 필사적으로 다가간다.
			PRINTFORMW 「응, 응아, 추, 추읍, 추프앗! 파, 아아앙ッ」
		ELSE
			PRINTFORML 「응읏, 응, 응, 응, 응우욱♪」
			PRINTFORML 뱌쿠렌의 스트로크가 빨라져 간다.
			PRINTFORML %CALLNAME:MASTER%역시 은밀한 곳에 손가락을 삽입하고 혀로 클리토리스를 문지른다.
			PRINTFORML 「응우우욱!! 쥬, 쥬르륵!!」
			PRINTFORMW 　추읍, 추릅, 낼름낼름, 하, 하아, 아무, 주풉!
		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K55_{SELECTCOM}_1
RETURN 1
