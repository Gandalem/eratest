						;薄曇
					CASE 2
						;夜
						IF TIME:2 == 3
							PRINTFORMW 「밤안개가 피어나고 참 아름답네요. 이런 달도 만만치 않게 좋은걸요」
							;夏
						ELSEIF DAY:2 == 2
							PRINTFORMW 「덥긴 하지만, 햇살이 강하지 않으니까 그나마 다행이네요」
						ELSE
							PRINTFORMW 「흐린 날씨라고 할까. 뭐, 그렇게 나쁜 날씨는 아니다」
						ENDIF
						;曇
					CASE 3
						;夜
						IF TIME:2 == 3
							PRINTFORMW 「달빛이 없으니까 되게 어둡네요」
						ELSE
							PRINTFORMW 「꽤 흐리네요. 비가 안 왔으면 좋겠는데……」
						ENDIF
						;雨、大雨、霧雨
					CASE 4,5,6
						;外(山門、境内、裏庭、墓地)
						IF OUTROOF(CFLAG:MASTER:現在位置)
