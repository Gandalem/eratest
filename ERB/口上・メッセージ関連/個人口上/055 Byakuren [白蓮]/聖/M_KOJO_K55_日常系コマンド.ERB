TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K55_301
CALL M_KOJO_MESSAGE_COM_K55_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K55_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;うふふが解除されていることを念押しする処理
	CFLAG:1211 = 0
	IF CFLAG:ブチギレ
		PRINTFORMW 「……차에 대해서는, 감사하다고 할게」
		;初めて
	ELSEIF FIRSTTIME(SELECTCOM)
		PRINTFORML 「아, 차를 내려주셨군요. 고마워요, %CALLNAME:MASTER%」
		PRINTFORM 그렇게 말하며 받은 차를 마신 뱌쿠렌은
		;マズー
		IF TFLAG:193 == -1
			PRINTFORML 한 모금 마시고, 사레들었다.
			PRINTFORMW 「……크헉, 크큭. 참 독특한 맛이네요」
			;ウマー
		ELSEIF TFLAG:193 == 1
			PRINTFORML 한 모금 머금고, 기분 좋게 눈을 가늘게 떴다. 
			PRINTFORMW 「아아, 능숙하시네요, %CALLNAME:MASTER%」
			;フツー
		ELSE
			PRINTFORML 싱긋 미소 지었다.
			PRINTFORMW 「후후, 맛있어요」
		ENDIF
		;二回目以降
	ELSE
		;◆睡眠薬だぜひゃっはー
		IF TFLAG:194
			IF TFLAG:194 < 0
				PRINTFORMW 「……저기, 뭐라고 해야 할지 모를 악의가 느껴져요. 죄송하지만……」
			ELSE
				IF TFLAG:193 == 1
					PRINTFORMW 「뭔가 숨겨진 맛이라도 넣은 걸까. 평소랑은 다르지만, 맛있었어요」
				ELSEIF TFLAG:193 == -1
					PRINTFORMW 「……잡미라고 하기엔 그게, 뭔가 수상한 맛이 나네」
				ELSE
					PRINTFORML 「음—?」
					PRINTFORMW 뱌쿠렌은 무언가 위화감을 느낀 듯했으나, 그대로 다 마셔버렸다...
				ENDIF
			ENDIF
			;混ぜ物なし
		ELSE
			;不味い
			IF TFLAG:193 == -1
				;4～5時(寝起きと仮定)
				IF TIME:0 >= 240 && TIME:0 <= 300
					PRINTFORMW 「...우윽... 그, 눈이 떠졌어요...」
					;◆
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「음~ 이거 그럼 그냥 색깔만 있는 뜨거운 물이네요」
					ELSE
						PRINTFORMW 「……독특한 맛이네」
					ENDIF
				ENDIF
				;美味しい
			ELSEIF TFLAG:193 == 1
				;4～5時(寝起きと仮定)
				IF TIME:0 >= 240 && TIME:0 <= 300
					PRINTFORML 「잠에서 깨자마자 정말 맛있는 차를 마시다니... 이것 또한 하나의 행복이다」
					PRINTFORMW 「고마워, %CALLNAME:MASTER%」
				ELSEIF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51)
					PRINTFORML 「아아. 맛있다, %CALLNAME:MASTER%」
					PRINTFORMW 「왠지 기운이 나네요. 남은 것도 열심히 해야겠어요」
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「아아…… 이 차잎, 이렇게 맛있게 우려낼 수 있는 거였네요」
					ELSE
						PRINTFORMW 「정말로 맛있다」
						PRINTFORMW 「손님께 내어드릴 때도, %조사처리(CALLNAME:MASTER,"에게")% 맡기고 싶을 정도이다」
					ENDIF
				ENDIF
				;普通
			ELSE
				;4～5時(寝起きと仮定)
				IF TIME:0 >= 240 && TIME:0 <= 300
					PRINTFORML 「음... 잠을 깨우는 한 잔이라는 것도 좋네요」
					;縁側で、夜(19～4時)で、満月
				ELSEIF CFLAG:現在位置 == 10 && TIME:2 == 3 && DAY:4 == 15
					PRINTFORML 「아아…… 감사합니다, %CALLNAME:MASTER%. 모처럼 그러니까, 같이 하시겠어요?」
					PRINTFORMW 기분이 좋아진 뱌쿠렌은 자신의 옆자리를 톡톡 두드렸다…
					;食事を取るまたは食事をふるまう の直後
				ELSEIF PREVCOM == 414 || PREVCOM == 415
					PRINTFORML 「식후의 차인가요? 감사합니다」
					PRINTFORMW 「음…… 맛있어. 정말, 고마운 사람이네」
				ELSEIF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
					IF RAND:2 ==0
						PRINTFORMW 「고마워요, %CALLNAME:MASTER%. 지금 손이 떨어지지 않았으니까 딱 좋네요」
					ELSE
						PRINTFORMW 「응…… 좀 숨 돌렸네. 고마워, %CALLNAME:MASTER%」
					ENDIF
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「맛있었어. 잘 먹었습니다, %CALLNAME:MASTER%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「아, 감사합니다」
					ELSE
						PRINTFORMW 「응... 후후, 잘 먹었다」
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
