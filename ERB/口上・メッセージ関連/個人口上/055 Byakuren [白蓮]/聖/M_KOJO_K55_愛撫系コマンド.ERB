@M_KOJO_MESSAGE_COM_K55_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:イタズラ && CFLAG:睡眠
		;「%CALLNAME:PLAYER%は眠っている%CALLNAME:TARGET%の胸を服の上から
		IF ABL:Ｂ感覚 <= 1
			;撫でるように揉みしだいた…　%CALLNAME:TARGET%はくすぐったそうに身をよじった…」
			IF RAND:2 == 0
				PRINTFORMW 뱌쿠렌의 풍만한 가슴이 살짝 형태를 바꾸며, 물컹하게 밀려왔다….
			ELSE
				PRINTFORMW 「응... 으응」
			ENDIF
		ELSEIF ABL:Ｂ感覚 <= 3
			;優しく揉みしだいた…　%CALLNAME:TARGET%は愛撫に熱い吐息を漏らし始めている…」
			IF RAND:2 == 0
				PRINTFORMW 「후우……」
			ELSE
				PRINTFORMW 「응... 후...」
			ENDIF
		ELSE
			;じっくりと揉みしだいた…　%CALLNAME:TARGET%は頬を上気させ%CALLNAME:MASTER%のされるがままになっている…」
			IF RAND:2 == 0
				PRINTFORMW 「흐읍... 하아... 아앗」
			ELSE
				PRINTFORML 「응읏……헉… 응읏…」
				PRINTFORMW 가슴의 끝에 손을 대고 손끝으로 만지자, 막히는 듯한 신음 소리가 들려왔다.
			ENDIF
		ENDIF
		RETURN 1
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;初めて
		;記入チェック
		LOCAL:1 = 1
		;-------------------------------------------------
	ELSEIF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「……앗! 가슴이요……」
		PRINTFORMW 당신의 손이 풍만하게 부푼 가슴에 닿자, 뱌쿠렌은 작게 몸을 떨었다...
		RETURN 1
		;-------------------------------------------------
		;挿入中
		;記入チェック
		LOCAL:1 = 1
		;-------------------------------------------------
		;V挿入
	ELSEIF TEQUIP:50 == PLAYER
		;MASTERが射精した
		IF NOWEX:PLAYER:11
			PRINTFORML 뱌쿠렌의 풍만한 가슴에 손가락을 박아 넣고, 질내 사정의 쾌락에 몸을 떨었다...
			IF RAND:3 == 0
				PRINTFORMW 「하, 하으, 하, 하아……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아, 아우, 후응, 하아, 윽, 아우……」
			ELSE
				PRINTFORMW 「아아앗… 당신의 게, 응응, 안에서……」
			ENDIF
			RETURN 1
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「안돼앳, 지금 만지는 건, 아우윽」
				PRINTFORMW 「너무 기분 좋아져 버릴 것 같아앗……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「...지금 유두를 만지는 건 안 돼... 에, 가버릴 것 같아...!」
			ELSE
				PRINTFORMW 「흐으, 넣은 채로 가슴 만지면…… 아앗%UNICODE(0x2665)%」
			ENDIF
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORML 뱌쿠렌의 풍만한 가슴에 손가락을 깊숙이 넣고, 장내 사정의 쾌락에 몸을 떨었다...
			IF RAND:3 == 0
				PRINTFORMW 「하, 하으, 하, 하아……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아, 아우, 후응, 하아, 윽, 아우……」
			ELSE
				PRINTFORMW 「아앗…… 당신이 가진 거, 으응, 엉덩이 속에서…… 엣」
			ENDIF
			RETURN 1
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「안돼앳, 지금 만지는 건, 아우윽」
				PRINTFORMW 「너무 기분 좋아져 버릴 것 같아앗……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「...지금 유두를 만지는 건 안 돼... 에, 가버릴 것 같아...!」
			ELSE
				PRINTFORMW 「흐으, 넣은 채로 가슴 만지면…… 아앗%UNICODE(0x2665)%」
			ENDIF
			RETURN 1
		ENDIF
		;基本セット
		;恋慕
	ELSEIF TALENT:恋慕
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:6 == 0  && ABL:Ｂ感覚 >= 5
				PRINTFORML 「하아, 응! 후우…… 가슴, 아앗…… 좋아요...!」
				PRINTFORMW 완전히 발현된 가슴을 농락당하자, 뱌쿠렌은 몸을 파르르 떨며 허리를 흔들었다...
			ELSEIF RAND:5 == 0 && ABL:Ｂ感覚 >= 3
				PRINTFORML 「하아앗%UNICODE(0x2665)% 하아앗%UNICODE(0x2665)% 하아앗…%UNICODE(0x2665)% 아우…」
				PRINTFORMW 가슴에 대한 애무에서 해방된 뱌쿠렌의 유방은 홍조를 띠며 상기했고, 그 끝은 꼿꼿하게 솟아 있었다.
			ELSEIF RAND:5 == 0 && ABL:Ｂ感覚 >= 3
				PRINTFORML 「아하, %CALLNAME:MASTER%한테, 마음대로 당하고 있어요……」
				PRINTFORMW 당신의 애무를 받으며 변형되는 가슴을, 뱌쿠렌은 욕정에 녹은 눈으로 바라보고 있다…
			ELSEIF RAND:5 == 0
				PRINTFORML 「하아, 하아…… 응, 가슴뿐만이 아니라……%UNICODE(0x2665)%」
				PRINTFORMW 발정 난 뱌쿠렌은 아첨하는 듯한 시선을 당신에게 보내고 있다…
			ELSEIF RAND:4 == 0
				PRINTFORMW 「후아앗……%UNICODE(0x2665)% 당신의 손, 따뜻해……%UNICODE(0x2665)%」
				;上半身裸
				IF TEQUIP:1 == 0
					PRINTFORMW 부드러운 유방은 당신의 손바닥에 빨려 들어가듯 감긴다.
				ELSE
					PRINTFORMW 뱌쿠렌의 풍만한 가슴은 옷 아래에서 부드럽게 일그러지며, 음란한 옷깃 스치는 소리를 조용히 울렸다…
				ENDIF
			ELSEIF RAND:3 == 0
				PRINTFORML 촉촉하게 땀을 머금은 뱌쿠렌의 가슴은, 당신의 손가락에 따라 말랑말랑한 형태로 변해간다…
				PRINTFORMW 「아, 하…… %CALLNAME:MASTER%님의 손길, 기분 좋아요\@ ABL:Ｂ感覚 >= 3 ? …%UNICODE(0x2665)% # … \@」 
			ELSEIF RAND:2 == 0
				PRINTFORML 「윽, 야아, 응응읏... 가슴이... 아아%UNICODE(0x2665)%」
				PRINTFORMW 완전히 익숙해진 당신의 손이 유두를 살과 함께 짓누르려 하고 있다...
			ELSE
				PRINTFORMW 「하아, 응윽... 응아, 앗...」
			ENDIF
		ELSEIF ABL:Ｂ感覚 >= 3
			IF RAND:5 == 0 && ABL:Ｂ感覚 >= 5
				PRINTFORML 「벌써 당신한테 계속 농락당하다 보니, 완전히 예민해져 버렸어요... %UNICODE(0x2665)%」
				PRINTFORMW 「자, 유두도 좀 더, 만져 주세요... %UNICODE(0x2665)%」
			ELSEIF RAND:4 == 0 && ABL:Ｂ感覚 >= 5
				PRINTFORMW 「응응... %조사처리(CALLNAME:MASTER,"에게")% 만져지면, 하으읏%UNICODE(0x2665)%응후... 터질 것 같아요...%UNICODE(0x2665)%」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「후아앗……%UNICODE(0x2665)% 당신의 손, 따뜻해……%UNICODE(0x2665)%」
			ELSEIF RAND:2 == 0
				PRINTFORML 「후후……%UNICODE(0x2665)% %조사처리(CALLNAME:MASTER,"는")%, 아응, 가슴 좋아하시는군요…%UNICODE(0x2665)%」
				PRINTFORMW 뱌쿠렌은 마음이 가는 대로 애무하는 당신의 머리를 부드럽게 쓰다듬고 있다.
			ELSE
				PRINTFORML 「야, 아…… 유두를 그렇게 만지면 안 돼, 아앗...! 응읏, 후우, 아앗!」
				PRINTFORMW 유두를 주무르자, 뱌쿠렌은 참지 못하고 교성(嬌聲)을 터뜨렸다…
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「후앗... 당신의 손이 따뜻해...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아, 하…… 괜찮아요…… 많이 만져줘……」
			ELSE
				PRINTFORMW 「응우…… 어때요, 저의 가슴……」
			ENDIF
		ENDIF
		;恋慕なし
	ELSE
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:6 == 0  && ABL:Ｂ感覚 >= 5
				PRINTFORML 「하아, 응! 후우…… 가슴, 아앗…… 좋아요...!」
				PRINTFORMW 완전히 발현된 가슴을 농락당하자, 뱌쿠렌은 몸을 파르르 떨며 허리를 흔들었다...
			ELSEIF RAND:5 == 0 && ABL:Ｂ感覚 >= 3
				PRINTFORML 「하아앗%UNICODE(0x2665)% 하아앗%UNICODE(0x2665)% 하아앗…%UNICODE(0x2665)% 아우…」
				PRINTFORMW 가슴에 대한 애무에서 해방된 뱌쿠렌의 유방은 홍조를 띠며 상기했고, 그 끝은 꼿꼿하게 솟아 있었다.
			ELSEIF RAND:5 == 0 && ABL:Ｂ感覚 >= 3
				PRINTFORML 「야아... 안 돼, 안 되는데…… 읏%UNICODE(0x2665)%」
				PRINTFORMW 당신의 애무를 받으며, 뱌쿠렌은 때때로 달콤한 신음을 흘리고 있다.
			ELSEIF RAND:5 == 0
				PRINTFORML 「하아, 하아…… 아으, 야앗…」
				PRINTFORMW 발정난 뱌쿠렌은 거친 숨을 몰아쉬며 가슴에 대한 애무를 만끽하고 있다…
			ELSEIF RAND:4 == 0
				PRINTFORM 「후아앗...」
				IF MARK:不埒刻印 == 3
					PRINTFORMW %CALLNAME:MASTER%손, 좋아...
				ELSE
					PRINTFORMW 안대앳, 안댸요으…읏」
				ENDIF
			ELSEIF RAND:3 == 0
				PRINTFORML 촉촉한 땀을 머금은 뱌쿠렌의 가슴은, 당신의 손가락에 따라 말랑말랑하게 형태를 바꾼다…
				PRINTFORMW 「아, 응… %조사처리(CALLNAME:MASTER,"의")% 손이, 꽉\@ ABL:Ｂ感覚 >= 3 ? …%UNICODE(0x2665)% # … \@」 
			ELSEIF RAND:2 == 0
				PRINTFORML 「윽, 야아, 응응흡... 가슴이... 아앗」
				PRINTFORMW 완전히 익숙해진 당신의 손이 유두를 살과 함께 짓누르려 하고 있다…
			ELSE
				PRINTFORMW 「하아, 응윽... 응아, 앗...」
			ENDIF
		ELSEIF MARK:不埒刻印 == 3
			IF RAND:3 == 0
				PRINTFORMW 「후앗... 당신의 손이 따뜻해...」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아, 하…… 괜찮아요…… 많이 만져줘……」
			ELSE
				PRINTFORMW 「응우…… 어때요, 저의 가슴……」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응…… 크으윽……읏」
			ELSEIF RAND:2 == 0
				PRINTFORMW 뱌쿠렌은 당신의 손바닥에서 말랑말랑하게 모양을 바꾸는 가슴 살에서 눈을 돌리고 있다.
			ELSE
				PRINTFORMW 「응아, 우으…… 안돼요읏」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
