@M_KOJO_MESSAGE_COM_K55_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;欲情3以上　※で、地の文にクリトリス吸い上げが入る
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:3 == 0
				PRINTFORML 「흐으… 읏……%UNICODE(0x2665)%」
				PRINTFORMW 잠들어 있는 뱌쿠렌의 음핵은 팽팽하게 긴장하며 쾌감을 만끽하고 있다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「하아... 아아...!」
			ELSE
				PRINTFORMW 「흐읍... 으응%UNICODE(0x2665)%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「하아…… 아, 후우……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응... 응으윽...」
			ELSE
				PRINTFORMW 「하후...음...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「...앗... 안돼요. 으응, 보지 말아주세요...」
		PRINTFORMW 「윽...! 핥아버릴... 거예요... 히으... 안돼요, 안 돼요...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;/汚れ無視ってどうやって取るんだろう
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:112 == 1
			PRINTFORML 방금 쏟아부은 정액이 뱌쿠렌의 애액과 섞여, 질구에서 흘러넘치고 있다……
			IF TALENT:恋人
				IF RAND:3 == 0 && ABL:精液中毒 >= 3
					PRINTFORML 「와, 아…… 이렇게나 많이, 내준 거야……」
					PRINTFORMW 뱌쿠렌은 황홀한 눈으로 흘러넘치는 정액을 바라보고 있다……
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후후, 나랑 당신 거 섞이니까…… 굉장한 냄새가 날 거예요……」
				ELSE
					PRINTFORMW 「아아…… 엄청나게 야하네요……」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「에, 그런 거…… 아, 앗……」
					PRINTFORMW 뱌쿠렌은 숨을 들이마시며 음란한 광경을 지켜보고 있다.
				ELSE
					PRINTFORMW 「히익…… 아, 핥고 있는 거야...?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;欲情3以上　※で、地の文にクリトリス吸い上げが入る
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:3 == 0
				PRINTFORML 「하아앗, 아아! 자……거기 빨아줘… %UNICODE(0x2665)%」
				PRINTFORMW 볼록하게 부풀어 오른 뱌쿠렌의 음핵에 열렬한 구강 서비스를 이어갔다.
				PRINTFORMW 「아아, 우아앗, 갈 것 같아, 가버릴 것 같아아아 %UNICODE(0x2665)%!!」
			ELSEIF RAND:2 == 0
				PRINTFORML 「히아아앗, 그, 거긴 민감해서윽…… 아, 아우우욱%UNICODE(0x2665)%!」
				PRINTFORMW 붉게 부풀어 오른 클리토리스를 입술로 감싸 빨아들이자, 뱌쿠렌의 몸이 파르르 떨렸다…
			ELSE
				PRINTFORML 「아, 아앗…… 안돼, 거긴, 갈 것 같아……%UNICODE(0x2665)%」
				PRINTFORMW 당신이 클리토리스를 혀로 간지럽히자, 뱌쿠렌은 강렬한 쾌락에 몸부림쳤다…
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「아, 으윽... 안돼, ...안될 것 같아앗…… %UNICODE(0x2665)%」
			ELSE
				PRINTFORML 「……~~앗!」
				PRINTFORMW 포피에 가려진 음핵을 집요하게 혀로 괴롭힘 당하며, 뱌쿠렌은 몸을 파르르 떨었다…
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;欲情3以上
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:5 == 0
				PRINTFORML 뱌쿠렌의 성기에 허겁지겁 입을 대고 애액을 핥았다...
				PRINTFORMW 「아후...응……%UNICODE(0x2665)% 벌써, 그렇게 음란한 소리를 내다니...」
			ELSEIF RAND:4 == 0
				PRINTFORML 「아우으윽...%UNICODE(0x2665)%... 그럴, 직설적으로...읏!」
				PRINTFORMW 포피에서 얼굴을 내민 뱌쿠렌의 음핵을 입술로 물고 혀끝으로 자극했다...
			ELSEIF RAND:3 == 0
				PRINTFORML 「아하읏... %UNICODE(0x2665)%... 그렇게 핥아주는 네가, 사랑스럽다... %UNICODE(0x2665)%」
				PRINTFORMW 「내가 기분 좋게, 해주고 있는 거지...? 후후, 기뻐... %UNICODE(0x2665)%」 
			ELSEIF RAND:2 == 0
				PRINTFORML 「하앗%UNICODE(0x2665)%……그렇게 핥아지니…… 그, 원하게 돼버려요……%UNICODE(0x2665)%」
				PRINTFORMW 질 입구를 부드럽게 핥아 올리자, 뱌쿠렌은 애처롭게 몸을 비틀었다…
			ELSE
				PRINTFORML 「응응, 거기, 츄읍하고 빨리면…… 아아앗!」
				PRINTFORMW 클리토리스를 강하게 빨려 올리자, 뱌쿠렌은 몸을 파르르 떨었다…
			ENDIF
		ELSE
			IF RAND:5 == 0
				PRINTFORML 「쿠……응……하아앙……」
				PRINTFORMW 혀가 뱌쿠렌을 쓸 때마다, 뱌쿠렌은 작게 신음 소리를 낸다.
				IF PALAM:潤滑 >= PALAMLV:2
					PRINTFORML 「있잖아…… 벌써, 준비는 되어 있다구……?」
					PRINTFORMW 도발하듯 다리를 벌린 뱌쿠렌의 질 입구는 꿀과 타액으로 축축하게 빛나고 있었다…
				ENDIF
			ELSEIF RAND:4 == 0
				PRINTFORMW 「하아... 혀가... 스치네...」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「으윽… 그, 그래… 더, 핥아줘…」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아하, 후우읏…응… %CALLNAME:MASTER%…%UNICODE(0x2665)%」
			ELSE
				PRINTFORMW 「앗 아, 하, 기분 좋아읏……」
			ENDIF
		ENDIF
		RETURN 1
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:5 == 0
			PRINTFORMW 「아, 응…… 벌써. 그렇게 야한 소리를 내고 있어서……」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「응, 아하…… 더, 핥아도 괜찮아요……」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「아앗..., %조사처리(CALLNAME:MASTER,"의")% 혀, 좋아요...읏%UNICODE(0x2665)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「그렇게 핥짝거리고……응읏%UNICODE(0x2665)%… 즐거운 거예요?」
		ELSE
			PRINTFORML 「힉... 크윽...」
			PRINTFORMW 혀가 비핵에 닿을 때마다, 뱌쿠렌의 몸이 파르르 떨린다...
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:5 == 0
			PRINTFORMW 「안돼, 그런 곳을 핥으면 안 돼... 읏, 안 돼……」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「야, 아…… 그런 소리 내면 안 돼요……」
		ELSEIF RAND:3 == 0
			PRINTFORML 「크으……응, 핫, 아……」
			PRINTFORMW 뱌쿠렌은 웅얼거리는 신음소리를 내고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흐아앗…… 안돼, 안 돼 %CALLNAME:MASTER%…… 아앗」
		ELSE
			PRINTFORML 「힉... 크윽...」
			PRINTFORMW 혀가 비핵에 닿을 때마다, 뱌쿠렌의 몸이 파르르 떨린다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
