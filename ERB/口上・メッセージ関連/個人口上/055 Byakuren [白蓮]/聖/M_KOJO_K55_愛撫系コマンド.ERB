@M_KOJO_MESSAGE_COM_K55_0
CALL M_KOJO_MESSAGE_COM_K55_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K55_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激なイタズラ中
	IF CFLAG:イタズラ && CFLAG:睡眠
		;欲情3以上
		IF PALAM:欲情 >= PALAMLV:3
			IF RAND:3 == 0
				PRINTFORMW 「후우…… 으음쪽… %UNICODE(0x2665)%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「아…… 하아……읏...!」
			ELSE
				PRINTFORMW 「……읏, 응으읏…%UNICODE(0x2665)%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「응…… 후우…」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「응... 응......」
			ELSE
				PRINTFORMW 「흐응...」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;※うふふ == 2のことも考えるとこのあたりのFIRSTTIMEは難しい
	;↑ほら、相手に押し倒されたときはまた別な心境になるじゃん？
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 뱌쿠렌의 풍만한 몸에 손가락을 미끄러뜨리며, 마음대로 가지고 놀았다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;※どっちかに挿入、もう片方にバイブの状態で自慰や愛撫は四重絶頂狙いでよくやると思われる。留意しておきたい
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF RAND:3 == 0
				PRINTFORMW 「앗…… 갈 것 같아, 가... 가버려 읏, 아아, 나와줘... 안에 사정해 줘엣...!」
				PRINTFORMW 「아, %조사처리(CALLNAME:MASTER,"에게")%... 사정당하면서... 갈 거야아... 윽!!」
				PRINTFORMW 간절한 애원의 외침과 함께 조여오는 질 내부에, %조사처리(CALLNAME:MASTER,"는")% 억누르고 있던 욕망의 응어리를 단숨에 터뜨렸다.
				PRINTFORMW 「――아, 하, 하아앗, 나와... 잔뜩... ♪」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「히야아아앙! 아, 아아…… 하아아아～～～응!」
				PRINTFORMW 뒤집힌 희열의 비명을 울리며, 뱌쿠렌은 맞은 듯한 짐승처럼 흰 등을 크게 휘었다.
				PRINTFORMW 영원할 것 같은 쾌감 끝에 꽃이 시들듯 탈력하여 쓰러지려던 그녀의 몸을, %조사처리(CALLNAME:MASTER,"는")% 단단히 붙잡았다.
				PRINTFORML 「――엣!? 하, 아아아앗!!」
			ELSE
				PRINTFORML 주기적으로 조여오는 뱌쿠렌의 은밀한 곳에, %조사처리(CALLNAME:MASTER,"는")% 더 이상 참을 수 없게 되어 버렸다.
				PRINTFORML 「하, 네엣……♪ 응아앗……응, 원하는 만큼……읏, 질 안에, 기분 좋게, 사정해 주세요♪」
				PRINTFORML 「하아, 하아……앙…… 좋아, 좋아요……♪」
				PRINTFORML 「당신의……응 아앗……모든 것을, 받아들이고 싶어요……♪」
				PRINTFORMW 그리고 마지막 일격이라도 되는 듯한 강한 조임에 마침내 절정에 도달한다.
				PRINTFORMW 「갈 것 같아……읏, ……갈 것 같아요어♪♪」
			ENDIF
			PRINTFORMW 사정의 쾌감에 몸을 맡기며, 풍만한 육체를 어루만졌다...
			RETURN 1
			;これで絶頂する
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			IF RAND:2 == 0
				PRINTFORMW 뱌쿠렌의 귓불을 입술로 감싸고 가볍게 숨을 불어넣거나 귀구멍을 핥으며 전신에 손가락을 더듬는다.
				PRINTFORMW 연결된 채 애무당한 뱌쿠렌은 부르르 몸을 떨며 절정에 달했다.
			ELSE
				PRINTFORMW 삽입을 계속하며 하복부를 부드럽게 쓸어 올리자, 뱌쿠렌은 유난히 큰 신음을 내며 허리를 크게 들썩였다.
				PRINTFORMW 미끄러지는 질벽의 강렬한 조임과, 한 몸이 빠져나갈 듯 격렬한 허리 움직임에 견디면서, %조사처리(CALLNAME:MASTER,"는")% 뱌쿠렌을 세게 끌어안았다.
			ENDIF
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「히으……! 그, 그런 다정한 건…… 하앗, 아아!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「흐윽, 아앗! 안돼요…… 이상해지, 어떡해……」
			ELSE
				PRINTFORMW 「우아, ……앗…… %CALLNAME:MASTER%, 키스해줘……. 응, 츄응!」
			ENDIF
			RETURN 1
		ENDIF
		;A挿入
		;即使いまわすテヌキ＝スタイルだぁ！
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			IF RAND:3 == 0
				PRINTFORML 「흐, 아아, 응, 흣……」
			ELSEIF RAND:2 == 0
				PRINTFORML 「아, 우와…… 당신 거, 움찔움찔하고 있어……」
			ELSE
				PRINTFORML 「흐으읏, 응응, 아앗, 아아…… 나와버릴 것 같아……」
			ENDIF
			PRINTFORMW 사정의 쾌감에 몸을 맡기며, 풍만한 육체를 어루만졌다...
			RETURN 1
			;これで絶頂する
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
