; Modular ERB: 個人口上/055 Byakuren [白蓮]/聖/M_KOJO_K55_絶頂.ERB
;-------------------------------------------------
;奴隷の絶頂時の口上
;NOWEX:0～4 CVABM絶頂
;NOWEX:6 二重絶頂
;NOWEX:7 三重絶頂
;NOWEX:8 四重絶頂
;NOWEX:9 五重絶頂
;NOWEX:10 噴乳
;NOWEX:11 射精
;NOWEX:12 放尿
;適当に組み合わせて使ってください
;-------------------------------------------------

@M_KOJO_MESSAGE_PALAMCNG_B_K55
;元の口上では各分岐ごとにCFLAG:1502~1505を加算していたが、煩わしいので最初にまとめてやる
SIF NOWEX:Ｃ絶頂
	CFLAG:1502 ++
SIF NOWEX:Ｖ絶頂
	CFLAG:1503 ++
SIF NOWEX:Ｂ絶頂
	CFLAG:1504 ++
SIF NOWEX:Ａ絶頂
	CFLAG:1505 ++
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	IF FLAG:70
		PRINTFORMW 얼어붙은 시간 속에서 뱌쿠렌은 절정에 달했다.
	ELSE
		SELECTCASE EXP:TARGET:噴乳経験
			CASE IS < 500
				PRINTFORMW 「흐응?! 아…… 응응…, 그렇게…… 유두만…… 앗!」
				PRINTFORMW 「헉…… 가슴… 나와버렸어요…%UNICODE(0x2665) *1%」
				PRINTFORMW 뱌쿠렌의 얼굴은 수치심으로 그 어느 때보다 새빨갛게 물들어 있다.
			CASEELSE
				IF !TEQUIP:1 == 0
					PRINTFORMW 「히얏!?……앗……응응옷……」
					PRINTFORMW 갑자기 뱌쿠렌은 얼굴을 새빨갛게 물들이고 고개를 숙였다.
					PRINTFORMW 평정을 가장하고는 있지만, 가슴에서 달콤한 우유 향이 풍기는 것을 %조사처리(CALLNAME:MASTER,"는")% 놓치지 않았다.
				ELSE
					PRINTFORMW 「하아앗…%UNICODE(0x2665)% 하아앗…%UNICODE(0x2665)%…… 안돼… 꼴 좋아……. 그만할 수 없어…%UNICODE(0x2665)%%UNICODE(0x2665)%」
					PRINTFORMW 가슴에서의 절정이 멈추지 않는 듯, 뱌쿠렌은 자신의 가슴을 들어 스스로의 젖꼭지에 물었다.
					PRINTFORMW %CALLNAME:MASTER%도 한쪽 젖꼭지에 물어, 뱌쿠렌의 가슴에서 솟아나는 우유를 맛보았다……
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
;-------------------------------------------------
;射精
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;五重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:五重絶頂
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 뱌쿠렌은 절정에 달했다.
		ELSE
			;イきまくってから
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아아아아아아아앗!!! 아앗, 아가앗, 앗%UNICODE(0x2665)% 하아앗%UNICODE(0x2665)% 으윽…%UNICODE(0x2665)%」
					PRINTFORML 전신을 덮치는 달콤한 쾌락에 농락당하며, 뱌쿠렌은 더 이상 의미 있는 말을 내뱉는 것조차 불가능했다.
					PRINTFORMW 거칠고 빠른 호흡이 새하얗고 가느다란 목구멍을 떨리는 소리만을 울리고 있었다…
				CASE 1
					PRINTFORML 「갈 것 같아……%UNICODE(0x2665)%……~~앗, 윽!? 아아, 또…… 크윽 %UNICODE(0x2665)% 그, 그…!~~~~~%UNICODE(0x2665)%%UNICODE(0x2665)%%UNICODE(0x2665)%」
					PRINTFORMW 뱌쿠렌의 아름다운 몸이 휘둘러지듯 뒤틀리더니, 다음 순간에는 움츠러들며 끊임없이 경련하고 있다.
				CASE 2
					PRINTFORML 「~~~~읏%UNICODE(0x2665)%간다!!%UNICODE(0x2665)%갈게 갈게 갈게읏%UNICODE(0x2665)%아앗%UNICODE(0x2665)%간다, 간다읏%UNICODE(0x2665)%」
					PRINTFORML 질에 가해지는 끊임없는 자극으로 음핵이 충혈되고 절정감에 허리를 구부리자 항문이 넓게 벌어지며 풍만한 가슴이 탄띠를 흔든다.
					PRINTFORMW 하나의 절정이 또 다른 절정을 불러일으키고, 뱌쿠렌은 아직 법열의 세계에서 내려오지 못한 듯하다...
			ENDSELECT
			PRINTFORML
			;落ち着く
			;この後に射精口上が来ることを考えると、この落ち着くパートはいらない可能性が…？
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 뱌쿠렌은 희미하게 붉어진 상기된 손바닥으로 얼굴을 가리고, 식은땀이 난 몸을 파르르 떨고 있다…
					PRINTFORMW 「아, 아아…… 이럴 수가, 이런 ……」
					PRINTFORML
					PRINTFORMW 「이런 여자의 행복을 가르쳐 버렸다면…… 이제 당신 없이는 살 수 없어……. 생%UNICODE(0x2665)%」
				CASE 1
					PRINTFORML 「아앗... 하앗...%UNICODE(0x2665)%%CALLNAME:MASTER%...%UNICODE(0x2665)%%CALLNAME:MASTER%...%UNICODE(0x2665)%」
					PRINTFORML 평소라면 자애로운 미소를 지으며 중생에게 진리를 설파하고 있어야 할 입매가, %조사처리(CALLNAME:MASTER,"가")% 주는 쾌락으로 흐트러지게 일그러져 있다.
					PRINTFORMW 입술 끝에서 흘러내리는 침을 닦을 힘도 없이 \@ !OUTROOF(CFLAG:MASTER:現在位置) ? 다섯 몸을 내던진 # 땅에 부서진 \@뱌쿠렌은, 그러나 행복한 듯한 숨을 내쉬고 있었다...
				CASE 2
					PRINTFORML 「하아, 하아앗… 하앗…%UNICODE(0x2665)%응으윽… %CALLNAME:MASTER%……%UNICODE(0x2665)%」
					PRINTFORMW 축 늘어진 채 힘을 빼고 호흡을 가다듬는 뱌쿠렌은, 마치 무언가 떠오른 듯 당신의 이름을 부르며 감탄에 찬 눈으로 바라본다.
					PRINTFORML
					PRINTFORML 괜찮은지 목소리를 걸려고 얼굴을 가까이 가져가자, 그녀의 따뜻한 손이 뻗어 나와 뺨을 붙잡았고, 열렬한 키스로 입을 막아버렸다...
					PRINTFORML 「…아%UNICODE(0x2665)%응윽…%UNICODE(0x2665)%츄, 츄읏%UNICODE(0x2665)%류우%UNICODE(0x2665)%츄루%UNICODE(0x2665)%츄루츄쿠…%UNICODE(0x2665)%류푸, 르럴렐레…%UNICODE(0x2665)%푸앙%UNICODE(0x2665)%응ー읏%UNICODE(0x2665)%
					PRINTFORMW 　츄욱…츄루뉴…%UNICODE(0x2665)%…좋아…%UNICODE(0x2665)%츄우읏…%UNICODE(0x2665)%르럴렐, 츄읏…%UNICODE(0x2665)%츄%UNICODE(0x2665)%츄%UNICODE(0x2665)%류츄%UNICODE(0x2665)%」
			ENDSELECT
		ENDIF
	ENDIF
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:四重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 뱌쿠렌은 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORML 「%CALLNAME:MASTER%…… 꽉 잡아줘……!」
			PRINTFORML 　아, 아, 아앙! 또, 또 와버릴 것 같아... 으응!!」
			PRINTFORMW 절정에 이른 시라하네는 힘없이 축 늘어졌다.
		ELSEIF RAND:4 == 0
			PRINTFORML 「츄, 츄파앗, 응으윽!」
			PRINTFORML 키스를 하면서 충분히 흥건하게 젖은 뱌쿠렌의 은밀한 곳을 만지고, 민감한 부분도 똑같이 건드린다.
			PRINTFORML 「후우욱, 라메, %CALLNAME:MASTER%……윽, 거긴, 여기는 하아, 라메, 라메에읏」
			PRINTFORMW 　또, 또 가버릴 것 같아!!
			PRINTFORMW 　응으, 응으으으―――읏♪
		ELSEIF RAND:3 == 0
			PRINTFORMW 「기, 기분 좋아서…… 와버릴 것 같아! 또 굉장한 게 나올 것 같아…앗!」
			PRINTFORMW 「아앗, 앗! 음───! 아아앗───!!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아앗, 굉장해! 한꺼번에 와버릴 것 같아...읏!」
			PRINTFORMW 「이제 안 돼! 벌써…… 아앗, 아앗! 으아아악!!」
		ELSE
			PRINTFORMW 「힉읏!? 안 돼, 전부 민감해져 버렸어…… 응응~~!!」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;三重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF NOWEX:三重絶頂
		IF FLAG:70
			PRINTFORMW 얼어붙은 시간 속에서 뱌쿠렌은 절정에 달했다.
		ELSEIF RAND:5 == 0
			PRINTFORML 「안…돼, 으윽… 안 돼,요…읏%UNICODE(0x2665)% 갈 것 같아…%UNICODE(0x2665)%」
			PRINTFORMW 「우앗…!? 그,런, 한 번에, 야아아악%UNICODE(0x2665)%%UNICODE(0x2665)%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「!?…크윽, 거기, 지금, 건드려버렸어……아아아앗%UNICODE(0x2665)%%UNICODE(0x2665)%」
			PRINTFORMW 「흐읍, 으윽, 가, 가, 아, 흐으윽%UNICODE(0x2665)%」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「응읏... 크으윽... %UNICODE(0x2665)% 아우욱... %UNICODE(0x2665)%」
			PRINTFORMW 「하... 앗, 싫어, 갈 것 같아, 갈 것 같아... %UNICODE(0x2665)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「~~앗!? 안, 안 돼, 전부, 전부 와버릴 것 같아……%UNICODE(0x2665)%%UNICODE(0x2665)%」
		ELSE
			PRINTFORMW 「하, 하, 안, 안 돼엣, 속도, 전부 와버릴 것 같아…… 아…… 아, 아아아아아~~%UNICODE(0x2665)%」
		ENDIF
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
	ENDIF
	;-------------------------------------------------
	;二重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF NOWEX:二重絶頂
		;部位を指定せず簡易的に書く場合、[SKIPSTART]&[SKIPEND]のコメントアウトを外して、[SKIPSTART]とこのコメントの間に書いてください
		;[SKIPSTART]
		SELECTCASE NOWEX:二重絶頂
			;Ｃ＆Ｖ絶頂
			CASE 1
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ａ絶頂
			CASE 2
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ａ絶頂
			CASE 3
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｂ絶頂
			CASE 4
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ｂ絶頂
			CASE 5
				PRINTFORMW 
				RETURN 1
				;Ａ＆Ｂ絶頂
			CASE 6
				PRINTFORMW 
				RETURN 1
				;Ａ＆Ｍ絶頂
			CASE 7
				PRINTFORMW 
				RETURN 1
				;Ｖ＆Ｍ絶頂
			CASE 8
				PRINTFORMW 
				RETURN 1
				;Ｃ＆Ｍ絶頂
			CASE 9
				PRINTFORMW 
				RETURN 1
				;Ｂ＆Ｍ絶頂
			CASE 10
				PRINTFORMW 
				RETURN 1
		ENDSELECT
		;[SKIPEND]
	ENDIF
	IF NOWEX:Ｃ絶頂 && (!NOWEX:二重絶頂 && !NOWEX:三重絶頂 && !NOWEX:四重絶頂 && !NOWEX:五重絶頂)
		;超強絶頂Ｃ
		IF NOWEX:Ｃ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｃ
		ELSEIF NOWEX:Ｃ絶頂 == 2
			PRINTFORMW 
			;絶頂Ｃ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	IF NOWEX:Ｖ絶頂 && (!NOWEX:二重絶頂 && !NOWEX:三重絶頂 && !NOWEX:四重絶頂 && !NOWEX:五重絶頂)
		;超強絶頂Ｖ
		IF NOWEX:Ｖ絶頂 == 3
			PRINTFORML 「좋아, 좋아, %CALLNAME:MASTER%읏, 정말 좋아해욧!」
			PRINTFORML 허리를 흔들며, %CALLNAME:MASTER%도 뱌쿠렌에게 사랑의 말을 되돌려준다.
			PRINTFORMW 「하아앙! 쪽, 쪽빠, 정말 좋아해용, %CALLNAME:MASTER%읏!!」
			;強絶頂Ｖ
		ELSEIF NOWEX:Ｖ絶頂 == 2
			PRINTFORML 「아, 아아아앗! 안쪽까지, 거시기, 와버렸어……읏」
			PRINTFORMW 「더, 더 범해줘, %CALLNAME:MASTER%옷♪♪」
			;絶頂Ｖ
		ELSE
			PRINTFORML 「하아, 하아아앙! 좋아, %CALLNAME:MASTER%한테 범해지고, 느껴져서, 느끼고 있잖아앗♪」
			PRINTFORMW 「아, 아아아, 이제, 안 돼, 안돼읏♪」
		ENDIF
	ENDIF
	IF NOWEX:Ａ絶頂 && (!NOWEX:二重絶頂 && !NOWEX:三重絶頂 && !NOWEX:四重絶頂 && !NOWEX:五重絶頂)
		;超強絶頂Ａ
		IF NOWEX:Ａ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ａ
		ELSEIF NOWEX:Ａ絶頂 == 2
			PRINTFORMW 
			;絶頂Ａ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	IF NOWEX:Ｂ絶頂 && (!NOWEX:二重絶頂 && !NOWEX:三重絶頂 && !NOWEX:四重絶頂 && !NOWEX:五重絶頂)
		;強絶頂Ｂ
		IF NOWEX:Ｂ絶頂 >= 2
			;胸を指で弄られて絶頂（愛撫、胸愛撫、背面座位）
			IF SELECTCOM == 0 || SELECTCOM == 313 || SELECTCOM == 6 || SELECTCOM == 68
				IF RAND:3 == 0
					PRINTFORMW 「하, 하... 응... 가슴, 더... 만져줘... %UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「안돼읏, 나, 가슴... 커아아앗%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「야, 응응읏, 그렇게 유두 만지면… 아…… %UNICODE(0x2665)%%UNICODE(0x2665)%」
				ENDIF
				;自分でイジって絶頂（自慰）
			ELSEIF SELECTCOM == 9
				IF RAND:3 == 0
					PRINTFORMW 「하아... 아아...앗! 가슴으로... 갈 것 같아... %UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0
					PRINTFORMW (앗…… 이거… 가슴만으로 가버릴 것 같아…. %UNICODE(0x2665)% )
				ELSE
					PRINTFORMW 「응아, 하앗, 으윽, 굉장한 게 와…… %UNICODE(0x2665)%」
				ENDIF
				;ニプルキャップ装着
			ELSEIF TEQUIP:ニプルキャップ
				IF RAND:2 == 0
					PRINTFORMW 「하아앗... 하아앗... 이거, 벗겨줘...」
					SIF TALENT:恋慕
						PRINTFORMW 「당신의 손가락이 좋아……읏」
				ELSE
					PRINTFORMW 「이런, 계속, 부르르읏, 하고…… %UNICODE(0x2665)%」
				ENDIF
			ELSE
				PRINTFORMW 「아... 안돼... 그곳, 약해... %UNICODE(0x2665)%%UNICODE(0x2665)%」
			ENDIF
			;絶頂Ｂ
		ELSE
			;胸を指で弄られて絶頂（愛撫、胸愛撫、背面座位）
			IF SELECTCOM == 0 || SELECTCOM == 313 || SELECTCOM == 6 || SELECTCOM == 68
				IF RAND:3 == 0
					PRINTFORMW 「하, 하... 응... 가슴, 더... 만져줘... %UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「안돼읏, 나, 가슴... 커아아앗%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「야, 응응읏, 그렇게 유두 만지면… 아…… %UNICODE(0x2665)%%UNICODE(0x2665)%」
				ENDIF
				;自分でイジって絶頂（自慰）
			ELSEIF SELECTCOM == 9
				IF RAND:3 == 0
					PRINTFORMW 「하아... 아아...앗! 가슴으로... 갈 것 같아... %UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0
					PRINTFORMW (앗…… 이거… 가슴만으로 가버릴 것 같아…. %UNICODE(0x2665)% )
				ELSE
					PRINTFORMW 「응아, 하앗, 으윽, 커루옷... %UNICODE(0x2665)%」
				ENDIF
				;ニプルキャップ装着
			ELSEIF TEQUIP:ニプルキャップ
				IF RAND:2 == 0
					PRINTFORMW 「하아앗... 하아앗... 이거, 벗겨줘...」
					SIF TALENT:恋慕
						PRINTFORMW 「당신의 손가락이 좋아……읏」
				ELSE
					PRINTFORMW 「이런, 계속, 부르르읏, 하고…… %UNICODE(0x2665)%」
				ENDIF
			ELSE
				PRINTFORMW 「아... 안돼... 그곳, 약해... %UNICODE(0x2665)%%UNICODE(0x2665)%」
			ENDIF
		ENDIF
	ENDIF
	IF NOWEX:Ｍ絶頂 && (!NOWEX:二重絶頂 && !NOWEX:三重絶頂 && !NOWEX:四重絶頂 && !NOWEX:五重絶頂)
		;超強絶頂Ｍ
		IF NOWEX:Ｍ絶頂 == 3
			PRINTFORMW 
			;強絶頂Ｍ
		ELSEIF NOWEX:Ｍ絶頂 == 2
			PRINTFORMW 
			;絶頂Ｍ
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
