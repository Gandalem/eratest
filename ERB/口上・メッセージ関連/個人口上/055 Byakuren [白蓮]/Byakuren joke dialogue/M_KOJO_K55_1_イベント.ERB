@M_KOJO_BOOBAJOKE_EVENT_K55_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Character returns to their room to sleep
	;小分岐
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【キャラの自室】に戻りました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL %CALLNAME:55%이 무언가를 말하고 떠나려 한다.
		PRINTFORMDW 그녀가 걸어가는 동안, 당신은 그녀의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% 가장자리가 손을 흔드는 것을 볼 수 있다.
		PRINTFORMDW 적어도, 당신은 그것이 그들이 하고 있는 것이라고 생각한다. 그들은 그냥 출렁이고 있을 수도 있다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character looks sleepy
	;眠そうにしている（～は眠そうにしている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDW %CALLNAME:55%'s %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%가 졸려 보인다. 평소처럼 활기차지 않다.
		PRINTFORMDL 아마 그들에게 영양제를 주면 좋을 것 같다-
		PRINTFORMDW 윽! 제기랄, %CALLNAME:55%!!
		PRINTFORMDW 그녀의 가슴은 정말 다른 곳에 붙을 누군가를 찾아야 한다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character is asleep
	;睡眠中（～は眠っている）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMDW %CALLNAME:55% 잠든 것 같았다. 그녀의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%는 깊게 숨을 쉬며 오르내리고 있었다.
		PRINTFORMDL 그리고 바깥세상의 저 이상한 풍선 같은 사람들처럼 흔들렸지만, 그들은 항상 그렇게 했다.
		PRINTFORMDW 그것은 그들의 매력의 일부일 뿐이었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The player collapses (the day ends after this dialogue. Only displayed if the character has Love?)
	;MASTERがダウン（恋慕のみ,そのまま一日が終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMDW 의식을 잃은 채로, 당신은 가슴을 꿈꾼다.
		PRINTFORMDW 구체적으로는 %CALLNAME:55%의 그것이다. 당신은 잠결에 또 다른 오르가즘을 느낀다.
		PRINTFORMDW 다행히 다시 기절할 정도로는 격렬하지 않았다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;The character enters the room the player is in to sleep?
	;TARGETが寝るために自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;The character changes into their sleepwear
		;そのまま着替えて寝た（【TARGET】が部屋に戻ってきた→寝間着へと着替え、寝床に潜った）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			PRINTFORMDW %CALLNAME:55%이 옷을 벗고 있는 건가?!
			PRINTFORMDW 정말로 오판츠님께서 당신을 축복하셨다.
			PRINTFORMDL 그 생각만으로도 너는 절정에 이를 지경이다.
			PRINTFORMDL 너는 천 개의 태양이 쏟아내는 힘으로 절정에 이르며 고개를 뒤로 젖히고 허리를 아치형으로 만들다가 기절한다.
			BASE:MASTER:体力 = 0
			FLAG:気絶中断 = 100 + CFLAG:MASTER:現在位置 / 100
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;The character kicks the player out of their room so they can sleep
		;部屋から追い出して寝た（眠そうな【TARGET】に追い出された…）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMDW 아아, %CALLNAME:55%이 어떤 이유로 그녀의 방에서 너를 내보냈다.
			PRINTFORMDW 그것은 그녀의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%와 관련이 없어서 네가 주의를 기울이지 못했다.
			PRINTFORMDW 너는 그녀에게 슬픈 작별 인사(%FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%)를 고하고 떠난다.
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;The character gets tired and goes back to their room
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		PRINTFORMDL %CALLNAME:55% 하품을 한다(그녀의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% 더 격렬하게 흔들리며) 그리고 떠나려고 몸을 돌린다.
		PRINTFORMDW 그녀가 걸어가는 동안 그녀의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% 손을 흔들며 작별 인사를 하는
		PRINTFORMDW 적어도 너는 저것이 그들이 하는 일이라고 생각한다. 그저 흔들고 있는 것일 수도 있다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
