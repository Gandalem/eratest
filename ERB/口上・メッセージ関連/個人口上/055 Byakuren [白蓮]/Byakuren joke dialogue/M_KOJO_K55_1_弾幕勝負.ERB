; Modular ERB: 個人口上/055 Byakuren [白蓮]/Byakuren joke dialogue/M_KOJO_K55_1_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_BOOBAJOKE_MESSAGE_COM_K55_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_BOOBAJOKE_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORMDW 당신은 %CALLNAME:55%의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%에게 결투를 신청한다.
		PRINTFORMDW 당신은 검과 카포테로 다시 한번 승리를 증명하겠다고 맹세한다!
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 2
				PRINTFORMDW 헤. 이거 쉬울 거야.
				PRINTFORMDW %CALLNAME:55%의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%는 너무 커서 피하려고 노력해야 할 정도야.
				PRINTFORMDW ――가슴 신「가슴의 환영」!!!
				PRINTFORMDW %CALLNAME:55%의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% 가슴이 봉긋하게 튀어나와 네 머리를 감싸버린다!
				PRINTFORMDW 어쩌면 이게 그렇게 쉽지 않을지도...
			CASE 1
				PRINTFORMDW 또 다른 가슴에 또 한 번의 타격.
				PRINTFORMDW ——강박 「엄마 문제」!!!
				PRINTFORMDW 달콤한 흰 꿀이 %CALLNAME:55%의 비치볼 크기 유두에서 흘러나오기 시작한다.
				PRINTFORMDW 그 광경은 당신의 마음속에 원치 않게 단어들을 떠올리게 한다.
				PRINTFORMDW 오 안 돼. 말하지 마.
				PRINTFORMDW 말하지 마-!
				PRINTFORMDL
				PRINTFORMDW 밀키 밀키 따뜻하고 맛있다!
				PRINTFORMDW 엄마! 우유! 어서 주세요!
				PRINTFORMDW 엄마의 유방에서 나온 상쾌한 음료!
				PRINTFORMDW 나는 엄마 것만 원해, 다른 건 싫어!
				PRINTFORMDW 줘! 줘! 지금 당장 줘!
				PRINTFORMDW 게으른 암염소야, 나에게 우유를 줘!
				PRINTFORMDW 네가 할 때까지 난 소리 지르고 외칠 거야!
				PRINTFORMDW 울고 칭얼대며 발을 구를 거야!
				PRINTFORMDW 내 배가 가득 차서 행복해질 때까지!
				PRINTFORMDW 기저귀는 받지 않겠어!
				PRINTFORMDW 당신은 복사 붙여넣기 문구를 읊으며 혼자 웃는다. 정말 밈의 왕이구나, 안 그래 동료 밈러들?! xD
				PRINTFORMDL
				PRINTFORMDW 불행하게도, 그 믿을 수 없을 만큼 재미없는 작은 시를 읊은 덕분에 당신은 앉아있는 먹잇감이 되었다.
				PRINTFORMDW %BREAKENG(@"You manage to avoid %CALLNAME:55%'s bullets by dodging around like you're one of her %FSYN("voluptuous")% %FSYN("chest",,TARGET)%, but only barely.")%
				PRINTFORMDW 그 후 당신의 명중 보너스가 무엇인지 궁금해진다...
			CASE 0
				PRINTFORMDW 그리고 승리는 당신의 것입니다. %CALLNAME:55%은 발치에 쓰러져 있습니다.
				PRINTFORMDW 적어도, 당신은 그렇게 생각하겠죠. 그녀는 저 %FSYN("voluptuous")% %FSYN("chest",,TARGET)% 어딘가에 있을 테니까, 그렇죠?
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORMDW ——배리어 사인 「변칙, 힘, 혼란, 그리고 정령」!!!
		PRINTFORMDW 제기랄, 그녀들의 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%가 네 공격을 막고 있나?
		PRINTFORMDW 도대체 어디에 히트박스가 있는 거야?!
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML
		;Case 4 only applies to 2hus with【Deep Knowledge Of Life】
		;Cases 3-1 are for when you lose, Case 0 is for when you win
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		PRINTFORMDW %CALLNAME:55%은 당신에게 절하고 항상처럼 %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)%이 뒤엉킨다.
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
