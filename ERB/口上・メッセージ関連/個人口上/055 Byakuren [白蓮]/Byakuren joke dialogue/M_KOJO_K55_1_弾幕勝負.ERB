;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_BOOBAJOKE_MESSAGE_COM_K55_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_BOOBAJOKE_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORMDW You challenge %CALLNAME:55%'s %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% to a duel.
		PRINTFORMDW You swear by your sword and capote that you will once again prove victorious!
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 2
				PRINTFORMDW Heh. This is going to be easy.
				PRINTFORMDW %CALLNAME:55%'s %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% are so big you'd have to be trying to miss them.
				PRINTFORMDW ――Breast Sign「Visions of Oppai」!!!
				PRINTFORMDW %CALLNAME:55%'s %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% breast boobily out and wrap themselves around your head!
				PRINTFORMDW Maybe this won't be so easy...
			CASE 1
				PRINTFORMDW Another hit to another tit.
				PRINTFORMDW ――Compulsion 「Mommy Issues」!!!
				PRINTFORMDW Sweet white nectar begins oozing from %CALLNAME:55%'s beachball-sized nipples.
				PRINTFORMDW The sight causes words to rise, unbidden, in your mind.
				PRINTFORMDW Oh no. Don't say it.
				PRINTFORMDW Don't say it-!
				PRINTFORMDL
				PRINTFORMDW MILKY MILKY WARM AND TASTY!
				PRINTFORMDW MOMMY! MILKY! PLEASE BE HASTY!
				PRINTFORMDW REFRESHING DRINK FROM MOMMY'S UDDERS!
				PRINTFORMDW I WANT MOMMY'S AND NO OTHER'S!
				PRINTFORMDW GIVE IT! GIVE IT! GIVE IT NOW!
				PRINTFORMDW GIVE ME MILKY, LAZY SOW!
				PRINTFORMDW UNTIL YOU DO I'LL SCREAM I'LL SHOUT!
				PRINTFORMDW I'LL CRY I'LL WHINE AND STOMP ABOUT!
				PRINTFORMDW UNTIL MY BELLY IS FULL AND HAPPY!
				PRINTFORMDW I REFUSE TO TAKE A NAPPY!
				PRINTFORMDW You giggle to yourself as you recite the copypasta. You're such a memelord, am I right fellow memers?! xD
				PRINTFORMDL
				PRINTFORMDW Unfortunately, reciting that incredibly unfunny little poem has left you a sitting duck.
				PRINTFORMDW %BREAKENG(@"You manage to avoid %CALLNAME:55%'s bullets by dodging around like you're one of her %FSYN("voluptuous")% %FSYN("chest",,TARGET)%, but only barely.")%
				PRINTFORMDW You wonder what your graze bonus is after that...
			CASE 0
				PRINTFORMDW And victory is yours. %CALLNAME:55% lies defeated at your feet.
				PRINTFORMDW At least, you think she does. She's got to be somewhere under those %FSYN("voluptuous")% %FSYN("chest",,TARGET)%, right?
		ENDSELECT
	ENDIF

	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORMDW ――Barrier Sign 「Anomalies, Strength, Disorder, and Spirits」!!!
		PRINTFORMDW Dammit, are her %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% blocking your shots?
		PRINTFORMDW Where the hell are their hitboxes?!
	ENDIF

	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML
		;Case 4 only applies to 2hus with【Deep Knowledge Of Life】
		;Cases 3-1 are for when you lose, Case 0 is for when you win
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		PRINTFORMDW %CALLNAME:55% bows to you, sending her %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% flopping about as always.
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1

