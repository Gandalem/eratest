;==================================================
;Get closer ("CHARACTER gets a little closer to you...")
;距離が近い
;==================================================
@M_KOJO_BOOBAJOKE_MESSAGE_COUNTER_K55_1
CALL EVENT_COUNTER_MESSAGE
CALL M_KOJO_BOOBAJOKE_MESSAGE_COUNTER_K55_1_1
RETURN RESULT
@M_KOJO_BOOBAJOKE_MESSAGE_COUNTER_K55_1_1
PRINTFORMDL Her %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% hit you full force, and you stagger. Directly into them.
PRINTFORMDL They're surprisingly hard. They feel almost like the ground.
PRINTFORMDL %CALLNAME:55%'s %FSYN("voluptuous")% %FSYN("chest:plu",,,TARGET)% are just full of surprises...
RETURN 1

;==================================================
