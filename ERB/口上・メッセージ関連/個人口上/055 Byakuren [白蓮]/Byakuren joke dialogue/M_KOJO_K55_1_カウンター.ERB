CALL M_KOJO_BOOBAJOKE_MESSAGE_COUNTER_K55_2_1
RETURN RESULT
@M_KOJO_BOOBAJOKE_MESSAGE_COUNTER_K55_2_1
PRINTFORMDL You return the glance. To her %FSYN("voluptuous")% %FSYN("chest",,TARGET)%.
RETURN 1

;==================================================
