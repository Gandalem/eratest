; Modular ERB: 個人口上/092 Futo [布都]/布都/M_KOJO_K92_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K92
RETURN 0 ;custom code

@M_KOJO_MESSAGE_MARKCNG_K92
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMDW 시간이 멈춰 있었지만, 후토의 보지 입술은 쾌락으로 움츠러들고 떨렸다...
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMDW 시간이 멈춰 있는데도 후토의 온몸이 상상할 수 없는 쾌감에 삼켜지는 듯 격렬하게 움찔거린다...
	PRINTFORMDW 그녀의 보지는 안팎으로, 문지르고, 짜내고, 두들겨지며 모든 각도에서 자극받았다.
	PRINTFORMDW 그녀의 G스팟은 수십 번이나 강타당했고, 당신이 만족할 때 밀어내자 심지어 자궁경부마저 무례하게 침범당했다.
	PRINTFORMDW 시간이 다시 흐르면서 한순간에 그렇게 많은 쾌감을 경험한 몸에게 과연 무슨 일이 일어날까...
	PRINTFORMDW 당신은 그런 것을 스스로는 절대 경험할 수 없을 테지만, 상상하는 것만으로도 끝없이 흥분한다.
	PRINTFORMDW 당신은 잠시 고민한다. 가련한 소녀에게 더 많은 쾌감을 채워줘야 할지, 아니면 여기서 멈추고 어떻게 될지 지켜봐야 할지...
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORMW 
ELSEIF TFLAG:21 == 2
	PRINTFORMW 
ELSEIF TFLAG:21 == 3
	PRINTFORMW 
ENDIF
