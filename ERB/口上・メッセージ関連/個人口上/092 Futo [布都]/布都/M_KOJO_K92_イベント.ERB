;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K92_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORMW 「Oho? 'Tis none other than %CALLNAME:MASTER%.」
				PRINTFORMW 「Just as well, thou shall accompany me.」
				PRINTFORMDW With a big smile plastered on her face, Futo rushes to your side...
			ELSE
				;"milord" doesn't make sense here. Translate お主 as "milord" only when she has love/lover and something less personal (but still formal) otherwise?
				PRINTFORMW 「How now, %PRINT_MALE("sirrah:madam", MASTER)%! 'Tis the gentleman from the other day.」
				PRINTFORMW 「If thou art not preoccupied, I should not spurn thy company.」
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORMW 「Excuse me, make way! 'Twas a surety I would find thee here, %CALLNAME:MASTER%.」
				PRINTFORMW 「Here, come to me. Let us exchange words about this and that.」
				PRINTFORMDW As she says that, Futo gleefully runs up to you and gives you a hug...
			ELSE
				PRINTFORMW 「Hmph. So the %PRINT_MALE("gentleman_:madam", MASTER)% is here.」
				PRINTFORMW 「I shouldn't have expected to find thee in such a place. Didst thou even bother to sweep up?」
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORMW 「Oh dear, it seems thou art already in here, %CALLNAME:MASTER%?」
				PRINTFORMW 「Ahhh, 'tis just as well. I shall bestow upon thee the honor of washing my back.」
				PRINTFORMW 「What manner of expression is that? Doth my beauty really captivate thee so?」
				PRINTFORMW 「Never have I bare'd my shame before the eyes of man nor mouse, not even the Taishi-sama. Only with thee, %PRINT_MALE("Milord:Milady", MASTER)%.」
				PRINTFORMW 「...I tire of waiting. Look here, make haste and cleanse my body～」
			ELSE
				PRINTFORMW 「Oh dear, the bath doth appear to be full up.」
				PRINTFORMW 「Ehh, I suppose no harm could come of it. I shall even bestow thee with the honor of washing my back.」
				PRINTFORMW 「...I trust thou shalt avert thine eyes from my private place?」
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「Aaack?! Why, thou scurrilous fiend! I cannot believe thy temerity! Away! Fie, fie!」
		PRINTFORMDW Futo, her bath rudely interrupted, rushes to cover herself and hurls a plate in your direction...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORMW 「What do we have here? 'Tis none other than %CALLNAME:MASTER%.」
				PRINTFORMW 「The fates have preordained it, thou shall accompany me.」
				PRINTFORMDW With a big smile plastered on her face, Futo rushes to your side...
			ELSE
				PRINTFORMW 「Oho, 'tis the %PRINT_MALE("gentleman_:madam", MASTER)% from the other day.」
				PRINTFORMW 「If thou art not preoccupied, I would not spurn thy company.」
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
			IF TALENT:恋人 || TALENT:恋慕
				PRINTFORMW 「Oho? Could that be %CALLNAME:MASTER%, perchance?」
				;キャラナンバー: 聖55 神子56 一輪85 屠自古91 布都92 
				IF FLAG:デート相手 == 55
					PRINTFORMW 「Just as well, I had a notion that I would have thee accompany me! ...But then, whyfor art thou here, Hijiri-dono?」
					PRINTFORMW 「Grrrrrr...! Doth thou think to convert %CALLNAME:MASTER% to thy treacherous faith?!」
					PRINTFORMW 「Leave %HIM_HER(MASTER)% alone, I command thee! %CALLNAME:MASTER% shall follow the path of Taoism with me!」
					PRINTFORMDW Futo launches an overwhelming barrage of plates at Byakuren, but she casually deflects them...
				ELSEIF FLAG:デート相手 == 56
					PRINTFORMW 「Just as well, I had a notion that I would have thee accompany me! ...But thou art with the Taishi-sama?!」
					PRINTFORMW 「Grrrr... I have given my everything for the sake of the Taishi-sama, but... But... Gahhh...」
					PRINTFORMW 「Ei! Taishi-sama, please pardon my impudence! Nshoー!」
					PRINTFORMDW Without waiting for permission, Futo sandwiches herself in between you and Miko...
				ELSEIF FLAG:デート相手 == 85
					PRINTFORMW 「Just as well, I had a notion that I would have thee accompany me! ...But then, whyfor art thou here, Ichirin?」
					PRINTFORMW 「Grrrrrr...! Doth thou think to convert %CALLNAME:MASTER% to thy treacherous faith?!」
					PRINTFORMW 「Part with %HIM_HER(MASTER)% at once, I command thee! %CALLNAME:MASTER% shall follow the path of Taoism with me!」
