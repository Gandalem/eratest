@M_KOJO_MESSAGE_COM_K92_20
CALL M_KOJO_MESSAGE_COM_K92_20_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K92_20_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕か恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:4
			CASE 1
				PRINTFORMW 「음흠... 한숨... %RANDKISS("kiss")%...」
				PRINTFORMDL 완전히 깨닫기도 전에 후토와 키스를 나누고 있는 자신을 발견한다.
				PRINTFORMDW 저속한 빨아들이는 소리, 빠는 소리, 입맞춤 소리가 두개골과 직접 뇌 속으로 울려 퍼진다.
				PRINTFORMDL 그녀의 혀가 왼쪽에서 오른쪽으로, 위에서 아래로, 앞뒤로 당신의 구강 속을 파고든다.
				PRINTFORMDW 그녀는 당신의 민감한 입천장을 핥고 당신의 온몸이 쾌감으로 떨린다... 키스가 이렇게 놀라울 수 있다는 것을 깨닫지 못했다.
				PRINTFORMDW 성기나 유두가 자극받지 않았음에도 불구하고, 당신의 흥분은 여전히 최고조로 치솟는다...
			CASE 2
				PRINTFORML 「음... 나의 입술을 가져보길 원하니...?」
				PRINTFORMDW 대답하는 수고는 하지 않고, 그녀의 입술에 키스를 하는 것으로 답하기로 결심한다.
				PRINTFORMDL 두 사람의 혀가 서로에게 닿고 뜨거운 숨결이 뒤섞인다.
				PRINTFORMDW 음란한 혀와 혀의 춤을 추며 후토의 한숨을 맛본다... 감각들이 마법에 걸린 듯 느껴진다.
				PRINTFORMDL 두 사람의 입술은 두 번째로 만나고, 마치 교미하는 짐승처럼 거칠게 그녀의 입 안으로 혀를 넣었다 빼기를 반복한다.
				PRINTFORMDW 갑자기 숨 쉬는 리듬이 동기화된다. 함께 길고 느린 숨을 몰아쉰다.
				PRINTFORMDW 수우ー... 하아ー... 수우ー... 심장 박동은 여전히 멈추지 않고 빠르게 울린다.
				PRINTFORMDW 하지만 동시에, 마음 깊은 곳에서 평온함을 느낀다.
				PRINTFORMDW 함께 숨을 쉬자, 키스만으로 두 사람이 하나가 될 수도 있을 것 같고 영혼이 뒤섞일 것 같다.
				PRINTFORMDW 오럴한 방종처럼 느껴졌던 영원 끝에, 후토는 갑자기 당신의 혀를 마지막으로 질척하게 빨아들인다.
				PRINTFORMDW 마침내 축축한 소리와 함께 떨어지자, 마치 후토의 아름다운 머리카락 중 하나 같은 은빛 타액 실이 두 사람 사이에 다리를 형성한다.
			CASE 3
				PRINTFORMDW 깊숙이, 당신의 입술은 후토의 입술과 겹친다.
				PRINTFORMDW 그녀의 혀는 마치 자신이 있어야 할 곳을 찾는 듯 움직이고, 당신은 그것을 강렬하게 빨아들인다.
				PRINTFORMDW 당신은 그녀를 품에 안고, 매번 그녀의 여성스러운 몸이 섬세하게 떨린다.
				PRINTFORMDW 그녀의 반응은 참을 수 없이 귀엽고, 당신은 계속해서 그녀의 혀를 빨면서 사랑스럽게 그녀를 끌어안게 된다.
				PRINTFORMW 「푸하아~... 하아... 내 영혼이 빠져나갈까 두려웠는데, 내가 그랬다...」
				PRINTFORMDW 당신은 눈가에 고인 눈물을 부드럽게 닦아주고, 다시 그녀를 꼭 안는다...
			CASEELSE
				PRINTFORMDW 당신은 그녀의 촉촉하고 부드러운 입술의 감각을 즐기며 후토를 부드럽게 안는다.
				PRINTFORMDW 깃털처럼 가볍게, 당신은 그녀의 섬세한 달걀껍질 같은 흰 다리를 어루만지고 그녀는 사랑스럽게 떨었다.
				PRINTFORMDW 그리고 당신은 키스를 심화시키고, 당신의 혀끝이 대담하게 후토의 입안으로 파고든다.
				PRINTFORMDW 당신은 그녀의 잇몸 전체와 입천장, 혀를 핥아 올리고 그녀의 볼 안쪽 윤곽을 따라 그린다...
				PRINTFORMDW 그녀의 혀와 당신의 혀가 서로 건드리고 자극하며, 쓸고 빨고, 맛보고 얽힌다...
				PRINTFORMDW 두 사람은 침을 주고받았고, 당신들의 체액은 어느 쪽 입인지 아무도 알 수 없을 정도로 뒤섞였다.
				PRINTFORMDW 당신이 그녀의 입안 모든 에로틱 존을 자극하자 후토는 극적으로 몸을 떨었고, 그녀의 먹먹한 신음이 당신의 목구멍을 타고 울렸다.
				PRINTFORMDW 마침내 당신은 그녀의 혀를 거칠게 빨아들인 후, 그녀의 가장 격렬한 쾌락 발작을 가두기 위해 그녀를 강하게 끌어안았다.
				PRINTFORMDW 마침내 당신과 그녀의 입이 떨어지면서 뒤섞인 타액의 실 같은 다리만을 남겼다...
		ENDSELECT
		RETURN 1
	ENDIF
	;屈服3
ELSEIF MARK:不埒刻印 == 3
	PRINTFORMW 
	RETURN 1
	;それ以外
ELSE
	PRINTFORMW 
	RETURN 1
ENDIF
RETURN 1
