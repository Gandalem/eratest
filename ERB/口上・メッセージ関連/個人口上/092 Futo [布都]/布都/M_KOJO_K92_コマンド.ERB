;==================================================
;0,愛撫
;==================================================

@M_KOJO_MESSAGE_COM_K92_0
CALL M_KOJO_MESSAGE_COM_K92_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K92_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW
	ENDIF
	RETURN 1
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			CALL HPH_PRINT,@"「응, 아아... 괜찮아, 기분이 정말 좋아-」","W"
			PRINTFORMDW 당신은 후토의 부드러운 살을 마음껏 자극하고 동시에 그녀의 모든 에로틱 존을 자극하며 애무한다.
			CALL HPH_PRINT,@"「내 연모여, 음... 내 입술에 그대의 입맞춤을 내려주오, 부디... 쪽―흡햣 흡햣」","W"
			PRINTFORMDW 동물들처럼 두 사람은 골반을 계속 움직이며 서로의 입술을 탐한다...
			CALL HPH_PRINT,@"「안, 흐으, 나를 안아줘, 네 모든 힘으로!HPH」","W"
			PRINTFORMDW 한계에 다다른 그녀에게 후토는 가장 깊은 욕망을 드러낸다. 당신은 그 응답으로 그녀를 강하게 끌어안는다...
			RETURN 1
		ELSE
			CALL HPH_PRINT,@"「아아, 음음... 좋아요, 아히이! 네, 더 괴롭혀 주세요—HPH」","W"
			PRINTFORMDW 당신은 후토의 보지를 때리고 그녀의 몸을 더듬으며 그녀를 흥분시키려 한다...
			CALL HPH_PRINT,@"「음... 이제 내 입술을 줘... 응, 쪽 %RANDKISS("kiss")%HPH %RANDKISS("kiss")%HPH」","W"
			PRINTFORMDW 네 장난은 결코 충분치 않아, 후토는 계속 더 달라고 하네... 그래서 너는 그녀에게 그것을 주며 그녀의 흥분을 다음 단계로 밀어 올린다...
			CALL HPH_PRINT,@"「아아음, 서두를 필요 없어, 으흣! 부드럽게, 더 부드럽게에에이잉흐읍」","W"
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋慕か恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「음냐... 거기는 간지러워...」
				PRINTFORMDW 두 사람은 당신의 손이 후토의 몸 위를 더듬는 동안 키스를 나눈다...
				CALL HPH_PRINT,@"「음, 더 세게, 나를 꼭 안아줘HPH」","W"
				CALL HPH_PRINT,@"「그대에게 키스하고 싶어... 음, %RANDKISS("kiss")%, %RANDKISS("kiss")%, %RANDKISS("kiss")%HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「아아, 내 몸이 노래하고 있어, 으응히잉프ㅎ」","W"
				PRINTFORMDW 당신은 후토의 눈을 깊이 들여 그녀의 봉우리를 부드럽게 자극한다...
				CALL HPH_PRINT,@"「네, 지금 모습 그대로예요, 응... 더 기분 좋게 느끼고 싶어요HPH」","W"
				PRINTFORMDW 당신의 입술이 탐욕스럽게 서로 겹치며, 그녀의 요구에 응하여 그녀의 모든 민감한 부분을 열렬히 공격한다...
			CASEELSE
				PRINTFORMDW 후토의 작은 몸을 뒤에서 안고, 당신은 그녀의 몸 전체를 쓰다듬고 애무했다...
				PRINTFORMDW 당신은 부드러운 손길로 그녀의 허벅지 윤곽을 따라 미끄러지며, 그녀의 여성적인 보물에 다가갔다...
				PRINTFORMDW 천천히, 당신은 그녀의 치골 부위에 도달한 후, 손가락으로 그녀의 V라인을 간질였다...
				PRINTFORMDW 그러고는 갑자기 한 손으로는 가슴을 움켜쥐고 유두를 살짝 꼬집으면서 다른 손가락을 그녀의 음핵에 가져갔다..
				PRINTFORMDW 그녀의 쾌락에 몸을 맡긴 채, 당신이 계속 괴롭히자 후토는 귀엽게 몸을 비틀며 경련했다...
		ENDSELECT
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
