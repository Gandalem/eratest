@M_KOJO_MESSAGE_COM_K52_301
CALL M_KOJO_MESSAGE_COM_K52_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K52_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「오, 차? 고마워요.」
				PRINTFORMDW 레이센은 찻잔을 들고 차를 마시기 시작한다.
				PRINTFORMW 「정말 맛있다... 응, 네 차에 연모하게 됐어, %CALLNAME:MASTER%.」
				PRINTFORMDW "네가 기쁘다니 다행이야..."라고 대답하려던 참이었지만, 그때...
				PRINTFORMW 「너 이거 온갖 여자들한테 만들잖아—」
				PRINTFORMDW 레이센이 응답하며 %HIS_HER(TARGET)% 고개를 저을 때, 당신은 "혹시 질투하는 거야?"라고 묻는다.
				PRINTFORMW 「아니야, 정말 아니거든—」
				PRINTFORMDW 그렇게 말하고도, %HE_SHE(TARGET)%는 차를 한 모금 더 마신다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「고마워요.」
				PRINTFORMDW 라이젠은 시끌벅적한 '후루룩' 소리를 내며 차를 마셨다.
				PRINTFORMW 「음~ 딱 내가 원하던 온기네...」
				PRINTFORMDW 당신이 드디어 %HE_SHE(TARGET)%이 받아들일 만한 적정 온도의 차를 만들었나 보다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「아, 나에게 차를 만들어 주었나? 정말 고맙다.」
				PRINTFORMDW %HIS_HER(TARGET)%에 대한 감사를 표현하며, 라이젠은 찻잔을 들고... 그저 그것을 응시한다.
				PRINTFORMW 「...약이라든가?」
				PRINTFORMDW 하지만 그때 %HE_SHE(TARGET)%는 "아니, 그럴 리 없어"라는 듯 태연하게 네 차를 계속 마신다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「오... 나도 그 차 마셔도 돼? 고마워.」
				PRINTFORMDW 라이젠은 찻잔을 들고 큰 소리로 차를 마시기 시작한다.
				PRINTFORMW 「아, 뜨거워! 왜 이렇게 다 데었지...」
				PRINTFORMDW 놀란 비명과 함께 %HE_SHE(TARGET)%이 튀어나오며 %HIS_HER(TARGET)%는 선명하게 빨개진 데어버린 혀를 드러냈다.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「오, 나에게 차를 타줬어?」
				PRINTFORMW 「고맙네.」
				PRINTFORMDW 리젠은 %HIS_HER(TARGET)% 뺨에 살짝 홍조가 돌며 당신에게 감사함을 표한다.
				PRINTFORMW 「응, 정말 맛있다...」
				PRINTFORMW 
			CASE 0
				PRINTFORML 
				PRINTFORMW 「음? 오, 차인가?」
				PRINTFORMW 「나만을 위해 만든 거야? 고마워.」
				PRINTFORMDW 라이젠은 찻잔을 들고 소리 내어 차를 마시기 시작했다.
				PRINTFORMW 「...아야!」
				PRINTFORMDW 놀란 비명과 함께 %HE_SHE(TARGET)%이 튀어나왔고, 분명 빨개진 %HIS_HER(TARGET)%가 달아올랐다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「...차였나?」
				PRINTFORMW 「정말로 마셔도 될까?」
				PRINTFORMDW "한 번 따면 당신을 위한 것이니까", 리젠에게 용기를 북돋아 주려 한다.
				PRINTFORMW 「그럼 내가 직접 할게...」
				PRINTFORMDW %HE_SHE(TARGET,1)%은 %HIS_HER(TARGET)%의 표정에 공허한 눈으로 차를 홀짝인다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「...차?」
				PRINTFORMW 「뭐, 마셔도 괜찮을 거야.」
				PRINTFORMDW 라이젠은 다소 수줍은 듯 차를 맛본다.
				PRINTFORMDW 하지만 너무 뜨거웠는지, %HE_SHE(TARGET)%는 투덜거리며 %HIS_HER(TARGET)% 입을 찻잔에서 재빨리 뗀다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
