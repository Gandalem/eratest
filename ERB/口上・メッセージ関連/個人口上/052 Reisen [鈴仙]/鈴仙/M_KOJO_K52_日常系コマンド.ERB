;63,もっとキスする
;前ターンキスする後キスする
;分岐条件はEVENT_MESSAGE_COM500.ERB参照
;==================================================

@M_KOJO_MESSAGE_SCOM_K52_63
CALL M_KOJO_MESSAGE_SCOM_K52_63_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K52_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠
		RETURN 0
	IF TALENT:恋人
		PRINTFORML 
		PRINTFORMW 「%RANDLIPS(,"kiss")%… 음, 안 돼, 지금 놓지 마... %FSYN("lips_muffle")%!」
		PRINTFORMDW 레이센은 당신의 입술을 놓으려는 기미가 없는 것처럼 끊임없이 키스를 즐긴다.
		PRINTFORMDW 그녀는 정말 많이 키스하는 것을 좋아하는구나. 숨 쉴 시간도 없이, %HE_SHE(TARGET)%는 그저 %HE_SHE(TARGET)%가 하던 것을 계속한다.
		PRINTFORMW 「%SLUR(FSYN("lips_over"), -2)%… 하아, 하아... 후, 후후후...」
		PRINTFORMDW 레이센은 당신의 입술에서 마침내 떨어지자 살짝 숨을 몰아쉰다.
	ELSEIF TALENT:恋慕
		PRINTFORML 
		PRINTFORMW 「아니, 안 돼, %TOLOWER(FSYN("lips_muffle"))%... 놓지 마... %FSYN("lips_muffle")%!」
		PRINTFORMDW %HE_SHE(TARGET,1)%은 그 긴 키스를 그저 즐길 뿐이다... 그리고 비록 %HE_SHE(TARGET)%가 몇 분 더 키스하더라도...
		PRINTFORMW 「%RANDLIPS(,"kiss")%... %FSYN("lips_muffle")%...」
		PRINTFORMDW %BREAKENG(@"레이센이 기절하려던 순간 당신은 즉시 %HIS_HER(TARGET)%의 입술에서 손을 떼는데, 이는 %HE_SHE(TARGET)%가 적어도 %HIS_HER(TARGET)% 자신의 한계를 인지하고 있어야 함을 알려준다.")%
	ELSEIF TALENT:思慕
		PRINTFORML 
		PRINTFORMW 「%FSYN("lips_muffle")%, %TOLOWER(RANDKISS("kiss"))%... 아, 조금만 더, 아주 잠시라도... 안!」
		PRINTFORMW 「괜찮아, 우리는 그저... 장난치는 것뿐이야...」
		PRINTFORMDW 얼굴이 상당히 붉어졌음에도 레이스는 단호하게 키스를 이어갔다.
	ELSE
		PRINTFORML 
		PRINTFORMW 「%FSYN("lips_muffle")%... %FSYN("lips_muffle")%...! 아니, 너를 놓아줄 생각 없어.」
		PRINTFORMDW 네가 얼굴을 돌리려던 순간, 라이젠이 네 머리를 붙잡고 놓아주지 않았다.
		PRINTFORMDW 그 후, 너는 한동안 계속 키스했다.
	ENDIF
ENDIF
RETURN 1
