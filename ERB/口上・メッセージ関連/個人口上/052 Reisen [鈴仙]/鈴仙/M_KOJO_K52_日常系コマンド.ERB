@M_KOJO_MESSAGE_COM_K52_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:恋人
		SELECTCASE RAND:4
			CASE 3
				PRINTFORML 
				PRINTFORMW 「%CALLNAME:MASTER%... 물론이지, 마음껏 만져도 돼...」
				PRINTFORMDW 당신에게 몸을 비비며, 레이센은 두 사람의 몸을 밀착시킨다.
				PRINTFORMDW %HIS_HER(TARGET,1)% 매끄럽고 하얀 피부는 만지기에 서늘하고 부드러웠다. 마치 눈 같았다.
				PRINTFORMDW 복숭아처럼 홍조를 띤 %HIS_HER(TARGET)%은, %HE_SHE(TARGET)% 당신에게 %HIMSELF_HERSELF(TARGET)%를 온전히 맡긴다.
			CASE 2
				PRINTFORML 
				PRINTFORMW 「내 머리 어때? 내가 말하길 나름 자신 있는데.」
				PRINTFORMDW 실로 레이센의 머리카락은 비단처럼 부드럽고 매끄러웠으며, 손가락 사이를 잔잔한 시냇물처럼 흘렀다.
				PRINTFORMDW 복숭아처럼 은은하게 달콤한 향기가 풍겼다.
				PRINTFORMW 「기분 전환으로 새로운 샴푸를 써봤는데, 어때?」
				PRINTFORMDW 당신은 %HIS_HER(TARGET)% 머리에서 나는 달콤한 향을 계속 음미했다.
			CASE 1
				PRINTFORML 
				PRINTFORMDW 당신은 장난스럽게 라이젠의 귀를 살짝 깨물었다.
				PRINTFORMW 「이봐, 뭐--...」
				PRINTFORMW 「안 돼-- 내 귀 만지지 마, 하지 마...」
				PRINTFORMDW %HE_SHE(TARGET)%가 완전히 황홀해 보였음에도 불구하고, %HIS_HER(TARGET)%의 귀는 그저 천 조각처럼 느껴지고 맛만 날 뿐이었다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「어깨 좀 주실 거예요?」
				PRINTFORMW 「음, 물론이죠. 딱히 뻣뻣하지도 않지만요.」
				PRINTFORMW 「너무 세게 하지 말아 주세요, 알겠죠?」
				PRINTFORMDW 리젠이 말을 마치자, 당신은 %HIS_HER(TARGET)%의 어깨를 문지르기 시작한다.
				PRINTFORMDW 만족스러운 "음, 하아..." 소리와 함께, %HE_SHE(TARGET)%는 다른 무언가가 벌어지는 것처럼 들릴 지경이다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 3
				PRINTFORML 
				PRINTFORMW 「%FSYN("hii")%, 나를 만지는 건...!」
				PRINTFORMDW 리젠은 당신이 %HIS_HER(TARGET)%의 몸을 만지는 순간 놀란 비명을 지른다.
				PRINTFORMDW 걱정스러운 %HIM_HER(TARGET)%는 멈추기로 결정하지만, 리젠은 당신의 손을 잡고 놓지 않는다.
				PRINTFORMW 「오, 멈추지 마... 괜찮아, 내가 장담해...」
				PRINTFORMDW %HIM_HER(TARGET)%가 그렇게 말하는 것을 듣고, 당신은 애정 어린 스킨십을 계속한다.
			CASE 2
				PRINTFORML 
				PRINTFORMW 「%FSYN("hii")%, %TOLOWER(GROAN("guh"))%...」
				PRINTFORMDW 당신은 계속해서 %FSYN("rub:ing")% 레이센의 몸을 느끼는데 고통스러운 신음이 %HIS_HER(TARGET)% 입에서 새어 나온다.
				PRINTFORMW 「더, 나를 만져줘 더...」
				PRINTFORMDW 하지만 %HE_SHE(TARGET)%는 그것에 반대하는 것 같지는 않았다.
			CASE 1
				PRINTFORML 
				PRINTFORMDW 너는 장난스럽게 레이센의 귀를 물었다... 그것은 천 맛이 났다.
				PRINTFORMW 「음! 내 귀가...」
				PRINTFORMDW 지금 당장 잡아당기면 벗겨질까?
				;it would be extremely painful
				PRINTFORMDW 그런 이상한 생각이 잠시 당신의 마음을 스쳐 지나간다.
				PRINTFORMW 「응...? 갑자기 멈췄어, 무슨 일 있었어?」
			CASE 0
				PRINTFORML 
				PRINTFORMW 「음... 내 머리카락...」
				PRINTFORMDW 당신은 레이센의 긴 머리카락을 따라 손을 움직였고, 그 향기는 이슬비 내리는 대나무 숲처럼 상쾌했다.
				PRINTFORMW 「음, 주인님이 만든 샴푸를 쓰는데... 어때?」
				PRINTFORMDW "굉장히 좋은 냄새야..."라고 말하며 레이센의 가슴에서 나는 것을 알아차렸다., is what you say, noticing how it got it off Reisen's chest.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:4
			CASE 3
				PRINTFORML 
				PRINTFORMW 「음 %CALLNAME:MASTER%, 내 손을 잡아줄래?」
				PRINTFORMDW 리젠의 말에 네가 그것을 향해 손을 뻗는다.
				PRINTFORMDW ...눈처럼 차갑고, %HIS_HER(TARGET)% 창백한 흰 손은 만져보니 건조하고 매끄러웠다.
				CALL PRINT_DIALOGUE, @"달 위는 춥고 물도 귀해서 상당히 건조하며 가끔은 해를 전혀 볼 수 없는 날도 있다.", "w"
				PRINTFORMW 「그렇기 때문에 이런 종류의 스킨은 정상인데... %CALLNAME:MASTER%너는 어떻게 생각해? 이상하다고 생각하니?」
				PRINTFORMDW "꽤 괜찮다고"라고 네가 대답하자, 라이젠이 미소 짓는다.
			CASE 2
				PRINTFORML 
				PRINTFORMW 「Ah! %CALLNAME:MASTER%...」
				PRINTFORMW 「음, 그러니까 이런 게... %SPLIT_G("to be expected:normal")% 친구들 사이에서는 이런 거겠지...」
				PRINTFORMDW Reisen은 당신의 몸에 닿는 것을 기꺼이 받아들인다 %FSYN("rub")% %HIS_HER(TARGET)% 몸으로
				PRINTFORMW 「음... 아...」
				PRINTFORMDW 너는 계속 그것을 했고 %HE_SHE(TARGET,1)%은 저항 없이 가만히 있었다.
			CASE 1
				PRINTFORML 
				PRINTFORMDW 당신은 라이젠의 큰 귀를 쓰다듬는다.
				PRINTFORMW 「아, 냐오오!」
				PRINTFORMW 「내 귀, 나의 소중한 귀들...」
				PRINTFORMDW 하지만 라이젠은 얼굴을 새빨갛게 물리기 시작하고, 당신에게는 촉감으로 천의 느낌만 들었다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「음... 어때?」
				PRINTFORMDW 너는 레이선의 머리에서 나는 향기를 즐긴다, 달콤한 우유와 또 다른 무언가의 기운이 살짝 섞인 것을... 부드러운 느낌이었다.
				PRINTFORMW 「에이텐이의 모든 사람이... 결국 그 향을 좋아했구나...」
				PRINTFORMDW 달콤한 우유와 아마도... 당근일 것이다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 1
				PRINTFORML 
				PRINTFORMW 「%FSYN("hii")%, 너무 스킨십하지 말아 줄...세...」
				PRINTFORMDW 라이젠은 %HE_SHE(TARGET)%가 %HIS_HER(TARGET)%를 꽉 깨무는 것을 보며 눈에 띄게 떨었다.
			CASE 0
				PRINTFORML 
				PRINTFORMW 「"내 귀를 만져주세요", 당신이 말하네... 불가능해, 너 정말-- 아아!」
				PRINTFORMDW 너는 %FSYN("start")% 레이센의 귀를 만지작거리며
				PRINTFORMDW 하지만 어쩐지 손에 잡히는 건 천 같은 것뿐이다, 대체 이게 무슨 상황이지...
				PRINTFORMW 「음, 그만해--... 제발, 내가 부탁하는 거야, 진심으로-- 아아악!」
				PRINTFORMDW 하지만 레이센은 계속 거칠게 숨을 몰아쉬며 신음을 흘린다. 이 귀들이 실제로 감각을 전달할 수 있는 걸까?
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
