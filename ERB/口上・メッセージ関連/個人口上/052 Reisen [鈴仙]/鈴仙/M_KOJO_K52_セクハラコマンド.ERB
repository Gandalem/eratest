;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K52_310
CALL M_KOJO_MESSAGE_COM_K52_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K52_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF TALENT:恋人
		PRINTFORML 
		PRINTFORMW 「끼익!」
		PRINTFORMDW %BREAKENG(@"라이젠은 당신이 %FSYN("rub")% %HIS_HER(TARGET)% %FSYN("ass")%%COND_STR(@" and squeeze %HIS_HER(TARGET)% fluffy bunny tail", CFLAG:K52EN_TAIL)%.")%
		PRINTFORMW 「후후, 무슨 일이야? 그게 당기니? %CALLNAME:MASTER%, %MOAN("m",1)%!」
		PRINTFORMDW 「꺄악!」
	ELSEIF TALENT:恋慕
		PRINTFORML 
		PRINTFORMW 「흐으음...!」
		PRINTFORMDW 라이젠이 신음하려던 순간 %HE_SHE(TARGET)% 덮는다 %HIS_HER(TARGET)% 입을 제때 막아버린다.
		PRINTFORMW 「아, 저건... %MOAN("m")%!」
		PRINTFORMDW %BREAKENG(@"But not only does %HE_SHE(TARGET)% not stop your hand, %HE_SHE(TARGET)% also clings to you so as to make it easier to %FSYN("rub")% %HIM_HER(TARGET)%%COND_STR(@", as %HIS_HER(TARGET)% tail shivers with every touch", CFLAG:K52EN_TAIL)%.")%
	ELSEIF TALENT:思慕
		PRINTFORML 
		PRINTFORMW 「%MOAN()%!」
		PRINTFORMDW %BREAKENG(@"라이젠이 갑작스러운 엉덩이 쓰다듬음에 깜짝 놀라 비명을 지른다%COND_STR(@" as %HIS_HER(TARGET)% tiny tail goes crazy, shivering in an amusing way", CFLAG:K52EN_TAIL)%.")%
		PRINTFORMW 「뭐, 무슨 일이야... %MOAN()%!」
		PRINTFORMDW %BREAKENG(@"레이센은 갑자기 엉덩이를 문지르자 놀란 비명을 내지른다%COND_STR(@" as %HIS_HER(TARGET)% tiny tail goes crazy, shivering in an amusing way", CFLAG:K52EN_TAIL)%. ")%
	ELSE
		PRINTFORML 
		PRINTFORMW 「에엣!!! 지금 뭐 하는 거야?!」
		PRINTFORMDW %BREAKENG(@"Reisen brushes your hand away in a fluster as %HIS_HER(TARGET)% face becomes bright red%COND_STR(@", the fur on %HIS_HER(TARGET)% tail standing on its end", CFLAG:K52EN_TAIL)%.")%
	ENDIF
ENDIF
RETURN 1
