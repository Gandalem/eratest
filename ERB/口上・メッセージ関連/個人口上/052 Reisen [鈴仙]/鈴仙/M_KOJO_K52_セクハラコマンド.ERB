LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF TALENT:恋慕
		PRINTFORML 
		PRINTFORMW 「네 두뇌파에서 상당히 저속한 의도를 감지하고 있지만...」
		PRINTFORMDW 당신이 조용히 고개를 끄덕이자, 라이젠은 즉시 %HIS_HER(TARGET)% 치마를 잡고 위로 말아 올린다.
		PRINTFORMW 「...우리가 단둘이라면 네가 원하는 만큼 보여줘도 상관없어.」
		PRINTFORMDW %HE_SHE(TARGET,1)%는 %HIS_HER(TARGET)%의 얼굴에 수치심의 베일을 드리운 채 다른 쪽으로 돌아보며 말한다.
		PRINTFORMDW 뭐, 그럴 만도 하지, 하지만... 바로 이런 상황이 만들어내는 재미가 있기에 이토록 즐거운 거겠지.
		PRINTFORMW 「역시, 조금 부끄러울 수도 있을 것 같아.」
	ELSE
		SELECTCASE CFLAG:2
			CASE IS < 100
				PRINTFORML 
				PRINTFORMDW 당신은 뺨을 맞는다. 뭐, 그건 명백한 결과지만...
				PRINTFORMW 「하아, 하아... 이게 다 무슨 일인지는 모르겠지만, 아슬아웠어.」
				PRINTFORMDW 때릴 거라면 적어도 잘못을 저지른 후에 해라.
			CASE 100 TO 1000
				PRINTFORML 
				PRINTFORMDW 네 손등이 맥을 치더니, 라이센이 그것을 꼬집자 상당히 빨개졌다.
				PRINTFORMW 「다시는 해서는 안 될 일에 대한 교훈이라고 생각해라.」
				PRINTFORMDW 아아, %HE_SHE(TARGET)%가 화가 났어, 완전히 화가 났다. 아직 아무것도 하지 않았는데, %HE_SHE(TARGET)%은 네 뇌파를 읽고 이미 알고 있었다.
				PRINTFORMDW 만약 네가 너무 심하게 상상하기 시작할 때, %HE_SHE(TARGET)%이 가끔 너에게 조금 관대해 주기로 결정한다면 좋을 텐데...
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

@K52_FIRSTFINGERING(ARGS)
;-------------------------------------------------
;original code, from J
;初めて
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL:1
	IF ARGS == "public"
		IF FIRSTTIME("PublicF")
			PRINTFORMDW 옷을 통해 공공의 애정을 받으며 그녀의 은밀한 부위가 완전히 젖은 채, 라이젠이 눈에 눈물을 머금고 당신을 노려본다.
			CALL PRINT_DIALOGUE, @"우으윽 침대에서 했으면 괜찮았을 텐데 왜 공공장소에서 하는 거야... \@ EQUIP:下半身下着２ ? 내 팬티가 # I'm \@ 이제 다 너 때문에 흠뻑 젖었네... %MOAN("m")%!", "w"
			PRINTFORMDW %BREAKENG(@"As you embrace the grumbling Reisen closer, you shove your hand under her skirt%COND_STR(@", sliding her drenched wet underwear aside", EQUIP:下半身下着２)%, and then %FSYN("thrust")% your fingers in her honey pot, copiously oozing with her sticky %FSYN("juice")%.")%
			PRINTFORMDW 그녀의 허리는 저항 없이 당신을 환영한다면, 그녀의 움찔거리고 꼬이는 벽들이 당신의 손가락 주위로 감싸 안는다.
			PRINTFORMW 「안 돼 손가락 넣지 마, 그거 큰일 날 거야... 이제 그만해, 그리고... 하아우욱...!」
			PRINTFORMDW 그녀의 토끼 같은 구멍 안에서 손가락을 꿈틀거리며 매혹적인 벽들을 자극한다. 
			PRINTFORMDW 라이젠이 아름다운 비명을 지르며 동시에 그녀의 질이 당신을 조인다.
			PRINTFORMW 「너 정말 못된 년이야...! 괴롭혀, 고문해...!」
			RETURN 1
		ENDIF
		RETURN 0
	ELSEIF FIRSTTIME("Fingering")
		;合意
		IF TALENT:恋慕
			PRINTFORMW 「음, 어때? 이렇게 축축하고 말랑말랑해서... 역겹지 않아?」
			PRINTFORMDW 라이젠은 자신의 질이 어떻게 느껴질지에 대해 약간 너무 불안해 보이지만, 당신은 아무런 문제가 없다는 듯 고개를 저었다.
			PRINTFORMDW 그녀의 녹아내리는 내부는 거의 불타오를 정도로 뜨거웠다.
			PRINTFORMDW 그녀의 근육질 벽에는 믿을 수 없을 만큼 부드럽고 섬세한 복잡한 주름들이 덮여 있었다.
			PRINTFORMDW 그리고 그 가장 깊은 곳에서부터 느껴지는 압박감... 그것이야말로 순수한 에로티시즘의 극치였다.
			;expanded it a bit
			CALL PRINT_DIALOGUE, @"음, 거칠고 울퉁불퉁한 게 있다고 하네? ...음, 음, 내 안쪽에 아주 많은 입자 같은 혹들이 있는데, 소위 \"청어알\".", "w"
			CALL PRINT_DIALOGUE, @"비록 그것이 ~을 가리키지만 \"상부 부분\" 또는 \"천장\" 벽의 복부 쪽과 같은 부분에 있을 수도 있고 엉덩이 쪽 아래에도 있을 수 있다.", "w"
			PRINTFORMW 「그건 정확히 지점은 아니야, 질 통로 자체의 특이함 같은 거랄까...」
			CALL PRINT_DIALOGUE, @"아직 아주 민감하지만, 너무 많은 감각으로 내가 미쳐버리지 않도록 조금만 참아주면 기쁠 거야.", "w"
			PRINTFORMDW 리젠은 얼굴을 붉히며 시선을 내리깔고 조금 더 작게 중얼거렸다.
			PRINTFORMW 「삽입 시 평소보다 훨씬 즐겁기 때문에, 그것은 더 높은 품질의 여성 "도구"를 의미한다고 한다.」
			PRINTFORMW 「...후후, 당신이 판단해 주도록 할게요...」
			PRINTFORMDW 그녀는 암시적인 속삭임으로 끝을 맺었다.
		ELSE
			PRINTFORMW 「안 돼, 그만둬, 아무것도 넣지 마, 손가락질 하지 마, 안 돼!!!」
			PRINTFORMDW %BREAKENG(@"Preventing Reisen from trying to escape, you grab her legs and force them open, aiming at her crotch stuffy with her female scent, before %FSYN("insert:ing")% your fingers inside her honey pot.")%
			PRINTFORMDW %BREAKENG(@"그녀의 부드럽고 뜨겁고 에로틱한 살 깊은 곳에서, 그녀의 강력하고 단련된 근육들이 그것이 더 이상 들어오는 것을 막기 위해 침입하는 물체를 뒤로 밀어내려 애쓴다.")%
			PRINTFORMDW %BREAKENG(@"하지만 네가 앞으로 나아가며 그녀에게 간지럼을 시키는 자극을 주자, 반대하던 레이센이 조금의 적개심도 없이 날카로운 비명을 지른다.")%
			PRINTFORMW 「이이이익...!! 아-아니야, 믿을 수가 없어! 어떻게 이렇게 좋을 수가 있단 말이야...!」
		ENDIF
		RETURN 1
	ENDIF
ENDIF

@K52_FIRSTCHESTCARESS
;-------------------------------------------------
;小分岐
;-------------------------------------------------
;original code
;初めて
;記入チェック
LOCAL:1 = 1
;-------------------------------------------------
IF !FLAG:70 && GET_BUSTSIZE(TARGET) >= 0 && LOCAL:1 && FIRSTTIME("ChestCaress")
	;裸表示 function deleted, replaced with just "is always true"
	PRINTFORMDW %BREAKENG(@"레이센의 가슴으로 손을 뻗는다. 그것은 %HIS_HER(TARGET)% 옷 아래에 있는 맛있고 잘 익은 흰 과일 한 쌍처럼 보이며, 조심스럽게 만진다.")%
	PRINTFORMDW %BREAKENG(@"손가락이 %HIS_HER(TARGET)%의 감싸는 살 속으로 파고들기를 기대했지만, 대신 당신을 뒤로 밀어내며 부드러워 보이는 것과는 대조적으로 상당한 탄력과 탄성을 보여 주스 같은 느낌을 주었다.")%
	IF TALENT:恋慕
		PRINTFORMW 「흐으응, 아아... 음... 기분 어때?」
		IF GET_BUSTSIZE(TARGET) > 0
			PRINTFORMW 「후후, 어떤 이유 때문인지... 훨씬 더 커져 버렸네... 마음껏 즐겨주길 바랄게.」
			PRINTFORMDW 당신은 %HIS_HER(TARGET)%의 아주 만져볼 만한 가슴들을 마음껏 쓰다듬고, 짜고, 마사지하고, 누르는 것을 즐긴다.
		ELSE
			CALL PRINT_DIALOGUE, @"비록 크지는 않을지라도... 물론 마스터에 비하면 그렇지 않겠지만... 그래도 스스로 말하자면 꽤 자랑스럽다...", "w"
			PRINTFORMDW %BREAKENG(@"%HE_SHE(TARGET)%이 말하길, 너무 크진 않지만 완벽한 형상이야. 거의 영원히 만지고 싶게 만들 만큼 충분해.")%
		ENDIF
	ELSE
		PRINTFORMW 「싫어, 그만해, 너무 거칠잖아...! 전혀 기분이 안 좋아, 아파...!」
		PRINTFORMDW %BREAKENG(@"하지만 %HIS_HER(TARGET)%의 말과는 달리, %HE_SHE(TARGET)%는 %HIS_HER(TARGET)%의 눈에 행복한 눈물과 함께 숨을 몰아쉬고 상기되었다. 이곳에는 많은 잠재력이 있는 것 같다...")%
	ENDIF
	RETURN 1
ENDIF
