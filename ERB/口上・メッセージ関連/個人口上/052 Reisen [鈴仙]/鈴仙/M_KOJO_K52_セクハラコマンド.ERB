;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K52_311
CALL M_KOJO_MESSAGE_COM_K52_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K52_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	IF TALENT:恋人
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「Zzz... Zzz...」
			PRINTFORMDW 라이젠은 깊이 잠들어 있다. 당신이 %HIM_HER(TARGET)%을 안으려고 하자...
			PRINTFORMW 「음... 후후. 더, 강하게... 어... 나를 좀 더 가까이... 붙잡아줘...」
			PRINTFORMDW %HE_SHE(TARGET,1)%가 즐거운 미소를 짓는다. 지금 %HE_SHE(TARGET)%는 어떤 꿈을 꾸고 있는 걸까?
		ELSE
			PRINTFORML 
			PRINTFORMW 「Ah...!」
			PRINTFORMDW 뒤에서 레이센을 안으며, %HE_SHE(TARGET)%은 저항의 기색 하나 없이 당신을 다시 껴안는다.
			PRINTFORMW 「음, 후우... 이렇게 나를 안아주니... 정말 마음이 편해진다...」
			PRINTFORMDW 몸 전체를 이완시키며, %HE_SHE(TARGET)%은 %HIMSELF_HERSELF(TARGET)%에게 자신을 맡긴다.
		ENDIF
	ELSEIF TALENT:恋慕
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「Zzz... Zzz...」
			PRINTFORMDW 당신은 리젠을 안고 %HE_SHE(TARGET)% 평화롭게 잠든다.
			PRINTFORMW 「음... 으윽, 우와아악, 미안해... 너무 미안해... 용서해줘...」
			PRINTFORMDW %HE_SHE(TARGET,1)%는 갑자기 눈물을 터뜨린다. %HE_SHE(TARGET)%은 지금 어떤 꿈을 꾸고 있는 걸까?
		ELSE
			PRINTFORML 
			PRINTFORMW 「...히야아앙?!」
			PRINTFORMDW 당신이 뒤에서 %HIM_HER(TARGET)%을 안자 리젠은 사랑스러운 비명을 지른다.
			PRINTFORMW 「어, 음음... %CALLNAME:MASTER%? 나 좀 놓아줄래, 제발?」
			PRINTFORMDW %HIS_HER(TARGET)%의 눈에 눈물이 고이고 %HE_SHE(TARGET)%는 침묵 속에서 당신의 얼굴을 응시한다. %HIS_HER(TARGET)%의 뺨은 촉촉하게 빛나고 있다.
			PRINTFORMDW 아마도 %HE_SHE(TARGET)%는 그냥 안기는 것을 정말 싫어하는 것 같다... 하지만 그 외에는 놀라울 정도로 저항이 없다.
		ENDIF
	ELSE
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「Zzz... Zzz...」
			PRINTFORMDW 조용히 잠든 리젠. 당신은 %HIM_HER(TARGET)%을 %HIS_HER(TARGET)%의 등을 부드럽게 안는다.
			PRINTFORMW 「에에윽, 으음... 싫어, 떨어져...!」
			PRINTFORMDW %HE_SHE(TARGET, 1)%는 그렇게 되자마자 즉시 강하게 저항했다. 혹시 %HE_SHE(TARGET)%는 포옹되는 것을 싫어하는 걸까?
		ELSE
			PRINTFORML 
			PRINTFORMW 「...끼이익! 에에엥...」
			PRINTFORMDW %BREAKENG(@"갑작스러운 포옹에 작은 비명을 지르며 레이센은 당신의 얼굴을 보는 순간 훨씬 더 크게 비명지를 것 같았기에, 당신은 그를 놓아주기로 결정했다.")%
			PRINTFORMW 「갑자기 안아오지 마!」
			PRINTFORMDW %HE_SHE(TARGET,1)%은(는) %HIS_HER(TARGET)% 눈에 눈물을 글썽이며 너를 꾸짖는다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_MESSAGE_COM_K52_312
CALL M_KOJO_MESSAGE_COM_K52_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K52_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;rejected
	IF TFLAG:193 == 99
		PRINTFORMW 「안 돼애애애!!!」
		PRINTFORMDW 라이젠은 갑자기 당신을 밀쳐내며 바닥으로 쓰러지게 한다.
		PRINTFORMW 「감히... 이럴 수는 없어...!」
		PRINTFORMW 「네가 하고 싶은 대로 하도록 내버려 둘 순 없어!」
		RETURN 1
	ENDIF
	;from J
	LOCAL:1 = 1
	IF LOCAL:1 && !CFLAG:TARGET:睡眠 && FIRSTTIME(SELECTCOM)
		PRINTFORMDW %BREAKENG(@"순간적으로 당신은 레이센에게 부드럽게 입을 맞추지만, %HE_SHE(TARGET)%이 놀라 벌떡 일어나 재빨리 당신에게서 물러나 거리를 유지한다.")%
		PRINTFORMW 「뭐 하는 거야 갑자기...!」
		PRINTFORMDW 레이센은 당신에게서 몸을 돌리며 말한다.
		PRINTFORMDW 자세히 들여다보니, %HIS_HER(TARGET)% 순백의 피부가 모든 수치심과 흥분으로 붉게 물들어 있었다.
		PRINTFORML
		PRINTFORMDW 이 기회를 놓치지 않고, 당신은 레이센의 %HIS_HER(TARGET)% 어깨를 붙잡고 이번에는 더욱 단단하게 입술을 맞대며 반복한다.
		PRINTFORMW 「이 틈을 놓치지 않고, 레이센의 %HIS_HER(TARGET)% 어깨를 붙잡은 채 이번에는 더욱 단단히 입술을 맞대고 몇 번이고 거듭 키스한다.」
		PRINTFORMDW %HIS_HER(TARGET,1)% 눈은 크게 뜨인 채, %HIS_HER(TARGET)% 몸은 충격으로 굳어 있다.
		PRINTFORMW 「......하으윽...!」
		PRINTFORMDW %BREAKENG(@"결국 레이센은 무언가 말하려고 입을 열지만, 그녀의 입술에서는 가련한 비명 소리만 새어 나와 당신이 웃음을 터뜨리게 만든다.")%
		PRINTFORMDW %BREAKENG(@"%HE_SHE(TARGET)%이 %HIS_HER(TARGET)%의 경직을 극복하자, 마치 %HIS_HER(TARGET)%의 수치심을 숨기려고 필사적으로 노력하는 것처럼 %HE_SHE(TARGET)%은 %HIS_HER(TARGET)%의 기분을 잃는다.")%
		CALL PRINT_DIALOGUE, @"뭐, 뭐야... 뭐가 그렇게 웃긴 거야?! 너도 그랬으면 누구나 똑같이 깜짝 놀라고, 딱딱하게 굳고, 심지어 같은 이상한 소리를 냈을 거라고!", "w"
		PRINTFORMW 「정말, 너 정말 괴롭히는 거 좋아하지? 만약 다시 이런 걸 하고 싶다면, 꼭 내 허락을 받고 해줘.」
		PRINTFORML
		PRINTFORMDW %HE_SHE(TARGET,1)%거의 히스테리적으로 말하며 입술을 삐죽 내밀고 돌아선다. 하지만 %HE_SHE(TARGET)%는 다시 %HIMSELF_HERSELF(TARGET)%를 열어두었다.
		PRINTFORMDW 조심스럽게 %HIM_HER(TARGET)%를 안으며, 당신은 열정적인 키스를 나누고, 당신의 혀로 %HIS_HER(TARGET)%의 부드러운 입술을 살며 가볍게 건드린다.
		PRINTFORMW 「%HE_SHE(TARGET,1)%가 거의 히스테릭하게 말하며 입을 삐죽 내밀고 돌아선다. 하지만 %HE_SHE(TARGET)%는 그저 %HIMSELF_HERSELF(TARGET)%를 다시 열어 둔 채였다.」
		PRINTFORMDW %BREAKENG(@"당황한 듯 잠시 몸을 꿈틀거리다가, 당신이 하려는 것을 깨닫고 %HE_SHE(TARGET)%는 입을 벌려 %HIS_HER(TARGET)%의 혀를 내밀어 천천히 당신의 혀에 닿는다.")%
		PRINTFORMDW %BREAKENG(@"레이센의 혀가 주는 황홀한 감정에 자신을 맡으려는 충동과 싸우려 필사적으로 노력하며, 당신은 조심스럽게 자신의 혀를 %HIS_HER(TARGET)% 입안 깊숙이 밀어 넣어 그 심연을 탐색한다.")%
		PRINTFORMDW 그러면 당신은 그것의 구석구석을 마음껏 조심스럽게 맛본다.
		SIF !(EXP:キス経験 || EXP:MASTER:キス経験)
			PRINTFORMDW 정말 지옥 같은 첫 키스였다.
		PRINTFORMDW 리젠은 온갖 감각이 %HIM_HER(TARGET)%에게 쏟아지면서 완전히 숨을 헐떡이고 기절할 지경이었다.
		;technically 1 main kiss plus two extra kisses
		CALL MUTUAL_KISS(TARGET, 2)
		RETURN 1
	ENDIF
	IF TALENT:恋人
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「쿨쿨... 쿨쿨...」
			PRINTFORMDW 잠든 라이젠의 입술을 맞추고 몇 번이고 키스를 나눈다.
			PRINTFORMW 「%RANDLIPS(, "kiss")%... %FSYN("lips_over")%...」
			PRINTFORMDW 믿기 어렵지만, 실수로 열정적인 프렌치 키스로 만들었음에도 불구하고, %HE_SHE(TARGET)%은(는) 여전히 깊이 잠들어 있었다.
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORMW 「%RANDLIPS(, "kiss:heart:name")%...」
					PRINTFORMDW 당신의 키스는 꽤 오랫동안 이어졌다.
					PRINTFORMW 「아, 아직 멈출 수 없어, 그러고 싶지 않아! %FSYN("lips_muffle")%... %FSYN("lips_muffle")%...」
					PRINTFORMDW 네가 물러나려 해도 레이센은 즉시 다시 너를 괴롭하며 너의 혀와 뒤섞인다.
				CASE 1
					PRINTFORML 
					PRINTFORMDW 리젠은 저항하지 않고 그것을 내버려 두거나, 아니면 오히려 %HE_SHE(TARGET)% 적극적으로 당신의 키스를 갈망한다.
					PRINTFORMW 「%RANDLIPS(, "kiss")%, %TOLOWER(FSYN("lips_over"))%... 후후, %CALLNAME:MASTER%%UNICODE(0x2665)%」
					PRINTFORMDW 리젠은 몰입한 표정으로 아름답게 당신에게 미소 짓는다.
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「쿨쿨... 쿨쿨...」
			PRINTFORMDW 잠든 레이센에게 키스를 나눈다.
			PRINTFORMW 「아안, 하지 마... %RANDKISS("kiss")%, %TOLOWER(FSYN("lips_muffle"))%...」
			PRINTFORMDW 얼굴을 붉히며, 레이센은 마치 당신을 놓지 않으려는 듯 계속해서 %HIS_HER(TARGET)%의 혀를 당신의 혀와 얽는다...
			PRINTFORMDW %HE_SHE(TARGET,1)%는 아직 자고 있지...?
		ELSE
			PRINTFORML 
			PRINTFORMW 「%FSYN("lips_muffle")%...」
			PRINTFORMW 「%RANDLIPS(, "kiss")%...」
			PRINTFORMDW 몸을 밀착시키며 레이센은 열렬하게 당신의 입술에 키스를 한다.
			PRINTFORMW 「%FSYN("lips_muffle")%, %TOLOWER(RANDKISS("kiss"))%... %FSYN("lips_over")%, 하아, 하으, 키스하는 게... 정말 좋아...」
			PRINTFORMDW 레이센은 완전히 취한 표정으로 부드럽게 속삭이며 그 짜릿한 감각을 즐긴다.
		ENDIF
	ELSEIF TALENT:思慕
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「Zzz... Zzz...」
			PRINTFORMDW 평온하게 잠든 라이젠에게 키스를 건넨다.
			PRINTFORMW 「%FSYN("lips_muffle")%... %FSYN("lips_muffle")%...」
			PRINTFORMDW %HIS_HER(TARGET,1)%얼굴이 살짝 빨개졌다.
			PRINTFORMDW %HE_SHE(TARGET,1)%서로의 혀가 얽히기도 했다. 어쩌면 %HE_SHE(TARGET)%은 키스에 익숙해지기 시작한 것 같다.
		ELSE
			PRINTFORML 
			PRINTFORMW 「%RANDLIPS(, "kiss")%...」
			PRINTFORMW 「너는 키스하는 게…… 꽤 잘하네……」
			PRINTFORMDW 라이젠은 당신을 또 다른 키스로 유도하기 전에 말한다.
		ENDIF
	ELSE
		IF CFLAG:TARGET:睡眠
			PRINTFORML 
			PRINTFORMW 「쿨쿨... 쿨쿨...」
			PRINTFORMDW 조용히 잠든 라이젠에게 입맞춤을 한다.
			PRINTFORMW 「%FSYN("lips_muffle")%... %FSYN("lips_muffle")%...! %RANDKISS("kiss")%...」
			PRINTFORMDW %HE_SHE(TARGET, 1)%살짝 혀를 섞어봐... %HE_SHE(TARGET)% 정말 자고 있는 걸까?
		ELSE
			PRINTFORML 
			PRINTFORMW 「「%FSYN("lips_muffle")%?! ...%FSYN("lips_muffle")%, %TOLOWER(FSYN("lips_muffle"))%... %FSYN("lips_muffle")%?! %FSYN("lips_over")%! S-... 그만해!」
			PRINTFORMDW 레이센이 잠시 키스를 즐기는 듯 보였음에도 불구하고, %HE_SHE(TARGET)%는 당신을 밀어낸다.
		ENDIF
	ENDIF
ENDIF
RETURN 1
