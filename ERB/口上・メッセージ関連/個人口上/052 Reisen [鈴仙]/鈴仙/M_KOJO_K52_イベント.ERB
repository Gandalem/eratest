@M_KOJO_SPEVENT_K52_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		LOCALS '= SPLIT_G("date me:ask me out:go out with me:take me out")
		;住み込み
		IF FLAG:住み込みキャラ == 52
			PRINTFORMW 「응, 정말 많이 즐겼어, 아주 많이!」
			IF RAND:2
				PRINTFORMW 「정말 즐거웠어, %CALLNAME:MASTER%%UNICODE(0x2665)%」
			ELSE
				PRINTFORMW 「다음에 또 나랑 데이트할래, 알았지?」
			ENDIF
			;恋人
		ELSEIF TALENT:恋人 ;original condition checked for kagerou, damn copy paste
			PRINTFORMW 「응, 정말 많이 즐겼어, 아주 많이!」
			IF RAND:2
				PRINTFORMW 「당신과 함께 있으면 시간이 정말 빨리 지나가네요, %CALLNAME:MASTER%.」
			ELSE
				PRINTFORMW 「이제 집에 돌아가야 한다는 게 정말 안타깝다.」
			ENDIF
			;	恋慕
		ELSEIF TALENT:恋慕
			IF RAND:2
				PRINTFORMW 「하아, 벌써 돌아온 것 같네.」
				PRINTFORMW 「...음, 다음엔 또 %LOCALS% 해줄 거지?」
			ELSE
				PRINTFORMW 「후우, 오늘은 이만하면 됐어요, 고마워요.」
				PRINTFORMW 「조금 피곤한 것 같아요...」
			ENDIF
			;思慕
		ELSEIF TALENT:思慕
			IF RAND:2
				PRINTFORMW 「당신과 좀 더 시간을 보내면 기쁠 텐데, 피곤함은 눈에 좋지 않다고들 하더라고.」
				PRINTFORMW 「다음에 또 %LOCALS% 해주길 바라, 응?」
			ELSE
				PRINTFORMW 「후우, 정말 즐거웠어, 너무 지쳤어~!」
				PRINTFORMW 「나는 일 외에는 별로 밖에 나가지 않아서, 가끔 이런 걸 하는 게 기분 좋네.」
			ENDIF
			;思慕じゃない
		ELSE
			PRINTFORMW 「...음... 다음번에 %LOCALS%하기로 결정한다면, 기대하고 있을게.」
		ENDIF
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;死に分岐
		IF GETBIT (CFLAG:1490,0)
			PRINTFORML 「정말이지~ ...진심이야.」
			PRINTFORML 「내가 이 모든 시간 동안 그렇게 화를 낸 이유가 뭐라고 생각해, 응?」
			PRINTFORMDW %PRINT_MALE("boy")%은/는 당신의 팔에 매달린 채 %HE_SHE(TARGET)%에게 말한다.
		ELSE
			PRINTFORML 「지난번에 정말 나 화나게 했잖아, 알지～」
			PRINTFORMDW 라이젠은 과시적으로 입을 삐죽 내밀고 %HIS_HER(TARGET)% 고개를 돌린다.
			PRINTFORML 「너 용서해 달라고 기대하지 마... 다음엔 꼭 그래야 돼, 알았지?」
			PRINTFORMDW %HE_SHE(TARGET)%는 옆눈으로 당신을 흘겨보며 말한다.
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;死に分岐
		IF GETBIT (CFLAG:1490,0)
			PRINTFORML 「제발 좀 그래어～」
			PRINTFORML 「너무 나를 동정하지 마...!」
			PRINTFORMDL 데이트에서 돌아온 후, 라이젠은 %HE_SHE(TARGET)% 조금 안절부절못하는 듯했다.
		ELSE
			PRINTFORML 「기대 갖지 마, 난 아직도... 너를 조금도 용서하지 않았어, 알겠지?」
			PRINTFORMDL 라이젠은 그렇게 말하지만, %HIS_HER(TARGET)%의 웃는 얼굴이 다른 이야기를 하고 있었다.
		ENDIF
		PRINTFORMW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;死に分岐
		IF GETBIT (CFLAG:1490,0)
			PRINTFORML 「...이것만으로 나를 용서할 수 있다고 생각한다면 큰, 아주 큰 실수를 하는 거야!」
			PRINTFORMDL 그렇다 해도 %HIS_HER(TARGET)%의 날카롭고 차가운 시선은 분명 조금이라도 누그러진 듯했다.
		ELSE
			PRINTFORML 「절대로, 절대 너를 용서하지 않을 거라는 걸 알아줘...!」
			PRINTFORMDW 라이젠은 거의 들리지 않는 속삭임을 남기며 당신에게서 한 발짝 물러선다...
			PRINTFORML 「...어쩌면, 난 확신이 없을지도 몰라.」
			PRINTFORMDL 결국 당신의 귀에 닿는다.
		ENDIF
		PRINTFORMW
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
