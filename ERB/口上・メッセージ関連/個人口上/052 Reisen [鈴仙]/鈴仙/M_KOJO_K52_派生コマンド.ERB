; Modular ERB: 個人口上/052 Reisen [鈴仙]/鈴仙/M_KOJO_K52_派生コマンド.ERB
;==================================================
;6,挿入Ｇスポ責め
;==================================================

@M_KOJO_MESSAGE_SCOM_K52_6
CALL M_KOJO_MESSAGE_SCOM_K52_6_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K52_6_1
;custom code, moved from M_KOJO_MESSAGE_COM_K52_72
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF !FLAG:70 && LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME("挿入Ｇ")
		PRINTFORML
		;恋慕
		IF (TALENT:恋人 || TALENT:恋慕)
			PRINTFORMW 「히야아아...! 크하아아... 하아아...」
			PRINTFORMW 「그 부위는... 매우 민감해서... 좀 부드럽게 애원해 봐--... 쿠우흐!」
			PRINTFORMDW 그녀의 가장 민감한 부위에 반복적인 자극이 가해지자 라이센의 틈에서 많은 체액이 흘러나왔다.
			;それ以外
		ELSE
			PRINTFORMW 「스토-- 그만둬! 저 곳은...!! 후아아아악!」
			PRINTFORMDW 민감한 부분을 끊임없이 자극당하며, 라이젠은 점차 정신을 놓아가고 있었다. 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		;前回射精した
		IF TCVAR:104
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	PRINTFORML
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「%MOAN("l:m",,2)%! 응, 더, 더 괴롭혀줘!」
		PRINTFORMDW 리젠은 높은 신음을 내며 %PRINT_OUTSIDE("room")%를 채우고, 더 많은 쾌락을 찾아 미쳐간다.
		RETURN 1
		;屈服3
	ELSEIF ABL:Ｖ感覚 >= 3 || MARK:不埒刻印 == 3
		PRINTFORMW 「안 돼, 그만해! 내가 말할 거야아아! %MOAN("h")%!!!」
		PRINTFORMDW 전기 충격을 받은 듯 경련하며, 라이젠이 소리를 지르며 목소리를 높인다.
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「%MOAN(,,3, "dot")%... 우으으...」
		PRINTFORMDW 떨고 몸을 떨며 리젠은 자신의 생각을 말로 표현조차 할 수 없었다.
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;Added, Double Handjob for Tewi.

@M_KOJO_MESSAGE_MESSAGECHECK_CUSTOM_SCOM_K52_12
RETURN 1

@M_KOJO_MESSAGE_CUSTOM_SCOM_K52_12
;Double Handjob.
VARSET RESULT
IF MASTER_POSE(SET_YUBI,SET_P,1) == 53 && CFLAG:53:口上セレクタ == 0
	TFLAG:SKIPASSIKOJO = 1
	TRYCALL K53_DOUBLE_HANDJOB(52)
ENDIF
SIF !RESULT
	CALL TRAIN_MESSAGE
RETURN 1

@M_KOJO_MESSAGE_CUSTOM_SCOM_K52_12_2
VARSET RESULT
IF MASTER_POSE(SET_YUBI,SET_P,0) == 53 && CFLAG:53:口上セレクタ == 0
	TFLAG:SKIPASSIKOJO = 1
	TRYCALL K53_DOUBLE_HANDJOB(52)
ENDIF
SIF !RESULT
	CALL TRAIN_MESSAGE
RETURN 1
