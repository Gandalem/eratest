	CALL CHARA_TEXT([[永琳]], @"『네가 그렇게 아끼던 %PRINT_MALE("boy", MASTER)% 친구 아니었어?』", "w")
PRINTFORMW 「아니, 아무것도 기억나지 않아... 그리고 결코...」
