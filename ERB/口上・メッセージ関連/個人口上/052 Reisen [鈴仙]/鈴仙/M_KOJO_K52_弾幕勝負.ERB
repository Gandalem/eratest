; Modular ERB: 個人口上/052 Reisen [鈴仙]/鈴仙/M_KOJO_K52_弾幕勝負.ERB
;original code as of now
;==================================================
;弾幕勝負
;==================================================

@M_KOJO_MESSAGE_COM_K52_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIM NUM_TARGET
;these variables will be cleaned, can't use dynamic because this function is re-called over and over again
#DIM nReisenPissedOff
#DIM nGoneMad
#DIM nPower
;for assembling characters who'd like to come and watch
;tewi, eirin, junko, kaguya, watatsuki sisters, youmu, sagume, seiran, ringo
#DIM nEligibleWatchers = [[てゐ]], [[永琳]], [[純狐]], [[輝夜]], [[依姫]], [[豊姫]], [[妖夢]], [[サグメ]], [[清蘭]], [[鈴瑚]]
#DIM nTargetPresent, 10
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		nPower = ABL:MASTER:戦闘能力 * 10
		CALL K52_WATCHFIGHT, nEligibleWatchers
		NUM_TARGET = GET_TARGETNUM()
		[IF_DEBUG]
		;debug
		PRINTFORML NUM_TARGET - {NUM_TARGET}, TARGET - %CALLNAME:TARGET%, 감시: {VARSIZE("nEligibleWatchers")}
		FOR LOCAL, 0, VARSIZE("nEligibleWatchers")
		PRINTFORML 적격 관찰자 수 - {nEligibleWatchers:LOCAL}
		NEXT
		[ENDIF]
		;check who's around for additional lines
		LOCAL:1 = 0
		FOR LOCAL, 0, NUM_TARGET+1
		SIF TARGET:LOCAL <= 0
			CONTINUE
		SIF FINDELEMENT(nEligibleWatchers, TARGET:LOCAL) == -1
			CONTINUE
		SIF LOCAL:1 >= VARSIZE("nTargetPresent") ;failsafe
			BREAK
		IF CFLAG:(TARGET:LOCAL):現在位置 == CFLAG:MASTER:現在位置
			SELECTCASE TARGET:LOCAL
				CASE [[てゐ]]
					CALL CHARA_TEXT([[てゐ]], "『야, 레이센! 너무 거만해지지 마!』", "w")
					PRINTFORMDW 테위는 레이센에게 혀를 내밀며 엄지를 내리고 부릅니다.
					PRINTFORMW 「쳇, 너 %HIM_HER(MASTER,,1)%이랑 같이 있구나... 조금도 놀랍지 않아.」
					CALL CHARA_TEXT([[てゐ]], "『아니, 난 네가 당해서 다들 당황하고 패배하는 걸 보고 싶었을 뿐이라고! 하하!』", "w")
					PRINTFORMW 「아우우...」
					nPower -= 10
				CASE [[永琳]]
					CALL CHARA_TEXT([[永琳]], "『후후...』", "w")
					PRINTFORMW 「M-마스터?! ...좋아요! 최선을 다할게요! 마스터 앞에서 창피한 일은 할 수 없으니까요!」
					nPower += 10
				CASE [[純狐]]
					CALL CHARA_TEXT([[純狐]], "『...』", "w")
					PRINTFORMDW 준코는 라이센에게 살짝 손을 흔들고 입을 가린 채 미소를 지었다.
					PRINTFORMW 「준-준코상?!」
					PRINTFORMW 「아우우우...」
					PRINTFORMDW 매우 효과가 좋았다!
					nPower -= 10
				CASE [[輝夜]]
					PRINTFORMDW 카구야는 레이스의 전체 이름이 적힌 깃발을 흔들며 팬처럼 환호한다 %HIM_HER(TARGET)%.
					CALL CHARA_TEXT([[輝夜]], "『이나바~짱! 계속 싸우자~! 너 할 수 있어~!』", "w")
					PRINTFORMW 「공주님... 네! 실망시키지 않겠어요!」
					nPower += 10
				CASE [[依姫]], [[豊姫]]
					PRINTFORMDW 달의 공주 중 한 명이 그 자리에 존재로 우아함을 더한다.
					CALL CHARA_TEXT(TARGET:LOCAL, "『우리를 자랑스럽게 해줘, 레이센!』", "w")
					PRINTFORMDW %HIS_HER(TARGET,1)%리젠은 새로운 결의를 다지며 앞을 응시하고 눈이 반짝였다.
					nPower += 5
				CASE [[妖夢]]
					PRINTFORMDW 요무가 어디선가 나타나 환호한다.
					CALL CHARA_TEXT([[妖夢]], "『레이센 씨... 행운을 빌어!』", "w")
					PRINTFORMW 「그래... 이제 우리를 조롱하는 걸 그만둬야지, 하인들아!」
					nPower += 10
				CASE [[サグメ]]
					CALL CHARA_TEXT([[サグメ]], "『\"The one who fell...\"』", "w")
					PRINTFORMDW 사구메는 이길 수 있다는 무언의 몸짓으로 라이젠을 바라보며 미소 지었다.
					PRINTFORMW 「사구메님...」
					PRINTFORMW 「네! 물론이죠! 저에게 맡겨주세요! 저는 패배하지 않을 거예요!」
					nPower += 10
				CASE [[鈴瑚]], [[清蘭]]
					PRINTFORMDW %HIS_HER(TARGET,1)%다른 토끼들이 레이즌이 싸우는 것을 보러 온 것 같다.
					CALL CHARA_TEXT(TARGET:LOCAL, "『지구는 재미있는 곳인 것 같아... 그리고 우리가 네가 여기서 성공하는 걸 보고 싶어!』", "w")
					PRINTFORMDW 그들의 존재는 레이슨이 더 열심히 싸우도록 영감을 준다!
					nPower += 5
			ENDSELECT
			nTargetPresent:(LOCAL:1++) = TARGET:LOCAL
		ENDIF
		PRINTFORML
		NEXT
		;debug
		;#;PRINTFORML Eirin - {FINDELEMENT(nTargetPresent, [[永琳]])}, LOCAL:1 - {LOCAL:1}, LOCAL - {LOCAL}
		HANDICAP_FIXED = nPower
		HANDICAP_RAND = nPower * ABL:MASTER:戦闘能力
		IF FIRSTTIME("ReisenDanmaku")
			PRINTFORMDW 당신은 %HIS_HER(TARGET)%의 일에 신경 쓰며 %HIM_HER(TARGET)%에게 단마쿠 시합을 청한다.
			PRINTFORMW 「그-나랑 단마쿠 연습하고 싶어?」
			PRINTFORMW 「음, 네가 만약... 좀 도와줄 수는 있는데--」
			PRINTFORMDW 아니, 연습이 아니라 싸움이야.
			PRINTFORMW 「아, 우으... 에?!」
			PRINTFORMW 「진짜 시합이라고?!」
			PRINTFORMW 「음... 진지하게 이런 거 해본 지 좀 됐는데, 그래서... 음, 좀 녹슬었을지도 모르겠어.」
			PRINTFORMW 「왜냐하면 전투나 단마쿠에 관해서는... 가볍게 하는 편이 아니거든...」
			PRINTFORMDW 순식간에 레이센 주변의 분위기가 완전히 바뀌었다.
			PRINTFORMDW %HE_SHE(TARGET,1)%가 갑자기 %HIS_HER(TARGET)%의 예전 블레이저를 꺼내 입고, 자세를 바로잡으며 결의에 찬 표정을 지었다.
			PRINTFORMDW 이 모습은 마치 완전히 다른 사람처럼, 심지어... 군인 같아서 그 어느 때보다 침착해 보였다.
			PRINTFORML
			PRINTFORMW 「단순한 달 토끼로 날 오해하지 말아주세요.」
			PRINTFORMDW 레이센은 %HIS_HER(TARGET)%의 눈이 붉게 번뜩이며 아래 눈꺼풀을 내리고, 위협적인 속삭임으로 목소리를 낮춘다.
			PRINTFORMW 「하지만 내가 힘을 아끼지는 않을 거예요, 알아두시라고.」
			PRINTFORMW 「어차피 싸우는 건 나의 전문이었으니까... 어느 시점에서는 말이죠. 보여드리죠.」
			PRINTFORMDW 믿을 수 없을 정도로 빠른 투사체가 당신의 목을 향해 날아오고 당신은 간신히 그것을 피한다.
			SIF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTFORMDW 너무 빨라서 보지도 못하고 그냥 땅에 쓰러졌다.
			PRINTFORMDW 그게... 총알이었나?
			PRINTFORMDW 너는 라이젠이 권총처럼 %HIS_HER(TARGET)% 손가락을 가리키고 있는 걸 본다. 그래, 그거였겠지...
			IF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTFORMW 「게다가 나는 그것을 느리게 만들었지...」
				PRINTFORMW 「어찌 이리 무례한가...」
				PRINTFORMW 「그렇게 약하다면 왜 나에게 도전하는 거지?」
				PRINTFORMW 「흥, 걱정 마. 빨리 끝내주지.」
			ENDIF
			PRINTFORML
			IF MARK:反発取得履歴
				PRINTFORMW 「내가 *모든 것*을 기억하고 있다는 걸 알아둬... 네 과거의 잘못들도 말이야.」
				PRINTFORMW 「네가 나에게 상처를 주고, 아프게 하고, 두렵게 하고, 밀어냈던 모든 순간들...」
				PRINTFORMW 「이제 우리 사이를 평등하게 만들 시간이다.」
				IF (MARK:反発刻印 || CFLAG:ブチギレ)
					PRINTFORMDW 리젠은 이 모든 시간 동안 당신에게 엄청나게 화가 나 있었던 것 같다.
					PRINTFORMDW %HE_SHE(TARGET,1)%(그녀는) 날카롭고 차가운 시선으로 당신을 노려보며 이미 정신적으로 제압하고 있다.
				ENDIF
				PRINTFORMW 「이것이 돌아설 수 있는 마지막 기회다... 무엇을 하겠느냐?」
				PRINTFORMDW 이제 물러설 방법은 없다!
				PRINTFORMW 「후후... 너는 계속해서 너의 파멸을 향해 행군하는구나. 마음에 드는걸.」
				PRINTFORMW 「그럼 시작하자!」
			ELSE
				PRINTFORMW 「계속 몰아붙인다면 상황이... 상당히 심각하게 돌아갈 수도 있다.」
				PRINTFORMW 「그럼에도 모든 것을 알고도 나랑 싸우고 싶단 거냐? ...좋다.」
				PRINTFORMW 「내가 너를 부숴주마. 네가 원했던 대로.」
			ENDIF
			PRINTFORML
		ELSE
			PRINTFORMW 「...또 시작이군.」
			PRINTFORMDW 순식간에 레이센 주변의 분위기가 완전히 바뀌었다.
			PRINTFORMDW %HE_SHE(TARGET,1)%은(는) 어디서도 없이 %HIS_HER(TARGET)% 구식 블레이저를 꺼내 입고, %HIMSELF_HERSELF(TARGET)%을 바로잡으며 차분해진 %HIS_HER(TARGET)%의 모습을 보인다.
			PRINTFORMDW 이 모습으로 %HE_SHE(TARGET)%은(는) 마치 완전히 다른 사람처럼, 마치... 군인처럼 보였다.
			PRINTFORMDW 레이센과 함께 매치를 시작하며 사방에서 끝없는 복도가 당신을 둘러싼다!
			PRINTFORMW 「보이는가?」
			PRINTFORMW 「이 최면적인 복도는 나의 함정 중 하나이다.」
			PRINTFORML
			PRINTFORMW 「곧 똑바로 날 수 없으니, 내 힘에 완전히 쓸려버릴 거야!」
			PRINTFORMW 「...하아, 이걸 보니 옛날 생각이 나네.」
			PRINTFORML
		ENDIF
		IF (MARK:反発刻印 || CFLAG:ブチギレ)
			HANDICAP_FIXED *= 2
			nReisenPissedOff = 1
			PRINTFORMDL 라이젠은 지금 정말 화가 나 있는 것 같지만...
			PRINTFORMDL 당신은 %HIM_HER(TARGET)%이 전혀 참을 것이라고 기대해서는 안 된다.
			PRINTFORMW
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Apply Handicap
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "HANDICAP"
		IF !RAND:( 10 * MAX(1, ABL:MASTER:戦闘能力 - ABL:戦闘能力) ) && !nGoneMad
			HANDICAP_FIXED *= 2
			nGoneMad = 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		IF nGoneMad == 1 ;triggered it just now
			PRINTFORMDL 당신은 라이젠의 광기 어린 시선에 사로잡히고 있음을 느낀다...
			PRINTFORML 「*이미 미쳐버렸다!*」
			nGoneMad = 2
		ELSE
			;怒り
			IF nReisenPissedOff
				PRINTDATAL
					DATAFORM 「이것이 달을 대신한 너의 벌이다!...뭐라고?」
					DATAFORM 「자, 이제 미안해지기라도 했니? 하지만 자비는 없을 거다!」
					DATAFORM 「그냥 항복하고 광기에 몸을 맡겨라!」
					DATAFORM 「가만히 있어. 내가 빨리 끝내주마!」
					DATAFORM 「얌전히 여기서 맞고 있거라, 알겠지?」
				ENDDATA
			ELSEIF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTDATAL
					DATAFORM 「조금 더 버텨봐!」
					DATAFORM 「따라와야 해. 안 그러면 죽게 될 거야, 알잖아?」
					DATAFORM 「네 수준으로 나 같은 애들이랑 장난 치면 안 돼.」
					DATAFORM 「야, 이쪽을 봐! 어디 보고 있는 거야? 난 여기 있었어!」
				ENDDATA
			ELSE
				PRINTDATAL
					DATAFORM 「적어도 이것들은 피할 수 있겠지, 맞지?」
					DATAFORM 「자, 그럼 네 실력을 한번 보자.」
					DATAFORM 「더 많이 날아간다! 자, 힘내!」
					DATAFORM 「아직 끝나지 않았어!」
					DATAFORM 「내가 온다!～ 쾅-쾅!」
					DATAFORM 「자, 계속 움직여! 정신 바짝 차리고 전부 피해!」
					DATAFORM 「그것에 홀리지 마! ...자, 힘내!」
				ENDDATA
			ENDIF
			PRINTDATAL
				DATAFORM 「웨이브 사인! 홍안 최면 (마인드 체이커)!」
				DATAFORM 「환각파! 홍안 최면 (마인드 블로잉)!」
				DATAFORM 「광기인의 징조! 환각 조율 (비전리 튜닝)!」
				DATAFORM 「광기의 응시! 광기 어린 시선 조율 (환각 추적자)!」
				DATAFORM 「게으름의 징조! 생명과 정신 정지 (아이들링 웨이브)!」
				DATAFORM 「나태! 생명과 정신 정지 (마인드 스토퍼)!」
				DATAFORM 「확산의 징조! 진실의 달 (보이지 않는 보름달)!」
				DATAFORM 「월광의 눈! 월광 토끼의 원격 최면술 (텔레-최면술)!」
			ENDDATA
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;#; PRINTFORML FINDELEMENT(nTargetPresent, [[永琳]]) - {FINDELEMENT(nTargetPresent, [[永琳]])}
				;怒り
				IF nReisenPissedOff
					PRINTFORMW 「보이는군...」
					PRINTFORMW 「뭐, 적어도 완전히 만만한 상대는 아니군...」
					PRINTFORMW 「드디어 진지해질 좋은 구실을 찾았어!」
					PRINTFORMW 「흐릿한 유령달의 응시(Lunatic Red Eyes)!」
					PRINTFORML
					PRINTFORMW 「모든 것을 보고, 모든 것을 듣는다! 개방 후에 개방이 이어지고! 약점 후에 약점이 이어진다!」
					PRINTFORMW 「후후후... 자, 이제 나를 즐겁게 해 주시지.」
					PRINTFORML
					PRINTFORMW 「이 토끼의 눈을 바라보면서 정신을 붙잡고 있을 수 있을지 궁금하군?」
					HANDICAP_FIXED *= 2
				ELSEIF FINDELEMENT(nTargetPresent, [[永琳]]) != -1
					PRINTFORMW 「이 정도는… 마스터께서 하실 때에 비하면 아무것도 아니지!」
					PRINTFORMDW 당신은 에이린이 어색하게 웃고 있는 것을 알아차린다.
				ELSE
					PRINTDATAL
						DATAFORM 「그냥 흠집 정도야... 난 아직 에너지가 넘쳐!」
						DATAFORM 「여기서 훨씬 더 어려워질 테니, 준비해둬!」
						DATAFORM 「몸풀기엔 충분했어. 자, 그럼 내가 진정으로 뭘 할 수 있는지 보여주지!」
						DATAFORM 「후후, 좀 성장했나 보네?」
						DATAFORM 「흐음~, 조금 더 빠르게 움직여야겠어.」
					ENDDATA
				ENDIF
			CASE 1
				;怒り
				IF nReisenPissedOff
					PRINTFORML 「크윽...! 아직이야! 나는 인간에게 다시는 지지 않을 거야!」
					PRINTFORML 「이것이 마지막 저항이다! 전력으로 간다! 너와 나, 해보자고!」
				ELSE
					PRINTDATAL
						DATAFORM 「아얏...! 아-아야, 이제 네가 해버렸구나!」
						DATAFORM 「나 진심으로 임하고 있다고 생각했는데! 무슨 일이야...」
						DATAFORM 「한 번만 더 하면 너의 전적이 하나 늘어날 거야! 그건 안 돼!」
						DATAFORM 「이걸로 끝난 게 아니야! 아직은 아니라고! 난 아직... 움직일 수 있어!」
					ENDDATA
				ENDIF
				;reinforcements
				IF !RAND:10
					PRINTFORML
					PRINTFORMD 갑자기 
					SELECTCASE RAND:11
						CASE 0 TO 5
							PRINTFORMDW 신묘마루가 레이센 근처에 나타나 %HIM_HER(TARGET)%을 도와준다!
							CALL CHARA_TEXT([[針妙丸]], "『당장 이 괴롭힘을 그만둬! 내가 지원해 줄게!』", "w")
							CALL CHARA_TEXT([[針妙丸]], "『함께라면 훨씬 더 크게 만들 수 있어!』", "w")
							PRINTFORMW 「와! 그래, 해보자!」
							CALL CHARA_TEXT([[針妙丸]], "『미친 망치 신호! 광인의 응시 환상(혼란의 눈)도 더 커진다!』", "w")
						CASE 6 TO 9
							PRINTFORMDW 모코우가 라이젠 근처에 나타나 %HIM_HER(TARGET)% 손을 내민다!
							CALL CHARA_TEXT([[妹紅]], "『좀 고생하는 것 같아서 눈에 띄었어...』", "w")
							CALL CHARA_TEXT([[妹紅]], "『좀 바삭하고 온도를 더 해보는 건 어때?』", "w")
							PRINTFORMW 「불과 광기라니... 재미있을 것 같아!」
							CALL CHARA_TEXT([[妹紅]], "『화염 광기 사인! 인간 연소 은닉 탄막(타오르는 숨겨진 탄환)!』", "w")
						CASE 10
							PRINTFORMDW 에린이 라이젠 근처에 나타나 %HIM_HER(TARGET)% 도움을 준다!
							CALL CHARA_TEXT([[永琳]], "『레이센.』", "w")
							PRINTFORMW 「마스터?」
							CALL CHARA_TEXT([[永琳]], @"『보여주기 %HIM_HER(MASTER,,1)%.』", "w")
							PRINTFORMW 「뭐... 할 수 있나?」
							CALL CHARA_TEXT([[永琳]], "『그래. 이번 한 번만 허락해주지.』", "w")
							PRINTFORMW 「오... 하, 하하... 물론이지! 오랜만이지만 아직 할 수 있을 것 같아!」
							PRINTFORMDW 리젠이 거대한 기관단총을 만들어 당신에게 겨눈다...
							PRINTFORMDW 잠깐, 뭐야?!
							PRINTFORMW 「이건... 개발 중이라 아직 제대로 된 이름이 없어.」
							PRINTFORMW 「일단은 '배리지 SMG'라고 부르도록 하지!」
							PRINTFORMDW 브르르트!
							PRINTFORMDW 미친 듯한 투사체 세례가 전 지역을 뒤덮는다! 그것들은 매우 혼란스러운 방식으로 사방으로 날아간다!
							PRINTFORMDW SMG...? 오히려 미니건 같군.
					ENDSELECT
					HANDICAP_FIXED *= 2
				ENDIF
			CASE 0
				;怒り
				IF nReisenPissedOff
					PRINTFORML 「하아, 하아... 치정이라니... 이렇게 해도 너를 이길 수 없구나...」
					PRINTFORML 「역시 그랬어... 나는 그저 쓸모없는 작은 토끼일 뿐이야... 그리고 나머지는 알겠지.」
				ELSE
					PRINTDATAL
						DATAFORM 「아... 이게 패배의 맛인가? 생각보다 별로 안 나쁘네.」
						DATAFORM 「벌써 끝난 건가? 하아...」
						DATAFORM 「뭐라고...? 내가 졌다고? 음... 잘했어.」
						DATAFORM 「내 모든 움직임과 기교들이... 충분하지 않았던 모양이네.」
					ENDDATA
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		PRINTFORML 「수단이 다 떨어진 것 같군, 응? 무슨 일이야? 긴장했나?」
		PRINTFORML 「후후... 더 이상 네놈의 모욕을 용납하지 않겠다! 이제 끝을 볼 시간이다!」
		PRINTFORML 「준비해라. 왜냐하면... 보기 좋지는 않을 테니, 너에게는.」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF nReisenPissedOff
					PRINTFORMW 「상처 하나 없네... 아이한테 사탕 받는 기분이야.」
					SIF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼稚) && (TALENT:MASTER:体型 == -2 || TALENT:MASTER:体型 == -1)
						PRINTFORMW 「...어찌 되었든 너는 결국 아이였구나. 이제 그렇게 괴롭힌 내가 미안해지네.」
				ELSE
					PRINTDATAL
						DATAFORM 「너는... 오늘 놀라울 정도로 약하군. 이치란에 한번 들러봐, 내가 제대로 고쳐줄게.」
						DATAFORM 「광기가 너를 집어삼킨 모양이군... 불가능한 결과는 아니지.」
						DATAFORM 「그냥 움직이고 빨리 했으면 됐는데... 나는 네 수준을 훨씬 벗어나 있겠어.」
					ENDDATA
				ENDIF
			CASE 2
				;怒り
				IF nReisenPissedOff
					PRINTFORMW 「모든 것이 당신 뜻대로 되지 않을 수 있다는 것을 기억해 두어라.」
					PRINTFORMW 「네 자리를 알아두거라, 내가 너를 가르겠지만... 모욕에 관해서는 말이다.」
					SIF FINDELEMENT(nTargetPresent, [[永琳]]) != -1
						PRINTFORMDW 당신은 영림이 무슨 이유에선지 홍당무를 보는 것을 본다. 그녀가... 레이스에게 그 대사를 가르쳤나?
				ELSE
					PRINTDATAL
						DATAFORM 「아직 갈 길이 멀군... 다음 기회에나.」
						DATAFORM 「끝까지 해보지 않았지, 그렇지? 다음엔 절대 망설이지 마.」
						DATAFORM 「대충 하는 건 어디 가서 인정 못 받아. 지금은 내 승리지만, 너는 더 잘할 수 있어.」
					ENDDATA
				ENDIF
			CASE 1
				;怒り
				IF nReisenPissedOff
					PRINTFORMW 「하! 네가 당할 만하지!」
					CALL PRINT_DIALOGUE, @"무슨 이유에서인지는 모르겠지만... 네가 마땅히 얻은 승리임에도 불구하고, 나는 기뻐하지 못하겠다...", "w"
					PRINTFORMW 「이리 와, 일어나 봐. 잘 해냈어.」
					PRINTFORMDW 라이젠이 당신에게 손을 내밀고 일어서도록 도와준다.
					PRINTFORMW 「가끔 이렇게 운동하는 것도 좋네.」
					PRINTFORMDW %HE_SHE(TARGET,1)%은(는) 미소 지으며 말한다.
					IF MARK:反発刻印 >= 1
						PRINTFORMW 「너와의 불화에 관해서는... 이제 없던 일로 해두지. 하지만 조금은 있긴 하다. 다음엔 좀 예의를 갖춰주길 바랄게, 알았지?」
						PRINTFORMW 「사소한 원한을 오래 품고 싶지는 않아... 정신 건강에 안 좋으니까.」
						CALL COLORMESSAGE("라이젠의 증오 표식이 감소했다!",C_YELLOW,2,1)
						CALL COLORMESSAGE("하지만 완전히 녹아내린 기분이다. (-1000 STA, -1000 ENE)",C_YELLOW,2,1)
						MARK:反発刻印 --
						BASE:MASTER:体力 -= 1000
						BASE:MASTER:気力 -= 1000
					ELSE
						PRINTFORMW 「생각보다 상쾌했다... 이제 훨씬 기분이 좋아.」
					ENDIF
					CFLAG:ブチギレ = 0
					TALENT:機嫌 = 1
				ELSE
					IF RAND:2
						PRINTFORMW 「이봐...!」
						PRINTFORMW 「하아, 인정하지, 너 나쁘지 않아, 전혀 안 나빠.」
						PRINTFORMW 「네가 *이것*만큼만 더 필요했다면 난 이미 끝났을 거야.」
					ELSE
						PRINTDATAL
							DATAFORM 「휴, 결국 해냈어... 정말 아슬아팠군, 수고했어.」
							DATAFORM 「하아, 하아... 요새 인간들은 힘이 장사야, 그렇지 않아?」
							DATAFORM 「요즘 운동 부족을 탓해야겠어...」
						ENDDATA
					ENDIF
				ENDIF
			CASE 0
				;怒り
				IF nReisenPissedOff
					PRINTFORMW 「믿을 수가 없어...! 어떻게 네게 지다니?! 하아...」
					PRINTFORMW 「나는 완전한 실패자야! 내가 여기에 오게 된 건 당연해, 나는 구원받을 수 없는 존재니까!」
				ELSE
					PRINTDATAL
						DATAFORM 「크윽, 아팠어... 그래도 거기선 참았지? 대단해!」
						DATAFORM 「정말 재미있었어... 내 실력을 더 연마해야 할 것 같아.」
						DATAFORM 「부정행위는 안 했을 거라고 믿고 싶지만... 설령 그랬다 해도, 수고했어.」
						DATAFORM 「인간에게 지는 건 좀... 창피해지는 기분이야. 축하해.」
					ENDDATA
				ENDIF
				IF HANDICAP_FIXED >= 10
					PRINTFORML
					PRINTFORMDW 라이젠은 놀라울 정도로 강했다...
					PRINTFORMDW 앞으로의 만남을 위해 많은 유용한 기교를 배웠다고 느낀다.
					LOCAL = LIMIT((HANDICAP_FIXED / 10) * 3, 1, 50)
					CALL COLORMESSAGE(@"전투경험+{LOCAL}",C_YELLOW,2,1)
					EXP:MASTER:戦闘経験 += LOCAL
					PRINTFORMDW 라이젠도 꽤 많은 것을 배운 것 같았다.
					EXP:戦闘経験 += LOCAL*2
				ENDIF
		ENDSELECT
		PRINTFORML
		PRINTFORMDW 싸울 때 정말 완전히 다르네, 리센?
		PRINTFORMDW 리센은 %HIS_HER(TARGET)% 얼굴로 아무 표정 없이 서 있었다.
		PRINTFORMDW 리센? 리센...?
		PRINTFORMDW 네가 반복해서 %HIM_HER(TARGET)%를 부르자, %HE_SHE(TARGET)%는 갑자기 예전 모습으로 돌아왔다.
		PRINTFORMW 「아, 음, 뭐지?」
		PRINTFORMW 「아, 미안... 선을 좀 넘었나 봐... 에헤헤.」
		PRINTFORMDW 리센은 %HIS_HER(TARGET)%의 뺨을 긁으며 홍당무처럼 빨개졌다.
		PRINTFORMDW 그리고 %HE_SHE(TARGET)%가 다시 돌아왔다... 이 귀여운 토끼가 방금 전까지만 해도 너를 완전히 박살 내고 있었다는 게 믿기지 않는다.
		;clear variables
		nPower = 0
		nGoneMad = 0
		nReisenPissedOff = 0
		VARSET nTargetPresent
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
;based on @AssembleForMeal

@K52_WATCHFIGHT, nEligibleWatchers
#DIM 集合, キャラクタ数上限, 3 ;集合:X:Y
#DIM 人数                      ;同一マップにいる人数、移動できないキャラも表示され、人数に加算されている
#DIM 入力値                    ;RESULT取得用
#DIM C_ID
#DIM REF nEligibleWatchers
SIF CFLAG:MASTER:現在位置 == OMANEKIBEYA()
	RETURN
SIF !AT_HOME(MASTER)
	RETURN
SIF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置
	RETURN
SIF PRIVATEROOM:(CFLAG:MASTER:現在位置 % 100)
	RETURN
CALL SYUGOS_GETDATA(人数, 集合)
CALL SYUGOS_COST(人数, 集合)
FOR LOCAL, 0, 人数
C_ID = 集合:LOCAL:0
SIF GETBIT(集合:LOCAL:1, 0)
	CONTINUE
;移動回数が多いと除外
SIF 集合:LOCAL:2 > 6
	CONTINUE
SIF CFLAG:C_ID:ブチギレ
	CONTINUE
SIF FINDELEMENT(nEligibleWatchers, C_ID) == -1
	CONTINUE
CFLAG:C_ID:現在位置 = CFLAG:MASTER:現在位置
PRINTFORMDL 레이센이 싸우는 것을 보려고 %CALLNAME:C_ID%가 온다.
NEXT
CALL TARGETSET_CHACK
PRINTFORMW 
