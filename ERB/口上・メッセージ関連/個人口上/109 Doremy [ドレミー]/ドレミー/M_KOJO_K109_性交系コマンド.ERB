@M_KOJO_MESSAGE_COM_K109_70_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;アナル処女
		IF TCVAR:Ａ破瓜
			PRINTFORMW 「흥미가 없다고 하면 거짓말이겠지만……」
			PRINTFORMDW 이미 세정을 마친 도레미는 네 발로 기며 %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 보이고 있다.
			PRINTFORMDW 두 손으로 그녀의 엉덩이살을 벌리자, 색소조차 침착되지 않은 미사용의 항문이 그 존재를 주장하고 있었다.
			PRINTFORMW 「저, 저렇게 자세히 쳐다보지 말아 주세요……읏」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그녀의 항문에 얼굴을 가까이 가져가 구멍 주변을 핥았다.
			CALL HPH_PRINT,@"「큭…… HPH라니, 더럽잖아요……! HPH」","W"
			PRINTFORMDW 마치 여성의 음부를 맛보듯, 도레미의 불결한 구멍을 세심하게 애무한다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 혀를 넣자, 그녀는 들어온 혀를 거부하듯 조여온다.
			CALL HPH_PRINT,@"「하아앗 HPH...응음... 언제까지, 핥고 있는 거예요... HPH」","W"
			PRINTFORMDW 혀를 빼자, 타액으로 축축해진 항문은 작은 구멍을 느슨하게 만들며 어딘가 아쉬운 듯 움츠리고 있다.
			PRINTFORMDW 준비가 되었다고 판단한 %조사처리(CALLNAME:MASTER,"는")% 뒤에서 그녀를 안아 올리더니 얕게 삽입하며 성기를 익숙하게 만들었다.
			CALL HPH_PRINT,@"「흐윽! 흐응... 빨리, 끝내줘...!」","W"
			PRINTFORMDW 축축하게 몇 번이고 넣었다 빼기를 한 후, 그녀의 요구에 응하며 천천히 허리를 움직인다.
			CALL HPH_PRINT,@"「응응! HPH... 아아... 후, 흐읍! HPH... 굉장해, 깊숙이... HPH」","W"
			PRINTFORMDW 꽉 벌어진 항문은 삽입되어 들어오는 음경을 기쁘게 받아들이고 있다.
			PRINTFORMDW 뜨거운 장내는 음경에 달라붙으며 정액을 짜내려는 듯 자극을 주고 온다...
			CALL HPH_PRINT,@"「후우우 HPH... 의외로, 괜찮을지도……!! HPH」","W"
			PRINTFORMDW 가장 깊숙이 삽입하고 서로의 살이 밀착하자 %조사처리(CALLNAME:MASTER,"는")% 도레미의 얼굴을 이쪽으로 향하게 하여 가볍게 키스했다.
			CALL HPH_PRINT,@"「하아... 하아... 후으읏! 후으읏... 후으윽...」","W"
			PRINTFORMW (그러고 보니... 엉덩이를 핥았던 입으로... 뭐, 괜찮겠지...)
			RETURN 1
		ELSE
			CALL DOREMY_SEX
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		IF ABL:Ａ感覚 >= 4
			;今射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앗 흐읍…… 으응흐윽 흐읍 기다려…… 흐읍」","L"
						PRINTFORMDL 정액이 차오르는 감각에 자제력이 풀려 허리를 치는 속도를 올린다.
						PRINTFORMDL 격렬하게 항문을 문질러 오는 쾌감에, 도레미는 온몸을 파르르 떨며 입가에 침을 흘리고 있다...
						CALL HPH_PRINT,@"「하, 아앗! 후우욱...~~~~윽! 하프 하프 하프」","L"
						PRINTFORMDW 사정의 순간, 허리가 밀착될 정도로 박아 넣자 도레미는 가랑이에서 정액을 흘리며 절정에 달했다...
					CASE 1
						CALL HPH_PRINT,@"「더 깊이 박아줘도 괜찮아요... 큭! 아앗, 후으윽」","L"
						PRINTFORMDL 도레미는 이쪽의 뺨에 손을 대며 음란한 표정을 지으며 격렬하게 해달라고 요구한다.
						PRINTFORMDL 사정이 가까워진 %조사처리(CALLNAME:MASTER,"는")% 그녀의 바람대로 짐승처럼 허리를 흔든다…
						CALL HPH_PRINT,@"「으윽! 그거, 안에 사정해줘……~~ 헉 헉 헉」","W"
					CASE 2
						CALL DOREMY_SEX
				ENDSELECT
				RETURN 1
				;前回射精した
			ELSEIF TCVAR:104
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「하후……응큿! 하프……엉덩이 구멍…… 그렇게 마음에 드셨어요…? 하프」","L"
						PRINTFORMDL 잠시 연결된 채 숨을 가다듬은 후, %조사처리(CALLNAME:MASTER,"는")% 다시 허리를 움직이기 시작했다.
						PRINTFORMDW 희뿌옇게 미끄러운 항문은, 육봉이 왕복할 때마다 움찔거리며 환희에 차 음경을 물고 있다……
					CASE 1
						CALL HPH_PRINT,@"「응응! 후우…… 벌써… 엉덩이가 흐물흐물해지면 어떡해요…… 후우」","L"
						PRINTFORMDL '배설'이 끝난 후에도 시들지 않는 페니스로 항문을 관통한 채, 허리를 스트로크하며 나아간다.
						PRINTFORMDL 도레미의 항문은 교감을 거듭할수록 육봉의 굵기에 익숙해지고 있다...
						PRINTFORMDW 자신만의 육구(肉穴)가 완성된 것에 만족한 %조사처리(CALLNAME:MASTER,"는")% 그녀의 엉덩이를 쓰다듬으며 피스톤의 속도를 높여갔다.
					CASE 2
						CALL DOREMY_SEX
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앙! 흐응... 꼬리, 비벼줘... 흐응」","L"
						PRINTFORMDL 느릿한 허리 움직임으로 도레미의 장내를 음미하고 있자, 그녀가 꼬리를 흔들며 애원해 왔다.
						PRINTFORMDL 요구에 응하여 움찔거리며 떨리는 꼬리를 부드럽게 깨물면서 마사지하듯 애무해 주었다...
						CALL HPH_PRINT,@"「하아아앗 흐읍 흐읍 흐읍 대박, 기분 좋아읏 흐읍」","W"
					CASE 1
						CALL HPH_PRINT,@"「응! 후으…… 어앗! 응, 꼭 안아줘……읏」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미의 상체를 끌어안고 느긋하게 허리를 움직인다.
						PRINTFORMDL 서로의 체액이 섞여 결합부에서 거품이 이는 것이 보인다.
						CALL HPH_PRINT,@"「쪽…… HPH 상냥한 것도 좋네요……. HPH 아앗 HPH」","W"
