@M_KOJO_MESSAGE_COM_K109_95
CALL M_KOJO_MESSAGE_COM_K109_95_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_95_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;処女か無自覚非処女の場合
	IF LOCAL:1 && TFLAG:194
		;欲情が高い場合の分岐
		IF TFLAG:194 == 2
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;非処女
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 
			RETURN 1
			;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
