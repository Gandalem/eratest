; Modular ERB: 個人口上/109 Doremy [ドレミー]/ドレミー/M_KOJO_K109_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K109_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF TALENT:妊娠
			PRINTFORML 「……본심인가요?」
			PRINTFORMDL 도레미는 걱정스러운 듯 부푼 배를 쓰다듬는다.
			PRINTFORMW 「…뭐, 좋은 태교가 될지도 모르겠네요. 자, 갑니다」
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「그 광몽, 제가 처리해 드릴게요」
				CASE 1
					PRINTFORMW 「당신의 평온은 지금 만들어진다」
				CASE 2
					PRINTFORMW 「꿈을 먹고, 꿈을 창조하는 나에게 대적할 수 있다고 생각하지 마라!」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「아직 멀었어요」
						PRINTFORMW 「코쵸 '나비 식민지화'!」 
					CASE 1
						PRINTFORML 「피해낼 수 있겠어요?」
						PRINTFORMW 「초특급 '드림 익스프레스'!」
				ENDSELECT
			CASE 2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「이걸로 밀어붙인다」
						PRINTFORMW 「양부 『나이트메어 오브 키메라』!」 
					CASE 1
						PRINTFORML 「아무래도 평범한 인간은 아닌 것 같아」
						PRINTFORMW 「하유메 '크리핑 버렛'!」
				ENDSELECT
			CASE 1
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「꿈의 결말 요인으로 무리한 요구를 받는 나의 괴로움, 마음껏 느껴 보란 말이야!」
						PRINTFORMDL 한심한 자 같으니!!
						PRINTFORMW 「뭐라고!!」
					CASE 1
						PRINTFORMW 「아무래도 당신에게는 내가 모르는 힘이 갖춰져 있는 것 같네요...」
						PRINTFORMDL 알 리가 없어! 탄막 놀이를 하고 있는 도레미한테…
						PRINTFORMDW 이, 내 몸을 통해 나오는 힘이라니! 
						PRINTFORMW 「몸을 통해 나오는 힘...? 그런 걸 가지고 탄막 놀이에 이길 수 있을 리가 없잖아!」
				ENDSELECT
			CASE 0
				PRINTFORMW 「……여기까지의 악몽, 전부 처리해 드렸어요」 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORMW 「불쌍하네…… 강하게 살아줘……」
			CASE 3
				PRINTFORMW 「무모하게 돌진해서 이길 수 있는 건 아니에요」
			CASE 2
				PRINTFORMW 「익숙해진 것 같네요」
			CASE 1
				PRINTFORMW 「아까는 아슬아팠네요」
			CASE 0
				IF TALENT:妊娠
					PRINTFORML 「하아... 하아...」
					PRINTFORMDL 도레미는 심하게 소모된 듯하다...
					PRINTFORMW 「배에 아기가 있잖아요... 조금만, 살살 해줘...」
				ELSE
					PRINTFORMW 「%MASTERNAME:109%라면 광몽조차 제압할 수 있을지도 모르겠네요」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
