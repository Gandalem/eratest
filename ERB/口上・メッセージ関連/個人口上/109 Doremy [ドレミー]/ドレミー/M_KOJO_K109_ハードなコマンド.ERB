;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K109_150
CALL M_KOJO_MESSAGE_COM_K109_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「아앗 흐응, 그렇게 거칠게……읏흐으」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미의 가슴을 끌어올리듯 움켜쥐고, 탱탱하게 허리를 때린다.
				PRINTFORMDW 동시에 손가락으로 유두를 주무르자, 도레미는 거칠게 가슴을 범당하고 있음에도 불구하고 녹아내리는 표정을 지으며 『사용되는』 행복에 몸을 떨었다.
			CASE 1
				CALL HPH_PRINT,@"「이제 HPH는 말 잘 들어줘야죠~ HPH」","L"
				PRINTFORMDL 도레미는 마치 장난꾸러기를 꾸짖는 듯한 말투로 봉사를 이어간다.
				PRINTFORMDW 버릇을 고치듯 도레미가 가슴을 꾹 밀어 올리자, 자극 전체가 살의 바다에 압박되는 쾌감에 %조사처리(CALLNAME:MASTER,"는")% 저도 모르게 신음을 터뜨렸다.
			CASE 2
				CALL HPH_PRINT,@"「응으윽 HPH 가슴 세게 잡으면 안 돼요……! HPH」","L"
				PRINTFORMDL 가슴으로 단단한 것을 만져지는 쾌감에 나도 모르게 도레미의 가슴을 움켜쥐고 만다.
				PRINTFORMDL 도레미는 입으로는 저항하고 있지만, 어딘가 기쁜 듯하다…….
				CALL HPH_PRINT,@"「흐느적거리며 내 가슴에 카우퍼를 비벼대다니... 어쩔 수 없는 사람이네에... HPH」","L"
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		CALL AUTO_AEGI(NO:TARGET)
		RETURN 1
	ENDIF
ENDIF
RETURN 1
