;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K109_140
CALL M_KOJO_MESSAGE_COM_K109_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORML 「목구멍 깊숙한 곳까지…… 그런 건…… 컥!?」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 반항할 틈도 주지 않고 목구멍 깊숙이 파고들었다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「흐윽…… 크으윽 HPH」","L"
				PRINTFORMDL 사정이 가까워지고 목구멍 깊숙이 밀어 넣는 속도가 빨라지자 도레미는 눈물과 콧물로 얼굴을 범벅으로 만들며 구토한다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 슬슬 사정할 거라고 선언하자, 도레미는 온몸의 힘을 빼고 받아들이는 자세를 취했다.
			CASE 1
				CALL HPH_PRINT,@"「흐으윽! 흐읍... 흥음... 흐읍」","L"
				PRINTFORMDL 도레미를 염려할 여유조차 없어진 %조사처리(CALLNAME:MASTER,"는")% 그저 필사적으로 목구멍 깊숙이 육봉을 밀어 넣는다.
				PRINTFORMDW 위가 뒤집히는 듯한 감각의 연속에 도레미는 그저 견딜 수밖에 없다...
			CASE 2
				CALL HPH_PRINT,@"「흐윽, 으응... 끄윽... 헉! 하아앗」","L"
				PRINTFORMDL 쿠퉤, 쿠퉤 하고 마치 온나호처럼 도레미의 목구멍을 범하고 있다.
				PRINTFORMDW 사정이 가까워진 %조사처리(CALLNAME:MASTER,"는")% 배출을 향해 허리를 흔드는 속도를 높였다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「윽 HPH… 후우…… 흐윽 HPH」","L"
				PRINTFORMDL 도레미는 마치 물건처럼 취급당하는 것에 이상한 희열을 느끼고 있었다.
				PRINTFORMDW 그런 모습을 알았는지 모르겠는지, %조사처리(CALLNAME:MASTER,"는")% 도레미에게 시선을 주지 않고 그저 목구멍 깊숙이 밀어 넣었다.
			CASE 1
				CALL HPH_PRINT,@"「우으윽!?…후욱 HPH…컥…후욱 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미를 밀쳐 쓰러뜨리고 얼굴에 올라타, 마치 바닥에서 자위하듯 목구멍 깊숙이 육봉을 찔러 넣었다.
				PRINTFORMDW 도레미는 처음에는 %조사처리(CALLNAME:MASTER,"의")% 엉덩이를 붙잡고 발버둥 쳤지만, 이내 조용해졌다…
			CASE 2
				CALL HPH_PRINT,@"「크으윽... 아앗, 큭, 크아악 HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미의 머리를 단단히 붙잡고, 자신만이 기분이 좋아지기 위해 목구멍을 범해 나간다.
				PRINTFORMDW 기분 좋게 침을 흘리는 %조사처리(CALLNAME:MASTER,"의")% 모습을 본 도레미는 가슴이 축축해지고 자궁이 저릿했다...
		ENDSELECT
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「흡…… 컥, 크윽, 아아읍……」
				PRINTFORMDL 목구멍 깊은 곳을 범당한 도레미가 구토하지만, 식도 입구는 육봉이 빈틈없이 막고 있어 위액 한 방울조차 통과할 틈이 없다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 도레미의 머리를 쓰다듬으며 성기를 빼내자, 순식간에 다시 박아 넣었다.
			CASE 1
				PRINTFORML 「응응읏…앗…고, 앗…」
				PRINTFORMDL 도레미는 죽은 개구리 같은 신음을 내뱉으며 목구멍에 가해지는 폭력에 견디고 있다.
				PRINTFORMDW 조임이 약하다고 생각한 %조사처리(CALLNAME:MASTER,"가")% 목을 확 움켜쥐자, 도레미는 반쯤 흰 눈을 드러내며 손을 축 늘어뜨렸다.
			CASE 2
				PRINTFORML 「윽……!」
				PRINTFORMDL 도레미는 목에 박힌 물건의 충격에 눈을 크게 뜨고 경직해 있었다.
				PRINTFORMDW 가학심이 샘솟은 %조사처리(CALLNAME:MASTER,"가")% 코를 막자, 숨이 막힌 도레미는 허둥지둥 몸부림쳤다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「끄, 으윽…… 부, 큭…」
				PRINTFORMDL 도레미는 목구멍 깊숙이 밀려들어 온 성기에 눈을 동그랗게 뜨고 있다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그런 도레미의 모습을 보고 잠시 속도를 늦추었다.
			CASE 1
				PRINTFORML 「부에엣... 응긋... 응크...」
				PRINTFORMDL 불시에 목구멍 깊숙이 밀어 넣자, 도레미는 돼지 같은 소리를 내며 몸을 움찔 떨었다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그 모습을 만족스럽게 미소 지으며 피스톤을 재개했다...
			CASE 2
				PRINTFORML 「오엣…얏…구욱…」
				PRINTFORMDL 난폭한 삽입에 항의하려던 도레미의 식도에 음경을 밀어 넣어 봉쇄한다.
				PRINTFORMDW 식도벽에 귀두를 비비듯 빼내자, 도레미는 콧물을 흘리며 구토했다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
