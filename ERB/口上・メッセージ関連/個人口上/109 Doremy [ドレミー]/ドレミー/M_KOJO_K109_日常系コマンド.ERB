@M_KOJO_SUCCESS_COM_K109_303
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K109_303
RETURN 0

@M_KOJO_MESSAGE_COM_K109_303
CALL M_KOJO_MESSAGE_COM_K109_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;判定
	SELECTCASE TFLAG:193
		;成功
		CASE 0
			PRINTFORML 「뭐, 머리도 식은 모양이니까……」
			PRINTFORML 「알겠어요. 당신을 용서할게요」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 용서해 주었다. 이걸로 악몽을 꾸지 않아도 될 것 같아……
			;大成功
		CASE 1
			PRINTFORML 「후후후, 악몽이라도 꾼 듯한 얼굴로」
			PRINTFORML 「그렇게 제가 무서웠던 건가요?」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 평소의 태세로 돌아온다.
			PRINTFORMDW 겨우 악몽에서 벗어날 수 있었다. 당신은 안도하며 숨을 내쉬었다……
			;菓子折成功
		CASE 2
			PRINTFORML 「맛있어 보이는 과자네요」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 과자상자 속에서 쿠키를 하나 집는다
			PRINTFORML 「차 마시는 시간을 갖도록 하죠. 이야기 정도는 들어줄 수 있어요」
			PRINTFORMDL 붙잡기는 성공이다. 당신은 차를 우리는 데 급히 달려나가기 시작했다……
			PRINTFORMW 「……후훗」
			;失敗
		CASE -1
			PRINTFORML 「――나에게 사과하고 싶어?」
			PRINTFORML 「음, 대체 무슨 일인지……」
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 수첩에 시선을 고정한 채 이쪽을 보려 하지 않는다.
			PRINTFORMDW ……상당히 화가 난 것 같다.
			;菓子折失敗
		CASE -2
			PRINTFORML 「――받아줄래?」
			PRINTFORML 「사과는 됐으니까, 부디 신경 쓰지 마」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 아무것도 해줄 수 없어……
	ENDSELECT
ENDIF
RETURN 1
