@M_KOJO_MESSAGE_COM_K109_334_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;判定
	SELECTCASE TFLAG:193
		;大成功
		CASE 1
			;恋慕
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「2차회는 꿈의 세계에서 해요」
						PRINTFORML 「누구에게도 방해받지 않는 곳에서…… 둘만, 응?」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 그렇게 귓속말을 건넨다
						PRINTFORMDW 주변 참가자들에게 보이지 않도록 두 사람은 입맞춤을 나누었다
						CALL MUTUAL_KISS ;custom code
					CASE 1
						PRINTFORML 「응쿠윽…… 응쿠윽…… 푸하, 하아앗」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"의")% 마시는 솜씨에 주위에서 환호성이 터진다.
						PRINTFORMDW 이렇게 많이 마셔도 괜찮을까……?
					CASE 2
						PRINTFORML 「――조금 너무 과음한 거 아닐까……?」
						PRINTFORML 「아니에요, 아니에요, 그런 건……」
						PRINTFORMDL 그렇게 말하며 옷을 벗어가는 %CALLNAME:TARGET%
						PRINTFORMDW 속옷 차림이 되기 전에 당신은 황급히 %조사처리(CALLNAME:TARGET,"를")% 막았다
				ENDSELECT
				;思慕
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「어라, 그거 큰일이네……」
						PRINTFORMDL 술에 취해 말이 많아진 당신은 %조사처리(CALLNAME:TARGET,"에게")% 푸념을 쏟아냈다.
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 맞장구를 치며 당신의 이야기를 듣고 있다…….
					CASE 1
						PRINTFORML 「한 잔 더 드시겠어요?」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 권하는 대로 술을 들이킨다.
						PRINTFORMDW 어느새 입장이 역전되어 있었지만, 술에 취한 당신은 개의치 않았다.
					CASE 2
						PRINTFORML 「헉…… 하고, 실례할게요」
						PRINTFORML 「하아…… 좀 너무 많이 마셨네요」
						PRINTFORMDW 귀여운 딸꾹질이다. 볼이 새빨개진 %조사처리(CALLNAME:TARGET,"의")% 머리를 당신은 톡톡 쓰다듬었다.
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「호오후……이것은 이것인가……」
						PRINTFORMDL 맛있는 요리와 술에 취해 있는 %조사처리(CALLNAME:TARGET,"를")% 옆에서 바라본다.
						PRINTFORMDW 눈을 빛내는 그녀가 어딘가 귀여워서, 당신은 나도 모르게 입꼬리를 올렸다.
					CASE 1
						PRINTFORML 「알코올을 너무 많이 마시는 것은 주의해야 하지만……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 훅 술을 들이킨다.
						PRINTFORMW 「오늘은 이 정도는 괜찮겠지」
					CASE 2
						PRINTFORML 「있잖아, 당신은 연주를 잘한다고 들었어」
						PRINTFORML 「나에게 들려줄 수 없을까? 당신의 연주를」
						PRINTFORMDW 확실히 악기는 준비해 왔지만…… 어쩌지?
				ENDSELECT
			ENDIF
			;成功
		CASE 0
			;恋慕
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「여러분은 여전하시군요……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"와")% 함께 술을 마시며 회장의 분위기를 즐긴다
						PRINTFORMDW 주변은 매우 소란스러운데, 어째서인지 매우 차분하다
					CASE 1
						PRINTFORML 「이후에는…… 어떻게 할까요?」
						PRINTFORML 「――후후, 그렇네요. 밤바람을 맞으며……」
						PRINTFORMDL 맛있는 술을 마시며 이야기에 꽃을 피운다.
						PRINTFORMDW 이 시간을 %조사처리(CALLNAME:TARGET,"는")% 즐기고 있는 듯하다.
					CASE 2
						PRINTFORML 「후우……」
						PRINTFORMDL 조금 취했는지 %조사처리(CALLNAME:TARGET,"가")% 기대왔다
						PRINTFORMDW ……참석자들의 시선이 따갑다. 당신은 어색함을 감추려는 듯 술을 벌컥 들이켰다
				ENDSELECT
				;思慕
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「――건배」
						PRINTFORMDL 쨍, 하고 %조사처리(CALLNAME:TARGET,"와")% 잔을 맞댄다.
						PRINTFORMDW 술의 힘도 있을지 모르지만, 평소보다 %조사처리(CALLNAME:TARGET,"의")% 거리가 가깝다……
					CASE 1
						PRINTFORML 「가끔은 꿈의 세계 주민처럼, 마음을 해방하는 것도 나쁘지 않을지도 모르겠네요」
						PRINTFORMDL 따라진 술을 꿀꺽 들이키고 %조사처리(CALLNAME:TARGET,"가")% 숨을 내쉰다.
						PRINTFORMDW 알코올이 돌면서 살짝 홍조를 띤 뺨이 어쩐지 관능적이다……
					CASE 2
						PRINTFORML 「조금 열이 나기 시작했네요……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 파닥파닥 손으로 얼굴을 부채질하고 있다.
						PRINTFORMDW 얼굴에는 드러내지 않지만, 꽤 취해버린 걸까?
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「――섞으러 가지 않을 건가?」
						PRINTFORML 「괜찮습니다. 저는 구경하는 것을 좋아하기 때문에」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 즐겁게 음식을 먹고 마시는 참가자들을 상냥한 표정으로 바라보고 있다……
					CASE 1
						PRINTFORML 「음…… 후우…… 제법 좋은 술이네요」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 조금씩 술을 입에 머금고, 혀로 굴리며 맛보고 있다.
						PRINTFORMDW 그렇구나, 그런 마시는 법도 있는 거네……
					CASE 2
						PRINTFORML 「술에 취하면 나쁜 꿈을 꾸기 쉬워진다」
						PRINTFORML 「여러분, 상당히 취하셨네요. 오늘 밤은 바빠질 것 같습니다」
						PRINTFORMDW 참가자들을 바라보며, 당신과 %조사처리(CALLNAME:TARGET,"는")% 몇 마디 대화를 나누었다
				ENDSELECT
			ENDIF
			;失敗
		CASE -1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「요리를 가져올게요」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 잔을 내려놓고 테이블 쪽으로 가버렸다.
					PRINTFORMDW 지금 안에 화제를 생각해 둘까……
				CASE 1
					PRINTFORML 「――화제가 없나?」
					PRINTFORML 「우연이네요. 저도요」
					PRINTFORMDW 그렇다면 연회의 분위기를 즐기자. 당신은 비어있는 잔에 술을 따르고, %조사처리(CALLNAME:TARGET,"와")% 건배를 했다
				CASE 2
					PRINTFORML 「…………♪」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 와인이 담긴 잔을 빙글빙글 돌리고 있다.
					PRINTFORMDW 당신도 따라 해 보려고 돌려봤지만, 완전히 쏟고 말았다.
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
