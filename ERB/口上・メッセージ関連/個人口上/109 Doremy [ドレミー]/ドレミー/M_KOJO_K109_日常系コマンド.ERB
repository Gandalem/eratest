RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;お招き部屋でドレミーが恋慕じゃないorドレミーが睡眠中・衰弱中・あなたの部屋にお泊りの場合はこれ
	IF (!TALENT:恋慕 && CFLAG:MASTER:現在位置 == OMANEKIBEYA()) || (CFLAG:睡眠 || CFLAG:衰弱 || FLAG:一時滞在 == 109)
		PRINTFORML 「…………」
		PRINTFORMDL 도레미는 숨소리조차 내지 않고 조용히 누워있다.
		PRINTFORMDW 당신은 그런 그녀의 머리를 부드럽게 쓰다듬으며 눈을 감았다.
		;一緒に寝る
	ELSEIF CFLAG:MASTER:現在位置 == CFLAG:初期位置
		;判定
		SELECTCASE TFLAG:193
			;通常
			CASE 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「자, 슬슬 불을 끌게요」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 램프를 끄고 살며시 당신 옆에 누웠다
						PRINTFORMW 「――잘 자요. %MASTERNAME:109%」
					CASE 1
						PRINTFORML 「오늘은 어떤 꿈을 보여줄까……」
						PRINTFORMDL 너는 %조사처리(CALLNAME:TARGET,"가")% 나오는 꿈을 리퀘스트했다.
						PRINTFORML 「풋, 그 정도로 괜찮다면……. 기꺼이」
						PRINTFORMDW 잠에 빠지는 순간, 도레미는 몰래 이마에 키스했다.
					CASE 2
						PRINTFORML 「――어라, 잠이 오지 않으신가요? 그렇다면…… 쪽」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 취침의 키스를 하자, 당신의 의식은 스르륵 가라앉았다
						PRINTFORMW 「……좋은 꿈을 꾸세요. %MASTERNAME:109%」
				ENDSELECT
				;子供と一緒に川の字で寝る
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「이제 자야겠네요. 이 아이도 기다리고 있고」
						PRINTFORML 「어디냐면? 후후, 물론 꿈의 세계죠」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 깊이 잠든 %CHILDNAME:109:(TALENT:109:育児中)%의 머리를 쓰다듬고 있다.
						PRINTFORMW 「자, 자요. 안녕히 주무세요. %MASTERNAME:109%」
					CASE 1
						PRINTFORML 「자, 자, 시끄럽지 말아줘」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 좀처럼 잠들지 않는 %CHILDNAME:109:(TALENT:109:育児中)% 때문에 애를 먹고 있다.
						PRINTFORMDL 참을성이 바닥난 도레미가 꿈의 영혼을 얼굴에 밀어붙이자, %CHILDNAME:109:(TALENT:109:育児中)%는 순식간에 정신을 잃었다.
						PRINTFORML 「역시 이 손밖에 안 되네요…… 무슨 일이에요? 그런 표정으로」
						PRINTFORMDW 『아무것도 아니야…』 당신은 그저 그렇게 말하고 눈을 감았다.
					CASE 2
						PRINTFORML 「정말 잘 자는 아이네. %MASTERNAME:109%에게 닮은 걸까」
						PRINTFORMDL %CHILDNAME:109:(TALENT:109:育児中)%와 %조사처리(CALLNAME:MASTER,"는")% 부모자식 모두 침을 흘리며 코를 골고 있다
						PRINTFORMW 「후후, 그렇다면…… 장래에는 분명 큰 인물이 되겠네요」
				ENDSELECT
		ENDSELECT
		;それ以外
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「잘 자요? 그렇다면, 좋은 꿈을 꾸게 해드려야겠네요」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 마치 아이를 재우듯이 당신의 배를 토닥토닥 두드리고 있다.
					PRINTFORMDW 매우 안심이 된다. 아이 취급받는 부끄러움보다, 그 마음이 더 우세하다
				CASE 1
					PRINTFORML 「잘 자는 키스라도 해볼까?」
					PRINTFORMDL 간절히 부탁하자, %조사처리(CALLNAME:TARGET,"가")% 뺨에 쪼아대는 듯한 키스를 해주었다.
					PRINTFORML 「――안녕. 나중에 또 보자」
					PRINTFORMDW 당신이 잠든 것을 확인하고 나서, %조사처리(CALLNAME:TARGET,"는")% 자신의 일을 하러 꿈의 세계로 돌아갔다.
				CASE 2
					PRINTFORML 「자, 이제부터는 일하는 시간이다」
					PRINTFORMDL 함께 잠들어 있던 %조사처리(CALLNAME:TARGET,"가")% 몸을 일으킨다.
					PRINTFORML 「좋은 꿈을. 꿈의 세계에서도 지켜보고 있다, %MASTERNAME:109%」
					PRINTFORMDW 당신의 이마에 키스를 하자, %조사처리(CALLNAME:TARGET,"는")% 꿈의 세계 속으로 사라졌다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「잘 자. 좋은 꿈을 꾸렴」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 꿈의 세계로 돌아간다
					PRINTFORMDW 곧 다시 만나게 되겠지. 그런 생각을 하고 있는 사이에 당신의 의식은 꺼져 있었다
				CASE 1
					PRINTFORML 「벌써 주무시는 거예요?」
					PRINTFORML 「――이미 자고 있어요. 잠이 잘 오는 걸로요」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%「후훗」하고 미소 지으며, 당신의 꿈을 관찰하러 나갔다
				CASE 2
					PRINTFORML 「자, 오늘은 어떤 꿈을 꾸게 될지... 나에게 보여주겠니?」
					PRINTFORMDL 당신이 움찔하며 몸을 경직시키자, %조사처리(CALLNAME:TARGET,"가")% 부드럽게 이불을 덮어주었다.
					PRINTFORMW 「농담이야. 잘 자, %MASTERNAME:109%.」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
