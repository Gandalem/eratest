RETURN 0

@M_KOJO_MESSAGE_COM_K109_331
CALL M_KOJO_MESSAGE_COM_K109_331_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_331_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;失敗
	IF TFLAG:193 == -1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……죄송하지만, 지금은 목이 마르지 않아서요…」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(1)는 차에 손을 대지 않았다
			CASE 1
				PRINTFORML 「이런 건 별로 감동적이지 않네요」
				PRINTFORMDW 아무래도 눈치챈 모양이다
			CASE 2
				PRINTFORML 「약이 다 녹지 않았어요?」
				PRINTFORMDW 들통났잖아
		ENDSELECT
	ELSE
		IF TCVAR:[[ドレミー]]:媚薬 == 210
			PRINTFORML 「감사합니다. 하지만 이상한 맛의 차네요……」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 의심하고 있지만……이미 늦었다
			PRINTFORMW 「………」
			PRINTFORMW 「……%MASTERNAME:109%…사람 없는 곳에 가지 않겠습니까?」
			PRINTFORMW 「그게… 좀 도와줬으면 하는 일이 있어서요……」
			PRINTFORMW 「아니 정말로, %MASTERNAME:109%에게밖에 부탁할 수 있는 일이라서……」
			PRINTFORMW 「좋죠? 그렇죠? 뭔가 말해 주시면 어떨까요?」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 발정하고 말았다!
			TCVAR:[[ドレミー]]:発情 = 1
		ELSEIF TCVAR:[[ドレミー]]:利尿剤 == 210
			PRINTFORML 「왠지 화학 약품 같은 맛의 차네요...」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 목을 기울이고 있다.
			PRINTFORMW 「………」
			PRINTFORMW 「……저, 이런 걸 여쭤보는 건 실례지만…」
			PRINTFORMW 「그게, 근처에… 화장실 없나요?」
			PRINTFORMW 「에, 없어?... 아, 그렇구나...」
			PRINTFORMW 「아니에요, 아니에요. 없다면 괜찮아요」
		ELSEIF TCVAR:[[ドレミー]]:惚れ薬 == 210
			PRINTFORML 「제가 모르는 약선차 같은 건가요~」
			PRINTFORMDW 뭐 약이긴 할지도……
			PRINTFORMW 「………」
			PRINTFORMW (……이상하네요)
			PRINTFORMW (오늘 %MASTERNAME:109%는 유독… 남자로서, 아니에요)
			PRINTFORMW (남성으로서 매력적으로 느끼고 있는 내가 있다니……)
			PRINTFORMW (……이건… 뭔가 꾸며진 걸까……)
		ENDIF
	ENDIF
ENDIF
RETURN 1
