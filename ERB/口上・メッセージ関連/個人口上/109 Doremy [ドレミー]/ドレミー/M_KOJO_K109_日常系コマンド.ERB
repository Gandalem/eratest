@M_KOJO_MESSAGE_COM_K109_335_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;判定
	SELECTCASE TFLAG:193
		;大成功
		CASE 1
			;恋慕
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「응후후……♪」
						PRINTFORMDL 완전히 회복된 %조사처리(CALLNAME:TARGET,"가")% 스르륵 몸을 비비며 다가온다.
						PRINTFORMDW 귀여운 녀석 같으니. 네가 톡톡 머리를 쓰다듬어 주자, %조사처리(CALLNAME:TARGET,"는")% 응석 부리듯 목울림을 만들었다.
					CASE 1
						PRINTFORML 「지금부터 호텔에 갈까요……?」
						PRINTFORML 「지금이라면, 어떤 일이라도 해드릴 수 있어요……?」
						PRINTFORMDL 취한 %조사처리(CALLNAME:TARGET,"가")% 달라붙어 온다.
						PRINTFORMDW 끈적거리는 목소리로 섹스를 유혹하는 %조사처리(CALLNAME:TARGET,"는")% 마치 꿈의 마왕 같다…….
					CASE 2
						PRINTFORML 「큐우……♪」
						PRINTFORMDL 술에 취한 %조사처리(CALLNAME:TARGET,"가")% 억압된 마음을 해방하고 있다.
						PRINTFORMDW 데구르르 누워 애교를 부리는 이 모습은 자(獏)라기보다 바쿠다…….
				ENDSELECT
				;思慕
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「그런데, 왜 엉덩이를 만지고 있는 거예요...?」
						PRINTFORMDL 들켰다. 당신은 화들짝 %조사처리(CALLNAME:TARGET,"의")% 엉덩이에서 손을 떼었다.
						PRINTFORMW 「――취기가 깨질 거라고 생각했어? 어디서 받아쳐야 할지 모르겠네……」
					CASE 1
						PRINTFORML 「후우…… 덕분에 시원해졌어, 으윽!」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 황급히 양동이에 얼굴을 박는다.
						PRINTFORMDW ……가엾네. 당신은 %조사처리(CALLNAME:TARGET,"의")% 등을 쓸어주며 그렇게 생각했다.
					CASE 2
						PRINTFORML 「죄송해요, 제 수첩을 알고 계신가요?」
						PRINTFORML 「책상…… 여기에 두고 갔을 터인데……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 수첩을 안고 두리번거리며 주위를 둘 뿐이다.
						PRINTFORMDW ……재미있으니까 잠시 이대로 두자
				ENDSELECT
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「감사합니다……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 차가운 물을 벌컥 들이킨다.
						PRINTFORMDW 이걸로 조금은 취기가 가라앉겠지.
					CASE 1
						PRINTFORML 「이렇게까지 마실 줄은 몰랐는데……」
						PRINTFORML 「――당신의 무릎을? 으, 음…… 그럼 말씀에 응할게요……」
						PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하고 당신의 무릎에 머리를 기댔다.
					CASE 2
						PRINTFORML 「괜찮아요…… 바람 좀 쐬면……」
						PRINTFORML 「……윽, 콜록콜록……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 양동이에 위액을 토해낸다
						PRINTFORMDW 뭐, 결과적으로 시원해진 것 같으니 됐다고 하자
				ENDSELECT
			ENDIF
			;成功
		CASE 0
			;恋慕
			IF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「좋아하는 거예요…… 당신이……」
						PRINTFORML 「알아요…… 좋아한다는 게……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 헤롱헤롱 취해 있다.
						PRINTFORMDW 그런 상태에서 다가오는 것이기에, 두 사람은 주위의 주목를 받게 되었다.
					CASE 1
						PRINTFORML 「귀찮군……. 누구지…… 이런 걸 쓰게 된 건……」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 쓰고 있던 나이트캡을 내던진다
						PRINTFORMDW 그렇게 소중히 하고 있었는데……. 술의 힘은 무섭구나
					CASE 2
						PRINTFORML 「어라…… 이런 곳에 %MASTERNAME:109%이……」
						PRINTFORML 「들어 주세요…… 저, 당신이……」
						PRINTFORMDL 술에 취한 %조사처리(CALLNAME:TARGET,"가")% 사랑의 고백을 해온다
						PRINTFORMDW 당신은 네네 하며 흘려들으면서 %조사처리(CALLNAME:TARGET,"를")% 간호했다
				ENDSELECT
				;思慕
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「히끅…… 아니, 취하지 않았어, 헤헷쿠」
						PRINTFORMDL 진지한 %조사처리(CALLNAME:TARGET,"가")% 이 정도로 취하다니 드문 일이다.
						PRINTFORMDW 너는 완전히 만취한 %조사처리(CALLNAME:TARGET,"를")% 상냥하게 부축해 주었다.
