						PRINTFORML 「잠깐만 기다려봐요. ……응읏」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 피임약을 먹는다. 후우 하고 숨을 내쉬자, 당신을 향해 돌아왔다
						PRINTFORML 「이제 준비는 완벽하네요……♪」
						PRINTFORMDW 그렇게 말하자, 이번에는 %조사처리(CALLNAME:TARGET,"가")% 쪽에서 당신에게 달려와 안겨왔다
						TCVAR:ピル = 1
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;危険日生Ｈ解禁済
			IF CFLAG:生解禁 >= 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「아기가 생기면…… 이해하고 있겠지?」
						PRINTFORMDL 진지한 얼굴로 그렇게 말하는 %조사처리(CALLNAME:TARGET,"를")%, 당신은 아무 말 없이 끌어안았다.
						CALL HPH_PRINT,@"「……그렇군요. 후후, 그럼 마음껏…… HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「읏, 하아……큭」","L"
						PRINTFORMDL 당신의 가슴팍에 얼굴을 묻고, %조사처리(CALLNAME:TARGET,"가")% 깊고 깊게 심호흡을 한다.
						CALL HPH_PRINT,@"「흐읍――읏……응응! 고무 같은 건 됐으니까, 빨리……읏!」","L"
						PRINTFORMDW 완전히 암컷의 얼굴이 된 %조사처리(CALLNAME:TARGET,"의")% 입술을, 당신은 조금 강제로 빼앗았다.
					CASE 2
						PRINTFORMW 「……어쩔 수 없는 사람이네요」
						PRINTFORMW 「오늘도 제 안에서 거침없이 사정하고, 싫다고 말해도 자궁을 정액으로 가득 채우는 거죠……」
						PRINTFORMW 「분명 원숭이처럼 허리 흔들며 고환이 빌 때까지 사정하고, 제가 기절하면 만족스러운 듯 배를 쓰다듬어 오죠……」
						CALL HPH_PRINT,@"「정말…… 어쩔 수 없는 사람…… 하프」","W"
				ENDSELECT
				;通常
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「그렇게 저랑 어울이고 싶었던 건가요?」
						PRINTFORML 「――후후, 어쩔 수 없네요」
						PRINTFORMDW 그렇게 말하자, %조사처리(CALLNAME:TARGET,"는")% 어깨의 힘을 풀었다.
					CASE 1
						PRINTFORML 「――알았어요」
						PRINTFORML 「당신의 성욕, 제가 처리해 드릴게요」
						PRINTFORMDW 합의를 얻은 당신은 %조사처리(CALLNAME:TARGET,"를")% 부드럽게 끌어안았다.
					CASE 2
						PRINTFORML 「이거」
						PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 어김없이 고무를 꺼내더니, %조사처리(CALLNAME:MASTER,"의")% 손에 쥐여주었다
						PRINTFORMW 「아이가 생기면 곤란하니까……. 부탁해」
						CALL GET_ITEM("コンドーム", 1, 2)
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
