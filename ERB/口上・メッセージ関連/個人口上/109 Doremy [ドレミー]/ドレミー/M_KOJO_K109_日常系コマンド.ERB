@M_KOJO_MESSAGE_MESSAGECHECK_COM_K109_614
RETURN 0

@M_KOJO_MESSAGE_COM_K109_614
CALL M_KOJO_MESSAGE_COM_K109_614_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_614_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;ドレミーとデート中にお買い物
	IF CHK_DATENOW(CFLAG:[[ドレミー]]:デート中)
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「장 볼 것도 다 했으니, 이제 갈까요?」
					PRINTFORMDL 필요한 것들을 적은 메모를 확인한다……
					PRINTFORMDW 괜찮을 것 같다. 당신은 그렇게 말하며 %조사처리(CALLNAME:TARGET,"에게")% 고개를 끄덕였다
				CASE 1
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 장보기에 함께하고 있다……
					PRINTFORML 「――지루해 보이세요?」
					PRINTFORML 「하지만 참아주세요. 자, 보상 줄 테니까」
					PRINTFORMDW %CALLNAME:TARGET%에게서 과자를 받았다. 당신은 기분이 풀렸다
				CASE 2
					PRINTFORMDL 쇼핑을 마치고 윈도우 쇼핑을 즐기고 있자……
					PRINTFORML 「란제리 전문점…… 환상향에도 있는 거네요」
					PRINTFORML 「헤에, 의외로 멋지다…… 에엣, 이런 것도」
					PRINTFORMDL 줄지어 늘어선 여성용 속옷들에 당신은 시선을 빼앗긴다
					PRINTFORMDW 남자 혼자라면 들어가기 힘들겠지만, %조사처리(CALLNAME:TARGET,"와")% 함께라면 안심이다
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「자, 이제 저거만 사면……」
					PRINTFORMDL 장보기에 집중하고 있는 %조사처리(CALLNAME:TARGET,"의")% 바구니에 몰래 간식을 넣어 보았다.
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 자연스러운 동작으로 간식을 꺼내 원래 있던 선반에 되돌려 놓았다.
				CASE 1
					PRINTFORML 「그렇게 많이 사면, 무거울 것이다.」
					PRINTFORML 「맡아두겠다. 자, 여기에 넣어 주어라.」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 폭신하게 떠다니는 꿈혼을 가리킨다.
					PRINTFORMDW 장바구니를 올려보니, 스르륵 안으로 빨려 들어갔다. 식재료가 상하지 않았으면 좋겠다……
				CASE 2
					PRINTFORML 「잠깐 들르고 싶은 곳이 있어서. 괜찮을까요?」
					PRINTFORMDL 당신은 고개를 끄덕이고 %조사처리(CALLNAME:TARGET,"의")% 뒤를 따랐다.
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 침구점 앞에서 멈춰 서서 이쪽으로 돌아보았다.
					PRINTFORML 「금방 끝나니까, 여기서 기다려 주세요」
					PRINTFORMDW 그렇게 말한 후, %조사처리(CALLNAME:TARGET,"는")% 침구점에 들어갔다.
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;恋慕
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「밤에 마실 술을 위한 식재료를 사 두어야 한다」
					PRINTFORML 「어떠세요? 오늘 저녁 함께」
					PRINTFORMDW 그렇게 말하며, %조사처리(CALLNAME:TARGET,"는")% 살짝 잔을 기울이는 제스처를 취했다
				CASE 1
					PRINTFORML 「자, 여기. 장 봐준 거 고마워」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신의 손바닥에 톡 사과를 올려놓는다.
					PRINTFORMDW 마침 배가 고팠었다. 당신은 감사하다고 말하고, 시원하게 사과를 베어 물었다.
				CASE 2
					PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 장보기를 도와주었다.
					PRINTFORML 「고마워요, %MASTERNAME:109%」
					PRINTFORML 「나머지는 분신이 가져갈 테니, 여기서 괜찮아요」
					PRINTFORMDW 많은 식재료가 담긴 상자를 내려놓는다. 이번 데이트에 사용할 도시락이라고 한다.
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「환상향에는, 쌀로 온갖 요리를 만드는 전설의 요리사가 있었다던데……」
					PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 할 수 없을까. 당신이 그렇게 물어보았다
					PRINTFORMW 「에? 무슨 소리예요, 그럴 리가 없잖아요」
				CASE 1
					PRINTFORML 「뭔가 빠진 것 같은 느낌……」
					PRINTFORML 「아, 맞다. 저거 좀 더 사둬야지」
					PRINTFORMDW 당신과 %조사처리(CALLNAME:TARGET,"는")% 일단 헤어져 장을 보았다
				CASE 2
					PRINTFORMDL 당신은 가는 길에 사온 사과를 %조사처리(CALLNAME:TARGET,"에게")% 건넸다.
					PRINTFORML 「――아라, 이걸 나한테?」
					PRINTFORML 「감사합니다. 마침 배가 고팠거든요」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신에게 감사를 표한 후, 와삭하고 사과를 베어 물었다.
					CALL CHANGE_CFLAG(2,[[ドレミー]],10)
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
