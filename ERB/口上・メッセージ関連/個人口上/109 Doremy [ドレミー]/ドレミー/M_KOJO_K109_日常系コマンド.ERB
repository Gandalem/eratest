@M_KOJO_MESSAGE_SCOM_K109_63_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미의 머리를 감싸 안고 거친 숨을 몰아쉬며 탐욕스럽게 키스한다.
		PRINTFORMDL 입가에서 침이 새어 나올 정도의 격렬함이었지만, 도레미는 미동조차 하지 않는다.
		PRINTFORMDW 어딘가 차갑게 자신을 바라보고 있는 기분이 들어 %조사처리(CALLNAME:MASTER,"는")% 민망한 듯 입술을 닦았다.
	ELSEIF TALENT:恋人
		SELECTCASE RAND:6
			CASE 0
				CALL HPH_PRINT,@"「아…… 후, 러…… 읏... 쪽... 흐읍」","L"
				PRINTFORMDL 열에 들뜬 도레미는 재촉을 받듯 혀를 내밀어 다가오는 것을 입 안으로 이끌었다.
				PRINTFORMDW 마치 뱀의 교미를 본 듯한 농후한 깊은 키스에 도레미는 자신의 자궁이 저릿함을 느끼는 것을 알았다.
			CASE 1
				CALL HPH_PRINT,@"「쭈릅 HPH… 더…… HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 천천히 혀를 들이밀자, 도레미는 기다림을 이기지 못하겠다는 듯 혀를 얽으며 안쪽으로 유혹해 왔다.
				CALL HPH_PRINT,@"「쯧흑쯧주루쯧흑… 하아… 좋아해…읏」","W"
			CASE 2
				CALL HPH_PRINT,@"「아노... 응읏 HPH... 흐으윽 HPH 주르륵 HPH... 하아... HPH」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미를 품에 안고, 그녀의 은밀한 곳에 거칠게 무릎을 밀착시키며 깊은 입맞춤을 나누었다.
				PRINTFORMDL 빠져나가는 혀를 얽어매고 침을 흘리며, 입가에서 흘러넘치는 침조차 신경 쓰지 않고 오로지 구강 내부를 탐했다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 입술을 떼자, 뒤섞인 타액의 다리가 행위의 격렬함을 말해주듯 걸려 있었다……
				TCVAR:109:発情 = 1
			CASE 3
				CALL HPH_PRINT,@"「훗 HPH츄릅... HPH주르읏 HPH핫 HPH응츄...읏 HPH」","L"
				PRINTFORMDL 서로를 갈구하듯 혀를 얽고 침을 교환한다.
				PRINTFORMDW 도레미는 정열적인 구강성교에 숨을 거칠게 몰아쉬며, 침이 흘러내리는 것도 개의치 않고 입안 전체를 탐하고 있다…
			CASE 4
				CALL HPH_PRINT,@"「츄읍 HPH……츄파읏 HPH……쥬루룻 HPH……응……하아……하아……HPH」","L"
				PRINTFORMDL 버드키스에서 소프트 키스로, 그리고 깊은 키스로 점차 입술을 더 깊게 맞댄다.
				PRINTFORMDW 서로 얼굴을 떨구고 잠시 마주 본 후, 다시 입맞춤을 나누었다.
			CASE 5
				CALL HPH_PRINT,@"「쭈욱 흐읍... 후우... 후후, 서로 입 주변이 끈적끈적하네요...」","L"
				PRINTFORMDL 두 사람은 자연스럽게 입술을 떼고, 서로의 '참담한 모습'에 쓴웃음을 짓는다.
				PRINTFORMDW 그럼에도 그 행위의 여운을 지우지 않은 채 다시 입술을 맞댔다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아... 격해... 읍, 음... 쪽... 츄릅... 읍」","L"
				PRINTFORMDL 스킨십으로 시작된 키스는 어느새 정사(情事)의 양상을 띠고 있었다.
				PRINTFORMDL 도레미는 저항을 보이지 않고, 오히려 황홀함 그 자체로 구강 섹스를 받아들이고 있다…
				CALL HPH_PRINT,@"「정말, 키스 정말 잘한다구…… 후훗 흐으윽… 흐읍」","W"
			CASE 1
				CALL HPH_PRINT,@"「흐읍! 후우…… 이런 데, 누가 보면 어떡해……후으」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 상관없다 하자 도레미는 요염하게 볼을 부드럽게 풀었다.
				CALL HPH_PRINT,@"「……그렇습니까… 그렇다면… 더 더럽혀 드릴게요… 쪽! HPH」","L"
				PRINTFORMDW 자발적으로 혀를 얽어오는 도레미에게 화답하듯 강하게 그녀의 몸을 끌어안았다
			CASE 2
				PRINTFORML 「키스, 기분 좋네요...%MASTERNAME:109%가 좋아하는 이유를 알았어요」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 더 하고 싶다고 말하자 도레미는 볼을 부드럽게 만들며 이쪽의 얼굴을 잡았다.
				CALL HPH_PRINT,@"「좋아요……암후후쪽후루르읏후」","L"
				PRINTFORMDW 도레미와 %조사처리(CALLNAME:MASTER,"는")% 잠시 동안 정신없이 서로의 입안을 탐했다.
		ENDSELECT
	ELSEIF TALENT:思慕 || TALENT:セフレ
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……후으… 츄읍… 응……읏」
				PRINTFORMDL 우울한 듯 눈을 내리깔고 있는 도레미의 입안에 혀를 넣자, 그녀는 조심스럽게 혀를 맞대어 왔다
				PRINTFORMW 「……… 의외로… 나쁘지 않을지도……」
			CASE 1
				PRINTFORML 「아, 혀까지……응응앗」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 정열적인 키스에 자신도 모르게 도레미의 입이 풀린다.
				PRINTFORMDL 그 틈을 놓치지 않고 혀를 밀어 넣자 도레미는 어깨를 떨면서도 그것을 받아들인다.
				CALL HPH_PRINT,@"「이런 거, 안 돼요…… 쪽읏 HPH아, 응…… HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「옷, 더러워지게 되잖아... 응으읏 HPH」","L"
				PRINTFORMDL 입가에서 침이 흘러도 개의치 않고 도레미의 구석구석을 맛본다.
				PRINTFORMDW 끊임없이 넘쳐흐르는 타액을 그녀의 입안에 흘려 넣자, 순간의 망설임 뒤에 '꿀꺽' 하고 삼키는 소리가 울렸다.
		ENDSELECT
		;陥落無し
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응, 응으……앗」
				PRINTFORMDL 도레미의 단단히 닫힌 입술을 억지로 벌려 빠져나가는 혀를 강제로 얽어잡는다.
				CALL HPH_PRINT,@"「흐읍, 츄릅……! 하아앗, 그만해줘...!」","L"
				PRINTFORMDW 침으로 범벅이 된 입을 닦는 도레미는 얼굴을 홍조하게 물들이며 불쾌한 듯 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있었다.
			CASE 1
				PRINTFORML 「응…… 윽, 이제 안 되겠어읏」
				PRINTFORMDL 혀를 넣으려고 하자, 도레미는 참을 수 없는 한계가 온 것인지 %조사처리(CALLNAME:MASTER,"를")% 밀쳐냈다.
				PRINTFORMW 「최악이네요… 아무리 그래도 한계라는 게 있는 법이에요」
			CASE 2
				PRINTFORML 「……윽」
				PRINTFORMDL 날카로운 통증이 전해져 입술을 떼게 된다. 스며 나오는 피를 보고 도레미에게 물렸다는 것을 깨닫는다.
				PRINTFORMW 「아우…… 그게…… 아니에요, 제가 사과할 필요 같은 건 없어요. 반성해주세요」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
