;411,戦闘訓練
;TFLAG:194(3=夏の昼間 2=ヤバい天気 1=悪天候 0=屋内or通常天気
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K109_411
RETURN 1

@M_KOJO_MESSAGE_COM_K109_411
CALL M_KOJO_MESSAGE_COM_K109_411_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_411_1
#DIM 正解
#DIM 経験値
#DIM 制限時間
#DIM 倍率
#DIM FEINT
#DIM イカサマ
VARSET LOCAL
イカサマ = 0
制限時間 = 2000 - (ABL:[[ドレミー]]:戦闘能力 - ABL:MASTER:戦闘能力) * 100
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;特訓デイリーからお借りしました
	PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"와")% 탄막 놀이 연습을 하게 되었다
	CALL M_KOJO_COLOR_K109
	SELECTCASE RAND:5
		CASE 0
			PRINTFORMW 「간다. 꿈부 '진홍빛 악몽'! 」
		CASE 1
			PRINTFORMW 「피할 수 있겠어? 꿈부 '란색의 우츠유메'! 」
		CASE 2
			PRINTFORMW 「자아, 갑니다. 꿈부 '가야스이로의 미몽'! 」
		CASE 3
			PRINTFORMW 「따라올 수 있겠어? 꿈의 부적 '드림캐처'! 」
		CASE 4
			PRINTFORMW 「이걸 피한다면 대단한 사람이 될 거예요. 월부 '남색의 광몽'이야!」
	ENDSELECT
	RESETCOLOR
	PRINTFORML 
	CALL ASK_YN("집중한다","잠깐, 탄마")
	IF RESULT
		CALL M_KOJO_COLOR_K109
		PRINTFORML 「무슨 일 있으세요?」
		PRINTFORML 「――에? 역시 멈출까? 하, 하아……」
		PRINTFORMDW 갑자기 배가 아파진 당신은 탄막 놀이 연습을 중단했다.
		RESETCOLOR
	ELSE
		正解 = RAND:4
		経験値 = MIN(ABL:[[ドレミー]]:戦闘能力 * 5, 5)
		SELECTCASE RAND:20
			;普通
			CASE IS <= 11
				LOCALS:0 = 上
				LOCALS:1 = 右
				LOCALS:2 = 左
				LOCALS:3 = 下
				倍率 = 100
				;ごっちゃ
			CASE 12 TO 15
				LOCALS:0 = 上
				LOCALS:1 = MIGI
				LOCALS:2 = ひだり
				LOCALS:3 = DOWN
				倍率 = 120
				;スペイン語
			CASE 16,17,18
				LOCALS:0 = encima de
				LOCALS:1 = a la derecha
				LOCALS:2 = a la izquierda
				LOCALS:3 = abajo de
				倍率 = 320
				;スワヒリ語
			CASE 19
				LOCALS:0 = juu
				LOCALS:1 = kulia
				LOCALS:2 = kushoto
				LOCALS:3 = chini
				倍率 = 320
		ENDSELECT
		;あなたの戦闘能力が高いと５分の一の確率でフェイントをかけてくる
		IF ABL:MASTER:戦闘能力 > 3 && !RAND:3
			FEINT = 1
			制限時間 += 400
			倍率 += 80
		ELSE
			FEINT = 0
		ENDIF
		CALL FISHER_YATES_SHAFFLE(4)
		PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 공격을 피한다 (클릭으로 시작)
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
		SETCOLOR C_YELLOW
		IF FEINT
			PRINTFORM %LOCALS:(RAND:4)%
			RESETCOLOR
			PRINTFORM 하고 보이면서 %LOCALS:(3 - 正解)%
		ELSE
			PRINTFORM %LOCALS:(3 - 正解)%
			RESETCOLOR
		ENDIF
		PRINTFORMDL 저쪽으로부터의 공격!
		$LOOP_IKASAMA
		FOR LOCAL:10,0,4
		LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
		PRINTFORMDL [{LOCAL}] ｛로컬｝ - %LOCALS:LOCAL%에게 피한다
		NEXT
		SIF !イカサマ && BASE:MASTER:TSP > 500
			PRINTFORMDL [{4}] - 시간 정지
		TINPUT 制限時間, -1, 1
		IF RESULT == 正解
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 공격을 회피했다!
			CALL M_KOJO_COLOR_K109
			PRINTFORMDL ……………
			PRINTFORMDL ………
			PRINTFORMDW …
			PRINTFORML 「후우…… 수고하셨어요」
			PRINTFORMDL 연습을 마친 당신과 %조사처리(CALLNAME:TARGET,"는")% 나란히 차를 마시고 있다.
			PRINTFORML 「잘 해냈네요. 저도 오랜만에 불타올랐어요」
			PRINTFORML 「다음에 또 할 때는 말해주세요. 함께 하겠습니다」
			PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"에게")% 칭찬을 받았다.
			SIF イカサマ
				PRINTFORMDW 사실은 시간을 멈추고 속임수를 썼는데…… 들키지 않은 것 같아
			RESETCOLOR
			BASE:MASTER:体力 -= 100 * (1 + ABL:[[ドレミー]]:戦闘能力)
			BASE:MASTER:気力 -= 100 * (1 + ABL:[[ドレミー]]:戦闘能力)
			経験値 = 経験値 * 倍率 / 100
			EXP:MASTER:戦闘経験 += 経験値
			EXP:[[ドレミー]]:戦闘経験 += 経験値 * 2
			CFLAG:[[ドレミー]]:好感度 += 経験値 * 2
			CFLAG:[[ドレミー]]:信頼度 += 経験値 * 2
			PRINTFORMDL 전투 경험 + {経験値}(%CALLNAME:MASTER%)
			PRINTFORMDL 전투 경험 + {経験値 * 2}(%CALLNAME:TARGET%)
			PRINTFORMDL 호감도 + {経験値 * 2}(%CALLNAME:TARGET%)
			PRINTFORMDL 신뢰도 + {経験値 * 2}(%CALLNAME:TARGET%)
		ELSEIF RESULT == 4 && !イカサマ && BASE:MASTER:TSP > 500
			イカサマ = 1
			倍率 /= 5
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 시간 정지 능력으로 공격을 간파했다!
			GOTO LOOP_IKASAMA
		ELSE
			CALL M_KOJO_COLOR_K109
			PRINTFORMDL 실패했어……
			PRINTFORML 「아쉽네. 아슬아슬했어」
			PRINTFORMDL 회피에 실패한 당신은 만신창이가 되어 바닥에 쓰러져 있다
			PRINTFORML 「다시 한번 부탁해. 나도 꽤 즐거웠으니까」
			PRINTFORMDW 그렇게 말하며 미소 짓는 %조사처리(CALLNAME:TARGET,"에게")%, 당신은 힘없이 엄지손가락을 치켜들었다
			RESETCOLOR
			BASE:MASTER:体力 -= 500 * (1 + ABL:[[ドレミー]]:戦闘能力)
			BASE:MASTER:気力 -= 500 * (1 + ABL:[[ドレミー]]:戦闘能力)
			PRINTFORMDL 전투 경험 + {経験値}(%CALLNAME:TARGET%)
			EXP:[[ドレミー]]:戦闘経験 += 経験値
			CFLAG:[[ドレミー]]:好感度 += 経験値 / 2
			CFLAG:[[ドレミー]]:信頼度 += 経験値 / 2
			PRINTFORMDL 호감도 + {経験値}(%CALLNAME:TARGET%)
			PRINTFORMDL 신뢰도 + {経験値}(%CALLNAME:TARGET%)
		ENDIF
	ENDIF
ENDIF
RETURN 1
