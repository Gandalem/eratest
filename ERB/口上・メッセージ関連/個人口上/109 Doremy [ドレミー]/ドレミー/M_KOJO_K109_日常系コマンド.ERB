LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:睡眠
		PRINTFORML 「……음응……」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 몸을 살짝 꿈틀거리지만 눈을 뜰 기색은 없다
		PRINTFORMDW 당신은 그녀를 깨우지 않도록 조심스럽게 이불 속으로 파고들었다
		;衰弱中
	ELSEIF CFLAG:衰弱
		PRINTFORML 「………………」
		PRINTFORMDL 지쳐 쓰러진 %조사처리(CALLNAME:TARGET,"는")% 진흙처럼 잠들어 있다.
		PRINTFORMDW 당신이 파고들어도 그녀는 몸을 조금도 움직이지 않았다.
		;通常
	ELSE
		;季節で分岐
		SELECTCASE DAY:2
			;春
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「마침 저도 %MASTERNAME:109%가 보고 싶다고 생각하고 있었어요」
						PRINTFORMDL 도레미는 미소를 지으며 당신을 이불 속으로 초대했다.
						PRINTFORMW 「후후, 자장가를 불러 드릴까요?」
					CASE 1
						PRINTFORML 「애처럼 응석 부리네…… 가슴이라도 물래?」
						CALL HPH_PRINT,@"「――앗, 저기, 그렇게 세게 빨면 안 돼읏! HPH」","L"
						PRINTFORMDW 당신과 %조사처리(CALLNAME:TARGET,"는")% 이불 속에서 애정행각을 벌였다.
					CASE 2
