@M_KOJO_MESSAGE_MESSAGECHECK_COM_K109_333
RETURN 0

@M_KOJO_MESSAGE_COM_K109_333
CALL M_KOJO_MESSAGE_COM_K109_333_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_333_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;判定
	SELECTCASE TFLAG:193
		;しゃべっているうちにまた怒りがぶり返してきたようだ…
		CASE 1
			PRINTFORML 「최근에는 나를 부르기 위해서만 꿈의 세계에서 날뛰는 무리들도 있어……」
			PRINTFORML 「…………하아」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며, 우울해 보이는 한숨을 내쉬었다
			;言いたいことを言って落ち着いたようだ
		CASE 2
			PRINTFORML 「이야 들어주는 게 능숙하다고 안 그래요?」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 투덜거림을 들어주니 시원해진 모양이다.
			;一通り吐き出したドレミーは、大人しく聞いてくれたあなたに礼を言った
		CASE 3
			PRINTFORML 「당신은 정말 말을 잘 들어주는 사람이네요」
			PRINTFORML 「덕분에 기분이 나아졌어요. 고마워요」
			PRINTFORMDW 투덜거림을 다 토해낸 %조사처리(CALLNAME:TARGET,"는")% 개운한 표정을 짓고 있다
			;ドレミーはますます理不尽な絡み方をしてきた…
		CASE 4
			PRINTFORML 「취하지 않았어요……네, 취하지 않았습니다」
			PRINTFORML 「무슨 표정이에요? 설마 제가 취했다고 생각하는 건가요?」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 술 냄새를 풍긴다. 이건 너무 심하다…….
			;自分で何を言っているかわかっているのかも怪しい…
		CASE 5
			PRINTFORML 「당신의 얼굴을 보고 있으니 꿈혼이 먹고 싶어졌어요……」
			PRINTFORML 「고향의 꿈속 세계로 돌아가서…… 소박한 꿈혼을……」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 상당히 취해 있는 모양이다……
			;あなたが適当に相槌を打っていると、なにかツボにはまったのかドレミーは急に笑い出した
		CASE 6
			PRINTFORML 「갑자기 말인데…… 사구메 씨의 목소리 따라 하기」
			PRINTFORML 「그렇지 않아(단호하게)」
			PRINTFORML 「――흡, 후후훗! 방금 건 닮았네요(웃음)」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"가")% 알코올로 머리가 나빠진 것 같다……
	ENDSELECT
ENDIF
RETURN 1
