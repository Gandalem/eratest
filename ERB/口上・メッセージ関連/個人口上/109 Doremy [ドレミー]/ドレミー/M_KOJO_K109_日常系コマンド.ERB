@M_KOJO_MESSAGE_COM_K109_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:時間停止
		PRINTFORML 
		RETURN 1
		;睡眠中
	ELSEIF CFLAG:睡眠
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMDL 짐승이 잠든 모습 같은 건 쉽게 볼 수 있는 게 아니야.
				PRINTFORMDW 당신은 잠든 %조사처리(CALLNAME:TARGET,"를")% 관찰하며 한숨 돌렸다.
			CASE 1
				PRINTFORML 「음…… 음……」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 깊이 잠들어 있다.
				PRINTFORMDW 가볍게 치마를 들어보아도 깨지 않을 정도이다.
			CASE 2
				PRINTFORML 「그거…… 스윗……」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 부르릉거리며 잠언을 하고 있다.
			CASE 3
				PRINTFORML 「아르마딜로랑……나무돼지랑은 다르다구……」
				PRINTFORMDW 꿈의 세계에서 %조사처리(CALLNAME:TARGET,"는")% 누군가에게 나무돼지와 아르마딜로의 차이점을 설명하고 있다……
			CASE 4
				PRINTFORML 「……꾸욱」
				PRINTFORMDW 잠든 %조사처리(CALLNAME:TARGET,"를")% 관찰하고 있자 그녀가 작고 귀여운 목소리를 냈다.
		ENDSELECT
		;反発刻印あり
	ELSEIF MARK:反発刻印
		;恋人
		IF TALENT:恋人
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「맛있는 차에, 맛있는 과자」
					PRINTFORML 「나머지는 여기에 당신의 사죄가 있다면……」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하고는 슬쩍 당신 쪽을 바라봤다
				CASE 1
					PRINTFORML 「이 거리감, 만났을 때를 생각하게 되네요」
					PRINTFORML 「설마 이런 걸 하는 사람이 있을 줄은 몰랐지만요」
					PRINTFORMDW 휴식을 취하는 당신과 %CALLNAME:TARGET%사이에는 보이지 않는 벽이 존재한다……
				CASE 2
					PRINTFORMDL 「야」라고 %조사처리(CALLNAME:TARGET,"에게")% 말을 걸었지만 대답이 없다.
					PRINTFORMDL ……잘 보니, 옆에 있던 것은 %조사처리(CALLNAME:TARGET,"가")% 아니라 그녀의 등신대 패널이었다!
					PRINTFORML 【급한 용무가 생각나서 자리를 비울게. 금방 돌아올게】
					PRINTFORMDW 패널에는 그렇게 쓰여 있었다……
				CASE 3
					PRINTFORML 「이것저것 지쳤으니까 슬슬 화해하자」
					PRINTFORML 「응, 그럼 우선 당신부터――에? 내가 먼저 사과해야 해?」
					PRINTFORMW 「아니, 왜 내가 사죄를 해야 하는데? 피해자잖아, 나」
				CASE 4
					PRINTFORML 「貴方と恋人になったこと、後悔はしていません」
					PRINTFORML 「だから、ハッキリ言わせて頂きますね。先に謝れコラァッ！」
					PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"에게")% 따뜻하게 머리를 맞았다
			ENDSELECT
			;恋慕
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「뭐랄까, 당신답네요」
					PRINTFORML 「깊은 의미는 없어요. 칭찬한 것도 아니고요」
					PRINTFORMDW 어색한 분위기 속에서 두 사람은 휴식을 취했다
				CASE 1
					PRINTFORML 「그래서, 사죄의 대사는 준비됐나요?」
					PRINTFORML 「저, 계속 기다리고 있잖아요? 당신의 진심이 담긴 사죄를」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 가만히 당신의 얼굴을 바라보며 다음 말을 기다리고 있다……
				CASE 2
					PRINTFORML 「나, 당신이랑 달라서 꽤 오래 곱씹는 타입이거든」
					PRINTFORML 「만약 이대로 사과가 없다면…… 최악으로는 10년 이상 끌지도 몰라」
					PRINTFORMDW 그렇게 곱씹어줬으면 해서 사과하지 않는 것도 괜찮겠다고 당신은 생각했다
				CASE 3
					PRINTFORML 「몸은 쉬어도, 마음은 쉬지 못하네요」
					PRINTFORML 「이 모든 게 전부 당신 때문이에요」
					PRINTFORMDW 휴식 중에도 %조사처리(CALLNAME:TARGET,"는")% 가슴을 콕콕 찌르며 계속 당신을 공격했다.
				CASE 4
