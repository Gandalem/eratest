@DOREMY_FELLATIO
;舌技術３以上
IF ABL:舌 >= 3
	;今射精した
	IF NOWEX:PLAYER:11
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「츄릅, 즈즈윽…… 쭉, 즈즈윽…… HPH」","L"
				PRINTFORMDL 도레미는 남성의 성기 전체를 입에 넣고, 혀를 사용해 민감한 등줄기를 집요하게 자극하고 있다.
				PRINTFORMDL 남자의 약점을 꿰뚫고 있는 듯한 봉사는 %조사처리(CALLNAME:MASTER,"를")% 급속히 사정으로 이끌어간다……
				PRINTFORML 「푸하…… 자, 뭘 참고 있을 필요가 있겠어요… 정액이 바닥날 때까지, 마음껏 사정해도 괜찮아요?」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그녀의 도발에 대답하는 대신, 부르르 하고 정액을 분출했다……
			CASE 1
				CALL HPH_PRINT,@"「구포옷 HPH응, 후우읏 HPH즈루루읏 HPH」","L"
				PRINTFORMDL 도레미는 경험으로 %조사처리(CALLNAME:MASTER,"의")% 사정이 임박했음을 깨닫고, 육봉을 더욱 격렬하게 빨기 시작했다.
				PRINTFORMDL 탐욕스러운 페라치오는 %조사처리(CALLNAME:MASTER,"를")% 급속히 절정에 이르게 해간다……
				CALL HPH_PRINT,@"「쭈루윽 HPH 이대로…… 입안에, 사정해줘…… HPH」","W"
			CASE 2
				CALL HPH_PRINT,@"「스르륵 핥짝... 주압! 츄릅! 주압! 츄릅!」","L"
				PRINTFORMDL 기둥을 빨아들이고 귀두를 몰아붙이며 얼굴을 흔드는 도레미
				PRINTFORMDW 격렬한 공격에, %조사처리(CALLNAME:MASTER,"는")% 견딜 수 없을 것만 같았다……
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「쥬폿... 구푸...! 후우... 자, 봐주세요...」
				PRINTFORMDW 도레미는 그렇게 말하며 손바닥에 대량의 타액을 떨어뜨렸다.
				PRINTFORML 「이거, 전부 %MASTERNAME:109%의 선사라구요? 후후, 굉장하죠... 거시기 괜찮으세요?」
				PRINTFORMW 「……뭐 망가져 버려도, 저는 상관없는데요♪」
			CASE 1
				CALL HPH_PRINT,@"「응윽, 주읍! 후루루루읏!」","L"
				PRINTFORMDL 자신도 모르게 허리가 들릴 정도의 격렬한 페라치오에 강렬한 쾌감이 밀려온다.
				PRINTFORMDL 봉사의 거세함에 %조사처리(CALLNAME:MASTER,"는")% 도레미의 머리를 붙잡으려 하지만, 그녀는 멈추지 않는다.
				PRINTFORMDW 오히려 불에 기름을 부은 듯, 도레미는 가학적인 미소를 지으며 자신의 기량으로 남성기를 괴롭혔다……
			CASE 2
				CALL HPH_PRINT,@"「츄릅 HPH... 쭈르륵 HPH... 흡, 꿀꺽 HPH」","L"
				PRINTFORMDL 도레미는 입안에 고인 선행과 타액의 혼합물을 삼키면서, 정신없이 남근에 달라붙고 있다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 무심코 신음하자, 도레미는 성기를 입에 물고 방긋 웃었다.
				CALL HPH_PRINT,@"(후후훗 후우~ 여자애처럼 신음해줘... 역시 %MASTERNAME:109%는 귀엽네요... 후후)","W"
			CASE 3
				;水増し
				SELECTCASE RAND:6
					CASE 0
						CALL HPH_PRINT,@"「흐으윽... 흡흡... 쪽... 흡흡」","L"
						PRINTFORMDW 도레미는 육봉을 손으로 받치더니, 등줄기부터 귀두까지를 질척하게 핥아 올렸다.
						CALL HPH_PRINT,@"「후후, 역시 여기가 약한 거네요…… HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「아무…… 응응…… 큭흐」","L"
						PRINTFORMDL 도레미는 %조사처리(CALLNAME:MASTER,"의")% 허리를 감싸 안고, 천천히 목구멍 깊숙이 육봉을 빨아들였다…….
						CALL HPH_PRINT,@"(%MASTERNAME:109%의 거시기, 냄새나서... 엄청 맛있다... HPH)","W"
					CASE 2
						CALL HPH_PRINT,@"「츄릅! HPH... 할 거야! HPH」","L"
						PRINTFORMDL 도레미는 귀두에서 입을 떼고 혀를 살살 움직이며 은구(鈴口)를 괴롭혔다.
						PRINTFORMDW 간지럽고 기분 좋은 감각에 나도 모르게 허리가 움직이자, 도레미는 기쁜 듯 꼬리를 흔들었다……
					CASE 3
						CALL HPH_PRINT,@"「츄…읏 HPH 츄릅…읏 HPH」","L"
						PRINTFORMDW 도레미는 요도의 카우퍼액을 빨아들이려는 것처럼 흡입해 왔다.
					CASE 4
						CALL HPH_PRINT,@"「……응……큭! 후루루루릉 큭!」","L"
						PRINTFORMDW 영혼까지 빨려 들어갈 것 같은 흡입에 저도 모르게 허리가 들썩였다.
					CASE 5
						CALL HPH_PRINT,@"「꾸벅 HPH 꾸벅 HPH 쿠읏 HPH」","L"
						PRINTFORMDW 도레미는 한 치의 흐트러짐도 없이 육봉을 빨고 있다…….
						CALL HPH_PRINT,@"「응응~…읏 HPH 하아…HPH 기분 좋아요...? HPH」","W"
				ENDSELECT
		ENDSELECT
	ENDIF
	;それ以外
ELSE
	;今射精した
	IF NOWEX:PLAYER:11
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「츄읍…… 거시기, 움찔거리고 있어요…… 그렇게 기분 좋은 거예요……?」
				PRINTFORMDL 도레미의 혀끝이 조심스럽게 구멍을 간지럽히자, %조사처리(CALLNAME:MASTER,"는")% 전율하는 듯한 쾌감에 나도 모르게 신음을 내뱉는다.
				PRINTFORMDL 그 반응을 보고 기분이 좋아졌는지, 그녀는 크게 입을 벌려 목구멍 깊숙이 성기를 삼켜버렸다……
				PRINTFORML 「사정할 때는 제대로 말해야 해요?… 꿀꺽… 질척…… 응, 퍽...!?」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 폭발적으로 사정하자, 도레미는 입가에서 정액을 흘리며 시크한 눈으로 노려보았다……
			CASE 1
				PRINTFORML 「쿠푸읏... 주풉... 사정할 때는... 도레미의 신호, 해줘요……」
				PRINTFORMDL 도레미는 %조사처리(CALLNAME:MASTER,"의")% 가랑이에 얼굴을 묻고 거친 숨을 내쉬며 자극에 봉사하고 있다.
				PRINTFORMDW 『이제 사정해』라는 %조사처리(CALLNAME:MASTER,"의")% 신호를 들은 도레미는, 사정을 재촉하듯 입으로 그 자극을 애무했다……
			CASE 2
				PRINTFORML 「응, 벌써 사정할 것 같아...? 에, 먹어줬으면 해?」
				PRINTFORML 「...정말 변태시네요... 뭐, 해보긴 할게요...」
				PRINTFORMDW 투덜거리면서도 거부하지 않는 모습에 도레미도 제법이었다
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「...응, 쭉... 하아... 어때요...?」
				PRINTFORMDL 도레미는 기둥 끝에 혀를 갖다 대며 올려다보는 시선으로 %조사처리(CALLNAME:MASTER,"가")% 바라본다.
				PRINTFORML 「기분 좋아요?... 그렇다면, 더 핥아 드릴까요... 응... 꿀꺽...」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 머리를 쓰다듬어 주자, 그녀는 기쁜 듯 눈을 가늘게 떴다.
			CASE 1
				PRINTFORML 「……츄릅… 흡… 조금 쓰네요……」
				PRINTFORMDL 도레미는 혀끝에 입술을 대고 넘쳐흐르는 선주를 빨아들이고 있다.
				PRINTFORMW 「하지만 이상하게 싫은 맛은 아니랄까…… 츄읍… 쮸읍…」
			CASE 2
				PRINTFORML 「꾸읍… 음크윽…… 후우… 턱이 피곤해지네요… 이거…」
				PRINTFORMDL 도레미는 일단 성기에서 입을 떼고, 입가의 침을 닦는다.
				PRINTFORML 「…응… 뭔가 위화감이 있다고 생각했는데, 입안에 %MASTERNAME:109%의 음모가…… 뭐 괜찮아요만」
				PRINTFORMW 「…자, 계속할게요…… 응응… 쭉 흡… 후, 응…」
			CASE 3
				;水増し
				SELECTCASE RAND:6
					CASE 0
						PRINTFORML 「...츄윽... 낼름...」
						PRINTFORMDW 도레미는 조심스럽게 남성의 성기를 핥고 있다.
					CASE 1
						PRINTFORML 「응읏... 굉장한 냄새...」
						PRINTFORMDW 도레미는 조심스럽게 귀두를 핥고 있다.
					CASE 2
						PRINTFORML 「...후... 쪽...」
						PRINTFORMDW 귀두를 입에 물고, 엿을 굴리듯이 핥기 시작했다
					CASE 3
						PRINTFORML 「응... 이거 잘 들어오나...?」
						PRINTFORMDW 성기를 입에 물고 상태를 물어본다.
					CASE 4
						CALL HPH_PRINT,@"「응, 쪽…… 응크윽… HPH」","L"
						PRINTFORMDW 도레미는 성기를 빨아먹으며, 앞서 나온 섞인 침을 단숨에 삼켰다.
					CASE 5
						PRINTFORML 「쿠프……응, 응……」
						PRINTFORMDW 도레미는 눈을 감고 성기를 빠는 것에 집중하고 있다.
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
;==================================================
;80,手淫
