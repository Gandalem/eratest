@M_KOJO_MESSAGE_COM_K109_80
CALL M_KOJO_MESSAGE_COM_K109_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K109_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧３以上
	ELSEIF ABL:技巧 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「어라, 벌써 갈 것 같으신가요?」
					PRINTFORMDL 도레미는 육봉을 잡고 사정에 이르게 하려고 격렬하게 애썼다.
					PRINTFORML 「너무 세다고? 후후, 기분 좋은 주제에……」
					PRINTFORMW 「자, 비력비력하게 실컷 사정해서 소중한 정액 낭비해 주세요♪」
				CASE 1
					PRINTFORML 「꿈의 지배자에게 사정 보조까지 받게 되다니, %MASTERNAME:109%는 행복한 사람이네요?」
					PRINTFORML 「크큭, 바보같이 고개를 끄덕이고, 남자의 자존심 따위는 전혀 없는 것 같아서……」
					PRINTFORML 「뭐 어쩔 수 없죠. 섹스하는 것 외에는 능력이 없으니까요」
					PRINTFORML 「그러니까 이렇게 내가 도와주지 않으면 안 되잖아♪」
					PRINTFORMDW 도레미가 즐거워 보여서 다행이다……%조사처리(CALLNAME:MASTER,"는")% 사정하면서 그런 생각을 했다
				CASE 2
					PRINTFORML 「언제든지 사정해도 괜찮으니까~」
					PRINTFORMDL 도레미는 나른하게 음낭을 주무르며, 부드럽게 성기를 다루고 있다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% '이제 사정할 거야'라고 중얼거리자, 점차 다루는 속도가 빨라져 갔다
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「아라라, 아까부터 앞서 나가는 게 멈추질 않아서…… 봐주세요」
					PRINTFORMDL 도레미가 손을 펼치자, 질척하게 달라붙은 애액이 그녀의 손 안에서 실처럼 늘어났다.
					PRINTFORML 「후후, 여성보다 더 적시고 있는 거 아닌가요?」
					PRINTFORMW 「빨리 계속 해달라고? 그렇게 조급해하지 마세요… 원하시는 대로, 오줌싸개 될 정도로 열심히 박아드릴 테니까♪」
				CASE 1
					PRINTFORML 「저기, 허리 움직이지 말아 주세요. 하기 힘들잖아요」
					PRINTFORMDL 도레미는 %조사처리(CALLNAME:MASTER,"의")% 허리를 눌러 붙이고, 테크닉을 더욱 강하게 해갔다
					PRINTFORMW 「후후, 침 흘리면서 신음해버리고…… 하고 싶다고 말한 건 %MASTERNAME:109%잖아요」
				CASE 2
					PRINTFORML 「알고 있어요... 이쪽도, 그렇죠?」
					PRINTFORMDL 도레미는 흔들리는 음낭을 부드럽게 손바닥으로 감싸더니, 조금씩 힘을 주었다.
					PRINTFORMDL 그대로 남성 성기가 문질러지자, %조사처리(CALLNAME:MASTER,"는")% 한심하게 허리를 경련시키고 만다……
					PRINTFORMW 「그렇게 기분 좋은 거예요?... 어라, 한눈에 알 수 있잖아요, 그렇게 신음하고 있으면♪」
				CASE 3
					;水増し
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「자…… 자극해 드릴 테니까, 마음껏 주르륵 싸도 괜찮아요…… HPH」","L"
							PRINTFORMDL 도레미는 능숙한 손놀림으로 기분 좋은 곳을 집중적으로 애무해 온다.
							PRINTFORMDW 장인의 솜씨에 %조사처리(CALLNAME:MASTER,"는")% 그저 허우적거릴 뿐이었다...
						CASE 1
							CALL HPH_PRINT,@"「이런 건 어때요? HPH」","L"
							PRINTFORMDL 도레미는 걸쭉한 꿈의 영혼 같은 것을 귀두에 흘려보냈다.
							PRINTFORMDW 그대로 꾸덕꾸덕 소리를 내며 다뤄진다. 강렬한 쾌감에 자신도 모르게 허리가 떨렸다……
						CASE 2
							CALL HPH_PRINT,@"「이렇게 되는 게 약한 거죠...? HPH 후후, 알고 있어요 HPH」","L"
							PRINTFORMDL 육봉을 다루던 도레미는, 흔들리는 음낭을 손바닥에 올려놓고 구슬을 굴리듯 주무르기 시작했다.
							PRINTFORMDW 능숙한 봉사에 %조사처리(CALLNAME:MASTER,"는")% 흐느끼는 듯한 신음 외에는 아무것도 할 수 없었다...
					ENDSELECT
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「이제 사정할 것 같아? 음, 어떻게 하면 좋을까……」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미에게 『그대로 세게 다뤄줬으면 해』라고 부탁했다.
					PRINTFORMW 「이런 느낌인가요?... 어라, 조금씩 부풀어 오고 있어... 아앗」
					PRINTFORMW 「………후후, 수고하셨습니다」
				CASE 1
					PRINTFORML 「자, 힘을 빼고…… 나에게 몸을 맡겨 주세요」
					PRINTFORMDL 도레미는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 가만히 응시하며 부드러우면서도 격렬하게 성기를 다루고 있다.
					PRINTFORMDL 그녀의 손 안에서 성기가 움찔거리며 사정을 예고한다……
					PRINTFORMW 「괜찮아요… 신경 쓰지 말고, 나의 손 안에서 사정해도 돼요…」
				CASE 2
					PRINTFORML 「자, 나에게 잘 보여줘. %MASTERNAME:109%가 사정하는 모습을……」
					PRINTFORMDL 도레미는 경련하는 성기를 먹을 듯 바라보며 거칠게 애무하고 있다
