@M_KOJO_MESSAGE_SCOM_K109_1
CALL M_KOJO_MESSAGE_SCOM_K109_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K109_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「이 모습, 서로 소중한 곳이 전부 보여버려서……」
		CALL HPH_PRINT,@"「뭐랄까, 부끄러워…… 아앗 HPH」","L"
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 도레미의 은밀한 곳을 핥아 올리자, 그녀의 허리가 움찔 떨렸다.
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;舌技術３以上
	ELSEIF ABL:舌 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후우, 응응……앗 후훗 나도 갈 것 같아……후훗」","L"
					CALL HPH_PRINT,@"「있잖아, 같이……흐응! 하햣, 같이 가줘……읏하햣」","L"
					PRINTFORMDL 축축한 열기와 함께, 질척질척하게 성기를 빨아들이는 소리가 사방에 울린다.
					PRINTFORMDW 서로의 허리를 놓을 듯한 쾌감을 맛보며, 절정으로 치달았다.
				CASE 1
					CALL HPH_PRINT,@"「봐요…… 제 보지, 보이잖아요……? HPH」","L"
					CALL HPH_PRINT,@"「가고 싶어, 가게 해줘…… 움찔거리고 있어…… 하프하프」","L"
					PRINTFORMDL 도레미는 좌우로 천천히 허리를 움직이며 %조사처리(CALLNAME:MASTER,"의")% 시선을 고정시키고 있다.
					CALL HPH_PRINT,@"「제대로 저를 흥분시킬 수 있다면…… 그렇네요…… HPH」","L"
					CALL HPH_PRINT,@"「허리가 빠져서 못 일어날 정도로, 기분 좋게 사정시켜줘…… 응 아아앗 HPH」","L"
					PRINTFORMDW 그 말을 들은 순간, 이미 한계 직전이었던 %조사처리(CALLNAME:MASTER,"는")% 도레미의 은밀한 곳에 달려들었다.
				CASE 2
					CALL HPH_PRINT,@"「저기…… 하고 싶어……? HPH 하고 싶은 거야……? HPH」","L"
					CALL HPH_PRINT,@"「그렇다면, 나도 기분 좋게 해 줄까……? HPH」","L"
					PRINTFORMDL 거칠게 은밀한 곳을 밀어붙이는 도레미의 요구에 응하여 혀로 안쪽을 파고들어 준다.
					PRINTFORMDL 끊임없이 흘러넘치는 애액을 입안 가득 머금고 꿀꺽 소리를 내며 삼켜주자, 도레미의 질이 움찔 조여왔다.
					CALL HPH_PRINT,@"「흐으응! 후후, 방금 때문에 좀 갈 것 같아……후후」","L"
					CALL HPH_PRINT,@"「제대로 기분 좋게 해줬으니까…… 저도, 가게 해줄게요…… 쪽, 쭉 HPH」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「쭈읍, 주륵……앗 HPH…응읏 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 격렬한 공격에 도레미는 무심코 성기에서 입을 떼고 몸부림쳤다.
					CALL HPH_PRINT,@"「이제, 자제해 주세요…… HPH %MASTERNAME:109%를 기분 좋게 해줄 수가 없잖아요…… HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「흐으……큭! 응……큭! 주르륵……읏!」","L"
					PRINTFORMDL 도레미의 격렬한 공격에 자신도 모르게 봉사하는 것을 잊어버린다.
					CALL HPH_PRINT,@"(후후…… HPH %MASTERNAME:109%란, 내 입안에서 헤실헤실 허리를 흔들어 버리다니…… HPH)","L"
					PRINTFORMDW 허리를 작게 흔드는 %조사처리(CALLNAME:MASTER,"의")% 모습에 기분이 좋아진 도레미는 더욱 격렬하게 몰아붙였다...
				CASE 2
					CALL HPH_PRINT,@"「흐으윽! 후우... 핥아줘... 쪽... 츄읍... 흐으윽!」","L"
					CALL HPH_PRINT,@"「응하아……읏 HPH %MASTERNAME:109%, 기분 좋아요……? HPH」","L"
					CALL HPH_PRINT,@"「…후후, 그렇슴까……HPH 저도, 기분 좋아서……HPH」","L"
					CALL HPH_PRINT,@"「봐…… 봐…… HPH 아랫부분이, 꽉 조여오고 있잖아…… HPH」","L"
					PRINTFORMDW 「잘 보인다」%조사처리(CALLNAME:MASTER,"가")% 그렇게 말하자 도레미의 달콤한 구멍에서 대량의 애액이 흘러넘쳐 왔다
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후후, %MASTERNAME:109%의 이곳…… 움찔하며 줄어들고 있네요…… HPH」","L"
					PRINTFORMDL 도레미가 육봉에서 입을 떼고 손끝으로 음낭을 쓰다듬는다.
					CALL HPH_PRINT,@"「이거, 벌써 사정할 것 같다는 신호죠…… HPH」","L"
					CALL HPH_PRINT,@"「그럼, 기분 좋게 해줘야겠네…… HPH 아무…… 주루, 쮸큭HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「후후, 벌써 사정할 것 같으세요...? HPH」","L"
					CALL HPH_PRINT,@"「그럼 이리 와봐……응! 나도 가게 해줘……흐으윽」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 봉사가 멈춰있는 것을 꾸짖듯 도레미가 은밀한 곳을 얼굴에 밀착시킨다.
					CALL HPH_PRINT,@"「크큭, 괴로워……? HPH라도 그쪽이 더 기분 좋잖아요...? HPH」","L"
					CALL HPH_PRINT,@"「아응! 후후, 그 느낌대로……. 후후, 노력한 보상으로 가게 해 드릴게요……. 후후」","W"
				CASE 2
					CALL HPH_PRINT,@"「응, 으음! 흐읍... 그렇게 격하게 하다니 안 돼요... 흐읍」","L"
					CALL HPH_PRINT,@"「기분 좋아서, 집중을 못 하겠어…… %MASTERNAME:109%의 걸 가게 해줄 수가 없어……읏 HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미의 은밀한 곳을 탐하면서, 어서 받아먹으라고 말하듯 허리를 밀어 올린다.
					CALL HPH_PRINT,@"「흐응…… 큭, 하아아…… 정말이지, 어쩔 수 없는 사람…… 큭」","W"
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 애액을 맛보며, 가볍게 허리를 들고 성기를 도레미의 입에 밀어 넣는다.
					CALL HPH_PRINT,@"「흐윽!? 응응…… 흐으윽…… 큭!」","L"
					CALL HPH_PRINT,@"「흐으... 츄릅... 츄릅읏... HPH」","L"
					PRINTFORMDW 도레미는 살짝 구역질을 하면서도 육봉에게 봉사를 시작했다
				CASE 1
					CALL HPH_PRINT,@"「안 돼, 소리 내면 안 되는데, 아……읏 하아, 아앗 하아」","L"
					PRINTFORMDL 도레미의 허리를 단단히 붙잡고, 질척질척 사랑액을 빨아들인다.
					PRINTFORMDW 그 격렬함에 도레미는 완전히 봉사를 잊고, 허리를 떨며 신음했다…….
				CASE 2
					PRINTFORMDL 도레미에게 육봉을 핥게 하면서, 비결에 혀를 갖다 대고 간다.
					CALL HPH_PRINT,@"「응…… 큭힐 것 같아…… 큭히고 싶어…… 읏……」","L"
					PRINTFORMDW 쾌감에 몸을 떨면서도 도레미의 봉사는 멈추지 않았다
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K109_{SELECTCOM}_1
RETURN 1
