RETURN 1

@M_KOJO_MESSAGE_SCOM_K109_19_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「수유 손가락 자극? 그것은 대체 얼마나 깊은 행위인가...」
		PRINTFORMW 「...알았으니 그렇게 필사적으로 부탁하지 말아 달라」
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕 || TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「젖 맛있으려나아~? HPH……라니」","L"
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 도레미에게 무릎 베개로 누워 아기처럼 유두를 빨고 있다.
				PRINTFORMDW 그 사랑스러운 모습과는 달리, 도레미에게 다뤄지는 성기는 터질 듯이 발기해 있었다.
			CASE 1
				PRINTFORMDL 도레미는 %조사처리(CALLNAME:MASTER,"에게")% 수유하면서 발기된 성기를 다루고 있다.
				PRINTFORMDW 아기처럼 유두를 빠는 %조사처리(CALLNAME:MASTER,"를")%, 도레미는 모성으로 가득 찬 눈으로 바라보고 있었다.
			CASE 2
				PRINTFORML 「마치 젖 먹던 아기 같네요...」
				PRINTFORMDW 대답 대신 단단하게 발기한 유두를 빨아주자, 도레미는 %조사처리(CALLNAME:MASTER,"의")% 머리를 감싸 안고 몸을 비틀었다.
			CASE 3
				PRINTFORMDL 도레미의 능숙한 자위 행위에 나도 모르게 유두에서 입을 떼고 신음하고 만다.
				PRINTFORML 「이봐, 아기는 그렇게 기분 좋아 보이는 소리로 신음하지 않아」
				PRINTFORMDW 죄송해요, 도레미 엄마
			CASE 4
				CALL HPH_PRINT,@"「큰 아기네요…… 응읏 HPH」","L"
				PRINTFORMDW 단단하게 발기한 젖꼭지를 세게 빨아들이자, 도레미는 남근을 세게 움켜쥐고 쾌감에 몸부림쳤다.
		ENDSELECT
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「마치 젖 먹던 아기 같네요...」
				PRINTFORMDW 대답 대신 단단하게 발기한 유두를 빨아주자, 도레미는 %조사처리(CALLNAME:MASTER,"의")% 머리를 감싸 안고 몸을 비틀었다.
			CASE 1
				PRINTFORMDL 도레미의 능숙한 자위 행위에 나도 모르게 유두에서 입을 떼고 신음하고 만다.
				PRINTFORML 「이봐, 아기는 그렇게 기분 좋아 보이는 소리로 신음하지 않아」
				PRINTFORMDW 죄송해요, 도레미 엄마
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「설마 %MASTERNAME:109%가 이런 제안을 해올 줄은…」
				PRINTFORMDL 도레미에게 가볍게 밀려나면서도, %조사처리(CALLNAME:MASTER,"는")% 영아 퇴행이라도 한 듯 무심하게 유두를 빨고 있다.
				PRINTFORMDW 손쓸 일이 없어진 도레미는, %조사처리(CALLNAME:MASTER,"의")% 딱딱하게 발기한 페니스를 만지기 시작했다.
			CASE 1
				PRINTFORMDL 도레미의 차가운 시선을 받으면서도, 유두를 빨아들이는 움직임은 멈추지 않았다.
				PRINTFORMDW 이윽고 도레미도 포기한 듯, 어쩔 수 없다는 듯 남자의 성기를 움켜쥐었다.
		ENDSELECT
	ENDIF
ENDIF
