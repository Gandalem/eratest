;3,Gスポット刺激
;==================================================

@M_KOJO_MESSAGE_SCOM_K109_3
CALL M_KOJO_MESSAGE_SCOM_K109_3_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K109_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:処女
			PRINTFORML 「%MASTERNAME:109%, 그 이상은…… 앗 아파」
			PRINTFORMDL 도레미의 처녀 질을 %조사처리(CALLNAME:MASTER,"의")% 손가락이 왕복한다
			PRINTFORML 「저기, 부탁이에요…… 정말 터져버릴 것 같으니까……!?」
			PRINTFORMW 「흐윽, 크으윽…… 어째서 말해주지 않으시는 거예요……윽」
		ELSE
			CALL HPH_PRINT,@"「앗!? HPH라니…… 뭘……! HPH」","W"
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 손가락을 쏙 구부려 질 내부의 거친 곳을 자잘하게 문지른다.
			PRINTFORMDW 너무 강한 쾌감에 도레미는 몇 번이고 허리를 들썩이게 하고, 뚝뚝 애액을 흘리게 한다...
			CALL HPH_PRINT,@"「기다려읏 HPH 기다려줘 기다려줘읏 HPH 이거, 안 돼……읏 HPH 안 되니까……읏 HPH」","W"
			PRINTFORMDW 허리를 단단히 고정하고 집요하게 쓸어 올리자, 도레미는 머리를 감싸 쥐고 소리 없는 신음소만을 내뱉는다.
			PRINTFORMDW 잠시 여자의 약점을 가지고 놀던 %조사처리(CALLNAME:MASTER,"가")% 손가락을 빼내자, 여자 음부는 녹아내리듯 출렁이며 끊임없이 꿀을 흘리고 있었다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;処女
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TALENT:処女
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「아파앗, 아우윽……읏...」
				PRINTFORML 「응애… 조금만 더 부드럽게 해줘……읏」
				PRINTFORMDW G스팟을 자극하려 시도했으나 도레미가 아파서 그럴 상황이 아니었다.
			CASE 1
				PRINTFORML 「……아무리 풀어주기 위함이라 해도……」
				PRINTFORML 「처음인 손가락이라는 게…… 조금……」
				PRINTFORMDL 정말 찢어버리는 건 아니다. %조사처리(CALLNAME:MASTER,"는")% 그렇게 스스로를 타이르며 도레미의 질내를 애무한다.
				PRINTFORML 「……응…… 윽」
				PRINTFORMDL 도레미가 통증으로 얼굴을 찡그리자 손가락을 빼보니, 약간 피가 묻어 있었다.
				PRINTFORMDW 부주의하게 막을 상처를 내버린 모양이다…… 조심해야 한다
			CASE 2
				PRINTFORML 「우, 거짓말…… 피가……」
				PRINTFORML 「설마…… 터뜨린 건가요……?」
				PRINTFORMDW 점막을 상하게 했을 뿐이다. %조사처리(CALLNAME:MASTER,"는")% 적당히 얼버렸다.
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;バイブ挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TEQUIP:バイブ
		;Ｖ感覚６以上
		IF ABL:Ｖ感覚 >= 6
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응후으읏 HPH %MASTERNAME:109%읏 HPH 잠깐만요! HPH 멈춰주세요! HPH」","L"
					PRINTFORMDL 미세하게 꿈틀거리는 바이브가 도레미의 G스팟을 흔든다.
					PRINTFORMDL 아무리 소리를 질러도, 기계는 무정하게 여자의 약점을 계속 공격했다.
					CALL HPH_PRINT,@"「아, 아윽! 안돼읏! 가버릴 것 같아읏! 갈 거야아앙! 하으윽 하으윽」","W"
				CASE 1
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 바이브를 한계까지 뽑아낸 후, 진동 스위치를 최강으로 바꾸었다.
					PRINTFORMDL 그리고 그대로, 질의 천장을 쓸어 올리듯 천천히 밀어 넣는다……
					CALL HPH_PRINT,@"「아, 갈 것 같아……! HPH 바이브가, 절대로 가버릴 곳에 닿아 버려……! HPH」","L"
					CALL HPH_PRINT,@"「……큿아! 아아아앗! 흐으윽흐윽, 아아앙!」","W"
					PRINTFORMDW 진동하는 바이브가 G스팟을 문 순간, 도레미는 성대한 사정을 내뿜으며 절정에 달했다……
				CASE 2
					CALL HPH_PRINT,@"「있잖아……있잖아읏 HPH %MASTERNAME:109%읏HPH」","L"
					CALL HPH_PRINT,@"「그렇게 얕은 곳 말고…… 기분 좋아지는 곳, 문질러 줘…… 읏흐으」","L"
					CALL HPH_PRINT,@"「미치도록 가고 싶어……!! 하아, 흐으응! 하아, 후우욱! 하아, 후우욱!」","L"
					PRINTFORMDW 당신이 원하는 대로 G스팟을 자극해주자, 도레미는 망가진 것처럼 허리를 경련시키며 대량으로 절정에 올랐다...
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응, 하아……읏 HPH 진동이, 전해져 와……읏 HPH」","L"
					PRINTFORMDL 손으로는 결코 느낄 수 없는 진동에 여자의 약점이 흔들리자, 도레미는 괴로운 듯 허리를 비튼다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 장난치고 싶어져 진동 단계를 한 단계 높여보았다.
					CALL HPH_PRINT,@"「흐, 아앗 HPH 그만해읏 HPH 약하게 해줘읏 HPH 응응읏 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「이런 것보다 나는 %MASTERNAME:109%의……읏 HPH」","L"
					PRINTFORMDL 질 내에 삽입한 바이브를 애태우듯이 천천히 움직인다.
					PRINTFORMDL 도레미는 복잡한 표정이었지만, G스팟을 집중적으로 문질러 주자 금세 표정이 녹아내렸다.
					CALL HPH_PRINT,@"「흐으윽……! 하지만 이거…… 좀 좋은지도 몰라요……! 흐으윽」","W"
				CASE 2
					CALL HPH_PRINT,@"「앗, 원래도 예민한 곳인데 거긴……. 큭흐윽!」","L"
					CALL HPH_PRINT,@"「흐, 윽 HPH 음음~!! HPH」","L"
					PRINTFORMDL 평소에는 태평한 도레미가 쾌락에 휘둘리며 귀엽게 신음하고 있다.
					PRINTFORMDW 그 광경이 %조사처리(CALLNAME:MASTER,"를")% 매우 흥분시켰다……
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｖ感覚６以上
	ELSEIF ABL:Ｖ感覚 >= 6
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아, 응……윽 후후 기분 너무 좋아서…… 이상해질 것 같아…… 큭!」","L"
				PRINTFORMDL 아직 여유가 있어 보여. %조사처리(CALLNAME:MASTER,"는")% 도레미의 아랫배를 누르며 G스팟을 집요하게 자극했다
				CALL HPH_PRINT,@"「아, 히, 잠깐만엣 HPH 정말, 이상해……앗 HPH」","L"
