@M_KOJO_EVENT_K109_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕
					PRINTFORMDL 스윽, 옷깃 스치는 소리가 정적인 공간에 울린다.
					PRINTFORMDL 도레미는 스트립을 하는 것처럼 %조사처리(CALLNAME:MASTER,"를")% 애태우며, 마침내 태어난 그대로의 모습이 되었다.
					CALL HPH_PRINT,@"「자아…… 당신도 벗어요…… HPH」","W"
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORMDL 거친 숨을 몰아쉬며 옷을 벗어가는 도레미의 몸을 시간하는
					CALL HPH_PRINT,@"「자, 계속을……꺅 하아앗」","L"
					PRINTFORMDW 참지 못하게 된 %조사처리(CALLNAME:MASTER,"는")% 도레미에게 달려들어 몸을 더듬었다
				ELSE
					PRINTFORMW 「역시 익숙하지 않네요……」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕
					PRINTFORML 「어떤 속옷을 입어야 %조사처리(CALLNAME:MASTER,"가")% 흥분할지…… 매일 고민하고 있답니다」
					PRINTFORMDL 천천히 드러나는 피부에서 %조사처리(CALLNAME:MASTER,"는")% 눈을 떼지 못한다.
					CALL HPH_PRINT,@"「……감상, 들려줘 봐요. 물론 말 말고 행동으로…… HPH」","W"
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORMDL 침을 삼키는 %조사처리(CALLNAME:MASTER,"의")% 반응을 즐기듯 도레미가 원피스를 벗어간다.
					PRINTFORMDL 천천히 드러나는 피부에서 %조사처리(CALLNAME:MASTER,"는")% 눈을 뗄 수 없었다.
					CALL HPH_PRINT,@"「...네, 벗었어요 HPH」","W"
				ELSE
					PRINTFORMW 「……네, 이걸로 괜찮으세요?」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					;通常
				ELSEIF TALENT:恋慕
					CALL HPH_PRINT,@"「옷 입은 채로 하고 싶다니…… 변태네요……. HPH」","L"
					PRINTFORMDL 선정적인 미소를 지은 도레미는 보여주듯이 치마를 들춰 올린다
					CALL HPH_PRINT,@"「옷에 섹스 향기가 배어서…… 아아, 했다고 모두에게 들켜 버릴지도 몰라…… HPH」","L"
					PRINTFORMDW 그것도 좋다고, %조사처리(CALLNAME:MASTER,"는")% 황홀한 시선으로 도레미를 끌어안았다.
				ELSEIF TALENT:愛欲 || TALENT:セフレ || TALENT:ヤリマン
					PRINTFORMDL 옷을 벗으려던 도레미를 짓누르고, 그대로 몸을 더듬어 간다.
					CALL HPH_PRINT,@"「...응앗 HPH 옷에 주름이 생겼어... 정말, 골치 아픈 사람이네요... HPH」","W"
					PRINTFORMDW 옷이 더러워지면 어쩌지. 구겨지면 어떡하지. 그런 건 나중에 생각하면 된다고 도레미는 생각했다
				ELSE
					PRINTFORMW 「현실적인 문제로 더러워진 옷을 빨래하는 게 힘들잖아요」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「등가 교환이에요. 제 팬티 반 드릴 테니 당신 팬티 반 주세요」
							PRINTFORMDW 팬티를 두 조각으로 만들 건지, 가진 팬티를 반씩 나눠 가질 건지……
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORML 「자아 드세요」
							PRINTFORMDW 도레미는 말아 놓은 속옷을 던져 옆에 두었다.
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「당신의 변태 취미에 맞춰주는 나도 나지만 말이죠……」
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							PRINTFORMW 「저기, 아니 상당히 실망스러운데요」
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
