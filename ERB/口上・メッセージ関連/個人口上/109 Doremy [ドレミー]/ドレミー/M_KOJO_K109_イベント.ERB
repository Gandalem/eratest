	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;サグメが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 110
		;恋人
		IF TALENT:恋人
			PRINTFORML 「사구메 씨, 딱 좋은 곳에 오셨네요」
			PRINTFORML 「들어주세요. 제 남자친구 자랑을」
			PRINTFORMDW 사구메는 매우 귀찮은 듯하다……
			;恋慕
		ELSEIF TALENT:恋慕
			PRINTFORML 「사구메 씨가 동료가 되고 싶다는 듯이 이쪽을 보고 있어……」
			PRINTFORML 「동료로 해드릴까요?」
			PRINTFORMDW 당신은 일단 『네』라고 대답해 두었다.
			;思慕
		ELSEIF TALENT:思慕
			PRINTFORML 「누구신가 했더니 사구메 씨」
			PRINTFORML 「……조금 피곤해 보이시네요? 제대로 자야 해요?」
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 사구메 쪽으로 시선을 돌렸다…….
			;それ以外
		ELSE
			PRINTFORML 「어머, 사구메 씨」
			PRINTFORML 「이쪽 분이요? 제 친구예요」
			PRINTFORMDW 「그렇지?」라며 %조사처리(CALLNAME:TARGET,"가")% 이쪽으로 윙크해 왔다.
		ENDIF
		RETURN 1
	ENDIF
	;その他（キャラ指定なし
	;恋人
	IF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……후훗」
				PRINTFORMDL 무슨 생각을 했는지, %조사처리(CALLNAME:TARGET,"는")% 일부러 당신에게 안겨보였다.
				PRINTFORMW 「무슨 용무신가요? 저희는 보시는 대로 바쁘답니다」
			CASE 1
				PRINTFORML 「――누군가 왔나? 나는 신경 안 써요?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 당신에게서 떨어지지 않는다
				PRINTFORMDW 오히려 몸을 더 밀착시켜 왔다
			CASE 2
				PRINTFORML 「무슨 용건이세요? 제 연인에게」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 보여주듯이 팔짱을 끼고 다가온다.
				PRINTFORMDW 상대는 쓴웃음을 지을 수밖에 없었다.
		ENDSELECT
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「……이続き는 나중에 다시 하자」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 그렇게 귓속말을 하자,
				PRINTFORMDW 스르륵 당신에게 감고 있던 꼬리를 풀어헤쳤다
			CASE 1
				PRINTFORML 「분위기를 파악하지 못하는 방황하는 어린 양이……」
				PRINTFORML 「――후훗, 그저 사자의 허튼 소리일 뿐이다」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 평소와 같은 느긋한 얼굴로 들어온 인물에게 인사했다
			CASE 2
				PRINTFORML 「정말 아쉽네요」
				PRINTFORML 「조금만 더……이었는데」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 그렇게 말하며, 흘깃한 눈빛으로 이쪽을 향해 윙크를 해왔다.
		ENDSELECT
		;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「방황하는 어린 양이 계신 것 같아요」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 당신에게서 조금 떨어지자,
				PRINTFORMDW 「저쪽에」라며 당신의 뒤를 손가락으로 가리켰다
			CASE 1
				PRINTFORML 「……어떻게 할까요?」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 자연스럽게 몸을 기울이며,
				PRINTFORMDW 들어온 인물을 흘긋 보고 당신에게 속삭였다.
			CASE 2
				PRINTFORML 「저에게 무슨 용무가 있으신가요」
				PRINTFORML 「아니면, 이쪽 분께요?」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 몸을 떨어뜨리더니 언제나처럼 영업 미소를 지었다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「어라, 당신은」
				PRINTFORMDL %조사처리(CALLNAME:TARGET,"가")% 한 걸음 당신에게서 멀어진다
				PRINTFORMDW 포이(Poi)가 터져 금붕어가 도망친 듯한 그런 감각이었다
			CASE 1
				PRINTFORML 「%MASTERNAME:109%」
