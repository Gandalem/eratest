@NAME_SET_K109
PRINTL 이름을 입력하세요 (좋은 호칭이 있다면 자유롭게 추가해도 됩니다)
IF !GROUPMATCH(NAME:MASTER, "あなた", "Player")
	LOCALS = %CALLNAME:MASTER%
ELSE
	LOCALS = %NAME:MASTER%
ENDIF
PRINTBUTTON @"[%LOCALS%로 설정한다.]", @"%LOCALS%"
PRINTL 　
;名前を入力するループ
$INPUT_LOOP_ONAMAE
INPUTS
; 行頭行尾の空白文字削除
LOCALS = %RESULTS%
REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
;10文字以上は受け付けない
IF STRLENS(LOCALS) > 16
	CLEARLINE 1
	REUSELASTLINE Name is too long.
	GOTO INPUT_LOOP_ONAMAE
	;空白は受け付けない
ELSEIF RESULTS == ""
	PRINTL 무언가를 입력해야 한다.
	GOTO INPUT_LOOP_ONAMAE
ELSE
	PRINTFORML 이름은 %RESULTS%로 설정될 예정인데, 확인하시겠습니까?
	CALL ASK_YN
	IF RESULT == 0
		;あなたの名前を%MASTERNAME:109%に格納
		MASTERNAME:109 = %RESULTS%
		PRINTFORML 
	ELSE
		PRINTL 이름을 입력하세요.
		GOTO INPUT_LOOP_ONAMAE
	ENDIF
ENDIF

