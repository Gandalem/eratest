@M_KOJO_EVENT_K109_29(ARG,ARG:1)
;口上主はTARGET
;ARGはTARGETの度胸で分岐
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;怒らせてしまった
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TCVAR:109:400 == 0
			TCVAR:109:400 = 1
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「………」
					PRINTFORMDW 카, 봐줘... 도레미... 제발 좀 봐달라고...읏
					PRINTFORMDW 나... 어, 이 몸... 앞으로 어떻게 해야 하는 거지... 응? 도레미...
					PRINTFORMDW 가르쳐 줘... 가르쳐 주지 않겠지... 이제...
				CASE 1
					PRINTFORML 「환서향에서 가장 온순한 나를 화나게 하다니, 실력이 대단하네요」
					PRINTFORMDW 그런 거 몰랐는데……
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「……하아…」
					PRINTFORMDW 도레미는 아직 화가 난 듯하다
				CASE 1
					PRINTFORML 「………」
					PRINTFORMDW 도레미는 뚱한 표정이다.
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;泣かせてしまった　[臆病]持ち
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
