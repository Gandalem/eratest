		PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 한숨을 쉬며 옷매무새를 가다듬었다.
		TCVAR:109:発情 = 0
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		IF TALENT:恋慕
			CALL HPH_PRINT,@"「하아…… 기분 좋았어…… 후후」","L"
			PRINTFORMDL 욕망을 완전히 발산한 도레미는 피부를 윤기나게 만들고 만족스러워한다.
			CALL HPH_PRINT,@"「……또, 하자구… HPH」","L"
			PRINTFORMDW 녹아내릴 듯한 목소리로 귓가에 속삭여지자, %조사처리(CALLNAME:MASTER,"는")% 당장이라도 하고 싶다는 충동에 사로잡혔다…
			TCVAR:109:発情 = 0
		ELSE
			PRINTFORML 「저기... 이런 일에 함께하게 해서 죄송해요」
			PRINTFORMDL 도레미는 %조사처리(CALLNAME:MASTER,"를")% 성적으로 몰아붙인 것을 후회하는 듯하다.
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")%, 기분 좋았으니까 괜찮다고 도레미를 위로했다.
			TCVAR:109:発情 = 0
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		CALL HPH_PRINT,@"「크스윽 HPH 다음은 %CALLNAME:MASTER%차례인가요... HPH」","L"
		PRINTFORMDL 도레미는 혀를 날름거리며 자신을 뜨겁게 바라본다.
		PRINTFORMDW 열에 들뜬 한 쌍의 연인은 녹아내리듯 피부를 맞대어 갔다…
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		PRINTFORML 「당신이 그런 말을 하다니 의외네요」
		PRINTFORML 「그렇게 말한다면…… 부숴 드릴게요. 철저하게♪」
		PRINTFORMDW 도레미는 혀를 날름거리며 다시 입맞춤을 시작했다……
		RETURN 1
	ENDIF
ENDIF
RETURN 1
