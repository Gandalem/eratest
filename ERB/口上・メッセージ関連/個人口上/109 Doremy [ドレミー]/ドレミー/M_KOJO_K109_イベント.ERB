					CASE 1
						PRINTFORML 「%MASTERNAME:109%, 떨어뜨렸어요」
						PRINTFORMDL 『잃어버린 물건?』라고 당신은 %조사처리(CALLNAME:TARGET,"가")%(1)에게 되돌아본다
						PRINTFORMDW ……%조사처리(CALLNAME:TARGET,"가")% 건넨 것은, %TEXTR("パンの袋を留める/針に糸を通す時に使う銀色の/弁当の仕切りによく使われる緑色の/")%저것이었다
					CASE 2
						PRINTFORM 「자,」
						;朝昼晩で分岐
						SELECTCASE TIME:2
							;朝
							CASE 1,2
								PRINTFORML 「좋은 아침이에요」
								;昼
							CASE 3,4
								PRINTFORML 「안녕하세요」
								;夜
							CASE 5,6,7
