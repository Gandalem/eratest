;-------------------------------------------------
;Communication
;コミュニケーション
;-------------------------------------------------
;==================================================
;Get closer ("CHARACTER gets a little closer to you...")
;距離が近い
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EGG_MESSAGE_COUNTER_MESSAGECHECK_K51_1
RETURN 0

@M_KOJO_EGG_MESSAGE_COUNTER_K51_1
IF TALENT:51:恋人
	IF TALENT:51:機嫌 == -1
		PRINTFORML 「Can I have a hug? I feel really bad right now...」
		PRINTFORMDL She acts clingy with you while fighting back tears.
	ELSEIF GET_TARGETNUM() > 4 || WITH_MOB() || DATE_HITOGOMI(CFLAG:MASTER:現在位置)
		PRINTFORML 「%SPLIT_G(@"Do we look like a regular couple?:Are they looking at us?:I feel better with you here.:What? Just hold my hand.")%」
		PRINTFORMDL She looks shyly at all of the people around.
	ELSE
		SELECTCASE RAND:7
			CASE 0
				SIF CFLAG:MASTER:現在位置/100 == 10 ;Seasonal lines don't make sense on the moon.
					RESTART
				IF OUTROOF(CFLAG:MASTER:現在位置)
					IF TALENT:MASTER:体型 < -1 && !RAND:2 ;Child-Sized or smaller.
						PRINTFORML 「Be careful or some youkai will swoop down and pick you up!」
						PRINTFORMDL She puts her hands on you as if to keep you on the ground.
					ELSE
						SELECTCASE DAY:2
							CASE 1
								PRINTFORML 「Doesn't the air smell nice in spring? I love this season.」
								PRINTFORMDL Nitori takes in a deep, slow breath.
							CASE 2
								PRINTFORML 「Are you hot? Want an ice pack?」
								PRINTFORMDL Seems like she's thinking about your health in the summer air.
							CASE 3
								PRINTFORML 「Look over there, isn't it pretty?」
								PRINTFORMDL Nitori tugs on you to show you the fall colors.
								IF IS_HERE(77)
									PRINTFORMDL Shizuha giggles.
									CALL CHARA_TEXT(77,@"「Romantic, isn't it?」","l")
								ENDIF
							CASE 4
								CALL HPH_PRINT(@"「Hey... Give me a hug to warm up?HPH」","l")
								PRINTFORMDL Nitori shivers in the cold air.
						ENDSELECT
					ENDIF
				ELSEIF MAIN_MAP == 7 && CFLAG:MASTER:現在位置 == 704
					PRINTFORML 「%SPLIT_G(@"Watch out. Someone's eyeing you:Be careful, she's spotted you:Look out, here she comes:Uh-oh, she's after you")%...」
					CALL K51_EGG_KAPPA_TEXT(2,@"「%CALLNAME:MASTER%! %SPLIT_G(@"We need investment money!:Wanna ride our new test rocket?:We need blood donations!:Can we borrow one of your organs?:Wanna sell your teeth? We'll pay you the highest rate!")%」","l")
					PRINTFORML 「I knew it! Hey, %HE_SHE(MASTER)%'s not interested!」
					PRINTFORMDL Nitori fiercely protects you from the hideout's local predators.
				ELSE
					RESTART
				ENDIF
			CASE 1
				PRINTFORML 「I'm not in your way, am I?」
				PRINTFORMDL She links her arm around yours as she asks the question.
				PRINTFORML 「Really, I can back up.」
				PRINTFORMDL So she says while gluing herself to your side.
				PRINTFORMDL You probably can't convince her to back up...
			CASE 2
				PRINTFORML 「Watch out, there's a kappa following you.」
				PRINTFORMDL She links her arm with yours while smirking mischievously.
				PRINTFORML 「She'll take your shirikodama～」
			CASE 3
				PRINTFORML 「What? Am I too close?」
				PRINTFORML 「I'm your girlfriend, so I'm never too close, got that?」
				PRINTFORMDL Declaring so, she grabs your arm and clings to your side.
			CASE 4
				PRINTFORML 「Whatcha up to?」
				PRINTFORMDL Nitori invades your space so closely that her cheek rubs against your body.
				PRINTFORML 「Tell meee～」
			CASE 5
				PRINTFORMDL She takes your hand in hers and squeezes it without saying anything.
				PRINTFORMDL You ask her what she's doing and she smiles at you.
				PRINTFORML 「Holding hands.」
				PRINTFORMDL It's that simple, then...
			CASE 6
				IF TALENT:MASTER:体型 >= TALENT:51:体型
					PRINTFORMDL She leans her body fully into yours and grips the edges of your clothing in her small hands.
				ELSE
					PRINTFORMDL She hovers over you and holds your elbows in her hands.
				ENDIF
				PRINTFORMDL You turn to look at her...
				PRINTFORML 「What is it, %PRINT_MALE("boy:girl",MASTER)%friend?～」
				PRINTFORMDL She smiles cutely at you while hanging on.
		ENDSELECT
	ENDIF
ELSE
	IF TALENT:51:機嫌 == -1
		PRINTFORML 「Mmm... Huh? ...It's nothing.」
		PRINTFORMDL Distracted by her sullen mood, she doesn't seem to realize how close she's standing...
	ELSEIF GET_TARGETNUM() > 4 || WITH_MOB() || DATE_HITOGOMI(CFLAG:MASTER:現在位置)
		PRINTFORML 「%SPLIT_G(@"Um, don't mind me...:I'm not hiding or anything.:What? I'm not doing anything...:Am I too close? Don't worry about it.")%」
		PRINTFORMDL She looks shyly at all of the people around.
	ELSE
		SELECTCASE RAND:6
			CASE 0
				SIF CFLAG:MASTER:現在位置/100 == 10 ;Seasonal lines don't make sense on the moon.
					RESTART
				IF OUTROOF(CFLAG:MASTER:現在位置)
					IF IS_CHILD(MASTER) && !RAND:2
						PRINTFORML 「Gensokyo's dangerous for children, so stick close to me, all right?」
					ELSE
						SELECTCASE DAY:2
							CASE 1
								PRINTFORML 「The spring air feels kinda nice, doesn't it?」
								PRINTFORMDL Nitori seems to be in a positive mood.
							CASE 2
								PRINTFORML 「It's soooo hot out...」
								PRINTFORMDL Nitori fans herself in a daze, unaware that she's wandered close to you.
								PRINTFORMDL You can see droplets of sweat forming on her skin.
							CASE 3
								PRINTFORML 「The fall colors out here are so pretty...」
								PRINTFORMDL Nitori watches the falling leaves.
								IF IS_HERE(77)
									CALL CHARA_TEXT(77,@"「Yay, that's my doing～」","l")
									PRINTFORMDL Shizuha looks proud.
								ENDIF
							CASE 4
								PRINTFORML 「I-I'm a little cold, that's all.」
								PRINTFORMDL Nitori shivers while clinging to you for heat.
						ENDSELECT
					ENDIF
				ELSEIF MAIN_MAP == 7 && CFLAG:MASTER:現在位置 == 704
					PRINTFORML 「%SPLIT_G(@"Watch out. Someone's eyeing you:Be careful, she's spotted you:Look out, here she comes:Uh-oh, she's after you")%...」
					CALL K51_EGG_KAPPA_TEXT(2,@"「%SPLIT_G(@"Want a great deal on tools? We've got alternative payment options!:Heeeey! Can I buy your shirikodama?:Wanna invest your money and get rich? I've got a great opportunity for you!:Hey! Hey! Let's make a deal! You'll make big money!")%」","l")
					PRINTFORML 「Don't go with her, you'll regret it.」
					PRINTFORMDL Nitori tugs on your clothes to pull you away from the approaching kappa.
				ELSE
					RESTART
				ENDIF
			CASE 1
				PRINTFORML 「Wh-What? It's no big deal, right?」
				PRINTFORMDL Despite saying so, she looks nervous at being so close.
			CASE 2
				PRINTFORML 「I-I'm really close? Oh, I didn't realize...」
				PRINTFORMDL She backs away from you while blushing.
			CASE 3
				PRINTFORML 「So, what are you up to?」
				PRINTFORMDL She starts making small talk in a forward manner.
			CASE 4
				PRINTFORML 「Am in your way? It's the backpack, isn't it...」
				PRINTFORMDL She tries to position herself out of the way without backing up.
			CASE 5
				PRINTFORML 「Wh-what?」
				PRINTFORMDL She hesitates and becomes flustered when you look at her.
				PRINTFORML 「I'm not gonna take your shirikodama, all right?」
				PRINTFORMDL Is that what she thinks the problem is?
		ENDSELECT
	ENDIF
ENDIF
WAIT
RETURN 1

;==================================================
;Gaze ("You can feel CHARACTER's glances...")
;チラ見
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EGG_MESSAGE_COUNTER_MESSAGECHECK_K51_2
RETURN 0

@M_KOJO_EGG_MESSAGE_COUNTER_K51_2
IF TALENT:51:恋人
	SELECTCASE RAND:5
		CASE 0
			PRINTFORMDL When you turn to look, she stares into your eyes.
			PRINTFORMDL ...What's that look for?
			IF TALENT:51:恋慕 && !RAND:2
				PRINTFORML 「Love, I guess...」
				PRINTFORMDL With that vague statement, she shuts up and continues to stare.
			ELSE
				PRINTFORML 「I just thought you looked kinda %PRINT_MALE("handsome:cute",MASTER)%.」
				PRINTFORMDL Her admiring stare grows steadily more powerful...
			ENDIF
		CASE 1
			PRINTFORMDL You turn and ask what she's looking at.
			PRINTFORML 「%SPLIT_G(@"You:My %PRINT_MALE("boy:girl",MASTER)%friend:Someone really %PRINT_MALE("handsome:cute",MASTER)%")%.」
			PRINTFORMDL You might have guessed that much...
		CASE 2
			PRINTFORMDL You ask her if she wants something.
			PRINTFORML 「Yeah, I wanna watch you.」
			PRINTFORMDL Everyone's happy, then...
		CASE 3
			PRINTFORMDL You ask her what's up.
			PRINTFORML 「I'm burning your face into my memory.」
			PRINTFORMDL Is she trying to remember you in case you're ever gone?
			PRINTFORML 「Well, with machines there's a risk of disfigurement.」
			PRINTFORMDL ...What a frightening thought.
		CASE 4
			PRINTFORMDL When you turn to face her, she speaks up.
			PRINTFORML 「Seeing you made me think of a new invention.」
			PRINTFORMDL Does that mean you're an inspiration?
			PRINTFORML 「Yeah! Like a funny-shaped cloud.」
	ENDSELECT
ELSE
	SELECTCASE RAND:5
		CASE 0
			PRINTFORMDL ...But when you meet her eyes, she looks away in a hurry.
			PRINTFORML 「I-I wasn't staring.」
			PRINTFORMDL She shuffles around awkwardly while trying to avoid looking at you again.
		CASE 1
			PRINTFORMDL ...But when you meet her eyes, she freezes up. Did she want something?
			PRINTFORML 「Um, no, nothing...」
			PRINTFORMDL She looks away while blushing.
		CASE 2
			PRINTFORMDL You stare at her back and she becomes self-conscious.
			PRINTFORML 「...What? Why are you looking at me like that...」
			PRINTFORMDL Wasn't she doing it first?
			PRINTFORML 「N-No I wasn't! You were imagining it.」
		CASE 3
			PRINTFORMDL You try to ignore it, but when you finally meet her eyes, she gives a small squeak.
			PRINTFORML 「Ah!」
			PRINTFORMDL She hurriedly pretends to be doing something...
		CASE 4
			PRINTFORMDL When you turn to face her, she suddenly becomes aware she was staring.
			PRINTFORML 「I-I was just thinking about a new invention...」
	ENDSELECT
ENDIF
WAIT
RETURN 1

