							LOCALS:3 = It'd never work
						CASE 2
							LOCALS = battery
							LOCALS:1 = petroleum engine
							LOCALS:2 = biodiesel
							LOCALS:3 = It's not enough
						CASE 3
							LOCALS = hard drive
							LOCALS:1 = solid state
							LOCALS:2 = flash storage
							LOCALS:3 = The load times will be awful
					ENDSELECT
