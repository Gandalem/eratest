SIF BeforeLineCount == LINECOUNT
		;Abort if nothing was printed because the target has no interaction.
	RETURN 0
RETURN 1

@K51_EGG_CONVERSATION_CHILDREN(Child=-1,ChildCallName,Counter)
#DIM DYNAMIC Child
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC Counter
CALL K51_EGG_CONVERSATION_MESSAGE(8,Child,ChildCallName,Counter)
$TOP
IF Child == -1
		;Parenthood in general.
	SELECTCASE RAND:6
		CASE 0
				;Getting used to being a mother.
			LOCAL = 1000
			SIF CFLAG:51:子供人数 < CHARANUM
					;Get how long she's been a mother by the age of the first one unless it's overflowed.
				LOCAL = DAY-CHILD_BIRTHDAY:51:1
			SELECTCASE LOCAL
				CASE IS < CHILD_喋る
						;Can't talk yet.
					PRINTFORML 「%SPLIT_G(@"I wish kids came with a manual...:Um, right, did I remember everything? I'm not forgetting anything, am I?:I feel so anxious all the time now... It's fine! I'm doing fine! No problem!:Guuugghh... I wish I could take a break...:There's gotta be some invention to make this easier...")%」
					PRINTFORMDL She looks %SPLIT_G(@"tired:exhausted:more tired than usual:run ragged:a bit high-strung")%.
				CASE IS < CHILD_就学
						;Before schooling.
					PRINTFORML 「%SPLIT_G(@"It was a huge adjustment, but I think we've got the hang of being parents, right?:Y'know, I didn't think it would be so rewarding. Having kids, I mean.:It's still so hard, but I kinda feel... happy, y'know?:I've started doing playtime at the same time as I build prototypes. It works pretty well!")%」
					PRINTFORMDL She seems to have gotten used to being a mother.
				CASEELSE
						;School age and beyond.
					PRINTFORML 「%SPLIT_G(@"Remember to spend time with \@ CFLAG:51:子供人数 > 1 ?the kids! They need#%CHILDNAME:51:1%! A growing mind needs\@ \@ IS_MALE(MASTER) ?fatherly#twice as much motherly\@ love!:Are we the best parents in the world, or what?:Raising children is easy! And it doesn't get boring, either!:\@ CFLAG:51:子供人数 > 1 ?Make time for every child! We can't play favorites!#I could definitely handle another kid by now. It's not that hard!\@")%」
					PRINTFORMDL %SPLIT_G(@"Her pride as a mother shows through as she talks.:She speaks proudly of your \@ CFLAG:51:子供人数 > 1 ?children#child\@.:The two of you share in your success as parents.:She wears a look of satisfaction as you talk about it with her.")%
			ENDSELECT
		CASE 1
				;Work/life balance.
			PRINTFORML 「%SPLIT_G(@"Gotta be more careful with the time budget... I'll always make time for \@ CFLAG:51:子供人数 > 1 ?the kids#%CHILDNAME:51:1%\@!:It's tougher when I get into a project now, because it makes me forget \@ CFLAG:51:子供人数 > 1 ?the kids#my responsibilities\@...」\n「...Well, it can be a way to bond, too, right?:Maybe I should get a nanny so I can focus more... No, I wouldn't trust anybody with \@ CFLAG:51:子供人数 > 1 ?the kids#%CHILDNAME:51:1%\@.")%」
		CASE 2
				;Supplies.
			PRINTFORML 「%SPLIT_G(@"I've got to stock up again soon... \@ CFLAG:51:子供人数 > 1 ?They eat#%CHILDNAME:51:1% eats\@ so much!:It's a good thing we've got our own growing operation. Cucumbers come cheap and we can always feed \@ CFLAG:51:子供人数 > 1 ?the kids#%CHILDNAME:51:1%\@.:Guh, salt is so expensive when you've got \@ CFLAG:51:子供人数 > 1 ?so many mouths#another mouth\@ to feed...:Do we have enough supplies for the week? ...Maybe I should shop around again.")%」
		CASE 3
				;How things used to be.
			PRINTFORML 「%SPLIT_G(@"Just think, I used to wake up whenever I felt like it...:Even with the other kappa, I used to be so independent. I never could've imagined my life now...!:Every day is so much more lively than things used to be. Kinda feels like time's slowed down a bit, you know?:I never thought I could do so much in a day before having \@ CFLAG:51:子供人数 > 1 ?kids#%CHILDNAME:51:1%\@... Heh.")%」
			PRINTFORMDL Nitori smiles pleasantly.
		CASE 4
				;Using the children.
			LOCAL = FIND_CHILD("51","Learning manners-Attending school")
			IF LOCAL
				ChildCallName '= CHILDNAME:51:LOCAL
				PRINTFORML 「%SPLIT_G(@"\@ CFLAG:51:子供人数 > 1 ?The kids have#%ChildCallName% has\@ been helping me with assembly. We've got such great teamwork, you know!:We can use \@ CFLAG:51:子供人数 > 1 ?the kids#%ChildCallName%\@ for free advertising. Business is going to take off!:I feel so lucky to have \@ CFLAG:51:子供人数 > 1 ?the kids#%ChildCallName%\@. Now I don't have to carry everything myself when we go to market!")%」
			ELSE
				GOTO TOP
			ENDIF
		CASE 5
				;Having another one.
			IF TALENT:51:妊娠
				PRINTFORML 「%SPLIT_G(@"I can't wait...:What do you think %BABYPLNOUN("this",51)% %BABYPLNOUN("one",51)% will be like?:It's gonna be a lot busier soon...:I hope our kids can get along...")%」
				PRINTFORMDL Nitori puts her hands on her belly and smiles.
			ELSEIF TALENT:51:妊娠願望
				PRINTFORML 「%SPLIT_G(@"I hope we can get \@ PREGNANCY_MULTIPLES(51) ? more # another one \@... You'd better try hard to put \@ PREGNANCY_MULTIPLES(51) ? some # one \@ in me, %K51_EGG_MASTER()%!:Being a parent is everything my life was missing. I so want \@ PREGNANCY_MULTIPLES(51) ? more # another one \@!:I'm so ready to have \@ PREGNANCY_MULTIPLES(51) ? more kids # another kid \@...")%」
				PRINTFORMDL She blushes as she urges you to give her another child.
			ELSE
				LOCAL = 1000
				SIF CFLAG:51:子供人数 < MAXCHILD
					LOCAL = DAY-CHILD_BIRTHDAY:51:1
				SELECTCASE LOCAL
						;Check the age of Nitori's oldest child if she has fewer than the maximum.
					CASE IS < CHILD_喋る
							;Can't talk yet.
						PRINTFORML 「When I think about how I might someday have another one...」
						IF !RAND:4
							PRINTFORMDL Nitori lets out a loud groan.
						ELSE
							PRINTFORMDL Nitori pauses for a moment.
							PRINTFORML 「%SPLIT_G(@"...No, no way. It's just impossible!:...As expected, I can't imagine it.:...Actually, I'm gonna stop thinking about it.")%」
						ENDIF
					CASE IS < CHILD_就学
							;Before schooling.
						PRINTFORML 「%SPLIT_G(@"Could I handle \@ PREGNANCY_MULTIPLES(51) ? more # another one \@? ...Maybe... I don't know if I'm ready for that yet.:It's all right now, but just imagine if we had \@ PREGNANCY_MULTIPLES(51) ? more # another one \@...:Y'know, as long as we don't have \@ PREGNANCY_MULTIPLES(51) ? more # another one \@, I think we'll be all right!")%」
					CASEELSE
							;School age and beyond.
						PRINTFORML 「%SPLIT_G(@"Having \@ PREGNANCY_MULTIPLES(51) ? more # another one \@... W-Well, I wouldn't mind.:Do you think... we could handle \@ PREGNANCY_MULTIPLES(51) ? more # another one \@?:I love our %PLNOUN("child",CFLAG:51:子供人数)% so much, I keep wondering if we should have more...:Suppose we had \@ PREGNANCY_MULTIPLES(51) ? more # another one \@... Would you make time?")%」
						PRINTFORMDL Nitori %SPLIT_G(@"blushes while thinking about the prospect:thinks about the future with you:brings up some hypotheticals")%.
				ENDSELECT
			ENDIF
	ENDSELECT
ELSE
	;Specific child.
	SELECTCASE CHILD_AGE(51,Child)
			;Branches for the child's age, followed by other qualities.
		CASE 0
				;Breastfeeding.
			IF !RAND:2
				SELECTCASE K51_EGG_CHILD_PERSONALITY(Child)
					CASE "Curious"
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「Doesn't it feel like \@ CHILD_SEX:51:Child == 1 ?she#he\@'s really smart? \@ CHILD_SEX:51:Child == 1 ?She#He\@'s always looking so intensely at everything.」
								PRINTFORMDL If \@ CHILD_SEX:51:Child == 1 ?she#he\@'s Nitori's \@ CHILD_SEX:51:Child == 1 ?daughter#son\@, there's no doubt \@ CHILD_SEX:51:Child == 1 ?she#he\@'ll be a genius.
								PRINTFORML 「Haha, true!」
								PRINTFORMDL Nitori hugs the baby while laughing.
							CASE 1
								CALL HPH_PRINT,@"「\@ CHILD_SEX:51:Child == 1 ?She#He\@ always reaches out to me... It's so cuuuute!HPH」","L"
						ENDSELECT
					CASE "Timid"
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「\@ CHILD_SEX:51:Child == 1 ?She#He\@ doesn't cry very much. I wonder if \@ CHILD_SEX:51:Child == 1 ?she#he\@'ll be really calm when \@ CHILD_SEX:51:Child == 1 ?she#he\@ grows up?」
							CASE 1
								PRINTFORML 「It's hard to make \@ CHILD_SEX:51:Child == 1 ?her#him\@ drink, but \@ CHILD_SEX:51:Child == 1 ?she#he\@'s still healthy.」
								PRINTFORMDL Nitori cradles the baby affectionately.
						ENDSELECT
					CASE "Brave"
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「He grabs on so tightly to my breast, it leaves red marks...」
								PRINTFORMDL Nitori pets your son's head and gazes at him.
							CASE 1
								PRINTFORML 「He's getting big, right? I think he might be the biggest so far, at this age.」
						ENDSELECT
					CASE "Shameless"
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「She's so greedy when drinking, my nipple gets sore and I have to switch...」
								PRINTFORMDL Nitori complains, but hugs your daughter tightly all the same.
							CASE 1
								PRINTFORML 「She wets herself all the time, I swear. More than the others, I mean!」
						ENDSELECT
					CASE "Moody"
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「\@ CHILD_SEX:51:Child == 1 ?She#He\@ cries so much, I hope nothing's wrong with \@ CHILD_SEX:51:Child == 1 ?her#him\@...」
