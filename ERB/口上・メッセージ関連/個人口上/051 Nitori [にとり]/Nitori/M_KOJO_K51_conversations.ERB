SIF (MAIN_MAP != 7 || CFLAG:MASTER:現在位置 != 704) && TopicModifier > 1
	TopicModifier = 3
CALL K51_EGG_CONVERSATION_MESSAGE(1,TopicModifier,,Counter)
SELECTCASE TopicModifier
	CASE 0
		;Playing assistant.
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「What do you think? %SPLIT_G(@"Should I use this kind of part, or this one?:Pretty efficient, right?:Would you use it?:It's not too much, right?:Is it worth building?:Too many useless parts? Not enough?:I could get away with a cheap part here, right?:It shouldn't break if I make it like this, right?:Will it work?:Anything you'd add?:Any ideas?:See any problems?:It's %SPLIT_G(@"cute:cool:fancy:sophisticated")%, right?:What would you change?")%」
			CASE 1
				PRINTFORML 「Do you think if %SPLIT_G(@"I loosened the frame, it would %SPLIT_G(@"hold:be fine:stay together")%:there weren't so many %SPLIT_G(@"embellishments:extra bits:bolts in it:handles:safety cushions")%, it would be light enough:I put on some %SPLIT_G(@"clothespins:extra bolts:reinforcing wire")%, it would %SPLIT_G(@"fix:solve:hold")% it:it were %SPLIT_G(@"bigger:smaller:padded:rounder")%, it would be easier to use")%?」
			CASE 2
				PRINTFORML 「%SPLIT_G(@"I wonder if it's:I think it's:I'm pretty sure it's")% %SPLIT_G(@"too %SPLIT_G(@"heavy:light:boxy:round:noisy:hard to use:bulky:hard to %SPLIT_G(@"figure out:tell what it is")%:fragile:unwieldy")%:gonna %SPLIT_G(@"break:fall apart:collapse")% if I build it like %SPLIT_G(@"this:that")%:even going to %SPLIT_G(@"work:be useful:be used:keep working for very long")%")%...」
		ENDSELECT
		IF !RAND:12
			PRINTFORML 「%SPLIT_G(@"Wait, I just thought of something...:...Wait a minute...:Well... Hmm...:Oh!:Wait, I've got it!:...Hey, you're right!:Hmm? ...Oh, you're right...:Oh, good idea...:Huh? You're right, that might work...:Hmm, you might be on to something...")%」
			PRINTFORMDL Nitori %SPLIT_G(@"crosses something out in the schematic, then writes something down:makes an alteration to the schematic:writes something down:starts scribbling on the schematic:writes something down:thinks about it some more..")%.
		ENDIF
	CASE 1
			;Working together to build.
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%SPLIT_G(@"Oh, that part should go in there.:Here, use my wrench.:Did you tighten it enough?:Be careful with this, it's more fragile than it looks.:No, do it like this, see?:You're doing it like I showed you, right?")%」
				PRINTFORMDL Nitori %SPLIT_G(@"watches you more :pays more attention to you")% than her own work.
			CASE 1
				PRINTFORML 「%SPLIT_G(@"Where's my wrench?:Did you take all the %SPLIT_G(@"nuts:bolts:washers:screwdrivers:wrenches:wires")%?:Wait, we skipped a step...:Wait, I was supposed to attach this first...:Wait, take that off again! I just got a better idea.:Where does this part go?:Why do I have so many extra parts?:I think I put this in backwards...:Did I put it in upside down? ...%SPLIT_G(@"Yes, I did.:No, I didn't.")%:What's this part for, again?:Hand me a... No, wait, I've got one.:Maybe we should do it like this instead...:Geh, I broke something...:Uh... I guess it's this part? ...No, this one goes in there.")%」
				PRINTFORMDL %SPLIT_G(@"It's a bit messy, but you make good progress.:Nitori's workflow is %SPLIT_G(@"disorganized:messy:strange")%...:Nitori ignores the schematic.:Nitori spends more time playing around than making progress.")%
			CASE 2
				PRINTFORML 「%SPLIT_G(@"Hold this for me, will you?:Here, push it together with me.:This part is stuck... Can you help?:Uh, what did the blueprint say again?:Here, I'll hold it for you...:Where did this go, again?%SPLIT_G(@" Oh, right.::")%:Hand me that thing? No, no, the other thing.:Here, let's sort all the parts out.:Wow, it's simpler than I thought.:These parts need polishing... I'll get the stuff.:Did I just break this? ...No, okay, it folds.")%」
				PRINTFORMDL It goes %SPLIT_G(@"pretty :fairly :::")%%SPLIT_G(@"well:smoothly")%.
		ENDSELECT
	CASE 2
			;Working together to dismantle.
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「%SPLIT_G(@"You strip the wires, I'll salvage the circuitry.:Oh, hey, don't strip that, I can use it as a part.:Look at what's inside this thing!:Woah, this thing's a treasure chest! Look at this stuff!:Make sure you keep everything sorted, I wanna put it back together after!:Look at all the copper in there... Uweh heh heh...:All right, beautiful, let's take off that casing～:Geh heh heh... Look at all these good parts...:I bet I could build something new out of these parts.:I'm so going to rebuild this one.:I've gotta remodel this... I can see a new invention just waiting to come out!:You take that side, I'll take this side.:Yes! The part I was looking for!:With the parts from this, I won't have to buy new ones from the yamawaro!")%」
				PRINTFORMDL %SPLIT_G(@"Nitori smiles the whole time:Nitori has a manic energy about her:You can see her fidgeting with excitement:There's a sparkle in her eyes..:Nitori talks to you about each part that she removes:The two of you ponder the uses for the salvaged parts:Nitori's hands work quickly")%.
			CASE 1
				PRINTFORML 「%SPLIT_G(@"Wait, don't take that off ye-- ...Ahaha, I should've warned you it'd break...:It's really rusted through, huh?:There's not as much to salvage in this as I thought...:This one's kinda hard to salvage...:Huh, most of the parts are broken...:Looks like most of this isn't worth the time salvaging.:Aaah, I broke the part I wanted!:Someone took the thing I wanted to salvage...")%」
				PRINTFORMDL %SPLIT_G(@"Nitori laughs off some minor %SPLIT_G(@"setbacks:inconveniences")%:It's not that productive, but Nitori seems to have fun:Though it goes slowly, Nitori enjoys herself.:Nitori grumbles to herself:Nitori shrugs and keeps at it with you:You end up with mainly useless scrap")%.
			CASE 2
				PRINTFORML 「%SPLIT_G(@"It's not disengaging... What if I just yank the whole thing out?:Maybe I can peel this away with a knife...:Hold this, okay? I'm gonna jam my crowbar in.:I might have to bend this part to get it out... Think it'll break?")%」
				PRINTFORML 「%SPLIT_G(@"Gah, it broke! ...Well, obviously...:...Huh, that went better than I thought.:...Yep, it worked just fine!:...Aha! Success!")%」
		ENDSELECT
	CASE 3
			;Brainstorming.
		PRINTFORML 「%SPLIT_G(@"If it can fit in a pocket or a backpack, it's better than something you need to lug around, right?:There are a lot of daily inconveniences with no solutions, huh...:Hmm, but it's got to have a charm point, right? Like a character flaw.:The most important thing is that it looks %SPLIT_G(@"cute:cool")%, right?:What about... No, %SPLIT_G(@"that won't work:that'd be stupid:I already made that:that already exists:that'd be too expensive:that'll never work")%...:Let's think of some problems people have and try to solve them.:I have so many ideas, but the energy consumption would be...:If only we had more funding...:Bleh, if we did that, we'd have to convince the yamawaro to help...:If it won't work in water, there's no point...:What if... Hmm...:Maybe if we got everyone to work together...")%」
		PRINTFORMDL %SPLIT_G(@"You don't come up with anything, but Nitori seems to have fun.:You come up with an idea that Nitori writes down.:Nitori comes up with a few ideas.:The two of you bounce ideas around until %SPLIT_G(@"settling on something practical:you give up")%.:You manage to come up with an idea together, which Nitori writes down.")%
ENDSELECT

@K51_EGG_CONVERSATION_OFFER(Counter)
