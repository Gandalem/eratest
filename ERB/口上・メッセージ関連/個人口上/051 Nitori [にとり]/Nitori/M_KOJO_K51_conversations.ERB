					PRINTFORM 「Well, maybe--」
					CALL K51_EGG_KAPPA_TEXT(0,@"「On that thing? %LOCALS:3%!」","l")
					PRINTFORMDL Another kappa happens by and begins arguing with the first. Soon, more and more start joining in...
					CALL K51_EGG_KAPPA_TEXT(2,@"「%CAPITALIZE(LOCALS)% is easier!」")
					CALL K51_EGG_KAPPA_TEXT(0,@"「%CAPITALIZE(LOCALS:1)% is always the best option!」")
					CALL K51_EGG_KAPPA_TEXT(1,@"「I'd use %LOCALS:2%...」","l")
					PRINTFORMDL In the end, nothing gets decided...
				CASE 1
						;Scope creep.
