	CASE 10
		;Kasen.
		PRINTFORML 「%SPLIT_G(@"그녀는 가끔 우리가 뭘 하는지 보러 들르긴 하지만, 그녀가 무슨 생각을 하는지는 도저히 알 수가 없어.:그녀는 항상 우리 기계에 관심이 많지만, 그것들에 대해 아는 게 하나도 없어서 결국 우리는 설명하는 데 많은 시간을 보내게 돼...:그녀는 호수에 사는 생물들에 대해 물어봤어. 그녀가 뭘 하고 있는지 궁금하네?:얼마 전에 그녀의 드래곤을 봤지. 꽤 인상적이었던 것 같아...")%」
	CASE 11
		;Fairies.
		PRINTFORML 「%SPLIT_G(@"아, 정말 짜증나. 우리가 은신처를 제대로 숨길 수도 없어! 그들이 계속 내 잡동사니 더미에 들어와 반짝이는 것들을 훔쳐 가고 있어. 나에게는 저 반짝이는 것들이 필요해! \”장난치다\” 나의 기계 볼트들을 느슨하게 하면서 나를 계속 장난치고 있어...\n내가 그들을 손에 넣는다면 난 \”장난치다\” 그들을 내 공중 어뢰 발사기로 놀려줄 거야! 그들은 너무 자유로워서 나도 좀 부럽네...\n나? 나도 걱정할 게 많다고!: 급할 때 도우미로 쓸 수는 있어. 중요한 일만 시키지 않도록 조심해.: 쉬운 손님들이겠지만 돈을 안 쓰니까...")%」
ENDSELECT

@K51_EGG_CONVERSATION_PERSONAL(Counter)
#DIM DYNAMIC Counter
#DIM DYNAMIC TopicModifier
TopicModifier = RAND:2
;This one has the generic action messages in the individual branches because some branches want to use different messages.
;Some branches are only available for certain traits. Nitori's not likely to comment on average features.
;At first, there's a chance of being redirected into her "awkward, can't talk to you very well" dialogue.
SIF ABL:51:親密 < 3 && !CFLAG:51:K51_EGG_EVENT_TIER && !RAND:3
	GOTO AWKWARD
$TOP
SELECTCASE TopicModifier
	CASE 0
		SELECTCASE RAND:6
			CASE 0
				;Breast size.
				IF !IS_MALE(MASTER)
					IF TALENT:51:バストサイズ < TALENT:MASTER:バストサイズ && TALENT:MASTER:バストサイズ > 0 && !RAND:2
						SIF TALENT:51:機嫌 == 1
							GOTO TOP
						IF GETBIT(CFLAG:53:既成事実,1)
							CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
							PRINTFORML 「%SPLIT_G(@"크윽... 만져보게 해줘!: 꽉 쥐어보고 싶어...: 저렇게 클 수가 있다니 너무 불공평해...: 진심으로, 어떻게 그렇게 커진 거지...: 네 가슴은 나를 정말 운 없는 기분이 들게 해... 아니면 내가 네 것을 볼 수 있어서 운이 좋은 걸지도 모르지...: 또 큰 가슴을 자랑하고 있네, 응...? : 내 것보다 훨씬 크다...: 젠장, 계속 쳐다보게 되네...: 어떻게 그렇게 가슴을 크게 만든 거야?")%」
							PRINTFORMDL 니토리의 당신의 가슴을 공개적으로 감탄한다.
						ELSE
							CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
							PRINTFORML 「%SPLIT_G(@"그냥 궁금해서 그러는데 평소에 뭐 먹어?:특별한 운동 같은 거 해? 아니면...:아무 이유 없지만 가슴을 많이 문지르면 커진다는 게 사실이야?:아무튼 내 가슴을 위해서 말인데... 음... 내가 아는 최고의 팁은... 어...")%」
							PRINTFORML %SPLIT_G(@"니토리(Nitori)가 당신의 가슴을 응시한다:니토리는 당신의 가슴 쪽으로 시선을 피하려 노력한다:니토리는 계속해서 당신의 가슴을 흘겨본다:당신은 니토리가 당신의 가슴을 바라보며 약간 몸을 움직이는 것을 본다")%...
						ENDIF
					ELSEIF TALENT:MASTER:バストサイズ > 0 && TALENT:51:バストサイズ > 0 && GETBIT(CFLAG:53:既成事実,1)
						$BREASTS
						CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
						PRINTFORML 「%SPLIT_G(@"허리 통증을 다루는 건 정말 짜증나지, 그렇지?:가끔 셔츠를 입기가 힘들 때도 있어... 너도 그래?:가끔 조이는 느낌이 들어?:나는 그래...")%」
						PRINTFORML %SPLIT_G(@"두 분은 가슴 문제에 대해 이야기한다: 서로의 큰 가슴에 대해 이야기한다: 두 분은 서로의 가슴 문제에 공감한다")%...
					ELSE
						GOTO TOP
					ENDIF
				ELSE
					GOTO TOP
				ENDIF
			CASE 1
				;Shy/Shameless, Timid/Bold.
				PRINTFORMDL 니토리는 당신에게 %SPLIT_G(@"machines:engineering:her business:something:her plans:a complicated subject")%...에 대해 이야기하려고 한다.
				PRINTFORMDW
				IF (TALENT:51:恋慕 && TALENT:51:恋人) || TALENT:51:愛欲 || TALENT:MASTER:羞恥心 == -1 || TALENT:MASTER:度胸 == 1
					PRINTFORML 「%SPLIT_G(@"음, 이런 거야...:어떻게 생각해? 예 아니오?:그건 말이야, 아이디어가 있었어...:여기서 이게 어떤지 네 생각을 말해줘...:음, 설명 좀 해보려고 해...")%」
					PRINTFORMDL 그녀는 당신과 대화하기 쉬운 사람인 것 같다.
				ELSE
					SIF TALENT:51:機嫌 == 1
						GOTO TOP
					PRINTFORML 「%SPLIT_G(@"음, 있잖아... 저기... 뭐였지... 아니, 됐어.: 어... 아냐, 아무것도 아니야.: 그건... 음... 신경 쓰지 마.: 오-오... 응.")%」
					IF TALENT:MASTER:羞恥心 == 1
						PRINTFORMDL 너의 수치심 때문에 두 사람은 소통에 어려움을 겪게 된다...
					ELSEIF TALENT:MASTER:度胸 == -1
						PRINTFORMDL 당신들 둘 다 소심해서 서로 대화하는 데 어려움을 겪는다...
					ELSE
						PRINTFORMDL 그녀는 자기 뜻을 전달하는 데 약간의 어려움이 있다...
					ENDIF
				ENDIF
			CASE 2
				;Age.
				SIF (TALENT:51:恋慕 && TALENT:51:恋人) || TALENT:51:愛欲
					GOTO TOP
				SELECTCASE TALENT:MASTER:年齢
					CASE -1 ;Child
						IF IS_CHILD(MASTER)
							CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
							PRINTFORML 「%SPLIT_G(@"Hee hee, you're pretty clever for a little %PRINT_MALE("boy", MASTER)%.:Are you really safe wandering out there? Gensokyo's dangerous for little kids...:So, what kinds of games have you been up to?:You know to be careful around machines, right?:%K51_EGG_MASTER(1)%, you're just too cute...")%」
							PRINTFORMDL 니토리 %SPLIT_G(@"dotes on you like a big sister:%SPLIT_G(@"smiles:looks animated")% as she talks with you:talks to you in a kneeling position:patronizes you a little")%.
						ELSE
							GOTO TOP
						ENDIF
					CASE 1,2 ;Middle Age, Elder
						CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
						PRINTFORML 「%SPLIT_G(@"너무 무리하는 건 아니지?:나이 생각하면 정말 활동적이네... 이동하기 힘들진 않아? 그냥 궁금해서.")%」
					CASEELSE
						GOTO TOP
				ENDSELECT
			CASE 3
				;Size.
				SIF (TALENT:51:恋慕 && TALENT:51:恋人) || TALENT:51:愛欲
					GOTO TOP
				SELECTCASE TALENT:MASTER:体型
					CASE -5 ;Inchling-Sized
						IF CFLAG:51:K51_EGG_ADDRESS == 1 && !RAND:5
							PRINTFORMDL 너는 니토리와 인간과 카파에 대해 이야기한다...
							PRINTFORMDW
							PRINTFORML 「아무것도 걱정하지 마. 너는 언제나 우리의 작고— 아니, 맹세한 친구니까!」
						ELSE
							CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
							PRINTFORML 「%SPLIT_G(@"그 정도 크기인 게 불편하지 않니?:그렇게 작으면 힘들겠지...:네 크기라면 움직이는 부품들을 정말 조심해야 해.:조심하는 게 좋을 거야. 네 크기라면 요괴가 너를 간식으로 생각할지도 모르니까...")%」
						ENDIF
					CASE -2 ;Child-Sized
						IF CFLAG:51:K51_EGG_ADDRESS == 1 && !RAND:3
							PRINTFORMDL 너는 니토리와 인간과 카파에 대해 이야기한다...
							PRINTFORMDW
							PRINTFORML 「아무것도 걱정하지 마. 너는 언제나 우리의 작고— 아니, 맹세한 친구니까!」
						ELSE
							CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
							PRINTFORML 「%SPLIT_G(@"조심하는 게 좋을 거야. 네 크기라면 요괴가 너를 간식이라고 생각할지도 모르니까...")%」
						ENDIF
					CASE 1,2,3 ;Tall, Huge, Giant-Sized
						IF !IS_NONHUMAN(MASTER) && !RAND:3
							PRINTFORMDL 너는 니토리와 인간과 카파에 대해 이야기한다...
							PRINTFORMDW
							PRINTFORML 「물론 우리는 잘 지내지. 큰 인간 친구를 원하지 않을 사람이 누가 있겠어?」
						ELSE
							CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
							PRINTFORML 「%SPLIT_G(@"그래서, 위쪽 날씨는 어때?:세상에, 당신 정말 크네...")%」
							PRINTFORMDL 니토리%SPLIT_G(@"너와 이야기하기 위해 목을 길게 빼고 서서 약간 뒤로 물러난다")%.
						ENDIF
					CASEELSE
						GOTO TOP
				ENDSELECT
			CASE 4
				;Flirting and low intimacy socializing.
				;She's interested in the player from the start, but doesn't know how to approach, so it rarely comes out until Yearning unless she's a [Slut].
				;She's normally very careful about it and retreats into plausible deniability if she thinks she's being too forward.
				;If she's a [Slut], she'll be much more blatant. Either way, she's not very good at it.
				IF TALENT:51:恋慕 && TALENT:51:恋人 && RAND:3
					;Love and Lovers.
					IF GET_TARGETNUM() > 1 || WITH_MOB() || DATE_HITOGOMI(CFLAG:MASTER:現在位置)
						PRINTFORMDL 니토리와 이야기하는 동안, 그녀는 %SPLIT_G(@"자신의 몸을 당신에게 기대고 다른 사람들에게 보이지 않는 곳에서 당신의 손을 잡는다:남들의 시선에 들키지 않으려 당신의 옷을 꼭 붙잡는다:주변에 남들이 있다는 것을 잊고 부드러운 미소로 당신의 눈을 바라본다")%.
					ELSE
						PRINTFORMDL 니토리와 대화하는 동안, 그녀는 %SPLIT_G(@"몸을 당신에게 바짝 붙인다:당신의 손가락에 부드럽게 손가락을 엮는다:부드러운 미소로 눈을 바라본다:뒤로 팔을 두르고 몸을 부드럽게 감싼다")%.
					ENDIF
					PRINTFORMDW
					PRINTFORML 「%SPLIT_G(@"헤헤... 아니, 듣고 있어요.:미안해요, 그냥 행복해서 그래... 그게 다예요.:흥... 응, 그래서 뭐?")%」
				ELSEIF TALENT:51:思慕 || TALENT:51:恋慕
					;Yearning or Lovers.
					IF !RAND:2
						PRINTFORMDL 니토리와 이야기하는 동안 그녀는 %SPLIT_G(@"stands a bit closer to you:listens with rapt attention:seems a bit wistful")%.
						PRINTFORMDW
						PRINTFORML 「%SPLIT_G(@"아니, 아니, 정말이야, 듣고 있어!?:진심으로? 더 말해봐!:헤헤헤... 안 돼, 계속 해봐.")%」
					ELSE
						PRINTFORMDL 니토리와 대화할 때, 그녀는 %SPLIT_G(@"더 빠르게 말을 시작하고, 점점 더 흥분하며:당신에게 혼란스러운 이야기를 한다:눈에 빛을 띠며 크게 말한다")%.
						PRINTFORMDW
						PRINTFORML 「%SPLIT_G(@"그러니까 대충 무슨 일이 있었냐면: 하지만 사실은 이랬어: 근데 실제로 일어난 게 뭔지 알아?: 있잖아, 내가 몰랐던 건 말이야: 그러자 그녀가 말했지: 아 맞다, 그러니까 우선 이걸 설명해야겠는데...: 그래서 그 부품을 끼워보려고 했는데, 종류가 달라서")%...」
					ENDIF
				ELSEIF !CFLAG:51:K51_EGG_EVENT_TIER && RAND:3
					;Awkward.
					$AWKWARD
					CALL K51_EGG_CONVERSATION_MESSAGE(14,,,Counter)
					PRINTFORML 「%SPLIT_G(@"...응... :어... 응, 헤헤... :오, 어... 아냐, 됐어. :음... 응, 응, 동의해. :저-저기, 음, 그거에 대해...」\n「...미안, 무슨 말을 하려 했는지 까먹었어.")%」
				ELSEIF TALENT:51:ヤリマン && RAND:4
					;Slut.
					CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
					IF !IS_MALE(MASTER)
						PRINTFORML 「%SPLIT_G(@"나를 대할 때 네 뒤에 대해 걱정할 필요 없어. 그냥 알아둬. 만약 그게 취향이 아니라면... 다른 여자들이 좋아? 너도 그렇지, 안 그래?:난 사실 남자들 별로 안 좋아해... 내 말 무슨 뜻인지 알지?")%」
					ELSEIF !CFLAG:51:K51_EGG_INITIAL_VIRGINITY && !RAND:3
						PRINTFORML 「%SPLIT_G(@"나한테는 네 뒤태 걱정 안 해도 돼, 그냥 알아둬. 혹시 그게 취향이라면...: 난 꽤 경험이 많거든... 좋은 시간을 보내게 해줄 수 있어.: 여러 가지 잘 알지. 예를 들면... 신체적인 것 같은 거 말이야?")%」
					ELSEIF THINKS_IS_VIRGIN(51)
						PRINTFORML 「%SPLIT_G(@"나한테는 신경 안 써도 돼. 알아둬. 네가 그런 거 좋아하지 않는 이상... :뭐 알고 있는 거야? 난 꽤 인기 많지만, 여전히 순결한 처녀거든. 희귀하잖아, 맞지?」\n「어느 날은 그냥 올라탈 놈이라도 찾아봐야겠어... :있잖아, 너 되게 귀엽다... :난 아직 처녀인데, 항상 흥분해 있어... 이거 미친 거 아니야?")%」
					ELSEIF GETBIT(CFLAG:53:既成事実,1)
						PRINTFORML 「%SPLIT_G(@"헤이 잘생긴 사람, 그 달콤한 거 어떻게 지내?:지금 네 거 생각하고 있어... 그냥 알아둬.:어떤 걸 먹고 싶은 기분이야... 무슨 말인지 알지?")%」
					ELSE
						PRINTFORML 「음... 오, 그냥 거시적인 것들을 생각하고 있었어.」
					ENDIF
					PRINTFORMDL %SPLIT_G(@"그녀의 목소리는 막힌 듯 들린다: 그녀는 눈짓을 하려 하지만 눈 떨림처럼 보인다: 그녀는 어색하게 당신의 팔을 더듬는다: 그녀는 치마 끝을 들어 올리지만 너무 길어서 아무것도 보이지 않는다: 그녀는 노골적인 시선을 주려 하지만 얼굴은 이상해 보인다")%...
				ELSEIF !IS_FALLEN(51)
					;Before any fall state, she tries to dig out information about the player, along with some forced compliments.
					CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
					IF IS_CHILD(MASTER) && !RAND:2
						PRINTFORML 「%SPLIT_G(@"아이고, 귀엽네... 아, 그러니까... 당연히 어린애니까... :나이치고는 꽤 성숙하네, 응?:게임이라든가 뭐 같이 해볼래...? 여기 네 나이 또 만난 적 있어? 아마 없을걸...」\n「내가 친구가 되어줄 테니 걱정 마...")%」
					ELSE
						PRINTFORML 「%SPLIT_G(@"그래서, 요즘 뭐 하고 지냈어?:인연을 사네... 정말로, 이 세계에서 말이야?:취미 같은 거 있어? ...시장 조사를 위해서 말이야...:좋아하는 단마쿠가 있니? 그냥 아이디어가 필요해서 말이지.:너는 이 세계에 꽤 잘 적응하고 있어. 정말 인상적이야!:너는 정말 흥미로워... 음- 외부에서 온 사람이니까, 그러니까.")%」
					ENDIF
					PRINTFORMDL %SPLIT_G(@"니토리의 말은 어색하게 나온다.:니토리는 말을 하면서 안절부절못한다.:니토리의 손이 조금 떨린다.:니토리는 웃음을 참는다.:니토리는 목을 가다듬고 미소 짓는다.:니토리의 목소리가 약간 떨린다.:니토리의 목소리가 갈라진다.")%
				ELSE
					GOTO TOP
				ENDIF
			CASE 5
				;Being an outsider.
				CALL K51_EGG_CONVERSATION_MESSAGE(5,TopicModifier,,Counter)
				IF !IS_FALLEN(51) && !RAND:2
