; Modular ERB: 個人口上/051 Nitori [にとり]/Nitori/M_KOJO_K51_conversations.ERB
;This file stores Nitori's regular dialogue.

@K51_EGG_CONVERSATION_MESSAGE(Topic,TopicModifier,CharacterName,Counter)
;Replacement for the default train message. This is called for certain branches, or certain individual dialogues.
;The topic is randomized based on location and situation.
#DIM DYNAMIC Topic
#DIM DYNAMIC TopicModifier
#DIM DYNAMIC Counter
#DIMS CharacterName
VARSET LOCALS
;Nitori's name is placed randomly at the beginning or the end of the message for variety.
LOCALS '= "당신과 니토리"
IF !RAND:2
	LOCALS '= "당신"
	LOCALS:1 '= @" 니토리와 함께"
ENDIF
SIF TALENT:51:恋人 && !RAND:6
	LOCALS:2 = %SPLIT_G(@"가끔 %SPLIT_G(@"one another:each other")%과 농담을 건네며, 때때로 손을 잡고 농담한다.")%
SELECTCASE Topic
	CASE 0
		;Machines. High chance when in the kappa hideout.
		SIF TALENT:51:機嫌 == 1
			GOTO HAPPY
		IF Counter
			PRINTFORMDL 니토리 %SPLIT_G(@"chats about:discusses:talk about")% 기계들과 너에 대해 이야기한다.
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat about:discuss:talk about")% 기계들 %SPLIT_G(@"for a while:for a time:for a little bit:together:and how they work:and how to build them:and their intricacies:and parts:and designs:and machinery:and their complexities:and their uses:and engineering:and all things mechanical")%%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 1
		;Collaboration. Unlocks at special event tier 2. Lower chance.
		SELECTCASE TopicModifier
			CASE 0
				;Playing assistant.
				PRINTFORMDL %SPLIT_G(@"Nitori asks for %SPLIT_G(@"your opinion:ideas:your take")% on a %SPLIT_G(@"project:concept:design:prototype")% of hers:Nitori shows you a blueprint for something she's %SPLIT_G(@"designing:building:working on")%:You ask Nitori about her projects")%...
			CASE 2
				;Both of you working together, only in the hideout.
				PRINTFORMDL %SPLIT_G(@"%LOCALS% build random gadgets together%LOCALS:1%:%LOCALS% tour the hideout, helping out some of the other kappa%LOCALS:1%:You help Nitori %SPLIT_G(@"build:fix:upgrade")% %SPLIT_G(@"one of her inventions:a gadget of hers:a %SPLIT_G(@"large:small:huge:strange")% machine")% while %SPLIT_G(@"chatting:talking:you talk:talking shop")%:You and Nitori join a group of kappa %SPLIT_G(@"building:assembling:upgrading:fixing")% a huge machine:You help Nitori %SPLIT_G(@"build:test:tweak:upgrade:refine")% her %K51_EGG_PROJECT_NAME()%%SPLIT_G(@" while %SPLIT_G(@"talking:chatting")%: while having an idle conversation:, %SPLIT_G(@"talking:chatting")% as you work:, %SPLIT_G(@"talking:chatting")% about the work")%")%...
			CASE 3
				;Both of you taking stuff apart, only in the hideout.
				PRINTFORMDL %SPLIT_G(@"%LOCALS% %SPLIT_G(@"salvage some junk from a pile:%SPLIT_G(@"disassemble:take apart:dismantle")%%SPLIT_G(@" and rebuild: and reassemble::")% an outside world machine")% in the hideout%LOCALS:1%:You and Nitori join a group of kappa %SPLIT_G(@"dismantling:taking apart:disassembling:salvaging")% a huge machine")%...
			CASEELSE
				;Spitballing.
				PRINTFORMDL %LOCALS% %SPLIT_G(@"brainstorm %SPLIT_G(@"inventions:new inventions:new designs:possible new projects:")%%SPLIT_G(@" for a while: for a little bit: together:::")%:talk shop%SPLIT_G(@" for a while: for a little bit: together:::")%")%%LOCALS:1%%LOCALS:2%...
		ENDSELECT
	CASE 2
		;Offers made to you. Once per day only. Locks once she's at Love or Lovers.
		PRINTFORMDL 니토리 %SPLIT_G(@"%SPLIT_G(@"has:proposes:makes")% an offer:turns the subject to business:makes a pitch")%...
	CASE 3
		;Business. Unlocks at special event tier 2.
		IF Counter
			PRINTFORMDL 니토리 %SPLIT_G(@"chats about:discusses:talks about")% 당과의 사업...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat about:discuss:talk about")% 비즈니스%SPLIT_G(@" for a while: for a time: for a little bit: together: opportunities: practices: and money: and profit: and finances")%%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 4
		;People. Locked when others are present.
		IF Counter
			PRINTFORMDL 니토리(Nitori)가 %CharacterName%에 대해 %SPLIT_G(@"talk:gossip")%한다...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"이야기하다: 결국 ~에 대해 이야기하게 되다: 가십하다")% %CharacterName%%LOCALS:1%...
		ENDIF
	CASE 5
		;The player or herself. Lower chance.
		SIF TALENT:51:機嫌 == 1
			GOTO HAPPY
		IF Counter
			PRINTFORMDL 니토리는 당신과 개인적인 %SPLIT_G(@"talk:chat")%을 가지고 있다...
		ELSEIF TopicModifier == 0 && !RAND:2
			PRINTFORMDL %SPLIT_G(@"Nitori asks you %SPLIT_G(@"about yourself:personal questions")%:Nitori starts comparing you with %SPLIT_G(@"herself:others")%:You %SPLIT_G(@"talk:chat")% with Nitori, who %SPLIT_G(@"ends up:winds up")% talking about you")%...
		ELSEIF TopicModifier == 1 && !RAND:2
			PRINTFORMDL %SPLIT_G(@"You ask Nitori %SPLIT_G(@"about herself:personal questions")%:Nitori starts comparing herself with %SPLIT_G(@"you:others")%:You %SPLIT_G(@"talk:chat")% with Nitori, who %SPLIT_G(@"ends up:winds up")% talking about herself")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"talk about:end up talking about:discuss:chat about")% 개인적인 문제들%LOCALS:1%...
		ENDIF
	CASE 6
		;Sex. Unlocks at Sex Friend, high chance at Lust. Higher chance with sexual frustration. Will not trigger in the presence of others. May also trigger at high frustration if she's a Lover.
		IF Counter
			PRINTFORMDL 니토리 %SPLIT_G(@"너와 음란하게 얘기한다:너에게 암시적인 말을 한다:성적인 이야기를 한다")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"talk dirty together:share a conversation that gradually turns sexual:make suggestive comments while %SPLIT_G(@"chatting:talking")%:have an innuendo-laden conversation:talk about sex")%%LOCALS:1%...
		ENDIF
	CASE 7
		;Interactions. Only possible while other characters are present.
		IF Counter
			PRINTFORMDL 니토리 %SPLIT_G(@"talk:chat:대화가 있다")%와 당신 및 %CharacterName%과 대화한다.
		ELSE
			PRINTFORMDL 당신과 니토리는 %SPLIT_G(@"talk:chat:have a conversation")%을(를) %CharacterName%와 대화한다...
		ENDIF
	CASE 8
		;Children. Unlocks after Nitori gives birth.
		IF TopicModifier != -1
			IF Counter
				PRINTFORMDL 니토리 %SPLIT_G(@"당신에게 이야기한다:당신과 대화한다:당신과 이야기를 나눈다")%에 대해 %CharacterName%을/를...
			ELSE
				PRINTFORMDL %LOCALS% %SPLIT_G(@"talk:chat:have a chat")% ~에 대해 %CharacterName%%LOCALS:1%...
			ENDIF
		ELSEIF Counter
			PRINTFORMDL 니토리 %SPLIT_G("당신에게 이야기한다:당신과 대화한다:당신과 대화를 나눈다")%에 대해 %SPLIT_G(@"your \@ CFLAG:51:子供人数 > 1 ? children # child\@:parenthood")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"이야기하다:대화하다:논의하다")% %SPLIT_G(@"당신의 \@ CFLAG:51:子供人数 > 1 ? 아이들 # 아이 \@:양육")%%LOCALS:1%...
		ENDIF
	CASE 9
		;Miscellaneous.
		SIF K51_EGG_IS_STORM() && OUTROOF(CFLAG:MASTER:現在位置)
			RETURN 1
		SIF TALENT:51:機嫌 == 1
			GOTO HAPPY
		IF Counter
			PRINTFORMDL 니토리 %SPLIT_G(@"talks to:chats with:has a chat with")% 너...
		ELSE
			PRINTFORMDL 함께 %LOCALS% %SPLIT_G(@"chat:talk:have a %SPLIT_G(@"nice :pleasant :")%conversation")% %LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 10
		;Drunk.
		IF Counter
			PRINTFORMDL 니토리 취해서 당신에게 %SPLIT_G(@"말을 건다:대화를 나눈다:대화를 시도한다")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"try to talk:attempt conversation:talk")%%LOCALS:1%이지만, 그녀는 %SPLIT_G(@"doesn't seem to listen:can't understand you:zones out when you speak:can't stay focused:doesn't make much sense")%한다...
		ENDIF
	CASE 11
		;Happy.
		$HAPPY
		IF Topic == 0
			PRINTFORMDL 니토리 %SPLIT_G(@"광적으로 떠든다:열심히 설명한다:매우 빠르게 말한다:미소 지으며 강의한다")%에 대해 %SPLIT_G(@"기계:그녀의 발명품:그녀의 프로젝트:그녀의 취미")%...
		ELSEIF !RAND:2
			IF Counter
				PRINTFORMDL 니토리는 당신과 `%SPLIT_G(@"lively:spirited")%`하게 `%SPLIT_G(@"talk:chat:conversation")%`한다...
			ELSE
				PRINTFORMDL %LOCALS% %SPLIT_G(@"share하기")% a %SPLIT_G(@"활기찬")% %SPLIT_G(@"대화")%%LOCALS:1%...
			ENDIF
		ELSE
			PRINTFORMDL 니토리 %SPLIT_G(@"smiles \@ ABL:51:親密 < 3 ? shyly # broadly\@:\@ ABL:51:親密 < 3 ? giggles nervously # laughs\@:\@ ABL:51:親密 < 3 ? comes out of her shell a bit # comes alive\@")% %SPLIT_G(@"while:as")% \@ Counter ? 그녀와 이야기한다 # 당신이 %SPLIT_G(@"talk:talk:chat:share a conversation")%이다 \@...
		ENDIF
	CASE 12
		;Angry.
		IF Counter
			PRINTFORMDL 니토리가 나쁜 기분으로 당신에게 말을 건다...
		ELSE
			PRINTFORMDL 니토리 %SPLIT_G(@"당신에게서 등을 돌린다:시선을 피한다:무시한다:말을 걸어도 듣지 않는다:냉담하게 대한다")%...
		ENDIF
	CASE 13
		;Sullen.
		IF Counter
			PRINTFORMDL 니토리가 나쁜 기분으로 당신에게 말을 건다...
		ELSE
			PRINTFORMDL %SPLIT_G(@"그녀와 대화하려고 노력해도, 니토리의 응답은 회피적이다.:지금은 말이 소용이 없을 것 같다...:니토리를 부딪혀 보지만 소용이 없다.")%
		ENDIF
	CASE 14
		;Conversation failure.
		PRINTFORMDL \@ Counter ? 니토리는 너와 대화하려고 노력한다. # 너는 니토리와 대화를 시도한다. \@이지만 %SPLIT_G(@"she's too awkward:she doesn't give you much to work with:she hesitates with every word:she's too self-conscious:she looks like she wants to run away:you can see her shaking:her shyness gets the better of her")%는...
ENDSELECT
PRINTFORMDL
SIF !Counter
	WAIT
;Random conversation lines below here.

@K51_EGG_CONVERSATION_MACHINES(Counter)
#DIM DYNAMIC Counter
CALL K51_EGG_CONVERSATION_MESSAGE(0,,,Counter)
$TOP
SELECTCASE RAND:12
	CASE 0
		;Scrap materials.
		;Nitori's Mountain of Faith profile says she takes outside world machines apart and puts them back together, presumably to modify them or see how they work.
		;I figured she should also scrap some of it for materials in order to rely on the yamawaro as little as possible.
		PRINTFORML 「나는 「어떤 %SPLIT_G(@"good :nice :decent :high quality :good condition :")%%SPLIT_G(@"copper:brass:iron:steel:magnetite:aluminum:electronics:scrap:salvage:machine parts")% %SPLIT_G(@"earlier:the other day:a while ago:yesterday")%.」을 발견했다.」
		PRINTFORML 「%SPLIT_G(@"뭘 만들 수 있을지 생각해 봤다: 어쩌면 새로운 것을 만들 수도 있겠지: 무엇을 지을까: 빨리 만들어 팔 만한 게 뭐가 있을까: 요즘 운이 따르는 것 같아서 궁금하다: 주변에 또 뭐가 숨겨져 있을지 궁금해진다: 비축량이 점점 늘어나고 있다: 이제 그 프로젝트를 할 만큼 충분할지도 모르겠다: 하지만 은신처의 모든 사람이 다 가져갔다: 재료의 품질이 좋을 때는 그것을 사용하는 게 좀 미안하게 느껴진다: 은신처에 저장 공간이 부족하다")%...」
	CASE 1
		;Things she's found.
		PRINTFORML 「나는 %SPLIT_G(@"another motor:a new model of computer:a whole mess of wires and lightbulbs:some diving gear:a fancy pair of headphones:a big air tank with a dial on it:a car:a jet engine:a bomb:a rifle:a laser pointer:a tractor:a washing machine:a refrigerator:a stove that uses propane:an electric toothbrush:a toy robot:a steam engine:a coal engine:a diesel engine:a sewing machine:a radio:an alarm clock:a clock:a fancy watch:an electronic drum set:a disco ball:an electric guitar:a big speaker:a floodlight:a coffee maker:a drink dispenser:an automatic lathe:a vacuum cleaner:a bread making machine:a machine I don't even know the name of:a tape deck:a portable music player")%을/를 %SPLIT_G(@"earlier:the other day:a while ago:yesterday")%에서 찾았다.」
		PRINTFORML 「%SPLIT_G(@"분해하는 게 재미있었다: 속이 정말 흥미로웠다: 분해하고 싶은데, 그냥 쓰는 것도 괜찮을지도 모른다: 분해한 뒤 다시 조립하기는 힘들었다: 이게 어떻게 인연의 마을에 오게 되었는지 궁금하다: 그냥 놓여 있는 걸 발견하는 게 재미있지 않나?: 더 많이 찾을 수 있을까 궁금하다: 분해하는 건 쉬웠다! 하지만 다시 조립하는 것은 그렇지 않았다: 분해하면서 도면을 그려봤다: 부품만 가지고 무언가를 만들 수도 있을지도 모른다: 좀 지루해 보이니 리모델링할 생각이다: 리모델링에 아주 좋은 아이디어를 주었다: 저 다른 것과 합칠 수 있을지도 모른다: 여기서 쓸 만한 좋은 부품을 얻을 수 있을 것 같다")%...」
	CASE 2
		;Talking up a side project.
