;This file stores Nitori's regular dialogue.

@K51_EGG_CONVERSATION_MESSAGE(Topic,TopicModifier,CharacterName,Counter)
	;Replacement for the default train message. This is called for certain branches, or certain individual dialogues.
	;The topic is randomized based on location and situation.
#DIM DYNAMIC Topic
#DIM DYNAMIC TopicModifier
#DIM DYNAMIC Counter
#DIMS CharacterName
VARSET LOCALS
	;Nitori's name is placed randomly at the beginning or the end of the message for variety.
LOCALS '= "You and Nitori"
IF !RAND:2
	LOCALS '= "You"
	LOCALS:1 '= @" with Nitori"
ENDIF
SIF TALENT:51:恋人 && !RAND:6
	LOCALS:2 = %SPLIT_G(@", occasionally flirting with %SPLIT_G(@"one another:each other")%:, sometimes flirting: while holding hands")%
SELECTCASE Topic
	CASE 0
			;Machines. High chance when in the kappa hideout.
		SIF TALENT:51:機嫌 == 1
			GOTO HAPPY
		IF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"chats about:discusses:talks about")% machines with you...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat about:discuss:talk about")% machines %SPLIT_G(@"for a while:for a time:for a little bit:together:and how they work:and how to build them:and their intricacies:and parts:and designs:and machinery:and their complexities:and their uses:and engineering:and all things mechanical")%%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 1
			;Collaboration. Unlocks at special event tier 2. Lower chance.
		SELECTCASE TopicModifier
			CASE 0
					;Playing assistant.
				PRINTFORMDL %SPLIT_G(@"Nitori asks for %SPLIT_G(@"your opinion:ideas:your take")% on a %SPLIT_G(@"project:concept:design:prototype")% of hers:Nitori shows you a blueprint for something she's %SPLIT_G(@"designing:building:working on")%:You ask Nitori about her projects")%...
			CASE 2
					;Both of you working together, only in the hideout.
				PRINTFORMDL %SPLIT_G(@"%LOCALS% build random gadgets together%LOCALS:1%:%LOCALS% tour the hideout, helping out some of the other kappa%LOCALS:1%:You help Nitori %SPLIT_G(@"build:fix:upgrade")% %SPLIT_G(@"one of her inventions:a gadget of hers:a %SPLIT_G(@"large:small:huge:strange")% machine")% while %SPLIT_G(@"chatting:talking:you talk:talking shop")%:You and Nitori join a group of kappa %SPLIT_G(@"building:assembling:upgrading:fixing")% a huge machine:You help Nitori %SPLIT_G(@"build:test:tweak:upgrade:refine")% her %K51_EGG_PROJECT_NAME()%%SPLIT_G(@" while %SPLIT_G(@"talking:chatting")%: while having an idle conversation:, %SPLIT_G(@"talking:chatting")% as you work:, %SPLIT_G(@"talking:chatting")% about the work")%")%...
			CASE 3
					;Both of you taking stuff apart, only in the hideout.
				PRINTFORMDL %SPLIT_G(@"%LOCALS% %SPLIT_G(@"salvage some junk from a pile:%SPLIT_G(@"disassemble:take apart:dismantle")%%SPLIT_G(@" and rebuild: and reassemble::")% an outside world machine")% in the hideout%LOCALS:1%:You and Nitori join a group of kappa %SPLIT_G(@"dismantling:taking apart:disassembling:salvaging")% a huge machine")%...
			CASEELSE
					;Spitballing.
				PRINTFORMDL %LOCALS% %SPLIT_G(@"brainstorm %SPLIT_G(@"inventions:new inventions:new designs:possible new projects:")%%SPLIT_G(@" for a while: for a little bit: together:::")%:talk shop%SPLIT_G(@" for a while: for a little bit: together:::")%")%%LOCALS:1%%LOCALS:2%...
		ENDSELECT
	CASE 2
			;Offers made to you. Once per day only. Locks once she's at Love or Lovers.
		PRINTFORMDL Nitori %SPLIT_G(@"%SPLIT_G(@"has:proposes:makes")% an offer:turns the subject to business:makes a pitch")%...
	CASE 3
			;Business. Unlocks at special event tier 2.
		IF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"chats about:discusses:talks about")% business with you...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat about:discuss:talk about")% business%SPLIT_G(@" for a while: for a time: for a little bit: together: opportunities: practices: and money: and profit: and finances")%%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 4
			;People. Locked when others are present.
		IF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"talks:gossips")% about %CharacterName%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"talk about:end up talking about:gossip about")% %CharacterName%%LOCALS:1%...
		ENDIF
	CASE 5
			;The player or herself. Lower chance.
		SIF TALENT:51:機嫌 == 1
			GOTO HAPPY
		IF Counter
			PRINTFORMDL Nitori has a pesonal %SPLIT_G(@"talk:chat")% with you...
		ELSEIF TopicModifier == 0 && !RAND:2
			PRINTFORMDL %SPLIT_G(@"Nitori asks you %SPLIT_G(@"about yourself:personal questions")%:Nitori starts comparing you with %SPLIT_G(@"herself:others")%:You %SPLIT_G(@"talk:chat")% with Nitori, who %SPLIT_G(@"ends up:winds up")% talking about you")%...
		ELSEIF TopicModifier == 1 && !RAND:2
			PRINTFORMDL %SPLIT_G(@"You ask Nitori %SPLIT_G(@"about herself:personal questions")%:Nitori starts comparing herself with %SPLIT_G(@"you:others")%:You %SPLIT_G(@"talk:chat")% with Nitori, who %SPLIT_G(@"ends up:winds up")% talking about herself")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"talk about:end up talking about:discuss:chat about")% personal matters%LOCALS:1%...
		ENDIF
	CASE 6
			;Sex. Unlocks at Sex Friend, high chance at Lust. Higher chance with sexual frustration. Will not trigger in the presence of others. May also trigger at high frustration if she's a Lover.
		IF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"talks dirty with you:makes suggestive comments at you:talks about sex")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"talk dirty together:share a conversation that gradually turns sexual:make suggestive comments while %SPLIT_G(@"chatting:talking")%:have an innuendo-laden conversation:talk about sex")%%LOCALS:1%...
		ENDIF
	CASE 7
			;Interactions. Only possible while other characters are present.
		IF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"talks:chats:has a chat")% with you and %CharacterName%...
		ELSE
			PRINTFORMDL You and Nitori %SPLIT_G(@"talk:chat:have a conversation")% with %CharacterName%...
		ENDIF
	CASE 8
			;Children. Unlocks after Nitori gives birth.
		IF TopicModifier != -1
			IF Counter
				PRINTFORMDL Nitori %SPLIT_G(@"talks to you:chats with you:has a talk with you")% about %CharacterName%...
			ELSE
				PRINTFORMDL %LOCALS% %SPLIT_G(@"talk:chat:have a chat")% about %CharacterName%%LOCALS:1%...
			ENDIF
		ELSEIF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"talks to you:chats with you:has a chat with you")% about %SPLIT_G(@"your \@ CFLAG:51:子供人数 > 1 ? children # child\@:parenthood")%...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"talk about:chat about:discuss")% %SPLIT_G(@"your \@ CFLAG:51:子供人数 > 1 ? children # child\@:parenthood")%%LOCALS:1%...
		ENDIF
	CASE 9
			;Miscellaneous.
		SIF K51_EGG_IS_STORM() && OUTROOF(CFLAG:MASTER:現在位置)
				;Don't bother describing conversation if you're outside in a storm.
			RETURN 1
		SIF TALENT:51:機嫌 == 1
			GOTO HAPPY
		IF Counter
			PRINTFORMDL Nitori %SPLIT_G(@"talks to:chats with:has a chat with")% you...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat:talk:have a %SPLIT_G(@"nice :pleasant :")%conversation")% together%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 10
			;Drunk.
		IF Counter
			PRINTFORMDL Nitori drunkenly %SPLIT_G(@"talks to:chats with:attempts conversation with")% you...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"try to talk:attempt conversation:talk")%%LOCALS:1%, but she %SPLIT_G(@"doesn't seem to listen:can't understand you:zones out when you speak:can't stay focused:doesn't make much sense")%...
		ENDIF
	CASE 11
			;Happy.
		$HAPPY
		IF Topic == 0
			PRINTFORMDL Nitori %SPLIT_G(@"gushes:launches into a manic spiel:starts going on:talks very quickly:lectures you with a smile")% about %SPLIT_G(@"machines:her inventions:her projects:her hobbies")%...
		ELSEIF !RAND:2
			IF Counter
				PRINTFORMDL Nitori has a %SPLIT_G(@"lively:spirited")% %SPLIT_G(@"talk:chat:conversation")% with you...
			ELSE
				PRINTFORMDL %LOCALS% %SPLIT_G(@"have:share")% a %SPLIT_G(@"lively:spirited")% %SPLIT_G(@"talk:chat:conversation")%%LOCALS:1%...
			ENDIF
		ELSE
			PRINTFORMDL Nitori %SPLIT_G(@"smiles \@ ABL:51:親密 < 3 ? shyly # broadly\@:\@ ABL:51:親密 < 3 ? giggles nervously # laughs\@:\@ ABL:51:親密 < 3 ? comes out of her shell a bit # comes alive\@")% %SPLIT_G(@"while:as")% \@ Counter ? she talks with you # you %SPLIT_G(@"talk:talk:chat:share a conversation")%\@...
		ENDIF
	CASE 12
			;Angry.
		IF Counter
			PRINTFORMDL Nitori talks to you in a bad mood...
		ELSE
			PRINTFORMDL Nitori %SPLIT_G(@"turns away from you:looks away:ignores you:doesn't listen when you try to talk:gives you the cold shoulder")%...
		ENDIF
	CASE 13
			;Sullen.
		IF Counter
			PRINTFORMDL Nitori talks to you in a bad mood...
		ELSE
			PRINTFORMDL %SPLIT_G(@"Although you try to talk with her, Nitori's responses are non-committal.:It seems like talking won't do any good right now...:You try to talk with Nitori, but to no avail.")%
		ENDIF
	CASE 14
			;Conversation failure.
		PRINTFORMDL \@ Counter ? Nitori tries to talk with you # You try to talk with Nitori\@, but %SPLIT_G(@"she's too awkward:she doesn't give you much to work with:she hesitates with every word:she's too self-conscious:she looks like she wants to run away:you can see her shaking:her shyness gets the better of her")%...
ENDSELECT
PRINTFORMDL
SIF !Counter
	WAIT


;Random conversation lines below here.

@K51_EGG_CONVERSATION_MACHINES(Counter)
#DIM DYNAMIC Counter
CALL K51_EGG_CONVERSATION_MESSAGE(0,,,Counter)
$TOP
SELECTCASE RAND:12
	CASE 0
			;Scrap materials.
			;Nitori's Mountain of Faith profile says she takes outside world machines apart and puts them back together, presumably to modify them or see how they work.
			;I figured she should also scrap some of it for materials in order to rely on the yamawaro as little as possible.
		PRINTFORML 「I found some %SPLIT_G(@"good :nice :decent :high quality :good condition :")%%SPLIT_G(@"copper:brass:iron:steel:magnetite:aluminum:electronics:scrap:salvage:machine parts")% %SPLIT_G(@"earlier:the other day:a while ago:yesterday")%.」
		PRINTFORML 「%SPLIT_G(@"I've been thinking about what I could make:Maybe I could make something new:What to build:Wonder what I could whip up and sell quick:Feels like I've been getting lucky lately:Makes me wonder what else is buried around:The stockpile's getting big:Maybe now there's enough for that project:Everyone at the hideout took it all, though:When the material quality's good, I kinda feel bad using it:The hideout is running out of storage space")%...」
	CASE 1
			;Things she's found.
		PRINTFORML 「I found %SPLIT_G(@"another motor:a new model of computer:a whole mess of wires and lightbulbs:some diving gear:a fancy pair of headphones:a big air tank with a dial on it:a car:a jet engine:a bomb:a rifle:a laser pointer:a tractor:a washing machine:a refrigerator:a stove that uses propane:an electric toothbrush:a toy robot:a steam engine:a coal engine:a diesel engine:a sewing machine:a radio:an alarm clock:a clock:a fancy watch:an electronic drum set:a disco ball:an electric guitar:a big speaker:a floodlight:a coffee maker:a drink dispenser:an automatic lathe:a vacuum cleaner:a bread making machine:a machine I don't even know the name of:a tape deck:a portable music player")% %SPLIT_G(@"earlier:the other day:a while ago:yesterday")%.」
		PRINTFORML 「%SPLIT_G(@"It was fun to take apart:The insides were really interesting:I want to take it apart, but maybe I can use it as-is:It was tough to put back together once I took it apart:I wonder how it ended up in Gensokyo:Isn't it fun to discover stuff just lying around?:I wonder if I can find even more:Taking it apart was easy! Putting it back together, though:I made a diagram of it while I was taking it apart:Maybe I can build something with just the parts from it:It looks kinda boring, so I think I'll remodel it:It gave me a great idea for a remodel:Maybe I can combine it with that other thing:I think I can get some good parts from it")%...」
	CASE 2
			;Talking up a side project.
		PRINTFORML 「%SPLIT_G(@"Guess what, :By the way, :Oh yeah, :That reminds me, :Did I tell you? :")%I finished %SPLIT_G(@"remodeling a %SPLIT_G(@"tape deck:clock:vacuum cleaner:refrigerator:weird machine")% I found:a new weapon:a new tool:an old side project:fixing up some old inventions:my secret project:a new remodel")% %SPLIT_G(@"earlier:the other day:a while ago:yesterday")%!」
		PRINTFORMDL Nitori starts %SPLIT_G(@"%SPLIT_G(@"bragging:boasting:telling you")%:to %SPLIT_G(@"brag:boast:tell you")%")% about her %SPLIT_G(@"creation:invention:new work")%.
	CASE 3
			;Need more stuff.
		IF IS_MALE(MASTER) && (TALENT:51:ヤリマン || TALENT:51:セフレ || TALENT:51:愛欲) && !RAND:2
			PRINTFORML 「I'm gonna need %SPLIT_G(@"a pair of nuts:a sturdy rod:some hard, thick wood")% for my project...」
			PRINTFORMDL Nitori grins suggestively at you.
		ELSE
			PRINTFORML 「%SPLIT_G(@"I'm gonna need:I'll need:I'd better get:I need")% %SPLIT_G(@"some ::")%more %SPLIT_G(@"nuts:bolts:screws:scrap:supplies:copper:copper wires:gears:connectors:metal")% for my %SPLIT_G(@"next :new ::")%%SPLIT_G(@"project:invention:remodel:maintenance job:construction job")%.」
			PRINTFORML 「%SPLIT_G(@"I don't want to ask the yamawaro, though...:I'd better get looking...:Time to scrape the river again...:Maybe I can borrow some?:Got any to sell?:Having to get parts is so annoying!:Intact parts are also a problem...:I can make parts myself with enough metal, but...:Before that, I need more money...:That means I need a new money-maker...")%」
		ENDIF
	CASE 4
			;Showing off finished projects. Big ones if you're in the hideout, stuff that fits in the backpack if not.
		PRINTFORML 「You wanna %SPLIT_G(@"see:know:hear about")% something I %SPLIT_G(@"made:built:finished")%%SPLIT_G(@" a while ago: before: a long time ago::")%?」
		IF MAIN_MAP == 7 && CFLAG:MASTER:現在位置 == 704
			PRINTFORMDL Nitori brings you to %SPLIT_G(@"a corner of the hideout:another room in the hideout:an adjoining warehouse")%%SPLIT_G(@", where she shows %SPLIT_G(@"you:off")%: and shows %SPLIT_G(@"you:off")%:, where you see")% %SPLIT_G(@"what looks like a miniature submarine:an engine of some kind:what appears to be a robot with noodle-shaped arms and legs:a machine made of a combine harvester bolted to the hull of a tugboat:a giant green bazooka with a kappa-shaped missile lying next to it:a huge machine with no clear purpose:an overly complicated machine for automatically popping party poppers:a mechanized recreation of the Loch Ness Monster:a fully functional pinball machine:a hydraulic press with a suspicious red stain on it:an extending arm so long, the collapsed version is longer than both of her arms combined:a backpack machine sprouting four flexible metal arms:a giant drill mounted on a metal wagon:a giant robotic fish:a giant boombox with enlarged speakers")%.
		ELSE
			PRINTFORMDL Nitori reaches into %SPLIT_G(@"one of her pockets:her backpack")% and %SPLIT_G(@"pulls out:shows off:shows you:reveals")% %SPLIT_G(@"a glove with some electronic buttons on it:a flashlight with a huge head and battery attached to it:a digital watch with an antenna sticking out of it:a rod-like machine with no clear purpose:a robotic fish:a microphone shaped like a cucumber:a boomerang with an antenna sticking out of it:a water pistol with an extended magazine and customized grip:a bomb shaped like a kappa's head:a multitool that unfolds into other multitools:a mini-megaphone:a gadget so complicated you can't make heads or tails of it:a collapsible fishing rod")%.
		ENDIF
		PRINTFORMDL She %SPLIT_G(@"tells you all about it:rambles about its specs:, pulls out a schematic and points at it while rambling:starts to explain it:tries to describe it")%, %SPLIT_G(@"speaking more and more quickly:speaking too quickly for you to keep up:stumbling over her words:though she keeps doubling back to explain more and more:using a lot of difficult words:using a lot of words like \"whatsit\" and \"thingummy\":losing her train of thought several times:getting off track several times:going down several tangents along the way:glossing over some important basics:talking so fast that she runs out of breath")%...
	CASE 5
			;Current project progress.
		PRINTFORML 「%SPLIT_G(@"I'm still working on the %K51_EGG_PROJECT_NAME()%.:I'm making good progress on the %K51_EGG_PROJECT_NAME()%!:The %K51_EGG_PROJECT_NAME()% is going pretty well.:Still working on the %K51_EGG_PROJECT_NAME()%...:Sorry, my mind's still on the %K51_EGG_PROJECT_NAME()%.:Right now, I can't think about anything but the %K51_EGG_PROJECT_NAME()%.:The %K51_EGG_PROJECT_NAME()%...")%」
		SELECTCASE CFLAG:51:K51_EGG_PROJECT_DAYS
			CASE IS > 10
				PRINTFORML 「%SPLIT_G(@"It'll probably take a while...:It'll be a good while...:It's not even nearly done, but slow and steady wins the race!:It's not even nearly done. I hope I don't get bored...:It's almost done! ...No, that's a lie. It's still way off...:I'm still working out the design of it.:I've got an idea of how to do it, but there are still some issues with the design...:Gweh... It's daunting to think about a project you just started...:New projects are the most refreshing thing there is! I just need to figure out my plan for it.:It's gonna be a good one, I just know it.")%」
			CASE IS > 6
				PRINTFORML 「%SPLIT_G(@"It might be a while yet...:It's still gonna be a while before it's done.:It's going kinda slow right now, but...:Soon... Well, sooner or later, it'll be ready...:Good thing I don't have a deadline...:Gotta keep at it to make sure it turns out well.:I'm not taking any shortcuts with it!:You ever think something's gonna be simple and it turns out complicated?")%」
			CASE IS > 4
				PRINTFORML 「%SPLIT_G(@"It's getting there...:It definitely won't be much longer!:Whew, I'm concentrating too much...:I'm sure I can get it done soon.:It's really fun to work on it.:It's kinda complicated, but I'll figure it out!:I keep finding new ways to optimize it. It's gonna be great!")%」
			CASE IS > 2
				PRINTFORML 「%SPLIT_G(@"Not long now!:I'm making great progress with it! It'll be done in a flash!:It's going to be done in no time!:It's almost ready, I know it!:Maybe I could get it done by tomorrow... Probably not, though.:I'm so close...:Just a few more days and it'll be done!")%」
			CASEELSE
				PRINTFORML 「%SPLIT_G(@"Tomorrow for sure!:It's almost done! Just needs some more testing.:There are still a couple of issues to iron out, but I've got a good plan for those.:It's almost ready! I can't wait to be done with it!:Just a couple more tweaks and it'll be done!")%」
		ENDSELECT
	CASE 6
			;Some basic comments about what she's working on, to make it feel like she's doing something.
			;If the projects were just names slotted into generic lines, it might feel hollow, so she should have at least a tiny bit of unique dialogue for each one.
		SIF DAY == CFLAG:51:K51_EGG_DAY_MET
				;Locked on the first day of knowing her, because she introduces the project to the player during the picnic event.
			GOTO TOP
		SELECTCASE CFLAG:51:K51_EGG_PROJECT
			CASE 0
				PRINTFORML 「My Q-Cumber sound system can make sound waves into a weapon! With this revamp, it'll be great in Danmaku, too!」
				PRINTFORML 「%SPLIT_G(@"To tell the truth, I got the idea from the moon rabbit...:And it sounds really cool in battle!:Just keep it away from your head...")%」
			CASE 1
				PRINTFORML 「A water cannon is the perfect kappa weapon, so I'm trying to make a really strong one.」
				PRINTFORML 「%SPLIT_G(@"The best part is, it can't be used against us!:Water power is the soul of the kappa, don't you think?:And it'll be great for fun in the summer!")%」
			CASE 2
				PRINTFORML 「The mystic kappacitor I'm working on is a super high-storage battery that can store spiritual energy!」
				PRINTFORML 「%SPLIT_G(@"I might even be able to make it absorb curses...:You can make barriers and stuff last a loooong time!:I'm not that good with occult stuff, but I think it'll work!")%」
			CASE 3
				PRINTFORML 「I'm trying to tune up my Danmaku pitching machine. It's for spell practice!」
				PRINTFORML 「%SPLIT_G(@"Imagine the ability to practice Spell Cards as much as you want. You could learn to defeat anyone!:The trouble is, machines aren't that good at casting Spell Cards...:Of course, you'd need a copy of the Spell Card to practice it...")%」
			CASE 4
