@K51_EGG_CHILD_SET_COLOR(ChildIndex)
;Assigns and then randomizes the given child's font color based on personality.
#DIM DYNAMIC ChildIndex
#DIM DYNAMIC NewColorR
#DIM DYNAMIC NewColorG
#DIM DYNAMIC NewColorB
SELECTCASE K51_EGG_CHILD_PERSONALITY(ChildIndex)
	CASE "Curious"
		NewColorR = 166
		NewColorG = 222
		NewColorB = 240
	CASE "Timid"
		NewColorR = 93
		NewColorG = 163
		NewColorB = 185
	CASE "Brave"
		NewColorR = 74
		NewColorG = 130
		NewColorB = 148
	CASE "Shameless"
		NewColorR = 209
		NewColorG = 238
		NewColorB = 247
	CASE "Moody"
		NewColorR = 47
		NewColorG = 94
		NewColorB = 83
	CASE "Liberated"
		NewColorR = 116
		NewColorG = 231
		NewColorB = 204
ENDSELECT
NewColorR = MIN(NewColorR+RAND(-20,20),255)
NewColorG = MIN(NewColorG+RAND(-20,20),255)
NewColorB = MIN(NewColorB+RAND(-20,20),255)
CHILD_COLOR:51:ChildIndex = COLOR_FROMRGB(NewColorR,NewColorG,NewColorB)
RESULT = 1
RETURN RESULT

