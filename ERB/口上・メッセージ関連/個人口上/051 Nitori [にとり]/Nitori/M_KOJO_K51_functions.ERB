@K51_EGG_MASTER(ARG,ARG:1)
;Nitori's address function. Controls how she refers to the player.
;ARG is whether to capitalize it, ARG:1 is whether to suppress lewd variations.
#FUNCTIONS
#DIMS Output
IF CFLAG:51:K51_EGG_ADDRESS == 2
	;If you've ever been especially close, she'll just use your name.
	RETURNF @"%CALLNAME:MASTER%"
ELSEIF TALENT:51:思慕 || TALENT:51:セフレ == 2 || IS_NONHUMAN(MASTER) || !CFLAG:51:K51_EGG_ADDRESS
	;Otherwise, if she has Yearning or Mistress, or you're not human, or you've turned off "sworn friend," she'll use your name with an honorific.
	IF IS_CHILD(MASTER)
		IF IS_MALE(MASTER)
			RETURNF @"%CALLNAME:MASTER%-군"
		ELSE
			RETURNF @"%CALLNAME:MASTER%-쨩"
		ENDIF
	ELSE
		RETURNF @"%CALLNAME:MASTER%님"
	ENDIF
ENDIF
;If you aren't that close and you've set her to call you "sworn friend," then she will do that. Under certain conditions, she might variate on it.
;If you're sex friends or she has Lust, she'll call you sex friend instead, but only if no one is around. ARG:1 suppresses this.
IF TALENT:MASTER:体型 < TALENT:51:体型 && !RAND:6
	Output = Little friend
ELSEIF TALENT:MASTER:体型 > TALENT:51:体型 && TALENT:MASTER:体型 > 0 && !RAND:6
	Output = Big friend
ELSEIF !ARG:1 && (TALENT:51:セフレ || TALENT:51:愛欲) && GET_TARGETNUM() == 0
	;Sometimes she flubs it.
	IF !RAND:12
		Output = Sworn sex
	ELSEIF !RAND:6 && HAS_PENIS(MASTER)
		Output '= @"%SPLIT_G(@"Dick:Cock:Penis")% 친구"
	ELSEIF !RAND:6 && !IS_MALE(MASTER) && TALENT:MASTER:バストサイズ > 0
		Output '= @"%SPLIT_G(@"가슴:젖꼭지")% 친구"
	ELSEIF !RAND:6
		Output = Sexy friend
	ELSE
		Output = Sex friend
	ENDIF
ELSE
	Output = Sworn friend
ENDIF
SIF !ARG
	RETURNF TOLOWER(Output)
RETURNF Output

