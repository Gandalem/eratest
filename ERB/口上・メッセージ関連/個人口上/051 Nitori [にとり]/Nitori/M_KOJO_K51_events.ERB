@M_KOJO_EGG_EVENT_K51_25(ARG,ARG:1)
#DIM DYNAMIC LitterSize
;口上主はLOCAL
;ARG:1	何人目の子供か
;--------------------------------------------------
FOR LOCAL,1,CFLAG:51:LatestChildCount+1
;Randomize all children being born to ensure they'll be different after overflowing the limit.
CALL K51_EGG_CHILD_SET_PERSONALITY(LATEST_CHILD(51,LOCAL))
CALL K51_EGG_CHILD_SET_HOBBY(LATEST_CHILD(51,LOCAL))
CALL K51_EGG_CHILD_SET_COLOR(LATEST_CHILD(51,LOCAL))
NEXT
IF ARG == 4
	;Doesn't know it's your child.
ELSE
	LitterSize = CFLAG:51:LatestChildCount
	PRINTL
	SELECTCASE CFLAG:51:BirthEventsCount
		;Different scenes depending on which child it is.
		CASE 1
			CALL K51_EGG_KAPPA_TEXT(0,@"「카프그램!」","w")
