		ELSE
			PRINTFORML 「%SPLIT_G(@"Can't stay awake...:I'm about to fall over, so bye...:Gotta go... I'm falling asleep...")%」
		ENDIF
		RETURN 1
	;-------------------------------------------------
	;The character looks sleepy
	;眠そうにしている（～は眠そうにしている）
	;-------------------------------------------------
	CASE 2
		RETURN 1
	;-------------------------------------------------
	;The character is asleep
	;睡眠中（～は眠っている）
	;-------------------------------------------------
	CASE 3
		RETURN 1
	;-------------------------------------------------
	;The character runs out of strength (Stamina less than 500)
	;衰弱して寝る（体力500以下,うふふ時はうふふ強制終了）
