@K51_EGG_SAWMILL_EVENT(Commission,ARGS)
#DIM DYNAMIC Commission
IF !RAND:20
		;Small chance of getting two days ahead of schedule.
	PRINTFORMDL At the new %ARGS% sawmill, the kappa are working as though inspired.
	PRINTFORML 「Woah, you guys built all that?! Guess I'll pick up the pace, too...」
	PRINTFORMDW In a sudden burst of mania, development surges ahead!
	COMMISSION_PROGRESS:Commission += 300
ENDIF
	;There will be no problems at all for the first four scheduled days, but afterwards, there is a high chance of issues.
SIF COMMISSION_PROGRESS:Commission < 602
	RETURN
SELECTCASE RAND:6
	CASE 0
		PRINTFORML 「Huh, we're over budget?!」
		PRINTFORMDL While directing the construction of the new %ARGS% sawmill, Nitori discovers there aren't enough materials.
		PRINTFORML 「Maybe we shouldn't have built that adjoining %SPLIT_G(@"sauna:sumo ring:underground swimming pool:cucumber growery:treehouse")%...」
		PRINTFORMDW The construction project has come to a halt.
		CALL COMMISSION_STALL(Commission)
	CASE 1
		PRINTFORMDL At the new %ARGS% sawmill's construction site, the kappa are growing restless.
		IF !RAND:2
			CALL K51_EGG_KAPPA_TEXT(0,@"「Huh, so we're just following the plans now?」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「Maybe we should build it like this instead...」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「Hey, guys, I drew up a new addition plan!」","l")
			PRINTFORML 「Don't get distracted! We have to satisfy the client!」
			CALL K51_EGG_KAPPA_TEXT(0,@"「We're still working on it!」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「Won't %HE_SHE(MASTER)% be happier if we add this?」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「I'm boooredー...」","l")
			PRINTFORML 「That's pretty cool, actually... Okay, let's change the design!」
		ELSE
			CALL K51_EGG_KAPPA_TEXT(1,@"「I forgot what the plan said we should do...」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「Who cares? Let's just improvise.」","")
			CALL K51_EGG_KAPPA_TEXT(0,@"「Hey, Nitori, what're you doing?」","l")
			PRINTFORML 「See, I figured we could get better cutting power from a %SPLIT_G(@"water jet:laser:giant chainsaw")% than a plain old saw.」
			PRINTFORML 「So, I'm gonna take apart what we've built and put it back together with this new system!」
			CALL K51_EGG_KAPPA_TEXT(0,@"「That's so cool!」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「Let's focus on that first!」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「Yeah, awesome!」","l")
		ENDIF
		PRINTFORMDW They start playing around, and fall behind schedule...
		COMMISSION_PROGRESS:Commission -= 200
ENDSELECT

@COMMISSION_STATUS_K51_EGG
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(51)
IF !Commission
	PRINTFORML 「Competent and reliable service for all kinds of labor!」
	SIF VAR_OR_DEFAULT("nSpoilerMode")
		PRINTFORML 「Just give us quick and interesting jobs. It'll get troublesome if it goes on too long.」
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「Ah, well, about our progress...」
		CASE 1
			PRINTFORML 「We're still setting up.」
		CASE IS < COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「We're a little behind, but we'll get it done!」
		CASE IS > COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「We're ahead of schedule! We'll knock this thing out in no time!」
		CASEELSE
			PRINTFORML 「The job's underway, no need to worry!」
	ENDSELECT
ENDIF

