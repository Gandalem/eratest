@K51_EGG_SAWMILL_EVENT(Commission,ARGS)
#DIM DYNAMIC Commission
IF !RAND:20
	;Small chance of getting two days ahead of schedule.
	PRINTFORMDL 새로운 %ARGS% 제재소에서 카파들이 영감을 받은 듯 일하고 있었다.
	PRINTFORML 「와, 너희들 그거 다 지었어?! 나도 속도를 좀 내야겠네...」
	PRINTFORMDW 갑작스러운 광란의 발발로 개발이 앞으로 치솟는다!
	COMMISSION_PROGRESS:Commission += 300
ENDIF
;There will be no problems at all for the first four scheduled days, but afterwards, there is a high chance of issues.
SIF COMMISSION_PROGRESS:Commission < 602
	RETURN
SELECTCASE RAND:6
	CASE 0
		PRINTFORML 「어라, 예산을 초과했단 말이야?!」
		PRINTFORMDL 새로운 %ARGS% 제재소 건설을 지휘하던 중, 니토리는 자재가 충분하지 않다는 것을 발견한다.
		PRINTFORML 「아마 저 옆에 붙인 %SPLIT_G(@"sauna:sumo ring:underground swimming pool:cucumber growery:treehouse")%를 안 지었어야 했나...」
		PRINTFORMDW 건설 프로젝트가 중단되었다.
		CALL COMMISSION_STALL(Commission)
	CASE 1
		PRINTFORMDL 새로운 %ARGS% 제재소 건설 현장에서 카파들이 초조해하고 있다.
		IF !RAND:2
			CALL K51_EGG_KAPPA_TEXT(0,@"「흐음, 이제 그냥 계획대로 진행하는 건가?」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「대신 이렇게 지어야 할지도 모르겠어...」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「얘들아, 나 새로운 추가 계획을 세웠어!」","l")
			PRINTFORML 「딴 데 정신 팔지 마! 손님을 만족시켜야 한다고!」
			CALL K51_EGG_KAPPA_TEXT(0,@"「아직 작업 중입니다!」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「이걸 추가하면 %HE_SHE(MASTER)%가 더 행복하지 않을까?」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「지루해ー...」","l")
			PRINTFORML 「사실 그거 꽤 멋지네... 좋아, 디자인을 바꾸자!」
		ELSE
			CALL K51_EGG_KAPPA_TEXT(1,@"「우리가 뭘 해야 한다고 계획에 적혀 있었는지 잊어버렸어...」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「누가 신경 써? 그냥 즉흥적으로 하자.」","")
			CALL K51_EGG_KAPPA_TEXT(0,@"「어이, 니토리, 뭐 하고 있어?」","l")
			PRINTFORML 「봐, 그냥 평범한 톱보다 %SPLIT_G(@"water jet:laser:giant chainsaw")%에서 더 나은 절단력을 얻을 수 있을 거라고 생각했지.」
			PRINTFORML 「그래서 우리가 만든 걸 분해하고 이 새로운 시스템으로 다시 조립할 거야!」
			CALL K51_EGG_KAPPA_TEXT(0,@"「정말 멋지다!」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「그것부터 집중하자!」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「그래, 굉장해!」","l")
		ENDIF
		PRINTFORMDW 그들은 빈둥거리기 시작하며 일정을 놓친다...
		COMMISSION_PROGRESS:Commission -= 200
ENDSELECT

@COMMISSION_STATUS_K51_EGG
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(51)
IF !Commission
	PRINTFORML 「모든 종류의 노동에 대한 유능하고 신뢰할 수 있는 서비스!」
	SIF VAR_OR_DEFAULT("nSpoilerMode")
		PRINTFORML 「재미있고 흥미로운 일만 빨리 달라. 너무 길어지면 골치 아파진다.」
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「아, 음, 우리의 진행 상황에 대해서 말인데...」
		CASE 1
			PRINTFORML 「아직 설정 중입니다.」
		CASE IS < COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「조금 지연되었지만 끝낼 거예요!」
		CASE IS > COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「우리는 예정보다 앞서고 있어! 금방 이걸 끝낼 거야!」
		CASEELSE
			PRINTFORML 「일은 진행 중이야, 걱정할 필요 없어!」
	ENDSELECT
ENDIF

