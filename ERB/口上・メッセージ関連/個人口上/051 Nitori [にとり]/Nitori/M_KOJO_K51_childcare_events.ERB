@M_KOJO_EGG_EVENT_K51_CHILD_RAISING_語彙
;-------------------------------------------------
;Developing speech.
CALL SET_KOJO_COLOR(51)
PRINTFORMDL
PRINTFORMDW %CALLNAME:(TALENT:51:育児中)%의 어휘력이 믿을 수 없는 속도로 증가한다. 마치 %HE_SHE(TALENT:51:育児中)%@는 한 번 듣고 새로운 단어를 즉시 배우는 것 같다.
SELECTCASE K51_EGG_CHILD_PERSONALITY(TALENT:51:育児中)
	CASE "Curious"
		PRINTFORMDW 사실, %HE_SHE(TALENT:51:育児中)%는 단 하나의 완전한 문장조차 알고 있지 않다...
		CALL CHILD_TEXT(@"「뭐지?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW …모든 것에 손가락으로 가리키며 끊임없이 반복하는 %HE_SHE(TALENT:51:育児中)%@.
		PRINTFORMDW 부모라는 건 때때로 힘들다…
	CASE "Timid"
		CALL CHILD_TEXT(@"「알겠어. 알겠어.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %HIS_HER(TALENT:51:育児中)%의 가장 좋아하는 말은 "Okay"이고, %HE_SHE(TALENT:51:育児中)%는 당신이 하는 모든 말 뒤에 그것을 %HIM_HER(TALENT:51:育児中)%에게 반복한다.
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%는 상당히 순응적인 성격을 가지고 있다...
	CASE "Brave"
		CALL CHILD_TEXT(@"「하자!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW 그는 자신이 무슨 생각을 하는지 말하는 것을 두려워하지 않는다.
		CALL CHILD_TEXT(@"「배고파! 배고파!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW 그의 목소리는 상당히 크다...
	CASE "Shameless"
		CALL CHILD_TEXT(@"「꺄아악!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW 그녀는 아직 말을 발음하는 데 어려움을 느끼지만 당신과 대화하려는 태도가 매우 적극적이다.
		CALL CHILD_TEXT(@"「%K51_EGG_CHILD_MASTER_NICKNAME(TALENT:51:育児中)%, 나랑 놀아줄래?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW 그녀의 밝은 미소는 너무 귀해서 지적하기 어렵다...
	CASE "Moody"
		PRINTFORMW 「저녁 먹어라, 귀여운 오이!」
		CALL CHILD_TEXT(@"「아니, 난 싫어해。」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「에헤...」
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%은/는 가끔 정말 자기주장이 강하다...
	CASE "Liberated"
		PRINTFORMW 「엄마한테 오고 싶니, 달콤한 피클아?」
		CALL CHILD_TEXT(@"「No!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「아니?! 왜 안 돼?!」
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%는 상당히 독립적인 성격을 가진 것 같다...
ENDSELECT
