@M_KOJO_EGG_EVENT_K51_CHILD_RAISING_喋る
;-------------------------------------------------
	;Learning to talk.
CALL SET_KOJO_COLOR(51)
PRINTFORMDL
PRINTFORMDW Lately, Nitori has been playing a lot with %CALLNAME:(TALENT:51:育児中)% while trying to teach %HIM_HER(TALENT:51:育児中)% words.
PRINTFORMW 「Peek-a-boo, it's Mama! Mama!」
PRINTFORMDW She sits in the play area with %HIM_HER(TALENT:51:育児中)% and repeats "Mama," trying to make %HIM_HER(TALENT:51:育児中)% say it back...
PRINTL
SELECTCASE K51_EGG_CHILD_HOBBY(TALENT:51:育児中)
	CASE "Curious"
		CALL CHILD_TEXT(@"「Awaga ro... Robot.」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「...Eh?!」
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)% is ignoring Nitori while playing with a remote control robot...
		PRINTL
		PRINTFORMW 「%K51_EGG_MASTER(1)%, did you hear that?! %HE_SHE(TALENT:51:育児中)% just said %HIS_HER(TALENT:51:育児中)% first word! I-I'm so happy!」
		PRINTFORMDW Nitori turns to you with tears in her eyes... Although, whether they're tears of joy, you can't say.
	CASE "Architecture"
		CALL CHILD_TEXT(@"「Mugum home.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)% cuddles up against Nitori, and she freezes as she hears the word.
		PRINTFORMW 「That was it! %K51_EGG_MASTER(1)%, you heard it, right?!」
	CASE "Explosives"
		PRINTFORMDW However, rather than paying attention, %HE_SHE(TALENT:51:育児中)%@ starts to bounce up and down while sitting and making rumbling sounds.
		CALL CHILD_TEXT(@"「Rumbaumbmambum...」",51,TALENT:51:育児中,"w")
		CALL CHILD_TEXT(@"「Rum bum, boom!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「D-Does that count as a word...?」
		PRINTL
		PRINTFORMDW Nitori peers down at %CALLNAME:(TALENT:51:育児中)% as %HE_SHE(TALENT:51:育児中)% picks up a ball and tosses it across the play area.
		CALL CHILD_TEXT(@"「Kaboom!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「It counts! It counts!」
		PRINTFORMDW You wonder when %HE_SHE(TALENT:51:育児中)%@ learned to say that kind of thing...
	CASE "Weapons"
		CALL CHILD_TEXT(@"「Gun!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)% confidently calls out his first word while reaching for the handle sticking out of Nitori's backpack.
		PRINTFORMW 「Ah! Ahaha, is that your first word?! Hahaha!」
		PRINTFORMDW Has Nitori been showing him some of her own toys, you wonder...
		PRINTFORMW 「Haha, just a little!」
	CASE "Danmaku"
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)% waves a colored block through the air and touches it against Nitori.
		CALL CHILD_TEXT(@"「Pa, pichuun!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「Ah... Do... Wait, do we count that?」
		CALL CHILD_TEXT(@"「Maku, Dammaku!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「Yes! Danmaku, Danmaku!」
	CASE "Vehicles"
		CALL CHILD_TEXT(@"「Hee...」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)% cuddles up with the toy mecha that %HE_SHE(TALENT:51:育児中)%@'s holding, as though hiding behind it.
		PRINTFORMW 「Yeees? You want to say something, sweet pickle?」
		PRINTL
		CALL CHILD_TEXT(@"「Hisoutensoku.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW A complicated word comes tumbling fully-formed from %HIS_HER(TALENT:51:育児中)% mouth. Nitori reacts with equal parts joy and disbelief.
		PRINTFORMW 「Aaaah! Yes, Hisoutensoku! You're such a smart %PRINT_MALE("boy", TALENT:51:育児中)%, hahaha!」
ENDSELECT
PRINTFORMDW You spend some more time with %HIM_HER(TALENT:51:育児中)%, trying to hear more words...

