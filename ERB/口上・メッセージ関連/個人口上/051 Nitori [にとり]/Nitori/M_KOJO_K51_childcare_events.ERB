@M_KOJO_EGG_EVENT_K51_CHILD_RAISING_語彙
;-------------------------------------------------
	;Developing speech.
CALL SET_KOJO_COLOR(51)
PRINTFORMDL
PRINTFORMDW %CALLNAME:(TALENT:51:育児中)%'s vocabulary is increasing at an unbelievable rate. It's as if %HE_SHE(TALENT:51:育児中)%@ learns new words instantly after hearing them once.
SELECTCASE K51_EGG_CHILD_PERSONALITY(TALENT:51:育児中)
	CASE "Curious"
		PRINTFORMDW In fact, %HE_SHE(TALENT:51:育児中)%@ even knows a single complete sentence...
		CALL CHILD_TEXT(@"「What's that?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW ...Which %HE_SHE(TALENT:51:育児中)%@ repeats constantly while pointing at anything and everything.
		PRINTFORMDW Being a parent is hard sometimes...
	CASE "Timid"
		CALL CHILD_TEXT(@"「Okay. Okay.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %HIS_HER(TALENT:51:育児中)% favorite word is "Okay," and %HE_SHE(TALENT:51:育児中)%@ repeats it after everything you say to %HIM_HER(TALENT:51:育児中)%.
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%@ has quite an agreeable personality...
	CASE "Brave"
		CALL CHILD_TEXT(@"「Let's play!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW He's not afraid to tell you what he's thinking, either.
		CALL CHILD_TEXT(@"「I'm hungry! I'm hungry!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW His voice is quite loud...
	CASE "Shameless"
		CALL CHILD_TEXT(@"「Plaaaysss!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW She still has trouble pronouncing her words, but she's extremely proactive about talking with you.
		CALL CHILD_TEXT(@"「%K51_EGG_CHILD_MASTER_NICKNAME(TALENT:51:育児中)%, I wawananna plays me?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW Her bright smile is so cute, it's hard to correct her...
	CASE "Moody"
		PRINTFORMW 「Eat your supper, sweet pickle!」
		CALL CHILD_TEXT(@"「No, I'm a don't like it.」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「Eeeh...」
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%@'s awfully opinionated sometimes...
	CASE "Liberated"
		PRINTFORMW 「Want to come to Mama, sweet pickle?」
		CALL CHILD_TEXT(@"「No!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「No?! Why not?!」
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%@ seems to have a rather independent personality...
ENDSELECT
