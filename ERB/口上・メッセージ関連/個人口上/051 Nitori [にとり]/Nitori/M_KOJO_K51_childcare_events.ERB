@M_KOJO_EGG_EVENT_K51_CHILD_RAISING_就学
;-------------------------------------------------
	;Attending school.
CALL SET_KOJO_COLOR(51)
PRINTFORMDL
PRINTFORMDW The time has come to enroll %CALLNAME:(TALENT:51:育児中)% in school. Nitori has been preparing for this...
SELECTCASE K51_EGG_CHILD_PERSONALITY(TALENT:51:育児中)
	CASE "Curious"
		PRINTFORMW 「You'll be studying with humans, so make sure you make lots of friends! Get to know everyone! Everyone!」
		CALL CHILD_TEXT(@"「Yes, %K51_EGG_CHILD_NITORI_NICKNAME(TALENT:51:育児中)%.」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「But don't stand out, and don't let them know you're not one of them!」
		CALL CHILD_TEXT(@"「Yes, %K51_EGG_CHILD_NITORI_NICKNAME(TALENT:51:育児中)%...」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「But be the smartest one in class! You'd better not come home with bad scores, or else!」
		CALL CHILD_TEXT(@"「Yes, %K51_EGG_CHILD_NITORI_NICKNAME(TALENT:51:育児中)%...?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW You try to calm Nitori down before she puts too much of a burden on %CALLNAME:(TALENT:51:育児中)%.
	CASE "Timid"
		PRINTFORMW 「Remember to make friends, okay?」
		CALL CHILD_TEXT(@"「...Okay.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW Although %HE_SHE(TALENT:51:育児中)%@ agrees, you and Nitori both sense trepidation in his voice.
		PRINTFORMW 「Oh, pickle, don't worry! They'll love you there! A kappa can always impress with %HIS_HER(TALENT:51:育児中)% smarts!」
		PRINTFORMDW You tell %HIM_HER(TALENT:51:育児中)% that's true. After all, it's why you had %HIM_HER(TALENT:51:育児中)% with Nitori.
		PRINTFORMDW As long as %HE_SHE(TALENT:51:育児中)%@ does %HIS_HER(TALENT:51:育児中)% best, you're sure %HE_SHE(TALENT:51:育児中)%@'ll get along just fine.
		CALL CHILD_TEXT(@"「I-I'll try...」",51,TALENT:51:育児中,"w")
		PRINTFORMDW Nitori hugs %HIM_HER(TALENT:51:育児中)% tightly, and you gently encourage %HIM_HER(TALENT:51:育児中)% together.
	CASE "Brave"
		PRINTFORMW 「Are you all set?」
		CALL CHILD_TEXT(@"「Yeah, I'm ready! No problem!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW He isn't lacking in confidence. Nitori glows with pride as she hugs and kisses him, but you notice he hasn't packed his bag.
		CALL CHILD_TEXT(@"「I don't need to take notes! I'll remember everything! I practically know it all, anyway!」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「Ooh, ha, ha! You're gonna get perfect scores without even trying, huh?」
		PRINTFORMDW Somehow, you have doubts.
	CASE "Shameless"
		CALL CHILD_TEXT(@"「I gots my human clothes! I'm readies!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW So she declares, wearing an open yukata and nothing else. It looks like it's also a size too big.
		PRINTFORMW 「Y-You can't go to school looking like that! Haven't I taught you how to do it up?」
		CALL CHILD_TEXT(@"「Sooooo annoyings～...」",51,TALENT:51:育児中,"w")
		PRINTFORMW 「Come on, dress properly! Everyone can see you! You don't want to be embarrassed at your first day of school, do you?」
		CALL CHILD_TEXT(@"「Why's embrassings?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW It takes a good deal more wrangling, and an impromptu lesson in modesty, before she's truly ready.
	CASE "Moody"
		CALL CHILD_TEXT(@"「Why do I have to go?」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)%, on the other hand, is scowling in annoyance.
		PRINTFORMW 「What's wrong, sweet pickle? Are you nervous?」
		CALL CHILD_TEXT(@"「No! There's just no point, I'm gonna know everything already!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW Sounds like %HE_SHE(TALENT:51:育児中)%@'s underestimating the human kids...
		PRINTFORMW 「Well, yeah, you're right about that...」
		PRINTFORMDW %HE_SHE(TALENT:51:育児中)%@ is?!
		PRINTFORMW 「B-But, think of all the human friends you'll make, being such a smart %PRINT_MALE("boy", TALENT:51:育児中)%!」
		CALL CHILD_TEXT(@"「I don't care! I don't wanna go!」",51,TALENT:51:育児中,"w")
		PRINTFORMDW It takes a bit more convincing to make %HIM_HER(TALENT:51:育児中)% give it a try...
	CASE "Liberated"
		PRINTFORMW 「All set? You're going to have a great time at school!」
		CALL CHILD_TEXT(@"「I'm not going, though.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW %CALLNAME:(TALENT:51:育児中)% nonchalantly answers Nitori, causing her to frown.
		PRINTFORMW 「Yes, you are! What's wrong?」
		CALL CHILD_TEXT(@"「Nothing's wrong, I just don't want to.」",51,TALENT:51:育児中,"w")
		PRINTFORMDW You have to talk %HIM_HER(TALENT:51:育児中)% into it...
ENDSELECT
