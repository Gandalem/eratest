							CALL CHILD_TEXT(@"「I'll hold this while you screw it in.」",51,ChildIndex,"l")
							CALL CHILD_TEXT(@"「Oh, the screwdriver... Here it is, %K51_EGG_CHILD_MASTER_NICKNAME(ChildIndex)%!」",51,ChildIndex,"l")
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% watches more than %HE_SHE_CHILD(51,,ChildIndex)% helps out.
							CALL CHILD_TEXT(@"「I didn't know you could put it like that...」",51,ChildIndex,"l")
							PRINTFORMDL Even so, %HE_SHE_CHILD(51,,ChildIndex)% seems to learn well.
					ENDSELECT
				CASE "Brave"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% tries to add an electric component.
							CALL CHILD_TEXT(@"「See, this will make it stronger!」",51,ChildIndex,"l")
							PRINTFORML 「No, no, no! That's so unsafe! You have to ground it first!」
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% tries to modify your design.
							CALL CHILD_TEXT(@"「We don't need this part.」",51,ChildIndex,"l")
							PRINTFORML 「That's a redundancy, it's there for safety.」
							CALL CHILD_TEXT(@"「But we don't need it!」",51,ChildIndex,"l")
					ENDSELECT
				CASE "Shameless"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% handles the machine carelessly and breaks off off a fragile part.
							CALL CHILD_TEXT(@"「Oops. I donesit bad.」",51,ChildIndex,"l")
							CALL CHILD_TEXT(@"「%K51_EGG_CHILD_MASTER_NICKNAME(ChildIndex)%, fixes it?」",51,ChildIndex,"l")
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% directs you in building the machine.
							CALL CHILD_TEXT(@"「Make its talls like a giraffe.」",51,ChildIndex,"l")
							CALL CHILD_TEXT(@"「An' fills it with coocumbers!」",51,ChildIndex,"l")
					ENDSELECT
				CASE "Moody"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% tries to boss you around.
							CALL CHILD_TEXT(@"「No! Put it like this! It works better!」",51,ChildIndex,"l")
							PRINTFORMDL %HE_SHE_CHILD(51,1,ChildIndex)% isn't afraid to let you know %HIS_HER_CHILD(51,,ChildIndex)% opinons...
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% keeps changing %HIS_HER_CHILD(51,,ChildIndex)% mind about it.
							CALL CHILD_TEXT(@"「How do you connect it? Shouldn't we do it like this?」",51,ChildIndex,"l")
							CALL CHILD_TEXT(@"「Wait, I get it, it's like that because you can... But it should be like this instead!」",51,ChildIndex,"l")
					ENDSELECT
				CASE "Liberated"
