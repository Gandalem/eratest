						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% turns it on while it's disassembled to see how it moves.
							CALL CHILD_TEXT(@"「Wow! It's gonna tear itself apart! Haha!」",51,ChildIndex,"l")
					ENDSELECT
				CASE "Shameless"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% tears the front off of the machine instead of taking it apart properly.
							PRINTFORML 「Nooo, we're supposed to put it back together!」
							CALL CHILD_TEXT(@"「I donesit wrong? Sorries...」",51,ChildIndex,"l")
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% tugs on you while you're working at it.
							CALL CHILD_TEXT(@"「%K51_EGG_CHILD_MASTER_NICKNAME(ChildIndex)%, snacks times?」",51,ChildIndex,"l")
					ENDSELECT
				CASE "Moody"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% diligently sorts and categorizes all of the parts.
							PRINTFORML 「You're more organized than I am...」
							CALL CHILD_TEXT(@"「This is the right way, %K51_EGG_CHILD_NITORI_NICKNAME(ChildIndex)%, you just don't do it right.」",51,ChildIndex,"l")
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% puts everything back exactly the way it's supposed to be.
							PRINTFORML 「You remembered everything perfectly! That's so great!」
							CALL CHILD_TEXT(@"「Any kappa could do that much...」",51,ChildIndex,"l")
					ENDSELECT
				CASE "Liberated"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% rebuilds it the wrong way on purpose.
							CALL CHILD_TEXT(@"「I improved it, see? It looks better and you can make attachments.」",51,ChildIndex,"l")
							CALL CHILD_TEXT(@"「I'm gonna add a new feature right now!」",51,ChildIndex,"l")
						CASE 1
							PRINTFORMDL %CHILDNAME:51:ChildIndex% takes apart a different machine by %HIM_HER_CHILD(51,,ChildIndex)%self.
							PRINTFORML 「I wanted us to do it together...」
							CALL CHILD_TEXT(@"「I wanna do this one. You can do that one.」",51,ChildIndex,"l")
					ENDSELECT
			ENDSELECT
		ENDIF
	ELSE
		PRINTFORMDL %LOCALS% %SPLIT_G(@"practice building a machine:build an experimental kappa machine:put together a kappa machine:modify a kappa machine")%%LOCALS:1%...
		PRINTFORMDW
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「Hmm, that doesn't look bad.」
				PRINTFORML 「Here, I'll show you a trick to doing it more efficiently.」
				PRINTFORMDL Nitori encourages you while showing you better ways of building.
			CASE 1
				PRINTFORML 「We've got a whole tub of screws over here. The specialized parts are... somewhere...」
				PRINTFORML 「Well, If you think of of anything specific, I can find it.」
			CASE 2
				PRINTFORML 「Huh? A blueprint?」
				PRINTFORML 「Nah, I keep stuff like that in my head. Here, I'll show you how to build it.」
			CASE 3
				PRINTFORML 「Creativity is more important than efficiency when it comes to this.」
				PRINTFORML 「I mean, what's the point if you're not enjoying yourself?」
		ENDSELECT
		IF ChildIndex
			SELECTCASE K51_EGG_CHILD_PERSONALITY(ChildIndex)
				CASE "Curious"
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL %CHILDNAME:51:ChildIndex% hovers and interrogates you about your creation.
							CALL CHILD_TEXT(@"「What are you making, %K51_EGG_CHILD_MASTER_NICKNAME(ChildIndex)%? What does it do? How does it work?」",51,ChildIndex,"l")
						CASE 1
