@M_KOJO_EGG_MESSAGE_COM_K51_368
;Join Activity.
IF Activity_Type:51 == 12
	CALL M_KOJO_EGG_MESSAGE_COM_K51_403
	RETURN 1
ENDIF
CALL D_LINE
SELECTCASE Activity_Type:51
	CASE 0
		;Join Navelgazing.
		;TFLAG:193, -1 = Brushed off.
		PRINTFORMDL 너는 니토리에게 무엇을 생각하는지 묻는다...
		PRINTFORMDW
		IF TFLAG:193 > -1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%SPLIT_G(@"%K51_EGG_PROJECT_NAME()%에 대해서 막힌 게 좀 있어.:새로운 기능들로 %K51_EGG_PROJECT_NAME()%을... 더 흥미진진해야 하는데!:아, 내 %K51_EGG_PROJECT_NAME()%에 대해 생각 중이야.")%」
					PRINTFORMDL 당신의 두 사람은 잠시 동안 그녀의 프로젝트에 대해 브레인스토밍을 했다.
				CASE 1
					PRINTFORML 「새로운 %SPLIT_G(@"product:service")%에 대한 아이디어가 생겼어. 이거 돈 주고 살 의향이 있는지 말해줘.」
					PRINTFORMDL 니토리가 설명을 시작하고 당신은 그녀의 아이디어에 대해 논한다.
				CASE 2
					PRINTFORML 「내 도구들이 수리가 필요해서, 그럴 겸 새로운 모드를 줄까 생각 중이야.」
					PRINTFORMDL 당신은 그녀에게 창의적인 통찰을 제공한다.
				CASE 3
					PRINTFORML 「그냥 심심해... 뭘 만들 아이디어가 없어.」
					PRINTFORML 「지금은 재미있을 만한 기계 같은 게 있어야 하는데...」
					PRINTFORMDL 당신이 몇 가지 제안을 내고 가능성에 대해 논의한다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「지금은 안 돼, 거의 다 잡았어...」
					PRINTFORMDL 뭔가 복잡한 것 같아.
				CASE 1
					PRINTFORML 「아아, 안 돼!! 내 생각의 흐름을 끊었잖아!」
					PRINTFORMDL 방해받고 싶지 않았던 것 같네...
				CASE 2
					PRINTFORML 「오이... 오이... 오이지?」
					PRINTFORMDL ...하지만 그녀는 완전히 당신을 무시하고 자신의 세계에 빠져있다.
				CASE 3
					PRINTFORML 「나한테 말 걸지 마, 지금 아이디어의 문턱에 있단 말이야!」
					PRINTFORMDL 니토리는 집중하는 듯한 표정으로 가만히 앉아 당신을 무시한다...
			ENDSELECT
		ENDIF
	CASE 1
		;Participate in Play.
		;Only for [Childish] characters.
		;TFLAG:193, -1 = Not very lively, 1 = Very lively.
		PRINTFORMDL 너는 니토리와 장난을 친다...
		PRINTFORMDL
	CASE 2
		;Join Meal.
		;TFLAG:193, -1 = MASTER isn't hungry.
		$JOINMEAL
		PRINTFORMDL 당신과 니토리(Nitori)는 함께 식사를 한다...
		PRINTFORMDW
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「오이 샌드위치 있어, 하나 먹을래?」
				PRINTFORMDL 샌드위치를 한 입 베어 물자... 너무 가득 차 있어서 샌드위치보다 오이가 더 많았다.
			CASE 1
				PRINTFORML 「초밥 먹고 싶어? 많이 만들었어.」
				PRINTFORMDL 예상대로, 니토리의 도시락은 카파마키밖에 들어있지 않아. 몇 개나 가져가도 돼.
			CASE 2
				PRINTFORML 「원하면 쌀이 아주 많아.」
				PRINTFORMDL 당신은 그 밥을 먹다가 안에 숨겨진 오이 조각들을 발견한다.
			CASE 3
				PRINTFORML 「많은 걸 만들었으니 마음껏 가져가.」
				PRINTFORMDL 신비로운 공 모양의 음식에 대해 묻는 것을 피하고 대신 고기를 좀 취한다.
		ENDSELECT
		IF TFLAG:193 > -1
			IF ABL:51:料理技能 > 2
				PRINTFORMDL %SPLIT_G(@"맛있어! 사랑을 담아 만든 게 분명해.:너무 맛있어서 결국 너무 많이 먹게 돼...:맛있다는 게 밝혀지다. 그렇게 말하자 니토리는 가슴을 부풀린다.")%
				PRINTFORML 「%SPLIT_G(@"그 모든 연습이 헛되지 않았음을 추측해봐!: 배우려고 열심히 노력했어, 알잖아!: 네가 좋아하니 정말 기쁘다!: 굉장해! 괜찮게 될 거라고 바라고 있었어!")%」
				PRINTFORMDL 두 분이 함께 음식을 즐깁니다.
			ELSE
				PRINTFORMDL %SPLIT_G(@"소금이 너무 많다:조금 물컹하다:식감이 조금 이상하다")%...
			ENDIF
		ELSE
			IF ABL:51:料理技能 > 2
				PRINTFORMDL 배가 안 고프니 조금만 먹지만, 맛은 꽤 좋다.
			ELSE
				PRINTFORMDL 배가 고프지 않아서 조금만 먹지만 어쨌든 너무 짜다...
			ENDIF
		ENDIF
	CASE 3
		;Join Snack.
		;Only for [Fairy] characters, Rumia, Koishi, Yuyuko, and Shion.
		;TFLAG:193, -1 = MASTER isn't hungry.
		PRINTFORMDL 당신과 니토리(Nitori)는 비밀리에 간식을 공유한다...
		PRINTFORMDL
	CASE 4
		;Join Cleaning.
		;Only for [Cleaner], [Smell Sensitive], and [Clean Freak] characters.
		PRINTFORMDL 당신은 니토리에게 청소를 돕는다...
		PRINTFORMDL
	CASE 5
		;Join Exercising.
		;Not for characters with [Musical Knowledge], [Singing Knowledge], or [Dancing Knowledge].
		PRINTFORMDL 당신은 니토리에게 실험적인 운동 기계를 테스트하는 것을 도와준다...
		PRINTFORMDW
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「기본적으로 계단을 올라가는 것이니 충분히 쉬울 것이다.」
				PRINTFORMDL %SPLIT_G(@"그녀의 말에도 불구하고 페달은 꽤 무겁다: 기계의 리듬감이 약간 어긋나 있다: 사용할수록 기계는 더 시끄러워진다")%...
			CASE 1
				PRINTFORML 「휴대용 트레드밀이다. 원하는 속도로 달려라!」
				PRINTFORMDL %SPLIT_G(@"운동 도중 절반쯤 지났을 때, 트레드밀이 통제 불능으로 속도를 높인다: 어쩐 일인지 트레드밀이 계속 방향을 바꾼다: 트레드밀이 갑자기 멈추면서 당신이 넘어지게 된다")%...
			CASE 2
				PRINTFORML 「그것 아래에 앉아서 이걸 잡아당겨라.」
				PRINTFORMDL %SPLIT_G(@"당신이 코드를 잡아당기면, 기계의 전체 상반부가 날카로운 삐걱거리는 소리와 함께 앞으로 휘어진다:당신이 코드를 충분히 세게 잡아당겨서 그것이 기계에서 튀어나온다:코드는 더 많이 할수록 당기기가 점점 더 힘들어진다")%...
			CASE 3
				PRINTFORML 「배를 노젓는 것과 기본적으로 같은 동작이야. 팔이랑 코어에 아주 좋은 운동이 될 거야!」
				PRINTFORMDL %SPLIT_G(@"짧은 시간 노를 저은 후에, 모든 것이 전복된다:노를 저으면 기계가 뒤로 움직이고, 팔이 부러지는 것을 피하기 위해 싸우게 된다:좌석이 받침대에서 미끄러져 내려가고 당신이 그것을 노하자 기계가 앞으로 굴러가기 시작한다")%...
		ENDSELECT
		PRINTL
		PRINTFORML 「%SPLIT_G(@"음, 더 작업이 필요할 것 같다.:좋은 데이터네, 도와줘서 고마워!:오, 그렇게 살짝 수정해볼 수 있을까...:그러니까 다음 버전에서는 다른 접근 방식을 시도해봐야겠다...:다시 밑바닥부터 시작해야겠지.:조금만 손보면 어떨까...:그게 문제인 것 같긴 한데, 고쳐보자...")%」
		PRINTFORMDL 니토리(Nitori)는 테스트 결과를 숙고했다.
	CASE 6
		;Join Reading.
		;TFLAG:193, -1 = Too focused to answer.
		PRINTFORMDL 너는 니토리에게 그녀가 무엇을 읽고 있는지 묻는다...
		PRINTFORMDW
		IF TFLAG:193 > -1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「수입된 설명서라, 내부적인 것들이 정확히 무엇을 위한 건지 잘 알려주지 않네...」
					PRINTFORMDL 그녀는 외부 세계의 유물들을 공부하는 모양이다. 당신이 그녀에게 지식을 좀 공유한다.
				CASE 1
					PRINTFORML 「이거? 이건 텐구 소녀 만화야...」
					PRINTFORMDL 커버를 본다... 카파와 \@ IS_NONHUMAN(MASTER) ? 다른 요괴 # 인간 \@ 사이의 로맨스 이야기다.
					IF IS_CHILD(MASTER) && IS_MALE(MASTER)
						PRINTFORMDL 게다가, 그것은 샷코짱 출판물이다...
					ELSEIF !IS_MALE(MASTER)
						PRINTFORMDL 게다가 그것은 유리가 연재물이다%COND_STR(" with a lolicon theme",IS_CHILD(MASTER))%...
					ENDIF
					PRINTFORMDL 니토리(Nitori)는 그 뒤에 얼굴을 숨기려 한다...
				CASE 2
					PRINTFORML 「이건 수입 소설이야. 가끔 인간이 쓴 책을 읽는 걸 좋아해.」
					PRINTFORMDL 당신은 제목을 알아보고 그녀와 잠시 이야기를 나눈다.
				CASE 3
					PRINTFORML 「이건 내 옛날 설계도야. 근데 필체가 뭔지 도저히 모르겠네...」
					PRINTFORMDL 그녀의 어깨 너머로 본 것은 완전한 낙서였다. 그걸 읽을 수 있었다는 게 기적이다.
					PRINTFORML 「사실 이걸 처음 보는 거야. 난 평소에 계획 같은 걸 잘 안 쓰거든, 그래서...」
					PRINTFORMDL 그녀는 문맹이 되어버리겠어...
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「어, 음, 좋아...」
					PRINTFORMDL 그녀는 대답하려고 노력하지만, 너무 정신이 팔려 아무 말도 하지 못한다.
				CASE 1
					PRINTFORML 「너 좀 방해되는데...」
					PRINTFORMDL 그녀는 책에서 눈을 떼지 않았다.
				CASE 2
					PRINTFORML 「음, 그래... 응.」
