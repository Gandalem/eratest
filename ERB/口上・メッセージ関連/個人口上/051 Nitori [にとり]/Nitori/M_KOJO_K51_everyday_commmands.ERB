@M_KOJO_EGG_MESSAGE_COM_K51_368
	;Join Activity.
IF Activity_Type:51 == 12
	CALL M_KOJO_EGG_MESSAGE_COM_K51_403
	RETURN 1
ENDIF
CALL D_LINE
SELECTCASE Activity_Type:51
	CASE 0
			;Join Navelgazing.
			;TFLAG:193, -1 = Brushed off.
		PRINTFORMDL You ask Nitori what she's thinking about...
		PRINTFORMDW
		IF TFLAG:193 > -1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「%SPLIT_G(@"Just something I'm stuck on with the %K51_EGG_PROJECT_NAME()%.:New features for the %K51_EGG_PROJECT_NAME()%... It needs to be more exciting!:Oh, I'm thinking about my %K51_EGG_PROJECT_NAME()%.")%」
					PRINTFORMDL The two of your brainstorm about her project for a little while.
				CASE 1
					PRINTFORML 「I had an idea for a new %SPLIT_G(@"product:service")%. Tell me if you'd spend money on this.」
					PRINTFORMDL Nitori launches into an explanation and you discuss her idea with her.
				CASE 2
					PRINTFORML 「My tools are in need of repair, so I'm thinking about new mods I could give them while I'm at it.」
					PRINTFORMDL You offer her some creative insight.
				CASE 3
					PRINTFORML 「I'm just bored... I don't have any ideas for stuff to build.」
					PRINTFORML 「There's gotta be a machine or something that'd be fun right now...」
					PRINTFORMDL You throw out some suggestions and discuss the possibilities.
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「Not now, I've almost got it...」
					PRINTFORMDL Seems it's something complicated.
				CASE 1
					PRINTFORML 「Aaah, nooo! You made me lose my train of thought!」
					PRINTFORMDL Looks like she didn't want to be disturbed...
				CASE 2
					PRINTFORML 「Cucumber... Cucumber... Cucumber...?」
					PRINTFORMDL ...But she completely ignores you, lost in her own world.
				CASE 3
					PRINTFORML 「Don't talk to me, I'm on the cusp of an idea!」
					PRINTFORMDL Nitori sits still with a look of concentration, ignoring you...
			ENDSELECT
		ENDIF
	CASE 1
			;Participate in Play.
			;Only for [Childish] characters.
			;TFLAG:193, -1 = Not very lively, 1 = Very lively.
		PRINTFORMDL You play around with Nitori...
		PRINTFORMDL
	CASE 2
			;Join Meal.
			;TFLAG:193, -1 = MASTER isn't hungry.
		$JOINMEAL
		PRINTFORMDL You and Nitori share a meal...
		PRINTFORMDW
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「I've got cucumber sandwiches, you want one?」
				PRINTFORMDL You bite into the sandwich... It's packed so full, there's more cucumber than sandwich.
			CASE 1
				PRINTFORML 「Want sushi? I made a lot.」
				PRINTFORMDL As expected, Nitori's lunchbox is full of nothing but kappamaki. You help yourself to a few of them.
			CASE 2
				PRINTFORML 「I've got lots of rice if you want some.」
				PRINTFORMDL You dig in to the rice and find slices of cucumber hidden inside.
			CASE 3
				PRINTFORML 「I made a lot of stuff, so help yourself.」
				PRINTFORMDL You avoid asking about the mysterious ball-shaped food and take some meat instead.
		ENDSELECT
		IF TFLAG:193 > -1
			IF ABL:51:料理技能 > 2
				PRINTFORMDL %SPLIT_G(@"It's delicious! Must have been made with love.:It tastes so good, you end up taking too much...:It turns out to be delicious. When you say so, Nitori puffs out her chest.")%
				PRINTFORML 「%SPLIT_G(@"Guess all that practice wasn't for nothing!:I worked hard to learn, you know!:I'm really happy you like it!:Great! I was hoping it'd turn out okay!")%」
				PRINTFORMDL The two of you enjoy the food together.
			ELSE
				PRINTFORMDL %SPLIT_G(@"There's way too much salt:It's a little soggy:The texture is a little off")%...
			ENDIF
		ELSE
			IF ABL:51:料理技能 > 2
				PRINTFORMDL You're not hungry so you only have a little, but it tastes pretty good.
			ELSE
				PRINTFORMDL You're not hungry so you only have a little, but it tastes too salty anyway...
			ENDIF
		ENDIF
	CASE 3
			;Join Snack.
			;Only for [Fairy] characters, Rumia, Koishi, Yuyuko, and Shion.
			;TFLAG:193, -1 = MASTER isn't hungry.
		PRINTFORMDL You and Nitori share a snack in secret...
		PRINTFORMDL
	CASE 4
			;Join Cleaning.
			;Only for [Cleaner], [Smell Sensitive], and [Clean Freak] characters.
		PRINTFORMDL You help Nitori clean up...
		PRINTFORMDL
	CASE 5
			;Join Exercising.
			;Not for characters with [Musical Knowledge], [Singing Knowledge], or [Dancing Knowledge].
		PRINTFORMDL You help Nitori test an experimental workout machine...
		PRINTFORMDW
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「It's basically walking up stairs, so it should be easy enough.」
				PRINTFORMDL %SPLIT_G(@"Despite her words, the pedals are pretty heavy:The machine's sense of rhythm is a little off:The more you use it, the noisier the machine gets")%...
			CASE 1
				PRINTFORML 「It's a portable treadmill. Run at your own pace!」
				PRINTFORMDL %SPLIT_G(@"Halfway through the exercise, the treadmill speeds up out of control:For some reason, the treadmill keeps reversing direction:The treadmill abruptly stops, causing you to fall over")%...
			CASE 2
				PRINTFORML 「Just sit under it and pull on this.」
				PRINTFORMDL %SPLIT_G(@"When you yank on the cord, the whole upper half of the machine bends forward with a shrill creak:You yank the cord hard enough that it pops right out of the machine:The cord gets harder and harder to pull the more you do it")%...
			CASE 3
				PRINTFORML 「It's basically the same motion as rowing a boat. It should be a great workout for your arms and your core!」
				PRINTFORMDL %SPLIT_G(@"After only a short time rowing, the whole thing capsizes:Once you start rowing, the machine rows back, and you engage in a battle to avoid it breaking your arms:The seat slips off the base and the machine starts to roll forward as you row it")%...
		ENDSELECT
		PRINTL
		PRINTFORML 「%SPLIT_G(@"Hmm, I guess it needs more work.:This is good data, thanks for your help!:Oh, maybe I can tweak it like that...:So, for the next version, I'll try a different approach...:Back to the drawing board, I guess.:Maybe with a little tweak...:I guess that's an issue, but fixing it...")%」
		PRINTFORMDL Nitori ruminates on the results of the test.
	CASE 6
			;Join Reading.
			;TFLAG:193, -1 = Too focused to answer.
		PRINTFORMDL You ask Nitori about what she's reading...
		PRINTFORMDW
		IF TFLAG:193 > -1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「It's an imported manual, but it doesn't really tell me what all the internals are for...」
					PRINTFORMDL Looks like she's studying up on outside world artifacts. You share some of your knowledge with her.
				CASE 1
					PRINTFORML 「This? It's a tengu shoujo manga...」
					PRINTFORMDL You look at the cover... It's a romance story between a kappa and \@ IS_NONHUMAN(MASTER) ? another youkai # human\@.
					IF IS_CHILD(MASTER) && IS_MALE(MASTER)
						PRINTFORMDL On top of that, it's a shotacon publication...
					ELSEIF !IS_MALE(MASTER)
						PRINTFORMDL On top of that, it's a yuri publication%COND_STR(" with a lolicon theme",IS_CHILD(MASTER))%...
					ENDIF
					PRINTFORMDL Nitori tries to hide her blushing face behind it...
				CASE 2
					PRINTFORML 「It's an imported novel. I like to read books written by humans sometimes.」
					PRINTFORMDL You recognize the title and discuss it with her for a bit.
				CASE 3
					PRINTFORML 「It's an old blueprint of mine. I can't make sense of the handwriting, though...」
					PRINTFORMDL Looking over her shoulder, you see complete and utter chicken scratch. It's a wonder she ever could read it.
					PRINTFORML 「It's actually my first time reading it. I don't usually write plans anyway, so...」
					PRINTFORMDL She's going to become illiterate...
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「It's, uh, it's good...」
					PRINTFORMDL Though she tries to respond, she's too distracted to say anything.
				CASE 1
					PRINTFORML 「You're kinda distracting me...」
					PRINTFORMDL She doesn't take her eyes off of the book.
				CASE 2
					PRINTFORML 「Mm, yeah... Uh-huh.」
					PRINTFORMDL ...She's not listening to you at all.
				CASE 3
					PRINTFORML 「.........」
					PRINTFORMDL She's so focused, you don't get an answer.
			ENDSELECT
		ENDIF
	CASE 7
