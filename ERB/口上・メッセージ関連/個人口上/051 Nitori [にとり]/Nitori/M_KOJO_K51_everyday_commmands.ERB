			PRINTFORML 「Um, never mind, it's fine...」
		CASE 3
			PRINTFORML 「Why do you do that stuff, seriously...」
			PRINTFORMDL Nitori looks away in embarrassment.
	ENDSELECT
ELSE
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML 「Ahaha, you...」
			PRINTFORMDL Nitori leans her body into yours and gives you a hug.
		CASE 1
			PRINTFORML 「You just treat me however you want to, don't you?」
			PRINTFORMDL Nitori smirks wryly while fixing her cap.
		CASE 2
			IF TALENT:MASTER:体型 > TALENT:51:体型
				PRINTFORML 「That's not fair, I can't do that back to you!」
				PRINTFORMDL Nitori stands on tiptoe and demands you bow your head so she can kiss it.
			ELSE
				PRINTFORML 「Oh, come on, you!」
				PRINTFORMDL Nitori kisses your forehead back while giggling.
			ENDIF
		CASE 3
			PRINTFORML 「Aaah, my weak spot!」
			PRINTFORMDL Nitori fixes her cap while blushing and giggling.
	ENDSELECT
ENDIF
WAIT
RETURN 1
