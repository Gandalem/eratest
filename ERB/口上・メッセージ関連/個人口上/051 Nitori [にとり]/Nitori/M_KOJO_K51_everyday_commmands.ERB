			CASEELSE
				PRINTFORML 「You guys are going out?」
				PRINTFORML 「Have fun...」
		ENDSELECT
	ENDIF
ELSE
		;Go Out.
	IF CFLAG:51:K51_EGG_EVENT_TIER && TALENT:51:機嫌 > -1
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「You're heading out? See you later.」
