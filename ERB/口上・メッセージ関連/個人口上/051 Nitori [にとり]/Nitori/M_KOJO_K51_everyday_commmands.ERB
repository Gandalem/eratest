			CASE 1
				PRINTFORML 「Off again? Good luck!」
				PRINTFORMDL Nitori sees you off with a cheerful wave.
			CASE 2
				PRINTFORML 「Where are you going? ...Ah, got it! Have fun!」
				PRINTFORMDL Nitori sees you off.
			CASE 3
				PRINTFORML 「Byyyye!」
				PRINTFORMDL Nitori waves at you with her whole arm.
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「O-oh, you're heading out?」
				PRINTFORMDL Nitori quietly waves goodbye.
			CASE 1
				PRINTFORML 「Off again? ...Good luck.」
