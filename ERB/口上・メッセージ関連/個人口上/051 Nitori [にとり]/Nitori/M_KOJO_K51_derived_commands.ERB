;19,授乳プレイ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_EGG_MESSAGE_MESSAGECHECK_SCOM_K51_19
RETURN 0

@M_KOJO_EGG_MESSAGE_SCOM_K51_19
SIF !SHIRAHU(51)
	RETURN 1
SELECTCASE RAND:4
	CASE 0
		PRINTFORML 「이봐, 너 큰 애처럼 구는 거 좀 어때 보여?」
		IF IS_CHILD(MASTER)
			PRINTFORML %HE_SHE(MASTER,1)%는 이렇게 너무 귀여워! 나 소리 지를 거야!
		ELSE
			PRINTFORML (%HE_SHE(MASTER,1)%의 이런 모습이 좀 귀엽다...)
		ENDIF
	CASE 1
		IF TALENT:51:母乳体質 || (CFLAG:51:出産経過日 && CFLAG:51:出産経過日 < CHILD_離乳) ;Lactating.
			IF IS_CHILD(MASTER)
				CALL HPH_PRINT(@"「마시고 튼튼해져라. 아빠도 여기서 너를 행복하게 해줄게...」","l")
				PRINTFORML %HE_SHE(MASTER,1)%는 너무 귀엽다!
			ELSE
				IF CFLAG:51:出産経過日 < CHILD_離乳
					CALL HPH_PRINT(@"「%CHILDNAME:51:(LATEST_CHILD(51,1))%와 나누고 있으니 조금 남겨둬라」","l")
					CALL HPH_PRINT(@"「내가 여기서 너를 행복하게 해 줄게... HPH」","l")
				ELSE
					CALL HPH_PRINT(@"「부끄러워하지 마, 아직 우유가 많이 남아있어 HPH」","l")
				ENDIF
				PRINTFORML %HE_SHE(MASTER,1)%는 참 온순하네... %COND_STR(" What a rare moment!",TALENT:MASTER:態度 == 1)%
			ENDIF
		ELSE
			CALL HPH_PRINT(@"「%SPLIT_G("Nothing tasty's gonna come outta there... But it might down hereHPH:I bet I'll find more milk in here than you will in thereHPH")%」","l")
			IF IS_CHILD(MASTER)
				PRINTFORML (%HE_SHE(MASTER,1)%는 우유가 너무 목마르다니, 얼마나 슬픈 일이야!)
			ELSE
				PRINTFORML %HE_SHE(MASTER,1)%이 너무 열중해서 귀엽다...
			ENDIF
		ENDIF
	CASE 2
		PRINTFORML 「그렇게 보이면 나도 모르게 좀 응석을 받아주고 싶어져.」
		PRINTFORML (%HE_SHE(MASTER,1)%이 눈을 감고 %HIS_HER(MASTER)%의 입맛으로 빨 때 \@ IS_CHILD(MASTER) ? , 정말 달콤해! # ... \@)
	CASE 3
		IF CFLAG:51:出産経過日 < CHILD_離乳
			CALL HPH_PRINT(@"「나를 짜도 되고, 내가 당신을 짜 줄게HPH」","l")
		ELSE
			PRINTFORML 「음, 너무 세게 빨지 마, 부드럽게 해... 좋아, 여기서 얼마나 좋아할 수 있는지 보자...!」
		ENDIF
		PRINTFORML (하아, 그냥 %HIM_HER(MASTER)%를 더 힘들게 만들 뿐이잖아!)
ENDSELECT
RETURN 1
