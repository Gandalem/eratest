;==================================================
;19,授乳プレイ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EGG_MESSAGE_MESSAGECHECK_SCOM_K51_19
RETURN 0

@M_KOJO_EGG_MESSAGE_SCOM_K51_19
SIF !SHIRAHU(51)
	RETURN 1
SELECTCASE RAND:4
	CASE 0
		PRINTFORML 「C'mon, you big baby... Do you get how silly you look?」
		IF IS_CHILD(MASTER)
			PRINTFORML (%HE_SHE(MASTER,1)%'s so adorable like this! I'm gonna scream!)
		ELSE
			PRINTFORML (%HE_SHE(MASTER,1)%'s kind of cute like this...)
		ENDIF
	CASE 1
		IF TALENT:51:母乳体質 || (CFLAG:51:出産経過日 && CFLAG:51:出産経過日 < CHILD_離乳) ;Lactating.
			IF IS_CHILD(MASTER)
				CALL HPH_PRINT(@"「Drink up and grow strongHPH I'll make you happy down here, too...」","l")
				PRINTFORML (%HE_SHE(MASTER,1)%'s sooooo cute!)
			ELSE
				IF CFLAG:51:出産経過日 < CHILD_離乳
					CALL HPH_PRINT(@"「You're sharing with %CHILDNAME:51:(LATEST_CHILD(51,1))%, so leave a little bitHPH」","l")
					CALL HPH_PRINT(@"「I'll make you happy down here in return...HPH」","l")
				ELSE
					CALL HPH_PRINT(@"「Don't be shy, there's lots of milk leftHPH」","l")
				ENDIF
				PRINTFORML (%HE_SHE(MASTER,1)%'s so docile...%COND_STR(" What a rare moment!",TALENT:MASTER:態度 == 1)%)
			ENDIF
		ELSE
			CALL HPH_PRINT(@"「%SPLIT_G("Nothing tasty's gonna come outta there... But it might down hereHPH:I bet I'll find more milk in here than you will in thereHPH")%」","l")
			IF IS_CHILD(MASTER)
				PRINTFORML (%HE_SHE(MASTER,1)%'s so thirsty for milk, how sad!)
			ELSE
				PRINTFORML (%HE_SHE(MASTER,1)%'s so into it, it's cute...)
			ENDIF
		ENDIF
	CASE 2
		PRINTFORML 「When you look like that, I can't help but pamper you a little.」
		PRINTFORML (%HE_SHE(MASTER,1)%'s sucking with %HIS_HER(MASTER)% eyes closed\@ IS_CHILD(MASTER) ? , how sweet! # ...\@)
	CASE 3
		IF CFLAG:51:出産経過日 < CHILD_離乳
			CALL HPH_PRINT(@"「You can milk me and I'll milk youHPH」","l")
		ELSE
			PRINTFORML 「Mmmh, don't suck so hard, be gentle... Fine, let's see how you like it down here...!」
		ENDIF
		PRINTFORML (Gah, it's only making %HIM_HER(MASTER)% suck harder!)
ENDSELECT
RETURN 1