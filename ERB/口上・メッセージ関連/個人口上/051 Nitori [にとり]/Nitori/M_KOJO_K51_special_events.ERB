@K51_EGG_SPECIAL_EVENT(Counter)
	;Function for events called from normal conversation.
#DIM DYNAMIC Counter
SIF CHK_DATENOW(CFLAG:51:デート中)
	RETURN 0
		;First check follow-ups. These are either small dialogues after the main event, or a continuation of an event that spans more than a single command.
IF CFLAG:51:K51_EGG_EVENT_PICNIC > 0
	SELECTCASE CFLAG:51:K51_EGG_EVENT_PICNIC
		CASE 1
			PRINTFORMDL Nitori still looks pleased%COND_STR(" when you talk with her",!Counter)%...
