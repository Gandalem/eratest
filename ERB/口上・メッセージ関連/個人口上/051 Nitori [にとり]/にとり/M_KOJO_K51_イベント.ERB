@M_KOJO_EVENT_K51_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORML 「후아아～... %CALLNAME:MASTER%, 나 좀 졸리네...」 
			PRINTFORMW 「나 방으로 돌아갈게.」
			PRINTFORMW 「기분 있으면, 이불 밑에 같이 들어올래...?」
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORML 「...오늘 밤 잠자리에 들 시간인 것 같아.」
			PRINTFORMW 「흠... 내일 봐요, %CALLNAME:MASTER%...」
			PRINTFORMDW 니토리는 조금 외로워 보이며 자신의 방으로 돌아간다...
		ELSE
			PRINTFORML 「음, 이제 밤이니까 집에 가야겠어.」
			PRINTFORMW 「잘 자라, 맹세한 친구여!」
			PRINTFORMDW 그리고 그렇게 니토리는 떠난다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORML 「후아아...」
			PRINTFORMDL 니토리는 작은 하품을 한다.
			PRINTFORML 「으음... 좀 졸리네... %CALLNAME:MASTER%, 내 무릎 좀 빌려줘.」
			PRINTFORMDW 그리고 그렇게, 니토리는 당신의 무릎을 베개 삼아 잠들기 시작한다.
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORML 「음, 음음—...」
			PRINTFORMDL 니토리(Nitori)가 기지개를 켜며 하품을 한다.
			PRINTFORMDL 그러더니 당신이 자신을 보고 있는 것을 알아차린다...
			PRINTFORML 「음—... 좀 졸린 것 같아...」
			PRINTFORMDW 그녀는 수줍게 당신을 흘긋 본다.
		ELSEIF TALENT:思慕
			PRINTFORML 「음—…」
			PRINTFORMDL 니토리는 기지개를 켜며 목을 돌린다…
			PRINTFORMW 「이제 잘 시간인 것 같아…」
		ELSE
			PRINTFORML 「음... 좋은 일은 충분한 휴식이 필요하겠지?」
			PRINTFORMDW 니토리는 혼잣말을 하며 졸린 듯 몸을 쭉 편다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORML 「에헤헤... %CALLNAME:MASTER%...」
			PRINTFORMDL 잠꼬리를 하는 니토리가 당신의 이름을 부른다...
			PRINTFORML 「음... 사랑해...」
			PRINTFORMDW 그녀의 행복한 얼굴을 바라보는 것이 마음을 따뜻하게 채운다.
		ELSEIF TALENT:恋慕
			PRINTFORMW 「으응……」
			PRINTFORML 「Nmー... %CALLNAME:MASTER%...」
			PRINTFORMDW 니토리의 이름이 들리고, 그녀가 깨고 있는 건 아닐까 생각한다.
			PRINTFORMW 「Un...」
			PRINTFORMDL 하지만, 그렇게 보이지 않는군.
			PRINTFORML 「음... 후후후...」
			PRINTFORMDW 니토리의 잠든 얼굴은 매우 평화롭다.
		ELSE
			PRINTFORML 「스으... 스으...」
			PRINTFORMDL 니토리는 잠을 자며 규칙적인 리듬으로 숨을 쉬었다.
			PRINTFORMDW 이제... 너는 뭘 할 거니...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「아아... 음~!」
				CASE 1
					PRINTFORMW 「음... 꾸...」
				CASE 0
					PRINTFORMW 「흐음...! 하아...하아...」
			ENDSELECT
			RETURN 1
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「음... 그만해...」
				CASE 1
					PRINTFORMW 「음... 아니야...」
				CASE 0
					PRINTFORMW 「아... 후우...」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;衰弱中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「음... 너무 무리하고 있어요, %CALLNAME:MASTER%... 잠시 쉬어야 해요...」
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORMW 「맹세한 친구―… 난… 갈 수 없어…」
		ELSE
			;could use a variation for if the player is a 2hu
			PRINTFORMW 「나... 나는 매복당했어... 네가 아직 계속 나아가는 걸 믿을 수가 없어, 맹세한 친구야... 너 정말 인간이야?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%!! 뭐-뭔 일이야?!」
			PRINTFORMDW 과로로 쓰러지자 니토리(Nitori)가 괴로워하며 비명을 지른다.
			PRINTFORML 「그냥 피곤한 거야? 정말로?」
			PRINTFORMDW 걱정스러운 표정을 짓고 있는 니토리에게 괜찮다고 안심시키려 한다.
			PRINTFORML 「적어도 방까지는 데려가야지.」
			PRINTFORMDW 그렇게 말하며 니토리는 당신을 품에 안고 걸음을 옮긴다.
			RETURN 1
		ELSEIF TALENT:恋慕
			PRINTFORML 「%CALLNAME:MASTER%... 괜찮으세요?」
			PRINTFORMDW 노리토는 당신이 탈진하여 쓰러지자 걱정스럽게 부른다.
			PRINTFORML 「피곤하신 거예요? ...어쩔 수 없겠죠.」
			PRINTFORMDW 그렇게 말하며, 노리토는 당신을 등에 업고 집으로 돌아간다.
		ELSE
			PRINTFORMW 「어라? 무슨 일이야, sworn friend?」
			PRINTFORMW 「그런 곳에서 누워 있다니... 시리코다마를 뽑고 싶으신 거야?」
			PRINTFORMW 「지쳤나 보네? 인간들은 정말 에너지가 없지... 뭐, 내가 방까지 데려다줄게.」
			PRINTFORMDW 그런 말과 함께 니토리는 당신에게 어깨를 빌려주며 걸음을 옮긴다.
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML 
ENDIF
RETURN 1
