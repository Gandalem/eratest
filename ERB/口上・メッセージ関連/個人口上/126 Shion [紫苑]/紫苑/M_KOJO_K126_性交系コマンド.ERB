	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;アナル処女
		IF !EXP:Ａ性交経験
			IF TALENT:恋人
				PRINTFORMW 「M-내 엉덩이...?」
				PRINTFORMW 「나 스스로 해본 적조차 없어...」
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		IF TALENT:恋人 || TALENT:恋慕
			IF RAND:5 == 0
				PRINTFORMW 「어, 크윽...」
				PRINTFORMW 「너는 너무 거칠어...%UNICODE(0x2764)%」
			ELSEIF RAND:4 == 0
				PRINTFORMW 「미안해, 좀 더 부드럽게 해줘...」
				PRINTFORMW 「크으응%UNICODE(0x2764)%, 더 거칠지 마%UNICODE(0x2764)%」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「사람의 %FSYN("ass")%에게 그렇게 폭력적이다...」
				PRINTFORMW 「%CALLNAME:MASTER%, 너는... 변태야...%UNICODE(0x2764)%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「오, 안 돼...%UNICODE(0x2764)% 내 엉덩이가 너무 좋아%UNICODE(0x2764)%」
				PRINTFORMW 「나 미쳐버릴 것 같아%UNICODE(0x2764)%」
			ELSE
				PRINTFORMW 「안(An)%UNICODE(0x2764)% 안(An)%UNICODE(0x2764)% 안(An)%UNICODE(0x2764)%」
				PRINTFORMW 「%CALLNAME:MASTER%%UNICODE(0x2764)%, %CALLNAME:MASTER%%UNICODE(0x2764)%」
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		RETURN 0
		;恋人
	ELSEIF TALENT:恋人
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
RETURN 1
