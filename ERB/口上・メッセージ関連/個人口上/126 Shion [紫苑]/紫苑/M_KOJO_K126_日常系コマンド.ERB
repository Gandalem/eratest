;303,謝る
;TFLAG:193(2=菓子折成功 1=大成功 0=成功 -1=失敗 -2=菓子折失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K126_303
CALL M_KOJO_MESSAGE_COM_K126_303_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K126_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == 2
		PRINTFORMDW 그녀는 케이크 상자를 받는 즉시 시온이 포장을 뜯기 시작한다.
		PRINTFORMDW 뚜껑을 열고, 그녀는 움직이지 않고 안의 내용물을 확인한다...
		PRINTFORMW 「...뭐, 여기까지 왔다면 화해하자.」
		PRINTFORMDW 그녀가 그렇게 말한 방식은 완전히 만족하지 못했다는 것을 나타내지만, 당분간 당신을 용서한 것 같다...
	ENDIF
