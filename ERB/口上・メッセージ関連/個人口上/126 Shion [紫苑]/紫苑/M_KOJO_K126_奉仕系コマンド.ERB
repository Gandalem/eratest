	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「내 입을 써줘...?」
			PRINTFORMW 「너 정말 이기적이구나...」
			PRINTFORMDW 시온은 수줍게 당신의 성기를 자신의 입 안에 넣었다.
			PRINTFORMW (우으, 이상한 맛이야.)
			PRINTFORMW (...하지만, 싫지는 않아.)
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음, 흐윽...」
			PRINTFORMW 「'엘...? 음... 기분 좋아...?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흐으음, 흠, 흠... 음, 흐윽...」
			PRINTFORMW (어떻게 해야 하지... 내 입이 멈추질 않아...)
		ELSE
			PRINTFORMW (이건 안 돼... 참을 수가 없어...)
			PRINTFORMW (%조사처리(CALLNAME:MASTER,"의")% %FSYN("penis")% 맛은 너무 좋아...
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
