;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K126_80
CALL M_KOJO_MESSAGE_COM_K126_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K126_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「나한테... 내 손을 쓰길 바라는 거야?」
			PRINTFORMW 「많이 기대하지 마.」
			PRINTFORMDW 시온은 어색하게 네 성기에 손을 갖다 댔다.
			PRINTFORMW 「응, 떨리고 있어...」
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「이렇게 해줄게...」
			PRINTFORMW 「기분 좋지, 그치? 후후, 알고 있어...%UNICODE(0x2764)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이렇게 비비고 있으면 미쳐버릴 것 같아.」
			PRINTFORMW 「압력을 좀 풀까? %UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「너무 힘들고 따뜻해...」
			PRINTFORMW 「정말 원하게 만들어...%UNICODE(0x2764)%」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
