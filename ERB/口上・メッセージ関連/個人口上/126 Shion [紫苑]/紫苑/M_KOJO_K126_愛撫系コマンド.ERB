@M_KOJO_MESSAGE_COM_K126_0
CALL M_KOJO_MESSAGE_COM_K126_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K126_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「후, 후후후, 간지러워요.」
			PRINTFORMW 「너 이거 잘 못하잖아, 그러니까 무리하지 마.」
			PRINTFORMDW 그녀의 말에 짜증이 나서 애무를 거칠게 했다.
			PRINTFORMW 「캬아?! 잠-잠깐...」
			PRINTFORMW 「...아아, 후아아...%UNICODE(0x2764)%」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;恋人
	ELSEIF TALENT:恋人 || TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음...」
			PRINTFORMW 「아, 아흠...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「아, 거기... 좋다.」
			PRINTFORMW 「더 만져줘...%UNICODE(0x2764)%」
		ELSE
			PRINTFORMW 「음... 이 정도면 됐을 것 같아.」
			PRINTFORMW 「뭘 묻는 거야...? 흥, 너 못됐구나...」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
