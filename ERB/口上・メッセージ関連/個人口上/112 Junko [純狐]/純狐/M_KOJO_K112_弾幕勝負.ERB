; Modular ERB: 個人口上/112 Junko [純狐]/純狐/M_KOJO_K112_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K112_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「…내 앞에 있지 말아 주겠니?」
		ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「알았어, %조사처리(CALLNAME:MASTER,"의")% 강함을 보여줘!」
		ELSE
			PRINTFORMW 「...자비는 베풀지 않을 거야」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				;怒り
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「잘하는구나」
					PRINTFORMDW 『살의 백합』!
				ELSE
					PRINTFORMW 「……」
					PRINTFORMDW 『살의 백합』
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「조금 위험할지도...?」
					PRINTFORMDW 『순수한 광기』!
				ELSE
					PRINTFORMW 「……」
					PRINTFORMDW 『순수한 광기』
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……っ！」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「그런...」
				ELSE
					PRINTFORMW 「……왜…」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「멍하니 있으면 안 돼?」
		ELSE
			PRINTFORMW 「……아직이야...」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「그 정도로는 아직 멀었네.」
		ELSE
			PRINTFORMW 「……」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「빨리 사라져 줄래?」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「아직 멀었네, 같이 특훈할래?」
				ELSE
					PRINTFORMW 「……」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「빨리 사라져 줄래?」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「생각했던 것보다 강했어.」
					PRINTFORMW 「하지만, 조금 더 특훈하자.」
				ELSE
					PRINTFORMW 「……」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「...빨리 어디 가버려라」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「위험했어... %조사처리(CALLNAME:MASTER,"는")% 강하네」
				ELSE
					PRINTFORMW 「……」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「……っ！」
				ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「거짓말이지... 당신은 정말 인간인 거야...?」
					PRINTFORMW 「다음에 달을 공격하러 갈 때 불러도 될까...?」
				ELSE
					PRINTFORMW 「……설마… 그럴 리가…」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
