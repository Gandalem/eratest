@M_KOJO_MESSAGE_COM_K112_81
CALL M_KOJO_MESSAGE_COM_K112_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF NOWEX:MASTER:射精
			IF TALENT:恋人
				PRINTFORMW 「입 안에서... 응... 내줘... 괜찮으니까... %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW (음... 이대로 나와 버릴까 %UNICODE(0x2665) *1%)
			ELSEIF TALENT:思慕
				PRINTFORMW (슬슬 나올까...?)
			ENDIF
		ELSE
			IF TALENT:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「츄... 주루... 주푸읏%UNICODE(0x2665) *1%」
						PRINTFORMW (이렇게 크게 해버려서... %UNICODE(0x2665) *1%)
					CASE 1
						PRINTFORMW 「쪽... 쪽...%UNICODE(0x2665) *1%」
						PRINTFORMW (이거... 좋아...%UNICODE(0x2665) *1%)
					CASE 2
						PRINTFORMW 「주루...응...쿠...」
						PRINTFORMW (기분 좋아 보여... %UNICODE(0x2665) *1% 기쁘다... %UNICODE(0x2665) *1%)
				ENDSELECT
			ELSEIF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「흐읍... 쪽... 쭈압...」
						PRINTFORMW (점점 커지고 있어... %UNICODE(0x2665) *1%)
					CASE 1
						PRINTFORMW 「음... 흠... 응...」
						PRINTFORMW (좀 더 격렬한 쪽을 %조사처리(CALLNAME:MASTER,"는")% 좋아할까...?)
					CASE 2
						PRINTFORMW 「음... 츄릅...」
						PRINTFORMW (이 맛... 좋아할지도... %UNICODE(0x2665) *1%)
				ENDSELECT
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「음... 핥아줘...」
						PRINTFORMW (왠지 이상한 기분이네...)
					CASE 1
						PRINTFORMW 「흐으... 츄...」
						PRINTFORMW (기분 좋아 보이는 얼굴이네...)
					CASE 2
						PRINTFORMW 「츄... 핥아...」
						PRINTFORMW (잘하고 있을까...)
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
