;82,パイズリ
;==================================================

@M_KOJO_MESSAGE_COM_K112_82
CALL M_KOJO_MESSAGE_COM_K112_82_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_82_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「여자의 가슴이 커지는 건 뛰어난 수컷에게 봉사하기 위해서야? 내가 만족시켜 줄게 %UNICODE(0x2665) *1%」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF NOWEX:MASTER:射精
			IF TALENT:恋人
				PRINTFORMW 「가슴 안에서 싸도 괜찮아 %UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「이대로 해 버릴까?」
			ELSEIF TALENT:思慕
				PRINTFORMW 「앗, 뜨거워지고 있어…」 
			ENDIF
		ELSE
			IF TALENT:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「자, 자 %UNICODE(0x2665) *1% 가슴으로 비비는 거 기분 좋지 %UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORMW 「입도 써 드릴까요?」
					CASE 2
						PRINTFORMW 「왠지 나도 기분이 좋아져 버려...%UNICODE(0x2665) *1%」
				ENDSELECT
			ELSEIF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「가슴이 커서 다행이야%UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORMW 「어라 %UNICODE(0x2665) *1% 거시기 숨어버렸네 %UNICODE(0x2665) *1%」
					CASE 2
						PRINTFORMW 「더 격렬한 게 좋아?」
						PRINTFORMW 「...꽤 피곤하단 말이야 이거」
				ENDSELECT
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「꽤 어렵네...」
					CASE 1
						PRINTFORMW 「이런 사용법도 있구나」
					CASE 2
						PRINTFORMW 「기분 좋아?」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
