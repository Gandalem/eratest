;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K112_80
CALL M_KOJO_MESSAGE_COM_K112_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF NOWEX:MASTER:射精
			IF TALENT:恋人
				PRINTFORMW 「아%UNICODE(0x2665) *1% 나올 것 같네%UNICODE(0x2665) *1%」
				PRINTFORMW 「많이 내줘%UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「슬슬 나올 것 같네 %UNICODE(0x2665) *1%」
			ELSEIF TALENT:思慕
				PRINTFORMW (덜덜 떨기 시작했어... 나올 것 같을까)
			ENDIF
		ELSE
			IF TALENT:恋人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「자, 자 %UNICODE(0x2665) *1% 꺼내도 괜찮아 %UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 기분 좋은 곳은 전부 알고 있잖아 %UNICODE(0x2665) *1%」
					CASE 2
						PRINTFORMW 「자 봐 %UNICODE(0x2665) *1% 이렇게 하면 기분 좋지 %UNICODE(0x2665) *1%」
				ENDSELECT
			ELSEIF TALENT:恋慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「끈적해져 버렸네%UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORMW 「기분 좋구나 %UNICODE(0x2665) *1% 얼굴이 풀려 있잖아 %UNICODE(0x2665) *1%」
					CASE 2
						PRINTFORMW 「굉장히 단단하고 뜨거워... %UNICODE(0x2665) *1%」
				ENDSELECT
			ELSEIF TALENT:思慕
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「이런 느낌으로 괜찮을까...」
						PRINTFORMW 「아프지 않아...?」
					CASE 1
						PRINTFORMW 「별로 이런 거 해본 적 없는데」
						PRINTFORMW 「잘 되길 바라지만...」
					CASE 2
						PRINTFORMW 「기분 좋아져 주는 게 기쁘네」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
