;==================================================
;150,胸の谷間を犯す
;==================================================

@M_KOJO_MESSAGE_COM_K112_150
CALL M_KOJO_MESSAGE_COM_K112_150_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_150_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「가슴을 쓰고 싶어...?」
			PRINTFORMW 「좋지만...」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		IF TALENT:恋人
			PRINTFORMW 「벌써... 가슴 좋아하는 걸 %UNICODE(0x2665) *1%」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「어때?... 기분 좋으려나%UNICODE(0x2665) *1%」
		ELSEIF TALENT:思慕
			PRINTFORMW 「이제... 좀 더 다정하게 해줬으면 좋겠어...」
		ENDIF
	ENDIF
ENDIF
RETURN 1
