;==================================================
;140,イラマチオ
;==================================================

@M_KOJO_MESSAGE_COM_K112_140
CALL M_KOJO_MESSAGE_COM_K112_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_140_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「에... 그건 무슨...」
			PRINTFORMW 「흐윽...!?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF TALENT:恋人
			PRINTFORMW 「으읏%UNICODE(0x2665) *1%… 꿀꺽%UNICODE(0x2665) *1%… 으읏%UNICODE(0x2665) *1%…」
			PRINTFORMW (어서%UNICODE(0x2665) *1%… 내줘%UNICODE(0x2665) *1%…)
		ELSEIF TALENT:恋慕
			PRINTFORMW 「응゛… 윽… 우゛…」
			PRINTFORMW (아앗%UNICODE(0x2665) *1%… 커졌어%UNICODE(0x2665) *1%… 나오는구나%UNICODE(0x2665) *1%)
		ELSEIF TALENT:思慕
			PRINTFORMW 「오...윽...크...」
			PRINTFORMW (설마... 이대로 내는 거야...?)
		ENDIF
	ELSE
		IF TALENT:恋人
			PRINTFORMW 「으゛오゛읏%UNICODE(0x2665) *1%… 읏%UNICODE(0x2665) *1%… 윽%UNICODE(0x2665) *1%…」
			PRINTFORMW (아앗%UNICODE(0x2665) *1%… 안 돼%UNICODE(0x2665) *1%… 기분 좋아%UNICODE(0x2665) *1%…)
		ELSEIF TALENT:恋慕
			PRINTFORMW 「う゛읏…ぶ읏…お゛읏…」
			PRINTFORMW （こんな%UNICODE(0x2665) *1%…道具みたいに…%UNICODE(0x2665) *1%）
		ELSEIF TALENT:思慕
			PRINTFORMW 「흐윽... 윽...」
			PRINTFORMW (괴롭다...)
		ENDIF
	ENDIF
ENDIF
RETURN 1
