@M_KOJO_MESSAGE_COM_K112_0
CALL M_KOJO_MESSAGE_COM_K112_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「으응%UNICODE(0x2665) *1%…좀 더 만져줘…%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORMW 「계속 접촉하고 있었잖아... %UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORMW 「%CALLNAME:MASTER%…좋아해…%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「%CALLNAME:MASTER%…%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"의")% 손... 따뜻하네... %UNICODE(0x2665) *1%」
				CASE 2
					PRINTFORMW 「아……그런 곳에……%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「응... 응...」
				CASE 1
					PRINTFORMW 「저기... 키스도 해 주지 않을래...?」
				CASE 2
					PRINTFORMW 「아...음... 그렇게...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
