;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K112_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K112_301
CALL M_KOJO_MESSAGE_COM_K112_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF (TALENT:恋人 || TALENT:恋慕 || TALENT:思慕) && CFLAG:318 == 1
		PRINTFORMW 「일단 받아 둘게.」
		;失敗
	ELSEIF (TALENT:恋人 || TALENT:恋慕 || TALENT:思慕) && TFLAG:193 == -1
		PRINTFORMW 「...같이 차를 끓이는 연습을 할까요」
		;成功
	ELSEIF (TALENT:恋人 || TALENT:恋慕 || TALENT:思慕) && TFLAG:193 == 1
		PRINTFORMW 「어머, 이거 정말 맛있네」
		PRINTFORMW 「뭐 특별한 비법 같은 게 있어요?」
	ELSEIF TALENT:恋人 || TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「아, 고마워.」
				PRINTFORMW 「이왕 이렇게 된 거, 당신도 같이 쉬지 않을래요?」
			CASE 1
				PRINTFORMW 「어머, 고마워」
				PRINTFORMW 「후훗, 맛있다」
			CASE 2
				PRINTFORMW 「어머, 고마워」
				PRINTFORMW 「앗 뜨거」
		ENDSELECT
	ELSEIF TALENT:思慕
		PRINTFORMW 「받을게, 고마워」
	ELSE
		PRINTFORMW 「……」
		PRINTFORMDW 받아주긴 했지만 입을 열 기미가 없다...
		PRINTFORMDW 하고 생각했을 때 눈을 뗀 사이에 차는 사라져 있었다.
	ENDIF
ENDIF
RETURN 1
