;-------------------------------------------------
IF LOCAL
	;怒り
	IF (TALENT:恋人 || TALENT:恋慕 || TALENT:思慕) && CFLAG:318 == 1
		PRINTFORMW 「그만해 주세요」
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「더 만져도 돼 %UNICODE(0x2665) *1%」
			CASE 1
				PRINTFORMW 「ん읏…そこは…%UNICODE(0x2665) *1%」
			CASE 2
				PRINTFORMW 「후훗, 무슨 일이야?」
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「기회가 된다면, 어깨라도 주물러 줄 수 없어?」
				PRINTFORMW 「요즘 뭉쳐서 말이야…」
			CASE 1
				PRINTFORMW 「사람들 앞에서 그러는 건 부끄럽잖아」
			CASE 2
				PRINTFORMW 「당신에게 만져지는 게 좋아.」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「뭔가?」
			CASE 1
				PRINTFORMW 「별로 만져주지 않아도 기쁠 거야」
			CASE 2
				PRINTFORMW 「뭐라도 붙어 있었니?」
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「……」
			CASE 1
				PRINTFORMW 「……뭔가 용건이야?」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
