LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		PRINTFORML 
	ELSEIF TFLAG:194 && (TALENT:恋人 || TALENT:恋慕 || TALENT:思慕)
		SELECTCASE TFLAG:194
			CASE 1
				;人目があるのはちょっと…
				PRINTFORMW 「사람이 있는 곳에서 그러는 건 안 될 것 같아...」
			CASE 2
				;野外はちょっと…
				PRINTFORMW 「어... 음...」
				PRINTFORMW 「적어도 실내에서 하지 않을래...?」
			CASE 3
				;多人数はちょっと…
				PRINTFORMW 「이런 건 단둘이 있을 때 하는 게 좋아...」
			CASE 4
				;ムードが無いのはちょっと…
				PRINTFORMW 「...좀 더 분위기 같은 걸 생각하지 않으면 미움받을 거야」
		ENDSELECT
	ELSEIF TCVAR:抱き寄せ初回 && (TALENT:恋人 || TALENT:恋慕 || TALENT:思慕)
		SELECTCASE TCVAR:抱き寄せ初回
			CASE 1
				;通常
				PRINTFORMW 「앗……」
				PRINTFORMW 「이제 계속 이런 건 안 했으니까…」
				PRINTFORMW 「상냥하게 부탁해…%UNICODE(0x2665) *1%」
			CASE 2
				;キスしてない
				PRINTFORMW 「아직 키스도 안 했는데 이건 빠르지 않을까…」
				PRINTFORMW 「좋지만……%UNICODE(0x2665) *1%」
			CASE 3
				;発情しちゃって抵抗できない
				PRINTFORMW 「안 돼...어...」
				PRINTFORMW (아아... 저항할 수 없어... 몸이 저릿해...)
			CASE 4
				;刻印があって抵抗できない
				PRINTFORMW 「이유 같은 건 상관없겠지...」
				PRINTFORMW 「안아줘...%UNICODE(0x2665) *1%」
			CASE 5
			CASE 6
				;まんざらでもない
				PRINTFORMW 「앗... 저기, 잠깐만...」
				PRINTFORMW 「아직은 일러요... 제 마음의 준비가...」
			CASE 7
				;駄目
				PRINTFORMW 「안 돼, 그런 건 더 사이좋게 지내고 나서 하자」
			CASE 8
				;論外
				PRINTFORMW 「그만둬 주세요」
				PRINTFORMW 「당신과는 아직 그런 관계일 생각은 없어요」
		ENDSELECT
	ELSE
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"로")% 할 거야, 정말 좋아해%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORMW 「아…%UNICODE(0x2665) *1%나도…%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「하고 싶어? 괜찮아%UNICODE(0x2665) *1%」
				CASE 1
					PRINTFORMW 「いいわよ%UNICODE(0x2665) *1%気持ちよくしてね%UNICODE(0x2665) *1%」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「이런 아줌마 몸으로도 괜찮은 거야...?」
				CASE 1
					PRINTFORMW 「하고 싶어...? 어쩔 수 없네... %UNICODE(0x2665) *1%」
			ENDSELECT
		ELSE
			PRINTFORMW 「... 마음대로 하세요」
		ENDIF
	ENDIF
ENDIF
RETURN 1
