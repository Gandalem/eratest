			ELSEIF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
				IF RAND:3 == 0
					PRINTFORMW 「아, 안녕하셨어요」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「안녕하세요, 무슨 용무인가요?」
				ELSE
					PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
					PRINTFORMW 「오늘은 뭘 할 거야?」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「……」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……무슨 일이야」
				ELSE
					PRINTFORMW 「일부러 만나러 온 거야?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとデート中に遭遇した
		;ARG:1にデート相手
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			;怒ってるとき
			IF CFLAG:318 == 1
				PRINTFORMW 「………」
				;恋人時怒ってて相手がサグメ豊姫依姫のどれか
			ELSEIF CFLAG:318 == 1 && TALENT:恋人 && (ARG:1 == 110 || ARG:1 == 99 || ARG:1 == 98)
				PRINTFORMW 「더 이상 나에게서 빼앗지 마……!」
				;恋人時怒ってて相手がクラウンピース
			ELSEIF CFLAG:318 == 1 && TALENT:恋人 && ARG:1 == 111
				PRINTFORMW 「...그런 취미였구나」
				;恋人時怒ってて相手がヘカーティア
			ELSEIF CFLAG:318 == 1 && TALENT:恋人 && ARG:1 == 113
				PRINTFORMW 「...헤카티아에게도 손을 댔구나」
				;思慕以上で相手がサグメ豊姫依姫のどれか
			ELSEIF (TALENT:思慕 || TALENT:恋慕 || TALENT:恋人) && (ARG:1 == 110 || ARG:1 == 99 || ARG:1 == 98)
				PRINTFORMW 「%CALLNAME:MASTER%, 너무 그 사람과 사귀지 않는 편이 좋아」
				;思慕以上で相手がクラウンピース
			ELSEIF (TALENT:思慕 || TALENT:恋慕 || TALENT:恋人) && ARG:1 == 111
				PRINTFORMW 「어라 %CALLNAME:MASTER%,」
				PRINTFORMW 「미치지 않도록 조심해 줘?」
				;思慕以上で相手がヘカーティア
			ELSEIF (TALENT:思慕 || TALENT:恋慕 || TALENT:恋人) && ARG:1 == 113
				PRINTFORMW 「어라 %CALLNAME:MASTER%」
				PRINTFORMW 「후훗, 헤카티아는 착한 아이잖아?」
			ELSEIF TALENT:恋人
				PRINTFORMW 「나도 잊지 말아줘.」
			ELSEIF (TALENT:思慕 || TALENT:恋慕)
				IF RAND:2 == 0
					PRINTFORMW 「아, 안녕하셨어요」
				ELSE
					PRINTFORMW 「사이좋은 건 좋은 일이지.」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「……」
				ELSE
					PRINTFORMW 「……무슨 일이야」
				ENDIF
			ENDIF
			;正直ここの分岐うまくできてるか自信ない
			RETURN 1
		ENDIF
		;その他
		PRINTFORML  
	ENDIF
ENDIF
RETURN 1
