@M_KOJO_EVENT_K112_2(ARG,ARG:1)
CALL MESSAGE_GOODMONING(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		IF TALENT:恋人 || TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORMW 「안녕, %CALLNAME:MASTER%」
				PRINTFORMW 「잠자는 모습이 귀여워서 자꾸 보고 말았어」
			ELSE
				PRINTFORMW 「안녕, %CALLNAME:MASTER%」
				PRINTFORMW 「오늘도 좋은 하루가 되면 좋겠네」
			ENDIF
		ELSEIF TALENT:思慕
			PRINTFORMW 「안녕, %CALLNAME:MASTER%」
		ELSE
			PRINTFORMW 「... 신경 쓰지 마」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人 || TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORMW 「안녕, %CALLNAME:MASTER%」
				PRINTFORMW 「잠자는 모습이 귀여워서 자꾸 보고 말았어」
			ELSE
				PRINTFORMW 「안녕, %CALLNAME:MASTER%」
				PRINTFORMW 「오늘도 좋은 하루가 되면 좋겠네」
			ENDIF
		ELSE
			PRINTFORMW 「안녕, %CALLNAME:MASTER%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORMW 「……응…%CALLNAME:MASTER%…」
			PRINTFORMDW 순호는 행복해 보이는 듯 자고 있다.
		ELSE
			PRINTFORMW 「………」
			PRINTFORMDW 순호는 곤히 자고 있다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			IF RAND:2 == 0
				PRINTFORMW 「안녕 %CALLNAME:MASTER%, 일찍 일어났네」
			ELSE
				PRINTFORMW 「안녕%CALLNAME:MASTER%,」
				PRINTFORMW 「…늦잠 자버렸을까」
			ENDIF
		ELSE
			PRINTFORMW 「……」
		ENDIF
		RETURN 1
	ENDIF
	;その他
	;PRINTFORMW 「あら、おはよう、%CALLNAME:MASTER%」
ENDIF
RETURN 1
