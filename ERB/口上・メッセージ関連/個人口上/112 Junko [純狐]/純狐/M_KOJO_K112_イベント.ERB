@M_KOJO_EVENT_K112_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「어머, 벌써 이 시간이네」
			PRINTFORMW 「그럼, 실례할게」
			PRINTFORMW 「내일도 만날 수 있으면 기쁠 거야」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「아, 벌써 이런 시간인가」
			PRINTFORMW 「それじゃあ、失礼するわね」
		ELSE
			PRINTFORMDW 눈을 돌린 사이에 순호는 사라져 있었다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「후아... 졸려지네...」
		ELSE
			PRINTFORMDW 순호의 표정이 살짝 졸려 보인다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			IF RAND:10 == 0
				PRINTFORMW 「괜찮아... 하쿠...」
				PRINTFORMDW 순호는 말다툼을 하고 있는 것 같다.
				;これだけ確率を低くしたかったがこれで合ってるか？
			ELSEIF RAND:3 == 0
				PRINTFORMW 「……당신……」
				PRINTFORMDW 순호는 말다툼을 하고 있는 듯하다.
			ELSEIF RAND:2 == 0
				PRINTFORMW 「%CALLNAME:MASTER%... 좋아해...」
				PRINTFORMDW 순호는 말다툼을 하고 있는 것 같다.
			ELSE
				PRINTFORMW 「...항상...」
				PRINTFORMDW 순호는 잠꼬대를 하고 있는 것 같다.
			ENDIF
		ELSE
			PRINTFORMW 「...항상...」
			PRINTFORMDW 순호는 잠꼬대를 하고 있는 것 같다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕付き拠点内キャラがMAIN_MAPで衰弱状態になった場合か、お招き部屋で相手が衰弱した場合に発生
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「저, 피곤해졌어...」
		ELSE
			PRINTFORMDW 순호의 표정이 조금 괴로워 보인다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「어라, 너무 열중해버렸어?」
		ELSE
			PRINTFORMDW 의식이 사라지는 순간, 순호가 나를 보고 있는 것이 보였다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			PRINTFORMW 「잘 자요, %CALLNAME:MASTER%」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「미안해, 이제 좀 자고 싶어」
			ELSE
				PRINTFORMW 「이제 좀 자고 싶으니 나가 줄 수 있겠니」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			IF TALENT:恋人 || TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「저기, 슬슬 자고 싶은데…」
			ELSE
				PRINTFORMW 「이제 좀 자고 싶으니 나가 줄 수 있겠니」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;非在住TARGETがMAIN_MAPで休憩
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;前のターンから一緒の部屋にいる状態で相手が寝る（お招き部屋含む（
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		PRINTFORMW 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML
ENDIF
RETURN 1
