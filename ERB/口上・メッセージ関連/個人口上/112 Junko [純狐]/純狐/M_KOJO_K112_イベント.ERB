@M_KOJO_EVENT_K112_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;うふふ==2（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;MASTERを押し倒した（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			IF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%…%UNICODE(0x2665) *1%」
				PRINTFORMW 「나 이제 참을 수 없어...」
				PRINTFORMW 「함께 사랑하자?」
				;夫を忘れさせて的な内容を入れたいけどいい感じの条件分岐が思いつかない
			ELSEIF TALENT:恋慕
				PRINTFORMW 「%CALLNAME:MASTER%…」
				PRINTFORMW 「참을 수가 없어...」
				PRINTFORMW 「상대... 해줄까...? %UNICODE(0x2665) *1%」
			ELSEIF TALENT:思慕
				PRINTFORMW 「%CALLNAME:MASTER%…」
				PRINTFORMW 「죄송해요... 하지만 저는...」
			ELSE
				PRINTFORMW 「……」
				PRINTFORMDW 순호는 무표정하지만, 눈은 번뜩이고 볼은 붉게 물들어 있다.
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTERに抱きついた（開始時）
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋人
				PRINTFORML 「%CALLNAME:MASTER%…%UNICODE(0x2665) *1%」
				PRINTFORML 「그, 저... 하고 싶어졌어요...」 %UNICODE(0x2665) *1%
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「%CALLNAME:MASTER%…」
				PRINTFORML 「있잖아... 나랑... 그게... 어때...? %UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「……」
				PRINTFORMDW 순호는 무표정하지만, 뺨은 붉게 물들어 있다.
			ENDIF
			RETURN 1
		ENDIF
		;押し倒すと抱きつくの違いがよく分かってないのでもしかしたら想定してた状況と違うかも
		;押し倒すは逆レ、抱きつくはイチャラブのイメージで書いた
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;-------------------------------------------------
		;抜け出した
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード満足終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;抱き着きモード強制終了
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;-------------------------------------------------
		;好きにして状態から抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋人
				PRINTFORMW 「안 돼, 당신이 하고 싶은 대로 하라고 말했잖아%UNICODE(0x2665) *1%」
				PRINTFORMW 「내가 만족할 때까지 끝내지 않을 거야%UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「싫어, 아직 용서해 주지 않아%UNICODE(0x2665) *1%」
			ELSE
				PRINTFORMW 「……아직 안 돼」
				PRINTFORMDW 순호는 %조사처리(CALLNAME:MASTER,"를")% 놓아줄 것 같지 않다.
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;欲求不満が高くて抜け出せなかった
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			IF TALENT:恋人
				PRINTFORMW 「%CALLNAME:MASTER%…%UNICODE(0x2665) *1%」
				PRINTFORMW 「이런 걸로는 만족할 수 없게 되어버렸어...%UNICODE(0x2665) *1%」
				PRINTFORMW 「더 하고 싶어...%UNICODE(0x2665) *1%」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「있잖아... 아직 나 만족 못 하고 있잖아...」
				PRINTFORMW 「더 해줬으면 좋겠어... %UNICODE(0x2665) *1%」
			ELSEIF TALENT:思慕
				PRINTFORMW 「기다려, %CALLNAME:MASTER%…」
				PRINTFORMW 「아직 하고 싶어…」
			ELSE
				PRINTFORMW 「……아직 안 돼」
				PRINTFORMDW 순호는 %조사처리(CALLNAME:MASTER,"를")% 놓아줄 것 같지 않다.
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;誘ってきた（人目につかない場所に行きたがるやつ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;ARG:1=TARGETの欲求不満度（最高1000）
		;必要ならばこれで分岐を作ってください
		SELECTCASE ARG:1
			CASE 1000
				IF TALENT:恋人
					PRINTFORMW 「ほら…%CALLNAME:MASTER%…触ってみて…%UNICODE(0x2665) *1%」
					PRINTFORMW 「私もうおかしくなっちゃいそう…%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「%CALLNAME:MASTER%%UNICODE(0x2665) *1%…%CALLNAME:MASTER%%UNICODE(0x2665) *1%…」
					PRINTFORMW 「있잖아, 부탁이야... 나 당신한테 안겨줬으면 좋겠어...」 %UNICODE(0x2665) *1%
				ELSEIF TALENT:思慕
					PRINTFORMW 「나 벌써 이렇게 되어버렸네...」
					PRINTFORMW 「어딘가 둘만 있을 수 있는 곳으로 가자...%UNICODE(0x2665) *1%」
				ELSE
					PRINTFORMW 「……%UNICODE(0x2665) *1%」
					PRINTFORMDW 순호의 눈빛은 초점이 맞지 않고, 볼은 붉게 물들어 있다.
				ENDIF
			CASE 800 TO 999
				IF TALENT:恋人
					PRINTFORMW 「있잖아 %CALLNAME:MASTER%… 나 흥분해버렸어 %UNICODE(0x2665) *1%」
					PRINTFORMW 「"이거" 갖고 싶어 %UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「...아, 죄송해요. 좀 신경 쓰여서...」
					PRINTFORMW 「...대신 저 것도 만져도 돼요... %UNICODE(0x2665) *1%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「…%UNICODE(0x2665) *1%」
					PRINTFORMW 「아, 그게...」
					PRINTFORMW 「미안해... 좀 이상했지...」
				ELSE
					PRINTFORMW 「……」
					PRINTFORMDW 순호는 볼을 붉히며 %CALLNAME:MASTER%에 닿아 있다.
				ENDIF
			CASEELSE
				IF TALENT:恋人
					PRINTFORMW 「%CALLNAME:MASTER%…」
					PRINTFORMW 「나, 둘만 있을 수 있는 곳에 가고 싶어졌어…%UNICODE(0x2665) *1%」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「있잖아 %CALLNAME:MASTER%…」
					PRINTFORMW 「어딘가 둘만 있을 수 있는 곳에 가지 않을래…?」
				ELSEIF TALENT:思慕
					PRINTFORMW 「있잖아 %CALLNAME:MASTER%……」
					PRINTFORMW 「장소 좀 바꾸지 않을래...?」
				ELSE
					PRINTFORMW 「……」
					PRINTFORMDW 순호가 %조사처리(CALLNAME:MASTER,"의")% 소매를 잡아당기고 있다.
					PRINTFORMDW 어딘가에 가고 싶은 모양이다.
				ENDIF
		ENDSELECT
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
