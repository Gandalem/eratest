					CASE 1
						PRINTFORMW 「기다려앗%UNICODE(0x2665) *1%, 너무 세%UNICODE(0x2665) *1%, 게앗%UNICODE(0x2665) *1%」
					CASE 2
						PRINTFORMW 「아앗%UNICODE(0x2665) *1%, 그러면 안 돼앳%UNICODE(0x2665) *1%, 갑자기앳%UNICODE(0x2665) *1%」
				ENDSELECT
			CASE 2 ;ねっとり
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「아... 이거... 좋아%UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORMW 「그렇게... 재촉하지 마... %UNICODE(0x2665) *1%」
					CASE 2
						PRINTFORMW 「아... 깊숙이... %UNICODE(0x2665) *1%」
				ENDSELECT
			CASE 3 ;グラインド
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「안… 안쪽%UNICODE(0x2665) *1%… 기분 좋아%UNICODE(0x2665) *1%」
					CASE 1
						PRINTFORMW 「아%UNICODE(0x2665) *1%…… 이거%UNICODE(0x2665) *1%…… 굉장해……%UNICODE(0x2665) *1%」
					CASE 2
						PRINTFORMW 「대단해... 뒤섞이고 있어...%UNICODE(0x2665) *1%」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
