@M_KOJO_SUCCESS_COM_K112_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K112_310
CALL M_KOJO_MESSAGE_COM_K112_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K112_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF CFLAG:318 == 1
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「참을 수 없게 되어버렸어... %UNICODE(0x2665) *1%」
			CASE 1
				PRINTFORMW 「...더... %UNICODE(0x2665) *1%」
			CASE 2
				PRINTFORMW 「음? 뭔데 %UNICODE(0x2665) *1%」
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「그런 건... 적어도 실내에서...」
			CASE 1
				PRINTFORMW 「꺅!」
				PRINTFORMW 「갑자기 만지지 마... 깜짝 놀라버리잖아」
			CASE 2
				PRINTFORMW 「응...」
				PRINTFORMW 「신경 쓰이나...?」
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「만져주지 않아도 기쁠 텐데…」
			CASE 1
				PRINTFORMW 「그렇게 하는 게 더 좋을 거야...?」
			CASE 2
				PRINTFORMW 「자, 그만둬...」
		ENDSELECT
	ELSE
		PRINTFORMW 「……」
		PRINTFORMDW 순호는 말없이 당신의 손을 뿌리쳤다.
	ENDIF
ENDIF
RETURN 1
