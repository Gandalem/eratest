	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
	ELSE
		SELECTCASE TFLAG:193
			CASE -5, -3, -1
				PRINTFORMW 「그만해 주세요」
			CASE 0
				PRINTFORMW 「잠깐만... 그런 건 하면 안 돼...?」
			CASE 1
				IF TALENT:恋人
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「안이 궁금한가 보네 %UNICODE(0x2665) *1%」
						CASE 1
							PRINTFORMW 「%CALLNAME:MASTER%라면 좋겠어 %UNICODE(0x2665) *1%」
							PRINTFORMW 「자, 원하는 만큼 봐 %UNICODE(0x2665) *1%」
						CASE 2
							PRINTFORMW 「보고만 있어도 참을 수 있을까%UNICODE(0x2665) *1%」
					ENDSELECT
				ELSEIF TALENT:恋慕
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「제발... 마지막으로 한 마디 해줬으면 좋겠어.」
						CASE 1
							PRINTFORMW 「사람 없는 곳으로 해줘」
							PRINTFORMW 「아무리 그래도 사람들 앞은...」
						CASE 2
							PRINTFORMW 「그렇게 신경 쓰여...?」
					ENDSELECT
				ELSEIF TALENT:思慕
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「조금만...」
							PRINTFORMW 「그렇게 자꾸 쳐다보지 마...」
						CASE 1
							PRINTFORMW 「이제... 그런 건...」
						CASE 2
							PRINTFORMW 「부끄러워...」
					ENDSELECT
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
