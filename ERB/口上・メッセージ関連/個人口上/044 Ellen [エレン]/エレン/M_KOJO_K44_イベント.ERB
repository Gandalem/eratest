@M_KOJO_EVENT_K44_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					CASE 0
						LOCALS = 하쿠레이 신사
					CASE 1
						LOCALS = 명련사
					CASE 2
						LOCALS = 마을
					CASE 3
						LOCALS = 안개의 호수
					CASE 4
						LOCALS = 망설임의 대나무 숲
						;選ばれる事は無いんだけど一応
					CASE 5
						LOCALS = 마법의 숲
						;デートで三途の川に誘われたら唖然とするよね、という事で
					CASE 6
						LOCALS = 마요히가
					CASE 7
						LOCALS = 요괴의 산기슭
					CASE 8
						LOCALS = 요괴의 산
					CASE 9
						LOCALS = 지하
					CASE 10
						LOCALS = 달
					CASEELSE
						LOCALS = "이거 나오면 스레드에 보고해줘"
				ENDSELECT
				IF TALENT:恋人 && TALENT:恋慕
					PRINTFORMW 「오늘은 둘이서 %LOCALS%에 외출하자」
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
					PRINTFORMW 「있잖아, 둘이 데이트하는 건 어때?」
					;恋慕縛りが解除されたときのために
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%、もし暇だったら一緒に%LOCALS%でも行かない？」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人 && TALENT:恋慕
					PRINTFORMW 「해냈어%UNICODE(0x2665)% 그럼 가자%UNICODE(0x2665)%%UNICODE(0x2665)%」
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
					PRINTFORMW 「해냈다%UNICODE(0x2665)%//」
				ELSE
					PRINTFORMW 「그럼 바로 가자 %UNICODE(0x2665)%」
				ENDIF
				;デートに誘われたフラグを立てる
				TCVAR:356 = 1
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「그럼 다른 날 데이트하자ね%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「아야야, 뭐 %조사처리(CALLNAME:MASTER,"가")% 의욕이 없으면 괜찮아」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人 && TALENT:恋慕
					PRINTFORMW 「우리 집에서 느긋하게 보내자%UNICODE(0x2665)%」
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1 || TALENT:恋人
					PRINTFORMW 「좋으면 우리 집에 들러주지 않을래?//」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人 && TALENT:恋慕
					PRINTFORMW 「해냈어%UNICODE(0x2665)% 그럼 가자%UNICODE(0x2665)%%UNICODE(0x2665)%」
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
					PRINTFORMW 「해냈다%UNICODE(0x2665)%//」
				ELSE
					PRINTFORMW 「그럼 바로 가자 %UNICODE(0x2665)%」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「그렇구나, 그럼 다음에 또 부를게 %UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「아야야, 뭐 %조사처리(CALLNAME:MASTER,"가")% 의욕이 없으면 괜찮아」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
