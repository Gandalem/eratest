@M_KOJO_UPDATE_K44
;口上独自のUPDATE用
;ENCOUNTER専用に独自分岐フラグを仕込んだ場合等にどうぞ
IF CFLAG:44:1951 < 2
	CFLAG:44:1951 = 2
	IF CFLAG:44:1007 == 1
		PRINTFORML 수습 기간 이후의 이벤트 진행을 수정하여 정확하게 만든다...
		SIF CFLAG:44:1008 > 30
			CFLAG:44:1012 = 1
		SIF CFLAG:44:1008 > 40
			CFLAG:44:1012 = 2
		SIF CFLAG:44:1008 > 60 && CFLAG:44:1009 > 20 && CFLAG:44:1010 > 10
			CFLAG:44:1012 = 3
		SIF CFLAG:44:1008 > 100 && CFLAG:44:1009 > 50 && CFLAG:44:1010 > 40
			CFLAG:44:1012 = 4
		SIF CFLAG:44:1008 > 150 && CFLAG:44:1009 > 80 && CFLAG:44:1010 > 60
			CFLAG:44:1012 = 5
		SIF CFLAG:44:1008 > 200 && CFLAG:44:1009 > 120 && CFLAG:44:1010 > 100
			CFLAG:44:1012 = 6
		SIF CFLAG:44:1008 > 300 && CFLAG:44:1009 > 200 && CFLAG:44:1010 > 250
			CFLAG:44:1012 = 7
	ENDIF
ENDIF
;出産経験、子供の誕生日で判定します
IF EXP:44:出産経験
	FOR LOCAL, 1, MAXCHILD + 1
	;UPDATE時にCHILD_SEXをリセットしています
	IF CHILD_BIRTHDAY:44:LOCAL && !CHILD_SEX:44:LOCAL
		;ここで設定しなおします
		PRINTFORML %CHILDNAME:44:LOCAL%의 성별은 무엇인가?
		CALL ASK_M("랜덤", 1, "여자아이", 1, "소년", 1)
		IF RESULT
			CHILD_SEX:44:LOCAL = RESULT
		ELSE
			CHILD_SEX:44:LOCAL = RAND:2 + 1
		ENDIF
		PRINTFORM %CHILDNAME:44:LOCAL, 15, LEFT%은(는) 태어난 \@ CHILD_SEX:44:LOCAL == 1 ? 여자 # 남자 \@로 설정되었다. 
		CALL PRINT_DATE(CHILD_BIRTHDAY:44:LOCAL)
		PRINTFORML .
	ENDIF
	NEXT
	WAIT
ENDIF
RETURN 1

