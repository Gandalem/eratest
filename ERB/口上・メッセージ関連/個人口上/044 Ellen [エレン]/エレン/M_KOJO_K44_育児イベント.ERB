;-------------------------------------------------
;育児イベント登下校時の地の文。
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_登下校(ARGS,ARG,ARG:1)
IF !ARG
	;登校時
	IF CFLAG:44:出産経過日 < CHILD_自立前
		PRINTFORMDL 『잘 다녀오겠습니다』
	ELSE
		PRINTFORMDL 『그럼 다녀올게』
	ENDIF
	PRINTFORML 「잘 다녀와」
ELSE
	;下校時
	IF CFLAG:44:出産経過日 < CHILD_自立前
		PRINTFORMDL 『다녀왔어요ー♪』
	ELSE
		PRINTFORMDL 『ただいま帰りました』
	ENDIF
	PRINTFORML 「어서 와 %UNICODE(0x2665)%」
ENDIF
;-------------------------------------------------
;育児イベント食事時。
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_食事(ARGS,ARG,ARG:1)
IF ARGS == "授乳"
	SELECTCASE RAND:4
		CASE 1
			PRINTFORMW 「많이 먹고 훌쩍 커줘 %UNICODE(0x2665)%」
		CASE 2
			PRINTFORMW 「당장 도망치지 않으니까 안심해 %UNICODE(0x2665)%」
		CASE 3
			PRINTFORMW 「다 먹으면 쪽해 줄게%UNICODE(0x2665)%」
		CASEELSE
			PRINTFORMW 「잘 먹었네%UNICODE(0x2665)% 대단해 대단해%UNICODE(0x2665)%」
	ENDSELECT
ELSEIF ARGS == "離乳食"
	SELECTCASE RAND:4
		CASE 1
			PRINTFORMW 「자, 아~」
		CASE 2
			PRINTFORMW 「잘 먹었네%UNICODE(0x2665)% 착하다 착해%UNICODE(0x2665)%」
		CASE 3
			SIF CFLAG:44:出産経過日 >= CHILD_喋る
				PRINTFORMDL 『엄마, 엄마』
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%는 맛있게 유아식을 먹고 있다...
		CASEELSE
			SIF CFLAG:44:出産経過日 >= CHILD_喋る
				PRINTFORMDL 『꺄캬악♪』
			PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%는 조금 장난치고 있다…….
			PRINTFORMW 「이봐, 음식으로 놀면 안 돼」
	ENDSELECT
ELSEIF ARGS == "幼少期"
	SELECTCASE RAND:3
		CASE 1
			PRINTFORMDL 『잘 먹겠습니다~♪』
		CASE 2
			PRINTFORMDL 『우와, 맛있겠다~♪』
		CASEELSE
			IF GROUPMATCH(SELECTCOM, 414, 415)
				PRINTFORMD 「아빠는 \@ TCVAR:44:360 == 1 ? 그리고 엄마 #  \@」
			ELSEIF SELECTCOM == 615
				PRINTFORMD 엄마
			ELSE
				PRINTFORMD 「코」
			ENDIF
			PRINTFORMDL 그 요리, 정말 맛있어%UNICODE(0x2665)%
	ENDSELECT
	LOCALS:0 = 
	IF GROUPMATCH(SELECTCOM, 414, 415)
		LOCALS:0 = %CALLNAME:MASTER% \@ TCVAR:44:360 == 1 ? 그리고 엘렌 # 의 \@
	ELSEIF SELECTCOM == 615
		LOCALS:0 '= @"엘렌의"
	ELSE
		LOCALS:0 '= @"내어졌다"
	ENDIF
	PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%은 %LOCALS:0% 요리를 맛있게 우물거리며 먹고 있다.
ELSE
	SELECTCASE RAND:3
		CASE 1
			PRINTFORMDL 『'받겠습니다'』
		CASE 2
			PRINTFORMDL 『여전히 맛있어 보인다 \@ CHILD_SEX:44:(TALENT:44:育児中) == 1 ? 네 # 어라 \@』
		CASEELSE
			IF GROUPMATCH(SELECTCOM, 414, 415)
				PRINTFORMD 『お父さん\@ TCVAR:44:360 == 1 ? とお母さん #  \@
			ELSEIF SELECTCOM == 615
				PRINTFORMD 『엄마
			ELSE
				PRINTFORMD 여기
			ENDIF
			PRINTFORMDL 의 요리는 정말 맛있다. \@ CHILD_SEX:44:(TALENT:44:育児中) == 1 ? 이다♪ # 또는 \@
	ENDSELECT
	LOCALS:1 = 
	IF GROUPMATCH(SELECTCOM, 414, 415)
		LOCALS:1 = %CALLNAME:MASTER% \@ TCVAR:44:360 == 1 ? 그리고 엘렌 # 의 \@
	ELSEIF SELECTCOM == 615
		LOCALS:1 '= @"엘렌의"
	ELSE
		LOCALS:1 '= @"내어졌다"
	ENDIF
	PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%은 %LOCALS:1% 요리를 미소 지으며 먹고 있다.
ENDIF
;子供の描写がオンならここで食事のTCVARを消す
IF GROUPMATCH(SELECTCOM, 414, 415)
	TCVAR:44:360 = 0
	TCVAR:44:361 = 0
ENDIF
