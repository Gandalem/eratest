;育児イベント入浴
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_BATH(ARGS,ARG,ARG:1)
IF ARGS == "幼児期"
	SIF CFLAG:44:出産経過日 >= CHILD_喋る
		PRINTFORMDL 『'철퍽철퍽'』
	PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%는 기분 좋게 욕조에 몸을 담그고 있다…….
ELSEIF ARGS == "幼少期"
	SELECTCASE RAND:2
		CASE 1
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%는 기분 좋게 욕조에 몸을 담그고 있다…….
		CASEELSE
			IF !RAND:2
				PRINTFORMDL 엘렌은 %CHILDNAME:44:(TALENT:44:育児中)%의 몸을 씻기고 있다.
				PRINTFORML 「깨끗하게 해 드리자 %UNICODE(0x2665)%」
				PRINTFORMDL 『네~♪』
			ELSE
				PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%그 몸을 씻겨주었다
				PRINTFORMDL 『꺅♪』
			ENDIF
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%는 기뻐 보인다…….
	ENDSELECT
ELSE
ENDIF
;-------------------------------------------------
;育児イベント就寝
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_SLEEPING(ARGS,ARG,ARG:1)
IF ARGS == "幼児期"
	;PRINTFORML
	;子供の寝てる隙に
	SIF !TCVAR:44:387 && !RAND:2
		CFLAG:44:溜まってる度 += ABL:欲望 * 10
ELSEIF ARGS == "幼少期"
	PRINTFORMDL 『잘 자아……』
	SIF !TCVAR:44:387 && !RAND:2
		CFLAG:44:溜まってる度 += ABL:欲望 * 10
ELSE
	PRINTFORMDL 『아버지, 어머니, 안녕히 주무세요』
	SIF !TCVAR:44:387 && !RAND:2
		CFLAG:44:溜まってる度 += ABL:欲望 * 10
ENDIF
;-------------------------------------------------
;育児イベント川の字でおやすみ
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_OYASUMI(ARGS,ARG,ARG:1)
PRINTFORMW 「에헤헤%UNICODE(0x2665)% 안녕히 주무세요, %CALLNAME:MASTER%%UNICODE(0x2665)% %CHILDNAME:44:(TALENT:44:育児中)%%UNICODE(0x2665)%」
;幼少期
IF CFLAG:44:出産経過日 < CHILD_自立前 && CFLAG:44:出産経過日 >= CHILD_語彙
	PRINTFORMDW 『에헤-♪ 잘 자요 아빠, 엄마』
	;自立手前
ELSEIF CFLAG:44:出産経過日 >= CHILD_自立前
	PRINTFORMDW 『\@ CHILD_SEX:44:(TALENT:44:育児中) == 1 ? 네♪ # 에에, \@안녕히 주무세요, 엄마, 아빠』
	;最終日のとき限定で追加
	IF CFLAG:44:出産経過日 == CHILD_自立
		PRINTFORMDW 『……아버지, 어머니, 지금까지 감사했습니다』
		PRINTFORMW 「천만에%UNICODE(0x2665)% ……%CHILDNAME:44:(TALENT:44:育児中)%, 행복하게 살아야 해」
		PRINTFORMDW 『네!』
	ENDIF
ENDIF
;-------------------------------------------------
;育児イベント玩具
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_TOY(ARGS,ARG,ARG:1)
IF ARGS == "幼児期"
	SIF CFLAG:44:出産経過日 >= CHILD_喋る
		PRINTFORMDL 『오~♪』
	SELECTCASE RAND:4
		CASE 1, 2
			LOCALS:0 = 
			SELECTCASE RAND:3
				CASE 1
					LOCALS:0 '= @"데구르르 굴리다"
				CASE 2
					LOCALS:0 '= @"데구루데 만진다"
				CASEELSE
					LOCALS:0 '= @"톡톡 두드리다"
			ENDSELECT
			PRINTFORMDW 장난감을 %LOCALS:0% 하는 것이 즐거운 모양이다……
		CASE 3
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%는 만족스러운 듯하다...
		CASEELSE
			PRINTFORMDW ...장난감을 가만히 응시하다가 갑자기 물어뜯었다.
	ENDSELECT
ELSEIF ARGS == "幼少期"
	;PRINTFORML
ELSE
	;PRINTFORML
ENDIF
;-------------------------------------------------
;育児イベントその他。その他が一番分厚いのは基本
;-------------------------------------------------

@M_KOJO_EVENT_K44_CHILD_RAISING_OTHER(ARGS,ARG,ARG:1)
;各種行事イベント　ある程度成長していることが前提
IF CFLAG:44:出産経過日 >= CHILD_語彙 && !TCVAR:44:365 && !RAND:2 && FESTIVAL() != ""
	;母の日
	IF FESTIVAL() == "母の日"
		IF CFLAG:44:出産経過日 < CHILD_自立前
			PRINTFORMDL 『엄마, 항상 고마워%UNICODE(0x2665)%』
		ELSE
			PRINTFORMDL 『엄마, 언제나 감사합니다』
		ENDIF
		PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%는 엘렌에게 감사의 마음을 전하며 이치린의 카네이션을 건넸다
		PRINTFORMW 「아아, 고마워 %CHILDNAME:44:(TALENT:44:育児中)%%UNICODE(0x2665)%」
		;ハロウィン　幼少期限定
	ELSEIF FESTIVAL() == "ハロウィン" && CFLAG:44:出産経過日 < CHILD_自立前
		PRINTFORMDL 『트릭 오어 트릿! 과자를 안 주면 장난칠 거야~』
		PRINTFORML 「귀여운 마녀 씨네 %UNICODE(0x2665)% 그럼 사탕을 줄게」
		PRINTFORMDL 『고마워~♪』
		PRINTFORMDW 엘렌과 마녀로 분장한 %CHILDNAME:44:(TALENT:44:育児中)%가 할로윈을 즐기고 있다.
		PRINTFORMDL 『아빠도, 트릭 오어 트릿! 과자를 안 주면 장난칠 거야~』
		PRINTFORMDL 아무래도 이번엔 이쪽 차례인 것 같다, 자……
		CALL ASK_YN("과자를 준다","장난을 받는다")
		IF !RESULT
			PRINTFORMDL 어쩔 수 없다고 생각하고 과자를 주기로 했다.
			PRINTFORMDL 『와아~♪』
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%은 만족하고 있다…….
		ELSE
			PRINTFORMDL 모처럼이니 장난을 받아보기로 했다.
			PRINTFORMDL 『뭐라고, 간지럼 공격을 당해라~♪』
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%은 %조사처리(CALLNAME:MASTER,"의")% 전신을 간질였다!
			PRINTFORMDW ……별로 간지럽지는 않지만, %조사처리(CALLNAME:MASTER,"를")% 필사적으로 간지럽히는 %CHILDNAME:44:(TALENT:44:育児中)%의 모습을 보니 미소가 새어 나온다.
		ENDIF
		;バレンタイン　娘限定
	ELSEIF FESTIVAL() == "バレンタイン" && CHILD_SEX:44:(TALENT:44:育児中) == 1
		IF CFLAG:44:出産経過日 < CHILD_自立前
			PRINTFORMDL 『아빠한테 선물 있어♪ 자, 이거야♪』
			PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%에게서 작은 수제 초콜릿을 받았다!
			PRINTFORMDW 나름 맛이 있었다......
			BASE:MASTER:体力 = MIN(BASE:MASTER:体力 + 100 , MAXBASE:MASTER:体力)
			BASE:MASTER:気力 = MIN(BASE:MASTER:気力 + 100 , MAXBASE:MASTER:気力)
		ELSE
			PRINTFORMDL 『아빠께 드리는 선물이에요♪』
			PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%에게서 수제 초콜릿을 받았다!
			PRINTFORMDW 맛있었다…….
			BASE:MASTER:体力 = MIN(BASE:MASTER:体力 + 200 , MAXBASE:MASTER:体力)
			BASE:MASTER:気力 = MIN(BASE:MASTER:気力 + 200 , MAXBASE:MASTER:気力)
		ENDIF
	ENDIF
	TCVAR:44:365 = 1
	;歩き回り　幼少期以下限定
ELSEIF CFLAG:44:出産経過日 >= CHILD_よちよち && CFLAG:44:出産経過日 < CHILD_自立前 && !RAND:4
	PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%는 주변을 \@ CFLAG:44:出産経過日 < CHILD_語彙 ? 뒤뚱뒤뚱 # 또또각 \@하며 돌아다니고 있다…
	PRINTFORM 「너무 멀리 가지 말아라ー!」
	IF CFLAG:44:出産経過日 < CHILD_語彙
		PRINTFORMW 
	ELSE
		PRINTFORML 
		PRINTFORMDW 『네~』
	ENDIF
ELSEIF ARGS == "幼児期"
	SELECTCASE RAND:6
		CASE 1
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「까꿍, 바아!」
				CASE 2
					PRINTFORML 「높아, 높아-」
				CASEELSE
					PRINTFORMDL 엘렌은 %CHILDNAME:44:(TALENT:44:育児中)%의 머리를 부드럽게 쓰다듬고 있다.
			ENDSELECT
			SIF CFLAG:44:出産経過日 >= CHILD_喋る
				PRINTFORMDL 『맘마~』
			PRINTFORMDW %CHILDNAME:44:(TALENT:44:育児中)%는 즐겁게 깔깔 웃고 있다……
		CASE 2
			SIF CFLAG:44:出産経過日 >= CHILD_喋る
				PRINTFORMDL 『맘마~』
			PRINTFORMDL %CHILDNAME:44:(TALENT:44:育児中)%는 엘렌에게 응석을 부린다.
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「잘했어」
				CASEELSE
					PRINTFORMW 「무슨 일이야 %UNICODE(0x2665)%」
			ENDSELECT
