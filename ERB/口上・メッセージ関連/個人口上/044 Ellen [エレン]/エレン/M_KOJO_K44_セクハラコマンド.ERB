;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K44_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K44_310
CALL M_KOJO_MESSAGE_COM_K44_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K44_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
CFLAG:1891 = 1
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF !CFLAG:ブチギレ
		IF TALENT:恋人 && TALENT:恋慕
			IF (OUTROOF(CFLAG:TARGET:現在位置)) || (OPENPLACE(CFLAG:TARGET:現在位置))
				PRINTFORMW 「잠깐 잠깐 잠깐// 누가 오면 어떡해//」
			ELSE
				PRINTFORMW 「정말, %조사처리(CALLNAME:MASTER,"는")% 정말 야하잖아...」
			ENDIF
		ELSEIF TALENT:恋慕
			IF (OUTROOF(CFLAG:TARGET:現在位置)) || (OPENPLACE(CFLAG:TARGET:現在位置))
				PRINTFORMW 「잠깐 잠깐 잠깐// 누가 오면 어떡해//」
			ELSE
				PRINTFORMW 「정말 %CALLNAME:MASTER%말이야. ...특별해//」
			ENDIF
		ELSEIF TFLAG:193 >= 2
			IF (OUTROOF(CFLAG:TARGET:現在位置)) || (OPENPLACE(CFLAG:TARGET:現在位置))
				PRINTFORMW 「잠깐 잠깐! // 여기서 뭐 하는 거야!//」
			ELSE
				IF TFLAG:193 == 4
					PRINTFORMW 「정말, 뭐가 재미있는 건지 모르겠네」
				ELSE
					PRINTFORMW 「어, 어디 만지고 있는 거야! 변태!」
				ENDIF
			ENDIF
		ELSEIF !TALENT:ヤリマン
			PRINTFORMW 「어디 만지는 거야! 이 변태!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K44_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K44_311
CALL M_KOJO_MESSAGE_COM_K44_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K44_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSEIF !CFLAG:ブチギレ && !MARK:反発刻印
		IF CFLAG:うふふ == 2
			PRINTFORMW 「에헤헤헤// 따뜻해...//」
		ELSEIF TALENT:恋慕 && TALENT:恋人
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 안겨 있으면 왠지 안심이 돼 %UNICODE(0x2665)%」
				CASEELSE
					PRINTFORMW 「에헤헤, 따뜻해~」
			ENDSELECT
		ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
			SELECTCASE RAND:2
				CASE 1
					PRINTFORMW 「에헤헤헤//」
				CASEELSE
					PRINTFORMW (%조사처리(CALLNAME:MASTER,"의")% 냄새... 왠지 마음이 놓이는구나//)
			ENDSELECT
		ELSEIF TALENT:思慕
			PRINTFORMW 「%CALLNAME:MASTER%정말이지, …어쩔 수 없네」
		ELSE
			PRINTFORMW 「잠깐 잠깐만! 뭐 하고 안고 있는 거야!」
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_SUCCESS_COM_K44_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K44_312
CALL M_KOJO_MESSAGE_COM_K44_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K44_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSEIF !CFLAG:ブチギレ && TFLAG:193 != 99 && !MARK:反発刻印
		;ありがとうおしゃぶり霊夢の人！そしてごめんなさい！
		IF EXP:キス経験 == 1
			;ファーストキッス群
			IF TALENT:恋人 && TALENT:恋慕
				PRINTFORMW 「에헤헤// 연인끼리의 키스란 이렇게 행복한 거였구나%UNICODE(0x2665)%」
				PRINTFORMW 「다음엔 내가 할래%UNICODE(0x2665)% 쪽%UNICODE(0x2665)%」
				EXP:キス経験 += 4
				EXP:MASTER:キス経験 += 4
				EXP:愛情経験 += 10
			ELSEIF TALENT:恋人 || TALENT:恋慕
				PRINTFORMW 「에헤헤// 이번엔 나의 차례야 %UNICODE(0x2665)% 에잇 %UNICODE(0x2665)%」
				EXP:キス経験 += 1
				EXP:MASTER:キス経験 += 1
			ELSEIF TALENT:思慕
				PRINTFORMW 「엣? 엣!? 에에엥!?」
				PRINTFORMW (설마 %조사처리(CALLNAME:MASTER,"가")% 키스해 올 줄은 //)
				PRINTFORMW (%CALLNAME:MASTER%에게서 키스를 해 온다는 건 혹시 나를 좋아한다는 거야!? //)
				PRINTFORMW (물론 %조사처리(CALLNAME:MASTER,"를")% 좋아하는 건 맞지만 그건 친구로서의 좋아함이고//)
				PRINTFORMW (%CALLNAME:MASTER%도 그렇게 생각하고 있다고 생각했는데, 하지만/그런데)
				PRINTFORMW (아아우//)
				CFLAG:1014 = 1
				TALENT:羞恥心 = 1
			ELSE
				PRINTFORML 「......나의 첫 키스~!!」
				PRINTFORMDW 엘렌은 울면서 화를 내고 있다...
				BASE:怒り += 500
				CFLAG:好感度 -= 300
				;マイナスにはならない
				SIF CFLAG:好感度 < 0
					CFLAG:好感度 = 0
			ENDIF
		ELSE
			IF TALENT:恋人 && TALENT:恋慕 && GET_TARGETNUM() == 1
				SELECTCASE RAND:3
					CASE 1
						PRINTFORMW 「다음엔 내가 %UNICODE(0x2665)% 쪽쪽%UNICODE(0x2665)% 할 거야」
					CASE 2
						PRINTFORMW 「저기, 한 번 더 %UNICODE(0x2665)%」
					CASEELSE
						SELECTCASE CFLAG:溜まってる度
							CASE 0 TO 499
								PRINTFORMW 「쪽, 쪽」
							CASE 500 TO 799
								PRINTFORMW 「쪽... 응//」
							CASE IS > 800
								PRINTFORMDW 엘렌은 상기된 얼굴로 %조사처리(CALLNAME:MASTER,"의")% 입술을 열렬히 원하고 있다...
						ENDSELECT
				ENDSELECT
				;			EXP:キス経験 += 1
				;			EXP:MASTER:キス経験 += 1
			ELSEIF TALENT:恋慕 && (OUTROOF(CFLAG:TARGET:現在位置)) || (OPENPLACE(CFLAG:TARGET:現在位置))
				PRINTFORMW 「쪽... 후후// 좀 부끄럽네//」
			ELSEIF TALENT:恋人 && TALENT:恋慕
				PRINTFORMW 「쪽... 푸하아. 아하하하 %UNICODE(0x2665)% %CALLNAME:MASTER%정말 좋아해 %UNICODE(0x2665)%」
			ELSEIF TALENT:恋慕 || CFLAG:1014 == 1 || TALENT:恋人
				PRINTFORMW 「쪽... 푸하아. 아하하하//」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
