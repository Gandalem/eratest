							PRINTFORMW 「도와줘서 고마워%UNICODE(0x2665)%」
						ELSEIF TALENT:思慕
							PRINTFORMW 「도와주는구나, 정말 고맙네%UNICODE(0x2665)%」
						ELSE
							PRINTFORMW 「아, %UNICODE(0x2665)% 도움이 되네%UNICODE(0x2665)%」
						ENDIF
					CASEELSE
						IF TALENT:恋慕
							LOCALS:0 = 
							SELECTCASE RAND:6
								CASE 0
									LOCALS:0 '= @"자신감을 주는 약"
								CASE 1
									LOCALS:0 '= @"요정 퇴치 마법"
								CASE 2
									LOCALS:0 '= @"저주를 멈춰라"
								CASE 3
									LOCALS:0 '= @"부적"
								CASE 4
									LOCALS:0 '= @"허브"
								CASE 5
									LOCALS:0 '= @"부적"
							ENDSELECT
							PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 거기서 %LOCALS:0%를 꺼내 %UNICODE(0x2665)%」
						ELSE
							LOCALS:1 = 
							SELECTCASE RAND:4
								CASE 0
									LOCALS:1 '= @"자신감을 주는 약"
								CASE 1
									LOCALS:1 '= @"요정 퇴치 마법"
								CASE 2
									LOCALS:1 '= @"저주를 막아라"
								CASE 3
									LOCALS:1 '= @"부적"
							ENDSELECT
							PRINTFORMW 「거기서 %LOCALS:1%을 꺼내 줘」
						ENDIF
				ENDSELECT
			ENDIF
			;%CALLNAME:MASTER%の教養が低い場合効果が下がる
			SIF ABL:MASTER:教養 < 2
				LOCAL:1 -= 1
			;ここでTCVARに減算
			TCVAR:354 -= LOCAL:1
			;呼び込み
		ELSE
			;先にLOCALに突っ込んどく、成功時は＋３～５人
			LOCAL:1 = RAND:3
			LOCAL:1 += 3
			LOCALS:2 = 
			IF TALENT:恋人
				LOCALS:2 '= @"엘렌과 함께"
			ELSE
				LOCALS:2 '= @"엘렌과는 다른 장소에서"
			ENDIF
			PRINTFORMDL %조사처리(CALLNAME:PLAYER,"는")%%LOCALS:2%를 호출했다
			IF TFLAG:193 == 1
				PRINTFORMDL 연달아 손님들이 찾아왔다!
				;大成功時は＋８～１０人
				LOCAL:1 += 5
				IF TALENT:恋人
					PRINTFORMW 「우와-, 이렇게 손님이 많다니 %UNICODE(0x2665)% 나도 지고 있을 순 없지! 에에, 마법사는 필요 없을까~ %UNICODE(0x2665)%」
					;ラブラブパワーで更に＋２！
					LOCAL:1 += 2
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
					PRINTFORMW 「와%UNICODE(0x2665)% 이렇게 손님이 많다니%UNICODE(0x2665)%　%CALLNAME:MASTER%정말 대단하네%UNICODE(0x2665)%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「우와아 %UNICODE(0x2665)% 굉장해 %UNICODE(0x2665)% 고마워 %CALLNAME:MASTER%%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「아, %UNICODE(0x2665)% 도움이 되네%UNICODE(0x2665)%」
				ENDIF
			ELSEIF TFLAG:193 == -1
				PRINTFORMDL 하지만 손님은 전혀 오지 않았다...
				;失敗時は＋０～１人
				LOCAL:1 = RAND:2
				IF TALENT:恋人
					PRINTFORMW 「뭐, 이런 때도 있는 거야. 신경 쓰지 마 %UNICODE(0x2665)%」
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
					PRINTFORMW 「뭐, 흔한 일이니 신경 쓰지 마 %UNICODE(0x2665)%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「뭐, 흔한 일이니까 신경 쓰지 마%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「아이야, 손님이 전혀 안 오네」
				ENDIF
			ELSE
				PRINTFORMDL 손님들이 조금씩 찾아왔다
				IF TALENT:恋人
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 있으면 백만 대일이네 %UNICODE(0x2665)% 자, 나도 힘낼게!」
				ELSEIF TALENT:恋慕 || CFLAG:1014 == 1
					PRINTFORMW 「도와줘서 고마워%UNICODE(0x2665)%」
				ELSEIF TALENT:思慕
					PRINTFORMW 「도와줘서 고마워%UNICODE(0x2665)%」
				ELSE
					PRINTFORMW 「아, %UNICODE(0x2665)% 도움이 되네%UNICODE(0x2665)%」
				ENDIF
			ENDIF
			;天気がよろしくない場合は－２
			SIF TIME:5 > 3
				LOCAL:1 -= 2
			;%CALLNAME:MASTER%の話術技能が低い場合効果が下がる
			SIF ABL:MASTER:話術技能 < 2
				LOCAL:1 -= 2
			;もし増加数がマイナスになったら０にする
			SIF LOCAL:1 < 0
				LOCAL:1 = 0
			;ここでTCVARに加算
			TCVAR:354 += LOCAL:1
			TCVAR:355 += LOCAL:1
		ENDIF
		;採集
	ELSEIF CFLAG:職種 == 54
		;仕事手伝ったよ！
		TCVAR:364 ++
		;MASTERの採集量を計上　TWには採集技能がまだ無いので教養で代用
		LOCAL:1 = ABL:MASTER:教養 * 80 + RAND:51
		TCVAR:354 += LOCAL:1
		TCVAR:355 += LOCAL:1
	ENDIF
ENDIF
RETURN 1
