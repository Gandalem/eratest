RETURN RESULT

@M_KOJO_MESSAGE_COM_K44_411_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;LOCAL:1 判定用
;LOCAL:2 成功or失敗記録用
;LOCAL:3 魔法のランク
IF LOCAL && !FLAG:70
	;弟子入り時
	IF CFLAG:1007 && CFLAG:1011 && CFLAG:MASTER:現在位置 != TFLAG:宴会場
		$LOOP_KUNREN
		PRINTFORML 지금이라면 마법 시연도 가능하지만...
		PRINTL [1] 마법
		PRINTL [2] 탄막
		INPUT
	ENDIF
	IF RESULT == 1
		;開始時に前回の分をリセットする
		LOCAL:2 = 0
		;判定用の変数を入れておく
		LOCAL:1 = CFLAG:1008 + CFLAG:1009 + (CFLAG:1010 * 2)
		TRYCALLFORM M_KOJO_COLOR_K44
		PRINTFORMW 「자, 공부한 실력을 보여줘 %UNICODE(0x2665)%」
		RESETCOLOR
		IF CFLAG:1008 > 220
			;魔法のランクに合わせてRANDを追加
			LOCAL:1 += RAND:80
			$LOOP_200
			;魔法のランクを記録
			LOCAL:3 = 5
			PRINTFORML 어떤 마법을 쓸까...
			PRINTL [0] 연기 변화의 마법
			PRINTL [1] 질량이 없는 드래곤의 실체화
			PRINTL [2] 얼음 결정으로 이용한 연주의 마법
			;PRINTL [3] 魔法決戦！
			PRINTL [9] 다른 마법으로 한다
			INPUT
			IF RESULT == 0
				PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 연기로 변화하는 마법을 사용했다.
				;清掃技能に応じて補正
				LOCAL:1 += (ABL:MASTER:清掃技能 * 10)
				IF LOCAL:1 >= 820
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 몸이 연기처럼 되었다! 성공이다!
					;学習経験が低いと戻れない、追加されるだけで特に何もないけど
					IF CFLAG:1008 < 250
						PRINTFORMW ...돌아갈 수 없어...
						PRINTFORMW …
						PRINTFORMW 곤란한 %조사처리(CALLNAME:MASTER,"를")% 보고 견디지 못한 엘렌이 어떻게든 해 주었다.
						;成功判定（煙）
						LOCAL:2 = 2
					ELSE
						;成功判定
						LOCAL:2 = 1
					ENDIF
				ELSE
					PRINTFORMW ...변화는 없는 것 같다...
					;失敗判定
					LOCAL:2 = 0
				ENDIF
			ELSEIF RESULT == 1
				;エレン以外にもいると不可
				IF GET_TARGETNUM() > 1
					PRINTFORMW ...지금은 다른 사람이 있으니 위험해서 그만두자...
					GOTO LOOP_200
				ELSE
					PRINTFORMW %CALLNAME:MASTER%は質量のないドラゴンの実体化の魔法を使った
					;教養に応じて補正
					LOCAL:1 += (ABL:MASTER:教養 * 10)
					IF LOCAL:1 >= 850
						PRINTFORMW 눈앞에 환상의 드래곤이 소환되었다! 성공이다!
						;実技経験が低いと制御不能、分岐されるだけで特に何もないけど
						IF CFLAG:1009 < 200
							PRINTFORMW ...소환할 수는 있었지만 제어할 수 없을 것 같다. 어떡하지...
							PRINTFORMW …
							PRINTFORMW 곤란한 %조사처리(CALLNAME:MASTER,"를")% 보고 견디지 못한 엘렌이 어떻게든 해 주었다.
							;成功判定（ドラゴン）
							LOCAL:2 = 3
						ELSE
							;いろいろとごめんなさい
							LOCAL:1 = 0
							PRINTFORMW 드래곤은 %조사처리(CALLNAME:MASTER,"의")% 지시를 기다리고 있는 것 같다...
							$LOOP_DORAGON
							PRINTFORML 뭘 해달라고 해야 할까...
							PRINTL [0] 특별히 없으니 돌아가 달라고 한다
							SIF LOCAL:1 == 0
								PRINTL [1] 등에 태워 달라고 했다
							SIF LOCAL:2 == 0
								PRINTL [2] 하쿠레이 신사를 습격한다!
							INPUT
							IF RESULT == 0
								PRINT 특별히 해줬으면 하는 것도 없으니까
								SIF LOCAL:1 == 0 && LOCAL:2 == 0
									PRINT 아무것도 하지 않고
								PRINTW 돌려보내기로 했다...
							ELSEIF RESULT == 1 && LOCAL:1 == 0
								PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 의기양양하게 드래곤의 등에 올라탔다.
								PRINTFORMW ……환상에 탈 방법이 없었다…….
								LOCAL:1 = 1
								GOTO LOOP_DORAGON
							ELSEIF RESULT == 2 && LOCAL:2 == 0
								PRINTFORMW ...그런 짓을 하면 자기 몸이 위험해진다!
								PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 간신히 마음을 다잡았다...
								LOCAL:2 = 1
								GOTO LOOP_DORAGON
							ELSE
								GOTO LOOP_DORAGON
							ENDIF
							;成功判定
							LOCAL:2 = 1
						ENDIF
					ELSE
						PRINTFORMW ......아무 일도 일어나지 않았다...
						;失敗判定
