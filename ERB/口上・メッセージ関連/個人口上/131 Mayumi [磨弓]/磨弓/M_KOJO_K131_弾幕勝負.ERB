; Modular ERB: 個人口上/131 Mayumi [磨弓]/磨弓/M_KOJO_K131_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================

@M_KOJO_MESSAGE_COM_K131_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;磨弓はスキル未実装ですが、一応書いてます。念のためにOFF
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(131) == "酔いどれ" || ALCOHOL_FACE(131) == "ぐでぐで"
			PRINTFORML 「승부라고? 좋지!」
			PRINTFORML 「숙취 해소 운동으로는 딱이군!」
			PRINTFORMDL 마유미의 목소리에 응답하듯, 도자기 병사 대군이 모습을 드러냈다...!
			PRINTFORMW 「『허무한 무진병단』이다! %조사처리(CALLNAME:MASTER,"를")% 쓰러뜨려라!!」
		ELSEIF TALENT:131:機嫌 == -1 || CFLAG:131:ブチギレ || MARK:131:反発刻印 >= 3
			PRINTFORML 「흥... 딱 좋군」
			PRINTFORML 「"'우리'도 너에게 가르쳐 주려고 하고 있었다...!!"」
			PRINTFORMDL 마유미의 목소리에 응답하듯, 도자기 병사들의 대군이 모습을 드러냈다...!
			PRINTFORMW 「'텅 빈 무한병단'! 저놈의 뒤틀린 본성을 바로잡아라!!」
			;あなた戦闘力3以下
		ELSEIF ABL:MASTER:戦闘能力 < 3
			PRINTFORML 「멈춰두는 편이 몸에 이롭다고 생각하지만…」
			PRINTFORML 「너는 말로 해도 이해하지 못할 테니.」
			PRINTFORMDL 마유미의 목소리에 응답하듯, 도자기 병사 대군이 모습을 드러냈다...!
			PRINTFORMW 「'텅 빈 무한병단'! 용기와 만용의 차이를 지긋지긋하게 가르쳐 주마!!」
		ELSE
			PRINTFORML 「승부라고? 좋다!」
			;磨弓戦闘能力5以上
			IF ABL:戦闘能力 >= 5
				PRINTFORML 「하지만… 예전의 "우리들"과 같다고 생각하지 마라?」
				PRINTFORML 「나와라! 『불패의 무진병단』!!」
				PRINTFORMDL 마유미의 목소리에 응답하듯, 하니와 병사들이 차례로 모습을 드러낸다…
				PRINTFORMDL 이전의 하니와 병단과는 수도 질도 격이 다르다...!
				PRINTFORMW 「케이키님께 받은 새로운 힘으로, 너에게 설욕을 달성한다!!」
			ELSE
				PRINTFORML 「"우리가 상대해 주겠다!"」
				PRINTFORMDL 마유미의 목소리에 응하듯, 하니와 병사들의 대군이 모습을 드러냈다...!
				PRINTFORMW 「『텅 빈 무한 병단』아! %조사처리(CALLNAME:MASTER,"를")% 쓰러뜨려라!!」
			ENDIF
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
			CASE 2
				PRINTFORML 「겁먹지 마라! 기병대, 전진해라! 궁수대는 지원을 해라!」
				PRINTFORMW 「남아있는 검사대는 궁수대를 지켜라!」
			CASE 1
				PRINTFORML 「...크윽! ...그렇다면 내가!</」
				PRINTFORML 「――！」
				PRINTFORMDL 마유미가 휘파람을 불자, 하나의 말 모양의 조형물이 나타난다.
				PRINTFORMDL 그것에 시원하게 올라타자, 마유미는 세라믹으로 만든 검을 들었다!
				PRINTFORML 「간다%CALLNAME:MASTER%! 마지막 승부다아아아!!」
				PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 탄막을 두려워하지 않고 돌격해 왔다!
			CASE 0
				PRINTFORML 「%TEXTR("つ、強い…！これ程とは…！/やはり私達は…生身の人間には勝てないのか…？/袿姫……様……")%」
				PRINTFORMDW 말 형태의 고분은 산산조각 나고, 마유미는 땅으로 내던져졌다...
		ENDSELECT
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【残忍酷薄】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1 ;custom code
;-------------------------------------------------
IF LOCAL:1 && ARGS == "残忍酷薄"
	PRINTFORML 「%TEXTR("さあ、この状況…お前はどうする？/よし！このまま押し切るぞ！/今だ！包囲しろ！")%」
	PRINTFORMDW 인해전술로 제압하려 오는 조각상 병사들을 폭탄으로 날려버렸다!
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【乾坤一擲】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1 ;custom code
;-------------------------------------------------
IF LOCAL:1 && ARGS == "乾坤一擲"
	SELECTCASE RAND:2
		CASE 0
			PRINTFORML 「궁병대, 사격 준비! ...테엣!!」
			PRINTFORMDW 마유미의 고함과 동시에, 다량의 화살이 날아왔다!
		CASE 1
			PRINTFORML 「기병대, 돌격---!」
			PRINTFORMDW 다수의 기병토인이 %조사처리(CALLNAME:MASTER,"를")% 향해 돌진해왔다!
	ENDSELECT
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【怪力乱神】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1 ;custom code
;-------------------------------------------------
IF LOCAL:1 && ARGS == "怪力乱神"
	SELECTCASE RAND:2
		CASE 0
			PRINTFORML 「궁병대, 공격 준비!…테엣!!」
			PRINTFORMDW 궁병 하니와가 날리는 화살의 탄막에 공격을 지워졌다!
		CASE 1
			PRINTFORML 「검사대! 전진해서 방어를 단단히 해라!」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 공격은, 검사 하시라들에게 막혀버렸다!
	ENDSELECT
ENDIF
;-------------------------------------------------
;戦闘後
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後"
	PRINTFORML 
	;残り残機4が表示されうるのは【洽覧深識】持ちのみ
	;残機が1以上ならあなたの負け、0の場合はあなたの勝利
	;あなた勝利
	IF 相手残機 == 0
		IF TALENT:131:機嫌 == -1 || CFLAG:131:ブチギレ || MARK:131:反発刻印 >= 3
			PRINTFORML 「…다음은 지지 않겠다…!」
			PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 손을 빌리지 않고 일어섰다…
		ELSE
			;磨弓に勝利済み
			IF CFLAG:131:弾幕勝負勝利
				PRINTFORML 「……으윽…! 크윽…우으…!」
				;磨弓戦闘能力5以上
				IF ABL:戦闘能力 >= 5
					PRINTFORML 「젠장! 그 많은 병력으로도 이길 수 없다니...!」
				ELSE
					PRINTFORML 「젠장! 또... 지고 말았어...!」
				ENDIF
				PRINTFORMW 「이러다가는… 케이키님께 보여드릴 얼굴이 없어…!」
				PRINTFORMDL 몹시 분했던 것인지 마유미는 팔로 눈을 가린 채 눈물을 흘리고 있다.
				PRINTFORMDW 일단 진정시키려고 %조사처리(CALLNAME:MASTER,"가")% 손을 뻗지만……
				PRINTFORMW 「시끄러워!! 저리 가! 나한테 신경 쓰지 마!!」
				PRINTFORMDL 드디어 심술을 부리기 시작한 마유미에게, %조사처리(CALLNAME:MASTER,"는")% 말을 건다.
				PRINTFORMDW "맛있는 거라도 먹으러 가자"
				PRINTFORML 「…………。」
				PRINTFORMDW 마유미는 꾸벅꾸벅 눈을 비비며 천천히 일어섰다...
				SETCOLOR 0xFFE9A9
				PRINTFORML      스테이지 클리어
				PRINTFORMDL      클리어 보너스
				PRINTFORMDL       5,000,000
				PRINTFORMDW 
				;磨弓に初勝利
			ELSE
				PRINTFORML 「하아……」
				PRINTFORML 「저들에게 이어, %CALLNAME:MASTER%에게까지 지다니… 나는 병장으로서 자격이 없다……」
				PRINTFORMDW "우연히 운이 좋았을 뿐이야"라며 격려하면서, %조사처리(CALLNAME:MASTER,"는")% 쓰러지는 마유미에게 손을 내밀었다.
				PRINTFORML 「…훗…♪……너는 정말 다정한 사람이구나……」
				PRINTFORML 「―다음엔 지지 않겠어!」
				PRINTFORMDW 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 손을 잡고 일어서는 마유미의 표정은 매우 상쾌했다.
				SETCOLOR 0xFFE9A9
				PRINTFORML      스테이지 클리어
				PRINTFORMDL      클리어 보너스
				PRINTFORMDL       5,000,000
				PRINTFORMDW 
			ENDIF
		ENDIF
		;磨弓勝利
	ELSE
		IF TALENT:131:機嫌 == -1 || CFLAG:131:ブチギレ || MARK:131:反発刻印 >= 3
			PRINTFORMW 「조금은 반성했나?」
		ELSE
			;あなた戦闘力3以下
			IF ABL:MASTER:戦闘能力 < 3
				PRINTFORML 「...자, 일어설 수 있겠니?」
				PRINTFORMW 「나에게 이기고 싶다면 제대로 단련해서 강해져야 해.」
			ELSE
				PRINTFORML 「우오오오오오오!!!」
				PRINTFORMDW 땅에 쓰러지면서, 마유미의 승전가를 들었다...
			ENDIF
		ENDIF
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
