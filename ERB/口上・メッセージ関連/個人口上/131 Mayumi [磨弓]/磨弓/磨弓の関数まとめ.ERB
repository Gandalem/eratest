;季節ネタ
;==================================================

@MAYUMI_SEASON
SELECTCASE DAY:2
	;春
	CASE 1
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「...하아...」
				PRINTFORML 「―엣!? 나 자신이...! 게으름을 피고 있었어, 죠토구 마유미...!」
				PRINTFORMDW 봄 햇살을 받은 걸까, 마유미는 조금 졸려 보인다...
			CASE 1
				PRINTFORML 「이 시기가 되면, 꽃가루 알레르기라는 것에 고통받는 사람이 많다고 하던데…」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 괜찮은 건가?」
			CASE 2
				PRINTFORML 「응...? %조사처리(CALLNAME:MASTER,"는")% 뭘 웃고 있는 거야?」
				PRINTFORML 「아...! 후후... 나비인가...♪」
				PRINTFORMDW 마유미에 앉아 있던 나비가, 파닥파닥 어딘가로 날아가 버렸다.
			CASE 3
				PRINTFORML 「봄은 동물 영물들이 동면에서 깨어나 활발해지는 계절이다」
				PRINTFORML 「너도 조심하지 않으면 쉽게 빙의당할 것이다」
				PRINTFORMDW 동물들은 영물이 되어도 동면하는 모양이다……
			CASE 4
				PRINTFORML 「응...? %조사처리(CALLNAME:MASTER,"는")% 무슨 일이야?... 내 얼굴에 뭔가 붙어있나?」
				PRINTFORMDW 마유미의 머리에 벌이 앉아있다. 어떻게 쫓아내야 할까...?
		ENDSELECT
		;夏
	CASE 2
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「... %CALLNAME:MASTER%. 더운 건 알겠지만, 해이해졌잖아」
				PRINTFORMDW 하니와병은 시원해서 기분 좋다... %조사처리(CALLNAME:MASTER,"는")% 마음껏 끌어안고 볼에 비볐다.
			CASE 1
				PRINTFORML 「이런 더운 날에는 삼도(三途)의 강물로 물을 주면 좋을 거야」
				PRINTFORMDW 어쩐지 버릇없게 느껴진다…….
			CASE 2
				;お盆のナスときゅうり
