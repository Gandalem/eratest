@MAYUMI_FELLATIO
;舌技術２以上
IF ABL:舌 >= 2
	;今射精した
	IF NOWEX:PLAYER:11
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「주루옷HPH쥬부옷HPH즈쥬옷HPH지우옷HPH지우오옷HPH HPH」","L"
				PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 허리에 손을 감더니, 그대로 격렬하게 머리를 앞뒤로 흔들었다...!
			CASE 1
				CALL HPH_PRINT,@"「주뽄HPH쪽HPH주뽄HPH구쥬HPH쥬루-HPH HPH」","L"
				PRINTFORMDL 마유미는 %조사처리(CALLNAME:MASTER,"의")% 성기를 핥고 빨면서, 자신의 질을 손가락으로 격렬하게 애무하고 있다.
				PRINTFORMDW 음란한 물소리에 청각까지 범해진 기분이 되면서, %조사처리(CALLNAME:MASTER,"는")% 사정했다.
			CASE 2
				CALL HPH_PRINT,@"「응...흡...흐읍...윽...흐읍」","L"
				CALL HPH_PRINT,@"「쭉... 주루루루우욱-ㅎㅍㅎ ㅎㅍ」","L"
				PRINTFORMDW 마유미의 강렬한 빨아올림에, %조사처리(CALLNAME:MASTER,"는")% 아무런 감흥 없이 사정했다...
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「츄읍! HPH할 거야... 응? HPH후... HPH추... HPH쥬...륵 HPH」","L"
				CALL HPH_PRINT,@"(나도 준비해 두어야겠어... HPH)","L"
				PRINTFORMDW 마유미는 페라를 하면서 자신의 질에 손가락을 넣었다...!
			CASE 1
				CALL HPH_PRINT,@"「응으...♪ 후후... HPH 세이에히는, 여기서 받는 거야...? HPH」","L"
				PRINTFORMDW 마유미는 페니스를 입에 넣은 채, 고환을 주무르며 다가왔다...!
			CASE 2
				CALL HPH_PRINT,@"「흐으윽... 츄읍! 흐으윽 혀로 핥아줘... 흐으윽」","L"
				CALL HPH_PRINT,@"「츄릅... HPH 도라...? 역겨워? HPH」","L"
				PRINTFORMDW 마유미는 음란하게 %조사처리(CALLNAME:MASTER,"의")% 페니스를 핥고 있다.
			CASE 3
				CALL HPH_PRINT,@"「츄...흡쪽츄르륵...츄...챱쪽츄르욱... 큭」","L"
				CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 거시기...♪ 변함없이 굉장한 냄새가 나네... HPH)","W"
			CASE 4
				CALL HPH_PRINT,@"「응, 흣 후우 HPH 쪽쪽 HPH 쮸루루옷 HPH 빨려욧 HPH 츄 HPH 츄부옷 HPH」","L"
				PRINTFORMDW 입가에서 침이 흘러내릴 정도로 격렬하게, 마유미는 페니스를 핥고 빨고 있다...!
		ENDSELECT
	ENDIF
	;それ以外
ELSE
	;今射精した
	IF NOWEX:PLAYER:11
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응...! 응윽... 크윽...! 츄우읍... 흐으...」","L"
				PRINTFORMDW 마유미는 페니스를 한계까지 삼키고, %조사처리(CALLNAME:MASTER,"의")% 사정에 대비했다...!
			CASE 1
				CALL HPH_PRINT,@"「질척...윽...HPH 질척...HPH 응...응으...?...질척HPH 질퍽HPH」","L"
				PRINTFORMDW 마유미는 참을 수 있는 액체를 핥았는지 순간 얼굴을 찡그렸지만, 금세 사정을 유도하기 위해 페니스를 빨아들였다...!
			CASE 2
				CALL HPH_PRINT,@"「스으...! 음! 후푸헵츄풉후헵쥬후헵주루헵지우헵 후헵」","L"
				PRINTFORMDW 마유미는 필사적으로 머리를 움직이며, 더욱 자극을 주어왔다...!
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「츄...후프응...♪ 츄파...후프레로...♪」","L"
				PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 페니스를 열심히 핥고 있다.
			CASE 1
				CALL HPH_PRINT,@"「츄...햣...햣...! 츄...♪ 쯧윽...햣」","L"
				PRINTFORMDW 페니스의 독특한 맛에 얼굴을 찡그리면서도, 마유미는 귀두를 빨고 있다...
			CASE 2
				CALL HPH_PRINT,@"「츄읍...후푸...♪응! 후프 츕폿후프 츕파앗후프」","L"
				PRINTFORMDW 마유미는 이쪽 표정을 살피면서 구강성애를 계속하고 있다.
			CASE 3
				PRINTFORML 「모고...♪...응!?」
				PRINTFORML 「푸핫! 미, 미안해%CALLNAME:MASTER%! 괜찮아...?」
				PRINTFORMDW 마유미의 이가 귀두에 닿아 저도 모르게 소리를 내버렸다...
		ENDSELECT
	ENDIF
ENDIF
;==================================================
;キス系関数
;==================================================

@MAYUMI_KISS
;親密５以上
IF ABL:親密 >= 5
	SELECTCASE RAND:6
		CASE 0
			CALL HPH_PRINT,@"「츄... HPH츄HPH츄옷HPH」","L"
			PRINTFORMDW 
		CASE 1
			CALL HPH_PRINT,@"「쪽... HPH는... HPH... 더...!」","L"
			CALL HPH_PRINT,@"「아...흐푸츄흐푸츄프흐렐...으...흐푸」","L"
			PRINTFORMDW 마유미의 부탁에 응해, 혀를 얽었다...!
		CASE 2
			CALL HPH_PRINT,@"「츄읍HPH... 츄풉... HPH레로... HPH츄풉HPH츄HPH츄풉HPH츄우웅HPH HPH」","L"
			PRINTFORMDW 마유미와 혀를 얽히게 하며, 서로의 감정을 고조시켰다...!
		CASE 3
			CALL HPH_PRINT,@"「츄헵응...헵츄푸헵는...♪푸...헵츄푸헵레로오...윽...헵 헵」","L"
			CALL HPH_PRINT,@"「푸하... HPH 어때...? 흥분할까...? HPH」","W"
		CASE 4
			CALL HPH_PRINT,@"「츄읍! 후후루! 주우~! 츄파앗! 어, 왜 그래? 갑자기 입을 떼다니!」","L"
			PRINTFORMDW 마유미의 격렬한 키스로, 아슬아슬하게 산소 부족이 될 뻔했다...
		CASE 5
			CALL HPH_PRINT,@"「응! 후후츄루... 후후츄 후후하무 후후쥬 후후츠를로옷 후후」","L"
			PRINTFORMDW 마유미는 적극적으로 혀를 얽으며, 깊은 키스를 해왔다...!
	ENDSELECT
	;それ以外
ELSE
	SELECTCASE RAND:3
		CASE 0
			CALL HPH_PRINT,@"「음...! 음... 쪽... HPH」","L"
			PRINTFORMDW 마유미는 조금 긴장한 것 같다.
		CASE 1
			CALL HPH_PRINT,@"「응응흐읍...흐읍음...흐읍」","L"
			PRINTFORMDW 마유미는 몸을 경직시키면서도 키스를 받아들이고 있다.
		CASE 2
			CALL HPH_PRINT,@"「츄...헵ㅎ음...」","L"
			PRINTFORMW 「역시... 키스는 조금 부끄럽네...」
	ENDSELECT
ENDIF
;==================================================
;処女関数 指入れセクハラ時に使い回すため関数化
;==================================================

@MAYUMI_VIRGIN
SELECTCASE RAND:5
	CASE 0
		PRINTFORML 「크윽…! 응…! 으윽…!」
		PRINTFORMDW 별로 익숙하지 않은 건지, 마유미는 고통에 얼굴을 일그러뜨리고 있다…
	CASE 1
		PRINTFORML 「우... 아...! 들어와, 올... 우...!」
		PRINTFORMDW 체내로 침입해오는 손가락의 감촉에 마유미는 몸을 떨고 있다.
	CASE 2
		PRINTFORML 「이, 넣는 건 괜찮지만, 천천히 부탁이야...?」
		PRINTFORML 「케이키님 말씀으로는 이곳의 구조가 인간과 같다고 하니...」
		PRINTFORMDW 딱 맞게 닫힌 마유미의 비열에 손가락을 천천히 넣었다...
	CASE 3
		PRINTFORML 「으윽...! 하, 한다면 빨리 해줘...!」
		PRINTFORMDW 긴장으로 몸이 굳어있는지 질 구멍에 손가락이 거의 들어가지 않는다...
	CASE 4
		PRINTFORML 「자... "스스로 할 때"!?」
		PRINTFORML 「이런 시간에 이상한 거 묻지 마! 바보야!」
		PRINTFORMDW 참고로 평소에 어떻게 만지는지 물어봤더니 혼났다...
ENDSELECT
;==================================================
;ボディタッチ関数
;==================================================

@MAYUMI_COUNTER
SELECTCASE RAND:6
	CASE 0
		PRINTFORML 「미안! 아팠나...?」
	CASE 1
		PRINTFORML 「아, 일부러 그런 게 아니라고!?」
	CASE 2
		PRINTFORML 「…두…두근,했…까…?」
	CASE 3
		PRINTFORML 「이... 이것은, 그게...」
	CASE 4
		PRINTFORML 「...아니야...! 몸이 멋대로...」
	CASE 5
		PRINTFORML 「…………。」
		PRINTFORMDL 마유미는 볼을 붉히며 시선을 피하고 있다.
ENDSELECT
