@M_KOJO_MESSAGE_COM_K131_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;お掃除フェラ
	ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「하아앗 HPH 하아앗 HPH %조사처리(CALLNAME:MASTER,"의")% 아이... HPH 아깝다... HPH」","L"
				CALL HPH_PRINT,@"「흐으윽, 하아... 음... 츄릅... 츄릅... 쭉쭉...」","L"
				PRINTFORMDW 마유미는 요도 안에 남아있던 정액을 마셔버렸다...!
			CASE 1
				CALL HPH_PRINT,@"「스윽스윽... HPH 하아... HPH 나의 것과 섞여서... 굉장한 냄새다... HPH」","L"
				CALL HPH_PRINT,@"「아아... HPH해라 HPH츳 HPH는... HPH해라... 윽 HPH」","L"
				PRINTFORMDW 마유미는 체액으로 뒤덮인 페니스를 정성스럽게 핥아 깨끗하게 만들었다...!
		ENDSELECT
		;それ以外
	ELSE
		CALL MAYUMI_FELLATIO
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF ABL:舌 >= 2
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「아아...HPH쥬...HPH쥬부우옷HPH쥬루루우웃HPH HPH」","L"
				PRINTFORMDW 마유미의 구강 안으로 페니스를 삽입하자마자, 혀가 물결치듯 감겨왔다...!
			CASE 1
				CALL HPH_PRINT,@"「으응... 큭큭... ♪ 후후... 답답해? 큭큭」","L"
				CALL HPH_PRINT,@"「애태우는 것도 가엾으니까... 아아-... HPH」","L"
				PRINTFORMDW 마유미는 크게 입을 벌리고 페니스를 입에 넣었다...!
			CASE 2
				CALL HPH_PRINT,@"「자 %CALLNAME:MASTER%... HPH 오늘도 정액을 마시게 해주마... HPH」","L"
				CALL HPH_PRINT,@"「아무... 헵후쥬... 보, 오오... 헵후 헵후」","L"
				PRINTFORMDL 마유미는 입을 오므리고 %조사처리(CALLNAME:MASTER,"의")% 페니스를 봉사하고 있다.
				PRINTFORMDW 늠름하게 다듬어진 얼굴이 저렇게 무너져 있는 모습은, 그것만으로도 끝을 볼 것 같은 정도로 흥분한다...!
			CASE 3
				CALL HPH_PRINT,@"「그러고 보니... 이쪽의 구슬도 빨아지는 것도 기분 좋다고 들었는데...? HPH」","L"
				CALL HPH_PRINT,@"「네가 괜찮다면 해 주겠지만... 어쩔래? HPH」","L"
				PRINTFORMDW 마유미는 고환에 손가락을 기댄 채 핥고 있다...!
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「흐, 입이라니... 별로 자신은 없지만...」
				PRINTFORML 「스으... 아아-... 음...♪」
				PRINTFORMDW 마유미는 조심스럽게 %조사처리(CALLNAME:MASTER,"의")% 페니스를 물었다.
			CASE 1
				CALL HPH_PRINT,@"「음... %조사처리(CALLNAME:MASTER,"의")% 냄새가 나네... HPH」","L"
				PRINTFORMDL 마유미는 즐거운 듯 남성의 성기를 냄새 맡고 있다.
				PRINTFORMDW 슬슬 입에 넣었으면 좋겠다고 말하자, 마유미는 무릎을 꿇고 페라치오를 시작했다...!
			CASE 2 ;custom code
				PRINTFORML 「이게 정말로, 내 안으로...?」
				PRINTFORML 「...아니 의외로 들어갈지도 몰라... 조금, 알아볼까...♪」
				PRINTFORMDL 마유미는 의심스러운 듯 %조사처리(CALLNAME:MASTER,"의")% 페니스를 바라보고 있었지만...
				PRINTFORMDW 이윽고 결심한 듯 입으로 가까이 가져갔다...!
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
