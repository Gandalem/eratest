@M_KOJO_MESSAGE_MESSAGECHECK_COM_K131_80
RETURN 0

@M_KOJO_MESSAGE_COM_K131_80
CALL M_KOJO_MESSAGE_COM_K131_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K131_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「...이걸, 손으로?」
		PRINTFORML 「알았어, 해보자...」
		PRINTFORMDW 마유미가 조심스럽게 페니스를 움켜쥐었다...
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧３以上
	ELSEIF ABL:技巧 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「이제,인가...? 어쩔 수 없는 녀네... HPH」","L"
					CALL HPH_PRINT,@"「뭐, 됐어...♪ 제대로 받아주겠으니까... 자... HPH」","L"
					PRINTFORMDW 마유미는 손바닥으로 정액을 받아들이는 자세를 취했다...!
				CASE 1
					CALL HPH_PRINT,@"「그래...♪...이렇게, 토...HPH」","L"
					CALL HPH_PRINT,@"「어때? 애액으로 다뤄지는 것도 나쁘지 않겠지? HPH」","L"
					PRINTFORMDL 마유미는 자신의 비열에서 흘러나온 애액을 손에 바르더니 다시 움직이기 시작했다.
					PRINTFORMDW 미끌미끈한 감촉과 적당한 온기에 %조사처리(CALLNAME:MASTER,"의")% 쾌감은 절정에 도달했다...!
				CASE 2
					CALL HPH_PRINT,@"「...윽 후후아... 알겠어...♪」","L"
					CALL HPH_PRINT,@"「네가 좋아하는 곳에 해도 좋다... HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 욕망대로, 마유미를 정액으로 물들였다...!
				CASE 3
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%…HP 고추, 벌써 한계인가? HP」","L"
					PRINTFORML 「그럼, 더 문질러 줄까?... 그치♪」
					PRINTFORMDL 마유미의 손놀림이 더욱 가속하며 절정으로 이끈다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 참지 못하고 작은 신음과 함께 사정했다―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「스스로 하는 것과 내가 하는 것 사이에는, 역시 감각이 다른 걸까?」
					CALL HPH_PRINT,@"「...훗...♪ 그렇구나... HPH」","L"
					CALL HPH_PRINT,@"「그럼, 내 손으로만 사정할 수 있을 정도로 네게 빠지게 만들어 주마... HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 대답에 기분이 좋아졌는지, 마유미는 다루는 속도를 높여왔다.
				CASE 1
					CALL HPH_PRINT,@"「하아... 하아... HPH응! HPH후우... 윽... HPH쿠으... HPH하아... 아아... HPH」","L"
					CALL HPH_PRINT,@"(%조사처리(CALLNAME:MASTER,"의")% 거시기... HPH 아무리 봐도... 크고, 단단해...)","L"
					CALL HPH_PRINT,@"(빨리... HPH 빨리 이 녀석을, 나의 질 안에 넣어줬으면 해... HPH)","L"
					PRINTFORMDW 마유미는 비어있는 손으로 자신의 가랑이를 만지며 자위하고 있다...!
				CASE 2
					CALL HPH_PRINT,@"「이렇게...♪ 끝을 긁히는 거, 기분 좋지? HPH」","L"
					PRINTFORMDW 마유미의 검지손가락이 귀두를 자극해 온다...!
				CASE 3
					PRINTFORML 「자루뿐만이 아니라... 이쪽도, 라고... ♪」
					PRINTFORMDW 마유미는 페니스뿐만 아니라 고환까지 주무르며 자극해왔다...!
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아... HPH 하앗... HPH 하앗... HPH HPH」","L"
					PRINTFORMDL "이제 사정할 것 같다"고 말했지만, 마유미는 흥분에 정신이 팔려 듣지 못하는 듯하다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 포기하고, 쾌감에 몸을 맡기기로 했다...
				CASE 1
					PRINTFORML 「"그렇게 하는 거야"... 사정인가!?」
					PRINTFORML 「저, 저는 어떻게 해야 하나...!?」
					PRINTFORMDW 마유미의 말에 귀 기울일 여유는 이미 없었다...
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%……아까보다, 커져버렸어...?」
					CALL HPH_PRINT,@"「아, 그렇구나... 사정이 가까워진 거구나...? HPH」","L"
					PRINTFORMDW 마유미는 처리 속도를 더욱 빠르게 하여 사정을 촉진해왔다...!
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「후우... 흐읍...♪ 후우...」","L"
					CALL HPH_PRINT,@"(이 큰 것이... 벌써 내 안에...? HPH)","L"
					PRINTFORMDW 마유미는 막대기를 손으로 만지면서 허벅지를 움찔거리며 비비고 있다.
				CASE 1
					CALL HPH_PRINT,@"「항상 스스로 할 때는... 이렇게 손으로 비비는 건가...? HPH」","L"
					PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 자위 행위에 흥미가 있는 것 같다...
				CASE 2
					PRINTFORML 「힘 조절은... 이 정도로 괜찮을까...?」
					PRINTFORMDW 마유미는 약간 어색한 움직임으로 %조사처리(CALLNAME:MASTER,"의")% 성기를 다루고 있다.
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
