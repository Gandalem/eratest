;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「가슴으로 감싸다...? ...이걸로 괜찮은 걸까?」
		PRINTFORMDW 마유미는 말대로 가슴을 드러내고, %조사처리(CALLNAME:MASTER,"의")% 성기를 가슴으로 감쌌다...!
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;胸技術２以上
	ELSEIF ABL:胸 >= 2
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 갈 것 같아? 좋아... HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 사정이 가까워졌음을 감지한 마유미는 가슴의 움직임을 더욱 빠르게 했다...!
				CASE 1
					CALL HPH_PRINT,@"「거기가 뻐근하게 울리기 시작했어... ♪ 벌써 사정할 것 같구나? HPH」","L"
					CALL HPH_PRINT,@"「어쩔 거야? 마셔줄까? HPH 아니면 얼굴에 부어줄까? HPH」","L"
					PRINTFORMDW 마유미의 능숙한 파이즈리로, 허망하게 끝나버렸다―
				CASE 2
					CALL HPH_PRINT,@"「네가 좋아하는 때에... 쏴도 괜찮으니까... HPH」","L"
					PRINTFORMDW 마유미의 부드러운 가슴에 감싸여, 기분 좋은 감각과 함께 사정했다―
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「어때, %CALLNAME:MASTER%...♪ 기분 좋아...? HPH」","W"
				CASE 1
					PRINTFORML 「게다가... 나의 가슴에, 이런 용도가 있었다니...♪」
				CASE 2
					CALL HPH_PRINT,@"「후후...♪ 무슨 일이야? 허리가 떠 있잖아... HPH」","W"
				CASE 3
					CALL HPH_PRINT,@"「유두로 끝을 문지르면 기분 좋겠지...? HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「흐읍...!! 더 빨리...? 이렇게...?!」
					PRINTFORMDW 마유미는 아까보다 강하게 가슴으로 압박하며 쓸어 올렸다...!
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%, 내보내려고 하는 건가...!?」
					PRINTFORML 「하지만... 이러면 양손을 쓸 수 없어, 어떻게 해야 하지...?」
					PRINTFORMDW 마유미가 망설이는 사이에, %조사처리(CALLNAME:MASTER,"는")% 사정했다...!
				CASE 2
					PRINTFORML (%조사처리(CALLNAME:MASTER,"는")% 기분 좋아 보이네...♪)
					PRINTFORML (가슴 같은 건 싸움의 방해만 된다고 생각하고 있었는데... %조사처리(CALLNAME:MASTER,"가")% 기뻐한다면―)
					PRINTFORML 「…우와!?」
					PRINTFORMDW 파이즈리에 열중하고 있던 마유미는, %조사처리(CALLNAME:MASTER,"의")% 사정이 임박하다는 것을 알아차리지 못한 듯했다...
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「응...! 후우...! 꽤... 어렵네...!」
				CASE 1
					PRINTFORML 「...있잖아, %CALLNAME:MASTER%. 정말 이 방법으로 괜찮은 걸까?」
					PRINTFORMW 「손으로 비비는 게 더 빠른 것 같은데...」
				CASE 2
					PRINTFORMW 「훗...응음...후우...응으...윽...!」
				CASE 3
					PRINTFORMW 「과연... 가슴이란, 이렇게 사용하는 것이었구나... ♪」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
