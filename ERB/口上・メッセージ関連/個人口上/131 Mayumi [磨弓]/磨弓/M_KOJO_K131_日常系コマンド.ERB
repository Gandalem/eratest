;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		IF TALENT:妊娠
			PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 아이를 품고 있는 마유미의 배를 살며시 쓰다듬었다.
			PRINTFORMDW 도기가 되어 있어야 할 그녀가 정말로 임신했다는 사실에, 다시 한번 %조사처리(CALLNAME:MASTER,"는")% 놀라게 되었다.
		ELSE
			PRINTFORMDL 배를 쓰다듬기 위해 마유미의 갑옷을 벗으려고 시도했다.
			IF TALENT:恋慕 || TALENT:思慕
				PRINTFORMDW 시행착오 끝에 갑옷을 벗고 무방비해진 마유미의 배를 쓰다듬자 이상한 성취감이 가슴에 퍼졌다...!
			ELSE
				PRINTFORMDW 마유미의 배를 쓰다듬으려 했으나, 갑옷을 벗는 방법을 몰라 포기했다...
			ENDIF
		ENDIF
		;怒り
	ELSEIF CFLAG:318 == 1
		PRINTFORML 「뭐지? 팔을 잘려나가길 바라는 거야?」
		PRINTFORMDW 마유미에게 닿으려고 손을 뻗자 노려보았다...
	ELSEIF TALENT:妊娠
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「더, 만져줘...♪ 이 아이도 기뻐할 거야... HPH」","L"
					PRINTFORMDW 마유미의 배에 손을 대자, 희미한 태동이 돌아왔다.
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%, 네가 이 아이의 이름 지어주는 사람이 되는 거야」
					PRINTFORML 「이 아이에게 어울리는, 좋은 이름을 생각해 줘...♪」
					PRINTFORMDW 마유미의 배를 쓰다듬으며, 두 사람은 태어날 아이에게 마음을 두었다.
				CASE 2
					PRINTFORML 「후후……♪」
					PRINTFORML 「…응? 아, 미안해… 무슨 이야기였지?」
					PRINTFORMDW 마유미는 어머니답게 애틋한 표정으로 자신의 배를 쓰다듬고 있다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...이 아이에게 죄는 없어... 이 아이에게 죄는 없어...」
					PRINTFORMDW 마유미는 공허한 눈으로 자신의 배를 쓰다듬고 있다...
				CASE 1
					PRINTFORML 「―그만둬! 나에게 손대지 마!!」
					PRINTFORML 「…아앗…!? 미, 미안해…… 괜찮아?」
					PRINTFORMDW 마유미의 배로 손을 뻗었으나, 세게 밀쳐졌다…….
				CASE 2
					PRINTFORML 「...케이키님은, 어째서 내가 아이를 가질 수 있도록 하신 걸까?」
					PRINTFORML 「미안해... 너에게 묻는 게 당연한 일이지...」
					PRINTFORMDW 마유미는 자신의 배를 쓰다듬으며 이야기하고 있지만, 그 눈이 어디를 보고 있는지 알 수 없다...
			ENDSELECT
		ENDIF
	ELSEIF EX:膣内精液 >= 1000
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...우으...! 배가, 이렇게나 뜨겁다...」
			CASE 1
				CALL HPH_PRINT,@"「……정말이지……!……사정 너무 많이 했잖아, 바보 같아…… HPH」","L"
			CASE 2
				PRINTFORML 「배 속이... 뭔가 이상한 느낌이다...」
		ENDSELECT
		PRINTFORMDW 마유미의 배는 %조사처리(CALLNAME:MASTER,"의")% 대량의 정액으로 부풀어 있다……
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「전부터 생각하고 있었지만... 배를 쓰다듬는 게 그렇게 즐거운 건가?」
			CASE 1
				PRINTFORML 「너에게만 알려주지만... 이 갑옷, 사실 조금 틈이 있단다」
				CALL HPH_PRINT,@"「자... 여기야... ♪ 네 손 정도는 들어가겠지...? HPH」","L"
				PRINTFORMDW 예전에는 눈치채지 못했던 갑옷의 틈새로 손을 넣어, 마음껏 마유미의 배를 쓰다듬었다...!
			CASE 2
				PRINTFORML 「또 갑옷을 닦아줄 거야? 꼭 부탁할게♪」
				PRINTFORML 「네가 닦아주면, 정말 예뻐질 테니까!」
				PRINTFORMDW 마유미의 갑옷을 천으로 정성껏 닦았다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「또 배를 쓰다듬는 거야...? 너 정말 좋아하는구나...♪」
			CASE 1
				PRINTFORML 「하, 배인가!? 좋...좋아...!」
				PRINTFORMDW 어째선지 긴장하고 있는 마유미의 배를 쓰다듬었다.
			CASE 2
				PRINTFORML 「...저, 저기...!」
				PRINTFORML 「만족하면 바로 달아줄 테니까...!」
				PRINTFORMDW 마유미는 갑옷을 조금 벗고 배를 직접 쓰다듬어 주었다.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「왜 그렇게 배를 쓰다듬는 거야...?」
			CASE 1
				PRINTFORML 「배를 쓰다듬고 싶다고?... 뭐, 상관없지만」
				PRINTFORMDW 마유미의 배를 쓰다듬었지만, 갑옷의 감촉뿐이다...
			CASE 2
				PRINTFORML 「오오, %CALLNAME:MASTER%. 갑옷을 닦아 주는 건가?」
				PRINTFORML 「고맙긴 한데… 어째서 그렇게 슬픈 얼굴을 하고 있는 거야?」
				PRINTFORMDW 마유미의 갑옷은 손가락 하나 들어갈 틈 없이 그녀를 지키고 있다…….
		ENDSELECT
		;陥落無し
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...뭐 하는 거야?」
				PRINTFORMDW 배를 쓰다듬어지자 마유미는 의아한 표정을 짓는다...
			CASE 1
				PRINTFORML 「뭐...?! 뭘 하는 거야!?」
				PRINTFORMDW 배를 쓰다듬으려고 했더니 혼나버렸다...
			CASE 2
				PRINTFORML 「뭐지? 갑옷이 신경 쓰이나?」
				PRINTFORML 「이 갑옷은 세라믹으로 만들어져 있어서... 이봐, 듣고 있나!?」
				PRINTFORMDW 갑옷에 가로막혀 배를 쓰다듬을 수 없다...
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
