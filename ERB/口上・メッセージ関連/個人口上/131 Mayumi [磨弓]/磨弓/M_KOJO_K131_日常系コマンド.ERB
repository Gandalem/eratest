@M_KOJO_MESSAGE_COM_K131_350_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR 0xC39143
	IF FLAG:時間停止
		PRINTFORMDW 인형처럼 움직이지 않는 마유미를 밀어 눕히고, 몸을 덮쳤다...!
	ELSEIF TFLAG:194
		SELECTCASE TFLAG:194
			;人目がある
			CASE 1
				PRINTFORML 「저, 저기...! 여기서 사람들에게 보이면 안 돼...!」
				PRINTFORMDW 마유미는 타인에게 정사를 들키고 싶지 않은 듯하다...
				;野外は嫌でござりまする
			CASE 2
				PRINTFORML 「뭐...!? 무슨 생각을 하고 있는 거야! 여긴 바깥이라고!」
				PRINTFORMDW 밖에 있는 건 안 되는 모양이야...
				;多人数プレイは勘弁
			CASE 3
				PRINTFORML 「이런 걸 하는 건, 그게…」
				PRINTFORML 「…너하고만 하고 싶어…」
				PRINTFORMDW 마유미는 고개를 숙인 채 작게 중얼거렸다…
				;合意があってもムードが足りぬ
			CASE 4
				PRINTFORML 「미안하지만, 지금은 그런 기분이 아니야」
				PRINTFORMDW 분위기를 좀 더 만들 필요가 있을 것 같다...
		ENDSELECT
	ELSEIF TCVAR:抱き寄せ初回
		SELECTCASE TCVAR:抱き寄せ初回
			;普通に合意ゲット
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%... 그, 뭐야...」
				CALL HPH_PRINT,@"「오, 부드럽게 부탁한다...? HPH」","L"
				PRINTFORMDW 마유미는 긴장하면서도 %조사처리(CALLNAME:MASTER,"에게")% 몸을 맡겼다...!
				;先にキスぐらいしろよ
			CASE 2
				PRINTFORML 「나도 그다지 자세히는 모르지만... 이런 건 키스부터 하는 게 우선 아닌가?」
				CALL HPH_PRINT,@"「응!? 쪽... HPH... 정말, 너 같은 녀석은... ♪」","L"
				PRINTFORMDW 말한 대로 키스하자, 마유미는 어이없다는 듯 웃었다.
				;媚薬or発情には勝てなかったよお…
			CASE 3
				CALL HPH_PRINT,@"「크윽... HPH 이 자식...! 약에 의지하다니...! 비겁한 녀석 같으니...」","L"
				CALL HPH_PRINT,@"「나중에... 기억해라...! HPH」","L"
				PRINTFORMDW 약효가 있는 사이, 마유미에게 빠르게 덮쳐버렸다...!
				;悔しい…刻印さえなければﾋﾞｸﾋﾞｸﾝ
			CASE 4
				PRINTFORML 「큭...! 이제 됐어... 마음대로 해...!」
				PRINTFORMDW 마유미는 저항을 포기한 듯했다...!
				;強引に迫られると断れぬ(素質臆病持ち専用)
			CASE 5
				;まんざらでもない
			CASE 6
				PRINTFORML 「뭐, 뭐야 %CALLNAME:MASTER%!?」
				PRINTFORML 「나에게 뭘 하려는 거야...?」
				PRINTFORMDW 놀라는 마유미의 눈에는 희미하게 기대감이 보였다...!
				;駄目
			CASE 7
				PRINTFORML 「야, 뭐 하는 거야! 떨어져!」
				PRINTFORMDW 마유미에게 밀쳐졌다...
				;論外
			CASE 8
				PRINTFORML 「흥!」
				PRINTFORML 「기습이라면, 좀 더 잘하는 거겠지」
				PRINTFORMDW 마유미를 밀어붙이려 했으나, 역공당했다...
		ENDSELECT
	ELSEIF TALENT:妊娠
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「…배 속의 아이에게 해가 될 테니, 적당히만…?」 HPH","L"
				CASE 1
					CALL HPH_PRINT,@"「정말... 내가 임신했어도 상관없나? HPH」","L"
				CASE 2
					PRINTFORML 「하는 건 상관없지만... 이 아이는 괜찮을까...?」
			ENDSELECT
			PRINTFORMDW 배가 불룩한 마유미를 배려하듯, 살짝 눕혔다.
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...적당히」
				CASE 1
					PRINTFORML 「아아... 하고 싶은 대로 해줘...」
				CASE 2
					PRINTFORML 「...적당히」
			ENDSELECT
			PRINTFORMDW 마유미를 배려하는 듯, 살짝 덮쳤다.
		ENDIF
	ELSEIF TALENT:恋人
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「후후...♪ 오늘은 %조사처리(CALLNAME:MASTER,"가")% 위에 있을까? HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「오늘이야말로, 너를 속이도록 만들어주마... HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 밀쳐지면서도, 마유미는 요염하게 미소 지어 보였다...!
			CASE 2
				PRINTFORML 「벌써 그런 기분이 들었나?」
				CALL HPH_PRINT,@"「...뭐, 나도 그래... HPH」","L"
				PRINTFORMDW 마유미에게 천천히 덮쳐갔다...!
			CASE 3
				CALL HPH_PRINT,@"「아무옷 HPH츄HPH츄푸HPH쿠츄HPH럴우웃 HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 밀쳐져도 동요하지 않고, 마유미는 혀를 얽어왔다...!
			CASE 4
				CALL HPH_PRINT,@"「응! 하으윽」","L"
				PRINTFORML 「세... 선수를 당했지만, 오늘은 지지 않겠어!」
				PRINTFORMDW 마유미도 지지 않고, %조사처리(CALLNAME:MASTER,"의")% 몸에 다가왔다...!
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「뭐, 또 할 거야!?」
				CALL HPH_PRINT,@"「부... 부드럽게 해줘, 부탁이다...? HPH」","L"
				PRINTFORMDW 마유미도 그럴 기분이 된 것 같다...!
			CASE 1
				PRINTFORML 「으윽...! 이, 이봐...! 좀 더 부드럽게...」
				PRINTFORMDW 기세에 맡기고 밀쳐 넘어뜨린 마유미를 걱정하며 천천히 몸을 덮쳤다...
			CASE 2
				PRINTFORML 「잠, 잠시만 기다려 줘! 마음의 준비라는 게...」
				CALL HPH_PRINT,@"「앗♪츄...흐읍! HPH츄푸HPH파...HPH」","L"
				PRINTFORMDW 기세에 맡겨 밀어붙여 버린 마유미를 염려하며, 천천히 덮쳤다...
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...이런 일은 서로 사랑하는 사이가 하는 것 아닌가?」
			CASE 1
				PRINTFORML (이 행동에 의미가 있는 걸까...?)
			CASE 2
				PRINTFORML 「아, 알겠어...」
		ENDSELECT
		PRINTFORMDW 마유미는 저항하지 않았지만, 그다지 의욕이 없어 보인다...
	ENDIF
ENDIF
RETURN 1
