	ELSEIF CFLAG:MASTER:初期位置 == CFLAG:131:初期位置 && CFLAG:MASTER:現在位置 == CFLAG:131:初期位置
		;川の字で寝る
		IF TFLAG:193 == 1
			SELECTCASE RAND:3
				CASE 0
