@M_KOJO_SUCCESS_COM_K131_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K131_301
RETURN 0

@M_KOJO_MESSAGE_COM_K131_301
CALL M_KOJO_MESSAGE_COM_K131_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K131_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「차인가. 마시겠다」
		PRINTFORML 「...만약을 위해 말해두지만, 나에게 독 같은 건 통하지 않아?」
		PRINTFORMDW 마유미는 그렇게 말한 뒤, %조사처리(CALLNAME:MASTER,"가")% 우려낸 차를 마셨다……
	ELSEIF CFLAG:318 == 1
		PRINTFORML 「미안하지만, 지금은 필요 없어...」
		PRINTFORMDW 마유미는 차를 마실 기분이 아닌 듯하다...
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「...음...이건...」
				PRINTFORMDW 입에 맞지 않았던 것인지, 마유미는 얼굴을 찡그리고 있다...
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%, 차가 식어버렸잖아」
				PRINTFORML 「너답지 않구나, 무슨 고민이라도 있니?」
				PRINTFORMDW 마유미가 걱정스러운 표정을 지었다……
			CASE 2
				PRINTFORML 「...이 차, 절대로 케이키님께 드릴 생각은 하지 마라?」
				PRINTFORMDW 마유미에게 이번의 차는 그다지 맛있지 않았던 것 같다...
			CASE 3
				PRINTFORML 「…우으…!」
				PRINTFORML (솔직히 이건… 하지만, 정성껏 내려준 걸 무시할 수는 없잖아…)
				PRINTFORMDW 마유미는 차를 홀짝이며 마셨다. 맛이 없었을지도 모른다…
			CASE 4
				PRINTFORML 「우왓!? 괜찮아!?」
				PRINTFORML 「아아, 나는 괜찮지만... 너 의외로 허둥대는구나...」
				PRINTFORMDL 깜빡하고 차를 쏟아버렸고, 마유미의 손에 닿아 버렸다.
				PRINTFORMDW 꽤 뜨거웠을 텐데, 마유미는 태연하다…….
		ENDSELECT
	ELSEIF TFLAG:193 == 0
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「아, 고마워. 받을게」
				PRINTFORMW 「...응. 맛있다...♪」
			CASE 1
				PRINTFORML 「즈즈... 하아... 맛있다...♪」
				PRINTFORMDL 상당히 뜨겁게 우려낸 차를 마유미는 맛있게 마시고 있다.
				PRINTFORMDW 토속 조각상답게, 열에는 강한지도 모른다...
			CASE 2
				PRINTFORML 「후우……잘 먹었다. 맛있는 차였어」
				PRINTFORMDW 마유미는 %CALLNAME:MASTER%로부터 건네받은 차를 받아 단숨에 들이켰다.
			CASE 3
				PRINTFORML 「고마워. %CALLNAME:MASTER%도 같이 마실래?」
				PRINTFORMDW 마유미의 것과 같은 차를 우려내고 한숨 돌렸다.
			CASE 4
				PRINTFORML 「음...」
				PRINTFORML (또 %조사처리(CALLNAME:MASTER,"가")% 차를 우려내는 순간을 놓쳐버렸다...)
				PRINTFORMDW 마유미는 어려운 표정으로 차를 마시고 있다...
		ENDSELECT
	ELSE
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「봐라 %CALLNAME:MASTER%! 차나무가 토테미 신사의 모양을 하고 있다!」
				PRINTFORML 「...하하핫♪ 농담이야...♪」
				PRINTFORMDW 드물게 마유미에게 놀림을 받았다. 꽤 기분이 좋은 모양이다...
			CASE 1
				PRINTFORML 「맛있다...♪」
				PRINTFORML 「...내가 이 정도 맛있는 차를 우릴 수 있다면, 케이키님께서 기뻐하실까...?」
				PRINTFORMDW 다음에 마유미에게 차 우리는 법을 가르쳐 주는 것도 좋을지도 모른다.
			CASE 2
				PRINTFORML 「오, 차인가! 고마워!」
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 정말 배려심이 깊네...♪」
			CASE 3
				PRINTFORML 「맛있다!」
				PRINTFORML 「%CALLNAME:MASTER%, 리필 좀 받을 수 있겠어?」
				PRINTFORMDW 마유미의 것과 같은 차를 우려 한숨을 돌렸다.
			CASE 4
				PRINTFORML 「오오...! 찻잔이 하니와 모양으로 되어 있네...♪」
				PRINTFORMDW 우연히 발견한 물건이었지만, 마유미는 대단히 마음에 들어 한 것 같다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
