@M_KOJO_MESSAGE_COM_K131_307_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止中
	IF FLAG:70
		PRINTFORMDL 인형처럼 움직이지 않는 마유미의 뺨을 손가락으로 집어 가지고 놀았다.
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 알고 있는 조각상과는 전혀 다른, 극도로 사람의 피부에 가까운 감촉이다……
		;睡眠中
	ELSEIF CFLAG:睡眠
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...으응~...! 그만둬 주세요... 케이키님~!」
			CASE 1
				PRINTFORML 「……응응……!」
			CASE 2
				PRINTFORML 「...그만둬어...!」
		ENDSELECT
		PRINTFORMDW 마유미는 얼굴을 찌푸리고 있지만, 일어날 기색은 없다.
		;怒り
	ELSEIF CFLAG:318 == 1
		PRINTFORML 「…………。」
		PRINTFORMDW 마유미가 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다. 함부로 만지는 건 위험하다…….
		;通常
	ELSEIF TALENT:恋人
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「―훗!」
				PRINTFORML 「어때? 내가 더 빨랐잖아♪」
				PRINTFORMDW 마유미에게 뺨을 꼬집혔다.
			CASE 1
				PRINTFORML 「윽!?」
				PRINTFORML 「대단하네 %CALLNAME:MASTER%… 이번엔, 내 패배다…♪」
				PRINTFORMDW 마유미가 잡기 전에 그녀의 뺨을 잡아버렸다.
			CASE 2
				PRINTFORML 「즐거워 보이네, 너는...♪」
				PRINTFORMDW 마유미의 부드러운 볼을 손가락으로 집었다.
		ENDSELECT
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「...아직도 하는 거야!? 이제 그만두면 안 돼...!」
				PRINTFORMDW 볼을 꼬집히자 마유미는 부끄러워 보였다.
			CASE 1
				PRINTFORML 「...우으...! 이게 너라면, 때려눕히고 있을 곳이다...!」
				PRINTFORMDW 중얼거리는 마유미의 뺨을 꼬집어 놀았다.
			CASE 2
				PRINTFORML 「아, 저는 별로 괜찮아요!」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 뺨을 내밀자, 마유미는 고개를 격렬하게 좌우로 흔들었다.
		ENDSELECT
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「…%TEXTR("何をする/これには一体何の意味があるんだ")%？」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 볼을 만지면서도, 마유미는 침착하게 대응하고 있다.
			CASE 1
				PRINTFORML 「음... 네가 가끔 하는 이 행위는 뭐가 재미있는 건지 잘 모르겠네...」
				PRINTFORMDL 마유미에게 볼을 잡아, 꿈틀거리며 볼이 가지고 놀아졌다.
				PRINTFORMDW 힘 조절을 못하는 건지, 좀 아프다...
			CASE 2
				PRINTFORML 「어떠냐? 케이키님의 기술이 담긴 나의 살결은 멋지겠지!」
				PRINTFORMDW 마유미의 볼은 사람 피부와 다름없이 부드럽다. 어떻게 되어버린 걸까...?
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「우왓!? 갑자기 뭘 하는 거야!」
				PRINTFORML (역시, 저 개자식들의 계략인가...!? )
				PRINTFORMDL 흥미 본연에 마유미의 볼을 꼬집어 보았다.
				PRINTFORMDW 아주 잠깐 접촉했던 볼의 감촉은 사람 피부와 거의 흡사했다...!
			CASE 1
				PRINTFORML 「...너는 뭘 하고 싶은 거니...?」
				PRINTFORMDW 볼을 꼬집힌 마유미는 당황하고 있다……
			CASE 2
				PRINTFORML 「…………。」
				PRINTFORMDW 마유미가 경계하고 있기 때문에, 볼을 꼬집는 건 어려울 것 같다…….
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
