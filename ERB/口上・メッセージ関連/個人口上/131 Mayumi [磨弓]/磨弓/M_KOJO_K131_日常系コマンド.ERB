;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K131_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K131_300
RETURN 0

@M_KOJO_MESSAGE_COM_K131_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K131_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K131_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初回会話
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「...응? 하니와 병사에게 흥미가 있나?」
		PRINTFORMDL 마유미의 곁에 서 있는 하니와 병사와 눈(??)이 마주쳤다.
		PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 아는 하니와와 똑같이 어리숙한 표정을 하고 있지만, 가까이서 보니 묘한 위압감이 있다...
		PRINTFORML 「이 하니와 병사 역시 케이키님의 손에 의해 만들어진 것이다」
		PRINTFORML 「병장인 나의 지시에 따라 움직이는, 아주 우수한 병사들이다!」
		PRINTFORMDL "들"이라고 말하니, 아직 다른 사람들도 있을 것이다.
		PRINTFORMDW 얼마나 많은 수가 있는지 알 수 없지만, 그녀에게 손을 대는 것은 위험할지도 모른다...
		;怒り
	ELSEIF CFLAG:318 == 1
		PRINTFORML 「시끄럽다. 조용히 해라」
		PRINTFORMDW 마유미에게 말을 걸었더니 혼났다...
		;喋りすぎ
	ELSEIF TCVAR:302
		IF TALENT:恋慕 || TALENT:思慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...억지로 이야기하려고 하지 않아도 돼?」
					PRINTFORMDW 화제가 다 되어버렸다...
				CASE 1
					PRINTFORML 「……？」
					PRINTFORML 「미안. 잘 모르겠으니까, 하니와로 비유해 줄 수 없을까?」
					PRINTFORMDW 마유미는 고개를 기울이고 있었다……
				CASE 2
					PRINTFORMDL "싸움은 숫자야 마유미!"
					PRINTFORML 「아, 아아... 나도 그렇게 생각하지만... 갑자기 왜 그래?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 흉내 내기는, 마유미에게는 받아들여지지 않았다…….
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...후우...」
					PRINTFORMDW 마유미는 시시하다는 듯 이야기를 듣고 있다...
				CASE 1
					PRINTFORML 「...이야는 끝난 건가?」
					PRINTFORMDW 대화가 끊기면서 어색한 공기가 흘렀다...
				CASE 2
					PRINTFORML (아까부터 이상하게 달라붙는군... 역시 저들의 동료인가...?)
					PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"를")% 경계하고 있다...
			ENDSELECT
		ENDIF
		;酔っ払い時会話　磨弓は酒に強い
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「%CALLNAME:MASTER%괜찮아? 좀 너무 많이 마셨잖아...」
			CASE 1
				PRINTFORMW 「아직도 마시는 건가!? 그만두는 게 좋을 텐데……」
			CASE 2
				PRINTFORMW 「아, 알았어! 알았으니까 그렇게 대해오지 마!」
			CASE 3
				PRINTFORML 「자, %CALLNAME:MASTER%. 물이다」
				PRINTFORML 「그걸 마시고, 조금 취기를 가라」
				PRINTFORMDW 마유미에게서 물을 받아 단숨에 들이켰다.
			CASE 4
				PRINTFORMW 「도저히 지금의 %조사처리(CALLNAME:MASTER,"는")% 케이키님께 보여드릴 수 없어...」
		ENDSELECT
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「마시는 건 상관없지만, 적당히 해둬라?」
				PRINTFORMW 「"술은 마셔도 취해서 안 되느니라"」라는 것이다.
			CASE 1
				PRINTFORML 「나는 술에 강한 것 같네. 이 정도로는 취하지 않아」
				PRINTFORML 「크윽... 푸하아~! 맛있다!」
				PRINTFORMDW 마유미의 마시는 페이스는 정말 빠르다...!
			CASE 2
				PRINTFORMW 「위험하니까, 술병은 휘두르지 마라?」
			CASE 3
				PRINTFORMW 「어라? %CALLNAME:MASTER%, 술 잘 마시네!」
			CASE 4
				PRINTFORML 「음... 하아... ♪ 맛있네... ♪」
				PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 술을 마음에 들어 하는지, 맛있게 마시고 있다.
		ENDSELECT
	ELSEIF TALENT:恋人
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL MAYUMI_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL MAYUMI_KOIBITO
						CASE 1
							CALL MAYUMI_OTENKI
						CASE 2
							CALL MAYUMI_SEASON
						CASE 3
							CALL MAYUMI_FREETALK
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					CALL MAYUMI_FREETALK
				CASE 1
					CALL MAYUMI_KOIBITO
				CASE 2
					CALL MAYUMI_SEASON
				CASE 3
					CALL MAYUMI_OTENKI
				CASE 4
					;袿姫と遭遇済
					IF CFLAG:132:面識 == 1
						IF TALENT:132:恋人 || TALENT:132:恋慕
							PRINTFORML 「...%CALLNAME:MASTER%. 너랑 케이키님은...」
							PRINTFORML 「...말실수를 했어. 못 들은 걸로 해줘...」
							PRINTFORMDW 마유미는 어쩐지 기운이 없어 보인다...
						ELSE
							PRINTFORML 「%CALLNAME:MASTER%! 케이키님이 다음에 너를 모델로 한 조각상을 만들고 싶다고 해!」
							PRINTFORML 「당연히, 협력은 아끼지 않을 거지?」
							PRINTFORMDW 모델로만 사용되면 좋겠는데...
						ENDIF
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%. 케이키님이 너와 한 번 만나보고 싶다고 말씀하셨어」
						PRINTFORML 「나중에 같이 인사드리러 갈까?」
						PRINTFORMDW 마음이 동하면 가보자...
					ENDIF
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL MAYUMI_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL MAYUMI_RENBO
						CASE 1
							CALL MAYUMI_OTENKI
						CASE 2
							CALL MAYUMI_SEASON
						CASE 3
							CALL MAYUMI_FREETALK
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					CALL MAYUMI_FREETALK
				CASE 1
					CALL MAYUMI_RENBO
				CASE 2
					CALL MAYUMI_SEASON
				CASE 3
					CALL MAYUMI_OTENKI
				CASE 4
					;袿姫と遭遇済
					IF CFLAG:132:面識 == 1
						IF TALENT:132:恋人 || TALENT:132:恋慕
							PRINTFORML 「...%CALLNAME:MASTER%. 너랑 케이키님은...」
							PRINTFORML 「...말실수를 했어. 못 들은 걸로 해줘...」
							PRINTFORMDW 마유미는 어쩐지 기운이 없어 보인다...
						ELSE
							PRINTFORML 「%CALLNAME:MASTER%! 케이키님이 다음에 너를 모델로 한 조각상을 만들고 싶다고 해!」
							PRINTFORML 「당연히, 협력은 아끼지 않을 거지?」
							PRINTFORMDW 모델로만 사용되면 좋겠는데...
						ENDIF
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%. 케이키님이 너와 한 번 만나보고 싶다고 말씀하셨어」
						PRINTFORML 「나중에 같이 인사드리러 갈까?」
						PRINTFORMDW 마음이 동하면 가보자...
					ENDIF
			ENDSELECT
		ENDIF
	ELSEIF TALENT:思慕
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL MAYUMI_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL MAYUMI_SHIBO
						CASE 1
							CALL MAYUMI_OTENKI
						CASE 2
							CALL MAYUMI_SEASON
						CASE 3
							CALL MAYUMI_FREETALK
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					CALL MAYUMI_FREETALK
				CASE 1
					CALL MAYUMI_SHIBO
				CASE 2
					CALL MAYUMI_SEASON
				CASE 3
					CALL MAYUMI_OTENKI
				CASE 4
					;袿姫と遭遇済
					IF CFLAG:132:面識 == 1
						PRINTFORML 「%CALLNAME:MASTER%! 케이키님이 다음에 너를 모델로 한 조각상을 만들고 싶다고 해!」
						PRINTFORML 「당연히, 협력은 아끼지 않을 거지?」
						PRINTFORMDW 모델로만 사용되면 좋겠는데...
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%. 케이키님이 너와 한 번 만나보고 싶다고 말씀하셨어」
						PRINTFORML 「나중에 같이 인사드리러 갈까?」
						PRINTFORMDW 마음이 동하면 가보자...
					ENDIF
			ENDSELECT
		ENDIF
	ELSE
		IF FLAG:デート相手 == 113
			SELECTCASE RAND:2
				CASE 0
					CALL MAYUMI_NORMAL
				CASE 1
					CALL MAYUMI_OTENKI
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL MAYUMI_NORMAL
				CASE 1
					CALL MAYUMI_OTENKI
				CASE 2
					;袿姫と遭遇済
					IF CFLAG:132:面識 == 1
						PRINTFORML 「케이키님을 만난 것 같구나」
					ELSE
						PRINTFORML 「레이장원에 갈 거라면 나의 주인, 하니야스신 케이키 님께도 인사드리고 와라」
					ENDIF
					PRINTFORML 「...알고 있다고 생각하지만, 이상한 기분은 품지 마라?」
