				CASE 2
					PRINTFORML 「…………。」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 사념을 감지했는지, 튀어나온 조각상 병사들에게 두들겨 맞았다...
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
