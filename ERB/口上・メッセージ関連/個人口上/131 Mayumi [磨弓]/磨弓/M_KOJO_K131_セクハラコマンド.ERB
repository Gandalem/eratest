						CASE 3
							CALL HPH_PRINT,@"「후우...! 후읍...! ...크...으윽... HPH」","W"
					ENDSELECT
				ENDIF
				;激しく
			CASE 1
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「오오오옷 HPH HPH마아 HPH엣 HPH오쿠우 HPH오쿠 HPH아아아- HPH HPH」","L"
					CASE 1
						CALL HPH_PRINT,@"「히기잇 HPH HPH헤, 히잇 HPH HPH우옷 HPH구, 오오옷 HPH오, 호오옷 HPH HPH HPH」","L"
				ENDSELECT
				PRINTFORMDW 마유미는 항문을 격렬하게 범당하며, 동물 같은 소리를 내고 있다...!
				;ねっとりぃ
			CASE 2
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「후우... 흐읍! 후으, 어어...」","L"
					CASE 1
						CALL HPH_PRINT,@"「느, 느릿하게 움직여지면... HPH 형태가... 잘 알겠어아앗 HPH우, 오오... HPH HPH」","L"
				ENDSELECT
				PRINTFORMDW 천천히 허리를 움직이며, 마유미의 장내를 만끽했다...!
				;グラインド
			CASE 3
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「크윽! 흐으윽! 아아악! 흐읍 흐읍」","L"
						CALL HPH_PRINT,@"「엉덩이가 후후하고 엉덩이가 넓어진 우으윽」","L"
					CASE 1
						CALL HPH_PRINT,@"「오옷!? 허우허우, 정말 거칠게 비비네아아앗」","L"
				ENDSELECT
				PRINTFORMDW 허리를 크게 움직여, 마유미의 항문을 확장했다...!
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
