;330,スカートめくり
;TFLAG:193(-5=拒絶（ビンタ） -3=拒絶（つねり） -1=いやがる 0=いやがる（嬉しげ） 1=受け入れ)
;TFLAG:193=1&&ABL:露出癖(5以上=人目のある場所で、自らスカートをまくり上げる 4以下=人目のある場所でめくられるさいに弱い抵抗 3以上=人目のない場所で自らスカートをまくり上げる 3未満=弱い抵抗)
;TFLAG:400(1=デート先or地底のモブが反応する)
;後ろからピラリ、ではなく、前からペラって感じ（そうじゃなかったら、めくり上げようとするのを止めて即座にビンタとか無理、めくり上げられた後にしかならないしその状況ならビンタ食らうより普通に弾幕で一発ＫＯにならないほうがおかしい
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K131_330
RETURN 0

@M_KOJO_MESSAGE_COM_K131_330
CALL M_KOJO_MESSAGE_COM_K131_330_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K131_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;磨弓の場合は袴ずり下げになる（デフォルトの場合）
	IF FLAG:70
		;穿いてる
		IF TEQUIP:0 > 1
			PRINTFORMDW 마유미의 하카마를 내리고 속옷의 유무를 확인했다.
			;穿いてない
		ELSE
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 마유미의 하카마를 내리자, 있어야 할 속옷은 없었다...!
		ENDIF
	ELSEIF CFLAG:うふふ == 2
		CALL HPH_PRINT,@"「어때...? HPH 전부, 삽입했어... HPH」","W"
	ELSE
		SELECTCASE TFLAG:193
			;ビンタ
			CASE -5
				PRINTFORML 「―윽!!」
				PRINTFORMDW %TEXTR("마유미에게 세게 볼을 맞았/어디선가 달려온 조각상 병사에게 날아갔다")%...
				;つねられる
			CASE -3
				PRINTFORML 「...다음엔 없을 거라고 생각해라?」
				PRINTFORMDW %TEXTR("마유미에게 손을 세게/埴輪兵사에게 살이 찢기는 듯한 강도로")% 잡아당겨졌다...
				;嫌がる
			CASE -1
				PRINTFORML 「뭐, 무슨 속셈이야!?」
				PRINTFORMDW %TEXTR("磨弓は服を押さえて抵抗している/埴輪兵士が立ちはだかり、失敗に終わった")%…
				;嫌がる（嬉しげ）
			CASE 0
				PRINTFORML 「어, 저기...! 아무리 그래도 여기서는...!」
				PRINTFORMDW 마유미는 부끄러운 듯 옷을 움켜쥐고 있다.
				;成功
			CASE 1
				IF ABL:露出癖 <= 2
					;穿いてる
					IF TEQUIP:0 > 1
						PRINTFORML 「앗!? 뭐, 뭘 하는 거야!!」
						PRINTFORMDW 아주 잠깐, 마유미의 속옷이 보였다...!
						;穿いてない
					ELSE
						PRINTFORML 「...!? ...아...아...!」
						PRINTFORMDW 속옷을 입고 있지 않다는 것을 %조사처리(CALLNAME:MASTER,"에게")% 들켜, 마유미는 동요하고 있다...
					ENDIF
				ELSEIF ABL:露出癖 <= 4
					;穿いてる
					IF TEQUIP:0 > 1
						PRINTFORML 「나... 어째서 내가 이런 짓을 해야만 하는 거야...!」
						PRINTFORMDW 불평하면서도, 마유미는 속옷을 보여주었다...!
						;穿いてない
					ELSE
						PRINTFORML 「...나쁘냐!? 나도 좋아해서 이런 차림인 건 아니라고!!」
						PRINTFORMDW 울 것 같은 얼굴로 호소해 오는 마유미의 기세에 눌려, 무심코 사죄하고 말았다...
					ENDIF
				ELSE
					;穿いてる
					IF TEQUIP:0 > 1
						CALL HPH_PRINT,@"「자... 이걸로... 됐겠지...? HPH」","L"
						PRINTFORMDW 마유미는 조금 기쁜 듯, 속옷을 보여주었다...!
						;穿いてない
					ELSE
						CALL HPH_PRINT,@"「도와주세요... HPH 너무 빤히 쳐다보잖아요... HPH」","L"
						PRINTFORMDW 속옷을 입지 않은 마유미의 가랑이를 찬찬히 시간했다...!
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
