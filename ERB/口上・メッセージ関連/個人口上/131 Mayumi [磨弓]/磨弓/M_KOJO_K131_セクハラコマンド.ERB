@M_KOJO_MESSAGE_COM_K131_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDW 예술 작품에 뒤지지 않을, 마유미의 좋은 곡선의 엉덩이를 쓰다듬었다.
	ELSEIF CFLAG:睡眠
		CALL HPH_PRINT,@"「응...후푸...으...음...윽...후푸」","W"
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;クンニ強制
			CASE 70
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아, 흐읍... 이쪽이 아니야... 응응!」","W"
					CASE 1
						CALL HPH_PRINT,@"「야...! 엉덩이는 나중에 해... HPH」","W"
				ENDSELECT
				;アナル奉仕
			CASE 72
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응...후훗, 그렇게... 쓰다듬지 마...윽...후훗」","W"
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%…손질하는 손길이 야하구나…? HPH」","W"
				ENDSELECT
				;スカートの中を見せる
			CASE 35
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「앗 후후, 이 자식 정말 세구나... 후후」","W"
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%…손질하는 손길이 야하구나…? HPH」","W"
				ENDSELECT
				;素股
			CASE 52
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「엉덩이를 만지지 마... HPH 움직일 수 없잖아 HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「흐응! 조용히 있어... 흐으」","W"
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응...후훗, 그렇게... 쓰다듬지 마...윽...후훗」","W"
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%…손질하는 손길이 야하구나…? HPH」","W"
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「...이봐, 뭘 하고 있는 거야...?」
					PRINTFORMDW 마유미가 분노를 담은 표정으로 노려보고 있다...
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응! 하으윽」","L"
						CASE 1
							CALL HPH_PRINT,@"「꺅 HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「히아악 HPH」","L"
					ENDSELECT
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「오, 너라는 자는...!」
							PRINTFORMDW 마유미는 손으로 엉덩이를 가하며 얼굴을 붉히고 있다.
						CASE 1
							PRINTFORML 「바... 바보 같아!」
							PRINTFORMDW 마유미에게 머리를 맞았다...
						CASE 2
							PRINTFORML (어이! 여기선 맛없잖아...!)
							PRINTFORMDW 마유미가 부끄러운 듯 귓속말을 했다.
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응... HPH도... 더... 만져줬으면 해... HPH」","L"
							PRINTFORMDW 마유미가 애교를 부리듯 바라보고 있었다...!
						CASE 1
							CALL HPH_PRINT,@"「그, 그렇게... 만지지 마...」","L"
							PRINTFORMDW 말과는 달리, 마유미의 저항은 약하다.
						CASE 2
							CALL HPH_PRINT,@"(직접... 만져도, 괜찮다고...? HPH)","L"
							PRINTFORMDW 마유미가 조금 부끄러워하며 귀에 속삭였다...!
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「...너는 뭘 하고 있는 거냐?」
					PRINTFORMDW 성희롱을 하려고 다가갔더니, 옆에 있던 조각상 병사에게 팔을 붙잡혔다...
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응! 하으윽」","L"
						CASE 1
							CALL HPH_PRINT,@"「꺅 HPH」","L"
						CASE 2
							CALL HPH_PRINT,@"「히아악 HPH」","L"
					ENDSELECT
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「...무슨 짓을 하는 거야!」
							PRINTFORMDW 마유미는 몹시 부끄러웠는지, 힘주어 머리를 때렸다...
						CASE 1
							PRINTFORML 「...너무 기세등등해지지 마...!」
							PRINTFORMDW 마유미에게 노려졌다...
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「...언제까지 만지고 있는 거야...!」
							PRINTFORMDW 마유미의 목소리에는 분노가 담겨 있었다.
						CASE 1
							PRINTFORML 「...윽!!」
							IF TALENT:132:恋人 || TALENT:132:恋慕
								PRINTFORML (케이키님의 연인이 아니었다면, 단칼에 끝내버릴 수 있을텐데...!)
							ELSE
								PRINTFORML (이 녀석, 기세등등해져서...!)
							ENDIF
							PRINTFORMDW 마유미는 입술을 깨물면서, %조사처리(CALLNAME:MASTER,"의")% 성희롱을 받아들이고 있다...
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
