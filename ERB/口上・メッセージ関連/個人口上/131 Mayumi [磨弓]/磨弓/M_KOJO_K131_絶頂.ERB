IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			SELECTCASE RAND:4
				CASE 1
					CALL HPH_PRINT,@"「아아앗 HPH HPH HPH」","W"
				CASE 2
					CALL HPH_PRINT,@"「음응! 흐으... 후우... 윽...... 흐으 흐으」","W"
				CASE 3
