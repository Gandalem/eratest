				CASE 5
					CALL HPH_PRINT,@"「~~~~흡 흡 흡 아...흡 아아...흡」","W"
			ENDSELECT
			;中
		CASE 2 TO 4
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「앗...후우 후우음...응, 아...후우 후우」","W"
				CASE 1
					CALL HPH_PRINT,@"「음응 흐읍 흐읍 ...후...음응...흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「아...윽 HPH HPH는, 후우...윽...HPH」","W"
				CASE 3
					CALL HPH_PRINT,@"「응! 흐으읍...흐윽...흐읍 흐읍」","W"
			ENDSELECT
			;弱
		CASE 1
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「앗...후우 후우음...응, 아...후우 후우」","W"
				CASE 1
					CALL HPH_PRINT,@"「음응 흐읍 흐읍 ...후...음응...흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「아...윽 HPH HPH는, 후우...윽...HPH」","W"
				CASE 3
					CALL HPH_PRINT,@"「응! 흐으읍...흐윽...흐읍 흐읍」","W"
			ENDSELECT
	ENDSELECT
ENDIF
;-------------------------------------------------
;あなたが射精したときに関する口上の表示
;一時的にTARGETを口上主に設定している
;-------------------------------------------------
;==================================================
;Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
