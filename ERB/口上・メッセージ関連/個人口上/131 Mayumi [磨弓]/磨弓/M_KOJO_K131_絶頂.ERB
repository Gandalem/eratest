;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂強度。まず0~3が割り当てられ、多重絶頂により最大16倍される。つまり単部位なら最大3、5重絶頂で最大48
;NOWEX:TotalEX
;多重絶頂補正を受ける前の各部位絶頂強度の合計値。1~15。このテンプレにおける分岐の基準。
;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。
;SYNCED_ORGASM(TARGET)
;相手とあなたが同時に絶頂した場合真となる。絶頂の部位は問わない。
;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_B_K131
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_B_K131
#DIM TotalEX
;-------------------------------------------------
;噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:噴乳
	CALL HPH_PRINT,@"「응, 흐윽... 으윽... 하아」","W"
ENDIF
;-------------------------------------------------
;射精した
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:射精
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「아아아아아악! 후우후우후우」","W"
				CASE 1
					CALL HPH_PRINT,@"「아앗 HPH HPH히, 아아아아앗 HPH HPH HPH」」","W"
				CASE 2
					CALL HPH_PRINT,@"「히으윽! HPH HPH HPH」","W"
				CASE 3
					CALL HPH_PRINT,@"「우아앗 HPH HPH앗 HPH 아아아아앗 HPH HPH HPH」","W"
				CASE 4
					CALL HPH_PRINT,@"「~~헉 큭 큭 큭인가... 하... 큭 큭」","W"
			ENDSELECT
			;弱
		CASE 1 TO 4
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「응 응! 흐으... 끄윽!」","W"
				CASE 1
					CALL HPH_PRINT,@"「응! 흐읍... 후우... 흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「아앗 후후 후우... 앗... 후후 후우」","W"
				CASE 3
					CALL HPH_PRINT,@"「으윽... HPH 아앗... HPH 아아... HPH」","W"
				CASE 4
					CALL HPH_PRINT,@"「크윽...후후후히...앗...후후후」","W"
			ENDSELECT
	ENDSELECT
ENDIF
;-------------------------------------------------
;放尿
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && NOWEX:放尿
	PRINTFORMW 「아...!! 그만둬... 보지 마!」
ENDIF
;-------------------------------------------------
;絶頂
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
;合計絶頂数で分岐
;これだけではどの部位が絶頂したかは区別されないため、書き分けたければ任意で分岐を加筆されたし
IF LOCAL
	SELECTCASE NOWEX:TotalEX
		;強
		CASE 5 TO 15
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「아아아아아악! 후우후우후우」","W"
				CASE 1
					CALL HPH_PRINT,@"「아앗 HPH HPH히, 아아아아악 HPH HPH HPH」」","W"
				CASE 2
					CALL HPH_PRINT,@"「히으윽! HPH HPH HPH」","W"
				CASE 3
					CALL HPH_PRINT,@"「우아앗 HPH HPH앗 HPH 아아아아앗 HPH HPH HPH」","W"
				CASE 4
					CALL HPH_PRINT,@"「~~헉 큭 큭 큭인가... 하... 큭 큭」","W"
			ENDSELECT
			;弱
		CASE 1 TO 4
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「응 응! 흐으... 끄윽!」","W"
				CASE 1
					CALL HPH_PRINT,@"「응! 흐읍... 후우... 흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「아앗 후후 후우... 앗... 후후 후우」","W"
				CASE 3
					CALL HPH_PRINT,@"「으윽... HPH 아앗... HPH 아아... HPH」","W"
				CASE 4
					CALL HPH_PRINT,@"「크윽...후후후히...앗...후후후」","W"
			ENDSELECT
	ENDSELECT
ENDIF
;-------------------------------------------------
;奴隷の睡眠絶頂時の口上
;-------------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_PALAMCNG_MESSAGECHECK_B2_K131
RETURN 0

@M_KOJO_MESSAGE_PALAMCNG_B2_K131
;-------------------------------------------------
;睡眠噴乳
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
