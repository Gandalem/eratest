;40,ローター
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K131_40
RETURN 0

@M_KOJO_MESSAGE_COM_K131_40
CALL M_KOJO_MESSAGE_COM_K131_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K131_40_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「응흥! 흐읍 흐읍 아악, 으윽!」","L"
				PRINTFORML 「하... 부탁해...! 조금만 더... 약하게 해줘...」
				PRINTFORMDW 마유미는 로터를 질 안에 넣은 채, 연약하게 간청해 왔다...!
			CASE 1
				CALL HPH_PRINT,@"「응... 흐읍... 흡! 아앗, 크윽...!」","L"
				CALL HPH_PRINT,@"「코... 이런 기계 따위에... HPH 내가, 지는... 건가아...!! HPH」","L"
				PRINTFORMDW 마유미는 로터가 가져오는 쾌감에 저항하고 있다.
			CASE 2
				PRINTFORML 「...이봐...!」
				PRINTFORML 「예전 같으면 괜찮았겠지만, 엉덩이는 그만두라고...!」
				PRINTFORMDW 애널에 로터를 넣으려 했더니 노려졌다...
			CASE 3
				PRINTFORML 「말... 기다려! 거긴—」
				CALL HPH_PRINT,@"「히야아아악!! 하프 하프 하프」","L"
				PRINTFORMDW 클리토리스에 로터를 갖다 대자, 마유미의 몸이 튀어 올랐다.
			CASE 4
				CALL HPH_PRINT,@"「히익 HPH HPH 유두... 으... HPH 떨려아... 큭 HPH HPH」","L"
				PRINTFORMDW 마유미의 유두에 로터를 밀어붙였다.
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
