@M_KOJO_EVENT_K131_20(ARG,ARG:1)
;口上主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1 ;custom code
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:うふふ
			;うふふ中に眠くて帰る
			PRINTFORML 「뭐라고!? 벌써 이렇게 시간이 됐나!」
			PRINTFORML 「%CALLNAME:MASTER%, 계속은 기다려줘!」
			PRINTFORMDW 마유미는 옷을 정돈하고, 황급히 돌아갔다...
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「저기, %CALLNAME:MASTER%…나랑 레이초원에…」
			PRINTFORML 「…아무것도 아니야! 또 내일 보자…♪」
			PRINTFORMDW 마유미는 조금 쓸쓸해하며 돌아갔다.
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%. 이번에는 레이초원에 놀러 오면 좋겠어.」
			IF TALENT:132:恋慕 || TALENT:132:思慕
				PRINTFORML 「케이키님도 분명 기뻐하실 거야♪」
			ELSE
				PRINTFORML 「그때는 내가 안내해 주겠다♪」
			ENDIF
			PRINTFORMDW 마유미와 손을 흔들며 헤어졌다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート中帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:うふふ
			PRINTFORML 「뭐라고!? 벌써 이렇게 시간이 됐나!」
			PRINTFORML 「%CALLNAME:MASTER%, 계속은 기다려줘!」
			PRINTFORMDW 마유미는 옷을 정돈하고, 황급히 돌아갔다...
		ELSEIF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「고마워 %CALLNAME:MASTER%! 오늘은 정말 즐거웠어♪」
			PRINTFORML 「다음에도 또, 불러줘!」
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 오늘은 즐거웠어. 또 불러줘」
		ENDIF
		PRINTFORMDW 마유미와 손을 흔들며 헤어졌다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;玄関先でお見送り（キャラの自宅位置、またはキャラの部屋でデート終了）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:132:面識 == 1
			PRINTFORML 「%CALLNAME:MASTER%, 케이키님을 만나지 않으시나요?」
		ELSE
			PRINTFORML 「기다려 %CALLNAME:MASTER%. 케이키님께 인사부터...」
		ENDIF
		PRINTFORMDW 또 다음에 보자고 말하고 마유미와 헤어졌다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;デート終了時に部屋に来ないかと誘う（～から部屋に来ないかと誘われた）
	;（来訪キャラのみ,自宅が無いキャラでも発生します）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			PRINTFORML 「%CALLNAME:MASTER%, 이제 레이초원에 오지 않겠어?」
			PRINTFORML 「케이키님도, 너라면 정말 환영이라고 말씀하셨을 거야♪」
			PRINTFORMDW 마유미의 유혹을 받아들일까...?
		ELSEIF TALENT:恋慕
			PRINTFORML 「저... 저기, %CALLNAME:MASTER%!」
			PRINTFORML 「같이 레이초원에 가지 않을래?」
			PRINTFORML 「...그게... 맞아! 그쪽이 케이키님도 기뻐하실 거야...♪」
			PRINTFORMDW 아무래도 마유미는 같이 와주었으면 하는 모양이다.
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 이제부터 시간은 있나?」
			PRINTFORML 「케이키님이, 너를 보고 싶다고 하셨는데…」
			PRINTFORMDW 마유미의 유혹을 받아들일까...?
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;部屋に来ないか→「行く」を選択（～に誘われるまま、【MASTER】は【TARGET】の部屋へと向かった……）
	;（これが発生すると十中八九押し倒されます）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			CALL HPH_PRINT,@"「즉답인가...♪ 네 그런 점이 좋은 거야... HPH」","L"
		ELSEIF TALENT:恋慕
			PRINTFORML 「그... 그렇구나! 좋아...♪」
		ELSE
			PRINTFORML 「좋아! 그렇게 정해졌다면...」
		ENDIF
		PRINTFORMDL 마유미가 휘파람을 불자, 어디선가 말 모양의 토테미가 나타났다.
		PRINTFORML 「자 타라! 떨어지지 않도록 나한테 단단히 붙어 있는 거다?」
		PRINTFORMDW 마유미의 말 모양 토테미를 타고 레이초원으로 향했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;部屋に来ないか→「やめとく」を選択（～は心なしか寂しそうだ……）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORML 「뭐라고!? 연인보다 더 중요한 용무가 있다는 거냐!?」
		ELSEIF TALENT:恋慕
			PRINTFORML 「...그렇구나...」
		ELSE
			PRINTFORML 「흠... 그렇구나...」
		ENDIF
		PRINTFORMDW 유혹을 거절당해서, 마유미는 외로워 보인다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今夜は帰りたくないと言い出す（～は今夜は帰りたくないと言い出した…）
	;（来訪キャラの帰宅時に欲求不満と欲望が高いと発生）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:恋人 || TALENT:恋慕
			CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"는")% 오늘 밤, 너와 함께 있고 싶어... HPH」","L"
			PRINTFORML 「...안 되는 건가...?」
			PRINTFORMDW 마유미는 아직 돌아가고 싶지 않은 것 같다...
		ELSE
			PRINTFORML 「마유미가 휘파람을 불자, 어디선가 말 모양의 토우가 나타났다.」
			PRINTFORML 「오늘 밤은 너를 호위하러 가려고 하는데, 괜찮겠어?」
			PRINTFORMDW 마유미는 아직 돌아갈 생각은 없는 듯했다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今夜は帰りたくない→「泊める」を選択（～は【MASTERの自室】に泊まっていくことになりました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		IF TALENT:恋人
			CALL HPH_PRINT,@"「후...♪ 너라면 그렇게 말해줄 거라고 생각하고 있었어... HPH」","L"
			PRINTFORMDW 오늘 밤은 마유미와 보내기로 했다...!
		ELSEIF TALENT:恋慕
			CALL HPH_PRINT,@"「그, 그렇구나!... 고마워... HPH」","L"
			PRINTFORMDW 오늘 밤은 마유미와 보내기로 했다...!
		ELSE
			PRINTFORML 「좋아! 그렇게 결정되었다면... 조각상 병사들!」
			PRINTFORML 「%CALLNAME:MASTER%, 잠시만 기다려 줘. 이들에게 지시를 내면 바로 갈게.」
			PRINTFORMDW 오늘 밤은, 마유미나 조각상 병사들과 함께 보내게 될 것 같다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今夜は帰りたくない→「泊めない」を選択、または家主が居る（【MASTER】は丁重に断った）
	;（家主が居る＝MASTERの私室に他のキャラの私室を設定している）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF TALENT:恋人
			PRINTFORML 「...내가 있으면 안 좋은 일이라도 있는 건가?」
			PRINTFORMDW 마유미는 의심의 시선을 보내고 있다...
		ELSEIF TALENT:恋慕
			PRINTFORML 「……그렇구나……」
			PRINTFORMDW 유혹을 거절당하고, 마유미는 외로워 보인다...
		ELSE
			PRINTFORML 「어, 이봐 기다려! 무슨 일이 생기고 나서서는 너무 늦는다구!?」
			PRINTFORMDW 그 후에도 마유미가 포기할 때까지 잠시 동안 말다툼이 이어졌다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;疲れて帰宅（疲れきった～は帰って行きました）
	;（～は疲れ切っている→（入り口）まで送るよ でも発生）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		IF CFLAG:うふふ
			;うふふ中に疲れて帰る
			PRINTFORML 「미, 미안해 %CALLNAME:MASTER%... 이 이상은...!」
			PRINTFORMDW 무척 피곤했는지 마유미는 하니와병에게 실려 돌아갔다...
		ELSE
			PRINTFORML 「마... 맛없어... 이대로는...」
			PRINTFORML 「미안해 %CALLNAME:MASTER%...! 이 보답은... 반드시...!」
			PRINTFORMDW 심하게 지쳤는지, 마유미는 하니와병에게 실려 돌아갔다...
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
