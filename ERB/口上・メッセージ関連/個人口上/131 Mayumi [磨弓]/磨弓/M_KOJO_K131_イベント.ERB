			IF ARG:2
				;時間停止して回避
				PRINTFORML 
			ELSE
				;回避成功
				PRINTFORML 
			ENDIF
		CASE 5
			;回避失敗
			PRINTFORML 
	ENDSELECT
ENDIF
RETURN 1
