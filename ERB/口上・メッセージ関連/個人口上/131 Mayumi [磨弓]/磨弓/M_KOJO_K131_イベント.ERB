		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無自覚
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF ARG:1 == 1
			PRINTFORML 
			PRINTFORML 「하아... 하아...! 아이를 낳는 것이 이렇게 힘든 일인가...」
			PRINTFORML 「...맞다! 케이키님, 아기는!?」 
