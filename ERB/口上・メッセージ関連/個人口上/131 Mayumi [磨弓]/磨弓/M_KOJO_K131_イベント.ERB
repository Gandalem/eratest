@M_KOJO_SPEVENT_MESSAGECHECK_K131_1
RETURN 1

@M_KOJO_SPEVENT_K131_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTFORML 
	PRINTFORML 「저기...%조사처리(CALLNAME:MASTER,"는")%, 키스...?라는 것을 해본 적은 있나?」
	PRINTFORMDL 돌아가는 길을 걷고 있는데, 마유미가 갑자기 화제를 꺼냈다.
	PRINTFORML 「...아니, 그게... 케이키님께 "키스는 했었냐"고 물어봤는데, 어떤 건지 잘 모르겠어서 말이야...」
	PRINTFORMDW 키스가 무엇인지 모르는 듯한 마유미에게 %조사처리(CALLNAME:MASTER,"는")% 설명하기로 했다.
	PRINTFORMW 「...입술을... 이렇게? ...응!」
	PRINTFORMDW 마유미의 입술이, 아주 잠깐 동안 %조사처리(CALLNAME:MASTER,"와")% 스쳤다...
	PRINTFORMW 「"두근두근"? 미안, 역시 나로서는 잘 모르겠어...」
	PRINTFORMDL 그 후에는 서로 대화 없이 귀가했다.
	PRINTFORMDW 맞은편에 도착할 때까지 마유미는 몇 번이나 자신의 입술을 손가락으로 만지고 있었다...
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;（任意）:通常の地の文を表示するかスキップするか決定する。
;RETURN 0;通常地の文と口上を表示
;RETURN 1;口上のみ表示
;RETURN 2;通常地の文のみ表示
;RETURN 3;どちらも表示しない
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K131_2
RETURN 1

@M_KOJO_SPEVENT_K131_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORML 
		;袿姫様に恋人or恋慕あり
		IF TALENT:132:恋人 || TALENT:132:恋慕
			PRINTFORML (오늘이야말로 말하겠어...! 이 마음을... 끊기 위해서...!)
			PRINTFORML 「…%CALLNAME:MASTER%！」
			PRINTFORMDW 마유미에게 불려, %조사처리(CALLNAME:MASTER,"는")% 걸음을 멈추고 뒤돌아본다.
			PRINTFORML 「...그! ...저기 말이야...」
			PRINTFORMDL 아무래도 하고 싶은 말이 있는 모양이지만, 말을 더듬고 있다...
			PRINTFORMDW 재촉하는 것은 역효과라고 생각하고, %조사처리(CALLNAME:MASTER,"는")% 그녀의 다음 말을 조용히 기다렸다.
			PRINTFORML (이번 한 번만은, 무례를 용서해 주세요...! 케이키님...!)
			PRINTFORML 「어... 어...」
			PRINTFORMW 「―네가 좋다고!!」
			PRINTFORML (아아... 말해버렸다...! 이제, 되돌릴 수 없어...)
			PRINTFORML (부탁이야 %CALLNAME:MASTER%...! 거절해줘! 나를, 거절해줘...!)
			PRINTFORMDL 마유미는 여러 감정이 뒤섞인 표정을 %조사처리(CALLNAME:MASTER,"에게")% 향하고 있다.
			PRINTFORMDW 그녀의 고백에 %조사처리(CALLNAME:MASTER,"는")%...
		ELSE
			PRINTFORML (……좋았어…!)
			PRINTFORML 「…%CALLNAME:MASTER%！」
			PRINTFORMDW 마유미에게 불려 %조사처리(CALLNAME:MASTER,"는")% 멈춰 서서 뒤돌아봤다.
			PRINTFORML 「...그! ...음, 그러니까...」
			PRINTFORMDL 아무래도 하고 싶은 말이 있는 듯하지만, 말을 더듬고 있다...
			PRINTFORMDW 재촉하는 것은 역효과일 거라 생각하고, %조사처리(CALLNAME:MASTER,"는")% 그녀의 다음 말을 조용히 기다렸다.
			PRINTFORML 「저... 저...」
			PRINTFORMW 「―네가 좋아!!」
			PRINTFORMDL 마유미의 눈동자가 살짝 촉촉해졌다.
			PRINTFORMDL 싸우는 것밖에 몰랐던 그녀에게, 타인에게 고백하는 것은 처음일 것이다...
			PRINTFORMDW 그녀의 고백에 %조사처리(CALLNAME:MASTER,"는")%…
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:132:恋人 || TALENT:132:恋慕
			PRINTFORML 「...윽!!」
			PRINTFORML 「...어째서야...? 어째서 거절해 주지 않아...!」
			IF TALENT:132:恋人
				PRINTFORMW 「나는...! 나 자신의 주인의 연인을 빼앗으려 꾸미고 있는, 비열한 여자라고!?」
			ELSE
				PRINTFORMW 「너에게는... 나 이상으로 어울리는 사람이 있어...!」
			ENDIF
			PRINTFORMDL 마유미는 여러 가지 감정이 폭발하며, 착란하기 시작했다.
			PRINTFORMDL 지금의 그녀도 알 수 있도록, 말 이상의 대답이 필요하다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 마유미를 조금 강제로 끌어안고, 자신의 입술을 포개었다―
			PRINTFORMW 「음무...!...? ...응...윽...! ...우으...!」
			PRINTFORML (죄송합니다... 케이키님...!)
			PRINTFORML (나는... 최악의 여자입니다...!)
			PRINTFORMDW 마유미는 눈물을 흘리면서도, %CALLNAME:MASTER%에게서 입술을 떼려고 하지 않았다...
		ELSE
			PRINTFORML 「…%CALLNAME:MASTER%！」
			PRINTFORML 「정…정말이야? 정말, 괜찮은 거야...?」
			PRINTFORMW 「나는… 싸우는 것밖에 할 수 없는, 도자기 병사라고...!?」
			PRINTFORMDL 현실에서 일어나고 있는 일이 믿기지 않는 듯한 마유미.
			PRINTFORMDL 지금 그녀도 알 수 있도록, 말 이상의 대답이 필요하다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 마유미를 조금 강제로 끌어안고 자신의 입술을 포개었다―
			CALL HPH_PRINT,@"「응윽!?…응응…흐읍」","W"
			PRINTFORMW (...고마워...! %CALLNAME:MASTER%...)
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:132:恋人 || TALENT:132:恋慕
			PRINTFORML 「…윽!!… 그렇구나… 그랬었네…」
			PRINTFORML (너의 마음은, 그분에게…)
			PRINTFORML 「…이상한 소리 해서 미안했다, %CALLNAME:MASTER%!」
			PRINTFORML 「나는 안심했어! 너의 케이키님에 대한 사랑이 진심이라는 걸 확신할 수 있었으니까 말이야!」
			PRINTFORML 「…윽… 잘 들어라 %CALLNAME:MASTER%!」
			PRINTFORML 「케이키님 이외의 여자에게 바람이라도 피우면, 이 내가 용서하지 않을 거다!」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 고개를 끄덕이자, 마유미는 아주 상쾌한 미소를 지어주었다.
		ELSE
			PRINTFORML 「…윽!!…그렇구나…」
			PRINTFORML 「…%CALLNAME:MASTER%! 그런 표정 짓지 마! 너는 아무 잘못 없어, 그렇지 않아?」
			PRINTFORML 「나는 당신에게 선택받지 못했어. 그저, 그것뿐이야…♪」
			PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"에게")% 지금까지와 변함없는 미소를 지어 보였다.
		ENDIF
		;レイセン口上からお借りしました告白禁止フラグ
		SETBIT CFLAG:[[磨弓]]:デート後イベントフラグ , 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1
