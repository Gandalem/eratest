			CALL HPH_PRINT,@"「오오부웅으윽 HPH HPH우구우...!」","L"
			CALL HPH_PRINT,@"「윽... 끅, 크으읍흐으윽흐으윽크으윽...」","L"
			CALL HPH_PRINT,@"(이건 뭐야 이 정액은...? 역하고, 끈적거리고... 최악의 맛이야... HPH)","L"
			PRINTFORMDW 숨이 막힐 듯한 냄새가 나는 진한 정액을, 마유미는 망설임 없이 다 마셔버렸다...!
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚顔面射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;無知持ち＆精液経験100未満
		IF ARG:1 == 1
			;通常ぬぐい取り
		ELSEIF ARG:1 == 2
			PRINTFORML 「―엣!? 뭐... 뭐야...!?」
			PRINTFORML 「...윽... 으윽...! 지독한 냄새야...!」
			PRINTFORMDW 마유미는 얼굴에 묻은 정액을 불쾌하다는 듯 닦았다.
			;顔射精液舐めとり
		ELSEIF ARG:1 == 3
			PRINTFORML 「음...!? 코, 이것은...」
			CALL HPH_PRINT,@"「치로홋... 이 맛... 역시 정액이다...」","L"
			PRINTFORMDW 마유미는 얼굴에 묻은 정액을 손가락으로 닦아내며 핥았다...!
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚手淫射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;ぬぐい取り
		IF ARG:1 == 1
			PRINTFORML 「…？」
			PRINTFORML (뭐지? 손에 뭔가―)
			PRINTFORML 「엣!?…이, 이 액체는 뭐지...?」
			PRINTFORMDW 마유미는 손에 묻은 수수께끼의 액체를 닦아냈다...
			;舐めとり
		ELSEIF ARG:1 == 2
			PRINTFORML 「…？」
			PRINTFORML (뭐야? 손에 뭔가―)
			PRINTFORML 「엣!? ...이건... 정액...!?」
			CALL HPH_PRINT,@"「치로옷 HPH... 하앗!? 뭐, 뭘 하고 있는 거야 나는...!」","L"
			PRINTFORMDW 마유미는 손에 묻은 정액을 무의식중에 핥아먹고 있었다...!
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚アナル射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;Ａ感覚2以下
		IF ARG:1 == 1
			CALL HPH_PRINT,@"「아기이익!? HPH HPH」","L"
			PRINTFORML 「뭐, 뭐야...!? 엉덩이에서... 액체가...!」
			PRINTFORMDW 마유미는 갑자기 엉덩이에서 흘러나온 정액을 보고 얼굴이 새파랗게 질렸다...!
			;それ以外
		ELSEIF ARG:1 == 2
			CALL HPH_PRINT,@"「오오오옷!? HPH HPH HPH」","L"
			CALL HPH_PRINT,@"「하... 헤...? HPH한, 왜... HPH할까,부터... 아...?」","L"
			PRINTFORMDW 마유미는 항문에서 절정에 이르러 정액을 흘리며 그 자리에 주저앉았다...!
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚処女喪失】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 「―윽, 아앗!?…뭐, 뭐야…!?」
		PRINTFORMW 「…이건…저, 가랑이에서…피가…!?」
		IF TALENT:恋人 || TALENT:恋慕
			PRINTFORML 「...미안해 %CALLNAME:MASTER%. 잠시 동안 어깨 좀 빌려줄 수 없을까?」
			PRINTFORML 「아아... 미안하네. 고마워...」
			PRINTFORML (…정말... 미안하다... %CALLNAME:MASTER%...)
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 뻔뻔하게 걱정을 가장하며, 마유미에게 어깨를 빌려 천천히 걸어갔다...
		ELSE
			PRINTFORML 「괜찮아... 괜찮아...! 이 정도는 아무렇지도 않아...」
			PRINTFORML (돌아가면 케이키님께 고쳐달라고 부탁해 봐야겠다...)
			PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 도움 없이 비틀거리며 걸음을 옮겼다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚膣内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF FIRSTTIME("無自覚膣内射精")
			CALL HPH_PRINT,@"「아앗!? 하프 하프...엣!? ...나...이게 뭐야...!?」","L"
			PRINTFORMDW 마유미는 자신의 가랑이에서 정액이 흘러나오는 이 예상치 못한 상황에 이해가 따라가지 못하는 듯하다...!
			;非処女膣内射精ピルなし
		ELSEIF ARG:1 == 1
			CALL HPH_PRINT,@"「아, 크윽 HPH HPH… 뭐지…? …정액…!?」","L"
			PRINTFORML (진정해, 죠토구 마유미...! 하니와 병장이 이런 일에 동요해서 어떡하지...!)
			PRINTFORML 「...괜찮아...! 괜찮아...!」
			PRINTFORMDW 마유미는 필사적으로 자신에게 타이르고 있는 것 같다...!
			;非処女膣内射精ピルあり
		ELSEIF ARG:1 == 2
			CALL HPH_PRINT,@"「아, 크윽 HPH HPH… 뭐지…? …정액…!?」","L"
			PRINTFORML (진정해, 죠토구 마유미...! 하니와 병장이 이런 일로 동요하다니 어쩌지...!)
			PRINTFORML 「...괜찮아...! 나에게는 케이키님께 받은 약도 있어...!」
			PRINTFORMDW 마유미는 필사적으로 자신을 다잡고 있는 것 같다...!
			;処女膣内射精
			;非処女でも出る？のでピル無しと同じにした
		ELSEIF ARG:1 == 3
			CALL HPH_PRINT,@"「아, 크윽 HPH HPH… 뭐지…? …정액…!?」","L"
			PRINTFORML (진정해, 죠토구 마유미...! 하니와 병장이 이런 일에 동요해서 어떡하지...!)
			PRINTFORML 「...괜찮아...! 괜찮아...!」
			PRINTFORMDW 마유미는 필사적으로 자신에게 타이르고 있는 것 같다...!
		ENDIF
	ENDIF
ENDIF
