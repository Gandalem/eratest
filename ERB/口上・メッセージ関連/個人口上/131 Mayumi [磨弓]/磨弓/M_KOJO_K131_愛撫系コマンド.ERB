@M_KOJO_MESSAGE_COM_K131_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｃ＆Ｂ感覚が一定以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				CALL MAYUMI_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「앙! HPH, 이봐... ♪ 너는 보지에 집중해라... HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「핫, 하아! 핫. 어때? %CALLNAME:MASTER%?! 핫」","L"
						CALL HPH_PRINT,@"「네 거, HPH 여기까지 닿아있다고!」","L"
						PRINTFORMDW 마유미의 배에 손을 대자, %조사처리(CALLNAME:MASTER,"의")% 육봉이 질 안에서 격렬하게 움직이고 있는 것을 알았다...!
					CASE 2
						CALL HPH_PRINT,@"「아앗 HPH히앗 HPH안ㅅ HPH HPH」","L"
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏흐으 더 만져줘 듬뿍 만지고 싶어 흐윽 흐윽」","L"
						PRINTFORMDW 마유미의 몸을 애무하면서, 격렬한 삽입을 계속했다...!
				ENDSELECT
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				CALL MAYUMI_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「저... 잠깐!」
						CALL HPH_PRINT,@"「햐아아악 햣헵 햣헵」","L"
						PRINTFORMDW 민감해진 마유미의 몸을 애무했다.
					CASE 1
						PRINTFORML 「두... 동시에 그럴 리가!」
						CALL HPH_PRINT,@"「응흐읍 흐아아앗 흐읍」","L"
						PRINTFORMDW 마유미의 몸을 어루만지면서 삽입을 계속했다...!
					CASE 2
						CALL HPH_PRINT,@"「~~~~!? 후후 후후 후후」","L"
						CALL HPH_PRINT,@"(엣...? 왜, 만졌을 뿐인데 이렇게 기분 좋은 거지...! HPH)","L"
						PRINTFORMDW 삽입되는 동안의 애무는 마유미에게 강렬한 자극이었던 것 같다.
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚・Ｂ感覚が５以上
	ELSEIF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「하아...윽... HPH 하아... HPH... 후우... HPH 응! HPH응!... ♪후후... HPH」","L"
				PRINTFORMDW 마유미의 숨결이 닿을 정도로 밀착하면서 그녀의 몸을 애무했다.
			CASE 1
				CALL HPH_PRINT,@"「후우... ♪ 훗... 흐으응... 오늘은... 꽤나 애태워 주네... 흐으응」","L"
				PRINTFORMDW 마유미의 부탁을 듣기 전까지는, 일부러 민감한 부위를 피해서 애무하기로 했다...
			CASE 2
				CALL HPH_PRINT,@"「응...아...흐으음...큭...흐으음...」","L"
				CALL HPH_PRINT,@"「하아... HPH는 하하핫... ♪ 귀여운 반응을 보여주잖아... HPH」","L"
				PRINTFORMDW 마유미에게 귓불을 달콤하게 깨물어지고, 나도 모르게 소리를 내고 말았다...
			CASE 3
				PRINTFORML 「아...♪응...윽...저기...%CALLNAME:MASTER%...♪」
				CALL HPH_PRINT,@"「...여...여기는, 만지지 않아도 되는 건가...? HPH」","L"
				PRINTFORMDW 마유미는 만져달라는 듯, 가슴을 밀어붙였다...!
			CASE 4
				PRINTFORML 「후후...♪ 신기한 것이네...」
				CALL HPH_PRINT,@"「이렇게... 너에게 접촉당하고 있다는 것만으로도... 응! HPH」","L"
				CALL HPH_PRINT,@"「자... HPH 벌써 이렇게...」","L"
				PRINTFORMDW 마유미가 손가락을 펼치자, 그녀의 애액이 끈적하게 실처럼 늘어났다...!
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「응윽... 아...! 후우... ♪ 음... HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 몸에 닿을 때마다, 마유미는 뜨거운 숨을 내쉬었다.
			CASE 1
				CALL HPH_PRINT,@"「히야앗 HPH 아...윽...! 으윽...!」","L"
				PRINTFORML 「흐읍... 웃지 마! 네가 갑자기 만져서...!」
				PRINTFORMDW 귀여운 목소리를 낸 마유미에게 자신도 모르게 미소가 새어 나왔다.
			CASE 2
				CALL HPH_PRINT,@"「음... 하으읍... 이제 만족했다면, 어서 넣어줬으면 하는데...」","L"
				PRINTFORML 「...너의...! ...그게... 우으...!」
				PRINTFORMDW 마유미는 답답한 듯 안절부절못하고 있다.
			CASE 3
				CALL HPH_PRINT,@"「응... 하아, 뭐야... 그... 야한 스킨 방식은...!」","W"
			CASE 4
				CALL HPH_PRINT,@"「음...흐읍...히히 웃겨...간지러워...♪」","L"
				PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"의")% 애무로 작게 몸을 떨고 있다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
