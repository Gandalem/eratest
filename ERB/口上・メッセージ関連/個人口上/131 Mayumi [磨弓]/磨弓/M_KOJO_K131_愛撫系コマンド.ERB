	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			;時姦中
		ELSEIF FLAG:70
			PRINTFORML 
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아... HPH 하아... HPH %CALLNAME:MASTER%...♪ 아름답게... 해줄 수 있는 거야...? HPH」","L"
					PRINTFORMDL 히끅거리며 경련하는 정액을 흘리고 있는 질구에 입을 가까이 가져가, 힘껏 빨아들였다...!
					CALL HPH_PRINT,@"「보지가 더러워져버렸어…… HPH, 이제 어떡하면 좋을지 알겠지…? HPH」","W"
				CASE 1
					PRINTFORML 「...어...?」
					PRINTFORML 「기... 기다려...! 지금, 민감해서-」
					CALL HPH_PRINT,@"「~~~~!!? HP프 HP프 HP프」","L"
					PRINTFORMDW 사정 직후의 질 구멍을 핥아져, 마유미의 몸은 예민하게 움찔했다...!
				CASE 2
					CALL HPH_PRINT,@"「큭흑 HPH우, 오오...HPH앗 HPH우, 아아...HPH」","L"
					PRINTFORMDW 마유미의 질 구멍에서 새어 나오는 정액을 조심스럽게 핥아냈다...!
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;Ｃ感覚５以上
		IF ABL:Ｃ感覚 >= 5
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「미안해엣HPH 미안해%CALLNAME:MASTER%엣HPH HPH 조금만 더 참아줘어HPH」","L"
					CALL HPH_PRINT,@"「아아앗 HPH 아아-앗 HPH 가슴이 터져요 HPH 가슴이 터져요 으윽 HPH HPH」","L"
					PRINTFORMDL 마유미에게 머리를 잡히고, 가랑이 쪽으로 밀어붙여진다.
					PRINTFORMDW 홍수처럼 넘쳐흐르는 애액에 빠질 듯하면서도, %조사처리(CALLNAME:MASTER,"는")% 정신없이 계속 핥았다...!
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%...윽...HPH 정말, 잘 빠는구나...윽...HPH」","L"
					CALL HPH_PRINT,@"「아앗 HPH도, 이제...!! 갈 것 같아... HPH 아, 아앗―」","L"
					PRINTFORMDW 혀를 통해 전해져 오는 질 내부의 경련이 유난히 강해졌다.
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%……윽! 안, 안 돼...!」
					CALL HPH_PRINT,@"「그렇게 함을, 하프 하프하게, 루우프 하프으로, 거기 하프」","L"
					PRINTFORMDL 그렇게 말하면서도, 마유미는 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 가랑이를 밀어붙인다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 입을 크게 벌리고 그것을 받아들이려는 자세를 취했다...!
				CASE 3
					CALL HPH_PRINT,@"「저, 저기 %CALLNAME:MASTER%... HPH 또... 그것을... HPH」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 혀를 빼고, 크게 발기된 음핵을 목표로 삼았다...!
					CALL HPH_PRINT,@"「아... HPH가 온다... HPH가 온다 HPH」","L"
					CALL HPH_PRINT,@"「흐윽-아아아아악! HPH HPH HPH」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「아아... HPH앗 HPH 아아! %CALLNAME:MASTER%!! 모, 이제... 슬슬...」","L"
					CALL HPH_PRINT,@"「이이익!? HPH는, 거세한 HPH 이익 HPH 아앗 HPH 아아- HPH HPH」","L"
					PRINTFORMDW 얼굴을 앞으로 내밀고, 혀를 한계까지 내밀어 핥아댔다...!
				CASE 1
					CALL HPH_PRINT,@"「아앗! 흐읍, 히히 %CALLNAME:MASTER%, 잠깐... 저기, 기다려...」","L"
					CALL HPH_PRINT,@"「히앗 HPH아아아아-ㅎHPH HPH HPH」","L"
					PRINTFORMDW 음핵을 세게 빨아들이자, 마유미는 절규 같은 교성을 질렀다...!
				CASE 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……HPH도……이제……! 좋아…… HPH 좋으니까아……HPH」","L"
					PRINTFORML 「오... 어이... 뭐 해-」
					CALL HPH_PRINT,@"「~~~~!?!? 후후 후후 후후」","L"
					PRINTFORMDW 마유미의 발기한 클리토리스를 살짝 물었다...!
				CASE 3
					CALL HPH_PRINT,@"「아앗 HPH, 그렇게 함부로 하다니 HPH도... 새어버려...」","L"
					CALL HPH_PRINT,@"「크으읍! 흐음~~흐으읍 흐으읍 흐으읍」","L"
					PRINTFORMDW 혀가 빠져버릴 정도까지 질이 수축한 순간, 마유미의 가랑이에서 따뜻한 액체가 분출했다―
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「으앗! 하프하프 아아아-옷 하프 하프, 빨지 마읏 하프 하프」","L"
				PRINTFORMDW 마유미의 클리토리스를 빨아 애무했다...!
			CASE 1
				CALL HPH_PRINT,@"「아... 흠응! 흠후... ♪ 아앗...」","L"
				PRINTFORMDL 마유미의 은밀한 곳을, 정성껏 핥아 풀었다.
				PRINTFORMDW 한 번 핥을 때마다, 깊은 곳에서 달콤한 액체가 흘러나온다...!
			CASE 2
				CALL HPH_PRINT,@"「음...흐읍후우...흐읍앗...흐읍안...흐읍」","L"
				CALL HPH_PRINT,@"「거기... 좋아... HPH 더... 핥아줘... HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 은밀한 곳을 핥아지며, 마유미는 허리를 음란하게 비틀고 있다...!
			CASE 3
				CALL HPH_PRINT,@"「훗...후헵! 후후... ♪ 잘하네... 후헵」","L"
				PRINTFORML 「미, 미안해... 나도 모르게 쓰다듬고 싶어져 버렸어...♪」
				PRINTFORMDW 마유미에게 머리를 쓰다듬어지면서 질 구멍을 계속 핥았다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@"「으윽...! 힉... 아... HPH 축축해서...! 으응... HPH」","L"
				PRINTFORMDW 은밀한 곳을 혀로 핥아지고, 마유미는 몸을 떨고 있다.
			CASE 1
