;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K131_15
RETURN 0

@M_KOJO_MESSAGE_COM_K131_15
CALL M_KOJO_MESSAGE_COM_K131_15_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K131_15_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1 ;custom code
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｃ感覚５以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｃ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「나... 저기 %CALLNAME:MASTER%... HPH」","L"
						CALL HPH_PRINT,@"「또... 그것을 해 주지 않을래...? HPH」","L"
						PRINTFORMDL 그렇게 말하며 마유미는 발기한 클리토리스를 %조사처리(CALLNAME:MASTER,"에게")% 비벼온다.
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 클리토리스를 손가락으로 집어, 으깨듯이 가볍게 힘을 주었다...!
						CALL HPH_PRINT,@"「히, 오오아아악 HPH HPH HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「하아앗 HPH 하아아앗 HPH %CALLNAME:MASTER%……♪」","L"
						CALL HPH_PRINT,@"「이제... 갈 것 같아... 그러니까...」","L"
						CALL HPH_PRINT,@"「아앗 흐으윽~~~흐읍 흐읍 흐읍」","L"
						PRINTFORMDW 페니스를 밀어 넣으며 음핵을 잡아당기자, 마유미의 조임이 더욱 강해졌다―
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%」는 으윽, 곧 갈 것 같아...응?","L"
						CALL HPH_PRINT,@"「나도, 그러니까! 하프 같이 할 거야! 함께에에에」","L"
						CALL HPH_PRINT,@"「흐으윽 HPH HPH 어……어어…HPH HPH」","L"
						PRINTFORMDL 호쾌하게 허리를 밀어 넣는 동시에, 민감해진 마유미의 음핵을 움켜쥔다.
						PRINTFORMDW 너무나 강렬한 조임에, %조사처리(CALLNAME:MASTER,"의")% 시야가 새하얗게 변했다―
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「우아아악 흐으흐 아아앗 흐으흐 아아앙 흐으흐 흐으흐」","L"
					CASE 1
						CALL HPH_PRINT,@"「아힛 흐으으윽흐읍흐읍흐읍」","L"
						CALL HPH_PRINT,@"「이거! 흐으윽, 안 돼! 흐으윽, 이상해, 꽉! 흐으윽」","L"
					CASE 2
						CALL HPH_PRINT,@"「아앗 히히, 아앗 히히 아햣 히히 아히잇 히히 아아아 히히 히히」","L"
				ENDSELECT
				PRINTFORMDW 페니스와 클리토리스에 의한 두 가지 자극으로, 마유미는 정신을 놓을 듯 신음하고 있다...!
				RETURN 1
			ENDIF
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 HPH HPH 이거라 HPH 온다 HPH 크네, 가앗 HPH HPH」","L"
						PRINTFORMDL 손가락의 살결로 음핵을 쓰다듬으며, %조사처리(CALLNAME:MASTER,"는")% 허리의 움직임을 더욱 가속시킨다.
						PRINTFORMDW 이윽고, 유난히 강한 조임과 동시에 절정에 이르렀다...!
					CASE 1
						PRINTFORML 「……엣!? 아... 아니...!」
						CALL HPH_PRINT,@"「히야아아아악 HPH HPH HPH」","L"
						PRINTFORMDL 음핵을 가볍게 집자, 마유미는 절정에 달했다.
						PRINTFORMDW 너무 강한 조임에, %CALLNAME:MASTER%도 뒤따르듯 끝이 났다―
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%윽, 하아...기다려...줘...하아」","L"
						CALL HPH_PRINT,@"「흐읍... 안 돼... HPH인가... 하... HPH」","L"
						PRINTFORMDL 음핵과 페니스의 삽입으로 인한 자극을 견디지 못하고, 마유미는 실신하듯 절정에 달한 것 같다.
						PRINTFORMDW %CALLNAME:MASTER%도 그것에 응하기 위해 허리를 한계까지 비틀었다―
				ENDSELECT
				RETURN 1
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗! 흐읍, 흐읍... 잠깐만 기다려 줘...!」","L"
						CALL HPH_PRINT,@"「그... 거기... 만지면... 윽... 이상해져버릴 것 같아... 흑흐읍」","L"
					CASE 1
						CALL HPH_PRINT,@"「~~~~!? 후후 후후 후후」","L"
						CALL HPH_PRINT,@"(뭐...야...? 흐읍... 숨... 쉴 수 없어... 흐읍 흐읍)","L"
					CASE 2
						CALL HPH_PRINT,@"「엣!? %CALLNAME:MASTER%! 거기... 아아아앗 HPH HPH」","L"
				ENDSELECT
				PRINTFORMDW 클리토리스를 자극당해, 마유미는 강렬한 쾌감을 느끼고 있는 것 같다...!
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「…윽 후으…! 응 큭 흐읍 흐읍」","L"
				PRINTFORMDW 마유미는 이를 악물고 음핵에 대한 자극을 참고 있다...!
			CASE 1
				CALL HPH_PRINT,@"「히으윽 HPH HPH 아흣HPH 아아앗 HPH HPH」","L"
				CALL HPH_PRINT,@"「뭐, 왜...거기만... 계속 해줘! 큭큭」","L"
				PRINTFORMDW 민감한 클리토리스를 자극받아 마유미는 몸을 비틀고 있다...!
			CASE 2
				CALL HPH_PRINT,@"「아아...흐응! 아아...! 흐으윽! 흐으윽!」","L"
				CALL HPH_PRINT,@"「하아... 하아... HPH%CALLNAME:MASTER%... 벌써, 용서해줘...!」","L"
				PRINTFORMDW 간청해오는 마유미를 무시하고 음핵을 계속 만졌다.
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응응! 흐읍 흐읍... 으윽... 흐읍 아... 으윽... 흐읍」","L"
				PRINTFORML (케... 케이키님은, 어째서 나에게 이런 것을...?)
				PRINTFORMDW 마유미는 %조사처리(CALLNAME:MASTER,"에게")% 애무받고 있는 클리토리스를 뚫어지게 응시하고 있다.
			CASE 1
				CALL HPH_PRINT,@"「앗... HPH다... 안 돼... HPH 거기... 민감하다고... 윽...!」","L"
				CALL HPH_PRINT,@"「히아앗! HPH다, 안 된다고 말하고 있잖아!! HPH HPH」","L"
				PRINTFORMDW 마유미의 클리토리스를 질척하게 애무했다...!
			CASE 2
				CALL HPH_PRINT,@"「응! 흐으윽 응! 흐으윽 아, 으윽 흐으윽 흐으윽」","L"
				PRINTFORML 「오... 여자는 모두 이렇게 되는 건가...?」
				PRINTFORMDW 마유미는 익숙하지 않은 클리토리스 자극에 당황하고 있는 듯하다...
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
