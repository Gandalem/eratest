	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			IF ABL:Ｖ感覚 >= 5
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏흐읍 보지읏흐읍 더, 비벼줘어엣 으큭 으큭」","L"
						CALL HPH_PRINT,@"「응응! 흐윽...아...아아아악! 허억, 허억」","L"
						PRINTFORMDL G스팟을 문지름 당하고, 마유미는 절정에 다다른 듯했다.
						PRINTFORMDW %CALLNAME:MASTER%도 뒤를 따르듯이, 밀려오는 사정감에 몸을 맡기며―
					CASE 1
						CALL HPH_PRINT,@"「흐으윽! 하프 하프 거기이얏! 더더어!」","L"
						CALL HPH_PRINT,@"「아앗, 흐으윽, 크윽, 너무 커, 응! 좋아, 좋았어...」","W"
					CASE 2
						CALL HPH_PRINT,@"「히아앗 HPH 오오옷 HPH 오오옷 HPH HPH」","L"
						CALL HPH_PRINT,@"「오, 거시기! 하프 하프 거시기, 기분 좋아! 아아아아-」","L"
						PRINTFORMDL G스팟을 몇 번이나 문지러져, 마유미는 완전히 쾌락의 포로가 되어버렸다.
						PRINTFORMDW 음란한 말도 거리낌 없이 내뱉는 그 모습에, %조사처리(CALLNAME:MASTER,"의")% 삽입도 자연스럽게 가속되어 간다―
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 헉헉 아... 아아아- 헉헉 헉」","L"
						PRINTFORMDW 지독하게 기분 좋은 곳을 건드렸는지, 질 안의 조임이 갑자기 강해졌다...!
					CASE 1
						CALL HPH_PRINT,@"「크, 아아앗 HPH HPH 거기만 계속 문지르면... 아아앗 HPH HPH」","L"
						PRINTFORMDW 마유미의 몸이 튀어 오르자마자, %조사처리(CALLNAME:MASTER,"는")% 사정했다...!
					CASE 2
						CALL HPH_PRINT,@"「아...윽 흐으흐흐윽...앗...흐으흐흐윽」","L"
