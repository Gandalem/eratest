					CASE 1
						CALL HPH_PRINT,@"「아으윽흐읍, 히이익!? 흐읍 흐읍 하며 큭흐읍, 이것을 멈춰줘어읍! 흐읍 흐읍」","L"
					CASE 2
						CALL HPH_PRINT,@"「히구우웃! HPH HPH 쿠오호오오옷 HPH HPH HPH」","L"
				ENDSELECT
				PRINTFORMDW 바이브가 좋은 곳에 맞았는지, 마유미는 굉장한 신음소리를 내고 있다...!
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「흐으윽!? 헉 헉」","L"
						CALL HPH_PRINT,@"「아, 그만둬...윽...HPH구, 우옷HPH거기...! 그만해, 어어...HPH HPH」","L"
