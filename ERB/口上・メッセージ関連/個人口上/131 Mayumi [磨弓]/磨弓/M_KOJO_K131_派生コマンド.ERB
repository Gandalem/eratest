@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K131_1
RETURN 0

@M_KOJO_MESSAGE_SCOM_K131_1
CALL M_KOJO_MESSAGE_SCOM_K131_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K131_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;舌技術３以上
	ELSEIF ABL:舌 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「쭈풉!흐음!으응!히응! 흐음! 흐음!」","L"
					PRINTFORMDW 마유미의 성기에서 터져 나온 물을 다 삼키면서 사정했다...!
				CASE 1
					CALL HPH_PRINT,@"「음부우읏HPH으응, 음무우읏HPH HPH줄루루우웅읏HPH HPH」","L"
					PRINTFORMDL 마유미는 절정에 이른 듯, 혀에서 질벽이 경련하고 있는 것이 느껴진다.
					PRINTFORMDW 강하게 빨려 올라간 %조사처리(CALLNAME:MASTER,"의")% 페니스도 뒤를 따르듯 한계에 도달했다―
				CASE 2
					CALL MAYUMI_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					CALL HPH_PRINT,@"「쭈욱 HPH츄HPH츄푸욱HPH음... ♪훗HPH쭈푸욱HPH쭈푸우욱HPH HPH」","L"
					PRINTFORMDW 마유미가 %조사처리(CALLNAME:MASTER,"의")% 페니스를 빨면서, 가랑이를 얼굴에 밀착해 온다...!
				CASE 1
					CALL HPH_PRINT,@"「히아아앗! 후후후, 하는구만 %CALLNAME:MASTER%……♪」","L"
					CALL HPH_PRINT,@"「하...HPH는 푹 HPH 주르륵 HPH 흘러내리듯 HPH HPH 주르륵 HPH 쭉 HPH」","L"
					PRINTFORMDW 서로 격렬하게 책망하며 절정에 가까워진다...!
				CASE 2
					CALL HPH_PRINT,@"「응응으윽 HPH음음우윽 HPH주릅 HPH음음우윽 HPH HPH」","L"
					PRINTFORMDW 마유미는 허리를 부르르 떨면서도, 구강욕을 계속하고 있다...!
				CASE 3
					CALL MAYUMI_FELLATIO
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응, 으윽, 후우... 응, 흐읍—후욱 후욱」","L"
					PRINTFORMDL 마유미의 허리를 단단히 붙잡고 질 안을 핥아내다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 격렬한 공격에 절정에 달한 듯했지만, 마유미는 페니스에서 입을 떼지 않고―
				CASE 1
					CALL HPH_PRINT,@"「응으윽... HPH는... 풋, 흐으윽... HPH」","L"
					PRINTFORML (%조사처리(CALLNAME:MASTER,"가")% 핥아주고 있어... HPH 나도 응해야 해...!)
					CALL HPH_PRINT,@"「아... 흐읍! 흠! 후우...」","L"
					PRINTFORMDW 서로의 눈앞에 있는 성기를 정신없이 핥으며 거의 동시에 절정에 도달했다.
				CASE 2
					CALL MAYUMI_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「하... 부끄러우니까 너무 보지 마...!」
					PRINTFORMDL 수치를 감추려는 듯, 마유미는 격렬하게 페니스를 몰아붙인다.
					PRINTFORMDW %CALLNAME:MASTER%도 지지 않고 눈앞의 비열을 핥아 풀었다...!
				CASE 1
					CALL HPH_PRINT,@"「쭈욱...흠프읏...흐음응...흡...흠프줄루...흡프」","L"
					PRINTFORMDW 질벽을 핥아졌고, 마유미의 페라치오가 순간 멈췄다.
				CASE 2
					CALL HPH_PRINT,@"「...푸하큭 HPH 그만둬! HPH %CALLNAME:MASTER%!! HPH」","L"
					CALL HPH_PRINT,@"「그렇게 격렬하게 당하면, 깔릴 수 없잖아! 큭큭」","L"
					PRINTFORMDW 마유미의 항의를 흘려보내고, 더욱 깊숙이 혀를 밀어 넣었다...!
				CASE 3
					CALL MAYUMI_FELLATIO
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
