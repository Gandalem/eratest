					CASE 0
						CALL HPH_PRINT,@"「히아아앗! 하프 하프 아앗! 하프 우, 아아아-!」","L"
					CASE 1
						CALL HPH_PRINT,@"「아응흐읍, 아앗흐읍 아응흐읍 크윽흐읍 아아앗흐읍 흐읍」","L"
					CASE 2
						CALL HPH_PRINT,@"「흐윽... 흐읍 흐읍 우옷 흐읍 호, 오옷 흐읍 아앗 흐읍 우오, 오오옷 흐읍 흐읍」","L"
				ENDSELECT
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 페니스에 G스팟을 자극당해, 마유미는 부끄러워하는 기색도 없이 큰 소리로 신음하고 있다...!
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「오옷!? 하프 하프」","L"
					CASE 1
						CALL HPH_PRINT,@"「아아앗 HPH HPH 거기, 멈춰...! 우아앗 HPH HPH」","L"
					CASE 2
						CALL HPH_PRINT,@"「응...흐읍! 흐으윽! 응...흐읍! 흐으윽! 응...흐읍! 흐으윽!」","L"
						PRINTFORML (그만둬어...! 거긴... 약하단 말이야!)
				ENDSELECT
				PRINTFORMDW 허리를 들고, 마유미의 G스팟으로 추정되는 부위를 페니스로 자극했다...!
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
