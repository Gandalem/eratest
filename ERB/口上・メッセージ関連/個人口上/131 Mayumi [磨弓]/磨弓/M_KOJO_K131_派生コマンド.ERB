						CALL HPH_PRINT,@"「거기... 계속 문지르네엣 HPH HPH」","L"
					CASE 2
						CALL HPH_PRINT,@"「크윽...HPH 진동이...! 아우우욱 HPH HPH」","L"
				ENDSELECT
				PRINTFORMDW 바이브를 끌어올려 마유미의 예민한 곳을 자극했다.
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;Ｖ感覚５以上
			IF ABL:Ｖ感覚 >= 5
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아앗 흐으, 거기! 좋아! 기분 좋아! 흐읍 흐읍」","L"
					CASE 1
						CALL HPH_PRINT,@"「아히이이익 HPH HPH이, 아앗 HPH HPH아아아아ー큭 HPH HPH HPH」","L"
					CASE 2
						CALL HPH_PRINT,@"「아앗 하프 아, 아아앗 하프 하프」","L"
						CALL HPH_PRINT,@"「거기이잇 후후 더, 비벼줘 후후 아아-앗 후후 후후」","L"
				ENDSELECT
				PRINTFORMDW 마유미의 약한 곳을 문지를 때마다, 애액이 홍수처럼 흘러나온다...!
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아아악 흐읍 흐읍」","L"
						CALL HPH_PRINT,@"「...그, 거...! 안 돼... 으윽... HPH」","L"
					CASE 1
						CALL HPH_PRINT,@"「윽 흐읍 아우윽 흐읍 아아앗 흐읍 앙흐읍 히아아앗 흐읍 흐읍」","L"
					CASE 2
						CALL HPH_PRINT,@"「크윽... HPH 아, 아앗 HPH 우앗 HPH」","L"
						CALL HPH_PRINT,@"「아, 어째서! HPH 거기가 자꾸!! HPH HPH」","L"
				ENDSELECT
				PRINTFORMDW 마유미의 약한 곳을 찾아내 손가락으로 여러 번 자극했다...!
			ENDIF
		ENDIF
	ENDIF
ENDIF
