;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「저기 %CALLNAME:MASTER%, 그거 뭐였지? 그게, 아레아레, 이런 느낌의~ 그런 거 말이야。」
		PRINTFORML 카나코는 건망증이 생긴 듯, 물레를 돌리는 듯한 손놀림으로 필사적으로 무언가를 떠올리려고 한다.
		PRINTFORML 『카나코님은 아직 치매가 되기엔 너무 이른 것 같은데요.』
		PRINTFORMW 「아, 아니! 이건 그런 게 아니라고!」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORML 『아레라고 말해도 모르겠다고, 어느 것이에요 카나코님.』
		PRINTFORML 「그니까ー읏! '저거'라고 말하잖아! 기억 못 해서 묻는 거라고!」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 카나코를 잠시 내버려 두기로 했다…….
		RETURN 1
	CASE "依頼受託時"
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 카나코가 말하는 그 '것'을 조사하기로 했다!
		PRINTFORML 「야, 미안해! 있잖아, 그거라는 건 뭔가 이렇게……」
		PRINTFORMW 여전히 요점을 모르겠는 카나코의 이야기에 %조사처리(CALLNAME:MASTER,"는")% 진지하게 귀를 기울였다……。
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「음, 그러니까 뭔가 우와~ 하고 되어서, 퍽! 하는 느낌으로」
		PRINTFORMW 카나코는 %조사처리(CALLNAME:MASTER,"를")% 향해 과장된 몸짓을 사용하여 설명하고 있다.
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 카나코에게 전혀 떠오르지 않는 것을 전달했다.
		PRINTFORML 「젠장~, 안 되는 건가~~! 사나에! 사나에는 있나!?」
		PRINTFORMW 다음 희생자를 찾고 있는 카나코를 옆에 두고, 당신은 헛되이 보낸 시간을 어떻게 되찾을지 생각했다.
		RETURN 1
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			PRINTFORML 혹시 카나코가 말하던 게 이거 아닐까?
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 떠오른 것을 입 밖에 냈다.
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORML 「모, 글씨가 작아서 못 읽겠어... 아, 아무것도 아니야!」
					PRINTFORML 설마 노안인가...? %조사처리(CALLNAME:MASTER,"는")% 의심했다.
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					PRINTFORML 「뭐야, 조사할 거? 사전은 저기 있잖아.」
					RETURN 1
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				PRINTFORML 「아, 맞아요, 바로 그거예요!」
				PRINTFORMW 카나코는 드디어 목적한 것을 떠올린 듯 싱글벙글 %조사처리(CALLNAME:MASTER,"에게")% 감사를 말했다.
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				PRINTFORML 「아니, 달라. 다르다고 말이야~ 뭔가 그랬던 것 같은데.」
				PRINTFORMW 카나코님, 농담하시기에는 아직 이른 것 같습니다…….
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		PRINTFORML 「음, 고마워. 자, 용돈.」
		PRINTFORML 카나코는 500엔 지폐를 건넸다.
		PRINTFORMW 이와쿠라 구시구나…….
		RETURN 1
	CASE "失敗報告時"
		PRINTFORML 「저기, 그러고 보니 그거 어떻게 됐어?」
		PRINTFORML 그 거? %CALLNAME:MASTER%에는 전혀 떠오르지 않았어.
		PRINTFORML 「그거? 어라? 아니, 그거라고 하면 저거... 응?」
		PRINTFORML 카나코의 엉뚱함은 심각한 모양이다…….
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
