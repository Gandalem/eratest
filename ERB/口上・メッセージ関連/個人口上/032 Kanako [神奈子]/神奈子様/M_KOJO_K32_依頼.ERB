	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では失くしもの持っていた側の口上です
		;【◆口上】
		;【W 聞き込みを続けていた［あなた］はついに探していた落とし物を発見した】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		RETURN 0
	CASE "成功報告時"
		;報酬：\3200
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
