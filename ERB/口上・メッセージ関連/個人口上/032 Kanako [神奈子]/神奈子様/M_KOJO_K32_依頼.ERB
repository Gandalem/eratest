;依頼口上・一般依頼03：いっしょにあそぼ
;※この依頼は[幼稚]を持っているキャラのみ発生します
;
;ロリ神奈子様すこすこ過ぎてスコティッシュフォールドになる。
;
;==================================================

@M_KOJO_IRAI_3_K32(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「있잖아, 있잖아! 아-재미있다!」
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORML 「흥! 재미없어~!」
		RETURN 1
	CASE "依頼受託時"
		PRINTFORML 「해냈다! 이쪽 이쪽! 오니 씨 이쪽으로, 손이 닿는 쪽으로요!」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「왜 그래? 어서 놀자!」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「엣......어째서............?」
		PRINTFORML 이 세상의 끝과 같은 표정을 짓는 카나코에게 %조사처리(CALLNAME:MASTER,"는")% 마음이 아팠다.
		;上げて落として沈む顔がみたいのか？　この鬼畜！
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と遊んだ】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "成功報告時"
		;報酬：好感度と信頼度のみ（機嫌が良くなる）
		;【▲上の口上から続き】
		;【◆口上】
		PRINTFORML 「후훗! 아, 재미있어!」
		RETURN 1
	CASE "失敗報告時"
		PRINTFORML 「앗, %CALLNAME:MASTER%구나! 있잖아, 저번에 어떻게 된 거야? 바빴어?」
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
