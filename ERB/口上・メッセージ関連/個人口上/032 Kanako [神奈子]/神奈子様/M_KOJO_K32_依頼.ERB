;依頼口上・一般依頼12：懲らしめて！
;==================================================

@M_KOJO_IRAI_12_K32(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「오이, %CALLNAME:MASTER%～.」
		PRINTFORML 카나코는 이것저것 개구리로부터 올라온 사업 보고서 등을 보면서 한 손으로 %조사처리(CALLNAME:MASTER,"를")% 불렀다.
		PRINTFORML 「잠깐 나 지금 손 쓸 수가 없으니 대행으로 신벌 내려줘. 보고서는 신사에 있으니, 잘 부탁해.」
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 꽃에 물을 주라고 부탁하는 핑계로 신벌 대행을 부탁받았다.
		RETURN 1
	CASE "依頼非受託時"
		PRINTFORML 자신에게 신벌 같은 큰 임무를 맡기지 말아달라고 %조사처리(CALLNAME:MASTER,"는")% 거절했다.
		PRINTFORML 「칫, 일일이 상대 찾아서 때려 보내는 거 귀찮단 거야~」
		PRINTFORML 「옛날 같았으면 폭우로 홍수를 일으키거나 폭풍을 몰아칠 수 있었을 텐데 말이야...」
		PRINTFORML 카나코는 날씨를 조작하려는 건지 슬쩍 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 살피고 있다.
		PRINTFORML 유카리님이나 레이무 씨에게 두들겨 맞을 테니 대규모 신벌은 그만두라고 %조사처리(CALLNAME:MASTER,"는")% 어떻게든 달랬다.
		RETURN 1
	CASE "依頼受託時"
		PRINTFORML 신벌이 그렇게 가벼운 태도로 괜찮은 걸까?
		PRINTFORML 의문이 들었지만 받아들이기로 했다…….
		PRINTFORML 「응, 기한 내에 맞춰주면 좋으니까 힘내 줘.」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「무슨 일이야? 전력이 불안해? 못한다면 내가 내려갈게, 하지만?」
		PRINTFORML 「그래도 역시 바쁘니까 %조사처리(CALLNAME:MASTER,"가")% 가줬으면 고마울 것 같은데……?」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「역시 홍수나 지진을 일으킬까, 산사태…….」
		PRINTFORMW 카나코는 아라카미로서의 본분을 떠올린 듯 갑자기 우르릉거리는 먹구름을 불러내기 시작했다...!
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 필사적으로 카나코를 진정시키려 노력했고, 간신히 천재지변은 다시 생각하게 만들었다.
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			PRINTFORML 「에, 에엣!? 지금!? 여기서!? 저기, 잠깐 밖에서 하지 않을래요?」
			PRINTFORML 「도전은 언제든 받고 싶지만 말이죠, 아무래도 실내에서는 좀……。」
			PRINTFORML 그럴 리가, %조사처리(CALLNAME:MASTER,"는")% 다시 생각하며 화를 거두었다.
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			;神奈子の仕事って女子会以外ないよね？
			PRINTFORML 「쉿! 지금 좀 상대해 줄 여유 없어, 나중에 하자!」
			PRINTFORML 큰 요괴들이 들끓는 여자들 모임 속에서 용기를 내서 말을 걸었는데 말이야.
			PRINTFORMW 대체 여자들이 몇 살인 거야...라고 %조사처리(CALLNAME:MASTER,"는")% 토하듯 중얼거렸다.
			PRINTFORML 무례한 소리를 지껄였던 것이 들킨 건지 얼음으로 척추를 찔러오는 듯한 여러 개의 살기가 %조사처리(CALLNAME:MASTER,"에게")% 전해졌다.
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			PRINTFORML 『싸, 싸워주겠어... 도망가는 거야!? 잠깐, 기다려...!』
			PRINTFORMW 숨조차 가쁜 %조사처리(CALLNAME:MASTER,"는")%, 설마 정의를 위해 카나코를 꾸짖기 위한 전투에 나서려 했다.
			PRINTFORML 「아니야... 약자를 괴롭히는 건 아무래도 취향이 아니라서 말이야.」
			;挑戦者には優しい神奈子様やりたいんだけどやり方がわからぬぇ
			;		PRINTFORML 「ちょいと待ってなよ。」
			;		PRINTFORML 神奈子はふらつく%CALLNAME:MASTER%の肩に手を当てて意識を集中した。
			;		PRINTFORMW ふらふらだった%CALLNAME:MASTER%の体に力が湧き上がる……！
			;		PRINTFORML 体力（それと気力？）回復
			;		PRINTFORML 「神徳によって回復させてやった。さあ勇者よ、私に立ち向かってくるが良い……！」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			PRINTFORML 「싸, 싸우자니... 괜찮잖아, 해줄게!」
			PRINTFORML 아오이 호흡으로 카나코는 그럼에도 신에게 도전하려는 인간의 심지를 존중하며 도전을 받아들였다.
			PRINTFORML 그렇지만 %CALLNAME:MASTER%도 오니가 아니었기에 나중에 날을 바꿔 다시 도전을 받기로 했다.
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			PRINTFORML 「에? 아니, 오늘의 건 이미 했으니까 싫어」
			PRINTFORML 탄막 듀얼은 같은 날 같은 상대에게 단 한 번만 할 수 있다.
			PRINTFORML 좀비 어택을 허용하면 지구력에 특화된 자가 극단적으로 유리해지기 때문이다.
			PRINTFORML 「나에게 도전하겠다는 마음만 고맙게 받도록 하지」
			PRINTFORML 「규칙을 지키며 즐겁게 듀얼하자!!!」
			;合言葉的な
			RETURN 1
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			RETURN 0
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				RETURN 0
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			RETURN 0
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		PRINTFORML 「오, 대행 수고했어~」
		PRINTFORML 「미안해, 갑자기 일 시켜서. 아, 돈은 내 방 서랍에 있으니까 마음대로 가져가도 돼-」
		PRINTFORML 카나코는 텐구와 카pp파에게 지시를 내리거나 사무 처리를 하면서 %조사처리(CALLNAME:MASTER,"를")% 뒤지라고 말했다.
		PRINTFORML 지금이라면 팬티님도 마음껏 뒤져도 되는 건가?
		PRINTFORML %CALLNAME:MASTER%안에서 분홍색 욕망이 소용돌이치기 시작했다……。
		;最初っから渦巻いている気もする。
		RETURN 1
	CASE "失敗報告時"
		;なにかきゃいいんだろう
		PRINTFORML 「%CALLNAME:MASTER%이전에 천벌을 빠졌나?」
		PRINTFORML 첫 만남에서 %조사처리(CALLNAME:MASTER,"는")% 칸나코에게 그렇게 들었다.
		PRINTFORML 분명 의뢰인에게 패배했다는 것을 보고하지 못했던 것 같다.
		PRINTFORML 「뭐 쓰러뜨리지 못했다면 어쩔 수 없으니 거기 대해서는 화낼 수 없지만, 보고만은 해 둬야 한다.」
		PRINTFORML 「언젠가 %조사처리(CALLNAME:MASTER,"에게")% 하늘의 벌을 내릴 거야☆」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
