@M_KOJO_EVENT_K32_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「응? %조사처리(CALLNAME:MASTER,"가")% 아니네. 안녕, 안녕.」
		PRINTFORML 카나코는 손을 흔들며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 「응, %CALLNAME:MASTER%.」
		PRINTFORML 카나코는 %조사처리(CALLNAME:MASTER,"에게")% 알아차리고 팔을 살랑살랑 흔들었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「어이쿠, 있었네. 방해할 거야。」
		PRINTFORML 카나코는 옷 한 벌 걸치지 않은 모습을 부끄러운 기색 없이 %NAME:MASTER%에 드러내며 씩씩하게 욕실로 들어왔다.
		PRINTFORML 너무나 노골적인 모습에 오히려 %CALLNAME:MASTER%쪽이 부끄러워졌다.
		;男あなたじゃないと違和感か？
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「~~~~♪ ……에!? 저, 있다면 있다고 말하라고요!」
		PRINTFORML 방금까지 신나게 흥얼거리던 카나코는 얼굴을 붉히고 목욕탕에서 나왔다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「무, %CALLNAME:MASTER%...... 내가 들어갈 테니 당신은 욕조에서 나오세요」
		PRINTFORML 그런 부당한......
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML 「어, 기구. 안녕 %CALLNAME:MASTER%.」
		PRINTFORML 카나코는 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들었다.
		PRINTFORML 친구 같은 느낌이 지나치다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他キャラとデート中に遭遇した
	;ARG:1にデート相手
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORML 「お읏、%CALLNAME:MASTER%……むぅ…………。」
		PRINTFORML 카나코는 가슴에 언짢은 것을 느끼고 %조사처리(CALLNAME:MASTER,"를")% 못 본 체했다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 「음, 안녕.」
		PRINTFORML 카나코는 오늘 처음 만난 %조사처리(CALLNAME:MASTER,"에게")% 손을 흔들었다.
		;朝（昼前）
		;PRINTFORML %CALLNAME:MASTER%がお茶汲みの用意をしていると寝起きの神奈子と出会った。
		;PRINTFORML 「んー、お茶くれお茶。ふぁ～～～……ねむ。」
		;昼（3時くらいから夕方まで）
		;PRINTFORML %CALLNAME:MASTER%が夕餉の献立を考えていると、神奈子と出会った。
		;PRINTFORML 「よお、何してたの？　夕飯の献立？　ちょっと早くない？」
		;実際3時くらいは早い。
		;夜（就寝時間まで）
		;PRINTFORML 「よっ、こんな夜にどうしたんだい？　あ、%CALLNAME:MASTER%も晩酌するか？」
		;PRINTFORML 神奈子はさっきまで吞んでいたであろう酒器を持ちながら%CALLNAME:MASTER%に手を振ってきた。
		;夜中に酒飲むだけの友達……
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1にデート相手、ARG:1が0の場合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接続します
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1とデート中
		IF ARG:1
			;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
