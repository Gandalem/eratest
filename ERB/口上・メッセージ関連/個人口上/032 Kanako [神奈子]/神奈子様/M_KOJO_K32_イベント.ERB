@M_KOJO_EVENT_K32_2(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時添い寝中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORML 「음, 안녕%CALLNAME:MASTER%. 내 방은 잘 잤니?」
			PRINTFORML 「귀여운 잠든 얼굴이었어.」
			PRINTFORML 카나코는 잠이 덜 깬 채 아직 멍한 %조사처리(CALLNAME:MASTER,"의")% 뺨에 키스하며 아침 인사를 했다.
			PRINTFORMW 「음, 오늘은 어떻게 보내볼까?」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORML 「음, 안녕. 이 방 좋다, 정말 잠자기 편해.」
			PRINTFORML 「게다가 희미한 술 기운도 기분 좋아...」
			;酒を幾つも醸造したり貯蔵したりしているTWあなたならたぶん部屋が酒臭いだろう……。
			PRINTFORMW 「저기、오늘 아침은 뭐야?」
			;餌付けされてあなたの部屋まで来ている神奈子様
			RETURN 1
		ENDIF
		PRINTFORML 「야, 안녕.」
		PRINTFORML 카나코는 옷을 정비하며 %조사처리(CALLNAME:MASTER,"에게")% 인사했다.
		;PRINTFORML 「ところで私達二人の自室じゃない状況ってどんな状況？」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML 아침, %조사처리(CALLNAME:MASTER,"가")% 눈을 뜨자 눈앞에 카나코의 얼굴이 보였다.
		;朝かな？ 昼じゃね？ 変えた方が良いかな？
		PRINTFORML 아무래도 안겨 있는 모양이라, 잠에서 깨는 것치 %조사처리(CALLNAME:MASTER,"의")% 몸은 꿈쩍도 하지 않는다.
		PRINTFORML 「귀여운 잠든 얼굴이었는데, 조금 더 자어도 괜찮아?」
		PRINTFORML 카나코는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 머리를 쓰다듬고 키스했다.
		PRINTFORML 「안녕, %CALLNAME:MASTER%. 오늘도 잘 부탁해?」
		;同棲状態に行ってるならもうログボにキス経験1回くらいプレゼントしたい。
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 아침, %조사처리(CALLNAME:MASTER,"가")% 눈을 뜨자 눈앞에 카나코의 가슴이 들어왔다.
		PRINTFORML 어느새 베개로 사용되고 있었던 모양이다.
		PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 카나코의 행복한 잠든 얼굴을 보고, 그녀를 깨우지 않으려고 살며 빠져나갔다…….
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or添い寝中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 눈을 뜨자마자 카나코도 일어난 것 같다.
			PRINTFORML 카나코는 머리에 잠옷 잔머리를 달고 %조사처리(CALLNAME:MASTER,"를")% 멍하니 바라보더니
			PRINTFORML 문득 양팔을 벌려 %조사처리(CALLNAME:MASTER,"에게")% 입술을 내밀었다.
			PRINTFORMW 「좋은 아침 키스... 안 돼...?」
			;添い寝まで行ってるならキスぐらい行けるでしょ……
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		PRINTFORMW 「음~ 야옹야옹, 안녕.」
		;この部分条件的には何が当てはまるんだろう？
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
