		ENDIF
		RETURN 1
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「아앗…%UNICODE(0x2665) *1%…%MASTERNAME:95%…%UNICODE(0x2665) *1%정신이 어떻게 될 것 같아앗…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응앗…%UNICODE(0x2665) *1%…싫어앗…%UNICODE(0x2665) *1%안 돼앳…%UNICODE(0x2665) *1%」
		ELSE
