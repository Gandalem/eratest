		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「으앗…%UNICODE(0x2665) *1%…%MASTERNAME:95%…%UNICODE(0x2665) *1%정말앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
