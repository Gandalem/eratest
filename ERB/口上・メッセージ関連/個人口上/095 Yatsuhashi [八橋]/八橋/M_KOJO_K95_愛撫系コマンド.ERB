		ENDIF
		RETURN 1
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「%MASTERNAME:95%…가슴만 만지지 말아줘…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
