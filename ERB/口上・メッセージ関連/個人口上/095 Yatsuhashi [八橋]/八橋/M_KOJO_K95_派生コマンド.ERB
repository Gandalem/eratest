@M_KOJO_MESSAGE_SCOM_K95_1
CALL M_KOJO_MESSAGE_SCOM_K95_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K95_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「응%UNICODE(0x2665) *1%응%UNICODE(0x2665) *1%읏%UNICODE(0x2665) *1%츄릅%UNICODE(0x2665) *1%낼름%UNICODE(0x2665) *1%음푹%UNICODE(0x2665) *1%푹%UNICODE(0x2665) *1%」
			PRINTFORMW 「정액 가득…%UNICODE(0x2665) *1%…내보내줘…%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「쭈욱%UNICODE(0x2665) *1% 츄릅%UNICODE(0x2665) *1% 낼름%UNICODE(0x2665) *1% 쭈욱%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「이상한 맛이긴 한데…%UNICODE(0x2665) *1%…나쁘진 않을지도…%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「암읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%츄읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「%MASTERNAME:95%의 정자, 입 안에 내줘%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%쪽%UNICODE(0x2665) *1%츄릅…%UNICODE(0x2665) *1%…낼름%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「응읏%UNICODE(0x2665) *1%낼름%UNICODE(0x2665) *1%쪽%UNICODE(0x2665) *1%츄릅%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%낼름%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%쪽%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「낼름%UNICODE(0x2665) *1%응읏%UNICODE(0x2665) *1%」
			PRINTFORMW 「%MASTERNAME:95%기분 좋아…?」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「%MASTERNAME:95%, 입으로 해 줄게... %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「멍청이 %UNICODE(0x2665) *1% 저리 가라 %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「후훗, 이런 건 나한테 자신 있을지도 몰라...%UNICODE(0x2665) *1%」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「츄릅%UNICODE(0x2665) *1% 핥아앗%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1% 응읏%UNICODE(0x2665) *1% 핥아앗%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「……응읏%UNICODE(0x2665) *1%으응읏……%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「츄%UNICODE(0x2665) *1%낼름%UNICODE(0x2665) *1%」
			PRINTFORMW 「입으로 기분 좋게 해줄게…%UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
