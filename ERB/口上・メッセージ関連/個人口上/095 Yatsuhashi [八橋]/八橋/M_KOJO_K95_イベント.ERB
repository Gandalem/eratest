@M_KOJO_SPEVENT_K95_1(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	PRINTFORMW 「후우... 오늘은 즐거웠네, %CALLNAME:MASTER%」
	PRINTFORMDW 야츠하시는 그렇게 말하면서 불안하게 안절부절못하고 있다.
	PRINTFORMW 「아, 저기 있잖아요, 이쪽을 봐줄 수 있을까요...?」
	PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 야츠시 쪽으로 고개를 돌리자, 야츠시는 발끝으로 서서 기지개를 켜고,
	PRINTFORMW 
	PRINTFORMW 「쪽...」
	PRINTFORMW 
	PRINTFORMDW 얼굴을 들자 야츠하가 환한 미소로 나를 바라보고 있었다.
	PRINTFORMW 「...에헤헤, 처음이었거든, 나의 키스」
	PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 멍하니 있는 사이
	PRINTFORMW 「이런 건 말이야, 사람은 좋아하는 사람에게 하는 거야, 언니가 그랬어」
	PRINTFORMW 「그럼 안녕, 잘 가!」
	PRINTFORMDW 야츠하는 그렇게 말하고 가버렸다.
	;キスをキャンセルしたい場合は以下を開放
	;TCVAR:キスキャンセル = 1
ENDIF
RETURN 1
;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_SPEVENT_MESSAGECHECK_K95_2
RETURN 1

@M_KOJO_SPEVENT_K95_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1095)
			PRINTFORMW 「있잖아 %CALLNAME:MASTER%」
			PRINTFORMW 「나 말이야, 좋아하는 사람이 생겼어」
			PRINTFORMW 「그 사람은 말이야, 상냥하고, 멋있고, 성실해서」
			PRINTFORMW 「울고 있을 때도 그 사람과 이야기하다 보면 기운을 차릴 수 있었어」
			PRINTFORMW 「이런 때 어떻게 해야 할지 누나에게 물어봤는데」
			PRINTFORMW 「『그건 스스로 결정하렴』이라는 말을 들었어」
			PRINTFORMW 「나 말이야, 부속신(付喪神)이 된 후에도 혼자서는 아무것도 할 수 없었거든」
			PRINTFORMW 「누나나 라이코 씨에게 업혀서 안겨 있었지」
			PRINTFORMW 「하지만 있잖아, 언제까지 그런 식일 수는 없고」
			PRINTFORMW 「두 분보다 소중한 사람이 생겼어」
			PRINTFORMW 「%CALLNAME:MASTER%」
			PRINTFORMW 「나는 %조사처리(CALLNAME:MASTER,"를")% 좋아해」
			PRINTFORMW 「세상 누구보다, %조사처리(CALLNAME:MASTER,"를")% 정말 좋아해!」
			;			PRINTFORMW 「わ、私は…その…姉さんや雷鼓さんや他のみんなみたいに華は無いけど…」
			PRINTFORMW 「나, 당신의 전부가 되고 싶어!」
			PRINTFORMW 「저랑 연인이 되어 주세요!」
			;二回目の告白
		ELSE
			PRINTFORMW 「있잖아, %CALLNAME:MASTER%」
			PRINTFORMDW 귀로 돌아오자 야츠하시가 결심한 듯 입을 열었다.
			PRINTFORMW 「아주 잠깐이라도 좋으니 나를 봐줘」
			PRINTFORMDW 야츠하시는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 뒤돌아보게 했다.
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 만날수록 더 좋아져서」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 만나지 않으면 외로워서」
			PRINTFORMW 「이런 걸 어떡해야 할지... 모르겠어서」
			PRINTFORMW 「어떻게든... 연인이 되어주지 않겠어...?」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「…흐윽…」
		PRINTFORMDW 야츠하시는 얼굴을 새빨갛게 물린 채 흐느꼈다.
		PRINTFORMW 「응… 고마워…」
		PRINTFORMDW 그렇게 말하자 야츠하는 안아왔다.
		PRINTFORMW 「%CALLNAME:MASTER%… 정말 좋아해…」
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 야츠하의 머리를 쓰다듬으며 한동안 그대로 있는 것으로 했다.
		PRINTFORMW (조금 더… 이대로…)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「음...으...」
		PRINTFORMW 「알, 알았어」
		PRINTFORMW 「그럼 안녕, %CALLNAME:MASTER%」
		PRINTFORMDW 야츠하시는 그렇게 말하고 떠났다.
		PRINTFORMW (만약, 만약이지만...)
		PRINTFORMW (누구보다 빨리... %조사처리(CALLNAME:MASTER,"에게")%... 만났다면...)
		PRINTFORMW (차라리...)
		RETURN 1
	ENDIF
ENDIF
RETURN 1
;==================================================
;デート帰り
;==================================================

@M_KOJO_SPEVENT_K95_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「...안녕」
		ELSEIF TALENT:恋人
			PRINTFORMW 「…오늘은 즐거웠어, 고마워 %MASTERNAME:95%!」
			PRINTFORMDW 야츠하시는 그렇게 말하며 %CALLNAME:MASTER%쪽으로 몸을 돌려 인사했다.
			PRINTFORMW 「역시 %MASTERNAME:95%이랑 함께 있는 건 좋네.」
			PRINTFORMW 「내일도 또 데이트하자! …약속이야」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「후후, 오늘은 즐거웠어.」
			PRINTFORMW 「%MASTERNAME:95%, 당신은 어땠어?」
			PRINTFORMW 「...만약 %CALLNAME:MASTER%마저 괜찮다면 내일도―」
			PRINTFORMW 「...역시 아무것도 아니야, 그럼 잘 가!」
			PRINTFORMDW 야츠하시는 그렇게 말하며 아쉬운 듯 손을 흔들고 떠났다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「그럼, 또 내일!」
			PRINTFORMDW 야츠하시는 그렇게 말하고 서둘러 돌아갔다.
			PRINTFORMW (…또 내일… 만날 수 있다면…)
			PRINTW
		ELSE
			PRINTFORMW 「음... 이제 돌아갈게」
			PRINTFORMW 「%MASTERNAME:95%도 일찍 자는 게 좋아, 밤샘은 몸에 안 좋으니까」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「...알았어, 용서해 줄게」
			PRINTFORMW 「하지만 말이야... 너무 나쁜 짓 하지 마?」
			PRINTFORMW 「%MASTERNAME:95%을 믿고 있으니까?」
		ELSE
			PRINTFORMW 「응, 괜찮지만 말이야」
			PRINTFORMW 「너무 사람 화나게 하는 건 하지 않는 게 좋아」
			PRINTFORMW 「나는 상냥하니까 용서해 주겠지만」
			PRINTFORMDW 야츠하시는 어딘가 서툰 미소로 그렇게 말했다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「…흥!」
			PRINTFORMW 「아직 화난 거니까 말이야!」
			PRINTFORMW 「%MASTERNAME:95% 같은 걸 그렇게 쉽게 믿어주지 않아!」
		ELSE
			PRINTFORMW 「...아직 싫어」
			PRINTFORMW 「하지만 %MASTERNAME:95%니까 조금 용서해 줄게...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「...아직 싫어」
			PRINTFORMW 「하지만 %MASTERNAME:95%니까 조금 용서해 줄게...」
			PRINTFORMW 「...별거 아니야!」
			PRINTFORMW 「언제까지 화내고 있을 건 아니잖아...」
		ELSE
			PRINTFORMW 「...좋아 줄게」
			PRINTFORMW 「조금만... 용서해 주겠어!」
		ENDIF
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1
