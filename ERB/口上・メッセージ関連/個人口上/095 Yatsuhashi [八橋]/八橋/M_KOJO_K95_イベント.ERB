IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を見られた（目撃者の馴れ合い度:低）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		IF TALENT:恋人
			PRINTFORMW 「어쩌지... 들켜버렸네」
			PRINTFORMW 「계속 어떻게 할까...?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「아…」
			PRINTFORMDW 야츠하시는 말문이 막히자
			PRINTFORMW 「어떻게 할 거야?」
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 행위의 계속을 물었다.
		ELSEIF TALENT:思慕
			PRINTFORMW 「...아아」
			PRINTFORMW 「귀찮은 일이 생기지 않았으면 좋겠는데...」
		ELSE
			PRINTFORMW 「...안 될지도...」
			PRINTFORMDW 야츠하시는 그렇게 말하며 몸을 떠났다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が負けじと参加（目撃者の馴れ合い度:高）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF TALENT:恋人
			PRINTFORMW 「음... 뭐 상관없지만...」
			PRINTFORMW 「본처의 여유 같은 건가?」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「아, 어...?」
			PRINTFORMW 「아니 뭐 세 명으로 해도... 괜찮지만...」
		ELSEIF TALENT:思慕
			PRINTFORMW 「...음우...」
			PRINTFORMW 「이런 건 별로 좋아하지 않지만...」
		ELSE
			PRINTFORMW 「…」
			PRINTFORMDW 야츠하시는 조금 토라진 듯 고개를 돌렸다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が立ち去る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		IF TALENT:恋人
			PRINTFORMW 「후후, 소문이 나버릴지도 모르겠네...%UNICODE(0x2665) *1%」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「...맛없을지도 모르겠네, 이거」
		ELSEIF TALENT:思慕
			PRINTFORMW 「음...」
			PRINTFORMW 「이거 괜찮을까...」
		ELSE
			PRINTFORMW 「…아차…」
			PRINTFORMDW 야츠하시는 약간 불안한 듯 얼굴을 찌푸렸다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて目撃者も参加
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG:1 == 4
	;PRINTFORML
	;RETURN 1
	;ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
