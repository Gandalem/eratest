@M_KOJO_EVENT_K95_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;仕事中ではなく、今日会ってない。
	IF !TCVAR:95:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中
			IF CFLAG:行動 == 5 && !TCVAR:95:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「%MASTERNAME:95%도 라이브 보러 와줬어? 기쁘네♪」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K95
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「………」
					PRINTFORMW 「뭐야, %MASTERNAME:95%인가」
				ELSEIF TALENT:恋人
					PRINTFORMW 「아, %MASTERNAME:95%잖아!」
					PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"에게")% 눈치채고 손을 흔들며 활기차게 인사했다.
					PRINTFORMW 「저기 저기 오늘은 뭐 할 거야?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「응? %MASTERNAME:95%?」
					PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"를")% 알아차리자
					PRINTFORMW 「뭐...뭔가!?」
					PRINTFORMDW 살짝 얼굴을 붉히며 방으로 들였다.
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:95%? 건강해 보이네」
					PRINTFORMW 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 모습을 확인하고 이쪽을 돌아와 인사했다.
