@M_KOJO_EVENT_K95_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERを押し倒した（開始時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「...에이야!」
			PRINTFORMDW 야츠하시가 외침과 함께 %조사처리(CALLNAME:MASTER,"를")% 밀어붙였다!
			PRINTFORMW 「연인 같은 거 하자 %UNICODE(0x2665) *1%」
			PRINTFORMDW 그렇게 말하며 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗고 옷을 벗겨 나간다.
			PRINTFORMW 「오늘은 재우지 않을 테니까 말이야!」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「있잖아, %MASTERNAME:95%!」
			PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 이름을 부르더니
			PRINTFORMW 「%MASTERNAME:95%, 정말 좋아해」
			PRINTFORMDW 그렇게 말하며 상대를 다정하게 밀어붙였다.
			PRINTFORMW 「...나 지금 에로한 기분이야... %UNICODE(0x2665) *1%」
			PRINTFORMDW 야츠하시는 어린아이 같은 모습을 남기면서도 요염하게 %조사처리(CALLNAME:MASTER,"의")% 입술을 빼앗았다.
		ELSE
			PRINTFORMW 「...저기 %MASTERNAME:95%」
			PRINTFORMDW 야츠하시가 %조사처리(CALLNAME:MASTER,"를")% 밀어붙였다.
			PRINTFORMW 「...여자한테도 흥분할 때가 있는 거구나」
			PRINTFORMDW 그렇게 말하며 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 가슴팍을 벌리고 키스했다.
			PRINTFORMW 「응... 이런 거, 싫어해?」
			PRINTFORMDW 야츠하시는 그렇게 말하면서 %조사처리(CALLNAME:MASTER,"를")% 마음대로 하려고 하고 있다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;なだめられた（終了時）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE ARG:1
			CASE 0
				;抜け出した
				IF TALENT:恋人
					PRINTFORMW 「음... 벌써 끝이야?」
					PRINTFORMDW 야츠하시는 조금 아쉬운 듯 몸을 뗐다.
				ELSEIF TALENT:恋慕
					PRINTFORMW 「음...?」
					PRINTFORMDW 야츠하시는 아쉬운 듯 가슴 쪽에서 떨어지지 않는다.
					PRINTFORMW 「알았어...」
					PRINTFORMDW 야츠하시는 마지못해 몸을 돌려 떠났다.
				ELSE
					PRINTFORMW 「？」
					PRINTFORMW 「...이걸로 끝이야?」
					PRINTFORMDW 야츠하시는 어리둥절한 표정으로 몸을 떼고 떠났다.
				ENDIF
				RETURN 1
			CASE 1
				;抱き着きモード満足終了
				PRINTFORML
				RETURN 1
			CASE 2
				;抱き着きモード強制終了
				PRINTFORML
				RETURN 1
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;抜け出す失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE ARG:1
			CASE 1
				;好きにして状態から抜け出せなかった
				PRINTFORML
				RETURN 1
			CASE 2
				;欲求不満が高くて抜け出せなかった
				PRINTFORML
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
;==================================================
;浴場で遭遇
;==================================================

