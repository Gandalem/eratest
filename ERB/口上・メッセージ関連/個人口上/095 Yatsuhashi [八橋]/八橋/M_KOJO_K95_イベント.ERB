				PRINTFORML
				RETURN 1
			CASE 2
			;欲求不満が高くて抜け出せなかった
				PRINTFORML
				RETURN 1
		ENDSELECT
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

