@M_KOJO_EVENT_K95_11(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:318 == 1
			PRINTFORMW 「…覗き魔…！」
		ELSEIF TALENT:恋人
			PRINTFORMW 「…一人で入りたいから…ごめんね」
			PRINTFORMDW 八橋は少し申し訳なさそうに%CALLNAME:MASTER%を追い出した。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「…えっと…一人で入りたいかなって…」
			PRINTFORMDW 八橋は申し訳なさそうに%CALLNAME:MASTER%を浴場から追い出した。
			
		ELSEIF TALENT:思慕
			PRINTFORMW 「………！」
			PRINTFORMW 「出てって…」
			PRINTFORMDW 八橋は湯船に沈みながら%CALLNAME:MASTER%を追い出した。
		ELSE
			PRINTFORMW 「…！？」
			PRINTFORMW 「馬鹿！」
			PRINTFORMDW 八橋は顔を赤らめながら%CALLNAME:MASTER%を浴場から追い出した。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目が合った（追い出されない）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:318 == 1
			PRINTFORMW 「…こっち見たら怒るからね！」
			PRINTFORMDW …八橋はそう怒ったように怒鳴った。
		ELSEIF TALENT:恋人
			PRINTFORMW 「…たまには混浴もいいかもね…」
			PRINTFORMDW 八橋は少し恥ずかしそうに%CALLNAME:MASTER%を見つめている。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「…背中とか流してあげよっか？」
			PRINTFORMDW 八橋は悪戯っぽく%CALLNAME:MASTER%を見つめている。
		ELSEIF TALENT:思慕
			PRINTFORMW 「………！」
			PRINTFORMW 「変なことはしないでね…」
			PRINTFORMDW 八橋は湯船に沈みながら%CALLNAME:MASTER%を見つめている。
		ELSE
			PRINTFORMW 「…！」
			PRINTFORMW 「別にこれくらいいいけど…」
			PRINTFORMDW 八橋は顔を赤らめながら%CALLNAME:MASTER%を見つめている。
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

;==================================================
;寝床に忍び込み
;==================================================
@M_KOJO_EVENT_K95_12(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;追い出される（怒り）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「駄目だって！疲れてるの！」
			PRINTFORMDW 八橋は%CALLNAME:MASTER%を追い出してきた。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「もう！出てって！」
			PRINTFORMDW 八橋は部屋から追い出してきた。
			PRINTFORMW 「馬鹿…」
		ELSEIF TALENT:思慕
			PRINTFORMW 「出てけ！」
			PRINTFORMDW 八橋はそう言って%CALLNAME:MASTER%を追い出してきた。
		ELSE
			PRINTFORMDW 八橋は寝床への侵入者に気づくと
			PRINTFORMW 「…馬鹿…！出てけ！」
			PRINTFORMDW 怒ったように追い出してきた。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		IF TALENT:恋人
			PRINTFORMW 「んん…どうしたの？%MASTERNAME:95%」
			PRINTFORMDW 八橋は%CALLNAME:MASTER%を招き入れた。
		ELSE
			PRINTFORMDW 八橋は寝床への侵入者に気づくと
			PRINTFORMW 「…何か用なの？」
			PRINTFORMDW 少し不機嫌そうに招き入れた。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;寝床に侵入（相手が恋慕・衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORMW 「ん…何？疲れてるんだけど」
		PRINTFORMDW 八橋は%CALLNAME:MASTER%を招き入れた。
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		IF TALENT:恋人
			PRINTFORMW 「駄目…今日は…ごめんね…」
			PRINTFORMDW 八橋は%CALLNAME:MASTER%を追い出してきた。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「もう一人にして…ね」
			PRINTFORMDW 八橋は部屋から追い出してきた。
			PRINTFORMW （悪かった…かな？）
		ELSEIF TALENT:思慕
			PRINTFORMW 「今日は一人がいいのごめんね」
			PRINTFORMDW 八橋はそう言って%CALLNAME:MASTER%を追い出してきた。
		ELSE
			PRINTFORMDW 八橋は寝床への侵入者に気づくと
			PRINTFORMW 「…もう、出てってよ」
			PRINTFORMDW 少し怒ったように追い出してきた。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;追い出される（衰弱）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5
		IF TALENT:恋人
			PRINTFORMW 「疲れてるの…ごめん…」
			PRINTFORMDW 八橋は%CALLNAME:MASTER%を追い出してきた。
		ELSEIF TALENT:恋慕
			PRINTFORMW 「ごめん…今日はもうダメ…」
			PRINTFORMDW 八橋は部屋から追い出してきた。
			PRINTFORMW 「また明日、ね」
		ELSEIF TALENT:思慕
			PRINTFORMW 「今日はもう疲れたから、%MASTERNAME:95%も帰ったら？」
			PRINTFORMDW 八橋はそう言って%CALLNAME:MASTER%を追い出してきた。
		ELSE
			PRINTFORMDW 八橋は寝床への侵入者に気づくと
			PRINTFORMW 「…疲れてるから…ね？」
			PRINTFORMDW 少し怒ったように追い出してきた。
		ENDIF
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

