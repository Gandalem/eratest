;==================================================
;時止め終了時
;==================================================
@M_KOJO_EVENT_K95_17(ARG,ARG:1)
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ARG=1～3は排他
	;謎の快感
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋慕
			PRINTFORMW 「～～～！？」
			PRINTFORMDW 八橋は唐突な快感に身悶えしている。
			PRINTFORMW 「なんでもない…！何でもないから…！」
			PRINTFORMDW 八橋は快楽に耐えながら必死に何でもない風を装っている。
			PRINTFORMW （こんなの…%CALLNAME:MASTER%に見られたくない…！）
		ELSE
			PRINTFORMW 「～～～！？」
			PRINTFORMDW 八橋はビクッと体を震わせ
			PRINTFORMW 「何でも…ないわ…」
			PRINTFORMW （…やだ…何よ…もう…）
			PRINTFORMDW 八橋はあまり経験のない快楽に涙目になっている。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋慕
			PRINTFORMW 「！？！？！？」
			PRINTFORMDW 八橋は一瞬でへたり込んでしまい何があったのか理解できないようだ。
			PRINTFORMW 「…ふぇ…やだぁ…」
			PRINTFORMDW 彼女は差し出された手を取りながらもう片方の手で涙を拭っている。
		ELSE
			PRINTFORMW 「んあっ%UNICODE(0x2665) *1%」
			PRINTFORMW 「…や…ぁ…」
			PRINTFORMDW 突然快楽を叩き込まれた八橋はうずくまってしまった。
			PRINTFORMW 「何…？…何！？」
			PRINTFORMDW 八橋は困惑しながら体に手を回して泣いている。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;パンツ紛失
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「…んん！？」
		PRINTFORMDW 八橋は急にスカートを両手で押さえつけた！
		PRINTFORMDW どうも下着を盗ったため違和感を覚えたようだ。
		PRINTFORMW 「…や、やだ…！？何よこれ…！」
		PRINTFORMDW 八橋は下着が無いことに困惑している。
		PRINTFORMDW 少なくとも彼女にとってノーパンは初めてだったようだ。
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚口内射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;精液中毒低精飲
		IF ARG:1 == 1
			IF EXP:精液経験 == 0
				PRINTFORMW 「んえぇ！？」
				PRINTFORMDW 八橋は口の中に流し込まれた子種に驚いている。
				PRINTFORMW 「うぇっ…何…何…！？」
				PRINTFORMW 「何なのよ…もう…」
				PRINTFORMDW 八橋は至極不快そうな顔をしながらゆっくりとどうにか精液を飲み下した。
			ELSE
				PRINTFORMW 「…ん！？」
				PRINTFORMDW 八橋は突然口を押さえ体を震わせながら膝から崩れ落ちた。
				PRINTFORMW 「うぇ…んん…」
				PRINTFORMDW 口内に残る子種をどうにかして処理しようか寸瞬迷った後
				PRINTFORMW 「ん…んっく…」
				PRINTFORMDW 飲み込むことにしたようだ。
				PRINTFORMW 「何よ…もう…」
			ENDIF
		;精液中毒低吐き出し
		ELSEIF ARG:1 == 2
			PRINTFORMW 「ん！？」
			PRINTFORMW 「げほっおぇ…」
			PRINTFORMDW 八橋は突然口内に現れたザーメンの臭いと苦味に顔をしかめ咳き込んだ。
			PRINTFORMW 「何なのよもう…」
		;精液中毒低手で覆う
		ELSEIF ARG:1 == 3
			PRINTFORMW 「！？」
			PRINTFORMW 「ん…ぐぇ…うっ…」
			PRINTFORMDW 八橋は涙目になりながら口を押さえている…
		;精液中毒高精飲
		ELSEIF ARG:1 == 4
			PRINTFORMW 「…ん！？」
			PRINTFORMDW 八橋は突然口の中に流し込まれたザーメンを困惑しながら飲み下した。
			PRINTFORMW 「…んんっ…なんなの…」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚顔面射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		;幼稚持ち＆精液経験100未満
		IF ARG:1 == 1
		;通常ぬぐい取り
		ELSEIF ARG:1 == 2
			PRINTFORMW 「…んん！？」
			PRINTFORMDW 八橋は顔面にへばりついた精液に気がつくと
			PRINTFORMW 「何よ…これ…」
			PRINTFORMDW 取り乱しながら拭い取った。
		;顔射精液舐めとり
		ELSEIF ARG:1 == 3
			PRINTFORMW 「…んぇ！？」
			PRINTFORMDW 八橋は顔面にへばりついた精液に気がつくと
			PRINTFORMW 「…ん…れろ…美味し…%UNICODE(0x2665) *1%」
			PRINTFORMDW 美味しそうに舐めとった。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚手淫射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		;ぬぐい取り
		IF ARG:1 == 1
			PRINTFORMW 「…！？」
			PRINTFORMDW 八橋は手にへばりついた精液に気がつくと
			PRINTFORMW 「…な…何よこれ！？」
			PRINTFORMDW 取り乱しながら拭い取った。
		;舐めとり
		ELSEIF ARG:1 == 2
			PRINTFORMW 「…うぇ！？」
			PRINTFORMDW 八橋は手にへばりついた精液に気がつくと
			PRINTFORMW 「ん…れろ…ちゅ…%UNICODE(0x2665) *1%」
			PRINTFORMDW 妖艶に舐めとった。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚アナル射精】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;Ａ感覚0
		IF ARG:1 == 1
			PRINTFORMW 「ひぎぃ！何！？何！？」
			PRINTFORMDW 八橋はアナルに違和感を覚えたが、その正体まではわからないようだ。
		;ソレ以外
		ELSEIF ARG:1 == 2
			PRINTFORMW 「…んひ！？」
			PRINTFORMDW 八橋はアナルの違和感に気づくと
			PRINTFORMW 「…何！？何なのよ…もう…」
			PRINTFORMDW お尻を押さえながら辺りを睨みつけている。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;【無自覚処女喪失】
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 「…うっ！？」
		PRINTFORMDW 八橋は下腹部の鈍痛に顔をしかめると
		PRINTFORMW 「………？」
		PRINTFORMDW 唇を噛み締めながら悪寒に冷や汗をかいている。
		RETURN 1
	ENDIF
