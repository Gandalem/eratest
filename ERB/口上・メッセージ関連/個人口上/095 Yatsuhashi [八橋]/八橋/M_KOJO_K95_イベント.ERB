;==================================================
;デート帰りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_K95_2
RETURN 1

@M_KOJO_SPEVENT_K95_2(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示後に受けるかどうかの選択分が表示されます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1095)
			PRINTFORMW 「ねえ%CALLNAME:MASTER%」
			PRINTFORMW 「私ね、好きな人が出来たの」
			PRINTFORMW 「その人はね、優しくて、格好良くて、真面目で」
			PRINTFORMW 「落ち込んでる時もその人と話してると元気になれたの」
			PRINTFORMW 「こういう時どうしたらいいのって姉さんに聞いたんだけど」
			PRINTFORMW 「『それは自分で決めなさい』って言われちゃった」
			PRINTFORMW 「私ね、付喪神になってからも一人じゃ何も出来なかったの」
			PRINTFORMW 「姉さんや雷鼓さんにおんぶにだっこ」
			PRINTFORMW 「でもね、いつまでもそういう訳にもいかないし」
			PRINTFORMW 「二人よりも大切な人が出来たんだ」
			PRINTFORMW 「%CALLNAME:MASTER%」
			PRINTFORMW 「私は%CALLNAME:MASTER%のことが好き」
			PRINTFORMW 「世界中の誰よりも、%CALLNAME:MASTER%のことが大好き！」
;			PRINTFORMW 「わ、私は…その…姉さんや雷鼓さんや他のみんなみたいに華は無いけど…」
			PRINTFORMW 「私、あなたの一番になりたい！」
			PRINTFORMW 「私と恋人になって下さい！」
		;二回目の告白
		ELSE
			PRINTFORMW 「あのね、%CALLNAME:MASTER%」
			PRINTFORMDW 帰路に着くと八橋は意を決したように口を開いた。
			PRINTFORMW 「ほんの少しだけでもいいから私を見て」
			PRINTFORMDW 八橋はそう言って%CALLNAME:MASTER%を振り向かせた。
			PRINTFORMW 「%CALLNAME:MASTER%と会えば会うほど好きになって」
			PRINTFORMW 「%CALLNAME:MASTER%と会わないと寂しくて」
			PRINTFORMW 「こんなのどうしていいかなんて…分からなくて」
			PRINTFORMW 「どうしても…恋人になってもらえませんか…？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白オッケー（恋人が付く）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「…ふぇ…」
		PRINTFORMDW 八橋は顔を真っ赤にしながら嗚咽を漏らした。
		PRINTFORMW 「んっ…ありがとう…」
		PRINTFORMDW そう言うと八橋は抱きついてきた。
		PRINTFORMW 「%CALLNAME:MASTER%…大好き…」
		PRINTFORMDW %CALLNAME:MASTER%は八橋の頭を撫でながらしばらくそのままでいることにした。
		PRINTFORMW （もう少し…このまま…）
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「む…ぅ…」
		PRINTFORMW 「わ、わかったわ」
		PRINTFORMW 「じゃあね、%CALLNAME:MASTER%」
		PRINTFORMDW 八橋はそう言って去っていった。
		PRINTFORMW （もし、もしもだけど…）
		PRINTFORMW （誰よりも早く…%CALLNAME:MASTER%に…会ってたら…）
		PRINTFORMW （いっそ…）
		RETURN 1
	ENDIF

ENDIF
RETURN 1

;==================================================
;デート帰り
;==================================================
@M_KOJO_SPEVENT_K95_3(ARG,ARG:1)
;口上主はTARGET
;地の文表示
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常帰宅
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:318 == 1
			PRINTFORMW 「…ばいばい」
		ELSEIF TALENT:恋人
			PRINTFORMW 「…今日は楽しかったわ、ありがとうね、%MASTERNAME:95%！」
			PRINTFORMDW 八橋はそう言いながら%CALLNAME:MASTER%の方へ向き直って礼を言った。
			PRINTFORMW 「やっぱり%MASTERNAME:95%と一緒に過ごすのっていいわね」
			PRINTFORMW 「明日もまた、デートしましょ！…約束よ」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「ふふ、今日は楽しかった」
			PRINTFORMW 「%MASTERNAME:95%、貴方はどうだった？」
			PRINTFORMW 「…もし、%CALLNAME:MASTER%さえよければ明日も―」
			PRINTFORMW 「…やっぱりなんでもないわ、じゃあね！」
			PRINTFORMDW 八橋はそう言って名残惜しげに手を振って去っていった。
		ELSEIF TALENT:思慕
			PRINTFORMW 「じゃあね、また明日！」
			PRINTFORMDW 八橋はそう言ってそそくさと帰っていった。
			PRINTFORMW （…また明日…会えたら…）
			PRINTW
		ELSE
			PRINTFORMW 「ん…もう帰るね」
			PRINTFORMW 「%MASTERNAME:95%も早く寝たほうがいいわよ、夜更かしは体に悪いからね」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印消去イベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「…わかった、許したげる」
			PRINTFORMW 「でもね…あんまり悪いことしないでよ？」
			PRINTFORMW 「%MASTERNAME:95%のこと、信じてるからね？」
		ELSE
			PRINTFORMW 「ん、いいけどさ」
			PRINTFORMW 「あんまり人怒らせること、しないほうがいいよ」
			PRINTFORMW 「私は優しいから許してあげるけど」
			PRINTFORMDW 八橋はどこかぎこちない笑顔でそう言った。
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印2>1レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「…ふん！」
			PRINTFORMW 「まだ怒ってるからね！」
			PRINTFORMW 「%MASTERNAME:95%のことそう簡単に信用してあげないんだから！」
		ELSE
			PRINTFORMW 「…まだ嫌い」
			PRINTFORMW 「だけど%MASTERNAME:95%だからちょっと許したげる…」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;反発刻印3>2レベルダウンイベント
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:恋人
			PRINTFORMW 「…まだ嫌い」
			PRINTFORMW 「だけど%MASTERNAME:95%だからちょっと許したげる…」
			PRINTFORMW 「…別に！」
			PRINTFORMW 「いつまでも怒ってるってわけじゃないわ…」
		ELSE
			PRINTFORMW 「…いいわよ」
			PRINTFORMW 「少しだけ…許したげる！」
		ENDIF
		RETURN 1
	ENDIF
	PRINTFORML
ENDIF
RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K95_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;仕事中ではなく、今日会ってない。
	IF !TCVAR:95:今日会ったか
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;仕事中
			IF CFLAG:行動 == 5 && !TCVAR:95:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「%MASTERNAME:95%もライブ見に来てくれたの？嬉しいな♪」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K95
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「………」
					PRINTFORMW 「なんだ、%MASTERNAME:95%か」
				ELSEIF TALENT:恋人
					PRINTFORMW 「あ、%MASTERNAME:95%じゃん！」
					PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと手を振って元気に挨拶をしてきた。
					PRINTFORMW 「ねえねえ今日は何するの？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「ん？%MASTERNAME:95%？」
					PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと
					PRINTFORMW 「な‥何かな！？」
					PRINTFORMDW 少し顔を赤らめて部屋に迎え入れた。
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:95%？元気そうね」
					PRINTFORMW 八橋は%CALLNAME:MASTER%の姿を確認するとこちらを振り向いて挨拶してきた。
					PRINTFORMW 「今日は何してんの？%MASTERNAME:95%」
				ELSE
					PRINTFORMW 「わっほーい！%MASTERNAME:95%元気ー？」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;仕事中
			IF CFLAG:行動 == 5 && !TCVAR:95:今日会ったか && !INRANGE(CFLAG:職種, 48, 51) ;custom code
				PRINTFORMW 「%MASTERNAME:95%もライブ見に来てくれたの？嬉しいな♪」
			ELSE
				;正月、バレンタイン、ハロウィン、クリスマスの場合
				IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
					CALL SPECIALDAY_EVENT_K95
				ELSEIF CFLAG:318 == 1
					PRINTFORMW 「………ふんっ」
					PRINTFORMW 「なんだ、%MASTERNAME:95%か」
				ELSEIF TALENT:恋人
					PRINTFORMW 「わっはー！%MASTERNAME:95%じゃん！」
					PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと手を振って元気に挨拶をしてきた。
					PRINTFORMW 「こんなとこで何やってるのー？面白いことしてるなら混ぜてよ！」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「おー！？%MASTERNAME:95%？」
					PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと
					PRINTFORMW 「何やってんの？」
				ELSEIF TALENT:思慕
					PRINTFORMW 「%MASTERNAME:95%！元気してた？」
					PRINTFORMDW 八橋は%CALLNAME:MASTER%の姿を確認すると近づきながら挨拶してきた。
					PRINTFORMW 「今日は何してんの？%MASTERNAME:95%？」
				ELSE
					PRINTFORMW 「わっほーい！%MASTERNAME:95%元気ー？」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて一緒に入る
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF CFLAG:318 == 1
				PRINTFORMW 「…まあ…」
				PRINTFORMW 「構わないけど…こっち見ないでよ」
			ELSEIF TALENT:恋人
				PRINTFORMW 「%MASTERNAME:95%？」
				PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと一度湯船に体を沈めながら招き入れた。
				PRINTFORMW 「一緒にお風呂入ろ？背中ぐらい流したげる！」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「ふえ！？%MASTERNAME:95%！？」
				PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと
				PRINTFORMW 「入ってもいいけど…変なことしないでね…？」
				PRINTFORMDW そう言って湯船に招き入れた。
			ELSEIF TALENT:思慕
				PRINTFORMW 「%MASTERNAME:95%！？な…なんで…」
				PRINTFORMDW 八橋は%CALLNAME:MASTER%に気づくと慌てた様子で湯船に沈んだ。
				PRINTFORMW 「…%MASTERNAME:95%と混浴ね～」
			ELSE
				PRINTFORMW 「%MASTERNAME:95%…今入ってるんだけど…まあいいわ」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
