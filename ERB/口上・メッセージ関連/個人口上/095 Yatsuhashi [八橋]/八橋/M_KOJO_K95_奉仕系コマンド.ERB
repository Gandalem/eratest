RETURN RESULT

@M_KOJO_MESSAGE_COM_K95_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;出す直前
	ELSEIF BASE:PLAYER:2 > 8000
		IF RAND:3 == 0
			PRINTFORMW 「...후훗...빵빵하게 부어서...이상해...%UNICODE(0x2665) *1%」
			PRINTFORMW 「이제 내도 괜찮아~ %UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「와아... 커지고 있어... %UNICODE(0x2665) *1%」
			PRINTFORMW 「많이 축축하게 내서 기분 좋아져줘... %UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「%MASTERNAME:95%, 참지 못하고 흘리고 있네~♪」
			PRINTFORMW 「이쪽이 기분이 좋은 건가...%UNICODE(0x2665) *1%」
		ENDIF
		;恋慕
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「후훗... 거시기 잡혀 있을 때는 조용해지네...%UNICODE(0x2665) *1%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「기분 좋게 해 줄 테니까...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「음... 좀 더 격하게 하는 게 좋을까?」
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		IF RAND:3 == 0
			PRINTFORMW 「%MASTERNAME:95%의 기분 좋아 보이는 얼굴, 나 좋아해...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...응... 손놀림에는 자신 있단다...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「내 손가락, 기분 좋아?」
		ENDIF
		;それ以外
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...아무리 그래도 코토와 같지는 못할까...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「손가락으로 마음껏 기분 좋게 해 줄게...%UNICODE(0x2665) *1%」
		ELSE
			PRINTFORMW 「빨리 많이 싸버려 %UNICODE(0x2665) *1%」
		ENDIF
	ENDIF
ENDIF
RETURN 1
