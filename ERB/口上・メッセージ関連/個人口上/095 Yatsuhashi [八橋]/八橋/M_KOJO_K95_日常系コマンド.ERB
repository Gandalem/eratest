;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K95_302
CALL M_KOJO_MESSAGE_COM_K95_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K95_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:318 == 1
		IF RAND:3 == 0
			PRINTFORMW 「바보... 변태...!」
			PRINTFORMDW 야츠하시가 스킨십에 대해 노려보고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「만지지 마!」
			PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 행위에 목소리를 높여 항의했다.
		ELSE
			PRINTFORMW 「...그만두라고!」
			PRINTFORMDW 야츠하는 화난 표정으로 항의해 온다.
		ENDIF
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「에헤헤, 몸 씻겨 줄게!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「크네... 나와는 전혀 달라...」
		ELSE
			PRINTFORMW 「씻을까! 깨끗하게 해줄게!」
		ENDIF
	ELSEIF TALENT:恋人
		IF RAND:3 == 0
			PRINTFORMW 「음~ 이런 것도 나쁘지 않을지도~」
			PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 즐기고 있다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「벌써 애기 같네, %MASTERNAME:95%는」
			PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 스킨십에 얼굴을 붉히며 그렇게 말했다.
			PRINTFORMW 「후훗! 더 응석 부려도 돼!」
			PRINTFORMDW 아무래도 야츠하시는 더 의지받고 싶은 것 같다.
		ELSE
			PRINTFORMW 「음~?」
			PRINTFORMDW 야츠하시는 그렇게 말하며 안아왔다.
			PRINTFORMW 「따뜻하네~! %MASTERNAME:95%!」
		ENDIF
	ELSEIF TALENT:恋慕
		IF RAND:3 == 0
			PRINTFORMW 「음~ 좋아해~」
			PRINTFORMW 「.........방금 건 농담이니까!」
			PRINTFORMDW 야츠하시는 스킨십을 취하면서 얼굴을 붉히며 그렇게 내뱉었다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「여자애한테 너무 달라붙으면 안 돼~%MASTERNAME:95%~」
			PRINTFORMW 「뭐, 나는 괜찮지만 말이야」
			PRINTFORMDW 야하시가 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 하고 있다.
		ELSE
			PRINTFORMW 「...음... 무슨 일이야? 갑자기」
			PRINTFORMDW 야츠하시는 얼굴을 새빨갛게 물들이며 %조사처리(CALLNAME:MASTER,"와")% 스킨십을 하고 있다.
			PRINTFORMW 「너무 야한 거라든지 하지 마?」
		ENDIF
	ELSEIF TALENT:思慕
		IF RAND:3 == 0
			PRINTFORMW 「나 어깨 주무르는 거 잘한단 말이야! 해줄까?」
			PRINTFORMDW 야츠하시는 그렇게 말하며 %조사처리(CALLNAME:MASTER,"의")% 어깨를 주무르기 시작했다.
		ELSEIF RAND:2 == 0
			PRINTFORMW 「...음, 너무 만지지 말아 줘」
			PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"와")%의 스킨십에 당황하고 있다.
		ELSE
			PRINTFORMW 「좀 떨어져 있어 줘」
			PRINTFORMW 「너무 달라붙지 마」
			PRINTFORMDW 스킨십을 시도하자 야츠하시는 지적을 했다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			PRINTFORMW 「...나에게 만져봐... 튕겨보고 싶어?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「좀 거칠잖아, %MASTERNAME:95%!」
			PRINTFORMDW 야츠하는 스킨십을 시도하려는 %조사처리(CALLNAME:MASTER,"에게")% 조금 물러나 있다.
		ELSE
			PRINTFORMW 「...응?」
			PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"와")%의 스킨십을 당황하며 받아들이고 있다.
			PRINTFORMW (....뭐, 나쁘지 않지만...)
		ENDIF
	ENDIF
ENDIF
RETURN 1
