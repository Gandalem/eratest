@M_KOJO_MESSAGE_COM_K95_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K95_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K95_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:325 == 5 && TFLAG:193 != -3 ;custom code
		IF RAND:3 == 0
			PRINTFORMW 「지금 바쁘니까 나중에 해줘」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이제, 타고 있는데 말이야」
		ELSE
			PRINTFORMW 「좀 시끄럽네~ 들어주긴 해 주지만 말이야~」
		ENDIF
		;怒り
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORMW 「...헤응!」
		PRINTFORMDW 야츠하시는 고개를 돌려버렸다.
		;会話不能
	ELSEIF TCVAR:302
		PRINTFORMW 「………」
		PRINTFORMW (어색하다...)
		PRINTFORMDW 야츠하시는 어색한 분위기에 입을 다물었다.
	ELSEIF CFLAG:2 >= 2000 && CFLAG:4 >= 100 && CFLAG:95:1901 == 0 ;custom code, changed the way flags are handled
		PRINTFORMW 「저기 저기 %MASTERNAME:95%」
		PRINTFORMDW 야츠하시는 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 가만히 응시하며 그렇게 중얼거렸다.
		PRINTFORMW 「%MASTERNAME:95%은 뭔가 오빠 같다고 요즘 생각하게 돼.」
		PRINTFORMW 「언제나 재미있는 이야기를 해주고, 이것저것 함께 놀아주니까.」
		PRINTFORMW 「그래서 말이야, 이왕 이렇게 된 거 오빠라든지 형이라고 불러보고 싶어...」
		PRINTFORMW 「...안 될까?」
		$INPUT_LOOP1
		PRINTL [0] 오빠
		PRINTL [1] 형님
		PRINTL [2] 이대로 괜찮아
		INPUT
		SELECTCASE RESULT
			CASE 0
				CFLAG:95:1900 = 1
				PRINTFORMW 「알았어!」
				PRINTFORMW 「앞으로도 잘 부탁해! %MASTERNAME:95%!」
				PRINTFORMDW 야츠하시는 환한 미소로 그렇게 말했다.
			CASE 1
				CFLAG:95:1900 = 2
				PRINTFORMW 「응, 그럼 %MASTERNAME:95%?」
				PRINTFORMW 「%MASTERNAME:95%! 기분 좋다!」
				PRINTFORMDW 야츠하시가 만면에 미소를 지으며 그렇게 말했다.
			CASE 2
				PRINTFORMW 「우으... 좀 아쉽네」
				PRINTFORMDW 야츠하시는 조금 아쉬한 듯 고개를 숙였다.
			CASEELSE
				GOTO INPUT_LOOP1
		ENDSELECT
		CFLAG:95:1901 = 1
		;風呂場
	ELSEIF BATHCHECK(CFLAG:MASTER:現在位置) && IN_HOME(CFLAG:MASTER:現在位置)
		IF RAND:3 == 0
			PRINTFORMW 「목욕~ 신나게 놀면 언니한테 혼날지도 모르겠어...」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이 몸이 된 후 즐거운 일이 생겼어! 목욕할 거야!」
		ELSE
			PRINTFORMW 「목욕은 기분 좋네~♪」
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 0
				IF DAY:2 == 1
					IF RAND:3 == 0
						PRINTFORMW 「후훗♪ 지내기 좋고 좋은 계절이네♪%MASTERNAME:95%♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「사쿠라~ 사쿠라의 계절이야♪」
					ELSE
						PRINTFORMW 「봄은 좋네! 바람도 기분 좋다!」
					ENDIF
				ELSEIF DAY:2 == 2
					IF RAND:3 == 0
						PRINTFORMW 「여름은 덥네... 물놀이하러 갈까 %MASTERNAME:95%♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「더워서 소리 낼 기력도 떨어져 버려~」
					ELSE
						PRINTFORMW 「빙수가 맛있는 계절이네, 이럴 때 몸이 있어서 다행이라고 생각해!」
					ENDIF
				ELSEIF DAY:2 == 3
					IF RAND:3 == 0
						PRINTFORMW 「가을은 지내기 좋아서 좋아! 마음껏 연주하자!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「다들 라이브가 한창인 계절이네! 가을밤에는 좋지 않아?」
					ELSE
						PRINTFORMW 「고구마가 맛있는 계절이네! 잔뜩 먹어도 괜찮아, 소리 내서 먹어볼까!」
					ENDIF
				ELSEIF DAY:2 == 4
					IF RAND:3 == 0
						PRINTFORMW 「으음... 춥네, %MASTERNAME:95%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이런 계절일수록 음악으로 따뜻해지자!」
					ELSE
						PRINTFORMW 「우동이 먹고 싶은 계절이네, 아 토끼가 아니야?」
					ENDIF
				ENDIF
			CASEELSE
				IF TALENT:恋人
					IF RAND:4 == 0
						PRINTFORMW 「있잖아, 저번에 갔던 과자 가게 말이야」
						PRINTFORMDW 야츠하시는 그렇게 말하며 상냥하게 대화를 시작했다.
						PRINTFORMW (이 시간이 영원히 계속되면 좋을 텐데...)
					ELSEIF RAND:3 == 0
						PRINTFORMW 「～♪」
						PRINTFORMW 「뭐야? 이쪽을 보고 있어?」
						PRINTFORMW 「부상신이 되어서, %MASTERNAME:95%이랑 이야기할 수 있는 게 즐겁다는 이야기야」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「...그러고 보니 악기 연주할 수 있었나%MASTERNAME:95%?」
						PRINTFORMW 「...나를 연주해 볼래?」
						PRINTFORMDW 야츠하시는 살짝 요염하게 미소 지어 보였다.
					ELSE
						PRINTFORMW 「もと%MASTERNAME:95% 이야기를 듣고 싶어」
						PRINTFORMDW 야츠하시는 싱글벙글 웃으며 %조사처리(CALLNAME:MASTER,"에게")% 물었다.
						PRINTFORMW 「나 같은 건 모르는 것뿐이고... %MASTERNAME:95%랑 여러 가지 경험하고 싶어」
					ENDIF
				ELSEIF TALENT:恋慕
					IF RAND:4 == 0
						PRINTFORMW 「저기...」
						PRINTFORMW 「%MASTERNAME:95% 말이야」
						PRINTFORMDW 야츠하시는 문득 물었다.
						PRINTFORMW 「...아니야, 아무것도 아니니까 잊어버려」
						PRINTFORMDW 하지만 도중에 입을 다물어 버렸다.
					ELSEIF RAND:3 == 0
						PRINTFORMW 「있잖아... %MASTERNAME:95%은 평소에 뭐 해?」
						PRINTFORMW 「나는 야외 라이브 같은 걸 하고 있어.」
						PRINTFORMW 「...누나나 라이코 씨만큼 잘하진 못하지만 말이야.」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「……여러 가지 있었지만」
						PRINTFORMW 「지금은 이런 일상도 좋을지도 모르겠네」
					ELSE
						PRINTFORMW 「나의 꿈?」
						PRINTFORMW 「그렇네... 신부...?」
					ENDIF
				ELSEIF TALENT:思慕
					IF RAND:4 == 0
						PRINTFORMW 「……에!?」
						PRINTFORMDW 야츠하시는 갑자기 이상한 소리를 내버렸다.
						PRINTFORMW 「미안해, 별로 듣지 못했어」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「...과로군」
						PRINTFORMW 「최근에 그런 일이」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「...음으」
						PRINTFORMW 「여러 가지 하고 있네, %MASTERNAME:95%」
					ELSE
						PRINTFORMW 「요즘 언니가 말이야~」
					ENDIF
				ELSE
					IF RAND:5 == 0
						PRINTFORMW 「...뭐야?」
						PRINTFORMW 「아니, 응, 재미있네, 그 이야기」
					ELSEIF RAND:4 == 0
						PRINTFORMW 「라이코 씨는 멋있다고요!」
						PRINTFORMW 「최근 라이브에서 말이에요~」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「라이코 씨는 평소에 뭘 하고 지내는 걸까?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「헤에, 그런 것이...」
						PRINTFORMDW 야츠하시는 감탄하며 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
					ELSE
						PRINTFORMW 「...음으」
						PRINTFORMDW 야츠하시는 흥미롭다는 듯이 %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고 있다.
						PRINTFORMW 「...세상에는 여러 가지 일이 있는 거구나...」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
