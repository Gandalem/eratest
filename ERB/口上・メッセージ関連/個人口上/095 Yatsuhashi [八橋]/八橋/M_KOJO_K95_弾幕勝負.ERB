; Modular ERB: 個人口上/095 Yatsuhashi [八橋]/八橋/M_KOJO_K95_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K95_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		;怒り
		IF CFLAG:318 == 1
			PRINTFORMW 「도착했다! 시비를 건 걸 후회하게 해 주겠어!」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「와호이! 승부야! %MASTERNAME:95%!」
		ELSEIF RAND:3 == 0
			PRINTFORMW 「나의 음악으로 해 줄 테니까!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「진혼 라이브의 시작이다!」
		ELSE
			PRINTFORMW 「도구라고 해서 가볍게 보지 마세요!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「흥! 이런 걸로 이겼다고 생각하지 마!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아얏! 정말이지! 부드럽게 해줘!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「이 정도밖에 안 돼!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「우연한 대박이라니!」
				ELSE
					PRINTFORMW 「아직이야! 이제부터야!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「우으, 이대로는...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「어떡하지... 이대로 지겠어!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「나도... 할 때는 하는 법이니까!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「승부는 이제부터야!」
				ELSE
					PRINTFORMW 「포기하지 않을 테니까!」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「%MASTERNAME:95% 바보 같아-!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「크윽...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「와아, 이건 무리야-」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「따뜻하네...」
				ELSE
					PRINTFORMW 「...안 되는 건가...」
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「어때! 제대로 사과해 줘!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「해냈다! 이겼어!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%MASTERNAME:95%, 컨디션 안 좋았어?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「후훗, 어떤 건지 보자!」
				ELSE
					PRINTFORMW 「좀 더 식감이 있었으면 좋았을 텐데」
				ENDIF
			CASE 2
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「흥! 지지 않을 테니까!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아, 정말! 머리 다 헝클어졌어!」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「아야... 쓸려버렸어...」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「%MASTERNAME:95%도 뭐 그럭저럭 강하네!」
				ELSE
					PRINTFORMW 「좋은 승부였어!」
				ENDIF
			CASE 1
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「아... 아슬아웠다...」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「아슬아났다...」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%MASTERNAME:95%, 강하네~」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「격투였네... 지쳤어...」
				ELSE
					PRINTFORMW 「힘겨운 승리라는 거구나...」
				ENDIF
			CASE 0
				;怒り
				IF CFLAG:318 == 1
					PRINTFORMW 「%MASTERNAME:95% 같은 건 싫어!」
				ELSEIF RAND:4 == 0
					PRINTFORMW 「음, 난 어떡하지, 항복이야-」
				ELSEIF RAND:3 == 0
					PRINTFORMW 「%MASTERNAME:95%, 강하네!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「분하다...」
				ELSE
					PRINTFORMW 「누나랑 태그해서 리벤지할 거야!」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
