;==================================================
;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K40_310
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K40_310
CALL M_KOJO_MESSAGE_COM_K40_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K40_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
	ELSE
		IF FIRSTTIME(310)
			;恋慕
			IF TALENT:恋慕
				PRINTFORMW 「ん…、その手……」
				PRINTFORMW 「偶然触れたんじゃ……ないよね？」
				PRINTFORMW 「んぁぁ……いやらしい手つき……」
				PRINTFORMW 「でも嫌じゃないよ……もっと、して？」
			;親密が３以上
			ELSEIF ABL:親密 > 2
				PRINTFORMW 「ぇ…、ぁ……こらっ……」
				PRINTFORMW 「何処撫でてっ……止めなさいって……っ！」
				PRINTFORMW 「んぁ…、やぁ……っ」
			;その他
			ELSE
				PRINTFORMDW 勇みよく、小傘の雌尻に手を触れようとしたその瞬間……
				PRINTL  
				PRINTFORMDW バシィッ！
				PRINTL  
				PRINTFORMDW 強烈な唐傘のスイングに、小気味良い音と共に手首を打ち上げられた。
				PRINTL  
				PRINTFORMW 「あらあら、ごめんねぇ～ちょっとゴルフの練習してたら当たっちゃったよ～」
				PRINTFORMW 「で、今何しようとしてたのかな？」
				PRINTFORMW 「唐傘の目を、ごまかせると思った？」
			ENDIF
		ELSE
			;恋慕
			IF TALENT:恋慕
				IF RAND:2
					PRINTFORMW 「あはぁ…、ん♪　そんなに揉みこまれたら、形変わっちゃうね」
					PRINTFORMW 「ねぇ、%CALLNAME:MASTER%の形に、変えてくれる？」
					PRINTFORMW 「ん…、はぁぁ%UNICODE(0x2665)%　あんぅ♪」
					PRINTL  
					PRINTFORMDW %CALLNAME:MASTER%が撫でやすいように、豊かな双臀を主張するように腰を突きだす小傘。
					PRINTFORMDL 丸みのある脂肪を湛えた臀筋も、この世の何よりも美しい腰のラインも、
					PRINTFORMDW 秘所へと続く鼠蹊部の柔らかな感触も、意識を集中させた指で全部味わう。
					PRINTFORMDL １０本の指が小傘の肌面を這いずりまわり、愛撫するたびに、
					PRINTFORMDW 小傘は%CALLNAME:MASTER%に抱きついたその腕をぎゅっと強く締め付けて、身を振わせる。
				ELSE
					PRINTFORMW 「んっ…、ふぁぁ……手つきがいやらしい……の、好きだよ」
					PRINTFORMW 「そんなに丁寧に揉まれたら……ふにゃんってなっちゃうよ♪」
					PRINTL  
					PRINTFORMDL 吸付いているのは%CALLNAME:MASTER%の手の筈なのに、
					PRINTFORMDW そのやわらかな感触はまるで小傘の牝尻が%CALLNAME:MASTER%の手のひらに吸付いてくるようだ。
					PRINTFORMDW 小傘の甘い声が頭に響いて、頭の芯まで蕩けさせて%CALLNAME:MASTER%は小傘のお尻にもっともっと夢中になる。
				ENDIF
			;親密が３以上
			ELSEIF ABL:親密 > 2
				PRINTFORMW 「ひゃっ！　い、いきなり触られるとびっくりするよっ」
				PRINTFORMW 「ん……んぁぁ……だからって、優しく触られるとそれも……あぁ…、んぅ」
			;それ以外
			ELSE
				PRINTFORMW 「んっ……ま、また……」
				PRINTFORMW 「%CALLNAME:MASTER%も……懲りないのねぇ」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;311,抱き付く
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 60=ディープキス 73=ぱふぱふ 74=乳合わせ 77=乳を吸わせる ＶＡ性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K40_311
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K40_311
CALL M_KOJO_MESSAGE_COM_K40_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K40_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	;ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中)
	ELSEIF CFLAG:睡眠
	ELSE
		;キスまたはディープキス
		IF TCVAR:20 == 30 || TCVAR:20 == 60
			PRINTFORMW 「ん♪　ふふっ、キス……気持ち良かったの？」
			PRINTFORMW 「それで、堪らずぎゅ♪　ってしちゃったんだねぇ」
			PRINTFORMW 「じゃあ私も、%CALLNAME:MASTER%をぎゅぅぅ～ってしながら」
			PRINTL  
			PRINTFORMDW %CALLNAME:MASTER%に応えるように、小傘の両腕が背中に絡み付く。
			PRINTFORMDL 片腕は%CALLNAME:MASTER%をしっかり抱きとめ、
			PRINTFORMDW もう片方の腕は背筋を伝い、うなじを伝い、頭頂へと達する。
			PRINTL  
			PRINTFORMW 「抱き合ったまま……ちゅ……」
			PRINTL  
			PRINTFORMDW 抱擁し合ったままするキスは気持ち良い……
			PRINTFORMDW 唇同士が触れる瞬間に、小傘の体が微かに震えるのが良く分かる。
			PRINTFORMDW そして、%CALLNAME:MASTER%の体もまた震えているのを、小傘は全身で感じた。
		;愛撫系
		ELSEIF TCVAR:20 == 34 || TCVAR:20 == 36 || TCVAR:20 == 50 || TCVAR:20 == 52 || TCVAR:20 == 55 || TCVAR:20 ==  57 || TCVAR:20 ==  58 || TCVAR:20 == 74
			PRINTFORMW 「んんっ…、ちゅ…む……あは♪　気持ち良いの、耐えられなくなっちゃった？」
			PRINTFORMW 「そっかそっかぁ、声が勝手に出ちゃうのを塞ぎたかったんだねぇ%UNICODE(0x2665)%」
			PRINTFORMW 「んん～、ちゅ%UNICODE(0x2665)%」
			PRINTL  
			PRINTFORMDW 身体を焼くような快楽に戦慄き、喘ぎ声を抑えるために小傘の唇を求める%CALLNAME:MASTER%。
			PRINTFORMDW そんな%CALLNAME:MASTER%を、可愛いものを見つめで見つめ、抱きしめ、口づけする小傘……
			PRINTFORMDW 口を塞がれ、逃げ場を失った悦楽が全身を駆け巡る……
			PRINTL  
			PRINTFORMW 「でも、ハグしたら……よけいに気持ち良くなって逆効果だと思うんだけれどなぁ～」
			PRINTFORMW 「むしろ、それでもっと気持ち良くなるのを期待してたのかな？」
		ELSEIF RAND:7 == 0
			PRINTFORMW 「わっ！？　んんっ、ふふふ……いきなり抱き付いて、本当に甘えんぼさんね」
			PRINTFORMW 「かわいい……食べちゃいたいくらい……」
			PRINTL  
			PRINTFORMDL %CALLNAME:MASTER%に抱きつかれた小傘は、一瞬驚く様子を見せたものの、
			PRINTFORMDW やがて満面の笑みを浮かべながら、%CALLNAME:MASTER%を優しく抱き返した……
			PRINTL  
			PRINTFORMW 「本当だよ……%CALLNAME:MASTER%を、%CALLNAME:MASTER%の心を食べたい」
			PRINTFORMW 「仕事に疲れて……不安と物寂しさに塗れた心、私が食べてあげる」
			PRINTL  
			PRINTFORMDW ぎゅっと強く、抱きしめられる……骨が軋むくらい、強く……力強く……
			PRINTFORMDW 妖怪の力は、その片鱗でも%CALLNAME:MASTER%の体、そして心をいともたやすく壊してしまえる。
			PRINTFORMDW でも苦しくない。小傘の優しさが包んでいてくれるから……
			PRINTFORMDW 強い抱擁に、小傘の柔らかな肢体が密着する。
			PRINTFORMDW 気持ち良い……身も心も、小傘に溶けてゆく……もう、小傘のもの。
		ELSEIF RAND:6 == 0
			PRINTFORMW 「んふ、甘えて……いいんだよ？」
			PRINTL  
			PRINTFORMDW 小傘は慈愛と母性の籠った笑みを浮かべつつ、両手を拡げて%CALLNAME:MASTER%を誘ってきた……
			PRINTFORMDW 堪らず%CALLNAME:MASTER%が小傘に抱きつくと、ぎゅっと力を込めて抱きしめ返した。
			PRINTL  
			PRINTFORMW 「よしよし%UNICODE(0x2665)%　いい子だよ……」
			PRINTFORMW 「うん♪　%CALLNAME:MASTER%はいい子……」
			PRINTFORMW 「神社の皆の為にお仕事を頑張るいい子なんだよ～」
			PRINTL  
			PRINTFORMDW ぽんぽんと背中を叩きながら、もう片方の手で頭を優しく撫でられる……
			PRINTFORMDW すぅっと髪の毛を撫でられ、指の形に沿った温もりは頭皮にまで届く。
			PRINTFORMDW ふわふわ……浮遊感。自分の力で立っているのか分からない……
			PRINTFORMDW そんな%CALLNAME:MASTER%を小傘が支える……化生の力強い抱擁が、とても気持ち良い。
			PRINTL  
			PRINTFORMW 「お仕事お疲れさま%UNICODE(0x2665)%」
			PRINTFORMW 「私に出来ることを……今はさせてね？」
			PRINTFORMW 「%CALLNAME:MASTER%を癒して、元気に仕事できるようにすること」
			PRINTFORMW 「%CALLNAME:MASTER%が元気に仕事して、神社の皆に喜ばれるのが、私の恩返し……」
			;恋人
			IF TALENT:恋人
				PRINTFORMW 「そして、こんなにも私を愛してくれることのお礼……もね%UNICODE(0x2665)%」
			ENDIF
		ELSEIF RAND:5 == 0
			PRINTFORMW 「どう……したの？」
			PRINTL  
			PRINTFORMDW 両手を拡げて、そして小傘の体を抱きしめる。
			PRINTL  
			PRINTFORMW 「えっ……わ！？　きゃっ、ど、どうしたの急に！？」
			PRINTL  
			PRINTFORMDL 強く抱きしめて、衣服越しに柔らかなボディラインの感触を……
			PRINTFORMDW その下に力強く流れる血潮の、温かく力強い鼓動を感じる。
			;恋人
			IF TALENT:恋人
				PRINTFORMDL 全身で、“多々良小傘”を満喫しながら、
				PRINTFORMDW 『大好き』と、愛を告げる……力強く、ひたすらに力強く。
				PRINTL  
				PRINTFORMW 「うん♪　私も大好きだよ%UNICODE(0x2665)%」
				PRINTFORMW 「だから……もっとぎゅっとして……」
				PRINTFORMW 「ううん、私から抱きしめてあげる」
				PRINTL  
				PRINTFORMDW %CALLNAME:MASTER%が小傘にしたように、小傘も%CALLNAME:MASTER%を抱きしめる。
				PRINTFORMDW 細い腕……華奢な体の、力強い抱擁。
				PRINTFORMDW それでも、小傘は力を入れすぎないように、優しく%CALLNAME:MASTER%を抱きしめる。
				PRINTFORMDW 小傘の温もりが、小傘の優しさが、愛が%CALLNAME:MASTER%の体に染みてゆく。
			ELSE
				PRINTFORMDL 皮膚の下に流れる熱き奔流に%CALLNAME:MASTER%の意識は呑まれ、
				;小傘より大きい
				IF MASTER_BODY_K40() > 0
					PRINTFORMDW 小傘を腕に抱きながらぐったり、身も心も小傘に委ねてしまう。
				;小傘より大きくない
				ELSE
					PRINTFORMDW 小傘の腕の中でぐったり、身も心も小傘に委ねてしまう。
				ENDIF
				PRINTL  
				PRINTFORMW 「寂しくなっちゃったの？」
				PRINTFORMW 「人肌が、恋しかったの？」
				PRINTFORMW 「でも……どうして私……？」
				PRINTFORMW 「……ううん、なにはともあれ私を求めてくれたのは嬉しいよ%UNICODE(0x2665)%」
			ENDIF
		ELSEIF RAND:4 == 0
			PRINTFORMW 「あんっ……いきなり抱き付くなんてぇ%UNICODE(0x2665)%」
			PRINTFORMW 「もうっ、人肌寂しくなっちゃったのかしら？　くすくす」
			PRINTL  
			PRINTFORMDL 一瞬、ビクッと体を震わせて驚くものの、
			PRINTFORMDW それが%CALLNAME:MASTER%だと分かると怒ることも無く笑顔で%CALLNAME:MASTER%を受け入れる小傘。
			PRINTL  
			PRINTFORMW 「でも、人肌の温もりを求めて私を選んでくれたのなら……」
			PRINTFORMW 「うれしい……な%UNICODE(0x2665)%」
			PRINTL  
			PRINTFORMDW %CALLNAME:MASTER%に応えるように、小傘がぎゅっと抱きしめてくる。
			;小傘より大きい
			IF MASTER_BODY_K40() > 0
				PRINTFORMDW %CALLNAME:MASTER%より一回りも小さい少女の抱擁は、しかし力強く、そして優しい。
			;小傘と同じくらい
			ELSEIF MASTER_BODY_K40() == 0
				PRINTFORMDW 優しげな表情に間近で見つめられながら、その抱擁の力強く優しいことに驚く%CALLNAME:MASTER%。
			;小傘より小さい
			ELSE
				PRINTFORMDW その抱擁は、小さな%CALLNAME:MASTER%を優しく……力強く包む。
			ENDIF
			PRINTFORMDW 小傘を欲しがっていた体の飢えが……満たされてゆく、癒されてゆく。
			PRINTL  
			PRINTFORMW 「ふふっ……お仕事、いつもお疲れ様%UNICODE(0x2665)%」
			PRINTFORMW 「よく……頑張ったね%UNICODE(0x2665)%　いい子だね%UNICODE(0x2665)%」
			;小傘より大きい
			IF MASTER_BODY_K40() >0
				PRINTFORMW 「だから今は……私を抱いて、お休み♪」
			;小傘より大きくない
			ELSE
				PRINTFORMW 「だから今は……私に抱かれて、お休み♪」
			ENDIF
		ELSEIF RAND:3 == 0
			PRINTFORMW 「ん？　ふふふ、よしよし」
			PRINTL  
			PRINTFORMDL %CALLNAME:MASTER%が小傘に抱き付くと、
			PRINTFORMDW 驚く素振りを見せることなく、小傘は%CALLNAME:MASTER%を抱き返してくれた。
			PRINTL  
			PRINTFORMW 「お仕事で疲れちゃったんだねぇ～、ふふっ」
			PRINTFORMW 「%CALLNAME:MASTER%が神社のお仕事頑張っているのは、私が知っているよ……」
			PRINTL  
			PRINTFORMDW そう言うと、ぽふっ、と音をたてて%CALLNAME:MASTER%の頭の上に手が置かれる。
			PRINTFORMDW とても小さな、可憐な手なのに……とても力強い。
			PRINTFORMDW そしてなにより、とても温かくて優しい。
			PRINTL  
			PRINTFORMW 「ううん、私だけじゃないよ……」
			PRINTFORMW 「神社の皆が、%CALLNAME:MASTER%の頑張りを知っている」
			PRINTL  
			PRINTFORMDW ゆっくり、ゆるうりと頭を撫でられる。
			PRINTFORMDW 頭を抱えられて、小傘の表情を直接窺い知ることはできない……
			PRINTFORMDW ただ、言葉が……撫でる手のひらが……抱く腕が、ひたすらに優しい。
			PRINTL  
			PRINTFORMW 「でも、今は私を選んでくれたんだものねぇ%UNICODE(0x2665)%」
			PRINTFORMW 「だから……私が休ませてあげる」
			PRINTFORMW 「%CALLNAME:MASTER%と違って、神社の皆に何もできない私だから……」
			PRINTFORMW 「せめて%CALLNAME:MASTER%が、明日もお仕事できるように癒してあげたいの」
		ELSEIF RAND:2
			PRINTFORMW 「くす、甘えたくなっちゃったんだぁ%UNICODE(0x2665)%」
			PRINTFORMW 「いいよ、ほら♪　いい子いい子してあげるから、甘えちゃえ～%UNICODE(0x2665)%」
			PRINTL  
			PRINTFORMDW 両手を拡げて誘惑する小傘の言葉に文字通り甘えて、%CALLNAME:MASTER%はそっと胸元に顔を埋める。
			PRINTFORMDW 小傘は片方の手で%CALLNAME:MASTER%の頭を撫で擦りながら、もう片方の手で背中をぽんぽんと叩いてきた。
			PRINTL  
			PRINTFORMW 「ふふっ……可愛い♪　私だけが知っている、%CALLNAME:MASTER%の本当の姿%UNICODE(0x2665)%」
			PRINTFORMW 「私もね、嬉しいよ。こんなことさせてくれるのは、%CALLNAME:MASTER%しかいないんだもの」
		ELSE
			PRINTFORMW 「あ…、ん%UNICODE(0x2665)%」
			PRINTFORMW 「%CALLNAME:MASTER%の体……温かくて、抱き心地がいいの♪」
			PRINTFORMW 「なんだか……蕩けちゃいそう、だよ♪」
			PRINTL  
			PRINTFORMDW 小傘は情欲の籠った艶声をあげながら%CALLNAME:MASTER%に体を擦りつけている……
			PRINTFORMDW 直で小傘の体を感じる……小傘の体が優しさで出来ていることを、%CALLNAME:MASTER%は感じる……
			PRINTFORMDW 小傘の優しさに包まれて……%CALLNAME:MASTER%の方こそ、カラダが、ココロが小傘という媒質に溶けてゆくのを感じる……
		ENDIF
	ENDIF

ENDIF
RETURN 1
;==================================================
;312,キスする
;TFLAG:193(99=拒絶(キス不可) 1=大成功 0=成功 -1=失敗)
;CFLAG:うふふ==2&&TCVAR:20(32=前から抱きつく 50=手淫 60=キス 性交(85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ) 86=だいしゅきホールド)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K40_312
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K40_312
CALL M_KOJO_MESSAGE_COM_K40_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K40_312_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
		PRINTFORMDL %CALLNAME:PLAYER%は眠っている%CALLNAME:TARGET%の口を、自分の口で塞いだ…
		PRINTFORMDW 唇を離すと%CALLNAME:TARGET%は僅かに微笑んでいる…
		PRINTL  
		PRINTFORMW 「ん…、むぁ……うふふ……」
		PRINTL  
		PRINTFORMDW 無防備で、嬉しそうな表情に堪らずもう一度キスする%CALLNAME:MASTER%。
	ELSE
		;キス未経験
		IF EXP:TARGET:キス経験 == 1
			PRINTFORMDW %CALLNAME:MASTER%は小傘と向き合い、キスがしたいと言った。
			PRINTL  
			PRINTFORMW 「えっ？　キ、キス……？」
			PRINTFORMW 「私と、キス……したいの？」
			PRINTFORMW 「うん、いいよ♪」
			PRINTFORMW 「私のファーストキス……%CALLNAME:MASTER%にあげる%UNICODE(0x2665)%」
			PRINTFORMW 「はい、ちゅー♪」
			PRINTL  
			PRINTFORMDW そう言って、僅かに唇を突き出して%CALLNAME:MASTER%に差し迫る小傘。
			PRINTFORMDW %CALLNAME:MASTER%はその小傘の頬をそっと手のひらで包むと、窘めるように動きを遮った。
