@MASTER_BODY_K40
;マスターの体型が小傘よりも小さければ-1、同じ程度なら0、小傘よりも大きければ1を返す関数。
#FUNCTION
;小傘よりも小さい
IF TALENT:MASTER:体型 < 0
	RETURNF -1
	;小傘と同じくらい。女の子で、体型が標準
ELSEIF TALENT:MASTER:性別 != 2 && TALENT:MASTER:体型 == 0
	RETURNF 0
	;小傘よりも大きい
ELSE
	RETURNF 1
ENDIF
;あっちむいてホイ
;冷静になると冗長だったので、一発で勝負がつく八百長仕様にしました

@M_KOJO_MESSAGE_COM_K40_302_1_HOI
PRINTFORMDL 『가위바위보』
PRINTL  
LOCAL:1 = 0
LOCAL:2 = 1
;LOCAL:3 == 0 ならMASTER勝ち、1なら小傘勝ち　八百長
LOCAL:3 = RAND:2
$LOOP_JYANKEN
PRINTFORMDL 『퍽!』
LOCAL:1 = RAND:3
;MASTER勝ち
IF LOCAL:3 == 0
	LOCAL:2 = LOCAL:3 + 1
	;MASTER負け
ELSE
	LOCAL:2 = LOCAL:3 + 2
ENDIF
LOCAL:2 = LOCAL:2 % 3
PRINTFORM %조사처리(CALLNAME:MASTER,"의")% 손:
;グー
IF LOCAL:1 == 0
	PRINTFORMDL 주먹
	;チョキ
ELSEIF LOCAL:1 == 1
	PRINTFORMDL 가위
	;パー
ELSE
	PRINTFORMDL 파르
ENDIF
PRINTFORM 코가사의 손:
;グー
IF LOCAL:2 == 0
	PRINTFORMDL 주먹
	;チョキ
ELSEIF LOCAL:2 == 1
	PRINTFORMDL 가위
	;パー
ELSE
	PRINTFORMDL 파르
ENDIF
PRINTFORMDL 이쪽을 봐~ 호이!
LOCAL:1 = RAND:4
IF LOCAL:3 == 0
	PRINTFORM %조사처리(CALLNAME:MASTER,"의")% 손가락:
ELSE
	PRINTFORM 코가사의 손가락:
ENDIF
IF LOCAL:1 == 0
	PRINTFORMDL ↑
ELSEIF LOCAL:1 == 1
	PRINTFORMDL ←
ELSEIF LOCAL:1 == 2
	PRINTFORMDL →
ELSE
	PRINTFORMDL ↓
ENDIF
IF LOCAL:3 == 0
	PRINTFORM 코가사의 얼굴 방향:
ELSE
	PRINTFORM %조사처리(CALLNAME:MASTER,"의")% 얼굴 방향:
ENDIF
IF LOCAL:1 == 0
	PRINTFORMDL ↑
ELSEIF LOCAL:1 == 1
	PRINTFORMDL ←
ELSEIF LOCAL:1 == 2
	PRINTFORMDL →
ELSE
	PRINTFORMDL ↓
ENDIF
;MASTERの勝ち
IF LOCAL:3 == 0
	RETURN 1
	;小傘の勝ち
ELSE
	RETURN 2
ENDIF
;異常終了
RETURN 0

@TS_K40, ARG
#FUNCTION
#DIM TIME_STAMP,1000
;TS:Time Stamp. Trans Sexualではありません。残念。
;その日の初回実行時に時間を記憶し1を返すと、以後一定時間立つまで0を返す。その後、1を返し繰り返す。
;長文が列挙してる使用頻度の高い口上を、定期的にのみ長文がでるようにするのが目的。
;ARGにはコマンド番号、またはカウンター照合番号を要求する
;特殊な番号
;900番台:カウンタ口上　TCVAR:354+900
;800番台:射精、絶頂関連
;
;一定時間の指定
;6時間
TIME_STAMP:500 = 60 * 6
;今日一度もタイムスタンプが切られていないなら、TIME_STAMPを初期化
IF TCVAR:356 == 0
	VARSET TIME_STAMP
	TCVAR:356 = 1
ENDIF
;今日、まだタイムスタンプが切られていない場合
IF TIME_STAMP:ARG == 0
	;0時丁度の場合、00:01分扱いに
	IF TIME == 0
		TIME_STAMP:ARG = 1
		;現在時刻でタイムスタンプを切る
	ELSE
		TIME_STAMP:ARG = TIME
	ENDIF
	RETURNF 1
	;タイムスタンプが切られてから一定時間後
ELSEIF TIME > TIME_STAMP:ARG + TIME_STAMP:500
	IF TIME == 0
		TIME_STAMP:ARG = 1
	ELSE
		TIME_STAMP:ARG = TIME
	ENDIF
	RETURNF 1
	;日を跨いだ場合
ELSEIF (TIME < TIME_STAMP:0) && TIME > TIME_STAMP:ARG + TIME_STAMP:500 - 60 * 24
	IF TIME == 0
		TIME_STAMP:ARG = 1
	ELSE
		TIME_STAMP:ARG = TIME
	ENDIF
	RETURNF 1
ELSE
	RETURNF 0
ENDIF
