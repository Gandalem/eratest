; Modular ERB: 個人口上/040 Kogasa [小傘]/小傘/M_KOJO_K40_FUNC.ERB
;どこにいるの関数
;引数は
;ARG:0 = 0:::室外（ただし紅魔館だろうがMAP外は外）か室内か
;ARG:0 = 1:::どこら辺にいるのか区分け

@K40_WHERE_ABOUT, ARG:0 = 0
#FUNCTIONS
;室外か室内かを判定する
IF ARG:0 == 0
	;室外
	IF OUTROOF(CFLAG:現在位置)
		LOCALS = "室外"
		;室内
	ELSE
		LOCALS = "室内"
	ENDIF
	;具体的にどの辺に居るのか判断する
ELSE
	IF !MAIN_MAP
		;神社
		IF CFLAG:現在位置 < 25
			LOCALS = "神社"
		ELSEIF CFLAG:現在位置 >= 25 && CFLAG:現在位置 < 36
			LOCALS = "三妖精宅"
		ELSEIF CFLAG:現在位置 >= 36 && CFLAG:現在位置 < 52
			LOCALS = "夢幻遺跡"
		ELSEIF CFLAG:現在位置 >= 52 && CFLAG:現在位置 <= MAXROOM
			LOCALS = "神社"
		ELSE
			LOCALS = "外野"
		ENDIF
	ELSE
		LOCALS = "外野"
	ENDIF
ENDIF
RETURNF LOCALS
