@M_KOJO_EVENT_K40_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && !FLAG:70
	;他のキャラとデート中または同行中かどうか判定
	LOCAL:2 = 0
	LOCAL:3 = 1
	FOR LOCAL:3, 1, 40
	LOCAL:2 = LOCAL:2 | CFLAG:(LOCAL:3):同行
	NEXT
	FOR LOCAL:3, 41, 61
	LOCAL:2 = LOCAL:2 | CFLAG:(LOCAL:3):同行
	NEXT
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;遭遇した回数を＋１する
		TCVAR:350 += 1
		;他のキャラとデート中または同行中かどうか判定
		IF LOCAL:2
			IF TALENT:恋慕
				PRINTFORMW 「어머, 사이가 좋구나 %CALLNAME:MASTER%? 부럽네...」
				PRINTFORMW 「괜찮아, 신경 쓰지 않아도 돼」
				PRINTFORMW 「그 정도의 가치는 없다고... 있잖아」
				PRINTL  
				PRINTFORMDW 차가운 시선을 보내며, 코가사는 비꼬는 말투로 그렇게 말했다.
				PRINTFORMDW 움찔하는 %조사처리(CALLNAME:MASTER,"의")% 귓가에 살짝 입술을 가져갔다……
				PRINTL  
				PRINTFORMW 「이번에는……저와도 해 줄래요?」
				PRINTL  
				PRINTFORMDW 그리고 음란하게 귀에 속삭였다.
			ELSE
				PRINTFORMW 「아아 %CALLNAME:MASTER%, 사이좋은 모습이라 부럽네」
				PRINTFORMW 「후훗, 별로 두 분을 놀라게 하지는 않을 거야」
				PRINTFORMW 「연인의 방해를 할 만큼 무례하지 않다고, 이것도 말이야」
				PRINTFORMW 「타타라 코가사는 멋지게 떠날 테니까……」
			ENDIF
			RETURN 1
			;恋慕
		ELSEIF TALENT:恋慕
			;小傘が住み込んだ
			IF FLAG:住み込みキャラ == 40
				PRINTFORMW 「아아 %CALLNAME:MASTER%, 수고하셨어요」
				PRINTFORMW 「저에게는 어려운 일은 무리지만」
				PRINTFORMW 「하지만 같이 살자고 제안해 준 %조사처리(CALLNAME:MASTER,"를")% 위해서예요」
				PRINTFORMW 「적어도, 최선을 다해 %조사처리(CALLNAME:MASTER,"를")% 치유해주고 싶다고 생각하고 있어요?」
				PRINTFORMW 「뭐...... 조금, 놀라게 해줄게요 %UNICODE(0x2665)%」
				PRINTL  
				PRINTFORMDW 그런 식으로 장난스럽게 오른쪽 눈을 감고 혀를 내밀며, 장난을 쳐 보였다.
			ELSE
				PRINTFORMW 「모처럼 여기까지 왔는데, 좀 더 %조사처리(CALLNAME:MASTER,"와")% 이야기하고 싶어.」
				PRINTFORMW 「있잖아, 괜찮지?」
				PRINTL  
				PRINTFORMDW 기대와 아첨을 담은 눈으로 %조사처리(CALLNAME:MASTER,"를")% 바라보며, 코가사는 %조사처리(CALLNAME:MASTER,"에게")% 다가갔다……
				PRINTFORMDW 그리고 %조사처리(CALLNAME:MASTER,"의")% 귓가에서……
				PRINTL  
				PRINTFORMW 「지금이라면, %조사처리(CALLNAME:MASTER,"가")% 놀랄 만한 일들 많이 해줄 수 있어%UNICODE(0x2665)%」
			ENDIF
		ELSE
			;初めて会った
			IF FIRSTTIME(1005)
				PRINTFORMW 「안녕하세요, %CALLNAME:MASTER%」
				PRINTFORMW 「헤에~, 청소 일 하고 있네, 조금 놀랐어」
				PRINTFORMW 「일 방해하면 안 되니까, 놀라게 하는 건 쉬는 시간에 할게」
				PRINTFORMW 「잠깐 마무리되면 나랑 이야기하자」
			ELSE
				PRINTFORMW 「바빠 보이네? %CALLNAME:MASTER%」
				PRINTFORMW 「쉬고 싶을 때 나한테 와줘」
				PRINTFORMW 「잔뜩 놀라게 해 줄 테니까」
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (ARG == 2 || ARG == 6 || ARG == 7)
		;遭遇した回数を＋１する
		TCVAR:350 += 1
		;デート中または他のキャラが同行中
		IF LOCAL:2
			IF TALENT:恋慕
				PRINTFORMW 「어머, 사이가 좋구나 %CALLNAME:MASTER%? 부럽네...」
				PRINTFORMW 「괜찮아, 신경 쓰지 않아도 돼」
				PRINTFORMW 「그 정도의 가치는 없다고... 있잖아」
				PRINTL  
				PRINTFORMDW 차가운 시선을 보내며, 코가사는 비꼬는 말투로 그렇게 말했다.
				PRINTFORMDW 움찔하는 %조사처리(CALLNAME:MASTER,"의")% 귓가에 살짝 입술을 가져갔다……
				PRINTL  
				PRINTFORMW 「이번에는……저와도 해 줄래요?」
				PRINTL  
				PRINTFORMDW 그리고 음란하게 귀에 속삭였다.
			ELSE
				PRINTFORMW 「아아 %CALLNAME:MASTER%, 사이좋은 모습이라 부럽네」
				PRINTFORMW 「후훗, 별로 두 분을 놀라게 하지는 않을 거야」
				PRINTFORMW 「연인의 방해를 할 만큼 무례하지 않다고, 이것도 말이야」
				PRINTFORMW 「타타라 코가사는 멋지게 떠날 테니까……」
			ENDIF
			;MAP外
		ELSEIF GET_MAPID(CFLAG:現在位置) != MAIN_MAP
			IF TALENT:恋慕
				PRINTFORMW 「찾았다~♪」
				PRINTFORMW 「잔뜩 놀라게 해줄 거야」
			ELSE
				PRINTFORMW 「어라 %CALLNAME:MASTER%아니네, 이런 곳에서 뭐 하고 있는 거야?」
				PRINTFORMW 「할 것도 없다면 나에게 놀라움을 받게 해주겠어……」
				PRINTFORMW 「아니, 나와 이야기라도 해보지 않을래 %UNICODE(0x2665)%.」
			ENDIF
			;MAP内
		ELSE
			IF TALENT:恋慕
				;小傘が住み込んだ
				;強化予定。逆セクハラ充実させたい
				IF FLAG:住み込みキャラ == 40
					IF RAND:2
						PRINTFORMW 「에잇... 놀라보라고~♪」
						PRINTL  
						PRINTFORMDW 갑자기 뒤에서 코가사에게 안겼다.
						PRINTFORMDW 말랑말랑하고 이기적인 몸의 감촉이 기분 좋다…….
						PRINTFORMDW 후와 하고 코가사의 냄새가 퍼지며 %조사처리(CALLNAME:MASTER,"를")% 감싼다.
						PRINTL  
						PRINTFORMW 「음……후우…, 후운……%조사처리(CALLNAME:MASTER,"의")% 냄새가 난다……」
						PRINTFORMW 「더, 느끼게 해줘……내 품 안에서…… 사라지지 않도록」
					ELSE
						PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 찾았어♪」
						PRINTL  
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"를")% 찾은 코가사는 환한 미소를 지으며 달려왔다.
						PRINTFORMDW 부드러운 몸이 %조사처리(CALLNAME:MASTER,"에게")% 감긴다…… 꽉, 기분 좋다……
						PRINTL  
						PRINTFORMW 후후, %조사처리(CALLNAME:MASTER,"의")% 품이 가장 마음이 편하네
						PRINTFORMW 「역시 우산은 소유주의 품에 안겨 있어야 해.」
					ENDIF
				ELSE
					PRINTFORMW 「후훗, 찾았다♪」
					PRINTFORMW 「모처럼 하쿠레이 신사까지 왔는데…… 물론, %조사처리(CALLNAME:MASTER,"를")% 만나기 위해서지?」
					PRINTFORMW 「%조사처리(CALLNAME:MASTER,"를")% 놀라게 하기 위함이라도…… 있을까」
					PRINTFORMW 「뭐 어느 쪽이든, %조사처리(CALLNAME:MASTER,"를")% 마음껏 즐기는 건 확실하네%UNICODE(0x2665)%.」
				ENDIF
			ELSE
				PRINTFORMW 「아아 %CALLNAME:MASTER%, 일 열심히 하고 있네」
				PRINTFORMW 「쉬고 싶을 때 나한테 말해줘? 놀라게 해줄 테니까」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
