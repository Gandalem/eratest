	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「あ…、ん、このまま寝ちゃうの？」
		PRINTFORMW 「うん、いいよ……私を抱き枕にしても」
		PRINTFORMW 「でも%CALLNAME:MASTER%だけが私を抱き枕にするのはだ～め%UNICODE(0x2665)%」
		PRINTFORMW 「私も……%CALLNAME:MASTER%のことを抱き枕にしちゃうから♪」
		PRINTL  
		PRINTFORMDW そういって小傘は%CALLNAME:MASTER%を抱き返してきた。
		;小傘よりも小さい
		IF MASTER_BODY_K40() < 0
			PRINTFORMDW 抱きしめたつもりが、抱きしめられている。気がつけば小傘の柔肌に包まれている。
		;小傘と同じくらいの体型
		ELSEIF MASTER_BODY_K40() == 0
			PRINTFORMDW 腕が背中に伸ばされる……脚が下半身に絡み付く……
		;小傘よりも大きい
		ELSE
			PRINTFORMDW %CALLNAME:MASTER%より一回り以上も小さな小傘の抱擁は、しかし力強い。
		ENDIF
		PRINTFORMDW 大好きだと、ずっと一緒だと安心させようとしたつもりが、逆に安心を得ることになる。
		PRINTFORMDW 安心して眠りに就ける。小傘に包まれて……体も心も、全てを小傘に許して。
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「ん、ふふふ♪　このまま眠りたいの？」
		PRINTFORMW 「だって、もう目がとろ～んとしてるんだもの」
		PRINTFORMW 「それは、眠たいから？」
		PRINTFORMW 「それとも……私を抱き枕にするのが気持ちいいから、かな？」
		PRINTL  
		PRINTFORMDW そこまで言ってから、小傘は体の向きを変えて%CALLNAME:MASTER%に覆い被さった。
		PRINTL  
		PRINTFORMW 「いいよ%UNICODE(0x2665)%　このまま眠りましょ♪」
		PRINTFORMW 「%CALLNAME:MASTER%が眠りに就くまで、私が見つめていてあげる」
		PRINTFORMW 「私も眠ってしまったら、“もう一つの私”が、%CALLNAME:MASTER%のことを見ていてあげる」
		PRINTFORMW 「ずっと、見ていてあげる……%CALLNAME:MASTER%の幸せそうに眠る姿、顔、見せて%UNICODE(0x2665)%」
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMDW 
		RETURN 1
	ENDIF
ENDIF
