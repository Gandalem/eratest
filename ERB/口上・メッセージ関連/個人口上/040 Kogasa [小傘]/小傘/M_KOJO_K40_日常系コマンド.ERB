;60,耳かき
;==================================================

@M_KOJO_MESSAGE_SCOM_K40_60
CALL M_KOJO_MESSAGE_SCOM_K40_60_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K40_60_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「에... 나한테, 귀파기를 해달라는 거야?」
		PRINTFORMW 「그게... 저, 귀파기 같은 건 한 적 없어서... 그리고」
		PRINTFORMW 「게다가 말이야, 어렴풋이 느끼고 있을 거라고 생각하지만, 나는 이런 섬세한 움직임은 서툴러서...」
		PRINTFORMW 「저... 무슨 일이 있어도 원망하지 말아줘?」
		PRINTFORMW 「응...」
		;失敗
		IF TFLAG:193 == -1
			PRINTL  
			PRINTW …
			PRINTW ……
			PRINTW ……
			PRINTW 아앗!
			PRINTW 피츄운!
			PRINTL  
			PRINTFORMW 「와아... 귀구멍도 파는 것과 똑같아서 처음에는 피가 나오는 거구나.」
			PRINTFORMW 「어라? 하지만 처음인 건 내가 %조사처리(CALLNAME:MASTER,"에게")% 귀를 파는 것이니까...」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"는")% 지금까지 귀를 파 본 적이 있을 터인데... 어라?!」
			PRINTFORMW 「잠깐 %CALLNAME:MASTER%, 혹시~ 들려? ~!?」
			PRINTL  
			PRINTFORMDW 코가사의 부름이 들려온 것은, 무릎 위에 파묻은 반대쪽 귀에서였다…….
			;成功
		ELSE
			PRINTL  
			PRINTFORMDW 살짝 시원한 귀 파는 것이 %조사처리(CALLNAME:MASTER,"의")% 귓속으로 들어온다.
			PRINTFORMDW 벽에 닿지 않아도, 감촉이 전해진다... 소름이 돋는다.
			PRINTFORMDW 조용히 벽을 만지고, 느껴지도록 천천히 끌어올려진다... 몸이 떨림을 멈추지 않는다, 기분 좋다.
			PRINTFORMDW 익숙하지 않은 느낌이었지만, 코가사는 정성껏 %조사처리(CALLNAME:MASTER,"의")% 귀를 청소해 주었다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;失敗
		IF TFLAG:193 == -1
			PRINTFORMW 「후후, 큰 거 찾았어♪」
			PRINTFORMW 「열심히 따볼게... 성공하면 지금까지의 두 배 양을 딸 수 있으니까 움직이지 마.」
			PRINTL  
			PRINTFORMDW 코가사의 귀 파기에서는 꽤 익숙함이 느껴진다……. 그럼에도 불안을 떨쳐낼 수 없는 %조사처리(CALLNAME:MASTER,"다")%.
			PRINTFORMDW 미세한 떨림도 외이도를 더욱 민감하게 만든다……. 그것이 귀 파기를 기분 좋은 것으로 만드는 것까지는 좋지만…….
			PRINTL  
			PRINTW …
			PRINTW ……
			PRINTW ………
			PRINTW 오호오오!
			PRINTW ＼피츄우운!／
			PRINTL  
			PRINTFORMW 「응? 틀렸을까?」
			;成功
		ELSE
			PRINTFORMW 「자, %조사처리(CALLNAME:MASTER,"의")% 귀에 넣을게……」
			PRINTFORMW 「(귀지가 잘 보이게 하기 위해) 검고 (귀지가 잘 제거되도록) 두꺼운 울퉁불퉁한 막대가 %조사처리(CALLNAME:MASTER,"의")% 귀를 벌리잖아」
			PRINTFORMW 「자, 쭉쭉♪ 후후, 잔뜩 (귀지를 걸기 위해) 뒤섞어 줄 테니까 말이야%UNICODE(0x2665)%」
			PRINTL  
			PRINTFORMDW 거친 말투와는 달리, 코가사는 귀에 넣은 면봉을 빙글빙글 돌리며 귀지를 제거하려 한다.
			PRINTFORMDW 예민한 고막에 섬유질이 스치는 감촉 속에서도 코가사의 다정함을 느낀다……매우 기분 좋다.
			PRINTFORMDL 귀 파기보다 사고가 적고, 코가사도 즐거운 듯 %조사처리(CALLNAME:MASTER,"의")% 귓속을 능욕하고 있으니,
			PRINTFORMDW 가끔은 면봉으로 청소해 달라고 하는 것도 좋겠다고 생각하는 %CALLNAME:MASTER%.
		ENDIF
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 「귀 파기? 응, 괜찮아」
		PRINTFORMW 「나한테 부탁하다니, %CALLNAME:MASTER%도 특이한 취향이네」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K40_{SELECTCOM}_1
RETURN RESULT
;==================================================
;61,抱き枕
;==================================================

@M_KOJO_MESSAGE_SCOM_K40_61
CALL M_KOJO_MESSAGE_SCOM_K40_61_1
RETURN RESULT

@M_KOJO_MESSAGE_SCOM_K40_61_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = (CFLAG:2 >= 3000)
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「아…, 응, 이대로 잠들어 버릴까?」
		PRINTFORMW 「응, 괜찮아… 나를 베개로 해도」
		PRINTFORMW 「하지만 %CALLNAME:MASTER%만 나를 베개로 하는 건 안 돼%UNICODE(0x2665)%」
		PRINTFORMW 「나도…… %조사처리(CALLNAME:MASTER,"를")% 베개로 해버릴 테니까♪」
		PRINTL  
		PRINTFORMDW 그렇게 말하며 코가사는 %조사처리(CALLNAME:MASTER,"를")% 끌어안았다.
		;小傘よりも小さい
		IF MASTER_BODY_K40() < 0
			PRINTFORMDW 안아주려던 것 같은데, 오히려 안겨 있었다. 정신을 차려보니 코가사의 부드러운 살결에 감싸여 있었다.
			;小傘と同じくらいの体型
		ELSEIF MASTER_BODY_K40() == 0
			PRINTFORMDW 팔이 등에 감기고... 다리가 하반신에 휘감긴다...
			;小傘よりも大きい
		ELSE
			PRINTFORMDW %CALLNAME:MASTER%로부터 한 바퀴 이상 작은 코가사의 포옹은, 하지만 힘이 있다.
		ENDIF
		PRINTFORMDW 정말 좋아하고, 영원히 함께할 거라고 안심시키려 했는데, 오히려 안도감을 얻게 된다.
		PRINTFORMDW 안심하고 잠들 수 있다. 코가사에 감싸여…… 몸도 마음도, 모든 것을 코가사에게 맡긴다.
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMW 「응, 후후후♪ 이대로 자고 싶은 거야?」
		PRINTFORMW 「왜냐면 벌써 눈이 풀려버렸으니까」
		PRINTFORMW 「그건, 졸려서?」
		PRINTFORMW 「아니면…… 나를 베개로 삼는 게 기분 좋아서일까?」
		PRINTL  
		PRINTFORMDW 그렇게 말한 후, 코가사는 몸의 방향을 바꿔 %조사처리(CALLNAME:MASTER,"에게")% 덮쳤다.
		PRINTL  
		PRINTFORMW 「괜찮아 %UNICODE(0x2665)% 이대로 잠들자♪」
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 잠들 때까지, 내가 지켜봐 줄게」
		PRINTFORMW 「나도 잠들어버린다면, '또 다른 나'가 %조사처리(CALLNAME:MASTER,"를")% 봐 줄 거야」
		PRINTFORMW 「계속, 지켜봐 줄게…… %조사처리(CALLNAME:MASTER,"가")% 행복하게 잠든 모습, 얼굴을 보여줘 %UNICODE(0x2665)%」
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMDW 
		RETURN 1
	ENDIF
ENDIF
