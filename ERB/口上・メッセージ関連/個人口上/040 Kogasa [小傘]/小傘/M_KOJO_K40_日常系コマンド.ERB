;==================================================
;60,耳かき
;==================================================
@M_KOJO_MESSAGE_SCOM_K40_60
CALL M_KOJO_MESSAGE_SCOM_K40_60_1
RETURN RESULT
@M_KOJO_MESSAGE_SCOM_K40_60_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70 
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「え……私に、耳かきしてほしい、の？」
		PRINTFORMW 「その……さ、耳かきなんて私したことない……し」
		PRINTFORMW 「それにさ、薄々感ずいてると思うけれど、私こういう細かい動きは苦手で……」
		PRINTFORMW 「その……何があっても恨まないでよ？」
		PRINTFORMW 「んっ……」
		;失敗
		IF TFLAG:193 == -1
			PRINTL  
			PRINTW …
			PRINTW ……
			PRINTW ……
			PRINTW アッー！
			PRINTW ＼ピチューン！／
			PRINTL  
			PRINTFORMW 「わぁ……耳の穴って破瓜と同じで最初血が出るものなのねぇ」
			PRINTFORMW 「あれ？　でも初めてなのは私が%CALLNAME:MASTER%に耳かきをすることであって……」
			PRINTFORMW 「%CALLNAME:MASTER%はこれまでにも耳かきをしたことがあるはずで……ってあれっ！？」
			PRINTFORMW 「ちょっと%CALLNAME:MASTER%っ、もしも～し！　聞こえてる～！？」
			PRINTL  
			PRINTFORMDW 小傘の呼びかけが聞こえてきたのは、膝上に伏せた反対側の耳からだった……
		;成功
		ELSE
			PRINTL  
			PRINTFORMDW ちょっぴりひんやりした耳かきが%CALLNAME:MASTER%の耳穴の中に入ってくる。
			PRINTFORMDW 壁に触れずとも、感触が伝わる……ゾクゾクする。
			PRINTFORMDW そっと壁に触れて、伝うようにゆっくりと引き上げられる……身震いが止まらない、気持ちいい。
			PRINTFORMDW 慣れない感じはあったけれども、小傘は丁寧に%CALLNAME:MASTER%の耳を掃除してくれた。
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;失敗
		IF TFLAG:193 == -1
			PRINTFORMW 「ふふ、大きいの見っけ♪」
			PRINTFORMW 「頑張って取ってみるよ……成功すれば今までの倍の量取れるから、動かないように」
			PRINTL  
			PRINTFORMDW 小傘の耳かきからは随分と慣れを感じる……それでも、不安を払拭することが出来ない%CALLNAME:MASTER%。
			PRINTFORMDW 細かな震えも耳孔をより敏感にしてゆく……それが耳かきを気持ちいいものにする、そこまではよいのだが……
			PRINTL  
			PRINTW …
			PRINTW ……
			PRINTW ………
			PRINTW おほぉぉぉぉ！
			PRINTW ＼ピチューン！／
			PRINTL  
			PRINTFORMW 「ん？　間違ったかな？」
		;成功
		ELSE
			PRINTFORMW 「ほ～ら、%CALLNAME:MASTER%の耳に挿入ってゆくよ……」
			PRINTFORMW 「（耳垢が良く見える為に）黒くて（耳垢が良く取れる為に）太いごつごつした棒が%CALLNAME:MASTER%の耳を押し広げちゃうよ」
			PRINTFORMW 「ほら、ずぷぷぅ♪　ふふ、いっぱい（耳垢を絡め取る為に）掻き回してあげるからねぇ%UNICODE(0x2665)%」
			PRINTL  
			PRINTFORMDW 乱暴な物言いとは裏腹に、小傘は耳穴に差し込んだ綿棒をコロコロと、丁寧に回して耳垢を絡め取ろうとする。
			PRINTFORMDW 敏感な耳粘膜に繊維が擦れる感触の中にも小傘の優しさを感じる……とても気持ちがいい。
			PRINTFORMDL 耳かきよりも事故が少ないし、小傘も楽しそうに%CALLNAME:MASTER%の耳穴を凌辱しているので、
			PRINTFORMDW 偶には綿棒で掃除して貰うのもいいかなと思う%CALLNAME:MASTER%。
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMW 「耳かき？　うん、いいよ」
		PRINTFORMW 「私に頼むなんて、%CALLNAME:MASTER%も物好きねぇ」
		RETURN 1
	ENDIF
ENDIF
