;415,食事をふるまう
;==================================================

@M_KOJO_MESSAGE_COM_K40_415
CALL M_KOJO_MESSAGE_COM_K40_415_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K40_415_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL && !FLAG:70
	;初めて
	IF FIRSTTIME(415)
		PRINTFORMW 「엣? 나에게도 먹어줬으면 좋겠다고?」
		PRINTFORMW 「음~ 괜찮지만…… 개인 간의 음식 같은 건 잘 모르겠어」
		PRINTFORMW 「그러니까 그게…… 기대하지 말아 줘?」
		PRINTFORMW 「잘 먹겠습니다…… 아무옷…, 응윽……」
		;失敗
		IF TFLAG:193 == -1
			PRINTFORMW 「응..., 음...」
			PRINTFORMW 「응, 무리. 역시 나한테 인간의 음식은 무리야」
			;嫌いな味
		ELSEIF TCVAR:MASTER:308 | 60
			PRINTFORMW 「응...!?」
			PRINTFORMW 「……」
			PRINTFORMW 「뭐, 뭐 맛있지 않을까……?」
			PRINTFORMW 「자, %CALLNAME:MASTER%도 한번 먹어봐……」
			PRINTL  
			PRINTFORMDW 그렇게 말하며 코가사는 조용히 식사를 다시 건넨다……
			PRINTFORMDW 의심스러워하면서도……%조사처리(CALLNAME:MASTER,"는")% 그것을 자신의 입에 가져간다……
			PRINTL  
			PRINTFORMDW …
			PRINTFORMDW ……
			PRINTFORMDW ………
			PRINTL  
			PRINTFORMDL 극물의 소화를 거부하는 소화기관에서 치밀어 오르는 강산성 유기물을 견디지 못하고,
			PRINTFORMDW 바닥에 토해버린 %CALLNAME:MASTER%.
			PRINTFORMDW 돌아보니 긴장을 풀고 괴로움을 참으면서도 해치웠다는 코가사의 얼굴.
			PRINTL  
			PRINTFORMW 「하아... 하아... 어때, 이겼어...」
			PRINTFORMW 「크윽, 물... 태연한 척하는 거... 힘들었어」
			;好みの味
		ELSEIF TCVAR:MASTER:308 == 1
			PRINTFORMW 「음... 어라, 맛있잖아!?」
			PRINTFORMW 「지금까지 인간의 음식 따위는 맛이 옅고 옅어서 견딜 수가 없었는데」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 만들어준 이건 맛있다고 알겠어, 알겠어.」
			;普通の味
		ELSE
			PRINTFORMW 「응, 응...... 맛있을까?」
			PRINTFORMW 「그게, 잘 모르겠어. 미안해......」
			PRINTFORMW 「역시 나한테는 놀라 주는 게 좋을까.」
		ENDIF
		;２回目以降
	ELSE
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「응, 고마워. 마음만으로도 나는 배불러.」
			PRINTFORMW 「하지만 어렵게 만들어 준 거니까 받을게♪」
			;恋慕で無い
		ELSE
			PRINTFORMW 「또 나에게 먹어달라고 하는 거야? 더 적합한 사람이 있을 거라고 생각해.」
			PRINTFORMW 「하지만 나의 것을 위해 만들어 준 거라면, 그건 기쁘겠네... 받을게♪」
		ENDIF
		PRINTFORMW 「음…, 아무우…… 응그, 모구……」
		;失敗か嫌いな味
		IF TFLAG:193 == -1 || (TCVAR:MASTER:308 | 60)
			IF RAND:3 == 0
				PRINTFORMW 「......윽!?」
				PRINTFORMW 「……」
				PRINTFORMW 「이런 걸 먹고 살아간다는 게……」
				PRINTFORMW 「지금 내가 사람의 마음을 먹고 살아가는 요괴라서 다행이라고 정말 생각했어」
			ELSEIF RAND:2
				PRINTFORMW 「……」
				PRINTFORMW 「이거, 혹시 사람 놀리는 법 강의 같은 거야?」
				PRINTFORMW 「하지만 말이야, 먹어주지 않으면 의미가 없잖아~」
			ELSE
				PRINTFORMW 「후루룩... 음~?」
				PRINTFORMW 「저기, 이게 지금 화제의 '치리토테친'이라니 농담하는 거죠?」
			ENDIF
			;好みの味
		ELSEIF TCVAR:MASTER:308 == 1
			PRINTFORMW 「응, 맛있어... 정말 맛있어」
			PRINTFORMW 「역시 %조사처리(CALLNAME:MASTER,"의")% 간이 좋아」
			PRINTFORMW 「너무 맛있어서 놀라 버렸어」
			PRINTFORMW 「나는 깜짝 놀라게 하지만 %조사처리(CALLNAME:MASTER,"는")% 업으로 놀라게 하는구나. 어쩐지 존경하게 돼」
			;普通の味
		ELSE
			PRINTFORMW 「응, 맛있다……」
			PRINTFORMW 「……그렇다고 생각한다, 아마도」
			PRINTFORMW 「역시 나에게는 인간의 음식 맛은 잘 모르겠어, 그런 걸까」
			PRINTFORMW 「이런 말을 하는 것도 그렇지만, 나보다는 다른 딸들을 위해 만들어 주는 게 좋을지도 모르겠다ね」
		ENDIF
	ENDIF
ENDIF
RETURN 1
