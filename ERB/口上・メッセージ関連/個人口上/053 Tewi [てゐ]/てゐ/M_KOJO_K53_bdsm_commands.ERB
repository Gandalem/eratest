@K53_SPANKING
PRINTFORM 「
FOR LOCAL, 0, RAND(1,5)
		;Generate a random number of hearts, for variety. The number increases the more masochistic she is.
	LOCALS = 
	IF ABL:53:マゾっ気 > 10 && !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF ABL:53:マゾっ気 > 8 && !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF ABL:53:マゾっ気 > 5 && !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF ABL:53:マゾっ気 > 3 && !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF ABL:53:マゾっ気 > 1
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	PRINTFORM %SLUR(SPLIT_G(@"Nooo:Nyoo:Nghoo:Oww:Ouuuch:Aaah:Aaagh:Waah"),RAND(2,4))%!%LOCALS%... 
NEXT
PRINTFORML %SLUR(SPLIT_G(@"Nooo:Nyoo:Nghoo:Oww:Ouuuch:Aaah:Aaagh:Waah"),RAND(2,4))%!%LOCALS%」
IF CFLAG:53:K53C_SPANKING_EVENT > 5 && !RAND:2
	LOCALS = %UNICODE(0x2764)%
	IF ABL:53:マゾっ気 > 10 && !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF ABL:53:マゾっ気 > 8 && !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	IF !RAND:2
		LOCALS += @"%UNICODE(0x2764)%"
	ENDIF
	PRINTFORML 「%SPLIT_G(@"M-Mooore―%LOCALS%:Incredible...%LOCALS%:I'm such a naughty giiiirl―%LOCALS%:Punish me mooore―%LOCALS%:Don't stop%LOCALS%:Is that all you've got?%LOCALS%:Spank me harder%LOCALS%:Do it more%LOCALS%:It huuurts%LOCALS%:Keep going...%LOCALS%:I haven't learned my lesson yet%LOCALS%:Oh, noooo―%LOCALS%:No more, no moooore―%LOCALS%")%」
ELSEIF CFLAG:53:K53C_SPANKING_EVENT > 3
	IF FLAG:なりきり != 52 && IS_MET(52) && !RAND:8
		PRINTFORML 「I'm sorry I %SPLIT_G(@"spread a rumor in the village that Reisen sells produce:made Reisen do all my chores:tricked Reisen into thinking that tengu are actually bears:faked Reisen's death last week:forged Reisen's will:got Reisen drunk off of fermented apples:put a beehive in Reisen's closet:turned all of Reisen's clothes inside out:filled Reisen's shoes with milk")%!」
	ELSE
		PRINTFORML 「I'm sorry I %SPLIT_G(@"dug that pitfall trap:ate your lunch before:fished in the lake with dynamite:put hats on all the Jizou statues:replaced the shampoo with bacon grease:made fun of groundhogs:painted all over the veranda:cultivated mushrooms under the storehouse:used ghosts from the Road of Liminality to refrigerate our food:crashed the Charisma market:published a fake Agatha Chris Q story where the culprit is a rabbit:sold one of my sketchbooks to the book renter as a demon book:tried to raise bees:ate the last dango:planted rafflesias around the house:screamed in the operating room")%!」
	ENDIF
ELSE
	CALL K53_AUTO_PVOICE
ENDIF
WAIT

