		CASE 9
			IF K53_PVOICE_FRAG:9
				;刺激が大きい場合キス感覚外処理
				IF K53_刺激LV("快感") >= 2 || K53_刺激LV("苦痛") >= 1 || K53_刺激LV("反感") >= 1
					SELECTCASE RAND:9
						CASE 0
							LOCALS += "Hn! Hn! Hn!"
						CASE 1
							LOCALS += "Nnn!"
						CASE 2
							LOCALS += "Nmuhhh～～?!"
						CASE 3
							LOCALS += "Mmnnn!"
						CASE 4
							LOCALS += "Nguhhh～～!"
						CASE 5
							LOCALS += "Nnnghhh?!"
						CASE 6
							LOCALS += "Mbwuhh!"
						CASE 7
							LOCALS += "Nmmuhhh!"
						CASE 8
							LOCALS += "～～～!"
					ENDSELECT
					SELECTCASE RAND:2
						CASE 0
							LOCALS += K53_ハート付与(2)
					ENDSELECT
				ELSEIF K53_刺激LV("快感") >= 0
					SELECTCASE RAND:9
						CASE 0
							LOCALS += "Hn"
						CASE 1
							LOCALS += "Ngh!"
						CASE 2
							LOCALS += "Hnngh～"
						CASE 3
							LOCALS += "Nnuhh"
						CASE 4
							LOCALS += "Fuh"
						CASE 5
							LOCALS += "Fuiihh"
						CASE 6
							LOCALS += "Uuu"
						CASE 7
							LOCALS += "Ufuuhh"
						CASE 8
							LOCALS += "Uoohhh"
					ENDSELECT
					SELECTCASE RAND:2
						CASE 0
							LOCALS += K53_ハート付与(2)
						CASE 1
							LOCALS += "..."
					ENDSELECT
				ENDIF
			ENDIF
	ENDSELECT
	
	OUTPUT += LOCALS
	SIF STRLENS(LOCALS)
		OUTPUT += " "
	
	;文字数が一定に達したら終了
	SIF STRLENSU(OUTPUT) > K53_NUM
		BREAK
REND

;*********************************************************************************
;あえぎ声描画
OUTPUT '= REPLACE(OUTPUT, " $", "")
CALL PRINT_DIALOGUE, OUTPUT