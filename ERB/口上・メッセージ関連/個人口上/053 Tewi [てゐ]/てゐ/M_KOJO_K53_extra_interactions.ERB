	RETURN 1
ELSEIF IS_HERE([[てゐ]], [[鈴仙]]) ;Reisen only
	CFLAG:53:K53C_REISEN_GROUP_SEX ++
	CALL K53_REISEN_RAW_CONVINCE
	IF RESULT
		RETURN 1
	ELSE
		SELECTCASE RAND:9
			CASE 0
				CALL CHARA_TEXT(53,@"「좋아! 섹스에서 리센에게 지지 않을 거야!」","w")
				CALL CHARA_TEXT(52,@"「저, 저건 두고 봐야겠어...」","w")
			CASE 1
				CALL CHARA_TEXT(53,@"「나를 돌봐줘, 라이젠―!」","w")
				CALL CHARA_TEXT(52,@"「뭐야, 왜 이렇게 행복해 보이는 거야...?」","w")
			CASE 2
