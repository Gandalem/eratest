					CALL CHARA_TEXT(52,@"「여기가 초점은 %K53_REISEN_MASTERNAME()%가 아니었나...?」","w")
					CALL CHARA_TEXT(53,@"「리센과 %조사처리(CALLNAME:MASTER,"와")% 성관계하기!」","w")
