		CASE 1
			CALL CHARA_TEXT(62,@"「모두 최선을 다해라.」","w")
			CALL CHARA_TEXT(53,@"「맞아, 우리 모두 최선을 다하자!」","w")
			CALL CHARA_TEXT(72,@"「그리고 즐겁게 보내도록 기억해라.」","w")
