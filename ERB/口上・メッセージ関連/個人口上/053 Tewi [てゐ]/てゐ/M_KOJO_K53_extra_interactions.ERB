					CALL CHARA_TEXT(52,@"「그게 문제가 아니야, 그리고 그건 그렇게 작동하지도 않아!」","w")
				ELSEIF HAS_PENIS(MASTER) && !THINKS_IS_VIRGIN(53) && THINKS_IS_VIRGIN(52)
					CALL CHARA_TEXT(53,@"「%CALLNAME:MASTER%, 리센은 아직 처녀성(hymen)을 가지고 있어! 뭘 해야 할지 알겠지, 안 그래?」","w")
					CALL CHARA_TEXT(52,@"「저기, 나 대신 그렇게 결정하지 마요!」","w")
				ELSEIF HAS_PENIS(MASTER) && THINKS_IS_VIRGIN(53) && !THINKS_IS_VIRGIN(52)
					CALL CHARA_TEXT(52,@"「생각해 보니 테위, 너 처녀지?」","w")
					CALL CHARA_TEXT(53,@"「에헤... 라이젠이 무서운 표정을 짓고 있어.」","w")
					CALL CHARA_TEXT(52,@"「그냥 생각하고 있었는데, 한 번은 네가 순종적인 쪽이었으면 좋겠어.」","w")
