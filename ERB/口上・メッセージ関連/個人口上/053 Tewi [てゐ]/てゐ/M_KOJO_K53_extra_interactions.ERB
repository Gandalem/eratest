@K53_PENETRATION(Position,Continued)
#DIM DYNAMIC Position
#DIM DYNAMIC Continued
CALL D_LINE
SIF SHIRAHU(53) && !TCVAR:無理矢理
	CALL K53_REMOVE_CONTRACEPTION()
IF FLAG:70
	PRINTFORMDL 당신은 %TINKO(MASTER)%를 테위의 %K53_MANKO()%에 박아 넣으며, 그녀의 얼어붙은 단단함을 즐긴다...
	PRINTFORMDW
	RETURN 1
ELSEIF CFLAG:MASTER:イタズラ == 2
	PRINTFORMDL 당신은 테위의 %K53_MANKO()% 안으로 당신의 %TINKO(MASTER)%를 넣었다가 빼면서...
	PRINTFORMDW
	RETURN 1
ELSEIF TCVAR:無理矢理
	PRINTFORMDL 당신은 그녀의 두려움에 찬 울음에도 아랑곳하지 않고 당신의 %TINKO(MASTER)%를 Tewi의 %K53_MANKO()%에 박아 넣는다...
	PRINTFORMDW
	RETURN 1
ELSEIF GROUPMATCH(TCVAR:53:破瓜,-1,1)
	CALL K53_VIRGINITY_LOSS(0)
	RETURN 1
ELSEIF IS_ERECT(MASTER) > 1
	RESULT = 0
	CALL K53_PENETRATION_EVENT(0)
	IF RESULT
		RETURN 1
	ENDIF
ENDIF
IF TEQUIP:0 & 2 && !Continued && GROUPMATCH(Position,2,3,4)
	PRINTFORMD %SPLIT_G(@"티위는 그녀의 %SHOW_BOTTOM(TARGET,2)%을 옆으로 치운다. 그리고:그녀의 %SHOW_BOTTOM(TARGET,2)%을 옆으로 치우면서, 티위:그녀의 %SHOW_BOTTOM(TARGET,2)%을 옆으로 치우며, 티위")%
ELSEIF TEQUIP:0 & 2 && !Continued
	PRINTFORMD %SPLIT_G(@"당신은 그녀를 %SHOW_BOTTOM(TARGET,2)% 옆으로 밀어낸 다음:그녀를 %SHOW_BOTTOM(TARGET,2)% 옆으로 밀면서, 당신은 그녀를 %SHOW_BOTTOM(TARGET,2)% 옆으로 옮긴다.")%
ELSEIF GROUPMATCH(Position,2,3,4)
	PRINTFORMD 테위
ELSEIF !Continued
	PRINTFORMD 당신
ENDIF
SELECTCASE Position
	CASE 0
		;Missionary.
		PRINTFORMDL  %SPLIT_G(@"테위의 다리를 잡고 당신의 %TINKO(MASTER)%을 그녀의 %K53_MANKO()% 안으로 박아 넣어, 그녀의 %K53_MANKO()%가 당신의 거기를 조이는 압박감을 느끼며:당신의 %TINKO(MASTER)%을 테위의 악력 있는 보지 안으로 넣었다 빼며:그녀의 다리를 잡은 채로 테위의 %K53_MANKO()%를 때리며:테위의 %K53_MANKO()% 안으로 밀고 들어가 그녀의 작은 몸이 주는 압박을 견디며:당신의 %TINKO(MASTER)%을 테위의 %K53_MANKO()% 안으로 미끄러뜨리며, 당신의 골반을 맞대며:그녀의 허벅지를 잡은 채로 테위의 %K53_MANKO()% 안에서 박아 넣었다 빼며:테위의 허벅지를 잡고 그녀의 %K53_MANKO()% 안으로 밀어 넣으며:당신의 %TINKO(MASTER)%으로 테위의 %K53_MANKO()%를 관통하며, 그녀의 허벅지를 붙잡고:그녀의 %K53_MANKO()% 안으로 박아 들어가면서 테위의 정강이를 움켜쥐며:테위가 등을 대고 누워 있는 동안 당신의 %TINKO(MASTER)%을 테위의 %K53_MANKO()% 안으로 인도하며:테위를 등을 대게 하고 당신의 %TINKO(MASTER)%을 그녀의 %K53_MANKO()% 안에 박아 넣으며:테위를 등을 대게 하고 당신의 %TINKO(MASTER)%을 그녀의 %K53_MANKO()% 안으로 난폭하게 밀어 넣는다")%...
	CASE 1
		;Doggy style.
		PRINTFORMDL  %SPLIT_G(@"테위의 엉덩이를 잡고 당신의 %TINKO(MASTER)%을 그녀의 %K53_MANKO()% 안으로 뒤에서 밀어 넣는다:테위를 뒤에서 피스톤질하며, 그녀의 %K53_MANKO()%가 당신의 거기를 조여오는 압박감을 느끼게 한다:당신의 %TINKO(MASTER)%을 테위의 꽉 잡는 보지 속으로 앞뒤로 강제로 밀어넣는다:그녀의 다리를 붙잡고 테위의 %K53_MANKO()%를 때린다:작은 몸의 압박을 견디며, 뒤에서 테위의 %K53_MANKO()% 안으로 돌진한다:당신의 %TINKO(MASTER)%을 테위의 %K53_MANKO()% 안으로 미끄러지게 하며, 골반을 연결한다:그녀의 허리를 잡고 당신이 그녀의 %K53_MANKO()% 안으로 피스톤질하는 동안 테위의 %K53_MANKO()% 안에서 앞뒤로 피스톤질한다:테위의 엉덩이를 잡고 그녀의 %K53_MANKO()% 속으로 돌진한다:당신의 %TINKO(MASTER)%을 이용해 테위의 %K53_MANKO()%를 관통하며, 그녀의 허리를 붙잡는다:그녀의 %K53_MANKO()% 안으로 피스톤질하는 동안 테위의 엉덩이를 잡는다:네 발로 기어 있는 테위에게 당신의 %TINKO(MASTER)%을 안내한다:테위를 숙이고 당신의 %TINKO(MASTER)%을 그녀의 %K53_MANKO()% 안으로 뒤에서 박아 넣는다:테위를 숙이고 당신의 %TINKO(MASTER)%을 그녀의 %K53_MANKO()% 안으로 뒤에서 난다.")%...
