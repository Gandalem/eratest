					CALL CHARA_TEXT(53,@"「라이젠, 오늘 우리 둘 다 임신하자!」","w")
					CALL CHARA_TEXT(52,@"「ㄷ, 그런 말은 하지 마...」","w")
					CALL CHARA_TEXT(53,@"「우리 아이들은 쌍둥이일 거야!」","w")
					CALL CHARA_TEXT(52,@"「그게 작동하는 방식이 아니야!」","w")
				ELSEIF HAS_PENIS(MASTER) && !TALENT:53:妊娠 && !TALENT:52:妊娠
					CALL CHARA_TEXT(53,@"「에헤, 리젠, 우리 둘 다 임신하면 어떡하지?」","w")
					CALL CHARA_TEXT(52,@"「ㄷ, 그런 말은 하지 마...」","w")
				ELSEIF HAS_PENIS(MASTER) && TALENT:53:妊娠 && TALENT:52:妊娠 && !PREGNANCY_MULTIPLES(53) && !PREGNANCY_MULTIPLES(52)
					CALL CHARA_TEXT(53,@"「%CALLNAME:MASTER%, 이미 임신했어! 쌍둥이를 바라는 거야?%UNICODE(0x2764)%」","w")
					CALL CHARA_TEXT(52,@"「티위, 그렇게 작동하는 게 아니야...」","w")
