			CASE 5
				CALL CHARA_TEXT(52,@"「여기서 이기려고 한다면, 테이, 너는 %K53_REISEN_MASTERNAME()%과 나에게 더 높은 호환성이 있다는 것을 알아야 해.」","w")
				CALL CHARA_TEXT(53,@"「오오―오! 레이선이 오늘 자신감이 넘치는군! 좋아, 네 도전을 받아들이겠어!」","w")
			CASE 6
				CALL CHARA_TEXT(52,@"「이번엔 내가 너를 이길 거라고 확신해, 테위!」","w")
				CALL CHARA_TEXT(53,@"「기습 공격이다!」","w")
