				CALL CHARA_TEXT(52,@"「자, %CALLNAME:MASTER%! 그녀를 끝내 버려라!」","w")
			CASE 7
				CALL CHARA_TEXT(52,@"「나에게 부드럽게 대해줘...」","w")
				CALL CHARA_TEXT(53,@"「그녀는 사실 거친 것을 좋아한다는 뜻이네.」","w")
				CALL CHARA_TEXT(52,@"「쉿-닥쳐!」","w")
