			CALL CHARA_TEXT(72,@"「...음...」","w")
			CALL CHARA_TEXT(52,@"「그녀는 실제로 그것에 대해 생각하고 있어...」","w")
			CALL CHARA_TEXT(53,@"「자, 어서! 벌써 하자!」","w")
		CASE 3
			CALL CHARA_TEXT(53,@"「좋아, 모두들! 질서 있고 활기찬 그룹 섹스를 하자!」","w")
			CALL CHARA_TEXT(52,@"「기분 망치지 마, 테위.」","w")
			CALL CHARA_TEXT(72,@"「그거 생각나서 말인데, 다들 깨끗이 손 씻었어?」","w")
			CALL CHARA_TEXT(52,@"「마스터님, 당신도 아니야...」","w")
			IF IS_HERE([[妹紅]])
				CALL CHARA_TEXT(61,@"「어, 난...」","w")
			ENDIF
			CALL CHARA_TEXT(62,@"「스트레칭을 전혀 못 했어... 잠시 쉬어도 될까?」","w")
			CALL CHARA_TEXT(53,@"「그건 그렇고, 에너제로나 로션 필요한 사람 있으면 할인 중이야!」","w")
			CALL CHARA_TEXT(52,@"「아아악, ITALIC다 조용히 하고 섹스 해!」","strw")
			PRINTFORMDW 리센의 눈이 밝은 빨간색으로 번쩍이고 다른 모든 사람들은 말을 멈춘다. 그들은 대신 당신을 바라보며 당신에게 손을 뻗기 시작한다...
		CASE 4
			CALL CHARA_TEXT(52,@"「우리 모두 여기 있어...」","w")
			CALL CHARA_TEXT(72,@"「%CALLNAME:MASTER%」를 낙담시키지 마라, 우동게.","w")
			IF TALENT:62:恋人 || (TALENT:62:妄信 && TALENT:MASTER:追加種族 == 4)
