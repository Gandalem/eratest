			ELSE
				CALL CHARA_TEXT(62,@"「이곳은 혼잡하게 느껴지지 않나?」","w")
			ENDIF
			IF IS_HERE([[妹紅]])
				CALL CHARA_TEXT(61,@"「성급하게 생각하지 마, 카구야. %HIM_HER(MASTER)%는 나에게 맡겨둬!」","w")
			ENDIF
			CALL CHARA_TEXT(53,@"「%CALLNAME:MASTER%, 저희를 돌봐주세요―!」","w")
