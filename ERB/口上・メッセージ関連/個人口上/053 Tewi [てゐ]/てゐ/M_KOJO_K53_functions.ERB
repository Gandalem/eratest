SELECTCASE K53_CHILD_PERSONALITY(ARG)
	CASE "Cheerful","Show-off"
		IF DAY - CHILD_BIRTHDAY:53:ARG < CHILD_自立前
			IF IS_MALE(MASTER)
				RETURNF "Papa"
			ELSE
				RETURNF "Mama"
			ENDIF
