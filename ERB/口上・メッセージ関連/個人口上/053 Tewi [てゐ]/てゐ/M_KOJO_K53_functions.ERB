@K53_CHILD_SET_COLOR(ChildIndex)
;Assigns and then randomizes the given child's font color based on personality.
#DIM DYNAMIC ChildIndex
#DIM DYNAMIC NewColorR
#DIM DYNAMIC NewColorG
#DIM DYNAMIC NewColorB
SELECTCASE K53_CHILD_PERSONALITY(ChildIndex)
	CASE "Cheerful"
		NewColorR = 229
		NewColorG = 180
		NewColorB = 167
	CASE "Show-off"
		NewColorR = 246
		NewColorG = 144
		NewColorB = 179
	CASE "Defiant"
		NewColorR = 246
		NewColorG = 160
		NewColorB = 144
	CASE "Tsundere"
		NewColorR = 198
		NewColorG = 122
		NewColorB = 135
	CASE "Prideful"
		NewColorR = 246
		NewColorG = 230
		NewColorB = 226
	CASE "Devoted"
		NewColorR = 246
		NewColorG = 226
		NewColorB = 232
	CASE "Gloomy"
		NewColorR = 194
		NewColorG = 154
		NewColorB = 161
ENDSELECT
NewColorR = MIN(NewColorR+RAND(-20,20),255)
NewColorG += RAND(-20,20)
NewColorB += RAND(-20,20)
CHILD_COLOR:53:ChildIndex = COLOR_FROMRGB(NewColorR,NewColorG,NewColorB)
RESULT = 1
RETURN RESULT

@K53_REISEN_WINGMAN(IgnoreConditions)
;Returns 1 if Tewi is actively trying to hook the player up with Reisen.
;Tewi must have gotten the idea during the first wingman event and must either not have a fall state or have agreed to keep it up after becoming a lover.
;Reisen also must not be a lover already.
;If IgnoreConditions is 1, only the flag needs to be set.
#FUNCTION
#DIM DYNAMIC IgnoreConditions
SIF !IgnoreConditions && IS_FALLEN(53) && (CFLAG:53:K53C_WINGMAN != 2 || TALENT:52:恋人)
	RETURNF 0
SIF CFLAG:53:K53C_WINGMAN
	RETURNF 1
RETURNF 0
