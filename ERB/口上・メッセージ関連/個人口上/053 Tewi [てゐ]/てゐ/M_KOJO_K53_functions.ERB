@K53_CONFIGURE()
;Simple configuration menu. As quick and painless as possible for the player, without going into submenus and the like.
RESETCOLOR
DRAWLINE
PRINTFORMDL
PRINTFORMDL
PRINTFORMDL 테위와 만나기 전에 당신은 그녀를 원하는 대로 커스터마이징할 수 있다.
$TOP
PRINTFORMDL
PRINTFORMDL
PRINTFORMDL [ 0] 테위는 \@ TALENT:53:処女 ? 처녀 # 처녀가 아니다 \@
PRINTFORMDL [ 1] 테위는 \@ TALENT:53:ヤリマン ? 걸레 # 걸레가 아니다 \@
SELECTCASE TALENT:53:バストサイズ
	CASE -2
		PRINTFORMDL [ 3] 티위는 가슴이 평평하다.
	CASE -1
		PRINTFORMDL [ 3] 테위는 작은 가슴을 가지고 있다.
	CASE 0
		PRINTFORMDL [ 3] 티위는 보통 가슴을 가지고 있다.
	CASE 1
		PRINTFORMDL [ 3] 트위는 큰 가슴을 가지고 있다.
	CASE 2
		PRINTFORMDL [ 3] 테위는 거대한 가슴을 가지고 있다.
ENDSELECT
SELECTCASE TALENT:53:108
	CASE -3
		PRINTFORMDL [ 4] 테위는 납작한 엉덩이를 가지고 있다.
	CASE -2
		PRINTFORMDL [ 4] 티위는 작은 엉덩이를 가졌다.
	CASE -1
		PRINTFORMDL [ 4] 티위는 작은 엉덩이를 가지고 있다.
	CASE 0
		PRINTFORMDL [ 4] 티위는 평균적인 엉덩이를 가졌다.
	CASE 1
		PRINTFORMDL [ 4] 테위는 큰 엉덩이를 가졌다.
	CASE 2
		PRINTFORMDL [ 4] 테위는 엄청난 엉덩이를 가졌다
ENDSELECT
PRINTFORMDL [ 5] 테위의 입은 \@ TALENT:53:Ｍ感度 == 1 ? 민감하다 # 특별히 민감하지 않다 \@
PRINTFORMDL [ 6] 테위의 가슴은 \@ TALENT:53:Ｂ感度 == 1 ? 민감하다 # 특별히 민감하지 않다 \@
PRINTFORMDL [ 7] 테위의 음핵은 \@ TALENT:53:Ｃ感度 == 1 ? 민감하다 # 특별히 민감하지 않다 \@
PRINTFORMDL [ 8] 테위의 질은 \@ TALENT:53:Ｖ感度 == 1 ? 민감하다 # 특별히 민감하지 않다 \@
PRINTFORMDL [ 9] 테위의 항문은 \@ TALENT:53:Ａ感度 == 1 ? 민감하다 # 특별히 민감하지 않다 \@
PRINTFORMDL
PRINTFORMDL [10] 완료
$LOOP
INPUT
SELECTCASE RESULT
	CASE 0
		TALENT:53:処女 = !TALENT:53:処女
		GOTO TOP
	CASE 1
		TALENT:53:ヤリマン = !TALENT:53:ヤリマン
		GOTO TOP
	CASE 2
		TALENT:53:体型++
		IF TALENT:53:体型 != 0
			TALENT:53:体型 = -1
		ENDIF
		GOTO TOP
	CASE 3
		TALENT:53:バストサイズ++
		SIF TALENT:53:バストサイズ > 2
			TALENT:53:バストサイズ = -2
		GOTO TOP
	CASE 4
		TALENT:53:108++
		SIF TALENT:53:108 > 2
			TALENT:53:108 = -3
		GOTO TOP
	CASE 5
		SIF TALENT:53:Ｍ感度 == -1
			TALENT:53:Ｍ感度 = 0
		TALENT:53:Ｍ感度 = !TALENT:53:Ｍ感度
		GOTO TOP
	CASE 6
		SIF TALENT:53:Ｂ感度 == -1
			TALENT:53:Ｂ感度 = 0
		TALENT:53:Ｂ感度 = !TALENT:53:Ｂ感度
		GOTO TOP
	CASE 7
		SIF TALENT:53:Ｃ感度 == -1
			TALENT:53:Ｃ感度 = 0
		TALENT:53:Ｃ感度 = !TALENT:53:Ｃ感度
		GOTO TOP
	CASE 8
		SIF TALENT:53:Ｖ感度 == -1
			TALENT:53:Ｖ感度 = 0
		TALENT:53:Ｖ感度 = !TALENT:53:Ｖ感度
		GOTO TOP
	CASE 9
		SIF TALENT:53:Ａ感度 == -1
			TALENT:53:Ａ感度 = 0
		TALENT:53:Ａ感度 = !TALENT:53:Ａ感度
		IF EXP:53:Ａ経験 < 2 && TALENT:53:Ａ感度
			EXP:53:Ａ経験 = 2
		ELSEIF EXP:53:Ａ経験 == 2 && !TALENT:53:Ａ感度
			EXP:53:Ａ経験 = 0
		ENDIF
		GOTO TOP
	CASE 10
		CALL SET_KOJO_COLOR(53)
	CASEELSE
		GOTO LOOP
ENDSELECT

@K53_TSUN(IntimacyThreshold=5)
;Tewi will have a more reserved personality below the Intimacy threshold, or if she isn't feeling positive towards the player.
#FUNCTION
#DIM DYNAMIC IntimacyThreshold
SIF ABL:53:親密 < IntimacyThreshold
	RETURNF 1
SIF TALENT:53:機嫌 < 0
	RETURNF 1
SIF MARK:53:反発刻印
	RETURNF 1
SIF CFLAG:53:ブチギレ
	RETURNF 1
RETURNF 0

@K53_REISEN_MASTERNAME
;Returns the player's name with a honorific if Reisen is not at least Yearning, like in Reisen's dialogue.
#FUNCTIONS
IF TALENT:52:思慕 || TALENT:52:恋慕 || TALENT:52:恋人
	RETURNF @"%CALLNAME:MASTER%"
ELSE
	RETURNF @"%CALLNAME:MASTER%님"
ENDIF

@K53_WEATHER_REJECTION
;Random lines to say if you try to interact with her while she's outside in a storm.
PRINTFORML 「%SPLIT_G(@"왜 밖에 있나요? 안으로 들어가요!: 어서, 여기서 나가자!: 나는 여기에 있고 싶지 않아요!")%」
;Child-handling functions for the purpose of getting around TW's limitations regarding children.
;Each child's character is derived from a combination of personality and hobby. These are assigned the first time they're checked.

@K53_CHILD_SET_PERSONALITY(ChildIndex)
#DIM DYNAMIC ChildIndex
#DIMS DYNAMIC ChildPersonality
SIF CHILD_TRAIT(53,ChildIndex,"Cheerful,Show-off,Defiant,Tsundere,Prideful,Devoted,Gloomy")
	RETURN
$TOP
SELECTCASE RAND:5
	CASE 0
		ChildPersonality '= "Cheerful"
	CASE 1
		ChildPersonality '= "Show-off"
	CASE 2
		IF TALENT:ChildIndex:2 == 2
			ChildPersonality '= "Defiant"
		ELSE
			ChildPersonality '= "Tsundere"
		ENDIF
	CASE 3
		IF TALENT:ChildIndex:2 == 2
			ChildPersonality '= "Prideful"
		ELSE
			ChildPersonality '= "Devoted"
		ENDIF
	CASE 4
		SIF RAND:3 ;Rare personality.
			GOTO TOP
		ChildPersonality '= "Gloomy"
ENDSELECT
SIF ChildIndex < 6 && CFLAG:53:子供人数 < MAXCHILD && FIND_CHILD("53",,ChildPersonality) ;The first five children will have unique personalities.
	GOTO TOP
CALL ADD_CHILD_TRAIT(53,ChildIndex,ChildPersonality)

@K53_CHILD_SET_HOBBY(ChildIndex)
#DIM DYNAMIC ChildIndex
#DIMS DYNAMIC ChildHobby
SIF CHILD_TRAIT(53,ChildIndex,"Camping,Gardening,Sports,Singing,Martial Arts,Danmaku,Cooking,Reading,Art")
	RETURN
$TOP
SELECTCASE RAND:6
	CASE 0
		IF TALENT:ChildIndex:2 == 2
			ChildHobby '= "Camping"
		ELSE
			ChildHobby '= "Gardening"
		ENDIF
	CASE 1
		IF TALENT:ChildIndex:2 == 2
			ChildHobby '= "Sports"
		ELSE
			ChildHobby '= "Singing"
		ENDIF
	CASE 2
		IF TALENT:ChildIndex:2 == 2
			ChildHobby '= "Martial Arts"
		ELSE
			ChildHobby '= "Danmaku"
		ENDIF
	CASE 3
		ChildHobby '= "Cooking"
	CASE 4
		ChildHobby '= "Reading"
	CASE 5
		ChildHobby '= "Art"
ENDSELECT
SIF ChildIndex < 7 && CFLAG:53:子供人数 < MAXCHILD && FIND_CHILD("53",,ChildHobby) ;The first six children will have unique hobbies.
	GOTO TOP
CALL ADD_CHILD_TRAIT(53,ChildIndex,ChildHobby)

@K53_CHILD_PERSONALITY(ChildIndex)
#FUNCTIONS
#DIM DYNAMIC ChildIndex
#DIMS DYNAMIC CheckPersonality
WHILE 1
SELECTCASE CheckPersonality
	CASE ""
		CheckPersonality '= "Cheerful"
	CASE "Cheerful"
		CheckPersonality '= "Show-off"
	CASE "Show-off"
		CheckPersonality '= "Defiant"
	CASE "Defiant"
		CheckPersonality '= "Tsundere"
	CASE "Tsundere"
		CheckPersonality '= "Prideful"
	CASE "Prideful"
		CheckPersonality '= "Devoted"
	CASE "Devoted"
		CheckPersonality '= "Gloomy"
	CASE "Gloomy"
		; [AUTO-NEUTRALIZED] THROW @K53_CHILD_PERSONALITY error with ChildIndex {ChildIndex}, personality was not assigned.
ENDSELECT
SIF CHILD_TRAIT(53,ChildIndex,CheckPersonality)
	RETURNF CheckPersonality
WEND

@K53_CHILD_HOBBY(ChildIndex)
#FUNCTIONS
#DIM DYNAMIC ChildIndex
#DIMS DYNAMIC CheckHobby
WHILE 1
SELECTCASE CheckHobby
	CASE ""
		CheckHobby '= "Camping"
	CASE "Camping"
		CheckHobby '= "Gardening"
	CASE "Gardening"
		CheckHobby '= "Sports"
	CASE "Sports"
		CheckHobby '= "Singing"
	CASE "Singing"
		CheckHobby '= "Martial Arts"
	CASE "Martial Arts"
		CheckHobby '= "Danmaku"
	CASE "Danmaku"
		CheckHobby '= "Cooking"
	CASE "Cooking"
		CheckHobby '= "Reading"
	CASE "Reading"
		CheckHobby '= "Art"
	CASE "Art"
		; [AUTO-NEUTRALIZED] THROW @K53_CHILD_HOBBY error with ChildIndex {ChildIndex}, hobby was not assigned.
ENDSELECT
SIF CHILD_TRAIT(53,ChildIndex,CheckHobby)
	RETURNF CheckHobby
WEND

@K53_CHILD_MASTER_NICKNAME(ARG)
