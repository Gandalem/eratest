;Irrumatio (Facefucking)
;140,イラマチオ
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K53_140
RETURN 0

@M_KOJO_MESSAGE_COM_K53_140
SIF FLAG:70
	RETURN 1
IF !RAND:3
	PRINTFORM 「
	FOR LOCAL, 0, RAND:7
	PRINTFORML %SPLIT_G(@"%FSYN("lips_muffle")%:%RANDKISS("suck")%")%...%SPLIT_G(@"%UNICODE(0x2764)%:")% 
	NEXT
	PRINTFORML %SPLIT_G(@"%FSYN("lips_muffle")%:%RANDKISS("suck")%")%...%UNICODE(0x2764)%」
ELSE
	CALL K53_AUTO_PVOICE
ENDIF
WAIT
RETURN 1
