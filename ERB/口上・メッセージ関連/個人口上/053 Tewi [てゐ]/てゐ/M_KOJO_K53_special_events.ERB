; Modular ERB: 個人口上/053 Tewi [てゐ]/てゐ/M_KOJO_K53_special_events.ERB
;This file stores Tewi's special events, which are triggered through conversation or other normal actions.

@K53_SPECIAL_EVENTS(Counter)
;Events called from normal conversation.
#DIM DYNAMIC Counter
VARSET RESULT
;Events in this section can be triggered any time as long as their conditions are met.
;Each one is listed and called by name.
CALL K53_SPECIAL_EVENT("Mesugaki")
CALL K53_SPECIAL_EVENT("Juggling")
CALL K53_SPECIAL_EVENT("RFS Complaint")
SIF RESULT
	RETURN RESULT
SIF CHK_DATENOW(CFLAG:53:デート中) ;Abort if on a date.
	RETURN 0
SIF RAND:6 ;Random chance.
	RETURN 0
SIF TIME < 240 || TIME > 1140 || CFLAG:53:ブチギレ == 1 || TALENT:53:機嫌 == -1 || MARK:53:反発刻印 > 0 || !ONCE("SpecialEvent",1,53)
	RETURN 0
CALL K53_SPECIAL_EVENT("Favorite Food")
CALL K53_SPECIAL_EVENT("Who Is Cuter")
CALL K53_SPECIAL_EVENT("Water Balloons")
CALL K53_SPECIAL_EVENT("Potion Testing")
CALL K53_SPECIAL_EVENT("Gunpowder Cookies")
CALL K53_SPECIAL_EVENT("Cooking")
CALL K53_SPECIAL_EVENT("Reisen Rape")
CALL K53_SPECIAL_EVENT("Seiga Rape")
CALL K53_SPECIAL_EVENT("Silent Blowjob")
SIF RESULT
	CALLF ONCE("SpecialEvent",0,53)
RETURN RESULT

@K53_SPECIAL_EVENT(EventName)
;Attempts to trigger a special event, but only if a previous event was not already triggered.
#DIMS DYNAMIC EventName
SIF RESULT
	RETURN 1
TRYCALLFORM K53_SPECIAL_EVENT_%FUNCTION_FORMAT(EventName)%
RETURN RESULT

@K53_SPECIAL_EVENT_FAVORITE_FOOD
