; Modular ERB: 個人口上/053 Tewi [てゐ]/てゐ/M_KOJO_K53_mesugaki.ERB
;These events are so huge together, they get their own file.

@K53_CAN_START_MESUGAKI
#FUNCTION
SIF CFLAG:53:K53C_MESUGAKI
	RETURNF 0
SIF GETBIT(CFLAG:53:既成事実,1)
	RETURNF 0
SIF CFLAG:53:ヤラせちゃった
	RETURNF 0
SIF ABL:53:親密 > 3
	RETURNF 0
SIF TALENT:53:妊娠
	RETURNF 0
SIF IS_FALLEN(53)
	RETURNF 0
SIF TALENT:MASTER:体型 == -5
	RETURNF 0
RETURNF 1

@K53_CAN_CONTINUE_MESUGAKI
#FUNCTION
IF CFLAG:53:K53C_MESUGAKI > 0 && CFLAG:53:K53C_MESUGAKI < 5
	RETURNF 1
ENDIF
RETURNF 0

@K53_SPECIAL_EVENT_MESUGAKI
;Tewi is a brat and gets corrected for it... or not.
IF (TALENT:ヤリマン || CFLAG:53:体目当て) && K53_CAN_START_MESUGAKI()
	CFLAG:53:K53C_MESUGAKI --
	PRINTFORMDW 당신이 그녀와 이야기하는 동안, 테위는 커다란 당근 끝을 아삭아삭 깨문다.
	PRINTFORMW 「음... 음음...」
	PRINTFORMDW ...사실은 그것을 빨고 있는 것에 더 가깝다. 그녀는 그것으로 볼 안쪽을 찌른다... 당신이 쳐다보는 것을 보고, 그녀는 순진하게 당신에게 미소 짓는다.
	PRINTL
	PRINTFORMW 「뭐지? 무슨 일 있어?～」
	PRINTFORMDW 어쩌면 그녀는 깨닫지 못하고 있을지도 몰라... 아무것도 보지 못한 것처럼 가장한다.
	PRINTFORMW 「휴우... 지금 너무 피곤해～」
	IF EQUIP:53:下半身下着２
		PRINTFORMDW 테위는 다리를 벌리고 땅에 주저앉아 크게 하품을 했다. 당신은 그녀의 %PANTSNAME(EQUIP:53:下半身下着２,53)%를 가득 볼 수 있었다...
	ELSE
		PRINTFORMDW 테위가 다리를 살짝 벌린 채 땅에 주저앉아 크게 하품을 한다. 조금만 더 움직이면 그녀의 맨 보지를 볼 수 있다...
	ENDIF
	PRINTL
	PRINTFORMDW ...뭐라고?! 어떤 숙녀가 저렇게 앉을 리 없어!
	IF HAS_PENIS(MASTER)
		IF BASE:MASTER:勃起 < 1000
			PRINTFORMDW 당신은 한쪽 눈을 뜨고 장난기 가득한 눈빛으로 당신을 훔쳐보는 테위가 있는 것을 발견하지만, 이미 자신의 성기가 반쯤 세워져 있다는 사실을 너무 늦게 알아차린다.
		ELSE
			PRINTFORMDW 너는 한쪽 눈을 뜨고 장난기 어린 눈빛으로 너를 훔쳐보는 테위를 발견하고, 너무 늦게 네 성기가 완전히 발기해 있다는 것을 알아차린다.
		ENDIF
	ELSE
		PRINTFORMDW 당신은 한쪽 눈을 뜨고 장난기 어린 빛을 눈꺼풀 사이에 머금은 테위가 당신을 훔쳐보는 것을 발견하고, 자신이 입술을 깨물고 있다는 사실을 너무 늦게 알아차린다.
	ENDIF
	PRINTFORMDW 네가 움직일 틈도 없이 테이가 공중으로 뛰어올라 시야에서 사라진다.
	CALL K53_MESUGAKI()
	RESULT = 1
	RETURN 1
ELSEIF CFLAG:53:K53C_MESUGAKI > 0 && CFLAG:53:K53C_MESUGAKI < 5
	CFLAG:53:同行 = 0
	IF IS_CHILD(MASTER)
		LOCALS = kid
	ELSEIF TALENT:MASTER:年齢 > 0
		LOCALS = old %PRINT_MALE("man", MASTER)%
	ELSE
		LOCALS = %PRINT_MALE("boy", MASTER)%
	ENDIF
	SELECTCASE CFLAG:53:K53C_MESUGAKI
		CASE 1
			PRINTFORMW 「에이―응? 지금 나랑 말하려고 하는 거야―?」
			PRINTFORMDW 테위는 믿을 수 없다는 듯 당신에게 미소를 짓는다. 그녀의 표정은 너무 태연해서 아무 일도 자신에게 일어나지 않을 거라고 생각하는 것 같다.
			PRINTFORMW 「아, 알겠어! 복수하고 싶구나, 그렇지? 나를 제압하고 더러운 짓을 하고 싶다고? 그게 네가 생각하는 전부잖아, 맞지?」
			PRINTFORMW 「이 지독한 %LOCALS%～ 네 머릿속엔 오직 나를 더럽히고 싶은 마음뿐일 거라고 장담해―?」
			PRINTFORMDW 테위의 얼굴은 사악한 미소로 일그러지고 그녀는 천천히 치맛자락을 들어 올린다. 간신히 아무것도 보이지 않는다...
			PRINTFORMW 「이리 와 봐, 한번 해봐―～～～」
			PRINTL
			PRINTFORMDL [0] 시도해 봐
			PRINTFORMDL [1] 시도하지 마
			PRINTFORMDL [2] 시간을 멈추고 시도해 봐 (결론으로 건너뛰기)
			$LOOP
			INPUT
			PRINTL
			SELECTCASE RESULT
				CASE 0
					PRINTFORMDW 앞으로 한 걸음 내딛자마자, 이전처럼 머리를 바닥에 박고 쓰러진다.
					IF TALENT:MASTER:体型 == -5
						PRINTFORMDW 시야가 돌아왔을 때, 당신은 작은 숨겨진 새장 함정에 걸렸음을 볼 수 있다.
						PRINTFORMDW 그 새장은 상반신만 가두고 있으며 당신은 이전과 비슷한 자세로 놓이게 된다.
					ELSE
						PRINTFORMDW 시야가 돌아왔을 때, 당신은 눈치채지 못했던 작은 덫을 볼 수 있다... 테위는 언제 그걸 놓았을까?
						PRINTFORMDW 결국 당신은 이전과 같은 자세로, 밧줄에 묶여 있게 된다.
					ENDIF
					PRINTFORMDW 당신은 산들바람을 느끼며 테위가 당신의 %SHOW_BOTTOM(MASTER,9)%와 속옷을 다시 벗겼다는 것을 깨닫는다...
					IF HAS_PENIS(MASTER)
						PRINTFORMDW 당신의 %TINKO(MASTER)%가 두 번째로 노출된다. 테위가 웃기 시작한다.
						PRINTL
						IF BASE:MASTER:勃起 > 999
							PRINTFORMW 「봐, 또 단단해졌어! 진짜 너무― 역겨워!～」
						ELSE
							PRINTFORMW 「점점 힘들어져! 봐, 봐, 점점 힘들어지고 있어! 이거 너무― 역겨워―!～」
						ENDIF
						BASE:MASTER:勃起 += 1000
					ELSE
						PRINTFORMDW 당신의 질이 두 번째로 노출된다. 테위가 웃기 시작한다.
						PRINTL
						PRINTFORMW 「젖었어? 이거 때문에 젖는 거지?! 진짜 너무― 역겨워~!」
					ENDIF
					IF GET_TARGETNUM() > 1
						PRINTFORMDW 테위 외에 다른 시선이 근처에서 응시하고 있는 것을 느낀다...
					ELSEIF GET_TARGETNUM() > 2
						PRINTFORMDW 주변에서 다른 이들의 시선이 자신을 응시하는 것이 느껴진다...
					ENDIF
					CALL AddEXPOrdered("露出快楽経験", MASTER, 1)
					PRINTFORMW 「다 또 나한테 벗기려고 그랬어? 했을 거야, 이 도착적인 %LOCALS%―!～」
					PRINTFORMW 「꼬맹이 앞에서 그런 역겨운 페티시를 드러내는 게 부끄럽지도 않아? 아니, 잠깐, 네가 그걸 즐기고 있겠지!」
					PRINTFORMDW 테위는 당신의 머리 앞에 몸을 낮게 웅크리고 있으며, 간신히 손이 닿지 않는 곳에 다리 사이 공간을 감추고 있다. 그녀는 부드럽게 말한다...
					PRINTFORMW 「보고 싶어? 보여주진 않을 거야～ 아, 슬퍼하지 마～!」
					PRINTFORMDW 또다시 웃으며 테위가 일어선다.
					PRINTFORMW 「잘 가, 변태 %LOCALS%―!～」
					PRINTL
					PRINTFORMDW 테위는 웃으며 튕겨 나간다. 당신은 다시 자유로워지기까지 시간이 좀 걸린다.
					IF MAIN_MAP == 4
						IF CFLAG:53:現在位置 == 410
							CFLAG:53:現在位置 = 431
						ELSE
							CFLAG:53:現在位置 = 410
						ENDIF
					ELSE
						IF CFLAG:53:現在位置 == 480
							CFLAG:53:現在位置 = 440
						ELSE
							CFLAG:53:現在位置 = 480
						ENDIF
					ENDIF
					TALENT:53:機嫌 = 1
					TIME += 30
				CASE 1
					PRINTFORMDW 당신은 테오이에게 그녀에게 아무것도 하지 않을 것임을 보여주기 위해 애쓴다.
					PRINTL
					PRINTFORMW 「에헤―? 무슨 일이야? 겁먹은 거야~?」
					PRINTFORMDW 티위는 치맛자락을 조금 더 높이 들었다. 뭔가 거의 보인다고 생각한다...
					PRINTFORMW 「혹시, 교훈을 얻었니~? 네 위치를 이해했어~? 내가 이미 너를 개처럼 훈련시킨 거 알아~?」
					PRINTFORMDW 그녀는 웃으며 다른 손을 입가에 가져다 대고 즐거운 듯 당신을 째려본다.
					IF EQUIP:53:下半身下着２
						PRINTFORMW 「말도 안 돼~ 아직도 내 팬티를 보려고 하는 거야~ 하지만 보여주지 않을 거야~」
					ELSE
						PRINTFORMW 「말도 안 돼~ 아직도 내 보려고 하는 거야~ 하지만 보여주지 않을 거야~」
					ENDIF
					PRINTFORMDW 또 한 번의 웃음과 함께, 테위는 발끝으로 빙글 돌며 치마를 위험할 정도로 넓게 펼쳤다.
					PRINTFORMW 「잘 가, 변태 %LOCALS%―!～」
					PRINTL
					PRINTFORMDW 티위는 웃으며 튕겨 나간다.
					IF MAIN_MAP == 4
						IF CFLAG:53:現在位置 == 410
							CFLAG:53:現在位置 = 431
						ELSE
							CFLAG:53:現在位置 = 410
						ENDIF
					ELSE
						IF CFLAG:53:現在位置 == 480
							CFLAG:53:現在位置 = 440
						ELSE
							CFLAG:53:現在位置 = 480
						ENDIF
					ENDIF
					TALENT:53:機嫌 = 1
					TIME += 5
				CASE 2
					IF TALENT:MASTER:体型 == -5
						PRINTFORMDW 무언가 잘못되는 순간 시간을 멈추기 위해 준비하던 당신은 한 걸음 앞으로 나아가더니... 금속 조각에 발이 걸려 넘어졌다!
						PRINTL
						SETBGCOLOR C_THE_WORLD
						PRINTFORMDW ＴＨＥ・ＷＯＲＬＤ！！　ＳＴＯＰ・ＴＩＭＥ！
						PRINTL
						PRINTFORMDW 당신은 낙하 도중에 능력을 발동했고, 착지 직전에 시간이 멈췄다. 위를 올려다보니 테위가 점프하는 도중에 얼어붙어 있는 것이 보였다.
						PRINTFORMDW 작은 설치형 설치물이 너에게 내려오고 있다. 예전처럼 상반신만 가둘 것 같은 모습이다.
						PRINTFORMDW 그녀는 다시 당신의 %SHOW_BOTTOM(MASTER,9)%을 노리려 했다... 이제 누가 예측 가능한지?
						PRINTFORMDW 주변을 수색하다가 줄 방아쇠를 가진 두 번째 함정을 발견했다. 너는 밧줄을 얻기 위해 함정을 해체한다.
						PRINTFORMDW 당신은 테위의 발목에 조심스럽게 고리를 묶고, 크기의 차이에도 그녀를 끌어당길 수 있도록 마법을 시전했다.
					ELSE
						PRINTFORMDW 뭔가 잘못되는 순간 시간을 멈추기 위해 준비를 하고 한 걸음 내딛는다... 그리고 숨겨진 함정에 걸려 넘어지게 된다!
						PRINTL
						SETBGCOLOR C_THE_WORLD
						PRINTFORMDW ＴＨＥ・ＷＯＲＬＤ！！　ＳＴＯＰ・ＴＩＭＥ！
						PRINTL
						PRINTFORMDW 추락하는 도중 능력을 발동하자 착지 직전에 시간이 멈췄다. 위를 올려다보니 테위가 공중에 떠 있는 모습이 보였다.
						PRINTFORMDW 그녀는 손에 다른 밧줄을 들고 있었다. 테위는 다시 %SHOW_BOTTOM(MASTER,9)%를 노리려던 참이었다... 이제 너희 중 누가 예측 가능한 쪽인가?
						PRINTFORMDW 그녀의 손에서 밧줄을 낚아채자 대신 그녀의 발목에 고리를 걸었다. 완벽한 토끼 함정이다.
					ENDIF
					PRINTFORMDW 그러면 당신은 순간이동한 것처럼 보이지 않도록 빠르게 반응하는 것처럼 보이게 자신을 조심스럽게 위치시킨다.
					PRINTFORMDW 시간을 멈춰서 속일 수 있다고 해서 이 걸레 같은 애송이가 네가 어떻게 했는지 알 자격이 있는 건 아니야. 그 비밀은 너만 알고 있어야 한다.
					PRINTFORMDW 그리고 이제, 시간이 다시 흐를 것이다!
					RESETBGCOLOR
					PRINTL
					PRINTFORMW 「우아악―?!」
					PRINTFORMDW 너는 몸을 피하며 밧줄을 잡아당기고, 테위가 쓰러진다. 그녀는 잠시 동안 정신을 못 차린 채 바닥에 널브러져 있다.
					PRINTFORMDW 그 순간을 이용하여, 너는 그녀를 눈에 띄지 않는 곳으로 끌고 가기 시작한다...
					CALL K53_MESUGAKI_CORRECTION
				CASEELSE
					GOTO LOOP
			ENDSELECT
		CASE 2
			IF IS_CHILD(MASTER)
				PRINTFORMW 「에헤―? 또 내 팬티를 보려고 하는 거야, \@ IS_MALE(MASTER) ? 꼬마야 # 어린 아가야 \@～?」
			ELSE
				PRINTFORMW 「에엥—? 또 내 팬티를 보려고 하는 거야, \@ IS_MALE(MASTER) ? 아저씨 # 숙녀야 \@～?」
			ENDIF
			PRINTFORMDW 그런 걸 바로 믿다니, 그녀는 정말 고치기 힘든 사람이야...
			PRINTFORMW 「헤헤, 거짓말하지 마~ 너 같은 변태 %LOCALS%가 나 같은 어린애한테 말을 걸려고 하는 건 단 하나의 이유밖에 없잖아~」
			PRINTFORMW 「계속 물어본다고 내가 넘어갈 거라고 생각했어?~ 정신 차려~ 이대로 계속하면 들키고 벌 받을 거야~」
			PRINTFORMDW 누가 너를 혼내 줄 거냐고 묻는가? 그 질문에 테위는 코웃음을 친다.
			PRINTL
			PRINTFORMW 「에헤―, 내가 벌을 준다고 했을 때 흥분했니? 못된 %LOCALS%～ 미안하지만 난 그게 아니야...」
			PRINTFORMDW 장난기 어린 미소를 지으며 테위가 당신 뒤쪽을 가리킨다. 이건 당신의 시선을 끌려는 속임수인가?
			PRINTFORMDW ...아니, 정말 누군가 오는 소리가 들린다. 당신은 누가 오는지 보려고 몸을 돌린다...
			LOCAL:1 = 0
			$TEWI_BYSTANDER_LOOP
			LOCAL:1 ++
			IF LOCAL:1 == 5
				LOCALS:1 = the rabbit
			ELSE
				IF !IS_MASTER(1) && IS_MET_ENABLED(1) && !GETBIT(CFLAG:1:既成事実,1) && !CFLAG:1:ヤラせちゃった && ABL:1:親密 < 4 && !TALENT:1:セフレ && !RAND:2
					LOCALS:1 = Reimu
				ELSEIF !IS_MASTER(11) && IS_MET_ENABLED(11) && !GETBIT(CFLAG:11:既成事実,1) && !CFLAG:11:ヤラせちゃった && ABL:11:親密 < 4 && !TALENT:11:セフレ && !RAND:2
					LOCALS:1 = Marisa
				ELSEIF !IS_MASTER(52) && IS_MET_ENABLED(52) && !GETBIT(CFLAG:52:既成事実,1) && !CFLAG:52:ヤラせちゃった && ABL:52:親密 < 4 && !TALENT:52:セフレ
					LOCALS:1 = Reisen
				ENDIF
				IF LOCALS:1 == ""
					GOTO TEWI_BYSTANDER_LOOP
				ENDIF
			ENDIF
			IF LOCALS:1 == "the rabbit"
				PRINTFORMDW 또 다른 요괴 토끼가 커다란 모찌 망치를 들고 뒤에서 걸어온다.
				PRINTFORMDW 「테위 씨―!...에엣?!」
			ELSE
				SELECTCASE LOCALS:1
					CASE "Reimu"
						PRINTFORMDW 레이무가 뒤에서 다가온다. 그녀는 당신을 보고 손을 흔든다.
						CALL CHARA_TEXT([[霊夢]], @"「오, %CALLNAME:MASTER%... 찾고 있었는데-- 으악?!」", "w")
					CASE "Marisa"
						PRINTFORMDW 마리사가 뒤에서 다가온다. 그녀는 너를 보면 미소를 지으며 손을 흔든다.
						CALL CHARA_TEXT([[魔理沙]], @"「야, %CALLNAME:MASTER%! 재료 찾고 있었는데-- 와아?!」", "w")
					CASE "Reisen"
						PRINTFORMDW 라이젠이 뒤에서 다가온다. 그녀는 당신을 보고 손을 흔들며 테위에게 눈길을 준다.
						CALL CHARA_TEXT([[鈴仙]], "「테위, 도와줘-- 에야아?!」", "w")
