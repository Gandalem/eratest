;Functions related to the commission system.

@COMMISSION_STATUS_K53
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(53)
IF !Commission
	PRINTFORML 「Rabbits offer fast service for cheap! Want a whole horde of rabbits at your beck and call? Guaranteed a better price than kappa for any job!」
	PRINTFORML 「Entrust us with your labor and get the job done securely and economically!」
	SIF VAR_OR_DEFAULT("nSpoilerMode")
		PRINTFORMDL You strongly feel that Tewi is lying and her services will end up being unreliable...
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「Hmm, commission? What's that?～」
		CASE 1
			PRINTFORML 「We'll have it done tonight, really!」
		CASEELSE
			PRINTFORML 「It's a little delayed, but we'll get to it soon!」
	ENDSELECT
ENDIF

@COMMISSION_ABLE_1_K53
RETURN 1

@COMMISSION_DESCRIPTION_1_K53
PRINTFORML 「You want us to pound mochi for you? We can quickly prepare a large order for cheap and deliver it the very same day!」
PRINTFORML 「We'll also provide foraged greens and medicinal additives at no extra charge!」

@COMMISSION_ACCEPT_1_K53
PRINTFORML 「Hehe, smart thinking. We'll have everything ready by the end of the day, don't worry!」

@COMMISSION_RESOLVE_1_K53
PRINTFORMW 「When you put it that way, I guess I can move it up the priority list.」
COMMISSION_PROGRESS:1 = 500

@COMMISSION_CANCEL_1_K53
PRINTFORML 「Really? Well, okay!」
PRINTFORMDW Tewi looks a bit happier...

@COMMISSION_COST_1_K53(ARG)
SELECTCASE ARG
	CASE 0
		RESULT:1 = 5000
		RETURN -3
ENDSELECT

@COMMISSION_RATE_1_K53
RETURN 1000

@COMMISSION_WORK_SITE_1_K53(Location)
#DIM DYNAMIC Location
SIF Location != GET_MAP_REPLACEMENT(431)
	RETURN 0
IF COMMISSION_PROGRESS:1 < 0
	PRINTFORMDL Rabbits are lazing around the mochi mortar...
ELSE
	PRINTFORMDL Rabbits are pounding mochi for your delivery order...
ENDIF
RETURN 1

@COMMISSION_EVENT_1_K53
IF (!RAND:2 && !(TALENT:53:恋慕 && RAND:3)) || ((MARK:53:反発刻印 || CFLAG:53:ブチギレ) && COMMISSION_PROGRESS:1 == 1001)
	IF (MARK:53:反発刻印 || CFLAG:53:ブチギレ) && COMMISSION_PROGRESS:1 == 1001
		PRINTFORML 「Hmm, was I supposed to do some work for someone today?」
		PRINTFORML 「...Nah, I don't know anyone who deserves that～」
		PRINTFORMDW Tewi deliberately forgets about your delivery...
		CALL COMMISSION_STALL(1)
	ELSE
		PRINTFORMDL Before you go to sleep, Tewi drops by with some news...
		PRINTFORML 「About your delivery, %SPLIT_G(@"I forgot to do it:the rabbits wanted to play around today:the rabbits mixed up your order:we ate all the ingredients")%, so %SPLIT_G(@"it'll be a little longer:there'll be a short delay:it may be a bit late:we'll get it for you tomorrow instead")%!」
		PRINTFORMW 「Please bear with us～」
		COMMISSION_PROGRESS:1 = 500
	ENDIF
ENDIF

@COMMISSION_COMPLETE_1_K53
PRINTFORMDL Before you go to sleep, a rabbit drops by with a package.
IF !RAND:5
	LOCAL = 30+(RAND:11)
	PRINTFORMDL It's stuffed full of mochi and vegetables!
ELSE
	LOCAL = 20+(RAND:11)
ENDIF
PRINTFORMDW Received {LOCAL} cheap ingredients.
ITEM:安物食材 = MIN(ITEM:安物食材+LOCAL,100)
COMMISSION_PROGRESS:1 = 0
COMMISSION_EXPECTED_PROGRESS:1 = 0
COMMISSION_CHARACTER:1 = 0