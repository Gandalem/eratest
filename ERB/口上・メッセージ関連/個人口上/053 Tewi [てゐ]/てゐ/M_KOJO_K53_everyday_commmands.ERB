;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K53_301
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K53_301
RETURN 1

@M_KOJO_MESSAGE_COM_K53_301(ARG)
;Serve Tea.
CALL D_LINE
PRINTFORMDL 당신은 %SPLIT_G(@"carefully hands Tewi a hot cup of tea:serve Tewi a fresh cup of tea:share some freshly-prepared tea with Tewi:and Tewi share a cup of tea together:offer Tewi some freshly-prepared tea")%...에게 따뜻한 차를 건넨다.
PRINTFORMDW
IF IS_DRUNK(53) > 2
	SELECTCASE TFLAG:193
		CASE 0
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「후우... 꿀꺽... 꿀꺽...」
					PRINTFORMDL 테위는 차를 들이켜며 웃었다.
				CASE 1
					PRINTFORML 「후우, 불어봐! 후우― 후우―!」
			ENDSELECT
		CASE 1
			PRINTFORML 「%CALLNAME:PLAYER%-씨의 차가 정말 맛있다!」
		CASE -1
			PRINTFORML 「크흡 크흡... 후우! 술 더!」
	ENDSELECT
	PRINTFORMDL 죽은 취객 티위가 차를 마신다...
	;ブチギレ
ELSEIF CFLAG:ブチギレ
	PRINTFORML 「..................」
	PRINTFORMDL 테위는 당신을 마치 목을 조를 것처럼 노려본다.
	PRINTFORMDL 그녀는 아무 말 없이 당신의 손에서 찻잔을 가져간다.
	;初回
ELSEIF FIRSTTIME(301,0,53)
	PRINTFORML 「에? 이 차 어디서 구했어?... 그러니까 마시긴 할 건데 그래도...」
	PRINTFORMDL 티위는 당신을 주시하고 있음에도 불구하고 당신에게서 찻잔을 가져간다.
	;通常
ELSEIF K53_TSUN() || TFLAG:193 == -1
	PRINTFORML 「나를 위해 차를 만들어 주셨어? 고마워!」
	PRINTFORMDL 테위는 짧지만 정중하게 감사하며 당신에게서 찻잔을 받는다.
	PRINTL
	SELECTCASE TFLAG:193
		CASE 0
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「음... 홀짝... 후우...」
					PRINTFORMDL 테위는 이를 악문 채 차를 마신다. 시끄럽게.
				CASE 1
					PRINTFORML 「꿀꺽... 꿀꺽... 후우―」
					PRINTFORMDL 테위가 크게 차를 들이켰다.
			ENDSELECT
		CASE 1
			PRINTFORML 「음, 맛있어!」
			PRINTFORML 「하하! 마실수록 더 나아지는군...」
			PRINTFORMDL 그녀는 이상한 톤으로 그렇게 말했는데, 어쩌면 에이린을 따라 하는 것일지도 모른다...
		CASE -1
			PRINTFORML 「크윽, 잠깐만! 이것보다 더 나은 차는 없어?」
	ENDSELECT
ELSE
	SELECTCASE RAND:6
		CASE 0,1,2
			PRINTFORML 「%SPLIT_G(@"아, 좀 줘, 좀 줘!: 우와, 좀 줘!: 여기 줘!: 아, 목말라! 여기 줘!: 나한테? 우와!: 향이 좋다!")%」
			PRINTFORMDL 테위는 차를 벌컥 들이켰다 %SPLIT_G(@"without a word of thanks:while paying you no mind:and forgets that you're there:without looking at you:right away:so fast that she burns her tongue:too fast, spilling some in the process:without any manners")%.
		CASE 3
			PRINTFORML 「나의 개인 \@ IS_MALE(MASTER) ? 집사 # 하녀 \@, %SPLIT_G(@"어떻게 멋져:감사합니다uu:정말 감사합니다:무슨 서비스야:헤헤")%～」
			PRINTFORMDL 테위는 숙녀를 흉내 내며 차를 마셨다.
		CASE 4
			PRINTFORML 「%SPLIT_G(@"차를 가져다준 이여, 내 감사를 받아주십시오!: 다시 한번, 우리는 이 풍성한 차에 대해 감사드립니다...: 차 만드는 분, 당신의 노고에 깊이 감사드립니다.: 차-차... 정말 괜찮으신가요? 감사합니다, 이 선물을 소중히 간직하겠습니다...")%」
			PRINTFORMDL 테위는 엄숙하고 극적인 감사의 모습을 보인 후 단숨에 그것을 마신다.
			SIF !RAND:2
				PRINTFORML 「%SPLIT_G(@"아! 뜨거워!:뜨거워!:후우!:윽, 뜨겁다!")%」
		CASE 5
			PRINTFORML 「%SPLIT_G(@"아, 고맙습니다!:오, 차 더 드릴까요?:왜요, 감사합니다!:차 주셔서 감사합니다!:정말 좋네요! 괜찮아요!:아유, 참 다정하시네요!")%」
			IF !RAND:4
				PRINTFORMDL 그것을 당신에게서 받은 후, 테위가 무언가를 안에 떨어뜨린다.
				PRINTFORML 「%SPLIT_G(@"설탕은 모든 것을 더 좋게 만든다!: 걱정 마, 약방에서 찾은 것일 뿐이야.: 뭐라고? 말 안 해~...음? 아니, 아무것도 넣지 않았어~: 이게 오늘 내 에너지를 유지하는 데 도움이 될 거야!")%」
			ENDIF
			PRINTFORMDL 그녀는 기쁘게 컵에서 한 모금 마셨다.
	ENDSELECT
	SIF TFLAG:193 == 1
		PRINTFORML 「음... %SPLIT_G(@"It's %SPLIT_G(@"really :so ::")%good!:Hey, not bad.:How'd you make this?:Your tea is so good...:How do you make it this good?:Not bad!:Great!:What kind is this? I like it!:I like it!:Nice!")%」
ENDIF
LOCAL = FIND_CHILD("53","Learning manners-Independent",,,"Here")
SIF LOCAL
	PRINTFORMDL %CHILDNAME:53:LOCAL%도 이것을 시도해 본다.
SIF !ARG
	WAIT
RETURN 1
