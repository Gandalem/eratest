@M_KOJO_MESSAGE_COM_K53_350
;Push Down.
CALL SET_KOJO_COLOR(53)
SIF !SHIRAHU(53)
	RETURN 1
SIF K53_CAN_START_MESUGAKI() || K53_CAN_CONTINUE_MESUGAKI()
	TCVAR:抱き寄せ初回 = 8
IF TFLAG:194
	IF K53_CAN_CONTINUE_MESUGAKI()
		PRINTFORML 「말도 안 돼, 변태야!」
		PRINTFORMDW 그녀를 평소처럼 밀어붙이는 건 통하지 않을 것 같다. 대화를 걸고 기회를 찾아봐야 할지도 모른다.
		RETURN 1
	ENDIF
	SELECTCASE TFLAG:194
		;人目がある
		CASE 1
			;野外は嫌
		CASE 2
			PRINTFORML 「사실은 말이야― 장소를 좀 더 신중하게 골라줘.」
			PRINTFORMW 「내가 토끼일지도 모르지만, 그렇다고 대놓고 교미하는 게 괜찮다는 뜻은 아니야.」
			;多人数は嫌
		CASE 3
			;ムードが足りない
		CASE 4
			PRINTFORMW 「잠깐만― 이렇게 된 나를 보는 게 즐겁다는 건 알지만, 더 좋은 시간을 고르는 게 좋을 것 같아.」
	ENDSELECT
ELSEIF GET_TARGETNUM() > 1 && CFLAG:うふふ != 2
	CALL M_KOJO_DIARYSETTING_K53(25)
	RESULT = 0
	CALL K53_3P(TARGET)
	IF !RESULT
		IF K53_TSUN()
			PRINTFORMW 「%SPLIT_G(@"그룹으로 하는 거야... 변태 같아... :그룹으로... 음... 괜찮아...")%」
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「다 같이 하는 건데... 여기서 지면 안 돼!」
				CASE 1
					PRINTFORMW 「좋아! 내가 네 최고의 연인이 되어줄게, %CALLNAME:MASTER%님!%UNICODE(0x2764)%」
				CASE 2
					PRINTFORMW 「나에게 가장 많은 관심을 가져줘야 해, %CALLNAME:MASTER%어!%UNICODE(0x2764)%」
				CASE 3
					PRINTFORMW 「아아, 우리 모두 그렇게 하고 있네, 응? 나한테는 괜찮아%UNICODE(0x2764)%」
				CASE 4
					PRINTFORMW 「내가 제일 좋아하는 사람이지, 그렇죠, %CALLNAME:MASTER%?%UNICODE(0x2764)%」
			ENDSELECT
		ENDIF
	ENDIF
	;抱き寄せ初回or合意持ちで成功
ELSE
	;抱き寄せ初回
	IF TCVAR:抱き寄せ初回
		SELECTCASE TCVAR:抱き寄せ初回
			;普通に合意ゲット
			CASE 1
				CALL M_KOJO_DIARYSETTING_K53(25)
				IF TALENT:ヤリマン
					PRINTFORMW 「에~? 나 같은 어린 애한테 이용하진 않을 거지~?」
					PRINTFORMW 「...음, 네가 그렇다면 허락해 줄게. 하지만 기분 좋게 해줘야 해, 알겠지?」
				ELSEIF TALENT:恋慕 && TALENT:恋人
					PRINTFORMW 「...응, 괜찮아. 괜찮으니까.」
					PRINTFORMW 「나한테 부드럽게 대해줘... 알았지?」
					PRINTFORMDW 무슨 이유에서인지, 테위가 곧 그 온순함을 전부 잃을 것만 같다... 
				ELSE
					PRINTFORMW 「에- 에이? 벌써 하려고 해?」
					PRINTFORMW 「음... 음... 좋아... 욕심 부리지 마, 알겠지?」
				ENDIF
				;キスがまだ
			CASE 2
				CALL M_KOJO_DIARYSETTING_K53(25)
				PRINTFORMW 「이런 걸 하는 거라면, 먼저 해야 할 게 있지 않아?」
				PRINTFORMW 「기분 문제가 아니야... 아아... 이제 신경도 안 쓰여...」
				;媚薬or発情
			CASE 3
				CALL M_KOJO_DIARYSETTING_K53(25)
				PRINTFORMW 「후우―우... 후우―우... 나 좀 놓아줘... 안 돼, 계속해... 아아...」
				;時姦刻印
			CASE 4
				CALL M_KOJO_DIARYSETTING_K53(25)
				PRINTFORMW 「히야! 스-스토... 기다려봐... 기-기다려아... 으응?!」
				PRINTFORMW (이건 뭐지... %HIS_HER(PLAYER,1)%의 향이군. %HIS_HER(PLAYER)%의 몸을 맡으니 내 몸이 그냥... 나... 저항할 수가 없어...)
				;強引に迫られると断れない（臆病持ち
			CASE 5
				;まんざらでもない
			CASE 6
				PRINTFORML 「헤헤~ 미안해, 싫어!」
				PRINTFORMDW 그녀는 거절하지만, 당신의 관심에 매우 기뻐하는 듯하다.
				;駄目
			CASE 7
				PRINTFORMDL 먹잇감처럼 빠른 반사 신경으로 티위는 당신이 손을 들기도 전에 당신의 손이 닿지 않는 곳으로 쏜살같이 빠져나간다.
				PRINTFORMW 「뭐 하려는 거야? 나한테 건방지게 굴지 마, 이 자식아!」
				;論外
			CASE 8
				IF K53_CAN_START_MESUGAKI()
					PRINTFORMDW 그녀는 비누 조각처럼 당신의 손아귀에서 빠져나와 시야에서 사라진다.
					CALL K53_MESUGAKI
				ELSEIF K53_CAN_CONTINUE_MESUGAKI()
					PRINTFORMDL 그녀는 당신의 손길을 놀라운 재빠르게 피하며 내내 웃고 비웃는다.
					IF HAS_PENIS(MASTER)
						PRINTFORMW 「변태 같으니~ 내 보지에 박고 싶니~」
					ELSE
						PRINTFORMW 「변태 같으니~ 내 보지에 끼고 싶다니~」
					ENDIF
				ELSEIF IS_CHILD(MASTER)
					PRINTFORMW 「내 근처에 오지 마, 변태 자식아! 변태라니까!」
				ELSE
					PRINTFORMW 「내 근처에 얼씬도 하지 마, 로리 덕후! 변태 같아!」
				ENDIF
		ENDSELECT
		;合意持ち
	ELSE
		IF TFLAG:102 == 3 || CFLAG:うふふ == 2
			IF K53_TSUN()
				PRINTFORML 「흐, 응? 반칙이잖아...」
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「아하%UNICODE(0x2764)% 판을 뒤집는 건가?」
					CASE 1
						PRINTFORMW 「오, 안 돼%UNICODE(0x2764)%」
					CASE 2
						PRINTFORMW 「뭐, 나한테 뭘 할 거야.%UNICODE(0x2764)%」
				ENDSELECT
			ENDIF
		ELSEIF ((CFLAG:MASTER:初期位置 == 412 && CFLAG:MASTER:現在位置 == 412) || (CFLAG:MASTER:初期位置 == 428 && CFLAG:MASTER:現在位置 == 428) || (CFLAG:MASTER:初期位置 == 442 && CFLAG:MASTER:現在位置 == 442) || (CFLAG:MASTER:初期位置 == 460 && CFLAG:MASTER:現在位置 == 460)) && !RAND:10
			PRINTFORMW 「와!」
			PRINTFORMW 「침대에서 뭘 할 거야?」
		ELSE
			IF K53_TSUN()
				PRINTFORML 「야, 또 ... 하고 싶어...?」
				PRINTFORML 「...아니... 아무것도 아니야... 그냥...」
			ELSE
				SELECTCASE RAND:12
					CASE 0
						PRINTFORMW 「다시 하고 싶어?」
						PRINTFORMW 「아이구, 먼저 경고 좀 해줘 %UNICODE(0x2764)%」
					CASE 1
						PRINTFORMW 「우와, 잠깐만! 그러기 전에 경고해 줘%UNICODE(0x2764)%」
					CASE 2
						IF TALENT:MASTER:体型 == -5
							PRINTFORMDW 네가 그녀에게 손을 대자, 테위는 그 작음에도 불구하고 너의 의도를 즉시 이해하는 듯하다.
						ELSEIF TALENT:MASTER:体型 == -2
							PRINTFORMDW 당신은 테위의 어깨에 손을 올린다. 당신의 눈과 그녀의 눈이 마주치고, 그녀는 당신에게 미소를 짓는다.
						ELSEIF TALENT:MASTER:体型 == 1
							PRINTFORMDW 무릎을 꿇고 당신은 티위의 빨간 눈을 응시했고, 그녀는 수줍게 미소 지었다.
						ELSEIF TALENT:MASTER:体型 == 2
							PRINTFORMDW 당신이 테위의 몸에 손을 대자 기쁨의 전율을 느낀다. 그녀는 당신을 올려다보며 미소 짓는다.
						ELSEIF TALENT:MASTER:体型 == 5
							PRINTFORMDW 거대한 손가락으로 티바트의 작은 몸을 부드럽게 감싸자 그녀는 기쁨에 떨며 보상했다. 그녀는 당신을 올려다보며 미소 지었다.
						ELSE
							PRINTFORMDW 당신은 테위에게 손을 뻗고, 그녀는 장난기 가득한 미소를 짓는다.
							PRINTFORMW 「이리 와%UNICODE(0x2764)%」
						ENDIF
					CASE 3
						PRINTFORMW 「아, 또 들켰네...」
						PRINTFORMW 「나한테 살살해줘%UNICODE(0x2764)%」
					CASE 4
						PRINTFORMW 「오? 뭘 할 계획이야?」
						PRINTFORMDW 테위는 잠시 표정을 굳히더니 이내 입가에 미소를 띠었다.
					CASE 5
						PRINTFORMW 「%SPLIT_G(@"아, 들켰네～:오, 안 돼～:뭐...지금 뭐 하는 거야?～")%」
						PRINTFORMDW 잡힌 토끼 역할을 연기하는 테위는 당신의 손아귀에서 몸을 비튼다. 그녀가 정말로 원한다면 탈출했을 것이다.
						IF TALENT:MASTER:体型 == -5
							PRINTFORMDW 오히려 당신의 체격이라면 그녀가 도망칠 방법이 없었다는 건 말이 안 된다. 이 사실은 두 사람 모두에게 분명하다.
						ELSEIF TALENT:MASTER:体型 == 5
							PRINTFORMDW 그래도 당신의 거대한 손은 그럴듯한 토끼 함을 만든다. 그녀는 거의 자신이 강요당하고 있다고 가장할 수 있다.
						ENDIF
					CASE 6
						PRINTFORMW 「헤헤~」
						PRINTFORMDW 네 의도를 이해한 테위는 몸을 너에게 비볐다...
					CASE 7
						PRINTFORMW 「흥? 내 어린 몸에 욕망을 품지는 않을 거지?」
						IF TALENT:MASTER:体型 == -2
							PRINTFORMDW 그녀가 말하기엔 적절치 않군. 게다가 그녀의 골반은 아이들이 들어갈 만큼 넓어. 네가 손으로 만져보면서 증명해 보렴.
						ELSE
							PRINTFORMDW 테위는 바보 행세를 하지만, 네가 그 작은 아이의 몸을 손으로 휘젓고 다니는 걸 모를 리 없다.
						ENDIF
						PRINTFORMDW 그녀는 작은 한숨을 내쉰다...
					CASE 8
						PRINTFORMDW 말할 필요 없어; 테위가 기분이 좋다는 걸 알리기 위해 필요한 건 그녀의 귀를 조금 쓰다듬어 주는 것뿐이야.
						PRINTFORMW 「음... 음흠흠～」
					CASE 9
						PRINTFORMW 「무슨 일이야?」
						PRINTFORMW 「아, 알겠어~」
						PRINTFORMDW 테위는 당신의 의도를 이해하고 부드럽게 웃었다.
					CASE 10
						PRINTFORMW 「또 내 매력에 빠졌나?～」
						PRINTFORMDW 확실히 빠졌지. 너는 손을 그녀의 몸 위아래로 움직이며 테위에게 알렸다.
						PRINTFORMDW 그녀는 작고 즐거운 전율을 느꼈다...
						PRINTFORMW 「음～」
					CASE 11
						IF TALENT:恋人 && TALENT:恋慕
							PRINTFORMW 「당신이 기분이 좋아지는 방식이 좋아~」
							PRINTFORMDW 테위는 당신의 품에서 부드럽게 속삭이며 온전히 자신을 당신에게 맡긴다.
						ELSEIF TALENT:愛欲
							PRINTFORMW 「드디어 왔네~ 나 이거 정말 필요해~」
							PRINTFORMDW 티위가 당신에게 몸을 던진다...
						ELSEIF TALENT:セフレ || TALENT:ヤリマン
							PRINTFORMW 「이리 와봐, 섹시한 %PRINT_MALE("boy", MASTER)%～」
							PRINTFORMDW 테위는 네가 움직이는 순간 무엇을 원하는지 알고 있다.
						ELSE
							PRINTFORMW 「에헤헤, 무슨 표정이야~」
						ENDIF
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
