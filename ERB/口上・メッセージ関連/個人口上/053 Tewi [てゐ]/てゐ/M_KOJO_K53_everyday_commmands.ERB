	IF TFLAG:194 == 56
		;Sweet Sake.
		PRINTFORML 「%SPLIT_G("「이건 마시기 쉬운 종류지, 그렇지?」\n「마실게. 하지만 나도 맥주 잘 마시는 여자니까.:오, 정말 좋은 향이 난다.:나는 이런 게 좋아, 향이 좋네.")%」
	ELSEIF TFLAG:194 == 55
		;Sacred Sake.
		PRINTFORML 「%SPLIT_G("신들을 위한 것이라지만, 이 종류는 보통 그렇게 좋지 않아.:누가 여기에 침이라 흘린 거 아냐?:아니, 이건 특별한 종류야.")%」
	ELSE
