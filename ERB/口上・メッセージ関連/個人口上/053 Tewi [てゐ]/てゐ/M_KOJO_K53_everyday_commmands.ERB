;Forage.
IF !SHIRAHU(53) || MARK:53:反発刻印 || CFLAG:53:ブチギレ
	CALL TRAIN_MESSAGE
	RETURN 1
ENDIF
PRINTFORML
SELECTCASE RAND:4
	CASE 0
		PRINTFORML 「토끼 팀, %SPLIT_G(@"지역을 쓸어라:분할 정복:못 박히지 않은 모든 것을 가져가라:수색 및 회수:수색:유용한 모든 것을 가져가라:이동해라:가라:모아라:지역을 약탈하라:찾을 수 있는 무엇이든 찾아라:가자, 가자, 가자:좋은 물건을 찾아라")%!」
		PRINTFORMDL 테위가 뒤에서 지켜보는 동안, 한 무리의 토끼들이 당신을 도와 지역 전체를 수색하기 위해 흩어진다!
		PRINTFORMDL 그들은 %SPLIT_G(@"대부분의 시간을 어울리며 보낸다:무엇을 찾고 있는지 모르는 것 같다:요괴가 지나갈 때 모두 도망치거나 숨는다:도중에 무엇을 하고 있었는지 잊어버린다:자신의 발을 잘 찾아내는 듯하지 않다:너무 멀리 퍼져 길을 잃는다:야생 동물에게 구조가 필요해진다:찾은 것의 절반을 실수로 망친다")%, 하지만...
	CASE 1
		PRINTFORML 「이것으로 점을 치거나 생각과 기도로 혹은 확률적 예측으로 %SPLIT_G(@"얻어내기")%! 당신을 도와 찾겠어요」
		PRINTFORMDL 테위의 방법은 의심스럽지만, 그녀의 열정이 지루해지는 것을 막아준다.
	CASE 2
		PRINTFORML 「... %SPLIT_G(@"over there:that direction:that way:there")%!에 대해 기분이 좋다」
		PRINTFORMDL 도와주기는커녕, 테위는 그저 무작위로 방향만 가리킨다. 운이 따를지도 모르지?
	CASE 3
		PRINTFORML 「%SPLIT_G(@"어디를 봐야 할까?:네가 보는 곳을 다시 확인할게.:나는 주변을 계속 살피고 있어!:찾는 동안 게임이나 하자.")%!」
		PRINTFORMDL 테위는 별로 도움도 안 되면서 주변을 맴돈다.
ENDSELECT
LOCAL = FIND_CHILD("53","Learning manners-Independent","Camping",,"Here")
IF LOCAL
	PRINTFORMDL %CHILDNAME:53:LOCAL%이(가) 열정적으로 수색에 합류한다.
ELSE
	LOCAL = FIND_CHILD("53","Learning manners-Independent",,,"Here")
	SIF LOCAL
		PRINTFORMDL %CHILDNAME:53:LOCAL%이(가) 수색에 합류한다.
ENDIF
WAIT
CALL TRAIN_MESSAGE
IF TFLAG:193 > 0
	PRINTFORML 「%SPLIT_G(@"에헤헤~ 봐, 효과가 있을 거라고 말했잖아! 호잇! 돈이 될 만한 거? 천만에~")%」
	LOCALS '= "딱 그게 전부라고 생각하기 시작할 때"
ELSE
	PRINTFORML 「%SPLIT_G(@"어라? 그게 될 줄 알았는데... : 뭐, 항상 운이 좋은 건 아니잖아. 그러니까, 너도 안 되지. : 시간 낭비군―! : 이거 지루해지기 시작했어...")%」
	LOCALS '= "막 그만두려던 참에"
ENDIF
IF !RAND:20
	IF (CFLAG:MASTER:現在位置 / 100) == 4
		PRINTFORMDL %LOCALS%, 테위가 진사석 바위에 걸려 넘어졌다! 정말 운 좋다!
		PRINTL
		CALL GET_ITEM("辰砂",RAND(2,6),2)
	ELSE
		PRINTFORMDL %LOCALS%가 귀한 쓴 뿌리 다리에 걸려 넘어졌다! 정말 운이 좋군!
		PRINTL
		CALL GET_ITEM("苦い根っこ",RAND(2,6),2)
	ENDIF
	PRINTL
ENDIF
WAIT
RETURN 1
