	LOCAL = FIND_CHILD("53","Learning manners-Independent",,,"Here")
	SIF LOCAL
		PRINTFORMDL %CHILDNAME:53:LOCAL% joins the search.
ENDIF
WAIT
CALL TRAIN_MESSAGE
IF TFLAG:193 > 0
	PRINTFORML 「%SPLIT_G(@"Ehehe～:See, I told you it'd work!:Hooray for you!:Anything worth money?:You're welcome～")%」
	LOCALS '= "Just as you start thinking that's all there is"
ELSE
	PRINTFORML 「%SPLIT_G(@"Huh? I thought that'd work...:Well, we can't always be lucky. I mean, you can't.:What a waste of time―!:This is getting boring...")%」
	LOCALS '= "As you're about to call it quits"
ENDIF
IF !RAND:20
	IF (CFLAG:MASTER:現在位置 / 100) == 4
		PRINTFORMDL %LOCALS%, Tewi trips over an outcrop of cinnabar! Talk about lucky!
		PRINTL
		CALL GET_ITEM("辰砂",RAND(2,6),2)
	ELSE
		PRINTFORMDL %LOCALS%, Tewi trips over a tangle of valuable bitter roots! Talk about lucky!
		PRINTL
		CALL GET_ITEM("苦い根っこ",RAND(2,6),2)
	ENDIF
	PRINTL
ENDIF
WAIT
RETURN 1

