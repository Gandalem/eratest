				ENDIF
		ENDSELECT
	ENDIF
ELSE
		;Go Out.
	SELECTCASE IFRAND("0",CFLAG:53:K53C_WINGMAN && ((TALENT:53:恋人 && CFLAG:53:K53C_WINGMAN == 2) || !TALENT:53:恋人),"1",1,"2",1,"3",1,"4",1)
		CASE 0
			PRINTFORML 「You're going out? Without Reisen?!」
			PRINTFORML 「Her poor feelings...」
		CASE 1
			PRINTFORML 「Bring me back a present～」
			PRINTFORMDL Tewi cheerfully waves goodbye as you head out.
		CASE 2
