	CALL TRAIN_MESSAGE
	RETURN 1
ENDIF
PRINTFORML
SELECTCASE RAND:4
	CASE 0
		PRINTFORML 「Rabbit team, %SPLIT_G(@"sweep the area:divide and conquer:take everything not nailed down:search and retrieve:search:take anything that looks useful:move out:go:assemble:pillage the area:find whatever you can:go, go, go:find some good stuff")%!」
		PRINTFORMDL While Tewi sits back and watches, a swarm of rabbits fans out over the area to help you search!
		PRINTFORMDL They %SPLIT_G(@"spend most of the time playing around:don't seem to know what they're looking for:all run and hide when a youkai passes by:forget what they're doing halfway through:hardly seem able to find their own feet:spread out way too far and get lost:end up needing to be rescued from wildlife:accidentally ruin half of what they find")%, though...
	CASE 1
		PRINTFORML 「I'll help you search %SPLIT_G(@"by using geta divination:with this dowsing rod:with thoughts and prayers:with probabilistic prediction:by letting this stick fall")%!」
		PRINTFORMDL Tewi's methods are dubious, but her enthusiasm keeps it from getting boring.
	CASE 2
		PRINTFORML 「I feel good about... %SPLIT_G(@"over there:that direction:that way:there")%!」
		PRINTFORMDL Instead of helping, Tewi just points you in random directions. Maybe you'll get lucky?
	CASE 3
		PRINTFORML 「%SPLIT_G(@"Where are we going to look?:I'll double-check where you look.:I've got my head on a swivel!:Let's play a game while we search.")%!」
		PRINTFORMDL Tewi follows you around without really helping.
ENDSELECT
LOCAL = FIND_CHILD("53","Learning manners-Independent","Camping",,"Here")
