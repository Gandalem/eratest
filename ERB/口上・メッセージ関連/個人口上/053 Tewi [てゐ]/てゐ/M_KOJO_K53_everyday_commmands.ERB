@M_KOJO_MESSAGE_COM_K53_626
	;Souvenir Shop.
SELECTCASE TFLAG:194
	CASE -2 ;Spent too much time and got kicked out.
		IF (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ;Kourindou.
			PRINTFORML 「He's getting cranky again! Let's get out of here!」
		ELSE
			PRINTFORML 「Run! She's gonna catch us!」
		ENDIF
	CASE -1 ;Left without buying anything.
		PRINTFORML 「Huh, leaving already?」
		PRINTFORMDL Tewi walks behind you. She doesn't say anything, but you feel her eyes on your back.
	CASE 1 ;Less than 400 points, bad.
		PRINTFORML 「Huh, what's this?」
		IF TALENT:53:恋人
			PRINTFORML 「...That's not a nice prank for your lover, you know.」
		ELSE
			PRINTFORML 「Haha, wow, this sucks. You really bought this?」
			PRINTFORML 「It's fine, it's fine, I'll throw it out later～」
		ENDIF
	CASE 2 ;Less than 700 points, okay.
		PRINTFORML 「For me? Thaaank youuuu～」
		PRINTFORML 「At least you know how to be polite to a girl!」
	CASE 3 ;700 or more points, good.
		IF TALENT:53:恋人
			PRINTFORML 「Thanks, I love it so much!」
			PRINTFORMDL Tewi kisses you on the cheek as she receives your gift, then holds your hand as you leave the store.
			PRINTFORML 「I have the very best～ lover in the world～♪」
		ELSE
			PRINTFORML 「Oh wow, this is great! Thanks so much!」
			PRINTFORMDL Tewi holds your gift with an expression of honest joy.
			PRINTFORMDL She skips and trots beside you as you leave the store, clinging to your side.
		ENDIF
ENDSELECT
WAIT
RETURN 1
