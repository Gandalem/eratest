@M_KOJO_MESSAGE_COM_K53_368_1
;Join Activity.
#DIM DYNAMIC ActivityPartner,2
#DIM DYNAMIC ChildIndex
IF Activity_Type:53 == 12
	CALL M_KOJO_MESSAGE_COM_K53_403
	RETURN 1
ENDIF
CALL D_LINE
IF GET_TARGETNUM() > 1
	FOR LOCAL,0,20 ;Get someone doing the same activity in the area.
	ActivityPartner:0 = TARGET:RAND(1,GET_TARGETNUM()+1)
	SIF ActivityPartner:0 != 53 && !IS_MALE(ActivityPartner:0) && (Activity_Type:53 != 1 || !GROUPMATCH(ActivityPartner:0,52,62,72)) && Activity_Type:(ActivityPartner:0) == Activity_Type:53
		BREAK
	ActivityPartner:0 = 0
	NEXT
	FOR LOCAL,0,20 ;Get someone in the area who isn't doing the same activity.
	ActivityPartner:1 = TARGET:RAND(1,GET_TARGETNUM()+1)
	SIF ActivityPartner:1 != 53 && !IS_MALE(ActivityPartner:0) && (Activity_Type:53 != 1 || !GROUPMATCH(ActivityPartner:1,52,62,72)) && Activity_Type:(ActivityPartner:1) != Activity_Type:53
		BREAK
	ActivityPartner:1 = 0
	NEXT
ENDIF
ChildIndex = FIND_CHILD("53","Learning manners-Independent",,,"Here")
SELECTCASE Activity_Type:53
	CASE 0
		;Join Navelgazing.
		;TFLAG:193, -1 = Brushed off.
		PRINTFORMDL 당신은 테위에게 무슨 생각을 하고 있는지 묻는다...
		PRINTFORMDW
		IF TFLAG:193 > -1
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「응? ...알 필요 없는 거잖아~」
					PRINTFORMDL 테위는 자신의 계획을 숨긴 채 당신을 무시한다.
				CASE 1
					PRINTFORML 「방해하지 마! 이건 천재적인 작품이 될 거야!」
					PRINTFORMDL 그녀는 장난을 치고 있는 걸 생각하고 있을지도 모른다...
				CASE 2
					PRINTFORML 「맞히면 상품을 주지.」
					PRINTFORMDL 그거 어려 보이는데, 그래도 한번 시도해 봐.
					PRINTFORML 「이겨서 말해줄지 말지 결정하려면 먼저 내기에 돈을 걸어야 해.」
					PRINTFORMDL 됐어.
				CASE 3
					PRINTFORML 「아무것도...」
					PRINTFORMDL 그녀는 공허한 눈으로 허공을 계속 응시했다.
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					IF IS_MASTER(52)
						PRINTFORML 「내가 너에게 다음에 하고 싶은 것.」
					ELSE
						PRINTFORML 「내가 라이젠에게 하고 싶은 게 바로 그거지.」
					ENDIF
					PRINTFORML 「아이디어는 정말 많은데, 타이밍이 안 맞으면 다 헛수고가 되겠지...」
					SIF !IS_MASTER(52)
						PRINTFORMDL 당신은 테위와 함께 몇 가지 계획을 세운다.
				CASE 1
