;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================
@M_KOJO_SUCCESS_COM_K53_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 = 0

;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_MESSAGECHECK_COM_K53_300
RETURN 1

@M_KOJO_MESSAGE_COM_K53_300(Counter)
#DIM DYNAMIC Counter
#DIM DYNAMIC Topic
RESULT = 0
SIF !Counter
	CALL D_LINE
IF MARK:53:反発刻印 > 1
		;Hate mark dialogue.
	CALL K53_CONVERSATION_HATE(Counter)
	RETURN 0
ENDIF
IF TALENT:53:機嫌 == -1
		;Sullen dialogue.
	CALL K53_CONVERSATION_SULLEN(Counter)
	RETURN 0
ENDIF
IF TFLAG:193 < 0
		;Failure dialogue.
	CALL K53_CONVERSATION_AWKWARD(Counter)
	RETURN 0
ENDIF
CALL K53_SPECIAL_EVENTS(Counter)
	;Check if any special events will trigger.
SIF RESULT
	RETURN 1
$CONVERSATION
Topic = RAND:8
SIF !RAND:6
		;Slightly higher chance to pick the general topic, since it's the largest.
	Topic = 5
SIF IS_HERE(52) && !RAND:4
		;Higher chance to pick the interaction topic if Reisen is around.
	Topic = 7
SELECTCASE Topic
	CASE 0
			;Residents of Eientei.
		CALL K53_CONVERSATION_PEOPLE(RAND:4,Counter)
	CASE 1
			;Tall tales.
		SIF TALENT:53:恋人 && !RAND:2
				;Lower chance after Lovers.
			GOTO CONVERSATION
		CALL K53_CONVERSATION_TALL_TALES(Counter)
	CASE 2
			;Business. Locks after Lovers.
		SIF TALENT:53:恋人
			GOTO CONVERSATION
		CALL K53_CONVERSATION_BUSINESS(Counter)
	CASE 3
			;Listening to you talk. Lower chance.
		SIF !RAND:2
			GOTO CONVERSATION
		CALL K53_CONVERSATION_LISTENING(Counter)
	CASE 4
			;The player character.
		CALL K53_CONVERSATION_MASTER(Counter)
	CASE 5
			;General topics.
		CALL K53_CONVERSATION_GENERAL(Counter)
	CASE 6
			;Children. Locked if she has none.
		SIF CFLAG:53:子供人数 < 1
			GOTO CONVERSATION
		IF !RAND:2
				;Set the conversation to be about a random child of yours and Tewi's.
			LOCAL = FIND_CHILD("53")
			LOCALS '= CHILDNAME:53:LOCAL
		ELSE
				;Set the conversation to be about parenthood in general.
			LOCAL = -1
		ENDIF
		CALL K53_CONVERSATION_CHILDREN(LOCAL,LOCALS,Counter)
	CASE 7
			;Interactions. Only possible while other characters are present.
		SIF GET_TARGETNUM() < 2
			GOTO CONVERSATION
		CALL K53_CONVERSATION_INTERACTION(Counter)
		SIF !RESULT
			GOTO CONVERSATION
ENDSELECT
WAIT
RETURN 1

