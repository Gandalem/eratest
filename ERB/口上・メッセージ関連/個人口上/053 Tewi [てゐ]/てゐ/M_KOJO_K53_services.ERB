@K53_RWS_EVENT
#DIM DYNAMIC TOTAL_PLOTS
#DIM DYNAMIC CROPS_STOLEN
#DIM DYNAMIC CARROTS_PLANTED
#DIM DYNAMIC THEFT_COUNTER
#DIM DYNAMIC CARROT_COUNTER
#DIM DYNAMIC THEFT_CHANCE = 30
#DIM DYNAMIC CARROT_CHANCE = 30
#DIM DYNAMIC EMPTY_FIELDS
SELECTCASE TFLAG:幸運補正
	CASE IS > 4
		THEFT_CHANCE = 100
		CARROT_CHANCE = 6
	CASE IS >= 0
		THEFT_CHANCE = 60
		CARROT_CHANCE = 20
	CASE IS >= -4
		THEFT_CHANCE = 20
		CARROT_CHANCE = 40
	CASEELSE
		THEFT_CHANCE = 10
		CARROT_CHANCE = 100
ENDSELECT
IF IS_FALLEN(53)
	THEFT_CHANCE += 10
	CARROT_CHANCE -= 5
ENDIF
IF TALENT:53:恋慕 || TALENT:53:愛欲
	THEFT_CHANCE = MAX(THEFT_CHANCE,60)
	CARROT_CHANCE = MIN(CARROT_CHANCE,20)
ENDIF
SIF !RAND:THEFT_CHANCE
	THEFT_COUNTER = RAND:3+1
SIF !RAND:CARROT_CHANCE
	CARROT_COUNTER = RAND:3+1
TOTAL_PLOTS = GETUNELENGTH418()
FOR LOCAL,0,TOTAL_PLOTS
IF PLANT_TYPE:LOCAL && THEFT_COUNTER
	PLANT_TYPE:LOCAL = 0
	PLANT_DAYS:LOCAL = 0
	PLANT_DRY:LOCAL = 1
	PLANT_GROW:LOCAL = 0
	THEFT_COUNTER--
	CROPS_STOLEN++
ELSEIF !PLANT_TYPE:LOCAL && CARROT_COUNTER
	PLANT_TYPE:LOCAL = 182
	HATAKE_NAME:LOCAL = carrot
	PLANT_DRY:LOCAL = 0
	CARROT_COUNTER--
	CARROTS_PLANTED++
ENDIF
SIF !PLANT_TYPE:LOCAL
	EMPTY_FIELDS++
NEXT
IF EMPTY_FIELDS == TOTAL_PLOTS && TFLAG:幸運補正 == 5 && IS_FALLEN(53)
	FOR LOCAL,0,TOTAL_PLOTS
	PLANT_TYPE:LOCAL = 182
	HATAKE_NAME:LOCAL = carrot
	PLANT_DRY:LOCAL = 0
	CARROTS_PLANTED++
	NEXT
ENDIF
IF CROPS_STOLEN
	PRINTFORMDL 「\@ CROPS_STOLEN > 1 ? 일부 # 하나 \@ of your crops \@ CROPS_STOLEN > 1 ? 이다 # 이다 \@ 사라졌다.」
	PRINTFORMDL %SPLIT_G(@"씹힌 잔해가 정원에 흩어져 있다:정원에 토끼 발자국이 있다:당신은 정원에서 토끼를 발견한다. 다가가자, 그녀는 도망친다:정원 전체에 구멍이 파져 있다:당신의 정원에 함정이 파여 있다. 그것을 없애기 위해 시간이 좀 걸린다:누군가 정원을 엉망으로 만들었다. 당신은 그것을 청소하는 데 시간이 좀 걸린다")%...
ENDIF
IF CARROTS_PLANTED
	IF CARROTS_PLANTED == TOTAL_PLOTS
		PRINTFORMDL 무슨 이유에서인지 빈 주방 정원이 당근으로 가득 차 있었다.
	ELSE
		PRINTFORMDL 너는 발견한다 \@ CARROTS_PLANTED > 1 ? 새로운 당근들이 있다. # 새로운 당근 하나가 \@ growing in your garden \@ CARROTS_PLANTED > 1 ? 그건 아니었다 # 그건 없었는데 \@ 전에 거기에 있었는데...
	ENDIF
ENDIF
SIF CROPS_STOLEN || CARROTS_PLANTED
	WAIT

