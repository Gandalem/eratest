@K53_RWS_EVENT
#DIM DYNAMIC TOTAL_PLOTS
#DIM DYNAMIC CROPS_STOLEN
#DIM DYNAMIC CARROTS_PLANTED
#DIM DYNAMIC THEFT_COUNTER
#DIM DYNAMIC CARROT_COUNTER
#DIM DYNAMIC THEFT_CHANCE = 30
#DIM DYNAMIC CARROT_CHANCE = 30
#DIM DYNAMIC EMPTY_FIELDS

SELECTCASE TFLAG:幸運補正
	CASE IS > 4
		THEFT_CHANCE = 100
		CARROT_CHANCE = 6
	CASE IS >= 0
		THEFT_CHANCE = 60
		CARROT_CHANCE = 20
	CASE IS >= -4
		THEFT_CHANCE = 20
		CARROT_CHANCE = 40
	CASEELSE
		THEFT_CHANCE = 10
		CARROT_CHANCE = 100
ENDSELECT
IF IS_FALLEN(53)
	THEFT_CHANCE += 10
	CARROT_CHANCE -= 5
ENDIF
IF TALENT:53:恋慕 || TALENT:53:愛欲
	THEFT_CHANCE = MAX(THEFT_CHANCE,60)
	CARROT_CHANCE = MIN(CARROT_CHANCE,20)
ENDIF
SIF !RAND:THEFT_CHANCE
	THEFT_COUNTER = RAND:3+1
SIF !RAND:CARROT_CHANCE
	CARROT_COUNTER = RAND:3+1

TOTAL_PLOTS = GETUNELENGTH418()
FOR LOCAL,0,TOTAL_PLOTS
	IF PLANT_TYPE:LOCAL && THEFT_COUNTER
		PLANT_TYPE:LOCAL = 0
		PLANT_DAYS:LOCAL = 0
		PLANT_DRY:LOCAL = 1
		PLANT_GROW:LOCAL = 0
		THEFT_COUNTER--
		CROPS_STOLEN++
	ELSEIF !PLANT_TYPE:LOCAL && CARROT_COUNTER
		PLANT_TYPE:LOCAL = 182
		HATAKE_NAME:LOCAL = carrot
		PLANT_DRY:LOCAL = 0
		CARROT_COUNTER--
		CARROTS_PLANTED++
	ENDIF
	SIF !PLANT_TYPE:LOCAL
		EMPTY_FIELDS++
NEXT
IF EMPTY_FIELDS == TOTAL_PLOTS && TFLAG:幸運補正 == 5 && IS_FALLEN(53)
	FOR LOCAL,0,TOTAL_PLOTS
		PLANT_TYPE:LOCAL = 182
		HATAKE_NAME:LOCAL = carrot
		PLANT_DRY:LOCAL = 0
		CARROTS_PLANTED++
	NEXT
ENDIF
IF CROPS_STOLEN
	PRINTFORMDL \@ CROPS_STOLEN > 1 ? Some # One \@ of your crops \@ CROPS_STOLEN > 1 ? are # is \@ missing.
	PRINTFORMDL %SPLIT_G(@"Chewed up remains litter the garden:There are rabbit tracks in the garden:You find a rabbit in the garden. When you approach, she runs away:Holes have been dug all over the garden:There's a pitfall trap dug in your garden. You take some time to get rid of it:Someone's made a mess of the garden. You take some time to clean it up")%...
ENDIF
IF CARROTS_PLANTED
	IF CARROTS_PLANTED == TOTAL_PLOTS
		PRINTFORMDL For some reason, the empty kitchen garden has been filled with carrots.
	ELSE
		PRINTFORMDL You find \@ CARROTS_PLANTED > 1 ? some new carrots #a new carrot \@ growing in your garden. \@ CARROTS_PLANTED > 1 ? Those weren't # That wasn't \@ there before...
	ENDIF
ENDIF
SIF CROPS_STOLEN || CARROTS_PLANTED
	WAIT

