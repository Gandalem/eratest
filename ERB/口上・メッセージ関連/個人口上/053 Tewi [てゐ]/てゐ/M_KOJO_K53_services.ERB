			PRINTFORMDW 테위의 비명에 깜짝 놀라 %PrankTargetName%은/는 당신이 그녀의 %SHOW_BOTTOM(PrankTarget,1)%을 들어 올리자 반응하지 못한다!
		ELSE
			PRINTFORMDW 테위의 비명에 깜짝 놀라, 당신이 그녀의 %SHOW_BOTTOM(PrankTarget,4)%를 잡아당기자 %PrankTargetName%은(는) 반응하지 못한다!
		ENDIF
		PRINTFORMDW 같은 순간에 테위는 벌떡 일어나 %PANTSNAME(EQUIP:PrankTarget:下半身下着２,PrankTarget)%를 잡아 내리고 %IT_THEM_PANTIES(PANTSNAME(EQUIP:PrankTarget:下半身下着２,PrankTarget))%!을 들고 도망친다!
		SELECTCASE PrankTarget
			CASE 51
				CALL CHARA_TEXT(51,@"「뭐, 뭐야아아악?!」","w")
			CASE 52
				CALL CHARA_TEXT(PrankTarget,@"「꺅―! 테위?!」","w")
			CASEELSE
				CALL CHARA_TEXT(PrankTarget,@"「뭐야--?!」","w")
		ENDSELECT
		PRINTL
		PRINTFORMDW 잠시 동안 그녀의 보지가 당신에게 노출된다. 당신은 그녀의 충격받은 얼굴과 함께 그것을 마음에 새긴다.
		PRINTFORMDW 그러고 나서, 그녀가 반격하기도 전에 두 사람은 그 전리품을 가지고 탈출한다...
		CFLAG:PrankTarget:同行 = 0
		CALL GETOUT(MASTER)
		CFLAG:53:現在位置 = CFLAG:MASTER:現在位置
		TALENT:53:機嫌 = 1
		TALENT:PrankTarget:機嫌 = -1
		CFLAG:PrankTarget:ブチギレ = 1
		PRINTL
		CALL CHANGE_CFLAG(2, 53, 60)
		IF !(TALENT:PrankTarget:愛欲 && ABL:PrankTarget:露出癖 > 2) && !(ABL:PrankTarget:露出癖 > 4)
			PRINTL
			CALL CHANGE_CFLAG(2, PrankTarget, -100)
			CALL CHANGE_CFLAG(4, PrankTarget, -50)
		ENDIF
		PRINTL
		CALL PANTS_GET(PrankTarget,"もらう")
		CFLAG:53:K53C_RAPE_ASSISTANT ++
	CASE 8
		SIF CFLAG:53:K53C_RAPE_ASSISTANT < 1
			GOTO LOOP8
		PRINTFORMDW 테위가 그녀 뒤로 살금살금 다가올 때 당신은 %PrankTargetName%와 대화를 시작한다...
		PRINTFORMW 「지금이야!」
		PRINTFORMDW 테위의 외침에 놀란 %PrankTargetName%는 두 사람이 체계적으로 그녀의 옷을 벗기는 것에 반응하지 못한다!
		IF GET_TARGETNUM() > 2 || WITH_MOB() || DATE_HITOGOMI(CFLAG:MASTER:現在位置)
			PRINTFORMDW 그녀의 나체는 모든 이들에게 노출되어 있었다. 모든 시선이 즉시 그녀에게 향했다...
		ELSE
			PRINTFORMDW 그녀의 벌거벗은 몸이 노출되어 있고, 당신은 그녀가 넋을 잃은 사이에 잠시 광경을 감상한다.
		ENDIF
		IF TALENT:PrankTarget:愛欲 && ABL:PrankTarget:露出癖 > 2 || ABL:PrankTarget:露出癖 > 5
			PRINTL
			CALL PRINT_FACE(PrankTarget,"通常","裸",,"照れ")
			PRINTFORMDW 하지만 그녀가 정신을 차리더라도 저항하지 않는다. 그녀는 그저 갑작스러운 노출에 흥분하며 홍당무처럼 빨개질 뿐이다...
		ELSE
			PRINTL
			CALL PRINT_FACE(PrankTarget,"怒り","裸",,"照れ")
			SELECTCASE PrankTarget
				CASE 51
					CALL CHARA_TEXT(PrankTarget,@"「끄아아악―!」","w")
				CASE 52
					CALL CHARA_TEXT(PrankTarget,@"「꺅―! 테위?!」","w")
				CASEELSE
					CALL CHARA_TEXT(PrankTarget,@"「뭐야--?!」","w")
			ENDSELECT
			IF ABL:PrankTarget:露出癖 > 3
				PRINTFORMDW 그녀는 자신의 사적인 부분을 가리지만... 그 이상은 별로 하지 않는다. 그녀가 그것을 그렇게까지 싫어하지 않을지도 모른다...
				MARK:PrankTarget:反発刻印 = 1
				CFLAG:PrankTarget:ブチギレ = 1
			ELSE
				PRINTFORMDW 잠시 후, 그녀는 자신의 은밀한 곳을 가리고 동시에 단마쿠를 발사하며 비명을 질렀다.
				MARK:PrankTarget:反発刻印 = 3
				TALENT:PrankTarget:機嫌 = -1
				CFLAG:PrankTarget:ブチギレ = 1
			ENDIF
		ENDIF
		PRINTFORMDW 그녀의 옷을 옆으로 던지며 당신과 테위는 도망치고, 그녀가 따라오지 않고 스스로 다시 옷을 입도록 내버려 둔다.
		CFLAG:PrankTarget:同行 = 0
		CALL GETOUT(MASTER)
		CFLAG:53:現在位置 = CFLAG:MASTER:現在位置
		TALENT:53:機嫌 = 1
		PRINTL
		CALL CHANGE_CFLAG(2, 53, 60)
		IF !(TALENT:PrankTarget:愛欲 && ABL:PrankTarget:露出癖 > 2) && !(!TALENT:PrankTarget:愛欲 && ABL:PrankTarget:露出癖 > 5)
			PRINTL
			CALL CHANGE_CFLAG(2, PrankTarget, -200)
			CALL CHANGE_CFLAG(4, PrankTarget, -200)
		ENDIF
		CFLAG:53:K53C_RAPE_ASSISTANT ++
	CASE 9,10
		LOCAL = 0
		SIF RESULT == 9
			LOCAL = 1
		IF CFLAG:53:K53C_RAPE_ASSISTANT < 1 || !ITEM:縄 || !ITEM:【捕縛技能】 || (LOCAL == 1 && (GET_TARGETNUM() != 2 || WITH_MOB() || DATE_HITOGOMI(CFLAG:MASTER:現在位置))) || (LOCAL == 0 && (CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置))
			LOCAL = 0
			GOTO LOOP8
		ENDIF
		PRINTFORMW 「헤헤헤...」
		PRINTFORMDW 티위는 에이린의 초강력 최음제를 또 준비해 두었다. 그녀가 등을 돌리고 있는 동안, 너는 %PrankTargetName% 뒤로 몰래 다가간다...
		PRINTFORMW 「자!」
		PRINTFORMDW 너는 줄을 이용해 %PrankTargetName%를 묶으려고 달려든다!
		SELECTCASE PrankTarget
			CASE 51
				CALL CHARA_TEXT(PrankTarget,@"「꺅! 기습이라고?」","w")
			CASE 52
				CALL CHARA_TEXT(PrankTarget,@"「뭐야, 퇴이--?!」","w")
			CASEELSE
				CALL CHARA_TEXT(PrankTarget,@"「뭐야--?!」","w")
		ENDSELECT
		IF TALENT:PrankTarget:愛欲 && ABL:PrankTarget:露出癖 > 2
			SELECTCASE PrankTarget
				CASE 51
					CALL CHARA_TEXT(PrankTarget,@"「하아, 여러분...! 이건 너무 심해...!」","w")
				CASE 52
					CALL CHARA_TEXT(PrankTarget,@"「야-너희 둘 다 정말 최악이야...!」","w")
				CASEELSE
					CALL CHARA_TEXT(PrankTarget,@"「N-No...」","w")
			ENDSELECT
			PRINTFORMDW 그녀가 항의했음에도 불구하고 저항하지 않자 당신은 손쉽게 그녀를 묶었다.
		ELSE
			PRINTFORMDW 그녀는 당신이 그녀의 시신을 노리고 있음을 깨닫고 온 힘을 다해 맞선다...
			SELECTCASE PrankTarget
				CASE 51
					CALL CHARA_TEXT(PrankTarget,@"「안 돼! 안 돼애! 뭐 하는 거야?! 아아악!」","w")
				CASE 52
					CALL CHARA_TEXT(PrankTarget,@"「뭐야 너!! 떨어져! 안 돼애애!」","w")
				CASEELSE
					CALL CHARA_TEXT(PrankTarget,@"「No!」","w")
			ENDSELECT
			IF ((ABL:MASTER:戦闘能力-2)+(ABL:53:戦闘能力-2)) > ABL:PrankTarget:戦闘能力
				PRINTFORMDW 하지만 당신의 힘과 테위의 힘이 합쳐져 그녀를 쓰러뜨린다. 그녀는 완전히 무방비 상태이며, 당신은 재빨리 밧줄을 사용하여 그녀의 저항 능력을 제거한다.
				SELECTCASE PrankTarget
					CASE 51
						SIF HAS_PENIS(MASTER)
							PRINTFORMW 「%CALLNAME:MASTER%」의 특별한 오이(cucumber)가 갖고 싶지 않으신가요? 모든 카파들을 미치게 만들 거예요~
						CALL CHARA_TEXT(PrankTarget,@"「유우, 나한테 이럴 수 없어...!」","w")
						PRINTFORMW 「특별한 사탕이야! 크게 벌려봐~」
					CASE 52
						CALL CHARA_TEXT(PrankTarget,@"「안 돼... 또...!」","w")
						PRINTFORMW 「봐, 라이젠! 네가 제일 좋아하는 사탕이야! 입 크게 벌려~」
					CASEELSE
						CALL CHARA_TEXT(PrankTarget,@"「크윽...!」","w")
						PRINTFORMW 「너에게 예쁜 사탕이 있어! 크게 벌려봐~」
				ENDSELECT
				PRINTFORMDW 테위는 %PrankTargetName%의 입에 최음제를 밀어 넣고 그녀가 삼키도록 강요한다. 얼마 지나지 않아 그녀는 식은땀을 흘리기 시작하고 온몸이 새빨갛게 달아오른다.
				SIF LOCAL
					GOTO PRANK_RAPE
				PRINTFORMDW 함께 노력하여 그녀를 집까지 부축해 데려오고, 눈에 띄지 않게 한다...
				PRINTL
				PRINTFORMDW .........
				PRINTL
				PRINTFORMDW 네가 들어설 때쯤이면 그녀는 이미 발정기에 깊이 빠져 있었다. 최음제(aphrodisiac)가 효과를 보고 있었다.
				CFLAG:MASTER:現在位置 = CFLAG:MASTER:初期位置
				CFLAG:53:現在位置 = CFLAG:MASTER:現在位置
				CFLAG:PrankTarget:現在位置 = CFLAG:MASTER:現在位置
				$PRANK_RAPE
				PRINTFORMW 「헤헤... 이제 그녀는 네 차지야!」
				PRINTFORML 「나에게도 보상을 줘, 알았지?」
				TALENT:53:機嫌 = 1
				CFLAG:MASTER:うふふ = 1
				CFLAG:PrankTarget:うふふ = 1
				CFLAG:53:うふふ = 1
				TCVAR:PrankTarget:無理矢理 = 1
				TCVAR:PrankTarget:媚薬 += 1000
				PALAM:PrankTarget:欲情 += 5000
			ELSE
				PRINTFORMDW 비록 당신이 테위와 힘을 합치지만, 두 사람은 충분히 강하지 않았고 그녀가 단막(Danmaku)의 세례로 당신들을 전멸시켰다.
				PRINTL
				PRINTFORMDW ＼ 피추운 ／
				PRINTL
				SELECTCASE PrankTarget
					CASE 51
						CALL CHARA_TEXT(PrankTarget,@"「나한테 손대지 마, 이 변태들아!」","w")
					CASE 52
						CALL CHARA_TEXT(PrankTarget,@"「너희 둘... 그만둬! 너무 심한 장난이야!」","w")
				ENDSELECT
				PRINTFORMDW 결국 할 수 있는 것은 목숨을 걸고 탈출하는 것뿐이다...
				CFLAG:PrankTarget:同行 = 0
				CALL GETOUT(MASTER)
				CFLAG:53:現在位置 = CFLAG:MASTER:現在位置
			ENDIF
		ENDIF
		CFLAG:53:K53C_RAPE_ASSISTANT ++
	CASEELSE
		GOTO LOOP8
ENDSELECT
