@M_KOJO_EVENT_K53_CHILD_RAISING_しつけ
;-------------------------------------------------
	;Learning manners.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	SELECTCASE ChildCount
		CASE 1
			IF K53_CHILD_PERSONALITY(ChildNumber) == "Gloomy"
					;Special case for a single Gloomy child.
				PRINTFORMDL %ChildCallName% is still very quiet, but seems to be getting better at speaking.
				PRINTFORMDW Tewi does her best to coax %HIM_HER_CHILD(53,0,ChildNumber)% to communicate...
				RETURN
			ENDIF
			PRINTFORMD %ChildCallName% is
		CASE 2
			PRINTFORMD %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% are
		CASEELSE
			PRINTFORMD %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings are
	ENDSELECT
	PRINTFORMDL  getting much better at speaking. %PLNOUN(@"%HE_SHE_CHILD(53,1,ChildNumber)%'s",ChildCount)% constantly chattering and demanding your attention.
	PRINTFORMDW %PLNOUN(@"%HE_SHE_CHILD(53,1,ChildNumber)%'s",ChildCount)% also learning to play pranks on you. Your patience is tried...
ENDIF
