@M_KOJO_EVENT_K53_CHILD_RAISING_よちよち
;-------------------------------------------------
	;Walking.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Text covers all children in a litter.
	PRINTFORMDL
	SELECTCASE ChildCount
		CASE 1
			LOCALS '= @"%HE_SHE_CHILD(53,1,ChildNumber)%"
		CASE 2
			ChildCallName += @" and %HIS_HER_CHILD(53,0,ChildNumber)% twin"
			LOCALS = They
		CASEELSE
			ChildCallName += @" and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings"
			LOCALS = They
	ENDSELECT
	PRINTFORMDL %ChildCallName% can walk, jump, and even run around now.
	PRINTFORMDW %LOCALS% %SPLIT_G(@"get%COND_STR("s",!ChildCount)% underfoot all the time:even climb%COND_STR("s",!ChildCount)% into places %LOCALS% shouldn't be:constantly run%COND_STR("s",!ChildCount)% across the house:gleefully dash%COND_STR("es",!ChildCount)% back and forth:seem%COND_STR("s",!ChildCount)% to be everywhere all at once")%...
ENDIF
