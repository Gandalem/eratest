;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;-------------------------------------------------
@M_KOJO_EVENT_K53_CHILD_RAISING_就学
;-------------------------------------------------
	;Attending school.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	SELECTCASE ChildCount
		CASE 1
			PRINTFORMD %ChildCallName% is
		CASE 2
			PRINTFORMD %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% twin are
		CASEELSE
			PRINTFORMD %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings are
	ENDSELECT
	PRINTFORMDW  ready to start attending school.
ENDIF
PRINTL
SELECTCASE K53_CHILD_PERSONALITY(ChildNumber)
	CASE "Cheerful"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「%ChildCallName%, you're going to make lots of friends at school, I just know it!」
				CALL CHILD_TEXT(@"「Yeah! And then I'll use my loyalty network to establish a core customer base that will draw in more influence and secure economic control!」",53,ChildNumber,"w")
				PRINTFORMW 「Just like we practiced!」
				PRINTFORMDW Tewi hugs %ChildCallName% tightly while you wonder what ill fate is in store for the temple school.
			CASE 1
				PRINTFORMW 「%ChildCallName%! You're going to behave yourself in class, right?」
				CALL CHILD_TEXT(@"「Nope!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% grins at Tewi, who grins back and rubs her %SON_DAUGHTER_CHILD(53,0,ChildNumber)%'s head.
				PRINTFORMW 「That's my %BOY_GIRL_CHILD(53,0,ChildNumber)%!」
			CASE 2
				PRINTFORMW 「%ChildCallName%, how are you feeling?」
				CALL CHILD_TEXT(@"「Great! The first thing I'm gonna do is find a friend!」",53,ChildNumber,"w")
				PRINTFORMDW With how sociable %ChildCallName% is, you aren't surprised that %HE_SHE_CHILD(53,0,ChildNumber)%'s already planning on making human friends.
				CALL CHILD_TEXT(@"「The second thing I'm gonna do is find an enemy! Then I'll make them fight!」",53,ChildNumber,"w")
				PRINTFORMDW ...In a way, that isn't surprising, either.
		ENDSELECT
	CASE "Show-off"
		SELECTCASE RAND:3
			CASE 0
				CALL CHILD_TEXT(@"「\@ CHILD_SEX:53:ChildNumber == 2 ? I'm gonna say the teacher looks hot and embarrass her! # I'm gonna find a cute boy and kiss him! \@」",53,ChildNumber,"w")
				PRINTFORMW 「%ChildCallName%! Do you think that's appropriate for a little %BOY_GIRL_CHILD(53,0,ChildNumber)%?!」
				CALL CHILD_TEXT(@"「I'll \@ CHILD_SEX:53:ChildNumber == 2 ? touch her boobies! # catch him in a trap and tease him first! \@」",53,ChildNumber,"w")
				PRINTFORMW 「That's better. Aim higher! You can get away with so much as a kid!」
				PRINTFORMDW Tewi seems to be teaching %HIM_HER_CHILD(53,0,ChildNumber)% quite a bit already...
			CASE 1
				CALL CHILD_TEXT(@"「I'm gonna come home with perfect marks, you'll see!」",53,ChildNumber,"w")
				PRINTFORMDW Oh? Sounds like %ChildCallName% is planning on taking the schoolwork seriously.
				CALL CHILD_TEXT(@"「Yeah! I already have a three-stage plan to change my score!」",53,ChildNumber,"w")
			CASE 2
				CALL CHILD_TEXT(@"「I'm gonna be the most popular one in school!」",53,ChildNumber,"w")
				PRINTFORMDW That sounds lovely, but you remind %ChildCallName% that learning should come first.
				CALL CHILD_TEXT(@"「I know that! I'm gonna be the smartest one, too!」",53,ChildNumber,"w")
				PRINTFORMDW Sounds like %HE_SHE_CHILD(53,0,ChildNumber)%'s got some big plans.
		ENDSELECT
	CASE "Defiant"
		SELECTCASE RAND:3
			CASE 0
				CALL CHILD_TEXT(@"「I don't want to go to school.」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% is pouting. You ask him to think about the friends he could make there.
				CALL CHILD_TEXT(@"「I don't want to make friends.」",53,ChildNumber,"w")
				PRINTFORMW 「You can make lots of enemies, too～!」
				CALL CHILD_TEXT(@"「...Fine, I'll go.」",53,ChildNumber,"w")
				PRINTFORMDW Why did that do it?!
			CASE 1
				PRINTFORMDW You notice that %ChildCallName% is dressed to go out, but doesn't have his things.
				PRINTFORMW 「%ChildCallName%, are you going to skip class on your first day?」
				CALL CHILD_TEXT(@"「Yeah, what about it? School's for losers.」",53,ChildNumber,"w")
				PRINTFORMW 「Right～? I'll come with you, we can play instead!」
				CALL CHILD_TEXT(@"「Uh, y-you know what, I feel like going after all!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% looks frustrated... Is this Tewi's way of making him behave?
			CASE 2
				CALL CHILD_TEXT(@"「Are we going yet?」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% is oddly anxious. Is he excited to get there?
				CALL CHILD_TEXT(@"「Not really. School's dumb, why would I want to go?」",53,ChildNumber,"w")
				PRINTFORMW 「He wants to get in fights with human kids～」
				CALL CHILD_TEXT(@"「I-I do not!」",53,ChildNumber,"w")
		ENDSELECT
	CASE "Tsundere"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW You notice that %ChildCallName% doesn't have her books with her and gently remind her to take them.
				CALL CHILD_TEXT(@"「I didn't forget! I-I was going to take them!」",53,ChildNumber,"w")
				PRINTFORMDW She hastily collects the books with a spine as stiff as a board. Is she nervous about going?
				CALL CHILD_TEXT(@"「I'm fine, stop pushing me! I can get ready by myself!」",53,ChildNumber,"w")
				PRINTFORMDW Your little girl is so independent... but as you're thinking this, she takes hold of your hand.
				CALL CHILD_TEXT(@"「...So, are we going now or what?」",53,ChildNumber,"w")
				PRINTFORMDW Seems she's expecting you to walk her there...
			CASE 1
				PRINTFORMW 「%ChildCallName%, tell me aaaa―ll about your day when you get back, okay?」
				CALL CHILD_TEXT(@"「D-Don't put more pressure on me! I don't know what to do!」",53,ChildNumber,"w")
				PRINTFORMDW You gently tell %ChildCallName% to relax. You know she'll do just fine.
				CALL CHILD_TEXT(@"「Even if you say that, I...」",53,ChildNumber,"w")
			CASE 2
				PRINTFORMW 「%ChildCallName%, remember to make a good impression, okay?」
				CALL CHILD_TEXT(@"「H-How do I do that?」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% puts on an annoyed tone, but she seems genuinely worried. Is she nervous about meeting people?
				PRINTFORMW 「Oh, it's easy! Just smile and be nice to people and look cute!」
				CALL CHILD_TEXT(@"「Easy for you to say...」",53,ChildNumber,"w")
				PRINTFORMW 「And if all else fails, a girl can just show her panties a little!」
				CALL CHILD_TEXT(@"「I-I'm not doing that!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% turns beet red and Tewi snickers at her reaction. She stands up straight and shrugs it off.
				CALL CHILD_TEXT(@"「%K53_CHILD_MASTER_NICKNAME(ChildNumber)%, tell %K53_CHILD_TEWI_NICKNAME(ChildNumber)% to stop saying things like that! Right now!」",53,ChildNumber,"w")
				PRINTFORMDW Somehow, it feels like she got more confident all of a sudden.
		ENDSELECT
	CASE "Prideful"
		SELECTCASE RAND:3
			CASE 0
				CALL CHILD_TEXT(@"「I've got my books, I practiced talking to humans, and I even did some pre-studying!」",53,ChildNumber,"w")
				PRINTFORMW 「Wow～! You're taking it really seriously!」
				PRINTFORMDW There's a note of surprise in Tewi's voice. Maybe unlike her, %ChildCallName% is a gifted child.
				PRINTFORMW 「Hey, what's in that bag you've got?」
				CALL CHILD_TEXT(@"「Stinkbombs and firecrackers!」",53,ChildNumber,"w")
				PRINTFORMW 「So many!」
				PRINTFORMDW Gifted at various things, perhaps.
			CASE 1
				PRINTFORMW 「What're you going to do at school, %ChildCallName%?」
				CALL CHILD_TEXT(@"「Make friends, compliment the teacher, offer to clean up, and set a good example!」",53,ChildNumber,"w")
				PRINTFORMW 「S-So bright, I think I'm crying...」
				PRINTFORMDW You notice that he didn't mention anything about learning.
			CASE 2
				PRINTFORMW 「What's your plan for school, %ChildCallName%?」
				CALL CHILD_TEXT(@"「First, I'll stinkbomb the classroom so we have to go outside. Then, I'll splash water on the girls!」",53,ChildNumber,"w")
				PRINTFORMW 「So methodical～!」
				PRINTFORMDW ...What about learning the material?
				CALL CHILD_TEXT(@"「Yeah, yeah, if there's time for that.」",53,ChildNumber,"w")
		ENDSELECT
	CASE "Devoted"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「Let's see, are we ready? Oh, I almost forgot!」
				PRINTFORMDW As Tewi dashes off to get something, %ChildCallName% tugs on your clothing for attention.
				CALL CHILD_TEXT(@"「%K53_CHILD_MASTER_NICKNAME(ChildNumber)%, are you coming, too?」",53,ChildNumber,"w")
				PRINTFORMDW You gently explain that you're not attending school with her and she starts to pout. Is she really so attached?
				PRINTFORMDW Now, now, this isn't something you can do for her anyway. \@ IS_CHILD(MASTER) ? Even if you're a child, too, you have other responsibilities. # Going to school is a child's job. \@
				PRINTFORMW 「I'm ready for my first day!」
				PRINTFORMDW Just then, Tewi comes back wearing an outside world school uniform complete with a red backpack and emergency buzzer.
				PRINTFORMDW ...You quietly ask %ChildCallName% if this doesn't embarrass her.
				CALL CHILD_TEXT(@"「M-Maybe...」",53,ChildNumber,"w")
			CASE 1
				CALL CHILD_TEXT(@"「I'm going to try my best at school. I'll make you proud of me, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% smiles brilliantly at you. You can't help but tell her that you're already proud.
			CASE 2
				PRINTFORMDW %ChildCallName% looks pretty happy. Is she looking forward to going?
				CALL CHILD_TEXT(@"「Yes... Just think, I'm going to learn so much!」",53,ChildNumber,"w")
				PRINTFORMW 「You're always so serious about things, %ChildCallName%～」
				PRINTFORMDW Unlike Tewi, who'd never pay attention in a class... You quietly advise %ChildCallName% to learn from positive examples and she giggles merrily.
				CALL CHILD_TEXT(@"「Yes, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%. I'll do my very best!」",53,ChildNumber,"w")
		ENDSELECT
	CASE "Gloomy"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW %ChildCallName% quietly gets ready for school without saying anything. Is %HE_SHE_CHILD(53,0,ChildNumber)% nervous? Looking forward to it?
				CALL CHILD_TEXT(@"「...I don't know.」",53,ChildNumber,"w")
			CASE 1
				PRINTFORMW 「You're gonna do great at school, %ChildCallName%! You're a smart cookie!」
				CALL CHILD_TEXT(@"「Mm.」",53,ChildNumber,"w")
				PRINTFORMDW Tewi rubs %ChildCallName%'s head affectionately while %ChildCallName% just stares...
			CASE 2
				PRINTFORMW 「%ChildCallName%, try to make some friends, okay?」
				CALL CHILD_TEXT(@"「...Okay.」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName% agrees, but you can tell %HE_SHE_CHILD(53,0,ChildNumber)%'s just saying that so Tewi doesn't keep bugging %HIM_HER_CHILD(53,0,ChildNumber)%.
				PRINTFORMDW Is a crowded temple school really the best environment for %HIM_HER_CHILD(53,0,ChildNumber)%...?
				PRINTFORMW 「%HE_SHE_CHILD(53,1,ChildNumber)%'ll be just fine. %HE_SHE_CHILD(53,1,ChildNumber)%'s really smart, you know! Just try to talk more!」
				CALL CHILD_TEXT(@"「I will...」",53,ChildNumber,"w")
		ENDSELECT
ENDSELECT
