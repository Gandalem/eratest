@M_KOJO_EVENT_K53_CHILD_RAISING_つかまり立ち
;-------------------------------------------------
	;Learning to walk.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Text covers all children in a litter.
	PRINTFORMDL
	LOCALS '= ChildCallName
	SELECTCASE ChildCount
		CASE 1
			ChildCallName += @" has"
			LOCALS '= @"%HE_SHE_CHILD(53,0,ChildNumber)%'s"
		CASE 2
			ChildCallName += @" and %HIS_HER_CHILD(53,0,ChildNumber)% twin have"
			LOCALS = they're
		CASEELSE
			ChildCallName += @" and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings have"
			LOCALS = they're
	ENDSELECT
	IF FIRSTTIME("LearningToWalk",0,53)
		PRINTFORMDW Tewi is working hard to teach \@ ChildNumber ? her litter # %CHILDNAME:53:ChildNumber% \@ how to function.
		PRINTFORMDW For the purpose of learning to walk, %ChildCallName% been placed at the opposite end of a room while the two of you call out.
		PRINTL
		ChildCallName '= CHILDNAME:53:ChildNumber
		PRINTFORMW 「Come here, \@ ChildCount ? bunnies # %ChildCallName% \@! Hop on over!」
		PRINTFORMDW Tewi beckons and waves as though she's training %PLNOUN("a dog",ChildCount)% and your %PLNOUN("child",ChildCount)% come%COND_STR("s",ChildCount < 2)% tottering towards you.
		PRINTFORMW 「Aaah, you're doing it! Keep it up, keep it up!」
		PRINTFORMDW You cheer to encourage %PLNOUN(HIM_HER_CHILD(53,0,ChildNumber),ChildCount)% as %PLNOUN(HE_SHE_CHILD(53,0,ChildNumber),ChildCount)% make%COND_STR("s",ChildCount < 2)% it halfway, only to watch \@ ChildCount ? %CHILDNAME:53:ChildNumber% # %HIM_HER_CHILD(53,0,ChildNumber)% \@ topple and fall flat on %HIS_HER_CHILD(53,0,ChildNumber)% face.
		PRINTL
		PRINTFORMW 「Oh, no! Bunny down! You know what that means!」
		PRINTFORMDW Seeing this, Tewi rushes over and picks %HIM_HER_CHILD(53,0,ChildNumber)% up with both hands.
		PRINTFORMDW After gently kissing %HIM_HER_CHILD(53,0,ChildNumber)% on both of %HIS_HER_CHILD(53,0,ChildNumber)% cheeks, she then tucks %HIM_HER_CHILD(53,0,ChildNumber)% into a ball and bowls %HIM_HER_CHILD(53,0,ChildNumber)% back to the other end of the room.
		PRINTFORMW 「Try again from the beginning!」
		PRINTFORMDW Her teaching method is surprisingly harsh...
		RETURN
	ENDIF
	PRINTFORMDL %ChildCallName% started hopping around on all fours.
	PRINTFORMDW Gradually, %LOCALS% learning to walk upright, as well...
ENDIF
;-------------------------------------------------

