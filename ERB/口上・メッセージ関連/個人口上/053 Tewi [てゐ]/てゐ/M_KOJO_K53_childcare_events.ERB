@M_KOJO_EVENT_K53_CHILD_RAISING_離乳
;-------------------------------------------------
	;Weaning.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	LOCALS '= ChildCallName
	SELECTCASE ChildCount
		CASE 1
			LOCALS += @"%COND_STR("'s eyes have opened and",TALENT:MASTER:動物耳 == 2)% is"
		CASE 2
			LOCALS += @" and %HIS_HER_CHILD(53,0,ChildNumber)% twin%COND_STR("'s eyes have opened and the two of them",TALENT:MASTER:動物耳 == 2)% are"
		CASE 3
			LOCALS += @" and %HIS_HER_CHILD(53,0,ChildNumber)% fellow triplets%COND_STR("' eyes have opened and the three of them",TALENT:MASTER:動物耳 == 2)% are"
		CASEELSE
			LOCALS += @" and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings%COND_STR("' eyes have opened and all of them",TALENT:MASTER:動物耳 == 2)% are"
	ENDSELECT
	PRINTFORMDW %LOCALS% ready for real food.
	IF FIRSTTIME("BabyFood",0,53)
		WAIT
		PRINTFORMW 「Huh? Baby food?」
		PRINTFORMDW Isn't now the time for that? When was Tewi planning to make the switch?
		PRINTFORMW 「Don't they grow fangs and start hunting prey on their own?」
		PRINTFORMDW What kind of rabbits does she think your children are...?
		PRINTL
		PRINTFORMW 「Well, what should we do? %PLNOUN(HE_SHE_CHILD(53,1,ChildNumber),ChildCount)% can't chew yet.」
		PRINTFORMDW Looks you'll have to help Tewi figure this out. You take her by the hand to prepare a first batch of baby food...
		PRINTL
		PRINTFORMDW .........
		PRINTL
		PRINTFORMW 「Okay, we're going to try it for the first time!」
		PRINTFORMDW Tewi begins the proceedings by presenting %ChildCallName% with a spoonful of mashed carrots.
		PRINTFORMDW The spoon slides neatly into %HIS_HER_CHILD(53,0,ChildNumber)% mouth and %HIS_HER_CHILD(53,0,ChildNumber)% eyes fly open as %HE_SHE_CHILD(53,0,ChildNumber)% gets %HIS_HER_CHILD(53,0,ChildNumber)% first taste.
		PRINTFORMDW %HIS_HER_CHILD(53,1,ChildNumber)% mouth begins to move rapidly before Tewi even slides the spoon out, as though trying to chew it without teeth.
		PRINTL
		PRINTFORMW 「Ooooh! Look at %HIM_HER_CHILD(53,0,ChildNumber)% go!」
		PRINTFORMDW Tewi laughs and pushes another spoonful into the baby's face. %HE_SHE_CHILD(53,1,ChildNumber)% takes to it greedily, gumming and gulping it down like %HE_SHE_CHILD(53,0,ChildNumber)%'s in a hurry.
		PRINTFORMW 「What a healthy %BOY_GIRL_CHILD(53,0,ChildNumber)%! Who's a strong and clever %BOY_GIRL_CHILD(53,0,ChildNumber)%? Yoooou aaaaare!」
		PRINTFORMDW Tewi and %ChildCallName% giggle together and she hands you the spoon to try feeding %HIM_HER_CHILD(53,0,ChildNumber)% yourself...
		SIF ChildCount > 1
			PRINTFORMW 「Now, let's not forget \@ ChildCount > 1 ?the others#our other patient baby\@!」
		RETURN
	ENDIF
	PRINTFORMW 「%SPLIT_G(@"I made enough for \@ ChildCount > 3 ?everyone#spills\@, so open wide!:Ready for the first-time taste test?:It's another first-time tasting!:Time for your first bite of food!:This one'll go great, I can just tell.:Hmm-hmm～ Who should give the%COND_STR(" first",ChildCount > 1)% spoon this time?～")%」
ENDIF
PRINTL
SELECTCASE K53_CHILD_PERSONALITY(ChildNumber)
	CASE "Cheerful"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName% smiles widely as %HE_SHE_CHILD(53,0,ChildNumber)% gulps down the baby food.
				PRINTFORMW 「Awww, such a happy little \@ CHILD_SEX:53:ChildNumber == 1 ?lady#guy\@!」
			CASE 1
				PRINTFORMDW %ChildCallName% swallows the food as fast as %HE_SHE_CHILD(53,0,ChildNumber)% possibly can.
				PRINTFORMW 「Wow, slow down! Hehehe!」
			CASE 2
				PRINTFORMDW As soon as %ChildCallName% gets %HIS_HER_CHILD(53,0,ChildNumber)% first taste of food, %HE_SHE_CHILD(53,0,ChildNumber)% breaks into a smile, then bounces up and down on %HIS_HER_CHILD(53,0,ChildNumber)% butt while waving %HE_SHE_CHILD(53,0,ChildNumber)% arms.
				PRINTFORMW 「Woah! Haha, it's a hit!」
			CASE 3
				PRINTFORMDW After tasting the food, %ChildCallName%'s eyes focus in on it and %HE_SHE_CHILD(53,0,ChildNumber)% starts to scoot forward.
				PRINTFORMDW As %HE_SHE_CHILD(53,0,ChildNumber)% does, Tewi pulls the spoon away to make %HIM_HER_CHILD(53,0,ChildNumber)% keep going...
				PRINTFORMW 「Hehe, look at %HIM_HER_CHILD(53,0,ChildNumber)% go! You've almost got it!」
				PRINTFORMDW You watch as Tewi continues to prank her own baby with a joyful smile...
		ENDSELECT
	CASE "Show-off"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName% swipes at the spoon with %HIS_HER_CHILD(53,0,ChildNumber)% hand when it draws near.
				PRINTFORMW 「Are you trying to take it, or push it away?」
				PRINTFORMDW You hold the spoon steady and %HE_SHE_CHILD(53,0,ChildNumber)% grasps the head with %HIS_HER_CHILD(53,0,ChildNumber)% little hand, smearing the food.
				PRINTFORMDW When %HE_SHE_CHILD(53,0,ChildNumber)% lets go, the food is stuck to it... Tewi gently pushes %HIS_HER_CHILD(53,0,ChildNumber)% hand towards %HIS_HER_CHILD(53,0,ChildNumber)% mouth.
				PRINTFORMDW The taste of the food causes %HIM_HER_CHILD(53,0,ChildNumber)% to pause in wonder and %HE_SHE_CHILD(53,0,ChildNumber)% starts to suck on %HIS_HER_CHILD(53,0,ChildNumber)% fingers while Tewi giggles over %HIS_HER_CHILD(53,0,ChildNumber)% expression.
				PRINTFORMW 「Hehehe, that's one way to do it!」
			CASE 1
				PRINTFORMDW When you move the spoon forward, %ChildCallName% holds out both hands and grabs your fingers.
				PRINTFORMW 「Oh? %HE_SHE_CHILD(53,1,ChildNumber)%'s more interested in you than the food, hehe.」
				PRINTFORMDW Then, %HE_SHE_CHILD(53,0,ChildNumber)% holds it still while %HE_SHE_CHILD(53,0,ChildNumber)% nibbles at the spoon...
				PRINTFORMW 「Or not?! Wow, what are you doing, little \@ CHILD_SEX:53:ChildNumber == 1 ?lady#guy\@?」
				PRINTFORMDW Looking pleased, Tewi starts going on about how "advanced" %HE_SHE_CHILD(53,0,ChildNumber)% is.
			CASE 2
				PRINTFORMDW %ChildCallName% dips %HIS_HER_CHILD(53,0,ChildNumber)% head forward and nibbles at the food before you can even slide it into %HIS_HER_CHILD(53,0,ChildNumber)% mouth.
				PRINTFORMW 「Oooh, %HE_SHE_CHILD(53,0,ChildNumber)% already knows what to do!」
				PRINTFORMDW Tewi claps and laughs at how proactive your child seems to be.
			CASE 3
				PRINTFORMDW %ChildCallName% takes to the baby food quickly and devours it in big gulps.
				PRINTFORMW 「Woah, look at you! Do we have enough to feed you?」
		ENDSELECT
	CASE "Defiant","Tsundere"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName% clamps %HIS_HER_CHILD(53,0,ChildNumber)% mouth shut when the spoon gets near...
				PRINTFORMW 「Huuuh, you don't want it? You'll love it, I promise!」
				PRINTFORMDW You tickle %ChildCallName% until %HE_SHE_CHILD(53,0,ChildNumber)% laughs and as soon as %HIS_HER_CHILD(53,0,ChildNumber)% mouth opens, Tewi inserts the spoon.
				PRINTFORMW 「There! Like it?」
				PRINTFORMDW %ChildCallName% frowns at first, but soon, %HE_SHE_CHILD(53,0,ChildNumber)%'s clamoring for more...
			CASE 1
				PRINTFORMDW %ChildCallName% eats the baby food calmly, but with an intense frown the whole time.
				PRINTFORMW 「Does %HE_SHE_CHILD(53,0,ChildNumber)% like it, or...?」
				PRINTFORMDW You and Tewi try to guess what %HE_SHE_CHILD(53,0,ChildNumber)% might be thinking...
			CASE 2
				PRINTFORMDW When shown the spoon of baby food, %ChildCallName% frowns.
				PRINTFORMW 「Uh-oh, this might be trouble...」
				PRINTFORMDW You gently slide the spoon inside %HIS_HER_CHILD(53,0,ChildNumber)% mouth and when you take it out, %HE_SHE_CHILD(53,0,ChildNumber)% starts to smile instead.
				PRINTFORMW 「Oh, maybe not!」
				PRINTFORMDW Soon, %HE_SHE_CHILD(53,0,ChildNumber)%'s anxious for more. Looks like %HE_SHE_CHILD(53,0,ChildNumber)% enjoys it after all.
			CASE 3
				PRINTFORMDW %ChildCallName% grips the spoon tightly as %HE_SHE_CHILD(53,0,ChildNumber)% eats the food, as if to stop you from taking it away.
				PRINTFORMW 「I think %HE_SHE_CHILD(53,0,ChildNumber)% likes it...」
		ENDSELECT
	CASE "Prideful","Devoted"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName% obediently samples the baby food when you offer it.
				PRINTFORMW 「Hehe, look at how calm %HE_SHE_CHILD(53,0,ChildNumber)% is!」
			CASE 1
				PRINTFORMDW %ChildCallName% happily eats the baby food, but when you put the spoon away, %HE_SHE_CHILD(53,0,ChildNumber)% starts to cry.
				PRINTFORMW 「Oh, no! Someone wants some more! %HE_SHE_CHILD(53,1,ChildNumber)%'s gonna be a fat baby―!」
				PRINTFORMDW Tewi picks up the spoon and begins feeding %HIM_HER_CHILD(53,0,ChildNumber)% some of the extra food she made.
				PRINTFORMW 「Chubby bunny, chubby bunny～%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「Heeere it is!」
				PRINTFORMDW %ChildCallName% gulps down the entire spoonful of baby food all at once.
				PRINTFORMW 「...And heeere's another one!」
				PRINTFORMDW Tewi presents a second spoonful and %ChildCallName% packs it away just as quickly. Impressed by %HIS_HER_CHILD(53,0,ChildNumber)% efficiency, Tewi scoops up some more...
				PRINTFORMW 「And another one... and another one...」
				PRINTFORMDW You have to remind her not to give too much.
			CASE 3
				PRINTFORMDW %ChildCallName% slowly, carefully eats the baby food...
				PRINTFORMW 「Don't be afraid of it! Pleeeease～!」
		ENDSELECT
	CASE "Gloomy"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName% turns away from the spoon of baby food...
				PRINTFORMW 「Look! Look at this!」
				PRINTFORMDW Tewi holds up a rabbit above %ChildCallName%'s head and %HIS_HER_CHILD(53,0,ChildNumber)% mouth hangs open as %HE_SHE_CHILD(53,0,ChildNumber)% stares at it...
				PRINTFORMDW Seizing the opportunity, you insert the spoon!
				PRINTFORMW 「Whoops! Tricked yooou!%UNICODE(0x2764)%」
				PRINTFORMDW Although %HE_SHE_CHILD(53,0,ChildNumber)% winces at first, %HE_SHE_CHILD(53,0,ChildNumber)%'s soon sucking on the spoon with a serious expression.
			CASE 1
				PRINTFORMDW After %ChildCallName%'s first taste of food, %HE_SHE_CHILD(53,0,ChildNumber)% stops eating.
				PRINTFORMW 「What's wrong, you don't like it?」
				PRINTFORMDW No matter how you coax %HIM_HER_CHILD(53,0,ChildNumber)%, %HE_SHE_CHILD(53,0,ChildNumber)% won't eat it, so Tewi whips up a new batch of baby food with different ingredients.
				PRINTFORMW 「Open wiiide! You're gonna grow up and be a big, strong bunny, okay?」
				PRINTFORMDW She tries as hard as she can to make %HIM_HER_CHILD(53,0,ChildNumber)% eat...
			CASE 2
				PRINTFORMDW %ChildCallName% eats the food calmly, but with a completely blank expression.
				PRINTFORMW 「Does %HE_SHE_CHILD(53,0,ChildNumber)% like it...? Does %HE_SHE_CHILD(53,0,ChildNumber)%?!」
				PRINTFORMDW Tewi keeps watching for a reaction, but %HIS_HER_CHILD(53,0,ChildNumber)% face never even twitches...
			CASE 3
				PRINTFORMDW %ChildCallName% smiles while eating the baby food, but when it's all gone, %HIS_HER_CHILD(53,0,ChildNumber)% face scrunches up and %HE_SHE_CHILD(53,0,ChildNumber)% starts a tantrum.
				PRINTFORMW 「Waah, don't cry! Don't be a greedy bunny～!」
				PRINTFORMDW Though %HE_SHE_CHILD(53,0,ChildNumber)% eventually calms down, %HE_SHE_CHILD(53,0,ChildNumber)% starts to sulk afterward...
		ENDSELECT
ENDSELECT
WAIT
