				PRINTFORMW 「%ChildCallName%, 기분이 어때?」
				CALL CHILD_TEXT(@"「좋아! 내가 제일 먼저 할 일은 친구를 찾는 거야!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%가 얼마나 사교적인지 보면, %HE_SHE_CHILD(53,0,ChildNumber)%가 이미 인간 친구를 사귀려고 계획하는 것에 놀라지 않는다.
				CALL CHILD_TEXT(@"「내가 할 두 번째 일은 적을 찾는 거야! 그리고 그들을 싸우게 만들겠어!」",53,ChildNumber,"w")
				PRINTFORMDW 어떤 면에서는 놀랍지도 않다.
		ENDSELECT
	CASE "Show-off"
		SELECTCASE RAND:3
			CASE 0
				CALL CHILD_TEXT(@"「\@ CHILD_SEX:53:ChildNumber == 2 ? 선생님이 멋있다고 말해서 치정하게 만들 거야! # 귀여운 남자애를 찾아서 키스할 거야! \@」",53,ChildNumber,"w")
				PRINTFORMW 「%ChildCallName%! 그게 작은 %BOY_GIRL_CHILD(53,0,ChildNumber)%에게 적절하다고 생각하니?!」
				CALL CHILD_TEXT(@"「나는 \@ CHILD_SEX:53:ChildNumber == 2 ? 그녀의 가슴을 만지겠어! # 그를 함정에 빠뜨려 먼저 놀려주겠어! \@」",53,ChildNumber,"w")
				PRINTFORMW 「그게 더 낫다. 더 높이 겨겨라! 너는 애라는 이유만으로 그렇게 많이 해도 된다!」
				PRINTFORMDW 테위가 이미 %HIM_HER_CHILD(53,0,ChildNumber)%에게 꽤 많은 것을 가르치고 있는 것 같다...
			CASE 1
				CALL CHILD_TEXT(@"「완벽한 점수로 집에 돌아올 거야, 지켜봐!」",53,ChildNumber,"w")
				PRINTFORMDW 어라? %ChildCallName%가 학교 숙제를 진지하게 하려는 것 같네.
				CALL CHILD_TEXT(@"「그래! 내 점수를 바꿀 세 단계의 계획이 이미 있어!」",53,ChildNumber,"w")
			CASE 2
				CALL CHILD_TEXT(@"「내가 학교에서 제일 인기 있는 사람이 될 거야!」",53,ChildNumber,"w")
				PRINTFORMDW 그것은 사랑스러워 보이지만, 당신은 학습이 우선되어야 함을 %ChildCallName%에게 상기시킨다.
				CALL CHILD_TEXT(@"「나도 그럴 거야! 나도 제일 똑똑해질 테니까!」",53,ChildNumber,"w")
				PRINTFORMDW %HE_SHE_CHILD(53,0,ChildNumber)%는 큰 계획이라도 있는 것 같군.
		ENDSELECT
	CASE "Defiant"
		SELECTCASE RAND:3
			CASE 0
				CALL CHILD_TEXT(@"「학교에 가기 싫어요.」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%는 토라져 있다. 너는 그에게 거기서 사귈 수 있는 친구들에 대해 생각해 보라고 말한다.
				CALL CHILD_TEXT(@"「친구 사귀고 싶지 않아.」",53,ChildNumber,"w")
				PRINTFORMW 「적도 많이 만들 수 있어~!」
				CALL CHILD_TEXT(@"「...알았어, 갈게.」",53,ChildNumber,"w")
				PRINTFORMDW 왜 그런 일을 한 거야?!
			CASE 1
				PRINTFORMDW 당신은 %ChildCallName%이 외출할 복장으로 차려입었지만 물건을 가지고 있지 않다는 것을 알아차린다.
				PRINTFORMW 「%ChildCallName%, 너 첫날에 학교 빼먹으려고?」
				CALL CHILD_TEXT(@"「뭐 어때? 학교는 패배자들을 위한 곳이야.」",53,ChildNumber,"w")
				PRINTFORMW 「맞지~? 같이 가줄게, 대신 놀자!」
				CALL CHILD_TEXT(@"「어, 그게 말이야, 나 다 해볼 것 같아!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%가 짜증을 내는 것 같다... 이게 테위(Tewi)가 그를 다루는 방식인가?
			CASE 2
				CALL CHILD_TEXT(@"「이제 갈 거야?」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%는 이상하게 불안해한다. 그곳에 가는 것이 기대되는 걸까?
				CALL CHILD_TEXT(@"「별로. 학교는 시시하니까 왜 가고 싶겠어?」",53,ChildNumber,"w")
				PRINTFORMW 「인간 아이들과 싸우고 싶어한다~」
				CALL CHILD_TEXT(@"「나, 나 안 해요!」",53,ChildNumber,"w")
		ENDSELECT
	CASE "Tsundere"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW 당신은 %ChildCallName%가 책을 가지고 있지 않은 것을 알아차리고 부드럽게 그것들을 챙기라고 상기시킨다.
				CALL CHILD_TEXT(@"「잊지 않았어! 나, 나는 그것들을 가져가려고 했단 말이야!」",53,ChildNumber,"w")
				PRINTFORMDW 그녀는 책등이 판처럼 딱딱한 책들을 서둘러 주운다. 그녀는 가는 것이 긴장되나?
				CALL CHILD_TEXT(@"「괜찮아, 나한테 자꾸 그러지 마! 나 혼자 준비할 수 있거든!」",53,ChildNumber,"w")
				PRINTFORMDW 당신의 어린 딸은 정말 독립적이야... 하지만 그렇게 생각하는 동안 그녀가 당신의 손을 잡는다.
				CALL CHILD_TEXT(@"「...그래서, 이제 갈 거야, 말 거야?」",53,ChildNumber,"w")
				PRINTFORMDW 그녀는 당신이 자신을 데려다주길 바라는 것 같다...
			CASE 1
				PRINTFORMW 「%ChildCallName%, 돌아오면 오늘 하루에 대해 전부 말해줘, 알겠지?」
				CALL CHILD_TEXT(@"「ㄷ, 더 이상 나한테 압박하지 마! 뭘 해야 할지 모르겠어!」",53,ChildNumber,"w")
				PRINTFORMDW 당신은 %ChildCallName%에게 부드럽게 긴장을 풀라고 말한다. 그녀는 잘 해낼 거라는 것을 안다.
				CALL CHILD_TEXT(@"「그렇게 말해도 난...」",53,ChildNumber,"w")
			CASE 2
				PRINTFORMW 「%ChildCallName%, 좋은 인상을 남기도록 해, 알았지?」
				CALL CHILD_TEXT(@"「저, 어떻게 하는 거죠?」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%은(는) 짜증 난 말투로 말하지만, 진심으로 걱정하는 것 같다. 사람들을 만나는 것이 긴장되는 걸까?
				PRINTFORMW 「아니야, 쉬워! 그냥 웃고 사람들한테 친절하게 대하고 귀엽게만 보이면 돼!」
				CALL CHILD_TEXT(@"「쉽게 말하긴 쉽네...」",53,ChildNumber,"w")
				PRINTFORMW 「그리고 다른 모든 것이 실패하더라도, 여자라면 그냥 팬티를 살짝 보여줄 수도 있지!」
				CALL CHILD_TEXT(@"「나, 난 그럴 리가 없어!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%은(는) 얼굴이 새빨개지고 테위는 그녀의 반응에 키득거린다. 그녀는 똑바로 서서 대수롭지 않게 넘긴다.
				CALL CHILD_TEXT(@"「%K53_CHILD_MASTER_NICKNAME(ChildNumber)%, %K53_CHILD_TEWI_NICKNAME(ChildNumber)%에게 그런 말 하지 말라고 해! 지금 당장!」",53,ChildNumber,"w")
				PRINTFORMDW 어쩐지 그녀가 갑자기 더 자신감을 얻은 것 같다.
		ENDSELECT
	CASE "Prideful"
		SELECTCASE RAND:3
			CASE 0
				CALL CHILD_TEXT(@"「책도 다 챙겼고, 인간들에게 말하는 연습도 했으며, 심지어 사전 학습까지 해봤어요!」",53,ChildNumber,"w")
				PRINTFORMW 「와~! 정말 진지하게 임하네!」
				PRINTFORMDW 테위의 목소리에는 놀라움이 묻어 있었다. 어쩌면 그녀와 달리 %ChildCallName%는 재능 있는 아이일지도 모른다.
				PRINTFORMW 「야, 그 가방 안에 뭐가 들었어?」
				CALL CHILD_TEXT(@"「썩은 폭탄이랑 폭죽이야!」",53,ChildNumber,"w")
				PRINTFORMW 「정말 많네!」
				PRINTFORMDW 여러 방면에서 재능이 있나 보다.
			CASE 1
				PRINTFORMW 「%ChildCallName%」은 학교에서 무엇을 할 거니?
				CALL CHILD_TEXT(@"「친구를 사귀고, 선생님께 칭찬하고, 청소를 자처하며, 좋은 본보기가 되어라!」",53,ChildNumber,"w")
				PRINTFORMW 「ㅅ-너무 밝아서 울 것 같아...」
				PRINTFORMDW 그는 배운 것에 대해 아무 말도 하지 않았다는 것을 깨닫는다.
			CASE 2
				PRINTFORMW 「%ChildCallName%」의 학교에 대한 계획은 무엇이니?
				CALL CHILD_TEXT(@"「우선 교실에 악취 가스를 뿌려서 밖에 나가게 만들 거야. 그런 다음 여자들에게 물을 뿌릴 거야!」",53,ChildNumber,"w")
				PRINTFORMW 「그렇게 체계적이라니~!」
				PRINTFORMDW ...자료를 학습하는 건 어때?
				CALL CHILD_TEXT(@"「그래, 그래, 그럴 시간이 있다면 말이지.」",53,ChildNumber,"w")
		ENDSELECT
	CASE "Devoted"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「음, 준비됐을까? 아, 깜빡할 뻔했네!」
				PRINTFORMDW 티위가 무언가를 가지러 달려나가자, %ChildCallName%이 네 옷자락을 잡아 관심을 요구한다.
				CALL CHILD_TEXT(@"「%K53_CHILD_MASTER_NICKNAME(ChildNumber)%도 올 거니?」",53,ChildNumber,"w")
				PRINTFORMDW 당신은 그녀에게 학교에 같이 다니지 않을 거라고 부드럽게 설명하고, 그녀는 입술을 삐죽 내민다. 정말 그렇게 집착하는 걸까?
				PRINTFORMDW 자, 진정해. 어차피 너 혼자 해줄 수 있는 일이 아니야. \@ IS_CHILD(MASTER) ? 네가 아이라 해도 다른 책임이 있단다. # 학교에 가는 건 아이의 일이야. \@
				PRINTFORMW 「나 첫 등교 준비됐어!」
				PRINTFORMDW 바로 그때, 테위가 빨간 배낭과 비상 버저까지 갖춘 바깥세상 교복을 입고 돌아온다.
				PRINTFORMDW ...당신은 조용히 %ChildCallName%에게 이게 그녀를 부끄럽게 하지는 않는지 묻는다.
				CALL CHILD_TEXT(@"「음... 아마도...」",53,ChildNumber,"w")
			CASE 1
				CALL CHILD_TEXT(@"「학교에서 최선을 다할 거예요. 저를 자랑스럽게 만들어 드릴게요, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%님!」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%는 당신을 향해 눈부시게 미소 짓는다. 당신은 그녀에게 이미 자랑스럽다고 말하지 않을 수 없다.
			CASE 2
				PRINTFORMDW %ChildCallName%는 꽤 행복해 보인다. 그녀는 갈 것을 기대하고 있는 걸까?
				CALL CHILD_TEXT(@"「응... 생각해보면, 정말 많이 배울 수 있을 거야!」",53,ChildNumber,"w")
				PRINTFORMW 「너는 항상 모든 일에 너무 진지해, %ChildCallName%～」
				PRINTFORMDW 수업 시간에 전혀 집중하지 않는 Tewi와 달리... 당신은 조용히 %ChildCallName%에게 긍정적인 모범을 통해 배우라고 조언하고 그녀는 즐겁게 웃는다.
				CALL CHILD_TEXT(@"「네, %K53_CHILD_MASTER_NICKNAME(ChildNumber)% 씨. 최선을 다할게요!」",53,ChildNumber,"w")
		ENDSELECT
	CASE "Gloomy"
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDW %ChildCallName%은 아무 말 없이 조용히 등교 준비를 한다. %HE_SHE_CHILD(53,0,ChildNumber)%는 긴장하고 있나? 기대하고 있나?
				CALL CHILD_TEXT(@"「...모르겠어.」",53,ChildNumber,"w")
			CASE 1
				PRINTFORMW 「학교에서 잘할 수 있을 거야, %ChildCallName%! 너는 똑똑한 아이야!」
				CALL CHILD_TEXT(@"「Mm.」",53,ChildNumber,"w")
				PRINTFORMDW 테위는 %ChildCallName%의 머리를 다정하게 쓰다듬는데, %ChildCallName%는 그저 응시하고 있었다...
			CASE 2
				PRINTFORMW 「%ChildCallName%, 친구를 사귀려고 노력해 봐, 알겠지?」
				CALL CHILD_TEXT(@"「...알겠어.」",53,ChildNumber,"w")
				PRINTFORMDW %ChildCallName%동의하지만, 당신은 %HE_SHE_CHILD(53,0,ChildNumber)%가 테위가 더 이상 %HIM_HER_CHILD(53,0,ChildNumber)%를 괴롭히지 못하게 하는 것뿐이라고 알 수 있다.
				PRINTFORMDW 북적이는 사찰 학교가 정말로 %HIM_HER_CHILD(53,0,ChildNumber)%에게 최고의 환경일까...?
				PRINTFORMW 「%HE_SHE_CHILD(53,1,ChildNumber)%는 괜찮을 거야. %HE_SHE_CHILD(53,1,ChildNumber)%는 정말 똑똑하잖아! 좀 더 말을 걸어봐!」
				CALL CHILD_TEXT(@"「나는 ... 할 거야」",53,ChildNumber,"w")
		ENDSELECT
ENDSELECT
