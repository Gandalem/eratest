@M_KOJO_EVENT_K53_CHILD_RAISING_つかまり立ち
;-------------------------------------------------
;Learning to walk.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
	;Text covers all children in a litter.
	PRINTFORMDL
	LOCALS '= ChildCallName
	SELECTCASE ChildCount
		CASE 1
			ChildCallName += @" 가지고 있다"
			LOCALS '= @"%HE_SHE_CHILD(53,0,ChildNumber)%'s"
		CASE 2
			ChildCallName += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)% 쌍둥이가 있다."
			LOCALS '= @"그들은"
		CASEELSE
			ChildCallName += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)%은(는) %NUM_COUNT(ChildCount-1)% 명의 형제자매를 가지고 있다."
			LOCALS '= @"그들은"
	ENDSELECT
	IF FIRSTTIME("LearningToWalk",0,53)
		PRINTFORMDW 테위는 \@ ChildNumber ? 자신의 새끼들 # %CHILDNAME:53:ChildNumber% \@ 에게 기능하는 법을 가르치기 위해 열심히 노력한다.
		PRINTFORMDW 걸음걸이를 배우려는 목적으로, 두 분이 소리치는 동안 %ChildCallName%은 방의 반대편에 놓여 있었다.
		PRINTL
		ChildCallName '= CHILDNAME:53:ChildNumber
		PRINTFORMW 「\@ ChildCount ? 토끼들 # %ChildCallName% \@아, 이리 와봐! 깡충 뛰어와 봐!」
		PRINTFORMDW 테위가 손짓하고 흔든다 마치 그녀가 훈련시키듯이 %PLNOUN("a dog",ChildCount)% 그리고 너의 %PLNOUN("child",ChildCount)% 다가오다%COND_STR("s",ChildCount < 2)% 당신에게 비틀거리며 다가온다.
		PRINTFORMW 「아, 해냈네! 계속해, 계속해!」
		PRINTFORMDW 너는 응원하며 %PLNOUN(HIM_HER_CHILD(53,0,ChildNumber),ChildCount)% ~로서 %PLNOUN(HE_SHE_CHILD(53,0,ChildNumber),ChildCount)% 만들다%COND_STR("s",ChildCount < 2)% 그것을 절반까지 만들고 지켜보는 것뿐이었다 \@ ChildCount ? %CHILDNAME:53:ChildNumber% # %HIM_HER_CHILD(53,0,ChildNumber)% \@ 쓰러져서 ~ 얼굴에 납작하게 떨어지다 %HIS_HER_CHILD(53,0,ChildNumber)% 얼굴에
		PRINTL
		PRINTFORMW 「오, 안 돼! 토끼야, 쓰러졌어! 그게 무슨 뜻인지 알잖아!」
		PRINTFORMDW 이것을 본 테위가 달려와 두 손으로 %HIM_HER_CHILD(53,0,ChildNumber)%을 집는다.
		PRINTFORMDW %HIS_HER_CHILD(53,0,ChildNumber)%의 양쪽 뺨에 부드럽게 키스한 후, 그녀는 %HIM_HER_CHILD(53,0,ChildNumber)%을 공처럼 말아 방 저쪽 끝으로 다시 던진다.
		PRINTFORMW 「처음부터 다시 해봐!」
		PRINTFORMDW 그녀의 가르치는 방식은 놀라울 정도로 거칠었다...
		RETURN
	ENDIF
	PRINTFORMDL %ChildCallName%은(는) 네 발로 뛰어다니기 시작했다.
	PRINTFORMDW 점차 %LOCALS%은(는) 똑바로 걷는 것을 배우게 되었다...
ENDIF
