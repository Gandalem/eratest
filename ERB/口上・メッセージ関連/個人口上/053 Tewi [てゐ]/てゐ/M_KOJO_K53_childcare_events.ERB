;-------------------------------------------------
@M_KOJO_EVENT_K53_CHILD_RAISING_玩具
;-------------------------------------------------
	;Playing with toys.
	;You can't tell what a rabbit will like in the future based on their baby toys. You can hardly guess what they'll like tomorrow.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CALLNAME:ChildNumber
; ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber) ;nas realchildren patch
OlderChild = FIND_CHILD("53","Learning to walk-Learning to be independent",,,,@"Older:{ChildNumber}")
SIF OlderChild
	; OlderChildCallName '= CHILDNAME:53:OlderChild
	OlderChildCallName '= CALLNAME:OlderChild
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	LOCALS '= ChildCallName
	SELECTCASE ChildCount
		CASE 1
			LOCALS += @" has"
			ChildCallName '= HE_SHE_CHILD(53,1,ChildNumber)
		CASE 2
			LOCALS += @" and %HIS_HER_CHILD(53,0,ChildNumber)% twin have"
		CASEELSE
			LOCALS += @" and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings have"
	ENDSELECT
	PRINTFORMDL %LOCALS% started to play with toys.
ENDIF
IF !RAND:2 && OlderChild && ONCE("BabyToysOlderChild",0,53)
		;Once per litter, an older child might form a connection with one of them.
	; ChildCallName '= CHILDNAME:53:ChildNumber
	ChildCallName '= CALLNAME:ChildNumber ;nas realchildren patch
	SELECTCASE K53_CHILD_PERSONALITY(OlderChild)
		CASE "Cheerful","Prideful","Devoted","Gloomy"
				;The nice personalities.
			$NICE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %OlderChildCallName% likes to play with %ChildCallName% by rolling a ball. They've bonded quickly.
				CASE 1
					PRINTFORMDL %OlderChildCallName% and %ChildCallName% often stack up blocks together. Maybe they're planning on building a house.
				CASE 2
					PRINTFORMDL %OlderChildCallName% shows %ChildCallName% a different toy every day and the two of them play together.
				CASE 3
					SIF !IS_MET_ENABLED(52)
						GOTO NICE
					PRINTFORMDL %OlderChildCallName% teaches %ChildCallName% to play with Reisen's panties.
			ENDSELECT
		CASE "Show-off","Defiant","Tsundere"
				;The mean personalities.
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %OlderChildCallName% teases %ChildCallName% often by playing keep-away with %HIS_HER_CHILD(53,0,ChildNumber)% favorite plushie.
				CASE 1
					PRINTFORMDL %OlderChildCallName% steals %ChildCallName%'s toys to get a reaction...
				CASE 2
					PRINTFORMDL %OlderChildCallName% makes distracting noises at %ChildCallName% whenever %HE_SHE_CHILD(53,0,ChildNumber)% plays by %HIM_HER_CHILD(53,0,ChildNumber)%self.
				CASE 3
					PRINTFORMDL %OlderChildCallName% throws %ChildCallName%'s toys around, watching as %HE_SHE_CHILD(53,0,ChildNumber)% scoots after them.
			ENDSELECT
	ENDSELECT
ELSE
	SELECTCASE K53_CHILD_PERSONALITY(ChildNumber)
		CASE "Cheerful","Show-off","Prideful","Devoted"
				;The positive personalities.
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %ChildCallName% is rather independent, throwing plush toys and chasing after them by %HIM_HER_CHILD(53,0,ChildNumber)%self.
				CASE 1
					PRINTFORMDL %ChildCallName% keeps throwing all of the toys at you and laughing.
				CASE 2
					PRINTFORMDL %ChildCallName% loves to shake the rattle to get your attention.
				CASE 3
					PRINTFORMDL %ChildCallName% and Tewi often play with the %SPLIT_G(@"blocks:rattles:stuffed carrots:toy ball")% together.
			ENDSELECT
		CASE "Defiant","Tsundere","Gloomy"
				;The negative personalities.
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %ChildCallName% always tries to hide %HIS_HER_CHILD(53,0,ChildNumber)% favorite toys.
				CASE 1
					PRINTFORMDL %ChildCallName% isn't very active and only "plays" by gripping the toys closely.
				CASE 2
					PRINTFORMDL %ChildCallName% tries to keep the toys to %HIM_HER_CHILD(53,0,ChildNumber)%self, not letting you play with %HIM_HER_CHILD(53,0,ChildNumber)%.
				CASE 3
					PRINTFORMDL %ChildCallName% likes to stack up colored blocks, in %HIS_HER_CHILD(53,0,ChildNumber)% own little world.
			ENDSELECT
	ENDSELECT
ENDIF
SIF CHILD_MULTIPLE_LAST(53,ChildNumber) == ChildNumber
	WAIT
;-------------------------------------------------

