@M_KOJO_EVENT_K53_CHILD_RAISING_喋る
;-------------------------------------------------
	;Learning to talk.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	SELECTCASE ChildCount
		CASE 1
			PRINTFORMDL %ChildCallName% has finally said %HIS_HER_CHILD(53,0,ChildNumber)% first word.
		CASE 2
			PRINTFORMDL One after the other, %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% twin have finally said their first words.
		CASEELSE
			PRINTFORMDL One after the other, %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings have finally said their first words.
	ENDSELECT
	PRINTL
ENDIF
CALL CHILD_TEXT(@"「%SPLIT_G(@"Carrot:Carro... Carrot:Hop, hop:You? You? You:Papa:Mama:%ChildCallName%:Iya... Wa... Want...:Bamboo:Me! Me! Me:Panty:Kick:Drug:Legs:Gunssss:Monkey:Bunny:Rabbit:Ears:Bunny, bunny:Hungry:Med'cine:House:Tree:Boom:Hard:Brother:Sister:Mochi:Dango:Moon:Grapes:Apple:Lemon:Sake:Ground:Soup:Miso:Oden:Nattou:Crab:Feet:Thumpy:Walking:Fire:Wood")%%SPLIT_G(@"!:!:?")%」",53,ChildNumber,"l")
SIF CHILD_MULTIPLE_LAST(53,ChildNumber) == ChildNumber
	PRINTFORMDW They grow up so fast...

;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
