@M_KOJO_EVENT_K53_CHILD_RAISING_語彙
;-------------------------------------------------
	;Developing speech.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
		;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	SELECTCASE ChildCount
		CASE 1
			PRINTFORMD %ChildCallName% is
		CASE 2
			PRINTFORMD %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% twin are
		CASEELSE
			PRINTFORMD %ChildCallName% and %HIS_HER_CHILD(53,0,ChildNumber)% %NUM_COUNT(ChildCount-1)% siblings are
	ENDSELECT
	PRINTFORMDL  learning to communicate and can more or less speak in full sentences now.
	PRINTL
ENDIF
SELECTCASE K53_CHILD_PERSONALITY(ChildNumber)
	CASE "Cheerful"
		CALL CHILD_TEXT(@"「%SPLIT_G(@"I'm hungry! %K53_CHILD_MASTER_NICKNAME(ChildNumber)%, I'm hungry!:Go. Let's go, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%.:%K53_CHILD_MASTER_NICKNAME(ChildNumber)%, %K53_CHILD_TEWI_NICKNAME(ChildNumber)%?")%」",53,ChildNumber,"l")
	CASE "Show-off"
		CALL CHILD_TEXT(@"「%SPLIT_G(@"%K53_CHILD_MASTER_NICKNAME(ChildNumber)%, lookit!:%K53_CHILD_MASTER_NICKNAME(ChildNumber)%! %K53_CHILD_MASTER_NICKNAME(ChildNumber)%. %K53_CHILD_MASTER_NICKNAME(ChildNumber)%!:Here! Over here! %K53_CHILD_MASTER_NICKNAME(ChildNumber)%, over here!:Look! Look, look!")%」",53,ChildNumber,"l")
	CASE "Defiant","Tsundere"
		CALL CHILD_TEXT(@"「%SPLIT_G(@"Don't wanna!:Go away!:I don't like that! I don't like that!")%」",53,ChildNumber,"l")
	CASE "Prideful","Devoted"
		CALL CHILD_TEXT(@"「%SPLIT_G(@"Look, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%!:Come back, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%!:I put the toys away, %K53_CHILD_MASTER_NICKNAME(ChildNumber)%.")%」",53,ChildNumber,"l")
	CASE "Gloomy"
		CALL CHILD_TEXT(@"「%SPLIT_G(@"...:Okay. Okay.:Whatever.:%K53_CHILD_MASTER_NICKNAME(ChildNumber)%?")%」",53,ChildNumber,"l")
ENDSELECT
SIF CHILD_MULTIPLE_LAST(53,ChildNumber) == ChildNumber && (ChildCount > 1 || K53_CHILD_PERSONALITY(ChildNumber) != "Gloomy")
		;Gloomy is quiet, so it doesn't get this message if it's the only one.
	PRINTFORMDW Naturally, %PLNOUN(HE_SHE_CHILD(53,0,ChildNumber),ChildCount)% %PLVERB("has",ChildCount)% a lot to say...
;-------------------------------------------------

