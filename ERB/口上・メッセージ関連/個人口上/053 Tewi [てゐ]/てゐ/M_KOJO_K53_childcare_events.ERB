; Modular ERB: 個人口上/053 Tewi [てゐ]/てゐ/M_KOJO_K53_childcare_events.ERB
;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;-------------------------------------------------

@M_KOJO_EVENT_K53_CHILD_RAISING_離乳
;-------------------------------------------------
;Weaning.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
ChildNumber = TALENT:53:育児中
ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber)
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
	;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	LOCALS '= ChildCallName
	SELECTCASE ChildCount
		CASE 1
			LOCALS += @"%COND_STR("'s eyes have opened and",TALENT:MASTER:動物耳 == 2)%이다"
		CASE 2
			LOCALS += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)% 쌍둥이%COND_STR("'s eyes have opened and the two of them",TALENT:MASTER:動物耳 == 2)%가 있다."
		CASE 3
			LOCALS += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)% 남은 세 쌍둥이들이 %COND_STR("' eyes have opened and the three of them",TALENT:MASTER:動物耳 == 2)% 있다."
		CASEELSE
			LOCALS += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)%은(는) 형제자매들%NUM_COUNT(ChildCount-1)%%COND_STR("' eyes have opened and all of them",TALENT:MASTER:動物耳 == 2)%이다."
	ENDSELECT
	PRINTFORMDW %LOCALS%는 진짜 음식 먹을 준비가 되었다.
	IF FIRSTTIME("BabyFood",0,53)
		WAIT
		PRINTFORMW 「어라? 아기 음식이라고?」
		PRINTFORMDW 지금이 그럴 때가 아니지. 테위는 언제 바꿀 계획이었던 거야?
		PRINTFORMW 「걔들이 이빨을 갈고 스스로 먹이를 사냥하기 시작할 때가 아닌가?」
		PRINTFORMDW 그녀는 네 아이들을 무슨 종류의 토끼라고 생각하는 거지...?
		PRINTL
		PRINTFORMW 「음, 뭘 하면 좋을까? %PLNOUN(HE_SHE_CHILD(53,1,ChildNumber),ChildCount)%는 아직 씹을 수 없어.」
		PRINTFORMDW 테위가 이걸 알아내도록 도와줘야 할 것 같아. 네가 그녀의 손을 잡고 아기 음식 첫 번째 배치를 준비해야 해...
		PRINTL
		PRINTFORMDW .........
		PRINTL
		PRINTFORMW 「좋아, 처음으로 시도해 보자!」
		PRINTFORMDW 테위는 %ChildCallName%에게 으깬 당근을 한 숟가락 떠서 절차를 시작한다.
		PRINTFORMDW 숟가락이 깔끔하게 %HIS_HER_CHILD(53,0,ChildNumber)%의 입안으로 들어가고, %HE_SHE_CHILD(53,0,ChildNumber)%가 첫 맛을 보면서 %HIS_HER_CHILD(53,0,ChildNumber)%의 눈이 커진다.
		PRINTFORMDW 테위가 숟가락을 빼기도 전에 %HIS_HER_CHILD(53,1,ChildNumber)%의 입은 이 없이 그것을 씹으려는 듯 빠르게 움직이기 시작한다.
		PRINTL
		PRINTFORMW 「우와! %HIM_HER_CHILD(53,0,ChildNumber)%가 가네!」
		PRINTFORMDW 테위는 웃으며 아기의 얼굴에 또 한 숟가락을 밀어 넣는다. %HE_SHE_CHILD(53,1,ChildNumber)%는 그것을 탐욕스럽게 받아먹으며, 마치 %HE_SHE_CHILD(53,0,ChildNumber)%'처럼 서둘러 씹고 삼킨다.
		PRINTFORMW 「건강한 %BOY_GIRL_CHILD(53,0,ChildNumber)%로구나! 강하고 똑똑한 %BOY_GIRL_CHILD(53,0,ChildNumber)%는 누구지? 바로 너야!」
		PRINTFORMDW 테위와 %ChildCallName%가 함께 깔깔 웃고 그녀는 당신에게 스푼을 건네며 스스로 %HIM_HER_CHILD(53,0,ChildNumber)%에게 먹여보라고 한다...
		SIF ChildCount > 1
			PRINTFORMW 「이제, \@ ChildCount > 1 ? 다른 아이들 # 우리의 다른 환자 아기들을 빼놓을 수 없지 \@!」
		RETURN
	ENDIF
	PRINTFORMW 「%SPLIT_G(@"I made enough for \@ ChildCount > 3 ?everyone#spills\@, so open wide!:Ready for the first-time taste test?:It's another first-time tasting!:Time for your first bite of food!:This one'll go great, I can just tell.:Hmm-hmm～ Who should give the%COND_STR(" first",ChildCount > 1)% spoon this time?～")%」
ENDIF
PRINTL
SELECTCASE K53_CHILD_PERSONALITY(ChildNumber)
	CASE "Cheerful"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %HE_SHE_CHILD(53,0,ChildNumber)%가 아기 음식을 급히 삼키자 %ChildCallName%이 활짝 웃는다.
				PRINTFORMW 「아, 정말 행복한 작은 \@ CHILD_SEX:53:ChildNumber == 1 ? 아가야. # 남자 \@이구나!」
			CASE 1
				PRINTFORMDW %ChildCallName%은(는) %HE_SHE_CHILD(53,0,ChildNumber)%이 할 수 있는 한 빨리 음식을 삼킨다.
				PRINTFORMW 「와, 천천히 해! 헤헤헤!」
			CASE 2
				PRINTFORMDW %ChildCallName%이 음식의 첫 맛을 보자마자, %HE_SHE_CHILD(53,0,ChildNumber)%은 웃음을 터뜨리고는 %HIS_HER_CHILD(53,0,ChildNumber)% 뒤에서 팔을 흔들며 위아래로 뛰어다닌다.
				PRINTFORMW 「와! 하하, 성공이야!」
			CASE 3
				PRINTFORMDW 음식을 맛본 후, %ChildCallName%의 눈이 그것에 집중되고 %HE_SHE_CHILD(53,0,ChildNumber)%가 앞으로 기어 나오기 시작한다.
				PRINTFORMDW %HE_SHE_CHILD(53,0,ChildNumber)%가 그렇게 하자, 테위는 %HIM_HER_CHILD(53,0,ChildNumber)%가 계속 나아가도록 숟가락을 거둔다...
				PRINTFORMW 「헤헤, %HIM_HER_CHILD(53,0,ChildNumber)%가 가는 걸 봐! 거의 다 왔어!」
				PRINTFORMDW 당신은 테위가 기쁜 미소를 지으며 자기 아기에게 계속 장난치는 것을 바라본다...
		ENDSELECT
	CASE "Show-off"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName%가 다가올 때 %HIS_HER_CHILD(53,0,ChildNumber)%의 손으로 수저를 휘젓는다.
				PRINTFORMW 「네가 그걸 가지려고 하는 거야, 아니면 밀어내려는 거야?」
				PRINTFORMDW 네가 수저를 안정적으로 잡고 %HE_SHE_CHILD(53,0,ChildNumber)%가 %HIS_HER_CHILD(53,0,ChildNumber)%의 작은 손으로 머리를 움켜쥐며 음식을 묻힌다.
				PRINTFORMDW %HE_SHE_CHILD(53,0,ChildNumber)%가 놓으면 음식은 거기에 들러붙는다... 테위가 %HIS_HER_CHILD(53,0,ChildNumber)%의 손을 %HIS_HER_CHILD(53,0,ChildNumber)%의 입 쪽으로 부드럽게 밀어준다.
				PRINTFORMDW 음식 맛에 %HIM_HER_CHILD(53,0,ChildNumber)%가 놀라 멈추고 %HE_SHE_CHILD(53,0,ChildNumber)%는 테위가 %HIS_HER_CHILD(53,0,ChildNumber)%의 표정을 보며 웃자 %HIS_HER_CHILD(53,0,ChildNumber)%의 손가락을 빨기 시작한다.
				PRINTFORMW 「헤헤헤, 그게 하는 방법이네!」
			CASE 1
				PRINTFORMDW 당신이 숟가락을 앞으로 움직이면, %ChildCallName%은 양손을 내밀고 당신의 손가락을 잡는다.
				PRINTFORMW 「어? %HE_SHE_CHILD(53,1,ChildNumber)%는 음식보다 당신에게 더 관심이 있네, 헤헤.」
				PRINTFORMDW 그러자, %HE_SHE_CHILD(53,0,ChildNumber)%은 그것을 가만히 들고 있는 동안 %HE_SHE_CHILD(53,0,ChildNumber)%은 숟가락을 깨문다...
				PRINTFORMW 「아니야?! 와, 뭐 하는 거야, 작은 \@ CHILD_SEX:53:ChildNumber == 1 ? 아가씨 # 남자 \@?」
				PRINTFORMDW 만족스러운 듯, 테위는 %HE_SHE_CHILD(53,0,ChildNumber)%가 얼마나 "발달했는지"에 대해 이야기하기 시작한다.
			CASE 2
				PRINTFORMDW %ChildCallName%는 당신이 음식을 입에 넣기도 전에 고개를 앞으로 숙이고 먹는다.
				PRINTFORMW 「우와, %HE_SHE_CHILD(53,0,ChildNumber)% 벌써 뭘 해야 할지 알고 있네!」
				PRINTFORMDW 테위는 아이가 얼마나 적극적인지에 박수를 치며 웃었다.
			CASE 3
				PRINTFORMDW %ChildCallName%은(는) 이유식을 빨리 먹으며 크게 한 모금씩 삼킨다.
				PRINTFORMW 「와, 너 정말 대단하다! 우리에게 줄 양이 충분할까?」
		ENDSELECT
	CASE "Defiant","Tsundere"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName%스푼이 가까워지면 %HIS_HER_CHILD(53,0,ChildNumber)%의 입을 다물게 한다...
				PRINTFORMW 「후우, 안 먹을 거야? 꼭 좋아하게 될 거라고 약속해!」
				PRINTFORMDW %ChildCallName%은 %HE_SHE_CHILD(53,0,ChildNumber)%가 웃을 때까지 간지럽히고, %HIS_HER_CHILD(53,0,ChildNumber)%의 입이 열리자마자 테위는 스푼을 넣는다.
				PRINTFORMW 「여기! 마음에 들어?」
				PRINTFORMDW %ChildCallName%은 처음에는 미간을 찌푸렸지만, 곧 %HE_SHE_CHILD(53,0,ChildNumber)%가 더 달라고 소리를 지르는 것을 본다...
			CASE 1
				PRINTFORMDW %ChildCallName%은(는) 아기 이유식을 차분하게 먹지만, 내내 심한 미간을 찌푸리고 있다.
				PRINTFORMW 「%HE_SHE_CHILD(53,0,ChildNumber)%은(는) 이걸 좋아할까, 아니면...?」
				PRINTFORMDW 당신과 Tewi는 %HE_SHE_CHILD(53,0,ChildNumber)%이 무슨 생각을 하고 있을지 추측해 본다...
			CASE 2
				PRINTFORMDW 아기 이유식 스푼을 보여주자 %ChildCallName%는 미간을 찌푸린다.
				PRINTFORMW 「어라, 이거 문제 될지도...」
				PRINTFORMDW 당신이 %HIS_HER_CHILD(53,0,ChildNumber)% 입안에 조심스럽게 스푼을 넣어주자, 그것을 꺼냈을 때 %HE_SHE_CHILD(53,0,ChildNumber)%는 대신 미소를 짓는다.
				PRINTFORMW 「오, 아닐지도!」
				PRINTFORMDW 곧 %HE_SHE_CHILD(53,0,ChildNumber)%는 더 먹고 싶어 한다. 알고 보니 %HE_SHE_CHILD(53,0,ChildNumber)%도 그것을 즐기는 모양이다.
			CASE 3
				PRINTFORMDW %HE_SHE_CHILD(53,0,ChildNumber)%가 음식을 먹는 동안 %ChildCallName%은 당신이 그것을 가져가는 것을 막으려는 듯 포크를 꽉 잡는다.
				PRINTFORMW 「나는 %HE_SHE_CHILD(53,0,ChildNumber)%가 그걸 좋아하는 것 같아...」
		ENDSELECT
	CASE "Prideful","Devoted"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName%은(는) 당신이 아기 음식을 권했을 때 순종적으로 맛을 본다.
				PRINTFORMW 「헤헤, %HE_SHE_CHILD(53,0,ChildNumber)%가 얼마나 침착한지 봐!」
			CASE 1
				PRINTFORMDW %ChildCallName%는 기쁘게 아기 이유식을 먹지만, 당신이 수저를 치우자 %HE_SHE_CHILD(53,0,ChildNumber)%가 울음을 터뜨린다.
				PRINTFORMW 「오, 안 돼! 누가 더 원하는 것 같아! %HE_SHE_CHILD(53,1,ChildNumber)%는 살찐 아기가 될 거야―!」
				PRINTFORMDW Tewi는 수저를 집어 들고 자신이 만든 남은 음식 중 일부를 %HIM_HER_CHILD(53,0,ChildNumber)%에게 먹이기 시작한다.
				PRINTFORMW 「통통한 토끼야, 통통한 토끼야～%UNICODE(0x2764)%」
			CASE 2
				PRINTFORMW 「자, 여기 있다!」
				PRINTFORMDW %ChildCallName%은(는) 아기 이유식 한 숟가락을 통째로 단번에 삼킨다.
				PRINTFORMW 「...그리고 또 하나 더!」
				PRINTFORMDW Tewi는 두 번째 숟가락을 내밀자 %ChildCallName%은(는) 그것을 순식간에 치운다. %HIS_HER_CHILD(53,0,ChildNumber)%의 효율성에 감탄한 Tewi는 더 많은 양을 떠서 먹는다...
				PRINTFORMW 「그리고 또 하나... 그리고 또 하나...」
				PRINTFORMDW 너무 많이 주지 않도록 그녀에게 상기시켜야 한다.
			CASE 3
				PRINTFORMDW %ChildCallName%은(는) 아기 이유식을 천천히 조심스럽게 먹는다...
				PRINTFORMW 「두려워하지 마! 제발~!」
		ENDSELECT
	CASE "Gloomy"
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMDW %ChildCallName%은 아기 이유식 스푼을 외면한다...
				PRINTFORMW 「봐! 이거 봐!」
				PRINTFORMDW 테위가 %ChildCallName%의 머리 위로 토끼를 들어 올리고 %HIS_HER_CHILD(53,0,ChildNumber)%는 입을 벌린 채 %HE_SHE_CHILD(53,0,ChildNumber)%는 그것을 응시한다...
				PRINTFORMDW 기회를 잡고, 당신은 스푼을 넣는다!
				PRINTFORMW 「웁스! 너 속였다!%UNICODE(0x2764)%」
				PRINTFORMDW 비록 %HE_SHE_CHILD(53,0,ChildNumber)%가 처음에는 움찔하지만, %HE_SHE_CHILD(53,0,ChildNumber)%는 곧 심각한 표정으로 스푼을 빨기 시작한다.
			CASE 1
				PRINTFORMDW %ChildCallName%의 첫 음식 맛을 본 후, %HE_SHE_CHILD(53,0,ChildNumber)%는 먹는 것을 멈춘다.
				PRINTFORMW 「왜 그래, 싫어?」
				PRINTFORMDW 아무리 %HIM_HER_CHILD(53,0,ChildNumber)%를 달래도, %HE_SHE_CHILD(53,0,ChildNumber)%는 먹지 않아서 테위는 다른 재료로 아기 이유식을 새로 만든다.
				PRINTFORMW 「입 크게 벌려! 너 어른 돼서 크고 튼튼한 토끼가 될 거야, 알았지?」
				PRINTFORMDW 그녀는 %HIM_HER_CHILD(53,0,ChildNumber)%가 먹도록 최대한 노력한다...
			CASE 2
				PRINTFORMDW %ChildCallName%은(는) 음식을 조용히 먹지만, 표정은 완전히 공허하다.
				PRINTFORMW 「%HE_SHE_CHILD(53,0,ChildNumber)%은(는) 그것을 좋아할까...? %HE_SHE_CHILD(53,0,ChildNumber)%은(는)?!」
				PRINTFORMDW Tewi는 반응을 기다리지만, %HIS_HER_CHILD(53,0,ChildNumber)%의 얼굴은 전혀 꿈쩍도 하지 않는다...
			CASE 3
				PRINTFORMDW %ChildCallName%아기 이유식을 먹을 때는 웃지만, 다 먹으면 %HIS_HER_CHILD(53,0,ChildNumber)%의 얼굴이 찌푸려지고 %HE_SHE_CHILD(53,0,ChildNumber)%는 떼쓰기 시작한다.
				PRINTFORMW 「우아앙, 울지 마! 욕심쟁이 토끼처럼 굴지 마～!」
				PRINTFORMDW 비록 %HE_SHE_CHILD(53,0,ChildNumber)%가 결국 진정하지만, 그 후 %HE_SHE_CHILD(53,0,ChildNumber)%는 시무룩해진다...
		ENDSELECT
ENDSELECT
WAIT
;-------------------------------------------------
;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;-------------------------------------------------

@M_KOJO_EVENT_K53_CHILD_RAISING_玩具
;-------------------------------------------------
;Playing with toys.
;You can't tell what a rabbit will like in the future based on their baby toys. You can hardly guess what they'll like tomorrow.
#DIM DYNAMIC ChildNumber
#DIMS DYNAMIC ChildCallName
#DIM DYNAMIC ChildCount
#DIM DYNAMIC OlderChild
#DIMS DYNAMIC OlderChildCallName
ChildNumber = TALENT:53:育児中
ChildCallName '= CALLNAME:ChildNumber
; ChildCallName '= CHILDNAME:53:ChildNumber
ChildCount = CHILD_MULTIPLE_COUNT(53,ChildNumber) ;nas realchildren patch
OlderChild = FIND_CHILD("53","Learning to walk-Learning to be independent",,,,@"부모: {ChildNumber}")
SIF OlderChild
	OlderChildCallName '= CALLNAME:OlderChild
CALL SET_KOJO_COLOR(53)
IF CHILD_MULTIPLE_FIRST(53,ChildNumber) == ChildNumber
	;Intro text will only happen for the first child in a litter.
	PRINTFORMDL
	LOCALS '= ChildCallName
	SELECTCASE ChildCount
		CASE 1
			LOCALS += @" 가지고 있다"
			ChildCallName '= HE_SHE_CHILD(53,1,ChildNumber)
		CASE 2
			LOCALS += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)% 쌍둥이가 있다"
		CASEELSE
			LOCALS += @" 그리고 %HIS_HER_CHILD(53,0,ChildNumber)%은(는) %NUM_COUNT(ChildCount-1)% 명의 형제자매를 가지고 있다."
	ENDSELECT
	PRINTFORMDL %LOCALS%가 장난감을 가지고 놀기 시작했다.
ENDIF
IF !RAND:2 && OlderChild && ONCE("BabyToysOlderChild",0,53)
	;Once per litter, an older child might form a connection with one of them.
	; ChildCallName '= CHILDNAME:53:ChildNumber
	ChildCallName '= CALLNAME:ChildNumber ;nas realchildren patch
	SELECTCASE K53_CHILD_PERSONALITY(OlderChild)
		CASE "Cheerful","Prideful","Devoted","Gloomy"
			;The nice personalities.
			$NICE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %OlderChildCallName%은(는) 공을 굴리며 %ChildCallName%과 놀기 좋아한다. 그들은 빠르게 유대감을 형성했다.
				CASE 1
					PRINTFORMDL %OlderChildCallName%와 %ChildCallName%는 종종 블록들을 함께 쌓는다. 어쩌면 집을 지으려고 계획하는 것일지도 모른다.
				CASE 2
					PRINTFORMDL %OlderChildCallName%은(는) 매일 %ChildCallName%에게 다른 장난감을 보여주고 둘이 함께 놀았다.
				CASE 3
					SIF !IS_MET_ENABLED(52)
						GOTO NICE
					PRINTFORMDL %OlderChildCallName%는 %ChildCallName%에게 레이선의 팬티로 노는 것을 가르친다.
			ENDSELECT
		CASE "Show-off","Defiant","Tsundere"
			;The mean personalities.
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %OlderChildCallName% 놀리다 %ChildCallName% 자주 가지고 놀면서 %HIS_HER_CHILD(53,0,ChildNumber)% 가장 좋아하는 봉제인형
				CASE 1
					PRINTFORMDL %OlderChildCallName%은(는) 반응을 얻기 위해 %ChildCallName%의 장난감을 훔친다...
				CASE 2
					PRINTFORMDL %OlderChildCallName%은 %HE_SHE_CHILD(53,0,ChildNumber)%가 %HIM_HER_CHILD(53,0,ChildNumber)% 혼자 놀 때마다 %ChildCallName%에게 방해되는 소리를 낸다.
				CASE 3
					PRINTFORMDL %OlderChildCallName%은/는 %ChildCallName%의 장난감을 사방에 던지며, %HE_SHE_CHILD(53,0,ChildNumber)%이 뒤쫓아가는 것을 지켜본다.
			ENDSELECT
	ENDSELECT
ELSE
	SELECTCASE K53_CHILD_PERSONALITY(ChildNumber)
		CASE "Cheerful","Show-off","Prideful","Devoted"
			;The positive personalities.
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %ChildCallName%은(는) 꽤 독립적이라 인형 장난감을 던지고 %HIM_HER_CHILD(53,0,ChildNumber)% 스스로 그것들을 쫓는다.
				CASE 1
					PRINTFORMDL %ChildCallName%은(는) 가지고 있는 장난감들을 모두 너에게 던지며 웃는다.
				CASE 2
					PRINTFORMDL %ChildCallName%은(는) 당신의 관심을 끌기 위해 딸랑이를 흔드는 것을 좋아한다.
				CASE 3
					PRINTFORMDL %ChildCallName%와 테위는 종종 %SPLIT_G(@"blocks:rattles:stuffed carrots:toy ball")%로 함께 놀았다.
			ENDSELECT
		CASE "Defiant","Tsundere","Gloomy"
			;The negative personalities.
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL %ChildCallName%은(는) 항상 %HIS_HER_CHILD(53,0,ChildNumber)%의 가장 좋아하는 장난감을 숨기려고 한다.
				CASE 1
					PRINTFORMDL %ChildCallName%는 별로 활동적이지 않고 장난감을 꼭 잡고만 "논다".
				CASE 2
					PRINTFORMDL %ChildCallName%은(는) 당신이 %HIM_HER_CHILD(53,0,ChildNumber)%와 가지고 놀지 못하게 %HIM_HER_CHILD(53,0,ChildNumber)%를 자기 것으로 두려고 한다.
				CASE 3
					PRINTFORMDL %ChildCallName% ...를 쌓는 것을 좋아해, ...에서 %HIS_HER_CHILD(53,0,ChildNumber)% 자신의 작은 세상에서.
			ENDSELECT
	ENDSELECT
ENDIF
SIF CHILD_MULTIPLE_LAST(53,ChildNumber) == ChildNumber
	WAIT
