;Custom 12,Double Handjob
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_CUSTOM_SCOM_K53_12
RETURN 1

@M_KOJO_MESSAGE_CUSTOM_SCOM_K53_12
TFLAG:SKIPASSIKOJO = 1
;Block dialogue from the other participant.
CALL K53_DOUBLE_HANDJOB(MASTER_POSE(SET_YUBI,SET_P,1))

@M_KOJO_MESSAGE_CUSTOM_SCOM_K53_12_2
CALL K53_DOUBLE_HANDJOB(MASTER_POSE(SET_YUBI,SET_P,0))

@K53_DOUBLE_HANDJOB(ARG)
CALL D_LINE
;EXP:MASTER_POSE(3,1,1):手淫経験 += 1
IF ARG == 52
	RESULT = 0
	CALL K53_REISEN_DOUBLE_HANDJOB
	SIF RESULT
		RETURN 1
ENDIF
IF !RAND:2
	LOCALS = 테위
	LOCALS:1 = %CALLNAME:ARG%
ELSE
	LOCALS = %CALLNAME:ARG%
	LOCALS:1 = 테위
ENDIF
PRINTFORMDL %SPLIT_G(@"%LOCALS%은(는) 당신의 귀두를 문지르고 %LOCALS:1%가 당신의 샤프트를 쓰다듬는다:%LOCALS%과 %LOCALS:1%는 각각 당신의 %TINKO(MASTER)% 주위를 감싸고 함께 동기화하여 펌프질한다:%LOCALS%과 %LOCALS:1%는 번갈아 가며 당신의 귀두를 문지른다:%LOCALS%과 %LOCALS:1%는 당신의 %TINKO(MASTER)%를 앞뒤로 구부리며, 번갈아 가며 끝부분을 문지른다:%LOCALS%은(는) 당신의 샤프트를 위아래로 펌프질하고 %LOCALS:1%가 기저부를 간지럽힌다:%LOCALS%과 %LOCALS:1%는 서로의 움직임을 거울처럼 따라하며 당신의 %TINKO(MASTER)%를 함께 쓰다듬는다:%LOCALS%과 %LOCALS:1%는 각각 한쪽을 유지하며 당신의 %TINKO(MASTER)%를 함께 쓰다듬는다:%LOCALS%과 %LOCALS:1%는 번갈아 가며 당신의 %TINKO(MASTER)%를 쓰다듬는다")%...
PRINTFORMDW
SELECTCASE ARG
	CASE 52
		IF CFLAG:53:K53C_REISEN_DOUBLE_HANDJOB_EVENT < 6
			SELECTCASE RAND:12
				CASE 0
					CALL CHARA_TEXT(53,@"「너 너무 느리다, 라이젠!」","l")
					CALL CHARA_TEXT(52,@"「빨리 하면 안 된다고 했잖아!」","l")
				CASE 1
					CALL CHARA_TEXT(52,@"「티위, 그만둬, 당신은 %HIM_HER(MASTER)%을/를 절정에 이르게 할 거야.」","l")
					CALL CHARA_TEXT(53,@"「그게 요점 아니야?」","l")
				CASE 2
					IF ABL:53:奉仕精神 > ABL:52:奉仕精神
						CALL CHARA_TEXT(53,@"「라이젠, 너 잘못하고 있어.」","l")
						CALL CHARA_TEXT(52,@"「%SPLIT_G(@"I-I'm not as experienced as you are...:W-Well, how should I do it?:Eh? I am?")%」","l")
					ELSEIF ABL:53:奉仕精神 < ABL:52:奉仕精神
						CALL CHARA_TEXT(52,@"「티위, 네가 다 틀리고 있어.」","l")
						CALL CHARA_TEXT(53,@"「네가 말하는 거야. 그냥 내 스타일이야~」","l")
						CALL CHARA_TEXT(52,@"「당신의 스타일이 %HIM_HER(MASTER)%을/를 거부하게 만든다!」","l")
					ELSE
						CALL CHARA_TEXT(53,@"「이것으로 누가 더 거시기 만지는 데 뛰어난지 결정될 것이다!」","l")
						CALL CHARA_TEXT(52,@"「안 돼, 그런 말 하지 마! 그만 좀 빨리 가지 마!」","l")
					ENDIF
				CASE 3
					CALL CHARA_TEXT(52,@"「기분 좋아, %K53_REISEN_MASTERNAME()%?」","l")
					CALL CHARA_TEXT(53,@"「너는 어때, 라이젠?」","l")
					CALL CHARA_TEXT(52,@"「음? 왜 나지...?」","l")
					CALL CHARA_TEXT(53,@"「기분 최고야~」","l")
				CASE 4
					IF K53_TSUN()
						CALL CHARA_TEXT(53,@"「또 이 물건을 만지게 하다니...」","l")
						CALL CHARA_TEXT(52,@"「원하지 않으면 언제든지 떠나도 돼.」","l")
						CALL CHARA_TEXT(53,@"「이-이건 뭔가 마법 같은 게 있어, 저항할 수가 없어...!」","l")
						CALL CHARA_TEXT(52,@"「그럴 줄 알았어...」","l")
					ELSE
						CALL CHARA_TEXT(53,@"「헤헤, 뿅~」","l")
						CALL CHARA_TEXT(52,@"「장난감처럼 다루지 마라...」","l")
						CALL CHARA_TEXT(53,@"「이건 우리만의 특별한 장난감이야~」","l")
						PRINTFORMDL 리젠이 얼굴을 찌푸린다.
						CALL CHARA_TEXT(52,@"「반대하고 싶지만...」","l")
						CALL CHARA_TEXT(53,@"「실제 사격 액션이야―!」","l")
						CALL CHARA_TEXT(52,@"「하-잠깐만, 진정해!」","l")
					ENDIF
				CASE 5
					CALL CHARA_TEXT(52,@"「부드럽게 해 줄게...」","l")
					CALL CHARA_TEXT(53,@"「상냥하게 하지 마! %조사처리(CALLNAME:MASTER,"는")% 이런 게 좋아―!」","l")
					CALL CHARA_TEXT(52,@"「티-티위, 그러지 마!」","l")
				CASE 6
					CALL CHARA_TEXT(53,@"「첫 번째 일격은 카구야상에게~♪」","l")
					CALL CHARA_TEXT(52,@"「하-헤이, 너무 무리하지 마!」","l")
				CASE 7
					CALL CHARA_TEXT(52,@"「너무 거칠게 하지 마, 테위. 이 부분은 아주 연약하고 소중하단다.」","l")
					CALL CHARA_TEXT(53,@"「그렇기 때문에 더 세게 하면 기분이 좋잖아―!」","l")
				CASE 8
					CALL CHARA_TEXT(53,@"「누가 먼저 그를 절정에 이르게 하는지 보자!」","l")
					CALL CHARA_TEXT(52,@"「우리 동시에 할 거야, 둘 다 하는 거지?」","l")
					CALL CHARA_TEXT(53,@"「라이젠, 라이젠... 너 여섯 번째 감각이 없다고 말하는 건 아니겠지?」","l")
					CALL CHARA_TEXT(52,@"「%SPLIT_G(@"That's not real!:That's a lame joke!:There's no such thing!:As if you do!")%」","l")
				CASE 9
					CALL CHARA_TEXT(52,@"「라이젠, 소원을 빌어―!」","l")
					CALL CHARA_TEXT(53,@"「뭐라고? 왜?」","l")
					CALL CHARA_TEXT(53,@"「거시기한테 소원을 빌면 행운이 따를 거야~」","l")
					CALL CHARA_TEXT(52,@"「도대체 뭐라고 말해야 할지...」","l")
				CASE 10
					IF K53_TSUN()
						CALL CHARA_TEXT(53,@"「냄새 안 나?」","l")
						CALL CHARA_TEXT(52,@"「나는 그 냄새가 좀 좋다...」","l")
						CALL CHARA_TEXT(53,@"「라이젠, 뭔가 특이한 거에 관심 있어...?」","l")
						CALL CHARA_TEXT(52,@"「오해하지 마!」","l")
					ELSE
						CALL CHARA_TEXT(53,@"「헤헤, 미스터 디크를 연모하지 않니?%UNICODE(0x2764)%」","l")
						CALL CHARA_TEXT(52,@"「애칭으로 부르는 거야... 이봐, 혼자만 알고 있지 마!」","l")
					ENDIF
				CASE 11
					CALL CHARA_TEXT(52,@"「내 길을 막지 마!」","l")
					CALL CHARA_TEXT(53,@"「내 길을 막지 마라!」","l")
			ENDSELECT
			PRINTFORMDL %SPLIT_G(@"서로 방해하며 움직인다:테위의 쓰기 속도가 라이젠보다 훨씬 빠르다:둘 다 동시에 같은 부분을 만지려 하면서 리듬을 끊는다:아무도 상대방이 무엇을 하는지 신경 쓰지 않는다:라이젠은 테위가 자기 말을 따르게 하려 하지만, 테위는 그녀를 무시한다:테위는 라이젠의 기교를 놀리며 그녀를 자극한다:테위는 짜증 나는 운율을 노래하며 라이젠을 좌절시킨다:그들의 움직임이 서로 방해되어 이상하게 느껴진다:일정한 속도를 유지할 수 없다:라이젠은 성기를 보살피려 하지만, 테위는 그것을 장난감처럼 다룬다:라이젠이 실수로 테위의 얼굴을 팔꿈치로 친다:테위가 의도적으로 라이젠의 얼굴을 팔꿈치로 친다:테위가 계속해서 라이젠에게서 성기를 빼앗는다:라이젠이 혼자 성기를 독차지하기 시작한다:그들은 당신의 성기를 두고 서로 당기며 싸우기 시작한다:그들은 불편한 표정으로 서로를 힐끔거린다:라이젠은 눈에 띄게 테위를 보지 않으려 애쓴다:둘 다 당신에게 집중하며 서로를 무시한다:그들은 비교적 잘 움직임을 동기화시킨다:그들의 손이 계속 부딪힌다:가끔 실수로 서로의 손가락을 잡는다")%.
		ELSE
			SELECTCASE RAND:12
				CASE 0
					IF ABL:53:奉仕精神 > ABL:52:奉仕精神
						CALL CHARA_TEXT(53,@"「라이젠, 이렇게 해봐!」","l")
						CALL CHARA_TEXT(52,@"「아, 그렇군요... 그래서 내가 잘못하고 있었던 거였어.」","l")
					ELSEIF ABL:53:奉仕精神 < ABL:52:奉仕精神
						CALL CHARA_TEXT(52,@"「아니, 아니야. 이렇게 하는 거야, 테위.」","l")
						CALL CHARA_TEXT(53,@"「우와, 알겠다~」","l")
					ELSE
						CALL CHARA_TEXT(53,@"「이것으로 누가 더 거시기 만지는 데 뛰어난지 결정될 것이다!」","l")
						CALL CHARA_TEXT(52,@"「나는 %K53_REISEN_MASTERNAME()%'의 거시기 만지는 걸에서 지지 않을 거야...」","l")
					ENDIF
				CASE 1
					CALL CHARA_TEXT(53,@"「자, 라이젠! 우리의 특수 기술이다!」","l")
					CALL CHARA_TEXT(52,@"「좋아... 해보자!」","l")
				CASE 2
					CALL CHARA_TEXT(52,@"「티위, 뒤처지지 않도록 조심해, 응?」","l")
					CALL CHARA_TEXT(53,@"「우와! 도전인가?%UNICODE(0x2764)%」","l")
				CASE 3
					CALL CHARA_TEXT(53,@"「미스터 디크는 너무 외로워 보이네,」 리젠은(는)","l")
					CALL CHARA_TEXT(52,@"「알겠다, 그를 기분 좋게 해줘야겠어%UNICODE(0x2665)%」","l")
				CASE 4
					CALL CHARA_TEXT(52,@"「너 정말 활기차구나... 테위야, 부디 %HIM_HER(MASTER)% 제대로 하자.」","l")
					CALL CHARA_TEXT(53,@"「당연하지%UNICODE(0x2764)%」","l")
				CASE 5
					CALL CHARA_TEXT(53,@"「라이젠, 너 정말 몰입했구나～」","l")
					CALL CHARA_TEXT(52,@"「음... 나를 탓할 수 있겠어?」","l")
					CALL CHARA_TEXT(53,@"「아니, 아니, 둘 다 굉장해~%UNICODE(0x2764)%」","l")
				CASE 6
					CALL CHARA_TEXT(52,@"「우리는 결국 이 과도한 리비도를 돌봐야 한다.」","l")
					CALL CHARA_TEXT(53,@"「라이젠, 정말 열정적이네~%UNICODE(0x2764)%」","l")
				CASE 7
					CALL CHARA_TEXT(53,@"「디익~ %UNICODE(0x2764)% 디이이익~ %UNICODE(0x2764)%」","l")
					CALL CHARA_TEXT(52,@"「정말 열정적이네... 나도 마찬가지야...」","l")
				CASE 8
					CALL CHARA_TEXT(52,@"「이번에는 뭔가 새로운 걸 시도해 보자, 티위.」","l")
					CALL CHARA_TEXT(53,@"「오카아~」","l")
				CASE 9
					CALL CHARA_TEXT(53,@"「라이젠, 이렇게 해보자!」","l")
					CALL CHARA_TEXT(52,@"「오? 아주 좋군.」","l")
				CASE 10
					CALL CHARA_TEXT(52,@"「제대로 하자, 티위.」","l")
					CALL CHARA_TEXT(53,@"「%HIS_HER(MASTER)%의 거기를 제대로 문질러주자!%UNICODE(0x2764)%」","l")
