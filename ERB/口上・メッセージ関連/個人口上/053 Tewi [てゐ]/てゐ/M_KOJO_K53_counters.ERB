			PRINTFORML 「Wuggle buggle nuggle huggle wuggle wuggle～」
			PRINTFORML 「Ahahaha～」
	ENDSELECT
ELSEIF GETBIT(CFLAG:53:既成事実,1) || CFLAG:53:ヤラせちゃった
