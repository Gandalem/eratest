			PRINTFORML 「Hmm～ Your body's kinda warm.」
			PRINTFORML 「Snuggle, snuggle～」
		CASE 2
			PRINTFORML 「Whatcha doing?」
			PRINTFORML 「Stay with me for a bit.」
		CASE 3
			PRINTFORML 「Stay with me for a little bit～」
			PRINTFORMDL Was Tewi always this clingy?
			IF IS_HERE(52)
				PRINTFORML 「So I can make Reisen jealous.」
				IF TALENT:52:恋人
					CALL CHARA_TEXT(52,"「Knock it off, seriously...」","l")
				ELSEIF GETBIT(CFLAG:52:既成事実,1) || CFLAG:52:ヤラせちゃった
					CALL CHARA_TEXT(52,"「Y-You'd really go that far...」","l")
				ELSE
					CALL CHARA_TEXT(52,"「Why would I be jealous...」","l")
				ENDIF
			ELSE
				PRINTFORML 「I wanna look around in your pockets.」
			ENDIF
	ENDSELECT
ENDIF
WAIT
RETURN 1

