;-------------------------------------------------
;Communication
;コミュニケーション
;-------------------------------------------------
;==================================================
;Get closer ("CHARACTER gets a little closer to you...")
;距離が近い
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_COUNTER_MESSAGECHECK_K53_1
RETURN 0

@M_KOJO_MESSAGE_COUNTER_K53_1
SELECTCASE RAND:12
	CASE 0
		IF IS_FALLEN(53)
			PRINTFORML 「Rabbits die if they're lonely.」
			PRINTFORML 「Don't let me die, %CALLNAME:MASTER%～」
		ELSE
			PRINTFORML 「Hmm? I'm not doing anything～」
			PRINTFORMDL She inches closer while wearing a suspicious smirk.
		ENDIF
	CASE 1
		PRINTFORML 「Something wrong?」
		PRINTFORMDL She's standing so close, it's hard to move.
	CASE 2
		PRINTFORML 「You're standing too close.」
		PRINTFORMDL You excuse yourself and move out of the way, but she follows you.
		PRINTFORML 「Nope, still too close.」
	CASE 3
		PRINTFORML 「Hmm?～」
		PRINTFORMDL When you look at her, she stares back with an innocent smile.
	CASE 4
		PRINTFORML 「Am I in the way?」
		PRINTFORMDL Despite asking, she makes no attempt to give you space.
	CASE 5
		PRINTFORML 「What are you thinking about?」
		PRINTFORML 「If you stand around with that look on your face, someone might be tempted to prank you～」
	CASE 6
		IF TALENT:MASTER:体型 == TALENT:53:体型 && !RAND:2
			PRINTFORML 「Hey, hey.」
			PRINTFORMDL When you turn your head to look, your cheek meets her outstretched finger.
			PRINTFORML 「Ehehehe～」
		ELSE
			PRINTFORML 「Hey, hey.」
			PRINTFORMDL When you turn your head to look, she grins at you.
			PRINTFORML 「Hi.」
		ENDIF
	CASE 7
		IF CFLAG:53:同行 ;Leading her around.
			PRINTFORML 「Hmm? I'm following like you told me to.」
		ELSE
			PRINTFORML 「Where are we going?」
			PRINTFORMDL Is she planning on following you if you go somewhere?
			PRINTFORML 「I'll pretend to and then ditch.」
		ENDIF
	CASE 8
		PRINTFORML 「Don't step on my toes.」
		PRINTFORMDL If she's worried about that, she should stand back.
	CASE 9
		PRINTFORMDL You ask Tewi what she's doing so close.
		IF TALENT:MASTER:体型 > TALENT:53:体型
			PRINTFORML 「That's relative. You're taller, so it feels closer. It'd be rude if I was farther away.」
		ELSE
			PRINTFORML 「That's relative. We're small, so we can be closer together. It'd be rude if I was farther away.」
		ENDIF
		PRINTFORMDL So as not to be rude, she stands closer until it's hard for you to move.
	CASE 10
		IF TALENT:53:恋人
			PRINTFORML 「What am I doing? I'm standing with my lover.」
			PRINTFORML 「If I don't stay by you, you might run away after all.」
		ELSE
			PRINTFORML 「What am I doing? Huh? Y-You don't want me here?」
			PRINTFORML 「D-Do... Do you not like me...? Am I just a bother to you...?」
			PRINTFORMDL Tewi looks up at you with her eyes full of tears until you're forced to accept it.
		ENDIF
	CASE 11
		PRINTFORML 「Whatcha doin'?」
		PRINTFORMDL She leans over and peers at you with an innocent expression.
	CASE 12
		PRINTFORML 「Are you having good luck today?」
		SELECTCASE TFLAG:幸運補正
			CASE IS < -4
				PRINTFORML 「...That bad, huh? Better stay close then～」
			CASE -4,-3
				PRINTFORML 「No? I can help with that...」
			CASE -1,2
				PRINTFORML 「No? Better stay close then～」
			CASE 0
				IF FLAG:おみくじ契約
					PRINTFORML 「So-so, huh? That's better than bad luck, though.」
				ELSE
					PRINTFORML 「If something good happens, you know who to thank～」
				ENDIF
			CASE 1,2
				PRINTFORML 「It'll be even better with me around～」
			CASE 3,4
				PRINTFORML 「That's because I'm here～」
			CASE IS > 4
				PRINTFORML 「That's the power of Tewi-chan～」
		ENDSELECT
ENDSELECT
WAIT
RETURN 1

;==================================================
;Gaze ("You can feel CHARACTER's glances...")
;チラ見
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_MESSAGE_COUNTER_MESSAGECHECK_K53_2
RETURN 0

@M_KOJO_MESSAGE_COUNTER_K53_2
IF TALENT:53:恋人
	IF !RAND:10 && FIRSTTIME("KissMark",0,53)
		PRINTFORMW 「A mark on your face...」
		PRINTFORMDW You feel around your cheek, trying to find what Tewi is talking about.
		PRINTFORMW 「No, a bit lower. I'll show you.」
		PRINTFORMDW Tewi \@ TALENT:MASTER:体型 > TALENT:53:体型 ? jumps # steps \@ up and plants a hard, sucking kiss on your cheek that leaves a mark.
		PRINTFORMW 「Right there～!」
		PRINTFORMDW She grins at you with her hands behind her back...
		TFLAG:キスマーク = 53
		RETURN 1
	ENDIF
	SELECTCASE RAND:5
		CASE 0
			PRINTFORML 「What am I doing? ...I'm looking at someone cute.」
			PRINTFORMDL Tewi is wearing a cute smile, herself.
		CASE 1
			IF IS_MALE(MASTER)
				IF IS_CHILD(MASTER)
					PRINTFORML 「Hmm? I'm just admiring my little boy.」
				ELSE
					PRINTFORML 「Hmm? I'm just admiring my handsome lover.」
				ENDIF
				PRINTFORMDL Tewi stares blatantly at you with a small smile.
			ELSE
				SELECTCASE TALENT:MASTER:バストサイズ
					CASE -2
						PRINTFORML 「Hmm? I'm just admiring my%COND_STR(" little",IS_CHILD(MASTER))% girl.」
					CASEELSE
						PRINTFORML 「Hmm? I'm just admiring them.」
				ENDSELECT
				PRINTFORMDL She stares blatantly at your chest.
			ENDIF
		CASE 2
			PRINTFORML 「...? I wasn't really thinking of anything.」
			PRINTFORMDL She keeps staring at you without doing anything else.
		CASE 3
			PRINTFORML 「.........」
			PRINTFORMDL She doesn't say anything, just watches you.
	ENDSELECT
ELSE
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML 「Eh? Do I look like I'm planning something?」
			PRINTFORML 「How did you know?～」
		CASE 1
			PRINTFORML 「No, I was looking at that over there.」
			PRINTFORMDL When you look, there's nothing there...
			PRINTFORML 「Eh, you just missed it～」
		CASE 2
			PRINTFORML 「You have this different look sometimes.」
			PRINTFORML 「What kind of look? ...Eh, you don't know?」
			PRINTFORML 「Then it's a secret～」
		CASE 3
			PRINTFORML 「.........」
			PRINTFORMDL She doesn't say anything, but doesn't try to hide her staring either.
	ENDSELECT
ENDIF
WAIT
RETURN 1

