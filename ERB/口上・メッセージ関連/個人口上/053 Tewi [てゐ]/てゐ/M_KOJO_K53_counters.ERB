;==================================================
;Cuddle
;身をすり寄せる
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_COUNTER_MESSAGECHECK_K53_14
RETURN 0

@M_KOJO_MESSAGE_COUNTER_K53_14
IF TALENT:53:恋人
	SELECTCASE RAND:6
		CASE 0
			PRINTFORML 「꽉 조여~」
			PRINTFORML 「귀여움으로 너를 충전할게.」
		CASE 1
			PRINTFORML 「나를 안아줘, 외로워~」
			PRINTFORMDL 테위의 작은 손이 당신을 꽉 붙잡는다.
		CASE 2
			PRINTFORML 「이것은 나의 사랑의 포옹이야~ 너에게 치유가 되고 있니?」
			PRINTFORML 「확실히 하려고 이것을 많이 할게!」
		CASE 3
			PRINTFORML 「이것이 나의 행운의 포옹이다!」
			PRINTFORML 「우리가 더 많이 안을수록, 당신은 더 운이 좋아질 거야. 기회가 있을 때 지금 충전해～!」
		CASE 4
			PRINTFORML 「꼭 안아줘, 꼭 안아줘, 포옹해줘, 꼭 안아줘～」
			PRINTFORML 「너를 죽을 때까지 꼭 안아줄 거야～」
		CASE 5
			PRINTFORML 「포근포근 아기처럼 껴안아～」
			PRINTFORML 「흔들흔들 부드럽게 꼭 안아 흔들어 흔들어～」
			PRINTFORML 「아하하하～」
	ENDSELECT
ELSEIF GETBIT(CFLAG:53:既成事実,1) || CFLAG:53:ヤラせちゃった
	PRINTFORML 「꽉 조여～」
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML 「너 좀 안아주고 싶게 생겼어, 있잖아.」
		CASE 1
			PRINTFORML 「당신의 몸은 내 거야, 전부 내 거야~」
		CASE 2
			PRINTFORML 「좀 안아주지 그래~」
		CASE 3
			PRINTFORML 「히히, 네 몸이 잡힐 때 느껴지는 게 좋아.」
	ENDSELECT
ELSE
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML 「이것은 나의 귀여움 스킨십이다!」
			PRINTFORML 「나의 귀여움 파워를 느끼고 있니?～」
		CASE 1
			PRINTFORML 「음~ 네 몸이 좀 따뜻하네.」
			PRINTFORML 「꼭 안기자~」
		CASE 2
			PRINTFORML 「뭐 하고 있어?」
			PRINTFORML 「Stay with me for a bit.」
		CASE 3
			PRINTFORML 「잠깐 나랑 있어줘～」
			PRINTFORMDL 테위는 항상 이렇게 달라붙었나?
			IF IS_HERE(52)
				PRINTFORML 「그래서 라이젠을 질투하게 만들 수 있지.」
				IF TALENT:52:恋人
					CALL CHARA_TEXT(52,"「그만 좀 해, 진심으로...」","l")
				ELSEIF GETBIT(CFLAG:52:既成事実,1) || CFLAG:52:ヤラせちゃった
					CALL CHARA_TEXT(52,"「야, 너 정말 그럴 정도로 가는구나...」","l")
				ELSE
					CALL CHARA_TEXT(52,"「내가 왜 질투를 하겠어...」","l")
				ENDIF
			ELSE
				PRINTFORML 「네 주머니 속을 둘러보고 싶어.」
			ENDIF
	ENDSELECT
ENDIF
WAIT
RETURN 1
