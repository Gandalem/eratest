; Modular ERB: 個人口上/053 Tewi [てゐ]/てゐ/M_KOJO_K53_conversations.ERB
;This file stores Tewi's regular conversation dialogue.

@K53_CONVERSATION_MESSAGE(Topic,TopicModifier,CharacterName,Counter)
;Replacement for the default train message. This is called for certain branches, or certain individual dialogues.
;The topic is randomized based on situation.
#DIM DYNAMIC Topic
#DIM DYNAMIC TopicModifier
#DIMS DYNAMIC CharacterName
#DIM DYNAMIC Counter
;Tewi's name is placed randomly at the beginning or the end of the message for variety.
VARSET LOCALS
LOCALS '= "너와 테위"
IF !RAND:2
	LOCALS '= "당신"
	LOCALS:1 '= @" 테위와 함께"
ENDIF
SIF TALENT:54:恋人 && !RAND:6
	LOCALS:2 = %SPLIT_G(@"가끔 %SPLIT_G(@"one another:each other")%과 농담을 건네며, 때때로 손을 잡고 농담한다.")%
SELECTCASE Topic
	CASE 0
		;The residents of Eientei.
		SELECTCASE TopicModifier
			CASE 0
				LOCALS:3 '= SPLIT_G(@"에이텐의 토끼들: 에이텐의 요괴 토끼들: 그녀의 동료 토끼들")
			CASE 1
				IF FLAG:なりきり == 52
					LOCALS:3 '= "너의 관계"
				ELSE
					LOCALS:3 '= "리젠"
				ENDIF
			CASE 2
				IF FLAG:なりきり == 72
					LOCALS:3 '= "너의 관계"
				ELSE
					LOCALS:3 '= "에린"
				ENDIF
			CASE 3
				IF FLAG:なりきり == 62
					LOCALS:3 '= "너의 관계"
				ELSE
					LOCALS:3 '= "카구야"
				ENDIF
			CASEELSE
				LOCALS:3 '= SPLIT_G(@"에이텐의 주민들:다른 사람들:두 분 모두 아는 사람들:에이텐의 다른 이들:에이텐 주민")
		ENDSELECT
		IF Counter
			PRINTFORMDL 테위는 너와... %SPLIT_G(@"chats about:discusses:talk about")% %LOCALS:3%로 이야기한다.
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"~에 대해 이야기하다")% %LOCALS:3%%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 6
		;Children. Unlocks after Tewi gives birth.
		IF Counter
			IF TopicModifier != -1
				PRINTFORMDL 테위가 %CharacterName%에 대해 이야기하기 시작한다.
			ELSE
				PRINTFORMDL 트위가 부모에 대해 이야기하기 시작한다.
			ENDIF
		ELSE
			IF TopicModifier != -1
				PRINTFORMDL %LOCALS%이(가) %CharacterName%%LOCALS:1%에 대해 이야기한다...
			ELSE
				PRINTFORMDL %LOCALS% %SPLIT_G(@"이야기하다:대화하다:논의하다")% %SPLIT_G(@"당신의 \@ CFLAG:53:子供人数 > 1 ? 자녀들 # 아이 \@:부모됨")%%LOCALS:1%...
			ENDIF
		ENDIF
	CASE 7
		;Interactions. Only possible while other characters are present.
		IF Counter
			PRINTFORMDL 테위 %SPLIT_G(@"talks:chats:has a chat")% 너와 그리고 %CharacterName%...
		ELSE
			PRINTFORMDL 당신과 테위는 %CharacterName%와 %SPLIT_G(@"talk:chat:have a chat")%으로 대화한다.
		ENDIF
	CASE 8
		;Hate marks.
		IF Counter
			PRINTFORMDL 테위가 당신에게 투덜거린다…
		ELSE
			PRINTFORMDL 테위 %SPLIT_G(@"turns away from you:looks away:ignores you:doesn't listen when you try to talk:gives you the cold shoulder")%...
		ENDIF
	CASE 9
		;Sullen.
		IF Counter
			PRINTFORMDL 테위가 당신에게 중얼거린다...
		ELSE
			PRINTFORMDL %SPLIT_G(@"그녀와 대화하려고 시도하지만, 티위의 응답은 모호하다.:지금은 대화해봤자 소용없을 것 같다...:티위를 만나 대화를 시도했지만 소용이 없었다.")%
		ENDIF
	CASE 10
		;Conversation failure.
		IF Counter
			PRINTFORMDL 티위가 당신에게 말을 걸려 하지만 대화는 금세 끊긴다...
		ELSE
			PRINTFORMDL 테위와 대화하려고 하지만 %SPLIT_G(@"할 말이 다 떨어졌다:그녀는 그저 듣는 척한다:어색해진다")%...
		ENDIF
	CASEELSE
		;Anything else.
		IF Counter
			PRINTFORMDL 티위 %SPLIT_G(@"chats:talks:has %SPLIT_G(@"an interesting:an amusing:a")% chat")% 너와 함께...
		ELSE
			PRINTFORMDL 함께 %LOCALS% %SPLIT_G(@"chat:talk:have %SPLIT_G(@"an interesting:an amusing:a")% chat")% %LOCALS:1%%LOCALS:2%...
		ENDIF
ENDSELECT
PRINTFORMDL
SIF !Counter
	WAIT

@K53_CONVERSATION_PEOPLE(TopicModifier,Counter)
#DIM DYNAMIC TopicModifier
#DIM DYNAMIC Counter
CALL K53_CONVERSATION_MESSAGE(0,TopicModifier,,Counter)
$TOP
SELECTCASE TopicModifier
	CASE 0
		;Other rabbits.
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「아, %SPLIT_G(@"the other day:not long ago:before:a while ago")%, 토끼들이 말하길...」
			CASE 1
				PRINTFORML 「우리 모두 당근을 좋아하지만, 항상 너무 많이 먹고 병에 걸린다.」
				PRINTFORML 「%SPLIT_G(@"그래서 우리는 재고를 철저히 관리하는 거야. 다이어트를 위해서야!: 그리고 나중에 몸이 좋아지면 또 그렇게 하지...: 그건 가끔 주는 간식일 뿐이야. 건강을 기억해!: 너 지금 다이어트 중이지, %CALLNAME:MASTER%?")%」
			CASE 2
				PRINTFORML 「그들이 %SPLIT_G(@"숲으로 우연히 들어온 인간을 속였다:스스로 사업 계획을 세웠다:숲을 가로지르는 경주를 해왔다:요즘 많은 사업을 하고 있다")%는 소리를 들었다.」
				PRINTFORML 「%SPLIT_G(@"그들은 너무 빨리 자라네... 더 독립적이 되고 있는 건지 궁금하다... 요즘은 좀 덜 게으른 것 같아... 이번엔 너무 금방 지루해하지 않을지도 모르겠어.")%」
			CASE 3
				PRINTFORML 「%SPLIT_G(@"그녀는 모찌 치는 걸 점점 잘하고 있지만, 챔피언을 이기려면 아직 갈 길이 멀다!: 그녀는 요즘 아무런 노력도 안 했어. 뭐, 내가 원망할 정도는 아니지만.: ...그래서 그녀가 그렇게 말했는데, 첫 번째 소녀가 말했지...: ...그리고 그녀는 많은 것들을 더 잘하게 됐어... 전에 봤던 사람이야, 눈치챘어?")%」
				PRINTFORMDL 테위는 활기차게 이야기하지만, 그녀가 누구에 대해 말하고 있는지 따라갈 수 없다…
		ENDSELECT
	CASE 1
		;Reisen.
		SELECTCASE RAND:4
			CASE 0
				;Your relationship with her.
				IF IS_MASTER(52)
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「우리 잘 지내잖아, 그렇지?」
							PRINTFORML 「너를 놀리기에 너무 재미있는 건 내 잘못이 아니야~」
						CASE 1
							PRINTFORML 「너는 항상 이런 순진한 표정을 하고 있어. 언제 봐도 정말 놀라워.」
							PRINTFORML 「하아! 사람들이 네가 늘 입고 다니는 장난기 가득한 팬티를 볼 수 있다면―!」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							IF K53_REISEN_WINGMAN() || GET_UWAKI_HISTORY(53,52)
								PRINTFORML 「리젠은 어떻게 지내고 있나?」
								PRINTFORML 「그녀를 조금 놀려도 괜찮아. 하지만 그 후에 상냥하게 대해주면 뭐든 용서해 줄 거야～」
							ELSE
								PRINTFORML 「라이젠이랑 잘 지내지, 응?」
								PRINTFORML 「그 여자애는 좀 겁쟁이야. 그게 오히려 놀리기 더 재밌어지잖아~」
							ENDIF
						CASE 1
							PRINTFORML 「라이젠은 언제나 이런 순진한 표정을 하고 있어. 언제 봐도 정말 놀라워.」
							IF GET_UWAKI_HISTORY(53,52)
								PRINTFORML 「하하! 그녀가 정말 어떤 종류의 것에 관심이 있는지 알고 있어―!」
							ELSE
								PRINTFORML 「하아! 그녀가 항상 입고 있는 그 못된 팬티를 보면 얼마나 좋을까―!」
							ENDIF
					ENDSELECT
				ENDIF
			CASE 1
				;Her history.
				IF IS_MASTER(52,62,72,98,99,100,110)
					;No Eientei residents or Lunarians.
					GOTO TOP
				ELSE
					SELECTCASE RAND:4
						CASE 0
							PRINTFORML 「보아하니 그녀의 이름은 달에서 누군가의 애완동물이었을 때 붙여진 모양이다.」
							PRINTFORML 「그녀가 도망쳤을 때, 그들은 다른 토끼를 데려와 똑같은 이름을 지어주었다...」
							PRINTFORML 「이렇게 쉽게 대체된다니... 그녀가 안쓰럽지 않으냐?」
						CASE 1
							PRINTFORML 「우동게인은 마스터가 그녀에게 붙여준 이름이다. 그녀는 달의 분재와 관련된 무언가가 보석을 만든다고 말한다...」
							PRINTFORML 「나는 그녀가 긴 귀가 우동처럼 생겨서 그렇게 이름을 지었다고 생각한다.」
						CASE 2
							PRINTFORML 「그녀는 순종적으로 보일지 몰라도, 사실 전에 파업한 적이 있다.」
							PRINTFORML 「만약 그녀의 부모님이 그녀를 일터로 돌아오게 설득하지 않으셨다면, 정말 큰 문제를 일으켰을지도 모른다, 아시겠죠?」
							IF IS_HERE(52)
								CALL CHARA_TEXT(52,@"「아, 그게 아니야! 나를 속였잖아!」","l")
								PRINTFORML 「그들이 정말 나타나긴 했지만.」
								CALL CHARA_TEXT(52,@"「그 부모님들은 대체 누구신 거죠?」","l")
							ELSE
								PRINTFORMDL 리젠이 달에서 온 거라면, 어떻게 그걸 했을까...?
								PRINTFORML 「알잖아, 텔레파시 같은 거?」
								PRINTFORMDL 테위는 시선을 돌린다.
							ENDIF
						CASE 3
							PRINTFORML 「라이젠은 친절함 없이 달에서 자랐다. 그녀는 연모를 한 번도 알지 못했다...」
							IF K53_REISEN_WINGMAN() || GET_UWAKI_HISTORY(53,52) == 2
								PRINTFORML 「그러니까, 네가 그녀를 행복하게 만들 책임이 있어! 알겠지?」
								PRINTFORMDL 테오리가 너에게 힘을 실어준다.
							ELSE
								PRINTFORML 「그러니까, 그녀를 괴롭혀도 괜찮다는 거네. 그녀는 익숙하잖아!」
							ENDIF
					ENDSELECT
				ENDIF
			CASE 2
				;Pranks that Tewi has pulled on her.
				IF IS_MASTER(52)
					PRINTFORML 「내가 %SPLIT_G(@"tied your ears together while you were asleep and you didn't even notice for hours?:tried to convince you that rabbits breathe fire when they get older?」\n「I made the rabbits do a flamethrower act and put spicy powder in all of the food in the house...:slipped contact lenses into your eyes while you were asleep?」\n「Your eyes turned blue and I told you that your ears would fall off and you'd turn into a human.:I ordered a delivery from every artisan in the village and gave them your name?」\n「It got pretty crowded in the lobby when they all came together...:tucked the back of your skirt into your waistband?」\n「And then you went out like that and...:dug a pit that was really, really deep?」\n「It was so deep, you had time to fly out before you hit the bottom, hehe.")%했던 때를 기억해?」
				ELSE
					PRINTFORML 「%SPLIT_G(@"그녀가 자는 동안 나는 그녀의 귀를 묶었고 그녀는 몇 시간 동안 전혀 알아차리지 못했다!: 한 번은 나이 들면 토끼들이 불을 뿜는다고 설득하려고 노력했었다.」\n「나는 토끼들에게 화염방사기 연기를 시키고 집 안의 모든 음식에 매운 가루를 넣었다...: 나는 그녀가 자는 동안 그녀의 눈에 콘택트렌즈를 몰래 넣어주곤 했다. 어떻게 했냐고 묻지 마!」\n「그녀의 눈이 파랗게 변했고 나는 그녀에게 귀가 빠지고 인간으로 변할 거라고 말했다.: 나는 마을의 모든 장인들에게 배달을 주문하고 그들에게 레이센의 이름을 알려주었다.」\n「모두 모였을 때 로비는 꽤 붐볐다...: 그녀의 치마 뒷부분을 허리춤에 넣어주는 것만 한 게 없다. 그녀는 절대, 절대로 눈치채지 못한다!」\n「어느 날 그녀가 그렇게 외출했는데...: 나는 아주아주 깊은 구덩이를 한번 파봤다!」\n「그것은 너무 깊어서 밑바닥에 닿기 전에 날아나올 시간까지 있었다, 헤헤.")%」
				ENDIF
				PRINTFORMDL %SPLIT_G(@"Tewi는 당신에게 과거의 활약에 대한 이야기를 들려준다.:당신은 Tew이가 오래된 추억을 이야기하는 것을 듣는다.:Tew이는 따뜻한 마음으로 옛 시절을 회상한다.:그녀는 오래전 장난에 대한 이야기를 해준다.")%
			CASE 3
				;Tewi's feelings towards her.
				SIF IS_MASTER(52)
					GOTO TOP
				PRINTFORML 「%SPLIT_G(@"나는 그녀가 주변에 있는 게 좋아, 분위기가 더 활기차지거든. 그녀의 반응에는 질리지 않아!」\n「아, 그리고 내 일도 대신 해줘. 정말 편리해.:그녀는 자꾸 나에게 일을 시키려고 해, 너무 짜증나...」\n「아, 얘기가 나와서 말인데, 에이전테이 주변 최고의 은신처를 알고 싶어?:그녀는 그냥 \@ IS_MASTER(72) ? 당신의 # 마스터의 \@ 수련생이기 때문에 보스처럼 말하는 걸 좋아해...」\n「그녀는 아주 온순하게 행동하지만, 사실은 알잖아...:그녀는 가족 중 한 명이니까 싫지는 않아. 하지만 그녀를 통제해야 해!」\n「안 그러면 날뛰게 될 테니까, 알잖아?")%」
		ENDSELECT
	CASE 2
		;Eirin.
		SELECTCASE RAND:2
			CASE 0
				IF IS_MASTER(72)
					PRINTFORML 「마스터, 당신은 너무 쉽게 화를 내요. 가끔은 \@ IS_ENABLED(52) ? 토끼들에게 관대해져야 해요 # 라이젠 \@」
					PRINTFORML 「농담이에요～ 헤헤.」
				ELSE
					PRINTFORML 「에린은 좋은 마스터야. 적어도 대부분의 시간에는.」
					PRINTFORML 「하지만 내가 아주 작은 장난을 치면 너무 쉽게 화를 내잖아~」
				ENDIF
			CASE 1
				IF IS_MASTER(72)
					GOTO TOP
				ELSE
					PRINTFORML 「마스터는 비밀 프로젝트가 많아, 알잖아.」
					PRINTFORML 「예를 들어, %SPLIT_G(@"her attempts at cloning \@ IS_ENABLED(52) ? Reisen # the rabbits \@ so that she can have an endless supply of test subjects...:a potion that makes you grow so big, you can reach the moon!:did you know that the rabbits are actually genetically modified super-rabbit ninja?:cultivating fruit. Not for medicinal reasons, she just likes fruit.:creating a mutant frog that transforms into a deadly monster when exposed to low temperatures. It seems she wants to release it in the lake.:cloning you... Really, she's doing it! And she won't say why...")%」
					PRINTFORMDL 테위가 그것에 대해 거짓말을 하고 있는지 알기 어렵다.
				ENDIF
		ENDSELECT
	CASE 3
		;Kaguya.
		SELECTCASE RAND:4
			CASE 0
				IF IS_MASTER(62)
					PRINTFORML 「요즘 더 자주 나오고 있네, 그렇지 않아?」
					PRINTFORML 「That's nice～ It's boring if I don't see you sometimes.」
				ELSE
					PRINTFORML 「카구야는 항상 은둔형 인간이었잖아, 알잖아?」
					PRINTFORML 「요즘 동굴에서 나오는 걸 봤지만~」
				ENDIF
			CASE 1
				IF IS_MASTER(52,61,62,72) || IS_FALLEN(53)
					GOTO TOP
				ELSE
					PRINTFORML 「이나바는 그녀가 우리에게 붙여준 이름이야. 토끼들을 말하는 거지.」
					PRINTFORML 「그녀는 우리를 다른 이름으로 부르지 않을 거야... 아마 우리가 서로 다르다는 걸 알 수 없는 것 같아.」
				ENDIF
			CASE 2
				IF IS_MASTER(62)
					PRINTFORML 「사람들은 가끔 네가 방에서 뭘 하고 있는지 물어본다.」
					PRINTFORML 「그래서 나는 그들에게 진실을 말해준다: 너는 %SPLIT_G(@"겐소쿄 정복 계획을 꾸미고 있다:사실은 은둔자이다:사실은 승려처럼 명상 중이다:천년 문제들을 해결하고 있다:우편으로 다이쇼기(dai-shogi)를 한다:밥 먹기 기록을 세우고 있다:춤 연습을 하고 있다:도둑질로 붙잡혀 숨어 지내고 있다")%!」
				ELSEIF TALENT:62:恋人 || GET_UWAKI_HISTORY(53,62)
					PRINTFORML 「카구야사마를 길들이는 데 성공했다니 놀랍군요, %CALLNAME:MASTER%.」
					PRINTFORML 「예전에는 구혼자들이 그녀와 결혼할 기회를 얻기 위해 목숨을 걸기도 했죠!」
