@K53_CONVERSATION_INTERACTION(Counter)
;Interactions with other characters present in the same location.
#DIM DYNAMIC Counter
#DIM DYNAMIC Character
#DIM DYNAMIC BeforeLineCount
SIF GET_TARGETNUM() < 2
	RETURN 0
DO
Character = TARGET:RAND(1, GET_TARGETNUM()+1)
LOOP Character == 53
BeforeLineCount = LINECOUNT
SELECTCASE Character
	;If there's a target character, display their interaction.
	CASE 1
		;Reimu.
		CALL K53_CONVERSATION_MESSAGE(7,0,CALLNAME:Character,Counter)
		IF CFLAG:53:K53C_RAPE_ASSISTANT > 0 && RAND:3
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「겨드랑이...」
					PRINTFORMDL 테위는 생각에 잠긴 표정으로 당신과 레이무 사이를 번갈아 보았다.
					CALL CHARA_TEXT([[霊夢]], "「...그만둬, 소름 끼쳐.」")
				CASE 1
					PRINTFORML 「레이무라면 몸을 얼마에 팔 거라고 생각하세요?」
					IF TALENT:1:ヤリマン
						CALL CHARA_TEXT([[霊夢]], "「응? ...공짜로 해줄게.」")
						PRINTFORML 「예상대로...」
					ELSEIF TALENT:1:愛欲
						CALL CHARA_TEXT([[霊夢]], @"「응? ...내 몸은 이미 %조사처리(CALLNAME:MASTER,"의")% 거야.」")
						PRINTFORML 「예상대로...」
					ELSE
						CALL CHARA_TEXT([[霊夢]], "「네가 암시하는 게 뭐든, 내가 화내기 전에 그만두는 게 좋을 거야.」")
						PRINTFORML 「어쩌면 그녀는 먹을 것을 위해 그렇게 할지도 모르지...」
					ENDIF
			ENDSELECT
		ELSE
			PRINTFORMDL 당신이 테위와 이야기를 나누는 동안, 레이무가 서서히 가까이 다가오는 것을 알아챈다.
			PRINTFORML 「왜 그래, 레이무? 행운을 좀 얻으려고?」
			CALL CHARA_TEXT([[霊夢]], "「아니, 난 그냥... 됐어!」")
			PRINTFORMDL 레이무는 수줍게 고개를 돌린다.
		ENDIF
	CASE 2
		;Ruukoto.
		CALL K53_CONVERSATION_MESSAGE(7,0,CALLNAME:Character,Counter)
		IF CFLAG:53:K53C_RAPE_ASSISTANT > 0 && !RAND:2
			PRINTFORML 「메이드 소녀~ 함께 %CALLNAME:MASTER%님을 모시자~」
			IF TALENT:2:ヤリマン
				CALL CHARA_TEXT([[る～こと]], "「물론이지. 여기서 할까?」")
				PRINTFORML 「조금 이따가 부탁해요~」
				PRINTFORMDL 테위가 당신을 위해 루코토에게 서비스를 예약하기 시작한다...
			ELSEIF TALENT:2:愛欲
				CALL CHARA_TEXT([[る～こと]], @"「물론이지. 공동 서비스를 위한 철저한 절차를 세우자.」")
				PRINTFORML 「참 질서정연하군...」
			ELSE
				CALL CHARA_TEXT([[る～こと]], "「...그런 무례한 말을 삼가줘.」")
			ENDIF
		ELSE
			PRINTFORML 「로봇 가정부~ 내 집안일 좀 대신 해주렴~」
			CALL CHARA_TEXT([[る～こと]], "「미안한데 지금 일정이 다 차 있어.」")
			PRINTFORMDL 루코토는 달콤한 미소로 테위의 요구를 거절한다.
			PRINTFORML 「거절당했어...」
		ENDIF
		;CASE 3
		;Kana.
		;CALL K53_CONVERSATION_MESSAGE(7,0,CALLNAME:Character,Counter)
	CASE 4
		;Mima.
		CALL K53_CONVERSATION_MESSAGE(7,0,CALLNAME:Character,Counter)
		IF CFLAG:53:K53C_RAPE_ASSISTANT > 0 && !RAND:2
			PRINTFORML 「짐작건대, 너는 미마에게 지배당하고 싶구나...」
			CALL CHARA_TEXT([[魅魔]], "「아, 내 힘을 알아봤구나?」")
			PRINTFORML 「음, 응.%UNICODE(0x2764)%」
		ELSE
			PRINTFORML 「진실을 말해라. 너는 그저 신사에서 공짜로 얻으려고 하는 거잖아, 안 그래?」
			CALL CHARA_TEXT([[魅魔]], "「...뭐, 거기 싫다고 할 정도는 아니거든.」")
		ENDIF
	CASE 5
		;Sunny.
		CALL K53_CONVERSATION_MESSAGE(7,0,CALLNAME:Character,Counter)
		IF CFLAG:53:K53C_RAPE_ASSISTANT > 0 && !RAND:2
			PRINTFORML 「써니의 우유를 맛보고 싶지 않아?」
			CALL CHARA_TEXT([[サニー]], "「뭐야? 네 거나 가져!」")
		ELSE
			CALL CHARA_TEXT([[サニー]], "「잊지 마, 우리가 제일 센 장난꾸러기들이라는 거!」")
			PRINTFORML 「잊지 않을 거야～」
		ENDIF
	CASE 6
		;Luna.
		CALL K53_CONVERSATION_MESSAGE(7,0,CALLNAME:Character,Counter)
		IF CFLAG:53:K53C_RAPE_ASSISTANT > 0 && !RAND:2
			PRINTFORML 「루나 정말 귀엽지 않아? 침대에서 괴롭히고 싶지 않아?%UNICODE(0x2764)%」
			CALL CHARA_TEXT([[ルナ]], "「어? 괴롭히지 마!」")
		ELSE
			CALL CHARA_TEXT([[ルナ]], "「저 여자... 우리 적이야!」")
			PRINTFORML 「어라, 왜?～」
		ENDIF
