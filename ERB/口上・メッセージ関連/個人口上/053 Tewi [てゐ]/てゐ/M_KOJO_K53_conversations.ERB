;This file stores Tewi's regular conversation dialogue.

@K53_CONVERSATION_MESSAGE(Topic,TopicModifier,CharacterName,Counter)
	;Replacement for the default train message. This is called for certain branches, or certain individual dialogues.
	;The topic is randomized based on situation.
#DIM DYNAMIC Topic
#DIM DYNAMIC TopicModifier
#DIMS DYNAMIC CharacterName
#DIM DYNAMIC Counter
	;Tewi's name is placed randomly at the beginning or the end of the message for variety.
VARSET LOCALS
LOCALS '= "You and Tewi"
IF !RAND:2
	LOCALS '= "You"
	LOCALS:1 '= @" with Tewi"
ENDIF
SIF TALENT:54:恋人 && !RAND:6
	LOCALS:2 = %SPLIT_G(@", occasionally flirting with %SPLIT_G(@"one another:each other")%:, sometimes flirting: while holding hands")%
SELECTCASE Topic
	CASE 0
			;The residents of Eientei.
		SELECTCASE TopicModifier
			CASE 0
				LOCALS:3 '= SPLIT_G(@"Eientei's rabbits:the youkai rabbits of Eientei:her fellow rabbits")
			CASE 1
				IF FLAG:なりきり == 52
					LOCALS:3 '= "your relationship"
				ELSE
					LOCALS:3 '= "Reisen"
				ENDIF
			CASE 2
				IF FLAG:なりきり == 72
					LOCALS:3 '= "your relationship"
				ELSE
					LOCALS:3 '= "Eirin"
				ENDIF
			CASE 3
				IF FLAG:なりきり == 62
					LOCALS:3 '= "your relationship"
				ELSE
					LOCALS:3 '= "Kaguya"
				ENDIF
			CASEELSE
				LOCALS:3 '= SPLIT_G(@"the residents of Eientei:other people:the people you both know:the others at Eientei:Eientei's residents")
		ENDSELECT
		IF Counter
			PRINTFORMDL Tewi %SPLIT_G(@"chats about:discusses:talks about")% %LOCALS:3% with you...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat about:discuss:talk about")% %LOCALS:3%%LOCALS:1%%LOCALS:2%...
		ENDIF
	CASE 6
			;Children. Unlocks after Tewi gives birth.
		IF Counter
			IF TopicModifier != -1
				PRINTFORMDL Tewi starts talking about %CharacterName%...
			ELSE
				PRINTFORMDL Tewi starts talking about parenthood...
			ENDIF
		ELSE
			IF TopicModifier != -1
				PRINTFORMDL %LOCALS% talk about %CharacterName%%LOCALS:1%...
			ELSE
				PRINTFORMDL %LOCALS% %SPLIT_G(@"talk about:chat about:discuss")% %SPLIT_G(@"your \@ CFLAG:53:子供人数 > 1 ? children # child\@:parenthood")%%LOCALS:1%...
			ENDIF
		ENDIF
	CASE 7
			;Interactions. Only possible while other characters are present.
		IF Counter
			PRINTFORMDL Tewi %SPLIT_G(@"talks:chats:has a chat")% with you and %CharacterName%...
		ELSE
			PRINTFORMDL You and Tewi %SPLIT_G(@"talk:chat:have a chat")% with %CharacterName%...
		ENDIF
	CASE 8
			;Hate marks.
		IF Counter
			PRINTFORMDL Tewi grumbles at you...
		ELSE
			PRINTFORMDL Tewi %SPLIT_G(@"turns away from you:looks away:ignores you:doesn't listen when you try to talk:gives you the cold shoulder")%...
		ENDIF
	CASE 9
			;Sullen.
		IF Counter
			PRINTFORMDL Tewi mumbles at you...
		ELSE
			PRINTFORMDL %SPLIT_G(@"Although you try to talk with her, Tewi's responses are non-committal.:It seems like talking won't do any good right now...:You try to talk with Tewi, but to no avail.")%
		ENDIF
	CASE 10
			;Conversation failure.
		IF Counter
			PRINTFORMDL Tewi tries to talk to you, but the conversation dries up quickly...
		ELSE
			PRINTFORMDL You try to talk with Tewi, but %SPLIT_G(@"you run out of things to say:she only pretends to listen:it gets awkward")%...
		ENDIF
	CASEELSE
			;Anything else.
		IF Counter
			PRINTFORMDL Tewi %SPLIT_G(@"chats:talks:has %SPLIT_G(@"an interesting:an amusing:a")% chat")% with you...
		ELSE
			PRINTFORMDL %LOCALS% %SPLIT_G(@"chat:talk:have %SPLIT_G(@"an interesting:an amusing:a")% chat")% together%LOCALS:1%%LOCALS:2%...
		ENDIF
ENDSELECT
PRINTFORMDL
SIF !Counter
	WAIT


@K53_CONVERSATION_PEOPLE(TopicModifier,Counter)
#DIM DYNAMIC TopicModifier
#DIM DYNAMIC Counter
CALL K53_CONVERSATION_MESSAGE(0,TopicModifier,,Counter)
$TOP
SELECTCASE TopicModifier
	CASE 0
			;Other rabbits.
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「Oh, %SPLIT_G(@"the other day:not long ago:before:a while ago")%, the rabbits were saying...」
			CASE 1
				PRINTFORML 「We all love carrots, but they always eat too much and get sick.」
				PRINTFORML 「%SPLIT_G(@"That's why I keep our stock under lock and key. For the sake of their diet!:Then once they get better, they do it again...:They're an occasional treat only. Remember your health!:You're watching your diet, aren't you, %CALLNAME:MASTER%?")%」
			CASE 2
				PRINTFORML 「I heard they %SPLIT_G(@"tricked a human who wandered into the forest:came up with a business scheme on their own:have been doing races across the forest:are doing a lot of business lately")%.」
				PRINTFORML 「%SPLIT_G(@"They grow up so fast...:I wonder if they're getting more independent?:I guess they're a little less lazy these days.:Maybe they won't get bored too quickly this time.")%」
			CASE 3
				PRINTFORML 「%SPLIT_G(@"She's getting better at pounding mochi, but she's got a long way to go to defeat the champion!:She hasn't done any work lately. Well, not that I blame her.:...So, she said that, but then the first girl said...:...And she's gotten better at a lot of things... You've seen her before, have you noticed?")%」
				PRINTFORMDL Tewi speaks animatedly, but you can't keep up with who she's talking about...
		ENDSELECT
	CASE 1
			;Reisen.
		SELECTCASE RAND:4
			CASE 0
					;Your relationship with her.
				IF IS_MASTER(52)
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 「We get along, right?」
							PRINTFORML 「It's not my fault you're so fun to tease～」
						CASE 1
							PRINTFORML 「You always have this innocent look. It's always so amazing.」
							PRINTFORML 「Hah! If people could only see the naughty panties you're always wearing―!」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							IF K53_REISEN_WINGMAN() || GET_UWAKI_HISTORY(53,52)
								PRINTFORML 「How are things going with Reisen?」
								PRINTFORML 「Don't be afraid to tease her a little. She'll forgive anything if you're sweet to her afterwards～」
							ELSE
								PRINTFORML 「You get along well with Reisen, right?」
								PRINTFORML 「That girl is kind of a coward. That just makes teasing her more fun～」
							ENDIF
						CASE 1
							PRINTFORML 「Reisen always has this innocent look. It's always so amazing.」
							IF GET_UWAKI_HISTORY(53,52)
								PRINTFORML 「Hah! We know what kind of stuff she's really into, though―!」
							ELSE
								PRINTFORML 「Hah! If you could only see the naughty panties she's always wearing―!」
							ENDIF
					ENDSELECT
				ENDIF
			CASE 1
					;Her history.
				IF IS_MASTER(52,62,72,98,99,100,110)
						;No Eientei residents or Lunarians.
					GOTO TOP
				ELSE
					SELECTCASE RAND:4
						CASE 0
							PRINTFORML 「Apparently, her name was given when she was someone's pet on the moon.」
							PRINTFORML 「When she ran away, they got another rabbit and named her the same thing...」
							PRINTFORML 「So easily replaced... Doesn't it make you feel sorry for her?」
						CASE 1
							PRINTFORML 「Udongein is what Master named her. She says it's something about a lunar bonsai that makes jewels...」
							PRINTFORML 「I think she just named her that because her long ears look like udon.」
						CASE 2
							PRINTFORML 「Though she might seem obedient, she's actually gone on strike before.」
							PRINTFORML 「If her parents hadn't convinced her to come back to work, she might've caused some real trouble, you know?」
							IF IS_HERE(52)
								CALL CHARA_TEXT(52,@"「Th-That's not what happened! You tricked me!」","l")
								PRINTFORML 「They really did show up, though.」
								CALL CHARA_TEXT(52,@"「Whose parents were those, anyway?」","l")
							ELSE
								PRINTFORMDL If Reisen is from the moon, how could they have done that...?
								PRINTFORML 「You know, telepathy?」
								PRINTFORMDL Tewi glances away.
							ENDIF
						CASE 3
							PRINTFORML 「Reisen grew up on the moon, without kindness. She's never known love...」
							IF K53_REISEN_WINGMAN() || GET_UWAKI_HISTORY(53,52) == 2
								PRINTFORML 「So, it's up to you to make her happy! Got it?」
								PRINTFORMDL Tewi gives you a pep talk.
							ELSE
								PRINTFORML 「So, it's fine to bully her. She's used to it!」
							ENDIF
					ENDSELECT
				ENDIF
			CASE 2
					;Pranks that Tewi has pulled on her.
				IF IS_MASTER(52)
					PRINTFORML 「Remember the time I %SPLIT_G(@"tied your ears together while you were asleep and you didn't even notice for hours?:tried to convince you that rabbits breathe fire when they get older?」\n「I made the rabbits do a flamethrower act and put spicy powder in all of the food in the house...:slipped contact lenses into your eyes while you were asleep?」\n「Your eyes turned blue and I told you that your ears would fall off and you'd turn into a human.:I ordered a delivery from every artisan in the village and gave them your name?」\n「It got pretty crowded in the lobby when they all came together...:tucked the back of your skirt into your waistband?」\n「And then you went out like that and...:dug a pit that was really, really deep?」\n「It was so deep, you had time to fly out before you hit the bottom, hehe.")%」
				ELSE
					PRINTFORML 「%SPLIT_G(@"I tied her ears together while she was asleep and she didn't even notice for hours!:One time, I tried to convince her that rabbits breathe fire when they get older.」\n「I made the rabbits do a flamethrower act and put spicy powder in all of the food in the house...:I once slipped contact lenses into her eyes while she was asleep. Don't ask me how!」\n「Her eyes turned blue and I told her that her ears would fall off and she'd turn into a human.:I once ordered a delivery from every artisan in the village and gave them Reisen's name.」\n「It got pretty crowded in the lobby when they all came together...:Nothing beats tucking the back of her skirt into her waistband. She never, ever notices!」\n「This one time, she went out like that and...:I once dug a pit thiiiiiis deep!」\n「It was so deep, she had time to fly out before she hit the bottom, hehe.")%」
				ENDIF
				PRINTFORMDL %SPLIT_G(@"Tewi weaves you a tale of past exploits.:You listen as Tewi regales you with some old memories.:Tewi fondly recalls some old times.:She tells you a story of an old prank.")%
			CASE 3
					;Tewi's feelings towards her.
				SIF IS_MASTER(52)
					GOTO TOP
				PRINTFORML 「%SPLIT_G(@"I like having her around, it makes things more lively. I never get tired of her reactions!」\n「Oh, and she does my work for me, too. It's really convenient.:She keeps trying to make me do work, it's so annoying...」\n「Oh, speaking of, do you want to know the best hiding places around Eientei?:She likes to talk like she's the boss just because she's \@ IS_MASTER(72) ? your # Master's \@ apprentice...」\n「She acts so meek, but in reality, you know...:She's part of the family, so I don't hate her. I've got to keep her in line, though!」\n「Otherwise she'll get ideas, you know?")%」
		ENDSELECT
	CASE 2
			;Eirin.
		SELECTCASE RAND:2
			CASE 0
				IF IS_MASTER(72)
					PRINTFORML 「Master, you get angry so easily. You should go easy on \@ IS_ENABLED(52) ? Reisen # the rabbits \@ sometimes.」
					PRINTFORML 「Just kidding～ Hehe.」
				ELSE
					PRINTFORML 「Eirin's a good master. At least most of the time.」
					PRINTFORML 「She gets angry so easily when I play the littlest tricks though～」
				ENDIF
			CASE 1
				IF IS_MASTER(72)
					GOTO TOP
				ELSE
					PRINTFORML 「Master has a lot of secret projects, you know.」
					PRINTFORML 「For example, %SPLIT_G(@"her attempts at cloning \@ IS_ENABLED(52) ? Reisen # the rabbits \@ so that she can have an endless supply of test subjects...:a potion that makes you grow so big, you can reach the moon!:did you know that the rabbits are actually genetically modified super-rabbit ninja?:cultivating fruit. Not for medicinal reasons, she just likes fruit.:creating a mutant frog that transforms into a deadly monster when exposed to low temperatures. It seems she wants to release it in the lake.:cloning you... Really, she's doing it! And she won't say why...")%」
					PRINTFORMDL It's hard to tell if Tewi is lying about that.
				ENDIF
		ENDSELECT
	CASE 3
			;Kaguya.
		SELECTCASE RAND:4
			CASE 0
				IF IS_MASTER(62)
					PRINTFORML 「You've been coming out more often lately, haven't you?」
					PRINTFORML 「That's nice～ It's boring if I don't see you sometimes.」
				ELSE
					PRINTFORML 「Kaguya-sama has always been a shut-in, you know?」
					PRINTFORML 「I've seen her coming out from her cave lately, though～」
				ENDIF
			CASE 1
				IF IS_MASTER(52,61,62,72) || IS_FALLEN(53)
					GOTO TOP
				ELSE
					PRINTFORML 「Inaba is a name that she gave us. The rabbits, I mean.」
					PRINTFORML 「She won't call us anything else... I think maybe she can't tell us apart.」
				ENDIF
			CASE 2
				IF IS_MASTER(62)
					PRINTFORML 「People sometimes ask me what you're doing in your room.」
					PRINTFORML 「So, I tell them the truth: You're %SPLIT_G(@"plotting the conquest of Gensokyo:actually a hermit in isolation:actually in meditation as a monk:solving the Millennium Problems:playing dai-shogi by mail:setting a record for eating rice:practicing your dance moves:in hiding because you're wanted for burglary")%!」
				ELSEIF TALENT:62:恋人 || GET_UWAKI_HISTORY(53,62)
					PRINTFORML 「It's amazing that you managed to tame Kaguya-sama, %CALLNAME:MASTER%.」
					PRINTFORML 「Back in the day, suitors would throw themselves to their deaths for the chance to marry her!」
					PRINTFORML 「Who knows― Maybe she'll ask something like that of you someday...」
				ELSE
					PRINTFORML 「What is Kaguya-sama doing all night, you ask?」
					IF !RAND:8 && !TALENT:恋人
						PRINTFORML 「Well, I'll tell you this: She won't mind if you peek in the window some night to see―...」
					ELSE
						PRINTFORML 「The truth is, she's actually %SPLIT_G(@"plotting the conquest of Gensokyo:a hermit in isolation:in meditation as a monk:solving the Millennium Problems:playing dai-shogi by mail:setting a record for eating rice:practicing her dance moves:in hiding because she's wanted for burglary")%!」
					ENDIF
				ENDIF
			CASE 3
				IF IS_MASTER(61,62,72)
					GOTO TOP
				ELSE
					PRINTFORML 「Mokou stopped by to visit Kaguya-sama again.」
					PRINTFORML 「%SPLIT_G(@"Their battles are so bloody, you should prepare an umbrella.:They kinda get along in a way, huh?:The look in her eyes was so scary...:After killing each other, they wound up eating mochi together～:I learned some new swear words...:I wish they wouldn't battle where their Danmaku might hit the rabbits.:It may not look like it, but Eientei is fireproof. Master made a chemical finish for such things!")%」
				ENDIF
		ENDSELECT
ENDSELECT

@K53_CONVERSATION_TALL_TALES(Counter)
#DIM DYNAMIC Counter
CALL K53_CONVERSATION_MESSAGE(1,,,Counter)
$TOP
SELECTCASE RAND:12
	CASE 0
		PRINTFORML 「When I need something done, I have 100 million rabbits in Gensokyo to call on―」
		IF IS_MASTER( 62, 72)
			PRINTFORML 「That's why you can count on me! ...To tell them to work for you.」
		ELSEIF K53_TSUN()
			PRINTFORML 「If you really understood that, you'd grovel in the dirt before me, too.」
		ELSEIF !RAND:2
			PRINTFORMDL Can they actually get the job done, though?
			PRINTFORML 「Sure they can! ...Usually.」
		ELSE
			PRINTFORMDL It must be hard to coordinate 100 million rabbits, you tell her.
			PRINTFORML 「Well, I mostly just grab one and throw it at the problem.」
		ENDIF
	CASE 1
		SIF IS_FALLEN(53) || IS_FALLEN(52) || IS_FALLEN(72)
			GOTO TOP
		PRINTFORML 「You know, there's a secret treasure for the taking hidden in the bamboo forest―!」
		PRINTFORML 「I'll tell you where the map is if you promise to get it for us. It's in... \@ FLAG:なりきり == 72 ? Reisen # Master \@'s panty drawer!」
	CASE 2
		PRINTFORM 「Want to know why I wear this carrot? It's
		IF (TALENT:53:ヤリマン || TALENT:53:愛欲 || TALENT:53:セフレ) && !RAND:6
			PRINTFORML  a vibrator, of course!」
		ELSE
			PRINTFORML  %SPLIT_G(@"because I like carrots, duh～:actually a bottle containing a secret serum... What does it do? That's a secret～:actually a key for a super strong weapon buried underneath Eientei!:so I can eat it when I'm hungry～:actually an ancient talisman of power from an extinct rabbit civilization that gives me the power to transform and fight!")%」
		ENDIF
	CASE 3
		PRINTFORML 「How lucky am I?」
		IF TALENT:恋人 && !RAND:6
			PRINTFORML 「I met you, right?～」
		ELSE
			PRINTFORML 「%SPLIT_G(@"Well, I'm banned from the gambling den on the mountain...:If I jump off a cliff, there's always a bird to jump off of before I hit the ground! ...And if there isn't, I'll just start flying!:I don't dodge in Danmaku, it just doesn't hit me～:Fifteen people have mistakenly put me in their last wills without knowing me! And they were humans, too!:Whenever I pull a fortune, I always get great luck!")%」
		ENDIF
	CASE 4
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「Rabbits are stronger than oni!」
				PRINTFORML 「We're sure to win because our speed is superior!」
			CASE 1
				PRINTFORML 「Rabbits are stronger than tengu!」
				PRINTFORML 「They move so fast, they probably can't see where they're going, anyway!」
			CASE 2
				PRINTFORML 「Rabbits are stronger than kappa!」
				PRINTFORML 「We've got better numbers and rabbits can finish a job, too! Usually!」
			CASE 3
				PRINTFORML 「Rabbits are stronger than foxes!」
				PRINTFORML 「The ones with up to three tails, at least!」
			CASE 4
				PRINTFORML 「Rabbits are stronger than tanuki!」
				PRINTFORML 「To prove it, I stole your wallet!」
				PRINTFORML 「...Fine, you can have it back―」
		ENDSELECT
	CASE 5,6
		PRINTFORML 「%SPLIT_G(@"The moon? Of course I can jump that high!:The roof of Eientei? I can jump that high!:Rabbits are just as good at disguises as tanuki. I could even disguise myself as you!:I can run as fast as an arrow! Shoot one and I'll chase it!:I once won a thumb wrestle with an oni.:Once, there was a clan of famous rabbit swordsmiths. I am all that remains...:I had to train hard to reach where I am. Five hundred years of rabbit school, followed by five hundred more on a mountaintop...:\@ FLAG:なりきり == 62 ? We're like family, right? # I'll have you know that Kaguya-sama considers me family. \@ That makes me a princess!")%」
		PRINTFORMDL Tewi makes a boast that's hard to take seriously.
	CASE 7,8
		PRINTFORML 「%SPLIT_G(@"\@ FLAG:なりきり == 72 ? Wasn't Eientei a militant Buddhist temple until you defeated them in martial arts? # Eientei used to be a militant Buddhist temple, until Master defeated them in a martial arts contest. It's true! \@:Know why you get lost in the bamboo forest? The bamboo stands up and wanders around, so you can't tell where you've been.:\@ FLAG:なりきり == 72 ? Reisen # Master\@ is actually a samurai. She uses an unstoppable rabbit-forged sword!:Do you know who Santa Claus is? He lives in the bamboo forest and gives \@ FLAG:なりきり == 52 ? you # Reisen\@ coal every year.:You know, the bamboo in the bamboo forest is actually the hair of a giant youkai...:Why do rabbits have red eyes? Allergies.")%」
		PRINTFORMDL Tewi tells you a pointless lie.
	CASE 9
		IF FLAG:なりきり
			GOTO TOP
		ELSE
			PRINTFORML %BREAKENG(@"「%SPLIT_G(@"The Scarlet Mist Incident? The vampire covered the sky for a hundred days and nights and the shrine maiden set out with a holy whip...:The Spring Snow Incident was really rough. The whole bamboo forest was buried under snow and we had to burn all of Reisen's clothes for warmth!:The Eternal Night Incident wasn't our fault! In fact, Eientei fought against the youkai who had stopped the night. We were the heroes of the incident! Really!:Once, a whole lot of flowers popped up everywhere. Reisen's allergies got so bad, she couldn't open her mouth without sneezing! Anyway, I went out to defeat the perpetrator...:Everything here changed when the Moriya Shrine came. They sent an army to the other shrine, with swords and spears, to take over all of Gensokyo!:One time, everything in Eientei turned into tsukumogami! It was a war between rabbits and their mochi mallets! I bravely led the troop, you see...:The Lunar Capital invaded Gensokyo once. I led my rabbits against the moon rabbits in a climactic showdown...!")%」")%
			PRINTFORMDL Tewi tells an exaggerated story.
		ENDIF
	CASE 10
		IF FLAG:なりきり
			GOTO TOP
		ELSE
			PRINTFORML 「%SPLIT_G(@"I used to be a grey rabbit, but when I saw Master punish Reisen, it turned me white with shock!:The other day, I saw the flower youkai board a UFO!:You know, when I visited the technology god at the shrine, I saw her shed her skin!:One time, I saw that human magician try to eat the mermaid...")%」
			PRINTFORMDL Something tells you that didn't happen.
		ENDIF
	CASE 11
		IF FLAG:なりきり
			GOTO TOP
		ELSE
			PRINTFORML 「%SPLIT_G(@"I've beaten the shrine maiden in Danmaku before. No, really, I have!:Did you know that Master is hundreds of millions of years old?:You know, when Reisen fled the moon, it wasn't an actual invasion. She just bolted because she was afraid of some visitors...:That tengu reporter once ran a story on a money scam I did... So I scammed her out of her money in the interview～:That inchling princess is as tricky as me. She won a river rafting championship by riding a fish!:They have some pretty wild drinking parties at the Buddhist temple. There's even a barbecue!")%」
			PRINTFORMDL Tewi's tone of voice is unusually sincere, though what she's saying still sounds like a lie.
		ENDIF
ENDSELECT

@K53_CONVERSATION_BUSINESS(Counter)
#DIM DYNAMIC Counter
CALL K53_CONVERSATION_MESSAGE(2,,,Counter)
$TOP
SELECTCASE RAND:12
	CASE 0
		IF FLAG:なりきり == 52
			PRINTFORML 「Don't want to make medicine today? I can sell you some of mine～」
		ELSE
			IF !RAND:2
				PRINTFORML 「Isn't your sweetheart being cold to you lately? The recommended product for that is right here!」
			ELSEIF TALENT:恋人
				PRINTFORML 「Hey, why don't you buy some medicine? You won't need a love potion for me, though―」
			ELSE
				PRINTFORML 「Hey, why don't you buy some medicine? I've got a special on Reisen's old panties, if you're interested―」
			ENDIF
		ENDIF
	CASE 1
		IF ITEM:兎符「開運大紋」
			PRINTFORML 「How's my Great Fortune Crest treating you?」
			PRINTFORML 「I've got lots of great items, right?～」
		ELSE
			PRINTFORML 「Wanna get a hold of something good? Here's an amulet for you: 『Great Fortune Crest』!」
			PRINTFORML 「There's a special sale right now―!」
		ENDIF
	CASE 2,3
