@M_KOJO_EVENT_K53_5(ARG,ARG:1)
;口上主はTARGET
;ARG is whatever characters arrived
;ARGに入ってきたキャラ（人数が膨大なので、自己把握自己責任で
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
IF ARG == 52
	;鈴仙が恋人
	IF TALENT:52:恋人 && !CFLAG:53:K53C_REISEN_GROUP_SEX && ABL:53:親密 > 4
		;浮気プレイ
		PRINTFORML 「어라아~」
		PRINTFORMDL 테위와 함께 있는 당신을 본 리젠은 약간 몸이 굳는다.
		CALL CHARA_TEXT([[鈴仙]], "「너희 둘 여기 뭐 하는 거야, 궁금하네?」")
	ELSE
		SELECTCASE RAND:6
			CASE 0
				PRINTFORMDW 리젠을 본 테위는 당신 뒤로 가려고 살짝 몸을 움직인다. 그녀의 눈에는 장난기 어린 반짝임이 있다...
			CASE 1
				PRINTFORML 「어라, 그녀가 나를 찾았어.」
				CALL CHARA_TEXT([[鈴仙]], @"「티위! 네가 그 %SPLIT_G(@"내 시험 혼합물을 흘린 것:방금 두드린 모찌를 먹은 것:내 팬티를 훔친 것:공주에게 그런 거짓말을 한 것:내 재킷의 앞 단추를 망가뜨린 것:나에 대한 소문을 퍼뜨린 것:그 함정 구덩이를 판 것:밀가루 함정을 설치한 것:나에 대한 그 이상한 그림을 그린 것:내 수면제를 카페인 알약으로 바꾼 것:내 실험을 망친 것:정원 전체에 구멍을 낸 것")%이잖아?!」")
				PRINTFORMDW 당신을 개의치 않고, 라이젠이 테위에게 꾸짖기 시작한다.
			CASE 2
				IF TALENT:恋人
					CALL CHARA_TEXT([[鈴仙]], "「방해하는 거야?」")
					PRINTFORMDL 라이젠은 당신과 티위 사이를 곁눈질한다.
				ELSE
					CALL CHARA_TEXT([[鈴仙]], @"「%HIM_HER(MASTER,,1)%을 괴롭히고 있는 건 아니지?」")
					PRINTFORMDL 라이젠이 테위에게 의심스러운 눈빛을 보냈다.
					PRINTFORMW 「당연하지 않아~」
				ENDIF
			CASE 3
				PRINTFORML 「아, 라이젠이군.」
				CALL CHARA_TEXT([[鈴仙]], "「...그런 반응은 뭐야?」", "w")
			CASE 4
				IF TALENT:恋人
					PRINTFORML 「리젠이다! 자연스럽게 행동해!」
				ELSE
					PRINTFORML 「리젠이다! 이제 네 차례야, %조사처리(CALLNAME:MASTER,"에게")%!」
				ENDIF
				PRINTFORMDL 라이젠은 너와 테위에게 노려본다.
				CALL CHARA_TEXT([[鈴仙]], "「거기서 무슨 꿍꿍이야?」", "w")
			CASE 5
				IF (TALENT:MASTER:動物耳 == 2) ;Bunny Ears.
					PRINTFORML 「토끼들이 모이고 있다―.」
				ELSE
					PRINTFORML 「토끼들이 당신보다 수가 많아요, %CALLNAME:MASTER%―.」
				ENDIF
				CALL CHARA_TEXT([[鈴仙]], "「이상한 소리 내지 마.」", "w")
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
