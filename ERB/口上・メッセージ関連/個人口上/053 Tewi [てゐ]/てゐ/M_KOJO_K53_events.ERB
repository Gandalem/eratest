				CASE 1
					PRINTFORMW 「잠들어야 해...」
				CASE 2
					PRINTFORMW 「피곤해...」
				CASE 3
					PRINTFORMW 「이제 잠자리에 들 거야...」
			ENDSELECT
		ENDIF
		RETURN 1
		;-------------------------------------------------
		;The character looks sleepy
		;眠そうにしている（～は眠そうにしている）
		;-------------------------------------------------
	CASE 2
		PRINTFORMDL 테위가 커다란 하품을 한다...
		RETURN 1
		;-------------------------------------------------
		;The character is asleep
		;睡眠中（～は眠っている）
		;-------------------------------------------------
