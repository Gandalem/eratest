				;記入チェック（=0, 非表示、1, 表示）
				LOCAL:1 = 0
				;-------------------------------------------------
			CASE 1
				RETURN 1
				;-------------------------------------------------
				;The character returns to their room to sleep, only to find the player having sex with another character?
