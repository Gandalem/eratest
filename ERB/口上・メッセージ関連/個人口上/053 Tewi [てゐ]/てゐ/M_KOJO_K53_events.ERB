	RETURN 1
;-------------------------------------------------
;Encountering the player while they're outside
;外出先で遭遇した
;記入チェック（=0, 非表示、1, 表示）
;-------------------------------------------------
ELSEIF ARG == 6
	GOTO GREETING
	RETURN 1
;-------------------------------------------------
;Encountering the player while they're on a date with another character
;ARG:1 is the person the player's on a date with (if you want to have custom dialogue
;for dating a specific character in front of this character, etc)
;他キャラとデート中に遭遇した
;ARG:1にデート相手
;記入チェック（=0, 非表示、1, 表示）
;-------------------------------------------------
ELSEIF ARG == 7
	IF TALENT:恋人 && !VAR_OR_DEFAULT("MORELOVER")
		PRINTFORML 「...Eh?」
		PRINTFORMDL Tewi stares at you and %CALLNAME:(ARG:1)% with wide eyes.
		PRINTFORML 「%SPLIT_G(@"So that's how it is...:I feel like playing a trick...:I see... I see...:You...:How could you...")%」
		PRINTFORMDL She mutters under her breath.
		TALENT:機嫌 = -1
	ELSEIF TALENT:恋人 && VAR_OR_DEFAULT("MORELOVER")
		PRINTFORML 「%SPLIT_G(@"Eh, you're out together...:I feel like playing a trick...:I see, I see, so you're doing that today...")%」
	ELSE
		SELECTCASE ARG:1
			CASE 1
				PRINTFORML 「Eeh―, you're with the shrine maiden?」
				PRINTFORMDL Tewi pauses for a moment, staring at the two of you.
				PRINTFORML 「...Why?」
				CALL CHARA_TEXT([[霊夢]], "「Wh-What's with that disbelieving tone?!」")
			CASE 11
				PRINTFORML 「Looks like Marisa's with another %PRINT_MALE("guy", MASTER)% today.」
				CALL CHARA_TEXT([[魔理沙]], "「Oi, don't spread lies about me!」")
			CASE 52
				IF FIRSTTIME("TewiReisenDateEncounter")
					PRINTFORML 「Eeh―? Reisen, %CALLNAME:MASTER%, you two are really finally dating?」
					CALL CHARA_TEXT([[鈴仙]], "「Don't talk like it was a foregone conclusion...」")
					PRINTFORMDL Tewi puts her hands on her cheeks and gazes with a wistful expression.
					PRINTFORML 「What are you going to name the kids?」
					CALL CHARA_TEXT([[鈴仙]], "「Stop jumping ahead of our relationship!」")
					PRINTFORMDL Reisen loses her composure, blushing furiously...
					PRINTFORML 「What are you going to write on Reisen's headstone, %CALLNAME:MASTER%?」
					CALL CHARA_TEXT([[鈴仙]], "「Too far! You're jumping too far ahead!」")
					CALL CHARA_TEXT([[鈴仙]], "「...And why am I the one who dies first?!」")
				ELSE
					PRINTDATAL
						DATAFORM 「Do your best, Reisen―!」
						DATAFORM 「You're doing great, Reisen―!」
						DATAFORM 「Don't let %HIM_HER(MASTER)% get away, Reisen―!」
						DATAFORM 「Ah, it's the lovebirds! Good luck, you two!」
					ENDDATA
					CALL CHARA_TEXT([[鈴仙]], @"「%SPLIT_G(@"I don't need you to cheer for me...:Stop cheering!:Stop drawing attention to us!:Don't you have anything better to do...?")%」")
				ENDIF
			CASE 60
				PRINTFORML 「Huh, you two look so close... I'm jealous...」
				CALL CHARA_TEXT([[パルスィ]], "「Role reversal...?」")
			CASE 61
				IF FIRSTTIME("TewiMokouDateEncounter")
					IF FLAG:なりきり == 62
						PRINTFORML 「I always knew the two of you would end up this way...」
						PRINTFORMDL Mokou flashes Tewi a dangerous look.
						CALL CHARA_TEXT([[妹紅]], "「What? You got something to say?」")
						PRINTFORML 「Enjoy your date～」
						PRINTFORMDL Tewi waves at you and Mokou, smiling brightly.
					ELSE
						PRINTFORML 「An unexpected pairing...」
						CALL CHARA_TEXT([[妹紅]], "「...What? Something wrong with me being on a date?」")
						PRINTFORML 「Nope, enjoy yourselves～」
						PRINTFORMDL Tewi waves at you and Mokou, smiling brightly.
					ENDIF
				ELSE
					PRINTFORML 「Ah, you're still together.」
					CALL CHARA_TEXT([[妹紅]], "「...Why wouldn't we be?」")
				ENDIF
			CASE 62
				IF FIRSTTIME("TewiKaguyaDateEncounter")
					IF FLAG:なりきり == 61
						PRINTFORML 「I always knew the two of you would end up this way...」
						PRINTFORMDL Kaguya tilts her head at Tewi.
						CALL CHARA_TEXT([[輝夜]], "「Hmm? Did you really?」")
						PRINTFORML 「Enjoy your date～」
						PRINTFORMDL Tewi waves at you and Kaguya, smiling brightly.
					ELSE
						PRINTFORML 「Could it be... A %PRINT_MALE("man", MASTER)% that Kaguya-sama approves of?」
						PRINTFORMDL Kaguya tilts her head at Tewi.
						CALL CHARA_TEXT([[輝夜]], "「Whatever do you mean?」")
						PRINTFORML 「Good luck, %CALLNAME:MASTER%!」
						PRINTFORMDL Tewi waves at you and Kaguya.
					ENDIF
				ELSE
					PRINTFORML 「Keep at it, %CALLNAME:MASTER%～」
					CALL CHARA_TEXT([[輝夜]], @"「Really, now, you don't have to cheer %HIM_HER(MASTER)% on...」")
				ENDIF
			CASE 72
				IF FIRSTTIME("TewiEirinDateEncounter")
					PRINTFORML 「Woah... Master actually likes someone...?」
					PRINTFORML 「Maybe she's using %HIM_HER(MASTER)% as a subject...」
					PRINTFORMDL Eirin's head pivots very slightly towards Tewi.
					CALL CHARA_TEXT([[永琳]], "「Please keep rude comments to yourself.」")
					PRINTFORMDL Despite her pleasant smile, her words feel like ice...
					PRINTFORML 「Good luck, %CALLNAME:MASTER%!」
					PRINTFORMDL Tewi waves at you as she backs away.
				ELSE
					PRINTFORML 「Don't give up, %CALLNAME:MASTER%～」
					CALL CHARA_TEXT([[永琳]], @"「Why would %HE_SHE(MASTER)% be giving up, I wonder?」")
				ENDIF
			CASEELSE
				PRINTFORML 「%SPLIT_G(@"Hmm? A date?:Ah, lovebirds～:Oh? On a date, I see...:Dating, eh...?")%」
				PRINTFORML 「%SPLIT_G(@"Good luck～:Looks like fun.:I'm jealous...:They look like they're having fun...:They're cute together...:Did you run into me on purpose for a lucky outcome?～:Maybe I can offer you a product to improve the outcome?")%」
		ENDSELECT
	ENDIF
	WAIT
	RETURN 1
