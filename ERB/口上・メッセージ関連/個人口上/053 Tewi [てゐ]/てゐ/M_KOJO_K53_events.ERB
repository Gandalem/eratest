@M_KOJO_EVENT_K53_7(ARG,ARG:1)
;口上主はTARGET
;ARGに目撃者
;--------------------------------------------------
SELECTCASE ARG:1
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The character gets embarrassed and leaves
	;情事を見られた（目撃者の馴れ合い度:低）
	;-------------------------------------------------
	CASE 1
		PRINTFORML 「아하하, 들켰네...」
		PRINTFORMDW 트위는 당황해서 얼굴을 붉히지만 부끄러워하는 것 같지는 않다.
		RETURN 1
		;-------------------------------------------------
		;The character joins the player and the other character
		;目撃者が負けじと参加（目撃者の馴れ合い度:高）
		;-------------------------------------------------
	CASE 2
		PRINTFORML 「에헤―? 나 혼자만 %HIM_HER(MASTER)%를 가졌는데!」
		PRINTFORMW 「음, 나는 지지 않을 거야!」
		SIF ARG == 52
			CFLAG:53:K53C_REISEN_GROUP_SEX ++
		RETURN 1
		;-------------------------------------------------
		;After the character and the player get walked in on, and the other character has left
		;目撃者が立ち去る
		;-------------------------------------------------
	CASE 3
		IF IS_CHILD(MASTER)
			PRINTFORMW 「...아하악! %HE_SHE(ARG,1)%이 봤어! %HE_SHE(ARG,1)%은 우리가 버릇없는 아이들이라고 생각할 거야―」
		ELSE
			PRINTFORMW 「...아악! %HE_SHE(ARG,1)%이 봤어! %조사처리(CALLNAME:MASTER,"가")% 로리콘으로 폭로될 거야―」
		ENDIF
		RETURN 1
	CASE 4
		IF ARG == 52
			PRINTFORMW 「내가 너랑 공유할 거라는 거 알잖아, 라이젠~」
			CFLAG:53:K53C_REISEN_GROUP_SEX ++
		ELSE
			PRINTFORMW 「좋아, 나도 공유할 수 있어―…」
		ENDIF
ENDSELECT
WAIT
RETURN 1
