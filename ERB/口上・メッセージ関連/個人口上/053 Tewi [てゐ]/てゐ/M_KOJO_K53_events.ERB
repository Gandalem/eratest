@M_KOJO_CHECK_K53_DAYEVENT_COND(ARGS, ARG, ARG:1)
SELECTCASE ARG
	CASE DAYEVENT_GENERAL ;initial, if the function is allowed to run at all, 0 is disallowed, 1 is allowed
		RETURN -1 ;not sure why it's fully disabled, but retained as is
		SIF MARK:反発刻印 || CFLAG:ブチギレ
			RETURN -1
		RETURN 1
		;per event
		;RETURN -1 - means disallowed, 0 - fall back to original condition, 1 - allowed
	CASE DAYEVENT_ORAL
		SIF !HAS_PENIS(MASTER) ;bj only
			RETURN -1
		SIF !TALENT:恋慕
			RETURN 0
		RETURN 0
	CASE DAYEVENT_COWGIRL, NIGHTEVENT_YOBAI
		SIF !HAS_PENIS(MASTER) ;penis only
			RETURN -1
		SIF !TALENT:恋慕
			RETURN 0
		SIF !(ABL:欲望 >= 5)
			RETURN -1
		SIF !(!TALENT:処女 && !IS_DOUTEI(MASTER)) ;must be experienced
			RETURN -1
		RETURN 1
	CASE DAYEVENT_WAKEUP
		SIF !TALENT:恋人
			RETURN -1
		RETURN 1
	CASE NIGHTEVENT_DRINK
		SIF !(ABL:奉仕精神 >= 3 && EXP:奉仕快楽経験 >= 50)
			RETURN -1
		SIF (TALENT:妊娠 || TALENT:育児中)
			RETURN -1
		SIF	CFLAG:2 >= 1500 ;allowed without love
		RETURN 1
		RETURN -1
	CASE DAYEVENT_PAIZURI, DAYEVENT_KISS, DAYEVENT_COSLEEPING, DAYEVENT_STARE, NIGHTEVENT_KISS, NIGHTEVENT_DRINK, NIGHTEVENT_SLEEPOVER
		RETURN 0 ;normal condition
	CASEELSE
		RETURN -1
ENDSELECT
RETURN 0
