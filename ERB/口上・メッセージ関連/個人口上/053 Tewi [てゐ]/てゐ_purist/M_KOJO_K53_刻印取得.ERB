;刻印取得
;-------------------------------------------

@M_KOJO_PURIST_MESSAGE_MARKCNG_K53
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORMW 
ELSEIF TFLAG:22 == 2
	PRINTFORMW 
ELSEIF TFLAG:22 == 3
	PRINTFORMW 
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORMW 
ELSEIF TFLAG:23 == 2
	PRINTFORMW 
ELSEIF TFLAG:23 == 3
	PRINTFORMW 
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 32
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 33
	PRINTFORMW 
ENDIF
;反発刻印
IF TFLAG:21 == 1
	IF CFLAG:うふふ
		PRINTFORML 「우으, 우으~~... 우으, 우으~~~...」
		PRINTFORMDL 당신에게 망신을 당한 티위의 얼굴이 새빨개진다.
		PRINTFORMDL 티위는 이내 울부짖기 시작하며, 마침내 폭발한다.
		PRINTFORML 「바보! 변태! 가서 어딘가에서 죽어버려!」
	ENDIF
	PRINTFORMW 
ELSEIF TFLAG:21 == 2
	IF CFLAG:うふふ
		PRINTFORML 「야아! 죽어버려! 날 내버려 두라고!」
	ENDIF
	PRINTFORMW 
ELSEIF TFLAG:21 == 3
	PRINTFORMW 
ENDIF
