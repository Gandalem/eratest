;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_PURIST_MESSAGE_COM_K53_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_PURIST_MESSAGE_COM_K53_300_1
RETURN RESULT

@M_KOJO_PURIST_MESSAGE_COM_K53_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TCVAR:泥酔
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「후냐아~~...」
			CASE 1
				PRINTFORML 「후우~ 후우~」
		ENDSELECT
	ELSEIF CFLAG:ブチギレ || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「계속 그렇게 하면 이나바를 네게 풀어주지...」
	ELSEIF IsHeat(TARGET)
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「음... 흐으... 뭐, 뭘 보고 있는 거야? 아무것도 아니야...」
			CASE 1
				PRINTFORML 「흐음... 뭐라고? 응? 미, 미안해. 뭐라던 거야?」
			CASE 2
				PRINTFORML 「하아... 푸와? 아-아니 듣고 있어. 좋아 계속해 봐.」
		ENDSELECT
		PRINTFORMDL 테위는 귀를 반쯤 기울인 채 당신의 말을 듣고 있다. 가끔 달콤한 한숨을 쉬거나 조용히 신음한다...
	ELSE
		;お話
		SELECTCASE RAND:4
			;身内の話
			CASE 0
				SELECTCASE RAND:4
					;イナバ
					CASE 0
						PRINTFORML 「아, 지난번에 이나바 애들이 말하길…」
						;鈴仙
					CASE 1
						PRINTFORML 「라이젠이랑 잘 지내지, 응?」
						PRINTFORML 「그 여자애는 좀 겁쟁이야. 그게 오히려 놀리기 더 재밌어지잖아~」
						;永琳
					CASE 2
						PRINTFORML 「에린은 좋은 마스터야. 적어도 대부분의 시간에는.」
						PRINTFORML 「하지만 내가 아주 작은 장난을 치면 너무 쉽게 화를 내잖아~」
						;輝夜
					CASE 3
						PRINTFORML 「카구야는 항상 은둔형 외톨이였잖아, 알지?」
						PRINTFORML 「요즘은 그녀가 동굴에서 나오는 걸 봤지만～」
				ENDSELECT
				;あることないこと
			CASE 1
				SELECTCASE RAND:4
					CASE 0
						PRINTFORML 「무언가 처리할 일이 생기면, 나는 이상현에 호출할 수 있는 이나바를 1억 명이나 가지고 있어—우사.」
						PRINTFORML 「만약 네가 그걸 진심으로 이해했다면, 나에게 무릎이라도 꿇었을 테니.」
					CASE 1
						PRINTFORML 「라이젠은 항상 이런 순진한 표정을 짓는다. 언제 봐도 정말 놀랍다.」
						PRINTFORML 「하! 그녀가 늘 입고 있는 장난기 가득한 팬티를 본다면 얼마나 좋을까-우사!」
					CASE 2
						PRINTFORML 「있잖아, 대나무 숲 속에 잡을 수 있는 비밀 보물이 숨겨져 있어ー우사!」
						PRINTFORML 「네가 우리를 위해 그걸 가져다준다면 지도가 어디 있는지 말해줄게. ...에린의 팬티 서랍 안에 있어!」
					CASE 3
						PRINTFORML 「카구야가 밤새 뭘 하는지 묻는다고?」
						PRINTFORML 「음, 이걸 말해주지. 어느 날 밤 창밖을 훔쳐보든 상관없다ー우사...」
				ENDSELECT
				;商談
			CASE 2
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「야, 약 좀 사는 게 어때? 네가 관심 있다면 레이선의 옛날 팬티 할인하고 있어-우사.」
					CASE 1
						PRINTFORML 「요즘 당신의 연인이 당신에게 차갑게 대하고 있지 않나요? 그럴 때 추천하는 제품이 바로 여기 있어요!」
					CASE 2
						PRINTFORML 「좋은 걸 얻고 싶어? 너에게 『카이운 다이몬』 목걸이를 줄게!」
						PRINTFORML 「지금 특별한 세일 중이야—우사!」
				ENDSELECT
				;あなたの話を聞く
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「후와아~... 아, 그런가요~?」
					CASE 1
						PRINTFORML 「어라? 어떻게 된 거지~?」
					CASE 2
						PRINTFORML 「그러니까 말이야~?」
				ENDSELECT
				;様子
				SELECTCASE TFLAG:193
					CASE 0
						PRINTFORMDL 티위는 편안한 자리에 앉아 발을 바람에 흔든다…
					CASE 1
						PRINTFORMDL 테위는 어린 소녀처럼 당신을 보고 웃는다...
					CASE -1
						PRINTFORMDL 테위가 당신의 이야기 한가운데서 엄청나게 하품을 한다...
				ENDSELECT
		ENDSELECT
	ENDIF
	WAIT
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_PURIST_MESSAGE_COM_K53_301
CALL M_KOJO_PURIST_MESSAGE_COM_K53_301_1
RETURN RESULT

@M_KOJO_PURIST_MESSAGE_COM_K53_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;泥酔
	IF TCVAR:泥酔
		SELECTCASE TFLAG:193
			CASE 0
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「후우... 고쿠... 고쿠...」
						PRINTFORMDL 테위는 차를 벌컥벌컥 마시며 웃는다.
					CASE 1
						PRINTFORML 「후~ 후우~!」
				ENDSELECT
			CASE 1
				PRINTFORML 「%CALLNAME:PLAYER%-씨의 차가 정말 맛있다!」
			CASE -1
				PRINTFORML 「크흡 크흡... 후우! 술 더!」
		ENDSELECT
		PRINTFORMDL 죽은 취객 티위가 차를 마신다...
		;ブチギレ
	ELSEIF CFLAG:ブチギレ
		PRINTFORML 「..................」
		PRINTFORMDL 테위는 마치 당신을 목줄로 삼으려는 것처럼 노려본다.
		PRINTFORMDL 그녀는 아무 말 없이 당신의 손에서 찻잔을 가져간다.
		;初回
	ELSEIF FIRSTTIME(301)
		PRINTFORML 「에? 이 차 어디서 구했어?... 그러니까 마시긴 할게, 그래도...」
		PRINTFORMDL 테위는 당신을 예의주시하고 있지만, 당신에게서 찻잔을 가져간다.
		;通常
	ELSE
		PRINTFORML 「나를 위해 차를 만들어 주셨어? 고마워!」
		PRINTFORMDL 테위는 짧지만 정중하게 감사하며 당신에게서 찻잔을 받는다.
		PRINTL
		SELECTCASE TFLAG:193
			CASE 0
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「음... 홀짝... 후우...」
						PRINTFORMDL 테위는 이를 악문 채 차를 마신다. 시끄럽게.
					CASE 1
						PRINTFORML 「꿀꺽... 꿀꺽... 후우―」
						PRINTFORMDL 테위가 소리 내어 차를 들이킨다.
				ENDSELECT
			CASE 1
				PRINTFORML 「음, 맛있어!」
				PRINTFORML 「하하! 마실수록 더 나아지는군...」
				PRINTFORMDL 그녀는 이상한 톤으로 그렇게 말했는데, 어쩌면 에이린을 따라 하는 것일지도 모른다...
			CASE -1
				PRINTFORML 「크윽, 잠깐만! 이것보다 더 나은 차는 없어?」
		ENDSELECT
	ENDIF
	WAIT
ENDIF
RETURN 1
