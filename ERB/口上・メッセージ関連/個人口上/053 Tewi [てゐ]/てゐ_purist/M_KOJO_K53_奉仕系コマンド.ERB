;80,手淫
;==================================================

@M_KOJO_PURIST_MESSAGE_COM_K53_80
CALL M_KOJO_PURIST_MESSAGE_COM_K53_80_1
RETURN RESULT

@M_KOJO_PURIST_MESSAGE_COM_K53_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;２４時間以上風呂に入っていない場合咎められる
		IF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 > 1440
			PRINTFORMW 「너 냄새나! 목욕은 한 번도 안 해? 이렇게 더러울 땐 절대 이런 일 못 하겠어. 가서 씻어!」
		ELSE
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		CALL K53_PURIST_AUTO_PVOICE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
