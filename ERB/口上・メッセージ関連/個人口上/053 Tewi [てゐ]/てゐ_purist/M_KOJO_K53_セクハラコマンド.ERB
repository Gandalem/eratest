;==================================================
;330,スカートめくり
;TFLAG:193(-5=拒絶（ビンタ） -3=拒絶（つねり） -1=いやがる 0=いやがる（嬉しげ） 1=受け入れ)
;TFLAG:193=1&&ABL:露出癖(5以上=人目のある場所で、自らスカートをまくり上げる 4以下=人目のある場所でめくられるさいに弱い抵抗 3以上=人目のない場所で自らスカートをまくり上げる 3未満=弱い抵抗)
;TFLAG:400(1=デート先or地底のモブが反応する)
;後ろからピラリ、ではなく、前からペラって感じ（そうじゃなかったら、めくり上げようとするのを止めて即座にビンタとか無理、めくり上げられた後にしかならないしその状況ならビンタ食らうより普通に弾幕で一発ＫＯにならないほうがおかしい
;==================================================

@M_KOJO_PURIST_MESSAGE_COM_K53_330
CALL M_KOJO_PURIST_MESSAGE_COM_K53_330_1
RETURN RESULT

@M_KOJO_PURIST_MESSAGE_COM_K53_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
VARSET LOCALS
;ふたなり以外は有り得ない
IF GETBIT(TALENT:TARGET:性別,1)
	IF BASE:勃起 >= 1000
		LOCALS += "발기 "
	ELSE
		LOCALS += "불응성 "
	ENDIF
	LOCALS += TINKO(TARGET) + ", and her "
ENDIF
IF PALAM:潤滑 > PALAMLV:4
	LOCALS += "토끼꿀로 축축하게 젖은 허벅지와 그녀의 "
ELSEIF PALAM:潤滑 > PALAMLV:2
	LOCALS += "연모의 액체가 축축한 허벅지에 묻고 그녀는 "
ENDIF
IF TALENT:体型 < 0
	LOCALS += "젊은 암캐"
ELSE
	LOCALS += "보지"
ENDIF
IF LOCAL
	IF FLAG:70
	ELSE
		SELECTCASE TFLAG:193
			CASE -5
				PRINTFORML 「꺄아아아아아악----!!」
				PRINTFORMDL 테위는 소리를 지르며 전력을 다해 당신의 뺨을 때린다.
				PRINTFORML 「로리콘! 변태! 마스터께 이거 말할 거야ーーーーーー!」
				PRINTFORMDW 그 학대를 거부하며, 테위는 토끼처럼 폴짝 도망친다.
			CASE -3
			CASE -1
			CASE 0
			CASE 1
				IF GET_TARGETNUM() == 1 && !DATE_HITOGOMI(CFLAG:PLAYER:現在位置) && !WITH_MOB()
					;デート中ヤリ部屋
					IF CHK_DATENOW(CFLAG:デート中) && CFLAG:現在位置 == OMANEKIBEYA()
						PRINTFORML 「... 딱 이번 한 번만, 이건 나의 특별한 속옷이니까... 저...저기...? 말해줘... 뭐라도...」
					ELSEIF ABL:露出癖 > 3
						IF !CFLAG:291
							PRINTFORML 「자, 이제 만족했나? %조사처리(CALLNAME:MASTER,"가")% 정말 팬티를 좋아하네... 변태 같아.」
							PRINTFORMDL 테위는 치마를 가슴까지 걷어 올려 팬티뿐만 아니라 귀여운 맨 배까지 드러냈다.
							;ノーパン
						ELSE
							PRINTFORML 「..........................................」
							PRINTFORMDL 당신을 바라보며, 테위는 치마 밑단을 들어 자신의 은밀한 곳을 드러낸다.
							PRINTFORMDL 말없이 그녀는 자신의 %LOCALS%를 과시한다.
						ENDIF
					ELSE
						IF !CFLAG:291
							PRINTFORML 「... 잠깐, 뭘 하고 있는 거지?」
							PRINTFORML 「이 팬티는 아무한테나 보여주려고 있는 게 아니야.」
							;ノーパン
						ELSE
							PRINTFORML 「음-뭐랄까, 오늘 팬티를 안 입고 싶다고 말하면 어떨까? 가상으로 말이야?」
							PRINTFORML 「알겠어? 아니, 난 그렇게 하진 않을 거야. 쌀쌀하고 감기 걸리는 거 싫거든.」
						ENDIF
						PRINTFORMDW 테위는 당신을 눈으로 응시하지만 기분 나빠하는 것 같지 않다. 
						SIF PALAM:欲情 > PALAMLV:4
							PRINTFORML 「... 그리고 난? 내가 내 %SHOW_BOTTOM(TARGET,1)%를 보여줬는데, 너는 뭘 할 거야?」
					ENDIF
				ELSE
					IF ABL:露出癖 > 5
						PRINTFORML 「나한테 그런 걸 공공장소에서 하라고? 정말이지— 변태 같아!」
						PRINTFORMDL 그녀가 그렇게 말하고 있음에도, 트위는 눈에 확실히 장난기를 담고 있었다...
					ELSE
						PRINTFORML 「그만둬... 잠깐! 여기에 사람들이 다 있잖아, 그러니까 그만해...」
						PRINTFORMDL 테위는 치마를 필사적으로 붙잡은 채 조용히 당신에게 항의한다.
						IF CFLAG:291
							PRINTFORML (아, 아슬아웠어... 지금 아래가 완전히 벌거벗겨졌으니까... 우우~~~)
						ENDIF
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
