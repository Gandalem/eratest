;310,尻を撫でる
;TFLAG:193(1=不快(TALENT:臆病なら涙目) 2&&3=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 4=されるがまま)
;CFLAG:うふふ==2&&TCVAR:20(パンツ無し顔面騎乗(70=クンニ強制 71=フェラチオ強制 72=アナル奉仕) 35=スカート内見せつけ 52=素股)
;CFLAG:うふふ==2&&TEQUIP:シックスナイン(パンツありTCVAR:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================

@M_KOJO_PURIST_MESSAGE_COM_K53_310
CALL M_KOJO_PURIST_MESSAGE_COM_K53_310_1
RETURN RESULT

@M_KOJO_PURIST_MESSAGE_COM_K53_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
	ELSEIF CFLAG:睡眠
		IF TALENT:恋慕
		ELSE
		ENDIF
	ELSE
		IF CFLAG:うふふ == 2
		ELSE
			IF EX:アナル内精液 > 500 && ABL:Ａ感覚 >= 3
				;漏らす
			ELSE
				SELECTCASE TFLAG:193
					;不快
					CASE 1
						;恥ずかしがる
					CASE 2, 3
						;されるがまま
					CASE 4
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
