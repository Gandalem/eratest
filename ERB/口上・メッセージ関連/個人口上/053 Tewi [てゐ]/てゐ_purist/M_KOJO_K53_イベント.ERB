		IF EQUIP:0
			;ぐっしょりして気持ちが悪い
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;パンツ紛失
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
