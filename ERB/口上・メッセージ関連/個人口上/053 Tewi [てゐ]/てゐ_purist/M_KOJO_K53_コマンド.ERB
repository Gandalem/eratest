;==================================================
;124,手淫する ;merged from tewi futa dialogue
;==================================================

@M_KOJO_PURIST_MESSAGE_COM_K53_124
CALL M_KOJO_PURIST_MESSAGE_COM_K53_124_1
RETURN RESULT

@M_KOJO_PURIST_MESSAGE_COM_K53_124_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「에? 내 성기를 느끼고 싶다고...?」
		PRINTFORML 「그-그만해! 나한테서 손 치라고! 그렇게 아무렇지도 않게 날 만지는 거 싫어!」
		IF TALENT:MASTER:2 >= 2
			PRINTFORML 「정말 자위하고 싶다면 그냥 자기 자신과 놀아봐!」
		ELSE
			PRINTFORML 「네가 자기 거 없다고 내 거 건드릴 권리가 생기는 건 아니잖아! 다른 사람이나 괴롭혀 보든 말든 상관없어?!」
		ENDIF
		PRINTFORML 「기다려, 그만두라고, 진심이야! ...음으...」
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"의")% 저항을 무시하고 그녀의 %TINKO(TARGET)%를 단단히 움켜쥐었다...
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		;連続
		IF PREVCOM == SELECTCOM
			PRINTFORML 「흠흠%UNICODE(0x2764)% %MOAN()%%UNICODE(0x2764)% %MOAN()%%UNICODE(0x2764)% 정말 기분 좋아%UNICODE(0x2764)% %CALLNAME:MASTER%...%UNICODE(0x2764)%」
			PRINTFORML 「내 소중한 %조사처리(CALLNAME:MASTER,"가")% 내 거 만져주니 너무 좋아%UNICODE(0x2764)% 너 완전 자위하고 있네%UNICODE(0x2764)%」
			PRINTFORML 「내 거 갖고 있어서 정말 다행이야%UNICODE(0x2764)%」
			PRINTFORML 「네가 내 걸 귀엽다고 부를 수밖에 없다는 게 정말 기뻐, 쓰다듬을 때 계속 "괜찮아, 괜찮아" 하면서 말하잖아%UNICODE(0x2764)%%UNICODE(0x2764)%」
			PRINTFORMDL 그녀의 것을 사랑스럽게 만지는 당신은 %CALLNAME:TARGET%뒤로 기대어 황홀한 미소로 쾌락에 몸을 맡긴다...
		ELSE
			PRINTFORML 「Ahn%UNICODE(0x2764)% 내 거 한 번 더 만져줄 거야?%UNICODE(0x2764)%」
			PRINTFORML 「네 수음이 너무 좋아, 부드럽고 기분 좋아. 네가 내 거 자위해 줄 때 나도 모르게 긴장이 풀려.%UNICODE(0x2764)%」
			PRINTFORML 「그러니까 어서 잡으라고%UNICODE(0x2764)% 여기 있어, 이제 쓸어내리렴%UNICODE(0x2764)%」
			PRINTFORMDL 당신이 그녀에게 줄 쾌감을 간절히 기대하며, %조사처리(CALLNAME:TARGET,"는")% 자신의 %TINKO(TARGET)%를 당신에게 내민다.
			PRINTFORMDL 그녀가 네 수음에 그렇게 매료된 사실에 시큰둥하게 미소를 지으며, 천천히 손을 그녀의 성기에 가져간다...
			RETURN 1
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「음, 있잖아... 괜찮다면... 다시 그 문지르는 거 해줬으면 좋겠어...」
		PRINTFORML 「좋았는지 물었지...」
		PRINTFORML 「...응... 솔직히, 정말... 최고로 좋았어...」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 수줍게 작은 엉덩이를 흔들고 볼이 붉어지며 당신의 수음을 애원한다...
		PRINTFORML 「저-그러니까... 해줄 거야...? %CALLNAME:MASTER%, 나를 만져주고 멋지게 만들어줬으면 정말 간절해%UNICODE(0x2764)%」
		PRINTFORMDL Tewi는 눈에 눈물을 글썽이며 당신에게 절실하게 자신의 성기를 바친다.
		PRINTFORMDL 당신은 그녀의 맥동하는 살을 어루만지기 시작하며 혼자 쓴 듯 미소 짓는다...
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「내 거 다시 만져보고 싶다고 말하는 거야... 에헤헸-」
		PRINTFORML 「내가 남자라고 생각해? 진심으로, 난 여자고 그걸 잊지 마! ...물론 나도 거기는 가지고 있지만...」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
