			BASE:TARGET:ムード += 50
		ENDIF
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 3
				PRINTFORMW 「%CALLNAME:MASTER%, 정말 식사를 즐기시는 것 같네요.」
