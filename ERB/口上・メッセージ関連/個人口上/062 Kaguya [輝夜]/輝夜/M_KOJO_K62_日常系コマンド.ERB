				CALL ASK_M("네",1 , "No" ,1)
				SELECTCASE RESULT
					CASE 0
						PRINTFORMDW 카구야는 [장난꾸러기]와 [여성혐오자]를 잃고 [순종적]과 [헌신적]을 얻었다.
