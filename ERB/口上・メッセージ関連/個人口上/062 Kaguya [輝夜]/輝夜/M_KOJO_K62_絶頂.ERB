@M_KOJO_MESSAGE_PALAMCNG_A_K62_0(ARG)
;-------------------------------------------------
;コンドーム
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		;ELSEIF GETBIT(TCVAR:62:50, 1)アナル用
	ELSEIF GETBIT(TCVAR:62:50, 1)
		CALLFORM M_KOJO_COLOR_K62
		IF ABL:膣射中毒
			PRINTFORMW
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				;ゴムハメ嫌い。
				SELECTCASE RAND:10
					CASE 9
						PRINTFORML 「%MOAN()%♥ %MOAN()%♥ 내 남편, 그렇게 놀리지 마요...♥」
						PRINTFORML
					CASE 8
						PRINTFORML 「Uu...♥」
						PRINTFORMW
					CASE 7
						PRINTFORML 「왜 그걸 입은 거야...?♥」
						PRINTFORML
					CASE 6
						PRINTFORML 「내 남편, 나 너의 맨살을 느끼고 싶어...♥」
						PRINTFORML
					CASE 5
						PRINTFORML 「콘돔을 끼고 나를 놀리지 마...♥」
						PRINTFORML
					CASE 4
						PRINTFORML 「그거 그냥 벗어보면 어때...?♥?」
						PRINTFORML
					CASE 3
						PRINTFORML 「나 안에 넣지 않으면...♥ 내 자궁이 미친 듯이 울릴 거야...♥」
						PRINTFORML
					CASE 2
						PRINTFORML 「...오♡ 내 남편, 부디 그것을 벗어줘...♥」
						PRINTFORML
					CASE 1
						PRINTFORML 「다음 건 생으로 해줄게...♥」
						PRINTFORML
					CASE 0
						PRINTFORML 「...오♥ 당신은 정말 콘돔만으로 만족할 수 있는 거예요, 내 사랑하는 남편...?」
						PRINTFORML
				ENDSELECT
				PRINTFORMDL 카구야는 잠시 숨을 고르며 정액으로 가득 찬 콘돔을 경멸의 눈빛으로 노려본다.
				PRINTFORMDL 그녀는 당신이 자기 자신이 아닌 콘돔에 넣은 것에 화가 난 것 같다.
				IF EX:膣内精液 < 1
					PRINTFORMDL 이번 세션 동안 그녀의 자궁 안에 당신의 정액이 조금도 들어가지 않았다는 사실은 그녀의 좌절감을 더욱 높인다.
					CFLAG:TARGET:溜まってる度  += 200
				ENDIF
				PRINTFORMW
			ELSE
				SELECTCASE RAND:10
					CASE 9
						PRINTFORML 「%MOAN()%...♥ %MOAN()%...♥ 왜 콘돔을 사용하는 거야...?♥」
						PRINTFORML
					CASE 8
						PRINTFORML 「너를 맨몸으로 느끼고 싶어...♥」
						PRINTFORML
					CASE 7
						PRINTFORML 「그것에 대해 걱정할 필요는 없어...♥」
						PRINTFORML
					CASE 6
						PRINTFORML 「흐응...♥ 콘돔을 끼는 게 이상한 기분이 들어, 벗어줘...♥」
						PRINTFORML
					CASE 5
						PRINTFORML 「Uu...♥」
						PRINTFORML
					CASE 4
						PRINTFORML 「왜 콘돔을 쓰는 거야...?♥」
						PRINTFORML
					CASE 3
						PRINTFORML 「그것에 대해 걱정할 필요 없어, 그러니까...♥」
						PRINTFORML
					CASE 2
						PRINTFORML 「원하는 만큼 안에서 싸도 돼...♥」
						PRINTFORML
					CASE 1
						PRINTFORML 「그럼, 다음엔 날것으로 해봐...♥」
						PRINTFORML
					CASE 0
						PRINTFORML 「흐음, 콘돔 대신에...♥」
						PRINTFORML
				ENDSELECT
				PRINTFORMDL 카구야는 네가 그녀 안에서 끝내지 않을까 봐 다소 속상해하는 것 같다.
				IF EX:膣内精液 < 1
					PRINTFORMDL 어쩌면 그녀의 자궁 속 공허함 때문일지도 모르지만, 그녀는 허벅지를 비비며 좌절감을 키워나갔다.
					CFLAG:TARGET:溜まってる度  += 100
				ENDIF
				PRINTFORMW
			ENDIF
		ELSE
			PRINTFORMW
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 「Uu...♥」
					PRINTFORML
				CASE 2
					PRINTFORML 「하아♥ 하아♥ 콘돔...♥?」
					PRINTFORML
				CASE 1
					PRINTFORML 「Nh...♥」
					PRINTFORML
				CASE 0
					PRINTFORML 「왜 콘돔을...?♥」
					PRINTFORML
			ENDSELECT
			PRINTFORMDL 그녀는 당신이 자신 대신 콘돔을 채우는 것을 더 선호하는 것 같아 속상해 보인다.
			PRINTFORMW
		ENDIF
	ENDIF
ENDIF
RETURN 1
