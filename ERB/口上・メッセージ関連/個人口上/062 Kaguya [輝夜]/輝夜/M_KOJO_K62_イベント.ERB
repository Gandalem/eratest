		CALL MUTUAL_KISS(TARGET, 1, 0)
		EXP:愛情経験 += 20
		IF CFLAG:62:1100 == 0
			PRINTFORML
			PRINTFORML
			PRINTFORML
			PRINTFORMDL 연인에게 도달하면, 카구야의 일부 특성이 바뀔 것이다.
			PRINTFORMDL (구체적으로, 그녀는 [뻔뻔함]과 [미남혐오]를 잃고 [순종적]과 [헌신적]을 얻게 된다)
			PRINTFORMDL 이 특성들이 바뀌도록 허락할 것인가?
			CALL ASK_M("네",1 , "No" ,1)
			SELECTCASE RESULT
				CASE 0
					PRINTFORMDW 카구야는 [장난꾸러기]와 [여성혐오자]를 잃고 [순종적]과 [헌신적]을 얻었다.
					CFLAG:62:性格傾向 = 4 ;custom code, trigger her intended personality change immediately
					TALENT:62:献身的 = 1
					TALENT:62:性別嗜好 = 0
					TALENT:62:応答 = 0
					TALENT:62:態度 = -1
					CFLAG:62:1100 = 1
				CASE 1
					PRINTFORMDW 그러면 아무런 변화도 일어나지 않을 것이다.
					CFLAG:62:1100 = 2
			ENDSELECT
		ELSEIF CFLAG:62:1100 == 1
			PRINTFORMDW 카구야는 [장난꾸러기]와 [여성혐오자]를 잃고 [순종적]과 [헌신적]을 얻었다.
			CFLAG:62:性格傾向 = 4 ;custom code, trigger her intended personality change immediately
			TALENT:62:献身的 = 1
			TALENT:62:性別嗜好 = 0
			TALENT:62:応答 = 0
			TALENT:62:態度 = -1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失敗
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF FIRSTTIME(1062)
			PRINTFORMDW 영원히 살아가게 될 소녀가 내뱉는 말의 의미를 당신은 완전히 이해한다.
			PRINTFORMDW 그래서 그녀에게 그렇게 쉽게 대답할 수 없고, 입조차 열지 못하고 있다.
			PRINTFORMDL 그녀는 눈을 감고 약간 안도한 듯하다. 부드러운 웃음으로 눈가를 닦는다.
			PRINTFORMW 「그냥 그것만 말해주고 싶었어. 너무 신경 쓰지 마.」
			PRINTFORMW 「오늘은 정말 즐거웠어. 다음에 또 나에게 주변을 보여줘.」
			PRINTFORMDL 그녀는 상황을 수습하려는 듯 평소 말투로 말을 건넨 후 당신에게 키스한다.
			PRINTFORMDW — 어느새, 시간의 흐름이 당신의 주변으로 정상적으로 돌아온다.
		ELSE
			PRINTFORMDW 영원히 계속 살아갈 소녀가 내뱉는 말 뒤에 숨겨진 의미를 이해한다.
			PRINTFORMDW 그래서 아무 말도 하지 않는다. 적어도 현 상태를 유지할 테니까.
			PRINTFORMW 「오늘은 매우 즐거웠어. 다음에 또 나에게 이것저것 보여줘.」
			PRINTFORMDW 카구야는 아무 일 없었다는 듯 말하며 계속 걸음을 옮겼다.
		ENDIF
		PRINTFORMDL 
		CFLAG:62:1101 = 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1
