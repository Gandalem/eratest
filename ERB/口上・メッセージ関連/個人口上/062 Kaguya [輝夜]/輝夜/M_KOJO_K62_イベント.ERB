					PRINTFORML 「%MOAN()%...%MOAN()%...」
				CASE 1
					PRINTFORMW 「%MOAN()%!」
				CASE 0
					PRINTFORMW 「아... 내 남편, 더...」
			ENDSELECT
		ELSEIF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 2
					PRINTFORMW 「만지는 것은…」
				CASE 1
					PRINTFORMW 「%MOAN()%...%MOAN()%...」
				CASE 0
					PRINTFORMW 「%MOAN()%...%MOAN()%.」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;衰弱中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「나의 남편…」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「%MOAN()%...%MOAN()%...」
		ELSE
			PRINTFORMW 「...할 수 없어...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
