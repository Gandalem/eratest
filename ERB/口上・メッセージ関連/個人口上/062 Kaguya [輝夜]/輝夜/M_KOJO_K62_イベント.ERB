@KOJO_OPTION_K62
CALL KOJO_OPTION_ITEM(@"진행에 따라 특성 변경: \@ CFLAG:62:1100 == 1 ? 활성화 # 비활성화 \@", 1, "onetime", CFLAG:62:1100)
CALL KOJO_OPTION_ITEM(@"아침/밤 이벤트 활성화", 2, "status:Enabled:Disabled", CFLAG:62:1190)
;process the input portion

@KOJO_OPTION_K62_RESULT_1
PRINTFORMDL 카구야는 [Love]를 얻기 전까지는 [Lover]가 될 수 없다. 그녀가 [Lover]가 되면, 그녀의 특성이 바뀔 것이다.
PRINTFORMDL (구체적으로, 그녀는 [Cheeky]와 [Misandrist]를 잃고 [Docile]과 [Devoted]를 얻게 된다.)
PRINTFORMDL 이 특성들이 바뀌도록 허락할 것인가? ([Lover]가 한 번 얻어지면 변경은 단 한 번만 일어난다)
CALL ASK_YN
SELECTCASE RESULT
	CASE 0
		PRINTFORMDW 대단히 감사합니다. 해당되는 경우 특성이 변경됩니다.
		CFLAG:62:1100 = 1
		IF TALENT:62:恋人 || (TALENT:62:妄信 && TALENT:MASTER:追加種族 == 4)
			CFLAG:62:性格傾向 = 4 ;custom code, trigger her intended personality change immediately
			TALENT:62:献身的 = 1
			TALENT:62:性別嗜好 = 0
			TALENT:62:応答 = 0
			TALENT:62:態度 = -1
		ENDIF
		RETURN 1
	CASE 1
		PRINTFORMDW 그러면 아무런 변화도 일어나지 않을 것이다.
		CFLAG:62:1100 = 2
		RETURN 1
ENDSELECT

@KOJO_OPTION_K62_RESULT_2
