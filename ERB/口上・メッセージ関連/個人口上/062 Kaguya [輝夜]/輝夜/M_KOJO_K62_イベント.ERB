;贈り物イベント
;==================================================

@M_KOJO_EVENT_K62_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(DISH_TASTE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	IF TALENT:62:恋人 || (TALENT:62:妄信 && TALENT:MASTER:追加種族 == 4)
		SELECTCASE RAND:4
			CASE 3
				PRINTFORMDL 
				PRINTFORML 「얼마 전에 이걸 발견하고 구매했어.」
			CASE 2
				PRINTFORMDL 
				PRINTFORMW 「네가 이런 종류의 것을 좋아할지도 모른다고 생각했어...」
			CASE 1
				PRINTFORMDL 
				PRINTFORMW 「...이것이 당신의 취향인가요? 그렇게 해주신다면 기쁠 것 같습니다.」
			CASE 0
				PRINTFORMDL 
				PRINTFORMW 「...다음에 만날 때 너에게 주려고 이걸 샀어...」
		ENDSELECT
		PRINTFORMDL 카구야는 %GIFT_NAME%를 보여주며 다소 긴장한 듯 말한다.
		PRINTFORMDL 아름다운 공주에게서 온 선물이며, 한때 귀족들에게 수많은 선물을 받았던 것이다.
		PRINTFORMDL 당신은 그녀의 머리를 쓰다듬으며 고맙다고 말하고, 그에 대한 보답으로 진심 어린 행복한 미소를 지어준다.
	ELSE
		SELECTCASE RAND:4
			CASE 3
				PRINTFORMDL 
				PRINTFORML 「그거 본 후에 며칠 전에 이걸 구매했어.」
			CASE 2
				PRINTFORMDL 
				PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 좋아하실 것 같아서 드리는 거예요.」
			CASE 1
				PRINTFORMDL 
				PRINTFORMW 「음? 마음에 들었으면 좋겠어.」
			CASE 0
				PRINTFORMDL 
				PRINTFORMW 「이걸 너에게 줄게.」
		ENDSELECT
		PRINTFORMDL 카구야가 당신에게 %GIFT_NAME%를 아무렇지도 않게 보여주지만, 그녀 역시 상당히 긴장하고 있다는 것을 알 수 있다.
		PRINTFORMDL 아름다운 공주의 선물이자 한때 많은 귀족들에게 선물 받은 적이 있는 물건이다.
		PRINTFORMDL 당신은 그녀의 머리를 쓰다듬으며 고맙다고 말했고, 그 대가로 그녀는 행복한 미소를 지어준 뒤 시선을 돌렸다.
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物を大事にする（700点以上）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	;custom, compare to Japanese
	IF STRCOUNT(SENSE, "(蓬莱の|永遠の|須臾の)")
		PRINTFORML 「...이 아이템은 나를 위해 만들어진 것 같아.」
		PRINTFORMDW 그녀는 당신이 준 %GIFT_NAME%을 응시한다.
		PRINTFORMDW 그 아이템의 모티프는 당신이 그녀를 생각하며 그것을 골랐음을 분명히 보여준다.
		IF TALENT:妄信 && TALENT:MASTER:追加種族 == 4
			PRINTFORML 「아니, 오히려 너와 나 둘 다 생각해서 말하자면...♥」
			PRINTFORMDW 그녀는 당신의 마음을 가득 채운 감정으로 천천히 당신에게 키스한다.
			;custom, compare to Japanese
			IF STRCOUNT(SENSE, "(蓬莱の|永遠の)")
				PRINTFORMDW 영원의 선물.
			ELSE
				PRINTFORMDW 이 눈부신 순간은 영원으로 새겨진다.
			ENDIF
			PRINTFORMDW 카구야가 진심에서 우러나오는 미소를 너에게 보여준다.
		ELSEIF TALENT:62:恋人
			PRINTFORML 「후후, 나의 사랑하는 남편...♥」
			PRINTFORMDW 카구야의 마음은 당신을 향한 감정으로 가득 차고, 그녀는 천천히 당신에게 입맞춤한다.
		ELSEIF TALENT:62:恋慕
			PRINTFORML 「만약 내가 당신에게 더 빠진다면...」
			PRINTFORMDW 그럼 난 어떻게 할까? 그녀는 체념의 기색을 내며 말하고, 그리고 당신에게 키스하기 시작한다.
		ELSE
			PRINTFORML 「너무 아름다워...」
			PRINTFORMDW 그리고 그녀는 예상치 못하게 당신에게 키스를 한 후, 자신의 행동에 얼굴을 붉힌다.
		ENDIF
		CFLAG:62:信頼度 += 100
		;この三種は特に恋慕未満では大きなボーナス。個人的に中々手に入らない気がする。
	ELSE
		IF TALENT:62:恋慕
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 「...후후, 정말 멋지네요.」
				CASE 2
					PRINTFORMW 「정말 아름답다...」
				CASE 1
					PRINTFORMW 「...나의 남편이야.」
				CASE 0
					PRINTFORMW 「...사랑해.」
			ENDSELECT
			PRINTFORMDW 당신을 향한 감정이 피어나면서, 카구야는 %GIFT_NAME%에게 키스를 하고 행복해하며 잠이 들었다.
		ELSE
			SELECTCASE RAND:4
				CASE 3
					PRINTFORML 「...정말 멋지네요.」
				CASE 2
					PRINTFORMW 「정말 아름답네...」
				CASE 1
					PRINTFORMW 「...당은 의외로 안목이 좋군요.」
				CASE 0
					PRINTFORMW 「...후후.」
			ENDSELECT
			PRINTFORMDW 카구야는 잠이 들면서, 떠나가는 그녀의 생각 속에 당신의 얼굴을 담고 있는 %GIFT_NAME%를 바라본다.
		ENDIF
	ENDIF
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	;上からの続きなので地文処理
	SIF STRCOUNT(SENSE, "身につける/")
		PRINTFORMDW 카구야가 %GIFT_NAME%을 액세서리로 착용하기로 한 것 같다.
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	SELECTCASE RAND:4
		CASE 3
			PRINTFORML 「어디에 장식으로 두어야 할지 궁금하네.」
		CASE 2
			PRINTFORMW 「이걸 어디에 두는 게 좋을까...?」
		CASE 1
			PRINTFORMW 「...이걸 어디에 두어야 할까...?」
		CASE 0
			PRINTFORMW 「저기 위에 표시할까 봐요.」
	ENDSELECT
	PRINTFORMDW 카구야는 어디에 %GIFT_NAME%를 진열할지 생각하며 잠이 들었다.
	RETURN 1
	;--------------------------------------------------------------------------------------------------
	;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
	;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	;姫さまを叱れる唯一の存在、永琳。
	PRINTFORMDW 이전에는
	IF TALENT:62:恋人 || (TALENT:62:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「내 남편, 그 걸 뭘 하고 있는 거예요...?」
		PRINTFORMDL 딱히 아무것도 아니에요.
	ELSE
		PRINTFORML 「그런 아이템을 가지고 뭘 하고 있는 거야...?」
	ENDIF
	PRINTFORMDW 카구야는 당신의 선물을 응시하며 혼란스러운 듯 고개를 기울이고 잠시 생각에 잠긴다.
	PRINTFORMW 「뭐 하는 거니, 카구야?」
	PRINTFORMW 「아, 에이린. 이건, 음...」
	PRINTFORMW 「네 마음대로 해도 된다고 말했지만... 또 이런 물건들을 사 온 거야?」
	PRINTFORMDW 에이린은 %GIFT_NAME%를 보며 한숨을 내쉰다.
	PRINTFORMDL 
	IF TALENT:62:恋人 || (TALENT:62:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「사실 말이야, 나의 사랑하는 남편인 에린--」
	ELSE
		PRINTFORMW 「사실은 에이린, 내가 산 게 아니야――」
	ENDIF
	PRINTFORMW 「카구야. 꾸짖으려는 건 아니지만 말해야겠어... 우리는 영원의 존재들이라는 걸 상기시켜 주려고.」
	PRINTFORMW 「그건 이해하지만...」
	PRINTFORMW 「그럼, 영원이라는 시간 동안 계속 새로운 것들을 더한다면 무슨 일이 일어나는지 분명히 알겠지? 물론, 네가 정말로 이걸 유지하고 싶다면 말이야.」
	PRINTFORMDW 카구야는 에이린의 말에 할 말을 잃었다.
	PRINTFORMDL 
	PRINTFORMW 「테위에게 주렴. 그게 네가 처리하기에 좋을 거라고 확신해.」
	IF TALENT:62:恋人 || (TALENT:62:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「우우...」
		PRINTFORMDW 그녀의 남편이 준 선물이었지만――물론 그것 없이 지낼 수 없다는 뜻이다.
		PRINTFORMDW 카구야는 체념의 기색을 내비치며 마지못해 고개를 끄덕였다.
	ELSEIF TALENT:62:恋慕
		PRINTFORML 「우으...」
		PRINTFORMDW 사랑하는 누군가에게 받은 선물이었다――하지만 물론, 그것 없이 지낼 수 없는 건 아니었다.
		PRINTFORMDW 카구야는 체념의 기색을 내비치며 고개를 끄덕였다.
	ELSE
		PRINTFORML 「하아... 네 말이 맞아, 그냥 좀 마음이 안 좋았어.」
		PRINTFORMDW 그녀에게 선물된 것이긴 했지만, 물론 그것 없이 지낼 수 없다는 건 아니지.
		PRINTFORMDW 카구야는 저항하며 고개를 끄덕였다.
	ENDIF
	RETURN 1
ENDIF
RETURN 1
;custom code, added

@M_KOJO_EVENT_K62_PANCHIRA
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;その他
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF EQUIP:スカート
			LOCALS '= SHOW_BOTTOM(TARGET,1)
		ELSEIF EQUIP:着物
			LOCALS '= SHOW_TOP(TARGET,1)
		ELSEIF EQUIP:ワンピース
			LOCALS '= SHOW_TOP(TARGET,2)
		ELSE
			LOCALS = ERROR
		ENDIF
		IF CFLAG:きょうのぱんつ == 0 || (!EQUIP:下半身下着１ && !EQUIP:下半身下着２ && !CFLAG:ただならぬ開放感ソース追加) ;going commando
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				IF GET_TARGETNUM() == 1 || ABL:露出癖 > 8
