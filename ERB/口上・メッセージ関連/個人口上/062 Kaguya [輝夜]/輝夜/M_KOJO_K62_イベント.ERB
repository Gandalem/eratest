				PRINTFORML (나의 사랑하는 남편이여, 당신도 나와 함께 시간을 보내는 것을 기억해 주었으면 좋겠어요.)
			ELSEIF TALENT:恋慕
				PRINTFORML 「...뻔뻔하군... 그래서 잡은 물고기에게 먹이를 주면 안 된다는 거야.」
				PRINTFORML (우리가 완전히 연인은 아니지만, %HE_SHE(MASTER)%은 나한테 좀 더 배려를 해줄 수 없나?)
				PRINTFORML (벌써 반 달이나 만나지 못했다니 믿을 수가 없어.)
			ENDIF
			SIF TALENT:恋慕 ;custom code, only show if there's dialogue
				PRINTFORMDW 카구야는 이불 속에서 혼자 누워 입술을 삐죽 내밀고 있다.
			;			CFLAG:62:翌日来訪 = 1
		ELSEIF ARG == 7
			SIF TALENT:恋慕 ;custom code, only show if there's dialogue
				CALL EVENTEND_TSUBUYAKI
			;会いたい病を煩う輝夜様。
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「...너무 외로워요.」
				PRINTFORML (벌써 일주일 가까이 만난 적도 없었다니.)
				PRINTFORML (제가 찾아뵙는 건 너무 무리일까요...?)
			ELSEIF TALENT:恋慕
				PRINTFORML 「...하아.」
				PRINTFORML (마지막으로 만난 건 일주일 전쯤이었지.)
				PRINTFORML (내일 한번 들러봐야 하나...? )
			ENDIF
			SIF TALENT:恋慕 ;custom code, only show if there's dialogue
				PRINTFORMDW 카구야는 자신의 이불 속에서 홀로 골똘히 생각에 잠겨 있다.
			;			CFLAG:62:翌日来訪 = 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		RETURN 1
	ENDIF
	;輝夜イベント。整合性を考えると表示は後の方が良い？
	IF CFLAG:62:1105 > 99 && TALENT:MASTER:追加種族 != 4 && TALENT:SexKnow < 5 && TALENT:妄信 != 1
		CALL EVENTEND_TSUBUYAKI
		CALL K62_I_KUSARI
	ELSEIF (DAY:2 == 3 && DAY:3 == 13)
		CALL EVENTEND_TSUBUYAKI
		CALL K62_GETTO
	ELSEIF TALENT:MASTER:性別 == 2 && CFLAG:62:1106 < 8
		IF CFLAG:62:1106 == 3 && CFLAG:62:好感度 < 20000
			;普通の人は３の恋慕で攻略終了のため確率を減らす。
			IF RAND:2 == 0
				IF MAIN_MAP == 4 && RAND:10 == 0
					CALL EVENTEND_TSUBUYAKI
					CALL K62_UDONGE
				ELSEIF MAIN_MAP != 4 && RAND:20 == 0
					CALL EVENTEND_TSUBUYAKI
					CALL K62_UDONGE
				ENDIF
			ENDIF
		ELSE
			IF MAIN_MAP == 4 && RAND:10 == 0
				CALL EVENTEND_TSUBUYAKI
				CALL K62_UDONGE
			ELSEIF MAIN_MAP != 4 && RAND:20 == 0
				CALL EVENTEND_TSUBUYAKI
				CALL K62_UDONGE
			ENDIF
		ENDIF
	ENDIF
	;ここまで
ENDIF
RETURN 1
