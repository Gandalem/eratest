;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K62_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前。ブチギレだったり、不機嫌＋あなた戦闘４以上でルナティック。不機嫌もしくは戦闘能力４以上でハード。
	;custom code, make it a bit more impactful
	LOCAL = RAND(30, 61)
	IF CFLAG:318 == 1
		HANDICAP_FIXED = LOCAL
		HANDICAP_RAND = LOCAL * ABL:戦闘能力
	ELSEIF ABL:MASTER:戦闘能力 >= 4 && TALENT:機嫌 < 0
		HANDICAP_FIXED = LOCAL
		HANDICAP_RAND = LOCAL * ABL:戦闘能力
	ELSEIF ABL:MASTER:戦闘能力 >= 4 || TALENT:機嫌 < 0
		HANDICAP_FIXED = LOCAL
		HANDICAP_RAND = 0
	ELSE
		HANDICAP_FIXED = 0
		HANDICAP_RAND = 0
	ENDIF
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF CFLAG:318 == 1
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「...알겠다, 그럼 도전이라는 거네?」
					CASE 1
						PRINTFORMW 「카구야가 진지한 모습을 보여줄 것이다.」
					CASE 2
						PRINTFORMW 「...카구야도 운동을 좀 하고 싶었다.」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「오늘은 어떤 위험도 감수하지 않겠어.」
					CASE 1
						PRINTFORMW 「나의 다섯 가지 요청이야... 그것들을 감당해 줄 수 있겠어?」
					CASE 2
						PRINTFORMW 「...좋다, 『단마쿠』 시합에 참가하자.」
				ENDSELECT
			ENDIF
			PRINTFORMDL 
			PRINTFORMW 「――신성한 보물 "눈부신 용의 탄환"!」
		ELSEIF ABL:MASTER:戦闘能力 >= 4 && TALENT:機嫌 < 0
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「…부끄럽게도 제가 주저할 수는 없겠어요, 나의 사랑스러운 남편.」
					CASE 1
						PRINTFORMW 「나의 단마쿠의 진정한 광경을 보여주겠어, 나의 사랑하는 남편.」
					CASE 2
						PRINTFORMW 「...카구야도 운동을 좀 하고 싶어 했다. 전 전력을 다해서 오겠다.」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「과거에 수많은 사람을 쓰러뜨린 나의 다섯 가지 요구사항들...」
						PRINTFORMW 「If you think you can fulfill them, then by all means make an attempt.」
					CASE 1
						PRINTFORMW 「나의 다섯 가지 요구 사항들, 네가 그걸 이행할 수 있다고 생각한다면, 마음껏 시도해 보거라.」
					CASE 2
						PRINTFORMW 「유감스럽게도 네게는 오늘 기분이 좋지 않다. 나도 참지 않을 것이다.」
				ENDSELECT
			ENDIF
			PRINTFORMDL 
			PRINTFORMW 「――신성한 보물 "눈부신 용의 탄환"!」
		ELSEIF ABL:MASTER:戦闘能力 >= 4 || TALENT:機嫌 < 0
			IF TALENT:機嫌 < 0
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「오늘은 참아낼 필요가 없을 것 같네.」
						CASE 1
							PRINTFORMW 「나의 단마쿠의 진정한 광경을 보여주겠어, 나의 사랑하는 남편.」
						CASE 2
							PRINTFORMW 「…나의 힘을 아끼는 것은 무례할 것이다. 나의 모든 힘을 사용할 것이다.」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「과거에 수많은 사람을 쓰러뜨린 나의 다섯 가지 요구사항들...」
							PRINTFORMW 「If you think you can fulfill them, then by all means make an attempt.」
						CASE 1
							PRINTFORMW 「나의 다섯 가지 요구 사항들, 네가 그걸 이행할 수 있다고 생각한다면, 마음껏 시도해 보거라.」
						CASE 2
							PRINTFORMW 「유감스럽게도 네게는 오늘 기분이 좋지 않다. 나도 참지 않을 것이다.」
					ENDSELECT
				ENDIF
			ELSE
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「...당신에게 망설일 필요가 없다는 걸 알겠어요, 나의 사랑하는 남편.」
						CASE 1
							PRINTFORMW 「나의 단마쿠의 진정한 광경을 보여주겠어, 나의 사랑하는 남편.」
						CASE 2
							PRINTFORMW 「당신에게 미안하지만, 남편. 나의 진정한 힘을 보여줄게요.」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「과거에 수많은 사람을 쓰러뜨린 나의 다섯 가지 요구사항들...」
							PRINTFORMW 「도대체 몇 개나 들어줄 수 있는 거지?」
						CASE 1
							PRINTFORMW 「후후, 나의 다섯 신성한 보물 중 몇 개를 극복할 수 있을까?」
						CASE 2
							PRINTFORMW 「난 자제할 필요가 없다는 걸 알겠군. 그럼, 단마쿠 대결을 시작해 보자.」
					ENDSELECT
				ENDIF
			ENDIF
			PRINTFORMDL 
			PRINTFORMW 「――신성한 보물 "눈부신 용의 탄환"!」
		ELSE
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「...좋아, 남편. 시합하자.」
					CASE 1
						PRINTFORMW 「카구야가 당신에게 단막을 보여주겠어요, 나의 사랑하는 남편.」
					CASE 2
						PRINTFORMW 「그럼 적당히 재미를 보죠.」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「과거에 수많은 사람을 쓰러뜨린 나의 다섯 가지 요구사항들...」
						PRINTFORMW 「도대체 몇 개나 들어줄 수 있는 거지?」
					CASE 1
						PRINTFORMW 「후후, 내 다섯 가지 부탁 중 몇 개를 들어줄 수 있겠니?」
					CASE 2
						PRINTFORMW 「몇 마리나 보게 될지 궁금하군.」
				ENDSELECT
			ENDIF
			PRINTFORMDL 
			PRINTFORMW 「――불가능한 요청 "용의 목걸이"!」
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		IF CFLAG:318 == 1
			PRINTFORMDL 너는 카구야를 정말 화나게 한 것 같다.
			PRINTFORMDL 
			PRINTFORMDW ――난이도 레벨: 광기
		ELSEIF ABL:MASTER:戦闘能力 >= 4 && TALENT:機嫌 < 0
			PRINTFORMDL 카구야는 기분이 안 좋은 것 같고, 진지해질 모양이다.
			PRINTFORMDL 
			PRINTFORMDW ――난이도 레벨: 광기
		ELSEIF ABL:MASTER:戦闘能力 >= 4
			PRINTFORMDL 카구야는 봐주지 않을 것 같았다.
			PRINTFORMDL 
			PRINTFORMDW 난이도 레벨: 하드
		ELSEIF TALENT:機嫌 < 0
			PRINTFORMDL 카구야가 짜증을 내는 듯하다.
			PRINTFORMDL 
			PRINTFORMDW 난이도 레벨: 하드
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				IF CFLAG:318 == 1
					PRINTFORML 「...Nh!!」
					PRINTFORMDL 분노한 카구야가 총에 맞고, 믿을 수 없을 정도로 좌절한 표정으로 당신을 노려본다.
					PRINTFORMW 「――신성 보물 "불교 다이아몬드"!」
				ELSEIF ABL:MASTER:戦闘能力 >= 4 && TALENT:機嫌 < 0
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「흐음... 카구야의 남편답군.」
					ELSE
						PRINTFORML 「크윽... 좋은 타격이군.」
					ENDIF
					PRINTFORMDL 카구야는 총에 맞고, 극도로 좌절한 표정으로 당신을 노려본다.
					PRINTFORMW 「――신성한 보물 "불교 다이아몬드"!」
				ELSEIF ABL:MASTER:戦闘能力 >= 4
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「...후후, 카구야의 남편답군.」
					ELSE
						PRINTFORML 「음, 잘했어.」
					ENDIF
					PRINTFORMDL 카구야는 총에 맞은 후에도 당신을 밝게 바라본다.
					PRINTFORMW 「다음은――신성한 보물 "불교 다이아몬드"이다!」
				ELSEIF TALENT:機嫌 < 0
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「카구야의 남편답게... 예상대로군.」
					ELSE
						PRINTFORML 「... 좋은 타격이네.」
					ENDIF
					PRINTFORMDL 카구야는 총에 맞고, 극도로 좌절한 표정으로 당신을 노려본다.
					PRINTFORMW 「――신성한 보물 "불교 다이아몬드"!」
				ELSE
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「후후, 내 사랑하는 남편답네.」
					ELSE
						PRINTFORML 「잘했어.」
					ENDIF
					PRINTFORMDL 카구야는 총을 맞은 후에도 당신을 밝게 바라본다.
					PRINTFORMW 「다음은――불가능한 요청 "부처의 돌 그릇"이다!」
				ENDIF
			CASE 2
				IF CFLAG:318 == 1
					PRINTFORML 「～!!」
					PRINTFORMDL 분노한 카구야는 두 번째 공격을 맞고 엄청난 좌절감을 담아 당신을 노려본다.
					IF RAND:2 == 0
						PRINTFORMW 「――신성한 보물 "살라만더 실드"!」
					ELSE
						PRINTFORMW 「――신성한 보물 "생명의 샘 무한!"」
					ENDIF
				ELSEIF ABL:MASTER:戦闘能力 >= 4 && TALENT:機嫌 < 0
					PRINTFORML 「으윽...」
					PRINTFORMDL 카구야는 맞고 깜짝 놀라 당신을 노려본다.
					IF RAND:2 == 0
						PRINTFORMW 「――신성한 보물 "살라만더 실드"!」
					ELSE
						PRINTFORMW 「――신성한 보물 "생명의 샘 무한!"」
					ENDIF
				ELSEIF ABL:MASTER:戦闘能力 >= 4
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「이것은 아직 끝나지 않았다.」
					ELSE
						PRINTFORML 「흥, 멋진 사격이군...!」
					ENDIF
					PRINTFORMDL 카구야는 맞았음에도 꽤 행복해 보인다.
					IF RAND:2 == 0
						PRINTFORMW 「――신성한 보물 "살라만더 실드"!」
					ELSE
						PRINTFORMW 「――신성한 보물 "생명의 샘 무한!"」
					ENDIF
				ELSEIF TALENT:機嫌 < 0
					PRINTFORML 「Nh...?!」
					PRINTFORMDL 카구야는 힘을 아끼지 않았음에도 또 맞은 것에 충격을 받았다.
					IF RAND:2 == 0
						PRINTFORMW 「――신성한 보물 "살라만더 실드"!」
					ELSE
						PRINTFORMW 「――신성한 보물 "생명의 샘 무한!"」
					ENDIF
				ELSE
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「후훗, 그럼 다음은――」
					ELSE
						PRINTFORML 「잘했어. 다음은――」
					ENDIF
					PRINTFORMDL 카구야는 처음에 예상했던 것보다 더 많은 피격 수를 기록한 채 당신을 밝게 바라본다.
					IF RAND:2 == 0
						PRINTFORMW 「――불가능한 요청 "화염쥐의 로브"!」
					ELSE
						PRINTFORMW 「――불가능한 요청 "삼키는 소라껍데기"!」
					ENDIF
				ENDIF
			CASE 1
				IF CFLAG:318 == 1
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「더 이상 참지 않겠다!!」
					ELSE
						PRINTFORML 「이것이 나의 관용의 한계다...!!」
					ENDIF
					PRINTFORMDL 분노한 카구야는 모퉁이에 몰렸고, 얼굴은 울분으로 붉어져 있었다.
					PRINTFORMW 「――신성한 보물 "후라이의 보석 가지"!」
				ELSEIF ABL:MASTER:戦闘能力 >= 4 && TALENT:機嫌 < 0
					PRINTFORML 「다음 타격은...!」
					PRINTFORMDL 만전의 카구야는 구석으로 몰려, 당황한 표정으로 당신을 바라본다.
					PRINTFORMW 「――신성 보물 "후라이의 보주 가지"!」
				ELSEIF ABL:MASTER:戦闘能力 >= 4
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「흥, 다음 건 마지막이 될 거야.」
					ELSE
						PRINTFORML 「흥, 다음 건 마지막이 될 거야.」
					ENDIF
					PRINTFORMDL 카구야는 자신을 몰아붙이고 있음에도 구석으로 몰렸다는 사실에 놀란다.
					PRINTFORMW 「――신성한 보물 "후라이의 보주 가지"!」
				ELSEIF TALENT:機嫌 < 0
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「응, 내 남편...!」
					ELSE
						PRINTFORML 「뭐야, 너는 왜 그렇게...?!」
					ENDIF
					PRINTFORMDL 카구야는 자신을 몰아붙여 구석으로 몰린 것에 놀란다, 비록 물러서지 않았음에도.
					PRINTFORMW 「――신성한 보물 "후라이의 유희 가지"!」
				ELSE
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「잘했어, 다음이 마지막이야.」
					ELSE
						PRINTFORML 「수고했다. 준비해라.」
					ENDIF
					PRINTFORMDL 카구야는 예상보다 더 많은 피격을 받은 채 즐거운 듯 당신을 바라본다.
					PRINTFORMW 「――불가능한 요청 "호라이의 탄막 분기"이다!」
				ENDIF
			CASE 0
				IF CFLAG:318 == 1
					PRINTFORMW 「우웁...!」
				ELSE
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「하아... 후후, 재미있었어.」
					ELSE
						PRINTFORML 「하아... 뭐, 꽤 재미있었지.」
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		IF CFLAG:318 == 1
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「흥, 그런 단마쿠는 통하지 않아!」
			ELSE
