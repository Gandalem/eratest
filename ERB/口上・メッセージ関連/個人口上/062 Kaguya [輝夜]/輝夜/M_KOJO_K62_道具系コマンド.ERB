;==================================================
;50,ゴム装着
;==================================================

@M_KOJO_MESSAGE_COM_K62_50
CALL M_KOJO_MESSAGE_COM_K62_50_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K62_50_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF !TEQUIP:PLAYER:コンドーム ;for equip only
		RETURN 0
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF FLAG:70
	ELSEIF ABL:膣射中毒
		PRINTFORML
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			;ゴムハメ嫌いな輝夜様。
			SELECTCASE RAND:10
				CASE 9
					PRINTFORML 「내 남편, 당신은 그런 걸 하지 말아줬으면 좋겠어...」
					PRINTFORML
				CASE 8
					PRINTFORML 「내 남편, 컨돔을 사용할 거야...?」
					PRINTFORMW
				CASE 7
					PRINTFORML 「왜 그런 걸 끼고 있는 거야...?」
					PRINTFORML
				CASE 6
					PRINTFORML 「...고무 같은 느낌은 원치 않아, 내 안에 당신을 느끼고 싶어, 나의 사랑하는 남편아.」
					PRINTFORML
				CASE 5
					PRINTFORML 「...이거 카구야를 위한 일종의 부정 연기인가?」
					PRINTFORML
				CASE 4
					PRINTFORML 「내 남편, 내 자궁에 직접 싸줬으면 해...」
					PRINTFORML
				CASE 3
					PRINTFORML 「내 남편, 정말로 네 정액을 기다리게 할 거야...?」
					PRINTFORML
				CASE 2
					PRINTFORML 「여보, 그런 걸 쓰면 기분 안 좋아질 거야...」
					PRINTFORML
				CASE 1
					PRINTFORML 「카구야를 모욕하려는 거냐...?」
					PRINTFORML
				CASE 0
					PRINTFORML 「나의 남편, 카구야 안에서 직접 느끼는 대신 콘돔으로 기분 좋게 하고 싶은 거야...?」
					PRINTFORML
			ENDSELECT
			PRINTFORMDL 카구야는 네가 콘돔을 쓰는 모습을 보고 얼굴을 찡그렸다.
			PRINTFORMW
		ELSE
			SELECTCASE RAND:8
				CASE 7
					PRINTFORML 「...흥.」
					PRINTFORML
				CASE 6
					PRINTFORML 「나는 저런 것들이 싫어...」
					PRINTFORML
				CASE 5
					PRINTFORML 「나를 모욕하는 건가?」
					PRINTFORML
				CASE 4
					PRINTFORML 「......좋아.」
					PRINTFORML
				CASE 3
					PRINTFORML 「으윽... 저건...」
					PRINTFORML
				CASE 2
					PRINTFORML 「흥... 결국 그걸 사용할 거였군?」
					PRINTFORML
				CASE 1
					PRINTFORML 「...콘돔을?」
					PRINTFORML
				CASE 0
					PRINTFORML 「...콘돔을 사용할 건가요?」
					PRINTFORML
			ENDSELECT
			PRINTFORMDL 카구야는 네가 콘돔을 쓰는 모습을 보고 얼굴을 찡그렸다.
			PRINTFORMW
		ENDIF
	ELSEIF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMDL 카구야는 당신의 %TINKO(PLAYER)%에 붙은 콘돔을 경멸하며 노려본다.
		PRINTFORMW
	ENDIF
ENDIF
RETURN 1
