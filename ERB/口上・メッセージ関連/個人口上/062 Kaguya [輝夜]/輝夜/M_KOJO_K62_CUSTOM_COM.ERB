@M_KOJO_MESSAGE_CUSTOM_SCOM_K62_5
CALL M_KOJO_MESSAGE_CUSTOM_SCOM_K62_5_1

@M_KOJO_MESSAGE_CUSTOM_SCOM_K62_5_1
#DIM C_TARGET
#DIM V_TARGET
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	V_TARGET = MASTER_POSE(SET_V,SET_P,0)
	C_TARGET = MASTER_POSE(SET_C,SET_M,0)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
		RETURN 1
	ELSE
		IF V_TARGET == TARGET
			CALL M_KOJO_MESSAGE_COM_K62_65_1
			CALL M_KOJO_COLOR_K62
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				SELECTCASE C_TARGET
					CASE [[永琳]] ;eirin
						PRINTFORML 「남편아, 에이린도 기분 좋게 해줘♥」
					CASE [[鈴仙]], [[てゐ]] ;reisen, tewi
						PRINTFORML 「%CALLNAME:C_TARGET%는 작은 보상을 받을 자격이 있지 않나요?」
					CASE [[妹紅]] ;mokou
						PRINTFORML 「모코에 대해서는 걱정하지 마라. 그저 카구야의 속을 즐기도록 해라.」
					CASEELSE
						PRINTFORML 「그렇게 보니 귀엽네, %CALLNAME:C_TARGET% 씨.」
				ENDSELECT
			ELSE
				SELECTCASE C_TARGET
					CASE [[永琳]] ;eirin
						PRINTFORML 「너도 이걸 즐기고 있니, 에이린?」
					CASE [[鈴仙]], [[てゐ]] ;reisen, tewi
						PRINTFORML 「가끔은 이 정도 괜찮을 것이다.」
					CASE [[妹紅]] ;mokou
						PRINTFORML 「내가 모코우와 함께 이런 일을 하게 될 거라고 상상하다니...」
					CASEELSE
						PRINTFORML 「%CALLNAME:C_TARGET%」의 주스가 맛있다니 즐거우신가요, %CALLNAME:MASTER%?
				ENDSELECT
			ENDIF
		ELSE
			CALL M_KOJO_MESSAGE_COM_K62_1_1
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				SELECTCASE V_TARGET
					CASE [[永琳]] ;eirin
						PRINTFORML 「내 남편이 당신 안에 깊숙이 박아 넣을 때 즐거워, 에린?」
					CASE [[鈴仙]], [[てゐ]] ;reisen, tewi
						PRINTFORML 「%CALLNAME:V_TARGET%는 걱정하지 마, 내 남편, 마음껏 거칠게 해도 돼.」
					CASE [[妹紅]] ;mokou
						PRINTFORMDL 카구야가 모코 앞에서 당신에게 지배력을 보이려는 듯 얼굴을 세게 밀어붙였다.
					CASEELSE
						PRINTFORML 「남편의 성기는 꽤 멋지네요, 그렇죠, %CALLNAME:V_TARGET%?」
				ENDSELECT
			ELSE
				SELECTCASE V_TARGET
					CASE [[永琳]] ;eirin
						PRINTFORML 「그렇게 보니 정말 사랑스럽구나, 에이린.」
					CASE [[鈴仙]], [[てゐ]] ;reisen, tewi
						PRINTFORML 「와라, %조사처리(CALLNAME:MASTER,"와")% 더 많은 재미를 보자.」
					CASE [[妹紅]] ;mokou
						PRINTFORML 「이런 일을 모코우와 함께 하게 될 거라고 상상하다니.」
					CASEELSE
						PRINTFORML 「%CALLNAME:V_TARGET%의 속을 꽤 즐기는 것 같군요, %CALLNAME:MASTER%.」
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

