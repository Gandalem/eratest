@M_KOJO_SUCCESS_CUSTOM_COM_K62_8
;成否判定
;TFLAG:192(-2=強制失敗(注、非コマンド終了）、-1＝強制失敗、0=COM依存、1=強制成功or大成功(注、睡眠薬アイスティーは眠気を感じていると飲まない)
CALL M_KOJO_COLOR_K62
TFLAG:192 = 0
IF TFLAG:194 == 0 ;general check
	;TFLAG:192 = -2 ;refuse to wear any cosplay outfit
ELSE
	IF TFLAG:194 == 161 ;Mokou's outfit
		IF !TALENT:恋慕
			PRINTFORML 「절대 안 돼. 네가 무슨 모욕적인 놀이를 생각하는지는 모르겠지만, 난 이거 입을 수 없어.」
			TFLAG:192 = -2 ;refuse to wear
		ENDIF
	ENDIF
ENDIF
