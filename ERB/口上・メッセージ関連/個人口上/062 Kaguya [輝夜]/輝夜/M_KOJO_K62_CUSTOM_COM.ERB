@M_KOJO_MESSAGE_CUSTOM_COM_K62_8
CALL M_KOJO_MESSAGE_CUSTOM_COM_K62_8_1

@M_KOJO_MESSAGE_CUSTOM_COM_K62_8_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME("C8")
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
		RETURN 1
	ELSE
		IF TFLAG:193 == 0
			IF TFLAG:194 == 0
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORML 「그렇게 멋있어 보였지만, 나의 남편아, 카구야는 네가 평상복을 입었을 때의 모습도 좋아해.」
					PRINTFORMDL 카구야는 당신이 옷을 다시 입는 것을 보며 미소 지었다.
				ELSE
					PRINTFORML 「벌써 끝난 거야?」
					PRINTFORML 「좀 아쉽네, 그거 입으니까 괜찮아 보이긴 했어.」
				ENDIF
			ELSEIF TFLAG:194 == 162
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORML 「에이, 카구야처럼?」
				ELSE
					PRINTFORML 「왜 그 특별한 복장이죠?」
				ENDIF
				PRINTFORMDL 카구야는 당신이 자신처럼 분장한 것에 대해 약간 어리둥절해 보인다.
			ELSE
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORML 「무엇을 입든, 당신은 언제나 멋져 보인다.」
					PRINTFORMDL 카구야는 네가 의상을 입는 것을 보며 미소 짓는다. 
				ELSE
					PRINTFORML 「꽤 잘 어울리는 것 같군요.」
				ENDIF
			ENDIF
		ELSE
			SELECTCASE TFLAG:194
				;special cases for eirin's outfit, reisen's outfit, mokou's outfit, hecatia's outfit, maid's outfit, etc.
				CASE 0
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「이건 재미있었지만, 결국 카구야는 자기 옷을 선호한다.」
					ELSE
						PRINTFORML 「그래, 결국 이게 가장 편한 거니까.」
					ENDIF
				CASE 4, 51, 102, 115, 203, 216
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「오늘은 메이드인가?」
						PRINTFORML 「그럼 "남편" 대신 "마스터"라고 부르는 게 더 좋을까?」
					ELSE
						PRINTFORML 「메이드 복이라고?」
						PRINTFORML 「후후, 그럼 당신을 모시도록 하겠어요, "마스터".」
					ENDIF
				CASE 101, 131
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「카구야에게 신사 계집소 복장을 입히고 싶다고?」
						PRINTFORML 「후후, 그럼 신들을 기리는 이 중요한 의식을 시작해 보자.」
					ELSE
						PRINTFORML 「신사 계집 옷이라고?」
						PRINTFORML 「이게 뭐가 마음에 드는 거야? 겨드랑이가 드러난 게 좋으신가?」
					ENDIF
				CASE 50, 56 ;nurse
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「그러니까 카구야가 당신을 돌봐주길 바라는 건가요, 내 남편?」
						PRINTFORML 「특별히 많은 관심이 필요한 부분이 하나 있는 것 같네요♥」
					ELSE
						PRINTFORML 「간호사 놀이 좀 해 볼까, 오늘은?」
						PRINTFORML 「좋아, 그럼 내가 %조사처리(CALLNAME:MASTER,"를")% 아주 잘 돌봐줄게.」
					ENDIF
				CASE 16 ;inaba
					PRINTFORML 「후후, 이나바 사람들은 귀엽지 않아?」
				CASE 62, 213
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「저런 지옥의 여신님을 말하는 거야?」
						PRINTFORML 「이런 화려한 옷이 마음에 들어, 내 남편?」
					ELSE
						PRINTFORML 「저 지옥의 여신 옷이요?」
						PRINTFORML 「좀 지나치게 화려하지 않나요?」
					ENDIF
					IF EQUIP:上半身下着１
						EQUIP:上半身下着１ = 0 ;take off bra
						PRINTFORMDL 카구야는 헤카티아의 옷으로 갈아입으면서 브라를 벗었다.
						IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
							PRINTFORML 「후후, 하나 없으니까 더 보기 좋지 않아?」
						ELSE
							PRINTFORML 「음, 이걸 입으려면 이렇게 하는 게 낫겠지?」
						ENDIF
					ENDIF
				CASE 172
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「카구야가 에이린처럼 옷을 입기를 원해?」
						PRINTFORMDL 카구야는 즐겁게 에이린의 복장을 입었다.
						PRINTFORML 「그럼 검사를 시작할까, 내 남편?」
						PRINTFORML 「카구야가 당신 몸 구석구석을 탐험해 줄 거야♥」
					ELSE
						PRINTFORML 「에이린이라니?」
						PRINTFORMDL 카구야는 망설이며 에이린의 옷을 입는다.
					ENDIF
				CASE 161
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「남편이 원하는 것이라면...」
						PRINTFORMDL 카구야는 다소 언짢은 표정으로 목옥의 옷을 입는다.
					ELSE
						PRINTFORML 「왜 하필 그녀지?!」
						PRINTFORMDL 카구야는 망설이며 목옥의 옷을 입는다.
					ENDIF
				CASE 152, 153
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「%CALLNAME:(TFLAG:194-100)%은(는) 나의 남편을 좋아하니?」
						PRINTFORML 「그럼 토끼들이 가장 잘하는 것을 하자, 그렇지 않겠어?」
					ELSE
						PRINTFORML (그는 %CALLNAME:(TFLAG:194-100)%을(를) 선호하는가?)
						PRINTFORML (그렇다면 내가 얼마나 더 나은 존재인지 보여줘야겠군...)
						PRINTFORMDL 카구야는 결연한 표정으로 %CALLNAME:(TFLAG:194-100)%의 옷을 입힌다.
					ENDIF
				CASEELSE
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORML 「후훗, 이것으로 재미있게 놀아볼까?」
						PRINTFORMDL 카구야는 얼굴에 미소를 띠고 서둘러 의상을 입는다.
					ELSE
						PRINTFORML 「이걸 입으라는 거야?」
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
