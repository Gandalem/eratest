; Modular ERB: 個人口上/062 Kaguya [輝夜]/輝夜/M_KOJO_K62_MARRIAGE.ERB
;custom, dialogue and checks for marriage-related content

@M_KOJO_SUCCESS_CUSTOM_COM_K62_11
IF TALENT:妄信 && TALENT:MASTER:追加種族 == 4 ;yandere mode always succeeds
	TFLAG:192 = 1
ELSE
	TFLAG:192 = 0
ENDIF

@M_KOJO_MESSAGE_CUSTOM_COM_K62_11
IF TFLAG:193 == 0
	;despite already calling the player her husband, she is still somewhat uncertain about formally marrying the player due to her immortality
	PRINTFORML 「Eh? Ah... Um...」
	PRINTFORMDL 당신이 카구야에게 반지를 들어 보이자, 그녀는 어떻게 응답해야 할지 확신하지 못하고 괴로운 듯 반응한다.
	PRINTFORMDW 그녀는 땅을 보며 응답하면서 조금 진정한다.
	PRINTFORML 「죄송해요, 제 남편 %CALLNAME:MASTER%. 아직 이럴 준비가 안 됐어요.」
	PRINTFORMDW 당신이 그녀를 바라보자, 카구야의 눈에 슬픈 기색이 보였다. 어쩌면 그녀는 끝에 자신을 기다리는 것을 알기에, 당신에게 더 깊이 마음을 줄까 두려워하는 것일지도 모른다.
ELSE
	IF TALENT:妄信 && TALENT:MASTER:追加種族 == 4
		PRINTFORML 「음? 반지라고?」
		PRINTFORMW 「이게 정말 필요할까, 내 남편? 결국 우리는 이것보다 훨씬 영원한 유대로 이미 연결되어 있잖아.」
		PRINTFORML 「뭐, 솔직히 카구야도 자신의 사랑하는 남편을 얼마나 사랑하는지 모두에게 보여주고 싶어 해.」
		PRINTFORML 「응. 기꺼이 받을게.」
		PRINTFORMDW 그렇게 말하며 카구야가 손을 내밀자 당신은 부드럽게 반지를 그녀의 손가락에 끼워준다.
		PRINTFORML 「후후. 이 반지가 우리의 사랑보다 훨씬 먼저 사라지겠지만, 받아 기쁘구나.」
		PRINTFORML 「당장 결혼식을 계획하자. 카구야가 자신의 사랑하는 남편에게 속해 있음을 모두에게 알리자.」
		PRINTFORMDW 얼굴에 환한 미소를 띤 채, 카구야는 당신을 끌어안고, 이전에 알지 못했던 따스함이 당신의 가슴을 채운다.
	ELSE
		PRINTFORML 「Ah.」
		PRINTFORMDL 잠시 망설인 후, 카구야는 당신의 제안을 열렬히 받아들인다.
		PRINTFORML 「네, 물론이죠, 남편.」
		PRINTFORMDW 당신이 조심스럽게 그녀의 손가락에 반지를 끼우자 카구야는 소중한 미소를 보인다.
		PRINTFORML 「후후. 고마워요, 남편. 지금 말하니 훨씬 더 기분이 좋네요.」
		PRINTFORML 「카구야는 이 반지를 에이린과 다른 사람들에게 보여줄 생각에 참 못 기다리겠어요. 정말 놀랄 거예요.」
		PRINTFORMDW 당신은 이제 약혼녀와 새로운 종류의 행복으로 데이트를 계속한다.
	ENDIF
ENDIF
RETURN 1

@M_KOJO_EVENT_K62_WEDDING_PREPARATIONS(ARGS,ARG,ARG:1)
SELECTCASE ARGS
	CASE "TYPE"
		IF VARS_OR_DEFAULT("WEDDING_TYPE") != "" ;type already chosen
		ELSE
			PRINTFORML 「제 남편분, 괜찮으시다면 카구야가 이것을 맡아도 될까요?」
			PRINTFORML 「에전에서 저희 결혼식을 올리고 모두가 카구야의 행복을 지켜봐 주시면 더할 나위 없이 좋을 것 같습니다.」
		ENDIF
	CASE "SIZE"
		PRINTFORML 「아, 모두가 들어갈 공간이 충분한지 확인해야겠어.」
		PRINTFORML 「물론 에린과 레이스, 그리고 테위는 초대해야 하고, 레이무와 마리사도 잊으면 안 되겠지.」
		PRINTFORML 「아, 이나바 일행까지 다 맞출 수 있는지 확인해야 해, 게다가-」
		PRINTFORMDL 카구야가 결혼식에 오고 싶어 하는 사람들을 계속 나열하자, 당신은 그녀에게 조금 자제하고 예산을 생각해보라고 촉구한다.
		PRINTFORMDL 하지만 그녀의 아름다운 얼굴에 슬픔의 기색이 보이는 순간, 당신은 결국 포기하며 최선을 다하겠다고 말하고 그녀의 미소가 돌아온다.
		PRINTFORML 「고마워요, 남편. 우리의 인생에서 가장 멋진 날로 만들어요.」
	CASE "DATE"
	CASE "GUESTS"
ENDSELECT

@M_KOJO_EVENT_K62_CUSTOM_WEDDING(ARGS,ARG,ARG:1)
#DIM DYNAMIC GUEST_COUNT
IF EXISTVAR("WEDDING_GUESTS")
	FOR LOCAL, 0, CHARANUM
	SIF GETVAR(@"WEDDING_GUESTS:{LOCAL}")
		GUEST_COUNT++
	NEXT
ENDIF
CALL OKIGAE(MASTER, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "ウェディングスーツセット"))
CALL OKIGAE([[輝夜]], OBJNAME_TO_ID([[輝夜]], "GET", "衣装セット", "ウェディングセット"))
PRINTFORMDW 당신이 도착하자, 여러 마리의 토끼들이 분주하게 마지막 준비를 서두르고 있는 것을 본다.
PRINTFORMDL 라이젠은 당신을 발견하고는 재빨리 대기 장소로 안내한다.
CALL SPTALK, [[鈴仙]], "通常", 0, "「The princess should be ready soon. You can just wait here until the ceremony begins.」", 1
PRINTFORMDW 그렇다고 말하긴 했지만, 레이스는 토끼들이 노력하는 동안 그들을 감독하려고 다시 도망친다.
PRINTFORMDL 레이스가 시야에서 사라지자, 테위는 의무를 분명히 회피한 채 은밀하게 방으로 들어간다.
CALL SPTALK, [[てゐ]], "笑顔", 0, "「So today's the big day, then. Our sweet little princess is finally getting married.」/「Ah, I remember the day of her arrival in the bamboo forest as if it was only yesterday.」/「Nothing but the clothes on her back, hiding from the cold in some forgotten corner until some kind rabbit offered her shelter.」", 1
IF TALENT:[[てゐ]]:恋慕
	PRINTFORMDL 테위가 계속 거짓말을 하자, 그녀는 갑자기 어딘가 아련한 표정으로 말투를 바꿨다.
	CALL SPTALK, [[てゐ]], "通常", 0, "「It's not too late, you know?」/「You can still accept your true feelings and run away with me.」/「Come, take my hand. We'll go somewhere where none of them will ever find us and be a family together.」", 1
	PRINTFORMDW 농담이 충분히 길어졌다고 생각하고, 테위의 귀를 잡아 응답한다.
	CALL SPTALK, [[てゐ]], "怒り", 0, "「Ow ow ow. I'm kidding, I'm kidding.」", 1
	CALL SPTALK, [[てゐ]], "通常", 0, @"「농담도 못 받아주겠어, %CALLNAME:MASTER%?」/「나조차 그런 일은 하지 않을걸, 있잖아.」/「게다가, 시도하면 Master가 나를 모피 코트로 만들어 버릴 거라고 확신해.」", 1
	PRINTFORMDW 당신과 테위는 함께 웃다가 다른 누군가 다가오는 소리를 듣는다.
ELSE
	PRINTFORMDW 티위는 잠시 동안 자신의 의심스러운 이야기를 계속하고 있다가, 다른 누군가가 다가오는 소리가 들린다.
ENDIF
CALL SPTALK, [[永琳]], "笑顔", 0, @"「아, 여기 있었군요, %CALLNAME:MASTER%. 딱 제 시간에 오셨네요.」/「공주는 준비가 되면 예식이 시작될 것입니다.」", 1
CALL SPTALK, [[永琳]], "通常", 0, "「Hm? Stand still, please.」", 1
IF BASE:MASTER:勃起 > 500
	PRINTFORMDL 에린은 당신의 턱을 잡아 손가락으로 마치 동물에게 약을 주듯 알약을 목 깊숙이 밀어 넣었다.
	PRINTFORMDW 그것이 내려가자마자, 당신의 사타구니 부위가 진정되는 것을 느꼈다.
	CALL SPTALK, [[永琳]], "笑顔", 0, "「That should prevent any unwanted accidents during the ceremony.」/「Everything needs to be perfect today.」", 1
	BASE:MASTER:勃起 = 0
ELSE
	PRINTFORMDL 에린은 당신의 칼라와 소매, 그리고 넥타이를 정돈하기 시작하며, 모든 것이 완벽해질 때까지 신경을 쓴다.
	CALL SPTALK, [[永琳]], "笑顔", 0, "「There. You look splendid.」/「Nothing must spoil the princess' special day.」", 1
ENDIF
WAIT
PRINTFORMDL 카구야 자신이 드디어 도착하는데, 그녀는 당신이 이전에 본 어떤 것보다 더 장엄한 드레스를 입고 있었다.
PRINTFORMDL %BREAKENG("Woven from the finest Lunarian materials, adorned by the most splendid jewelry, and a hem so long that it needs to be carried by no less than twelve rabbits, its beauty is only surpassed by that of Kaguya herself.")%
PRINTFORMDW 그녀가 잠시 시선을 빼는 사이, 그녀는 당신에게 달려와 단단하게 당신을 끌어안는다.
CALL SPTALK, [[輝夜]], "Smile", 0, "「My husband, you look wonderful.」", 1
CALL SPTALK, [[輝夜]], "笑顔", 0, "「Ah, but I suppose Kaguya shouldn't be calling you \"my husband\" just yet, right?」", 1
WAIT
CALL SPTALK, [[永琳]], "笑顔", 0, "「We're about to start the ceremony. Are you two ready?」", 1
PRINTFORMDL 카구야가 고개를 끄덕이고 당신 둘은 에이린을 따라 무대로 향한다.
PRINTFORMD 카구야와 나란히 걸으면서, 당신은 본다 
SELECTCASE VAR_OR_DEFAULT(GUEST_COUNT)
	CASE IS > CHARANUM - 10
		PRINTFORMDL 연례 사교 행사에 참석한 근교의 모든 저명인사들.
	CASE 50
		PRINTFORMDL 많은 사람들이 참석했다.
	CASE IS >= 15
		PRINTFORMDL 당신의 가장 가까운 친구들이 자리에 앉아 있다.
	CASEELSE
		PRINTFORMDL 당신이 초대한 소수의 사람들이 그 자리에 있다.
ENDSELECT
IF CFLAG:[[輝夜]]:子供人数
	LOCALS =
	FOR LOCAL, 0, VARSIZE("CHILDNAME")
	SIF STRLENS(CHILDNAME:LOCAL)
		LOCALS += @"%CHILDNAME:LOCAL%、"
	NEXT
	PRINTFORMDL %BREAKENG(@"자연스럽게, %LIST_IN_STRING(LOCALS)%은(는) \@ CFLAG:[[輝夜]]:子供人数 > 1 ? 앞줄에 앉아 있다 # 앞줄에 앉아 있다 \@.")%
ENDIF
;remaining seats
LOCAL = VAR_OR_DEFAULT("WEDDING_SIZE") - GUEST_COUNT
IF VAR_OR_DEFAULT("WEDDING_SIZE") <= 50
	IF LOCAL <= 0
		PRINTFORMDW 토끼들도 많이 있지만 자리가 없어서 손님들 뒤에 서 있어야 한다.
	ELSE
		PRINTFORMDW 남은 좌석은 토끼들이 사용하지만, 모두가 앉을 공간이 충분하지 않아 나머지는 손들 뒤에 서게 된다.
	ENDIF
ELSE
	PRINTFORMDW 남은 좌석들은 토끼들이 사용하고 있고, 결혼식 장소는 겨우 그들 모두를 담을 수 있었다.
ENDIF
PRINTFORMDL 카구야는 마치 당신의 소유권을 과시하려는 듯 팔을 단단히 당신에게 감고 있다.
IF CHARANUM - CMATCH(TALENT:恋慕, 0, 1) > 2
	PRINTFORMDW 주위를 둘러보니 그들 중 몇몇의 얼굴에는 어느 정도 질투심이 숨겨져 있는 듯했다.
ELSE
	PRINTFORMDW 그녀의 두려움은 근거 없는 것 같지만, 모든 손님들이 그녀를 위해 행복해하는 것처럼 보였다.
ENDIF
PRINTFORMDL 머지않아 무대에 도착한다.
CALL SPTALK, [[永琳]], "通常", 0, "「Welcome everyone. I'm glad all of you could make it here today.」", 1
CALL SPTALK, [[永琳]], "通常", 0, "「When we first came to Gensokyo, I never could've imagined things would end up like this.」/「Had it been up to me, we would've remained hidden in the bamboo forest forever and lived a quiet life together.」/「It was only at the princess' urging that we revealed ourselves to the rest of Gensokyo.」/「But I now see that was the best decision we ever made.」", 1
CALL SPTALK, [[永琳]], "笑顔", 0, @"「결국 그녀는 다른 방식으로 %조사처리(CALLNAME:MASTER,"를")% 만날 수 없었을 테니까.」", 1
WAIT
CALL SPTALK, [[永琳]], "通常", 0, "「Seeing her smile so much every day...」/「It is truly a blessing beyond any other.」", 1
CALL SPTALK, [[永琳]], "通常", 0, "「I'm sure we can all share in her happiness today, knowing that these two have a bright future ahead of them.」", 1
WAIT
PRINTFORMDL 에린이 당신에게 가까이 오라고 손짓한다.
CALL SPTALK, [[永琳]], "通常", 0, @"「달의 현자로서, 오늘 두 분의 결혼에 함께하게 되어 영광입니다.」/「카구야, 당신은 %조사처리(CALLNAME:MASTER,"를")% 아내로서 성실히 돌봐 주리라 믿습니다.」/「%CALLNAME:MASTER%, 당신은 언제나 카구야를 지켜주고 그녀가 결코 불행해지지 않도록 해줄 것이라 믿습니다.」", 1
PRINTFORMDW 아니면 후회하게 만들 거라고, 그녀가 분명히 암시하고 있는 것이었다.
IF TALENT:MASTER:追加種族 == 4
	CALL SPTALK, [[永琳]], "通常", 0, @"「자, 카구야. 여기 모두가 증인으로 함께 있는 가운데, 당신은 영원히 지금부터 나(%CALLNAME:MASTER%)를 남편으로 받아들이겠습니까?」", 1
ELSE
	CALL SPTALK, [[永琳]], "通常", 0, @"「자, 카구야. 여기에 모두가 증인으로 이 자리에 모였으니, 죽음이 우리를 갈라놓을 때까지 %조사처리(CALLNAME:MASTER,"를")% 남편으로 받아들이겠습니까?」", 1
ENDIF
WAIT
CALL SPTALK, [[輝夜]], "Smile", 0, "「Yes, of course!」", 1
WAIT
PRINTFORMDL 에린은 당신에게 돌아보기 전에 미소 지었다.
IF TALENT:MASTER:追加種族 == 4
	CALL SPTALK, [[永琳]], "通常", 0, @"「그리고 당신은, %CALLNAME:MASTER%, 여기에 있는 모든 이들이 증인으로 앞에서 카구야를 아내로 받아들여 줄 수 있습니까/, 그리고 영원히 그녀를 그 무엇보다 사랑하고 아끼겠다고 약속해 주시겠습니까?」", 1
ELSE
	CALL SPTALK, [[永琳]], "通常", 0, @"「그리고 당신, %CALLNAME:MASTER%, 모든 사람이 증인으로 이 자리에 있는 가운데, 카구야를 아내로 맞이하고, 죽음이 당신을 찾아올 때까지 그녀를 무엇보다 사랑하고 소중히 여기겠습니까?」", 1
ENDIF
PRINTFORMDL [0] 네, 합니다.
INPUT
CALL SPTALK, [[永琳]], "通常", 0, "「Then as the sage of the moon, I declare you to be husband and wife.」/「Congratulations.」/「You may now kiss the-」", 1
PRINTFORMDL 에린이 문장을 끝내기도 전에 카구야는 당신을 깊게 끌어안고 청중의 환호 속에 열렬하게 키스했다.
PRINTFORMDW 그녀는 당신의 입술에 만족하지 않고 혀로 그것들을 벌리며 당신의 입 안으로 침범해 입 안 구석구석을 핥았다.
PRINTFORMDL 마침내 몸을 떼었을 때, 카구야는 숨을 몰아쉬고 거친 상태였으며, 그녀의 정교한 용모는 이제 흐트러지고 이전의 평정을 잃었다.
PRINTFORMDL 그럼에도 불구하고 당신에게 지금의 아내는 그 어느 때보다 더 아름답게 보였다.
PRINTFORMDW 그녀가 옆에 있다면 분명 \@ TALENT:MASTER:追加種族 == 4 ? 영원 # 남은 인생 \@ 오직 행복만을 가져다줄 것이다.
TIME += 240
RETURN 1

@M_KOJO_EVENT_K62_WEDDING(ARGS,ARG,ARG:1)
SELECTCASE VARS_OR_DEFAULT("WEDDING_TYPE")
	CASE "WESTERN"
		SELECTCASE ARGS
			CASE "AISLE_WALK"
				PRINTFORMDL 당신은 에이린이 카구야를 통과하며 행진하는 것을 보고, 그녀의 웨딩드레스 끝을 들고 있는 토끼 한 쌍이 뒤따르는 것을 본다.
				PRINTFORMDW 이 화려한 드레스를 처음 보는 그녀는 평소보다 훨씬 더 아름다워 보이고, 당신의 심장이 멎는다.
			CASE "I_DO"
				PRINTFORMDL 카구야가 당신의 손을 잡고 대답하며 단단히 움켜쥔다.
				CALL SPTALK, [[輝夜]], "Smile", 0, "「I do.」", 1
			CASE "KISS"
				PRINTFORMDL 카구야가 먼저 주도권을 잡고 당신에게 입술을 맞추며 열정적인 키스를 나눈다.
				PRINTFORMDL 그녀는 주변의 모든 이들에게 자신만의 소유임을 표현하듯, 혀로 당신의 입안을 침범하며 팔로 당신을 감싼다.
				PRINTFORMDL 마침내 떨어져 나왔을 때, 그녀는 거칠게 숨을 몰아쉬다가 눈부신 미소를 지어 보인다.
				PRINTFORML 「후후, 나의 사랑스러운 남편. 당신을 너무나 많이 사랑해요.」
				PRINTFORML 「영원토록 카구야를 잘 부탁드립니다.」
		ENDSELECT
		RETURN 1
ENDSELECT

