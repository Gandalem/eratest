;==================================================
;181,媚薬,
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K62_181
RETURN 1

@M_KOJO_MESSAGE_COM_K62_181
CALL M_KOJO_MESSAGE_COM_K62_181_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K62_181_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	CALLFORM M_KOJO_COLOR_K62
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMDL 카구야는 당신이 최음제 병을 꺼내는 것을 보며 몸을 떨었다.
		SELECTCASE RAND:4
			CASE 3
				PRINTFORML 「카구야가 더욱 음란해지기를 바라는 건가...?」
			CASE 2
				PRINTFORML 「카구야가 음란해지기를 바라는 거구나, 응...?」
			CASE 1
				PRINTFORML 「만약 남편이 이것을 마시라고 한다면...%UNICODE(0x2764)%」
			CASE 0
				PRINTFORML 「이걸 마시고 남편에게 난장판을 당할 생각만 해도...%UNICODE(0x2764)% 몸이 떨린다...%UNICODE(0x2764)%」
		ENDSELECT
		PRINTFORMDW %BREAKENG(@"그녀는 가까이 다가와 네 행동에 대한 모든 책임을 지라고 속삭이고, 병 전체를 비우며 그것을 마시는 시늉을 한다.")%
	ELSEIF TALENT:恋慕 || TALENT:愛欲
		PRINTFORMDL 카구야는 네가 꺼내든 작은 병을 응시했다.
		SELECTCASE RAND:4
			CASE 3
				PRINTFORML 「두려워 말아라, 한 방울도 남기지 않겠다...%UNICODE(0x2764)%」
			CASE 2
				PRINTFORML 「얼마나 음탕한지...%UNICODE(0x2764)%」
			CASE 1
				PRINTFORML 「얼마나 방탕한가...%UNICODE(0x2764)%」
			CASE 0
				PRINTFORML 「...후후%UNICODE(0x2764)%」
		ENDSELECT
		PRINTFORMDW %BREAKENG(@"그녀가 가까이 다가와 속삭인다. 네 행동에 대한 모든 책임을 지라고. 카구야는 병 전체를 마시는 시늉을 하며 내용물을 입으로 비운다.")%
	ENDIF
ENDIF
RETURN 1
