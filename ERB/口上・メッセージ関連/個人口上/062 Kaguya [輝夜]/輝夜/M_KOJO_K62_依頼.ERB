;==================================================
;依頼口上・一般依頼12：懲らしめて！
;==================================================
@M_KOJO_IRAI_12_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  TARGET_ID
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「Aah, it's terrible, it's terrible.」
		PRINTFORML 「My husband, someone was so mean to Kaguya today.」
		PRINTFORML 「She still gets angry whenever she thinks about it.」
		PRINTFORMDW Kaguya looks extremely upset as she walks up to you.
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「Ah, %CALLNAME:MASTER%, you're here...」
		PRINTFORML 「I'm sorry, I'm still a little upset after a little disagreement I had with someone earlier.」
		PRINTFORMW 「But perhaps you can help. Would you be willing to hear me out?」
	ELSE
		PRINTFORML 「Perhaps you can help me with this, %CALLNAME:MASTER%.」
		PRINTFORMW 「I ran into a little trouble with someone. Could you help me clear it up?」
	ENDIF

	RETURN 1
CASE "依頼非受託時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMDW Kaguya looks like she's about to start crying.
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「That's unfortunate. Well, I'm sure I'll forget all about it soon enough.」
	ELSE
		PRINTFORMW 「I see. Well, it wasn't all that important.」
	ENDIF
	RETURN 1
CASE "依頼受託時"
	TARGET_ID = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMDL You ask Kaguya what you can do to help. Her frown immediately turns into a smile.
		PRINTFORML 「Thank you, my husband. You see, Kaguya got into a little fight with %CALLNAME:TARGET_ID%...」
		PRINTFORML 「%HE_SHE(TARGET_ID,1)% said such mean things to Kaguya. Aaah, thinking about it makes Kaguya angry all over again.」
		PRINTFORMW 「My husband, could you have a little talk with %CALLNAME:TARGET_ID%? I'm sure that you can convince %HIM_HER(TARGET_ID)% to be nicer to Kaguya.」
		SIF TALENT:TARGET_ID:恋慕
			PRINTFORMW （And perhaps %HE_SHE(TARGET_ID)% will learn to know %HIS_HER(TARGET_ID)% place with this...）
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「%CALLNAME:TARGET_ID% and I had a bit of an argument, and things got really heated by the end.」
		PRINTFORML 「I'm still pretty upset over it, so I want to ask you to handle it.」
		PRINTFORMW 「Can you go over to %CALLNAME:TARGET_ID% and have a little "talk" with %HIM_HER(TARGET_ID)%?」
		SIF TALENT:TARGET_ID:恋慕
			PRINTFORMW （With some luck, this will convince %HIM_HER(TARGET_ID)% to back off...）
	ELSE
		PRINTFORML 「Someone has insulted me, and I cannot leave that sort of thing be.」
		PRINTFORMW 「Can you go over to %CALLNAME:TARGET_ID% and teach them a little lesson?」
	ENDIF

	RETURN 1
CASE "依頼確認時"
	RETURN 0
CASE "依頼破棄時"
	TARGET_ID = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「My husband...」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「I see. Perhaps I was wrong to ask this of you.」
		SIF TALENT:TARGET_ID:恋慕
			PRINTFORMW （Did he catch on?...）
	ELSE
		PRINTFORML 「Was this too much for you to stomach?」
		PRINTFORMW 「Perhaps you're more of a coward than I thought.」
	ENDIF
	
	RETURN 1
CASE "依頼実行直前"
;○この依頼では討伐される側の口上です
	IF CANNOT_DANMAKU() == 1
	;屋内のとき（勝負できない）
	;【◆口上】
	;【W 屋外で挑もう…】
		SIF CFLAG:行動 == 5 && CFLAG:職種 == 43
			GOTO AT_WORK
		PRINTFORMW 「This is hardly the place for that. Let's move elsewhere, first.」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 2
	;仕事中（勝負できない）
	;【◆口上】
	;【W お取り込み中だ…】
		$AT_WORK
		;IF (DAY:2 == 3 && DAY:3 == 14)
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			IF (DAY:2 == 3 && DAY:3 == 14)
				PRINTFORMW 「I'm sorry, my husband. Kaguya is busy with the Expo right now. Can you wait until it is finished?」
			ELSE
				PRINTFORMW 「Could you wait a little while, my husband? Kaguya is still tending to her bonsai.」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			IF (DAY:2 == 3 && DAY:3 == 14)
				PRINTFORMW 「Sorry, %CALLNAME:MASTER%. I'm busy with the Expo right now.」
			ELSE
				PRINTFORMW 「Please allow me to finish this first.」
			ENDIF
		ELSE
			PRINTFORMW 「Whatever you need, it's not as important as what I'm doing right now.」
		ENDIF
		
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 3
	;あなたが疲労中（勝負できない）
	;【◆口上】
	;【W 今は疲れている…】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「My husband, are you alright? You look extremely pale right now.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「I think we should postpone this until you have recovered, %CALLNAME:MASTER%.」
		ELSE
			PRINTFORMW 「You're clearly in no condition to do this right now.」
		ENDIF
		
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 4
	;口上主が疲労竜（勝負できない）
	;【◆口上】
	;【W 今挑むのはフェアじゃない…】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「I am sorry, my husband. Kaguya is too tired for this right now.」
			PRINTFORMW 「Please permit her to rest first.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「I'm too tired for this right now. Please come back later.」
		ELSE
			PRINTFORMW 「I'm far too tired for this. Come back some other time.」
		ENDIF
		
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 5
	;既に今日一度弾幕勝負をしている（勝負できない）
	;【◆口上】
	;【W 今日はもう挑めない…】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「Kaguya would love to play more with her dear husband, but she's still sore from the last match.」
			PRINTFORMW 「Let's both get some rest and try again tomorrow, instead.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「I'm still tired from the last match. Let's try this again tomorrow, instead.」
		ELSE
			PRINTFORMW 「Don't be so eager, %CALLNAME:MASTER%. It's only reasonable to fight only one match per day.」
		ENDIF
		
		RETURN 1
	ELSE
	;【◆口上】
	;【W 勝負開始！！】
	;【以降はそのまま弾幕口上が呼ばれます】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			IF CLIENT_ID == [[妹紅]]
				PRINTFORML 「To think that Mokou would send my own husband against me...」
				;no, she does not realize the irony in this statement
				PRINTFORML 「Has she grown too cowardly to face me herself?」
				PRINTFORML 「Very well then, my husband. If you're serious about this, then Kaguya will fight seriously, too.」
				PRINTFORMW 「Now come at me with all you've got!」
				TALENT:機嫌 = -1 ;trigger the bad mood dialogue
			ELSE
				PRINTFORML 「Someone asked you to fight Kaguya?」
				PRINTFORML 「Fufu, how amusing. Shall we have a little fun, then?」
				PRINTFORMW 「Don't hold back, my husband. Show me your splendid Danmaku!」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			IF CLIENT_ID == [[妹紅]]
				PRINTFORML 「To think she would send you against me.」
				PRINTFORML 「Very well then, today I will show you my true power.」
				PRINTFORML 「My Danmaku that stretches from the instantaneous to the eternal...」
				PRINTFORMW 「How long will you last against them?」
				TALENT:機嫌 = -1 ;trigger the bad mood dialogue
			ELSE
				PRINTFORML 「So someone hired you to fight me?」
				PRINTFORML 「This should be fun.」
				PRINTFORML 「Show me everything you've got, %CALLNAME:MASTER%!」
				PRINTFORML 「My five requests that so many humans in the past have failed to complete...」
				PRINTFORMW 「How many of them can you fulfill?」
			ENDIF
		ELSE
			IF CLIENT_ID == [[妹紅]]
				PRINTFORML 「So that girl sends her dog to attack me now.」
				PRINTFORML 「If you have decided to take her side, then I will show you no mercy.」
				PRINTFORML 「My five impossible requests that led Kuramochi no Miko to ruin...」
				PRINTFORMW 「How many can you survive?」
				TALENT:機嫌 = -1 ;trigger the bad mood dialogue
			ELSE
				PRINTFORML 「To think someone would hire an assassin to kill me...」
				PRINTFORML 「What good timing, I was just getting bored.」
				PRINTFORML 「My would-be murderer, since you're so eager to pick a fight with me, let's begin right away.」
				PRINTFORML 「My five requests that so many humans in the past have failed to complete...」
				PRINTFORMW 「How many of them can you fulfill?」
			ENDIF
		ENDIF
		
		RETURN 1
	ENDIF
	;【▼そのまま下の口上へ】
CASE "依頼実行直後"
;○この依頼では討伐される側の口上です
	IF CFLAG:CLIENT_ID:依頼状況 == 2
		IF CANNOT_DANMAKU() == 0
			;負け犬
			;【▲上の口上から続き】
			;【L ［彼女］の討伐に失敗した……】
			;【W ……こうなったら後日出直すしかない】
			;【◆口上】

			;player loses
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「Are you okay, my husband?」
				PRINTFORMW 「Please accept Kaguya's apologies for being so rough with you.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				IF CLIENT_ID == [[妹紅]]
					PRINTFORMW 「I trust you understand now why it's so foolish to concern yourself with that girl.」
				ELSE
					PRINTFORMW 「I had a good time. Thank you for entertaining me today, %CALLNAME:MASTER%.」
				ENDIF
			ELSE
				IF CLIENT_ID == [[妹紅]]
					PRINTFORMW 「It doesn't matter who that girl sends, she should understand her place in the world.」
				ELSE
					PRINTFORMW 「It seems that I had little to fear from my would-be assassin.」
				ENDIF
			ENDIF

			TALENT:機嫌 = 1 ;put in a good mood afterwards
			RETURN 1
		ELSE
			;挑めなかった場合
			;【▲上の口上から続き】
			;【◆口上】
			RETURN 0
		ENDIF
	ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
	;勝利
	;【▲上の口上から続き】
	;【W ［彼女］を懲らしめた！】
	;【◆口上】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			IF CLIENT_ID == [[妹紅]]
				PRINTFORMW 「As expected from Kaguya's husband. Although it pains Kaguya to admit it, let Mokou know that today is her victory.」
			ELSE
				PRINTFORMW 「Fufu, you were simply magnificent. Kaguya stood no chance against her husband.」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			IF CLIENT_ID == [[妹紅]]
				PRINTFORML 「You've bested me, though it's frustrating to know that it was on Mokou's behalf.」
				PRINTFORMW 「Well, it's fine. It was fun for me too, after all.」
			ELSE
				PRINTFORMW 「It's my loss today. It seems that whoever hired you has a good eye for talent.」
			ENDIF
		ELSE
			IF CLIENT_ID == [[妹紅]]
				PRINTFORML 「Hmph. Fine, I surrender. Tell Mokou that she won this battle.」
				PRINTFORMDW Kaguya says nothing more, but she clearly looks frustrated by her loss.
			ELSE
				PRINTFORMW 「I submit. It's your victory today, %CALLNAME:MASTER%.」
			ENDIF
		ENDIF

		SIF TALENT:恋慕 || TALENT:思慕
			TALENT:機嫌 = 1 ;put in a good mood afterwards
		
		RETURN 1
	ENDIF
CASE "成功報告時"
;報酬：賞金（時価）
	TARGET_ID = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「Thank you, my husband. Kaguya is so relieved that you managed to resolve this so quickly.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「Thank you for this, %CALLNAME:MASTER%. I'm feeling a lot better about this whole incident already.」
	ELSE
		PRINTFORMW 「Thank you for dealing with this matter for me. I may call on you again in the future.」
	ENDIF
	
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

