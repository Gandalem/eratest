;custom, entire file is original content
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================
@M_KOJO_IRAI_K62(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K62(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K62(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
;●依頼を持ちかけられる時
;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
;【◆口上】
;【依頼データ表示】
;【INPUT（受託するかY/N）】
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「My husband, can Kaguya impose on you with one of her selfish requests?」
		PRINTFORML 「There's something that I am only willing to entrust to you.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「Do you have some time, %CALLNAME:MASTER%?」
		PRINTFORML 「There's something I need your help with.」
	ELSE
		PRINTFORML 「Ah, good timing, %CALLNAME:MASTER%.」
		PRINTFORML 「There's something I would like your help with.」
	ENDIF
	
CASE "依頼非受託時"
;●内容だけ見て受託しなかった時
;【L ［あなた］は丁重にお断りした】
;【◆口上】
;【W ［彼女］は残念そうな顔をしている】
IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
	PRINTFORML 「I understand. Kaguya shouldn't be so selfish as to bother her husband with this.」
	PRINTFORML 「Please accept my apologies for trying to impose on you so.」
	PRINTFORMDW Kaguya bows her head and expresses her apologies.
ELSEIF TALENT:恋慕 || TALENT:思慕
	PRINTFORMW 「That's a shame, but I won't force you. Perhaps some other time.」
ELSE
	PRINTFORML 「I see, that's unfortunate.」
	PRINTFORMW 「Perhaps I overestimated you.」
ENDIF
	
CASE "依頼受託時"
;●依頼を受託した時
;【W ［あなた］は［彼女］の依頼を受けた】
;【◆口上】
IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
	PRINTFORML 「Thank you, my husband.」
	PRINTFORMW 「Let Kaguya explain the issue further.」
ELSEIF TALENT:恋慕 || TALENT:思慕
	PRINTFORMW 「Thank you, %CALLNAME:MASTER%. Allow me to explain what I need of you.」
ELSE
	PRINTFORML 「Thank you, %CALLNAME:MASTER%.」
	PRINTFORMW 「Let me tell you what I need you to do.」
ENDIF
	
CASE "依頼確認時"
;●[366]で依頼内容を依頼人に確認した時
;【◆口上】
;【依頼データ表示】
;【INPUT（破棄するかY/N）】
IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
	PRINTFORML 「Is something wrong, my husband?」
ELSEIF TALENT:恋慕 || TALENT:思慕
	PRINTFORML 「Is there something I can do for you, %CALLNAME:MASTER%?」
ELSE
	PRINTFORML 「Is there something you need to ask me, %CALLNAME:MASTER%?」
ENDIF
	
CASE "依頼破棄時"
;●受託した依頼を破棄する時
;【◆口上】
;【W 依頼を破棄しました。】
IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
	PRINTFORML 「I understand. Kaguya was selfish for bothering her husband with this.」
	PRINTFORML 「Please accept my apologies for imposing on you so.」
	PRINTFORMDW Kaguya bows her head and expresses her apologies.
ELSEIF TALENT:恋慕 || TALENT:思慕
	PRINTFORML 「That's unfortunate.」
	PRINTFORML 「Well, at least you had the decency to say this in person.」
	PRINTFORMW 「Now if you excuse me, I will need to make other arrangements.」
ELSE
	PRINTFORML 「If you didn't want to do this, you should've just said so from the beginning, %CALLNAME:MASTER%.」
	PRINTFORML 「Now I'll have to figure out something else on short notice.」
	PRINTFORMDL Kaguya makes no attempt to hide the expression of displeasure on her face.
	CALL CHANGE_CFLAG(2, TARGET, -70)
	CALL CHANGE_CFLAG(4, TARGET, -30)
ENDIF
	
CASE "依頼実行直前"
;●[367]で依頼を実行する時、実行処理の前に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【◆口上】
;【実行時の地の文・ソース等】
;【▼下の口上に続く】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		
	ENDIF
CASE "依頼実行直後"
;●[367]で依頼を実行する時、実行処理の後に呼び出される
;※依頼によって状況が大きく異なるので共通口上は非推奨
;【▲上の口上から続き】
;【◆口上】
;【達成時・CLIENT：▼下の口上に続く】
;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
	IF ROLE == "CLIENT"
	;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ELSEIF ROLE == "TARGET"
	;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
		CASE 2
		;実行後未解決
			
		CASE 3
		;実行後達成
			
		CASE 6
		;実行後失敗（現在「06_誰か教えて！」のみ）
			
		ENDSELECT
	ENDIF
CASE "成功報告時"
;●報告時（成功）
;【依頼実行と報告が同時の時：▲上の口上から続き】
;【◆口上】
;【ソースの入手・アイテム等の報酬獲得】
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「Thank you, my husband. Kaguya is extremely grateful for your aid.」
		PRINTFORMDW Kaguya gives you a magnificent bow as she expresses her gratitude.
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「Good work, %CALLNAME:MASTER%. Thank you for your assistance.」
		PRINTFORMDW Kaguya gives you a small bow.
	ELSE
		PRINTFORMW 「Yes, that will be adequate. Thank you, %CALLNAME:MASTER%.」
	ENDIF
CASE "失敗報告時"
;○直接失敗報告は現在「06_誰か教えて！」のみ
;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
;【◆口上】
;○機嫌の変化や追加のペナルティ等は口上側で処理してください
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「I'm sorry, my husband. Kaguya misjudged the situation.」
		PRINTFORML 「Please accept her humble apologies for failing you in this manner.」
		PRINTFORMDW Kaguya bows deeply to express her regret.
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「Thats unfortunate, but such a thing can happen.」
		PRINTFORMDW Kaguya does not seem particularly upset about your failure.
	ELSE
		PRINTFORML 「I did not consider that particular request to be impossible.」
		PRINTFORML 「Perhaps I should find someone more capable next time.」
		PRINTFORMDL Kaguya looks at you with disdain before turning away from you.
		CALL CHANGE_CFLAG(2, TARGET, -30)
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDIF
	
CASE "依頼報告不要"
;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
;○地の文はありません
;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「My husband, did everything go alright with that matter from the other day?」
		PRINTFORML 「Ah, so you finished it already.」
		PRINTFORML 「Thank you for your aid, my husband.」
		PRINTFORMDW Kaguya gives you a splendid bow as she expresses her gratitude.
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「Did everything work that with that request I made of you, %CALLNAME:MASTER%?」
		PRINTFORMW 「I see. So it's all been resolved. Thank you for your assistance.」
	ELSE
		PRINTFORML 「%CALLNAME:MASTER%, did you remember to finish that thing I asked of you earlier?」
		PRINTFORMW 「I see. I'm glad to hear that you succeeded, but please inform me a little sooner next time.」
	ENDIF
ENDSELECT
RETURN 1

;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================
@M_KOJO_IRAI_1_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  SAME_ROOM
SAME_ROOM = CFLAG:TARGET:初期位置 == CFLAG:MASTER:初期位置
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「My husband, while it shames Kaguya to admit it, \@ SAME_ROOM ? our # her \@ room has become unbearably filthy.」
		PRINTFORML 「Can I ask for your help with cleaning it up?」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORML 「It's rather embarrassing to admit, but my room has become rather filthy.」
		PRINTFORML 「Can I ask for your help with cleaning it up?」
	ELSE
		PRINTFORML 「My room is in dire need of cleaning.」
		IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
			PRINTFORML 「Since I'm housing you, this is the least you could do for me.」
		ELSE
			PRINTFORML 「This is a great opportunity for you to show your worth.」
		ENDIF
	ENDIF
	
	RETURN 1
CASE "依頼非受託時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORML 「Kaguya understands. Kaguya will do it herself.」
		PRINTFORMW 「After all, this too is one of the duties of a wife.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「I understand. This is my own responsibility.」
	ELSE
		;minor trust decrease if living under Kaguya's roof
		IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
			PRINTFORML 「I did not think this was too much to ask of you in return for permitting you to live here.」
			PRINTFORML 「Fine. Do as you will, then.」
			PRINTFORMDW Though Kaguya acts as if she doesn't care, she looks at you with clear disdain on her face.
			CALL CHANGE_CFLAG(4, TARGET, -10)
		ELSE
			PRINTFORML 「That's a shame.」
			PRINTFORMDW Kaguya turns away, having lost interest in you.
		ENDIF
	ENDIF
	RETURN 1
CASE "依頼受託時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「Thank you, my husband. Let us head to \@ SAME_ROOM ? our # my \@ room, then.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「Thank you. Let's do this quickly, then.」
	ELSE
		IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
			PRINTFORMW 「Very good. You can go to work right away.」
		ELSE
			PRINTFORMW 「Thank you. Let's waste no time with this.」
		ENDIF
	ENDIF
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「Did something else come up? Do not worry about this, my husband. Whatever you need to do is more important.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「Did something happen? That's unfortunate. I'll think of something else, then.」
	ELSE
		IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
			PRINTFORML 「Was this really too much to ask of you?」
			PRINTFORML 「Fine. Do as you wish.」
			PRINTFORMDW Though Kaguya acts as if she doesn't care, she looks at you with clear disdain on her face.
			CALL CHANGE_CFLAG(4, TARGET, -25)
		ELSE
			PRINTFORMW 「You should know that it's rather rude to suddenly go back on your word.」
		ENDIF
	ENDIF
	RETURN 1
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
	IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
	;先に掃除してしまっていた場合
	;【◆口上】
	;【W ［彼女］の部屋は十分にきれいだ】
	;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「Eh, it's already been cleaned up? When did-」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「Eh, it's already clean? Did you already clean everything up?」
		ELSE
			PRINTFORML 「How odd. Perhaps Reisen or the other Inaba already cleaned it?」
		ENDIF
		PRINTFORMDW Kaguya looks confused to find her room already cleaned up.
		
		;keep track of not having done any work
		LOCAL = 1
		RETURN 1
	ELSE
	;一緒に掃除する場合
	;【◆口上】
	;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
	;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			IF ABL:MASTER:清掃技能 + ABL:清掃技能 >= 10
				PRINTFORMW 「Then let us begin. With our combined skills, this should take no time at all.」
			ELSEIF ABL:MASTER:清掃技能 < ABL:清掃技能
				PRINTFORMW 「Allow Kaguya to show you her skills as a wife.」
			ELSE
				PRINTFORML 「While it shames Kaguya to admit it, her skills at cleaning are far inferior to that of her husband.」
				PRINTFORMW 「Please forgive her for putting this burden on you.」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			IF ABL:MASTER:清掃技能 + ABL:清掃技能 >= 10
				PRINTFORMW 「With the two of us, this shouldn't be too difficult.」
			ELSEIF ABL:MASTER:清掃技能 < ABL:清掃技能
				PRINTFORMW 「Well then, allow me to show you my talents today.」
			ELSE
				PRINTFORML 「While it shames Kaguya to admit it, her skills at cleaning are far inferior to that of her husband.」
				PRINTFORMW 「Please forgive her for putting this burden on you.」
			ENDIF
		ELSE
			PRINTFORML 「You can get to work now, but please be careful in here.」
			PRINTFORMDW Kaguya sits down while giving you instructions on what to clean next, not putting in any work herself.
		ENDIF
		
		LOCAL = 0
		RETURN 1
	ENDIF
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
;【▼そのまま下の口上へ】
	IF LOCAL
		PRINTFORMW 「Well, things went a little different than expected, but everything is in order now.」
	ELSE
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「Fufu, when it's together with my husband, even cleaning becomes fun.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「Oh my, we finished that really quickly.」
		ELSE
			PRINTFORMW 「Good work. Everything is in order now.」
		ENDIF
	ENDIF
	RETURN 1
CASE "成功報告時"
;報酬：低級素材
;【▲上の口上から続き】
;【◆口上】
;【報酬獲得】
	
	RETURN 0
CASE "失敗報告時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「Did something else come up? Do not worry about this, my husband.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「Is everything alright, %CALLNAME:MASTER%? You completely forgot about cleaning \@ SAME_ROOM ? our # my \@ room.」
	ELSE
		IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
			PRINTFORMW 「I did not consider this to be a difficult task, was this really too much for you?」
			CALL CHANGE_CFLAG(4, TARGET, -40)
		ELSE
			PRINTFORMW 「I do not understand how you could fail such a simple task.」
		ENDIF
	ENDIF
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼02：お花に水をあげて
;==================================================
@M_KOJO_IRAI_2_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	
	RETURN 0
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;【◆口上】
;【W ［あなた］は［依頼主］の家の鉢植えや植木に水をあげた】
;【▼そのまま下の口上へ】
	IF ROLE == "CLIENT"
	;水やりした時、依頼主である口上主がTARGETの場合
		
		RETURN 0
	ELSEIF ROLE == "TARGET"
	;水やりした時、依頼主ではない口上主がTARGETの場合
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			IF RELATION:TARGET:CLIENT_ID && RELATION:TARGET:CLIENT_ID < 100
				PRINTFORML 「My husband, do you really need to bother with this?」
				PRINTFORML 「%CALLNAME:CLIENT_ID% is perfectly capable of doing it %HIMSELF_HERSELF(CLIENT_ID)%, is %HE_SHE(CLIENT_ID)% not?」
				PRINTFORMDW Kaguya grumbles while you water the plants.
			ELSE
				PRINTFORML 「You're watering %CALLNAME:CLIENT_ID%'s flowers?」
				PRINTFORMW 「Please permit Kaguya to help you.」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			IF RELATION:TARGET:CLIENT_ID && RELATION:TARGET:CLIENT_ID < 100
				PRINTFORMW 「It surprises me to see how eager you are to perform other people's chores.」
			ELSE
				PRINTFORML 「Yes, these flowers do look a little dry.」
			ENDIF
		ELSE
			IF RELATION:TARGET:CLIENT_ID && RELATION:TARGET:CLIENT_ID < 100
				PRINTFORMW 「Why do you even bother with that person?」
			ELSE
				PRINTFORMDW Kaguya pays you no mind as you water the flowers.
			ENDIF
		ENDIF
		
		RETURN 1
	ENDIF
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
;【◆口上】
	IF ROLE == "CLIENT"
	;水やりした時、依頼主である口上主がTARGETの場合
	;この場合はそのまま下の口上へ続きます
		
		RETURN 0
	ELSEIF ROLE == "TARGET"
	;水やりした時、依頼主ではない口上主がTARGETの場合
		
		RETURN 0
	ENDIF
CASE "成功報告時"
;報酬：\500
	
	RETURN 0
CASE "失敗報告時"
	
	RETURN 0
CASE "依頼報告不要"
	
	RETURN 0
ENDSELECT
