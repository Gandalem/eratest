	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
