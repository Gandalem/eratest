@M_KOJO_IRAI_8_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  RECIPIENT
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「내 남편, 카구야가 배달해야 할 것이 있어. 카구야를 위해 이것을 해줄 수 있겠어?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「아, %CALLNAME:MASTER%, 타이밍이 좋네. 작은 배달 부탁 하나 해도 될까?」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%, 처리해야 할 작은 임무가 하나 있습니다. 이 편지를 대신 맡아주시겠어요?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RECIPIENT = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「감사해요, 남편. 그럼 이 편지를 %CALLNAME:RECIPIENT%에게 전달해 주세요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. 이 편지는 %CALLNAME:RECIPIENT%에게 전달할 것입니다. 가능한 한 빨리 전해주십시오.」
		ELSE
			PRINTFORMW 「아주 잘했다. 이 편지는 %CALLNAME:RECIPIENT%에게 가는 것이다. 신속히 %HIM_HER(RECIPIENT)%에게 전해주길 바란다.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RECIPIENT = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「아직 편지를 %CALLNAME:RECIPIENT%에게 주었나?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「%CALLNAME:RECIPIENT%에게 편지를 이미 가져다주었나? 분명 %HE_SHE(RECIPIENT)%는 그것을 애타게 기다리고 있을 거야.」
		ELSE
			PRINTFORMW 「벌써 잊어버렸나? 편지는 %CALLNAME:RECIPIENT%에게 가는 거야. 봉투에까지 적어뒀는데.」
		ENDIF
		RETURN 1
	CASE "依頼破棄時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「알겠어, 내 남편. 카구야가 다른 방법으로 이것을 전달할 거야.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「좋아, 그럼 다른 걸 생각할게.」
		ELSE
			PRINTFORMW 「그런 작은 임무가 당신에게 정말 너무 어려운 건가요?」
		ENDIF
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では手紙を渡される側の口上です
		;【◆口上】
		;【W ［あなた］は［彼女］に預かっていた手紙を渡した】
		;【▼そのまま下の口上へ】
		;there shouldn't be anyone who'd send a letter to Kaguya, but might as well
		PRINTFORMW 「나에게 온 편지라고? 누가 보냈을까 궁금하네.」
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「오 마이, 그거 정말 흥미롭네요.」
			PRINTFORMW 「%CALLNAME:CLIENT_ID%에게 감사를 전해 주세요, 남편.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「그게 무슨 일인지 알겠군.」
			PRINTFORMW 「%CALLNAME:MASTER%, 고맙습니다. %CALLNAME:CLIENT_ID%에게 제 인사를 전해 주세요.」
		ELSE
			PRINTFORMDL 카구야는 편지를 조용히 읽는다.
			PRINTFORMW 「알겠다. 이 일을 나에게 알려줘서 %CALLNAME:CLIENT_ID%에게 고맙다고 전해다오.」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：素材4つ
		RECIPIENT = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「고마워요, 남편. %CALLNAME:RECIPIENT%가 그것을 받고 기뻐했을 거라고 확신해요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. 저를 위해 이것을 해주셔서 고맙습니다.」
		ELSE
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. 잘해주셨습니다.」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RECIPIENT = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「그렇구나. 뭐, 그런 일은 생길 수 있지. 가끔 %CALLNAME:RECIPIENT%를 찾기 힘들다는 거 알아.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「알겠다. %CALLNAME:RECIPIENT%가 너에게 상당히 어려운 일을 만든 것 같구나.」
		ELSE
			PRINTFORMW 「분명 %CALLNAME:RECIPIENT%에게 무언가를 전달하는 것이 그렇게 어려울 리 없었을 텐데.」
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
