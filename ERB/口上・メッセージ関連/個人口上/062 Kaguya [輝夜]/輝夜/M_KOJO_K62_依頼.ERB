;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「내 남편, 카구야가 당신에게 부탁을 해도 될까요?」
			PRINTFORML 「카구야는 최근에 남편의 맛있는 생선이 정말 먹고 싶었어요.」
			PRINTFORML 「그녀에게 좀 가져다줄 수 있나요?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「좋은 생선 좀 빨리 먹고 싶어.」
			PRINTFORML 「나를 위해 좀 잡아줄 수 있어?」
		ELSE
			PRINTFORML 「너는 꽤 실력 있는 어부 %PRINT_MALE("man", MASTER)%이군, 안 그래?」
			PRINTFORML 「나를 위해 고품질의 생선을 구해주길 바란다.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「고마워요, 남편. 카구야가 당신이 그녀에게 가져다줄 것을 빨리 보고 싶어 해요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「고마워요. 이번에는 어떤 물고기를 잡을지 기대하고 기다릴게요.」
		ELSE
			PRINTFORMW 「최대한 빨리 전달해 주세요.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【L ［あなた］は［彼女］にうまい魚を渡した】
		;【L 何だか生きる希望がわいてきたよ。】
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「아, 이거 정말 맛있어 보인다. 고마워, 남편. 카구야는 이게 분명 환상적인 맛일 거야.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「오오, 이거 정말 멋지네요. 이런 걸 잡을 정도라면 실력이 상당하신 것 같아요.」
		ELSE
			PRINTFORMW 「그래, 이게 충분하겠지. 여기 보상이 있다.」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：白米３個
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
