@M_KOJO_IRAI_5_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「나의 남편 카구야가 단마쿠 연습을 하고 싶어 한다. 함께 해 주겠니?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「운동 시작하려던 참인데, 같이 할래요?」
		ELSE
			PRINTFORML 「시기 좋군, %CALLNAME:MASTER%. 마침 스파링 파트너를 찾고 있었어.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORM 「고마워요, 남편.」 
			IF 戦闘訓練可(CFLAG:MASTER:現在位置)
				PRINTFORMW 바로 시작하자.
			ELSE
				PRINTFORMW 충분히 공간이 있는 곳을 찾자.
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORM 그럼 그렇게 하자. 
			IF 戦闘訓練可(CFLAG:MASTER:現在位置)
				PRINTFORMW 그럼 시작하자.」
			ELSE
				PRINTFORMW 좀 더 넓은 곳으로 가자.
			ENDIF
		ELSE
			PRINTFORM 「아주 좋아.」 
			IF 戦闘訓練可(CFLAG:MASTER:現在位置)
				PRINTFORMW 이곳이라면 괜찮을 것이다.
			ELSE
				PRINTFORMW 좀 더 넓은 곳으로 가자.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		PRINTFORMW 「좀 더 연습할 공간이 필요할 것 같아.」
		RETURN 1
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			IF ABL:MASTER:戦闘能力 == ABL:戦闘能力
				PRINTFORMW 「후후, 우리가 서로의 파트너가 되도록 만들어진 것 같아.」
			ELSEIF ABL:MASTER:戦闘能力 > ABL:戦闘能力
				PRINTFORMW 「당신의 멋진 단막을 보여줘, 내 남편.」
			ELSEIF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTFORMW 「가구야가 남편을 더욱 강하게 만드는 것을 도와주게 하라.」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			IF ABL:MASTER:戦闘能力 == ABL:戦闘能力
				PRINTFORMW 「재미있게 놀아보자고?」
			ELSEIF ABL:MASTER:戦闘能力 > ABL:戦闘能力
				PRINTFORMW 「나에 대해서는 걱정하지 말고, 네 모든 힘을 보여줘.」
			ELSEIF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTFORMW 「걱정 마, 다치지 않게 내가 확실히 해줄게.」
			ENDIF
		ELSE
			IF ABL:MASTER:戦闘能力 == ABL:戦闘能力
				PRINTFORMW 「이것은 좋은 연습이 되어야 한다.」
			ELSEIF ABL:MASTER:戦闘能力 > ABL:戦闘能力
				PRINTFORMW 「주저하지 말고, 네 실력을 보여줘.」
			ELSEIF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTFORMW 「최선을 다해 나를 따라오도록 노력해라.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		;if combined skill of 11 or higher, chance of catastrophic clash that leads to damaging the surrounding areas
		IF ABL:MASTER:戦闘能力 + ABL:戦闘能力 > 10 && !RAND:10
			PRINTFORMDL 당신과 카구야가 스파링을 하는 동안, 두 사람은 서로에게 점점 더 강력한 패턴들을 던졌다.
			PRINTFORMD 결국 상황이 계속해서 격화되면서 통제 불능의 상태로 빠지고, 
			SELECTCASE GET_MAPID(CFLAG:MASTER:現在位置)
				CASE MAP神社
					PRINTFORMDL 당신은 신사 일부를 손상시킨다.
					PRINTFORMDL 매우 화가 난 신사에 마주쳤을 때, 당신과 카구야는 즉시 사과하러 움직인다.
				CASE MAP寺
					PRINTFORMDL 당신은 일부 묘비에 피해를 입힌다.
					PRINTFORMDL 빠른 "나무산!" 이후, 당신과 카구야는 비아쿠렌에게 빠르게 사과하기로 결정한다.
				CASE MAP里
					PRINTFORMDL 당신은 마을 사람들에게 작은 패닉을 일으키는 결과를 초래한다.
					PRINTFORMDL 마을 장로들은 당신과 카구야의 부주의에 대해 꾸짖고, 당신은 재빨리 사과한다.
				CASE MAP湖
					PRINTFORMDL 당신은 스칼렛 데빌 맨션에 피해를 입히게 된다.
					PRINTFORMDL 레밀리아는 당신을 꾸짖지만, 마치 이것이 자신에게 드문 상황이 아닌 것처럼 오히려 체념한 듯 보인다.
				CASE MAP竹林
					PRINTFORMDL 너는 결국 대나무 숲에 불을 지르게 된다.
					PRINTFORMDL 비록 네가 불을 빨리 끄는 데 성공했지만, 에린에게 꾸중을 듣게 된다.
				CASE MAP森
					PRINTFORMDL 당신은 많은 나무들을 손상시키게 된다.
					PRINTFORMDL 주민들에게 더 이상 적대감을 드러내고 싶지 않아, 당신과 카구야는 그들에게 사과하기로 결정한다.
				CASE MAP冥界
					PRINTFORMDL 정의와 불의부(Ministry of Right and Wrong)가 교차 사격에 휘말렸다.
					PRINTFORMDL 저승의 긴 설교를 들은 후, 두 사람은 자신의 부주의에 대해 사과했다.
				CASE MAP山麓
					PRINTFORMDL 어떤 가파리 기계 장치들이 파괴되었다.
					PRINTFORMDL 분노한 가파리 무리를 마주하고, 당신은 사과하기로 결정한다.
				CASE MAP山頂
					PRINTFORMDL 당신은 케이블카를 손상시킨다.
					PRINTFORMDL 온바시라가 던진 공격을 간신히 피한 후, 두 사람은 카나코에게 사과한다.
				CASE MAP地底
					PRINTFORMDL 당신은 오니들 사이에서 소동을 일으키게 된다.
					PRINTFORMDL 유우기는 혼란 속에서 당신을 붙잡고, 사과 대신 그녀에게 술을 대접하게 한다.
					CALL LOST_MONEY_YEN(20000, 1)
					GOTO SKIPPAYMENT
				CASE MAP月
					PRINTFORMDL 당신은 수도의 일부 건물들을 손상시키게 된다.
					PRINTFORMDL 무장한 루나리안 경비대 부대가 도착하기 전에 카구야를 급히 숨긴 후, 당신은 그들에게 혼자 사과한다.
			ENDSELECT
			PRINTFORMDL 발생한 피해가 상당히 크고, 당신은 수리비를 지불해야 한다.
			CALL LOST_MONEY_YEN(50000, 1)
			$SKIPPAYMENT
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「후훗, 우리 너무 심하게 나갔나 봐요, 남편.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「다음엔 더 조심해야겠어.」
			ELSE
				PRINTFORMW 「정말 허술했어.」
			ENDIF
		ELSE
			IF ABL:MASTER:戦闘能力 == ABL:戦闘能力
				SELECTCASE ABL:MASTER:戦闘能力
					CASE 4
						PRINTFORMDL 둘 다 실력이 비슷해서 연습하는 동안 서로에게 많은 것을 배운다.
					CASE 5
						PRINTFORMDL 두 분 모두 강력한 전투원이기에 서로의 탄막으로부터 많은 것을 배운다.
					CASE 6
						PRINTFORMDL 두 분 모두 긴소쿄 최고의 인물들 중 한 명들이기에, 수련을 통해 기술을 더욱 연마할 수 있었다.
				ENDSELECT
			ELSEIF ABL:MASTER:戦闘能力 > ABL:戦闘能力
				PRINTFORMDL 카구야는 당신이 그녀와 함께 연습하는 것을 주의 깊게 지켜본다.
			ELSEIF ABL:MASTER:戦闘能力 < ABL:戦闘能力
				PRINTFORMDL 카구야는 당신에게 주의를 기울이라고 재촉하며 자신의 단막을 시연한다.
			ENDIF
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「도와주셔서 감사합니다, 남편. 카구야는 당신과 함께 연습하게 되어 기뻤어요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「%CALLNAME:MASTER%님, 감사합니다. 정말 도움이 되었어요.」
		ELSE
			PRINTFORMW 「잘했어. 나중에 다시 부탁할지도 몰라.」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「나의 남편, 카구야가 궁금해하는 것이 있어.」
			PRINTFORML 「그것을 그녀에게 설명해 줄 수 있겠어?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「무언가 궁금한 게 있어.」
			PRINTFORML 「그것에 대해 아는 것이 있나요, %CALLNAME:MASTER%?」
		ELSE
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%(는) 상당히 잘 아시는 것 같군요.」
			PRINTFORML 「Perhaps you could explain this for me.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「고마워, 내 남편. 카구야가 더 알고 싶어-」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「이것에 대해 더 알고 싶은 것이 있어-」
		ELSE
			PRINTFORMW 「무엇을 알고 있나-」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			;PRINTFORMW 「Reading with Kaguya for Kaguya~」
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「찾는 것이 있나요, 남편?」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「뭐 찾으세요?」
			ELSE
				PRINTFORMW 「참고 자료를 찾으시나요?」
			ENDIF
			RETURN 1
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			SELECTCASE CLIENT_ID
				CASE [[鈴仙]], [[てゐ]], [[永琳]]
					PRINTFORML 「%CALLNAME:CLIENT_ID%에게 무언가를 부탁했나요?」
					PRINTFORMW 「\@ (TALENT:妄信 && TALENT:MASTER:追加種族 == 4) ? 카구야 # 나 \@ 가 당신을 도울 수 있도록 허락해 주세요.」
				CASE [[妹紅]]
					PRINTFORMW 「모코우가 이걸 이해할 수 있을지는 의심이다.」
				CASEELSE
					IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
						PRINTFORMW 「무엇을 찾고 계신가요, 남편? 카구야가 도울 수 있는 만큼 최대한 도와드릴게요.」
					ELSEIF TALENT:恋慕 || TALENT:思慕
						PRINTFORMW 「당신은 무엇에 관심이 있나요, %CALLNAME:MASTER%? 제가 찾는 것을 도와드릴게요.」
					ELSE
						PRINTFORMW 「뭐 찾으세요?」
					ENDIF
			ENDSELECT
			RETURN 1
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMDW 카구야는 당신을 간절하게 바라보며 대답을 기다린다.
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMDW 카구야는 당신이 설명을 시작하는 것을 주의 깊게 지켜본다.
			ELSE
				PRINTFORMDW 카구야가 당신에게 대답을 하라고 손짓한다.
			ENDIF
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					PRINTFORMW 「흥미롭군. 상당히 흥미롭네.」
					RETURN 1
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					PRINTFORMW 「꽤 흥미로운 책이군요.」
					RETURN 1
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORMW 「카구야는 이제 이해했다. 당신의 설명은 너무 간결하고 이해하기 쉽구나, 나의 남편.」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「아, 이런 식으로 작동하는 거군요. 당신은 정말 능숙하시네요, %CALLNAME:MASTER%.」
				ELSE
					PRINTFORMW 「알겠다. 응, 그걸로 충분할 거야.」
				ENDIF
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORMW 「미안해, 남편이지만 카구야는 아직 이해하지 못하고 있어.」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「제대로 이해한 것 같지 않아요. 이제 모든 게 더 복잡하게 들려요.」
				ELSE
					PRINTFORML 「정말 무슨 말을 하는 건지 알고는 있는 거야?」
					PRINTFORMW 「네가 하는 말 중 이해되는 게 없어.」
				ENDIF
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「도와주셔서 감사합니다, 남편. 카구야는 당신에게 많은 것을 배웠어요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. 당신의 노력에 감사드립니다.」
		ELSE
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. 잘 해냈습니다.」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「걱정할 필요 없어, 내 남편. 카구야는 이해할 때까지 그저 더 공부하면 돼.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「어쩌면 이 일은 에이린에게 직접 물어봐야 할지도 모르겠군.」
		ELSE
			PRINTFORMW 「이건 완전히 시간 낭비였어.」
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼07：大掃除が終わらない
;==================================================

@M_KOJO_IRAI_7_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  SAME_ROOM
SAME_ROOM = CFLAG:TARGET:初期位置 == CFLAG:MASTER:初期位置
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「나의 남편 카구야는 \@ SAME_ROOM ? 우리의 # 그녀가 있는 \@ 방이 새해를 위해 완벽하게 준비되기를 바란다.」
			PRINTFORML 「그녀와 함께하고 싶으신가요?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「새해가 다가오니 \@ SAME_ROOM ? 우리의 # 나의 공간을 철저히 청소할 때다. \@」
			PRINTFORML 「나와 같이 해줄래?」
		ELSE
			PRINTFORML 「새해가 다가오니 방을 깨끗하게 청소하고 싶습니다.」
			PRINTFORML 「많은 일이 걸리기 때문에 도움을 주시면 정말 감사하겠습니다.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「카구야는 이해한다. 비록 카구야가 남편과 함께 이것을 하고 싶었겠지만, 그녀는 스스로 할 것이다.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「알겠다, 그럼 내가 직접 할게.」
			PRINTFORMW 「마음이 바뀌면 나를 찾아와라.」
		ELSE
			PRINTFORML 「좋아, 그럼.」
			PRINTFORMDL 카구야는 몸을 돌려 떠났다.
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「고마워요, 남편. 할 일이 많으니 바로 일하자.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「감사합니다. 시간이 좀 걸릴 테니 바로 시작합시다.」
		ELSE
			PRINTFORMW 「당분간 바쁠 테니, 지체하지 말자.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「무슨 일 있었어? 뭐, 그럴 거면 카구야가 직접 할 테니까.」
			PRINTFORMDW 카구야는 화난 것처럼 행동하지만, 분명 실망한 표정을 짓고 있었다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「알겠어. 그럼 내가 직접 해야겠군.」
		ELSE
			PRINTFORMW 「이 일을 하고 싶지 않았다면 애초에 도와주겠다고 약속하지 말았어야 했다.」
		ENDIF
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「응? 모든 게 벌써 정리됐어? 내 남편, 당신이 이걸 한 거야?」
				PRINTFORMW 「당신은 정말 대단해.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「기다려, 모든 것이 이미 청소되고 정리되어 있어.」
				PRINTFORMW 「이게 어떻게 일어날 수 있었는지 이해가 안 가네.」
			ELSE
				PRINTFORML 「이건 이상하네. 누가 내 방에 들어왔나?」
				PRINTFORML 「아니, 도둑이 모든 걸 치우기로 결정했을 거라고는 상상할 수 없어.」
				PRINTFORMDW 카구야는 임무가 이미 완료된 것을 보고 어안이 벙벙해진다.
			ENDIF
			;keep track of not having done any work
			LOCAL = 1
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			IF SAME_ROOM
				PRINTFORML 「시작해서 우리 방을 다시 예쁘게 만들자.」
			ELSEIF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「후후. 내 남편이 오늘 나와 함께 있어서 기쁘네.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"와")% 함께 있어 기뻐요. 혼자서는 항상 힘들어요.」
			ELSE
				PRINTFORML 「시작하자. 해야 할 일이 많다.」
			ENDIF
			PRINTFORMDW 당신과 카구야는 구석구석을 청소하며 모든 것을 철저히 닦고 그녀가 더 이상 필요 없는 것은 모두 버린다. 
			LOCAL = 0
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF LOCAL
			PRINTFORMW 「어떻게 일어났는지는 여전히 이해가 안 되지만, 모든 것이 순조롭다.」
		ELSE
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「이제 정말 멋져 보여요, 남편.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「그래, 이래야지.」
			ELSE
				PRINTFORMW 「수고했어. 예상했던 것보다 훨씬 좋아 보이네.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		RETURN 0
	CASE "失敗報告時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMDL 카구야는 당신을 보며 실망한 표정을 짓는다.
			PRINTFORMDW 그녀는 당신이 자신의 방을 도와주는 것을 잊은 것에 대해 꽤 속상해하는 것 같다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「%CALLNAME:MASTER%, 지킬 수 없는 약속은 하지 않는 게 좋아.」
		ELSE
			PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 정말 다른 사람을 이렇게 대하는 거야?」
			PRINTFORMW 「좋아, 뭐 어때. 이미 해결됐으니까.」
		ENDIF
		YOGORE:(GET_CHARAHOME(TARGET)) = 0 ;room is cleaned regardless
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
