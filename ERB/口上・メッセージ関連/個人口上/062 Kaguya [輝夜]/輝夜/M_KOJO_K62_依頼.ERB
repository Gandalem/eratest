#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼実行直前"
	IF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P213鈴奈庵) || IS_HERE([[小鈴]])
		PRINTFORMDL You see Kaguya with a book in her hands. Perhaps she was already about to return it.

		IF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P213鈴奈庵)
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「My husband, could you wait for a little while?」
				PRINTFORMW 「Kaguya needs to return this to the bookstore.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「Hello %CALLNAME:MASTER%.」
				PRINTFORMW 「Please excuse me, I just need to return this.」
			ELSE
				PRINTFORMDW Kaguya pays you no mind as she walks up to the counter.
			ENDIF
		ELSEIF IS_HERE([[小鈴]])
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「A thousand pardons, my husband, but Kaguya really needs to go to the bookstore to return this.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「Please excuse me, %CALLNAME:MASTER%, but I really need to return this book.」
			ELSE
				PRINTFORMW 「Hello, %CALLNAME:MASTER%. Is there something you need from me?」
			ENDIF
		ENDIF
	ELSE
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「Is there something you require of me, my husband?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「Can I help you with something, %CALLNAME:MASTER%?」
		ELSE
			PRINTFORMW 「Is there something you need from me?」
		ENDIF
	ENDIF
	RETURN 1
CASE "依頼実行直後"
	IF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P213鈴奈庵) && IS_HERE([[小鈴]])
		CALL CHARA_TEXT([[小鈴]], "Ah, Kaguya-san. Welcome!")
		CALL CHARA_TEXT([[小鈴]], "Did you come here to return a book?")
		PRINTFORML 「Yes, here it is. Please accept my apologies for my tawdriness. It simply was so enjoyable that I couldn't bear to part with it yet.」
		CALL CHARA_TEXT([[小鈴]], "That's alright. I'm just happy you enjoyed it.")
		CALL CHARA_TEXT([[小鈴]], "While you're here, is there any other book you're interested in?")
		PRINTFORML 「This one looks interesting, or perhaps this one...」
		PRINTFORMDL While Kaguya searches for a new book, Kosuzu turns to face you.
		CALL CHARA_TEXT([[小鈴]], @"I guess it wasn't necessary to ask for your help, %CALLNAME:MASTER%-san. Well, it's alright. I'll still pay you for your help.", "w")
	ELSEIF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P213鈴奈庵)
		PRINTFORMDW Kaguya returns the book to the girl behind the counter, apologizing for the delay.
	ELSEIF IS_HERE([[小鈴]])
		CALL CHARA_TEXT([[小鈴]], "Ah, Kaguya-san. Is that the book you borrowed?")
		PRINTFORML 「Yes, I was just about to return it. Please accept my apologies for the delay.」
		CALL CHARA_TEXT([[小鈴]], "That's okay. Please come back if there's anything else you'd like to borrow.")
		CALL CHARA_TEXT([[小鈴]], @"I guess it wasn't necessary to ask for your help, %CALLNAME:MASTER%-san. Well, it's alright. I'll still pay you for your help.", "w")
	ELSE
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「You're here for the book Kaguya borrowed?」
			PRINTFORML 「Oh no, Kaguya completed forgot about that.」
			PRINTFORMW 「Here it is. Please give my apologies to the bookstore girl as well.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「The book I borrowed?」
			PRINTFORML 「Ah, I completely forgot about that.」
			PRINTFORMW 「Here you go. Please tell the bookstore girl that I'm sorry for forgetting about this.」
		ELSE
			PRINTFORML 「You're here on the behalf of the bookstore?」
			PRINTFORMW 「Here's the book I borrowed. My apologies for the delay.」
		ENDIF
	ENDIF
	RETURN 1
ENDSELECT

@M_KOJO_IRAI_BOOK_RETRIEVAL_FEES_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼実行直前"
	CALL M_KOJO_IRAI_BOOK_RETRIEVAL_K62(ROLE, SCENE, CLIENT_ID)
	RETURN 1
CASE "依頼実行直後"
	IF TFLAG:194 == 0 ;paid fees
		IF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P213鈴奈庵) && IS_HERE([[小鈴]])
			CALL CHARA_TEXT([[小鈴]], "Ah, Kaguya-san. Welcome!")
			CALL CHARA_TEXT([[小鈴]], "Did you come here to return a book?")
			PRINTFORML 「Yes, here it is. Please accept my apologies for my tawdriness. It simply was so enjoyable that I couldn't bear to part with it yet.」
			CALL CHARA_TEXT([[小鈴]], "That's alright. But, given how late it is, I must ask you to pay a late fee, please.")
			PRINTFORML 「Of course. That's only natural, is it not? Here you go. Again, my apologies for the trouble I caused.」
			CALL CHARA_TEXT([[小鈴]], @"I guess it wasn't necessary to ask for your help, %CALLNAME:MASTER%-san. Well, it's alright. I'll still pay you for your help.", "w")
		ELSEIF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P213鈴奈庵)
			PRINTFORMDL Kaguya returns the book to the girl behind the counter, apologizing for the delay.
			PRINTFORMDL When the girl brings up late fees, Kaguya quickly pays them alongside another apology.
		ELSEIF IS_HERE([[小鈴]])
			CALL CHARA_TEXT([[小鈴]], "Ah, Kaguya-san. Is that the book you borrowed?")
			PRINTFORML 「Yes, I was just about to return it. Please accept my apologies for the delay.」
			CALL CHARA_TEXT([[小鈴]], "That's alright. But, given how late it is, I must ask you to pay a late fee, please.")
			PRINTFORML 「Of course. That's only natural, is it not? Here you go. Again, my apologies for the trouble I caused.」
			CALL CHARA_TEXT([[小鈴]], @"I guess it wasn't necessary to ask for your help, %CALLNAME:MASTER%-san. Well, it's alright. I'll still pay you for your help.", "w")
		ELSE
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「You're here for the book Kaguya borrowed?」
				PRINTFORML 「Oh no, Kaguya completed forgot about that.」
				PRINTFORML 「Here it is. Please give my apologies to the bookstore girl as well.」
				PRINTFORMDL You tell Kaguya that there's a fee involved due to the extreme delay.
				PRINTFORMW 「Of course, here you go, my husband. Kaguya will endeavor to remember it next time.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「The book I borrowed?」
				PRINTFORML 「Ah, I completely forgot about that.」
				PRINTFORML 「Here you go. Please tell the bookstore girl that I'm sorry for forgetting about this.」
				PRINTFORMDL You tell Kaguya that there's a fee involved due to the extreme delay.
				PRINTFORMW 「I see. Here it is. My apologies for causing so much trouble.」
			ELSE
				PRINTFORML 「You're here on the behalf of the bookstore?」
				PRINTFORML 「Here's the book I borrowed. My apologies for the delay.」
				PRINTFORMDL You tell Kaguya that there's a fee involved due to the extreme delay.
				PRINTFORMW 「I understand. Here you go. My apologies for all this.」
			ENDIF
		ENDIF
	ELSEIF TFLAG:194 == 1 ;fought player, player won
		PRINTFORMW 「Ow ow ow.」
	ELSEIF TFLAG:194 == -1 ;fought player, player lost
		PRINTFORMW 「Perhaps now you've learned to not attempt to threaten your betters.」
	ELSEIF TFLAG:194 == -2 ;player pays instead
		PRINTFORMW 「I see that you're at least smart enough not to pick fights you cannot win.」
	ELSEIF TFLAG:194 == -3 ;threatened with reimu
		PRINTFORMW 「Hmph. What kind of coward would make the shrine maiden fight %HIS_HER(MASTER)% battles for %HIM_HER(MASTER)%.」
	ENDIF
	RETURN 1
CASE "REFUSAL_DIALOGUE"
	PRINTFORML 「Ah yes, I forgot about that book.」
	PRINTFORML 「Here you go.」
	PRINTFORMDL You tell Kaguya that there's a fee involved due to the extreme delay.
	PRINTFORMW 「A fee? I've already returned the book, haven't I? It sounds like you're simply trying to extort me.」
	RETURN 1
CASE "PAYS_UP"
	IF TALENT:機嫌 >= 0 || IS_FALLEN(TARGET) || IS_HERE([[小鈴]]) ;kaguya always pays, except if she's in a bad mood and doesn't have any fall state and kosuzu isn't present
		RESULT:100 = 1 ;always pays
	ELSE
		RESULT:100 = 0 ;normal calculation
	ENDIF
	RETURN 1
ENDSELECT
