SELECTCASE SCENE
	CASE "依頼提示時"
		SELECTCASE TALENT:音楽知識
			CASE 1
				LOCALS = 악기
			CASE 2
				LOCALS = 노래하는 것
			CASE 3
				LOCALS = 춤추는
		ENDSELECT
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「카구야는 오늘 자신의 %LOCALS%를 연습하고 싶어 해. 나랑 같이 해줄래, 여보?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「나 %LOCALS%를 좀 연습할 생각이야. 나랑 같이 할래?」
		ELSE
			PRINTFORML 「%LOCALS%」 연습하고 싶어. 원하면 나랑 같이 해도 돼.
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		;skip normal text
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【W ［あなた］は［彼女］と遊んだ】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		SELECTCASE TFLAG:193
			CASE 3
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORMW 「괜찮아, 남편? 뭔가 정신이 팔려 보여.」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「오늘은 잘 안 되는 것 같아. 다음에 다시 시도해 보자.」
				ELSE
					PRINTFORML 「이리 와요, %CALLNAME:MASTER%. 적어도 좀 집중해 봐요.」
				ENDIF
			CASE 2,1,0 ;successes
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORMW 「후후, 카구야는 아주 즐거운 시간을 보냈다.」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「우리는 좋은 한 쌍이 되는 것 같다, %CALLNAME:MASTER%님.」
				ELSE
					PRINTFORMW 「좋은 세션이었어.」
				ENDIF
		ENDSELECT
		RETURN 1
	CASE "成功報告時"
		;報酬：好感度と信頼度のみ（機嫌が良くなる）
		;【▲上の口上から続き】
		;【◆口上】
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
