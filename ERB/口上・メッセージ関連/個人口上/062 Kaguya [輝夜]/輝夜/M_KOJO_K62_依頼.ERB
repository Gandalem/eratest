; Modular ERB: 個人口上/062 Kaguya [輝夜]/輝夜/M_KOJO_K62_依頼.ERB
;custom, entire file is original content
;==================================================
;依頼口上・各依頼で共通の口上
;==================================================

@M_KOJO_IRAI_K62(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
#DIMS IRAI_NAME;依頼名
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
IRAI_NAME = %STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)%
RESULT = 0
IF CHK_ID > 100
	TRYCALLFORM M_KOJO_IRAI_%IRAI_NAME%_K62(ROLE, SCENE, CLIENT_ID)
ELSE
	TRYCALLFORM M_KOJO_IRAI_{CHK_ID}_K62(ROLE, SCENE, CLIENT_ID)
ENDIF
SIF RESULT
	RETURN 1
;--------------------------------------------------
;ここにあるのは各依頼で共通の口上です
;依頼ごとの口上を表示した場合は共通の口上は表示されません
;【】で囲ってあるのは口上前後の地の文や発生する処理です
;WAITをするか等の目安にしてください（L,WはそれぞれPRINTFORML,PRINTFORMWの略）
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		;●依頼を持ちかけられる時
		;【W どうやら［彼女］は［あなた］に頼み事があるようだ】
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（受託するかY/N）】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「내 남편이 카구야의 이기적인 요구 중 하나로 당신에게 부담을 줄 수 있을까요?」
			PRINTFORML 「내가 오직 당신에게만 맡기고 싶은 것이 있어요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「시간 좀 있으세요, %CALLNAME:MASTER%?」
			PRINTFORML 「도움을 청할 일이 있습니다.」
		ELSE
			PRINTFORML 「아, 타이밍 좋으시네요, %CALLNAME:MASTER%.」
			PRINTFORML 「도와주셨으면 하는 일이 있습니다.」
		ENDIF
	CASE "依頼非受託時"
		;●内容だけ見て受託しなかった時
		;【L ［あなた］は丁重にお断りした】
		;【◆口上】
		;【W ［彼女］は残念そうな顔をしている】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「알겠어요. 카구야는 남편에게 이런 걸 부탁할 만큼 이기적일 필요는 없죠.」
			PRINTFORML 「이렇게 폐를 끼치려 한 점, 사과드립니다.」
			PRINTFORMDW 카구야는 고개를 숙이고 사과의 말을 전한다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「안타깝지만, 강요하지 않겠어. 아마 다른 때에.」
		ELSE
			PRINTFORML 「알겠어, 유감이다.」
			PRINTFORMW 「아마 내가 너를 과대평가했나 보군.」
		ENDIF
	CASE "依頼受託時"
		;●依頼を受託した時
		;【W ［あなた］は［彼女］の依頼を受けた】
		;【◆口上】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「고마워요, 남편.」
			PRINTFORMW 「Let Kaguya explain the issue further.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. 제가 당신에게 원하는 것을 설명해 드리겠습니다.」
		ELSE
			PRINTFORML 「감사합니다, %CALLNAME:MASTER%님.」
			PRINTFORMW 「당신에게 무엇을 시킬지 말해드리겠습니다.」
		ENDIF
	CASE "依頼確認時"
		;●[366]で依頼内容を依頼人に確認した時
		;【◆口上】
		;【依頼データ表示】
		;【INPUT（破棄するかY/N）】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「무슨 일이야, 내 남편?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「제가 당신을 위해 해드릴 일이 있나요, %CALLNAME:MASTER%?」
		ELSE
			PRINTFORML 「저에게 물어볼 것이 있으신가요, %CALLNAME:MASTER%?」
		ENDIF
	CASE "依頼破棄時"
		;●受託した依頼を破棄する時
		;【◆口上】
		;【W 依頼を破棄しました。】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「알겠다. 카구야가 남편에게 이런 일로 폐를 끼친 것은 이기적인 행동이었다.」
			PRINTFORML 「이렇게 폐를 끼치게 되어 정말 죄송하다.」
			PRINTFORMDW 카구야는 고개를 숙이며 사과했다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「유감이군요.」
			PRINTFORML 「뭐, 적어도 직접 말해주는 도리는 있었네요.」
			PRINTFORMW 「이제 실례하겠습니다. 다른 조치를 취해야 할 것 같으니까요.」
		ELSE
			PRINTFORML 「이걸 하기 싫었다면 처음부터 그렇게 말했어야지, %CALLNAME:MASTER%.」
			PRINTFORML 「이제 갑자기 다른 걸 알아내야겠어.」
			PRINTFORMDL 카구야는 얼굴에 드러난 불쾌한 표정을 숨기려 하지 않았다.
			CALL CHANGE_CFLAG(2, TARGET, -70)
			CALL CHANGE_CFLAG(4, TARGET, -30)
		ENDIF
	CASE "依頼実行直前"
		;●[367]で依頼を実行する時、実行処理の前に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【◆口上】
		;【実行時の地の文・ソース等】
		;【▼下の口上に続く】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
		ENDIF
	CASE "依頼実行直後"
		;●[367]で依頼を実行する時、実行処理の後に呼び出される
		;※依頼によって状況が大きく異なるので共通口上は非推奨
		;【▲上の口上から続き】
		;【◆口上】
		;【達成時・CLIENT：▼下の口上に続く】
		;【達成時・TARGET：忘れずに［依頼主］に報告しよう】
		IF ROLE == "CLIENT"
			;（共通）CLIENT：依頼実行の対象と依頼主（口上主）が同一の場合（主に特訓系ですが一緒に捜索等をした場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ELSEIF ROLE == "TARGET"
			;（共通）TARGET：口上主が依頼実行の対象である場合（主に配達系ですが捜索等をした際、TARGETにしていた場合も含まれます）
			SELECTCASE CFLAG:CLIENT_ID:依頼状況
				CASE 2
					;実行後未解決
				CASE 3
					;実行後達成
				CASE 6
					;実行後失敗（現在「06_誰か教えて！」のみ）
			ENDSELECT
		ENDIF
	CASE "成功報告時"
		;●報告時（成功）
		;【依頼実行と報告が同時の時：▲上の口上から続き】
		;【◆口上】
		;【ソースの入手・アイテム等の報酬獲得】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「고마워요, 남편. 카구야는 당신의 도움에 극도로 감사하고 있어요.」
			PRINTFORMDW 카구야는 감사를 표하며 멋진 목례를 한다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「수고하셨습니다, %CALLNAME:MASTER%. 도움 주셔서 감사합니다.」
			PRINTFORMDW 카구야가 작은 목례를 한다.
		ELSE
			PRINTFORMW 「네, 그것으로 충분할 겁니다. 감사합니다, %CALLNAME:MASTER%님.」
		ENDIF
	CASE "失敗報告時"
		;○直接失敗報告は現在「06_誰か教えて！」のみ
		;●報告忘れ・期限切れになった際、遭遇時の最後に呼び出される
		;（遭遇時）【挨拶等】→【機嫌の良し悪し】→【劣情察知】→【祭日イベント】→【◆ココ！】（尚、依頼失敗判定があるとデートのお誘いは発生しません）
		;【◆口上】
		;○機嫌の変化や追加のペナルティ等は口上側で処理してください
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「죄송해요, 남편. 카구야가 상황을 잘못 판단했어요.」
			PRINTFORML 「이런 방식으로 당신에게 실패한 것에 대해 그녀의 겸허한 사과를 받아주세요.」
			PRINTFORMDW 카구야는 후회를 나타내며 깊게 고개를 숙였다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「그것은 불행하지만, 그런 일은 일어날 수 있는 것.」
			PRINTFORMDW 카구야는 네 실패에 대해 특별히 상심한 것 같지 않다.
		ELSE
			PRINTFORML 「그 특정한 요청을 불가능하다고 생각하지 않았다.」
			PRINTFORML 「다음에는 좀 더 유능한 사람을 찾아야 할지도 모르겠다.」
			PRINTFORMDL 카구야는 경멸의 눈빛으로 당신을 바라본 후 등을 돌린다.
			CALL CHANGE_CFLAG(2, TARGET, -30)
			CALL CHANGE_CFLAG(4, TARGET, -10)
		ENDIF
	CASE "依頼報告不要"
		;○一般依頼では現在「02_お花に水をあげて」「09_誰かの落とし物」のみ
		;●起床時、報告不要依頼を達成していた場合に呼ばれる口上
		;（起床時）【起床メッセージ】→【X時間寝た等】→【◆ココ！】→【おみくじ・補充等】→【一日開始】
		;○地の文はありません
		;○口上主がその場にいなくても表示されます（MASTERが寝る時のイベント口上と同じタイプ）
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「여보, 지난번에 그 일은 잘 마무리된 거예요?」
			PRINTFORML 「아, 벌써 끝내셨군요.」
			PRINTFORML 「도와주셔서 감사합니다, 여보.」
			PRINTFORMDW 카구야는 감사를 표하며 멋지게 인사한다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「내가 당신에게 부탁했던 그 일은 전부 제대로 되었나요, %CALLNAME:MASTER%?」
			PRINTFORMW 「알겠습니다. 그럼 모두 해결된 거군요. 도움 주셔서 감사합니다.」
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 내가 아까 부탁했던 그거 끝냈는지 기억해?」
			PRINTFORMW 「그렇구나. 성공했다니 다행이지만, 다음부터는 좀 더 빨리 알려주면 좋겠어.」
		ENDIF
ENDSELECT
RETURN 1
;==================================================
;依頼口上・一般依頼01：掃除を手伝って
;==================================================

@M_KOJO_IRAI_1_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  SAME_ROOM
SAME_ROOM = CFLAG:TARGET:初期位置 == CFLAG:MASTER:初期位置
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「내 남편은 그것을 카구야가 인정하기에 치욕스럽지만, \@ SAME_ROOM ? 우리의 # 그녀의 \@ 방이 참 견딜 수 없을 정도로 더러워졌다.」
			PRINTFORML 「청소하는 것을 도와줄 수 있겠어?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「솔직히 말하기엔 좀 민망하지만, 내 방이 꽤 더러워졌어.」
			PRINTFORML 「청소하는 것 좀 도와줄 수 있을까?」
		ELSE
			PRINTFORML 「내 방은 청소가 시급하다.」
			IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
				PRINTFORML 「내가 너를 머물게 해주는 만큼, 이건 네가 나에게 할 수 있는 최소한의 일이야.」
			ELSE
				PRINTFORML 「이것은 당신의 가치를 보여줄 좋은 기회입니다.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「카구야는 이해한다. 카구야가 직접 할 것이다.」
			PRINTFORMW 「After all, this too is one of the duties of a wife.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「알겠습니다. 이건 제 책임이니까.」
		ELSE
			;minor trust decrease if living under Kaguya's roof
			IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
				PRINTFORML 「여기에 머물도록 허락한 것에 대한 보답으로 이 정도를 부탁하는 것이 너무 과하다고 생각하지 않았다.」
				PRINTFORML 「좋다. 그럼 네 마음대로 해라.」
				PRINTFORMDW 카구야는 신경 쓰지 않는 듯 행동하지만, 그녀는 당신을 명백히 경멸하는 표정으로 바라본다.
				CALL CHANGE_CFLAG(4, TARGET, -10)
			ELSE
				PRINTFORML 「아쉽네.」
				PRINTFORMDW 카구야는 당신에게 흥미를 잃고 등을 돌린다.
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「고마워요, 남편. 그럼 \@ SAME_ROOM ? 우리 집 # 내 \@ 방으로 가요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「고마워. 그럼 빨리 끝내자.」
		ELSE
			IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
				PRINTFORMW 「아주 좋아. 바로 일하러 가도 돼.」
			ELSE
				PRINTFORMW 「고맙다. 시간 낭비하지 말자.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「다른 일이 생겼나요? 걱정하지 마세요, 남편. 당신이 해야 할 일이 더 중요하니까.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「무슨 일이라도 있었나? 유감하네. 그럼 다른 걸 생각해 볼게.」
		ELSE
			IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
				PRINTFORML 「정말로 그게 당신에게 너무 큰 부탁이었나요?」
				PRINTFORML 「좋아. 네 마음대로 해.」
				PRINTFORMDW 비록 카구야는 신경 쓰지 않는 듯 행동하지만, 그녀는 얼굴에 명백한 경멸을 담고 당신을 바라본다.
				CALL CHANGE_CFLAG(4, TARGET, -25)
			ELSE
				PRINTFORMW 「당신이 약속을 갑자기 어기는 것은 상당히 무례하다는 것을 알아야 한다.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
			;先に掃除してしまっていた場合
			;【◆口上】
			;【W ［彼女］の部屋は十分にきれいだ】
			;【▼そのまま下の口上へ】
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORML 「에, 벌써 청소됐다고? 언제-」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORML 「에, 벌써 깨끗해졌어? 모든 걸 이미 치웠어?」
			ELSE
				PRINTFORML 「이상하네. 혹시 레이선이나 다른 이나바가 이미 청소했나?」
			ENDIF
			PRINTFORMDW 카구야는 자신의 방이 이미 청소되어 있는 것을 보고 혼란스러워했다.
			;keep track of not having done any work
			LOCAL = 1
			RETURN 1
		ELSE
			;一緒に掃除する場合
			;【◆口上】
			;【W ［あなた］は［彼女］と協力して部屋の掃除を行なった】
			;【▼そのまま下の口上へ】
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				IF ABL:MASTER:清掃技能 + ABL:清掃技能 >= 10
					PRINTFORMW 「그럼 시작하자. 우리의 합으로라면 이건 아무것도 아닐 거야.」
				ELSEIF ABL:MASTER:清掃技能 < ABL:清掃技能
					PRINTFORMW 「카구야가 아내로서 자신의 기술을 보여주도록 허락해라.」
				ELSE
					PRINTFORML 「카구야에게 인정하기 부끄럽지만, 그녀의 청소 실력은 남편에 비해 훨씬 떨어진다.」
					PRINTFORMW 「이 부담을 당신에게 지운 것을 용서해 주세요.」
				ENDIF
			ELSEIF TALENT:恋慕 || TALENT:思慕
				IF ABL:MASTER:清掃技能 + ABL:清掃技能 >= 10
					PRINTFORMW 「우리 둘이라면, 이건 그렇게 어렵지 않을 거야.」
				ELSEIF ABL:MASTER:清掃技能 < ABL:清掃技能
					PRINTFORMW 「자, 그럼 오늘 나의 재능을 보여드려야겠군요.」
				ELSE
					PRINTFORML 「카구야에게 인정하기 부끄럽지만, 그녀의 청소 실력은 남편에 비해 훨씬 떨어진다.」
					PRINTFORMW 「이 부담을 당신에게 지운 것을 용서해 주세요.」
				ENDIF
			ELSE
				PRINTFORML 「이제 일해도 되지만, 여기서는 조심해.」
				PRINTFORMDW 카구야는 아무것도 직접 하지 않은 채 다음에 무엇을 청소할지 지시하며 자리에 앉는다.
			ENDIF
			LOCAL = 0
			RETURN 1
		ENDIF
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF LOCAL
			PRINTFORMW 「음, 상황이 예상과 조금 달랐지만, 이제 모든 것이 순조롭다.」
		ELSE
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「후훗, 남편이랑 함께라면 청소조차 즐거워지네.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「오 마이, 그거 정말 빨리 끝났네.」
			ELSE
				PRINTFORMW 「잘했어. 모든 것이 이제 제자리를 찾았군.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：低級素材
		;【▲上の口上から続き】
		;【◆口上】
		;【報酬獲得】
		RETURN 0
	CASE "失敗報告時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「다른 일이 생긴 건 아니야? 걱정하지 마, 나의 남편아.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「모든 게 괜찮아, %CALLNAME:MASTER%완전히 청소하는 걸 잊었네 \@ SAME_ROOM ? 우리의 # 내 \@ 방을.」
		ELSE
			IF GROUPMATCH(拠点_大家, [[輝夜]], [[永琳]])
				PRINTFORMW 「이건 어려운 과제라고 생각하지 않았는데, 정말 너에게 너무 버거웠니?」
				CALL CHANGE_CFLAG(4, TARGET, -40)
			ELSE
				PRINTFORMW 「당신이 그렇게 간단한 임무에 실패할 수 있다는 것을 이해할 수 없다.」
			ENDIF
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
