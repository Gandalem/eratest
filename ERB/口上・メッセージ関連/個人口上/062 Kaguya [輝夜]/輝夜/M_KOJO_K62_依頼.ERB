;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人
			PRINTFORMDL 갑자기 카구야가 당신에게 매달리며 허리를 감싸 안는다.
			PRINTFORMDL 그녀가 느끼는 것을 말로 설명할 필요도 없다. 그녀가 원하는 것은 지금 당장 당신과 섹스하는 것뿐이다.
		ELSE
			PRINTFORML 「내 몸이 타는 것 같다. 이런 상태로는 아무것도 할 수가 없다.」
			PRINTFORML 「당신의 도움에 대가를 지불할 용의가 있으니, 부디 내 스트레스를 해소하기 위해 무슨 일이든 해주세요.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋人
			PRINTFORML 「내 남편이라고?」
			PRINTFORMDW 카구야는 자신의 욕정을 참지 못하고 당신을 강렬한 갈망의 시선으로 바라본다.
		ELSE
			PRINTFORMW 「공주와 함께할 기회를 거절하겠어, 아니면 그냥 겁쟁이인가?」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:恋人
			PRINTFORMDL 그녀의 요청에 동의하자마자 카구야는 당신에게 깊게 입을 맞추며 감사를 전한다.
			PRINTFORMW 「가자...♥」
		ELSE
			PRINTFORMW 「좋아. 조용한 곳으로 가자...」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		PRINTFORMDW 카구야는 자신의 고동치는 몸에 매달려 간신히 자신을 붙잡고 있었다.
		RETURN 1
	CASE "依頼破棄時"
		IF TALENT:恋人
			PRINTFORMDW 카구야는 울음을 터뜨릴 것 같다.
		ELSE
			PRINTFORMW 「흥.」
			CALL CHANGE_CFLAG(2, TARGET, -100)
			CALL CHANGE_CFLAG(4, TARGET, -50)
		ENDIF
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		;【◆口上】
		;【※依頼処理側にある専用口上が表示されます】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人
			PRINTFORMW 「드디어...♥」
		ELSE
			PRINTFORMW 「나도 더 이상 기다릴 수 없어.」
		ENDIF
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人
			PRINTFORML 「당신은 정말 멋졌어요, 나의 남편.」
			PRINTFORMW 「카구야는 완전히 만족한다♥」
		ELSE
			PRINTFORMW 「이제 훨씬 기분이 좋아졌어요. 도움 주셔서 감사합니다, %CALLNAME:MASTER%.」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：\20,000（ホ別）
		IF TALENT:恋人
			PRINTFORMW 「후후. 카구야는 정말 행복해라.」
		ELSE
			PRINTFORMW 「여기에 보상이 있다. 나중에 다시 부를지도 모른다.」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		IF TALENT:恋人
			PRINTFORMW 「나의 남편, 어떻게 카구야를 잊을 수 있었어?」
		ELSE
			PRINTFORMW 「내가 이런 것을 당신에게 부탁한 것은 바보 같은 짓이었다.」
			CALL CHANGE_CFLAG(2, TARGET, -100)
			CALL CHANGE_CFLAG(4, TARGET, -50)
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "UNIQUE_SCENARIO_CHANCE"
		;return the chance (1/X) to select the character's unique scenario instead of a general one
		RESULT:100 = 25 ;25% chance
		RETURN 1
	CASE "UNIQUE_SCENARIO"
		IF TALENT:恋人
			PRINTFORML 「...카구야는 더 이상 기다릴 수 없어♥」
		ELSE
			PRINTFORML 「...여기가 충분히 좋아. 여기서 하자.」
		ENDIF
		PRINTFORMDL 카구야가 그 말을 하자 당신 주변의 공간이 일그러지기 시작한다.
		PRINTFORMDL 바람은 멎고 소리는 고요해지며, 모든 것이 영원을 향해 늘어나는 하나의 순간처럼 희미해진다.
		IF GET_TARGETNUM() > 1
			LOCALS =
			FOR LOCAL, 1, GET_TARGETNUM() + 1
			SIF TARGET:LOCAL == TARGET
				CONTINUE
			LOCALS += @"%CALLNAME:(TARGET:LOCAL)%、"
			NEXT
			PRINTFORMDL %BREAKENG(@"움직이지 않는 %LIST_IN_STRING(LOCALS)%에게 신경 쓰지 않고, 카구야는 너를 오직 너와 그녀만을 위한 이 세계의 그 자리에서 바닥으로 밀어붙인다.")%
		ELSE
			PRINTFORMDL 그녀의 욕망을 더 이상 참지 못한 카구야는 이 영원한 쾌락의 세계에서 당신을 아래로 밀어붙인다.
		ENDIF
		CALL HIMESAMA_OTANOSHIMI_HANYOU(3)
		RETURN 1
ENDSELECT
;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================

@M_KOJO_IRAI_16_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「카구야에게 계속 신경 쓰이는 일이 있다.」
			PRINTFORML 「부인께 조언을 해 주실 수 있나요, 남편?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「최근 나를 괴롭히는 일이 있었다.」
			PRINTFORML 「내 말을 들어줄 수 있겠어, %CALLNAME:MASTER%?」
		ELSE
			PRINTFORML 「뭔가 걱정하고 있었어.」
			PRINTFORML 「외부의 의견이 도움이 될 거야.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「고마워요, 남편.」
			PRINTFORMW 「이것에 대해 의견을 들려줄 수 있나요?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「감사합니다, %CALLNAME:MASTER%님.」
			PRINTFORMW 「이것에 대해 어떻게 생각하세요?」
		ELSE
			PRINTFORML 「감사합니다.」
			PRINTFORMW 「이 일에 대해 어떻게 생각하시나요?」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		IF TFLAG:194
			PRINTFORMW 「후후♥」
		ELSEIF TFLAG:193 == 1
			;正解の選択肢
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「물론이죠. 그거 정말 좋은 생각이네요, 여보.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「그래, 좋은 생각이야.」
			ELSE
				PRINTFORMW 「응, 충분히 말이 되네.」
			ENDIF
		ELSEIF TFLAG:193 == 2
			;ハズレの選択肢だったが逆に正解
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「가구야의 남편에게 그런 기발한 아이디어가 떠오리도록 맡기자.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「그렇게 생각해 본 적은 없지만, 좋은 생각이야.」
			ELSE
				PRINTFORMW 「내가 생각했던 것과는 조금 다르지만, 그래도 괜찮을 거야.」
			ENDIF
		ELSEIF TFLAG:193 == -1
			;ハズレの選択肢
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「아니, 그게 좀 맞지 않는 것 같아.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「아니, 그건 현명하지 않다고 생각해.」
			ELSE
				PRINTFORMW 「음, 네게서 기대했던 건 여기까지인 것 같군.」
			ENDIF
		ELSEIF TFLAG:193 == -2
			;正解の選択肢だったが逆にハズレ
			IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
				PRINTFORMW 「그거 좀 지루하게 들리네요.」
			ELSEIF TALENT:恋慕 || TALENT:思慕
				PRINTFORMW 「이미 그것도 생각해 봤지만, 내가 찾던 건 아니야.」
			ELSE
				PRINTFORMW 「그 아이디어는 좀 너무 전형적이야. 나는 정말 다른 것을 찾고 있었어.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：野菜か果物
		RETURN 0
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "口上委託率"
		;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
		IF !(TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4))
			RESULT:100 = 0
		ELSEIF !CFLAG:1094
			RESULT:100 = 100 ;first one's free
			CFLAG:1094 = 1
		ELSE
			RESULT:100 = 25
		ENDIF
		;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
		;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
		;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
		;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
		RESULT:1 = 0
		RESULT:2 = 0
		RESULT:19 = 1 ;everyone loves kaguya
		RETURN 1
	CASE "口上専用"
		;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
		;16,お悩み相談 の場合
		;RESULT        発生判定,0だと発生しません
		;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
		;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
		;RESULTS:0     お悩み文章（自動で『』で囲まれます）
		;RESULTS:1～3  選択肢１～３
		;何も発生しない状態になると無限ループになるので注意してください
		;●追記メモ
		;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
		;RESULT:1を7にするとどれも正解になります
		;RESULT:1を8にするとどれもハズレになります
		;1～3以外の場合は逆張り判定が自動で無くなります
		RESULT = 0
		TFLAG:194 = 1
		SELECTCASE RAND:2
			CASE 0
				RESULTS:0 = Who do you love most of all?
				RESULTS:1 = Kaguya
				RESULTS:2 = Kaguya
				RESULTS:3 = Kaguya
				RESULT:1 = 7
				RESULT:2 = 1
			CASE 1
				RESULTS:0 = What part of Kaguya do you like the most?
				RESULTS:1 = Her hair
				RESULTS:2 = Her face
				RESULTS:3 = That thing she does when she covers her mouth with her sleeves
				RESULT:1 = 7
				RESULT:2 = 1
		ENDSELECT
		RETURN 1
ENDSELECT
