@M_KOJO_IRAI_9_K62(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  ITEM_OWNER
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「나의 남편 카구야가 땅에 떨어진 것을 발견했지만, 그것이 누구의 것인지 모르고 있다.」
			PRINTFORML 「그 주인을 찾는 것을 도와줄 수 있겠습니까?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「아, %CALLNAME:MASTER%, 타이밍이 좋군요. 이것을 발견했는데 누구의 것인지 모르겠어요.」
			PRINTFORML 「주인을 찾는 것을 도와주시겠어요?」
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%, 이것이 여기 놓여 있는 것을 발견했네. 이 일에 신경 쓸 시간이 없으니, 주인에게 돌려달라고 부탁하고 싶어.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「카구야는 이해한다. 그녀는 자신을 도울 다른 사람을 찾을 것이다.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「알겠다. 그럼 다른 사람에게 부탁할게.」
		ELSE
			PRINTFORMW 「그렇게 되겠군.」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		ITEM_OWNER = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「여기 있어요, 제 남편.」
			IF GROUPMATCH(ITEM_OWNER, [[鈴仙]], [[てゐ]], [[妹紅]], [[永琳]]) || RELATION:ITEM_OWNER > 100
				PRINTFORMW 「어딘가 익숙한 것 같지만, 카구야는 그것이 누구의 소유인지 기억해낼 수 없다.」
			ELSE
				PRINTFORMW 「누구의 것인지 알게 되면, 그분께 돌려주세요.」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「이것이 내가 말하고 있던 대상이다.」
			IF GROUPMATCH(ITEM_OWNER, [[鈴仙]], [[てゐ]], [[妹紅]], [[永琳]]) || RELATION:ITEM_OWNER > 100
				PRINTFORMW 「다소 익숙해 보이지만 누구의 것인지 모르겠군.」
			ELSE
				PRINTFORMW 「누구의 것인지 알게 되면, 그분께 돌려주세요.」
			ENDIF
		ELSE
			PRINTFORML 「이것이 내가 찾은 것이다.」
			IF GROUPMATCH(ITEM_OWNER, [[鈴仙]], [[てゐ]], [[妹紅]], [[永琳]]) || RELATION:ITEM_OWNER > 100
				PRINTFORMW 「조금 친숙해 보인다. 그러니 소유자는 근처에 있을 것이다.」
			ELSE
				PRINTFORMW 「이것이 누구의 소유인지 알아내고 그들에게 돌려주세요.」
			ENDIF
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では落とし物を渡される側の口上です
		;【◆口上】
		;【W ［あなた］は［彼女］に預かっていた落とし物を返した】
		;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「음, 무슨 일이니, 내 남편?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「무슨 일 있습니까, %CALLNAME:MASTER%?」
		ELSE
			PRINTFORMW 「나에게 필요한 것이 있나요?」
		ENDIF
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORML 「아, 카구야가 잃어버렸던 중요한 보물이군요.」
			PRINTFORML 「카구야에게 이걸 돌려주셔서 고마워요, 남편. %CALLNAME:CLIENT_ID%께도 제 인사를 전해주세요.」
			PRINTFORMDW 카구야는 당신에게 감사를 표하며 아름다운 활을 건넨다.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORML 「아, 이걸 잃어버린 줄 알았는데.」
			PRINTFORML 「이걸 돌려주셔서 감사합니다. %CALLNAME:CLIENT_ID%께도 제 인사를 전해주세요.」
			PRINTFORMDW 카구야는 당신에게 고맙다는 말을 하며 아름다운 절을 한다.
		ELSE
			PRINTFORML 「아, 벌써 찾았군.」
			PRINTFORMW 「%조사처리(CALLNAME:MASTER,"에게")% 이것을 가져다줘서 고맙네. %CALLNAME:CLIENT_ID%에게도 내 감사를 전해주게.」
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：上級素材
		ITEM_OWNER = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:依頼内容))
		IF GROUPMATCH(ITEM_OWNER, [[鈴仙]], [[てゐ]], [[妹紅]], [[永琳]]) || RELATION:ITEM_OWNER > 100
			PRINTFORML 「전부터 전부 %CALLNAME:ITEM_OWNER%의 것이었다니...」
		ENDIF
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「나를 위해 이걸 돌려줘서 고마워요, 남편. 카구야는 그것이 올바른 주인에게 돌아왔다는 소식을 듣고 안심했어요.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「감사합니다, %CALLNAME:MASTER%. %CALLNAME:ITEM_OWNER%께서 매우 걱정하셨을 거라고 확신해요.」
		ELSE
			PRINTFORMW 「수고했어, %CALLNAME:MASTER%. 이걸 나를 위해 처리해줘서 고마워.」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
