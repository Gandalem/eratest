	ELSE
		PRINTFORML 「You seem to be pretty knowledgeable, %CALLNAME:MASTER%.」
		PRINTFORML 「Perhaps you could explain this for me.」
	ENDIF
	
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「Thank you, my husband. Kaguya wants to know more about-」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「This is what I would like to know more about-」
	ELSE
		PRINTFORMW 「What do you know about-」
	ENDIF
	
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
	;［しらべもの］と［教えてあげる］が重なっている場合
	;【◆口上】
	;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
	;【L ここなら役に立つ資料が見つかりそうだ】
	;【INPUT（しらべもの/教えてあげる）】
	;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
	;【▼そのまま下の口上へ】
	;【教えてあげる＞［教えてあげる］へジャンプ】
	;PRINTFORMW 「Reading with Kaguya for Kaguya~」
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「Is there something you are looking for, my husband?」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「Are you looking for something?」
		ELSE
			PRINTFORMW 「Are you looking for reference materials?」
		ENDIF
		
		RETURN 1
	ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
	;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
	;【◆口上】
	;【［あなた］は［現在地］で調べ物をした】
	;【▼そのまま下の口上へ】
		SELECTCASE CLIENT_ID
			CASE [[鈴仙]], [[てゐ]], [[永琳]]
				PRINTFORML 「Did %CALLNAME:CLIENT_ID% ask you for something?」
				PRINTFORMW 「Allow \@ (TALENT:妄信 && TALENT:MASTER:追加種族 == 4) ? Kaguya # me \@ to help you.」
			CASE [[妹紅]]
				PRINTFORMW 「I doubt Mokou would even be able to understand this.」
			CASEELSE
				IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
					PRINTFORMW 「Are you looking for something, my husband? Please allow Kaguya to help you as much as she can.」
				ELSEIF TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「What are you interested in, %CALLNAME:MASTER%? Let me help you look.」
				ELSE
					PRINTFORMW 「Are you looking for something?」
				ENDIF
		ENDSELECT
		
		RETURN 1
	ELSE
	;［教えてあげる］時（依頼主がTARGET）
	;【◆口上】
	;【L ［あなた］は［彼女］の疑問に答えた】
	;【成功：［彼女］の疑問は氷解した！】
	;【失敗：［彼女］は納得できなかったようだ……】
	;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMDW Kaguya looks at you eagerly, awaiting your answer.
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMDW Kaguya pays close attention as you begin your explanation.
		ELSE
			PRINTFORMDW Kaguya motions for you to give your answer.
		ENDIF
		
		RETURN 1
	ENDIF
CASE "依頼実行直後"
	;【▲上の口上から続き】
	;【◆口上】
	SELECTCASE CFLAG:CLIENT_ID:依頼状況
	CASE 2
	;［しらべもの］をした時
		IF ROLE == "CLIENT"
		;一緒に［しらべもの］をした時
			PRINTFORMW 「I see. That's quite interesting.」
			
			RETURN 1
		ELSEIF ROLE == "TARGET"
		;依頼主ではない口上主の前で［しらべもの］をした時
			PRINTFORMW 「That's a pretty interesting book.」
			
			RETURN 1
		ENDIF
	CASE 3
	;成功した時
	;【▼そのまま下の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「Kaguya understands it now. Your explanations are so concise and easy to understand, my husband.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「Ah, so that's how it works. You're quite good at this, %CALLNAME:MASTER%.」
		ELSE
			PRINTFORMW 「I see. Yes, that should suffice.」
		ENDIF
		
		RETURN 1
	CASE 6
	;失敗した時
	;【▼そのまま失敗報告時の口上へ】
		IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
			PRINTFORMW 「I'm sorry, my husband, but Kaguya still doesn't understand it.」
		ELSEIF TALENT:恋慕 || TALENT:思慕
			PRINTFORMW 「I don't think I quite get it. It all sounds even more complicated now.」
		ELSE
			PRINTFORML 「Do you actually have any idea what you're talking about?」
			PRINTFORMW 「Nothing you say makes any sense.」
		ENDIF
		
		RETURN 1
	ENDSELECT
CASE "成功報告時"
;報酬：\500
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「Thank you for your aid, my husband. Kaguya learned a lot from you.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「Thank you, %CALLNAME:MASTER%. I appreciate your efforts.」
	ELSE
		PRINTFORMW 「Thank you, %CALLNAME:MASTER%. You did well.」
	ENDIF
	
	RETURN 1
CASE "失敗報告時"
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
		PRINTFORMW 「No need to worry, my husband. Kaguya will simply study more until she understands it.」
	ELSEIF TALENT:恋慕 || TALENT:思慕
		PRINTFORMW 「Perhaps I should just ask Eirin about this.」
	ELSE
		PRINTFORMW 「This turned out to be a complete waste of time.」
	ENDIF
	
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

