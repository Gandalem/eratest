; Modular ERB: 個人口上/107 Seiran [清蘭]/清蘭/M_KOJO_K107_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;ブチギレ口上はナイトメアダイアリー風

@M_KOJO_MESSAGE_COM_K107_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF ALCOHOL_FACE(107) == "酔いどれ" || ALCOHOL_FACE(107) == "ぐでぐで"
			PRINTFORMW 「아아~응? 와라시라고 해서 뭐얏~! 잠시만 기다려 보라고오!!」
		ELSEIF TALENT:107:機嫌 == -1 || CFLAG:107:ブチギレ || MARK:107:反発刻印 >= 3
			PRINTFORML 「탄환 '이글 슈팅'」
			SETCOLOR 0xC07070
			PRINTFORMW 세이란이 갑자기 덤벼왔다!!
			;あなた戦闘能力1以下
		ELSEIF ABL:MASTER:戦闘能力 < 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「%CALLNAME:MASTER%!! 이 정도가 피할 수 있을 거라고 생각하는 거야!」
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%……나를 하찮게 보고 방심하면 안 돼읏!」
				CASE 2
					PRINTFORMW 「제가 지상인…… 그것도 %CALLNAME:MASTER%같은 사람한테 질 리가 없잖아요!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					;あなた戦闘能力4以上
					IF ABL:MASTER:戦闘能力 >= 4
						PRINTFORMW 「보여줄게 %CALLNAME:MASTER%! 달을 조사하는 부대원인 나의 실력을 말이야!」
					ELSE
						PRINTFORMW 「좋아! 승부야 %CALLNAME:MASTER%!」
					ENDIF
				CASE 1
					;清蘭戦闘能力3以上
					IF ABL:戦闘能力 >= 3
						PRINTFORMW 「나도…… 전보다 강해졌단 말이야!」
					ELSE
						PRINTFORMW 「%CALLNAME:MASTER%!! 말해두는데, 봐주진 않을 거야!」
					ENDIF
				CASE 2
					PRINTFORMW 『여기 세이란. 이로써 %조사처리(CALLNAME:MASTER,"의")% 정화 활동에 들어간다』
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 2
			IF ALCOHOL_FACE(107) == "酔いどれ" || ALCOHOL_FACE(107) == "ぐでぐで"
				PRINTFORMW 「끄아아악~~!!」
				PRINTFORML 랜프『○△□×◎※』~~~~!
				PRINTFORMDW 스펠카드명을 듣지 못하여, %조사처리(CALLNAME:MASTER,"는")% 다음에 올 탄막을 예측할 수 없다!
			ELSEIF TALENT:107:機嫌 == -1 || CFLAG:107:ブチギレ || MARK:107:反発刻印 >= 3
				PRINTFORMW 「탄환 『래빗 팔코너』」
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 어느새, 자신의 손에 작은 카메라가 들려 있음을 깨달았다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 무아지경으로, 다가오는 탄막을 향해 셔터를 눌렀다!
			ELSEIF ABL:MASTER:戦闘能力 >= 4
				;あなたの戦闘能力4以上でスペルカード増加
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「크윽...! 달의 토끼를 함부로 대하지 마라!」
						PRINTFORMW 「흉탄 『스피드 스트라이크』!!」
					CASE 1
						PRINTFORML 「아파……지 않아! 승부는 아직부터 시작이라고요!」
						PRINTFORMW 「탄환 『이글 슈팅』!!」
					CASE 2
						;内4人は紺珠伝のプレイアブルキャラ
						PRINTFORML 「우으윽...! 대단하시네요 %CALLNAME:MASTER%...! 여기부터는 저도 본심이에요!」
						PRINTFORMW 「저에게 이걸 쓰게 만든 건 당신이야…… 히이, 후우… 다섯 번째예요!」
						PRINTFORMW 「탄환 '매는 꿰뚫는다'!!」
				ENDSELECT
			ELSE
				PRINTFORML 「아파……지 않아! 승부는 아직부터 시작이라고요!」
				PRINTFORMW 「탄환 『이글 슈팅』!!」
			ENDIF
		ENDIF
	ENDIF
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 1
			IF ALCOHOL_FACE(107) == "酔いどれ" || ALCOHOL_FACE(107) == "ぐでぐで"
				PRINTFORMW 「아아앗 하하핫하~ ♪라노시이이~☆」
				PRINTFORML 「□×○『▼×●◎★※☆』～～～！」
				PRINTFORMDW 세이란은 만취해서 움직임을 읽을 수가 없어! %조사처리(CALLNAME:MASTER,"는")% 아슬아슬하게 피할 뻔했어!
			ELSEIF TALENT:107:機嫌 == -1 || CFLAG:107:ブチギレ || MARK:107:反発刻印 >= 3
				PRINTFORMW 「꿈탄 『루나틱 드림샷』」
				PRINTFORMDL  이 카메라로 탄막을 촬영하면, 사진에 찍힌 부분만 잘려나가듯 소멸하는 모양이다.
				PRINTFORMDW  카메라의 능력을 이해한 %조사처리(CALLNAME:MASTER,"는")%, 계속되는 세이란의 맹공에 대처하기 위해 다시 카메라를 겨누었다!
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「싫어어! 이제 뒤가 없잖아!」
						PRINTFORMW 「이럴 때는… 나의 비장의 무기를 쓸 수밖에 없어ー!」
						PRINTFORMW 「총부 '루나틱 건'!!」
					CASE 1
						PRINTFORML 「으윽…… 이런 식으로는 지겠어, 이대로는 안 돼!」
						PRINTFORMW 「이럴 때는…… 비장의 수라도 써야지~!」
						PRINTFORML 『메데ー 메데ー! 긴급 상황 발생! 지원을 요청합니다! 다시 말하지만... 응원해 주세요...』
						SETCOLOR 0xC07070
						PRINTFORMW  세이란은 동료를 부를 작정이다! 원군이 오기 전에 결판을 내라!
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
	IF LOCAL:1 && ARGS == "被弾"
		IF 相手残機 == 0
			IF ALCOHOL_FACE(107) == "酔いどれ" || ALCOHOL_FACE(107) == "ぐでぐで"
				PRINTFORMW 「크으~……」
			ELSEIF TALENT:107:機嫌 == -1 || CFLAG:107:ブチギレ || MARK:107:反発刻印 >= 3
				PRINTFORML  「………………。」
				PRINTFORMDW  세이란의 공격이 멈춘 동시에 %조사처리(CALLNAME:MASTER,"는")% 의식을 잃었다…….
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「%CALLNAME:MASTER%강하잖아. 싫어아~」
					CASE 1
						PRINTFORMW 「에? 왜 제가 당하고 있는 거예요?」
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【残忍酷薄】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "残忍酷薄"
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【乾坤一擲】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "乾坤一擲"
ENDIF
;-------------------------------------------------
;戦闘中
;TARGETの【怪力乱神】発動時
;ARGはTARGETの残機
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARGS == "怪力乱神"
ENDIF
;-------------------------------------------------
;戦闘後
;記入チェック（=0, 非表示、1, 表示）
LOCAL:1 = 1
;-------------------------------------------------
IF LOCAL:1 && ARGS == "戦闘後"
	PRINTFORML 
	;残り残機4が表示されうるのは【洽覧深識】持ちのみ
	;残機が1以上ならあなたの負け、0の場合はあなたの勝利
	;あなた勝利
	IF 相手残機 == 0
		IF ALCOHOL_FACE(107) == "酔いどれ" || ALCOHOL_FACE(107) == "ぐでぐで"
			PRINTFORMDL 승부가 끝나자 세이란은 땅에 쓰러진 채 움직이지 않게 되었다.
			PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 황급히 달려가자, 세이란은 갑자기 벌떡 일어났다.
			PRINTFORML  「………………。」
			PRINTFORML  「…………。」
			PRINTFORMW  「……。」
			SETCOLOR 0xC07070
			PRINTFORMW 「우푸읏」
			PRINTFORML 
			PRINTFORMW 
			PRINTFORMDW 이 뒤에 일어난 일은 기억하고 싶지 않아……
			PRINTFORML
			SETCOLOR 0xFFE9A9
			PRINTFORML      스테이지 클리어
			PRINTFORMDL      클리어 보너스
			PRINTFORMDL       5,000,000
			PRINTFORMDW 
		ELSEIF TALENT:107:機嫌 == -1 || CFLAG:107:ブチギレ || MARK:107:反発刻印 >= 3
			PRINTFORMDL 정신을 차려보니, %조사처리(CALLNAME:MASTER,"는")% 원래 있던 장소에 있었다. 들고 있던 카메라 또한 어느새 사라져 있었다.
			PRINTFORMDW 세이란과 싸운 탓에 저런 악몽을 꾸었는지도 몰라. 나중에 제대로 사과하는 편이 좋겠어……
		ELSE
			PRINTFORML 
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 『저기―!! 왜 아무도 지원 오질 않는 거야아! 그러니까 "지금의 토끼는 명령을 지키지 않는 쓰레기다"라고 들리는 거잖아!』
					PRINTFORML 『...아니이!? "네가 약한 게 잘못이다" 라니이?!』
					PRINTFORMDW 세이란은 허공을 향해 소리를 지르며 발을 동동 구르고 있다……
					PRINTFORML
					SETCOLOR 0xFFE9A9
					PRINTFORML      스테이지 클리어
					PRINTFORMDL      클리어 보너스
					PRINTFORMDL       5,000,000
					PRINTFORMDW 
				CASE 1
					PRINTFORMDW 쓰러져 움직이지 않게 된 세이란에게 %조사처리(CALLNAME:MASTER,"가")% 황급히 달려가자, 세이란은 아른거리며 일어섰다.
					PRINTFORML 「……제2라운드야 %CALLNAME:MASTER%」
					PRINTFORML 「탄막으로 이길 수 없다면, 육탄전으로 승부를 보자아!!」
					PRINTFORMDW 도끼를 휘두르며 뒤쫓아오는 세이란에게 한동안 도망다니고 말았다……
					PRINTFORML
					SETCOLOR 0xFFE9A9
					PRINTFORML      스테이지 클리어
					PRINTFORMDL      클리어 보너스
					PRINTFORMDL       5,000,000
					PRINTFORMDW 
			ENDSELECT
		ENDIF
		;清蘭勝利
	ELSE
		IF ALCOHOL_FACE(107) == "酔いどれ" || ALCOHOL_FACE(107) == "ぐでぐで"
			PRINTFORMW 「우히나~~! 세이라~~안!!」
		ELSEIF TALENT:107:機嫌 == -1 || CFLAG:107:ブチギレ || MARK:107:反発刻印 >= 3
			PRINTFORMW 「………………。」
			PRINTFORMDL 세이란은 %조사처리(CALLNAME:MASTER,"에게")% 눈길도 주지 않고 가버렸다.
			PRINTFORMDL 저게 정말 세이란일까? 이건 자신이 보고 있는 악몽이 아닐까?
			PRINTFORMDW 그런 생각을 하고 있는 사이에, %조사처리(CALLNAME:MASTER,"의")% 눈앞이 새까매졌다……
		ELSE
			IF ABL:MASTER:戦闘能力 < 1
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「봐. 역시 내 승리야~♪」
					CASE 1
						PRINTFORMW 「%CALLNAME:MASTER%약해졌네~…. 자, 일어날 수 있겠어?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						;あなた戦闘能力4以上
						IF ABL:MASTER:戦闘能力 >= 4
							PRINTFORMW 「…… %CALLNAME:MASTER%, 진지하게 하고 있는 거야?」
						ELSE
							PRINTFORMW 「야아~ 이기지 못하는 강아지~♪」
						ENDIF
					CASE 1
						;清蘭戦闘能力3以上
						IF ABL:戦闘能力 >= 3
							PRINTFORMW 「야... 이겼다아! %CALLNAME:MASTER%한테 이겼어~~」
						ELSE
							PRINTFORML 「나에게 지고 있는 모양으로는 누구에게도 이길 수 없을 것 같은데?」
							PRINTFORMW 「...아, 나 스스로 말하고 있으니 슬퍼지기 시작했어...」
						ENDIF
					CASE 2
						PRINTFORMW 『세이란이다. %조사처리(CALLNAME:MASTER,"의")% 정화를 완료했다』
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
