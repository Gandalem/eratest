@M_KOJO_MESSAGE_SCOM_K107_6_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 후후, 저 이제 갈 것 같아! 이이잉으으윽! 후후 후후 후후」","L"
					PRINTFORMDL 세이란은 몇 번이고 G스팟을 문지르다 결국 절정에 도달해 버렸다.
					PRINTFORMDL 하지만 이쪽은 아직 절정에 이르지 못했어... %조사처리(CALLNAME:MASTER,"는")% 삽입을 재개했다...!
					CALL HPH_PRINT,@"「――아아아앗!? 후후후 잠깐만 후후우읏 그만해 후후 후루고 있어 후후 후루고 있으니까 후후 후후」","L"
					CALL HPH_PRINT,@"「아앗! 흐으윽, 아아앗! 또 갈 것 같아... 흐으으읍! 하아... 하아...」","W"
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH, 거시기 떨고 있네…… 벌써 갈 것 같아...?」","L"
					CALL HPH_PRINT,@"「나도…… 같이 가고 싶으니까…… 흐응… 여기, 많이 비벼줘…… 흐응」","L"
					PRINTFORMDL 그렇게 말하며 세이란은 하복부 입구 부근을 손가락으로 쓸었다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 페니스로 G스팟을 문지르자, 세이란은 질벽의 조임으로 응답했다...!
				CASE 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐읍, 나 벌써 갈 것 같아, 그러니까…… 흐으읍」","L"
					CALL HPH_PRINT,@"「아앗! 흐응! 거기이얏! 기분 좋아욧! 갈 것 같아아앙! 히끅, 히끅...」","L"
					PRINTFORMDW 세이란의 절정에 의해, 페니스가 밀려 나올 듯한 기세로 조여진다--
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응읏! 흐으흐흐 그곳... 안 돼애엣! 흐으흐흐」","L"
					PRINTFORMDW 페니스로 민감한 곳을 문지르자, 세이란은 높은 신음을 내고 있다...
				CASE 1
					CALL HPH_PRINT,@"「파아아앙! 후후, %CALLNAME:MASTER%읏! 후후, 거기 안돼! 안돼요오! 후우……」","L"
					CALL HPH_PRINT,@"「아우웅으응! 하햣... 이제... 용서해줘! 흐윽, 너무 아파애엣! 하햣 하햣」","L"
					PRINTFORMDW 페니스로 G스팟을 문지르자, 세이란은 말을 제대로 할 수 없을 정도로 흐트러진다...
				CASE 2
					CALL HPH_PRINT,@"「응흣…… 흡흡, 후으…… 안돼, %CALLNAME:MASTER%…… 잠깐만...! 잠깐만으읏」","L"
					CALL HPH_PRINT,@"「너무 느껴져서…… 숨이 못 쉬겠어――아아악! 흐응으 아아악! 흐읍 흐읍」","L"
					PRINTFORMDW 허리를 들썩이며 세이란의 G스팟을 페니스로 문질렀다.
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
