	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:妊娠
		;今射精した
		IF NOWEX:PLAYER:11
			CALL HPH_PRINT,@"「아앗 흐으응! %CALLNAME:MASTER%읏흐윽 나, 벌써 갈 것 같아읏」","L"
			PRINTFORMDW 마찬가지로 절정에 다다르고 있던 %조사처리(CALLNAME:MASTER,"는")%, 세이란에게 "안에서 사정하고 싶어"라고 속삭였다.
			IF ABL:欲望 > 20
				CALL HPH_PRINT,@"「아앗―……응읏 HPH 좋아욧 HPH 안에 넣어줘요 HPH」","L"
				CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 우유…… 아기한테 잔뜩 먹여줘읏 HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 자궁을 억지로 벌리듯이 페니스를 밀어 넣고, 자신의 아이에게 "밀크"를 주었다...
			ELSE
				PRINTFORMW 「에...? 아앗― 안 돼! 배에는 아기가 있단 말이야―」
				CALL HPH_PRINT,@"「아아아앗! 흐으읍, 싫어어!! %CALLNAME:MASTER%그만해줘! 밖에 사정해줘어!」","W"
				PRINTFORMDL 임신하기 전에는 볼 수 없었을지도 모르는 질내 사정을 거부하는 세이란의 모습에, %조사처리(CALLNAME:MASTER,"의")% 가학심이 자극된다...!
				PRINTFORMDL 울부짖는 세이란을 일부러 무시하고, 질 깊은 곳으로 사정했다―
				CALL HPH_PRINT,@"「응구우욱! 하프 하프 아...아앗...! 거짓말이야...! 정말로... 사정했어...?」","W"
			ENDIF
			;それ以外
		ELSE
			IF ABL:欲望 > 20
				CALL HPH_PRINT,@"「하앙! 흐으윽, 아아앗! 으응! 기분 좋아읏!」","L"
				PRINTFORMDL 세이란은 임신 전처럼 %조사처리(CALLNAME:MASTER,"의")% 페니스로 찔리며 교성(嬌聲)을 내고 있다……
				CALL HPH_PRINT,@"「아아... HPH 아기 미안해... HPH 당신이 배에 있는데, 거시기(성기)로 느끼고 있는 야한 엄마라 미안해애읏 HPH HPH」","L"
				PRINTFORMDW 자신들 아이라면 괜찮겠지 하고, %조사처리(CALLNAME:MASTER,"는")% 세이란을 더욱 페니스로 몰아붙이며 신음하게 했다.
				PRINTFORMDW ……아이를 낳더라도 이 세이란의 치태는 우리 둘만의 비밀로 해두자.
			ELSE
				CALL HPH_PRINT,@"「아우으윽! HPH %CALLNAME:MASTER%...! 잠깐, 기다려줘...」","L"
				PRINTFORML 「배가 아파서 그래…… 안쪽은 그만해 줄 수 없어...?」
				CALL HPH_PRINT,@"「응으윽, 흐읍...!! 그만해...! 정말, 괴로워어...!」","L"
				PRINTFORMDW "세이란이 야해서 자궁까지 도달해 버릴지도 몰라"%조사처리(CALLNAME:MASTER,"는")% 세이란의 귓가에서 속삭였다.
				PRINTFORML (내… 때문…?)
				CALL HPH_PRINT,@"「...훌쩍... 우우...! 응! HPH응구으윽... HPH 아기 미안해...! 내 탓이야... 미안해...!」","L"
				PRINTFORMDW 울면서, 혼잣말처럼 자기 아이에게 사죄하는 세이란의 자궁을 범하기를 계속했다...!
			ENDIF
		ENDIF
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏...! 배가 아파아... 힘들어애...」","L"
						CALL HPH_PRINT,@"「아...! 아아앙! 흐읍흐읍, 이거 안 돼읏! 좆이 자궁에 들어갔잖아앗! 흐읍흐읍」","L"
						CALL HPH_PRINT,@"「거짓이야...! 거시기, 커져버렸어...? 지금 사정하면... HPH 분명 아기 생길 거야... HPH」","L"
						PRINTFORMDL "아기"라는 말을 듣고 %조사처리(CALLNAME:MASTER,"의")% 남성 본능이 다량의 정액을 만들어내어 세이란의 자궁에 박아 넣었다...!
						CALL HPH_PRINT,@"「우아아아악 흐으읍 히끅 히끅 아기 방에서 날뛰고 있어…… 흐응흐으윽 흐으읍 히끅 히끅 히끅」","W"
					ELSE
						PRINTFORML 「아파앗...! 하, 격해...!! %CALLNAME:MASTER%... 벌써... 갈 것 같아읏?」
						CALL HPH_PRINT,@"「응... 알겠어... 사정해 HPH 안에... 잔뜩 줘 HPH」","L"
						CALL HPH_PRINT,@"「아우으윽! 큭큭큭흐읍, 거시기…… 깊숙한 곳에서 부들부들 떨려…… 헉! 흐읍」","W"
					ENDIF
				CASE 1
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「하아앗 HPH 하아앗 HPH 기분 좋아읏 HPH 거시기! HPH 기분 좋아읏 HPH」","L"
						PRINTFORMDL 자궁을 몇 번이고 페니스로 범당한 세이란은 이제 눈의 초점이 맞지 않았다……
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 더욱 깊숙이 페니스를 밀어 넣는다… 순간적인 저항 후, 귀두가 무언가에 감싸이는 듯한 감촉이 있었다...!
						CALL HPH_PRINT,@"「카히큭―흐읍! 히끅… 흐읍… 흐읍…… 흐읍 흐읍」","L"
						PRINTFORMDW 정신을 잃은 세이란의 질 안과 자궁이, 폭력적일 정도로 조여온다...!
					ELSE
						CALL HPH_PRINT,@"「커헉...! 아아앗 HPH%CALLNAME:MASTER%...! 온... 흣...!」","L"
						CALL HPH_PRINT,@"「부탁이야...! 조금만 더, 상냥하게... 으윽! 흐읍 흐읍」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 질 깊숙한 곳을 격렬하게 공격당하고, 세이란은 절정에 다다른 듯하다.
						PRINTFORMDW 질벽의 강렬한 조임에, %CALLNAME:MASTER%역시 사정했다―
					ENDIF
				CASE 2
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아앗, 후후... 거기가... 후후, 세게 울리고 있어읏, 후후」","L"
						CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"와")%줘, HPH 오게 해줘. HPH 지금 당장…… HPH 세게 박아줬으면 좋겠어읏 HPH」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 세이란의 허리를 붙잡고, 아슬아슬할 정도로 자신의 골반을 뒤로 빼며 호쾌하게 페니스를 밀어 넣었다...!
						CALL HPH_PRINT,@"「응으으윽! 하아, 갈 것 같아아아아, 하아 하아 하아」","W"
					ELSE
						CALL HPH_PRINT,@"「안 돼...! 아아... HPH 거시기, 부풀어 올라버렸어...」","L"
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%가고 싶어? ...응... HPH 좋아, HPH 많이... 사정해―」","L"
						CALL HPH_PRINT,@"「아우으윽 흐읍 흐읍... 아아 흐읍 흐읍 뜨거운 게... 흐읍 많이 읏 흐읍 흐읍」","L"
						PRINTFORMDW 세이란에게 한계까지 페니스를 박아넣고 사정했다……
					ENDIF
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아아악! 흐으윽... 흐읍... 하으읏... 아앗... 하으윽」","L"
						CALL HPH_PRINT,@"「아, 하…… HPH…… 거시기(오친친)가…… HPH 가서는 안 되는 곳까지…… 와버리고 있어…… HPH」","L"
						PRINTFORMDL 대략 여성의 것이라고는 믿을 수 없는 비명을 지르며 세이란은 절정에 도달했다……
						PRINTFORMDW 폴치오에 조여오는 것인지, 귀두에 강렬한 쾌감이 밀려온다...!
					ELSE
						PRINTFORML 「응구우욱! 아파아앗...! %CALLNAME:MASTER%...! 부탁이야... 좀 더, 상냥하게... 으윽...!」
						PRINTFORMDL 자궁경부에 도달할 정도의 기세로 세이란의 질 안에 페니스를 박고 삽입했다.
						PRINTFORMDW 하지만 세이란에게는 쾌감보다 고통이 더 우세한 듯하다……
					ENDIF
				CASE 1
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「아아앙! 흐으응, 내 거시 아기 방까지 와버렸어우...」","L"
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 후후, 저 무서워요 앗 뭔가 나올 것 같아요 앗」","L"
						PRINTFORMDW 자궁을 몇 번이고 찔리자, 세이란은 미지의 쾌감에 몸을 떨고 있다...!
					ELSE
						CALL HPH_PRINT,@"「흐읍...! 으... 끅... 응응... 히힝응... 아구우욱...!」","L"
						PRINTFORMDW 세이란은 괴로운 듯 신음하고 있지만, 아주 조금의 쾌감을 얻고 있는 듯하다.
					ENDIF
				CASE 2
					IF EXP:107:子宮口開発経験 >= 50
						CALL HPH_PRINT,@"「응구우…… HPH응응! HPH부서버릴 것 같아…… HPH」","L"
						CALL HPH_PRINT,@"「이런 거 기억해버리면…… HPH 이제…… HPH 나 죽을 것 같아 HPH」","L"
						PRINTFORMDW 세이란은 황홀한 표정으로 침을 흘리며 %조사처리(CALLNAME:MASTER,"의")% 페니스를 깊숙이 받아들이고 있다...
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%……! 제발요... 그렇게 깊숙이, 울퉁불퉁하게 하지 말아주세요...!」
						PRINTFORML 「응으윽...! ...정말 아파요... 너무... 아프다고오...!!」
						PRINTFORMDW 세이란은 눈가에 눈물을 글썽이고 있다……
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
