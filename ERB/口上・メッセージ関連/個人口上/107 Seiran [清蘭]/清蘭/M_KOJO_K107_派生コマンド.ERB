@M_KOJO_MESSAGE_SCOM_K107_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSE
		;バイブ装着中
		IF TEQUIP:バイブ
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「하햣! 하으응HPH%CALLNAME:MASTER%읏... HPH제발, 이거... 빼줘요HPH」","L"
					CALL HPH_PRINT,@"「더 이상은 하아 HPH 이상해져 버릴 테니까…… HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 바이브를 잡고 천천히 빼낸다…
					PRINTFORMDL …그렇게 속인 뒤 스위치를 최대로 올리고 세이란의 G스팟을 문질렀다.
					CALL HPH_PRINT,@"「―응흐으으아아아아앗 후후 후후 후후… 아……! 아우윽… 후후」","W"
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……! 부탁이야... HPH 이거... 빼줘어...!」","L"
					CALL HPH_PRINT,@"「이런……응! HPH 장난감이 아니라……. HPH %조사처리(CALLNAME:MASTER,"가")% 더 좋아…….」","L"
					PRINTFORMDL 아무래도 세이란은 바이브가 별로 마음에 들지 않는 모양이다……
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 바이브만이 줄 수 있는 자극이 있다고 하며 G스팟에 밀어붙여 계속해서 자극을 주었다.
					CALL HPH_PRINT,@"「아아아악 흐읍 흐읍 흐읍 이거 안돼애읏흐읍 이상해져버릴 것 같아앙흐읍 흐읍 흐읍」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응햐아앗 흐읍 흐읍」","L"
					PRINTFORMDL 손가락으로 세이란의 질내를 애무하고 있자, 분명 아까와는 다른 반응을 보였다.
					PRINTFORMDL 이곳이 세이란의 약점임을 이해한 %조사처리(CALLNAME:MASTER,"는")% 이곳을 집요하게 손가락으로 문질렀다.
					CALL HPH_PRINT,@"「아우윽 HPH 아아 HPH 앗 HPH 우으...! 거기, 계속 해줘 HPH 싫어아 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「하앗 HPH 아아큭 HPH 아아아 HPH 거기! HPH 기분 좋아 HPH 더 비벼줘 HPH」","L"
					PRINTFORMDL G스팟을 자극당하자, 세이란은 신음을 내며 몸을 파르르 떨었다.
					PRINTFORMDW 경련에 맞춰 질구에서 물이 푸슉푸슉 하고 간헐적으로 분출하고 있다...!
				CASE 2
					CALL HPH_PRINT,@"「아앗 하프 아앙! 하프 쿠... 후으읏, 이거... 기분 너무 좋아애 하프 하프」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 세이란의 G스팟을 찾아내자 손가락으로 가볍게 토닥이며 자극을 주었다.
					PRINTFORMDW 세이란에게는 충분하고도 넘치는 자극인지, 밀꿀에서는 다량의 애액이 흘러나오고 있다…
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
