;1,シックスナイン
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_SCOM_K107_1
RETURN 0

@M_KOJO_MESSAGE_SCOM_K107_1
CALL M_KOJO_MESSAGE_SCOM_K107_1_1
RETURN 1

@M_KOJO_MESSAGE_SCOM_K107_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;舌技術３以上
	ELSEIF ABL:舌 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH 부탁해…… HPH 벌써 갈 것 같아…… 그러니까…… 응…? HPH」","L"
					PRINTFORMDL 세이란은 무언가를 기대하는 듯한 눈빛으로 엉덩이를 흔들었다.
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 세이란의 허벅지를 단단히 붙잡고, 질구에 혀를 쑥 넣어 힘껏 빨아들였다.
					CALL HPH_PRINT,@"「후아아아앗 흐읍, 흐읍 이 느낌, 너무 좋아읏 후응으윽 흐읍 흐읍」","W"
				CASE 1
					CALL HPH_PRINT,@"「응응읏 HPH 응응... HPH 음읏 HPH 치우 HPH 주루읏 HPH」","L"
					PRINTFORMDL 세이란과 서로의 성기를 핥아주고 있자, 질 안이 떨리기 시작했다.
					PRINTFORMDL 먼저 가게 해 주려고 %조사처리(CALLNAME:MASTER,"는")% 질 구멍과 클리토리스를 동시에 공략했다.
					CALL HPH_PRINT,@"「응으음흐읍! 흐읍... 흐읍... 윽흐읍」","L"
					CALL HPH_PRINT,@"「―응! 하아큭, 촉촉해, 츄릅... 축... 주르륵ㅡ!! 흐읍 흐읍」","L"
					PRINTFORMDW 세이란도 고집이 센 건지, %조사처리(CALLNAME:MASTER,"의")% 페니스를 힘껏 빨아들였다...!
				CASE 2
					CALL SEIRAN_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응응... 후우읍! 츄... 응으읏! 아아아아아아아아아아아아아아아아아아아!」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 질을 핥아지는 쾌감에, 세이란은 페니스에서 입을 떼고 만다...
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%...! 잠, 잠깐만... HPH 그만해줘읏 HPH」","L"
					PRINTFORMW (으윽...! 제가 %조사처리(CALLNAME:MASTER,"를")% 기분 좋게 해주고 싶은데에...!)
				CASE 1
					CALL HPH_PRINT,@"「흐으아아앙! HPH 입구 쪽…… HPH 그렇게 많이 핥지 마아... HPH」","L"
					CALL HPH_PRINT,@"「응응… HPH는… 아으읍! HPH 음쥬 HPH 줄 HPH 응! HPH 음쥬읏 HPH 주루우우우 HPH HPH」","L"
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 지지 않겠다는 듯, 세이란은 정신없이 페니스를 핥고 빨아먹고 있다...!
				CASE 2
					CALL SEIRAN_FELLATIO
			ENDSELECT
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%...! 아흐읍흡! 흐으윽, 잠깐만... 하아, 벌써 갈 것 같아... 하아」","L"
					CALL HPH_PRINT,@"「아앗!? 아아아악! 후우우, 안 돼! 그렇게 격렬하게 하면…… 아아아악! 후후 후후」","L"
					PRINTFORMDW 세이란은 교성을 지르며 몸을 부들부들 떨었다…….
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……나… 이제 …!」","L"
					PRINTFORMDL 세이란의 애달픈 목소리를 들은 %조사처리(CALLNAME:MASTER,"는")%, 단내 나는 곳에 입술을 붙이고 애액을 빨아들여 마셔버렸다.
					CALL HPH_PRINT,@"「응으으윽 아아아앗 HPH HPH HPH」","L"
					CALL HPH_PRINT,@"「...아흐으... 아아... 흐으... 이게 뭐야... 머리가... 지끈거려... 하으... 하으...」","W"
				CASE 2
					CALL SEIRAN_FELLATIO
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「자……! %CALLNAME:MASTER%도, 기분 좋게 해줘…… HPH」","L"
					PRINTFORMDL 세이란은 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 여자 음부를 밀착해 왔다...
					CALL HPH_PRINT,@"「앗 흐으응! HPH 혀가 들어왔어읏 HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"아으으…… 흐응앗 흐응흐음……","L"
					CALL HPH_PRINT,@"(아... HPH%조사처리(CALLNAME:MASTER,"가")%, 저렇게 열심히 내 거 쪽을 핥아주고 있어... HPH)","L"
					PRINTFORML 「나도…… 노력해야 해! ……아무읏――」
					CALL HPH_PRINT,@"「응읏…흐읍… 흐으윽... 후우욱… 흐으으… 흐읍」","W"
				CASE 2
					CALL SEIRAN_FELLATIO
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K107_{SELECTCOM}_1
RETURN 1
