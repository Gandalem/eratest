		;Ｂ感覚５以上
	ELSEIF ABL:Ｂ感覚 >= 5
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏큭 벌써 갈 것 같아 으윽! 갈 거야 으윽!」","L"
					CALL HPH_PRINT,@"「이윽끄으으윽! 후우 후우 후우」","L"
					PRINTFORMDW 유두를 살짝 깨물자, 세이란은 활처럼 몸을 뒤틀며 질 안쪽을 조여왔다...!
				CASE 1
					CALL HPH_PRINT,@"「아아……읏! HPH %CALLNAME:MASTER%읏 HPH 더 빨아줘 HPH 아기처럼 잔뜩이이이」","L"
					CALL HPH_PRINT,@"「흐응으으읏HPH HPH HPH」","L"
					PRINTFORMDW 세이란의 유두를 거칠게 빨아들이고, %조사처리(CALLNAME:MASTER,"는")% 사정했다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「히으윽 HPH 이제…… 갑자기 빠는 거 그만둬 줘아……HPH」","L"
					CALL HPH_PRINT,@"「후훗♪…… 어쩔 수 없는 아기네…… HPH」","W"
				CASE 1
					CALL HPH_PRINT,@"「응응...흐읍 HPH %CALLNAME:MASTER%...흡...이쪽도...HPH」","L"
					PRINTFORMDW 세이란의 %TEXTR("左/右")% 유두에 빨리고 있자, 다른 쪽 가슴을 내밀어 왔다……
				CASE 2
					CALL HPH_PRINT,@"「아우으읏 흐읍... 응읏... 안돼애읏 흐읍 치크비, 물면 안 돼애읏 흐읍 흐읍」","L"
					PRINTFORMDL 세이란의 민감한 유두를 몇 번이고 달콤하게 깨문다. %조사처리(CALLNAME:MASTER,"가")% 입술을 떼자, 살짝 이빨 자국이 남아 있었다.
					CALL HPH_PRINT,@"「이제…… HPH 자국 남으면 어쩔 거야아… HPH」","W"
			ENDSELECT
		ENDIF
		RETURN 1
	ELSEIF TALENT:母乳体質
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「……괜찮아♪ 자, 받아봐 HPH」","L"
				PRINTFORMDL "세이란의 모유가 마시고 싶다"라고 말하자, 조금 부끄러운 듯하면서도 승낙해 주었다.
				CALL HPH_PRINT,@"「응읏 HPH 잠깐... 너무 세게 빨지 마아 HPH 야앗 HPH 유두, 핥지 말라고오 HPH」","L"
				CALL HPH_PRINT,@"「이제…… HPH…… 야한 아기네…… HPH」","W"
			CASE 1
				PRINTFORML 「가슴 먹고 싶다고…… 정말, 어쩔 수 없겠네……. 조금만 할까?」
				PRINTFORMDL 세이란은 어이없다는 듯하면서도 %조사처리(CALLNAME:MASTER,"에게")% 가슴을 드러냈다.
				CALL HPH_PRINT,@"「응응……흐읍 하아읍 흐응…흐읍 응으…흐읍」","L"
				CALL HPH_PRINT,@"「하아아 HPH 아우윽 HPH…… 저기, 있잖아…… 이제 그만해도 되지 않아? 아직 더 먹을 거야...?」","W"
			CASE 2
				CALL HPH_PRINT,@"「……응읏 HPH... 후우... HPH... 응읏... HPH 음음... 후... HPH」","L"
				PRINTFORML 「음……저기, 가슴은 어떤 맛이야…?」
				PRINTFORML 「"마셔볼래?"라고―응!?」
				CALL HPH_PRINT,@"「응응! 흐읍... 쪽... 응, 응응... 흐읍」","L"
				PRINTFORMW (왠지, 신기한 맛이 나네……)
		ENDSELECT
	ELSE
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:2
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏큭 벌써 갈 것 같아 으윽! 갈 거야 으윽!」","L"
					CALL HPH_PRINT,@"「좋아읏!? 유두 안돼애에~응응앗 하프 하프 하프」","L"
					PRINTFORMDW 유두를 살짝 깨물자, 세이란은 활처럼 몸을 뒤틀며 질 안쪽을 조여왔다...!
				CASE 1
					CALL HPH_PRINT,@"「아……! 후우, %CALLNAME:MASTER%! 이쪽은 아앗, 안돼요오!」","L"
					CALL HPH_PRINT,@"「머리가, 몽롱해서~ 아무것도 생각할 수가 없어~ 아아앗! 흐읍흐읍」","L"
					PRINTFORMDW 세이란의 유두를 거칠게 빨아들이고, %조사처리(CALLNAME:MASTER,"는")% 사정했다……
			ENDSELECT
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「히끅!? 안 돼에 HPH 유두읏... HPH 빨지 마아 HPH」","L"
					CALL HPH_PRINT,@"「응응! 하아앗! 크, 간질간지잖아아!!」","W"
				CASE 1
					PRINTFORML 「흐읍!? 갑자기 뭐야―」
					CALL HPH_PRINT,@"「풂아아아아앙흐읍 흐읍 그, 그거……그만해읏……흐읍」","L"
					PRINTFORMDW 유두를 살짝 깨물자, 정말 사랑스러운 소리를 내며 신음했다.
				CASE 2
					CALL HPH_PRINT,@"「응우으…HPH 유두아…HPH 그렇게 세게 빨지 마아……!」","L"
					PRINTFORMDL 세이란의 유두를 강하게 빨아들인다. …하지만, 정작 모유가 나오질 않는다…
					PRINTFORMW 「보뉴읏…!? 나올 리가 없잖아! 바보냐고!」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
