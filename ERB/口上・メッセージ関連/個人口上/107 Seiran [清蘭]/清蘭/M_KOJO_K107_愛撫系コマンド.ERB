		ENDIF
		;露出癖１０以上
	ELSE
		CALL HPH_PRINT,@"「하아흐윽 하아흐윽 음으윽……흐읍」","L"
		PRINTFORMDW "엉덩이 보여줘"라고 말하자, 세이란은 고개를 끄덕이며 항문을 이쪽으로 보여주었다.
		;アナル中出し直後
		IF TCVAR:104
			PRINTFORMDW 뻥 뚫린 항문에서는 장액과 섞인 정액이 새어 나오고 있다.
			CALL HPH_PRINT,@"「아아 흐으윽, 많이…… 흐으윽 흘러버려 버렸어……흐응읏 흐으윽 흐음읏 흐으윽」","L"
			CALL HPH_PRINT,@"「하아... HPH 하아... HPH %CALLNAME:MASTER%... HPH 아직, 할 수 있잖아... HPH」","L"
			CALL HPH_PRINT,@"「한 번 더, 엉덩이에 할까? 아니면... 다음엔 여기...? HPH」","L"
			PRINTFORMDW 세이란은 능숙하게 한 손으로 항문을, 다른 한 손으로는 질을 음란하게 벌리며 유혹해 왔다...!
			;それ以外
		ELSE
