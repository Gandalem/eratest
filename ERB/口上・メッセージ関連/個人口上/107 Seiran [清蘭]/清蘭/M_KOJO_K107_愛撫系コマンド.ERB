@M_KOJO_MESSAGE_MESSAGECHECK_COM_K107_1
RETURN 0

@M_KOJO_MESSAGE_COM_K107_1
CALL M_KOJO_MESSAGE_COM_K107_1_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K107_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF TCVAR:102
			;時姦中
			IF FLAG:70
				PRINTFORMW 
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「%CALLNAME:MASTER%…… 그게, 괜찮은 거야...?」
						CALL HPH_PRINT,@"「뭐가, 라니... 아앗 HPH 안돼앳 HPH 지금은 민감하단 말이야! 격하게 하지 마아아HPH」","L"
						PRINTFORMDW 단내 나는 곳에서 휘저어진 두 사람의 체액을 빨아들인다... 쓰면서도 달콤한 이상한 맛이야...
					CASE 1
						CALL HPH_PRINT,@"「응우읏 HPH 싫어…… 빨지 마아……! 모처럼 %조사처리(CALLNAME:MASTER,"가")% 사정해줬는데에...!」","L"
						PRINTFORMDW "또 잔뜩 사정해 줄 테니"라고 말하자 세이란은 얼굴을 새빨갛게 물들이고 고개를 숙여버렸다.
					CASE 2
						CALL HPH_PRINT,@"(%CALLNAME:MASTER%, 정말 내 곳을 핥고 있네... 자기 정액 싫지 않을까...)","L"
						PRINTFORML 「……엣? 뭐―응음!?」
						CALL HPH_PRINT,@"「응응…후루욱 후우읏 후…… 응음으…후우」","L"
						CALL HPH_PRINT,@"(이거…… 나와 %조사처리(CALLNAME:MASTER,"의")% 맛이, 뒤섞여있어…… HPH 엄청 야한 맛이야…… HPH)","W"
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;Ｃ感覚５以上
		IF ABL:Ｃ感覚 >= 5
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「하아아...HPH 아...HPH 응응HPH HPH %조사처리(CALLNAME:MASTER,"에게")% 핥아지는 거, 기분 좋아...HPH」","L"
					PRINTFORMDL 여러 번의 정사를 거친 덕분인지, 세이란은 예전처럼 부끄러워하지 않고 %조사처리(CALLNAME:MASTER,"의")% 혀를 받아들이고 있다.
					PRINTFORMDW 완전히 민감해진 클리토리스는 마치 페니스처럼 발기하고 있다……
					CALL HPH_PRINT,@"「응응! 후후후 %CALLNAME:MASTER%……? 잠깐만……. 클리 벗겨버릴 거야—」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 포피를 벗겨낸 음핵을, 페라치오를 하듯 입으로 빨아들였다.
					CALL HPH_PRINT,@"「아우윽――~~큭! 흐으흐 흐으흐…… 아흑, 아아... 흐으흐 흐으흐」","L"
					PRINTFORMDW 세이란은 절정을 맞으며 숨을 내쉬자, 황홀한 표정 그대로 힘이 풀려버렸다…….
				CASE 1
					CALL HPH_PRINT,@"「아앗 흐으햣 아흐윽 히끅! 크윽!! 하으윽, 후우…… 흐읍, 흐으윽」","L"
					PRINTFORMDL 절정에 가까워졌는지 세이란의 질 내부가 떨리고 있는 것이 혀를 통해 전해져 온다……
					CALL HPH_PRINT,@"「가버릴 것 같아... 후우헵! 가버리겠어으윽후우헵 후우헵 후우헵」","L"
					PRINTFORMDL 질 안이 수축하며 혀가 밀려 나올 듯한 것을 세이란의 다리를 붙잡고 참으며, 강제로 혀를 질 깊숙한 곳으로 비틀어 넣는다...!
					CALL HPH_PRINT,@"「으아아아아앗! 후우후우, 안 돼읏! 또 갈 것 같아욧! 후우후우」","W"
				CASE 2
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 후후, 세게... 후후 잠깐만 후후 기다려줘 후후 후후」","L"
					CALL HPH_PRINT,@"「벌써 나올 것 같아……응으 아앗! 왜 전보다 더 세게 하는 거야아아앙…… HPH」","L"
					CALL HPH_PRINT,@"「아앗 후후 안돼읏 후후 나와버릴 것 같아읏 후후 갈것 같아읏 가아아아아앙! 후후 후후」","L"
					PRINTFORMDL 세이란은 마치 실금이라도 한 것처럼 정액을 대량으로 뿜어냈다.
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 얼굴에 정액이 튀어도 신경 쓰지 않고, 세이란의 질구를 계속 핥고 있다……
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「응으윽! 하아아앙! 하프 하프」","L"
					PRINTFORML 「아…… %CALLNAME:MASTER%읏…… 잠깐만 기다려 줘! 그만둬…… 어……읏!」
					CALL HPH_PRINT,@"「지금 가버릴 거야! 흐으윽, 가버리니까아아흐읍! 흐읍 흐읍」","L"
					PRINTFORMDW 절정으로 움찔거리며 경련하는 세이란의 질내를 계속해서 핥아댔다...
				CASE 1
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐으, 저 벌써 갈 것 같아……흐으」","L"
					PRINTFORMDL 그것을 들은 %조사처리(CALLNAME:MASTER,"는")% 세이란의 클리토리스를 입에 넣고 달콤하게 깨물었다.
					CALL HPH_PRINT,@"「――응흣! 아아아악 흐읍 흐읍 흐읍」","W"
				CASE 2
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"의")% 혀…… 내 안에서 움직여줘…… 하으흣 기분 좋아아…… 하으흣」","L"
					CALL HPH_PRINT,@"「아아... HPH 온다 HPH 온나앗... HPH 큰 거...응으으으읍 HPH HPH」","L"
					PRINTFORMDW 절정에 달했는지 세이란은 몸을 뒤로 젖히며 파도처럼 내뿜었다.
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚５以上
	ELSEIF ABL:Ｃ感覚 >= 5
		SELECTCASE RAND:5
			CASE 0
				CALL HPH_PRINT,@"「응응읏 HPH 응앗 HPH %CALLNAME:MASTER%읏 HPH 클리도... HPH 클리도 핥고 싶어... HPH」","L"
				CALL HPH_PRINT,@"「아아앗 후으읍! 아아앗 후으읍! 아아앗 후으읍 기분 좋아읏 더, 해줘읏 후우후우」","W"
			CASE 1
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%……♪ "저기"……또 하고 싶으신 거예요……?」
				PRINTFORMDL 허리를 비틀며 애원해오는 세이란에게 응답하기 위해, %조사처리(CALLNAME:MASTER,"는")% 사랑의 액이 떨어지는 밀소로 얼굴을 가까이 가져간다.
				PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 은밀한 곳에 물어뜯으며 저속한 소리를 내면서 사랑의 액을 빨아들였다.
				CALL HPH_PRINT,@"「우아아아앗 후후후 왔다아 후후 후후 이거, 소름 끼쳐으윽 후후후」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 더 해줘! 더 해줘... 내 거 잔뜩 마셔줘아앙! 히히」","W"
			CASE 2
				CALL HPH_PRINT,@"「응응... 흐읍 응으읏흐읍 하아... 흐읍 아흐읍 아아앗... 흐읍」","L"
				CALL HPH_PRINT,@"(대단해…… ♪ %CALLNAME:MASTER%, 정신없이 내 안을 핥아주고 있어…… HPH)","L"
				CALL HPH_PRINT,@"(혀가…… 꿈틀꿈틀 움직이고 싶어…… 후훗 이런 거, 갈 것 같아…… 후훗 후훗)","L"
				PRINTFORMDW 세이란의 질에 혀를 집어넣고 핥아 녹여나간다. 세이란은 몸을 떨며 쾌락을 받아들이고 있다...
			CASE 3
				PRINTFORMDL 세이란의 질내를 핥고 있을 때, %조사처리(CALLNAME:MASTER,"는")% 불시에 머리를 잡혀 은밀한 곳에 얼굴을 짓눌렸다.
