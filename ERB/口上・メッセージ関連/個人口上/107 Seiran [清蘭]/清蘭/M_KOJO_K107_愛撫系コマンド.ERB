LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｂ感覚が５以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				CALL SEIRAN_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「거기... 깊숙이, 와주세요... 기분 좋아읏...」","L"
						CALL HPH_PRINT,@"「아앗 흐응 아아읏 히이… 가슴 만지면 안 되는데에엣」","L"
						PRINTFORMDW 안과 밖에서 동시에 공격당하며, 세이란은 몸을 부르르 떨었다...!
					CASE 1
						CALL HPH_PRINT,@"「아우으윽 HPH 거시기! HPH 끝까지, 와버릴 것 같아…… HPH」","L"
						CALL HPH_PRINT,@"「더 HPH 기분 좋은 거! HPH 원해! HPH 잔뜩 원해애! HPH」","L"
						PRINTFORMDL 탐욕스럽게 쾌락을 구하는 세이란에게 흥분한 %조사처리(CALLNAME:MASTER,"는")%, 격렬하게 삽입하며 그녀의 가슴을 정성껏 애무했다.
						CALL HPH_PRINT,@"「후아아앗! 큿, 가슴이... 동시에 당해버리면 미쳐버릴 것 같아아아앗! 후우흐윽 흐읍 흐읍」","W"
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐읍, 내 안쪽…… 기분 좋아...?」","L"
						PRINTFORMDL 기분 좋다고 대답하면서 %조사처리(CALLNAME:MASTER,"는")% 세이란의 가슴을 조금 더 강하게 주물렀다.
						CALL HPH_PRINT,@"「응으으읏 후후 후후, 기분 좋아읏 후후 더 만져줘읏 후후」","W"
				ENDSELECT
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				CALL SEIRAN_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아흐헵 아앗헵 그건 안돼읏헵 너무 느껴져버리잖아, 그러니까헵」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 삽입하면서, 세이란의 가슴을 주무르고 있었다.
					CASE 1
						CALL HPH_PRINT,@"「하아앗 흐으응! 흠흐응~ 하아큭 하아큭 하아큭」","L"
						PRINTFORMDL 세이란의 가슴을 주무르자, 세이란은 몸을 부들부들 떨었다.
						PRINTFORMDW 질 내에 삽입된 성기를 꽉 조이며 사정으로 이끌어 간다...!
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｂ感覚５以上
	ELSEIF ABL:Ｂ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「하아아… 흐응! 후우, 기분 좋아읏…후우」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH 유두도, 만져보고 싶어……HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「아앗 후으읍! 응! 흐응! 크윽, 소리 나버릴 것 같아읏! 하으으읍!」","L"
				PRINTFORMDL 작은 가슴을 주무르자, 세이란은 귀여운 신음을 터뜨렸다.
				PRINTFORMDW "가슴이 작은 여성은 감도가 좋다"는 이야기도 틀린 말이 아닐지도 모른다.
			CASE 2
				CALL HPH_PRINT,@"「아앗 HPH %CALLNAME:MASTER%읏 HPH 좋아 HPH 좋아앙 HPH」","L"
				CALL HPH_PRINT,@"「가슴이이 히히, 더 만져줘읏 히히 %조사처리(CALLNAME:MASTER,"에게")% 만져지니까…… 너무 기분 좋아욧 히히」","L"
				PRINTFORMDW 예민해진 가슴을 주무르자, 세이란은 침을 흘리며 희열에 잠긴다...
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응응우…… 응읏… 하아… 아으윽…♪」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 가슴을 주무르며, 세이란은 간지러운 듯 몸을 비틀고 있다.
			CASE 1
				PRINTFORML 「응으윽...! 아, 너무 만지지 마... 그게, 작으니까...」
				PRINTFORMDL "크기 같은 건 상관없어. 세이란의 가슴은 매우 매력적이다."
				PRINTFORMW 「...고마워...」
			CASE 2
				CALL HPH_PRINT,@"「응응…앗…흐읍 응으……응응…!」","L"
				PRINTFORMDL 세이란의 작은 가슴을, 일부러 유두에는 닿지 않게 주무르기 시작한다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 의도를 눈치챘는지, 세이란은 조금 아쉬운 듯 볼을 부풀렸다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
