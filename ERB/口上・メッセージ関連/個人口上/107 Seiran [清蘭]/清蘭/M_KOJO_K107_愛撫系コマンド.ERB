@M_KOJO_MESSAGE_MESSAGECHECK_COM_K107_0
RETURN 0

@M_KOJO_MESSAGE_COM_K107_0
CALL M_KOJO_MESSAGE_COM_K107_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K107_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;挿入中分岐
	IF LOCAL:1 && (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER)
		;Ｃ＆Ｂ感覚が一定以上かつＶ挿入中ならＶ感覚５以上Ａ挿入中ならＡ感覚４以上
		IF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 4))
			;射精した
			IF NOWEX:PLAYER:11
				CALL SEIRAN_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 세이란의 허리를 잡고 삽입하고 있었지만, 불현듯 손을 놓아 그녀의 몸을 애무했다.
						CALL HPH_PRINT,@"「앗 흐으응! 흠흐음... %CALLNAME:MASTER%읏! 기분 좋아...!」","L"
						PRINTFORMDW 안과 밖에서 동시에 공격당하며, 세이란은 몸을 부르르 떨었다...!
					CASE 1
						CALL HPH_PRINT,@"「아우으윽 HPH 거시기! HPH 끝까지, 와버릴 것 같아…… HPH」","L"
						CALL HPH_PRINT,@"「더 HPH 기분 좋은 거! HPH 원해! HPH 잔뜩 원해애! HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 성기만으로는 만족하지 못하고, 세이란은 스스로 클리토리스를 만지기 시작했다.
						PRINTFORMDL 탐욕스럽게 쾌락을 추구하는 세이란에게 흥분한 %조사처리(CALLNAME:MASTER,"는")%, 격렬하게 삽입하면서 그녀의 가슴을 정성껏 애무했다.
						CALL HPH_PRINT,@"「우아악! 흐으윽, 동시에 당하면 어떡해…… 아아악!!」","W"
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH 더, 만져줘…? HPH」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 삽입을 계속하면서 세이란을 애무했다.
						PRINTFORMDL 귀밑으로 얼굴을 가까이 대고 "좋아해"라고 속삭인다.
						CALL HPH_PRINT,@"「~~~~읏 흐으읍 흐으읍 …… 더 말해줘… 흐으읍」","W"
				ENDSELECT
			ENDIF
			RETURN 1
			;それ以外
		ELSE
			;射精した
			IF NOWEX:PLAYER:11
				CALL SEIRAN_SEX
				;それ以外
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「흐읍!? 아앗 HPH 그거, 안돼읏 HPH 너무 느껴져버릴 거잖아아 HPH」","L"
						PRINTFORMDW 삽입하면서 세이란의 몸을 애무했다.
					CASE 1
						CALL HPH_PRINT,@"「응으읏 HPH 아HPH 아앗 HPH 아우…… %CALLNAME:MASTER%?」","L"
						PRINTFORMDL 갑자기 허리 움직임을 멈춘 %조사처리(CALLNAME:MASTER,"를")% 세이란은 불안한 듯 바라본다.
						PRINTFORMDL 유두나 음핵을 정성스럽게 애무하며, 세이란에게 새로운 쾌감을 선사한다…
						CALL HPH_PRINT,@"「응으으 HPH 안돼……HPH 지금은, 민감해져 있어서…….HPH」","L"
						CALL HPH_PRINT,@"「...에엣!? 설마, 이대로 움직여――아앗! 흐읍! 안읏! 하아앗! 흐읍! 흐읍」","W"
					CASE 2
						CALL HPH_PRINT,@"「응으~~앗 흐읍 흐읍 흐읍」","L"
						PRINTFORMDL 페니스를 세이란에게 밀어 넣으면서, 토끼 귀에 숨을 불어넣는다. 세이란은 소름이 돋아 몸을 뒤틀었다.
						PRINTFORMDW 기분 좋은지 묻자, 세이란은 얼굴을 붉히며 고개를 끄덕였다.
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ｃ感覚・Ｂ感覚が５以上
	ELSEIF ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5
		SELECTCASE RAND:3
			CASE 0
				CALL HPH_PRINT,@"「응...큭! 흐읍 아앗... 더...!! 흐읍」","L"
				PRINTFORMDL 세이란의 옆구리나 허벅지를 손가락으로 스윽 쓸어내리며 애무한다.
				PRINTFORMDL 세란이 만져달라고 할 것 같은 곳은 일부러 건드리지 않고, 애태우는 듯한 애무를 계속해 나간다...
				CALL HPH_PRINT,@"「흐으윽...! ...응! HPH %CALLNAME:MASTER%...! 평소처럼 더 만져줘어...읏!」","L"
				PRINTFORMDW 애타는 소리를 내며 몸을 비트는 세이란에게 "어디를 만져줬으면 해?"라고 물었다.
				PRINTFORMW 「……%TEXTR("クリ…/おっぱい…/お…おまんこ…/")%」
			CASE 1
				CALL HPH_PRINT,@"「후아아아… 후후. 귀가… 후후, 소름이 돋아와…… 후후」","L"
				PRINTFORMDL 세이란의 토끼 귀에 후 하고 숨을 불어넣었다. 세이란은 기분 좋은 듯 몸을 떨고 있다…
				PRINTFORMDL 거듭된 %조사처리(CALLNAME:MASTER,"와")%의 정사 덕분인지, 완전히 예민해진 것 같다.
				PRINTFORMDL ……좀 더 강한 자극을 주도록 해보자. %조사처리(CALLNAME:MASTER,"는")% 토끼 귀를 살짝 깨물었다.
				CALL HPH_PRINT,@"「아앗—흐으읍 흐읍 흐읍 아앗 흐윽 후우……흐읍」","W"
			CASE 2
				CALL HPH_PRINT,@"「응으… 흐읍! 응… 후우… 하아앗!!」","L"
				PRINTFORMDL 서로의 몸을 애무하는 사이에 흥분으로 식은땀이 흘렀다. 세이란의 목덜미를 핥아보고, 땀의 맛을 만끽했다…
				CALL HPH_PRINT,@"「――나도 말이야...! 응... 츄릅... HPH 당해버릴 것 같아... HPH」","L"
				PRINTFORMDW 서로의 땀을 핥아먹는다…… 이토록 도착적인 플레이에, 두 사람은 흥분을 더는 참을 수 없게 되어버렸다...!
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응응… 응으윽…! …기분 좋아? 라기엔, 간지러워……」
				PRINTFORMDW 아직 타인에게 애무받는 것에 익숙하지 않은 건지, 가려운 듯 몸을 비틀고 있다.
			CASE 1
				CALL HPH_PRINT,@"「응응... HPH 귀, 핥아버리면... 안 돼읏 HPH」","L"
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"가")% 세이란의 토끼 귀를 핥자, 간지러운 듯 몸을 떨었다.
			CASE 2
				CALL HPH_PRINT,@"「히얀! 후으윽」","L"
				PRINTFORMDL 세이란의 몸을 더듬으며 목덜미에 혀를 가져갔다. 땀과 섞여 약간 달콤한 맛이 난다…
				PRINTFORMW 「하, 부끄러우니까 그런 거 말하지 마아읏!」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
