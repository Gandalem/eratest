			CASE 0
				CALL HPH_PRINT,@"「하아아… 흐응! 후우, 기분 좋아읏…후우」","L"
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH 유두도, 만져보고 싶어……HPH」","W"
			CASE 1
				CALL HPH_PRINT,@"「아앗 후으읍! 응! 흐응! 크윽, 소리 나버릴 것 같아읏! 하으으읍!」","L"
				PRINTFORMDL 작은 가슴을 주무르자, 세이란은 귀여운 신음을 터뜨렸다.
				PRINTFORMDW "가슴이 작은 여성은 감도가 좋다"는 이야기도 틀린 말이 아닐지도 모른다.
			CASE 2
				CALL HPH_PRINT,@"「아앗 HPH %CALLNAME:MASTER%읏 HPH 좋아 HPH 좋아앙 HPH」","L"
				CALL HPH_PRINT,@"「가슴이이 히히, 더 만져줘읏 히히 %조사처리(CALLNAME:MASTER,"에게")% 만져지니까…… 너무 기분 좋아욧 히히」","L"
				PRINTFORMDW 예민해진 가슴을 주무르자, 세이란은 침을 흘리며 희열에 잠긴다...
		ENDSELECT
		RETURN 1
		;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「응응우…… 응읏… 하아… 아으윽…♪」
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"에게")% 가슴을 주무르며, 세이란은 간지러운 듯 몸을 비틀고 있다.
			CASE 1
				PRINTFORML 「응으윽...! 아, 너무 만지지 마... 그게, 작으니까...」
				PRINTFORMDL "크기 같은 건 상관없어. 세이란의 가슴은 매우 매력적이다."
				PRINTFORMW 「...고마워...」
			CASE 2
				CALL HPH_PRINT,@"「응응…앗…흐읍 응으……응응…!」","L"
				PRINTFORMDL 세이란의 작은 가슴을 일부러 젖꼭지에는 닿지 않게 주무르듯이 만진다.
				PRINTFORMDW %조사처리(CALLNAME:MASTER,"의")% 의도를 눈치챘는지, 세이란은 조금 아쉬한 듯 볼을 부풀렸다.
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
