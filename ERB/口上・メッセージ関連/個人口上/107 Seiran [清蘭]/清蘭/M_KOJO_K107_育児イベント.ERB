;育児イベント登下校時の地の文。
;-------------------------------------------------

@M_KOJO_EVENT_K107_CHILD_RAISING_登下校(ARGS,ARG,ARG:1)
SETCOLOR 0x00A9D4
IF !ARG
	;登校時
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「%CALLNAME:(TALENT:107:育児中)% 잘 다녀와!」
			PRINTFORMW 「날아다니는 탄막에는 조심해야 해~」
		CASE 1
			CALL HPH_PRINT,@"「%CALLNAME:(TALENT:107:育児中)%♪ 잘 다녀와... 쪽HPH」","L"
			PRINTFORMDW 세이란에게서 안녕이라는 키스를 받자, %CALLNAME:(TALENT:107:育児中)%는 부끄러운 듯 웃었다.
		CASE 2
			PRINTFORML 「%CALLNAME:(TALENT:107:育児中)%잘 다녀와!」
			PRINTFORMW 「늦어지면, 텔레파시로 연락해줘!」
	ENDSELECT
ELSE
	;下校時
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「어서 와―아! 이봐 %CALLNAME:(TALENT:107:育児中)%!」
			PRINTFORMW 「돌아오면 손 씻고 양치하라고 항상 말했잖아ー!」
		CASE 1
			PRINTFORML 「%CALLNAME:(TALENT:107:育児中)% 어서 왔어~!? 무슨 일이야, 그 옷! 진흙투성이잖아ー!」
			PRINTFORML 「아아~ ... 정성껏 입은 예쁜 옷이 말이야...」
			PRINTFORMDW %CALLNAME:(TALENT:107:育児中)%에게 사정을 들으니, 돌아오는 길에 놀다가 논밭에 떨어진 모양이다...
		CASE 2
			PRINTFORML 「%CALLNAME:(TALENT:107:育児中)% 어서 와~♪ 사립학교 즐거웠어?」
			PRINTFORMDW %CALLNAME:(TALENT:107:育児中)%는 힘차게 고개를 끄덕였다. 잘 해내고 있나 걱정했지만, 기우였던 모양이다.
	ENDSELECT
ENDIF
