;TFLAG:193(1=大成功 0=成功 -1=失敗)(失敗でもふりほどかれたりはしません
;==================================================

@M_KOJO_SUCCESS_COM_K107_603
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K107_603
RETURN 0

@M_KOJO_MESSAGE_COM_K107_603
CALL M_KOJO_MESSAGE_COM_K107_603_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K107_603_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;怒り
	IF CFLAG:318 == 1
		PRINTFORML 「……뭐 하는 거야?」
		PRINTFORMDW 세이란에게 차가운 눈으로 노려졌다...
	ELSEIF TALENT:恋人
		SELECTCASE RAND:4
			CASE 0
				CALL HPH_PRINT,@" 「응……흐읍」","L"
				PRINTFORMDW 어느 쪽에서부터라고 할 것도 없이 자연스럽게 세이란과 손을 잡았다.
			CASE 1
				PRINTFORMDL 세이란과 서로의 손가락을 깍지 끼며 손을 잡았다. 이른바 "연인들의 걸음"이다.
				CALL HPH_PRINT,@" 「에헤헤 HPH…… 좀 걷기 힘들어 보이네…… HPH」","W"
			CASE 2
				CALL HPH_PRINT,@" 「……그렇구나. 우리 이제 연인이잖아, HPH」","L"
				PRINTFORMDW 세이란은 조금 부끄러워하면서도, 단단하게 손을 잡아주었다.
				CALL HPH_PRINT,@" 「나를 절대로 놓지 말아줘…… HPH」","W"
			CASE 3
				CALL HPH_PRINT,@" 「……앗 하프 헤헤... 하프」","L"
				PRINTFORMDW 손을 잡자 세이란은 기쁜 듯 얼굴을 환하게 만들었다.
		ENDSELECT
	ELSEIF TALENT:思慕 || TALENT:恋慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「…………♪」
				PRINTFORMDW 세이란과 손을 잡자, 아무 말 없이 잡아주었다.
			CASE 1
				PRINTFORML 「%CALLNAME:MASTER%. 손, 내줘」
				PRINTFORMDW 말하는 대로 손을 내밀자, 세이란은 %조사처리(CALLNAME:MASTER,"의")% 손을 꽉 잡았다.
				PRINTFORMW 「자~ 이리 와♪ 빨리 가자♪」
				PRINTFORMDW ……세이란의 미소에, 조금만 두근거렸다.
			CASE 2
				PRINTFORML 「…저기 %CALLNAME:MASTER%. 혹시 뭔가 잊은 것 없어?」
				PRINTFORMDW 잊을 리가 없다며 세이란의 손을 꽉 잡았다.
				PRINTFORMW 「응, 괜찮아♪」
			CASE 3
				PRINTFORML 「갑자기 손을 잡자니…… 왜 그래?」
				PRINTFORMW 「…헤어지지 않기 위해 손을 잡는 거야? …뭐, 그런 거라면… 응…」
				PRINTFORMDW 목적지까지 세이란과 손을 잡고 가기로 했다.
		ENDSELECT
		;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「하…? 하아앗!? 왜 연인도 아닌 당신이랑 손을 잡는 거야!?」
				PRINTFORML 「싫냐고……음, 싫지는 않은데 그게… 부끄럽다고 해야 하나…」
				PRINTFORMW 「윽!?~~~~!!」
				PRINTFORMDW 우물쭈물하는 태도의 세이란과, 조금 강압적으로 손을 잡았다. ……의외로 싫어하는 것도 아닌 것 같았다.
			CASE 1
				PRINTFORML 「엣!? 손을…? 그치만… 부끄럽단 말이야…」
				PRINTFORML 「우…… 알았다고! 잡으면 되는 거잖아!?」
				PRINTFORMW 「네엣!! 꽉~~~~!!」
				PRINTFORMDW 부끄러움을 감추려는지, 세이란은 강한 힘으로 손을 잡아온다. 손끝이 저릿해져 감각이 사라지기 시작했다…
			CASE 2
				PRINTFORML (...오늘은 손이, 이어지지 않을까...)
				PRINTFORMW 「앗...! ......~~!!」
				PRINTFORMDW ...솔직하지 못한 세이란의 "기대"에 응하며, 손을 잡았다.
			CASE 3
				PRINTFORML 「……자, 여기 있어」
				PRINTFORMDW ……? 내밀어진 세이란의 손을 응시하지만, 아무것도 보이지 않는다――
				PRINTFORMW 「…아우, 진짜! 손 잡으라니까! 부끄럽단 말이야, 자 어서!!」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
