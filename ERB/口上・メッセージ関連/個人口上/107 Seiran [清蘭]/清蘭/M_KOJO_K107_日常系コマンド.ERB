@M_KOJO_SUCCESS_COM_K107_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K107_300
RETURN 0

@M_KOJO_MESSAGE_COM_K107_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K107_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K107_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初回会話
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 『―응응. 아하하하! 그거 진짜야~~?』
		PRINTFORMDL 처음 만났을 때도 그랬지만, 세이란은 저렇게 허공을 향해 말을 하는 경우가 많았다.
		PRINTFORMDL 혼잣말처럼 보일 수도 있지만, 즐거워 보이는 표정으로 볼 때 틀림없이 "누군가와의 대화"였다.
		PRINTFORMW 「후우~…… 그래서? 너 아까부터 자꾸 쳐다보는 이유가 뭐야?」
		PRINTFORMDW 생각을 정리하는 사이 세이란의 "수수께끼 같은 대화"는 끝난 듯했다.
		PRINTFORML 「누구랑 얘기하고 있었냐고…… 그건 텔레파시로 이글라비 무리랑 대화하고 있었어」
		PRINTFORMW 「우리 타마토들은 모두 이 능력으로 떨어져 있어도 수다 떨 수 있거든」
		PRINTFORMDW 마치 우리 세계에서 말하는 휴대폰 같은 거지.
		PRINTFORML 「핸드폰? 그런 건 잘 모르겠지만…… 어쨌든 우리는 대단한 거야! 알겠어?」
		PRINTFORMDW 세이란은 의기양양하게 코를 '흥' 하고 울리며 거들었다.
		;怒り
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 『―에? 별로 기분 나쁘지도 않고... 평소랑 똑같아』
		PRINTFORMW 『...하아!? 왜 %조사처리(CALLNAME:MASTER,"가")% 나오는 거야! ...몰라니까! 저런 녀석!』
		PRINTFORMDW 세이란은 테레파시로 동료들과 대화하고 있어 말을 걸 수 없다...
		;喋りすぎ
	ELSEIF TCVAR:302
		SELECTCASE RAND:3
			CASE 0
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 「……?… %CALLNAME:MASTER%, 괜찮아? 모찌 만들래?」
					PRINTFORMDW 안 돼…….
				ELSE
					PRINTFORMW 「……이야가 끝났으면 이제 가도 돼? 나, 용건이 있거든」
				ENDIF
			CASE 1
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORMW 「%CALLNAME:MASTER%~!! 수다 떠는 것도 좋지만, 다른 거 하자구?」
				ELSE
					PRINTFORMW 「당신, 지상인이니까 지상의 재미있는 이야기를 들려주렴」
				ENDIF
			CASE 2
				IF TALENT:恋慕 || TALENT:思慕
					PRINTFORML 『후후후…♪ 그래서 %조사처리(CALLNAME:MASTER,"는")% 말이야…♪』
					PRINTFORMW 「―앗...! 아하하... 미안, 못 들었어...」
				ELSE
					PRINTFORML 『아하하하! 그런 농담 같은 게 있단 말이야~!』
					PRINTFORMDW ……동료들과 대화하는 세이란은 무척 즐거워 보인다.
				ENDIF
		ENDSELECT
		;酔っ払い時会話
		;ぐでぐで
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 8
		IF TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%~~뽀뽀하자아앙!! 안츄~~!! 핥짝! 핥짝! 핥짝」","L"
					CALL HPH_PRINT,@"「에헤헤 HPH %CALLNAME:MASTER%너무 멋져서 벌써 막 흥분하고 있어~ 에치이~ HPH 」","W"
					PRINTFORMDW 세이란은 애용하는 절구에 열렬한 키스를 퍼붓고 있다...
				CASE 1
					PRINTFORML 「어라~? %조사처리(CALLNAME:MASTER,"가")% 후다닥 나타났네~?」
					PRINTFORMW 「알았지~!! 로치카가 가짜야아아~!?」
					PRINTFORMDW 세이란은 상당히 취한 것 같다...
				CASE 2
					PRINTFORMDW 세이란은 갑자기 일어나 %조사처리(CALLNAME:MASTER,"의")% 팔을 붙잡고 잡아당겼다.
					PRINTFORML 「갈 거야 %CALLNAME:MASTER%! 우리 무도에 올라가서 고쿠죠를 하는 거야!」
					PRINTFORMW 「우리가 더 높은 곳으로 올라가, 달의 지배자가 될 거라고~!! 아하하하~☆」
					PRINTFORMDW 생명의 위기를 감지한 %조사처리(CALLNAME:MASTER,"는")% 세이란을 필사적으로 막았다...
				CASE 3
					PRINTFORMW 『지금~? %조사처리(CALLNAME:MASTER,"와")% 마시고 있어~♪』
					PRINTFORML 『...응~? ...응, 맞아~ 잔뜩 마셔버렸어~ ...하지만 %조사처리(CALLNAME:MASTER,"가")% 다정해서...』
					PRINTFORMW 『...응, ...... 응~? ...... ♪......』
					PRINTFORML 「아하하하! %CALLNAME:MASTER%~! 모두가 "짐승이다! 지옥에 떨어져라!"라고 해~♪」
					PRINTFORMDW 세이란은 대체 동료들과 무슨 이야기를 하고 있었을까...
				CASE 4
					PRINTFORML 「그니까 말이야~! 이 와라시가 거기서, 사과에 붙여줬단 말이야~!」
					PRINTFORML 「잠깐 %CALLNAME:MASTER%～! 듣고 있니~!?」
					PRINTFORMDW 이 얘기 아까도 들었어……
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「모오, 뜨거워 죽겠네~……어라? 안 벗겨져~!!」
					PRINTFORMDW 옷을 벗으려는 세이란을 필사적으로 막았다…
				CASE 1
					PRINTFORML 「잠깐만~ %CALLNAME:MASTER%!! 지금 와라시의 가슴 만졌잖아~!!」
					PRINTFORML 「와라시를 부르게 해줄 테니까 죽여버릴 거야~!」
					PRINTFORMDW 아무것도 안 했는데 불공평하게 혼나다니……
				CASE 2
					PRINTFORML 「아하!? 나한테서 도망가지 마! 이 세이란을 우습게 보지 말라고... 어라, 잠깐」
					PRINTFORMDW 비틀거리는 세이란을 간신히 부축했다.
				CASE 3;勇者王
					PRINTFORML 「부로우 군 망가져라아~!」
					PRINTFORMDW 세이란에게 갑자기 맞았다……
				CASE 4
					PRINTFORML 「요~라고 안 해주는 거야~…… 요~라고 안 해주니까~」
					PRINTFORMDW 세이란은 흔들리고 있다.
			ENDSELECT
		ENDIF
		;酔いどれ
	ELSEIF BASE:酒気 > (MAXBASE:酒気 / 10) * 5
		PRINTFORMW 「…………。」
		IF TALENT:恋慕
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「네읏! 제일 깨끗하게! 노래할게요!!」
					SELECTCASE RAND:4
						CASE 0
							PRINTFORML 「우~ 토끼~ 우~ 토끼~ ♪ 뭐~ 보고~ 뛰어놀까~♪」
						CASE 1
							PRINTFORML 「우~사~기~는~ 날아올라~♪」
						CASE 2;星条旗のピエロ
							PRINTFORML 「챠라라라차~라아~라~♪ 챠라라라챠라라라라아~↓♪」
						CASE 3;勇者王
							PRINTFORML 「이~카레~♪ 강철의 세포구~♪」
					ENDSELECT
					PRINTFORMDW 세이란이 갑자기 노래를 부르기 시작했다...
				CASE 1
					PRINTFORML 「우오오오오오옷!!」
					PRINTFORMDW 세이란은 갑자기 울부짖음을 토해냈다! %조사처리(CALLNAME:MASTER,"는")% 놀라 몸을 떨고 있다.
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%~ 꽉! 에헤헤헤헤☆」
					PRINTFORMDW 세이란이 갑자기 달려와 안아왔다...
				CASE 3
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……좋아해 HPH」","L"
					PRINTFORMDW 세이란이 갑자기 응석을 부리기 시작했다...
				CASE 4
					PRINTFORML 「……한 잔 더~! ……? 응~~!! 한, 잔, 더~!!」
					PRINTFORMDW 세이란은 술을 더 달라고 요구하고 있다. 이 이상 마시게 해도 괜찮을까…….
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「푸후읏... 아하하하하하!!」
					PRINTFORMDW 세이란이 갑자기 웃기 시작했다...
				CASE 1
					PRINTFORML 「……흐윽... 끅... 으아아앙...!」
					PRINTFORMDW 세이란이 갑자기 울음을 터뜨렸다.
				CASE 2
					PRINTFORML 「……뭐야, 그렇게 빤히 쳐다보는 거야~! 욕먹고 싶은 거야~!?」
					PRINTFORMDW 세이란이 갑자기 화를 내기 시작했다...
				CASE 3
					PRINTFORML 「………꾸윽.」
					PRINTFORMDW 세이란은 갑자기 잠이 들기 시작했다...
				CASE 4
					PRINTFORML 「……응」
					PRINTFORMDW 리필을 원하는 건지, 세이란은 빈 잔을 내밀었다...
			ENDSELECT
		ENDIF
		;ほろ酔い
	ELSEIF BASE:酒気 >= 1
		IF TALENT:恋慕
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「후훗 후후훗♪」
				CASE 1
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")%…… 한 잔 더 줄래?」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 비워진 세이란의 잔에 술을 따라주었다.
				CASE 2
					PRINTFORML 「사실 말이야... 술 마시는 거 좀 서툴렀거든...」
					CALL HPH_PRINT,@"「하지만…… %조사처리(CALLNAME:MASTER,"와")% 마시는 술은 좋아……」","L"
				CASE 3
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%…HPH」","L"
					PRINTFORMDW 세이란이 촉촉해진 눈으로 바라본다...
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「응~……?」
					PRINTFORMDW 세이란은 벌써 얼굴이 붉어져 있다. 술을 그렇게 잘 못하는 걸지도 모르겠어….
				CASE 1
					PRINTFORMW 「……음후후~♪ 술 마시는 거 좀 오랜만인가아~」
				CASE 2
					PRINTFORML 「리필할래~?……그럼 조금만 더 받을까……」
					PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 비어버린 세이란의 잔에 술을 따랐다.
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋人
		IF FLAG:デート相手 == 107
			SELECTCASE RAND:2
				CASE 0
					CALL SEIRAN_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL SEIRAN_KOIBITO
						CASE 1
							CALL SEIRAN_OTENKI
						CASE 2
							CALL SEIRAN_SEASON
						CASE 3
							CALL SEIRAN_GENSAKU
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					CALL SEIRAN_GENSAKU
				CASE 1
					CALL SEIRAN_KOIBITO
				CASE 2
					CALL SEIRAN_SEASON
				CASE 3
					CALL SEIRAN_OTENKI
				CASE 4
					PRINTFORML 「%CALLNAME:MASTER%…… 오늘은 데이트 안 할 거야?」
					PRINTFORMDW 세이란을 데리고 어디론가 나가 볼까…….
			ENDSELECT
		ENDIF
	ELSEIF TALENT:恋慕
		IF FLAG:デート相手 == 107
			SELECTCASE RAND:2
				CASE 0
					CALL SEIRAN_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL SEIRAN_RENBO
						CASE 1
							CALL SEIRAN_OTENKI
						CASE 2
							CALL SEIRAN_SEASON
						CASE 3
							CALL SEIRAN_GENSAKU
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE CFLAG:現在位置
				;人間の里
				CASE 201,202,203,204,205,206,230,240,210,220,230,240,250,270
					CALL SEIRAN_ODANGO
				CASEELSE
					SELECTCASE RAND:5
						CASE 0
							CALL SEIRAN_GENSAKU
						CASE 1
							CALL SEIRAN_RENBO
						CASE 2
							CALL SEIRAN_SEASON
						CASE 3
							CALL SEIRAN_OTENKI
						CASE 4
							PRINTFORML 「%CALLNAME:MASTER%…… 오늘은 데이트 안 할 거야?」
							PRINTFORMDW 세이란을 데리고 어디론가 나가 볼까…….
					ENDSELECT
			ENDSELECT
		ENDIF
	ELSEIF TALENT:思慕
		IF FLAG:デート相手 == 107
			SELECTCASE RAND:2
				CASE 0
					CALL SEIRAN_DATE
				CASE 1
					SELECTCASE RAND:4
						CASE 0
							CALL SEIRAN_SHIBO
						CASE 1
							CALL SEIRAN_OTENKI
						CASE 2
							CALL SEIRAN_SEASON
						CASE 3
							CALL SEIRAN_GENSAKU
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE CFLAG:現在位置
				;人間の里
				CASE 201,202,203,204,205,206,230,240,210,220,230,240,250,270
					CALL SEIRAN_ODANGO
				CASEELSE
					SELECTCASE RAND:5
						CASE 0
							CALL SEIRAN_GENSAKU
						CASE 1
							CALL SEIRAN_SHIBO
						CASE 2
							CALL SEIRAN_SEASON
						CASE 3
							CALL SEIRAN_OTENKI
						CASE 4
							PRINTFORML 「아~... 뭔가 지루하네... 기분 전환 삼아 어딘가 가자」
							PRINTFORMDW 세이란을 불러 어딘가 나가볼까…….
					ENDSELECT
			ENDSELECT
		ENDIF
	ELSE
		IF FLAG:デート相手 == 107
			SELECTCASE RAND:2
				CASE 0
					CALL SEIRAN_NORMAL
				CASE 1
					CALL SEIRAN_OTENKI
			ENDSELECT
		ELSE
			SELECTCASE CFLAG:現在位置
				;人間の里
				CASE 201,202,203,204,205,206,230,240,210,220,230,240,250,270
					CALL SEIRAN_ODANGO
				CASEELSE
					SELECTCASE RAND:2
						CASE 0
							CALL SEIRAN_NORMAL
						CASE 1
							CALL SEIRAN_OTENKI
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
