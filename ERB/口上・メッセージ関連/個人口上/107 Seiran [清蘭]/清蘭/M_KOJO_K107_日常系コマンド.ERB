				ENDSELECT
			ENDIF
			;汚れ中以下
		ELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 『여기 세이란입니다. 이제 %조사처리(CALLNAME:MASTER,"와")% 정화 활동을 시작하겠습니다』
				CASE 1
