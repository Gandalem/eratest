; Modular ERB: 個人口上/107 Seiran [清蘭]/清蘭/M_KOJO_K107_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MARKCNG_MESSAGECHECK_K107
RETURN 0

@M_KOJO_MESSAGE_MARKCNG_K107
;このままだと地の文が表示されません
;地の文を表示したい方は、下記のコメントアウトを削除して下さい
;苦痛刻印
IF !FLAG:70 && !CFLAG:MASTER:イタズラ
	IF TFLAG:22 == 1
		PRINTFORML 「아, 아파앗...! %CALLNAME:MASTER%, 아프다고! 그만해줘요!」
		PRINTFORMDW 세이란은 눈에 눈물이 고인 채 이쪽으로 호소하고 있다...
	ELSEIF TFLAG:22 == 2
		PRINTFORML 「아파! 그만해!! 너무 아프다고오!!」
		PRINTFORML 『링고옷! 우동게! 누군가! 도와줘!!』
		PRINTFORMDW 고통으로 인한 공포인지, 세이란은 착란했다.
	ELSEIF TFLAG:22 == 3
		PRINTFORML 「훌쩍… 아파아…! %CALLNAME:MASTER%…… 부탁이야, 그만해줘…!」
		PRINTFORML 「미안해…… 미안해...! 나쁜 짓을 했다면 사과할게…!」
		PRINTFORMDW 세이란은 아무 잘못이 없는데도 울면서 몇 번이고 %조사처리(CALLNAME:MASTER,"에게")% 사과하고 있다.
	ENDIF
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMDL 멈춰버린 시간 속에서 수없이 세이란의 유두를 주무르고 다녔기 때문인지, 가볍게 만지는 것만으로도 발기가 되어 버렸다.
	PRINTFORMDL 설마 모르는 사이에 자신의 가슴이 개발되었다니, 같은 꿈도 꾸지 못할 것이다.
	PRINTFORMDW 다음엔 어디를 개발해 줄까… %조사처리(CALLNAME:MASTER,"는")% 자신의 세계에서 홀로 희열에 찬 미소를 지었다.
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMDL 세이란의 클리토리스만 시간을 움직이자, 순식간에 여러 번 절정에 이른 듯한 거대한 경련을 보여주었다.
	PRINTFORMDL 원래부터 감도가 높았던 것도 있겠지만, 스스로도 놀랄 정도로 개발이 진척된 것이다.
	PRINTFORMDW 시간이 움직이기 시작했을 때 그녀는 어떤 반응을 보일지…… 상상을 하며 다시 그녀의 음핵을 집어 올렸다.
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMDL 유두, 음핵, 질에 이르기까지 세이란의 성기에 %조사처리(CALLNAME:MASTER,"의")% 손이 닿지 않은 곳은 없다고 해도 과언이 아닐 것이다.
	PRINTFORMDL 설령 세이란도 %조사처리(CALLNAME:MASTER,"의")% 능력에 눈치채고 있을지도 모르지만…… 그렇다고 해서 그녀가 자신을 떠날 리는 없을 것이다.
	PRINTFORMDW 온몸의 성기가 동시에 절정에 이르는 쾌감은, %CALLNAME:MASTER%없이는 맛볼 수 없는 것이니까…….
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	CALL HPH_PRINT,@"「응응읏 HPH… 후우 HPH 후우 HPH」","L"
	PRINTFORMW (아... 어라? 평소보다 기분 좋은 것 같아...)
ELSEIF TFLAG:23 == 2
	CALL HPH_PRINT,@"「후아아아아아~ 후프 후프 후프」","L"
	CALL HPH_PRINT,@"(왠지... 몽롱해서... 아무것도 생각할 수가 없어읏...)","W"
ELSEIF TFLAG:23 == 3
	CALL HPH_PRINT,@"「응으아아아흐읍 후우으아아아앗 흐읍 흐읍」","L"
	CALL HPH_PRINT,@"「저, 저기…… HPH 이쿠의 HPH 이쿠는 그만둘 수 없어…… HPH」","W"
	CALL HPH_PRINT,@"「――으응! 흐읍 으으응~~~~ッ흐읍 흐읍 흐읍」","L"
	PRINTFORMDW 세이란은 완전히 쾌락의 노예가 되어버렸다...
ENDIF
;不埒刻印
;快楽、屈服、恭順による刻印
;LV1
IF TFLAG:24 == 11 || TFLAG:24 == 31
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「혼자 하는 것보다 훨씬…… 기분 좋아……. HPH」","L"
		PRINTFORMW 「――아앗!?……아니 아무것도?! 아무것도, 안 했단 말이야……」
	ELSE
		PRINTFORML 「저, 저기 %CALLNAME:MASTER%…… 오늘은…… 안 하는 거예요...?」
		PRINTFORMW 「엣!? …… 아무것도 말 안 했어! 잊어버려!」
	ENDIF
	;LV2
ELSEIF TFLAG:24 == 12 || TFLAG:24 == 32
	IF CFLAG:うふふ
		PRINTFORML 「%CALLNAME:MASTER%……? 빨리…! 빨리 계속해줘어…!」
		PRINTFORMDW 세이란은 쾌락에 몸을 떨며, %조사처리(CALLNAME:MASTER,"에게")% 애원하고 있다…
	ELSE
		CALL HPH_PRINT,@"「달이나 지상 같은 건, 이제 아무래도 상관없어…… %조사처리(CALLNAME:MASTER,"가")% 있으면, 그걸로 됐어…… HPH」","L"
		PRINTFORMDW 세이란은 끈적한 시선을 보내며 %조사처리(CALLNAME:MASTER,"의")% 사타구니를 쓰다듬고 있다...
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 13 || TFLAG:24 == 33
	IF CFLAG:うふふ
		CALL HPH_PRINT,@"「아앗 HPH 응앗 HPH 아앗 HPH %CALLNAME:MASTER%읏 HPH 좋아해애 HPH」","L"
		CALL HPH_PRINT,@"「%CALLNAME:MASTER%도 HPH %조사처리(CALLNAME:MASTER,"의")% 거시기 전부 좋아읏 HPH 정말 좋아아!」","W"
		PRINTFORMDL 자랑스러운 달의 전사인 세이란이 평소의 그녀로서는 상상도 할 수 없는 암캐 같은 얼굴로 음란하게 허리를 흔들고 있다...
		PRINTFORMDW 이 환상향에서 자신만이 세이란의 암캐다운 표정을 알고 있다는 사실이 %조사처리(CALLNAME:MASTER,"의")% 욕망을 더욱 고조시킨다...!
	ELSE
		CALL HPH_PRINT,@"「나, %CALLNAME:MASTER%한테 완전히 더러워졌어 HPH」","L"
		CALL HPH_PRINT,@"「……제대로 책임져야 해읏 HPH」","L"
		PRINTFORMDW 세이란은 애정인지 색욕인지 모를 시선을 %조사처리(CALLNAME:MASTER,"에게")% 보내고 있다...
	ENDIF
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORML 「――앗! 싫다고 말하고 있잖아!」
	PRINTFORMDW 세이란의 눈가에 눈물이 고여 있다. 조금 지나쳤나 봐……
ELSEIF TFLAG:21 == 2
	PRINTFORML 「……흐윽… 왜, 이런 거 하는 거야아…읏!」
	IF TALENT:恋人 || TALENT:恋慕
		PRINTFORML 「%CALLNAME:MASTER%일, 좋아했었는데……! 너무해! ……너무하다구욧...!」
	ELSEIF TALENT:思慕
		PRINTFORML 「좋은 사람이라고 생각했는데...! 최악이야...읏!」
	ELSE
		PRINTFORML 「지상인 같은 건, 전부 정화되어 버리면 돼애……!!」
	ENDIF
	PRINTFORMDW 세이란은 울면서 %조사처리(CALLNAME:MASTER,"를")% 노려보고 있다...
ELSEIF TFLAG:21 == 3
	PRINTFORML 「이제 싫어! 어디 가버려! 나한테 오지 마!!」
	PRINTFORML 「%CALLNAME:MASTER%같은 거 정말 싫어!!」
	PRINTFORMDW 세이란에게 분명하게 거절당해 버렸다……
ENDIF
