@M_KOJO_MESSAGE_COM_K107_65_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			CALL SEIRAN_SEX
			RETURN 1
		ELSE
			CALL SEIRAN_SEX
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF FLAG:70
			PRINTFORMW 
			RETURN 1
		ELSEIF ABL:膣 >= 3
			;今射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「후우읏 HPH 응읏 HPH 아으윽 HPH %CALLNAME:MASTER%읏! 키스ぅ HPH 키스하고 싶어 HPH」","L"
						CALL HPH_PRINT,@"「음으윽 흐읍 흐읍 음읏 흐읍 냠흐읍 음응흐읍 응응... 흐읍 흐읍」","L"
						PRINTFORMDL 세이란은 이곳으로 쓰러져, 탐하듯 입술을 포개고 다가온다.
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 세이란의 엉덩이를 잡고 허리를 밀어 넣어 질벽을 비빈다……!
						CALL HPH_PRINT,@"「응으음흐읍 흐응읏흐읍 흐으으으읍흐읍 흐읍 흐읍 흐읍」","L"
						PRINTFORMDW 입술을 맞댄 채로, 두 사람은 절정에 달했다……
					CASE 1
						CALL HPH_PRINT,@"「앗 HPH 앗 HPH 안! HPH %CALLNAME:MASTER% HPH 함께... 가자 HPH」","L"
						PRINTFORMDL 세이란과 손을 맞잡고, 호흡을 맞추며 허리를 박는다.
						PRINTFORMDL 딱, 하고 서로의 몸이 맞닿은 순간―두 사람의 시야가 새하얗게 변했다...
						CALL HPH_PRINT,@"「아앗 흐으윽! 가아아흐윽!! 아아앗 아아아악! 흐읍 흐읍 흐읍」","W"
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
				;前回射精した
			ELSEIF TCVAR:102
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「음무우 HPH… 쪽 HPH… 푸핫… 하아… 하아… HPH」","L"
						PRINTFORMDL 세이란이 입술을 떼자 침의 실타래가 '툭' 하고 떨어졌다.
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%흐응 또 한 번만... 흐응」","L"
						PRINTFORMDW 세이란이 다시 허리를 움직이기 시작한다. 절정에 달한 지 얼마 안 된 페니스가 자극을 받고, %조사처리(CALLNAME:MASTER,"는")% 한심한 신음을 내뱉는다…
					CASE 1
						CALL HPH_PRINT,@"「하아... HPH 하아... HPH %CALLNAME:MASTER%... HPH」","L"
						PRINTFORMDL 세이란이 다시 허리를 상하로 움직이기 시작했다. 꾸덕꾸덕 소리를 내며 두 사람의 체액이 뒤섞인다…
						PRINTFORMDW 자신의 하반신이 더러워지는 것도 개의치 않고, 두 사람은 허리를 부딪쳤다.
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%~♪ 어때? 기분 좋지, 헤헤」","L"
						PRINTFORMDL 허리를 상하로 움직이거나 그라인딩을 하며 세이란은 느림과 빠름을 조절해 페니스를 공격한다.
						PRINTFORMDL 사정을 참는 %조사처리(CALLNAME:MASTER,"는")% 온 힘을 다해 필사적으로 고개를 끄덕일 뿐이다...
						CALL HPH_PRINT,@"「에헤헤 후훗... 이것도 공부하고 있는 거니까앗 후훗」","L"
						PRINTFORMW 「항상 섹스할 때 괴롭히는구나…… 되갚아주지♪」
					CASE 1
						CALL HPH_PRINT,@"「하아아흐읍! 아앗, 기분 좋아읏! 허리, 멈출 수가 없어읏 흐읍! 흐읍」","L"
						CALL HPH_PRINT,@"「하앗 HPH 하아앗 HPH %조사처리(CALLNAME:MASTER,"는")%? %조사처리(CALLNAME:MASTER,"는")% 기분 좋아?」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 쾌락에 몸을 떨면서도, 어떻게든 "기분 좋아"라고 짜냈다…….
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
			ENDIF
		ELSE
			;今射精した
			IF NOWEX:PLAYER:11
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「하앗... 큭 아아읏 큭 이거으~ㄴ응읏 큭 큭 큭」","L"
						PRINTFORMDL 절정에 달했나, 세이란의 움직임이 멈춘다… 하지만 %조사처리(CALLNAME:MASTER,"는")% 아직 절정에 이르지 못했다...!
						CALL HPH_PRINT,@"「응으 아아아앗 흐읍 흐읍 말, 말해읏 히끅 흐읍 이잇히―」","L"
						CALL HPH_PRINT,@"「아앗―후우 아아아아아악흐읍 흐윽 흐윽 흐읍」","L"
						PRINTFORMDW 다시 절정에 이르는 세이란. 그리고 %CALLNAME:MASTER%도 또한――
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 HPH... 거시기(혹은 성기)가 HPH... 부풀어 올랐어 읏 HPH」","L"
						CALL HPH_PRINT,@"「좋아읏 HPH 아파읏 안에 사정해줘애 HPH」","L"
						PRINTFORMDW 세이란은 %조사처리(CALLNAME:MASTER,"에게")% 정액을 짜내려고 허리를 가속시켰다. 이윽고 %CALLNAME:MASTER%도 한계에 다다른다―
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
				;前回射精した
			ELSEIF TCVAR:102
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「하아... HPH 하아... HPH 아아 HPH 정액, 잔뜩... 나오고 있어... HPH」","L"
						PRINTFORMDL 세이란이 애틋하게 배를 쓰다듬는다. 어딘가 관능적인 몸짓에, 남근이 다시 단단해진다...
						CALL HPH_PRINT,@"「아…… HPH…… 좋아♪ 한 번 더 하자 HPH」","L"
						PRINTFORMDW 세이란이 다시 허리를 움직이기 시작했다……
					CASE 1
						CALL HPH_PRINT,@"「하아... 아... 후우... 잠깐만, 쉬자...」","L"
						PRINTFORMDL 세이란이 이쪽으로 쓰러져 몸을 맡기고 왔다. ……이제 다음은 내 차례야.
						CALL HPH_PRINT,@"「――응으아아앗!? 잠, 잠깐만!! 방금 갔으니까 말이야!」","L"
						PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 세이란의 엉덩이를 붙잡고 허리를 밀어 넣어 질벽을 비볐다.
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「하아앗 HPH 아앗 HPH 여기 기분 좋은 곳 HPH 닿아…… HPH」","L"
						PRINTFORMDL 세이란은 리드미컬하게 피스톤 운동을 하며 페니스를 자극해 온다.
						PRINTFORMDW 이쪽도 지지 않겠다는 듯 타이밍에 맞춰 허리를 밀어 올리며 교성(嬌聲)을 터뜨렸다.
					CASE 1
						CALL HPH_PRINT,@"「아앗 HPH 아앗 HPH…… %CALLNAME:MASTER%, 기분 좋아…?」","L"
						PRINTFORMDL 세이란은 이쪽을 기분 좋게 해주려고 필사적으로 허리를 위아래로 움직이고 있다.
						PRINTFORMDW 서툰 골반 사용이지만, 이것 나름으로도 기분 좋다……
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF ABL:膣 >= 3
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH 넣어줄 테니까 가만히 있어줘…… HPH」","L"
				PRINTFORMDL 세이란이 천천히 남성의 성기를 자신의 구멍으로 삼켜 들어간다.
				PRINTFORMDW %CALLNAME:MASTER%도 움직일 생각이었지만, 단내 나는 곳에서 오는 쾌감에 버티느라 진땀을 빼고 있다...!
			CASE 1
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 잠깐 기다려줘♪ 금방…… 기분 좋게 해줄 테니까… HPH」","L"
				PRINTFORMDL 세이란은 남근에 여자 음부를 비비며 애액을 발라대고 있다.
				PRINTFORMDL 지독하게 답답한 자극에 %조사처리(CALLNAME:MASTER,"는")% 빨리 넣어달라고 졸랐다.
				PRINTFORMW 「기다리게 했어~ 에잇♪」
				CALL HPH_PRINT,@"「응응! 흐으윽... 아우, 나 가버렸어...흐윽」","L"
				PRINTFORMDW 한꺼번에 깊숙이 삽입되었지만, %조사처리(CALLNAME:MASTER,"는")% 이를 악물고 간신히 사정을 참았다...!
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「내가 위에 있는 거야...? 알겠어♪ 열심히 할게... HPH」","L"
				CALL HPH_PRINT,@"「응으... 하프 아아아앙... 하프 하프 삽입됐어... 하프 %조사처리(CALLNAME:MASTER,"의")% 거시기 하프」","L"
				PRINTFORMDW 세이란은 %조사처리(CALLNAME:MASTER,"와")% 손을 잡자, 허리를 상하로 움직이기 시작했다……
			CASE 1
				CALL HPH_PRINT,@"「내가……응으……HPH %조사처리(CALLNAME:MASTER,"를")%……기분 좋게, 해줄 테니까……HPH」","L"
				PRINTFORML 「……응ぅ…? 응…! 아, 어라? 삽입이 안 돼...! 뭐, 왜 이래...?」
				PRINTFORMDL 애액으로 미끄러지기는 하는데, 페니스가 쉽게 삽입되지 않아 고전하는 세이란.
				PRINTFORMDL 이대로 죽을 맛 날 것 같아, 세이란의 허리를 붙잡고 단숨에 질 속에 박아 넣었다.
				CALL HPH_PRINT,@"「파아아앗 HPH HPH HPH 크헉... HPH 내가, 기분 좋게 해주고 싶었는데읏 HPH」","W"
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
