	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;処女
		IF TCVAR:破瓜 == 1
			CALL SEIRAN_SEX
			RETURN 1
		ELSE
			CALL SEIRAN_SEX
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER
		IF FLAG:70
			PRINTFORMW 
