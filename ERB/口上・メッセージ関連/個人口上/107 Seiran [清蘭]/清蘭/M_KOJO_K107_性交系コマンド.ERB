						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
			ELSE
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「하아아흐읍! 아앗, 기분 좋아읏! 허리, 멈출 수가 없어읏 흐읍! 흐읍」","L"
						PRINTFORMDL 이쪽으로 등을 돌리고 행위에 몰두하는 세이란. 등은 텅 비어 있다, 하고 발기한 유두를 집어 올렸다.
						CALL HPH_PRINT,@"「응히유우읏 흐읍 흐읍 그거, 너무 치사해읏 기분이 너무 좋아서 움직일 수가 없어……흐읍」","L"
						PRINTFORMDW 이대로는 안 돼…… %조사처리(CALLNAME:MASTER,"는")% 허리를 들고 자궁을 밀어붙이자, 세이란은 교성(嬌聲)을 토해냈다.
					CASE 1
						CALL HPH_PRINT,@"「아앗 HPH 아앗 HPH…… %CALLNAME:MASTER%, 기분 좋아…?」","L"
						PRINTFORMDL 세이란은 이쪽을 기분 좋게 해주려고 필사적으로 허리를 위아래로 움직이고 있다.
						PRINTFORMDW 불안한지, 수시로 뒤돌아 %조사처리(CALLNAME:MASTER,"의")% 상태를 살피는 것이 조금 귀엽다……
					CASE 2
						CALL SEIRAN_SEX
				ENDSELECT
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF ABL:膣 >= 3
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%…… HPH 넣어줄 테니까 가만히 있어줘…… HPH」","L"
				PRINTFORMDL 세이란이 천천히 남성의 성기를 자신의 구멍으로 삼켜 들어간다.
				PRINTFORMDW %CALLNAME:MASTER%도 움직일 생각이었지만, 단내 나는 곳에서 오는 쾌감에 버티느라 진땀을 빼고 있다...!
			CASE 1
				CALL HPH_PRINT,@"「%CALLNAME:MASTER%, 잠깐만 기다리고 있어...! 금방... 기분 좋게 해줄 테니까... HPH」","L"
				PRINTFORMDL 세이란은 남근에 여자 음부를 비비며 애액을 발라대고 있다.
				PRINTFORMDL 지독하게 답답한 자극에 %조사처리(CALLNAME:MASTER,"는")% 빨리 넣어달라고 졸랐다.
				PRINTFORMW 「기다리게 했어~ 에잇♪」
				CALL HPH_PRINT,@"「응응! 흐으윽... 아우, 나 가버렸어...흐윽」","L"
				PRINTFORMDW 한꺼번에 깊숙이 삽입되었지만, %조사처리(CALLNAME:MASTER,"는")% 이를 악물고 간신히 사정을 참았다...!
		ENDSELECT
		RETURN 1
	ELSE
		SELECTCASE RAND:2
			CASE 0
				CALL HPH_PRINT,@"「아아아... 흐읍 흐읍 %조사처리(CALLNAME:MASTER,"의")% 거시기 흐읍 안쪽까지 왔어... 흐읍」","L"
				PRINTFORMDW 세이란은 페니스가 질도를 통과하는 쾌감에 몸을 떨고 있다…….
			CASE 1
				CALL HPH_PRINT,@"「내가……응으……HPH %조사처리(CALLNAME:MASTER,"를")%……기분 좋게, 해줄 테니까……HPH」","L"
				PRINTFORML 「……응우…? 응...! 아, 이상해…! 왜 안 들어가지…?」
				PRINTFORMDL 애액으로 미끄러지는데, 페니스가 쉽게 삽입되지 않아 고전하는 세이란.
				PRINTFORMDL 이대로 생살로 당하는 것도 괴롭기에, 세이란을 안아 올리고 단번에 질 구멍에 밀어 넣었다.
				CALL HPH_PRINT,@"「파아아앗 HPH HPH HPH 크헉... HPH 내가, 기분 좋게 해주고 싶었는데읏 HPH」","W"
		ENDSELECT
		RETURN 1
	ENDIF
