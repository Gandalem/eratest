@M_KOJO_MESSAGE_MESSAGECHECK_COM_K107_66
RETURN 0

@M_KOJO_MESSAGE_COM_K107_66
CALL M_KOJO_MESSAGE_COM_K107_66_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K107_66_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF FLAG:70
			PRINTFORMDW
			RETURN 1
			;アナル処女
		ELSEIF TCVAR:Ａ破瓜
			CALL SEIRAN_SEX
		ELSE
			CALL SEIRAN_SEX
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;挿入継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:101 == PLAYER
		IF ABL:Ａ感覚 >= 4
			;今射精した
			IF NOWEX:PLAYER:11
				CALL SEIRAN_SEX
				RETURN 1
				;前回射精した
			ELSEIF TCVAR:104
				CALL SEIRAN_SEX
				RETURN 1
			ELSE
				CALL SEIRAN_SEX
				RETURN 1
			ENDIF
		ELSE
			CALL SEIRAN_SEX
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;Ａ感覚４以上
	ELSEIF ABL:Ａ感覚 >= 4
		PRINTFORML 「또 엉덩이로 하고 싶어?…… 정말, 어쩔 수 없네…….♪」
		PRINTFORMDL 세이란은 %CALLNAME:MASTER%위로 올라타 엉덩이 구멍을 크게 벌리고 남근을 삽입했다…
		CALL HPH_PRINT,@"「후우우욱…… HPH 거시기 HPH…… 엉덩이에, 왔어…… 아앗 HPH」","L"
		PRINTFORMDL 몇 번이나 항문 섹스를 한 덕분인지, 세이란도 요령을 터뜨린 듯하다.
		PRINTFORMDW 매끄러운 삽입이 %조사처리(CALLNAME:MASTER,"를")% 사정에 이끌어 간다...!
		RETURN 1
		;それ以外
	ELSE
		PRINTFORML 「에에... 또 엉덩이에 할 거야...?」
		PRINTFORML 「알, 알았으니까...... 딱 한 번만...」
		PRINTFORMDW 
		PRINTFORML 「하아...! 하아...! 하아...!」
		PRINTFORMDL 역시 아직 무서운 건지, 세이란은 항문에 %조사처리(CALLNAME:MASTER,"의")% 페니스를 맞추지만, 올라탄 자세 그대로 움직이지 않는다...
		PRINTFORMDL 참을성이라는 것을 바닥친 %조사처리(CALLNAME:MASTER,"는")%, 세이란의 허리를 붙잡고 단숨에 항문으로 육봉을 밀어 넣었다.
		PRINTFORMW 「아윽...! 끅...! 하아... 하아... 하아...」
		RETURN 1
	ENDIF
ENDIF
