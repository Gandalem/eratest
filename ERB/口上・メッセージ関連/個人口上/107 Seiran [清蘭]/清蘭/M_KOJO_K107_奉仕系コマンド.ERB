	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;お掃除フェラ
	ELSEIF TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2
		;精液中毒４以上
		IF ABL:精液中毒 > 4
			CALL HPH_PRINT,@"「큰일이야…… HPH %조사처리(CALLNAME:MASTER,"의")% 거시기(오친친)가 더러워져 버렸어. HPH 내가 정화해 줄게, HPH」","L"
			CALL HPH_PRINT,@"「아…… 모옷 히펑즈…… 주쥬루…… 히펑 주헵 주쥬루우우우히펑 히펑」","L"
			PRINTFORMDL 목구멍 깊숙이 페니스를 물어버리고, 기둥 주변뿐만 아니라 요도 속 정액까지 탐욕스럽게 빨아들인다.
			PRINTFORMDL 쾌감에 다시 한번, 페니스는 경도를 높여갔다...!
			CALL HPH_PRINT,@"「응... 쪽... 후후 HPH 정화 완료~♪ %CALLNAME:MASTER%읏 HPH 나 노력했어 HPH」","L"
			PRINTFORMDW 머리를 쓰다듬으며 세이란에게 감사 인사를 하고 "한 번만 더 하고 싶어"라고 말하자 기쁜 듯 고개를 끄덕였다.
			RETURN 1
			;精液中毒３以下
		ELSE
			CALL HPH_PRINT,@"「거시기…… HPH 깨끗하게 해 줄게, HPH」","L"
			CALL HPH_PRINT,@"「응... 츄... 후후 흐르... 후후 취... 후후 응... 후후 흘러... 후후」","L"
			PRINTFORMDL 방금 전까지 자신의 안에 있던 것을, 세이란은 열성적으로 핥아먹으며 청소하고 있다.
			PRINTFORMDW 헌신적이고 음란한 모습에 %조사처리(CALLNAME:MASTER,"는")% 다시 흥분해 버린다...!
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		CALL SEIRAN_FELLATIO
		RETURN 1
	ENDIF
ENDIF
RETURN 1
