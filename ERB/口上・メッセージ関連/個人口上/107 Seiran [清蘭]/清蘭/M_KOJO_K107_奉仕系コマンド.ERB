;80,手淫
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K107_80
RETURN 0

@M_KOJO_MESSAGE_COM_K107_80
CALL M_KOJO_MESSAGE_COM_K107_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K107_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF !FLAG:70 && LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「손으로... 비비는 거야...? 알겠어... 에잇!」
		PRINTFORMDL 순간, %조사처리(CALLNAME:MASTER,"의")% 페니스에 엄청난 격통이 흘렀다...!
		PRINTFORML 「미, 미안해!... 아팠어? 괜찮아?」
		PRINTFORMW 「상냥하게... 살금살금... 살금살금...!」
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
		;技巧３以上
	ELSEIF ABL:技巧 >= 3
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「거시기 부풀어 올랐네 HPH 벌써 사정할 것 같아 HPH」","L"
					PRINTFORMDL 사정 직전임을 감지한 세이란은 절정에 이르기 위해 속도를 더욱 높여간다.
					PRINTFORMDL 자신의 절정을 타인에게 맡긴다는 것은 이루 말할 수 없는 기분이야...!
					CALL HPH_PRINT,@"「자자! 흐으읍, 빨리 가버려라! 흐으읍, 가버려아앗! 흐으읍」","W"
				CASE 1
					CALL HPH_PRINT,@"「아……흐읍! 흐읍응…… 정액… 가득… 흐읍」","L"
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"의")% 페니스에서 발사된 다량의 정액이, 세이란의 손을 더럽히고 있다...!
					CALL HPH_PRINT,@"「후후... HPH 아까워... HPH 응... 주루루루 HPH」","L"
					PRINTFORMDL 세이란은 손에 모인 정액을 싫은 표정 하나 없이 핥고 있다……
					CALL HPH_PRINT,@"「괜찮아……♪ %CALLNAME:MASTER%니까 헤헤」","W"
				CASE 2
					CALL HPH_PRINT,@"「아……흐응, 거시기… 벌써 갈 것 같은 거야? ……좋았어… ♪」","L"
					PRINTFORMDL 세이란은 살짝 페니스를 강하게 움켜쥐고, 사정시키려는 듯 움직임을 가속시켰다.
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏 HPH 빨리 싸줘 HPH 더럽게 정액 가득 사정해 HPH」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%……후헵, 어때? 기분 좋아?」","L"
					CALL HPH_PRINT,@"「스스로 하는 거랑, 내 손으로 하는 거…… 어느 쪽이 더 좋아…? HPH」","L"
					PRINTFORMDL 이젠 자신의 손으로 자위해도 이곳까지의 쾌락은 얻을 수 없을 것이다...
					PRINTFORMDW "세이란의 손 쪽이 더 좋다"라고 말하자, 세이란은 기쁜 듯 전신을 떨었다...!
				CASE 1
					CALL HPH_PRINT,@"「거기, 이렇게 단단하게 만들고 싶다아…… HPH 얼마나 더 더러운 걸 쌓아둔 거야아 HPH」","L"
					CALL HPH_PRINT,@"「나쁜 거시기들은…… 내가 정화해 줄 테니까…… 후후」","L"
					PRINTFORMDW 세이란은 손으로 페니스를 주무르며 "정화 활동"을 하고 있다…….
				CASE 2
					PRINTFORML 「있지 %CALLNAME:MASTER%…… 기분 좋아?」
					CALL HPH_PRINT,@"「사정하고 싶을 때면 언제든지 말해줘 HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
		;それ以外
	ELSE
		;今射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「에…… 갈 것 같아!? 아, 잠깐! 휴지―꺅!!」
					PRINTFORMDL 참으려고 했지만 제때가 아니었고, 세이란의 얼굴과 머리카락에 정액이 튀어버렸다……
					PRINTFORMW 「우와아~! 정액, 묻었어…! ……냄새나아…!」
				CASE 1
					PRINTFORML 「거시기, 부풀었어...! 벌써, 사정할 것 같아?」
					PRINTFORML 「좀 더 빨리...? 우, 응! 알겠어...!」
					PRINTFORMDL 절정에 다가가 세이란은 페니스를 자극하는 속도를 높여간다... 이윽고 %조사처리(CALLNAME:MASTER,"는")% 한계에 도달하고―
					PRINTFORMW 「앗, 아앗! 대단해...! 정액이 이런 식으로 나오는구나……」
				CASE 2
					PRINTFORML 「아...! 사정해버렸어... 응! 으윽...! ...정액, 손에 묻어버렸다...」
					PRINTFORMW 「…………。」
					CALL HPH_PRINT,@"「……으응큭흐읍… 굉장한 맛이야… 흐읍」","W"
			ENDSELECT
			RETURN 1
			;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「상냥하게... 상냥하게... 살살... 살살...!」
					PRINTFORMDW 세이란은 엄청나게 조심스럽게 %조사처리(CALLNAME:MASTER,"의")% 페니스에 손을 대고 있다…… 간질간질해...!
				CASE 1
					PRINTFORML 「침을 흘리면서…… 응아…… 손으로 비비적, 비비적…!」
					PRINTFORMDL 세이란은 서툰 손길로 %조사처리(CALLNAME:MASTER,"의")% 육봉을 문지르고 있다…
					PRINTFORMDW 의성어를 내며 자위하는 모습은 어딘가 귀여워서, 형언할 수 없는 기분을 느끼게 한다…!
				CASE 2
					PRINTFORML 「%CALLNAME:MASTER%, 어때...? 기분 좋아?」
					CALL HPH_PRINT,@"「...좋아, 다행이야♪... 그럼 이대로 계속할게... HPH」","W"
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
