@M_KOJO_MESSAGE_COM_K107_311_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 시간이 멈춘 세이란을 끌어안는다. 그 손의 인형과는 다르게, 제대로 된 온기가 느껴진다….
		PRINTFORMDW ―이대로 데려가 버릴까―… 순간 그런 생각이 머릿속을 스쳤다.
	ELSEIF CFLAG:睡眠
		CALL HPH_PRINT,@"「응…… 에헤헤…♪… %CALLNAME:MASTER%…… 후으윽」","W"
		RETURN 1
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;前から抱きつく
			CASE 32
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐읍%CALLNAME:MASTER%읏흐읍」","L"
						PRINTFORMDL 세이란이 몇 번이고 자신의 이름을 부르며 끌어안아 온다.
						PRINTFORMDW 얼굴은 상기되어 있고, 붉은 눈동자는 정욕으로 찬란하게 빛나고 있다……
					CASE 1
						CALL HPH_PRINT,@"「킁킁…… 에헤헤 HPH %조사처리(CALLNAME:MASTER,"의")% 냄새…… 정말 좋아해…… HPH」","L"
						CALL HPH_PRINT,@"「히얏! 흐응... 흐흐, 간지러워아... 흐흐」","L"
						PRINTFORMDW 답례라며 세이란의 머리카락에 코를 박고 냄새를 맡자, 부끄러운 듯 몸을 비틀었다.
					CASE 2
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……후후, 저기 봐…… 알겠어...?」","L"
						CALL HPH_PRINT,@"「나…… 지금 엄청 두근거려……. 흐읍 흐읍」","L"
						PRINTFORMDW 밀착된 피부로부터 세이란의 고동이 전해져 온다...!
				ENDSELECT
				;ディープキス
			CASE 60
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응~ HPH쪽 츄읍 HPH쭈릅 HPH즈주릅 HPH쥬루우 HPH」","L"
						PRINTFORMDW 서로 껴안은 채 세이란과 진한 키스를 나누었다...
					CASE 1
						CALL HPH_PRINT,@"「응읏... 후우욱 후욱 주르륵 쪽... 흘러... ♪ 음무우욱 주르륵쪽」","L"
						CALL HPH_PRINT,@"「—푸하앗!…… 하아 HPH 하아 HPH 하아 HPH…… %CALLNAME:MASTER%…… HPH 응…… 암으읏—」","L"
						CALL HPH_PRINT,@"「응으읏흐읍 쥬읍흐읍 주르륵흐읍 지이잉…… 주르륵흐읍 흐읍」","W"
				ENDSELECT
				;ぱふぱふ
			CASE 73
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「조금 부끄럽지만…… %조사처리(CALLNAME:MASTER,"가")% 기뻐해 준다면…… 후훗」","L"
						PRINTFORMDW 세이란의 사랑스러운 가슴에 얼굴을 묻고, 행복한 시간을 맛보았다...
					CASE 1
						PRINTFORML 「으윽...! 정말 말해야 하는 거야...?」
						CALL HPH_PRINT,@"「파아...! 파후...!! 파후파후읏... HPH 파후파후읏HPH」","L"
						PRINTFORMDW 세이란은 얼굴을 새빨갛게 물린 채 가슴으로 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 파묻었다...
				ENDSELECT
				;乳合わせ
			CASE 74
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응응! HPH 유두, 비벼져서…… HPH 기분 좋아읏…… HPH」","L"
						PRINTFORMDW 세이란과 서로의 유두를 비비며 애무했다.
					CASE 1
						CALL HPH_PRINT,@"「응읏... 후후... HPH %CALLNAME:MASTER%도... 유두, 기분 좋구나... HPH」","L"
						CALL HPH_PRINT,@"「응... 큿! 아아앗... 큿! 더... 기분 좋게, 해보자...? 큿!」","L"
						PRINTFORMDW 세이란과 유두를 비비며, 쾌감을 공유했다……
				ENDSELECT
				;乳を吸わせる
			CASE 77
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응응흐으윽 HPH 더… HPH 가슴, 빨고 싶어… HPH HPH」","W"
					CASE 1
						CALL HPH_PRINT,@"「%CALLNAME:MASTER%……흐응읏~ 흐으읍!」","L"
						PRINTFORMDL 세이란이 안아왔다. %조사처리(CALLNAME:MASTER,"의")% 눈앞에 세이란의 가슴이 다가온다…….
						CALL HPH_PRINT,@"「응히햐앗 HPH HPH야, 안돼읏 HPH 유두 물기, 반칙이야읏…HPH」","L"
						PRINTFORMDW 무의식중에, %조사처리(CALLNAME:MASTER,"는")% 세이란의 유두를 달콤하게 깨물고 있었다...
					CASE 2
						CALL HPH_PRINT,@"「응으 흣! 후후, 가슴이 간지러워읏」","L"
						CALL HPH_PRINT,@"(이렇게 열중해서 가슴을 빨아…… 후후, 정말 아기 같네 후후)","L"
						CALL HPH_PRINT,@"「……%CALLNAME:MASTER%쨩~ HPH 가슴 맛있으읏?」","L"
						PRINTFORMDW 세이란에게 아기 말로 말을 걸어지며 머리를 쓰다듬어졌다……
				ENDSELECT
				;85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ
			CASE 85,87,88,89
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「응응읏HPH HPH 아아……HPH %조사처리(CALLNAME:MASTER,"의")% 거시기……HPH 단단하고……커…….HPH」","L"
						CALL HPH_PRINT,@"「하윽... HPH는 후우... HPH 역시... %조사처리(CALLNAME:MASTER,"의")% 얼굴 보면서 하는 거... 조금 부끄럽지만, 좋아 HPH」","L"
						PRINTFORMDW 얼굴을 상기시키며 빙긋 웃는 세이란을 보고, %조사처리(CALLNAME:MASTER,"의")% 심장이 쿵 하고 고동쳤다...!
					CASE 1
						CALL HPH_PRINT,@"「거시기...HPH\@ TCVAR:20 == 85 || TCVAR:20 == 88 ? 안쪽에 # 뒤에... 가득 넣어줘 HPH HPH」 \@","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 세이란을 꽉 끌어안은 채, 허리를 격렬하게 상하로 움직였다...!
						CALL HPH_PRINT,@"「아앗! 흐읍! 굉장해읏! 기분 좋아욧! 거시기!! 쿵쾅쿵쾅해서... 후우후우」","W"
					CASE 2
						CALL HPH_PRINT,@"「아우으읍! 하앗! 아앙! 어, 어떡해읏 허리가 저절로 움직여버려어엣! 흐윽!」","L"
						CALL HPH_PRINT,@"「아햣! 아햣%CALLNAME:MASTER%! 꽉 안아주면 안 돼읏! 흐응! 흐으윽」","L"
						PRINTFORMDW 담담담하고 리듬 좋게 허리를 흔드는 세이란의 몸을, 끌어안고 지탱했다.
				ENDSELECT
				;だいしゅきホールド
			CASE 86
				SELECTCASE RAND:3
					CASE 0
						CALL HPH_PRINT,@"「아하아앗 흐읍흐읍 이거 굉장해!! 거기가, 깊숙이 들어와 있어읏!」","L"
						PRINTFORMDL %조사처리(CALLNAME:MASTER,"가")% 허리를 부딪치고 있을 때, 세이란이 팔과 다리로 감싸며 밀착해 왔다.
						PRINTFORMDW 피부에 흩뿌려지는 숨결과 직접 전해져 오는 세이란의 체온이 %조사처리(CALLNAME:MASTER,"의")% 흥분을 자극한다...!
					CASE 1
