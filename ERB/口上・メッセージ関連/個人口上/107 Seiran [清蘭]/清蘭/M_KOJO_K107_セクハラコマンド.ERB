@M_KOJO_MESSAGE_COM_K107_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:70
		PRINTFORMDL 시간이 멈춘 세이란의, 적당히 탄력 있는 엉덩이를 쓰다듬었다. 좋은 감촉이군...
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 그저 쓸어내리는 것만으로는 만족하지 못하고, 주무르거나 볼을 비비기도 하며 마음껏 엉덩이를 만끽했다.
	ELSEIF CFLAG:睡眠
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「응... 엉덩이... 가아앙... 음음...」
			CASE 1
				PRINTFORML 「엉덩이…… 만지지 말아줘…… 음냐……」
				PRINTFORMDW 일어났다고 생각했으나, 말귀였던 모양이다.
		ENDSELECT
	ELSEIF CFLAG:うふふ == 2
		SELECTCASE TCVAR:20
			;クンニ強制
			CASE 70
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응앗 HPH 이제… 지금은 엉덩이 만지지 않아도 돼읏… HPH」","W"
					CASEELSE
						CALL HPH_PRINT,@"「응응! 후훗, 엉덩이……후훗. 나도 말이야, 후훗」","L"
						PRINTFORMDW 세이란은 %조사처리(CALLNAME:MASTER,"의")% 얼굴에 가랑이를 부비부비 밀어붙였다...
				ENDSELECT
				;アナル奉仕
			CASE 72
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「손가락……후훗, 엉덩이에 넣고 있어 후훗」","W"
					CASEELSE
						CALL HPH_PRINT,@"「흐아앙! 흐으, 굉장해……혀가, 말랑말랑해서 그래……」","W"
				ENDSELECT
				;スカートの中を見せる
			CASE 35
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「응응... HPH %CALLNAME:MASTER%… HPH 엉덩이가 아니라… 그게… HPH」","W"
					CASEELSE
						CALL HPH_PRINT,@"「아... 후으음... 후으음, 엉덩이... 직접 만져지고 있어... 후으음」","W"
				ENDSELECT
				;素股
			CASE 52
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗! 하으... 아무것도 지금 만지지 않아도... 으윽!」","W"
					CASEELSE
						CALL HPH_PRINT,@"「잠깐...! 지금 엉덩이 만지면 위험하다고 했잖아아아아헉」","W"
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						CALL HPH_PRINT,@"「아앗! 하으... 아무것도 지금 만지지 않아도... 으윽!」","W"
					CASEELSE
						CALL HPH_PRINT,@"「저기...! 방금 엉덩이 만졌잖아... 응! HPH」","W"
				ENDSELECT
		ENDSELECT
	ELSE
		IF TALENT:恋人 || TALENT:恋慕
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「...흐윽... 으응...! ...그, 그만해줘...!」
					PRINTFORMDL %조사처리(CALLNAME:MASTER,"에게")% 엉덩이를 쓰다듬히며 세이란은 눈에 눈물을 글썽이며 겁을 먹고 있다...
					PRINTFORMDW 마치 치한이라도 당하는 듯한 기분이 들었다...
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응응읏... HPH %조사처리(CALLNAME:MASTER,"의")% 손이... 응으으... HPH」","L"
							PRINTFORMDW 세이란은 엉덩이를 쓰다듬어지며 몸을 움찔거린다...
						CASE 1
							CALL HPH_PRINT,@"「히야큭 HPH 응응... HPH 뭔가, 손길이 야해...! -으윽 HPH」","W"
						CASE 2
							CALL HPH_PRINT,@"「흐으아앙! 후헵 후헵 후헵」","L"
							PRINTFORML (엣, 이상한 소리가 나버렸어……!)
							PRINTFORMDL 꼬리를 만졌을 뿐인데 재미있는 반응이 돌아왔다. 더 만지고 싶어...!
							PRINTFORMDW 하지만 세이란은 얼굴을 새빨게 물리고 %조사처리(CALLNAME:MASTER,"를")% 노려보며 손으로 꼬리를 가려버렸다...
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:4
						CASE 0
							CALL HPH_PRINT,@"「앙! 후으음……후우 음응! 이제, 왜 계속 엉덩이만 쓰다듬는 거야아윽… 후우」","L"
							PRINTFORMDW 세이란의 엉덩이를 마음껏 쓰다듬게 해 주었다.
						CASE 1
							CALL HPH_PRINT,@"「응읏... 하아... 아으윽... 응읏...」","L"
							CALL HPH_PRINT,@"「왠지…… 엉덩이 쓰다듬히니까…… 흐음! 으응, 이상한 기분이네읏」","L"
							PRINTFORMDW 세이란은 엉덩이를 쓰다듬어지며, 매혹적인 목소리를 내기 시작했다...
						CASE 2
							CALL HPH_PRINT,@"「앙! 흐으응……흐으윽…흐으 응……흐으 %CALLNAME:MASTER%……흐으」","L"
							CALL HPH_PRINT,@"「저... 엉덩이 쓰다듬는 것만으로도... HPH 괜찮아? HPH」","L"
							PRINTFORMDW 세이란은 조금 부끄러워하는 듯하면서도 도발적인 미소를 지었다……
						CASE 3
							CALL HPH_PRINT,@"「흐아읍! 후후, 아앗... 꼬리야읏... 후후 후후」","L"
							CALL HPH_PRINT,@"「%CALLNAME:MASTER%읏! 더 만져줘, 더!! 엉덩이 비비고 싶단 말이야아앗!」","L"
							PRINTFORMDW 세이란은 엉덩이를 쓰다듬히고 달콤한 소리를 내고 있다……
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				;不快
				CASE 1
					PRINTFORML 「헉...! 싫, 싫어읏!!」
					PRINTFORMDW 세이란에게 손바닥으로 맞았다…….
					;恥ずかしがる
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「잠깐...! 뭐, 하는 거야아...」
						CASE 1
							PRINTFORMW 「응읏...! 아앗... 그만두라고 했잖아...!」
						CASE 2
							CALL HPH_PRINT,@"「히얀! 후으윽」","L"
							PRINTFORML 「~~윽!」
							PRINTFORMDW 세이란에게 노려졌다... 별로 꼬리 만지고 싶지 않은 모양이다.
					ENDSELECT
					;されるがまま
				CASE 4
					SELECTCASE RAND:3
						CASE 0
							CALL HPH_PRINT,@"「응응... HPH, 아직 만지는 거야!? 이제 됐잖아... HPH」","L"
							PRINTFORMDW 세이란의 엉덩이를 만끽했었다.
						CASE 1
							PRINTFORML 「저기... 후훗♪ 간, 간지러워...!」
							CALL HPH_PRINT,@"「아하하하! 하...앗...후우음...후우음」","W"
						CASE 2
							CALL HPH_PRINT,@"「흐으응읏 HPH, 꼬리야 하아앗... HPH」","L"
							CALL HPH_PRINT,@"「흐으윽...! 아...응우...큭」","L"
							PRINTFORMDW 세이란은 꼬리를 쓰다듬는 것에 약한 모양이다.
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
