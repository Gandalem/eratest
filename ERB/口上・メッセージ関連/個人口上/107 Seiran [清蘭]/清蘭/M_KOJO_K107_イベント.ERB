@M_KOJO_EVENT_K107_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					CALL HPH_PRINT,@"「아, %조사처리(CALLNAME:MASTER,"랑")% 데이트하자♪」","L"
					PRINTFORML 「있잖아! 좋지? 정말 좋다아~!」
					PRINTFORMDW 세이란은 데이트에 가고 싶은 모양이다. 어떡하지….
				ELSEIF TALENT:恋慕
					CALL HPH_PRINT,@"「아, %CALLNAME:MASTER%……흐읍. 오늘 그…… 데, 데이트하고 싶어!」","L"
					PRINTFORML 「……안돼요?」
					PRINTFORMDW 세이란은 올려다보며 %조사처리(CALLNAME:MASTER,"의")% 얼굴을 들여다보았다...
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%~!! 시간 되니까, 어디 놀러 가자♪」
					PRINTFORMDW 세이란은 아무래도 함께 외출하고 싶은 모양이다…
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMW 「좋아, 결정했어~ 그럼 당장 외출하자! 고고~♪」
				ELSEIF TALENT:恋慕
					PRINTFORML 「정, 정말!? 그럼 바로 가보자 가보자♪」
					PRINTFORMDW 세이란은 조금 안심한 표정을 지었다.
				ELSE
					PRINTFORMW 「정해졌네! 자 그럼 가볼까~♪」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMDL "초대해 준 건 기쁘지만, 오늘은 용무가 있다"고 거절하기로 했다.
				IF TALENT:恋人
					PRINTFORML 「에에!? 믿을 수 없어! 평소의 연인의 초대를 거절하다니!?」
					PRINTFORML 「흥! 좋아! 나중에 "역시 데이트하자"라고 말해도 이미 늦었어! 야!」
					PRINTFORMDW 세이란은 데이트 제안을 거절당해 시무레 보였다...
				ELSEIF TALENT:恋慕
					PRINTFORML 「……그렇구나. 응, 다음에 봐…」
					PRINTFORMDW 세이란은 토끼 귀가 주름지도록 시무룩해 있다...
				ELSE
					PRINTFORMW 「칫~ 분위기 안 맞네~……」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「있잖아…… %CALLNAME:MASTER%……♪」
					CALL HPH_PRINT,@"「오늘은…… 내 집에서 놀자…… 흐으읍」","L"
					PRINTFORMDW 세이란은 열기 어린 시선을 보내 %조사처리(CALLNAME:MASTER,"를")% 유혹하고 있다……
				ELSEIF TALENT:恋慕
					PRINTFORML 「……%CALLNAME:MASTER%! 우리 집에 안 갈 거야!?」
					PRINTFORMDW 갑자기 세이란이 집에 초대해 왔는데…… 어떡하지….
				ELSE
					PRINTFORML 「아, %CALLNAME:MASTER%. 우동게한테 과자 받았는데, 같이 안 먹을래?」
					PRINTFORMDW 세이란이 집에 초대해왔다…… 어쩌지…….
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORMDL 준비된 만찬은 대체 어떤 것일까. 세이란의 유혹에 응하기로 했다.
					CALL HPH_PRINT,@"「해냈다~ 후후HPH 자 그럼 가자♪」","L"
					PRINTFORMDW 세이란과 밀착한 채 집으로 향했다...
				ELSEIF TALENT:恋慕
					PRINTFORMDL 모처럼 기회가 생겼으니, 그 말씀에 응하기로 했다.
					CALL HPH_PRINT,@"「...! ...고마워 HPH 그럼 가자♪」","L"
					PRINTFORMW (――좋아! 이걸로 오늘은 %조사처리(CALLNAME:MASTER,"와")% 둘만 있잖아...!)
				ELSE
					PRINTFORMDL 모처럼이니 과자를 대접받기로 했다.
					PRINTFORML 「좋아, 결정이야♪ 그럼 %조사처리(CALLNAME:MASTER,"는")%, 차 부탁해~♪」
					PRINTFORMDW 자신을 유혹한 건 그게 목적이었나……%조사처리(CALLNAME:MASTER,"는")% 쓴웃음을 지으며 세이란의 집으로 향했다.
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				PRINTFORMDL "초대해 준 건 기쁘지만, 오늘은 용무가 있다"고 거절하기로 했다.
				IF TALENT:恋人
					PRINTFORML 「...그. ……지루해」
					PRINTFORMDW 세이란은 시시하다는 듯 입술을 삐죽 내밀고 있다.
				ELSEIF TALENT:恋慕
					PRINTFORML 「……그렇구나. 알겠어... 또 봐……」
					PRINTFORMDW 세이란은 토끼 귀가 주름이 생길 정도로 시무룩해 있다...
				ELSE
					PRINTFORMW 「뭐야~ 아쉽네. 그럼 링고랑 먹자」
				ENDIF
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
