		;満足して解放
		CALL HPH_PRINT,@"「하아아큭 후우……큭 기분 좋았다아큭」","L"
		PRINTFORMDL 세이란은 드디어 만족한 듯, 천천히 허리를 들고 %조사처리(CALLNAME:MASTER,"의")% 페니스를 밀랍통에서 빼냈다…
		PRINTFORMDW 이성을 잃고 질 구멍으로 엄청난 양의 정액이 흘러넘치기 시작한다……
		CALL HPH_PRINT,@"「아앗... 흘러버려... 응응! 하아... 아하...!」","L"
		PRINTFORMDW 세이란은 정액이 질도를 지나 나오는 쾌감에 몸을 떨고 있다...
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;満足したところを押し倒された
		PRINTFORML 「후우…… 개운해졌고, 오늘은 이제 자야지― 흣!?」
		PRINTFORMDL "아직 자기엔 일러. 다음은 이쪽 차례야"
		CALL HPH_PRINT,@"(와아... HPH 엄청나다... ♪ 그렇게 많이 나왔는데, 벌써 딱딱해지고 있어... HPH)","L"
		CALL HPH_PRINT,@"「―좋아 HPH…… 더, 해줘 HPH」","W"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;壊れるまでしてあげる
		CALL HPH_PRINT,@"「에엥~? 곤란한데…… 내일, 세이란 가게 일 있단 말이야…… 후후」","L"
		PRINTFORMDW 말과는 달리, 세이란은 기대하는 듯한 눈으로 바라보고 있다……
		RETURN 1
	ENDIF
ENDIF
RETURN 1
