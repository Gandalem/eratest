@M_KOJO_EVENT_K107_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					PRINTFORMDL 세이란의 옷을 전부 벗겨, 태어난 그대로의 모습으로 만들었다.
					PRINTFORMDW ……예상했던 가슴 크기에, %조사처리(CALLNAME:MASTER,"는")% 어깨를 떨구었다…
					;通常
				ELSEIF TALENT:恋慕
					SELECTCASE RAND:4
						CASE 0
							CALL HPH_PRINT,@"「아앗 흐읍 으응...흐읍」","L"
							PRINTFORMDL 태어나기 전의 모습이 되어 세이란과 끌어안았다.
							PRINTFORMDW 흥분한 걸까, 세이란의 빠른 고동이 밀착된 몸을 통해 느껴진다…
						CASE 1
							PRINTFORMDL 세이란과 서로 옷을 벗겨주며, 둘 다 알몸이 되었다.
							CALL HPH_PRINT,@"「이제…… 부끄러우니까 너무 보지 말아줘… HPH」","W"
						CASE 2
							CALL HPH_PRINT,@"「벌써 이렇게 크게 해줘... HPH %조사처리(CALLNAME:MASTER,"의")% 에치HPH」","L"
							PRINTFORMDW 세이란에게 발기한 페니스를 쓰다듬히고, 저도 모르게 소리를 내버렸다...
						CASE 3
							PRINTFORML 「어, 어때...? 가슴, 조금은 커졌을까아...?」
							PRINTFORMDW 전혀 변한 것 같지 않지만... 그걸 말하는 건 야박한 거겠지.
					ENDSELECT
				ELSE
					PRINTFORML 「……미안했어. 그게 말이야, 가슴이 작아서」
					PRINTFORMDL ……아주 아름다운 세이란의 몸매에 나도 모르게 눈을 빼앗기고 말았다…
					PRINTFORMW 「…!! …저기! 계속 보고만 있지 말고, 당신도 빨리 벗어줘…!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					PRINTFORMDL 세이란의 옷을 벗겨 속옷 차림으로 만들었다.
					PRINTFORMDW ……외에도, 가슴을 크게 드러내는 종류의 속옷은 입고 있지 않은 듯하다.
					;通常
				ELSEIF TALENT:恋慕
					SELECTCASE RAND:2
						CASE 0
							CALL HPH_PRINT,@"「아우……흐응」","L"
							PRINTFORMDL 속옷 차림의 세이란을 꽉 껴안았다.
							PRINTFORMDW 얇은 천 너머로 고동과 체온이 전해져 온다…
						CASE 1
							CALL HPH_PRINT,@"「에헤헤…… 이 속옷 어때…? %조사처리(CALLNAME:MASTER,"가")% 좋아할 거라고 사봤는데…」","L"
							PRINTFORMDW "잘 어울린다"고 생각한 그대로 감상을 전했다.
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORMDL 오늘의 세이란은 아주 귀여운 속옷을 입고 있어...
							PRINTFORML 「뭐, 뭐야! 그 얼굴은!」
							PRINTFORMW 「나도 이런 거 입고 싶을 때가 있다구...!」
						CASE 1
							PRINTFORML (%CALLNAME:MASTER%…… 엄청 보고 있어…!)
							PRINTFORML (흐윽… 부, 부끄러워…!)
							PRINTFORMDW 세이란은 속옷 차림 그대로 몸을 움츠리고 있다. 팬티가 조금 젖기 시작한 것처럼 보인다…
					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;半脱ぎ 多分使わないけど一応作った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				;時間停止時
				IF FLAG:70
					PRINTFORMDL 세이란의 옷을 일부만 벗도록 했다.
					PRINTFORMDW ……마치 공격하는 듯한 느낌이 들어서, 꽤 자극적이네.
					;通常
				ELSEIF TALENT:恋慕
					PRINTFORML 「이제…… 이거 주름 생길 것 같아서 별로 안 좋아하는데……」
					CALL HPH_PRINT,@"「%조사처리(CALLNAME:MASTER,"가")% 흥분한다면…… 괜찮아 HPH」","W"
				ELSE
					PRINTFORML 「벗겨주는 게 좋다고…… 변태……」
					PRINTFORMDW 세이란에게 흰 눈으로 보였다…….
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;パンツちょうだい
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				SELECTCASE ARG:1
					;-------------------------------------------------
					CASE 0
						;交換です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								CALL HPH_PRINT,@"「%CALLNAME:MASTER%……저기……팬티, 고마워……흐읍」","L"
								PRINTFORMDW 세이란은 %조사처리(CALLNAME:MASTER,"의")% 팬티를 정성껏 접어 자기 가방에 넣었다.
							ELSE
								PRINTFORML 「……그럼 %CALLNAME:MASTER%팬티 내놔 봐」
								PRINTFORMW 「자, 싫지? 말도 안 되는 소리 하지 마―」
								PRINTFORMDL %조사처리(CALLNAME:MASTER,"는")% 자신의 팬티를 세이란에게 건넸다.
								PRINTFORMDW …세이란은 어쩔 수 없었는지, 자신의 팬티를 %조사처리(CALLNAME:MASTER,"에게")% 던져 주었다…
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 1
						;OK（嬉々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								CALL HPH_PRINT,@"「이제……♪ 네, 소중히 해줘요……HPH」","L"
								PRINTFORMDW 세이란은 어이없다는 듯하면서도 살짝 기쁜 듯 팬티를 건넸다.
							ELSE
								PRINTFORML 「이제! 알았다고! 주면 되는 거잖아!? 받아봐!!」
								PRINTFORMDW 꽤나 부끄러운 건지, 얼굴을 새빨갛게 물들이며 팬티를 던져왔다...
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 2
						;OK（渋々
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								PRINTFORML 「우으... 네... 여기 있어요...」
								PRINTFORMDL 세이란은 망설이면서도 팬티를 건넸다.
								PRINTFORMW (저거 아끼던 건데... 그래도 %조사처리(CALLNAME:MASTER,"가")% 기뻐 보여서야... 됐겠지...♪)
							ELSE
								PRINTFORML 「...어차피 이상한 데 쓸 거잖아... 에치...!」
								PRINTFORMDW 노려보면서도, 세이란은 팬티를 주었다...
							ENDIF
							RETURN 1
						ENDIF
						;-------------------------------------------------
					CASE 3
						;嫌です
						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 1
						;-------------------------------------------------
						IF LOCAL:1
							IF TALENT:恋慕
								PRINTFORMW 「아, 아니야! 이거 나 최애거든! 절대 안 돼!」
							ELSE
								PRINTFORMW 「하아!? 안 되게 되어있잖아! 무슨 생각 하는 거야 바보!!」
							ENDIF
							RETURN 1
						ENDIF
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
