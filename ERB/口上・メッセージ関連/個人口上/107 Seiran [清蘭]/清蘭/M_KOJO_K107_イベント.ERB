@M_KOJO_EVENT_K107_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORML 「후우~…… 지치고 말았어…… 쉬자, 쉬자……」
		PRINTFORMDW 피곤했는지 세이란의 구속이 느슨해졌다…….
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
