@K30_PALAMCNG_MAGURO
;-------------------------------------------------
;噴乳
;-------------------------------------------------
IF NOWEX:噴乳
	IF SHIRAHU(30)
		CALLF FIRSTTIME("噴乳")
		PRINTFORML 「내 가슴이... 새고 있어...」
		SIF FIRSTTIME("母乳定着") && TALENT:母乳体質 == 2
			PRINTFORML 「어째서, 나는....?」
	ENDIF
ENDIF
;泥酔はパス
SIF TCVAR:泥酔 == 1
	RETURN 1
;-------------------------------------------------
;五重絶頂
;-------------------------------------------------
IF NOWEX:五重絶頂
	CALL HPH_PRINT("「아아아아아아아~~!!흐읍흐읍」", "L")
	PRINTFORMDW 남은 저항의 감각마저 정신을 부수는 듯한 쾌감에 쓸려나간다...
	PRINTFORMDL 비명을 지르며, 에이키의 몸이 격렬하게 경련한다...
	CALL HPH_PRINT("「...하아프 아아... 우우... 하프 ...아아합프ㅎㅍ」", "W")
	TCVAR:30:397 ++
	RETURN 1
	;-------------------------------------------------
	;四重絶頂
	;記入チェック（=0, 非表示、1, 表示）
	;-------------------------------------------------
ELSEIF NOWEX:四重絶頂
	SELECTCASE NOWEX:四重絶頂
		;Ｍ含まない絶頂
		CASE 1
			PRINTFORMDL 그녀의 감각은 압도적인 쾌감에 명확하게 단락했고, 에이키는 숨을 몰아쉬거나 신음하는 사이 날카로운 비명을 질렀다...
			CALL HPH_PRINT("「아니, 아아아아아~하프 후후프」", "W")
			PRINTFORMDW 그녀의 몸이 믿을 수 없는 절정 이후 마침내 경련하는 것을 멈추자, 에이키는 그저 멍하니 허공을 응시했다...
			PRINTFORMW 「...하아... 하아...... 하아......」
			RETURN 1
			;Ｍを含む絶頂
		CASEELSE
			PRINTFORMDW 에이키의 몸은 여러 에로틱 존으로부터 가차 없이 즐거움을 당한다...
			IF TEQUIP:30:口接触部位 == 4 || GROUPMATCH(SELECTCOM, 20, 19) || TEQUIP:継続キス ;custom code
				PRINTFORMDL 그녀는 사랑보다는 욕망으로 이끌리는 키스를 즐기며, 오직 자신의 몸을 만족시키려 한다...
			ELSE
				PRINTFORMDL 그녀는 당신을 무의식적으로 봉사하며 그것을 직접 자신의 쾌락으로 바꾼다...
			ENDIF
			PRINTFORMDW 즐거움의 파도가 마침내 정점에 도달하여, 에이키가 말을 할 수 없게 만드는 상상조차 불가능할 만큼 강력한 오르가즘으로 부딪혔다...
			CALL HPH_PRINT("「ーー! ～～～～HPH ～～～! ～～～～HPH」", "W")
			RETURN 1
	ENDSELECT
	RETURN 1
	;-------------------------------------------------
	;三重絶頂
	;-------------------------------------------------
ELSEIF NOWEX:三重絶頂
	SELECTCASE NOWEX:三重絶頂
		;両穴+他絶頂
		CASE 1,2,7
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT("「아니, 안 돼, 크으윽흐흐」", "L")
				CASE 1
					CALL HPH_PRINT("「아니, 더는 안 돼! 나... 사정해버릴 것 같아~...흐으읍」", "L")
				CASE 2
					CALL HPH_PRINT("「아아아――, 안 돼! 안 돼... 아아아악」", "L")
			ENDSELECT
			PRINTFORMDL 에이키는 몰려오는 오르가슴을 필사적으로 막으려 하지만, 두 구멍을 강타하는 쾌락이 쉽게 그녀를 압도한다...
			RETURN 1
			;他絶頂
		CASEELSE
			IF TEQUIP:30:口接触部位 == 4 || GROUPMATCH(SELECTCOM, 20, 19) || TEQUIP:継続キス ;custom code
				PRINTFORMDL 에이키는 키스에서 벗어나려 등을 아치형으로 만들지만, 흥분한 몸은 그녀의 의지를 무시한다...
			ELSEIF TEQUIP:30:口接触部位 == 0
				PRINTFORMDL 에이키는 부정하며 머리를 앞뒤로 흔들지만, 강렬한 쾌감에 복종하며 비명을 지를 수밖에 없었다...
			ELSE
				PRINTFORMDL 에이키는 당신을 모시는 것에 집중하여 쾌감에서 벗어나려 하지만, 유혹적인 신음이 입술 사이로 새어 나온다...
			ENDIF
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT("「히이이! 아, 안 돼... 아니, 아아아아아아아아아아아악」", "W")
				CASE 1
					CALL HPH_PRINT("「안 돼! 안 해...! 나... 싸버릴 것 같아아아ㅏ」", "W")
				CASE 2
					CALL HPH_PRINT("「아아! 안 돼, 더는 안 돼, 원하지 않아... 안 돼, 사정할 거야 HPH」", "W")
			ENDSELECT
	ENDSELECT
	RETURN 1
ENDIF
