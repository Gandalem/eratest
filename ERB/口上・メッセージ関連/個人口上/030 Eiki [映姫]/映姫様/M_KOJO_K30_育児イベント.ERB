LOCAL = GETCOLOR()
IF RAND:2
	CALL M_KOJO_COLOR_K30
	CALL COLORMESSAGE(@"「언니는 낮에 자는 걸 좋아한다는 것을 알고 있어.」", K30_CHILDWORD() ,1 ,0)
	CALL COLORMESSAGE(@"「일단 일이 끝나면 원하는 만큼 잠을 잘 수 있어.」", K30_CHILDWORD() ,1 ,0)
	CALL COLORMESSAGE(@"「하지만 지금은 안 돼!」", K30_CHILDWORD() ,1 ,0)
	CALL COLORMESSAGE(@"「일 안 하면 모두에게 큰 문제야!」", K30_CHILDWORD() ,1 ,0)
	CALL COLORMESSAGE(@"「네, \@ CHILD_SEX:30:(TALENT:育児中) == 1 ? 부인 # 선생님 \@.」", LOCAL ,1 ,0)
	PRINTFORMDW 에이키가 지나가자, 그녀는 코마치가 %SHOW_CHILDNAME(30)% 앞에 무릎을 꿇고 있는 것을 본다. %HE_SHE_CHILD(30,,TALENT:育児中)%은 진지하게 그녀에게 말을 건넨다.
	PRINTFORML 
	PRINTFORMW 「음... %SHOW_CHILDNAME(30)%랑... 코마치...?」
	PRINTFORML 「...하아.」
	PRINTFORML 「이 아이조차 당신에게 얼마나 많은 훈육과 관심이 필요한지 이해하다니...」
	PRINTFORMDW 상황을 빠르게 파악한 에이키는 한숨을 내쉰다.
	PRINTFORML 
	PRINTFORML 「%SHOW_CHILDNAME(30)%, 언니가 여기 있으니까 엄마가 "엄청나게" 할 말이 많네.」
	PRINTFORML 「다른 데 가서 놀고 오면 어때?」
	CALL COLORMESSAGE(@"「알았어~」", K30_CHILDWORD() ,1 ,0)
	CALL COLORMESSAGE(@"「우에에... 마치 시키님 두 분이 계신 것 같고, 잔소리도 두 배라니...」", LOCAL ,1 ,0)
	PRINTFORMDW 또 잔소리를 들어야 한다는 것을 깨달은 코마치의 어깨가 슬픔에 축 처졌다...
ELSE
	PRINTFORML 「...잘 들어라, %SHOW_CHILDNAME(30)%. "좋은 것은 기다리는 자에게 온다"는 말을 들었지?」
	PRINTFORML 「나는 그저 빈둥거리고 있을지도 모르지만, 일하기 싫어서 그런 건 아니야.」
	PRINTFORML 「그건 좋은 것을 찾느라 스스로를 지치게 하기보다, 나에게 좋은 것이 오기를 기다리려는 나의 계획의 일부란다.」
	PRINTFORML 「사람들이나 신들, 그리고 물론 사신들도 이런 인내심이 필요하지... 이해하겠지?」
	PRINTFORMDW 코마치는 팔에 머리를 기댄 채 게으름을 피우며 %SHOW_CHILDNAME(30)%의 %HIS_HER_CHILD(30,,TALENT:育児中)% 의 의심을 풀려고 노력한다.
	PRINTFORML
	CALL COLORMESSAGE, @"「하지만... 숙제를 안 하는 건 좋지 않아...」", K30_CHILDWORD() ,1 ,0
	PRINTFORML 「하아, 정말 엄마를 닮았네, %SHOW_CHILDNAME(30)%는?」
	PRINTFORML 「그 나이에 어른처럼 행동하려고 하면, 어린 시절을 놓치게 될 거야, 알잖아?」
	PRINTFORML 「아하하, 누나가 네 미래가 걱정되기 시작했어.」
	CALL COLORMESSAGE, @"「...우웅.」", K30_CHILDWORD() ,1 ,0
	PRINTFORMDW 코마치(Komachi)는 %SHOW_CHILDNAME(30)%을 괴롭하며 시간을 보낸다.
	PRINTFORML
	CALL M_KOJO_COLOR_K30
	PRINTFORML 「...걱정할 필요 없어. 적어도 나는 %HE_SHE_CHILD(30,,TALENT:育児中)%이 너처럼 되지 않을 거라고 확신해.」
	CALL COLORMESSAGE, @"「아, 엄마♪」", K30_CHILDWORD() ,1 ,0
	CALL COLORMESSAGE, @"「시-시키사마...」", LOCAL ,1 ,0
	PRINTFORMDW 에이키가 등장하면서 분위기가 극적으로 변한다.
	PRINTFORML
	PRINTFORML 「단순히 의무를 포기하는 것만으로 만족하지 않고, %SHOW_CHILDNAME(30)%을 타락시키려 들다니...」
	PRINTFORML 「이번엔 절대로 그냥 넘어가게 두지 않을 거야... 준비하고 있겠지.」
	CALL COLORMESSAGE, @"「크윽! 히이익....」", LOCAL ,1 ,0
	PRINTFORMDL 에이키의 차갑고 무덤덤한 목소리는 그녀의 진정한 분노의 깊이를 숨기고 있었는데, 코마치에게는 그 기색이 느껴졌다.
	PRINTFORMDW 코마치는 마치 낙엽처럼 침묵 속에서 떨 뿐이었다... 완전히 패배한 듯했다.
	PRINTFORML
	CALL COLORMESSAGE, @"「엄마, 저 거기 가서 놀게요...」", K30_CHILDWORD() ,1 ,0
	PRINTFORML 「물론이지, %SHOW_CHILDNAME(30)%야, 다른 데 가서 즐겁게 보내렴, 알겠지?」
	PRINTFORML 「오늘 남은 시간 동안 여기로 돌아와선 안 돼.」
	CALL COLORMESSAGE, @"「...알겠어ー」", K30_CHILDWORD() ,1 ,0
	PRINTFORML
	PRINTFORMDW %SHOW_CHILDNAME(30)%이 다가오는 폭풍을 감지하고 떠나자, 지옥으로부터의 에이키의 심판이 시작된다...
ENDIF

