			PRINTFORMDL  %SHOW_CHILDNAME(30)% greets %CALLNAME:CHR%.
		CASEELSE
			キャラ名 = %CALLNAME:CHR%%\@ TALENT:CHR:神霊 ? 様 # さん \@%
			CALL COLORMESSAGE, @"「%あいさつ%, %キャラ名%.」", K30_CHILDWORD() ,1 ,0
			SIF K30_JOBCHECK(ARG)
				CALL COLORMESSAGE, @"「Thank you for all your hard work.」", K30_CHILDWORD() ,1 ,0
			PRINTFORMDL  %SHOW_CHILDNAME(30)% %TEXTR("formally/politely")% greets %CALLNAME:CHR%.
	ENDSELECT
ENDIF

