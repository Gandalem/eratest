;dialogue for custom commands

;Cosplay Sex
@M_KOJO_SUCCESS_CUSTOM_COM_K30_8
;成否判定
;TFLAG:192(-2=強制失敗(注、非コマンド終了）、-1＝強制失敗、0=COM依存、1=強制成功or大成功(注、睡眠薬アイスティーは眠気を感じていると飲まない)
CALL M_KOJO_COLOR_K30
TFLAG:192 = 0
IF TFLAG:194 == 0 ;general check
	;TFLAG:192 = -2 ;refuse to wear any cosplay outfit
ELSE
	;refuses unless Hecatia is here
	IF GROUPMATCH(TFLAG:194, 62, 213) && !CFLAG:[[ヘカーティア]]:うふふ
		PRINTFORML 「No, please. Anything but this.」
		PRINTFORMDL The light disappears from Eiki's eyes as you hold out the infamous t-shirt towards her.
		TFLAG:192 = -2 ;refuse to wear
	ENDIF
ENDIF

;==================================================
;Custom 8,Cosplay
;==================================================
@M_KOJO_MESSAGE_CUSTOM_COM_K30_8
CALL M_KOJO_MESSAGE_CUSTOM_COM_K30_8_1

@M_KOJO_MESSAGE_CUSTOM_COM_K30_8_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME("C8")
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
		RETURN 1
	ELSE
		IF TFLAG:193 == [[映姫]] && GROUPMATCH(TFLAG:194, 62, 213)
			CALL CHARA_TEXT([[ヘカーティア]], "『Yes, you'd look positively adorable in this, Eiki-chan.』", )
			PRINTFORMDL Unable to go against Hecatia, Eiki puts on the outfit with a hollow look in her eyes.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
