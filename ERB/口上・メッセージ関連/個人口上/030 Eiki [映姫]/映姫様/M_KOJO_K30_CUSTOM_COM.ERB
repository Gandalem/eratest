@M_KOJO_MESSAGE_CUSTOM_COM_K30_8
CALL M_KOJO_MESSAGE_CUSTOM_COM_K30_8_1

@M_KOJO_MESSAGE_CUSTOM_COM_K30_8_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME("C8")
		RETURN 1
	ENDIF
	;基本セット
	IF FLAG:70
		RETURN 1
	ELSE
		IF TFLAG:193 == [[映姫]] && GROUPMATCH(TFLAG:194, 62, 213)
			CALL CHARA_TEXT([[ヘカーティア]], "『응, 이걸 입으면 정말 귀여울 거야, 에이키쨩.』", )
			PRINTFORMDL 헤카티아에게 맞설 수 없자, 에이키는 공허한 눈빛으로 의상을 걸었다.
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
