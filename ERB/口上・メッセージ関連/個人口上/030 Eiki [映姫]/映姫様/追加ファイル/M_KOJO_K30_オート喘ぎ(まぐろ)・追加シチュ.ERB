@K30_GASPING_RAND(ARG)
;--------------------------------------------------
#DIM TEMP2
TEMP2 = ARG
SELECTCASE TEMP2
	;ノーマル時は肯定否定半々
	CASE 0
		PRINTFORM %TEXTR("Ahh/Ahn/Hiiie/No/Stop")%
		SIF PALAM:30:欲情 > PALAMLV:8 && RAND:2 == 1
			PRINTFORM ー
		SIF PALAM:30:欲情 > PALAMLV:5 && RAND:2 == 1
			PRINTFORM ♥
		PRINTFORM  
		;キス・フェラはちゅぱ音
	CASE 1
		PRINTFORM %RANDLIPS(1,"kiss")%
		SIF PALAM:30:欲情 > PALAMLV:7 && RAND:2 == 1
			PRINTFORM ♥ 
	CASE 2
		PRINTFORM %RANDLIPS(1,"suck")%
		SIF PALAM:30:欲情 > PALAMLV:7 && RAND:2 == 1
			PRINTFORM ♥ 
		;Ａ弱点なのでハートマシマシ
	CASE 3
		PRINTFORM %TEXTR("Ahn/No/That's/Ahaa/Noo/My butt")%
		IF PALAM:30:欲情 > PALAMLV:7 && RAND:2 == 1
			CALL HPH_PRINT(@"HPH")
			SIF PALAM:30:欲情 > PALAMLV:9
				CALL HPH_PRINT(@"HPH")
			PRINTFORM  
		ELSEIF PALAM:30:欲情 > PALAMLV:4 && RAND:2 == 1
			PRINTFORM ♥ 
		ENDIF
		;セフレ、泥酔時は肯定のみ、ハートマシマシ
	CASE 4, 5
		PRINTFORM %TEXTR("Hyaa/Ahnn/Hiiie/Nnnah/Nnn/Yaahn/Ahhh/Ahaa")%
		SIF PALAM:30:欲情 > PALAMLV:4 && !RAND:3 == 1
			PRINTFORM ー
		SIF PALAM:30:欲情 > PALAMLV:7 && RAND:2 == 1
			CALL HPH_PRINT(@"HPH")
		SIF PALAM:30:欲情 > PALAMLV:9
			CALL HPH_PRINT(@"HPH")
		PRINTFORM  
		;薬時＠こことか個別の方がどう考えてもいいよね。また今度やる
	CASE 6
		IF TCVAR:泥酔 || CFLAG:睡眠
		ELSE
			SELECTCASE SELECTCOM
				CASE 50, 51
					IF TCVAR:無理矢理
					ELSE
						PRINTFORM %TEXTR("Thank you./That's safer./Yes, please.")%
					ENDIF
				CASEELSE
					PRINTFORM %TEXTR("What are you doing?/Stop using strange things./I... feel... strange...")%
			ENDSELECT
		ENDIF
		;ＳＭ時＠ここも個別だ。また今度
	CASE 7
		;スパンキング
		IF SELECTCOM == 100
			IF TCVAR:泥酔
				PRINTFORML %TEXTR("Hurts/Noo～/Yahhn/Stop")%...」
			ELSE
				PRINTFORML %TEXTR("That hurts/Stop/Ouch")%! ...%TEXTR("What are you doing/Please... Stop/Stop... Don't hit me")%...」
			ENDIF
			;それ以外
		ELSE
			IF TCVAR:泥酔
				PRINTFORML %TEXTR("Nnn/Nn～/Mmm～")%...」
			ELSE
				PRINTFORML %TEXTR("I'm scared/What are you doing/Stop being so cruel")%...」
			ENDIF
		ENDIF
		;奉仕(ちゅぱ音無し)時
	CASE 8
		IF TCVAR:泥酔
			PRINTFORM %TEXTR("Nnn～?/What～?/Hard...?/Sticky...?")%
		ELSEIF CFLAG:睡眠
			PRINTFORM %TEXTR("Nnn/Nnー?/Nnnー")%
		ELSE
			PRINTDATA
				DATAFORM 이거 괜찮아?
				DATAFORM 만족해?
				DATAFORM 이렇게 해야 해?
				DATAFORM 이렇게 움직여야 해?
				DATAFORM 이렇게?
			ENDDATA
		ENDIF
ENDSELECT
RETURN 0
