PRINTFORM 「
SIF TCVAR:無理矢理
	PRINTFORM %TEXTR("No/Don't/Stop")%!...
;セフレ、心神喪失、薬、ＳＭは必ず最初に一言
IF (RAND:2 == 0 || GROUPMATCH(状況, 4, 6, 7) || 心神喪失) && !TCVAR:無理矢理
	CALL K30_GASPING_RAND(状況)
	;ＳＭは一言で処理終了
	SIF 状況 == 7
		RETURN 1
	TEMP = 1
ENDIF
;行中の処理
REPEAT 5 + RAND:2
SELECTCASE 状況
	;キス・フェラはちゅぱ音
	;心神喪失・無理矢理時は頻度半分
	CASE 1, 2
		IF (RAND:2 == 1 && !(心神喪失 || TCVAR:無理矢理)) || (RAND:4 == 1 && (心神喪失 || TCVAR:無理矢理))
			IF 状況 == 1
