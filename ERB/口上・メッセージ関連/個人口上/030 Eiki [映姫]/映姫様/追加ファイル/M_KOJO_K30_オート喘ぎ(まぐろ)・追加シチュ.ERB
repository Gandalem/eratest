			ELSE
				PRINTFORM ...%RANDLIPS(1,"suck")%
			ENDIF
			SIF PALAM:30:欲情 > PALAMLV:7 && !TCVAR:無理矢理 && RAND:3 != 1
				PRINTFORM ♥ 
		ELSE
			PRINT ...
		ENDIF
		;通常は拒否っぽい声	、準強制わいせつは寝言っぽいのを、セフレ・恋人同伴は肯定をそれぞれ2回まで
	CASE 0, 4, 5, 9
		IF TEMP2 < 3 && !TCVAR:無理矢理
			IF RAND:3 == 1
				TEMP2 ++
				IF TCVAR:泥酔
					PRINTFORM ...%TEXTR("Nfufu/Nnn～/Ahnn/Nnnn/Hic")%
				ELSEIF CFLAG:睡眠
					PRINTFORM ...%TEXTR("Nnyaa/Afuu/Nnn/Ahnn/Mmph")%
				ELSEIF 状況 == 4 || TALENT:恋慕
					PRINTFORM ...%TEXTR("Feels good/There/Ahh/Yes/Ahn/Yaah")%
					IF (PALAM:30:欲情 > PALAMLV:3 && RAND:3 == 1) || (PALAM:30:欲情 > PALAMLV:5 && RAND:3 != 1)
						PRINTFORM ー
					ENDIF
					IF PALAM:30:欲情 > PALAMLV:6
						SIF RAND:2 == 1
							CALL HPH_PRINT(@"HPH ")
					ELSEIF PALAM:30:欲情 > PALAMLV:3 && RAND:3 != 1
						PRINTFORM ♥ 
					ENDIF
				ELSE
					PRINTFORM ...%TEXTR("I'm not/No/Why/Why do I feel/I shouldn't")%
					IF (PALAM:30:欲情 > PALAMLV:2 && RAND:3 == 1) || PALAM:30:欲情 > PALAMLV:6
						PRINTFORM ー
					ENDIF
					IF PALAM:30:欲情 > PALAMLV:9
						SIF RAND:4 == 1
							CALL HPH_PRINT(@"HPH ")
					ELSEIF PALAM:30:欲情 > PALAMLV:5 && RAND:3 == 1
						PRINTFORM ♥ 
					ENDIF
				ENDIF
			ELSE
				PRINT ...
			ENDIF
		ELSE
			PRINT ...
		ENDIF
