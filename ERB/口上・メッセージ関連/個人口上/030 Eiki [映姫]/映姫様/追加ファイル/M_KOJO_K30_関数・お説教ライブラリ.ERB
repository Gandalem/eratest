;==================================================
;汎用説教判定＆実行

@K30_LECTURE_CHECK(説教長, 理由)
;--------------------------------------------------
;説教長= 説教の行数＝怒り具合
;理由= 説教理由（=0 パンツ =1 セクハラコマンド失敗時 =2ＶＡ強制わいせつ）
;--------------------------------------------------
#DIM 説教長
#DIM 理由
#DIM ぱんつ１
#DIM ぱんつ２
#DIM セクハラ１
#DIM セクハラ２
#DIM 強制わいせつ
#DIM TEMP
;ガード低下時・その他状態異常・うふふ時は判定なし無罪
SIF (CFLAG:1801 == 0 || SHIRAHU(30) != 1 || CFLAG:30:うふふ) && 理由 != 0
	RETURN 1
;変Ｔで目が死んでいるときは説教無し
SIF K30_CHECK_HEN_T() && TALENT:機嫌 > -1
	RETURN 1
;ラブホとお招き部屋にいても説教しない
SIF (CFLAG:30:現在位置 == 連れ込み宿 || CFLAG:30:現在位置 == ラブホ || CFLAG:30:現在位置 == OMANEKIBEYA()) && 理由 != 0
	RETURN 1
SELECTCASE 理由
	;パンツ密輸摘発
	CASE 0
		;説教orぶん殴りで弱味はチャラ
		CFLAG:弱み握り -= 5
		CFLAG:1700 -= 5
		CLEARBIT CFLAG:1699, 1
		;２回まではお説教
		IF ぱんつ１ != DAY
			ぱんつ１ = DAY
			PRINTFORML 
			PRINTFORMW 「...자, 이제 %K30_C_NAME(MASTER)%아.」
			GOTO LECTURE
		ELSEIF ぱんつ２ != DAY
			ぱんつ２ = DAY
			PRINTFORML 
			PRINTFORMW 「네가 아직 교훈을 배우지 못한 것 같군...」
			GOTO LECTURE
			;３回目でぶん殴られる
		ELSE
			PRINTFORML 
			PRINTFORMW 「...%CALLNAME:MASTER%-씨.」
			PRINTFORMW 「말만으로는 충분하지 않은 것 같다.」
			TCVAR:30:371 = 1
			CALL K30_DISCIPLINE_HEAD
		ENDIF
		;セクハラ失敗時
	CASE 1
		;怒り具合30以下ノーカン
		IF 説教長 > 30
			;１日２回お説教
			IF セクハラ１ != DAY
				セクハラ１ = DAY
				PRINTFORML 
				PRINTFORMW 「...이걸 그냥 넘어갈 수는 없어.」
				GOTO LECTURE
			ELSEIF セクハラ２ != DAY
				セクハラ２ = DAY
				PRINTFORML 
				PRINTFORMW 「…넌 여전히 조금도 변하지 않았구나.」
				GOTO LECTURE
				;３回目でぶん殴られる
			ELSE
				PRINTFORML 
				PRINTFORMW 「...이제 지긋지긋하다.」
				PRINTFORMW 「만약 말만으로는 충분하지 않다면...」
				TCVAR:30:371 = 1
				CALL K30_DISCIPLINE_HEAD
			ENDIF
		ENDIF
		;通常時ＶＡコマンド確率で
	CASE 2
		;最初は説教
		IF 強制わいせつ != DAY
			強制わいせつ = DAY
			PRINTFORML 
			PRINTFORMW 「…너는 너무 배려심이 없다.」
			GOTO LECTURE
			;我慢は一回だけ
		ELSE
			PRINTFORML 
			PRINTFORMW 「...이것을 용납하지 않겠다.」
			PRINTFORMW 「If words alone are not sufficient...」
			TCVAR:30:371 = 2
			CALL K30_DISCIPLINE_HEAD
		ENDIF
ENDSELECT
RETURN 1
;説教
$LECTURE
PRINTFORML 「저기 앉아주세요.」
FORCEWAIT
PRINTFORMDW 에이키가 땅을 가리키자, 당신은 그녀 앞에 순종적으로 똑바로 앉는다...
PRINTFORMW 
SELECTCASE 理由
