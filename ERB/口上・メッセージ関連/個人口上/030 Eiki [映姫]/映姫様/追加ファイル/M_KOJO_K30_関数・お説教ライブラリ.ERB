;==================================================
;ぱんつ画像を決定する関数
;全部描ける画力も無いので似た系統のを表示、気が向いたので追加
;--------------------------------------------------
@K30_SELECT_PANTS_TYPE(指定)
#DIM 指定
#DIM G_ID
#DIM ASIDE
#DIMS 色
#DIMS 装着
#DIMS ずらし
#DIMS ヌード
#DIMS ベースぱんつ
#DIMS TEMP_PANTS
#DIMS COLOR = "", "白", "緑", "黒"
LOCAL = 0
RESULTS =
色 = %COLOR:(DAY % 4)%
ASIDE = (CFLAG:うふふ == 1 || TEQUIP:50 >= 0 || TEQUIP:51 >= 0 || TEQUIP:バイブ || TEQUIP:アナルバイブ || 指定 == 2)
ずらし = _%\@ ASIDE ? SHIFT # NORMAL \@% 
ヌード = %\@ K30_NUDITY() ? _NUDE # _WEAR \@%
装着 = %\@ TEQUIP:アナルバイブ ? _VIBE # \@%
;指定あれば画像をそちらに合わせる
SELECTCASE 指定
	CASE -1
		RETURN
	CASE 1, 2
		ヌード = %\@ 指定 == 1 ? _NUDE # _WEAR \@%
	CASE  3
		RESULTS = 30_PANTS_HARNESS
		RETURN
ENDSELECT
SELECTCASE EQUIP:30:下半身下着２
	CASE 0
		;ノーパンorガーターベルトorバイブベルト
		IF TCVAR:30:364 && !CFLAG:うふふ && TEQUIP:アナルバイブ && !CHECK_NUDE(30)
			RESULTS = 30_PANTS_HARNESS
			RETURN
		ENDIF
		SIF TCVAR:30:354 > 0
			RESULTS = 30_PANTS%ヌード%_TYPE10_NO-PANTS
		
	CASE 1, 2, 26
		;1/男物のトランクス,2/緩やかな構造のドロワーズ,26/排便用に股間部が大きく開いたドロワーズ（股開き）
		IF ASIDE
			RESULTS = 30_PANTS_COMMON_TYPE1_SHIFT
		ELSE
			RESULTS = 30_PANTS%ヌード%_TYPE1_NORMAL
		ENDIF
		
	CASE 5
		;5/おしりのラインが強調されるしましまパンツ＠もちろん白黒
		RESULTS = 30_PANTS%ヌード%_TYPE4%ずらし%
		
	CASE 7, 10
		;7/飾り気のない無地のパンツ,10/シンプルなデザインのローレグパンツ
		IF ASIDE
			RESULTS = 30_PANTS_COMMON_TYPE8_SHIFT
		ELSE
			RESULTS = 30_PANTS%ヌード%_TYPE8_NORMAL
		ENDIF
		LOCAL = 1
	
	CASE 11, 20
		;11/おしりの割れ目が見えそうなローライズパンツ,20/きわめて丈が短いスキャンティ
		IF ASIDE
			RESULTS = 30_PANTS_COMMON_TYPE11_SHIFT
		ELSE
			RESULTS = 30_PANTS%ヌード%_TYPE11_NORMAL
		ENDIF
		LOCAL = 1
		
	CASE 12
		;12/きわどく切れ上がったハイレグパンツ
		RESULTS = 30_PANTS%ヌード%_TYPE3%ずらし%
		
	CASE 13, 23
		;13/清楚ながらうっすら透けるレースのパンティ（白）,23/大事な部分がスケスケのシースルーショーツ
		RESULTS = 30_PANTS%ヌード%_TYPE6%ずらし%
		
	CASE 14, 16
		;14/大人の色気たっぷりのレースのパンティ（黒）,16/細い紐で腰に結わえた紐パン
		RESULTS = 30_PANTS%ヌード%_TYPE5%ずらし%
		
	CASE 15
		;15/お尻が丸出しの大胆なＴバック
		RESULTS = 30_PANTS%ヌード%_TYPE12%ずらし%
		
	CASE 17
		;縦にジッパーの走るレザーパンツ
		RESULTS = 30_PANTS%ヌード%%装着%_TYPE7%ずらし%
		
	CASE 18
		;大事にはき古した木綿のぱんつ(固有下着)
		RESULTS = 30_PANTS%ヌード%_TYPE0%ずらし%
		
	CASE 19
		;19/少女らしいキュートなショーツ
		IF ASIDE
			RESULTS = 30_PANTS_COMMON_TYPE2_SHIFT
		ELSE
			RESULTS = 30_PANTS%ヌード%_TYPE2_NORMAL
		ENDIF
		
	CASE 21
		;きゅっとお尻に締め込んだふんどし
		RESULTS = 30_PANTS%ヌード%_TYPE13%ずらし%
	CASE 22
		;極小面積のヒモ同然なＧストリング＠なんとなくガーターベルト仕様
		RESULTS = 30_PANTS%ヌード%_TYPE10%ずらし%
		
	CASE 24
		;ぱっくりと恥丘を剥き出しにしたオープンショーツ
		RESULTS = 30_PANTS%ヌード%%装着%_TYPE9

	CASEELSE
		;初期or獲得可能素質では穿かない/着せ替えのみのぱんつはスルー
		;3/くまさんパンツ,4/水玉パンツ,6/フリルパンツ,25/ばんそうこう = 無知ロリ用、27以降 = 着替え可能判定なし
		RESULTS = 30_PANTS%ヌード%_TYPE0%ずらし%
ENDSELECT

SIF !LOCAL
	RETURN

;色違いぱんつの生成
ベースぱんつ = %RESULTS%
RESULTS = %RESULTS%%色%
;SIF SPRITECREATED(RESULTS)
G_ID = 0
CALL COMPOSE_IMAGE(G_ID, ベースぱんつ, 0, 0, 0, 0, 色)
SPRITECREATE RESULTS, G_ID
RETURN
