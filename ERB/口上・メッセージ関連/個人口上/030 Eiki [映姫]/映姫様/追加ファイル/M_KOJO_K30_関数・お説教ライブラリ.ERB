L_NUM ++
;弱
IF TCVAR:30:365 == 1
	TEX '= \@ NOWEX:Ａ絶頂 ? 4 # %TOSTR(RAND(5, 7))% \@
	TEX2 '= \@ NOWEX:Ａ絶頂 ? %TOSTR(RAND:2)% # %TOSTR(RAND(3, 6))% \@
	;強
ELSE
	TEX '= \@ NOWEX:Ａ絶頂 ? %TOSTR(RAND(2, 4))% # 1 \@
	TEX2 '= TOSTR(RAND(3, 6))
ENDIF
SET_RESOURCE:L_NUM = 30_AHE_EYE%TEX%
RESOURC_NAME += @"눈%TEX%"
L_NUM ++
SET_RESOURCE:L_NUM = 30_AHE_MOUTH%TEX2%
