;映姫様のバイブデート中顔絵を表示する関数
;--------------------------------------------------

@K30_PRINT_VIBE_DATE
#DIM G_ID
#DIM LAYER
#DIM NUM
#DIMS TEX
#DIMS TEX2
#DIM L_NUM
#DIM TEMP_SIZE
#DIM TEMP_WIDTH
#DIM TEMP_SCALE
#DIMS SET_RESOURCE,7
#DIMS RESOURC_NAME
SIF !FLAG:画像表示 || !GETBIT(CFLAG:1500, 1)
	RETURN
VARSET SET_RESOURCE
LAYER = 0
L_NUM = 2
TEX '= \@ TCVAR:30:365 == 2 || NOWEX:Ａ絶頂 ? AHE_ # \@
SET_RESOURCE:0 = 30_%TEX%BASE
SET_RESOURCE:1 = 30_AHE_BODY_WEAR
