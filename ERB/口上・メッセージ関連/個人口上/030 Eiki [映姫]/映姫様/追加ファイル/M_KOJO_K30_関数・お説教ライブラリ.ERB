	RETURNF 2
$PREG
;母胎の成育を見る
SIF TALENT:30:妊娠 && !INRANGE(CFLAG:妊娠経過日数, 31, 70)
	RETURNF 1
;ここまで抜けたらOK
RETURNF 0
