;==================================================
;汎用説教判定＆実行
@K30_LECTURE_CHECK(説教長, 理由)
;--------------------------------------------------
;説教長= 説教の行数＝怒り具合
;理由= 説教理由（=0 パンツ =1 セクハラコマンド失敗時 =2ＶＡ強制わいせつ）
;--------------------------------------------------
#DIM 説教長
#DIM 理由
#DIM ぱんつ１
#DIM ぱんつ２
#DIM セクハラ１
#DIM セクハラ２
#DIM 強制わいせつ
#DIM TEMP
;ガード低下時・その他状態異常・うふふ時は判定なし無罪
SIF (CFLAG:1801 == 0 || SHIRAHU(30) != 1 || CFLAG:30:うふふ) && 理由 != 0
	RETURN 1
;変Ｔで目が死んでいるときは説教無し
SIF K30_CHECK_HEN_T() && TALENT:機嫌 > -1
	RETURN 1
;ラブホとお招き部屋にいても説教しない
SIF (CFLAG:30:現在位置 == 連れ込み宿 || CFLAG:30:現在位置 == ラブホ || CFLAG:30:現在位置 == OMANEKIBEYA()) && 理由 != 0
	RETURN 1
SELECTCASE 理由
	;パンツ密輸摘発
	CASE 0
		;説教orぶん殴りで弱味はチャラ
		CFLAG:弱み握り -= 5
		CFLAG:1700 -= 5
		CLEARBIT CFLAG:1699, 1
		;２回まではお説教
		IF ぱんつ１ != DAY
			ぱんつ１ = DAY
			PRINTFORML 
			PRINTFORMW 「...Now then, %K30_C_NAME(MASTER)%.」
			GOTO LECTURE
		ELSEIF ぱんつ２ != DAY
			ぱんつ２ = DAY
			PRINTFORML 
			PRINTFORMW 「I see you have yet to learn your lesson...」
			GOTO LECTURE
		;３回目でぶん殴られる
		ELSE
			PRINTFORML 
			PRINTFORMW 「...%CALLNAME:MASTER%-san.」
			PRINTFORMW 「It seems that words alone are not sufficient.」
			TCVAR:30:371 = 1
			CALL K30_DISCIPLINE_HEAD
		ENDIF
	;セクハラ失敗時
	CASE 1
		;怒り具合30以下ノーカン
		IF 説教長 > 30
			;１日２回お説教
			IF セクハラ１ != DAY
				セクハラ１ = DAY
				PRINTFORML 
				PRINTFORMW 「...I can't just let this go.」
				GOTO LECTURE
			ELSEIF セクハラ２ != DAY
				セクハラ２ = DAY
				PRINTFORML 
				PRINTFORMW 「...You still haven't changed a bit.」
				GOTO LECTURE
			;３回目でぶん殴られる
			ELSE
				PRINTFORML 
				PRINTFORMW 「...I've had enough of this.」
				PRINTFORMW 「If words alone are not sufficient...」
				TCVAR:30:371 = 1
				CALL K30_DISCIPLINE_HEAD
			ENDIF
		ENDIF
	;通常時ＶＡコマンド確率で
	CASE 2
		;最初は説教
		IF 強制わいせつ != DAY
			強制わいせつ = DAY
			PRINTFORML 
			PRINTFORMW 「...You are far too inconsiderate.」
			GOTO LECTURE
		;我慢は一回だけ
		ELSE
			PRINTFORML 
			PRINTFORMW 「...I will not let this pass.」
			PRINTFORMW 「If words alone are not sufficient...」
			TCVAR:30:371 = 2
			CALL K30_DISCIPLINE_HEAD
		ENDIF
ENDSELECT
RETURN 1
;説教
$LECTURE
PRINTFORML 「Please have a seat over there.」
FORCEWAIT
PRINTFORMDW Eiki points at the ground, and you obediently sit upright in front of her...
PRINTFORMW 
SELECTCASE 理由
	CASE 0
		PRINTFORMW 「Just how much underwear have you stolen? Because I won't believe for a moment that you simply picked them up.」
		PRINTFORMW 「Your kleptomania is completely out of hand!」
	CASE 1
		PRINTFORMW 「Are you truly so deficient in self-control that you would casually lay your hands on any woman?」
		PRINTFORMW 「You must learn to keep your base desires in check!」
	CASE 2
		PRINTFORMW 「\@ TALENT:30:恋人 ? Even between lovers # Even between friends \@, there are lines you shouldn't cross! Have some respect for others!」
		PRINTFORMW 「You are far too lacking in consideration!」
	CASEELSE
		PRINTFORMDW An unexpected lecture case has occurred. We are very sorry, but please report this as a bug, along with the most recently used command.
		PRINTFORMW 「K30_LECTURE_CHECK, your parameters are far too strange! ...Huh?」
ENDSELECT
PRINTFORML 
TEMP = 説教長
WHILE TEMP
	;行頭の修飾。2行に1回確率でつける
	IF  (((説教長 + TEMP) % 2 == 0) && RAND:5 == 0) || (TEMP == 説教長)
		PRINTFORM 「%TEXTR("To begin with/Please think for a moment/To put it bluntly/Listen carefully/More specifically/Now listen here/")%...
	ELSE
		PRINT 「...
	ENDIF
	;1行の長さは適当に
	REPEAT 6 + RAND:4
		;雑に百分率
		SELECTCASE RAND:100
			CASE 0 TO 9
				SELECTCASE 理由
					CASE 0
						PRINTFORM %TEXTR("underwear/a little/your/virtues/panties/Where did/How did/Are you listening...? /Why would")%...
					CASE 1
						PRINTFORM %TEXTR("the afterlife/moderation/clinging to/even though it's unwelcome/your/virtues/reflection/other people's feelings/embarrassing/public/without consideration")%...
					CASE 2
						PRINTFORM %TEXTR("the afterlife/intention/though it's wrong/even though it's unwelcome/your/virtues/reflection/other people's feelings/embarrassing/public/without consideration")%...
					CASEELSE
						PRINTFORM %TEXTR("reflection/a little/your sins/virtue/to Hell/In general, you are/your errors/Are you listening...? /the afterlife")%...
				ENDSELECT
			CASE 10 TO 13
				PRINTFORM ...!
			CASEELSE
				PRINTFORM ...
		ENDSELECT
	REND
	PRINTW 」
	TEMP --
WEND
説教長 *=2
TIME += 説教長
TEMP = MAXBASE:MASTER:気力 / 3
SIF TEMP > BASE:MASTER:気力
	TEMP = MAX(BASE:MASTER:気力, 1)
CALL K30_D_LINE
PRINTFORML 「......」
PRINTFORMW 「...That is all. Now, in regards to what you must do right now...」
SELECTCASE 理由
	CASE 0
		PRINTFORMW 「You must immediately dispose of all of your stolen underwear. This is the first step towards returning to the virtuous path.」
	CASE 1
		PRINTFORMW 「You must reflect on the consequences of your desires. This is the first step towards returning to the virtuous path.」
	CASE 2
		PRINTFORMW 「You must learn how to consider the feelings of others. This is the first step towards returning to the virtuous path.」
	CASEELSE
ENDSELECT
FORCEWAIT
PRINTFORML
PRINTFORMDW It's finally over...
PRINTFORMDL After being lectured by Eiki for {説教長} minutes, you're completely exhausted...
PRINTFORMDW Your legs are numb from sitting...
CALL RECOVER(MASTER, -50, "体力", "Legs have fallen asleep")
CALL RECOVER(MASTER, -(TEMP), "気力", "Long, tedious lecture")
;映姫様が趣味を満喫
SOURCE:鬱屈 -= 1000
SIF SOURCE:鬱屈 < 0
	SOURCE:鬱屈 = 0
SOURCE:歓楽 += ABL:30:親密 * 70
SOURCE:情愛 += 300
TEMP = RAND:5 - 理由
SIF TEMP <= 0
	TEMP = 1
;日記フラグ
IF DIARY:30:5 == 0
	;かなり行儀の悪い受け渡し方だけど、ターン終了直前の茶番だからこれでいいや
	TFLAG:193 = 理由 * 1000 + 説教長
	CALL K30_WRITE_DIARY(5)
ENDIF
PRINTFORML 
PRINTFORMDL After obediently listening to Eiki's lecture, her Trust towards you increases a little.
SIF 理由 == 0
	PRINTFORMDL It seems she's also let you off the hook regarding the panties.
CALL CHANGE_CFLAG(4, 30, TEMP)
RETURN 1
;==================================================
;映姫様の折檻＠遠慮のない一撃
@K30_DISCIPLINE_HEAD
#DIM DAMAGE
;--------------------------------------------------
LOCAL = MIN(1 + 2 * TCVAR:30:371, 7)
