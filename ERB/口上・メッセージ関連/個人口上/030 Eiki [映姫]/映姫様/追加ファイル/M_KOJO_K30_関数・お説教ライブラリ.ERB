@K30_CREAMPIE()
#FUNCTION
;ピルさえ飲めば出すのは安心
SIF TCVAR:30:ピル
	GOTO PREG
;合意状況を見る
SIF (CFLAG:30:生解禁 == 0 && ESTRUS_CYCLE(30) != 15) || (CFLAG:30:生解禁 == 1 && ESTRUS_CYCLE(30) == 150)
	RETURNF 3
