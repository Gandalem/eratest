;==================================================
;複数恋人を制御する関数
;TALENT:MASTER:恋人が変動する仕様変更に対応できないため
;--------------------------------------------------
;ARG	状況分類(0=破局チェック（ターン毎） 1=デート後告白イベント制御 2=告白するコマンド制御
;				 3=破局後チェック
;--------------------------------------------------

@K30_DENY_POLYAMORY(ARG)
;↓のコメントアウト外すと制御解除。エラーは出ないはずだけど@K30_C_NAME関連で変なことにはなる
SIF TALENT:30:妻 ;custom code, skip the check if married
	RETURN 0
SIF ARG != 1 && HAREMUNKILLER_CHECK() ;custom code, harem unkiller toggle
	RETURN
SELECTCASE ARG
	CASE 0
		SIF !TALENT:30:恋人
			RETURN
		SIF TALENT:MASTER:恋人 == 30
			RETURN
		CLEARBIT CFLAG:30:既成事実, 2
		TALENT:30:恋人 = 0
		SETBIT CFLAG:30:1505, 1
		PRINTFORML 
		PRINTFORMDW 새로운 연모를 찾을수록, 무언가 다른 것이 부서진 듯한 기분이 들었다.
		CALL COLORMESSAGE, "당신은 더 이상 에이키의 연인이 아니다.", C_YELLOW, 2, 1
	CASE 1
		IF TALENT:MASTER:恋人 && !HAREMUNKILLER_CHECK() ;custom code, harem unkiller toggle is off
			TCVAR:30:キスキャンセル = 1
			SETBIT CFLAG:30:デート後イベントフラグ, 1
		ELSEIF !(TALENT:MASTER:恋人 || TALENT:30:恋人) || HAREMUNKILLER_CHECK() ;custom code, harem unkiller toggle
			CLEARBIT CFLAG:30:デート後イベントフラグ, 1
		ENDIF
	CASE 2
		SIF !TALENT:MASTER:恋人
			RETURN 0
		SIF GETBIT(CFLAG:1505, 1)
			RETURN 2
		RETURN 1
	CASE 3
		SIF GETBIT(CFLAG:30:1505, 1)
			RETURN 1
ENDSELECT
