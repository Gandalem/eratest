CFLAG:30:風呂 = MIN(CFLAG:30:風呂 + (SUMARRAY(TCVAR:30:0, 390, 395) * 150), 2500)
CFLAG:30:ディレイ += 15
VARSET TCVAR:30:0, 0, 383, 388
TCVAR:30:376 = 0
SIF !ARG
	CLEARBIT TCVAR:30:367, 2
RETURN RESULT
