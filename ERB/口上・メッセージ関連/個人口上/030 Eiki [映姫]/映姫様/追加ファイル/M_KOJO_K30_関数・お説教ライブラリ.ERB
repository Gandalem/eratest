;==================================================
;MASTERの恋人がその場に居るかどうか返す式中関数
;=-1 映姫様が恋人 =0 元から恋人なし =1 その場に居ない =2 恋人と同席
;非恋人時の映姫様を面倒くさい女にさせる
;-------------------------------------------------

@K30_FIND_LOVER()
#FUNCTION
RETURNF FIND_LOVER(30) ;custom code
SIF TALENT:MASTER:恋人 == 0
	RETURNF 0
SIF TALENT:30:恋人
	RETURNF -1
SIF GET_TARGETNUM() < 2
	RETURNF 1
FOR LOCAL, 1, GET_TARGETNUM() + 1
SIF TALENT:(TARGET:LOCAL):恋人 && CFLAG:MASTER:現在位置 == CFLAG:(TARGET:LOCAL):現在位置
	RETURNF 2
NEXT
RETURNF 1
