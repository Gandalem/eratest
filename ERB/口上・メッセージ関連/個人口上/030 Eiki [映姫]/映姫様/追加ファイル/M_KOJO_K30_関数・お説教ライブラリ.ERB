;主人公の呼び名を変更する関数
;スレで話題にあがってたから、なんとなく入れてみる
;構文は命OD勢の口上からほぼそのまま持ってきてます

@K30_SET_C_NAME(ARG)
#DIMS C_NAM
;--------------------------------------------------
;ARG =0:通常の初回入力 =1:恋慕呼び名入力 =2:願掛けからの通常呼び名変更 =3:願掛けからの恋慕呼び名変更
;--------------------------------------------------
RESETCOLOR
PRINTFORMDL %CALLNAME:30%가 당신을 부를 이름을 입력해 주세요. (버튼 중 하나를 사용하거나 직접 입력하세요)
IF ARG == 1 || ARG == 3
	C_NAM = %MASTERNAME:30%
	SIF ARG == 3 && CSTR:30:80 != ""
		C_NAM = %CSTR:30:80%
	PRINTBUTTON "[나의 주군]", "My Lord"
	PRINTL 
	PRINTBUTTON "[마스터]", "Master"
	PRINTL
	PRINTBUTTON @"[%C_NAM%은 괜찮다, 어쨌든]", @"%C_NAM%"
	PRINTL
ELSE
	C_NAM = %CALLNAME:MASTER%
	PRINTBUTTON @"[%C_NAM%%COND_STR(@"-상", !TALENT:30:恋人)%]", @"%C_NAM%"
	PRINTL
ENDIF
$INPUT_LOOP
RESETCOLOR
INPUTS
CALL M_KOJO_COLOR_K30
;行頭行尾の空白文字削除
C_NAM = %RESULTS%
REPLACE C_NAM, "\(\^\\s\+\|\\s\+\$)", ""
;2文字未満
IF STRLENS(C_NAM) < 2
	SIF STRLENS(RESULTS)
		CLEARLINE 1
	REUSELASTLINE 「...Please treat the name your parents gave you with more respect.」
	GOTO INPUT_LOOP
	;12文字(全角6文字)超えた
ELSEIF STRLENS(C_NAM) > 16
	CLEARLINE 1
	REUSELASTLINE 「I'm sorry, that's a little too long to say each time...」
	GOTO INPUT_LOOP
	;以下そのキャラのなりきりでない時
	;同姓同名
ELSEIF !PLAYING_AS(30) && STRCOUNT(C_NAM, "(?i)shiki|eiki")
	CLEARLINE 1
	REUSELASTLINE 「...Please don't mock me like that.」
	GOTO INPUT_LOOP
	;小町or久侘歌
ELSEIF (!PLAYING_AS(129) && STRCOUNT(C_NAM, "(?i)niwatari|kutaka")) || (!PLAYING_AS(76) && STRCOUNT(C_NAM, "(?i)onozuka|komachi"))
	CLEARLINE 1
	REUSELASTLINE 「...That name would be a little too confusing, so please choose something else.」
	GOTO INPUT_LOOP
	;阿求
ELSEIF (!PLAYING_AS(80) && STRCOUNT(C_NAM, "(?i)hieda|akyuu"))
	CLEARLINE 1
	REUSELASTLINE 「...Do you claim to be the current Child of Miare? Please don't joke around like that.」
	GOTO INPUT_LOOP
	;ヘカーティア
ELSEIF (!PLAYING_AS(113) && STRCOUNT(C_NAM, "(?i)hecatia"))
	CLEARLINE 1
	REUSELASTLINE 「...Please refrain from spouting such foolishness. Even disrespect has its limits.」
	GOTO INPUT_LOOP
ENDIF
;変えるって言ったのに呼び名変えてなかったら戻る
SIF (C_NAM == CSTR:30:80 && ARG == 3) || (C_NAM == MASTERNAME:30 && ARG == 2)
	RETURN -1
;直接入力対応＠響子口上からそのまま拝借。改造したいけど正規表現わかんね
IF MASTERNAME:30 == "" || ARG == 2
	IF STRCOUNT(C_NAM, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$")
		CLEARLINE 1
		REUSELASTLINE 「I'm not in the mood for such childishness.」
		GOTO INPUT_LOOP
	ELSEIF STRCOUNT(C_NAM, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$")
		CLEARLINE 1
		REUSELASTLINE 「I'm not in the mood for such childishness.」
		GOTO INPUT_LOOP
	ELSEIF STRCOUNT(C_NAM, "((?i)master|lord|god|shujin|shuujin)$")
		CLEARLINE 1
		IF TALENT:恋慕
			REUSELASTLINE 「That's a little... embarrassing to say in front of others...」
		ELSE
			REUSELASTLINE 「I'm not in the mood for such childishness.」
		ENDIF
		GOTO INPUT_LOOP
	ELSEIF STRCOUNT(C_NAM, "(?i)(husband|dear|darling|honey|hubby|danna)$")
		CLEARLINE 1
		IF TALENT:恋慕
			REUSELASTLINE 「That's a little... embarrassing to say in front of others...」
		ELSE
			REUSELASTLINE 「I'm not in the mood for such childishness.」
		ENDIF
		GOTO INPUT_LOOP
	ENDIF
ENDIF
IF ARG == 1
	PRINTFORML 「당신을 %C_NAM%이라고 부르고 싶어요... 괜찮으세요?」
ELSEIF ARG == 3
	PRINTFORML 「%C_NAM%은(는)... 괜찮아?」
ELSE
	PRINTFORML 「%C_NAM%%COND_STR(@"-san", !TALENT:30:恋人)%은(는) 그런 거야?」
ENDIF
RESETCOLOR
CALL ASK_YN
IF !RESULT
	IF MASTERNAME:30 == "" || ARG == 2
		MASTERNAME:30 = %C_NAM%
	ELSE
		CSTR:30:80 = %C_NAM%
	ENDIF
ELSE
	PRINTFORMDL 이름을 입력해 주세요.
	GOTO INPUT_LOOP
ENDIF
CALL M_KOJO_COLOR_K30
RETURN 1
