L_NUM ++
IF NOWEX:Ａ絶頂
	TEX '= \@ TCVAR:30:365 == 1 ? 0 # %TOSTR(RAND(2, 4))% \@
	SET_RESOURCE:L_NUM = 30_AHE_EFFECT%TEX%
	RESOURC_NAME += @"효과%TEX%"
ELSEIF TCVAR:30:365 == 2
	SET_RESOURCE:L_NUM = 30_AHE_EFFECT1
	RESOURC_NAME += "効果1"
ELSEIF K30_BE_SEEN() && !TFLAG:デート道中
	SET_RESOURCE:L_NUM = 別顔_吐息_30
	RESOURC_NAME += "効果4"
	LAYER = 1
ELSE
	SET_RESOURCE:L_NUM = 汎用エフェクト_spoken squiggle
	RESOURC_NAME += "効果5"
	LAYER = 2
ENDIF
IF !SPRITECREATED(RESOURC_NAME)
	G_ID = 0
	FOR COUNT, 0, L_NUM
	CALL COMPOSE_IMAGE(G_ID, SET_RESOURCE:COUNT)
	NEXT
	SELECTCASE LAYER
		CASE 0
			CALL COMPOSE_IMAGE(G_ID, SET_RESOURCE:L_NUM)
		CASE 1
			CALL COMPOSE_IMAGE(G_ID, SET_RESOURCE:L_NUM, -15, 0, 320, 320)
		CASE 2
			CALL COMPOSE_IMAGE(G_ID, SET_RESOURCE:L_NUM, 0, -15, 270, 270)
	ENDSELECT
	SPRITECREATE RESOURC_NAME, G_ID
ENDIF
TEMP_SIZE = FLAG:マルチサイズ
TEMP_WIDTH = デフォルトキャラ画像横幅
TEMP_SCALE = キャラ画像表示サイズ比
FLAG:マルチサイズ = 1
IF TEMP_WIDTH * TEMP_SCALE > 27000
	デフォルトキャラ画像横幅 = 270
	キャラ画像表示サイズ比 = 100
ENDIF
CALL IMAGE_SET(RESOURC_NAME, 0, 0, キャラ画像表示サイズ比, 0)
SIF 充填率(30, 2) > 30
	CALL DUMMY_SET(0, 0, キャラ画像表示サイズ比, 1)
CALL IMAGE_SET(@"30_SECTIONAL_DATE{TCVAR:30:365}", 0, 0, キャラ画像表示サイズ比, 0)
SIF 充填率(30, 2) > 30
	CALL IMAGE_SET(@"30_SECTIONAL_%\@ 充填率(30, 2) > 60 ? POKKORI # TAPPURI \@%", 0, 0, キャラ画像表示サイズ比, 1)
CALL SIMULTANEOUS_IMAGE_DISPLAY("LEFT", 0, 1, -1)
FLAG:マルチサイズ = TEMP_SIZE
デフォルトキャラ画像横幅 = TEMP_WIDTH
キャラ画像表示サイズ比 = TEMP_SCALE
RETURN 1
