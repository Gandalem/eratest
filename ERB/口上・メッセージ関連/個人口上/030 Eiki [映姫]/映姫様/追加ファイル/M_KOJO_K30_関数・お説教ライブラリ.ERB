;	DEBUGPRINTFORML レイヤ:{COUNT} %SET_RESOURCE:COUNT%
NEXT
IF FLAG:時間停止
	CALL IMAGE_SET("時間停止", 0, 0, キャラ画像表示サイズ比, L_NUM)
