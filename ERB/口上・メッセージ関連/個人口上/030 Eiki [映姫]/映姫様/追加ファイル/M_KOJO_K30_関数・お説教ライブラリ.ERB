@K30_CHECK_HEN_T()
#FUNCTION
SIF DAY % 7 == 5
	RETURNF 1
SIF FLAG:ファッション == 62
	RETURNF 1
SIF CFLAG:30:衣装一時変更 == 62
	RETURNF 1
