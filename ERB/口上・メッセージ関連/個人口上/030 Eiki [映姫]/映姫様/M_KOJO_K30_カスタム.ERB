;コマンド名

@KOJO_COM_NAME_K30_0
RESULTS = Listen To Lecture
;コマンド使用条件。通常のCOM_ABLE関数と同じくRETURN 1すれば実行可能としてコマンドが表示される

@KOJO_COM_ABLE_K30_0
SIF SHIRAHU(MASTER) != 1 || SHIRAHU(30) != 1 || CFLAG:30:1701 < 10 || TFLAG:COMABLE管理 > 1
	RETURN 0
SIF GET_TARGETNUM() > 1 || CHK_DATENOW(CFLAG:30:デート中) || MARK:30:反発刻印 > 1
	RETURN 0
SIF NEMUKE() > 240 || !CHARA_HOLIDAY(30) || K30_CHECK_HEN_T()
	RETURN 0
RETURN 1
;コマンド実行内容。経験・SOURCE変動を記述
;RETURN 1=コマンド実行 / RETURN 0=キャンセル(SOURCE計算SKIP) / RETURN -1=コマンド取り消し

@KOJO_COM_K30_0
#DIM お怒り
お怒り = CFLAG:ブチギレ || MARK:反発刻印
PRINTFORML 정말 확실해?(%\@ お怒り ? In exchange for lightening Eiki's anger # With no further event \@%, 날이 끝날 거야.)
CALL ASK_YN
SIF RESULT
	RETURN -1
;好感度低いなら効果強め、でも効率考えると使う意味なし
TFLAG:194 = 720 - NEMUKE() / 60
SOURCE:情愛 = 75 * TFLAG:194
SOURCE:達成 = 150 * TFLAG:194
IF CFLAG:30:好感度 <= 500
	TIMES SOURCE:情愛, 1.50
	TIMES SOURCE:達成, 1.50
ELSEIF CFLAG:30:好感度 <= 5000
	TIMES SOURCE:情愛, 1.25
	TIMES SOURCE:達成, 1.25
ENDIF
BASE:MASTER:体力 = 0
BASE:MASTER:気力 = 0
IF お怒り
	SOURCE:情愛 = 0
	SOURCE:達成 /= 3
	CFLAG:ブチギレ = 0
	CFLAG:不機嫌 = 0
	BASE:怒り = 0
	BASE:MASTER:体力 = -500
	TFLAG:193 = 1
	IF MARK:反発刻印
		SOURCE:達成 = 0
		MARK:反発刻印 = 0
		TFLAG:193 = 2
		BASE:MASTER:体力 = -2500
	ENDIF
ENDIF
TFLAG:194 = MIN(TFLAG:194, 6)
TIME += TFLAG:194  * 60
RETURN 1
;コマンドメッセージ。口上色が指定される。
;Vの値は(270 + Y)。SELECTCOM/PREVCOMの代入値も同じ

@M_KOJO_MESSAGE_COM_K30_270
#DIM TEMP
#DIM P_REDRAW
#DIM L_COUNT
#DIM LOOP_C
#DIM LINE_C
#DIMS WORDS =	 "In the first place", "I'll say this again", "To be clear", "From my perspective", "To make an analogy", "Moving to another topic", "The important point is", "To change your mindset", "Yes, you should", "Use this opportunity", "Reflect on yourself", "At this rate"
#DIMS MODIFY =	"perpetually", "thoroughly", "endlessly", "forever", "unendingly", "ceaselessly", "neverendingly", "evermore", "singlemindedly", "relentlessly", "constantly", "continually", "untiringly", "eternally", "unceasingly", "until you click", "as expected", "incessantly", "everlastingly", "tirelessly"
CALL FISHER_YATES_SHAFFLE(12)
CALLF FUNC_FISHER_YATES_SHAFFLE(LOCAL, 20)
VARSET LOCALS
TEMP = 0
MODIFY:(LOCAL:0) '= ""
IF TFLAG:193
	PRINTFORMDL 요청대로, 에이키는 당신에게 %TEXTR("격렬한 열정으로/천 개의 지옥불의 열기로/거센 홍수처럼")% 강의를 시작한다...
ELSE
	PRINTFORMDL 당신의 요청을 들은 에이키는 %TEXTR("거침없는 열정으로/큰 기쁨으로/마치 그것이 그녀가 평생 원했던 것처럼")% 강의를 시작한다...
ENDIF
PRINTW
PRINTFORML 「!!」
IF !TFLAG:193
	PRINTDATAW
		DATAFORM 「훌륭하군... 정말 가상한 태도야.」\n「새로운 시선으로 너를 보게 되었네.」
		DATAFORM 「내 가르침을 듣는 것에 그토록 열의가 있었는지 몰랐다.」\n「마침내 덕 있는 삶을 쌓는 것의 중요성을 깨달은 듯하군.」
		DATAFORM 「너 같은 존경할 만한 사람이 되었으니...」\n「나의 일상이 비로소 보상받고 있음을 느끼네.」
	ENDDATA
	PRINTFORML 「...좋다.」
	PRINTFORML 「운 좋게도, 나는 오늘 다른 계획이 없다.」
	PRINTFORML 「당신을 가르치는 데 %TEXTR("최선을 다할 것이다/평소보다 더 많은 시간을 들일 것이다/오늘까지의 모든 생각을 포함할 것이다")%를 할 것이다.」
ELSE
	PRINTDATAW
		DATAFORM 「드디어... 드디어 새 출발을 하는구나.」
		DATAFORM 「이렇게 반성하는 마음을 외면할 리 없지.」
		DATAFORM 「내 인내심이 바닥나기 전에 네 잘못을 깨달아서 기쁘구나.」
	ENDDATA
	PRINTFORML 「오늘 다른 계획은 없어... 그러니 걱정할 필요는 없을 거야.」
	PRINTDATAL
		DATAFORM 「그러니, 이것은 시간이 좀 걸릴 수 있다... 하지만 잘 들어주렴.」
		DATAFORM 「그렇다면 어디서부터 시작해야 할지... 말하면서 생각을 정리하겠다.」
		DATAFORM 「그리고 내 말이 끝난 후에도 당신에게 남을 수 있도록, 나의 가르침을 철저히 주입해 주겠어.」
	ENDDATA
ENDIF
PRINTL
P_REDRAW = CURRENTREDRAW()
LINE_C = LINECOUNT
REDRAW 0
WHILE 1
FOR LOOP_C, 0, 5
IF !TEMP
	LOCALS:99 = Now listen carefully
ELSEIF TEMP % 2
	LOCALS:99 =
ELSE
	SIF !LOOP_C
		LOCAL:99 = LOCAL:99 == 11 ? 0 # LOCAL:99 + 1
	LOCALS:99 = \@ !LOOP_C ? %WORDS:(SHAFFLE_ARRAY:(LOCAL:99))% # %LOCALS:99% \@
ENDIF
LOCALS:0 = 「%LOCALS:99%%UNICODE(0x2026) * (MAX(1, 9 - STRLENSU(LOCALS:99)))%」
FOR L_COUNT, 1, 4
LOCALS:L_COUNT '= COND_STR(@"「%UNICODE(0x2026) * ((4 - L_COUNT) * 2 + 1)%」", LOOP_C >= L_COUNT)
NEXT
LOCALS:4 '= COND_STR(@"(%MODIFY:(LOCAL:TEMP)%에 의해) 설교를 듣는 중이다...", LOOP_C == 4)
FOR L_COUNT, 0, 5
IF L_COUNT < 4
	PRINTFORML %LOCALS:L_COUNT%
ELSE
	PRINTFORMDL %LOCALS:L_COUNT%
ENDIF
NEXT
TWAIT 350 + ((LOOP_C == 4) * 1050), 0
SIF GETKEY(1) && TEMP > 1
	GOTO LOOP_BREAK
CLEARLINE LINECOUNT - LINE_C
NEXT
CLEARLINE LINECOUNT - LINE_C
TEMP = TEMP < 19 ? TEMP + 1 # 1
WEND
$LOOP_BREAK
REDRAW P_REDRAW
LOCALS:0 '= "「...」", "「......」", "「.........Hmm?」"
CALL PRINT_GROUP(LOCALS, 3, 350)
IF TFLAG:193
	PRINTFORMDL ...{TFLAG:194}이(가) \@ TFLAG:194 == 1 ? 시간 # 시간들 \@ 후에, 에이키의 기분이 마침내 나아졌다.
	PRINTFORMDW %\@ TFLAG:193 > 1 ? Eiki loses 1 hate mark # Eiki's anger has subsided \@%.
ELSE
	PRINTFORMDL {TFLAG:194}이(가) \@ TFLAG:194 == 1 ? 시간 # 시간들 \@이 지나도 에이키는 조금의 피로함도 보이지 않는다.
	PRINTFORMDL 오히려 그녀는 시간이 지날수록 더욱 열정적으로 변하며, 이 강의를 완전히 즐기고 있는 듯하다.
ENDIF
PRINTFORML
PRINTFORMDW 하지만 당신은 한계에 도달했다...
RETURN 1
