;custom code
;determines if a specific event/command has timestop dialogue
;overrides CFLAG:時間停止口上有
@M_KOJO_K30_TIMESTOP_ALLOWED(ARGS, ARG, ARGS:1)
SELECTCASE ARGS
    CASE "COM"
        SIF GROUPMATCH(ARG, 48)
            RETURN -1
    CASE "SCOM"
    CASE "CUSTOM_COM"
    CASE "CUSTOM_SCOM"
    CASE "EVENT"
    CASE "PALAM"
    CASE "COUNTER"
    CASE "COM_ASSISTANT"
    CASE "SCOM_ASSISTANT"
    CASE "CUSTOM_COM_ASSISTANT"
    CASE "CUSTOM_SCOM_ASSISTANT"
ENDSELECT
RETURN 0
