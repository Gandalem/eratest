@M_KOJO_MESSAGE_COM_K30_1_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ENDIF
	;マグロスイッチオン
	IF TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
		CALL K30_GASPING_MAGURO
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「아... 그렇게 자세히 보지 마... 너무 부끄럽단 말이야...」
		PRINTFORMW 「에헤, 정말 핥으려고 해...? 히야아!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;膣内射精直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:100 == PLAYER && TCVAR:112 == 1
		PRINTFORMDL 당신이 방금 사정시킨 정액이 에이키의 사랑의 분비물과 섞여 그녀의 %FSYN("vagina")%에서 흘러나온다...
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「에... 당신은 그 정도까지 할 수 있군요... 안~♥」
			CASE 1
				PRINTFORMW 「흐읍... 음... 무리하지 마, 알았지?...」
			CASE 2
				PRINTFORMW 「\@ ABL:精液中毒 >= 3 ? 후후... 정말 맛있을 것 같아...♥ # 음... 정말 상관없는 거야...? \@」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;絶頂した
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		;欲情3以上で、地の文にクリトリス吸い上げが入る
		IF PALAM:欲情 >= PALAMLV:4
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아니, 그렇게 많이 빨지 마! 아하♥」
					PRINTFORMW 「네가 그걸 하면, 안 돼... 나, 사정할 것 같아~♥」
				CASE 1
					PRINTFORML 「아, 그렇게... 시끄럽게 하지 마요... 너무 야하게 들려요...」
					PRINTFORMW 「흐으읍... 저 좀 쉬게 해줘요... 아, 안 돼... 아아~♥」
				CASE 2
					PRINTFORMDL 당신은 에이키의 부어오른 붉은 음핵을 부드럽게 깨물며 그녀를 오르가슴으로 몰아간다...
					PRINTFORMW 「햐아!! 히이~~♥」
			ENDSELECT
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「...오르네, 나 오르고 있어♥」
			ELSE
				PRINTFORMDL 에이키는 음핵을 핥아져 치를 떨지만, 쾌감이 점차 지배하기 시작한다...
				PRINTFORMW 「안 돼... 안 돼, 그만해... 아...?! 아, 아아~~♥」
			ENDIF
		ENDIF
		;欲情3以上
	ELSEIF (PALAM:欲情 >= PALAMLV:4) && !RAND:3 == 1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL 이키의 음핵을 빨면서 일부러 큰 소리를 내는 것이 그녀의 치부를 자극하는 것을 즐긴다...
				PRINTFORMW 「흐아아! ...그런 추한 소리 내지 마... 안 돼, 아...♥」
			CASE 1
				PRINTFORMW 「아... 아! 그렇게... 강하게는...」
			CASE 2
				PRINTFORMDL 치정스러워진 이키는 마치 밀어내려는 듯 당신의 머리에 손을 올린다.
				PRINTFORMW 「아우우...♥ 안 돼, 그만해... 아, 후와아... 쿠우～...♥」
				PRINTFORMDW 하지만 그녀는 계속하라는 듯 다리를 더 벌렸고, 이내 달콤한 신음만이 입에서 새어 나왔다.
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「아... 아아... 음♥ ...」
			CASE 1
				PRINTFORML 「안... 후와아♥ ...느」
				PRINTFORMW 「너무... 자세히... 보지... 마...」
			CASE 2
				PRINTFORMW 「아... 음, 그런 음탕한 소리 내지 마...」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
