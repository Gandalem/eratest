@M_KOJO_MESSAGE_COM_K30_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ENDIF
	;マグロスイッチオン
	IF TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
		CALL K30_GASPING_MAGURO
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:30:処女 != 0
			PRINTFORML 「조금 무서워요... 하지만 이런 것에 익숙해져야겠지요...」
			PRINTFORMW 「...부디, 부드럽게 해주세요...」
		ELSE
			PRINTFORMW 「...이게 일을 하는 올바른 순서가 아닌 것 같지...?」
		ENDIF
		RETURN 1
	ELSEIF TEQUIP:バイブ
		;∨感覚Lv.5以上
		IF ABL:Ｖ感覚 >= 5 && !RAND:3 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「아우... 후와♥ 아, 후와아♥ 안♥」
					PRINTFORMDW 에이키는 진동기의 아주 작은 움직임에도 반응하며 기쁨을 자유롭게 받아들인다...
				CASE 1
					PRINTFORML 「안 돼... 아아핫!♥ 아♥ 아♥ ...안 돼...」
					PRINTFORMDW 에이키는 바이브레이터의 모든 움직임에 맞춰 음탕한 소리를 낸다...
				CASE 2
					PRINTFORML 「우으... 아♥ 안 돼, 그만해... 우으, 아♥ 제발... 자비를 베풀어줘...♥」
					PRINTFORMDW 진동기에서 오는 쾌감에 압도된 에이키의 목소리는 애원과 황홀감이 뒤섞여 있었다...
			ENDSELECT
			;Ｖ感覚2以上
		ELSEIF ABL:Ｖ感覚 >= 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「꺄아... 아, 그만둬, 이건... 너무해... 안♥」
				CASE 1
					PRINTFORMW 「우리 함께 기분 좋아하지 않을까... 야아♥」
				CASE 2
					PRINTFORMW 「아, 안 돼, 그만♥ 그런 소리 내지 마...」
			ENDSELECT
		ELSE
			PRINTFORML 「흐으음... 우우, 크윽... 안 돼... 그만해...」
			PRINTFORMDW 에이키는 즐거움보다는 압박감을 느끼는 듯 미간을 약간 찌푸렸다.
		ENDIF
	ELSE
		;∨感覚Lv.5以上
		IF ABL:Ｖ感覚 >= 5 && !RAND:3 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 에이키를 당황시키려고 당신은 그녀 주위를 손가락으로 비비며 %FSYN("vagina")% 음란하고 질척이는 소리를 유도하기 위해...
					PRINTFORMW 「아... 안 돼, 그만해... 부끄러워... 아♥ 아♥ 자비를 베풀어줘...」
				CASE 1
					PRINTFORML 「응... 바로 거기, 천천히... 하아♥」
					PRINTFORMDW 에이키가 자신의 손으로 당신의 손을 이끌며 그녀의 G스팟을 찾아냈다...
				CASE 2
					PRINTFORML 「손가락보다는... 나는 원해... 나의...♥」
					PRINTFORMDW 이키의 잘 발달된 %FSYN("vagina")%은 더 이상 손가락만으로는 만족할 수 없는 것 같다...
			ENDSELECT
			;Ｖ感覚2以上
		ELSEIF ABL:Ｖ感覚 >= 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「당신의 손가락들... 너무 음란하게 움직여요...♥」
				CASE 1
					PRINTFORMW 「천천히만 하면 괜찮아... 더 깊이... 아앗♥」
				CASE 2
					PRINTFORMW 「...후우♥ 이건, 부끄럽지만... 기분이, 좋아... 아래쪽이...♥」
			ENDSELECT
		ELSEIF ABL:Ｖ感覚 == 1
			IF RAND:2 == 0
				PRINTFORMW 「아... 당신의 손가락이 문지르고 있어...」
			ELSE
				PRINTFORML 「아, 안 돼... 이건 너무 창피해...」
				PRINTFORMDW 하지만 그녀의 말과는 달리, 에이키는 당신의 손가락을 %FSYN("vagina")% 움켜쥐고 안으로 끌어당긴다.
				PRINTFORMW 「아, 만약 네가 그렇게 손가락을 비틀면... 아, 안 돼...」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「우으... 우와아... 좀... 꽉 끼네...」
			ELSE
				PRINTFORML 「아응... 크윽, 아으... 우웅... 흠...」
				PRINTFORMDW 이키는 여전히 아주 작은 움직임 외에는 익숙하지 않은 것 같다...
			ENDIF
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1
