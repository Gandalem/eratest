@M_KOJO_MESSAGE_COM_K30_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;時姦中
	IF FLAG:70
		RETURN 1
	ENDIF
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「우으... 당신의 손이... 너무 야하네...」
		RETURN 1
	ENDIF
	;マグロスイッチオン
	IF TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
		CALL K30_GASPING_MAGURO
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;挿入中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V挿入
	IF LOCAL:1 && TEQUIP:50 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「음... 아... 너무... 뜨거워...」
				CASE 1
					PRINTFORMW 「아... 우우... 아... 터지고 있어...」
				CASE 2
					PRINTFORMW 「후와아... 채워지고 있어... 으음...」
			ENDSELECT
			PRINTFORMDW 사정의 쾌감으로 몸이 떨리는 가운데, 그녀의 매끄러운 피부가 당신에게 스치는 감각을 음미한다.
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			PRINTFORMDW 교감에서 오는 쾌감이 에이키의 당신의 애무에 대한 감각을 증폭시키며 그녀를 가볍게 오르가즘으로 이끈다...
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「아... 아아... 대...단해...」
				CASE 1
					PRINTFORMW 「%MOAN(,,3)%... 후와아!」
				CASE 2
					PRINTFORMW 「하아... 하아... 후와... 아...!」
			ENDSELECT
		ENDIF
		;A挿入
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;射精した
		IF NOWEX:PLAYER:11
			SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT("「음... 너무 따뜻해... 아응흐헵」", "W")
				CASE 1
					CALL HPH_PRINT("「아... 사정하고 있어 HPH ...많이 HPHHPH」", "W")
				CASE 2
					CALL HPH_PRINT("「푸와아~... 너... 사정하네... 으응흐햬」", "W")
			ENDSELECT
			PRINTFORMDW 사정의 쾌감으로 몸이 떨리는 가운데, 그녀의 매끄러운 피부가 당신에게 스치는 감각을 음미한다.
		ELSEIF NOWEX:0 || NOWEX:1 || NOWEX:2 || NOWEX:3
			PRINTFORMDW 교감에서 오는 쾌감이 에이키의 당신의 애무에 대한 감각을 증폭시키며 그녀를 가볍게 오르가즘으로 이끈다...
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「아... 아아... 정말... 멋지네...♥」
				CASE 1
					PRINTFORMW 「%MOAN(,,3)%♥ 후와아!」
				CASE 2
					PRINTFORMW 「하아♥ 하아... 후와... 아앗...!」
			ENDSELECT
		ENDIF
		;手淫してもらった直後
	ELSEIF PREVCOM == 80
		PRINTFORMD 그녀의 수음에 응답하여, 당신은 에이키를 어루만지기 시작한다. 
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINTFORMD 흥건하게 젖은 
		PRINTFORMDL %FSYN("vagina")%...
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「아... 후와아... 서로... 즐겨보자...♥」
			CASE 1
				PRINTFORMW 「함께♥ 아아~... 아, 후와♥」
			CASE 2
				PRINTFORMW 「안, 아아... 후후, 답례품 고마워♪」
		ENDSELECT
		;これで絶頂する&ランダム1/2
	ELSEIF (NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂) && RAND:2 == 0
		;キスもした
		IF EXP_UP(27, TARGET) && RAND:2 == 0
			IF RAND:2 == 0
				PRINTFORML 「...%RANDLIPS(,"kiss")% ...아! 안돼♥」
				PRINTFORMDW 쾌락을 견디지 못한 에이키는 키스를 풀고 활시위를 당긴 듯 등을 아치형으로 휘며 숨을 몰아쉰다...
			ELSE
				PRINTFORML 「...%RANDLIPS(,"kiss:heart")%.」
				PRINTFORMDW 그녀는 극도의 쾌감을 입술로 전달하려는 듯, 강렬하게 계속 키스한다…
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORML 「하아... 후와...! 안 돼♥ 정액이 나와버릴 거야!」
				PRINTFORMDW 쾌락을 견디지 못하고 에이키는 활시위를 당긴 듯 등을 아치형으로 휘며 숨을 몰아쉬었다...
			ELSE
				PRINTFORML 「아아, 하아... 아! ...커밍... 커밍구~♥」
				PRINTFORMDW 에이키는 당신이 손가락으로 그녀를 희롱하자 절정에 이른다...
			ENDIF
		ENDIF
	ELSE
		;キスもした
		IF EXP_UP(27, TARGET) && RAND:2 == 0
			IF RAND:2 == 0
				PRINTFORML 「...%RANDLIPS(,"kiss")%♥ ...후후... 또♪ ...츄♥」
				PRINTFORMDW 서로의 입술을 장난스럽게 깨물면서, 에이키의 부드러운 피부가 자신에게 닿는 감각을 즐긴다...
			ELSE
				PRINTFORML 「츄♥ ...후후, 당신과 이것을 하는 것이 좋아요... 응, 츄...」
				PRINTFORMDW 에이키의 몸은 당신의 애무와 키스에 반응하며 이완되고 꿈결 같은 표정이 얼굴에 떠올랐다...
			ENDIF
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMDL 에이키의 피부를 어루만지던 당신은 갑자기 그녀 목덜미에 키스한다.
					PRINTFORMW 「...꺅, 그렇게 빨아버리면... 자국이 남을 거야...」
				CASE 1
					PRINTFORMW 「크으, 음... 당신의 손길이... 너무 짜릿해요...」
				CASE 2
					PRINTFORMW 「아... 아, 거기... 더 만져줘... 하아♥」
				CASE 3
					PRINTFORMDL 당신은 그녀의 손을 부드럽게 옆구리와 팔 아래로 미끄러뜨린다.
					PRINTFORMW 「캬아!... 아아... 당신의 손이... 너무 달콤해...」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1
