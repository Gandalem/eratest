;100,スパンキング
;マイ口上構文参考にしました
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K30_100
IF TCVAR:30:385 || FLAG:70 || TCVAR:30:無理矢理
	RETURN 0
ELSE
	CALL K30_TRAIN_MESSAGE_100
	RETURN 1
ENDIF

@M_KOJO_MESSAGE_COM_K30_100
TCVAR:30:355 = TIME:1
CALL K30_PRINT_BUTT_IMAGE(SELECTCOM)
CALL M_KOJO_MESSAGE_COM_K30_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K30_100_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;-------------------------------------------------
	;時姦中
	IF FLAG:70
		RETURN 1
	ELSEIF FIRSTTIME(SELECTCOM)
		PRINTFORML 「?!」
		PRINTFORML 「어... 갑자기 뭐 하는 거야?!」
		PRINTFORMDW 에이키는 갑작스러운 스팽킹에서 고통보다 충격을 더 느끼는 것 같다.
		RETURN 1
		;マグロスイッチオン
	ELSEIF TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
		CALL K30_GASPING_MAGURO
		RETURN 1
		;ABL:マゾっ気はちゃんと機能してない？結局お尻を使ったプレイになったし適当にＡ感覚で代用
		;不慣れ
	ELSEIF ABL:Ａ感覚 < 3
		PRINTFORML 「%TEXTR("/Uuu/No/Why")%... 내가 이런 걸 받을 만한 일을 했다는 기억이 없어!」
		PRINTFORML 「만약 그렇다면... 네가 맞이 벌을 받아야 할 것 같은데...」
		PRINTFORMDW 그녀가 붉어진 엉덩이를 문지르자, 에이키는 불만스럽게 항의한다...
		RETURN 1
		;非挿入時
	ELSEIF ALLSAMES(TEQUIP:50, TEQUIP:51, -1)
		PRINTDATAL
			DATAFORM 「흐음...♥ 마음껏 나를 때리고 있지만...」\n「그냥 이렇게 내버려 둘 생각은 없겠지, 그렇지?♥」
			DATAFORM 「정말 불쾌한 행동이네...♥」\n「당신에게 부탁할 거야... 당장 기분을 풀어주도록♥」
			DATAFORM 「내 엉덩이가... 아파...♥」\n「제발... 기분 좋게 해줘...♥」
		ENDDATA
		PRINTFORMDW 그녀의 엉덩이를 때린 직후, 에이키는 기대하며 그것을 좌우로 흔든다...
		IF RAND:2 == 1
			PRINTFORMDL 당신은 개처럼 그녀의 붉어지는 엉덩이를 핥기 시작한다.
			IF ABL:Ａ感覚 < 5 || RAND:2
				PRINTFORML 「히야♥ 당신은... %K30_C_NAME(MASTER)%?!」
				PRINTFORML 「이상해... 간질거리는 것 같아... 음♥」
				PRINTFORMDW 에이키는 당신의 변태적인 행동에 초조하게 신음한다...
			ELSE
				CALL HPH_PRINT, @"「히야아흐헵 거기 없어헵 나한테 핥지 마...헵」", "L"
				CALL HPH_PRINT, @"「아... 아아앙 하지 마... 안 돼애에으윽」", "L"
				PRINTFORMDW 네가 그녀의 뜨겁고 염증 난 엉덩이를 혀로 핥자, 에이키는 당황한 목소리로 신음하고 비명을 질렀다...
			ENDIF
		ELSE
			PRINTFORMDL 당신은 마치 달래듯이 에이키의 엉덩이를 쓰다듬기 시작했다.
			IF ABL:Ａ感覚 < 5 || RAND:2
				PRINTFORML 「아후♥ 그거, 기분 좋아... 저 간지러움이 사라지고 있어...♥」
				PRINTFORML 「%K30_C_NAME(MASTER)%, 부디... 내 엉덩이를 더욱 달래줘♥」
				PRINTFORMDW 에이키는 고통이 쾌감으로 변하는 감각에 완전히 중독된 듯하다...
			ELSE
				CALL HPH_PRINT, @"「응...후프 당신의 손은 정말 부드럽고 기분 좋네... 하지만...」", "L"
				PRINTFORMDL 당신이 그녀의 뜨겁고 부어오른 엉덩이를 부드럽게 어루만지자, 그녀의 사타구니가 %FSYN("juice")%로 넘치기 시작한다.
				CALL HPH_PRINT, @"「조금은... 부족한 듯해... 히이이히프프ㅎ」", "L"
				PRINTFORMDW 당신의 손가락이 그녀의 클리토리스를 가볍게 스치자 기대감에 몸을 떨었고, 에이키는 음란한 쾌락의 비명을 터뜨렸다.
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;挿入時
	IF PALAM:欲情 < PALAMLV:10 || !RAND:4
		STRDATA LOCALS
			DATAFORM 「아우...♥」 \n 「방금... 아주 깊은 곳에서부터...」 \n 「히이이♥」
			DATAFORM 「꺄아♥」\n 「이런 기분... 매를 맞으면서 느끼다니...」 \n 「왜... 왜 내가 이럴까...」
			DATAFORM 「아후우...♥」 \n 「너무 큰... 소리야...」 \n 「고통보다 더 부끄럽네...♥」
		ENDDATA
		SIF TEQUIP:51 == MASTER
			LOCALS '= REPLACE(LOCALS, "♥", "HPH")
		CALL HPH_PRINT, LOCALS, "L"
		PRINTFORMDL 당신은 에이키의 엉덩이를 때리며, 그녀의 치정 감정을 자극하기 위해 힘을 참아 소리가 크게 울리게 한다.
		PRINTFORMDW 당혹스러움에도 불구하고, 그녀의 \@ !TEQUIP:50 ? 질 # 항문 \@ 의 조임이 그녀가 즐기고 있다는 것을 분명히 알려준다...
	ELSE
		STRDATA LOCALS
			DATAFORM 「히이♥ 아-아니... 그런 거 아니야♥」\n「동시에 맞추고 있어, 안 돼♥」
			DATAFORM 「아! 아으♥ 아히이♥」\n「나, 맞는 중이야♥」\n「너무 깊어서 느껴져, 아주 깊은 곳까지♥」
			DATAFORM 「후우ー♥ 후우ー♥ 후우-...」\n「...히이♥」\n「용서해줘♥ 제발, 이 타락한 엉덩이를 용서해줘♥」
		ENDDATA
		SIF TEQUIP:51 == MASTER
			LOCALS '= REPLACE(LOCALS, "♥", "HPH")
		CALL HPH_PRINT, LOCALS, "L"
		PRINTFORMDW 채찍질이 이제 그 감각을 고조시키는 역할만 하기에 \@ TEQUIP:51 == MASTER ? 항문 섹스 # 섹스 \@, 에이키는 쾌락에 몸을 맡긴다...
	ENDIF
	PRINTFORML 
	;Ｖ挿入/Ａ挿入:感覚-低
	IF TEQUIP:50 == MASTER || ABL:Ａ感覚 < 5 || PALAM:欲情 < PALAMLV:10 || RAND:2
		PRINTFORMDL 갑자기 에이키에게 허리를 부딪히는 것을 멈추고 그녀의 엉덩이를 부드럽게 쓰다듬는다...
		IF TEQUIP:50 == MASTER
			PRINTFORML 「네, 거기... 타는 것 같아요...♥ 나아앙♥」
			PRINTFORML 「아아...♥ 너무 뜨거워요...♥」
			PRINTFORML 「엉덩이랑 사타구니가... 정말 뜨거워요...♥」
		ELSE
			CALL HPH_PRINT, @"「아아아아안, 안 돼! 내 엉덩이... 너무 외로워어어」", "L"
			CALL HPH_PRINT, @"「%K30_C_NAME(MASTER)%!! 서둘러줘, 내 안으로 밀어 넣어줘 HPHHPH」", "L"
		ENDIF
		PRINTFORMDW 그녀의 민감한 엉덩이를 비비자, 에이키의 \@ !TEQUIP:50 ? %FSYN("vagina")%, 당신의 %FSYN("penis")%로 가득 찬 # 흥건하게 젖은 %FSYN("vagina")% \@ 신선한 꿀처럼 흘러내린다...
		;Ａ挿入:感覚-高
	ELSE
		PRINTFORMDL 당신이 에이키의 항문에 당신의 %FSYN("penis")%을 가능한 한 깊숙이 박아 넣자, 이번에는 그녀의 엉덩이를 더 강하게 때린다.
		CALL HPH_PRINT, @"「하아히에헵ㅎㅍ 나의 엉덩이헵 ㅅ-그렇게 강렬해헵」", "L"
		CALL HPH_PRINT, @"「내 엉덩이가 부서질 거야, 부서지고 있어」", "W"
		PRINTFORMDW 당신에게 지배당하는 감각에 취한 이키는 신음하며 숨을 몰아쉬며 즐거움에 침을 흘린다...
	ENDIF
ENDIF
RETURN 1
;地の文改変

@K30_TRAIN_MESSAGE_100
CALL K30_D_LINE
IF GROUPMATCH(MASTER, TEQUIP:50, TEQUIP:51)
	PRINTFORMD 이키의 \@ !TEQUIP:50 ? %FSYN("vagina")% # 뒤를 즐기면서 \@, 너는 이키의 %HIP(TARGET)%를 때린다.
ELSEIF TEQUIP:0 & 1 && (EQUIP:スカート || EQUIP:下半身上着 || EQUIP:ワンピース || EQUIP:着物)
	PRINTFORMD 당신은 에이키의 %SHOW_BOTTOM(TARGET,1)%를 들어 올리고 에이키의 %HIP(TARGET)%를 찰싹 때린다.
ELSE
	PRINTFORMD 당신은 에이키의 %HIP(TARGET)%를 때린다.
ENDIF
SIF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ
	PRINTFORMD 그녀의 %SHOW_下半身下着(TARGET,2)%로 가려져 있다.
PRINTFORMDL .
PRINTFORMD 그녀의 뒤쪽을 계속 때리면서 움직임의 속도를 조절한다. 
IF ABL:Ａ感覚 < 3
	PRINTFORMDL 약간 붉어지기 시작한다...
ELSEIF ALLSAMES(TEQUIP:50, TEQUIP:51, -1)
	PRINTFORMDL 그리고 %FSYN("juice")%이 그녀의 가랑이에서 흘러내리기 시작한다...
ELSE
	PRINTFORMDL 그리고 그녀의 \@ !TEQUIP:50 ? %FSYN("vagina")% # 항문 \@이 당신 주위를 리듬에 맞춰 조인다...
ENDIF
PRINTFORMW 
RETURN
