@M_KOJO_MESSAGE_COM_K30_91_1
#DIM CHR
CHR = TFLAG:193
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;地の文総入れ替え
	CALL K30_D_LINE
	SELECTCASE TFLAG:194
		CASE 0
			PRINTFORMDL 당신은 에이키에게 항문을 핥으라고 명령한다.
			PRINTFORMDL 그녀는 \@ TCVAR:30:泥酔 ? 항의하며 고개를 저지만 포기하고 # 망설이며 시선을 돌린 후 \@ 그녀의 입을 당신의 항문에 갖다 대는데...
		CASE 1
			PRINTFORMDL 당신은 에이키에게 항문을 핥으라고 명령한다.
			PRINTFORMDL 그녀는 혀를 내밀고 아무런 항의 없이 당신의 항문 주변을 핥기 시작한다...
		CASE 2
			PRINTFORMDL 당신이 자신의 뒤를 에이키에게 가까이 가져가자, 그녀는 스스로 얼굴을 더 가까이 움직였다.
			PRINTFORMDL 에이키는 당신의 항문을 사랑스럽게 키스한 후, 언어적으로 체계적으로 그것을 섬기기 시작했다...
		CASE 3
			PRINTFORMDL 당신이 이키에게 엉덩이를 가까이 가져가자, 그녀는 당신의 단단한 %FSYN("penis")%을 움켜쥐고 위아래로 쓰다듬는다.
			PRINTFORMDL 그녀는 기쁨으로 떨리는 당신의 항문을 행복하게 바라본 후, 자신의 혀로 그것을 체계적으로 봉사하기 시작한다...
		CASE 4
			PRINTFORMDL 당신이 %CALLNAME:CHR%'의 \@ !TEQUIP:CHR:50 ? %FSYN("vagina")% # 항문을 침범하면, 이키에게 당신의 항문을 핥으라고 명령했다. \@
			PRINTFORMDL 이키는 당신과 %CALLNAME:CHR%이 교미하는 곳을 응시하며 얼굴을 붉혔다.
			PRINTFORMDL 그녀는 조심스럽게 얼굴을 당신의 항문에 가까이 가져가며 그 주변을 핥기 시작했다...
		CASE 5
			PRINTFORMDL %CALLNAME:CHR%가 당신의 %FSYN("penis")%를 핥자, 당신은 에이키에게 당신의 항문을 핥으라고 명령한다.
			PRINTFORMDL 에이키는 %CALLNAME:CHR%를 부러운 눈으로 바라본다...
			PRINTFORMDL 하지만 그녀는 곧 평정을 되찾고 당신의 항문에 봉사를 시작한다...
	ENDSELECT
	PRINTFORMW 
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF TCVAR:30:泥酔
			PRINTFORMW 「하고 싶지 않아...」
		ELSEIF TCVAR:30:385 || TCVAR:30:無理矢理
			PRINTFORMW 「도대체... 인간의 한계란 어디까지인 거니?」
		ELSEIF ABL:Ａ感覚 < 2 || ABL:30:奉仕精神 < 5
			PRINTFORML 「...누군가에게 실제로 그런 것을 요구하려면, 당신은 희망 없는 사람이어야 해.」
			PRINTFORMW 「하지만 거절할 수 없다는 건... 나도 다르지 않은 걸지도 몰라...」
		ELSE
			PRINTFORML 「...여기에서도 즐기는 거야...?」
			PRINTFORMW 「...나도 최선을 다할게.」
		ENDIF
		RETURN 1
	ENDIF
	SIF TCVAR:30:無理矢理 || TCVAR:30:泥酔
		RETURN 1
	SELECTCASE TFLAG:194
		CASE 0
			PRINTFORML 「츄우, 챱... 우으... 흐읍...」
			PRINTDATAW
				DATAFORM 「"저주받았다"는 용어에 대해 알고 있나?」 \n 「...지금 당신이야말로 그런 부류 중 하나라고 생각한다.」
				DATAFORM 「...당신처럼 비양심적인 사람은 이 일을 아무렇지도 않게 생각할지 모르지만...」 \n 「나는 이것을 치욕으로밖에 볼 수 없다...」
				DATAFORM 「...위생적이지 못한 것보다 신성모독적인 것을 건드리는 것에 더 신경이 쓰인다.」 \n 「나는 정말 죄악스러운 짓을 하고 있다...」
			ENDDATA
		CASE 1
			PRINTFORML 「%RANDLIPS(,"kiss:heart")%.」
			PRINTDATAW
				DATAFORM 「나 이쪽 좀 잘하고 있는 것 같아.」 \n 「어때... 기분 좋지 않아?」
				DATAFORM 「...네 페니스가 이렇게 떨리는 걸 보는 거야... 내 혀로 이런 식으로 할 때...」 \n 「네가 그렇게 큰 쾌감을 느끼는 걸 보니까...」 \n 「나도 기분이 좋아지거든...♥」
				DATAFORM 「...네가 나에게 이곳이 얼마나 좋은지 가르쳐 준 사람이었지.」 \n 「그래서 그 가르침에 보답하고 싶어...♥」
			ENDDATA
			IF NOWEX:MASTER:射精
				PRINTFORML 
				PRINTDATAW
					DATAFORM 「참지 마...」\n「이렇게 싸도 괜찮아...♥」
					DATAFORM 「...아아♥ 그렇게 고환이 긴장하는 걸 보니... 명백해.」\n「자, 나에게 해줘...♥」
					DATAFORM 「...가까워졌지?」\n「입에 넣고 싶지만... 그냥 이렇게 싸버려♥」
				ENDDATA
			ENDIF
		CASE 2, 3
			PRINTFORMW 「%RANDLIPS(,"kiss:heart")%.」
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...이런 행동은 야마답지 않다는 걸 알고 있어요.」
					PRINTFORML 「하지만 제가 이렇게 하는 건 오직 당신을 섬기기 위한 이유인 것 같아요...」
					PRINTFORMW 「정말 흥분돼요...♥」
				CASE 1
					PRINTFORML 「%K30_C_NAME(MASTER)%, 기분 좋지...?」
					PRINTFORML 「만약 당신이 행복하다면... 어디든 괜찮아.」
					PRINTFORMW 「그러니 이 야마의 혀와 입을 마음껏 사용해줘♥」
				CASE 2
					PRINTFORML 「당신에게 명령받은 후에 이걸 하고 있으니... 싫지는 않네요.」
					PRINTFORML 「이렇게 복종하는 것처럼 보여야 한다고 해도... 오히려 흥분되네요...♥」
					PRINTFORMW 「그러니 부디, 당신이 만족할 때까지 계속 봉사하게 해주세요♥」
			ENDSELECT
			IF TFLAG:194 == 3
				PRINTFORML 
				PRINTFORML 「...후후♥ 네 아래가 정말 %TEXTR("미끌거려/딱딱해/단단해")%하구나...♥」
				PRINTFORML 「널 더 기분 좋게 해주고 싶어... %RANDLIPS(2,"kiss:heart")%.」
				PRINTFORMDW 에이키는 네 %FSYN("페니스")%를 짜내려고 손놀림을 빠르게 하며, 당신의 항문에 %TEXTR("시끄럽게 빨아들인다/혀를 안으로 집어넣는다/열렬하게 키스한다")%...
			ENDIF
		CASE 4
			PRINTFORML 「%RANDLIPS(,"kiss:heart")%.」
			PRINTDATAW
				DATAFORM 「아앙♥ 너무 많이 움직이면 핥기가 힘든데...♥」\n「아니면... 너무 기분이 좋아서 멈출 수 없는 걸까?」
				DATAFORM 「%K30_C_NAME(CHR)%도 정말 행복해 보여...♥」\n「다음엔... 나한테 차례를 줄 거지, 응?」
				DATAFORM 「놀랍다, %K30_C_NAME(CHR)%... 아주 음란하게 벌어지고 있어...♥」\n「이렇게 될 수 있도록...」
				DATAFORM 「야마가 %K30_C_NAME(CHR, 3)%를 아래에 고정한 채 네 항문을 핥게 하려고...」\n「너는 분명 이 세계에서 가장 행복하고 도착적인 사람이겠지♥」
			ENDDATA
			PRINTFORML 
			IF NOWEX:MASTER:射精
				PRINTFORMDL 에이키는 사정을 재촉하려는 듯 계속 당신의 항문을 애무했다.
				PRINTFORMDL 그녀가 한 올 한 올 접힌 부분을 핥을 때, 당신은 그 쾌감을 견디려 무의식적으로 삽입 속도를 늦췄다.
				PRINTFORMDW %CALLNAME:CHR%'의 \@ !TEQUIP:CHR:50 ? %FSYN("vagina")% # 항문이 마치 당신을 재촉하듯 조여왔고, 당신은 곧 한계에 도달했다... \@
			ELSE
				PRINTFORMDL 이키의 정성스러운 항문 서비스 때문에 하반신이 무너질 것 같다.
				PRINTFORMDL %CALLNAME:CHR%의 \@ !TEQUIP:CHR:50 ? 부드러운 질 주름 # 단단하게 조이는 항문 \@과 합쳐져, 그 쾌감은 거의 너무 크다.
				PRINTFORMDW 당신은 이를 악물고 다가오는 사정을 억누르려 하며, 그 쾌감을 조금이라도 더 연장하려 한다...
			ENDIF
		CASE 5
			PRINTDATAL
				DATAFORM 「너무 많이 움찔거리고 있어, 여기서...♥」\n「나도 뒤처지지 않으려면 열심히 해야 해, %K30_C_NAME(CHR)%...」
				DATAFORM 「후후후♥ 내 입과 %K30_C_NAME(CHR)%의 입이...」\n「지금은 그저 네 즐거움을 위한 도구일 뿐이야.」\n「그러니 더 기분 좋아지도록 그것들을 사용해줘...♥」
				DATAFORM 「%K30_C_NAME(CHR)%... 정말 열렬하게 핥고 있네...♥」\n「조금은 부럽긴 하지만...」\n「지금은... 네가 기분 좋아지는 게 더 중요해♥」
			ENDDATA
			PRINTFORMW 「%RANDLIPS(,"kiss:heart")%.」
			IF NOWEX:MASTER:射精
				PRINTFORMDL 열렬하게 혀를 놀리며, 에이키는 당신의 더러운 구멍을 봉사하는 것 외에는 모든 것을 잊는다.
				PRINTFORMDW %CALLNAME:CHR%가 당신을 더욱 빠르게 빨기 시작하자, 당신은 금세 한계에 도달했음을 깨닫는다...
			ELSE
				PRINTFORMDL %CALLNAME:CHR%와 에이키는 모두 그들의 타락한 서비스에 취해있다...
				PRINTFORMDL 에이키가 모든 주름을 복종시킬 때, %CALLNAME:CHR%는 경쟁하듯 당신을 완전히 %HIS_HER(CHR)%의 목구멍까지 데려간다.
				PRINTFORMDW 이 두 아름다운 몸과 그들의 음탕한 서비스에 둘러싸여, 당신은 압도적인 정복감에 잠긴다...
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
;アナル舐めでサドっ気ではなく奉仕精神が上がる映姫様のEXTRASOURCE関数

@M_KOJO_EXTRASOURCE_COM_K30_91
#DIM CHR
;ソース変更処理
SOURCE:征服 = 0
SOURCE:情愛 = 0
SOURCE:達成 = 300
SOURCE:屈従 = 2500
SOURCE:逸脱 = 1200
SOURCE:反感 = 1200
TCVAR:MASTER:射精箇所 = 9
;地の文分岐決定
SIF TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
	RETURN
SOURCE:反感 /= 2
SIF !TALENT:30:恋慕 || ABL:30:奉仕精神 < 5 || ABL:30:Ａ感覚 < 2 || !STRCOUNT(CSTR:30:0, "/91/")
	RETURN
SOURCE:情愛 = 200
SOURCE:反感 /= 3
TFLAG:194 ++
SIF ABL:30:Ａ感覚 < 5 || ABL:30:奉仕精神 < 7 || PALAM:30:欲情 < PALAMLV:9 || !RAND:4
	RETURN
SOURCE:情愛 *= 2
SOURCE:達成 *= 2
SOURCE:反感 /= 2
TFLAG:194 ++
CHR = MASTER_POSE(0, 1)
;３Ｐ中挿入orフェラ→TARGET変更アナル舐めで疑似タブルコマンド化
IF CHR && ((!TEQUIP:CHR:50 && ABL:CHR:Ｖ感覚 > 2) || (!TEQUIP:CHR:51 && ABL:CHR:Ａ感覚 > 2))
	TFLAG:193 = CHR
	TFLAG:194 = 4
ELSEIF CHR && TEQUIP:CHR:口接触部位 == 1 && EXP:CHR:精飲経験 > 19
	TFLAG:193 = CHR
	TFLAG:194 = 5
	;あなたが射精直前でTINKOが空いてたらアナル舐め手コキ扱い
ELSEIF TCVAR:MASTER:イきそう && (!CHR || GROUPMATCH(MASTER_POSE(30, 1, 1), 3, 4))
	TFLAG:194 = 3
	CALL TOUCH_SET(SET_FROM_YUBI, SET_P, 30)
	TCVAR:MASTER:射精快感強度 = 700
	SOURCE:MASTER:快Ｃ += ABL:30:指 * 20
	EXP:30:手淫経験 ++
ENDIF
