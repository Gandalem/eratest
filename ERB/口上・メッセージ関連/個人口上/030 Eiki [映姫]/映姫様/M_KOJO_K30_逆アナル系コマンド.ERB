LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:194
		CASE 0, 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMDL 에이키를 제압하고 침과 함께 최음제를 키스로 전달한다.
					PRINTFORMDL 에이키는 그것을 모두 받아들이고 꿀꺽 소리를 내며 삼킨다...
					PRINTFORMW 
					PRINTFORML 「...응♥ 꿀꺽, 음크흡... 응♥」
					PRINTFORML 
					PRINTFORMW (아아... 뭔가 하고 있어... 정말 치정적이네...♥)
				CASE 1
					PRINTFORMDL 당신은 최음제를 손가락에 바르고 에이키 앞에 그것을 들었다.
					PRINTFORMDL 온 손가락을 입에 넣은 에이키는 최음제를 삼키고 계속 그것을 빨았다...
					PRINTFORMW 
					PRINTFORML 「%RANDLIPS(,"suck:heart")%」
					PRINTFORML 
					PRINTFORML (그것을 핥는 것만으로도... 몸이... 뜨거워지는 걸 느껴...)
					PRINTFORMW (이 손가락만으로는 부족할 거야...♥)
				CASE 2
					PRINTFORMDL 당신은 키스를 통해 에이키에게 최음제를 직접 먹인다.
					PRINTFORMDL 그녀는 당신의 목을 감싸 안고, 에이키가 탐욕스럽게 당신의 입술을 빨아들인다...
					PRINTFORMW 
					PRINTFORML 「%RANDLIPS(,"suck:heart")%」
					PRINTFORML 
					PRINTFORML (%K30_C_NAME(MASTER)%'의 입술이... 너무 맛있다...♥)
					PRINTFORML (나는 %HIM_HER(MASTER,,1)%에게 계속 키스하고... 마시고 싶다...)
					PRINTFORMW (더, 더... 더 원한다♥)
			ENDSELECT
			PRINTFORML 
			PRINTFORML 「푸와아...♥」
			PRINTFORMW 
			IF TFLAG:192 < 120
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「...이 모든 건 이 약 때문이야.」
						PRINTFORML 「나를 이런 수치스러운 짓을 하게 만들고 있어... 그리고 아래가 너무 흥분하게 만들어.」
						PRINTFORML 「그리고 내가 하려는 모든 것들... 마음껏 신음하며...」
						PRINTFORML 「이 모든 건 이 약 때문이야... 그리고 당신...♥」
					CASE 1
						PRINTFORML 「평범한 섹스... 당신에게 너무 일상이 되었나요?」
						PRINTFORML 「그렇다면 기꺼이... 함께 놀아줄게요♥」
						PRINTFORML 「하지만 그 대가로... 이 모든 것에 대한 전적인 책임을 지는 게 좋을 거예요...♥」
					CASE 2
						PRINTFORML 「이 약은 정말 효과가 있어... 거의 너무 효과적이야.」
						PRINTFORML 「이렇게 말하고 있는 중에도... 우리가 하려는 일들이 머릿속을 스쳐 지나가고 있어...♥」
						PRINTFORML 「%K30_C_NAME(MASTER)%... 이 생각들을... 현실로 만들어 줄 거지?♥」
				ENDSELECT
			ELSEIF RAND:2 == 1
				PRINTFORML 「이 약이 없어도... 나는 벌써 당신밖에 생각나지 않아♥」
				PRINTFORML 「...그래서 알려줄게... 이걸 마시고 난 뭘 해야 할지 모르겠어♥」
			ELSE
				PRINTFORML 「...도대체 무슨 계획이야, 나한테 이걸 그렇게 많이 먹이려는 건?」
				PRINTFORMW 「무슨 음란한 짓을... 나에게 하려고 생각하는 거니..♥」
				PRINTFORML 「...잊지 마, %K30_C_NAME(MASTER)%아.」
				PRINTFORML 「나 같은 야마(閻魔)의 내면에도 어두운 욕정들이 잠들어 있어.」
				PRINTFORML 「그러니 만약 그것들이 깨어난다면... 네가 책임을 질 준비를 해야 할 거야♥」
			ENDIF
			PRINTDATADW
				DATAFORM 에이키의 눈은 당신을 바라보며 욕망으로 가득 차 있다.
				DATAFORM 에이키는 음흉하게 당신에게 미소 짓고 있다...
				DATAFORM 에이키의 입가에서 가느다란 침줄이 흘러내린다...
			ENDDATA
		CASE 2
			SETBIT TCVAR:30:367, 0
			PRINTFORMDL 에이키는 말없이 최음제를 입에 흘려 넣는다...
			PRINTFORMW 
			IF K30_KIMESEKU()
				CALL K30_KIMESEKU_BUFF
				PRINTFORML 「...Ah♥♥」
				PRINTFORMDL 에이키에게 뭔가 이상한 것이 있는 것 같다...
				PRINTFORMDW 최음제 때문에 에이키는 지금 [발정 상태]다.
				IF GETBIT(TCVAR:30:367, 1)
					PRINTFORMDL 게다가 그녀에게는 평소의 야마다운 위엄이라고는 찾아볼 수 없고, 대신 순전한 음탕함의 분위기를 풍긴다.
					PRINTFORMDL ...최음제의 효과로 인해 그녀가 [%GET_TALENTNAME_TR(4, 1)%]하게 된 것 같다.
				ENDIF
				PRINTFORMW 
				PRINTFORML 「후후... 후후훗♥」
				PRINTFORML 「...더는... 참을 수 없어♥」
				PRINTFORML 「%K30_C_NAME(MASTER)%... 약은 이제 그만...」
				PRINTFORMW 「서둘러... 이 욕망들을... 진정시켜줘...♥」
			ELSE
				PRINTFORML 「...적당한 것이 다 좋다고들 하니까.」
				PRINTFORML 「그래서 오늘은 이쯤에서 그만둬야겠어.」
				PRINTFORMW 「이제부터는... 오직 쾌락만을 생각하자...♥」
				PRINTFORMDL 에이키가 이성을 유지하려 하지만, 그녀의 눈에는 수상한 빛이 감돌고 있었다...
				PRINTFORMDW 최음제 때문에 에이키는 지금 [발정 상태]이다.
				TCVAR:30:発情 = 1
			ENDIF
		CASE 3
			PRINTFORMDL 당신은 에이키에게 최음제를 먹이려고 시도하지만 그녀는 거부한다.
			PRINTFORMW 
