@M_KOJO_MESSAGE_COM_K30_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時姦中＆チョコレートプレイ
	IF FLAG:70 || GETBIT(STAIN:1, 7)
		RETURN 1
		;マグロスイッチオン
	ELSEIF TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
		CALL K30_GASPING_MAGURO
		RETURN 1
	ELSEIF TALENT:処女 && HAS_PENIS(MASTER)
		PRINTFORML 「거기 안쪽이 이제 너무 축축하고 미끌미끌해...」
		PRINTFORMW 「네가 ... 넣고 싶다는 거야...?」
	ELSEIF HAS_PENIS(MASTER) && (ABL:Ｖ感覚 + ABL:Ａ感覚 > 7) && TFLAG:194 >= PALAMLV:7 && RAND:3
		PRINTFORMW 「더 이상 필요 없다고 생각하는데.」 
		PRINTFORML 「...그렇지 않으면 버리게 될 테니, 대신 너와 나누도록 할게... 어때?」
		PRINTFORML 「기분 좋게 잘 발라줄게... 그리고 이걸 같이 즐기자...♥」
		PRINTFORMDL 에이키가 그녀의 %SLIT_TR(30)%에서 로션을 떠서 당신의 %TINKO_TR(MASTER)%에 골고루 바른다...
		SELECTCASE BASE:MASTER:勃起
			CASE 0 TO 499
				WAIT
				PRINTFORML 「후훗♥ 이렇게 작을 때도 귀여워...」
				PRINTFORML 「하지만 크면 더 좋으니까♥」
				PRINTFORMDW 아주 살짝만 만져도 %FSYN("penis")%로 피가 점차 몰려오는 것을 느낄 수 있다.
				BASE:MASTER:勃起 = 1000
			CASE 500 TO 999
				WAIT
				PRINTFORML 「후훗❤ 더 커져라~❤」
				PRINTFORMDW 에이키의 능숙한 손가락이 로션 위에서 곧 당신의 %FSYN("penis")%을 격렬하게 만들었다.
				BASE:MASTER:勃起 = 1500
			CASE 1500
				PRINTFORML 
				PRINTFORMDW 에이키의 섬세한 손가락 스침에 통제력을 잃을 것 같은 기분이 든다.
			CASEELSE
				PRINTFORMDW 에이키의 손가락 감각이 당신의 %FSYN("penis")%로 더욱 많은 피를 몰고 왔다.
		ENDSELECT
	ELSEIF TFLAG:194 >= 30000 && PALAM:30:欲情 > PALAMLV:6 && RAND:2
		PRINTFORML 「난... 로션이 꼭 필요하다고 생각하지 않아.」
		PRINTFORML 「그냥 봐... 너에게 너무 참을 수가 없어서 벌써...♥」
		PRINTFORMDL 네가 로션을 바르는 와중에도, 에이키의 %FSYN("vagina")%은 흥분과 기대감으로 넘쳐흘렀다.
		PRINTFORMDW 그녀의 %SLIT_TR(30)%는 유혹하듯 움찔거리고 꿈틀거렸다...
	ELSE
		PRINTDATAW
			DATAFORM 「거기 아래가 너무 매끄럽게 느껴져... 그리고 반짝이고 있어...」\n「너무... 음란해 보여...♥」
			DATAFORM 「음... 좀 차갑게 느껴지네...」\n「다시 따뜻하게 해줬으면 좋겠어...♥」
			DATAFORM 「거기 아래가 이렇게 젖는 게 좀 부끄럽네...」\n「하지만 다음에 뭐가 올지 생각하니까 더 짜릿해져...♥」
		ENDDATA
	ENDIF
ENDIF
RETURN 1
