@DIARY_TEXT_K30, PAGENUM, MODE, PAGECOUNT
;PAGENUM   =日記のパターン
;MODE      =デイリー:一日終了時のデイリーイベントでの読み上げ
;          =コマンド:[日記を読む]コマンドでの読み上げ
;PAGECOUNT =何ページ目に書かれているか
;=============================
#DIM PAGENUM
#DIMS MODE
#DIM PAGECOUNT
#DIM 重複防止
#DIM 日付
#DIMS 表情
#DIMS 台詞
#DIMS 服装
#DIMS エフェクト
VARSET LOCALS
服装 = 服
エフェクト =
TFLAG:192 = 0
SIF GETBIT(CFLAG:30:1500, 2)
	SETANIMETIMER 50
;口上色＠コマンドで呼び出された時、色を付ける
CALL M_KOJO_COLOR_K30
;日記内容
;グループマッチに日記のIDを入れて、表示させたい顔絵を表示する。
IF MODE == "デイリー"
	;一時的に拡張顔絵に変更
	VARSET LOCAL
	LOCAL = FLAG:立ち絵種類
	FLAG:立ち絵種類 = 1
	LOCAL:1 = CFLAG:30:差し替え適用
	CFLAG:30:差し替え適用 = 1
	;カジュアルデーorファッションブームなら素敵なＴシャツ
	SIF YOUBI_MATCH(DAY, "金") || PAGENUM == 7
		服装 = 服_変Ｔ
	;ページごとに表情の指定
	SELECTCASE PAGENUM
		CASE 1, 2, 32
			IF K30_DIARY_DATA(PAGENUM, 2) == "恋"
				表情 = 笑顔
				TFLAG:192 = -7
			ELSE
				表情 = %\@ PAGENUM == 1 ? 発情 # 睡眠 \@%
			ENDIF
		CASE 3, 4, 9, 11, 13, 14, 16, 17, 18, 20, 21, 22, 24, 32, 33, 36, 50
			表情 = アニメ
			SIF PAGENUM == 36
				エフェクト = 照れ
		CASE 5, 20, 25
			表情 = 反発
		CASE 6, 7, 12, 26, 34
			表情 = 笑顔
		CASE 8, 10
			表情 = 怒り
		CASE 15, 27, 31, 35
			SELECTCASE K30_DIARY_DATA(PAGENUM, 5)
				CASE "怒"
					表情 = 怒り
				CASE "喜"
					表情 = LOVE
					エフェクト = 照れ
				CASEELSE
					表情 = 赤面
					エフェクト = 照れ
			ENDSELECT
		CASE 23
			表情 = 絶頂
			服装 = 服_下着
			TFLAG:192 = -9
		CASE 30, 37, 38
			表情 = %\@ PAGENUM == 30 ? LOVE # 発情 \@%
			TFLAG:192 = -7
			SIF PAGENUM == 37
				SETBIT CFLAG:1609, 0
		CASE 39
			表情 = 睡眠
			エフェクト = 照れ
		CASE 40
			表情 = 無表情
			エフェクト = 照れ
			TFLAG:192 = -7
	ENDSELECT
	PRINTFORML 
	CALL PRINT_FACE,30, 表情, 服装, "", エフェクト
	;立ち絵種類を元に戻す
	FLAG:立ち絵種類 = LOCAL
	CFLAG:30:差し替え適用 = LOCAL:1
ENDIF
IF MODE == "コマンド"
	;初見
	IF !STRCOUNT(CSTR:30:0, "日記初見")
		PRINTFORMDW 무엇이 적혀 있을지 궁금해하며 일기를 넘기고 그 내용을 훑어본다.
		PRINTFORML 
		PRINTFORML O/X □일 맑음
		PRINTFORML 
		PRINTFORML 오전 6시. 기상. 신체 상태와 건강 양호하다. 오늘은 비근무일이다. 계획된 순찰 지역에는 인간 마을이 포함되어 있다...
		PRINTFORML ...오전 11시. 근처 인간 마을에서 코마치가 일을 빼먹고 있는 것을 발견했다. 그녀의 이전 범죄에 대해서도 심문했다...
		PRINTFORML ...오후 1시. 심문과 질책이 끝났다. 인간 마을을 계속 순찰했다...
		PRINTFORMW ......
		PRINTFORMDW 일기라기보다는 일일 업무 기록에 가까웠지만, 당신은 에이키와의 첫 만남에 대한 항목을 찾아내기는 했다.
		PRINTFORML
		CALLF FIRSTTIME("日記初見")
		;2回目以降、最初のページの前に
	ELSEIF 重複防止 != DAY
		;適当にお説教の対象として名前だけ。神様に当たったら小町に
		LOCAL = RAND(RANDOM_CHARANUM - 1) + 1
		SIF TALENT:LOCAL:神霊
			LOCAL = 76
		PRINTFORMDL 당신은 임의의 페이지로 넘긴다...
		IF LOCAL == 76 || RAND:3 == 1
			PRINTDATADW
				DATAFORM 놀랍지 않게도, 에이키는 코마치가 일을 빠지는 모든 것을 알고 있는 듯하다.
				DATAFORM 하루 종일 밤낮으로 코마치에게 잔소리를 했다는 기록들이 있다.
				DATAFORM 코마치에게 세 시간 동안 강의를 했다는 기록이 있다.
				DATAFORM 그녀의 일이 얼마나 바쁜지에 대해 언급하는 기록은 있지만, 불만족에 대한 암시는 없다.
			ENDDATA
		ELSE
			PRINTDATADW
				DATAFORM 그것은 %CALLNAME:LOCAL%에게 전달된 강의에 대한 기록이다.
				DATAFORM "%K30_C_NAME(LOCAL,3)%를 꾸짖어야 할 것들"이라는 제목의 항목이 있다.
				DATAFORM 평소처럼 일일 업무 일지 형식으로 구성된 항목이 있다.
				DATAFORM 거기에는 %CALLNAME:LOCAL%를 방문하여 강의할 계획이 적혀 있다.
				DATAFORM 그녀가 부하 직원들에게 느끼는 감사함에 대한 좋은 기록이 있다.
			ENDDATA
		ENDIF
		PRINTFORMDL ―――――――――――――――――――――――――――――
		PRINTFORMDL 조금 더 읽어보니, 자신에 대한 몇몇 구절도 발견한다.
		PRINTFORMW 
	ENDIF
	重複防止 = DAY
ENDIF
PRINTFORMDL - %CALLNAME:30%의 일기 -----------------------------------------------------------------------------------------------------
PRINTL
;CSTRに保存した日付を体裁整えて表示
日付 = TOINT(K30_DIARY_DATA(PAGENUM, 0))
IF 日付 != 0
	SPLIT PRINT_DATE_F(日付), " ", LOCALS
	PRINTFORML %GET_DAY_TR(日付)%, %LOCALS:2%의 %LOCALS:4%, %K30_DIARY_DATA(PAGENUM, 1)%
	;不具合出たときの保険。記号バージョンも併記
ELSE
	LOCAL:1 = PAGENUM % 4
	LOCAL:2 = PAGENUM % 9
	LOCAL:3 = PAGENUM % 7
	PRINTFORML %UNICODE(945 + LOCAL:3)%, %UNICODE(9824 + LOCAL:2)%의 %UNICODE(9829 + LOCAL:1)%, %K30_DIARY_DATA(PAGENUM, 1)%
ENDIF
PRINTFORML 
SELECTCASE PAGENUM
	;ファーストキス＠オプション次第でTINKOにキスでも発生。ぼかした書き方にしておく
	CASE 1
		;恋慕と場所で簡単な分岐
		LOCAL = (K30_DIARY_DATA(PAGENUM, 2) == "恋")
		PRINTFORML 내 심장은 여전히 두근거려 내가 생각하는 것에 대해 \@ K30_DIARY_DATA(PAGENUM, 5) == "捧" ? 나는 그랬다 # 나에게 일어났다 \@.
		IF GROUPMATCH(K30_DIARY_DATA(PAGENUM, 4), "the Ministry of Right and Wrong", "my room", "映姫の部屋")
			PRINTFORML 눈을 감고 진정하려고 하면 그 느낌의 기억이 빙글빙글 되살아난다.
			PRINTFORML 하지만 대신 눈을 뜨면 마치 다시 경험하는 것처럼 그 순간과 주변 환경을 생생하게 기억할 수 있다.
			PRINTFORML 오늘 밤은 잠들 수 없을 것 같다.
		ELSE
			PRINTFORML 내가 조만간 %K30_DIARY_DATA(PAGENUM, 4)%로 돌아가면, 아마 이 기억들만 촉발할 것이다.
			PRINTFORML 일단은 평소 순찰 경로에서 그것을 치울 생각이다. 이런 식으로 내 가르침을 제대로 전파할 수 있을지는 의문이다.
			PRINTFORML 내 영혼이 이렇게 흔들릴 줄은 꿈에도 몰랐다.
		ENDIF
		PRINTFORML 
		PRINTFORML 이 곧 서 있는 야마는 \@ LOCAL ? 드디어 조금 더 정직해졌다 # 자신을 잃었다 \@... %K30_DIARY_DATA(PAGENUM, 3)%가 나에 대해 어떻게 생각할지 궁금하다.
		PRINTFORM 어쩌면 %HE_SHE(MASTER)%는 내가 부끄럼이 없다고 생각하는 걸지도 모르겠다... 
		IF LOCAL
			PRINTFORML 아니면 어쩌면 %HE_SHE(MASTER)%가 내 감정들을 돌려주지 않을지도 모르겠어...
		ELSE
			PRINTFORML 만약 %HE_SHE(MASTER)%가 나에게 환멸을 느꼈다면, 나는 어떻게 진행해야 할까?
		ENDIF
		PRINTFORMW 가끔 모든 일에 너무 예민해지는 내가 싫을 때가 있다.
		IF MODE == "コマンド"
			表情 = 赤面
			TFLAG:192 = -6
			台詞 = 「......」/「......」
		ENDIF
		;処女喪失
	CASE 2
		;陥落、積極具合で簡単な分岐。思慕以下はキャンセル口上前提
		LOCALS = %K30_DIARY_DATA(PAGENUM, 2)%
		SELECTCASE LOCALS
			CASE "無"
				PRINTFORML 아마 나는 육체를 얻지 말았어야 했다.
				PRINTFORMW 이 고통스러운 감정들은 내가 이것에 자격이 없었다는 증거일 것이다.
			CASE "思"
				PRINTFORML %K30_DIARY_DATA(PAGENUM, 3)%가 나의 순결을 가져갔다.
				PRINTFORML 나는 야마를 위해 금지된 선을 넘었다.
				PRINTFORML 하지만 %HE_SHE(MASTER)%의 행동에도 불구하고, 나는 %HIM_HER(MASTER,,1)%에게 원망을 품지 못한다.
				PRINTFORMW 이 감정은 너무 고통스럽다...
			CASE "恋"
				PRINTFORML 나는 마침내 %K30_DIARY_DATA(PAGENUM, 3)%과 관계를 성립시켰다.
				PRINTFORML 지금 생각해보니, 나는 %HIM_HER(MASTER,,1)%을(를) 오랫동안 기다리게 했다. %HE_SHE(MASTER)%이 나를 일찍 떠나지 않은 것이 다행이다.
				PRINTFORML 심지어 오늘조차, 나는 너무 자기 자신에게만 집중해서 %K30_DIARY_DATA(PAGENUM, 3)%이 그것에 대해 어떻게 생각했는지조차 모른다.
				PRINTFORML 
				PRINTFORML 오늘부터 몸과 정신 모두로 %HIM_HER(MASTER,,1)%에게 더 가까워지도록 노력할 것이다.
				PRINTFORML 나는 %K30_DIARY_DATA(PAGENUM, 3)%가 무엇을 원하는지, 그리고 %HIM_HER(MASTER,,1)%를 위해 내가 무엇을 더 잘 할 수 있는지 알고 싶다.
				PRINTFORMW 이 과정에서 나의 행복을 찾을 것이라고 느낀다.
		ENDSELECT
		IF MODE == "コマンド"
			IF LOCALS == "恋"
				TFLAG:192 = -6
				表情 = LOVE
				台詞 = 「......」/「...It is just as you've read.」
			ELSE
				表情 = 睡眠
				;custom code
				台詞 '= @"「...너에게 꼭 해주고 싶은 말이 있단다.」/"
				台詞 += @"「하지만... 내가 지금 느끼는 것을 진정으로 이해한다면...」/"
				台詞 += @"「그것으로 충분하다. 나는 너의 죄를 용서하겠다.」"
			ENDIF
		ENDIF
		;弾幕勝負映姫様勝ち
	CASE 3
		PRINTFORML 오늘 나는 %K30_DIARY_DATA(PAGENUM, 3)%에게 %K30_DIARY_DATA(PAGENUM, 4)%에서 단마쿠 시합에 도전받았다.
		IF GETBIT(CFLAG:30:1910, 0)
			PRINTFORML 나는 %HIS_HER(MASTER)%의 능력을 시험해 보려 했을 뿐인데, 곧 따라가기 버거움을 느꼈다.
			PRINTFORML 나의 능력을 날카롭게 유지하기 위해 최선을 다했지만, 이것은 야마답지 않다.
		ELSE
			PRINTFORML 비록 나는 결코 궁지에 몰린 적은 없었지만, 인정하고 싶을 만큼 아슬아슬한 순간들이 더 있었다.
			PRINTFORML 나 자신에게는 아직 갈 길이 먼 것 같다. 오늘 승리를 거둘지도 모르지만, 경계를 늦춰서는 안 된다.
		ENDIF
		PRINTFORMW 나는 더 부지런해야 한다.
		IF MODE == "コマンド"
			PRINTFORML 
			PRINTFORMDL 이어서 당신의 단막(Danmaku) 매치에 대한 철저한 분석과 성찰을 제공한다.
			PRINTFORMDW 그녀의 강점의 핵심은 바로 이러한 부지런함과 규율일 것이다...
			表情 = アニメ
			IF RAND:2 == 1
				;custom code
				台詞 '= @"「승부에서는 양측 모두 전력을 다하는 것이 당연하다.」"
				台詞 += @"그러므로 준비와 전투 전략에서 우위를 점해야 한다."
				台詞 += @"「그러기 위해서 이 정도는 당연한 일이다.」"
			ELSE
				;custom code
				台詞 '= @"「%\@ GETBIT(CFLAG:1910, 0) ? I was cornered like that in our very first match # I may have won, but it was not an easy victory \@%.」/"
				台詞 += @"그러므로 나는 안주할 생각이 없다."
				台詞 += @"%\@ CFLAG:30:弾幕勝負勝利 ? 「And regardless, there is a loss in my record against you...」/「I still have a long way to go.」#「After all, my dignity as a Yama is on the line.」/「I shall always answer your challenge with my full strength.」 \@%"
