@DIARY_AFTER_CHECK_K30
;=============================
;=============================

@DIARY_BEFORE_CHECK_K30
;PAGENUM:0は使えません
;EVENTCOMEND.ERBから現在位置に関係なく毎ターン呼び出される
;=============================
;MAXPAGEはここで記入する
MAX_DIARY_PAGE:30:0 = 100
;ここで汎用発生条件を記入する
;ファーストキス		No.1
SIF DIARY:30:1 != 0 || GETBIT(CFLAG:30:1910, 2) == 1
	GOTO THROUGH_K
IF TALENT:30:キス未経験
ELSE
	CALL K30_WRITE_DIARY(1)
ENDIF
;処女喪失			No.2
$THROUGH_K
