;縦割れアナル		No.35	うふふ時Ａ性交経験100回以上でフラグ
SIF DIARY:30:35 ==0 && GETBIT(CFLAG:30:1910, 7)
	CALL K30_WRITE_DIARY(35)
;小町と同時			No.36	一日の終了時
;尻穴狂い			No.37	一日の終了時
;バイブデート		No.38	追加シチュ
;セフレ				No.39	一日の終了時
