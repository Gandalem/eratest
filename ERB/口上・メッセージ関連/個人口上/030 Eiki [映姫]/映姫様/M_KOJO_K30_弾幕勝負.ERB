; Modular ERB: 個人口上/030 Eiki [映姫]/映姫様/M_KOJO_K30_弾幕勝負.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K30_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIMS TXT
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		CALL M_KOJO_COLOR_K30
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	IF K30_CHECK_HEN_T()
		HANDICAP_FIXED = 1200
		HANDICAP_RAND = 1500
	ELSEIF TCVAR:30:364
		HANDICAP_FIXED = -99999
	ENDIF
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF K30_CHECK_HEN_T()
			PRINTFORML 「오늘은 마음속에 많은 것들이 걸려있어.」
			PRINTFORML 「그래서 좀 진지하게 할 생각이야.」
			PRINTFORMDW 에이키는 단순히 『스파링』만 하려는 것 같지는 않다...
		ELSEIF TCVAR:30:364
			CALL HPH_PRINT, @"「하우우...흐프흑」", "L"
			CALL HPH_PRINT, @"「땅 위를 그냥 날고 있는 게 내 모든 노력을 가져가 버리네...HPH」", "L"
			PRINTFORMDW 에이키는 지금 도살장으로 끌려가는 어린 양 같아!
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「네 죄의 무게를 재어 볼까?」
				CASE 1
					PRINTFORMW 「내 가르침을 제대로 따랐느냐?」
				CASE 2
					PRINTFORMW 「나는 나의 단마쿠 두오링 능력을 상당히 자신한다.」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		IF K30_CHECK_HEN_T()
			PRINTDATADL
				DATAFORM 에이키는 침묵 속에서 경기에 집중하고 있다...
				DATAFORM 에이키 뒤로 위협적인 오라가 소용돌이치는 것이 보인다...
				DATAFORM 에이키는 돌 같은 표정으로 단마쿠를 준비한다...
			ENDDATA
		ELSEIF TCVAR:30:364
			LOCALS = Hauu/Hiiiee/Yahhh/Ahnn/Afuu/Nnn/YahHPH Nooo
			TXT '= TEXTR(LOCALS)
			CALL HPH_PRINT, @"「%TXT%HPHHPH」", "L"
			PRINTDATADL
				DATAFORM 에이키가 단마쿠를 준비하려 하지만 나오는 것은 힘없는 신음뿐이다...
				DATAFORM 에이키는 가느다란 신음을 내며 단마쿠를 발사한다!\n...단도 하나만이 당신 쪽으로 날아온다.
				DATAFORM 에이키가 비명을 지르자 몸을 경직시키고 엉덩이를 잡는다...
			ENDDATA
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		IF TCVAR:30:364
			TXT '= TEXTR("No.../Hauuu/Ahyahh/Kyahn/Ahn/Stop.../Wait...")
			TXT '= \@ !相手残機 ? AuuuHPH I c-can't do this... # %TXT% \@
			CALL HPH_PRINT, @"「%TXT%HPHHPH」", "W"
		ELSE
			SELECTCASE 相手残機
				;残り残機3が表示されるのは【洽覧深識】持ちのみ
				CASE 3
					PRINTFORML 
				CASE 2
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...다음으로.」
					ELSE
						PRINTFORML 「나의 가르침을 따르는 사람은 여기까지 올 수 있어야 한다.」
						PRINTFORMW 「한 단계 더 올라가 보자.」
					ENDIF
					PRINTFORMW 「심판 『십왕의 재판』이다!」
				CASE 1
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...이제 끝낼게.」
					ELSE
						PRINTFORML 「당신은 상당히 실력이 있군요.」
						PRINTFORMW 「이제 이것을 끝장을 보자고.」
					ENDIF
					PRINTFORMW 「심판 '마지막 심판'!!」
				CASE 0
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...크흡.」
					ELSE
						PRINTFORMW 「정말 뛰어난 실력의 과시였다!」
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF K30_CHECK_HEN_T()
			PRINTFORMW 「...이것에 전력을 다할 거야.」
		ELSEIF TCVAR:30:364
			PRINTFORMW 「이것은... 결정적인 순간이다...」
			CALL HPH_PRINT, @"「아히이이헵헵헵」", "L"
			CALL HPH_PRINT, @"「내 배가... 힘을 낼 수가 없어... HPH」", "W"
		ELSE
			PRINTFORMW 「이것이 결정적인 순간인가.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF 相手残機 && TCVAR:30:364
			PRINTFORML 「자, 이제 뭘 하고 싶으세요...?」
			CALL HPH_PRINT, @"「하아... 하아, 나 지쳤어...」", "W"
		ELSE
			SELECTCASE 相手残機
				CASE 4
					PRINTFORML 
				CASE 3
					IF K30_CHECK_HEN_T()
						PRINTFORML 「이대로라면 지옥에 처형될 것이다.」
						PRINTFORMW 「회개하고 정조로운 삶에 전념하라.」
					ELSE
						PRINTFORMW 「뭐 하는 거야? 정신 차려!」
					ENDIF
				CASE 2
					IF K30_CHECK_HEN_T()
						PRINTFORML 「이대로라면 동물계로 보내질 것이다.」
						PRINTFORMW 「영원한 억압을 피하고 싶다면 자신을 되돌아보고 정조의 삶을 만들어라.」
					ELSE
						PRINTFORMW 「음~, 내 가르침 기억해?」
					ENDIF
				CASE 1
					IF K30_CHECK_HEN_T()
						PRINTFORML 「이대로라면, 당신은 지옥(Preta Realm)에 처하게 될 겁니다.」
						PRINTFORMW 「욕망으로 얼룩진 날들은 뒤로하고 정조로운 삶을 일구세요.」
					ELSE
						PRINTFORMW 「꽤 접전이었지만, 네가 쌓아온 정조와 규율이 조금 부족했던 것 같다.」
					ENDIF
				CASE 0
					;日記フラグ＠映姫様が負けた
					IF DIARY:30:4 == 0 && !TCVAR:30:364
						CALL K30_WRITE_DIARY(4)
						;過去に映姫様が勝利してたら分岐
						SIF STRCOUNT(CSTR:30:0, "勝利")
							SETBIT CFLAG:1910, 1
					ENDIF
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「일단은 네가 통과하는 걸로 치겠어.」
					ELSEIF TCVAR:30:364
						CALL HPH_PRINT, @"「하아...후프 하아...후프 하아...후프」", "L"
						PRINTFORML 「네 승리라는 걸 부정할 수는 없지만...」
						PRINTFORMW 「정말... 무슨 의미가 있는 걸까...?」
					ELSE
						PRINTFORML 「축하한다. 하지만 이것이 끝이라고 생각해서는 안 된다.」
						PRINTFORMW 「이 승리는 네가 쌓아온 정조와 규율의 결과다. 매일 그것을 연마해야 한다.」
					ENDIF
			ENDSELECT
		ENDIF
		;日記フラグ＠あなたが負けた
		IF 相手残機 > 0
			CALLF FIRSTTIME("勝利")
			IF DIARY:30:3 == 0 && !CFLAG:30:弾幕勝負勝利
				CALL K30_WRITE_DIARY(3)
				SIF 相手残機 == 1
					SETBIT CFLAG:1910, 0
			ENDIF
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
