;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESSAGE_COM_K30_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
#DIMS TXT
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		CALL M_KOJO_COLOR_K30
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	IF K30_CHECK_HEN_T()
		HANDICAP_FIXED = 1200
		HANDICAP_RAND = 1500
	ELSEIF TCVAR:30:364
		HANDICAP_FIXED = -99999
	ENDIF
	
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF K30_CHECK_HEN_T()
			PRINTFORML 「...There's a lot weighing on my mind today.」
			PRINTFORML 「So I'm going to get a little serious.」
			PRINTFORMDW Eiki doesn't seem like she intends just to 『spar』...
		ELSEIF TCVAR:30:364
			CALL HPH_PRINT, @"「Hauu...HPHHPH」", "L"
			CALL HPH_PRINT, @"「Just flying above the ground...is taking all my effort...HPH」", "L"
			PRINTFORMDW Eiki is like a lamb to the slaughter right now!
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「Shall we measure the weight of your sins?」
				CASE 1
					PRINTFORMW 「Have you been properly following my teachings?」
				CASE 2
					PRINTFORMW 「I'm quite confident in my Danmaku dueling ability.」
			ENDSELECT
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		IF K30_CHECK_HEN_T()
			PRINTDATADL
				DATAFORM Eiki is focusing on the match in silence...
				DATAFORM You can see a menacing aura swirling behind Eiki...
				DATAFORM Eiki prepares her Danmaku with a stony face...
			ENDDATA
		ELSEIF TCVAR:30:364
			LOCALS = Hauu/Hiiiee/Yahhh/Ahnn/Afuu/Nnn/YahHPH Nooo
			TXT '= TEXTR(LOCALS)
			CALL HPH_PRINT, @"「%TXT%HPHHPH」", "L"
			PRINTDATADL
				DATAFORM Though Eiki tries to prepare her Danmaku, all that comes out is a weak moan...
				DATAFORM Eiki releases her Danmaku along with a feeble moan!\n...Only a single kunai flies in your direction.
				DATAFORM As Eiki cries out, she stiffens and grabs her butt...
			ENDDATA
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		IF TCVAR:30:364
			TXT '= TEXTR("No.../Hauuu/Ahyahh/Kyahn/Ahn/Stop.../Wait...")
			TXT '= \@ !相手残機 ? AuuuHPH I c-can't do this... # %TXT% \@
			CALL HPH_PRINT, @"「%TXT%HPHHPH」", "W"
		ELSE
			SELECTCASE 相手残機
				;残り残機3が表示されるのは【洽覧深識】持ちのみ
				CASE 3
					PRINTFORML 
				CASE 2
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...Next.」
					ELSE
						PRINTFORML 「Anyone who follows my teachings should be able to come this far.」
						PRINTFORMW 「Let's take it up a notch.」
					ENDIF
					PRINTFORMW 「Judgement 『Trial of the Ten Kings』!」
				CASE 1
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...I'm ending this now.」
					ELSE
						PRINTFORML 「You're quite skilled.」
						PRINTFORMW 「Now, let's decide this once and for all.」
					ENDIF
					PRINTFORMW 「Judgement 『Last Judgement』!!」
				CASE 0
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...Kuh.」
					ELSE
						PRINTFORMW 「That was an excellent display of skill!」
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		IF K30_CHECK_HEN_T()
			PRINTFORMW 「...I'm giving this one my all.」
		ELSEIF TCVAR:30:364
			PRINTFORMW 「This is...the critical moment...」
			CALL HPH_PRINT, @"「AhiiiHPHHPH」", "L"
			CALL HPH_PRINT, @"「My belly... I can't, muster the strength...HPH」", "W"
		ELSE
			PRINTFORMW 「This is the deciding moment, is it.」
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF 相手残機 && TCVAR:30:364
			PRINTFORML 「So, what would you like to do now...?」
			CALL HPH_PRINT, @"「Haa...HPH I'm exhausted...」", "W"
		ELSE
			SELECTCASE 相手残機
				CASE 4
					PRINTFORML 
				CASE 3
					IF K30_CHECK_HEN_T()
						PRINTFORML 「...At this rate, you'll be sentenced to Hell.」
						PRINTFORMW 「Repent, and devote yourself to a life of virtue.」
					ELSE
						PRINTFORMW 「What are you doing? Pull yourself together!」
					ENDIF
				CASE 2
					IF K30_CHECK_HEN_T()
						PRINTFORML 「...At this rate, you'll be sentenced to the Animal Realm.」
						PRINTFORMW 「If you wish to avoid an eternity of oppression, reflect upon yourself and build a life of virtue.」
					ELSE
						PRINTFORMW 「Mmmー, do you remember my teachings?」
					ENDIF
				CASE 1
					IF K30_CHECK_HEN_T()
						PRINTFORML 「...At this rate, you'll be sentenced to the Preta Realm.」
						PRINTFORMW 「Leave behind your lust-stained days and build a life of virtue.」
					ELSE
						PRINTFORMW 「That was quite a close match, but it seems the virtue and discipline you've built up was a little lacking.」
					ENDIF
				CASE 0
					;日記フラグ＠映姫様が負けた
					IF DIARY:30:4 == 0 && !TCVAR:30:364
						CALL K30_WRITE_DIARY(4)
						;過去に映姫様が勝利してたら分岐
						SIF STRCOUNT(CSTR:30:0, "勝利")
							SETBIT CFLAG:1910, 1
					ENDIF
					IF K30_CHECK_HEN_T()
						PRINTFORMW 「...I suppose you pass, for now.」
					ELSEIF TCVAR:30:364
						CALL HPH_PRINT, @"「Haa...HPH Haa...HPH Haa...HPH」", "L"
						PRINTFORML 「I can't deny...that it's your victory, but...」
						PRINTFORMW 「Is there really...any meaning to this...?」
					ELSE
						PRINTFORML 「Congratulations. But you mustn't think this is the end.」
						PRINTFORMW 「This victory is the result of the virtue and discipline that you've built up. You must continue to hone that every day.」
					ENDIF
			ENDSELECT
		ENDIF
		;日記フラグ＠あなたが負けた
		IF 相手残機 > 0
			CALLF FIRSTTIME("勝利")
			IF DIARY:30:3 == 0 && !CFLAG:30:弾幕勝負勝利
				CALL K30_WRITE_DIARY(3)
				SIF 相手残機 == 1
					SETBIT CFLAG:1910, 0
			ENDIF
		ENDIF
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

