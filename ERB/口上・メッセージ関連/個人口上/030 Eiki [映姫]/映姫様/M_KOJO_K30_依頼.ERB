;依頼口上・一般依頼04：料理上手になりたい
;==================================================

@M_KOJO_IRAI_4_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「요리 연습에 도움을 좀 청해도 될까요?」
		IF TALENT:30:恋慕
			PRINTFORML 「...내가 요리해 줄 수 있는 사람에게 부탁하는 게 조금 이상하게 느껴지지만...」
			PRINTFORML 「결국 네가 내가 가장 믿을 수 있는 사람이니까.」
		ELSE
			PRINTFORML 「레시피만으로는 도저히 이해할 수 없는 것들이 있다.」
			PRINTFORML 「누군가 지켜보고 도와주는 게 가장 좋을 것 같다.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		PRINTFORML 「정말 감사합니다. 최선을 다할 테니, 적절한 지도를 부탁드립니다, 알겠죠?」
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF ABL:30:料理技能 < 2
			PRINTFORML 「음, 뭘 먼저 해야 할까...」
		ELSEIF ABL:30:料理技能 < 4
			PRINTFORML 「대충 감은 잡았는데...」
		ELSE
			PRINTFORML 「후후후, 솔직히 말하면 당신과 요리하고 싶었을 뿐이야.」
		ENDIF
		;【L ［あなた］は［彼女］と一緒に料理をした】
		;【W ［料理名］を作ります】
		;【▼そのまま下の口上へ】
		RETURN 0
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		IF ABL:30:料理技能 < 2
			PRINTFORML 「끝났다... 정말 성취감이 느껴지는군.」
		ELSEIF ABL:30:料理技能 < 4
			PRINTFORML 「잘 만들어진 것 같네.」
		ELSE
			PRINTFORML 「모든 것이 완벽하게 나온 것 같아♪」
		ENDIF
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		IF TALENT:恋慕
			PRINTFORML 「오늘 도와줘서 고마워.」
			PRINTFORML 「감사의 작은 기념품이야.」
		ELSE
			PRINTFORML 「오늘 가르쳐 주셔서 감사합니다.」
			PRINTFORML 「우리가 합의한 지불을 여기에 드립니다.」
		ENDIF
		PRINTFORML 「완성된 요리를 먹어볼까요?」
		;【報酬獲得】
		;【L できた料理は二人でいっしょに頂いた】
		;【食事効果（料理採点）】
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
