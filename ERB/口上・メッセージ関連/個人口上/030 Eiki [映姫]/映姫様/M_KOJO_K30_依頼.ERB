;依頼口上・一般依頼05：特訓につきあって
;==================================================

@M_KOJO_IRAI_5_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF K30_CHECK_HEN_T()
			PRINTFORML 「%K30_C_NAME(MASTER)%, 한 판 하시겠어요?」
			PRINTFORML 「물론 당신 스스로의 능력에 절대적인 확신이 있겠지만...」
			PRINTFORML 「저도 스트레스를 좀 풀려고 하거든요...」
		ELSE
			PRINTFORML 「단막 대결 어떠세요?」
			PRINTFORML 「그 정도의 전투능력을 얻기 위해서는 얼마나 많은 훈련이 필요한 건지...」
			PRINTFORML 「직접 여쭤보는 게 제일 좋을 것 같네요.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		IF K30_CHECK_HEN_T()
			PRINTFORMW 「...그럼 바로 시작하자.」
		ELSE
			PRINTFORMW 「정말 감사합니다. 언제든지 준비되어 있습니다.」
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼は依頼主がTARGETです
		IF K30_CHECK_HEN_T()
			PRINTFORML 「미리 사과해야 할 것 같군... 준비가 되었겠지?」
		ELSE
			PRINTFORML 「그럼 시작해 볼까?」
		ENDIF
		;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		CALL K30_D_LINE
		PRINTFORML
		IF K30_CHECK_HEN_T()
			PRINTDATADL
				DATAFORM 이키의 불가능할 정도로 잔혹한 단막(彈幕)에 맞서, 당신은 일방적인 패배를 당한다...
				DATAFORM 이키의 무자비한 공격에 맞서, 당신은 끝없는 포화로 박살 난 채 남는다...
				DATAFORM 이키 분노의 전면적인 힘에 맞서, 당신은 순식간에 패배한다...
			ENDDATA
			PRINTFORML 「…죄송합니다.」
			PRINTDATAL
				DATAFORM 「나도... 참을 수가 없었어.」
				DATAFORM 「오늘은 내가... 좀 과했던 것 같아.」
				DATAFORM 「야마(山)로서조차 경기 규칙을 지키지 못했군...」
			ENDDATA
			PRINTFORMW 에이키는 \@ TALENT:機嫌 == -1 ? 간신히 감춘 짜증 # 공허하고 생기 없는 눈으로 짧게 사과했다 \@.
			RETURN 1
		ELSEIF RAND:2 == 1
			PRINTDATADL
				DATAFORM 결국 당신은 믿을 수 없는 역전 승리를 거둔다.
				DATAFORM 결국 당신은 일련의 주고받는 교전 끝에 승리한다.
				DATAFORM 결국 당신은 에이키를 압도하고 경기를 지배한다.
			ENDDATA
			PRINTDATAW
				DATAFORM 「나 자신을 더 단련해야 할 것 같다.」
				DATAFORM 「네가 비범하게 실력이 있다는 건 알지만, 나 자신이 조금 아쉽다.」
				DATAFORM 「너의 강함에는 정말 끝이 없는 것 같다.」
			ENDDATA
		ELSE
			PRINTDATADL
				DATAFORM 결국 에이키는 믿을 수 없는 역전승을 거둔다.
				DATAFORM 결국 에이키는 일련의 주고받는 교전을 끝에 승리한다.
				DATAFORM 결국 에이키는 당신을 압도하며 경기를 지배한다.
			ENDDATA
			PRINTDATAW
				DATAFORM 「나 스스로의 명성에 부응할 수 있었던 것 같다.」
				DATAFORM 「순수한 전투능력에는 큰 차이가 없지만, 결국 매일의 규율이 결정적인 요인이었던 것 같다.」
				DATAFORM 「...미래의 대결도 같은 결과를 보장하지는 않는다」\n「나 자신도 계속 훈련해야 한다.」
			ENDDATA
		ENDIF
		PRINTFORML 「자, 그럼 처음부터 우리의 경기에 대해 이야기해 봅시다.」
		PRINTFORMDW 당신은 트레이닝 세션 후에도 에이키와 함께 철저한 경기 분석을 진행한다...
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "成功報告時"
		;報酬：\500
		;【▲上の口上から続き】
		PRINTFORML 
		IF K30_CHECK_HEN_T()
			PRINTFORML 「오늘 나를 이해해 주셔서 감사합니다.」
			PRINTFORML 「......」
			PRINTFORML 「귀찮게 해드린 것에 대한 보상으로 약간의 추가 보상을 준비했습니다.」
			PRINTFORML 
			PRINTFORMDL 에이키가 합의된 가격과 함께 초콜릿을 당신에게 건넨다.
			CALL GET_ITEM("チョコレート", 1, 1)
		ELSE
			PRINTFORML 「오늘 저와 스파링해주셔서 감사합니다.」
			PRINTFORML 「이번 기회가 제 전투 능력을 재평가하기에 좋은 기회였다고 생각합니다.」
			PRINTFORML 「앞으로도 다시 한번 도움을 주시길 바랍니다.」
		ENDIF
		;【報酬獲得】
		RETURN 1
	CASE "失敗報告時"
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
;==================================================
;依頼口上・一般依頼06：誰か教えて！
;==================================================

@M_KOJO_IRAI_6_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「밖에 대한 무언가를 알아야 할 것 같다...」
		PRINTFORML 「자네가 가장 적합한 사람이겠지라고 생각한다.」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
			;［しらべもの］と［教えてあげる］が重なっている場合
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
			;【L ここなら役に立つ資料が見つかりそうだ】
			;【INPUT（しらべもの/教えてあげる）】
			;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			;【教えてあげる＞［教えてあげる］へジャンプ】
			RETURN 0
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
			;【◆口上】
			;【［あなた］は［現在地］で調べ物をした】
			;【▼そのまま下の口上へ】
			RETURN 0
		ELSE
			;［教えてあげる］時（依頼主がTARGET）
			;【◆口上】
			;【L ［あなた］は［彼女］の疑問に答えた】
			;【成功：［彼女］の疑問は氷解した！】
			;【失敗：［彼女］は納得できなかったようだ……】
			;【▼そのまま下の口上へ】
			RETURN 0
		ENDIF
	CASE "依頼実行直後"
		;【▲上の口上から続き】
		;【◆口上】
		SELECTCASE CFLAG:CLIENT_ID:依頼状況
			CASE 2
				;［しらべもの］をした時
				IF ROLE == "CLIENT"
					;一緒に［しらべもの］をした時
					RETURN 0
				ELSEIF ROLE == "TARGET"
					;依頼主ではない口上主の前で［しらべもの］をした時
					RETURN 0
				ENDIF
			CASE 3
				;成功した時
				;【▼そのまま下の口上へ】
				PRINTDATAL
					DATAFORM 「알겠다... 그것은 나에게 상당한 참고가 될 것이다.」
					DATAFORM 「...직접 경험을 한 사람에게 묻는 것이 가장 좋겠군, 예상대로 말이야.」
					DATAFORM 「...그런 거였구나.\n내가 스스로 알기는 불가능했을 거야.」
				ENDDATA
				RETURN 1
			CASE 6
				;失敗した時
				;【▼そのまま失敗報告時の口上へ】
				PRINTDATAL
					DATAFORM 「음?」\n「그렇게 들리지 않는데...」
					DATAFORM 「...나를 도와주려 했던 건 고맙게 생각하지만.」\n「하지만 그 설명은 일관성이 없다고 생각해.」
					DATAFORM 「...어느 정도는 말이 되긴 하지만...」\n「뭔가 뭔가 좀 이상한 것 같아...?」
				ENDDATA
				RETURN 1
		ENDSELECT
	CASE "成功報告時"
		;報酬：\500
		RETURN 0
	CASE "失敗報告時"
		PRINTFORML 「시간 내주셔서 감사하지만...」
		PRINTFORMW 「그 설명은 도저히 받아들일 수가 없네요...」
		PRINTFORML 「...그래도, 우리가 합의했던 보상입니다.」
		PRINTFORML 
		PRINTFORMDL ￥500을 획득했다.
		MONEY += 500
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
