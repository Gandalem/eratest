	PRINTFORML 「There is something I need to know about the outside world...」
	PRINTFORML 「I believe you would be the most suitable person to ask.」
	RETURN 1
CASE "依頼非受託時"

	RETURN 0
CASE "依頼受託時"

	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
	IF IS_LIBRARY(CFLAG:MASTER:現在位置) && TARGET == CLIENT_ID
	;［しらべもの］と［教えてあげる］が重なっている場合
	;【◆口上】
	;【L ［あなた］は［彼女］の疑問に答えるために［現在地］を訪れた】
	;【L ここなら役に立つ資料が見つかりそうだ】
	;【INPUT（しらべもの/教えてあげる）】
	;【しらべもの＞［あなた］と［彼女］は［現在地］で調べ物をした】
	;【▼そのまま下の口上へ】
	;【教えてあげる＞［教えてあげる］へジャンプ】
		
		RETURN 0
	ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
	;［しらべもの］をした時、依頼主ではない口上主がTARGETの場合
	;【◆口上】
	;【［あなた］は［現在地］で調べ物をした】
	;【▼そのまま下の口上へ】
		
		RETURN 0
	ELSE
	;［教えてあげる］時（依頼主がTARGET）
	;【◆口上】
	;【L ［あなた］は［彼女］の疑問に答えた】
	;【成功：［彼女］の疑問は氷解した！】
	;【失敗：［彼女］は納得できなかったようだ……】
	;【▼そのまま下の口上へ】
		
		RETURN 0
	ENDIF
CASE "依頼実行直後"
	;【▲上の口上から続き】
	;【◆口上】
	SELECTCASE CFLAG:CLIENT_ID:依頼状況
	CASE 2
	;［しらべもの］をした時
		IF ROLE == "CLIENT"
		;一緒に［しらべもの］をした時
			
			RETURN 0
		ELSEIF ROLE == "TARGET"
		;依頼主ではない口上主の前で［しらべもの］をした時
			
			RETURN 0
		ENDIF
	CASE 3
	;成功した時
	;【▼そのまま下の口上へ】
		PRINTDATAL
			DATAFORM 「I see... That will be of substantial reference to me.」
			DATAFORM 「...Asking someone with first-hand knowledge is best, as I expected.」
			DATAFORM 「...So that's how it is.」\n「I probably would have never been able to learn that on my own.」
		ENDDATA
		RETURN 1
	CASE 6
	;失敗した時
	;【▼そのまま失敗報告時の口上へ】
		PRINTDATAL
			DATAFORM 「Hmmm?」\n「That doesn't sound right...」
			DATAFORM 「...I appreciate that you were willing to help me.」\n「But I don't think that explanation is consistent.」
			DATAFORM 「...That does make a certain amount of sense, but...」\n「I feel like something's not quite right...?」
		ENDDATA
		RETURN 1
	ENDSELECT
CASE "成功報告時"
;報酬：\500
	
	RETURN 0
CASE "失敗報告時"
	PRINTFORML 「I'm grateful for your time, but...」
	PRINTFORMW 「I just can't quite accept that explanation...」
	PRINTFORML 「...Still, here is the compensation we agreed upon.」
	PRINTFORML 
	PRINTFORMDL Earned ￥500
	MONEY += 500
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

