;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================

@M_KOJO_IRAI_16_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:30:思慕
			PRINTFORML 「%K30_C_NAME(MASTER)%님, 이것이 당신에게는 귀찮은 일이 될지도 모르지만...」
			PRINTFORML 「당신께 무언가 여쭤보고 싶은 것이 있습니다...」
		ELSE
			PRINTFORML 「지금 시간 좀 있으신가요?」
			PRINTFORML 「There's something I would like to confirm with you.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		IF TALENT:30:思慕
			PRINTFORML 「알겠다...」
			PRINTFORML 「아무것도 아니니까 걱정하지 마세요.」
		ELSE
			PRINTFORML 「알겠다.」
			PRINTFORML 「그럼 다른 용무를 먼저 처리하고 가라.」
		ENDIF
		RETURN 1
	CASE "依頼受託時"
		IF TALENT:30:思慕
			PRINTFORML 「음...」
			PRINTFORML 「자, 그럼 시작해 볼게.」
		ELSE
			PRINTFORML 「내 질문은 이래.」
		ENDIF
		RETURN 0
	CASE "依頼確認時"
		PRINTFORML 「특별히 자세한 사항은 없습니다.」
		PRINTFORML 「그냥 당신에게 물어보고 싶은 것이 있습니다.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「...」
		PRINTFORML 「정말 내 질문을 들으려 저항하는 거야?」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		IF TALENT:30:思慕
			;正解の選択肢
			IF TFLAG:193 == 1
				IF TFLAG:194 == 2
					PRINTFORML 「결국 그런 거구나...」
					PRINTFORML 「정말 고마워요, 덕분에 많이 알게 됐어요...」
				ELSE
					PRINTFORML 「알겠다, 그런 거였구나...」
					PRINTFORML 「고마워, 정말 유익했어.」
				ENDIF
				;ハズレの選択肢だったが逆に正解
			ELSEIF TFLAG:193 == 2
				PRINTFORML 「!!!」
				PRINTFORML 「저... 정말 그런 거야...?」
				PRINTFORML 「고마워, 덕분에 많은 걸 알게 됐어.」
				;ハズレの選択肢
			ELSEIF TFLAG:193 == -1
				PRINTFORML 「...」
				PRINTFORML 「...%TEXTR("You're not just saying something at random, are you/Do you... really believe that/")%?」
				;正解の選択肢だったが逆にハズレ
			ELSEIF TFLAG:193 == -2
				PRINTFORML 「...」
				PRINTFORML 「...기분 좀 못 읽어?」
			ENDIF
			SIF DIARY:30:27 == 0
				CALL K30_WRITE_DIARY(27)
		ELSE
			PRINTDATAL
				DATAFORM 「네, 말씀하신 대로예요.」\n「걱정할 필요가 없었던 것 같네요.」
				DATAFORM 「이해해 주셔서 기뻐요.」
				DATAFORM 「네, 말씀하신 대로예요.」\n「물어볼 필요는 없다고 생각했지만, 확인하고 싶었어요.」
			ENDDATA
		ENDIF
		RETURN 1
	CASE "成功報告時"
		;報酬：野菜か果物
		PRINTFORML 
		IF TALENT:30:思慕
			PRINTFORML 「이것은 그저 저의 감사의 작은 표시일 뿐이에요...」
			PRINTFORML 「부디 받아주세요.」
		ELSE
			PRINTFORML 「앞으로는 더욱 부지런해 주길 바란다.」
		ENDIF
		RETURN 1
	CASE "失敗報告時"
		PRINTFORML 「음, 어쨌든...」
		PRINTFORML 「Thank you for listening, at least...」
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
	CASE "口上委託率"
		;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
		RESULT:100 = 100
		;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
		;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
		;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
		;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
		VARSET RESULT, 1, 1, 23
		RETURN 1
	CASE "口上専用"
		;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
		;16,お悩み相談 の場合
		;RESULT        発生判定,0だと発生しません
		;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
		;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
		;RESULTS:0     お悩み文章（自動で『』で囲まれます）
		;RESULTS:1～3  選択肢１～３
		;何も発生しない状態になると無限ループになるので注意してください
		;●追記メモ
		;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
		;RESULT:1を7にするとどれも正解になります
		;RESULT:1を8にするとどれもハズレになります
		;1～3以外の場合は逆張り判定が自動で無くなります
		IF TALENT:30:思慕
			SELECTCASE RAND:4
				CASE 0
					RESULTS:0 = When inviting someone you're interested in on a date...』\n　　　『How should you present yourself?
					RESULTS:1 = Reveal your honest feelings
					RESULTS:2 = Act casual and nonchalant
					RESULTS:3 = Be forceful even if it exposes your ulterior motives
					RESULT:1 = 6
					RESULT:2 = 1
				CASE 1
					RESULTS:0 = Just as an example... If you were asking someone you like on a date...』\n　　　『Where would be the best place to go?
					RESULTS:1 = The lively Human Village
					RESULTS:2 = Somewhere the two of you can be alone
					RESULTS:3 = A local love hotel
					RESULT:1 = 6
					RESULT:2 = 1
				CASE 2
					RESULTS:0 = This is just a very general question, with no one specific in mind, but...』\n　　　『What kind of god would be popular with other people...?
					RESULTS:1 = A stubborn, uncompromising god
					RESULTS:2 = A cheerful, amiable god
					RESULTS:3 = A kind, gentle god that is friendly to everyone
					RESULT:1 = 4
					RESULT:2 = 0
					TFLAG:194 = 2
				CASE 3
					RESULTS:0 = Umm... This is just a silly question, but...』\n　　　『Do others care about breast size, and things like that...?
					RESULTS:1 = Moderately sized ones are also fine
					RESULTS:2 = Bigger is better, I suppose
					RESULTS:3 = Cow tits are justice
					RESULT:1 = 4
					RESULT:2 = 0
					TFLAG:194 = 2
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					RESULTS:0 = If I were to give you a prize...』\n　　　『What do you think it would be for?
					RESULTS:1 = Most Sinful
					RESULTS:2 = Most Sinful
					RESULTS:3 = Most Sinful
					RESULT:1 = 7
					RESULT:2 = 1
				CASE 1
					RESULTS:0 = If you were to come listen to my teachings...』\n　　　『How often do you think it should be?
					RESULTS:1 = Every day
					RESULTS:2 = 7 times a week
					RESULTS:3 = Once every 24 hours
					RESULT:1 = 7
					RESULT:2 = 1
				CASE 2
					RESULTS:0 = What do you believe will happen if you don't follow my teachings?
					RESULTS:1 = Going to Hell
					RESULTS:2 = Going to Hell
					RESULTS:3 = Going to Hell
					RESULT:1 = 7
					RESULT:2 = 1
				CASE 3
					RESULTS:0 = What do you think is the most appropriate thing for you to do right now?
					RESULTS:1 = Build a life of virtue
					RESULTS:2 = Pursue a life of virtue
					RESULTS:3 = Live a life of virtue
					RESULT:1 = 7
					RESULT:2 = 1
			ENDSELECT
		ENDIF
ENDSELECT
;==================================================
;依頼口上・一般依頼18：おなかすいた
;==================================================

@M_KOJO_IRAI_18_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIMS TEMPS
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		IF TALENT:30:恋慕
			PRINTFORML 「갑작스러운 부탁이라 죄송하지만...」
			PRINTFORML 「당신의 요리에 대한 강렬한 갈망에 사로잡혔어요...」
			PRINTFORML 「실례가 안 된다면...?」
		ELSE
			PRINTFORML 「%K30_C_NAME(MASTER)%, 시간 좀 있으세요?」
			PRINTFORML 「다른 사람들과 나누고 싶었던 요리가 있었는데, 일정을 비울 수가 없었어요.」
			PRINTFORML 「대신 그것을 준비해 주실 수 있나요?」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		LOCAL = 0
		TEMPS =
		VARSET LOCALS
		IF TALENT:30:恋慕
			PRINTFORML 「감사합니다, %K30_C_NAME(MASTER)%씨.」
			PRINTFORML 「해볼 생각에 설레네요.」
			RETURN 1
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		IF !LOCAL
			IF TALENT:30:恋慕
				PRINTFORML 「네, 제가 찾고 있는 것의 상세 내용입니다.」
				PRINTFORML 「당신에게 기대하고 있어요.」
			ELSE
				PRINTFORML 「당신이 준비해주었으면 하는 요리는 다음과 같다.」
			ENDIF
			LOCAL ++
			RETURN 1
		ENDIF
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;依頼確認しないとリクエストは決まらない仕様
		;シュレディンガーの料理
		IF REQUEST_DISHNAME:30:0 != ""
			TEMPS '= REQUEST_DISHNAME:30:0
			SPLIT TEMPS, "／", LOCALS
		ELSE
			LOCALS:0 = "無"
		ENDIF
		LOCALS:1 '= DISH_NAME
		RETURN 0
	CASE "依頼実行直後"
		SELECTCASE SOURCE:30:歓楽
			;大成功
			CASE 1000
				IF LOCALS:0 == "無"
					PRINTFORML 「Eh...?!」
					PRINTFORML 「이게 내가 생각했던 바로 그거라는 걸 어떻게 알았지...?」
					PRINTFORML 「...Eh??」
				ELSEIF TALENT:30:恋慕
					IF LOCALS:0 == LOCALS:1
						PRINTFORML 「완벽해. 나는 당신에게 그 이하의 것을 기대하지 않아, %K30_C_NAME(MASTER)%에게.」
						PRINTFORML 「후후...」
						PRINTFORML 「네가 나를 위해 준비한 이 %LOCALS:1%를, 마음껏 즐길게...♥」
					ELSE
						PRINTFORML 「네 행동으로 항상 내 기대에 배신감을 주지만...」
						PRINTFORML 「이런 흥미진진한 순간들까지도 마찬가지야.」
						PRINTFORML 「%LOCALS:1%에게 고마워.」
					ENDIF
				ELSE
					PRINTFORML 「이것은 정말 멋지게 준비된 %LOCALS:1%로군.」
					IF LOCALS:0 == LOCALS:1
						PRINTFORML 「이건 내 기대를 뛰어넘네요.」
					ELSE
						PRINTFORML 「%LOCALS:0%가 아니더라도, 모두 즐겨줄 거라고 확신해.」
					ENDIF
					PRINTFORML 「%K30_C_NAME(MASTER)%님, 감사합니다.」
				ENDIF
				;成功
			CASE 300
				IF LOCALS:0 == "無"
					PRINTFORML 「이 %LOCALS:1%는 먹음직해 보이는데, 하지만...」
					PRINTFORML 「무엇 때문에 이걸 준비했다고 생각했지?」
					PRINTFORML 「아, 물론 내 기대에 부응해서 기쁘지만, 도저히 이해할 수가 없네...」
				ELSEIF TALENT:30:恋慕
					IF LOCALS:0 == LOCALS:1
						PRINTFORML 「당신에게 기댈 수 있다는 걸 알고 있었어요, %K30_C_NAME(MASTER)%.」
						PRINTFORML 「정말 고마워요.」
					ELSE
						PRINTFORML 「...%LOCALS:1%?」
						PRINTFORML 「비록 그렇지만... 이것도 만족스러운 결과이기도 하다.」
						PRINTFORML 「%K30_C_NAME(MASTER)%님, 정말 감사합니다.」
					ENDIF
				ELSE
					IF LOCALS:0 == LOCALS:1
						PRINTFORML 「이것은 나에게 큰 도움이 되었다.」
					ELSE
						PRINTFORML 「%LOCALS:0%가 너무 큰 골칫거리였나?」
						PRINTFORML 「비록 이 %LOCALS:1%는 받아들일 만한 대체품이지만.」
					ENDIF
					PRINTFORML 「%K30_C_NAME(MASTER)%님, 감사합니다.」
				ENDIF
				;失敗
			CASEELSE
				IF LOCALS:0 == "無"
					PRINTFORML 「...%K30_C_NAME(MASTER)%, 나를 위해 요리해 주러 수고해줘서 기쁘다.」
					PRINTFORML 「하지만 내가 부탁한 말은 단 하나도 듣지 않은 거지??」
				ELSEIF TALENT:30:恋慕
					PRINTFORML 「이게... 음... 이게 뭐지...?」
					IF LOCALS:0 == LOCALS:1
						PRINTFORML 「음, 보아하니 %LOCALS:0%는... 조금... 오른쪽 각도에서...」
						PRINTFORML 「솔직히 모르겠어... 어떻게 이렇게 만든 건지...」
					ELSE
						PRINTFORML 「내가 요청한 건 %LOCALS:0%였을 뿐인데... 이게... %LOCALS:1%라고?」
						PRINTFORML 「아마 내 지시가 명확하지 않았던 것 같군...」
					ENDIF
				ELSE
					PRINTFORML 「...요청자로서 나도 어느 정도 책임은 받아야 한다. 하지만...」
					IF LOCALS:0 == LOCALS:1
						PRINTFORML 「이게 처음 준비하는 %LOCALS:1%인가?」
						PRINTFORML 「요리 경험이 없다면 미리 나에게 알려주길 바란다.」
					ELSE
						PRINTFORML 「나는 %LOCALS:0%에 대한 내 요청이 명확했다고 생각하는데.」
						PRINTFORML 「하지만 내가 받은 것은 %LOCALS:1%였어...」
						PRINTFORML 「막 어렴풋이 비슷한 걸 대충 만들어낸다고 해서 칭찬받을 일은 없을 거야, 알잖아.」
					ENDIF
				ENDIF
		ENDSELECT
		CALL K30_D_LINE
		PRINTFORML
		RETURN 1
	CASE "成功報告時"
		PRINTFORML 「여기에 당신의 보상이 있습니다.」
		SIF SOURCE:30:歓楽 == 1000
			PRINTFORML 「작은 보너스를 추가했다.」
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		IF TALENT:30:恋慕
			PRINTFORML 「...오늘은 그렇게 잘 풀리지 않았지만, 당신에게는 큰 기대를 걸고 있어.」
			PRINTFORML 「다음엔 더 나아지기를 기대할게.」
		ELSE
			PRINTFORML 「...어쨌든, 나를 위해 이것을 준비하는 수고를 했군요.」
			PRINTFORML 「이것을 헛되이 할 수는 없지.」
			PRINTFORML 「당신에게 적절한 보상입니다.」
			CALL GET_MONEY_YEN(500, 2)
		ENDIF
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
