;==================================================
;依頼口上・一般依頼04：料理上手になりたい
;==================================================
@M_KOJO_IRAI_4_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Might I... ask for some help with cooking practice?」
	IF TALENT:30:恋慕
		PRINTFORML 「...It feels a little strange asking the person I want to be able to cook for, but...」
		PRINTFORML 「I think you're the one I can count on most, after all.」
	ELSE
		PRINTFORML 「There are some things I can't quite understand just by reading the recipe.」
		PRINTFORML 「I think having someone watch and help will be best.」
	ENDIF
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	PRINTFORML 「Thank you very much. I'll do my best, so please provide me proper guidance, okay?」
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
	IF ABL:30:料理技能 < 2
		PRINTFORML 「Umm, what should I do first...」
	ELSEIF ABL:30:料理技能 < 4
		PRINTFORML 「I think I have the general idea, but...」
	ELSE
		PRINTFORML 「Fufufu, to be honest, I just wanted to cook with you.」
	ENDIF
;【L ［あなた］は［彼女］と一緒に料理をした】
;【W ［料理名］を作ります】
;【▼そのまま下の口上へ】
	
	RETURN 0
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
	IF ABL:30:料理技能 < 2
		PRINTFORML 「It's finished... This really does bring a sense of accomplishment.」
	ELSEIF ABL:30:料理技能 < 4
		PRINTFORML 「It looks like it came out well.」
	ELSE
		PRINTFORML 「It looks everything came out perfectly♪」
	ENDIF
;【▼そのまま下の口上へ】
	
	RETURN 1
CASE "成功報告時"
;報酬：\500
;【▲上の口上から続き】
	IF TALENT:恋慕
		PRINTFORML 「Thank you for helping me today.」
		PRINTFORML 「Here's a little token of my appreciation.」
	ELSE
		PRINTFORML 「Thank you for your instruction today.」
		PRINTFORML 「Here is the payment we agreed upon.」
	ENDIF
	PRINTFORML 「Let's eat the completed dish, shall we?」
;【報酬獲得】
;【L できた料理は二人でいっしょに頂いた】
;【食事効果（料理採点）】
	
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼05：特訓につきあって
;==================================================
@M_KOJO_IRAI_5_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	IF K30_CHECK_HEN_T()
		PRINTFORML 「%K30_C_NAME(MASTER)%, would you care for a match?」
		PRINTFORML 「Though I'm sure you have absolute confidence in your own abilities...」
		PRINTFORML 「I'm looking to vent some...stress, myself...」
	ELSE
		PRINTFORML 「Would you care for a Danmaku match?」
		PRINTFORML 「Just how much training is needed to achieve that level of combat ability...」
		PRINTFORML 「Asking you directly seems best.」
	ENDIF
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	IF K30_CHECK_HEN_T()
		PRINTFORMW 「...Let's begin immediately, then.」
	ELSE
		PRINTFORMW 「Thank you very much. I'm ready any time.」
	ENDIF
	RETURN 1
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼は依頼主がTARGETです
	IF K30_CHECK_HEN_T()
		PRINTFORML 「I must apologize in advance... You are prepared, I assume?」
	ELSE
		PRINTFORML 「Then let us begin, shall we?」
	ENDIF
;【W ［あなた］は［彼女］と弾幕ごっこの特訓をした】
;【▼そのまま下の口上へ】
	
	RETURN 1
CASE "依頼実行直後"
;○この依頼は必ず実行後達成します
;【▲上の口上から続き】
	CALL K30_D_LINE
	PRINTFORML
	IF K30_CHECK_HEN_T()
		PRINTDATADL
			DATAFORM Faced against Eiki's impossibly vicious Danmaku, you suffer a one-sided defeat...
			DATAFORM Faced against Eiki's merciless assault, you're left battered by an endless barrage...
			DATAFORM Faced against the full force of Eiki's fury, you're defeated in an instant...
		ENDDATA
		PRINTFORML 「...My apologies.」
		PRINTDATAL
			DATAFORM 「I couldn't...hold myself back.」
			DATAFORM 「It looks like I...overdid it a little today.」
			DATAFORM 「Even as a Yama... I failed to uphold the rules of the match...」
		ENDDATA
		PRINTFORMW Eiki offers a curt apology with \@ TALENT:機嫌 == -1 ? barely-disguised irritation # hollow, lifeless eyes \@.
		RETURN 1
	ELSEIF RAND:2 == 1
		PRINTDATADL
			DATAFORM ...In the end, you manage to win an incredible comeback victory.
			DATAFORM ...In the end, you manage to win after a series of back-and-forth engagements.
			DATAFORM ...In the end, you overwhelm Eiki and dominate the match.
		ENDDATA
		PRINTDATAW
			DATAFORM 「It seems I need to train myself further.」
			DATAFORM 「Though I know you're exceptionally skilled, I'm still a little disappointed in myself.」
			DATAFORM 「The limits of your strength seem truly endless.」
		ENDDATA
	ELSE
		PRINTDATADL
			DATAFORM ...In the end, Eiki manages to win an incredible comeback victory.
			DATAFORM ...In the end, Eiki manages to win after a series of back-and-forth engagements.
			DATAFORM ...In the end, Eiki overwhelms you and dominates the match.
		ENDDATA
		PRINTDATAW
			DATAFORM 「It seems I've been able to live up to my own reputation.」
			DATAFORM 「There's not much difference in our raw combat ability, but in the end, it seems daily discipline was the deciding factor.」
			DATAFORM 「...There's no guarantee a future match would have the same outcome」\n「I need to continue training myself as well.」
		ENDDATA
	ENDIF

	PRINTFORML 「Now then, let's discuss our match from the beginning.」
	PRINTFORMDW Even after your training session, you and Eiki go over a thorough post-match analysis...
;【▼そのまま下の口上へ】
	RETURN 1
CASE "成功報告時"
;報酬：\500
;【▲上の口上から続き】
	PRINTFORML 
	IF K30_CHECK_HEN_T()
		PRINTFORML 「Thank you for humoring me today.」
		PRINTFORML 「......」
		PRINTFORML 「...I've prepared a bit of additional compensation for your trouble.」
		PRINTFORML 
		PRINTFORMDL Eiki hands you some chocolate along with the agreed-upon price.
		CALL GET_ITEM("チョコレート", 1, 1)
	ELSE
		PRINTFORML 「Thank you for sparring with me today.」
		PRINTFORML 「I believe this was a good chance for me to re-evaluate my combat abilities.」
		PRINTFORML 「I hope for your assistance again in the future.」
	ENDIF
;【報酬獲得】
	RETURN 1
CASE "失敗報告時"
	
	RETURN 0
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・一般依頼06：誰か教えて！
;==================================================
@M_KOJO_IRAI_6_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
