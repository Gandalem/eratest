;依頼口上・一般依頼08：手紙を届けて
;※この依頼はキャラによっては発生しません
;==================================================

@M_KOJO_IRAI_8_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		LOCAL = SEARCH_IRAI_EMPTY()
		PRINTFORML 「%K30_C_NAME(MASTER)%은 지금 시간 좀 있습니까?」
		PRINTFORML 「이 편지를 대신 전해주시면 감사하겠습니다.」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		PRINTFORML 「정말 감사합니다.」
		PRINTFORML 「%K30_C_NAME(IRAI_SLOT_TO_PERSON(LOCAL))%에게 전달할 편지입니다.」
		PRINTFORML 「서두를 필요는 없지만, 꼭 배달해 주시기 바랍니다.」
		RETURN 1
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		PRINTFORML 「알겠다...」
		PRINTFORML 「좋다. 그럼 편지를 나에게 돌려주게.」
		RETURN 1
	CASE "依頼実行直前"
		;○この依頼では手紙を渡される側の口上です
		;【◆口上】
		PRINTFORML 「이것은 \@ CLIENT_ID == 49 ? 보고서 # 편 \@ 이 %K30_C_NAME(CLIENT_ID)%로부터 온 것이네...」
		;【W ［あなた］は［彼女］に預かっていた手紙を渡した】
		;【▼そのまま下の口上へ】
		RETURN 1
	CASE "依頼実行直後"
		;○この依頼は必ず実行後達成します
		;【▲上の口上から続き】
		;【◆口上】
		IF CLIENT_ID == 49
			PRINTFORML 「%K30_C_NAME(MASTER)%는 나를 위해 이 심부름을 해줘서 고마워.」
			PRINTFORM 「그녀를 다시 보게 되면, 부디」 
			PRINTDATAL
				DATAFORM 그녀에게 항상 보고를 제때 해줘서 내 감사를 전해 줘.」
				DATAFORM 그곳의 모든 행정 처리를 신경 써준 것에 대해 내 감사를 전해 줘.」
				DATAFORM 내 쪽에는 문제가 없으니 계속 진행해도 된다고 알려 줘.」
			ENDDATA
			SIF DIARY:30:17 == 0
				CALL K30_WRITE_DIARY(17)
		ELSEIF !STRCOUNT(CSTR:30:0, "変Ｔ")
			PRINTFORMW 「............Eh...?」
			PRINTFORML 「...이럴 수가.........」
			PRINTFORMW 「......이것은...」
			PRINTFORMW 「.........」
			PRINTFORMW 「Hecatia님께 제가 지시를 받았다고 보고해 주세요...」
			CALLF FIRSTTIME("変Ｔ指令")
		ELSE
			PRINTFORML 「혹시... 제안된 %\@ K30_CHECK_HEN_T() ? this # that \@% uniform의 제거에 대해...」
			PRINTFORMW 「............」
			PRINTFORML 「...소용없어... 결국...」
			PRINTFORMW 「......」
			PRINTFORMW 「헤카티아님께 '%TEXTR("지시를 받았습니다/즉시 시작하겠습니다/곧 후속 조치하겠습니다")%'라고 보고해 주세요...」
		ENDIF
		SIF CLIENT_ID == 113 && DIARY:30:18 == 0
			CALL K30_WRITE_DIARY(18)
		RETURN 1
	CASE "成功報告時"
		;報酬：素材4つ
		RETURN 0
	CASE "失敗報告時"
		PRINTFORML 「%K30_C_NAME(MASTER)%, 뭔가 잊고 있는 것 같군요...?」
		PRINTFORML 「...이것은 다른 사람들에게도 영향을 미치는 문제예요.」
		PRINTFORML 「앞으로는 좀 더 주의해 주세요.」
		CALL CHANGE_CFLAG(4, 30, -10)
		PRINTFORMDL 에이키가 너에게 소름 끼치는 눈빛을 보내고 있다...
		TALENT:30:機嫌 = MIN(TALENT:30:機嫌, 0)
		RETURN 1
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
