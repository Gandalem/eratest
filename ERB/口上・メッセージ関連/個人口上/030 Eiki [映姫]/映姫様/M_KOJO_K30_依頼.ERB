;依頼口上・固有依頼101：
;固有依頼の仕様はキャラによって異なりますが依頼番号は101～で共通です
;"依頼名"部分に依頼名を入れて下さい
;==================================================

@M_KOJO_IRAI_お説教たいむ_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;サボりが一瞬でバレるくらいだし、場所だって丸わかりでいいんじゃないかと
SELECTCASE GET_MAPID(CFLAG:[[小町]]:現在位置)
	CASE 0
		LOCALS = the Hakurei Shrine region
	CASE 1
		LOCALS = the Myouren Temple region
	CASE 2
		LOCALS = the Human Village region
	CASE 3
		LOCALS = the Scarlet Devil Mansion region
	CASE 4
		LOCALS = the Eientei region
	CASE 5
		LOCALS = Kourindou
	CASE 6
		IF GET_MAPID(CFLAG:MASTER:現在位置) == 6
			LOCALS = here
		ELSE
			LOCALS = here in a remote location
		ENDIF
	CASE 7
		LOCALS = the Ibara Kasen residence
	CASE 8
		LOCALS = the Moriya Shrine region
	CASE 9
		LOCALS = the Old Capital region
	CASE 10
		LOCALS = the Moon
	CASE 10
		LOCALS = the Demon World
	CASEELSE
		LOCALS = somewhere random
ENDSELECT
SIF CFLAG:[[小町]]:現在位置 % 100 == 99 && MAIN_MAP != 6
	LOCALS = her own room
SIF CFLAG:30:現在位置 == CFLAG:[[小町]]:現在位置
	LOCALS = here
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「%K30_C_NAME(MASTER)%, 이 편지를 코마치에게 전해주시겠어요?」
		PRINTFORML 「...내용은 충분히 짐작하실 수 있을 거예요.」
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		PRINTFORML 「정말 고마워. 이제 문제는 코마치가 어디에 있을지라는 거지...」
		IF LOCALS == "here"
			PRINTFORML 「그리고 정말로, 그녀가 우리 눈앞에 있다. 내 코앞에서 빈둥거리고 있군.」
			PRINTFORML 「하지만 아무리 터무니없게 보일지라도, 이것들은 절차상 글로 남겨야 한다.」
			PRINTFORML 「그러니 번거롭게 느껴질 수도 있겠지만... 이 문제에 대한 당신의 이해와 협조를 부탁드립니다.」
			RETURN 1
		ELSE
			PRINTFORM 「%TEXTR("I'm sure it's/It's most likely/")%은 %LOCALS% 주변에 있어... 그녀는 아마 그냥 
			IF LOCALS == "her own room"
				PRINTDATAL
					DATAFORM 빈둥거리며 지내다.
					DATAFORM 게으름 피우다.
				ENDDATA
			ELSE
				PRINTDATAL
					DATAFORM 빈둥거리고 있다.」
					DATAFORM 게으름을 피하고 있다.」
					DATAFORM 돌아다니고 있다.」
					DATAFORM 낮잠을 자고 있다.」
				ENDDATA
			ENDIF
			PRINTDATAL
				DATAFORM 「몇 번이나 말해줘야 하는 걸까...」
				DATAFORM 「이번엔 무슨 변명을 지어낼지 궁금하네...」
				DATAFORM 「만약 그녀가 정신 차리지 않는다면, 고통받을 건 자기 자신이야...」
				DATAFORM 「언제쯤 어른스러워질까...」
			ENDDATA
		ENDIF
		RETURN 1
	CASE "依頼確認時"
		IF LOCALS == "here"
			PRINTFORML 「...정말로 확인할 필요가 있는 게 있나?」
			PRINTFORML 「코마치처럼 빈둥거리지 말고 이 일을 어서 해결해라.」
			PRINTFORML 「너는 타인에게 도움이 되도록 노력해야 한다.」
		ELSE
			PRINTFORML 「음? 그녀가 %LOCALS%에 있을 거라 확신했는데...」
			PRINTFORML 「하지만 코마치라면 여기저기 돌아다닐 만하겠지.」
			PRINTFORML 「미안하지만 주변 지역을 한 번 더 수색해 줄 수 있겠어?」
		ENDIF
		RETURN 1
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;These are lines from Komachi, so if she ever gets translated, make sure the style is consistent
		;書いたはいいけどここには飛ばない
		CALL SET_KOJO_COLOR([[小町]])
		IF TALENT:[[小町]]:恋人
			PRINTFORML 「...%CALLNAME:MASTER%, 당신은 귀엽고 아름다운 여자친구를 도와주고 싶을 거라고 확신해요.」
		ELSEIF TALENT:[[小町]]:恋慕
			PRINTFORML 「...우리는 아름답고 친밀한 우정이지, 그렇지 않아?」
		ELSE
			PRINTFORML 「...%CALLNAME:MASTER%, %TEXTR("there's something I'd like to ask of you/I have a very serious request for you/")%.」
		ENDIF
		PRINTDATAL
			DATAFORM 「이 편지가 존재하지 않았던 것처럼 그냥 모르는 척할 수 있을까...」
			DATAFORM 「내 대신 혼나러 가줄래...」
		ENDDATA
		RESETCOLOR
		RETURN 1
	CASE "依頼実行直後"
		;ここにも飛ばない
		CALL SET_KOJO_COLOR([[小町]])
		PRINTDATAL
			DATAFORM 「시키님을 두려워하는 건가? 알겠다, 예상했던 바야...」
			DATAFORM 「그럴 수 없다는 거야? 처음부터 당연했겠지...」
			DATAFORM 「가끔은 스스로를 되돌아봐야 하는 걸까? 이봐, 그렇게 차갑게 굴지 말아줘...」
			DATALIST
				DATAFORM 「하아... 시키님의 또 다른 설교라니...」
				DATAFORM 「...어쩌면 내 게으름 전부 당신에게 돌릴 수도 있을 텐데...」
				DATAFORM 「...안 되는 건가?」
			ENDLIST
		ENDDATA
		RESETCOLOR
		RETURN 1
	CASE "成功報告時"
		SIF DIARY:30:8 == 0
			CALL K30_WRITE_DIARY(8)
		PRINTFORML 「수고했습니다.」
		PRINTFORML 「이것을 당신에게 부탁하는 마지막일 거라고 말하고 싶지만...」
		PRINTFORML 「제가 바라는 만큼 자신 있게 말할 수는 없습니다.」
		RETURN 1
	CASE "失敗報告時"
		PRINTFORML 「...혹시 코마치를 위해 거짓말하는 건 아닌 거지?」
		PRINTFORML 「자비로운 마음을 갖는 것은 중요하지만, 이건 전부 그 아이를 위한 것이야.」
		RETURN 1
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
