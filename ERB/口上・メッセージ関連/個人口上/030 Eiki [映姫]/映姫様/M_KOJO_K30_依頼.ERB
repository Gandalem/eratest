;==================================================
;依頼口上・一般依頼16：お悩み相談
;==================================================
@M_KOJO_IRAI_16_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	IF TALENT:30:思慕
		PRINTFORML 「%K30_C_NAME(MASTER)%, this might just be a bother to you, but...」
		PRINTFORML 「There's something I would like to ask you...」
	ELSE
		PRINTFORML 「Do you have some time right now?」
		PRINTFORML 「There's something I would like to confirm with you.」
	ENDIF
	RETURN 1
CASE "依頼非受託時"
	IF TALENT:30:思慕
		PRINTFORML 「I see...」
		PRINTFORML 「Ah... It's nothing major, so please don't worry about it.」
	ELSE
		PRINTFORML 「I see.」
		PRINTFORML 「Then please go ahead and finish your other business first.」
	ENDIF
	RETURN 1
CASE "依頼受託時"
	IF TALENT:30:思慕
		PRINTFORML 「Umm...」
		PRINTFORML 「Here I go, then.」
	ELSE
		PRINTFORML 「Here is my question, then.」
	ENDIF
	RETURN 0
CASE "依頼確認時"
	PRINTFORML 「There aren't any particular details about this request.」
	PRINTFORML 「I just have something I'd like to ask you.」
	RETURN 1
CASE "依頼破棄時"
	PRINTFORML 「...」
	PRINTFORML 「Are you really that reluctant to listen to my question?」
	RETURN 1
CASE "依頼実行直前"
	
	RETURN 0
CASE "依頼実行直後"
	IF TALENT:30:思慕
		;正解の選択肢
		IF TFLAG:193 == 1
			IF TFLAG:194 == 2
				PRINTFORML 「So that's how it is, after all...」
				PRINTFORML 「Thank you very much, this was informative...」
			ELSE
				PRINTFORML 「I see, so that's how it is...」
				PRINTFORML 「Thank you, this was very informative.」
			ENDIF
		;ハズレの選択肢だったが逆に正解
		ELSEIF TFLAG:193 == 2
			PRINTFORML 「!!!」
			PRINTFORML 「I-Is that really true...?」
			PRINTFORML 「Thank you, this was quite enlightening.」
		;ハズレの選択肢
		ELSEIF TFLAG:193 == -1
			PRINTFORML 「...」
			PRINTFORML 「...%TEXTR("You're not just saying something at random, are you/Do you... really believe that/")%?」
		;正解の選択肢だったが逆にハズレ
		ELSEIF TFLAG:193 == -2
			PRINTFORML 「...」
			PRINTFORML 「...Can't you read the mood a little?」
		ENDIF
		SIF DIARY:30:27 == 0
			CALL K30_WRITE_DIARY(27)
	ELSE
		PRINTDATAL
			DATAFORM 「Yes, it's just as you say.」\n「It seems there wasn't any need for concern.」
			DATAFORM 「I'm glad you understand.」
			DATAFORM 「Yes, it's just as you say.」\n「I didn't believe there was any need to ask, but I just wanted to make sure.」
		ENDDATA
	ENDIF
	RETURN 1
CASE "成功報告時"
;報酬：野菜か果物
	PRINTFORML 
	IF TALENT:30:思慕
		PRINTFORML 「This is just a small token of my appreciation...」
		PRINTFORML 「Please accept it.」
	ELSE
		PRINTFORML 「I hope you will be more diligent in the future.」
	ENDIF
	RETURN 1
CASE "失敗報告時"
	PRINTFORML 「Well, anyway...」
	PRINTFORML 「Thank you for listening, at least...」
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
CASE "口上委託率"
;＜この依頼特有の分岐です。(RESULT:100の値)％の確率で"口上専用"が発生します＞
	RESULT:100 = 100

;＜RESULT:YYに0以外の数値を入れると、該当のお悩みを発生させなくできます（詳しくは一般依頼16_お悩み相談参照）＞
;1,2:弾幕ごっこの悩み 3,4:晩酌の悩み 5,6:本の悩み 7,8:香料の悩み
;9,10:音楽の悩み 11,12:服の悩み 13:髪型の悩み 14:参拝の悩み 15:ダイエットの悩み
;16,17:菜園の悩み 18:休日の悩み 19:人気の悩み 20:集中力の悩み 21:御三家の悩み 22:進化の悩み
	VARSET RESULT, 1, 1, 23
	RETURN 1
CASE "口上専用"
;＜この依頼特有の分岐です。(口上委託率)％の確率で発生します＞
;16,お悩み相談 の場合
;RESULT        発生判定,0だと発生しません
;RESULT:1      正解の選択肢（ただしRESULT:2が0だと、一定確率で逆にハズレる）
;RESULT:2      逆張り正解／ハズレ判定の消去,1だと逆張りが無くなります
;RESULTS:0     お悩み文章（自動で『』で囲まれます）
;RESULTS:1～3  選択肢１～３
;何も発生しない状態になると無限ループになるので注意してください
;●追記メモ
;RESULT:1を4～6にするとそれぞれ1～3がハズレ（残り2つが正解）になります
;RESULT:1を7にするとどれも正解になります
;RESULT:1を8にするとどれもハズレになります
;1～3以外の場合は逆張り判定が自動で無くなります
IF TALENT:30:思慕
	SELECTCASE RAND:4 
		CASE 0
			RESULTS:0 = When inviting someone you're interested in on a date...』\n　　　『How should you present yourself?
			RESULTS:1 = Reveal your honest feelings
			RESULTS:2 = Act casual and nonchalant
			RESULTS:3 = Be forceful even if it exposes your ulterior motives
			RESULT:1 = 6
			RESULT:2 = 1
		CASE 1
			RESULTS:0 = Just as an example... If you were asking someone you like on a date...』\n　　　『Where would be the best place to go?
			RESULTS:1 = The lively Human Village
			RESULTS:2 = Somewhere the two of you can be alone
			RESULTS:3 = A local love hotel
			RESULT:1 = 6
			RESULT:2 = 1
		CASE 2
			RESULTS:0 = This is just a very general question, with no one specific in mind, but...』\n　　　『What kind of god would be popular with other people...?
			RESULTS:1 = A stubborn, uncompromising god
			RESULTS:2 = A cheerful, amiable god
			RESULTS:3 = A kind, gentle god that is friendly to everyone
			RESULT:1 = 4
			RESULT:2 = 0
			TFLAG:194 = 2
		CASE 3
			RESULTS:0 = Umm... This is just a silly question, but...』\n　　　『Do others care about breast size, and things like that...?
			RESULTS:1 = Moderately sized ones are also fine
			RESULTS:2 = Bigger is better, I suppose
			RESULTS:3 = Cow tits are justice
			RESULT:1 = 4
			RESULT:2 = 0
			TFLAG:194 = 2
	ENDSELECT
ELSE
	SELECTCASE RAND:4 
		CASE 0
			RESULTS:0 = If I were to give you a prize...』\n　　　『What do you think it would be for?
			RESULTS:1 = Most Sinful
			RESULTS:2 = Most Sinful
			RESULTS:3 = Most Sinful
			RESULT:1 = 7
			RESULT:2 = 1
		CASE 1
			RESULTS:0 = If you were to come listen to my teachings...』\n　　　『How often do you think it should be?
			RESULTS:1 = Every day
			RESULTS:2 = 7 times a week
			RESULTS:3 = Once every 24 hours
			RESULT:1 = 7
			RESULT:2 = 1
		CASE 2
			RESULTS:0 = What do you believe will happen if you don't follow my teachings?
			RESULTS:1 = Going to Hell
			RESULTS:2 = Going to Hell
			RESULTS:3 = Going to Hell
			RESULT:1 = 7
			RESULT:2 = 1
		CASE 3
			RESULTS:0 = What do you think is the most appropriate thing for you to do right now?
			RESULTS:1 = Build a life of virtue
			RESULTS:2 = Pursue a life of virtue
			RESULTS:3 = Live a life of virtue
			RESULT:1 = 7
			RESULT:2 = 1
	ENDSELECT
ENDIF
ENDSELECT

;==================================================
;依頼口上・一般依頼18：おなかすいた
;==================================================
@M_KOJO_IRAI_18_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIMS TEMPS
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	IF TALENT:30:恋慕
		PRINTFORML 「I apologize for the sudden request, but...」
		PRINTFORML 「I was just overcome by an intense craving for your cooking...」
		PRINTFORML 「Would you mind...?」
	ELSE
		PRINTFORML 「%K30_C_NAME(MASTER)%, do you have some time?」
		PRINTFORML 「There was a dish I wanted to share with others, but I couldn't find an opening in my schedule to prepare it.」
		PRINTFORML 「Would you be able to prepare it in my stead?」
	ENDIF
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	LOCAL = 0
	TEMPS = 
	VARSET LOCALS
	IF TALENT:30:恋慕
		PRINTFORML 「Thank you, %K30_C_NAME(MASTER)%.」
		PRINTFORML 「I'm excited to try it.」
		RETURN 1
	ENDIF
	RETURN 1
CASE "依頼確認時"
	IF !LOCAL
		IF TALENT:30:恋慕
			PRINTFORML 「Yes, here are the details of what I'm looking for.」
			PRINTFORML 「I'm counting on you.」
		ELSE
			PRINTFORML 「The dish I'd like you to prepare is as follows.」
		ENDIF
		LOCAL ++
		RETURN 1
	ENDIF
	RETURN 0
CASE "依頼破棄時"
	RETURN 0
CASE "依頼実行直前"
	;依頼確認しないとリクエストは決まらない仕様
	;シュレディンガーの料理
	IF REQUEST_DISHNAME:30:0 != ""
		TEMPS '= REQUEST_DISHNAME:30:0
		SPLIT TEMPS, "／", LOCALS
	ELSE
		LOCALS:0 = "無"
	ENDIF
	LOCALS:1 '= DISH_NAME 
	RETURN 0
CASE "依頼実行直後"
	SELECTCASE SOURCE:30:歓楽
		;大成功
		CASE 1000
			IF LOCALS:0 == "無"
				PRINTFORML 「Eh...?!」
				PRINTFORML 「How did you know this is exactly what I had in mind...?」
				PRINTFORML 「...Eh??」
			ELSEIF TALENT:30:恋慕
				IF LOCALS:0 == LOCALS:1
					PRINTFORML 「Absolutely perfect. I'd expect nothing less of you, %K30_C_NAME(MASTER)%.」
					PRINTFORML 「Fufu...」
					PRINTFORML 「This %LOCALS:1% you prepared for me, I'll relish it to the fullest...♥」
				ELSE
					PRINTFORML 「Though you're always betraying my expectations with your actions...」
					PRINTFORML 「That includes exciting moments like these, too.」
					PRINTFORML 「Thank you for the %LOCALS:1%.」
				ENDIF
			ELSE
				PRINTFORML 「What a splendidly prepared %LOCALS:1% this is.」
				IF LOCALS:0 == LOCALS:1
					PRINTFORML 「This exceeds my expectations.」
				ELSE
					PRINTFORML 「Even though it's not %LOCALS:0%, I'm sure everyone will enjoy it regardless.」
				ENDIF
				PRINTFORML 「%K30_C_NAME(MASTER)%, thank you.」
			ENDIF
		;成功
		CASE 300
			IF LOCALS:0 == "無"
				PRINTFORML 「This %LOCALS:1% looks appetizing, but...」
				PRINTFORML 「What made you think to prepare this?」
				PRINTFORML 「Ah, I'm happy you met my expectations, of course, but I just can't figure it out...」
			ELSEIF TALENT:30:恋慕
				IF LOCALS:0 == LOCALS:1
					PRINTFORML 「I knew I could depend on you, %K30_C_NAME(MASTER)%.」
					PRINTFORML 「Thank you very much.」
				ELSE
					PRINTFORML 「...%LOCALS:1%?」
					PRINTFORML 「Although... This is an agreeable outcome, as well.」
					PRINTFORML 「%K30_C_NAME(MASTER)%, thank you very much.」
				ENDIF
			ELSE
				IF LOCALS:0 == LOCALS:1
					PRINTFORML 「This was of great assistance to me.」
				ELSE
					PRINTFORML 「Was preparing %LOCALS:0% too much trouble?」
					PRINTFORML 「Although this %LOCALS:1% is an acceptable substitute.」
				ENDIF
				PRINTFORML 「%K30_C_NAME(MASTER)%, thank you.」
			ENDIF
		;失敗
		CASEELSE
			IF LOCALS:0 == "無"
				PRINTFORML 「...%K30_C_NAME(MASTER)%, I'm glad you went to the trouble of cooking for me.」
				PRINTFORML 「But you didn't listen to a word of what I asked for, did you??」
			ELSEIF TALENT:30:恋慕
				PRINTFORML 「This is... Um... What is this...??」
				IF LOCALS:0 == LOCALS:1
					PRINTFORML 「Well, it looks like %LOCALS:0%... A little... From the right angle...」
					PRINTFORML 「Honestly, I'm not sure...how you even made it like this...」
				ELSE
					PRINTFORML 「I believe I requested %LOCALS:0%... And this is... %LOCALS:1%?」
					PRINTFORML 「Perhaps I wasn't clear in my instructions...」
				ENDIF
			ELSE
				PRINTFORML 「...As the requester, I must accept some responsibility as well. But...」
				IF LOCALS:0 == LOCALS:1
					PRINTFORML 「Is this the first time you've prepared %LOCALS:1%?」
					PRINTFORML 「If you're inexperienced in the culinary arts, I would appreciate it if you notify me ahead of time.」
				ELSE
					PRINTFORML 「I believe I was clear in my request for %LOCALS:0%.」
					PRINTFORML 「But what I received was %LOCALS:1%...」
					PRINTFORML 「Just throwing together something vaguely similar isn't going to earn you any praise, you know.」
				ENDIF
			ENDIF
	ENDSELECT
	CALL K30_D_LINE
	PRINTFORML
	RETURN 1
CASE "成功報告時"
	PRINTFORML 「Here is your compensation.」
	SIF SOURCE:30:歓楽 == 1000
		PRINTFORML 「I added a little bonus.」
	;報酬：
	RETURN 1
CASE "失敗報告時"
	IF TALENT:30:恋慕
		PRINTFORML 「...Today didn't turn out so well, but I have high hopes for you.」
		PRINTFORML 「I'll expect better next time.」
	ELSE
		PRINTFORML 「...In any case, you did go to the trouble of preparing this for me.」
		PRINTFORML 「I mustn't allow it to go to waste.」
		PRINTFORML 「Here is suitable compensation for you.」
		CALL GET_MONEY_YEN(500, 2)
	ENDIF
	RETURN 1
;CASE "依頼報告不要"
;＜この依頼にはありません＞
;	RETURN 0
ENDSELECT

;==================================================
;依頼口上・固有依頼101：
;固有依頼の仕様はキャラによって異なりますが依頼番号は101～で共通です
;"依頼名"部分に依頼名を入れて下さい
;==================================================
@M_KOJO_IRAI_お説教たいむ_K30(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
;サボりが一瞬でバレるくらいだし、場所だって丸わかりでいいんじゃないかと
SELECTCASE GET_MAPID(CFLAG:[[小町]]:現在位置)
	CASE 0
		LOCALS = the Hakurei Shrine region
	CASE 1
		LOCALS = the Myouren Temple region
	CASE 2
		LOCALS = the Human Village region
	CASE 3
		LOCALS = the Scarlet Devil Mansion region
	CASE 4
		LOCALS = the Eientei region
	CASE 5
		LOCALS = Kourindou
	CASE 6
		IF GET_MAPID(CFLAG:MASTER:現在位置) == 6
			LOCALS = here
		ELSE
			LOCALS = here in a remote location
		ENDIF
	CASE 7
		LOCALS = the Ibara Kasen residence
	CASE 8
		LOCALS = the Moriya Shrine region
	CASE 9
		LOCALS = the Old Capital region
	CASE 10
		LOCALS = the Moon
	CASE 10
		LOCALS = the Demon World
	CASEELSE
		LOCALS = somewhere random
ENDSELECT
SIF CFLAG:[[小町]]:現在位置 % 100 == 99 && MAIN_MAP != 6
   LOCALS = her own room
SIF CFLAG:30:現在位置 == CFLAG:[[小町]]:現在位置
	LOCALS = here
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「%K30_C_NAME(MASTER)%, could you please deliver this letter to Komachi?」
	PRINTFORML 「...I'm sure you can surmise as to the contents.」
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	PRINTFORML 「Thank you very much. Now, the question is where Komachi might be...」
	IF LOCALS == "here"
		PRINTFORML 「And indeed, here she is, before our very eyes. She's slacking off right under my nose.」
		PRINTFORML 「But as nonsensical as it may seem, these things must be put into writing, as is procedure.」
		PRINTFORML 「So while it may seem bothersome... I request your understanding and cooperation in this matter.」
	 	RETURN 1
	ELSE
		PRINTFORM 「%TEXTR("I'm sure it's/It's most likely/")% around %LOCALS%... She's probably just 
		IF LOCALS == "her own room"
			PRINTDATAL
				DATAFORM sleeping around.」
				DATAFORM lazing about.」
			ENDDATA
		ELSE
			PRINTDATAL
				DATAFORM lazing about.」
				DATAFORM slacking off there.」
				DATAFORM wandering around.」
				DATAFORM taking a nap.」
			ENDDATA
		ENDIF
		PRINTDATAL
			DATAFORM 「How many times do I need to tell her...」
			DATAFORM 「I wonder what excuse she'll fabricate this time...」
			DATAFORM 「If she doesn't shape up, she's the one that will suffer for it...」
			DATAFORM 「When will she ever grow up...」
		ENDDATA
	ENDIF
	RETURN 1
CASE "依頼確認時"
	IF LOCALS == "here"
		PRINTFORML 「...Is there really anything that requires confirmation?」
		PRINTFORML 「Please don't fool around like Komachi, and resolve this matter posthaste.」
		PRINTFORML 「You should strive to be of assistance to others.」
	ELSE
		PRINTFORML 「Hmm? I was sure she would be around %LOCALS%...」
		PRINTFORML 「But since it's Komachi, I'm sure she's apt to wander around.」
		PRINTFORML 「I'm sorry, but could you search the surrounding area once more?」
	ENDIF
	RETURN 1
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;These are lines from Komachi, so if she ever gets translated, make sure the style is consistent
	;書いたはいいけどここには飛ばない
	CALL SET_KOJO_COLOR([[小町]])
	IF TALENT:[[小町]]:恋人
		PRINTFORML 「...%CALLNAME:MASTER%, I'm sure you want to help your cute, beautiful girlfriend.」
	ELSEIF TALENT:[[小町]]:恋慕
		PRINTFORML 「...We have a beautiful, intimate friendship, don't we?」
	ELSE
		PRINTFORML 「...%CALLNAME:MASTER%, %TEXTR("there's something I'd like to ask of you/I have a very serious request for you/")%.」
	ENDIF
	PRINTDATAL
		DATAFORM 「Can we just pretend this letter never existed...」
		DATAFORM 「Can you go get scolded in my place...」
	ENDDATA
	RESETCOLOR
	RETURN 1
CASE "依頼実行直後"
	;ここにも飛ばない
	CALL SET_KOJO_COLOR([[小町]])
	PRINTDATAL
		DATAFORM 「You're scared of Shiki-sama? I see, I figured as much...」
		DATAFORM 「You can't do that? I guess that was obvious from the start...」
		DATAFORM 「I should try reflecting on myself sometimes? Come on, don't be so cold...」
		DATALIST
			DATAFORM 「Haaaー... Another lecture from Shiki-sama...」
			DATAFORM 「...Maybe we could just blame all of my slacking off on you...」
			DATAFORM 「...No good, after all?」
		ENDLIST
	ENDDATA
	RESETCOLOR
	RETURN 1
CASE "成功報告時"
	SIF DIARY:30:8 == 0
		CALL K30_WRITE_DIARY(8)
	PRINTFORML 「Thank you for your hard work.」
	PRINTFORML 「I'd like to say this is the last time I need to ask this of you, but...」
	PRINTFORML 「I can't say that with as much confidence as I would like.」
	RETURN 1
CASE "失敗報告時"
	PRINTFORML 「...You're not covering for Komachi by any chance, are you?」
	PRINTFORML 「A compassionate heart is important to have, but this is all for that girl's sake.」
	RETURN 1
CASE "依頼報告不要"
	
	RETURN 0
ENDSELECT

