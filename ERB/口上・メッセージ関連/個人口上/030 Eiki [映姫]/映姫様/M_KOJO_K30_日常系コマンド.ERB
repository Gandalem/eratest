;通常会話
;映姫様は他のキャラより陥落無しでの会話が多くなりそうだからもっと増やしたい
@K30_TALK_NORMAL
#DIM TEMP
#DIM 回数
#DIM 分岐量
;-------------------------------------------------
;恋人＠パターン少ないので1/3で下へ
IF TALENT:恋人 && RAND:3 != 0
	SELECTCASE RAND:7
		CASE 0
			PRINTFORML 「What parts of me did you fall in love with?」
			PRINTFORMW 「When we first met, I didn't think your first impression of me was very good.」
			PRINTFORML 「...Honestly, I also thought you were a shady individual.」
			PRINTFORMW 「Come on, won't you tell me?」
		CASE 1
			PRINTFORML 「Just because you became lovers with a Yama doesn't mean you should let your virtues slip.」
			PRINTFORMW 「I can't play favorites, after all.」
		CASE 2
			PRINTFORML 「Fufu... I never imagined I would ever fall in love with a human.」
			PRINTFORMW 「But when I speak to you, I feel such a sense of happiness. I wonder why...」
		CASE 3
			IF !CFLAG:衣装一時変更
				PRINTFORML 「I really love this uniform. I feel a sense of calm and control whenever I put it on.」
				PRINTFORMW 「...And then...」
				PRINTFORMW 「When you take it off later...」
				PRINTFORMW 「The sense of freedom... I can't get enough...♥」
			ELSE
				PRINTFORML 「These clothes are different from my usual wear...」
				PRINTFORMW 「What do you think, do they suit me?」
				PRINTFORML 「...」
				PRINTFORMW 「Thank you, %K30_C_NAME(MASTER)%...♥」
			ENDIF
		CASE 4
			PRINTFORML 「Our lifespans may differ, but...」
			PRINTFORMW 「Because of that, we must cherish every moment we have together.」
		CASE 5
			PRINTFORML 「I feel like I'm quite different now than when I first met you.」
			PRINTFORMW 「To sympathize and be affected by others... I'm sure the old me could never have imagined it.」
			PRINTFORMW 「But now, I'm so happy I can't even put it into words. %K30_C_NAME(MASTER)%... Thank you.」
		CASE 6
			PRINTFORMW 「Along with the awareness of joy comes the fear of inevitable loss.」
			PRINTFORMW 「Even so... I'll never regret meeting you, %K30_C_NAME(MASTER)%.」
	ENDSELECT
;恋慕＠1/3で下へ恋人ならここまで
ELSEIF TALENT:恋慕 && RAND:3 != 1 || TALENT:恋人
	;恋慕初回会話、二人きりだと呼び名変更提案
	IF FIRSTTIME("呼び名",1) && K30_BE_SEEN() == 0
		PRINTFORML 「Hey, %K30_C_NAME(MASTER)%.」
		PRINTFORMW 
		PRINTFORMW 「I've come to see you as a special person. So, umm...」
		PRINTFORMW 「When we're alone together, maybe we could... address each other more casually?」
		PRINTFORML 
		;RESETCOLOR
		CALL ASK_YN("Of course", "No, that's too embarrassing")
		;CALL M_KOJO_COLOR_K30
		IF !RESULT
			CALL K30_SET_C_NAME(1)
			CALL M_KOJO_COLOR_K30
			IF RESULT == -1
				PRINTFORMW 「...Is it too embarrassing, after all?」
				PRINTFORMW 「I'm sorry, I think I've gotten a little embarrassed too...」
				PRINTFORMW 「It's best to keep the way it is...」
			ELSE
				PRINTFORMW 「Fufufu, this will be our little secret... %K30_C_NAME(MASTER)%.」
			ENDIF
		ELSE
			PRINTFORML 「I-I suppose it is...」
			PRINTFORMW 「It seems I got a little carried away...」
			PRINTFORMDW Eiki blushes furiously.
		ENDIF
		CSTR:30:0 = %CSTR:(30):0%呼び名/
		RETURN 1
	ENDIF
	SELECTCASE RAND:8
		CASE 0
			PRINTFORML 「I've learned some things since meeting you.」
			PRINTFORMW 「The subtleties between men and women... Before, when I would see them reflected in my mirror, there was a lot I couldn't understand.」
			PRINTFORML 「But lately, I feel like I've finally gained a real intuition for it... My judgements have improved as a result.」
			PRINTFORMW 「It seems there are matters that require firsthand experience, after all.」
		CASE 1
			IF ONCE("会話＠予定", 1) && K30_FIND_LOVER() < 1
				CALLF ONCE("会話＠予定")
				SELECTCASE TIME
					CASE 360 TO 549 
						IF CHARA_HOLIDAY(30)
							PRINTFORML 「%K30_C_NAME(MASTER)%, what are your plans for today?」
							PRINTFORMW 「If you're going out, I'd like to go with you if possible...」
						ELSE
							PRINTFORML 「I need to perform my duties today...」
							PRINTFORMW 「%K30_C_NAME(MASTER)%, do you have any interest in observing court proceedings?」
						ENDIF
					CASE 550 TO 719
						PRINTFORML 「%K30_C_NAME(MASTER)%, have you made plans for today?」
						PRINTFORMW 「A stitch in time saves nine, as they say. You shouldn't procrastinate on your responsibilities.」
						PRINTFORMW 「...So if you're wondering whether to ask me out on a date, you should do it quickly♥」
					CASE 720 TO 789
						IF 仕事中チェック(30) && CFLAG:30:職種 == 43
							PRINTFORML 「I must restore my energy to properly face my afternoon duties.」
							PRINTFORMW 「So I had better speak more and more with you♥」
						ELSE
							PRINTFORML 「Time passes so quickly. It's already noon.」
							IF TIME_PROGRESS(TCVAR:30:空腹時刻) > 0
								PRINTFORMW 「If you haven't had lunch yet, would you like to eat together?」
							ELSE
								PRINTFORML 「Do you have any plans later?」
								PRINTFORMW 「...Is it cleaning, after all?」
							ENDIF
						ENDIF
					CASE 790 TO 1029
						IF 仕事中チェック(30) && CFLAG:30:職種 == 43
							PRINTFORML 「It seems like the amount of work never goes down? That might be true.」
							PRINTFORML 「There's only one other person that works here at the Ministry of Right and Wrong with me...」
							IF TCVAR:30:手伝った量
								PRINTFORMW 「So I'm very grateful when you help me with my work.」
								PRINTFORMW 「Thank you, %K30_C_NAME(MASTER)%」
							ELSEIF ABL:MASTER:教養 >= 4 && TALENT:機嫌 != -1
								PRINTFORML 「Ahhhー, if only there was an intelligent and kind %PRINT_MALE("boy", MASTER)% who could help me with mywork...」
								PRINTFORMDW Eiki giggles while glancing meaningfully at you.
							ELSE
								PRINTFORMW 「...I suppose saying that won't change anything. I just need to focus on my duties.」
							ENDIF
						ELSE
							PRINTFORML 「%K30_C_NAME(MASTER)%, would you like to go somewhere with me?」
							PRINTFORMW 「The location? Anywhere is enjoyable as long as we're together.」
						ENDIF
					CASE 1030 TO 1329
						PRINTFORML 「Ahhー, it's already rather late...」
						PRINTFORMW 「%K30_C_NAME(MASTER)%, do you still have time \@ GETBIT(CFLAG:30:既成事実, 1) ? tonight? # to talk? \@」
					CASEELSE
                  PRINTFORMW 「It's already time for bed...」
				ENDSELECT
			ELSE
				PRINTFORML 「You seem to be able to freely travel between the world of the living and Higan, but...」
				PRINTFORMW 「I wonder if this is really okay...」
			ENDIF
		CASE 2
			PRINTFORMW 「How rude, saying that all I do is lecture others.」
			PRINTFORML 「...Each person has but a single chance to be judged when they die. There are no exceptions.」
			PRINTFORML 「The only way to lighten your sins is to live a virtuous life.」
			PRINTFORMW 「So in order to decrease your sins by as much as possible, I try and offer my teachings.」
			PRINTFORMW 「No matter what kind of sinner they may be, I refuse to give up on even a single soul.」
		CASE 3
			PRINTFORML 「Even the process of judging the dead and sending them to Hell is itself a sin.」
			PRINTFORMW 「Not even a Yama can escape from sin. And of course, this is all the more true for humans and youkai.」
			PRINTFORMW 「This is why we must all be in the habit of living a virtuous life.」
		CASE 4
			IF !CFLAG:衣装一時変更
				PRINTFORML 「I am quite fond of this uniform.」
				PRINTFORMW 「Wearing this uniform and wielding the authority of justice is my pride and joy.」
				PRINTFORMW 「...Although, maybe this skirt could be a little longer...」
			ELSE
				PRINTFORML 「I believe I must always take the ideal form of a Yama.」
				PRINTFORML 「Though I am not wearing my usual uniform today...」
				PRINTFORMW 「This is an opportunity to demonstrate that a Yama is not decided by her appearance but her behavior and conduct.」
				SIF STRCOUNT(CSTR:30:0, "変Ｔ")
					PRINTFORMW 「...」\n「Of course, I am aware there are days when I am unsuccessful.」\n「I still have a long road ahead of me...」
			ENDIF
		CASE 5
			PRINTFORML 「What do you usually do in your free time?」
			PRINTFORMW 「...I'm not trying to probe or judge. I just wanted to hear it from you directly.」
			PRINTFORMW 「You don't have to say anything that makes you uncomfortable. So... won't you tell me?」
		CASE 6
			PRINTFORMW 「Hey... %K30_C_NAME(MASTER)%.」
			IF K30_BE_SEEN() == 0 && CSTR:30:80 != "" && CSTR:30:80 != MASTERNAME:30
				PRINTFORMW 「...」
				PRINTFORML 「...Fufu, this way of addressing you...」
				PRINTFORMW 「It's rather exciting...♥」
			ELSE
				PRINTFORML 「Umm...」
				PRINTFORMW 「......」
				PRINTFORMW 「...It's difficult to continue speaking without dropping the conversation.」
				PRINTFORML 「When I'm spreading my teachings, it seems like I can speak indefinitely, but...」
				PRINTFORMW 「Do you really enjoy talking with me...?」
			ENDIF
		;小町口上のパ…リスペクト若しくはアンサー。地主の時は胡麻畑持ちなので好物でもおかしくない
		CASE 7
			IF ABL:料理技能 < 2
				PRINTFORML 「Komachi taught me a delicious recipe the other day.」
				PRINTFORMW 「I'd like to make it for you some time, too.」
				PRINTFORML 「The name of the dish? Umm... Perhaps "Salted Natto with Sesame Oil"...?」
				PRINTFORMW 「You make it by... Huh? You know even without hearing it??」
			ELSEIF ABL:料理技能 < 4
				PRINTFORML 「As part of my culinary learning, I've even started trying to make sweets lately.」
				PRINTFORML 「I've heard baking sweets is harder cooking normally, but...」
				PRINTFORMW 「I think cooking is harder after all.」
				PRINTFORML 「...Cooking recipes always mention "a pinch of this" or "a little of that".」
				PRINTFORMW 「I'm no good with vague instructions like that.」
			ELSE
				PRINTFORML 「After learning so much about cooking from you, I've been trying many different things.」
				PRINTFORMW 「Fried sesame trout, bean salad with sesame dressing, black-and-white sesame tofu... And also...」
				PRINTFORML 「Eh? It sounds unbalanced?」
				PRINTFORML 「What's wrong with sesame oil? I love sesame.」
				PRINTFORMW 「I think they're a wonderful ingredient, being clearly black-and-white from the start.」
			ENDIF
	ENDSELECT
	SIF GETBIT(CFLAG:1502, 2)
		RETURN 1
	;恋慕で信頼度積むと妊娠願望フラグ
	IF CFLAG:信頼度 >= 1500 && !(TALENT:妊娠 || EXP:出産経験)
		PRINTFORMW
		PRINTFORMDL Though you've finished your conversation, Eiki is looking at you strangely...
		PRINTFORMW 
		PRINTFORMW （%MASTERNAME:30%-san. The person I can't help but love.）
		SELECTCASE CFLAG:1502
			CASE 0
				PRINTFORMW （Even if our lifespans are different, I want to...）
			CASE 1, 2
				PRINTFORMW （It's not that I'm brushing you off. I also want to...）
			CASE 3
				PRINTFORMW （After all the thought you've put into it, what am I doing hesitating like this...）
		ENDSELECT
		SETBIT CFLAG:1502, 2
		PRINTFORMW （A child with %MASTERNAME:30%-san...）
		PRINTFORML 
		PRINTFORMW 「...I'm sorry, I was just thinking about something.」
	ENDIF
;思慕＠2/3で下へ恋慕付いてたらここまでで選ぶ
ELSEIF (TALENT:思慕 && RAND:3 == 0) || TALENT:恋慕
	SELECTCASE RAND:8
		CASE 0
			IF !CHARA_HOLIDAY(30, 1) && CFLAG:30:職種 != 49
				PRINTFORML 「It seems the Yama for the outside world has a highly talented and level-headed assistant.」
				PRINTFORMW 「We wouldn't be able to hire someone like that here with our scope and budget, though.」
				PRINTFORML 「...I've tried having Komachi and Kutaka help out with my work before, as an experiment.」
				PRINTFORML 「As I thought, picking the right person for the right duties is important.」
				PRINTFORMW 「That experiment made that painfully clear to me...」
			ELSE
				PRINTFORML 「Vacation? Yes, even Yamas have days off.」
				PRINTFORMW 「I'm an employee of the Ministry of Right and Wrong, after all. We work in shifts.」
				PRINTFORML 「It's a little perplexing to be told that it looks like I'm still working.」
