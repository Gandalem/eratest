@M_KOJO_MESSAGE_COM_K30_449
CALL M_KOJO_MESSAGE_COM_K30_449_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K30_449_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF !SHIRAHU(30) || TCVAR:30:364 || 仕事中チェック(30)
		RETURN 1
	SELECTCASE TFLAG:193
		;閻魔様から強奪とかいかんでしょ
		CASE -2
			CALL GET_ANGRY(30, 1)
			TCVAR:30:372 = 0
			PRINTFORMDL You quickly reach out your hand to try and snatch the %MUSHI_NAME% that Eiki caught...
			PRINTFORMW 
			PRINTFORML 「Hey!!」
			CALL K30_QUAKE
			PRINTFORMDL Ow ow ow!! Eiki struck you full-force with the Rod of Remorse...
			PRINTFORML 
			PRINTFORML 「Trying to steal from a Yama, of all things...!」
			PRINTFORMW 「What could you possibly be thinking... Have you lost your mind?!」
			PRINTFORML 「For starters...」
			PRINTFORML 「%K30_C_NAME(MASTER)%-san, kneel down there, right now... I said now!」
			PRINTFORMW 「Ethics, common sense... My goodness... I have a lot to say to you!!」
			PRINTFORMDL ...
			PRINTFORMDL Eiki gives you a scathing lecture...
			PRINTFORMDL Naturally, the %MUSHI_NAME% gets away.
			CALL RECOVER(MASTER, -200, "気力", "Harsh scolding")
			CALL RECOVER(MASTER, -200, "体力", "Merciless punishment")
			WAIT
		CASE -1
			PRINTFORML 「I'm sorry, but I cannot let you have this.」
			PRINTFORML 「If you really need one, please find one yourself.」
			IF MARK:反発刻印 || TALENT:機嫌
				PRINTFORMDW Already in a bad mood, Eiki curtly refuses...
			ELSE
				PRINTFORMDW Eiki bluntly refuses...
			ENDIF
		CASE 0
			IF MARK:反発刻印 || TALENT:機嫌 < 0 || !RAND:10
				PRINTFORMW 「We're not having any luck at all...」
				PRINTFORML 「...Perhaps the cause is your impatience and restlessness?」
				PRINTFORMW 「Wandering around aimlessly all day, and being unable to focus when you need to.」
				PRINTFORML 「You should really...!」
				PRINTFORML 「......!!」
				PRINTFORMDL ...
				PRINTFORMDW Eiki lectures you even though all you did was fail to catch a bug...
			ELSE
				PRINTDATAW
					DATAFORM 「That's unfortunate... I was unable to catch anything, either.」\n「Let's be more careful next time.」
					DATAFORM 「A-Ara? It's unexpectedly agile...」
					DATAFORM 「Ahhー... I almost caught it, too...」\n「It looks like I need to get serious.」
				ENDDATA
			ENDIF
		CASE 1
			IF RAND:2 == 1
				PRINTFORML 「It looks like you caught one, I'm glad.」
				PRINTFORML 「...However, I must caution you that even a small insect's life is an important life.」
				PRINTFORMW 「Now that you've caught it, it's your responsibility to care for it.」
				PRINTFORML 「And of course, you must not engage in pointless killing, and treat all life equally...」
				PRINTFORML 「......」
				PRINTFORMDL ...
				PRINTFORMDW Eiki starts lecturing even though all you did was catch a bug...
			ELSE
				PRINTFORML 「It looks like you were successful, I'm glad.」
				PRINTFORMW 「Now that you've caught it, please take good care of it.」
			ENDIF
		CASE 2
			IF RAND:4
				PRINTFORML 「Fufu, thank you very much.」
				PRINTFORMW 「Catching bugs is rather fun, I feel like a child again.」
			ELSE;
				PRINTFORMW 「Fufu, thank you♪」
				PRINTFORML 「...」
				PRINTFORMW 「I'm sorry, I'm getting a little too excited...」
			ENDIF
		CASE 3
			IF RAND:2 == 1
				PRINTFORML 「Umm, if you really want it that badly, I suppose I can let you have it...」
				PRINTFORMW 「But I think you should try and restrain your greed, too.」
			ELSE
				PRINTFORML 「It's rather bothersome for you to be so insistent...」
				PRINTFORML 「Well... I suppose I'm fine with giving it to you.」
				PRINTFORMW 「But I can't say I approve of you being so greedy.」
			ENDIF
		CASE 4
			IF RAND:2 == 1
				PRINTFORML 「Of course, I don't mind.」
				PRINTFORMW 「Here you go.」
			ELSE
				PRINTFORML 「Of course, that was my intention from the beginning.」
				PRINTFORML 「I'm already quite confident in the team that I have.」
				PRINTFORMW 「Please take good care of it.」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

