;==================================================
;445,採集する
;TFLAG:193(採集物のID, 0=『何も見つからなかった…』
;TFLAG:194(見つけた個数
;==================================================
@M_KOJO_MESSAGE_COM_K30_445
CALL M_KOJO_MESSAGE_COM_K30_445_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K30_445_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF !SHIRAHU(30) || 仕事中チェック(30)
		RETURN 1
	IF TCVAR:30:364
		IF !TFLAG:193
			PRINTFORMW 「You weren't... able to find any?」
			CALL HPH_PRINT, "「If I, move around, right now... It'll become, quite the scene...HPH」", "L"
			CALL HPH_PRINT, "「So I'm sorry... that I can't be of assistanceHPH」", "W"
		ELSEIF RAND:2 == 1
			PRINTFORML 「Were you, able to find something?」
			CALL HPH_PRINT, @"「%ITEMNAME_TR(TFLAG:193)%... How fortunate...HPH」", "W"
			CALL HPH_PRINT, @"「...AhhHPH But I must say, it feels... so hotHPH」", "L"
			PRINTFORMDL Even though she's just watching you, \@ DAY:2 == 2 ? Eiki's already covered in sweat # Eiki is sweating lightly \@...
		ELSE
			PRINTFORML 「Are you... still searching?」
			CALL HPH_PRINT, "「It's okay, you can... keep goingHPH」", "L"
			CALL HPH_PRINT, "「I'll just... enjoy myself...HPH」", "W"
		ENDIF
	ELSEIF !TFLAG:193
		IF TALENT:恋慕 && !RAND:3
			IF RAND:2 == 1
				PRINTFORML 「Mmmー, I can't find anything of acceptable quality...」
				PRINTFORMW 「I'm sorry I couldn't be of much assistance.」
			ELSE
				PRINTFORML 「You weren't able to find anything either?」
				PRINTFORMW 「I suppose we'll just have to keep searching, then.」
			ENDIF
		ELSE
			IF RAND:2 == 1
				PRINTFORML 「Not being able to find even a single thing really adds exhaustion to insult...」
				PRINTFORML 「Perhaps we shouldn't be so picky about the quality.」
			ELSE
				PRINTFORML 「We haven't found a single thing even after searching for so long...」
				PRINTFORMW 「Perhaps... we should search a different location?」
			ENDIF
		ENDIF
	ELSE
		LOCALS = %ITEMNAME_TR(TFLAG:193)%
		SELECTCASE ITEMPRICE:(TFLAG:193)
			;初級？素材
			CASE 1 TO 999
				;ふん
				IF TFLAG:193 == 636
					PRINTFORML 「Ah, yes... There's quite a lot around here.」
					PRINTFORMW 「I don't think anyone will mind if you take some.」
					PRINTFORMW 「...Just, please don't stand too close to me while you're carrying it.」
				;5個以上採れた
				ELSEIF TFLAG:194 > 4
					PRINTFORML 「There seems to be a large quantity of %LOCALS% around here.」
					PRINTFORMW 「Let's take as many as we need.」
				ELSEIF RAND:2 == 1
					PRINTFORML 「Ah, there's some %LOCALS% here.」
					PRINTFORMW 「%K30_C_NAME(MASTER)%, here you go.」
				ELSE
					PRINTFORML 「%LOCALS%... Gathering this should be quick if we work together.」
					PRINTFORMW 「Do you have enough now?」
				ENDIF
			;中級素材
			CASE 1000 TO 2999
				IF RAND:2 == 1
					PRINTFORML 「If I remember correctly... It should be around here...」
					PRINTFORMW 「Ah, here it is. %LOCALS%. I've found some over here.」
				ELSE
					PRINTFORML 「If you search at random, this can be quite difficult to find.」
					PRINTFORML 「But if you know where to look...」
					PRINTFORMW 「Look, %LOCALS%. Right where I predicted.」
				ENDIF
			;高級素材
			CASE 3000 TO 9999
				IF RAND:2 == 1
					PRINTFORML 「%LOCALS% is quite valuable, but you found it rather quickly...」
					PRINTFORMW 「Your skills really are admirable.」
				ELSE
					PRINTFORML 「Do you have some kind of trick to finding %LOCALS%?」
					PRINTFORMW 「I can't imagine I would have found any on my own.」
					
				ENDIF
			;最高級素材
			CASE IS >= 10000
				IF RAND:2 == 1
					PRINTFORML 「Mmmー... No such luck...」
					PRINTFORMW 「%K30_C_NAME(MASTER)%, did you find... Eh?!」
					PRINTFORML 「That's... %LOCALS%?!」
					PRINTFORMW 「You actually found some... Unbelievable...」
				ELSE
					PRINTFORML 「Ehhh?! That's... %LOCALS%?! Is that authentic?!」
					PRINTFORML 「...How should I say this... I'm glad we found some, but...」
					PRINTFORMW 「Is it really okay to just take something so valuable...?」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

