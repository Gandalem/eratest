		CASE 9, 23, 24, 28, 30, 31
			IF TFLAG:194 > 1000
				PRINTFORMW 「이렇게 큰 걸 잡을 수 있었다니 놀랍다.」
			ELSE
				IF RAND:2 == 1
					PRINTFORMW 「인상적이군. %FISH_NAME_TR(TFLAG:193)%를 잡는 건 흔한 일이 아니야.」
				ELSE
					PRINTFORMW 「꽤 큰 조과군. 당신은 낚시에 꽤 능하네요.」
				ENDIF
			ENDIF
			;守矢の守札
		CASE 131
			IF TFLAG:194 > 1000
				PRINTFORMW 「음? 이게 뭐지?」
				PRINTFORMW 「...누군가 이걸 그냥 버린 것 같아.」
			ELSE
				IF RAND:2 == 1
					PRINTFORML 「이것은 쓸모가 있으니 보관하는 것을 추천한다.」
					PRINTFORMW 「원하지 않는다고 해서 또 다른 곳에 쓰레기를 버리지 마라.」
				ELSE
					PRINTFORMW 「아, 갈고리에 무언가 걸렸나 보군... 대체 뭐지?」
					PRINTFORMW 「...누군가가 이걸 버린 것 같군.」
				ENDIF
			ENDIF
			RETURN 1
			;ローター
		CASE 21
			IF TFLAG:194 > 1000
				PRINTFORMW 「...Eh?」
				PRINTFORMW 「...이걸 네가 처리하게 해 주지...」
			ELSE
				PRINTFORMW 「아, 걸린 게 있나―?!」
				PRINTFORMW 「...혹시라도 이걸 사용하려는 생각은 하지 않는 것이 좋을 거다!!」
			ENDIF
			RETURN 1
			;お宝
		CASE 606, 609, 643
			IF TFLAG:194 > 1000
				PRINTFORMW 「이것은... %ITEMNAME_TR(TFLAG:193)%인가? 왜 그렇게 귀중한 것이 있는 거지...?」
			ELSE
				IF RAND:2 == 1
					PRINTFORML 「그렇게 귀한 것을 발견하다니, 당신은 참 운이 좋군요.」
					PRINTFORMW 「성공이라고 부를 만하다고 생각합니다.」
				ELSE
					PRINTFORMW 「얼마나 운이 좋은가. 자네가 행한 덕스러운 업보에 대한 보상일 거라 확신해.」
				ENDIF
			ENDIF
			;木材
		CASE 610
			IF TFLAG:194 > 1000
				PRINTFORMW 「바닥에 뭔가 걸리지 않은 게 다 천만다...」
			ELSE
				IF RAND:2 == 1
					PRINTFORMW 「...음, 이것도 분명 쓸모가 있을 거라고 확신해. 낙담하지 마.」
				ELSE
					PRINTFORMW 「가끔 이런 일이 생긴다. 적어도 줄이 끊어지진 않았으니까.」
				ENDIF
			ENDIF
			RETURN 1
			;カエル
		CASE 706
			IF TFLAG:194 > 1000
				PRINTFORMW 「에헤... 물고기는 아니고 개구리네...」
				PRINTFORMW 「이건 너에게 맡길게...」
			ELSE
				IF RAND:2 == 1
					PRINTFORMW 「적어도 무언가는 잡았지만... 이걸로 뭘 할 거니?」
					PRINTFORMW 「...먹을 생각은 아니겠지?」
				ELSE
					PRINTFORMW 「개구리라... 이거 쓸모가 있을지도 모르겠는데, 그렇지 않나?」
					PRINTFORMW 「아, 일단 확보해 두자...」
				ENDIF
			ENDIF
			;未対応の何か
		CASEELSE
			IF TFLAG:194 > 1000
				PRINTFORMW 「이런 것이 어떻게 여기에 있을 수 있지...」
				PRINTFORMW 「...어떤 사건과 관련이 있는 걸까?」
			ELSE
				IF RAND:2 == 1
					PRINTFORMW 「음, 당신 같은 사람이 뭘 낚아 올릴지 놀랄 일은 아니겠지만...」
					PRINTFORMW 「...아니, 다시 생각해보니 이건 정말 이상하군. %ITEMNAME_TR(TFLAG:193)%? 여기서?」
				ELSE
					PRINTFORML 「이상한 일들이 당신을 어디서든 따라다닌다는 걸 알고 있어.」
					PRINTFORMW 「하지만 그게 당신의 낚시에도 적용될 줄은... 정말 할 말이 없네.」
					PRINTFORMW 「...어떻게 %ITEMNAME_TR(TFLAG:193)% 같은 것을 잡을 수 있었지?」
				ENDIF
			ENDIF
			RETURN 1
	ENDSELECT
	SIF IS_WISEMAN()
