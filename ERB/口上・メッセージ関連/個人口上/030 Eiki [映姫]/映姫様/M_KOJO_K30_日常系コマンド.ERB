;446,調合する
;TFLAG:193(調合物のID)
;TFLAG:194(今回調合した個数)
;マイ口上参考にしました
;==================================================
@M_KOJO_MESSAGE_COM_K30_446
CALL M_KOJO_MESSAGE_COM_K30_446_1
RETURN RESULT
@M_KOJO_MESSAGE_COM_K30_446_1
#DIM CID
#DIMS TYPENAME
IF !SHIRAHU(TARGET) || CFLAG:行動 == 5 || CFLAG:318 == 1
	RETURN 1
;手伝わない=塩対応
ELSEIF ABL:親密 < 5
	PRINTDATAL
		DATAFORM 「I don't really understand the details of what you're doing.」
		DATAFORM 「I don't really understand what I'm looking at.」
		DATAFORM 「Since I'm just observing from the side, I don't truly grasp what's happening.」
	ENDDATA
	PRINTFORMW 「But since it's you, I'm sure you're %TEXTR("up to no good/making something fishy/making something suspicious")%.」
	RETURN 1
ENDIF
LOCALS '= "TYPE:回復", "TYPE:園芸用品", "TYPE:調合物", "TYPE:素材", "TYPE:消耗品", "TYPE:弾幕", "TYPE:体質変化"
CID = TFLAG:193
RESULT = 0
TYPENAME = 
FOR COUNT, 0, 7
	CALL ITEMDATA(CID, LOCALS:COUNT, 0)
	IF RESULT
		TYPENAME '= LOCALS:COUNT
		BREAK
	ENDIF
NEXT
;酒
IF ALCOHOL_TASTE(CID)
	TFLAG:口上特殊補正 = 0
	SELECTCASE ALCOHOL_TASTE(CID)
		CASE IS < 10
			PRINTDATAW
				DATAFORM 「...Unfortunately, this alcohol doesn't really suit my palate.」
				DATAFORM 「Everyone has their own tastes, but... This doesn't really match mine.」
			ENDDATA
		CASE 10 TO 14
			PRINTDATAW
				DATAFORM 「%K30_C_NAME(MASTER)%, just because you make it yourself doesn't mean you should drink too much.」
				DATAFORM 「If you create a large batch, I'm sure the liquor store in the village would appreciate some.」
			ENDDATA
		CASE 15 TO 29
			PRINTDATAW
				DATAFORM 「This alcohol is quite high-quality... I'd like to partake sometime if possible.」
				DATAFORM 「I'd love to try some well-made, handcrafted alcohol sometime.」
			ENDDATA
		CASEELSE
			PRINTDATAL
				DATAFORM 「...Sacred wine is called as such because it takes on a miraculous quality after being offered to the gods.」
				DATAFORM 「...Did you know the purpose of sacred wine is to receive a divine blessing by drinking something suitable for the gods?」
				DATAFORM 「...Might that freshly made sacred wine...contain within it a divine spiritual power?」
			ENDDATA
			PRINTFORML 「If you would like to properly complete that sacred wine, I'll gladly offer my assistance.」
			PRINTFORMDW Eiki eagerly speaks with a sparkle in her eye.
	ENDSELECT
;ほかはITEMDATAから適当に
ELSE
	SELECTCASE TYPENAME
		CASE "TYPE:回復"
			PRINTDATAW
				DATAFORM 「It's not good to rely on medicine too heavily.」\n「You should rest your body when you are tired, and prepare for further good deeds.」
				DATAFORM 「There are certainly times where you must push yourself beyond normal limits.」\n「But exercising patience is equally important.」\n「So please take care of your body.」
			ENDDATA
		CASE "TYPE:園芸用品"
			PRINTDATAW
				DATAFORM 「Creating this yourself for field work... You're quite dedicated.」\n「With this much, I'm sure you'll be able to grow something wonderful.」
				DATAFORM 「...Preparing thoroughly and working hard in the fields.」\n「Normally, this would be a virtuous deed worthy of praise, but...」\n「For some reason, I cannot help but become suspicious of you.」\n「Please grow something normal.」
			ENDDATA
		CASE "TYPE:調合物"
			PRINTDATAW
				DATAFORM 「I don't know what you will do with this, but...」\n「This feels suspicious... Is that just my imagination, or a premonition?」
				DATAFORM 「It appears you've made some valuable components, but...」\n「Why is that it gives off a suspicious aura, just like you...?」
			ENDDATA
		CASE "TYPE:素材"
			PRINTDATAW
				DATAFORM 「Creating even raw ingredients from scratch... You're quite devoted.」\n「I hope you will be able to make something useful with this.」
				DATAFORM 「Your usual behavior merits nothing but disapproval, but...」\n「Diligently creating things from scratch like this...」\n「You're quite a mysterious person.」
			ENDDATA
		CASE "TYPE:消耗品"
			PRINTDATAW
				DATAFORM 「...It's not surprising someone like you would have a use for something like this.」\n「But do you really require my assistance to make it?」
				DATAFORM 「...Provided that both parties consent, I have no particular objections to the use of this.」\n「Brandishing it like that makes me uncomfortable, so please hurry and put it away.」
			ENDDATA
		CASE "TYPE:弾幕"
			PRINTDATAW
				DATAFORM 「You're only human, so naturally there are opponents you cannot defeat with your own power.」\n「There's nothing wrong with preparing devices and schemes.」\n「I wish you the best of luck in your Danmaku matches.」
				DATAFORM 「I believe that doing your utmost in all that you do is an excellent attitude.」\n「I don't know who you plan to challenge in Danmaku, but I wish you the best of luck.」
			ENDDATA
		CASE "TYPE:体質変化"
			PRINTDATAW 
				DATAFORM 「Why are you creating such questionable items in such a carefree manner...?」
				DATAFORM 「Just what is this incredibly suspicious drug...」
			ENDDATA
		CASEELSE
	ENDSELECT
ENDIF
