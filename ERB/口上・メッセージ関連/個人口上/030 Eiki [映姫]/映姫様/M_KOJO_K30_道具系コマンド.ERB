						CALL HPH_PRINT, @"「%UNICODE(0XFF5E)* RAND(8, 16)% %TEXTR("HPH/HPHHPH/")%HPH」", "L"
						STRDATA LOCALS
							DATAFORM 「아, 아아~~히프 아우흐피 아, 우우히프 아ㅎ피 아ㅎ피이프」
