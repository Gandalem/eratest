;挿入+道具コンボの判定用式中関数

@K30_INST_AND_TOY()
#FUNCTION
SIF FLAG:70 || TCVAR:30:385 || TCVAR:30:無理矢理 || TCVAR:30:泥酔
	RETURNF 0
SIF ABL:Ｃ感覚 < 5 || GETBIT(TEQUIP:30:0, 2) || !NOWEX:Ｃ絶頂
	RETURNF 0
SIF !((ABL:Ｖ感覚 > 4 && NOWEX:Ｖ絶頂 && !TEQUIP:50) || (ABL:Ａ感覚 > 4 && NOWEX:Ａ絶頂 && !TEQUIP:51))
	RETURNF 0
RETURNF 1
;特殊おもらし判定関数

@K30_PEEING
SIF GET_TARGETNUM() > 1 || ABL:Ａ感覚 < 10 || !TEQUIP:バイブ
	RETURN
SIF !NOWEX:MASTER:射精 || STRFIND(CSTR:30:1, "おもらし") > -1 || !SUMARRAY(NOWEX:30:0, 7, 10) || TEQUIP:MASTER:コンドーム
	RETURN
CALLF ONCE("おもらし")
PRINTFORML
CALL K30_D_LINE
PRINTFORMDL 그녀는 항문을 범당하면서 정신을 잃자 갑자기 말투가 바뀌며 애원하기 시작한다.
STRDATA LOCALS
	DATAFORM 「아, 아아 잠깐-잠깐만! 그만둬 제발」
	DATAFORM 「아아 그만둬! 잠시만 기다려줘」
	DATAFORM 「안 돼 안 돼! 정말로 멈춰줘」
ENDDATA
LOCALS = %LOCALS%\n「%TEXTR("Pee! I'm gonna, pee/NoHPH Pee! Stoppp ")%HPH」\n「Mercy! Forgive meeeHPHHPH」
CALL HPH_PRINT, LOCALS, "W"
PRINTFORMDL 그녀의 치정스러운 구멍이 완전히 괴로워하자, 그녀가 곧 소변을 지릴 것 같다...
RESETCOLOR
PRINTBUTTON "[절박함]　　　", 0
PRINTBUTTON "[포기하지 마라]", 1
CALL M_KOJO_COLOR_K30
DO
INPUT
CLEARLINE 1
IF !RESULT
	PRINTFORMDL 당신은 그 정도의 품위를 가진 야마를 강탈해서는 안 된다고 느낀다.
	PRINTFORMDW 대신 당신은 골반을 움직이고 사정 쪽으로 집중한다.
	RETURN 1
ELSEIF RESULT == 1
	BREAK
ENDIF
LOOP 1
TFLAG:194 = 045
TCVAR:30:374 = 1
NOWEX:放尿 = NOWEX:Ｃ絶頂
EX:放尿 ++
EXP:放尿経験 += EXP_UP(5, 30)
TCVAR:利尿剤  = 10
BASE:30:体力 = 10
PRINTFORMDL 이키가 정말 한계를 넘어선다면 어떤 모습일까?
IF SELECTCOM == 40
	PRINTFORMDL 그녀의 절박한 애원을 전혀 신경 쓰지 않고, 당신은 로터를 그녀의 작은 요도에 단단히 누른다...
ELSE
	PRINTFORMDL 에이키가 닫으려고 하는 다리를 강제로 벌리면서 손가락으로 그녀의 요도를 자극한다...
ENDIF
PRINTFORML 「!!!」
CALL HPH_PRINT, "「노홉 노! 노오오오오오호프프프」", "L"
CALL HPH_PRINT, "「흐으윽 새는 거 같아 흐으윽 나 지금 소변 봐야 해 흐으윽」", "W"
RETURN
