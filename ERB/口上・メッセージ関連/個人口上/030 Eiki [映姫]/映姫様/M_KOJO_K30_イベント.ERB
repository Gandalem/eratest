	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMDW 에이키는 서류 작업 도중 깊은 생각에 잠겨 멈춰 선다.
		PRINTFORMDW %MASTERNAME:30%.
		PRINTFORMDL 최근에 환상향에 온 그 외부인은 야마조차 속일 수 있는 무언가를 가지고 있다.
		PRINTFORMDW 거울이 그것을 드러내지 않는다면, 직접 관찰할 수밖에 없다.
		PRINTFORMDL 신중하게 관찰하고 그에 맞춰 가르칠 수밖에 없다.
		PRINTFORMDW 그리고 그녀가 그렇게 하는 동안, %HIM_HER(MASTER,,1)%와 차를 마시며 긴장을 풀 수도 있다...
		PRINTFORMW 「......」
		PRINTFORMDL 다른 사람들에게 영향을 받지 않고 공정함을 유지해야 하는 그녀는 무슨 생각을 하고 있을까...?
		PRINTFORMW 「...」
		PRINTFORMDW 한숨을 쉬며 이키는 다시 자신의 일을 시작했다.
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛欲取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;愛人取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;セフレ取得
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		RETURN 1
	ENDIF
ENDIF
RETURN 1
