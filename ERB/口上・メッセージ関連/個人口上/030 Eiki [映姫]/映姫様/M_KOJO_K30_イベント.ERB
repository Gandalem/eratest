				PRINTFORMDW You've been falsely charged by the Yama...
			CASE 1
				PRINTFORML 「What indecent wind...」
				PRINTFORMW 「It almost reminds me of a certain someone in front of me.」
			CASE 2
				PRINTFORML 「I always seem to let down my guard in front of you...」
				IF K30_BE_SEEN()
					PRINTFORMW 「%K30_C_NAME(K30_FIND_AROUND(1), 2)% is around too, how embarrassing...」
				ELSE
					PRINTFORMW 「I mustn't allow my subordinates to see me like this...」
				ENDIF
			CASE 3
				PRINTFORML 「...Do you think this skirt is too short, after all?」
				PRINTFORMW 「I wonder if I could request a uniform change...」
			CASE 4
				PRINTFORML 「...Did you, see...?」
				PRINTFORML 「Umm... I hope you enjoyed the meal...」
				PRINTFORMDW Flustered, Eiki mumbles a strange reply.
		ENDSELECT
	ELSE
		SELECTCASE RAND:4 + (GET_TARGETNUM() > 1)
			CASE 0
				PRINTFORML 「...!」
				PRINTFORMDL Eiki glares at you...
				PRINTFORMDW You decide to look away and pretend you didn't see anything.
			CASE 1
				PRINTFORML 「...How careless of me.」
				PRINTFORML 「I'll be more prudent in the future.」
				PRINTFORMDW Eiki attempts to retain a calm composure as she fixes her skirt.
			CASE 2
				PRINTFORML 「...This seems to have been a random occurrence. I'm not so small-minded as to penalize you for this.」
				PRINTFORML 「But I must ask you to forget anything you just witnessed.」
				PRINTFORMW 「Are we clear?」
			CASE 3
				PRINTFORML 「How naive of me... I was so focused on keeping an eye on you...」
				PRINTFORMW 「I neglected to watch my own surroundings...」
			CASE 4
				PRINTFORML 「Umm... %K30_C_NAME(K30_FIND_AROUND(1))%, my apologies.」
				PRINTFORML 「You've seen me in a rather unbecoming situation.」
				PRINTFORMDW ...Eiki seems to be intentionally ignoring you.
		ENDSELECT
	ENDIF
ENDIF
;発生は一日一回
TCVAR:30:352 = 1
RETURN 1

