@M_KOJO_EVENT_K30_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
VARSET LOCALS
IF LOCAL
	SIF GETBIT(CFLAG:30:1500, 2)
		SETANIMETIMER 50
	;日記フラグ：ぱんつの日、恋慕取得、妊娠願望取得、小町と同時、尻穴狂い、セフレ、スイッチ準備
	SIF DIARY:30:11 == 0 && FLAG:異常気象 == 7
		CALL K30_WRITE_DIARY(11)
	SIF DIARY:30:30 == 0 && TALENT:30:恋慕
		CALL K30_WRITE_DIARY(30)
	SIF DIARY:30:32 == 0 && GETBIT(CFLAG:1502, 3)
		CALL K30_WRITE_DIARY(32)
	IF DIARY:30:36 == 0 && GETBIT(CFLAG:1910, 8) == 0
		IF GET_UWAKI_HISTORY(30, 76) == 2
			SIF TALENT:30:恋慕
				CALL K30_WRITE_DIARY(36)
			SETBIT CFLAG:1910, 8
		ENDIF
	ENDIF
	SIF DIARY:30:37 == 0 && TALENT:尻穴狂い
		CALL K30_WRITE_DIARY(37)
	SIF DIARY:30:39 == 0 && TALENT:セフレ
		CALL K30_WRITE_DIARY(39)
	SIF DIARY:30:40 == 0 && CFLAG:1608 >= 2 && TALENT:尻穴狂い && DAY % 2 == 0
		CALL K30_WRITE_DIARY(40)
	;バイブデートフラグリセット
	CLEARBIT CFLAG:1609, 1
	;縁結びフラグ立てor折り
	IF FLAG:願掛け内容 == 30 && CFLAG:翌日来訪 == 1 && GET_MAPID(GET_CHARAHOME(30)) != MAIN_MAP
		CFLAG:1603 = 1
	ELSE
		CFLAG:1603 = 0
	ENDIF
	;うふふがまん日数記録
	IF TCVAR:30:380
		CFLAG:1603 = 0
	ELSE
		CFLAG:1603 ++
	ENDIF
	PRINTFORML 
	CALL M_KOJO_COLOR_K30
	;媚薬盛りでいじった素質戻す
	IF GETBIT(TCVAR:30:367, 1)
		TALENT:30:淫乱 = 0
		PRINTFORMDL 에이키에게 향정제의 효과가 끝난다...
		PRINTFORMDW 에이키는 [%GET_TALENTNAME_TR(4, 1)%]을/를 잃었다.
		PRINTFORML 
	ENDIF
	;関数使うと呼び名安定しないので先に固定
	LOCALS = %CSTR:30:80%
	SIF LOCALS == ""
		LOCALS = %MASTERNAME:30%-san
	;今日会っていなければおやすみ口上フラグ折っておく
	SIF TCVAR:30:今日会ったか == 0
		CFLAG:1605 = 0
	;詫びおぱんつ処理
	IF TCVAR:30:377
		IF TCVAR:30:377 < 0
			;貰うおぱんつを抽選。ノーパン/トランクスを渡さないように最低値は2
			LOCAL = MAX(今日のぱんつ(30), 2)
			PRINTFORMDL 당신은 침대 옆에서 깔끔하게 접힌 %PANTSNAME(LOCAL, 30)%을 발견한다.
			PRINTFORMDL 그런 무의미한 약속을 지킬 사람은 야마에게 맡기는 게 좋겠지...
			PRINTFORML 
		ELSE
			LOCAL = TCVAR:30:377
		ENDIF
		PRINTFORMDW 당신은 에이키의 \@ TCVAR:30:377 < 0 ? %PANTSNAME(LOCAL, 30)% # 비밀 %PANTSNAME(LOCAL, 30)%을 컬렉션에 추가한다. \@
		CFLAG:30:(パンツ管理 + LOCAL) ++
		PRINTFORML
	ENDIF
	;口上通って無くても同棲中の部屋戻ってたらおやすみ口上フラグ立てる
	SIF CFLAG:MASTER:初期位置 == CFLAG:30:初期位置 && CFLAG:MASTER:初期位置 == CFLAG:MASTER:現在位置
		CFLAG:1605 = 1
	;無自覚妊娠関連口上
	IF CFLAG:1805
		IF GROUPMATCH(CFLAG:妊娠経過日数, 40, 60) || (CFLAG:出産経過日 && CSTR:30:83 == "" )
			CALL K30_INSENSIBLE_PREGNANCY
			CFLAG:1805 ++
			RESETCOLOR
			SETANIMETIMER 32627
			RETURN 1
		ENDIF
	ENDIF
	;子供自立口上withoutあなた
	IF CFLAG:出産経過日 >= 115
		CALL K30_CHILD_INDEPENDENCE
		RESETCOLOR
		SETANIMETIMER 32627
		RETURN 1
	ENDIF
	;同棲相手が無断外泊とか普通はキツい。幻想郷の子、ドライすぎない？
	;それとは別に映姫様は重い女の方が良い
	IF CFLAG:MASTER:初期位置 == CFLAG:30:初期位置 && CFLAG:MASTER:現在位置 != CFLAG:30:初期位置
		CALL EVENTEND_TSUBUYAKI
		SELECTCASE RAND:3
			CASE 0
				LOCALS:1 = 「%LOCALS%... Don't leave me alone... %LOCALS%...」
			CASE 1
				LOCALS:1 = 「I wonder if something happened to %LOCALS%? ...No way, right...」
			CASE 2
				LOCALS:1 = 「%LOCALS%... Why aren't you coming home... Why...?」
		ENDSELECT
		;イキ顔を泣き顔と言い張る暴挙
		IF CFLAG:差し替え適用 && 顔絵付きメッセージ
			CALL K30_SPTALK, "絶頂", @"%LOCALS:1%"
		ELSE
			PRINTFORML %LOCALS:1%
		ENDIF
		PRINTFORMDW 에이키는 당신 때문에 몸이 아플 정도로 걱정한다...
		RESETCOLOR
		SETANIMETIMER 32627
		RETURN 1
	ENDIF
	;妊娠願望取得
	;custom code: if raw permission was obtained through Eiki's initiative, set CFLAG:1502 accordingly
	;this is already done in the update function, but that only fixes the problem for players that update after fulfilling this condition
	SIF CFLAG:生解禁 == 2
		SETBIT CFLAG:1502, 0
	CALL K30_DENY_POLYAMORY(3)
	IF !RESULT && !EXP:出産経験 && !TALENT:妊娠願望 && CFLAG:1502 == 7
		CALL EVENTEND_TSUBUYAKI
		PRINTFORML 
		LOCALS:1 = （I shouldn't just keep making excuses... I need to be more honest with myself.）
		LOCALS:2 = （I want to create proof... Proof that %MASTERNAME:30% and I lived together, and loved each other.）
		LOCALS:3 = （I want our love to manifest within me...）
		IF CFLAG:差し替え適用 && 顔絵付きメッセージ
			CALL K30_SPTALK, "LOVE", @"%LOCALS:1%/%LOCALS:2%/%LOCALS:3%"
			PRINTFORML 
		ELSE
			PRINTFORML 
			PRINTFORML %LOCALS:1%
			PRINTFORML %LOCALS:2%
			PRINTFORMW %LOCALS:3%
		ENDIF
		PRINTFORMDL 에이키는 진심으로 당신의 아이들을 품고 싶어 한다.
		PRINTFORMDW 에이키가 [%GET_TALENTNAME_TR(9, 1)%]을 얻었다!
		TALENT:妊娠願望 = 1
		SETBIT CFLAG:1502, 3
		RESETCOLOR
		SETANIMETIMER 32627
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;会わない日に一言
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		;陥落無しならしっかり間隔を開ける。攻略対象外が出しゃばってはいけません。ついでに顔も出しません
		IF ARG % 21 == 0 && ARG && !TALENT:30:恋慕 && !TALENT:30:思慕
			CALL EVENTEND_TSUBUYAKI
			PRINTFORMDL 에이키는 서류 작업으로 열심히 일하고 있었다...
			PRINTFORMDL 그녀가 한 지점에 도달했을 때, 갑자기 어떤 특이한 외부인을 생각하게 되었다.
			PRINTDATAW
				DATAFORM 「%K30_C_NAME(MASTER)%을/를 최근에 보지 못한 것 같다.」
				DATAFORM 「어쨌든 %K30_C_NAME(MASTER)%은 이 지역을 자주 방문하지 않으니까.」
				DATAFORM 「%K30_C_NAME(MASTER)%에게 잔소리를 하지 않은 것 같은 기분이 든다.」
			ENDDATA
			PRINTFORML 「...」
			PRINTFORML 「음, 그건 나중에 생각해 볼게.」
			PRINTFORMDW 에이키는 그것을 대수롭지 않게 여기고 자신의 일로 돌아갔다.
			;思慕は10日に１回＠映姫様ここからが固いので放置しがちだよね
		ELSEIF ARG % 10 == 0 && ARG && TALENT:30:思慕
			CALL EVENTEND_TSUBUYAKI
			STRDATA LOCALS:1
				DATAFORM 「%K30_C_NAME(MASTER)%이 올바르게 덕 있는 삶을 추구하고 있을지 궁금하다...」
				DATAFORM 「만약 %K30_C_NAME(MASTER)%이 %HIS_HER(MASTER)%의 바람기 있는 버릇만 고친다면, %HE_SHE(MASTER)%는 존경받는 사람이 될 텐데...」
				DATAFORM 「%K30_C_NAME(MASTER)%이 부끄러운 짓을 하고 있지는 않기를 바란다...」
			ENDDATA
			IF CFLAG:差し替え適用 && 顔絵付きメッセージ
				CALL K30_SPTALK, "アニメ", @"%LOCALS:1%"
			ELSE
				PRINTFORML %LOCALS:1%
			ENDIF
			PRINTFORMDL 한동안 당신을 보지 못해서, 에이키의 생각은 당신에게 머문다.
			PRINTFORMDW 어떤 이유에서인지, 그녀는 조금 안절부절못한다...
			;恋慕なら5日会わない毎に一言
		ELSEIF ARG % 5 == 0 && ARG
			IF TALENT:30:恋人
				CALL EVENTEND_TSUBUYAKI
				STRDATA LOCALS:1
					DATAFORM 「%HIS_HER(MASTER)% 연인을 이렇게 혼자 두다니... 다음에 %HIM_HER(MASTER,,1)%를 보면, 난...」
					DATAFORM 「%HE_SHE(MASTER)%가 나를 놀리는 걸까? 아니면... 어쩌면 %HE_SHE(MASTER)%는 그저 배려심 없는 것일지도...? 」
					DATAFORM 「%LOCALS%... %HE_SHE(MASTER)%가 또 다른 여자와 함께 있을 거라고 확신해...」
				ENDDATA
				IF CFLAG:差し替え適用 && 顔絵付きメッセージ
					CALL K30_SPTALK, "反発", @"%LOCALS:1%"
				ELSE
					PRINTFORML %LOCALS:1%
				ENDIF
				PRINTFORMDW 당신과 그 긴 부재를 생각하니, 에이키는 조금 질투하지 않을 수 없다...
			ELSEIF TALENT:30:恋慕
				CALL EVENTEND_TSUBUYAKI
				STRDATA LOCALS:1
					DATAFORM 「%HE_SHE(MASTER)%이 나 혼자 %HIM_HER(MASTER,,1)%를 찾아오는 것을 이상하게 생각할까 궁금하다...」
					DATAFORM 「그 사람이 쉽게 산만해진다는 걸 알고 있다, 하지만...」
					DATAFORM 「%HIM_HER(MASTER,,1)%가 오기를 기다릴까... 아니면 내가 직접 %HIM_HER(MASTER,,1)%를 방문할까... 뭘 해야 할까...」
				ENDDATA
				IF CFLAG:差し替え適用 && 顔絵付きメッセージ
					TFLAG:192 = -6
					CALL K30_SPTALK, "赤面", @"%LOCALS:1%"
				ELSE
					PRINTFORML %LOCALS:1%
				ENDIF
				PRINTFORMDW 한동안 당신을 보지 못해서, 에이키는 불안함을 느끼기 시작한다...
			ENDIF
		ENDIF
		RESETCOLOR
		SETANIMETIMER 32627
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
