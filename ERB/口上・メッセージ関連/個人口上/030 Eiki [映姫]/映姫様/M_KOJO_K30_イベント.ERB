;おはよう口上通したフラグ
TCVAR:30:373 = 1
;-------------
;ファッションブームの日記フラグ
SIF DIARY:30:7 == 0 && FLAG:ファッション == 62
	CALL K30_WRITE_DIARY(7)
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
