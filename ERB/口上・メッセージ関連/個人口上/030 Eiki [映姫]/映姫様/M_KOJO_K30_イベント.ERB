		CALLF ONCE("おはよう")
		;ファッションブームの日記フラグ
		SIF DIARY:30:7 == 0 && FLAG:ファッション == 62
			CALL K30_WRITE_DIARY(7)
		;ここで不機嫌なら「朝から虫の居所が悪い」反発刻印なければMASTERのせいじゃない
		SIF TALENT:機嫌 == -1 && MARK:反発刻印 == 0
			TCVAR:30:372 = 1
		TFLAG:192 = 10
		;変なＴシャツ
		IF K30_CHECK_HEN_T()
			IF YOUBI_MATCH(DAY, "金")
