			PRINTFORMW 「In the end... there's no way a human and a god could...」
			PRINTFORMW 「%K30_C_NAME(MASTER)%... My apologies.」
			PRINTFORMW 「For asking something so absurd.」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RESETCOLOR
RETURN 1

