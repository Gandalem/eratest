@M_KOJO_EVENT_K30_3(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;自室に帰る（定時になって寝る）＠クラピ構文参考にしてます
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1 && !CFLAG:うふふ
		IF CFLAG:現在位置 == OMANEKIBEYA()
			PRINTFORML 「벌써 이렇게 늦었네...」
			PRINTFORMW 「%K30_C_NAME(MASTER)%, 잘 자...」
			SIF !TCVAR:(CFLAG:MASTER:お招き):連泊禁止 && NEMUKE() < 720
				PRINTFORMW 「...잠깐, 아직 떠나지 말아줬으면 해...」
		ELSE
			IF TALENT:恋慕
				PRINTFORML 「벌써 이렇게 늦었네...」
				PRINTFORMW 「\@ TALENT:恋人 ? 밤이다 # 잘 자 \@, %K30_C_NAME(MASTER)%.」
			ELSE
				PRINTFORML 「%K30_C_NAME(MASTER)%는, 잘 자요.」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠そうにしている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SIF RAND:10 || !TALENT:恋慕
			RETURN 1
		PRINTDATAL
			DATAFORM 「후와아... 아후우...」
			DATAFORM 「느응~... 후와, 아아...」
			DATAFORM 「후와아~~... 졸려...」
		ENDDATA
		PRINTFORMDL 에이키가 입을 손으로 가리는 것을 잊고 크게 하품한다.
		PRINTDATAW
			DATAFORM 「부디... 방금 일은 잊어주세요...」
			DATAFORM 「...제가 그런 부끄러운 모습을 보여드려 죄송합니다...」
			DATAFORM 「...잠시 정신을 놓았네요... 죄송합니다...」
		ENDDATA
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;睡眠中（起きていないので会話というよりは寝言？）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;イタズラ中
	;記入チェック（=0, 非表示、1, 表示）
	;LOCAL:1 = 0
	;-------------------------------------------------
	;IF LOCAL:1 && ARG == 4
	;PRINTFORMW
	;RETURN 1
	;ENDIF
	;-------------------------------------------------
	;衰弱中（恋慕付き拠点内キャラがMAIN_MAPで衰弱状態になった場合か、お招き部屋で相手が衰弱した場合に発生
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:うふふ && TCVAR:30:374
			CALL HPH_PRINT, "「아히이... 후후 히이후우... 나하후으」", "L"
			CALL HPH_PRINT, "「아니, 더는... HPH이, 못하겠어... 움직일 수 없어... HPH」", "L"
			PRINTFORMDW 에이키는 격렬하게 오르가즘을 느낀 후 손가락 하나조차 들어 올릴 수 없는 것 같다...
		ELSE
			PRINTFORML 「하아... 하아...」
			PRINTFORML 「미안해요, %K30_C_NAME(MASTER)%...」
			PRINTFORMW 「내 몸이... 따라갈 수가 없어...」
		ENDIF
		SIF CFLAG:うふふ
			CALL K30_UFUFU_RECORD
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（部屋まで運ばれる）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		SIF CFLAG:MASTER:初期位置 == CFLAG:30:初期位置
			CFLAG:1605 = 1
		;媚薬で淫乱。キャラ崩壊気味
		IF GETBIT(TCVAR:30:367, 2) || GETBIT(TCVAR:30:367, 3)
			LOCAL = TALENT:尻穴狂い && RAND:2
			LOCAL:1 = FLAG:画像表示 && FLAG:挿絵表示
			LOCAL:2 = CURRENTREDRAW()
			REDRAW 0
			PRINTFORMW 「흐-흐응...? %K30_C_NAME(MASTER)%아?」
			PRINTFORML 「...우리는... 벌써 끝난 건가?」
			PRINTFORMW 「다른 선택지는 없는 것 같군... 다른 곳으로 옮겨야겠어, 그럼...」
			CALL TRIPLEDOT("reverse:timed") ;custom code
			CALL K30_D_LINE
			CALL HPH_PRINT, "「하후프 하후프 아후프 아아~ ... 아아홋ㅍㅎㅍ」", "L"
			CALL HPH_PRINT, "「...C-커ㅁ...! HPH 사정하는 중이다 HPHHPH」", "L"
			IF LOCAL
				CALL PRINT_IMAGE_ANIMATION_正常位("Ａ正常位_挿入")
			ELSE
				CALL PRINT_IMAGE_ANIMATION_正常位("正常位_挿入")
			ENDIF
			PRINTFORMDL ...아직 의식이 없는 채로, 당신은 \@ ARG:1 ? 침대 위에, # 방 안에, \@ 위를 향해 누워 있다.
			PRINTFORMDL 에이키가 당신의 위에서 무릎을 꿇고, 마치 망치처럼 자신의 골반을 단숨에 내리찍는다.
			PRINTFORMDW 그녀의 \@ LOCAL ? 항문 # 질 \@은 당신의 %FSYN("penis")%을 반복적으로 삼키며, 수많은 사정으로 정액이 옆으로 흘러나온다.
			LOCAL:3= LINECOUNT
			IF LOCAL
				CALL PRINT_IMAGE_ANIMATION_正常位("Ａ正常位_射精")
			ELSE
				CALL PRINT_IMAGE_ANIMATION_正常位("正常位_射精")
			ENDIF
			SIF LOCAL:1
				TWAIT 400, 0
			CLEARLINE LINECOUNT - LOCAL:3
			IF LOCAL
				CALL PRINT_IMAGE_ANIMATION_射精後("Ａ正常位_中出し")
			ELSE
				CALL PRINT_IMAGE_ANIMATION_射精後("正常位_中出し")
			ENDIF
			CALL HPH_PRINT, @"「...아아~큭 소오, 고오오드큭흐프」", "L"
			CALL HPH_PRINT, @"「그것이 \@ LOCAL ? 내 엉덩이 # 나 를 향해 발사되고 있다 \@HPH 벽에 부딪히고 있어HPHHPH」", "L"
			PRINTFORMDW 정액이 그녀의 \@ LOCAL ? 직장 # 질에 가득 차는 감각만으로 절정에 이른다 \@, 에이키는 경련하고 떨었다.
			PRINTFORML  
			CALL HPH_PRINT, @"「...후후후 후후후 %K30_C_NAME(MASTER)%... 그거 좋은 %PRINT_MALE("boy", MASTER)%후후후」", "L"
			CALL HPH_PRINT, @"「나의 귀여운 작은 %K30_C_NAME(MASTER)%… 나를 위해 계속해서 흘리는구나」", "W"
			PRINTFORML 
			CALL HPH_PRINT, @"「%K30_C_NAME(MASTER)%... 그냥 거기서 모든 걸 나에게 맡겨줘 HPH」", "L"
			CALL HPH_PRINT, @"「네가 내 품에서, 그리고 네 성기까지 ... 끝날 때까지 지켜줄게HPH」", "L"
			CALL HPH_PRINT, @"「그러니까 더, 더... 나에게 HPH 커밍을 더 해줘, 더HPHHPH」", "W"
			PRINTFORML 
			PRINTFORMDL 오르가슴의 여운을 즐기며, 에이키는 달콤한 새드끼로 당신의 무의식적인 형태에게 말을 건다.
			PRINTFORMDL 그러면서 그녀는 멈출 기미를 보이지 않고, 느리고 리듬감 있게 골반을 계속 움직인다.
			PRINTFORML 
			PRINTFORMDL 당신의 %FSYN("penis")%이 다시 활기를 되찾자, 에이키는 광적인 피스톤질을 시작한다...
			CALL TRIPLEDOT("reverse:timed") ;custom code
			CALL K30_D_LINE
			PRINTFORMDW 밤새도록 에이키는 악마적인 욕망에 사로잡힌 듯 네 무방비한 몸을 빠뜨리듯 움켜쥐었다...
			;ここまで来たらおそらく精力0だけど一応処理を置く
			IF LOCAL
				CALL ADD_SAMEN_A(30, BASE:MASTER:精力)
			ELSE
				CALL ADD_SAMEN_V(30, BASE:MASTER:精力, 0)
			ENDIF
			;おっぱい神と同じ破壊力
			BASE:MASTER:体力 = -5000
			BASE:MASTER:気力 = 0
			CFLAG:溜まってる度 = 0
			REDRAW LOCAL:2
			;酔っぱらい
		ELSEIF K30_DRUNK() > 1
			PRINTFORMW 「아하하하! 뭘 하고 있는 거야, 저렇게 쓰러지다니~」
			PRINTFORML 「...잠깐?! 진심이야?!」
			PRINTFORMW 「정말 무력하네~ 세상에~」
			;思い切りぶん殴られたor中出し強要中
		ELSEIF TCVAR:30:371 > 1 || TCVAR:30:386
			PRINTFORMW 「Ah...」
			PRINTFORMW 「이제 교훈을 얻었니...?」
			PRINTFORML 「......」
			PRINTFORMW 「그냥 이렇게 너를 두고 갈 수는 없는 것 같아...」
			;うふふ中断。わりかしひどい
		ELSEIF CFLAG:うふふ
			PRINTFORML 「Eh?! %K30_C_NAME(MASTER)%! %K30_C_NAME(MASTER)%?!」
			PRINTFORMW 「오, 안 돼... 너무 거칠었나...?」
			IF (TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER) && !TCVAR:無理矢理
				LOCAL = 2
				CALL HPH_PRINT, @"「...아아헵 아직도 너무 커, 안에 \@ TEQUIP:51 == PLAYER ? 내 엉덩이 # 나 \@...헵헵헵」", "L"
				CALL HPH_PRINT, @"「...NnnHPH AhhnHPH %K30_C_NAME(MASTER)%... 이런 식으로 계속해라...HPH」", "W"
			ELSEIF MASTER_POSE(4, 1) == 30 && !TCVAR:無理矢理
				LOCAL = 2
				CALL HPH_PRINT, @"「아흐으... 당신의 성기는 여전히 단단하네... 흐프」", "W"
				CALL HPH_PRINT, @"「...%RANDLIPS(,"suck")%흐으... 후후, 꿈틀거리고 있어... 귀엽네... 흐으」", "W"
			ENDIF
			PRINTFORMW 「......」
			PRINTFORMW 「나, 난 \@ LOCAL == 2 ? 이상한 짓을 하는 걸 #  \@ weird things and \@ ARG:1 ? %HIM_HER(MASTER,,1)% 잠들어야 해… # %HIM_HER(MASTER,,1)% %HIS_HER(MASTER)% 방으로 돌아가야…… \@」
			;通常
		ELSE
			PRINTFORML 「어이쿠, %K30_C_NAME(MASTER)%님, 괜찮으세요?!」
			SIF TCVAR:30:371 != 0
				PRINTFORML 「뭘 해야 할까... 너무 나갔을지도 몰라...」
			PRINTFORMW 「어쨌든, 나는 \@ ARG:1 ? %HIM_HER(MASTER,,1)%을 재우거나... # %HIM_HER(MASTER,,1)%을 %HIS_HER(MASTER)% 방으로 돌려야 해... \@」
		ENDIF
		;終了記録
		SIF CFLAG:うふふ
			CALL K30_UFUFU_RECORD
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが自室まで戻ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		;-------------------------------------------------
		;そのまま着替えて寝た
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 0
			IF CFLAG:MASTER:初期位置 == CFLAG:30:初期位置
				;SHOPメニュー表示中
				IF CFLAG:MASTER:睡眠
					CFLAG:1605 = 1
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDL 에이키는 당신의 뺨에 입을 맞추고 당신 옆에서 잠자리에 든다.
						CASE 1
							PRINTFORMDL 에이키는 당신의 이불을 고치고 당신 옆에서 잠이 든다.
						CASE 2
							PRINTFORMDL 에이키는 당신의 잠든 얼굴을 보며 잠이 들었다.
					ENDSELECT
					CALL K30_D_LINE
					;映姫様通常睡眠時刻
				ELSEIF GROUPMATCH(TIME / 60, 0, 24)
					IF INRANGE(TIME:3 / 60, 4, 18)
						PRINTFORML 「\@ TALENT:恋人 ? 밤이야 # 잘 자 \@, %K30_C_NAME(MASTER)%.」
						PRINTFORMW 「너무 무리하지 마.」
					ELSE
						PRINTFORML 「나 이제 자야 해...」
						PRINTFORMW 「같은 지붕 아래서 살고 있으니까, 같이 잠들면 안 될까...?」
					ENDIF
				ELSE
					CFLAG:1605 = 1
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMDL 에이키는 당신의 뺨에 입을 맞추고 당신 옆에서 잠자리에 든다.
						CASE 1
							PRINTFORMDL 에이키는 당신의 이불을 고치고 당신 옆에서 잠이 든다.
						CASE 2
							PRINTFORMDL 에이키는 당신의 잠든 얼굴을 보며 잠이 들었다.
					ENDSELECT
					PRINTFORML 
					CALL K30_D_LINE
				ENDIF
			ELSE
				IF INRANGE(TIME:3 / 60, 4, 18)
					PRINTFORML 「\@ TALENT:恋人 ? 밤이야 # 잘 자 \@, %K30_C_NAME(MASTER)%.」
					PRINTFORMW 「너무 무리하지 마.」
				ELSE
					PRINTFORML 「이렇게 늦게까지 안 자고 있었어...?」
					PRINTFORML 「나 먼저 잠자리에 들게.」
					PRINTFORMW 「%K30_C_NAME(MASTER)%야, 잘 자.」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;部屋から追い出された
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			IF TALENT:恋慕
				PRINTFORMW 「죄송하지만 나가 주시겠어요?」
			ELSE
				PRINTFORML 「왜 여기에 있는 거야...」
				PRINTFORMW 「즉시 떠 주세요.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;他キャラとのＨを止めさせて寝た＠後出しの説教つけたい
		;記入チェック（=0, 非表示、1, 表示）
		;情事発覚通らないから弱みつかない？
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 2
			PRINTFORML 「...할 말이 많은데, 다른 날로 미루자.」
			PRINTFORMW 「빨리 나가거라!」
			SETBIT CFLAG:1699, 3
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;非在住TARGETがMAIN_MAPで休憩
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		IF CFLAG:うふふ
			IF TCVAR:30:374
				CALL HPH_PRINT, "「히이...흐프 아히이...흐프 ...히이해프」", "L"
				CALL HPH_PRINT, "「더는... HPH를 받을 수 없어... HPH」", "W"
			ELSE
				PRINTFORML 「미안해... 더는... 안 돼...」
				PRINTFORMW 「더 이상... 움직일 수가 없어...」
			ENDIF
			CALL K30_UFUFU_RECORD
		ELSE
			PRINTFORML 「하아... 하아...」
			PRINTFORMW 「미안해... %K30_C_NAME(MASTER)%, 잠시... 쉬자...」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;前のターンから一緒の部屋にいる状態で相手が寝る（お招き部屋、自室でヤリ過ぎてもここ）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		IF TCVAR:30:374
			CALL HPH_PRINT, "「히이...흐프 아히이...흐프 ...히이해프」", "L"
			CALL HPH_PRINT, "「못하겠어... HPH 안 돼... 더는 HPH」", "W"
		ELSEIF BASE:30:体力 < 500
			PRINTFORML 「하아... 하아...」
			PRINTFORMW 「나 너무 지쳤어... %K30_C_NAME(MASTER)%님, 잠깐... 쉬어도 될까요...」
		ELSE
			PRINTFORMW 「\@ TALENT:恋人 ? 밤에 잘 때 # 안녕 \@, %K30_C_NAME(MASTER)%...」
		ENDIF
		SIF CFLAG:うふふ
			CALL K30_UFUFU_RECORD
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;拠点外で自宅前に居るキャラが自室に帰って寝る（眠くなった～は自室に帰って行きました）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		IF TALENT:恋慕
			PRINTFORML 「...벌써 이렇게 늦었네.」
			PRINTFORML 「미안해, 나 먼저 잠자리에 들게.」
			PRINTFORMW 「\@ TALENT:恋人 ? 밤 # 잘 자 \@, %K30_C_NAME(MASTER)%...」
		ELSE
			PRINTFORML 「너무 늦게까지 깨어 있으면 내일 부정적인 결과가 있을 거야...」
			PRINTFORML 「밤에 빈둥거리며 돌아다니기보다는 너도 집으로 가는 게 어때?」
			PRINTFORMW 「그럼 좋은 저녁 보내.」
		ENDIF
		RETURN 1
	ENDIF
	;その他
ENDIF
RETURN 1
;==================================================
;移動時すれちがい
;==================================================

@M_KOJO_EVENT_K30_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL && SHIRAHU(30)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;この後遭遇口上に接続
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:機嫌 < 0
		ELSEIF K30_CHECK_HEN_T()
			PRINTFORMDL 에이키는 아직 당신이 다가오는 것을 눈치채지 못했다...
		ELSEIF TALENT:恋人
			PRINTFORMDL 에이키의 얼굴에 꽃처럼 미소가 피어난다, 그녀는 당신을 알아본다.
		ELSEIF TALENT:恋慕
			PRINTFORMDL 에이키가 당신이 그녀에게 인사하기를 기다리는 것 같다...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF K30_CHECK_HEN_T()
			PRINTFORMDL 에이키는 허공을 응시하고 있다.
		ELSE
			PRINTFORMDL 에이키가 당신의 가벼운 인사를 되돌려준다.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF K30_CHECK_HEN_T()
