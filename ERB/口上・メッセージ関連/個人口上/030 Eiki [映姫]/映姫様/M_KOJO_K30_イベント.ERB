@M_KOJO_EVENT_K30_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	CALL K30_DENY_POLYAMORY(1)
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF K30_CHECK_HEN_T()
					IF TALENT:恋人
						PRINTFORMW 「사람들이 우리를 보지 못할 곳으로 가자...」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「우리가 보이지 않을 만한 곳을 알아...?」
					ELSE
						PRINTFORMW 「제발, 나랑 어디에 같이 나가줘...」
					ENDIF
				ELSE
					IF TALENT:恋人
						PRINTFORMW 「재미있게 어디론가 놀러 갈래, %K30_C_NAME(MASTER)%?」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「나랑 어디 외출할래, %K30_C_NAME(MASTER)%?」
					ELSE
						PRINTFORMW 「여기 왔으니, 연회 기다리는 동안 어디든 가고 싶으신가요?」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				TCVAR:30:358 = 1
				IF K30_CHECK_HEN_T()
					PRINTFORMW 「정말 고마워...」
				ELSEIF TALENT:恋慕
					RESULT = 0
					SIF !GETBIT(CFLAG:1609, 2)
						CALL K30_INSERT_VIBE_DATE
					SIF RESULT
						RETURN 1
					PRINTFORMW 「후훗, 그럼 가볼까?」
				ELSE
					PRINTFORMW 「정말 감사합니다.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF K30_CHECK_HEN_T()
					PRINTFORMW 「오호, 그런가...」
				ELSEIF TALENT:恋慕
					PRINTFORML 「하아, 당분간 할 게 없겠네...」
					PRINTFORMW 「그렇겠죠. 누군가를 가르쳐야겠어요...」
				ELSE
					PRINTFORMW 「...그런가요.」
					PRINTFORML 「...하지만 물론, 다른 사람의 편의에 따라 끌려다니는 것은 성가실 수밖에 없겠죠.」
					PRINTFORMW 「부디 용서해 주세요.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF K30_CHECK_HEN_T()
					PRINTFORMW 「음... 내 방에서 잠시 얘기하고 싶어?」
				ELSE
					IF TALENT:恋人
						PRINTFORMW 「내 방에서 쉬고 싶지 않아?」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「음... 내 방에서 잠시 얘기하고 싶어?」
					ELSE
						PRINTFORMW 「내 방에서 너와 이야기하고 싶은 게 있어.」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF K30_CHECK_HEN_T()
					PRINTFORMW 「정말 고마워...」
				ELSE
					IF TALENT:恋人
						PRINTFORMW 「그럼 가자, 응? ♪」
					ELSEIF TALENT:恋慕
						PRINTFORMW 「정말 감사합니다. 이쪽으로 오세요.」
					ELSE
						PRINTFORMW 「정말 감사합니다. 그럼 저를 따라오세요.」
					ENDIF
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋人
					PRINTFORML 「음, 연인의 부탁을 거절하다니...」
					PRINTFORMW 「Do you have some other business, I wonder...?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「알겠다, 안됐네...」
				ELSEIF TALENT:思慕
					PRINTFORMW 「알겠다. 그거 유감하네...」
				ENDIF
				PRINTFORMW 「그럼 다음에 또 보자.」
				RETURN 1
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
