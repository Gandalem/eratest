					PRINTFORMW （%K30_C_NAME(MASTER)% and %K30_C_NAME(ARG:1)%. They really are right for each other...）
			ENDIF
		ELSE
			PRINTFORMDW Eiki tries to be considerate towards to the two of you by greeting you wordlessly.
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一日最初の挨拶
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG, 8, 9)
		;おはよう口上から連続
		IF TFLAG:192 == 10
			IF TCVAR:30:373 == 1 || TCVAR:30:363 != 0
