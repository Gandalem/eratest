;「四季様の愛のあるお説教……イイ……！」
;
;**** FlagManagement **********************************************************
;本口上にて使用しているCFLAG・TCVAR等
;TCVAR:30:351 複数恋人発覚フラグ
;TCVAR:30:352 風チラ発生フラグ
;TCVAR:30:353 アヘ顔フラグ
;TCVAR:30:354 おしり画像ぱんつ描画フラグ
;TCVAR:30:355 おしり画像エフェクト制御フラグ
;TCVAR:30:356 特殊表情COM制御フラグ
;TCVAR:30:357 フェラアニメ制御フラグ
;TCVAR:30:358 デートのお誘い(=0 あなたから =1 相手から)
;TCVAR:30:359 一日一回の会話＠来訪理由
;TCVAR:30:360 IMAGE.ERB受け渡し用フラグ (=TIMEで表情変化) 
;TCVAR:30:361 強制攻守交代口上フラグ１
;TCVAR:30:362 強制攻守交代口上フラグ２
;TCVAR:30:363 朝うふふフラグ(=TIME 朝フェラした時間 =-1 妊活の為我慢した -1以下 朝うふふ実行)
;TCVAR:30:364 バイブ挿入デートフラグ(=1 挿入中 =-1 時間停止中)
;TCVAR:30:365 バイブ挿入デートリモコン(=1 弱 =2強)
;TCVAR;30:366 特殊衰弱中フラグ(=1 ヤリすぎ)
;TCVAR:30:367 媚薬関連フラグ(Bit0-もう飲まない Bit1-後付け[淫乱]付与中 Bit2-上限突破 Bit3-搾り取りモード)
;TCVAR:30:368 バイブ挿入デートリモコン連打防止(=TIME:1)
;TCVAR:30:371 映姫様折檻フラグ(=1 怒ってる =2 オオイカリ =3 マジイカリ)
;TCVAR:30:372 虫の居所フラグ(=1 @KIGEN_CHANGEで不機嫌になった。MASTERが悪くない)
;TCVAR:30:373 おはよう口上フラグ(=1 おはよう口上通した =2 映姫様起きてなかった =3 部屋に乱入された)
;TCVAR:30:374 特殊衰弱中フラグ(=1 ヤリすぎ)
;TCVAR:30:375 射精口上分岐フラグ(ダブルフェラ/授乳プレイ)
;TCVAR:30:377 詫びおぱんつフラグ(=-1 配送予約済み =2～ 手元のぱんつ種類)
;TCVAR:30:376 押し倒し口上制御フラグ(=1 押し倒し中 =2 押し倒され中)
;TCVAR:30:378 私室でうふふしたフラグ(=1 部屋でした)
;TCVAR:30:379 薬入りお茶フラグ(=1～5 口上分岐 =10～ミニイベント終了)
;TCVAR:30:380 当日うふふ回数
;TCVAR:30:381 当日弱み握りモニタリング
;TCVAR:30:382 前ターンＡ絶頂モニタリング
;TCVAR:30:383 うふふ終了時刻監視フラグ
;TCVAR:30:385 映姫様マグロスイッチ（ =1 ON）
;TCVAR:30:386 無理矢理フラグ
;TCVAR:30:387 恋人同衾フラグ
;TCVAR:30:389 お気に入り体位記録
;TCVAR:30:390 Ｃ絶頂回数
;TCVAR:30:391 Ｖ絶頂回数
;TCVAR:30:392 Ａ絶頂回数
;TCVAR:30:393 Ｂ絶頂回数
;TCVAR:30:394 Ｍ絶頂回数
;TCVAR:30:395 口内射精回数
;TCVAR:30:396 あなた射精回数
;TCVAR:30:397 五重絶頂
;TCVAR:30:398 騎乗位の向き(=0 対面 =1 背面)
;CFLAG:1500 映姫様おしり画像＆アニメーションスイッチ（Bit0-フェラアニメ 1-おしり画像 2-まばたき）
;CFLAG:1501 口上色保存フラグ
;CFLAG:1502 妊娠願望関連フラグ
;(Bit0-危険日Ｈ解禁 1-子宝願掛け済 2-信頼度到達 3-願望取得済 4-二人目願望)
;CFLAG:1503 うふふ我慢日数
;CFLAG:1504 合意うふふ終了時刻(= TIME:1)
;CFLAG:1505 映姫様恋人フラグ(Bit0-告白成功 Bit1-破局済)
;CFLAG:1602 キス制御フラグ
;CFLAG:1603 翌日行動予約フラグ（=1 願掛けで来訪 =2 同居時自慰して朝襲う予定 =3,4 自慰我慢して来訪）
;CFLAG:1605 就寝フラグ (=1 同棲時、おやすみ口上通したor初期位置で寝た =10 同棲決定後口上制御)
;CFLAG:1606 朝フェラフラグ（Bit0-発生抑制 1-依頼時口上制御）
;CFLAG:1607 潮吹きカウントフラグ
;CFLAG:1608 バイブ挿入デート累計
;CFLAG:1609 バイブ挿入デートフラグ(Bit0-予約済 1-本日実行中 2-実行抑制 3-願掛け表示フラグ 4-リモコン追加）
;CFLAG:1698 情事ばれモニタリング
;CFLAG:1699 弱み関連管理(Bit =0 パンツ密輸前科あり =1 密輸説教待ち =2 盛りすぎ説教待ち =3 寝室ヤリ部屋化説教待ち)
;CFLAG:1700 ぱんつ密輸モニタリング
;CFLAG:1701 良いお話の累計
;CFLAG:1801 映姫様ガードアップフラグ(=1 ガード力アップ)
;CFLAG:1802 母乳口上分岐フラグ(=1 授乳期間中)
;CFLAG:1803 メッセージ抑制フラグ(Bit0-ガード力アップUPDATE 1-弱み握り 2-呼び名変更 3-日記UPDATE
;									4-母乳体質UPDATE 5-特殊デート 6-別絵確認 7-痛みに強い付与 8-口上色変更)
;CFLAG:1804 育児口上抑制フラグ(Bit1~10がTALENT:育児中に対応)
;CFLAG:1805 無自覚妊娠フラグ
;CFLAG:1900 日記フラグ(初回遭遇パターン)
;CFLAG:1901 日記フラグ(初回遭遇時大家ID)
;CFLAG:1910 日記分岐管理
;(Bit =0 弾幕勝負経過 =1 弾幕勝負結果 =2 日記記入抑制No.1 =3 日記記入抑制No.2 =4 ぱんつ密輸検挙歴
;	  =5 望んだ妊娠 =6 キス主導権 =7 縦割れアナル =8 日記記入抑制No.36 =9 日記記入抑制No.50	)
;＊＊明確な口上使用領域ではないので注意＊＊
;CSTR:30:80 恋慕二人きり限定のMASTER呼び名
;CSTR:30:81 日記用記録１([日記ID:内容]…の形式で@SET_DICによる管理)
;CSTR:30:82 日記用記録２(ひとまとめより処理が早そうなので分割)
;CSTR:30:83 無自覚孕ませの子の名前
;******************************************************************************
;### 口上存在判定 ###################################
@M_KOJO_K30(ARG)
;別人版を作成する際はこのテンプレではなく別人版用口上テンプレをご利用ください

;口上存在判定です、けしてコメントアウトしないでください
;他の処理は一切行わないように
RETURN 1

;### 口上基本フラグ設定 #############################
@M_KOJO_FLAGSETTING_K30
#DIM COM_TIME
#DIMS PREV_STR

SIF CFLAG:30:1501 == 0 ;custom code, set default color in case it's not initialized
	CFLAG:30:1501 = 0x337D5C

;基本フラグ設定はここで行ってください
;共通の口上フラグは必要な箇所のコメントアウトを外してご利用ください
;口上専用フラグはご自由に
;Xにはキャラ番号を入れてください
;眠姦口上有、時間停止口上有、なりきりに1を入れると、それぞれ時間停止時、眠姦時、なりきり時にコマンド口上が読み込まれるように
;入れないと時間停止時、眠姦時、なりきり時は一切喋りません
CFLAG:30:時間停止口上有 = 1
CFLAG:30:眠姦口上有 = 1

;破瓜キャンセル口上有に1を入れると、@M_KOJO_EVENT_KX_LOST_VIRGIN_STOPでキャンセルの成否を操作できます
;映姫様はお堅いので処女はなるべく守ろうとするよ
;押し倒し禁止に1を入れると、自分から押し倒してこなくなります
;映姫様はお堅いので恋慕かセフレがつくまで押し倒してこないよ
IF CFLAG:30:1801 == 1
	CFLAG:30:破瓜キャンセル口上有 = 1
	IF TALENT:30:恋慕 || TALENT:30:セフレ || TALENT:30:愛欲
		CFLAG:30:押し倒し禁止 = 0
	ELSE
		CFLAG:30:押し倒し禁止 = 1
	ENDIF
ELSE
	CFLAG:30:押し倒し禁止 = 0
	CFLAG:30:破瓜キャンセル口上有 = 0
ENDIF

;口上内抱き寄せ判定_初回と口上内抱き寄せ判定_通常に1を入れると、M_KOJO_EVENT_KX_PERMISSIONで押し倒しの成否を操作できます
;CFLAG:X:口上内抱き寄せ判定_初回 = 0
;CFLAG:X:口上内抱き寄せ判定_通常 = 0

;映姫様は意識がちゃんとある時しかキス合意を認めないよ
SIF CFLAG:30:1801 == 1 && CFLAG:30:1602 == 0
	CLEARBIT CFLAG:30:既成事実, 0
	
;映姫様は風チラガード硬めだよ
;でもバイブデート中はユルユルだよ
IF !CFLAG:30:うふふ && TEQUIP:30:アナルバイブ
	CFLAG:30:めくれ補正 = 33
ELSEIF TCVAR:30:352 || CFLAG:30:ノーパン
	CFLAG:30:めくれ補正 = -100
ELSE
	CFLAG:30:めくれ補正 = -10
ENDIF

;バニーの日でも映姫様は変Ｔから逃げられないよ
IF CFLAG:30:衣装一時変更 == 55 && !CFLAG:30:うふふ
	LOCAL = DAY % 7 == 5 ? 62 # 17
	CALL CTRL_CLOTHES_SET(30, "現在衣装の変更_衣装セット", LOCAL)
	CALL CLOTHES_SETTING_TRAIN(30)
ENDIF

;映姫様はえっちした時間をしっかり覚えてるよ
IF TCVAR:30:383 && !CFLAG:30:うふふ
	TCVAR:30:383 = 0
	CFLAG:1504 = TIME:1
ENDIF

;ターン毎複数恋人管理
CALL K30_DENY_POLYAMORY(0)

;媚薬で搾り取りモードなら溜まってる度減らさない
SIF GETBIT(TCVAR:30:367, 3)
	CFLAG:30:溜まってる度 = MIN(CFLAG:30:溜まってる度, 666)
	
;媚薬で搾り取りモード中はうふふから逃さない
SIF COM_STR == "K30_搾り取りモード"
	CALL K30_KIMESEKU_PUSHDOWN

;COM_STR管理=口上独自で1ターンのみ継続するフラグを立てる
SIF STRFIND(PREV_STR, "K30_") > -1 && COM_STR == PREV_STR && COM_TIME < TIME:1
	COM_STR = 
PREV_STR '= COM_STR
COM_TIME = TIME:1

;無自覚孕ませの代償
IF CFLAG:30:1805
	CFLAG:30:子宝補正 = 0
	EX:30:膣内精液 = 0
	SIF FLAG:子宝祈願 == 30
		FLAG:子宝祈願 = 0
	SIF CFLAG:30:1805 > 2
		TALENT:30:機嫌 = MIN(TALENT:30:機嫌, 0)
ENDIF

;ガーターベルト描画フラグ
SIF !TCVAR:30:354
	TCVAR:30:354 = CFLAG:30:きょうのぱんつ == 22 ? 1 # -1

;オプション設定＆現在位置が映姫様と一緒の場合、コマンド待機時のアニメ描画優先度変更
SETANIMETIMER 32627
SIF CFLAG:MASTER:現在位置 == CFLAG:30:現在位置 && GETBIT(CFLAG:30:1500, 2)
	SETANIMETIMER 50

;バイブデートフォロー
SIF TCVAR:30:364 >= 0
	RETURN 1
SIF CFLAG:30:うふふ
	RETURN 1
TEQUIP:30:アナルバイブ = 1
TCVAR:30:364 = 1
RETURN 1

;### 来訪前フラグ設定 #############################
@K30_BEFORETRAIN
;変Ｔを着て朝から上機嫌とか無理
SIF DAY % 7 == 5 || FLAG:ファッション == 62
	TALENT:30:機嫌 = MIN(TALENT:30:機嫌, 0)

;母乳イベント用フラグ
CFLAG:30:1802 = (INRANGE(CFLAG:30:出産経過日, 1, 24) || CFLAG:30:妊娠経過日数 >= 90) && !CFLAG:1805

;同棲中外泊朝帰りチェック
SIF CFLAG:MASTER:初期位置 == CFLAG:30:初期位置 && CFLAG:MASTER:現在位置 != CFLAG:30:初期位置 && STRFIND(CSTR:30:1, "同居") == -1
	CFLAG:1605 = 0

;### 口上色判定 ###################################
@M_KOJO_COLOR_K30
SETCOLOR CFLAG:30:1501
;custom code, commented out
;RETURN RESULT

;### 一般依頼の抑制 ###############################
;ARG is request number
;If this function returns 1, that request will not occur for this character
@M_KOJO_CHECK_K30_IRAI_BLOCKED(ARGS, ARG, ARG:1)
;「あれ、なんだっけ」は映姫様には合わないので抑制
SIF ARG == 17
	RETURN 1
RETURN 0

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"UPDATE判定"
;※※※※※※※※※※※※※※※※※※※※※※※※※※
@M_KOJO_UPDATE_K30
#DIM TEMP
#DIM R_TEMP
;口上独自のUPDATE用
;ENCOUNTER専用に独自分岐フラグを仕込んだ場合等にどうぞ
;UPDATE判定でCFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります
SIF CFLAG:30:1501 == 0 ;custom code failsafe
	CFLAG:30:1501 = 0x337D5C
VARSET LOCALS
SETBIT CFLAG:30:1803, 4
SIF TALENT:30:恋人 && !CFLAG:30:1505
	SETBIT CFLAG:30:1505, 0
SIF CFLAG:30:生解禁 == 2
	SETBIT CFLAG:30:1502, 0
IF CFLAG:30:面識 && GETBIT(CFLAG:30:1803, 3) == 0
	VARSET DIARY:30, 0, 0, 101
	VARSET PAGESET:30, 0, 0, 101
	DIARY:30:50 =1
	PAGESET:30:1 = 50
	IF CFLAG:30:1902
		CSTR:30:81 = [50:%TOSTR(CFLAG:30:1902)%/晴れ/]
		CSTR:30:82 = [50:%MASTERNAME:30%/%CSTR:30:82%/]
	ELSE
		CFLAG:30:1900 = 3
		CFLAG:30:1901 = 1
		CSTR:30:81 = [50:3/晴れ/]
		CSTR:30:82 = [50:%MASTERNAME:30%/博麗神社/]
	ENDIF
	SIF !TALENT:30:キス未経験
			CALL K30_WRITE_DIARY(1, 1)
	SIF CSTR:30:処女喪失履歴 != "" 
			CALL K30_WRITE_DIARY(2, 1)
	PRINTFORML 
	PRINTFORML Eiki's diary has been reset due to specification changes.
	PRINTFORMW Please note that the diary may not be displayed properly in the old data.
	PRINTFORML 
	SETBIT CFLAG:30:1803, 3
ENDIF 
IF !GETBIT(CFLAG:30:1803, 6)
	SETBIT CFLAG:30:1803, 6
	IF !CFLAG:30:差し替え適用 && SPRITECREATED("30_bodyparts_00")
		PRINTFORML
		PRINTFORML Eiki's portrait set will be changed as per dialogue suggestion.
		PRINTFORMW In case you want the original back, use [Display Settings] and switch [Alternate Img] to OFF when viewing the character.
		PRINTFORML 
		CFLAG:30:差し替え適用 = 1
	ENDIF
ENDIF
IF !GETBIT(CFLAG:30:1803, 7)
	SETBIT CFLAG:30:1803, 7
	TALENT:30:痛覚 = -1
	PRINTFORML 
	CALL COLORMESSAGE, @"In accordance with her dialogue, Eiki has gained [%GET_TALENTNAME_TR(40, -1)%].", C_YELLOW, 2, 0
ENDIF

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;Custom dialogue settings, custom code
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;made it as a way to speed up the update process and separate simple flag updates from various customization options
;note: options start from 1!
@KOJO_OPTION_K30
LOCALS = %CSTR:30:80%
SIF LOCALS == "" && LOCALS != CALLNAME:MASTER
	LOCALS = %\@ TALENT:恋人 ? %MASTERNAME:30% # %MASTERNAME:30%-san \@%
CALL KOJO_OPTION_ITEM(@"Change how Eiki addresses you%COND_STR(@", current: %LOCALS%", LOCALS != "")%", 1)
CALL KOJO_OPTION_ITEM("Change Eiki's alertness", 2, "status:Ordinary:Strict", CFLAG:30:1801)
CALL KOJO_OPTION_ITEM(@"Extra settings for Alt 1 portrait　Oral:\@ GETBIT(CFLAG:30:1500, 0) ? On # Off\@　Butt:\@ GETBIT(CFLAG:30:1500, 1) ? On # Off \@　Flashing:\@ GETBIT(CFLAG:30:1500, 2) ? On # Off \@", 3)
SIF !CFLAG:30:1501 ;set initial color if necessary
	CFLAG:30:1501 = 0x337D5C
CALL M_KOJO_COLOR_K30
CALL KOJO_OPTION_ITEM("Change dialogue color", 4)
RESETCOLOR

;process the input portion
@KOJO_OPTION_K30_RESULT_1
PRINTFORML Would you like to change the usual "%CALLNAME:MASTER%%COND_STR(@"-san", !TALENT:30:恋人)%"?
CALL ASK_YN("Set custom", "Use your default name")
IF !RESULT
	CALL K30_SET_C_NAME(2)
	RESETCOLOR
ELSE
	MASTERNAME:30 = %CALLNAME:MASTER%
	PRINTFORMW Name has been set to "%CALLNAME:MASTER%%COND_STR(@"-san", !TALENT:30:恋人)%".
ENDIF

@KOJO_OPTION_K30_RESULT_2
PRINTFORML Eiki \@ CFLAG:30:1801 == 1 ? is a strict Yama-sama who never lowers her guard # is just an ordinary girl from Gensokyo \@ as of right now.
PRINTFORML Would you like to change her alertness?
CALL ASK_YN
SELECTCASE RESULT
	CASE 0
		CALL K30_SELECT_TYPE
ENDSELECT

@KOJO_OPTION_K30_RESULT_3
#DIM R_TEMP
#DIM TEMP
R_TEMP = CURRENTREDRAW()
REDRAW 0
PRINTL Eiki's extra portrait settings (dialogue exclusive)
PRINTL 
DO
	TEMP = LINECOUNT
	CALL PRINTBUTTON_EX, @"[0] - Oral sex animations   %\@ GETBIT(CFLAG:30:1500, 0) ? On # Off \@%　※High image-processing load", 0, 0, GETBIT(CFLAG:30:1500, 0)
	PRINTL
	CALL PRINTBUTTON_EX, @"[1] - Butt Cut-Ins          %\@ GETBIT(CFLAG:30:1500, 1) ? On # Off \@%　※Some imagery may be inappropriate", 1, 0, GETBIT(CFLAG:30:1500, 1)
	PRINTL
	CALL PRINTBUTTON_EX, @"[2] - Flashing animations   %\@ GETBIT(CFLAG:30:1500, 2) ? On # Off \@%　※Experimental - some instability", 2, 0, GETBIT(CFLAG:30:1500, 2)
	PRINTFORML \n
	PRINTL [9] - Confirm
	INPUT
	SELECTCASE RESULT
		CASE 0 TO 2
			INVERTBIT CFLAG:30:1500, RESULT
		CASE 9
			REDRAW R_TEMP
			BREAK
	ENDSELECT
	CLEARLINE LINECOUNT - TEMP
LOOP 1

@KOJO_OPTION_K30_RESULT_4
SETBIT CFLAG:30:1803, 8
CFLAG:30:1501 = 0x337D5C
PRINTFORML 
CALL M_KOJO_COLOR_K30
LOCAL = 0x337D5C, 0x52C487, 0x7FD8A7, GETDEFCOLOR(), 0xFF93FB
SIF !CFLAG:30:面識
	PRINTFORML 「You, there... I apologize for the sudden interruption. My name is Shiki Eiki.」
PRINTFORML 「It has recently come to my attention that some consider my teachings to be long-winded and my voice to be difficult to hear.」
PRINTFORML 「I believe the length is primarily because my audience fails to live a virtuous life, but...」
PRINTFORML 「If I am difficult to hear, that must be my own shortcoming.」
PRINTFORML 「...How do you think I should speak to be easier to hear?」
PRINTFORMDL 
SETCOLOR LOCAL:0
PRINTL [0] - Low, calm tone
SETCOLOR LOCAL:1
PRINTL [1] - In a normal, plain voice
SETCOLOR LOCAL:2
PRINTL [2] - A little bit more high-pitched
RESETCOLOR
PRINTL [3] - Your usual is fine
SETCOLOR LOCAL:4
PRINTL [4] - A sexy voice, please
RESETCOLOR
DO
	INPUT
	LOCAL:99 = RESULT
	SIF INRANGE(RESULT, 0, 4)
		BREAK
	CLEARLINE 1
LOOP 1
CFLAG:30:1501 = LOCAL:RESULT
CALL M_KOJO_COLOR_K30
SELECTCASE LOCAL:99
	CASE 2
		PRINTFORML 「This will... take some time to get used to.」
		PRINTFORML 「But I shall do my best. Thank you for your cooperation.」
	CASE 3
		PRINTFORML 「Is my voice... really that difficult to hear...?」
		PRINTFORML 「Well, thank you for informing me...」
	CASE 4
		PRINTFORML 「Eh...? Like... this?」
		PRINTFORML 「...Are you serious?」
	CASEELSE
		PRINTFORML 「Very well. Thank you for your cooperation.」
ENDSELECT
RESETCOLOR
PRINTFORML
;PRINTFORMW ※口上色はSHOPメニューから変更できます

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"ENCOUNTER"系イベント（エクストラ構文）
;※※※※※※※※※※※※※※※※※※※※※※※※※※
@M_KOJO_ENCOUNTER_K30
;初対面、挨拶のタイミング
;TALENTの変更はここでどうぞ
CALL K30_SELECT_TYPE
SIF K30_CHECK_HEN_T()
	CALLF FIRSTTIME("変Ｔお披露目")
;BIT 0と3を同時にON
CFLAG:30:1803 = 9
