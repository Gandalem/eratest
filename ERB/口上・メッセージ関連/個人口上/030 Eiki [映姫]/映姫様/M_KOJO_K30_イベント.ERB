		;押し倒され未経験
		IF CFLAG:1801 && !STRCOUNT(CSTR:30:0, "押し倒し")
			PRINTFORML 「우으음...」
			PRINTFORML 「%TEXTR(@"아니, 아무것도 아냐./나 신경 쓰지 마.")%...」
			IF ARG:1 < 800
				PRINTFORMDL 에이키는 무언가를 필사적으로 억누르고 있는 것 같다...
			ELSE
				PRINTFORMDL 이 시점에서도 에이키는 체면을 유지하려고 애쓰고 있다...
			ENDIF
			;子供がいるでしょ
		ELSEIF TFLAG:描写中の子供 == 30 && GET_TARGETNUM() == 1 && INROOM(CFLAG:MASTER:現在位置)
			IF ONCE("子供の前")
				PRINTDATAL
					DATAFORM (아... 나는 %SHOW_CHILDNAME(30)% 앞에서 무슨 부끄러운 생각을 하고 있는 거지...)
					DATAFORM (어머니인데도... 정말 미안하다, %SHOW_CHILDNAME(30)%...)
					DATAFORM (%SHOW_CHILDNAME(30)%가 보고 있는데 나 자신을 제어하지 못하고 있다니...)
				ENDDATA
			ENDIF
			RESETCOLOR
			RETURN
			;欲求不満度=地の文で分岐
		ELSE
			SELECTCASE ARG:1
				CASE 1000
					PRINTDATAL
						DATAFORM 「내가 원하는 게 뭔지 알잖아, 그치?♥ 아니면 직접 말해야 하나...」
						DATAFORM 「제발, 제발... 더는 견딜 수가 없어...♥」
						DATAFORM 「정말 치기고 부끄러워... 하지만 더는 못 참겠어.」
						DATAFORM 「빨리, 서둘러... 우리를 %LOCALS%가 볼 수 없는 곳으로 가자...♥」
					ENDDATA
				CASE 800 TO 999
					PRINTDATAL
						DATAFORM 「...당신도 %LOCALS%가 우리를 보지 않기를 바라겠지, 안 그래?」
						DATAFORM 「가자... 참는 건 우리 둘에게 좋지 않아...」
						DATAFORM 「서둘러 어딘가로 가자... %LOCALS%가 우리를 볼 수 없는 곳으로...」
					ENDDATA
				CASEELSE
					PRINTFORML 「...%TEXTR(@"다른 데 갈까?/조용한 곳으로 가자./잠깐 쉬고 싶지 않아?")%」
			ENDSELECT
		ENDIF
		RESETCOLOR
		RETURN 1
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
