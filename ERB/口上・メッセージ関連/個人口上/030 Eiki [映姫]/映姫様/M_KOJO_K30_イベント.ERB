		;通常の挨拶
		ELSE
			IF TALENT:恋人
				PRINTFORML 「%K30_GREETING_EIKI()%, %K30_C_NAME(MASTER)%.」
				PRINTFORMDL Eiki \@ TALENT:機嫌 > -1 ? seems happy to see you # greets you normally \@.
			ELSEIF TALENT:恋慕
				PRINTFORML 「%K30_GREETING_EIKI()%, %K30_C_NAME(MASTER)%.」
				PRINTFORMDL Eiki \@ TALENT:機嫌 > -1 ? greets you with a smile # greets you \@.
			ELSEIF TALENT:思慕
				PRINTFORML 「%K30_GREETING_EIKI()%, %K30_C_NAME(MASTER)%.」
				PRINTFORMDL Eiki notices you and gives you a quick greeting.
			ELSE
				PRINTFORML 「%K30_GREETING_EIKI()%, %K30_C_NAME(MASTER)%.」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1

