@KOJO_SF_CONTRACT_EVENT_K30(ARGS)
SELECTCASE ARGS
	CASE "導入"
		PRINTFORMDL 당신은 에이키에게 섹프가 되는 것을 제안한다.
		PRINTFORMW 
		IF K30_CHECK_HEN_T()
			PRINTFORML 「...」
			PRINTFORML 「...하아?」
		ELSE
			PRINTFORML 「어, 너 뭐야...」
			PRINTFORMW 「섹프라고?! 나랑...?」
			IF TALENT:ヤリマン || TALENT:即落ち
				PRINTFORML (내 마음이 왜 이렇게... 흔들리는 거지...)
			ELSEIF !GETBIT(CFLAG:既成事実, 1)
				PRINTFORML 「?!!」
				PRINTFORML 「지금 네가 내뱉는 말들을 도대체 이해하고 있는 거냐?!」
			ELSEIF TALENT:思慕
				PRINTFORML 「이미... 당신에게 몸을 바쳤는데...」
				PRINTFORML 「그렇게까지 가는 것은...」
			ELSE
				PRINTFORML 「혹시 제가 잘못 들은 건가요?」
				PRINTFORML 「제정신으로 누군가가 그런 제안을 할 수 있다고는 믿을 수가 없으니까요.」
			ENDIF
		ENDIF
		;口上が全然カバーしてない＆お堅い雰囲気出したいので基本お断り、ただしアナル経験ありだと揺らぐ感じに
		;実際に動かしてないから数字は適当
	CASE "補正"
		IF K30_CHECK_HEN_T()
			PRINTFORML 「...」
			PRINTFORMDL 에이키는 말없이 당신을 노려본다.
			PRINTFORMDL 이 일을 하기에 더 좋은 날을 골랐어야 했다는 생각이 든다...
			CALL COLORMESSAGE("「이상한 티셔츠」 보정 계수가 적용되었다.", C_YELLOW,1 ,1)
			TFLAG:193 = -1
			RETURN 9999
		ELSEIF TALENT:ヤリマン || TALENT:即落ち
			PRINTFORML (왜...? 왜 나는 %K30_C_NAME(MASTER)%의 제안을 거부할 수 없을까...)
			PRINTFORMDL 에이키는 그녀의 %\@ TALENT:即落ち ? "programmed" instincts... # lewd programming...\@%
			CALL COLORMESSAGE(@"【%\@ TALENT:即落ち ? %GET_TALENTNAME_TR(72, 1)% # %GET_TALENTNAME_TR(142, 1)% \@%】보정 계수가 적용되었다.", C_YELLOW,1 ,1)
			TFLAG:193 = 3
			RETURN -5000
		ELSEIF EXP:Ａ性交経験 >= 50
			PRINTFORML (내가 %K30_C_NAME(MASTER)%'의 제안을 받아들인다면...)
			PRINTFORML (%HE_SHE(MASTER)%가 내 엉덩이를 더욱 기분 좋게 만들어 줄까...?)
			PRINTFORMDL 금지된 쾌락이 에이키의 심장 속으로 꿈틀거리며 파고든다...
			CALL COLORMESSAGE("【항문 발달】보정 계수가 적용되었다.", C_YELLOW,1 ,1)
			TFLAG:193 = 2
			RETURN -200
		ELSEIF EXP:無自覚Ａ経験 >= 50
			PRINTFORMDL 이키는 항문에서 갑작스러운 맥동을 느낀다.
			PRINTFORML (뭐야... 이거...)
			PRINTFORML (나... 무언가를 원하고 있는 건가...?)
			PRINTFORMDL 이키는 자신의 몸에 모르고 새겨진 항문적인 쾌감으로 흔들리고 있었다...
			CALL COLORMESSAGE("「무자각적 분석 발달」 보정 계수 적용되었다.", C_YELLOW,1 ,1)
			TFLAG:193 = 1
			RETURN -100
		ELSE
			IF GETBIT(CFLAG:既成事実, 1)
				PRINTFORML 「...야마로서 그런 유혹에 넘어갈 방법은 없다.」
			ELSE
				PRINTFORML 「...시간 낭비였어.」
			ENDIF
			CALL COLORMESSAGE(@"에이키는 당신의 제안을 단칼에 거절한다.", C_YELLOW,1 ,1)
			TFLAG:193 = -2
			RETURN 9999
		ENDIF
	CASE "成功"
		PRINTFORMW 「...좋다.」
		PRINTFORML 「하지만 오해하지 말아 주길 바란다.」
		PRINTFORML 「나는 그저... 너 같은 무책임한 사람을 못 보고 지나칠 수가 없었다.」
		PRINTFORML 「그래서 나의 몸으로 네 행동을 제지하겠다.」
		PRINTFORMW 「이것은 그저... 어쩔 수 없는 일이다...」
		COM_STR = K30_契約
		CALL K30_WRITE_DIARY(39)
	CASE "失敗"
		IF TFLAG:193 < 0
			PRINTFORML 
			PRINTFORMDL 당신의 제안이 야마의 분노를 산 것 같다.
			CALL GET_ANGRY(30, 1)
		ENDIF
		SELECTCASE TFLAG:193
			CASE -2
				PRINTFORML 「절대 거절한다.」
				PRINTFORMDL 에이키가 짧게 말한다.
			CASE -1
				PRINTFORML 「이런 날에 그런 황당한 소리를 듣다니.」
				PRINTFORML 「제발 오늘만큼은 조금이라도 품위 있게 행동해 주십시오!!」
				PRINTFORMD 그녀의 폭발적인 분노는 일시적으로 에이키의 눈에 빛을 되찾아준다.
			CASE 1, 2
				TIME += 20
				PRINTFORML 「...」
				PRINTFORML 「...그런 하찮은 말을 삼가라.」
				PRINTFORMW 「그런 저속한 행동을 하다 부끄러움이 없는 거냐?」
				PRINTFORML 「내 말 들어라, 너는...」
				PRINTFORML 「...!」
				PRINTFORMW 「이 속도라면 지옥의 고통만이 당신을 기다릴 뿐이다...」
				PRINTFORMDL ...!
				PRINTFORMDL ...!!
				PRINTFORMDL ...!!!
				PRINTFORMDL 당신은 답변 대신 이키에게 강의를 듣게 되었다.
				PRINTFORMD 당신의 제안이 모호하게 거절된 것 같다.
			CASE 3
				PRINTFORMW 「...」
				PRINTFORML 「...이번 한 번은 눈감아 주지.」
				PRINTFORML 「그러니, 부디... 이 대화는 없었던 일로 해줘.」
				PRINTFORMD 에이키는 거절하면서 꽤 갈등하는 듯했다.
		ENDSELECT
ENDSELECT
RETURN 1
