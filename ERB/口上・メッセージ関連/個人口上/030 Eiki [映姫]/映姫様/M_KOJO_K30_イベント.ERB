			ELSE
				LOCAL =  DAY - CFLAG:最後に会った日
				IF TIME:2 < 4 && LOCAL == 1
					PRINTFORML 「%K30_GREETING_EIKI()%, %K30_C_NAME(MASTER)%...」
				ELSE
					PRINTFORML 「%K30_C_NAME(MASTER)%…… 드디어 너를 찾았다……」
				ENDIF
				;朝帰りして本命を連れてきた
				IF K30_FIND_LOVER() == 2
					PRINTFORML 「Ah...」
					PRINTFORMDW 에이키는 당신을 바라보며 복잡한 표정을 짓는다. 그리고 %CALLNAME:(TALENT:MASTER:恋人)%은(는)...
				ELSE
					IF TALENT:恋人
						IF LOCAL == 1
							PRINTFORML 「...어젯밤에 여기 없었잖아...」
						ELSE
							PRINTFORML 「{LOCAL}일 동안 자리를 비웠다니...」
						ENDIF
						PRINTFORMW 「혹시 당신이...?」
						PRINTFORML 「%K30_C_NAME(MASTER)%...」
						PRINTFORMW 「다른 여자들과 시간 보내지 말아줘...」
					ELSE
						IF K30_FIND_LOVER() == 0
							PRINTFORMW 「...우리의 관계는 정확히 무엇일까...?」
							PRINTFORMW 「당신이 아주 인기 많은 사람이라는 건 알지만...」
							PRINTFORMW 「내가 부족한 걸까...?」
						ELSE
							PRINTFORMW 「...%K30_C_NAME(MASTER)%%COND_STR(@", 어제", LOCAL == 1)%, 너는...」
							PRINTFORMW 「...」
							PRINTFORML 「...아니야, 아무것도 아니야.」
							PRINTFORMW 「내가 말할 만한 사람은 아닌 것 같아...」
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			;通常の挨拶
