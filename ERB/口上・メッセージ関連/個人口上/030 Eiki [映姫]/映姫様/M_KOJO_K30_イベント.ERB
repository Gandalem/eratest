@M_KOJO_EVENT_K30_19(ARG,ARG:1)
#DIM 一日一回
;口上主はARG
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	LOCALS = %CSTR:30:80%
	SIF LOCALS == ""
		LOCALS = %MASTERNAME:30%-san
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;認められる
	;記入チェック（=0, 非表示、1, 表示）
