@M_KOJO_EVENT_K30_34(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF !CFLAG:面識 || FLAG:70 || TCVAR:泥酔 || CFLAG:睡眠
		RETURN 1
	SIF ARG >= 11 && !TALENT:恋慕
		RETURN 1
	SELECTCASE ARG
		CASE 1
			;戦闘技能
			PRINTFORML 「아직 더 멀리 도달할 수 있다는 것을 상상하는 것。」
			PRINTFORMW 「결국 매일의 훈련과 성실함의 효과를 과소평해서는 안 된다.」
		CASE 2
			;話術技能
			PRINTFORML 「너무 딱딱하게 말하면 때때로 효과적인 의사소통을 방해할 수 있다.」
			PRINTFORMW 「나도 %K30_C_NAME(MASTER)%에게 배울 점이 있는 것 같다.」
		CASE 3
			;清掃技能
			IF TALENT:恋慕 && GETBIT(CFLAG:30:既成事実, 1)
				IF RAND:2
					PRINTFORML 「%K30_C_NAME(MASTER)%'가 %HIM_HER(MASTER,,1)%로 ... "더럽힌" 후에 주변을 청소하는 습관을 배웠다.」
					PRINTFORMW 「청소를 더 잘하게 되는 건 당연한 일일 거라고 생각한다...」
				ELSE
					PRINTFORML 「뭔가 깨끗하게 치는 데만 더 능숙해진 것 같아...」
					PRINTFORMW 「%K30_C_NAME(MASTER)%와 함께하고 나서 내 몸을 닦고, 우리가 뿌린 모든... 체액들을 문질러 지워내는 것처럼...」
				ENDIF
				PRINTFORML 「...」
				PRINTFORMW 「아, 정말 치정스럽군...」
			ELSE
				PRINTFORML 「...찾아야 할 것을 안다면, 쌓인 먼지와 때를 눈에 띄게 발견하는 것은 분명 쉽다.」
				PRINTFORMW 「%K30_C_NAME(MASTER)%는... 왜 %HE_SHE(MASTER)%가 그렇게 청소에 집착하는지 모르겠군?」
			ENDIF
		CASE 4
			;教養
			PRINTFORML 「세상의 일이나 심지어 저속한 용어들도 점점 이해하게 되었군.」
			PRINTFORML 「혹시 %K30_C_NAME(MASTER)% 때문인 걸까...?」
			PRINTFORMW 「...이 기분에 대해 어떻게 느껴야 할지 모르겠어.」
		CASE 5
