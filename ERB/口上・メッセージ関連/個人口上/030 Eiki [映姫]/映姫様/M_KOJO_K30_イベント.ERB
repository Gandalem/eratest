						ENDIF
						PRINTFORML 「...츄♥」
						PRINTDATAD
							DATAFORM 에이키는 당신에게 입술을 맞춘다.
							DATAFORM 에이키는 당신의 뺨에 손을 댄다.
							DATAFORM 에이키는 부드럽게 당신을 안는다.
						ENDDATA
						PRINTFORMDW  그리고 아침 키스를 해준다.
						IF LOCAL && RAND:5 < 3
							PRINTDATAL
								DATAFORM 「넌 내가 눈을 떼자마자 항상 어딘가로 가버리니까...」
								DATAFORM 「우리가 언제나 함께 있을 수는 없지만...」
							ENDDATA
							PRINTFORMW 「이런 식으로, 우리가 떨어져 있는 시간을 견딜 수 있어...♥」
						ELSE
							PRINTDATAW
								DATAFORM 「음... 오늘 나도 최선을 다할 수 있게 됐어♥」
								DATAFORM 「후후... 이제 제대로 깨어났네♥」
								DATAFORM 「...내가 사랑하는 사람에게 행복을 전하는 것. 이것 또한 덕 있는 삶의 일부야♥」
							ENDDATA
						ENDIF
						;朝から致した
					ELSE
						PRINTFORML 「...뭐 필요한 거 있어? 나 아직, 음... 준비 중이거든.」
						PRINTFORMDL 아침부터 옷을 더럽혀서인지, 에이키는 복장에 좀 어려움을 겪고 있는 듯하다...
					ENDIF
					CFLAG:1605 = 0
				ENDIF
			ENDIF
			RETURN
		ELSEIF FLAG:70 || CFLAG:睡眠 || STRFIND(CSTR:30:1, "おはよう") > -1
			TFLAG:192 = 10
			RETURN
		ENDIF
		CALLF ONCE("おはよう")
		;ファッションブームの日記フラグ
		SIF DIARY:30:7 == 0 && FLAG:ファッション == 62
			CALL K30_WRITE_DIARY(7)
		;ここで不機嫌なら「朝から虫の居所が悪い」反発刻印なければMASTERのせいじゃない
		SIF TALENT:機嫌 == -1 && MARK:反発刻印 == 0
			TCVAR:30:372 = 1
		TFLAG:192 = 10
		;変なＴシャツ
		IF K30_CHECK_HEN_T()
			IF YOUBI_MATCH(DAY, "金")
