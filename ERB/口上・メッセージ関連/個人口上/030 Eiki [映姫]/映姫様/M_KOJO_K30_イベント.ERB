					PRINTFORML 「%K30_GREETING_EIKI()%, %K30_C_NAME(MASTER)%...」
				ELSE
					PRINTFORML 「%K30_C_NAME(MASTER)%... I finally found you...」
				ENDIF
				;朝帰りして本命を連れてきた
				IF K30_FIND_LOVER() == 2
					PRINTFORML 「Ah...」
					PRINTFORMDW Eiki has a complicated expression as she looks at you and %CALLNAME:(TALENT:MASTER:恋人)%...
				ELSE
					IF TALENT:恋人
						IF LOCAL == 1
							PRINTFORML 「...You weren't here last night...」
						ELSE
							PRINTFORML 「For you to have been gone for {LOCAL} days...」
						ENDIF
						PRINTFORMW 「Could it be you're...?」
						PRINTFORML 「%K30_C_NAME(MASTER)%...」
						PRINTFORMW 「Please don't spend time with other women...」
					ELSE
						IF K30_FIND_LOVER() == 0
							PRINTFORMW 「...What exactly is our relationship...?」
							PRINTFORMW 「I know you're a very popular person, but...」
							PRINTFORMW 「Am I, not good enough...?」
						ELSE
							PRINTFORMW 「...%K30_C_NAME(MASTER)%%COND_STR(@", yesterday", LOCAL == 1)%, were you...」
