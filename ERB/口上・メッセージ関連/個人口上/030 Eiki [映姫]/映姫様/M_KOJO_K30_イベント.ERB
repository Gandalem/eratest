			PRINTFORMW 「I know very well that %K30_C_NAME(MASTER)% is quite charming and enjoyable to be with.」
			PRINTFORMW 「However, %K30_C_NAME(MASTER)% and I are already in a relationship. \@ ARG:1 ==113 ? Please withdraw. # Withdraw at once. \@」
			IF ARG:1 == 76
				PRINTFORML 
