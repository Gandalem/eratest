				ELSEIF TALENT:恋慕
					PRINTFORMW 「Would you like to go out somewhere with me, %K30_C_NAME(MASTER)%?」
				ELSE
					PRINTFORMW 「Since we're here, would you like to go somewhere while we're waiting for the banquet?」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 1
		;受けた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			TCVAR:30:358 = 1
			IF K30_CHECK_HEN_T()
				PRINTFORMW 「Thank you very much...」
			ELSEIF TALENT:恋慕
				RESULT = 0
				SIF !GETBIT(CFLAG:1609, 2)
					CALL K30_INSERT_VIBE_DATE
				SIF RESULT
					RETURN 1
				PRINTFORMW 「Fufufu, shall we go then?」
			ELSE
				PRINTFORMW 「Thank you very much.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 2
		;断った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF K30_CHECK_HEN_T()
				PRINTFORMW 「Oh, is that so...」
			ELSEIF TALENT:恋慕
				PRINTFORML 「Haa, now I've got nothing to do for a while...」
				PRINTFORMW 「I guess that's how it is. I suppose I'll just find someone to instruct...」
			ELSE
				PRINTFORMW 「...Is that so.」
				PRINTFORML 「...But of course, it must be bothersome to be dragged around at someone else's convenience.」
				PRINTFORMW 「Please excuse me.」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 3
		;部屋に誘われた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF K30_CHECK_HEN_T()
				PRINTFORMW 「Umm... Would you like to talk for a while in my room?」
			ELSE
				IF TALENT:恋人
					PRINTFORMW 「Would you like to relax in my room?」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「Umm... Would you like to talk for a while in my room?」
				ELSE
					PRINTFORMW 「I have something I'd like to speak to you about in my room.」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 4
		;部屋に誘われたのを受けた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF K30_CHECK_HEN_T()
				PRINTFORMW 「Thank you very much...」
			ELSE
				IF TALENT:恋人
					PRINTFORMW 「In that case, let's go, shall we?♪」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「Thank you very much. Right this way, please.」
				ELSE
					PRINTFORMW 「Thank you very much. Please follow me, then.」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 5
		;部屋に誘われたのを断った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋人
				PRINTFORML 「Hmm, to turn down your lover's request...」
				PRINTFORMW 「Do you have some other business, I wonder...?」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「I see, that's too bad...」
			ELSEIF TALENT:思慕
				PRINTFORMW 「I see. That's too bad...」
			ENDIF
				PRINTFORMW 「Then another time, perhaps.」
			RETURN 1
		ENDIF
	ENDSELECT
ENDIF
RETURN 1

