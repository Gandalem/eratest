@M_KOJO_EVENT_K30_26(ARG,ARG:1)
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
		;見られた瞬間
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
		PRINTFORMW 「Kyaaaaーー!!」
		PRINTFORMDW As if released from some sort of spell, Eiki shrieks like a banshee, completely unlike her usual quiet voice.
		PRINTFORMDW Desperately trying to cover her lower half with her underwear, Eiki starts questioning you.
			IF TALENT:恋慕
				PRINTFORML 「Wh-When did you... How...」
				PRINTFORMW 「D-D-Did you see...? I-It's not what you think! This is...」
			ELSE
				PRINTFORML 「Wh-Why are you even here!!」
				PRINTFORMW 「Just w-walking into a woman's room without permission...」
			ENDIF
			PRINTFORMDW Eiki continues to ramble on with a flustered expression, but after seeing her fully exposed crotch, there's just no authority to her words...
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 1
		;何もしない
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORMW 「Eh... Okay...」
			PRINTFORMDW Stammering out an inane reply, Eiki just continues to stare dumbfounded.
			PRINTFORMW 「What was that... supposed to be about...」
			PRINTFORMW 「How am I supposed to take this...」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 2
		;そのまま続行
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORMDW In her bewilderment, Eiki honestly considers your proposal that she would normally dismiss out of hand.
			IF TALENT:恋慕
				PRINTFORML 「Th-That's right... This way, we can both be satisfied... This is fine.」
				PRINTFORMW 「Even in this form, communication between lovers is a good thing. In that case...」
			ELSE
				PRINTFORML 「Y-Yes, if I continue while you watch, then you become the perpetrator...」
				PRINTFORMW 「Then I'll have something on you, yes, if I just continue...」
			ENDIF
			PRINTFORMDW Eiki is muttering some random unintelligible excuses...
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 3
		;追い出し
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORMW 「I-I-I cannot abide by that!!」
			IF TALENT:恋人
				PRINTFORML 「Th-This is secret practice! Yes! For when we meet next! So I can surprise you!」
				PRINTFORMW 「I'm not doing anything wrong! Because it's a secret! So not even you're allowed to see!」
			ELSEIF TALENT:恋慕
				PRINTFORML 「B-Besides! Y-You shouldn't even be here in the first place!!」
				PRINTFORMW 「Eh, you came because I called your name?」
				PRINTFORMW 「...Oh no, was I... really that loud?」
			ELSE
				PRINTFORML 「I-I know! If I j-just banish you to Hell right now, there's no problem!」
				PRINTFORMDW The supposedly fair and just Yama is saying something completely absurd...
				PRINTFORMW 「Ah, but this person could probably just come right back...」
			ENDIF
			PRINTFORMW 「...A-Anyway, get out of here～～!!」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 4
		;やっちゃう
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			PRINTFORMW 「Eh, what...? What are you doing...? Eh, no, wait, stop...」
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 5
		;事後
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1
			IF TALENT:恋慕 && CFLAG:MASTER:デート中 != MAIN_MAP
				PRINTFORML 「...I think I might get addicted to this...」
				PRINTFORMW 「...That was... amazing♥」
			ELSEIF !TALENT:恋慕
				PRINTFORML 「...Uuu... Why did I...」
				PRINTFORMW 「Why did I... do such a thing...」
			ELSE
				PRINTFORMW 「You're so... forceful today...」
			ENDIF
			CFLAG:1504 = TIME:2
			RETURN 1
		ENDIF
		;-------------------------------------------------
		CASE 6
		;事後お泊り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		PRINTFORMW 「That's right, it would be a waste for you to just go home like this.」
		SIF K30_FIND_LOVER() == 1
			PRINTFORMW 「...Just for today, let's be lovers...」
		PRINTFORMW 「Once we've taken a little break, I'd like your help with something.」
		PRINTFORMW 「And once night falls... Let's continue♥」
		RETURN 1
	ENDSELECT
ENDIF
RETURN 1
