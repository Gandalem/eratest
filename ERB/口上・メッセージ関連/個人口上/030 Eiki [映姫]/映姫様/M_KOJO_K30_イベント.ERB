@M_KOJO_EVENT_K30_30(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	TCVAR:30:376 = 0
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;疲れた
		PRINTFORML 「하아, 하아... 나, 한계야... 나와 함께 해줘서 고마워...」
		PRINTFORMW 「나를 따라와 줘서 고마워...」
		;終了記録
		CALL K30_UFUFU_RECORD
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		;満足して解放
		IF (TALENT:妊娠願望 || GETBIT(CFLAG:1502, 4)) && 充填率(30, 4) > 20 && !TCVAR:ピル
			PRINTFORML 「하아, 하아... 고마워요. 정말... 굉장했어요.」
			PRINTFORML 「여기서 저를 너무 가득 채워주셨어요... 정말 행복해요...♥」
			PRINTFORMDW 에이키는 당신의 정액으로 가득 찬 그녀의 배를 부드럽게 쓰다듬었다.
			PRINTFORMW 「임신하면 좋을 텐데...」
		ELSEIF INRANGE(TCVAR:30:363, -4, -2)
			PRINTFORML 「하아, 하아... 정말 대단했어...♥ 아침부터 이렇게 부지런하다니♥」
			PRINTFORML 「아아, 하지만... 우리 둘 다 온몸이 끈적하고 땀투성이야...」
			PRINTFORMW 「같이 목욕하면서 긴장을 풀래?」
			TCVAR:30:363 = -100
		ELSEIF TALENT:恋慕
			PRINTFORML 「하아, 하아... 후후후, 고마워. 꽤 만족스럽네♪」
			PRINTFORMW 「It seems like you're rather fond of this kind of thing, too.」
		ELSE
			PRINTFORML 「하아, 하아... 오늘은 여기서 그만하자.」
			PRINTFORMW 「...끌고 다니게 해서 미안해. 고마워...」
		ENDIF
		;終了記録
		CALL K30_UFUFU_RECORD
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		TCVAR:30:376 = 1
		;満足したところを押し倒した
		IF TALENT:恋慕
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「...너 정말 인간이니? 사람들이 보통 이렇지는 않은 것 같은데...」
					PRINTFORMDW 에이키는 너의 성적인 지구력에 조금 경악한 듯하다...
				CASE 1
					PRINTFORML 「...이제 막 시작하는 거니?」
					PRINTFORMW 「하지만 나도 이 일에 대한 책임은 좀 져야겠지...」
				CASE 2
					PRINTFORML 「평소에는 이것만으로는 만족하지 못하는 모양이군요...」
					PRINTFORMW 「그렇다면 이제 나의 차례야... 당신의 욕망을 잠재우러...」
			ENDSELECT
		ELSE
			PRINTFORML 「에, 에엣...? 우리... 정말 계속 가야 하는 거야...?」
			PRINTFORML 「나 벌써... 끼아?!」
			PRINTFORMDW 이제 네가 먼저 이키를 누르고 있어...
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;押し倒されフラグ再点灯
		TCVAR:30:376 = 2
		;壊れるまでしてあげる
		PRINTFORML 「...네가 그걸 말해버렸군. 정말 그 말을 진심으로 하는지 한번 보자고?」
		PRINTFORMW 「너는 지옥의 야마의 진정한 힘을 보게 될 거야... 얼마나 버틸 수 있을지 궁금하네♥」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
