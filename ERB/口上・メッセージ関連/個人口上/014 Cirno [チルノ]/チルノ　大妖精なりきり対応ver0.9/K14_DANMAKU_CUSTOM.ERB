; Modular ERB: 個人口上/014 Cirno [チルノ]/チルノ　大妖精なりきり対応ver0.9/K14_DANMAKU_CUSTOM.ERB
;custom code

@K14_DANMAKU_MAIN(ARGS, LIVES)
#DIM LIVES
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		CALL SET_KOJO_COLOR
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	; HANDICAP_FIXED = 0
	; HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		IF K14_DANMAKU_ANGRY
			PRINTFORMDL Cirno는 최대한 화난 표정으로 너를 노려본다.
			PRINTFORML 「우리가 만난 이후로 너는 나에게 늘 못된 행동만 했어.」
			PRINTFORML 「오늘 네가 했던 모든 것에 대해 내가 똑같이 되돌려 줄 거야!」
			PRINTFORMDL 얼음 요정이 너에게 모든 분노를 퍼붓기 직전, 거대한 폭풍이 나타난다.
			PRINTFORMDW 그 힘은 너무나 압도적이어서 그 감각만으로도 거의 너를 부술 정도다.
			RESETCOLOR
			REPEAT 9
			REUSELASTLINE Probability of victory%"." * COUNT%
			TWAIT 100, 1
			REND
			TWAIT 100, 1
			RESETCOLOR
			CALL PRINT_STRW, "Probability of victory........@BOLD@0\%@."
			PRINTFORMDW 
			ABL:[[チルノ]]:戦闘能力 = LIMIT(ABL:[[チルノ]]:戦闘能力, 7, 10)
		ELSEIF CFLAG:[[チルノ]]:1101
			SELECTCASE ABL:[[チルノ]]:戦闘能力
				CASE IS >= 7
					PRINTFORMW 「여기서 누가 가장 강한지 보여주지!」
				CASE 6
					PRINTFORMW 「여기서 너를 쓰러뜨리고 모든 이상향의 지배자가 될 것이다!」
				CASE 5
					PRINTFORMW 「너를 서리 맞은 소고기가 되어 주마!」
				CASEELSE
					PRINTFORML 「다시 붙으러 온 거야?」
					PRINTFORMW 「Fine. I'll show you how strong I've gotten!」
			ENDSELECT
		ELSE
			PRINTFORML 「이 근방에서 누가 가장 강한 요정인지 보여주지!」
			PRINTFORML 「울부짖는 눈보라처럼 혹독한 단마쿠를 사용하고, 흩날리는 벚꽃 사이를 헤쳐 나갈 수 있는 자... 그게 바로 나다!」
			CALL COLORMESSAGE14("　I-I'm not gonna lose!",C_GREEN,2,0)
		ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Setup character values
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "INITIALIZE"
		IF !K14_DANMAKU_INITIALIZED
			CALL K14_DANMAKU_INITIALIZE
			CALL K14_DANMAKU_START_CARD(LIVES)
		ENDIF
	ENDIF
	;-------------------------------------------------
	;Apply Handicap
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "HANDICAP"
		SIF K14_DANMAKU_CARD_TURNS > 0 ;don't trigger on first turn of usage
			CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "ongoing_handicap")
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		IF K14_DANMAKU_CARD_TURNS == 0
			CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "begin")
		ELSE
			CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "ongoing")
		ENDIF
		K14_DANMAKU_CARD_TURNS++
		CALL K14_DANMAKU_DRAW_THERMOMETER
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;being hit, swap spell cards
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE K14_DANMAKU_CARD
			CASE 61
				CALL CHARA_TEXT([[リリーＷ]], "「으악! 아프네. 봄이잖아, 알지?」")
				PRINTFORML 「네가 내 앞을 막았기 때문이야!」
				PRINTFORMDL 시르노는 리리를 쫓아 그녀에게 탄막을 발사한다.
			CASE 62
				CALL CHARA_TEXT([[ラルバ]], @"「우와우. 너 너무 강해, %CALLNAME:MASTER%.」")
				PRINTFORML 「다음엔 더 좋은 연계 기술을 생각해내야 해.」
				PRINTFORMDL 라바는 평소처럼 명랑하게 떠났다.
			CASE 63
				LOCAL = IS_HERE([[静葉]], [[穣子]]) ;both are present
				CALL CHARA_TEXT(LOCAL || IS_HERE([[静葉]]) ? [[静葉]] # [[穣子]], @"「이것으로 요정은 결코 믿을 수 없다는 게 드러나는군.」")
				PRINTFORML 「너야말로 %COND_STR("s", LOCAL)%이 내 앞을 가로막은 거야!」
				CALL CHARA_TEXT(LOCAL || IS_HERE([[穣子]]) ? [[穣子]] # [[静葉]], @"「얼음 요정들은 가을에 어울리지 않아. 그건 상식이야.」")
				PRINTFORMDL 수확의 여신%COND_STR("es", LOCAL)%은(는) 그것을 \@ LOCAL ? 그들의 것 # 그녀의 것으로 \@ 남긴다%COND_STR("s", !LOCAL)% 쓰게.
			CASE 64
				CALL CHARA_TEXT([[レティ]], "「함께 노력하는 것만으로는 부족했던 모양이야.」")
				CALL CHARA_TEXT([[レティ]], @"「너 꽤 잘한다, %CALLNAME:MASTER%. 겨울이 너에게 잘 어울린다.」")
				PRINTFORMDL 레티는 떠난다.
			CASE 65
				CALL CHARA_TEXT([[一輪]], "「재밌었어, 운잔?」")
				CALL CHARA_TEXT([[一輪]], "「요정은 꽤 잘했지 않아?」")
				PRINTFORMDL 이치린과 운잔은 재미를 충분히 본 후 날아간다.
			CASE 66
				CALL CHARA_TEXT([[ルナ]], "「와아아아앙!」")
				CALL CHARA_TEXT([[スター]], "「어머, 우리가 패배한 것 같아.」")
				CALL CHARA_TEXT([[サニー]], "「내가 말했잖아-」")
				PRINTFORMDL 세 요정들은 여전히 서로 다투며 날아간다.
			CASE 67
				PRINTFORMDL 『와아아아아아아아아아아아아아아!!』
				PRINTFORMDL 요정들은 도착했던 것처럼 빠르게 흩어지고 치르노만 남았다.
			CASE 68
				CALL CHARA_TEXT([[お空]], "「...」")
				CALL CHARA_TEXT([[お空]], "「...어라? 나 뭐 하고 있었지.」")
				PRINTFORMDL 우츠호는 여전히 약간 혼란스러워하며 걸어갔다.
			CASEELSE
				SELECTCASE LIVES
					;残り残機3が表示されるのは【洽覧深識】持ちのみ
					CASE 4
						PRINTFORMW 「Eh?」
					CASE 3
						PRINTFORMW 「아야!」
					CASE 2
						PRINTFORMW 「와와와와!」
					CASE 1
						PRINTFORMW 「오우와우!」
					CASE 0
						PRINTFORMW 「꺄아아악!」
				ENDSELECT
		ENDSELECT
		SIF LIVES > 0
			CALL K14_DANMAKU_START_CARD(LIVES)
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		PRINTFORMW 「어때?」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		PRINTFORMW 「이제 좀 동기 부여가 됐어.」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		PRINTFORMW 「나한테는 안 통할 거야.」
	ENDIF
	;King Crimson fail
	LOCAL:1 = 1
	IF LOCAL:1 && ARGS == "エピタフ失敗"
		PRINTDATAW
			DATAFORM 「너무 예측 가능하군.」
			DATAFORM 「그것으로는 물고기조차 놀라게 할 수 없었을 거야.」
			DATAFORM 「남아 있는 결과는 너의 패배뿐이다!」
		ENDDATA
	ENDIF
	;King Crimson success
	LOCAL:1 = 1
	IF LOCAL:1 && ARGS == "エピタフ成功"
		PRINTDATAW
			DATAFORM 「엣? 저게 어디서 나온 거지?」
			DATAFORM 「야, 그거 반칙이잖아!」
			DATAFORM 「어떻게 저런 식으로 움직이는 거야?」
			DATAFORM 「불공평해!」
		ENDDATA
	ENDIF
	;Player loses life
	LOCAL:1 = 1
	IF LOCAL:1 && ARGS == "Pichun"
		PRINTDATAW
			DATAFORM 「내가 얼릴 수 없는 것은 없다!」
			DATAFORM 「얼어 죽어라! 얼어 죽어라!」
			DATAFORM 「멈춰주세요.」
		ENDDATA
	ENDIF
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		IF K14_DANMAKU_ANGRY
			CALL K14_DANMAKU_THE_END(LIVES)
		ELSEIF K14_DANMAKU_CARD == 99 && LIVES > 0
			CALL K14_DANMAKU_FINISH
			CALL K14_DANMAKU_PLAYER_FAINTS
		ELSE
			SELECTCASE ABL:[[チルノ]]:戦闘能力
				CASE 7
					SELECTCASE LIVES
						CASE 5
							PRINTFORMW 「뭐, 강자에게는 당연한 일이겠지.」
						CASE 4
							PRINTFORMW 「내 양말조차 이길 자격이 안 돼.」
						CASE 3
							PRINTFORMW 「이제 누가 가장 강한지 알겠지.」
						CASE 2
							PRINTFORMW 「아무리 열심히 노력해도 가장 강자를 이길 수 없다.」
						CASE 1
							PRINTFORML 「흐읍... 전력이 다 됐어. 집에 가서 잘 거야!」
							PRINTFORMW 「승리했어! 모두 중의 최고야, 해낼 거야!」
						CASE 0
							CALL K14_DANMAKU_STRONGEST_VICTORY
					ENDSELECT
				CASE 6
					SELECTCASE LIVES
						CASE 4
							PRINTFORMW 「너는 내 상대가 될 자격조차 없었다.」
						CASE 3
							PRINTFORMW 「땀 한 방울 흘리지도 못했다.」
						CASE 2
							PRINTFORMW 「다음엔 더 노력해.」
						CASE 1
							PRINTFORMW 「아직 피곤하지도 않아.」
						CASE 0
							PRINTFORML 「오와오오오! 아프다.」
							;complains about the weather if defeated, hinting towards strongest mode
							IF K14_DANMAKU_CIRNO_ORIGINAL_COMBAT < 6
								GOTO NORMAL_END
							ELSEIF !GETBIT(TIME:5, 3) || !GETBIT(TIME:5, 1)
								PRINTFORML 「젠장. 이 날씨에 싸우기엔 너무 더해. 불공평하잖아.」
								PRINTFORMDW 변명하는 것 같지만...
							ELSEIF !K14_DANMAKU_POTENTIAL_UNLEASHED
								PRINTFORML 「젠장. 왜 모든 힘을 다해 싸울 수가 없는 거지?」
								PRINTFORML 「저 이상한 의자 아줌마를 이겼을 때는 훨씬 강했었는데. 불공평하잖아.」
								PRINTFORMDW 아마 오키나가 주변에 있을 때 어떤 일이 일어나는지 보게 될지도 모르겠군...
							ENDIF
					ENDSELECT
				CASEELSE
					$NORMAL_END
					SELECTCASE LIVES
						CASE 4
							PRINTFORMW 「그거 식은 죽이었다.」
						CASE 3
							PRINTFORMW 「치정스럽군, 너는 내 수준에 한참 못 미친다.」
						CASE 2
							PRINTFORMW 「어때? 포기할 거야?!」
						CASE 1
							PRINTFORMW 「난 아직 괜찮아! 이기기는 쉬울 거야!」
						CASE 0
							PRINTFORMW 「오우와와! 오늘은 이만하면 됐다!」
					ENDSELECT
			ENDSELECT
			IF LIVES == 0 && !CFLAG:[[チルノ]]:1101 ;start special training mechanics
				PRINTFORML 「정말 강하구나, %CALLNAME:MASTER%.」
				PRINTFORML 「너에게 패배하는 걸로 내가 최강일 수는 없어.」
				PRINTFORML 「흐음……」
				PRINTFORML 「알겠어. 나도 더 강해져서 너를 완전히 박살 내줄 테니까.」
				PRINTFORML 「기다려봐, 나는 너무 강해질 거야, 그 거대한 두꺼비조차 날 무서워하게 만들 정도로 말이야.」
				PRINTFORMDW 시루노는 결의에 찬 눈빛으로 달려나가며, 요정에게 기대할 수 없었던 투지를 드러냈다.
				CFLAG:[[チルノ]]:1101 = 1
			ENDIF
			;xp bonus
			IF LIVES == 0
				SELECTCASE ABL:[[チルノ]]:戦闘能力
					CASE 6
						EXP:[[チルノ]]:戦闘経験 += 40
					CASE 5
						EXP:[[チルノ]]:戦闘経験 += 20
					CASE 4
						EXP:[[チルノ]]:戦闘経験 += 13
					CASE 3
						EXP:[[チルノ]]:戦闘経験 += 8
					CASE 2
						EXP:[[チルノ]]:戦闘経験 += 5
					CASE 1
						EXP:[[チルノ]]:戦闘経験 += 3
				ENDSELECT
			ENDIF
			CFLAG:[[チルノ]]:1104 = DAY ;fought today
			CFLAG:[[チルノ]]:1102++ ;total losses
			CALL K14_DANMAKU_FINISH
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1

@K14_DANMAKU_INITIALIZE
K14_DANMAKU_PLAYER_POPULARITY = 0
K14_DANMAKU_CIRNO_POPULARITY = 0
K14_DANMAKU_PLAYER_ORIGINAL_COMBAT = ABL:MASTER:戦闘能力
K14_DANMAKU_CIRNO_ORIGINAL_COMBAT = ABL:[[チルノ]]:戦闘能力
K14_DANMAKU_POTENTIAL_UNLEASHED = 0
K14_DANMAKU_ORIGINAL_IMAGE = CFLAG:[[チルノ]]:差し替え適用
VARSET K14_DANMAKU_CARDS_USED
HANDICAP_FIXED = 0
HANDICAP_RAND = 0
K14_DANMAKU_INITIALIZED = 1
IF K14_DANMAKU_ANGRY
	HANDICAP_FIXED = 10000
	HANDICAP_RAND = 10000
ELSE
	CALL K14_DANMAKU_FETCH_AUDIENCE
	CALL K14_DANMAKU_OKINA
	CALL K14_DANMAKU_MOTIVATION
	CALL K14_DANMAKU_ABILITY
	CALL K14_DANMAKU_AUDIENCE_SETUP
ENDIF

@K14_DANMAKU_FINISH
IF K14_DANMAKU_INITIALIZED
	ABL:MASTER:戦闘能力 = K14_DANMAKU_PLAYER_ORIGINAL_COMBAT
	ABL:[[チルノ]]:戦闘能力 = K14_DANMAKU_CIRNO_ORIGINAL_COMBAT
	K14_DANMAKU_INITIALIZED = 0
	CFLAG:[[チルノ]]:弾幕特能 = K14_DANMAKU_CIRNO_ORIGINAL_ABILITY
	CFLAG:[[チルノ]]:差し替え適用 = K14_DANMAKU_ORIGINAL_IMAGE
ENDIF

@K14_DANMAKU_MOTIVATION
#DIM DYNAMIC MOTIVATION
#DIM DYNAMIC WEATHER_INCREASE
SIF K14_DANMAKU_POTENTIAL_UNLEASHED ;ignore motivation if okina draws out her power
	RETURN
SELECTCASE CFLAG:[[チルノ]]:今日の運勢 ;luck
	CASE IS >= 800
		MOTIVATION = 200
	CASE IS >= 600
		MOTIVATION = 100
	CASE IS >= 400
	CASE IS >= 200
		MOTIVATION = -100
	CASEELSE
		MOTIVATION = -200
ENDSELECT
IF TALENT:[[チルノ]]:機嫌 > 0 ;mood
	MOTIVATION += 200
ELSEIF TALENT:[[チルノ]]:機嫌 < 0
	MOTIVATION -= 200
ENDIF
SIF CFLAG:[[チルノ]]:ブチギレ
	MOTIVATION += 200
SIF !EQUIP:[[チルノ]]:下半身下着２
	MOTIVATION += 100
DEBUGPRINTFORML 시르노 동기: {MOTIVATION}
;apply motivation
SELECTCASE ABL:[[チルノ]]:戦闘能力
	CASE 6
		SELECTCASE MOTIVATION
			CASE IS <= -200
				ABL:[[チルノ]]:戦闘能力 = 4
				PRINTFORMDW 에너지 부족으로 인해 치르노는 평소보다 약해졌다!
			CASE IS <= 0
				ABL:[[チルノ]]:戦闘能力 = 5
				PRINTFORMDW 에너지 부족으로 인해 치르노는 평소보다 약해졌다!
		ENDSELECT
	CASE 5
		SELECTCASE MOTIVATION
			CASE IS <= -300
				ABL:[[チルノ]]:戦闘能力 = 3
				PRINTFORMDW 에너지 부족으로 인해 치르노는 평소보다 약해졌다!
			CASE IS <= -100
				ABL:[[チルノ]]:戦闘能力 = 4
				PRINTFORMDW 에너지 부족으로 인해 치르노는 평소보다 약해졌다!
		ENDSELECT
	CASE 4
		SELECTCASE MOTIVATION
			CASE IS >= 400
				ABL:[[チルノ]]:戦闘能力 = 5
				PRINTFORMDW 치르노의 놀라운 동기 부여 덕분에 평소보다 더 강해진다!
			CASE IS <= -300
				ABL:[[チルノ]]:戦闘能力 = 2
				PRINTFORMDW 에너지 부족으로 인해 치르노는 평소보다 약해졌다!
			CASE IS <= -200
				ABL:[[チルノ]]:戦闘能力 = 3
