@K14_WATCHFIGHT, AUDIENCE_MEMBERS
#DIM 集合, キャラクタ数上限, 3 ;集合:X:Y
#DIM 人数                      ;同一マップにいる人数、移動できないキャラも表示され、人数に加算されている
#DIM 入力値                    ;RESULT取得用
#DIM C_ID
#DIM REF AUDIENCE_MEMBERS
SIF CFLAG:MASTER:現在位置 == OMANEKIBEYA()
	RETURN
SIF !AT_HOME(MASTER)
	RETURN
CALL SYUGOS_GETDATA(人数, 集合)
CALL SYUGOS_COST(人数, 集合)
FOR LOCAL, 0, 人数
C_ID = 集合:LOCAL:0
SIF GETBIT(集合:LOCAL:1, 0)
	CONTINUE
CALL MOVEMENT_WILLING(C_ID, CFLAG:MASTER:現在位置)
SIF !RESULT
	CONTINUE
;移動回数が多いと除外
SIF 集合:LOCAL:2 > 6
	CONTINUE
SIF FINDELEMENT(AUDIENCE_MEMBERS, C_ID) == -1
	CONTINUE
CFLAG:C_ID:現在位置 = CFLAG:MASTER:現在位置
PRINTFORMDL %CALLNAME:C_ID%이 나타나 싸움에 관심을 보인다.
NEXT
