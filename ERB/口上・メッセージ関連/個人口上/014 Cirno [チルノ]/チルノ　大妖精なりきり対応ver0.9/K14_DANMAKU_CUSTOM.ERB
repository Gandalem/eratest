                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 8)
                                LOCALS += " while "
                            ELSEIF GROUPMATCH(LOCAL:3, 6, 7)
                                LOCALS += " even if "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF

                        LOCALS += "you seem to have trouble moving in the cold"
                    ENDIF
                CASE 1
                    IF !LOCAL:1
                        LOCALS = You look like a total pushover. Can you even hurt me with those weak bullets?
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 1, 4, 6, 8, 9)
                                LOCALS += "And "
                            ELSEIF GROUPMATCH(LOCAL:2, 0)
                                LOCAL:4 = 1
                            ELSE
                                LOCALS += "But "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 0, 4, 8, 9)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 6, 7)
                                LOCALS += " even if "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF

                        LOCALS:1 = your bullets look pretty weak
                        SIF LOCAL:4
                            LOCALS:1 = %CAPITALIZE(LOCALS:1)%
                        LOCALS += LOCALS:1
                    ENDIF
                CASE 2
                    IF !LOCAL:1
                        LOCALS = Wahooo! Danmaku is the best! I'm full of energy today!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 0, 1)
                            ELSEIF GROUPMATCH(LOCAL:2, 1, 3, 4, 5, 7)
                                LOCALS += "And "
                            ELSEIF GROUPMATCH(LOCAL:2, 6, 8, 9)
                                LOCALS += "Because "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 3, 5, 8)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 7)
                                LOCALS += " because "
                            ELSEIF GROUPMATCH(LOCAL:3, 6)
                                LOCALS += " even if "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF

                        LOCALS += "I'm full of energy today"
                    ENDIF
                CASE 3
                    IF !LOCAL:1
                        LOCALS = Today, I, the great ice fairy, will show you my true power!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 1)
                                LOCALS += "Well, "
                            ELSEIF GROUPMATCH(LOCAL:2, 2, 5, 7)
                                LOCALS += "So "
                            ELSEIF GROUPMATCH(LOCAL:2, 0, 4, 8, 9)
                                LOCALS += "Because "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 1, 4)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 6)
                                LOCALS += " even if "
                            ELSEIF GROUPMATCH(LOCAL:3, 2, 5, 8)
                                LOCALS += " so "
                            ELSEIF GROUPMATCH(LOCAL:3, 7)
                                LOCALS += " because "
                            ELSEIF GROUPMATCH(LOCAL:3, 9)
                                LOCALS += " but even so, "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF

                        LOCALS += "I'll show you my true power today"
                    ENDIF
                CASE 4
                    IF !LOCAL:1
                        LOCALS = You'd better get serious. Weak little attacks will never hurt me!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 0)
                                LOCALS += "Well, "
                            ELSEIF GROUPMATCH(LOCAL:2, 1, 5, 6)
                                LOCALS += "Those "
                            ELSEIF GROUPMATCH(LOCAL:2, 3, 7, 9)
                                LOCALS += "So those "
                            ELSEIF GROUPMATCH(LOCAL:2, 2)
                                LOCALS += "And "
                            ELSEIF GROUPMATCH(LOCAL:2, 8)
                                LOCALS += "Because those "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 0, 1, 2, 9)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 3, 5, 8)
                                LOCALS += " so "
                            ELSEIF GROUPMATCH(LOCAL:3, 6)
                                LOCALS += " even if "
                            ELSEIF GROUPMATCH(LOCAL:3, 7)
                                LOCALS += " because "
                            ENDIF
                        ENDIF

                        LOCALS += "weak little attacks won't do anything to me"
                    ENDIF
                CASE 5
                    IF !LOCAL:1
                        LOCALS = Awesome! I feel like I can keep going and going today!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 0, 1)
                                LOCALS += "Well, "
                            ELSEIF GROUPMATCH(LOCAL:2, 2, 3)
                                LOCALS += "So "
                            ELSEIF GROUPMATCH(LOCAL:2, 4, 7, 9)
                                LOCALS += "And "
                            ELSEIF GROUPMATCH(LOCAL:2, 6, 8)
                                LOCALS += "Because "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 0, 1, 2, 4, 8)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 3, 6, 7)
                                LOCALS += " because "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF

                        LOCALS += "I can keep going and going today"
                    ENDIF
                CASE 6
                    IF !LOCAL:1
                        LOCALS = You'd better not be a sore loser when I beat you down!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 0)
                                LOCAL:4 = 1
                            ELSEIF GROUPMATCH(LOCAL:2, 2, 3, 4, 5, 7, 8, 9)
                                LOCALS += "So "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 1, 2, 3, 4, 5, 7, 8, 9)
                                LOCALS += " so "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF
                        LOCALS:1 = you'd better not be a sore loser
                        SIF LOCAL:4
                            LOCALS:1 = %CAPITALIZE(LOCALS:1)%
                        LOCALS += LOCALS:1
                    ENDIF
                CASE 7
                    IF !LOCAL:1
                        LOCALS = Awright, I got my extra special moves all ready to go!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 0, 1)
                            ELSEIF GROUPMATCH(LOCAL:2, 8)
                            ELSEIF GROUPMATCH(LOCAL:2, 2, 3, 4, 5, 6, 9)
                                LOCALS += "So "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 8)
                            ELSEIF GROUPMATCH(LOCAL:3, 0, 1, 2, 3, 4, 5, 6, 9)
                                LOCALS += " so "
                            ENDIF
                        ENDIF
                        IF LOCAL:2 == 8
                            IF LOCAL:1 == 1
                                LOCALS += "Because they're totally awesome"
                            ELSE
                                LOCALS += " and they're totally awesome"
                            ENDIF
                        ELSE
                            LOCALS += "I hope you're ready for my special moves"
                        ENDIF
                    ENDIF
                CASE 8
                    IF !LOCAL:1
                        LOCALS = You'd better keep on your toes against my special moves, %CALLNAME:MASTER%!
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 0)
                            ELSEIF GROUPMATCH(LOCAL:2, 3)
                                LOCALS += "So "
                            ELSEIF GROUPMATCH(LOCAL:2, 1, 2, 4, 5, 7)
                                LOCALS += "And "
                            ELSEIF GROUPMATCH(LOCAL:2, 6, 9)
                                LOCALS += "Because "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 3, 4, 5, 9)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 0, 1, 2)
                                LOCALS += " so "
                            ELSEIF GROUPMATCH(LOCAL:3, 6, 7, )
                                LOCALS += " because "
                            ENDIF
                        ENDIF

                        LOCALS += "I can see through all your moves already"
                    ENDIF
                CASE 9
                    IF !LOCAL:1
                        LOCALS = Underhanded tricks aren't going to work on me.
                    ELSE
                        IF LOCAL:1 == 1
                            IF GROUPMATCH(LOCAL:2, 4, 7)
                                LOCALS += "And "
                            ELSEIF GROUPMATCH(LOCAL:2, 0, 1)
                                LOCALS += "Because "
                            ELSEIF GROUPMATCH(LOCAL:2, 2, 3, 5)
                                LOCALS += "But "
                            ELSEIF GROUPMATCH(LOCAL:2, 6, 8)
                                LOCALS += "Even if "
                            ELSEIF GROUPMATCH(LOCAL:2, 9)
                                LOCALS += "Especially since "
                            ENDIF
                        ELSE
                            IF GROUPMATCH(LOCAL:3, 0, 1, 4, 8)
                                LOCALS += " and "
                            ELSEIF GROUPMATCH(LOCAL:3, 3, 6, 7)
                                LOCALS += " even if "
                            ELSE
                                LOCALS += " but "
                            ENDIF
                        ENDIF

                        LOCALS += "you're looking a little down"
                    ENDIF
            ENDSELECT
            
            LOCAL:1 ++
            LOCAL:(1+LOCAL:1) = LOCAL
        ENDIF
    NEXT
    SIF LOCAL:1 >= 1
        LOCALS += "."
    CALL SPTALK, [[チルノ]], "笑顔", 0, @"「%LOCALS%」", 1
ENDIF
