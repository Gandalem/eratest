@CALC_COLOR_GRADIENT(COLOR1, COLOR2, STEP)
#FUNCTION
#DIM COLOR1
#DIM COLOR2
#DIM STEP
#DIM RDELTA
#DIM GDELTA
#DIM BDELTA
STEP = LIMIT(STEP, 0, 100)
RDELTA = ((COLOR2 >> 16) & 0xFF) - ((COLOR1 >> 16) & 0xFF)
GDELTA = ((COLOR2 >> 8) & 0xFF) - ((COLOR1 >> 8) & 0xFF)
BDELTA = (COLOR2 & 0xFF) - (COLOR1 & 0xFF)
RETURNF COLOR_FROMRGB(((COLOR1 >> 16) & 0xFF) + RDELTA * STEP / 100, ((COLOR1 >> 8) & 0xFF) + GDELTA * STEP / 100, (COLOR1 & 0xFF) + BDELTA * STEP / 100)

