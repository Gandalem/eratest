@K14_DANMAKU_TEMPERATURE_HANDICAP(DISPLAY)
#DIM CURRENT_TEMP
#DIM DISPLAY
SIF K14_DANMAKU_ANGRY
	RETURN
CURRENT_TEMP = K14_DANMAKU_TEMP()
HANDICAP_FIXED = K14_DANMAKU_CIRNO_POPULARITY - K14_DANMAKU_PLAYER_POPULARITY
IF CURRENT_TEMP < -273
	HANDICAP_FIXED += 1000
ELSEIF CURRENT_TEMP < 0 && !TALENT:MASTER:氷精 || CURRENT_TEMP < -500
	IF ACTIVE_DANMAKU_ITEM == GETNUM(ITEM, "太乙の火種") ;taiyi's live coals
		HANDICAP_FIXED += CURRENT_TEMP / 2 * -1
	ELSE
		HANDICAP_FIXED += CURRENT_TEMP * -1
	ENDIF
ELSE
	;the higher cirno's combat gets, the more resistant to high temperatures she becomes
	IF K14_DANMAKU_POTENTIAL_UNLEASHED
	ELSEIF CURRENT_TEMP <= 50
	ELSEIF CURRENT_TEMP <= 200 && ABL:[[チルノ]]:戦闘能力 >= 4
	ELSEIF CURRENT_TEMP <= 300 && ABL:[[チルノ]]:戦闘能力 >= 5
	ELSE
		HANDICAP_FIXED += CURRENT_TEMP * -1
	ENDIF
ENDIF
SIF !HANDICAP_FIXED ;always set to a value to trigger the "ハンデ" case
	HANDICAP_FIXED = -1
IF DISPLAY
	IF CURRENT_TEMP < 0
		IF TALENT:MASTER:氷精
			PRINTFORMDL 극도로 낮은 온도가 당신의 몸까지 영향을 미친다.
		ELSE
			PRINTFORMDL 추운 기온 때문에 움직이기 어렵다.
		ENDIF
	ELSEIF CURRENT_TEMP > 0 && !K14_DANMAKU_POTENTIAL_UNLEASHED
		IF K14_DANMAKU_POTENTIAL_UNLEASHED
		ELSEIF CURRENT_TEMP <= 200 && ABL:[[チルノ]]:戦闘能力 >= 4
		ELSEIF CURRENT_TEMP <= 300 && ABL:[[チルノ]]:戦闘能力 >= 5
		ELSE
			PRINTFORMDL 서리녀는 더위에 신경 쓰이는 것 같다.
		ENDIF
	ENDIF
ENDIF

@K14_DANMAKU_DRAW_THERMOMETER
;color red to blue, to black
#DIM CURRENT_TEMP
#DIM BAR_COLOR
#DIM BAR_LENGTH
CURRENT_TEMP = K14_DANMAKU_TEMP()
