@K14_DANMAKU_SANGETSUSEI_ATTITUDE()
#FUNCTION
#DIM DYNAMIC TOTAL_FAVORABILITY
#DIM DYNAMIC NUM_PRESENT
FOR LOCAL, [[サニー]], [[スター]] + 1
SIF !IS_HERE(LOCAL)
	CONTINUE
SIF MARK:LOCAL:反発刻印
	RETURNF 2
TOTAL_FAVORABILITY += CFLAG:LOCAL:好感度
NUM_PRESENT++
NEXT
SIF TOTAL_FAVORABILITY / NUM_PRESENT > 1000
	RETURNF 1

@K14_DANMAKU_START_CARD(LIVES)
#DIM LIVES
SIF K14_DANMAKU_CARD == 11 ;learned the trick
	K14_DANMAKU_SAW_ICICLE_FALL = 2
K14_DANMAKU_CARD = K14_DANMAKU_PICK_SPELLCARD(LIVES)
;NAS hack
SIF (FINDELEMENT(K14_DANMAKU_CARDS_USED, 0)) == -1
	VARSET K14_DANMAKU_CARDS_USED
K14_DANMAKU_CARDS_USED:(FINDELEMENT(K14_DANMAKU_CARDS_USED, 0)) = K14_DANMAKU_CARD
CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "init")
K14_DANMAKU_CARD_TURNS = 0

@K14_DANMAKU_PICK_SPELLCARD(LIVES)
#FUNCTION
#DIM LIVES
#DIM DYNAMIC CARD_OPTIONS, 20
#DIM DYNAMIC CARD_INDEX
K14_DANMAKU_CARD_DIFFICULTY = 0
SELECTCASE ABL:[[チルノ]]:戦闘能力
	CASE IS > 6
		SIF LIVES == 1
			RETURNF 99 ;final spell
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 51, 57) ;only use the unique set
	CASE 6
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 41, 47)
	CASE 5
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 41, 47)
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 31, 38)
	CASE 4
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 31, 38)
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 21, 27)
	CASE 3
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 21, 27)
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 11, 15)
	CASE 2
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 11, 15)
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 1, 4)
	CASEELSE
		CALLF K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, 1, 4) ;only basic options
ENDSELECT
IF ABL:[[チルノ]]:戦闘能力 < 7 ;no co-op at maximum level
	SIF IS_HERE([[リリーＷ]]) && DAY:2 == 1
		CARD_OPTIONS:(CARD_INDEX++) = 61
	SIF IS_HERE([[ラルバ]]) && DAY:2 == 2
		CARD_OPTIONS:(CARD_INDEX++) = 62
	SIF (IS_HERE([[静葉]]) || IS_HERE([[穣子]])) && DAY:2 == 3
		CARD_OPTIONS:(CARD_INDEX++) = 63
	SIF IS_HERE([[レティ]]) && DAY:2 == 4
		CARD_OPTIONS:(CARD_INDEX++) = 64
	SIF IS_HERE([[一輪]]) && DAY:2 == 4
		CARD_OPTIONS:(CARD_INDEX++) = 65
	SIF IS_HERE([[サニー]], [[ルナ]], [[スター]])
		CARD_OPTIONS:(CARD_INDEX++) = 66
	SIF IS_HERE([[サニー]], [[ルナ]], [[スター]], [[大妖精]], [[リリーＷ]], [[リリーＢ]], [[クラウンピース]], [[ラルバ]])
		CARD_OPTIONS:(CARD_INDEX++) = 67
	SIF IS_HERE([[お空]])
		CARD_OPTIONS:(CARD_INDEX++) = 68
ENDIF
;clean out previously used cards
FOR LOCAL, 0, 5
SIF !K14_DANMAKU_CARDS_USED:LOCAL
	BREAK
LOCAL:1 = FINDELEMENT(CARD_OPTIONS, K14_DANMAKU_CARDS_USED:LOCAL)
;remove previously played cards to prevent repetition
IF LOCAL:1 >= 0
	ARRAYREMOVE CARD_OPTIONS, LOCAL:1, 1
	CARD_INDEX--
ENDIF
NEXT
IF CARD_INDEX
	RETURNF CARD_OPTIONS:(RAND:CARD_INDEX)
ELSE
	RETURNF 1 ;default to icicle fall if we're ever in an invalid state
ENDIF

@K14_DANMAKU_ADD_CARD_RANGE(CARD_OPTIONS, CARD_INDEX, MINVAL, MAXVAL)
#FUNCTION
#DIM REF CARD_OPTIONS
#DIM REF CARD_INDEX
#DIM MINVAL
#DIM MAXVAL
FOR LOCAL, MINVAL, MAXVAL + 1
CARD_OPTIONS:(CARD_INDEX++) = LOCAL
NEXT

@K14_DANMAKU_SPELLCARD_NAME(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "Ice Sign 「Icicle Fall」 (Easy)"
	CASE 2
		RETURNF "Freeze Sign 「Perfect Freeze」 (Easy)"
	CASE 3
		RETURNF "Ice Sign 「Fairy Spin」"
	CASE 4
		RETURNF "Freeze Sign 「Minus K」"
	CASE 11
		RETURNF "Ice Sign 「Icicle Fall」 (Normal)"
	CASE 12
		RETURNF "Freeze Sign 「Perfect Freeze」 (Normal)"
	CASE 13
		RETURNF "Snow Sign 「Diamond Blizzard」"
	CASE 14
