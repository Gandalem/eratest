@K14_DANMAKU_TEMP()
#FUNCTION
SIF K14_DANMAKU_ANGRY
	RETURNF -500
LOCAL = GET_現在気温() + K14_DANMAKU_TEMPERATURE
SIF ACTIVE_DANMAKU_ITEM == GETNUM(ITEM, "太乙の火種") ;taiyi's live coals
