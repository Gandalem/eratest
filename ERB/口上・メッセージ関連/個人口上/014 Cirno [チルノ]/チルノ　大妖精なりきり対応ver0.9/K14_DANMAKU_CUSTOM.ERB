;custom code
@K14_DANMAKU_MAIN(ARGS, LIVES)
#DIM LIVES
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
    SIF FLAG:口上色
        CALL SET_KOJO_COLOR
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	; HANDICAP_FIXED = 0
	; HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
        IF K14_DANMAKU_ANGRY
            PRINTFORMDL Cirno glares at you as angrily as she can.
            PRINTFORML 「You've been nothing but mean to me ever since we met.」
            PRINTFORML 「Today I'll pay you back for everything you did!」
            PRINTFORMDL As the ice fairy prepares to unleash all her anger towards you, a formidable storm appears.
            PRINTFORMDW So overwhelming is its power that the sensation alone is almost enough to crush you.
            RESETCOLOR
            REPEAT 9
                REUSELASTLINE Probability of victory%"." * COUNT%
                TWAIT 100, 1
            REND
            TWAIT 100, 1
            RESETCOLOR
            CALL PRINT_STRW, "Probability of victory........@BOLD@0\%@."
            PRINTFORMDW 
            ABL:[[チルノ]]:戦闘能力 = LIMIT(ABL:[[チルノ]]:戦闘能力, 7, 10)
        ELSEIF CFLAG:[[チルノ]]:1101
            SELECTCASE ABL:[[チルノ]]:戦闘能力
                CASE IS >= 7
                    PRINTFORMW 「I'll show you who the strongest is here!」
                CASE 6
                    PRINTFORMW 「I'll defeat you here and become the overlord of all Gensokyo!」
                CASE 5
                    PRINTFORMW 「I'll turn you into frosted beef!」
                CASEELSE
                    PRINTFORML 「You here for a rematch?」
                    PRINTFORMW 「Fine. I'll show you how strong I've gotten!」
            ENDSELECT
        ELSE
            PRINTFORML 「I'll show you who's the strongest fairy around here!」
            PRINTFORML 「One that can use Danmaku that's as harsh as the howling blizzard, and weave through the falling cherry blossoms... That's me!」
            CALL COLORMESSAGE14("　I-I'm not gonna lose!",C_GREEN,2,0)
        ENDIF
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Setup character values
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "INITIALIZE"
        IF !K14_DANMAKU_INITIALIZED
            CALL K14_DANMAKU_INITIALIZE
            CALL K14_DANMAKU_START_CARD(LIVES)
        ENDIF
	ENDIF
	;-------------------------------------------------
	;Apply Handicap
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "HANDICAP"
        SIF K14_DANMAKU_CARD_TURNS > 0 ;don't trigger on first turn of usage
            CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "ongoing_handicap")
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
        IF K14_DANMAKU_CARD_TURNS == 0
            CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "begin")
        ELSE
            CALL K14_DANMAKU_PROCESS_SPELLCARD(K14_DANMAKU_CARD, "ongoing")
        ENDIF
        K14_DANMAKU_CARD_TURNS++
        CALL K14_DANMAKU_DRAW_THERMOMETER
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
        ;being hit, swap spell cards
		;別に一律で「やられたー」だけでもいいよ
        SELECTCASE K14_DANMAKU_CARD
            CASE 61
                CALL CHARA_TEXT([[リリーＷ]], "「Ow! That hurt. It's Spring, you know?」")
                PRINTFORML 「It's all because you got in my way!」
                PRINTFORMDL Cirno fires some Danmaku towards Lily to chase her away.
            CASE 62
                CALL CHARA_TEXT([[ラルバ]], @"「Owowow. You're too strong, %CALLNAME:MASTER%.」")
                PRINTFORML 「We should come up with an even better combo move next time.」
                PRINTFORMDL Larva leaves, as cheerful as usual.
            CASE 63
                LOCAL = IS_HERE([[静葉]], [[穣子]]) ;both are present
                CALL CHARA_TEXT(LOCAL || IS_HERE([[静葉]]) ? [[静葉]] # [[穣子]], @"「This just goes to show that you can never trust a fairy.」")
                PRINTFORML 「You're the one%COND_STR("s", LOCAL)% who got in my way!」
                CALL CHARA_TEXT(LOCAL || IS_HERE([[穣子]]) ? [[穣子]] # [[静葉]], @"「Ice fairies don't belong in Autumn. That's just common sense.」")
                PRINTFORMDL The harvest goddess%COND_STR("es", LOCAL)% take\@ LOCAL ? their # s her \@ leave%COND_STR("s", !LOCAL)% bitterly.
            CASE 64
                CALL CHARA_TEXT([[レティ]], "「I guess that even working together wasn't enough.」")
                CALL CHARA_TEXT([[レティ]], @"「You're pretty good, %CALLNAME:MASTER%. Winter suits you well.」")
                PRINTFORMDL Letty takes her leave.
            CASE 65
                CALL CHARA_TEXT([[一輪]], "「Did you have fun, Unzan?」")
                CALL CHARA_TEXT([[一輪]], "「Miss fairy was pretty good, wasn't she?」")
                PRINTFORMDL Ichirin and Unzan fly off, having had their fill of fun.
            CASE 66
                CALL CHARA_TEXT([[ルナ]], "「Waaaaaaahhh!」")
                CALL CHARA_TEXT([[スター]], "「Oh my, it seems we were defeated.」")
                CALL CHARA_TEXT([[サニー]], "「I told you that-」")
                PRINTFORMDL The three fairies fly off, still arguing amongst each other.
            CASE 67
                PRINTFORMDL 『Waaaaaaaaaaaaaaaaahhhhhhh!』
                PRINTFORMDL The fairies scatter as quickly as they arrived, leaving only Cirno behind.
            CASE 68
                CALL CHARA_TEXT([[お空]], "「...」")
                CALL CHARA_TEXT([[お空]], "「...Huh? What was I doing.」")
                PRINTFORMDL Utsuho walks off, still looking a bit befuddled.
            CASEELSE
                SELECTCASE LIVES
                    ;残り残機3が表示されるのは【洽覧深識】持ちのみ
                    CASE 4
                        PRINTFORMW 「Eh?」
                    CASE 3
                        PRINTFORMW 「Ouch!」
                    CASE 2
                        PRINTFORMW 「Wawawawa!」
                    CASE 1
                        PRINTFORMW 「Owowow!」
                    CASE 0
                        PRINTFORMW 「Gyaaaー!」
                ENDSELECT
        ENDSELECT
        SIF LIVES > 0
            CALL K14_DANMAKU_START_CARD(LIVES)
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
        PRINTFORMW 「How'd you like that?」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
        PRINTFORMW 「Now I'm a little motivated.」
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
        PRINTFORMW 「That won't work on me.」
	ENDIF

    ;King Crimson fail
	LOCAL:1 = 1
    IF LOCAL:1 && ARGS == "エピタフ失敗"
        PRINTDATAW
			DATAFORM 「Sooo predictable.」
			DATAFORM 「You couldn't even surprise a fish with that.」
			DATAFORM 「The only result that remains is your defeat!」
		ENDDATA
    ENDIF

    ;King Crimson success
    LOCAL:1 = 1
    IF LOCAL:1 && ARGS == "エピタフ成功"
        PRINTDATAW
			DATAFORM 「Eh? Where did that come from?」
			DATAFORM 「Hey, that's cheating!」
			DATAFORM 「How do you move like that?」
			DATAFORM 「Not fair!」
		ENDDATA
    ENDIF

    ;Player loses life
    LOCAL:1 = 1
    IF LOCAL:1 && ARGS == "Pichun"
        PRINTDATAW
			DATAFORM 「There is nothing I can't freeze!」
			DATAFORM 「Freeze to death! Freeze to death!」
			DATAFORM 「Freeze excuse me.」
		ENDDATA
    ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利

        IF K14_DANMAKU_ANGRY
            CALL K14_DANMAKU_THE_END(LIVES)
        ELSEIF K14_DANMAKU_CARD == 99 && LIVES > 0
            CALL K14_DANMAKU_FINISH
            CALL K14_DANMAKU_PLAYER_FAINTS
        ELSE
            SELECTCASE ABL:[[チルノ]]:戦闘能力
                CASE 7
                    SELECTCASE LIVES
                        CASE 5
                            PRINTFORMW 「Well, that's only to be expected for the strongest.」
                        CASE 4
                            PRINTFORMW 「You're not even good enough to beat my socks.」
                        CASE 3
                            PRINTFORMW 「Now you know who the strongest is.」
                        CASE 2
                            PRINTFORMW 「No matter how hard you try, you can't beat the strongest.」
                        CASE 1
                            PRINTFORML 「Oof... I'm out of power. I'm heading home and going to sleep!」
                            PRINTFORMW 「I am triumphant! Strongest of them all, comin' through!」
                        CASE 0
                            CALL K14_DANMAKU_STRONGEST_VICTORY
                    ENDSELECT
                CASE 6
                    SELECTCASE LIVES
                        CASE 4
                            PRINTFORMW 「You weren't even worthy as my opponent.」
                        CASE 3
                            PRINTFORMW 「Didn't even break a sweat.」
                        CASE 2
                            PRINTFORMW 「Try harder next time.」
                        CASE 1
                            PRINTFORMW 「I'm not even tired yet.」
                        CASE 0
                            PRINTFORML 「Owowowowow! That hurts.」
                            ;complains about the weather if defeated, hinting towards strongest mode
                            IF K14_DANMAKU_CIRNO_ORIGINAL_COMBAT < 6
                                GOTO NORMAL_END
                            ELSEIF !GETBIT(TIME:5, 3) || !GETBIT(TIME:5, 1)
                                PRINTFORML 「Dang it. It's way too hot to fight in this weather. It's not fair.」
                                PRINTFORMDW Sounds like she's just making excuses, but...
                            ELSEIF !K14_DANMAKU_POTENTIAL_UNLEASHED
                                PRINTFORML 「Dang it. Why can't I fight with all my power?」
                                PRINTFORML 「I was way stronger when I beat that weird chair lady. It's not fair.」
                                PRINTFORMDW Maybe you should see what happens if Okina's around...
                            ENDIF
                    ENDSELECT
                CASEELSE
                    $NORMAL_END
                    SELECTCASE LIVES
                        CASE 4
                            PRINTFORMW 「That was a piece of cake.」
                        CASE 3
                            PRINTFORMW 「What a shame, you're nowhere near my level.」
                        CASE 2
                            PRINTFORMW 「How's that? Do ya give up?!」
                        CASE 1
                            PRINTFORMW 「I'm still alright! Winning'll be easy!」
                        CASE 0
                            PRINTFORMW 「Owowow! That's enough for today!」
                    ENDSELECT
            ENDSELECT
            IF LIVES == 0 && !CFLAG:[[チルノ]]:1101 ;start special training mechanics
                PRINTFORML 「Man, you're so strong, %CALLNAME:MASTER%.」
                PRINTFORML 「I can't be the strongest if I let myself be defeated by you.」
                PRINTFORML 「Hmmmmmmmmmm...」
                PRINTFORML 「I've got it. I'm gonna get stronger, too, and then I'll pound you into a pulp.」
                PRINTFORML 「Just you wait, I'm going to get so strong, even that giant toad will be afraid of me.」
                PRINTFORMDW Cirno runs off with a glint of determination in her eye, expressing a drive you never expected from a fairy.
                CFLAG:[[チルノ]]:1101 = 1
            ENDIF
            ;xp bonus
            IF LIVES == 0
                SELECTCASE ABL:[[チルノ]]:戦闘能力
                    CASE 6
                        EXP:[[チルノ]]:戦闘経験 += 40
                    CASE 5
                        EXP:[[チルノ]]:戦闘経験 += 20
                    CASE 4
                        EXP:[[チルノ]]:戦闘経験 += 13
                    CASE 3
                        EXP:[[チルノ]]:戦闘経験 += 8
                    CASE 2
                        EXP:[[チルノ]]:戦闘経験 += 5
                    CASE 1
                        EXP:[[チルノ]]:戦闘経験 += 3
                ENDSELECT
            ENDIF
            CFLAG:[[チルノ]]:1104 = DAY ;fought today
            CFLAG:[[チルノ]]:1102++ ;total losses
            CALL K14_DANMAKU_FINISH
        ENDIF
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

@K14_DANMAKU_INITIALIZE
K14_DANMAKU_PLAYER_POPULARITY = 0
K14_DANMAKU_CIRNO_POPULARITY = 0
K14_DANMAKU_PLAYER_ORIGINAL_COMBAT = ABL:MASTER:戦闘能力
K14_DANMAKU_CIRNO_ORIGINAL_COMBAT = ABL:[[チルノ]]:戦闘能力
K14_DANMAKU_POTENTIAL_UNLEASHED = 0
K14_DANMAKU_ORIGINAL_IMAGE = CFLAG:[[チルノ]]:差し替え適用
VARSET K14_DANMAKU_CARDS_USED
HANDICAP_FIXED = 0
HANDICAP_RAND = 0
K14_DANMAKU_INITIALIZED = 1

IF K14_DANMAKU_ANGRY
    HANDICAP_FIXED = 10000
    HANDICAP_RAND = 10000
ELSE
    CALL K14_DANMAKU_FETCH_AUDIENCE
    CALL K14_DANMAKU_OKINA
    CALL K14_DANMAKU_MOTIVATION
    CALL K14_DANMAKU_ABILITY
    CALL K14_DANMAKU_AUDIENCE_SETUP
ENDIF


@K14_DANMAKU_FINISH
IF K14_DANMAKU_INITIALIZED
    ABL:MASTER:戦闘能力 = K14_DANMAKU_PLAYER_ORIGINAL_COMBAT
    ABL:[[チルノ]]:戦闘能力 = K14_DANMAKU_CIRNO_ORIGINAL_COMBAT
    K14_DANMAKU_INITIALIZED = 0
    CFLAG:[[チルノ]]:弾幕特能 = K14_DANMAKU_CIRNO_ORIGINAL_ABILITY
    CFLAG:[[チルノ]]:差し替え適用 = K14_DANMAKU_ORIGINAL_IMAGE
ENDIF

@K14_DANMAKU_MOTIVATION
#DIM DYNAMIC MOTIVATION
#DIM DYNAMIC WEATHER_INCREASE
SIF K14_DANMAKU_POTENTIAL_UNLEASHED ;ignore motivation if okina draws out her power
    RETURN

SELECTCASE CFLAG:[[チルノ]]:今日の運勢 ;luck
    CASE IS >= 800
        MOTIVATION = 200
    CASE IS >= 600
        MOTIVATION = 100
    CASE IS >= 400
    CASE IS >= 200
        MOTIVATION = -100
    CASEELSE
        MOTIVATION = -200
ENDSELECT

IF TALENT:[[チルノ]]:機嫌 > 0 ;mood
    MOTIVATION += 200
ELSEIF TALENT:[[チルノ]]:機嫌 < 0
    MOTIVATION -= 200
ENDIF
SIF CFLAG:[[チルノ]]:ブチギレ
    MOTIVATION += 200
SIF !EQUIP:[[チルノ]]:下半身下着２
    MOTIVATION += 100

DEBUGPRINTFORML Cirno motivation: {MOTIVATION}
;apply motivation
SELECTCASE ABL:[[チルノ]]:戦闘能力
    CASE 6
        SELECTCASE MOTIVATION
            CASE IS <= -200
                ABL:[[チルノ]]:戦闘能力 = 4
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
            CASE IS <= 0
                ABL:[[チルノ]]:戦闘能力 = 5
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
        ENDSELECT
    CASE 5
        SELECTCASE MOTIVATION
            CASE IS <= -300
                ABL:[[チルノ]]:戦闘能力 = 3
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
            CASE IS <= -100
                ABL:[[チルノ]]:戦闘能力 = 4
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
        ENDSELECT
    CASE 4
        SELECTCASE MOTIVATION
            CASE IS >= 400
                ABL:[[チルノ]]:戦闘能力 = 5
                PRINTFORMDW Cirno's amazing motivation makes her stronger than usual!
            CASE IS <= -300
                ABL:[[チルノ]]:戦闘能力 = 2
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
            CASE IS <= -200
                ABL:[[チルノ]]:戦闘能力 = 3
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
        ENDSELECT
    CASE 3
        SELECTCASE MOTIVATION
            CASE IS >= 400
                ABL:[[チルノ]]:戦闘能力 = 5
                PRINTFORMDW Cirno's incredible motivation makes her much stronger than usual!
            CASE IS >= 200
                ABL:[[チルノ]]:戦闘能力 = 4
                PRINTFORMDW Cirno's amazing motivation makes her stronger than usual!
            CASE IS <= -300
                ABL:[[チルノ]]:戦闘能力 = 2
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
        ENDSELECT
    CASE 2
        SELECTCASE MOTIVATION
            CASE IS >= 400
                ABL:[[チルノ]]:戦闘能力 = 4
                PRINTFORMDW Cirno's incredible motivation makes her much stronger than usual!
            CASE IS >= 200
                ABL:[[チルノ]]:戦闘能力 = 3
                PRINTFORMDW Cirno's amazing motivation makes her stronger than usual!
            CASE IS <= -300
                ABL:[[チルノ]]:戦闘能力 = 1
                PRINTFORMDW Due to a lack of energy, Cirno is left weaker than usual!
        ENDSELECT
    CASEELSE
        SELECTCASE MOTIVATION
            CASE IS >= 300
                ABL:[[チルノ]]:戦闘能力 = 3
                PRINTFORMDW Cirno's incredible motivation makes her much stronger than usual!
            CASE IS >= 100
                ABL:[[チルノ]]:戦闘能力 = 2
                PRINTFORMDW Cirno's amazing motivation makes her stronger than usual!
        ENDSELECT
ENDSELECT

WEATHER_INCREASE = 0
;apply weather
SELECTCASE ABL:[[チルノ]]:戦闘能力
    CASE 6
        IF GETBIT(TIME:5, 3)
        ELSEIF DAY:2 == 2 ;can only go down
            IF INRANGE(TIME:2, 2, 4)
                IF TIME:5 == 1 ;strong sunlight
                    WEATHER_INCREASE = -1
                ENDIF
            ENDIF
        ENDIF
    CASE 5
        IF GETBIT(TIME:5, 3) && GETBIT(TIME:5, 1) ;only in snowstorm at this stage
            WEATHER_INCREASE = 1
        ELSEIF DAY:2 == 2
            IF INRANGE(TIME:2, 2, 4)
                IF GROUPMATCH(TIME:5, 0, 1) ;sunlight
                    WEATHER_INCREASE = -1
                ENDIF
            ENDIF
        ENDIF
    CASE 4
        IF GETBIT(TIME:5, 3) ;increases with snow, but only one stage at most
            WEATHER_INCREASE = 1
        ELSEIF DAY:2 == 2
            IF INRANGE(TIME:2, 2, 4)
                IF TIME:5 == 1 ;strong sunlight
                    WEATHER_INCREASE = -2
                ELSEIF GROUPMATCH(TIME:5, 0, 2) ;sunlight, light clouds
                    WEATHER_INCREASE = -1
                ENDIF
            ENDIF
        ENDIF
    CASE 3, 2
        IF GETBIT(TIME:5, 3) ;increases with snow and snowstorm
            WEATHER_INCREASE = 1
            SIF GETBIT(TIME:5, 1)
                WEATHER_INCREASE = 2
        ELSEIF DAY:2 == 2
            IF INRANGE(TIME:2, 2, 4)
                IF TIME:5 == 1 ;strong sunlight
                    WEATHER_INCREASE = -2
                ELSEIF GROUPMATCH(TIME:5, 0, 2) ;sunlight, light clouds
                    WEATHER_INCREASE = -1
                ENDIF
            ENDIF
        ENDIF
    CASE 1
        IF GETBIT(TIME:5, 3) ;increases with snow and snowstorm
            WEATHER_INCREASE = 1
            SIF GETBIT(TIME:5, 1)
                WEATHER_INCREASE = 2
        ENDIF
ENDSELECT

ABL:[[チルノ]]:戦闘能力 += WEATHER_INCREASE
ABL:[[チルノ]]:戦闘能力 = LIMIT(ABL:[[チルノ]]:戦闘能力, 1, 7)
IF WEATHER_INCREASE > 0
    IF GETBIT(TIME:5, 1)
        PRINTFORMDW Cirno draws power from the snowstorm!
    ELSE
        PRINTFORMDW Cirno draws power from the snow!
    ENDIF
ELSEIF WEATHER_INCREASE < 0
    PRINTFORMDW Cirno is unable to fight at full power due to the \@ WEATHER_INCREASE == -2 ? extreme # sweltering \@ summer heat!
ENDIF

DEBUGPRINTFORML Cirno's current combat ability: {ABL:[[チルノ]]:戦闘能力}.

@K14_DANMAKU_ABILITY
#DIM DYNAMIC ROLLS_REMAINING
VARSET LOCAL
K14_DANMAKU_CIRNO_ORIGINAL_ABILITY = CFLAG:[[チルノ]]:弾幕特能
IF ABL:[[チルノ]]:戦闘能力 >= 6
    CFLAG:[[チルノ]]:弾幕特能 = 1023 ;every ability
ELSEIF ABL:[[チルノ]]:戦闘能力 > 1
    ;roll abilities from a pool
    CFLAG:[[チルノ]]:弾幕特能 = 0
    IF ABL:[[チルノ]]:戦闘能力 >= 2
        LOCAL:2 = 1
        LOCAL:3 = 1
        LOCAL:8 = 1
        ROLLS_REMAINING = 1
    ENDIF
    IF ABL:[[チルノ]]:戦闘能力 >= 3
        LOCAL:1 = 1
        LOCAL:7 = 1
        LOCAL:9 = 1
        ROLLS_REMAINING = 2
    ENDIF
    IF ABL:[[チルノ]]:戦闘能力 >= 4
        LOCAL:0 = 1
        LOCAL:6 = 1
    ENDIF
    IF ABL:[[チルノ]]:戦闘能力 >= 5
        LOCAL:5 = 1
        LOCAL:4 = 1
        ROLLS_REMAINING = 3
    ENDIF

    WHILE ROLLS_REMAINING > 0
        LOCAL:10 = ARRAY_HIT(LOCAL, 10)
        IF !GETBIT(CFLAG:[[チルノ]]:弾幕特能, LOCAL:10)
            SETBIT CFLAG:[[チルノ]]:弾幕特能, LOCAL:10
            LOCAL:(LOCAL:10) = 0
            ROLLS_REMAINING--
        ENDIF
    WEND
ENDIF

[IF_DEBUG]
LOCALS =
IF CFLAG:[[チルノ]]:弾幕特能 == 1023
    DEBUGPRINTFORML Cirno has every Danmaku ability.
ELSE
    FOR LOCAL, 0, 10
        IF GETBIT(CFLAG:[[チルノ]]:弾幕特能, LOCAL)
            LOCALS += @"%DANMAKU_ABILITY_TR(LOCAL)%、"
        ENDIF
    NEXT
    DEBUGPRINTFORML Cirno's Danmaku abilities are now %LIST_IN_STRING(LOCALS)%.
ENDIF
[ENDIF]

CALL SET_KOJO_COLOR([[チルノ]])
;print vague description of which abilities cirno currently has
IF CFLAG:[[チルノ]]:弾幕特能 == 1023
    CALL SPTALK, [[チルノ]], "笑顔", 0, "「I feel amazing! It's like I can't lose to anyone right now!」", 1
ELSE
    VARSET LOCALS
    LOCAL:1 = 0  ;stage
