;==================================================
;相手からデートのお誘い
;==================================================
@M_KOJO_EVENT_K14_27(ARG,ARG:1)
;口上主はLOCAL
;ARG:1は目的地
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
		SELECTCASE ARG
			;-------------------------------------------------
			CASE 0
			;誘い文句
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
			;自分用メモ。そもそも恋慕じゃないと発生しない？
				IF TALENT:思慕
					CALL COLORMESSAGE14("「DaーiーChaーnー!」",C_AQUA,1,0)
					PRINTFORMW 「LーeーtーsーPーlーaーyー!」
				ELSE
					PRINTFORML 「Isn't today a good day to go exploring?」
					PRINTFORMW 「I'll take you with me as a partner.」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
			CASE 1
			;受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:思慕
					CALL COLORMESSAGE14("「Yay! Dai-chan's coming with me ♪」",C_AQUA,1,0)
					CALL COLORMESSAGE14("　I'll have to pack a lunch... Tissues... A handkerchief...",C_GREEN,1,0)
					CALL COLORMESSAGE14("「Dai-chan hurry, hurry! I can't wait!」",C_AQUA,1,0) 
					CALL COLORMESSAGE14("　Fufu, it's okay, I'm not going to run away so you don't need to panic.",C_GREEN,1,0) 
					PRINTFORMW 「Hurry up! I can't wait any longer!」
				ELSE
					PRINTFORML 「Good, follow me quietly!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
			CASE 2
			;断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:思慕
					PRINTFORML 「Even though I'm inviting you... Booー...」
					CALL COLORMESSAGE14("　Sorry. There's something I have to do today...",C_GREEN,1,0) 
					CALL COLORMESSAGE14("「Ehー... I wanted to come along with you...」",C_AQUA,1,0) 
					CALL COLORMESSAGE14("　Let's play together next time, okay?",C_GREEN,1,0)
					CALL COLORMESSAGE14("「Don't forget, okay? Don't you dare forget!」",C_AQUA,1,0) 
					PRINTFORMW 
				ELSE
					PRINTFORML 「Hmph! I won't invite you next time!」
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
			CASE 3
			;部屋に誘われた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
			;-------------------------------------------------
			CASE 4
			;部屋に誘われたのを受けた
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
			;-------------------------------------------------
			CASE 5
			;部屋に誘われたのを断った
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				RETURN 1
			ENDIF
		ENDSELECT
ENDIF
RETURN 1

