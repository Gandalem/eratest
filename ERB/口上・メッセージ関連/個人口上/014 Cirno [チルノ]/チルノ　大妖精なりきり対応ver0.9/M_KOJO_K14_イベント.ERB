;==================================================
;お仕事中
;==================================================
@M_KOJO_EVENT_K14_13(ARG,ARG:1)
;口上主はTARGET
;ARG:1に残っている仕事量
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;仕事開始（職場へ移動する）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1

		IF IS_WEEKEND(DAY)
			;土日は三妖精の家で遊ぶ
				PRINTFORML 「Ah! Today I promised to play with the three fairies.」
				PRINTFORMW 「Today I'll get my revenge!」
		ELSEIF TIME:5 == 8
		;朝起きて、雪が降っていると湖畔で遊ぶ
			PRINTFORML 「It's snowingー!! Let's go and play in the snowー!」 
			PRINTFORMW 「Running around and having fun isn't some dogs speciality, it's an ice fairies!」
		ELSEIF (DAY:2 == 2 && TIME:5 < 2)
		;夏晴れ晴天なら人間の里でアイス屋
			PRINTFORML 「Ugh～... This heat, it makes you... want to have ice cream, right?」
			PRINTFORMW 「I can't deal with this. Gotta go sell some ice cream right now.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:318 == 1
			PRINTFORMW 
		ELSEIF CFLAG:MASTER:現在位置 == 5 || CFLAG:MASTER:現在位置 == 32
		;土日は三妖精の家で遊ぶ
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Alright, follow me!」
				CASE 0
					PRINTFORML 「I'll play the hero next time!」
				CASEELSE
					PRINTFORML 「What'll we play this time?」 
			ENDSELECT
		ELSEIF CFLAG:MASTER:現在位置 == 343
		;朝起きて、雪が降っていると湖畔で遊ぶ
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Maybe it's time for the long-awaited snow house expansion...?」
					;Possible mistranslation.. Alt: "Snow's pretty rare around here. Wonder if I should expand my igloo...?"
				CASE 0
					PRINTFORML 「I'm gonna cover the floor here in slippery ice and make someone fall over!」
				CASEELSE
					PRINTFORML 「Snow is falling～ ♪ Kitsune are falling～ ♪ They're falling～ They're falling～ And I'm starving～ ♪」 
					PRINTFORML 「Dogs are tottering～ ♪ Chickens are going "Cock-a-doodle-doo"! ♪ And the cats curl up into ballsー ♪」
			ENDSELECT
		ELSEIF CFLAG:MASTER:現在位置 == 2 || CFLAG:MASTER:現在位置 == 202
		;夏晴れ晴天なら人間の里でアイス屋
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Ice cream! Ice cream! Wouldn't ya like an ice cream!」 
					PRINTFORML 「We've got the strongest ice creamー Cirno approved!」 
				CASE 0
					PRINTFORML 「Ughー... So hotー...」
					PRINTFORML 「This ice cream's deliciousー...」Lick lick
				CASEELSE
					PRINTFORML 「Get a winning popsicle and you get another one freeー」 
					
			ENDSELECT
		ENDIF

		RETURN 1
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 2 || CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 202
			PRINTFORMW 「That's all for today!」
		ELSE
			PRINTFORMW 「Ahー... That was fun!」
		RETURN 1
		ENDIF
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1

