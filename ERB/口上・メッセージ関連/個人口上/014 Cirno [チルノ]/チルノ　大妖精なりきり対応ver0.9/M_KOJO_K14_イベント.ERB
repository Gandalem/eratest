@M_KOJO_EVENT_K14_13(ARG,ARG:1)
;口上主はTARGET
;ARG:1に残っている仕事量
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;仕事開始（職場へ移動する）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF IS_WEEKEND(DAY)
			;土日は三妖精の家で遊ぶ
			PRINTFORML 「아! 오늘 나는 세 요정들과 놀기로 약속했다.」
			PRINTFORMW 「오늘 내가 복수할 것이다!」
		ELSEIF TIME:5 == 8
			;朝起きて、雪が降っていると湖畔で遊ぶ
			PRINTFORML 「눈이 온다―!! 눈밭에 가서 놀자―!」 
			PRINTFORMW 「뛰어놀며 즐거워하는 건 개들의 특기가 아니라, 얼음 요정들이지!」
		ELSEIF (DAY:2 == 2 && TIME:5 < 2)
			;夏晴れ晴天なら人間の里でアイス屋
			PRINTFORML 「휴~... 이 더위는 사람을... 아이스크림이라 먹고 싶게 만들지, 그렇지?」
			PRINTFORMW 「이건 못 참겠어. 당장 아이스크림이나 팔러 가야겠다.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;業務中
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:318 == 1
			PRINTFORMW 
		ELSEIF CFLAG:MASTER:現在位置 == 5 || CFLAG:MASTER:現在位置 == 32
			;土日は三妖精の家で遊ぶ
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「좋아, 나 따라와!」
				CASE 0
					PRINTFORML 「다음엔 내가 영웅을 해볼게!」
				CASEELSE
					PRINTFORML 「이번엔 뭘 할까?」 
			ENDSELECT
		ELSEIF CFLAG:MASTER:現在位置 == 343
			;朝起きて、雪が降っていると湖畔で遊ぶ
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「어쩌면 오랫동안 기다려온 눈집 확장 시간일지도...?」
					;Possible mistranslation.. Alt: "Snow's pretty rare around here. Wonder if I should expand my igloo...?"
				CASE 0
					PRINTFORML 「여기 미끄러운 얼음을 깔고 누군가 넘어지게 만들 거야!」
				CASEELSE
					PRINTFORML 「눈이 내리고~♪ 여우들이 떨어지고~♪ 그들은 떨어지고~ 그들은 떨어지고~ 그리고 나는 배가 고프다~♪」 
					PRINTFORML 「개들이 비틀거린다~♪ 닭들이 "꼬끼오!"라고 울고~♪ 그리고 고양이들은 공처럼 몸을 웅크린다ー♪」
			ENDSELECT
		ELSEIF CFLAG:MASTER:現在位置 == 2 || CFLAG:MASTER:現在位置 == 202
			;夏晴れ晴天なら人間の里でアイス屋
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「아이스크림이야! 아이스크림! 아이스크림 먹어보는 게 어때!」 
					PRINTFORML 「우리가 제일 강력한 아이스크림을 가졌어—시르노가 승인했지!」 
				CASE 0
					PRINTFORML 「으음~... 너무 더워~...」
					PRINTFORML 「이 아이스크림 맛있다~...」 핥는 소리
				CASEELSE
					PRINTFORML 「승리한 아이스크림을 얻으면 하나가 더 무료로 주어진다-」 
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;仕事終了
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 2 || CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 202
			PRINTFORMW 「오늘은 여기까지야!」
		ELSE
			PRINTFORMW 「아아... 재미있었다!」
			RETURN 1
		ENDIF
	ENDIF
	;その他
	PRINTFORML  
ENDIF
RETURN 1
