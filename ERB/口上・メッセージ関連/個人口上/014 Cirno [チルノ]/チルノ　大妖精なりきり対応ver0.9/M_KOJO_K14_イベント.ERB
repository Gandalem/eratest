@COLORMESSAGE14(ARGS,色,表示形式,フォントスタイル)
;-------------------------------------------------
;直前まで使用していた色とフォントを保存し、使用後はそちらに復帰するように
;表示形式　0=通常　1=L　2=W
;フォントスタイル　0=通常　1=太字　2=斜体　4=打ち消し線　8=下線
;(ビットで管理されているため例えば3なら太字＋斜体)
#DIM 現在指定の色
#DIM 現在指定のフォントスタイル
#DIM 色
#DIM フォントスタイル
#DIM 表示形式
現在指定の色 = GETCOLOR()
現在指定のフォントスタイル = GETSTYLE()
SIF フォントスタイル
	FONTSTYLE フォントスタイル
SETCOLOR 色
IF FLAG:なりきり == [[大妖精]] || CFLAG:14:1001 == 1
	;大妖精のなりきり、または口上を全て表示する設定のみ文章が表示される。
	SELECTCASE 表示形式
		CASE 0
			PRINTFORM %ARGS%
		CASE 1
			PRINTFORML %ARGS%
		CASE 2
			PRINTFORMW %ARGS%
	ENDSELECT
ENDIF
SETCOLOR 現在指定の色
FONTSTYLE 現在指定のフォントスタイル
;-------------------------------------------------
;custom code

@UNIQUE_COM_アイスを買う_TR
#DIM アイスねだん
#DIM パックねだん
LOCAL = 0
gLineCount = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - gLineCount > 0
	CLEARLINE LINECOUNT - gLineCount
SELECTCASE DAY:2
	CASE 1
		アイスねだん = 400
	CASE 2
		アイスねだん = 500
	CASE 3
		アイスねだん = 300
	CASE 4
		アイスねだん = 200
ENDSELECT
パックねだん = アイスねだん * 9
DRAWLINE
CALL SPTALK, [[チルノ]], "通常", 1, @"「아이스크림 사러 왔니? 개당 {アイスねだん}엔이야.」", 1
IF MONEY < アイスねだん
	CALL COLORMESSAGE14(@"　아아... 돈이 충분하지 않네...",C_GREEN,2,0)
ELSE
	CALL COLORMESSAGE14(@"　저 아이스크림 맛있어 보이네... 돈은 충분한데 하나 사야 할까?",C_GREEN,2,0)
ENDIF
RESETCOLOR
PRINTFORML 금액: %金額表示(MONEY)%
DRAWLINE
CALL EX_SHOPPING(GETNUM(ITEM, "アイス"), "Ice cream", "Sweet and delicious ice cream", アイスねだん, 1)
CALL EX_SHOPPING(GETNUM(ITEM, "アイス"), "Ice cream box", "Let's eat together!（10 Pieces）", パックねだん, 10, GETNUM(ITEM, "アイス") + 1)
DRAWLINE
PRINTL [999] 리턴
INPUT
IF RESULT == 999
	SELECTCASE LOCAL
		CASE 2
			CALL SPTALK, [[チルノ]], "笑顔", 1, @"「와, 정말 고마워요! 또 와주세요! 항상 더 많이 재고가 있을 거예요!」", 1
		CASE 1
			CALL SPTALK, [[チルノ]], "笑顔", 1, @"「아이스크림 맛있게 먹고 친구들에게 꼭 말해줘!」", 1
		CASEELSE
			CALL SPTALK, [[チルノ]], "怒り", 1, @"「체... 안 사고 구경만 하는 사람들은 정말 싫다고, 알잖아!」", 1
	ENDSELECT
	RETURN -1
ELSEIF RESULT == GETNUM(ITEM, "アイス")
	CALL ITEM_CARTON(GETNUM(ITEM, "アイス"), アイスねだん, 1)
	SIF LOCAL == 0
		LOCAL = 1
ELSEIF RESULT == GETNUM(ITEM, "アイス") + 1
	CALL ITEM_CARTON(GETNUM(ITEM, "アイス"), パックねだん, 10)
	LOCAL = 2
ENDIF
LOOP 1
