						PRINTFORMW 「This amulet can imprison cold air. It's so usefulー」
						CALL COLORMESSAGE14("　Thank goodness... Let's warm up together.",C_GREEN,2,0) 
				ENDSELECT
				
			ELSE
				SELECTCASE RAND:3
					;CASE 1
						;PRINTFORML 
					CASE 0
						PRINTFORML 「Alright! Today's the day I finally take a hot bath!」
					CASEELSE
						PRINTFORML 「Yes! I've finally taken my first bath! ...Huh?」
						PRINTFORMW 
				ENDSELECT
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが風呂に入ってきて出て行った
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
