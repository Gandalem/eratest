							PRINTFORML 「I thought nobody could beat me, but it looks like you're different.」
							PRINTFORMW 「Now, how about another match!」
							CALL COLORMESSAGE14("　W-Wait a moment!",C_GREEN,2,0)
						ELSE
							PRINTFORML 「You aren't that strong, huh?」
							PRINTFORMW 「I'll go find someone much stronger than you!」
						ENDIF
					CASEELSE
						PRINTFORML 「Hey you...!」
						PRINTFORML 「Uh... Have I met you somewhere?」
						CALL COLORMESSAGE14("　Please don't forget me...",C_GREEN,2,0) 
				ENDSELECT
			ENDIF
			CALL K14_DANMAKU_CHALLENGE() ;custom code
			RETURN 1
		ENDIF
		;-------------------------------------------------
