;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K14_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SETCOLOR C_AQUA
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			IF FLAG:時間停止
			ELSEIF CFLAG:318 == 1
				PRINTFORML 
			;ELSEIF TALENT:恋慕
				;PRINTFORML 
			ELSEIF TALENT:思慕
				SELECTCASE RAND:4
					CASE 2
						CALL COLORMESSAGE14("「Dai-chan!」",C_AQUA,1,0)
						CALL COLORMESSAGE14("　Ah, Cirno-chan!",C_GREEN,1,0)
						PRINTFORML 「Did you come here to playー?」
					CASE 1
					PRINTFORML 「Gotcha!」 (Squeeze!)
						CALL COLORMESSAGE14("　Hyaah!",C_GREEN,1,0) 
						PRINTFORML 「Weeell? Surprised?」
					CASE 0
						PRINTFORML 「Oh! Playmate found!」
					CASEELSE
						CALL COLORMESSAGE14("「Found you, Dai-chan!」",C_AQUA,1,0) 
						PRINTFORMW 「I had a feeling you'd be hereー!」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「Fu-fu-fu... Another Hide-and-seek win for me!」
					CASE 0
						PRINTFORML 「Hm? Oh, it's just you. Don't scare me like that.」
					CASEELSE
						CALL COLORMESSAGE14("　Ah, Cirno-san.",C_GREEN,1,0)
						PRINTFORML 「...Did you notice? Something's been following me for a while...」
						PRINTFORML 「Hurry up and show yourself!」
						CALL COLORMESSAGE14("　I wonder why she's talking to that tanuki statue?",C_GREEN,1,0) 
				ENDSELECT
			ENDIF
			CALL K14_DANMAKU_CHALLENGE() ;custom code
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
		;チルノの部屋で遭遇
			IF CFLAG:14:現在位置 == 345
				IF CFLAG:318 == 1
					PRINTFORML 
				;ELSEIF TALENT:恋慕
					;PRINTFORML 
				ELSEIF TALENT:思慕
					SELECTCASE RAND:3
						CASE 1
							PRINTFORML 「What the heckー If I knew you were here I'd come over in a flash!」
						CASE 0
							PRINTFORM 「So, you've come to my 
							PRINTDATA
								DATAFORM Ice Castle 
								DATAFORM Frozen Palace 
								DATAFORM Cirno Igloo 
								DATAFORM Chise 
								DATAFORM Demonic Mirroring Ice Crystals 
							ENDDATA
							PRINTFORML for a visit, eh!」
							CALL COLORMESSAGE14("（She's changed the name again...）",C_GREEN,2,0) 
						CASEELSE
								IF DAY:2 == 2
									CALL COLORMESSAGE14("　So nice and cool in here...",C_GREEN,1,0) 
									PRINTFORML 「Just when I was thinking you weren't around, I find you chilling out at my place.」
									CALL COLORMESSAGE14("　It's really cold here... I want to stay in here forever.",C_GREEN,1,0) 
								ELSE
									PRINTFORML 「Your lips are blue... You okay?」
								ENDIF
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 1
							PRINTFORML 「...? Did I ever promise to play with you?」
							PRINTFORML 「So you're dojo storming, huh?!」
							PRINTFORML 「Bring it on!」
						CASEELSE
							PRINTFORML 「Hey, this is my castle. You can't just intrude here and give me the cold shoulder, that's rude!」
							CALL COLORMESSAGE14("「But since were both fairies, I'll forgive you this time.」",C_AQUA,1,0) 
					ENDSELECT
				ENDIF
			ENDIF
