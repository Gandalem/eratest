;custom code
@UNIQUE_COM_アイスを買う_TR
#DIM アイスねだん
#DIM パックねだん
LOCAL = 0

gLineCount = LINECOUNT
REDRAW 0
DO
	SIF LINECOUNT - gLineCount > 0
		CLEARLINE LINECOUNT - gLineCount
	SELECTCASE DAY:2
	CASE 1
		アイスねだん = 400
	CASE 2
		アイスねだん = 500
	CASE 3
		アイスねだん = 300
	CASE 4
		アイスねだん = 200
	ENDSELECT
	パックねだん = アイスねだん * 9

	DRAWLINE
	CALL SPTALK, [[チルノ]], "通常", 1, @"「You here to buy Ice Cream? It's {アイスねだん} yen a stick.」", 1
	IF MONEY < アイスねだん
		CALL COLORMESSAGE14(@"　Aw... I don't have enough money...",C_GREEN,2,0)
	ELSE
		CALL COLORMESSAGE14(@"　That ice cream looks tasty... I have enough money, but I wonder if I should buy one?",C_GREEN,2,0)
	ENDIF
	RESETCOLOR
	PRINTFORML Money: %金額表示(MONEY)%
	DRAWLINE
	CALL EX_SHOPPING(GETNUM(ITEM, "アイス"), "Ice cream", "Sweet and delicious ice cream", アイスねだん, 1)
	CALL EX_SHOPPING(GETNUM(ITEM, "アイス"), "Ice cream box", "Let's eat together!（10 Pieces）", パックねだん, 10, GETNUM(ITEM, "アイス") + 1)
	DRAWLINE
	PRINTL [999] Return
	INPUT

	IF RESULT == 999
		SELECTCASE LOCAL
			CASE 2
				CALL SPTALK, [[チルノ]], "笑顔", 1, @"「Wow, thanks a lot! Come again soon! I always got more in stock!」", 1
			CASE 1
				CALL SPTALK, [[チルノ]], "笑顔", 1, @"「Enjoy your ice cream and be sure to tell your friends!」", 1
		CASEELSE
			CALL SPTALK, [[チルノ]], "怒り", 1, @"「Tche... I don't like when people browse without buying, you know!」", 1
		ENDSELECT
		RETURN -1
	ELSEIF RESULT == GETNUM(ITEM, "アイス")
		CALL ITEM_CARTON(GETNUM(ITEM, "アイス"), アイスねだん, 1)
		SIF LOCAL == 0
			LOCAL = 1
	ELSEIF RESULT == GETNUM(ITEM, "アイス") + 1
		CALL ITEM_CARTON(GETNUM(ITEM, "アイス"), パックねだん, 10)
		LOCAL = 2
	ENDIF
LOOP 1

