						CALL COLORMESSAGE14("　I... I think I'll pass for today...",C_GREEN,2,0) 
					CASEELSE
						PRINTFORML 「Hm... How do I get back home from here?」
						CALL COLORMESSAGE14("　Cirno-chan, are you lost perhaps?",C_GREEN,2,0) 
						PRINTFORMW 「N-No! I'm not lost or anything!」
						CALL COLORMESSAGE14("　Well if you want to go home, why don't we go together?",C_GREEN,2,0)
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						CALL COLORMESSAGE14("　Ah, Cirno-chan. Whoa... Everything's frozen around here.",C_GREEN,2,0) 
						PRINTFORML 「Just one step out of the lake, and I found so many fun things around.」
