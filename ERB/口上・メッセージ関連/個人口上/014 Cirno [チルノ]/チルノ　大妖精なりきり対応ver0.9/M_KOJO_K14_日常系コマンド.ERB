@M_KOJO_MESSAGE_COM_K14_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	SELECTCASE TFLAG:193
		CASE 0,1,2
			IF TALENT:恋慕
				;PRINTFORML
			ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
				PRINTFORML 「흠... 용서해 주었어!」
				CALL COLORMESSAGE14(@"　정말로 나를 용서해 주는 거야?",C_GREEN,1,0)
				PRINTFORML 「이런 작은 일도 용납하지 못한다면 결코 가장 강해질 수 없을 거야!」
				CALL COLORMESSAGE14(@"「게다가, 당신이 일부러 그랬다고 생각하지 않아.」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　흐윽... 정말 미안해, 치르노쨩.",C_GREEN,2,0)
			ELSE
				CALL COLORMESSAGE14(@"　치르노 씨... 지난번에 이상한 짓 해서 미안해요!",C_GREEN,1,0)
				PRINTFORML 「......」
				CALL COLORMESSAGE14(@"......",C_GREEN,1,0)
				PRINTFORML 「...무슨 일 있었어?」
				CALL COLORMESSAGE14(@"　흠...",C_GREEN,1,0)
				PRINTFORML 「갑자기 그런 식으로 사과하다니 나 놀랐어.」
				CALL COLORMESSAGE14(@"(그녀가 잊어버렸을까...?)",C_GREEN,2,0)
			ENDIF
		CASEELSE
			IF TALENT:恋慕
				;PRINTFORML
			ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
				PRINTFORML 「...너 그냥 사과하는 척하는 거잖아?」
				CALL COLORMESSAGE14(@"　아니, 그게 아니라... 그런 뜻이 아니었어...",C_GREEN,2,0)
			ELSE
				PRINTFORML 「장난치지 마! 나한테 무슨 짓을 했는지 알고 있나?!」
				PRINTFORML 「아, 알겠어! 그냥 계속 나랑 싸우고 싶다는 거지?! 난 언제든 네 엉덩이를 차 줄 준비가 되어 있어!」
				CALL COLORMESSAGE14(@"　으윽...! 저, 정말 죄송해요!!",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"　W-어떡하지? 그녀가 아직도 나한테 화가 난 것 같아...",C_GREEN,2,0)
			ENDIF
	ENDSELECT
ENDIF
RESETCOLOR
RETURN 1
