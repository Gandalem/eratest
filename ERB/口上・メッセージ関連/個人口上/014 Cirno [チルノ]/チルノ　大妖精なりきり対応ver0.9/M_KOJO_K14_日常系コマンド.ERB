					CALL COLORMESSAGE14(@"　Thank goodness... It looks like Cirno-san's good taking ice baths.",C_GREEN,1,0)
					PRINTFORMW 
			ENDSELECT
		ENDIF
	ELSE
		PRINTFORML 
	ENDIF
ENDIF
