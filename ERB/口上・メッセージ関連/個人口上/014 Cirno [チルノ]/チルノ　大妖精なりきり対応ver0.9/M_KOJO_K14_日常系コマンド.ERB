	SETCOLOR C_AQUA
	;TARGETとデート
	IF CFLAG:同行
		IF CFLAG:318 == 1
			PRINTFORML
			;ELSEIF TALENT:恋慕
			;PRINTFORML
		ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
			SELECTCASE RAND:3
				CASE 1
					CALL COLORMESSAGE14(@"　시르노짱, 가고 싶은 곳 있어?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「당신과 함께라면 어디든 괜찮아, 다이쨩!」",C_AQUA,1,0)
					PRINTFORMW 「좋아! 가자!」
				CASE 0
					PRINTFORMW 「좋아! 나의 이름을 아케비요 전체에 떨쳐보자!」
					CALL COLORMESSAGE14(@"　우리 최선 다하자, 시르노짱!",C_GREEN,2,0)
				CASEELSE
					PRINTFORMW 「그래서 우리 어디에 가서 뭘 할까, 내 형제여?」
					CALL COLORMESSAGE14(@"　자매가 되어야 하지 않나?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「사소한 것들은 걱정하지 마―!」",C_AQUA,2,0)
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「지루한 곳에 나를 데려가면 망설임 없이 너를 얼음 조각 속에 가둬버릴 거야.」
					CALL COLORMESSAGE14(@"　야, 농담이지, 그렇지?",C_GREEN,2,0)
				CASE 0
					PRINTFORMW 「그럼 어디 가서 놀까?」
				CASEELSE
					PRINTFORMW 「나 여행 경비가 꽤 많이 들더라고.」
					CALL COLORMESSAGE14(@"　음... 이 허니 비스킷밖에 없는데... 하지만...",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「뭐라고?!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　에엑...!",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「좋아! 너랑 어디든 갈게!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"(후우...)",C_GREEN,2,0)
			ENDSELECT
		ENDIF
		;TARGET以外とデート
	ELSEIF CFLAG:MASTER:同行
		;お出かけお見送り
		;IF TALENT:恋慕
		;PRINTFORML
		IF TALENT:思慕 || CFLAG:14:1002 == 1
			SELECTCASE RAND:3
				;CASE 1
				;PRINTFORML
				;PRINTFORMW
				;CASE 0
				;PRINTFORML
				CASEELSE
