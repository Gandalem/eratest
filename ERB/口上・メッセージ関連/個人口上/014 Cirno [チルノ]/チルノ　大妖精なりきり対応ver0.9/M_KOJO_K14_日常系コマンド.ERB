CALL M_KOJO_MESSAGE_COM_K14_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	IF FLAG:70
	ELSEIF CFLAG:14:睡眠
		PRINTFORML 
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
		;ELSEIF TALENT:恋慕
		;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「흠, 이 정도 쓰레기를 처리하기엔 어려울 것 같아.」
				PRINTFORMW 「하지만 나한테는 식은 죽일 일이지. 전혀 문제없다고 생각해!」
			CASE 0
				PRINTFORML 「여기부터 저기까지 쓰레기가 가득하다.」
				PRINTFORMW 「이거 영원히 걸리겠어... 그만할 수 없을까?」
				CALL COLORMESSAGE14(@"　여기서 청소를 다 하면 그만둘 수 있으니까 아직 포기하지 마, 알았지?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「부...」",C_AQUA,2,0)
			CASEELSE
				CALL COLORMESSAGE14(@"　...하아, 여기 정말 깨끗해졌네, 서노쨩?",C_GREEN,1,0)
				PRINTFORML 「...」
				CALL COLORMESSAGE14(@"　...시루노짱?",C_GREEN,1,0)
				PRINTFORML 「방이 꽤 깨끗해졌고, 기분이 좋아지기 시작했어!」
				PRINTFORMW 「자, 단마쿠 대결하자!」
				CALL COLORMESSAGE14(@"　...치르노짱.",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「농담이야!」",C_AQUA,2,0)
		ENDSELECT
	ELSEIF TFLAG:193 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「이거 나 혼자 다 치울 수 있다고! 내가 누군지 알고 그래?」
				CALL COLORMESSAGE14(@"　우리 같이 정리하면 금방 깨끗해질 거야. 조금만 더...",C_GREEN,2,0)
			CASE 0
				PRINTFORML 「그 큰 빨간 집에는 늘 돌아다니며 곳을 청소하는 요정 하녀들이 있다.」
				PRINTFORMW 「그들은 홍차와 과자를 뷔페식으로 먹을 수 있지만, 나는 여전히 거기서 일하고 싶지 않다.」
				CALL COLORMESSAGE14(@"　그냥 단 거라면 내가 구워 줄 수 있어.",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「청소 끝나면 달콤한 거 좀 만들어줘!」",C_AQUA,2,0)
			CASEELSE
				PRINTFORML 「청소는 신사 마이의 일이야- 너 할 필요 없어!」
				CALL COLORMESSAGE14(@"　깨끗한 방을 갖는 게 좋지 않니?",C_GREEN,1,0)
				PRINTFORML 「...아! 재미있는 생각이 갑자기 떠올랐어!」
				CALL COLORMESSAGE14(@"　?",C_GREEN,1,0)
				PRINTFORMW 「모든 걸 다이아몬드 가루로 만들면 깨끗해질 거야! 냉동 표지:"완벽해...!"」
				CALL COLORMESSAGE14(@"　……어? ……어?! ……꺄아악!",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「뭐 하는 거야?」
				CALL COLORMESSAGE14(@"　여기 좀 더러워서 치우려고 왔어...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「Hm....」",C_AQUA,2,0)
			CASE 0
				PRINTFORMW 「이 근처에 이상한 사람 있나 궁금하네? 좀 놀아보고 싶어.」
				CALL COLORMESSAGE14(@"　잠깐만요... 저 청소하고 있어요.",C_GREEN,2,0)
			CASEELSE
				PRINTFORMW 「고블린들이 청소를 하는 게 더 낫지 않을까?」
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
