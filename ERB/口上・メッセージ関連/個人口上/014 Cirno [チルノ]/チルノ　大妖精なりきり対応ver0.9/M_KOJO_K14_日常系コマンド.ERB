IF LOCAL
SETCOLOR C_AQUA
		IF FLAG:時間停止
		ELSEIF CFLAG:318 == 1
			PRINTFORMW 
		;ELSEIF TALENT:恋慕
			;PRINTFORML 
		ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Hmー? How do you read the title of this book?」
