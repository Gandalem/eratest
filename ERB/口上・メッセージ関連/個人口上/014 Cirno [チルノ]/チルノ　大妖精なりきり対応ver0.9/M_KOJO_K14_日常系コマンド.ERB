					CALL COLORMESSAGE14(@"　Isn't Cirno-chan awfully close? ...Ah, she was clinging onto me, wasn't she?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"　Fufu, what a cute sleeping face. I'd love to look at it forever...",C_GREEN,2,0)
				CASEELSE
					PRINTFORMW 「Zzzー...」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Snoreー ...Snoreー...」
					PRINTFORMW 
				CASE 0
					PRINTFORML 「Zzz...」
					PRINTFORMW 
				CASEELSE
					PRINTFORML 「Mmm... Mnn... It's eating meー...」
					PRINTFORMW 
			ENDSELECT
		ENDIF
ENDIF
RESETCOLOR
RETURN 1
