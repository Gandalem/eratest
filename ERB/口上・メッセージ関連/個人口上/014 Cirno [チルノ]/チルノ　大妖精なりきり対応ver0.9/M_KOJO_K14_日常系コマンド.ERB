@M_KOJO_MESSAGE_COM_K14_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
		IF FLAG:時間停止
		ELSEIF CFLAG:318 == 1
		;ELSEIF TALENT:恋慕
			;PRINTFORML 
		ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Huh? this tea's cold.」
					CALL COLORMESSAGE14(@"　It's so that you can drink too, Cirno-chan!",C_GREEN,1,0)
					PRINTFORMW 「Not cold enough... I'll chill it some more!」
					CALL COLORMESSAGE14(@"　The tea stalk that was floating about is frozen now...",C_GREEN,2,0)
				CASE 0
					CALL COLORMESSAGE14(@"　How many sugar cubes would you like in your tea, Cirno-chan?",C_GREEN,1,0)
					PRINTFORMW 「I want 3 sugar cubes in mine.」
					CALL COLORMESSAGE14(@"　3? I'd like 3 too... How greedy.",C_GREEN,2,0)
				CASEELSE
					PRINTFORML 「The tea's deliciousー!」crunch
					CALL COLORMESSAGE14(@"　Excuse me Cirno, but that popsicle you're holding...",C_GREEN,1,0)
					PRINTFORMW 「I turned it into a popsicle!」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「So bitter! Gimme another!」
					CALL COLORMESSAGE14(@"　Uhm... Are you okay? You're melting a bit...",C_GREEN,2,0) 
				CASE 0
					PRINTFORML 「Tea should be served like... This!」
					CALL COLORMESSAGE14(@"　Wow... Ice appeared out of thin air...!",C_GREEN,1,0) 
					;Missing context makes this conversation sound weird
					PRINTFORML 「Fu～ Aren't I the strongest?」
					PRINTFORML 「...It's bitter!」
					CALL COLORMESSAGE14(@"　I'll bring some sugar next time, okay?",C_GREEN,2,0)
				CASEELSE
					CALL COLORMESSAGE14(@"　Excuse me, Cirno-san. W-... Would you like to drink some tea?",C_GREEN,1,0)
					PRINTFORML 「...Handing me a hot drink like this, isn't that just bullying?」
					CALL COLORMESSAGE14(@"　Ah..! I'm so sorry...",C_GREEN,1,0)
					PRINTFORML 「Well, if I can't even drink tea this hot I'd lose my reputation of being the strongest!」
					PRINTFORMW 「...Hot!!」
			ENDSELECT
		ENDIF
	RETURN 1
ENDIF
RESETCOLOR
RETURN 1
