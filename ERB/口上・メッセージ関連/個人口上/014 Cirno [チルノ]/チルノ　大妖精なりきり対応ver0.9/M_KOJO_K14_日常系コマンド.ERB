	;ELSEIF TALENT:恋慕
		;PRINTFORML 
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:3
			CASE 1
				CALL COLORMESSAGE14(@"「Good night Dai-chan!」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　Good night, Cirno-san...",C_GREEN,2,0) 
				
			CASE 0
				PRINTFORML 「Muu～～Don't get cold, don't get coldー...!」
				CALL COLORMESSAGE14(@"　Cirno-chan, you don't have to hold yourself back from being cold okay?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「But you'll catch a cold Dai-chan...」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　There's hot stones all over my back so I'll be okay. (Fwip)",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「Wow...」",C_AQUA,2,0)
			CASEELSE
				PRINTFORMW 「Let's sleep together today!」
				CALL COLORMESSAGE14(@"「I hope that you're with me in my dreams, Dai-chan.」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　Cirno-chan, let's play a lot together in your dream.",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「It's so weird to want to be frozenー」
				PRINTFORMW 
			CASE 0
				PRINTFORML 「I wouldn't care if you accidentally freeze to death.」
				PRINTFORMW 
			CASEELSE
				PRINTFORML 「You'd rather be cold than warm?」
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
