RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
		LOCALS = %ITEMNAME:(TFLAG:193)%
		IF FLAG:時間停止
		ELSEIF CFLAG:318 == 1
			PRINTFORML 
		ELSEIF LOCALS == "カエル" 
		;カエルを釣るとチルノが欲しがる。何個もあげると何かもらえる。
			PRINTFORMW 「Ah! A frog! I want it!」
			PRINTFORML
			PRINTFORML  
			PRINTFORMW 　Will you give Cirno the frog?
			CALL ASK_YN
			IF !RESULT
				CALL LOST_ITEM("カエル",1,2)
				CALL COLORMESSAGE14(@"　Sure, you can have it. Please cherish it.",C_GREEN,1,0)
				PRINTFORMW 「Yaaay! Thanks a lot!」
				CFLAG:14:1003 ++
				SELECTCASE CFLAG:14:1003
					CASE 5,10,15
						PRINTFORML 「Since you're always giving me frogs, you can have this!」
						CALL COLORMESSAGE14(@"　It's so pretty... Is it really okay for me to have this?",C_GREEN,1,0)
						CALL COLORMESSAGE14(@"「I said it's fine didn't Iー?」",C_AQUA,1,0)
						CALL COLORMESSAGE14(@"　I'm so happy... I'll treasure this gift.",C_GREEN,2,0)
						CALL GET_ITEM("氷の鱗",1,2)
					CASEELSE
				ENDSELECT
			ELSE
				CALL COLORMESSAGE14(@"　Sorry, I want to keep this frog for myself.",C_GREEN,1,0)
				PRINTFORMW 「What's your problemー? So stingy!」
			ENDIF
		ELSEIF TALENT:恋慕 || TALENT:思慕 || CFLAG:14:1002 == 1
			IF TFLAG:194 > 1000
			;チルノが釣った
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「To think it'd turn into a close fight. This fish was pretty good.」
						CALL COLORMESSAGE14(@"　It would've escaped if you weren't here for sure, Cirno-chan.",C_GREEN,2,0)
					CASE 0
						PRINTFORML 「Heh, aren't I the best? I feel like I can catch anything!」
						PRINTFORML 「The next one! And the next one too!」
						CALL COLORMESSAGE14(@"　I wonder what you'll catch next.",C_GREEN,2,0)
					CASEELSE
						PRINTFORML 「Oh, ooooh...?」
						CALL COLORMESSAGE14(@"　Cirno-chan, reel it in!",C_GREEN,1,0)
						PRINTFORML 「I'm not gonna lose! Gunununu!」
						CALL COLORMESSAGE14(@"　Ah, I see it! Keep at it!",C_GREEN,1,0) 
						PRINTFORMDL FISH GET!
						PRINTFORMW 「Caught you! How's this huh?! You give up?!」
						CALL COLORMESSAGE14(@"　As expected of Cirno-chan!",C_GREEN,2,0)
				ENDSELECT
			ELSE
				SELECTCASE TFLAG:193
					CASE 0 
					;何も釣れない
						SELECTCASE RAND:3
							CASE 1
								PRINTFORML 「When we catch some fish, what should we make with it? Tempura sounds nice. Teriyaki too!」
								PRINTFORML 「Sashimi sounds pretty good, too. I'm drooling thinking about it.」
								CALL COLORMESSAGE14(@"　Leave the cooking to me, Cirno-chan!",C_GREEN,2,0)
							CASE 0
								PRINTFORMW 「I couldn't catch a single fish. Maybe Apollo's better than Marble as bait.」
								CALL COLORMESSAGE14(@"　...Cirno-chan. Using chocolate for fishing is kinda...",C_GREEN,1,0)
								CALL COLORMESSAGE14(@"「I'll catch one!」",C_AQUA,1,0)
								CALL COLORMESSAGE14(@"　I-Is that so?...",C_GREEN,2,0)
							CASEELSE
								CALL COLORMESSAGE14(@"　...It's just not taking the bait, huh.",C_GREEN,1,0)
								PRINTFORMW 「Dang it, fish! Now you're just making fun of us, aren't you...!」
						ENDSELECT
					CASE 1 TO 4
					;魚が釣れた
						CALL COLORMESSAGE14(@"「You're doing pretty good Dai-chan, but I'm not gonna lose to you!」",C_AQUA,1,0)
						CALL COLORMESSAGE14(@"　If it's you Cirno-chan, you'll definitely catch a bigger fish than me.",C_GREEN,1,0)
						PRINTFORMW 「I'm gonna catch the biggest fish I can! My goal's a mermaid!」
					CASE 11 TO 15
					;うまい魚が釣れた
						PRINTFORML 「Oh! That's a tasty looking fish!」
						CALL COLORMESSAGE14(@"　Cirno-chan, is it okay if I ask you for a favor?",C_GREEN,1,0)
						CALL COLORMESSAGE("「Hah! Leave it to me. I'll turn all those fishies into ice!」",C_AQUA,1,0)
						CALL COLORMESSAGE14(@"　With Cirno-chan here, all of these fishes can be served fresh.",C_GREEN,2,0)
					CASE 610
					;木材が釣れた
						CALL COLORMESSAGE14(@"　Ha... Ha... I thought I caught something big, but it was just a sunken log.",C_GREEN,1,0)
						PRINTFORMW 「Doesn't look like this log's good for sword fights. What a shame.」
					CASE 131
					;守矢の守札が釣れた
						PRINTFORML 「What's this piece of paper?」
						PRINTFORML 「It's so wet! You can't even use it to blow your nose.」
						CALL COLORMESSAGE14(@"　Is this... a lottery ticket? It looks like if you collect 5 of these, you could win a prize.",C_GREEN,1,0)
						CALL COLORMESSAGE14(@"「What a pain. It'd be less annoying if you just needed one of these.」",C_AQUA,2,0)
					CASE 21
					;ローターが釣れた
						PRINTFORML 「It's vibrating like crazy. What the heck's happening?」
						CALL COLORMESSAGE14(@"　C-Could that be?!",C_GREEN,1,0)
						PRINTFORML 「Hm? Do you know anything about this?」
						CALL COLORMESSAGE14(@"　Uhm... Cirno-chan, this thing is used... When a girl...",C_GREEN,1,0)
						PRINTFORMW 「Hey! Tell me! Tell me tell me!」
						CALL COLORMESSAGE14(@"　～～It's hopeless. I can't tell you!",C_GREEN,1,0)
						CALL COLORMESSAGE14(@"「Booー ...You're so stingy.」",C_AQUA,2,0)
					CASE 609
					;氷の鱗が釣れた
						PRINTFORMW 「Oh, that's something I threw out the other day.」
						CALL COLORMESSAGE14(@"　Huh?",C_GREEN,2,0)
					CASE 606
					;龍の爪が釣れた
						PRINTFORML 「What the heck's this? A really big claw? A fang? Is it a youkai's?」
						CALL COLORMESSAGE14(@"　How scary... Maybe a huge youkai is growing these around here.",C_GREEN,1,0)
						PRINTFORML 「Wonder if it's nearbyー If I tame it and make it my pet, there'll be nothing to be scared about!」
						CALL COLORMESSAGE14(@"　Eek! I hope we don't run into it...",C_GREEN,2,0)
					CASEELSE
						PRINTFORMW 「What'd you fish up?」
				ENDSELECT
			ENDIF

		ELSE
			SELECTCASE RAND:4
				CASE 2
					PRINTFORML 「It's so boring waiting around.」
					CALL COLORMESSAGE14(@"　Waiting is the true charm of fishing... At least, that's what I've heard.",C_GREEN,1,0)
					PRINTFORMW 「I'll go play over there!」
				CASE 1
					PRINTFORMW 「If you have any frogs, give 'em to me!」
					CALL COLORMESSAGE14(@"　I wonder if I can reel one in... I'll do my best.",C_GREEN,2,0)
				CASE 0
					PRINTFORMW 「Zzzz...」
					CALL COLORMESSAGE14(@"　（Cirno-san got tired of waiting and fell asleep. I'll have to try not waking her up.）",C_GREEN,2,0)
				CASEELSE
					PRINTFORMW 「Come on out fishyー! I'll fillet you into three pieces!」
					CALL COLORMESSAGE14(@"　The fish'll keep running away if you shout like that...",C_GREEN,2,0)
			ENDSELECT
		ENDIF
ENDIF
RESETCOLOR
RETURN 1
