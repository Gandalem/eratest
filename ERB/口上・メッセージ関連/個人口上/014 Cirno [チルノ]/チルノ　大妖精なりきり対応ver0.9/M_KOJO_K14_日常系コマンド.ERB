					CALL COLORMESSAGE14(@"　그 텐구 신문에 광고를 실어보는 건 어때?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「'거대 두꺼비 처단자! 가장 강한 얼음 요정 서노의 가장 강력한 아이스크림!'」",C_AQUA,2,0)
				CASEELSE
					PRINTFORML 「알고 있었어? 초록색 신사는 온 인간 마을을 돌아다니며 하루 종일 지껄여야 한다고.」
					CALL COLORMESSAGE14(@"　그리고 그 빨간색 신사 마이가 요괴를 섬멸하며 돌아다닌다.",C_GREEN,1,0)
					PRINTFORMW 「그 차이점을 이제 좀 알 것 같다.」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					CALL COLORMESSAGE14(@"　음, 서노 씨, 인간이 무섭지 않아요?",C_GREEN,1,0)
					PRINTFORML 「내가 요정이라는 이유로 나를 가볍게 여기는 못난 놈들이 있지만...」
					PRINTFORMW 「성가신 인간들은 얼어붙으면 조용해진다.」
					CALL COLORMESSAGE14(@"　으윽...",C_GREEN,2,0)
				CASE 0
					CALL COLORMESSAGE14(@"　인간 마을에 상점을 연다니, 정말 대담하구나 시르노쨩...",C_GREEN,1,0)
					PRINTFORMW 「나는 가서 내가 하고 싶은 대로 할 자유가 있어! 나 같은 요정에게는 그럴 수 있는 거지—?」
				CASEELSE
					CALL COLORMESSAGE14(@"　아, 아이스크림이… 혹시… 아이스크림 어때…?",C_GREEN,1,0)
					PRINTFORMW 「너무 조용하잖아! 주문 외우듯이 말해봐!」
					CALL COLORMESSAGE14(@"　고객 집합 사인: \"아이스크림 좀 드시겠어요~!\"",C_GREEN,2,0)
			ENDSELECT
		ENDIF
		;妖精の大樹かサニーの部屋で遊ぶ
		;ELSEIF CFLAG:MASTER:現在位置 == 5 || CFLAG:MASTER:現在位置 == 32
	ELSEIF GET_MAPID(CFLAG:職場) == 0 ;custom code from dialogue tweak patch
		;IF TALENT:恋慕
		;PRINTFORML
		IF TALENT:思慕 || CFLAG:14:1002 == 1
			SELECTCASE RAND:3
				CASE 1
					CALL COLORMESSAGE14(@"내가 영웅을 할게, 너는 악당을 해!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　음... 이거 할 수 있을까?",C_GREEN,1,0)
					PRINTFORML 「드디어 모습을 드러냈군, 위대한 마왕이여! 요정들의 평화를 어지럽힌 자들은 벌을 받아야 한다!」
					IF FLAG:なりきり == [[大妖精]] || CFLAG:14:1001 == 1 ;custom code, fixed
						SETCOLOR C_GREEN
						PRINTFORM U, Um...
						PRINTDATA
							DATAFORM 후후후... 쿠아하하하... 아하하하ー 악! 콜록콜록!!!
							DATAFORM 네가 돼지처럼 비명을 지르게 해 주마!
							DATAFORM 어머니 자연조차 때로는 죽는다. 이제, 네가 너무 많은 힘을 가지고 있다는 것을 알아둬라!
							DATAFORM 나의 기쁨은 너의 파괴다. 나의 아름다움은 너의 죽음이다! 그러니 앞으로 나와 평화롭게 죽어라!
							DATAFORM 모르겠나...? 위대한 마왕으로부터는 벗어날 수 없다는 것을!
						ENDDATA
					ENDIF
					PRINTFORMW 
				CASE 0
					PRINTFORML 「냠냠...」
					CALL COLORMESSAGE14(@"　아, 만두를 먹고 있네. 누군가 이걸 준 거야?",C_GREEN,1,0)
					PRINTFORMW 「오, 이 밤나무 만두인가? 루나 방 구석에서 발견했어!」
					CALL COLORMESSAGE14(@"(그래서 루나는 그것을 숨기고 있었다...)",C_GREEN,2,0)
				CASEELSE
					PRINTFORMW 「좋아, 숨바꼭질하자ー!」
					CALL COLORMESSAGE14(@"　시르노짱... 마법의 숲까지는 가지 말아줘.",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「알고 있어 알고 있어. 이번엔 요괴 산에 숨을 거야!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　거기에도 가지 마...",C_GREEN,2,0)
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 1
					CALL COLORMESSAGE14(@"(하쿠레이 신사를 방문했으나...)",C_GREEN,1,0)
					PRINTFORMW 「나 지금 과자 훔치느라 바빠, 나뭇잎 사방에 뿌려놓고 그 코마이누 상들 발로 차고 있단 말이야—!」
					CALL COLORMESSAGE14(@"　난 네가 너무 심하게 못된 행동을 하면 안 된다고 생각한다...",C_GREEN,2,0)
				CASE 0
					CALL COLORMESSAGE14(@"(나랑 시르노 씨가 같이 낙서하고 있다...)",C_GREEN,1,0)
					PRINTFORML 「나의 예술 작품을 보아라!!」
					CALL COLORMESSAGE14(@"　?!...그게 거시기...인가?",C_GREEN,1,0)
					PRINTFORMW 「이 개구리 멋있지 않니?」
					CALL COLORMESSAGE14(@"　정말 그렇다! 귀여운 개구리네!!",C_GREEN,2,0)
				CASEELSE
					PRINTFORML 「이 요정들이 이렇게 멋진 집을 소유하다니 너무 불공평해!」
					CALL COLORMESSAGE14(@"　부엌도 있고 욕실까지 있다. 정말 인간들이 살 만한 집에 보인다.",C_GREEN,2,0)
			ENDSELECT
		ENDIF
	ELSE
		;朝に雪が降っていると湖畔で遊ぶ。
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「헤이브호! 헤이브호!」
				PRINTFORMW 「그리고 끝났어ー! 나의 멋진 치르노 드래곤!」
			CASE 0
