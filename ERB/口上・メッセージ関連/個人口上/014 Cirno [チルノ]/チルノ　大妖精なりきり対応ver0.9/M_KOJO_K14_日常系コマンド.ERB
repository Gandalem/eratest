;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================
@M_KOJO_SUCCESS_COM_K14_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K14_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K14_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
	IF FLAG:時間停止
	ELSEIF FLAG:なりきり == [[大妖精]] && !CFLAG:14:1002
	;大妖精に限り初対面口上へ移行
		CALL M_KOJO_ENCOUNTER_K14
	ELSEIF TCVAR:302 && !TALENT:恋慕 && !TALENT:思慕 && CFLAG:14:1002 != 1
		SELECTCASE RAND:3
			CASE 1
				CALL COLORMESSAGE14(@"　Ha, hachoo!",C_GREEN,1,0)
				PRINTFORMW 「Fu... If you stand too close to me you'll catch frostbite.」
			CASE 0
				PRINTFORML 「By the way, who're you?」
				CALL COLORMESSAGE14(@"（She still can't remember my name...）",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「...You've been pestering me for a while now.」
				CALL COLORMESSAGE14(@"　S-Sorry!",C_GREEN,2,0)
		ENDSELECT
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「......」
	ELSEIF CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 2 || CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 202
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「You here to buy Ice Cream? It's 500 yen a stick.」
				IF MONEY < 500
					CALL COLORMESSAGE14(@"　Aw... I don't have enough money...",C_GREEN,2,0)
				ELSE
					CALL COLORMESSAGE14(@"　That ice cream looks tasty... I have enough money, but I wonder if I should buy one?",C_GREEN,2,0)
				ENDIF
			CASE 0
				PRINTFORML 「I'm working right now. It's so busy that I'm getting dizzy!」
				PRINTFORMW 「It's tough being so popularー」
				CALL COLORMESSAGE14(@"（She looks quite busy... Maybe I should lend her a hand?）",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「Dang sun, melting me and my ice cream...」
				PRINTFORMW 「Uoー! I won't lose to you!」
				CALL COLORMESSAGE14(@"　Hang in there, Cirno-chan!",C_GREEN,2,0)
		ENDSELECT
	;ELSEIF TALENT:恋慕 
		;PRINTFORML 
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:8
			CASE 6
				PRINTFORML 「Ice's a better murder weapon than a knife!」
				PRINTFORML 「A knife made of ice would melt, and there'd be no evidence of the murder!」
				CALL COLORMESSAGE14(@"　Cirno-chan, were you by any chance reading detective comics from the outside world?",C_GREEN,1,0) 
				CALL COLORMESSAGE14(@"「Ughー So you already knew.」",C_AQUA,2,0) 
			CASE 5
				CALL COLORMESSAGE14(@"「Hey Dai-chan, what kind of fairy are you?」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　Huh? Me? I wonder...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「Are you a butterfly fairy like Larva?」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　But I don't hibernate or anything... Just what kind of fairy am I?",C_GREEN,1,0)
				PRINTFORMW 「...I got this weird feeling that an incident's gonna happen!」
				CALL COLORMESSAGE14(@"　My identity isn't something worthy of an incident you know～",C_GREEN,2,0)
			CASE 4
				PRINTFORMW 「I really don't wanna get tanned againー Lately the sun's gotten really weak though.」
				CALL COLORMESSAGE14(@"　Around that time, Cirno-chan was really strong and so cool...",C_GREEN,2,0)
			CASE 3
				PRINTFORMW 「Watch out for those crow tengu. They'll make stuff up about you in their articles!」
				CALL COLORMESSAGE14(@"　You mean like that article about the giant toad?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「That's right! That newspaper's full of lies. Just so you know, I put up quite a fight!」",C_AQUA,2,0) 
			CASE 2
				PRINTFORML 「Wonder if there's any frogs around here...」
				CALL COLORMESSAGE14(@"　You're going to freeze frogs again? I feel bad for them so please don't...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「I'll revive them properly so it's fine.」",C_AQUA,2,0)
			CASE 1
				PRINTFORML 「Ahhー So boringー... I really hope another big incident happens.」
				CALL COLORMESSAGE14(@"　Isn't it great that it's peaceful around here, Cirno-chan?",C_GREEN,1,0)
				PRINTFORMW 「I think it'd be more fun if there was an incident everyday!」
			CASE 0
				PRINTFORML 「Lying down on my back and freezing everything around me is so fun...」 
				PRINTFORMW 「Pebbles and stuff start sliding around... It's the best!」
			CASEELSE
				PRINTFORML 「Look! Freezing flower petals is awesome!」
				CALL COLORMESSAGE14(@"　Are you making dried flowers?",C_GREEN,1,0)
				PRINTFORMW 「If you freeze it like this, it becomes a deadly weapon!」
				CALL COLORMESSAGE14(@"　W-Whoa...",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:6
			CASE 4
				PRINTFORML 「I sell ice cream in the human village on sunny summer days.」
				PRINTFORMW 「Selling ice cream is only something I can do during the summer, so I make lots of money!」
				CALL COLORMESSAGE14(@"　I love ice cream! If I see you, please let me buy one too.",C_GREEN,2,0) 
				SIF DAY:2 == 4
					CALL COLORMESSAGE14(@"　Ice cream during winter sounds delicious, but I'm afraid I'll catch a cold...",C_GREEN,2,0) 
			CASE 3
				PRINTFORML 「Those 3 fairies that live near the shrine are amazing.」
				PRINTFORML 「Sunny can hide someone's presence, Luna can erase light, and Star can... um, detect sounds!」
				PRINTFORMW 「It's frustrating but, there's no one that's better than them at Hide and Seek!」
				CALL COLORMESSAGE14(@"（Huh... Isn't there something off?）",C_GREEN,2,0) 
			CASE 2
				IF DAY:2 == 4
					PRINTFORMW 「Winter's so boring. Everything around me just freezes without me doing anything.」
					CALL COLORMESSAGE14(@"　Since insects and summer fairies are hibernating, winter feels pretty lonely...",C_GREEN,2,0)
				ELSE
					PRINTFORMW 「Well then, what should I freeze today～?」
					CALL COLORMESSAGE14(@"　P-... Please don't freeze me, alright...?",C_GREEN,2,0) 
				ENDIF
			CASE 1
				PRINTFORML 「By the way, what's your name again?」
				CALL COLORMESSAGE14(@"　My name? My name is...",C_GREEN,1,0)
				PRINTFORMW 「It's a pain to remember, so forget it.」
				CALL COLORMESSAGE14(@"　No way...",C_GREEN,2,0)
			CASE 0
				PRINTFORML 「What a meek girlー! Did you forget to have lunch?」 
				;She calls her meek because of her small body/chest, but being meek doesn't mean skinny(unless if people associate the two).
				CALL COLORMESSAGE14(@"　I-I'm eating properly...",C_GREEN,1,0)
				IF TALENT:MASTER:バストサイズ > -1
					CALL COLORMESSAGE14(@"「...Or so I said, but these are quite big.」",C_AQUA,1,0) 
					CALL COLORMESSAGE14(@"　U-Um... Where are you looking at?",C_GREEN,2,0)
				ELSE
					PRINTFORMW 「Really? You sure you aren't just eating grass?」
				ENDIF
			CASEELSE
				PRINTFORML 「Do you know how to play hide and seek?」
				CALL COLORMESSAGE14(@"　It's the game where the seeker has to find the hiders... Right? I used to play it with some friends in a sunflower field.",C_GREEN,1,0)
				PRINTFORML 「It's really popular with the fairies around the lake.」
				PRINTFORML 「Also, I'm the one that always win. Ahem!」
				PRINTFORML 「Oh, I know! Next time I'll invite you too!」
				CALL COLORMESSAGE14(@"　I wonder if I'll be able to find Cirno-san... I'll do my best!",C_GREEN,2,0) 
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
