					CALL COLORMESSAGE14(@"　??",C_GREEN,2,0)
				CASE 2
				;寝顔にキスされた？
					CALL COLORMESSAGE14(@"「Heeey! Dai-chan!」（Shake shake）",C_AQUA,1,0)
					PRINTFORML 「Hurry and wake up so we can play!」
					PRINTFORML 「Come ooonー This is such a waste of tiiimeー」
					PRINTFORML 「...If you don't wake up, I'm gonna kiss you.」
					PRINTFORML 「Smooch-...」
					CALL COLORMESSAGE14(@"「...Dai-chan's cheek is so soft.」",C_AQUA,1,0)
					PRINTFORML 「That's weird. ...Why do I feel so hot and bothered?」
					PRINTFORMW 「???」
					PRINTFORML 
					PRINTFORML 
					PRINTFORMW 
					CALL COLORMESSAGE14(@"　Yaawn... I overslept.",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"　? ...Cirno-chan, what're you doing in the corner of the room?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「N-Nothing!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　...? You're acting weird Cirno-chan.",C_GREEN,2,0)
				CASE 1
				;MASTERの膝を枕にして寝ている
					CALL COLORMESSAGE14(@"　Nh, fuu... ...My lap feels kinda heavy for some reason...?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"　Have to get up and see what's wrong. Hup...",C_GREEN,1,0)
