;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;==================================================

@M_KOJO_SUCCESS_COM_K14_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K14_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K14_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	IF FLAG:時間停止
	ELSEIF FLAG:なりきり == [[大妖精]] && !CFLAG:14:1002
		;大妖精に限り初対面口上へ移行
		CALL M_KOJO_ENCOUNTER_K14
	ELSEIF TCVAR:302 && !TALENT:恋慕 && !TALENT:思慕 && CFLAG:14:1002 != 1
		SELECTCASE RAND:3
			CASE 1
				CALL COLORMESSAGE14(@"　하, 재채기!",C_GREEN,1,0)
				PRINTFORMW 「후... 내게 너무 가까이 서 있으면 동상을 입을 거야.」
			CASE 0
				PRINTFORML 「그건 그렇고, 당신은 누구예요?」
				CALL COLORMESSAGE14(@"(그녀는 아직도 내 이름을 기억하지 못한다...)",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「...한동안 계속 나를 귀찮게 했네.」
				CALL COLORMESSAGE14(@"　죄송해요!",C_GREEN,2,0)
		ENDSELECT
	ELSEIF CFLAG:318 == 1 || TFLAG:193 == -3 ;custom code, hate mark 3
		PRINTFORML 「......」
	ELSEIF CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 2 || CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 202
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「아이스크림 사러 왔어? 한 개에 500엔이야.」
				IF MONEY < 500
					CALL COLORMESSAGE14(@"　아아... 돈이 충분하지 않네...",C_GREEN,2,0)
				ELSE
					CALL COLORMESSAGE14(@"　저 아이스크림 맛있어 보이네... 돈은 충분한데 하나 사야 할까?",C_GREEN,2,0)
				ENDIF
			CASE 0
				PRINTFORML 「지금 일하고 있어. 너무 바빠서 어지러울 지경이야!」
				PRINTFORMW 「너무 인기 있는 게 힘들다구-」
				CALL COLORMESSAGE14(@"(그녀는 꽤 바빠 보인다... 내가 도와줘야 할까?)",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「뜨거운 태양이 나랑 내 아이스크림을 녹이고 있어...」
				PRINTFORMW 「우오ー! 너에게 지지 않을 거야!」
				CALL COLORMESSAGE14(@"　힘내, 치르노짱!",C_GREEN,2,0)
		ENDSELECT
		;ELSEIF TALENT:恋慕
		;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:8
			CASE 6
				PRINTFORML 「얼음이 칼보다 더 나은 살인 도구지!」
				PRINTFORML 「얼음으로 만든 칼은 녹아버려서 살해의 증거가 남지 않을 거야!」
				CALL COLORMESSAGE14(@"　시르노쨩, 혹시 외부 세계의 탐정 만화 같은 거 읽고 있었어?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「하아- 벌써 알고 있었구나.」",C_AQUA,2,0)
			CASE 5
				CALL COLORMESSAGE14(@"「헤이 다이쨩, 너는 무슨 종류의 요정이니?」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　응? 나라고? 궁금하네...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「너는 애벌레 요정처럼 나비 요정이니?」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　하지만 난 동면 같은 건 안 해... 대체 난 무슨 종류의 요정인 거지?",C_GREEN,1,0)
				PRINTFORMW 「...사건이 일어날 것 같은 이상한 느낌이 들어!」
				CALL COLORMESSAGE14(@"　내 정체성은 어떤 사건을 치러야 할 만큼 가치 있는 것이 아니야~",C_GREEN,2,0)
			CASE 4
				PRINTFORMW 「난 정말 다시 피부 까매지는 거 싫단 말이야—요즘 햇빛이 많이 약해지긴 했지만.」
				CALL COLORMESSAGE14(@"　그때쯤 치르노는 정말 강하고 멋있었다...",C_GREEN,2,0)
			CASE 3
				PRINTFORMW 「저 까마귀 테누들을 조심해. 그놈들이 기사에 너에 대해 지어낸 이야기를 할 거니까!」
				CALL COLORMESSAGE14(@"　거대한 두꺼비에 대한 그 기사를 말하는 거야?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「그렇지! 그 신문은 거짓말로 가득 차 있어. 네가 알도록 해두자면, 난 꽤 열심히 싸웠어!」",C_AQUA,2,0)
			CASE 2
				PRINTFORML 「이 근처에 개구리가 있을지 궁금하네...」
				CALL COLORMESSAGE14(@"　또 개구리들 얼릴 거야? 내가 그 아이들이 안쓰러우니까 그러지 말아 줘...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「제가 제대로 되살려 드릴 테니 괜찮을 거예요.」",C_AQUA,2,0)
			CASE 1
				PRINTFORML 「아아~ 너무 지루해~ 정말 또 큰 사건이 생겼으면 좋겠어.」
				CALL COLORMESSAGE14(@"　여기 주변이 평화롭다는 게 정말 멋지지 않아, 시르노짱?",C_GREEN,1,0)
				PRINTFORMW 「매일 사건이 있으면 더 재미있을 것 같은데!」
			CASE 0
				PRINTFORML 「뒤로 누워서 주변의 모든 것을 얼려버리는 건 정말 재미있어...」 
				PRINTFORMW 「조약돌 같은 것들이 굴러다니기 시작해... 최고야!」
			CASEELSE
				PRINTFORML 「봐! 꽃잎 얼리는 거 멋지다!」
				CALL COLORMESSAGE14(@"　건조 꽃을 만들고 있나요?",C_GREEN,1,0)
				PRINTFORMW 「이렇게 얼리면 치명적인 무기가 된다!」
				CALL COLORMESSAGE14(@"　와, 뭐야...",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:6
			CASE 4
				PRINTFORML 「나는 화창한 여름날 인간 마을에서 아이스크림을 판다.」
				PRINTFORMW 「아이스크림 판매는 내가 여름 동안 할 수 있는 유일한 것이라 돈을 많이 번다!」
				CALL COLORMESSAGE14(@"　나는 아이스크림을 사랑해! 당신을 보면 하나도 사게 해줘.",C_GREEN,2,0)
				SIF DAY:2 == 4
					CALL COLORMESSAGE14(@"　겨울에 아이스크림은 맛있을 것 같지만 감기에 걸릴까 봐 걱정이야...",C_GREEN,2,0)
			CASE 3
				PRINTFORML 「신사 근처에 사는 저 세 요정들은 정말 대단해.」
				PRINTFORML 「써니는 누군가의 존재를 숨길 수 있고, 루나는 빛을 지울 수 있으며, 스타는... 음, 소리를 감지할 수 있어!」
				PRINTFORMW 「답답하지만, 숨바꼭질만큼 그들보다 잘하는 사람은 없어!」
				CALL COLORMESSAGE14(@"(음... 뭔가 이상하지 않아?)",C_GREEN,2,0)
			CASE 2
				IF DAY:2 == 4
					PRINTFORMW 「겨울은 너무 지루해. 내가 아무것도 하지 않아도 내 주변의 모든 것이 얼어붙는 것만 같아.」
					CALL COLORMESSAGE14(@"　벌레들과 여름 요정들이 동면 중이라, 겨울은 꽤 외롭구나...",C_GREEN,2,0)
				ELSE
					PRINTFORMW 「음, 그럼 오늘은 뭘 얼려볼까~?」
					CALL COLORMESSAGE14(@"　P-... 날 얼리지 말아줘, 알겠지...?",C_GREEN,2,0)
				ENDIF
			CASE 1
				PRINTFORML 「그건 그렇고, 다시 한번 이름이 뭐였지?」
				CALL COLORMESSAGE14(@"　내 이름? 내 이름은...",C_GREEN,1,0)
				PRINTFORMW 「기억하기 힘들 테니, 잊어버려.」
				CALL COLORMESSAGE14(@"　말도 안 돼...",C_GREEN,2,0)
			CASE 0
				PRINTFORML 「참 온순한 아이로군-! 점심을 거르셨나?」 
				;She calls her meek because of her small body/chest, but being meek doesn't mean skinny(unless if people associate the two).
				CALL COLORMESSAGE14(@"　저, 저 제대로 먹고 있어요...",C_GREEN,1,0)
				IF TALENT:MASTER:バストサイズ > -1
					CALL COLORMESSAGE14(@"「...그렇게 말했지만, 이건 상당히 크네.」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　음... 어디를 보고 있는 거야?",C_GREEN,2,0)
				ELSE
					PRINTFORMW 「정말? 풀이나 먹는 거 아니야?」
				ENDIF
			CASEELSE
				PRINTFORML 「숨바꼭질하는 법 알아?」
				CALL COLORMESSAGE14(@"　찾으려는 사람이 숨어 있는 사람을 찾아야 하는 게임이지... 맞지? 예전엔 해바라기밭에서 친구들이랑 같이 했었어.",C_GREEN,1,0)
				PRINTFORML 「호수 주변의 요정들에게 정말 인기가 많다.」
				PRINTFORML 「게다가, 내가 항상 이기는 사람이다. 에헴!」
				PRINTFORML 「아, 알고 있어! 다음에는 너도 초대할게!」
				CALL COLORMESSAGE14(@"　시루노 씨를 찾을 수 있을지 모르겠어... 최선을 다할게!",C_GREEN,2,0)
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
