				;CASE 1
				;PRINTFORML
				;PRINTFORMW
				CASE 0
					;PRINTFORML
				CASEELSE
					PRINTFORML 「다른 곳에서 놀아야 할지 궁금하네?」
					PRINTFORMW 
			ENDSELECT
		ENDIF
	ELSE
	ENDIF
