						PRINTFORMW 「Troublesome humans become quiet when they're frozen.」
						CALL COLORMESSAGE14(@"　Eek...",C_GREEN,2,0)
					CASE 0
						CALL COLORMESSAGE14(@"　Opening a shop in the human village, that's quite bold of you Cirno-chan...",C_GREEN,1,0)
						PRINTFORMW 「I have the freedom to go and do whatever I want! That much's possible for a fairy like me, isn't itー?」
					CASEELSE
						CALL COLORMESSAGE14(@"　Ah, Ice creamー... W-Wouldn't you... like an ice creamー...",C_GREEN,1,0)
						PRINTFORMW 「You're so quiet! Say it like you're announcing a spell card!」
						CALL COLORMESSAGE14(@"　Customer Gathering Sign:\"Wouldn't you like some ice creamー!\"",C_GREEN,2,0)
				ENDSELECT
			ENDIF
		;妖精の大樹かサニーの部屋で遊ぶ
		;ELSEIF CFLAG:MASTER:現在位置 == 5 || CFLAG:MASTER:現在位置 == 32
		ELSEIF GET_MAPID(CFLAG:職場) == 0 ;custom code from dialogue tweak patch
			;IF TALENT:恋慕
				;PRINTFORML 
			IF TALENT:思慕 || CFLAG:14:1002 == 1
				SELECTCASE RAND:3
					CASE 1
						CALL COLORMESSAGE14(@"I'll play the hero, you can play the villain!」",C_AQUA,1,0) 
						CALL COLORMESSAGE14(@"　Eeh... I wonder if I can do this?",C_GREEN,1,0) 
						PRINTFORML 「So you finally show yourself, great Demon King! Those that disturb the peace of the fairies deserve to be punished!」
						IF FLAG:なりきり == [[大妖精]] || CFLAG:14:1001 == 1 ;custom code, fixed
						SETCOLOR C_GREEN
						PRINTFORM U, Um...
						PRINTDATA 
							DATAFORM Fufufu... Guahahaha... Ahahahahaー Agh! Cough-cough!!!
							DATAFORM I'll make you squeal like a pig!
							DATAFORM Even mother nature will die at times. Now, be aware that you hold a little too much power!
							DATAFORM My joy is thy destruction. My beauty thy death! Come forward then, and die in peace!
							DATAFORM Don't you know...? You can't escape from the great Demon King!
						ENDDATA
						ENDIF ;custom code
						PRINTFORMW 
					CASE 0
						PRINTFORML 「Munch-munch...」
