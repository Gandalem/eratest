;TFLAG:193(1=貸し出しOK 0=貸し出し不可
;ITEM:10X (X=1戦術指南書 X=2調理指南書 X=3字引 X=4御伽草子
;==================================================

@M_KOJO_MESSAGE_COM_K14_620
CALL M_KOJO_MESSAGE_COM_K14_620_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_620_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORMW 
		;ELSEIF TALENT:恋慕
		;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「음~? 이 책의 제목은 어떻게 읽는 거니?」
				CALL COLORMESSAGE14(@"「다이쨩, 이거 어떻게 읽어?」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　음~ 뭐라고 하네...",C_GREEN,1,0)
				PRINTFORML 
				PRINTFORMDL 『오모테나시집 - 연애와 궁정 예절의 서론』
				PRINTFORMW 
				CALL COLORMESSAGE14(@"　... (쿵)",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「우와, 다이짱! 깜짝 놀랐잖아! 아무 말 없이 그냥 책을 제자리에 놓지 마!」",C_AQUA,2,0)
			CASE 0
				PRINTFORMW 「추위에도 강한 얼음 책 같은 거 빌릴 수 있나요?」
				CALL COLORMESSAGE14(@"　그거 아주 거친 것 같네. 찾아보자!",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「아! 분분마루 신문이네...」
				PRINTFORMW 「그리고 그 개구리가 있던 무렵이었지!」
				CALL COLORMESSAGE14(@"　응? 그 기사 속의 너는 치르노쨩이야?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"　우와! 네가 그 텐구의 신문에 실릴 줄은 몰랐어... 내가 피크를 가져가도 괜찮을까?",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「이건 별일 아니라고! 읽을 필요 없어! 사실은 아예 보지 마!」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　에에엣―… 말도 안 돼…",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 2
				CALL COLORMESSAGE14(@"　와, 여기 흥미로운 책들이 정말 많네요.",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「와, 장난칠 만한 책이 엄청 많은 것 같네.」",C_AQUA,1,0)
				PRINTFORMW 「좋아, 누가 이 탐정 소설의 살인자인지 보자고 그리고...」
				CALL COLORMESSAGE14(@"　잠깐, 너네 쫓겨날 거야!",C_GREEN,2,0)
			CASE 1
				PRINTFORML 「저 점원은 대체 뭘 보고 있는 거야?」
				PRINTFORMW 「나를 그렇게 심하게 놀리고 싶다면 지금 당장 해줄게!」
				CALL COLORMESSAGE14(@"　C-진정해, 서노짱...",C_GREEN,2,0)
			CASE 0
				CALL COLORMESSAGE14(@"　여기에 읽고 싶은 것이 있니, 시르노짱?",C_GREEN,1,0)
				PRINTFORMW 「레이저 동결에 대한 안내가 있었으면 했는데, 그런 건 없는 것 같네요.」
			CASEELSE
				PRINTFORML 「참으로 비참하게 음울한 곳이군―」
				PRINTFORMW 「내가 이걸 얼리기 시작하면 아마 덜 우울해 보일 거야.」
				CALL COLORMESSAGE14(@"　여기에서 너무 시끄럽게 굴지 마라...",C_GREEN,2,0)
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
