@M_KOJO_MESSAGE_COM_K14_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		;ELSEIF TALENT:恋慕
		;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:3
			CASE 1
				CALL COLORMESSAGE14(@"　음, 우리 뭘 해야 할까...",C_GREEN,1,0)
				PRINTFORMW 「놀래볼래ー?」(기대며)
				CALL COLORMESSAGE14(@"　아... 지지, 시르노쨩. 너무 세게 밀고 있잖아--",C_GREEN,2,0)
			CASE 0
				PRINTFORML 「이거 받아라!」
				CALL COLORMESSAGE14(@"　음~ 다이쨩, 너 정말 좋은 향기가 난다.",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　끼야! 갑자기 그렇게 매달리다니, 너희 같은 장난기 많은 여자애들은 안아주면 되잖아!",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「웃으면 지는 거야! 쿠치쿠ー~」
				CALL COLORMESSAGE14(@"　Nh～......!",C_GREEN,1,0)
				PRINTFORML 「...큭!」
				CALL COLORMESSAGE14(@"「다이짱의 떨림~ 귀여워!」",C_AQUA,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				CALL COLORMESSAGE14(@"　히야...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「오오! 네 날개가 정말 복슬복슬하네.」",C_AQUA,1,0)
				PRINTFORMW 「헤이~ 너 좀 얼려봐도 돼?」
				;This sounds weird out of context when the player isn't pretending to be Daiyousei.
				CALL COLORMESSAGE14(@"　P-하지 마세요!",C_GREEN,2,0)
			CASE 0
				CALL COLORMESSAGE14(@"　머리가 정말 지저분해 보인다. 내가 정리해 줄게.",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「흠, 알겠어-」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　음... 되게 복슬복슬하고 웨이브가 있네... 좀 질투난다.",C_GREEN,1,0)
				PRINTFORMW 「머리도 되게 복슬복슬하네. 만지면 재미있을 것 같아!」
			CASEELSE
				CALL COLORMESSAGE14(@"　시르노 씨의 몸이 꽤 차갑다.",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「음, 당연하지.」",C_AQUA,1,0)
				PRINTFORMW 「얼음 요정의 몸은 항상 그렇게 푸르고 차갑다.」
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
