@M_KOJO_MESSAGE_COM_K14_303_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
		SELECTCASE TFLAG:193 
		CASE 0,1,2
			IF TALENT:恋慕
				;PRINTFORML 
			ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
				PRINTFORML 「Hm... You're forgiven!」
				CALL COLORMESSAGE14(@"　A-Are you really forgiving me?",C_GREEN,1,0)
				PRINTFORML 「If you can't let something this little slide, you'll never be the strongest!」
				CALL COLORMESSAGE14(@"「Besides, I don't think you did it on purpose.」",C_AQUA,1,0) 
				CALL COLORMESSAGE14(@"　Sniffle... I'm really sorry Cirno-chan.",C_GREEN,2,0) 
			ELSE
				CALL COLORMESSAGE14(@"　Cirno-san... I'm sorry for doing something weird last time!",C_GREEN,1,0)
				PRINTFORML 「......」
				CALL COLORMESSAGE14(@"......",C_GREEN,1,0)
				PRINTFORML 「...Did something happen?」
				CALL COLORMESSAGE14(@"　Huh...",C_GREEN,1,0)
				PRINTFORML 「You surprised me, apologizing like that out of nowhere.」
				CALL COLORMESSAGE14(@"（Did she forget...?）",C_GREEN,2,0) 
			ENDIF
		CASEELSE
			IF TALENT:恋慕
				;PRINTFORML 
			ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
				PRINTFORML 「...You're just pretending to apologize aren't you?」
				CALL COLORMESSAGE14(@"　No I... Didn't mean it like that...",C_GREEN,2,0) 
			ELSE
				PRINTFORML 「Don't mess around! You know what you did to me?!」
				PRINTFORML 「Oh I get it! You just wanna keep picking fights with me, is that it?! I'm ready to kick your butt anytime!」
				CALL COLORMESSAGE14(@"　Eek...! I-I'm really sorry!!",C_GREEN,1,0)  
				CALL COLORMESSAGE14(@"　W-What should I do? She's still mad at me...",C_GREEN,2,0) 
			ENDIF
		ENDSELECT
ENDIF
RESETCOLOR
RETURN 1
