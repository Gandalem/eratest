;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
		IF CFLAG:318 == 1
		;ELSEIF TALENT:恋慕
			;PRINTFORML 
		ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「Fast asleep...」
					CALL COLORMESSAGE14(@"　Zzz... Zzz...",C_GREEN,1,0)
					PRINTFORML 「Fufufu, now's a good time for a prank!」
					PRINTFORML 「I'll put this ice on your back and..」
					CALL COLORMESSAGE14(@"　Zzz... Zzz... I love you... Cirno-chan...",C_GREEN,1,0)
