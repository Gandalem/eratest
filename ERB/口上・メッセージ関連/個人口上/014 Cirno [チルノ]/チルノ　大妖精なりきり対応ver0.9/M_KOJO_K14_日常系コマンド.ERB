RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_416_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORML
	ELSEIF CFLAG:行動 == 5 && CFLAG:MASTER:現在位置 == 広場
		PRINTFORML 「Don't bother the ice cream sellerー!」
		PRINTFORMW 「Or I'll turn you into a popsicle!」
	ELSEIF TALENT:恋慕
				;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORMW 「Hoeeー That's amazing...」
				CALL COLORMESSAGE14(@"「Aw... I wanna have a jam session with Dai-chan tooー」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　If you practiced an instrument for a bit, you'd be able to, Cirno-chan!",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「Really?! Yeahー! I'll do itー!」",C_AQUA,2,0)
			CASE 0
				PRINTFORMW 「What's that? It looks like fun! Lemme try lemme try!」
				CALL COLORMESSAGE14(@"　D-Don't break it, okay?",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「Graahhh! What an ear-splitting sound!」
				PRINTFORMW 「Even ice would shatter into pieces!」
				CALL COLORMESSAGE14(@"　I was doing fine earlier...",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE TFLAG:193
			CASE 1
				PRINTFORMW 「Ooh! It's starting to get exciting!」
			CASE 0
				PRINTDATAW
					DATAFORM 「I thought for sure it was a frog croaking funny.」
					DATAFORM 「Wow, are you some kind of poltergeist reincarnation or what?」
					DATAFORM 「My own stage theme showed up!」
				ENDDATA
			CASEELSE
				PRINTFORMW 「Be quiet! You've been clanging and banging since the morning!」
				CALL COLORMESSAGE14(@"　S... Sorry.",C_GREEN,2,0)
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
