@M_KOJO_MESSAGE_COM_K14_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		;ELSEIF TALENT:恋慕
		;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「응? 이 차 차네.」
				CALL COLORMESSAGE14(@"　너도 마실 수 있게 말이야, 서노짱!",C_GREEN,1,0)
				PRINTFORMW 「아직 충분히 차갑지 않아... 좀 더 식혀야겠어!」
				CALL COLORMESSAGE14(@"　떠다니던 차 줄기가 이제 얼어버렸다...",C_GREEN,2,0)
			CASE 0
				CALL COLORMESSAGE14(@"　시르노쨩의 차에는 설탕을 몇 개 넣고 싶어?",C_GREEN,1,0)
				PRINTFORMW 「나 건 설탕 세 개 넣어줘.」
				CALL COLORMESSAGE14(@"　3도 원해요... 정말 탐스럽네요.",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「차 맛있어ー!」바삭
				CALL COLORMESSAGE14(@"　실례지만 시르노, 네가 들고 있는 그 아이스크림 막대 말인데...",C_GREEN,1,0)
				PRINTFORMW 「내가 그걸 아이스크림으로 만들었어!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「너무 쓰네! 한 잔 더 줘!」
				CALL COLORMESSAGE14(@"　음... 괜찮아? 좀 녹고 있는 것 같은데...",C_GREEN,2,0)
			CASE 0
				PRINTFORML 「차는 이렇게 대접해야 하는 거지... 이처럼!」
				CALL COLORMESSAGE14(@"　와... 아무것도 없었는데 얼음이 나타났어...!",C_GREEN,1,0)
				;Missing context makes this conversation sound weird
				PRINTFORML 「후~ 내가 제일 강하지 않아?」
				PRINTFORML 「...쓰네!」
				CALL COLORMESSAGE14(@"　다음에 설탕 좀 가져올게, 알겠지?",C_GREEN,2,0)
			CASEELSE
				CALL COLORMESSAGE14(@"　실례합니다, 서노 씨. 저... 차 한 잔 하시겠어요?",C_GREEN,1,0)
				PRINTFORML 「이렇게 뜨거운 음료를 나에게 건네는 게, 그냥 괴롭히는 거 아니야?」
				CALL COLORMESSAGE14(@"　아...! 정말 미안해...",C_GREEN,1,0)
				PRINTFORML 「음, 이 뜨거운 차조차 못 마시면 내가 최강자라는 명성이 날아가 버리겠어!」
				PRINTFORMW 「...뜨겁다고!!」
		ENDSELECT
	ENDIF
	RETURN 1
ENDIF
RESETCOLOR
RETURN 1
