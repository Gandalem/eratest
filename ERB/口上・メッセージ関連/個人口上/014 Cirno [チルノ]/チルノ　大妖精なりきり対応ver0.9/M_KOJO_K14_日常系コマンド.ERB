;402,就寝
;TFLAG:193(0=通常 1=子供と一緒に川の字で寝る)
;==================================================

@M_KOJO_MESSAGE_COM_K14_402
;就寝にTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K14_402_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_402_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	IF CFLAG:318 == 1
		;ELSEIF TALENT:恋慕
		;PRINTFORML
	ELSEIF TALENT:思慕 || CFLAG:14:1002 == 1
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「깊이 잠들어...」
				CALL COLORMESSAGE14(@"　쿨쿨... 쿨쿨...",C_GREEN,1,0)
				PRINTFORML 「후훗, 지금이 장난치기 딱 좋은 때야!」
				PRINTFORML 「네 등에 이 얼음을 붙이고...」
				CALL COLORMESSAGE14(@"　꾸르륵... 꾸르륵... 사랑해... 시르노짱...",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「...그럴 줄 알았는데, 당신이 너무 편안하게 자고 있으니 사양할게.」",C_AQUA,2,0)
			CASE 0
				PRINTFORMW 「좀 더 하고 싶은데... 뭐, 어쩔 수 없지.」
				CALL COLORMESSAGE14(@"　미안해. 오늘보다 너랑 훨씬 더 많이 놀아줄게.",C_GREEN,1,0)
				CALL COLORMESSAGE14(@"「그건 약속이야. 안녕, 다이짱!」",C_AQUA,1,0)
				CALL COLORMESSAGE14(@"　안녕, 시르노쨩...",C_GREEN,2,0)
			CASEELSE
				PRINTFORMW 「이 시간에 잠드는 건 작은 생물뿐이야!」
				CALL COLORMESSAGE14(@"　너무 늦게까지 깨어 있지 마, 알겠지?",C_GREEN,2,0)
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 「나도 잠들까 봐。」
				PRINTFORMW 「하지만 여기 너무 더워... 어디가 잘 곳이 좋을까...?」
			CASE 0
				CALL COLORMESSAGE14(@"　미안해, 나 벌써 너무 졸려... 시르노 씨는 아직 전혀 안 피곤해?",C_GREEN,1,0)
				PRINTFORML 「얼음 요정들은 "신데렐라" 같은 시간은 없어!」
				PRINTFORMW 「지금은 내 차례야!」
				CALL COLORMESSAGE14(@"　아직도 그렇게 활기차네. 질투 나... 뭐, 잘 자.",C_GREEN,2,0)
			CASEELSE
				PRINTFORML 「네가 자는 동안, 나는 더 놀러 갈게!」
				PRINTFORMW 「Uoー!」
		ENDSELECT
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
