				CASEELSE
					PRINTFORML 「Eat my Danmakuー!」Splash!
					CALL COLORMESSAGE14(@"　Kyaa! Alright! I'm not gonna lose!",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"　Ei! Ei!（Splash Splash）",C_GREEN,1,0)
