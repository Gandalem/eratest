				CASE 0
					PRINTFORMW 「I wanna play some more... Well, can't be helped.」
					CALL COLORMESSAGE14(@"　Sorry. I'll play with you a lot more than I did today.",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「That's a promise. Good night Dai-chan!",C_AQUA,1,0)
