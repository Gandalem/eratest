;621,釣りをする
;TFLAG:193(0=釣れない 1～4=魚 11～15=うまい魚 610=木材 131=守矢の守札 21=ローター 609=氷の鱗 606=龍の爪)
;TFLAG:194(1000以上ならTARGETが釣った)
;==================================================

@M_KOJO_MESSAGE_COM_K14_621
CALL M_KOJO_MESSAGE_COM_K14_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K14_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SETCOLOR C_AQUA
	LOCALS = %ITEMNAME:(TFLAG:193)%
	IF FLAG:時間停止
	ELSEIF CFLAG:318 == 1
		PRINTFORML 
	ELSEIF LOCALS == "カエル"
		;カエルを釣るとチルノが欲しがる。何個もあげると何かもらえる。
		PRINTFORMW 「아! 개구리다! 갖고 싶어!」
		PRINTFORML
		PRINTFORML  
		PRINTFORMW 　너는 치르노에게 개구리를 줄 거니?
		CALL ASK_YN
		IF !RESULT
			CALL LOST_ITEM("カエル",1,2)
			CALL COLORMESSAGE14(@"　물론이지, 네가 가질 수 있어. 부디 아껴줘.",C_GREEN,1,0)
			PRINTFORMW 「야호! 정말 고마워!」
			CFLAG:14:1003 ++
			SELECTCASE CFLAG:14:1003
				CASE 5,10,15
					PRINTFORML 「계속 개구리를 주니 이걸 받아!」
					CALL COLORMESSAGE14(@"　너무 예쁘네... 이걸 내가 가져도 정말 괜찮을까?",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「괜찮다고 했잖아ー?」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　정말 행복해... 이 선물을 소중히 간직할게.",C_GREEN,2,0)
					CALL GET_ITEM("氷の鱗",1,2)
				CASEELSE
			ENDSELECT
		ELSE
			CALL COLORMESSAGE14(@"　미안하지만 이 개구리는 내가 갖고 싶어.",C_GREEN,1,0)
			PRINTFORMW 「무슨 문제야-? 정말 인색하네!」
		ENDIF
	ELSEIF TALENT:恋慕 || TALENT:思慕 || CFLAG:14:1002 == 1
		IF TFLAG:194 > 1000
			;チルノが釣った
			SELECTCASE RAND:3
				CASE 1
					PRINTFORML 「가까운 싸움으로 번질 줄이야. 이 물고기 꽤 좋았다.」
					CALL COLORMESSAGE14(@"　네가 여기 없었다면 분명 도망쳤을 거야, 서노쨩.",C_GREEN,2,0)
				CASE 0
					PRINTFORML 「흥, 내가 최고지 않나? 뭐든지 잡을 수 있을 것 같아!」
					PRINTFORML 「다음 것도! 다음 것도 말이야!」
					CALL COLORMESSAGE14(@"　다음에 뭘 잡을지 궁금하다.",C_GREEN,2,0)
				CASEELSE
					PRINTFORML 「오, 오오오...?」
					CALL COLORMESSAGE14(@"　시르노짱, 끌어올려!",C_GREEN,1,0)
					PRINTFORML 「질 수 없어! 구누누누!」
					CALL COLORMESSAGE14(@"　아, 봤어! 계속 해 봐!",C_GREEN,1,0)
					PRINTFORMDL 물고기 잡았다!
					PRINTFORMW 「잡았다! 어때? 포기할 거야?!」
					CALL COLORMESSAGE14(@"　역시 치르노짱답다!",C_GREEN,2,0)
			ENDSELECT
		ELSE
			SELECTCASE TFLAG:193
				CASE 0
					;何も釣れない
					SELECTCASE RAND:3
						CASE 1
							PRINTFORML 「물고기를 잡으면 그걸로 뭘 만들어야 할까? 튀김이 좋겠다. 데리야키도!」
							PRINTFORML 「회도 꽤 맛있을 것 같아. 생각만 해도 군침 도네.」
							CALL COLORMESSAGE14(@"　요리는 나에게 맡겨줘, 시르노쨩!",C_GREEN,2,0)
						CASE 0
							PRINTFORMW 「물고기 한 마리도 못 잡았어. 아마 미끼로는 마블보다 아폴로가 더 나을지도.」
							CALL COLORMESSAGE14(@"　...치르노짱. 낚시에 초콜릿을 쓰는 건 좀...",C_GREEN,1,0)
							CALL COLORMESSAGE14(@"「하나 잡을 거야!」",C_AQUA,1,0)
							CALL COLORMESSAGE14(@"　정말인가...",C_GREEN,2,0)
						CASEELSE
							CALL COLORMESSAGE14(@"　...미끼가 도저히 안 물리는군.",C_GREEN,1,0)
							PRINTFORMW 「젠장, 물고기야! 이제 우리 놀리는 거지...!」
					ENDSELECT
				CASE 1 TO 4
					;魚が釣れた
					CALL COLORMESSAGE14(@"「꽤 잘하고 있어 다이쨩, 하지만 나 너한테 지지는 않을 거야!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　네가 시르노쨩이라면 분명 나보다 더 큰 물고기를 잡을 거야.",C_GREEN,1,0)
					PRINTFORMW 「가장 큰 물고기를 잡을 거야! 내 목표는 인어야!」
				CASE 11 TO 15
					;うまい魚が釣れた
					PRINTFORML 「오! 맛깔스러워 보이는 물고기야!」
					CALL COLORMESSAGE14(@"　치르노쨩, 부탁 하나 해도 괜찮을까?",C_GREEN,1,0)
					CALL COLORMESSAGE("「하! 나에게 맡겨둬. 저 물고기들을 전부 얼려주마!」",C_AQUA,1,0)
					CALL COLORMESSAGE14(@"　시르노쨩이 여기 있으니 이 물고기들을 모두 신선하게 내줄 수 있다.",C_GREEN,2,0)
				CASE 610
					;木材が釣れた
					CALL COLORMESSAGE14(@"　하아... 하아... 큰 걸 잡은 줄 알았는데, 그냥 가라앉은 통나무였어.",C_GREEN,1,0)
					PRINTFORMW 「이 로그는 검 싸움에는 좋을 것 같지 않군. 정말 아깝다.」
				CASE 131
					;守矢の守札が釣れた
					PRINTFORML 「이 종이는 뭐야?」
					PRINTFORML 「너무 축축해서 코를 풀 때도 쓸 수 없을 정도야.」
					CALL COLORMESSAGE14(@"　이거... 복권인가? 이걸 5개 모으면 상품을 딸 수 있을 것 같다.",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「정말 고통이군. 이런 것들 중 하나만 있으면 더 성가시지 않을 텐데.」",C_AQUA,2,0)
				CASE 21
					;ローターが釣れた
					PRINTFORML 「미친 듯이 진동하고 있어. 도대체 무슨 일이야?」
					CALL COLORMESSAGE14(@"　설마 그럴 리가?!",C_GREEN,1,0)
					PRINTFORML 「음? 이것에 대해 아는 것 있어?」
					CALL COLORMESSAGE14(@"　음... 시르노짱, 이 건 사용되는 거야... 여자애가...",C_GREEN,1,0)
					PRINTFORMW 「야! 말해봐! 말해줘, 말해줘!」
					CALL COLORMESSAGE14(@"　~절망적이야. 말해줄 수 없어!",C_GREEN,1,0)
					CALL COLORMESSAGE14(@"「부-' ...너 정말 인색하구나.」",C_AQUA,2,0)
				CASE 609
					;氷の鱗が釣れた
					PRINTFORMW 「아, 그거 내가 지난번에 버린 거야.」
					CALL COLORMESSAGE14(@"　응?",C_GREEN,2,0)
				CASE 606
					;龍の爪が釣れた
					PRINTFORML 「이게 뭐야? 정말 큰 발톱이야? 송곳니인가? 요괴의 건가?」
					CALL COLORMESSAGE14(@"　정말 무섭다... 어쩌면 이 근처에 거대한 요괴가 자라고 있는 건지도 모른다.",C_GREEN,1,0)
					PRINTFORML 「근처에 있나― 만약 내가 그것을 길들여 내 애완동물이 된다면, 두려워할 것이 아무것도 없을 거야!」
					CALL COLORMESSAGE14(@"　으악! 우리 그거랑 마주치지 않았으면 좋겠다...",C_GREEN,2,0)
				CASEELSE
					PRINTFORMW 「뭐 잡았어?」
			ENDSELECT
		ENDIF
	ELSE
		SELECTCASE RAND:4
			CASE 2
				PRINTFORML 「기다리는 게 너무 지루해.」
				CALL COLORMESSAGE14(@"　기다리는 것이 진정한 낚시의 매력이라고... 적어도 나는 그렇게 들었다.",C_GREEN,1,0)
				PRINTFORMW 「저기 가서 놀다 올게!」
			CASE 1
				PRINTFORMW 「개굴이 있으면 나한테 줘!」
				CALL COLORMESSAGE14(@"　한 마리나 끌어올릴 수 있을지 궁금하네... 최선을 다해야지.",C_GREEN,2,0)
			CASE 0
				PRINTFORMW 「꾸르릉...」
