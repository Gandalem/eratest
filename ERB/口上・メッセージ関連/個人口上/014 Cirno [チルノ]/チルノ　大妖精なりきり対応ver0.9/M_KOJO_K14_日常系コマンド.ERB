@M_KOJO_MESSAGE_COM_K14_304_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
SETCOLOR C_AQUA
		;時間停止中
		IF FLAG:70
		;人間の里の広場でアイス売り
		;ELSEIF CFLAG:MASTER:現在位置 == 2 || CFLAG:MASTER:現在位置 == 202
		ELSEIF GET_MAPID(CFLAG:職場) == 2 ;custom code from dialogue tweak patch
			;IF TALENT:恋慕
				;PRINTFORML 
			IF TALENT:思慕 || CFLAG:14:1002 == 1
				SELECTCASE RAND:3
					CASE 1
						PRINTFORML 「Aw manー! It's soo sweltering hot!」
						PRINTFORMW 「I wouldn't be able to go on without any of this ice cream.」
						CALL COLORMESSAGE14(@"　C-Cirno-chan... Can I have something to eat?",C_GREEN,1,0)
						CALL COLORMESSAGE14(@"「Sure, here's your share.」",C_AQUA,1,0)
						CALL COLORMESSAGE14(@"　Gulp...",C_GREEN,2,0)
					CASE 0
						PRINTFORML 「Wonder if I should promote the store with some flyersー? Spice 'em up with cool facts about me, whether they're true or not, if need be.」
						CALL COLORMESSAGE14(@"　How about putting an ad in that Tengu's newspaper?",C_GREEN,1,0)
						CALL COLORMESSAGE14(@"「Something like 'Punisher of Giant toads! The strongest ice fairy Cirno's strongest ice cream!'」",C_AQUA,2,0)
					CASEELSE
						PRINTFORML 「Didja know? That shrine maiden in green has to go all over the human village and yap all day.」
						CALL COLORMESSAGE14(@"　And that shrine maiden in red goes around exterminating youkai.",C_GREEN,1,0)
						PRINTFORMW 「I sorta get the difference between them now.」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 1
						CALL COLORMESSAGE14(@"　Uhm, Cirno-san, aren't you afraid of humans?",C_GREEN,1,0) 
