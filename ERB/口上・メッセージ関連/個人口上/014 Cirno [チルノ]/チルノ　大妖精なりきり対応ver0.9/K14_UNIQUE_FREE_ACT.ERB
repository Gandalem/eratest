; Modular ERB: 個人口上/014 Cirno [チルノ]/チルノ　大妖精なりきり対応ver0.9/K14_UNIQUE_FREE_ACT.ERB

@UNIQUE_FA_14(CHARA, ARGS,時間係数)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIMS FROG_STATE
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
UNIQUE_FA_NAME:CHARA = freezing frogs
SELECTCASE ARGS
	CASE "発生"
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		SIF !WATERAREA(現在地)
			RETURN 0
		IF メッセージ表示
			PRINTFORMD 시르노는 개구리들을 얼리기 시작한다 
			SELECTCASE WATERAREA(現在地)
				CASE 1
					PRINTFORMDL 호수.
				CASE 2
					PRINTFORMDL 강가에서.
			ENDSELECT
		ENDIF
		FROG_STATE =
		;返し値は行動時間
		RETURN 150
	CASE "行動中"
		IF 現在地 == GET_MAP_REPLACEMENT(P708大蝦蟇の池) && !RAND:10 ;caught by giant toad
			IF メッセージ表示
				PRINTFORMDL 치르노가 개구리들과 놀이에 몰두하고 있을 때, 거대한 그림자가 갑자기 그녀 위로 드리워졌다.
				IF ABL:CHARA:戦闘能力 < 6
					PRINTFORMDL 그러고는 긴 혀를 내밀어 서노 주위를 감싸 한 번에 크게 삼켜버렸다.
					CALL CHARA_TEXT(CHARA, "「와아아아아아악!」", "w")
					PRINTFORMDL 본능적으로 그녀는 거대한 두꺼비 안에서 얼어붙으며 겁에 질려 도망친다.
					PRINTFORMDW 그 거대한 두꺼비는 갑작스러운 공격에 약간 놀란 듯 보이지만, 다친 것 같지는 않다.
				ELSE
					PRINTFORMDW 하지만 그녀에게 직접적으로 맞서지는 듯 망설이는지 지켜볼 뿐 아무것도 하지 않았다.
				ENDIF
			ENDIF
			;massive stamina hit, sent to sleep
			IF ABL:CHARA:戦闘能力 < 6
				CALL RECOVER(CHARA, -MAXBASE:CHARA:体力, "体力", "거대한 두꺼비에게 삼켜졌다.")
				CALL RUNOFF(CHARA)
				Activity_Duration:CHARA = 0
				Activity_Type:CHARA = 0
			ENDIF
		ELSEIF メッセージ表示
			IF FROG_STATE == "frozen"
				LOCAL = 0
				SELECTCASE ABL:CHARA:戦闘能力
					CASE IS >= 6
						PRINTFORMDW 개구리 시르노는 해동되면서 무슨 일이 일어났는지 전혀 깨닫지 못한 채 아무렇지도 않게 걸어갔다.
						RETURN
					CASE 5
						LOCAL = !RAND:20
					CASE 4
						LOCAL = !RAND:10
					CASE 3
						LOCAL = !RAND:6
					CASE 2
						LOCAL = !RAND:4
					CASE 1
						LOCAL = !RAND:3
				ENDSELECT
				IF LOCAL
					PRINTFORMDW 그녀의 최선의 노력에도 불구하고, 가련한 개구리 시르노는 조각들로 얼어붙는다.
				ELSE
					PRINTFORMDW 개구리 시르노는 결국 얼음에서 풀렸고, 아무 일도 없었다.
				ENDIF
				FROG_STATE =
			ELSE
				PRINTFORMDL 시르노가 개구리를 얼리고 있다.
				IF ABL:CHARA:戦闘能力 >= 6
					PRINTFORMDW 순식간에 얼어 완벽하게 매끄러운 얼음 공을 형성한다.
				ELSE
					PRINTFORMDW 그녀는 개구리를 꾸준히 얼려 얼음으로 감싼다.
				ENDIF
				FROG_STATE = frozen
			ENDIF
		ENDIF
	CASE "完了"
		SIF メッセージ表示
			PRINTFORMDW 시르노는 개구리를 얼리는 것에 질렸다.
	CASE "中断"
		;中断メッセージはうふふ突入時等でも表示されてしまうので表示しない
	CASE "付き合う"
		PRINTFORMDL 당신은 치르노가 개구리를 얼리는 것을 지켜본다.
		IF TFLAG:193 < 0
			PRINTFORMDW 별로 재미없다.
		ELSE
			PRINTFORMDW 그녀의 열정을 보는 것은 재미있다.
		ENDIF
	CASE "ソース"
		DOWNBASE:MASTER:気力 += 20 * 時間係数
		DOWNBASE:TARGET:気力 += 20 * 時間係数
		SOURCE:歓楽 = (100 + ((ABL:親密 + ABL:MASTER:話術技能) * 50)) * 時間係数
		SOURCE:受動 = (60 + ((ABL:従順 + ABL:MASTER:話術技能) * 30)) * 時間係数
ENDSELECT

@M_KOJO_自由行動判定_K14(ARG)
;if frog freezing is possible, always do that
SIF WATERAREA(CFLAG:[[チルノ]]:現在位置) && ARG > 0
	RETURN -1
RETURN 0
