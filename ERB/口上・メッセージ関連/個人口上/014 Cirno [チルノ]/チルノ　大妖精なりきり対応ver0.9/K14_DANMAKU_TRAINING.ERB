;custom code
@K14_TRAINING_NIGHTLY
;a steady trickle of xp per day
IF ABL:[[チルノ]]:戦闘能力 < 6 && CFLAG:[[チルノ]]:弾幕勝負勝利
    EXP:[[チルノ]]:戦闘経験 += RAND(1, MAX(ABL:[[チルノ]]:戦闘能力 + 1, 2))

    IF !RAND:5 ;occasionally show a message
        CALL EVENTEND_TSUBUYAKI
        SELECTCASE RAND:5
            CASE 4
                PRINTFORMDL Cirno is lying on the ground, reading Marisa's Danmaku book.
                PRINTFORML 「Whoa. That's a great idea! I should make one like that, too.」
                PRINTFORML 「Of course, mine's gonna be even more super awesome than this one.」
                PRINTFORML 「Hmmm, what should I start with...」
                PRINTFORMDW Cirno spends some time thinking about new spell cards before she falls asleep.
            CASE 3
                PRINTFORML 「Huff... huff... huff...」
                PRINTFORML 「I gotta be even faster if I wanna be the strongest.」
                PRINTFORMDW Cirno is running laps around the lake, trying to build up her stamina.
            CASE 2
                ;freezing lake
                PRINTFORML 「Take this! My super awesome freeze!」
                PRINTFORMDL Cirno is freezing part of the lake using her powers.
                PRINTFORML 「I can't be the strongest until I can freeze all of it.」
                PRINTFORMDW Still full of energy, she continues practicing until she gets tired.
            CASE 1
                ;stacking frogs
                PRINTFORML 「There, all perfect. I'm in top shape today.」
                PRINTFORMDW Cirno is stacking frozen frogs by the lake.
            CASE 0
                PRINTFORML 「Take this!」
                PRINTFORMDL Cirno is firing Danmaku at a bunch of fairies.
                PRINTFORML 「I gotta keep working hard if I wanna be the strongest.」
        ENDSELECT
    ENDIF
ENDIF

@K14_PLAYER_TRAINING
IF FIRSTTIME("CirnoTraining")
    PRINTFORML 「You wanna train under me?」
    PRINTFORML 「Fufufu, you did well to come to me, the strongest fairy.」
    PRINTFORML 「Awright. Follow me and I'll make you the strongest one of them all.」
    PRINTFORML 「After myself, of course.」

    PRINTFORMDL You spend some time practicing with Cirno.
    IF ABL:MASTER:戦闘能力 < ABL:[[チルノ]]:戦闘能力
        PRINTFORMDW She's a terrible teacher, but you still pick up some things from her extensive experience.
    ELSE
        PRINTFORMDW Despite proclaiming you as her pupil, you spend most of the time giving her advice instead.
    ENDIF
ELSE
    SELECTCASE RAND:2
        CASE 1
            PRINTFORML 「Lemme show you how to dodge like a champ.」
            PRINTFORMDL Cirno creates a bunch of snow and starts weaving through it.
            PRINTFORML 「You just have to...」
            PRINTFORMDW Cirno's advice is incomprehensible, but you still pick up a few techniques from her movements.
        CASE 0
            PRINTFORML 「Today I'll teach you how to freeze bullets.」
            PRINTFORML 「All you gotta do is...」
            PRINTFORMDL （Mumble mumble, so-and-so...）
            PRINTFORMD Cirno tries to teach you her freezing techniques
            IF !TALENT:MASTER:氷精
                PRINTFORMDW , though you're obviously not able to copy it.
            ELSE
                PRINTFORMDW , but she's really hard to understand.
            ENDIF
    ENDSELECT
ENDIF
;slight bonus for player
EXP:MASTER:戦闘経験 += 1
;decent bonus for her
SELECTCASE ABL:[[チルノ]]:戦闘能力
    CASE 5
        EXP:[[チルノ]]:戦闘経験 += 10
    CASE 4
        EXP:[[チルノ]]:戦闘経験 += 7
    CASE 3
        EXP:[[チルノ]]:戦闘経験 += 5
    CASE 2
        EXP:[[チルノ]]:戦闘経験 += 3
    CASE 1
        EXP:[[チルノ]]:戦闘経験 += 2
ENDSELECT

@K14_COMBAT_SKILL_UP
SELECTCASE ABL:戦闘能力
    CASE 6
        PRINTFORML 「Whoa. I'm so strong now I even scare myself.」
        PRINTFORML 「Even %CALLNAME:MASTER% won't stand a chance against me now!」
        PRINTFORMW 「Fufufu. I should prepare for our rematch immediately.」
    CASE 5
        PRINTFORML 「Amazing. I'm stronger than I've ever been before.」
        PRINTFORML 「I bet even the red-and-white can't beat me now!」
        PRINTFORMW 「But there's still one more obstacle I need to overcome...」
    CASE 4
        PRINTFORML 「Eat this!」
        PRINTFORMDL Cirno shoots an intricate pattern of Danmaku towards Meiling, whom she had been sparring with.
        PRINTFORMDL Despite her efforts, the gate guard is unable to avoid the attack, and ends up conceding defeat.
        CALL CHARA_TEXT([[美鈴]], "「Wow. When did you get this strong?」")
        PRINTFORML 「I've always been this strong! I just didn't realize it yet.」
        PRINTFORML 「Now I'm off to find my next challenge.」
        CALL CHARA_TEXT([[美鈴]], "「Even the fairies are getting so strong.」")
        CALL CHARA_TEXT([[美鈴]], "「Hmmm, maybe I need to work harder too, if I want to stay here as the guard.」", "w")
    CASE 3
        PRINTFORMDL Cirno stands over a defeated youkai.
        PRINTFORMDL It has no name and is of no importance, but it nonetheless looks like it cannot believe it lost to a fairy.
        PRINTFORML 「Hmpf, none of these small fry can stand up against me. You're not even worth fighting.」
        PRINTFORMW 「I need to find a better opponent if I wanna become even stronger.」
    CASEELSE
        PRINTFORML 「Awesome, I've gotten even stronger.」
        PRINTFORMW 「Can't stop now, though. This is only the beginning of the legend of the strongest.」
ENDSELECT
