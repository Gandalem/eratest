; Modular ERB: 個人口上/079 Hina [雛]/eraTW用鍵山雛口上/追加ファイル/M_KOJO_K79_特殊イベント.ERB
;==================================================
;@M_KOJO_MESSAGE_EVENT_K79_EX_TALK
;祭日限定特殊会話イベント([恋人]要)
;==================================================

@M_KOJO_MESSAGE_EVENT_K79_EX_TALK
;元日(春1日) プレイ初日は発生しない
IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1
	PRINTFORML %CALLNAME:MASTER%, 새해 복 많이 받으세요.
	PRINTFORML 　올 한 해 동안 정말 신세 많이 졌습니다. 올해도 잘 부탁드립니다.
	PRINTFORMW 히나와 새해 인사를 나눴다.
	PRINTFORML 「...멋진 1년이 되었으면 좋겠네, %CALLNAME:MASTER%?」
	PRINTFORMW 인사를 마치자 히나는 표정을 풀고 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다.
	TCVAR:79:350 = 2
	;雛祭り(春3日)
ELSEIF DAY:2 == 1 && DAY:3 == 3
	PRINTFORML 「자, 오늘은 손꼽아 기다렸던 히나마츠리!」
	PRINTFORMW 언제였더라, 히나가 의욕으로 가득 찬 것 같은 기분이 들었다.
	PRINTFORML 「강에 흘러가는 대량의 나기히나. 이걸 전부 회수하는 게 오늘의 임무야.」
	PRINTFORMW ……생각했던 것보다 힘들어 보인다.
	TCVAR:79:350 = 2
	;ホワイトデー(春14日)
ELSEIF DAY:2 == 1 && DAY:3 == 14
	PRINTFORML 「화이트데이인가……」
	PRINTFORMW 멍한 표정으로 히나는 그렇게 중얼거렸다.
	PRINTFORML 「후후… 잘 부탁할게, %CALLNAME:MASTER%?」
	PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 답례를 기대하고 있는 듯했다…….
	TCVAR:79:350 = 2
	;例大祭(春25日)
ELSEIF DAY:2 == 1 && DAY:3 == 25
	PRINTFORML 「하쿠레이 신사 대축제 오늘이었네, 완전히 잊고 있었어.」
	PRINTFORMW ...아무래도 대축제의 인지도는 아직 낮은 것 같다.
	PRINTFORML 「나중에 잠깐 가서 상황을 보러 갈까? 물론 %조사처리(CALLNAME:MASTER,"랑")% 같이 말이야, 응?」
	PRINTFORMW 시간이 있다면 데이트에 초대해 주는 것도 좋을지도 모르겠어…….
	TCVAR:79:350 = 2
	;七夕(夏7日)
ELSEIF DAY:2 == 2 && DAY:3 == 7
	PRINTFORML 오늘은 치타쿠네.
	;時間帯で分岐
	;夜
	IF TIME:2 == 6
		;天気で分岐
		IF TIME:5 == 0 || TIME:5 == 1
			PRINTFORML 　날씨도 딱 좋아서 무사히 볼 수 있어서 다행이야.
			PRINTFORMW 밤하늘에는 견우성과 직녀성이 빛나고 반짝이고 있어…….
		ELSEIF TIME:5 == 2 || TIME:5 == 3
			PRINTFORML 　구름 사이로, 조금은 보이지만……
			PRINTFORMW 눈부신 빛을 내는 견우성(牽牛星)과 직녀성(織女星)이 가끔 구름 사이로 나타났다 사라진다.
		ELSEIF TIME:5 == 4 || TIME:5 == 5
			PRINTFORML 　아쉽지만, 올해는 볼 수 없을 것 같네요.
			PRINTFORMW 비는 한동안 그칠 기미가 보이지 않는다. 아무래도 포기할 수밖에 없는 모양이다…….
		ELSE
			PRINTFORMW 　소원은 닿지 않는 건가……. ?
			PRINTFORMW 아무래도 그런 것 같다…….
		ENDIF
		TCVAR:79:350 = 2
		;朝 or 昼
	ELSE
		;天気で分岐
		IF TIME:5 == 0 || TIME:5 == 1
			PRINTFORML 　이대로 날씨가 흐려지지 않으면 볼 수 있을 것 같아.
			PRINTFORMW 초여름의 햇살이 내리쬐고 있어. 이것이라면 무사히 볼 수 있겠어.
		ELSEIF TIME:5 == 2 || TIME:5 == 3
			PRINTFORML 　음, 밤까지 구름이 사라졌으면 좋겠는데…….
			PRINTFORMW 우츠호는 두꺼운 구름에 뒤덮여 있다. 운 좋게 구름 사이로 보일 수 있도록 기도할 수밖에 없을 것 같다.
		ELSEIF TIME:5 == 4 || TIME:5 == 5
			PRINTFORML 　하지만 이 비로는 보기 어려울지도….
			PRINTFORMW 비는 지금도 계속 내리고 있다. 왜 이런 날에만 날씨가 나빠지는 걸까…….
		ELSE
			PRINTFORMW 　……과연, 제대로 볼 수 있을까?
			PRINTFORMW 「하늘의 강이 보이기를」이라고, 기도해야 할지도 모른다.
		ENDIF
		TCVAR:79:350 = 2
	ENDIF
	;収穫祭(秋27日)
ELSEIF DAY:2 == 3 && DAY:3 == 27
	PRINTFORML 「올해도 수확제가 시작되었네. 시즈하와 미노리코가 바빠 보였어.」
	PRINTFORMW 산에 사는 신들끼리니 그쪽 사정은 제대로 파악하고 있는 것 같다.
	TCVAR:79:350 = 2
	;ハロウィン(秋30日)
ELSEIF DAY:2 == 3 && DAY:3 == 30
	PRINTFORML 「할로윈...? 서양의 축제?」
	PRINTFORML 　아이들이 분장해서 요괴나 유령이 되어 사탕을 받는, 과연 신기한 축제구나……」
	PRINTFORMW 아무래도 할로윈이라는 개념을 제대로 이해하지 못하고 있는 모양이다.
	TCVAR:79:350 = 2
	;バレンタインデー(冬14日)
ELSEIF DAY:2 == 4 && DAY:3 == 14
	PRINTFORML 「%조사처리(CALLNAME:MASTER,"를")% 위해 열심히 만들었으니까, 맛보고 먹어줘」
	PRINTFORMW 속일 수 없는 히나의 진심초콜릿이다. 맛보며 먹자.
	PRINTFORML 「그리고……, 답례도 기대하고 있을 테니까?」
	PRINTFORMW 그런 점은 재빠하군.
	TCVAR:79:350 = 2
	;クリスマス(冬25日)
ELSEIF DAY:2 == 4 && DAY:3 == 25
	PRINTFORML 「메리 크리스마스. ……라니 말이야」
	PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 크리스마스를 축하했다…….
	TCVAR:79:350 = 2
	;大晦日(冬31日)
ELSEIF DAY:2 == 4 && DAY:3 == 31
	PRINTFORML 「올해도 눈 깜짝할 새에 끝나버렸네……」
	PRINTFORMW 그렇게 말하는 히나는 감상에 잠겨있다…….
	PRINTFORMW 「어쨌든, 내년에도 잘 부탁해. %CALLNAME:MASTER%?」
	TCVAR:79:350 = 2
ELSE
	TCVAR:79:350 = 1
ENDIF
RETURN 1
;==================================================
;@M_KOJO_MESSAGE_EVENT_K79_EX_350
;祭日限定特殊押し倒しイベント([恋慕]要)
;
;★祭日押し倒し&祭日押し倒されのフラグ(TCVAR:79:359)は競合する
;　いずれか片方がその日既に実行済みの場合、もう一方は発生しない
;==================================================

@M_KOJO_MESSAGE_EVENT_K79_EX_350
;元日(春1日) プレイ初日は発生しない
IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1
	PRINTFORML 「『한 해의 계획은 새해에 있다』고 말하지만…….」
	PRINTFORML 　새해부터 에치하면, 올해는 계속 에치하게 되는 걸까? 후훗」
	PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 덮침을 히나는 상냥하게 받아들이고, 새해 첫 번째 에치를 하기로 했다…….
	TCVAR:79:359 = 2
	;雛祭り(春3日)
ELSEIF DAY:2 == 1 && DAY:3 == 3
	PRINTFORML 「히나마츠리는 여자아이들을 축하하는 날이야. 그러니까, 그게... 오늘은 상냥하게 대해줘...?」
	PRINTFORMW 히나는 달콤한 목소리로 속삭이며 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다…….
	TCVAR:79:359 = 2
	;ホワイトデー(春14日)
ELSEIF DAY:2 == 1 && DAY:3 == 14
	PRINTFORML 「후훗, 발렌타인 답례로 덮치다니……. 뭐, 나는 기쁘니까 괜찮지만.」
	PRINTFORML 　그럼 오늘은 평소보다 %조사처리(CALLNAME:MASTER,"에게")% 응석을 받아볼까……」
	PRINTFORMW 그렇게 말하자, 히나는 %조사처리(CALLNAME:MASTER,"에게")% 매달려 왔다…….
	TCVAR:79:359 = 2
	;ハロウィン(秋30日)
ELSEIF DAY:2 == 3 && DAY:3 == 30
	PRINTFORML 「할로윈이라도 %조사처리(CALLNAME:MASTER,"는")% 사탕보다 장난을 원하는구나.
	PRINTFORML 　그렇다면, 나에게 마음껏 장난쳐도…… 괜찮아...?
	PRINTFORMW 히나는 부끄러운 듯 뺨을 붉히며, %조사처리(CALLNAME:MASTER,"를")% 받아들였다…….
	TCVAR:79:359 = 2
	;バレンタインデー(冬14日)
ELSEIF DAY:2 == 4 && DAY:3 == 14
	PRINTFORML 「이런 특별한 발렌타인데스인데. 오늘은 달콤하고 야릇하게... 해요?」
	PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"를")% 끌어안고, %조사처리(CALLNAME:MASTER,"의")% 애무를 요구했다...
	TCVAR:79:359 = 2
	;クリスマス(冬25日)
ELSEIF DAY:2 == 4 && DAY:3 == 25
	PRINTFORML 「크리스마스에 가장 좋아하는 사람과 이렇게 있을 수 있다니……. 나는 행복한 사람이네…….」
	PRINTFORMW 히나는 미소를 지으며, 행복하게 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다…….
	TCVAR:79:359 = 2
	;大晦日(冬31日)
ELSEIF DAY:2 == 4 && DAY:3 == 31
	PRINTFORML 「올해 마지막 연말 에치... 그런 곳일까. 우후후」
	PRINTFORMW 히나는 표정을 풀고, 상냥한 눈길을 %조사처리(CALLNAME:MASTER,"에게")% 향하고 있다…….
	TCVAR:79:359 = 2
ELSE
	TCVAR:79:359 = 1
ENDIF
RETURN 1
;==================================================
;@M_KOJO_MESSAGE_EVENT_K79_EX_10
;祭日限定特殊押し倒されイベント([恋慕]要)
;
;★祭日押し倒し&祭日押し倒されのフラグ(TCVAR:79:359)は競合する
;　いずれか片方がその日既に実行済みの場合、もう一方は発生しない
;==================================================

@M_KOJO_MESSAGE_EVENT_K79_EX_10
;元日(春1日) プレイ初日は発生しない
IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1
	PRINTFORML 「첫날은 연신님을 축하하는 날이니까, 원래라면 『히메조메』는 내일인데…….」
	PRINTFORML 　저 벌써 내일까지 참을 수 없어...! 그러니까 이 에치(야한 것)를 『히메조메』로 하자?」
	PRINTFORMW 히나의 제안에 %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕이고, 히나에게 몸을 맡기기로 했다…….
	TCVAR:79:359 = 2
	;雛祭り(春3日)
ELSEIF DAY:2 == 1 && DAY:3 == 3
	PRINTFORML 「오늘은 즐거운 히나마츠리~, 에에~!」
	PRINTFORMW %조사처리(CALLNAME:MASTER,"를")% 깔아뭉갠 히나는 즐거운 듯이 %조사처리(CALLNAME:MASTER,"의")% 몸을 만지기 시작했다…….
	TCVAR:79:359 = 2
	;ホワイトデー(春14日)
ELSEIF DAY:2 == 1 && DAY:3 == 14
	PRINTFORML 「그럼 나부터 감사함... 받아줘?」
	PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 손바닥에 살짝 키스하고, 그대로 손가락으로 %조사처리(CALLNAME:MASTER,"의")% 옷을 더듬기 시작했다……。
	TCVAR:79:359 = 2
	;ハロウィン(秋30日)
ELSEIF DAY:2 == 3 && DAY:3 == 30
	PRINTFORML 「%CALLNAME:MASTER%? 오늘은 할로윈이니까……, 장난칠 거야?」
	PRINTFORMW 입맞춤 직전 단계를 건너뛰고, 히나는 %조사처리(CALLNAME:MASTER,"에게")% 장난을 치기 시작했다…….
	TCVAR:79:359 = 2
	;バレンタインデー(冬14日)
ELSEIF DAY:2 == 4 && DAY:3 == 14
	PRINTFORML 「응... %CALLNAME:MASTER%. 음, 제대로 맛봐줘?」
	PRINTFORMW 히나는 초콜릿을 입에 넣고, 입으로 %조사처리(CALLNAME:MASTER,"의")% 입안에 초콜릿을 흘려보냈다……。
	TCVAR:79:359 = 2
	;クリスマス(冬25日)
ELSEIF DAY:2 == 4 && DAY:3 == 25
	PRINTFORML 「후후, 나로부터 %조사처리(CALLNAME:MASTER,"에게")% 주는 크리스마스선물이야」
	PRINTFORMW 히나는 미소 지으며 %조사처리(CALLNAME:MASTER,"와")% 살짝 입을 맞추었다…….
	TCVAR:79:359 = 2
	;大晦日(冬31日)
ELSEIF DAY:2 == 4 && DAY:3 == 31
	PRINTFORML 「올해도 오늘로 끝이야. 그래서 올해의 마지막까지 %조사처리(CALLNAME:MASTER,"와")% 사랑하고 싶어……」
	PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 몸을 밀착시켰다…….
	TCVAR:79:359 = 2
ELSE
	TCVAR:79:359 = 1
ENDIF
RETURN 1
