LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕
		IF ABL:技巧 > 9
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 
				CASE 1
					PRINTFORMW 
				CASE 2
					PRINTFORMW 
				CASE 3
					PRINTFORMW 
				CASE 4
					PRINTFORMW 
			ENDSELECT
			RETURN 1
		ELSEIF ABL:技巧 > 4
			PRINTFORMW 
			RETURN 1
		ELSEIF ABL:技巧 > 2
			PRINTFORMW 
			RETURN 1
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
		;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
