; Modular ERB: 個人口上/079 Hina [雛]/eraTW用鍵山雛口上/M_KOJO_K79_日常系コマンド.ERB
;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1>=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;
;★祭日会話イベントの処理はエレン口上を参考にさせていただきました
;==================================================

@M_KOJO_MESSAGE_COM_K79_300
;コマンド共通メッセージ(TRAIN_MESSAGE)
;削除すると「～話をした。」とかが消えます
;口上メイン呼出
CALL M_KOJO_MESSAGE_COM_K79_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_300_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:193 == -3 ;custom code, hate mark 3
		RETURN
	ENDIF
	;初回
	IF FIRSTTIME(300)
		PRINTFORMW 「……당신에게 이전에 말했을 터인데」
		PRINTFORML 「재앙을 부르는 나의 주변에는 재앙이 모이기 때문에」
		PRINTFORMW 　주변의 인간이나 요괴들은 불행한 일을 겪기 쉬워진다」
		PRINTFORML 　
		PRINTFORML 그러니까 나를 봐도 함부로 다가오거나 말을 걸지 마.
		PRINTFORMW 　그렇게 하면, 당신은 불행해지지 않을 테니까…….
		PRINTFORML 　
		PRINTFORML 「그런 거 신경 안 쓴다고...?」
		PRINTFORML 　...... ...... 하아.
		PRINTFORMW 　......어떻게 되든 난 모른다니까」
		PRINTFORML 　
		PRINTFORML 히나는 한숨을 쉬면서도 마지못해 대답했다.
		PRINTFORMW 아무래도 일방적으로 거절당하고 있는 건 아닌 것 같다.
		;二回目以降
	ELSE
		IF TALENT:恋人
			;失敗
			IF TFLAG:193 == -1
				PRINTFORML 「%CALLNAME:MASTER%…… 그 얘기, 재미없네」
				PRINTFORMW 직설적으로 들으면 꽤 괴롭다…….
			ELSE
				;祭日限定会話(その日に初めて"会話"した際に発生)
				SIF TCVAR:79:350 == 0
					CALL M_KOJO_MESSAGE_EVENT_K79_EX_TALK
				;七夕特殊処理
				SIF DAY:2 == 2 && DAY:3 == 7 && TIME:2 == 6
					CALL M_KOJO_MESSAGE_EVENT_K79_EX_TALK
				;特別会話結果
				IF TCVAR:79:350 == 2
					TCVAR:79:350 = 1
					RETURN 1
				ENDIF
				;押し倒され条件が整っている(且つ50%の確率で発生)
				IF (!CFLAG:うふふ && TFLAG:102 != 3) || (TFLAG:102 == 3 && TFLAG:抱きつきモード) && RAND:2
					;溜まっている度の状態で分岐
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 「…… …… ……」
						PRINTFORMW 히나는 말없이 %조사처리(CALLNAME:MASTER,"의")% 소매를 만지고 있다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 「저기... %CALLNAME:MASTER%앗... %UNICODE(0x2764)%」
						PRINTFORMW 히나는 얼굴을 새빨갛게 물리고, %조사처리(CALLNAME:MASTER,"를")% 가만히 보고 있다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 1000
						PRINTFORML 「하아, 하아……%UNICODE(0x2764)% 후후읏……%UNICODE(0x2764)%」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 말도 닿지 않는 건가, 히나는 달콤한 숨을 내쉬며 %조사처리(CALLNAME:MASTER,"의")% 음부를 계속 쓰다듬고 있다…….
					ELSE
						PRINTFORML 「하아후윽 %UNICODE(0x2764)% 응, 후우, 후우…… %UNICODE(0x2764)%」
						PRINTFORMW 유두를 뜨겁게 달구고 가랑이를 흥건하게 적신 히나에게는 이성이라는 것이 남아있지 않은 것 같다…….
					ENDIF
					RETURN 1
				ENDIF
				;通常会話
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「%CALLNAME:MASTER%도 같이 고스로리 옷, 입어보지 않을래?……아니, 입으렴!」
						PRINTFORMW 그렇게 말하는 히나는 어째선지 숨이 거칠어져 있다…….
					CASE 1
						PRINTFORML 「나, 예전에는 혼자였는데. 지금은 %조사처리(CALLNAME:MASTER,"의")% 연인이니까 말이야...... 후훗」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"와")% 처음 만났을 때를 회상하고 있다......。
					CASE 2
						PRINTFORML 「……%CALLNAME:MASTER%, 정말 좋아해」
						PRINTFORMW 자애에 찬 표정으로 히나는 %조사처리(CALLNAME:MASTER,"를")% 바라보았다.
					CASE 3
						PRINTFORML 「...나 말이야, 지금 엄청 행복해. %CALLNAME:MASTER%덕분이야」
						PRINTFORMW 그렇게 말하자 히나는 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다…….
					CASE 4
						PRINTFORML 「다음에 또 데이트하러 가요, 그렇죠?」
						PRINTFORMW 히나는 다음 데이트를 기대하고 있는 듯하다…….
				ENDSELECT
			ENDIF
		ELSEIF TALENT:恋慕
			;失敗
			IF TFLAG:193 == -1
				PRINTFORML 「헤, 헤에, 그렇구나……」
				PRINTFORMW ……왠지 히나가 억지로 대화에 맞춰주고 있는 것 같다.
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「후훗~♪」
						PRINTFORMW 히나는 기쁜 표정을 짓고 있다…….
					CASE 1
						PRINTFORML 「맞아, 저번에 말이야, 이런 일이 있었어……」
						PRINTFORMW 그렇게 말하며 %조사처리(CALLNAME:MASTER,"에게")% 이야기하는 히나는 평소와는 달리 즐거워 보인다.
					CASE 2
						PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 얘기하고 있으면 시간이 눈 깜짝할 새에 지나가 버려」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"와")%의 대화를 즐기고 있다.
					CASE 3
						PRINTFORML 「……빙글빙글 도는 데에는, 분명 이유가 있는 거야?」
						PRINTFORMW 히나는 평소의 회전 행동에 대해 설명하기 시작했다…….
					CASE 4
						PRINTFORML 「좀 더, 서로를 알아야지」
						PRINTFORMW 히나도 자신 나름에 %조사처리(CALLNAME:MASTER,"를")% 알려고 노력하는 것 같다.
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕
			;失敗
			IF TFLAG:193 == -1
				PRINTFORML 「후우. ……그래서?」
				PRINTFORMW 히나의 대답에 나도 모르게 말이 막혀버렸다…….
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「헤에, 마을에서 그런 일이 있었구나……」
						PRINTFORMW 원래 타인과의 관계를 피하고 있어서인지, 최근 상황에는 어두운 듯하다.
					CASE 1
						PRINTFORML 「왠지 모르겠지만... %CALLNAME:MASTER%라면 잘 해낼 수 있을 것 같아...」
						PRINTFORMW 대화가 잠시 끊긴 순간, 히나는 나지막이 중얼거렸다...
					CASE 2
						PRINTFORML 「그 이야기, 좀 더 듣고 싶어.」
						PRINTFORMW 아무래도 이야기에 흥미를 느낀 것 같다.
					CASE 3
						PRINTFORML 「후훗……, %조사처리(CALLNAME:MASTER,"는")% 재미있는 사람이네」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 이야기를 듣고, 히나는 작게 웃었다.
					CASE 4
						PRINTFORML 「야가미의 일? 대단한 건 아니야」
						PRINTFORMW 히나는 평소의 일에 대해 이야기했다…….
				ENDSELECT
			ENDIF
			;それ以外
		ELSE
			;失敗
			IF TFLAG:193 == -1
				PRINTFORML 「…… …… ……」
				PRINTFORMW 서로 말이 없어지며, 어색한 분위기가 되었다…….
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「그것은, 음... 그게...」
						PRINTFORMW 히나는 말하기 힘든 듯하고 있다.
					CASE 1
						PRINTFORML 「나 자신은 불행해지지 않으니까 상관없지만……」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"를")% 걱정하고 있는 것 같다…….
					CASE 2
						PRINTFORML 「아…… 그렇구나……」
						PRINTFORMW 어쩐지 어색한 분위기다…….
					CASE 3
						PRINTFORML 「나랑 얘기하고 싶다고, 당신 정말 이상한 사람이네……」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"를")% 의아해하고 있다…….
					CASE 4
						PRINTFORML 「후우...」
						PRINTFORMW 별로 흥미 없는 이야기였던 것 같다....
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;==================================================
;301,お茶を淹れる
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K79_301
CALL M_KOJO_MESSAGE_COM_K79_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_301_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初回
	IF FIRSTTIME(301)
		PRINTFORMW 「나에게 차를...? 고마워.」
		PRINTFORMW 히나는 멍한 얼굴을 지으며 차를 받았다.
		PRINTFORML 
		PRINTFORML 뭐, 이걸 봉헌의 일환이라고 생각한다면,
		PRINTFORMW 　당신이 재앙을 맞는 일은 없을지도 모르겠네.
		;お茶淹れ失敗
		IF TFLAG:193 == -1
			PRINTFORML ……음. 컥, 컥...! ……너무 괴로워.
			PRINTFORMW 그렇게 말하는 히나의 표정은 쓰다. 내 우려를 잘못 만든 걸지도 모른다…….
			PRINTFORML 
			PRINTFORML 이런 걸로는 바치기도 부끄러울걸, 사람 앞에 서지도 못할 거야.
			PRINTFORMW 　...좀 더 연습하고 실력을 갈고닦아 오렴.
			PRINTFORML 
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 차는 히나에게 마음에 들지 않았다…….
			;それ以外(=成功 or 大成功)
		ELSE
			PRINTFORMW 　......아라. 꽤 맛있지 않아?
			PRINTFORMW 순식간에 히나의 얼굴이 환해진다. 이런 표정은 처음 본 것 같다.
			PRINTFORML 
			PRINTFORML 차, 잘 마셨습니다.
			PRINTFORMW 　다음에 기회가 되면 꼭 다도 시연을 보여줬으면 좋겠네.
			PRINTFORML 
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 차는 히나에게 마음에 들린 것 같다.
		ENDIF
		;二回目以降
	ELSE
		;お茶飲み過ぎ
		IF TCVAR:79:351 > 4
			IF TALENT:恋慕
				PRINTFORML 「우으윽......, 차가 너무 맛있는 것도 정도가 있지...」
				PRINTFORMW 히나는 괴로운 듯 차로 부풀어 오른 배를 문지르고 있다....
			ELSEIF TALENT:思慕
				PRINTFORML 「몇 번 마시니, 역시 배가 느슨해지기 시작했네……」
				PRINTFORMW 히나는 내밀어진 차를 보며 일그러진 표정을 지었다…….
			ELSE
				PRINTFORML 「......미안해요, 더는 못 마시겠어요.」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 건넨 차를 히나는 다 마시지 못한 채 있다…….
			ENDIF
		ELSEIF TCVAR:79:351 > 2
			IF TALENT:恋慕
				PRINTFORML 「%조사처리(CALLNAME:MASTER,"가")% 우려낸 차는 맛있어서 몇 잔이고 마셔버리네」
				PRINTFORMW 차 향을 즐기며, 히나는 차를 천천히 마셨다…….
			ELSEIF TALENT:思慕
				PRINTFORML 「오늘은 여러 번 %조사처리(CALLNAME:MASTER,"의")% 차를 받고 있네」
				PRINTFORMW 히나는 그렇게 중얼거리며, %조사처리(CALLNAME:MASTER,"가")% 우려낸 차를 홀짝이고 있었다……。
			ELSE
				PRINTFORML 「혹시... 차를 마시는 게 취미야?」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"가")% 여러 번 차를 건네는 것을 이상하게 생각하고 있었다...
			ENDIF
		ELSE
			IF TALENT:恋慕
				;仕事中判定(お茶を差し入れ)
				IF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
					PRINTFORML 선물 고마워, %CALLNAME:MASTER%.
					PRINTFORMW 　그럼 잘 먹겠습니다.
				ENDIF
				;お茶入れ大成功
				IF TFLAG:193 == 1
					PRINTFORML 「이 차라면 몇 잔이라도 마셔버릴 것 같네, 후훗」
					PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"가")% 우려낸 차를 매우 마음에 들어 했다.
					;お茶淹れ失敗
				ELSEIF TFLAG:193 == -1
					PRINTFORML 「음, 어라...? 꽤 싱거운 느낌이 드는데...?」
					PRINTFORMW 아무래도 평소보다 연하게 내려버린 모양이다....
					;それ以外(=成功)
				ELSE
					SELECTCASE RAND:5
						CASE 0
							PRINTFORML 「……%조사처리(CALLNAME:MASTER,"가")% 내려주는 차는 특별하네」
							PRINTFORMW 히나는 표정을 부드럽게 풀고, %조사처리(CALLNAME:MASTER,"가")% 내린 차를 만끽하고 있었다…….
						CASE 1
							PRINTFORML 「음... 역시 차는 좋네...」
							PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 느긋하게 쉬었다...
						CASE 2
							PRINTFORML 「너무 뜨겁지도, 너무 따뜻하지도 않아서. 마시기 딱 좋네.」
							PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"가")% 우려낸 차를 다 마셔버렸다.
						CASE 3
							PRINTFORML 「후우... 진정되네...」
							PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 차를 마시며 잠시 숨을 돌렸다.
						CASE 4
							PRINTFORML 「딱 목이 말랐는데. 덕분에 살았어」
							PRINTFORMW 히나는 차를 마시면서 %조사처리(CALLNAME:MASTER,"에게")% 감사 인사를 전했다…….
					ENDSELECT
				ENDIF
			ELSEIF TALENT:思慕
				;仕事中判定(お茶を差し入れ)
				IF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
					PRINTFORML 「あら、差し入れ？
					PRINTFORMW 　일단 차를 마시고 잠시 쉬도록 하자
				ENDIF
				;お茶入れ大成功
				IF TFLAG:193 == 1
					PRINTFORML 「……대단해. 차는 이렇게 맛있게 우릴 수 있는 거구나」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 우린 차의 맛에 히나는 눈을 동그랗게 뜨고 있다…….
					;お茶淹れ失敗
				ELSEIF TFLAG:193 == -1
					PRINTFORML 「카, 상당히 괴롭네……. 원래 이런 차인가……?」
					PRINTFORMW 차의 우리는 방법을 잘못 만든 것 같다…….
					;それ以外(=成功)
				ELSE
					PRINTFORML 「음... 맛있어……. 혹시 차를 올린 건가.」
					PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 차 맛의 차이를 눈치챈 듯했다.
				ENDIF
			ELSE
				;仕事中判定(お茶を差し入れ)
				IF CFLAG:行動 == 5 && !INRANGE(CFLAG:職種, 48, 51) ;custom code
					PRINTFORML 「……선물로 가져온 차?」
					PRINTFORMW 　고마워. 마실게」
				ENDIF
				;お茶入れ大成功
				IF TFLAG:193 == 1
					PRINTFORML 「…좋은 차, 좋은 다도네」
					PRINTFORMW 히나는 밝은 미소를 띠고 있다. 기뻐해 준 것 같다…….
					;お茶淹れ失敗
				ELSEIF TFLAG:193 == -1
					PRINTFORML 「으윽, 쓴걸……」
					PRINTFORMW 차를 마신 히나의 표정이 굳어졌다. 우리는 잘못 우린 모양이다.
					;それ以外(=成功)
				ELSE
					PRINTFORML 「음쿠읏……응, 나쁘지 않네」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 우려낸 차는 합격점인 것 같다.
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	TCVAR:79:351 += 1
ENDIF
RETURN 1
