;405,出掛ける(同行時デート
;条件が厄介なので、COMF405 出掛ける.ERBを参照のこと
;★無駄に凝り始めるとキリがない
;==================================================

@M_KOJO_MESSAGE_COM_K79_405
;出掛けるにTRAIN_MESSAGEは無い
CALL M_KOJO_MESSAGE_COM_K79_405_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_405_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;デート開始
	IF CFLAG:TARGET:同行
		PRINTFORML 
		;初デート
		IF FIRSTTIME(SELECTCOM)
			CFLAG:79:1003 = DAY
			IF TALENT:恋慕
				PRINTFORML 「하, 첫 데이트라, 저, 저, 긴장돼…….」
				PRINTFORMW 히나는 너무 긴장한 나머지 목소리가 갈라지고 있다…….
			ELSEIF TALENT:思慕
				PRINTFORML 「누군가와 함께 외출하는 건, 언제부터였을까……」
				PRINTFORMW 히나는 앞을 향하고, 아득한 눈빛이다…….
				;それ以外
			ELSE
				PRINTFORML 「... 가능하다면 다른 사람과의 접촉은 피하고 싶지만」
				PRINTFORMW 히나는 작게 한숨을 쉬었다…….
			ENDIF
			;二回目以降
		ELSE
			IF TALENT:恋慕
				;★デートの行き先で分岐(暫定的に一部のみ)
				;博麗神社
				IF DATENAME_PLACE(1) == "博麗神社"
					;元日(春1日)の場合特殊分岐(1年目は発生しない)
					IF DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1
						PRINTFORML 「아아, 첫 참배는 모야 신사가 아니라 하쿠레이 신사에 가는 거구나」
						PRINTFORMW 히나는 의외라는 듯하고 있다…….
						;博麗神社例大祭(春25日)の場合特殊分岐
					ELSEIF DAY:2 == 1 && DAY:3 == 25
						PRINTFORML 「예타이사에 데리고 가 줄 거야, 기뻐.」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 제안을 히나는 흔쾌히 승낙했다…….
						;大晦日(冬31日)の場合特殊分岐
					ELSEIF DAY:2 == 4 && DAY:3 == 31
						PRINTFORML 「언제나 조용한 하쿠레이 신사도 연말이면 북적이고 있을까」
						PRINTFORMW 히나는 하쿠레이 신사의 혼잡함이 신경 쓰이는 듯하다…….
					ELSE
						PRINTFORML 「하쿠레이 신사에 가는 거니? 알겠어」
						PRINTFORMW 히나는 %CALLNAME:MASTER%옆에 나란히 서서 걷기 시작했다…….
					ENDIF
					;命蓮寺(まだ)
					;ELSEIF DATENAME_PLACE() == "命蓮寺"
					;人間の里
				ELSEIF DATENAME_PLACE(1) == "人間の里"
					;育児中で子供が寺子屋へ登校している場合特殊分岐
					IF TALENT:育児中 && GO_SCHOOL() && TIME:0 >= 540
						PRINTFORML 「……나중에 몰래, 세이육야에서 열심히 하고 있는 %CHILDNAME:79:(TALENT:79:育児中)%의 모습을 보러 가자?」
						PRINTFORML 히나의 제안에 %조사처리(CALLNAME:MASTER,"는")% 망설임 없이 고개를 끄덕였다.
						PRINTFORMW 이것이 속칭 '부모바카'구나 하고 생각하며, %조사처리(CALLNAME:MASTER,"와")% 히나는 둘이서 웃었다.
						;相当溜まっている(＆合意取得済み)場合特殊分岐
					ELSEIF CFLAG:TARGET:溜まってる度 > 800 && GETBIT(CFLAG:(TARGET:LOCAL):既成事実 , 1)
						PRINTFORML 「하아, 하아……. %UNICODE(0x2764)% ……오늘은 마을의 여관에 데려가고 싶어 %UNICODE(0x2764)%」
						PRINTFORMW 이것저것 쌓여 있을까, 히나의 머릿속은 분홍색으로 물든 것 같다…….
					ELSE
						SELECTCASE RAND:3
							CASE 0
								PRINTFORML 「인간 마을에 도착했으니, 어디선가 맛있는 걸 먹고 싶네……」
								;現在の所持金が3000円(食事代金)未満の場合特殊分岐
								;あくまでフレーバー これ以上の分岐は特にない
								IF MONEY < 3000
									PRINTFORML 하지만, 지금 %조사처리(CALLNAME:MASTER,"의")% 주머니는 다소 불안하다.
									PRINTFORMW 히나의 소원을 이루기 위해 어떻게든 돈을 마련하고 싶다…….
								ELSE
									PRINTFORMW 시간에 여유가 있다면 데리고 가 줄게…….
								ENDIF
							CASE 1
								PRINTFORML 「데이트 겸 쇼핑도 해버릴까요?」
								PRINTFORMW 히나는 쇼핑용 보자기를 품에 넣었다. ……히시모치 무늬다.
							CASE 2
								PRINTFORML 「시골이라면 이것저것 다 갖추고 있네. 오늘은 어떤 가게에 갈 거야?」
								PRINTFORMW 히나는 가게 구경이 즐거운 모양이다…….
						ENDSELECT
					ENDIF
					;霧の湖～紅魔館(まだ)
					;ELSEIF DATENAME_PLACE() == "霧の湖～紅魔館"
					;迷いの竹林(まだ)
					;ELSEIF DATENAME_PLACE() == "迷いの竹林"
					;魔法の森(まだ)
					;ELSEIF DATENAME_PLACE() == "魔法の森"
					;三途の川～冥界(まだ)
					;ELSEIF DATENAME_PLACE() == "三途の川～冥界"
					;妖怪の山(山麓)(まだ)
					;神社暮らし前提
					;ELSEIF DATENAME_PLACE() == "妖怪の山 (山麓)"
					;妖怪の山(山頂)(まだ)
					;ELSEIF DATENAME_PLACE() == "妖怪の山 (山頂)"
					;地底(まだ)
					;ELSEIF DATENAME_PLACE() == "地底"
					;夢の世界～月(まだ)
					;ELSEIF DATENAME_PLACE() == "夢の世界～月"
					;それ以外
				ELSE
					SELECTCASE RAND:5
						CASE 0
							PRINTFORML 「오늘도 즐거운 데이트를 해요, 그렇죠? %CALLNAME:MASTER%?」
							PRINTFORMW 히나는 미소 지으며 %조사처리(CALLNAME:MASTER,"에게")% 미소 지었다.
						CASE 1
							PRINTFORML 「후후, %CALLNAME:MASTER%. 같이 가요?」
							PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 팔에 안겼다…….
						CASE 2
							PRINTFORML 「저기, %CALLNAME:MASTER%. 오늘은 어디에 외출하는 거야?」
							PRINTFORMW 히나는 데이트 장소가 궁금한 것 같다…….
						CASE 3
							PRINTFORML 「%조사처리(CALLNAME:MASTER,"랑")% 함께라면, 어디를 가도 즐겁네」
							PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 손을 잡고 걷기 시작했다…….
						CASE 4
							PRINTFORML 「네, 가요. 어디에 갈 때든 %조사처리(CALLNAME:MASTER,"에게")% 함께할게요」
							PRINTFORMW 히나는 표정을 부드럽게 만들며, %조사처리(CALLNAME:MASTER,"에게")% 기대었다……。
					ENDSELECT
				ENDIF
			ELSEIF TALENT:思慕
				PRINTFORML 「……그럼, 가시죠」
				PRINTFORMW 히나는 %CALLNAME:MASTER%옆에 서서 걷기 시작했다…….
				;それ以外
			ELSE
				PRINTFORML 「그, 어째서 나와 외출하고 싶은 걸까……?」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 데리고 나가려는 행동에 히나는 의문을 품고 있다…….
			ENDIF
		ENDIF
		;それ以外(出掛けるMASTERを見送るシチュエーション)
	ELSE
	ENDIF
ENDIF
RETURN 1
;==================================================
;410,掃除
;FLAG:70(1=時間停止中
;TFLAG:193(0=見てるだけ 1=一緒に掃除)
;TFLAG:194(3=汚れ高 2=汚れ中 1=汚れ低 0=汚れ最小
;OUTROOF(CFLAG:現在位置)(野外掃除（冬は雪かき
;==================================================

@M_KOJO_MESSAGE_COM_K79_410
CALL M_KOJO_MESSAGE_COM_K79_410_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_410_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止
	IF FLAG:時間停止
		RETURN 1
	ENDIF
	;睡眠中
	IF CFLAG:睡眠 == 1
		RETURN 1
	ENDIF
	;初回
	IF FIRSTTIME(410)
		PRINTFORML 「......저도 청소, 도와드려도 될까요?」
		PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 청소를 돕겠다고 신청했다.
		PRINTFORML 　
		PRINTFORML 「당신에게만 청소를 시키는 것도, 미안해서 말이야……」
		PRINTFORMW 그렇게 말하자 히나는 묵묵히 청소를 시작했다.
		;二回目以降
	ELSE
		IF TALENT:恋慕
			;野外掃除
			IF OUTROOF(CFLAG:TARGET:現在位置)
				SELECTCASE DAY:2
					;春
					CASE 1
						PRINTFORML 「%CALLNAME:MASTER%, 머리에 벚꽃잎이 붙어 있네?」
						PRINTFORMW 히나가 %조사처리(CALLNAME:MASTER,"에게")% 급접근한 듯, 머리에 붙어 있었을 꽃잎을 뽑아 %조사처리(CALLNAME:MASTER,"에게")% 보여왔다…….
						;夏
					CASE 2
						PRINTFORML 「여름철 청소는 수분 보충이 중요해?」
						PRINTFORMW 청소를 잠시 중단하자, 히나는 물통을 %CALLNAME:MASTER%에 내밀었다…….
						;秋は落ち葉掃き(という想定)
					CASE 3
						PRINTFORML 「붉거나 노랗게 물든 낙엽은, 단풍의 신인 시즈하가 한 장 한 장 손수 색을 칠하고 있는 거야」
						PRINTFORMW 히나는 가벼운 말투로 그렇게 말했지만, 그건 꽤 힘든 작업이 아닐까...?
						;冬は雪かき
					CASE 4
						;雪の積もり具合で分岐
						IF TFLAG:194 == 3
							IF TALENT:MASTER:清掃中毒
								PRINTFORML 「%조사처리(CALLNAME:MASTER,"는")% 의욕이 넘치네……」
								PRINTFORMW 기세 좋게 눈 치우기를 계속하는 %조사처리(CALLNAME:MASTER,"를")% 옆에 두고, 히나도 자신의 페이스로 눈 치우기를 계속했다…….
							ELSE
								PRINTFORML 「……지금부터 이걸 치려면, 기운이 빠질 것 같아」
								PRINTFORMW 쌓여있는 눈을 바라보며 히나는 멍하니 서 있다…….
							ENDIF
						ELSEIF TFLAG:194 == 2
							PRINTFORML 「적어도 통로 정도는 만들어 두지 않으면...」
							PRINTFORMW 히나는 삽을 들고 눈 치우기를 시작했다...
						ELSEIF TFLAG:194 == 1
							PRINTFORML 「이 정도 깨끗하게 치워두면 충분할까?」
							PRINTFORMW 히나와 함께 제설 작업을 한 덕분에 눈은 대충 치워진 모양이다…….
						ELSEIF TFLAG:194 == 0
							PRINTFORML 「땅이 얼면 위험해. 꼼꼼하게 하지 않으면 안 되지」
							PRINTFORMW 히나는 얼어붙은 눈을 삽으로 깨서, 눈 조각들을 제설한 눈 산에 던져 넣었다……。
						ELSE
						ENDIF
				ENDSELECT
				;屋内掃除
			ELSE
				;現在位置が[706]厄神の家の場合特殊分岐
				IF CFLAG:MASTER:現在位置 == 706
					;冬の月13日の場合更に特殊分岐(煤払いの日)
					IF DAY:2 == 4 && DAY:3 == 13
						PRINTFORML 「오늘은 묵을 털 날이었네. 기분 좋게 새해를 맞이하려면, 제대로 청소해야겠어」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 평소보다 기합을 넣고 청소에 임했다…….
					ELSE
						PRINTFORML 「고마워, %조사처리(CALLNAME:MASTER,"가")% 도와줘서 다행이야」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 함께 히나의 방을 청소하고 있다…….
					ENDIF
					;現在位置がお風呂場の場合特殊分岐
				ELSEIF BATHCHECK(CFLAG:MASTER:現在位置)
					;★条件分岐草案
					;露出癖で条件分岐(お風呂場で裸になって何が悪い)
					;うふふ終了後か否かで条件分岐(行為後の掃除シチュエーション)
					;膣外射精したか否かで条件分岐(床に零れた精液を掃除。精液中毒なら舐めとる…とか？)
					IF ABL:露出癖 >= 3
						PRINTFORML 「목욕탕 청소는 알몸으로 할 수 있으니 좋네……」
						PRINTFORMW 뭐가 좋은지는 몰라도, 히나는 전라의 채 스펀지를 들고 목욕탕을 청소하고 있었다…….
					ELSE
						PRINTFORML 「%CALLNAME:MASTER%、아, 별로, 보지 말아줘……」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 시선이 신경 쓰이는 건지, 히나는 수건을 한 장 걸치고 목욕 청소를 하고 있다…….
					ENDIF
					;それ以外
				ELSE
					SELECTCASE RAND:5
						CASE 0
							PRINTFORML 「……다음에, %조사처리(CALLNAME:MASTER,"의")% 방도 청소하고 싶네」
							PRINTFORMW 윽, 청소되기 전에 이것저것 정리해 두자…….
						CASE 1
							PRINTFORML 「빙글빙글-」
							PRINTFORMW 히나는 회전하면서 청소를 하고 있다…….
						CASE 2
							PRINTFORML 「이 근처, 아직 더러웠구나……」
							PRINTFORMW 히나는 세세한 때도 놓치지 않고 청소를 해나가고 있다…….
						CASE 3
							PRINTFORML 「……%CALLNAME:MASTER%? 그렇게 나를 응시하면, 그게…… 청소에 집중할 수가 없어」
							PRINTFORMW 청소를 하는 와중에도, 아무래도 %조사처리(CALLNAME:MASTER,"는")% 히나에게 빠져 있었다.
						CASE 4
							PRINTFORML 「청소하고 있는 %조사처리(CALLNAME:MASTER,"는")% 어쩐지 빛나 보여……」
