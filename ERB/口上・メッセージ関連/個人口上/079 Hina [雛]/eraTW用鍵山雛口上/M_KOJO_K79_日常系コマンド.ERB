RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_413_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:睡眠
		RETURN 1
	ENDIF
	;初回
	IF FIRSTTIME(413)
		PRINTFORML 「헤에......, %조사처리(CALLNAME:MASTER,"가")% 요리를 만들 수 있구나」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 요리를 하고 있을 때, 히나가 옆에서 엿보았다.
	ELSE
		PRINTFORML 「다른 사람이 요리하는 모습이라, 역시 신경 쓰이네……」
		PRINTFORMW 히나는 흥미로운 듯 %조사처리(CALLNAME:MASTER,"가")% 요리하는 모습을 바라보고 있다…….
	ENDIF
	PRINTFORML 　
	;朝食
	IF TIME >= 300 && TIME <= 540
		PRINTFORML 아침밥인데, 꽤 정성 들여 만들고 있네.
		;昼食
	ELSEIF TIME >= 660 && TIME <= 900
		PRINTFORML 그러고 보니, 슬슬 점심시간이 되었네.
		;夕食
	ELSEIF TIME >= 1020 && TIME <= 1200
		PRINTFORML 벌써 저녁 시간인가.
		;晩食
	ELSEIF TIME >= 1200 && TIME <= 1440
		PRINTFORML 이 시간으로는 좀 늦은 저녁이 될 것 같네.
		;夜食
	ELSEIF TIME >= 0 && TIME <= 180
		PRINTFORML 이렇게 늦게까지 깨 있으면, 역시 배도 고파지네.
	ELSE
		PRINTFORML 이 시간대라면, 간식이 될까나.
	ENDIF
	;祭日特別メニュー分岐
	;おせち料理(春1日/春2日) プレイ初年は発生しない
	IF DAY:2 == 1 && DAY:3 <= 2 && DAY:0 != 1
		PRINTFORML 　새해라서, 오세치요리를 만들고 있는 거야?
		;恵方巻(冬3日)
	ELSEIF DAY:2 == 4 && DAY:3 == 3
		PRINTFORML 　오늘은 셋분(절분)이니까, 절분이라고 하면 역시 에호마키지.
		;年越し蕎麦(冬31日)
	ELSEIF DAY:2 == 4 && DAY:3 == 31
		PRINTFORML 　지금 만들고 있는 건……, 새해맞이 소바지.
		;それ以外
	ELSE
		PRINTFORML 　그래서 지금은 뭘 만들고 있는 거야? ……%DISHNAME%?
	ENDIF
	PRINTFORMW 　
	;料理技能で分岐
	;0～2はそれぞれ共通、3以上は料理内容でさらに分岐
	IF ABL:MASTER:44 == 0
		PRINTFORML 「에, 음... 그게..., 요리를 하고 있는 것 같지는 않지만...」
		PRINTFORMW 히나는 의심스러운 듯 %조사처리(CALLNAME:MASTER,"의")% 서툰 손놀림을 바라보고 있다.
	ELSEIF ABL:MASTER:44 == 1
		PRINTFORML 「뭐, 무엇이든 도전하는 것이 실력 향상의 지름길이지. ……나도 남의 일에 대해 말할 수는 없지만」
		PRINTFORMW 그렇게 말하자 히나는 다시 %조사처리(CALLNAME:MASTER,"의")% 손끝으로 시선을 돌렸다…….
	ELSEIF ABL:MASTER:44 == 2
		PRINTFORML 「과연, %CALLNAME:MASTER%나름으로 고안을 하고 있구나……」
		PRINTFORMW 히나는 감탄한 듯 고개를 끄덕이며, %조사처리(CALLNAME:MASTER,"의")% 손놀림을 관찰하고 있다…….
	ELSEIF ABL:MASTER:44 >= 3
		SELECTCASE DISHNAME
			;サンドイッチ
			CASE "サンドイッチ"
				PRINTFORML 「빵 사이에 넣는 속 재료에 따라 여러 가지 변주를 즐길 수 있겠네」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"가")% 어떤 속재료를 넣을지 궁금해하는 것 같다.
				;おにぎり
			CASE "おにぎり"
				PRINTFORML 「주먹밥 속은 뭘로 했어? 우메보시? 다시마? 아니면 소금 주먹밥?」
				PRINTFORMW 히나는 주먹밥 속이 궁금한 듯, %조사처리(CALLNAME:MASTER,"에게")% 속을 물어왔다…….
				;ハンバーガー
			CASE "ハンバーガー"
				PRINTFORML 「여러 재료를 넣으면 꽤 두꺼워지네……. 나이프랑 포크, 가져올게.」
				PRINTFORMW 그렇게 말하고 히나는 식기장에 나이프와 포크를 가지러 갔다……。
				;スコーン
			CASE "スコーン"
				PRINTFORML 「찻잔과 함께 먹는 과자라고 생각했는데, 반죽에 양파나 베이컨을 넣으면 간식으로도 되는 거구나」
				PRINTFORMW 히나는 가마솥 안에서 구워지는 스콘을 가만히 응시하고 있었다……。
				;シウマイ
				;★葉物ならレタスやキャベツでも代用可
			CASE "シウマイ"
				PRINTFORML 프라이팬에 배추를 깔고, 그 위에 샤오마이를 올리고 쪄야 하는 거구나…….
				PRINTFORML 　그렇구나, 이렇게 하면 깨끗하게 찔 수 있겠네. 공부가 된다.
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 창의적인 발명에 눈을 동그랗게 뜨고 있었다…….
				;肉まん
				;★同上
			CASE "肉まん"
				PRINTFORML 프라이팬에 양배추를 깔고 그 위에 니쿠만(찐 만두)을 올려 쪄내는 거야…….
				PRINTFORML 　이거면 깨끗하게 쪄낼 수 있고, 육즙이 배인 양배추도 맛있게 먹을 수 있겠네.
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 창의적인 발명품에 눈을 동그랗게 뜨고 있다.
				;フィッシュ＆チップス
			CASE "フィッシュ＆チップス"
				PRINTFORML 「영국에서 유래한 요리지? 가볍게 먹고 싶을 때 딱이겠어...」
				PRINTFORMW 옷을 입힌 생선 조각과 감자가 기름 속에서 춤추고 있다.
				;タコス
			CASE "タコス"
				PRINTFORML 「음, 멕시코 요리였던 걸까. 샌드위치 같은 거.」
				PRINTFORMW 히나는 환상향에서는 만나보기 힘들 것 같은 요리를 신기한 듯 관찰했다.
				;たこ焼き
			CASE "たこ焼き"
				PRINTFORML 「축제 노점에서 볼 수 있네. 후우…… 소스 향이 식욕을 자극해...」
