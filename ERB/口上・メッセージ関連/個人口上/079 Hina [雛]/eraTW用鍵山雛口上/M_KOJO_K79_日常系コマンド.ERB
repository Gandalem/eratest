;==================================================
;604,散策する
;デート中の場合、CFLAG:現在位置に移動先の場所が既に入ってる
;==================================================

@M_KOJO_MESSAGE_COM_K79_604
;散策するにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K79_604_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_604_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SIF FLAG:時間停止 || CFLAG:睡眠 || !CFLAG:同行 ;custom code
		RETURN 0
	;次の移動先で分岐
	SELECTCASE CFLAG:MASTER:現在位置
		;大衆浴場(人間の里)
		CASE 大衆浴場
			;初めて
			IF FIRSTTIME("大衆浴場",0)
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「엣, 대중목욕탕!? 그건 혹시... 같이 들어가는 거야...?」
					PRINTFORMW 대중목욕탕을 모르는 건지, 히나는 당황한 듯 말을 쏟아낸다.
					PRINTFORML 아... 아앗! 역시 남녀는 분리되어 있구나...
					PRINTFORML 　평소 자주 가는 산의 물놀이장은 온탕이라, 나도 모르게 성급하게 단정 지어버렸네……
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 대중목욕탕에 대해 설명하자, 히나는 안심한 듯하다…….
				ELSE
					PRINTFORML 
					PRINTFORML 「산에서는 계속 물놀이만 했으니까, 나에게 목욕탕은 정말 신선하네.」
					PRINTFORMW 히나는 하늘을 향해 솟아있는 높은 굴뚝을 올려다보고 있다…….
				ENDIF
			ELSE
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 가능하면 목욕하면서 몸을 깨끗하게 해두고 싶네.
					PRINTFORML 　여러 가지 의미로... 응?
					PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 윙크했다...
				ELSE
					PRINTFORML 
					PRINTFORML 「이렇게 온천에 몸을 담그러 가는 것도 나쁘지 않네……」
					PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 뒤에서 따라왔다…….
				ENDIF
			ENDIF
			;連れ込み宿(人間の里)
		CASE 連れ込み宿
			;初めて
			IF FIRSTTIME("連れ込み宿",0)
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「코, 이곳은 혹시……」
					PRINTFORML 여관답지 않은 작은 모습, 입구 정면에 설치된 높은 담, 담에 걸린 『숙박』과 『휴식』의 간판…….
					PRINTFORMW 모든 것을 눈치챘는지, 히나의 얼굴이 새빨개져 있었다…….
					PRINTFORML 「엣, 아, %CALLNAME:MASTER%윽...! 저랑, 이, 들어가는 거야!?
					PRINTFORML 　들어간다는 건…, 음, 그러니까...!」
					PRINTFORMW 히나의 말이 중간에 끊긴다. 그것을 본 %조사처리(CALLNAME:MASTER,"는")% 말없이 고개를 끄덕였다.
					PRINTFORML 「윽~~~~!?」
					PRINTFORMW 말로 할 수 없는 비명을 지르는 히나를 데리고, %조사처리(CALLNAME:MASTER,"는")% 연례숙의 문을 열었다…….
				ELSE
					PRINTFORML 
					PRINTFORML 「나에게도 여기가 평범한 여관이 아니라는 건 알겠어……. 그러니까, 그런 곳이지?」
					PRINTFORMW 연내숙 앞에 오자, 히나는 작게 한숨을 쉬었다…….
					PRINTFORML 「……뭐, 됐어. 야외에서 할 것도 아니고, 같이 가줄게」
					PRINTFORMW 히나는 마지못한 듯 %조사처리(CALLNAME:MASTER,"와")% 함께 연내숙으로 들어갔다…….
				ENDIF
			ELSE
				IF TALENT:恋慕
					;溜まっている度の状態で分岐
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「앗, %CALLNAME:MASTER%……%UNICODE(0x2764)%」
						PRINTFORMW 동의를 구하러 온 %조사처리(CALLNAME:MASTER,"에게")% 히나는 부끄러움에 고개를 숙인 채 작게 고개를 끄덕였다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「후후훗……%UNICODE(0x2764)% 나는 연거절 환영이야?」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 눈짓을 하며, 요염한 미소를 띠고 있다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 1000
						PRINTFORML 
						PRINTFORML 「%CALLNAME:MASTER%……, 에치하자?」
						PRINTFORMW 히나가 %조사처리(CALLNAME:MASTER,"의")% 귓가에 살며 속삭였다.
					ELSE
						PRINTFORML 
						PRINTFORML 「%CALLNAME:MASTER%빨리, 에치해줘 %UNICODE(0x2764)% 에치하고 싶어~ %UNICODE(0x2764)%」
						PRINTFORMW 욕정이 된 히나는 뺨을 붉게 물들이며 지금 당장이라도 %조사처리(CALLNAME:MASTER,"에게")% 안기고 싶은 것 같다…….
					ENDIF
				ELSE
					;溜まっている度の状態で分岐(恋慕より分岐少なめ)
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「이쪽으로 온 건, 역시 그런 거겠지……」
						PRINTFORMW 이동 도중 행선지를 눈치챈 히나는 시선을 허공에 두었다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「아, 들어가는 거야...? 알, 알겠어...」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 재촉받는 듯, 연내숙의 입구를 열었다….
					ELSE
						PRINTFORML 
						PRINTFORML 「하아, 하아……. 나를 이렇게 만들어 놓은 책임…… 지게 될 거야!」
						PRINTFORMW 히나는 뜨거운 숨을 내뱉으며 %조사처리(CALLNAME:MASTER,"에게")% 이끌려 연채숙으로 들어갔다…….
					ENDIF
				ENDIF
			ENDIF
			;ラブホ(地底)
		CASE ラブホ
			;初めて
			IF FIRSTTIME("ラブホ",0)
				IF TALENT:恋慕
					PRINTFORML 
					PRINTFORML 「지하에는 서양풍의 건물이 지령전 이외에도 있었구나…… 아」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"를")% 따라 호화로운 건물의 외관을 보고 있던 히나의 발이 갑자기 멈췄다.
					PRINTFORML 장식으로 채색된 간판, 입구에 걸린 긴 노렌, 「숙박」 「휴식」 요금표…….
					PRINTFORMW 분명 이곳이 평범한 건물이 아니라는 것을 깨달은 것이다.
					PRINTFORML 「저기, 저기, %CALLNAME:MASTER%…… 여기 혹시……」
					PRINTFORMW 히나는 자신의 예감을 확인하기 위해 조심스럽게 %조사처리(CALLNAME:MASTER,"에게")% 물었다. %조사처리(CALLNAME:MASTER,"는")% 말없이 고개를 끄덕였다.
					PRINTFORML 「아앗, 역시! 서양풍의 유흥주택이었구나……! 에? 유흥주택이라는 건…….」
					PRINTFORML 　저기, 즉…… 나와 여기서…… 어라, 야한 걸 하고 싶은 거야...?」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 아까보다 더 크게 고개를 끄덕였다. 히나의 얼굴이 수치심으로 새빨갛게 물들어 갔다…….
					PRINTFORML 「윽~~~!?」
					PRINTFORMW 그 자리에서 멈춰 선 히나를 데리고, %조사처리(CALLNAME:MASTER,"는")% 입구의 노렌을 지나갔다…….
				ELSE
					PRINTFORML 
					PRINTFORML 「……이상한 서양식 건물이 있다고 생각했는데, 여관이었구나」
					PRINTFORMW 요사스럽게 빛나는 건물을 보며 히나는 어이없다는 듯 중얼거렸다…….
					PRINTFORML 「랄까, 이렇게 눈에 띄면 오히려 들어가기 어렵잖아……」
					PRINTFORMW 조금 토라져 있는 히나를 달래면서, %조사처리(CALLNAME:MASTER,"는")% 러브호 입구로 향했다…….
				ENDIF
			ELSE
				IF TALENT:恋慕
					;溜まっている度の状態で分岐
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「%CALLNAME:MASTER%, 거기서 『휴식』하고 싶은 거니...?」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 끄덕이자, 히나는 조용히 손을 잡아왔다……。
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「앗, %CALLNAME:MASTER%, 여기는……%UNICODE(0x2764)%」
						PRINTFORMW 두 사람의 시야에 러브호가 보이기 시작하자, 히나는 확인하듯 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있었다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 1000
						PRINTFORML 
						PRINTFORML 「지금부터 저 러브호에서, %조사처리(CALLNAME:MASTER,"랑")% 에치, 하는 거야……%UNICODE(0x2764)% 후훗%UNICODE(0x2764)%」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 팔에 매달렸다…….
					ELSE
						PRINTFORML 
						PRINTFORML 「엣치, 엣치옷 %UNICODE(0x2764)% %CALLNAME:MASTER%하고, 러브호 엣치~ %UNICODE(0x2764)%」
						PRINTFORMW 욕정이 생긴 히나는 완전히 제멋대로 되고 있다……。
					ENDIF
				ELSE
					;溜まっている度の状態で分岐(恋慕より分岐少なめ)
					IF CFLAG:TARGET:溜まってる度 < 600
						PRINTFORML 
						PRINTFORML 「뭐, 조금은 쉴 수 있으면 좋겠는데……」
						PRINTFORMW %조사처리(CALLNAME:MASTER,"와")% 히나는 느릿한 발걸음으로 러브호로 향했다…….
					ELSEIF CFLAG:TARGET:溜まってる度 < 800
						PRINTFORML 
						PRINTFORML 「……주위에 사람이나 요괴의 기척은 없네? 그렇다면……」
						PRINTFORMW 히나는 주위를 둘러본 후, 입구의 노렌을 지나갔다…….
					ELSE
						PRINTFORML 
						PRINTFORML 「하아, 하아……, 모, 이제 마음대로 해버려……!」
						PRINTFORMW 자신의 욕망을 더 이상 참지 못한 히나는 몸을 던지고 %조사처리(CALLNAME:MASTER,"에게")% 맡겼다…….
					ENDIF
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
RETURN 1
