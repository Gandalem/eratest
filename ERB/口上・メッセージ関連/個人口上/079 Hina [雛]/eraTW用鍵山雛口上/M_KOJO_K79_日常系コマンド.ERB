;★TW針妙丸口上を参考に昼夜で分岐
;==================================================

@M_KOJO_MESSAGE_COM_K79_403
CALL M_KOJO_MESSAGE_COM_K79_403_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_403_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;睡眠中
	IF CFLAG:TARGET:睡眠
		RETURN 1
	ENDIF
	;連れ込み宿・ラブホにいる場合特殊分岐
	IF CFLAG:MASTER:現在位置 == 連れ込み宿 || CFLAG:MASTER:現在位置 == ラブホ
		PRINTFORML 「여기서 정말 '휴식'을 취하는 건, 뭔가 이상한 기분이네……」
		PRINTFORMW 히나는 이상하다는 듯 작게 웃었다…….
		RETURN 1
	ENDIF
	IF TALENT:恋人
		;昼(AM 06:00 - PM 06:00)
		IF TIME:0 >= 360 && TIME:0 < 1080
			PRINTFORML 「……%CALLNAME:MASTER%, 팔베개 해줄 수 없어?」
			PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 승낙하자, 히나는 %조사처리(CALLNAME:MASTER,"의")% 팔에 머리를 기댔다.
			PRINTFORMW 이윽고, 히나는 스르륵 잠꼬대를 하기 시작했다……。
			;夜(PM 06:00 - AM 06:00)
		ELSEIF TIME:0 >= 1080 && TIME:0 < 360
			PRINTFORML 「%CALLNAME:MASTER%옆에 있으면 마음이 놓여……」
			PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 기대어 휴식을 취했다……。
		ENDIF
	ELSEIF TALENT:恋慕
		;昼(AM 06:00 - PM 06:00)
		IF TIME:0 >= 360 && TIME:0 < 1080
			PRINTFORML 「……함께 낮잠을 자지 않겠어요」
			PRINTFORMW 히나와 %조사처리(CALLNAME:MASTER,"는")% 누워 휴식을 취했다…….
			;夜(PM 06:00 - AM 06:00)
		ELSEIF TIME:0 >= 1080 && TIME:0 < 360
			PRINTFORML 「……스으, ……스으」
			PRINTFORML 히나는 잠꼬리를 하고 있다.
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 살며 이불을 덮어주었다…….
		ENDIF
	ELSEIF TALENT:思慕
		;昼(AM 06:00 - PM 06:00)
		IF TIME:0 >= 360 && TIME:0 < 1080
			PRINTFORML 「이렇게 느긋하게 보내는 것도 나쁘지 않네...」
			PRINTFORMW 오, 느긋하게 보내는 좋은 점을 알아준 것 같아.
			;夜(PM 06:00 - AM 06:00)
		ELSEIF TIME:0 >= 1080 && TIME:0 < 360
			PRINTFORML 「……스르륵」
			PRINTFORMW 얕은 잠이라 할지라도, 자고 있는 히나는 완전히 무방비 상태다.
		ENDIF
		;それ以外
	ELSE
		;昼(AM 06:00 - PM 06:00)
		IF TIME:0 >= 360 && TIME:0 < 1080
			PRINTFORML 「낮부터 쉬다니…… 괜찮아?」
			PRINTFORMW ……가끔은 이런 날이 있어도 나쁘지 않다고 생각해.
			;夜(PM 06:00 - AM 06:00)
		ELSEIF TIME:0 >= 1080 && TIME:0 < 360
			PRINTFORML 「확실히... 휴식은 중요하지」
			PRINTFORMW 히나는 그 자리에 주저앉아 눈을 감았다...
		ENDIF
	ENDIF
ENDIF
RETURN 1
