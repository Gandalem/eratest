;302,スキンシップ
;TFLAG:193(1=大成功 0=成功 -1=失敗)
;==================================================

@M_KOJO_MESSAGE_COM_K79_302
CALL M_KOJO_MESSAGE_COM_K79_302_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_302_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
