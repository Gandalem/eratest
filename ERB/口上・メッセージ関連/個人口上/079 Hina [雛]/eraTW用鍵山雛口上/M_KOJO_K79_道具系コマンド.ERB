;44,バイブ
;==================================================

@M_KOJO_MESSAGE_COM_K79_44
CALL M_KOJO_MESSAGE_COM_K79_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_44_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORMW 
		ELSEIF TALENT:恋慕
			PRINTFORML 「에엣, 혹시...... 그걸 넣을 작정...?」
			PRINTFORMW 남성기를 모사한 형태의 바이브를 바라보며 히나는 불안한 목소리를 냈다.
			PRINTFORML 「응윽..., 하앗, 아아...! 넣어줘..., 응응...!」
			PRINTFORMW 비밀에서 흘러나오는 애액을 적신 후 바이브를 삽입한다. 히나는 다소 괴로워하는 표정을 짓고 있다...
		ELSE
			PRINTFORML 「응윽…, 뭐, 진짜보다는… 나을지도 모르겠네……」
			PRINTFORMW 히나는 비틈에 삽입된 바이브의 이물감에 견디고 있는 듯하다…….
		ENDIF
		;絶頂判定
		CALL M_KOJO_MESSAGE_EVENT_K79_EX_ORGASM
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:バイブ
		;時姦中
		IF FLAG:時間停止
			PRINTFORMW 
			RETURN 1
		ELSEIF TALENT:恋慕
			IF ABL:Ｖ感覚 > 9
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「이야아, 바이브보다 %조사처리(CALLNAME:MASTER,"의")% 거시기(성기)가 원해어... %UNICODE(0x2764)%」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 페니스에 닿으려 하지만, %조사처리(CALLNAME:MASTER,"는")% 그것을 정지시키고 바이브를 삽입했다.
						PRINTFORML 「햐앙 %UNICODE(0x2764)%, 음, 너무하다... %UNICODE(0x2764)%, 이런 거 기분 좋아져 버리잖아우우 %UNICODE(0x2764)%」
						PRINTFORMW 바이브가 가져오는 쾌락에 히나의 사고는 순식간에 녹아내렸고, 히나는 질 구멍에서 바이브를 단단히 물고 허리를 흔들고 있었다…….
					CASE 1
						PRINTFORML 「앗, 바이브... %UNICODE(0x2764)% 님, 이거 좋아... %UNICODE(0x2764)%」
						PRINTFORMW %CALLNAME:MASTER%이것이 바이브를 꺼내자, 새끼는 바이브를 손에 들고 사랑스럽게 혀로 핥고 있다...
						PRINTFORML 「응응 %UNICODE(0x2764)% 한 번에, 깊숙이 와줘... %UNICODE(0x2764)% 바이브 기분 좋아... %UNICODE(0x2764)%」
						PRINTFORMW 타액과 애액으로 뒤덮인 바이브는 쉽게 히나의 질 속으로 파고들며, 히나에게 최고의 희열을 선사했다…….
					CASE 2
						PRINTFORML 「있잖아 %CALLNAME:MASTER%, 이 바이브를…… 써줬으면 해…… %UNICODE(0x2764)%」
						PRINTFORMW 히나가 꺼낸 것은 표면에 사마귀가 붙은 극굵의 바이브였다. ……혹시, 히나의 개인 물건일까?
						PRINTFORML 「아앗 아아아아앗 %UNICODE(0x2764)%, 이거, 보지가 넓어져… %UNICODE(0x2764)% 아아아앗 %UNICODE(0x2764)%%UNICODE(0x2764)%」
						PRINTFORMW 극굵 바이브는 큰 구동음을 내며 히나의 질 속으로 빨려 들어가고, 히나는 전신에서 공 같은 땀을 흘리며 쾌락을 만끽하고 있었다…….
