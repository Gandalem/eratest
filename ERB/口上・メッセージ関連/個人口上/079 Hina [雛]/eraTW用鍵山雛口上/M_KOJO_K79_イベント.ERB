						;記入チェック（=0, 非表示、1, 表示）
						LOCAL:1 = 0
						;-------------------------------------------------
						IF LOCAL:1
							RETURN 1
						ENDIF
						RETURN 1
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
