					ENDSELECT
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;何もしない
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
