@M_KOJO_EVENT_K79_28(ARG,ARG:1)
;口上主はTARGET
;ARGに脱がし方選択
;ARG:1（ARG=3の場合のみあり）地の文の反応
;★時間停止時の処理位置を変更
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;時間停止時
	IF FLAG:時間停止
		RETURN 1
	ENDIF
	SELECTCASE ARG
		;-------------------------------------------------
		CASE 0
			;全裸にする
			;記入チェック（=0, 非表示、1, 表示）
			LOCAL:1 = 1
			;-------------------------------------------------
			IF LOCAL:1
				IF TALENT:恋慕
					;妊娠時に特殊分岐
					IF TALENT:妊娠
						IF CFLAG:TARGET:903 >= 40
							PRINTFORML 「%CALLNAME:MASTER%……, 사랑해」
							PRINTFORML 히나는 배를 감싸면서 %조사처리(CALLNAME:MASTER,"의")% 도움을 받아 옷을 벗어 나갔다.
							PRINTFORMW 크게 부풀어 오른 배를 다정하게 안고 있는 히나의 임산부 모습은, 여성으로서 가장 아름답게 빛난다.
						ELSE
							PRINTFORML 「……? %CALLNAME:MASTER%, 무슨 일이야?」
							PRINTFORML 히나를 벌거벗긴 %조사처리(CALLNAME:MASTER,"는")%, 히나의 신체 변화에 눈치챘다.
							PRINTFORMW 임신(妊娠)의 영향일까, 히나의 몸이 윤기를 더하고 있는 것 같다…….
						ENDIF
						;相手主導うふふ時に特殊分岐
						;ELSEIF CFLAG:うふふ == 2
					ELSE
						SELECTCASE RAND:5
							CASE 0
								PRINTFORML 「……많이 해요, %CALLNAME:MASTER%?」
								PRINTFORMW 태어난 그대로의 모습이 된 히나는 만족스러운 표정을 지으며, %조사처리(CALLNAME:MASTER,"를")% 응시하고 있다…….
							CASE 1
								PRINTFORML 「아우......, 뭐라고 해야 할지, 그......, 하읏, 부끄러워......」
								PRINTFORMW 몇 번이나 피부를 맞댄 관계라 해도, 초심은 건재한 듯하다.
							CASE 2
								PRINTFORML 「%CALLNAME:MASTER%, 정말 좋아...!」
								PRINTFORMW 알몸의 히나가 %조사처리(CALLNAME:MASTER,"에게")% 안겨왔다. 피부를 통해 히나의 체온이 전해져 왔다…….
							CASE 3
								PRINTFORML 「%조사처리(CALLNAME:MASTER,"에게")%……, 벗겨져 버렸어……」
								PRINTFORMW 그렇게 말하는 히나는 기쁜 듯 미소를 띠고 있다…….
							CASE 4
								PRINTFORML 「있잖아 %CALLNAME:MASTER%…… 빨리, 벗자……?」
								PRINTFORMW %조사처리(CALLNAME:MASTER,"에게")% 옷과 속옷을 벗겨진 것으로 보아, 히나는 본격적으로 스위치가 들어간 듯하다……。
						ENDSELECT
					ENDIF
				ELSEIF TALENT:思慕
					PRINTFORML 「%CALLNAME:MASTER%…… 아, 그렇게 빤히 보지 말아 주세요……」
					PRINTFORMW 새끼의 나체 몸을 훑어보는 %조사처리(CALLNAME:MASTER,"의")% 모습을 보고, 새끼는 부끄러움에 얼굴을 붉히고 있다…….
					;それ以外
				ELSE
					PRINTFORML 「으윽......, 역시 부끄러워......」
					PRINTFORMW 한쪽 팔로 가슴을, 다른 쪽 손으로 은밀한 곳을 가리면서, 히나는 긴장한 모습으로 몸을 떨고 있다…….
				ENDIF
				RETURN 1
			ENDIF
			;-------------------------------------------------
		CASE 1
			;下着姿にする
