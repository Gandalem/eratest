LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;時間停止
	IF FLAG:時間停止
		RETURN 1
	ENDIF
	;睡眠中
	IF CFLAG:TARGET:睡眠
		RETURN 1
	ENDIF
	;★直前のカウンター行動で分岐
