IF LOCAL
	;時間停止
	IF FLAG:時間停止
		RETURN 1
	ENDIF
	;睡眠中
	IF CFLAG:TARGET:睡眠
		RETURN 1
	ENDIF
	;初回
	IF FIRSTTIME(311)
		PRINTFORML 「……슬슬, 떨어져 주지 않겠니」
		PRINTFORMW 히나는 유난히 차갑게 내뱉었다.
		PRINTFORML 　
		PRINTFORML 「우와..., 당신, 온몸에 얼룩이 묻어 있잖아요...」
		PRINTFORMW 히나는 놀라움의 목소리를 내고 있다. 아마 상당히 심각한 상황인 것 같다...
		PRINTFORML 　
		PRINTFORML 「……뭐, 겨우 아프게 돼서 반성하는 거지」
		PRINTFORMW 자업자득이라는 건 알고 있지만, 히나가 이렇게 밀어내는 건 드문 것 같다.
		;二回目以降
	ELSE
		IF TALENT:恋慕
			;MASTER主導のうふふ
			IF CFLAG:うふふ == 1
				PRINTFORML 「후아아아... %UNICODE(0x2764)% 응, %CALLNAME:MASTER%... %UNICODE(0x2764)%」
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 열정적인 포옹에 히나는 완전히 정신을 못 차리고 있다…….
				;TARGET主導のうふふ
			ELSEIF CFLAG:うふふ == 2
				;だいしゅきホールド時に特殊分岐
				IF TCVAR:20 == 86
					PRINTFORML 「하아아~~ %UNICODE(0x2764)% 아아아, %CALLNAME:MASTER%윽, 좋아해, 정말 정말 좋아해!! %UNICODE(0x2764)%%UNICODE(0x2764)%」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 히나의 몸을 꽉 끌어안고, 더욱 깊숙이 연결되었다……。
				ELSE
					PRINTFORML 「괜찮아, %CALLNAME:MASTER%… 더 나한테 기대도 돼……?」
					PRINTFORMW 히나는 상냥하게 말을 걸며, %조사처리(CALLNAME:MASTER,"의")% 포옹을 받아들였다…….
				ENDIF
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「……언제까지나, 이렇게 있고 싶어」
						PRINTFORMW 히나는 눈을 감고, %조사처리(CALLNAME:MASTER,"에게")% 몸을 기댔다…….
					CASE 1
						PRINTFORML 「......나, 행복해.」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 몸에 팔을 감고, 다시 안았다…….
				ENDSELECT
			ENDIF
		ELSEIF TALENT:思慕
			PRINTFORML 「저, 저기 잠깐만 %CALLNAME:MASTER%…… 대체 무슨 일이야……」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 갑자기 안아왔기에 히나는 당황했다.
			;それ以外
		ELSE
			PRINTFORML 「정말, 당신은 지겹지 않네요……」
			PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"를")% 밀어냈다…….
		ENDIF
	ENDIF
	;絶頂判定
	CALL M_KOJO_MESSAGE_EVENT_K79_EX_ORGASM
ENDIF
RETURN 1
