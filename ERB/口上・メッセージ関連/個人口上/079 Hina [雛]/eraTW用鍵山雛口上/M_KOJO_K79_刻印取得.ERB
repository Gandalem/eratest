; Modular ERB: 個人口上/079 Hina [雛]/eraTW用鍵山雛口上/M_KOJO_K79_刻印取得.ERB
;-------------------------------------------
;刻印取得
;-------------------------------------------

@M_KOJO_MESSAGE_MARKCNG_K79
;苦痛刻印
IF TFLAG:22 == 1
	PRINTFORML 「……아파!」
	PRINTFORMW 히나는 너무 아파서 무심코 소리를 질렀다.
ELSEIF TFLAG:22 == 2
	PRINTFORML 「아파 아파 아파 아파 아파...! 제, 이제 용서해 주세요...!」
	PRINTFORMW 창조를 끊을 듯한 고통을 몸으로 받은 히나는 %조사처리(CALLNAME:MASTER,"에게")% 용서를 구했다.
ELSEIF TFLAG:22 == 3
	PRINTFORML 「우윽… 아아아앗, 크으윽, 큭 아아아악!!!」
	PRINTFORMW 온몸을 꿰뚫는 극심한 고통을 견디지 못하고 히나는 짐승 같은 비명을 질렀다.
ENDIF
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 히나의 몸에 성적인 쾌감을 새겨 넣었다…….
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORMW 시간을 멈추고 있음에도, 히나의 몸은 %조사처리(CALLNAME:MASTER,"를")% 갈망하며 아파하고 있는 것처럼 보인다...
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORMW 시간이 멈춘 세계에서 육욕을 가르침 받은 히나의 몸은, 가벼운 애무에도 민감하게 반응하고 있다…….
ENDIF
;快楽刻印
IF TFLAG:23 == 1
	PRINTFORML 「후아앗… 아, 아앗…… 이게 뭐야……%UNICODE(0x2764)%」
	PRINTFORMW 전신을 감싸는 나른한 감각에 히나는 당황하면서도 그것을 받아들였다…….
ELSEIF TFLAG:23 == 2
	PRINTFORML 「아앗, 아……. %UNICODE(0x2764)%, 어쩌지, 이거…, 기, 기분 좋아어……. %UNICODE(0x2764)%」
	PRINTFORMW 거부할 수 없는 성적인 쾌감이 히나의 마음을 서서히 뒤덮어갔다……。
ELSEIF TFLAG:23 == 3
	PRINTFORML 　
	PRINTFORML 「하아앗, 아앗…%UNICODE(0x2764)% 하앗, 하앗……, 아앗, 하앗……%UNICODE(0x2764)%」
	PRINTFORMW 강렬한 쾌락에 휩싸인 히나는 아직 절정의 여운으로 몸을 떨면서 거친 숨을 몰아쉬고 있었다.
	PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 히나의 모습을 살피자, 히나는 쾌락에 녹은 표정을 %조사처리(CALLNAME:MASTER,"에게")% 보였다. 
	PRINTFORMW 그 눈빛에서 이성의 불꽃은 완전히 사라져 있었다…….
	PRINTFORML 「있잖아, 더…%UNICODE(0x2764)%, 더, 기분 좋은 걸……, 줘……%UNICODE(0x2764)%」
	PRINTFORMW 성의 황홀경을 몸에 새긴 히나는 멍한 모습으로 %조사처리(CALLNAME:MASTER,"에게")% 더욱 큰 쾌락을 바랐다…….
ENDIF
;不埒刻印
;快楽による刻印
;LV1
IF TFLAG:24 == 11
	PRINTFORML (%조사처리(CALLNAME:MASTER,"에게")% 이런 일을 당하고, 나는 속으로 기뻐하는 건가……?)
	PRINTFORML 히나는 마음속에 싹튼 이상한 감정에 갈등하고 있는 듯하다…….
	PRINTFORMW 
	;LV2
ELSEIF TFLAG:24 == 12
	PRINTFORML (아앗, 이런 건 안 되는데……. 가슴이 들뜨는 걸 참을 수가 없어……%UNICODE(0x2764)%)
	PRINTFORML 녹아내릴 듯한 쾌락이 히나의 사고 회로를 침식해갔다…….
	PRINTFORMW 
	;LV3
ELSEIF TFLAG:24 == 13
	PRINTFORML (%조사처리(CALLNAME:MASTER,"는")% 나를 기분 좋게 해준다……. 아아, 더 기분 좋은 것이 갖고 싶다……. %UNICODE(0x2764)%)
	PRINTFORML 쾌락의 노예가 된 히나는 무의식중에 은밀한 곳과 가슴에 손을 뻗고 있다…….
	PRINTFORMW 
	;屈服、恭順による刻印
	;LV1
ELSEIF TFLAG:24 == 31
	;うふふ中の場合特殊分岐
	IF CFLAG:うふふ
		PRINTFORML 「히야앗! 저, 방금 건, 좀, 좋았을지도……」
		PRINTFORML 의식하지 않고 큰 소리가 나왔다는 것을 부끄러워하며, 히나는 작게 중얼거렸다…….
		PRINTFORMW 
	ELSE
		PRINTFORML 「%CALLNAME:MASTER%…… 그, 어... 아무것도 아니야」
		PRINTFORML %조사처리(CALLNAME:MASTER,"를")% 바라보며 히나는 작게 웃었다.
		PRINTFORMW 
	ENDIF
	;LV2
ELSEIF TFLAG:24 == 32
	IF CFLAG:うふふ
		PRINTFORML 「아앗, 응윽! %CALLNAME:MASTER%... 괜찮아, 더 해줘...」
		PRINTFORML 히나는 쾌락에 녹은 표정을 지으며, 넋을 잃고 있다...
		PRINTFORMW 
	ELSE
		PRINTFORML 「%CALLNAME:MASTER%…, %CALLNAME:MASTER%…. 후훗」
		PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 이름을 중얼거리며, 히나는 미소 짓고 있다.
		PRINTFORMW 
	ENDIF
	;LV3
ELSEIF TFLAG:24 == 33
	IF CFLAG:うふふ
		PRINTFORML 「하아, 하아……, %CALLNAME:MASTER%윽, %CALLNAME:MASTER%윽……%UNICODE(0x2764)%」
		PRINTFORML 완전히 발정 상태인 히나는 달콤한 한숨을 내쉬며, %조사처리(CALLNAME:MASTER,"에게")% 시선을 보냈다…….
		PRINTFORMW 
	ELSE
		PRINTFORML 「%CALLNAME:MASTER%. 나에게 할 수 있는 일이 있다면..., 주저하지 말고 말해 보렴?」
		PRINTFORML 히나에게 %조사처리(CALLNAME:MASTER,"는")% 믿을 만한 상대가 된 것 같다.
		PRINTFORMW 
	ENDIF
ENDIF
;反発刻印
IF TFLAG:21 == 1
	PRINTFORML 「이제 그만둬......」
	PRINTFORMW 평소 조용한 히나가 분노의 표정을 짓고 있다.
ELSEIF TFLAG:21 == 2
	PRINTFORML 「...더 가까이 오지 마세요」
	PRINTFORMW 히나는 목소리를 높여 %CALLNAME:MASTER%에 경고했다.
ELSEIF TFLAG:21 == 3
	PRINTFORML 「……사라져라. 다시는 내 앞에 나타나지 마」
	PRINTFORMW 히나는 표정을 일그러뜨리며 분노로 떨고 있다.
ENDIF
