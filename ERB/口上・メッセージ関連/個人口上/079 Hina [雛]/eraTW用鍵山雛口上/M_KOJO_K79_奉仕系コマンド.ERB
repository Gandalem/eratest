;81,フェラチオ
;==================================================

@M_KOJO_MESSAGE_COM_K79_81
CALL M_KOJO_MESSAGE_COM_K79_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_81_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「…내가 듣는 것도 그렇지만, 그…… 거기, 제대로 깨끗하게 하고 있는 거죠……?」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 괜찮다고 대답하자, 히나는 조심스럽게 %조사처리(CALLNAME:MASTER,"의")% 성기를 핥았다.
		ELSE
			PRINTFORML 「윽… 우엣… 나, 왜 그런 걸, 핥아야 하는 거야…… 에우으윽……」
			PRINTFORMW 약간 눈물이 고인 채로 히나는 %조사처리(CALLNAME:MASTER,"의")% 성기 끝을 살짝 핥았다.
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕
		IF ABL:舌 >= 5
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「앗…, %조사처리(CALLNAME:MASTER,"의")% 거시기..., 음쪽..., 쪽%UNICODE(0x2764)% 주르륵..., 좔좔...%UNICODE(0x2764)%」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 남근을 내밀자, 히나는 기쁜 듯이 %조사처리(CALLNAME:MASTER,"의")% 성기를 입에 넣고 목구멍 깊숙한 곳까지 받아들였다…….
					PRINTFORML 「츄폰..., 하아, 하아...%UNICODE(0x2764)% 히나의, 입안... , 역겹다, 그렇죠...?」
					PRINTFORMW 성기에 혀를 감기고 목구멍 안쪽을 골고루 빨면서, 히나는 %조사처리(CALLNAME:MASTER,"의")% 성기를 정신없이 빨고 있었다…….
				CASE 1
					PRINTFORML 「치로옷, 주루옷, 페로옷……%UNICODE(0x2764)% 꾸읏, 추푼앗…%UNICODE(0x2764)%」
					PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 육봉을 사랑스럽게 핥아대며, 덕분에 육봉은 히나의 타액으로 미끌미끌해졌다…….
					PRINTFORML 「츳…%UNICODE(0x2764)% 아문앗, 주루룻…, 오친친옷, 오이힛…! 응우앗, 주폿, 주폿……!」
					PRINTFORMW 귀두에 살짝 입맞춤한 것을 신호로, 히나는 기둥의 뿌리까지 한 번에 입에 넣고 따뜻한 혀와 입술로 %조사처리(CALLNAME:MASTER,"의")% 육봉을 유린했다…….
				CASE 2
					PRINTFORML 「아앗, %조사처리(CALLNAME:MASTER,"의")% 성이... %UNICODE(0x2764)% 하아, 하아..., 성, 빨리, 주세요...?」
					PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 남근에 마음을 빼앗긴 히나는 흥분한 모습으로 크게 솟아오른 %조사처리(CALLNAME:MASTER,"의")% 기둥에 혀를 움직였다.
					PRINTFORML 「음추루엣... %UNICODE(0x2764)%, 쪽, 하읏, 함읍..., 음므읏, 응, 주루엣, 주루루엣 %UNICODE(0x2764)% 츄폰앗, 푸하앗...!」
					PRINTFORMW 기세가 너무 넘쳐 입에서 튀어나와 떨며 경련하는 %조사처리(CALLNAME:MASTER,"의")% 육봉을 히나는 황홀한 표정으로 바라보고 있다…….
				CASE 3
					PRINTFORML 「%조사처리(CALLNAME:MASTER,"의")% 거시기, 히나가 핥아주며 깨끗하게 해줄게엣」
					PRINTFORMW 그렇게 말한 히나는 때가 많이 끼는 귀 밑부분을 정성스럽게 핥기 시작했다. ……깨끗하게 하고 있었는지 조금 불안해진다.
					PRINTFORML 「음쪽, 쪽빠아앗…%UNICODE(0x2764)% 응, 큭, 헤헷, 예뻐……응, 주륵%UNICODE(0x2764)% 쭉 빠앙… , 쩝쩝……!」
					PRINTFORMW 깨끗하게 해주겠다는 목적을 포기하고, 히나는 입에 문 %조사처리(CALLNAME:MASTER,"의")% 성기를 한참 동안 놓지 않았다…….
				CASE 4
					PRINTFORML 「후훗, 하아무... %UNICODE(0x2764)% 음무, 쭉, 쪽...!」
					PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 고환을 입에 넣고, 사탕처럼 입안에서 굴리고 있다…….
					PRINTFORML 「앗..., %CALLNAME:MASTER%, 기분 좋아지고 있구나... %UNICODE(0x2764)% 응, 주루륵!」
					PRINTFORMW 귀두 끝에 액체가 고여 있는 것을 발견한 히나는 눈을 빛내며 그 액체를 삼키고, 그대로 성기를 삼켰다…….
			ENDSELECT
		ELSEIF ABL:舌 >= 2
			PRINTFORML 「앗..., 또 봉사하게 해주는 거야...?」
			PRINTFORMW 약간 흥분한 듯한 히나는 눈앞에 내밀어진 %조사처리(CALLNAME:MASTER,"의")% 남근을 망설임 없이 입안으로 받아들였다.
			PRINTFORML 「쭈륵, 주보봇, 츄반앗, 하아하앗..., %조사처리(CALLNAME:MASTER,"의")% 맛, 좋아해버렸을지도 몰라...」
			PRINTFORMW 완전히 남근의 맛에 중독된 히나는 스스로 적극적으로 봉사에 힘썼다....
		ELSE
			PRINTFORML 「그, 그럼..., 하무읏... 응, 츄읍..., 푸핫, 츄루읏, 주르르륵...」
			PRINTFORMW 갑자기 히나는 %조사처리(CALLNAME:MASTER,"의")% 성기를 입에 넣었다. 그 너무나 기분 좋은 것에 %조사처리(CALLNAME:MASTER,"는")% 나도 모르게 신음했다.
			PRINTFORML 「...?? 혹시, 여기... 키모히이노...? 응주루읏, 응무으읍...」
			PRINTFORMW 입안이 남자의 향기에 뒤덮여가면서도, %조사처리(CALLNAME:MASTER,"가")% 신음하는 모습을 보고 히나는 충족감으로 가득 차갔다....
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「우와아... 나, 뭔가 굉장한 냄새가 난다...」
		PRINTFORMW 남근에서 발산되는 독특한 향기에 얼굴을 찡그리면서도 히나는 혀끝으로 귀두나 요도를 주르륵 핥고 있다.
		PRINTFORML 「하지만... 쭈릅, 이것도, 으응, 나쁘지 않아, 츄폿, 슈루와...」
		PRINTFORMW 하지만 그 향기는 거부할 수 없이 히나의 비강을 자극하고, 서서히 여자의 본능이 깨어나고 있다....
		;それ以外
	ELSE
		PRINTFORML 「치로옷..., 으윽..., 써, 짜...」
		PRINTFORMW 페라에 익숙하지 않은 히나에게는 남성의 성기 끝을 조금씩 핥는 것이 전부였다.
		PRINTFORML 「이, 이런 걸... 빨다니, 무리야...」
		PRINTFORMW 아무래도 히나는 아직 입에 넣는 것에 거부감이 있는 듯하다.
	ENDIF
ENDIF
RETURN 1
