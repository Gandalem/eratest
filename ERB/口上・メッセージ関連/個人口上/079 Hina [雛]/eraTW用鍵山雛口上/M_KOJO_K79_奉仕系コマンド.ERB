;80,手淫
;==================================================

@M_KOJO_MESSAGE_COM_K79_80
CALL M_KOJO_MESSAGE_COM_K79_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_80_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕
			PRINTFORML 「뭐, 뭐, 나도 여러 가지로 %조사처리(CALLNAME:MASTER,"에게")% 해주고 있는 거니까... 이런 건 서로 맞춰주는 거지...」
			PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"에게")% 당했던 것을 떠올리며, 얼굴을 붉히면서도 납득한 듯 %조사처리(CALLNAME:MASTER,"의")% 성기에 손을 댔다……。
		ELSE
			PRINTFORML 「에엣!? 그, 그것을…… 내 손으로 비비는 거야…? 우윽…, 알겠어」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 요구에 히나의 표정이 순간 일그러졌지만, 마지못해 승낙했다…….
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕
		IF ABL:指 >= 5
			;この後射精する(射精寸前の描写)
			IF NOWEX:PLAYER:射精
				PRINTFORML 「앗... %UNICODE(0x2764)% %CALLNAME:MASTER%, 이제 갈 것 같아?」
				PRINTFORMW 페니스의 미세한 변화를 눈치챈 히나는 %조사처리(CALLNAME:MASTER,"에게")% 물었다.
				PRINTFORML 「자, 자, 이젠 싸자, 쭈욱 하고 하고 싶지? 참지 말고 잔뜩 내보내 봐?」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 육봉을 필사적으로 만지면서, 사랑이 가득한 표정으로 %조사처리(CALLNAME:MASTER,"를")% 바라보고 있다…….
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 「네~ %조사처리(CALLNAME:MASTER,"의")% 거시기, 비벼줄게요~」
						PRINTFORMW 자위의 요령을 터득한 히나는 손가락을 얽으면서 경쾌한 리듬으로 성기를 만지고 있다.
						PRINTFORML 「음~ %UNICODE(0x2764)% 이렇게 하면... 미끌미끌해서 기분 좋지...? %UNICODE(0x2764)%」
						PRINTFORMW 히나는 타액을 %조사처리(CALLNAME:MASTER,"의")% 페니스에 흘리며 움직임을 부드럽게 이어나갔다…….
					CASE 1
						PRINTFORML 「후훗, %조사처리(CALLNAME:MASTER,"의")% 여기..., 딱딱하네... %UNICODE(0x2764)%」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 고환을 주무르며, 솟아오른 %조사처리(CALLNAME:MASTER,"의")% 성기를 바라보고 있다…….
						PRINTFORML 「그럼, 기다리던 순간이군.... 꽉 조여줄게 %UNICODE(0x2764)%」
						PRINTFORMW 히나는 양손으로 %조사처리(CALLNAME:MASTER,"의")% 남성기를 움켜쥐고, 성기 전체를 만지기 시작했다…….
					CASE 2
						PRINTFORML 「에잇! ……크으윽%UNICODE(0x2764)%」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 성기를 꽉 움켜쥐었다. 하지만 그 힘 조절은 절묘해서 통증보다는 오히려 기분 좋을 정도였다.
						PRINTFORML 「거기뿐만이 아니야, 뭘 다루는 것만 하는 게 아니라구...?」
						PRINTFORMW 그렇게 말하는 히나는 어딘가 의기양양해 보였다.
					CASE 3
						PRINTFORML 「……이런 건 어때요?」
						PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 성기를 능숙한 손길로 만지면서, 손끝을 움직여 성기에 자극을 주었다.
						PRINTFORML 「어때요? %조사처리(CALLNAME:MASTER,"의")% 거시기, 정말 기분 좋죠...?」
						PRINTFORMW 때때로 주는 자극에 강약을 조절하면서, 히나는 %조사처리(CALLNAME:MASTER,"의")% 성기를 가지고 즐기고 있었다…….
					CASE 4
						PRINTFORML 「응… 빙글빙글, 꾹꾹…」
						PRINTFORMW 히나는 손바닥으로 %조사처리(CALLNAME:MASTER,"의")% 귀두를 비비고 있다. 강렬한 자극에 %조사처리(CALLNAME:MASTER,"는")% 무심코 몸을 비틀 것 같다.
						PRINTFORML 「후후훗, %조사처리(CALLNAME:MASTER,"는")% 얼굴이 새빨갛잖아…? 그렇게 기분이 좋았던 거야…?」
						PRINTFORMW 히나는 손길을 풀며 애태우면서, 들뜬 %조사처리(CALLNAME:MASTER,"의")% 성기를 바라보고 있다…….
				ENDSELECT
			ENDIF
		ELSEIF ABL:指 >= 2
			;この後射精する(射精寸前の描写)
			IF NOWEX:PLAYER:射精
				PRINTFORML 「...어라? 혹시 슬슬 나올 때가 된 걸까? 그렇다면...!」
				PRINTFORMW 그렇게 말하자 히나는 움직이는 속도를 높이며, %조사처리(CALLNAME:MASTER,"의")% 사정을 재촉해 나갔다....
				PRINTFORML 「자, %CALLNAME:MASTER%. '여기'에서 마음껏 싸버리렴?」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 고환을 가볍게 주무르며 남성기 전체를 쓸어내렸다....
			ELSE
				PRINTFORML 「……어때? 나도 꽤 익숙해졌잖아?」
				PRINTFORMW 예전의 서투름은 사라지고, 히나는 일정한 템포로 남성 성기를 다루고 있었다.
				PRINTFORML 「후훗, %CALLNAME:MASTER%, 기분 좋아 보여……」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 상태를 살필 여유까지 보였다. 아무래도 자위하는 것을 즐기고 있는 듯했다.
			ENDIF
		ELSE
			;この後射精する(射精寸前の描写)
			IF NOWEX:PLAYER:射精
				PRINTFORML 「%CALLNAME:MASTER%, 얼굴이 빨갛지만 괜찮아...?」
				PRINTFORMW 걱정스럽게 하는 히나에게, %조사처리(CALLNAME:MASTER,"는")% 이제 곧 한계가 다가옴을 전했다.
				PRINTFORML 「엣, 그, 그런 거야...? 그렇다면 나도 노력할게...!」
				PRINTFORMW 히나는 서툰 방식으로 처리하는 페이스를 올렸다...
			ELSE
				PRINTFORML 「아, 아프면 바로 말해줘...?」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"를")% 상처 입히지 않으려고 천천히 성기를 다루고 있다.
				PRINTFORML 「저기... %CALLNAME:MASTER%기분 좋게 해주고 있나...?」
				PRINTFORMW 양손으로 %조사처리(CALLNAME:MASTER,"의")% 성기를 부드럽게 감싸 안으며, 히나는 필사적으로 봉사를 계속했다....
			ENDIF
		ENDIF
		;屈服3
	ELSEIF MARK:不埒刻印 == 3
		;この後射精する(射精寸前の描写)
		IF NOWEX:PLAYER:射精
			PRINTFORML 「자, 끝부분에서 뭔가 나오고 있는데……」
			PRINTFORMW 스즈구치에서 분비되는 선행을 보고, 히나는 불안한 목소리를 냈다.
			PRINTFORML 「즉, 곧 나올 거라는 건가……? 으윽」
			PRINTFORMW 사정하는 순간을 상기했는지, 히나의 표정이 한순간 일그러졌다…….
		ELSE
			PRINTFORML 「앗......, 이거..., 엄청 뜨겁고, 파르르 떨리고 있어...!」
			PRINTFORMW 손에서 전해지는 뜨거운 감각에 히나는 눈을 동그랗게 뜨고, 그 열원인 %조사처리(CALLNAME:MASTER,"의")% 부풀어 오른 것을 응시하고 있다....
			PRINTFORML 「죄, 죄송해요..., 그럼, 시작할게요...」
			PRINTFORMW 정신이 돌아온 히나는 황급히 %조사처리(CALLNAME:MASTER,"의")% 성기를 만지기 시작했다....
		ENDIF
		;それ以外(※射精寸前描写は無し)
	ELSE
		PRINTFORML 「저, 저기, 이거... 무서워요...」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 성기를 잡은 히나의 표정에는 불안감이 가득했으며, 당장 봉사할 것 같아 보이지 않았다.
		PRINTFORML 「음... 이런 식으로 해도 괜찮을까요...?」
		PRINTFORMW 성기를 다루는 손길은 서툴렀고, 도저히 기분 좋다고 말하기 어려웠다. 조금씩 익숙해지게 해줘야 할 것 같았다.
	ENDIF
ENDIF
RETURN 1
