@M_KOJO_MESSAGE_COM_K79_3
CALL M_KOJO_MESSAGE_COM_K79_3_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_3_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORML 
		ELSEIF TALENT:恋慕
			PRINTFORML 「응, 으윽…. 뭐, 뭔가 끼인 느낌이랄까, 그게… 진정되지 않아……」
			PRINTFORMW 히나의 질 입구는 어떻게든 %조사처리(CALLNAME:MASTER,"의")% 새끼손가락을 삼키고 있지만, 안은 여전히 단단하다.
		ELSE
			PRINTFORML 「……윽, 우으윽!! 아, 부탁이야…, 빼줘……」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 히나의 질 입구에 새끼손가락을 밀어 넣자, 히나는 괴로운 듯 저항하는 소리를 냈다.
		ENDIF
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:時間停止
		PRINTFORMW 
		RETURN 1
	ELSEIF TALENT:恋慕
		IF ABL:Ｖ感覚 > 9
			SELECTCASE RAND:5
				CASE 0
					PRINTFORML 「응… 처음엔 새끼손가락조차 고통스러웠는데……. 아, 몸이란 신비하네……. 음으윽 %UNICODE(0x2764)%」
					PRINTFORMW 히나의 꿀 항문은 %조사처리(CALLNAME:MASTER,"의")% 검지와 중지를 밑동까지 아무렇지도 않게 빨아들였고, 질벽은 만족스럽게 두 손가락을 조이고 있었다…….
					PRINTFORML 「아아앗 %UNICODE(0x2764)% 아우욱, 햐앗!? 랄, 라메, 그럴 수는, 너무 격렬해, 으응… 햐안 %UNICODE(0x2764)% 아아아아아앗…!!!」
					PRINTFORMW 두 손가락으로 히나의 질 안을 거칠게 휘저으니, 히나는 하반신을 벌벌 떨면서 암혈의 쾌락에 취했다…….
				CASE 1
