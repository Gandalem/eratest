@M_KOJO_MESSAGE_COM_K79_0
CALL M_KOJO_MESSAGE_COM_K79_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K79_0_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;初めて
	IF FIRSTTIME(SELECTCOM)
		IF FLAG:時間停止
			PRINTFORML 시간이 멈춘 세상에서, %조사처리(CALLNAME:MASTER,"는")% 히나의 몸을 쓰다듬어 나간다.
			PRINTFORMW 당연히, 히나가 저항할 리가 없었고, 무의식 그대로 %조사처리(CALLNAME:MASTER,"의")% 애무를 받아들였다…….
		ELSEIF TALENT:恋慕
			PRINTFORML 「그게…… 상냥하게, 해줘...?」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 고개를 끄덕이고, 히나의 몸을 상냥하게 쓰다듬기 시작했다…….
		ELSE
			PRINTFORML 「윽……, 우으윽……」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 애무를 받는 히나의 몸은 경직되어 있다…….
		ENDIF
		RETURN 1
	ENDIF
	;二回目以降
	;V挿入中
	IF TEQUIP:50 == PLAYER
		IF TALENT:恋慕
			PRINTFORML 「앗 %UNICODE(0x2764)% 햐앗, %CALLNAME:MASTER%윽... %UNICODE(0x2764)% 후응, 아앙 %UNICODE(0x2764)%」
			PRINTFORMW %조사처리(CALLNAME:MASTER,"는")% 허리를 움직이며 히나의 몸을 부드럽게 애무했다....
			PRINTFORML 「캬앗, 그쪽은 엣... %UNICODE(0x2764)% 아아앗, 라메옷 %UNICODE(0x2764)% 기분 좋네 %UNICODE(0x2764)% 후아앙!」
			PRINTFORMW 몸의 모든 부위에서 쾌감이 밀려와 참지 못하고 히나는 신음 소리를 내고 있다....
		ELSE
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
	;A挿入中
	IF TEQUIP:51 == PLAYER
		IF TALENT:恋慕
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
	;ふたなり
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		IF TALENT:恋慕
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:時間停止
		RETURN 1
		;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:5
			CASE 0
				PRINTFORML 「후응, 햐앙... %UNICODE(0x2764)%, 아, 파아앗 %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 가벼운 애무에도 히나의 몸은 민감하게 반응하며 쾌감을 가져다주고 있다…….
			CASE 1
				PRINTFORML 「응... %UNICODE(0x2764)% 하아, 아... %UNICODE(0x2764)% 응, %CALLNAME:MASTER%윽... %UNICODE(0x2764)%%UNICODE(0x2764)%」
				PRINTFORMW 히나의 몸을 천천히 가지고 놀자, 히나는 숨을 거칠게 몰아쉬며 몸을 비틀고 있었다...
			CASE 2
				PRINTFORML 「응, 아아앗, 앗… %UNICODE(0x2764)% 거기…, 기분 좋아… %UNICODE(0x2764)%」
				PRINTFORMW 온몸을 부드럽게 감싸 안는 듯한 애무에 히나의 표정은 녹아내리고 있다…….
			CASE 3
				PRINTFORML 「아앗, %CALLNAME:MASTER%……%UNICODE(0x2764)% %CALLNAME:MASTER%윽……%UNICODE(0x2764)%」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 애무를 원하며 스스로 몸을 가까이 했다…….
			CASE 4
				PRINTFORML 「하아아앗……%UNICODE(0x2764)% %CALLNAME:MASTER%윽, 더…, 더 해줘……%UNICODE(0x2764)%」
				PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 애무에 완전히 취해 있는 것 같다…….
		ENDSELECT
		;不埒3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 「앗…… 응응… 아, 하아앗……」
		PRINTFORMW 히나는 %조사처리(CALLNAME:MASTER,"의")% 애무를 받아들이며 달콤한 소리를 내고 있다…….
		PRINTFORML 「…햣! 아아, 거긴…… 안, 안 돼어...!」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"가")% 히나의 비밀스러운 곳에 손을 뻗자, 히나는 자신도 모르게 몸을 비틀었다.
		;それ以外
	ELSE
		PRINTFORML 「응... 응, 윽..., 응...」
		PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% 애무에 히나는 몸을 경직시키고 있다…….
		PRINTFORML 「응, 아앗..., 응, 응아앗...」
		PRINTFORMW 하지만 비열이나 유두 자극에는 민감한 반응을 보이고 있으며, 쾌락의 조짐이 보이기 시작했다.
	ENDIF
	;絶頂判定
	CALL M_KOJO_MESSAGE_EVENT_K79_EX_ORGASM
ENDIF
RETURN 1
