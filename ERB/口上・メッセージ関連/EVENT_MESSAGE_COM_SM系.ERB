;102,蝋燭
;-------------------------------------------------

@MESSAGE_COM102
IF FLAG:70 == 1
	PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% 촛불에 불을 붙이고 데워진 왁스를, 시간을 멈춘다
	;縄などで緊縛中
	SIF TEQUIP:縄
		PRINT 밧줄로 묶었다
	PRINTFORM 다%조사처리(CALLNAME:TARGET,"의")%
	;調教者がサド
	IF TALENT:PLAYER:サド
		PRINT 민감한 부분을 집중적으로
	ELSE
		;(eraElona用素質[アルビノ]の代わり)、痛みに弱いを見る
		IF TALENT:痛覚 > 1
			PRINT 새하얀 맨살에
		ELSE
			PRINT 몸 위에
		ENDIF
	ENDIF
	PRINTL 늘어뜨렸다
ELSE
	PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% 촛불에 불을 붙이자 데워진 왁스를
	;縄などで緊縛中
	SIF TEQUIP:縄
		PRINT 결박되어 움직일 수 없다.
	PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
	;調教者がサド
	IF TALENT:PLAYER:サド
		PRINT 민감한 부분을 집중적으로
	ELSE
		;(eraElona用素質[アルビノ]の代わり)、痛みに弱いを見る
		IF TALENT:痛覚 > 1
			PRINT 새하얀 맨살에
		ELSE
			PRINT 몸 위에
		ENDIF
	ENDIF
	PRINTL 늘어뜨렸다
ENDIF
