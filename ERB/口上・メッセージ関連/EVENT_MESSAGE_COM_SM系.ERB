;100,スパンキング
;-------------------------------------------------

@MESSAGE_COM100
CALL MESSAGE_COM100_TR
RETURN
IF FLAG:70 == 1
	IF TEQUIP:50 == PLAYER
		PRINTFORM 시간을 멈춘 %조사처리(CALLNAME:TARGET,"를")% 격렬하게 범하면서
	ELSEIF TEQUIP:51 == PLAYER
		PRINTFORM 시간을 멈춘 %조사처리(CALLNAME:TARGET,"의")% 국문을 격렬하게 범하면서
	ELSEIF TEQUIP:0 & 1 && (EQUIP:スカート || EQUIP:下半身上着 || EQUIP:ワンピース || EQUIP:着物)
		PRINTFORM 시간을 멈춘 %조사처리(CALLNAME:TARGET,"의")% %SHOW_BOTTOM(TARGET,1)%를 넘기며
	ELSE
		PRINTFORM 시간을 멈춘 %조사처리(CALLNAME:TARGET,"의")%
	ENDIF
	SIF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ
		PRINTFORM %SHOW_下半身下着(TARGET,2)%에 싸여
	PRINTFORML %HIP(TARGET)%를 손바닥으로 세게 때렸다.
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 엉덩이는 새빨갛게 부어갔다...
ELSE
	IF TEQUIP:50 == PLAYER
		PRINTFORM %조사처리(CALLNAME:TARGET,"를")% 격렬하게 범하면서
	ELSEIF TEQUIP:51 == PLAYER
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 국문을 격렬하게 범하면서
	ELSEIF TEQUIP:0 & 1 && (EQUIP:スカート || EQUIP:下半身上着 || EQUIP:ワンピース || EQUIP:着物)
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")% %SHOW_BOTTOM(TARGET,1)%를 넘기며
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")%
	ENDIF
	SIF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ
		PRINTFORM %SHOW_下半身下着(TARGET,2)%에 감싸였다
	PRINTFORML %HIP(TARGET)%를 손바닥으로 세게 때렸다.
	PRINTFORM 몇 번이나 계속 맞고 있는 사이에,
	;オトコ＋マゾっ気LV2以上
	IF !(TALENT:2 & 1) && (ABL:マゾっ気 >= 2)
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 가랑이는 단단해져 갔다...
		;マゾっ気LV2以上
	ELSEIF ABL:マゾっ気 >= 2 && TEQUIP:50 == -1
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 가랑이는 자신의 애액으로 젖기 시작했다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 엉덩이는 새빨갛게 부어갔다...
	ENDIF
ENDIF
