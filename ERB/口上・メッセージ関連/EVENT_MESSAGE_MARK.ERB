; Modular ERB: EVENT_MESSAGE_MARK.ERB
;-------------------------------------------
;刻印取得時のテキスト
;-------------------------------------------

@MARK_MESSAGE
#DIM MM_TARGET
MM_TARGET = TARGET
M:1 = 0
SETCOLOR 247,171,166
SIF (TFLAG:苦痛刻印取得 || TFLAG:時姦刻印取得 || TFLAG:23 || TFLAG:24 || TFLAG:反発刻印取得 || TFLAG:TFLAG_FORCE_GET) && MESSKIP() ;addition custom code, forcewait on acquisition
	FORCEWAIT
CALL MARK_MESSAGE_A
TARGET = MM_TARGET
CALL MARK_MESSAGE_P
TARGET = MM_TARGET
CALL MARK_MESSAGE_S
SIF SHIRAHU(TARGET)
	CALL MARK_MESSAGE_R
CALL MARK_MESSAGE_T
CALL MARK_MESSAGE_AB
CALL MARK_MESSAGE_FORCE() ;rape expansion customs
CALL MARK_MESSAGE_TRAUMA(MM_TARGET)
TARGET = MM_TARGET
CALL SET_KOJO_COLOR()

@MARK_MESSAGE_A
;苦痛刻印
IF FLAG:70 == 1
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORML 시간이 멈춘 동안 고통이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 고통 각인 LV1을 얻었다!
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORML 시간이 멈춘 동안 강한 고통이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 고통 마크 LV2를 얻었다!
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORML 시간이 멈춘 동안, 격렬한 고통이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 고통 각인 LV3을 얻었다!
		IF TALENT:PLAYER:サド
			PRINTFORML 【새드 보너스】
			PRINTL 이상경험 +2
		ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 104
			PRINTFORML 【바늘질 보너스】
			PRINTL 이상경험 +2
		ELSE
			PRINTL 이상경험 +1
		ENDIF
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORML 고통이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다, %HE_SHE(TARGET)%가 악몽을 견디면서...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 고통 각인 LV1을 얻었다!
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORML 강렬한 고통이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다. %HE_SHE(TARGET)%가 악몽을 견디면서...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 고통 표식 LV2를 얻었다!
	ELSEIF TFLAG:苦痛刻印取得 == 3
		PRINTFORML 강렬한 고통이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다. %HE_SHE(TARGET)%는 악몽을 견딘다...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 고통 각인 LV3를 얻었다!
		IF TALENT:PLAYER:サド
			PRINTFORML 【당신은 새드다】
			PRINTL 이상경험+2
		ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 104
			PRINTFORML 【바늘질 스킬을 가졌다.】
			PRINTL 이상경험 +2
		ELSE
			PRINTL 이상경험 +1
		ENDIF
	ENDIF
ELSE
	IF TFLAG:苦痛刻印取得 == 1
		PRINTFORM 
		IF TARGET == 57 && !TALENT:恋慕
			PRINTFORM 오바와 사루 가면이 떠다닌다 %CALLNAME:TARGET%
		ELSE
			PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 얼굴이 고통으로 일그러져 있다.
		ENDIF
		PRINTFORML 하지만 %HE_SHE(TARGET)%은 그것을 견딘다...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 고통의 각인 LV1을 얻었다!
	ELSEIF TFLAG:苦痛刻印取得 == 2
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 잠시 고통으로 울부짖는다.
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 고통의 각인 LV2를 획득했다!
		IF TFLAG:刻印従順変化 == 1 && M:1 == 0
			PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 LV1로 증가했다!
			M:1 = 1
		ENDIF
	ELSEIF TFLAG:苦痛刻印取得 == 3
		LOCALS:0 = 
		IF TARGET == 57 && !TALENT:恋慕
			LOCALS:0 = 하지만 표정 변화는 없다.
		ENDIF
		PRINTFORML %CALLNAME:TARGET%울고 비명을 지른다 %LOCALS:0% 고통스럽게...
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 고통의 각인 LV3를 획득했다!
		IF TFLAG:刻印従順変化 == 1 && M:1 == 0
			PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 LV1로 증가했다!
			M:1 = 1
		ENDIF
		IF TALENT:PLAYER:サド
			PRINTFORML 【「새드」를 가졌다.】
			PRINTL 이상경험+2
		ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 104
			PRINTFORML 【바늘질 스킬을 가지고 있다】
			PRINTL 이상경험 +2
		ELSE
			PRINTL 이상경험 +1
		ENDIF
	ELSEIF TFLAG:苦痛刻印取得 == 4
		PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 고통으로 비명을 지른다. 
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 고통의 각인 LV4를 획득했다!
		IF TFLAG:刻印従順変化 == 1 && M:1 == 0
			PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 레벨 5로 증가했다!
			M:1 = 1
		ENDIF
		IF TALENT:PLAYER:サド
			PRINTFORML 【당신은 새드다】
			PRINTL 이상경험+2
		ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 104
			PRINTFORML 【바늘질 스킬을 가졌다.】
			PRINTL 이상경험 +2
		ELSE
			PRINTL 이상경험 +1
		ENDIF
	ELSEIF TFLAG:苦痛刻印取得 == 5
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 믿을 수 없을 만큼 큰 고통으로 고통 충격에 빠진다.
		PRINTFORMW %CALLNAME:TARGET% Pain Mark Lv5를 얻었다!
		IF TFLAG:刻印従順変化 == 1 && M:1 == 0
			PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 Lv8로 증가했다!
			M:1 = 1
		ENDIF
		IF TALENT:PLAYER:サド
			PRINTFORML 【당신은 새드다】
			PRINTL 이상경험+2
		ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 104
			PRINTFORML 【바늘질 스킬을 가졌다.】
			PRINTL 이상경험 +2
		ELSE
			PRINTL 이상경험 +1
		ENDIF
		CFLAG:TARGET:衰弱 = 60
		CALL CHARA_ACTION_FAINT(TARGET)
		CALL ENDUFUFU(TARGET)
		CALL ENDUFUFU(MASTER)
	ENDIF
ENDIF

@MARK_MESSAGE_T
;時姦刻印
IF TFLAG:時姦刻印取得 == 1
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸은 시간이 멈춘 동안 성적 쾌락을 배운다...
	PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 시간 정지 강간 마크 Lv1을 얻었다!
ELSEIF TFLAG:時姦刻印取得 == 2
	PRINTFORML 시간은 멈추고, 잊을 수 없는 쾌락이 %조사처리(CALLNAME:TARGET,"의")% 몸에 새겨진다...
	PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 시간 정지 강간 낙인 LV2를 얻었다!
ELSEIF TFLAG:時姦刻印取得 == 3
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸은 시간이 멈춘 동안 네가 가져다줄 수 있는 쾌락에 완전히 사로잡힌다.
	PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 시간 정지 강간 마크 LV3를 획득했다!
ELSEIF TFLAG:時姦刻印取得 == 4
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 정신과 코어는 시간이 멈춘 동안 거대한 쾌락에 압도당한다...
	PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 시간 정지 강간 마크 LV4를 얻었다!
ELSEIF TFLAG:時姦刻印取得 == 5
	PRINTFORML %CALLNAME:TARGET%몸은 시간이 멈춘 동안 쾌락 외에는 아무것도 해석할 수 없다.
	PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 시간 정지 강간 각인 LV5를 획득했다!		
ENDIF

@MARK_MESSAGE_P
;快楽刻印
IF !FLAG:70
	IF CFLAG:MASTER:イタズラ == 2
		IF TFLAG:23 == 1
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 잠든 몸에 쾌락각인이 새겨져 있다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 쾌락각인 Lv1을 얻었다!
		ELSEIF TFLAG:23 == 2
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 잠든 몸이 음란하게 변하기 시작한다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 쾌락각인 레벨2를 얻었다!
		ELSEIF TFLAG:23 == 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 잠든 몸이 음란한 욕정에 완전히 굴복한다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 쾌락각인 레벨3을 얻었다!
		ELSEIF TFLAG:23 == 4
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 잠든 몸이 거대한 쾌락에 압도당한다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 쾌락각인 Lv4를 얻었다!
			GOTO FirstMensGet
		ELSEIF TFLAG:23 == 5
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 잠든 몸은 끊임없이 정신을 부수는 쾌락에 취한다.
			PRINTFORMW %CALLNAME:TARGET% Pleasure Mark Lv5를 획득했다!
			GOTO FirstMensGet
			;		ELSEIF TFLAG:23 == 4
			;			PRINTFORML 幼い身体が知るには早すぎた快楽が、%CALLNAME:TARGET%を「女」へと変えていく……
			;			PRINTFORMW %CALLNAME:TARGET%は初潮を迎えてしまった
		ENDIF
	ELSE
		IF TFLAG:23 == 1
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸은 방금 느낀 강렬한 쾌감으로 떨린다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 쾌락각인 Lv1을 얻었다!
		ELSEIF TFLAG:23 == 2
			IF TARGET == 57 && !TALENT:恋慕
				PRINTFORM 오키나 마스크가 느릿하게 떠다닌다 %CALLNAME:TARGET%
			ELSE
				PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 얼굴이 여운 속에 녹는다.
			ENDIF
			PRINTFORML ...
			PRINTFORMW %CALLNAME:TARGET%쾌락각인 레벨2를 얻었다!
		ELSEIF TFLAG:23 == 3
			PRINTFORML 엄청난 양의 쾌락이 %조사처리(CALLNAME:TARGET,"의")% 정신과 육체에 영구적으로 각인되었다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 쾌락각인 Lv3을 얻었다!
			IF TFLAG:刻印従順変化 == 1 && M:1 == 0
				PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 LV1로 증가했다!
				M:1 = 1
			ENDIF
		ELSEIF TFLAG:23 == 4
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 정신과 핵심이 거대한 쾌락에 압도당했다...
			PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 쾌락각인 레벨4를 얻었다!
			IF TFLAG:刻印従順変化 == 1 && M:1 == 0
				PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 레벨 5로 증가했다!
				M:1 = 1
			ENDIF
			$FirstMensGet
			IF (TALENT:TARGET:150 || TALENT:TARGET:151 || CharaAge:TARGET:0 < 13) && !TALENT:TARGET:初潮
				PRINTFORML 강렬하고 갑작스러운 쾌감에 %조사처리(CALLNAME:TARGET,"의")% 유치한 몸이 「여성」처럼 행동하기 시작한다...
				PRINTFORMW %조사처리(CALLNAME:TARGET,"에게")% 초경이 왔다!
				PRINTFORMW 이제 %조사처리(CALLNAME:TARGET,"는")% 임신할 수 있게 되었다.
				TALENT:TARGET:初潮 = 1
				CALL QoL_Info_Write(TARGET, Qol_Dates_FirstPeriod) ;qol custom code
			ENDIF
		ELSEIF TFLAG:23 == 5
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 믿을 수 없을 만큼 큰 쾌락에 기절한다.
			PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 쾌락 각인 Lv5를 얻었다!
			IF TFLAG:刻印従順変化 == 1 && M:1 == 0
				PRINTFORML 그리고 %HIS_HER(TARGET)% 순종이 Lv8로 증가했다!
				M:1 = 1
			ENDIF
			CFLAG:TARGET:衰弱 = 60
			CALL CHARA_ACTION_FAINT(TARGET)
			CALL ENDUFUFU(TARGET)
			CALL ENDUFUFU(MASTER)
			GOTO FirstMensGet
			;		ELSEIF TFLAG:23 == 4
			;			PRINTFORML 幼い身体が知るには早すぎた快楽が、%CALLNAME:TARGET%を「女」へと変えていく……
			;			PRINTFORMW %CALLNAME:TARGET%は初潮を迎えてしまった
		ENDIF
	ENDIF
ENDIF

@MARK_MESSAGE_S
;不埒刻印
;快楽による刻印
IF TFLAG:24 == 11
	LOCALS:0 = 
	IF TARGET == 57 && !TALENT:恋慕
		LOCALS:0 = , 원숭이 가면 하나가 떠다닌다 %HIM_HER(TARGET)%
