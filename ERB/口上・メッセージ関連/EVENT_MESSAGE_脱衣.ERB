; Modular ERB: EVENT_MESSAGE_脱衣.ERB

@MESSAGE_脱衣上着(ARG);だけ custom code ARG
;Custom code, replaced function
CALL MESSAGE_脱衣上着_TR(ARG)
RETURN
IF SHOW_TOP(TARGET) != ""
	IF TEQUIP:3 == 0; && EQUIP:TARGET:上半身下着１
		PRINTFORM %CALLNAME:TARGET%\@ FLAG:70 ? の # が \@
		IF EQUIP:TARGET:上半身上着１
			IF EQUIP:TARGET:ワンピース
				PRINTFORM %CLOTHNAME(17, EQUIP:TARGET:上半身上着１)%
				SIF EQUIP:TARGET:上半身上着２
					PRINTFORM 그리고 %CLOTHNAME(16, EQUIP:TARGET:上半身上着２)%
				SIF EQUIP:TARGET:着物
					PRINTFORM 와 %CLOTHNAME(14, EQUIP:TARGET:着物)%
				PRINTFORM 그리고 %CLOTHNAME(13, EQUIP:TARGET:ワンピース)%을 벗을 \@ FLAG:70 ? 가슴 # 가운 \@과,
			ELSE
				PRINTFORM %CLOTHNAME(17, EQUIP:TARGET:上半身上着１)%
				IF EQUIP:TARGET:上半身上着２
					PRINTFORM 그것들을 벗는다 \@ FLAG:70 ? 벗는다 # ぎ \@%CLOTHNAME(16, EQUIP:TARGET:上半身上着２)%
					SIF EQUIP:TARGET:着物
						PRINTFORM 과 %CLOTHNAME(14, EQUIP:TARGET:着物)%
					PRINTFORM 를 피부로 드러내게 할 \@ FLAG:70 ? 하는 # 것 \@과,
				ELSEIF EQUIP:TARGET:着物
					PRINTFORM 을 벗고 \@ FLAG:70 ? 입히다 # ぎ \@%CLOTHNAME(14, EQUIP:TARGET:着物)%を肌蹴\@ FLAG:70 ? 시키다 # る \@와,
				ELSE
					PRINTFORM 를 벗을 \@ FLAG:70 ? 가슴 # 옷 \@과,
				ENDIF
			ENDIF
		ELSEIF EQUIP:TARGET:上半身上着２
			PRINTFORM %CLOTHNAME(16, EQUIP:TARGET:上半身上着２)%
			IF EQUIP:TARGET:ワンピース
				SIF EQUIP:TARGET:着物
					PRINTFORM 과 %CLOTHNAME(14, EQUIP:TARGET:着物)%
				PRINTFORM 를 벗게 하고 %CLOTHNAME(13, EQUIP:TARGET:ワンピース)%을 벗\@ FLAG:70 ? 가 # [구] \@와,
			ELSE
				SIF EQUIP:TARGET:着物
					PRINTFORM 과 %CLOTHNAME(14, EQUIP:TARGET:着物)%
				PRINTFORM 를 살갗을 드러내게 할 것 \@ FLAG:70 ? 하는 # 것 \@과
			ENDIF
		ELSEIF EQUIP:TARGET:着物
			PRINTFORM %CLOTHNAME(14, EQUIP:TARGET:着物)%
			IF EQUIP:TARGET:ワンピース
				PRINTFORM 를 벗기고%CLOTHNAME(13, EQUIP:TARGET:ワンピース)%벗다\@ FLAG:70 ? 벗기다 # ぐ \@와,
			ELSE
				PRINTFORM 를 벗기\@ FLAG:70 ? 시키는 # 것 \@과,
			ENDIF
		ELSE
			PRINTFORM %CLOTHNAME(13, EQUIP:TARGET:ワンピース)%을 벗도록 \@ FLAG:70 ? 시키는 # 옷 \@과,
		ENDIF
		;		IF SHOW_TOP(TARGET,1) != ""
		;			PRINTFORM %CALLNAME:TARGET%\@ FLAG:70 ? の # が \@%SHOW_TOP(TARGET,1)%を肌蹴\@ FLAG:70 ? させる # る \@と、
		;		ELSE
		;			PRINTFORM %CALLNAME:TARGET%\@ FLAG:70 ? の # が \@%SHOW_TOP(TARGET,2)%を脱\@ FLAG:70 ? がせる # ぐ \@と、
		;		ENDIF
		IF SHOW_上半身下着(TARGET) != ""
			PRINTFORM %OPPAI_DESCRIPTION(TARGET)%
			IF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ || EQUIP:TARGET:ワンピース || EQUIP:TARGET:着物
				LOCALS:0 = 
				IF SHOW_BOTTOM(TARGET) == ""
					LOCALS:0 = 그리고 %SLIT(TARGET)%
				ELSEIF !EQUIP:TARGET:スカート
					LOCALS:0 = 그리고%SHOW_BOTTOM(TARGET, 14)%
				ENDIF
				PRINTFORMW 를 감싸고 있던 %SHOW_上半身下着(TARGET)% %LOCALS:0%가 드러났다.
			ELSEIF EQUIP:TARGET:上半身下着１
				PRINTFORMW 를 감싸던 %SHOW_上半身下着(TARGET)%이 드러났다
			ELSEIF EQUIP:TARGET:下半身下着２
				PRINTFORMW 벗겨진 %SHOW_TOP(TARGET,1)%에서 들여다보고 있다.
			ENDIF
		ELSE
			PRINTFORM %OPPAI_DESCRIPTION(TARGET, 1)%
			IF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ || EQUIP:TARGET:ワンピース || EQUIP:TARGET:着物
				IF SHOW_BOTTOM(TARGET) == ""
					PRINTFORM 그리고 %SLIT(TARGET)%
				ELSEIF !EQUIP:TARGET:スカート
					PRINTFORM 그리고 %SHOW_BOTTOM(TARGET, 14)%
				ENDIF
			ENDIF
			PRINTFORMW 가 드러났다
		ENDIF
	ENDIF
ELSE
	PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET, 1)%가 드러나 있다.
ENDIF
IF PALAM:TARGET:欲情 >= PALAMLV:3
	IF PALAM:TARGET:欲情 >= PALAMLV:6
		PRINTFORM 그 %NIPPLE_DESCRIPTION(TARGET)%은,
		IF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000 && ABL:Ｂ感覚 <= 5
			IF RAND:2 == 0
				PRINT 마치 모욕에 대한 기대에 떨고 있는 듯했다.
			ELSE
				PRINTFORM %조사처리(CALLNAME:PLAYER,"에게")% 가슴을 괴롭기를 청하는 듯이
			ENDIF
		ENDIF
		IF RAND:4 == 0
			PRINT 쾌감으로 역겹게 부풀어 올라
		ELSEIF RAND:3 == 0
			PRINT 빳빳하게 서서
		ELSEIF RAND:2 == 0
			PRINT 유륜에서 볼록하게 부풀어 올라
		ELSE
			PRINT 유두와 함께 볼록하게
		ENDIF
		PRINTFORMW \@ EQUIP:TARGET:上半身下着１ ? %SHOW_上半身下着(TARGET)%의 천을 밀어 올려 #  \@ 있다…
	ELSEIF PALAM:TARGET:欲情 >= PALAMLV:3
		LOCALS:1 = 
		IF RAND:3 == 0
			LOCALS:1 = 삐딱하게 고개를 들었다.
		ELSEIF RAND:2 == 0
			LOCALS:1 = 완전히 단단해졌다
		ELSE
			LOCALS:1 = 발기했다
		ENDIF
		PRINTFORMW 그 %NIPPLE_DESCRIPTION(TARGET)%는, %LOCALS:1% 하고 \@ EQUIP:TARGET:上半身下着１ ? , %SHOW_上半身下着(TARGET)%의 천을 밀어 올리고 #  \@ 있다...
	ENDIF
ENDIF
SIF !((EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ || EQUIP:TARGET:ワンピース || EQUIP:TARGET:着物) && !(EQUIP:TARGET:スカート || EQUIP:TARGET:ズボン))
	RETURN
IF (EQUIP:TARGET:下半身下着１ || EQUIP:TARGET:下半身下着２)
	IF PALAM:潤滑 >= PALAMLV:3
		PRINTFORMW %UNDER_SKIRT_DESCRIPTION(TARGET)%는 애액으로 얼룩이 생겨있다...
	ELSEIF PALAM:潤滑 >= PALAMLV:2
		PRINTFORMW %UNDER_SKIRT_DESCRIPTION(TARGET)%가 애액으로 축축해져 있다...
	ENDIF
ENDIF

@MESSAGE_脱衣下下着
;Custom code, override
CALL MESSAGE_脱衣下下着_TR
RETURN
IF EQUIP:TARGET:下半身下着２
	PRINTFORM %CALLNAME:TARGET%\@ !FLAG:70 ? が # 에서 \@%PANTSNAME(EQUIP:TARGET:下半身下着２, TARGET)%을
	IF PALAM:TARGET:潤滑 >= PALAMLV:4
		PRINTFORM \@ !FLAG:70 ? 벗다 # 벗기다 \@
		IF GET_INT(TARGET, "下半身下着_ずらし可能", EQUIP:TARGET:下半身下着２, "透ける(前)") && !RAND:2
			PRINTFORMW 그리고, %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%는 질퍽하게 젖어 있었고, %PANTSNAME(EQUIP:TARGET:下半身下着２, TARGET)%는 애액을 빨아들여 무겁게 되어 있었다...
		ELSE
			PRINTFORMW 그리고, %SLIT(TARGET)%에서 흘러나온 애액이 주르륵 허벅지를 타고 흐르고 있다...
		ENDIF
	ELSEIF PALAM:TARGET:潤滑 >= PALAMLV:3
		PRINTFORM \@ !FLAG:70 ? 벗다 # 벗기다 \@
		IF GET_INT(TARGET, "下半身下着_ずらし可能", EQUIP:TARGET:下半身下着２, "透ける(前)") && !RAND:2
			PRINTFORMW 그리고, %SLIT(TARGET)%와 %PANTSNAME(EQUIP:TARGET:下半身下着２, TARGET)% 사이에서 애액이 실을 이었다...
		ELSE
			PRINTFORMW 그리고, %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%는 분명하게 젖어있다…
		ENDIF
	ELSEIF PALAM:TARGET:潤滑 >= PALAMLV:2
		PRINTFORMW [\@ !FLAG:70 ? 벗다 # 벗기다 \@]와, %조사처리(CALLNAME:TARGET,"의")%%SLIT(TARGET)%는 촉촉하게 젖어 있었다...
	ELSE
		PRINTFORMW \@ !FLAG:70 ? 벗었다... # 벗겼다... \@
	ENDIF
ELSEIF EQUIP:TARGET:下半身下着１
	PRINTFORM %CALLNAME:TARGET% \@ !FLAG:70 ? 가 # 부터 \@%SHOW_下半身下着(TARGET, 3)%를
	IF PALAM:TARGET:潤滑 >= PALAMLV:4
		PRINTFORM \@ !FLAG:70 ? 벗다 # 벗기다 \@
		IF GET_INT(TARGET, "下半身下着_ずらし不可", EQUIP:TARGET:下半身下着１, "透ける(前)") && !RAND:2
			PRINTFORMW 그리고, %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%는 질퍽하게 젖어 있었고, %SHOW_下半身下着(TARGET, 3)%는 애액을 빨아들여 묵직해져 있다...	
		ELSE
			PRINTFORMW 그리고, %SLIT(TARGET)%에서 흘러넘친 애액이 축축하게 허벅지를 타고 흐르고 있다...
		ENDIF
	ELSEIF PALAM:TARGET:潤滑 >= PALAMLV:3
		PRINTFORM \@ !FLAG:70 ? 벗다 # 벗기다 \@
		IF GET_INT(TARGET, "下半身下着_ずらし不可", EQUIP:TARGET:下半身下着１, "透ける(前)") && !RAND:2
			PRINTFORMW 그리고, %SLIT(TARGET)%와 %SHOW_下半身下着(TARGET, 3)% 사이에서 애액이 실을 이었다...
		ELSE
			PRINTFORMW 그리고, %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%는 선명하게 젖어있다...
		ENDIF
	ELSEIF PALAM:TARGET:潤滑 >= PALAMLV:2
		PRINTFORMW \@ !FLAG:70 ? 벗는다 # 벗긴다 \@와, %조사처리(CALLNAME:TARGET,"의")%%SLIT(TARGET)%는 촉촉하게 젖어 있었다...
	ELSE
		PRINTFORMW \@ !FLAG:70 ? 벗었다... # 벗겼다... \@
	ENDIF
ELSE
	IF PALAM:TARGET:潤滑 >= PALAMLV:4
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳은 질척하게 축축해져 있었고, %SLIT(TARGET)%로부터 흘러넘친 애액이 주름을 따라 허벅지를 타고 흘러내리고 있었다...
	ELSEIF PALAM:TARGET:潤滑 >= PALAMLV:3
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%는 선명하게 젖어있다…
	ELSEIF PALAM:TARGET:潤滑 >= PALAMLV:2
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%는 촉촉하게 젖어 있다...
	ELSE
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% %SLIT(TARGET)%가 드러나 있다...
	ENDIF
ENDIF
SELECTCASE CFLAG:TARGET:妊娠経過日数
	CASE IS >= 60
		IF TALENT:TARGET:体型 == -2
			PRINTFORMW 임신한 배는 어린 몸과는 균형이 맞지 않을 정도로 불룩하다.
		ELSE
			PRINTFORMW 임산부의 배는 크게 부풀어 있다.
		ENDIF
	CASE IS >= 40
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 몸매는 이전보다 둥글어지고 배는 선명하게 부풀어 있다.
	CASE IS >= 30
		PRINTFORMW 부풀기 시작한 %조사처리(CALLNAME:TARGET,"의")% 배를 보니, 다시 %조사처리(CALLNAME:TARGET,"를")% 임신했다는 것을 실감한다.
	CASE IS >= 20
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 배는 아직 부풀지 않았지만, 그 태내에 자신의 아이를 품고 있다는 생각을 하니 감회가 새롭다.
ENDSELECT

@MESSAGE_脱衣上
;Custom code, override
CALL MESSAGE_脱衣上_TR
RETURN
IF SHOW_TOP(TARGET) != ""
	IF SHOW_TOP(TARGET, 1) != ""
		PRINTFORM \@ FLAG:70 ?  # %조사처리(CALLNAME:TARGET,"가")% \@%SHOW_TOP(TARGET,1)%を肌蹴\@ FLAG:70 ? 시키고, # 하면, \@
		IF (SHOW_上半身下着(TARGET) != SHOW_TOP(TARGET,1)) && (SHOW_上半身下着(TARGET) != "")
			SIF !EQUIP:TARGET:上半身下着１ || !EQUIP:TARGET:上半身下着２
				PRINTFORM %SHOW_上半身下着(TARGET)%을 벗 \@ FLAG:70 ? 가슴 # 속옷 \@,
			;		ELSE
			;			SIF !EQUIP:TARGET:上半身下着１ || !EQUIP:TARGET:上半身下着２
			;				PRINTFORM %SHOW_上半身下着(TARGET)%を脱\@ FLAG:70 ? がし # ぎ \@、
		ENDIF
		PRINTFORML %OPPAI_DESCRIPTION(TARGET, 1)%이 드러났다
	ELSE
		PRINTFORM \@ FLAG:70 ? %CALLNAME:TARGET%에서 # %조사처리(CALLNAME:TARGET,"가")% \@%SHOW_TOP(TARGET,2)%
		IF SHOW_上半身下着(TARGET) != SHOW_TOP(TARGET,1) && SHOW_上半身下着(TARGET) != SHOW_TOP(TARGET,2)
			SIF !EQUIP:TARGET:上半身下着１ || !EQUIP:TARGET:上半身下着２
				PRINTFORM 와 %SHOW_上半身下着(TARGET)%
		ENDIF
		PRINTFORML を脱\@ FLAG:70 ? がし # ぎ \@、%OPPAI_DESCRIPTION(TARGET, 1)%が露わになった
	ENDIF
ELSE
	PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION(TARGET, 1)%가 드러나 있다.
ENDIF
IF PALAM:TARGET:欲情 >= PALAMLV:3
	IF PALAM:TARGET:欲情 >= PALAMLV:6
		PRINTFORM 그 %NIPPLE_DESCRIPTION(TARGET)%은,
		IF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000 && ABL:Ｂ感覚 <= 5
			IF RAND:2 == 0
				PRINT 마치 모욕에 대한 기대에 떨고 있는 듯했다.
			ELSE
				PRINTFORM %조사처리(CALLNAME:PLAYER,"에게")% 가슴을 괴롭기를 청하는 듯이
			ENDIF
		ENDIF
		IF RAND:4 == 0
			PRINT 쾌감으로 역겹게 부풀어
		ELSEIF RAND:3 == 0
			PRINT 빳빳하게 서서
		ELSEIF RAND:2 == 0
			PRINT 유륜에서 볼록하게
		ELSE
			PRINT 유륜째 동글동글하게
		ENDIF
		PRINTFORMW 들뜨고 있다...
	ELSEIF PALAM:TARGET:欲情 >= PALAMLV:3
		LOCALS:0 = 
		IF RAND:3 == 0
			LOCALS:0 = 삐딱하게 고개를 들었다.
		ELSEIF RAND:2 == 0
			LOCALS:0 = 완전히 단단해졌다
		ELSE
			LOCALS:0 = 발기했다
		ENDIF
		PRINTFORMW 그 %NIPPLE_DESCRIPTION(TARGET)%은, %LOCALS:0% 해서, 자기주장하고 있다...
	ENDIF
ENDIF

@MESSAGE_脱衣下(ARG)
CALL MESSAGE_脱衣下_TR(ARG)
RETURN
SIF !(EQUIP:TARGET:スカート || EQUIP:TARGET:ズボン)
	RETURN
SIF (!ARG && EQUIP:TARGET:スカート) || EQUIP:TARGET:ズボン
	PRINTFORM \@ EQUIP:TARGET:ズボン ? %SHOW_BOTTOM(TARGET)% # %SHOW_BOTTOM(TARGET, 1)% \@を脱\@ FLAG:70 ? 가세 # 구 \@와,
PRINTFORM %UNDER_SKIRT_DESCRIPTION(TARGET)%
IF (EQUIP:TARGET:下半身下着１ || EQUIP:TARGET:下半身下着２)
	IF PALAM:潤滑 >= PALAMLV:3
		PRINTFORMW 는 애액으로 얼룩이 되어 있다...
	ELSEIF PALAM:潤滑 >= PALAMLV:2
		PRINTFORMW 가 애액으로 젖어 있다...
	ELSE
		PRINTFORMW 보였다...
	ENDIF
ELSE
	PRINTFORMW 봤다...
ENDIF
