;-------------------------------------------------

@MESSAGE_COM613
PRINTFORM %PARSE("You")%%COND_STR(@" and the others", TARGET)% %PARSE("spend",,TARGET)% 한 시간 
IF DATE_PARTTIME(CFLAG:MASTER:現在位置) == 2
	PRINTFORM %DATENAME_PLACE()%에서 어떤 일을 수행하며
ELSEIF DATE_PARTTIME(CFLAG:MASTER:現在位置) == 1
	PRINTFORM %DATENAME_PLACE()%에서 음식을 좀 모았다
ELSE
	SELECTCASE CFLAG:MASTER:現在位置
		;寺子屋
		CASE 240
			PRINTDATA
				DATAFORM 사원학교에서 임시 교사로 일했다.
				DATAFORM 키네의 조수로 일했다.
				DATAFORM 사원학교에서 문서를 정리했다.
			ENDDATA
			;永遠亭
		CASE 450
			PRINTDATA
				DATAFORM 에이테이에서 약 준비를 돕고 있다.
				DATAFORM 새로운 약의 시험 대상자로 일하고 있다.
				DATAFORM 몇몇 토끼들을 돌보고 있다.
			ENDDATA
			;香霖堂
		CASE 520
			PRINTDATA
				DATAFORM 쿠린도에서 파트타임으로 일하고 있다.
				DATAFORM 쓰레기를 좀 줍고 있다.
				DATAFORM 쿠린도에서 재고 정리를 돕고 있다.
			ENDDATA
			;霧雨魔法店
		CASE 540
			PRINTDATA
				DATAFORM 마법 상점에서 파트타임으로 일하고 있다.
				DATAFORM 마법 도구들을 정리하는 것을 돕고 있다.
				DATAFORM 마리사와 함께 실험을 돕고 있다.
			ENDDATA
			;紅魔館
		CASE 650
			PRINTDATA
				DATAFORM 스칼렛 데빌 맨션에서 아르바이트를 하고 있다.
				DATAFORM 사쿠야의 일을 좀 돕고 있다.
				DATAFORM 도서관 정리를 돕고 있다.
			ENDDATA
			;守矢神社
		CASE 830
			PRINTFORM 모리야 신사에서 아르바이트를 하고 있다.
	ENDSELECT
ENDIF
PRINTFORML , 당신에게 %金額表示(TFLAG:200)%을 얻게 한다.
SELECTCASE TFLAG:193
	CASE 1
		PRINTFORML %PARSE("You feel")% ~처럼 %PARSE("you",1)% 방금 완벽하게 해냈어!
	CASE -1
		PRINTFORML %PARSE("You")%많은 실수를 했다...
ENDSELECT
SIF TARGET
	PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 이 시간 내내 %PARSE("you",5)%를 지켜보고 있었다.
PRINTFORMW
TFLAG:200 = 0
