@MESSAGE_COM620
;-------------------------------------------------
;621,釣りをする
;-------------------------------------------------

@MESSAGE_COM621
#DIM CHARA
CHARA = TFLAG:194 % 1000
SELECTCASE TFLAG:193
	CASE 0
		PRINTFORML 아무것도 잡지 못했다...
		RETURN
	CASE 610
		IF TFLAG:194 > 1000
			PRINTFORML %CALLNAME:CHARA%은 나무 조각을 잡는다.
		ELSE
			PRINTFORML 나무를 좀 잡았네...
		ENDIF
		RETURN
	CASE 131
		IF TFLAG:194 > 1000
			PRINTFORMW %CALLNAME:CHARA%은 종이 조각을 집었다.
		ELSE
			PRINTFORMW 너 종이 몇 장 잡았네...
		ENDIF
		PRINTL 
		PRINTL ┌─────────────┐
		PRINTL ｜　　　　　　　　　　　　　｜
		PRINTL 모리야 부적
		PRINTL 복권
		PRINTL ｜　　　　　　　　　　　　　｜
		PRINTL 부적 5개를 모아라
		PRINTL 복권 한 개를 얻어라
		PRINTL ｜　　　　　　　　　　　　　｜
		PRINTL 기적은 보장되지 않는다.
		PRINTL ｜　　　　　　　　　　　　　｜
		PRINTL 모리야 신사
		PRINTL └─────────────┘
		RETURN
	CASE 1 TO 20, 22 TO 60
		LOCALS = %FISH_NAME_TR(TFLAG:193)%
	CASE 21
		LOCALS = rotor
	CASEELSE
		LOCALS = %ITEMNAME_TR(TFLAG:193)%
ENDSELECT
IF TFLAG:194 > 1000
	PRINTFORML %CALLNAME:CHARA%이(가) %ARTICLE(LOCALS)%를 잡았다!
ELSE
	PRINTFORML 당신은 %ARTICLE(LOCALS)%을 잡았다!
	;ローター以降を弾いてサイズと漁獲数の処理
	IF INRANGE(TFLAG:193, 1, 60) && TFLAG:193 != 21
		;サイズの出力
		LOCAL:1 = FISHING_SIZE(TFLAG:193)
		PRINTFORML 　크기: {LOCAL:1}cm
		;ここまでの最高サイズと比較して大きければ記録
		IF LOCAL:1 > FISHSIZE_RECORD:(TFLAG:193)
			SETCOLOR C_YELLOW
			SIF FISH_EXP:(TFLAG:193)
				PRINTFORML 　지금까지 잡은 가장 큰 %LOCALS%이다!
			RESETCOLOR
			FISHSIZE_RECORD:(TFLAG:193) = LOCAL:1
		ENDIF
		;漁獲数の加算
		FISH_EXP:(TFLAG:193) ++
	ENDIF
ENDIF
;説明を流す
SELECTCASE TFLAG:193
	CASE 1 TO 20, 22 TO 60
		DRAWLINE
		PRINTFORML %CAPITALIZE(LOCALS)%
		CALL FISHING_EXPLANATION(TFLAG:193)
	CASE IS > 61 ;bugfix custom code, handle rotor separately, since its internal id is 0, but fishing makes it 21 because it uses 0 for "no catch"
		DRAWLINE
		PRINTFORML %CAPITALIZE(LOCALS)%
		PRINTFORML 　　%ITEM_EXPLANATION(TFLAG:193)%
	CASE 21 ;bugfix custom code, rotor
		DRAWLINE
		PRINTFORML %CAPITALIZE(LOCALS)%
		PRINTFORML 　　%ITEM_EXPLANATION(0)%
ENDSELECT
