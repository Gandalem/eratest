;410,掃除
;-------------------------------------------------

@MESSAGE_COM410
IF FLAG:562 == 1
	PRINTFORML 청소가 드디어 끝나면 주민들을 거실로 불러 설교를 한다.
	PRINTFORML 이렇게 하면 그들은 잠시 동안 스스로 청소할 것이라 희망한다...
	FLAG:562 = 0
ELSE
	IF FLAG:70
		LOCAL:3 = 0
		FOR LOCAL,0,CHARANUM
		SIF LOCAL == MASTER
			CONTINUE
		SIF CFLAG:LOCAL:同室
			LOCAL:3 ++
		NEXT
		IF LOCAL:3 ;bugfix
			LOCALS = %조사처리(CALLNAME:TARGET,"를")% 무시하려고 시도하는 동안 \@ LOCAL:3 > 1 ? 다른 이들과 함께 있는 자가 # 시간이 정지된 채로 남아있는 자는 \@ 당신은
		ELSE
			LOCALS '= @"당신"
		ENDIF
	ELSEIF TFLAG:193 && !CFLAG:睡眠 && !CFLAG:うふふ
		LOCALS '= @"너와 %CALLNAME:TARGET%"
	ELSEIF CFLAG:うふふ
		LOCALS = %조사처리(CALLNAME:TARGET,"를")% 무시한 채, 당신은
	ELSE
		LOCALS '= @"당신"
	ENDIF
	IF OUTROOF(CFLAG:MASTER:現在位置) && DAY:2 == 4
		SELECTCASE TFLAG:194
			CASE 0
				PRINTFORML %LOCALS%도로의 눈을 완전히 치워서 아무도 실수로 미끄러지지 않게 한다.
			CASE 1
				PRINTFORML %LOCALS%눈을 치워라.
			CASE 2
				PRINTFORML %LOCALS%어디든 가기 위해 눈을 헤치고 깨끗한 길을 만들었다.
				PRINTFORML 그곳은 여전히 눈으로 가득 차 있었다.
			CASE 3
				IF TALENT:MASTER:清掃中毒
					PRINTFORML 당신은 눈앞에 쌓인 엄청난 양의 눈을 치우면서 눈빛이 반짝이며 계속 일한다.
					PRINTFORML 그 장소는 여전히 눈으로 가득 차 있다.
				ELSE
					PRINTFORML %LOCALS%엄청난 양의 눈을 치우느라 지쳤지만, 계속 일한다.
					PRINTFORML 그곳은 여전히 눈으로 가득 차 있다.
				ENDIF
		ENDSELECT
	ELSEIF OUTROOF(CFLAG:MASTER:現在位置)
		SELECTCASE TFLAG:194
			CASE 0
				PRINTFORML %LOCALS%쓰레기를 좀 치우고 장소를 더 깨끗하게 만들어라.
			CASE 1
				PRINTFORML %LOCALS%빗자루로 쓰레기 몇 개를 쓸어 없앤다.
			CASE 2
				PRINTFORML %LOCALS%모든 쓰레기를 하나씩 모아서 쓰레기봉투에 버려라.
				PRINTFORML 아직 장소가 좀 지저분하다.
			CASE 3
				IF TALENT:MASTER:清掃中毒
					PRINTFORML 당신은 넘쳐나는 쓰레기를 치우면서 눈에 광채를 띠며 계속 일한다.
					PRINTFORML 장소는 아직 조금 어수선하다.
				ELSE
					PRINTFORML %LOCALS%엄청난 양의 쓰레기를 치느라 지쳤지만 계속 일한다.
					PRINTFORML 장소는 여전히 좀 어지럽다.
				ENDIF
		ENDSELECT
	ELSEIF (WetBed || MessyBed) && CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置
		IF ITEM:NewMattress
			PRINTFORML 얼룩진 침대를 새 매트리스로 교체하거나, 청소를 시도할 수 있다.
			CALL ASK_YN("교체한다","청소")
			SELECTCASE RESULT
				CASE 0
					PRINTFORML 당신은 더러운 매트리스를 깨끗한 것으로 교체한다.
					WetBed = 0
					MessyBed = 0
					CALL LOST_ITEM("NewMattress",1,2)
				CASE 1
					$CleanBed
					PRINTFORML %LOCALS% 당신의 실금 자국 일부를 %PARSE("your")% 이불에서 문질러 지웠다.
					WetBed = MAX(WetBed-250 - (10*ABL:MASTER:40), 0)
					MessyBed = MAX(MessyBed-250 - (10*ABL:MASTER:40), 0)
					SIF WetBed || MessyBed
						PRINTFORML %PARSE("Your")%침대는 아직 좀 지저분하다.
			ENDSELECT
		ELSE
			GOTO CleanBed
		ENDIF
	ELSE
		SELECTCASE TFLAG:194
			CASE 0
				IF TALENT:MASTER:汚臭耐性 < 0
					PRINTFORML %LOCALS%모든 구석을 조심스럽고 철저하게 정리한다.
				ELSE
					PRINTFORML %LOCALS%먼지 걸레로 더러운 곳을 닦아낸다.
				ENDIF
			CASE 1
				PRINTFORML %LOCALS%주변을 빗자루와 쓰레받기로 청소한다.
			CASE 2
				IF TALENT:MASTER:汚臭耐性 > 0 && CFLAG:MASTER:現在位置 == 15
					PRINTFORML %LOCALS%모든 쓰레기를 모아서 옷장 안에 밀어 넣으세요.
					PRINTFORML 장소가 아직 좀 어수선하네요.
				ELSE
					PRINTFORML %LOCALS%모든 쓰레기를 모아서 쓰레기통에 버려라.
					PRINTFORML 장소가 아직 좀 지저분하다.
				ENDIF
			CASE 3
				IF TALENT:MASTER:清掃中毒
					PRINTFORML 압도적인 양의 쓰레기를 치우면서 눈에 빛을 띠며 계속 일하고 있다.
					PRINTFORML 장소는 아직 좀 지저분하다.
				ELSE
					PRINTFORML %LOCALS%엄청난 양의 쓰레기를 치느라 지쳤지만 계속 일한다.
					PRINTFORML 장소는 여전히 조금 어지럽다.
				ENDIF
		ENDSELECT
	ENDIF
	IF TALENT:MASTER:清掃中毒
		PRINTFORML 청소의 즐거움에 얼굴이 새빨개지고, 계속 청소하면서 기쁨의 눈물을 흘린다.
		PRINTFORM 완전히 몰입하여 자신이 무엇을 하고 있는지 신경 쓰지 않게 된다. 
		IF CFLAG:MASTER:現在位置 == 3
			PRINTFORMW 그리고 거의 기부함을 쓰레기통처럼 사용했다.
			PRINTFORML 아슬아웠다...
			;食卓分岐
		ELSEIF CFLAG:MASTER:現在位置 == 9 || CFLAG:MASTER:現在位置 == 27 || CFLAG:MASTER:現在位置 == 41
			PRINTFORML 그리고 그냥 행주로 계속 걸레질을 해라.
			PRINTFORML 혼자 두면 아마 영원히 이걸 계속할 것이다.
			;倉庫、押入れ分岐
		ELSEIF CFLAG:MASTER:現在位置 == 6 || CFLAG:MASTER:現在位置 == 18 || CFLAG:MASTER:現在位置 == 35 || CFLAG:MASTER:現在位置 == 51
			PRINTFORML 그리고 계속 소리 내서 물건들을 재배치한다.
			PRINTFORML 혼자 두면 영원히 이 행동을 반복할지도 모른다.
		ELSE
			PRINTFORML 그리고 계속 먼지 걸레를 소리 내며 앞뒤로 왔다 갔다 한다.
			PRINTFORML 혼자 두면 아마 영원히 이 행동을 반복할 것이다.
		ENDIF
	ELSEIF CFLAG:うふふ && SHIRAHU(TARGET)
		PRINTFORML 등 뒤로 차가운 시선이 느껴지지만, 무시하기로 한다.
	ENDIF
	IF STRLENS(TSTR:2)
		WAIT
		SIF CFLAG:FOUND_PANTS_OWNER:(FOUND_PANTS_TYPE + パンツ管理) == 0
			SETCOLOR C_PINK
		PRINTFORML 누군가의 %TSTR:2%을 발견했다.
		RESETCOLOR
		PRINT [0] - 그것들을 훔쳐라 [1] - 하지 마라
		INPUT
		IF !RESULT
			PRINTFORML 당신은 %CAPITALIZE(TSTR:2)%을 훔친다.
			CALL PANTS_GETTING(FOUND_PANTS_OWNER, FOUND_PANTS_TYPE)
		ELSE
			TSTR:3 =
			PRINTFORML 당신은 빨래에 %CAPITALIZE(TSTR:2)%을 던진다.
		ENDIF
	ENDIF
	SIF !TFLAG:193 && TARGET != MASTER && !CFLAG:睡眠 && !FLAG:70
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 당신이 일하는 것을 감탄하며 지켜본다.
ENDIF
CALL QUEST_EVENT("Cleaning End") ;Custom code, quest system.
