;403休憩
;-------------------------------------------------

@MESSAGE_COM403
IF TARGET != MASTER
	IF IsDead:TARGET:0
		PRINTDATAL
			DATAFORM %PARSE("You take")%는 %조사처리(CALLNAME:TARGET,"의")% 생기 없는 얼굴을 보며 휴식을 취한다.
			DATAFORM %PARSE("You decide")%는 죽은 %CALLNAME:TARGET%옆에서 잠시 쉬도록 한다.
		ENDDATA
	ELSEIF CFLAG:TARGET:睡眠
		PRINTDATAL
			DATAFORM %PARSE("You take")% 보면서 잠시 쉬다 %조사처리(CALLNAME:TARGET,"의")% 잠든 얼굴
			DATAFORM %PARSE("You decide")% 잠든 옆에서 쉬기 위해 %CALLNAME:TARGET%.
		ENDDATA
	ELSE
		PRINTDATAL
			DATAFORM %PARSE("You")%그리고 %조사처리(CALLNAME:TARGET,"는")% 잠시 숨을 고른다.
			DATAFORM %PARSE("You")%그리고 %조사처리(CALLNAME:TARGET,"는")% 휴식을 취하기로 결정한다.
		ENDDATA
	ENDIF
ELSE
	PRINTDATAL
		DATAFORM 당신은 숨을 고른다.
		DATAFORM 당신은 휴식을 취하기로 결정한다.
		DATAFORM 당신은 다음에 무엇을 할지 생각한다.
		DATAFORM 당신은 잠시 눈을 감고 시간이 조금 흘렀음을 알아차린다.
	ENDDATA
ENDIF
