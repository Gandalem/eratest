@MESSAGE_EAT_DISH(CHARA, EAT_ALONE)
#DIM CHARA    ;主体となるキャラ
#DIM EAT_ALONE;食べるのが一人なら1
;Custom code
#DIM DYNAMIC TENSE
SIF CHARA!=MASTER&&EAT_ALONE==1
	TENSE = 1
IF TFLAG:194 == 1
	PRINTL 이것은... 노판 샤브샤브다!
	;ELSEIF STRCOUNT(DISH_TASTE, "ローター/")
	;	PRINTL
ELSEIF STRCOUNT(DISH_TASTE, "精力/")
	PRINTL 이것은 활력으로 가득 차 있다!
ENDIF
SELECTCASE DISH_NAME
	CASE "ギンギー料理"
		PRINTW 「저게 뭐야?」
		PRINTW 「긴기 요리야.」
		PRINTW 「뭐로 만든 거야?」
		PRINTW 「긴기지.」
	CASE "モッツァレラチーズとトマトのサラダ"
		IF STRCOUNT(DISH_TASTE, "野菜抜き/")
			IF CHARA == [[ナズーリン]] || (CHARA == MASTER && FLAG:なりきり == [[ナズーリン]])
				;なんて雑な専用分岐！ハーモニーってなんだよ
				PRINTL 너무 맛있다～! ... 이, 이건...! 이 맛이야~!! 치즈와 치즈가 완벽하게 어울려! 
				PRINTL 치즈와 치즈! 치즈는 치즈를 보완해줘! 이게 '조화'라고 불리는 것일까~? 아니면 '맛의 조화'라고 부르는 걸까~?!
				PRINTL 사이먼 앤 가펑클의 듀엣 같아! 혹은 우짱과 난찬 같달까! 혹은 「내일날 조」에서 아사오 다카모리의 오리지널 작품과 치바 테츠야의 아트가 어우러진 것처럼 말이야!
			ELSE
				PRINTL 너무 맛있어~~! ...이건...!
				PRINTL ...그게 다야? 좀 평범하네. 뭔가 빠졌어... 이 치즈가~
			ENDIF
		ELSE
			PRINTL 정말 맛있다～! 이...이것은～! 이 풍미는～! 토마토의 육즙 가득한 부분이 모차렐라 치즈에 완벽하게 달라붙는다!
			PRINTL 치즈와 토마토! 토마토가 치즈를 보완한다! 이것이 당신이 말하는 “조화”인가～? 아니면 “맛의 조화”인가～?!
			PRINTL 마치 사이먼 앤 가펑클의 듀엣 같다! 혹은 우짱과 난짱처럼! 혹은 “아시타노 조”에 나오는 다카모리 아사오의 원작과 치바 테츠야의 예술처럼!
		ENDIF
	CASE "ドーピングコンソメスープ"
		PRINTL 수많은 약 성분들이 정밀하게 균형을 이루어 섞여 있다. 독특한 양념은 일곱 날 밤낮으로 조리되었다!!
		PRINTL 혈액이나 소변으로는 감지할 수 없다. 약물의 효과가 몇 배나 더 큰 것은 물론...
		PRINTL 일단 혈관에 주입(섭취)되면 더욱 강력해진다!!
	CASE "団子"
		IF NAME_MOON(DAY:3) == "十五夜 -中秋の名月- "
			IF TENSE
				PRINTFORML %CALLNAME:CHARA% 
				IF MOON_WATCH(DAY:3) < 1
					PRINTFORML 달이 보이지 않는 것을 후회한다.
				ELSE
					PRINTFORML 눈부신 보름달을 바라본다.
				ENDIF
				PRINTFORML %HE_SHE(CHARA,1)%달맞이 단고를 먹는다.
			ELSE
				PRINTFORML \@ CHARA==MASTER ? 당신 # %CALLNAME:CHARA% \@ %COND_STR(@" and the others", EAT_ALONE)% 
				IF MOON_WATCH(DAY:3) < 1
					PRINTFORML 달을 볼 수 없다는 것을 후회했다.
				ELSE
					PRINTFORML 눈부신 보름달을 응시한다.
				ENDIF
				IF CHARA == MASTER
					PRINTFORML 당신은 달맞이 단고를 먹었다.
				ELSE
					PRINTFORML 그들은 달맞이 단고를 먹는다.
				ENDIF
			ENDIF
		ENDIF
	CASE "寿司", "刺身", "活け造り"
		IF TENSE
			PRINTFORML %CALLNAME:CHARA%은(는) 생선 맛의 단순하지만 깊은 풍미를 즐긴다.
		ELSE
			PRINTFORML \@ CHARA==MASTER ? 당신은 # %CALLNAME:CHARA% \@%COND_STR(@" and the others", EAT_ALONE)% 그 단순하지만 깊은 생선 맛을 즐긴다.
		ENDIF
	CASE "スターゲイジーパイ"
		IF TENSE
			PRINTFORML %CALLNAME:CHARA%은(는) 하늘을 올려다보는 물고기를 응시하는 동안 %HE_SHE(CHARA)%이 %HIM_HER(CHARA)%에게 가해지는 무게를 느꼈지만, 스스로 결심했다.
		ELSEIF CHARA == MASTER
			PRINTFORML 당신은%COND_STR(@" and the others", EAT_ALONE)% 너에게 무거운 것이 짓누르는 것을 느끼며 하늘을 올려다보는 물고기를 응시하지만 결심하다 \@ EAT_ALONE ? 너 자신에게 # 당신들 자신에게 \@...
		ELSE
			PRINTFORML %CALLNAME:CHARA%%COND_STR(@" and the others", EAT_ALONE)% 그들은 하늘을 올려다보는 물고기를 응시하며 자신들을 짓누르는 무게를 느끼지만 결심했다.
		ENDIF
	CASE "肉まん"
		IF STRCOUNT(DISH_TASTE, "温かい/") && STRCOUNT(DISH_TASTE, "旬/")
			IF TENSE
				PRINTFORML %CALLNAME:CHARA%은 김이 모락모락 나는 %DISHNAME_TR(DISH_NAME)%를 한 입 베어 문다!
			ELSE
				PRINTFORML \@ CHARA==MASTER ? 너는 # %CALLNAME:CHARA% \@와 %COND_STR(@" and the others", EAT_ALONE)%가 김이 모락모락 나는 %DISHNAME_TR(DISH_NAME)%를 한입 베어 문다!
			ENDIF
		ENDIF
	CASE "サンドイッチ", "おにぎり", "スコーン"
		IF TENSE
			PRINTFORML %CALLNAME:CHARA%이/가 %DISHNAME_TR(DISH_NAME)%를(을) 문다.
		ELSE
			PRINTFORML \@ CHARA==MASTER ? 너는 # %CALLNAME:CHARA% \@과 %COND_STR(@" and the others", EAT_ALONE)%가 %DISHNAME_TR(DISH_NAME)%를 한입 베어 문다.
		ENDIF
	CASE "おせち料理"
		IF STRCOUNT(DISH_TASTE, "縁起物/")
			IF TENSE
				PRINTFORML %CALLNAME:CHARA%은 화려한 주바코 요리들로 새해의 도래를 축하한다.
			ELSE
				PRINTFORML \@ CHARA==MASTER ? You # %CALLNAME:CHARA% \@%COND_STR(@" and the others", EAT_ALONE)% 화려한 주박오(祝箱) 요리로 새해의 도래를 축하했다.
			ENDIF
		ENDIF
	CASE "年越し蕎麦"
		IF STRCOUNT(DISH_TASTE, "縁起物/")
			IF TENSE
				PRINTFORM %CALLNAME:CHARA%은 소바를 후루룩 마신다. 
			ELSE
				PRINTFORM \@ CHARA==MASTER ? 너는 # %CALLNAME:CHARA% \@와 %COND_STR(@" and the others", EAT_ALONE)%는 소바를 후루룩 마신다. 
			ENDIF
			IF RAND:10 < 5
				PRINTFORML 다가오는 한 해를 생각하며.
			ELSE
				PRINTFORML 지나간 한 해를 되돌아보며.
			ENDIF
		ENDIF
	CASE "恵方巻"
		SIF STRCOUNT(DISH_TASTE, "縁起物/")
			PRINTFORML 두툼한 말의 엄청난 한 입을 베어 무는 소리가 ~ 전체에 들렸다.
		;野菜抜き
	CASE "野菜炒め"
		SIF STRCOUNT(DISH_TASTE, "野菜抜き/")
			PRINTFORML 볶음 야채라고 했는데, 숙주만 있네...
	CASE "おひたし"
		SIF STRCOUNT(DISH_TASTE, "野菜抜き/")
			PRINTFORML 그냥 식초랑 말린 가쓰오부시뿐이야, 다른 건 없어...
	CASE "漬物に大盛り飯"
		SIF STRCOUNT(DISH_TASTE, "野菜抜き/")
			PRINTL 절임류가 없어! 이거 먹을 수 없어!
	CASEELSE
		SIF STRCOUNT(DISH_TASTE, "野菜抜き/")
			PRINTL 그것에는 채소가 없다...
ENDSELECT
;custom code, don't show if eating alone
SIF EAT_ALONE == 1
	RETURN 1
IF DISH_DRG
	CALL MESSAGE_EAT_DISH_DRG(TARGET, GET_TARGETNUM() > 1)
ELSEIF TFLAG:193 == 1
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 만족스럽게 %DISHNAME_TR(EX_DISH_NAME)%를 먹는다...
ELSEIF TFLAG:193 == -1
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 입맛에는 맞지 않는 것 같다.
ELSE
	IF CHARA == MASTER
		SIF TARGET != MASTER
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 당신과 함께 %DISHNAME_TR(EX_DISH_NAME)%를 먹으며 즐거운 시간을 보낸다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%/는 %DISHNAME_TR(EX_DISH_NAME)%를 먹으면서 즐거운 시간을 보낸다.
	ENDIF
ENDIF
;-------------------------------------------------
;仕込み料理を食べた時の反応,MASTERには使わない
;-------------------------------------------------

@MESSAGE_EAT_DISH_DRG(CHARA, 複数人)
#DIM CHARA
#DIM 複数人
SIF CHARA == MASTER
	RETURN
;bug fix target -> chara
SELECTCASE ITEMNAME:DISH_DRG
	CASE "媚薬"
		PRINTFORML %CALLNAME:CHARA%, \@ GET_TARGETNUM() > 1 ? 그리고 다른 이들이 먹는다 # 먹는다 \@ 그 %DISHNAME_TR(EX_DISH_NAME)% 미약으로 물든 것을.
		PRINTFORML \@ GET_TARGETNUM() > 1 ? 그들의 뺨이 발갛게 달아오르고 몇몇은 낮은 신음을 흘린다 # %HIS_HER(CHARA,1)% 뺨이 발갛게 달아오르고 %HE_SHE(CHARA)% 낮은 신음을 내뱉는다 \@...
	CASE "利尿剤"
		PRINTFORML %CALLNAME:CHARA% \@ GET_TARGETNUM() > 1 ? 그리고 다른 이들은 먹는다 # 먹는다 \@ the %DISHNAME_TR(EX_DISH_NAME)% 이뇨제가 첨가된
		PRINTFORML \@ GET_TARGETNUM() > 1 ? 그들은 허벅지를 꽉 조이고 어색하게 뒤뚱거리기 시작한다. # %HE_SHE(CHARA,1)%이 %HIS_HER(CHARA)%의 허벅지를 꽉 붙이고 어정쩡하게 걸음을 옮기기 시작한다. \@...
	CASE "惚れ薬"
		PRINTFORML %CALLNAME:CHARA%는 사랑의 물약을 탄 %DISHNAME_TR(EX_DISH_NAME)%를 먹고, \@ GET_TARGETNUM() > 1 ? 그리고 다른 이들은 먹는다 # 먹는다 \@도 함께 먹는다.
		PRINTFORML \@ GET_TARGETNUM() > 1 ? 그들은 황홀한 시선으로 너를 응시한다. # %HE_SHE(CHARA,1)% 황홀한 시선으로 당신을 응시한다 \@...
	CASE "睡眠薬"
		PRINTFORML %CALLNAME:CHARA% \@ GET_TARGETNUM() > 1 ? 그리고 다른 이들은 먹는다 # 먹는다 \@ 그 %DISHNAME_TR(EX_DISH_NAME)% 수면제로 뒤섞인
	CASE "排卵誘発剤" ;addition custom code
		PRINTFORML %CALLNAME:CHARA% \@ GET_TARGETNUM() > 1 ? 그리고 다른 이들은 먹는다 # 먹는다 \@ 그 %DISHNAME_TR(EX_DISH_NAME)% 배란 약으로 뒤섞인
ENDSELECT
;-------------------------------------------------
;416,演奏する
;-------------------------------------------------

@MESSAGE_COM416
#DIM DYNAMIC 楽器弾き
#DIM DYNAMIC 歌唄い
#DIMS DYNAMIC 楽器筆頭
#DIMS DYNAMIC 歌筆頭
VARSET LOCAL
;Custom code, replaced
CALL MESSAGE_COM416_TR
RETURN RESULT
LOCAL = -1
WHILE 1
;Bug-fix
SIF LOCAL >= (CHARANUM - 1)
	BREAK
LOCAL = FINDCHARA(TALENT:音楽知識, 1, LOCAL + 1)
SIF LOCAL < 0
	BREAK
SIF !LOCAL
	CONTINUE
IF CFLAG:MASTER:現在位置 == CFLAG:LOCAL:現在位置
	IF !ACCOMPANY_ABLE(LOCAL) || TARGET == LOCAL
		CONTINUE
	ELSE
		IF !楽器弾き
			楽器筆頭 = %CALLNAME:LOCAL%
		ELSEIF !RAND:楽器弾き
			楽器筆頭 = %CALLNAME:LOCAL%
		ENDIF
		楽器弾き ++
	ENDIF
ENDIF
WEND
LOCAL:1 = -1
WHILE 1
LOCAL:1 = FINDCHARA(TALENT:音楽知識, 2, LOCAL:1 + 1)
SIF LOCAL:1 <0
	BREAK
SIF !LOCAL:1
	CONTINUE
IF CFLAG:MASTER:現在位置 == CFLAG:(LOCAL:1):現在位置
	IF !ACCOMPANY_ABLE(LOCAL:1) || TARGET == LOCAL:1
		CONTINUE
	ELSE
		IF !歌唄い
			歌筆頭 = %CALLNAME:(LOCAL:1)%
		ELSEIF !RAND:歌唄い
			歌筆頭 = %CALLNAME:(LOCAL:1)%
		ENDIF
		歌唄い ++
	ENDIF
ENDIF
WEND
SIF 楽器弾き > 1
	楽器筆頭 += "達"
SIF 歌唄い > 1
	歌筆頭 += "達"
IF TFLAG:使用楽器 != 0
	PRINTFORM %조사처리(CALLNAME:MASTER,"는")%
	;楽器持ちキャラ、プリリバ三姉妹と九十九姉妹と雷鼓がTARGETで彼女らの音楽技能を上回っている
	IF TARGET != MASTER && (ABL:MASTER:音楽技能 >= ABL:TARGET:音楽技能) && TALENT:TARGET:音楽知識 == 1 && ACCOMPANY_ABLE(TARGET)
		PRINTFORM %조사처리(CALLNAME:TARGET,"와")% 나란히
		;歌唱キャラ、ミスティアと響子、エレンがTARGETで彼女らの音楽技能を上回っている
	ELSEIF TARGET != MASTER && (ABL:MASTER:音楽技能 >= ABL:TARGET:音楽技能) && TALENT:TARGET:音楽知識 == 2 && ACCOMPANY_ABLE(TARGET)
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 노래에 맞춰
		;あなたの音楽技能がTARGETより低いかTARGETが音楽知識を持っている
	ELSEIF TARGET != MASTER && (ABL:MASTER:音楽技能 <= ABL:TARGET:音楽技能 || TALENT:TARGET:音楽知識)
		PRINTFORM %조사처리(CALLNAME:TARGET,"에게")% 조언을 받으면서
	ELSEIF 楽器弾き && 歌唄い
		PRINTFORM %楽器筆頭%와 나란히, %歌筆頭%의 노래에 맞춰
		LOCAL:2 = 3
	ELSEIF 楽器弾き
		PRINTFORM %楽器筆頭%와 나란히,
		LOCAL:2 = 2
	ELSEIF 歌唄い
		PRINTFORM %歌筆頭%에 맞춰,
		LOCAL:2 = 1
	ENDIF
	SELECTCASE TFLAG:使用楽器
		CASE 1
			PRINTL 키보드를 쳐봤다.
		CASE 2
			PRINTL 피아노를 쳐보았다
		CASE 3
			PRINTL 기타를 연주해 보았다
		CASE 4
			PRINTL 트럼펫을 불어봤다
		CASE 5
			PRINTL 바이올린을 연주해 보았다
	ENDSELECT
	IF TFLAG:193 == 1
		IF LOCAL:2
			IF TARGET && !GROUPMATCH(TARGET,20,21,22,28,44,88,94,95,96)
				LOCALS:0 = 
				IF LOCAL:2 == 3
					LOCALS:0 = %楽器筆頭%와 %歌筆頭%의 즉흥 라이브
				ELSEIF LOCAL:2 == 2
					LOCALS:0 = %楽器筆頭%의 앙상블
				ELSEIF LOCAL:2 == 1
					LOCALS:0 = %歌筆頭%의 공동 출연
				ENDIF
				PRINTFORML %CALLNAME:TARGET%\@ IN_ROOM_NUMBER(CFLAG:MASTER:現在位置) > 2 ? 모두 #  \@는, %조사처리(CALLNAME:MASTER,"와")%%LOCALS:0%에게 황홀하게 귀 기울이고 있다
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:MASTER,"와")%의 세션에 신이 나 흥겹게 하고 있다.
			ENDIF
		ELSE
			IF TARGET
				IF !GROUPMATCH(TARGET,20,21,22,28,44,88,94,95,96)
					PRINTFORML %CALLNAME:TARGET%\@ IN_ROOM_NUMBER(CFLAG:MASTER:現在位置) > 2 ? 達 #  \@황홀한 표정으로 듣고 있다
				ELSE
					PRINTFORML %조사처리(CALLNAME:TARGET,"는")%, %조사처리(CALLNAME:MASTER,"와")%의 세션에 신나서 즐기고 있다
				ENDIF
			ELSEIF (WITH_MOB() || DATE_HITOGOMI()) && !GROUPMATCH(TIME:2,1,6,7)
				PRINTFORML \@ (MAIN_MAP !=9 && CFLAG:MASTER:現在位置 == 960) || (IN_HOME(CFLAG:MASTER:現在位置) && !CHK_FOCUS(927,CFLAG:MASTER:現在位置,948) && (ROOMDATA:(CFLAG:MASTER:現在位置 % 100) & 場所_モブ)) ? %ANIMALNAME()% # %DATE_HITOGOMI_SYUBETU()% \@は%조사처리(CALLNAME:MASTER,"의")% 곁에 와서 귀 기울이고 있다
			ELSE
				PRINTFORML 아무도 듣지 않는 완벽한 연주가 흘러내리고 있다.
			ENDIF
		ENDIF
	ELSEIF TFLAG:193 == -1
		IF LOCAL:2
			IF TARGET && !GROUPMATCH(TARGET,20,21,22,28,44,88,94,95,96)
				LOCALS:1 = 
				IF LOCAL:2 == 3
					LOCALS:1 = %楽器筆頭%와 %歌筆頭%의
				ELSEIF LOCAL:2 == 2
					LOCALS:1 = %楽器筆頭%의
				ELSEIF LOCAL:2 == 1
					LOCALS:1 = %歌筆頭%의
				ENDIF
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")%, %조사처리(CALLNAME:MASTER,"와")% %LOCALS:1%가 내는 불협화음에 얼굴을 찡그리고 있다.
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")%, %조사처리(CALLNAME:MASTER,"와")%의 세션을 끊고 서둘러 떠났다
			ENDIF
		ELSE
			IF TARGET
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 양손으로 귀를 막고 있다.
			ELSEIF WITH_MOB() || DATE_HITOGOMI()
				PRINTFORML \@ (MAIN_MAP !=9 && CFLAG:MASTER:現在位置 == 960) || (IN_HOME(CFLAG:MASTER:現在位置) && !CHK_FOCUS(927,CFLAG:MASTER:現在位置,948) && (ROOMDATA:(CFLAG:MASTER:現在位置 % 100) & 場所_モブ)) ? %ANIMALNAME()% # %DATE_HITOGOMI_SYUBETU()% \@は、慌てて%조사처리(CALLNAME:MASTER,"의")% 곁을 떠났다.
			ELSE
				PRINTFORML 지독한 연주가 주변의 조화를 흐트러뜨리고 있다.
			ENDIF
		ENDIF
	ELSE
		IF LOCAL:2
			IF TARGET && !GROUPMATCH(TARGET,20,21,22,28,44,88,94,95,96)
				LOCALS:2 = 
				IF LOCAL:2 == 3
					LOCALS:2 = %楽器筆頭%과 %歌筆頭%의 즉흥 세션
