; Modular ERB: COMMON_KOJO.ERB

@SAMEROOM(ARG,ARG:1)
#FUNCTION
SIF ARG < 0 || ARG >= CHARANUM
	RETURNF 0
SIF ARG:1 < 0 || ARG:1 >= CHARANUM
	RETURNF 0
ARG:1 = ARG:1 ? ARG:1 # TARGET
SIF CFLAG:ARG:現在位置 == CFLAG:(ARG:1):現在位置
	RETURNF 1
;calls the appropriate M_KOJO_K function for ARG

@KOJO_ACTIVE_INFO(ARG)
RESULT = 0
RESULTS =
RESULTS:1 =
RESULTS:2 =
IF CFLAG:ARG:口上セレクタ
	TRYCALLFORM M_KOJO_K{NO:ARG}_{CFLAG:ARG:口上セレクタ}
ELSE
	TRYCALLFORM M_KOJO_K{NO:ARG}
ENDIF
SIF RESULT && RESULTS:1 == ""
	RESULTS:1 = Default
RETURN RESULT
;searches for currently used dialogue and sets the character's color

@SET_KOJO_COLOR(ARG = -1)
RESETCOLOR
SIF !FLAG:口上色
	RETURN
SIF ARG == -1
	ARG = TARGET
;modded custom code below
SIF ARG >= CHARANUM
	RETURN
;keep duplicated character value
LOCAL = TFLAG:HandlingDuplicateCharacter
TFLAG:HandlingDuplicateCharacter = 0
SIF CFLAG:ARG:IS_DUPLICATE
	TFLAG:HandlingDuplicateCharacter = ARG
IF ARG == RANDOM_CHARANUM
	SETCOLOR CFLAG:ARG:1000
ELSE
	CALL KOJO_ACTIVE_INFO(ARG) ;custom code, fixed
	TRYCALLFORM M_KOJO%RESULTS%_COLOR_K{NO:ARG}
ENDIF
;NAS custom code
;fallback to personality colors
IF GETCOLOR() == GETCONFIG("TEXT COLOR")
	SELECTCASE ARG
		CASE 3
			SETCOLOR 0xeae5b0
		CASE 8
			SETCOLOR 0x7888ff
		CASE 20
			SETCOLOR 0xb51824
		CASE 21
			SETCOLOR 0xc2b9d3
		CASE 22
			SETCOLOR 0xac8378
		CASE 24
			SETCOLOR 0xfe5641
		CASE 32
			SETCOLOR 0x794cd4
		CASE 39
			SETCOLOR 0x9fa3a2
		CASE 43
			SETCOLOR 0xe44e5e
		CASE 44
			SETCOLOR 0xe9bd48
		CASE 45
			SETCOLOR 0x961b8b
		CASE 46
			SETCOLOR 0x5e36ca
		CASE 47
			;rika
			SETCOLOR 0xB33C00
		CASE 48
			SETCOLOR 0xfbf5ae
		CASE 73
			SETCOLOR 0xa40600
		CASE 92
			;futo
			SETCOLOR 0xA5A5A5
		CASE 120
