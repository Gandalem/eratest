;706,胸愛撫(慰)
;-------------------------------------------------

@MESSAGE_COM706
;時止め時
SIF FLAG:70 == 1
	PRINTFORM 시간이 멈춘 세계에서
IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
	IF FLAG:70 == 1
		PRINTFORM %조사처리(CALLNAME:PLAYER,"를")% 범한 채로
	ELSE
		PRINTFORM %조사처리(CALLNAME:PLAYER,"와")% 연결된 채로
	ENDIF
ELSE
	PRINTFORM %조사처리(CALLNAME:PLAYER,"의")%
ENDIF
IF TEQUIP:1 == 0
	PRINT 
ELSE
	FOR LOCAL,17,6,-1
	IF GROUPMATCH(LOCAL, 13, 12, 11)
		CONTINUE
	ENDIF
	IF EQUIP:PLAYER:LOCAL
		PRINTFORM %CLOTHNAME(LOCAL,EQUIP:PLAYER:LOCAL)%위로
		BREAK
	ENDIF
	NEXT
ENDIF
IF TALENT:バストサイズ <= -1
	CALL PrintMilkedNipple(TARGET, "")
	IF TEQUIP:乳首吸い
		IF RAND:3 == 0
			PRINTL 를 깨물었다…
		ELSEIF RAND:2 == 0
			PRINTL 게걸스럽게 달려들어 음흉한 소리를 내며 몰아붙였다...
		ELSE
			PRINTL 를 입에 머금은 채, 유륜 주위를 애타게 핥았다...
		ENDIF
	ELSE
		PRINTFORML %TEXTR("を摘まんでこね回した…/をぎゅうぅっと押しつぶし、スリスリと擦りあげた…/を捻りあげた…/を強弱つけながら刺激した…/を乳輪にそってくすぐった…/をつまみあげた…/を扱きあげた…")%
	ENDIF
ELSEIF TALENT:バストサイズ >= 1
	IF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000 && RAND:4 == 0
		PRINTFORML %OPPAI_DESCRIPTION(PLAYER,1)%을 아래에서 받아내며
		PRINT 손바닥으로 받치면서,
		IF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000 && ABL:Ｂ感覚 <= 5
			IF RAND:3 == 0
				PRINT 모욕에 대한 기대감에 몸을 떨었다
			ELSEIF RAND:2
				PRINT 가슴을 만져주길 언제나 기다리고 있었다
			ELSE
				PRINT 
			ENDIF
		ENDIF
		PRINTFORML %NIPPLE_DESCRIPTION(PLAYER,1)%를 해치웠다...
	ELSEIF RAND:3 == 0 && ABL:Ｂ感覚 >= 3
		IF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000 && ABL:Ｂ感覚 <= 5
			IF RAND:3 == 0
				PRINT 모욕에 대한 기대감에 몸을 떨었다.
			ELSEIF RAND:2
				PRINT 유방애를 지금인가 언제인가 기다리고 있다.
			ELSE
				PRINT 
			ENDIF
		ENDIF
		PRINTFORM %OPPAI_DESCRIPTION(PLAYER,1)%를,
		IF TALENT:PLAYER:サド
			IF RAND:2 == 0
				PRINT 부수려고만 하는 기세로
			ELSE
				PRINT 압살할 듯이
			ENDIF
		ENDIF
		IF RAND:3 == 0 && TALENT:PLAYER:サド
			PRINTL 전 체중을 실어, 힘으로, 움켜쥐듯이 주무르다...
			PRINTFORML 주물러진 %OPPAI_DESCRIPTION(PLAYER)%은 가죽 물주머니처럼 축 늘어졌다...
		ELSEIF RAND:2 == 0 && TALENT:PLAYER:サド
			PRINTL 강제로 잡아당겨, 세로형 양깔처럼 형태를 일그러뜨렸다...
		ELSE
			PRINTL 형태가 변할 정도로 주물렀다...
		ENDIF
		IF EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 10000 && ABL:Ｂ感覚 <= 5 && RAND:3 == 0
			IF RAND:3 == 0 && TALENT:淫乳 && TALENT:マゾ &&  EX:Ｂ絶頂 * 10000 + PALAM:快Ｂ + PALAM:欲情 >= 30000
				PRINTFORML 유방애인인 %조사처리(CALLNAME:PLAYER,"는")% %CALLNAME:PLAYER%으로부터 오는 유방 학대에서 오는
				PRINTL 쾌락에, 흐트러진 모습을 드러내며 기쁨의 소리를 내고 녹아내리고 있다...
			ELSEIF RAND:2 == 0 && ABL:マゾっ気 >= 5 || TALENT:マゾ
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %CALLNAME:PLAYER%로부터 오는 유방의 희열한 감각에
				PRINTL 흐트러진 표정을 드러내며 녹아내리고 있다...
			ELSEIF ABL:マゾっ気 >= 3
				PRINTFORML %CALLNAME:PLAYER%에게서 주어지는 달콤한 황홀경에 %조사처리(CALLNAME:PLAYER,"는")%
				PRINTL 역겹고 음란한 표정을 지으며, 축 늘어진 몸을 떨었다...
			ENDIF
		ENDIF
	ELSEIF RAND:2 == 0
		PRINTFORML %OPPAI_DESCRIPTION(PLAYER,1)%손가락을 집어넣고,
		PRINT 指をめり込ませ、
		IF TALENT:バストサイズ >= 1 && RAND:2
			PRINTL 세게 주물렀다...
		ELSE
			PRINTL 말랑한 감촉을 즐겼다...
		ENDIF
	ELSE
		PRINTFORML %OPPAI_DESCRIPTION(PLAYER)%에게
		PRINTL 손가락이 파고드는 감촉을 만끽했다...
	ENDIF
ELSE
	IF RAND:2
		IF RAND:4 == 0
			PRINTFORML %OPPAI_DESCRIPTION(PLAYER)%그것을 들어 쓰다듬었다.
		ELSEIF RAND:3 == 0
			PRINTFORML %OPPAI_DESCRIPTION(PLAYER)%을 움켜쥐고 비틀었다.
		ELSEIF RAND:2 == 0
			LOCALS:0 = 
			IF RAND:2 == 0
				LOCALS:0 '= @"의 탄력을 즐기면서"
			ELSE
				LOCALS:0 '= @"을"
			ENDIF
			PRINTFORML %OPPAI_DESCRIPTION(PLAYER)% %LOCALS:0% 충분히 뒤섞었다.
		ELSE
			PRINTFORML %OPPAI_DESCRIPTION(PLAYER)%의 부드러움을 즐겼다.
		ENDIF
	ELSE
		IF RAND:2
			PRINTFORML %OPPAI_DESCRIPTION(PLAYER)%전체를 감싸듯이 손바닥으로 쓰다듬었다.
		ELSE
			PRINTFORML %OPPAI_DESCRIPTION(PLAYER)%을 주먹으로 움켜쥐었다.
		ENDIF
	ENDIF
ENDIF
;母乳
IF TALENT:母乳体質 && RAND:2 == 0
	IF TALENT:バストサイズ <= -1 && RAND:2
		PRINTFORMW %조사처리(CALLNAME:PLAYER,"의")% 손이 유방에 파고들 때마다, %NIPPLE_DESCRIPTION(PLAYER)%에게서 모유가 흘러나왔다...
	ELSE
		PRINTFORMW %조사처리(CALLNAME:PLAYER,"의")% 손에 의해 가슴 모양이 바뀔 때마다, %NIPPLE_DESCRIPTION(PLAYER)%에게서 모유가 스며 나온다...
	ENDIF
ENDIF
