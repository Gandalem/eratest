; Modular ERB: EVENT_MESSAGE_COM700.ERB
;-------------------------------------------------
;700,愛撫(慰)
;-------------------------------------------------

@MESSAGE_COM700
IF FLAG:70 == 1
	PRINTFORM 시간이 멈춘 동안, 당신은 조심스럽게 %FSYN("rub")%한다 
	;小柄体型
	IF TALENT:PLAYER:体型 == -2
		PRINT 어린아이 같은
	ELSEIF TALENT:PLAYER:体型 == -1
		PRINT 작은
	ELSEIF TALENT:PLAYER:体型 == -5
		PRINT 인형 같은
	ENDIF
	PRINTL  본문...
	IF NOWEX:PLAYER:Ｃ絶頂 || NOWEX:PLAYER:Ｖ絶頂 || NOWEX:PLAYER:Ａ絶頂 || NOWEX:PLAYER:Ｂ絶頂
		IF TEQUIP:PLAYER:50 == TARGET || TEQUIP:PLAYER:51 == TARGET
			;PRINTFORML %TINKO(TARGET)%を挿入させている\@ TEQUIP:PLAYER:50 == PLAYER ? 膣 # アヌス \@は%CALLNAME:PLAYER%の意思とは無関係にびくびくと震えながら快楽を貪っている…
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%에 삽입된 동안, 당신의 정신은 욕망스럽게 쾌감으로 떨린다...
		ELSEIF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORM %TINKO(PLAYER)%를 삽입하고 있는 %조사처리(CALLNAME:TARGET,"의")% \@ TEQUIP:50 == TARGET ? 질 # 항문 \@을 사용해
			;オトコ
			IF !(TALENT:2 & 1)
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 절정의 감각에서 몸을 떨며, %TINKO(PLAYER)%로부터 정액을 흘리고 있다...
			ELSE
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 절정의 쾌감으로 몸을 떨며, 비소에서 애액을 흘리고 있다...
			ENDIF
			;オトコ
		ELSEIF !(TALENT:2 & 1)
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 절정의 감각에서 몸을 떨고, %TINKO(PLAYER)%로부터 정액을 흘리고 있다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 절정의 쾌감으로부터 몸을 떨게 하고, 은밀한 곳에서 애액을 흘리고 있다...
		ENDIF
	ELSE
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 몸을 전혀 움직이지 않는 %조사처리(CALLNAME:TARGET,"의")% \@ TEQUIP:50 == PLAYER ? 膣 # 항문 \@을 범하며 있다.
			PRINTFORML 마치 눈앞의 %조사처리(CALLNAME:TARGET,"는")% 오나홀에 불과하다는 듯, 자신의 몸을 만지며 위로하고 있다.
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈췄을 때의 표정 그대로인 %조사처리(CALLNAME:TARGET,"를")% 뒤로하고, 자신의 몸을 가지고 위로하고 있다...
		ENDIF
	ENDIF
ELSE
	;キスをする場合
	SIF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		PRINTFORM 여전히 %CALLNAME:TARGET%에 연결되어 있는 동안,
	PRINTFORM 당신은 조심스럽게 %FSYN("rub")%한다. 
	;小柄体型
	IF TALENT:PLAYER:体型 == -2
		PRINT 아이 같은
	ELSEIF TALENT:PLAYER:体型 == -1
		PRINT 작은
	ELSEIF TALENT:PLAYER:体型 == -5
		PRINT 인형 같은
	ENDIF
	PRINTL  본문...
	IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% \@ TEQUIP:50 == PLAYER ? 질 # 항문 \@은 %조사처리(CALLNAME:PLAYER,"가")% 박을 때마다 파르르 떨며 수축했다.
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:PLAYER,"가")% 몸에 닿을 때마다 파르르 떨었다.
		ENDIF
		IF EXP_UP(27,PLAYER)
			PRINTFORML 쾌락에 녹아내린 얼굴로 %조사처리(CALLNAME:PLAYER,"에게")% 혀를 내밀어 핥고 빨리고 있다...
		ELSEIF EXP_UP(27,TARGET)
			PRINTFORML 쾌락에 녹아버린 얼굴로 %조사처리(CALLNAME:PLAYER,"의")% 입술을 찾아왔다...
		ELSE
			PRINTFORML 주어지는 쾌락에 허덕이고 있다...
		ENDIF
	ELSE
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 물어 넣은 %TINKO(PLAYER)%를 조이며
		ELSE
			;PRINTFORM %CALLNAME:PLAYER%は%CALLNAME:PLAYER%にぴったりと寄り添いながら
			PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% 스스로의 손으로
		ENDIF
		IF EXP_UP(27,PLAYER)
			PRINTFORML %조사처리(CALLNAME:PLAYER,"의")% 입술을 원해왔다...
		ELSE
			PRINTFORML 주는 쾌락에 몸을 떨며 반응하고 있다...
		ENDIF
	ENDIF
ENDIF
