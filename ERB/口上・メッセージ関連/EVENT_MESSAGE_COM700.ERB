;-------------------------------------------------
;703,指挿れ(慰)
;-------------------------------------------------

@MESSAGE_COM703
IF FLAG:70 == 1
	PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:PLAYER,"의")%
	;下半身着衣
	SIF TEQUIP:0 & 2
		PRINTFORM %PeeProtectType(MASTER,2)%안에 손을 넣었다
	;処女
	IF TALENT:処女 == 1
		PRINT 남자를 알지 못했던
		;潤滑LV4以上
	ELSEIF PALAM:潤滑 >= PALAMLV:4
		PRINT 흠뻑 젖은
	ENDIF
	;小柄体型の有無で分岐
	IF TALENT:体型 == -2
		PRINT 어린 나약한 자
	ELSE
		PRINT 히레츠
	ENDIF
	;バイブの有無で分岐
	IF TEQUIP:バイブ
		PRINTFORML 안에 삽입된, 요사스럽게 꿈틀거리는 바이브를 앞뒤로 넣었다 빼기를 했다.
	ELSE
		PRINTFORML 손가락을 천천히 삽입했다...
		IF NOWEX:Ｖ絶頂
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 표정의 변화 없이 절정에 이르렀고, %조사처리(CALLNAME:PLAYER,"의")% 손가락을 애액으로 적시고 있다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 몸을 전혀 움직일 수 없는 채 질 안에서 희롱당하고 있다.
		ENDIF
	ENDIF
ELSE
	;下半身着衣
	IF TEQUIP:0 & 2
		PRINTFORM 당신의 손을 당신의 %PeeProtectType(PLAYER,2)% 안에 넣으면서, 
	ENDIF
	PRINTFORM \@ LINEISEMPTY() ? 당신은 # 당신이 \@ 천천히 손가락을 안으로 넣는다 
	;潤滑LV4以上
	IF PALAM:潤滑 >= PALAMLV:4
		PRINTFORM %FSYN("wet",,MASTER)%
	ENDIF
	;小柄体型の有無で分岐
	IF TALENT:体型 == -2
		PRINTFORM 미성숙한 %FSYN("vagina",,MASTER)%
	ELSE
		PRINTFORM %FSYN("vagina",,MASTER)%
	ENDIF
	;処女
	IF TALENT:処女 == 1
		PRINT  남자를 알지 못했던
	ENDIF
	;バイブの有無で分岐
	IF TEQUIP:バイブ
		PRINTFORML 바이브를 앞뒤로 밀어 넣으며.
	ELSE
		PRINTFORML ...
		IF NOWEX:Ｖ絶頂
			IF TALENT:処女 == 1
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 삽입한 손가락을 파르르 떨며 조이고 있다...
			ELSEIF TALENT:処女 == -1
				PRINTFORML 방금 순결을 잃었다는 것도 모른 채, %조사처리(CALLNAME:PLAYER,"는")% 자신의 육체의 반응에 당황하면서도 절정에 이르렀다...
			ELSE
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 침을 흘리며 스스로 허리를 흔들어 쾌락을 탐하고 있다.
			ENDIF
		ELSE
			IF TALENT:処女 == 1
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 서툰 감촉에 몸을 굳히고 있다...
			ELSE
				PRINTFORML 당신이 손가락을 %FSYN("vagina",,MASTER)% 주위로 비틀자, 즐거움의 신음소리를 내뱉는다.
			ENDIF
		ENDIF
	ENDIF
ENDIF
