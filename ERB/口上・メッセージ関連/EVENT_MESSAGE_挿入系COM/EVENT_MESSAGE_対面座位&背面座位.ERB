; Modular ERB: EVENT_MESSAGE_挿入系COM/EVENT_MESSAGE_対面座位&背面座位.ERB
;-------------------------------------------------
;67,対面座位
;-------------------------------------------------

@MESSAGE_COM67
CALL MESSAGE_COM67_TR
RETURN
IF FLAG:70 == 1
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"를")% 끌어안고,
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 체취에 싸여 밀려오는 충동에 몸을 맡기고 허리를 박아 올렸다...
		ELSEIF TEQUIP:体位２ == 4
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"에게")% 키스하고, 혀를 얽으면서 다시 허리를 흔들기 시작했다...
		ELSE
			PRINTFORML 질내에서 %TINKO(PLAYER)%을 빼내지 않고 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 몸을 끌어안고, 입안을 음미하며 다시 허리를 흔들기 시작했다...
		ENDIF
	ELSE
		PRINTFORM 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 몸을 안아 올리고,
		PRINTFORM %TINKO(PLAYER)% 눈을 내리깔았다.
		SIF TEQUIP:0 & 2
			PRINTFORM 비켜진 %SHOW_BOTTOM(TARGET,2)%의 빈틈에
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 흠뻑 젖은
		;小柄体型
		IF TALENT:体型 < 0
			PRINT 어린 꿀단지
		ELSE
			PRINT 질
		ENDIF
		PRINTFORM 에 삽입해、
		;ボールギャグの有無
		SIF TEQUIP:ボールギャグ == 0
			PRINT 키스하면서
		PRINTL 「%CALLNAME:TARGET%」라는 오나홀로 자위하기 위해 허리를 흔들었다...
	ENDIF
ELSE
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"를")% 끌어안은 채,
			PRINTFORML 밀려오는 충동에 몸을 맡기고 허리를 박아 올렸다...
		ELSEIF TEQUIP:体位２ == 4
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %조사처리(CALLNAME:PLAYER,"와")% 키스를 하고, 혀를 얽으면서 다시 허리를 흔들기 시작했다...
		ELSE
			PRINTFORML 질 속에서 %TINKO(PLAYER)%을 빼내지 않으면서 %조사처리(CALLNAME:TARGET,"의")% 몸을 꽉 끌어안고, 혀를 섞으며 다시 허리를 흔들기 시작했다...
		ENDIF
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 몸을 안아 올리며,
		PRINTFORM 천천히 내려놓으면서
		SIF TEQUIP:0 & 2
			PRINTFORM 비켜진 %SHOW_BOTTOM(TARGET,2)%의 틈 사이로
		PRINTFORM %SLIT(, 1)%에 삽입하고,
		;ボールギャグの有無
		SIF TEQUIP:ボールギャグ == 0
			PRINT 입맞춤을 하면서
		PRINTL 허리를 흔들었다...
	ENDIF
	;SIF TALENT:恋慕
	;	PRINTFORML %CALLNAME:TARGET%は%CALLNAME:PLAYER%の首に手を回して抱きついてきた…
ENDIF
;-------------------------------------------------
;68,背面座位
;-------------------------------------------------

@MESSAGE_COM68
CALL MESSAGE_COM68_TR
RETURN
IF FLAG:70 == 1
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"를")% 안으며,
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 체취에 감싸이면서, 솟구쳐 오르는 충동에 몸을 맡기고 허리를 밀어 올렸다…
		ELSEIF TEQUIP:体位２ == 5
			PRINTFORML 시간이 멈춘 %조사처리(CALLNAME:TARGET,"를")% 뒤에서 껴안고, 다시 %조사처리(CALLNAME:TARGET,"의")% 몸을 흔들기 시작했다...
		ELSE
			PRINTFORML 질 안에서 %TINKO(PLAYER)%을 빼내지 않고, 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 몸을 등 뒤에서 끌어안으며,
			PRINTFORML 몸을 흔들며 %조사처리(CALLNAME:TARGET,"를")% 이용한 자위를 재개했다...
		ENDIF
	ELSE
		PRINTFORM 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 몸을 안아 올리고, %SLIT(, 1)%
		IF TEQUIP:0 & 2
			PRINTFORML 에 %SHOW_BOTTOM(TARGET,2)%의 틈에서 삽입했다...
		ELSE
			PRINTFORML 을 기다리고 있던 %TINKO(PLAYER)%으로 관통했다...
		ENDIF
	ENDIF
ELSE
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"를")% 안은 채로,
			PRINTFORML 밀려오는 충동에 몸을 맡기고 허리를 치켜올렸다...
		ELSEIF TEQUIP:体位２ == 5
			PRINTFORML %조사처리(CALLNAME:TARGET,"를")% 등 뒤에서 껴안고, 다시 %조사처리(CALLNAME:TARGET,"의")% 몸을 흔들기 시작했다...
		ELSE
			PRINTFORML 질 안에서 %TINKO(PLAYER)%을 빼내지 않고 %조사처리(CALLNAME:TARGET,"의")% 몸을 등 뒤에서 끌어안고, 몸을 흔들기 시작했다...
		ENDIF
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 몸을 안아 올리고, %SLIT(, 1)%
		IF TEQUIP:0 & 2
			PRINTFORML 에 %SHOW_BOTTOM(TARGET,2)%의 틈으로부터 천천히 삽입했다...
		ELSE
			PRINTFORML 을 기다리고 있던 것으로 천천히 관통했다...
		ENDIF
	ENDIF
	;SIF TALENT:恋慕
	;	PRINTFORML %CALLNAME:TARGET%は背を仰け反らせて%CALLNAME:PLAYER%にしなだれかかった…
ENDIF
;-------------------------------------------------
;69,対面座位アナル
;-------------------------------------------------

@MESSAGE_COM69
CALL MESSAGE_COM69_TR
RETURN
IF FLAG:70 == 1
	;連続
	IF SELECTCOM == PREVCOM && ASSIPLAY == TFLAG:150
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"에게")% 키스하고, 혀를 얽으면서 다시 허리를 흔들기 시작했다...
		RETURN 0
		;抜かず
	ELSEIF TCVAR:101 == PLAYER
		PRINTFORM 장내로부터
		;調教者についてる
		IF TALENT:PLAYER:2 & 2
			PRINTFORM %TINKO(PLAYER)%을
		ELSE
			PRINTFORM 딜도를
		ENDIF
		PRINTFORML 빼지 않고 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 몸을 뒤에서 끌어안고, 몸을 흔들며 %조사처리(CALLNAME:TARGET,"를")% 이용한 자위를 재개했다...
	ELSE
		PRINTFORM 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 몸을 안아 올리며
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 강제로 밀어내다
		PRINTFORM %TINKO(PLAYER)%눈을 내리깔고
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORM 엉덩이구멍으로 삽입하면,
	ENDIF
	;ボールギャグの有無
	SIF TEQUIP:ボールギャグ == 0
		PRINT 입맞춤을 하면서
	PRINTL %조사처리(CALLNAME:TARGET,"의")% 항문으로 자위하기 위해 허리를 흔들었다...
ELSE
	;連続
	IF SELECTCOM == PREVCOM && ASSIPLAY == TFLAG:150
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %조사처리(CALLNAME:PLAYER,"와")% 키스를 하고, 혀를 얽으면서 다시 허리를 흔들기 시작했다...
		RETURN 0
		;抜かず
	ELSEIF TCVAR:101 == PLAYER
		PRINTFORM 장내로부터
		;調教者についてる
		IF TALENT:PLAYER:2 & 2
			PRINTFORM %TINKO(PLAYER)%을
		ELSE
			PRINTFORM 딜도를
		ENDIF
		PRINTFORM 빼앗지 않고 %조사처리(CALLNAME:TARGET,"의")% 몸을 꼭 끌어안았다.
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 몸을 안아 올렸다.
		SIF TEQUIP:0 & 2
			PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 강제로 밀어냈다
		PRINTFORM 느긋하게 내리며
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORM 아누스에 삽입해,
	ENDIF
	;ボールギャグの有無
	SIF TEQUIP:ボールギャグ == 0
		PRINT 입맞춤을 하면서
	PRINTL 허리를 흔들었다...
	;陥落済み
	SIF TALENT:恋慕
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %조사처리(CALLNAME:PLAYER,"의")% 목에 손을 감고 안겨왔다…
ENDIF
