	;連続
	IF SELECTCOM == PREVCOM && ASSIPLAY == TFLAG:150
		PRINTFORML %조사처리(CALLNAME:TARGET,"를")% 등 뒤에서 껴안고, 다시 %조사처리(CALLNAME:TARGET,"의")% 몸을 흔들기 시작했다...
