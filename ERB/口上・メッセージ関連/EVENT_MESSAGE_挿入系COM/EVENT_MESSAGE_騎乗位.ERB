; Modular ERB: EVENT_MESSAGE_挿入系COM/EVENT_MESSAGE_騎乗位.ERB
;-------------------------------------------------
;65,騎乗位
;-------------------------------------------------

@MESSAGE_COM65
;Custom code, override
CALL MESSAGE_COM65_TR
RETURN RESULT
;抜かず
IF FLAG:70 == 1
	IF EXP:MASTER:時姦経験 >= EXP:TARGET:愛情経験 + 50
		IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
			IF TALENT:体型 == -1
				IF NOWEX:MASTER:射精
					PRINTFORML 갈 것 같아진 %조사처리(CALLNAME:PLAYER,"는")%, %TINKO(PLAYER)%를 밀어 넣고 있는 공중에 정지해 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고
					PRINTFORML 작은 질 구멍을 뚫을 듯한 기세로, 허리를 치기 시작했다...
				ELSEIF TCVAR:102
					PRINTFORML 시간을 멈춘 채 %CALLNAME:TARGET%에 정액을 쏟아낸 %조사처리(CALLNAME:MASTER,"는")%
					PRINTFORML 다시 쾌락을 탐하기 위해 %조사처리(CALLNAME:TARGET,"의")% 어린 질 구멍을 범하기 시작했다...
				ELSEIF TEQUIP:体位２ == 3
					PRINTFORML 시간을 멈춘 %조사처리(CALLNAME:TARGET,"를")% 자신에게 다시 걸친 채, 다시 허리를 밀어 올리기 시작했다...
				ELSE
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 어린 질구에 %TINKO(PLAYER)%를 삽입한 채 등을 대고 누워
					PRINTFORML %TINKO(PLAYER)%가 간신히 빠지지 않는 높이까지 %조사처리(CALLNAME:TARGET,"의")% 몸을 들어 올리고
					PRINTFORML 공중에 정지된 %조사처리(CALLNAME:TARGET,"의")% 질구를 범하기 위해 허리를 들기 시작했다…
				ENDIF
			ELSEIF NOWEX:MASTER:射精
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈추고 공중에서 정지해 있는 %조사처리(CALLNAME:TARGET,"의")% 질 구멍을 아래에서 허리를 밀어붙이며 범하고 있다.
				PRINTFORML 절정에 이를 듯한 %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")% 허리를 붙잡고, 더욱 격렬하게 허리를 밀어붙이기 시작했다...
			ELSEIF TCVAR:102
				PRINTFORML 시간을 멈춘 채 %CALLNAME:TARGET%에 정액을 뱉어낸 %조사처리(CALLNAME:MASTER,"는")%
				PRINTFORML 다시 쾌락을 탐하기 위해 미동조차 하지 않는 %조사처리(CALLNAME:TARGET,"를")% 범하기 시작했다...
			ELSEIF TEQUIP:体位２ == 3
				PRINTFORML 시간을 멈춘 %조사처리(CALLNAME:TARGET,"를")% 자신에게 다시 걸친 채, 다시 허리를 밀어 올리기 시작했다...
			ELSE
				PRINTFORML 육봉 오나호로 만들었던 %조사처리(CALLNAME:TARGET,"의")% 질 구멍에서 빼지 않고 자신에게 다시 올라타게 한 뒤, 다시 질 구멍을 찔러 올리기 시작했다...
			ENDIF
		ELSEIF TALENT:体型 == -1
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈추고 공중에 정지해 있는 %CALLNAME:TARGET%아래로 몸을 밀어 넣었다.
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINTFORM 점액에 젖었다
			SIF TALENT:処女 == 1
				PRINTFORM 남을 알기엔 너무 이르다.
			PRINTFORML 어린 혈관에 %TINKO(PLAYER)%을 맞추고, 세차게 허리를 박아 올렸다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 다리를 벌린 채 공중에 정지한 채, 고정된 오나홀처럼 %조사처리(CALLNAME:PLAYER,"에게")% 어린 질 구멍을 사용당했다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈추고 공중에 정지해 있는 %CALLNAME:TARGET%아래로 몸을 미끄러뜨렸다.
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINTFORM 애액을 떨어뜨리다
			SIF TALENT:処女 == 1
				PRINTFORM 남자 경험 없음
			;小柄体型
			IF TALENT:体型 < 0
				PRINT 어린 나약한 자
			ELSE
				PRINT 히레츠
			ENDIF
			PRINTFORML 그것을 %TINKO(PLAYER)%에게 맞추고 힘차게 허리를 쳐올린다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 다리를 벌린 채 공중에 정지한 채, 고정된 오나홀처럼 %조사처리(CALLNAME:PLAYER,"에게")% 질 구멍을 사용당하고 있다.
		ENDIF
	ELSE
		IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
			IF NOWEX:MASTER:射精
				PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈춘 %조사처리(CALLNAME:TARGET,"를")% 자신에게 올라탄 채로,
				PRINTFORML 밀려오는 충동에 몸을 맡긴 채 허리를 치켜들었다…
			ELSEIF TCVAR:102
				PRINTFORML 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 자궁 안에 정액을 주입하고 끝내자,
				PRINTFORML %TINKO(PLAYER)%가 경도를 잃기 전에 다시 골반을 밀어붙이기 시작했다...
			ELSEIF TEQUIP:体位２ == 3
				PRINTFORML 시간이 멈춘 %조사처리(CALLNAME:TARGET,"를")% 자신에게 태운 채, 다시 허리를 밀어 올리기 시작했다...
			ELSE
				PRINTFORML 질내에서 빼지 않고 시간이 멈춘 %조사처리(CALLNAME:TARGET,"를")% 자신에게 올라타게 하고, 다시 허리를 치기 시작했다...
			ENDIF
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 다리를 벌리고, %조사처리(CALLNAME:TARGET,"를")% 자신의 위에 올라타게 했다.
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINTFORM 애액을 떨어뜨린다.
			SIF TALENT:処女 == 1
				PRINTFORM 남자 경험 없음
			;小柄体型
			IF TALENT:体型 < 0
				PRINT 어린 나약한 자
			ELSE
				PRINT 히레츠
			ENDIF
			PRINTFORML 에 %TINKO(PLAYER)%를 밀어 넣었다...
		ENDIF
	ENDIF
ELSE
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 올라탄 채로,
			PRINTFORML 밀려오는 충동에 몸을 맡기고 허리를 치켜들었다...
		ELSEIF TCVAR:102
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 안에 정액을 주입하는 것을 마치자,
			PRINTFORML %TINKO(PLAYER)%가 경도를 잃기 전에 다시 허리를 움직이기 시작했다...
		ELSEIF TEQUIP:体位２ == 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 삽입된 채의 %TINKO(PLAYER)%를 조이며, 다시 허리를 움직이기 시작했다...
		ELSE
			PRINTFORML 질 안에서 빼내지 않고 %조사처리(CALLNAME:TARGET,"를")% 안아 올리며, 아래에서 허리를 밀어붙였다...
		ENDIF
	ELSE
		IF TALENT:処女 == 1
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:PLAYER%위에 올라타서, 천천히 자리를 잡았다.
			;処女＋小柄体型
			IF TALENT:体型 < 0
				PRINTFORML , 남을 모르는 어린 나로 %TINKO(PLAYER)%를 삼켜버렸다...
				;処女
			ELSE
				PRINTFORML , 남을 모르는 은밀한 곳으로 %TINKO(PLAYER)%를 삼아버렸다...
			ENDIF
		ELSEIF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%가 해방한 %TINKO(PLAYER)%를 자신의 질 안에 천천히 집어넣었다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:PLAYER%위에 올라타서, 천천히 자리를 잡았다...
		ENDIF
		;		;陥落済み
		;		IF TALENT:恋慕
		;			PRINTFORM %CALLNAME:TARGET%は
		;			;小柄体型
		;			SIF TALENT:体型 < 0
		;				PRINT 小さな身体で懸命に
		;			;巨乳
		;			SIF TALENT:バストサイズ == 1
		;				PRINT 大きく胸を揺らしながら
		;			;爆乳
		;			SIF TALENT:バストサイズ == 2
		;				PRINT 跳ねる胸に身体ごと揺らされながら
		;			PRINTL 自ら腰を動かしている…
		;		ENDIF
	ENDIF
ENDIF
