;-------------------------------------------------
;64,逆レイプ
;-------------------------------------------------

@MESSAGE_COM64
CALL MESSAGE_COM64_TR
RETURN
;逆レイプと騎乗位されるは少しニュアンスが違う気がするけど、需要がはっきりするまで保留します
;;連続
;IF SELECTCOM == PREVCOM && ASSIPLAY == TFLAG:150
;	PRINTFORML %CALLNAME:MASTER%は%CALLNAME:TARGET%の%TINKO(MASTER)%をきつく食い締めたまま、執拗に腰を振りたてた…
;ELSE
;	PRINTFORM %CALLNAME:MASTER%は%CALLNAME:TARGET%の%TINKO(MASTER)%を強引に、
;	;調教者が処女
;	SIF TALENT:MASTER:処女 == 1
;		PRINT 男を受け入れた事のない
;	PRINTL ヴァギナの奥まで咥えこんだ…
;ENDIF
;逆レイプはMASTER主導なのに、地の文がTARGET主導になってるので、まるっと変更
;抜かず
IF TCVAR:MASTER:100 == TARGET && TARGET == TFLAG:103
	;対象が射精
	IF NOWEX:TARGET:11
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 궁지에 몰린 모습에, 입가에 미소를 띠고 격렬하게 허리를 흔든다.
		PRINTFORM %TINKO(TARGET)%가 질강을 파고드는 쾌락에, %CALLNAME:MASTER%도 달콤한 신음소리를 냈다.
		;調教者も射精
		IF NOWEX:MASTER:11
			PRINTL  
			PRINTFORM 동시에 도달한 %CALLNAME:MASTER%도 %TINKO(MASTER)%에서, 격렬하게 %SAMEN_DESCRIPTION(MASTER)%을 발사했다.
		ENDIF
		PRINTFORML …
		;前ターンでＶ中出し
	ELSEIF TCVAR:MASTER:102
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 태내에 주입된 정액의 감촉에, 황홀한 표정을 지으며 허리를 흔들기 시작했다.
		PRINTFORML 사정의 쾌락에 잠겨 있던 %조사처리(CALLNAME:TARGET,"지만")%, %조사처리(CALLNAME:MASTER,"의")% 질 안에서 조여오는 쾌감에 신음을 멈출 수 없었다.
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%를, 질구로 꽉 조이면서 %조사처리(CALLNAME:MASTER,"는")% 신음하고 있다
	ENDIF
ELSE
	IF TALENT:MASTER:処女 == 1
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %CALLNAME:TARGET%위에 올라타, 스스로 %TINKO(TARGET)%를 질강으로 이끌어 간다.
		;処女＋小柄体型
		IF TALENT:MASTER:体型 < 0
			PRINTFORML 아직 남자를 모르는 어린 나약함을 스스로 깨우치게 하고, %TINKO(TARGET)%을 천천히 삼켰다...
			;処女
		ELSE
			PRINTFORML 처음으로의 증거를 우리 안에 간직한 비밀을 열고, %TINKO(MASTER)%을 천천히 삼아갔다...
		ENDIF
	ELSE
		PRINTFORM %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"를")% 깔아뭉개고,
		SIF TEQUIP:MASTER:0 & 2
			PRINTFORM %SHOW_BOTTOM(MASTER,2)%의 틈 사이로
		PRINTFORML 자신의 %SLIT(, 1)%에 %TINKO(TARGET)%를 갖다 대고 삼켜 갔다……
		PRINTFORML 
		;ちんちん
		IF TALENT:TARGET:2 & 2
			PRINTFORM 열을 띤 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%
			;にせちん
		ELSE
			PRINTFORM 무기질적인 페니스밴드
		ENDIF
		PRINTFORML 를 질강에서 빨면서, %조사처리(CALLNAME:MASTER,"는")% 날카로운 환희의 울음을 내고 있다...
	ENDIF
ENDIF
;-------------------------------------------------
;66,騎乗位アナル
;-------------------------------------------------

@MESSAGE_COM66
CALL MESSAGE_COM66_TR
RETURN
IF FLAG:70 == 1
	;連続
	IF SELECTCOM == PREVCOM && ASSIPLAY == TFLAG:150
		PRINTFORML 시간을 멈춘 %조사처리(CALLNAME:TARGET,"를")% 자신에게 다시 걸친 채, 다시 허리를 밀어 올리기 시작했다...
		;抜かず
	ELSEIF TCVAR:101 == MASTER
		PRINTFORML 장내에서 빼내지 않고 미동도 하지 않는 %조사처리(CALLNAME:TARGET,"를")% 안아 올리고, 아래에서 허리를 밀어 올렸다...
	ELSE
		PRINTFORM %조사처리(CALLNAME:MASTER,"는")% 시간이 멈춘 %조사처리(CALLNAME:TARGET,"의")% 다리를 벌리고, %CALLNAME:TARGET%아래에 몸을 파고들었다.
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORML 애널에 천천히 %조사처리(CALLNAME:MASTER,"의")% 것을 삽입해 나갔다...
	ENDIF
ELSE
	;連続
	IF SELECTCOM == PREVCOM && ASSIPLAY == TFLAG:150
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 삽입된 채로 조여오며, 다시 허리를 움직이기 시작했다...
		;抜かず
	ELSEIF TCVAR:101 == MASTER
		PRINTFORML 장에서 빼내지 않고 %조사처리(CALLNAME:TARGET,"를")% 안아, 아래쪽에서 허리를 밀어 올렸다...
	ELSE
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:MASTER%위에 올라타자,
		;潤滑LV4以上
		SIF PALAM:潤滑 >= PALAMLV:4
			PRINT 점액에 뒤덮인
		PRINTFORML 항문을 통해 천천히 %조사처리(CALLNAME:MASTER,"의")% 것을 삼켜 내려갔다...
	ENDIF
	;陥落済み
	IF TALENT:恋慕
		PRINTFORM %조사처리(CALLNAME:TARGET,"는")%
		;小柄体型
		SIF TALENT:体型 < 0
			PRINT 작은 몸으로 필사적으로
		;巨乳
		SIF TALENT:バストサイズ == 1
			PRINT 크게 가슴을 흔들면서
		;爆乳
		SIF TALENT:バストサイズ == 2
			PRINT 뛰는 가슴에 몸째 흔들리면서
		PRINTL 스스로 허리를 움직이고 있다...
	ENDIF
ENDIF
;-------------------------------------------------
;71,二穴挿し
;-------------------------------------------------

@MESSAGE_COM71
CALL MESSAGE_COM71_TR
RETURN
VARSET LOCAL
LOCAL:1 = MASTER_POSE(SET_V,SET_P,1)
LOCAL:2 = MASTER_POSE(SET_A,SET_P,1)
IF LOCAL:1
	LOCAL = LOCAL:1
ELSEIF LOCAL:2
	LOCAL = LOCAL:2
ENDIF
;LOCAL 二穴挿しされる人
;連続
IF PREVCOM == SELECTCOM
	PRINTFORML %CALLNAME:LOCAL%는 앞뒤를 동시에 관통당하고, 폭력적인 쾌감에 자아를 잊고 몸부림치고 있다...
	RETURN 0
	;主人W挿し
ELSEIF ((LOCAL:1 == 0 || LOCAL:2 == 0) && LOCAL == TARGET) && TALENT:MASTER:双槍
	PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 자신으로 %CALLNAME:LOCAL%의 두 구멍을 관통했다...
	;主人V挿入-TARGET A挿入
ELSEIF LOCAL == LOCAL:1
	PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 연결된 채로 %CALLNAME:LOCAL%의 엉덩이를 벌리고, %조사처리(CALLNAME:TARGET,"에게")% 뒤쪽 구멍도 범하듯이 촉구했다...
	;主人A挿入-助手V挿入
ELSE
	PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 항문을 관통한 상태로 %CALLNAME:LOCAL%를 안아 올리고 다리를 벌리게 하여 %조사처리(CALLNAME:TARGET,"에게")% 앞의 구멍도 범하도록 재촉했다...
ENDIF
;-------------------------------------------------
;79,小人オナホ
;-------------------------------------------------

@MESSAGE_COM79
CALL MESSAGE_COM79_TR
RETURN
IF TCVAR:100 == MASTER && TARGET == TFLAG:103
	IF TALENT:MASTER:2 & 2
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 질 속 감촉을 느끼며, 다시 %조사처리(CALLNAME:TARGET,"로")% 페니스를 만지기 시작했다……
		;ペニスバンドを使用している場合
	ELSE
		PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 질 속에서 빼지 않고, 다시 %조사처리(CALLNAME:TARGET,"로")% 페니스를 만지기 시작했다…….
	ENDIF
	SIF !FLAG:70 && EXP:Ｖ拡張経験 < 25 && CFLAG:MASTER:イタズラ != 2
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 흰자 눈을 드러내고 의미 없는 신음소리를 내고 있다...
ELSE
	PRINTFORM %조사처리(CALLNAME:TARGET,"를")% 움켜쥐고, 그
	;処女
	IF TALENT:0
		PRINT 남자 경험 없음
		;潤滑LV4以上
	ELSEIF PALAM:4 >= PALAMLV:4
		PRINT 흠뻑 젖은
	ELSEIF PALAM:4 <= PALAMLV:2
		PRINT 제대로 젖지도 않았다.
	ENDIF
	IF EXP:Ｖ拡張経験 < 5
		PRINTFORML 작은 와레메에 %TINKO(MASTER)%을 힘으로 집어넣었다.
	ELSE
		PRINTL 작은 상처를 관통했다
	ENDIF
	IF FLAG:70 || CFLAG:MASTER:イタズラ == 2
		IF EXP:Ｖ拡張経験 < 10
			PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 은밀한 곳이 삐걱거리는 불쾌한 소리를 내는 것도 개의치 않고,
		ELSEIF EXP:Ｖ拡張経験 > 50
			PRINTFORM 거대한 페니스를 쉽게 삼킨다
		ENDIF
	ELSE
		IF ABL:マゾっ気 > 3 && EXP:Ｖ拡張経験 > 50
			PRINT 거대한 육창에 꿰뚫린 채 황홀한 표정으로 몸을 떨었다.
		ELSEIF ABL:マゾっ気 > 2 && EXP:Ｖ拡張経験 > 25
			PRINT 입을 뻐끔거리면서도 뺨을 상기시켰다.
		ELSE
			PRINT 거대한 페니스에 내장을 압박당하며 고통의 비명을 지른다.
		ENDIF
	ENDIF
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸을 오나홀처럼 사용해서 페니스를 다루고 싶었다…….
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 배에는 %조사처리(CALLNAME:MASTER,"의")% 페니스 형태가 그로테스크하게 솟아올라, %조사처리(CALLNAME:TARGET,"의")% 작은 몸과 현저한 대조를 이루었다…….
ENDIF
;-------------------------------------------------
;92,Ａ正常位される
;-------------------------------------------------

@MESSAGE_COM92
CALL MESSAGE_COM92_TR
RETURN
;Ａ対面立位される
IF (!BEDROOM(CFLAG:MASTER:現在位置) && !(BATHROOM() && ITEM:20))
	;抜かずに
	IF TCVAR:MASTER:101 == TARGET && TARGET == TFLAG:103
		;対象が射精
		IF NOWEX:TARGET:11
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 안긴 채 항문을 헤집히고 있다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 격렬하게 몸을 떨자, 동시에 %조사처리(CALLNAME:MASTER,"의")% 직장에 %SAMEN_DESCRIPTION(TARGET)%이 주입되었다.
			;調教者も射精。あへぇ
			SIF NOWEX:MASTER:11
				PRINTFORM 동시에 도달한 %조사처리(CALLNAME:MASTER,"의")% %TINKO(MASTER)%도 크게 떨며 뜨거운 %SAMEN_DESCRIPTION(MASTER)%을 토해냈다
			PRINTFORML …
			;前ターンでＡ中出しされてる
		ELSEIF TCVAR:MASTER:102
			PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 허리를 움직이며, %조사처리(CALLNAME:MASTER,"의")% 꽃받침을 관통하고 있다.
			PRINTFORM %SAMEN_DESCRIPTION(TARGET)%가
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん（てかチンコないのに中出しされてるってどういうこと？
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 뒤엉켜서, 음란한 달라붙는 소리를 항문에서 울리고 있다.
		ELSE
			PRINTFORML %TINKO(TARGET)%에 장벽을 비비면서 %조사처리(CALLNAME:MASTER,"는")% 허리를 앞으로 내밀었다.
			PRINTFORML 온몸의 힘을 푸는 %조사처리(CALLNAME:MASTER,"에게")%, %조사처리(CALLNAME:TARGET,"의")% 허리가 움직이기 시작한다...
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:TARGET%에서 \@ ABL:サドっ気 >= 3 ? 강제로 # 다정하게 \@끌어안겼다
		PRINTFORM %조사처리(CALLNAME:MASTER,"는")% 한쪽 다리를 %조사처리(CALLNAME:TARGET,"의")% 허리에 감고,
		IF EXP:MASTER:Ａ経験 >= EXPLV:4
			PRINTFORM 부드럽게 녹아내리는 항문으로,
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 를 달콤하게 물어 먹는다.
		ELSEIF EXP:MASTER:Ａ経験 >= EXPLV:3
			PRINTFORM 시작된 항문에 천천히
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 을 물고 들어간다
		ELSE
			PRINTFORML 아직 이물점이 되지 못한 항문을 관통당하는 고통에, 신음한다.
		ENDIF
		;ちんちん
		IF TALENT:TARGET:2 & 2
			PRINTFORM 열을 띤 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%가
			;にせちん
		ELSE
			PRINTFORM 무기질적인 페니스밴드가
		ENDIF
		PRINTFORML 항문을 파고 장벽을 가지고 노는 감각에, %조사처리(CALLNAME:MASTER,"는")% 신음하고 있다...
	ENDIF
	;Ａ正常位される
ELSE
	;抜かずに
	IF TCVAR:MASTER:101 == TARGET && TARGET == TFLAG:103
		;対象が射精
		IF NOWEX:TARGET:11
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"에게")% 뒤덮인 채 항문을 파헤쳐지고 있다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 격렬하게 몸을 떨자 동시에, %조사처리(CALLNAME:MASTER,"의")% 직장에 %SAMEN_DESCRIPTION(TARGET)%가 주입되었다.
			;調教者も射精。あへぇ
			SIF NOWEX:MASTER:11
				PRINTFORM 동시에 도달한 %조사처리(CALLNAME:MASTER,"의")% %TINKO(MASTER)%도 크게 떨며 뜨거운 %SAMEN_DESCRIPTION(MASTER)%을 토해냈다
			PRINTFORML …
			;前ターンでＡ中出し
		ELSEIF TCVAR:MASTER:102
			PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 허리를 움직이며, %조사처리(CALLNAME:MASTER,"의")% 국좌를 관통하고 있다.
			PRINTFORM %SAMEN_DESCRIPTION(TARGET)%가
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 에게 달라붙어, 음란한 끈적이는 소리를 항문에서 울리고 있다.
		ELSE
			PRINTFORML %TINKO(TARGET)%에 장벽을 비비면서 %조사처리(CALLNAME:MASTER,"는")% 등을 대고 누웠다.
			PRINTFORML 몸 전체의 힘을 빼자 %조사처리(CALLNAME:MASTER,"에게")% %조사처리(CALLNAME:TARGET,"의")% 허리가 움직이기 시작한다...
		ENDIF
	ELSE
		LOCALS:0 = 
		IF ABL:サドっ気 >= 3
			LOCALS:0 = 거칠게 밀쳐 넘어지고,
		ELSE
			LOCALS:0 = 누워져서,
		ENDIF
		PRINTFORML %CALLNAME:TARGET%에 등을 대고 누운 %LOCALS:0% %조사처리(CALLNAME:MASTER,"는")% 다리를 자신의 머리 위로 던졌다.
		PRINTFORM 스스로 엉덩이를 벌리는 %조사처리(CALLNAME:MASTER,"의")%,
		IF EXP:MASTER:Ａ経験 >= EXPLV:4
			PRINTFORM 이미 부드럽게 녹아내린 항문이, %조사처리(CALLNAME:TARGET,"의")%
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 를 달콤하게 물어 먹는다.
		ELSEIF EXP:MASTER:Ａ経験 >= EXPLV:3
			PRINTFORM 시작된 항문에 천천히
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 이 삽입되어 온다
		ELSE
			PRINTFORML 아직 이물질이 될 수 없는 항문을 관통당하고, 고통스러운 신음이 새어 나왔다.
		ENDIF
		;ちんちん
		IF TALENT:TARGET:2 & 2
			PRINTFORM 열을 띤 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%가
			;にせちん
		ELSE
			PRINTFORM 무기질적인 페니스밴드가
		ENDIF
		PRINTFORML 장벽을 휘젓는 감각에, %조사처리(CALLNAME:MASTER,"는")% 신음하고 있다...
	ENDIF
ENDIF
;-------------------------------------------------
;93,Ａ後背位される
;-------------------------------------------------

@MESSAGE_COM93
CALL MESSAGE_COM93_TR
RETURN
;Ａ背面立位される
IF (!INROOM(CFLAG:MASTER:現在位置) && !(BATHROOM() && ITEM:20))
	;抜かずに
	IF TCVAR:MASTER:101 == TARGET && TARGET == TFLAG:103
		;対象が射精
		IF NOWEX:TARGET:11
			PRINTFORML 엉덩이살에 허리를 부딪히는 %조사처리(CALLNAME:MASTER,"는")%, %조사처리(CALLNAME:TARGET,"에게")% 애원하듯 항문을 오므렸다.
			PRINTFORM 떨리는 성기에서 직장으로 %SAMEN_DESCRIPTION(TARGET)%가 박혀 들어오자, %조사처리(CALLNAME:MASTER,"는")% 뜨거운 한숨을 내쉬었다.
