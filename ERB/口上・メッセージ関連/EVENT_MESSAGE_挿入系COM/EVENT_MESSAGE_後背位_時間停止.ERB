					PRINTFORML 정액을 쏟아내기 위해서만, 남자를 모르는 \@ TALENT:体型 < 0 ? 어린 여자 # 회음부 \@에 사정 직전의 %TINKO(PLAYER)%를 집어넣었다...
				ELSE
					PRINTFORML 잠자고 있는 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 높이 들어 올린다.
					PRINTFORML 오나홀로 쓰기 위해, 남을 모르는 \@ TALENT:体型 < 0 ? 어린 여자 # 비열 \@에게 %TINKO(PLAYER)%를 쑤셔 넣었다.
				ENDIF
			ELSEIF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
				PRINTFORML %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%에서 %TINKO(PLAYER)%를 빼는 동시에
				PRINTFORML %CALLNAME:TARGET%에 삽입했다...
			ELSE
				LOCALS:2 = 
				IF TEQUIP:0 & 2
					LOCALS:2 = %SHOW_BOTTOM(TARGET,2)%을 치우고,
				ELSEIF TEQUIP:0 & 1
					LOCALS:2 = %SHOW_BOTTOM(TARGET,1)%를 말아 올리며,
				ENDIF
				PRINTFORML 자고 있는%조사처리(CALLNAME:TARGET,"의")% 질을 오나홀 삼아 사용하기 위해, 엎드리게 한 뒤%LOCALS:2% 뒤에서%SLIT(, 1)%를 범하기 시작했다...
			ENDIF
		ELSE
			IF TALENT:処女 == 1
				PRINTFORML 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 높이 들어 올리고
				PRINTFORML 남을 모르는\@ TALENT:体型 < 0 ? 어린 여자 # 은밀한 곳 \@을 %TINKO(PLAYER)%로 꿰뚫었다...
			ELSEIF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
				PRINTFORML %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%에서 %TINKO(PLAYER)%를 빼는 동시에
				PRINTFORML %CALLNAME:TARGET%에 삽입했다...
			ELSE
				LOCALS:3 = 
				IF TEQUIP:0 & 2
					LOCALS:3 = %SHOW_BOTTOM(TARGET,2)%을 치우고,
				ELSEIF TEQUIP:0 & 1
					LOCALS:3 = %SHOW_BOTTOM(TARGET,1)%를 말아 올리며,
				ENDIF
				PRINTFORML 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% %LOCALS:3% 배를 깔고 %SLIT(, 1)% 가장 깊숙이 밀어 넣었다...
			ENDIF
		ENDIF
	ENDIF
ELSE
	CALL MESSAGE_COM61通常
ENDIF
