;7,挿入子宮口責め
;-------------------------------------------------

@MESSAGE_SCOM7
;Custom code, override
CALL MESSAGE_SCOM7_TR
RETURN
;CALL エロAA(1)
IF FLAG:70 == 1
	IF EXP:MASTER:時姦経験 >= EXP:TARGET:愛情経験 + 50
		;---------------------------------
		;時間停止・鬼畜
		;---------------------------------
		IF TALENT:体型 <= -1
			;---------------------------------
			;小柄体型以下
			;---------------------------------
			IF EXP:TARGET:子宮口開発経験 >= 50
				PRINTFORM %조사처리(CALLNAME:MASTER,"는")% 시간을 멈췄다
				;正常位
				IF TEQUIP:体位２ == 1
					IF TFLAG:193
						PRINTFORML 오나홀처럼 상하로 움직이는 %조사처리(CALLNAME:TARGET,"의")% 작은 몸에, 힘껏 %TINKO(PLAYER)%를 밀어 넣었다.
						PRINTFORML 자궁 입구를 넓히고 자궁 깊숙이 도달한 %TINKO(PLAYER)%는, 밖에서 보기에도 %조사처리(CALLNAME:TARGET,"의")% 하복부를 밀어 올리고 있었다...
						PRINTL 
						PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸을 상하로 흔들면, 칼에 자궁구가 걸려 자궁이 %TINKO(PLAYER)%에 이끌려 상하로 움직인다.
						PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 잔혹한 쾌락을 원하며, 아이 같은 %조사처리(CALLNAME:TARGET,"의")% 몸을 격렬하게 상하로 흔들고 있다...
					ELSE
						PRINTFORML 등을 대고 범하고 있는 %조사처리(CALLNAME:TARGET,"의")% 좁은 질 안에, 힘껏 %TINKO(PLAYER)%를 박아넣었다.
						PRINTFORML 자궁 입구를 밀어내 자궁 깊숙이 도달한 %TINKO(PLAYER)%는, 외부에서 볼 수 있을 정도로 %조사처리(CALLNAME:TARGET,"의")% 아랫배를 밀어 올리고 있다…
						PRINTL 
						PRINTFORML 허리를 움직이면, 자궁구가 칼에 걸려 자궁이 %TINKO(PLAYER)%에 이끌리며 움직이는 것이 느껴진다.
						PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 가학적인 쾌락을 찾아 아이 같은 %조사처리(CALLNAME:TARGET,"의")% 몸에 격렬하게 %TINKO(PLAYER)%를 박고 있다...
					ENDIF
					;後背位
				ELSEIF TEQUIP:体位２ == 2
					IF TFLAG:193
						PRINTFORML 공중에 정지한 채 범해지고 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 힘껏 %TINKO(PLAYER)%를 밑동까지 밀어 넣었다.
						PRINTFORML 밀어 넣어진 %TINKO(PLAYER)%는 %조사처리(CALLNAME:TARGET,"의")% 작은 질 내부를 넘어 자궁 깊숙이 도달한 것 같다...
						PRINTL 
						PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 좁은 질 내부와 자궁구의 조임을 %TINKO(PLAYER)%에게 느끼며 격렬하게 허리를 움직였고,
						PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 어린 생식기를 자궁 깊숙한 곳까지 범해버렸다...
					ELSE
						PRINTFORML 네 발로 기게 만든 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 힘껏 %TINKO(PLAYER)%를 뿌리까지 밀어 넣었다.
						PRINTFORML 밀려 들어간 %TINKO(PLAYER)%는 %조사처리(CALLNAME:TARGET,"의")% 작은 질을 지나 자궁 깊숙한 곳까지 닿아 있는 것 같다...
						PRINTL 
						PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 좁은 질 안과 자궁 입구의 조임을 %TINKO(PLAYER)%에게 느끼며, 짐승처럼 허리를 움직였고
						PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 어린 생식기를 자궁 깊숙한 곳까지 범해버렸다...
					ENDIF
					;騎乗位
				ELSEIF TEQUIP:体位２ == 3
					PRINTFORML 허공에 정지시킨 채 범하고 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 힘껏 골반을 밀어 올렸다.
					PRINTFORML 자궁 깊숙이 닿았던 %TINKO(PLAYER)%가 %조사처리(CALLNAME:TARGET,"의")% 아랫배를 밀어 올려 도드라져 있다.
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 자궁에서 %TINKO(PLAYER)%가 빠지지 않도록 %조사처리(CALLNAME:TARGET,"의")% 높이를 조절하며, 마음껏 어린 질과 자궁을 유린했다...
				ELSE
					PRINTFORML 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 허리를 감싸 안고, 격렬하게%TINKO(PLAYER)%를 밀어 올렸다.
				ENDIF
			ELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 시간을 멈춘 %조사처리(CALLNAME:TARGET,"에게")% %TINKO(PLAYER)%을 한계까지 삽입하고,
				PRINTFORML 자궁구를 부수듯이, 몇 번이고 다시 귀두로 밀어 올렸다...
			ENDIF
		ELSE
			;---------------------------------
			;普通以上
			;---------------------------------
			IF EXP:TARGET:子宮口開発経験 >= 50
				PRINTFORM %조사처리(CALLNAME:MASTER,"는")% 시간을 멈췄다
				;正常位
				IF TEQUIP:体位２ == 1
					IF TFLAG:193
						PRINTFORML 정면에서 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 뒤를 끌어안고, 격렬하게%TINKO(PLAYER)%를 박아 넣었다.
					ELSE
						PRINTFORML 등을 대고 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 허리를 들어 올리고, 격렬하게%TINKO(PLAYER)%를 박아 넣었다.
					ENDIF
					;後背位
				ELSEIF TEQUIP:体位２ == 2
					IF TFLAG:193
						PRINTFORML 뒤에서 범하고 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 짐승처럼 격렬하게 %TINKO(PLAYER)%를 박아넣었다.
					ELSE
						PRINTFORML 네 발로 기어 오르며 범하고 있는 %CALLNAME:TARGET%위에 올라타, 짐승처럼 격렬하게 %TINKO(PLAYER)%를 박아 넣었다.
					ENDIF
					;騎乗位
				ELSEIF TEQUIP:体位２ == 3
					PRINTFORML 자신의 허벅지 위에 앉힌 채 범하고 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 격렬하게 %TINKO(PLAYER)%를 박아 올렸다
				ELSE
					PRINTFORML 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 허리를 감싸 안고, 격렬하게%TINKO(PLAYER)%를 밀어 올렸다.
				ENDIF
				PRINTFORML %TINKO(PLAYER)%깊숙이 삽입하자 개발된 %조사처리(CALLNAME:TARGET,"의")% 자궁구는 유연하게 입을 열고, 밀어 넣어진 귀두를 어렵지 않게 자궁 안으로 받아들였다.
				PRINTFORML 
				IF NOWEX:MASTER:射精
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 범하고 있는 %조사처리(CALLNAME:TARGET,"를")% '기분 좋게 사정할 수 있는 구멍'이라고밖에 생각하지 않고
					PRINTFORML 아무런 망설임 없이 사정 직전의 %TINKO(PLAYER)%로 %조사처리(CALLNAME:TARGET,"의")% 자궁 내를 범하고 있다...
				ELSE
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 부담 따위는 생각지도 않고, 욕망대로 자궁구를 거칠게 범했다...
				ENDIF
			ELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 시간을 멈춘 %조사처리(CALLNAME:TARGET,"에게")% 한계까지 %TINKO(PLAYER)%를 삽입하고
				PRINTFORML 자궁구를 억지로 벌리듯이, 몇 번이고 다시 귀두로 밀어 넣었다…
			ENDIF
		ENDIF
		;---------------------------------
		;時間停止・通常
		;---------------------------------
	ELSEIF EXP:TARGET:子宮口開発経験 >= 50
		PRINTFORML 시간을 멈춘 채%TINKO(PLAYER)%를 깊게 삽입하자, 개발이 완료된%CALLNAME:TARGET%자궁구는 유연하게 입을 열고
		PRINTFORML 밀려 들어온 귀두를 어렵지 않게 자궁 안으로 받아들였다.
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 자궁구의 조임을 느끼며 천천히 허리를 움직였다...
	ELSE
		PRINTFORML 시간을 멈춘%CALLNAME:TARGET%에 한계까지%TINKO(PLAYER)%를 삽입하고 자궁을 꾹꾹 자극했다...
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	IF EXP:TARGET:睡眠姦経験 >= EXP:TARGET:愛情経験 + 50
		;---------------------------------
		;睡眠姦・鬼畜
		;---------------------------------
		IF TALENT:体型 <= -1
			;---------------------------------
			;小柄体型以下
			;---------------------------------
			IF EXP:TARGET:子宮口開発経験 >= 50
				PRINTFORM %조사처리(CALLNAME:MASTER,"는")% 잠든 채로
				;正常位
				IF TEQUIP:体位２ == 1
					PRINTFORML 천장을 보고 범하고 있는 %조사처리(CALLNAME:TARGET,"의")% 좁은 질 안에, 힘껏 %TINKO(PLAYER)%를 박아 넣었다.
					PRINTFORML 자궁구를 밀어 넓히고 자궁 깊숙이 도달한 %TINKO(PLAYER)%는, 겉에서 보기에 알 수 있을 정도로 %조사처리(CALLNAME:TARGET,"의")% 하복부를 밀어 올리고 있다...
					PRINTL 
					PRINTFORML 허리를 움직이면, 자궁구가 칼에 걸려 자궁이 %TINKO(PLAYER)%에 이끌리며 움직이는 것이 느껴진다.
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 가학적인 쾌락을 찾아 아이 같은 %조사처리(CALLNAME:TARGET,"의")% 몸에 격렬하게 %TINKO(PLAYER)%를 박고 있다...
					;後背位
				ELSEIF TEQUIP:体位２ == 2
					PRINTFORML 엎드린 채 범하고 있는 %조사처리(CALLNAME:TARGET,"의")% 허리를 잡고, 힘껏 %TINKO(PLAYER)%를 뿌리까지 밀어 넣었다.
					PRINTFORML 밀어 넣어진 %TINKO(PLAYER)%는 %조사처리(CALLNAME:TARGET,"의")% 작은 질 안을 지나 자궁 깊숙한 곳까지 닿아있는 것 같다...
					PRINTL 
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 좁은 질 안과 자궁 입구의 조임을 %TINKO(PLAYER)%에게 느끼며, 짐승처럼 허리를 움직였고
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 어린 생식기를 자궁 깊숙한 곳까지 범해버렸다...
				ELSE
					PRINTFORML 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 허리를 감싸 안고, 격렬하게%TINKO(PLAYER)%를 밀어 올렸다.
				ENDIF
			ELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 자고 있는 %조사처리(CALLNAME:TARGET,"에게")% 한계까지 %TINKO(PLAYER)%를 삽입하고
				PRINTFORML 자궁구를 벌리듯이, 몇 번이고 반복해서 귀두로 박아 올렸다…
			ENDIF
		ELSE
			;---------------------------------
			;普通以上
			;---------------------------------
			IF EXP:TARGET:子宮口開発経験 >= 50
				PRINTFORM %조사처리(CALLNAME:MASTER,"는")% 잠든 채로
				;正常位
				IF TEQUIP:体位２ == 1
					PRINTFORML 등을 대고 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 허리를 들어 올리고, 격렬하게%TINKO(PLAYER)%를 박아넣었다.
					;後背位
				ELSEIF TEQUIP:体位２ == 2
					PRINTFORML 엎드린 채 범하고 있는 %조사처리(CALLNAME:TARGET,"에게")% 덮쳐, 야수처럼 격렬하게 %TINKO(PLAYER)%를 찔러 넣었다.
				ELSE
					PRINTFORML 범하고 있는%조사처리(CALLNAME:TARGET,"의")% 허리를 감싸 안고, 격렬하게%TINKO(PLAYER)%를 밀어 올렸다.
				ENDIF
				PRINTFORML %TINKO(PLAYER)%깊숙이 삽입하자 완전히 발달한 %조사처리(CALLNAME:TARGET,"의")% 자궁구는 유연하게 입을 벌려 박힌 귀두를 어렵지 않게 자궁 안으로 받아들였다.
				PRINTFORML 
				IF NOWEX:MASTER:射精
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 범하고 있는 %조사처리(CALLNAME:TARGET,"를")% '기분 좋게 사정할 수 있는 구멍'이라고밖에 생각하지 않고
					PRINTFORML 아무런 망설임 없이 사정 직전의 %TINKO(PLAYER)%로 %조사처리(CALLNAME:TARGET,"의")% 자궁 속을 범하고 있다...
				ELSE
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% %조사처리(CALLNAME:TARGET,"의")% 부담 따위는 생각도 않고, 욕망대로 자궁구를 쑤셨다…
				ENDIF
			ELSE
				PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 잠들어 있는 %조사처리(CALLNAME:TARGET,"에게")% 한계까지 %TINKO(PLAYER)%를 삽입하고
				PRINTFORML 자궁구를 벌리듯이, 몇 번이고 다시 귀두로 박아 올렸다…
			ENDIF
		ENDIF
		;---------------------------------
		;睡眠姦・通常
		;---------------------------------
	ELSEIF EXP:TARGET:子宮口開発経験 >= 50
		PRINTFORML 잠든 채로 %TINKO(PLAYER)%을 깊숙이 삽입하자, 개발된 %조사처리(CALLNAME:TARGET,"의")% 자궁구는 유연하게 입을 열고
		PRINTFORML 밀려 들어온 귀두를 어렵지 않게 자궁 안으로 받아들였다.
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 자궁구의 조임을 느끼며 천천히 허리를 움직였다...
	ELSE
		PRINTFORML 자고 있는 %조사처리(CALLNAME:TARGET,"에게")% 한계까지 %TINKO(PLAYER)%를 삽입하고 자궁을 꾹꾹 자극했다…
	ENDIF
ELSE
	;---------------------------------
	;シラフ
	;---------------------------------
	SELECTCASE TEQUIP:体位２
		CASE 1
			;正常
			IF TCVAR:PLAYER:12 && (BEDROOM(CFLAG:PLAYER:現在位置) || (BATHROOM() && ITEM:20)) && TEQUIP:TARGET:体位 == 1
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 허벅지를 감싸 안듯이 눌러,
				PRINTFORML 묵직하게 체중을 실어 폭발 직전인 %TINKO(PLAYER)%를 깊숙한 곳까지 밀어 넣었다…
			ELSE
				PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 몸을 누르며, 부드럽게 깊숙이 밀어 넣는다...
			ENDIF
		CASE 2
			IF TCVAR:PLAYER:12
				PRINTFORM 절정에 다다르면서 당신은 
				IF BEDROOM(CFLAG:PLAYER:現在位置) && !RAND:3
					PRINTFORML 당신들 둘은 마치 씨앗을 준비하는 동물처럼, %CALLNAME:TARGET%위로 납작하게 쓰러져 %HIM_HER(TARGET)%를 덮으며 교합했다...
				ELSE
					IF (TEQUIP:胸揉み || !RAND:2)
						PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 가슴을 강하게 더듬었다.
					ELSE
						PRINTDATA
							DATAFORM %조사처리(CALLNAME:TARGET,"의")% 허벅지를 붙잡았다.
							DATAFORM %조사처리(CALLNAME:TARGET,"의")% 허리를 붙잡았다.
							DATAFORM %조사처리(CALLNAME:TARGET,"의")% 팔을 잡아 고삐처럼 사용했다.
						ENDDATA
					ENDIF
					PRINTFORML  %HIM_HER(TARGET)%에 부딪히면서, 그들은 서로 하나와 융합된 것처럼 교미한다...
				ENDIF
			ELSE
				;バック
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 바닥에 깔려 있고 당신이 리듬을 타며 박아 넣고 있는 동안 %HIS_HER(TARGET)% 리듬에 맞춰 뒤에서
				PRINTFORML 귀두가 자궁에 반복적으로 부딪혔다.
			ENDIF
		CASE 5
			;騎乗
			PRINTFORML 당신은 골반을 위로 밀어 올리며 %조사처리(CALLNAME:TARGET,"의")% 깊숙한 곳으로 파고든다...
		CASE 3,4
			;その他
			PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 허리를 단단히 잡고, 
			IF ABL:MASTER:腰 >= 3
				LOCALS:0 = 
				SELECTCASE EXP:TARGET:子宮口開発経験
					CASE IS < 25
						LOCALS:0 '= @"단단하게 자궁 입구를 닫았다."
					CASE 25 TO 50
						LOCALS:0 '= @"맥동하는 자궁"
					CASEELSE
						LOCALS:0 = %CALLNAME:MASTER%에 들러붙은 듯한 자궁
				ENDSELECT
				PRINTFORML 당신은 능숙하게 부딪힌다 %조사처리(CALLNAME:TARGET,"의")% %LOCALS:0% 당신의 %TINKO(PLAYER)%...
			ELSE
				PRINTFORML 당신은 %HIS_HER(TARGET)% 자궁에 몸을 밀착한다...
			ENDIF
	ENDSELECT
	SELECTCASE EXP:TARGET:子宮口開発経験
		CASE IS < 25
			PRINTDATA
				DATAFORM %CALLNAME:TARGET% 감았다 %HIS_HER(TARGET)% 눈을 굳게 감은 채 이물질의 감각을 견디며...
				DATAFORM %CALLNAME:TARGET% 찡그리며 느끼는 감각을 견디면서 %HIS_HER(TARGET)% 자궁경부가 벌려지는 감각을 견디며...
			ENDDATA
		CASE 25 TO 50
			PRINTFORML 발현이 되는 것 같다. %조사처리(CALLNAME:TARGET,"가")% 쾌감으로 인해 조금씩 홍조를 띠기 시작했으니까.
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 자궁이 산산조각 날 정도로 두들겨지자, %HE_SHE(TARGET)%는 고통보다는 쾌감으로 숨을 몰아쉬기 시작한다...
		CASE IS > 50
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML %TINKO(PLAYER)%이 삽입되자, %조사처리(CALLNAME:TARGET,"의")% 발달된 자궁은 유연하게 입을 연다.
					PRINTFORML 그것은 어려움 없이 추삽들을 맞이한다.
					IF TALENT:TARGET:恋慕
						PRINTDATA
							DATAFORM %조사처리(CALLNAME:TARGET,"의")% 얼굴은 쾌감에 취해 녹아내리며, 당신이 %HIS_HER(TARGET)%의 가장 깊은 곳에 도달하고 있음을 알고 행복하다.
							DATAFORM %조사처리(CALLNAME:TARGET,"의")% 얼굴이 풀리며 당신이 ~을 두들기자 %HIS_HER(TARGET)% 자궁경부...
						ENDDATA
					ELSE
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 지배당하는 느낌을 기억하고 복종적인 암컷처럼 당신에게 굴게 될 것이라는 공포를 느낀다...
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 참지 못하고 헐떡인다...
					ENDIF
				CASE 1
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 온몸이 기쁨에 떨리고 경련한다. 그녀의 발달된 자궁이 %TINKO(PLAYER)%에게 찔리자...
			ENDSELECT
	ENDSELECT
ENDIF
