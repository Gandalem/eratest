;6,挿入Ｇスポ責め
;-------------------------------------------------

@MESSAGE_SCOM6
;Custom code, override
CALL MESSAGE_SCOM6_TR
RETURN
SELECTCASE TEQUIP:体位２
	CASE 1,3
		PRINTFORML 너는 %ONGOING_P(TARGET)%으로 박아 넣으며 %HIS_HER(TARGET)%의 질 천장을 때린다...
	CASE 2
		PRINTFORML 당신은 %CALLNAME:TARGET%위에서 %HIS_HER(TARGET)%의 질 천장을 때리며 %HIS_HER(TARGET)% 안으로 내리친다...
	CASE 4
		PRINTFORML 당신은 %ONGOING_G(TARGET)%의 상체를 놓아주며, %HIS_HER(TARGET)% 질의 천장을 자극하는 데 집중한다...
	CASE 5
		PRINTFORML 당신은 %CALLNAME:TARGET%질의 천장을 계속해서 두드리며 위아래로 튕긴다...
ENDSELECT
SIF FLAG:70 == 1
	PRINTFORML 시간을 멈출 수 있었던 %조사처리(CALLNAME:TARGET,"는")% 질 내부만 파르르 떨고 있다…
SIF CFLAG:MASTER:イタズラ == 2
	PRINTFORML 잠든 채 범해지고 있는 %조사처리(CALLNAME:TARGET,"는")% 가끔 작은 신음 소리를 흘린다…
