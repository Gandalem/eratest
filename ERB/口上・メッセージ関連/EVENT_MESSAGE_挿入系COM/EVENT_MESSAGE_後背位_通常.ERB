; Modular ERB: EVENT_MESSAGE_挿入系COM/EVENT_MESSAGE_後背位_通常.ERB

@MESSAGE_COM61通常
CALL MESSAGE_COM61通常_TR
RETURN
;背面立位
IF TFLAG:193
	;抜かず
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% \@ OPENPLACE(CFLAG:MASTER:現在位置) == 2 ? 팔 # 골반 \@을 잡고 정액을 %HIS_HER(TARGET)%의 질에 쏟아내며 격렬하게 허리를 움직인다...
		ELSEIF TCVAR:102
			PRINTFORML 당신이 %CALLNAME:TARGET%안에 사정하고, 당신의 %TINKO(PLAYER)%가 벌떡되기 전에 다시 박기 시작한다...
		ELSEIF TEQUIP:体位２ == 2
			;調教者についてる
			IF TALENT:PLAYER:2 & 2
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부의 감촉을 느끼며, 다시 허리를 움직이기 시작했다…
				;ペニスバンドを使用している場合
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부에서 빼지 않고, 다시 허리를 움직이기 시작했다...
			ENDIF
		ELSE
			IF TEQUIP:体位２ == 2
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 속에서 %TINKO(PLAYER)%를 빼내지 않고 다시 허리를 움직이기 시작했다...
				;対面立位から
			ELSE
				PRINTFORML 일단 %CALLNAME:TARGET%에서 %TINKO(PLAYER)%를 빼고 벽에 손을 대더니
				PRINTFORML 뒤에서 삽입하고 다시 허리를 움직이기 시작했다...
			ENDIF
		ENDIF
	ELSE
		IF TALENT:処女 == 1
			PRINTFORML \@ OPENPLACE(CFLAG:MASTER:現在位置) == 2 ? 뒤에서 양손을 잡았다. # 벽에 손을 대고 \@%CALLNAME:TARGET%엉덩이를 내밀게 하고
			PRINTFORML 남자 모르는 \@ TALENT:体型 < 0 ? 어린 여자 # 비열한 균열 \@을 %TINKO(PLAYER)%로 관통했다.
		ELSEIF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
			PRINTFORML %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%에서 %TINKO(PLAYER)%를 빼는 동시에
			PRINTFORML %CALLNAME:TARGET%에 삽입했다...
		ELSE
			IF TEQUIP:0 & 2
				PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 밀었다
			ELSEIF TEQUIP:0 & 1
				PRINTFORM %SHOW_BOTTOM(TARGET,1)%를 들어 올렸다
			ENDIF
			PRINTFORM %CALLNAME:TARGET%
			PRINTFORM \@ OPENPLACE(CFLAG:MASTER:現在位置) == 2 ? 내밀었던 양손을 붙잡고 # 양손을 벽에 붙인 채 \@, 뒤에서
			;潤滑LV4以上
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINT 흠뻑 젖은
			;小柄体型
			IF TALENT:体型 < 0
				PRINT 어린 나약한 자
			ELSE
				PRINT 히레츠
			ENDIF
			PRINTFORML 가장 깊숙한 곳까지 파고들었다...
		ENDIF
	ENDIF
ELSE
	;抜かず
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"에게")% 네 발로 기게 하고, %HIS_HER(TARGET)%의 허리를 잡은 뒤 정액을 %HIS_HER(TARGET)%의 질에 쏟아내며 격렬하게 박기 시작한다...
		ELSEIF TCVAR:102
			PRINTFORML 당신이 %CALLNAME:TARGET%에 사정하고, 당신의 %TINKO(PLAYER)%가 벌떡되기 전에 다시 허리를 움직이기 시작한다...
		ELSEIF TEQUIP:体位２ == 2
			;調教者についてる
			IF TALENT:PLAYER:2 & 2
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부의 감촉을 느끼며, 다시 허리를 움직이기 시작했다…
				;ペニスバンドを使用している場合
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부에서 빼지 않고, 다시 허리를 움직이기 시작했다...
			ENDIF
		ELSE
			PRINTFORML %CALLNAME:TARGET%안에 삽입된 채, 당신은 %HIM_HER(TARGET)%을 네 발로 엎드리게 만들고 계속해서 밀어붙인다...
		ENDIF
	ELSE
		IF TALENT:処女 == 1
			PRINTFORML 네 발로 기게 한 %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 높이 들게 하고
			PRINTFORML 남을 모르는\@ TALENT:体型 < 0 ? 어린 여자 # 비밀 \@를 %TINKO(PLAYER)%로 관통했다...
		ELSEIF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
			PRINTFORML %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%에서 %TINKO(PLAYER)%를 빼는 동시에
			PRINTFORML %CALLNAME:TARGET%에 삽입했다...
		ELSE
			PRINTFORM 당신은 모든 사족으로 %조사처리(CALLNAME:TARGET,"를")% 아래로 누른다
			IF TEQUIP:0 & 2
				PRINTFORM , 움직여서 %HIS_HER(TARGET)% %TOLOWER(SHOW_BOTTOM(TARGET,2))% 옆으로 치우고,
			ELSEIF TEQUIP:0 & 1
				PRINTFORM , 뒤집혔다 %HIS_HER(TARGET)% %TOLOWER(SHOW_BOTTOM(TARGET,1))%,
			ENDIF
			PRINTFORM  그리고 모두 %조사처리(CALLNAME:TARGET,"의")% 안으로 밀어 넣었다. 
			;潤滑LV4以上
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINT 축축하게 젖어 있었다. 
			;小柄体型
			IF TALENT:体型 < 0
				PRINTFORM %COND_STR(@"and ", PALAM:潤滑 >= PALAMLV:4)%미숙한 슬릿
			ELSE
				PRINT 틈
			ENDIF
			PRINTFORML  뒤에서부터...
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;322,相手主導後背位
;-------------------------------------------------

@MESSAGE_COM322
IF TALENT:処女 == 1
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 당신의 %TINKO(MASTER)% 머리를 %HIS_HER(TARGET)% 처녀인 \@ TALENT:体型 < 0 ? young 슬릿 # 틈 \@에 맞추고 밀어 넣기 시작한다.
	PRINTFORML 그것은 천천히 퍼지며 %HIS_HER(TARGET)% 입술을 벌리고 더 깊숙이 밀어 넣으며, 터뜨리기 전에 %HIS_HER(TARGET)% 처녀성
	SIF TALENT:恋慕
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 매달리는 %HE_SHE(TARGET)%의 고통을 견딘다...
ELSE
	PRINTFORML 당신은 %CALLNAME:TARGET%위로 걸터앉아 꿈틀거리고 탐욕스러운 구멍인 %HIS_HER(TARGET)% 안으로 귀두를 밀어 넣는다...
	SELECTCASE ABL:TARGET:膣
		CASE 0
			PRINTFORML 당신은 %TINKO()%을 %HIS_HER(TARGET)%의 좁고 단단한 구멍에 밀어 넣으며, 그것을 벌리고 깊숙이 안으로 손을 뻗었다...
		CASE 1
			PRINTFORML 당신은 %TINKO()%을/를 %조사처리(CALLNAME:TARGET,"의")% 아직 약간 뻣뻣한 안쪽에 박아 넣는다.
		CASE 2,3
			PRINTFORML 너는 네 %TINKO()%을 %조사처리(CALLNAME:TARGET,"의")% 단단한 안쪽으로 깊숙이 밀어 넣는다...
		CASEELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 따뜻한 안쪽이 당신의 %TINKO()% 주위로 녹아들며, 힘들이지 않고 깊숙이 밀어 넣도록 초대하고 허락한다.
	ENDSELECT
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 따뜻한 안쪽에 싸인 채, 당신의 %TINKO()%는 자신이 있어야 할 곳임을 알며 흥분하여 움찔거린다...
ENDIF
