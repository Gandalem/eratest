; Modular ERB: EVENT_MESSAGE_挿入系COM/EVENT_MESSAGE_Ａ騎乗位する.ERB
;-------------------------------------------------
;94,Ａ騎乗位する
;-------------------------------------------------

@MESSAGE_COM94
CALL MESSAGE_COM94_TR
RETURN
;抜かずに
IF FLAG:70 == 1
	IF TCVAR:PLAYER:101 == TARGET && TARGET == TFLAG:103
		;対象が射精
		IF NOWEX:TARGET:射精
			PRINTFORM %조사처리(CALLNAME:PLAYER,"는")%
			IF ABL:PLAYER:Ａ感覚 >= 3
				PRINTFORML 스스로 허리를 음란하게 비틀며, 직장에서 전해지는 쾌락을 탐하고 있었다.
			ELSE
				PRINTFORML 필사적으로 허리를 흔들며, %조사처리(CALLNAME:TARGET,"의")% 남성기에게 봉사하고 있다.
			ENDIF
			PRINTFORML 이윽고 시간이 멈춘 채 %조사처리(CALLNAME:TARGET,"는")% %TINKO(TARGET)%만을 절정에 이르게 하고, %조사처리(CALLNAME:PLAYER,"의")% 직장에 정액을 쏟아부었다...
			;調教者も射精
			SIF NOWEX:PLAYER:射精
				PRINTFORML 동시에 %조사처리(CALLNAME:PLAYER,"의")% 끝에서도 뜨거운 백탁이 터져 공중을 날았다...
			;前ターンでＡ中出し
		ELSEIF TCVAR:PLAYER:104
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈춘 채 사정했던 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%를 개방하지 않고, 다시 허리를 흔들기 시작한다.
			PRINTFORML 넘쳐흐른 정액과 장액은 접합부를 적시고, 질척질척 더러운 흰 실을 만들었다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈춘 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%를 개방하지 않고, 다시 허리를 움직이기 시작했다...
		ENDIF
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 시간을 멈춘 %조사처리(CALLNAME:TARGET,"를")% 등을 대고 누운 채 허리에 걸터앉는다.
		SIF TEQUIP:PLAYER:0 & 2
			PRINTFORM %SHOW_BOTTOM(PLAYER,2)%의 틈 사이로
		IF EXP:PLAYER:Ａ経験 >= EXPLV:4
			PRINTFORML 이미 부드럽게 녹아버린 항문으로 %TINKO(TARGET)%을 삼켰다.
		ELSEIF EXP:PLAYER:Ａ経験 >= EXPLV:3
			PRINTFORML 겸손하게 입을 열고 아널로 %TINKO(TARGET)%을 삼켰다
		ELSE
			PRINTFORML 아직 이물질을 거부하려는 항문으로 %TINKO(TARGET)%을 삼켰다.
		ENDIF
		;ちんちん
		IF TALENT:TARGET:2 & 2
			PRINTFORM 열을 띤 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%가
			;にせちん
		ELSE
			PRINTFORM 무기질적인 페니스밴드가
		ENDIF
		PRINTFORML 장벽을 휘젓는 감각에, %조사처리(CALLNAME:PLAYER,"는")% 신음하고 있다...
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	IF TCVAR:PLAYER:101 == TARGET && TARGET == TFLAG:103
		;対象が射精
		IF NOWEX:TARGET:射精
			PRINTFORM %조사처리(CALLNAME:PLAYER,"는")%
			IF ABL:PLAYER:Ａ感覚 >= 3
				PRINTFORML 스스로 허리를 음란하게 흔들며, 직장에서 전해지는 쾌락을 탐하고 있다.
			ELSE
				PRINTFORML 필사적으로 허리를 흔들며, %조사처리(CALLNAME:TARGET,"의")% 남성기에 봉사하고 있다.
			ENDIF
			PRINTFORML 이윽고 잠든 채 범해지고 있던 %조사처리(CALLNAME:TARGET,"는")% %TINKO(TARGET)%를 절정에 이르게 하고, %조사처리(CALLNAME:PLAYER,"의")% 직장에 정액을 주입했다...
			;調教者も射精
			SIF NOWEX:PLAYER:射精
				PRINTFORML 동시에 %조사처리(CALLNAME:PLAYER,"의")% 끝에서도 뜨거운 흰 액이 터져 허공을 날았다...
			;前ターンでＡ中出し
		ELSEIF TCVAR:PLAYER:104
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 잠든 채 사정했던 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%를 방출하지 않고, 다시 허리를 흔들기 시작한다.
			PRINTFORML 넘쳐흐른 정액과 장액은 접합부를 적시고, 질척질척 더러운 하얀 실을 만들었다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 잠들어 있는 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%를 열지 않고, 다시 허리를 움직이기 시작했다...
		ENDIF
	ELSE
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")% 잠들어 있는%조사처리(CALLNAME:TARGET,"를")% 등을 대고 누운 채 허리에 걸터앉는다.
		SIF TEQUIP:PLAYER:0 & 2
			PRINTFORM %SHOW_BOTTOM(PLAYER,2)%의 틈 사이로
		IF EXP:PLAYER:Ａ経験 >= EXPLV:4
			PRINTFORML 이미 부드럽게 녹아버린 항문으로 %TINKO(TARGET)%을 삼켰다.
		ELSEIF EXP:PLAYER:Ａ経験 >= EXPLV:3
			PRINTFORML 겸손하게 입을 열고 아널로 %TINKO(TARGET)%을 삼켰다
		ELSE
			PRINTFORML 아직 이물을 거부하려는 항문으로 %TINKO(TARGET)%을 삼켰다.
		ENDIF
		;ちんちん
		IF TALENT:TARGET:2 & 2
			PRINTFORM 열을 띤 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%가
			;にせちん
		ELSE
			PRINTFORM 무기질적인 페니스밴드가
		ENDIF
		PRINTFORML 장벽을 휘젓는 감각에, %조사처리(CALLNAME:PLAYER,"는")% 신음하고 있다...
	ENDIF
ELSE
	IF TCVAR:PLAYER:101 == TARGET && TARGET == TFLAG:103
		;対象が射精
		IF NOWEX:TARGET:射精
			PRINTFORM %조사처리(CALLNAME:PLAYER,"는")%
			IF ABL:PLAYER:Ａ感覚 >= 3
				PRINTFORML 스스로 허리를 음란하게 비틀며, 직장에서 전해지는 쾌락을 탐하고 있다.
			ELSE
				PRINTFORM 필사적으로 허리를 흔들며, %조사처리(CALLNAME:TARGET,"의")%
				IF TALENT:TARGET:2 & 2
					PRINTFORM %TINKO(TARGET)%
					;にせちん
				ELSE
					PRINTFORM 페니스밴드
				ENDIF
				PRINTL ~에게 봉사하고 있다.
			ENDIF
			PRINTFORM 이윽고 도달한 %조사처리(CALLNAME:TARGET,"는")% 파르르 떨며, %조사처리(CALLNAME:PLAYER,"의")% 직장에 정액을 쏟아부었다.
			;調教者も射精
			SIF NOWEX:PLAYER:射精
				PRINTFORM 동시에 %조사처리(CALLNAME:PLAYER,"의")% 끝에서도 뜨거운 흰 액이 터져 공중을 날았다.
			PRINTFORML …
			;前ターンでＡ中出し
		ELSEIF TCVAR:PLAYER:104
			PRINTFORM %조사처리(CALLNAME:PLAYER,"는")%%조사처리(CALLNAME:TARGET,"에게")% 밀리면서 항문을 꽉 조이고 있다.
			PRINTFORM 흘러넘친 정액과 장액이 접합부를 적시고, 질척질척 더러운 흰 실을 만들었다...
		ELSE
			PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"의")%
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 를 조이며, 음란하게 허리를 흔들고 있다.
		ENDIF
	ELSE
		PRINTFORM %조사처리(CALLNAME:PLAYER,"는")% %조사처리(CALLNAME:TARGET,"에게")%
		IF ABL:サドっ気 >= 3
			PRINTFORM 명을 받든 대로
		ELSE
			PRINTFORM 부탁받은 대로
		ENDIF
		PRINTFORM 허리에 걸터앉아, 항문을
		IF TALENT:TARGET:2 & 2
			PRINTFORM %TINKO(TARGET)%
			;にせちん
		ELSE
			PRINTFORM 페니스밴드
		ENDIF
		PRINTFORML 끝부분에 눌렀다
		SIF TEQUIP:PLAYER:0 & 2
			PRINTFORM %SHOW_BOTTOM(PLAYER,2)%의 틈 사이로
		IF EXP:PLAYER:Ａ経験 >= EXPLV:4
			PRINTFORM 이미 부드럽게 녹아버린 항문이, %조사처리(CALLNAME:TARGET,"의")%
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 살짝 깨무는 듯이 먹어간다.
		ELSEIF EXP:PLAYER:Ａ経験 >= EXPLV:3
			PRINTFORM 시작된 항문에 천천히
			IF TALENT:TARGET:2 & 2
				PRINTFORM %TINKO(TARGET)%
				;にせちん
			ELSE
				PRINTFORM 페니스밴드
			ENDIF
			PRINTFORML 이 삽입되어 온다
		ELSE
			PRINTFORML 아직 이물질이 될 수 없는 항문을 강제로 관통당하고, %조사처리(CALLNAME:MASTER,"는")% 고통의 울음을 흘렸다.
		ENDIF
		;ちんちん
		IF TALENT:TARGET:2 & 2
			PRINTFORM 열을 띤 %조사처리(CALLNAME:TARGET,"의")% %TINKO(TARGET)%가
			;にせちん
		ELSE
			PRINTFORM 무기질적인 페니스밴드가
		ENDIF
		PRINTFORML 장벽을 휘젓는 감각에, %조사처리(CALLNAME:PLAYER,"는")% 신음하고 있다...
	ENDIF
ENDIF
