; Modular ERB: EVENT_MESSAGE_挿入系COM/EVENT_MESSAGE_正常位.ERB

@MESSAGE_COM60_1
;-------------------------------------------------
;60,正常位（シラフ）
;-------------------------------------------------
;Custom code, override
CALL MESSAGE_COM60_1_TR
RETURN
IF TFLAG:193
	;抜かず
	IF TCVAR:V挿入管理フラグ == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML %조사처리(CALLNAME:TARGET,"를")% \@ OPENPLACE(CFLAG:MASTER:現在位置) == 2 ? 허리를 감싸 안고 # 벽에 밀어붙이며 \@격렬하게 골반을 움직였다.
			PRINTFORML 사정의 순간에 %TINKO(PLAYER)%를 질 깊숙한 곳까지 박아 넣었다...
		ELSEIF TCVAR:102
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 안에 정액을 주입하는 것을 마치자,
			PRINTFORML %TINKO(PLAYER)%가 경도를 잃기 전에 다시 허리를 움직이기 시작했다...
		ELSEIF TEQUIP:体位２ == 1
			;調教者についてる
			IF TALENT:PLAYER:2 & 2
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부의 감촉을 느끼며, 다시 허리를 움직이기 시작했다…
				;ペニスバンドを使用している場合
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부에서 빼지 않고, 다시 허리를 움직이기 시작했다...
			ENDIF
		ELSE
			IF TEQUIP:体位２ == 1
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 안에서 %TINKO(PLAYER)%를 빼내지 않고 다시 허리를 움직이기 시작했다...
				;背面立位から
			ELSE
				PRINTFORML 일단 %CALLNAME:TARGET%에서 %TINKO(PLAYER)%를 빼고 이쪽으로 돌아보게 한 뒤에
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 한쪽 다리를 들어 삽입하고 다시 허리를 움직이기 시작했다…
			ENDIF
		ENDIF
	ELSEIF TALENT:処女 == 1
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 한쪽 다리를 들어 %SLIT(TARGET)%에
		PRINTFORML 귀두를 대고 단숨에 관통했다...
	ELSE
		IF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
			PRINTFORML %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%에서 %TINKO(PLAYER)%를 빼는 동시에
			PRINTFORML %CALLNAME:TARGET%에 삽입했다...
		ELSE
			PRINTFORM %조사처리(CALLNAME:TARGET,"의")% 한쪽 다리를 들어 올리며
			SIF TEQUIP:0 & 2
				PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
			PRINTFORML %SLIT(TARGET)%에 %TINKO(PLAYER)%를 대고 관통했다...
		ENDIF
		IF TALENT:恋慕
			IF TALENT:処女
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 고통을 참으며 %조사처리(CALLNAME:PLAYER,"에게")% 꼭 안겼다...
			ENDIF
		ENDIF
	ENDIF
	;正常位
ELSE
	;抜かず
	IF TCVAR:100 == PLAYER && TARGET == TFLAG:103
		IF NOWEX:MASTER:射精
			PRINTFORML 등을 대고 누운 %조사처리(CALLNAME:TARGET,"에게")% 덮치며 허리를 흔들었고,
			PRINTFORML 사정하는 순간 %TINKO(PLAYER)%를 질 깊숙한 곳까지 밀어 넣었다...
		ELSEIF TCVAR:102
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 안에 정액을 주입하는 것을 마치자,
			PRINTFORML %TINKO(PLAYER)%가 경도를 잃기 전에 다시 허리를 움직이기 시작했다...
		ELSEIF TEQUIP:体位２ == 1
			;調教者についてる
			IF TALENT:PLAYER:2 & 2
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부의 감촉을 느끼며, 다시 허리를 움직이기 시작했다…
				;ペニスバンドを使用している場合
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 질 내부에서 빼지 않고, 다시 허리를 움직이기 시작했다...
			ENDIF
		ELSE
			PRINTFORML 질 안에서 빼내지 않고 %조사처리(CALLNAME:TARGET,"를")% 등을 대고 눕힌 채 다시 허리를 움직이기 시작했다...
		ENDIF
	ELSE
		IF TALENT:処女 == 1
			PRINTFORML 등을 대고 누운 %조사처리(CALLNAME:TARGET,"의")% 다리를 벌리고 귀두를 얕게 삽입한 후,
			PRINTFORML %SLIT(TARGET)%를 관통했다...
		ELSEIF MASTER_POSE(SET_V,SET_P,1) && MASTER_POSE(SET_V,SET_P,1) != TARGET
			PRINTFORML %CALLNAME:(MASTER_POSE(SET_V,SET_P,1))%에서 %TINKO(PLAYER)%를 빼는 동시에
			PRINTFORML %CALLNAME:TARGET%에 삽입했다...
		ELSE
			PRINTFORM 등을 대고 누운 %조사처리(CALLNAME:TARGET,"의")%
			SIF TEQUIP:0 & 2
				PRINTFORM %SHOW_BOTTOM(TARGET,2)%을 치우고,
			PRINTFORML %SLIT(TARGET)%에 %TINKO(PLAYER)%를 대고 관통했다...
		ENDIF
		IF TALENT:恋慕
			IF TALENT:処女 && TALENT:処女 != -1
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 고통을 참으며 %조사처리(CALLNAME:PLAYER,"에게")% 꼭 안겼다...
			ENDIF
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;320,相手主導正常位
;-------------------------------------------------

@MESSAGE_COM320
IF TALENT:処女 == 1
	PRINTFORML %CALLNAME:TARGET%당신의 머리를 정렬한다 %TINKO(MASTER)% ~와 함께 %HIS_HER(TARGET)% 처녀의 \@ TALENT:体型 < 0 ? 젊은 슬릿 # 틈 \@ 그리고 그것을 밀어 넣기 시작한다.
	PRINTFORML 그것은 천천히 퍼지며 %HIS_HER(TARGET)% 입술을 벌리고 더 깊숙이 밀어 넣으며 %HIS_HER(TARGET)% 순결을
	SIF TALENT:恋慕
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 매달리는 %HE_SHE(TARGET)%의 고통을 견딘다...
ELSE
	PRINTFORML 너는 %CALLNAME:TARGET%위에 매달려 그녀의 탐욕스럽고 떨리는 구멍 속으로 천천히 귀두를 밀어 넣는다...
	SELECTCASE ABL:TARGET:膣
		CASE 0
			PRINTFORML 당신은 %TINKO()%을 %HIS_HER(TARGET)%의 좁고 단단한 구멍에 밀어 넣으며, 그것을 벌리고 깊숙이 안으로 손을 뻗었다...
		CASE 1
			PRINTFORML 당신은 %TINKO()%을/를 %조사처리(CALLNAME:TARGET,"의")% 아직 약간 뻣뻣한 안쪽에 박아 넣는다.
		CASE 2,3
			PRINTFORML 너는 네 %TINKO()%을 %조사처리(CALLNAME:TARGET,"의")% 단단한 안쪽으로 깊숙이 밀어 넣는다...
		CASEELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 따뜻한 안쪽이 당신의 %TINKO()% 주위로 녹아들며, 힘들이지 않고 깊숙이 밀어 넣도록 초대하고 허락한다.
	ENDSELECT
	PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 따뜻한 안쪽에 싸인 채, 당신의 %TINKO()%는 자신이 있어야 할 곳임을 알며 흥분하여 움찔거린다...
ENDIF
