						PRINTFORML %CALLNAME:TARGET%주변에 사람들이 있다는 것을 신경 쓰지 않고 끌어내린다 %HIS_HER(TARGET)% %SHOW_BOTTOM(TARGET)% 위에 %HIS_HER(TARGET)% 자신의 것으로 과시하며 %UNDER_SKIRT_DESCRIPTION_TR(TARGET,1)%...
					ELSE
						PRINTFORML %CALLNAME:TARGET%주변에 사람들이 있다는 것을 신경 쓰지 않고 들어 올리며 %HIS_HER(TARGET)% %SHOW_BOTTOM(TARGET,1)% 위에 %HIS_HER(TARGET)% 자신의 것으로 자랑하며 %UNDER_SKIRT_DESCRIPTION_TR(TARGET,1)%...
					ENDIF
					SIF PALAM:欲情 > PALAMLV:4
						PRINTFORML %TNAME(TARGET, 1,,1)%눈이 초점이 없고, 마치 무언가를 기대하는 듯 당신을 응시한다...
					;潤滑LV4以上
					IF PALAM:潤滑 > PALAMLV:4
						PRINTFORML 넓게 퍼지는, %TNAME(TARGET,,,1)% 비밀스러운 곳에서 풍겨 나오는 향이 흘러나오면서 연모의 액체와 섞인다...
					ELSEIF PALAM:潤滑 > PALAMLV:2
						PRINTFORML 넓게 퍼진 %TNAME(TARGET,,,1)% 비밀스러운 장소에서 풍겨오는 향기가 욕망으로 공기를 채운다...
					ENDIF
				ELSE
					IF EQUIP:TARGET:ズボン
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 노출되는 것이 걱정되어 %HIS_HER(TARGET)% %SHOW_BOTTOM(TARGET)%을 누르고 있지만, 힘이 별로 없다.
						PRINTFORM %조사처리(CALLNAME:TARGET,"의")% %SHOW_BOTTOM(TARGET)%이 아래로 당겨진다. 
					ELSE
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 보이고 싶지 않아 %HIS_HER(TARGET)% %SHOW_BOTTOM(TARGET,1)%을 누르고 있지만, 힘이 별로 없다.
						PRINTFORM %조사처리(CALLNAME:TARGET,"의")% %SHOW_BOTTOM(TARGET,1)%이 뒤집혔다. 
					ENDIF
					IF !CFLAG:291
						IF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ
							PRINTFORML 그리고 %HE_SHE(TARGET)%이 아무것도 입고 있지 않으니, 너는 %HIS_HER(TARGET)%를 통해 %LOCALS%로 만들 수 있고 다시 %HIS_HER(TARGET)%와 %SHOW_下半身下着(TARGET,3)%를 통해서도 만들 수 있다...
						ELSEIF EQUIP:TARGET:下半身下着１ || EQUIP:TARGET:下半身下着２
							;Custom code
							PRINTFORML 그리고 %HIS_HER(TARGET)%과 %PANTS_DESCRIPTION_TR(TARGET)%가 보일 수 있다...
						ELSE
							PRINTFORML 하지만 %HE_SHE(TARGET)%이 속옷을 입고 있지 않아서, %HIS_HER(TARGET)% %LOCALS%은(는) %COND_STR(@"s", !HAS_PENIS(TARGET))% 플래시를 당한다...
						ENDIF
					ELSE
						IF EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ
							PRINTFORML 하지만 %HIS_HER(TARGET)% 아래에서도, %LOCALS:1%는 %HE_SHE(TARGET)%이 %SHOW_下半身下着(TARGET,3)%를 저주하고 있다...
						ELSE
							PRINTFORML 하지만 %HE_SHE(TARGET)%이 속옷을 입고 있지 않아서, %HIS_HER(TARGET)%의 %LOCALS%가 %COND_STR(@"s", !HAS_PENIS(TARGET))% 플래시를 당한다...
						ENDIF
					ENDIF
				ENDIF
				TFLAG:400 = RAND:2
				SIF TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)
					CALL DATE_HITOGOMI_MESSAGE()
			ENDIF
			RESETCOLOR
	ENDSELECT
ENDIF
