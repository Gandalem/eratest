@DATE_HITOGOMI_MESSAGE(ARG)
SIF !ARG
	ARG = CFLAG:PLAYER:現在位置
IF FLAG:70 ;custom code
	TFLAG:400 = 0
	RETURN 0
ENDIF
;外出先地霊殿および地底内地霊殿
IF (MAIN_MAP !=9 && ARG == 960) || (IN_HOME(ARG) && !CHK_FOCUS(927,CFLAG:MASTER:現在位置,948) && (ROOMDATA:(CFLAG:MASTER:現在位置 % 100) & 場所_モブ))
	IF GROUPMATCH(TIME:2,1,6,7)
		PRINTFORMDL 근처에서 자고 있는 %ANIMALNAME()%이 시끄럽게 코를 고르고 있다...
	ELSE
		PRINTFORMD 근처에 %ANIMALNAME()% 
		SELECTCASE TIME:1 % 25
			;小型哺乳類
			CASE 0 TO 7
				SELECTCASE RAND:4
					CASE 3
						PRINTFORMDL 그것은 당신에게 몸을 비빈다.
					CASE 2
						PRINTFORMDL 당신을 호기심 가득한 눈으로 바라본다.
					CASE 1
						PRINTFORMDL 발을 당신 쪽으로 뻗는다.
					CASE 0
						PRINTFORMDL \@ INROOM(CFLAG:MASTER:現在位置) ? 바닥을 긁는다. # 바닥을 두드린다. \@.
				ENDSELECT
				;大型哺乳類
			CASE 8 TO 13
				SELECTCASE RAND:4
					CASE 3
						PRINTFORMDL 호기심을 느끼며 당신 쪽으로 얼굴을 내밀고 있다.
					CASE 2
						PRINTFORMDL 보기에 당신을 똑바로 응시하고 있다.
					CASE 1
						PRINTFORMDL 살짝 흔들린다.
					CASE 0
						PRINTFORMDL %PRINT_OUTSIDE("floor")%을 두드린다.
				ENDSELECT
				;超大型哺乳類（屋内にはいってこれないんじゃないのか？
			CASE 14 TO 15
				SELECTCASE RAND:2
					CASE 1
						PRINTFORMDL 위에서 당신을 응시한다.
					CASE 0
						PRINTFORMDL 발을 땅에 '쿵' 하고 세게 구른다.
				ENDSELECT
				;鳥類
			CASE 16 TO 20
				SELECTCASE RAND:5
					CASE 4
						IF TIME:1 % 25 == 18 ;shoebill
							PRINTFORMDL 완전히 움직이지 않고 가만히 있다.
						ELSE
							PRINTFORMDL 그것의 날개를 \@ TIME:1 % 25 > 18 ? 파닥거리며 # 부드럽게 흔들며 \@ 친다.
						ENDIF
					CASE 3
						IF TIME:1 % 25 == 18
							PRINTFORMDL 완전히 움직이지 않고 가만히 있다.
						ELSE
							PRINTFORMDL \@ TIME:1 % 25 > 18 ? is squawking loudly # is %SPLIT_G("chirping:chittering")%이 울고 있다. \@.
						ENDIF
					CASE 2
						IF TIME:1 % 25 == 18
							PRINTFORMDL 완전히 움직이지 않는다.
						ELSE
							PRINTFORMDL 바로 당신에게 다가와서 쓰다듬어 달라는 듯 머리를 내민다.
						ENDIF
					CASE 1
						IF TIME:1 % 25 == 18
							PRINTFORMDL 완전히 움직이지 않고 가만히 있다.
						ELSE
							PRINTFORMDL 사방을 돌아다니고 있다.
						ENDIF
					CASE 0
						IF TIME:1 % 25 == 18
							PRINTFORMDL 당신의 인사에 깊이 고개를 숙인다.
						ELSE
							PRINTFORMDL 당신을 위협하려 하고 있다.
						ENDIF
				ENDSELECT
				;爬虫類
			CASE 21 TO 24
				SELECTCASE RAND:3
					CASE 2 ;python
						PRINTFORMDL \@ TIME:1 % 25 == 23 ? 기어가며 다가온다 # 뒤뚱거리며 다가온다 \@은 당신 옆으로 다가와 길게 응시한다.
					CASE 1
						PRINTFORMDL 위협하려는 시도로 입을 연다.
					CASE 0
						PRINTFORMDL 왼쪽과 오른쪽으로 흔들리고 있으며, 별로 관심이 없는 듯하다.
				ENDSELECT
		ENDSELECT
	ENDIF
ELSEIF IN_HOME(ARG) && CHK_FOCUS(927,CFLAG:MASTER:現在位置,930) && (ROOMDATA:(CFLAG:MASTER:現在位置 % 100) & 場所_モブ)
	PRINTFORMD 근처의 원한을 품은 정령 
	SELECTCASE RAND:5
		CASE 4
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"에게")% 다가가려 했지만, 당신이 그것을 쫓아낸다.
		CASE 3
			PRINTFORMDL 응시하다 %조사처리(CALLNAME:TARGET,"를")%, 점점 가까이 다가오다가 갑자기 떠버린다.
		CASE 2
			PRINTFORMDL 주변을 떠다닌다 %CALLNAME:TARGET%잠시 동안 날아가기 전에
		CASE 1
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"를")% 보면 활기를 띠지만, 당신에 대해서는 걱정스러워 보인다.
		CASE 0
			PRINTFORMDL 그저 목적 없이 떠다니며 %CALLNAME:TARGET%에 전혀 신경 쓰지 않는다.
	ENDSELECT
ELSE
	;addition custom code
	PRINTFORMD A %DATE_HITOGOMI_SYUBETU(CFLAG:PLAYER:現在位置)% \@ CFLAG:PLAYER:現在位置 == 寺子屋 ? 절에서 학교에 다니고 있다. # 그 지역에서 \@ 
	SELECTCASE RAND:7
		CASE 6
			PRINTFORMDL 눈을 크게 뜨고 충격받은 기색으로 바라본다.
		CASE 5
			PRINTFORMDL 서둘러 시선을 돌린다.
		CASE 4
			PRINTFORMDL 자꾸만 쳐다보게 된다.
		CASE 3
			PRINTFORMDL 놀란 표정으로 지켜본다.
		CASE 2
			PRINTFORMDL 계속 당신 둘을 흘긋흘긋 본다.
		CASE 1
			PRINTFORMDL 얼굴을 붉히며 시선을 돌린다.
		CASE 0
			PRINTFORMDL 믿을 수 없다는 듯 눈을 비빈다.
	ENDSELECT
ENDIF
