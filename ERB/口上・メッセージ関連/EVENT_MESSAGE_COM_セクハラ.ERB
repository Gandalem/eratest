; Modular ERB: EVENT_MESSAGE_COM_セクハラ.ERB
;-------------------------------------------------
;310,尻を撫でる
;-------------------------------------------------

@MESSAGE_COM310
IF FLAG:70 == 1
	PRINTFORML %ONGOING_NAME(MASTER)%당신의 손을 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)% 쪽으로 뻗는다.
	PRINTFORML 시간이 정지된 채, %조사처리(CALLNAME:TARGET,"는")% 당신이 %HIS_HER(TARGET)%의 엉덩이를 어루만지는 동안 저항하지 못한다...
ELSEIF CFLAG:TARGET:睡眠 == 1
	PRINTFORML %ONGOING_NAME(MASTER)%잠자고 있는 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%에게 손을 내민다.
	IF TALENT:恋慕
		PRINTFORML 너는 계속해서 %조사처리(CALLNAME:TARGET,"의")% 간호를 하자, 그가 살짝 얼굴을 붉힌다.
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 잠에 빠져 %HIS_HER(TARGET)%에서 몸을 뒤척이고 네 손을 쳐낸다.
	ENDIF
ELSE
	IF CFLAG:うふふ == 2
		PRINTFORM %ONGOING_NAME(MASTER)% 
		SELECTCASE TCVAR:20
			;クンニ強制
			CASE 70
				IF !TEQUIP:0
					PRINTFORML 마사지해 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)% 천천히 자극하면서 %HIS_HER(TARGET)% %SLIT(TARGET)% 혀로...
				ELSE
					GOTO NOMALSIRINADE
				ENDIF
				;アナル奉仕
			CASE 72
				IF !TEQUIP:0
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 볼을 벌려서 당신의 혀로 %HIS_HER(TARGET)% 항문에 더 쉽게 침투할 수 있게 한다... 
				ELSE
					GOTO NOMALSIRINADE
				ENDIF
				;スカートの中を見せる
			CASE 35
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 엉덩이를 더 가깝게 돌리고 비비기 시작한다...
				;素股
			CASE 52
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)% 위에서 걸터앉아 뒤쪽 %HIS_HER(TARGET)%를 어루만진다...
			CASEELSE
				$NOMALSIRINADE
				;シックスナイン パンツ有り顔面騎乗(70～72)はこちら
				SIF TEQUIP:シックスナイン
					PRINTFORM 얼굴 위에 걸터앉은 
				PRINTFORM %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%를 문지른다.
		ENDSELECT
	ELSE
		PRINTFORML %ONGOING_NAME(MASTER)%이/가 %조사처리(CALLNAME:TARGET,"의")% %HIP(TARGET)%을 향해 손을 뻗는다 \@ PREVCOM == 305 ? %HIS_HER(TARGET)% 위에서 누운 채 뒤쪽에서 #  \@.
		SELECTCASE TFLAG:193
			CASE -5 ;custom code - added text for special reactions
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 깜짝 놀라 잠시 비명을 지르며 얼어붙은 뒤 당신의 뺨을 때린다.
			CASE -3 ;custom code
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 평정심을 되찾기 전에 숨을 들이마신 후 고통스럽게 %PARSE("your")% 손을 비튼다.
				;-------------------
			CASE 1
				IF TALENT:TARGET:10 == -1
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 눈가에 눈물이 고인다, %HE_SHE(TARGET)%는 당신의 괴롭힘을 견디며.
					PRINTFORML 당신은 약간 죄책감을 느낀다...
				ELSE
					PRINTFORML %HIS_HER(TARGET)%의 얼굴에 분명한 불쾌함을 드러내며, %조사처리(CALLNAME:TARGET,"는")% 즉시 당신의 손을 쳐낸다...
				ENDIF
			CASE 2,3
				IF OTOKOGIRAI(TARGET)
					PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HE_SHE(TARGET)%가 점프하자 작은 비명을 지른다.
					PRINTFORML 당신은 약간 죄책감을 느낀다...
				ELSE
					PRINTFORM 
					IF TARGET == 57 && !TALENT:恋慕
						PRINTFORM 사루 가면이 떠다닌다 %CALLNAME:TARGET%
					ELSE
						PRINTFORM %조사처리(CALLNAME:TARGET,"가")% 얼굴을 붉힌다.
					ENDIF
					PRINTFORML  %HE_SHE(TARGET)%이 네 손을 뿌리치며...
				ENDIF
			CASE 4
				IF TARGET == 57 && !TALENT:恋慕
					PRINTFORM 사루와 오키나 가면이 떠다닌다 %CALLNAME:TARGET%
				ELSE
					PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 당황한 듯 얼굴을 붉힌다.
				ENDIF
				PRINTFORML  %HE_SHE(TARGET)%가 계속할 수 있게 해준다...
		ENDSELECT
		TFLAG:400 = RAND:2
		SIF TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)
			CALL DATE_HITOGOMI_MESSAGE(CFLAG:PLAYER:現在位置)
	ENDIF
ENDIF
;-------------------------------------------------
;311,抱き付く
;-------------------------------------------------

@MESSAGE_COM311
IF FLAG:70 == 1
	PRINTFORML %ONGOING_NAME(MASTER)%은 %조사처리(CALLNAME:TARGET,"를")% 꽉 껴안는다.
	PRINTFORML 시간이 멈춘 듯, %조사처리(CALLNAME:TARGET,"는")% %HE_SHE(TARGET)%에게 안겨 저항하지 못한다.
ELSEIF CHK_DATENOW(CFLAG:LOCAL:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	PRINTFORML \@ TFLAG:デート道中 ? 옆에서 걸으며 # 옆에 앉아 \@이 %CALLNAME:TARGET%일 동안, 너는 %HIM_HER(TARGET)%를 꽉 끌어안는다.
	PRINTFORM 
	IF TALENT:恋慕
		PRINTFORML %CALLNAME:TARGET% \@ TFLAG:デート道中 ? 그는 기분 좋게 놀란다. # 너를 다시 안아준다. \@...
	ELSEIF TALENT:思慕
		IF TARGET == 57 && !TALENT:恋慕
			PRINTFORM 원숭이 가면 하나가 %CALLNAME:TARGET%주변을 떠다닌다. 
		ELSE
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 약간 부끄러워 보인다. 
		ENDIF
		PRINTFORML 하지만 그것이 그것을 싫어하는 것 같지는 않다...
	ELSEIF ABL:親密 > 5
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 약간 놀라고, 조금 애쓰고 있다...
	ELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HIS_HER(TARGET)% 목소리를 높이며 당신을 밀쳐낸다.
	ENDIF
	TFLAG:400 = RAND:2
	SIF TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)
		CALL DATE_HITOGOMI_MESSAGE(CFLAG:PLAYER:現在位置)
ELSEIF CFLAG:うふふ == 2
	SELECTCASE TCVAR:20
		;前から抱きつく
		CASE 32
			PRINTFORM %ONGOING_NAME(MASTER)%과 %CALLNAME:TARGET% 
			IF TALENT:恋慕
				PRINTL 서로가 사랑하는 자만이 할 수 있는 방식으로 끌어안는다...
			ELSEIF TALENT:思慕
				PRINTL 서로를 단단히 끌어안는다...
			ELSEIF TALENT:愛欲
				PRINTL 서로를 끌어안으며, 몸을 밀착시킨다...
			ELSE
				PRINTL 서로를 끌어안는다...
			ENDIF
			;ディープキス
		CASE 60
			PRINTFORM %ONGOING_NAME(MASTER)% 그리고 %CALLNAME:TARGET% 
			IF TALENT:恋慕
				PRINTL 깊은 키스를 나누며 서로를 꼭 안았다...
			ELSEIF TALENT:愛欲
				PRINTL 서로를 깊고 욕망으로 가득 찬 키스를 나누며 꼭 끌어안는다...
			ELSE
				PRINTL 키스를 교환하며 서로를 안는다...
			ENDIF
			;ぱふぱふ
		CASE 73
			PRINTFORM %ONGOING_NAME(MASTER)% 
			IF TALENT:TARGET:バストサイズ >= 0
				SELECTCASE RAND:5
					CASE 0
						PRINTFORML 당신의 얼굴을 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET)%에 묻고, %HIS_HER(TARGET)%의 향긋한 냄새를 들이마신다...
					CASE 1
						PRINTFORML 당신의 얼굴을 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET)%에 비비다...
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HIS_HER(TARGET)%의 가슴이 주는 쾌락 속에서 꿈틀거린다...
					CASE 2
						PRINTFORML 빨아대다 %조사처리(CALLNAME:TARGET,"의")% 젖꼭지들...
						PRINTFORML %CALLNAME:TARGET%신음소리를 내며 %HE_SHE(TARGET)% ~로부터 오는 쾌감을 견딜 수 없는 %HIS_HER(TARGET)% 가슴들...
					CASE 3
						PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 부드러운 계곡에 얼굴을 파묻는다...
					CASE 4
						PRINTFORML 기쁘게 얼굴을 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET)% 깊숙이 파묻는다...
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 당신의 얼굴을 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET)%에 비비며, %HIS_HER(TARGET)%의 향기로운 냄새를 들이마셨다...
					CASE 1
						PRINTFORML 당신의 얼굴을 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET)%에 비빈다...
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HIS_HER(TARGET)%의 가슴이 주는 쾌감 속에서 몸부림친다...
					CASE 2
						PRINTFORML ..젖꼭지를 빨아라 %조사처리(CALLNAME:TARGET,"의")% 유두들...
						PRINTFORML %CALLNAME:TARGET%신음소리를 내며 %HE_SHE(TARGET)% ~로부터 오는 쾌감을 견디지 못하다 %HIS_HER(TARGET)% 가슴들...
				ENDSELECT
			ENDIF
			;乳合わせ
		CASE 74
			IF GETBIT(TALENT:MASTER:性別,1)
				PRINTFORML %ONGOING_NAME(MASTER)%당신의 몸을 %조사처리(CALLNAME:TARGET,"의")% %OPPAI_DESCRIPTION_TR(TARGET)%에 단단히 밀착시켜라...
			ELSE
				PRINTFORML %ONGOING_NAME(MASTER)% 껴안다 %CALLNAME:TARGET%젖꼭지가 서로 파고들 때...
			ENDIF
			;乳を吸わせる
		CASE 77
			LOCALS:0 = 
			SELECTCASE RAND:6
				CASE 0
					LOCALS:0 = 계속 빨아들인다
				CASE 1
					LOCALS:0 = 정말 별로다
				CASE 2
					LOCALS:0 = 장난스럽게 깨물었다.
				CASE 3
					LOCALS:0 = 입맛을 다시다
				CASE 4
					LOCALS:0 = 힘차게 핥는다
				CASE 5
					LOCALS:0 = 당신의 혀로 전부 문질러라
			ENDSELECT
			PRINTFORML %ONGOING_NAME(MASTER)% 안아주다 %CALLNAME:TARGET%놓지 않으려는 듯이 %HIM_HER(TARGET)% 놓지 않으려는 것처럼 %LOCALS:0% %조사처리(CALLNAME:TARGET,"의")% %NIPPLE_DESCRIPTION(TARGET)%.
			SELECTCASE RAND:6
				CASE 0
					IF TARGET == 57 && !TALENT:恋慕
						PRINTFORM 사루 가면이 떠다닌다 %CALLNAME:TARGET%
					ELSE
						PRINTFORM %조사처리(CALLNAME:TARGET,"는")% %HIS_HER(TARGET)%를 갈아댄다.
					ENDIF
					PRINTFORML  %HE_SHE(TARGET)%은(는) 그 즐거움을 견디려고 노력한다...
				CASE 1
					PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 달콤한 목소리를 내며 %HE_SHE(TARGET)%에게 닿을 때마다 점프한다...
				CASE 2
					PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 간헐적인 자극에서 신음한다.
				CASE 3
					PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HIS_HER(TARGET)% 가슴에서 오는 강렬한 쾌감으로 몸을 꿈틀거린다...
				CASE 4
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 머리카락은 완전히 헝클어져 있고 %HE_SHE(TARGET)%는 즐거움에 빠져 있다...
				CASE 5
					PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 즐거움을 참지 못하고 너를 꽉 껴안는다.
			ENDSELECT
			;85=Ｖ挿入する 87=Ａ挿入する 88=腰振りＶ 89=腰振りＡ
		CASE 85,87,88,89
			PRINTFORML %ONGOING_NAME(MASTER)% 껴안다 %CALLNAME:TARGET%꽉 안으며 흔들리는 %HIS_HER(TARGET)% 허리를 위아래로 흔들며.
			IF TALENT:TARGET:恋慕
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸은(는) 당신의 움직임에 맞춰 리듬을 타며 규칙적으로 움켜쥐고, 당신의 성기를 조이며 절정에 이르게 하려고 노력한다... \@ TCVAR:20 == 85 || TCVAR:20 == 88 ? 허니팟 # 장미봉오리 \@.
			ELSEIF TALENT:TARGET:愛欲
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% \@ TCVAR:20 == 85 || TCVAR:20 == 88 ? 꿀단지 # 장미 꽃봉오리 \@가 네 음경을 조여 사정하게 만들려 한다……
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% \@ TCVAR:20 == 85 || TCVAR:20 == 88 ? 허니팟이 넘쳐흐른다. # 장벽이 넘쳐흐른다. \@ with \@ TCVAR:20 == 85 || TCVAR:20 == 88 ? 사랑의 액체 # 장 내 액체 \@ 끝없는 격류 속에서...
			ENDIF
			;だいしゅきホールド
		CASE 86
			PRINTFORML %ONGOING_NAME(MASTER)%은 %조사처리(CALLNAME:TARGET,"를")% 꽉 껴안고 %HIM_HER(TARGET)% 안쪽으로 더 깊이 밀어 넣을 수 있도록 조절한다.
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 포옹을 되돌려주고 당신의 귓가에 사랑의 말을 속삭인다.
			SELECTCASE BASE:PLAYER:2
				CASE 10000
					PRINTFORML 당신은 자신의 %SAMEN_DESCRIPTION(PLAYER)%을 %조사처리(CALLNAME:TARGET,"의")% 자궁에 붓는다...
				CASEELSE
					PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 꿀단지 맛과 감촉을 음미한다...
			ENDSELECT
		CASEELSE
			GOTO NOMALDAKI
	ENDSELECT
ELSE
	$NOMALDAKI
	PRINTFORML %ONGOING_NAME(MASTER)%을/를 %CALLNAME:TARGET%꽉 안았다 %COND_STR(@" as you lay in bed", CFLAG:TARGET:添い寝中)%.
	IF CFLAG:TARGET:睡眠
		IF TALENT:恋慕
			PRINTFORML %CALLNAME:TARGET%당의 가슴에 파고들며 행복한 표정을 지은 채 %HIS_HER(TARGET)% 얼굴에...
		ELSEIF TALENT:思慕
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HIS_HER(TARGET)% 잠에서 너를 다시 껴안는다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 조금 꿈틀거리지만 깨어나지 않는다.
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 따뜻하게 포옹에 화답한다.
		ELSEIF TALENT:思慕
			IF TARGET == 57 && !TALENT:恋慕
				PRINTFORM 사루 가면이 떠다닌다 %CALLNAME:TARGET%
			ELSE
				PRINTFORM %조사처리(CALLNAME:TARGET,"가")% 약간 부끄러워 보인다.
			ENDIF
			PRINTL  하지만 그것을 싫어하는 것 같지는 않다...
		ELSEIF TALENT:幼児／幼児退行
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %HIS_HER(TARGET)%의 머리를 살짝 기울인다...
		ELSEIF TALENT:動物耳
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 발버둥 치며 몸을 비튼다.
		ELSE
			IF TARGET == 57 && !TALENT:恋慕
				PRINTFORM 시시구치 가면이 떠다닌다 %CALLNAME:TARGET%
			ELSE
				PRINTFORM %조사처리(CALLNAME:TARGET,"는")% 그것 때문에 매우 당황한 듯하다.
			ENDIF
			PRINTL ...
		ENDIF
	ENDIF
	TFLAG:400 = RAND:2
	SIF TFLAG:400 && (DATE_HITOGOMI() || WITH_MOB() == 9)
		CALL DATE_HITOGOMI_MESSAGE(CFLAG:PLAYER:現在位置)
ENDIF
;-------------------------------------------------
;312,キスする
;-------------------------------------------------

@MESSAGE_COM312
CALL ONGOING_END()
IF FLAG:70 == 1
	PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 입술에 키스한다.
	PRINTFORML 시간이 멈췄기 때문에 %조사처리(CALLNAME:TARGET,"는")% 키스를 저항할 수 없다...
ELSEIF CFLAG:TARGET:睡眠
	PRINTFORML 너는 잠든 %조사처리(CALLNAME:TARGET,"의")% 입술에 네 입을 가져다 댄다.
	IF ABL:親密 >= 5
		PRINTFORM 당신의 입술이 떨어지고 난 후 
		IF TARGET == 57 && !TALENT:恋慕
			PRINTFORML 오키나 가면 하나가 떠다닌다 %TNAME(TARGET)%...
		ELSE
			PRINTFORML %TNAME(TARGET)%살짝 미소 짓는다...
		ENDIF
	ELSEIF ABL:親密 >= 3
		PRINTFORM %TNAME(TARGET,1)%그것이 어색하다고 느낀다
		IF TARGET == 57 && !TALENT:恋慕
			PRINTFORML  그리고 시시구치 가면 하나가 공중에 걸려 있었다...
		ELSE
			PRINTFORML  그리고 %HIS_HER(TARGET)% 눈썹이 찌푸려진다...
		ENDIF
	ELSE
		LOCALS:0 = 
		IF TARGET == 57 && !TALENT:恋慕
			LOCALS:0 = 한텐가 가면이 %HIM_HER(TARGET)% 옆에 떠 있다.
		ELSE
			LOCALS:0 = 얼굴을 찡그린다
		ENDIF
		PRINTFORML %TNAME(TARGET,1)% 그리고 잠에 빠지면서 %LOCALS:0% 뒤에 %HIS_HER(TARGET)% 잠든다...
	ENDIF
ELSEIF CFLAG:TARGET:添い寝中
	PRINTFORML 당신은 침대에 누워 %조사처리(CALLNAME:TARGET,"의")% 입술에 자신의 입술을 맞댄다...
	IF ABL:親密 >= 8
		PRINTFORML %TNAME(TARGET,1)%당신에게 몸을 기울이며 키스를 되돌려준다...
	ELSEIF ABL:親密 >= 5
		PRINTFORML %TNAME(TARGET,1)% 홍조를 띠며 입술을 내밀고 %HIS_HER(TARGET)% 입술을 내며 키스에 응한다...
