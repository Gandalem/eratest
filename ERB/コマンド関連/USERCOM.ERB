ELSEIF RESULT == 850 && CFLAG:うふふ == 2
	SELECTCOM = RESULT
	TFLAG:3 = SELECTCOM
	DOTRAIN 999
	;居場所察知=============================================================================================================================
ELSEIF RESULT == 811 && TALENT:MASTER:居場所察知 && (GETBIT(TALENT:MASTER:居場所察知, 1) || !(CFLAG:うふふ || CFLAG:イタズラ || CFLAG:添い寝中 || CapacityStats:MASTER:3 <= 0)) ;qol custom code - at_home check removed
