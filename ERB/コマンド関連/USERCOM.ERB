		ELSE
			TEQUIP:焦らしモード = 1
		ENDIF
	ENDIF
	;過激なイタズラ（未実装）
	;Bug-fix
ELSEIF RESULT == 830 && CFLAG:イタズラ < 2 && (EXP:TARGET:睡眠姦経験 > 100 || TCVAR:睡眠薬強度 || TCVAR:睡眠深度 > 2000 || IsDead:TARGET:0)
	PRINTFORML 당신은 천천히 %조사처리(CALLNAME:TARGET,"의")% 옷을 벗긴다.
	EQUIP:0 = 0
	SIF CFLAG:TARGET:睡眠姦 < 2
		CFLAG:TARGET:睡眠姦 = 2
	CALL SET_PRANK(2,TARGET,1)
	CALL 脱衣処理(TARGET, "全裸", "「表示なし」")
	FOR LOCAL,1,CHARANUM
	CALL CLOTHES_SETTING_TRAIN(LOCAL)
	NEXT
	RETURN 1
	;test
	;ELSEIF RESULT == 99999
	;	TIME:5 = 4
	;	RETURN 1
