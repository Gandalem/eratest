; Modular ERB: USERCOM_服を脱がせる.ERB

@脱衣処理(C_ID, TYPE, OP)
#DIM  C_ID ;対象となる登録番号
#DIMS TYPE ;処理内容
#DIMS OP   ;実行オプション
#DIM  PANTS;Avoid reusing name when stealing panties after removing pants
SELECTCASE TYPE
	CASE "全裸"
		IF !(C_ID == MASTER) && !STRCOUNT(OP, "「表示なし」")
			CALL MESSAGE_脱衣上
			TSTR:3 = %CALLNAME:C_ID%{EQUIP:C_ID:下半身下着２}/
			IF (FLAG:時間停止 || TCVAR:C_ID:泥酔 || CFLAG:C_ID:睡眠) && EQUIP:下半身下着２ && !PANTIES_LOCKED(C_ID)
				;IF (TIMESTOP() == 2|| TCVAR:C_ID:泥酔) && EQUIP:下半身下着２
				CALL MESSAGE_脱衣下
				SIF !PANTS_ALREADY_COLLECTED(C_ID)
					SETCOLOR C_PINK
				PRINTFORML %CALLNAME:C_ID%은 %A_SOME_PANTIES(UNDIES_NAME_WITH_BRAND(C_ID,EQUIP:C_ID:下半身下着２,1))%을 입고 있는 것 같다 %UNDIES_NAME_WITH_BRAND(C_ID,EQUIP:C_ID:下半身下着２,1)%.
				RESETCOLOR
				IF FLAG:パンツ泥棒 == 1
					CALL 脱衣処理(C_ID, "くすねる")
				ELSEIF FLAG:パンツ泥棒 == 2
					GOTO PANTU_NUGASUDAKE
				ELSE
					PRINTFORML %IT_THEM_PANTIES(PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID))%는 어떻게 할 것인가?
					CALL ASK_YN("훔치다","그냥 벗어")
					IF RESULT == 0
						CALL 脱衣処理(C_ID, "くすねる")
					ELSE
						$PANTU_NUGASUDAKE
						CALL MESSAGE_脱衣下下着
						EQUIP:C_ID:下半身下着２ = 0
					ENDIF
				ENDIF
			ELSEIF EQUIP:下半身下着２ && !PANTIES_LOCKED(C_ID)
				CALL MESSAGE_脱衣下
				SIF !PANTS_ALREADY_COLLECTED(C_ID)
					SETCOLOR C_PINK
				CALL MESSAGE_脱衣下下着
				PRINTFORML 당신이 %CALLNAME:C_ID%에게 %HIS_HER(C_ID)%를 가져가도 되는지 %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)% 물어볼 건가?
				RESETCOLOR
				PRINT [0] - 묻지 마라 
				PRINT [1] - 묻지 마
				DO
				INPUT
				SIF !GROUPMATCH(RESULT, 0, 1)
					CONTINUE
				IF RESULT
					EQUIP:C_ID:下半身下着２ = 0
					PRINTL  
					BREAK
				ENDIF
				;こっからRESULT == 0
				IF ABL:C_ID:従順 > 7 && ABL:C_ID:親密 > 7
					IF ABL:C_ID:欲望 > 7 && !RAND:4
						PRINTFORMW %CALLNAME:C_ID%은(는) 당신과 속옷을 교환하고 싶어한다...
						IF EQUIP:MASTER:下半身下着２
							SIF !PANTS_ALREADY_COLLECTED()
								SETCOLOR C_PINK
							PRINTFORMW 당신은 자신의 %PANTSNAME(EQUIP:MASTER:下半身下着２, MASTER)%을 벗고 %CALLNAME:C_ID%의 %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)%으로 교환한다!
							RESETCOLOR
							CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 3, 0)
							TSTR:3 = %CALLNAME:C_ID%{EQUIP:C_ID:下半身下着２}/
							CSTR:MASTER:12 += TSTR:3
							CALL PANTS_GET(C_ID, "もらう")
							CFLAG:MASTER:ノーパン = 2
							CFLAG:C_ID:パンツ2 = 1
							CFLAG:C_ID:あなたのパンツ = 1
							EQUIP:MASTER:下半身下着２ = 0
						ELSE
							PRINTFORMW 하지만 너는 아무것도 입고 있지 않다.
							PRINTFORMW %CALLNAME:C_ID%는 조금 혼란스러워한다...
						ENDIF
					ELSE
						SIF !PANTS_ALREADY_COLLECTED()
							SETCOLOR C_PINK
						PRINTFORMW %CALLNAME:C_ID%의 얼굴은 새빨갛게 달아오르고 %HE_SHE(C_ID)%는 방금 벗어둔 %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)%를 당신에게 건넨다.
						PRINTFORMW 당신은 %CALLNAME:C_ID%의 %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)%를 얻는다!
						RESETCOLOR
						CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 3, 1)
						CALL PANTS_GET(C_ID, "もらう")
					ENDIF
				ELSEIF TCVAR:TARGET:Common_Sense_Alteration_Status > 50 || FLAG:催眠強度 > 50 || (ABL:TARGET:従順 > 5 && ABL:TARGET:親密 > 5) ;hypnosis patch
					SIF !PANTS_ALREADY_COLLECTED()
						SETCOLOR C_PINK
					PRINTFORMW %CALLNAME:C_ID% 꺼내며 %HIS_HER(C_ID)% %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)% 그리고 건넨다 %IT_THEM_PANTIES(PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID))% 넘긴다.
					PRINTFORMW 획득한다 %CALLNAME:C_ID%의 %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)%!
					RESETCOLOR
					CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 3, 2)
					CALL PANTS_GET(C_ID, "もらう")
				ELSE
					PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 그것들을 당신에게 주기를 거절한다.
					PRINTFORMW 하지만 결국 마지못해 벗어버린다...
					CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 3, 3)
					EQUIP:C_ID:下半身下着２ = 0
				ENDIF
				PRINTL  
				BREAK
				LOOP 1
			ELSE
				CALL MESSAGE_脱衣下
				SIF !PANTIES_LOCKED(C_ID)
					CALL MESSAGE_脱衣下下着
			ENDIF
			CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 0, 0)
		ENDIF
		CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_全裸")
		CALL CLOTHES_SETTING_TRAIN(C_ID)
		RETURN 0
	CASE "くすねる"
		;NAS: Replaced
		CALL PANTY_STEAL_NAS(C_ID, TYPE, OP)
		RETURN RESULT
		;Custom code
		PANTS = 0
		IF EQUIP:TARGET:ズボン
			CALL MESSAGE_脱衣下_TR(2)
			PANTS = 1
		ENDIF
		TSTR:3 = %CALLNAME:C_ID%{EQUIP:C_ID:下半身下着２}/
		CALL MESSAGE_脱衣下下着
		SIF !PANTS_ALREADY_COLLECTED(C_ID)
			SETCOLOR C_PINK
		PRINTFORMW 당신은 \@ PANTS ? %HIS_HER(C_ID)% # %CALLNAME:C_ID%의 \@ %PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID)%를 벗어 주머니에 넣는다. %IT_THEM_PANTIES(PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID))%.
		RESETCOLOR
		CALL PANTS_GET(C_ID)
		RETURN 0
	CASE "下着姿にする"
		IF !(C_ID == MASTER) && !STRCOUNT(OP, "「表示なし」")
			CALL MESSAGE_脱衣上着
			CALL MESSAGE_脱衣下
			CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 1, 0)
		ENDIF
		CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_下着姿")
		CALL CLOTHES_SETTING_TRAIN(C_ID)
		;"現在衣装の変更_下着姿"にはTEQUIPの直接操作がある、全容を把握してないがもとの構文だと
		;呼び出し元で最終的に全キャラに対してCLOTHES_SETTING_TRAINを実行していたため
		;挙動としては変わらないはず
		;TEQUIP:TARGET:上半身はだけ状態 = 1
		RETURN 0
	CASE "パンツ貰う"
	CASE "半脱ぎ"
		IF !(C_ID == MASTER) && !STRCOUNT(OP, "「表示なし」")
			CALL MESSAGE_脱衣上着(1) ;custom code ARG
			CALL MESSAGE_脱衣下(1)
			CALL KOJO_MESSAGE_SEND("EVENT", 28, C_ID, 2, 0)
		ENDIF
		CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_半脱ぎ")
		CALL CLOTHES_SETTING_TRAIN(C_ID)
		RETURN 0
	CASEELSE
		THROW 不明なTYPE %TYPE%
ENDSELECT

@服を脱がせる
; SIF !TARGET && !CFLAG:MASTER:今忙しくて手が離せない
; 	JUMP SIMATTYAUOJISAN
IF CFLAG:TARGET:ノーパン == 0
	SELECTCASE FLAG:脱衣選択
		CASE 0
			PRINTL 모든 것을 벗을까?
			PRINT [0] - 전부 벗기 
			IF TEQUIP:TARGET:上着脱衣済み == 0 || EQUIP:TARGET:上半身下着１
				SIF EQUIP:0 && TARGET && EQUIP:TARGET:上半身下着１ != 0 && (EQUIP:TARGET:着物 != 0 || EQUIP:TARGET:上半身上着２ != 0 || EQUIP:TARGET:ボディースーツ == 3)
					PRINT [1] 옷을 반쯤 벗은 상태로 놀아보자. 
			ENDIF
			IF TEQUIP:TARGET:上着脱衣済み == 0
				SIF EQUIP:0 && TARGET && (EQUIP:TARGET:上半身下着１ != 0 || EQUIP:TARGET:上半身下着２ != 0 || EQUIP:TARGET:下半身下着１ != 0 || EQUIP:TARGET:下半身下着２ != 0 || EQUIP:TARGET:レオタード != 0 || EQUIP:TARGET:ボディースーツ != 0)
					PRINT [2] 속옷만 입는다.
			ENDIF
			DO
			INPUT
			SELECTCASE RESULT
				CASE 0
					CALL 脱衣処理(TARGET, "全裸")
					CALL 脱衣処理(MASTER, "全裸")
				CASE 1
					CALL 脱衣処理(TARGET, "半脱ぎ")
					CALL 脱衣処理(MASTER, "半脱ぎ")
				CASE 2
					CALL 脱衣処理(TARGET, "下着姿にする")
					CALL 脱衣処理(MASTER, "下着姿にする")
				CASEELSE
					CONTINUE
			ENDSELECT
			BREAK
			LOOP 1
		CASE 1
			CALL 脱衣処理(TARGET, "全裸")
			CALL 脱衣処理(MASTER, "全裸")
		CASE 2
			IF !TEQUIP:3
				CALL 脱衣処理(TARGET, "半脱ぎ")
				CALL 脱衣処理(MASTER, "半脱ぎ")
			ELSE
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 옷은 이미 반쯤 벗겨졌다.
				PRINTL 모든 걸 벗길까?
				PRINT [0] - 그렇다 
				PRINT [1] - No
				INPUT
				IF RESULT == 0
					CALL 脱衣処理(TARGET, "全裸")
					CALL 脱衣処理(MASTER, "全裸")
				ELSE
					RETURN 0
				ENDIF
			ENDIF
	ENDSELECT
	;すでにはいてない
ELSE
	IF TEQUIP:TARGET:上着脱衣済み
		CALL 脱衣処理(TARGET, "全裸")
		CALL 脱衣処理(MASTER, "全裸")
	ELSE
		;着衣プレイの選択
		PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 속옷은 이미 벗겨졌다.
		SELECTCASE FLAG:脱衣選択
			CASE 0
				PRINTL 모든 걸 벗을까?
				PRINT [0] - 전부 제거한다 
				IF EQUIP:TARGET:上半身下着１
					SIF EQUIP:0 && TARGET && EQUIP:TARGET:上半身下着１ && (EQUIP:TARGET:着物 != 0 || EQUIP:TARGET:上半身上着２ != 0 || EQUIP:TARGET:ボディースーツ == 3)
						PRINT [1] 옷을 반만 벗고 놀아보자 
				ENDIF
				SIF EQUIP:0 && TARGET && (EQUIP:TARGET:上半身下着１ != 0 || EQUIP:TARGET:上半身下着２ != 0 || EQUIP:TARGET:下半身下着１ != 0 || EQUIP:TARGET:下半身下着２ != 0 || EQUIP:TARGET:レオタード != 0 || EQUIP:TARGET:ボディースーツ != 0)
					PRINT [2] 속옷만 남긴다.
				DO
				INPUT
				SELECTCASE RESULT
					CASE 0
						CALL 脱衣処理(TARGET, "全裸")
						CALL 脱衣処理(MASTER, "全裸")
					CASE 1
						CALL 脱衣処理(TARGET, "半脱ぎ")
						CALL 脱衣処理(MASTER, "半脱ぎ")
					CASE 2
						CALL 脱衣処理(TARGET, "下着姿にする")
						CALL 脱衣処理(MASTER, "下着姿にする")
					CASEELSE
						CONTINUE
				ENDSELECT
				BREAK
				LOOP 1
			CASE 1
				CALL 脱衣処理(TARGET, "全裸")
			CASE 2
				IF !TEQUIP:TARGET:3
					CALL 脱衣処理(TARGET, "半脱ぎ")
					CALL 脱衣処理(MASTER, "半脱ぎ")
				ELSE
					PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 옷이 이미 반쯤 벗겨졌다.
					PRINTL 모든 것을 벗기겠어?
					PRINT [0] - 응 
					PRINT [1] - No
					INPUT
					IF RESULT == 0
						CALL 脱衣処理(TARGET, "全裸")
						CALL 脱衣処理(MASTER, "全裸")
					ELSE
						RETURN 0
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
;着せ替えフラグOFF
;EQUIP:TARGET:0 = 0
;キャラ全員の服再セッティング
;個々でやってるからこれいらんと思う
RETURN 1
