; Modular ERB: COMABLE/COMABLE_300.ERB
;-------------------------------------------------
;300番台,日常(相手が必要)
;-------------------------------------------------
;抵抗する
;移植済
;対応コマンド不明
;逃げる

@COM_ABLE362
;停止中は不可
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
;逃げる実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(362)
	RETURN RESULT
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF TFLAG:102 != 4
	RETURN 0
RETURN 1
