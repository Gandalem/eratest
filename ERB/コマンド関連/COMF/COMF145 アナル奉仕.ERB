; Modular ERB: COMF/COMF145 アナル奉仕.ERB
;-------------------------------------------------
;アナル奉仕
;ハードな調教コマンド、レベル3
;-------------------------------------------------

@COM145
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = TARGET
;奉仕快楽フラグ
TCVAR:108 = 1
CSTR:PLAYER:10 += @"{TARGET}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:PLAYER:2 = 12
;強度
TCVAR:PLAYER:4 = 250
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:体力 += 10
DOWNBASE:気力 += 100
SOURCE:PLAYER:快Ａ = 100
SOURCE:性行動 = 300
SOURCE:達成 = 300
SOURCE:屈従 = 2500
SOURCE:逸脱 = 1200
SOURCE:反感 = 1200
;上のほうで計算した汚れデータ
SOURCE:不潔 = Y*80 + 50
EXP:口淫経験 ++ ;bug fix, include experience
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:自己愛 < 0 || TALENT:抵抗
	SOURCE:鬱屈 += 1200
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷の口⇔調教者のＡの汚れが移動
STAIN:0 |= STAIN:PLAYER:4
STAIN:PLAYER:4 |= STAIN:0
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF HETEROSEX(TARGET,PLAYER)
	EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 6
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 6
ENDIF
;奴隷が猫舌持ちの場合は、調教者に嗜虐快楽経験を追加
SIF TALENT:TARGET:猫舌
	EXP:嗜虐快楽経験 += 1
Qol_Info_Count_Array:TARGET:Qol_Count_GiveMSexAnal += EXP_UP(GETNUM(EXP, "口淫経験"), TARGET) ;qol custom code
RETURN 1

@CAN_COM145(ARG)
;qol custom code, replaced
CALL CAN_COM145_TR(ARG)
RETURN RESULT
SKIPDISP ARG
PRINTL 분석 서비스
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
A = 0
S = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
CALL COM_ORDER
;ABL:欲望
IF ABL:欲望
	SIF S
		PRINT  + 
	A += ABL:欲望 * 1
	PRINT 욕정
	PRINTV 'LV,ABL:欲望,'(,ABL:欲望 * 1,')
	S = 1
ENDIF
;ABL:奉仕精神
IF ABL:奉仕精神
	SIF S
		PRINT  + 
	A += ABL:奉仕精神 * 3
	PRINT 봉사정신
	PRINTV 'LV,ABL:奉仕精神,'(,ABL:奉仕精神 * 3,')
	S = 1
ENDIF
IF MARK:快楽刻印
	SIF S
		PRINT  + 
	A += MARK:快楽刻印 * 2
	PRINT 쾌락의 낙인
	PRINTV 'LV,MARK:快楽刻印,'(,MARK:快楽刻印 * 2,')
	S = 1
ENDIF
;恥じらい
IF TALENT:羞恥心 > 0
	PRINT  - 
	A -= 1
	PRINT 부끄러움
	PRINTV '(,1,')
	S = 1
ENDIF
;汚臭鈍感
IF TALENT:汚臭耐性 == 1
	SIF S
		PRINT  + 
	A += 2
	PRINT 악취 내성
	PRINTV '(,2,')
	S = 1
ENDIF
;汚臭敏感
IF TALENT:汚臭耐性 < 0
	PRINT  - 
	A -= 5
	PRINT 악취에 민감하다
	PRINTV '(,5,')
	S = 1
ENDIF
;献身的
IF TALENT:献身的
	SIF S
		PRINT  + 
	A += 4
	PRINT 헌신적인
	PRINTV '(,4,')
	S = 1
ENDIF
;汚れ無視
IF TALENT:汚臭耐性 == 2
	SIF S
		PRINT  + 
	A += 3
	PRINT 더러움을 무시한다
	PRINTV '(,3,')
	S = 1
ENDIF
;快感の否定（淫乱、娼婦で無効）
IF TALENT:快感応答 < 0 && !TALENT:淫乱
	PRINT  - 
	A -= 1
	PRINT 쾌감을 부정한다
	PRINTV '(,1,')
	S = 1
ENDIF
;倒錯的
IF TALENT:倒錯的
	SIF S
		PRINT  + 
	A += 3
	PRINT 도착적
	PRINTV '(,3,')
	S = 1
ENDIF
;サド
IF TALENT:PLAYER:サド
	SIF S
		PRINT  + 
	A += 3
	PRINT 새드
	PRINTV '(,3,')
	S = 1
ENDIF
;恋慕
IF TALENT:恋慕 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 연모
	PRINTV '(,5,')
	S = 5
ENDIF
;親愛
IF TALENT:恋慕 > 1 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 깊은 연모
	PRINTV '(,5,')
	S = 5
ENDIF
Y = 0
;愛液の汚れ
SIF STAIN:PLAYER:3 & 1
	Y += 1
;精液の汚れ
SIF STAIN:PLAYER:3 & 4
	Y += 3
;アナルの汚れ
SIF STAIN:PLAYER:3 & 8
	Y += 7
SIF STAIN:PLAYER:3 & 16
	Y += 15
Y = Y * (2 - TALENT:汚臭耐性) / 2
;汚れあり
IF Y
	PRINT  - 
	A -= Y
	PRINT 더러운
	;汚臭鈍感
	IF TALENT:汚臭耐性 > 0
		PRINT 악취 내성
	ELSEIF TALENT:汚臭耐性 < 0
		PRINT 악취에 민감하다
	ENDIF
	PRINTV '(,Y,')
	S = 1
ENDIF
;合計を表示(23以上で実行)
PRINT  =
PRINTV A
V = 23
SIF A < V
	PRINT  < 
SIF A == V
	PRINT  =
SIF A > V
	PRINT  > 
PRINT 필요 값 
PRINTV V
WAIT
SKIPDISP 0
;実行できない
SIF A < V
	RETURN 0
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE145
;アナル奉仕強制実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(145)
	RETURN RESULT
;猫舌の奴隷の場合は技巧Lv2以上必要
SIF TALENT:猫舌 && ABL:技巧 < 2
	RETURN 0
;ボールギャグ使用中は不可
SIF TEQUIP:ボールギャグ
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
RETURN 1
