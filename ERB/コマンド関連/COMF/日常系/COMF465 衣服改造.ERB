; Modular ERB: COMF/日常系/COMF465 衣服改造.ERB

@COM370
#DIM 改造部位
PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 무엇을 개조할까요?
FOR LOCAL,1,23
SIF EQUIP:TARGET:LOCAL
	PRINTFORML [{LOCAL}]- %CLOTHNAME(LOCAL,EQUIP:TARGET:LOCAL)%
NEXT
PRINTFORML [999]- 그만두다
$LOOP
INPUT
SELECTCASE RESULT
	CASE 1 TO 22
		IF !EQUIP:TARGET:RESULT
			GOTO LOOP
		ELSE
			改造部位 = RESULT
		ENDIF
	CASE 999
		RETURN -1
	CASEELSE
		GOTO LOOP
ENDSELECT
PRINTFORML %CLOTHNAME(改造部位,EQUIP:TARGET:改造部位)%를 어떻게 할까요?
CALL ASK_YN("원래대로 되돌린다","재봉하다")
IF !RESULT
	CSTR:TARGET:(50 + 改造部位) =
	PRINTFORML 원상태로 되돌렸습니다.
ELSE
	PRINTFORML 어떻게 만들어 드릴까요? (앞에 붙일 수식어를 입력하세요)
	INPUTS
	IF RESULTS == ""
		GOTO LOOP
	ELSE
		CSTR:TARGET:(50 + 改造部位) = %RESULTS%%CLOTHNAME(改造部位,EQUIP:TARGET:改造部位)%
	ENDIF
	PRINTFORML %CLOTHNAME(改造部位,EQUIP:TARGET:改造部位)%는%CSTR:TARGET:(50 + 改造部位)%가 되었습니다.
ENDIF
TIME += 60
RETURN 1
