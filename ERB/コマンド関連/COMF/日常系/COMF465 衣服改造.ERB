@COM_ABLE370
;実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(370)
	RETURN RESULT
;アリスがいないとダメ
SIF CFLAG:17:現在位置 != CFLAG:MASTER:現在位置
	RETURN 0
;仕事中
SIF CFLAG:行動 == 5
	RETURN 0
;気力0
SIF BASE:17:気力 <= 0
	RETURN 0
RETURN 1
