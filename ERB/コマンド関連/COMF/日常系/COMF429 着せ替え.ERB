; Modular ERB: COMF/日常系/COMF429 着せ替え.ERB
;-------------------------------------------------
;着せ替え
;日常系コマンド、レベル1
;-------------------------------------------------

@COM429
#DIM C_ID
#DIM ID_着せ替え対象, キャラクタ数上限
#DIM 着せ替え可能人数
#DIM L_ID ;使用リストのID
CALL MAKE_CHARA_LIST("着せ替え可能キャラリスト", L_ID, ID_着せ替え対象, 着せ替え可能人数)
IF 着せ替え可能人数 <= 1
	PRINTFORMW 너는 옷을 갈아입기로 결정한다.
	CALL 服装着せ替え(MASTER)
	CALL CLOTHES_SETTING_TRAIN(MASTER)
	RETURN -1
ENDIF
;着替え対象の選択
;リスト作成時に可否判定やってるのでここでは必要ないです
PRINTFORML 여기서 옷을 바꿀 수 있다.
PRINTFORML 누구의 옷을 바꿔야 하는가?
PRINTFORML 
CALL SIMPLE_CHARA_LIST(ID_着せ替え対象, 着せ替え可能人数)
;キャンセルした
SIF RESULT == 999
	RETURN -1
;RESULTはすぐ腐るので
C_ID = ID_着せ替え対象:(RESULT)
SIF FLAG:時間停止 == 1 && !(C_ID == MASTER)
	CFLAG:C_ID:時間停止着せ替え = 1
CALL 服装着せ替え(C_ID)
CALL CLOTHES_SETTING_TRAIN(C_ID)
SIF !FLAG:70
	TIME += 5
TFLAG:102 = 0
RETURN 0
;CLOTHES_SETTING_TRAINに靴脱ぎ処理を移動させたので
;ここでCLOTHES_SETTING_TRAINすると靴を脱いでしまい、靴設定の保存ができません
;呼び出し元でCLOTHES_SETTING_TRAINすること

@服装着せ替え(C_ID)
#DIM C_ID
#DIM LINESTART2
CALL 服装着せ替え_TR(C_ID) ;qol custom code
RETURN RESULT
LINESTART = LINECOUNT
CALL SHOW_CLOTHES(C_ID, "現在の衣装")
PRINTFORML %CALLNAME:C_ID%의 옷을 갈아입힌다
PRINTFORML 
PRINTFORML [6] 옷 확인
PRINTFORML [5] 즐겨찾기
SIF C_ID != MASTER ;custom code
	PRINTFORML [4] - 잠옷으로 변경
PRINTFORML [3] - 캐주얼 복장으로 변경
PRINTFORML [2] - 임시로 옷을 변경한다
PRINTFORML [1] - 속옷
PRINTFORML 
PRINTFORML [0] - 반환
DO
INPUT
LINESTART2 = LINECOUNT
SELECTCASE RESULT
	CASE 6
		CALL SHOW_CHARA_CLOTHES(C_ID, 0)
		CLEARLINE LINECOUNT - LINESTART
		RESTART
	CASE 5
		$着せ替え5
		CALL SHOW_CLOTHES(C_ID, "おきにいり衣装")
		PRINTFORML %CALLNAME:C_ID%의 가장 좋아하는 옷을 바꾸다
		PRINTFORML 
		PRINTFORML [4] - 현재 옷을 즐겨찾기로 확정한다.
		PRINTFORML [3] - 복장 변경
		PRINTFORML [2] - 다른 캐릭터의 평상복을 따라 한다.
		PRINTFORML [1] - 즐겨찾기 초기화
		PRINTFORML 
		PRINTFORML [0] 신경 쓰지 마.
		DO
		INPUT
		SELECTCASE RESULT
			CASE 4
				CALL DECIDE_CLOTHES(C_ID, "おきにいり衣装", "現在の衣装")
			CASE 3
				CALL COSPLAY_SET(C_ID, "おきにいり衣装")
			CASE 2
				CALL COSPLAY_CHARA(C_ID, "おきにいり衣装")
			CASE 1
				PRINTFORML 정말 옷을 초기화해?
				PRINTFORML 
				PRINTFORML [1] - 초기화
				PRINTFORML [0] - 하지 않음
				DO
				INPUT
				SELECTCASE RESULT
					CASE 1
						CALL CTRL_CLOTHES_SET(C_ID, "おきにいり衣装のリセット")
						GOTO 着せ替え5 ;bugfix custom code
					CASE 0
						CLEARLINE LINECOUNT - LINESTART2
						GOTO 着せ替え5
					CASEELSE
						CLEARLINE 1
						CONTINUE
				ENDSELECT
				LOOP 1
			CASE 0
				CLEARLINE LINECOUNT - LINESTART
				RESTART
			CASEELSE
		ENDSELECT
		CLEARLINE LINECOUNT - LINESTART2
		GOTO 着せ替え5
		LOOP 1
	CASE 4
		IF C_ID == MASTER
			CLEARLINE LINECOUNT - LINESTART
			RESTART
		ENDIF
		$着せ替え4
		CALL SHOW_CLOTHES(C_ID, "今日のパジャマ")
		PRINTFORML %CALLNAME:C_ID%의 잠옷을 갈아입힌다
		PRINTFORML 
		PRINTFORML [5] - %HIM_HER(C_ID)%가 무엇을 입고 자게 할지
		PRINTFORML [4] - %HIM_HER(C_ID)%에게 %HIS_HER(C_ID)%가 가장 좋아하는 복장을 하고 잠들게 한다.
		PRINTFORML [3] - %HIS_HER(C_ID)%의 잠옷을 설정한다.
		PRINTFORML [2] - %HIM_HER(C_ID)%가 알몸으로 자게 한다.
		PRINTFORML [1] - %HIM_HER(C_ID)%에게 속옷만 입고 자게 한다.
		PRINTFORML 
		PRINTFORML [0] - 반환
		DO
		INPUT
		SELECTCASE RESULT
			CASE 5
				CFLAG:C_ID:パジャマ指定 = 0
			CASE 4
				SIF CFLAG:C_ID:おきにいり衣装
					CALL CTRL_CLOTHES_SET(C_ID, "パジャマの変更_おきにいり衣装")
			CASE 3
				CALL COSPLAY_SELECT(C_ID, "パジャマ", "パジャマセット")
			CASE 2
				CALL CTRL_CLOTHES_SET(C_ID, "パジャマの変更_全裸")
			CASE 1
				CALL CTRL_CLOTHES_SET(C_ID, "パジャマの変更_パンイチ")
			CASE 0
				CLEARLINE LINECOUNT - LINESTART
				RESTART
			CASEELSE
				CLEARLINE 1
				CONTINUE
		ENDSELECT
		CLEARLINE LINECOUNT - LINESTART2
		GOTO 着せ替え4
		LOOP 1
	CASE 3
		$着せ替え3
		CALL SHOW_CLOTHES(C_ID, "今日の衣装")
		PRINTFORML %CALLNAME:C_ID%의 캐주얼 의상을 변경한다.
		PRINTFORML 
		PRINTFORML [4] - 현재 의상 확인 (즐겨찾기 덮어씀)
		PRINTFORML [3] - 코스튬 변경
		PRINTFORML [2] - 다른 캐릭터의 평상복 모방
		PRINTFORML [1] - %HIM_HER(C_ID)%에게 결정하게 함
		PRINTFORML 
		PRINTFORML [0] - 반환
		DO
		INPUT
		SELECTCASE RESULT
			CASE 4
				CALL DECIDE_CLOTHES(C_ID, "普段着", "現在の衣装")
			CASE 3
				CALL COSPLAY_SET(C_ID, "普段着")
			CASE 2
				CALL COSPLAY_CHARA(C_ID, "普段着")
			CASE 1
				PRINTFORMW %HE_SHE(C_ID,1)%은 이제 %HE_SHE(C_ID)%가 하고 싶은 대로 입는다.
				CFLAG:C_ID:基本服装セット = 100 + C_ID ;bugfix custom code
			CASE 0
				CLEARLINE LINECOUNT - LINESTART
				RESTART
		ENDSELECT
		CLEARLINE LINECOUNT - LINESTART2
		GOTO 着せ替え3
		LOOP 1
	CASE 2
		$着せ替え2
		;#;PRINTFORML CFLAG:C_ID:衣装一時変更{CFLAG:C_ID:衣装一時変更}
		CALL SHOW_CLOTHES(C_ID, "現在の衣装")
		PRINTFORML %CALLNAME:C_ID%의 현재 옷을 변경한다
		PRINTFORML 
		PRINTFORML [4] - 즐겨찾기
		PRINTFORML [3] - 의상 변경
		PRINTFORML [2] - 다른 캐릭터의 사복을 따라 입는다
		PRINTFORML [1] - 일상 기본 복장으로 되돌린다
		PRINTFORML 
		PRINTFORML [0] - 나가기
		DO
		INPUT
		SELECTCASE RESULT
			CASE 4
				IF !CFLAG:C_ID:おきにいり衣装
					CLEARLINE LINECOUNT - LINESTART2
					GOTO 着せ替え2
				ENDIF
				CALL DECIDE_CLOTHES(C_ID, "現在の衣装", "おきにいり衣装")
			CASE 3
				CALL COSPLAY_SET(C_ID, "現在の衣装")
			CASE 2
				CALL COSPLAY_CHARA(C_ID, "現在の衣装")
			CASE 1
				PRINTFORMW %CALLNAME:C_ID%는 오늘 옷을 입는다
				CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_普段着")
			CASE 0
				CLEARLINE LINECOUNT - LINESTART
				RESTART
		ENDSELECT
		CLEARLINE LINECOUNT - LINESTART2
		GOTO 着せ替え2
		LOOP 1
	CASE 1
		$着せ替え1
		PRINTFORML %CALLNAME:C_ID%의 속옷을 확인한다.
		;Custom code
		PRINTFORML 현재 속옷: %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", EQUIP:C_ID:下半身下着２, "名前"),1)%
		SELECTCASE CFLAG:C_ID:指定パンツ
			CASE 0
				PRINTFORML 　현재 착용 중인 속옷: 해당 없음
			CASE 100
				PRINTFORML 　현재 착용 중인 속옷: 없음
			CASEELSE
				;Custom code
				PRINTFORML 　현재 착용 중인 속옷: %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", CFLAG:C_ID:指定パンツ, "名前"),1)%
		ENDSELECT
		PRINTFORML 
		PRINTFORML 
		SIF C_ID == MASTER
			PRINTFORML [3] 그것들을 벗어라.
		PRINTFORML [2] - 이것들을 즐겨찾기로 설정한다.
		PRINTFORML [1] - 즐겨찾기 속옷을 초기화한다.
		PRINTFORML 
		PRINTFORML [0] - 반환
		DO
		INPUT
		SELECTCASE RESULT
			CASE 3
				PRINTFORMW 현재 착용하고 있는 속옷을 벗는다.
				EQUIP:C_ID:下半身下着２ = 100
			CASE 2
				PRINTFORMW 현재 속옷 세트를 즐겨찾기로 설정했다.
				CFLAG:C_ID:指定パンツ = EQUIP:C_ID:下半身下着２
				SIF !CFLAG:C_ID:指定パンツ
					CFLAG:C_ID:指定パンツ = 100
			CASE 1
				PRINTFORMW 좋아하는 속옷은 이제 사용 불가능합니다.
				CFLAG:C_ID:指定パンツ = 0
			CASE 0
				CLEARLINE LINECOUNT - LINESTART
				RESTART
		ENDSELECT
		CLEARLINE LINECOUNT - LINESTART2
		GOTO 着せ替え1
		LOOP 1
	CASE 0
		RETURN
	CASEELSE
		CLEARLINE 1
		CONTINUE
ENDSELECT
LOOP 1
;模倣させる対象キャラの選択

@COSPLAY_CHARA(C_ID, TYPE)
#DIM  C_ID
#DIMS TYPE
#DIM  COS_CHARA
;Custom code
PRINTFORML %CALLNAME:C_ID%의 %CLOTHES_TYPE_TR(TYPE)%를 변경한다.
PRINTFORML 누구의 스타일을 모방해야 하는가?
CALL SHOW_CHARA_LIST("普段着模倣可能キャラリスト", "体力気力")
COS_CHARA = RESULT
IF GROUPMATCH(COS_CHARA, 0, 999)
	PRINTFORMW 옷 갈아입는 것은 취소되었다.
	RETURN
ELSEIF COS_CHARA == C_ID
	SELECTCASE TYPE
		CASE "おきにいり衣装"
			PRINTFORMW 옷 갈아입기가 취소되었다.
		CASE "普段着"
			PRINTFORMW %HE_SHE(C_ID,1)%은 이제 %HE_SHE(C_ID)%가 하고 싶은 대로 입는다.
			CFLAG:C_ID:基本服装セット = 100 + C_ID ;bugfix custom code
		CASE "現在の衣装"
			PRINTFORMW %HE_SHE(C_ID,1)%은(는) %HIS_HER(C_ID)%의 일상복을 입는다.
			CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_普段着")
	ENDSELECT
	RETURN
ENDIF
CALL DECIDE_CLOTHES(C_ID, TYPE, "キャラ普段着", COS_CHARA)
SIF RESULT
	RESTART
;衣装セットのカテゴリ選択

@COSPLAY_SET(C_ID, TYPE)
#DIM  C_ID
#DIM  SET_ID
#DIMS TYPE
#DIMS CATEGORY
CALL SHOW_CLOTHES(C_ID, TYPE)
;Custom code
PRINTFORML %CALLNAME:C_ID%의 %CLOTHES_TYPE_TR(TYPE)%를 변경한다.
PRINTFORML 의상을 선택하라
PRINTFORML 
PRINTFORML [3] - 일반 의상
PRINTFORML [2] - 코스프레 의상
PRINTFORML [1] - 특수 캐릭터 의상
PRINTFORML 
PRINTFORML [0] - 반환
DO
INPUT
SELECTCASE RESULT
	CASE 3
		CATEGORY '= "基本衣装セット"
	CASE 2
		CATEGORY '= "コスプレ衣装セット"
	CASE 1
		CATEGORY '= "キャラ特殊衣装セット"
	CASE 0
		RETURN
	CASEELSE
		REUSELASTLINE Invalid input
		CONTINUE
ENDSELECT
BREAK
LOOP 1
CALL COSPLAY_SELECT(C_ID, TYPE, CATEGORY)
SIF !RESULT
	RESTART
;個々の衣装セットの選択

@COSPLAY_SELECT(C_ID, TYPE, CATEGORY)
#DIM  C_ID
#DIM  SET_ID
#DIMS TYPE
#DIMS CATEGORY
;Custom code
PRINTFORML %CALLNAME:C_ID%의 %CLOTHES_TYPE_TR(TYPE)% (%CLOTHES_CAT_TR(CATEGORY)%)를 변경한다
PRINTFORML 사용할 코스튬을 선택하라
PRINTFORML 
;Custom code
PRINTFORML [999] - 모듈형
CALL CLASS_LIST_TR("衣装セット", CATEGORY)
PRINTFORML 
PRINTFORML [0] - 반환
DO
INPUT
SET_ID = RESULT
SELECTCASE SET_ID
	CASE 0
		RETURN
	CASE 999
		CALL INDIVIDUAL_SELECT(C_ID, TYPE)
		RETURN
	CASEELSE
		SIF GET_INT(0, "衣装セット" , SET_ID, CATEGORY)
			BREAK
		REUSELASTLINE Invalid input
		CONTINUE
ENDSELECT
LOOP 1
CALL DECIDE_CLOTHES(C_ID, TYPE, "衣装セット", SET_ID)
CALL CHANGE_CLOTHES(C_ID, "衣装リセット") ;qol custom code
SIF RESULT
	RESTART
;衣装決定の最終確認

@DECIDE_CLOTHES(C_ID, COS_SAVE, COS_LOAD, SET_ID, CharaCreator = 0)
#DIM  C_ID     ;設定するキャラ
#DIMS COS_SAVE ;衣装の保存先
#DIMS COS_LOAD ;衣装の参照元
#DIM  SET_ID   ;参照衣装等のID
#DIM CharaCreator ; custom character custom code
#DIMS DYNAMIC  UnownedItems
#DIM ItemsID
;#; PRINTFORML C_ID{C_ID}, COS_SAVE%COS_SAVE%, COS_LOAD%COS_LOAD%, SET_ID{SET_ID}
PRINTFORMW 선택을 확인한다
CALL SHOW_CLOTHES(C_ID, COS_LOAD, SET_ID)
PRINTFORML 
;NAS: you need to have the clothes
SELECTCASE COS_LOAD
	CASE "衣装セット"
		FOR LOCAL, 1, 30
		SIF GROUPMATCH(LOCAL,10,24) || !GET_INT(C_ID, "衣装セット", SET_ID, EQUIPNAME:LOCAL)
			CONTINUE
		SIF !BoughtClothing:LOCAL:(GET_INT(C_ID, "衣装セット", SET_ID, EQUIPNAME:LOCAL))
			UnownedItems += @"%CLOTHES_TR(CLOTHNAME(LOCAL, GET_INT(C_ID, "衣装セット", SET_ID, EQUIPNAME:LOCAL)))%/"
		NEXT
	CASE "キャラ普段着"
		FOR LOCAL, 1, 30
		IF TALENT:C_ID:CustomChara
			ItemsID = CFLAG:SET_ID:(200+LOCAL)
		ELSE
			ItemsID = GET_INT(C_ID, "キャラデータ", SET_ID, @"평상복: %EQUIPNAME:LOCAL%")
		ENDIF
		SIF GROUPMATCH(LOCAL,10,24) || !ItemsID
			CONTINUE
		SIF !BoughtClothing:LOCAL:(ItemsID)
			UnownedItems += @"%CLOTHES_TR(CLOTHNAME(LOCAL, ItemsID))%/"
		NEXT
	CASE "ModularClothes"
		FOR LOCAL, 1, 30
		SIF GROUPMATCH(LOCAL,10,24) || !TempClothes:C_ID:LOCAL
			CONTINUE
		SIF !BoughtClothing:LOCAL:(TempClothes:C_ID:LOCAL)
			UnownedItems += @"%CLOTHES_TR(CLOTHNAME(LOCAL, TempClothes:C_ID:LOCAL))%/"
		NEXT
ENDSELECT
IF UnownedItems != ""
	PRINTFORML 당신은 다음 의류를 가지고 있지 않기 때문에 이 세트를 착용할 수 없습니다.
	;PRINTFORML %UnownedItems%
	FOR LOCAL,0,30
	LOCALS = %SPLIT_SINGLE(UnownedItems, LOCAL, "/")%
	SIF LOCALS == ""
		CONTINUE
	PRINTFORML ・%LOCALS%
	NEXT
	WAIT
	VARSET RESULT
	;#; CALL ASK_M("Give up",1,"No U", 1) ;debug override
	SIF !RESULT
		RETURN
ENDIF
;//////////////////////////
PRINTFORML 이 코스튬이 적절한가?
PRINTFORML 
PRINTFORML [1] - 확인
PRINTFORML [0] - 반환
PRINTFORML 
PRINTFORML [9] - 나가기
DO
INPUT
SELECTCASE RESULT
	CASE 1
		BREAK
	CASE 0
		RETURN 1
	CASE 9
		RETURN
	CASEELSE
		REUSELASTLINE Invalid input
		CONTINUE
ENDSELECT
LOOP 1
SELECTCASE COS_LOAD
	CASE "現在の衣装"
		SELECTCASE COS_SAVE
			CASE "普段着"
				PRINTFORMW 평소 복장으로 갈아입었다.
				CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の保存_おきにいり") ;bugfix custom code, flipped order
				CFLAG:C_ID:基本服装セット = 100
			CASE "おきにいり衣装"
				PRINTFORMW 현재 장착된 의상이 즐겨찾기로 설정되었습니다.
				CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の保存_おきにいり")
		ENDSELECT
	CASE "衣装セット"
		PRINTFORMW %CALLNAME:C_ID%의 %CLOTHES_TYPE_TR(COS_SAVE)%가 %LISTING_TR(GET_STR(C_ID, "衣装セット", SET_ID, "名前"))%로 설정되었다.
		SELECTCASE COS_SAVE
			CASE "現在の衣装"
				CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_衣装セット", SET_ID)
			CASE "普段着"
				CALL CTRL_CLOTHES_SET(C_ID, "普段着の変更_衣装セット", SET_ID)
			CASE "おきにいり衣装"
				CALL CTRL_CLOTHES_SET(C_ID, "おきにいり衣装の変更_衣装セット", SET_ID)
			CASE "パジャマ"
				CALL CTRL_CLOTHES_SET(C_ID, "パジャマの変更_衣装セット", SET_ID)
		ENDSELECT
	CASE "キャラ普段着"
		PRINTFORMW %CALLNAME:C_ID%는 %CALLNAME:SET_ID%를 모방하도록 설정되었다.
		SELECTCASE COS_SAVE
			CASE "現在の衣装"
				CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_キャラ衣装", SET_ID, "普段着")
			CASE "普段着"
				CALL CTRL_CLOTHES_SET(C_ID, "普段着の変更_キャラ衣装", SET_ID, "普段着")
			CASE "おきにいり衣装"
				CALL CTRL_CLOTHES_SET(C_ID, "おきにいり衣装の変更_キャラ衣装", SET_ID, "普段着")
		ENDSELECT
	CASE "ModularClothes"
		PRINTFORMW %CALLNAME:C_ID%의 %CLOTHES_TYPE_TR(COS_SAVE)%가 설정되었다.
		SELECTCASE COS_SAVE
			CASE "現在の衣装"
				CALL CTRL_CLOTHES_SET(C_ID, "TEMP_MODULAR", SET_ID)
			CASE "普段着"
				CALL CTRL_CLOTHES_SET(C_ID, "NORMAL_MODULAR", SET_ID)
			CASE "おきにいり衣装"
				CALL CTRL_CLOTHES_SET(C_ID, "FAVORTIE_MODULAR", SET_ID)
			CASE "パジャマ"
				CALL CTRL_CLOTHES_SET(C_ID, "PAJAMA_MODULAR", SET_ID)
		ENDSELECT
ENDSELECT
;着せ替え

@COM_ABLE429
;移動実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(429)
	RETURN RESULT
;私室設定
SIF (CFLAG:MASTER:現在位置 != CFLAG:MASTER:311) && (CFLAG:現在位置 != CFLAG:311)
	RETURN 0
SIF !GETBIT(CFLAG:TARGET:既成事実, 1) && TARGET != MASTER && !NASCheat:1
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
RETURN 1
