; Modular ERB: COMF/日常系/COMF351 連れ出す.ERB
;-------------------------------------------------
;連れ出す
;日常系コマンド、レベル2
;-------------------------------------------------

@COM351
#DIM NUM_TARGET
#DIM N_TO_M
NUM_TARGET = GET_TARGETNUM()
N_TO_M = 0
;連れ出す
VARSET LOCAL
SIF !NUM_TARGET
	RETURN -1
FOR LOCAL, 1, NUM_TARGET + 1
IF COM_351_CONDITION(TARGET:LOCAL) >= 2
	LOCAL:97 += 1
ENDIF
NEXT
IF NUM_TARGET == 1 || LOCAL:97 == 1
	IF COM_351_CONDITION(TARGET) < 1
		RETURN -1
	ELSEIF COM_351_CONDITION(TARGET) < 2
		DRAWLINE
		PRINTFORMW %CALLNAME:(TARGET)%은 바쁘다.
		RETURN -1
	ENDIF
	IF CFLAG:TARGET:同行
		CFLAG:TARGET:同行 = 0
		CFLAG:MASTER:同行 = 0
		TFLAG:PublicToyPlay = 0
		PRINTFORMW 리드 주위 취소했다.
	ELSE
		CFLAG:TARGET:同行 = 60
		;雨＋外＋傘or相手が傘の時は相合い傘
		SIF TIME:5 > 3 && TIME:5 < 14 && OUTROOF(CFLAG:MASTER:現在位置) && ((ITEM:折り畳み傘 && !nDontUseUmbrella) || EQUIP:TARGET:アクセサリ == 6) ;addition custom code
			TEQUIP:TARGET:201 = 1
		PRINTFORMW %CALLNAME:TARGET%주위를 이끈다.
		CFLAG:MASTER:同行 = 60
	ENDIF
	TIME += 1
	SIF CFLAG:TARGET:同行
		CALL KOJO_MESSAGE_SEND("DIRECT",351,TARGET,-1,-1)
	RETURN 1
ENDIF
;custom code
PRINTL
PRINTL
LOCAL:9 = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - LOCAL:9 > 0
	CLEARLINE LINECOUNT - LOCAL:9
;---------------------------------
PRINTL 누구를 초대해야 할까?
DRAWLINE ;custom code
FOR LOCAL, 1, NUM_TARGET + 1
SIF COM_351_CONDITION(TARGET:LOCAL) <= 0
	CONTINUE
IF CFLAG:(TARGET:LOCAL):同行
	SETCOLOR 255, 200, 100
ELSEIF CFLAG:(TARGET:LOCAL):同行準備
	SETCOLOR C_AQUA
ENDIF
PRINTFORML [{LOCAL,3}] - %CALLNAME:(TARGET:LOCAL)%
RESETCOLOR
NEXT
DRAWLINE ;custom code
PRINTL [ 97] - 주변을 돌기
PRINTL [ 98] - 모두 데려오기
PRINTL [ 99] - 주변 돌아가 취소하기
PRINTL [100] - 복귀
INPUT
SELECTCASE RESULT
	CASE 100
		FOR LOCAL, 1, NUM_TARGET + 1
		CFLAG:(TARGET:LOCAL):同行準備 = 0
		NEXT
		RETURN -1
	CASE 99
		FOR LOCAL, 1, NUM_TARGET + 1
		CFLAG:(TARGET:LOCAL):同行 = 0
		CFLAG:(TARGET:LOCAL):同行準備 = 0
		;相合い傘もなくなる
		TEQUIP:(TARGET:LOCAL):相合い傘 = 0
		NEXT
		PRINTFORMW 리드 어라운드가 취소되었다.
		CFLAG:MASTER:同行 = 0
		RETURN 1
	CASE 98
		FOR LOCAL, 1, NUM_TARGET + 1
		SIF COM_351_CONDITION(TARGET:LOCAL) == 2
			N_TO_M = 1
		NEXT
		IF N_TO_M > 0
			PRINTFORMW 일부 캐릭터는 현재 바쁘다.
			N_TO_M = 0
			CONTINUE
		ENDIF
		FOR LOCAL, 1, NUM_TARGET + 1
		IF COM_351_CONDITION(TARGET:LOCAL) >= 3
			CFLAG:(TARGET:LOCAL):同行 = 60
			LOCAL:98 += 1
		ENDIF
		NEXT
		PRINTFORMW 당신은 {LOCAL:98}을(를) 가지고 온다 \@ LOCAL:98 > 1 ? 사람들 # 사람 \@.
		CFLAG:MASTER:同行 = 60
		TIME += LOCAL:98
		SIF CFLAG:TARGET:同行
			CALL KOJO_MESSAGE_SEND("DIRECT",351,TARGET,-1,-1)
		RETURN 1
	CASE 97
		FOR LOCAL, 1, NUM_TARGET + 1
		IF (COM_351_CONDITION(TARGET:LOCAL) >= 2) && (CFLAG:(TARGET:LOCAL):同行準備 || CFLAG:(TARGET:LOCAL):同行)
			LOCAL:98 += 1
			SIF COM_351_CONDITION(TARGET:LOCAL) == 2
				N_TO_M = 1
		ENDIF
		NEXT
		SIF LOCAL:98 == 0
			CONTINUE
		IF LOCAL:98 == 1
			TIME += 1
			LOCAL = 0
			LOCAL:98 = 0
			FOR LOCAL, 1, NUM_TARGET + 1
			IF (COM_351_CONDITION(TARGET:LOCAL) >= 2) && (CFLAG:(TARGET:LOCAL):同行準備 || CFLAG:(TARGET:LOCAL):同行)
				PRINTFORMW 당신은 %CALLNAME:(TARGET:LOCAL)%을(를) 이끌기 시작한다.
				CFLAG:(TARGET:LOCAL):同行 = 60
				CFLAG:(TARGET:LOCAL):同行準備 = 0
				;雨＋外＋傘or相手が傘の時は相合い傘
				SIF TIME:5 > 3 && TIME:5 < 14 && OUTROOF(CFLAG:MASTER:現在位置) && ((ITEM:折り畳み傘 && !nDontUseUmbrella) || EQUIP:(TARGET:LOCAL):アクセサリ == 6) ;addition custom code
					TEQUIP:(TARGET:LOCAL):相合い傘 = 1
			ENDIF
			NEXT
		ELSE
			IF N_TO_M > 0
				PRINTFORMW 일부 캐릭터는 현재 바쁘다.
				N_TO_M = 0
				CONTINUE
			ENDIF
			PRINTFORMW 너는 {LOCAL:98}을/를 데려간다 \@ LOCAL:98 > 1 ? 사람 # 인 \@.
			TIME += LOCAL:98
			LOCAL = 0
			LOCAL:98 = 0
			FOR LOCAL, 1, NUM_TARGET + 1
			IF (COM_351_CONDITION(TARGET:LOCAL) >= 3) && (CFLAG:(TARGET:LOCAL):同行準備 || CFLAG:(TARGET:LOCAL):同行)
				CFLAG:(TARGET:LOCAL):同行 = 60
				CFLAG:(TARGET:LOCAL):同行準備 = 0
			ENDIF
			NEXT
		ENDIF
		CFLAG:MASTER:同行 = 60
		SIF CFLAG:TARGET:同行
			CALL KOJO_MESSAGE_SEND("DIRECT",351,TARGET,-1,-1)
		RETURN 1
	CASEELSE
		IF !INRANGE(RESULT, 1, NUM_TARGET)
			;CLEARLINE 1 ;custom code
			CONTINUE
		ELSEIF COM_351_CONDITION(TARGET:RESULT) < 1
			;CLEARLINE 1 ;custom code
			CONTINUE
		ELSEIF COM_351_CONDITION(TARGET:RESULT) < 2
			PRINTFORMW %CALLNAME:(TARGET:RESULT)%은 바쁘다.
			;CLEARLINE 2 ;custom code
			CONTINUE
		ENDIF
		;qol custom code
		IF CFLAG:(TARGET:RESULT):同行
			CFLAG:(TARGET:RESULT):同行 = 0
			CFLAG:(TARGET:RESULT):同行準備 = 0
			;相合い傘もなくなる
			TEQUIP:(TARGET:RESULT):相合い傘 = 0
			LOCAL:1 = 0
			FOR LOCAL, 1, NUM_TARGET + 1
			SIF CFLAG:(TARGET:LOCAL):同行
				LOCAL:1 = 1
			NEXT
			SIF !LOCAL:1
				CFLAG:MASTER:同行 = 0
		ELSE
			CFLAG:(TARGET:RESULT):同行準備 ^= 1
		ENDIF
ENDSELECT
LOOP 1

@EQUIP_COM351(ARG)
;ソースは控えめに適当。愛情入りすぎたので自重
IF FLAG:70 == 1
ELSE
	SOURCE:歓楽 += ABL:親密 * 5
	SOURCE:情愛 += ABL:親密 * 5
	SOURCE:反感 += 100 - MIN(ABL:親密 * 10,100)
	SIF ABL:親密 > 9 && TIME_PROGRESS(TIME:1) > 10
		EXP:ARG:愛情経験 += RAND:2
ENDIF
RETURN 1
