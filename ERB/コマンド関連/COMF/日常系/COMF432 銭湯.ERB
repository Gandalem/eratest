#DIM 回復前気力２
#DIM 回復後体力２
#DIM 回復後気力２
#DIMS 台詞
回復前体力１ = BASE:MASTER:体力
回復前気力１ = BASE:MASTER:気力
IF DAY * 1440 + TIME - EX:MASTER:前回の入浴時刻 < 360
	TFLAG:194 = 1
	PRINTFORML Just got in a short while ago.
	RETURN -1
ELSEIF PLACE_SENTO(CFLAG:MASTER:現在位置) == 2
	;番台ちゃんを怒らせてしまった場合
	IF TFLAG:209 == 4
		CALL SPTALK, 0, "怒り", 14, "「.........」",1
