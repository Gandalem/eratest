					IF TARGET != MASTER && CFLAG:TARGET:6 > 0 && !CFLAG:TARGET:睡眠
						PRINTFORMW You and %CALLNAME:TARGET% relax at the hot spring, enjoying yourselves together.
					ELSE
						PRINTFORMW You relax \@ LOCAL ? in the privacy of your exclusive bathing room, alone and lonely # at the hot spring\@.
					ENDIF
					CALL TRIPLEDOT, "reverse:timed" ;custom code
					;旧地獄温泉は30分固定
					TIME += 30
					;旧地獄温泉総入湯回数はフラグごとオミット
