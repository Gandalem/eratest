				CALL SPTALK, 0, "通常", 14, @"%台詞%",1
				;煽り耐性無い番台ちゃんブチギレ
				IF TFLAG:209 >= 2
					台詞 =  「...Listen, I don't have time for this either.」/「I can get angry too when it comes down to it, you know?」
					CALL SPTALK, 0, "怒り", 14, @"%台詞%",1
					TFLAG:209 = 4
				ELSE
					;I always thought she suggested the hot springs at the underworld, but that one is even more expensive, so hakurei shrine's bath might be the next logical choice as far as publicity goes
					{
					台詞 = 「Look, this might come out of left field, but...」
							/「If you're really strapped for cash right now, how about a little suggestion?」
							/「It's quite a walk from here, but there's a hot spring near the top of the hill by the Shrine.」/「Why don't you go there instead of bothering me for nothing?」
					}
					CALL SPTALK, 0, "通常", 14, @"%台詞%",1
					TFLAG:209 = 3
				ENDIF
				RETURN -1
			ELSE
				CALL PAY_SENTO, 400
				台詞= 「...Mhmm, go right ahead and enjoy...」
				SIF TARGET != MASTER && CFLAG:TARGET:6 > 0 && !CFLAG:TARGET:睡眠 
					台詞 = %台詞%/「...Oh, and just so you know, I'll be keeping an eye on you, so don't try anything funny.」
