			IF MONEY < 5000
				{
				台詞 = 「...Oh, you want to rent out the place? And how much do you think you can pay for it? Is that so.」
						/「Look here, this kind of service requires fair compensation. Get it?」
						/「So quit acting up and just bathe at home if you haven't even got two yen to rub together!」
				}
				CALL SPTALK, 0, "通常", 14, @"%台詞%",1
				RETURN -1
			ELSE
				CALL PAY_SENTO, 5000
				{
				台詞 = 「...Oh, you want to rent out the place?」
						/「Hmph... I mean, I can pretty much guess what it's going to be used for...」
						/「Well, since you're such a well-paying customer, I'm willing to turn a blind eye.」/「Tell you what, it's yours for the next 24 hours.」
						/「So be my guest, enjoy your time...」
				}
				CALL SPTALK, 0, "通常", 14, @"%台詞%",1
				CALLF 銭湯貸切(DAY, 1)
				RETURN 1
			ENDIF
		ELSEIF RESULT == 1
			IF MONEY < 400
				{
				台詞 = 「...Mhmm, go right ahead and enjoy...」
						/「Hey, wait a sec! Are you pulling my leg here?! That's not nearly enough!」
						/「.........」
