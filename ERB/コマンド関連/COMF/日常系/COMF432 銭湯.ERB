@PLACE_SENTO(ARG)
#FUNCTION
;人里
IF ARG == GET_MAP_REPLACEMENT(223)
	RETURNF 2
;地底
ELSEIF ARG == GET_MAP_REPLACEMENT(934)
	RETURNF 9
ELSE
	RETURNF 0
ENDIF

@PAY_SENTO, ARG
#DIM PLACE, 1

MONEY -= ARG
PLACE = PLACE_SENTO(CFLAG:MASTER:現在位置)
SIF !PLACE
	RETURN 0

SENTO_CONSUMPTION:PLACE += ARG
SELECTCASE PLACE
	CASE 9
		;2万以上消費した場合、ニュープランが選択できるようになる
		IF SENTO_CONSUMPTION:9 >= 旧地獄温泉_ニュープラン_必要額
			旧地獄温泉_ニュープラン_完成日 = DAY + 旧地獄温泉_ニュープラン_工期
		ENDIF
ENDSELECT
RETURN 1

@ODEKAKE_OFURO(ARG,ARG:1)
;logging custom code - restoration effects from the cypress bath
#DIM 回復率_体力, 4
#DIM 回復率_気力, 4
#DIM 回復率_精力, 4
#DIM DYNAMIC Restore
;------------------------------------

;ARG=1人里　ARG=2地底 =3プール
RESET_STAIN ARG
STAIN:ARG:4 = 0
CFLAG:ARG:膣内射精 = 0
CFLAG:ARG:アナル射精 = 0
CFLAG:ARG:口に精液 = 0
CFLAG:ARG:顔に精液 = 0
CFLAG:ARG:手に精液 = 0
CFLAG:ARG:脇に精液 = 0 ;custom code
;NAS: bug fix
CFLAG:ARG:風呂 = MAX(CFLAG:ARG:風呂 - 1000,0)
SIF TALENT:ARG:機嫌 == -1 && (SoiledSelf:ARG:0 || SoiledSelf:ARG:1)
	TALENT:ARG:機嫌 = 0
SoiledSelf:ARG:0 = 0
SoiledSelf:ARG:1 = 0
TCVAR:ARG:PeeAccidentTime = 0
TCVAR:ARG:PooAccidentTime = 0
BASE:ARG:尿意 = 0
IF PantiesType:ARG:0 == "Naked" || ARG != MASTER
	CALLF DiapeStats(ARG,CFLAG:ARG:きょうのぱんつ,1)
ENDIF
SELECTCASE ARG:1
	CASE 1
		;logging custom code
		回復率_体力:0 = 200
		回復率_気力:0 = 300

		回復率_体力:1 = 250
		回復率_気力:1 = 350

		回復率_体力:2 = 300
		回復率_気力:2 = 400

		回復率_体力:3 = 350
		回復率_気力:3 = 500

		SIF ITEM:ヒノキ風呂 && NEAR_BATH() == CFLAG:MASTER:現在位置
			Restore = MIN(ITEM:ヒノキ風呂,3)
	
		CALL RECOVER_PERMIL(ARG, 回復率_体力:Restore, "体力", 1) ;logging custom code
		CALL RECOVER_PERMIL(ARG, 回復率_体力:Restore, "気力", 1) ;logging custom code
	CASE 2
		CALL RECOVER_PERMIL(ARG, 300, "体力", 1)
		CALL RECOVER_PERMIL(ARG, 400, "気力", 1)
	CASE 3
		CALL RECOVER_PERMIL(ARG, 60, "体力", 1)
		CALL RECOVER_PERMIL(ARG, 150, "気力", 1)
ENDSELECT
SIF ARG == MASTER
	EX:MASTER:前回の入浴時刻 = DAY * 1440 + TIME