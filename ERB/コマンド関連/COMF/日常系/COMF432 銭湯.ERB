		PRINTFORML Better try coming back another day...
		RETURN -1
	;番台ちゃん通常運行
	ELSE
		;お金足りなかったイベントを見ている
		IF TFLAG:209 == 3
			台詞 = 「...Oh, it's you.」/「Mmm, well? Any luck scrounging up some money for the fee this time?」
		;やめるを選んだけどやっぱり入りたくなった
		ELSEIF TFLAG:209 == 2
			台詞 = 「...Huh, changed your mind? Fancy to go in?」
