TEQUIP:CHR:お風呂場プレイ = 0
CFLAG:CHR:同行 = 0
CFLAG:CHR:お招き = 0
NEXT
TFLAG:MASTERのＰ挿入中 = 0
;あなたの現在位置を戻してサービス終了
FLAG:デート相手 = MASTER
SIF MOREDATE
	CALL CLEAN_GROUP_DATES
CFLAG:MASTER:デート中 = 9
CFLAG:MASTER:現在位置 = CFLAG:RANDOM_CHARANUM:遭遇位置
TFLAG:泡風呂 = 0
ITEM:20 = TFLAG:マット貸し出し ? 0 # ITEM:20
