SELECTCASE ARGS
	CASE "タイムアップ"
		CALL TALK_MOBGIRL("泡姫タイムアップ", 延長回数)
		RESETCOLOR
		延長回数 ++
		SIF RESULT
			RETURN
	CASE "コマンドから終了"
		CALL TALK_MOBGIRL("泡姫コマンドから終了", 延長回数)
	CASE "攻守交代時終了"
		CALL TALK_MOBGIRL("泡姫攻守交代時終了")
