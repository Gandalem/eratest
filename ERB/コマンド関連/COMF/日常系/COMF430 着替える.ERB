; Modular ERB: COMF/日常系/COMF430 着替える.ERB
;-------------------------------------------------
;着替える
;日常系コマンド、レベル1
;-------------------------------------------------

@COM430
#DIM 対象
#DIM 種類
;replaced
CALL COM430_PANTY_REWORK
RETURN RESULT
;困ったことに固有はキャラで名称判定しているのであなたが履くと名前が変わる
PRINTW 도둑맞은 팬티로 갈아입을까?
DRAWLINE
CALL DISPLAY_ALL_COLLECTION(1,1)
DRAWLINE
PRINTFORML [0] 신경 쓰지 마
$INPUT_LOOP
INPUT
IF RESULT == 0
	RETURN 0
ELSE
	対象 = RESULT / 100
	種類 = RESULT % 100
	CALL SPEND_HAVE_COLLECTION(RESULT)
	IF RESULT != 0
		CFLAG:MASTER:206 = 種類
		CFLAG:MASTER:246 = 種類
		CFLAG:MASTER:きょうのぱんつ = 種類
		CFLAG:MASTER:パジャマパンツ = 種類
		PRINTFORM 너 
		IF EQUIP:MASTER:下半身下着２ == 0
			PRINTFORML %CALLNAME:(対象)%의 %PANTSNAME(種類, 対象)%로 바뀐다.
		ELSE
			PRINTFORML 당신의 %PANTSNAME(EQUIP:MASTER:下半身下着２)%을 벗고 그것들을 %CALLNAME:(対象)%의 %PANTSNAME(種類, 対象)%으로 교체하라.
		ENDIF
		EQUIP:MASTER:下半身下着２ = 種類
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ENDIF
IF !FLAG:時間停止
	TIME += 3
ELSE
	BASE:MASTER:TSP -= 5
ENDIF
RETURN 1
;着替える

@COM_ABLE430
;移動実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(430)
	RETURN RESULT
;私室設定
SIF (CFLAG:MASTER:現在位置 != CFLAG:MASTER:311) && (CFLAG:現在位置 != CFLAG:311)
	RETURN 0
;SIF CSTR:MASTER:12 == ""
SIF !FLAG:パンツ輸送
	RETURN 0
;NAS: Non 0 MASTER
SIF !FLAG:時間停止 && (!GETBIT(CFLAG:TARGET:既成事実, 1) && TARGET != MASTER)
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
RETURN 1
