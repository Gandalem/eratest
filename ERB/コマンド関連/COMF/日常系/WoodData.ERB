; Modular ERB: COMF/日常系/WoodData.ERB
;logging patch custom code

@WoodData(W_ID)
#DIM W_ID
;WoodName = 名前
;WoodValue_Log = 丸太売り（里の材木屋）の基礎価格
;WoodValue_Plank = 製材売り（山の製材屋）の基礎価格
;WoodEffort = 伐採所要時間　TSPの消費量
;WoodItem = 直接入手するアイテム　644=丸太　645=青竹（複数持ち可）　646=香木
;WoodIntro = 説明文
;WoodTribe = 分布・樹種・特徴のタグ
SELECTCASE W_ID
	CASE 1
		WoodName = Cedar
		WoodValue_Log = 2500
		WoodValue_Plank = 2000
		WoodEffort = 800
		WoodItem = 644
		WoodIntro1 = Native to Japan and symbolic of Japanese wood culture. Easy to work with, as the wood does not harden as much.
		WoodIntro2 = The most common tree you can find, boasting the number one spot as its habitat area.\n　For this reason, the large amount of pollen that the trees release into the air in early spring is a cause for concern.
		WoodTribe = 博/魔/深/山/常緑/針葉/湿潤/軟質/
	CASE 2
		WoodName = Cypress
		WoodValue_Log = 3750
		WoodValue_Plank = 3000
		WoodEffort = 800
		WoodItem = 644
		WoodIntro1 = A tree that has been used extensively for its superior building qualities.　Durable and does not rot even after more than 1,000 years.
		WoodIntro2 = It has a good color, luster, easy workability and a unique aroma, all of which make it well deserving of its title\n　as the best building material out there.
		WoodTribe = 博/魔/深/山/常緑/針葉/乾湿/軟質/
	CASE 3
		WoodName = Pine
		WoodValue_Log = 3750
		WoodValue_Plank = 3000
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = An auspicious tree that grows in sunny places such as mountain ridges.　The trunk is bent, making it unsuitable for columns and the like,\n　but it is very strong and is often used for beams or other supporting structures.
		WoodIntro2 = Known to symbiotically coexist with matsutake mushrooms, and its oily wood was once held in great value as a high-quality source of fuel.
		WoodTribe = 博/深/山/常緑/針葉/乾燥/中硬/
	CASE 4
		WoodName = Evergreen
		WoodValue_Log = 5000
		WoodValue_Plank = 4200
		WoodEffort = 1800
		WoodItem = 644
		WoodIntro1 = A member of the Fagaceae family, known for its acorns.　Very rigid as a material, making it one of the hardest woods in Japan.
		WoodIntro2 = Widely used as a component that requires exceptional durability, such as spear and axe handles,\n　a casing for hand planes, abacus beads, wooden swords, and material for high-quality charcoal.
		WoodTribe = 博/魔/深/山/落葉/広葉/乾湿/硬質/
	CASE 5
		WoodName = Beech
		WoodValue_Log = 2500
		WoodValue_Plank = 2000
		WoodEffort = 1400
		WoodItem = 644
		WoodIntro1 = Widespread as the mainstay of deciduous hardwood forests in cool temperate northern regions.　It was used for both timber and charcoal.
		WoodIntro2 = In contrast to the satoyama woodlands and the evergreen forest cultures that are associated with rice cultivation,\n　the bounty of the deep beech forests has nurtured a wide variety of species\n　and given rise to unique customs such as the traditional winter hunters of Tohoku called matagi.
		WoodTribe = 深/山/落葉/広葉/湿潤/中硬/
	CASE 6
		WoodName = Ginkgo
		WoodValue_Log = 3750
		WoodValue_Plank = 3000
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = This tree belongs to the Ginkgoaceae family and is a "living fossil", being the last living species since the Jurassic period\n　about two hundred million years ago.　This tree is unique in that it produces sperm to reproduce.
		WoodIntro2 = Its wood is white, dense and beautiful and is used to make Buddhist fish gongs, go boards, cutting boards and lacquer ware.
		WoodTribe = 博/魔/落葉/広葉/乾湿/中硬/
	CASE 7
		WoodName = Zelkova
		WoodValue_Log = 8000
		WoodValue_Plank = 7100
		WoodEffort = 1800
		WoodItem = 644
		WoodIntro1 = A tree belonging to the Elm family.\n　Because it grows quickly and has a long lifespan, many large and giant trees can be found in various areas and are often considered sacred.
		WoodIntro2 = The wood has excellent strength and durability, and its grain is no less beautiful.\n　It is one of the finest hardwoods and is used for a variety of purposes including construction, furniture and sculpture.
		WoodTribe = 博/魔/深/落葉/広葉/乾湿/硬質/
	CASE 8
		WoodName = Paulownia
		WoodValue_Log = 5400
		WoodValue_Plank = 4700
		WoodEffort = 600
		WoodItem = 644
		WoodIntro1 = A tree belonging to the Paulowniaceae family.\n　Because it grows quickly and is light with little warping, it was widely used for high-quality chests,\n　geta [Japanese wooden clogs], koto [Japanese harps], Noh masks, and paulownia boxes.
		WoodIntro2 = It is also used to line safes due to its ability to quickly scorch and carbonize the surface when ignited,\n　preventing further combustion of the interior.
		WoodTribe = 博/魔/深/落葉/広葉/乾湿/軟質/
	CASE 9
		WoodName = Oak
		WoodValue_Log = 4050
		WoodValue_Plank = 3400
		WoodEffort = 1400
		WoodItem = 644
		WoodIntro1 = Oak: A tree belonging to the Fagaceae family.\n　Although it grows slowly and is difficult to replenish through reforestation,\n　its wood is heavy and hard, with a beautiful pattern on the quarter-sawn grain.
		WoodIntro2 = Used extensively as a material for high-end furniture and interior decoration, as well as for barrels used to age whiskey.
		WoodTribe = 博/魔/深/山/落葉/広葉/乾湿/硬質/
	CASE 10
		WoodName = Maple
		WoodValue_Log = 4050
		WoodValue_Plank = 3400
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = A tree belonging to the Sapindaceae family.\n　The original Japanese name "kaede" comes from its leaves, which resemble frog's paws.
		WoodIntro2 = Its sap is called maple syrup.　The wood is hard and durable and is widely used for musical instruments and furniture.
		WoodTribe = 博/深/山/落葉/広葉/乾湿/硬質/
	CASE 11
		WoodName = Betula
		WoodValue_Log = 4800
		WoodValue_Plank = 4000
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = A tree belonging to the birch family.\n　A tree species that often grows at high altitudes, vigorous and strong enough to withstand the weight of snow.
		WoodIntro2 = The reddish bark is often used as tinder and for tanning,\n　and the wood has a unique luster and texture that makes it valuable as a furniture material.
		WoodTribe = 山/落葉/広葉/乾湿/中硬/
	CASE 12
		WoodName = Bamboo
		WoodValue_Log = 500
		WoodValue_Plank = 300
		WoodEffort = 300
		WoodItem = 645
		WoodIntro1 = A plant belonging to the Poaceae family.\n　A perennial herb that is similar in appearance to a tree, but is said to bloom every few decades and then wither.
		WoodIntro2 = The bamboo is strong and flexible in the horizontal plane, but splits easily in the vertical plane,\n　allowing it to be used as a material for various types of bamboo ware.
		WoodTribe = 竹/常緑/広葉/乾湿/軟質/サイズ無視/
	CASE 13
		WoodName = Incense Wood
		WoodValue_Log = 15000
		WoodValue_Plank = 15000
		WoodEffort = 600
		WoodItem = 646
		WoodIntro1 = A tree that secretes a special resin or essential oil containing aromatic components. Sandalwood and agarwood are well-known examples.
		WoodIntro2 = Products that release fragrance at room temperature are used for prayer beads, Buddhist statues, scent bags, and so on.
		WoodTribe = 竹/深/常緑/広葉/湿潤/軟質/希少/サイズ無視/
	CASEELSE
		WoodValue_Log = 0
		WoodValue_Plank = 0
ENDSELECT
