; Modular ERB: COMF/日常系/COMF491 ホワイトデー.ERB
;-------------------------------------------------
;ホワイトデー
;-------------------------------------------------

@COM491
#DIM CAN_COOK
#DIM 親密係数
#DIM 信頼係数
#DIM WD_BUFF
#DIMS WD_GIFT
#DIMS WD_GIFT_TR ;custom code
親密係数 = 0
信頼係数 = 0
CAN_COOK = 0
WD_BUFF = 0
;調理可能か
CALL COM_ABLE413
CAN_COOK = RESULT
IF FESTIVAL() == "ホワイトデー" && INRANGE(CFLAG:TARGET:バレンタイン,1,4) && SHIRAHU(TARGET)
	CALL ASK_M("답례품 받는 사람",1,"쿠키로 답례품 사탕 주기 (요구 재료: 사탕 5개)",ITEM:甘味材 >= 5,@"선물은 %조사처리(CALLNAME:TARGET,"에게")% 준다.",1)
ELSE
	CALL ASK_M("선물 수령자",1,"요리 완성 선물 사탕 (요구 사항: 감미료 5개)",ITEM:甘味材 >= 5)
ENDIF
SELECTCASE RESULT
	CASE 0
		CALL Valentine_List
		WAIT
		RETURN -1
	CASE 1
		IF !CAN_COOK
			;com stuff custom code
			IF !KITCHEN(CFLAG:MASTER:現在位置)
				PRINTFORMW 요리할 수 있는 곳으로 먼저 이동해야 한다.
			ELSEIF BASE:MASTER:気力 <= 0
				PRINTFORMW 당신은 이것을 하기에 정신적으로 조금 너무 지쳐 있다.
			ELSEIF DISH_NAME != "" ;allow making chocolate while having a dish on hand
				CALL WD_COOK
				RETURN RESULT
			ELSE
				PRINTFORMW 지금은 할 수 없다.
			ENDIF
			RETURN -1
		ENDIF
		CALL WD_COOK
		RETURN RESULT
	CASE 2
		;Custom code: remove White Day Chocolate and White Day Custard because they haven't been implemented yet
		PRINTFORML 무엇을 답례 선물로 줄 건가요? (받은 선물: %CAPITALIZE(Valentine_Chocolate(TARGET))%)
		CALL ASK_M("취소",1,"블랙 썬더",ITEM:ブラックサンダー,"로터 초콜릿",ITEM:ローターチョコ,"수제 초콜릿 쿠키",ITEM:手作りチョコクッキー,"수제 커스터드",ITEM:手作りプディング,@"장식된 케이크 %COND_STR(@" (Only in return for Handmade Chocolate)", CFLAG:TARGET:バレンタイン != 4)%",ITEM:デコレーションケーキ && CFLAG:TARGET:バレンタイン == 4)
		SELECTCASE RESULT
			CASE 0
				RETURN -1
			CASE 1
				WD_GIFT = ブラックサンダー
				;custom code: from here on out - WD_GIFT_TR used to return translated gift name
				WD_GIFT_TR '= @"블랙 썬더"
				SIF CFLAG:バレンタイン > 1 ;gifting the cheap throwaway store-bought chocolate in return to a proper gift reaction?
					PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 완전히 어리둥절해 보인다...
				親密係数 = 5
			CASE 2
				WD_GIFT = ローターチョコ
				WD_GIFT_TR '= @"로터 초콜릿"
				親密係数 = 10
				SOURCE:快Ｃ += 3000
				SOURCE:反感 += 300
				;Custom code: remove this because it isn't implemented
				; CASE 3
				; 	WD_GIFT = WDチョコレート
				; 	WD_GIFT_TR = White Day Chocolate
				; 	親密係数 = 25
				; 	WD_BUFF = 100
			CASE 3
				WD_GIFT = 手作りチョコクッキー
				WD_GIFT_TR '= @"수제 초콜릿 쿠키"
				親密係数 = 50
				EXP:愛情経験 += 1
				WD_BUFF = 100
				;Custom code: remove this because it isn't implemented
				; CASE 5
				; 	WD_GIFT = WDプディング
				; 	WD_GIFT_TR = White Day Custard
				; 	親密係数 = 70
				; 	EXP:愛情経験 += 3
				; 	WD_BUFF = 100
			CASE 4
				WD_GIFT = 手作りプディング
				WD_GIFT_TR '= @"수제 커스터드"
				親密係数 = 80
				EXP:愛情経験 += 5
				WD_BUFF = 200
			CASE 5
				WD_GIFT = デコレーションケーキ
				WD_GIFT_TR '= @"장식된 케이크"
				親密係数 = 200
				EXP:愛情経験 += 30
				WD_BUFF = 1000
		ENDSELECT
		TFLAG:193 = RESULT
		SIF RESULT >= 5
			TALENT:機嫌 = 1
		PRINTFORMW 당신은 %WD_GIFT_TR%을(를) %조사처리(CALLNAME:TARGET,"에게")% 건넨다!
		;ITEM:WD_GIFT --
		;custom code
		CALL LOST_ITEM(WD_GIFT, 1, 1)
		CALL JUEL_UP_SPECIAL(TARGET,"好意","親密",親密係数,1)
		CALL CHANGE_CFLAG(4,TARGET,親密係数)
		IF WD_BUFF
			CALL BUFF_BASE(TARGET,BASE_体力, WD_BUFF, 1)
			CALL BUFF_BASE(TARGET,BASE_気力, WD_BUFF, 1)
		ENDIF
		;custom code, add source (based on gift shop's, slightly reduced because of strong gifts)
		SOURCE:歓楽 = 800 + 800 * TFLAG:193 + 400 * 好感度係数(TARGET)
		SOURCE:受動 = 600 + 800 * TFLAG:193 + 400 * ABL:従順
		SOURCE:征服 = 600 + 500 * TFLAG:193 + 900 * ABL:サドっ気
		;-----------------------------
		CFLAG:TARGET:バレンタイン += 100
		TIME += 10
		RETURN 1
ENDSELECT

@Valentine_List
;qol custom code, keep count
#DIM DYNAMIC HANDMADE
#DIM DYNAMIC PREMIUM
#DIM DYNAMIC ORDINARY
#DIM DYNAMIC OBLIGATORY
FOR LOCAL,1,CHARANUM
SIF !CFLAG:LOCAL:バレンタイン
	CONTINUE
SELECTCASE CFLAG:LOCAL:バレンタイン % 100
	CASE 1 ;qol custom code
		OBLIGATORY++
	CASE 2
		SETCOLOR C_GREEN
		ORDINARY++ ;qol custom code
	CASE 3
		SETCOLOR C_YELLOW
		PREMIUM++ ;qol custom code
	CASE 4
		SETCOLOR C_PINK
		HANDMADE++ ;qol custom code
	CASEELSE
ENDSELECT
;返礼済みなら打ち消し線
SIF CFLAG:LOCAL:バレンタイン > 100
	FONTSTYLE 4
PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
FONTREGULAR
RESETCOLOR
NEXT
PRINTFORML 
DRAWLINE
SETCOLOR C_PINK
PRINTFORM 수제%COND_STR(@" ({HANDMADE})", HANDMADE)%　
SETCOLOR C_YELLOW
PRINTFORM 프리미엄%COND_STR(@" ({PREMIUM})", PREMIUM)%　
SETCOLOR C_GREEN
PRINTFORM 평범한%COND_STR(@" ({ORDINARY})", ORDINARY)%　
RESETCOLOR
;original uses 義理 which would be "out of obligation/courtesy", but it's too confusing
PRINTFORML 블랙 썬더 %COND_STR(@" ({OBLIGATORY})", OBLIGATORY)%

@WD_COOK
;bug fix for no checking sweeteners
#DIM CONST WD_SWEET_NEED = 5
#DIM WD_HAS_SWEETS
WD_HAS_SWEETS = ITEM:甘味材 >= WD_SWEET_NEED
PRINTFORML 무엇을 만들까? (모든 아이템은 최소 5개의 감미재가 필요하다(소유: x{ITEM:甘味材}))
PRINTFORM 현재 요리기능 (α): 
CALL PRINT_RANK(ABL:MASTER:料理技能,"MAX_6")
PRINTFORML  {ABL:MASTER:料理技能}
CALL ASK_M("취소",1, "초콜릿 쿠키×10＋α: 대량으로 만들 수 있다. 나눠주기에 완벽하다.",WD_HAS_SWEETS, @"커스터드×5＋α: 균형 잡힌 선택이다.(요구사항: 벌꿀 (보유량: {ITEM:はちみつ}x))",ITEM:はちみつ && WD_HAS_SWEETS, @"장식된 케이크: 가장 소중한 사람들을 위해.(요구사항: 딸기 3개(보유량: x{ITEM:イチゴ}), 요리기능 {UniversalRank("A")} (현재:{ABL:MASTER:料理技能}))",ITEM:イチゴ >= 3 && ABL:MASTER:料理技能 >= UniversalRank("A") && WD_HAS_SWEETS, @"로터 초콜릿×5:'로터리' 필링이 들어있는 먹을 수 있는 미스터리 초콜릿입니다.(요구: 로터 (소유: x{ITEM:ローター}))",ITEM:ローター && WD_HAS_SWEETS)
SELECTCASE RESULT
	CASE 0
		RETURN -1
	CASE 1
		CALL GET_ITEM("手作りチョコクッキー", 10 + LEVEL_TO_RANK(ABL:MASTER:料理技能), 2)
		;ITEM:甘味材 -= 5
		;custom code
		CALL LOST_ITEM("甘味材", 5, 2)
	CASE 2
		CALL GET_ITEM("手作りプディング", 5 + LEVEL_TO_RANK(ABL:MASTER:料理技能) / 3, 2)
		;ITEM:甘味材 -= 5
		;ITEM:はちみつ -= 1
		;custom code
		CALL LOST_ITEM("甘味材", 5, 1)
		CALL LOST_ITEM("はちみつ", 1, 1)
	CASE 3
		;ITEM:甘味材 -= 5
		;ITEM:イチゴ -= 3
		CALL GET_ITEM("デコレーションケーキ", 1, 1)
		;custom code
		CALL LOST_ITEM("甘味材", 5, 1)
		CALL LOST_ITEM("イチゴ", 3, 1)
	CASE 4
		CALL GET_ITEM("ローターチョコ", 5, 1)
		;ITEM:甘味材 -= 5
		;ITEM:ローター -= 1
		;custom code
		CALL LOST_ITEM("甘味材", 5, 1)
		CALL LOST_ITEM("ローター", 1, 1)
ENDSELECT
TIME += 60
EXP:MASTER:料理経験 += 3
DOWNBASE:MASTER:気力 = 300
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE491
;チョコレートを贈る実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(491)
	RETURN RESULT
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;添い寝中
SIF CFLAG:添い寝中
	RETURN 0
;イタズラ中
SIF CFLAG:MASTER:イタズラ
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
SIF !PREPARE_WD()
	RETURN 0
IF FESTIVAL() != "ホワイトデー"
	SIF !KITCHEN(CFLAG:MASTER:現在位置)
		RETURN 0
ENDIF
RETURN 1

@PREPARE_WD()
#FUNCTION
SIF DAY:2 != 1
	RETURNF 0
SIF DAY:3 > 14
	RETURNF 0
SIF SUMCARRAY(CFLAG:バレンタイン) == 0 ;qol custom code, don't show if there are no gifts to hand out
	RETURNF 0
RETURNF 1
;デバッグ用

@WD_DEBUG
#FUNCTION ;custom code
ITEM:甘味材 = 99
ITEM:イチゴ = 99
ITEM:はちみつ = 99
DAY:2 = 1
DAY:3 = 13
FOR LOCAL,1,CHARANUM
CFLAG:LOCAL:バレンタイン = 1 + RAND:4
NEXT
