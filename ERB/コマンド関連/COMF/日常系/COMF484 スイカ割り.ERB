; Modular ERB: COMF/日常系/COMF484 スイカ割り.ERB
;スイカ割り

@COM484
#DIM CHARA
#DIM 同室人数
#DIM 参加可能人数
;雨天中止
IF GROUPMATCH(天候, 4, 5, 6, 7, 8, 10, 11, 12, 13) || GROUPMATCH(FLAG:異常気象, 9, 10)
	IF OUTROOF(CFLAG:MASTER:現在位置)
		PRINTFORMW 날씨가 이렇게 안 좋은데, 나중에 하는 걸 고려해 보는 게 어떨까...
		RETURN -1
	ENDIF
	;料理がある
ELSEIF DISH_NAME != ""
	PRINTFORMW 아마 당신 몸에 있는 음식을 먼저 처리해야 할 것 같다...
	RETURN -1
ENDIF
;参加可能人数チェック
参加可能人数 = 0
同室人数 = GET_TARGETNUM()
FOR LOCAL, 1, 同室人数 + 1
CHARA = TARGET:LOCAL
SIF !SHIRAHU(CHARA)
	CONTINUE
SIF CFLAG:CHARA:行動 == 5 && !(CFLAG:CHARA:職種 == 49 && ADD_BANQUET_ACTIVITY_ALLOWED("WATERMELON")) ;addition custom code, allow for banquets
	CONTINUE
SIF BASE:CHARA:気力 < 500 || BASE:CHARA:体力 < 500
	CONTINUE
参加可能人数 ++
NEXT
;TARGETは実行判定で可能なはずなのでエラーチェック
SIF 参加可能人数 == 0
	THROW
SUIKA_PLAYERNUM = 0
CALL SUIKA_CHARASELECT(同室人数, 参加可能人数)
;キャンセル
SIF RESULT == -1
	RETURN -1
;武器選択
CALL SUIKA_WEAPONSELECT
;開幕地の文
DRAWLINE
IF GROUPMATCH(SUIKA_WEAPON, "打ち出の小槌", "制御棒") ;miracle mallet, control rod
	PRINTFORML 너는 안대를 착용하고 그 자리에서 온 마음을 다해 돌기 시작한다...
ELSE
	PRINTFORML 당신은 안대를 쓰고 바닥에 %SUIKA_WEAPON_TR(SUIKA_WEAPON)%를 휘두르는 것에 집중한다...
ENDIF
;セットアップ
CALL SUIKA_SETUP
WAIT
;TARGETが参加していない場合はTARGETを変更しておく
IF FLAG:デート相手 != MASTER
	;参加しなくても最優先,そんなひどいことする？
	TARGET = FLAG:デート相手
ELSEIF !MATCH(SUIKA_PLAYER, TARGET)
	;一人目をターゲットに変更
	TARGET = SUIKA_PLAYER:1
ENDIF
TARGET = SUIKA_PLAYER:1
;ゲーム開始
CALL SUIKA_SMASHING
TFLAG:193 = RESULT
;ソース獲得
DOWNBASE:MASTER:体力 = 200
DOWNBASE:MASTER:気力 = 300
FOR LOCAL, 1, SUIKA_PLAYERNUM + 1
CHARA = SUIKA_PLAYER:LOCAL
DOWNBASE:CHARA:気力 += 100
DOWNBASE:CHARA:体力 += 50
SELECTCASE TFLAG:193
	CASE 0
		SOURCE:CHARA:歓楽 = 1500 + ABL:CHARA:親密 * 100
		SOURCE:CHARA:受動 = 100 + 50 * ABL:CHARA:従順
		SOURCE:CHARA:征服 = 200 + 80 * ABL:CHARA:サドっ気
	CASE 1, 2
		SOURCE:CHARA:歓楽 = 2500 + ABL:CHARA:親密 * 100
		SOURCE:CHARA:受動 = 200 + 60 * ABL:CHARA:従順
		SOURCE:CHARA:征服 = 400 + 120 * ABL:CHARA:サドっ気
	CASE -1
		IF SUIKA_LIAR:LOCAL || CHARA == [[正邪]]
			SOURCE:CHARA:歓楽 = 1500 + ABL:CHARA:親密 * 100
			SOURCE:CHARA:征服 = 400 + 120 * ABL:CHARA:サドっ気
		ELSE
			SOURCE:CHARA:歓楽 = 800 + ABL:CHARA:親密 * 100
			SOURCE:CHARA:受動 = 100 + 50 * ABL:CHARA:従順
			SOURCE:CHARA:征服 = 50 + 20 * ABL:CHARA:サドっ気
		ENDIF
ENDSELECT
IF TFLAG:193 >= 0
	SIF CHARA == TARGET
		TFLAG:信頼度管理 = 1 + TFLAG:193
	IF TFLAG:193 == 2
		TIMES SOURCE:CHARA:歓楽, 1.20
		TIMES SOURCE:CHARA:受動, 1.20
		TIMES SOURCE:CHARA:征服, 1.20
	ENDIF
ENDIF
;口上用に役職情報を渡しておく
SIF CHARA == TARGET && (SUIKA_LIAR:LOCAL || CHARA == [[正邪]])
	TFLAG:194 = 1
;◆口上
CALL KOJO_MESSAGE_SEND("SUIKA", 0, CHARA, SUIKA_LIAR:LOCAL, 0, "結果")
IF RESULTS != ""
	PRINTL 
	PRINTFORML %CALLNAME:CHARA%
	PRINTFORMW 「%RESULTS%」
	RESETCOLOR
ENDIF
;なるべく動かない
TCVAR:CHARA:なるべく動かない = 1
NEXT
;料理生成
SIF TFLAG:193 >= 0
	CALL 料理生成("カットスイカ")
;結果記録
IF TFLAG:193 > 0
	SUIKA_GREAT ++
ELSEIF TFLAG:193 == 0
	SUIKA_SUCCESS ++
ENDIF
;時間経過
TIME += 60
;フラグをリセットしてあなたのフラグを立てる
VARSET SUIKA_PLAYER
CVARSET TCVAR, GETNUM(TCVAR, "スイカ割り参加"), 0
TCVAR:MASTER:スイカ割り参加 = 1
RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;スイカ割り

@COM_ABLE484
;時間停止中
SIF FLAG:時間停止
	RETURN 0
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(484)
	RETURN RESULT
;スイカがない
SIF !ITEM:スイカ
	RETURN 0
;アイマスクがない
SIF !ITEM:アイマスク
	RETURN 0
;夏じゃない
SIF GET_MONTH() != "夏の月"
	RETURN 0
;とりあえず訓練できる場所
SIF !戦闘訓練可(CFLAG:MASTER:現在位置)
	RETURN 0
;一日一回まで
SIF TCVAR:MASTER:スイカ割り参加
	RETURN 0
;対象がいない
SIF TARGET <= 0
	RETURN 0
;意識がない
SIF !SHIRAHU(TARGET)
	RETURN 0
;添い寝中
SIF CFLAG:MASTER:添い寝中
	RETURN 0
;うふふ中
SIF CFLAG:MASTER:うふふ
	RETURN 0
;仕事中
SIF CFLAG:行動 == 5 && !(CFLAG:職種 == 49 && ADD_BANQUET_ACTIVITY_ALLOWED("WATERMELON")) ;addition custom code, allow for banquets
	RETURN 0
;体力・気力不足
SIF BASE:MASTER:気力 < 500 || BASE:MASTER:体力 < 500
	RETURN 0
;体力・気力不足
SIF BASE:TARGET:気力 < 500 || BASE:TARGET:体力 < 500
	RETURN 0
RETURN 1
;-------------------------------------------------
;スイカ割り：キャラクターセレクト関数
;ARG 同室人数
;-------------------------------------------------

@SUIKA_CHARASELECT(ARG, 参加可能人数)
#DIM CHARA
#DIM 参加可能人数
#DIM LINE
#DIM 参加要求
VARSET LOCAL
LINE = 7
DRAWLINE
;全員参加指示
SIF 参加要求
	SUIKA_PLAYERNUM = MIN(参加可能人数, SUIKA_MAXPLAYER)
PRINTFORML ●참가자 선택(%TOFULL(TOSTR(SUIKA_PLAYERNUM))%／%TOFULL(TOSTR(SUIKA_MAXPLAYER))%)블러퍼:{SUIKA_LIARNUM()}
FOR LOCAL, 1, ARG + 1
CHARA = TARGET:LOCAL
SIF !SHIRAHU(CHARA)
	CONTINUE
SIF CFLAG:CHARA:行動 == 5 && !(CFLAG:CHARA:職種 == 49 && ADD_BANQUET_ACTIVITY_ALLOWED("WATERMELON")) ;addition custom code, allow for banquets
	CONTINUE
SIF BASE:CHARA:気力 < 500 || BASE:CHARA:体力 < 500
	CONTINUE
;全員参加指示
IF 参加要求
	TCVAR:CHARA:スイカ割り参加 = LOCAL:1 + 1
	SUIKA_PLAYER:(LOCAL:1 + 1) = CHARA
ENDIF
SIF TCVAR:CHARA:スイカ割り参加
	SETCOLOR C_AQUA
PRINTFORM [{CHARA, 3}] %CALLNAME:CHARA, 18, LEFT%
LOCAL:1 ++
IF LOCAL:1 % 3 == 0
	PRINTL 
	LINE ++
ENDIF
RESETCOLOR
SIF 参加要求 && LOCAL:1 == SUIKA_MAXPLAYER
	参加要求 = 0
NEXT
参加要求 = 0
IF LOCAL:1 % 3
	PRINTL 
	LINE ++
ENDIF
IF 参加可能人数 > SUIKA_MAXPLAYER
	PRINTL [902] 상위 8명에게 참여를 허용한다.
ELSE
	PRINTL [901] 모두 포함한다
ENDIF
DRAWLINE
PRINTL [900] 적용 [903] 규칙
PRINTL [999] 취소
INPUT
;やめる
IF RESULT == 999
	;参加フラグをリセットする
	CVARSET TCVAR, GETNUM(TCVAR, "スイカ割り参加"), 0
	VARSET SUIKA_PLAYER
	RETURN -1
	;決定
ELSEIF RESULT == 900
	IF INRANGE(SUIKA_PLAYERNUM, 1, SUIKA_MAXPLAYER)
		RETURN 1
	ELSE
		PRINTFORMW 게임을 시작하기 위해 1~%TOFULL(TOSTR(SUIKA_MAXPLAYER))% %PRINT_PLUR("participant", SUIKA_MAXPLAYER)%를 선택해라!
		LINE ++
	ENDIF
	;全員参加,上から８人を参加
ELSEIF RESULT == 901 || RESULT == 902
	;一旦リセット
	CVARSET TCVAR, GETNUM(TCVAR, "スイカ割り参加"), 0
	SUIKA_PLAYERNUM = 0
	VARSET SUIKA_PLAYER
	参加要求 = 1
	;ルール説明
ELSEIF RESULT == 903
	CALL SUIKA_TUTORIAL
	RESTART
	;キャラ選択
ELSEIF INRANGE(RESULT, 1, CHARANUM) && MATCH(TARGET, RESULT)
	;参加エントリー
	IF !TCVAR:RESULT:スイカ割り参加
		;上限
		IF SUIKA_PLAYERNUM >= SUIKA_MAXPLAYER
			PRINTW 참가 가능한 최대 인원에 도달했습니다!
			LINE ++
		ELSE
			FOR LOCAL, 1, SUIKA_MAXPLAYER + 1
			;空きに入れる
			IF !SUIKA_PLAYER:LOCAL
				SUIKA_PLAYER:LOCAL = RESULT
				TCVAR:RESULT:スイカ割り参加 = LOCAL
				BREAK
			ENDIF
			NEXT
			SUIKA_PLAYERNUM ++
		ENDIF
		;参加キャンセル
	ELSE
		FOR LOCAL, TCVAR:RESULT:スイカ割り参加, SUIKA_MAXPLAYER + 1
		;参加者はキャンセルする
		IF SUIKA_PLAYER:LOCAL == RESULT
			SUIKA_PLAYER:LOCAL = 0
			;番号が後の人がいるなら登録番号を一つ下げる
		ELSEIF SUIKA_PLAYER:LOCAL
			TCVAR:(SUIKA_PLAYER:LOCAL):スイカ割り参加 --
		ENDIF
		NEXT
		;その後シフトする
		FOR LOCAL, TCVAR:RESULT:スイカ割り参加, SUIKA_MAXPLAYER + 1
		SIF !SUIKA_PLAYER:LOCAL
			SWAP SUIKA_PLAYER:LOCAL, SUIKA_PLAYER:(LOCAL + 1)
		NEXT
		;参加状態を戻す
		TCVAR:RESULT:スイカ割り参加 = 0
		SUIKA_PLAYERNUM --
	ENDIF
ENDIF
CLEARLINE LINE
RESTART
