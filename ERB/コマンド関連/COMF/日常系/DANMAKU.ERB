	PRINTFORMW 남은 생명: {プレイヤー残機}
	;【ルナシューター】の効果
	SIF TALENT:MASTER:ルナシューター == 1
		残りボム回数 ++
	;【残忍酷薄】の効果
	IF GETBIT(CFLAG:OPPONENT:弾幕特能, 6) && プレイヤー残機 > 0
		CALL COLORMESSAGE(@"%CALLNAME:OPPONENT%의 【무자비함】이 발동한다!",C_RED,2)
		;【三粒の天滴】の効果
		IF ITEM:三粒の天滴 && !RAND:2
			PRINTFORMW 개구리 신의 축복은 【무자비함】을 비활성화한다!
		ELSE
			;口上呼び出し
			CALL KOJO_MESSAGE_SEND("DANMAKU", 相手残機, OPPONENT, ENEMY, -1, "残忍酷薄")
			残りボム回数 --
		ENDIF
	ENDIF
ENDIF
Pichun = 0
ターン数 ++
WEND
PRINTL 
IF プレイヤー残機 <= 0
	PRINTFORMW 너 패배했다...
	CALL COLORMESSAGE(@"패배자!",C_RED,2,1)
	TCVAR:OPPONENT:弾幕勝負結果 = -1
ELSEIF 相手残機 <= 0
	PRINTFORML 당신은 %CALLNAME:OPPONENT%에게 승리했다!
	CALL COLORMESSAGE(@"생명이 승리했다!",C_GREEN,2,1)
	TCVAR:OPPONENT:弾幕勝負結果 = 1
	CALL DANMAKU_GIPS_REWARD
	;addition custom code
	SIF nInitLives == プレイヤー残機
		RESULT:9 = 1
	SIF nInitBombs == 残りボム回数
		RESULT:10 = 1
	CALL POST_DANMAKU_CLOTHING_SET_156()
	;--------------------
ENDIF
TFLAG:GipsLV = 0
PRINTL 
;楽譜入手処理
IF (RAND:(100) < 30)
	RESULT = 楽譜入手_弾幕勝負(OPPONENT)
	SIF RESULT != -1
		PRINTL
ENDIF
nGluttonousCentipedeCaptures = 0 ;custom code
RETURN 相手残機

@DICE_PRINT(ARG:0, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARGS)
