; Modular ERB: COMF/日常系/DANMAKU.ERB

@DANMAKU_OPPONENT_STATUS(ARG, ARG:1)
#DIMS DYNAMIC OUTPUT
;特殊能力表示
LOCAL:1 = 0
IF !GETBIT(TALENT:ARG:ESP,0)
	PRINTFORML %CALLNAME:ARG%는 단막을 할 수 없다
	PRINTFORML 먼저 %HIM_HER(ARG)%의 단막을 습득해라.
	RETURN 0
ENDIF
FOR LOCAL, 0, 63
SIF GETBIT(CFLAG:ARG:弾幕特能, LOCAL)
	LOCAL:1 ++
NEXT
;IF LOCAL:1 == 10
;	CALL DANMAKU_SA_OUTPUT(ARG, LOCAL:1)
IF LOCAL:1 == 0
	PRINTFORML 단막 특수 능력은 없다.
ELSE
	OUTPUT =
	FOR LOCAL, 0, 500
	OUTPUT += DANMAKU_SA_OUTPUT(ARG, LOCAL)
	NEXT
	HTML_PRINT OUTPUT
ENDIF
SIF ARG:1
	RETURN
;戦闘能力の差でメッセージ分岐
LOCAL:1 = ABL:ARG:戦闘能力 - ABL:MASTER:戦闘能力
SELECTCASE LOCAL:1
	CASE IS <= -30
		PRINTFORML 상대는 싸우기보다는 그냥 항복할 가능성이 더 높다.
	CASE IS <= -18
		PRINTFORML 눈을 가리고, 가만히 서서, 오줌 지릴 것 같고, 만취한 상태여도, %PARSE("you")%은 이길 수 있다.
	CASE -17 TO -13
		PRINTFORML 눈을 가리고, 가만히 서서, 소변이 마려운 상태로도, %PARSE("you")%은 이길 수 있다.
	CASE -12 TO -8
		PRINTFORML 안대까지 쓰고 가만히 서 있어도 %PARSE("you")%은 이길 수 있다.
	CASE -7 TO -4
		PRINTFORML 눈가리개를 하고 있어도 %PARSE("you")%은 이길 수 있다.
	CASE -3 TO -1
		PRINTFORML 지는 건 불가능할 것이다.
	CASE 0
		PRINTFORML 이길 수도 있을지도 모른다.
	CASE 1 TO 3
		PRINTFORML 승리는 불가능할지도 모른다.
	CASE 4 TO 7
		PRINTFORML 상대방은 매우 강하다.
	CASE 8 TO 12
		PRINTFORML 상대는 최소 %PARSE("you")%의 두 배만큼 강해 보인다.
	CASE 13 TO 17
		PRINTFORML 기적이 일어나지 않는다면 %PARSE("you")%은 죽는다.
	CASEELSE
		PRINTFORML 상대는 거인이다, 그들의 발밑의 %PARSE("you are")% 개미다.
ENDSELECT
;-------------------------------------------------
;戦闘中の処理
;-------------------------------------------------

@DANMAKU_BATTLE(OPPONENT, ENEMY = -1)
#DIM プレイヤー残機
#DIM 相手残機
#DIM 残りHP
#DIM 残りボム回数
#DIM ターン数
#DIM プレイヤーダイス面
#DIM 相手ダイス面
#DIM プレイヤーダイス数
#DIM 相手ダイス数
#DIM プレイヤーダイス値
#DIM 相手ダイス値
#DIM プレイヤー修正値
#DIM 相手修正値
#DIM 相手強さ
#DIM 霊力充填フラグ
#DIM 慢心フラグ
#DIM OPPONENT
#DIM ENEMY
#DIM BombPower
#DIM B_Min
#DIM B_Max
#DIM 持ち込みアイテム
#DIM DamageThreshold
#DIM Pichun
#DIM Charge
;addition custom code
#DIM nGluttonousCentipedeCaptures
#DIM nInitLives
#DIM nInitBombs
IF FORCE_ERATW_DANMAKU == 0
	CALL KNIFE_FIGHT(MASTER,OPPONENT,0)
	RETURN RESULT
ENDIF
;--------------------
BONUS_DANMAKU_LIVES = 0 ;addition custom code
CALL KOJO_MESSAGE_SEND("DANMAKU", 相手残機, OPPONENT, ENEMY, -1, "INITIALIZE") ;addition custom code
プレイヤー残機 = 3
相手残機 = 3
相手強さ = ABL:OPPONENT:戦闘能力
残りHP = MAXBASE:MASTER:体力
残りボム回数 = 2
ターン数 = 1
霊力充填フラグ = 0
慢心フラグ = 0
Pichun = 0
Charge = 0
B_min = ABL:MASTER:戦闘能力 * 7 * (ABL:MASTER:戦闘能力 / 2 + 1)
B_Max = ABL:MASTER:戦闘能力 * 11 * (ABL:MASTER:戦闘能力 / 2 + 1) + 6
SIF TALENT:OPPONENT:プライド > 0 && ABL:MASTER:戦闘能力 < 相手強さ && 相手強さ > 2 && TALENT:OPPONENT:行きずり == 1
	慢心フラグ = 1
;【洽覧深識】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 5)
	相手残機 ++
相手残機 = MAX(相手残機 + BONUS_DANMAKU_LIVES, 1) ;addition custom code, extra lives
;【エクステンド】の効果
SIF TALENT:MASTER:エクステンド == 1
	プレイヤー残機 ++
;【ルナシューター】の効果
SIF TALENT:MASTER:ルナシューター == 1
	残りボム回数 ++
;弾幕勝負補助アイテムの持ち込み
CALL DANMAKU_ITEM_USE
持ち込みアイテム = RESULT
ACTIVE_DANMAKU_ITEM = 持ち込みアイテム ;addition custom code
;持ち込みアイテム 命のカード(856) と スペルのカード(857) はここで処理
SIF 持ち込みアイテム == 856
	プレイヤー残機 ++
SIF 持ち込みアイテム == 857
	残りボム回数 ++
;addition custom code
nGluttonousCentipedeCaptures = 0
nInitLives = プレイヤー残機
nInitBombs = 残りボム回数
RESULT:9 = 0
RESULT:10 = 0
;--------------------
;プレイヤーのダイス数は2.5n + 期待値2 + 期待値1
;ダイス面は(n+1)*期待値10*期待値7*n/2
WHILE プレイヤー残機 > 0 && 相手残機 > 0
;ダイス数計算
プレイヤーダイス数 = (ABL:MASTER:戦闘能力 + RAND:5) * 2 + (ABL:MASTER:戦闘能力 + RAND:3) / 2
相手ダイス数 = (相手強さ + RAND:4 + 1) * 2 + 相手強さ / 2 * RAND:3
SELECTCASE 相手残機
	CASE IS > 2
		IF 慢心フラグ && 相手残機 > 2
			CALL COLORMESSAGE(@"%CALLNAME:OPPONENT%는 당신을 깔본다.",C_YELLOW,1)
			相手ダイス数 -= 相手強さ / 2
		ENDIF
	CASE 2
		相手ダイス数 += 相手強さ / 2
	CASE 1
		相手ダイス数 += 相手強さ / 2 + 1
ENDSELECT
;ダイス面計算
プレイヤーダイス面 = (ABL:MASTER:戦闘能力 + 1) * (6 + RAND:8) + RAND:(15 + TFLAG:幸運補正) * ABL:MASTER:戦闘能力 / 2
相手ダイス面 = (相手強さ + 1) * (9 + RAND:7) + RAND:10 - (相手残機 - 1) * 相手強さ
;修正値計算
IF (相手強さ - ABL:MASTER:戦闘能力) < 0
	プレイヤー修正値 = (ABL:MASTER:戦闘能力 - 相手強さ + 3) * (-RAND:4 - 8) * ABL:MASTER:戦闘能力 / 2
	相手修正値 = (ABL:MASTER:戦闘能力 - 相手強さ + 3) * (RAND:4 + 8) * 相手強さ / 2
ELSEIF (相手強さ - ABL:MASTER:戦闘能力) > 0
	プレイヤー修正値 = (相手強さ - ABL:MASTER:戦闘能力 + 3) * (RAND:4 + 8) * ABL:MASTER:戦闘能力 / 2
	相手修正値 = (相手強さ - ABL:MASTER:戦闘能力 + 3) * (-RAND:4 - 8) * 相手強さ / 2
ELSE
	プレイヤー修正値 = 0
	相手修正値 = 0
ENDIF
CALL KOJO_MESSAGE_SEND("DANMAKU", 相手残機, OPPONENT, ENEMY, -1, "HANDICAP") ;addition custom code
;イベント用
プレイヤー修正値 -= (HANDICAP_FIXED + TFLAG:GipsLV)
;addition custom code
LOCAL:10 = HANDICAP_RAND + TFLAG:GipsLV * ABL:MASTER:戦闘能力 + 1
IF LOCAL:10 > 0
	プレイヤー修正値 -= RAND:(HANDICAP_RAND + TFLAG:GipsLV * ABL:MASTER:戦闘能力 + 1)
ELSEIF LOCAL:10 < 0
	プレイヤー修正値 += RAND:ABS(HANDICAP_RAND + TFLAG:GipsLV * ABL:MASTER:戦闘能力 + 1)
ENDIF
;【言笑自若】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 0)
	プレイヤーダイス数 -= (相手強さ / 2 + RAND:3 + 1) * RAND:2
;【温柔敦厚】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 1)
	プレイヤーダイス面 -= (相手強さ / 2 + 1) * RAND:4 + RAND:5
;【勇気凛々】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 2)
	相手ダイス数 += (相手強さ / 2 + RAND:3 + 2) * RAND:2
;【豪放磊落】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 3)
	相手ダイス面 += 相手強さ * 2 + 6 / (RAND:3 + 1)
;【狷介孤高】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 8)
	相手修正値 += 相手強さ * (RAND:5 + 5) + RAND:5
;【幽愁暗恨】の効果
SIF GETBIT(CFLAG:OPPONENT:弾幕特能, 9)
	プレイヤー修正値 -= 相手強さ * (RAND:4 + 4) + RAND:9
;【霊力充填】の効果
IF 霊力充填フラグ
	Charge = 相手強さ / 2 + 1
	プレイヤーダイス数 += Charge
	CALL COLORMESSAGE(@"【영력충전】이 활성화되며 주사위 숫자가 {Charge}만큼 증가한다!",C_RED,1)
	Charge = (相手強さ / 2 + 1) * 2
	プレイヤーダイス面 += Charge
	CALL COLORMESSAGE(@"【영력충전】이 활성화되며, 주사위 값이 {Charge}만큼 증가한다!",C_RED,1)
	Charge = 相手強さ * (RAND:3 + 2)
	プレイヤー修正値 += Charge
	CALL COLORMESSAGE(@"【영력충전】이 활성화되며, 수정값이 {Charge}만큼 증가했다!",C_RED,1)
	霊力充填フラグ = 0
ENDIF
;【国士無双の薬】使用中　残りHP増大・ダイス面に補正
SIF TCVAR:MASTER:国士無双の薬
	プレイヤーダイス面 += MAX(RAND:(MAX((TCVAR:MASTER:国士無双の薬), 1) * 2), 1)
;戦闘バフの効果（プレイヤーと対戦相手両方）
SIF TCVAR:MASTER:エンチャント
	プレイヤー修正値 += ABL:MASTER:戦闘能力 * RAND:3 + RAND:3
SIF TCVAR:OPPONENT:エンチャント
	相手修正値 += 相手強さ * RAND:3 + RAND:3
;custom code
SIF ITEM:922
	相手修正値 += (相手修正値 / 4) * 2 * nGluttonousCentipedeCaptures
SIF TCVAR:MASTER:加護
	相手修正値 -= ABL:MASTER:戦闘能力 * RAND:3 + RAND:3
SIF TCVAR:OPPONENT:加護
	プレイヤー修正値 -= 相手強さ * RAND:3 + RAND:3
;弾幕勝負補助アイテムの効果
CALL DANMAKU_ITEM_EFFECT(持ち込みアイテム)
プレイヤーダイス面 += RESULT:0
プレイヤーダイス数 += RESULT:1
;念のためリセット
VARSET RESULT
プレイヤーダイス数 = MAX(プレイヤーダイス数, 1)
相手ダイス数 = MAX(相手ダイス数, 1)
プレイヤーダイス面 = MAX(プレイヤーダイス面, 1)
相手ダイス面 = MAX(相手ダイス面, 1)
PRINTL 
PRINTFORML -----------------------------------------------------
PRINTFORML TURN:{ターン数}
PRINTFORML -----------------------------------------------------
PRINTL 
CALL DICE_PRINT(プレイヤーダイス数, プレイヤーダイス面, プレイヤー修正値, 相手ダイス数, 相手ダイス面, 相手修正値, "確定前")
PRINTFORMW 운명의 주사위가 던져졌다!
;イベント用
IF (HANDICAP_FIXED || HANDICAP_RAND)
	CALL KOJO_MESSAGE_SEND("DANMAKU", 相手残機, OPPONENT, ENEMY, -1, "ハンデ")
ENDIF
;ダイス値計算
プレイヤーダイス値 = DICE_VALUE(プレイヤーダイス数, プレイヤーダイス面, プレイヤー修正値)
相手ダイス値 = DICE_VALUE(相手ダイス数, 相手ダイス面, 相手修正値)
LOCAL = 相手ダイス値 - プレイヤーダイス値
;持ち込みアイテム【バレットゴーレム】の効果　基本ダイス差を0.8倍に
SIF LOCAL && 持ち込みアイテム == 854
	TIMES LOCAL, 0.8
CALL DICE_PRINT(プレイヤーダイス値, 0, 0, 相手ダイス数, 相手ダイス面, 相手修正値, "確定後")
$BEFORE_BATTLE
PRINTL 
PRINTFORML 남은 HP: {残りHP} 폭탄: {残りボム回数} 폭탄 파워: 최소:{B_Min}, 최대:{B_Max} 생명: {プレイヤー残機}
IF 持ち込みアイテム
	SETCOLOR 0x666666
	PRINTFORML   (%ITEMNAME_TR(持ち込みアイテム)% - %DANMAKU_ITEM_EXPLANATION(持ち込みアイテム)%이 들고 있다.)
ENDIF
IF TCVAR:MASTER:国士無双の薬
	SETCOLOR 0x666666
	PRINTFORML   (지속 효과: 비견할 수 없는 애국의 약 ... 주사위 값이 약간 향상되었다.)
ENDIF
IF TCVAR:MASTER:エンチャント
	SETCOLOR 0x666666
	PRINTFORML   (버프: 마법 부여 ... 주사위 값 보정 증가)
ENDIF
;custom code
IF nGluttonousCentipedeCaptures > 0
	SETCOLOR 0x666666
	PRINTFORML   (지속 효과: 탐욕스러운 지네 ... 주사위 값 보정 증가)
ENDIF
IF TCVAR:MASTER:加護
	SETCOLOR 0x666666
	PRINTFORML   (버프: 신성한 보호 ... 상대방 주사위 값 보정 감소)
ENDIF
IF TCVAR:OPPONENT:エンチャント
	SETCOLOR 0xc86666
	PRINTFORML   (상대 버프: 마법 부여 ... 상대 주사위 값 보정 상승)
ENDIF
IF TCVAR:OPPONENT:加護
	SETCOLOR 0xc86666
	PRINTFORML   (상대방 버프: 신성한 보호 ... 주사위 값 보정 하락)
ENDIF
RESETCOLOR
CALL ASK_M("회피하는 데 집중하라", 1, "공격", 1)
SELECTCASE RESULT
	CASE 0
		;【霊力充填】の効果
		IF TALENT:MASTER:霊力充填 == 1
			霊力充填フラグ = 1
			CALL COLORMESSAGE(@"%조사처리(CALLNAME:MASTER,"의")%【전력 충전】이 발동한다!",C_RED,2)
		ENDIF
		PRINTFORML 당신은 단마쿠 피하는 데 집중한다...
		PRINTFORMW ・・・
		PRINTL 
		CALL DICE_PRINT(プレイヤーダイス値, 相手ダイス値, 0, 0, 0, 0, "勝負")
		PRINTW 
		;【バレットゴーレム】の効果  回避選択時はさらに0.9倍（トータル0.72倍程度に）
		IF LOCAL && 持ち込みアイテム == 855
			TIMES LOCAL, 0.9
			PRINTFORML 골렘이 단막을 막아낸다...!
		ENDIF
		$UseEpitaph
		;【グレイズ上手】の効果
		IF TALENT:MASTER:グレイズ上手 == 1
			IF ABL:MASTER:戦闘能力 < 3
				LOCAL = (LOCAL * 2) / (ABL:MASTER:戦闘能力 + 2)
			ELSE
				LOCAL = (LOCAL * 3) / (ABL:MASTER:戦闘能力 + 3)
			ENDIF
		ENDIF
		;addition custom code
		CALL Add_SeedOfUnknownForm("danmaku", OPPONENT, LOCAL)
		SIF RESULT > 0
			LOCAL = RESULT
		;--------------------
		DamageThreshold = MAX(ABL:MASTER:戦闘能力 / 2, 1)
		IF LOCAL <= 20 * DamageThreshold
			PRINTFORML 거의 피해를 입지 않는다.
			SIF LOCAL > 0
				残りHP -= LOCAL * 4
		ELSEIF LOCAL <= 50 * DamageThreshold
			PRINTFORML 당신은 약간의 피해를 입는다.
			残りHP -= LOCAL * 5
		ELSEIF LOCAL <= 150 * DamageThreshold
			PRINTFORML 당신은 많은 피해를 입는다.
			残りHP -= LOCAL * 6
		ELSE
			PRINTFORML 당신은 상당한 양의 피해를 입는다.
			残りHP = 残りHP - MAXBASE:MASTER:体力 / 2 + 1
		ENDIF
		PRINTFORMW 남은 HP: {残りHP}
		IF 残りHP <= 0
			Pichun = 1
			IF ITEM:922
				SIF nGluttonousCentipedeCaptures > 0
					PRINTFORMDL 탐욕스러운 지네의 힘이 당신의 몸을 떠난다.
				nGluttonousCentipedeCaptures = 0 ;custom code
			ENDIF
		ENDIF
	CASE 1
		;【乾坤一擲】の効果
		IF GETBIT(CFLAG:OPPONENT:弾幕特能, 7)
			IF RAND:100 + 1 < 10 + 相手強さ * 2
				LOCAL:1 = 相手強さ * (7 + RAND:5) * (相手強さ / 2 + 1) + RAND:7
				相手ダイス値 += LOCAL:1
				SETCOLOR C_RED
				PRINTFORML %CALLNAME:OPPONENT%의 【올인】이 발동한다!
				PRINTFORMW %CALLNAME:OPPONENT%의 주사위 값이 +{LOCAL:1} 증가한다!
				RESETCOLOR
				;口上呼び出し
				CALL KOJO_MESSAGE_SEND("DANMAKU", 相手残機, OPPONENT, ENEMY, -1, "乾坤一擲")
				LOCAL = 相手ダイス値 - プレイヤーダイス値
			ENDIF
		ENDIF
		IF 残りボム回数 >= 1
			PRINTFORML 폭탄을 사용하겠습니까?
			CALL ASK_M("그것을 사용한다", 1, "사용하지 마라", 1)
			SELECTCASE RESULT
				CASE 0
					CALL UseBomb
					BombPower = RESULT
					プレイヤーダイス値 += BombPower
					PRINTFORMW 플레이어 주사위 값이 {プレイヤーダイス値}로 증가했다!
					残りボム回数 --
					LOCAL = 相手ダイス値 - プレイヤーダイス値
					IF ITEM:922
						SIF nGluttonousCentipedeCaptures > 0
							PRINTFORMDL 탐욕스러운 지네의 힘이 당신의 몸을 떠난다.
						nGluttonousCentipedeCaptures = 0 ;custom code
					ENDIF
				CASE 1
			ENDSELECT
		ENDIF
		PRINTFORML 싸우기로 결정한다!
		PRINTFORMW ・・・
		PRINTL 
		CALL DICE_PRINT(プレイヤーダイス値, 相手ダイス値, 0, 0, 0, 0, "勝負")
		IF (持ち込みアイテム == 870 ||持ち込みアイテム == 871) && LOCAL > 0 && BASE:MASTER:TSP >= 500
			;qol edit, don't waste tsp when you think you don't have to
			PRINTFORML TSP를 사용해서 회피할까?
			CALL ASK_YN
			SIF RESULT
				GOTO SKIP_TSP
			SETBGCOLOR 1, 24, 60
			CALL COLORMESSAGE(TEXTR("I see it! Your movements! No matter what you do, I can say『I've seen through it』!/......... I can read the『Trajectory』of your lines.........『The trajectory of your movements in the future』...!"), 0xFF1493, 2, 1)
			PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 『에피타프』로 사격들을 예측했다!
			CALL RECOVER(MASTER, -500, "TSP")
			CALL COLORMESSAGE(@"남은 TSP:{BASE:MASTER:TSP}", C_RED, 2)
			CALL ASK_M("피하는 데 집중한다",1,"『킹 크림슨』! (TSP1500)",持ち込みアイテム == 871 && BASE:MASTER:TSP >= 1500)
			SELECTCASE RESULT
				CASE 0
					PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 회피로 전환했다!
					IF FLAG:背景色推移 ;bugfix custom code, fixes background color if weather bgcolor option is disabled
						;(天候パッチ)時刻・天候に応じて背景色を変更
						CALL SET_MAP_WEATHER_BGCOLOR
					ELSE
						RESETBGCOLOR
					ENDIF
					GOTO UseEpitaph
				CASE 1
					CLEARLINE 1
