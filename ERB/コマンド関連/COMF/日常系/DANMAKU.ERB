	RESULT:8 = (プレイヤー残機-1) ;addition custom code
	CALL KOJO_MESSAGE_SEND("DANMAKU", 相手残機, OPPONENT, ENEMY, -1, "Pichun") ;addition custom code
	プレイヤー残機 --
