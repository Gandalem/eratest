					CALL KEYTYPING(@"...Heavy snow warning for the region...", "dc:l", 80, 1)
				ENDIF
			CASE "大雪注意報"
				CALL KEYTYPING(@"...Heavy snow caution is in effect for the region...", "dc:l", 80, 1)
		ENDSELECT
		
		SELECTCASE 暴風情報
			CASE "暴風雪特別警報"
				SELECTCASE RAND:4
					CASE 0
						CALL KEYTYPING(@"...Blizzard emergency warning for the region...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"...the unprecedented snowstorm in decades...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...the heaviest snowstorm ever seen to date... ...avoid going out unnecessarily...", "dc:l", 80, 1)
					CASE 3
						CALL KEYTYPING(@"...ferocious blizzard... ...could occur at any time...", "dc:l", 80, 1)
				ENDSELECT
			CASE "暴風特別警報"
				SELECTCASE RAND:4
					CASE 0
						CALL KEYTYPING(@"...heavy windstorm emergency warning for... surrounding region at...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"...the most ferocious storm we've ever experienced...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...record-breaking storm... ...since Isewan Typhoon...", "dc:l", 80, 1)
