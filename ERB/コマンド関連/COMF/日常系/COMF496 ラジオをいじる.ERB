	CALL KEYTYPING(@"... ", "l")
	FONTBOLD
	CALL KEYTYPING(@"Crunch! Scrape! ", "l")
	FONTREGULAR
	CALL KEYTYPING(@"...... ", "l")
	FONTBOLD
	CALL KEYTYPING(@"Bzzzzzzz!!! ", "l")
	FONTREGULAR
	CALL KEYTYPING(@"Hissss...... ", "l")
ELSEIF GET_FRONTAL_THUNDERSTORM() == 1 || GET_HEAT_THUNDERSTORM() == 1
	CALL KEYTYPING(@"... ", "l")
	FONTBOLD
	CALL KEYTYPING(@"Crackle! ", "l")
	FONTREGULAR
	CALL KEYTYPING(@"Fshhhh...... ...", "l")
ELSE
	CALL KEYTYPING(@"... ...... ......... ...", "dc:l")
ENDIF

SELECTCASE TIME:0
	CASE 345 TO 359, 375 TO 389, 405 TO 419, 435 TO 449, 465 TO 479, 525 TO 539, 585 TO 599, 705 TO 719, 735 TO 749, 825 TO 839, 885 TO 899, 945 TO 959, 1005 TO 1019, 1065 TO 1079, 1125 TO 1139, 1185 TO 1199, 1245 TO 1259, 1305 TO 1319, 1365 TO 1379
	;天気予報(15分間)(05:45 06:15 06:45 07:15 07:45 08:45 09:45 11:45 12:15 13:45 14:45 15:45 16:45 17:45 18:45 19:45 20:45 21:45 22:45)
		SELECTCASE 低気圧位置
			CASE "台風遠方"
				CALL KEYTYPING(@"...%CAPITALIZE(ARTICLE(台風勢力))% typhoon sighted... from the southern seas...", "dc:l", 80, 1)
			CASE "台風勢力圏"
				CALL KEYTYPING(@"...%CAPITALIZE(ARTICLE(台風勢力))% typhoon approaching... from off the coast... central atmospheric pressure is... hPa...", "dc:l", 80, 1)
			CASE "台風接近強風域", "台風接近暴風域"
				CALL KEYTYPING(@"...%ARTICLE(台風勢力)% typhoon... approaching... ", "dc", 80, 1)
