; Modular ERB: COMF/日常系/COMF496 ラジオをいじる.ERB
;-------------------------------------------------
;ラジオをいじる
;日常系コマンド、レベル1
;-------------------------------------------------

@COM496
#DIMS 大雨情報
#DIMS 大雪情報
#DIMS 暴風情報
#DIMS 雷情報
#DIMS 低温情報
#DIMS 雪崩情報
#DIMS 低気圧位置
#DIMS 線状降水帯位置
#DIMS 積乱雲位置
#DIMS 台風勢力
#DIMS 早期注意情報
低気圧位置 = %GET_LOCATION_LOW()%
線状降水帯位置 = %GET_LOCATION_LINER_RAINBAND()%
積乱雲位置 = %GET_LOCATION_CUMULUS()%
大雨情報 = %GET_WEATHER_WARNING_HEAVY_RAIN()%
大雪情報 = %GET_WEATHER_WARNING_HEAVY_SNOWFALL()%
暴風情報 = %GET_WEATHER_WARNING_STORM()%
雷情報 = %GET_WEATHER_WARNING_LIGHTNING()%
低温情報 = %GET_WEATHER_WARNING_COLD()%
雪崩情報 = %GET_WEATHER_WARNING_AVALANCHE()%
早期注意情報 = %GET_WEATHER_ADVISORY_probability_subsequent_WARNING()%
SELECTCASE IS_TYPHOON:1
	CASE 5
		台風勢力 = ferocious
	CASE 4
		台風勢力 = extremely strong
	CASE 3
		台風勢力 = strong
	CASEELSE
		台風勢力 =
ENDSELECT
[IF_DEBUG]
SELECTCASE TIME:0
	CASE 345 TO 359, 375 TO 389, 405 TO 419, 435 TO 449, 465 TO 479, 525 TO 539, 585 TO 599, 705 TO 719, 735 TO 749, 825 TO 839, 885 TO 899, 945 TO 959, 1005 TO 1019, 1065 TO 1079, 1125 TO 1139, 1185 TO 1199, 1245 TO 1259, 1305 TO 1319, 1365 TO 1379
		;天気予報(15分間)(05:45 06:15 06:45 07:15 07:45 08:45 09:45 11:45 12:15 13:45 14:45 15:45 16:45 17:45 18:45 19:45 20:45 21:45 22:45)
		DEBUGPRINTFORML 현재 방송: 일기예보
	CASE 300 TO 329, 360 TO 374, 420 TO 434, 540 TO 554, 600 TO 614, 660 TO 674, 720 TO 734, 780 TO 794, 840 TO 854, 900 TO 914, 1020 TO 1034, 1140 TO 1184, 1200 TO 1214, 1260 TO 1274, 1380 TO 1394, 0 TO 14, 60 TO 74, 120 TO 134, 180 TO 194, 240 TO 254
		;ニュース(原則15分間)(05:00~05:29 06:00 07:00 09:00 10:00 11:00 12:00 13:00 14:00 15:00 17:00 19:00~19:44 20:00 21:00 23:00 24:00 01:00 02:00 03:00 04:00)
		DEBUGPRINTFORML 현재 방송: 뉴스
	CASE 960 TO 989
		;気象通報(16:00~16:29)
		DEBUGPRINTFORML 현재 방송: 기상 통보
	CASEELSE
		DEBUGPRINTFORML 현재 방송: 불명
ENDSELECT
DEBUGPRINTFORML %大雨情報%
DEBUGPRINTFORML %大雪情報%
DEBUGPRINTFORML %暴風情報%
DEBUGPRINTFORML %雷情報%
DEBUGPRINTFORML %低温情報%
DEBUGPRINTFORML %雪崩情報%
DEBUGPRINTFORML %早期注意情報%
[ENDIF]
;custom code - replaced all radio lines with the slow type function for immersion, set to moderate speed
PRINTW 당신은 라디오 노브를 만지작한다.
PRINTL
PRINTL ┏━━━━━━┓
PRINT ┃PWR ［
IF 大雨情報 == "大雨特別警報"
	PRINT □□
ELSEIF 大雨情報 == "大雨警報(土砂災害警戒情報)" || 大雪情報 == "大雪特別警報" || 暴風情報 == "暴風雪特別警報" || 暴風情報 == "暴風特別警報"
	IF CONTINUOUS_RAINFALL >= 10
		SETCOLOR C_気象_土砂災害警戒情報
		PRINT ■
		RESETCOLOR
		PRINT □
	ELSE
		SETCOLOR C_気象_土砂災害警戒情報
		PRINT ■■
		RESETCOLOR
	ENDIF
ELSEIF 大雨情報 == "大雨警報" || 大雪情報 == "大雪警報" || 暴風情報 == "暴風雪警報" || 暴風情報 == "暴風警報" || 雷情報 == "雷注意報(竜巻注意情報)" || 雪崩情報 == "なだれ注意報"
	SETCOLOR C_気象_警報
	PRINT ■■
	RESETCOLOR
ELSEIF 大雨情報 == "大雨注意報" || 大雪情報 == "大雪注意報" || 暴風情報 == "風雪注意報" || 暴風情報 == "強風注意報" || 雷情報 == "雷注意報"
	SELECTCASE 早期注意情報
		CASE "警報級の可能性［高］"
			SETCOLOR C_気象_注意報
			PRINT ■■
			RESETCOLOR
		CASE "警報級の可能性［中］"
			SETCOLOR C_気象_注意報
			PRINT ■
			RESETCOLOR
			PRINT ■
		CASEELSE
			SETCOLOR C_気象_注意報
			PRINT ■
			SETCOLOR C_GREEN
			PRINT ■
			RESETCOLOR
	ENDSELECT
ELSE
	SELECTCASE 早期注意情報
		CASE "警報級の可能性［高］"
			PRINT ■■
		CASE "警報級の可能性［中］"
			SETCOLOR C_GREEN
			PRINT ■
			RESETCOLOR
			PRINT ■
		CASEELSE
			SETCOLOR C_GREEN
			PRINT ■■
			RESETCOLOR
	ENDSELECT
ENDIF
PRINTL ］┃
PRINTL ┗━━━━━━┛
;(天候パッチ)雷発生時はノイズが混じる
IF GET_FRONTAL_THUNDERSTORM() == 1 && GET_HEAT_THUNDERSTORM() == 1
	CALL KEYTYPING(@"... ", "l")
	FONTBOLD
	CALL KEYTYPING(@"콰직! 스윽! ", "l")
	FONTREGULAR
	CALL KEYTYPING(@"...... ", "l")
	FONTBOLD
	CALL KEYTYPING(@"지지직!!! ", "l")
	FONTREGULAR
	CALL KEYTYPING(@"쉬이익...... ", "l")
ELSEIF GET_FRONTAL_THUNDERSTORM() == 1 || GET_HEAT_THUNDERSTORM() == 1
	CALL KEYTYPING(@"... ", "l")
	FONTBOLD
	CALL KEYTYPING(@"파지직! ", "l")
	FONTREGULAR
	CALL KEYTYPING(@"후우...... ...", "l")
ELSE
	CALL KEYTYPING(@"... ...... ......... ...", "dc:l")
ENDIF
SELECTCASE TIME:0
	CASE 345 TO 359, 375 TO 389, 405 TO 419, 435 TO 449, 465 TO 479, 525 TO 539, 585 TO 599, 705 TO 719, 735 TO 749, 825 TO 839, 885 TO 899, 945 TO 959, 1005 TO 1019, 1065 TO 1079, 1125 TO 1139, 1185 TO 1199, 1245 TO 1259, 1305 TO 1319, 1365 TO 1379
		;天気予報(15分間)(05:45 06:15 06:45 07:15 07:45 08:45 09:45 11:45 12:15 13:45 14:45 15:45 16:45 17:45 18:45 19:45 20:45 21:45 22:45)
		SELECTCASE 低気圧位置
			CASE "台風遠方"
				CALL KEYTYPING(@"...%CAPITALIZE(ARTICLE(台風勢力))% 태풍이 목격되었다... 남쪽 바다에서...", "dc:l", 80, 1)
			CASE "台風勢力圏"
				CALL KEYTYPING(@"%CAPITALIZE(ARTICLE(台風勢力))% 태풍이 다가오고 있다... 해안에서... 중심 기압은... hPa...", "dc:l", 80, 1)
			CASE "台風接近強風域", "台風接近暴風域"
				CALL KEYTYPING(@"...%ARTICLE(台風勢力)% 태풍이 접근 중... ", "dc", 80, 1)
				IF 暴風情報 == "暴風特別警報"
					CALL KEYTYPING(@"...Day {TIME_CLOSEST_TYPHOON:1}에 %GET_NAME_WEATHER_TIMEZOME_TR(TIME_CLOSEST_TYPHOON:2)%에서 전례 없는 10년 만의 강도... 매우 가깝다...", "dc:l", 80, 1)
				ELSEIF IS_TYPHOON:1 >= 3
					CALL KEYTYPING(@"...태풍에 가장 가까운 날 {TIME_CLOSEST_TYPHOON:1}의 %GET_NAME_WEATHER_TIMEZOME_TR(TIME_CLOSEST_TYPHOON:2)%조에도 여전히 세찬 힘이... 아주 가깝다...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"...Day {TIME_CLOSEST_TYPHOON:1}에 %GET_NAME_WEATHER_TIMEZOME_TR(TIME_CLOSEST_TYPHOON:2)%이... 매우 가깝다...", "dc:l", 80, 1)
				ENDIF
			CASE "台風最接近"
				CALL KEYTYPING(@"...%ARTICLE(台風勢力)% 태풍이... 접근 중... ", "dc", 80, 1)
				IF 暴風情報 == "暴風特別警報"
					CALL KEYTYPING(@"지난 10년간 전례 없는 강도의 태풍... 가장 근접한 지점...", "dc:l", 80, 1)
					CALL KEYTYPING(@"가능한 대형 폭풍에 대비해 경계 태세를 유지하라... 반복한다... 이것은 훈련이 아니다...", "dc:l", 80, 1)
				ELSEIF IS_TYPHOON:1 >= 3
					CALL KEYTYPING(@"접근 지점과 극한의 주의를 가지고...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"접근 지점... 매우 조심해...", "dc:l", 80, 1)
				ENDIF
			CASE "台風通過暴風域", "台風通過強風域"
				CALL KEYTYPING(@"...%ARTICLE(台風勢力)% 태풍이 다가온다... ", "dc", 80, 1)
				IF 暴風情報 == "暴風特別警報"
					CALL KEYTYPING(@"기록적인 강도로 유지하며 통과하고 있다... 여전히... 높은 경계 태세에 있다...", "dc:l", 80, 1)
				ELSEIF IS_TYPHOON:1 >= 3
					CALL KEYTYPING(@"...여전히 무시할 수 있는 힘으로 남아있다... 통과하며...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"통과하고 있다.", "dc:l", 80, 1)
				ENDIF
			CASE "寒冷渦遠方", "寒冷渦接近"
				SELECTCASE DAY:2
					CASE 1, 3, 4
						CALL KEYTYPING(@"...한랭 소용돌이가 동해로 다가온다...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"고지대를 따라 이동하는 강한 찬 공기...", "dc:l", 80, 1)
				ENDSELECT
			CASE "二つ玉低気圧遠方", "日本海低気圧遠方"
				CALL KEYTYPING(@"...동해 위로... ...저기압...", "dc:l", 80, 1)
			CASE "二つ玉低気圧接近", "疑似好天", "二つ玉低気圧通過中"
				CALL KEYTYPING(@"일본해 상공에서 급격히 발달하는 저기압...", "dc:l", 80, 1)
				CALL KEYTYPING(@"산악 지역의 갑작스러운 날씨 변화...", "dc:l", 80, 1)
			CASE "日本海低気圧接近", "日本海低気圧通過中"
				CALL KEYTYPING(@"일본해 상공에서 저기압이 발달한다.", "dc:l", 80, 1)
			CASE "南岸低気圧遠方"
				CALL KEYTYPING(@"동중국해 상공에서... 저기압...", "dc:l", 80, 1)
			CASE "南岸低気圧接近"
				CALL KEYTYPING(@"태평양 상공에서 낮은 기압이 발달하고 있다.", "dc:l", 80, 1)
			CASE "温暖前線遠方"
				IF TIME_ENTER_TERRITORY_EXTRATROPICAL_LOW:0 == DAY:2 && TIME_ENTER_TERRITORY_EXTRATROPICAL_LOW:1 <= DAY:3 + 1
					CALL KEYTYPING(@"내일이 지나고 나서 기상 전선이 오고 있다...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"한 주 중간의 저기압 위치...", "dc:l", 80, 1)
				ENDIF
			CASE "温暖前線接近"
				CALL KEYTYPING(@"서쪽에서 따뜻한 전선이 접근함에 기인한다.", "dc:l", 80, 1)
			CASE "暖域"
				CALL KEYTYPING(@"냉전 통과 시에는...", "dc:l", 80, 1)
			CASE "寒冷前線通過"
				CALL KEYTYPING(@"그리고 일부 지역에는 소나기가 내린다...", "dc:l", 80, 1)
			CASEELSE
				SELECTCASE DAY:2
					CASE 1,3
						IF IS_RAINY_SEASON1:0 == 1 || IS_RAINY_SEASON2 == 1
							CALL KEYTYPING(@"간헐적인 날씨가 이어졌다.", "dc:l", 80, 1)
						ELSE
							CALL KEYTYPING(@"…고요한 날씨…", "dc:l", 80, 1)
						ENDIF
					CASE 2
						IF POWER_WARM_AIR == 1
							CALL KEYTYPING(@"태평양 고기압의 약화된 확장...", "dc:l", 80, 1)
						ELSE
							CALL KEYTYPING(@"전국에 펼쳐진 여름 하늘...", "dc:l", 80, 1)
						ENDIF
					CASE 4
						CALL KEYTYPING(@"서쪽에는 높은 기압이, 동쪽에는 낮은 기압이 있는 겨울의 기압 배치...", "dc:l", 80, 1)
				ENDSELECT
		ENDSELECT
		SELECTCASE 大雨情報
			CASE "大雨特別警報"
				SELECTCASE RAND:4
					CASE 0
						CALL KEYTYPING(@"지금까지 경험했던 가장 거센 비로...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"수십 년 만에 기록된 전례 없는 강수량은...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...주변 지역에 대한 폭우 긴급 경보가...", "dc:l", 80, 1)
					CASE 3
						CALL KEYTYPING(@"우리는 안전한 대피가 이루어지도록 이미 조치를 취했다... 살아남기 위해 해야 할 일을 하라...", "dc:l", 80, 1)
				ENDSELECT
			CASE "大雨警報(土砂災害警戒情報)"
				SELECTCASE RAND:2
					CASE 0
						CALL KEYTYPING(@"지난 몇 년간 보아온 산사태의 가장 높은 위험을...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"기상 관측소에서 지역의 산사태 위험을 보고한다.", "dc:l", 80, 1)
				ENDSELECT
			CASE "大雨警報"
				SELECTCASE RAND:3
					CASE 0
						CALL KEYTYPING(@"도움이 필요한 분들, 장애가 있는 분들 등은 저희에게 연락해 주십시오...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"아직 낮 동안이라서 대피해 주십시오...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"기상 관측소는 해당 지역에 호우 및 홍수 경보를 발령했다.", "dc:l", 80, 1)
				ENDSELECT
			CASE "大雨注意報"
				SELECTCASE RAND:2
					CASE 0
						CALL KEYTYPING(@"당신은 지역별 위험 지도를 다음에서 확인할 수 있습니다...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"기상 관측소에서 해당 지역에 폭풍 경보를 발령했다.", "dc:l", 80, 1)
				ENDSELECT
		ENDSELECT
		SELECTCASE 大雪情報
			CASE "大雪特別警報"
				SELECTCASE RAND:3
					CASE 0
						CALL KEYTYPING(@"지금까지 관측된 가장 많은 눈...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"수십 년 만의 최악의 눈보라…", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...주변 지역에 대한 폭설 특보가 발령되었다...", "dc:l", 80, 1)
				ENDSELECT
			CASE "大雪警報"
				IF CONTINUOUS_SNOWFALL >= 20
					CALL KEYTYPING(@"기상 관측소의 보고에 따르면... 해당 지역에 상당한 폭설이 내리고 있다...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"해당 지역에 폭설 경보가 내려졌다.", "dc:l", 80, 1)
				ENDIF
			CASE "大雪注意報"
				CALL KEYTYPING(@"해당 지역에 폭설 주의보가 발효 중이다.", "dc:l", 80, 1)
		ENDSELECT
		SELECTCASE 暴風情報
			CASE "暴風雪特別警報"
				SELECTCASE RAND:4
					CASE 0
						CALL KEYTYPING(@"해당 지역에 대한 폭풍 특보...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"수십 년 만에 발생한 전례 없는 눈보라...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"지금까지 관측된 가장 심한 눈보라... 불필요하게 외출하는 것을 피하세요...", "dc:l", 80, 1)
					CASE 3
						CALL KEYTYPING(@"사나운 눈보라가 언제든지 발생할 수 있다.", "dc:l", 80, 1)
				ENDSELECT
			CASE "暴風特別警報"
				SELECTCASE RAND:4
					CASE 0
						CALL KEYTYPING(@"...주변 지역에 대한 강풍 특보가...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"우리가 경험했던 가장 사나운 폭풍...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"기록적인 폭풍... 이세완 태풍 이후로...", "dc:l", 80, 1)
					CASE 3
						CALL KEYTYPING(@"비정상적으로 거센 바람이 몰아치고 있으니 안전을 위해 부탁드립니다...", "dc:l", 80, 1)
				ENDSELECT
			CASE "暴風雪警報"
				SELECTCASE RAND:2
					CASE 0
						CALL KEYTYPING(@"해당 지역에 폭풍우 경보가 있습니다... 가능하다면 외출하지 마십시오...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"몇 년에 한 번 있는 눈보라가 그 지역을 강타했다.", "dc:l", 80, 1)
				ENDSELECT
			CASE "暴風警報"
				CALL KEYTYPING(@"해당 지역에 폭풍 경보가 발령되었다... 가능한 한 빨리 대피하라...", "dc:l", 80, 1)
			CASE "風雪注意報"
				CALL KEYTYPING(@"해당 지역에 풍설 주의보가 발효되었다.", "dc:l", 80, 1)
			CASE "強風注意報"
				CALL KEYTYPING(@"해당 지역의 강풍주의보가 발령되었다.", "dc:l", 80, 1)
		ENDSELECT
		SELECTCASE 雷情報
			CASE "雷注意報(竜巻注意情報)"
				CALL KEYTYPING(@"대기 상황이 매우 불안정해졌고...", "dc:l", 80, 1)
				CALL KEYTYPING(@"해당 지역에서 토네이도 발생의 위협이 커지고 있다.", "dc:l", 80, 1)
			CASE "雷注意報"
				IF DAY:2 == 2 && (IS_COLD_LOW || 低気圧位置 == "台風勢力圏")
					CALL KEYTYPING(@"대기 상황이 매우 불안정해졌고...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"대기 상황이 불안정해진다...", "dc:l", 80, 1)
				ENDIF
		ENDSELECT
		SELECTCASE 雪崩情報
			CASE "なだれ注意報"
				LOCALS = ...%SPLIT_G("An avalanche could occur in the:Risk of avalanche in:There is a risk of a possible avalanche in the")%...
				CALL KEYTYPING(LOCALS, "dc:l", 80, 1)
		ENDSELECT
		SELECTCASE 低温情報
			CASE "低温注意報"
				CALL KEYTYPING(@"해당 지역은 평균 연도에 비해 더 낮은 기온을 경험했다.", "dc:l", 80, 1)
