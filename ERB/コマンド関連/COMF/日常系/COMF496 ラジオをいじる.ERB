				CALL KEYTYPING(@"...Storm warning for the region... evacuate as soon as possible...", "dc:l", 80, 1)
			CASE "風雪注意報"
				CALL KEYTYPING(@"...Wind and snow caution is in effect for the region...", "dc:l", 80, 1)
			CASE "強風注意報"
				CALL KEYTYPING(@"...Strong wind warning for the region...", "dc:l", 80, 1)
