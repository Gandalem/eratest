;custom code - replaced all radio lines with the slow type function for immersion, set to moderate speed

PRINTW You fiddle with the radio knob.
PRINTL

PRINTL ┏━━━━━━┓
PRINT ┃PWR ［
IF 大雨情報 == "大雨特別警報"
	PRINT □□
ELSEIF 大雨情報 == "大雨警報(土砂災害警戒情報)" || 大雪情報 == "大雪特別警報" || 暴風情報 == "暴風雪特別警報" || 暴風情報 == "暴風特別警報"
	IF CONTINUOUS_RAINFALL >= 10
		SETCOLOR C_気象_土砂災害警戒情報
		PRINT ■
		RESETCOLOR
		PRINT □
	ELSE
		SETCOLOR C_気象_土砂災害警戒情報
		PRINT ■■
		RESETCOLOR
	ENDIF
ELSEIF 大雨情報 == "大雨警報" || 大雪情報 == "大雪警報" || 暴風情報 == "暴風雪警報" || 暴風情報 == "暴風警報" || 雷情報 == "雷注意報(竜巻注意情報)" || 雪崩情報 == "なだれ注意報"
	SETCOLOR C_気象_警報
	PRINT ■■
	RESETCOLOR
ELSEIF 大雨情報 == "大雨注意報" || 大雪情報 == "大雪注意報" || 暴風情報 == "風雪注意報" || 暴風情報 == "強風注意報" || 雷情報 == "雷注意報"
	SELECTCASE 早期注意情報
		CASE "警報級の可能性［高］"
			SETCOLOR C_気象_注意報
			PRINT ■■
			RESETCOLOR
		CASE "警報級の可能性［中］"
			SETCOLOR C_気象_注意報
			PRINT ■
			RESETCOLOR
			PRINT ■
		CASEELSE
			SETCOLOR C_気象_注意報
			PRINT ■
			SETCOLOR C_GREEN
			PRINT ■
			RESETCOLOR
	ENDSELECT
ELSE
	SELECTCASE 早期注意情報
		CASE "警報級の可能性［高］"
			PRINT ■■
		CASE "警報級の可能性［中］"
			SETCOLOR C_GREEN
			PRINT ■
			RESETCOLOR
			PRINT ■
		CASEELSE
			SETCOLOR C_GREEN
			PRINT ■■
			RESETCOLOR
	ENDSELECT
ENDIF
PRINTL ］┃
PRINTL ┗━━━━━━┛
;(天候パッチ)雷発生時はノイズが混じる
