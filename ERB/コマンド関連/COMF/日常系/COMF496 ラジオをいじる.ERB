						CALL KEYTYPING(@"...Cold vortex advances into the Sea of Japan...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...Strong cold air moving at high altitudes...", "dc:l", 80, 1)
				ENDSELECT
			CASE "二つ玉低気圧遠方", "日本海低気圧遠方"
				CALL KEYTYPING(@"...over the Sea of Japan... ...low atmospheric pressure...", "dc:l", 80, 1)
