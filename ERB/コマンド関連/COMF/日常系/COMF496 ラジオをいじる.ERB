								CALL KEYTYPING(@"많은 강에서 수위가 홍수 위험 수준을 초과한다...", "dc:l", 80, 1)
						ENDSELECT
					CASE IS >= 10
						SELECTCASE RAND:2
							CASE 0
								CALL KEYTYPING(@"기록적인 시간당 강우량 업데이트를 위한... 도시...", "dc:l", 80, 1)
							CASE 1
								CALL KEYTYPING(@"일 년에 한 번 있는 폭우 이벤트가...", "dc:l", 80, 1)
						ENDSELECT
				ENDSELECT
			CASE "大雨警報(土砂災害警戒情報)"
				SELECTCASE RAND:5
					CASE 0
						CALL KEYTYPING(@"경보 수준이 4로 격상되었다.", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"지난 몇 년간 보아온 산사태의 가장 높은 위험을...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"기상 관측소에서 지역의 산사태 위험을 보고한다.", "dc:l", 80, 1)
					CASE 3
						CALL KEYTYPING(@"해당 시는 ~에 위치한 가구들에 대피 명령을 내렸다.", "dc:l", 80, 1)
					CASE 4
						CALL KEYTYPING(@"모든 노선이 운행이 중단된다.", "dc:l", 80, 1)
				ENDSELECT
			CASEELSE
				IF 暴風情報 == "暴風雪特別警報"
					SELECTCASE RAND:6
						CASE 0
							CALL KEYTYPING(@"해당 지역에 대한 폭풍 특보...", "dc:l", 80, 1)
						CASE 1
							CALL KEYTYPING(@"수십 년 만에 발생한 전례 없는 눈보라...", "dc:l", 80, 1)
						CASE 2
							CALL KEYTYPING(@"지금까지 관측된 가장 심한 눈보라... 불필요하게 외출하는 것을 피하세요...", "dc:l", 80, 1)
						CASE 3
							CALL KEYTYPING(@"사나운 눈보라가 언제든지 발생할 수 있다.", "dc:l", 80, 1)
						CASE 4
							CALL KEYTYPING(@"...결국 고립되었다... 전국적으로... 구조 요청을 했다...", "dc:l", 80, 1)
						CASE 5
							CALL KEYTYPING(@"고속도로에 엄청나게 많은 차들이 갇혀 있었다...", "dc:l", 80, 1)
					ENDSELECT
				ELSEIF 大雪情報 == "大雪特別警報"
					SELECTCASE RAND:4
						CASE 0
							CALL KEYTYPING(@"지금까지 관측된 가장 많은 눈...", "dc:l", 80, 1)
						CASE 1
							CALL KEYTYPING(@"수십 년 만의 최악의 눈보라…", "dc:l", 80, 1)
						CASE 2
							CALL KEYTYPING(@"...주변 지역에 대한 폭설 특보가 발령되었다...", "dc:l", 80, 1)
						CASE 3
							CALL KEYTYPING(@"전국적으로 기록적인 폭설이 내렸다... 많은 사람들이... 고립되었다...", "dc:l", 80, 1)
					ENDSELECT
				ELSEIF 大雪情報 == "大雪警報" && CONTINUOUS_SNOWFALL >= 20
					SELECTCASE RAND:2
						CASE 0
							CALL KEYTYPING(@"기상 관측소의 보고에 따르면... 해당 지역에 상당한 폭설이 내리고 있다...", "dc:l", 80, 1)
						CASE 1
							CALL KEYTYPING(@"폭설로 인해 심각한 교통 체증이 발생하고 있다.", "dc:l", 80, 1)
					ENDSELECT
				ELSEIF 雷情報 == "雷注意報(竜巻注意情報)"
					SELECTCASE RAND:3
						CASE 0
							CALL KEYTYPING(@"해당 지역에서 토네이도 발생의 위협이 커지고 있다.", "dc:l", 80, 1)
						CASE 1
							CALL KEYTYPING(@"적란운이 다가오고 있다... 안전한 곳으로 가라...", "dc:l", 80, 1)
						CASE 2
							CALL KEYTYPING(@"강한 돌풍과 우박이 많은 지역에 피해를 주고 있다.", "dc:l", 80, 1)
					ENDSELECT
				ELSEIF POSSIBLITY_AVALANCHE >= 1
					CALL KEYTYPING(@"많은 지역에서 눈사태가 피해를 입히고 있다.", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"... ......... ......", "dc:l", 80, 1)
				ENDIF
		ENDSELECT
ENDSELECT
TIME += 15
