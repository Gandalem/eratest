					CASE 1,3
						IF IS_RAINY_SEASON1:0 == 1 || IS_RAINY_SEASON2 == 1
							CALL KEYTYPING(@"...on and off weather...", "dc:l", 80, 1)
						ELSE
							CALL KEYTYPING(@"...calm weather...", "dc:l", 80, 1)
						ENDIF
					CASE 2
						IF POWER_WARM_AIR == 1
							CALL KEYTYPING(@"...the weakening expansion of the Pacific anticyclone...", "dc:l", 80, 1)
						ELSE
							CALL KEYTYPING(@"...Summer skies across the country...", "dc:l", 80, 1)
						ENDIF
					CASE 4
						CALL KEYTYPING(@"...high barometric pressure to the west, low pressure to the east... ...winter pressure pattern...", "dc:l", 80, 1)
				ENDSELECT
		ENDSELECT
		
		SELECTCASE 大雨情報
			CASE "大雨特別警報"
				SELECTCASE RAND:4
					CASE 0
						CALL KEYTYPING(@"...the harshest rain we have ever experienced to date...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"...the unprecedented precipitation in decades...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...heavy rain emergency warning for... surrounding region at...", "dc:l", 80, 1)
					CASE 3
