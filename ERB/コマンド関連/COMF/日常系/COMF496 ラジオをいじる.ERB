				CALL KEYTYPING(@"...over the East China Sea... ...low atmospheric pressure...", "dc:l", 80, 1)
			CASE "南岸低気圧接近"
				CALL KEYTYPING(@"...Low atmospheric pressure developing over the Pacific Ocean...", "dc:l", 80, 1)
			CASE "温暖前線遠方"
