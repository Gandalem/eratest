				ELSE
					CALL KEYTYPING(@"...Low atmospheric pressure in the middle of a week...", "dc:l", 80, 1)
				ENDIF
			CASE "温暖前線接近"
				CALL KEYTYPING(@"...due to the approach of a warm front from the west...", "dc:l", 80, 1)
