			CASE "大雨注意報"
				SELECTCASE RAND:2
					CASE 0
						CALL KEYTYPING(@"...You can access the hazard map for your region at...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"...the Meteorological Observatory... has issued a storm warning for the region...", "dc:l", 80, 1)
				ENDSELECT
		ENDSELECT
		
		SELECTCASE 大雪情報
			CASE "大雪特別警報"
				SELECTCASE RAND:3
					CASE 0
						CALL KEYTYPING(@"...the heaviest snowfall ever seen to date...", "dc:l", 80, 1)
					CASE 1
						CALL KEYTYPING(@"...The worst snowfall in decades...", "dc:l", 80, 1)
					CASE 2
						CALL KEYTYPING(@"...heavy snow emergency warning for... surrounding region at...", "dc:l", 80, 1)
				ENDSELECT
			CASE "大雪警報"
				IF CONTINUOUS_SNOWFALL >= 20
					CALL KEYTYPING(@"...the Meteorological Observatory's report concerning... ...significant heavy snowfall in the region...", "dc:l", 80, 1)
