					CALL KEYTYPING(@"...closest point of approach... ...with extreme caution...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"...closest point of approach... ...very careful...", "dc:l", 80, 1)
				ENDIF
			CASE "台風通過暴風域", "台風通過強風域"
				CALL KEYTYPING(@"...%ARTICLE(台風勢力)% typhoon... approaching... ", "dc", 80, 1)
				IF 暴風情報 == "暴風特別警報"
					CALL KEYTYPING(@"...remains at record strength... passing through... still... on high alert...", "dc:l", 80, 1)
				ELSEIF IS_TYPHOON:1 >= 3
					CALL KEYTYPING(@"...remains a force to be reckoned with... passing through...", "dc:l", 80, 1)
				ELSE
					CALL KEYTYPING(@"...is passing through...", "dc:l", 80, 1)
				ENDIF
			CASE "寒冷渦遠方", "寒冷渦接近"
