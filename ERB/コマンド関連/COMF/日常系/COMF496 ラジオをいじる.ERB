				ELSE
					CALL KEYTYPING(@"...Day {TIME_CLOSEST_TYPHOON:1} at %GET_NAME_WEATHER_TIMEZOME_TR(TIME_CLOSEST_TYPHOON:2)%... very close...", "dc:l", 80, 1)
				ENDIF
			CASE "台風最接近"
				CALL KEYTYPING(@"...%ARTICLE(台風勢力)% typhoon... approaching... ", "dc", 80, 1)
