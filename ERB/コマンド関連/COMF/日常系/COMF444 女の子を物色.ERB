@LOAD_MOBGIRL(ARG, masterCreator = 0)
#DIM nSlot
#DIM PAGE
#DIM FIRST_LINE
#DIM masterCreator
;NAS custom code
;custom character menu
$RELOOP
DO
FIRST_LINE = LINECOUNT
DRAWLINE
PRINTFORML 커스텀 캐릭터 관리
DRAWLINE
CALL LISTUP_CUSTOM_CHARACTER(0, PAGE, 20)
DRAWLINE
PRINTBUTTON "[반환]", 10000
INPUT
LOCAL = RESULT
;SIF LOCAL == 100
;	CALL PRINT_SAVED_GIRL_STATS
SELECTCASE LOCAL
	CASE 10000
		;----------------------------------------------------
		RETURN -1
	CASE MAX_CUSTOM_CHARA
		PAGE = ROUND_DECREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
	CASE MAX_CUSTOM_CHARA + 1
		PAGE = ROUND_INCREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
	CASE 0 TO MAX_CUSTOM_CHARA
		IF FIND_CHARADATA(TOSTR(LOCAL))
			BREAK
		ENDIF
ENDSELECT
CLEARLINE FIRST_LINE - LINECOUNT
LOOP 1
$END
nSlot = FREE_MOB_SLOT()
SIF nSlot >= CHARANUM
	nSlot = CHARANUM -1
IF FIND_CHARADATA(TOSTR(LOCAL))
	CALL モブ子画像リセット(nSlot)
	;DELCHARA RANDOM_CHARANUM
	; LOADCHARA TOSTR(LOCAL)
	CALL LOAD_CUSTOM_DATA(LOCAL)
	nSlot = CHARANUM-1
	;bugfix custom code, when loading mobs from older saves, ensure that if new characters have been added in the interim we update the NO for the mob
	;subsequently save the mob and reload it to ensure all the correct sprites are loaded
	IF NO:nSlot != CSV_CHARANUM() && TALENT:nSlot:300
		NO:nSlot = CSV_CHARANUM()
		CALL SAVE_CUSTOM_DATA(LOCAL, nSlot)
		CALL モブ子画像リセット(nSlot)
		DELCHARA nSlot
		; LOADCHARA TOSTR(LOCAL)
		CALL LOAD_CUSTOM_DATA(LOCAL)
	ENDIF
	;NAS custom code: sleepy custom characters
	PRINTFORML {NO:nSlot}
	SIF !INRANGE(NO:nSlot,0,CHARANUM-1)
		NO:nSlot = RANDOM_CHARANUM
	; CFLAG:nSlot:来訪時間 = CSVCFLAG(NO:nSlot,352)
	; CFLAG:nSlot:帰宅時間 = CSVCFLAG(NO:nSlot,353)
	; CFLAG:nSlot:就寝時間 = CSVCFLAG(NO:nSlot,354)
	; CFLAG:nSlot:起床時間 = CSVCFLAG(NO:nSlot,355)
	IF !VISIT(nSlot) && !masterCreator
		PRINTFORML %CALLNAME:nSlot%은 잠들어 있는 것 같다...
		PRINTFORMW 방문 가능 시간: %時刻表示(CFLAG:nSlot:来訪時間)%부터 %時刻表示(CFLAG:nSlot:帰宅時間)%까지
		CALLF ClearALlHediffs(CHARANUM,1)
		DELCHARA CHARANUM-1
		ADDCHARA CSV_CHARANUM()
		GOTO RELOOP
	ELSE
	ENDIF
	PRINTFORML 너는 %CALLNAME:nSlot%을 발견한다.
	IF MOBGIRL_FP:LOCAL != ""
		モブ子一人称 = %MOBGIRL_FP:LOCAL%
		モブ子二人称 = %MOBGIRL_SP:LOCAL%
	ENDIF
	SIF Mob_Personality:nSlot:0 == 0 || Mob_MasterName:nSlot:0 == "" ;custom code, init translated pronoun types if not found ;custom code, init translated pronoun types if not found
		CALL MOB_PRONOUN_INIT(MOBGIRL_FP:LOCAL, MOBGIRL_SP:LOCAL, nSlot)
	IF CSTR:nSlot:モブ子画像文字列_服_通常 == "" && !masterCreator
		PRINTFORML 용모가 설정되어 있지 않다. 아래 목록에서 선택한다.
		;NAS
		CALL MOB_IMAGE_SELECTION(ARG)
	ENDIF
	; IF NO:RANDOM_CHARANUM != RANDOM_CHARANUM
	;     NO:RANDOM_CHARANUM = RANDOM_CHARANUM
	; ENDIF
	;過去に合成されて裸画像の笑顔に[装飾_照れ]が乗ってない場合に追記
	SIF STRFIND(CSTR:nSlot:モブ子画像文字列_裸_笑顔, "装飾_照れ") == -1
		CSTR:nSlot:モブ子画像文字列_裸_笑顔 += "[装飾9:装飾_照れ][乗色:朱色]"
	;過去（ver4.760以前）に保存されて種族のTALENT設定が適合しない場合に修正を行う
	SELECTCASE CAN_NANPA(CFLAG:MASTER:現在位置)
		;里
		CASE 1
			;以前の194 人間が現varでは194 幽霊になっている
			IF TALENT:nSlot:幽霊
				TALENT:nSlot:幽霊 = 0
				TALENT:nSlot:人間 = 1
			ENDIF
			;霧の湖、紅魔館、および地底の妖精たち
		CASE 2, 3, 5
			;以前の190 妖精が現verでは190 人間になっている
			IF TALENT:nSlot:人間
				TALENT:nSlot:人間 = 0
				TALENT:nSlot:妖精 = 1
			ENDIF
			;竹林
		CASE 4
			;イナバ…妖獣が新設された
			SIF TALENT:nSlot:妖怪 != 6
				TALENT:nSlot:妖怪 = 6
			;冥界
		CASE 6
			;化け狸、狐、猫…妖獣が新設された
			SIF TALENT:nSlot:妖怪 != 6
				TALENT:nSlot:妖怪 = 6
			;妖怪の山山麓
		CASE 7
			;河童…河童が新設された
			SIF TALENT:nSlot:妖怪 != 4
				TALENT:nSlot:妖怪 = 4
			;妖怪の山山頂
		CASE 8
			;白狼天狗…以前の197 天狗が現verでは197 追加種族（巫女）になっている
			IF TALENT:nSlot:追加種族
				TALENT:nSlot:追加種族 = 0
				TALENT:nSlot:妖怪 = 5
			ENDIF
			;地底　鬼か妖精
		CASE 9
			;鬼…以前の195 鬼が現verでは195　付喪神になっている
			IF TALENT:nSlot:付喪神
				TALENT:nSlot:付喪神 = 0
				TALENT:nSlot:妖怪 = 2
				;妖精は同上
			ELSEIF TALENT:nSlot:人間
				TALENT:nSlot:人間 = 0
				TALENT:nSlot:妖精 = 1
			ENDIF
			;月　一応分けておく
		CASE 10
			;玉兎…妖獣が新設された
			SIF TALENT:nSlot:妖怪 != 6
				TALENT:nSlot:妖怪 = 6
	ENDSELECT
	IF FLAG:70 || masterCreator	;時間停止中と風俗嬢は反応なし
	ELSEIF TALENT:nSlot:風俗嬢
	ELSEIF CFLAG:nSlot:負け犬 && (TALENT:nSlot:セフレ || TALENT:nSlot:思慕)
		PRINTFORMW %CALLNAME:nSlot%은 당신을 보고 초조해하지만, %HE_SHE(nSlot)%는 다소 기대하며 몸을 꿈틀거린다...
	ELSEIF CFLAG:nSlot:負け犬 && !TALENT:nSlot:恋慕 && !TALENT:nSlot:思慕 && !TALENT:nSlot:愛欲
		PRINTFORMW 다시 당신을 본 %CALLNAME:nSlot%의 얼굴이 굳는다.
	ELSEIF TALENT:nSlot:恋慕
		PRINTFORMW %CALLNAME:nSlot%은(는) 당신을 보자마자 기쁘게 달려온다.
	ELSEIF TALENT:nSlot:愛欲
		PRINTFORMW %CALLNAME:nSlot%은(는) 당신을 보자마자 다가와 팔에 기대며 달려온다...
	ELSEIF ABL:nSlot:親密 >= 5
		PRINTFORMW 다시 당신을 보게 되자, %CALLNAME:nSlot%은(는) 손을 흔든다.
	ENDIF
	CALL Qol_Info_Reset(nSlot) ;qol custom code
ELSE
	RETURN -1
ENDIF

@SAVE_MOBGIRL(nChara)
#DIM CHOSEN_MOB
#DIM nChara
#DIMS MOBNAME
#DIM FIRST_LINE
#DIM PAGE
;NAS custom code
;custom character menu
$LOOP
DO
FIRST_LINE = LINECOUNT
DRAWLINE
PRINTFORML 커스텀 캐릭터 관리
DRAWLINE
CALL LISTUP_CUSTOM_CHARACTER(0, PAGE, 20)
DRAWLINE
PRINTBUTTON "[반환]", 10000
INPUT
CHOSEN_MOB = RESULT
SELECTCASE CHOSEN_MOB
	CASE 10000
		RETURN -1
	CASE MAX_CUSTOM_CHARA
		PAGE = ROUND_DECREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
	CASE MAX_CUSTOM_CHARA + 1
		PAGE = ROUND_INCREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
	CASE 0 TO MAX_CUSTOM_CHARA
		BREAK
ENDSELECT
CLEARLINE FIRST_LINE - LINECOUNT
LOOP 1
;Custom code
LOCAL:150 = 0
IF FIND_CHARADATA(TOSTR(CHOSEN_MOB))
	LOCAL:150 = 1
	CHKCHARADATA RESULTS:0
	STRFIND RESULTS:0, "："
	SUBSTRING RESULTS:0, 0, RESULT
	MOBNAME = %RESULTS:0%
	PRINTFORML %MOBNAME%는 잊고 대신 %CALLNAME:nChara%를 외울까?
	CALL ASK_YN
	IF !RESULT
		PRINTFORM 당신은 그 자리에서 %MOBNAME%에 대해 냉정하게 모든 것을 잊어버린다. 
	ELSE
		GOTO LOOP
	ENDIF
ENDIF
IF TALENT:nChara:行きずり
	MOBGIRL_PLACE:CHOSEN_MOB = CFLAG:nChara:よく行く地域
	SIF TALENT:nChara:風俗嬢
		MOBGIRL_PLACE:CHOSEN_MOB = 90
	TALENT:nChara:行きずり = 2
	CFLAG:nChara:モブ子セーブスロット = CHOSEN_MOB
	MOBGIRL_FP:CHOSEN_MOB = %モブ子一人称%
	MOBGIRL_SP:CHOSEN_MOB = %モブ子二人称%
	SIF Mob_Personality:RANDOM_CHARANUM:0 == 0 || Mob_MasterName:RANDOM_CHARANUM:0 == "" ;custom code, init translated pronoun types if not found ;custom code, init translated pronoun types if not found
		CALL MOB_PRONOUN_INIT(MOBGIRL_FP:CHOSEN_MOB, MOBGIRL_SP:CHOSEN_MOB, RANDOM_CHARANUM) ;custom code
ENDIF
CALL SAVE_CUSTOM_DATA(CHOSEN_MOB, nChara)
IF LOCAL:150
	PRINTFORMW 그리고 그녀를 가장 좋아하는 사람으로 표시하며 %CALLNAME:RANDOM_CHARANUM%을 기억한다.%COND_STR(@", marking her as a favorite", TALENT:RANDOM_CHARANUM:風俗嬢)%.
ELSE
	PRINTFORMW %CALLNAME:RANDOM_CHARANUM%%COND_STR(@", marking her as a favorite", TALENT:RANDOM_CHARANUM:風俗嬢)%를(를) 기억한다.
ENDIF
