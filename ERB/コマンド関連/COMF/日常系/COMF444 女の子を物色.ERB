; Modular ERB: COMF/日常系/COMF444 女の子を物色.ERB
;-------------------------------------------------
;女の子を物色
;日常系コマンド、レベル1
;-------------------------------------------------

@COM444
#DIM nSlot
#DIMS YUKIZURI_RACE  ;生成するMOB娘の種類
IF FLAG:デート相手 != MASTER
	PRINTFORMW 이미 땅을 뒤흔들 만큼 귀여운 소녀가 근처에 있다.
	RETURN -1
ENDIF
;com stuff custom code
;-------------------------
;潜伏モード中は不可
IF GETBIT(FLAG:潜伏,0)
	PRINTFORMW 지금은 그것을 찾을 때가 아니다.
	RETURN -1
ENDIF
GOTO BYPASS
LOCAL = 0 ;com stuff custom code
$BUSSYOKU
IF BASE:MASTER:TSP < 50
	PRINTFORML 당신의 시간 정지 능력은 곧 소진됩니다...
	GOTO END
ENDIF
;------------------------------------
IF !FLAG:70
	TIME += 3
ELSE
	BASE:MASTER:TSP -= 10
ENDIF
PRINTFORML 당신은 귀여운 소녀를 찾고 있다.
PRINTFORMW ...저 아이는 어때?
;Bugfix, moving this as canceling here messes things up
;SETBIT TFLAG:一日一回, 9
SELECTCASE CAN_NANPA(CFLAG:MASTER:現在位置)
	CASE 1
		YUKIZURI_RACE '= TEXTR("町娘/人妻")
	CASE 2
		YUKIZURI_RACE = 妖精
	CASE 3
		YUKIZURI_RACE = メイド妖精
	CASE 4
		;３日に一度販売員が出没
		IF ((GETTIME()/1000000000) % 100) % 3 == 1 && !RAND:7
			YUKIZURI_RACE = 販売員
		ELSE
			YUKIZURI_RACE = イナバ
		ENDIF
	CASE 5
		YUKIZURI_RACE = ゾンビフェアリー
	CASE 6
		YUKIZURI_RACE '= TEXTR("化け狐/化け猫")
	CASE 7
		YUKIZURI_RACE '= TEXTR("山童/河童")
	CASE 8
		YUKIZURI_RACE '= TEXTR("白狼天狗/鴉天狗")
	CASE 9
		IF !RAND:10
			YUKIZURI_RACE = 鬼
		ELSE
			YUKIZURI_RACE = ゾンビフェアリー
		ENDIF
	CASE 10
		YUKIZURI_RACE = 玉兎
	CASE 11
		YUKIZURI_RACE '= TEXTR("化け狸/茨たぬき")
ENDSELECT
;PRINTFORMW %YUKIZURI_RACE%
;com stuff custom code
CALL Com_MobRaceSelect(YUKIZURI_RACE, LOCAL)
LOCALS '= RESULTS
SIF RESULTS == "none"
	LOCAL = -1
;--------------------------------------------
nSlot = FREE_MOB_SLOT()
CALL MAKE_YUKIZURI(nSlot, YUKIZURI_RACE)
IF nSlot >= CHARANUM
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML 스침 캐릭터 슬롯 {nSlot}을 만들려고 했으나, 이용 가능한 것은 {CHARANUM}뿐이다.
	PRINTFORMW 모브 소녀 사냥 취소한다.
	PRINTFORML !이것을 보고하라!
	PRINTFORML %"-"*89%
	RESETCOLOR
	FORCEWAIT
	RETURN
ELSEIF nSlot == 0
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML 스침 캐릭터 슬롯이 설정되지 않았습니다.
	PRINTFORMW 스침 소녀 사냥을 중단합니다.
	PRINTFORML 이것을 보고하십시오!
	PRINTFORML %"-"*89%
	RESETCOLOR
	FORCEWAIT
	RETURN
ENDIF
TEQUIP:nSlot:上半身着衣状況 = 1
$CHOICE
;Custom code
CALL CHARA_STATE_TR(nSlot)
IF CSTR:nSlot:処女喪失履歴 != ""
	DRAWLINE
	CALL COLORMESSAGE(@"처녀 상실 이력: %CSTR:nSlot:処女喪失履歴%",C_PINK,1)
	PRINTFORML 
ENDIF
;DEBUGPRINTFORML %CSTR:nSlot:モブ子画像文字列_服_通常%
$BYPASS
CALL ASK_M( "이거 좋다",nSlot, @"다른 것을 찾아라 \@ !INRANGE(TIME,420,1140) ? %" (이용 가능 시간: "+TWENTY_FOUR_TIME(420)+"～"+TWENTY_FOUR_TIME(1140)+")"% #  \@", INRANGE(TIME,420,1140), "방금 그 사람을 찾아라", TFLAG:直前モブ子マップ == CFLAG:MASTER:現在位置 /100, "이전에 만난 사람 중 한 명을 찾아라",1, "사냥을 멈춰라",1, @"현재 종족: %CAP_PROCESS(LOCALS, 5)%", LOCAL != -1) ;com stuff custom code, specify race
;com stuff custom code
IF LOCAL != -1 && RESULT == 5
	LOCAL = ROUND_INCREMENT(LOCAL, 0, 2)
	GOTO BUSSYOKU
ENDIF
;-----------------------------------------
IF RESULT == 4
	$END
	SIF !nSlot
		RETURN -1
	CFLAG:nSlot:現在位置 = SUKIMA()
	CFLAG:nSlot:着替え実行 = 0
	CFLAG:nSlot:出禁 = 2
	CFLAG:nSlot:デート中 = -1 ;com stuff, disable dating flag
	SIF TARGET == nSlot
		TARGET = 0
	RETURN -1
ENDIF
IF RESULT == 1
	SIF !nSlot
		nSlot = CHARANUM-1
	TFLAG:直前モブ子マップ = CFLAG:MASTER:現在位置 /100
	SAVECHARA "TEMP_MOB", "直前に会った子", nSlot
	CALLF ClearALlHediffs(nSlot,1)
	DELCHARA nSlot
	ADDCHARA CSV_CHARANUM()
	GOTO BUSSYOKU
ELSEIF RESULT == 3
	SIF !nSlot
		nSlot = CHARANUM-1
	CALL LOAD_MOBGIRL(0)
	IF RESULT == -1
		;念のためまっさらにしておく
		CALL モブ子画像リセット(nSlot)
		CALLF ClearALlHediffs(nSlot,1)
		DELCHARA nSlot
		ADDCHARA CSV_CHARANUM()
		;com stuff, disable dating flag
		CFLAG:nSlot:出禁 = 2
		CFLAG:nSlot:デート中 = -1
		RETURN -1
	ENDIF
	nSlot = CHARANUM-1
	CFLAG:nSlot:出禁 = 0
ELSEIF RESULT == 2
	CALL モブ子画像リセット(nSlot)
	CALLF ClearALlHediffs(nSlot,1)
	DELCHARA nSlot
	LOADCHARA "TEMP_MOB"
	TFLAG:直前モブ子マップ = 0
	GOTO CHOICE
ENDIF
SIF !nSlot
	nSlot = CHARANUM-1
PRINTFORML {nSlot}
CFLAG:nSlot:現在位置 = CFLAG:MASTER:現在位置
CFLAG:nSlot:デート中 = MAIN_MAP
IF CFLAG:MASTER:現在位置 / 100 == MAIN_MAP
	;拠点内で時間停止せずに物色した場合は、同行扱い
	;IF !FLAG:70 ;com stuff
	CFLAG:nSlot:同行 = 180
	CFLAG:MASTER:同行 = 180
	SIF FLAG:70
		PRINTFORMW 당신은 시간을 재개하고, %CALLNAME:nSlot%에게 날짜를 묻는다.
	FLAG:70 = 0
	;ENDIF
	CFLAG:nSlot:拠点来訪 = 1
	CFLAG:nSlot:遭遇位置 = 0
	;CFLAG:nSlot:自宅位置 = 0
	CFLAG:nSlot:来訪時間 = CSVCFLAG(NO:nSlot,352)
	CFLAG:nSlot:帰宅時間 = CSVCFLAG(NO:nSlot,353)
	CFLAG:nSlot:就寝時間 = CSVCFLAG(NO:nSlot,354)
	CFLAG:nSlot:起床時間 = CSVCFLAG(NO:nSlot,355)
ELSE
	;引っ越ししたりして定義しなおす場合もあるので、毎回確認
	CFLAG:nSlot:拠点来訪 = 0
	CFLAG:nSlot:遭遇位置 = CFLAG:MASTER:現在位置
	;CFLAG:nSlot:自宅位置 = CFLAG:MASTER:現在位置
	CFLAG:nSlot:来訪時間 = 0
	CFLAG:nSlot:帰宅時間 = 0
	CFLAG:nSlot:就寝時間 = 0
	CFLAG:nSlot:起床時間 = 0
ENDIF
CFLAG:nSlot:ディレイ = 30
TARGET = nSlot
TFLAG:現在のTARGET = TARGET ;com stuff
;Bugfix, moved the assignment of flag here
SETBIT TFLAG:一日一回, 9
CALL Com_Date_Meet(nSlot) ;com custom code, handle first time meeting/greeting
SIF CFLAG:MASTER:現在位置 / 100 != MAIN_MAP
	CALL Com_DateRando(nSlot) ;com custom code, ask whether to date on the spot or bring her with you
RETURN 1

@COM_ABLE444
;一括管理
SIF GLOBAL_COMABLE(622)
	RETURN RESULT
SIF !CAN_NANPA(CFLAG:MASTER:現在位置)
	RETURN 0
;SIF !INRANGE(TIME,420,1140)
;	RETURN 0
SIF CFLAG:MASTER:睡眠 || CFLAG:MASTER:イタズラ || CFLAG:うふふ ;com custom code
