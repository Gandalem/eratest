@COM444
#DIM nSlot
#DIMS YUKIZURI_RACE  ;生成するMOB娘の種類

IF FLAG:デート相手 != MASTER
	PRINTFORMW There is already an earth-shatteringly adorable girl nearby.
	RETURN -1
ENDIF

;com stuff custom code
[SKIPSTART]
IF CFLAG:RANDOM_CHARANUM:現在位置 > 0 && CFLAG:RANDOM_CHARANUM:現在位置 != SUKIMA()
	PRINTFORML Currently existing random girl will be removed.
	PRINTFORML Proceed?
	CALL ASK_YN
	SIF RESULT
		RETURN -1
ENDIF
[SKIPEND]
;-------------------------

;潜伏モード中は不可
IF GETBIT(FLAG:潜伏,0)
	PRINTFORMW Now is not the time to be looking for that.
	RETURN -1
ENDIF

GOTO BYPASS

LOCAL = 0 ;com stuff custom code

$BUSSYOKU
[SKIPSTART]
;com custom code, kick the player out
IF !INRANGE(TIME,420,1140)
	PRINTFORML It's getting too late...
	GOTO END
ENDIF
[SKIPEND]
IF BASE:MASTER:TSP < 50
	PRINTFORML Your Time Stop ability is about to run out...
	GOTO END
ENDIF
;------------------------------------

IF !FLAG:70
	TIME += 3
ELSE
	BASE:MASTER:TSP -= 10
ENDIF
PRINTFORML You are looking for a cute girl.
PRINTFORMW ...How about that one?
;Bugfix, moving this as canceling here messes things up
;SETBIT TFLAG:一日一回, 9
SELECTCASE CAN_NANPA(CFLAG:MASTER:現在位置)
	CASE 1
		YUKIZURI_RACE '= TEXTR("町娘/人妻")
	CASE 2
		YUKIZURI_RACE = 妖精
	CASE 3
		YUKIZURI_RACE = メイド妖精
	CASE 4
		;３日に一度販売員が出没
		IF ((GETTIME()/1000000000) % 100) % 3 == 1 && !RAND:7
			YUKIZURI_RACE = 販売員
		ELSE
			YUKIZURI_RACE = イナバ
		ENDIF
	CASE 5
		YUKIZURI_RACE = ゾンビフェアリー
	CASE 6
		YUKIZURI_RACE '= TEXTR("化け狐/化け猫")
	CASE 7
		YUKIZURI_RACE '= TEXTR("山童/河童")
	CASE 8
		YUKIZURI_RACE '= TEXTR("白狼天狗/鴉天狗")
	CASE 9
		IF !RAND:10
			YUKIZURI_RACE = 鬼
		ELSE
			YUKIZURI_RACE = ゾンビフェアリー
		ENDIF
	CASE 10
		YUKIZURI_RACE = 玉兎
	CASE 11
		YUKIZURI_RACE '= TEXTR("化け狸/茨たぬき")
ENDSELECT

;PRINTFORMW %YUKIZURI_RACE%

;com stuff custom code
CALL Com_MobRaceSelect(YUKIZURI_RACE, LOCAL)
LOCALS '= RESULTS
SIF RESULTS == "none"
	LOCAL = -1
;--------------------------------------------
nSlot = FREE_MOB_SLOT()
CALL MAKE_YUKIZURI(nSlot, YUKIZURI_RACE)
IF nSlot >= CHARANUM
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML Mob character slot {nSlot} tried to be made, but there are only {CHARANUM} available.
	PRINTFORMW ABORTING MOB GIRL HUNTING
	PRINTFORML !REPORT THIS!
	PRINTFORML %"-"*89%
	RESETCOLOR 
	FORCEWAIT
	RETURN
ELSEIF nSlot == 0
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML Mob character slot was not set
	PRINTFORMW ABORTING MOB GIRL HUNTING
	PRINTFORML !REPORT THIS!
	PRINTFORML %"-"*89%
	RESETCOLOR 
	FORCEWAIT
	RETURN
ENDIF

TEQUIP:nSlot:上半身着衣状況 = 1
$CHOICE
;Custom code
CALL CHARA_STATE_TR(nSlot)
IF CSTR:nSlot:処女喪失履歴 != ""
	DRAWLINE
	CALL COLORMESSAGE(@"Virginity loss history: %CSTR:nSlot:処女喪失履歴%",C_PINK,1)
	PRINTFORML 
ENDIF
;DEBUGPRINTFORML %CSTR:nSlot:モブ子画像文字列_服_通常%
$BYPASS
{
CALL ASK_M(
	"This one's good",nSlot,
	@"Look for another one \@ !INRANGE(TIME,420,1140) ? %" (Available: "+TWENTY_FOUR_TIME(420)+"～"+TWENTY_FOUR_TIME(1140)+")"% #\@", INRANGE(TIME,420,1140),
	"Find the one from just now", TFLAG:直前モブ子マップ == CFLAG:MASTER:現在位置 /100,
	"Find one from earlier",1,
	"Stop the hunt",1,
	@"Current Race: %CAP_PROCESS(LOCALS, 5)%", LOCAL != -1) ;com stuff custom code, specify race
}
;com stuff custom code
IF LOCAL != -1 && RESULT == 5
	LOCAL = ROUND_INCREMENT(LOCAL, 0, 2)
	GOTO BUSSYOKU
ENDIF
;-----------------------------------------
IF RESULT == 4
	$END
	SIF !nSlot
		RETURN -1
	CFLAG:nSlot:現在位置 = SUKIMA()
	CFLAG:nSlot:着替え実行 = 0
	CFLAG:nSlot:出禁 = 2
	CFLAG:nSlot:デート中 = -1 ;com stuff, disable dating flag
	SIF TARGET == nSlot
		TARGET = 0
	RETURN -1
ENDIF
IF RESULT == 1
	SIF !nSlot
		nSlot = CHARANUM-1

	TFLAG:直前モブ子マップ = CFLAG:MASTER:現在位置 /100
	SAVECHARA "TEMP_MOB", "直前に会った子", nSlot
	CALLF ClearALlHediffs(nSlot,1)
	DELCHARA nSlot
	ADDCHARA CSV_CHARANUM()
	GOTO BUSSYOKU
ELSEIF RESULT == 3
	SIF !nSlot
		nSlot = CHARANUM-1
	CALL LOAD_MOBGIRL(0)
	IF RESULT == -1
		;念のためまっさらにしておく
		CALL モブ子画像リセット(nSlot)
		CALLF ClearALlHediffs(nSlot,1)
		DELCHARA nSlot
		ADDCHARA CSV_CHARANUM()
		;com stuff, disable dating flag
		CFLAG:nSlot:出禁 = 2
		CFLAG:nSlot:デート中 = -1
		RETURN -1
	ENDIF
	nSlot = CHARANUM-1
	CFLAG:nSlot:出禁 = 0
ELSEIF RESULT == 2
	CALL モブ子画像リセット(nSlot)
	CALLF ClearALlHediffs(nSlot,1)
	DELCHARA nSlot
	LOADCHARA "TEMP_MOB"
	TFLAG:直前モブ子マップ = 0
	GOTO CHOICE
ENDIF
	SIF !nSlot
		nSlot = CHARANUM-1
PRINTFORML {nSlot}
CFLAG:nSlot:現在位置 = CFLAG:MASTER:現在位置
CFLAG:nSlot:デート中 = MAIN_MAP

IF CFLAG:MASTER:現在位置 / 100 == MAIN_MAP
	;拠点内で時間停止せずに物色した場合は、同行扱い
	;IF !FLAG:70 ;com stuff
		CFLAG:nSlot:同行 = 180
		CFLAG:MASTER:同行 = 180
		SIF FLAG:70
			PRINTFORMW You resume the time, asking %CALLNAME:nSlot% on a date.
		FLAG:70 = 0
	;ENDIF
	CFLAG:nSlot:拠点来訪 = 1
	CFLAG:nSlot:遭遇位置 = 0
	;CFLAG:nSlot:自宅位置 = 0
	CFLAG:nSlot:来訪時間 = CSVCFLAG(NO:nSlot,352)
	CFLAG:nSlot:帰宅時間 = CSVCFLAG(NO:nSlot,353)
	CFLAG:nSlot:就寝時間 = CSVCFLAG(NO:nSlot,354)
	CFLAG:nSlot:起床時間 = CSVCFLAG(NO:nSlot,355)
ELSE
	;引っ越ししたりして定義しなおす場合もあるので、毎回確認
	CFLAG:nSlot:拠点来訪 = 0
	CFLAG:nSlot:遭遇位置 = CFLAG:MASTER:現在位置
	;CFLAG:nSlot:自宅位置 = CFLAG:MASTER:現在位置
	CFLAG:nSlot:来訪時間 = 0
	CFLAG:nSlot:帰宅時間 = 0
	CFLAG:nSlot:就寝時間 = 0
	CFLAG:nSlot:起床時間 = 0
ENDIF
CFLAG:nSlot:ディレイ = 30
TARGET = nSlot
TFLAG:現在のTARGET = TARGET ;com stuff
;Bugfix, moved the assignment of flag here
SETBIT TFLAG:一日一回, 9

CALL Com_Date_Meet(nSlot) ;com custom code, handle first time meeting/greeting
SIF CFLAG:MASTER:現在位置 / 100 != MAIN_MAP
	CALL Com_DateRando(nSlot) ;com custom code, ask whether to date on the spot or bring her with you
RETURN 1


