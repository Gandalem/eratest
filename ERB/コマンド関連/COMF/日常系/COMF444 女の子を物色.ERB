#FUNCTION
#DIM YEAR
#DIM MOUTH
#DIMS 季
#DIM DAYS
#DIMS カット
#DIM TOTAL
SPLIT ARGS, "：", LOCALS
カット = %LOCALS:1%
SPLIT カット, "年目 ", LOCALS
カット = %LOCALS:1%
YEAR = TOINT(LOCALS:0)
SPLIT カット, "の月の", LOCALS
季 = %LOCALS:0%
カット = %LOCALS:1%
