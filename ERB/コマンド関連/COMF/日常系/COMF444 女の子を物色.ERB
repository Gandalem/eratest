@LOAD_MOBGIRL(ARG, masterCreator = 0)
#DIM nSlot
#DIM PAGE
#DIM FIRST_LINE
#DIM masterCreator

;NAS custom code
;custom character menu
$RELOOP
DO
FIRST_LINE = LINECOUNT
DRAWLINE
PRINTFORML Custom character management
DRAWLINE
CALL LISTUP_CUSTOM_CHARACTER(0, PAGE, 20)
DRAWLINE
PRINTBUTTON "[Return]", 10000
INPUT
LOCAL = RESULT
;SIF LOCAL == 100
;	CALL PRINT_SAVED_GIRL_STATS
SELECTCASE LOCAL
CASE 10000
;----------------------------------------------------
	RETURN -1
CASE MAX_CUSTOM_CHARA
	PAGE = ROUND_DECREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
CASE MAX_CUSTOM_CHARA + 1
	PAGE = ROUND_INCREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
CASE 0 TO MAX_CUSTOM_CHARA
	IF FIND_CHARADATA(TOSTR(LOCAL))
		BREAK
	ENDIF
ENDSELECT
CLEARLINE FIRST_LINE - LINECOUNT
LOOP 1

$END

nSlot = FREE_MOB_SLOT()
SIF nSlot >= CHARANUM
	nSlot = CHARANUM -1
[SKIPSTART]
IF !ARG && MOBGIRL_PLACE:LOCAL != CFLAG:MASTER:現在位置 / 100
	;she - because currently mobs are all girls, and it will stay that way
	IF MOBGIRL_PLACE:LOCAL == 90
		PRINTFORMW She will not meet you outside the establishment...
	ELSE
		PRINTFORML {MOBGIRL_PLACE:LOCAL}
		PRINTFORMW She's not here.
	ENDIF
	RETURN -1
ELSEIF ARG && MOBGIRL_PLACE:LOCAL != 90 ;note -MOBGIRL_PLACE is only a savedata and not global, meaning it only works on saves where you had this girl. Either intended or an oversight? todo?
	PRINTFORMW 「SAY WHAT?! We ain't got no chicks like 'dat 'round 'ere, gya!」
	PRINTFORML 
	RETURN -1
ENDIF
[SKIPEND]
IF FIND_CHARADATA(TOSTR(LOCAL))
	CALL モブ子画像リセット(nSlot)
	;DELCHARA RANDOM_CHARANUM
	; LOADCHARA TOSTR(LOCAL)
	CALL LOAD_CUSTOM_DATA(LOCAL)
	nSlot = CHARANUM-1
    ;bugfix custom code, when loading mobs from older saves, ensure that if new characters have been added in the interim we update the NO for the mob
    ;subsequently save the mob and reload it to ensure all the correct sprites are loaded
    IF NO:nSlot != CSV_CHARANUM() && TALENT:nSlot:300
        NO:nSlot = CSV_CHARANUM()
        CALL SAVE_CUSTOM_DATA(LOCAL, nSlot)
        CALL モブ子画像リセット(nSlot)
        DELCHARA nSlot
        ; LOADCHARA TOSTR(LOCAL)
		CALL LOAD_CUSTOM_DATA(LOCAL)
    ENDIF
	;NAS custom code: sleepy custom characters
	PRINTFORML {NO:nSlot}
	SIF !INRANGE(NO:nSlot,0,CHARANUM-1)
		NO:nSlot = RANDOM_CHARANUM
	; CFLAG:nSlot:来訪時間 = CSVCFLAG(NO:nSlot,352)
	; CFLAG:nSlot:帰宅時間 = CSVCFLAG(NO:nSlot,353)
	; CFLAG:nSlot:就寝時間 = CSVCFLAG(NO:nSlot,354)
	; CFLAG:nSlot:起床時間 = CSVCFLAG(NO:nSlot,355)
	IF !VISIT(nSlot) && !masterCreator
		PRINTFORML %CALLNAME:nSlot% doesn't seem to be awake...
		PRINTFORMW Visiting Hours: %時刻表示(CFLAG:nSlot:来訪時間)% to %時刻表示(CFLAG:nSlot:帰宅時間)%
		CALLF ClearALlHediffs(CHARANUM,1)
		DELCHARA CHARANUM-1
		ADDCHARA CSV_CHARANUM()
		GOTO RELOOP
	ELSE
	ENDIF
	PRINTFORML You find %CALLNAME:nSlot%.
	IF MOBGIRL_FP:LOCAL != ""
		モブ子一人称 = %MOBGIRL_FP:LOCAL%
		モブ子二人称 = %MOBGIRL_SP:LOCAL%
	ENDIF
	
	SIF Mob_Personality:nSlot:0 == 0 || Mob_MasterName:nSlot:0 == "" ;custom code, init translated pronoun types if not found ;custom code, init translated pronoun types if not found
		CALL MOB_PRONOUN_INIT(MOBGIRL_FP:LOCAL, MOBGIRL_SP:LOCAL, nSlot)
	IF CSTR:nSlot:モブ子画像文字列_服_通常 == "" && !masterCreator
		PRINTFORML Appearance not set. Select from the list below.
		;NAS
		CALL MOB_IMAGE_SELECTION(ARG)
		[SKIPSTART]
		PRINTBUTTON "[Village Girl] ", "町娘"
		PRINTBUTTON "[Married Woman] ", "人妻"
		PRINTBUTTON "[Fairy] ", "妖精"
		PRINTBUTTON "[Fairy Maid] ", "メイド妖精"
		PRINTBUTTON "[Zombie Fairy] ", "ゾンビフェアリー"
		PRINTBUTTON "[Kappa] ", "河童"
		PRINTBUTTON "[White Wolf Tengu] ", "白狼天狗"
		PRINTBUTTON "[Rabbit] ", "イナバ"
		PRINTBUTTON "[Moon Rabbit] ", "玉兎"
		PRINTBUTTON "[Oni] ", "鬼"
		PRINTBUTTON "[Tanuki] ", "化け狸"
		PRINTBUTTON "[Kitsune] ", "化け狐"
		PRINTBUTTON "[Bakeneko] ", "化け猫"
		PRINTBUTTON "[Random] ", "ランダム"
		INPUTS
		CALL SET_MOB_IMAGE_STR(nSlot, RESULTS)
		[SKIPEND]
	ENDIF
    ; IF NO:RANDOM_CHARANUM != RANDOM_CHARANUM
    ;     NO:RANDOM_CHARANUM = RANDOM_CHARANUM

    ; ENDIF
	;過去に合成されて裸画像の笑顔に[装飾_照れ]が乗ってない場合に追記
	SIF STRFIND(CSTR:nSlot:モブ子画像文字列_裸_笑顔, "装飾_照れ") == -1
		CSTR:nSlot:モブ子画像文字列_裸_笑顔 += "[装飾9:装飾_照れ][乗色:朱色]"

	;過去（ver4.760以前）に保存されて種族のTALENT設定が適合しない場合に修正を行う
	SELECTCASE CAN_NANPA(CFLAG:MASTER:現在位置)
		;里
		CASE 1
			;以前の194 人間が現varでは194 幽霊になっている
			IF TALENT:nSlot:幽霊
				TALENT:nSlot:幽霊 = 0
				TALENT:nSlot:人間 = 1
			ENDIF
		;霧の湖、紅魔館、および地底の妖精たち
		CASE 2, 3, 5
			;以前の190 妖精が現verでは190 人間になっている
			IF TALENT:nSlot:人間
				TALENT:nSlot:人間 = 0
				TALENT:nSlot:妖精 = 1
			ENDIF
		;竹林
		CASE 4
			;イナバ…妖獣が新設された
			SIF TALENT:nSlot:妖怪 != 6
				TALENT:nSlot:妖怪 = 6
		;冥界
		CASE 6
			;化け狸、狐、猫…妖獣が新設された
			SIF TALENT:nSlot:妖怪 != 6
				TALENT:nSlot:妖怪 = 6
		;妖怪の山山麓
		CASE 7
			;河童…河童が新設された
			SIF TALENT:nSlot:妖怪 != 4
				TALENT:nSlot:妖怪 = 4
		;妖怪の山山頂
		CASE 8
			;白狼天狗…以前の197 天狗が現verでは197 追加種族（巫女）になっている
			IF TALENT:nSlot:追加種族
				TALENT:nSlot:追加種族 = 0
				TALENT:nSlot:妖怪 = 5
			ENDIF
		;地底　鬼か妖精
		CASE 9
			;鬼…以前の195 鬼が現verでは195　付喪神になっている
			IF TALENT:nSlot:付喪神
				TALENT:nSlot:付喪神 = 0
				TALENT:nSlot:妖怪 = 2
			;妖精は同上
			ELSEIF TALENT:nSlot:人間
				TALENT:nSlot:人間 = 0
				TALENT:nSlot:妖精 = 1
			ENDIF
		;月　一応分けておく
		CASE 10
			;玉兎…妖獣が新設された
			SIF TALENT:nSlot:妖怪 != 6
				TALENT:nSlot:妖怪 = 6
	ENDSELECT

	IF FLAG:70 || masterCreator	;時間停止中と風俗嬢は反応なし
	ELSEIF TALENT:nSlot:風俗嬢
	ELSEIF CFLAG:nSlot:負け犬 && (TALENT:nSlot:セフレ || TALENT:nSlot:思慕)
		PRINTFORMW %CALLNAME:nSlot% looks frustrated upon seeing you, but %HE_SHE(nSlot)% does squirm somewhat expectantly...
	ELSEIF CFLAG:nSlot:負け犬 && !TALENT:nSlot:恋慕 && !TALENT:nSlot:思慕 && !TALENT:nSlot:愛欲
		PRINTFORMW Upon seeing you again, %CALLNAME:nSlot%'s face stiffens.
	ELSEIF TALENT:nSlot:恋慕
		PRINTFORMW %CALLNAME:nSlot% happily runs over to you as soon as she sees you.
	ELSEIF TALENT:nSlot:愛欲
		PRINTFORMW %CALLNAME:nSlot% runs over to you as soon as she sees you, leaning against your arm...
	ELSEIF ABL:nSlot:親密 >= 5
		PRINTFORMW Upon seeing you again, %CALLNAME:nSlot% waves her hand.
	ENDIF
	CALL Qol_Info_Reset(nSlot) ;qol custom code
ELSE
	RETURN -1
ENDIF

@SAVE_MOBGIRL(nChara)
#DIM CHOSEN_MOB
#DIM nChara
#DIMS MOBNAME
#DIM FIRST_LINE
#DIM PAGE

;NAS custom code
;custom character menu
$LOOP
DO
FIRST_LINE = LINECOUNT
DRAWLINE
PRINTFORML Custom character management
DRAWLINE
CALL LISTUP_CUSTOM_CHARACTER(0, PAGE, 20)
DRAWLINE
PRINTBUTTON "[Return]", 10000
INPUT
CHOSEN_MOB = RESULT
SELECTCASE CHOSEN_MOB
CASE 10000
	RETURN -1
CASE MAX_CUSTOM_CHARA
	PAGE = ROUND_DECREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
CASE MAX_CUSTOM_CHARA + 1
	PAGE = ROUND_INCREMENT(PAGE, 0, (MAX_CUSTOM_CHARA / 20) - 1)
CASE 0 TO MAX_CUSTOM_CHARA
	BREAK
ENDSELECT
CLEARLINE FIRST_LINE - LINECOUNT
LOOP 1

;Custom code
LOCAL:150 = 0
IF FIND_CHARADATA(TOSTR(CHOSEN_MOB))
	LOCAL:150 = 1
	CHKCHARADATA RESULTS:0
	STRFIND RESULTS:0, "：" 
	SUBSTRING RESULTS:0, 0, RESULT
	MOBNAME = %RESULTS:0%
	PRINTFORML Forget %MOBNAME% and memorize %CALLNAME:nChara% instead?
	CALL ASK_YN
	IF !RESULT
		PRINTFORM You heartlessly forget all about %MOBNAME% on the spot, 
	ELSE
		GOTO LOOP
	ENDIF
ENDIF
IF TALENT:nChara:行きずり
MOBGIRL_PLACE:CHOSEN_MOB = CFLAG:nChara:よく行く地域
SIF TALENT:nChara:風俗嬢
	MOBGIRL_PLACE:CHOSEN_MOB = 90
TALENT:nChara:行きずり = 2
CFLAG:nChara:モブ子セーブスロット = CHOSEN_MOB
MOBGIRL_FP:CHOSEN_MOB = %モブ子一人称%
MOBGIRL_SP:CHOSEN_MOB = %モブ子二人称%
SIF Mob_Personality:RANDOM_CHARANUM:0 == 0 || Mob_MasterName:RANDOM_CHARANUM:0 == "" ;custom code, init translated pronoun types if not found ;custom code, init translated pronoun types if not found
	CALL MOB_PRONOUN_INIT(MOBGIRL_FP:CHOSEN_MOB, MOBGIRL_SP:CHOSEN_MOB, RANDOM_CHARANUM) ;custom code
ENDIF
CALL SAVE_CUSTOM_DATA(CHOSEN_MOB, nChara)
IF LOCAL:150
	PRINTFORMW and memorize %CALLNAME:RANDOM_CHARANUM% instead%COND_STR(@", marking her as a favorite", TALENT:RANDOM_CHARANUM:風俗嬢)%.
ELSE
	PRINTFORMW You memorize %CALLNAME:RANDOM_CHARANUM%%COND_STR(@", marking her as a favorite", TALENT:RANDOM_CHARANUM:風俗嬢)%.
ENDIF


