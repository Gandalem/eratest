	CASE "春"
		MOUTH = 0
	CASE "夏"
		MOUTH = 31
	CASE "秋"
		MOUTH = 62
	CASE "冬"
		MOUTH = 93
ENDSELECT
TOTAL = (YEAR - 1) * 124 + MOUTH + DAYS
RETURNF TOTAL
