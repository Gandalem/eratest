@COM450
#DIM 醸造量
#DIM 酒ID
#DIM START_LINECOUNT
VARSET LOCAL

酒ID = ALC_ID()
醸造量 = GET_INT(0, "酒データ", 酒ID, "醸造数")
LOCALS '= @"Replace it with %VAR_WATER_TR(VAR_WATER)%"
LOCAL = 1
IF VAR_WATER == ""
	IF GETBIT(FLAG:プール, 2) ;addition custom code
		LOCALS '= "Replace it with Pool Water"
	ELSE
		LOCALS '= "Can't just take it out without the replacement"
		LOCAL = 0
	ENDIF
ENDIF

;qol custom code
CALL QOL_BREWING_GUIDE

PRINTFORML You take a look into the jar with the Sake Bug.
IF VAR_FERMENT == "" ;qol custom code failsafe
	PRINTFORML Huh, it's empty... Maybe you should update the game.
ELSE
	;qol custom code
	CALL PRINT_STRL, @"It's filled with @HEX@{C_YELLOW}@%VAR_FERMENT_TR(VAR_FERMENT)%@..."
ENDIF
SIF ABL:MASTER:教養 >= 3 && DAY:10 > 0 && VAR_FERMENT != "" ;qol custom code
	PRINTFORML You can tell it went through %PRINT_PLUR("day", DAY:10)% worth of brewing.
DRAWLINE
;qol custom code: applied tips, item check, backtrack option
LOCAL:10 = GET_STR(0, "酒データ", ALC_ID(VAR_FERMENT), "ADDITIONS") != ""
START_LINECOUNT = LINECOUNT
$CHOOSEOPTION
CLEARLINE LINECOUNT - START_LINECOUNT
{
CALL ASK_M("Do nothing",1,@"%LOCALS%\@ VAR_WATER == "" && !GETBIT(FLAG:プール, 2) ? %" "%(Fetch water first)#\@", LOCAL,"Add items into the mix",LOCAL:10,
"Time Manipulated Brewing (Req:TSP2400)",BASE:MASTER:8 >= 2400 && GET_STR(0, "酒データ", ALC_ID(VAR_FERMENT), "変化先") != "0","『King Crimson』! (Req:TSP4000&King Crimson)", BASE:MASTER:8 >= 4000 && ITEM:キング・クリムゾン && GET_STR(0, "酒データ", ALC_ID(VAR_FERMENT), "変化先") != "0",
"Dump Contents", !GROUPMATCH(VAR_FERMENT, "", "ただの水")) ;com custom code, failsafe
}
SELECTCASE RESULT
	CASE 0
		RETURN -1
	CASE 1
		;IF ITEM:酒ID >= 99
		;	PRINTFORMW Can't carry any more %VAR_FERMENT_TR(VAR_FERMENT)%.
		;	RETURN -1
		;ENDIF
		;qol
		PRINTFORML Confirm?
		CALL ASK_YN
		SIF RESULT
			;RETURN -1
			GOTO CHOOSEOPTION ;qol custom code
		SIF VAR_WATER == "" && GETBIT(FLAG:プール, 2) ;addition custom code
			VAR_WATER = ただの水
		PRINTFORML You extract the %VAR_FERMENT_TR(VAR_FERMENT)% from the jar and replace it with %VAR_WATER_TR(VAR_WATER)%.
		IF 醸造量 > 0
			;qol custom code, bonus from brewer
			SIF TALENT:MASTER:酒造家
				醸造量++

			CALL GET_ITEM(@"%VAR_FERMENT%", 醸造量, 2)
		ENDIF
		;(酒造パッチ)酒粕入手
		SIF VAR_FERMENT == "吟醸酒" || VAR_FERMENT == "熟成酒" || VAR_FERMENT == "古酒" || VAR_FERMENT == "貴醸酒" || VAR_FERMENT == "貴醸熟成酒" || VAR_FERMENT == "貴醸古酒"
			CALL GET_ITEM("酒粕", 1, 1)
		VAR_FERMENT = %VAR_WATER%
		VAR_WATER =
		DAY:10 = 0
		;入れ替え時にエサをやれる
		IF ITEM:魚粕 || ITEM:肉骨粉
			PRINTFORML Feed the Sake Bug? (Speeds up the process)
			{
			CALL ASK_M("Give it some Fish Meal", ITEM:魚粕,
			"Give it some Meat-and-bone Meal", ITEM:肉骨粉,
			"Don't feed it",1)
			}
			SELECTCASE RESULT
				CASE 0
					CALL LOST_ITEM("魚粕", 1, 1)
					PRINTFORML The Sake Bug seems to have become a bit more active, chewing on the fish meal...
					DAY:10 += 1
				CASE 1
					CALL LOST_ITEM("肉骨粉", 1, 1)
					PRINTFORML The Sake Bug seems to have become more active, chewing on the meat-and-bone meal...
					DAY:10 += 2
				CASE 2
					PRINTFORML Cancel feeding.
			ENDSELECT
		ENDIF
		CALL QOL_BREWING_GUIDE_MAKE_KNOWN(VAR_FERMENT) ;qol custom code
	CASE 2
		;qol tip
		PRINTFORML For the mix to be able to ferment, it must be filled with any unmixed water, and not be too ripe (3 days tops).
		DRAWLINE
		PRINTFORML Held Materials:
		CALL LIST_ITEM("Ferment")
		DRAWLINE
		CALL COM450_1
		SIF RESULT == -1 ;custom code if canceled
			GOTO CHOOSEOPTION
	CASE 3
		IF GET_STR(0, "酒データ", 酒ID, "変化先") == "0"
			PRINTFORMW There's no point in doing this for %VAR_FERMENT_TR(VAR_FERMENT)%.
			;RETURN -1
			GOTO CHOOSEOPTION ;qol custom code
		ENDIF
		PRINTFORML You apply your time-stopping ability to forcefully hasten time inside the jar.
		BASE:MASTER:8 -= 2400
		CALL 酒造
	CASE 4
		IF GET_STR(0, "酒データ", 酒ID, "変化先") == "0"
			PRINTFORMW There's no point in doing this for %VAR_FERMENT_TR(VAR_FERMENT)%.
			;RETURN -1
			GOTO CHOOSEOPTION ;qol custom code
		ENDIF
		PRINTFORML You erase time to simply get *results*.
		BASE:MASTER:8 -= 4000
		ITEM:キング・クリムゾン --
		DAY:10 += 9
		CALL 酒造
	CASE 5 ;com custom code, failsafe
		PRINTFORML This is an emergency option in case something went wrong.
		CALL COLORMESSAGE(@"All Jar contents will be lost!",C_RED, 1)
		PRINTFORML Confirm?
		CALL ASK_YN
		SIF RESULT
			;RETURN -1
			GOTO CHOOSEOPTION ;qol custom code
		PRINTFORML After thoroughly dumping everything out of the jar, it's once again filled with Plain Water.
		VAR_FERMENT = ただの水
		DAY:10 = 0
ENDSELECT
TIME += 5
RETURN 1



