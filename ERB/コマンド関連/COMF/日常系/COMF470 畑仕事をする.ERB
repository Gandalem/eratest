;COM系関数、MESSAGEは本来は切り分けて別ファイル
;養蚕だろうが畑仕事になるけどまあいいや

@MESSAGE_COM470
#LOCALSIZE 1
#LOCALSSIZE 1
;qol custom code, moved intro line down
SELECTCASE TFLAG:193
	CASE 1
		PRINTFORML 오늘의 작업은 소득이 없었다.
	CASE 2
		PRINTFORML 오늘의 작업은 별로 진전이 없었다.
	CASE 3
		PRINTFORML 오늘의 작업은 사고 없이 끝났다.
	CASE 4
		PRINTFORML 오늘의 작업으로 전장이 상당히 개선되었다.
	CASE 5
		PRINTFORML 오늘의 작업은 성공적으로 끝났다.
	CASEELSE
		PRINTFORML 오늘의 작업에는 신이 지켜보고 있었을 것이다.
ENDSELECT
;システム的に1キャラ優遇するのはどうかと思うけど
;アイデンティティだものいいよね

@COM470
;qol custom code, moved line to fit flavor text
PRINTFORML 당신은 %FARM_FIELD_TR(STR_NOUMIN(FLAG:地主, "畑の種類"))%로 향한다.
IF ITEM:園芸用品一式
	TFLAG:畑仕事成功度 = RAND(2, 7)
ELSE
	TFLAG:畑仕事成功度 = RAND(1, 4)
ENDIF
;神の加護
;Custom code, translated
;qol custom code, added flavor text
SELECTCASE CFLAG:[[穣子]]:好感度
	CASE IS < 1000
	CASE IS < 5000
		TFLAG:畑仕事成功度 += 1
		PRINTFORML 신비로운 기운을 느끼고 있다...
		PRINTFORML 그저 상상일지도 모르지만, 작물들이 더 건강해 보인다.
	CASE IS < 10000
		TFLAG:畑仕事成功度 += 2
		PRINTFORML 영적인 존재의 기척을 느낀다...
		PRINTFORML 작물들이 확실히 평소보다 더 잘 자라고 있다.
	CASE IS < 30000
		TFLAG:畑仕事成功度 += 3
		PRINTFORML 수확의 여신이 당신에게 푸른 손(녹색 엄지손가락)을 축복했을 것이다.
		PRINTFORML 당신의 작물은 생각했던 것보다 더 빨리 자라고 있다.
	CASEELSE
		TFLAG:畑仕事成功度 += 4
		PRINTFORML 미노리코의 끝없는 연모가 들판을 감싼다!
		PRINTFORML 당신의 작물은 아름답고 믿을 수 없을 정도로 빠르게 자란다!
ENDSELECT
TFLAG:畑仕事成功度 += Add_Apply_Fairy_Title_Bonus("farming") ;custom code
FLAG:畑仕事の成果 += TFLAG:畑仕事成功度
TFLAG:193 = TFLAG:畑仕事成功度
IF FLAG:70
	BASE:MASTER:TSP -= 500
ELSE
	TIME += 180
	DOWNBASE:MASTER:体力 += 300
	DOWNBASE:MASTER:気力 += 300
ENDIF
RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;畑仕事をする

@COM_ABLE470
SIF !TFLAG:100
	RETURN 0
SIF TFLAG:妄想中
	RETURN 0
;あなたは農民ではない
SIF !FLAG:地主
	RETURN 0
;現在位置が畑の場所ではない、LOCALに畑の位置を一次取得して使用
LOCAL = INT_NOUMIN(FLAG:地主, "場所ID")
SIF GET_MAPID(LOCAL) != MAIN_MAP
	LOCAL = GET_MAP_REPLACEMENT(LOCAL)
SIF CFLAG:MASTER:現在位置 != LOCAL
	RETURN 0
;呑んでる
SIF BASE:MASTER:酒気
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
;体力・気力不足
SIF BASE:MASTER:気力 < 300 || BASE:MASTER:体力 < 300
	RETURN 0
;天気が悪い
SIF !GROUPMATCH(TIME:5, 0, 1, 2, 3, 4, 6, 7)
	RETURN 0
;今日はもう仕事をした
SIF TFLAG:畑仕事成功度
	RETURN 0
;時間に余裕が無いとダメ
IF FLAG:70
	;TSP足りない
	SIF BASE:MASTER:TSP < 300
		RETURN 0
ELSE
	;活動限界を720としてその3時間前
	SIF NEMUKE() >= 540
		RETURN 0
ENDIF
RETURN 1
