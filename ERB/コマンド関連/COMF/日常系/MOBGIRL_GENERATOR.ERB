;----------------------------------------------------------------------------------------
;候補と確率を入れるとランダムで数字を返すよ
;たとえばBIASED_RANDOM(1, 100, 2, 50, 3, 200, 10, 10)だと
;100/1000で1, 50/1000で2, 200/1000で3, 10/1000で10が返ってくるよ
;NAS: made it a #FUNCTION with help of SHUFFLE_F
;increased it to 15 possible instead of 6
;----------------------------------------------------------------------------------------
@BIASED_RANDOM(候補:1,確率:1,候補:2,確率:2,候補:3,確率:3,候補:4,確率:4,候補:5,確率:5,候補:6,確率:6,候補:7,確率:7,候補:8,確率:8,候補:9,確率:9,候補:10,確率:10,候補:11,確率:11,候補:12,確率:12,候補:13,確率:13,候補:14,確率:14)
#FUNCTION
#DIM 候補,15
#DIM 確率,15
CALLF FISHER_YATES_SHUFFLE_F(15)
FOR LOCAL:1, 0 , 15
	LOCAL = SHAFFLE_ARRAY:(LOCAL:1)
	SIF !候補:LOCAL
		CONTINUE
	SIF 確率:LOCAL > RAND:1000
		RETURNF 候補:LOCAL
NEXT
RETURNF 0


