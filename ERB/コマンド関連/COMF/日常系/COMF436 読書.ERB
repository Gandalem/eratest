@COM436
#DIM READING_EXP
READING_EXP = 1
PRINTL 어떤 종류의 책을 읽어야 할까요?
CALL ASK_M("문학", 1, "방법 안내", 1, "에로북", 1, "주술서", 1, "스스로 유술 책", 1, "취소", 1)
IF RESULT == 0
	SELECTCASE RAND:10
		;忍殺
		CASE 0
			TFLAG:193 = 1
			;失敗
		CASE 1 TO 3
			TFLAG:193 = 2
			;文学
		CASEELSE
			TFLAG:193 = 3
	ENDSELECT
ELSEIF RESULT == 1
	SELECTCASE RAND:10
		;失敗
		CASE 0 TO 2
			TFLAG:193 = 4
			;実用
		CASEELSE
			TFLAG:193 = 5
	ENDSELECT
ELSEIF RESULT == 2
	SELECTCASE RAND:9
		;ｳｽｲﾀｶｲﾎﾝ
		CASE 0 TO 2
			TFLAG:193 = 6
			;保健体育
		CASE 3 TO 5
			TFLAG:193 = 7
			;カーマスートラ
		CASE 6 TO 8
			TFLAG:193 = 8
			;やばい本
			;		CASEELSE
			;		IF TALENT:MASTER:SexKnow < 5
			;			TFLAG:193 = 9
			;		ELSE
			;			GOTO LOOP
			;		ENDIF
	ENDSELECT
	;NAS YOUJUTSU LEANING
ELSEIF RESULT == 3 || RESULT == 4
	CALL YoujutsuSelfStudyMenu(RESULT == 3 ? TARGET # MASTER)
	TFLAG:193 = 200
ELSEIF RESULT == 5
	RETURN -1
ENDIF
IF TARGET == 54 && CFLAG:325 == 5
	IF TALENT:恋慕
		PRINTFORML 패치울과 함께 독서하는 것을 즐기기로 했다.
	ELSE
		PRINTFORML 패치울이 끝날 때까지 시간을 죽이며 읽기로 했다.
	ENDIF
ENDIF
PRINTFORM 당신은 읽었다 
SELECTCASE TFLAG:193
	CASE 1
		PRINT 「닌자 슬레이어」는
	CASE 2 TO 3
		PRINT 어떤 문학
	CASE 4 TO 5
		;『Welcome to AI: MakAI user's guide』
		;『Sen, MakAI, OmniART (autoregressive transformer), what is the best model』
		;『Mastering NodeML: An image and video generation tool』
		;『Checkov's Latent Starter's Guide』
		;『Deep Learning from Zero』
		;『iNgenunity AIX GPU ARCHITECTURE』
		; a blank how-to book
		; PRINT , which
		PRINT 사용 설명서
	CASE 6
		PRINT 선정적인 동인지
	CASE 7
		PRINT 건강 및 체육 교양서
	CASE 8
		PRINT 「카마수트라」는
	CASE 200
		PRINTFORM 「%NAS_ESP_BOOK_NAME%」은(는),
		;	CASE 9
		;		PRINT タイトルのない皮装丁の湿り気を帯びた本
ENDSELECT
PRINTFORML  당신은 책장에 앉아 있는 것을 발견했다.
;3分の1で追加イベント
SIF !RAND:3 && TARGET == 54
	TFLAG:194 = 1
;TARGETが無知かつＨな本読みかつMASTERがTARGETより教養が高くTARGETの教養が2以上かつ五分の一
SIF !RAND:5 && TALENT:TARGET:SexKnow == -1 && TFLAG:193 >= 6 && TFLAG:193 <= 8 && ABL:MASTER:教養 > ABL:教養 && ABL:教養 >= 2
	TFLAG:194 = 2
SELECTCASE TFLAG:193
	CASE 1
		EXP:MASTER:戦闘経験 += 5
	CASE 3
		;文学
		EXP:MASTER:学習経験 += READING_EXP
	CASE 5
		;実用
		SELECTCASE RAND:7
			CASE 0
				EXP:MASTER:会話経験 += READING_EXP
			CASE 1
				EXP:MASTER:撮影経験 += READING_EXP
			CASE 2
				EXP:MASTER:料理経験 += READING_EXP
			CASE 3
				EXP:MASTER:釣り経験 += READING_EXP
			CASE 4
				EXP:MASTER:採集経験 += READING_EXP
			CASE 5
				EXP:MASTER:調合経験 += READING_EXP
			CASEELSE
				EXP:MASTER:伐採経験 += READING_EXP
		ENDSELECT
	CASE 6
		CALL RECOVER(MASTER,100,"精力")
		CALL RECOVER(MASTER,100,"勃起")
ENDSELECT
IF TARGET != MASTER && CFLAG:行動 != 5
	;固定で獲得するソース
	SOURCE:歓楽 = 200
	;信頼
	TFLAG:98 = 3
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:歓楽 += (ABL:従順 * 80)
	ELSEIF ABL:従順 <= 3
		SOURCE:歓楽 += 300 + (ABL:従順 * 80)
	ELSEIF ABL:従順 <= 5
		SOURCE:歓楽 += 700 + (ABL:従順 * 80)
	ELSEIF ABL:従順 <= 8
		SOURCE:歓楽 += 950 + (ABL:従順 * 100)
	ELSEIF ABL:従順 <= 11
		SOURCE:歓楽 += 1200 + (ABL:従順 * 90)
	ELSE
		SOURCE:歓楽 += 2000 + (ABL:従順 * 50)
	ENDIF
	;好感度をみる
	IF CFLAG:2 <= 500
		SOURCE:歓楽 += CFLAG:2 * 2
	ELSEIF CFLAG:2 <= 5000
		SOURCE:歓楽 += 1000 + (CFLAG:2 - 500) / 2
	ELSE
		SOURCE:歓楽 += 5000 + (CFLAG:2 - 5000) / 3
	ENDIF
	SIF SOURCE:歓楽 < 0
		SOURCE:歓楽 = 0
ENDIF
DOWNBASE:MASTER:体力 = 50
DOWNBASE:MASTER:気力 = 200
;賢者タイムは読書がはかどる
IF IS_WISEMAN()
	PRINTFORML 세상의 욕정들이 더 이상 네 마음에 없으므로, 너는 더욱 효율적으로 공부하는 데 전념한다.
	TIME += 45
ELSE
	TIME += 60
ENDIF
RETURN 1
