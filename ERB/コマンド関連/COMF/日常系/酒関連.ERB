@EVENTTRAIN
#PRI
CALL MAKE_BOOZE_MAP

@EVENTLOAD ;The drink data won't survive loading the game, so release the MAP to let it regenerate.
SIF MAP_EXIST(BOOZE_MAP)
	MAP_RELEASE BOOZE_MAP

@MAKE_BOOZE_MAP
IF !MAP_EXIST(BOOZE_MAP)
	MAP_CREATE BOOZE_MAP
	DEBUGPRINTFORML ------------------------------
	FOR LOCAL, 1, OBJ_ID_LAST
		LOCALS '= GET_STR(0, "酒データ", LOCAL, "名称")
		IF LOCALS != ""
			MAP_SET BOOZE_MAP, LOCALS, TOSTR(LOCAL)
			DEBUGPRINTFORML {LOCAL, 3, LEFT}: %LOCALS%

			SIF GET_INT(0, "酒データ", LOCAL, "酒気増加量") > 0 ;qol custom code
				VALID_DRINKS_LIST:(VALID_DRINK_COUNT++) = GETNUM(ITEM, ALC_NAME(LOCAL))
		ENDIF
	NEXT
	DEBUGPRINTFORML ------------------------------
	DEBUGPRINTFORML Booze map made
	;-----------------------------------------------------------
ENDIF


;廃止
;@醸造日数(ARG)
;@醸造できた量(ARG)


@酒造
#DIMS ALTER
SIF !KNOW_RESEARCH("Alcohol") ;research custom code
	RETURN

DAY:10 ++
LOCAL = GET_INT(0, "酒データ", ALC_ID(), "醸造日数")
;qol custom code, speed up from brewer
SIF TALENT:MASTER:酒造家 >= 2 && LOCAL > 2
	LOCAL--
IF LOCAL > 0 && LOCAL <= DAY:10
	ALTER = %GET_STR(0, "酒データ", ALC_ID(), "変化先")%
	CALL COLORMESSAGE(@"The %VAR_FERMENT_TR(VAR_FERMENT)% in the jar with the Sake Bug turns into %VAR_FERMENT_TR(ALTER)%.",C_YELLOW, 2)
	DAY:10 = 0
	VAR_FERMENT = %ALTER%
	CALL QOL_BREWING_GUIDE_MAKE_KNOWN(VAR_FERMENT) ;qol custom code
ENDIF

@DRUNKEN(C_ID, itemnum)
#DIM C_ID
#DIM 酒ID
#DIM itemnum
#DIM 酒気増加量

LOCALS = %ITEMNAME:itemnum%

酒ID = ALC_ID(LOCALS)

酒気増加量 = GET_INT(C_ID, "酒データ", 酒ID, "酒気増加量")
;一夜のクシナダを除く
IF LOCALS != "一夜のクシナダ"
	SELECTCASE AlcoholAddict:C_ID:0
	CASE 6
		TIMES 酒気増加量, 0
	CASE 5
		TIMES 酒気増加量, 0.2
	CASE 4
		TIMES 酒気増加量, 0.35
	CASE 3
		TIMES 酒気増加量, 0.5
	CASE 2
		TIMES 酒気増加量, 0.75
	CASE 1
		TIMES 酒気増加量, 0.9
	CASE -1
		TIMES 酒気増加量, 1.2
	CASE -2
		TIMES 酒気増加量, 1.5
	CASE -3
		TIMES 酒気増加量, 1.75
	CASE -4
		TIMES 酒気増加量, 2.0
	CASE -5
		TIMES 酒気増加量, 3.0
	ENDSELECT
ENDIF
DrinkingExp:C_ID:0 += 酒気増加量/10
SIF C_ID == MASTER
	酒気増加量 = 酒気増加量 / (1 + TFLAG:酔い止め)
BASE:C_ID:酒気 = MIN(BASE:C_ID:酒気 + 酒気増加量 ,MAXBASE:C_ID:酒気)

@酒一覧表示(ARG, ARGS, 割合)
;所持数がARG未満だと非表示、ARG以上所有してる酒を選択するとそのアイテム番号をRETURNする
#DIM ITEM_ID
#DIM ITEM_INDEX ;qol custom code
#DIM 割合
;qol replaced with paginated version (not for shops)
IF ARGS != "売却"
	CALL QOL_ALCOHOLMENU(ARG, 割合)
	RETURN RESULT
ENDIF
$LOOP

FOR ITEM_INDEX, 0, VALID_DRINK_COUNT ;qol custom code
	ITEM_ID = VALID_DRINKS_LIST:ITEM_INDEX
	IF IS_ALC(ITEM_ID) && ITEM:ITEM_ID >= ARG
		IF ARGS == "売却"
			;custom code
			PRINTFORML [{ITEM_ID,3}]%ITEMNAME_TR(ITEM_ID), 24, LEFT% (%金額表示(ITEMPRICE:ITEM_ID * 割合 / 100), 8%)  	(Quantity:{ITEM:ITEM_ID,3})
		ELSE
			CALL PRINT_ITEM_EXPLANATION2(ITEM_ID);qol custom code
		ENDIF
	ENDIF
NEXT
DRAWLINE 
PRINTL [999] Cancel
INPUT
IF IS_ALC(RESULT) && ITEM:RESULT >= ARG
	RETURN RESULT
ELSEIF RESULT == 999
	RETURN 0
ELSE
	GOTO LOOP
ENDIF

@CAN_DRINK(ARG)
#FUNCTION
SIF AlcoholAddict:ARG:0 == -5
	RETURNF 0
SIF BASE:ARG:酒気 >= MAXBASE:ARG:酒気 * 2 / 3
	RETURNF 0
RETURNF 1

@ALCOHOL_TASTE(ARG)
#FUNCTION
#DIM 酒ID

;qol custom code, optimized
酒ID = ALC_ID(ITEMNAME:ARG)
IF 酒ID > 0
	LOCAL = GET_INT(TARGET, "酒データ", 酒ID, "TASTE")
	LOCAL += TFLAG:口上特殊補正
	RETURNF LOCAL
ENDIF
[SKIPSTART]
LOCALS = %ITEMNAME:ARG%
FOR 酒ID, 1, 120
	IF GET_STR(0, "酒データ", 酒ID, "名称") == LOCALS
		LOCAL = GET_INT(TARGET, "酒データ", 酒ID, "TASTE")
		LOCAL += TFLAG:口上特殊補正
		RETURNF LOCAL
	ENDIF
NEXT
[SKIPEND]
RETURNF 0

[SKIPSTART]
;テンプレ
;EXIST関数忘れると動きません
@EXIST_酒データX
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@酒データX(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
;名前、水でも酒でもこれがないと始まらない
CASE "名称"
	CALLF MAKE_STR(V_NAME, "どぶろく")
;瓶で放置してたら何に変化するか
;変化しないなら未記載
CASE "変化先"
	CALLF MAKE_STR(V_NAME, "清酒")
;変化に必要な日数、しないなら未記載
CASE "醸造日数"
	CALLF MAKE_INT(V_NAME, 5)
;汲みだすときに手に入る数
;水とか調合で入手するやつは未記載
CASE "醸造数"
	LOCAL = 10 + RAND:(ABL:MASTER:教養 * 2 + 1)
	CALLF MAKE_INT(V_NAME, LOCAL)
;酒飲んだ時の酒気増加量
;後で行われるので耐性による補正は無視してよい
;ここが未記入でないなら、当該名称のアイテムは酒扱いされる
CASE "酒気増加量"
	LOCAL = 300 + RAND:100
	CALLF MAKE_INT(V_NAME, LOCAL)
;反応、10が基本値
CASE "TASTE"
		IF TALENT:ARG:酒耐性 > 0
			LOCAL = 7
		ELSE
			LOCAL = 10
		ENDIF
	CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT
[SKIPEND]