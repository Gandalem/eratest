@EXIST_酒データ49
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@酒データ49(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名称"
	CALLF MAKE_STR(V_NAME, "芋焼酎")
CASE "変化先"
	CALLF MAKE_STR(V_NAME, "")
CASE "醸造日数"
	CALLF MAKE_INT(V_NAME, )
CASE "醸造数"
	LOCAL = 0
	CALLF MAKE_INT(V_NAME,)
CASE "酒気増加量"
	LOCAL = 700 + RAND:300
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "TASTE"
	IF TALENT:ARG:酒耐性 < 0
		LOCAL = 2
	ELSEIF TALENT:ARG:酒耐性 < 2
		LOCAL = 8
	ELSE
		LOCAL = 22
	ENDIF
	CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT

@EXIST_酒データ50
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@酒データ50(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名称"
	CALLF MAKE_STR(V_NAME, "一夜のクシナダ")
CASE "変化先"
	CALLF MAKE_STR(V_NAME, "")
CASE "醸造日数"
	CALLF MAKE_INT(V_NAME, )
;CASE "醸造数"
;	CALLF MAKE_INT(V_NAME, )
CASE "酒気増加量"
	LOCAL = 500 + RAND:200
	;一夜のクシナダは酒耐性が高いほど酔いが回りやすいF	
	IF ARG != MASTER	
		SELECTCASE AlcoholAddict:ARG:0
		CASE -1
			TIMES LOCAL, 1.1
		CASE 1
			TIMES LOCAL, 1.2
		CASE 2
			TIMES LOCAL, 1.5
		CASE 3
			TIMES LOCAL, 1.7
		CASE 4
			TIMES LOCAL, 2.5
		CASE 5
			TIMES LOCAL, 3.5				
		CASE -5
			IF CFLAG:ARG:下戸飲み >= 5
				TIMES LOCAL, 2.0
			ELSEIF CFLAG:ARG:下戸飲み >= 2
				TIMES LOCAL, 1.5
			ELSE
				TIMES LOCAL, 1.0
			ENDIF
		ENDSELECT
	ENDIF
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "TASTE"
	IF TALENT:ARG:酒耐性 < 0
		LOCAL = 8
	ELSE
		LOCAL = 25
	ENDIF
	CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT


