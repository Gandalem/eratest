;アイテム以外の処理
SELECTCASE RESULT
	CASE 999
		RETURN -1
	CASE 900
		FLAG:Cスキマ自動仕様 = !FLAG:Cスキマ自動仕様
		PRINTFORMW 자동 사용은 \@ FLAG:Cスキマ自動仕様 ? 켜짐 # 꺼짐 \@으로 전환되었다.
		GOTO LOOP
	CASE 901
		;[虫捕りをする]へ転送
		CALL SHOW_MUSHI_CAGE
		GOTO LOOP
	CASE 998
		IF 対象 != MASTER
			対象 = MASTER
		ELSEIF TARGET
			対象 = TARGET
		ENDIF
		GOTO LOOP
	CASE 2000 TO 2007
		表示アイテム種別 = RESULT % 2000
		GOTO LOOP
ENDSELECT
;使用可能アイテム以外の入力、またはアイテム未所持の場合は再入力
IF 使用可能アイテム(使用アイテム) == 0 || ITEM:使用アイテム <= 0
	GOTO LOOP
ENDIF
;相手使用時にMASTERのみアイテムの選択は再入力
IF 対象 != MASTER && 使用可能アイテム(使用アイテム) == 1
	GOTO LOOP
ENDIF
;IF ITEMTYPE_DRUG(使用アイテム,対象) && TCVAR:(ARG:1):お薬
;	PRINTW That's enough drugs for today.
;	GOTO LOOP
;ENDIF
IF (ITEMTYPE_FOOD(使用アイテム) || ITEMTYPE_MOD(使用アイテム) == 3) && !TIME_PROGRESS(TCVAR:対象:空腹時刻) ;addition custom code
	PRINTFORMW \@ 対象 == MASTER ? 당신은 # %CALLNAME:対象%은(는) \@ 충분히 배고프지 않다.
	GOTO LOOP
ENDIF
IF (ITEMTYPE_SWEETS(使用アイテム) || ITEMTYPE_MOD(使用アイテム) == 4) && !TIME_PROGRESS(TCVAR:対象:デザート空腹時刻) ;addition custom code
	PRINTFORMW \@ 対象 == MASTER ? 당신은 # %CALLNAME:対象%은(는) \@ 간식을 먹을 만큼 배가 고프지 않다.
	GOTO LOOP
ENDIF
TFLAG:193 = 使用アイテム
TFLAG:194 = 対象 == MASTER ? MASTER # 1
;----------------------------------
;addition custom code, for modded item usage
CALL Add_UseItem(使用アイテム, 対象)
IF RESULT > 0
	SIF RESULT == 3
		GOTO LOOP
	LOCAL:1 = 1
	SIF RESULT == 2
		虚無への回帰 = 1
	GOTO DONE
ENDIF
;----------------------------------
