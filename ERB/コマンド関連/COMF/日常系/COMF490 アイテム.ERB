			PRINTL 맛이 꽤 저렴했다.
		CALL DrugStuffNoFluff(対象,使用アイテム)
		LOCAL:1 ++
	CASE 121
		PRINTFORML 그 %PARSE("You eat",,,対象)%과 그 %ITEMNAME_TR(使用アイテム)%를.
		CALL DrugStuffNoFluff(対象,使用アイテム)
		LOCAL:1 ++
	CASE 122	;高級チョコ
		PRINTFORML %PARSE("You eat",,,対象)%은(는) %ITEMNAME_TR(使用アイテム)%이다.
		PRINTFORML 맛있다!
		CALL DrugStuffNoFluff(対象,使用アイテム)
		LOCAL:1 ++
	CASE 123	;本命チョコ
		PRINTFORML %PARSE("You eat",,,対象)% 그 %ITEMNAME_TR(使用アイテム)%를.
