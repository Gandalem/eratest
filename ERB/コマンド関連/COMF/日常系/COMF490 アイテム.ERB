	IF 使用可能アイテム(LOCAL) == 2 && ITEM:LOCAL
		CALL PRINT_ITEM_EXPLANATION(LOCAL)
	ENDIF
ELSE
	IF 使用可能アイテム(LOCAL) && ITEM:LOCAL
		CALL PRINT_ITEM_EXPLANATION(LOCAL)
	ENDIF
ENDIF
NEXT
PRINTL
DRAWLINE
CALL PRINTBUTTON_EX("[ All ]", 2000, 表示アイテム種別 != 0, 表示アイテム種別 == 0)
CALL PRINTBUTTON_EX("[Heal]", 2001, 表示アイテム種別 != 1, 表示アイテム種別 == 1)
CALL PRINTBUTTON_EX("[Buff]", 2002, 表示アイテム種別 != 2, 表示アイテム種別 == 2)
CALL PRINTBUTTON_EX("[Food]", 2003, 表示アイテム種別 != 3, 表示アイテム種別 == 3)
CALL PRINTBUTTON_EX("[Snack]", 2004, 表示アイテム種別 != 4, 表示アイテム種別 == 4)
CALL PRINTBUTTON_EX("[Fruit]", 2005, 表示アイテム種別 != 5, 表示アイテム種別 == 5)
CALL PRINTBUTTON_EX("[Misc]", 2006, 表示アイテム種別 != 6, 表示アイテム種別 == 6)
