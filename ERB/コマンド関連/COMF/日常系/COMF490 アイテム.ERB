PRINTL Pick an item to use.
$LOOP
;qol custom code
GOTO QOL
DRAWLINE
FOR LOCAL,120, 699
	SIF 表示アイテム種別 != 0 && ITEMTYPE(LOCAL) != 表示アイテム種別
		CONTINUE
	IF 対象 != MASTER
		IF 使用可能アイテム(LOCAL) == 2 && ITEM:LOCAL
			CALL PRINT_ITEM_EXPLANATION(LOCAL)
		ENDIF
	ELSE
		IF 使用可能アイテム(LOCAL) && ITEM:LOCAL
			CALL PRINT_ITEM_EXPLANATION(LOCAL)
		ENDIF
	ENDIF
NEXT
PRINTL
DRAWLINE
CALL PRINTBUTTON_EX("[ All ]", 2000, 表示アイテム種別 != 0, 表示アイテム種別 == 0)
CALL PRINTBUTTON_EX("[Heal]", 2001, 表示アイテム種別 != 1, 表示アイテム種別 == 1)
CALL PRINTBUTTON_EX("[Buff]", 2002, 表示アイテム種別 != 2, 表示アイテム種別 == 2)
CALL PRINTBUTTON_EX("[Food]", 2003, 表示アイテム種別 != 3, 表示アイテム種別 == 3)
CALL PRINTBUTTON_EX("[Snack]", 2004, 表示アイテム種別 != 4, 表示アイテム種別 == 4)
CALL PRINTBUTTON_EX("[Fruit]", 2005, 表示アイテム種別 != 5, 表示アイテム種別 == 5)
CALL PRINTBUTTON_EX("[Misc]", 2006, 表示アイテム種別 != 6, 表示アイテム種別 == 6)
RESETCOLOR
PRINTL
DRAWLINE
SIF ITEM:昆虫採集セット
	PRINTFORML [901] Check Bug Cage
PRINTFORML [900] Use Collector's Gap automatically (Currently: \@ FLAG:Cスキマ自動仕様 ? ON# OFF\@)
IF TARGET && SHIRAHU(TARGET)
	SIF 対象 != MASTER
		SETCOLOR C_YELLOW
	PRINTFORML [998] Use on %CALLNAME:TARGET%
	RESETCOLOR
ENDIF

PRINTL [999] Return
INPUT
$QOL
CALL QoL_490_ITEMMENU(対象,MASTER)
使用アイテム = RESULT
;アイテム以外の処理
SELECTCASE RESULT
	CASE 999
		RETURN -1
	CASE 900
		FLAG:Cスキマ自動仕様 = !FLAG:Cスキマ自動仕様
		PRINTFORMW Automatic usage has been switched \@ FLAG:Cスキマ自動仕様 ? ON# OFF\@.
		GOTO LOOP
	CASE 901
		;[虫捕りをする]へ転送
		CALL SHOW_MUSHI_CAGE
		GOTO LOOP
	CASE 998
		IF 対象 != MASTER
			対象 = MASTER
		ELSEIF TARGET
			対象 = TARGET
		ENDIF
		GOTO LOOP
	CASE 2000 TO 2007
		表示アイテム種別 = RESULT % 2000
		GOTO LOOP
ENDSELECT

;使用可能アイテム以外の入力、またはアイテム未所持の場合は再入力
IF 使用可能アイテム(使用アイテム) == 0 || ITEM:使用アイテム <= 0
	GOTO LOOP
ENDIF
;相手使用時にMASTERのみアイテムの選択は再入力
IF 対象 != MASTER && 使用可能アイテム(使用アイテム) == 1
	GOTO LOOP
ENDIF
;IF ITEMTYPE_DRUG(使用アイテム,対象) && TCVAR:(ARG:1):お薬
;	PRINTW That's enough drugs for today.
;	GOTO LOOP
;ENDIF
IF (ITEMTYPE_FOOD(使用アイテム) || ITEMTYPE_MOD(使用アイテム) == 3) && !TIME_PROGRESS(TCVAR:対象:空腹時刻) ;addition custom code
	PRINTFORMW \@ 対象 == MASTER ? You are # %CALLNAME:対象% is \@ not hungry enough.
	GOTO LOOP
ENDIF
IF (ITEMTYPE_SWEETS(使用アイテム) || ITEMTYPE_MOD(使用アイテム) == 4) && !TIME_PROGRESS(TCVAR:対象:デザート空腹時刻) ;addition custom code
	PRINTFORMW \@ 対象 == MASTER ? You are # %CALLNAME:対象% is \@ not hungry enough for a snack.
	GOTO LOOP
ENDIF
TFLAG:193 = 使用アイテム
TFLAG:194 = 対象 == MASTER ? MASTER # 1

;----------------------------------
;addition custom code, for modded item usage
CALL Add_UseItem(使用アイテム, 対象)
IF RESULT > 0
	SIF RESULT == 3
		GOTO LOOP
	LOCAL:1 = 1
	SIF RESULT == 2
		虚無への回帰 = 1
	GOTO DONE
ENDIF
