		CALL DrugStuffNoFluff(対象,使用アイテム)
		LOCAL:1 ++
	CASE 212	;かしわもち
		PRINTFORML \@ 対象 == MASTER ? 당신은 먹는다 # %CALLNAME:対象%이/가 먹는다 \@ 그 %ITEMNAME_TR(使用アイテム)%.
		LOCAL:1 ++
