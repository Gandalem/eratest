DISH_TASTE_ENEMY += "できたて/"
DISH_TASTE_ENEMY += DISH_NAME_ENEMY + "/"
DISH_TASTE_ENEMY += DISH_TYPE + "/"
;[中立温度]は夏だけ冷たい（そば,うどん等）
