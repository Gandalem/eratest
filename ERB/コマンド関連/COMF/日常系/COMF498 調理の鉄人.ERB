@COM498
#DIMS 対戦相手
#DIMS 相手の料理
#DIM DISH_TYPE_NUM
#DIM SCORE, 3
#DIM JUDGE, 3
#DIM TOTAL_PLAYER
#DIM TOTAL_ENEMY
#DIM ENEMY_LV
#DIM C_ID
#DIM PREV_REDRAW
#DIMS THEME
#DIMS TASTE_TREND_GOOD
#DIMS TASTE_TREND_BAD
#DIMS DISH_NAME_ENEMY
#DIMS DISH_TASTE_ENEMY
#DIM BASEPOINT_TEMP
#DIMS WINNER
#DIM DishEXP
#DIM FirstWinBonus
;translation use
#DIMS strOppName
#DIMS strTheme
#DIMS strType

PRINTFORML Choose your opponent!
CALL ASK_M("Amateur",1,"Apprentice",1,"Expert",1,"Master",1,CALLNAME:TARGET + (CFLAG:TARGET:料理勝負勝利 == 1 ? " 　★Beaten" # ""),TARGET ? 1 # -1,"Cancel",1) ;custom code to show beaten opps
	;Custom code, split the contest from the command and expose the outcome.
SIF RESULT == 5
	RETURN -1
SETBIT TFLAG:一日一回, 14 ;Moved.
CALL IRON_CHEF_CONTEST(RESULT)
RETURN RESULT

@IRON_CHEF_CONTEST(EnemyType,PresetJudgeIndex:0,PresetJudgeIndex:1,PresetJudgeIndex:2,EnemyBonus,EnemyFloor=-1,EnemyCeiling=-1,MasterBonus,MasterFloor=-1,MasterCeiling=-1) ;Custom code, separate function.
	;A cooking contest between the player and one opponent.
	;Set TARGET to a character's index and use EnemyType 4 to start with a specific character.
	;OpponentIndex 0-3 are generic Amateur, Apprentice, Expert, and Master chefs.
	;Judges will be randomized if not given specific assignments.
	;EnemyBonus and MasterBonus add the given amount to every judge's score for the opponent or player.
	;EnemyFloor and EnemyCeiling, if passed, will raise or lower the opponent's score to be within those values.
#DIMS DYNAMIC 対戦相手
#DIMS DYNAMIC 相手の料理
#DIM DYNAMIC DISH_TYPE_NUM
#DIM DYNAMIC SCORE, 3
#DIM DYNAMIC JUDGE, 3
#DIM DYNAMIC TOTAL_PLAYER
#DIM DYNAMIC TOTAL_ENEMY
#DIM DYNAMIC ENEMY_LV
#DIM DYNAMIC C_ID
#DIM DYNAMIC PREV_REDRAW
#DIMS DYNAMIC THEME
#DIMS DYNAMIC TASTE_TREND_GOOD
#DIMS DYNAMIC TASTE_TREND_BAD
#DIMS DYNAMIC DISH_NAME_ENEMY
#DIMS DYNAMIC DISH_TASTE_ENEMY
#DIM DYNAMIC BASEPOINT_TEMP
#DIMS DYNAMIC WINNER
#DIM DYNAMIC DishEXP
#DIM DYNAMIC FirstWinBonus
#DIMS DYNAMIC strOppName
#DIMS DYNAMIC strTheme
#DIMS DYNAMIC strType
#DIM DYNAMIC EnemyType
#DIM DYNAMIC PresetJudgeIndex,3
#DIM DYNAMIC EnemyBonus
#DIM DYNAMIC EnemyFloor
#DIM DYNAMIC EnemyCeiling
#DIM DYNAMIC MasterBonus
#DIM DYNAMIC MasterFloor
#DIM DYNAMIC MasterCeiling
#DIM DYNAMIC Disqualified
SELECTCASE EnemyType ;Custom code, check argument instead of RESULT.
	CASE 0
		対戦相手 = 素人料理人
		strOppName = Amateur Chef
		ENEMY_LV = 1
	CASE 1
		対戦相手 = 駆け出し料理人
		strOppName = Apprentice Chef
		ENEMY_LV = 3
	CASE 2
		対戦相手 = 腕利き料理人
		strOppName = Expert Chef
		ENEMY_LV = 4
	CASE 3
		対戦相手 = 熟練料理人
		strOppName = Master Chef
		ENEMY_LV = 5
	CASE 4
		SIF TARGET == CFLAG:MASTER
			RETURN -1
		対戦相手 = %CALLNAME:TARGET%
		strOppName = %CALLNAME:TARGET%
		ENEMY_LV = ABL:TARGET:料理技能
	CASEELSE
		RETURN -1
ENDSELECT
DISH_TYPE_NUM = RAND:2 + 1
;レベル不足の時は軽食のみ
SIF ABL:MASTER:料理技能 < 2
	DISH_TYPE_NUM = 1

SELECTCASE DISH_TYPE_NUM
	CASE 1
		DISH_TYPE = 軽食
	CASE 2
		DISH_TYPE = 主食
ENDSELECT
$SELECTTHEME ;Custom code.
IF DISH_TYPE == "軽食"
	THEME = %TEXTR("和食/洋食/中華/肉料理/魚料理/汁物/揚げ物/煮物/おつまみ/家庭料理")%
ELSEIF DISH_TYPE == "主食"
	THEME = %TEXTR("和食/洋食/中華/肉料理/魚料理/麺類/鍋物/汁物/揚げ物/謎料理/家庭料理")%
ENDIF
strTheme '= CONTEST_DISH_THEME_TR(THEME)
strType '= CAPITALIZE(TASTE_TR(DISH_TYPE))

FOR LOCAL,0,3 ;Custom code, ensure themes are compatible with preset judges.
	SIF !PresetJudgeIndex:LOCAL
		CONTINUE
	SIF STRCOUNT(GET_STR(, "キャラデータ", PresetJudgeIndex:LOCAL, "料理：嫌いな味"), THEME)
		GOTO SELECTTHEME
NEXT

PRINTFORML 「And now, ladies and gentlemen, the curtain rises once more on the long-awaited, you-know-it, you-love-it: Iron Chef contest!!!」
PRINTFORML 「Will the flames blazing in today's kitchen forge the will to win, or turn into tears of defeat?!」
;custom code
CALL PRINT_STRL, @"「We proudly present today's theme... @BOLD@HEX@{C_YELLOW}@【%strTheme%】@!」"
;IF 対戦相手 == CALLNAME:TARGET
;	PRINTFORML 「私の記憶が確かならば、%THEME%といえばこの女！」
;ELSE
;	PRINTFORML 「今回のテーマは【%THEME%】。私の記憶が確かならば、%THEME%といえばこの男！」
;ENDIF

;qol custom code
CALL QOL_IRON_CHEF_JUDGE_SELECTION(THEME,PresetJudgeIndex:0,PresetJudgeIndex:1,PresetJudgeIndex:2)
IF RESULT < 0
	PRINTFORML 「...Unfortunately, we could not find enough people to serve as judges today.」
	PRINTFORMW 「Better luck next time!」
	RETURN -1
ELSE
	ARRAYCOPY "RESULT" , "JUDGE"
ENDIF

;custom
PRINTFORML 「And if my memory serves me right, this \@ 対戦相手 == CALLNAME:TARGET ? %PRINT_MALE("man", TARGET)% # man \@ right here is all about the %TOLOWER(strTheme)% stuff!」
PRINTFORML 「Please give a big round of applause to the %strTheme% Iron Chef, %strOppName%!」
SIF EnemyType == 4
	CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,DISH_TYPE_NUM,0,"IRON_CHEF_INTRO",THEME) ;Custom code, KOJO call.
SIF THEME == "家庭料理"
	THEME = 家庭的
PRINTFORML 「Facing them on the opposite corner is %CALLNAME:MASTER%, our Challenger!」
PRINTFORML 「Joining us for the cooking competition are the following individuals, who will be serving as judges this time around:」

$JUDGE_SELECT

; qol custom code, disabled here
; CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)
; ARRAYCOPY "SHAFFLE_ARRAY" , "JUDGE"

; ;テーマの味が嫌いな審査員だった場合再抽選
; ;対戦相手,なりきり時は自分だった場合も再抽選
; FOR LOCAL, 0 , 3
; 	C_ID = JUDGE:LOCAL + 1
; 	SIF STRCOUNT(GET_STR(, "キャラデータ", C_ID, "料理：嫌いな味"), THEME)
; 		GOTO JUDGE_SELECT
; 	SIF C_ID == TARGET
; 		GOTO JUDGE_SELECT
; 	SIF C_ID == FLAG:なりきり
; 		GOTO JUDGE_SELECT
; NEXT

FOR LOCAL, 0 , 3
	;JUDGE:LOCAL += 1 ;qol custom code
	C_ID = JUDGE:LOCAL
	CALL PRINT_FACE, C_ID, "通常", "服", "", ""
	PRINTFORML 
	PRINTFORML 【Judge #{LOCAL + 1} %CALLNAME:C_ID%】
	CALL KOJO_MESSAGE_SEND("EVENT",0,C_ID,DISH_TYPE_NUM,EnemyType == 4 ? TARGET # EnemyType*-1,"IRON_CHEF_JUDGE_INTRO",THEME) ;Custom code, KOJO calls.
	SIF EnemyType == 4
		CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,C_ID,LOCAL,"IRON_CHEF_MEET_JUDGE",THEME)
	PRINTL Favorite flavors: 
	CALL SHOW_TASTE(GET_STR(, "キャラデータ", C_ID, "料理：好きな味"), "POSITIVE", ABL:C_ID:親密 < 3)
	PRINTL Disliked flavors: 
	CALL SHOW_TASTE(GET_STR(, "キャラデータ", C_ID, "料理：嫌いな味"), "NEGATIVE", ABL:C_ID:親密 < 3)
	PRINTFORMW 
	CALL JUDGE_RESEARCH(C_ID,"GET")
NEXT

TASTE_TREND_GOOD =
TASTE_TREND_BAD =

;好きな味、嫌いな味の内気を付けるべきものを提示
CALL JUDGE_RESEARCH(C_ID,"OUT")
PRINTFORML 「And there we have it! The key to victory in this Iron Chef competition seems to be the following flavors:」
FOR LOCAL, 0, 6
	IF LOCAL < 3
		CALL COLORMESSAGE(@"[%TASTE_TR(RESULTS:LOCAL)%]",C_GREEN) ;custom code
		TASTE_TREND_GOOD += RESULTS:LOCAL + "/"
		IF LOCAL == 2 ;custom
			PRINTFORML
			PRINTFORML 「Conversely, one must watch out for these at the risk of upsetting our judges:」
		ENDIF
	ELSEIF LOCAL > 2
		CALL COLORMESSAGE(@"[%TASTE_TR(RESULTS:LOCAL)%]",C_RED) ;custom code
		TASTE_TREND_BAD += RESULTS:LOCAL + "/"
		;SIF LOCAL == 5 ;custom
		;	PRINTFORM 味には要注意！」
	ENDIF
NEXT
PRINTFORMW 

;curly brakes works badly with english text, creating extra spaces before or after
CALL PRINT_DIALOGUE, TEXTR(@"The outcome of victory lies in the soul infused into the ingredients and the innate talent that wields them! Let us see what miraculous dish the Challenger will present in %HIS_HER(MASTER)% daring counterattack!/Soon, this kitchen will turn into a fierce battlefield. Please enjoy the spectacle to the fullest as the two chefs prepare to clash their hidden mastery against each other in a magnificent battle!/Which side will claim the crown after this dazzling exchange of culinary skills?! Come witness the ultimate cuisine crafted in a limited amount of time - let us all bear witness!")

PRINTFORMW 「Without further ado... ALLEZ CUISINE!!!」

;相手の料理を生成する
CALL ENEMY_DISH_MENU(対戦相手, DISH_TYPE_NUM, THEME, ENEMY_LV, TASTE_TREND_GOOD, TASTE_TREND_BAD)
DISH_NAME_ENEMY = %RESULTS:0%
DISH_TASTE_ENEMY = %RESULTS:1%

SIF EnemyType == 4
	CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,0,0,"IRON_CHEF_START",DISH_TASTE_ENEMY) ;Custom code, KOJO call.

CALL COLORMESSAGE(@"【%strType%】【%strTheme%】(Failure to adhere to the theme will result in disqualification!)",C_YELLOW,1)
DRAWLINE
PREV_REDRAW = CURRENTREDRAW()
REDRAW 0
CALL COOKING_MATCH_SELECT(DISH_TYPE_NUM, THEME)
REDRAW PREV_REDRAW
IF RESULTS == "棄権"
	PRINTFORML Whoa, mama! It appears our Challenger has thrown in the towel and forfeited!
	WINNER = 棄権
	SIF EnemyType == 4
		CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,DISH_TYPE_NUM,0,"IRON_CHEF_MASTER_FORFEIT",DISH_TASTE_ENEMY) ;Custom code, KOJO call.
	GOTO PLAYER_LOSE
ENDIF

BASEPOINT_TEMP = DISH_BASEPOINT
CALL ENEMY_COOKING(DISH_NAME_ENEMY, DISH_TASTE_ENEMY, ENEMY_LV, 対戦相手)
DISH_NAME_ENEMY = %RESULTS%

SIF EnemyType == 4
	CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,0,0,"IRON_CHEF_FINISH",DISH_TASTE_ENEMY) ;Custom code, KOJO call.

PRINTFORML Our contestants have finished preparing their dishes!
PRINTFORMW Now, let us sample the fruits of their labor starting from %strOppName%'s %DISH_NAME_ENEMY%!

TOTAL_ENEMY = 0
FOR LOCAL, 0 , 3
	C_ID = JUDGE:LOCAL
	CALL PRINT_FACE, C_ID, "通常", "服", "", ""
	CALL REVIEW_DISH(C_ID, DISH_TASTE_ENEMY)
	SCORE:LOCAL = TCVAR:C_ID:料理評価値/10
	SCORE:LOCAL += EnemyBonus ;Custom code.
	SCORE:LOCAL = IRON_CHEF_SCORE_CLAMP(SCORE:LOCAL,EnemyFloor,EnemyCeiling)
	CALL KOJO_MESSAGE_SEND("EVENT",0,C_ID,SCORE:LOCAL,EnemyType == 4 ? TARGET # EnemyType*-1,"IRON_CHEF_JUDGING_ENEMY",DISH_TASTE_ENEMY) ;Custom code, KOJO call.
	PRINTFORMW 【Judge #{LOCAL + 1} %CALLNAME:C_ID%】 %PRINT_PLUR("Point", SCORE:LOCAL)%
	TOTAL_ENEMY += SCORE:LOCAL
NEXT
CALL COLORMESSAGE(@"Total score: %PRINT_PLUR("Point", TOTAL_ENEMY)%",C_YELLOW,1)
DISH_BASEPOINT = BASEPOINT_TEMP

PRINTFORMW The judges have spoken! But how will the Challenger's %DISHNAME_TR(DISH_NAME)% fare?!

IF STRFIND(DISH_TASTE, THEME) == -1
	PRINTFORML Wait, what is this?!
	PRINTFORML This dish can't be called【%strTheme%】! Disqualification is in order!!!
	Disqualified = 1 ;Custom code.
	SIF EnemyType == 4
		CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,DISH_TYPE_NUM,0,"IRON_CHEF_MASTER_DISQUALIFIED",DISH_TASTE_ENEMY) ;Custom code, KOJO call.
	GOTO PLAYER_LOSE
ENDIF

TOTAL_PLAYER = 0
FOR LOCAL, 0 , 3
	C_ID = JUDGE:LOCAL
	CALL PRINT_FACE, C_ID, "通常", "服", "", ""
	CALL REVIEW_DISH(C_ID, DISH_TASTE)
	SCORE:LOCAL = TCVAR:C_ID:料理評価値 / 10
	SCORE:LOCAL += MasterBonus ;Custom code.
	SCORE:LOCAL = IRON_CHEF_SCORE_CLAMP(SCORE:LOCAL,MasterFloor,MasterCeiling)
	CALL KOJO_MESSAGE_SEND("EVENT",0,C_ID,SCORE:LOCAL,EnemyType == 4 ? TARGET # EnemyType*-1,"IRON_CHEF_JUDGING_MASTER",DISH_TASTE_ENEMY) ;Custom code, KOJO call.
	IF SCORE:LOCAL >= 80
		SETCOLOR C_GREEN
		FONTBOLD
		{
			PRINTFORML The scenery behind %CALLNAME:C_ID% changes, vividly depicting %TRIM_TEXT(TEXTR("the grand explosion of the Scarlet Devil Mansion
				/the cataclysmic eruption of Youkai Mountain
				/Suzunaan going up in flames
				/the Inverted Castle crashing down and the Hakurei Shrine getting blasted to bits
				/Animal Spirits and Haniwa dancing Samba together
				/the Moon bouncing off the surface and lodging itself inside Hecatia's head
				/the Moriya Shrine splitting in two, making way for Hisoutensoku's takeoff
				/Hell of Blood Pools turning cobalt blue, with palm trees growing around it
				/the appearance of a colossal head belonging to Hina Kagiyama
				/a Seven-Colored Cannonball being fired"))%!!!
		}
		RESETCOLOR
		FONTREGULAR
	ENDIF
	PRINTFORMW 【Judge #{LOCAL + 1} %CALLNAME:C_ID%】 %PRINT_PLUR("Point", SCORE:LOCAL)%
	TOTAL_PLAYER += SCORE:LOCAL
NEXT
CALL COLORMESSAGE(@"Total score: %PRINT_PLUR("Point", TOTAL_PLAYER)%",C_YELLOW,2)
IF TOTAL_PLAYER > TOTAL_ENEMY
	WINNER = 勝利
	SETCOLOR C_GREEN ;custom
	PRINTFORMW Congratulations, you won the contest!
	SIF EnemyType == 4
		CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,TOTAL_PLAYER,EnemyType == 4 ? TARGET # EnemyType*-1,"IRON_CHEF_LOSE",DISH_TASTE_ENEMY) ;Custom code, KOJO call.
ELSE
	WINNER = 敗北
	$PLAYER_LOSE
	SETCOLOR C_YELLOW ;custom
	PRINTFORMW Alas, %strOppName% wins this round!
	SIF EnemyType == 4 && WINNER == "敗北" && !Disqualified
		CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET,TOTAL_PLAYER,EnemyType == 4 ? TARGET # EnemyType*-1,"IRON_CHEF_WIN",DISH_TASTE_ENEMY) ;Custom code, KOJO call.
ENDIF
RESETCOLOR ;custom
CALL RESET_DISH

IF WINNER == "勝利" ;if we win (seems to be an identical repurposed section from danmaku)
	IF !CFLAG:TARGET:料理勝負勝利 && 対戦相手 == CALLNAME:TARGET ;note: this check might be flawed
		CALL COLORMESSAGE(@"【First win against %CALLNAME:TARGET%】",C_YELLOW,1)
		CFLAG:TARGET:料理勝負勝利 = 1
		SELECTCASE ABL:TARGET:料理技能
			CASE 0
				FirstWinBonus = 1
			CASE 1
				FirstWinBonus = 3
			CASE 2
				FirstWinBonus = 5
			CASE 3
				FirstWinBonus = 10
			CASE 4
				FirstWinBonus = 20
			CASE 5
				FirstWinBonus = 30
			CASEELSE
				FirstWinBonus = 50
		ENDSELECT
		EXP:MASTER:料理経験 += FirstWinBonus
	ENDIF
	DishEXP = MAX(ENEMY_LV , 1)
	SIF ABL:MASTER:料理技能 < ENEMY_LV
		DishEXP *= 2
	EXP:MASTER:料理経験 += DishEXP
ELSEIF WINNER == "敗北" ;if we lose
	EXP:MASTER:料理経験 += 1
ENDIF
RESULT:1 = TOTAL_PLAYER ;Custom code, expose more details of the contest's outcome.
RESULT:2 = TOTAL_ENEMY
RESULT:3 = EnemyType
RESULT:4 = ENEMY_LV
RESULTS '= DISH_NAME_ENEMY
RESULTS:1 '= DISH_TASTE_ENEMY
RESULTS:2 '= WINNER
DOWNBASE:MASTER:体力 = 100
DOWNBASE:MASTER:気力 = 100
TIME += 90
RETURN 1

@IRON_CHEF_SCORE_CLAMP(Score,ScoreFloor,ScoreCeiling)
		;Ensures the given score is within the given range with some variation.
#FUNCTION
#DIM DYNAMIC Score
#DIM DYNAMIC ScoreFloor
#DIM DYNAMIC ScoreCeiling
IF ScoreFloor > -1 && Score < ScoreFloor
	Score = MIN(ScoreFloor+RAND:10,ScoreCeiling)
ELSEIF ScoreCeiling > -1 && Score > ScoreCeiling
	Score = MAX(ScoreCeiling-RAND:10,ScoreFloor)
ENDIF
RETURNF Score

;-------------------------------------------------
;料理の選択
;-------------------------------------------------
@COOKING_MATCH_SELECT(DISH_TYPE_NUM, THEME)
#DIM DISH_TYPE_NUM
#DIM MAXMENU
#DIM MENUCOUNT
#DIM SELECT_MENU
#DIM SELECT_ING
#DIM 料理結果
#DIM REQUIRED_LV
#DIMS THEME

CALL COOKING_UI(DISH_TYPE_NUM, SELECT_MENU, SELECT_ING, 0, 0, 0, THEME)
PRINTFORML [ 0] Surrender
INPUT
;やめる
RESULTS =
IF RESULT == 0
	RESULTS = 棄権
ELSEIF RESULT == 9 && SELECT_MENU
	CALL DISHDATA(SELECT_MENU, DISH_TYPE, 0)
	IF RESULT != 10
		CLEARLINE 13 + COOKING_LCOUNT
		RESTART
	ENDIF
	CALL DISH_TASTE_ADD(SELECT_ING)
	DISH_RANK = 食材レベル(SELECT_ING)
	;DISHNAMEは口上でのみ使用してください
	DISHNAME = %DISH_NAME%
	FLAG:料理 = SELECT_MENU
	SELECT_MENU = 0
	;custom
	;PRINTFORML 使用食材：%ITEMNAME:SELECT_ING%
	CALL COLORMESSAGE(@"Ingredient used:  %ITEMNAME_TR(SELECT_ING)%, Total: {ITEM:SELECT_ING} → {MAX(ITEM:SELECT_ING - 1, 0)}", C_YELLOW,1)
	ITEM:SELECT_ING --
	CALL DISH_COOKING(0)
ELSE
	;料理選択
	IF INRANGE(RESULT, 101, 400 + CHARANUM)
		SELECT_MENU = RESULT
		CALL DISHDATA(RESULT, DISH_TYPE)
		;表示外なら選択リセット
		IF !RESULT
			SELECT_MENU = 0
			SELECT_ING = -1
		;作れないなら材料だけリセットして表示する
		ELSEIF RESULT < 10
			SELECT_ING = -1
		;作れるなら材料を設定
		ELSEIF RESULT == 10
			RESULT = 0
			;選択中の材料があったら選択を保持する
			FOR LOCAL, 1, 11
				IF DISH_ING:LOCAL == SELECT_ING && SELECT_ING >= 0
					RESULT = 1
					BREAK
				ENDIF
			NEXT
			;選択中の材料がなければ材料を再設定
			IF !RESULT
				FOR LOCAL, 1, 11
					IF ITEM:(DISH_ING:LOCAL)
						SELECT_ING = DISH_ING:LOCAL
						BREAK
					ENDIF
				NEXT
			ENDIF
		ENDIF
	ELSEIF INRANGE(RESULT, 11, 20) && DISH_ING:(RESULT - 10) >= 0 && ITEM:(DISH_ING:(RESULT - 10))
		SELECT_ING = DISH_ING:(RESULT - 10)
	ENDIF
	CLEARLINE 14 + COOKING_LCOUNT
	RESTART
ENDIF
