; Modular ERB: COMF/日常系/COMF464 特殊地域間移動.ERB
;-------------------------------------------------
;特殊地域間移動
;日常系コマンド、レベル1
;-------------------------------------------------

@COM464
#DIM FEE
#DIM 目的場所
#DIM 所要時間
VARSET LOCAL
FEE = 0
FOR LOCAL,1,CHARANUM
;NAS: Don't count dead
SIF IsDead:LOCAL:0
	CONTINUE
IF CFLAG:(LOCAL):同行
	LOCAL:1 ++
	SIF CFLAG:LOCAL:衰弱 || BASE:LOCAL:気力 == 0
		LOCAL:2 ++
	SIF !CHARA_HOLIDAY(LOCAL) && BASE:LOCAL:仕事量
		LOCAL:3 ++
ENDIF
NEXT
IF NEMUKE() >= 720
	PRINTFORML 너무 졸리다고 느껴 외출하지 않기로 결정한다.
	RETURN -1
ELSEIF !MOREDATE && LOCAL:1 > 1
	PRINTL 다른 사람 한 명 이상은 태울 수 없다.
	RETURN -1
ELSEIF LOCAL:2 || BASE:MASTER:気力 == 0
	PRINTFORML 기력이 없는 사람들은 참석해서는 안 된다 \@ BASE:MASTER:気力 == 0 ? (0 ENE) # (파트너가 너무 피곤하다) \@.
	RETURN -1
ELSEIF LOCAL:3 && FESTIVAL() == ""
	PRINTFORML 파트너는 그들의 근무일이라 함께 올 수 없다.
	RETURN -1
	;(天候パッチ)悪天候時も外出可能に
	;ELSEIF TIME:5 == 9 || TIME:5 == 5
	;	PRINTFORML Can't go out because of the bad weather.
	;	RETURN -1
ELSEIF TALENT:MASTER:100 < -4
	PRINTFORML 그 작은 몸으로는 밖에 나가는 게 너무 위험하다.
	RETURN -1
ENDIF
SELECTCASE CFLAG:MASTER:現在位置
	CASE 205, 210, 803, 820
		; IF !INRANGE(TIME, 540, 1260) ;qol custom code, allow cableway to work up to 21:00 instead of 17:00 at a higher fee
		; 	PRINTFORML Outside of business hours.
		; 	RETURN -1
		; ENDIF
		CALL BusinessHours(540,1260)
		SIF RESULT == -1
			RETURN -1
		;(天候パッチ)悪天候時は運行見合わせ
		IF GET_LOCATION_AREA_TYPHOON() == 1
			PRINTFORML 접근하는 태풍 때문에 서비스가 중단되었습니다.
			RETURN -1
		ENDIF
		IF WIND_VELOCITY >= 1
			PRINTFORML 강풍으로 인해 서비스가 중단되었습니다.
			RETURN -1
		ENDIF
		SELECTCASE TIME:5
			CASE 14, 15
				PRINTFORML 폭우로 인해 서비스가 중단되었습니다.
				RETURN -1
			CASE 9
				PRINTFORML 폭설로 인해 운행 중입니다.
				RETURN -1
		ENDSELECT
		;守矢キャラたちと同行時は敷設者割引運賃
		IF MOREDATE && NumberOfDates > 1 ; handle custom group date code first, if its a 1 on 1 we can use the original
			IF IS_IN_GROUP_DATE(31) || IS_IN_GROUP_DATE(32) || IS_IN_GROUP_DATE(33) ; moriya check
				FEE = 1
			ELSE
				FEE = 5 + (5 * NumberOfDates)
			ENDIF
		ELSEIF (CFLAG:31:同行 || CFLAG:32:同行 || CFLAG:33:同行) || GROUPMATCH(FLAG:デート相手, 31, 32, 33) ;bug fix, correct check for dating moriya
			FEE = 1
		ELSEIF CFLAG:MASTER:同行 || FLAG:デート相手 ;bug fix
			FEE = 10
		ELSE
			FEE = 5
		ENDIF
		;qol custom code
		SIF TIME >= 1020 && FEE != 1
			FEE += 5
		IF MOREDATE && NumberOfDates > 1
			CALL MOREDATES_CABLEWAY(FEE)
			;相手が鬼か天狗だと愛想笑い／敷設者にも敬意を払う
		ELSEIF GROUPMATCH(TARGET, 10, 29, 31, 32, 33, 42, 64, 65) && CFLAG:TARGET:同行
			;ガワを山の河童(16)or里の人間(12)に決める
			LOCAL = 12 + ((CFLAG:MASTER:現在位置 / 100 == 8) * 4)
			CALL SPTALK, 0, "笑顔", LOCAL, @"「어라, %CALLNAME:TARGET%씨 아니신가요, 당신도 그거 사용하고 있네요?」",1
			PRINTFORM ~하자마자 
			;人里側に河童が常駐してるのもアレかなと
			IF CFLAG:MASTER:現在位置 / 100 == 2
				PRINTFORM 카파
			ELSE
				PRINTFORM 접수원
			ENDIF
			PRINTFORML  본다 %CALLNAME:TARGET%, %HE_SHE(TARGET)%는 억지 미소를 짓는다.
		ELSE
			;人里側では一応丁寧対応に
			IF CFLAG:MASTER:現在位置 / 100 == 2
				CALL SPTALK, 0, "通常", 12, @"「케이블카 타 볼래?」/「그건 %金額表示(FEE * 200)%일 거야! {FEE} 카리스마도 통하거든.」",1
			ELSE
				CALL SPTALK, 0, "通常", 16, @"「...응? 케이블카를 타고 갈래?」/「{FEE} 카리스마. %金額表示(FEE * 200)%로도 작동해.」",1
			ENDIF
			;qol custom code
			SIF TIME >= 1020 && FEE != 1
				CALL SPTALK, 0, "笑顔", CFLAG:MASTER:現在位置 / 100 == 2 ? 12 # 16, @"「하아... 이렇게 늦게까지 일하니 돈을 더 받고 싶어지네.」",1
		ENDIF
		CALL PAY_YEN_OR_CM(FEE * 200, FEE)
		SELECTCASE RESULT
			CASE 0
				RETURN -1
			CASE 1
				SIF FLAG:口上色 ;qol custom code, set shopkeeper text color
					SETCOLOR CFLAG:MASTER:現在位置 / 100 == 2 ? モブ子店員口上色:12 # モブ子店員口上色:16
				IF (CFLAG:31:同行 || CFLAG:32:同行 || CFLAG:33:同行) || GROUPMATCH(FLAG:デート相手, 31, 32, 33) || (MOREDATE && (IS_IN_GROUP_DATE(31) || IS_IN_GROUP_DATE(32) || IS_IN_GROUP_DATE(33))) ;bug fix
					PRINTFORML 「항상 싸게 해줄게~」
				ELSE
					PRINTFORML 「다시 말해봐!」
				ENDIF
				RESETCOLOR
			CASE 2
				SIF FLAG:口上色 ;qol custom code, set shopkeeper text color
					SETCOLOR CFLAG:MASTER:現在位置 / 100 == 2 ? モブ子店員口上色:12 # モブ子店員口上色:16
				;custom code
				IF (CFLAG:31:同行 || CFLAG:32:同行 || CFLAG:33:同行) || GROUPMATCH(FLAG:デート相手, 31, 32, 33) || (MOREDATE && (IS_IN_GROUP_DATE(31) || IS_IN_GROUP_DATE(32) || IS_IN_GROUP_DATE(33))) ;bug fix
					PRINTFORML 「언제나 싸게 해줄게~」
				ELSEIF CFLAG:MASTER:現在位置 / 100 == 2
					PRINTFORML 「카리스마로 계산해도 괜찮아... 좋아, 어서.」
				ELSE
					PRINTFORML 「헤에? 손님은 인간인데도 카리스마를 가지고 있어?」
				ENDIF
				RESETCOLOR
		ENDSELECT
ENDSELECT
;住み込み先からの特殊移動 or 住み込み先でない場所への特殊移動はデート扱い
IF AT_HOME(MASTER) || MAIN_MAP != SPECIAL_AREAMOVE() / 100
	;bug fix: move time here so that it can proper add before position changes
	;qol let player use TSP if auto-tsp is active
	CALL QOL_MOVE_TO_OTHER_AREA_APPLY_TIME
	LOCAL:2 = 0
	LOCALS = %STR_TR(6000 + SPECIAL_AREAMOVE() / 10)%
	FOR LOCAL,1,CHARANUM
	IF CFLAG:(LOCAL):同行
		CFLAG:LOCAL:デート中 = SPECIAL_AREAMOVE() / 100
		CFLAG:LOCAL:現在位置 = SPECIAL_AREAMOVE()
		LOCAL:2 = LOCAL
		FLAG:デート相手 = LOCAL
	ENDIF
	NEXT
	CFLAG:MASTER:デート中 = SPECIAL_AREAMOVE() / 100
	CFLAG:MASTER:現在位置 = SPECIAL_AREAMOVE()
	IF MOREDATE && NumberOfDates > 1 ;do the same thing but as a loop
		FOR LOCAL:10, 0, NumberOfDates
		IF CFLAG:MASTER:デート中 == 2
			CALL EX_COSTUME(Datees:(LOCAL:10), "人里デート")
			SIF RESULT
				PRINTFORMW %CALLNAME:(Datees:(LOCAL:10))%은 인간 마을에서 입기에 더 적합한 옷으로 갈아입었다.
		ELSE
			CALL EX_COSTUME(Datees:(LOCAL:10), "デート")
			SIF RESULT
				PRINTFORMW %CALLNAME:(Datees:(LOCAL:10))%은(는) %HIS_HER(Datees:(LOCAL:10))% 옷을 데이트 복장으로 바꿨다.
		ENDIF
		NEXT
	ELSEIF CFLAG:MASTER:デート中 == 2
		CALL EX_COSTUME(FLAG:デート相手, "人里デート")
		SIF RESULT
			PRINTFORMW %CALLNAME:(FLAG:デート相手)%은 인간 마을에서 입기에 더 적합한 옷으로 갈아입었다.
		;addition custom code, change to date clothes for some chara
	ELSE
		CALL EX_COSTUME(FLAG:デート相手, "デート")
		SIF RESULT
			PRINTFORMW %CALLNAME:(FLAG:デート相手)% %HIS_HER(FLAG:デート相手)%의 옷을 %HIS_HER(FLAG:デート相手)% 데이트 복장으로 바꿨다.
	ENDIF
	PRINTFORML 당신은 %LOCALS%로 떠난다.
	;TIME += SPECIAL_AREAMOVE_TIME() ;bug fix
	;住み込み先でないところから住み込み先への移動はデート終了扱い
ELSEIF !AT_HOME(MASTER) && MAIN_MAP == SPECIAL_AREAMOVE() / 100
	IF CFLAG:負け犬 && TALENT:行きずり == 1
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"를")% 집으로 데려간다.
	ELSE
		PRINTFORMW 당신은 \@ CFLAG:MASTER:デート中 != CFLAG:TARGET:デート中 || TARGET == MASTER ? 여행 # 데이트 \@에서 돌아온다.
	ENDIF
	;デート終了時は強制的にENTRANCEへ飛ばされるため一時保存
	目的場所 = SPECIAL_AREAMOVE()
	所要時間 = SPECIAL_AREAMOVE_TIME()
	CFLAG:MASTER:現在位置 = SPECIAL_AREAMOVE()
	CALL 守矢くじデート相手のリセット()
	CALL HYPNO_DATE_RESET() ;hypnosis custom code
	FOR LOCAL,1,CHARANUM
	IF CHK_DATENOW(CFLAG:LOCAL:デート中)
		CALL DATE_EVENT(LOCAL)
		CFLAG:LOCAL:現在位置 = 目的場所
		CALL SET_DATE(99,LOCAL)
		;デート相手にも改めて現在位置渡す
		CFLAG:LOCAL:現在位置 = 目的場所
	ENDIF
	NEXT
	CALL SET_DATE(99,MASTER,0)
	;一時保存情報渡す
	CFLAG:MASTER:現在位置 = 目的場所
	TIME += 所要時間
ENDIF
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE464
;停止中は不可
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(464)
	RETURN RESULT
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
;添い寝中
SIF CFLAG:添い寝中
	RETURN 0
SIF !SPECIAL_AREAMOVE()
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
RETURN 1
;-------------------------------------------------

@SPECIAL_AREAMOVE()
#FUNCTION
SELECTCASE CFLAG:MASTER:現在位置
	;博麗神社守矢分社
	CASE 21
		;守矢キャラと同行中
		SIF (CFLAG:31:同行 || CFLAG:32:同行 || CFLAG:33:同行) || GROUPMATCH(FLAG:デート相手, 31, 32, 33) ;bug fix
			RETURNF 840
		;人里北通り
	CASE 205
		RETURNF 820
		;広場（ミニマップ）
	CASE 210
		IF MAIN_MAP != 2
			IF MAIN_MAP == 8
				RETURNF 803
			ELSE
				RETURNF 820
			ENDIF
		ENDIF
		;無縁塚（魔法の森がメインマップ）
	CASE 506
		RETURNF 610
		;無縁塚（外出先から）
	CASE 570
		;メインマップが三途の川～冥界のときは中有の道へ
		SIF MAIN_MAP == 6
			RETURNF 601
		;今後のことを考えて弾いておく 中有の道(外出)へ
		SIF MAIN_MAP != 5
			RETURNF 610
		;間欠泉地下センター(7がメインマップ)
	CASE 712
		RETURNF 970
		;間欠泉地下センター(外出先から)
	CASE 760
		;メインマップが地底のときは灼熱地獄跡へ
		SIF MAIN_MAP == 9
			RETURNF 928
		;今後のことを考えて弾いておく 灼熱地獄跡(外出)へ
		SIF MAIN_MAP != 7
			RETURNF 970
		;山頂への道
	CASE 732, 770 ;addition custom code, move to summit entrance if you live there, or waterfall if not
		RETURNF MAIN_MAP == 8 ? 801 # 810
	CASE 810 ;addition custom code, a little complicated because 810 exists on the map if you live there
		SIF MAIN_MAP == 8 ;disable this waypoint if you live on the summit and use the other one instead
			RETURNF 0
		RETURNF MAIN_MAP == 7 ? 732 # 770 ;move to the road to summit if you live there, or deep forest if not
	CASE 801
		SIF MAIN_MAP == 8
			RETURNF 770
		;-------------------------------
		;索道駅
	CASE 803
		RETURNF 210
		;絶景の丘
	CASE 820
		;メインマップが人里のときは人里北通りへ
		SIF MAIN_MAP == 2
			RETURNF 205
		;守矢神社・早苗私室(820)を弾き広場へ
		SIF MAIN_MAP != 8
			RETURNF 210
		;灼熱地獄跡（9がメインマップ）
	CASE 928
		RETURNF 760
		;灼熱地獄跡（外出先から）
	CASE 970
		;メインマップが妖怪の山（山麓）のときは間欠泉地下センターへ
		SIF MAIN_MAP == 7
			RETURNF 712
		;今後のことを考えて弾いておく 灼熱地獄跡(外出)へ
		SIF MAIN_MAP != 9
			RETURNF 760
ENDSELECT
RETURNF 0
;-------------------------------------------------

@SPECIAL_AREAMOVE_TIME()
#FUNCTION
SELECTCASE CFLAG:MASTER:現在位置
	;博麗神社守矢分社
	CASE 21
		RETURNF 1
		;人里北通り
	CASE 205
		RETURNF 15
		;広場
	CASE 210
		RETURNF 15
		;無縁塚
	CASE 506, 570
		SIF SHORTCUT(3)
			RETURNF 3
		RETURNF 5
		;間欠泉地下センター
	CASE 712, 760
		RETURNF 10
		;山頂への道
	CASE 732, 770, 810, 801 ;770, 810, 801 - addition custom code
		RETURNF 5
		;索道駅
	CASE 803
		RETURNF 15
		;絶景の丘
	CASE 820
		RETURNF 15
		;灼熱地獄跡
	CASE 928, 970
		RETURNF 5
ENDSELECT
