; Modular ERB: COMF/日常系/COMF412 勉強.ERB
;-------------------------------------------------
;勉強
;日常系コマンド、レベル1
;-------------------------------------------------

@COM412
;自室時かつ家具を持っている際は補正
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ITEM:ケヤキの机椅子
	SELECTCASE ITEM:ケヤキの机椅子
		CASE 1
			DOWNBASE:MASTER:体力 = 90
			DOWNBASE:MASTER:気力 = 270
		CASE 2
			DOWNBASE:MASTER:体力 = 80
			DOWNBASE:MASTER:気力 = 240
		CASE 3
			DOWNBASE:MASTER:体力 = 70
			DOWNBASE:MASTER:気力 = 210
	ENDSELECT
	PRINTFORML 바른 자세, 곧게 편 등, 읽기, 쓰기, 그리고 산술은 모두 공부의 기본이다!
ELSE
	DOWNBASE:MASTER:体力 = 100
	DOWNBASE:MASTER:気力 = 300
ENDIF
IF TARGET != MASTER && !CFLAG:睡眠 && CFLAG:行動 != 5
	;固定で獲得するソース
	SOURCE:歓楽 = 200
	TFLAG:ムード上昇抑制 = 1
	;信頼
	TFLAG:98 = 3
	SIF ABL:MASTER:教養 > 2
		TFLAG:98 ++
	IF ABL:MASTER:教養 > ABL:教養
		TFLAG:98 ++
		EXP:学習経験 += 2
	ENDIF
	SIF ABL:MASTER:教養 < ABL:教養 - 2
		EXP:MASTER:学習経験 ++
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:歓楽 += (ABL:従順 * 60)
	ELSEIF ABL:従順 <= 3
		SOURCE:歓楽 += 200 + (ABL:従順 * 60)
	ELSEIF ABL:従順 <= 5
		SOURCE:歓楽 += 500 + (ABL:従順 * 60)
	ELSEIF ABL:従順 <= 8
		SOURCE:歓楽 += 750 + (ABL:従順 * 75)
	ELSEIF ABL:従順 <= 11
		SOURCE:歓楽 += 1000 + (ABL:従順 * 75)
	ELSE
		SOURCE:歓楽 += 2000 + (ABL:従順 * 30)
	ENDIF
	;好感度をみる
	IF CFLAG:2 <= 500
		SOURCE:歓楽 += CFLAG:2
	ELSEIF CFLAG:2 <= 5000
		SOURCE:歓楽 += 500 + (CFLAG:2 - 500) / 3
	ELSE
		SOURCE:歓楽 += 2000 + (CFLAG:2 - 5000) / 5
	ENDIF
	SIF SOURCE:歓楽 < 0
		SOURCE:歓楽 = 0
	EXP:MASTER:学習経験 ++
	EXP:学習経験 ++
ENDIF
;(天候パッチ)大雨・豪雨・大雪・ひょう・暴風のときには効率上昇
IF (TIME:5 == 13 && GET_HEAT_THUNDERSTORM() == 1) || TIME:5 == 14 || TIME:5 == 15
	PRINTFORML 비 오는 소리가 집중하는 것을 도와주자, 당신은 더 효율적으로 공부에 몰두한다.
	TIME += 30
ELSEIF WIND_VELOCITY >= 2
	PRINTFORML 바람 소리가 집중을 도와주면서, 너는 더 효율적으로 공부하려고 노력한다.
	TIME += 30
ELSEIF TIME:5 == 9
	PRINTFORML 눈의 고요함이 집중을 돕는 가운데, 당신은 더 효율적으로 공부하기 위해 노력한다.
	TIME += 30
ELSEIF TIME:5 == 5
	PRINTFORML 비 오는 소리가 집중하는 데 도움을 주자, 너는 더 효율적으로 공부에 전념한다.
	TIME += 45
ELSEIF WIND_VELOCITY >= 1
	PRINTFORML 바람 소리가 집중을 돕는 가운데, 당신은 더 효율적으로 공부하기 위해 노력한다.
	TIME += 45
ELSEIF IS_WISEMAN()
	PRINTFORML 세상의 욕정들이 더 이상 네 마음에 없으므로, 너는 더욱 효율적으로 공부하는 데 전념한다.
	TIME += 45
ELSEIF IS_BABY(TARGET)
	PRINTFORML 아기 %조사처리(CALLNAME:TARGET,"의")% 응원 소리가 집중을 돕자, 효율적으로 공부하기 위해 노력한다.
	TIME += 30
ELSE
	TIME += 60
ENDIF
SIF CFLAG:同行
	CFLAG:同行 += 60
EXP:MASTER:学習経験 ++
SIF ITEM:103 && !RAND:2
	EXP:MASTER:学習経験 ++
CALL LS_BOOK_BONUS(103) ;Custom code, add experience during Lunatic Survival.
SIF ITEM:214 > 0
	EXP:MASTER:学習経験 ++
SIF ITEM:ケヤキの机椅子 && !RAND:2
	EXP:MASTER:学習経験 ++
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE412
;勉強実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(412)
	RETURN RESULT
;勉強出来る部屋か
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ITEM:ケヤキの机椅子
	;上の条件を満たしたら処理を飛ばす
ELSEIF !勉強可(CFLAG:MASTER:現在位置)
	RETURN 0
ENDIF
;添い寝中
SIF CFLAG:添い寝中
	RETURN 0
;イタズラ中
SIF CFLAG:MASTER:イタズラ
	RETURN 0
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
RETURN 1

@IS_WISEMAN()
#FUNCTION
SIF HAS_PENIS(MASTER) && (BASE:MASTER:精力 *10) <= MAXBASE:MASTER:精力 ;qol custom code, only apply if penis
	RETURNF 1
SIF FLAG:願掛け内容 == 201
	RETURNF 1
RETURNF 0
