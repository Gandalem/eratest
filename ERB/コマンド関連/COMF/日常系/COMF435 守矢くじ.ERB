; Modular ERB: COMF/日常系/COMF435 守矢くじ.ERB
;-------------------------------------------------
;守矢くじ
;日常系コマンド、レベル1
;-------------------------------------------------
;守矢ガｔ……くじ
;LOCAL

@COM435
#DIM ガチャ回数
#DIM カリスマ払い
#DIMS 台詞
#DIMS 表情
VARSET LOCAL
ガチャ回数 = 0
IF !BETWEENTIME(600,1200)
	PRINTFORML 영업 종료다...
	PRINTFORMW 업무 시간 외인 것 같다.
	RETURN -1
ENDIF
IF !GETBIT(FLAG:999, 2)
	PRINTFORMW 사찰 경계에 포스터가 있다.
	PRINTFORML ┌─────────────┐
	PRINTFORML ｜　　　　　　　　　　　　　｜
	PRINTFORML 모리야 복권장
	PRINTFORML 극찬받은 판매다!
	PRINTFORML ｜　　　　　　　　　　　　　｜
	PRINTFORML ｜　　　　　　　　　　　　　｜
	PRINTFORML 신의 호의는 보장된다.
	PRINTFORML ｜　　　is  guaranteed　　　｜
	PRINTFORML ｜　　　　　　　　　　　　　｜
	PRINTFORML 모리카 신사
	PRINTFORML └─────────────┘
	PRINTFORMW 
	PRINTFORML 신사 마이(巫女) 복장(물론 녹색 스타일로)을 입은 소녀, 아마도 조수일 것이다, 다가와 미소를 지어 보인다.
	PRINTFORMW 그녀 옆에는 「봉헌 상자」라고 표시된 상자가 있다.
	PRINTFORML ...
	PRINTFORML ......
	PRINTFORMW 어쩐지 이 모든 상황에 대해 강한 직감을 떨쳐버릴 수가 없다...
	SETBIT FLAG:999, 2
	;最初のくじのセットを作成
	CALL FISHER_YATES_SHAFFLE(300)
	ARRAYCOPY "SHAFFLE_ARRAY", "MORIYA_BOX"
ENDIF
IF FLAG:守矢くじデート相手
	CALL SPTALK, 0, @"평소", 15, @"「지금 복권 놀이할 때가 아니지 않아?」/「너는 신과 데이트할 자격이 있으니, 사소한 것에 단 1초도 낭비하지 마라!」", 1
	RETURN -1
ENDIF
IF FLAG:守矢デート権 && !FLAG:デート相手
	CALL ASK_YN(@"%CALLNAME:(FLAG:守矢デート権)%의 데이트권을 사용한다.", "복권을 뽑는다")
	IF !RESULT
		CALL DATE_RIGHT
		TIME += 3
		RETURN 1
	ENDIF
ENDIF
IF MONEY < 3000 && MONEY:2 < 20
	PRINTFORMW 지갑을 확인해 보니 돈이 충분하지 않다는 것을 깨닫는다.
	PRINTFORMW 기부를 할 만큼 돈을 벌기 위해 나가야 할 시간인 것 같다!
	RETURN -1
ENDIF
CALL SPTALK, 0, @"미소", 15, @"「그림을 그리는 데 비용은 %金額表示(3000)% 또는 매력 20 또는 모리야 부적 5개이다.」", 1
PRINTL 하나 살래?
CALL ASK_M("상황이 더 나빠지기 전에 멈추자",1,@"%金額表示(3000)%로 그린다.", MONEY >= 3000, "20CM로 그리다", MONEY:2 >= 20, "5개의 모리야 부적을 가지고 그림을 그린다.", ITEM:131>= 5, @"%金額表示(27000)%으로 10을 뽑는다.", MONEY >= 27000, "180CM로 10을 그린다.", MONEY:2 >= 180, "50 모리야 참으로 10을 뽑는다.", ITEM:131 >= 50)
SELECTCASE RESULT
	CASE 0
		IF 顔絵付きメッセージ
			IF !RAND:8
				台詞 = 「Whaa... Is this your idea of window shopping?」/「...You might get cursed one day, you know?」
				表情 = 怒り
			ELSE
				台詞 = 「%TEXTR("...There's nothing shady about it, promise～/Are you really going to turn down a divine fortune?/This stuff actually works, you know?/No divine blessing～?/Mmm... Until next time, perhaps?/Well, maybe next time.")%」
				表情 = 通常
			ENDIF
			CALL SPTALK, 0, @"%表情%", 15, @"%台詞%", 1
		ENDIF
		RETURN -1
	CASE 1
		MONEY -= 3000
	CASE 2
		MONEY:2 -= 20
	CASE 3
		ITEM:131 -= 5
	CASE 4
		ガチャ回数 = 9
		MONEY -= 27000
	CASE 5
		ガチャ回数 = 9
		MONEY:2 -= 180
	CASE 6
		ガチャ回数 = 9
		ITEM:131 -= 50
ENDSELECT
IF (RESULT == 1 || RESULT == 2) && ITEM:兎符「開運大紋」
	PRINTFORML 토끼 부적 「개운대문」을 사용한다?
	CALL ASK_YN
	IF !RESULT
		ITEM:兎符「開運大紋」 --
		TFLAG:194 = 5
	ENDIF
ENDIF
$RENZOKU
IF GETBIT(FLAG:999, 3)
	IF MORIYA_BOX:0 == -1
		PRINTFORMW 현재 복권함이 비었으므로 새로운 것이 준비될 것이다.
		CALL FISHER_YATES_SHAFFLE(300)
		ARRAYCOPY "SHAFFLE_ARRAY", "MORIYA_BOX"
	ELSE
		PRINTFORML 현재 복권은 이미 대박 추첨을 했다.
		PRINTFORML 이 복권 상자를 버리고 새 것을 준비하시겠습니까?
		PRINTFORML [1] 그들에게 새 상자를 준비하게 한다
		PRINTFORML [0] 이것으로 계속 진행한다
		$LOOP_INPUT_2
		INPUT
		SELECTCASE RESULT
			CASE 0
				PRINTW 당신은 현재 상자에서 계속 뽑는다.
			CASE 1
				PRINTW 잠시만 기다려주세요... 저희가 상자를 교체해 드리겠습니다.
				CLEARBIT FLAG:999, 3
				CALL FISHER_YATES_SHAFFLE(300)
				ARRAYCOPY "SHAFFLE_ARRAY", "MORIYA_BOX"
				;qol custom code, text color
				SETCOLOR モブ子店員口上色:15
				PRINTW 「잠시만 기다려 주십시오... 상자를 교체해 드리겠습니다.」
				RESETCOLOR
			CASEELSE
				GOTO LOOP_INPUT_2
		ENDSELECT
	ENDIF
ENDIF
PRINTFORML %BREAKENG(@"봉헌함에 충분한 금액을 기부한 후, 보조에게 건네기 전에 복권 한 장을 뽑는다.")%
PRINTL ......
PRINTL ...
CALL FOTUNE_MORIYA
TIME += 2
IF ガチャ回数 > 0
	PRINTFORMW 
	ガチャ回数 --
	GOTO RENZOKU
ENDIF
SIF 顔絵付きメッセージ
	CALL SPTALK, 0, @"미소", 15, @"「정말 고마워~」", 1
RETURN 1
;守谷くじ

@COM_ABLE435
;一括管理
SIF GLOBAL_COMABLE(435)
	RETURN RESULT
SIF !TFLAG:100
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;気力0では不可
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF !MORIYA_OMIKUJI(CFLAG:MASTER:現在位置)
	RETURN 0
RETURN 1

@MORIYA_OMIKUJI(ARG)
#FUNCTION
;守矢神社の社務所
SIF ARG == GET_MAP_REPLACEMENT(813)
	RETURNF 1
SIF GETBIT(HOME_CUSTOM_ROOM(CFLAG:MASTER:300),6)
	RETURNF 1
RETURNF 0
