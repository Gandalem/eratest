@COM419
SELECTCASE CFLAG:MASTER:現在位置
	CASE 霧の湖
		;TFLAG:水汲み = 2
		VAR_WATER = 霧の湖の水
	CASE 347
		VAR_WATER = 霧の湖の水
	CASE 旧地獄温泉
		;TFLAG:水汲み = 3
		VAR_WATER = 地獄温泉の水
	CASE 934
		VAR_WATER = 地獄温泉の水
	CASE 山の湖
		VAR_WATER = 奇跡の水
	CASE 814
		VAR_WATER = 奇跡の水
		;アイテム設定有れども入手経路が思いつかないのでコメントアウト
		;CASE
		;	TFLAG:水汲み = 5
		;CASE
		;	TFLAG:水汲み = 5
		;CASE 台所
		;	TFLAG:水汲み = 6
		;CASE 11
		;	TFLAG:水汲み = 6
		;CASE 長屋街
		;	TFLAG:水汲み = 7
		;CASE 270
		;	TFLAG:水汲み = 7
	CASEELSE
		VAR_WATER = ただの水
ENDSELECT
STAIN:MASTER:0 = 0
STAIN:MASTER:1 = 0
CFLAG:MASTER:口に精液 = 0
CFLAG:MASTER:顔に精液 = 0
CFLAG:MASTER:手に精液 = 0
CFLAG:MASTER:脇に精液 = 0 ;custom code
IF TARGET
	STAIN:0 = 0
	STAIN:1 = 0
	CFLAG:口に精液 = 0
	CFLAG:顔に精液 = 0
	CFLAG:手に精液 = 0
	CFLAG:脇に精液 = 0 ;custom code
ENDIF
PRINTFORML 당신은 %VAR_WATER_TR(VAR_WATER)%를 그린다.
IF GET_MAPID(CFLAG:MASTER:現在位置) != MAIN_MAP
	PRINTFORML 이렇게 들고 다니는 것은 좀 번거로우니 집으로 돌아가는 것이 좋을지도 모른다.
	CALL 外出先から帰宅
ENDIF
TIME += 3
RETURN -1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE419
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(419)
	RETURN RESULT
SIF !水汲み可(CFLAG:MASTER:現在位置)
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
RETURN 1
