@COM_ABLE434
;一括管理
SIF GLOBAL_COMABLE(434)
	RETURN RESULT
SIF !TFLAG:100
	RETURN 0
;気力0では不可
SIF BASE:MASTER:気力 <= 0
	RETURN 0
;賽銭箱（おみくじの代金入れも兼ねている）でないと引けない
SIF !OMIKUJI_SPOT(CFLAG:MASTER:現在位置)
	RETURN 0
;SIF CFLAG:MASTER:現在位置 != P3賽銭箱 ;custom code disabled, not very necessary of a check
;RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
RETURN 1

@OMIKUJI_SPOT(ARG)
#FUNCTION
;博麗神社の賽銭箱
SIF ARG == GET_MAP_REPLACEMENT(3)
	RETURNF 1
;神社本堂
SIF NAME_FROM_PLACE(CFLAG:MASTER:現在位置, 1) == "神社本堂" ;custom code, added the visiting variant of the spot
	RETURNF 1
SIF GETBIT(HOME_CUSTOM_ROOM(CFLAG:MASTER:300),6); NAS: your home
	RETURNF 1
RETURNF 0
