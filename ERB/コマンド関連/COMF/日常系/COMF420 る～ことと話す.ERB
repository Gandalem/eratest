@COM420
PRINTL 「제가 도와드릴까요?」
PRINTL [0] - 누군가를 찾고 있어요
PRINTL [1] - 청소를 좀 하고 싶어요
PRINTL [2] - git에 대해서요
PRINTL [100] - 돌아가기
INPUT
IF RESULT == 0
	PRINTL 「누구를 찾고 있나?」
	CALL HITOSAGASI()
ELSEIF RESULT == 1
	CALL OHEYA_CHECK
ELSEIF RESULT == 2
	PRINTDATA
		DATAFORM 「git을 사용하면 어떤 패치든 즉시 병합할 수 있다!」
		DATAFORM 「git을 사용하면 모든 변경 사항을 쉽게 추적할 수 있다!」
		DATAFORM 「또한 이전 코드들을 깔끔하게 보존한다!」
		;custom code
		DATAFORM 「여러 브랜치와 머지 충돌을 흘리지 않고 추적할 수 있다!」
		DATAFORM 「버튼 클릭 한 번으로 새로운 변경 사항에 즉시 접근할 수 있게 해준다!」
	ENDDATA
	PRINTW 정말 굉장한 것 같다.
	RETURN -1
ELSEIF RESULT == 100
	RETURN -1
ELSE
	RETURN -1
ENDIF
INPUTS
RESULT = TOINT(RESULTS)
IF !ISNUMERIC(RESULTS) ;bugfix
	REPLACE RESULTS, CALLNAME:MASTER, "%CALLNAME:MASTER%"
	FOR LOCAL, MINROOM(), MAXROOM ;bugfix
	;Custom code
	SIF GET_PLACENAME(LOCAL) == RESULTS
		RESULT = LOCAL
	NEXT
ELSEIF RESULT == 0
	RESTART
ENDIF
IF !MAP_CAN_MOVE(RESULT) ;bugfix
	CALL CANNOT_MOVE_MESSAGE(RESULT)
ELSEIF IN_HOME(RESULT) == 1
	CALL SKIP_MOVE(CFLAG:MASTER:現在位置, RESULT)
ENDIF
RETURN -1

@OHEYA_CHECK
VARSET LOCAL
FOR LOCAL, MINROOM(), MAXROOM
LOCALS = %NAME_FROM_PLACE(LOCAL)%
SIF LOCALS == ""
	CONTINUE
SIF CFLAG:MASTER:現在位置 == LOCAL
	SETCOLOR C_GREEN
;	PRINTBUTTON "["+LOCALS+"]", LOCAL
;	RESETCOLOR
;	PRINTFORM %" "*(22-STRLENS(LOCALS))%
PRINTFORM [{LOCAL, 3}]%LOCALS, 42, LEFT%
PRINTFORM %"<"+SexAnywhereIndicator(LOCAL)+">",24,RIGHT%
RESETCOLOR
LOCALS = %SEIKETU(LOCAL), 29, RIGHT%
PRINTFORM %LOCALS%　　
RESETCOLOR
LOCAL:1 ++
SIF LOCAL:1 % 2 == 0
	PRINTL
NEXT
PRINTFORML 
DRAWLINE
;custom code
PRINTBUTTON "[반환]", 0

@SEIKETU(ARG)
#FUNCTIONS
IF OUTROOF(ARG) && DAY:2 == 4
	SELECTCASE YOGORE:ARG
		CASE IS < 100
			SETCOLOR C_GREEN
			RETURNF "Snow Level: Refreshing"
		CASE IS < 500
			SETCOLOR C_M_GREEN
			RETURNF "Snow Level: Low"
		CASE IS < 1000
			SETCOLOR C_P_GREEN
			RETURNF "Snow Level: Somewhat Low"
		CASE IS < 2000
			SETCOLOR 0xFFFFFF
			RETURNF "Snow Level: Medium"
		CASE IS < 3500
			SETCOLOR 0xFFFFFF
			RETURNF "Snow Level: Somewhat High"
		CASE IS < 5000
			SETCOLOR 0xFFFFFF
			RETURNF "Snow Level: High"
		CASEELSE
			SETCOLOR 0xFFFFFF
			RETURNF "Snow Level: Snow Mountain"
	ENDSELECT
ELSE
	SELECTCASE YOGORE:ARG
		CASE IS < 100
			SETCOLOR C_GREEN
			RETURNF "Cleanliness: Spotless"
		CASE IS < 500
			SETCOLOR C_M_GREEN
			RETURNF "Cleanliness: High"
		CASE IS < 1000
			SETCOLOR C_P_GREEN
			RETURNF "Cleanliness: Somewhat High"
		CASE IS < 2000
			SETCOLOR C_YELLOW
			RETURNF "Cleanliness: Medium"
		CASE IS < 3500
			SETCOLOR C_V_PINK
			RETURNF "Cleanliness: Somewhat Low"
		CASE IS < 5000
			SETCOLOR C_RED
			RETURNF "Cleanliness: Low"
		CASEELSE
			SETCOLOR C_RED
			RETURNF "Cleanliness: Garbage Mountain"
	ENDSELECT
ENDIF
;Custom Code

@HITOSAGASI(ARG, ARG:2=0)
CALL HITOSAGASI_2(1)
CALL HITOSAGASI_2(2)
;custom code
PRINTBUTTON "[반환]", 0
;Qol custom code
IF ARG:2 == 1
	PRINTL
	PRINTBUTTON "[다른 지역 확인한다.]", -1
	PRINTL
ENDIF
;ARG=何回目の表示か(1or2)

@HITOSAGASI_2(ARG)
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 0, EX_CHARANUM
SIF LOCAL:1 == MASTER
	CONTINUE
IF FLAG:並び替え
	LOCAL = RESULT:(LOCAL:1)
	SIF LOCAL < 0
		CONTINUE
ELSE
	LOCAL = LOCAL:1
	SIF LOCAL >= CHARANUM
		BREAK
ENDIF
SIF AT_HOME(LOCAL) == 0
	CONTINUE
SIF CFLAG:LOCAL:現在位置 < MINROOM()
	CONTINUE
SIF CFLAG:LOCAL:現在位置 == MAXROOM && CFLAG:LOCAL:睡眠
	CONTINUE
IF ARG == 1
	SIF !CFLAG:LOCAL:神社在住
		CONTINUE
	SETCOLOR C_S_BLUE
ELSEIF ARG == 2
	SIF CFLAG:LOCAL:神社在住
		CONTINUE
ENDIF
SIF CFLAG:LOCAL:PatrolGroup
	SETCOLOR C_L_GREEN
IF SaveIsEZB
	CALL ALTNAME_CHECK
	IF LoG_RivalWins(LoG_RivalID(LOCAL))
		SETCOLOR C_L_GREEN
	ELSEIF LoG_RivalLosses(LoG_RivalID(LOCAL))
		SETCOLOR C_PURPLE
	ENDIF
ENDIF
PRINTFORM %ALTNAME_OR_CALLNAME(LOCAL), 35, LEFT%
RESETCOLOR
LOCALS = %NAME_FROM_PLACE(CFLAG:LOCAL:現在位置)%
;	SIF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:初期位置
;		LOCALS = %CALLNAME:MASTER%私室
;	PRINTBUTTON "["+LOCALS+"]", CFLAG:LOCAL:現在位置
;	PRINTFORM %" "*(22-STRLENS(LOCALS))%
;qol custom code
SIF IN_HOME(CFLAG:LOCAL:現在位置) != 1 || MAP_CAN_MOVE(CFLAG:LOCAL:現在位置) == 0
	SETCOLOR C_GRAY
PRINTFORM [{CFLAG:LOCAL:現在位置, 3}]%LOCALS, 42, LEFT%
RESETCOLOR
IF LOCALS == ""
	PRINTFORML 알 수 없는 위치 ({CFLAG:LOCAL:現在位置})
ELSEIF IsDead:LOCAL:0
	PRINTFORML 사망했다 \@ CFLAG:LOCAL:出禁 ? (숨겨짐) #  \@
ELSEIF CFLAG:LOCAL:衰弱
	PRINTL 의식을 잃은		
	[IF_DEBUG]
ELSEIF TCVAR:LOCAL:INITIAL_VISITATION_POINT
	IF TCVAR:LOCAL:INITIAL_VISITATION_POINT < 0
		PRINTFORML %CALLNAME:(TCVAR:LOCAL:INITIAL_VISITATION_POINT * -1)%을 향해 걸어갔다.
	ELSE
		PRINTFORML %NAME_FROM_PLACE(TCVAR:LOCAL:INITIAL_VISITATION_POINT)%를 향해 가고 있다.
	ENDIF
	[ENDIF]
ELSEIF CFLAG:LOCAL:睡眠
	PRINTL 잠들어 있다
ELSEIF CFLAG:LOCAL:行動 == 5
	IF ADD_BANQUET_CHARA_STATE(LOCAL) && (CFLAG:LOCAL:職種 == JOB_宴会参加 || CFLAG:LOCAL:職種 == JOB_酔いつぶれる) ;bugfix/addition custom code
		PRINTFORML 연회에 참석한다 %ADD_BANQUET_TERM(CFLAG:LOCAL:BANQUET)%
	ELSE
		PRINTL 작동 중이다
	ENDIF
ELSEIF DT_EXIST(@"Movement_{LOCAL}")
	PRINTFORML 【%NAME_FROM_PLACE(PathEndingPlace(LOCAL))%}로 이동한다.
ELSE
	PRINTL
ENDIF
NEXT
;Qol Custom code
IF ARG:2 == 1
	PRINTL
	PRINTBUTTON "[다른 지역을 확인한다.]", -1
	PRINTL
ENDIF
PRINTL
