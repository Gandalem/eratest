;伐採する
@COM442
#DIM CHARA
#DIM 木材種
#DIM W_ID
#DIM 伐採パワー
#DIM 減少値
#DIM 伐採時間
#DIM 採集パワー
#DIM 採集物
#DIM 探索回数
#DIM nLuck ;logging tweak
nLuck = CFLAG:MASTER:今日の運勢 / 20 - 25
SIF ITEM:チェーンソー && GETBIT(nChainSawMods, ChainSaw_TreeSeeker) ;addition custom code
	nLuck += 20

;丸太を抱えてるときは薪割りするか選択　薪割りしたら体力気力消費時間経過させる
IF ITEM:丸太
	;依頼の報酬など、伐採以外で丸太を入手してしまった場合の退避用
	SIF !FLAG:丸太種類
		;とりあえずスギにしておく
		FLAG:丸太種類 = 1
	DRAWLINE
	PRINTFORML Gotta do something with the logs in possession first...
	CALL WOOD_CHOPPING(FLAG:丸太種類)
	RETURN RESULT
ENDIF
;青竹を抱えすぎてる時もリターン
IF ITEM:青竹 > 9 && FLAG:最後に材木商に訪れた日 != 0
	DRAWLINE
	PRINTFORML Gotta do something with the bamboo in possession first...
	RETURN -1
ENDIF
;夕方～夜の伐採はやめる
	;Custom code, allow night logging during Lunatic Survival.
IF TIME:2 >= 5 && !FLAG:70 && !(ITEM:チェーンソー && GETBIT(nChainSawMods, ChainSaw_Flashlight)) && !LS_RESTRICTION("Logging hours")
	DRAWLINE
	PRINTFORML If you start logging now it'll be pitch black by the time you're done...
	RETURN -1
ENDIF
;大雨、吹雪のときはやめる(天候パッチ)強風時もやめる
IF GROUPMATCH(天候, 5, 9) || GROUPMATCH(FLAG:異常気象, 9, 10) || WIND_VELOCITY >= 1
	DRAWLINE
	PRINTFORML Logging in this weather would be dangerous.
	RETURN -1
ENDIF
;あからさまな人の敷地での盗伐はやめる
IF (TCVAR:Common_Sense_Alteration_Status <= 50 && FLAG:催眠強度 <= 50) || (nReligions && GET_INT(MASTER, "Religion", TALENT:MASTER:Religion, "Cutting Trees") >= 1) ;hypnosis patch
	; SELECTCASE CFLAG:MASTER:現在位置
	; 	CASE 妖精の大樹, P25鎮守の森
	; 		IF ABL:[[霊夢]]:親密 < 5
	; 			DRAWLINE
	; 			PRINTFORML Logging here without permission feels like a bad idea.
	; 			RETURN -1
	; 		ENDIF
	; 	CASE 斜角の竹林, P433斜角の竹林
	; 		IF ABL:[[妹紅]]:親密 < 5 && ABL:[[てゐ]]:親密 < 5 && ABL:[[輝夜]]:親密 < 5 && ABL:[[永琳]]:親密 < 5
	; 			DRAWLINE
	; 			PRINTFORML Logging here without permission feels like a bad idea.
	; 			RETURN -1
	; 		ENDIF
	; 	CASE 絶景の丘, P805頂上
	; 		IF ABL:[[文]]:親密 < 5 && ABL:[[はたて]]:親密 < 5
	; 			DRAWLINE
	; 			PRINTFORML Logging here without permission feels like a bad idea.
	; 			RETURN -1
	; 		ENDIF
	; ENDSELECT
	;replaced
	CALL HAVE_PERMS(CFLAG:MASTER:300,"logging")
	SIF RESULT == -1
		RETURN -1
ENDIF

IF GET_INT(MASTER, "Religion", TALENT:MASTER:Religion, "Cutting Trees") <= -3 && nReligions
	DRAWLINE
	PRINTFORML Logging here is not allowed by your religion (%TOSTR_RELIGION(TALENT:MASTER:Religion)%: %TOSTR_PRECEPT_RANKING("Cutting Trees", GET_INT(TARGET, "MASTER", TALENT:MASTER:Religion, "Cutting Trees"), 0)%).
	RETURN -1
ENDIF

TFLAG:ムード上昇抑制 = 1

;先に伐採パワー算出
伐採パワー = 1 + (Level_TO_RANK(ABL:(MASTER):Melee) * 2) + (LEVEL_TO_RANK(TALENT:MASTER:46) * 2) + LEVEL_TO_RANK(ABL:MASTER:教養) ;custom code
;参加者判定
IF FLAG:デート相手 != MASTER && !FLAG:70
	;Group date stuff, prioritize target date instead of lastest date invite
	IF MOREDATE
		IF IS_IN_GROUP_DATE(TARGET)
			CHARA = TARGET
		ENDIF
	ELSE
		CHARA = FLAG:デート相手
	ENDIF
ELSEIF TARGET && ABL:TARGET:親密 >= 10 && SHIRAHU(TARGET) && CFLAG:TARGET:行動 != 5
	CHARA = TARGET
ELSE
	CHARA = 0
ENDIF
;参加者がいる場合は伐採パワー追加
SIF CHARA != MASTER && !FLAG:70
	伐採パワー += (LEVEL_TO_RANK(ABL:(TARGET):Melee) * 2) + (LEVEL_TO_RANK(TALENT:TARGET:46) * 2) + LEVEL_TO_RANK(ABL:TARGET:教養) ;custom code
	伐採パワー += (LEVEL_TO_RANK(ABL:(CHARA):Melee) * 2) + (LEVEL_TO_RANK(TALENT:CHARA:46) * 2) + LEVEL_TO_RANK(ABL:CHARA:教養)

伐採パワー += Add_Apply_Fairy_Title_Bonus("logging") ;addition custom code

探索回数 = 1 ;moved search counter to always count first tree

$LOOP_SELECT

木材種 = 0
W_ID = 0
減少値 = 0
伐採時間 = 0

REPEAT 5
	REUSELASTLINE  Looking for a tree to cut%COND_STR(@" with %CALLNAME:CHARA%", CHARA)%.%"." * COUNT%
	TWAIT 150, 1
REND

;伐採候補の木材種を決定
CALL WOOD_SPECIES(伐採可能(CFLAG:MASTER:現在位置), nLuck) ;logging tweak
;種類判定用に退避する
W_ID = RESULT
;★木材関連のデータを読み出し
CALL WoodData(W_ID)
;大きさを抽選 FLAG:丸太種類に流し込む数値を作る
木材種 = WOOD_SIZE(W_ID, nLuck)

;伐採候補をテキスト出力
IF W_ID == 13
	PRINTFORML You break off a twig, revealing the tree to be sweet and aromatic...
ELSEIF W_ID == 12
	PRINTFORML This bamboo looks very straight and symmetrical...
ELSE
	PRINTFORML How about this tree...
ENDIF
DRAWLINE
SETCOLOR C_YELLOW
PRINTFORM You find: 
;logging tweak
PRINTFORM %WOOD_NAME(木材種)%\@ W_ID == 12 ? # %" "%tree \@\@ FLAG_TO_LOGSIZE(木材種) > 1 ? !!! # .\@
RESETCOLOR

;体力気力の減少値と伐採にかかる時間を算出
;PRINTFORML WOOD_EFFORT(木材種, 大きさ) - {WOOD_EFFORT(木材種, 大きさ)}
;減少値 = WOOD_EFFORT(木材種, 大きさ) - (WOOD_EFFORT(木材種, 大きさ) * (伐採パワー / 70))
減少値 = MULTIPLY(WOOD_EFFORT(木材種), 100-(伐採パワー/3*2)) ;logging tweak
;PRINTFORML 減少値 = {減少値}
SIF ITEM:チェーンソー
	減少値 -= SQRT(MAX(WOOD_EFFORT(木材種), 1)) * (GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser) ? 15 # 10) ;addition custom code
;PRINTFORML Ch: 減少値 = {減少値}
減少値 = MAX(減少値, 20) ;logging tweak
IF CHARA != MASTER && !FLAG:70
	;bug fix
	伐採時間 = 減少値 / (4 + ABL:MASTER:Melee + SQRT(ABL:CHARA:Melee) + TALENT:MASTER:46 + SQRT(TALENT:CHARA:46))
ELSE
	伐採時間 = 減少値 / (4 + ABL:MASTER:Melee + TALENT:MASTER:46)
ENDIF
SIF ITEM:チェーンソー && GETBIT(nChainSawMods, ChainSaw_DualSaw) ;addition custom code, 25% reduction
	伐採時間 = MULTIPLY(伐採時間, 75)

;伐採時間に応じてテキスト出力
SETCOLOR C_L_GRAY
SELECTCASE 伐採時間
	CASE IS <= 60 
		PRINTFORML 　（Should be easy to cut.）
	CASE IS <= 120
		PRINTFORML 　（Should take a while to cut down.）
	CASE IS <= 180
		PRINTFORML 　（Not going to be easy...）
	CASE IS <= 240
		PRINTFORML 　（Gonna struggle with this one...）
	CASE IS <= 300
		PRINTFORML 　（Will require a good stance and a great deal of time...）
	CASE IS <= 360
		PRINTFORML 　（This will be a large-scale endeavor...）
	CASEELSE
		PRINTFORML 　（This is impossible with your current skill level...）
ENDSELECT
RESETCOLOR
PRINTL 
;体力・気力が実施後マイナスになる場合は、木材種選択に戻る
;logging tweak
{
	IF 
	(!FLAG:70 && 
		(BASE:MASTER:体力 <= 減少値 ||
		 BASE:MASTER:気力 <= 減少値 - (ITEM:チェーンソー ? (GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser) ? 75 # 50) # 25) )) ||
	(FLAG:70 && BASE:MASTER:TSP <= (伐採時間 * 10) + (探索回数 * 5))
}
	CALL WOOD_V_RESET
	;探索回数が10回を超えた場合は無限ループ除けのためにリターンする
	IF 探索回数 > 10
		$GIVEUP
		PRINTFORMW ...You lose your enthusiasm and decide to stop for now.
		IF !FLAG:70
			TIME += 探索回数 * 5
		ELSE
			BASE:MASTER:TSP -= 探索回数 * 5
		ENDIF
		RETURN 1 ;tweaked to show time spent
	ELSE
		PRINTFORML Considering your condition, cutting this one down would be a bad idea... Pick another.
		;moved search counter
		CALL ASK_YN("Proceed", "Stop") ;logging tweak
		SIF RESULT
			GOTO GIVEUP
		PRINTL 
		CALL WOOD_V_RESET
		GOTO LOOP_SELECT
	ENDIF
ENDIF
PRINTFORML Cut down this one?
CALL ASK_M("Yes", 1, "No", 1, "Stop", 1)
IF !RESULT
	CLEARLINE 5
ELSEIF RESULT == 1
	CLEARLINE 9
	探索回数 ++
	CALL WOOD_V_RESET
	;探索回数が10回を超えた場合は無限ループ除けのためにリターンする
	IF 探索回数 > 10
		PRINTFORMW ...You have a feeling that you might get lost if you get too enthusiastic about it, so you decide to leave it at that for the time being.
		IF !FLAG:70
			TIME += 探索回数 * 5
		ELSE
			BASE:MASTER:TSP -= 探索回数 * 5
		ENDIF
		RETURN 1 ;tweaked to show time spent
	ENDIF
	GOTO LOOP_SELECT
ELSE
	GOTO GIVEUP
ENDIF
CALL DQPRINT(@"You cut down some \@ W_ID == 12 ? bamboo # trees\@ー", 1)
CALL DQPRINT("Hei Hei Hoー", 1)
CALL DQPRINT("Hei Hei Hoー", 1)
SIF 伐採時間 >= 540
	CALL DQPRINT("...........................", 1)
SIF 伐採時間 >= 480
	CALL DQPRINT("........................", 1)
SIF 伐採時間 >= 420
	CALL DQPRINT(".....................", 1)
SIF 伐採時間 >= 360
	CALL DQPRINT("..................", 1)
SIF 伐採時間 >= 300
	CALL DQPRINT("...............", 1)
SIF 伐採時間 >= 240
	CALL DQPRINT("............", 1)
CALL DQPRINT(".........", 1)
CALL DQPRINT("......", 1)

;NAS: Religion
CALL CharacterSinned(MASTER,"Cutting Trees",@"cut down a tree", -3, -1)

;時間経過と体力消費
IF FLAG:70
	BASE:MASTER:TSP -= (伐採時間 * 10) + (探索回数 * 5)
ELSE
	DOWNBASE:MASTER:体力 = 減少値
	DOWNBASE:MASTER:気力 = 減少値
	IF ITEM:チェーンソー && GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser)
		PRINTFORML Your water dispenser helped you recover quicker!
		CALL RECOVER_PERMIL(MASTER, 伐採時間, "体力", 1, "Refreshing water") ;water recovery tweak
		CALL RECOVER_PERMIL(MASTER, 伐採時間, "気力", 1, "Refreshing water")
	ENDIF
	TIME += 伐採時間 + (探索回数 * 10)
	;logging tweak
	IF PERCENT(nLuck)
		LOCAL:0 = RAND:5 + RAND:5 + RAND:3
		LOCAL:1 = RAND:5 + RAND:5 + RAND:3
		MAXBASE:MASTER:体力 += LOCAL:0
		MAXBASE:MASTER:気力 += LOCAL:1
		SIF LOCAL:0 + LOCAL:1
			PRINTFORMW After getting a good workout from chopping trees, you feel like you became a little tougher...
	ENDIF
ENDIF

;経験追加処理
EXP:(MASTER):Melee += MAX((伐採時間 / 20), 1)
EXP:(MASTER):86 += MAX((伐採時間 / 20), 1)
;試行回数が少ないだろうから確定
IF ITEM:木こりの心得
	EXP:MASTER:伐採経験 += MAX((伐採時間 / 20), 1)
	EXP:(MASTER):Melee ++
	EXP:(MASTER):86 ++	
ENDIF
CALL LS_BOOK_BONUS(110) ;Custom code, add experience during Lunatic Survival.
;大きさ補正
IF 木材種 > 100
	EXP:MASTER:伐採経験 += FLAG_TO_LOGSIZE(木材種) * 4
	EXP:(MASTER):86 += (FLAG_TO_LOGSIZE(木材種) * 4)
ENDIF
;手伝ってくれたキャラの経験
IF CHARA != MASTER
	EXP:(CHARA):Melee += MAX((伐採時間 / 20), 1)
	IF 木材種 > 100
		EXP:CHARA:伐採経験 += FLAG_TO_LOGSIZE(木材種) * 4
		EXP:(CHARA):86 += (FLAG_TO_LOGSIZE(木材種) * 4)
	ENDIF
ENDIF

;デート経験
IF CHK_DATENOW(CFLAG:CHARA:デート中) && CHARA > 0
	EXP:MASTER:デート経験 ++
	EXP:CHARA:デート経験 ++
ENDIF
SIF ITEM:チェーンソー
	PRINTFORML Your chainsaw makes a high-pitched buzzing sound as you cut the \@ W_ID == 12 ? bamboo # tree \@...
PRINTFORML With the use of time stopping powers, it's dried instantly!
;アイテム入手処理
SELECTCASE 木材種
	CASE 12, 13
		CALL GET_ITEM(ITEMNAME:WoodItem, 1, 2)
	CASEELSE
		ITEM:丸太 ++
		FLAG:丸太種類 = 木材種
		SETCOLOR 0x00FF00
		PRINTFORMW You get %WOOD_NAME(FLAG:丸太種類)%.
		RESETCOLOR
ENDSELECT
DRAWLINE
PRINTFORML 　%WoodIntro1%
PRINTFORML 　%WoodIntro2%
PRINTW 

;デバッグ用
IF FLAG:丸太種類
	DEBUGPRINTFORML 　　Wood Check：%WOOD_NAME(FLAG:丸太種類)%
ENDIF
PRINTL 

;薪割り確認 薪割り時間・体力消費はサービス
IF FLAG:丸太種類
	CALL WOOD_CHOPPING(FLAG:丸太種類, 1)
ENDIF

;オマケ採集物  採集Lvに依存  あくまでおまけなので控えめに
採集パワー = 1 + TALENT:MASTER:採集Lv * 10 + ABL:MASTER:教養 * 5 + TFLAG:幸運補正 * 5 + nLuck ;logging tweak
SIF CHARA && !FLAG:70
	採集パワー += (1 + TALENT:CHARA:採集Lv * 10 + ABL:CHARA:教養 * 5) / 2

CALL WOODMAN_PRESENT(採集パワー)
採集物 = RESULT
IF 採集物
	CALL GET_ITEM(ITEMNAME:採集物, 1, 2)
	EXP:MASTER:採集経験 ++
	SIF CHARA 
		EXP:CHARA:採集経験 ++
ENDIF

;空腹時刻と参加者の疲労度
SIF !FLAG:70 ;bugfix
	TCVAR:MASTER:空腹時刻 -= 25
IF CHARA
	TCVAR:CHARA:空腹時刻 -= 25
	CALL ADD_TIRED(CHARA, POWER((FLAG_TO_LOGSIZE(木材種) + 1) + 1, 3) * 100)
ENDIF

;参加者のソース
IF CHARA > 0
	;固定で獲得するソース
	SOURCE:CHARA:歓楽 = 500
	SOURCE:CHARA:情愛 = 50
	
	TFLAG:信頼度管理 += 3
	
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:CHARA:歓楽 += (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += (ABL:親密 * 20)
	ELSEIF ABL:従順 <= 3
		SOURCE:CHARA:歓楽 += 300 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 100 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 5
		SOURCE:CHARA:歓楽 += 600 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 300 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 8
		SOURCE:CHARA:歓楽 += 850 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 500 + (ABL:親密 * 40)
	ELSEIF ABL:従順 <= 11
		SOURCE:CHARA:歓楽 += 1200 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 700 + (ABL:親密 * 40)
	ELSE
		SOURCE:CHARA:歓楽 += 2500 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 1200 + (ABL:親密 * 20)
	ENDIF
	SIF CHARA != FLAG:デート相手 
		SOURCE:CHARA:情愛 = 0
	
	;好感度はみない
	
	SOURCE:CHARA:受動 = 200 + 100 * ABL:従順
	SOURCE:CHARA:征服 = 200 + 100 * ABL:サドっ気
	SOURCE:CHARA:達成 = 150 * (FLAG_TO_LOGSIZE(木材種) + 1)

	SELECTCASE FLAG_TO_LOGSIZE(木材種)
		CASE 0
			TIMES SOURCE:CHARA:歓楽 , 1.00
			TIMES SOURCE:CHARA:受動 , 1.00
			TIMES SOURCE:CHARA:征服 , 1.00
			SOURCE:CHARA:達成 = 120
		CASE 1
			TIMES SOURCE:CHARA:歓楽 , 2.00
			TIMES SOURCE:CHARA:受動 , 2.00
			TIMES SOURCE:CHARA:征服 , 1.75
			SOURCE:CHARA:達成 = 240
		CASE 2
			TIMES SOURCE:CHARA:歓楽 , 3.00
			TIMES SOURCE:CHARA:受動 , 3.00
			TIMES SOURCE:CHARA:征服 , 2.50
			SOURCE:CHARA:達成 = 360
		;logging tweak
		CASE 3
			TIMES SOURCE:CHARA:歓楽 , 4.00
			TIMES SOURCE:CHARA:受動 , 4.00
			TIMES SOURCE:CHARA:征服 , 3.25
			SOURCE:CHARA:達成 = 480
		CASE 4
			TIMES SOURCE:CHARA:歓楽 , 5.00
			TIMES SOURCE:CHARA:受動 , 5.00
			TIMES SOURCE:CHARA:征服 , 4.00
			SOURCE:CHARA:達成 = 600
	ENDSELECT
ENDIF
;樹木関連の変数をリセット
CALL WOOD_V_RESET

RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;伐採する
@COM_ABLE442
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(442)
	RETURN RESULT
SIF CFLAG:うふふ
	RETURN 0
;伐採可能場所でのみ
SIF !伐採可能(CFLAG:MASTER:現在位置)
	RETURN 0
;デート中はデート相手とだけ
SIF FLAG:デート相手 && ((!MOREDATE && TARGET != FLAG:デート相手) || (MOREDATE && !IS_IN_GROUP_DATE(TARGET)))
	RETURN 0
;睡眠中
SIF CFLAG:MASTER:睡眠 || CFLAG:MASTER:イタズラ ;custom code
	RETURN 0
;体力・気力不足
SIF BASE:MASTER:気力 < 800 || BASE:MASTER:体力 < 800
	RETURN 0
;TSP不足
SIF FLAG:70 && BASE:MASTER:TSP < 700
	RETURN 0
RETURN 1

;-----------------------------------------------------------
;現在位置から伐採スポットを割り出す関数
;-----------------------------------------------------------
@伐採可能(ARG)
#FUNCTION
IF !IN_HOME(ARG)
	SELECTCASE ARG
		CASE 妖精の大樹
			RETURNF 1
		CASE 斜角の竹林
			RETURNF 2
		CASE 森の入り口
			RETURNF 3
		CASE 森の深奥
			RETURNF 4
		CASE 絶景の丘
			RETURNF 5
	ENDSELECT
ELSE
	SELECTCASE ARG
		CASE P25鎮守の森
			RETURNF 1
		CASE P433斜角の竹林
			RETURNF 2
		CASE P507キノコ群生地
			RETURNF 3
		CASE P738森の深奥
			RETURNF 4
		CASE P805頂上
			RETURNF 5
	ENDSELECT
ENDIF
RETURNF 0

;-----------------------------------------------------------
;伐採スポットから伐れる木材種を割り出す関数
;-----------------------------------------------------------
@WOOD_SPECIES(伐採可能, nLuck) ;logging tweak
#DIM 伐採可能
#DIM W_ID
#DIM nLuck

$LOOP

W_ID = 1 + RAND:20 ;logging tweak, lower the rand size since there aren't many trees right now (was RAND:49)
SIF PERCENT(nLuck + TFLAG:幸運補正) ;logging tweak
	W_ID = TOINT(SPLIT_G("2:6:7:7:8:9:13:13"))
;変数を読み込み
CALL WoodData(W_ID)

;無名（未登録）ならリターン
SIF WoodName == ""
	GOTO LOOP
SIF WoodValue_Log == 0
	GOTO LOOP
;[希少]は１／２で再抽選に
SIF STRCOUNT(WoodTribe, "希少/") && !PERCENT(nLuck + TFLAG:幸運補正) ;logging tweak
	GOTO LOOP
SELECTCASE 伐採可能
	CASE 1;鎮守の森、妖精の大樹
		SIF STRCOUNT(WoodTribe, "博/")
			RETURN W_ID
	CASE 2;斜角の竹林
		SIF STRCOUNT(WoodTribe, "竹/")
			RETURN W_ID
	CASE 3;魔法の森、キノコ群生地
		SIF STRCOUNT(WoodTribe, "魔/")
			RETURN W_ID
	CASE 4;森の深奥
		SIF STRCOUNT(WoodTribe, "深/")
			RETURN W_ID
	CASE 5;絶景の丘、山頂
		SIF STRCOUNT(WoodTribe, "山/")
			RETURN W_ID
	CASEELSE
		;エラーによる無限ループ除け
		RETURN W_ID
ENDSELECT
;樹木関連の変数をリセット
CALL WOOD_V_RESET

GOTO LOOP

;-----------------------------------------------------------
;木材種のサイズを抽選する
;-----------------------------------------------------------
@WOOD_SIZE(W_ID, nLuck) ;logging tweak
#FUNCTION
#DIM W_ID
#DIM SIZE
#DIM nLuck

SIZE = W_ID

SIF STRCOUNT(WoodTribe, "サイズ無視/")
	RETURNF W_ID
;logging tweak
IF PERCENT(20 + nLuck)
	SIZE += 100
	SIF PERCENT(33 + nLuck)
		SIZE += 100
	SIF PERCENT(5 + nLuck)
		SIZE += 100
	SIF PERCENT(1 + nLuck)
		SIZE += 100
ENDIF
RETURNF SIZE

;-----------------------------------------------------------
;丸太・青竹の名称を装飾名も含めて返す関数
;FLAG_L …FLAG:丸太種類　（木材種番号でも通る）
;TEXT =1 「の大木・の巨木」を文字列に反映しない
;      省略した場合は =0 (巨木・大木表示あり)
;RETURNF 1～ 普通の木 100～ 〇〇の大木 200～ 〇〇の巨木
;-----------------------------------------------------------
@WOOD_NAME(FLAG_L, TEXT = 0)
#FUNCTIONS
#DIM FLAG_L
#DIM TEXT
#DIM 番号
#DIMS 名前

SELECTCASE FLAG_L
	CASE 101 TO 199
		番号 = FLAG_L - 100
	CASE 201 TO 299
		番号 = FLAG_L - 200
	;logging tweak
	CASE 301 TO 399
		番号 = FLAG_L - 300
	CASE 401 TO 499
		番号 = FLAG_L - 400
	CASEELSE
		番号 = FLAG_L
ENDSELECT


SELECTCASE 番号
	CASE 1 TO 11
		名前 = %WoodName%
	CASEELSE
		名前 = %WoodName%
		RETURNF 名前
ENDSELECT

IF TEXT == 0
	SELECTCASE FLAG_L
		CASE 101 TO 199
			名前 += " (Large)"
		CASE 201 TO 299
			名前 += " (Gigantic)"
		CASE 301 TO 399 ;logging tweak
			名前 += " (Colossal)"
		CASE 401 TO 499 ;logging tweak
			名前 += " (Epic)"
	ENDSELECT
ENDIF
RETURNF 名前
;-----------------------------------------------------------
;木材種から大きさを判定する
;-----------------------------------------------------------
@FLAG_TO_LOGSIZE(FLAG_L)
#FUNCTION
#DIM FLAG_L

SELECTCASE FLAG_L
	CASE 101 TO 199
		RETURNF 1
	CASE 201 TO 299
		RETURNF 2
	CASE 301 TO 399 ;logging tweak
		RETURNF 3
	CASE 401 TO 499 ;logging tweak
		RETURNF 4
	CASEELSE
		RETURNF 0
ENDSELECT

;-------------------------------------------------
;FLAG:丸太種類から、巨木・大木を無視して木材種番号を取り出す関数
;FLAG_L…FLAG:丸太種類
;-------------------------------------------------
@WOOD_NUM(FLAG_L)
#FUNCTION
#DIM FLAG_L

;logging tweak
WHILE FLAG_L > 100
	FLAG_L -= 100
WEND

RETURNF FLAG_L

;-----------------------------------------------------------
;丸太・青竹の伐採にかかる体力・気力を返す関数
;-----------------------------------------------------------
@WOOD_EFFORT(木材種, nChainsawBonus) ;logging tweak
#FUNCTION
#DIM 木材種
#DIM 消費
#DIM nChainsawBonus

消費 = WoodEffort
SELECTCASE 木材種
	CASE IS > 100;大木
		消費 += 700
	CASE IS > 200;巨木
		消費 += 1000
	CASE IS > 300 ;logging tweak
		消費 += 1500
	CASE IS > 400 ;logging tweak
		消費 += 1800
ENDSELECT

IF ITEM:チェーンソー && GETBIT(nChainSawMods, ChainSaw_KickBack) && nChainsawBonus ;logging tweak
	消費 = MULTIPLY(WoodEffort, 75)
	SIF 消費 >= 1000
		消費 /= 2
ENDIF

RETURNF 消費

;-----------------------------------------------------------
;樹木関連の変数のリセット
;-----------------------------------------------------------
@WOOD_V_RESET

VARSET WoodName
VARSET WoodValue_Log
VARSET WoodValue_Plank
VARSET WoodEffort
VARSET WoodIntro1
VARSET WoodIntro2
VARSET WoodTribe
VARSET WoodItem

;-----------------------------------------------------------
;薪割りをするかどうかを確認して、木材を入手する
;丸太を割る場合は体力・気力消費と時間の経過は別に記述をすること
;FLAG_L FLAG:丸太種類　で丸太の薪割を行う
;		省略時は=0  一般薪割・丸太無しでも可能
;PHASE: 0= 体力気力時間消費あり  1= 消費なし
;-----------------------------------------------------------
@WOOD_CHOPPING(FLAG_L = 0, PHASE = 0)
#DIM FLAG_L
#DIM PHASE
#DIM FireWood
#DIM 伐採パワー
#DIM 減少値
#DIM 伐採時間
#DIM nLuck ;logging tweak
nLuck = CFLAG:MASTER:今日の運勢 / 20 - 25
SIF ITEM:チェーンソー && GETBIT(nChainSawMods, ChainSaw_TreeSeeker) ;addition custom code
	nLuck += 20

IF FLAG_L
	PRINTFORM Split the log and chop it into timber on the spot?
	;マツは木材数ボーナス
	IF WOOD_NUM(FLAG:丸太種類) == 3
		FireWood = 7
	ELSE
		FireWood = 4
	ENDIF
	SELECTCASE FLAG_L
		CASE IS > 200
			FireWood += 8
		CASE IS > 100
			FireWood += 4
	ENDSELECT
ELSE
	;一般薪割りの場合
	PRINTFORM Chop wood into timber?
	FireWood = 3
ENDIF

SETCOLOR C_GRAY
IF (ITEM:木材 + FireWood) > 99
	CALL COLORMESSAGE(@"　（There's too much timber for you to hold...）",C_GRAY,2)
ELSE
	PRINTW 
ENDIF
RESETCOLOR
SETCOLOR C_RED
SIF FLAG_L
	CALL COLORMESSAGE(@"　（Note: Once logs are chopped, they cannot be cut into lumber!）",C_RED,1)
RESETCOLOR
CALL ASK_YN
IF !RESULT
	PRINTFORMW You chop the logs.
	;丸太を割った場合は丸太情報を削除
	IF FLAG_L
		ITEM:丸太 = 0
		FLAG:丸太種類 = 0
	ENDIF
	
	;消費ありの場合
	IF PHASE == 0
		伐採パワー = (ABL:(MASTER):Melee * 10) + (TALENT:MASTER:48 * 10)
		減少値 = 350 - 伐採パワー
		伐採時間 = 180 - 伐採パワー
		IF ITEM:チェーンソー
			減少値 /= 2
			伐採時間 /= 2
			;logging tweak, addition custom code
			IF GETBIT(nChainSawMods, ChainSaw_DualSaw)
				減少値 = MULTIPLY(減少値, 75)
				伐採時間 = MULTIPLY(伐採時間, 75)
			ENDIF
		ENDIF
		IF FLAG:70
			BASE:MASTER:TSP -= 減少値
		ELSE
			DOWNBASE:MASTER:体力 += 減少値 ;tweaked to stack with chopping cost
			IF ITEM:チェーンソー
				;added line
				PRINTFORML Your water dispenser helped you recover quicker!
				DOWNBASE:MASTER:気力 += 減少値 - (GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser) ? 75 # 50)
			ELSE
				DOWNBASE:MASTER:気力 += 減少値 - 25
			ENDIF
			TIME += 伐採時間
			;logging tweak
			IF PERCENT(nLuck)
				LOCAL:0 = RAND:5 + RAND:5 + RAND:3
				LOCAL:1 = RAND:5 + RAND:5 + RAND:3
				MAXBASE:MASTER:体力 += LOCAL:0
				MAXBASE:MASTER:気力 += LOCAL:1
				SIF LOCAL:0 + LOCAL:1
					PRINTFORMW After getting a good workout from cutting logs, you feel like you became a little tougher...
			ENDIF
		ENDIF
	ENDIF
	;木材数の増加処理
	CALL GET_ITEM("木材", FireWood, 2)
	RETURN 1
ELSE
	IF FLAG_L
		CLEARLINE 5
		SIF LS_RESTRICTION("Logging advice print") ;Custom code, restrict the following print during Lunatic Survival.
			RETURN -1
		PRINTFORMW Take the intact logs to the lumber dealer in the Village, or to the sawmill on the Mountain...
	ENDIF
	RETURN -1
ENDIF
PRINTL 

;-----------------------------------------------------------
;伐採用おまけ抽選
;-----------------------------------------------------------
@WOODMAN_PRESENT(採集パワー)
#DIM 採集パワー
#DIM 採集物

採集物 = 0
採集パワー = MAX(採集パワー, 1) ;logging tweak
SELECTCASE RAND:(1 + 2 * SQRT(採集パワー))
	CASE 0 TO 6
		;失敗
	CASE 7, 9, 11, 13, 15, 17, 19, 21, 23
		IF 伐採可能(CFLAG:MASTER:現在位置) == 2
			;竹林では何も手に入らない
		ELSEIF DAY:2 == 1 || DAY:2 == 2;春夏
			SELECTCASE RAND:3;キイチゴ、はちみつ、梅 ;Custom code
				CASE 0
					採集物 = GETNUM(ITEM, "キイチゴ") ;logging tweak
				CASE 1
					採集物 = GETNUM(ITEM, "はちみつ") ;logging tweak
				CASEELSE
					採集物 = GETNUM(ITEM, "梅") ;logging tweak
			ENDSELECT
		ELSEIF DAY:2 == 3;秋
			;logging tweak
			SELECTCASE RAND:4;キイチゴ、アケビ、ヤマブドウ、りんご
				CASE 0
					採集物 = GETNUM(ITEM, "ヤマブドウ") ;logging tweak
				CASE 1
					採集物 = GETNUM(ITEM, "キイチゴ") ;logging tweak
				CASE 2
					採集物 = GETNUM(ITEM, "りんご") ;Custom code
				CASEELSE
					採集物 = GETNUM(ITEM, "アケビ") ;logging tweak
			ENDSELECT
		ELSE
			;冬 かびたブドウ
			採集物 = GETNUM(ITEM, "かびたブドウ") ;logging tweak
		ENDIF
		SIF 採集物
			PRINTFORMW You find something growing on the wood...
	CASEELSE
		IF 伐採可能(CFLAG:MASTER:現在位置) == 2;春の竹林ではタケノコ
			SIF DAY:2 == 1
				採集物 = GETNUM(ITEM, "たけのこ") ;logging tweak
		ELSEIF DAY:2 == 1 || DAY:2 == 3;春秋
			SELECTCASE RAND:3;普通のキノコか山菜
				CASE 0
					採集物 = GETNUM(ITEM, "普通のキノコ") ;logging tweak
				CASE 1
					採集物 = GETNUM(ITEM, "草木灰") ;logging tweak, added
				CASEELSE
					採集物 = GETNUM(ITEM, "山菜") ;logging tweak
			ENDSELECT
		ELSEIF DAY:2 == 2;夏
			採集物 = RAND:2 ? GETNUM(ITEM, "普通のキノコ") # GETNUM(ITEM, "草木灰") ;普通のキノコのみ or ash logging tweak
		ELSE
			SIF RAND:2 == 0;冬は50％の確率で氷の鱗
				採集物 = GETNUM(ITEM, "氷の鱗")
		ENDIF
		SIF 採集物
			PRINTFORMW You find something on the ground...
ENDSELECT
RETURN 採集物
