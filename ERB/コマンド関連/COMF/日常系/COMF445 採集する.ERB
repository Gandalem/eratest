; Modular ERB: COMF/日常系/COMF445 採集する.ERB
;採集する

@COM445
#DIM 採集物
#DIM 採集パワー
#DIM 採集パワーM
#DIM 採集パワーT
#DIM 土地の恵み
#DIM CHARA
#DIM 採集位置
;あからさまな人の敷地での無断採集はやめる、弾幕勝負で勝ってれば腕づくで
IF !QOL_PERMISSION(CFLAG:MASTER:現在位置, "foraging") ;qol custom code
	DRAWLINE
	SELECTCASE CFLAG:MASTER:現在位置
		CASE GET_MAP_REPLACEMENT(P438太陽の畑)
			PRINTFORML 허가 없이 여기서 채집하는 것은 매우 위험하게 느껴진다...
		CASE GET_MAP_REPLACEMENT(P833桃園)
			PRINTFORML 허가 없이 여기서 채집하는 건 안 좋은 생각인 것 같다...
		CASE GET_MAP_REPLACEMENT(P855虹龍洞)
			PRINTFORML 허가 없이 여기서 채집한다는 생각이 당신을 두렵게 만든다...
	ENDSELECT
	RETURN -1
ENDIF
採集物 = 0
採集パワーM = 0
採集パワーT = 0
LOCAL:4 = 0
;参加者判定
IF FLAG:デート相手 != MASTER && !FLAG:70
	;Group date stuff, prioritize target date instead of lastest date invite
	IF MOREDATE
		IF IS_IN_GROUP_DATE(TARGET)
			CHARA = TARGET
		ENDIF
	ELSE
		CHARA = FLAG:デート相手
	ENDIF
ELSEIF TARGET && ABL:TARGET:親密 >= 5 - TALENT:TARGET:採集Lv && SHIRAHU(TARGET) && CFLAG:TARGET:行動 != 5 ;com custom code
	CHARA = TARGET
ELSE
	CHARA = MASTER
ENDIF
;土地の恵み。日替わりで-25～+25の間をランダムで浮動。釣りを参考に。
土地の恵み = CFLAG:MASTER:今日の運勢 / 20 - 25
SIF ITEM:三粒の天滴
	土地の恵み += 5
;採集パワー設定
採集パワーM = 10 + TALENT:MASTER:採集Lv * 10 + ABL:MASTER:教養 * 5 + TFLAG:幸運補正 * 10
SIF ITEM:108
	採集パワーM += 10
SIF CHARA != MASTER && !FLAG:70
	採集パワーT = 10 + TALENT:CHARA:採集Lv * 10 + ABL:CHARA:教養 * 5
;参加者で最もパワーが高いものを基準に、1/2したもう１人のパワーを足す
IF 採集パワーM >= 採集パワーT
	採集パワー = 採集パワーM + (採集パワーT / 2)
ELSE
	採集パワー = 採集パワーT + (採集パワーM / 2)
ENDIF
採集パワー += Add_Apply_Fairy_Title_Bonus("foraging") ;addition custom code
採集位置 = GATHERING_SPOT(CFLAG:MASTER:現在位置)
NOSKIP ;addition custom code
REPEAT 5
REUSELASTLINE  Gathering%COND_STR(@" %CALLNAME:CHARA%과 함께", CHARA != MASTER)%.%"." * COUNT%
TWAIT 150, 1
REND
;デバッグ用
;PRINTFORML 採集位置{採集位置}
;PRINTFORML 採集パワー{採集パワー}
$TREASURSARCH
CALL Gathering_Drawing(採集位置, 採集パワー, 土地の恵み)
採集物 = RESULT:0
TFLAG:194 = RESULT:1
VARSET RESULT
;試行回数を１回増やす
LOCAL:4 ++
;採集物が気に入らない場合は引き直し
IF 採集物 != 0
	IF !FLAG:採集再抽選
		CLEARLINE 3
	ELSE
		PRINTFORM 당신은 발견한다
		SETCOLOR 0x00FF00
		PRINTFORM  %ITEMNAME_TR(採集物)%
		RESETCOLOR
		PRINTFORML 그것을 채집할까? (현재 소지품에 {ITEM:(採集物)}가 있다)
		CALL ASK_YN("채집한다","계속 찾아라")
		IF !RESULT
			CLEARLINE 4
		ELSE
			CLEARLINE 4
			採集物 = 0
			TFLAG:194 = 0
			REPEAT 5
			REUSELASTLINE  Gathering%COND_STR(@" %CALLNAME:CHARA%과 함께", CHARA != MASTER)%.%"." * COUNT%
			TWAIT 150, 1
			REND
		ENDIF
	ENDIF
ENDIF
;試行回数３回以下で採集物が確保されていない場合はループ
SIF LOCAL:4 <= 3 && 採集物 == 0
	GOTO TREASURSARCH
;アイテム入手処理 99個以上にならないようにする
IF 採集物 != 0
	SELECTCASE 採集物
		CASE 4000 TO 4499
			CALL GET_WEAPON(採集物-3000, TFLAG:194 , 2)
		CASE 3000 TO 3999
			CALL GET_WEAPON(採集物-3000, TFLAG:194 , 2)
		CASEELSE
			LOCALS = %ITEMNAME:採集物%
			CALL GET_ITEM(LOCALS, TFLAG:194 , 2)
	ENDSELECT
ENDIF
ENDNOSKIP ;addition custom code
;基本の経験
EXP:MASTER:採集経験 ++
SIF !採集物
	EXP:MASTER:採集経験 += 2
SIF CHARA != MASTER
	EXP:CHARA:採集経験 ++
SIF ITEM:108 && !RAND:2
	EXP:MASTER:採集経験 ++
CALL LS_BOOK_BONUS(108) ;Custom code, add experience during Lunatic Survival.
SIF ABL:MASTER:教養 <= 2
	EXP:MASTER:学習経験 ++
;能力差で教えてもらう・教えてあげる
IF 採集パワーM >= 採集パワーT && CHARA != MASTER
	EXP:CHARA:採集経験 ++
ELSEIF CHARA != MASTER
	EXP:MASTER:採集経験 ++
ENDIF
;デート経験
IF CHK_DATENOW(CFLAG:CHARA:デート中) && CHARA != MASTER
	EXP:MASTER:デート経験 ++
	EXP:CHARA:デート経験 ++
ENDIF
;時間停止時はTSP減
IF FLAG:70
	;虹龍洞は採掘困難
	;custom code, halve the penalty if the player has the Oxygen Mask and eliminate it if they have the Sky-Blue Magatama or aren't human
	IF 採集位置 == 68
		IF IS_NONHUMAN(MASTER) || ITEM:空色の勾玉
			GOTO TSP_FORAGING_PENALTY
		ELSEIF ITEM:酸素マスク
			BASE:MASTER:TSP -= 205
		ELSE
			BASE:MASTER:TSP -= 290
		ENDIF
	ELSE
		$TSP_FORAGING_PENALTY
		BASE:MASTER:TSP -= 120
	ENDIF
	BASE:MASTER:TSP = MAX(BASE:MASTER:TSP, 0)
ELSE
	;com stuff custom code
	LOCAL = 240 / (4 + TALENT:MASTER:採集Lv + (CHARA ? SQRT(TALENT:CHARA:採集Lv) # 0 ) )
	;時間経過
	TIME += LOCAL
	;虹龍洞は空気が薄い（無い）ので体力を余計に消耗する　ITEM:空色の勾玉の実装が待たれる
	;custom code, halve the penalty if the player has the Oxygen Mask and eliminate it if they have the Sky-Blue Magatama or aren't human
	IF 採集位置 == 68
		IF IS_NONHUMAN(MASTER) || ITEM:空色の勾玉
			GOTO TIME_FORAGING_PENALTY
		ELSEIF ITEM:酸素マスク
			DOWNBASE:MASTER:体力 = 240 - (ABL:MASTER:戦闘能力 * 10)
			DOWNBASE:MASTER:気力 = 220
			PRINTFORML 이 산소통들을 등에 메고 움직이기가 힘들다...
		ELSE
			DOWNBASE:MASTER:体力 = 320 - (ABL:MASTER:戦闘能力 * 10)
			DOWNBASE:MASTER:気力 = 280
			PRINTFORML 광산 안은 숨쉬기 정말 힘들었고, 당신을 상당히 지치게 했다.
		ENDIF
	ELSE
		$TIME_FORAGING_PENALTY
		;体力減少は戦闘能力によって減少抑制
		DOWNBASE:MASTER:体力 = 180 - (ABL:MASTER:Melee * 15)
		DOWNBASE:MASTER:気力 = 150
	ENDIF
ENDIF
;参加者のソース,同一コマンド制限を受けないので控えめに,見つからないと半減
IF CHARA > 0
	;固定で獲得するソース
	SOURCE:CHARA:歓楽 = 300
	SOURCE:CHARA:情愛 = 50
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:CHARA:歓楽 += (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += (ABL:親密 * 20)
	ELSEIF ABL:従順 <= 3
		SOURCE:CHARA:歓楽 += 200 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 50 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 5
		SOURCE:CHARA:歓楽 += 500 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 200 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 8
		SOURCE:CHARA:歓楽 += 750 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 300 + (ABL:親密 * 40)
	ELSEIF ABL:従順 <= 11
		SOURCE:CHARA:歓楽 += 1000 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 600 + (ABL:親密 * 40)
	ELSE
		SOURCE:CHARA:歓楽 += 1600 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 1000 + (ABL:親密 * 20)
	ENDIF
	SIF (!MOREDATE && CHARA != FLAG:デート相手) || (MOREDATE && !IS_IN_GROUP_DATE(CHARA))
		SOURCE:CHARA:情愛 = 0
	;好感度はみない
	SOURCE:CHARA:受動 = 200 + 100 * ABL:CHARA:従順
	SOURCE:CHARA:征服 = 200 + 100 * ABL:CHARA:サドっ気
	;採集成果をみる、アイテム価格に応じてとりあえず設定
	IF 採集物
		SELECTCASE ITEMPRICE:(採集物)
			CASE 1 TO 499
				TIMES SOURCE:CHARA:歓楽 , 1.00
				TIMES SOURCE:CHARA:受動 , 1.00
				TIMES SOURCE:CHARA:征服 , 1.00
				SOURCE:CHARA:達成 = 80
			CASE 500 TO 999
				TIMES SOURCE:CHARA:歓楽 , 1.10
				TIMES SOURCE:CHARA:受動 , 1.10
				TIMES SOURCE:CHARA:征服 , 1.10
				SOURCE:CHARA:達成 = 115
			CASE 1000 TO 2999
				TIMES SOURCE:CHARA:歓楽 , 1.25
				TIMES SOURCE:CHARA:受動 , 1.25
				TIMES SOURCE:CHARA:征服 , 1.15
				SOURCE:CHARA:達成 = 125
			CASE 3000 TO 5999
				TIMES SOURCE:CHARA:歓楽 , 1.50
				TIMES SOURCE:CHARA:受動 , 1.50
				TIMES SOURCE:CHARA:征服 , 1.25
				SOURCE:CHARA:達成 = 150
			CASE 6000 TO 9999
				TIMES SOURCE:CHARA:歓楽 , 1.75
				TIMES SOURCE:CHARA:受動 , 1.75
				TIMES SOURCE:CHARA:征服 , 1.50
				SOURCE:CHARA:達成 = 200
			CASE 10000 TO 14999
				TIMES SOURCE:CHARA:歓楽 , 2.00
				TIMES SOURCE:CHARA:受動 , 2.00
				TIMES SOURCE:CHARA:征服 , 1.75
				SOURCE:CHARA:達成 = 300
			CASEELSE
				TIMES SOURCE:CHARA:歓楽 , 2.25
				TIMES SOURCE:CHARA:受動 , 2.25
				TIMES SOURCE:CHARA:征服 , 2.00
				SOURCE:CHARA:達成 = 350
		ENDSELECT
		;見つからない
	ELSE
		TIMES SOURCE:CHARA:歓楽 , 0.50
		TIMES SOURCE:CHARA:受動 , 0.50
		TIMES SOURCE:CHARA:征服 , 0.50
	ENDIF
	;採集物のキャラに応じた固有反応（上書き）
	SELECTCASE 採集物
		;カエル
		CASE 706
			;チルノ
			IF CHARA == [[チルノ]]
				TIMES SOURCE:CHARA:歓楽 , 2.00
				TIMES SOURCE:CHARA:受動 , 2.00
				TIMES SOURCE:CHARA:征服 , 2.00
				;諏訪子
			ELSEIF CHARA == [[諏訪子]]
				TIMES SOURCE:CHARA:歓楽 , 0.50
				TIMES SOURCE:CHARA:受動 , 0.50
				TIMES SOURCE:CHARA:征服 , 0.50
			ELSE
				TIMES SOURCE:CHARA:歓楽 , 1.25
				TIMES SOURCE:CHARA:受動 , 1.00
				TIMES SOURCE:CHARA:征服 , 1.00
			ENDIF
			SOURCE:CHARA:達成 = 110
	ENDSELECT
ENDIF
;フラグ引き渡し
TFLAG:SELECTCOMの分岐 = 採集物
RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;採集する

@COM_ABLE445
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(445)
	RETURN RESULT
;採集できる場所である
SIF !GATHERING_SPOT(CFLAG:MASTER:現在位置)
	RETURN 0
;デート中はデート相手とだけ
SIF FLAG:デート相手 && ((!MOREDATE && TARGET != FLAG:デート相手) || (MOREDATE && !IS_IN_GROUP_DATE(TARGET)))
	RETURN 0
;睡眠中
SIF CFLAG:MASTER:睡眠
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
;体力・気力不足
SIF BASE:MASTER:気力 < 650 || BASE:MASTER:体力 < 680
	RETURN 0
;時間停止中も可能（仮）
;SIF FLAG:70
;	RETURN 0
SIF FLAG:70 && BASE:MASTER:TSP < 120
	RETURN 0
RETURN 1
;-----------------------------------------------------------
;現在位置から採集スポットを割り出す関数
;ARG		現在位置
;ARG:1		@ShowGatheringSpotsからの参照用
;RETURN		0 該当なし	1～30 森、草原	31～60 水系		61～ 特殊
;COMMENT	場所を追加した場合、CASEを変更の事
;-----------------------------------------------------------

@GATHERING_SPOT(ARG, ARG:1)
#FUNCTION
SIF LS_GATHERING_SPOT() ;Custom code, modify gathering spot during Lunatic Survival.
	RETURNF RESULT
IF !IN_HOME(ARG) && !ARG:1
	;サブマップなどでの判定
	SELECTCASE ARG
		CASE 妖精の大樹
			RETURNF 1
		CASE 斜角の竹林
			RETURNF 2
		CASE 無名の丘
			RETURNF 3
		CASE 太陽の畑
			RETURNF 4
		CASE 再思の道
			RETURNF 5
		CASE 古木の大樹
			RETURNF 6
		CASE マヨヒガ
			RETURNF 7
		CASE 彼岸
			RETURNF 8
		CASE 麓の樹海
			RETURNF 11
		CASE 絶景の丘
			RETURNF 12
		CASE 天界
			RETURNF 13
		CASE 桃林～砂浜
			RETURNF 14
		CASE 霧の湖
			RETURNF 31
		CASE 三途の川
			RETURNF 32
		CASE 玄武の沢
			RETURNF 33
		CASE 大蝦蟇の池
			RETURNF 34
		CASE 九天の滝
			RETURNF 35
		CASE 山の湖
			RETURNF 36
		CASE 地獄の深道
			RETURNF 37
		CASE 墓地
			RETURNF 61
		CASE 無縁塚
			RETURNF 62
		CASE 間欠泉地下センター
			RETURNF 64
		CASE 灼熱地獄跡
			RETURNF 65
		CASE 幻想風穴
			RETURNF 66
		CASE 静かの海
			RETURNF 67
		CASE 虹龍洞
			RETURNF 68
		CASE 1120
			RETURNF 80
		CASE 1130
			RETURNF 81
	ENDSELECT
ELSE
	;メインマップでの判定
	SELECTCASE ARG
		;博霊神社
		CASE P25鎮守の森
			RETURNF 1
			;命蓮寺
		CASE P121墓地
			RETURNF 61
			;紅魔館
		CASE P343湖畔
			RETURNF 31
			;永遠亭
		CASE P433斜角の竹林
			RETURNF 2
		CASE P436無名の丘
			RETURNF 3
		CASE P438太陽の畑
			RETURNF 4
			;魔法の森
		CASE P506無縁塚
			RETURNF 62
		CASE P507キノコ群生地
			RETURNF 63
		CASE P509再思の道
			RETURNF 5
		CASE P540古木の大樹
			RETURNF 6
			;冥界
		CASE P602賽の河原 ;addition custom code
			RETURNF 32
		CASE P604彼岸
			RETURNF 8
		CASE P630八雲邸玄関
			RETURNF 7
			;妖怪の山山麓
		CASE P701樹海道入り口 ;addition custom code
			RETURNF 11
		CASE P702山道・沢へ続く道
			RETURNF 9
		CASE P703玄武の沢
			RETURNF 33
		CASE P705山道・中腹
			RETURNF 10
		CASE P708大蝦蟇の池
			RETURNF 34
		CASE P712間欠泉地下センター
			RETURNF 64
			;妖怪の山山頂
		CASE P805頂上
			RETURNF 12
		CASE P806滝の裏
			RETURNF 35
		CASE P814湖畔
			RETURNF 36
		CASE P833桃園
			RETURNF 13
		CASE P855虹龍洞
			RETURNF 68
			;地底
		CASE P928灼熱地獄跡
			RETURNF 65
		CASE P945川岸
			RETURNF 37
		CASE P948縦穴の底
			RETURNF 66
			;月
		CASE P1014桃林, P1015砂浜
			RETURNF 14
		CASE P1016入り江
			RETURNF 67
			;Makai
		CASE 1122
			RETURNF 81
	ENDSELECT
ENDIF
RETURNF 0
;-------------------------------------------------
;その採集スポットでの採集物の出現判定をする関数
;アイテム番号ARG:0
;GATHERING_SPOT(ARG)の返り値ARG:1（採集スポット）  の
;出現可否を数字で返す 出現==1 非出現==0
;アイテムを追加した場合は、GROUPMATCH内にそれぞれ追記
;-------------------------------------------------

@GATHERING_PRODUCT(ARG:0, ARG:1)
#FUNCTION
;(酒造パッチ)ヤマブドウ665・かびたブドウ666を追加
SELECTCASE ARG:1
	;鎮守の森、妖精の大樹
	CASE 1
		SIF GROUPMATCH(ARG:0, 600, 601, 602, 607, 608, 611, 612, 616, 619, 621, 622, 626, 627, 628, 636, 665, 666, 675, 677);Custom code
			RETURNF 1
		;斜角の竹林
	CASE 2
		SIF GROUPMATCH(ARG:0, 607, 608, 611, 612, 613, 618, 619, 629, 635, 640)
			RETURNF 1
		;無名の丘
	CASE 3
		SIF GROUPMATCH(ARG:0, 600, 601, 602, 603, 612, 616, 620, 626, 627, 631, 636, 638, 665, 666, 677);Custom code
			RETURNF 1
		;太陽の畑
	CASE 4
		SIF GROUPMATCH(ARG:0, 612, 613, 614, 615, 617, 618, 619, 620, 623, 624, 626, 627, 665, 666)
			RETURNF 1
		;再思の道
	CASE 5
		SIF GROUPMATCH(ARG:0, 612, 614, 619, 624, 631, 632, 638)
			RETURNF 1
		;古木の大樹
	CASE 6
		SIF GROUPMATCH(ARG:0, 600, 601, 602, 603, 604, 605, 607, 608, 611, 612, 616, 618, 621, 622, 623, 625, 626, 627, 628, 665, 666, 675, 676, 677);Custom code
			RETURNF 1
		;マヨヒガ
	CASE 7
		SIF GROUPMATCH(ARG:0, 600, 601, 602, 603, 607, 608, 611, 612, 616, 617, 619, 621, 622, 626, 627, 628, 665, 666, 675, 676);Custom code
			RETURNF 1
		;彼岸
	CASE 8
		SIF GROUPMATCH(ARG:0, 600, 601, 607, 608, 612, 614, 620, 624, 638)
			RETURNF 1
		;山道・沢へ続く道
	CASE 9
		SIF GROUPMATCH(ARG:0, 600, 601, 602, 607, 608, 611, 612, 616, 617, 621, 622, 626, 627, 628, 636, 665, 666, 676, 677);Custom code
			RETURNF 1
		;山道・中腹
	CASE 10
		SIF GROUPMATCH(ARG:0, 611, 613, 616, 619, 621, 622, 623, 633)
			RETURNF 1
		;麓の樹海
	CASE 11
		SIF GROUPMATCH(ARG:0, 600, 601, 602, 607, 608, 611, 612, 613, 616, 617, 619, 621, 622, 623, 626, 627, 628, 633, 665, 666, 675, 677);Custom code
			RETURNF 1
		;絶景の丘、頂上
	CASE 12
		IF GROUPMATCH(ARG:0, 602, 603, 607, 608, 611, 612, 615, 616, 619, 621, 622, 625, 626, 627, 628, 665, 666, 676);Custom code
			RETURNF 1
		ELSEIF GROUPMATCH(ARG:0, 3300, 3301, 3302, 3304, 3309, 3310, 3312, 3313, 3500, 3504, 3506, 3508, 3405, 3403, 3410, 3411, 3413, 3414, 3415, 3418, 3604, 3606, 3003, 3002, 3005, 3009, 3011, 3012, 3013, 3024, 3025, 3026, 3027, 3028, 3700, 3701, 3702, 3703, 3706, 3707)
			;weapons
			;scenic hills
			RETURNF 1
		ENDIF
		;天界、桃園
	CASE 13
		SIF GROUPMATCH(ARG:0, 617, 623, 630)
			RETURNF 1
		;桃林～砂浜
	CASE 14
		SIF GROUPMATCH(ARG:0, 607, 608, 613, 617, 618, 624, 625, 630)
			RETURNF 1
		;霧の湖、湖畔(紅魔館)
	CASE 31
		SIF GROUPMATCH(ARG:0, 606, 607, 608, 609, 611, 612, 617, 624, 633, 706)
			RETURNF 1
		;三途の川
	CASE 32
		SIF GROUPMATCH(ARG:0, 607, 608, 612, 614, 631, 638, 706)
			RETURNF 1
		;玄武の沢
	CASE 33
