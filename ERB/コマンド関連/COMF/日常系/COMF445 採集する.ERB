@Gathering_Drawing(採集位置, 採集パワー, Modification)
;RESULT:0	採集アイテム
;RESULT:1	採集量
#DIM 採集位置
#DIM 採集パワー
#DIM Chosen
#DIM QTY
#DIM Modification
#DIM start			;抽選開始値
#DIM end			;抽選終了値
#DIM difference		;加算or減算
#DIMS 低気圧位置
#DIMS 積乱雲位置
#DIM nChoice
#DIM nItem
低気圧位置 = %GET_LOCATION_LOW()%
積乱雲位置 = %GET_LOCATION_CUMULUS()%
Chosen = 0
QTY = 0
;採集物の選出
;ランダムで検索スタート位置をずらしたり、検索の向きを変えたりする
;just use fisher yates shuffle :shrug:
start = 0
end = 5000
difference = 1
CALL FISHER_YATES_SHAFFLE(end)
FOR LOCAL:0, start, end, difference
;アイテムが無名でなく、出現条件を満たし、所有数上限でない
nChoice = SHAFFLE_ARRAY:LOCAL
SELECTCASE nChoice
	CASE 3000 TO 4999
		nItem = nChoice-3000
		LOCALS '= PrintWeaponName(,nItem,1)
		DEBUGPRINTFORML 무기 {nItem}을 얻으려고 시도한다.
		SIF !STRLENS(PrintWeaponName(,nItem,-1))
			CONTINUE
		; IF NumberWeaponOwned(nItem) >= 99 ;custom code bug fix
		; 	DEBUGPRINTFORML Skipping %GET_STR(0, "Weapon", nItem, "名前")% due to having too much
		; 	CONTINUE
		;ELSEIF !GATHERING_SEASON(nChoice)
		;	DEBUGPRINTFORML 季節外れのため%ITEMNAME:(nChoice)%をスキップ
		;	CONTINUE
		IF GATHERING_PRODUCT(nChoice, 採集位置) < 1
			DEBUGPRINTFORML 부적절한 아이템 %LOCALS%를 건너뛴다.
			CONTINUE
		ELSEIF BLACKLISTED_WEAPON(nItem)
			DEBUGPRINTFORML 비활성화된 아이템 %LOCALS%를 건너뛴다.
			CONTINUE
		ENDIF
		LOCAL:5 = (GetWeaponRank(-1,-1,GetWeaponScore(nItem, -1))*1000) + 1000
		;採集パワー＋補正値 が √アイテム費用+1000 を上回ったら入手
		;(天候パッチ)猛烈な台風通過後・二つ玉低気圧通過後・スーパーセル通過後は、龍の爪・竜血・竜骨・龍珠の入手成功率が上昇
		IF 採集パワー + Modification < SQRT(LOCAL:5)
			DEBUGPRINTFORML %LOCALS%는 충분한 채집력 때문에 건너뛴다.
			CONTINUE
		ENDIF
		DEBUGPRINTFORML %LOCALS%를 선택했다
		Chosen = nChoice
		;価格10000を超える希少アイテムは１つしか手に入らない、それ以下の価格帯は採集パワーに応じて複数入手が可能に
		QTY = 1
		BREAK
	CASEELSE
		SIF ITEMNAME:(nChoice) == ""
			CONTINUE
		IF ITEM:(nChoice) >= 9999 ;custom code bug fix
			DEBUGPRINTFORML 소지 한계로 %ITEMNAME:(nChoice)%를 건너뛴다
			CONTINUE
		ENDIF
		IF !GATHERING_SEASON(nChoice)
			DEBUGPRINTFORML 계절 외라서 %ITEMNAME:(nChoice)%를 스킵한다.
			CONTINUE
		ENDIF
		IF GATHERING_PRODUCT(nChoice, 採集位置) < 1
			DEBUGPRINTFORML 위치가 부적절하여 %ITEMNAME:(nChoice)%를 건너뛴다.
			CONTINUE
		ENDIF
		LOCAL:5 = ITEMPRICE:(nChoice) + 1000
		;採集パワー＋補正値 が √アイテム費用+1000 を上回ったら入手
		;(天候パッチ)猛烈な台風通過後・二つ玉低気圧通過後・スーパーセル通過後は、龍の爪・竜血・竜骨・龍珠の入手成功率が上昇
		IF GROUPMATCH(nChoice, 606, 625, 634, 647) && ((低気圧位置 == "台風一過" && IS_TYPHOON:1 >= 5) || 低気圧位置 == "二つ玉低気圧通過" || (積乱雲位置 == "積乱雲通過" && CAN_CUMULUS:0 == 5))
			DEBUGPRINTFORML %ITEMNAME:(nChoice)% 획득 성공률 상승 중
			IF 採集パワー + Modification < SQRT((LOCAL:5)/2)
				DEBUGPRINTFORML 채집 파워가 부족하여 %ITEMNAME:(nChoice)%를 건너뛴다.
				CONTINUE
			ENDIF
			;(天候パッチ)寒冷渦通過後・二つ玉低気圧通過後は、氷の鱗の入手成功率が上昇
		ELSEIF nChoice == 609 && (低気圧位置 == "寒冷渦通過" || 低気圧位置 == "二つ玉低気圧通過")
			DEBUGPRINTFORML %ITEMNAME:(nChoice)% 입수 성공률 상승 중
			IF 採集パワー + Modification < SQRT((LOCAL:5)/2)
				DEBUGPRINTFORML 채집 파워가 부족하여 %ITEMNAME:(nChoice)%를 건너뛴다.
				CONTINUE
			ENDIF
		ELSEIF 採集パワー + Modification < SQRT(LOCAL:5)
			DEBUGPRINTFORML 채집 파워가 부족하여 %ITEMNAME:(nChoice)%를 스킵한다.
			CONTINUE
		ENDIF
		DEBUGPRINTFORML %ITEMNAME:(nChoice)%로 결정
		Chosen = nChoice
		;価格10000を超える希少アイテムは１つしか手に入らない、それ以下の価格帯は採集パワーに応じて複数入手が可能に
		SELECTCASE LOCAL:5
			CASE 0 TO 2000
				QTY = MAX((RAND:(SQRT(採集パワー)) - 1), 1)
			CASE 2001 TO 4000
				QTY = MAX((RAND:(SQRT(採集パワー)) - 2), 1)
			CASE 4001 TO 7000
				QTY = MAX((RAND:(SQRT(採集パワー)) - 3), 1)
			CASE 7001 TO 9999
				QTY = MAX((RAND:(SQRT(採集パワー)) - 4), 1)
			CASE 10000 TO 25000
				QTY = MAX((RAND:(SQRT(採集パワー)) - 5), 1)
			CASE 25000 TO 50000
				QTY = MAX((RAND:(SQRT(採集パワー)) - 6), 1)
			CASEELSE
				QTY = 1
		ENDSELECT
		BREAK
		;bugfix custom code, limit QTY to amount player can hold
		SIF CHOSEN
			QTY = MIN(QTY, 所持数制限-ITEM:(Chosen))
ENDSELECT
NEXT
RETURN Chosen, QTY
