;-------------------------------------------------
;出掛ける
;日常系コマンド、レベル1
;-------------------------------------------------
@COM405
VARSET LOCAL
FOR LOCAL,1,CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	;NAS: Don't count dead
	SIF IsDead:LOCAL:0
		CONTINUE
	;NAS: Don't count delusions
	SIF TALENT:LOCAL:妄想の産物
		CONTINUE
	;NAS: Must be in the same location
	SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
		CONTINUE

	IF CFLAG:(LOCAL):同行
		LOCAL:1 ++
		SIF CFLAG:LOCAL:衰弱 || BASE:LOCAL:気力 == 0
			LOCAL:2 ++
		SIF !CHARA_HOLIDAY(LOCAL) && BASE:LOCAL:仕事量
			LOCAL:3 ++
		SIF CFLAG:LOCAL:態度 < 1 && CAN_IRAI_CHARA_GO_TOGATHER(LOCAL) && !Add_CAN_IRAI_CHARA_GO_OUT_ALWAYS(LOCAL) ;addition custom code, allows taking out of town for specific requests even at low affection
			LOCAL:4 ++
	ENDIF
NEXT

IF NEMUKE() >= 720
	DRAWLINE
	PRINTFORML You feel too sleepy, and decide not to go out.
	RETURN -1
ELSEIF LOCAL:1 > 1 && !MOREDATE
	DRAWLINE
	PRINTL Can't bring more than one person when going out.
	RETURN -1
ELSEIF LOCAL:2 || BASE:MASTER:気力 == 0
	DRAWLINE
	PRINTFORML You feel too tired, and decide not to go out. \@ BASE:MASTER:気力 == 0 ? (ENE is 0) # (Partner too tired)\@
	RETURN -1
ELSEIF LOCAL:3 && FESTIVAL() == ""
	DRAWLINE
	PRINTFORML The one accompanying you couldn't go out because it is a work day.
	RETURN -1
ELSEIF LOCAL:4
	DRAWLINE
	PRINTFORML You are told to hurry up and get the request done first...
	RETURN -1
;(天候パッチ)悪天候時も外出可能に
;ELSEIF TIME:5 == 9 || TIME:5 == 5 || WIND_VELOCITY >= 2
;	DRAWLINE
;	PRINTL The weather is too poor to leave.
;	RETURN -1
ELSEIF TALENT:MASTER:100 < -4 
	DRAWLINE
	PRINTL It's too dangerous to go out with such a small body.
	RETURN -1
ELSEIF CapacityStats:MASTER:3 <= 0
	;NAS movement stuff
	IF LEGS_BOUND(MASTER)
		DRAWLINE
		PRINTFORMW Can't go out with your legs bound like this...
		RETURN -1
	ELSEIF IsPartCrippled(MASTER,81) && IsPartCrippled(MASTER,91)
		DRAWLINE
		PRINTFORML Your legs are too damaged to even consider going out...
		RETURN -1
	ELSE
		DRAWLINE
		PRINTFORMW You simply don't have the ability to move...
		RETURN -1
	ENDIF
ELSEIF IsPartCrippled(MASTER,4) && !LOCAL:1
	DRAWLINE
	PRINTFORML You are blind and don't have a sense of direction...
	RETURN -1
ENDIF
IF !CHK_ENTRANCE(CFLAG:MASTER:現在位置, MAIN_MAP)
	PRINTFORML Going to %NAME_FROM_PLACE(ENTRANCE)% first.
	CALL SKIP_MOVE(CFLAG:MASTER:現在位置, ENTRANCE)
	SIF !CHK_ENTRANCE(CFLAG:MASTER:現在位置, MAIN_MAP) ;bugfix custom code
		RETURN -1
	;bugfix custom code, the section below is copied from COMF400
	PRINTFORM When going through %NAME_FROM_PLACE_THE(ENTRANCE)%, 
	LOCAL:10 = 0
	FOR LOCAL,1,CHARANUM
		SIF LOCAL == MASTER
			CONTINUE
		IF CFLAG:LOCAL:現在位置 == ENTRANCE
			LOCAL:10 = LOCAL
			BREAK
		ENDIF
	NEXT
		IF LOCAL:10
		CALL KOJO_ACTIVE_INFO(LOCAL:10) ;addition custom code, duplicated characters
		PRINTFORML you come across %CALLNAME:(LOCAL:10)%.
		SIF LS_RESTRICTION("Pass character") ;Custom code, restrict passing during Lunatic Survival.
			GOTO FORCESTOP
		IF FLAG:立ち止まり == 2
			;立ち止まらない
		ELSEIF FLAG:立ち止まり == 1 && !RESULT
			;口上がある場合のみ
		ELSE
			CALL ASK_M("Greet in passing",!FLAG:70,"Ignore and keep moving",1,"Stop",1)
			IF RESULT == 2
				$FORCESTOP ;Custom code.
				CALL KOJO_MESSAGE_SEND("EVENT",4,LOCAL:10,1,0)
				RETURN -1
			ELSEIF RESULT == 1
				CALL KOJO_MESSAGE_SEND("EVENT",4,LOCAL:10,3,0)
			ELSE
				CALL KOJO_MESSAGE_SEND("EVENT",4,LOCAL:10,2,0)
			ENDIF
		ENDIF
	ELSE
		PRINTFORML you meet no one.
	ENDIF
ENDIF
LOCAL:3 = 0
DRAWLINE
CALL OTHERREGIONS("出掛ける")
LOCAL:2 = RESULT
LOCAL = 0
IF LOCAL:2 == MAIN_MAP || LOCAL:2 == 100
	FLAG:デート相手 = MASTER
	SIF MOREDATE
		CALL CLEAN_GROUP_DATES
	RETURN -1
ENDIF
RETURN 1

@COM_ABLE405
SIF LS_RESTRICTION("Go out") ;Custom code, restrict going out during Lunatic Survival.
	RETURN 0
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(405)
	RETURN RESULT
;お持ち帰り中は不可
;SIF TFLAG:運搬
;	RETURN 0
SIF CFLAG:MASTER:添い寝中
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
SIF CFLAG:MASTER:イタズラ
	RETURN 0
;参道設定
;SIF !CHK_ENTRANCE(CFLAG:MASTER:現在位置, MAIN_MAP)
;	RETURN 0
SIF !AT_HOME(MASTER)
	RETURN 0
RETURN 1