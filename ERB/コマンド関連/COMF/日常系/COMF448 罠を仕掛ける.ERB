		CASE 兎の洞穴
			CALL MUSHI_TRAP_MOVING(431)
		CASE 無名の丘
			CALL MUSHI_TRAP_MOVING(436)
		CASE 太陽の畑
			CALL MUSHI_TRAP_MOVING(438)
		CASE 森の入り口
			CALL MUSHI_TRAP_MOVING(501)
		CASE 古木の大樹
			CALL MUSHI_TRAP_MOVING(540)
		CASE 再思の道
			CALL MUSHI_TRAP_MOVING(509)
		CASE 無縁塚
			CALL MUSHI_TRAP_MOVING(506)
