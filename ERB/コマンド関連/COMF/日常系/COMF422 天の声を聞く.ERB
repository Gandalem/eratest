@広域チェック(ARG,ARG:1)
#DIM DYNAMIC nRoster, 200
VARSET LOCAL
VARSET nRoster, -1

LOCAL:9 = 0
FOR LOCAL,0,CHARANUM
	SIF AT_HOME(LOCAL) == 1
		CONTINUE
	SIF CFLAG:LOCAL:現在位置 == MAXROOM && CFLAG:LOCAL:睡眠
		CONTINUE
	FOR LOCAL:1,10,100,10
		IF CFLAG:LOCAL:現在位置 == ARG * 100 + LOCAL:1
			;その地域にいるキャラを表示
			IF ARG:1 == 2
				;custom code
				IF FLAG:画像表示
					nRoster:(LOCAL:9++) = LOCAL
				ELSE
					IF QoL_IsRequestProgressable(LOCAL) ;custom code, highlight in progress requests
						SETCOLOR C_GREEN
					ELSEIF CFLAG:LOCAL:行動 ;orange work
						SETCOLOR 255, 100, 0
					ELSEIF TCVAR:LOCAL:発情 ;pink in heat
						SETCOLOR 255, 64, 255
					ENDIF
					PRINTFORM %CALLNAME:LOCAL,15,LEFT%
					SIF ++(LOCAL:9) % 6 == 0
						PRINTL
					RESETCOLOR
				ENDIF
			ENDIF
			LOCAL:2 ++
		ENDIF
	NEXT
NEXT
SIF FLAG:画像表示
	CALL PRINT_ROSTER(nRoster, "broad", 50, 13, 110)
;その地域にいる人数
IF ARG:1 == 1
	IF LOCAL:2
		PRINTFORML %@"{LOCAL:2}",2% \@LOCAL:2 == 1?person#people\@
	ELSE
		PRINTL Nobody here
	ENDIF
ENDIF


