	PRINTL Number of children ranking:
	kind = 0
	flagnum=912
ELSEIF ARG == 1
	PRINTL Semen received in vagina ranking:
	kind = 1
	flagnum=515
ELSEIF ARG == 2
	PRINTL Semen received in anus ranking:
	kind = 1
	flagnum=516
ELSEIF ARG == 3
	PRINTL Semen swallowed ranking:
	kind = 1
	flagnum=517
ELSEIF ARG == 4
	PRINTL Semen received on body ranking:
	kind = 1
	flagnum=518
ELSEIF ARG == 5
