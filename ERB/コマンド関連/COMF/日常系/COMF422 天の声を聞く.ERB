				PRINTFORM %ORDINAL(ranum)% place  
				PRINTFORML {CFLAG:(RANK):flagnum} %PLURALIZER("child", CFLAG:(RANK):flagnum)%
				ADDITIONAL_IN_LIST = 0 ;custom code, formatting
				FOR ra,1,CHARANUM
					IF LOCAL:ra == ranum
						;custom code, formatting
						SIF ADDITIONAL_IN_LIST
							PRINTFORM , 
						PRINTFORM %CALLNAME:(ra)%
						ADDITIONAL_IN_LIST = 1 ;custom code, formatting
					ENDIF
				NEXT
				SIF ranum == 3
					WAIT
				CALL PRINT_BREAK() ;qol custom code
				BREAK
			ENDIF
		NEXT
	NEXT
	PRINTW -----------------------------------
ELSEIF kind == 1
	FOR RANK,1,CHARANUM
		FOR ra,1,CHARANUM
			IF CFLAG:RANK:flagnum < CFLAG:ra:flagnum
				LOCAL:RANK ++
			ENDIF
