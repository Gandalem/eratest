	kind = 2
	flagnum=77
ELSEIF ARG == 9
	PRINTL Total kisses ranking:
	kind = 2
	flagnum=27
ENDIF


;kind毎に分岐（内容はほぼ一緒）
IF kind == 0
	;他キャラと項目数の比較
	;もし負けていた場合はLOCALフラグをプラス1
	;最終的にLOCALフラグの数値が、全体の中での順位となる
	;例:LOCALフラグが1の場合、誰にも負けてない＝ランキング1位！
	;例:LOCALフラグが3の場合、二人に負けている＝ランキング3位
	FOR RANK,1,CHARANUM
		FOR ra,1,CHARANUM
			IF CFLAG:RANK:flagnum < CFLAG:ra:flagnum
				LOCAL:RANK ++
			ENDIF
		NEXT
