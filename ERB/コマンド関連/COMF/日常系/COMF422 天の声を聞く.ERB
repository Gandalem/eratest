VARSET LOCAL

;キャラ数だけLOCALの配列を準備
;すべて1に設定しておく
FOR RANK,1,CHARANUM
	;qol custom code
	IF CFLAG:RANK:出禁
		LOCAL:RANK = 100
	ELSE
	LOCAL:RANK = 1
	ENDIF
NEXT

;flagnum:フラグナンバーを管理
;kind:フラグ種類を管理（EXPかCFLAGか）
