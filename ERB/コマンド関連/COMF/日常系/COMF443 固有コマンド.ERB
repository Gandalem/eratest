#DIM CHK_SLOT
#DIM DYNAMIC CAN_SLOT
FOR CHK_SLOT, 1, 6
SIF !IRAI_SLOT_CAN_DOWSING(CHK_SLOT)
	CONTINUE
SETBIT CAN_SLOT, CHK_SLOT
NEXT
RETURNF CAN_SLOT
