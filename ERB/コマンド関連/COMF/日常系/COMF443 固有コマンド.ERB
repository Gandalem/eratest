@UNIQUE_COM_ResurrectONomitron
#DIM DeadCharaCount
#DIM C_ID
VARSET DeadCharaCount
FOR LOCAL, 1, CHARANUM
SIF !IsDead:LOCAL:0
	CONTINUE
IF !DeadCharaCount
	CALL SET_KOJO_COLOR(90)
	PRINTFORML 「누구를 되살리고 싶으세요?」
	RESETCOLOR
ENDIF
DeadCharaCount ++
PRINTFORMC [{LOCAL,3}] - %CALLNAME:LOCAL%
NEXT
IF !DeadCharaCount
	CALL SET_KOJO_COLOR(90)
	PRINTFORML 「여보세요?」
	PRINTFORML 「저는 %NAME:90%입니다」
	PRINTFORML 「당신이 나한테 전화한 이유를 잘 모르겠네요. 죽은 사람을 아는 사람이 없으니까.」
	PRINTFORMW 「이러다 내가 직접 찾아갈 테니까 각오해라!」
	RESETCOLOR
	RETURN -1
ELSE
	PRINTL
	PRINTL [ -1] RETURN
	INPUT
	SELECTCASE RESULT
		CASE -1
			RETURN -1
		CASE 1 TO CHARANUM
			SIF !IsDead:RESULT:0
				RETURN -1
			C_ID = RESULT
			CALL SET_KOJO_COLOR(90)
			PRINTFORML 「얼마를 지불하고 싶으신가요?」
			PRINTFORML 「기억하세요, 경쟁력 있는 가격을 제시하지 않으면 부활된 과정이 불완전할 수 있습니다.」
			RESETCOLOR
			PRINTBUTTON "\\0", 0
			PRINTL
			PRINTBUTTON "\\98800", 98800
			PRINTL
			PRINTBUTTON "\\412800", 412800
			PRINTL
			PRINTBUTTON "\\1000000", 1000000
			INPUT
			IF MONEY < RESULT
				RETURN -1
			ENDIF
			SELECTCASE RESULT
				CASE IS >= 851300
					SIF RESULT >= 1000000
						RESULT = 1000000
					CALL Resurrect(C_ID,0,1)
				CASE IS >= 412800
					CALL Resurrect(C_ID,1,1)
				CASE IS >= 98800
					CALL Resurrect(C_ID,2,1)
				CASEELSE
			ENDSELECT
			CALL PAY_MONEY_YEN(RESULT, 2)
	ENDSELECT
ENDIF
