@TOOL_CUSTOM
#DIM 泡改造前提条件
;NAS: Replaced
CALL TOOL_CUSTOM_NAS
RETURN RESULT
泡改造前提条件 = GETBIT (FLAG:プール, 0) && GETBIT (FLAG:プール, 1) && GETBIT (FLAG:プール, 2)
DRAWLINE
PRINTFORML 맞춤화할 아이템을 선택하세요. 사용 가능한 금액: %金額表示(MONEY)%
DRAWLINE
FOR LOCAL, 0, VARSIZE("ITEM") ;qol custom code
CALL ITEMDATA(LOCAL, "TYPE:改造可能")
IF RESULT && ITEM:LOCAL ;addition custom code
	PRINTFORM [{LOCAL, 3}] - %ITEMNAME_TR(LOCAL)%: 
	TRYCALLFORM Add_ItemModList_%ITEMNAME:LOCAL%
	PRINTFORML
ENDIF
NEXT
PRINT [999] 신경 쓰지 마.
INPUT
SELECTCASE RESULT
	CASE 999
		RETURN
	CASE GETNUM(ITEM, "簡易プール")
		SIF !ITEM:簡易プール
			RETURN
		DRAWLINE
		;qol custom code
		CALL SPTALK, [[にとり]], "笑顔", 0, @"「어떻게 바꾸고 싶으세요?」", 1
		PRINT 현재 상태: 
		CALL Add_ItemModList_簡易プール ;addition custom code
		PRINTL
		DRAWLINE
		IF !GETBIT (FLAG:プール, 0)
			PRINTFORML [  1] [ 1] - 모터(%金額表示(5000)%): 돌아다니기 더 쉽다
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 모터: 이동하기가 더 쉽다
			RESETCOLOR
		ENDIF
		IF !GETBIT (FLAG:プール, 1)
			PRINTFORML [  2] [ 2] - 온수 기능: (%金額表示(5000)%)으로 어디서든 휴식을 취한다
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 온수 기능: 어디서든 휴식 가능・목욕 놀이를 할 수 있게 해준다
			RESETCOLOR
		ENDIF
		IF !GETBIT (FLAG:プール, 2)
			PRINTFORML [  3] [ 3] - 샤워 (%金額表示(5000)%): 샤워에서 빨 수 있고・식물에 물을 줄 수도 있으며・어디든 깨끗한 물로 쓸 수 있다.
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 샤워기: 샤워할 수 있고・식물에게 물을 줄 수도 있음・어디서든 그냥 물 사용 가능
			RESETCOLOR
		ENDIF
		IF 泡改造前提条件 == 0
			PRINTFORML [  4] [ 4] - 전부 추가한다 (%金額表示(5000)% / 개당 모드)
			PRINTL [  ?] - ?????
		ELSEIF !GETBIT (FLAG:プール, 3)
			PRINTFORML [  5] [ 5] - 미스터 버블(%金額表示(5000)%) : 와카사기히메가 자유롭게 돌아다니게 한다.
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 미스터 버블: 와카사기히메가 자유롭게 움직일 수 있게 한다
			RESETCOLOR
			PRINTL 　　　　더 이상 수정할 수 없다.
		ENDIF
		PRINTL [999] 신경 쓰지 마.
		INPUT
		SELECTCASE RESULT
			CASE 999
				RETURN
			CASE 1
				IF !GETBIT (FLAG:プール, 0) && MONEY >= 5000
					PRINTL 돌아다니기 더 편해졌다!
					SETBIT FLAG:プール, 0
					CALL PAY_MONEY_YEN(5000, 2) ;custom code
				ELSE
					RETURN
				ENDIF
			CASE 2
				IF !GETBIT (FLAG:プール, 1) && MONEY >= 5000
					PRINTL 이제 어디서든 편하게 휴식할 수 있다!
					PRINTL 화장실 플레이가 가능해졌다!
					SETBIT FLAG:プール, 1
					CALL PAY_MONEY_YEN(5000, 2)
				ELSE
					RETURN
				ENDIF
			CASE 3
				IF !GETBIT (FLAG:プール, 2) && MONEY >= 5000
					PRINTL 샤워 시설을 이제 사용할 수 있게 되었다!
					PRINTL 식물에 물 주는 것도 이제 더 쉬워졌다!
					SETBIT FLAG:プール, 2
					CALL PAY_MONEY_YEN(5000, 2)
				ELSE
					RETURN
				ENDIF
			CASE 4
				IF 泡改造前提条件 == 0 && MONEY >= 5000 * (!GETBIT (FLAG:プール, 0) + !GETBIT (FLAG:プール, 1) + !GETBIT (FLAG:プール, 2))
					PRINTL 여러 기능이 추가되었다!
					CALL PAY_MONEY_YEN(5000 * (!GETBIT (FLAG:プール, 0) + !GETBIT (FLAG:プール, 1) + !GETBIT (FLAG:プール, 2)), 2)
					SETBIT FLAG:プール, 0
					SETBIT FLAG:プール, 1
					SETBIT FLAG:プール, 2
				ELSE
					RETURN
				ENDIF
			CASE 5
				IF !GETBIT (FLAG:プール, 3) && 泡改造前提条件 && MONEY >= 5000
					PRINTL 미스터 버블을 와카사기히메를 위해 구매했다!
					CALL KOJO_MESSAGE_SEND("EVENT", 0, 93, 0, 0, "MYSTERYBUBBLES_BUY") ;custom code waggy
					SETBIT FLAG:プール, 3
					CALL PAY_MONEY_YEN(5000, 2)
				ELSE
					RETURN
				ENDIF
		ENDSELECT
	CASEELSE
		CALL Add_ItemMod(RESULT) ;addition custom code
		RESTART
ENDSELECT
RETURN -1
