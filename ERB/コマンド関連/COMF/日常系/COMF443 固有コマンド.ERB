@UNIQUE_COM_ダウジング
#DIM DYNAMIC CNT_TALK
#DIM DYNAMIC CNT_DOWSING
#DIM CAN_SLOT
#DIM CHK_SLOT
#DIM TMP_ID
CALL SET_KOJO_COLOR([[ナズーリン]]) ;custom code
IF !CNT_TALK
	PRINTFORML 「음. 뭘 찾고 있는 거냐?」
	PRINTFORML 「그건 내 전문 분야다.」
	PRINTFORMW 「그러니 무슨 일이 있었는지 자세히 말해 보라.」
	CNT_TALK ++
	CAN_SLOT = CAN_DOWSING()
	IF !CAN_SLOT
		PRINTFORML 「이봐, 거기 멈춰! 네가 찾고 있는 게 탐지술로도 못 찾을 거라고 말하는 거야?」
		PRINTFORMW 「나 가지고 장난치는 거야? 정말...」
		RETURN
	ENDIF
ELSE
	PRINTFORMW 「더 이상은 없었나요?」
ENDIF
FOR CHK_SLOT, 1, 6
SIF !GETBIT(CAN_SLOT, CHK_SLOT)
	CONTINUE
PRINTFORMDL [{CHK_SLOT}] - 요청 {CHK_SLOT} ＜%REQUEST_NAMES_TR(STR_DATA_IRAI(IRAI_SLOT:CHK_SLOT, "依頼名", IRAI_SLOT_TO_CLIENT(CHK_SLOT)))%＞
NEXT
PRINTFORML 
PRINTFORMDL [0] - 반환
DO
INPUT
CHK_SLOT = RESULT
SELECTCASE CHK_SLOT
	CASE 1 TO 5
		SIF !GETBIT(CAN_SLOT, CHK_SLOT)
			CONTINUE
		IF IRAI_EX:CHK_SLOT
			PRINTFORML 「야, 벌써 그거에 대해 물어봤잖아?」
			CONTINUE
		ENDIF
		PRINTFORML 「그렇게 된 걸 알겠다.」
		PRINTFORML 「탐색(dowsing)을 위한 '기부금'을 내는 건 괜찮지, 그렇지?」
		CALL ASK_M("신경 쓰지 마", 1, @"%金額表示(1000)%을 제안한다", MONEY >= 1000, "5CM 제공", MONEY:2 >= 5)
		SELECTCASE RESULT
			CASE 0
				PRINTFORMW 「아쉽네.」
				BREAK
			CASE 1
				CALL PAY_MONEY_YEN(1000, 2) ;custom code
			CASE 2
				CALL PAY_MONEY_CM(5, 2) ;custom code
		ENDSELECT
		CNT_DOWSING ++
		SELECTCASE IRAI_SLOT_TO_TASKNAME(CHK_SLOT)
			CASE "捜索（人物）"
				CNT_DOWSING ++
				TMP_ID = IRAI_SLOT_TO_PERSON(CHK_SLOT)
				IRAI_EX:CHK_SLOT = TMP_ID
				;Custom code, name-check
				IF CALLNAME:TMP_ID == "Nazrin"
					;ナズ口上は人物に対する反応分岐が多いがつくれない
					;流石に自分が相手ならこんな感じになるだろう
					PRINTFORML 「추는 시간이 꽤 되었다.」
					PRINTFORML 「그 요청은 혹시 나와 관련이 있는 걸까?」
					PRINTFORMW 「그런 것 같다.」
					BREAK
				ENDIF
				CALL DOWSING_TSUBUYAKI
				PRINTFORML 「완료했다.」
				PRINTFORML 「%CALLNAME:TMP_ID%가 핵심 인물이다.」
				PRINTFORML 「%HE_SHE(TMP_ID)%가 어디에 있는지 알고 싶나?」
				CALL ASK_M("No", 1, @"%金額表示(500)%을 제안한다.", MONEY >= 500, "3cm 제안", MONEY:2 >= 3)
				SELECTCASE RESULT
					CASE 0
						PRINTFORMW 「아쉽네, 유감이다.」
						BREAK
					CASE 1
						CALL PAY_MONEY_YEN(500, 2) ;custom code
					CASE 2
						CALL PAY_MONEY_CM(3, 2) ;custom code
				ENDSELECT
				IF CFLAG:TMP_ID:現在位置 == SUKIMA()
					PRINTFORML 「흠... 수치가 불안정하다.」
					PRINTFORMW 「지금 그들을 만나는 건 꽤 어려울 것이다.」
				ELSE
					;Custom code
					PRINTFORMW 「%HE_SHE(TMP_ID,1)%은 현재 “%STR_TR(5000 + GET_MAPID(CFLAG:TMP_ID:現在位置))%” 근처에 있다.」
				ENDIF
			CASE "捜索（場所）"
				CNT_DOWSING ++
				TMP_ID = IRAI_SLOT_TO_PLACE(CHK_SLOT)
				IRAI_EX:CHK_SLOT = TMP_ID + 5000
				CALL DOWSING_TSUBUYAKI
				;Custom code
				PRINTFORML 「다 끝났어.」
				PRINTFORML 「“%STR_TR(5000 + GET_MAPID(TMP_ID))%” 근처를 좀 더 찾아봐야 해.」
				PRINTFORML 「더 상세한 정보가 필요해?」
				CALL ASK_M("No", 1, @"%金額表示(2000)%을 제안한다.", MONEY >= 2000, "10cm를 제공한다", MONEY:2 >= 10)
				SELECTCASE RESULT
					CASE 0
						PRINTFORMW 「아쉽네.」
						BREAK
					CASE 1
						CALL PAY_MONEY_YEN(2000, 2) ;custom code
					CASE 2
						CALL PAY_MONEY_CM(10, 2) ;custom code
				ENDSELECT
				IRAI_EX:CHK_SLOT = TMP_ID
				;Custom code
				PRINTFORMW 「맵 ID %STR_TR(5000 + GET_MAPID(TMP_ID))%, “%GET_PLACENAME(TMP_ID)%” 근처가 반응이 가장 강한 곳이다.」
			CASEELSE
				PRINTFORMW 「오호...? ...흠, 봉에서 이상한 소리가 나네.」
				PRINTFORML 
				RESETCOLOR
				PRINTFORML 　오류가 발생했습니다(로그를 확인해 주세요)
				PRINTFORML 　로그 오류를 생성하려면 클릭하세요
				PRINTFORMW ◆로그 시작
				PRINTFORML IRAI_SLOT:CHK_SLOT　{IRAI_SLOT:CHK_SLOT}
				PRINTFORML IRAI_DATA:CHK_SLOT　{IRAI_DATA:CHK_SLOT}
				CALL SHOW_IRAI_DATA(IRAI_SLOT:CHK_SLOT, CHK_SLOT)
				PRINTFORML 
				PRINTFORML ◆로그 종료
				PRINTFORMW 　복사해서 붙여넣어라
		ENDSELECT
	CASE 0
		IF CNT_DOWSING
			PRINTDATAL
				DATA 「Did that help?」
				DATA 「I hope you'll find what you seek, good luck.」
				DATA 「Is that all?」
			ENDDATA
			PRINTFORMW 「어쨌든, 인내심을 갖고 계속 찾아봐라.」
		ELSE
			PRINTFORMW 「그냥 나한테 계속 시비 걸지 그래?」
		ENDIF
		RETURN
	CASEELSE
		$RETRY
		PRINTFORMW 「흠... 무슨 일이야?」
		CONTINUE
ENDSELECT
BREAK
LOOP 1
RESTART
;受託済み依頼のダウジング可否判定
