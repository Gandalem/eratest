@UNIQUE_COM_生薬を売る
#DIM 候補番号
#DIM 候補個数
#DIM 売却個数
PRINTFORML Money: %金額表示(MONEY)%
DRAWLINE
;所持している素材アイテムの売却可能物・個数をリスト化
LOCAL:1 = 999
FOR LOCAL:0 ,600, 700
	IF UNIQUE_COM_HARBAL_SALES(LOCAL:0)
		IF ITEM:(LOCAL:0)
			LOCALS:0 = [{LOCAL:0,3}] %ITEMNAME_TR(LOCAL:0), 32, LEFT%×{ITEM:(LOCAL:0),3}
			LOCAL:1 += STRLENS(LOCALS:0)
			SIF ITEM:(LOCAL:0) < 10
				LOCAL:1 ++
			IF LOCAL:1 > 90
				IF LOCAL:1 >= 999
				;最初のみ改行しない
				ELSE
					PRINTL 
				ENDIF
				LOCAL:1 = 0
				PRINT 　　
			ENDIF
			PRINTFORM %LOCALS%
			;SIF ITEM:(LOCAL:0) < 10
			;	PRINT  
			PRINT 　　
		ENDIF
	ENDIF
NEXT
PRINTL
SIF TFLAG:運搬 && IsDead:(TFLAG:運搬):0
PRINTFORML 　　[150] Resurrect %CALLNAME:(TFLAG:運搬)%
PRINTL 　　[100] Return
DRAWLINE
CALL SET_KOJO_COLOR(72)
PRINTFORML 「What are you selling?」
RESETCOLOR
$INPUT_LOOP01
INPUT
候補番号 = RESULT

IF 候補番号 == 100
;100は先送り、売却不能物、600未満および700以上の入力は無効化する
ELSEIF 候補番号 == 150
ELSEIF UNIQUE_COM_HARBAL_SALES(候補番号) == 0 || 候補番号 < 600 || 候補番号 > 699
	CLEARLINE 1
	GOTO INPUT_LOOP01
ENDIF
SELECTCASE 候補番号
	CASE 150
		LOCAL = 400000
		SIF TALENT:72:恋人
			LOCAL /= 2

		CALL SET_KOJO_COLOR(72)
		PRINTFORML 「I'll resurrect %HIS_HER(TFLAG:運搬)% for %"\\"+DIGIT_GROUP(LOCAL)%.」
		PRINTFORML 「Is that fine?」
		RESETCOLOR
		CALL ASK_YN()
		SELECTCASE RESULT
		CASE 0
			IF MONEY >= LOCAL
			CALL Resurrect(TFLAG:運搬,,1)
			TFLAG:運搬 = MASTER
			MONEY -= LOCAL
			ELSE
			CALL SET_KOJO_COLOR(72)
			PRINTFORML 「Oops... It doesn't seem you have enough money to do a resurrection」
			PRINTFORML 「Resurrections are expensive, but I don't want to half-ass it unlike that other girl.」
			RESETCOLOR
			ENDIF
		CASE 1
		ENDSELECT
	CASE 100
		RETURN -1
	CASEELSE
		候補個数 = ITEM:(候補番号)
		CLEARLINE 1
		IF 候補個数
			CALL SET_KOJO_COLOR(72)
			SELECTCASE 候補番号
				CASE 601, 612, 635
					PRINTFORML 「%ITEMNAME_TR(候補番号)%... It's poisonous, but that depends on how you use it...
				CASE 603, 618
					PRINTFORML 「%ITEMNAME_TR(候補番号)%... It's famous as a tonic medicine, but... Fufu, how will you use it I wonder?
				CASE 605, 624
					PRINTFORML 「%ITEMNAME_TR(候補番号)%... Normal people shouldn't deal with things like these, please be careful.
				CASE 634
					PRINTFORML 「%ITEMNAME_TR(候補番号)%... Excavating it takes a while, but it's very versatile.
				CASE 646
					PRINTFORML 「%ITEMNAME_TR(候補番号)%... Hard to cut down, but it's very versatile.
				CASE 606, 609, 615, 625, 640, 643
					PRINTFORML 「%ITEMNAME_TR(候補番号)%...! That you managed to get something like this...
				CASEELSE
					PRINTFORM 「%ITEMNAME_TR(候補番号)%...
			ENDSELECT
			PRINTFORM 　I'll pay you %金額表示(ITEMPRICE:(候補番号) / 2)% per item, is that fine?」
			SETCOLOR 0x777777
			PRINTFORML 　Select how many to sell. (Enter 1～{候補個数}. 0 cancels.)
			RESETCOLOR
			PRINTL   
			PRINTBUTTON "[0] Cancel", 0
			PRINT     
			PRINTBUTTON "[1] 1", 1
			PRINT     
			IF 候補個数 >= 5
				PRINTBUTTON "[5] 5", 5
				PRINT     
			ENDIF
			IF 候補個数 >= 10
				PRINTBUTTON "[10] 10", 10
				PRINT    
			ENDIF
			$INPUT_LOOP02
			INPUT
			SELECTCASE RESULT
				CASE 0
					RESTART
				CASE 1 TO 候補個数
					CLEARLINE 2
					売却個数 = RESULT
					CALL SET_KOJO_COLOR(72)
					PRINTFORMW 「Thank you. Then I'll buy {売却個数} of your %ITEMNAME_TR(候補番号)% for %金額表示(ITEMPRICE:(候補番号) / 2 * 売却個数)%.」
					RESETCOLOR
					MONEY += (ITEMPRICE:(候補番号) / 2 * 売却個数)
					ITEM:(候補番号) -= 売却個数
					RESTART
				CASEELSE
					CLEARLINE 1
					GOTO INPUT_LOOP02
			ENDSELECT
		ELSE
			CLEARLINE 1
			GOTO INPUT_LOOP01
		ENDIF
ENDSELECT
RESTART

;売却リストに載せないアイテムを定義
@UNIQUE_COM_HARBAL_SALES(ARG)
#FUNCTION
SELECTCASE ARG
	;★ここに売却リストに載せないアイテムを記入
	CASE 600, 602, 610, 611, 616, 621, 626 TO 631, 636, 638, 639, 642, 644, 645, 647, 648, 660 TO 669
		RETURNF 0
	;まだ未登録のアイテム
	CASE 649 TO 659, 670 TO 699
		RETURNF 0
	CASEELSE
		RETURNF ARG
ENDSELECT

