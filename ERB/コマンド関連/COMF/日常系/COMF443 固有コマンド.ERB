@UNIQUE_COM_天候操作
CALL SET_KOJO_COLOR([[天子]]) ;custom code
IF CFLAG:MASTER:現在位置 == 天界
	PRINTFORML 「아, 여기서 그럴 수는 없어...」
	RETURN -1
ENDIF
IF FLAG:異常気象
	PRINTFORML 「이런 종류의 날씨는 바꿀 수 없어...」
	RETURN -1
ENDIF
IF GETBIT(TFLAG:一日一回,6)
	PRINTFORML 「오늘은 못 하겠어, 몸이 좀 안 좋네.」
	RETURN -1
ENDIF
PRINTFORML 「나는 날씨를 전반적인 방향으로만 살짝 바꿀 수 있을 뿐이야, 정밀한 조절은 너무 피곤해.」
RESETCOLOR
$LOOP
CALL ASK_M("화창하다",1,"흐림",1,"비",1, "눈", DAY:2 == 4, "팬티", 1)
SELECTCASE RESULT
	CASE 0
		;雨なら低確率で虹
		SIF INRANGE(TIME:5,4,7) && !RAND:7
			TIME:7 = 1
		;雪なら低確率でダイヤモンドダスト
		SIF INRANGE(TIME:5,8,13) && !RAND:7
			TIME:7 = 2
		TIME:5 = RAND:2
	CASE 1
		TIME:5 = RAND:2 + 2
	CASE 2
		;晴れを変えようとすると虹
		IF TIME:5 < 2 && !RAND:4
			TIME:7 = 1
		ELSE
			TIME:5 = 4 + RAND:4
		ENDIF
	CASE 3
		;晴れを変えようとするとダイヤモンドダスト
		IF TIME:5 < 2 && !RAND:4
			TIME:7 = 2
		ELSE
			TIME:5 = 8 + RAND:6
		ENDIF
	CASE 4
		IF TALENT:34:恋人
			CALL SET_KOJO_COLOR(34)
			PRINTFORML 「아... 알겠어..」
			PRINTFORML 「하지만 당신을 진심으로 사랑하기 때문에...」
			RESETCOLOR
			FLAG:異常気象 = 7
		ELSE
			CALL SET_KOJO_COLOR(34)
			PRINTFORML 「멍청해?」
			RETURN -1
		ENDIF
ENDSELECT
