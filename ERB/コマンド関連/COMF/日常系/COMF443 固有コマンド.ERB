;-------------------------------------------------
;Seiga's Resurrection Service
;-------------------------------------------------
@UNIQUE_COM_ResurrectONomitron
#DIM DeadCharaCount
#DIM C_ID
VARSET DeadCharaCount
FOR LOCAL, 1, CHARANUM
	SIF !IsDead:LOCAL:0
		CONTINUE

	IF !DeadCharaCount
		CALL SET_KOJO_COLOR(90)
		PRINTFORML 「Who do you like to resurrect?」
		RESETCOLOR
	ENDIF	
	DeadCharaCount ++

	PRINTFORMC [{LOCAL,3}] - %CALLNAME:LOCAL%
NEXT

IF !DeadCharaCount
	CALL SET_KOJO_COLOR(90)
	PRINTFORML 「Hello?」
	PRINTFORML 「This is %NAME:90%」
	PRINTFORML 「I'm not sure why you're calling me, since you don't know anyone who has died.」
	PRINTFORMW 「Keep this up and I'll be paying YOU a visit!」
	RESETCOLOR
	RETURN -1
	ELSE
	PRINTL
	PRINTL [ -1] RETURN
	INPUT
	SELECTCASE RESULT
	CASE -1
		RETURN -1
	CASE 1 TO CHARANUM
		SIF !IsDead:RESULT:0
			RETURN -1
		C_ID = RESULT
		CALL SET_KOJO_COLOR(90)
		PRINTFORML 「How much would you like to pay?」
		PRINTFORML 「Remember, if you don't offer a competitive price, the resurrection performed may be imcomplete.」
		RESETCOLOR

		PRINTBUTTON "\\0", 0
		PRINTL
		PRINTBUTTON "\\98800", 98800
		PRINTL
		PRINTBUTTON "\\412800", 412800
		PRINTL
		PRINTBUTTON "\\1000000", 1000000
		INPUT
		IF MONEY < RESULT
			RETURN -1
		ENDIF

		SELECTCASE RESULT
			CASE IS >= 851300
				SIF RESULT >= 1000000
					RESULT = 1000000
				CALL Resurrect(C_ID,0,1)
			CASE IS >= 412800
				CALL Resurrect(C_ID,1,1)
			CASE IS >= 98800
				CALL Resurrect(C_ID,2,1)
			CASEELSE
		ENDSELECT
		CALL PAY_MONEY_YEN(RESULT, 2)
	ENDSELECT
ENDIF

RESETCOLOR

