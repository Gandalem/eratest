@UNIQUE_COM_天候操作
CALL SET_KOJO_COLOR([[天子]]) ;custom code
IF CFLAG:MASTER:現在位置 == 天界
	PRINTFORML 「Ah, I can't do that here...」
	RETURN -1
ENDIF
IF FLAG:異常気象
	PRINTFORML 「I can't change this kind of weather...」
	RETURN -1
ENDIF
IF GETBIT(TFLAG:一日一回,6)
	PRINTFORML 「Can't do it today, I'm feeling a bit under the weather.」
	RETURN -1
ENDIF
PRINTFORML 「I can only nudge the weather in a general direction, precise control is too tiring.」
RESETCOLOR
$LOOP
CALL ASK_M("Sunny",1,"Cloudy",1,"Rain",1, "Snow", DAY:2 == 4, "Panties", 1)
SELECTCASE RESULT
	CASE 0
		;雨なら低確率で虹
		SIF INRANGE(TIME:5,4,7) && !RAND:7
			TIME:7 = 1
		;雪なら低確率でダイヤモンドダスト
		SIF INRANGE(TIME:5,8,13) && !RAND:7
			TIME:7 = 2
		TIME:5 = RAND:2
	CASE 1
		TIME:5 = RAND:2 + 2
	CASE 2
		;晴れを変えようとすると虹
		IF TIME:5 < 2 && !RAND:4
			TIME:7 = 1
		ELSE
			TIME:5 = 4 + RAND:4
		ENDIF
	CASE 3
		;晴れを変えようとするとダイヤモンドダスト
		IF TIME:5 < 2 && !RAND:4
			TIME:7 = 2
		ELSE
			TIME:5 = 8 + RAND:6
		ENDIF
	CASE 4
		IF TALENT:34:恋人
			CALL SET_KOJO_COLOR(34)
			PRINTFORML 「Oh... okay..」
			PRINTFORML 「But only because I love you dearly...」
			RESETCOLOR
			FLAG:異常気象 = 7
		ELSE
			CALL SET_KOJO_COLOR(34)
			PRINTFORML 「Are you stupid?」
			RETURN -1
		ENDIF
ENDSELECT

