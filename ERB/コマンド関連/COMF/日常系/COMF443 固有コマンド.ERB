;-------------------------------------------------
;ナズーリン用
;-------------------------------------------------
@UNIQUE_COM_ダウジング
#DIM DYNAMIC CNT_TALK
#DIM DYNAMIC CNT_DOWSING
#DIM CAN_SLOT
#DIM CHK_SLOT
#DIM TMP_ID
CALL SET_KOJO_COLOR([[ナズーリン]]) ;custom code
IF !CNT_TALK
	PRINTFORML 「Mhmm. What is it you're lookin' for?」
	PRINTFORML 「It's absolutely in my field of expertise.」
	PRINTFORMW 「So, give me a detailed account of what happened.」
	CNT_TALK ++
	CAN_SLOT = CAN_DOWSING()
	IF !CAN_SLOT
		PRINTFORML 「Hey, hold it right there! Are you saying what you're lookin' for can't even be found via dowsing?」
		PRINTFORMW 「Are you screwing with me? Really...」
		RETURN
	ENDIF
ELSE
	PRINTFORMW 「Was there anything else?」
ENDIF

FOR CHK_SLOT, 1, 6
	SIF !GETBIT(CAN_SLOT, CHK_SLOT)
		CONTINUE
	PRINTFORMDL [{CHK_SLOT}] - Request {CHK_SLOT}　＜%REQUEST_NAMES_TR(STR_DATA_IRAI(IRAI_SLOT:CHK_SLOT, "依頼名", IRAI_SLOT_TO_CLIENT(CHK_SLOT)))%＞
NEXT
PRINTFORML 
PRINTFORMDL [0] - Return
DO
	INPUT
	CHK_SLOT = RESULT
	SELECTCASE CHK_SLOT
	CASE 1 TO 5
		SIF !GETBIT(CAN_SLOT, CHK_SLOT)
			CONTINUE
		IF IRAI_EX:CHK_SLOT
			PRINTFORML 「Hey now, haven't you already asked about that?」
			CONTINUE
		ENDIF
		PRINTFORML 「I see how it is.」
		PRINTFORML 「You don't mind offering some *donations* for the dowsing, right?」
		CALL ASK_M("Never mind", 1, @"Offer %金額表示(1000)%", MONEY >= 1000, "Offer 5CM", MONEY:2 >= 5)
		SELECTCASE RESULT
		CASE 0
			PRINTFORMW 「Oh well, that's a pity.」
			BREAK
		CASE 1
			CALL PAY_MONEY_YEN(1000, 2) ;custom code
		CASE 2
			CALL PAY_MONEY_CM(5, 2) ;custom code
		ENDSELECT
		CNT_DOWSING ++
		SELECTCASE IRAI_SLOT_TO_TASKNAME(CHK_SLOT)
		CASE "捜索（人物）"
			CNT_DOWSING ++
			TMP_ID = IRAI_SLOT_TO_PERSON(CHK_SLOT)
			IRAI_EX:CHK_SLOT = TMP_ID
			;Custom code, name-check
			IF CALLNAME:TMP_ID == "Nazrin"
			;ナズ口上は人物に対する反応分岐が多いがつくれない
			;流石に自分が相手ならこんな感じになるだろう
				PRINTFORML 「The pendulum has been reacting for some time.」
				PRINTFORML 「Is that request perhaps related to me?」
				PRINTFORMW 「It feels like it is.」
				BREAK
			ENDIF
			CALL DOWSING_TSUBUYAKI
			PRINTFORML 「Done.」
			PRINTFORML 「%CALLNAME:TMP_ID% is the key person.」
			PRINTFORML 「Wanna know where %HE_SHE(TMP_ID)% is as well?」
			CALL ASK_M("No", 1, @"Offer %金額表示(500)%", MONEY >= 500, "Offer 3CM", MONEY:2 >= 3)
			SELECTCASE RESULT
			CASE 0
				PRINTFORMW 「Oh well, that's a pity.」
				BREAK
			CASE 1
				CALL PAY_MONEY_YEN(500, 2) ;custom code
			CASE 2
				CALL PAY_MONEY_CM(3, 2) ;custom code
			ENDSELECT
			IF CFLAG:TMP_ID:現在位置 == SUKIMA()
				PRINTFORML 「Hmm... The reading's unstable.」
				PRINTFORMW 「Encountering 'em right now would be rather difficult.」
			ELSE
				;Custom code
				PRINTFORMW 「%HE_SHE(TMP_ID,1)% is currently around “%STR_TR(5000 + GET_MAPID(CFLAG:TMP_ID:現在位置))%”.」
			ENDIF
		CASE "捜索（場所）"
			CNT_DOWSING ++
			TMP_ID = IRAI_SLOT_TO_PLACE(CHK_SLOT)
			IRAI_EX:CHK_SLOT = TMP_ID + 5000
			CALL DOWSING_TSUBUYAKI
			;Custom code
			PRINTFORML 「It's done.」
			PRINTFORML 「You should look somewhere around “%STR_TR(5000 + GET_MAPID(TMP_ID))%”.」
			PRINTFORML 「Need more detailed information?」
			
			CALL ASK_M("No", 1, @"Offer %金額表示(2000)%", MONEY >= 2000, "Offer 10CM", MONEY:2 >= 10)
			SELECTCASE RESULT
			CASE 0
				PRINTFORMW 「Oh well, that's a pity.」
				BREAK
			CASE 1
				CALL PAY_MONEY_YEN(2000, 2) ;custom code
			CASE 2
				CALL PAY_MONEY_CM(10, 2) ;custom code
			ENDSELECT
			IRAI_EX:CHK_SLOT = TMP_ID
			;Custom code
			PRINTFORMW 「Around %STR_TR(5000 + GET_MAPID(TMP_ID))%, near “%GET_PLACENAME(TMP_ID)%”, that's where the reaction is the strongest.」
		CASEELSE
			PRINTFORMW 「Ohh...? ...Hmm, the rod is making a weird noise.」
			PRINTFORML 
			RESETCOLOR
			PRINTFORML 　An error has occurred (Please check the log)
			PRINTFORML 　Click to generate a log error
			PRINTFORMW ◆Log start
			PRINTFORML IRAI_SLOT:CHK_SLOT　{IRAI_SLOT:CHK_SLOT}
			PRINTFORML IRAI_DATA:CHK_SLOT　{IRAI_DATA:CHK_SLOT}
			CALL SHOW_IRAI_DATA(IRAI_SLOT:CHK_SLOT, CHK_SLOT)
			PRINTFORML 
			PRINTFORML ◆Log end
			PRINTFORMW 　Copy-paste that
		ENDSELECT
		
	CASE 0
		IF CNT_DOWSING
