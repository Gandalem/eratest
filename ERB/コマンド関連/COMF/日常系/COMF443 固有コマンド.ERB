@UNIQUE_COM_新聞購読
#DIM R_ID
#DIM C_ID
#DIM LINE_BREAK
VARSET R_ID
CALL SET_KOJO_COLOR(29)
PRINTFORML 「무엇을 도와드릴까요?」
RESETCOLOR
CALL ASK_M("신문을 구독한다", !FLAG:新聞購読, "나에 대한 좋은 소식을 전파한다", !GETBIT(ReputationKnow:29:0,17), "이 소문 더 이상 떠다니는 거 원치 않아", 1, "내 이름을 지워라", 1, "죽음을 보고한다", nNecro, "데이트 휴전 신청하기", nFactions, "데이트 휴전 선언하기", nFactions, "나 좀 여기서 나가게 해줘!", 1)
SELECTCASE RESULT
	CASE 0
		IF FLAG:新聞購読
			CALL SET_KOJO_COLOR(29)
			PRINTFORML 「이미 구독 중입니다...」
			RESETCOLOR
			RETURN -1
		ENDIF
		CALL SET_KOJO_COLOR(29)
		PRINTFORML 「지금 환상향에서 무슨 일이 일어나고 있는지 매달 %金額表示(3000)%로 알 수 있어! 문문환 신문을 구독하지 않을 이유가 있겠어?!」
		PRINTFORML 「컴퓨터를 가진 사람들을 위해 온라인 버전도 %WebSitesNames:7%에서 제공하고 있어!」
		WebSitesKnown:7 = 1
		RESETCOLOR
		CALL ASK_M("괜찮습니다",1,"돈으로 구독한다",MONEY >= 3000,"카리스마로 구독한다",MONEY:2 >= 10)
		SELECTCASE RESULT
			CASE 0
				RETURN -1
			CASE 1
				CALL PAY_MONEY_YEN(3000, 2) ;custom code
			CASE 2
				CALL PAY_MONEY_CM(10, 2) ;custom code
		ENDSELECT
		PRINTFORMDW 분분마루 신문을 구독하기로 결정했다.
		PRINTFORMDW 계약은 매월 첫째 날에 갱신된다.
		FLAG:新聞購読 = 1
	CASE 1
		LOCAL = 50000 + (FakeNews * 10000)
		CALL SET_KOJO_COLOR(29)
		IF FakeNews >= 5
			PRINTFORML 「봐, 더 이상 나를 이용해서 너에 대한 가짜 뉴스를 퍼뜨릴 수는 없어.」
			PRINTFORML 「그딴 짓 또 하면 네 빌어먹을 명예를 망쳐버릴 거야.」
			CALL SET_REP(29,17,,)
			RETURN -1
		ELSE
			PRINTFORML 「좋아요, 적절한 대가로 다른 사람들에게 좋은 평판을 얻게 해 드릴 수 있어요」
			PRINTFORML 「%"\\"+DIGIT_GROUP(LOCAL)%은(는) 어때요?」
		ENDIF
		RESETCOLOR
		CALL ASK_M("예!", MONEY >= LOCAL, "No.", 1)
		SELECTCASE RESULT
			CASE 0
				MONEY -= LOCAL
				FakeNews ++
				DidFakeNews = 1
			CASE 1
				RETURN -1
		ENDSELECT
	CASE 2
		CALL SET_KOJO_COLOR(29)
		PRINTFORML 「다른 사람들이 잊어주길 바라는 부정적인 평판은 무엇인가?」
		RESETCOLOR
		PRINTFORML 
		FOR C_ID,1,CHARANUM
		FOR LOCAL,0,REP_NUM
		IF GETBIT(ReputationKnow:C_ID:0,LOCAL)
			SIF LINEISEMPTY()
				PRINT 　
			SIF !GETBIT(R_ID, LOCAL)
				PRINTFORMLC [{LOCAL}] - %GET_STR(C_ID, "Reputation", LOCAL, "Name")%
			SETBIT R_ID, LOCAL
			LINE_BREAK ++
			SIF LINE_BREAK % (PRINTCPERLINE() - 1) == 0
				PRINTL 
		ENDIF
		RESETCOLOR
		NEXT
		NEXT
		PRINTL
		PRINTFORML [999] 나를 여기서 나가게 해줘!
		INPUT
		LOCAL = RESULT
		IF INRANGE(LOCAL, 0, REP_NUM)
			PRINTFORML 「좋아, 사람들이 네가 【%GET_STR(29, "Reputation", LOCAL, "Name")%】였던 걸 잊게 만들어 줄 수 있어」
			PRINTFORML 「【%"\\"+DIGIT_GROUP(50000)%】는 어때?」
			RESETCOLOR
			CALL ASK_M("네!", MONEY >= 50000, "No.", 1)
			SELECTCASE RESULT
				CASE 0
					MONEY -= 50000
					DisregardRep = LOCAL
				CASE 1
					RETURN -1
			ENDSELECT
		ELSE
		ENDIF
	CASE 3
		LOCAL = 500000
		CALL SET_KOJO_COLOR(29)
		PRINTFORML 「당신의 모든 명예를 지워버리고 새로운 시작을 줄 수 있어.」
		PRINTFORML 「이것은 본질적으로 당신에게 새로운 정체성을 부여하는 거야.」	
		PRINTFORML 「%"\\"+DIGIT_GROUP(LOCAL)%는 어때?」
		RESETCOLOR
		CALL ASK_M("네!", MONEY >= LOCAL, "No.", 1)
		SELECTCASE RESULT
			CASE 0
				PRINTFORML %PARSE("Your")% 명성이 지워졌다.
				MONEY -= LOCAL
				FOR C_ID,1,CHARANUM
				VARSET ReputationKnow:C_ID:0
				NEXT
			CASE 1
				RETURN -1
		ENDSELECT
	CASE 4
		CALL SET_KOJO_COLOR(29)
		PRINTFORML 「그건 비극이군...」
		PRINTFORML 「누가 이런 운명을 견뎌야 했던 거지?」
		RESETCOLOR
		PRINTFORML 
		FOR C_ID,1,CHARANUM
		SIF !IsDead:C_ID:0
			CONTINUE
		SIF KnowsDeadBodies:29:C_ID
			CONTINUE
		SIF LINEISEMPTY()
			PRINT 　
		PRINTFORMLC [{C_ID}] - %NAME:C_ID%
		LINE_BREAK ++
		SIF LINE_BREAK % (PRINTCPERLINE() - 1) == 0
			PRINTL 
		NEXT
		PRINTL
		PRINTFORML [999] 나 여기서 나가게 해줘!
		INPUT
		LOCAL = RESULT
		IF INRANGE(LOCAL, 0, CHARANUM)
			PRINTFORML 「%CALLNAME:LOCAL%가 죽었다... 얼마나 불운한 일일까...」
			RESETCOLOR
			CALL FIND_DEATH(29,LOCAL,1)
		ELSE
		ENDIF
	CASE 5
		CALL SET_KOJO_COLOR(29)
		PRINTFORML 「특정 캐릭터를 지정하면 진영들이 공격하는 것을 막는 데이트 휴전 조약을 제출할 수 있다.」
		PRINTFORML 「그것은 그들(진영)이 싸움을 시작하는 것도 불가능하게 만든다는 점을 염두에 두라.」
		RESETCOLOR
		CALL SHOW_CHARA_LIST_TR("NoDatingTruce")
		LOCAL = RESULT
		IF INRANGE(LOCAL, 0, CHARANUM)
			IF FactionDateTruce:LOCAL:0
				PRINTFORMW 「%CALLNAME:LOCAL%은(는) 이미 데이트 휴전 상태이다.」
				RESETCOLOR
				RESTART
			ENDIF
			RESETCOLOR
			CALL FACTION_DATE_TRUCE(LOCAL)
		ELSE
		ENDIF
	CASE 6
		CALL SET_KOJO_COLOR(29)
		PRINTFORML 「데이트 휴전을 철회하면 그들은 파벌들의 표적이 될 것이다.」
		PRINTFORML 「또한 이것은 당신이 그들을 싸우게 할 수도 있다는 것을 의미한다..」
		RESETCOLOR
		CALL SHOW_CHARA_LIST_TR("NoDatingTruce")
		LOCAL = RESULT
		IF INRANGE(LOCAL, 0, CHARANUM)
			IF !FactionDateTruce:LOCAL:0
				PRINTFORMW 「%CALLNAME:LOCAL%는 휴전 상태가 없다.」
				RESETCOLOR
				RESTART
			ENDIF
			RESETCOLOR
			CALL FACTION_RENOUNCE_DATE_TRUCE(LOCAL)
		ELSE
		ENDIF
	CASEELSE
		RETURN -1
ENDSELECT
