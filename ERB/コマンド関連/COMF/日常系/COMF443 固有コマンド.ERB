@UNIQUE_COM_おみくじ契約
#DIM おみくじ代
CALL SET_KOJO_COLOR([[霊夢]]) ;custom code
IF FLAG:おみくじ契約
	PRINTFORML 「이미 계약을 체결했다.」
	RETURN -1
ENDIF
IF !MAIN_MAP
	おみくじ代 = 30
ELSE
	おみくじ代 = 50
ENDIF
