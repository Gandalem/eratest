;-------------------------------------------------
;文用
;-------------------------------------------------
@UNIQUE_COM_新聞購読
#DIM R_ID
#DIM C_ID
#DIM LINE_BREAK
VARSET R_ID

CALL SET_KOJO_COLOR(29)
PRINTFORML 「What can I do for you?」
RESETCOLOR
{
CALL ASK_M("Subscribe to newspaper", !FLAG:新聞購読,
"Spread good news about me", !GETBIT(ReputationKnow:29:0,17),
"I don't want this rumor floating around anymore", 1,
"Clear my name", 1,
"Report a death", nNecro,
"File a Dating Truce", nFactions,
"Renounce a Dating Truce", nFactions,
"Get me out of here!", 1)
}
SELECTCASE RESULT
CASE 0
IF FLAG:新聞購読
	CALL SET_KOJO_COLOR(29)
	PRINTFORML 「You already have a subscription...」
	RESETCOLOR
	RETURN -1
ENDIF
CALL SET_KOJO_COLOR(29)
PRINTFORML 「Know what's happening in Gensokyo right *now* for just %金額表示(3000)% per month! Why not subscribe to Bunbunmaru newspaper?!」
PRINTFORML 「We also offer an online version for those with computers at %WebSitesNames:7%!」
WebSitesKnown:7 = 1
RESETCOLOR
CALL ASK_M("No thank you",1,"Subscribe with money",MONEY >= 3000,"Subscribe with charisma",MONEY:2 >= 10)
SELECTCASE RESULT
	CASE 0
		RETURN -1
	CASE 1
		CALL PAY_MONEY_YEN(3000, 2) ;custom code
	CASE 2
		CALL PAY_MONEY_CM(10, 2) ;custom code
ENDSELECT
PRINTFORMDW Decided to subscribe to the Bunbunmaru newspaper.
PRINTFORMDW The contract renews on the first of each month.
FLAG:新聞購読 = 1
CASE 1
	LOCAL = 50000 + (FakeNews * 10000)

	CALL SET_KOJO_COLOR(29)
	IF FakeNews >= 5
	PRINTFORML 「Look, you can't just use me as a way to spread fake news about you anymore.」
	PRINTFORML 「Do that shit again and I'll ruin your fucking reputation.」
	CALL SET_REP(29,17,,)
	RETURN -1
	ELSE
	PRINTFORML 「Okay, I can give you a good reputation with others for a decent price」
	PRINTFORML 「How about %"\\"+DIGIT_GROUP(LOCAL)%?」
	ENDIF
	RESETCOLOR
	CALL ASK_M("Yes!", MONEY >= LOCAL, "No.", 1)
	SELECTCASE RESULT
	CASE 0
	MONEY -= LOCAL
	FakeNews ++
	DidFakeNews = 1
	CASE 1
	RETURN -1
	ENDSELECT
CASE 2
CALL SET_KOJO_COLOR(29)
PRINTFORML 「What negative reputation do you want others to forget?」
RESETCOLOR
	PRINTFORML 
		FOR C_ID,1,CHARANUM
			FOR LOCAL,0,REP_NUM
				IF GETBIT(ReputationKnow:C_ID:0,LOCAL)
					SIF LINEISEMPTY()
						PRINT 　
					SIF !GETBIT(R_ID, LOCAL)
					PRINTFORMLC [{LOCAL}] - %GET_STR(C_ID, "Reputation", LOCAL, "Name")%
					SETBIT R_ID, LOCAL
					LINE_BREAK ++
					SIF LINE_BREAK % (PRINTCPERLINE() - 1) == 0
						PRINTL 
				ENDIF
				RESETCOLOR        
			NEXT
		NEXT
	PRINTL
	PRINTFORML [999] - Get me out of here!
	INPUT
	LOCAL = RESULT
	IF INRANGE(LOCAL, 0, REP_NUM)
		PRINTFORML 「Okay, I can make others forget you were a 【%GET_STR(29, "Reputation", LOCAL, "Name")%】」
		PRINTFORML 「How about %"\\"+DIGIT_GROUP(50000)%?」
		RESETCOLOR
		CALL ASK_M("Yes!", MONEY >= 50000, "No.", 1)
		SELECTCASE RESULT
		CASE 0
		MONEY -= 50000
		DisregardRep = LOCAL
		CASE 1
		RETURN -1
		ENDSELECT
	ELSE
	ENDIF
CASE 3
	LOCAL = 500000

	CALL SET_KOJO_COLOR(29)
	PRINTFORML 「I can wipe all of your reputation and give you a fresh slate.」
	PRINTFORML 「This esentially gives you a new identity.」	
	PRINTFORML 「How about %"\\"+DIGIT_GROUP(LOCAL)%?」
	RESETCOLOR
	CALL ASK_M("Yes!", MONEY >= LOCAL, "No.", 1)
	SELECTCASE RESULT
	CASE 0
		PRINTFORML %PARSE("Your")% reputation has been cleared.
		MONEY -= LOCAL
		FOR C_ID,1,CHARANUM
			VARSET ReputationKnow:C_ID:0
		NEXT
	CASE 1
	RETURN -1
	ENDSELECT	
CASE 4
CALL SET_KOJO_COLOR(29)
PRINTFORML 「That's tragic...」
PRINTFORML 「Who was the one that suffered through this fate?」
RESETCOLOR
	PRINTFORML 
		FOR C_ID,1,CHARANUM
			SIF !IsDead:C_ID:0
				CONTINUE
			SIF KnowsDeadBodies:29:C_ID
				CONTINUE
			SIF LINEISEMPTY()
				PRINT 　
			PRINTFORMLC [{C_ID}] - %NAME:C_ID%
			LINE_BREAK ++
			SIF LINE_BREAK % (PRINTCPERLINE() - 1) == 0
				PRINTL 
		NEXT
	PRINTL
	PRINTFORML [999] - Get me out of here!
	INPUT
	LOCAL = RESULT
	IF INRANGE(LOCAL, 0, CHARANUM)
		PRINTFORML 「%CALLNAME:LOCAL% died... How unfortunate...」
		RESETCOLOR
		CALL FIND_DEATH(29,LOCAL,1)
	ELSE
	ENDIF
CASE 5
	CALL SET_KOJO_COLOR(29)
	PRINTFORML 「I can file a Dating Truce which prevents factions from attacking characters you specify.」
	PRINTFORML 「Keep in mind that it'll make them unable to initiate fights either.」
	RESETCOLOR
	CALL SHOW_CHARA_LIST_TR("NoDatingTruce")
	LOCAL = RESULT
	IF INRANGE(LOCAL, 0, CHARANUM)
		IF FactionDateTruce:LOCAL:0
			PRINTFORMW 「%CALLNAME:LOCAL% already has a dating truce.」
			RESETCOLOR
			RESTART
		ENDIF
		RESETCOLOR
		CALL FACTION_DATE_TRUCE(LOCAL)
	ELSE
	ENDIF
CASE 6
	CALL SET_KOJO_COLOR(29)
	PRINTFORML 「Renouncing a dating truce will make them a target to factions.」
	PRINTFORML 「This also means you can have them fight as well..」
	RESETCOLOR
	CALL SHOW_CHARA_LIST_TR("NoDatingTruce")
	LOCAL = RESULT
	IF INRANGE(LOCAL, 0, CHARANUM)
		IF !FactionDateTruce:LOCAL:0
			PRINTFORMW 「%CALLNAME:LOCAL% has no dating truce.」
			RESETCOLOR
			RESTART
		ENDIF
		RESETCOLOR
		CALL FACTION_RENOUNCE_DATE_TRUCE(LOCAL)
	ELSE
	ENDIF
CASEELSE
RETURN -1
ENDSELECT

