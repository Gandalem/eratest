@COM401
#DIM 種類
;NAS: Replaced
CALL COM401_PANTY_REWORK
RETURN RESULT

FLAG:700 = 0
FOR LOCAL,1,CHARANUM
	FOR 種類,0,MAXPANTS
		CFLAG:LOCAL:(種類 + パンツ管理) += PANTS_TEMP:LOCAL:種類
		SIF PANTS_TEMP:LOCAL:種類
		PRINTFORML %@"%CALLNAME:LOCAL%'s", 15, LEFT% %PANTSNAME(種類, LOCAL, 1), 36, LEFT% - added to the collection
		PANTS_TEMP:LOCAL:種類 = 0
		CFLAG:LOCAL:293 = 0
		SIF CFLAG:LOCAL:(種類 + パンツ管理)
			FLAG:700 ++
	NEXT
NEXT
FLAG:パンツ輸送 = 0

PRINTFORMW Your collection has \@FLAG:700>1?{FLAG:700} different kinds#1 pair\@ of panties now.
RETURN 1

;コレクション
@COM_ABLE401
;移動実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(401)
	RETURN RESULT
;私室設定
; SIF CFLAG:MASTER:現在位置 != CFLAG:MASTER:311
; 	RETURN 0
IF GETBIT(NAS_PAIL,4) || SaveIsEZB
	SIF CFLAG:MASTER:現在位置 != CFLAG:MASTER:311 && !BATHROOM(CFLAG:MASTER:300) && !IN_TOILET(CFLAG:MASTER:300) && !FISHING_SPOT(CFLAG:MASTER:現在位置) && ((SaveIsEZB && CFLAG:MASTER:300 != 201) || !SaveIsEZB)
		RETURN 0
ELSE
	SIF CFLAG:MASTER:現在位置 != CFLAG:MASTER:311
		RETURN 0
ENDIF

;SIF CSTR:MASTER:12 == ""
SIF !FLAG:パンツ輸送
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
RETURN 1