;願掛け
;日常系コマンド、レベル1
;-------------------------------------------------

@COM421
PRINTL 소원을 빌어라.
$INPUT_LOOP
SIF !IS_RELIGIONS(MASTER)
	GOTO NoReligion
;NAS: Religions
PRINTFORM 오늘 기도한다: {TFLAG:DidPray} 
SIF GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, "Prays per Day")
	PRINTFORML (필수: {GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, "Prays per Day")})
PRINTL
PRINTFORML [ 0] 운명의 붉은 실들을 엮는다(%金額表示(1000)%)$$
SIF HAS_PENIS(MASTER)
	PRINTFORML [ 1] 무한한 성적 체력 (%金額表示(3000)% 이다)
PRINTFORML [ 2] - 마음의 평화 (%金額表示(3000)%)
PRINTFORML [ 3] - 가슴 가슴(%金額表示(3000)%)
;added
PRINTFORML [ 4] - 오시리 오시리(%金額表示(3000)%)
SIF GET_RELIGION_PRECEPT(MASTER, "Panty Stealing") > 0
	PRINTFORML [10] - 소녀의 팬티다! 내게 줘!! (%金額表示(5000)% 경)
PRINTFORML [15] - 모두를 흥분시킨다 (%金額表示(10000)%을/를)
SIF TARGET != MASTER && ABL:サドっ気 >= 1
	PRINTFORML [16] - %COND_STR(@"Cutest-in-all-Gensokyo-", TALENT:恋人)%%조사처리(CALLNAME:TARGET,"는")% 너무 강압적이다. 무언가를 해라.
SIF TARGET != MASTER
	PRINTFORML [20] - %COND_STR(@"Cutest-in-all-Gensokyo-", TALENT:恋人)%%조사처리(CALLNAME:TARGET,"를")% 좀 더 도착적으로 만들어라
SIF TALENT:TARGET:恋慕 && !TALENT:妊娠 ;com custom code for below line
	PRINTFORML [21] - 아이를 위해 기도하기 (%조사처리(CALLNAME:TARGET,"의")% 현재 임신 기도 상태 {CFLAG:子宝補正}, 현재 기도의 대상은 \@ FLAG:子宝祈願 > 0 ? %CALLNAME:(FLAG:子宝祈願)% # 없음 \@)
;addition custom code, from KR version
PRINTFORML [22] - 나의 연인을 좀 더 감수성 있게 만들어줘!
SIF TARGET && CFLAG:PullOutPromiseDenied ;pullout promise patch
	PRINTFORML [23] 나는 %조사처리(CALLNAME:TARGET,"의")% 나에 대한 신뢰를 회복시키고 그녀와 다시 거칠게 관계를 맺고 싶어! 제때 빠질 거라고 약속해!
PRINTFORML [30] - 화가 난 여자들에 대해 뭔가 조치를 취해야 한다
;addition custom code, from KR version
PRINTFORML [31] - 당신을 협박할 수 있는 여자들에 대해 무언가 조치가 취해져야 한다.
;NAS: regression marks
SIF nAdultBaby
	PRINTFORML [32] - 퇴행한 소녀들에 대해 뭔가 조치가 취해져야 한다.
;21/08/27 反発履歴削除追加
PRINTFORML [35] 특정 소녀의 과거 실수에 대한 기억을 지운다.
SIF CFLAG:MASTER:魔力回収 && CFLAG:MASTER:小槌 < 6
	PRINTFORML [40] - 기적의 도구 효과 제거한다
SIF FLAG:開運大紋購入回数 > 10
	PRINTFORML [50] 부도덕한 상인들에게 내리는 신의 징벌이다!
SIF CAN_DOWSING()
	PRINTFORML [60] - 아무것도 찾을 수 없어
;NAS: New Spells
SIF (nPee || nScat)
	PRINTFORML [900] - \@ TARGET != MASTER ? 나의 %PRINT_MALE("husband",TARGET)% # 나에게 \@ 더 남자다운 방광을 주세요.
SIF (nPee || nScat) && (PeeHold:TARGET:0 < 5 || PooHold:TARGET:0 < 5)
	PRINTFORML [901] - 부디 도와주세요 \@ TARGET != MASTER ? 저의 %PRINT_MALE("husband",TARGET)% # 나를 \@ with \@ TARGET != MASTER ? %HIS_HER(TARGET)% # 나의 \@ 실금에.
PRINTFORML [988] 믿음을 위해 기도하라
PRINTL
$NoReligion
SIF TALENT:MASTER:Religion == 19
	PRINTFORML [989] 나의 종교의 교리를 바꾼다.
PRINTFORML [990] - 나는 이 종교가 후회되고 다른 것을 믿고 싶다.
PRINTL [999] - 신경 쓰지 마라
INPUT
SIF RESULT == 999
	RETURN -1
IF RESULT == 0
	IF MONEY < 1000
		PRINTL 돈이 충분하지 않다.
		GOTO INPUT_LOOP
	ENDIF
	PRINTL 「누가 너를 생각하고 내일 방문할 거라고 생각해?」
	CALL SHOW_CHALALIST
	PRINTL 
	PRINTL [999] 신경 쓰지 마.
	INPUT
	IF !INRANGE(RESULT,1,CHARANUM)
		RETURN -1
	ELSE
		CALL GANKAKE_0(RESULT)
		MONEY -= 1000
		CALL NAS_PrayerEnd(MASTER,10)
	ENDIF
	;精力絶倫
ELSEIF RESULT == 1
	IF MONEY < 3000
		PRINTL 돈이 충분하지 않다.
		GOTO INPUT_LOOP
	ENDIF
	MONEY -= 3000
	FLAG:願掛け内容 = 200
	IF EXP:MASTER:11 > (100 + FLAG:561 * 100) && FLAG:561 < 11
		LOCAL += 100
		FLAG:561 += 1
	ENDIF
	CALL BUFF_BASE(MASTER,BASE_精力,500)
	FLAG:71 ++
	CALL NAS_PrayerEnd(MASTER,30)
	;心の平安
ELSEIF RESULT == 2
	IF MONEY < 3000
		PRINTL 돈이 충분하지 않다.
		GOTO INPUT_LOOP
	ENDIF
	MONEY -= 3000
	CALL BUFF_BASE(MASTER,BASE_気力,500)
	FLAG:願掛け内容 = 201
	FLAG:71 = 0
ELSEIF RESULT == 3
	IF MONEY < 3000
		PRINTL 돈이 부족하다.
		GOTO INPUT_LOOP
	ENDIF
	MONEY -= 3000
	PRINTFORML 당신은 가슴으로만 마음을 채우며 두 손을 모았다.
	TFLAG:OPPAI = 1
	CALL NAS_PrayerEnd(MASTER,30)
ELSEIF RESULT == 4
	IF MONEY < 3000
		PRINTL 돈이 충분하지 않다.
		GOTO INPUT_LOOP
	ENDIF
	MONEY -= 3000
	PRINTFORML 당신은 머릿속을 오직 '엉덩이'로 채우면서 두 손을 모았다.
	TFLAG:OSHIRI = 1
	CALL NAS_PrayerEnd(MASTER,30)
ELSEIF RESULT == 10
	IF MONEY < 5000
		PRINTL 돈이 충분하지 않다.
		GOTO INPUT_LOOP
	ELSE
		MONEY -= 5000
		FLAG:願掛け内容 = 202
		CALL NAS_PrayerEnd(MASTER,50)
	ENDIF
ELSEIF RESULT == 15
	IF MONEY < 10000
		PRINTL 돈이 충분하지 않다.
		GOTO INPUT_LOOP
	ELSE
		MONEY -= 10000
		FLAG:願掛け内容 = 203
		CALL NAS_PrayerEnd(MASTER,100)
	ENDIF
ELSEIF RESULT == 16 && ABL:サドっ気
	CALL IKENIE(TARGET,7)
ELSEIF RESULT == 20 && TARGET != 0
	CALL IKENIE(TARGET,2)
ELSEIF RESULT == 21 && TALENT:TARGET:恋慕
	IF FLAG:子宝祈願 > 0 && FLAG:子宝祈願 != TARGET ;com custom code
		PRINTFORML 현재 당신이 쌓아온 모든 기도들이 다른 대상에게로 바꾸면 사라질 것만 같은 기분이 드는군요...
		PRINTFORML 진행하시겠습니까?
		CALL ASK_YN
		SIF RESULT
			RESTART
	ENDIF
	;-----------------------------------
	CALL IKENIE(TARGET,6)
ELSEIF RESULT == 30
	PRINTL 누구?
	DRAWLINE
	FOR LOCAL,1,CHARANUM
	SIF MARK:LOCAL:反発刻印 && !CFLAG:LOCAL:出禁
		PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
	NEXT
	PRINTL 
	DRAWLINE
	PRINTL [999] 신경 쓰지 마.
	INPUT
	IF RESULT >= 1 && RESULT <= CHARANUM && MARK:RESULT:反発刻印
		CALL IKENIE(RESULT,1)
	ELSE
		RETURN -1
	ENDIF
ELSEIF RESULT == 35
	PRINTL 누가?
	DRAWLINE
	FOR LOCAL,1,CHARANUM
	SIF !MARK:LOCAL:反発刻印 && MARK:LOCAL:反発取得履歴 && !CFLAG:LOCAL:出禁
		PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
	NEXT
	PRINTL 
	DRAWLINE
	PRINTL [999] 신경 쓰지 마.
	INPUT
	IF RESULT >= 1 && RESULT <= CHARANUM && !MARK:RESULT:反発刻印 && MARK:RESULT:反発取得履歴
		CALL IKENIE(RESULT,8)
	ELSE
		RETURN -1
	ENDIF
ELSEIF RESULT == 40 && CFLAG:MASTER:魔力回収 && CFLAG:MASTER:小槌 < 6
	CALL IKENIE(71,3)
ELSEIF RESULT == 50 && FLAG:開運大紋購入回数 > 10
	CALL IKENIE(53,5)
ELSEIF RESULT == 60 && CAN_DOWSING()
	CALL DOWSING_PANTS
	;addition custom code
ELSEIF GROUPMATCH(RESULT, 22, 31)
	CALL Add_GodPrayer(RESULT)
	SIF RESULT
		RETURN RESULT
ELSEIF TARGET && CFLAG:PullOutPromiseDenied ;pullout promise patch
	CALL IKENIE(TARGET,999)
	;NAS: New Prayers
ELSEIF RESULT == 32
	; regression
	PRINTL 누구?
	DRAWLINE
	FOR LOCAL,1,CHARANUM
	SIF MARK:LOCAL:RegressionMark && !CFLAG:LOCAL:出禁
		PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
	NEXT
	PRINTL 
	DRAWLINE
	PRINTL [999] 신경 쓰지 마.
	INPUT
	IF RESULT != MASTER && RESULT <= CHARANUM && MARK:RESULT:RegressionMark
		CALL IKENIE(RESULT,32)
	ELSE
		RETURN -1
	ENDIF
ELSEIF RESULT == 900
	; Bladder
	CALL IKENIE(TARGET,900)
ELSEIF RESULT == 901
	; continence
	IF !GET_RELIGION_PRECEPT(TALENT:TARGET:Religion, @"Incontinence")
		CALL ASK_M(@"절제에 축복을 내린다",1, @"절제불능을 축복하라",1)
		SELECTCASE RESULT
			CASE 0
				GOTO Con901
			CASE 1
				GOTO Incon901
		ENDSELECT
	ELSEIF GET_RELIGION_PRECEPT(TALENT:TARGET:Religion, @"Incontinence") > 0
		$Incon901
		PRINTFORML 절제력의 축복
		CALL IKENIE(TARGET,9011)
	ELSEIF GET_RELIGION_PRECEPT(TALENT:TARGET:Religion, @"Incontinence") < 0
		$Con901
		PRINTFORML 절제력의 축복
		CALL IKENIE(TARGET,9010)
	ENDIF
ELSEIF RESULT == 988
	PRINTFORML 당신은 아무런 제물도 없이 %PantsuSama(MASTER)%에게 기도한다.
	CALL NAS_PrayerEnd(MASTER,10)
ELSEIF RESULT == 989
	;NAS: Own Religion
	CALL YourReligionChange()
ELSEIF RESULT == 990
	;NAS: Religion
	PRINTFORML 「어떤 종교로 스스로 개종하고 싶으신가요?」
	FOR LOCAL, 0, 19
	SIF STRLENS(TOSTR_Religion(LOCAL)) && LOCAL != 11
		PRINTFORML [{LOCAL}] - %TOSTR_Religion(LOCAL)%
	NEXT
	IF !STRLENS(YourReligionSTR)
		PRINTFORML [19] - 종교 형성
	ELSE
		PRINTFORML [19] - %YourReligionSTR%
	ENDIF
	INPUT
	R = RESULT
	IF RESULT == 19 && !STRLENS(YourReligionSTR)
		CALL YourReligionForm()
	ELSE
		PRINTFORML 당신은 %TOSTR_Religion(TALENT:MASTER:Religion,1)%에서 %TOSTR_Religion(R,1)%로 전환될 것입니다.
		PRINTFORML 진행하시겠습니까?
		CALL ASK_YN
		IF !RESULT
			charReligionCertainty:MASTER:(TALENT:MASTER:Religion) = 0
			charReligionCertainty:MASTER:R = 1000
			TALENT:MASTER:Religion = R
		ENDIF
	ENDIF
	;=====================================================
ENDIF
DOWNBASE:MASTER:気力 = 100
TIME += 10
RETURN 1
;願掛け

@COM_ABLE421
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;掃除実行判定
SIF !TFLAG:100
	RETURN 0
;すでに今日願掛けしてたら弾く
SIF FLAG:願掛け内容 > 0 && TFLAG:DidPray >= GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, "Prays per Day")
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(421)
	RETURN RESULT
;賽銭箱
SIF !天の声可(CFLAG:MASTER:現在位置) && CFLAG:MASTER:現在位置 != 守矢神社本殿
	RETURN 0
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
RETURN 1
