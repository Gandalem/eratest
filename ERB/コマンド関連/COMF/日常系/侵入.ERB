; Modular ERB: COMF/日常系/侵入.ERB

@部屋に忍び込む(ARG, 直前位置)
#DIM 直前位置
;ARG=行先
FOR LOCAL, 1, CHARANUM
IF CFLAG:LOCAL:311 == ARG
	IF CFLAG:LOCAL:ブチギレ
		IF FLAG:70 == 1
			;時間停止中,現状死に分岐
			PRINTFORML 방에 들어가 문을 열자 극도로 분노한 %CALLNAME:LOCAL%를 발견했다.
			PRINTFORMW 그런 형언할 수 없는 광경을 본 후, 잠입하는 것을 포기한다...
		ELSE
			PRINTFORML 당신은 문을 열고 잠든 %CALLNAME:LOCAL%의 방에 몰래 들어간다.
			PRINTFORMW 하지만 당신은 즉시 당신에게 날카로운 눈빛으로 노려보는 %CALLNAME:(LOCAL)%와 마주하게 된다.
			;部屋へ通しても寝ない仕組みが作れたら解放
			;IF TALENT:LOCAL:恋慕
			;CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,2,2)
			;PRINTFORMW %CALLNAME:LOCAL%はしぶしぶ%CALLNAME:MASTER%を部屋へ通した…
			;移動成立 でも忍び込みは立たない
			;CFLAG:MASTER:現在位置 = (TFLAG:195)
			;ELSE
			CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,2,1)
			PRINTFORMW 너는 잠입을 포기한다...
			;ENDIF
		ENDIF
		;侵入成功フラグクリア
		CLEARBIT CFLAG:LOCAL:42,8
		LOCK:(CFLAG:LOCAL:現在位置) = 1
		CFLAG:MASTER:現在位置 = 直前位置
	ELSE
		IF (!RAND:3 || !CFLAG:LOCAL:睡眠) && !FLAG:70 && !CFLAG:LOCAL:出禁 && !IsDead:LOCAL:0 && !TCVAR:LOCAL:睡眠薬強度 && EXP:LOCAL:睡眠姦経験 < 300
			;PRINT 物音に気づいた
			PRINTFORML %CALLNAME:LOCAL%은(는) 소리를 듣는다.
			CALL CHARA_AWAKE(LOCAL,1)
			IF !CFLAG:LOCAL:睡眠 && CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置 && !CFLAG:LOCAL:隠密中
				IF TALENT:LOCAL:恋慕
					IF CFLAG:LOCAL:衰弱
						PRINTFORMW %CALLNAME:LOCAL%은 하품을 하고 다시 잠들기 전에 확인하고 당신임을 알아낸다...
						CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,3)
						CALL SET_DERAY(99,LOCAL)
						CALL CHARA_SLEEP(LOCAL,0)
					ELSE
						PRINTFORMW %CALLNAME:LOCAL%은(는) 당신이라는 것을 알게 된 %HE_SHE(LOCAL)%가 안도하며 한숨을 쉰다...
						CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,2)
					ENDIF
					;移動成立
					CFLAG:MASTER:現在位置 = ARG
				ELSE
					IF CFLAG:LOCAL:衰弱
						PRINTFORMW %CALLNAME:LOCAL%은(는) 다시 잠들기 전에 당신을 내보낸다.
						CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,5)
						CALL SET_DERAY(99,LOCAL)
						CALL CHARA_SLEEP(LOCAL,0)
					ELSE
						PRINTFORMW %CALLNAME:LOCAL%이 너를 내쫓는다...
						CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,4)
					ENDIF
					;侵入成功フラグクリア
					CLEARBIT CFLAG:LOCAL:42,8
					LOCK:(CFLAG:LOCAL:現在位置) = 1
					CFLAG:MASTER:現在位置 = 直前位置
				ENDIF
			ENDIF
		ELSE
			PRINTFORML 너는 잠든 %CALLNAME:LOCAL%의 방에 몰래 들어간다.
			CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,1)
			;移動成立
			CFLAG:MASTER:現在位置 = ARG
			;侵入成功フラグセット
			SETBIT CFLAG:LOCAL:42,8
		ENDIF
	ENDIF
ENDIF
NEXT
SIF CFLAG:MASTER:現在位置 != ARG
	RETURN -1

@トイレ侵入(ARG,ARG:1)
#DIM 入れません
入れません = 0
PRINTFORM 당신은 문 손잡이를 잡아당기려고 시도한다. 
IF FLAG:70 == 1
	FOR LOCAL, 1, CHARANUM
	IF CFLAG:LOCAL:現在位置 == ARG
		PRINTFORMW %CALLNAME:LOCAL%가 벌써 여기에 있는 것 같다.
		BREAK
	ENDIF
	NEXT
	CFLAG:MASTER:現在位置 = ARG
	;遠距離移動フラグ消去
	SIF ARG:1
		NEXTCOM = -1
ELSE
	FOR LOCAL, 0, CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	IF CFLAG:LOCAL:現在位置 == (TFLAG:195) || CFLAG:LOCAL:現在位置 == ARG
		PRINTFORML 잠겨있다....
		PRINTFORML %CALLNAME:LOCAL%는 화장실에 있는 것 같다.
		CALL KOJO_MESSAGE_SEND("EVENT",11,LOCAL:1,1,0)
		入れません = 1
	ENDIF
	NEXT
	IF 入れません == 1
		入れません = 0
		IF ARG:1
			NEXTCOM = -1
			DEBUGPRINTL 【COM400】RETURNPOINT E
			RETURN 0
		ELSE
			RETURN -1
		ENDIF
	ENDIF
	CFLAG:MASTER:現在位置 = ARG
	PRINTFORML 그것이 열린다!
	WAIT
	;遠距離移動フラグ消去
	SIF ARG:1
		NEXTCOM = -1
ENDIF

@虫かご侵入(ARG,ARG:1)
#DIM 入れません
#DIM 虫かご
入れません = 0
FOR LOCAL, 1, CHARANUM
SIF CFLAG:LOCAL:同行 && TALENT:LOCAL:100 >= -4
	入れません = 1
NEXT
SIF TALENT:MASTER:100 >= -4
	入れません = 2
IF 入れません == 1
	PRINTFORMW 현재 팔로우하고 있는 존재를 데리고 오는 것은 불가능하다…
	RETURN -1
ELSEIF 入れません
	PRINTDATAW
		DATAFORM 그것은 벌레통이다.
		DATAFORM 안에는 들어갈 방법이 없다!
		DATAFORM 오직 난쟁이들만 들어갈 수 있다.
	ENDDATA
	IF ARG:1
		NEXTCOM = -1
		DEBUGPRINTL 【COM400】RETURNPOINT D
		RETURN 0
	ELSE
		虫かご += 1
		IF 虫かご >= 10 && !FLAG:70
			PRINTFORMW 당신은 안으로 들어가려는 것에 너무 집착해서 미아(inchling)가 된다.
			;半永続する
			TALENT:MASTER:100 = -5
			虫かご = 0
		ENDIF
		RETURN -1
	ENDIF
ENDIF
CFLAG:MASTER:現在位置 = ARG
SIF ARG:1
	NEXTCOM = -1
