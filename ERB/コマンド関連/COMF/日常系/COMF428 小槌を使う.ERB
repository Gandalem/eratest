; Modular ERB: COMF/日常系/COMF428 小槌を使う.ERB
;-------------------------------------------------
;小槌を使う
;日常系コマンド、レベル1
;-------------------------------------------------

@COM428
#DIM CHARA
CALL SET_KOJO_COLOR(71)
SIF FLAG:なりきり != 71
	CALL SPTALK, [[針妙丸]], "通常", 1, @"「사용될 준비가 되었다.」", 1
RESETCOLOR
PRINTL 당신의 소원은 무엇입니까?
SIF (TALENT:71:体型 != 0 || TALENT:146:体型 != 0 || TALENT:147:体型 != 0 || TALENT:148:体型 != 0) && CFLAG:[[針妙丸]]:現在位置 != 54
	PRINTL [2] 인슐링을 보통 크기로 만든다.
IF GETBIT(TALENT:MASTER:性別,1)
	PRINTL [3] - 경이로운 페니스!
	PRINTL [4] - 인간에게 어울리지도 않는 무언가!
ENDIF
SIF TALENT:MASTER:体型 >= -4
	PRINTL [5] 나를 작은 아이로 만들어줘!
SIF TALENT:MASTER:体型 < -4 && CFLAG:MASTER:小槌 == 6
	PRINTL [6] - 원래 크기로 돌아가 줘...
PRINTL [7] 나를 거인으로 만들어줘!
;addition custom code
PRINTL [93] 나 더 많이 존재하고 싶어!
PRINTL 
PRINTL [100] - 반환
$LOOP
INPUT
IF RESULT == 2 && CFLAG:[[針妙丸]]:現在位置 != 54
	PRINTFORML 정상 크기로 만들고 싶은 것을 선택하라
	DRAWLINE
	FOR LOCAL, 0, CHARANUM-1
	SIF TALENT:LOCAL:体型 >= -4
		CONTINUE
	PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
	NEXT
	PRINTFORML
	PRINTFORML
	PRINTFORML [999] 취소
	INPUT
	CHARA = RESULT
	SIF !INRANGE(CHARA,0,CHARANUM)
		RETURN -1
	PRINTFORMW 소망은 망치에 의해 이루어졌다.
	PRINTFORMW %CALLNAME:CHARA%의 몸이 인간 크기가 되었다.
	;Custom code, stores her pre-change height, in case she's not an inchling
	CFLAG:CHARA:382 = TALENT:CHARA:形状
	CFLAG:MASTER:小槌 = 8
	TALENT:CHARA:体型 = 0
ELSEIF RESULT ==  3 && GETBIT(TALENT:MASTER:性別,1)
	PRINTW 그 소원은 망치에 의해 이루어졌다.
	PRINTW 숨길 수 없는 무언가가 자라났다.
	CFLAG:MASTER:小槌 = 4
	CFLAG:MASTER:382 = TALENT:MASTER:形状
	TALENT:MASTER:形状 = 10
	CFLAG:MASTER:魔力回収 = 6
	FLAG:MALLET_BACKLASH = !RAND:4 ;qol custom code, only a 1/4th chance of backlash
ELSEIF RESULT == 4 && GETBIT(TALENT:MASTER:性別,1)
	PRINTW 망치에 의해 소원이 이루어졌다.
	PRINTW 또 하나가 자란 것 같다.
	CFLAG:MASTER:382 = TALENT:MASTER:形状
	CFLAG:MASTER:小槌 = 5
	TALENT:MASTER:183 = 1
	CFLAG:MASTER:魔力回収 = 6
	FLAG:MALLET_BACKLASH = !RAND:4 ;qol custom code, only a 1/4th chance of backlash
ELSEIF RESULT == 5 && TALENT:MASTER:100 >= -4
	PRINTFORMW 소망은 망치에 의해 이루어졌다.
	PRINTFORMW 당신의 몸은 어린아이 크기로 줄어들었다.
	CFLAG:MASTER:魔力回収 = 3
	CFLAG:MASTER:小槌 = 6
	FLAG:元の体格 = TALENT:MASTER:100
	TALENT:MASTER:体型 = -5
ELSEIF RESULT == 6 && TALENT:MASTER:体型 < -4 && CFLAG:MASTER:現在位置 == 54
	CALL SET_KOJO_COLOR(71)
	PRINTFORMW 「여기서 그런 짓 하지 마!」
	RESETCOLOR
	RETURN -1
ELSEIF RESULT == 6 && (TALENT:MASTER:体型 < -4 || TALENT:MASTER:100 > 4)
	PRINTFORMW 그 소원은 망치에 의해 이루어졌다.
	PRINTFORMW 당신의 몸은 원래 크기로 돌아간다.
	TALENT:MASTER:体型 = FLAG:元の体格
	CFLAG:MASTER:魔力回収 = 3
	CFLAG:MASTER:小槌 = 7
ELSEIF RESULT == 7 && TALENT:MASTER:体型 <= 4
	PRINTFORMW 그 소원은 망치에 의해 이루어졌다.
	PRINTFORMW 당신의 몸이 크기가 커진다.
	CFLAG:MASTER:魔力回収 = 3
	CFLAG:MASTER:小槌 = 6
	FLAG:元の体格 = TALENT:MASTER:体型
	TALENT:MASTER:100 = 5
ELSEIF RESULT == 93
	PRINTFORMW 소원은 망치에 의해 이루어졌다.
	PRINTFORMW 평소보다 더 많은 자신의 존재를 느끼는 듯하다.
	TEQUIP:MASTER:DOPPELGANGER_MAX = 4
	CFLAG:MASTER:小槌 = 93
	CFLAG:MASTER:魔力回収 = 5
	FLAG:MALLET_BACKLASH = !RAND:3 ;1/3th chance of backlash
ELSEIF RESULT == 100
	SIF FLAG:なりきり != 71
		CALL SPTALK, [[針妙丸]], "笑顔", 1, @"「현명한 결정이군요.」", 1
	RETURN -1
ELSE
	GOTO LOOP
ENDIF
TIME += 5
RETURN 1
;小槌を使う

@COM_ABLE428
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;移動実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(428)
	RETURN RESULT
;針妙丸が寝ていたらダメ
SIF CFLAG:71:睡眠
	RETURN 0
;針妙丸の居る所。針妙丸が虫かごにいる時は居間か縁側にいればセーフ
IF CFLAG:MASTER:現在位置 != CFLAG:71:現在位置 && FLAG:なりきり != 71
	IF CFLAG:71:現在位置 == 54 && (CFLAG:MASTER:現在位置 == 9 || CFLAG:MASTER:現在位置 == 10) && AT_HOME(MASTER)
	ELSE
		RETURN 0
	ENDIF
ENDIF
;SIF CFLAG:MASTER:現在位置 != CFLAG:71:現在位置
;	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
;魔力回収中および針妙丸巨大化中は使用できない
SIF CFLAG:MASTER:魔力回収 > 0 || CFLAG:MASTER:小槌 == 8
	RETURN 0
RETURN 1
