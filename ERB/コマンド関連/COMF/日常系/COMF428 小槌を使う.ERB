;-------------------------------------------------
;小槌を使う
;日常系コマンド、レベル1
;-------------------------------------------------
@COM428
#DIM CHARA

CALL SET_KOJO_COLOR(71)
SIF FLAG:なりきり != 71
	;custom code
	CALL SPTALK, [[針妙丸]], "通常", 1, @"「It's ready to be used.」", 1
RESETCOLOR
PRINTL What is your wish?
SIF (TALENT:71:体型 != 0 || TALENT:146:体型 != 0 || TALENT:147:体型 != 0 || TALENT:148:体型 != 0) && CFLAG:[[針妙丸]]:現在位置 != 54
	PRINTL [2] - Make an inchling normal-sized
IF GETBIT(TALENT:MASTER:性別,1)
	PRINTL [3] - Wondrous penis!
	PRINTL [4] - Something that doesn't even belong on a human!
ENDIF
SIF TALENT:MASTER:体型 >= -4
	PRINTL [5] - Make me an inchling!
SIF TALENT:MASTER:体型 < -4 && CFLAG:MASTER:小槌 == 6
	PRINTL [6] - Return me to original size...
PRINTL [7] - Make me a giant!
;addition custom code
PRINTL [93] - I want there to be more of me!

PRINTL 
PRINTL [100] - Return
$LOOP
INPUT
IF RESULT == 2 && CFLAG:[[針妙丸]]:現在位置 != 54
	PRINTFORML Select who you do you want to be put into normal size
	DRAWLINE
	FOR LOCAL, 0, CHARANUM-1
		SIF TALENT:LOCAL:体型 >= -4
			CONTINUE
		PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
	NEXT
	PRINTFORML
	PRINTFORML
	PRINTFORML [999] Cancel
	INPUT
	CHARA = RESULT	
	SIF !INRANGE(CHARA,0,CHARANUM)
		RETURN -1
	PRINTFORMW The wish has been granted by the mallet.
	PRINTFORMW %CALLNAME:CHARA%'s body has become human-sized
	;Custom code, stores her pre-change height, in case she's not an inchling
	CFLAG:CHARA:382 = TALENT:CHARA:形状
	CFLAG:MASTER:小槌 = 8
	TALENT:CHARA:体型 = 0
ELSEIF RESULT ==  3 && GETBIT(TALENT:MASTER:性別,1)
	PRINTW The wish has been granted by the mallet.
	PRINTW Something impossible to conceal has grown.
	CFLAG:MASTER:小槌 = 4
	CFLAG:MASTER:382 = TALENT:MASTER:形状
	TALENT:MASTER:形状 = 10
	CFLAG:MASTER:魔力回収 = 6
	FLAG:MALLET_BACKLASH = !RAND:4 ;qol custom code, only a 1/4th chance of backlash
ELSEIF RESULT == 4 && GETBIT(TALENT:MASTER:性別,1)
	PRINTW The wish has been granted by the mallet.
	PRINTW Looks like another one has grown.
	CFLAG:MASTER:382 = TALENT:MASTER:形状
	CFLAG:MASTER:小槌 = 5
	TALENT:MASTER:183 = 1
	CFLAG:MASTER:魔力回収 = 6
	FLAG:MALLET_BACKLASH = !RAND:4 ;qol custom code, only a 1/4th chance of backlash
ELSEIF RESULT == 5 && TALENT:MASTER:100 >= -4
	PRINTFORMW The wish has been granted by the mallet.
	PRINTFORMW Your body shrinks to that of an inchling's.
	CFLAG:MASTER:魔力回収 = 3
	CFLAG:MASTER:小槌 = 6
	FLAG:元の体格 = TALENT:MASTER:100
	TALENT:MASTER:体型 = -5
ELSEIF RESULT == 6 && TALENT:MASTER:体型 < -4 && CFLAG:MASTER:現在位置 == 54
	CALL SET_KOJO_COLOR(71)
	PRINTFORMW 「Don't do that here!」
	RESETCOLOR
	RETURN -1
ELSEIF RESULT == 6 && (TALENT:MASTER:体型 < -4 || TALENT:MASTER:100 > 4)
	PRINTFORMW The wish has been granted by the mallet.
	PRINTFORMW Your body returns to its original size.
	TALENT:MASTER:体型 = FLAG:元の体格
	CFLAG:MASTER:魔力回収 = 3
	CFLAG:MASTER:小槌 = 7
ELSEIF RESULT == 7 && TALENT:MASTER:体型 <= 4
	PRINTFORMW The wish has been granted by the mallet.
	PRINTFORMW Your body grows in size.
	CFLAG:MASTER:魔力回収 = 3
	CFLAG:MASTER:小槌 = 6
	FLAG:元の体格 = TALENT:MASTER:体型
	TALENT:MASTER:100 = 5
ELSEIF RESULT == 93
	PRINTFORMW The wish has been granted by the mallet.
	PRINTFORMW You feel like there's more of you than usual.
	TEQUIP:MASTER:DOPPELGANGER_MAX = 4
	CFLAG:MASTER:小槌 = 93
	CFLAG:MASTER:魔力回収 = 5
	FLAG:MALLET_BACKLASH = !RAND:3 ;1/3th chance of backlash
ELSEIF RESULT == 100
SIF FLAG:なりきり != 71
	;custom code
	CALL SPTALK, [[針妙丸]], "笑顔", 1, @"「That's a wise decision.」", 1
	RETURN -1
ELSE
	GOTO LOOP
ENDIF
TIME += 5

RETURN 1

;小槌を使う
@COM_ABLE428
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;移動実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(428)
	RETURN RESULT
;針妙丸が寝ていたらダメ
SIF CFLAG:71:睡眠
	RETURN 0
;針妙丸の居る所。針妙丸が虫かごにいる時は居間か縁側にいればセーフ
IF CFLAG:MASTER:現在位置 != CFLAG:71:現在位置 && FLAG:なりきり != 71
	IF CFLAG:71:現在位置 == 54 && (CFLAG:MASTER:現在位置 == 9 || CFLAG:MASTER:現在位置 == 10) && AT_HOME(MASTER)
	ELSE
	RETURN 0
	ENDIF
ENDIF
;SIF CFLAG:MASTER:現在位置 != CFLAG:71:現在位置
;	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
;魔力回収中および針妙丸巨大化中は使用できない
SIF CFLAG:MASTER:魔力回収 > 0 || CFLAG:MASTER:小槌 == 8
	RETURN 0
RETURN 1