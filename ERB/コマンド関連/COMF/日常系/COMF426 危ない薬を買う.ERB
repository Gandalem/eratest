; Modular ERB: COMF/日常系/COMF426 危ない薬を買う.ERB
;-------------------------------------------------
;危ない薬を買う
;-------------------------------------------------

@COM426
$LOOP
PRINTFORML 구매할 아이템을 선택하세요. 사용 가능한 금액: %金額表示(MONEY)%
PRINTL
VARSET LOCALS
;媚薬
LOCALS = [41] %ITEMNAME_TR(41)%
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(3000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL
IF FLAG:おもらし有効 ;custom code, applies enable urination toggle (i think this whole file is unused?)
	;利尿剤
	LOCALS = [42] %ITEMNAME_TR(42)%
	LOCALS '= @"%LOCALS,24,LEFT%%金額表示(3000), 8, RIGHT%"
	PRINTFORM %LOCALS,48,LEFT%
	PRINTL
ENDIF
;惚れ薬
LOCALS = [250] %ITEMNAME_TR(250)%
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(5000), 8, RIGHT%"
PRINTFORML %LOCALS,48,LEFT% 쉽게 높은 호의를 얻는 방법.
;LOCALS = [2] 豊胸剤　￥2000
LOCALS = [2] Cow Milk
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(2000), 8, RIGHT%"
PRINTFORML %LOCALS,48,LEFT% 이것을 마시면 가슴이 커질지도 모른다.
LOCALS = [501] Chest Shrinking Drug
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(2000), 8, RIGHT%"
PRINTFORML %LOCALS,48,LEFT% 이것을 마시면 가슴이 작아질지도 모른다.
LOCALS = [502] Apoptoxin 4869
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(10000), 8, RIGHT%"
PRINTFORML %LOCALS,48,LEFT% 신이치를 바보로 만드는 약.
LOCALS = [503] Chanko 072
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(10000), 8, RIGHT%"
PRINTFORML %LOCALS,48,LEFT% 신체를 즉시 확대할 수 있는 훈련용 약물이다.
LOCALS = [42] Super "Fun" Drink
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(3000), 8, RIGHT%"
PRINTFORML %LOCALS,48,LEFT% 사라지기 전에 황홀경을 즐겨라
DRAWLINE
PRINTL [100] 취소
INPUT
SELECTCASE RESULT
	CASE 0
		IF MONEY < ITEMPRICE:RESULT
			PRINTW 돈이 충분하지 않다.
			GOTO LOOP
		ELSEIF ITEM:RESULT > 50
			PRINTW 더 이상 못 참겠어.
			GOTO LOOP
		ELSE
			PRINTFORMW %ITEMNAME_TR(RESULT)%을 구매했다.
			ITEM:RESULT += 5
			MONEY -= ITEMPRICE:RESULT
			GOTO LOOP
		ENDIF
	CASE 100
		RETURN -1
	CASEELSE
		GOTO LOOP
ENDSELECT
RETURN 1
