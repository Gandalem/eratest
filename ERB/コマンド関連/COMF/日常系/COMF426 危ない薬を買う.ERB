PRINTFORM %LOCALS,48,LEFT%
PRINTL
IF FLAG:おもらし有効 ;custom code, applies enable urination toggle (i think this whole file is unused?)
	;利尿剤
	LOCALS = [42] %ITEMNAME_TR(42)%
	LOCALS '= @"%LOCALS,24,LEFT%%金額表示(3000), 8, RIGHT%"
	PRINTFORM %LOCALS,48,LEFT%
	PRINTL
ENDIF
;惚れ薬
LOCALS = [250] %ITEMNAME_TR(250)%
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(5000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL Getting high favor the easy way.

;LOCALS = [2] 豊胸剤　￥2000
LOCALS = [2] Cow Milk
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(2000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL Drinking this might make one's chest bigger.
LOCALS = [501] Chest Shrinking Drug
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(2000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL Drinking this might make one's chest smaller.
LOCALS = [502] Apoptoxin 4869
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(10000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL Drug that makes Shinichi an idiot.
LOCALS = [503] Chanko 072
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(10000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL Training drug that can instantly enlarge the body.
LOCALS = [42] Super "Fun" Drink
LOCALS '= @"%LOCALS,24,LEFT%%金額表示(3000), 8, RIGHT%"
PRINTFORM %LOCALS,48,LEFT%
PRINTL Enjoy the euphoria before it goes away
DRAWLINE
PRINTL [100] Cancel
INPUT
SELECTCASE RESULT
	CASE 0
		IF MONEY < ITEMPRICE:RESULT
			PRINTW Not enough money.
			GOTO LOOP
		ELSEIF ITEM:RESULT > 50
			PRINTW Can't hold any more.
			GOTO LOOP
		ELSE
			PRINTFORMW Bought %ITEMNAME_TR(RESULT)%.
			ITEM:RESULT += 5
			MONEY -= ITEMPRICE:RESULT
			GOTO LOOP
		ENDIF
	CASE 100
		RETURN -1
	CASEELSE
		GOTO LOOP
ENDSELECT

RETURN 1