; Modular ERB: COMF/COMF107 拘束プレイ.ERB
;-------------------------------------------------
;拘束
;SM系コマンド、レベル1
;-------------------------------------------------

@COM107
;Custom code: Rape Expansion
;Bypass this
SIF FLAG:70 || TCVAR:無理矢理
	GOTO BYPASS
IF TCVAR:無理矢理
	;when it's rape, it stays rape
	TEQUIP:拘束 = !TEQUIP:拘束
	RETURN
ENDIF
;====================================
IF CFLAG:無理矢理膣射 == 1 && !TEQUIP:拘束 && !ISSKIP()
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 당신이 강제로 안으로 들어왔을 때부터 여전히 당신을 미워하고 있다 %HIM_HER(TARGET)%...
	PRINTFORML [0] 포기해라
	PRINTFORML [1] 다시는 그러지 않겠다고 약속해
	$LOOP
	INPUT
	IF RESULT == 0
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 화가 나서, 당신은 %HIM_HER(TARGET)%에게 구속을 가하는 것을 포기한다.
		RETURN -1
	ELSEIF RESULT == 1
		IF ABL:マゾっ気 >= 3 || (CFLAG:4 + ABL:PLAYER:話術技能 * 100) > 1500
			PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"를")% 설득하고 납득시키는 데 성공한다.
			CFLAG:無理矢理膣射 = 2
		ELSE
			PRINTFORML 네가 무슨 말을 하든, %조사처리(CALLNAME:TARGET,"는")% 너를 용서하지 않을 거야...
			SOURCE:反感 += 10000
			BASE:ムード /= 2
			TFLAG:193 = 1
			RETURN -1
		ENDIF
	ELSE
		GOTO LOOP
	ENDIF
ELSEIF CFLAG:無理矢理膣射 == 3 && !TEQUIP:拘束
	PRINTFORML 당신은 또다시 무례하게 구속에 대해 묻지만, %조사처리(CALLNAME:TARGET,"는")% 그저 차갑게 응시할 뿐이다.
	CALL ASK_YN("미안",@"제지된 상태에서도 %조사처리(CALLNAME:TARGET,"는")% 여전히 사랑스럽다")
	IF RESULT == 0
		PRINTFORML 위험을 감지하고, 즉시 물러났다.
		RETURN -1
	ELSEIF RESULT == 1
		IF ABL:マゾっ気 >= 3 || (CFLAG:4 + ABL:PLAYER:話術技能 * 100) > 3000
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 계속 말을 이어가지만, 결국 당신이 %HIM_HER(TARGET)%을 제압하는 데 성공한다.
			PRINTW 간단해!
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 당신에게서 등을 돌리고 아무 말 없이 %HIS_HER(TARGET)%의 옷을 다시 입기 시작한다.
			CUP:欲情 = 0
			SOURCE:反感 += 10000
			BASE:ムード = 0
			FOR LOCAL,0,CHARANUM
			SIF CFLAG:うふふ == 2
				CALL SET_DERAY(5,LOCAL)
			CALL ENDUFUFU(LOCAL)
			NEXT
			TFLAG:106 = 0
			;PLAYERとの接触位置をリセット
			CALL TOUCH_SET(0,0,0,1)
			;はだけフラグをオフ
			TEQUIP:2 = 0
			TEQUIP:上半身はだけ状態 = 0
			;キャラ全員の服再セッティング
			FOR LOCAL,0,CHARANUM
			CALL CLOTHES_SETTING_TRAIN(LOCAL)
			;上着脱衣済みフラグをオフ
			TEQUIP:LOCAL:5 = 0
			NEXT
			TFLAG:193 = 1
			RETURN 1
		ENDIF
	ENDIF
ENDIF
;-------------------------------------------------
;custom code: Rape Expansion
;neede so we can bypass this check
$BYPASS
;着脱の処理
IF TEQUIP:拘束
	TEQUIP:拘束 = 0
	TCVAR:無理矢理 = 0
ELSE
	TEQUIP:拘束 = 1
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:体力 += 10
DOWNBASE:気力 += 80
SOURCE:苦痛 = 60
SOURCE:恐怖 = 180
SOURCE:屈従 = 100
SOURCE:反感 = 350
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;緊縛経験が高いと消費減少
IF EXP:緊縛経験 < EXPLV:3
	TIMES DOWNBASE:体力 , 1.00
	TIMES DOWNBASE:気力 , 1.00
ELSEIF EXP:緊縛経験 < EXPLV:4
	TIMES DOWNBASE:体力 , 0.90
	TIMES DOWNBASE:気力 , 0.90
ELSE
	TIMES DOWNBASE:体力 , 0.70
	TIMES DOWNBASE:気力 , 0.70
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:緊縛経験 += 1
;同性愛　レズなら戻り値1ゲイなら戻り値2
;IF HETEROSEX(TARGET,PLAYER)
;	EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
;	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
;ENDIF
RETURN 1
;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------

@EQUIP_COM107(ARG)
PRINTL 제지 모드
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:ARG:体力 += 10
SOURCE:ARG:苦痛 += 30
SOURCE:ARG:恐怖 += 180
SOURCE:ARG:屈従 += 50
SOURCE:ARG:反感 += 200
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;緊縛経験が高いと消費減少
LOCAL = 60
IF EXP:ARG:緊縛経験 < EXPLV:3
	TIMES LOCAL , 1.00
ELSEIF EXP:ARG:緊縛経験 < EXPLV:4
	TIMES LOCAL , 0.90
ELSE
	TIMES LOCAL , 0.70
ENDIF
DOWNBASE:ARG:気力 += LOCAL
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:ARG:緊縛経験 ++
EXP:PLAYER:嗜虐快楽経験 += 1
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE107
;custom code: Rape Expansion. Needed or else this will block it
CALL COM_ABLE107_MOD
RETURN RESULT
;拘束プレイ実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(107)
	RETURN RESULT
;縄でしばってるとダメ
SIF TEQUIP:縄
	RETURN 0
;睡眠姦中
SIF CFLAG:イタズラ > 1
	RETURN 0
;停止中は不可
SIF FLAG:70
	RETURN 0
;解除はいつでも可能
SIF TEQUIP:拘束
	RETURN 1
;アイテムを持っているか、アイテムなし設定でないとダメ
SIF ITEM:27 == 0 && NOITEM == 0
	RETURN 0
RETURN 1
