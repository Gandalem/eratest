;二穴挿し
;セックス系派生コマンド
;-------------------------------------------------

@COM71
;addition custom code, handle player duplication
CALL COM71_TR
RETURN RESULT
VARSET LOCAL
LOCAL:1 = MASTER_POSE(SET_V,SET_P,1)
LOCAL:2 = MASTER_POSE(SET_A,SET_P,1)
IF LOCAL:1
	LOCAL = LOCAL:1
ELSEIF LOCAL:2
	LOCAL = LOCAL:2
ENDIF
;LOCAL 二穴挿しされる人
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者（これ設定するのは無理、暫定的にやったけど
TCVAR:116 = LOCAL
TCVAR:LOCAL:116 = PLAYER
;-------------------------------------------------
;挿入部位管理
;-------------------------------------------------
;PLAYERがA,TARGETがV挿入
IF LOCAL == LOCAL:2
	CSTR:10 += @"{LOCAL}/"
	;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
	TCVAR:2 = 1
	;強度
	TCVAR:4 = 1500
	CSTR:PLAYER:10 += @"{LOCAL}/"
	;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
	TCVAR:PLAYER:2 = 2
	;既にＡに挿入中だからこれひつようなくない？
	TCVAR:PLAYER:童貞喪失 = 1
	TCVAR:Ａ喪失発生 = 1
	;強度
	TCVAR:PLAYER:4 = 2500
	;PLAYERがV,TARGETがA挿入
ELSE
	CSTR:PLAYER:10 += @"{LOCAL}/"
	;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
	TCVAR:PLAYER:2 = 1
	;強度
	TCVAR:PLAYER:4 = 1500
	CSTR:10 += @"{LOCAL}/"
	;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
	TCVAR:2 = 2
	TCVAR:TARGET:童貞喪失 = 1
	TCVAR:LOCAL:Ａ喪失発生 = 1
	;強度
	TCVAR:4 = 2500
ENDIF
;addition custom code, twin dicks sets ejaculation point to both holes
IF TALENT:PLAYER:双槍
	TCVAR:2 = 50
	TCVAR:PLAYER:2 = 50
ENDIF
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 220
	SOURCE:PLAYER:快Ｃ = 400
	SOURCE:快Ｃ = 400
	SOURCE:LOCAL:快Ｖ = 400
	SOURCE:LOCAL:快Ａ = 400
	SOURCE:LOCAL:苦痛 = 650
	;処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:LOCAL:処女 == 1
		SOURCE:LOCAL:苦痛 += 2750
	ENDIF
	;再生処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:LOCAL:処女 == 2
		SOURCE:LOCAL:苦痛 += 1750
	ENDIF
	EXP:PLAYER:時姦経験 += 1
ELSE
	DOWNBASE:体力 += 40
	DOWNBASE:気力 += 220
	SOURCE:PLAYER:快Ｃ = 400
	SOURCE:快Ｃ = 400
	SOURCE:性行動 = 500
	SOURCE:屈従 = 1000
	SOURCE:逸脱 = 500
	SOURCE:反感 = 500
	DOWNBASE:LOCAL:体力 += 160
	DOWNBASE:LOCAL:気力 += 350
	SOURCE:LOCAL:快Ｖ = 400
	SOURCE:LOCAL:快Ａ = 400
	SOURCE:LOCAL:情愛 = 300
	SOURCE:LOCAL:性行動 = 300
	SOURCE:LOCAL:苦痛 = 1300
	SOURCE:LOCAL:屈従 = 500
	SOURCE:LOCAL:逸脱 = 500
	SOURCE:LOCAL:反感 = 500
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 500
	SIF TALENT:LOCAL:自己愛 < 0 || TALENT:LOCAL:抵抗
		SOURCE:LOCAL:鬱屈 += 500
	;貞操観念持ちで恋慕、親愛持ち以外には常に反発のソースを追加する（セックス系のみ）
	SIF TALENT:LOCAL:貞操 && !TALENT:LOCAL:恋慕
		SOURCE:LOCAL:反感 += 1000
	;処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:LOCAL:処女 == 1
		SOURCE:LOCAL:苦痛 += 5500
		SOURCE:LOCAL:反感 += 3000
	ENDIF
	;再生処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:LOCAL:処女 == 2
		SOURCE:LOCAL:苦痛 += 3500
		SOURCE:LOCAL:反感 += 1000
	ENDIF
ENDIF
;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(LOCAL)
;Aへの苦痛は先に処理しておく
CALL PAIN_CHECK_A(LOCAL)
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;PLAYERがV,TARGETがA挿入
IF LOCAL == LOCAL:1
	;膣内に破瓜の血の汚れを付加
	SIF TALENT:LOCAL:処女 && TALENT:処女 != -1
		STAIN:LOCAL:6 |= 64
	;LOCALの膣内⇔主人のＰの汚れが移動
	IF HAS_PENIS(MASTER)
		STAIN:PLAYER:2 |= STAIN:LOCAL:6
		STAIN:PLAYER:2 |= STAIN:LOCAL:3
		STAIN:LOCAL:6 |= STAIN:PLAYER:2
		STAIN:LOCAL:3 |= STAIN:PLAYER:2
	ENDIF
	;LOCALのＡ⇔TARGETのＰの汚れが移動
	IF HAS_PENIS(TARGET)
		STAIN:2 |= STAIN:LOCAL:7
		STAIN:2 |= STAIN:LOCAL:4
		STAIN:LOCAL:7 |= STAIN:2
		STAIN:LOCAL:4 |= STAIN:2
	ENDIF
ELSE
	;膣内に破瓜の血の汚れを付加
	SIF TALENT:LOCAL:処女 && TALENT:処女 != -1
		STAIN:LOCAL:6 |= 64
	;LOCALの膣内⇔TARGETのＰの汚れが移動
	IF HAS_PENIS(MASTER)
		STAIN:2 |= STAIN:LOCAL:6
		STAIN:2 |= STAIN:LOCAL:3
		STAIN:LOCAL:6 |= STAIN:2
		STAIN:LOCAL:3 |= STAIN:2
	ENDIF
	;LOCALのＡ⇔PLAYERのＰの汚れが移動
	IF HAS_PENIS(TARGET)
		STAIN:PLAYER:2 |= STAIN:LOCAL:7
		STAIN:PLAYER:2 |= STAIN:LOCAL:4
		STAIN:LOCAL:7 |= STAIN:PLAYER:2
		STAIN:LOCAL:4 |= STAIN:PLAYER:2
	ENDIF
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:PLAYER:挿入経験 ++
;EXP:LOCAL:Ａ経験 ++
EXP:LOCAL:Ｖ性交経験 ++
EXP:LOCAL:Ａ性交経験 ++
EXP:挿入経験 ++
;異常経験
IF TALENT:LOCAL:処女  && TALENT:処女 != -1 && !GETBIT(CFLAG:3,9)
	EXP:LOCAL:異常経験 += 2
	SETBIT CFLAG:LOCAL:3,9
ENDIF
IF LOCAL == TARGET
	IF FLAG:70 == 1
		IF HETEROSEX(LOCAL,PLAYER)
			EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		ENDIF
		EXP:PLAYER:時姦経験 += 1
	ELSE
		;同性愛　レズなら戻り値1ゲイなら戻り値2
		IF HETEROSEX(LOCAL,PLAYER)
			EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
			EXP:LOCAL:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		ENDIF
	ENDIF
ELSE
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF FLAG:70 == 1
		IF HETEROSEX(TARGET,PLAYER)
			EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		ENDIF
		IF HETEROSEX(LOCAL,PLAYER)
			EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		ENDIF
		EXP:PLAYER:時姦経験 += 1
	ELSE
		IF HETEROSEX(TARGET,PLAYER)
			EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 3
			EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		ENDIF
		;同性愛　レズなら戻り値1ゲイなら戻り値2
		IF HETEROSEX(LOCAL,PLAYER)
			EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
			EXP:LOCAL:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		ENDIF
		IF HETEROSEX(TARGET,LOCAL)
			EXP:(50 + HETEROSEX(TARGET,LOCAL)) += 3
			EXP:LOCAL:(50 + HETEROSEX(TARGET,LOCAL)) += 3
		ENDIF
	ENDIF
ENDIF
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE71
;addition custom code, handle player duplication
CALL COM_ABLE71_TR
RETURN RESULT
;二穴挿し実行判定
VARSET LOCAL
LOCAL = MASTER_POSE(SET_V,SET_P,1)
LOCAL:1 = MASTER_POSE(SET_A,SET_P,1)
IF LOCAL
	LOCAL:2 = LOCAL
ELSEIF LOCAL:1
	LOCAL:2 = LOCAL:1
ENDIF
SIF !TFLAG:100
	RETURN 0
SIF GLOBAL_COMABLE(71)
	RETURN RESULT
;双槍持ちならひとりで可能
IF TALENT:PLAYER:双槍 == 1
	SIF BASE:PLAYER:勃起 < 1000
		RETURN 0
	;自分が挿入してないとダメ
	SIF !LOCAL:2
		RETURN 0
	;bugfix custom code, check if inserted in current target
	SIF LOCAL:2 != TARGET
		RETURN 0
	RETURN 1
ELSE
	;TARGETがオトコ、ふたなりの場合はある程度勃起してないとダメ
	SIF (HAS_PENIS(TARGET)) && BASE:勃起 < 1000
		RETURN 0
	;TARGET以外の誰かに挿入してないとダメ
	SIF !LOCAL:2 || LOCAL:2 == TARGET
		RETURN 0
	;相手が処女で、従順4以下・レズっ気4以下の場合はできない（サドならＯＫ）
	IF LOCAL:2 && TALENT:(LOCAL:2):処女
		SIF (ABL:従順 <= 4 || ABL:レズっ気 <= 4) && TALENT:サド == 0
			RETURN 0
	ENDIF
	;潤滑不足で、従順3以下・レズっ気3以下のASSIの場合はできない（サドならＯＫ）
	IF LOCAL:2 && PALAM:(LOCAL:2):潤滑 < PALAMLV:2
		SIF (ABL:従順 <= 3 || ABL:レズっ気 <= 3) && TALENT:サド == 0
			RETURN 0
	ENDIF
ENDIF
;毒人形だと性器がついてないのでダメ
SIF TALENT:196 == 99
	RETURN 0
;オトコだとダメ
;SIF LOCAL:2 && !(TALENT:(LOCAL:2):2 & 1)
SIF LOCAL:2 && !HAS_VAGINA(LOCAL:2)
	RETURN 0
;ペニスがないとだめ
SIF !(HAS_PENIS(TARGET)) && ITEM:PBAND == 0
	RETURN 0
;バイブ装着中はダメ
SIF TEQUIP:(LOCAL:2):13
	RETURN 0
;アナルバイブ使用中は不可
SIF TEQUIP:(LOCAL:2):14
	RETURN 0
;アナルビーズ使用中は不可
SIF TEQUIP:(LOCAL:2):15
	RETURN 0
;普通の浣腸使用中は不可
SIF TEQUIP:(LOCAL:2):21
	RETURN 0
;バルーン使用中は不可
SIF TEQUIP:(LOCAL:2):22
	RETURN 0
;電極使用中は不可
SIF TEQUIP:(LOCAL:2):23
	RETURN 0
;新妻プレイ中はダメ
SIF TEQUIP:(LOCAL:2):33 || TEQUIP:33
	RETURN 0
; ;体格差がある場合は経験がないとダメ
; SIF Com_Size_Check("strict") || Com_Size_Check("strictA") ;com custom code
; 	RETURN 0
; ;さらに体格差があると禁断の知識が必要
; SIF Com_Size_Check("reg") || Com_Size_Check("regA") ;com custom code
; 	RETURN 0
SIF 挿入不可(TARGET) == 3
	RETURN 0
;時間停止中はスキップ
IF FLAG:70 != 1
	;一定のＡ経験が必要
	SIF EXP:(LOCAL:2):2 < EXPLV:3
		RETURN 0
ENDIF
;下半身着衣
SIF TEQUIP:(LOCAL:2):0 > 1
	RETURN 0
RETURN 1
;addition custom code

@COM_ABLE71_TR
#DIM OTHER
#DIM V_ACTOR
#DIM A_ACTOR
SIF !TFLAG:100
	RETURN 0
SIF GLOBAL_COMABLE(71)
	RETURN RESULT
SIF !HAS_VAGINA(TARGET)
	RETURN 0
;毒人形だと性器がついてないのでダメ
SIF TALENT:196 == 99
	RETURN 0
SIF TEQUIP:バイブ
	RETURN 0
SIF TEQUIP:アナルバイブ
	RETURN 0
SIF TEQUIP:アナルビーズ
	RETURN 0
;二穴挿し実行判定
VARSET LOCAL
V_ACTOR = ADD_CHARA_WHO_TOUCHING(TARGET, SET_V, SET_P, 1)
A_ACTOR = ADD_CHARA_WHO_TOUCHING(TARGET, SET_A, SET_P, 1)
IF V_ACTOR < 0 && A_ACTOR < 0 ;nothing inserted yet
	RETURN 0
ELSEIF !GROUPMATCH(V_ACTOR, -1, PLAYER) && !GROUPMATCH(A_ACTOR, -1, PLAYER) ;already double-stuffed
	RETURN 0
ENDIF
IF !TALENT:PLAYER:双槍 ;need co-op partner if not having two dicks
	IF V_ACTOR == PLAYER && A_ACTOR == -1
		RETURN 0
	ELSEIF A_ACTOR == PLAYER && V_ACTOR == -1
		RETURN 0
	ENDIF
ENDIF
;assume empty slot as player
IF V_ACTOR == -1
	V_ACTOR = PLAYER
ELSEIF A_ACTOR == -1
	A_ACTOR = PLAYER
ENDIF
SIF !HAS_PENIS(V_ACTOR) && ITEM:PBAND == 0
	RETURN 0
SIF !HAS_PENIS(A_ACTOR) && ITEM:PBAND == 0
	RETURN 0
SIF BASE:PLAYER:勃起 < 1000
	RETURN 0
;体格差がある場合は経験がないとダメ
SIF Com_Size_Check("strict") || Com_Size_Check("strictA") ;com custom code
	RETURN 0
;さらに体格差があると禁断の知識が必要
SIF Com_Size_Check("reg") || Com_Size_Check("regA") ;com custom code
	RETURN 0
SIF 挿入不可(TARGET) == 3
	RETURN 0
;時間停止中はスキップ
IF FLAG:70 != 1
	;一定のＡ経験が必要
	SIF EXP:2 < EXPLV:3
		RETURN 0
ENDIF
RETURN 1

@COM71_TR
#DIM V_ACTOR
#DIM A_ACTOR
;TOUCH_SUCCESSION should've set touch positions by now
V_ACTOR = ADD_CHARA_WHO_TOUCHING(TARGET, SET_V, SET_P)
A_ACTOR = ADD_CHARA_WHO_TOUCHING(TARGET, SET_A, SET_P)
IF V_ACTOR < 0 || A_ACTOR < 0
	PRINTFORMDW 경고: 이중 관통에 대한 설정이 유효하지 않습니다. V_ACTOR = {V_ACTOR}, A_ACTOR = {A_ACTOR}
