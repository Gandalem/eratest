;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;set to both holes
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 50
;奉仕快楽フラグ
TCVAR:V_ACTOR:108 = 1
CSTR:V_ACTOR:10 += @"{TARGET}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:V_ACTOR:2 = 1
TCVAR:V_ACTOR:童貞喪失 = 1
;強度
TCVAR:V_ACTOR:4 = 1500
CSTR:TARGET:10 += @"{V_ACTOR}/"
;強度
TCVAR:TARGET:4 = 1500
DOWNBASE:V_ACTOR:体力 += 40
DOWNBASE:V_ACTOR:気力 += 40
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 100
	SOURCE:V_ACTOR:快Ｃ = 400
	SOURCE:快Ｖ = 400
	SOURCE:苦痛 = 250
	;処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:処女 == 1
		SOURCE:苦痛 += 1000
	ENDIF
	;再生処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:処女 == 2
		SOURCE:苦痛 += 250
	ENDIF
ELSE
	DOWNBASE:体力 += 50
	DOWNBASE:気力 += 60
	SOURCE:V_ACTOR:快Ｃ = 400
	SOURCE:快Ｖ = 300
	SOURCE:情愛 = 150
	SOURCE:苦痛 = 500
	SOURCE:露出 = 50
	SIF TFLAG:193
		SOURCE:露出 = 300
	SOURCE:反感 = 300
	;正常位補正
	;PLAYERがTARGETの膣に挿入している
	IF BEDROOM(CFLAG:V_ACTOR:現在位置) && TEQUIP:50 == V_ACTOR
		TCVAR:V_ACTOR:4 += EXP:愛情経験 * 5
		SOURCE:快Ｖ += EXP:愛情経験
		SIF SOURCE:快Ｖ >= 700
			SOURCE:快Ｖ = 700
		SIF TCVAR:V_ACTOR:4 >= 3000
			TCVAR:V_ACTOR:4 = 3000
	ENDIF
	;上のほうで計算した汚れデータ
	SOURCE:不潔 = Y*10 + 60
	CALL 特殊ソース処理
ENDIF
;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(TARGET)
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
CALL STAIN_膣内Ｐ挿入
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:V_ACTOR:挿入経験 ++
EXP:Ｖ経験 ++
;奉仕快楽フラグ
TCVAR:A_ACTOR:108 = 1
CSTR:A_ACTOR:10 += @"{TARGET}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:A_ACTOR:2 = 2
TCVAR:A_ACTOR:童貞喪失 = 1
TCVAR:Ａ喪失発生 = 1
;強度
TCVAR:A_ACTOR:4 = 2000
CSTR:TARGET:10 += @"{A_ACTOR}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 12
;強度
TCVAR:TARGET:4 = 1500
DOWNBASE:PLAYER:体力 += 40
DOWNBASE:PLAYER:気力 += 40
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 120
	SOURCE:A_ACTOR:快Ｃ = 400
	SOURCE:快Ａ = 400
	SOURCE:苦痛 = 450
ELSE
	DOWNBASE:体力 += 80
	DOWNBASE:気力 += 80
	SOURCE:A_ACTOR:快Ｃ = 400
	SOURCE:快Ａ = 400
	SOURCE:情愛 = 100
	SOURCE:苦痛 = 900
	SOURCE:露出 = 80
	SOURCE:逸脱 = 200
	SOURCE:反感 = 500
	;上のほうで計算した汚れデータ
	SOURCE:不潔 = Y*10 + 60
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 500
ENDIF
;Aへの苦痛は先に処理しておく
CALL PAIN_CHECK_A(TARGET)
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;奴隷のＡ⇔調教者のＰの汚れが移動
CALL STAIN_アナルＰ挿入
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:Ａ経験 ++
EXP:A_ACTOR:挿入経験 ++
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF FLAG:70 == 1 || CFLAG:イタズラ
	IF HETEROSEX(TARGET,V_ACTOR)
		EXP:V_ACTOR:(50 + HETEROSEX(TARGET,V_ACTOR)) += 1
	ENDIF
	IF HETEROSEX(TARGET,A_ACTOR)
		EXP:A_ACTOR:(50 + HETEROSEX(TARGET,A_ACTOR)) += 1
	ENDIF
ELSE
	IF HETEROSEX(TARGET,V_ACTOR)
		EXP:(50 + HETEROSEX(TARGET,V_ACTOR)) += 4
		EXP:V_ACTOR:(50 + HETEROSEX(TARGET,V_ACTOR)) += 1
	ENDIF
	IF HETEROSEX(TARGET,A_ACTOR)
		EXP:(50 + HETEROSEX(TARGET,A_ACTOR)) += 4
		EXP:A_ACTOR:(50 + HETEROSEX(TARGET,A_ACTOR)) += 1
	ENDIF
ENDIF
Qol_Info_Count_Array:TARGET:Qol_Count_VSex ++
Qol_Info_Count_Array:TARGET:Qol_Count_ASex ++
IF FLAG:70 == 1 || CFLAG:イタズラ
	Qol_Info_Count_Array:TARGET:Qol_Count_UncVSex ++
	Qol_Info_Count_Array:TARGET:Qol_Count_UncASex ++
ENDIF
