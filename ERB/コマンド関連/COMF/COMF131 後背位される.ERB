@CAN_COM131(ARG)
;qol custom code, replaced
CALL CAN_COM131_TR(ARG)
RETURN RESULT
SKIPDISP ARG
IF (!INROOM(CFLAG:PLAYER:現在位置) && !(BATHROOM() && ITEM:20))
	PRINTL 서서 개 자세로 잡기
ELSE
	PRINTL 개 스타일로 잡기
ENDIF
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
A = 0
S = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
CALL COM_ORDER
;ABL:欲望
IF ABL:欲望
	SIF S
		PRINT  + 
	A += ABL:欲望 * 2
	PRINT 욕정
	PRINTV 'LV,ABL:欲望,'(,ABL:欲望 * 2,')
	S = 1
ENDIF
IF MARK:快楽刻印
	SIF S
		PRINT  + 
	A += MARK:快楽刻印 * 2
	PRINT 쾌락의 낙인
	PRINTV 'LV,MARK:快楽刻印,'(,MARK:快楽刻印 * 2,')
	S = 1
ENDIF
;快感に素直
IF TALENT:快感応答 > 0
	SIF S
		PRINT  + 
	A += 2
	PRINT 쾌감을 즐긴다
	PRINTV '(,2,')
	S = 1
ENDIF
;快感の否定（淫乱、娼婦で無効）
IF TALENT:快感応答 < 0 && !TALENT:淫乱
	PRINT  - 
	A -= 2
	PRINT 쾌감을 부정한다
	PRINTV '(,2,')
	S = 1
ENDIF
;淫乱
IF TALENT:淫乱 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 음란
	PRINTV '(,5,')
	S = 5
ENDIF
;娼婦
IF TALENT:淫乱 > 1 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 창녀
	PRINTV '(,5,')
	S = 5
ENDIF
;調教者が処女
IF TALENT:PLAYER:処女 && TALENT:PLAYER:処女 == -1
	PRINT  - 
	A -= 15
	PRINTFORM %NAME:PLAYER%는 처녀이다.
	PRINTV '(,15,')
	S = 1
ENDIF
;調教者が貞操観念
IF TALENT:PLAYER:貞操 > 0
	PRINT  - 
	A -= 10
	PRINTFORM %NAME:PLAYER%는 정조 있다.
	PRINTV '(,10,')
	S = 1
ENDIF
;調教者が貞操無頓着
IF TALENT:PLAYER:貞操 < 0
	PRINT  + 
	A += 5
	PRINTFORM %NAME:PLAYER%는 정조롭지 않다
	PRINTV '(,5,')
	S = 1
ENDIF
;調教者のABL:技巧
IF ABL:PLAYER:技巧
	SIF S
		PRINT  + 
	A += ABL:PLAYER:技巧 * 4
	PRINTFORM %NAME:PLAYER%의 기교
	PRINTV 'LV,ABL:PLAYER:技巧,'(,ABL:PLAYER:技巧 * 4,')
	S = 1
ENDIF
;合計を表示(15以上で実行)
PRINT  =
PRINTV A
V = 15
SIF A < V
	PRINT  < 
SIF A == V
	PRINT  =
SIF A > V
	PRINT  > 
PRINT 필요 값 
PRINTV V
WAIT
SKIPDISP 0
;実行できない
SIF A < V
	RETURN 0
RETURN 1
