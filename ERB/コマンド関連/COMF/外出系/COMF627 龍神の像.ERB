@COM627
#DIMS 低気圧位置

低気圧位置 = %GET_LOCATION_LOW()%

DRAWLINE
PRINTW You gaze at the statue of the Dragon God.
PRINTL
PRINTL ...

IF (IS_COLD_LOW && 低気圧位置 != "寒冷渦通過" && DAY:2 != 2) || IS_LINER_RAINBAND:0 == 1 || (IS_SoJ_LOW == 2 && 低気圧位置 != "二つ玉低気圧通過") || CAN_CUMULUS:0 == 5 || CAN_CUMULUS:2 == 2 || CONTINUOUS_RAINFALL >= 20 || POSSIBLITY_AVALANCHE >= 1
	IF ABL:MASTER:教養 >= 2 ;custom code (below as well)
		CALL PRINT_STRW, @"The eyes are @BOLD@HEX@{C_RED}@red@!!! Abnormal weather is imminent!"
	ELSE
		PRINTFORMW The eyes are red.
	ENDIF
ELSEIF GET_LOCATION_AREA_TYPHOON() || 低気圧位置 == "台風勢力圏" || (低気圧位置 == "台風遠方" && TIME_ENTER_TERRITORY_TYPHOON:1 == DAY:3)
	IF ABL:MASTER:教養 >= 2
		CALL PRINT_STRW, @"The eyes are @BOLD@HEX@{C_PURPLE}@purple@... typhoon is approaching."
	ELSE
		PRINTFORMW The eyes are purple.
	ENDIF
ELSEIF (IS_SoJ_LOW == 1 && 低気圧位置 != "日本海低気圧通過") || (IS_SOUTHERN_LOW && 低気圧位置 != "南岸低気圧通過") || IS_RAINY_SEASON1 || IS_RAINY_SEASON2 || 低気圧位置 == "温暖前線接近" || 低気圧位置 == "暖域" || 低気圧位置 == "寒冷前線通過"
	IF ABL:MASTER:教養 >= 2
		CALL PRINT_STRW, @"The eyes are @BOLD@HEX@{C_BLUE}@blue@... rain is near."
	ELSE
		PRINTFORMW The eyes are blue.
	ENDIF
ELSE
	PRINTW The eyes look normal.
ENDIF
PRINTL
SIF !FLAG:70
	TIME += 1
TFLAG:102 = 0
RETURN 0

