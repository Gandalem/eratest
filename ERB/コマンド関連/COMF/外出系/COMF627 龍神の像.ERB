; Modular ERB: COMF/外出系/COMF627 龍神の像.ERB

@COM627
#DIMS 低気圧位置
低気圧位置 = %GET_LOCATION_LOW()%
DRAWLINE
PRINTW 용신(龍神)의 동상을 바라본다.
PRINTL
PRINTL ...
IF (IS_COLD_LOW && 低気圧位置 != "寒冷渦通過" && DAY:2 != 2) || IS_LINER_RAINBAND:0 == 1 || (IS_SoJ_LOW == 2 && 低気圧位置 != "二つ玉低気圧通過") || CAN_CUMULUS:0 == 5 || CAN_CUMULUS:2 == 2 || CONTINUOUS_RAINFALL >= 20 || POSSIBLITY_AVALANCHE >= 1
	IF ABL:MASTER:教養 >= 2 ;custom code (below as well)
		CALL PRINT_STRW, @"눈이 BOLDHEX{C_RED}빨강!!! 이상 기상이 임박했다!"
	ELSE
		PRINTFORMW 눈이 빨갛다.
	ENDIF
ELSEIF GET_LOCATION_AREA_TYPHOON() || 低気圧位置 == "台風勢力圏" || (低気圧位置 == "台風遠方" && TIME_ENTER_TERRITORY_TYPHOON:1 == DAY:3)
	IF ABL:MASTER:教養 >= 2
		CALL PRINT_STRW, @"눈이 BOLDHEX{C_PURPLE}purple... 태풍이 다가오고 있다."
	ELSE
		PRINTFORMW 눈은 보라색이다.
	ENDIF
ELSEIF (IS_SoJ_LOW == 1 && 低気圧位置 != "日本海低気圧通過") || (IS_SOUTHERN_LOW && 低気圧位置 != "南岸低気圧通過") || IS_RAINY_SEASON1 || IS_RAINY_SEASON2 || 低気圧位置 == "温暖前線接近" || 低気圧位置 == "暖域" || 低気圧位置 == "寒冷前線通過"
	IF ABL:MASTER:教養 >= 2
		CALL PRINT_STRW, @"눈은 BOLDHEX{C_BLUE}파란색으로... 비가 가까이 온다."
	ELSE
		PRINTFORMW 눈은 파랗다.
	ENDIF
ELSE
	PRINTW 눈은 정상으로 보인다.
ENDIF
PRINTL
SIF !FLAG:70
	TIME += 1
TFLAG:102 = 0
RETURN 0
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;龍神の像

@COM_ABLE627
;一括管理
SIF GLOBAL_COMABLE(627)
	RETURN RESULT
;龍神の像ではない場所
SIF !RYUJIN_STATUE(CFLAG:MASTER:現在位置)
	RETURN 0
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
RETURN 1
;龍神の像を判定する関数

@RYUJIN_STATUE(ARG)
#FUNCTION
;龍神の像
SIF ARG == GET_MAP_REPLACEMENT(207)
	RETURNF 1
RETURNF 0
