; Modular ERB: COMF/外出系/COMF626 土産屋.ERB

@COM626
#DIM LPCOUNT
#DIM 品揃え上限
#DIM GIFT_LIST, 21 ;Com custom code
#DIM GIFT_PRICE, 21 ;Com custom code
#DIMS GIFT_NAME, 21 ;Com custom code
#DIM BOUGHT_GIFT
#DIM SCORE
#DIM 生成済み
#DIM リロード数
#DIM 貰った回数
#DIM 渡した回数
#DIM 店員
#DIM 重複防止,21 ;Com custom code
#DIMS 台詞
#DIM GIFT_SCORE, 21 ;qol custom code
#DIM DYNAMIC nTimeSpent ;qol custom code
;とりあえず５つ。11個以上のときは#DIMも修整する
IF FLAG:市場の神 == 10
	品揃え上限 = 20 ;Com custom code
ELSE
	品揃え上限 = 10 ;Com custom code
ENDIF
;店員の見た目を決める。@GIFTSHOP_NAMEを変更すると香霖堂の店主も変わる
店員 = (GET_MAPID(CFLAG:MASTER:現在位置) == 5 && GIFTSHOP_NAME(5) == "香霖堂") ? 90 # GET_MAPID(CFLAG:MASTER:現在位置)
PRINTL 
;店員に喋らせる。ガワを変えるだけなので一言程度
IF !重複防止:(GET_MAPID(CFLAG:MASTER:現在位置))
	DRAWLINE ;bugfix custom code, moved from above
	台詞 = 「Welcome!」/「%TEXTR("A gift for the young lady?/Please take a look!/It's good value for the money!/They're masterworks all, can't go wrong!")%」
	CALL SPTALK, 0, "笑顔", 店員, 台詞, 1
	重複防止:(GET_MAPID(CFLAG:MASTER:現在位置)) = 1
ENDIF
IF FLAG:土産屋大安売り >= 100 && FLAG:土産屋大安売り % 100 == CFLAG:MASTER:デート中
	CALL COLORMESSAGE(@"특가 세일이다!", C_YELLOW, 1)
ELSE
	PRINTFORML %조사처리(CALLNAME:TARGET,"에게")% 무엇을 사줘야 할까...
ENDIF
DRAWLINE
FOR LPCOUNT, 1, 品揃え上限 + 1
;品出し,通るたびにラインナップが変わるので注意
IF !生成済み
	;地域制限を取っ払い全てのパターンを生成する場合
	IF FLAG:市場の神 == 10
		CALL CREATE_GIFT(99)
	ELSE
		CALL CREATE_GIFT(CFLAG:MASTER:デート中)
	ENDIF
	GIFT_LIST:LPCOUNT = RESULT:0
	GIFT_PRICE:LPCOUNT = RESULT:1
	GIFT_NAME:LPCOUNT = %RESULTS%
ENDIF
;qol custom code
CALL REVIEW_GIFT(TARGET, GIFT_LIST:LPCOUNT)
PRINTFORML [{LPCOUNT, 2}] - %GIFT_NAME:LPCOUNT, 42, LEFT%%金額表示(GIFT_PRICE:LPCOUNT), 10%%Qol_GiftReview(RESULT, GIFT_PRICE:LPCOUNT)%
GIFT_SCORE:LPCOUNT = RESULT
NEXT
DRAWLINE
PRINTFORML 돈: %金額表示(MONEY)%\@ nTimeSpent ? %" "%Time Spent: {nTimeSpent} #  \@
IF リロード数 == 8
	FONTBOLD ;qol custom code
	SETCOLOR C_RED
ENDIF
PRINTFORML [99] - 탐색(은) (\@ !FLAG:TIME_COMPRESSION ? 10 # 2 \@ 분)
RESETCOLOR
FONTREGULAR
PRINTFORML [ 0] 신경 쓰지 마
INPUT
;やっぱりやめる,キャンセルだとリロードできてしまうのでSOURCEまで回す
IF RESULT == 0
	TFLAG:194 = -1
	;ウィンドウショッピングとして少量のソースを獲得
	SOURCE:歓楽 = 500 + 300 * 好感度係数(TARGET)
	重複防止:(GET_MAPID(CFLAG:MASTER:現在位置)) = 0
	;商品リロード
ELSEIF RESULT == 99
	;ひやかしはお断り
	IF リロード数 >= 8
		TFLAG:194 = -2
		リロード数 = 0
		;閉店ガラガラ（他の店も閉まるのは仕様）
		重複防止:(GET_MAPID(CFLAG:MASTER:現在位置)) = 0
		SETBIT TFLAG:一日一回, 10
	ELSE
		CLEARLINE 8 + 品揃え上限 ;bugfix custom code
		生成済み = 0
		リロード数 ++
		nTimeSpent += !FLAG:TIME_COMPRESSION ? 10 # 2 ;qol custom code
		TIME += !FLAG:TIME_COMPRESSION ? 10 # 2
		RESTART
	ENDIF
	;商品選択
ELSEIF INRANGE(RESULT, 1, 品揃え上限 + 1)
	;qol custom code
	BOUGHT_GIFT = RESULT
	LOCAL = LINECOUNT
	CALL Qol_GiftShowTaste(GIFT_LIST:RESULT, GIFT_NAME:RESULT, GIFT_SCORE:RESULT)
	IF RESULT
		生成済み = 1
		CLEARLINE 8 + (LINECOUNT-LOCAL) + 品揃え上限 ;bugfix custom code
		RESTART
	ENDIF
	;-------------------------------------------------
	;お金足りない
	IF MONEY < GIFT_PRICE:BOUGHT_GIFT ;qol custom code
		PRINTFORMW 너무 비싸...
		生成済み = 1
		CLEARLINE 8 + 品揃え上限 ;bugfix custom code
		RESTART
		;商品購入
	ELSE
		;BOUGHT_GIFT = RESULT qol custom code
		台詞 = 「Thank you very much.」/「%TEXTR("Found something nice did ya?/Please come again./Why not hand it over right away?")%」
		CALL SPTALK, 0, "笑顔", 店員, 台詞, 1
		MONEY -= GIFT_PRICE:BOUGHT_GIFT
		重複防止:(GET_MAPID(CFLAG:MASTER:現在位置)) = 0
		;貰った回数をチェック
		貰った回数 = GET_GIFTDATA(CFLAG:TARGET:贈り物ストック, "回数") + 1
		;渡した回数をチェック
		渡した回数 = CFLAG:MASTER:渡した贈り物 / 1000 + 1
		;批評する
		CALL REVIEW_GIFT(TARGET, GIFT_LIST:BOUGHT_GIFT)
		SCORE = RESULT
		[IF_DEBUG]
		PRINTFORML ◆디버깅◆
		PRINTFORML 점수: {SCORE}
		PRINTFORML 점수는 수동으로 변경 가능(1～999), 0은 건너뜀
		INPUT 0
		;custom code
		IF RESULT == 0
		ELSEIF INRANGE(RESULT, 1, 999)
			SCORE = RESULT
		ENDIF
		[ENDIF]
		;ストックにGIFT_IDを保存
		CFLAG:TARGET:贈り物ストック = 貰った回数 * 10000000000000000 + SCORE * 10000000000000 + DAY * 1000000000 + CFLAG:MASTER:デート中 * 10000000 + GIFT_LIST:BOUGHT_GIFT
		;ストレージにも保存
		GIFT_GOT:TARGET:(貰った回数 % 100) = CFLAG:TARGET:贈り物ストック
		;TARGETはID,MASTERは渡したキャラを保存
		TCVAR:TARGET:今日の贈り物 = CFLAG:TARGET:贈り物ストック
		TCVAR:MASTER:今日の贈り物 = TARGET
		;MASTERは渡した回数と渡したキャラを保存
		CFLAG:MASTER:渡した贈り物 = 渡した回数 * 1000 + TARGET
		;		PRINTFORMW ID:{CFLAG:TARGET:贈り物ストック}
		;ソースの係数
		TFLAG:193 = SCORE / 100
		;ソースの獲得,一日一回限定でコストもかかるのでかなり大きめ（これでも時間効率はスキンシップと同等）
		SOURCE:歓楽 = 800 + 1500 * TFLAG:193 + 800 * 好感度係数(TARGET)
		SOURCE:受動 = 600 + 1500 * TFLAG:193 + 800 * ABL:従順
		SOURCE:征服 = 600 + 800 * TFLAG:193 + 1500 * ABL:サドっ気
		;恋人補正
		SIF TALENT:TARGET:恋人
			TIMES SOURCE:歓楽, 2.00
		;祭日補正,評価と二重になるけど
		SIF FESTIVAL() != ""
			TIMES SOURCE:歓楽, 2.00
		;信頼度,大きめ
		TFLAG:98 = (TFLAG:193 + 1) / 2 + 1
		;地の文用の分岐と機嫌修整
		IF TFLAG:193 >= 7
			SIF TALENT:TARGET:機嫌 < 0
				CALL KIGEN_CHANGE(TARGET, 100, 1)
			TFLAG:194 = 3
			addDateActionsDone:TARGET:date_Gift ++ ;addition custom code
		ELSEIF TFLAG:193 >= 4
			TFLAG:194 = 2
		ELSE
			TFLAG:194 = 1
		ENDIF
		;一日一回
		SETBIT TFLAG:一日一回, 10
	ENDIF
ELSE
	生成済み = 1
	RESTART
ENDIF
リロード数 = 0
生成済み = 0
TIME += !FLAG:TIME_COMPRESSION ? 30 # 10
RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;土産屋

@COM_ABLE626
;一括管理
SIF GLOBAL_COMABLE(626)
	RETURN RESULT
;土産屋ではない場所
SIF !GIFT_SHOP(CFLAG:MASTER:現在位置)
	RETURN 0
;デート中でない
IF CFLAG:同行 && CFLAG:2 > 1500 && GET_MAPID(CFLAG:MASTER:現在位置) == MAIN_MAP ;com custom code - allow to visit the gift shop with your "date" on a home map
ELSEIF !FLAG:デート相手
	RETURN 0
ENDIF
;TARGETがデート相手ではない
IF CFLAG:同行 && CFLAG:2 > 1500 && GET_MAPID(CFLAG:MASTER:現在位置) == MAIN_MAP ;com custom code - allow to visit the gift shop with your "date" on a home map
ELSEIF (!MOREDATE && TARGET != FLAG:デート相手) || (MOREDATE && !IS_IN_GROUP_DATE(TARGET))
	RETURN 0
ENDIF
;一日一回
SIF GETBIT(TFLAG:一日一回, 10)
	RETURN 0
;既に貰ってたらダメ
SIF TCVAR:今日の贈り物
	RETURN 0
;睡眠中
SIF CFLAG:睡眠 || CFLAG:MASTER:イタズラ || CFLAG:うふふ ;com custom code
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1

@GIFT_SHOP(ARG)
#FUNCTION
;土産屋,（今の所は拠点内ではできない）
;境内,社務所を作りたいところ
SIF ARG == GET_MAP_REPLACEMENT(2)
	RETURNF 1
;境内,寺務所を作りたいところ
SIF ARG == GET_MAP_REPLACEMENT(102)
	RETURNF 1
;集会所,土産物店を作りたいところ
SIF ARG == GET_MAP_REPLACEMENT(219)
	RETURNF 1
;湖畔,正門の方がいいか？
SIF ARG == GET_MAP_REPLACEMENT(343)
	RETURNF 1
;待合室,他にいいところが…
SIF ARG == GET_MAP_REPLACEMENT(403)
	RETURNF 1
;香霖堂
SIF ARG == GET_MAP_REPLACEMENT(502)
	RETURNF 1
;中有の道
SIF ARG == GET_MAP_REPLACEMENT(601)
	RETURNF 1
;山道・沢へ続く道,休憩所の方がいいか？
SIF ARG == GET_MAP_REPLACEMENT(702)
	RETURNF 1
;境内,社務所を
SIF ARG == GET_MAP_REPLACEMENT(811)
	RETURNF 1
;大通り
SIF ARG == GET_MAP_REPLACEMENT(931)
	RETURNF 1
;玉兎の街
SIF ARG == GET_MAP_REPLACEMENT(1003)
	RETURNF 1
RETURNF 0

@好感度係数(ARG)
#FUNCTION
IF CFLAG:ARG:好感度 < 100
	LOCAL = 0
ELSEIF CFLAG:ARG:好感度 < 500
	LOCAL = 1
ELSEIF CFLAG:ARG:好感度 < 1000
	LOCAL = 2
ELSEIF CFLAG:ARG:好感度 < 5000
	LOCAL = 3
ELSEIF CFLAG:ARG:好感度 < 10000
	LOCAL = 4
ELSEIF CFLAG:ARG:好感度 < 30000
	LOCAL = 5
ELSE
	LOCAL = 6
ENDIF
RETURNF LOCAL
