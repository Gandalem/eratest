; Modular ERB: COMF/外出系/COMF632 組み手.ERB

@COM632
PRINTFORML 이것은 전투 시스템의 체험판이다. 한번 사용해 볼래?
CALL ASK_M("No",1,"매우 약한 적",1,"약한 적",1)
IF !RESULT
	RETURN -1
ELSE
	CALL BATTLE_SYSTEM(RESULT)
	IF RESULT == -1
		PRINTFORMW 패배했다!
	ELSEIF RESULT == 1
		PRINTFORMW 당신이 이겼습니다!
	ENDIF
ENDIF

@COM_ABLE632
;一括管理
SIF GLOBAL_COMABLE(632)
	RETURN RESULT
SIF !TFLAG:100
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;仕事中
SIF CFLAG:行動 == 5
	RETURN 0
SIF !戦闘訓練可(CFLAG:MASTER:現在位置)
	RETURN 0
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
RETURN 1
