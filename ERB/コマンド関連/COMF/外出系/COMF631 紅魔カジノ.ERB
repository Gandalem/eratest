; Modular ERB: COMF/外出系/COMF631 紅魔カジノ.ERB
;紅魔カジノ

@COM631
TFLAG:カジノ入場時カリスマ = MONEY:2
PRINTFORMW 당신은 스칼렛 데빌 맨션의 카지노 안으로 들어선다.
CALL CASINO_ENTRANCE
SIF NEMUKE() >= 700
	PRINTFORM 당신은 너무 지쳤다.
PRINTFORMW 당신은 카지노를 떠난다.
TIME += 10

@COM_ABLE631
;一括管理
SIF GLOBAL_COMABLE(631)
	RETURN RESULT
SIF !CASINO_SPOT(CFLAG:MASTER:現在位置)
	RETURN 0
SIF TFLAG:妄想中
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
;時間に余裕が無い
;活動限界を700としてその20分前
SIF NEMUKE() >= 700
	RETURN 0
SIF CFLAG:MASTER:睡眠 || CFLAG:MASTER:イタズラ || CFLAG:うふふ ;com custom code
	RETURN 0
RETURN 1

@CASINO_SPOT(ARG)
#FUNCTION
;広間
SIF ARG == GET_MAP_REPLACEMENT(309)
	RETURNF 1
;NAS: Player housing
SIF GETBIT(HOME_CUSTOM_ROOM(CFLAG:MASTER:300),3)
	RETURNF 1
RETURNF 0
