; Modular ERB: COMF/外出系/COMF697 部屋を訪ねる.ERB
;-------------------------------------------------
;部屋を訪ねる
;-------------------------------------------------

@COM697
#DIM 家主
#DIM 嫉妬
#DIM 浮気
#DIM 部屋の汚れ
FOR LOCAL,1,CHARANUM
IF CFLAG:LOCAL:自宅位置 == CFLAG:MASTER:現在位置
	SIF CFLAG:LOCAL:出禁
		CONTINUE
	IF MOREDATE && NumberOfDates > 1 ;bugfix custom code
		FOR LOCAL:2, 0, NumberOfDates
		IF LOCAL == Datees:(LOCAL:2)
			LOCAL:3 = 1
			CONTINUE
		ENDIF
		NEXT
		SIF LOCAL:3
			CONTINUE
	ENDIF
	SIF LOCAL == FLAG:デート相手 ;bugfix custom code
		CONTINUE
	SIF LOCAL == TARGET
		CONTINUE
	SIF CFLAG:LOCAL:弱み握られ
		SETCOLOR C_AQUA
	SIF CFLAG:LOCAL:現在位置 != SUKIMA() || !VISIT(LOCAL) || CFLAG:LOCAL:拠点来訪 || BASE:LOCAL:体力 < 1000
		SETCOLOR C_GRAY
	;qol custom code, white day
	SIF QOL_CAN_WHITE_DAY_HOME_DELIVERY(LOCAL)
		SETCOLOR C_GREEN
	;qol custom code, highlight potential receivers
	FOR LOCAL:1, 1, COUNT_IRAI_SLOT() + 1
	SIF !(CAN_IRAI_VISIT_HOME_PERSON(LOCAL, LOCAL:1) || CAN_IRAI_VISIT_HOME_CLIENT(LOCAL, LOCAL:1))
		CONTINUE
	SETCOLOR C_YELLOW
	BREAK
	NEXT
	;------------------------------------------------
	PRINTFORML [{LOCAL, 3}] %OMANEKI_PLACE(LOCAL)%
	RESETCOLOR
ENDIF
NEXT
DRAWLINE
PRINTL [999] 멈춰
INPUT
SIF RESULT == 999
	RETURN -1
SIF CFLAG:RESULT:自宅位置 != CFLAG:MASTER:現在位置
	RETURN -1
家主 = RESULT
;qol custom code, moved above before all the abort checks etc
CALL IRAI_VISIT_HOME(家主)
IF RESULT
	TCVAR:家主:お宅訪問 = 1
	GOTO OWARI
ENDIF
;qol custom code
CALL QOL_WHITE_DAY_HOME_DELIVERY(家主)
IF RESULT
	TCVAR:家主:お宅訪問 = 1
	GOTO OWARI
ENDIF
;------------------------------
;別の子とデート中
IF FLAG:デート相手 != MASTER
	PRINTFORMW 당신은 %OMANEKI_PLACE(家主)%를 방문하려고 하지만, %CALLNAME:(FLAG:デート相手)%가 당신을 강렬하게 노려본다.
	RETURN -1
ENDIF
;見られてないかチェック
浮気 = 0
嫉妬 = 0
FOR LOCAL,1,CHARANUM
IF LOCAL != 家主 && CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置 && !MORELOVER
	SIF LOCAL == 60
		嫉妬 = 60
	SIF TALENT:LOCAL:恋慕 && CFLAG:LOCAL:信頼度 < 1000
		浮気 = LOCAL
ENDIF
NEXT
;パルスィが出現し4人も住んでいる地霊殿はかなり難易度が高い
;連動キャラも駆けつけてくるので二股してると大変
IF 嫉妬 || 浮気
	PRINTFORM 당신이 %OMANEKI_PLACE(家主)%에 들어가려고 시도한다, 
	IF 嫉妬
		PRINTFORMW 하지만 당신은 %CALLNAME:嫉妬%이 %HIS_HER(嫉妬)%의 얼굴에 사악한 표정으로 방해하자 마음을 바꾼다.
	ELSE
		PRINTFORMW 하지만 당신은 의심스럽게 당신을 쳐다보고 있는 %CALLNAME:浮気%에게 막힌다.
	ENDIF
	RETURN -1
ENDIF
IF TCVAR:家主:お宅訪問
	PRINTFORMW 다른 날 다시 방문하자.
	RETURN -1
ENDIF
SELECTCASE RAND:10
	CASE IS <= 1
		TFLAG:193 = 1
	CASE 2 TO 4
		;多忙
		TFLAG:193 = 2
	CASE 5,6,7
		;ちょっとだけ
		TFLAG:193 = 3
	CASE 8,9
		;上げてもらえる
		TFLAG:193 = 4
ENDSELECT
SIF !TALENT:家主:恋慕 && !TALENT:家主:思慕 && TFLAG:193 > 2
	TFLAG:193 --
SIF CFLAG:家主:現在位置 != SUKIMA() || !VISIT(家主) || CFLAG:家主:拠点来訪 || BASE:家主:体力 < 1000
	TFLAG:193 = 1
PRINTFORMW 당신은 %OMANEKI_PLACE(家主)%을 방문한다.
TCVAR:家主:お宅訪問 = 1
[IF_DEBUG]
IF FLAG:テストプレイ用オナバレ強制発生
	CALL ONABARE(家主)
	GOTO OWARI
ENDIF
[ENDIF]
;qol custom code, moved above
; CALL IRAI_VISIT_HOME(家主)
; SIF RESULT
; GOTO OWARI
IF DAY:2 == 3 && (DAY:3 == 13 || DAY:3 == 15) && TFLAG:193 > 1
	CALL PRINT_FACE, 家主 , "通常", "服" ;qol custom code
	CFLAG:家主:最後に会った日 = DAY
	PRINTFORML %CALLNAME:家主%이 나온다.
	;ぼうじぼ当たれ、三角ばたけにソバ当たれ！ https://www.bench.co.jp/hanada/essay/boujibo.htm
	;the meaning is that you strike the ground with the boujibo straw pole (that you make) to drive out the pest while chanting this, wishing for a good harvest even on small fields (hence triangular patch of ground)
	PRINTFORML 「부지보로 내려쳐라! 크고 작은 들에 메밀이 풍성하도록 축복하라!」
	PRINTFORMW 당신은 짚으로 땅을 치며 풍년을 기원한다.
	IF ABL:家主:教養 >= UniversalRank("S") || 家主 == 77 || 家主 == 78
		PRINTFORML %CALLNAME:家主%가 당신에게 사탕 하나를 준다!
		;現状実装されているお菓子をランダムに
		SELECTCASE RAND:5
			CASE 0
				ITEM:120 ++
			CASE 1
				ITEM:212 ++
			CASE 2
				ITEM:213 ++
			CASE 3
				ITEM:216 ++
			CASEELSE
				ITEM:376 ++
		ENDSELECT
	ELSE
		PRINTFORML %CALLNAME:家主%은 약간 혼란스러워 보인다. %HE_SHE(家主)%는 「보지보」가 뭔지 전혀 모르는 것 같다...
		PRINTFORML %HE_SHE(家主,1)%은 아무 말 없이 문을 당신에게 쾅 닫아버린다.
		PRINTFORML 당신은 슬퍼진다.
	ENDIF
	TIME += 10
	RETURN 1
ENDIF
IF TFLAG:193 > 1 && CFLAG:家主:溜まってる度 > 300
	IF RAND:(CFLAG:家主:溜まってる度 + TFLAG:幸運補正 * 50) >= RAND:700
		CALL ONABARE(家主)
		GOTO OWARI
	ELSEIF ITEM:兎符「開運大紋」
		PRINTL 응? 대길 부적은...
		CALL ASK_YN("그것을 활성화한다.","그것을 그대로 두어라")
		IF !RESULT
			ITEM:兎符「開運大紋」 --
			CALL COLORMESSAGE(@"토끼 부적 「개운대문」이 발동했다!",C_YELLOW,2)
			CALL ONABARE(家主)
			GOTO OWARI
		ENDIF
	ENDIF
ENDIF
SELECTCASE TFLAG:193
	CASE 1
		IF CFLAG:MASTER:現在位置 == CFLAG:家主:現在位置
			CALL PRINT_FACE, 家主 , "通常", "服" ;qol custom code
			PRINTFORMW 하지만 %CALLNAME:家主%은(는) 허가 없이 들어가지 말라고 당신에게 말한다.
		ELSE
			PRINTFORMW 대답이 없다... %HE_SHE(家主)%은 잠들었거나 외출했을지도 모른다.
		ENDIF
	CASE 2
		CALL PRINT_FACE, 家主 , "通常", "服" ;qol custom code
		CFLAG:家主:最後に会った日 = DAY
		PRINTFORMW %CALLNAME:家主%이 나온다.
		IF !TALENT:家主:恋慕 && !TALENT:家主:思慕
			PRINTFORM %HE_SHE(家主,1)%가주인(은) 짜증이 난 듯하다. 
		ELSE
			PRINTFORM %HE_SHE(家主,1)%은 미안한 듯이 바라본다. 
		ENDIF
		PRINTFORMW 그리고 %HE_SHE(家主)%는 오늘 시간이 없다고 말한다.
		PRINTFORM 당신은 곧 만날 수 있는지 묻는다. 
		IF !RAND:2 && !GETBIT (TFLAG:一日一回,5)
			PRINTFORMW 그리고 %HE_SHE(家主)%은 내일 %HE_SHE(家主)%에 갈 계획이라고 %GET_MAPNAME(MAIN_MAP)%이 답한다.
			CFLAG:家主:翌日来訪 = 1
			SETBIT TFLAG:一日一回,5
		ELSE
			PRINTFORMW 하지만 %HE_SHE(家主)%은 모른다고 응답한다.
		ENDIF
		CALL COM697_1(家主)
		TARGET = 家主
		TIME += 5
		RETURN 1
	CASE 3
		CALL PRINT_FACE, 家主 , "通常", "服" ;qol custom code
		CFLAG:家主:最後に会った日 = DAY
		PRINTFORML 집주인(%CALLNAME:家主%)이 나온다.
		PRINTFORML 당신은 %HIM_HER(家主)%을 만나러 왔다고 말하지만, %HE_SHE(家主)%는 잠시만 시간을 내줄 수 있는 것 같다.
		PRINTFORMW ...
		PRINTFORMW ......
		PRINTFORMW .........
		PRINTFORMW 당신은 %CALLNAME:家主%와 한동안 대화한다.
		PRINTFORMW 작별 인사를 하며, 당신은 %HIM_HER(家主)%에게 곧 만날 수 있는지 묻는다.
		IF !RAND:2 && !GETBIT (TFLAG:一日一回,5)
			PRINTFORMW %HE_SHE(家主,1)%은(는) %HE_SHE(家主)%이/가 내일 %GET_MAPNAME(MAIN_MAP)%에 갈 계획이라고 답했다.
			CFLAG:家主:翌日来訪 = 1
			SETBIT TFLAG:一日一回,5
		ELSE
			PRINTFORMW 하지만 %HE_SHE(家主)%은 모른다고 응답한다.
		ENDIF
		CALL COM697_1(家主)
		TARGET = 家主
		TIME += 30
		RETURN 1
	CASE 4
		CALL PRINT_FACE, 家主 , "笑顔", "服" ;qol custom code
		CFLAG:家主:最後に会った日 = DAY
		PRINTFORMW %CALLNAME:家主%이(가) 나온다.
		PRINTFORMW %CALLNAME:家主%은(는) 쾌활해 보인다...
		TALENT:家主:機嫌 = 1 ;bug fix, actually set them to being cheerful
		CALL ASK_YN("데이트 신청하기","방문하기")
		IF !RESULT || !TALENT:家主:恋慕
			IF !RESULT
				PRINTFORMW %CALLNAME:家主%를 데이트에 초대했다.
			ELSE
				PRINTFORML 당신은 %HIM_HER(家主)%에게 들어가는 것이 괜찮은지 묻지만, %HE_SHE(家主)%는 당신을 거절한다.
				PRINTFORMW %CALLNAME:家主%가 대신 데이트를 제안했고, 당신은 고개를 끄덕이며 흔쾌히 동의했다.
			ENDIF
			CFLAG:MASTER:同行 = 60
			CFLAG:家主:同行 = 60
			CFLAG:家主:現在位置 = CFLAG:MASTER:現在位置
			CFLAG:家主:デート中 = CFLAG:MASTER:現在位置 / 100
			CFLAG:家主:拠点来訪 = 1
			FLAG:デート相手 = 家主
			TFLAG:デート前好感度 = CFLAG:家主:2
		ELSE
			;デート処理入れてないのにデート中だけ入れるのはバグの元になりかねないので一旦オミット
			;CFLAG:家主:デート中 = CFLAG:MASTER:現在位置 / 100
			CALL OMANEKI_ENTER(家主)
		ENDIF
ENDSELECT
$OWARI
TIME += 3
TFLAG:102 = 0
RETURN 0

@COM697_1(ARG)
#DIM 歓楽UP
#DIM 受動UP
#DIM 征服UP
;会話のコンパチ
TFLAG:98 = 5
;固定で獲得するソース
歓楽UP = 200
受動UP = 0
征服UP = 0
;ABL:親密をみる
IF ABL:ARG:親密 <= 1
	歓楽UP += (ABL:ARG:従順 * 40)
ELSEIF ABL:ARG:親密 <= 3
	歓楽UP += 200 + (ABL:ARG:従順 * 40)
ELSEIF ABL:ARG:親密 <= 5
	歓楽UP += 500 + (ABL:ARG:従順 * 40)
ELSEIF ABL:ARG:親密 <= 8
	歓楽UP += 750 + (ABL:ARG:従順 * 60)
ELSEIF ABL:ARG:親密 <= 10
	歓楽UP += 1000 + (ABL:ARG:従順 * 60)
ELSE
	歓楽UP += 1600 + (ABL:ARG:従順 * 30)
ENDIF
;好感度をみる
IF CFLAG:ARG:2 <= 1000
	歓楽UP += CFLAG:ARG:2
ELSEIF CFLAG:2 <= 5000
	歓楽UP += 500 + (CFLAG:ARG:2 - 500) / 3
ELSE
	歓楽UP += 2000 + (CFLAG:ARG:2 - 5000) / 5
ENDIF
SIF 歓楽UP < 0
	歓楽UP = 0
受動UP = 100 + 100 * ABL:ARG:従順
征服UP = 100 + 100 * ABL:ARG:サドっ気
SELECTCASE ABL:MASTER:話術技能
	CASE 0
		TIMES 歓楽UP , 0.20
		TIMES 征服UP , 0.20
		TIMES 受動UP , 0.20
	CASE 1
		TIMES 歓楽UP , 0.40
		TIMES 征服UP , 0.40
		TIMES 受動UP , 0.40
	CASE 2
		TIMES 歓楽UP , 0.70
		TIMES 征服UP , 0.70
		TIMES 受動UP , 0.70
	CASE 3
		TIMES 歓楽UP , 1.00
		TIMES 征服UP , 1.00
		TIMES 受動UP , 1.00
	CASE 4
		TIMES 歓楽UP , 1.20
		TIMES 征服UP , 1.20
		TIMES 受動UP , 1.20
	CASEELSE
		TIMES 歓楽UP , 1.50
		TIMES 征服UP , 1.50
		TIMES 受動UP , 1.50
ENDSELECT
IF TFLAG:193 == 3
	TIMES 歓楽UP , 3.50
	TIMES 征服UP , 3.50
	TIMES 受動UP , 3.50
	TFLAG:好感度ボーナス = 200
ENDIF
SOURCE:ARG:歓楽 = 歓楽UP
SOURCE:ARG:征服 = 征服UP
SOURCE:ARG:受動 = 受動UP
CALL FAVOR_CALC(ARG)
CALL TRUST_CALC(ARG)
TFLAG:好感度ボーナス = 0
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;部屋を訪ねる

@COM_ABLE697
;一括管理
SIF GLOBAL_COMABLE(697)
	RETURN RESULT
SIF AT_HOME(MASTER)
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
;潜伏モード中は不可
SIF GETBIT(FLAG:潜伏,0)
	RETURN 0
LOCAL:1 = 0
FOR LOCAL,1,CHARANUM
SIF CFLAG:LOCAL:出禁
	CONTINUE
SIF CFLAG:LOCAL:自宅位置 == CFLAG:MASTER:現在位置 && !CFLAG:LOCAL:神社在住 && LOCAL != TARGET; && (TALENT:LOCAL:思慕 || TALENT:LOCAL:恋慕)
	LOCAL:1 ++
NEXT
SIF !LOCAL:1
	RETURN 0
RETURN 1
