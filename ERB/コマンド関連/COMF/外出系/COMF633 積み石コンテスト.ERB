	CALL GET_MONEY_YEN(Prize - 3000, 2) ;custom code
ELSE
	CALL GET_MONEY_YEN(Prize, 2) ;custom code
ENDIF
SIF STONE_PLAYCOUNT:2 > 2
	CALL GET_ITEM("滑石", 1, 2) ;custom code
CALL STONE_UKETSUKE
