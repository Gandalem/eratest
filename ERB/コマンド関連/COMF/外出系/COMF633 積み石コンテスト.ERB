RETURN 0

@Stone_Entry_EX(Rank, MaxBattle, Prize)
#DIM Rank
#DIM MaxBattle
#DIM Prize
#DIM WIN_P
#DIM difficulty
#DIM DYNAMIC nPoorFag ;custom code
WIN_P = 0
IF !TALENT:MASTER:積み石ランカー == 6 && MONEY < 3000
	PRINTFORMW 「음, 실례지만... 입장료를 감당할 만한 자금이 없는 것 같은데요...」
	STONE_PLAYCOUNT:1 -= 50
	IF STONE_PLAYCOUNT:2 >= 14
		PRINTFORMW 「정말 네가 뭘 하든 소용없겠구나... %UNICODE(0x2764)% 그러니 내가 직접 돈을 내야겠다 %UNICODE(0x2764)%」
	ELSEIF STONE_PLAYCOUNT:2 >= 5
		PRINTFORMW 「가끔은 정말 무책임하구나. 뭐 어쩔 수 없지, 네 유일한 친구로서 내가 예의상 계산해 줄게.」
	ELSE
		PRINTFORMW 「흐음... 이번 한 번만 예외를 두어주지, 하지만 딱 이번 한 번이야, 알겠지?」
	ENDIF
	nPoorFag = 1
ENDIF
SIF TALENT:MASTER:積み石ランカー < 6 && MONEY >= 3000 ;custom code fix
	CALL PAY_MONEY_YEN(3000, 2) ;custom code
;持ち込みアイテム
CALL STONE_MOCHIKOMI
IF Rank == 3
	difficulty = 5
ELSEIF Rank == 4
	difficulty = 6
ENDIF
FOR WIN_P, 0, MaxBattle
IF WIN_P > 0
	STONE_PLAYCOUNT:1 += 1
	STONE_BATTLECOUNT:0 += 1
	STONE_BATTLECOUNT:1 += 1
	PRINTFORMW
	;決勝前
	IF WIN_P == MaxBattle - 1
		IF TALENT:MASTER:積み石ランカー == 6
			PRINTFORML 「4라운드 승리를 축하한다! 다음 상대는 당연히 우리의 사랑스러운 에리카쨩이다...」
			PRINTFORMW 「하지만 분명 잘 해낼 수 있을 거야!」
		ELSE
			PRINTFORML 「네 번째 라운드 승리를 축하한다! 다음 상대는 가장 강한 자이니 각오해라!」
			PRINTFORMW 「만약 여기서 멈춘다면 참가비를 돌려받을 수 있다. 무엇을 할 것인가?」
		ENDIF
	ELSE
		;custom code
		PRINTFORML 「%ORDINAL(WIN_P)% 라운드 승리를 축하한다! \@ TALENT:MASTER:積み石ランカー == 6 || nPoorFag ? 원하면 여기서 그만둘 수 있다... # 대신 여기서 그만두면 참가비를 돌려받을 것이다. \@」
		PRINTFORMW 「무엇을 할 거니?」
	ENDIF
	CALL ASK_YN("계속하기","멈춰라")
	IF RESULT
		PRINTFORMW 「아니야... 다시 여기에서 보길 바랄게!!!」
		SIF TALENT:MASTER:積み石ランカー < 6 && !nPoorFag ;custom code fix
			CALL GET_MONEY_YEN(3000, 2) ;custom code
		CALL STONE_UKETSUKE
		TIME += 50
		RETURN -1
	ELSE
		PRINTFORMW 「바로 그거야!」
	ENDIF
ENDIF
IF WIN_P == MaxBattle - 1
	PRINTFORML 「이제 마지막 라운드다... 준비됐나? 네 마지막 상대는...」
	PRINTFORMW 「오, 그래! 그녀를 알고 있지, 사랑하고 있잖아... 그것은...!!!」
	CALL STONELEVEL(Rank + 4)
ELSE
	PRINTFORMW 「음... %ORDINAL(WIN_P + 1)% 라운드 상대가 이이쓰스...」
	CALL STONELEVEL(difficulty)
ENDIF
IF RESULT == 1
	IF WIN_P == MaxBattle - 1
		PRINTFORML
		PRINTFORML 「Eika쨩과 정면으로 맞설 수 있었다니 정말 대단해!」
		PRINTFORMW 「정말 아슬아슬했어... 다음에 꼭 다시 도전해주길 바랄게!」
		STONE_PLAYCOUNT:1 += 1
	ELSE
		PRINTFORML
		PRINTFORMW 「플레이해 주셔서 감사합니다! 다시 이곳에서 뵙기를 기대합니다!」
	ENDIF
	STONE_BATTLECOUNT:0 += 1
	CALL STONE_UKETSUKE
	TIME += 50
	RETURN 0
ELSE
	difficulty = MIN(difficulty + 1, 6)
ENDIF
NEXT
PRINTFORMW 「승리를 축하합니다! 당신의 상금입니다, %金額表示(Prize)%!」
;ピラミッド
IF Rank == 3
	IF TALENT:MASTER:積み石ランカー > Rank
		PRINTFORML 「하지만 이보다 높은 등급을 이길 수 있을 거라고 확신해...」
	ELSE
		PRINTFORMW 「피라미드 등급에서 첫 승리를 축하하며... '스태킹 베테랑'이라는 타이틀을 수여합니다, 축하해요!」
		PRINTFORMW 「그것은 제쳐두고...」
		PRINTFORMW 「이게 루나틱 난관이라 끝이라고 생각하지는 않으셨겠죠!」
		PRINTFORMW 「사실 전설로 불리는 또 다른 등급이 있는데, 거기서 진짜 제대로 된 에리카짱과 싸울 수 있답니다!」
		PRINTFORMW 「그녀는 엄청나게 강하고 매우 어렵지만... 당신이 이길 수도 있을 거라고 저는 큰 기대를 하고 있어요!」
		TALENT:MASTER:積み石ランカー = Rank + 1
		STONE_PLAYCOUNT:1 += 10
	ENDIF
	;バベル
ELSEIF Rank == 4
	IF TALENT:MASTER:積み石ランカー >= 5
		PRINTFORML 「진짜 심각한 에리카짱을 또 이기다니 믿을 수가 없네... 대단해!!!」
		STONE_PLAYCOUNT:1 += 7
	ELSE
		PRINTFORML 「바벨탑 등급에서 첫 승리를 거둔 당신에게...」
		PRINTFORML 「저, 에리카쨩이 벌써 저보다 이겼더라도... 당신은 '스태킹 마스터'의 타이틀을 얻었습니다! 굉장해!」
		TALENT:MASTER:積み石ランカー = 5
		STONE_PLAYCOUNT:1 += 15
	ENDIF
	SIF STONE_PLAYCOUNT:2 == 13
		CALL STONE_UKETSUKE_H
ENDIF
STONE_PLAYCOUNT:1 += 1
STONE_BATTLECOUNT:0 += 1
STONE_BATTLECOUNT:1 += 1
PRINTFORMW 「다시 우리와 함께 놀러 오세요!」
IF TALENT:MASTER:積み石ランカー < 6 && nPoorFag ;custom code fix
	CALL GET_MONEY_YEN(Prize - 3000, 2) ;custom code
ELSE
	CALL GET_MONEY_YEN(Prize, 2) ;custom code
ENDIF
SIF STONE_PLAYCOUNT:2 > 2
	CALL GET_ITEM("滑石", 1, 2) ;custom code
IF STONE_PLAYCOUNT:2 == 9 || STONE_PLAYCOUNT:2 == 11
	CALL STONE_UKETSUKE_H
ELSE
	CALL STONE_UKETSUKE
ENDIF
TIME += 60
RETURN 0
