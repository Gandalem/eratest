;積み石コンテスト

@COM_ABLE633
;一括管理
SIF GLOBAL_COMABLE(633)
	RETURN RESULT
SIF !INRANGE(TIME, 480, 1080)
	RETURN 0
IF !AT_HOME(MASTER)
	SIF CFLAG:MASTER:現在位置 != 三途の川
		RETURN 0
ELSE
	;冥界が拠点の場合は、賽の河原
	SIF CFLAG:MASTER:現在位置 != 602
		RETURN 0
ENDIF
;デート中はデート相手と一緒じゃないとダメ
SIF CHK_DATENOW(CFLAG:12) && TARGET != FLAG:デート相手
	RETURN 0
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1
;-------------------------------------------------
;積み石コンテスト実行
;-------------------------------------------------

@Stone_Entry(Rank, MaxBattle, Prize)
#DIM Rank
#DIM MaxBattle
#DIM Prize
#DIM WIN_P
#DIM difficulty
#DIM DYNAMIC nPoorFag ;custom code
WIN_P = 0
difficulty = Rank
IF TALENT:MASTER:積み石ランカー < 6 && MONEY < 3000 ;custom code fix
	PRINTFORMW 「음, 실례지만... 입장료를 감당할 만한 자금이 없는 것 같은데요...」
	STONE_PLAYCOUNT:1 -= 50
	IF STONE_PLAYCOUNT:2 >= 14
		PRINTFORMW 「정말 네게 도움을 줄 수는 없구나... %UNICODE(0x2764)% 그러니 내가 직접 비용을 지불하겠다 %UNICODE(0x2764)%」
	ELSEIF STONE_PLAYCOUNT:2 >= 5
		PRINTFORMW 「가끔은 정말 한심하구나. 뭐 어쩔 수 없지, 네 유일한 친구니까 예의상 내가 계산해 줄게.」
	ELSE
		PRINTFORMW 「흐음... 이번 한 번만 예외를 두어주지, 하지만 딱 이번 한 번이야, 알겠지?」
	ENDIF
	nPoorFag = 1
ENDIF
SIF TALENT:MASTER:積み石ランカー < 6 && MONEY >= 3000 ;custom code fix
	CALL PAY_MONEY_YEN(3000, 2) ;custom code
;持ち込みアイテム
CALL STONE_MOCHIKOMI
FOR WIN_P, 0, MaxBattle
IF WIN_P > 0
	STONE_PLAYCOUNT:1 += 1
	STONE_BATTLECOUNT:0 += 1
	STONE_BATTLECOUNT:1 += 1
	PRINTFORMW
	;custom code
	PRINTFORML 「%ORDINAL(WIN_P)% 라운드 승리 축하한다! \@ TALENT:MASTER:積み石ランカー == 6 || nPoorFag ? 원하면 여기서 끝낼 수 있다... # 여기서 멈추면 참가비를 돌려받는다. \@ 무엇을 할 것인가?」
	PRINTFORMW 「무엇을 할 것인가?」
	CALL ASK_YN("계속하기","멈춰라")
	IF RESULT
		PRINTFORMW 「아니야... 다시 여기에서 보길 바랄게!!!」
		SIF TALENT:MASTER:積み石ランカー < 6 && !nPoorFag ;custom code fix
			CALL GET_MONEY_YEN(3000, 2) ;custom code
		CALL STONE_UKETSUKE
		TIME += 50
		RETURN -1
	ELSE
		PRINTFORMW 「바로 그거야!」
	ENDIF
ENDIF
PRINTFORMW 「음... %ORDINAL(WIN_P + 1)% 라운드 상대가 이이쓰스...」
CALL STONELEVEL(difficulty)
IF RESULT == 1
	PRINTFORMW 「당신은 패배했으니, 여기서 끝입니다... 플레이해 주셔서 감사합니다! 다시 이곳에서 만날 날을 기대하겠습니다!」
	STONE_BATTLECOUNT:0 += 1
	CALL STONE_UKETSUKE
	TIME += 50
	RETURN 0
ELSE
	difficulty ++
ENDIF
NEXT
PRINTFORMW 「승리를 축하합니다! 상금 %金額表示(Prize)%는 당신의 것입니다!」
STONE_PLAYCOUNT:1 += 3
STONE_BATTLECOUNT:0 += 1
STONE_BATTLECOUNT:1 += 1
IF TALENT:MASTER:積み石ランカー > Rank
	PRINTFORML 「더 높은 등급을 깨려고 노력해야 하지 않나?」
ELSE
	IF TALENT:MASTER:積み石ランカー == 0
		PRINTFORML 「장난감 블록 등급에서의 첫 승리를 위해 새로운 타이틀인 '쌓기 초보자!'를 획득했습니다.」
		PRINTFORML 「이제 젠가 등급의 도전을 시도할 수 있습니다, 축하합니다!」
		PRINTFORML 「당신의 돌 쌓기 전설이 여기서 시작되기를 바랍니다!」
	ELSEIF TALENT:MASTER:積み石ランカー == 1
		PRINTFORML 「그리고 Jenga 등급에서의 첫 승리 덕분에 새로운 타이틀 - 쌓는 초보를 얻었습니다!」
		PRINTFORML 「이제 카드 집 등급의 도전을 시도할 수 있게 되었습니다, 축하합니다!」
		PRINTFORML 「돌 쌓기 커뮤니티 곳곳에서 당신이 유망한 신성이라는 이야기가 많은 것 같습니다!」
	ELSEIF TALENT:MASTER:積み石ランカー == 2
		PRINTFORML 「그리고 카드 하우스 등급에서 첫 승리를 거두셨으니 새로운 타이틀 '스태킹 엘리트'를 얻으셨습니다!」
		PRINTFORML 「이제 피라미드 등급의 도전을 시도할 수 있습니다. 축하드립니다!」
		PRINTFORML 「당신은 경력을 쌓을 좋은 길에 와 있습니다! 돌 하나하나 쌓아 정상까지 올라가세요!」
	ENDIF
	TALENT:MASTER:積み石ランカー = Rank + 1
	STONE_PLAYCOUNT:1 += 7 + RANK
ENDIF
PRINTFORMW 「다시 와서 놀아라!」
