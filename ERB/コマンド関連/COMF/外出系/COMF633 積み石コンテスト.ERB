;積み石コンテストの戦績を呼び出す関数
;-------------------------------------------------
@StoneBattle_record
SETCOLOR C_GREEN
PRINTFORML ◆Your Stone Stacking Record◆
RESETCOLOR
PRINTFORML
PRINTFORML
PRINTFORML Fast-stacking division matches: {STONE_BATTLECOUNT:0} Wins: {STONE_BATTLECOUNT:1}
PRINTFORML Couples division matches      : {STONE_BATTLECOUNT:2} Wins: {STONE_BATTLECOUNT:3}
;デバッグ用
;PRINTFORML 通った日数{STONE_PLAYCOUNT:0}受付水子好感度{STONE_PLAYCOUNT:1}進行度{STONE_PLAYCOUNT:2}
PRINTFORML
IF TALENT:MASTER:積み石ランカー == 6
	SETCOLOR C_RED
	PRINTFORML ★%GET_TALENTNAME_TR(274,TALENT:MASTER:274)%!
	RESETCOLOR
ELSEIF TALENT:MASTER:積み石ランカー > 0
	SETCOLOR C_YELLOW
	PRINTFORML ★%GET_TALENTNAME_TR(274,TALENT:MASTER:274)%
	RESETCOLOR
ELSE
	SETCOLOR C_L_GRAY
	PRINTFORML ●You have yet to earn a title in the fast-stacking division
	RESETCOLOR
ENDIF
PRINTFORML
IF TALENT:MASTER:積み石ランカー == 4
	SETCOLOR C_YELLOW
	PRINTFORML ★You have beaten Eika
	RESETCOLOR
ELSEIF TALENT:MASTER:積み石ランカー > 4
	SETCOLOR C_RED
	PRINTFORML ★You have beaten serious Eika!
ELSE
	SETCOLOR C_L_GRAY
	PRINTFORML ●You haven't beaten ？？？ yet
ENDIF

PRINTFORML
IF STONE_PLAYCOUNT:3 == 0
	SETCOLOR C_L_GRAY
	PRINTFORML ●You have not yet built up a track record in the couples division
	RESETCOLOR
ELSEIF STONE_COMBI_TROPHY:31 == 1
	SETCOLOR C_RED
	PRINTFORML ★You have conquered all the couples division themes!
	RESETCOLOR
ELSE
	SETCOLOR C_YELLOW
	PRINTFORML ★Winner of %PRINT_PLUR("theme", STONE_PLAYCOUNT:3)%
	RESETCOLOR 
ENDIF
PRINTFORML
IF STONE_PLAYCOUNT:2 < 14
	SETCOLOR C_L_GRAY
	PRINTFORML ●？？？？？
	RESETCOLOR
ELSEIF STONE_PLAYCOUNT:2 > 15
	SETCOLOR C_RED
	PRINTFORML ★You got %STONE_UKETSUKENAME% pregnant!
	RESETCOLOR
ELSE
	SETCOLOR C_YELLOW
	PRINTFORML ★You're very good friends with %STONE_UKETSUKENAME%
	RESETCOLOR 
ENDIF
PRINTFORML
PRINTFORML
IF DAY:3 == 31
	PRINTFORML Today is Anything Goes Day!
ELSE
	PRINTFORML Today's Theme: %STONECombiDAY(DAY:3)%, Top Score:
	IF STONE_COMBI_WIN:(DAY:3) == 0
		SETCOLOR C_L_GRAY
		PRINTFORML ●You have not yet participated in this theme
		RESETCOLOR
	ELSE
		PRINTFORML %PRINT_PLUR("point", STONE_COMBI_WIN:(DAY:3))% Partner…%CALLNAME:(STONE_COMBI_COMBI:(DAY:3))%
	ENDIF
	PRINTFORML
	IF (MAIN_MAP == 6 && CFLAG:TARGET:同行) || CHK_DATENOW(CFLAG:12)
		PRINTFORML Today's Theme: %STONECombiDAY(DAY:3)%, %CALLNAME:TARGET%'s Top Score:
		IF STONE_COMBI_WIN:(DAY:3) == 0
			SETCOLOR C_L_GRAY
			PRINTFORML ●%CALLNAME:TARGET% has not yet participated in this theme
			RESETCOLOR
		ELSE
			PRINTFORML %PRINT_PLUR("point", STONE_COMBI_CHARA:TARGET:(DAY:3))%
		ENDIF
	ENDIF
ENDIF
PRINTFORML

{
CALL ASK_M("Show my personal details",1,
			"Show my partner's details", (MAIN_MAP == 6 && CFLAG:TARGET:同行) || (CHK_DATENOW(CFLAG:MASTER:デート中) && TARGET == FLAG:デート相手 && !TARGET == MASTER) ,
			"Return",1)
}
SELECTCASE RESULT
	CASE 0
		PRINTFORML 【Show my personal details】
		SETCOLOR C_YELLOW
		PRINTFORML Note: Conquered themes are shown in yellow.
		RESETCOLOR
		DRAWLINE
		;bugfix custom code, corrected loop condition
		FOR LOCAL,1, 31
			SIF STONE_COMBI_WIN:LOCAL == 0
				CONTINUE
			SIF STONE_COMBI_WIN:LOCAL > 79
				SETCOLOR C_YELLOW
			PRINTFORML %STONECombiDAY(LOCAL)% Top Score: {STONE_COMBI_WIN:LOCAL} Partner…%CALLNAME:(STONE_COMBI_COMBI:LOCAL)%
			SIF STONE_COMBI_WIN:LOCAL >79
				RESETCOLOR
		NEXT
		PRINTFORMW
	CASE 1
		PRINTFORML 【Show my partner's details】
		SETCOLOR C_YELLOW
		PRINTFORML Note: Conquered themes are shown in yellow.
		RESETCOLOR
		DRAWLINE
		;bugfix custom code, corrected loop condition
		FOR LOCAL,1, 31
			SIF STONE_COMBI_CHARA:TARGET:LOCAL == 0
				CONTINUE
			SIF STONE_COMBI_CHARA:TARGET:LOCAL >79
				SETCOLOR C_YELLOW
			PRINTFORML %STONECombiDAY(LOCAL)% Top Score:{STONE_COMBI_CHARA:TARGET:LOCAL}
			SIF STONE_COMBI_CHARA:TARGET:LOCAL >79
				RESETCOLOR
		NEXT
		PRINTFORMW
	CASE 2
		RETURN 0
ENDSELECT
RESTART

