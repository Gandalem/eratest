;積み石コンテスト
@COM_ABLE633
;一括管理
SIF GLOBAL_COMABLE(633)
	RETURN RESULT
SIF !INRANGE(TIME, 480, 1080)
	RETURN 0

IF !AT_HOME(MASTER)
	SIF CFLAG:MASTER:現在位置 != 三途の川
		RETURN 0
ELSE
	;冥界が拠点の場合は、賽の河原
	SIF CFLAG:MASTER:現在位置 != 602
		RETURN 0
ENDIF

;デート中はデート相手と一緒じゃないとダメ
SIF CHK_DATENOW(CFLAG:12) && TARGET != FLAG:デート相手
	RETURN 0

;睡眠中
SIF CFLAG:睡眠
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1

;-------------------------------------------------
;積み石コンテスト実行
;-------------------------------------------------

@Stone_Entry(Rank, MaxBattle, Prize)
#DIM Rank
#DIM MaxBattle
#DIM Prize
#DIM WIN_P
#DIM difficulty
#DIM DYNAMIC nPoorFag ;custom code
WIN_P = 0
difficulty = Rank
IF TALENT:MASTER:積み石ランカー < 6 && MONEY < 3000 ;custom code fix
	PRINTFORMW 「Umm, excuse me, but... It doesn't seem like you have enough funds to cover the entrance fee...」
	STONE_PLAYCOUNT:1 -= 50
	IF STONE_PLAYCOUNT:2 >= 14
		PRINTFORMW 「There's no helping you, really...%UNICODE(0x2764)% So be it, I'll pay for you myself%UNICODE(0x2764)%」
	ELSEIF STONE_PLAYCOUNT:2 >= 5
		PRINTFORMW 「...You're such a deadbeat sometimes. So be it, I'll pay for you out of courtesy because I'm your (only) friend.」
	ELSE
		PRINTFORMW 「Siiigh... I'll make it an exception for you this one time, but only this time, okay?」
	ENDIF
	nPoorFag = 1
ENDIF

SIF TALENT:MASTER:積み石ランカー < 6 && MONEY >= 3000 ;custom code fix
	CALL PAY_MONEY_YEN(3000, 2) ;custom code

	
;持ち込みアイテム
CALL STONE_MOCHIKOMI

FOR WIN_P, 0, MaxBattle
	IF WIN_P > 0
		STONE_PLAYCOUNT:1 += 1
		STONE_BATTLECOUNT:0 += 1
		STONE_BATTLECOUNT:1 += 1
		PRINTFORMW
		;custom code
		PRINTFORML 「Congratulations on winning the %ORDINAL(WIN_P)% round! \@ TALENT:MASTER:積み石ランカー == 6 || nPoorFag ? We can stop here if you like... # If you stop here you will get back the entry fee.\@ What will you do?」
		PRINTFORMW 「What will you do?」
		CALL ASK_YN("Continue","Stop")
		IF RESULT
			PRINTFORMW 「Oh well... Hope to see you back here again!!!」
			SIF TALENT:MASTER:積み石ランカー < 6 && !nPoorFag ;custom code fix
				CALL GET_MONEY_YEN(3000, 2) ;custom code
			CALL STONE_UKETSUKE
			TIME += 50
			RETURN -1
		ELSE
			PRINTFORMW 「That's the spirit!」
		ENDIF
	ENDIF
	PRINTFORMW 「Let's see here... The %ORDINAL(WIN_P + 1)% round opponent iiissss...」
	CALL STONELEVEL(difficulty)
	IF RESULT == 1
		PRINTFORMW 「You lost, so it ends here... Thank you for playing! We look forward to seeing you back here again!」
		STONE_BATTLECOUNT:0 += 1
		CALL STONE_UKETSUKE
		TIME += 50
		RETURN 0
	ELSE
		difficulty ++
	ENDIF
NEXT

PRINTFORMW 「Congratulations on your victory! The prize money of %金額表示(Prize)% is yours to take!」
STONE_PLAYCOUNT:1 += 3
STONE_BATTLECOUNT:0 += 1
STONE_BATTLECOUNT:1 += 1
IF TALENT:MASTER:積み石ランカー > Rank
	PRINTFORML 「Shouldn't you be striving to beat higher grades though?」
ELSE
	IF TALENT:MASTER:積み石ランカー == 0
		PRINTFORML 「And for your first win in the Toy Block-grade, you have earned a new title - Stacking Beginner!」
		PRINTFORML 「You may now attempt the Jenga-grade challenge, congratulations!」
		PRINTFORML 「Here's hoping your Stone Stacking legend starts here!」
	ELSEIF TALENT:MASTER:積み石ランカー == 1
		PRINTFORML 「And for your first win in the Jenga-grade, you have earned a new title - Stacking Rookie!」
		PRINTFORML 「You may now attempt the House of Cards-grade challenge, congratulations!」
		PRINTFORML 「There seems to be a lot of talk all over the Stone Stacking community that you are a promising new star!」
	ELSEIF TALENT:MASTER:積み石ランカー == 2
		PRINTFORML 「And for your first win in the House of Cards-grade, you have earned a new title - Stacking Elite!」
		PRINTFORML 「You may now attempt the Pyramid-grade challenge, congratulations!」
		PRINTFORML 「You are well on your way to building a career! Stone by stone, right to the top!」
	ENDIF
	TALENT:MASTER:積み石ランカー = Rank + 1
	STONE_PLAYCOUNT:1 += 7 + RANK
ENDIF
PRINTFORMW 「Come play again!」
IF TALENT:MASTER:積み石ランカー < 6 && nPoorFag ;custom code fix
	CALL GET_MONEY_YEN(Prize - 3000, 2) ;custom code
ELSE
	CALL GET_MONEY_YEN(Prize, 2) ;custom code
ENDIF

SIF STONE_PLAYCOUNT:2 > 2
	CALL GET_ITEM("滑石", 1, 2) ;custom code
CALL STONE_UKETSUKE
TIME += 60
RETURN 0

@Stone_Entry_EX(Rank, MaxBattle, Prize)
#DIM Rank
#DIM MaxBattle
#DIM Prize
#DIM WIN_P
#DIM difficulty
#DIM DYNAMIC nPoorFag ;custom code
WIN_P = 0
IF !TALENT:MASTER:積み石ランカー == 6 && MONEY < 3000
	PRINTFORMW 「Umm, excuse me, but... It doesn't seem like you have enough funds to cover the entrance fee...」
	STONE_PLAYCOUNT:1 -= 50
	IF STONE_PLAYCOUNT:2 >= 14
		PRINTFORMW 「There's no helping you, really...%UNICODE(0x2764)% So be it, I'll pay for you myself%UNICODE(0x2764)%」
	ELSEIF STONE_PLAYCOUNT:2 >= 5
		PRINTFORMW 「...You're such a deadbeat sometimes. So be it, I'll pay for you out of courtesy because I'm your (only) friend.」
	ELSE
		PRINTFORMW 「Siiigh... I'll make it an exception for you this one time, but only this time, okay?」
	ENDIF
	nPoorFag = 1
ENDIF
SIF TALENT:MASTER:積み石ランカー < 6 && MONEY >= 3000 ;custom code fix
	CALL PAY_MONEY_YEN(3000, 2) ;custom code

;持ち込みアイテム
CALL STONE_MOCHIKOMI

IF Rank == 3
	difficulty = 5
ELSEIF Rank == 4
	difficulty = 6
ENDIF

FOR WIN_P, 0, MaxBattle
	IF WIN_P > 0
		STONE_PLAYCOUNT:1 += 1
		STONE_BATTLECOUNT:0 += 1
		STONE_BATTLECOUNT:1 += 1
		PRINTFORMW
		;決勝前
		IF WIN_P == MaxBattle - 1
			IF TALENT:MASTER:積み石ランカー == 6
				PRINTFORML 「Congratulations on winning the fourth round! Your next opponent is our beloved Eika-chan, naturally...」
				PRINTFORMW 「But I'm sure you will be fine!」
			ELSE
				PRINTFORML 「Congratulations on winning the fourth round! Your next opponent is the strongest, so brace yourself!」
				PRINTFORMW 「If you instead stop here you will get back the entry fee. What will you do?」
			ENDIF
		ELSE
			;custom code
			PRINTFORML 「Congratulations on winning the %ORDINAL(WIN_P)% round! \@ TALENT:MASTER:積み石ランカー == 6 || nPoorFag ? We can stop here if you like... # If you instead stop here you will get back the entry fee.\@」
			PRINTFORMW 「What will you do?」
		ENDIF
		CALL ASK_YN("Continue","Stop")
		IF RESULT
			PRINTFORMW 「Oh well... Hope to see you back here again!!!」
			SIF TALENT:MASTER:積み石ランカー < 6 && !nPoorFag ;custom code fix
				CALL GET_MONEY_YEN(3000, 2) ;custom code
			CALL STONE_UKETSUKE
			TIME += 50
			RETURN -1
		ELSE
			PRINTFORMW 「That's the spirit!」
		ENDIF
	ENDIF
	IF WIN_P == MaxBattle - 1
		PRINTFORML 「Now is the time for the final round... Are you ready? Your last opponent is...」
		PRINTFORMW 「Oh yes! You know her, you love her... Iiiiiitttt'ssss...!!!」
		CALL STONELEVEL(Rank + 4)
	ELSE
		PRINTFORMW 「Let's see here... The %ORDINAL(WIN_P + 1)% round opponent iiissss...」
		CALL STONELEVEL(difficulty)
	ENDIF
	IF RESULT == 1
		IF WIN_P == MaxBattle - 1
			PRINTFORML
			PRINTFORML 「It's amazing that you were able to go toe to toe with Eika-chan herself!」
			PRINTFORMW 「It was really close... We hope you'll challenge her again some time!」
			STONE_PLAYCOUNT:1 += 1
		ELSE
			PRINTFORML
			PRINTFORMW 「Thank you for playing! We look forward to seeing you back here again!」
		ENDIF
		STONE_BATTLECOUNT:0 += 1
		CALL STONE_UKETSUKE
		TIME += 50
		RETURN 0
	ELSE
		difficulty = MIN(difficulty + 1, 6)
	ENDIF
NEXT
PRINTFORMW 「Congratulations on your victory! Here's your prize money, %金額表示(Prize)%!」
;ピラミッド
IF Rank == 3
	IF TALENT:MASTER:積み石ランカー > Rank
		PRINTFORML 「I'm pretty sure you can beat a higher grade than this though...」
	ELSE
		PRINTFORMW 「And for your first win in the Pyramid-grade... I present you with the title of Stacking Veteran, congratulations!」
		PRINTFORMW 「That aside...」
		PRINTFORMW 「I hope you didn't think this was the end of it just because it was the LUNATIC difficulty!」
		PRINTFORMW 「Actually, there's another grade that is said to be the stuff of legends, where you can fight with the real, super serious Eika-chan!」
		PRINTFORMW 「She's incredibly strong, and it's super hard, but... I have high hopes that *you* might be able to beat it!」
		TALENT:MASTER:積み石ランカー = Rank + 1
		STONE_PLAYCOUNT:1 += 10
	ENDIF
;バベル
ELSEIF Rank == 4
	IF TALENT:MASTER:積み石ランカー >= 5
		PRINTFORML 「I can't believe you actually managed to beat serious Eika-chan again... That's awesome!!!」
		STONE_PLAYCOUNT:1 += 7
	ELSE
		PRINTFORML 「And for your first win in the Tower of Babel-grade...」
		PRINTFORML 「W-Well, even if Eika-chan had already beat me to it... You have earned the title of Stacking Master! Amaaazing!」
		TALENT:MASTER:積み石ランカー = 5
		STONE_PLAYCOUNT:1 += 15
	ENDIF
	SIF STONE_PLAYCOUNT:2 == 13
		CALL STONE_UKETSUKE_H
ENDIF
STONE_PLAYCOUNT:1 += 1
STONE_BATTLECOUNT:0 += 1
STONE_BATTLECOUNT:1 += 1
PRINTFORMW 「Please be sure to come play with us again!」
IF TALENT:MASTER:積み石ランカー < 6 && nPoorFag ;custom code fix
	CALL GET_MONEY_YEN(Prize - 3000, 2) ;custom code
ELSE
	CALL GET_MONEY_YEN(Prize, 2) ;custom code
ENDIF
SIF STONE_PLAYCOUNT:2 > 2
	CALL GET_ITEM("滑石", 1, 2) ;custom code
IF STONE_PLAYCOUNT:2 == 9 || STONE_PLAYCOUNT:2 == 11
	CALL STONE_UKETSUKE_H
ELSE
	CALL STONE_UKETSUKE
ENDIF
TIME += 60
RETURN 0


;-------------------------------------------------
;積み石コンテストカップル部門関数
