;custom code edited
PRINTL Set a unique name for Mizuko Attendant.
LOCALS = Mizuko Attendant
PRINTFORML 
CALL ASK_M("Let's do this!",1, "It's an important decision, need some time to think about it",1)
SELECTCASE RESULT
	CASE 0
		LOCAL:9 = LINECOUNT
		REDRAW 0
		DO
			SIF LINECOUNT - LOCAL:9 > 0
				CLEARLINE LINECOUNT - LOCAL:9
			;bugfix custom code, enable formatting
			PRINTFORML Input a new name for %STONE_UKETSUKENAME%.
			PRINTBUTTON @"[Set to %LOCALS%]", @"%LOCALS%"
			PRINTL 　
			INPUTS
			; 行頭行尾の空白文字削除
			LOCALS = %RESULTS%
			REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
			;15文字以上は受け付けない
			IF STRLENS(LOCALS) > 15
				PRINTFORML 「I'm not sure I would like a name that long...」
				PRINTFORMW 「It would be a little troubling, I'm afraid.」
				CONTINUE
			;空白は受け付けない
			ELSEIF RESULTS == ""
				PRINTW Input a name.
				CONTINUE
			ELSE
				; 瓔花と同名
				IF STRCOUNT(LOCALS, "(?i)瓔花|eika")
					PRINTFORML 「B-Bwuh?! You want me to have the same name as E-Eika-chan?!」
					PRINTFORMW 「That... doesn't sound like a good idea at all...」
					CONTINUE
				ELSE
					PRINTFORML 「%RESULTS%, is it? Would that be correct?」
				ENDIF
				CALL ASK_YN
				IF !RESULT
					;受付水子の名前を保存
					STONE_UKETSUKENAME = %RESULTS%
