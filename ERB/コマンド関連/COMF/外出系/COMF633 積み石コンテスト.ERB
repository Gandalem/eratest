@STONE_NAMESET
;custom code edited
PRINTL 미즈코 시종에게 고유한 이름을 지정한다.
LOCALS = Mizuko Attendant
PRINTFORML 
CALL ASK_M("자, 해보자!",1, "중요한 결정이다, 생각해 볼 시간이 좀 필요하다.",1)
SELECTCASE RESULT
	CASE 0
		LOCAL:9 = LINECOUNT
		REDRAW 0
		DO
		SIF LINECOUNT - LOCAL:9 > 0
			CLEARLINE LINECOUNT - LOCAL:9
		;bugfix custom code, enable formatting
		PRINTFORML %STONE_UKETSUKENAME%에 새 이름을 입력한다.
		PRINTBUTTON @"[%LOCALS%로 설정한다.]", @"%LOCALS%"
		PRINTL 　
		INPUTS
		; 行頭行尾の空白文字削除
		LOCALS = %RESULTS%
		REPLACE LOCALS, "\(\^\\s\+\|\\s\+\$)", ""
		;15文字以上は受け付けない
		IF STRLENS(LOCALS) > 15
			PRINTFORML 「그렇게 긴 이름은 별로일 것 같네요...」
			PRINTFORMW 「조금 문제가 될까 봐 걱정입니다.」
			CONTINUE
			;空白は受け付けない
		ELSEIF RESULTS == ""
			PRINTW 이름을 입력하라.
			CONTINUE
		ELSE
			; 瓔花と同名
			IF STRCOUNT(LOCALS, "(?i)瓔花|eika")
				PRINTFORML 「바, 바우?! 내 이름이 에-에이카쨩이랑 같기를 원해?!」
				PRINTFORMW 「그건... 전혀 좋은 생각이 아닌 것 같은데...」
				CONTINUE
			ELSE
				PRINTFORML 「%RESULTS%, 그거야? 그게 맞을까?」
			ENDIF
			CALL ASK_YN
			IF !RESULT
				;受付水子の名前を保存
				STONE_UKETSUKENAME = %RESULTS%
				STONE_PLAYCOUNT:4 = 2
				PRINTFORMW 「%STONE_UKETSUKENAME%... 응! 정말 좋은 이름이야, 마음에 들어!」
				PRINTFORMW 「정말 고마워요, %CALLNAME:MASTER%-씨!」
				PRINTFORML 
				BREAK
			ELSE
				CONTINUE
			ENDIF
		ENDIF
		LOOP 1
	CASE 1
		PRINTFORMW 「좋아... 일단 보류해 두자.」
		;忘れ物 - that's the euphemism used for sex throughout the events above
		PRINTFORMW 「하지만 나에게 이름을 정하기로 결심했을 때... 또 편리하게 무언가를 "잊어버려" 주길 바라, 알겠지?」
		STONE_PLAYCOUNT:4 = 1
ENDSELECT

