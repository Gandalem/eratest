@COM633
#DIM WIN_P
#DIM STONE_ENTER ;本日コンテストに来た回数

;名付けイベントを見てないとき、受付水子への地の文の名前呼びは受付水子になる
SIF STONE_PLAYCOUNT:4 == 0
	STONE_UKETSUKENAME = Mizuko Attendant


IF FLAG:周回数 && STONE_BITE_A_DUST < FLAG:周回数
	STONE_BITE_A_DUST = FLAG:周回数
	SETCOLOR C_RED
	PRINTFORML Due to Bite the Dust (NG+), Stone Stacking Contest progress has been reset except for the skills gained.
	PRINTFORMW
	RESETCOLOR
	CALL MIZUKO_BITE_A_DUST
	VARSET STONE_PLAYCOUNT
	VARSET STONE_TUTORIAL
	VARSET STONE_BATTLECOUNT
	VARSET STONE_ITEM
	VARSET STONE_COMBI_WIN
	VARSET STONE_COMBI_COMBI
	VARSET STONE_COMBI_CHARA
	VARSET STONE_COMBI_TROPHY
	VARSET STONE_FIRSTSEX
	STONE_UKETSUKEDAY = 0
	;名付けのみ周回引継ぎ可に変更しました
	IF RESULT && STONE_UKETSUKENAME != "Mizuko Attendant"
		STONE_PLAYCOUNT:4 = 2
	ELSE
		STONE_UKETSUKENAME = Mizuko Attendant
	ENDIF
ENDIF

CALL MIZUKO_SETUP
;はじめてコンテストに行った
IF STONE_PLAYCOUNT:0 == 0
	IF TALENT:MASTER:積み石ランカー > 0
		IF STONE_BITE_A_DUST > 0
			IF CHK_DATENOW(CFLAG:MASTER:デート中) && TARGET == FLAG:デート相手 && !TARGET == MASTER
				PRINTFORMW You take %CALLNAME:TARGET% to the Stone Stacking Contest.
			ELSE
				PRINTFORMW %CALLNAME:MASTER% visit the Stone Stacking Contest.
			ENDIF
			PRINTFORML 「Hello, and welcome! This is where we hold the Stone Stacking Contest!」
			PRINTFORML 「I'm your host %STONE_UKETSUKENAME%, one of the spirits of a stillborn child from around here--」
			PRINTFORML 「Wha...? Wait a second...」
			PRINTFORML
			PRINTFORMW 「...??? You have no record of participation, yet you hold the Stacking title?! What kind of trickery is this?」
			PRINTFORMW 「Hmmm～... Well, whatever! It's not such a big deal! You're in! And you can even keep your title if you like.」
			PRINTFORML
			PRINTFORMW 「Unless of course you choose otherwise, in which case we'll just revoke that title.」
			PRINTFORMW 「There's no downside to keeping it, but you may get treated like a rookie when you are already a veteran!」
			PRINTFORMW 「Also, regardless of your choice, the number of matches and wins to date will be completely reset!」
		ELSE
			IF CHK_DATENOW(CFLAG:MASTER:デート中) && TARGET == FLAG:デート相手 && !TARGET == MASTER
				PRINTFORML 「Hello, and welcome! This is where we hold the Stone Stacking Contest!」
				PRINTFORML 「I'm your host %STONE_UKETSUKENAME%, one of the spirits of a stillborn child from around here--」
				PRINTFORML 「Wha...? Wait a second...」
				PRINTFORMW You take %CALLNAME:TARGET% to the Stone Stacking Contest in which you have participated in before.
				PRINTFORML
				PRINTFORML 「My apologies! It appears that you have participated in one of our previous Stone Stacking Contest!」
				PRINTFORMW 「But be it as it may... The contest has been reborn with a new and improved version!」
				PRINTFORMW 「The highlight is the newly established couples division! You can go ahead and try to tackle it with %CALLNAME:TARGET% right now～!」
				PRINTFORMW 「Be sure to check the HELP section for more info should you need it!」
				PRINTFORML
				PRINTFORML 「So on that note, we can let you keep your previous title if you like... What will you do?」
				PRINTFORMW 「There's no downside to it, but you may get treated like a rookie when you are already a veteran!」
				PRINTFORMW 「Also, regardless of your choice, you will start with a clean record concerning your wins and matches, as we have never tracked them before.」
			ELSE
				PRINTFORML 「Hello, and welcome! This is where we hold the Stone Stacking Contest!」
				PRINTFORML 「I'm your host %STONE_UKETSUKENAME%, one of the spirits of a stillborn child from around here--」
				PRINTFORML 「Wha...? Wait a second...」
				PRINTFORMW You make your way to the Stone Stacking Contest held at the Sai no Kawara, which you have clearly participated in before!
				PRINTFORML
				PRINTFORML 「My apologies! It appears that you have participated in one of our previous Stone Stacking Contest!」
				PRINTFORMW 「But be it as it may... The contest has been reborn with a new and improved version!」
				PRINTFORMW 「The highlight is the newly established couples division! Be sure to check the HELP section for more info should you need it!」
				PRINTFORML 「So on that note, we can let you keep your previous title if you like... What will you do?」
				PRINTFORMW 「There is no downside to it, but you may get treated like a rookie when you are already a veteran!」
				PRINTFORMW 「Also, regardless of your choice, you will start with a clean record concerning your wins and matches, as we have never tracked them before.」
			ENDIF
		ENDIF
		;custom code moved
		PRINTFORML
		PRINTFORML 「Would you like to keep your previous Stacking title? (※You will start over from zero if not)」
		CALL ASK_YN("Keep my title","I want to start over!")
		IF !RESULT
			
		ELSE
			PRINTFORML You have lost your Stacking rank...
			TALENT:MASTER:積み石ランカー = 0
		ENDIF
	ELSE
		IF CHK_DATENOW(CFLAG:MASTER:デート中) && TARGET == FLAG:デート相手 && !TARGET == MASTER
			PRINTFORML 「Hello, and welcome! This is where we hold the Stone Stacking Contest!」
			PRINTFORML 「I'm your host %STONE_UKETSUKENAME%, one of the spirits of a stillborn child from around here!」
			PRINTFORMW While dating, you and %CALLNAME:TARGET% stumble upon a mysterious contest taking place at the Sai no Kawara [Children's Limbo].
			PRINTFORML
			PRINTFORML 「As the name suggests, it's a contest to see how good you are at stacking stones!」
			PRINTFORMW 「No reservations needed, and you can join anytime, so feel free to give it a shot!」
			PRINTFORMW 「I suggest you enter in the couples division since you're on a date!」
			PRINTFORMW 「Lastly, be sure to check the HELP section for more info should you need it!」
		ELSE
			PRINTFORML 「Hello, and welcome! This is where we hold the Stone Stacking Contest!」
			;custom line to explain mizuko
			PRINTFORML 「I'm your host %STONE_UKETSUKENAME%, one of the spirits of a stillborn child from around here!」
			PRINTFORMW For some reason or another, you manage to stumble upon a mysterious contest taking place at the Sai no Kawara [Children's Limbo].
			PRINTFORML
			PRINTFORML 「As the name suggests, it's a contest to see how good you are at stacking stones!」
			PRINTFORMW 「No reservations needed, and you can join anytime, so feel free to give it a shot!」
			PRINTFORMW 「If you are a beginner, I suggest you start with the Toy Block-grade and work your way up from there!」
			PRINTFORMW 「Lastly, be sure to check the HELP section for more info should you need it!」
		ENDIF
	ENDIF
	;custom code moved
	PRINTFORML
	PRINTFORML 「Now then, without further ado...」
	SELECTCASE TALENT:MASTER:積み石ランカー
		CASE 0
		CASE 1
			STONE_PLAYCOUNT:1 += 7
		CASE 2
			STONE_PLAYCOUNT:1 += 15
		CASE 3
			STONE_PLAYCOUNT:1 += 24
		CASE 4
			STONE_PLAYCOUNT:1 += 34
		CASE 5
			STONE_PLAYCOUNT:1 += 50
		CASEELSE
	ENDSELECT
ENDIF

;受付水子妊娠後
IF STONE_PLAYCOUNT:2 == 16 && (DAY:0 >= STONE_UKETSUKEDAY + 14)
	;Mizuko takes maternity leave and gives birth in 2 weeks time as described in the below event
	PRINTFORML 「Oh! Um, hi... Hello there. It's been a while, hasn't it?」
	PRINTFORMW 「I, uh... I was able to give birth to your baby safely.」
	PRINTFORML
	PRINTFORMW 「Fufufu... Ehehehe...!」
	PRINTFORMW 「Oh, right! I need to get back to work now, don't I? Ahem!」
	PRINTFORMW 「...But by all means, be sure to come see me if you have something to "retrieve"... in case you've "lost" it, if you know what I mean.」
	STONE_PLAYCOUNT:2 = 17
ELSEIF STONE_PLAYCOUNT:2 == 16 && !(DAY:0 >= STONE_UKETSUKEDAY + 14)
	PRINTFORMW 『Stacking Stone Contest is currently on vacation!　We will reopen \@ STONE_UKETSUKEDAY + 14 - DAY:0 == 1 ? tomorrow # in {STONE_UKETSUKEDAY + 14 - DAY:0} days\@!』
	RETURN 0
ENDIF

;積み石王
IF STONE_COMBI_TROPHY:31 == 1 && TALENT:MASTER:積み石ランカー == 5 ;bugfix custom code, correct rank
	PRINTFORMW 「Eh?! WOW! Th-That's amaaaaziiiing!!!!!!」
	PRINTFORMW 「Not only you have beaten the super serious Eika-chan in the fast stacking division, you also managed to conquer every single theme there is?!」
	PRINTFORMW 「At this point, you are more than just a Stacking Master, you are... the Stacking King!!!」
	PRINTFORMW 「I present you with the right to participate in as many contests as you want for absolutely no charge at all from now on!」
	PRINTFORMW 「You may not have much to do here anymore, but... but... I hope you'll come back and visit me sometime!」
	PRINTFORMW 「I'll be very happy to see you again, any time!」
	TALENT:MASTER:積み石ランカー = 6 ;bugfix custom code, correct rank
ENDIF

;今日はじめて来たときの判定
IF STONE_ENTER < DAY
	STONE_ENTER = DAY
	SIF STONE_PLAYCOUNT:2 > 0
		PRINTFORML 「Ah! %CALLNAME:MASTER%-san!」
	STONE_PLAYCOUNT:1 += 7
	;受付水子と友達になるとデイリー好感度が増加
	SIF STONE_PLAYCOUNT:2 > 5
		STONE_PLAYCOUNT:1 += 3
	STONE_PLAYCOUNT:0 += 1
ENDIF


IF CHK_DATENOW(CFLAG:MASTER:デート中) && TARGET == FLAG:デート相手 && !TARGET == MASTER
	CALL STONECouple
;拠点が三途の川～冥界の場合連れ出しているだけでもOK(ただし好感度1000が最低条件)
ELSEIF MAIN_MAP == 6 && CFLAG:TARGET:同行 && CFLAG:MASTER:同行 
	IF CFLAG:TARGET:好感度 < 1000
		PRINTFORMW %CALLNAME:TARGET% turns you down, claiming %HE_SHE(TARGET)% isn't comfortable with participating in the couples division with you.
		PRINTFORMW Alas... Let's head on over to the solo division...
	ELSE
		CALL STONECouple
	ENDIF
ELSE
	CALL MIZUKO_FACE, "笑顔", "服", "通常"
	;custom code
	PRINTFORML 「Welcome to the Stone Stacking Contest! Which grade would you like to try? \@ TALENT:MASTER:積み石ランカー == 6 ? It's free of charge for our revered %PRINT_MALE("King:Queen", MASTER)% of Stacking! # The entrance fee is %金額表示(3000)%.\@」
	$LOOP1
	DRAWLINE
	{
	CALL ASK_M("EASY- Toy Block-grade - (Very simple to stack)",1,
	"NORMAL - Jenga-grade - (Will collapse if you're careless)", TALENT:MASTER:積み石ランカー >= 1,
	"HARD - House of Cards-grade - (Even getting started is nerve-wracking!)",TALENT:MASTER:積み石ランカー >= 2,
	"LUNATIC - Pyramid-grade - (Might as well start throwing them stones)", TALENT:MASTER:積み石ランカー >= 3,
	"PHANTASM - Tower of Babel-grade - (Throw them all you want, it won't do a damn thing!)", TALENT:MASTER:積み石ランカー >= 4,
	"Mind telling me what's today's theme?",1, "I want to check my score",1, "HELP",1, "Return",1)
	}
	IF RESULT == 0
		PRINTFORMW 「Toy Block-grade challenge! Succeed twice to win!」
		CALL Stone_Entry(0, 2, 5000)
	ELSEIF RESULT == 1
		PRINTFORMW 「Jenga-grade challenge! Have you gotten used to stacking stones yet? Succeed thrice to win!」
		CALL Stone_Entry(1, 3, 7000)
	ELSEIF RESULT == 2
		PRINTFORMW 「House of Cards-grade challenge! You've got everyone's attention! Succeed four times to win!」
		CALL Stone_Entry(2, 4, 10000)
	ELSEIF RESULT == 3
		PRINTFORMW 「Pyramid-grade challenge! You've finally made it this far! Succeed five times to win!」
		CALL Stone_Entry_EX(3, 5, 15000)
	ELSEIF RESULT == 4
		PRINTFORML 「Tower of Babel-grade challenge?! To think I'd see someone attempt to tackle this legendary grade...!」
		PRINTFORMW 「I wish you the best of luck! Succeed five times to win!」
		CALL Stone_Entry_EX(4, 5, 30000)
	ELSEIF RESULT == 5
		CALL StoneTheme_Intro
		GOTO LOOP1
	ELSEIF RESULT == 6
		CALL StoneBattle_record
		GOTO LOOP1
	ELSEIF RESULT == 7
		CALL Stone_Help
		GOTO LOOP1
	ELSEIF RESULT == 8
		RETURN -1
	ENDIF
	RETURN 1
ENDIF



