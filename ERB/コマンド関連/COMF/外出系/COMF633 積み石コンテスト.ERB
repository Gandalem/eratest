@STONECouple
CALL MIZUKO_FACE, "笑顔", "服", "通常"
;custom code
PRINTFORML 「Welcome to the Stone Stacking Contest, couples division! \@ TALENT:MASTER:積み石ランカー == 6 ? It's free of charge for our revered %PRINT_MALE("King:Queen", MASTER)% of Stacking! # The entrance fee is %金額表示(3000)% as well!\@」
$LOOP2
DRAWLINE
{
CALL ASK_M("Compete in the couples division",1, "Mind telling me what's today's theme?",1, "I want to check my score",1, "HELP",1, "Return",1)
}
IF RESULT == 0
	PRINTFORMW 「Couples division challenge! This way please!」
	IF MONEY < 3000 ;custom code fix
		PRINTFORMW You didn't have the %金額表示(3000)% entry fee, so you had %CALLNAME:TARGET% pay it instead...
		CALL CHANGE_CFLAG(2, TARGET, -50) ;custom code
	ENDIF
	CALL STONECombiBattle
ELSEIF RESULT == 1
	CALL StoneTheme_Intro
	GOTO LOOP2
ELSEIF RESULT == 2
	CALL StoneBattle_record
	GOTO LOOP2
ELSEIF RESULT == 3
	CALL StoneCombi_Help
	GOTO LOOP2
ELSEIF RESULT == 4
	RETURN -1
ENDIF
RETURN 1

