; Modular ERB: COMF/外出系/COMF625 家具屋.ERB
;家具屋

@COM625
#DIM 売値
#DIM ループ数
#DIM リザルト
#DIM 資材保管
#DIM 削除行数
#DIM MaterialQTY
#DIMS DiscountedPrice
ループ数 = 0
;開店時間・閉店時間
; IF INRANGE(TIME:0, 480, 1200) == 0 ;logging custom code
; 	PRINTFORMW Outside of business hours.
; 	RETURN -1
; ENDIF
IF !LS_RESTRICTION("Furniture store hours")
	CALL BusinessHours(480,1200)
	SIF RESULT == -1
		RETURN -1
ENDIF
;初回イベント
IF FLAG:最後に家具屋に訪れた日 == 0
	PRINTL 
	PRINTFORMW "가구점"이라고 쓰인 간판이 눈에 들어오고, 당신은 문을 열기로 결정한다.
	PRINTFORMW 하지만 그렇게 하자...
	PRINTFORMW 「...젠장, 대체 네 정체가 뭐야? 흐으?!」
	PRINTFORMW 「뭐? 그래, 여긴 가구점이야, 그건 맞지. 그래서 뭔데?」
	PRINTFORMW 「"팔 만한 거 있나요?"」
	PRINTFORMW 「멍청하게 굴지 마, 바보야. 옷장이든 뭐든 전부 주문 제작하는 거야. 그리고 지금은 일이 없어.」
	PRINTFORMW 「...그래서? 나한테 뭘 원하는 건지 솔직히 말해봐.」
	PRINTFORMW 「...흐읍? 네가 진짜를 보기 전에 결정할 줄 알았나?」
	PRINTFORMW 「사지도 않고 구경만 하려면, 당장 나가...」
	PRINTFORMW 「그렇게 말하고 싶지만, 뭐 어쩌겠어. 잠시만, 지난번 작업의 장부를 어디에 두었더라――」
	PRINTFORMW 　그 남자는 놀라울 정도로 정확하게 지출 내역이 적힌 문서를 당신에게 제시했다.
	PRINTFORMW 　...맙소사, 정말 비싸네!
	PRINTFORMW 「그건 내가 공들여 만든 걸 대충 팔 리가 없으니까 그래.」
	PRINTFORMW 　당신은 그에게 혹시 다른 방법이 없는지 물어보려 한다...
	PRINTFORMW 「네 돈을 다 갈취할 생각이었는데, 뭐...」
	PRINTFORMW 「...일리가 있군. 만약 나무 재료를 제공해 줄 수 있다면 할인된 가격으로 해줄 수 있어.」
	PRINTFORMW 　그는 이쪽과 저쪽의 비율 등을 보여주기 시작했다...
	PRINTFORMW  뭐, 네가 감당할 수 있는 비율로 결정하겠지.
	PRINTFORMW 「흥. 돈과 마음이 있다면 주문해 봐. 내가 최고 중의 최고로 만들어 줄 테니까!」
	PRINTL 
	ループ数 = 1
ENDIF
;conflicts with my timer
;SIF FLAG:作成中家具
;	FLAG:家具作成残り = MAX(FLAG:家具作成残り-((DAY:0 - FLAG:最後に家具屋に訪れた日) * 2),0)
$LOOP_SELECT
IF ループ数
	PRINTL 
	IF FLAG:家具作成残り
		PRINTFORMW 「비켜봐, 나 여기서 일하고 있잖아!」
	ELSE
		PRINTFORMW 「뭐야, 아직도 뭔가 원하는 거 있어?」
	ENDIF
ELSE
	;平常来店
	PRINTL 
	;家具発注中
	IF FLAG:家具作成残り >= 14
		PRINTFORMW 「뭐야, 또 너냐? 야, 너는 아침 설사만큼 성급하구나. 나는 아직 설계도 단계일 뿐이니까, 어서 가렴.」
	ELSEIF FLAG:家具作成残り >= 9
		PRINTFORMW 「뭐야, 또 너냐? 주문한 거에 관한 일이라면 시간이 좀 걸릴 거야. 인내심을 가져줘.」
	ELSEIF FLAG:家具作成残り >= 5
		PRINTFORMW 「뭐야, 또 너냐? 걱정 마, 네가 주문한 가구 작업 중이니까. 아직 갈 길이 남았지만.」
	ELSEIF FLAG:家具作成残り >= 2
		PRINTFORMW 「네, 주문하신 가구 거의 다 만들었어요!」
	ELSEIF FLAG:作成中家具 && FLAG:家具作成残り == 0
		;完成日
		IF nFurnitureStoreComplete == 0 ;changed with this since your first order might be anything else
			PRINTFORMW 「야, 와줘서 다행이네. 어라, 뭐라고?」
			PRINTFORMW 「주문했던 %ITEMNAME_TR(FLAG:作成中家具)%의 완성품을 직접 봤는데, 왜 여기까지 가게까지 온 거야?」
			PRINTFORMW 「배송 확인증에 서명하는 것 같은 처리할 일들이 좀 있거든.」
			PRINTFORMW 「제대로 안 하면 나중에 골치 아파질까 봐 걱정이야.」
			nFurnitureStoreComplete = 1
		ELSE
			PRINTFORMW 「야, %PRINT_MALE("man_:miss", MASTER)%. 기다리게 해서 미안하다. 주문한 게 여기 있다.」
		ENDIF
		IF FLAG:作成中家具 == 907
			PRINTFORMW 「솔직히 말하자면... 저는 청소 도구 전문가가 아니라 시간이 좀 걸렸어요.」
		ELSEIF ITEM:(FLAG:作成中家具) == 2
			PRINTFORMW 「하아... 이거 정말 오랜만에 만족스러운 작품이 된 것 같군. 결과에 만족해 주리라 확신한다.」
			PRINTFORMW 「정말로, 지금 내가 해줄 수 있는 최선이야. 이것보다 더 좋을 수는 없을 거야!」
		ELSEIF ITEM:(FLAG:作成中家具) == 1
			PRINTFORMW 「음-흠, 네가 걱정했던 부분은 보완했지만... 뭐, 이 정도가 최선이야.」
			PRINTFORMW 「창조자의 만족과 사용자의 만족은 약간 다른 것이기에, 그것들을 균형 잡는 것은 진정한 장인만이 할 수 있는 일이지.」
		ELSE
			PRINTFORMW 「원하는 가구가 있다면 또 나에게 말해줘. 아, 그리고 현재 가지고 있는 가구에 만족하지 못한다면 그것도 알려줘.」
		ENDIF
		PRINTL 
		SETCOLOR 0x00FF00
		PRINTFORM %ITEMNAME_TR(FLAG:作成中家具)% 
		IF ITEM:(FLAG:作成中家具) == 0
			PRINTFORMW 획득했다!
		ELSE
			PRINTFORMW 사용하기 더 편하도록 개조되었다!
		ENDIF
		RESETCOLOR
		PRINTL 
		ITEM:(FLAG:作成中家具) ++
		FLAG:作成中家具 = 0
	ELSE
		IF DAY:0 - FLAG:最後に家具屋に訪れた日 > 28
			PRINTFORMW 「뭐야, 또 너니? 드디어 주문할지 결정했어?」
		ELSEIF FLAG:最後に家具屋に訪れた日 == DAY:0
			PRINTFORMW 「네가 뭔데? 너 때문에 귀찮아질 시간 없어...」
			PRINTFORMW 「...그리고 그래, 지금 나 한가한 건 알아, 꺼져버려.」
		ELSE
			PRINTFORMW 「뭐야, 또 너냐? 가구라도 원하는 거니?」
		ENDIF
	ENDIF
ENDIF
ループ数 ++
FLAG:最後に家具屋に訪れた日 = DAY:0
PRINTFORM 　　금액: %金額表示(MONEY)%
IF FLAG:作成中家具
	PRINTFORML 　　%ITEMNAME_TR(FLAG:作成中家具)% 제작 중이다 예상 배송일: %PRINT_PLUR("day", FLAG:家具作成残り)%.
ELSE
	PRINTL 
ENDIF
DRAWLINE
CALL ASK_M("주문을 한다", !FLAG:作成中家具, "거래에 관하여", 1, "상점 나가기", 2)
SELECTCASE RESULT
	;家具を作ってほしい
	CASE 0
		PRINTFORMW 「만약 가구에 대해 이야기한다면... 이걸 원하시나요?」
		$INPUT_LOOP01
		;リストの呼び出し
		削除行数 = 0
		FOR LOCAL, 902, 909
		削除行数 ++
		IF ITEM:LOCAL == 3
			PRINTPLAINFORM 　[{LOCAL}]
			LOCALS = %ITEMNAME_TR(LOCAL)%(Lv{ITEM:LOCAL})
			PRINTPLAINFORM %LOCALS, 32, LEFT%
		ELSE
			PRINTFORM 　
			PRINTFORM [{LOCAL}]
			IF ITEM:LOCAL == 0
				;未所持
				PRINTFORM %ITEMNAME_TR(LOCAL), 32, LEFT%
			ELSE
				;所持
				LOCALS = %ITEMNAME_TR(LOCAL)%(Lv{ITEM:LOCAL})
				PRINTFORM %LOCALS, 32, LEFT%
			ENDIF
		ENDIF
		CALL FURNITURE_EXPLANATION(LOCAL)
		NEXT
		PRINTFORML 　[999] 취소
		削除行数 ++
		INPUT
		リザルト = RESULT
		MaterialQTY = FURNITURE(リザルト, "軽減上限", ITEM:リザルト)
		SELECTCASE リザルト
			CASE 902 TO 908
				;Lv3の時は選択できない
				IF ITEM:リザルト == 3
					CLEARLINE 削除行数 + 1
					GOTO INPUT_LOOP01
				ENDIF
				;木材データ呼び出し
				CALL WoodData(FURNITURE(リザルト, "資材番号"))
				;注文家具の請求を作成
				DRAWLINE
				PRINTFORML [\@ ITEM:リザルト == 0 ? 주문하기 # 업그레이드하기 \@] %ITEMNAME_TR(リザルト)%
				;所持製材量での値引きの表記
				;Lv1→2の時は半額
				IF ITEM:リザルト == 1
					PRINTFORM 　%"Cost", 20, LEFT%: %金額表示((ITEMPRICE:リザルト / 2))% → 
				ELSE
					PRINTFORM 　%"Cost", 20, LEFT%: %金額表示(ITEMPRICE:リザルト)%  → 
				ENDIF
				DiscountedPrice = %金額表示(FURNITURE(リザルト, 0, ITEM:リザルト))%
				IF FURNITURE(リザルト, 0, ITEM:リザルト) == FURNITURE(リザルト, "最低額", ITEM:リザルト)
					SETCOLOR C_RED
				ELSEIF ITEM:リザルト == 1 && FURNITURE(リザルト, 0, ITEM:リザルト) < ITEMPRICE:リザルト / 2
					SETCOLOR C_YELLOW
				ELSEIF FURNITURE(リザルト, 0, ITEM:リザルト) < ITEMPRICE:リザルト
					SETCOLOR C_YELLOW
				ENDIF
				PRINTFORML %DiscountedPrice%%COND_STR(@" 가장 낮은 가격!", FURNITURE(リザルト, 0, ITEM:リザルト) == FURNITURE(リザルト, "最低額", ITEM:リザルト))%
				RESETCOLOR
				;価格軽減に必要な資材量と現在所持量の比較
				PRINTFORM 　비용 절감 조건: {MaterialQTY}개 %WOOD_NAME(FURNITURE(リザルト, "資材番号"))% 목재 공급
				SIF LOG_SALES:FURNITURE(リザルト, "資材番号") >= MaterialQTY
					SETCOLOR C_RED
				PRINTFORML （{LOG_SALES:FURNITURE(リザルト, "資材番号")}／{MaterialQTY}）
				RESETCOLOR
			CASE 999
				PRINTL 
				CALL WOOD_V_RESET
				GOTO LOOP_SELECT
			CASEELSE
				CLEARLINE 1
				GOTO INPUT_LOOP01
		ENDSELECT
		PRINTL 
		IF ITEM:リザルト == 0
			CALL ASK_M("이 가구를 만들어라", MONEY >= FURNITURE(リザルト, 0), "취소", 1)
		ELSE
			CALL ASK_M("이 가구를 업그레이드한다", MONEY >= FURNITURE(リザルト, 0, ITEM:リザルト) && ITEM:リザルト <= 2, "취소", 1)
		ENDIF
		IF RESULT
			CALL WOOD_V_RESET
			CLEARLINE 9 + 削除行数
			GOTO INPUT_LOOP01
		ELSE
			;費用の支払い
			PRINTFORMW 　돈: %金額表示(MONEY)% → %金額表示(MONEY - FURNITURE(リザルト, 0, ITEM:リザルト))%
			PRINTFORM 　
			CALL PAY_MONEY_YEN(FURNITURE(リザルト, 0, ITEM:リザルト))
			;製材等の消費  軽減上限量以上に持っていれば上限量分減らし、上限に達していなければ全部消費
			;現在の製材の量を退避してから計算
			資材保管 = LOG_SALES:FURNITURE(リザルト, "資材番号")
			LOG_SALES:FURNITURE(リザルト, "資材番号") = MAX(0, LOG_SALES:FURNITURE(リザルト, "資材番号") - MaterialQTY)
			;文章部分
			PRINTFORMW 　%WOOD_NAME(FURNITURE(リザルト, "資材番号"))%벌목: {資材保管} → {LOG_SALES:FURNITURE(リザルト, "資材番号")}
			PRINTL 
			LOCAL = FURNITURE(リザルト, "期間", ITEM:リザルト)
			IF ITEM:リザルト
				PRINTFORMW 「흥, 네가 오래된 가구에 만족하지 못하는군. 그럼 가져와 보라고!」
				PRINTFORMW 「내일 \@ LOCAL == 1 ?  # {LOCAL}일 후에 돌아와라 \@, 내가 분명 깜짝 선물을 줄 테니까!」
			ELSE
				PRINTFORMW 「좋아, 거래 성립됐어! \@ LOCAL == 1 ? 내일 # {LOCAL}일 이내에 배달될 걸 기대해 \@.」
				PRINTFORMW 「그리고 다시는 내 가게에 나타나지 마!」
			ENDIF
			FLAG:家具作成残り = LOCAL
			FLAG:作成中家具 = リザルト
		ENDIF
		;取引内容を確認する
	CASE 1
		PRINTFORMW 「하아? 이걸 다시 해달라고? 에이...」
		PRINTFORMW 「봐, 여긴 가구점이니까 당연히 가구를 만드는 게 전문이야.」
		PRINTFORMW 「목재를 네가 제공해 주면 할인해서 만들어 줄게.」
		PRINTFORMW 「당연하겠지만, 주문한 가구를 만드는 데는 시간이 좀 걸릴 거야.」
		PRINTFORMW 「뜬구름에서 그냥 생겨날 리가 없잖아, 당연히!」
		PRINTFORML 「말 나온 김에, 나는 그 기간 동안 대기 중인 가구 제작에만 집중하고 있어서,」
		PRINTFORMW 　「다른 주문은 받지 않을 거야.」
		PRINTFORMW 「그리고 응, 내가 만든 가구가 마음에 들지 않으면 바로 말해줘.」
		PRINTFORMW 「돈은 받을 테니, 더 잘 만들어 줄게.」
		PRINTL 
	CASE 2
		PRINTFORMW 「그래, 개뿔. 당장 여기서 꺼져 버려.」
		PRINTL 
		TIME += ループ数 * 5
		RETURN -1
ENDSELECT
GOTO LOOP_SELECT
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;家具屋

@COM_ABLE625
;一括管理
SIF GLOBAL_COMABLE(625)
	RETURN RESULT
IF !AT_HOME(MASTER)
	SIF CFLAG:MASTER:現在位置 != 長屋街
		RETURN 0
ELSE
	;長屋前
	SIF CFLAG:MASTER:現在位置 != 214
		RETURN 0
ENDIF
;睡眠中
SIF CFLAG:MASTER:睡眠 || CFLAG:MASTER:イタズラ || CFLAG:うふふ ;custom code
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1
;-------------------------------------------------
;注文できる家具リストに付随する説明文
;ARG 家具のアイテム番号
;-------------------------------------------------

@FURNITURE_EXPLANATION(ARG)
IF ITEM:ARG
	PRINTFORM 지점: 
	SELECTCASE ARG
		CASE 902
			LOCALS = %NAME_FROM_PLACE(NEAR_BATH(1))%
		CASE 904, 907
			LOCALS = On %CALLNAME:MASTER%
		CASEELSE
			LOCALS = %CALLNAME:MASTER%'s Room
	ENDSELECT
	PRINTFORMD %LOCALS, 26, LEFT%
ELSE
	PRINTFORM %" "*32%
ENDIF
SIF ITEM:ARG == 0
	SETCOLOR C_GRAY
SELECTCASE ARG
	CASE 902
		PRINTFORM 지정된 장소에서 목욕할 때 STA와 ENE 회복을 증가시킨다.
	CASE 903
		PRINTFORM 수면 중 STA, ENE 및 VIG 회복량을 증가시킨다.
	CASE 904
		PRINTFORM 당신의 음식 품질을 향상시킨다.
	CASE 905
		PRINTFORM 방에서 공부하고 섞는 효율을 높여준다.
	CASE 906
		PRINTFORM 당신의 방에서 휴식할 때 STA, ENE 및 VIG 회복을 증가시킨다.
	CASE 907
		PRINTFORM 청소 효율을 높인다.
	CASE 908
		PRINTFORM 전투 기술이 %PARSE("yours")%보다 낮은 침입자가 들어오는 것을 막는다.
	CASEELSE
		PRINT 
ENDSELECT
IF ITEM:ARG == 3
	SETCOLOR C_ORANGE
	PRINTFORML ▲▲
ELSEIF ITEM:ARG == 2
	SETCOLOR C_YELLOW
	PRINTFORML ▲
ELSE
	PRINTL 
ENDIF
RESETCOLOR
;-------------------------------------------------
;家具注文で使用する各種数値をまとめた関数
;現状は902～907
;F_ID …家具のアイテム番号
;ARGS 0= 補正価格(省略時)  1= 資材による軽減上限数
;      2= 家具に対応する資材番号  3= 軽減最低額
;      4= 発注後の作成期間   を返す
;EnhanceTime 0= 初発注(省略時)  1= 強化１  2= 強化２
;        主にITEM:家具番号を入れて利用
;-------------------------------------------------

@FURNITURE(F_ID, ARGS, EnhanceTime = 0)
#FUNCTION
#DIM F_ID
#DIM EnhanceTime
#DIM DiscountRate
#DIM MaxDiscount
#DIM 資材番号
#DIM 軽減上限
#DIM 最低額
#DIM 補正価格
#DIM 期間
;手持ち製材との調整価格を表記
SELECTCASE F_ID
	;ヒノキ風呂
	CASE 902
		資材番号 = 2;ヒノキ
		軽減上限 = 50
		最低額 = 250000
		期間 = 15
		;キリのベッド
	CASE 903
		資材番号 = 8;キリ
		軽減上限 = 30
		最低額 = 200000
		期間 = 10
		;イチョウのまな板
	CASE 904
		資材番号 = 6;イチョウ
		軽減上限 = 10
		最低額 = 50000
		期間 = 5
		;ケヤキの机椅子
	CASE 905
		資材番号 = 7;ケヤキ
		軽減上限 = 30
		最低額 = 200000
		期間 = 10
		;ナラのソファー
	CASE 906
		資材番号 = 9;ナラ
		軽減上限 = 30
		最低額 = 200000
		期間 = 10
		;カスタム竹箒
	CASE 907
		資材番号 = 12;竹
		軽減上限 = 30
		最低額 = 30000
		期間 = 10
		;door
	CASE 908
		資材番号 = 8;キリ
		軽減上限 = 30
		最低額 = 50000
		期間 = 10
ENDSELECT
;Lv1→Lv2時は半分  Lv2→Lv3時は最初と同じで
MaxDiscount = ITEMPRICE:F_ID - 最低額
IF EnhanceTime == 1
	軽減上限 /= 2
	最低額 /= 2
	期間 /= 2
	MaxDiscount /= 2
ENDIF
SIF ARGS == "資材番号"
	RETURNF 資材番号
SIF ARGS == "軽減上限"
	RETURNF 軽減上限
SIF ARGS == "最低額"
	RETURNF 最低額
SIF ARGS == "期間"
	RETURNF 期間
DiscountRate = 100 * MIN(LOG_SALES:資材番号, 軽減上限) / 軽減上限
IF EnhanceTime == 1
	補正価格 = (ITEMPRICE:F_ID / 2) - MaxDiscount * DiscountRate / 100
ELSE
	補正価格 = ITEMPRICE:F_ID - MaxDiscount * DiscountRate / 100
ENDIF
RETURNF 補正価格
