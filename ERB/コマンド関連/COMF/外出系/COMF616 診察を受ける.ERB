; Modular ERB: COMF/外出系/COMF616 診察を受ける.ERB

@COM616
#DIM 買うもの
;addition custom code
CALL COM616_TR
RETURN RESULT
PRINTL 「오늘 무슨 일로 마음이 불편한 거니?」
$LOOP
DRAWLINE
PRINTL [0] 내 몸이 지친다...
PRINTL [1] 정신적인 피로를 느낀다...
;SIF MAXBASE:MASTER:精力 - BASE:MASTER:精力 > 500
;	PRINTL [2] 彼女が激しくて…
PRINTL [3] 최근 여자친구가 기분파였다.
SIF TALENT:MASTER:清掃中毒
	PRINTL [4] 청소하는 게 너무 재미있고 더 이상 멈출 수가 없다.
;PRINTL [5] 先生の事を考えるとおちんちんがおっきくなっちゃうんです
;PRINTL [5] 先生の事を考えるとお股がムズムズするんです
;SIF GETBIT(TALENT:MASTER:性別 & 1)
;PRINTL [10] おちんちんの悩み
DRAWLINE
PRINTL [100] 리턴
INPUT
IF RESULT == 0
	CALL REMEDY(RAND:3)
	PRINTFORML 의사 비용은 %金額表示(3000)%였다.
	IF MONEY < 3000
		DOWNBASE:MASTER:体力 -= 100
		DOWNBASE:MASTER:気力 -= 200
		TIME += 180
		TFLAG:193 = 1
	ELSE
		MONEY -= 3000
	ENDIF
ELSEIF RESULT == 1
	;永琳の思慕恋慕で良化
	CALL REMEDY(RAND:2 + 3 + TALENT:(NO:72):3 * 2 + TALENT:(NO:72):8)
	PRINTFORML 의사의 진료비는 %金額表示(3000)%였다.
	IF MONEY < 3000
		DOWNBASE:MASTER:体力 -= 100
		DOWNBASE:MASTER:気力 -= 200
		TIME += 180
		TFLAG:193 = 1
	ELSE
		MONEY -= 3000
	ENDIF
ELSEIF RESULT == 3
	$SELL
	;購入条件設定
	FOR LOCAL, 0, 1000
	CALL ITEMDATA(LOCAL, "SHOP:診察")
	IF RESULT
		CALL ITEMDATA(LOCAL, "SALES")
		ITEMSALES:LOCAL = RESULT
	ENDIF
	NEXT
	DRAWLINE
	PRINTL 「그럼 이걸 어때?」
	PRINTFORML 구매할 아이템을 선택하세요 (돈:%金額表示(MONEY)%)
	DRAWLINE
	CALL SHOW_SHOPPING("診察", "調教")
	DRAWLINE
	PRINTL [999] - 반환
	INPUT
	IF RESULT == 999
		RETURN 0
	ELSE
		買うもの = RESULT
		CALL ITEMDATA(買うもの, "SHOP:診察")
		IF RESULT && ITEMSALES:買うもの >= 0 && ITEM:買うもの < 所持数制限
			CALL ITEMDATA(買うもの, "購入")
			SIF RESULT
				GOTO SELL
		ELSE
			GOTO SELL
		ENDIF
	ENDIF
ELSEIF RESULT == 4 && TALENT:MASTER:清掃中毒
	IF FLAG:850 == 0
		PRINTL 「집안일 하는 거 좋아해? 그거 좋잖아?」
		PRINTL 「좋지 않아?」
		PRINTW 「다른 것에 집중할 수가 없다는 거야? 그건 문제가 되겠네, 응.」
		PRINTW ...
		PRINTW 「흠, 뭐 약간 이상하긴 하네요.」
		PRINTW ......
		PRINTW 「그게 너를 흥분시킨다고!?」
		PRINTW ............
		PRINTL 「도대체 어떻게 이렇게 된 거야...」
		PRINTL 「이런 희귀한 경우니까 이번엔 무료로 치료해 주지.」
		PRINTL 「하지만 이상하게 청소하지는 마.」
		PRINTFORMW 당신의 [청소중독]이 치유되었다.
		TALENT:MASTER:清掃中毒 = 0
		FLAG:850 ++
	ELSE
		PRINTL 「또 그렇게 됐네, 응?」
		PRINTFORML 「그냥... 이번엔 ¥{FLAG:850 * 10000}가 들 거야.」
		IF MONEY < FLAG:850 * 10000
			PRINTL 「치료를 감당할 수 없을 것 같군.」
			PRINTL 「돈을 더 모아서 다시 돌아와라.」
		ELSE
			PRINTW ...
			PRINTW ......
			PRINTW ............
			PRINTL 「좋아, 끝났어.」
			PRINTL 「다시 그러면 나한테 더 돈을 내야 할 거야.」
			PRINTFORMW 당신의 [청소중독]이 치유되었다.
			TALENT:MASTER:清掃中毒 = 0
			MONEY -= FLAG:850 * 10000
			FLAG:850 ++
		ENDIF
	ENDIF
ELSEIF RESULT == 6
	IF GETBIT(CFLAG:72:既成事実,1) && EXP:72:口淫経験 > 10 && !TALENT:72:キス未経験
		IF TALENT:72:機嫌 == -1
			PRINTFORMDW %CALLNAME:72%는 한숨을 내쉬고 %조사처리(CALLNAME:MASTER,"를")% 안쪽으로 안내했다.
			PRINTFORMDW %CALLNAME:72%는 불만스러운 듯 옆머리를 쓸어 넘기며 %조사처리(CALLNAME:MASTER,"의")% 음경을 입에 넣었다.
			PRINTFORMDW %CALLNAME:72%는 정액을 입안에 받아낸 후 양치질을 하고 손을 씻고 진찰실로 돌아갔다.
			EXP:MASTER:射精経験 ++
			BASE:MASTER:精力 = MAX(BASE:MASTER:精力 - 200, 0)
			EXP:72:口淫経験 ++
			EXP:72:精液経験 ++
			IF TALENT:MASTER:濃厚精液
				PRINTFORMW %조사처리(CALLNAME:MASTER,"의")% [농후한 정액]이 나았다.
				TALENT:MASTER:濃厚精液 = 0
			ENDIF
			PRINTFORML 치료비로 %金額表示(10000)%가 청구되었다.
			MONEY -= 10000
		ELSE
			PRINTFORMDW 에이린에게 바쁘다고 가볍게 넘겨버렸다...
			TALENT:72:機嫌 --
		ENDIF
	ELSE
		PRINTFORMDW %CALLNAME:72%는 감사의 말을 전하며 %조사처리(CALLNAME:MASTER,"를")% 안쪽으로 안내했다.
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTFORMDW %조사처리(CALLNAME:MASTER,"는")% 헌혈에 협력하게 되었다...
		BASE:MASTER:体力 = MIN(MAXBASE:MASTER:体力,BASE:MASTER:体力 - 400)
		TALENT:72:機嫌 = 1
	ENDIF
	;ELSEIF RESULT == 10
	;	CALL PENIS_CHANGE
ELSEIF RESULT == 100
	RETURN -1
ELSE
	GOTO LOOP
ENDIF
SETBIT TFLAG:一日一回,3
TIME += 30
RETURN 1

@REMEDY(ARG)
SELECTCASE ARG
	CASE 0
		LOCALS = 맛있는 식사
		BASE:MASTER:体力 = MIN(MAXBASE:MASTER:体力,BASE:MASTER:体力 + 500)
	CASE 1
		LOCALS = 영양 주사
		BASE:MASTER:体力 = MIN(MAXBASE:MASTER:体力,BASE:MASTER:体力 + 750)
	CASE 2
		LOCALS = 진진 지
		BASE:MASTER:体力 = MAXBASE:MASTER:体力
	CASE 3
		LOCALS = 계절적 힘
		BASE:MASTER:気力 = MIN(MAXBASE:MASTER:気力,BASE:MASTER:気力 + 500)
	CASE 4
		LOCALS = 진정제
		BASE:MASTER:気力 = MIN(MAXBASE:MASTER:気力,BASE:MASTER:気力 + 750)
	CASE 5
		LOCALS = 이마 온도 측정
		BASE:MASTER:気力 = MIN(MAXBASE:MASTER:気力,BASE:MASTER:気力 + 900)
	CASE 6
		LOCALS = 포옹
		BASE:MASTER:気力 = MIN(MAXBASE:MASTER:気力,BASE:MASTER:気力 + 1000)
ENDSELECT
PRINTFORMW 에이린은 당신을 %LOCALS%로 치료한다.
SIF ARG == 2
	PRINTL 한 방에 해라, 만탄!
SIF ARG >= 0 && ARG <= 2
	PRINTW 스태미나가 회복되었다.
SIF ARG >= 3 && ARG <= 6
	PRINTW 에너지가 회복되었다.
