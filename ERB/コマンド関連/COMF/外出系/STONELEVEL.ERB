; Modular ERB: COMF/外出系/STONELEVEL.ERB
;**************************************************************
;キャラ追加のやり方
;①@STONELEVELの相手候補:Xのところに/で区切って名前を追加。
;	Xは出現レベル。
;
;②@StoneMessage_XX(ARGS)を増設。XXは追加するキャラの番号。
;
;@StoneMessage_XX(ARGS)
;IF ARGS == "beginning"
;	対戦前のメッセージ
;ELSEIF ARGS == "win"
;	プレイヤー勝利時
;ELSEIF ARGS == "lose"
;	プレイヤー敗北時
;ENDIF
;**************************************************************

@STONELEVEL(difficulty)
#DIM C_ID
#DIM difficulty
#DIMS ENEMY
#DIMS 相手候補, 9
;Custom code
#DIMS 相手候補_TR, 9
相手候補:0 = [[久侘歌]]/[[サニー]]/[[スター]]/[[リグル]]
相手候補:1 = [[こころ]]/[[小町]]/[[妖夢]]/[[百々世]]
相手候補:2 = [[霊夢]]/[[成美]]/[[白蓮]]/[[パルスィ]]
相手候補:3 = [[にとり]]/[[小悪魔]]/[[菫子]]/[[ユウゲンマガン]]
相手候補:4 = [[布都]]/[[青娥]]/[[エレン]]
相手候補:5 = [[袿姫]]/[[隠岐奈]]/[[神子]]/[[映姫]]
相手候補:6 = [[久侘歌]]/[[妖夢]]/[[成美]]/[[スター]]/[[こころ]]/[[小町]]/[[霊夢]]/[[白蓮]]/[[小悪魔]]/[[菫子]]/[[にとり]]/[[サニー]]/[[こころ]]/[[映姫]]/[[エレン]]/[[袿姫]]/[[隠岐奈]]/[[布都]]/[[青娥]]/[[神子]]/[[ヘカーティア]]/[[パルスィ]]/[[リグル]]/[[百々世]]/[[ユウゲンマガン]]
相手候補:7 = [[瓔花]]
相手候補:8 = [[瓔花]]
LOCALS = %TEXTR(@"%相手候補:difficulty%")%
C_ID = TOINT(LOCALS)
IF C_ID == 0 || !SHIRAHU(C_ID)
	;THROW ID %LOCALS% is invalid!
	;NAS: not alive, replace with mob
	C_ID = FREE_MOB_SLOT()
	CALL MAKE_YUKIZURI(FREE_MOB_SLOT(1), "妖精", 1)
ENDIF
CALL PRINT_FACE(C_ID, "通常", "服", "", "") ;custom code tweak, make sure they're clothed
;custom code in case images aren't available
PRINTFORML %CALLNAME:C_ID%!!!
IF difficulty == 8
	;ラスボス特殊分岐
	;addition custom code, kojo dialogues
	CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lastbattle_b")
	SIF !RESULT
		TRYCALLFORM StoneMessage_{C_ID}("lastbattle_b")
ELSE
	;addition custom code, kojo dialogues
	CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "beginning")
	SIF !RESULT
		TRYCALLFORM StoneMessage_{C_ID}("beginning")
ENDIF
CALL STONEBATTLE(difficulty, C_ID)
RETURN RESULT

