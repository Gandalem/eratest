; Modular ERB: COMF/外出系/NASIKUZUSI.ERB

@ONABARE(ARG)
#DIM C_ID
#DIM なし崩し必要値
#DIM どうぞそのまま好感度上昇値
CFLAG:ARG:最後に会った日 = DAY
IF !TALENT:ARG:処女 && ABL:ARG:Ａ感覚 >= ABL:ARG:Ｖ感覚
	LOCAL:2 = 1
ELSE
	LOCAL:2 = 0
ENDIF
;addition custom code
CALL KOJO_CHECK(ARG, "ONABARE_HOLE")
IF RESULT == 1
	LOCAL:2 = 0
ELSEIF RESULT == 2
	LOCAL:2 = 1
ENDIF
SIF IS_MALE(ARG) ;custom code
	LOCAL:2 = 1
IF CFLAG:MASTER:311 == CFLAG:ARG:311
	LOCALS '= @"살짝 들여다봐"
ELSE
	LOCALS '= @"노크 없이 들어간다"
ENDIF
PRINTFORMW 방 안에서 먹먹한 목소리가 들린다...
CALL ASK_YN("조용히 떠나라",@"%LOCALS%")
IF !RESULT
	RETURN
ENDIF
;custom code - move portrait here to show it for both default/custom event text (like with suwako)
CALL PrintOnanismImage(ARG)
;口上チェック,存在しないならRESULT = 2
CALL KOJO_MESSAGE_SEND("ONABARE", 1, ARG, LOCAL:2)
IF RESULT == 2
	;CALL PrintOnanismImage(ARG) ;custom code, moved above
	PRINTFORMW 당신은 눈치채지 못한 채 방에 들어서고, 가운데에서 자위하는 %CALLNAME:ARG%을 보았다.
	PRINTFORM %CALLNAME:ARG%의 옷은 %HIS_HER(ARG)% 상반신만 가리고 있으며, %HE_SHE(ARG)%인 것처럼 %HIS_HER(ARG)%의 손가락으로 가지고 놀고 있었다.
	IF TALENT:ARG:恋慕
		PRINTFORM  당신의 이름을 부른다
		;気弱系,真面目系
	ELSEIF CFLAG:ARG:性格傾向 == 1 || CFLAG:ARG:性格傾向 == 4
		PRINTFORM  신음 소리를 막는다
		;強気系
	ELSEIF CFLAG:ARG:性格傾向 == 2 || CFLAG:ARG:性格傾向 == 3 || CFLAG:ARG:性格傾向 == 5
		PRINTFORM  신음을 내뱉는다.
	ENDIF
	PRINTFORMW .
	PRINTFORM %HE_SHE(ARG,1)% 쓰다듬는다 %HIS_HER(ARG)% 
	IF TALENT:ARG:2 == 2
		PRINTFORM 공들
	ELSE
		;デカパイ
		IF TALENT:ARG:バストサイズ > 0
			PRINTFORM 풍만한 가슴
			;ちっぱい
		ELSEIF TALENT:ARG:バストサイズ < 0
			PRINTFORM 떨리는 가냘픈 가슴
			;普通
		ELSE
			PRINTFORM 흔들리는 가슴
		ENDIF
	ENDIF
	PRINTFORMW  %HE_SHE(ARG)%은(는) %HIS_HER(ARG)%의 다리를 넓게 벌려 %HIS_HER(ARG)%의 네더 리전에 더 나은 접근을 허용한다.
	PRINTFORMW %CALLNAME:ARG%는(는) %HIS_HER(ARG)%의 침으로 축축해진 손가락을 %HIS_HER(ARG)%의 \@ !LOCAL:2 ? 질 # 항문에 삽입한다. \@
	PRINTFORMW 바로 그때, '쾅' 소리와 함께 당신은 이마를 문에 부딪혔다...
	PRINTFORML 당신을 눈치챈 %CALLNAME:ARG%는(는) 몸을 숨기는 것조차 잊고 그대로 당신을 응시했다...
ENDIF
CALL KOJO_MESSAGE_SEND("EVENT",26,ARG,0,0)
PRINTFORMW 
$LOOP
PRINTFORML 
CALL ASK_M("사과하다",1,"그냥 계속 찾아볼 테니 계속해라",!CFLAG:ARG:Hypno_Orgasm_Denial || BASE:MASTER:TSP >= 500,"두 사람과 함께 있으면 더 기분이 좋다",(BASE:MASTER:精力 > MAXBASE:MASTER:精力 / 5) && !CFLAG:ARG:Hypno_Orgasm_Denial || BASE:MASTER:TSP >= 500) ;custom code
IF RESULT == 0
	IF CFLAG:MASTER:311 == CFLAG:ARG:311
		PRINTFORML 당신은 서둘러 잠자리에 들었다.
	ELSE
		PRINTFORML 당신은 %CALLNAME:ARG%이 정신을 차리기 전에 그 장면을 눈에 담고 사과한 뒤 떠난다.
	ENDIF
	SIF !CFLAG:ARG:弱み握られ
		PRINTFORML %CALLNAME:ARG%의 【약점】을 알아냈다! 이것으로 %HIM_HER(ARG)%를 협박할 수 있다!
	CALL KOJO_MESSAGE_SEND("EVENT",26,ARG,1,0)
	CFLAG:ARG:オナバレ = 1
	CFLAG:ARG:弱み握られ = 1
	CALL ASK_DIARY(@"%CALLNAME:ARG%이 자위하는 것을 우연히 발견했다. 흥미롭군.")
	TIME += 5
ELSEIF RESULT == 1
	RESULT = 0
	CALL KOJO_MESSAGE_SEND("ONABARE", 4, ARG, 0, 0, "どうぞそのまま")
	SIF RESULT == -1
		GOTO GOOUT
	SIF RESULT == 1
		GOTO SONOMAMA
	なし崩し必要値 = 抱き寄せ必要値(ARG) - 50 + TALENT:ARG:羞恥心 * 50 - ABL:ARG:露出癖 * 30 - CFLAG:ARG:溜まってる度 / 20
	SIF TALENT:ARG:プライド > 0
		なし崩し必要値 += 100
	SIF CFLAG:ARG:既成事実 & 合意_うふふ
		なし崩し必要値 -= 50
	SIF TALENT:ARG:度胸 < 0
		なし崩し必要値 -= 200
	CALL SHOW_LOVEPOWER(CFLAG:ARG:合意判定,50)
	CALL SHOW_REASONWALL(なし崩し必要値 ,50)
	;失敗
	IF CFLAG:ARG:合意判定 <= なし崩し必要値
		GOTO GOOUT
		;成功
	ELSE
		$SONOMAMA
		CALL KOJO_MESSAGE_SEND("EVENT",26,ARG,2,0)
		;口上チェック,存在しないならRESULT = 2
		CALL KOJO_MESSAGE_SEND("ONABARE", 2, ARG, LOCAL:2)
		IF RESULT == 2
			IF CFLAG:ARG:Hypno_Orgasm_Denial ;custom code
				PRINTFORMDW 당신은 %CALLNAME:ARG%에게 가해진 최면을 풀었다.
				CFLAG:ARG:Hypno_Orgasm_Denial = -1
			ENDIF
			PRINTFORM 잠시 동안 %CALLNAME:ARG%이 본다 
			IF TALENT:ARG:恋慕
				PRINTFORM 기쁘면서 약간 혼란스러웠다.
				;気弱系,真面目系
			ELSEIF CFLAG:ARG:性格傾向 == 1 || CFLAG:ARG:性格傾向 == 4
				PRINTFORM 주저하고 당황한
				;強気系,素直系,その他
			ELSEIF CFLAG:ARG:性格傾向 == 2 || CFLAG:ARG:性格傾向 == 3 || CFLAG:ARG:性格傾向 == 5
				PRINTFORM 역겹고 충격받았다
			ENDIF
			PRINTFORML 작은 한숨을 내뱉기 전에.
			IF TALENT:ARG:恋人
				PRINTFORML 남은 옷을 벗어 던지고 당신 앞에서 다리를 벌린다.
				;気弱系,真面目系
			ELSEIF CFLAG:ARG:性格傾向 == 1 || CFLAG:ARG:性格傾向 == 4
				PRINTFORML %HE_SHE(ARG,1)%은(는) %HE_SHE(ARG)%가 %HIS_HER(ARG)%의 옷을 조금 더 열자 당황해서 타오르지만, %HIS_HER(ARG)%의 다리를 꼭 붙인다.
				;強気系,素直系,その他
			ELSEIF CFLAG:ARG:性格傾向 == 2 || CFLAG:ARG:性格傾向 == 3 || CFLAG:ARG:性格傾向 == 5
				PRINTFORML %HE_SHE(ARG,1)%은(는) %HIS_HER(ARG)%의 옷을 벗기지만, 여전히 %HIS_HER(ARG)%의 중요한 부위를 숨긴다.
			ENDIF
			PRINTFORML 그 후 당신은 격려한다 %CALLNAME:ARG%계속하도록 격려한다.
			PRINTFORMW %HE_SHE(ARG,1)%는 한숨을 내쉬더니 %HIS_HER(ARG)%의 손을 움직이기 시작한다.
			PRINTFORML 젖은 소리가 난다 %HE_SHE(ARG)% 파고든다 %HIS_HER(ARG)% 가운데 손가락을 넣다 %HIS_HER(ARG)% \@ !LOCAL:2 ? 질 # 항문 \@.
			;デカパイ
			IF TALENT:バストサイズ > 0
				PRINTFORML 다른 한편은 손으로 가슴을 더듬었고, 살이 그 손가락 주위로 변형되었다.
				;ちっぱい
			ELSEIF TALENT:バストサイズ < 0
				PRINTFORML %HE_SHE(ARG,1)%은(는) %HIS_HER(ARG)%의 다른 손으로 %HIS_HER(ARG)% 유두를 짜고 문지른다.
				;普通
			ELSE
				PRINTFORML %HE_SHE(ARG,1)%은/는 %HIS_HER(ARG)%의 가슴을 %HIS_HER(ARG)%의 다른 손으로 만진다.
			ENDIF
			PRINTFORMW 음란한 장면은 %HE_SHE(ARG)%가 진심으로 신음하기 시작하면서 더욱 음란해진다.
			IF TALENT:ARG:恋人
				PRINTFORML %HE_SHE(ARG)%이 당신의 이름을 부르자 %HE_SHE(ARG,1)%은/는 더 강한 힘으로 %HIS_HER(ARG)%의 손가락을 움직이기 시작한다.
				PRINTFORML 액체가 새어 나온다 %CALLNAME:ARG%의 입에서부터 %HE_SHE(ARG)% 황홀한 표정으로 당신을 응시한다.
				PRINTFORMW 너는 침을 삼킨다.
				PRINTFORML %HE_SHE(ARG,1)%는 %HIS_HER(ARG)%의 가슴을 계속 애무하면서 %HIS_HER(ARG)% \@ !LOCAL:2 ? 질 # 항문 \@에게 더 빠르게 손가락질하기 시작한다.
				PRINTFORMW 그리고 나서 %CALLNAME:ARG%이 당신의 이름을 부르고 %HIS_HER(ARG)%의 온몸이 오르가슴으로 떨린다.
				;気弱系,真面目系
			ELSEIF CFLAG:ARG:性格傾向 == 1 || CFLAG:ARG:性格傾向 == 4
				PRINTFORML 부끄러워하면서도 %HE_SHE(ARG)%은/는 %HIS_HER(ARG)%의 가슴을 만지고 \@ !LOCAL:2 ? 질 # 항문을 만진다 \@.
				PRINTFORML 하지만 %HIS_HER(ARG)%의 유두가 더 발갛게 달아오르고 단단해지자, %HE_SHE(ARG)%이 즐기고 있다는 것이 분명했다.
				PRINTFORMW 그녀의 목소리가 커지고, %HE_SHE(ARG)%은/는 %HIS_HER(ARG)%의 다리를 조금 더 벌렸다.
				PRINTFORML 당신이 보고 있다는 것을 모르는 듯, %HE_SHE(ARG)%은/는 아무것도 숨기지 않고 %HIMSELF_HERSELF(ARG)%을 부끄러움 없이 넓게 벌렸다.
				PRINTFORML 그녀의 걸쭉한 연모액이 흘러내려 %HIS_HER(ARG)%의 허벅지를 타고 흐르며 떨리기 시작했다.
				PRINTFORMW %CALLNAME:ARG%이/가 마침내 오르기 직전, 액체가 폭포수처럼 분출되었다.
				;強気系,素直系,その他
			ELSEIF CFLAG:ARG:性格傾向 == 2 || CFLAG:ARG:性格傾向 == 3 || CFLAG:ARG:性格傾向 == 5
				PRINTFORML %CALLNAME:ARG%이 다가가지 못하게 막으며, 당신에게 지켜보는 것만 허락되었다고 상기시킨다.
				PRINTFORML %HIS_HER(ARG)%의 가슴을 움켜쥐며, %HE_SHE(ARG)%는 %HIS_HER(ARG)%를 \@ !LOCAL:2 ? 질 # 항문 \@과 가지고 놀며, 매번 축축한 소리를 낸다.
				PRINTFORMW %HE_SHE(ARG,1)%은 %HIS_HER(ARG)%의 관음적인 시선이 만족스럽지 않음을 알아차리고, 그래서 %HE_SHE(ARG)%는 %HIS_HER(ARG)%의 다리를 더 넓게 벌린다.
				PRINTFORML Love juice가 %HIS_HER(ARG)%의 허벅지를 타고 흘러내리며, %HE_SHE(ARG)%가 %HIS_HER(ARG)%의 음핵을 가지고 놀기 시작한다.
				PRINTFORML 당신의 시선이 자신에게 향하는 것을 느끼고, %CALLNAME:ARG%은 %HIS_HER(ARG)%의 손가락을 더욱 빠르게 움직이기 시작한다.
				PRINTFORMW %HE_SHE(ARG,1)%는 갑자기 %HIS_HER(ARG)%의 손가락을 %HIS_HER(ARG)%의 \@ !LOCAL:2 ? 질 # 항문 \@ 안에 밀어 넣으며, %HIM_HER(ARG)%를 절벽 끝으로 몰아붙인다.
			ENDIF
		ENDIF
	ENDIF
	PRINTFORML %CALLNAME:ARG%의 전신이 쾌감으로 움찔거리며 경련한다.
	IF CFLAG:MASTER:311 == CFLAG:ARG:311
		PRINTFORML 당신은 지친 %CALLNAME:ARG%를 위해 침대를 준비한다.
	ELSE
		PRINTFORML 더 이상 밀어붙이지 않기로 결정하고 망설임 없이 집으로 돌아간다.
		IF !CFLAG:ARG:ノーパン && EQUIP:ARG:下半身下着２ && CFLAG:MASTER:デート中 != MAIN_MAP
			PRINTFORML 떠나기 전에, 기념품이 필요하지 않을까?
			CALL ASK_YN
			IF !RESULT
				PRINTFORML 집에 돌아가기 전에 당신은 %CALLNAME:ARG%의 %PANTSNAME(EQUIP:ARG:下半身下着２, ARG)%를 가져와 %IT_THEM_PANTIES(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))%를 주머니에 넣는다.
				CALL PANTS_GET(ARG)
			ENDIF
		ENDIF
	ENDIF
	CFLAG:ARG:オナバレ = 3
	どうぞそのまま好感度上昇値 = ABL:ARG:親密 * CFLAG:ARG:溜まってる度 / 250 * MIN(ABL:ARG:露出癖,10)
	CALL CHANGE_CFLAG(2,ARG,どうぞそのまま好感度上昇値)
	CALL CHANGE_CFLAG(4,ARG,どうぞそのまま好感度上昇値 * -1 / 20)
	CALL JUEL_UP_SPECIAL(ARG,"恥情","自慰中毒",30,1)
	CALL JUEL_UP_SPECIAL(ARG,"欲情","自慰中毒",30,1)
	CALL ADD_EXP_LESNIAN(CFLAG:ARG:溜まってる度 / 100, ARG, "PRINT")
	EXP:ARG:露出快楽経験 += CFLAG:ARG:溜まってる度 / 200 * ABL:ARG:露出癖
	EXP:ARG:自慰経験 +=  CFLAG:ARG:溜まってる度 / 200 * ABL:ARG:露出癖
	CALL ASK_DIARY(@"%CALLNAME:ARG%이 자위하는 것을 우연히 발견하고 끝까지 계속하라고 부탁했다. <br>그녀는 스스로에게 매우 만족한 듯 보였다.")
	CFLAG:ARG:Hypno_Orgasm_Denial = 0
	TIME += 27
ELSEIF RESULT == 2
	RESULT = 0
	CALL KOJO_MESSAGE_SEND("ONABARE", 4, ARG, 0, 0, "二人で")
	SIF RESULT == -1
		GOTO GOOUT
	SIF RESULT == 1
		GOTO NASI
	なし崩し必要値 = 抱き寄せ必要値(ARG) - 150 + TALENT:ARG:羞恥心 * 30 - CFLAG:ARG:溜まってる度 / 20
	SIF TALENT:ARG:プライド > 0
		なし崩し必要値 += 50
	SIF CFLAG:ARG:既成事実 & 合意_うふふ
		なし崩し必要値 -= 50
	SIF TALENT:ARG:度胸 < 0
		なし崩し必要値 -= 200
	CALL SHOW_LOVEPOWER(CFLAG:ARG:合意判定,50)
	CALL SHOW_REASONWALL(なし崩し必要値 ,50)
	$ GOOUT
	IF CFLAG:ARG:合意判定 <= なし崩し必要値
		PRINTFORML %CALLNAME:ARG%는 당신의 제안에 격분하며 당신을 내쫓는다.
		CALL KOJO_MESSAGE_SEND("EVENT",26,ARG,3,0)
		SIF !CFLAG:ARG:弱み握られ
			PRINTFORML %CALLNAME:ARG%의 【약점】을 알아냈다! 이것으로 %HIM_HER(ARG)%를 협박할 수 있다!
		CALL GET_ANGRY(ARG,1)
		;bugfix custom code, cannot use normal processing
		CALL HMF_HeartfeltApology(ARG) ;addition custom code
		LOCAL = TARGET
		TARGET = ARG
		CALL KOJO_MESSAGE_SEND("MARK",-1,ARG,-1,-1)
		TFLAG:反発刻印取得 = 0
		TARGET = LOCAL
		CFLAG:ARG:オナバレ = 1
		CFLAG:ARG:弱み握られ = 1
		CALL ASK_DIARY(@"%CALLNAME:ARG%가 자위하는 것을 우연히 보았다. 그녀는 정말 화를 냈다!")
		TIME += 5
	ELSE
		$NASI
		CALL NASIKUZUSI(ARG,LOCAL:2)
		CFLAG:ARG:ヤラせちゃった = 1
		CFLAG:ARG:Hypno_Orgasm_Denial = 0
	ENDIF
ENDIF

@NASIKUZUSI(ARG, 本番はどっちか)
#DIM 前戯１
;1=C 2=B 3=M
#DIM 前戯２
#DIM 本番はどっちか
#DIM 注入量
#DIM 基本注入量
#DIM 好感度上昇量
#DIM 信頼低下量
#DIM 回数
#DIM 経験増加数,58
#DIMS 日記記述
;０ならＶ、１ならＡ
VARSET 経験増加数
CALL KOJO_MESSAGE_SEND("EVENT",26,ARG,4,0)
回数 = MAX(MIN(ABL:ARG:欲望 / 2, 5) + CFLAG:ARG:溜まってる度 / 200,1)
注入量 = 0
IF TALENT:ARG:キス未経験
	前戯１ = 3
	経験増加数:4 += 3 + ABL:ARG:Ｍ感覚 * 2
	経験増加数:25 = 経験増加数:4
	経験増加数:27 = 経験増加数:4
	EXP:MASTER:Ｍ経験 += 経験増加数:4
	EXP:MASTER:キス経験 += 経験増加数:4
	EXP:MASTER:口淫経験 += 経験増加数:4
ELSEIF !RAND:3
	前戯１ = 3
	経験増加数:4 += 3 + ABL:ARG:Ｍ感覚 * 2
	経験増加数:27 = 経験増加数:4
ELSEIF ABL:ARG:Ｃ感覚 >= ABL:ARG:Ｂ感覚
	前戯１ = 1
	経験増加数:0 += RAND:(回数 * 2)
	経験増加数:5 += 経験増加数:0 / 2
	経験増加数:10 += 経験増加数:0 / 2
ELSE
	前戯１ = 2
	経験増加数:3 += RAND:(回数 * 2)
	経験増加数:8 += 経験増加数:3 / 2
	経験増加数:10 += 経験増加数:3 / 2
ENDIF
前戯２ = RAND:3
SIF 本番はどっちか == 1
	前戯２ += 10
IF 本番はどっちか
	基本注入量 = (ABL:ARG:アナル + 1) * 20 + BASE:MASTER:精力 /25
	経験増加数:21 += 回数
	経験増加数:17 += 回数
	経験増加数:10 += 回数
	経験増加数:7 += 2 * 回数
	経験増加数:2 += 回数 * 2
ELSE
	基本注入量 = (ABL:ARG:膣 + 1) * 20 + BASE:MASTER:精力 / 25
	SIF TALENT:ARG:処女 == 1
		基本注入量 += 100
	経験増加数:20 += 回数
	経験増加数:16 += 回数
	経験増加数:10 += 2 * 回数
	経験増加数:6 += 2 * 回数
	経験増加数:1 += 2 * 回数
ENDIF
EXP:MASTER:挿入経験 += 回数
EXP:MASTER:射精経験 += 回数
EXP:MASTER:絶頂経験 += 回数
FOR LOCAL,1,回数
注入量 += 基本注入量 + RAND:(基本注入量)
NEXT
注入量 = MIN(注入量, BASE:MASTER:精力)
;addition custom code, for correct display if pc has unmatched
LOCAL:9 = 注入量
SIF TALENT:MASTER:絶倫
	LOCAL:9 *= 2
SIF !HAS_PENIS(MASTER)
	注入量 = 0
IF !本番はどっちか
	CALL ADD_SAMEN_V(ARG, 注入量)
ELSE
	CALL ADD_SAMEN_A(ARG, 注入量)
ENDIF
;RESULTS:1一時退避
