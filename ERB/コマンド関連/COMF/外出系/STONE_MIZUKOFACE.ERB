; Modular ERB: COMF/外出系/STONE_MIZUKOFACE.ERB
;顔絵選択・生成

@MIZUKO_SETUP
#DIM GID
#DIM L_FEED
#DIM 合成数
#DIMS 生成文字列
#DIMS 合成文字列配列, 50
#DIMS 色合成
;作成済or顔絵無しなら帰る
IF SPRITECREATED("水子_服_通常") || 受付水子画像文字列:0 == "顔絵なし"
	RETURN
	;初回選択
ELSEIF 受付水子画像文字列:0 == ""
	PRINTFORML %STONE_UKETSUKENAME%의 얼굴 이미지를 설정한다.
	CALL ASK_YN()
	IF RESULT
		受付水子画像文字列:0 = 顔絵なし
		RETURN
	ENDIF
	REDRAW 0
	CLEARLINE 1
	PRINTFORML 원하는 표정을 확인하려면 마우스를 올린다.
	SIF FLAG:マルチサイズ
		デフォルトキャラ画像横幅 = 180
	L_FEED = LINECOUNT
	WHILE 1
	CALL モブ店員画像作成(27, "水子")
	CALL IMAGE_SET("顔絵_服_通常_MOB_27", 0, 0, キャラ画像表示サイズ比, 0, 1, "100", STONE_UKETSUKENAME, "顔絵_服_笑顔_MOB_27")
	CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
	PRINTFORML [0] 선택 [1] 취소
	INPUT
	SIF !RESULT
		BREAK
	CLEARLINE LINECOUNT - L_FEED
	SPRITEDISPOSE "顔絵_服_通常_MOB_27"
	SPRITEDISPOSE "顔絵_服_笑顔_MOB_27"
	SPRITEDISPOSE "顔絵_服_怒り_MOB_27"
	SPRITEDISPOSE "顔絵_裸_通常_MOB_27"
	SPRITEDISPOSE "顔絵_裸_笑顔_MOB_27"
	SPRITEDISPOSE "顔絵_裸_怒り_MOB_27"
	FOR COUNT, 0, 6
	GDISPOSE モブ子店員GID:27:COUNT
	モブ子店員GID:27:COUNT = 0
	モブ子店員画像文字列:27:COUNT =
	NEXT
	WEND
	REDRAW 1
	PRINTFORMW 얼굴 사진이 설정되었다.
	;顔絵生成文字列を日替わり枠からセーブデータ保存枠に移行
	FOR COUNT, 0, 6
	受付水子画像文字列:COUNT '= モブ子店員画像文字列:27:COUNT
	NEXT
ENDIF
;MIZUKO_FACEから呼び出せるスプライトを改めて作成
;@MOB_IMAGE_GENから流用
FOR COUNT, 0, 6
GID = 0
VARSET LOCAL
VARSET 合成文字列配列,
合成数 = 0
CALL COMPOSE_IMAGE(GID, "ダミー")
CALL モブ子リソース探索(合成文字列配列, 合成数, 受付水子画像文字列:COUNT, 1)
ARRAYSORT 合成文字列配列, BACK, 0, 合成数
FOR LOCAL, 0, 合成数
色合成 '= ""
IF 合成文字列配列:LOCAL != ""
	FOR LOCAL:1, 0 , モブ子素材色種別数
	IF STRFIND(合成文字列配列:LOCAL, @"_%モブ子素材色種別:(LOCAL:1)%_") != -1 && DIC_CONTAINSKEY(受付水子画像文字列:COUNT, @"%モブ子素材色種別:(LOCAL:1)%色")
		色合成 = %DIC_GET(受付水子画像文字列:COUNT, @"%モブ子素材色種別:(LOCAL:1)%색")%
		LOCAL:1 = モブ子素材色種別数
	ENDIF
	NEXT
	CALL COMPOSE_IMAGE(GID, 合成文字列配列:LOCAL, 0, 0, 0, 0, 色合成)
ENDIF
NEXT
SELECTCASE COUNT
	CASE 0
		CALL RESOURCE_REGISTER("水子_服_通常", GID)
	CASE 1
		CALL RESOURCE_REGISTER("水子_服_笑顔", GID)
	CASE 2
		CALL RESOURCE_REGISTER("水子_服_怒り", GID)
	CASE 3
		CALL RESOURCE_REGISTER("水子_裸_通常", GID)
	CASE 4
		CALL RESOURCE_REGISTER("水子_裸_笑顔", GID)
	CASE 5
		CALL RESOURCE_REGISTER("水子_裸_怒り", GID)
ENDSELECT
NEXT
RETURN
;水子顔絵表示関数

@MIZUKO_FACE(表情, 着衣, マウスオーバー = "")
#DIMS 表情
#DIMS 着衣
#DIMS 表示用文字列
#DIMS マウスオーバー
#DIMS マウスオーバー文字列
SIF !FLAG:画像表示 || 受付水子画像文字列:0 == "顔絵なし"
	RETURN
マウスオーバー文字列 =
SIF !GROUPMATCH(表情, "笑顔", "怒り")
	表情 = 通常
SIF 着衣 != "裸"
	着衣 = 服
表示用文字列 = 水子_%着衣%_%表情%
SIF GROUPMATCH(マウスオーバー, "通常", "笑顔", "怒り")
	マウスオーバー文字列 = 水子_%着衣%_%マウスオーバー%
SIF FLAG:マルチサイズ
	デフォルトキャラ画像横幅 = 180
CALL IMAGE_SET(表示用文字列, 0, 0, キャラ画像表示サイズ比, 0, 1, "999", STONE_UKETSUKENAME, マウスオーバー文字列)
CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
RETURN
;周回時設定

@MIZUKO_BITE_A_DUST
PRINTFORML %STONE_UKETSUKENAME%은(는) 당신이 사랑을 나누고 심지어 아이까지 가졌던 사람에 대해서는 어때? %COND_STR(@" with whom you made love and even had a child together", STONE_PLAYCOUNT:2 == 17)%로.
CALL ASK_YN("그녀는 잊어버려라", "그녀를 기억해")
IF !RESULT
	VARSET 受付水子画像文字列
	RETURN 0
ENDIF
RETURN 1
