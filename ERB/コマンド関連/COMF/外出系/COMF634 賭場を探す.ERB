; Modular ERB: COMF/外出系/COMF634 賭場を探す.ERB
;賭場を探す

@COM634
DRAWLINE
PRINTFORML 짧은 산책 끝에 용이 파이프를 피우며 매달린 버려진 집에 도착한다.
PRINTFORMW 희미한 환호 소리에 이끌려 건물 안으로 발을 들인다.
CALL TOBA_SETUP
CALL 賭場_導入
SIF NEMUKE() >= 700 ;custom code
	PRINTFORML 졸음 때문에 쓰러질 것 같은 기분이 든다.
PRINTFORMW 당신은 도박판에서 벗어난다.
TIME += 10

@COM_ABLE634
;一括管理
SIF GLOBAL_COMABLE(634)
	RETURN RESULT
SIF !TOBA_PLACE(CFLAG:MASTER:現在位置)
	RETURN 0
SIF TFLAG:妄想中
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
;時間に余裕が無い
;活動限界を700としてその20分前
SIF NEMUKE() >= 700
	RETURN 0
RETURN 1

@TOBA_PLACE(ARG)
#FUNCTION
;秘天崖
SIF ARG == GET_MAP_REPLACEMENT(739)
	RETURNF 1
RETURNF 0
