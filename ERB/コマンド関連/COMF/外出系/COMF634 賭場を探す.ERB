;賭場を探す
@COM634
DRAWLINE
PRINTFORML A short walk brings you to an abandoned house with a dragon smoking pipe hanging from it.
PRINTFORMW Attracted by the faint murmur of cheers, you step into the building.
CALL TOBA_SETUP
CALL 賭場_導入
SIF NEMUKE() >= 700 ;custom code
	PRINTFORML You feel like you're about to pass out from drowsiness.
PRINTFORMW You step away from the gambling den.
TIME += 10

@COM_ABLE634
;一括管理
SIF GLOBAL_COMABLE(634)
	RETURN RESULT
SIF !TOBA_PLACE(CFLAG:MASTER:現在位置)
	RETURN 0
SIF TFLAG:妄想中
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
;時間に余裕が無い
;活動限界を700としてその20分前
SIF NEMUKE() >= 700
	RETURN 0
RETURN 1

@TOBA_PLACE(ARG)
#FUNCTION
;秘天崖
SIF ARG == GET_MAP_REPLACEMENT(739)
	RETURNF 1
RETURNF 0
