;お掃除サービス

@COM630
PRINTFORML 호브고블들에게 어떤 서비스를 요청해야 하는가?
CALL ASK_M("묻지 마라", 1, "청소 서비스", !TFLAG:出張お掃除, "물 주기 서비스", ITEM:150)
SIF !RESULT
	RETURN -1
IF RESULT == 1
	PRINTFORML 호그박스들에게 %GET_MAPNAME(MAIN_MAP)%을 청소하라고 요청한다.
	CALL PAY_YEN_OR_CM(3000,10)
	SIF !RESULT
		RETURN -1
	PRINTFORML 당신은 청소 서비스를 요청한다.
	TFLAG:出張お掃除 = 1
ELSEIF RESULT == 2
	PRINTFORML 부엌 정원을 물 주라고 호그밥린들에게 부탁할까? (이번 달에)
	CALL PAY_YEN_OR_CM(15000,70)
	SIF !RESULT
		RETURN -1
	PRINTFORML 당신은 물주기 서비스를 요청한다.
	FLAG:水やり代行 = 1
ENDIF
TIME += 5
RETURN 1

@COM_ABLE630
SIF LS_RESTRICTION("Hire hobgoblins") ;Custom code, restrict hiring hobgoblins during Lunatic Survival.
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(630)
	RETURN RESULT
SIF MAIN_MAP == 3
	RETURN 0
SIF !HOBGOBLIN(CFLAG:MASTER:現在位置)
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1

@HOBGOBLIN(ARG)
#FUNCTION
IF !IN_HOME(ARG)
	SIF ARG == 広間
		RETURNF 1
ENDIF
