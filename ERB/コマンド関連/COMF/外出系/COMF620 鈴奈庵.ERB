; Modular ERB: COMF/外出系/COMF620 鈴奈庵.ERB
;貸本屋

@COM620
#DIM CHARISMA
#DIM ItemId
;addition custom code
CALL COM620_TR
RETURN RESULT
$C_LOOP
DRAWLINE
IF !CHARISMA
	PRINTFORML 돈: %金額表示(MONEY)%
	PRINTFORML 「차용 비용 %金額表示(3000)%」
ELSE
	PRINTFORML 카리스마: {MONEY:2}
	PRINTL 「월세는 카리스마 10이다」
ENDIF
DRAWLINE
FOR LOCAL,1, BookTitles + 1
ItemId = LOCAL + 100
PRINTFORM [{LOCAL}] %ITEMNAME_TR(ItemId)%
IF ITEM:ItemId
	PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 이미 그것을 빌리고 있다. {FLAG:貸本返却期限-1}일 후에 반납한다.
ELSEIF GETBIT (FLAG:1011,LOCAL)
	PRINTL (임대됨)
ELSE
	PRINTL 　
ENDIF
NEXT
IF !CHARISMA
	PRINTFORML [100] 카리스마로 지불한다
ELSE
	PRINTFORML [100] 돈으로 지불한다
ENDIF
DRAWLINE
PRINTL [0] 취소
$LOOP
INPUT
IF RESULT == 100
	IF !CHARISMA
		LOCALS = 「Pay with Charisma????」/「Uhh... Then, 10 Charisma...? Should be good enough I think...」
		CALL BOOK_RENTAL_SALESTALK(LOCALS)
		IF MONEY:2 < 10
			PRINTFORMW 당신은 카리스마가 충분하지 않다.
			GOTO C_LOOP
		ENDIF
	ELSE
		LOCALS = 「Ah, You'll pay with money then?」
		CALL BOOK_RENTAL_SALESTALK(LOCALS)
	ENDIF
	PRINTFORML 
	CHARISMA = !CHARISMA
	GOTO C_LOOP
ELSE
	IF !CHARISMA && MONEY < 3000
		PRINTW 돈이 충분하지 않다...
		RETURN -1
	ENDIF
	IF INRANGE(RESULT, 1, BookTitles)
		RESULT:1 = RESULT
		IF GETBIT (FLAG:1011,RESULT:1)
			ItemId = RESULT:1 + 100
			IF ITEM:ItemId
				IF FLAG:貸本返却期限 == 8
					LOCALS = 「But you just borrowed it today……？」
					CALL BOOK_RENTAL_SALESTALK(LOCALS)
					RETURN -1
				ENDIF
				LOCALS = 「You are borrowing it, but……」/「Would you like to pay for a 7-day extension?」
				CALL BOOK_RENTAL_SALESTALK(LOCALS)
				CALL ASK_YN
				IF !RESULT
					IF !CHARISMA
						MONEY -= 3000
					ELSE
						MONEY:2 -= 10
					ENDIF
					FLAG:貸本返却期限 = 8
					PRINTFORML %ITEMNAME_TR(100 + RESULT)%의 대출 기간이 일주일 연장되었다.
					LOCALS = 「Thank you very much!」/「You must like that book a lot.」
					CALL BOOK_RENTAL_SALESTALK(LOCALS)
				ELSE
					RETURN -1
				ENDIF
			ELSE
				LOCALS = 「It's rented out.」
				CALL BOOK_RENTAL_SALESTALK(LOCALS)
			ENDIF
			RETURN -1
		ELSE
			FOR LOCAL,1, BookTitles + 1
			ItemId = LOCAL + 100
			IF ITEM:ItemId
				LOCALS = 「You are already borrowing a book.」/「If you want another book, would you like to return the earlier one first?」
				CALL BOOK_RENTAL_SALESTALK(LOCALS)
				CALL ASK_YN
				IF !RESULT
					ITEM:ItemId = 0
					CLEARBIT FLAG:1011,LOCAL
				ELSE
					RETURN -1
				ENDIF
			ENDIF
			NEXT
			SETBIT FLAG:1011,RESULT:1
			IF !CHARISMA
				MONEY -= 3000
			ELSE
				MONEY:2 -= 10
			ENDIF
			ITEM:(100 + RESULT) = 1
			FLAG:貸本返却期限 = 8
			TFLAG:193 = 1
			PRINTFORML 빌렸다 %ITEMNAME_TR(100 + RESULT)%
			LOCALS = 「Thank you very much.」/「The loan period is a week.」
			CALL BOOK_RENTAL_SALESTALK(LOCALS)
			RETURN 1
		ENDIF
	ELSEIF RESULT == 0
		RETURN -1
	ELSE
		GOTO LOOP
	ENDIF
ENDIF
TIME += 30
;貸本屋

@COM_ABLE620
;一括管理
SIF GLOBAL_COMABLE(620)
	RETURN RESULT
;貸本屋ではない場所
SIF !BOOK_RENTAL(CFLAG:MASTER:現在位置)
	RETURN 0
;睡眠中
SIF CFLAG:MASTER:睡眠 || CFLAG:MASTER:イタズラ || CFLAG:うふふ ;com custom code
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1
;貸本屋を判定する関数

@BOOK_RENTAL(ARG)
#FUNCTION
;鈴奈庵
SIF ARG == GET_MAP_REPLACEMENT(213)
	RETURNF 1
SIF ARG == GET_MAP_REPLACEMENT(1119)
	RETURNF 1
SIF GETBIT(HOME_CUSTOM_ROOM(ARG),1)
	RETURNF 1
RETURNF 0

@BOOKLEND
FOR LOCAL,1,BookTitles + 1
SIF LOCAL == 6	;[紙芝居]をスルー
	CONTINUE
;addition custom code
IF LOCAL == (GETNUM(ITEM,  "妖魔本")-100) ;always unset demon book
	CLEARBIT FLAG:1011,LOCAL
	CONTINUE
ENDIF
;-------------------------------------------------------------
SIF !ITEM:(100 + LOCAL) && !RAND:3
	INVERTBIT FLAG:1011,LOCAL
NEXT
SIF FLAG:貸本返却期限
	FLAG:貸本返却期限 -= 1
IF FLAG:貸本返却期限 == 1
	;there was a fix here, need testing
	IF Omogatari_Raids()
		PRINTFORML 책을 제때 반납하지 않은 것 때문에, %CALLNAME:[[小鈴]]%가 당신에게 암살 명령을 내렸다...
		PRINTFORMDL PMC 그룹이 도착하여 당신에게 책들을 넘기라고 요구했다.
		CALL ASK_YN("책들을 반납해라", "저항하라")
		SELECTCASE RESULT
			CASE 0
				GOTO BookSurrender
			CASE 1
				CFLAG:MASTER:313 = 0
				CALL FACTION_ASSAIANS(MASTER, 1)
		ENDSELECT
	ELSE
		$BookSurrender
		;fix
		FLAG:貸本返却期限 = 0
		FOR LOCAL,1,BookTitles + 1
		ITEM:(100 + LOCAL) = 0
		NEXT
		PRINTW 반납일이 왔기에 빌린 책은 반납되어야 했다.	
	ENDIF
ENDIF

@BOOK_RENTAL_SALESTALK(ARGS)
IF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置
	CALL SPTALK, [[小鈴]], "笑顔", 0, @"%ARGS%", 1
	SIF TARGET != [[小鈴]]
		RESETCOLOR
ELSE
	CALL SPTALK, 0, "笑顔", 12, @"%ARGS%", 1
ENDIF
