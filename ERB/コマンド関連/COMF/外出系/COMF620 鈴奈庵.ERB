;貸本屋
@COM620
#DIM CHARISMA
#DIM ItemId
;addition custom code
CALL COM620_TR
RETURN RESULT

$C_LOOP
DRAWLINE
IF !CHARISMA
	PRINTFORML Money: %金額表示(MONEY)%
	PRINTFORML 「Borrowing costs %金額表示(3000)%」
ELSE
	PRINTFORML Charisma: {MONEY:2}
	PRINTL 「The rent is 10 Charisma」
ENDIF

DRAWLINE
FOR LOCAL,1, BookTitles + 1
	ItemId = LOCAL + 100
	PRINTFORM [{LOCAL}] %ITEMNAME_TR(ItemId)%
	IF ITEM:ItemId
		PRINTFORML (%CALLNAME:MASTER% is already borrowing it, {FLAG:貸本返却期限-1} day(s) until returning)
	ELSEIF GETBIT (FLAG:1011,LOCAL)
		PRINTL (Rented out)
	ELSE
		PRINTL 　
	ENDIF
NEXT

IF !CHARISMA
	PRINTFORML [100] Pay with Charisma
ELSE
	PRINTFORML [100] Pay with money
ENDIF
DRAWLINE
PRINTL [0] Cancel

$LOOP
INPUT

IF RESULT == 100
	IF !CHARISMA
		LOCALS = 「Pay with Charisma????」/「Uhh... Then, 10 Charisma...? Should be good enough I think...」
		CALL BOOK_RENTAL_SALESTALK(LOCALS)
		IF MONEY:2 < 10
			PRINTFORMW You don't have enough of Charisma
			GOTO C_LOOP
	ENDIF
	ELSE
		LOCALS = 「Ah, You'll pay with money then?」
		CALL BOOK_RENTAL_SALESTALK(LOCALS)
	ENDIF
	PRINTFORML 
	CHARISMA = !CHARISMA
	GOTO C_LOOP
ELSE
	IF !CHARISMA && MONEY < 3000
		PRINTW Not enough money...
		RETURN -1
	ENDIF
	IF INRANGE(RESULT, 1, BookTitles)
		RESULT:1 = RESULT
		IF GETBIT (FLAG:1011,RESULT:1)
			ItemId = RESULT:1 + 100
			IF ITEM:ItemId
				IF FLAG:貸本返却期限 == 8
					LOCALS = 「But you just borrowed it today……？」
					CALL BOOK_RENTAL_SALESTALK(LOCALS)
					RETURN -1
				ENDIF
								
				LOCALS = 「You are borrowing it, but……」/「Would you like to pay for a 7-day extension?」
				CALL BOOK_RENTAL_SALESTALK(LOCALS)
				CALL ASK_YN
				IF !RESULT
					IF !CHARISMA
						MONEY -= 3000
			ELSE
				MONEY:2 -= 10
			ENDIF
			FLAG:貸本返却期限 = 8
					PRINTFORML The loan period for %ITEMNAME_TR(100 + RESULT)% has been extended for a week
					LOCALS = 「Thank you very much!」/「You must like that book a lot.」
					CALL BOOK_RENTAL_SALESTALK(LOCALS)
		ELSE
			RETURN -1
				ENDIF
			ELSE
				LOCALS = 「It's rented out.」
				CALL BOOK_RENTAL_SALESTALK(LOCALS)
			ENDIF
			RETURN -1
		ELSE
			FOR LOCAL,1, BookTitles + 1
				ItemId = LOCAL + 100
				IF ITEM:ItemId
					LOCALS = 「You are already borrowing a book.」/「If you want another book, would you like to return the earlier one first?」
					CALL BOOK_RENTAL_SALESTALK(LOCALS)
					CALL ASK_YN
					IF !RESULT
						ITEM:ItemId = 0
						CLEARBIT FLAG:1011,LOCAL
					ELSE
						RETURN -1
					ENDIF
				ENDIF
			NEXT
			SETBIT FLAG:1011,RESULT:1
			IF !CHARISMA
				MONEY -= 3000
			ELSE
				MONEY:2 -= 10
			ENDIF
			ITEM:(100 + RESULT) = 1
			FLAG:貸本返却期限 = 8
			TFLAG:193 = 1
			PRINTFORML Borrowed %ITEMNAME_TR(100 + RESULT)%
			LOCALS = 「Thank you very much.」/「The loan period is a week.」 
			CALL BOOK_RENTAL_SALESTALK(LOCALS)
			RETURN 1
		ENDIF
	ELSEIF RESULT == 0
		RETURN -1
	ELSE
		GOTO LOOP
	ENDIF
ENDIF
TIME += 30

;貸本屋
@COM_ABLE620
;一括管理
SIF GLOBAL_COMABLE(620)
	RETURN RESULT
;貸本屋ではない場所
SIF !BOOK_RENTAL(CFLAG:MASTER:現在位置)
	RETURN 0
;睡眠中
SIF CFLAG:MASTER:睡眠 || CFLAG:MASTER:イタズラ || CFLAG:うふふ ;com custom code
	RETURN 0
;時間停止中
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 1

;貸本屋を判定する関数
@BOOK_RENTAL(ARG)
#FUNCTION
;鈴奈庵
SIF ARG == GET_MAP_REPLACEMENT(213)
	RETURNF 1
SIF ARG == GET_MAP_REPLACEMENT(1119)
	RETURNF 1
SIF GETBIT(HOME_CUSTOM_ROOM(ARG),1)
	RETURNF 1
RETURNF 0

@BOOKLEND
FOR LOCAL,1,BookTitles + 1
	SIF LOCAL == 6	;[紙芝居]をスルー
		CONTINUE
	;addition custom code
	IF LOCAL == (GETNUM(ITEM,  "妖魔本")-100) ;always unset demon book
		CLEARBIT FLAG:1011,LOCAL
		CONTINUE
	ENDIF
	;-------------------------------------------------------------
	SIF !ITEM:(100 + LOCAL) && !RAND:3
		INVERTBIT FLAG:1011,LOCAL
NEXT
SIF FLAG:貸本返却期限
	FLAG:貸本返却期限 -= 1
IF FLAG:貸本返却期限 == 1
;there was a fix here, need testing
	IF Omogatari_Raids()
	PRINTFORML With your negligence to return your books, %CALLNAME:[[小鈴]]% has order a hit against you...
	
	PRINTFORMDL A group of PMCs arrive and ask you to surrender the books.
		CALL ASK_YN("Surrender the books", "Resist")
		SELECTCASE RESULT
		CASE 0
			GOTO BookSurrender
		CASE 1
			CFLAG:MASTER:313 = 0
			CALL FACTION_ASSAIANS(MASTER, 1) 	
		ENDSELECT
	ELSE
	$BookSurrender
	;fix
	FLAG:貸本返却期限 = 0
	FOR LOCAL,1,BookTitles + 1
		ITEM:(100 + LOCAL) = 0
	NEXT
	PRINTW The return date has come, so the borrowed book had to be returned.	
	ENDIF
ENDIF

@BOOK_RENTAL_SALESTALK(ARGS)
IF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置
	CALL SPTALK, [[小鈴]], "笑顔", 0, @"%ARGS%", 1
	SIF TARGET != [[小鈴]]
		RESETCOLOR
ELSE
	CALL SPTALK, 0, "笑顔", 12, @"%ARGS%", 1
ENDIF