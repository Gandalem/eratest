; Modular ERB: COMF/外出系/STONEBATTLE.ERB

@STONEBATTLE(difficulty, C_ID)
#DIM C_ID
#DIM FIRSTONE
#DIM SECONE, 3
#DIM LASTONE, 3
#DIM FIRSTONE_E
#DIM SECONE_E
#DIM LASTONE_E
#DIM STONE_YOSOKU
#DIM KUISHIBARI
#DIM Skill
#DIM OUTCOME	;0=双方失敗 1=あなた成功 2=相手成功 3=双方成功
#DIM PLAYER_TOTAL
#DIM ENEMY_TOTAL
#DIM difficulty
#DIM DYNAMIC nLustPenalty ;bug fix custom code
FIRSTONE = 1 + RAND:5 + (TALENT:MASTER:針さばき * 2) + (TALENT:MASTER:器用な指 * 2) + (TALENT:MASTER:採集Lv / 2 ) + ( ABL:MASTER:清掃技能 / 2 ) + (TALENT:MASTER:調合Lv / 2 ) + (TALENT:MASTER:積み石ランカー * 2)
;持ち込みアイテム
SIF STONE_ITEM:1 == 2
	FIRSTONE += TALENT:MASTER:積み石ランカー + 1
Skill = ABL:MASTER:技巧 + ABL:MASTER:指
SECONE:0 = RAND:(6 + Skill) + Skill + RAND:8 + 7
SECONE:1 = RAND:(4 + Skill) + Skill + RAND:5 + 4
SECONE:2 = RAND:(2 + Skill) + (Skill / 2) + RAND:2 + 2
LASTONE:0 = RAND:9 + 2
LASTONE:1 = RAND:7 + 4
LASTONE:2 = RAND:5 + 7
IF difficulty == 0
	FIRSTONE_E = RAND:4 + 1
	SECONE_E = RAND:4 + RAND:5 + 1
	LASTONE_E = RAND:5 + 1
ELSEIF difficulty == 1
	FIRSTONE_E = RAND:5 + 2
	SECONE_E = RAND:6 + RAND:6 + 2
	LASTONE_E = RAND:6 + 2
ELSEIF difficulty == 2
	FIRSTONE_E = RAND:6 + 3
	SECONE_E = RAND:6 + RAND:7 + 3
	LASTONE_E = RAND:7 + 3
ELSEIF difficulty == 3
	FIRSTONE_E = RAND:7 + 4
	SECONE_E = RAND:7 + RAND:7 + 4
	LASTONE_E = RAND:8 + 4
ELSEIF difficulty == 4
	FIRSTONE_E = RAND:8 + 5
	SECONE_E = RAND:7 + RAND:8 + 5
	LASTONE_E = RAND:9 + 5
ELSEIF difficulty == 5
	FIRSTONE_E = RAND:10 + 6
	SECONE_E = RAND:8 + RAND:8 + 6
	LASTONE_E = RAND:10 + 6
ELSEIF difficulty == 6
	LOCAL = RAND:3
	FIRSTONE_E = RAND:(10 + LOCAL) + 5 + LOCAL
	SELECTCASE RAND:3
		CASE 0
			SECONE_E = RAND:8 + RAND:8 + 5
		CASE 1
			SECONE_E = RAND:9 + RAND:9 + 6
		CASE 2
			SECONE_E = RAND:10 + RAND:10 + 7
	ENDSELECT
	LASTONE_E = RAND:5 + 8
ELSEIF difficulty == 7
	SELECTCASE RAND:3
		CASE 0
			FIRSTONE_E = RAND:10 + 6
		CASE 1
			FIRSTONE_E = RAND:11 + 7
		CASE 2
			FIRSTONE_E = RAND:12 + 8
	ENDSELECT
	SELECTCASE RAND:3
		CASE 0
			SECONE_E = RAND:8 + RAND:8 + 6
		CASE 1
			SECONE_E = RAND:9 + RAND:9 + 7
		CASE 2
			SECONE_E = RAND:10 + RAND:10 + 8
	ENDSELECT
	LASTONE_E = RAND:6 + 9
ELSEIF difficulty == 8
	FIRSTONE_E = RAND:6 + 10
	SECONE_E = RAND:7 + RAND:7 + 10
	LASTONE_E = 20
ELSE
	FIRSTONE_E = RAND:7 + 12
	SECONE_E = RAND:8 + RAND:8 + 12
	LASTONE_E = 22
ENDIF
;相手の積み石数予測
IF STONE_ITEM:1 == 4
	STONE_YOSOKU = SECONE_E
ELSE
	IF SECONE_E < 6
		STONE_YOSOKU = SECONE_E + RAND:3
	ELSE
		SELECTCASE 1
			CASE 0
				STONE_YOSOKU = SECONE_E - RAND:6
			CASEELSE
				STONE_YOSOKU = SECONE_E + RAND:6
		ENDSELECT
	ENDIF
ENDIF
DRAWLINE
PRINTFORMW 쌓기 게임이 시작되었다!
SIF STONE_ITEM:1 == 2
	CALL COLORMESSAGE(@"몸 강화 지조가 발동했다!",C_YELLOW,2)
PRINTFORML 강력한 초반 시작 이후, 당신은 이제 %PRINT_PLUR("stone", FIRSTONE)%을 쌓았다.
PRINTFORML 반대편에서는, %CALLNAME:C_ID%가 {FIRSTONE_E}를 쌓았다...
IF STONE_ITEM:1 == 4
	CALL COLORMESSAGE(@"너무나 솔직한 돌 가이드가 발동했다!",C_YELLOW,2)
	PRINTFORMW 사고는 제쳐두고, %HE_SHE(C_ID)%가 여기서 %PRINT_PLUR("stone", STONE_YOSOKU)%을 쌓아주기를 기대한다...!
ELSE
	PRINTFORMW 너는 %HE_SHE(C_ID)%가 여기서 대략 %PRINT_PLUR("stone", STONE_YOSOKU)% 쌓일 거라는 느낌이 든다...
ENDIF
SIF COM_STONE_STACKING_LUST_PENALTY(MASTER)
	nLustPenalty = RAND:(COM_STONE_STACKING_LUST_PENALTY(MASTER)) ;bug fix, original pointed at target even though it's supposed to check yours. com custom code, restrict maximum desire penalty if clear-minded
; [AUTO-NEUTRALIZED] CALL ASK_M(@"스택 패스트(위험도: {12 + (nLustPenalty * 2)}% 및 돌의 개수: 많음)",1,@"꾸준한 페이스 (위험도: {10 + nLustPenalty}%)",1, @"느리고 조심스럽게(위험도: {7 + (nLustPenalty / 2)}%&돌의 개수: 적음)",1, @"대기 중 (위험도: 없음&돌 개수: 없음)",1)
IF RESULT == 0
	PRINTFORMW 돌을 빠르게 쌓는다, 비록 약간의 위험이 있더라도!
	PRINTFORMW 
	SELECTCASE RAND:100
		CASE 0 TO 6
			OUTCOME = 1
		CASE 7 TO 13
			OUTCOME = 0
		CASE 14 TO 18 + (nLustPenalty * 2)
			OUTCOME = 2
		CASEELSE
			OUTCOME = 3
	ENDSELECT
ELSEIF RESULT == 1
	PRINTFORMW 당신은 돌을 쌓는다.
	PRINTFORMW 
	SELECTCASE RAND:100
		CASE 0 TO 6
			OUTCOME = 1
		CASE 7 TO 13
			OUTCOME = 0
		CASE 14 TO 16 + nLustPenalty
			OUTCOME = 2
		CASEELSE
			OUTCOME = 3
	ENDSELECT
ELSEIF RESULT == 2
	PRINTFORMW 당신은 돌을 아주 조심스럽게 쌓는다.
	PRINTFORMW 
	SELECTCASE RAND:100
		CASE 0 TO 6
			OUTCOME = 1
		CASE 7 TO 13
			OUTCOME = 0
		CASE 13 TO 13 + (nLustPenalty / 2)
			OUTCOME = 2
		CASEELSE
			OUTCOME = 3
	ENDSELECT
ELSEIF RESULT == 3
	PRINTFORMW 당신은 더 많은 돌을 쌓지 못합니다.
	PRINTFORMW 
	PLAYER_TOTAL = FIRSTONE
	SELECTCASE RAND:100
		CASE 0 TO 13
			PRINTFORMW 당신은 아무것도 하지 않은 채 기다린다...
			PRINTFORMW 아아, 안 돼! %CALLNAME:C_ID%의 더미가 막 끝에서 무너진 것 같아!
			PRINTFORMW 상대는 이제 %PRINT_PLUR("stone", LASTONE_E)%를 갖게 되었다...
			ENEMY_TOTAL = LASTONE_E
		CASEELSE
			IF STONE_ITEM:1 == 3 && RAND:9 == 0
				PRINTFORMW 당신은 아무것도 하지 않고 기다린다...
				CALL COLORMESSAGE(@"근심 없는 돌 쌓는 자가 활성화되었다!",C_YELLOW,2)
				PRINTFORMW %CALLNAME:C_ID%(이)가 %HIS_HER(C_ID)%의 더미를 \@ OUTCOME % 2 == 1 ? 마지막에 # 또한 \@ 쓰러뜨린 것 같다!
				PRINTFORMW 그것을 복구하려 달려들었지만, %HE_SHE(C_ID)%은(는) 결국 %PRINT_PLUR("stone", LASTONE_E)%만 얻었다...
				ENEMY_TOTAL = LASTONE_E
			ELSE
				PRINTFORMW 너는 아무것도 하지 않고 기다린다...
				PRINTFORMW 잠시 쉬며 %CALLNAME:C_ID%를 바라본다.
				PRINTFORMW %HE_SHE(C_ID,1)%가 꾸준히 진행하고 있으며, 네가 기다리는 동안 {SECONE_E}가 더 추가된다...
				ENEMY_TOTAL = FIRSTONE_E + SECONE_E
			ENDIF
	ENDSELECT
ENDIF
IF GROUPMATCH(RESULT, 0, 1, 2)
	IF OUTCOME % 2 == 1
		PRINTFORMW 당신은 여분의 %PRINT_PLUR("stone", SECONE:RESULT)%을 쌓았습니다!
		PLAYER_TOTAL = FIRSTONE + SECONE:RESULT
	ELSE
		PRINTFORMW 이런!
		PRINTFORMW 네가 실수로 그것을 넘어뜨렸어!
		KUISHIBARI = RAND:CHARANUM
		;全キャラからランダムに判定して恋慕か恋人にヒットしたら食いしばりが発動する
		;仕様上全員を恋慕にしてるプレイヤーは絶対発動
		IF TALENT:(KUISHIBARI):恋人 || TALENT:(KUISHIBARI):恋慕
			CALL COLORMESSAGE(@"버텨라!!!",C_RED,1,1)
			CALL QUAKE(4) ;custom code
			PRINTFORMW 
			PRINTFORMW 착각일지도 모르지만, 잠시 동안 %CALLNAME:KUISHIBARI%이(가) 너를 응원하는 소리를 들은 것 같았다...
			PRINTFORMW 그 기세로 너는 전체 스택을 복구하기 위해 온 힘을 다했고, 그 이상까지 해냈다!
			PRINTFORMW 결국 너는 총 %PRINT_PLUR("stone", FIRSTONE + SECONE:RESULT)%개를 쌓게 되었다!
			PLAYER_TOTAL = FIRSTONE + SECONE:RESULT
		ELSEIF STONE_ITEM:1 == 1
			SELECTCASE RAND:5
				CASE 0
					CALL COLORMESSAGE(@"작은 조약 모자가 활성화되었다!",C_YELLOW,2)
					PRINTFORMW 당신의 스택은 언젠가 무너졌겠지만, 어떻게든 보이지 않는 무언가가 그것을 막아주었다...!
					PRINTFORMW 결국 총 %PRINT_PLUR("stone", FIRSTONE + SECONE:RESULT)%개를 쌓게 되었다!
					PLAYER_TOTAL = FIRSTONE + SECONE:RESULT
				CASEELSE
					PRINTFORMW 그것을 복구하려 서두르다가 결국 %PRINT_PLUR("stone", LASTONE:RESULT)%만 남게 되었다.
					PLAYER_TOTAL = LASTONE:RESULT
			ENDSELECT
		ELSE
			PRINTFORMW 그것을 복구하기 위해 서두르다가 결국 %PRINT_PLUR("stone", LASTONE:RESULT)%만 남게 된다.
			PLAYER_TOTAL = LASTONE:RESULT
		ENDIF
	ENDIF
	IF OUTCOME >= 2
		IF STONE_ITEM:1 == 3
			SELECTCASE RAND:9
				CASE 0
					CALL COLORMESSAGE(@"근심 없는 돌 쌓는 자가 활성화되었다!",C_YELLOW,2)
					PRINTFORMW %CALLNAME:C_ID%이(가) %HIS_HER(C_ID)%의 더미를 \@ OUTCOME % 2 == 1 ? 막판에 # 역시 \@ 쓰러뜨린 모양이다!
					PRINTFORMW 그것을 복구하려 서두르지만, %HE_SHE(C_ID)%은(는) 결국 %PRINT_PLUR("stone", LASTONE_E)%밖에 얻지 못했다...
					ENEMY_TOTAL = LASTONE_E
				CASEELSE
					PRINTFORMW 한편, %CALLNAME:C_ID%은 꾸준히 {SECONE_E} 만큼의 추가적인 %PLURALIZER("piece", SECONE_E)%을 모은 것 같다...
					ENEMY_TOTAL = FIRSTONE_E + SECONE_E
			ENDSELECT
		ELSE
			PRINTFORMW 한편, %CALLNAME:C_ID%은 꾸준히 {SECONE_E}의 추가적인 %PLURALIZER("piece", SECONE_E)%를 쌓고 있는 듯하다...
			ENEMY_TOTAL = FIRSTONE_E + SECONE_E
		ENDIF
	ELSE
		PRINTFORMW 이런! %CALLNAME:C_ID%가 %HIS_HER(C_ID)%의 더미%COND_STR(@" right at the end", OUTCOME % 2 == 1)%를 쓰러뜨렸다!
		PRINTFORMW 그것을 복구하려 서두르다, %HE_SHE(C_ID)%는 결국 %PRINT_PLUR("stone", LASTONE_E)%만 가지게 되었다...
		ENEMY_TOTAL = LASTONE_E
	ENDIF
ENDIF
CALL COLORMESSAGE(@"%CALLNAME:MASTER%：{PLAYER_TOTAL}　VS　%CALLNAME:C_ID%：{ENEMY_TOTAL}",C_YELLOW,2)
PRINTFORML 
IF PLAYER_TOTAL > ENEMY_TOTAL
	CALL COLORMESSAGE(@"승리했다!",C_YELLOW,1)
	CALL COLORMESSAGE(@"생명이 승리한다!",C_YELLOW,1)
	PRINTFORMW
	;ラスボス特殊分岐
	IF difficulty == 8
		;addition custom code, kojo dialogues
		CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lastbattle_w")
		SIF !RESULT
			TRYCALLFORM StoneMessage_{C_ID}("lastbattle_w")
	ELSE
		;addition custom code, kojo dialogues
		CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "win")
		SIF !RESULT
			TRYCALLFORM StoneMessage_{C_ID}("win")
	ENDIF
	RETURN 0
ELSEIF PLAYER_TOTAL == ENEMY_TOTAL
	PRINTFORML
	PRINTFORMW 무승부로 끝났으므로 또 다른 경기가 있을 것이다.
	JUMP STONEBATTLE(difficulty, C_ID)
ELSE
	CALL COLORMESSAGE(@"너는 패배했다!",C_YELLOW,1)
	CALL COLORMESSAGE(@"패배자!",C_YELLOW,1)
	PRINTFORMW
	;ラスボス特殊分岐
	IF difficulty == 8
		;addition custom code, kojo dialogues
		CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lastbattle_l")
		SIF !RESULT
			TRYCALLFORM StoneMessage_{C_ID}("lastbattle_l")
	ELSE
		;addition custom code, kojo dialogues
		CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lose")
		SIF !RESULT
			TRYCALLFORM StoneMessage_{C_ID}("lose")
	ENDIF
	RETURN 1
ENDIF
RETURN 0
