	StoneKoukando += 11
ELSEIF CFLAG:TARGET:好感度 >= 4000
	StoneKoukando += 10
ELSEIF CFLAG:TARGET:好感度 >= 3000
	StoneKoukando += 9
ELSEIF CFLAG:TARGET:好感度 >= 2500
	StoneKoukando += 8
ELSEIF CFLAG:TARGET:好感度 >= 2000
	StoneKoukando += 7
ELSEIF CFLAG:TARGET:好感度 >= 1500
	StoneKoukando += 5
ELSE
	StoneKoukando += 1
ENDIF
