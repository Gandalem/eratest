@STONEBATTLE(difficulty, C_ID)
#DIM C_ID
#DIM FIRSTONE
#DIM SECONE, 3
#DIM LASTONE, 3
#DIM FIRSTONE_E
#DIM SECONE_E
#DIM LASTONE_E
#DIM STONE_YOSOKU
#DIM KUISHIBARI
#DIM Skill
#DIM OUTCOME	;0=双方失敗 1=あなた成功 2=相手成功 3=双方成功
#DIM PLAYER_TOTAL
#DIM ENEMY_TOTAL
#DIM difficulty
#DIM DYNAMIC nLustPenalty ;bug fix custom code

{
FIRSTONE = 1 + RAND:5 + (TALENT:MASTER:針さばき * 2) + (TALENT:MASTER:器用な指 * 2) + (TALENT:MASTER:採集Lv / 2 )
+ ( ABL:MASTER:清掃技能 / 2 ) + (TALENT:MASTER:調合Lv / 2 ) + (TALENT:MASTER:積み石ランカー * 2) 
}

;持ち込みアイテム
SIF STONE_ITEM:1 == 2
	FIRSTONE += TALENT:MASTER:積み石ランカー + 1

Skill = ABL:MASTER:技巧 + ABL:MASTER:指

SECONE:0 = RAND:(6 + Skill) + Skill + RAND:8 + 7
SECONE:1 = RAND:(4 + Skill) + Skill + RAND:5 + 4
SECONE:2 = RAND:(2 + Skill) + (Skill / 2) + RAND:2 + 2
LASTONE:0 = RAND:9 + 2
LASTONE:1 = RAND:7 + 4
LASTONE:2 = RAND:5 + 7
IF difficulty == 0
	FIRSTONE_E = RAND:4 + 1
	SECONE_E = RAND:4 + RAND:5 + 1
	LASTONE_E = RAND:5 + 1
ELSEIF difficulty == 1
	FIRSTONE_E = RAND:5 + 2
	SECONE_E = RAND:6 + RAND:6 + 2
	LASTONE_E = RAND:6 + 2
ELSEIF difficulty == 2
	FIRSTONE_E = RAND:6 + 3
	SECONE_E = RAND:6 + RAND:7 + 3
	LASTONE_E = RAND:7 + 3
ELSEIF difficulty == 3
	FIRSTONE_E = RAND:7 + 4
	SECONE_E = RAND:7 + RAND:7 + 4
	LASTONE_E = RAND:8 + 4
ELSEIF difficulty == 4
	FIRSTONE_E = RAND:8 + 5
	SECONE_E = RAND:7 + RAND:8 + 5
	LASTONE_E = RAND:9 + 5
ELSEIF difficulty == 5
	FIRSTONE_E = RAND:10 + 6
	SECONE_E = RAND:8 + RAND:8 + 6
	LASTONE_E = RAND:10 + 6
ELSEIF difficulty == 6
	LOCAL = RAND:3
	FIRSTONE_E = RAND:(10 + LOCAL) + 5 + LOCAL
	SELECTCASE RAND:3
		CASE 0
			SECONE_E = RAND:8 + RAND:8 + 5
		CASE 1
			SECONE_E = RAND:9 + RAND:9 + 6
		CASE 2
			SECONE_E = RAND:10 + RAND:10 + 7
	ENDSELECT
	LASTONE_E = RAND:5 + 8
ELSEIF difficulty == 7
	SELECTCASE RAND:3
		CASE 0
			FIRSTONE_E = RAND:10 + 6
		CASE 1
			FIRSTONE_E = RAND:11 + 7
		CASE 2
			FIRSTONE_E = RAND:12 + 8
	ENDSELECT
	SELECTCASE RAND:3
		CASE 0
			SECONE_E = RAND:8 + RAND:8 + 6
		CASE 1
			SECONE_E = RAND:9 + RAND:9 + 7
		CASE 2
			SECONE_E = RAND:10 + RAND:10 + 8
	ENDSELECT
	LASTONE_E = RAND:6 + 9
ELSEIF difficulty == 8
	FIRSTONE_E = RAND:6 + 10
	SECONE_E = RAND:7 + RAND:7 + 10
	LASTONE_E = 20
ELSE 
	FIRSTONE_E = RAND:7 + 12
	SECONE_E = RAND:8 + RAND:8 + 12
	LASTONE_E = 22
ENDIF

;相手の積み石数予測
IF STONE_ITEM:1 == 4
	STONE_YOSOKU = SECONE_E
ELSE
	IF SECONE_E < 6
		STONE_YOSOKU = SECONE_E + RAND:3
	ELSE
		SELECTCASE 1
			CASE 0
				STONE_YOSOKU = SECONE_E - RAND:6
			CASEELSE
				STONE_YOSOKU = SECONE_E + RAND:6
		ENDSELECT
	ENDIF
ENDIF


DRAWLINE

PRINTFORMW The Stacking Game has begun!
SIF STONE_ITEM:1 == 2
	CALL COLORMESSAGE(@"Body Strengthening Jizo Activates!",C_YELLOW,2)
PRINTFORML After a strong early start, you have now stacked %PRINT_PLUR("stone", FIRSTONE)%.
PRINTFORML On the other side, %CALLNAME:C_ID% has stacked {FIRSTONE_E}...
IF STONE_ITEM:1 == 4
	CALL COLORMESSAGE(@"All-Too-Honest Stone Guide Activates!",C_YELLOW,2)
	PRINTFORMW Accidents aside, %HE_SHE(C_ID)%'s expected to stack %PRINT_PLUR("stone", STONE_YOSOKU)% from here...!
ELSE
	PRINTFORMW You have a feeling %HE_SHE(C_ID)%'ll stack roughly %PRINT_PLUR("stone", STONE_YOSOKU)% from here...
ENDIF
SIF COM_STONE_STACKING_LUST_PENALTY(MASTER)
	nLustPenalty = RAND:(COM_STONE_STACKING_LUST_PENALTY(MASTER)) ;bug fix, original pointed at target even though it's supposed to check yours. com custom code, restrict maximum desire penalty if clear-minded
{
CALL ASK_M(@"Stack Fast（Risk: {12 + (nLustPenalty * 2)}％＆Number Of Stones: Many）",1,@"Steady Pace（Risk: {10 + nLustPenalty}％）",1,
@"Slow And Careful（Risk: {7 + (nLustPenalty / 2)}％＆Number Of Stones: Few）",1, @"Idle （Risk: None＆Number Of Stones: None）",1)
}

IF RESULT == 0
	PRINTFORMW You stack stones fast, even if there's some risk!
	PRINTFORMW 
	SELECTCASE RAND:100
		CASE 0 TO 6
			OUTCOME = 1
		CASE 7 TO 13
			OUTCOME = 0
		CASE 14 TO 18 + (nLustPenalty * 2)
			OUTCOME = 2
		CASEELSE
			OUTCOME = 3
		ENDSELECT
ELSEIF RESULT == 1
	PRINTFORMW You stack some stones.
	PRINTFORMW 
	SELECTCASE RAND:100
		CASE 0 TO 6
			OUTCOME = 1
		CASE 7 TO 13
			OUTCOME = 0
		CASE 14 TO 16 + nLustPenalty
			OUTCOME = 2
		CASEELSE
			OUTCOME = 3
	ENDSELECT
ELSEIF RESULT == 2
	PRINTFORMW You stack stones very carefully.
	PRINTFORMW 
	SELECTCASE RAND:100
		CASE 0 TO 6
			OUTCOME = 1
		CASE 7 TO 13
			OUTCOME = 0
		CASE 13 TO 13 + (nLustPenalty / 2)
			OUTCOME = 2
		CASEELSE
			OUTCOME = 3
	ENDSELECT
ELSEIF RESULT == 3
	PRINTFORMW You don't stack more stones.
	PRINTFORMW 
	PLAYER_TOTAL = FIRSTONE
	SELECTCASE RAND:100
		CASE 0 TO 13
			PRINTFORMW You wait, doing nothing...
			PRINTFORMW Oh no! It looks like %CALLNAME:C_ID%'s pile crumbled right before the end!
			PRINTFORMW Your opponent now has %PRINT_PLUR("stone", LASTONE_E)%...
			ENEMY_TOTAL = LASTONE_E
		CASEELSE
			IF STONE_ITEM:1 == 3 && RAND:9 == 0
				PRINTFORMW You wait, doing nothing...
				CALL COLORMESSAGE(@"Carefree Stone Stacker Activates!",C_YELLOW,2)
				PRINTFORMW Looks like %CALLNAME:C_ID% managed to knock over %HIS_HER(C_ID)% pile \@ OUTCOME % 2 == 1 ? right at the end # as well \@!
				PRINTFORMW Rushing to restore it, %HE_SHE(C_ID)% ends up with only %PRINT_PLUR("stone", LASTONE_E)%...
				ENEMY_TOTAL = LASTONE_E
			ELSE
				PRINTFORMW You wait, doing nothing...
				PRINTFORMW Taking a break, you look at %CALLNAME:C_ID%.
				PRINTFORMW %HE_SHE(C_ID,1)%'s making steady progress, adding {SECONE_E} more while you wait...
				ENEMY_TOTAL = FIRSTONE_E + SECONE_E
			ENDIF
	ENDSELECT
ENDIF

IF GROUPMATCH(RESULT, 0, 1, 2)
	IF OUTCOME % 2 == 1
		PRINTFORMW You have piled up extra %PRINT_PLUR("stone", SECONE:RESULT)%!
		PLAYER_TOTAL = FIRSTONE + SECONE:RESULT
	ELSE
		PRINTFORMW Whoops!
		PRINTFORMW You accidentally knock it over!
		KUISHIBARI = RAND:CHARANUM
		;全キャラからランダムに判定して恋慕か恋人にヒットしたら食いしばりが発動する
		;仕様上全員を恋慕にしてるプレイヤーは絶対発動
		IF TALENT:(KUISHIBARI):恋人 || TALENT:(KUISHIBARI):恋慕
			CALL COLORMESSAGE(@"...HANG IN THERE!!!",C_RED,1,1)
			CALL QUAKE(4) ;custom code
			PRINTFORMW 
			PRINTFORMW You might be tripping, but for a second you think you just heard %CALLNAME:KUISHIBARI% cheering on you...
			PRINTFORMW With that, you put your utmost effort into restoring the entire stack, and then some!
			PRINTFORMW You end up stacking a total of %PRINT_PLUR("stone", FIRSTONE + SECONE:RESULT)%!
			PLAYER_TOTAL = FIRSTONE + SECONE:RESULT
		ELSEIF STONE_ITEM:1 == 1
			SELECTCASE RAND:5
				CASE 0
					CALL COLORMESSAGE(@"Small Pebble Hat Activates!",C_YELLOW,2)
					PRINTFORMW Your stack was sure to collapse at some point, but somehow it was prevented by something invisible...!
					PRINTFORMW You end up stacking a total of %PRINT_PLUR("stone", FIRSTONE + SECONE:RESULT)%!
					PLAYER_TOTAL = FIRSTONE + SECONE:RESULT
				CASEELSE
					PRINTFORMW Rushing to restore it, you end up with only %PRINT_PLUR("stone", LASTONE:RESULT)%...
					PLAYER_TOTAL = LASTONE:RESULT
			ENDSELECT
		ELSE
			PRINTFORMW Rushing to restore it, you end up with only %PRINT_PLUR("stone", LASTONE:RESULT)%...
			PLAYER_TOTAL = LASTONE:RESULT
		ENDIF
	ENDIF
	IF OUTCOME >= 2
		IF STONE_ITEM:1 == 3
			SELECTCASE RAND:9
				CASE 0
					CALL COLORMESSAGE(@"Carefree Stone Stacker Activates!",C_YELLOW,2)
					PRINTFORMW Looks like %CALLNAME:C_ID% managed to knock over %HIS_HER(C_ID)% pile \@ OUTCOME % 2 == 1 ? right at the end # as well \@!
					PRINTFORMW Rushing to restore it, %HE_SHE(C_ID)% ends up with only %PRINT_PLUR("stone", LASTONE_E)%...
					ENEMY_TOTAL = LASTONE_E
				CASEELSE
					PRINTFORMW Meanwhile, %CALLNAME:C_ID% seems to have steadily racked up {SECONE_E} additional %PLURALIZER("piece", SECONE_E)%...
					ENEMY_TOTAL = FIRSTONE_E + SECONE_E
			ENDSELECT
		ELSE
			PRINTFORMW Meanwhile, %CALLNAME:C_ID% seems to have steadily racked up {SECONE_E} additional %PLURALIZER("piece", SECONE_E)%...
			ENEMY_TOTAL = FIRSTONE_E + SECONE_E
		ENDIF
	ELSE
		PRINTFORMW Oops! %CALLNAME:C_ID% knocked over %HIS_HER(C_ID)% pile%COND_STR(@" right at the end", OUTCOME % 2 == 1)%!
		PRINTFORMW Rushing to restore it, %HE_SHE(C_ID)% ends up with only %PRINT_PLUR("stone", LASTONE_E)%...
		ENEMY_TOTAL = LASTONE_E
	ENDIF
ENDIF
CALL COLORMESSAGE(@"%CALLNAME:MASTER%：{PLAYER_TOTAL}　VS　%CALLNAME:C_ID%：{ENEMY_TOTAL}",C_YELLOW,2)
PRINTFORML 
IF PLAYER_TOTAL > ENEMY_TOTAL
	CALL COLORMESSAGE(@"YOU WIN!",C_YELLOW,1)
	CALL COLORMESSAGE(@"Life Prevails!",C_YELLOW,1)
	PRINTFORMW
	;ラスボス特殊分岐
	IF difficulty == 8
		;addition custom code, kojo dialogues
        CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lastbattle_w")
		SIF !RESULT
		TRYCALLFORM StoneMessage_{C_ID}("lastbattle_w")
	ELSE
		;addition custom code, kojo dialogues
        CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "win")
		SIF !RESULT
		TRYCALLFORM StoneMessage_{C_ID}("win")
	ENDIF
	RETURN 0
ELSEIF PLAYER_TOTAL == ENEMY_TOTAL
	PRINTFORML
	PRINTFORMW Because it ended in a draw, there will be another match.
	JUMP STONEBATTLE(difficulty, C_ID)
ELSE
	CALL COLORMESSAGE(@"YOU LOSE!",C_YELLOW,1)
	CALL COLORMESSAGE(@"LOSER!",C_YELLOW,1)
	PRINTFORMW
	;ラスボス特殊分岐
	IF difficulty == 8
		;addition custom code, kojo dialogues
        CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lastbattle_l")
		SIF !RESULT
		TRYCALLFORM StoneMessage_{C_ID}("lastbattle_l")
	ELSE
		;addition custom code, kojo dialogues
        CALL KOJO_MESSAGE_SEND("EVENT", 0, C_ID, 0, 0, "STONEBATTLE", "lose")
		SIF !RESULT
		TRYCALLFORM StoneMessage_{C_ID}("lose")
	ENDIF
	RETURN 1
ENDIF

RETURN 0


