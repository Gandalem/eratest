ELSEIF CFLAG:TARGET:好感度 >= 50000
	StoneKoukando += 18
ELSEIF CFLAG:TARGET:好感度 >= 30000
	StoneKoukando += 17
ELSEIF CFLAG:TARGET:好感度 >= 15000
	StoneKoukando += 16
ELSEIF CFLAG:TARGET:好感度 >= 12500
	StoneKoukando += 15
ELSEIF CFLAG:TARGET:好感度 >= 10000
