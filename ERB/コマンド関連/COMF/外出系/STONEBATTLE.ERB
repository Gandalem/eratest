@STONECombiBattle
#DIM CombiSkill
#DIM StoneState
#DIM CombiLove
#DIM StoneKoukando
#DIMS StoneGood
#DIMS StoneBad
#DIM StoneSense
#DIM CombiPoint
#DIM Stoneday
#DIM DYNAMIC nLustPenalty
CombiSkill = 0
StoneState = 0
CombiLove = 0
StoneKoukando = 0
StoneGood = 0
StoneBad = 0
StoneSense = 0
CombiPoint = 0
Stoneday = 0
IF DAY:3 == 31
	PRINTFORMW 「오늘은 시즌의 31일이니 뭐든지 괜찮아!」
	PRINTFORMW 「어떤 테마에 참가하고 싶어?」
	FOR LOCAL,1, 31
	PRINTFORMLC [{LOCAL}] - %STONECombiDAY(LOCAL)%
	SIF LOCAL % 5 == 0
		PRINTL
	NEXT
	$LOOP
	INPUT
	IF INRANGE(RESULT, 1, 30)
		Stoneday = RESULT
	ELSE
		GOTO LOOP
	ENDIF
ELSE
	Stoneday = DAY:3
ENDIF
CombiSkill = (ABL:MASTER:指 * 2) + ABL:MASTER:技巧 + (ABL:TARGET:指 * 2) + ABL:TARGET:技巧
;com custom code, enable restriction on desire penalty if clear-minded
SIF COM_STONE_STACKING_LUST_PENALTY(TARGET)
	nLustPenalty += RAND:(COM_STONE_STACKING_LUST_PENALTY(TARGET))
SIF COM_STONE_STACKING_LUST_PENALTY(MASTER)
	nLustPenalty += RAND:(COM_STONE_STACKING_LUST_PENALTY(MASTER))
StoneState = 30 + (TALENT:MASTER:針さばき * 5) + (TALENT:MASTER:器用な指 * 5) + TALENT:MASTER:採集Lv + ABL:MASTER:清掃技能 + TALENT:MASTER:調合Lv + (TALENT:MASTER:積み石ランカー * 2) + (TALENT:TARGET:針さばき * 5) + (TALENT:TARGET:器用な指 * 5) + TALENT:TARGET:採集Lv + ABL:TARGET:清掃技能 + TALENT:TARGET:調合Lv + (TALENT:TARGET:積み石ランカー * 2) + RAND:CombiSkill + CombiSkill - nLustPenalty
IF CFLAG:TARGET:好感度 >= 100000
