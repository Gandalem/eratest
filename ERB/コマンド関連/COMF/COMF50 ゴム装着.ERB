@COM50
TFLAG:102 = 0
CALL NAS_Put_On_Condom ;com custom code
RETURN RESULT
;着脱の処理
IF !TEQUIP:PLAYER:コンドーム
	ITEM:45 -= 1
	TEQUIP:PLAYER:コンドーム = 1
	PRINTL You put on a condom.
	PRINTFORMW {ITEM:45} left.
ELSE
	TEQUIP:PLAYER:コンドーム = 0
	PRINTW You take off the condom.
ENDIF
