; Modular ERB: COMF/700 自慰系/COMF751 自慰終了.ERB
;-------------------------------------------------
;自慰終了
;-------------------------------------------------

@COM751
;CALL ENDUFUFU(PLAYER)
IF FLAG:70 == 1
	;時間停止中は服装セットしない
ELSEIF CFLAG:PLAYER:イタズラ > 1
	;はだけ中は服装セットしない
ELSEIF LOCK:(CFLAG:PLAYER:311) && CFLAG:PLAYER:イタズラ < 2
	;イタズラLv1以下ならパジャマセット
	CALL CTRL_CLOTHES_SET(PLAYER, "現在衣装の変更_パジャマ")
ELSE
	;イタズラ以外なら普段着セット
	CALL CTRL_CLOTHES_SET(PLAYER, "現在衣装の変更_普段着")
	CFLAG:PLAYER:パジャマ = 0
ENDIF
;服装をTEQUIPへ（↓でやってるので削除）
;ウフフ時系装備リセット
;TEQUIP:ARG:10-TEQUIP:ARG:149を初期化する
;PLAYER:1をカウントに使うのはやめよう
VARSET TEQUIP:(PLAYER):0, 0, 10, 150
;射精関係リセット
IF TFLAG:102 < 2
	BASE:PLAYER:射精 = 0
	TCVAR:PLAYER:12 = 0
ENDIF
CFLAG:今忙しくて手が離せない = 0
TEQUIP:PLAYER:50 = -1
TEQUIP:PLAYER:51 = -1
;NAS: U Sex
TEQUIP:PLAYER:USex = -1
TEQUIP:PLAYER:上半身はだけ状態 = 0
TEQUIP:PLAYER:下半身ずらし状態 = 0
TCVAR:PLAYER:無理矢理 = 0
IF !FLAG:70
	TFLAG:運搬 = MASTER
	IF CFLAG:PLAYER:口に精液
		PRINTFORML %조사처리(CALLNAME:PLAYER,"는")%(는) 입안에 남아있던 정액을 \@ ABL:PLAYER:精液中毒 > 2 ? 마셔버렸다 # 토해냈다 \@.
		CFLAG:PLAYER:口に精液 = 0
	ENDIF
	IF CFLAG:PLAYER:顔に精液 || CFLAG:PLAYER:手に精液
		PRINTFORM %조사처리(CALLNAME:PLAYER,"는")%
		IF CFLAG:PLAYER:顔に精液 && !CFLAG:PLAYER:手に精液
			PRINTFORM 얼굴에 달라붙어 있었다
		ELSEIF !CFLAG:PLAYER:顔に精液 && CFLAG:PLAYER:手に精液
			PRINTFORM 손에 들러붙은
		ELSE
			PRINTFORM 얼굴과 손을 더럽히고 있다.
		ENDIF
		PRINTFORM 정액을\@ ABL:PLAYER:精液中毒 > 2 ? 입에 머금었다 # 닦았다 \@
		CFLAG:PLAYER:顔に精液 = 0
		CFLAG:PLAYER:手に精液 = 0
		CFLAG:LOCAL:脇に精液 = 0 ;custom code
	ENDIF
ENDIF
TEQUIP:PLAYER:乳首吸い自慰 = 0
TEQUIP:PLAYER:胸揉み自慰 = 0
TFLAG:106 = 0
;はだけフラグをオフ
TEQUIP:PLAYER:2 = 0
TEQUIP:PLAYER:上半身はだけ状態 = 0
CALL CLOTHES_SETTING_TRAIN(PLAYER)
;上着脱衣済みフラグをオフ
TEQUIP:PLAYER:5 = 0
SIF !FLAG:時間停止
	TIME += 5
;自慰経験
SIF CFLAG:PLAYER:オナニーした > 0
	EXP:PLAYER:自慰経験 ++
CFLAG:PLAYER:オナニーした = 0
RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------

@COM_ABLE751
;自慰終了実行判定
SIF !TFLAG:100
	RETURN 0
SIF TARGET != MASTER && FLAG:70 && CFLAG:PLAYER:今忙しくて手が離せない
	RETURN 1
SIF !CFLAG:MASTER:今忙しくて手が離せない
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(751)
	RETURN RESULT
RETURN 1
