;-------------------------------------------------
;アナル開帳
;愛撫系コマンド、レベル2
;NAS: Turned all PLAYER checks into MASTER ones
;-------------------------------------------------
@COM713
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = MASTER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力

DOWNBASE:MASTER:体力 += 50
DOWNBASE:MASTER:気力 += 90

SOURCE:MASTER:快Ａ = 43
SOURCE:MASTER:達成 = 20
SOURCE:MASTER:恐怖 = 120
SOURCE:MASTER:液体 = 10
SOURCE:MASTER:露出 = 300
SOURCE:MASTER:屈従 = 450
SOURCE:MASTER:逸脱 = 150
SOURCE:MASTER:反感 = 150
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:MASTER:自己愛 < 0 || TALENT:MASTER:抵抗
	SOURCE:MASTER:鬱屈 += 150

;処女、貞操観念
IF TALENT:MASTER:処女 == 1 || TALENT:MASTER:処女 == -1
	TIMES SOURCE:MASTER:恐怖 , 1.20
	TIMES SOURCE:MASTER:屈従 , 1.20
	TIMES SOURCE:MASTER:反感 , 1.20
	SOURCE:MASTER:露出 += 300
	IF TALENT:MASTER:貞操 > 0
		TIMES SOURCE:MASTER:露出 , 2.00
		TIMES SOURCE:MASTER:逸脱 , 2.00
	ENDIF
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＶ⇔指の汚れが移動
STAIN:MASTER:4 |= STAIN:MASTER:1
STAIN:MASTER:1 |= STAIN:MASTER:4
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
SIF !FLAG:時間停止
	TIME += 5
;露出癖Lv3以上で自慰経験加算
SIF ABL:MASTER:露出癖 >= 3
	CFLAG:MASTER:オナニーした ++
RETURN 1

[SKIPSTART]
@CAN_COM713(PLAYER)
SKIPDISP PLAYER
PRINTL Spread Anus (Self)
;-------------------------------------------------
;実行できるかの判定
;-------------------------------------------------
	A = 0
	S = 0
	;すべての命令に共通の要素を考慮
	;(従順が高いと命令に従いやすいなど)
	CALL COM_ORDER

	;ABL:PLAYER:欲望
	IF ABL:PLAYER:欲望
		SIF S
			PRINT  + 
		A += ABL:PLAYER:欲望 * 3
		PRINT Desire
		PRINTV 'LV,ABL:PLAYER:欲望,'(,ABL:PLAYER:欲望 * 3,')
		S = 1
	ENDIF
	;ABL:PLAYER:Ａ感覚
	IF ABL:PLAYER:Ａ感覚
		SIF S
			PRINT  + 
		A += ABL:PLAYER:Ａ感覚 * 2
		PRINT A Sens
		PRINTV 'LV,ABL:PLAYER:Ａ感覚,'(,ABL:PLAYER:Ａ感覚 * 2,')
		S = 1
	ENDIF
	;ABL:PLAYER:奉仕精神
	IF ABL:PLAYER:奉仕精神
		SIF S
			PRINT  + 
		A += ABL:PLAYER:奉仕精神 * 4
		PRINT Servitude
		PRINTV 'LV,ABL:PLAYER:奉仕精神,'(,ABL:PLAYER:奉仕精神 * 4,')
		S = 1
	ENDIF
	;ABL:PLAYER:露出癖
	IF ABL:PLAYER:露出癖
		SIF S
			PRINT  + 
		A += ABL:PLAYER:露出癖 * 3
		PRINT Exposure
		PRINTV 'LV,ABL:PLAYER:露出癖,'(,ABL:PLAYER:露出癖 * 3,')
		S = 1
	ENDIF
	;ABL:PLAYER:自慰中毒
	IF ABL:PLAYER:自慰中毒
		SIF S
			PRINT  + 
		A += ABL:PLAYER:自慰中毒 * 3
		PRINT Masturbation Addiction
		PRINTV 'LV,ABL:PLAYER:自慰中毒,'(,ABL:PLAYER:自慰中毒 * 3,')
		S = 1
	ENDIF

	IF MARK:PLAYER:快楽刻印
		SIF S
			PRINT  + 
		A += MARK:PLAYER:快楽刻印 * 3
		PRINT Pleasure Mark
		PRINTV 'LV,MARK:PLAYER:快楽刻印,'(,MARK:PLAYER:快楽刻印 * 3,')
		S = 1
	ENDIF

	;PALAM:PLAYER:潤滑（の不足）
	IF PALAM:PLAYER:潤滑 < PALAMLV:3
		PRINT  - 
		A -= 5
		PRINT Low Lubrication
		PRINTV '(,5,')
		S = 1
	ENDIF
	;PALAM:PLAYER:欲情
	IF GETPALAMLV(PALAM:PLAYER:欲情,5)
		SIF S
			PRINT  + 
		A += GETPALAMLV(PALAM:PLAYER:欲情,5) * 3
		PRINT Desire
		PRINTV 'LV,GETPALAMLV(PALAM:PLAYER:欲情,5),'(,GETPALAMLV(PALAM:PLAYER:欲情,5) * 3,')
		S = 1
	ENDIF

	;恥じらい
	IF TALENT:PLAYER:羞恥心 > 0
		PRINT  - 
		A -= 2
		PRINT Shy
		PRINTV '(,2,')
		S = 1
	ENDIF
	;快感の否定（淫乱、娼婦で無効）
	IF TALENT:PLAYER:快感応答 < 0 && !TALENT:PLAYER:淫乱
		PRINT  - 
		A -= 5
		PRINT Denies Pleasure
		PRINTV '(,5,')
		S = 1
	ENDIF
	;男嫌い（恋慕、親愛で無効）
	IF OTOKOGIRAI(TARGET) == 1
		PRINT  - 
		A -= 12
		PRINT Man Hater
		PRINTV '(,12,')
		S = 1
	ENDIF

	;処女
	IF TALENT:PLAYER:処女 == 1
		PRINT  - 
		A -= 20
		PRINT Virgin
		PRINTV '(,20,')
		S = 1
	ELSEIF EXP:PLAYER:Ａ経験 < EXPLV:2
		PRINT  - 
		A -= 5
		PRINT Lack of 
		PRINT A Exp
		PRINTV '(,5,')
		S = 1
	ENDIF

	;調教者がふたなり
	IF (TALENT:PLAYER:2 & 3) == 3
		PRINT  + 
		A += 4
		PRINT Futanari
		PRINTV '(,4,')
		S = 1
	ENDIF

	;媚薬
	IF TCVAR:PLAYER:媚薬
		SIF S
			PRINT  + 
		A += 6
		PRINT Aphrodisiac
		PRINTV '(,6,')
		S = 1
	ENDIF

	;'合計を表示(18以上で実行)
	PRINT  = 
	PRINTV A

	V = 18
	SIF A < V
		PRINT  < 
	SIF A == V
		PRINT  = 
	SIF A > V
		PRINT  > 
	PRINT Required Value 
	PRINTV V

	WAIT
	SKIPDISP 0
	;実行できない
	SIF A < V
		RETURN 0
RETURN 1
[SKIPEND]

