; Modular ERB: COMF/700 自慰系/COMF713 アナル開帳(慰).ERB
;-------------------------------------------------
;アナル開帳
;愛撫系コマンド、レベル2
;NAS: Turned all PLAYER checks into MASTER ones
;-------------------------------------------------

@COM713
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = MASTER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:MASTER:体力 += 50
DOWNBASE:MASTER:気力 += 90
SOURCE:MASTER:快Ａ = 43
SOURCE:MASTER:達成 = 20
SOURCE:MASTER:恐怖 = 120
SOURCE:MASTER:液体 = 10
SOURCE:MASTER:露出 = 300
SOURCE:MASTER:屈従 = 450
SOURCE:MASTER:逸脱 = 150
SOURCE:MASTER:反感 = 150
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:MASTER:自己愛 < 0 || TALENT:MASTER:抵抗
	SOURCE:MASTER:鬱屈 += 150
;処女、貞操観念
IF TALENT:MASTER:処女 == 1 || TALENT:MASTER:処女 == -1
	TIMES SOURCE:MASTER:恐怖 , 1.20
	TIMES SOURCE:MASTER:屈従 , 1.20
	TIMES SOURCE:MASTER:反感 , 1.20
	SOURCE:MASTER:露出 += 300
	IF TALENT:MASTER:貞操 > 0
		TIMES SOURCE:MASTER:露出 , 2.00
		TIMES SOURCE:MASTER:逸脱 , 2.00
	ENDIF
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＶ⇔指の汚れが移動
STAIN:MASTER:4 |= STAIN:MASTER:1
STAIN:MASTER:1 |= STAIN:MASTER:4
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
SIF !FLAG:時間停止
	TIME += 5
;露出癖Lv3以上で自慰経験加算
SIF ABL:MASTER:露出癖 >= 3
	CFLAG:MASTER:オナニーした ++
RETURN 1
;-------------------------------------------------
;実行可能判定
;-------------------------------------------------

@COM_ABLE713
;アナル開帳実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(713)
	RETURN RESULT
;時間停止中は許可
IF FLAG:70 != 1
	; ;従順が2未満だとダメ
	; SIF ABL:従順< 2
	; 	RETURN 0
	; ;処女の場合、従順3以上または露出癖3以上ないとダメ
	; SIF TALENT:処女 && ABL:従順 < 3 && ABL:露出癖 < 3
	; 	RETURN 0
	;redundant checks
	;NAS: needs an anus
	SIF !HAS_ANUS(MASTER)
		RETURN 0
	;縄使用中は不可
	SIF TEQUIP:MASTER:縄
		RETURN 0
ENDIF
;NAS: converted to use MASTER checks
;下半身着衣
SIF TEQUIP:MASTER:0 & 4 || TEQUIP:MASTER:0 & 2
	RETURN 0
;アナルバイブ、ビーズ挿入してる時はダメ
SIF TEQUIP:MASTER:14 || TEQUIP:MASTER:15
	RETURN 0
;お風呂場プレイ中はプレイマットが無いとダメ
IF TEQUIP:MASTER:31
	SIF ITEM:20 == 0 && NOITEM == 0
		RETURN 0
ENDIF
RETURN 1
