; Modular ERB: COMF/700 自慰系/COMF460妄想オナニー.ERB

@COM460
;妄想オナニー
CALL COM460_NAS; NAS: REPLACED
RETURN RESULT
VARSET LOCAL
IF FLAG == 70
	TCVAR:194 = 1
	RETURN 0
ELSEIF GET_TARGETNUM() > 0
	TCVAR:194 = 2
	RETURN 0
ELSE
	TCVAR:194 = 3
	$LOOP_MOUSOU
	FOR LOCAL,1,CHARANUM
	SIF !CFLAG:LOCAL:出禁
		PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
	NEXT
	PRINTL
	DRAWLINE
	PRINTL [900] 그만두다
	PRINTL 누구를 떠올리나요?
	INPUT
	SELECTCASE RESULT
		CASE 1 TO CHARANUM - 1
			ADDCOPYCHARA RESULT
			CFLAG:MASTER:現在位置 = 260
			CFLAG:(CHARANUM - 1):現在位置 = 260
			CFLAG:(CHARANUM - 1):面識 = 1
			CFLAG:(CHARANUM - 1):2 = 100000
			CFLAG:(CHARANUM - 1):4 = 10000
			CFLAG:(CHARANUM - 1):生解禁 = 2
			CFLAG:(CHARANUM - 1):同行 = 300
			CFLAG:TARGET:デート中 = 2
			CFLAG:MASTER:デート中 = 2
			TFLAG:妄想中 = 1
			MARK:(CHARANUM - 1):快楽刻印 = 3
			MARK:(CHARANUM - 1):不埒刻印 = 3
			CFLAG:(CHARANUM - 1):うふふ = 0
			CFLAG:(CHARANUM - 1):睡眠 = 0
			CFLAG:(CHARANUM - 1):行動 = 0
			TALENT:(CHARANUM - 1):妄想の産物 = 1
			BASE:(CHARANUM - 1):仕事量 = 0
			PRINTFORMW %CALLNAME:RESULT%와 섹스합니다.
			PRINTL 망상으로 계속 할 수 있도록, 처녀가 아닌 것으로 설정되어 있지만……
			PRINTL 처녀로 할까요?
			PRINTL [0]예 [1]아니요
			$INPUT_VIRGIN
			INPUT
			IF RESULT == 0
				PRINTW 부디 상냥하게 대해주세요.
				PRINTW 다만, V감각은 10이다
				TALENT:(CHARANUM - 1):処女 = 1
				ABL:(CHARANUM - 1):Ｖ感覚 = 10
				EXP:(CHARANUM - 1):精飲経験 = 0
				EXP:(CHARANUM - 1):Ｖ性交経験 = 0
			ELSEIF RESULT == 1
				PRINTW 그대로 시작한다
			ELSE
				GOTO INPUT_VIRGIN
			ENDIF
			PRINTL 그런데, 항문에 흥미는……
			PRINTL [0]있다 [1]없다
			$INPUT_ANUS
			INPUT
			IF RESULT == 0
				PRINTW 감각, 경험을 준다.
				ABL:(CHARANUM - 1):Ａ感覚 = 10
				EXP:(CHARANUM - 1):Ａ経験 = 100
				EXP:(CHARANUM - 1):Ａ拡張経験 = 50
			ELSEIF RESULT == 1
				PRINTW 그대로 시작한다
			ELSE
				GOTO INPUT_ANUS
			ENDIF
			BEFORE_MOUSOU_EXP14 = EXP:MASTER:14
			BEFORE_MOUSOU_EXP15 = EXP:MASTER:15
			BEFORE_MOUSOU_EXP16 = EXP:MASTER:16
			BEFORE_MOUSOU_EXP20 = EXP:MASTER:20
			BEFORE_MOUSOU_EXP21 = EXP:MASTER:21
			BEFORE_MOUSOU_EXP24 = EXP:MASTER:24
			BEFORE_MOUSOU_EXP25 = EXP:MASTER:25
			BEFORE_MOUSOU_EXP27 = EXP:MASTER:27
			BEFORE_MOUSOU_EXP28 = EXP:MASTER:28
			BEFORE_MOUSOU_EXP29 = EXP:MASTER:29
			BEFORE_MOUSOU_EXP53 = EXP:MASTER:53
		CASE 900
			TCVAR:194 = 4
			RETURN 0
		CASEELSE
			GOTO LOOP_MOUSOU
	ENDSELECT
ENDIF
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE460
CALL COM_ABLE460_NAS ; NAS: REPLACED
RETURN RESULT
;妄想実行判定
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:MASTER:現在位置 != CFLAG:MASTER:311
	RETURN 0
;SIF GLOBAL_COMABLE(460)
RETURN RESULT
SIF TFLAG:妄想中
	RETURN 0
;気力0では不可
SIF BASE:MASTER:気力 <= 0
	RETURN 0
;できるのは昼12時～夜0時
SIF TIME:0 > 0 && TIME:0 < 720
	RETURN 0
RETURN 1
