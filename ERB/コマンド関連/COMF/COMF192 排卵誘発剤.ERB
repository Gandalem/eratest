; Modular ERB: COMF/COMF192 排卵誘発剤.ERB
;-------------------------------------------------
;排卵誘発剤
;特殊コマンド
;-------------------------------------------------

@COM192
IF TCVAR:強制排卵
	PRINTL 이미 사용 중이다.
	RETURN -1
ENDIF
ITEM:排卵誘発剤 -= 1
TCVAR:強制排卵 = 180
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
ELSE
	;調教者が調合知識を持っていれば消費を抑えられる
	IF TALENT:PLAYER:調合知識
		DOWNBASE:体力 += 200
		DOWNBASE:気力 += 200
	ELSE
		DOWNBASE:体力 += 100
		DOWNBASE:気力 += 100
	ENDIF
	SOURCE:逸脱 = 1000
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
RETURN 1

@CAN_COM192(ARG)
;qol custom code, replaced
CALL CAN_COM192_TR(ARG)
RETURN RESULT
SKIPDISP ARG
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
IF FLAG:70 == 1 || CFLAG:イタズラ
ELSE
	A = 0
	S = 0
	;すべての命令に共通の要素を考慮
	;(従順が高いと命令に従いやすいなど)
	CALL COM_ORDER
	;ABL:欲望
	IF ABL:欲望
		SIF S
			PRINT  + 
		A += ABL:欲望 * 1
		PRINT 욕정
		PRINTV 'LV,ABL:欲望,'(,ABL:欲望 * 1,')
		S = 1
	ENDIF
	;ABL:Ｖ感覚
	IF ABL:Ｖ感覚
		SIF S
			PRINT  + 
		A += ABL:Ｖ感覚 * 2
		PRINT 감각
		PRINTV 'LV,ABL:Ｖ感覚,'(,ABL:Ｖ感覚 * 2,')
		S = 1
	ENDIF
	;ABL:精液中毒
	IF ABL:精液中毒
		SIF S
			PRINT  + 
		A += ABL:精液中毒 * 3
		PRINT 정액중독
		PRINTV 'LV,ABL:精液中毒,'(,ABL:精液中毒 * 3,')
		S = 1
	ENDIF
	IF MARK:快楽刻印
		SIF S
			PRINT  + 
		A += MARK:快楽刻印 * 1
		PRINT 쾌락의 낙인
		PRINTV 'LV,MARK:快楽刻印,'(,MARK:快楽刻印 * 1,')
		S = 1
	ENDIF
	;PALAM:欲情
	IF GETPALAMLV(PALAM:欲情,5)
		SIF S
			PRINT  + 
		A += GETPALAMLV(PALAM:欲情,5) * 1
		PRINT 욕정 레벨
		PRINTV 'LV,GETPALAMLV(PALAM:欲情,5),'(,GETPALAMLV(PALAM:欲情,5) * 1,')
		S = 1
	ENDIF
	;恥じらい
	IF TALENT:羞恥心 > 0
		PRINT  - 
		A -= 1
		PRINT 부끄러움
		PRINTV '(,1,')
		S = 1
	ENDIF
	;男嫌い（恋慕、親愛で無効）
	IF OTOKOGIRAI(TARGET)
		PRINT  - 
		A -= 12
		PRINT 인간 증오자
		PRINTV '(,12,')
		S = 1
	ENDIF
	;恋慕
	IF TALENT:恋慕 && ASSIPLAY == 0
		SIF S
			PRINT  + 
		A += 5
		PRINT 연모
		PRINTV '(,5,')
		S = 5
	ENDIF
	;愛欲
	IF TALENT:愛欲 && ASSIPLAY == 0
		SIF S
			PRINT  + 
		A += 5
		PRINT 욕망
		PRINTV '(,5,')
		S = 5
	ENDIF
	;親愛
	IF TALENT:恋慕 > 1 && ASSIPLAY == 0
		SIF S
			PRINT  + 
		A += 5
		PRINT 깊은 연모
		PRINTV '(,5,')
		S = 5
	ENDIF
	;生解禁
	IF CFLAG:生解禁 == 2
		SIF S
			PRINT  + 
		A += 5
		PRINT 아기 만들기 계약
		PRINTV '(,5,')
		S = 1
	ELSEIF SHIRAHU(TARGET) ;com custom code, only when conscious
		SIF S
			PRINT  - 
		A -= 200
		PRINT 아기 만들기 계약 없음
		PRINTV '(,200,')
		S = 1
	ENDIF
	;調教者がふたなり
	IF (TALENT:PLAYER:2 & 3) == 3
		SIF S
			PRINT  + 
		A += 8
		PRINT 포타나리
		PRINTV '(,8,')
		S = 1
	ENDIF
	;合計を表示(100以上で実行)
	PRINT  =
	PRINTV A
	V = 100
	SIF A < V
		PRINT  < 
	SIF A == V
		PRINT  =
	SIF A > V
		PRINT  > 
	PRINT 필요 값 
	PRINTV V
	WAIT
	SKIPDISP 0
	;実行できない
	SIF A < V
		RETURN 0
ENDIF
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE192
;排卵誘発剤実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(192)
	RETURN RESULT
;アイテムを持っていないとダメ
SIF ITEM:排卵誘発剤 == 0
	RETURN 0
;薬毒耐性だとダメ
SIF DrugAddict:TARGET:0 >= 6
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;SIF SHIRAHU(TARGET) && CFLAG:生解禁 != 2 ;com custom code
;	RETURN 0
SIF TCVAR:ピル > 0 || TCVAR:強制排卵 ;com custom code
	RETURN 0
SIF TALENT:妊娠 || !HAS_VAGINA(TARGET) ;bug fix, don't allow if already pregnant or isn't a female (anal pregnancy probably isn't going to be a thing ever)
	RETURN 0
RETURN 1
