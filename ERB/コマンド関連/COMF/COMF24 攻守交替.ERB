; Modular ERB: COMF/COMF24 攻守交替.ERB
;-------------------------------------------------
;攻守交替
;-------------------------------------------------

@COM24
CALL COM24_NAS
RETURN RESULT
VARSET LOCAL
CFLAG:MASTER:うふふ = 2
TFLAG:COMABLE管理 = 3
;bug fix custom code, revised the loop
FOR LOCAL,1,GET_TARGETNUM() + 1
SIF TARGET:LOCAL <= 0
	CONTINUE
SIF !SHIRAHU(TARGET:LOCAL)
	CONTINUE
SIF GETBIT(FLAG:潜伏, 0) && !GETBIT(CFLAG:(TARGET:LOCAL):潜伏状態, 0) ;concealment, only apply to the target
	CONTINUE
CFLAG:(TARGET:LOCAL):うふふ = 2
LOCAL:1 ++
NEXT
PRINTFORML 당신이 %CALLNAME:TARGET%%COND_STR(@" 및 다른 이들", LOCAL:1 > 1)%에게 주도권을 준다.
TIME += 5
RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE24
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(150)
	RETURN RESULT
SIF GETBIT(FLAG:潜伏, 0) ;don't let it happen in the concealment mode because it's glitchy and other characters join in anyway
	RETURN 0
;相手の欲情
;SIF GETPALAMLV(PALAM:欲情,10) < 5
;	RETURN 0
SIF TCVAR:無理矢理
	RETURN 0
;時間停止中も駄目
SIF !SHIRAHU(TARGET)
	RETURN 0
;なんか装着してるとダメ
FOR LOCAL,11,25
SIF TEQUIP:LOCAL
	RETURN 0
NEXT
;挿入中は駄目
SIF TEQUIP:50 != -1
	RETURN 0
SIF TEQUIP:51 != -1
	RETURN 0
;シャワー中はダメ
SIF TEQUIP:32
	RETURN 0
;乳首吸い中はダメ
SIF TEQUIP:41
	RETURN 0
;乳揉み中はダメ
SIF TEQUIP:42
	RETURN 0
;継続キス
SIF TEQUIP:継続キス
	RETURN 0
RETURN 1
