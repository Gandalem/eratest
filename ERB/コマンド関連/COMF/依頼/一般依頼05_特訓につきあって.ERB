; Modular ERB: COMF/依頼/一般依頼05_特訓につきあって.ERB
;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう

@EXIST_一般依頼5
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです

@一般依頼5(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "特訓につきあって")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%에게 특별한 단막(Danmaku) 훈련을 도와준다.")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"%金額表示(500)%")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, "Special Training!")
	CASE "依頼備考表示"
		CALLF MAKE_STR(V_NAME, "Let's move somewhere one can practice combat first")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
	CASE "依頼サブ"
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
	CASE "依頼発生率"
		;これは他の一般依頼との相対確率なんで10％ではありません
		CALLF MAKE_INT(V_NAME, 10)
	CASE "依頼発生条件"
		IF !CFLAG:ARG:神社在住 && !来訪可能(ARG) ;qol custom code, do not generate for characters who cannot visit player's home map
			;現状の人里では達成不能なため拠点が人里の場合は除外
		ELSEIF ABL:ARG:戦闘能力 <= ABL:MASTER:戦闘能力 && ABL:ARG:親密 >= 2 ;qol custom code, allow in human village, as danmaku can be done in the square
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "依頼受託可能条件"
		IF CFLAG:ARG:宴会参加
			;依頼発生条件で人里が除外できないようなのでこちらで除外
			;ELSEIF MAIN_MAP == 2 ;qol custom code, allow in human village
		ELSEIF GET_MAPID(CFLAG:ARG:現在位置) == MAIN_MAP ;qol custom code
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "依頼実行可能条件"
		SIF 戦闘訓練可(CFLAG:MASTER:現在位置)
			CALLF MAKE_INT(V_NAME, 1)
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		SIF Add_Request_Should_Discard(ARG) ;addition custom code
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般5(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  BAD_WEATHER
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
		;何か専用の表示情報を設けたい時用
		;受託済みの依頼表示で使用されます
		;
		;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
		;ここ以外の表示項目は
		;PRINTFORML 　　　　　：
		;となっているのでスペースを揃えたほうが見栄えが良いです
	CASE "依頼実行時"
		;このCASEに限り、RESULTが意味を持ちます
		;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
		;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
		;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		;
		;"依頼実行時"に限っていえば、CHARAはTARGETと同一であり、必ずしもCLIENT_IDと一致するとは限りません
		;個々のケースで確認する必要があります
		;この依頼は「作業」扱いであり、CLIENTがTARGETになっている時のみ実行できます
		;
		;天気を参照
		BAD_WEATHER = 0
		SELECTCASE TIME:5
			CASE 4, 6, 8, 10, 12, 13
				;悪天候
				BAD_WEATHER = 1
			CASE 5, 9
				;ヤバい天気
				BAD_WEATHER = 2
				;それ以外
			CASEELSE
				;夏場は死ねる
				SIF DAY:2 == 2 && TIME:5 == 1 && INRANGE(TIME, 361, 1019)
					BAD_WEATHER = 3
		ENDSELECT
		SIF !OUTROOF(CFLAG:MASTER:現在位置)
			BAD_WEATHER = 0
		PRINTFORMW 당신은 %조사처리(CALLNAME:TARGET,"가")% 단막 특별 훈련을 하는 것을 돕는다.
		SELECTCASE TIME:5
			CASE 4, 6
				PRINTL 비가 내리는 가운데 두 사람은 격투를 벌인다.
				PRINTW 정말 지친다...
			CASE 1
				IF BAD_WEATHER == 3
					PRINTL 매서운 태양 아래 두 사람은 지치지 않고 스파링을 한다.
					PRINTW 이대로라면 일사병은 피할 수 없을 것이다...
				ELSE
					PRINTW 구름 한 점 없는 광활한 푸른 하늘 아래, 두 사람은 훈련한다.
				ENDIF
			CASE 5
				PRINTL 폭우 속에서 두 사람은 지칠 줄 모르고 스파링을 한다.
				PRINTW 죽음을 넘어선 피로감이다...
			CASE 8, 10, 12, 13
				PRINTL 눈보라 한가운데에서 두 사람은 스파링을 한다.
				PRINTW 믿을 수 없이 지친다...
			CASE 9
				PRINTL 눈보라 한가운데서 두 사람은 지칠 줄 모르고 스파링을 한다.
				PRINTW 죽음의 경지를 넘어선 피로감이다...
			CASEELSE
				;		PRINTL 弾幕の訓練を行った
		ENDSELECT
		TCVAR:MASTER:空腹時刻 -= 15
		TCVAR:TARGET:空腹時刻 -= 15
		DOWNBASE:MASTER:体力 = 100 * (2 + BAD_WEATHER)
		DOWNBASE:MASTER:気力 = 100 * (2 + BAD_WEATHER)
		DOWNBASE:体力 = 50 * (2 + BAD_WEATHER)
		DOWNBASE:気力 = 50 * (2 + BAD_WEATHER)
		SOURCE:歓楽 = 600 + 100 * (1 + BAD_WEATHER)
		TIME += 60
		EXP:MASTER:戦闘経験 += 1 + ABL:戦闘能力
		EXP:戦闘経験 += MAX(ABL:戦闘能力 - ABL:MASTER:戦闘能力 + 1, 1) * 3 + BAD_WEATHER
		IF ITEM:戦術指南書
			EXP:MASTER:戦闘経験 ++
			EXP:TARGET:戦闘経験 ++
			CALL LS_BOOK_BONUS(101) ;Custom code, add experience during Lunatic Survival.
			CALL LS_BOOK_BONUS(101,TARGET)
		ENDIF
		IF ITEM:スポーツドリンク >= 2
			IF BAD_WEATHER == 3
				DOWNBASE:MASTER:体力 -= 200
				DOWNBASE:MASTER:気力 -= 300
				DOWNBASE:体力 -= 70
				DOWNBASE:気力 -= 100
			ELSE
				DOWNBASE:MASTER:体力 -= 50
				DOWNBASE:MASTER:気力 -= 50
				DOWNBASE:体力 -= 20
				DOWNBASE:気力 -= 20
			ENDIF
			SOURCE:歓楽 += 1000
			PRINTL 두 분은 연습이 끝난 후 스포츠 음료를 마신다.
			PRINTW 그 액체가 지친 몸속으로 스며드는 듯하다...
			CALL LOST_ITEM("スポーツドリンク", 2, 2) ;custom code
			;元の構文だと消費は1個っぽいが2個に
		ENDIF
		CALL Add_PhysImprov(TARGET, BAD_WEATHER) ;addition custom code
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		;成功報告時の報酬など
		CALL CHANGE_CFLAG(2, TARGET, 30)
		CALL CHANGE_CFLAG(4, TARGET, 20)
		CALL GET_MONEY_YEN(500, 2)
	CASE "依頼失敗時"
		;失敗報告時の処理
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -10)
ENDSELECT
