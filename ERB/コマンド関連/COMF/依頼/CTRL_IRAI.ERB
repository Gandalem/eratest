;----------------------------------------------------------------------------------------------------
;依頼情報表示関数
;依頼ID単体でも使用できるが受託済みの場合は簡略化のためにSLOT番号を渡す
;フルネーム表記なのはわざとです（そのほうがお硬い文面っぽく見えるので）
;----------------------------------------------------------------------------------------------------

@SHOW_IRAI_DATA(IRAI_ID, CHK_SLOT)
#DIM IRAI_ID   ;対象の依頼ID（依頼人情報含む）
#DIM CHK_SLOT  ;判定対象とする依頼スロット、未受託の状態では0で読んで下さい
#DIM CLIENT_ID ;依頼人ID
#DIM CHK_ID    ;依頼自体のID
#DIM DEAD_LINE ;期限日数
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_ID    = IRAI_ID % 1000
DEAD_LINE = INT_DATA_IRAI(IRAI_ID, "依頼期限", CLIENT_ID)
SIF CHK_SLOT
	PRINTFORML %TOFULL(TOSTR(CHK_SLOT))% 요청함
PRINTFORML 　＜%REQUEST_NAMES_TR(STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID))%＞
PRINTFORML %"Client:", 20, RIGHT% %NAME:CLIENT_ID%
PRINTFORML %"Objective:", 20, RIGHT% %STR_DATA_IRAI(IRAI_ID, "依頼内容表示", CLIENT_ID)%
PRINTFORML %"Reward:", 20, RIGHT% %STR_DATA_IRAI(IRAI_ID, "依頼報酬表示", CLIENT_ID)%
SIF STRLENS(STR_DATA_IRAI(IRAI_ID, "依頼報告不要", CLIENT_ID))
	PRINTFORML %"Report:", 20, RIGHT% %STR_DATA_IRAI(IRAI_ID, "依頼報告不要", CLIENT_ID)%
SIF STRLENS(STR_DATA_IRAI(IRAI_ID, "依頼備考表示", CLIENT_ID))
	PRINTFORML %"Note:", 20, RIGHT% %STR_DATA_IRAI(IRAI_ID, "依頼備考表示", CLIENT_ID)%
;#;PRINTFORML %"Request ID:", 20, RIGHT% {IRAI_ID}　CLIENT_ID{CLIENT_ID}
;未受託の場合は期限のみ表示しておしまい
IF !CHK_SLOT
	SELECTCASE DEAD_LINE
		CASE IS >= YearLength
			PRINTFORML %"Deadline:", 20, RIGHT% %PRINT_DATE_F(DAY+DEAD_LINE,1)% (%PRINT_PLUR("year", DEAD_LINE/YearLength)% (%PRINT_PLUR("day", DEAD_LINE)%))
		CASE IS >= 31
			PRINTFORML %"Deadline:", 20, RIGHT% %PRINT_DATE_F(DAY+DEAD_LINE,1)% (%PRINT_PLUR("month", DEAD_LINE/31)% (%PRINT_PLUR("day", DEAD_LINE)%))
		CASE IS > 0
			PRINTFORML %"Deadline:", 20, RIGHT% %PRINT_DATE_F(DAY+DEAD_LINE,1)% (%PRINT_PLUR("day", DEAD_LINE)%)
		CASE 0
			PRINTFORML %"Deadline:", 20, RIGHT% 오늘
	ENDSELECT
	RETURN
ELSE
	;PRINTFORML %"Deadline:", 20, RIGHT% After {IRAI_DEADLINE:CHK_SLOT - DAY} days
ENDIF
IF !INRANGE(IRAI_SLOT_TO_PERSON(CHK_SLOT),0,CHARANUM-1)
	PRINTFORML %"Objective:", 20, RIGHT% 상실...
	GOTO CarryOut
ENDIF
;ここから受託済み、業種別の表示
SELECTCASE IRAI_SLOT_TO_TASKNAME(CHK_SLOT)
	CASE "調達"
		PRINTFORML %"Required Item:", 20, RIGHT% %ITEMNAME_TR(IRAI_SLOT_TO_ITEM(CHK_SLOT))%×{IRAI_SUB:CHK_SLOT}
		SIF ITEMNAME:IRAI_SLOT_TO_ITEM(CHK_SLOT) == "うまい魚"
			PRINTFORML 　　　　　(무지개송어·연어·와카사기·뱀장어·북부뱀머리돔)
	CASE "伝令（人物）"
		PRINTFORML %"Target Character:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%
	CASE "伝令（場所）"
		;qol custom code, add map
		PRINTFORML %"Destination:", 20, RIGHT% %COND_STR(@"%GET_MAPNAME(GET_MAPID(IRAI_SLOT_TO_PLACE(CHK_SLOT)))% - ", !IN_HOME(IRAI_SLOT_TO_PLACE(CHK_SLOT)))%%THE_CASE_SHIFT(GET_PLACENAME(IRAI_SLOT_TO_PLACE(CHK_SLOT)))%
		;ナズーリンに聞いても忘れるあなた(わたし)へ
	CASE "捜索（人物）"
		IF IRAI_EX:CHK_SLOT
			PRINTFORML %"Key Person:", 20, RIGHT% %ALTNAME_OR_CALLNAME(IRAI_SLOT_TO_PERSON(CHK_SLOT))%
		ELSE
			PRINTFORM %"Hint:", 20, RIGHT% 
			CALL SHOW_IRAI_HINT("捜索（人物）", IRAI_SLOT_TO_PERSON(CHK_SLOT), IRAI_SUB:CHK_SLOT)
		ENDIF
	CASE "捜索（場所）"
		IF IRAI_EX:CHK_SLOT > 5000
			PRINTFORML %"Estimated Position:", 20, RIGHT% %STR_TR(5000 + GET_MAPID(IRAI_EX:CHK_SLOT-5000))%
		ELSEIF IRAI_EX:CHK_SLOT
			PRINTFORML %"Estimated Position:", 20, RIGHT% %STR_TR(5000 + GET_MAPID(IRAI_EX:CHK_SLOT))% - %GET_PLACENAME(IRAI_EX:CHK_SLOT)%
		ELSE
			PRINTFORM %"Hint:", 20, RIGHT% 
			CALL SHOW_IRAI_HINT("捜索（場所）", IRAI_SLOT_TO_PLACE(CHK_SLOT), IRAI_SUB:CHK_SLOT)
		ENDIF
	CASE "討伐"
		PRINTFORML %"Subjugation Target:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%
	CASE "faction hitman" ;NAS factions
		PRINTFORML %"Hit Target:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))% (%FactionName(DT_CELL_GET("FactionUnits",IRAI_SUB:CHK_SLOT,"faction",1))%)
	CASE "bandit camp"
		PRINTFORML %"Place:", 20, RIGHT% %COND_STR(@"%GET_MAPNAME(GET_MAPID(IRAI_SLOT_TO_PLACE(CHK_SLOT)))% - ", !IN_HOME(IRAI_SLOT_TO_PLACE(CHK_SLOT)))%%THE_CASE_SHIFT(GET_PLACENAME(IRAI_SLOT_TO_PLACE(CHK_SLOT)))%
		PRINTFORML %"Faction:", 20, RIGHT% %FactionName(IRAI_SUB:CHK_SLOT)%
	CASE "downed refugee"
		PRINTFORML %"Rescue Target:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))% (%FactionName(TALENT:CLIENT_ID:Recruiter-1)%)
		PRINTFORML %"Place:", 20, RIGHT% %COND_STR(@"%GET_MAPNAME(GET_MAPID(IRAI_SUB:(CHK_SLOT)))% - ", !IN_HOME(IRAI_SUB:(CHK_SLOT)))%%THE_CASE_SHIFT(GET_PLACENAME(IRAI_SUB:(CHK_SLOT)))%
		SIF IRAI_EX:CHK_SLOT > -1
			PRINTFORML %"Hostile Faction:", 20, RIGHT% %FactionName(IRAI_EX:CHK_SLOT)%
	CASE "prank" ;addition custom code
		PRINTFORML %"Prank Target:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%
	CASE "meeting" ;addition custom code
		PRINTFORML %"Meeting Target:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%
	CASE "person" ;addition custom code
		PRINTFORML %"Target:", 20, RIGHT% %NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%
	CASE "food" ;addition custom code
		IF IRAI_DATA:CHK_SLOT % 1000 == 93
			CALL FOOD_NAME(IRAI_DATA:CHK_SLOT / 1000)
			PRINTFORML %"Dish:", 20, RIGHT% %DISHNAME_TR(RESULTS)%
		ENDIF
ENDSELECT
$CarryOut
CALL IRAI_CARRYOUT(CLIENT_ID, IRAI_ID, "依頼条件表示")
;確定してる場合はその旨を表示しておしまい
IF GROUPMATCH(IRAI_CHARA_TO_PROGRESS(CLIENT_ID), "期限切れ", "報告忘れ", "依頼失敗")
	PRINTFORML %"Request status:", 20, RIGHT% 실패했다
	RETURN
ELSEIF GROUPMATCH(IRAI_CHARA_TO_PROGRESS(CLIENT_ID), "依頼達成")
	PRINTFORML %"Request status:", 20, RIGHT% 완료됨 (전달되지 않음)
	;Custom code formatting (all below)
	;RETURN
ENDIF
IF DAY == IRAI_DEADLINE:CHK_SLOT || IRAI_DEADLINE:CHK_SLOT - DAY <= 0
	PRINTFORML %"Deadline:", 20, RIGHT% 오늘
ELSEIF IRAI_DEADLINE:CHK_SLOT > DAY
	PRINTFORML %"Deadline:", 20, RIGHT% %PRINT_DATE_F(IRAI_DEADLINE:CHK_SLOT - DAY,1)% (%PRINT_PLUR("Day", IRAI_DEADLINE:CHK_SLOT - DAY)%)
ELSE
	PRINTFORML %"Deadline:", 20, RIGHT% 오늘
ENDIF
;----------------------------------------------------------------------------------------------------
;依頼情報内のヒント表示
;DYNAMIC部分はSHOW_TASTEを参考,助手効果のデータだけを抽出する
;----------------------------------------------------------------------------------------------------

@SHOW_IRAI_HINT(TASKNAME, ARG, パターン)
#DIMS TASKNAME
#DIM CHARA
#DIM PLACE
#DIM パターン
#DIM 洞察力
#DIMS DYNAMIC LIST, 100 ;リスト
#DIM  DYNAMIC CNT,  100 ;リスト各要素の重複個数
#DIM  DYNAMIC NUM       ;種類の総数
;◆洞察力に関して
;元々はEXP:依頼達成経験とABL:依頼こなしレベルを設定して、依頼をこなすほど洞察力(=依頼レベル)が増えるという風にしようと思っていた
;が、わざわざ作らなくてもプレイヤー側のリアル洞察力の方が必要なので凍結させました。
