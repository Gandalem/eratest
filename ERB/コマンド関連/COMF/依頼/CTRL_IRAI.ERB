@MEMO_IRAI_DEADLINE
#DIM CLIENT
;受託済み依頼の期限の処理
FOR LOCAL,1, 6
SIF !IRAI_SLOT:LOCAL
	CONTINUE
CLIENT = IRAI_SLOT_TO_CLIENT(LOCAL)
;nas custom anti-retard code
IF !INRANGE(CLIENT,0,CHARANUM-1)
	PRINTFORML 클라이언트 ID {CLIENT}에 대한 요청은 해당 캐릭터가 존재하지 않아 무효 처리되며 제거될 것이다.
	CALL CLEAR_IRAI_SLOT(MASTER,LOCAL,"")
	CONTINUE
ENDIF
SIF GROUPMATCH(IRAI_CHARA_TO_PROGRESS(CLIENT), "依頼中", "依頼達成", "依頼失敗")
	PRINTFORML %CALLNAME:CLIENT%의 요청은 만료된다 \@ IRAI_DEADLINE:LOCAL - DAY == 0 ? 오늘! # {IRAI_DEADLINE:LOCAL - DAY}일 후에. \@
NEXT
