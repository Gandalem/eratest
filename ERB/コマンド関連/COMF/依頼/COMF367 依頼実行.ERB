; Modular ERB: COMF/依頼/COMF367 依頼実行.ERB
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE367
SIF !TFLAG:100
	RETURN 0
SIF !SEARCH_ACTIVE_IRAI_SLOT()
	RETURN 0
SIF IRAI_SLOT_TO_TASKNAME(SEARCH_ACTIVE_IRAI_SLOT()) == "meeting" && !(IS_HERE(IRAI_SLOT_TO_CLIENT(SEARCH_ACTIVE_IRAI_SLOT())) || IS_HERE(IRAI_SLOT_TO_PERSON(SEARCH_ACTIVE_IRAI_SLOT()))) ;qol custom code, unique handling for meetings
	RETURN 0
SIF GROUPMATCH(IRAI_SLOT_TO_TASKNAME(SEARCH_ACTIVE_IRAI_SLOT()), "伝令（人物）", "捜索（人物）", "討伐", "person", "その他") && CFLAG:IRAI_SLOT_TO_PERSON(SEARCH_ACTIVE_IRAI_SLOT()):現在位置 == SUKIMA() ;qol custom code, disallow to do it on the spot, but still lets you do it when you visit someone's room
	RETURN 0
RETURN 1

@COM367
#DIM CHK_SLOT
CHK_SLOT  = SEARCH_ACTIVE_IRAI_SLOT()
CALL IRAI_APPLY(CHK_SLOT)
RETURN RESULT
;-------------------------------------------------
;依頼実行処理をスロット指定にした
;かならずCAN_IRAI_SLOT_DO(CHK_SLOT)を噛ませてから実行しないと素通しになります
;@COM367はSEARCH_ACTIVE_IRAI_SLOT()で判定済みなのでよし
;-------------------------------------------------

@IRAI_APPLY(CHK_SLOT, MEETING_POINT) ;addition custom code, added MEETING_POINT
#DIM CHK_SLOT
#DIM IRAI_RESULT
#DIM CLIENT_ID
#DIM MEETING_POINT
CLIENT_ID = IRAI_SLOT_TO_CLIENT(CHK_SLOT)
;addition custom code
IF MEETING_POINT
	CALL IRAI_CARRYOUT(CLIENT_ID, IRAI_SLOT:CHK_SLOT, "依頼実行時_MEETINGPOINT")
ELSE
	CALL SHOW_IRAI_MESSAGE(TARGET, IRAI_SLOT:CHK_SLOT, "依頼実行直前")
	CALL IRAI_CARRYOUT(TARGET, IRAI_SLOT:CHK_SLOT, "依頼実行時")
ENDIF
IRAI_RESULT = RESULT
;ここで設定しないと実行直後のメッセージで成功失敗の判別がつかないので仕方なく
SELECTCASE IRAI_RESULT
	CASE IRAI_CONST_RESULT("キャンセル")
		;ここは-1が返る
		;これ以外は実行処理が行われたはずなので全て1以上を返す
		RETURN IRAI_RESULT
	CASE IRAI_CONST_RESULT("実行して成功")
		CALL SET_IRAI_PROGRESS(CLIENT_ID, "依頼達成")
	CASE IRAI_CONST_RESULT("実行して失敗")
		CALL SET_IRAI_PROGRESS(CLIENT_ID, "依頼失敗")
	CASE IRAI_CONST_RESULT("実行して未解決")
ENDSELECT
SIF !MEETING_POINT ;qol custom code
	CALL SHOW_IRAI_MESSAGE(TARGET, IRAI_SLOT:CHK_SLOT, "依頼実行直後")
;とりあえず時間経過
SIF !FLAG:70
	TIME += 5
;成否が未解決ならスルー
IF !GROUPMATCH(IRAI_RESULT, IRAI_CONST_RESULT("実行して成功"), IRAI_CONST_RESULT("実行して失敗"))
	;成否が確定し、TARGETが依頼者である
ELSEIF TARGET == CLIENT_ID
	CALL COM366
ELSEIF GROUPMATCH(IRAI_SLOT_TO_TASKNAME(CHK_SLOT), "prank", "meeting") ;addition custom code: instantly resolve fairy pranks, meetings, as request giver is implied to be present
	LOCAL:1 = TARGET ;temp storage
	TARGET = CLIENT_ID
	CALL COM366
	TARGET = LOCAL:1
	;成否が確定し、TARGETが依頼者でない
ELSE
	;依頼完了(報告しないと失敗扱い)
	PRINTFORMW %CALLNAME:CLIENT_ID%에게 보고하는 것을 잊지 마라.
	;addition custom code, allow extra report day for characters without a home
	SIF IRAI_DEADLINE:CHK_SLOT - DAY <= 0 && !CFLAG:CLIENT_ID:自宅位置
		IRAI_DEADLINE:CHK_SLOT = DAY + 1
ENDIF
RETURN 1
