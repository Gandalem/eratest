; Modular ERB: COMF/依頼/一般依頼14_薪を切らしてる.ERB
;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
;logging patch custom code, reenabled

@EXIST_一般依頼14
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです

@一般依頼14(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "薪を切らしてる")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, @"나를 위해 나무 좀 베어주세요")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"저렴한 재료 3가지")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, "Hand Over 5 Pieces Of Timber")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(GETNUM(ITEM, "木材"), "調達"))
	CASE "依頼サブ"
		CALLF MAKE_INT(V_NAME, 5) ;bugfix custom code
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
		CALLF MAKE_INT(V_NAME, 5)
	CASE "依頼発生率"
		IF DAY:2 == 4
			;冬は発生しやすい
			CALLF MAKE_INT(V_NAME, 6) ;logging custom tweak
		ELSE
			CALLF MAKE_INT(V_NAME, 2) ;logging custom tweak
		ENDIF
	CASE "依頼発生条件"
		IF DAY:2 == 4 && GROUPMATCH(ARG, [[チルノ]], [[レティ]]) ;logging custom tweak
		ELSEIF nRequestDisable:req_Logging ;custom, moved from 依頼受託可能条件 to prevent creation of request altogether, instead of only prohibiting the player from accepting it
		ELSE
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "依頼受託可能条件"
		;木材を持ってる
		;SIF ITEM:木材 ;disabled, caught by 依頼発生条件
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		SIF ITEM:木材 >= 5
			CALLF MAKE_INT(V_NAME, 1)
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		SIF nRequestDisable:req_Logging || Add_Request_Should_Discard(ARG) ;addition custom code
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
	CASE "MEETINGPOINT_ALLOWED" ;addition custom code
		SIF ITEM:木材 >= 5
			CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般14(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
		;何か専用の表示情報を設けたい時用
		;受託済みの依頼表示で使用されます
		;
		;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
		;ここ以外の表示項目は
		;PRINTFORML 　　　　　：
		;となっているのでスペースを揃えたほうが見栄えが良いです
	CASE "依頼実行時"
		;このCASEに限り、RESULTが意味を持ちます
		;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
		;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
		;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		PRINTFORML 당신은 그 목재를 %조사처리(CALLNAME:TARGET,"에게")% 준다.
		IF DAY:2 == 4
			;冬はメッセージあり
			PRINTFORML %HE_SHE(TARGET,1)%는 %HE_SHE(TARGET)%가 마침내 모든 혹독한 추위에서 벗어날 수 있게 되어 기쁘다.
			SOURCE:TARGET:歓楽 += 2000
		ELSE
			PRINTFORML 
			SOURCE:TARGET:歓楽 += 1000
		ENDIF
		CALL LOST_ITEM("木材", 5, 2)
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼実行時_MEETINGPOINT"
		PRINTFORML 당신은 %CALLNAME:CLIENT_ID%에게 목재 배달을 설정한다.
		CALL LOST_ITEM("木材", 5, 2)
		CALL PAY_MONEY_YEN(500, 2)
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		;成功報告時の報酬など
		CALL CHANGE_CFLAG(2, TARGET, 30)
		CALL CHANGE_CFLAG(4, TARGET, 20)
		TALENT:機嫌 = LIMIT(TALENT:機嫌 + 1, -1, 1)
		CALL GET_ITEM("安物食材", 3, 2)
	CASE "依頼失敗時"
		;失敗報告時の処理
		CALL CHANGE_CFLAG(2, TARGET, -5)
		CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT
