@一般依頼15(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		IF TALENT:ARG:SexKnow == -1
			SELECTCASE RAND:2
				CASE 0
					CALLF MAKE_STR(V_NAME, "My heart is throbbing")
				CASE 1
					CALLF MAKE_STR(V_NAME, "My crotch feels funny")
			ENDSELECT
		ELSEIF TALENT:ARG:マゾ
			SELECTCASE RAND:2
				CASE 0
					CALLF MAKE_STR(V_NAME, @"I want you to violate me")
				CASE 1
					CALLF MAKE_STR(V_NAME, @"I want you to mess me up")
			ENDSELECT
		ELSEIF TALENT:ARG:恋人 ;addition custom code
			CALLF MAKE_STR(V_NAME, @"Let's make love")
		ELSE
			CALLF MAKE_STR(V_NAME, @"Have sex with me")
		ENDIF
	CASE "依頼内容表示"
		IF TALENT:ARG:SexKnow == -1
			CALLF MAKE_STR(V_NAME, "무언가를 한다")
		ELSEIF TALENT:ARG:マゾ
			CALLF MAKE_STR(V_NAME, "나를 마음껏 괴롭혀 봐")
		ELSEIF TALENT:ARG:恋人 ;addition custom code
			CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%의 소원을 들어준다.")
		ELSE
			CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%의 스트레스를 풀어준다")
		ENDIF
	CASE "依頼報酬表示"
		IF TALENT:ARG:SexKnow == -1
			CALLF MAKE_STR(V_NAME, "잔돈")
		ELSEIF TALENT:ARG:恋人 ;addition custom code
			CALLF MAKE_STR(V_NAME, "즐거운 시간")
		ELSE
			;性技術を売ると考えたら技巧*5000円とかのがいいのかも？
			CALLF MAKE_STR(V_NAME, @"%金額表示(20000)% (호텔비 제외)")
		ENDIF
	CASE "依頼実行コマンド名"
		IF TALENT:ARG:SexKnow == -1
			CALLF MAKE_STR(V_NAME, "Help Out")
		ELSEIF TALENT:ARG:マゾ
			CALLF MAKE_STR(V_NAME, @"Violate %CALLNAME:ARG%")
		ELSEIF TALENT:ARG:恋人 ;addition custom code
			CALLF MAKE_STR(V_NAME, @"Have lovey-dovey sex with %CALLNAME:ARG%")
		ELSE
			CALLF MAKE_STR(V_NAME, @"Have Sex With %CALLNAME:ARG%")
		ENDIF
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
	CASE "依頼サブ"
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
	CASE "依頼発生率"
		;初期設定でヤリマン幻想郷にした場合は依頼発生頻度高すぎると阿鼻叫喚になりそうだからヤリマンの場合は確率低下
		;かわりに溜まってる度に関わらず発生するようにしてバランスが取れるといいなぁ
		IF TALENT:ARG:ヤリマン
			CALLF MAKE_INT(V_NAME, 4)
		ELSEIF TALENT:ARG:プライド == 1 || TALENT:ARG:羞恥心 == 1
			;プライドが高かったり恥じらいを持ってるキャラは言い出しづらいだろうから確率低下
			;CALLF MAKE_INT(V_NAME, 9)
			CALLF MAKE_INT(V_NAME, 50)
		ELSE
			;それ以外は発生条件が厳しめなので基本の発生率はとりあえず高めに
			;CALLF MAKE_INT(V_NAME, 15)
			CALLF MAKE_INT(V_NAME, 70)
		ENDIF
	CASE "依頼発生条件"
		;セフレor愛欲かつ溜まってる度500以上 or ヤリマン
		;debug
		;SIF TALENT:ARG:処女
		;addition custom code, make it available for lovers and for girls in heat who don't mind dicking & futa/male PC and girls only (due to event text and mechanics, you're welcome to expand)
		SIF HAS_PENIS(MASTER) && (CFLAG:TARGET:溜まってる度 > 500 || TALENT:ARG:ヤリマン)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		CALLF MAKE_INT(V_NAME, 1)
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		;依頼以外の要因で溜まってる度が解消された場合消えるべきなのかもしれないけど文法とかよくわかんないので雑にスルー
		;addition custom code, erase for all characters who only qualified because of the pink wind (also check for current heat so first batch isn't immediately erased)
		SIF (!TALENT:ARG:セフレ && !TALENT:ARG:愛欲 && !TALENT:ARG:ヤリマン && !TALENT:ARG:恋人 && !TCVAR:ARG:発情) || Add_Request_Should_Discard(ARG)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般15(CHARA, IRAI_ID, SCENE)
