		;
		;以下デフォルト地の文
		CALL SET_KOJO_COLOR(CLIENT_ID) ;custom code
		;qol custom code, permit custom scenarios
		RESULT:100 = 0
		CALL KOJO_MESSAGE_SEND("IRAI", TARGET, IRAI_ID, 0, 0, "TARGET", "UNIQUE_SCENARIO_CHANCE")
		IF RESULT:100 > RAND:100
			CALL KOJO_MESSAGE_SEND("IRAI", TARGET, IRAI_ID, 0, 0, "TARGET", "UNIQUE_SCENARIO")
			GOTO SEXEND
		ENDIF
