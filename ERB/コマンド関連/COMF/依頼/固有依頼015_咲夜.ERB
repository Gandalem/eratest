; Modular ERB: COMF/依頼/固有依頼015_咲夜.ERB

@固有依頼15(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
	;ID101：美鈴に差し入れ
	CASE 101
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "美鈴に差し入れ")
			CASE "依頼内容表示"
				CALLF MAKE_STR(V_NAME, "메이링에게 식량을 전달한다.")
			CASE "依頼報酬表示"
				CALLF MAKE_STR(V_NAME, @"%金額表示(1000)%")
			CASE "依頼報告不要"
				CALLF MAKE_STR(V_NAME, "No report needed (report needed to get the reward)")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, "Deliver Provisions")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA([[美鈴]], "伝令（人物）"))
			CASE "依頼サブ"
			CASE "依頼期限"
			CASE "依頼発生率"
				;これは他の固有依頼との相対確率なんで10％ではありません
				CALLF MAKE_INT(V_NAME, 10)
			CASE "依頼発生条件"
				SIF CAN_MEET([[美鈴]])
					CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼受託可能条件"
				;受託可能は@COM_ABLE366も確認のこと
				;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
				;should remove request if it can't be completed at the time of generation
				IF !IS_WEEKDAY(DAY)
				ELSEIF !INRANGE(TIME / 60, 7, 11)
				ELSEIF GET_MAPID(CFLAG:[[咲夜]]:現在位置) != 3 ;not in sdm
				ELSE
					CALLF MAKE_INT(V_NAME, 1)
				ENDIF
			CASE "依頼実行可能条件"
				;実行可能は@COM_ABLE367も確認のこと
				;revert code - lets you complete the request no matter what for meiling
				CALLF MAKE_INT(V_NAME, 1)
				;成功/失敗処理はCARRYOUTで直接書く
				;SOURCEやITEM入手など、内容が複雑なので
			CASE "依頼消滅条件"
				;30％で消失
				SIF Add_Request_Should_Discard(ARG) ;addition custom code
					CALLF MAKE_INT(V_NAME, 1)
		ENDSELECT
ENDSELECT
;固有依頼の設定用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各キャラのメッセージは別所にて

@IRAI_固有15(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
	;個々の依頼名で分岐
	CASE "美鈴に差し入れ"
		SELECTCASE SCENE
			CASE "依頼条件表示"
				;何か専用の表示情報を設けたい時用
				;受託済みの依頼表示で使用されます
				;
				;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
				;ここ以外の表示項目は
				;PRINTFORML 　　　　　：
				;となっているのでスペースを揃えたほうが見栄えが良いです
			CASE "依頼実行時"
				;このCASEに限り、RESULTが意味を持ちます
				;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
				;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
				;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
				SOURCE:歓楽 = 500
				PRINTFORMW 당신은 %CALLNAME:15%가 만든 물품을 %조사처리(CALLNAME:TARGET,"에게")% 전달한다.
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 그것을 받게 되어 기뻐한다.
				PRINTL
				CALL CHANGE_CFLAG(2, TARGET, 30)
				CALL CHANGE_CFLAG(4, TARGET, 15)
				TALENT:機嫌 = LIMIT(TALENT:機嫌 + 1, -1, 1)
				RETURN IRAI_CONST_RESULT("実行して成功")
			CASE "依頼成功時"
				;成功報告時の報酬など
				CALL CHANGE_CFLAG(2, TARGET, 20)
				CALL CHANGE_CFLAG(4, TARGET, 10)
				CALL GET_MONEY_YEN(1000, 2)
			CASE "依頼報告不要"
				;達成後に報告をしなかった場合、多少減らす
				PRINTFORML 방에서 요청을 완료한 것에 대한 감사로 %金額表示(1000)%으로부터 %CALLNAME:CHARA%이 적힌 편지를 받았다.
				CALL GET_MONEY_YEN(1000, 1)
				CALL CHANGE_CFLAG(2, CHARA, 15)
				CALL CHANGE_CFLAG(4, CHARA, 7)
			CASE "依頼失敗時"
				;失敗報告時の処理
		ENDSELECT
ENDSELECT
