; Modular ERB: COMF/依頼/一般依頼06_誰か教えて！.ERB
;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう

@EXIST_一般依頼6
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです

@一般依頼6(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "誰か教えて！")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%의 질문에 답한다")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"%金額表示(500)%")
	CASE "依頼実行コマンド名"
		IF IS_LIBRARY(CFLAG:MASTER:現在位置)
			CALLF MAKE_STR(V_NAME, "Study")
		ELSE
			CALLF MAKE_STR(V_NAME, "Answer The Question")
		ENDIF
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "その他"))
	CASE "依頼サブ"
		CALLF MAKE_INT(V_NAME, (ABL:ARG:教養 + RAND(1, 10)) * 10)
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
	CASE "依頼発生率"
		;これは他の一般依頼との相対確率なんで10％ではありません
		CALLF MAKE_INT(V_NAME, 10)
	CASE "依頼発生条件"
		SIF ABL:ARG:教養 <= ABL:MASTER:教養
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		;しらべものはいつでも
		IF FLAG:70
		ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
			CALLF MAKE_INT(V_NAME, 1)
			;教えるのはCLIENTをTARGETにする必要がある
		ELSEIF TARGET == ARG && SHIRAHU(ARG)
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		SIF Add_Request_Should_Discard(ARG) ;addition custom code
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般6(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  LIBRARY_ID
#DIMS LIBRARY_NAME
#DIM  CHK_SLOT
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
		PRINTFORML       이해: %IRAI_一般6_DIFFICULTY(CHK_SLOT)%
		;何か専用の表示情報を設けたい時用
		;受託済みの依頼表示で使用されます
		;
		;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
		;ここ以外の表示項目は
		;PRINTFORML 　　　　　：
		;となっているのでスペースを揃えたほうが見栄えが良いです
	CASE "依頼実行時"
		;依頼実行時にはRESULTが意味を持ちます
		;このCASEに限り、RESULTが意味を持ちます
		;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
		;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
		;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		LIBRARY_ID = IS_LIBRARY(CFLAG:MASTER:現在位置)
		IF LIBRARY_ID
			IF INRANGE(LIBRARY_ID, 1, 99)
				;Custom code
				LIBRARY_NAME '= @"%LOC_THE(LIBRARY_ID)%%STR_TR(LIBRARY_ID)%"
			ELSE
				;Custom code
				LIBRARY_NAME '= @"%LOC_THE(LIBRARY_ID)%%STR_TR(8000 + LIBRARY_ID)%"
			ENDIF
			IF TARGET == CLIENT_ID
				PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 문제에 대한 답을 찾기 위해 당신은 %LIBRARY_NAME%를 방문한다.
				PRINTFORML 이곳에서 좋은 자료를 찾을 가능성이 있을 것이다.
				CALL ASK_M("포기한다", 1, "연구한다", 1, "대답을 해라", 1)
				SELECTCASE RESULT
					CASE 0
						RETURN IRAI_CONST_RESULT("キャンセル")
					CASE 1
						PRINTFORMW 당신과 %조사처리(CALLNAME:TARGET,"는")%(는) %LIBRARY_NAME%에서 공부한다.
						EXP:MASTER:学習経験 ++
						EXP:TARGET:学習経験 ++
						IRAI_SUB:CHK_SLOT -= ABL:MASTER:教養 + ABL:TARGET:教養 + 5
						IRAI_SUB:CHK_SLOT = MAX(IRAI_SUB:CHK_SLOT, 1)
						TIME += 30
					CASE 2
						GOTO ANSWER
				ENDSELECT
			ELSE
				PRINTFORML 당신은 %LIBRARY_NAME%에서 공부한다.
				EXP:MASTER:学習経験 ++
				IRAI_SUB:CHK_SLOT -= ABL:MASTER:教養 + 3
				IRAI_SUB:CHK_SLOT = MAX(IRAI_SUB:CHK_SLOT, 1)
			ENDIF
			PRINTFORML 현재 당신의 이해:
			PRINTFORMW 　%IRAI_一般6_DIFFICULTY(CHK_SLOT)%
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ELSE
			$ANSWER
			PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 문제에 답을 준다.
			IF IRAI_一般6_SUCCESS(CHK_SLOT)
				PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 문제가 해결되었다!
				SOURCE:歓楽 = 300
				;addition custom code - grant at least 1 exp even when asked by the likes of cirno
				EXP:MASTER:学習経験 += MAX(ABL:TARGET:教養 * 5, 1)
				EXP:TARGET:学習経験 += MAX(ABL:TARGET:教養 * 5, 1)
				IF ITEM:103
					EXP:MASTER:学習経験 ++
					EXP:TARGET:学習経験 ++
					CALL LS_BOOK_BONUS(103) ;Custom code, add experience during Lunatic Survival.
					CALL LS_BOOK_BONUS(103,TARGET)
				ENDIF
				DOWNBASE:MASTER:体力 = 70
				DOWNBASE:MASTER:気力 = 100
				DOWNBASE:体力 = 50
				DOWNBASE:気力 = 70
				TIME += ABL:TARGET:教養 * 5 ;addition custom code, scale time taken by target's knowledge, from 0 to 30+
				RETURN IRAI_CONST_RESULT("実行して成功")
			ELSE
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 그 대답에 납득하지 못하는 것 같다...
				RETURN IRAI_CONST_RESULT("実行して失敗")
			ENDIF
		ENDIF
	CASE "依頼成功時"
		;成功報告時の報酬など
		CALL CHANGE_CFLAG(2, TARGET, 50)
		CALL CHANGE_CFLAG(4, TARGET, 30)
		CALL KIGEN_CHANGE(TARGET,100,1)
		CALL GET_MONEY_YEN(500, 2)
	CASE "依頼失敗時"
		;失敗報告時の処理
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -10)
ENDSELECT

@IRAI_一般6_SUCCESS(CHK_SLOT)
#FUNCTION
#DIM CHK_SLOT
SIF RAND:MAX(1, IRAI_SUB:CHK_SLOT) <= (1 + ABL:MASTER:教養) * 20
	RETURNF 1

@IRAI_一般6_DIFFICULTY(CHK_SLOT)
#FUNCTIONS
#DIM CHK_SLOT
SIF IRAI_SUB:CHK_SLOT <= (1 + ABL:MASTER:教養) * 20
	RETURNF "Displays perfect understanding"
;難易度全体で差分をパーセント化したもの
SELECTCASE (IRAI_SUB:CHK_SLOT - ((1 + ABL:MASTER:教養) * 20)) * 100 / IRAI_SUB:CHK_SLOT
	CASE 0, 1, 2, 3
		RETURNF "Expert in the subject"
	CASE 4, 5, 6
		RETURNF "Has studied well enough"
	CASE 7 TO 10
		RETURNF "Will be able to answer"
	CASE 11 TO 33
		RETURNF "Might not be right"
	CASE 34 TO 50
		RETURNF "Can answer it, probably"
	CASE 51 TO 70
		RETURNF "It's a pretty difficult one"
	CASEELSE
		RETURNF "Clueless"
ENDSELECT
