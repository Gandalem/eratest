					ENDIF
					PRINTL 
					SOURCE:CHARA:歓楽 += 300
				CASEELSE
					;大成功
					PRINT <--
					SETCOLORBYNAME GOLD
					PRINT 훌륭해!!
					SETCOLOR SAVECLR
					PRINTL -->
					IF IRAI_RESULT_SCORE2:CHK_SLOT == 0
						PRINTFORMW %CALLNAME:CHARA%이(가) 주문한 요리는 아니었지만, 아주 좋은 인상을 준 것 같다!
					ELSE
						PRINTFORMW %CALLNAME:CHARA%는(은) %HE_SHE(CHARA)%가 주문했던 먹음직스러운 음식을 받아 매우 기뻐하는 것 같다!
					ENDIF
					PRINTL 
					SOURCE:CHARA:歓楽 += 1000
					おまけ = 1
			ENDSELECT
		ENDIF
		CALL CHANGE_CFLAG(2, CHARA, 20)
		CALL CHANGE_CFLAG(4, CHARA, 20)
		CALL GET_MONEY_YEN(2000, 2)
		IF おまけ
			PRINTFORML %CALLNAME:CHARA%가 보너스 팁으로 당신에게 보상하기로 결정했다!
			CALL CHANGE_CFLAG(2, CHARA, 20)
			CALL CHANGE_CFLAG(4, CHARA, 20)
			CALL GET_MONEY_YEN(1000, 2)
		ENDIF
		;bugfix custom code, cleanup
		REQUEST_DISHNAME:CHARA:0 =
	CASE "依頼失敗時"
		;失敗報告時の処理
		IF IRAI_RESULT_SCORE1:CHK_SLOT ;addition custom code, judge result here
			SAVECLR = GETCOLOR()
			PRINTL 
			SETCOLORBYNAME YELLOW
			PRINTFORM %"★" * (IRAI_RESULT_SCORE1:CHK_SLOT / 10)%
			SETCOLORBYNAME RED
			PRINTFORM %"★" * (IRAI_RESULT_SCORE2:CHK_SLOT / 10)%
			PRINTL 
			SETCOLOR SAVECLR
			PRINT <--
			SETCOLORBYNAME RED
			PRINT BAD
			SETCOLOR SAVECLR
			PRINTL -->
			IF 一致評価 == 0
				;注文違い
				PRINTFORML %CALLNAME:CHARA%의 눈이 믿을 수 없다는 듯 커진다. 왜냐하면 %HE_SHE(CHARA)%가 음식이 %HE_SHE(CHARA)%가 주문한 것과 완전히 다르다는 것을 깨달았기 때문이다.
			ELSE
				;ここに来ると言うことは料理の出来がよほど悪い
				PRINTFORML %BREAKENG(@"완전한 절망의 표정이 스친다 %CALLNAME:CHARA%의 얼굴에 %HE_SHE(CHARA)% ~을 보았을 때 \”맛있는\” 음식 %HE_SHE(CHARA)% 주문한 것이 어떻게 되었는지")%
			ENDIF
			PRINTFORMW 그 요청은 처참한 실패로 이어졌다...
			PRINTL 
		ENDIF
		CALL CHANGE_CFLAG(2, CHARA, -5)
		CALL CHANGE_CFLAG(4, CHARA, -5)
		;bugfix custom code, cleanup
		REQUEST_DISHNAME:CHARA:0 =
ENDSELECT
