@IRAI_一般18_依頼料理(CHARA, CHK_SLOT)
#DIM CHARA
#DIM CHK_SLOT
#DIM RANDOM
#DIM DISHNUMBER
#DIMS TEMPS, 2
#DIM CONST ユニーク閾値 = 5   ;キャラがユニーク料理を発注しはじめる親密度
#DIMS CONST DELIMITER = "／"   ;料理名と料理IDの区切りに使う文字
;**********依頼料理生成部**********
IF REQUEST_DISHNAME:CHARA:0 == ""
	;料理の定義関数が通常関数で@一般依頼18から呼べないので乱数シードを固定して同じ料理名を出す
	;ユニーク料理の売り込み機能を捨てればERHとこの煩雑な実装を除去できる(受託後、期限内に連れ出し可能になると結果が変わってしまうため変数に入れる必要がある)
	;DISH_NAMEなどを破壊するので待避。力業にしたって汚すぎる…
	DUMPRAND
	RANDOMIZE IRAI_SUB:CHK_SLOT
	;100番台＝軽食、200番台＝主食、300番台＝デザート、400番台＝各キャラのユニーク料理
	;親密だと自分のユニーク料理をしれっと売り込んでくることがある
	IF ABL:CHARA:親密 >= ユニーク閾値 && COM_351_CONDITION(CHARA) && RAND:4 == 0
		;仲がいい、かつ連れだし可能なら25%の確率でユニーク料理確定
		RANDOM = 400 + CHARA
	ELSE
		RANDOM = RAND:3 * 100 + 100
	ENDIF
	;注文される料理を抽選。ローター系はなしで
	DO
	IF RANDOM >= 400
		;キャラのユニーク料理が抽選された
		DISHNUMBER = RANDOM
	ELSE
		;汎用の料理が抽選された
		DISHNUMBER = RAND(RANDOM, RANDOM + 100)
	ENDIF
	CALL TEMP_DISHDATA(DISHNUMBER)
	;******キャラ別処理******
	IF DISHNUMBER > 400
		;嫌いLv10クラスの嫌い方でなければ強制削除はしないようにした(小兎姫の辛いLv8は除去していない)
		;明確な理由はないので必要とあらばいじってほしい
		;あくまで料理の基本要素として加わっているものだけ。プレイヤーがあとから足せるものは除去不能
		;くたかとミスティアは鳥肉と卵を除去する
		IF GROUPMATCH(CHARA, [[ミスティア]], [[久侘歌]])
			SIF STR_MULTI_COUNT(TEMP_DISH_TASTE, "鳥肉/卵")
				TEMP_DISH_NAME =
		ENDIF
		;リグル、ラルバは虫肉を除去する
		IF GROUPMATCH(CHARA, [[リグル]] , [[ラルバ]])
			SIF STR_MULTI_COUNT(TEMP_DISH_TASTE, "虫肉")
				TEMP_DISH_NAME =
		ENDIF
		;諏訪子はカエルを除去する
		IF GROUPMATCH(CHARA, [[諏訪子]])
			SIF STR_MULTI_COUNT(TEMP_DISH_TASTE, "カエル")
				TEMP_DISH_NAME =
		ENDIF
		;わかさぎ姫は魚orうまい魚を除去する
		IF GROUPMATCH(CHARA, [[わかさぎ姫]])
			SIF STR_MULTI_COUNT(TEMP_DISH_TASTE, "魚/うまい魚")
				TEMP_DISH_NAME =
		ENDIF
	ENDIF
	;************************
	LOOP TEMP_DISH_NAME == "" || STRCOUNT(TEMP_DISH_NAME, "ローター") > 0
	REQUEST_DISHNAME:CHARA:0 = %TEMP_DISH_NAME%%DELIMITER%{DISHNUMBER}
	INITRAND
ENDIF
;**********************************
SPLIT REQUEST_DISHNAME:CHARA:0, DELIMITER, TEMPS
RESULTS = %TEMPS:0%
RETURN TOINT(TEMPS:1)
