				ELSE
					PRINTFORMW %CALLNAME:CHARA%는 %HE_SHE(CHARA)%가 주문한 음식을 받게 되어 기뻐하는 것 같다.
				ENDIF
				PRINTL 
				SOURCE:CHARA:歓楽 += 300
				RETURN IRAI_CONST_RESULT("実行して成功")
			CASEELSE
				;大成功
				PRINT <--
				SETCOLORBYNAME GOLD
				PRINT 훌륭해!!
				SETCOLOR SAVECLR
				PRINTL -->
