				RETURN IRAI_CONST_RESULT("実行して成功")
		ENDSELECT
	CASE "依頼実行時_MEETINGPOINT" ;addition custom code
		;このCASEに限り、RESULTが意味を持ちます
		;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
		;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
		;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		VARSET おまけ
		PRINTFORML 당신은 %DISHNAME_TR(DISH_NAME)%의 특수 배송을 %CALLNAME:CHARA%에게 준비했다.
		PRINTFORML 나중에 %HIM_HER(CHARA)%을 만나 %HE_SHE(CHARA)%가 그것을 마음에 들어 했는지 확인해야 한다.
		;ローカル変数にグローバル変数をコピーしたのち消去する
		DISH_DELIVER = %DISH_NAME%
		DISH_NAME =
		REQUEST_DISHNAME:CHARA:0 =
		;#;PRINTFORML 依頼したもの＝%DISH_REQUEST%
		;#;PRINTFORML 届けた料理　＝%DISH_DELIVER%
		CALL REVIEW_DISH(CHARA , DISH_TASTE)
		;料理が美味しいかどうか、要求した物かどうか吟味
		;料理自体の味は評価点を低く補正(補正値は定数の評価点補正)
		評価基礎 = TCVAR:CHARA:料理評価値 * 評価点補正 / 100 / 10
		一致評価 = STRCOUNT(DISH_DELIVER , DISH_REQUEST) > 0 ? 一致ボーナス # 0
		;#;PRINTFORML 評価基礎：{評価基礎}    一致評価：{一致評価}
		IRAI_RESULT_SCORE1:CHK_SLOT = 評価基礎
		IRAI_RESULT_SCORE2:CHK_SLOT = 一致評価
		SIF !評価基礎 && !一致評価 ;ensure a value is set
			IRAI_RESULT_SCORE1:CHK_SLOT = 1
		SELECTCASE 評価基礎 + 一致評価
			CASE IS < 評価基準:0
				RETURN IRAI_CONST_RESULT("実行して失敗")
			CASEELSE
				RETURN IRAI_CONST_RESULT("実行して成功")
		ENDSELECT
	CASE "依頼成功時"
		;成功報告時の報酬など
		IF IRAI_RESULT_SCORE1:CHK_SLOT ;addition custom code, judge result here
			SAVECLR = GETCOLOR()
			PRINTL 
			SETCOLORBYNAME YELLOW
			PRINTFORM %"★" * (IRAI_RESULT_SCORE1:CHK_SLOT / 10)%
			SETCOLORBYNAME RED
			PRINTFORM %"★" * (IRAI_RESULT_SCORE2:CHK_SLOT / 10)%
