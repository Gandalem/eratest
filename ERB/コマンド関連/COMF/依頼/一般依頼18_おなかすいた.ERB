; Modular ERB: COMF/依頼/一般依頼18_おなかすいた.ERB
;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう

@EXIST_一般依頼18
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです

@一般依頼18(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Would someone mind cooking this for me～?")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, @"주문한 대로 음식을 준비하여 배달한다.")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"%金額表示(2000)% + 팁")
	CASE "依頼実行コマンド名"
		;何か問題があったら変えてください
		IF TALENT:MASTER:性別 == 2
			CALLF MAKE_STR(V_NAME, "Food Delivery!")
		ELSE
			CALLF MAKE_STR(V_NAME, "It's UmanEats!")
		ENDIF
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "food")) ;qol custom code, change type for better handling
	CASE "依頼サブ"
		;これは乱数シード
		CALLF MAKE_INT(V_NAME, RAND:1000000)
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
		CALLF MAKE_INT(V_NAME, 3)
	CASE "依頼発生率"
		CALLF MAKE_INT(V_NAME, 5)
	CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		SIF DISH_NAME != "" && (TARGET == ARG || CFLAG:ARG:現在位置 == SUKIMA()) && !FLAG:70 ;bugfix custom code, allow delivery if at home
			CALLF MAKE_INT(V_NAME, 1)
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		SIF Add_Request_Should_Discard(ARG) ;addition custom code
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
	CASE "MEETINGPOINT_ALLOWED" ;addition custom code
		SIF DISH_NAME != ""
			CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

