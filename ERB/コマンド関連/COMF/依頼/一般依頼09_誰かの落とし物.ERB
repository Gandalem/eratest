;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼9
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@一般依頼9(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "依頼名"
	CALLF MAKE_STR(V_NAME, "誰かの落とし物")
CASE "依頼内容表示"
	CALLF MAKE_STR(V_NAME, @"Look for the owner")
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"High-grade Material")
CASE "依頼報告不要"
	CALLF MAKE_STR(V_NAME, "No report needed (report needed to get the reward)")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, "Return The Lost Item")

CASE "依頼内容"
	CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(RAND_PERSON(ARG), "捜索（人物）"))
CASE "依頼サブ"
	;パターンの設定
	CALLF MAKE_INT(V_NAME, RAND:3 + 1)
CASE "依頼期限"
	CALLF MAKE_INT(V_NAME, 10)
CASE "依頼発生率"
	CALLF MAKE_INT(V_NAME, 4)
CASE "依頼発生条件"
	SIF CFLAG:ARG:信頼度 >= 30
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼受託可能条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "依頼実行可能条件"
	CALLF MAKE_INT(V_NAME, 1)
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE "依頼消滅条件"
	SIF Add_Request_Should_Discard(ARG) ;addition custom code
		CALLF MAKE_INT(V_NAME, 1)
CASE "MEETINGPOINT_ALLOWED" ;addition custom code
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT



@IRAI_一般9(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT ;addition custom code
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID) ;addition custom code
SELECTCASE SCENE
CASE "依頼条件表示"
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE "依頼実行時"
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
	PRINTFORMW You return the lost item to %CALLNAME:TARGET%.
	PRINTFORML 
	SOURCE:恭順 = 1500
	SOURCE:歓楽 = 1000
	CALL CHANGE_CFLAG(2, TARGET, 20)
	CALL CHANGE_CFLAG(4, TARGET, 10)
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE "依頼実行時_MEETINGPOINT" ;addition custom code
	PRINTFORMW You place %CALLNAME:IRAI_SLOT_TO_PERSON(CHK_SLOT)%'s item in the lost-and-found box.
	PRINTFORML 
	CALL CHANGE_CFLAG(2, IRAI_SLOT_TO_PERSON(CHK_SLOT), 10)
	CALL CHANGE_CFLAG(4, IRAI_SLOT_TO_PERSON(CHK_SLOT), 5)
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE "依頼成功時"
;成功報告時の報酬など
	SOURCE:歓楽 = 500
	CALL CHANGE_CFLAG(2, TARGET, 30)
	CALL CHANGE_CFLAG(4, TARGET, 20)
	CALL GetRandMaterial(1, 10000, 5000)
CASE "依頼失敗時"
;失敗報告時の処理
	CALL CHANGE_CFLAG(2, TARGET, -2)
	CALL CHANGE_CFLAG(4, TARGET, -1)
ENDSELECT
