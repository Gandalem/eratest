; Modular ERB: COMORDER.ERB

@COM_ORDER
;hypnosis patch
;常識改変
IF TCVAR:Common_Sense_Alteration_Status
	A += 30 * TCVAR:Common_Sense_Alteration_Status / 100
	PRINT 상식 수정
	PRINTV '(,30 * TCVAR:Common_Sense_Alteration_Status / 100,')
	S = 1
ENDIF
IF FLAG:催眠強度
	A += 30 * FLAG:催眠強度 / 100
	PRINT 전 지구적 상식 수정
	PRINTV '(,30 * FLAG:催眠強度 / 100,')
	S = 1
ENDIF
;----------------------------------------
;ABL:親密
IF ABL:親密
	SIF S ;hypnosis patch
		PRINT  + 
	A += ABL:親密
	PRINT 친밀
	PRINTV 'LV,ABL:親密,'(,ABL:親密,')
	S = 1
ENDIF
;ABL:従順
IF ABL:従順
	SIF S
		PRINT  + 
	A += ABL:従順 * 4
	PRINT 순종
	PRINTV 'LV,ABL:従順,'(,ABL:従順 * 4,')
	S = 1
ENDIF
;ABL:マゾっ気
IF ABL:マゾっ気
	SIF S
		PRINT  + 
	A += ABL:マゾっ気 * 2
	PRINT 마조키즘
	PRINTV 'LV,ABL:マゾっ気,'(,ABL:マゾっ気 * 2,')
	S = 1
ENDIF
;レズ調教
IF HETEROSEX(TARGET,PLAYER) == 1
	;ABL:レズっ気
	IF ABL:レズっ気
		SIF S
			PRINT  + 
		A += ABL:レズっ気 * 3
		PRINT 레즈끼
		PRINTV 'LV,ABL:レズっ気,'(,ABL:レズっ気 * 3,')
		S = 1
	ENDIF
	;ABL:レズ中毒
	IF ABL:レズ中毒
		SIF S
			PRINT  + 
		A += ABL:レズ中毒 * 3
		PRINT 레즈중독
		PRINTV 'LV,ABL:レズ中毒,'(,ABL:レズ中毒 * 3,')
		S = 1
	ENDIF
	;TALENT:両刀
	IF TALENT:性別嗜好 == -1
		SIF S
			PRINT  + 
		A += 10
		PRINT 양성애
		PRINTV '(,10,')
		S = 1
	ENDIF
	;好奇心
	IF TALENT:性的興味 > 0
		SIF S
			PRINT  + 
		A += 7
		PRINT 호기심이 있다.
		PRINTV '(,7,')
		S = 1
	ENDIF
	;保守的
	IF TALENT:性的興味 < 0
		PRINT  - 
		A -= 13
		PRINT 보수적이다
		PRINTV '(,13,')
		S = 1
	ENDIF
	;ゲイ調教
ELSEIF HETEROSEX(TARGET,PLAYER) == 2
	;ABL:ホモっ気
	IF ABL:ホモっ気
		SIF S
			PRINT  + 
		A += ABL:ホモっ気 * 3
		PRINT 호모끼
		PRINTV 'LV,ABL:ホモっ気,'(,ABL:ホモっ気 * 3,')
		S = 1
	ENDIF
	;ABL:ゲイ中毒
	IF ABL:ゲイ中毒
		SIF S
			PRINT  + 
		A += ABL:ゲイ中毒 * 3
		PRINT 게이중독
		PRINTV 'LV,ABL:ゲイ中毒,'(,ABL:ゲイ中毒 * 3,')
		S = 1
	ENDIF
	;TALENT:両刀
	IF TALENT:性別嗜好 == -1
		SIF S
			PRINT  + 
		A += 10
		PRINT 양성애자
		PRINTV '(,10,')
		S = 1
	ENDIF
	;好奇心
	IF TALENT:性的興味 > 0
		SIF S
			PRINT  + 
		A += 7
		PRINT 호기심이 생겼다.
		PRINTV '(,7,')
		S = 1
	ENDIF
	;保守的
	IF TALENT:性的興味 < 0
		PRINT  - 
		A -= 13
		PRINT 보수적이다
		PRINTV '(,13,')
		S = 1
	ENDIF
ELSE
	;好奇心
	IF TALENT:性的興味 > 0
		SIF S
			PRINT  + 
		A += 5
		PRINT 호기심이 많다
		PRINTV '(,5,')
		S = 1
	ENDIF
	;保守的
	IF TALENT:性的興味 < 0
		PRINT  - 
		A -= 10
		PRINT 보수적인
		PRINTV '(,10,')
		S = 1
	ENDIF
ENDIF
;刻印チェック
IF MARK:苦痛刻印
	SIF S
		PRINT  + 
	A += MARK:苦痛刻印 * 5
	PRINT 고통 각인
	PRINTV 'LV,MARK:苦痛刻印,'(,MARK:苦痛刻印 * 5,')
	S = 1
ENDIF
IF TALENT:プライド > 0
	T = 4
ELSEIF TALENT:プライド < 0
	T = 1
ELSE
	T = 2
ENDIF
;不埒刻印および反発刻印
IF MARK:不埒刻印
	SIF S
		PRINT  + 
	A += MARK:不埒刻印 * 3 * T
	PRINT 음란한 표식
	PRINTV 'LV,MARK:不埒刻印,'(,MARK:不埒刻印 * 3 * T,')
	S = 1
ENDIF
IF MARK:反発刻印
	PRINT  - 
	A -= MARK:反発刻印 * 2 * T
	PRINT 증오의 낙인
	PRINTV 'LV,MARK:反発刻印,'(,MARK:反発刻印 * 2 * T,')
	S = 1
ENDIF
;PALAM:恭順
IF GETPALAMLV(PALAM:恭順,5)
	SIF S
		PRINT  + 
	A += GETPALAMLV(PALAM:恭順,5) * 3
	PRINT 공순
	PRINTV 'LV,GETPALAMLV(PALAM:恭順,5),'(,GETPALAMLV(PALAM:恭順,5) * 3,')
	S = 1
ENDIF
;PALAM:恐怖
IF GETPALAMLV(PALAM:恐怖,5)
	SIF S
		PRINT  + 
	A += GETPALAMLV(PALAM:恐怖,5) * 3
	PRINT 공순
	PRINTV 'LV,GETPALAMLV(PALAM:恐怖,5),'(,GETPALAMLV(PALAM:恐怖,5) * 3,')
	S = 1
ENDIF
;服従
IF TALENT:服従
	SIF S
		PRINT  + 
	A += 10
	PRINT 복종
	PRINTV '(,10,')
	S = 1
ENDIF
;隷属
IF TALENT:服従 > 1
	SIF S
		PRINT  + 
	A += 20
	PRINT 노예
	PRINTV '(,20,')
	S = 1
ENDIF
;反抗的（服従、隷属で無効）
IF TALENT:態度 > 0 && !TALENT:服従
	PRINT  - 
	A -= 5
	PRINT 반항적인
	PRINTV '(,5,')
	S = 1
ENDIF
;気丈
IF TALENT:度胸 > 0
	PRINT  - 
	A -= 5
	PRINT 용기
	PRINTV '(,5,')
	S = 1
ENDIF
;素直
IF TALENT:態度 < 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 온순함
	PRINTV '(,5,')
	S = 1
ENDIF
;プライド高い
IF TALENT:プライド > 0
	PRINT  - 
	A -= 15
	PRINT 자존심 강한
	PRINTV '(,15,')
	S = 1
ENDIF
;プライド低い
IF TALENT:プライド < 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 겸손
	PRINTV '(,5,')
	S = 1
ENDIF
;目立ちたがり
IF TALENT:目立ちたがり
	SIF S
		PRINT  + 
	A += 2
	PRINT 눈에 띄고 싶어 함
	PRINTV '(,2,')
	S = 1
ENDIF
;抑圧
IF TALENT:自己愛 < 0
	PRINT  - 
	A -= 10
	PRINT 억압된
	PRINTV '(,10,')
	S = 1
ENDIF
;抵抗
IF TALENT:抵抗
	PRINT  - 
	A -= 10
	PRINT 저항
	PRINTV '(,10,')
	S = 1
ENDIF
;弱味
IF TALENT:弱味
	SIF S
		PRINT  + 
	A += 12
	PRINT 약점
	PRINTV '(,12,')
	S = 1
ENDIF
;即落ち
IF TALENT:即落ち
	SIF S
		PRINT  + 
	A += 10
	PRINT 즉각함락한다.
	PRINTV '(,10,')
	S = 1
ENDIF
;妄信
IF TALENT:妄信
	SIF S
		PRINT  + 
	A += 8
	PRINT 맹목적인 신념
	PRINTV '(,8,')
	S = 1
ENDIF
;調教者の能力、素質
;ABL:サドっ気
IF ABL:PLAYER:サドっ気
	SIF S
		PRINT  + 
	A += ABL:PLAYER:サドっ気 * 2
	PRINTFORM 당신의 새드끼
	PRINTV 'LV,ABL:PLAYER:サドっ気,'(,ABL:PLAYER:サドっ気 * 2,')
	S = 1
ENDIF
;魅惑
IF TALENT:PLAYER:魅惑
	SIF S
		PRINT  + 
	A += 6
	PRINTFORM 당신의 매혹적인
	PRINTV '(,6,')
	S = 1
ENDIF
;謎の魅力
IF TALENT:PLAYER:謎の魅力
	SIF S
		PRINT  + 
	A += 8
	PRINTFORM 당신의 수수께끼의매력
	PRINTV '(,8,')
	S = 1
ENDIF
;サド
IF TALENT:PLAYER:サド
	SIF S
		PRINT  + 
	A += 3
	PRINTFORM 당신의 새드
	PRINTV '(,3,')
	S = 1
ENDIF
;助手の素質
;鼓舞
IF ASSIPLAY && TALENT:PLAYER:鼓舞
	SIF S
		PRINT  + 
	A += 1
	PRINT 조수가 고무한다
	PRINTV '(,1,')
	S = 1
ENDIF
IF TCVAR:泥酔 == 1
	SIF S
		PRINT  + 
	A += 20
	PRINT 만취했다
	PRINTV '(,20,')
	S = 1
ENDIF
;相性チェック
R = NO:PLAYER
IF RELATION:R > 0 && RELATION:R < 30
	PRINT  - 
	A -= 10
	PRINT 매우 나쁜 친밀도
	PRINTV '(,10,')
	S = 1
ELSEIF RELATION:R > 0 && RELATION:R < 70
	PRINT  - 
	A -= 6
	PRINT 나쁜 친밀도
	PRINTV '(,10,')
	S = 1
ELSEIF RELATION:R > 0 && RELATION:R < 100
	PRINT  - 
	A -= 3
	PRINT 낮은 친밀도
	PRINTV '(,3,')
	S = 1
ELSEIF RELATION:R >= 100 && RELATION:R < 130
	SIF S
		PRINT  + 
	A += 3
	PRINT 일반적인 친밀도
	PRINTV '(,3,')
	S = 1
ELSEIF RELATION:R >= 100 && RELATION:R < 170
	SIF S
		PRINT  + 
	A += 6
	PRINT 좋은 친밀도
	PRINTV '(,6,')
	S = 1
ELSEIF RELATION:R >= 100 && RELATION:R >= 170
	SIF S
		PRINT  + 
	A += 10
	PRINT 큰 친밀도
	PRINTV '(,10,')
	S = 1
ENDIF
