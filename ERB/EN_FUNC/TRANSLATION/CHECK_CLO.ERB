@GET_ACTIVE_PANTY_ID(ARG)
#FUNCTION
LOCAL = EQUIP:ARG:下半身下着２
IF !LOCAL
	LOCAL:1 = CURRENT_CLOTHES_SET(ARG)
	LOCAL:2 = CFLAG:ARG:睡眠 ? 240 # 200
	IF CFLAG:ARG:睡眠 || LOCAL:1 > 100 || !GET_INT(ARG, "衣装セット", LOCAL:1, "OVERRIDE_UNDERWEAR_BOTTOM")
		LOCAL = CFLAG:ARG:(LOCAL:2 + 6)
	ELSEIF LOCAL:1 > 100
		LOCAL = GET_INT(ARG, "キャラデータ", LOCAL:1 - 100, @"普段着：%EQUIPNAME:6%")
	ELSE
		LOCAL = GET_INT(ARG, "衣装セット", LOCAL:1, @"%EQUIPNAME:6%")
	ENDIF
ENDIF
RETURNF LOCAL

@GET_ACTIVE_CLOTHING_PART(ARG, PART)
#FUNCTION
#DIM PART
LOCAL = EQUIP:ARG:PART
IF !LOCAL
	LOCAL:1 = CURRENT_CLOTHES_SET(ARG)
	LOCAL:2 = CFLAG:ARG:睡眠 ? 240 # 200
	IF CFLAG:ARG:睡眠 || LOCAL:1 > 100
		LOCAL = CFLAG:ARG:(LOCAL:2 + PART)
	ELSEIF LOCAL:1 > 100
		LOCAL = GET_INT(ARG, "キャラデータ", LOCAL:1 - 100, @"普段着：%EQUIPNAME:PART%")
	ELSE
		LOCAL = GET_INT(ARG, "衣装セット", LOCAL:1, @"%EQUIPNAME:PART%")
	ENDIF
ENDIF
RETURNF LOCAL

@CHECK_CLO(ARGS, ARG = -1)
#FUNCTION

SIF ARG == -1
	ARG = TARGET

SELECTCASE ARGS
    CASE "belly_visible"
    {
        RETURNF !EQUIP:ARG:上半身上着１ && !EQUIP:ARG:上半身上着２ && !EQUIP:ARG:外衣
            && !EQUIP:ARG:着物 && !EQUIP:ARG:ワンピース && !EQUIP:ARG:レオタード && !EQUIP:ARG:ボディースーツ
    }
    CASE "bra_visible"
    {
        RETURNF !EQUIP:ARG:上半身上着１ && !EQUIP:ARG:上半身上着２ && !EQUIP:ARG:外衣
            && !EQUIP:ARG:着物 && !EQUIP:ARG:ワンピース && !EQUIP:ARG:レオタード && !EQUIP:ARG:ボディースーツ
            && (EQUIP:ARG:上半身下着１ || EQUIP:ARG:上半身下着２)
    }
    CASE "bra_overridden"
        LOCAL = CURRENT_CLOTHES_SET(ARG)
        IF LOCAL == 100
            RETURNF CFLAG:ARG:FAVORITE_OVERRIDE_UNDERWEAR
        ELSE
            RETURNF GET_INT(ARG, "衣装セット", LOCAL, "OVERRIDE_UNDERWEAR_TOP")
        ENDIF
    CASE "panties_overridden"
        LOCAL = CURRENT_CLOTHES_SET(ARG)
        IF LOCAL == 100
            RETURNF CFLAG:ARG:FAVORITE_OVERRIDE_UNDERWEAR
        ELSE
            RETURNF GET_INT(ARG, "衣装セット", LOCAL, "OVERRIDE_UNDERWEAR_BOTTOM")
        ENDIF
    CASE "nude" ;ignores hats, socks, shoes, accessories, and decorations
        RETURNF !SUMARRAY(EQUIP:ARG:0, 5, 19)
    CASE "fully_nude"
        RETURNF !(EQUIP:ARG:0)
ENDSELECT
RETURNF 0

@CHECK_PANTIES(ARGS, ARG = -1)
#FUNCTION
SIF ARG == -1 && TARGET != MASTER
	ARG = TARGET

LOCAL = GET_ACTIVE_PANTY_ID(ARG)
SELECTCASE ARGS
	CASE "can_pilfer"
		RETURNF EQUIP:ARG:0 && ARG && EQUIP:ARG:下半身下着２ != 0 && GET_INT(ARG, "下半身下着_ずらし可能", EQUIP:ARG:下半身下着２, "コレクション表示可能")
	CASE "can_shift_aside"
		RETURNF DiaperShiftAble(ARG);NAS: REPLACED
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "SHIFTABLE")
	CASE "can_pull_down"
		RETURNF !GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "PASTIES")
	CASE "are_pasties"
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "PASTIES")
	CASE "open_front"
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "HOLE_FRONT") || GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "STRING_FRONT") || GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "NOTHING_FRONT") || GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "INTANGIBLE_FRONT")
	CASE "open_back"
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "HOLE_BACK") || GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "STRING_BACK") || GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "NOTHING_BACK") || GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "INTANGIBLE_BACK")
	CASE "open_front_type"
		IF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "HOLE_FRONT")
			RETURNF 1
		ELSEIF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "STRING_FRONT")
			RETURNF 2
		ELSEIF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "NOTHING_FRONT")
			RETURNF 3
		ELSEIF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "INTANGIBLE_FRONT")
			RETURNF 4
		ELSE
			RETURNF 0
		ENDIF
	CASE "open_back_type"
		IF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "HOLE_BACK")
			RETURNF 1
		ELSEIF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "STRING_BACK")
			RETURNF 2
		ELSEIF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "NOTHING_BACK")
			RETURNF 3
		ELSEIF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "INTANGIBLE_BACK")
			RETURNF 4
		ELSE
			RETURNF 0
		ENDIF
	CASE "zippable_front"
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "ZIPPABLE_FRONT")
	CASE "zippable_back"
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "ZIPPABLE_BACK")
	CASE "can_be_untied"
		RETURNF GET_INT(ARG, "下半身下着_ずらし可能", LOCAL, "TIED")
	;NAS CUSTOMS
	;IsPadded covers whether its a diaper or not so this is more specific things
	CASE "diaper_tape"
		RETURNF MAX(STRCOUNT(GET_STR(ARG, "下半身下着_ずらし可能", LOCAL, "Tags"),"two-taped"),STRCOUNT(GET_STR(ARG, "下半身下着_ずらし可能", LOCAL, "Tags"),"four-taped"))
	CASE "diaper_pin"
		RETURNF STRCOUNT(GET_STR(ARG, "下半身下着_ずらし可能", LOCAL, "Tags"),"pinned")
	CASE "diaper_belt"
		RETURNF STRCOUNT(GET_STR(ARG, "下半身下着_ずらし可能", LOCAL, "Tags"),"belted")
	;////////////////
ENDSELECT


@CURRENT_CLOTHES_SET(ARG)
#FUNCTION
SIF TCVAR:ARG:EVENT_CLOTHING_SET
    RETURNF TCVAR:ARG:EVENT_CLOTHING_SET
SIF CFLAG:ARG:衣装一時変更
    RETURNF CFLAG:ARG:衣装一時変更

RETURNF CFLAG:ARG:基本服装セット