@MOENY_HENDOU
#LOCALSIZE 1
#LOCALSSIZE 1
IF FLAG:カリスマ変動累積 >= 10
	FLAG:カリスマ変動状況 = RAND(1, 10)
	SELECTCASE FLAG:カリスマ変動状況
		CASE 9
			CALL SHOW_REMILLIA_INTERVIEW
		CASE 1
			CALL SHOW_CHARISMA_GUARD
	ENDSELECT
	FLAG:カリスマ変動累積 = 0
ENDIF
;極端な状況の補正
IF FLAG:カリスマ人気 >= 300
	SIF RAND:(FLAG:カリスマ人気 / 50)
		FLAG:カリスマ変動状況 = MAX(1, FLAG:カリスマ変動状況 - 2)
ELSEIF FLAG:カリスマ人気 <= 50 && INRANGE(FLAG:カリスマ変動状況, 1, 4)
	SIF RAND:(6 - FLAG:カリスマ変動状況)
		FLAG:カリスマ変動状況 += 2
ENDIF
SELECTCASE FLAG:カリスマ変動状況
	CASE 1
		LOCAL = 60 + RAND:10
	CASE 2
		LOCAL = 70 + RAND:10
	CASE 3
		LOCAL = 80 + RAND:10
	CASE 4
		LOCAL = 95 + RAND:5
	CASE 5
		IF FLAG:カリスマ人気 <= 85
			FLAG:カリスマ人気 += RAND(1, 10)
		ELSEIF FLAG:カリスマ人気 >= 150
			FLAG:カリスマ人気 -= RAND(1, 10)
		ELSEIF RAND:2
			FLAG:カリスマ人気 += RAND(1, 10)
		ELSE
			FLAG:カリスマ人気 -= RAND(1, 10)
		ENDIF
	CASE 6
		LOCAL = 105 + RAND:5
	CASE 7
		LOCAL = 125 + RAND:10
	CASE 8
		LOCAL = 150 + RAND:50
	CASE 9
		LOCAL = 200 + RAND:100
ENDSELECT
IF FLAG:カリスマ変動状況 == 5
	FLAG:カリスマ変動累積 += 5
ELSE
	FLAG:カリスマ人気 = FLAG:カリスマ人気 * LOCAL / 100
	FLAG:カリスマ変動累積 += ABS(5 - FLAG:カリスマ変動状況) + RAND:2
ENDIF
FLAG:カリスマ人気 = MAX(10, FLAG:カリスマ人気)
TIMES FLAG:カリスマ流通, 0.98
;￥、やってることはカリスマと同様
IF FLAG:￥変動累積 >= 10
	FLAG:￥変動状況 = RAND(1, 10)
	FLAG:￥変動累積 = 0
ENDIF
;極端な状況の補正
IF FLAG:￥人気 >= 300
	SIF RAND:(FLAG:￥人気 / 50)
		FLAG:￥変動状況 = MAX(1, FLAG:￥変動状況 - 2)
ELSEIF FLAG:￥人気 <= 30 && INRANGE(FLAG:￥変動状況, 1, 4)
	SIF RAND:(6 - FLAG:￥変動状況)
		FLAG:￥変動状況 += 2
ENDIF
SELECTCASE FLAG:￥変動状況
	CASE 1
		LOCAL = 60 + RAND:10
	CASE 2
		LOCAL = 70 + RAND:10
	CASE 3
		LOCAL = 80 + RAND:10
	CASE 4
		LOCAL = 95 + RAND:5
	CASE 5
		IF FLAG:￥人気 <= 85
			FLAG:￥人気 += RAND(1, 10)
		ELSEIF FLAG:￥人気 >= 150
			FLAG:￥人気 -= RAND(1, 10)
		ELSEIF RAND:2
			FLAG:￥人気 += RAND(1, 10)
		ELSE
			FLAG:￥人気 -= RAND(1, 10)
		ENDIF
	CASE 6
		LOCAL = 105 + RAND:5
	CASE 7
		LOCAL = 125 + RAND:10
	CASE 8
		LOCAL = 150 + RAND:50
	CASE 9
		LOCAL = 200 + RAND:100
ENDSELECT
IF FLAG:￥変動状況 == 5
	FLAG:￥変動累積 += 5
ELSE
	FLAG:￥人気 = FLAG:￥人気 * LOCAL / 100
	FLAG:￥変動累積 += ABS(5 - FLAG:￥変動状況) + RAND:2
ENDIF
FLAG:￥人気 = MAX(10, FLAG:￥人気)
TIMES FLAG:￥流通, 0.98
