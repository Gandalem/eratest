;紅魔カジノ用初期設定

@SET_CHARISMA(TYPE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS TYPE
#DIM LCOUNT
SELECTCASE TYPE
	;まだカリスマを設定していないデータ用
	CASE "NEW"
		FLAG:カリスマ人気 = 100
		FLAG:カリスマ変動状況 = 5
		FLAG:￥人気 = 100
		FLAG:￥変動状況 = 5
		;すでにカリスマを設定している周回用
		;要するに紅魔カジノの初期化コマンドだがカモられ指数は初期化しない
	CASE "RESET"
		FLAG:カリスマ流通 = 0
		FLAG:カリスマ人気 = 100
		FLAG:カリスマ変動状況 = 5
		FLAG:カリスマ変動累積 = 0
		FLAG:￥流通 = 0
		FLAG:￥人気 = 100
		FLAG:￥変動状況 = 5
		FLAG:￥変動累積 = 0
ENDSELECT

@SET_THISMONTHCHARISMA
#DIM カリスマ変動累積
#DIM 変動幅
カリスマ変動累積 = 0
;初日は150~250
CHARISMA_RATE:0 = 150 + RAND:100
CHARISMA_TENDENCY:0 = 5
FOR LOCAL,1,(FLAG:CHARISMA_INGAME_DAY?190#40)
IF カリスマ変動累積 >= 10
	;適正レートだと安定しやすい
	IF INRANGE(CHARISMA_TENDENCY:(LOCAL - 1),150,250) && !RAND:2
		CHARISMA_TENDENCY:LOCAL = 5
	ELSEIF CHARISMA_TENDENCY:(LOCAL - 1) == 5
		;安定からは極端な変動をしない
		CHARISMA_TENDENCY:LOCAL = RAND(3,8)
	ELSEIF CHARISMA_RATE:(LOCAL -1) > 250
		CHARISMA_TENDENCY:LOCAL = RAND(2, 8)
	ELSEIF CHARISMA_RATE:(LOCAL -1) < 150
		CHARISMA_TENDENCY:LOCAL = RAND(3, 9)
	ELSE
		CHARISMA_TENDENCY:LOCAL = RAND(2, 9)
	ENDIF
	カリスマ変動累積 = 0
ELSE
	;変動しないなら前期と同じ
	CHARISMA_TENDENCY:LOCAL = CHARISMA_TENDENCY:(LOCAL -1)
ENDIF
;前期カリスマ価格に応じて補正
SELECTCASE CHARISMA_RATE:(LOCAL -1)
	CASE IS < 50
		IF !RAND:4
			CHARISMA_TENDENCY:LOCAL = 9
			カリスマ変動累積 = 0
		ENDIF
	CASE 50 TO 100
		IF !RAND:5
			CHARISMA_TENDENCY:LOCAL = 8
			カリスマ変動累積 = 0
		ENDIF
	CASE 250 TO 300
		IF !RAND:5
			CHARISMA_TENDENCY:LOCAL = 2
			カリスマ変動累積 = 0
		ENDIF
	CASE IS > 300
		IF !RAND:4
			CHARISMA_TENDENCY:LOCAL = 1
			カリスマ変動累積 = 0
		ENDIF
ENDSELECT
SELECTCASE CHARISMA_TENDENCY:LOCAL
	CASE 1
		変動幅 = - RAND:30 - 100
		カリスマ変動累積 += 3 + RAND:2 + RAND:3
	CASE 2
		変動幅 = RAND:20 - 50
		カリスマ変動累積 += 2 + RAND:2 + RAND:2
	CASE 3
		変動幅 = RAND:10 - 30
		カリスマ変動累積 += 1 + RAND:3 + RAND:2
	CASE 4
		変動幅 = -RAND:5 - 5
		カリスマ変動累積 += 1 + RAND:3 + RAND:2
	CASE 5
		変動幅 = RAND:10 - 5
		カリスマ変動累積 += 1 + RAND:3
	CASE 6
		変動幅 = RAND:5 + 5
		カリスマ変動累積 += 1 + RAND:3 + RAND:2
	CASE 7
		変動幅 = 30 - RAND:10
		カリスマ変動累積 += 1 + RAND:3 + RAND:3
	CASE 8
		変動幅 = RAND:20 + 50
		カリスマ変動累積 += 2 + RAND:2 + RAND:2
	CASE 9
		変動幅 = RAND:30 + 100
		カリスマ変動累積 += 3 + RAND:2 + RAND:3
ENDSELECT
CHARISMA_RATE:LOCAL = CHARISMA_RATE:(LOCAL -1) + 変動幅
CHARISMA_RATE:LOCAL = LIMIT(CHARISMA_RATE:LOCAL,1,400)
SIF CHARISMA_RATE:LOCAL == 1 || CHARISMA_RATE:LOCAL == 400
	カリスマ変動累積 = 10
NEXT

@SHOW_CHARISMA
#DIM 前期カリスマ傾向
IF NOW_PERIOD()
	前期カリスマ傾向 = CHARISMA_TENDENCY:(NOW_PERIOD() -1)
	LOCAL = CHARISMA_TENDENCY:(NOW_PERIOD()-1)
	IF CHARISMA_TENDENCY:NOW_PERIOD() != 前期カリスマ傾向 && NOW_PERIOD() > 1
		SETCOLOR C_YELLOW
		SELECTCASE CHARISMA_TENDENCY:NOW_PERIOD()
			CASE 9
				CALL SHOW_REMILLIA_INTERVIEW
			CASE 5
				SIF GROUPMATCH(前期カリスマ傾向,1,2,8,9)
					PRINTFORML %SHOW_TENDENCY(前期カリスマ傾向)% 카리스마 시장이 평탄해졌다.
			CASE 1
				CALL SHOW_CHARISMA_GUARD
		ENDSELECT
		RESETCOLOR
		PRINTFORML 
	ENDIF
ENDIF
PRINTL
PRINTFORML  카리스마의 시장 가치가 %ORDINAL(NOW_PERIOD())%:로 설정되었다: 1 카리스마 = %金額表示(CHARISMA_NOW())%
PRINTFORML 현재 시장은 %SHOW_TENDENCY(CHARISMA_TENDENCY:NOW_PERIOD())%이다.
;IF FLAG:新聞購読
PRINTFORML 
PRINTFORML 지난 10일간 카리스마의 시장 가격:
FOR LOCAL,1,(FLAG:CHARISMA_INGAME_DAY?190#40)
SIF !INRANGE(LOCAL,NOW_PERIOD()-9,NOW_PERIOD())
	CONTINUE
CALL PRINT_COLORBAR, CHARISMA_RATE:LOCAL, 400, 40, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("水色"),
PRINTFORML 　%ORDINAL(LOCAL),6% — %金額表示(CHARISMA_RATE:LOCAL),4%　%SHOW_TENDENCY(CHARISMA_TENDENCY:LOCAL)%
NEXT
;ENDIF

@SHOW_TENDENCY(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		LOCALS = crashing
	CASE 2
		LOCALS = rapidly falling
	CASE 3
		LOCALS = trending downwards
	CASE 4
		LOCALS = slightly decreasing
	CASE 5
		LOCALS = holding steady
	CASE 6
		LOCALS = slightly increasing
	CASE 7
		LOCALS = trending upwards
	CASE 8
		LOCALS = rising rapidly
	CASE 9
		LOCALS = skyrocketing
ENDSELECT
RETURNF LOCALS

@NOW_PERIOD()
#FUNCTION
GETTIME
;カリスマ変動は一日一度に変更
LOCAL = (RESULT / 1000000000) % 100
SIF FLAG:CHARISMA_INGAME_DAY
	LOCAL = ((RESULT / 1000000000) % 100 - 1) * 6 + ((RESULT / 10000000) % 100) / 4
RETURNF LOCAL

@NOW_MONTH()
#FUNCTION
GETTIME
LOCAL = RESULT / 100000000000
RETURNF LOCAL

@CHARISMA_NOW()
#FUNCTION
RETURNF CHARISMA_RATE:NOW_PERIOD()

