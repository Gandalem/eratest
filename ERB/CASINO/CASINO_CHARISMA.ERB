@TODAYS_CHARISMA(ARG)
#DIM 年月
GETTIME
DEBUGPRINTFORML {RESULT / 10000000000000}년 {(RESULT / 100000000000) % 100}月 {(RESULT / 1000000000) % 100}일 {(RESULT / 10000000) % 100}시간이야
年月 = RESULT / 100000000000
IF 年月 != FLAG:前回カリスマ設定月
	DUMPRAND
	IF !ARG
		PRINTFORMW 카리스마의 시장 가격이 %MONTH_NAME((RESULT / 100000000000) % 100)% {RESULT / 10000000000000}로 설정되었다.
		FLAG:前回カリスマ設定月 = 年月
	ENDIF
	RANDOMIZE 年月
	CALL SET_THISMONTHCHARISMA
	INITRAND
ENDIF
