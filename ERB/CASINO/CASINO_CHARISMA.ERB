; Modular ERB: CASINO_CHARISMA.ERB
;C/Yはカリスマ・￥

@CASINO_TRADE
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM LCOUNT
#DIM C_RATE
#DIM C_MAX
#DIM C_PRICE
#DIM Y_RATE
#DIM Y_MAX
#DIM Y_PRICE
C_RATE = CHARISMA_NOW()
;Y_RATEはC_RATEの1/100だが精度の関係で使わない
;Y_RATE = FUNC_CASINO("TRADE") / 100
;C購入取引に使うカリスマ入力の上限
C_MAX = MIN(CM_LIMIT - MONEY:2, MONEY / C_RATE)
PRINTFORML 요정 하녀:
PRINTFORML 　「어서 오세요!」
PRINTFORML 　「여기서 카리스마와 돈을 교환합니다.」
IF C_RATE < 100
	PRINTFORML 　「죄송합니다...」
	PRINTFORML 　「매력으로 교환하는 것은 현재 불가능합니다.」
ENDIF
;custom code alignment
PRINTFORML %"Current ￥", 36 + 3 + STRLENS(三桁区切(CM_LIMIT)), LEFT%%金額表示(MONEY), 13, RIGHT%
PRINTFORML %"Current Charisma", 36, LEFT%%三桁区切(MONEY:2), 13, RIGHT% / %三桁区切(CM_LIMIT)%
PRINTFORML %"Current ￥/Charisma exchange rate", 36 + 3 + STRLENS(三桁区切(CM_LIMIT)), LEFT%%金額表示(C_RATE), 13, RIGHT%
DRAWLINE
CALL ASK_M(@"카리스마 구매",C_RATE > 100 && C_MAX > 0, @"매력 판매",FLAG:会員ランク,"종료",1)
SELECTCASE RESULT
	CASE 0
		IF CM_LIMIT <= MONEY:2
			PRINTFORML 「죄송합니다만, 당신은 카리스마 한도에 도달했습니다. 더 이상 판매할 수 없습니다.」
			PRINTFORML 「회원 등급을 올리거나 큰 손실 후에 다시 와주세요.」
			RETURN
		ENDIF
		PRINTFORML 요정 하녀:
		PRINTFORML 　「구매하고 싶은 카리스마의 양을 말해 주십시오. (최대:%三桁区切(C_MAX)%)」
		FOR LCOUNT, 0, LOG10(C_MAX) + 1
		LOCAL = POWER(10, LCOUNT)
		PRINTFORML [{LOCAL, LOG10(C_MAX) + 1}] - 매수 {LOCAL} 카리스마
		NEXT
		SIF C_MAX >= 4
			PRINTFORML [{C_MAX / 2, LOG10(C_MAX) + 1}] - 최대 매력치의 절반을 구매한다.
		PRINTFORML [{C_MAX, LOG10(C_MAX) + 1}] - 가능한 최대 카리스마를 구매한다.
		PRINTFORML [{0, LOG10(C_MAX) + 1}] - 종료한다.
		INPUT
		IF INRANGE(RESULT, 1, C_MAX)
			C_PRICE = RESULT
			Y_PRICE = C_PRICE * C_RATE
			CALL CASINO_MONEY("￥", -Y_PRICE)
			CALL CASINO_MONEY("カリスマ", C_PRICE)
			PRINTFORML 요정 마이드:
			PRINTFORML 　「방문해 주셔서 고마워요!」
			PRINTFORMW 　「%金額表示(Y_PRICE)% 카리스마를 구매하는 데 %三桁区切(C_PRICE)%가 들 거예요.」
		ENDIF
	CASE 1
		CALL CM_BALANCE
	CASE 2
		RETURN
ENDSELECT
