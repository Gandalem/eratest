;フッター部分
;-----------------------------
DRAWLINE
PRINTFORM PAGE.{ページ数}/

IF 全ページ数 != 11
	SETCOLOR 0xFF0000
	FONTSTYLE 1
ENDIF
PRINTFORML {全ページ数 - 1}
RESETCOLOR
FONTREGULAR

PRINTFORML [  0] Previous Page
PRINTFORML [  1] Next Page
PRINTFORML [100] Return

INPUT
SELECTCASE RESULT
CASE 0
	ページ数 += 全ページ数 - 1
	ページ数 %= 全ページ数
	RESTART
CASE 1
	ページ数 ++
	ページ数 %= 全ページ数
	RESTART
CASE 666
	全ページ数 = 17
	RESTART
CASEELSE
	RETURN
ENDSELECT

@スロット配列_一覧(左リール,中リール,右リール)
#DIM 左リール
#DIM 中リール
#DIM 右リール

#DIM リール, 3

#DIM LOOP_NUM

#DIM CONST 色_RED7       = 0xFF00FF
#DIM CONST 色_BLUE7      = 0x66FFFF
#DIM CONST 色_BELL       = 0xFFFF00
#DIM CONST 色_CHERRY     = 0xFF0000
#DIM CONST 色_MELON      = 0x00FF00
#DIM CONST 色_BAR        = 0xFFFFFF
#DIM CONST 色_REPLAY     = 0xCCFFFF
#DIM CONST 色_NULL       = 0x404040

リール = 左リール,中リール,右リール
FOR LOOP_NUM, 0,3
	FONTSTYLE 1
	SELECTCASE リール:LOOP_NUM
		CASE 1
			SETCOLOR 色_RED7
				PRINT     RD7
			RESETCOLOR
		CASE 2
			SETCOLOR 色_BLUE7
				PRINT     BL7
			RESETCOLOR
		CASE 3
			SETCOLOR 色_BELL
				PRINT     BEL
			RESETCOLOR
		CASE 4
			SETCOLOR 色_CHERRY
				PRINT     CHE
			RESETCOLOR
		CASE 5
			SETCOLOR 色_MELON
				PRINT     MEL
			RESETCOLOR
		CASE 6
			SETCOLOR 色_BAR
				PRINT     BAR
			RESETCOLOR
		CASE 7
			SETCOLOR 色_REPLAY
				PRINT     REP
			RESETCOLOR
		CASEELSE
			SETCOLOR 色_NULL
				PRINT     NUL
			RESETCOLOR
	ENDSELECT
	FONTREGULAR
NEXT
