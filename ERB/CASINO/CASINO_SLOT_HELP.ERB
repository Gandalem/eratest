#DIM 行数
#DIM 暗転
#DIM 色_RED7
#DIM 色_BLUE7
#DIM 色_BELL
#DIM 色_CHERRY茎
#DIM 色_CHERRY果実
#DIM 色_MELON果実
#DIM 色_MELON皮
#DIM 色_BAR
#DIM 色_REPLAY
#DIM 色_NULL
IF 暗転
	色_RED7 = 0x404040
	色_BLUE7 = 0x404040
	色_BELL = 0x404040
	色_CHERRY茎 = 0x404040
	色_CHERRY果実 = 0x404040
	色_MELON果実 = 0x404040
	色_MELON皮 = 0x404040
	色_BAR = 0x404040
	色_REPLAY = 0x404040
	色_NULL = 0x000000
ELSE
	色_RED7 = 0xFF0000
	色_BLUE7 = 0x66FFFF
	色_BELL = 0xFFFF00
	色_CHERRY茎 = 0x00FF00
	色_CHERRY果実 = 0xFF0000
	色_MELON果実 = 0xFF0000
	色_MELON皮 = 0x00FF00
	色_BAR = 0xFFFFFF
	色_REPLAY = 0xCCFFFF
	色_NULL = 0x404040
ENDIF
;########################################################
;赤7(Scarlet BB)
;Bonus Pattern
;
;1 ;;;;;;;;;;;;;;;;;;;;;;;;;
;2 ;;;                   ;;;
;3 ;;;                   ;;;
;4 ;;;                   ;;;
;5 ;;;;;;;;;;;;;;;      ;;;;
;6 ;;;;;;;;;;;        ;;;;;;
;7 ;;;;;;;;      Scarlet;;;;
;8 ;;;;;;            ;;;;;;;
;9 ;;;;;;;;;;;;;;;;;;;;;;;;;
;########################################################
IF 絵柄 == 1
	FONTSTYLE 1
	SELECTCASE 行数
		CASE 1,9
			PRINTFORM ;;;;;;;;;;;;;;;;;;;;;;;;;
		CASE 2,3,4
			PRINT ;;;
			SETCOLOR 色_RED7
			PRINTFORM %UNICODE(0x2589)*19%
			RESETCOLOR
			PRINT ;;;
		CASE 5
			PRINT ;;;;;;;;;;;;;;;
			SETCOLOR 色_RED7
			PRINTFORM %UNICODE(0x2589)*6%
			RESETCOLOR
			PRINT ;;;;
		CASE 6
			PRINT ;;;;;;;;;;;
			SETCOLOR 色_RED7
			PRINTFORM %UNICODE(0x2589)*8%
			RESETCOLOR
			PRINT ;;;;;;
		CASE 7
			PRINT ;;;;;;;;
			SETCOLOR 色_RED7
			PRINTFORM %UNICODE(0x2589)*6%
			FONTSTYLE 3
			PRINT 스칼렛
			RESETCOLOR
			FONTSTYLE 1
			PRINT ;;;;
		CASE 8
			PRINT ;;;;;;
			SETCOLOR 色_RED7
			PRINTFORM %UNICODE(0x2589)*12%
			RESETCOLOR
			PRINT ;;;;;;;
		CASEELSE
			PRINTL 오류 존재하지 않는 행수가 지정되었습니다(RED7)
	ENDSELECT
