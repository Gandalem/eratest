;-----------------------------
;フッター部分
;-----------------------------
DRAWLINE
PRINTFORM PAGE.{ページ数}/
IF 全ページ数 != 11
	SETCOLOR 0xFF0000
	FONTSTYLE 1
ENDIF
PRINTFORML {全ページ数 - 1}
RESETCOLOR
FONTREGULAR
PRINTFORML [  0] 이전 페이지
PRINTFORML [  1] 다음 페이지
PRINTFORML [100] 돌아가기
INPUT
SELECTCASE RESULT
	CASE 0
		ページ数 += 全ページ数 - 1
		ページ数 %= 全ページ数
		RESTART
	CASE 1
		ページ数 ++
		ページ数 %= 全ページ数
		RESTART
	CASE 666
		全ページ数 = 17
		RESTART
	CASEELSE
		RETURN
ENDSELECT

