		PRINTFORML [2] - 베팅 변경
		PRINTFORML [1] - 계속하기
		PRINTFORML [0] - 중지
		DO
		INPUT
		IF INRANGE(RESULT, 0, 2)
			BREAK
		ELSE
			REUSELASTLINE Invalid input
			CONTINUE
		ENDIF
		LOOP 1
	CASE "続行"
		PRINTFORML [1] - 계속하기
		PRINTFORML [0] - 중단
		DO
		INPUT
		IF INRANGE(RESULT, 0, 1)
			BREAK
		ELSE
			REUSELASTLINE Invalid input
			CONTINUE
		ENDIF
		LOOP 1
	CASE "丁半予想"
		PRINTFORML ~당신의 예측~
		PRINTFORML [2] - 짝수
		PRINTFORML [1] - 홀수
		DO
		INPUT
		IF INRANGE(RESULT, 1, 2)
			BREAK
		ELSE
			REUSELASTLINE Invalid input
			CONTINUE
		ENDIF
		LOOP 1
	CASE "ダイス続行"
		PRINTFORML [2] - 계속하기
		PRINTFORML [1] - 출금하고 계속하기
		PRINTFORML [0] - 출금하고 종료하기
		DO
		INPUT
		IF INRANGE(RESULT, 0, 2)
			BREAK
		ELSE
			REUSELASTLINE Invalid input
			CONTINUE
		ENDIF
		LOOP 1
ENDSELECT
