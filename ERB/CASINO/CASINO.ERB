;紅魔カジノ
;とりあえず格好だけ作ったが景品がないのはどうしたもんか
;為替市場もここにいれてます
;各ゲームコーナーで保有カリスマを確認できないのはカリスマを搾取するための罠である

@CASINO_ENTRANCE
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM EXIT
EXIT = 0
CALL CASINO_CHECK_EVENT("ENTRANCE")
PRINTFORML 
PRINTFORML ～스칼렛 데빌 카지노～
PRINTFORML 　현재 보유액: %金額表示(MONEY), 13, RIGHT%
PRINTFORML 　현재 매력: %三桁区切(MONEY:2), 13, RIGHT%
PRINTFORML 
;SIF ITEM:紅魔カジノVIP会員証
;	PRINTFORML [6] - VIPルーム
;PRINTFORML [5] - 景品交換
IF FUNC_CASINO("CLOSE_CASINO")
	PRINTFORML [-] - 슬롯 (폐쇄됨)
	PRINTFORML [-] - 포커 (폐쇄됨)
	PRINTFORML [-] - 블랙잭 (폐쇄됨)
	PRINTFORML [-] - 카드 (폐쇄됨)
	PRINTFORML [-] - 주사위 (폐쇄됨)
	PRINTFORML [-] - 퀴즈 (폐쇄됨)
ELSE
	PRINTFORML [6] - 슬롯
	PRINTFORML [5] - 포커
	PRINTFORML [4] - 블랙잭
	PRINTFORML [3] - 카드
	PRINTFORML [2] - 주사위
	PRINTFORML [1] - 퀴즈
ENDIF
PRINTFORML 
PRINTFORML [0] - 나가기
PRINTFORML [9] - 설명
SIF FLAG:会員ランク
	PRINTFORML [8] - 카리스마 중개인
DO
INPUT
;休業中はゲーム系は閉まってる
SIF FUNC_CASINO("CLOSE_CASINO") && INRANGE(RESULT, 1, 6)
	GOTO RETRY
SELECTCASE RESULT
	CASE 9
		CALL CASINO_CHECK_EVENT("HELP")
	CASE 8
		SIF FLAG:会員ランク
			CALL CASINO_TRADE
	CASE 0
		;IF MONEY:2 >= TFLAG:カジノ入場時カリスマ + 100
		;	PRINTFORML 「カリスマを現金に交換しますか？」
		;	PRINTFORML 「今ですと手数料がお得ですよ」
		;ENDIF
		EXIT = 1
	CASE 6
		CALL CASINO_SLOT
	CASE 5
		CALL CASINO_POKER
	CASE 4
		CALL CASINO_BLACKJACK
	CASE 3
		CALL CASINO_CARD
	CASE 2
		CALL CASINO_DICE
	CASE 1
		CALL CASINO_QUIZ
	CASEELSE
		$RETRY
		REUSELASTLINE Invalid input
		CONTINUE
ENDSELECT
SIF NEMUKE() >= 700
	EXIT = 1
BREAK
LOOP 1
SIF !EXIT
	RESTART
CALL CASINO_CHECK_EVENT("EXIT")
