;カジノ用ファンクション

@FUNC_CASINO(TYPE, ARG, ARG:1)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS TYPE
#DIM LCOUNT
#DIM YEN
#DIM CHARISMA
SELECTCASE TYPE
	CASE "DICE"
		;汎用で使えるがダイス関数
		;個人的に改造のたびになんやかんや毎回作って入れてるような気がする
		LOCAL = 0
		FOR LCOUNT, 0, ARG
		LOCAL += RAND(1, ARG:1)
		NEXT
	CASE "TRADE"
		;紅魔館用の為替取引レート
		;基本レート￥200 == 1カリスマ
		LOCAL = CHARISMA_NOW()
	CASE "CLOSE_CASINO"
		;カジノ休業判定
		;廃止になったような気もするが、読みやすいように
		IF 500000 - FLAG:カリスマ流通 <= 10001 ;bugfix custom code, prevent crashing for card games
			LOCAL = 1
		ELSE
			LOCAL = 0
		ENDIF
ENDSELECT
RETURNF LOCAL
;カジノ金銭取引関数
;あなたが1万￥を得た場合には
;CALL CASINO_MONEY("￥", 10000)
;あなたが100カリスマを失った場合には
;CALL CASINO_MONEY("カリスマ", -100)
;
;あなたの最高収入はたぶん一ヶ月で100万には届かない
;紅魔館側で1億＄と50万カリスマを用意

@CASINO_MONEY(TYPE, ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS TYPE
SELECTCASE TYPE
	CASE "￥"
		;払い戻し上限
		IF ARG > 0
			LOCAL = MIN(ARG, 100000000 - FLAG:￥流通)
			SIF LOCAL < 0
				LOCAL = 0
		ELSE
			LOCAL = ARG
		ENDIF
		MONEY += LOCAL
		FLAG:￥流通 += LOCAL
	CASE "カリスマ"
		;払い戻し上限
		IF ARG > 0
			LOCAL = MIN(ARG, 500000 - FLAG:カリスマ流通)
			SIF LOCAL < 0
				LOCAL = 0
		ELSE
			LOCAL = ARG
		ENDIF
		MONEY:2 += LOCAL
		FLAG:カリスマ流通 += LOCAL
	CASE "カモ"
		FLAG:カモられ指数 += ARG
ENDSELECT
;汎用性もクソもねぇ
;さして意味もないDO-LOOPがうざかった

