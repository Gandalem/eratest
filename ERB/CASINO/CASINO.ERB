					台詞 = 「%\@ nameArray:(FLAG:なりきり):na_Callname == "Remilia" ? Ojou # Imouto \@%-sama!」 /「We appreciate Your patronage.」 /「Here, take this gift of 250 Charisma.」 /「Please enjoy yourself.」
					MONEY:2 += 250
				CASE "Patchouli"
					台詞 = 「Welcome %CALLNAME:MASTER%-sama.」 /「Yes, it has been a tremendous success.」 /「Please accept this gift of 200 Charisma from Ojousama.」 /「Please enjoy yourself.」
					MONEY:2 += 200
				CASE "Sakuya"
					台詞 = 「Welcome %CALLNAME:MASTER%-san.」 /「Here to inspect? Everyone is trying their hardest.」 /「Please accept this gift of 200 Charisma from Ojousama.」
					MONEY:2 += 200
