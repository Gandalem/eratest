			CASE 2
				;正々堂々
				D_POINT += 12
				PRINTFORML 요정 마이는 지켜지는 것에 대해 긴장하는 것 같지 않다.
			CASE 3
				;イカサマ
				PRINTFORML 당신은 수상한 움직임을 보이는 요정 메이드에게 응시한다.
				LOCAL = D_DO_IKASAMA + P_STOP_IKASAMA
				IF RAND:LOCAL <= D_DO_IKASAMA
					D_POINT += 15
					PRINTFORML 하지만 요정 메이드가 발각되지 않은 채 자신의 움직임을 성공적으로 마친다.
				ELSE
					PRINTFORML 요정 하녀는 자신의 움직임이 막힌 것에 짜증을 냈다.
				ENDIF
		ENDSELECT
	CASE 2
		;正々堂々
		P_POINT += 12
		SELECTCASE D_ACT
			CASE 1
				;注視
				D_POINT += 9
				PRINTFORML 당신은 공정하게 플레이하지만 요정 하녀가 당신을 응시하는 것을 느낀다.
			CASE 2
				;正々堂々
				D_POINT += 12
				PRINTFORML 게임은 지연 없이 앞으로 나아간다.
			CASE 3
				;イカサマ
				D_POINT += 15
				PRINTFORML 당신은 공정하게 플레이하며 요정 하녀의 가벼운 미소를 무시한다.
		ENDSELECT
	CASE 3
		;イカサマ
		SELECTCASE D_ACT
			CASE 1
				;注視
				D_POINT += 9
				LOCAL = D_STOP_IKASAMA + P_DO_IKASAMA
				PRINTFORML 당신이 속이려고 하지만 요정 하녀가 당신을 유심히 지켜본다.
				IF RAND:LOCAL <= D_STOP_IKASAMA
					PRINTFORML 동작을 끝낼 수 없었다.
				ELSE
					P_POINT += 15
					PRINTFORML 어쨌든 성공했다.
				ENDIF
			CASE 2
				;正々堂々
				D_POINT += 12
				P_POINT += 15
				PRINTFORML 당신은 요정이 공정하게 게임을 하는 동안 능숙하게 속인다.
			CASE 3
				;イカサマ
				D_POINT += 15
				P_POINT += 15
				PRINTFORML 당신과 요정 하녀는 공정하게 플레이하는 척하면서 둘 다 속인다.
		ENDSELECT
ENDSELECT
