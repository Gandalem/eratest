;ツボ振りの呟きを表示する関数
@TOBA_DEALER_TWEET(L_FEED, 状況, NUM_A, NUM_B, SUB = 0)
;L_FEED：表示分類 BIT0 ONでウエイトあり BIT1 ONでCLEARLINE BIT2 ONで必ず表示
#DIM NUM_A
#DIM NUM_B
#DIM SUB
#DIM L_FEED
#DIM EFFECT
#DIM L_COUNT
#DIMS エフェクト = "", "顔絵_ざわ", "顔絵_ぐにゃあ"
#DIMS 状況
#DIMS 表情
#DIMS MESSAGE
#DIMS MESSAGE_PRINT, 50
#DIMS RESOURCE
EFFECT = 0
MESSAGE = %DEALER_TALK_STRINGS(状況, NUM_A, NUM_B, SUB)%
SIF MESSAGE == ""
	RETURN 0
表情 = %RESULTS%
LOCAL = LINECOUNT
;表示部分は@SP_TALKのカスタム
IF !顔絵付きメッセージ || STRFIND(状況, "煽り") > -1
	SIF FLAG:口上色
		SETCOLOR 0xD37CD0
	SPLIT MESSAGE, "/", MESSAGE_PRINT
	FOR L_COUNT, 0, RESULT
		PRINTFORML %MESSAGE_PRINT:L_COUNT%
	NEXT
	RESETCOLOR
	SIF GETBIT(L_FEED, 0)
		WAIT
ELSE
	キャラ画像表示サイズ比 = 100
	VARSET MESSAGE_PRINT
	SIF FLAG:マルチサイズ
		デフォルトキャラ画像横幅 = 180
	RESOURCE = %\@ 状況 == "勝負！" ? SAI_RESULT # 顔絵_はだけ_%表情%_MOB_95 \@%
	CALL IMAGE_SET(RESOURCE, 0, 0, キャラ画像表示サイズ比, 0)
	SIF EFFECT
		CALL IMAGE_SET(エフェクト:EFFECT, 0, 0, キャラ画像表示サイズ比, 1)
	MESSAGE = %SPTALK整形(MESSAGE)%
	SPLIT MESSAGE, "/", MESSAGE_PRINT
	FOR L_COUNT, 0, RESULT
		SIF L_COUNT != 0 || EFFECT
			CALL DUMMY_SET(0, 0, キャラ画像表示サイズ比, L_COUNT)
		TEMP_HTML:L_COUNT += @"<font color='#0xD37CD0'>%MESSAGE_PRINT:L_COUNT%</font>"
	NEXT
	CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
	IF GETBIT(L_FEED, 0)
		PRINTW 
	ELSE
		PRINTL
	ENDIF
ENDIF
SIF GETBIT(L_FEED, 1)
	CLEARLINE LINECOUNT - LOCAL
RETURN 1

;ツボ振りの呟きと表情を決める式中関数
@DEALER_TALK_STRINGS(状況, NUM_A, NUM_B, SUB)
#FUNCTIONS
#DIM NUM_A
#DIM NUM_B
#DIM BIAS
#DIM SUB
#DIM POS
#DIM 初回
#DIMS 賭け = "Even", "Odds"
#DIMS 状況
#DIMS 台詞
#DIMS 候補
#DIMS 呼称
呼称 = %\@ TALENT:MASTER:性別 == 2 ? fella # darling \@%
POS = NUM_A - NUM_B
RESULTS = 通常
台詞 = 
SELECTCASE 状況
	;チンチロリン台詞
	;ツボ振り挨拶
	CASE "挨拶"
		STRDATA 台詞
			DATAFORM 「Looks like all the players are in...」/「I see %BAKUTO_NAME_TR:5% and %BAKUTO_NAME_TR:6% will be joining us as well. \@ 初回 == DAY ? You feel like you wanna keep going, eh ladies?」/「Let's all have fun together once again, shall we?」 # First time here, ladies?」/「Make sure you have lots of fun today, y'hear?」\@
			DATAFORM 「Alrighty, guess we can get started now.」/「\@ 初回 == DAY ? I'll act as your humble dealer today and shake the cup for ya lot.」/「We ain't got enough people here to do it, anyhow.」 # I'll be acting as your dealer once again... I'm not much of a celebrity, so I think there's no need to introduce myself.」/「After all, I'm but another resident of the mountain.」/「Pleased to meet y'all.」 \@
			DATAFORM 「Well then fellas, you ready to game?」/「Before we begin, lemme make this clear - %SPLIT_G("set your feelings aside no matter the result:win or lose, no hard feelings:we bear no grudges here whether you win or lose")%. Alright?」/「What matters is that we all get our share of fun, that's what counts!」
		ENDDATA
		初回 = DAY
	;ツボ振り直前
	CASE "スタート口上"
		SELECTCASE SUB
			CASE 0 ;showdown accepted
				STRDATA 候補
					DATAFORM 「That's the spirit!」
					DATAFORM 「Now we're talking!」
					DATAFORM 「Alright! I'm already chomping at the bit!」
					DATAFORM 「I was sure you would take me up on it, %呼称%!」
					DATAFORM 「I knew you had it in you, %呼称%!」
					DATAFORM 「Now the fun part begins!」
				ENDDATA
				台詞 = %候補%/「Well then, you ready? Best of luck!」
			CASE 1 ;first speech on subsequent rounds
				候補 = %TEXTR(@"「...Well, enough with the pleasantries now.」/「...I guess you all had enough of my smack talk by now, so I'll make it short.」/「...Now, who's up for some more?」/「Are we up for another game? That's what I thought.」")%
				台詞 = %候補%/「Without further ado, let's get the fun started!」
			CASEELSE
				STRDATA 台詞
					DATAFORM 「Alright, let's %\@ RAND:2 ? give it another go # keep that party going \@%!」
					DATAFORM 「Yup-yup, %\@ RAND:2 ? the fun's just about to begin # there's still plenty of games to be had \@%!」
					DATAFORM 「Great, I think we're all starting to get up to speed, ain't we?」
					DATAFORM 「Come now, why don't we have another game?」
					DATAFORM 「Let's keep it rollin', eh?」
					DATAFORM 「That's it, that's it, onto the next game!」
					DATAFORM 「Come on now guys, place your bets and guess it right, don't be shy!」
					DATAFORM 「Dear, I can keep playing with you as much as your heart desires!」
					DATAFORM 「Now-now, who's ready for more? All in? Great!」
				ENDDATA
		ENDSELECT
	CASE "構え口上" ;rolling the dice
		STRDATA 台詞
			DATAFORM 「The cup's down, ready?」
			;not sure about these two, but I think she's spoiling the result pretty much
			DATAFORM 「%CH_PRIZE_TR:NUM_A:NUM_B%, going in...」
			DATAFORM 「Rolling with %CH_PRIZE_TR:NUM_A:NUM_B%...」
			DATAFORM 「The dice are in!」
		ENDDATA
	;ツボかぶり
	CASE "被り口上" ;ask to make a bet on even or odds
		;RESULTS =  賽振り
		台詞 = 「There it is%\@ SUB ? , Even or Odds, call it # ! They're in, place your bets \@%!」
	;丁半選択時合いの手
	;NUM_A=丁選択人数 NUM_B=半選択人数 SUB=張り方 0=丁 1=半
	CASE "煽り" ;dealer hype, placing the bets
		BIAS = ((POS > 0 && !SUB) || (POS < 0 && SUB))
		IF ABS(POS) > 2 && BIAS
			台詞 = 「Huuuh?! A bet on %賭け:SUB%%COND_STR(@", agaiiin", ABS(POS) > 3)%?!」/
		ELSE
			台詞 = 「%SPLIT_G("I see a bet on:We got a bet on")% %賭け:SUB%, I repeat, a bet on %賭け:SUB%!」/
		ENDIF
		SELECTCASE ABS(POS)
			CASE 0
				STRDATA 候補
					DATAFORM 「Even or Odds, Odds or Even?! Come on, come on, make your choice!」
					DATAFORM 「Go on, choose either or both!」/「Any bets on %賭け:(!SUB)%? %賭け:SUB%, anyone?」
					DATAFORM 「Would someone bet on %賭け:(!SUB)%? Or maybe %賭け:(!SUB)%? Don't make me wait!」
					DATAFORM 「Even or Odds, place your bets RIGHT NOW!」
				ENDDATA
			CASE 1, 2
				STRDATA 候補
					DATAFORM 「Any more bets on %賭け:(POS > 0)%? What about %賭け:(!SUB)%? You decide!」
					DATAFORM 「Good bets, good bets! Would anybody put some on %賭け:(POS > 0)%?」/「Even or Odds, Odds or Even?! Come on, come on, make your choice!」
					DATAFORM 「Come on come on, keep the bets coming! Place some on %賭け:(!SUB)% too, it might win!」
					DATAFORM 「Even or Odds, call it, come on!」/「Any bets on %賭け:(POS > 0)%? %賭け:(!SUB)%, anyone?」
				ENDDATA
			CASE 3, 4, 5
				STRDATA 候補
					DATAFORM 「Everyone just gonna ignore %賭け:(POS > 0)% like that? %賭け:(POS > 0)%, folks!」/「%賭け:(POS > 0)% is sitting all lonely out there!」
					DATAFORM 「Oi-oi, %\@ BIAS ? no one's gonna bet on %賭け:(POS > 0)% or something? # we finally got a bet going on %賭け:(POS > 0)%, is that all you got? \@%!」/「Come on folks, come on, anyone wants to bet on %賭け:(POS > 0)%? %賭け:(POS > 0)%, hurry up folks!」
					DATAFORM 「What the heck, whaaaat?! %\@ BIAS ? No one likes %賭け:(POS > 0)% or what? # %賭け:(POS > 0)% just got its first bet, at last! \@%」/「Do I hear a bet on %賭け:(POS > 0)%? No? C'mon, someone please place a big fat bet on %賭け:(POS > 0)%!」
					DATAFORM 「Hey hey, wait a sec! %賭け:(POS > 0)% ain't got enough bets yet! See?」/「Come on folks, %\@ BIAS ? it's no fun if everybody chooses the same # %賭け:(POS > 0)% can use some more bets, keep it coming \@%!」/「Are we going to bet on %賭け:(POS > 0)% or what?! I can't hear you!」
				ENDDATA
			CASE 6
				RESULTS = 怒り
				STRDATA 候補
					DATAFORM 「Hey now, hey, hey! What's the big idea, what the hell's this?!」/「You guys conspiring with each other or something? 'Cos it certainly looks like it to me!」
					DATAFORM 「Oi-oi, you gotta be kidding me right now!」/「If it ain't the saddest state of the betting pool, I don't know what this is!」/「Is that the kind of game you wanna play? Huh?!」/「You call this gambling? This dull farce?!」
					DATAFORM 「Oh, come on you guys! Gimme a break already, geez!」/「How on earth did it get so lop-sided?!」
					;added
					DATAFORM 「Come on guys, stop screwing around, seriously...」/「This ain't betting, this is just... a clown show, is what it is!!!」
				ENDDATA
		ENDSELECT
		台詞 = %台詞%%候補%
	;ツボを開く直前
	CASE "予想終了" ;bets are in
		LOCALS:9 = %SPLIT_G("Here we go!:Let's see it!:Let the game begin!:It's show time!:The game is on!")%
		;サシ勝負
		IF SUB
			台詞 = 「%TEXTR(@"%賭け:NUM_A%, is that right?/%賭け:NUM_A%, you sure?/The bets are all in. %賭け:NUM_A%, then?/%賭け:NUM_A%... Looks like we've made a decision here, folks.")%」
			STRDATA 候補
				DATAFORM 「Who will win, me or you, %呼称%?」/「...%LOCALS:9%!」
				DATAFORM 「Is that so, %呼称%? So that's gonna be your move, huh.../「Very well, %TOLOWER(LOCALS:9)%!」
				DATAFORM 「You seem fully determined, %呼称%, I sure love to see it...」/「Alrighty, %TOLOWER(LOCALS:9)%!」
			ENDDATA
			台詞 = %台詞%/%候補%
		;通常
		ELSEIF ABS(POS) < 7
			台詞 = 「Looks like we got equal bets between Even and Odds.」/「...%LOCALS:9%!」
		;全員同じ張り方
		ELSE
			RESULTS = 怒り
			台詞 '= @"「Aww man... Things just went out of hand, but what can you do.」/"
			;not sure about these two
			台詞 += @"「This ain't gonna match the rate of this setting at all, but so be it.」/"
			台詞 += @"「Payout from %賭け:(POS > 0)% will be taken from our establishment's budget.」/"
			台詞 += @"「HOWEVER... It doesn't mean you can just game the system willy-nilly.」/"
			台詞 += @"「The rules will be upheld, and there's that.」/"
			台詞 += @"「So even if you manage to win you ain't gonna break the bank, so forget about it!」"
		ENDIF
	;賽の目表示
	CASE "勝負！" ;reveal
		台詞 = 「%CH_PRIZE_TR:NUM_A:NUM_B%!!!」
		LOCALS:9 = %\@ !SUB ? Even # Odds \@%
		SIF RAND:2
			台詞 = %台詞%/「We got %LOCALS:9% everyone%COND_STR(@", I repeat, we got %LOCALS:9%", !RAND:4)%!」
	CASE "継続口上" ;ask to continue
		IF NUM_A
			STRDATA 候補
				DATAFORM 「Hey %呼称%, you ain't just gonna quit on us while you're ahead, right?」
				DATAFORM 「Hey %呼称%, you ain't one of those who runs away after a single win, right?」
				DATAFORM 「Hey %呼称%, %\@ NUM_B ? it just got you all excited, didn't it # I see you're getting into the swing of things, ain't that right \@%?」
				DATAFORM 「%\@ NUM_B ? You're on a roll today, ain'tcha # Looks like you still got it, eh \@% %呼称%?」
			ENDDATA
		ELSE
			STRDATA 候補
				DATAFORM 「It wouldn't be pleasant to just quit here, now would it?」
				DATAFORM 「Ohh %呼称%, %呼称%... Don't you think it's time for you to change gears and win back?」
				DATAFORM 「I know what you're thinking... "I gotta turn the game around and come back from this", ain't that right %呼称%?」
				DATAFORM 「Gonna get 'em next time, right?」/「That kind of mindset is key when it comes to gambling, you know.」
				DATAFORM 「Bad luck, but what can you do... Doesn't mean you're stopping now, right?」/「It takes a lot of spunk to take a gamble like that.」/「So come on, show it to us!」
			ENDDATA
		ENDIF
		台詞 = %候補%/「%TEXTR("Surely you wanna keep going, I take it/How about another game/One more... How about it")%?」
	;サシ勝負持ちかけ
	CASE "サシ持ちかけ"
		;showdown offer
		STRDATA 候補
			DATAFORM 「Nothing beats the high after blowing everyone out of the water, am I right %呼称%?」
			DATAFORM 「My my, looks like our %呼称% made it big this time!」
			DATAFORM 「Looks like fortune smiles upon you today, my %呼称%. Lucky you!」
		ENDDATA
		台詞 = %候補%/「Say, how about you wager that prize money in a showdown with me?」/「Double your prize, or lose it all.」
		STRDATA 候補
			DATAFORM 「Bet it all on a single roll of the dice, plain and simple, right?」
			DATAFORM 「Sounds like an exciting gamble, don'tcha think?」
			DATAFORM 「There's your chance! Smells like a big profit, doesn't it?」
		ENDDATA
		台詞 = %台詞%/%候補%/「What say you?」
	;	ハハ
	;（ ﾟωﾟ ）お断りします
	CASE "サシお断り" ;refuse showdown
		RESULTS = 泣き
		候補 = 「Oh... Huh.」/「%TEXTR("That's a shame./What a pity./Oh well, that's good reasoning, I guess./Heh, giving me a cold shoulder, eh?/Looks like I got turned down, dear me.")%」
		STRDATA 台詞
			DATAFORM 「It is what it is.」
			DATAFORM 「No matter, I'll be looking forward to the next one.」
			DATAFORM 「Fair enough, there's always a next one.」
			DATAFORM 「You're one sly %呼称% to refuse a woman's offer, you know that?」
		ENDDATA
		台詞 = %候補%/%台詞%
	;サシ勝負あなたの勝ち
	CASE "サシで負け" ;player wins, dealer loses
		SELECTCASE RAND:4
			CASE 0, 1
				STRDATA 台詞
					DATAFORM 「Aww dear, that's my defeat, fair and square.」/「I'm no match for you it seems, %呼称%.」
					DATAFORM 「Grats, well done!」/「It's your win this time, my %呼称%.」/「Here, you've earned it!」
					DATAFORM 「Woow, it's been a while since I got smashed to pieces like this...」/「That was really good, %呼称%. The thrill alone was well worth it.」
					DATAFORM 「Ahahaha, you reaaaally don't pull your punches, do you %呼称%?」/「Treat me to something with that prize money you got sometime, alright?」
				ENDDATA
			CASE 2, 3
				RESULTS = 泣き
				STRDATA 台詞
					DATAFORM 「...Ohh man.」/「I got beaten to the punch, eh?」
					DATAFORM 「Ahaha...」/「It's my loss, it seems...」/「I done goofed it all up!」
					DATAFORM 「Ouch, oof...」/「And I really wanted some extra pocket money, too...」
				ENDDATA
			CASE 4
				RESULTS = 怒り
				STRDATA 台詞
					DATAFORM 「...Tsk!」/「I screwed up big time, sure I did.」
					DATAFORM 「...Dammit!」/「%SPLIT_G("I'm getting rusty:I'm losing my touch:My luck is running out")%, alright.」
				ENDDATA
		ENDSELECT
	;サシ勝負あなたの負け
	CASE "サシで勝ち" ;dealer wins, player loses
		STRDATA 台詞
			DATAFORM 「So sorry about that!」/「But that's the game for ya, and we had a deal, so I'll eagerly help myself to it!」
			DATAFORM 「Yesss!!!」/「...All the money I win here goes straight into my pocket.」/「It's the reason why I'm so fired up, y'see.」
			DATAFORM 「You were so close, too bad!」/「It's my payday this time!」
			DATAFORM 「Shame, shame. %SPLIT_G("Looks like your luck ran out at the worst possible moment,:No one's luck lasts forever, remember that")% %呼称%.」
			DATAFORM 「Ahaha, you sure missed out on some big prize money.」/「That gotta hurt, my bad.」
			DATAFORM 「Ahaha, easy moneyyy, lucky me!」/「Now I feel like going for a nice expensive drink♪」
			;added
			DATAFORM 「Easy come, easy go, as they say.」/「Well, cheer up, it's no reason to feel down!」/「I'm sure you'll come back from this eventually.」
			DATAFORM 「When the deck is stacked so far in your favor, and you still lose, that must be very painful.」/「I really am sorry, %呼称%♪」
		ENDDATA
ENDSELECT
RETURNF 台詞

;ダイス画像を一個一個丁寧に手作りする関数
;標準でダイス３個、ARGが真ならダイス２個の画像をセット
;ARG == 2なら丁半用背景画像をセット
@TOBA_CREATE_DICEIMAGE(DICE:0, DICE:1 = 0, DICE:2 = 0, ARG = 0)
#DIM DICE,3
#DIM GID
#DIM L_COUNT
#DIM POS_X, 3 = 14, 67, 114
#DIM POS_Y, 3 = 109, 125, 91
#DIM RAND_X
#DIM RAND_Y
IF GID
	SPRITEDISPOSE "SAI_RESULT"
	GDISPOSE GID
ENDIF
GID= 0
CALL COMPOSE_IMAGE(GID, @"%\@ ARG == 2 ? CH_BASE # ダミー \@%")
FOR L_COUNT, 0, 3
	SIF L_COUNT == 1 && ARG
		CONTINUE
	;表示位置にばらつきを持たせる
	RAND_X = ARG == 2 ? RAND(1, 16) - 9 # RAND(1, 7) - 4 
	RAND_Y = ARG == 2 ? RAND(1, 16) - 9 # RAND(1, 7) - 4
	CALL COMPOSE_IMAGE(GID, @"D_SURF_{DICE:L_COUNT}", POS_X:L_COUNT + RAND_X, POS_Y:L_COUNT + RAND_Y, 46, 55)
NEXT
SPRITECREATE "SAI_RESULT", GID
RETURN

;コマ札変動を表示位置揃えて表示する関数
@TOBA_RESULT_PRINT(TGT, BP, ARG = 0)
#DIM BP
#DIM NUM
#DIM TGT
#DIM COLOR
#DIMS STRINGS
COLOR = BP > 0 ? C_GREEN # C_D_RED
STRINGS = %BAKUTO_NAME_TR:TGT% \@ BP > 0 ? wins%" "% # loses \@%" "%
;custom code
;NUM = (26 + ARG) - STRLENSU(BAKUTO_NAME_TR:TGT)
;STRINGS = %STRINGS%%UNICODE(0x3000) * NUM%
STRINGS = %STRINGS, 26 + ARG, LEFT%
PRINTFORM %STRINGS%
CALL COLORMESSAGE(@"%\@ BP > 0 ? ＋ # － \@%{ABS(BP)}", COLOR, 1, 1)
RETURN

;持ちゴマと遊戯回数を表示する関数
@PRINT_TOBA_STATE(回数, レート, ウエイト)
#DIM 回数
#DIM レート
#DIM ウエイト
#DIM レート色 = C_AQUA, C_WHITE, C_YELLOW, C_D_PINK
#DIMS レート表示 = "Low", "Default", "High", "Max"
DRAWLINE
PRINTFORML ～%NUM_COUNT(回数, "pos", 1)% Round～　　　　　　Current Time - %時刻表示(TIME)% 
PRINTFORML 
SIF ウエイト
	TWAIT 750, 0
PRINTFORML %"Your Chips:", 26, LEFT%%三桁区切(KOMAFUDA:MASTER)%
PRINTFORM Current Rate: 
CALL COLORMESSAGE(レート表示:レート, レート色:レート, 1, 1)
PRINTFORML 
RETURN

;配列を{ARG}個のダイス目で埋める参照関数
@TOBA_FILL_DICE(ダイス目, ARG)
#DIM REF ダイス目, 0
#DIM L_COUNT
FOR L_COUNT, 0, ARG
	ダイス目:L_COUNT = RAND(1, 7)
NEXT
RETURN

;賭場セッティング関数
@TOBA_SETUP
#DIM 設定済
#DIM 代入済
#DIM L_COUNT
#DIM KOMA
#DIMS 種族, 3
#DIMS 呼び名
;一日一回所持金確認,モブ子博徒定義
SIF 設定済 == DAY
	RETURN
設定済 = DAY
;NPC持ちゴマはあなた所持金の４割に設定
;パッチ取り込まれたらもう少しきちんと処理したい
KOMA = MONEY / 1000 * 4
KOMA = MAX(KOMA, 500) 
VARSET KOMAFUDA, KOMA, 1, 7

VARSET 種族
FOR L_COUNT, 0, 2
	DO
		種族:L_COUNT = %TEXTR("イナバ/妖精/白狼天狗/鬼/化け狸/化け猫/化け狐/茨たぬき/販売員")%
	LOOP 種族:0 == 種族:1
	CALL モブ店員画像作成(25 + L_COUNT, 種族:L_COUNT)
	BAKUTO_WORDCOLOR:(5 + L_COUNT) = モブ子店員口上色:(25 + L_COUNT)
	BAKUTO_NAME_TR:(5 + L_COUNT) '= 種族:L_COUNT
NEXT
FOR L_COUNT, 0, 2
	;custom code
	IF BAKUTO_NAME_TR:(5 + L_COUNT) == "茨たぬき"
		BAKUTO_NAME_TR:(5 + L_COUNT) = Tanuki Henchman
	ELSE
		BAKUTO_NAME_TR:(5 + L_COUNT) '= RACE_TR(BAKUTO_NAME_TR:(5 + L_COUNT))
	ENDIF
	;set the player name
	BAKUTO_NAME_TR:0 = %CALLNAME:MASTER%
NEXT
;ゲーム中に１回ニ次元配列変数を定義
SIF 代入済
	RETURN
代入済 = 1
