ELSE
	FOR L_COUNT, 0, 7
	CH_PROFIT:L_COUNT = -(賭駒:L_COUNT)
	KOMAFUDA:L_COUNT += CH_PROFIT:L_COUNT
	NEXT
ENDIF
;ランダムで誰か一言
TGT = RAND(1, 7)
CALL TOBA_GAMBLER_TWEET(TGT, @"%\@ CH_BET:TGT == 結果 ? 安堵 # 失望 \@%", 0, 0, 7)
