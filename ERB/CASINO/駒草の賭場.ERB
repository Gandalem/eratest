@THROW_CHINCHIRO_DICE(振り手, ARG)
#DIM 出目
#DIM L_COUNT
#DIM D_COUNT
#DIM 賽, 3
#DIM DICE, 3
#DIM 失敗率
#DIM ファンブル
#DIM 振り手
;ファンブル率2％、あなたのみ眠気ありで+2％
失敗率 = 1 + (!振り手 && NEMUKE() >= 540) * 2
ファンブル = 0
CALL TOBA_GAMBLER_TWEET(振り手, "一投目", ARG)
FOR L_COUNT, 1, 4
LOCAL = LINECOUNT
CALL TOBA_FILL_DICE(賽, 3)
VARSET DICE
ARRAYCOPY "賽", "DICE"
;昇順に並び替え
ARRAYSORT DICE, FORWARD
;値が同じ=ゾロ目
IF ALLSAMES(DICE:0, DICE:1, DICE:2)
	IF DICE:0 == 1
		出目 = 15
	ELSE
		出目 = 15 - (7 - DICE:0)
	ENDIF
	;値が全て異なる=目無し/ヒフミ/シゴロ
ELSEIF !((DICE:0 == DICE:1) || (DICE:1 == DICE:2) || (DICE:0 == DICE:2))
	IF DICE:0 == 1 && DICE:2 == 3
		出目 = 0
	ELSEIF DICE:0 == 4 && DICE:2 == 6
		出目 = 9
	ELSE
		出目 = 2
	ENDIF
	;XXYパターン=Yの値で判定
ELSEIF DICE:0 == DICE:1
	出目 = 2 + DICE:2
	;XYYパターン=Xの値で判定
ELSE
	出目 = 2 + DICE:0
ENDIF
;ファンブル判定
ファンブル = RAND:100 <= 失敗率 ? 1 # 0
PRINTFORML ~ %NUM_COUNT(L_COUNT, "pos", 1)%의 주사위를 던진다~
REDRAW 0
IF FLAG:画像表示
	CALL TOBA_CREATE_DICEIMAGE(賽:0, 賽:1, 賽:2, ファンブル)
	CALL PRINT_IMAGE_ANIMATION("SAI_",0 ,13, 1, 0, 33)
	CALL PRINT_IMAGE("SAI_RESULT")
	TWAIT 250, 0
ELSE
	FOR D_COUNT, 0, 3
	PRINTFORM %NUM_COUNT(賽:D_COUNT, "pos", 1)%　%COND_STR(@"!", D_COUNT == 2)%
	TWAIT 30 + RAND(25, 50 + D_COUNT * 20), 0
	NEXT
ENDIF
IF ファンブル
	PRINTFORML 뭐야?!
	PRINTFORML %BAKUTO_NAME_TR:振り手%의 주사위 굴림이 %TEXTR("다른 곳으로 날아가거나/모두 눈앞에서 순식간에 사라지거나/갑자기 생긴 빈틈에 휘말리거나/솥에게 거절당한 것처럼 바닥에 떨어지는 것")%로 끝났다...
	SIF !振り手
		TWAIT 1000, 0
	出目 = 1
	BREAK
ELSEIF 出目 == 2
	PRINTFORML 「\@ L_COUNT < 3 ? 결과가 불명확하여 재시도한다. # 세 번의 시도 내에 조합을 얻지 못했다, 운이 없군... \@」
	CALL TOBA_GAMBLER_TWEET(振り手, "n投目", L_COUNT, 0, (3 + (L_COUNT == 3) * 4))
	SIF !RESULT
		TWAIT 1000, 0
	REDRAW 0
	CLEARLINE LINECOUNT - LOCAL
	SIF L_COUNT < 3
		CONTINUE
	REDRAW 1
ENDIF
BREAK
NEXT
RESULT = 0
IF 出目 == 2 || !振り手
	;出目が極端なら必ずつぶやく
ELSEIF 出目 == 0 || (INRANGE(ARG, 0, 4) && ARG > 出目)
	CALL TOBA_GAMBLER_TWEET(振り手, "悲鳴", 出目, 0, 7)
ELSEIF 出目 == 1
	CALL TOBA_GAMBLER_TWEET(振り手, "罵声", 出目, 0, 7)
ELSEIF 出目 > 8 || (ARG > 6 && 出目 > ARG)
	CALL TOBA_GAMBLER_TWEET(振り手, "歓声", 出目, 0, 7)
	;通常の勝ち負け/出目
ELSEIF (ARG < 0 && INRANGE(出目, 3, 4)) || ARG > 出目
	CALL TOBA_GAMBLER_TWEET(振り手, "失望", 出目)
ELSEIF (ARG < 0 && INRANGE(出目, 7, 8)) || (ARG >= 0 && ARG < 出目)
	CALL TOBA_GAMBLER_TWEET(振り手, "安堵", 出目)
ENDIF
SIF !RESULT
	TWAIT 600, 0
REDRAW 1
RETURN 出目
;博徒の呟きを表示する関数
;CHARA:1=山童 2=河童 3= 鴉天狗, 4=蟒蛇 5=ランダムモブ子Ａ 6=ランダムモブ子Ｂ
;L_FEED：表示分類=BIT0 ONでウエイトあり BIT1 ONでCLEARLINE BIT2 ONで必ず表示

@TOBA_GAMBLER_TWEET(CHARA, 状況, 分類, SUB = 0, L_FEED = 3)
#DIM CHARA
#DIM 分類
#DIM L_FEED
#DIM SUB
#DIM EFFECT
#DIM L_COUNT
#DIM 表示CID = 0, 91, 92, 93, 94, 25, 26
#DIMS エフェクト = "", "顔絵_ざわ", "顔絵_ぐにゃあ"
#DIMS 状況
#DIMS 表情
#DIMS MESSAGE
#DIMS FONTCOLOR
#DIMS MESSAGE_PRINT, 50
;ペラペラ喋ると発言すぐ被るので発生抑えめ
SIF !(!RAND:3 || 分類 == 15 || GETBIT(L_FEED, 2)) || CHARA == MASTER
	RETURN 0
EFFECT = 0
MESSAGE = %BAKUTO_TALK_STRINGS(CHARA, 状況, 分類, SUB)%
DEBUGPRINTFORML {CHARA} %MESSAGE%
SIF MESSAGE == ""
	RETURN 0
表情 = %RESULTS%
LOCAL = LINECOUNT
;表示部分は@SP_TALKのカスタム
IF 顔絵付きメッセージ
	キャラ画像表示サイズ比 = 100
	FONTCOLOR = %TOSTR(BAKUTO_WORDCOLOR:CHARA, "X")%
	VARSET MESSAGE_PRINT
	SIF FLAG:マルチサイズ
		デフォルトキャラ画像横幅 = 180
	CALL IMAGE_SET(@"얼굴그림_옷_%表情%_스침_{表示CID:CHARA}", 0, 0, キャラ画像表示サイズ比, 0)
	SIF EFFECT
		CALL IMAGE_SET(エフェクト:EFFECT, 0, 0, キャラ画像表示サイズ比, 1)
	MESSAGE = %SPTALK整形(MESSAGE)%
	SPLIT MESSAGE, "/", MESSAGE_PRINT
	FOR L_COUNT, 0, RESULT
	SIF L_COUNT != 0 || EFFECT
		CALL DUMMY_SET(0, 0, キャラ画像表示サイズ比, L_COUNT)
	TEMP_HTML:L_COUNT += @"<font color='#%FONTCOLOR%'>%MESSAGE_PRINT:L_COUNT%</font>"
	NEXT
	CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
	IF GETBIT(L_FEED, 0)
		PRINTW 
	ELSE
		PRINTL
	ENDIF
ELSE
	SIF FLAG:口上色
		SETCOLOR BAKUTO_WORDCOLOR:CHARA
	SPLIT MESSAGE, "/", MESSAGE_PRINT
	FOR L_COUNT, 0, RESULT
	PRINTFORML %MESSAGE_PRINT:L_COUNT%
	NEXT
	RESETCOLOR
	SIF GETBIT(L_FEED, 0)
		WAIT
ENDIF
REDRAW 0
SIF GETBIT(L_FEED, 1)
	CLEARLINE LINECOUNT - LOCAL
REDRAW 1
RETURN 1
;博徒の呟きと表情を決める式中関数
;キャラ:1=山童 2=河童 3=鴉天狗 4=蟒蛇 5=ランダムモブ子１ 6=ランダムモブ子２

@BAKUTO_TALK_STRINGS(キャラ, 状況, 分類, SUB = 0)
#FUNCTIONS
#DIM キャラ
#DIM 分類
#DIM SUB
#DIM 初回
#DIM 定義済
#DIM L_COUNT
#DIMS 賭け = "Even", "Odds"
#DIMS 自称, 2
#DIMS 状況
#DIMS 台詞
#DIMS 候補
#DIM nPersonality, 2 ;custom code
RESULTS = 通常
台詞 =
IF 定義済 != DAY
	定義済 = DAY
	FOR L_COUNT, 0, 2
	自称:L_COUNT = %TEXTR("わたし/私/あたい/あたし/")%
	SIF !RAND:4
		自称:L_COUNT = %TEXTR("ボク/僕/")%
	nPersonality:L_COUNT = RAND:4 ;%SPLIT_G("normal:child:girly:tomboy")%
	NEXT
ENDIF
SELECTCASE 状況
	;チンチロリン台詞
	;親・子の一投目：分類 = 親の出目
	CASE "一投目" ;rolling the dice, 分類 sets their reaction according to dealer's roll
		SELECTCASE 分類
			;親がピン以下勝ち確時の煽り
			CASE 0 TO 3 ;if dealer rolled very poorly and instalost
				SELECTCASE キャラ
					CASE 1
						STRDATA 台詞
							DATAFORM 「나나, 혹시 돈을 새처럼 뿌리는 부류인가?」/「뭐, 상관없어! 나도 좀 가져갈게, 정말 고마워♪」
							DATAFORM 「가만히 앉아 아무것도 안 하는데 계속 칩이 늘다니 믿기지 않아.」/「정말로... 이 도박장이 아주 끝내주는 곳이군♪」
							DATAFORM 「뭐, 위로가 된다면 나중에 좋은 일이 생길 거라고 확신해.」/「하지만 네가 여기 있는 동안은 지금처럼 남아 우리를 잘 먹여줘♪」
							DATAFORM 「때로는 지는 것이 승리를 얻는 데 필요하다고들 하지.」/「그러니까 결국 이기는 한 아무 문제 없다고 보는 거지?」/「그렇기에... 우리를 위해 좀 더 많은 승리를 양보해야 해♪」
						ENDDATA
					CASE 2
						STRDATA 台詞
							DATAFORM 「분 단위로 부자가 되다니 정말 대단하네,」/「순식간에 모두에게 저렇게 칩을 나눠주다니!」/「맞지 않아, 우리의 귀한 후원자님?♪」
							DATAFORM 「%SPLIT_G("돈 다 고맙다: 여기에서 정말 좋은 시간을 보낼 것 같아!")%♪」
							DATAFORM 「있잖아, 네가 엄청난 돈을 잃은 건 알지만, 지금 무슨 생각을 하고 있는 거야?」/「이봐, 말해봐, 말해줘! 기분이 어때, 응?」
							DATAFORM 「푸훗! 푸-푸... 큭큭!」/「...ㅋㅋ, 대박♪」
							DATAFORM 「아니야 아니야 아니야...」/「오오오오...」/「(헉) 풉하하하!」
							DATAFORM 「아야 아파라, 인구 - 너야, 친구♪」
						ENDDATA
					CASE 3
						STRDATA 台詞
							DATAFORM 「아하하! 심지어 칩들도 네 손에서는 편치 않다고 말해!」/「하지만 걱정 마, 내가 기꺼이 그 책임을 지고 가져갈게♪」
							DATAFORM 「만나서 반가워, 너 돈으로 모두를 웃게 만들다니.」/「너 정말 대단한 성녀로구나, 얘야!」/「벌써 네 위에 후광 같은 게 떠 있는 것 같아져 가네♪」
							DATAFORM 「우와, 이게 무슨 마법이야?! 손 하나 까딱 안 하고 칩을 더 얻었다고?」/「어머, 귀여워라, 그럴 필요 없었어! 이렇게 돈 벌기 좋은 방법이라니♪」
							DATAFORM 「사람들의 불행도 꿀 맛이라고들 하던걸♪」/「그리고 정말이지, 영원히 핥고 싶을 정도야!」
						ENDDATA
					CASE 4
						RESULTS = 笑顔
						STRDATA 台詞
							DATAFORM (큰 뱀이 원을 그리며 몸을 말고 있다...)
							DATAFORM (큰 뱀이 기쁨에 차 입을 크게 벌린다...)
							DATAFORM (큰 뱀이 용수철처럼 튕기기 전에 스스로 몸을 감는다...)
							DATAFORM (큰 뱀이 포식자의 섬뜩한 빛을 눈에 담고 입술을 핥는다...)
						ENDDATA
				ENDSELECT
			CASE 4 ;2-pointer
				SELECTCASE キャラ
					CASE 1
						STRDATA 台詞
							DATAFORM 「내 승리는 결정된 것 같군。」/「이걸로 내가 질 리가 없지!」
							DATAFORM 「후후후! 그렇게 쉽게 내게 기회를 주어서 고맙네.」
							DATAFORM 「결국 이건 진지한 게임이니까. 그러니 누구도 방심할 수 없어!」
							DATAFORM 「여기서 제대로 된 승리를 확정 지을 테다.」
							DATAFORM 「상황이 좋지 않아... 오호, 너 정말 끝났구나!」
						ENDDATA
					CASE 2
						STRDATA 台詞
							DATAFORM 「와, 우리한테 힘 빼고 있는 거야?」/「그럼 내 마음대로 전력을 다해 봐야겠어!」
							DATAFORM 「아, 정말 너 너무 관대하다! 나 너한테 넘어갈지도 모르겠어.「 / 」하지만 네 본을 따지는 건 아닐 것 같아♪」
							DATAFORM 「미리 사과할게, 개인적으로 받아들이지 마~「 / 」하지만 이건 시합이니까, 내가 해야 할 일을 해야 해♪」
							DATAFORM 「아하하! 정말 미안해, 네 마음이 너무 안쓰러워♪「 / 」걱정 마, 잠시 후에 내 던짐으로 끝내줄게~」
							DATAFORM 「네 기대에 부응할 수 있길 바라야 할 거야, 왜냐면 그럴 것 같지 않거든!」
						ENDDATA
					CASE 3
						STRDATA 台詞
							DATAFORM 「미안하지만, 이제부터는 내가 플레이할 거야.」
							DATAFORM 「뭐, 알다시피 이런 일은 가끔 생기는 거지!」/「너무 상심하지 마!」
							DATAFORM 「이길 수 있다면 해보는 거지, 뭐.」
							DATAFORM 「아하하, 정말 관대하시네!」/「이렇게 관대한 후원은 거절할 수 없지!」
							DATAFORM 「페어플레이. 이제 내가 당신을 손쉽게 쓰러뜨릴 차례야♪」
						ENDDATA
					CASE 4
						STRDATA 台詞
							DATAFORM (빅 스네이크가 입으로 주사위를 집어 던졌다.)
							DATAFORM (빅 스네이크는 능숙하게 혀를 이용해 주사위를 굴렸다.)
							DATAFORM (빅 스네이크는 꼬리로 주사위 굴림을 했다. / 주사위들이 공중으로 날아올라 잔 안에 정확히 착지했다...)
						ENDDATA
				ENDSELECT
			CASE -1, 5, 6 ;3,4 pointer, dealer's first roll
				LOCALS:9 = %SPLIT_G("Shoot:Go:Rolling:Here goes:Heave-ho:Let's go")%!
				SIF !RAND:10
					LOCALS:9 = Come on, come on, baby needs a new pair of shoes!
				SELECTCASE キャラ
					CASE 1
						STRDATA 台詞
							DATAFORM 「좋아, 주사위 굴릴 시간이야!」
							DATAFORM 「간다... 여기 있다!」
							DATAFORM 「자 그럼, 시작해 볼까.」
							DATAFORM 「조심스럽게, 조심스럽게... 여기 있다!」
							DATAFORM 「%LOCALS:9%」
							DATAFORM 「좋아, 해보자!」
						ENDDATA
					CASE 2
						STRDATA 台詞
							DATAFORM 「%LOCALS:9%」
							DATAFORM 「아유프!」
							DATAFORM 「굴려보자, 볼리를 받자!」
							DATAFORM 「좋아... 덤벼라!」
							DATAFORM 「후라아!」
							DATAFORM 「오도록 해, 에이스 아웃, 에이스 아웃...」/「여기, 붐!」
						ENDDATA
					CASE 3
						STRDATA 台詞
							DATAFORM 「%LOCALS:9%」
							DATAFORM 「자, 가볍게 한 번 굴려보자!」
							DATAFORM 「나 간다!」
							DATAFORM 「신과 부처님... 나의 이 던짐을 인도해 주소서!」
							DATAFORM 「나는 손이 가벼워, 알잖아... 전부 손목에 달렸지!」
							DATAFORM 「에이스 아웃... 나에게 줘!」
						ENDDATA
					CASE 4
