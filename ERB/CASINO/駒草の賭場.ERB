@賭場_コマ札交換
#DIM 閾値 = 0, 1050, 2100, 10500, 105000
LOCAL = LINECOUNT
LOCAL:9 = MONEY ;qol custom code
PRINTFORML %"Current ￥", 36, LEFT%%金額表示(MONEY), 13, RIGHT%
PRINTFORML %"Current Chips", 36, LEFT%%三桁区切(KOMAFUDA:MASTER), 13, RIGHT%
PRINTFORML [1]칩 구매 (105엔=1 칩) ※최소 10개 필요
PRINTFORML [2]칩 판매 (1 칩=100엔)
PRINTFORML [0]반납
DO
INPUT
SELECTCASE RESULT
	CASE 0
		CLEARLINE 1
		RETURN 0
	CASE 1
		CALL COLORMESSAGE(@"「얼마를 원하세요?」", 0xD37CD0, 1, 0)
		SIF MONEY >= 1050
			PRINTFORML [1] 모든 돈({MONEY / 105} 칩)을 교환한다. 
		SIF MONEY >= 2100
			PRINTFORML [2] 돈의 절반( {MONEY / 210} 칩)을 교환한다.
		SIF MONEY >= 10500
			PRINTFORML [3]칩 100개(%金額表示(10500)%)를 받는다
		SIF MONEY >= 105000
			PRINTFORML [4]1000칩(%金額表示(105000)%을) 받는다.
		PRINTFORML [0]취소
		PRINTFORML (원하는 칩 개수를 직접 입력하거나 버튼을 선택할 수 있다)
		$BUY_LOOP
		INPUT
		IF INRANGE(RESULT, 1, 4) && (MONEY < 閾値:RESULT)
			CLEARLINE 1
			GOTO BUY_LOOP
		ENDIF
		SELECTCASE RESULT
			CASE 0
				CLEARLINE LINECOUNT - LOCAL
				RESTART
			CASE 1
				KOMAFUDA:MASTER += MONEY / 105
				MONEY = MONEY % 105
			CASE 2
				KOMAFUDA:MASTER += MONEY / 210
				MONEY /= 2
			CASE 3, 4
				MONEY -= 閾値:RESULT
				KOMAFUDA:MASTER = RESULT == 3 ? KOMAFUDA:MASTER + 100 # KOMAFUDA:MASTER + 1000
			CASE IS < 0, 5 TO 9
				CLEARLINE 1
				GOTO BUY_LOOP
			CASEELSE
				IF RESULT * 105 > MONEY
					CLEARLINE 1
					GOTO BUY_LOOP
				ENDIF
				MONEY -= RESULT * 105
				KOMAFUDA:MASTER += RESULT
		ENDSELECT
		PRINTFORML 돈: %金額表示(LOCAL:9)% → %金額表示(MONEY)%
		;qol custom code
		nGamblingDenProfit -= LOCAL:9 - MONEY
		CALL COLORMESSAGE(@"「자, 가라, 가져가!」", 0xD37CD0, 2, 0)
	CASE 2
		IF !KOMAFUDA:MASTER
			CLEARLINE LINECOUNT - LOCAL
			RESTART
		ENDIF
		CALL COLORMESSAGE(@"「얼마에 팔래?」", 0xD37CD0, 1, 0)
		PRINTFORML [ 0] 보유한 모든 칩을 현금으로 교환합니다(%金額表示(KOMAFUDA:MASTER * 100)%) 
		PRINTFORML (교환하고 싶은 칩의 개수를 직접 입력하거나 버튼을 선택할 수 있습니다)
		PRINTFORML [-1] -1 취소
		$SELL_LOOP
		INPUT
		SELECTCASE RESULT
			CASE IS < -1
				CLEARLINE 1
				GOTO SELL_LOOP
			CASE -1
				CLEARLINE LINECOUNT - LOCAL
				RESTART
			CASE 0
				MONEY += KOMAFUDA:MASTER * 100
				KOMAFUDA:MASTER = 0
			CASEELSE
				IF RESULT > KOMAFUDA:MASTER
					CLEARLINE 1
					GOTO SELL_LOOP
				ENDIF
				MONEY += RESULT *100
				KOMAFUDA:MASTER -= RESULT
		ENDSELECT
		PRINTFORML 돈: %金額表示(LOCAL:9)% → %金額表示(MONEY)%
		;qol custom code
		nGamblingDenProfit += MONEY - LOCAL:9
		CALL COLORMESSAGE(@"「여기 있네, 원하면 세어봐도 돼.」", 0xD37CD0, 2, 0)
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
RESTART
LOOP 1
