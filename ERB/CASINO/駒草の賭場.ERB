		賭場退店 ++
		メッセージ = 1
	CASE "へるぷ"
		SIF FLAG:口上色
			SETCOLOR 0xD37CD0
		PRINTFORML 「Sure, lemme briefly explain how the things go down here.」
		PRINTFORML 
		PRINTFORML 「First, you gotta have some of our Chips on you. No Chips - no game, simple as.」
		PRINTFORML 「So I suggest you go and exchange your hard earned cash for some Chips here before anything.」
		PRINTFORML 「Each Chip costs %金額表示(105)% yen to purchase. We hate dealing with fractions, so you must take at least 10 Chips, hope you understand.」
		PRINTFORML 「We'll purchase those Chips from you for %金額表示(100)% yen each. Naturally, we'll account for fractions this time, so you don't have to worry.」
		PRINTFORML 
		PRINTFORML 「Sounds like a bad ratio? Tough luck, but that's the house cut. We gotta get our share somehow, y'know?」
		PRINTFORML 「It's a very important source of our income to earn that food on the table. Don't take it personally.」
		PRINTFORML 「What else we got... Right, if you happen to run out of Chips in the middle of the game, that's the end of it.」
		PRINTFORML 「We'll have you buy the missing Chips at a higher rate with fees included, so watch out.」
		PRINTFORML 「Well, just be careful not to run out of Chips and you should be golden, right?」
		$EXP_LOOP
		RESETCOLOR
		{
		 CALL ASK_M("Return",1,
		 			"Tell me more about Cho-Han", 1,
					"Tell me more about Cee-lo", 1)
		}
		SIF FLAG:口上色
			SETCOLOR 0xD37CD0
		SELECTCASE RESULT
			CASE 0
			CASE 1
				PRINTFORML 「Odds or even... Does it even need an explanation?」
				PRINTFORML 「All you need to do is guess whether the roll is odd or even, and that's it.」
				PRINTFORML 「The betting is in increments of 10, and the limit is set by the setting, so make sure you follow the rules.」
				PRINTFORML 「And, right... I guess the Chips exchange gets a little complicated.」
				PRINTFORML 
				PRINTFORML 「If you guess wrong, your wager is forfeit... That part is pretty straightforward.」
				PRINTFORML 「Buuut, if you guess right, you won't just get a double of your wager all of a sudden.」
				PRINTFORML 「The winners get a split of the losing bet in proportion to their percentage of the wager.」
				PRINTFORML 
				PRINTFORML 「Let's say, for example, there's four bets for Even, three for Odds, and everyone bets 100 Chips.」
				PRINTFORML 「If the result is Odds, the 400 Chips on Even will be split between the three players who bet on Odds.」
				PRINTFORMW 「In this case, it's an even split, with a profit of 166 Chips.」
				PRINTFORML 
				PRINTFORML 「I keep yapping about all that at length, but it still might be tough to understand until you actually play it...」
				PRINTFORML 「Anyhow, it's a game where you can go all out with stakes as big as your wallet, or just play small at your leisure.」
				PRINTFORMW 「Whatever you do, be sure to have a great time!」
				GOTO EXP_LOOP
			CASE 2
				PRINTFORML 「Alrighty, let's go over some of the rules and regulations of our humble establishment.」
				PRINTFORML 「Hifumi (1-2-3) loses double, Shigoro (4-5-6) wins double, Trips (three of the same) wins triple, Snake Eyes (1-1-1, Ace Out) wins quintuple.」
				PRINTFORML 「If you happen to be established as the banker, it doesn't matter if you win or lose since the role of the dealer keeps changing.」
				CALL PRINT_DIALOGUE, @"But if you roll any of the instant loss combos such as Hifumi (1-2-3), 1-point, or Missed the Pot (pisser, die lands outside of the pot)/go Bust (no combos for three throws), you're supposed to stay as the dealer."
				PRINTFORML 「Oh and be careful, you can't just call it quits until everyone got their turn at being the dealer at least once.」
				PRINTFORML 「That's right, quitting while you're ahead after a single roll of the dice is not an option.」
				PRINTFORMW 「After all everyone wants to do it, and that'd be terrible if you don't get a chance to win back, am I right?」
				PRINTFORML 
				PRINTFORML 「What else is there to say... You still wanna know more? Heh, I'll let you figure out the rest on your own.」
				PRINTFORML 「Isn't it a bit of a fool's errand to expect someone to teach you every trick in the book? I'd be digging my own grave here!」
				PRINTFORML 「Well, simplicity is the name of the game. Just keep going at it and you'll learn in time, trust me.」
				GOTO EXP_LOOP
		ENDSELECT
ENDSELECT
SIF メッセージ
	CALL SPTALK, 0, 表情, 95, 台詞, 1, "0xD37CD0"
RESETCOLOR
RETURN

;やっぱりCASINOから構文お借りしてます
@賭場_コマ札交換
#DIM 閾値 = 0, 1050, 2100, 10500, 105000
LOCAL = LINECOUNT
LOCAL:9 = MONEY ;qol custom code
PRINTFORML %"Current ￥", 36, LEFT%%金額表示(MONEY), 13, RIGHT%
PRINTFORML %"Current Chips", 36, LEFT%%三桁区切(KOMAFUDA:MASTER), 13, RIGHT%
PRINTFORML [1]Purchase Chips （105 Yen＝1 Chip）※10 Chips Minimum
PRINTFORML [2]Sell Chips     （1 Chip＝100 Yen）
PRINTFORML [0]Return
DO
	INPUT
	SELECTCASE RESULT
		CASE 0
			CLEARLINE 1
			RETURN 0
		CASE 1
			CALL COLORMESSAGE(@"「How much you want?」", 0xD37CD0, 1, 0)
			SIF MONEY >= 1050
				PRINTFORML [1]Exchange all your money（{MONEY / 105} Chips） 
			SIF MONEY >= 2100
				PRINTFORML [2]Exchange half your money（{MONEY / 210} Chips）
			SIF MONEY >= 10500
				PRINTFORML [3]Get 100 Chips（%金額表示(10500)%）
			SIF MONEY >= 105000
				PRINTFORML [4]Get 1000 Chips（%金額表示(105000)%）
			PRINTFORML [0]Cancel
			PRINTFORML （You can input the number of Chips you want directly or select a button）
			$BUY_LOOP
			INPUT
			IF INRANGE(RESULT, 1, 4) && (MONEY < 閾値:RESULT)
				CLEARLINE 1
				GOTO BUY_LOOP
			ENDIF
			SELECTCASE RESULT
				CASE 0
					CLEARLINE LINECOUNT - LOCAL
					RESTART
				CASE 1
					KOMAFUDA:MASTER += MONEY / 105
					MONEY = MONEY % 105
				CASE 2
					KOMAFUDA:MASTER += MONEY / 210
					MONEY /= 2
				CASE 3, 4
					MONEY -= 閾値:RESULT
					KOMAFUDA:MASTER = RESULT == 3 ? KOMAFUDA:MASTER + 100 # KOMAFUDA:MASTER + 1000
				CASE IS < 0, 5 TO 9
					CLEARLINE 1
					GOTO BUY_LOOP
				CASEELSE
					IF RESULT * 105 > MONEY
						CLEARLINE 1
						GOTO BUY_LOOP
					ENDIF
					MONEY -= RESULT * 105
					KOMAFUDA:MASTER += RESULT
			ENDSELECT
			PRINTFORML Money: %金額表示(LOCAL:9)% → %金額表示(MONEY)%
			;qol custom code
			nGamblingDenProfit -= LOCAL:9 - MONEY
			CALL COLORMESSAGE(@"「There ya go, take 'em!」", 0xD37CD0, 2, 0)
		CASE 2
			IF !KOMAFUDA:MASTER
				CLEARLINE LINECOUNT - LOCAL
				RESTART
			ENDIF
			CALL COLORMESSAGE(@"「How much you wanna sell?」", 0xD37CD0, 1, 0)
			PRINTFORML [ 0]Redeem all of your Chips for cash（%金額表示(KOMAFUDA:MASTER * 100)%） 
			PRINTFORML （You can input the number of Chips you want to redeem directly or select a button）
			PRINTFORML [-1]Cancel
			$SELL_LOOP
			INPUT
			SELECTCASE RESULT
				CASE IS < -1
					CLEARLINE 1
					GOTO SELL_LOOP
				CASE -1
					CLEARLINE LINECOUNT - LOCAL
					RESTART
				CASE 0
					MONEY += KOMAFUDA:MASTER * 100
					KOMAFUDA:MASTER = 0
				CASEELSE
					IF RESULT > KOMAFUDA:MASTER
						CLEARLINE 1
						GOTO SELL_LOOP
					ENDIF
					MONEY += RESULT *100
					KOMAFUDA:MASTER -= RESULT
			ENDSELECT
			PRINTFORML Money: %金額表示(LOCAL:9)% → %金額表示(MONEY)%
			;qol custom code
			nGamblingDenProfit += MONEY - LOCAL:9
			CALL COLORMESSAGE(@"「Here you are, you can count 'em if you want.」", 0xD37CD0, 2, 0)
	ENDSELECT
	CLEARLINE LINECOUNT - LOCAL
	RESTART
LOOP 1

;ここから試行錯誤のオリジナル
@チンチロリン_メイン(レート)
#DIM 回数
#DIM 増減
#DIM 胴元
#DIM レート
#DIM 判定
#DIM プール
#DIM 賭駒, 5
#DIM 強さ, 5
#DIM 親継続, 6
#DIM L_COUNT
#DIM TGT
#DIM 表示色
#DIM 眠い
#DIM レート指数 = 1, 10, 100 ,500
#DIM DYNAMIC 役倍率 = 5, 3, 3 ,3, 3, 3, 2 ;bugfix custom code, reset to normal stakes
;custom code
#DIMS strMag = "", "", "double", "triple", "quadruple", "quintuple", "sextuple", "septuple", "octuple", "nonuple", "decuple"
眠い = 0
VARSET 親継続
FOR COUNT, 1, 5
	IF KOMAFUDA:COUNT < レート指数:レート * 40
		PRINTFORMW ...Some players don't have enough Chips to match the rate. You leave.
		RETURN 0
	ENDIF
NEXT
回数 = 0
DRAWLINE
PRINTFORML 
PRINTFORML ～Cee-lo～
PRINTFORML 
PRINTFORML Rolling the die to decide the order for the Dealer role.
PRINTFORMW 
CALL TOBA_FILL_DICE(強さ, 5)
FOR COUNT, 6, 1, -1
	胴元 = FINDELEMENT (強さ, COUNT)
	SIF 胴元 == -1
		CONTINUE
	BREAK
NEXT
FOR COUNT, 0, 5
	PRINTFORML %BAKUTO_NAME_TR:COUNT, 16, LEFT%%NUM_COUNT(強さ:COUNT, , 1)%
NEXT
PRINTL
PRINTFORMW First Dealer: %BAKUTO_NAME_TR:胴元%
PRINTFORML 
親継続:胴元 = 1
$GAME_LOOP
IF NEMUKE() >= 540 && !眠い
	眠い = 1
	PRINTFORML Your drowsiness makes it hard for you to concentrate well...
	PRINTFORMW The probability of not being able to throw the dice as intended is increased.
	PRINTFORML 
ENDIF
SIF レート > 1
	役倍率 = 10, 6, 5 ,4, 3, 2, 2
回数 ++
CALL PRINT_TOBA_STATE(回数, レート, !胴元)
LOCAL = LINECOUNT

;COMの賭けゴマを適当に決める
FOR COUNT, 1, 5
	IF KOMAFUDA:COUNT >= レート指数:レート * 50 && RAND:4
		TGT = 20
	ELSEIF KOMAFUDA:COUNT >= レート指数:レート * 20
		TGT = 10
	ELSEIF KOMAFUDA:COUNT <= レート指数:レート * 10
		TGT = KOMAFUDA:COUNT / レート指数:レート
	ELSE
		TGT = 5
	ENDIF
	賭駒:COUNT = レート指数:レート * TGT
NEXT
賭駒:胴元 = 0

IF 胴元
	PRINTFORML Decide the initial stake for this turn（1＝%PRINT_PLUR("Chip", レート指数:レート)%）
	PRINTFORML [20]Max   %PRINT_PLUR("Chip", 20 * レート指数:レート)%
	PRINTFORML [10]Half  %PRINT_PLUR("Chip", 10 * レート指数:レート)%
	PRINTFORML Or you may input 1-19 directly.
	$INPUT_LOOP
	INPUT
	IF !INRANGE(RESULT, 1, 20) || (レート指数:レート * RESULT > KOMAFUDA:MASTER)
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
	賭駒:MASTER = レート指数:レート * RESULT
ENDIF
CLEARLINE LINECOUNT - LOCAL
FOR COUNT, 0, 4
	TGT = TOBA_ROTATE:胴元:COUNT
	PRINTFORML %BAKUTO_NAME_TR:TGT + "'s Wager", 26, LEFT%%三桁区切(賭駒:TGT)%
	TWAIT 200, 0
NEXT
PRINTFORML 
;親の処理
PRINTFORML Dealer's Turn
LOCAL = LINECOUNT
PRINTFORML 
PRINTFORML %BAKUTO_NAME_TR:胴元% rolls the dice!
TWAIT 1000, 0
CALL THROW_CHINCHIRO_DICE(胴元, -1)
強さ:胴元 = RESULT
CLEARLINE LINECOUNT -LOCAL
;その場で勝ち負け確定判定
IF !INRANGE(強さ:胴元, 4, 7)
	IF 強さ:胴元 > 7
		CALL COLORMESSAGE(@"Dealer rolls %CHIN_PRIZE_TR:(強さ:胴元)%!", C_YELLOW, 1, 1)
		PRINTFORML %BAKUTO_NAME_TR:胴元% %\@ 強さ:胴元 > 8 ? wins %strMag:(役倍率:(15 - 強さ:胴元))% the wager # takes all \@%!
	ELSE
		CALL COLORMESSAGE(@"Dealer rolls %CHIN_PRIZE_TR:(強さ:胴元)%...", C_YELLOW, 1, 1)
		PRINTFORML %BAKUTO_NAME_TR:胴元% pays out \@ 強さ:胴元 == 0 ? double the # the amount of the \@ wager for each player.
		親継続:5 = 1
	ENDIF
	RESULT = 0
	TGT = !胴元 ? RAND(1, 5) # 胴元
	IF (TGT != 胴元 && RAND:2) || !胴元
		CALL TOBA_GAMBLER_TWEET(TGT, "一投目", 強さ:胴元)
	ELSE
		CALL TOBA_GAMBLER_TWEET(胴元, "親で振った後", 強さ:胴元)
	ENDIF
	GOTO PAY
ENDIF
PRINTFORML %"Dealer's Roll：", 26, LEFT%%CHIN_PRIZE_TR:(強さ:胴元)%
PRINTFORML 
CALL TOBA_GAMBLER_TWEET(胴元, "親で振った後", 強さ:胴元)
;子の処理
PRINTFORML Players Turn
FOR L_COUNT, 0, 4
	TGT = TOBA_ROTATE:胴元:L_COUNT
	LOCAL = LINECOUNT
	PRINTFORML 
	PRINTFORML %BAKUTO_NAME_TR:TGT% rolls the dice!
	TWAIT 1000, 0
	CALL THROW_CHINCHIRO_DICE(TGT, 強さ:胴元)
	強さ:TGT = RESULT
	TWAIT 600, 0
	CLEARLINE LINECOUNT - LOCAL
	PRINTFORML %BAKUTO_NAME_TR:TGT + "'s Roll：", 26, LEFT%%COND_STR(@"%UNICODE(0x3000)%", STRLENS(BAKUTO_NAME_TR:TGT) <= 4)%%CHIN_PRIZE_TR:(強さ:TGT)%
NEXT
PRINTFORML Settling Bets...
$PAY
PRINTFORML 
増減 = 0
プール = 0
;親と勝負・出目判定処理
IF INRANGE(強さ:胴元, 4, 7)
	FOR COUNT, 0, 4
		TGT = TOBA_ROTATE:胴元:COUNT
		SELECTCASE 強さ:TGT
			CASE 0
				判定 = 2
				増減 = -(賭駒:TGT * 2)
			CASE 1, 2, 3
				判定 = 0
				増減 = -(賭駒:TGT)
			CASE 4 TO 8
				判定 = 1
				IF 強さ:TGT == 強さ:胴元
					増減 = 0
				ELSEIF 強さ:TGT > 強さ:胴元
					増減 = 賭駒:TGT
				ELSE
					増減 = -(賭駒:TGT)
				ENDIF
			CASEELSE
				判定 = 役倍率:(15 - 強さ:TGT)
				増減 = 賭駒:TGT * 判定
		ENDSELECT
		PRINTFORM %BAKUTO_NAME_TR:TGT%'s Roll：%CHIN_PRIZE_TR:(強さ:TGT)%　＝　
		IF 増減 < 0
			PRINTFORML Dealer Wins!
			SIF 判定 > 1
				CALL COLORMESSAGE(@"Rolling 1-2-3 means %BAKUTO_NAME_TR:TGT% has to pay double...", C_YELLOW, 1, 1)
		ELSEIF 増減 > 0
			PRINTFORML Player Wins!
			SIF 判定 > 1
				CALL COLORMESSAGE(@"Rolling %CHIN_PRIZE_TR:(強さ:TGT)% means %BAKUTO_NAME_TR:TGT% wins %strMag:判定% the wager!!!", C_YELLOW, 1, 1)
		ELSE
			PRINTFORML Draw!
			PRINTFORML Wager is given back.
		ENDIF
		TWAIT 500, 0
		;親のコマ変動を一時保存
		プール -= 増減
		;子のコマ変動を表示
		KOMAFUDA:TGT = KOMAFUDA:TGT + 増減
		SIF 増減
			CALL TOBA_RESULT_PRINT(TGT, 増減)
		PRINTFORML 
	NEXT
;親の総取り/総付け処理
ELSE
	FOR L_COUNT, 0, 4
		TGT = TOBA_ROTATE:胴元:L_COUNT
		SELECTCASE 強さ:胴元
			;ヒフミ
			CASE 0
				プール -= 賭駒:TGT * 2
				KOMAFUDA:TGT += 賭駒:TGT * 2
				増減 = 賭駒:TGT * 2
			;ションベン目無しピン
			CASE 1, 2, 3
				プール -= 賭駒:TGT
				KOMAFUDA:TGT += 賭駒:TGT
				増減 = 賭駒:TGT
			;ロッポウ
			CASE 8
				プール += 賭駒:TGT
				KOMAFUDA:TGT -= 賭駒:TGT
				増減 = -賭駒:TGT
			;倍付以上
			CASEELSE
				プール += 賭駒:TGT * 役倍率:(15 - 強さ:胴元)
				KOMAFUDA:TGT -= 賭駒:TGT * 役倍率:(15 - 強さ:胴元)
				増減 = -(賭駒:TGT * 役倍率:(15 - 強さ:胴元))
		ENDSELECT
		CALL TOBA_RESULT_PRINT(TGT, 増減)
		TWAIT 500, 0
	NEXT
	PRINTFORML 
ENDIF
KOMAFUDA:胴元 += プール
IF プール
	表示色 = プール > 0 ? C_GREEN # C_D_RED
	PRINTFORM %BAKUTO_NAME_TR:胴元 + "'s Balance", 26, LEFT%%COND_STR(@"%UNICODE(0x3000)%", STRLENS(BAKUTO_NAME_TR:TGT) <= 4)%
	CALL COLORMESSAGE(@"%\@ プール > 0 ? ＋ # － \@%{ABS(プール)}", 表示色, 1, 1)
	SIF ABS(プール) >= レート指数:レート * 80
		CALL TOBA_GAMBLER_TWEET(胴元, @"%\@ プール > 0 ? 得 # 失 \@%意", 強さ:胴元)
	PRINTFORML 
ENDIF

TIME += 5
;タネ銭足りないと終了
FOR COUNT, 0, 5
	SIF KOMAFUDA:COUNT >= レート指数:レート * 2
		CONTINUE
	PRINTFORML 
	IF COUNT > 0 || KOMAFUDA:0 >= 0
		PRINTFORML %BAKUTO_NAME_TR:COUNT% \@ KOMAFUDA:COUNT > 0 ? can no longer cover the rate # ran out of Chips \@.
		PRINTFORMW Game over.
		RETURN 0
	ELSE
		SIF FLAG:口上色
			SETCOLOR 0xD37CD0
		PRINTFORML 「Uh oh, dear... What, out of Chips already? I suggest it's time for you to cut your losses, maybe?」
		PRINTFORML 「...Hang on, whaddya mean you ain't got enough to cover your losses?! Is this some kind of joke?!」
		PRINTFORMW 「I'm gonna have you pay every penny you've got, just you wait!」
		PRINTFORMDL ...You were forced to buy Chips (at a premium rate) to cover the portion that went into red.
		PRINTFORMDW You feel like stepping out for a moment.
		RESETCOLOR
		LOCAL:9 = MONEY
		MONEY = MONEY + KOMAFUDA:MASTER * 125
		;qol custom code
		nGamblingDenProfit -= LOCAL:9 - MONEY
		KOMAFUDA:MASTER = 0
		RETURN 0
	ENDIF
NEXT
;親の目がショボいときは親を続行
IF 親継続:5 == 1
	PRINTFORMW %BAKUTO_NAME_TR:胴元% remains as a Dealer!
	親継続:5 = 0
	GOTO GAME_LOOP
;親交代
ELSEIF SUMARRAY(親継続, 0, 5) < 5
	胴元 = 胴元 == 4 ? 0 # 胴元 + 1
	親継続:胴元 = 1
	PRINTFORMW %BAKUTO_NAME_TR:胴元% is the new Dealer!
	GOTO GAME_LOOP
ENDIF
IF NEMUKE() >= 700
	PRINTFORMW You're getting too drowsy to continue. You're forced to leave.
	RETURN 2
ENDIF
;一周したら一区切り
PRINTFORML 
PRINTFORML Each player has assumed the role of a Dealer at least for one round, so you can leave now.
PRINTFORML [0]Continue the game
PRINTFORML [1]Quit
DO
 	INPUT
 	IF !INRANGE(RESULT, 0, 1)
 		CLEARLINE 1
 		CONTINUE
 	ELSEIF !RESULT
 		VARSET 親継続
 		胴元 = 胴元 == 4 ? 0 # 胴元 + 1
 		親継続:胴元 = 1
 		PRINTFORML The game goes on.
		PRINTFORMW %BAKUTO_NAME_TR:胴元% is the new Dealer!
 		GOTO GAME_LOOP
 	ENDIF
 	RETURN 0
LOOP 1


