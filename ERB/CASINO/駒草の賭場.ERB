		CALL TOBA_CREATE_DICEIMAGE(DICE:0, 0, DICE:1, 2)
		LOCAL = LINECOUNT
		CALL TOBA_DEALER_TWEET(0, "予想終了", CH_BET:MASTER, 0, 1)
		TWAIT 2000 + (RAND(2, 5) * 200), 0
		CLEARLINE LINECOUNT - LOCAL
