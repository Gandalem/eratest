							DATAFORM （The Big Snake picks up the dice with its mouth and tosses them.）
							DATAFORM （The Big Snake dexterously uses its tongue to roll the dice.）
							DATAFORM （The Big Snake makes a dice roll with its tail.）/（The dice soar into the air and land squarely in the cup...）
						ENDDATA
				ENDSELECT
			CASE -1, 5, 6 ;3,4 pointer, dealer's first roll
				LOCALS:9 = %SPLIT_G("Shoot:Go:Rolling:Here goes:Heave-ho:Let's go")%!
				SIF !RAND:10
					LOCALS:9 = Come on, come on, baby needs a new pair of shoes!
				SELECTCASE キャラ
					CASE 1
						STRDATA 台詞
							DATAFORM 「Okay, time to roll the dice!」
							DATAFORM 「Here I come... There!」
							DATAFORM 「Well then, here we go.」
							DATAFORM 「Carefully, carefully... There!」
							DATAFORM 「%LOCALS:9%」
							DATAFORM 「Very well, let's do this!」
						ENDDATA
					CASE 2
						STRDATA 台詞
							DATAFORM 「%LOCALS:9%」
							DATAFORM 「Ayup!」
							DATAFORM 「Roly-poly, let's get a volley!」
							DATAFORM 「Alright... bring it on!」
							DATAFORM 「Hoorah!」
							DATAFORM 「Come ooon, Ace Out, Ace Out...」/「Here, boom!」
						ENDDATA
					CASE 3
						STRDATA 台詞
							DATAFORM 「%LOCALS:9%」
							DATAFORM 「Let's get rolling, nice and easy!」
							DATAFORM 「Here I come!」
							DATAFORM 「God and Buddha... please guide this roll of mine!」
							DATAFORM 「I have a light hand, you know... It's all in the wrist!」
							DATAFORM 「Ace Out... give it to me!」
						ENDDATA
					CASE 4
						STRDATA 台詞
							DATAFORM （The Big Snake picks up the dice with its mouth and tosses them.）
							DATAFORM （The Big Snake dexterously uses its tongue to roll the dice.）
							DATAFORM （The Big Snake makes a dice roll with its tail.）/（The dice soar into the air and land squarely in the cup...）
						ENDDATA
				ENDSELECT
			CASE 7 ;5-pointer
				RESULTS = 泣き
				SELECTCASE キャラ
					CASE 1
						RESULTS = 怒り
						STRDATA 台詞
							DATAFORM 「Hmmm, that's a tough one...」
							DATAFORM 「If I give it my best, then maybe...」
							DATAFORM 「If there's even the slightest chance, then...」
							DATAFORM 「I-It... doesn't mean I've... lost yet, so...」
						ENDDATA
					CASE 2
						STRDATA 台詞
							DATAFORM 「Ack, oof... this is gonna hurt...」
							DATAFORM 「I'm just gonna go out on a limb and give it my best shot...」/「There's no other way anyhow...」
							DATAFORM 「I might just surprise everyone with a good combo if I try... maybe?」
							DATAFORM 「This looks like a bust, but I might as well give it a try... I'll take my chances!」＠通常
						ENDDATA
					CASE 3
						RESULTS = 通常
						STRDATA 台詞
							DATAFORM 「Wouldn't it be cool if I won this? Watch!」
							DATAFORM 「Don't be so full of yourself just yet, dear! You never know until I make a move, you know?」
							DATAFORM 「I bet it'd feel great if I manage to overcome this hurdle and win!」
							DATAFORM 「Channel my motivation! Motivation is all I need! I can handle it, here we go!!!」
						ENDDATA
					CASE 4
						STRDATA 台詞
							DATAFORM （The Big Snake rolls the dice, brimming with confidence...）
							DATAFORM （The Big Snake ponders over something before rolling the dice...）
							DATAFORM （The Big Snake rolls the dice much more carefully than usual...）
						ENDDATA
				ENDSELECT
			CASE 8 TO 15 ;dealer instawon
				SELECTCASE キャラ
					CASE 1
						RESULTS = 怒り
						STRDATA 台詞
							DATAFORM 「...I'm only parting with these momentarily.」/「I swear it on my name, I'll definitely have them back!」
							DATAFORM 「Sometimes the best gain is to lose...」/「Sometimes the best gain is to lose...」/「Sometimes the best gain is to lose...」/「Yes, I will get it all back, no doubt about it!」
							DATAFORM 「This is... indescribably frustrating.」/「It's like, you know, it was over before it even began...」/「And just like that, my bet is gone... It was out of my control...」
						ENDDATA
