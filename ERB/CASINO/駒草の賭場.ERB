			CALL TOBA_DEALER_TWEET(3, "サシで勝ち")
			KOMAFUDA:MASTER -= CH_PROFIT:MASTER
			連勝:MASTER = 0
			CH_PROFIT:MASTER = -(CH_PROFIT:MASTER)
