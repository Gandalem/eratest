;稼ぐ手段の紅魔カジノに対して雰囲気+ロールプレイ用な感じで差別化したいなあ
;ほとんどのコードをカジノから引っ張ってきてます
@賭場_導入
#DIM 退店フラグ
退店フラグ = 0
DRAWLINE
CALL 賭場_台詞("入店中")
DRAWLINE
PRINTFORML 
PRINTFORML ～Komakusa Gambling Den～
PRINTFORML 　Current holdings: %金額表示(MONEY), 13, RIGHT%
PRINTFORML 　Current Chips   : %三桁区切(KOMAFUDA:MASTER), 13, RIGHT%
;qol custom code
PRINTFORML 　Total Wins      : %金額表示(nGamblingDenProfit), 13, RIGHT%
PRINTFORML 
PRINTFORML [1] - Play Cho-Han (Even-Odds)
PRINTFORML [2] - Play Cee-lo (The Three Dice)
;PRINTFORML [3]おいちょかぶで遊ぶ-札表示のスクリプト組めたらやりたい
;PRINTFORML [4]ナンパする-お金で即セフレになるモブ子を湧かせる、とか
;PRINTFORML [5]酒を頼む-酔っ払うとダイス判定に極小メリット＆強烈なデバフをつける、とか
;PRINTFORML [6]おだいじん-モブ子も酔うとクリファン率上がる、とか
PRINTFORML 
PRINTFORML [8] - Chips exchange
PRINTFORML [9] - Explanation
PRINTFORML [0] - Leave
DO
	INPUT
	SELECTCASE RESULT
		CASE 0
			退店フラグ = 1
			BREAK
		CASE 1
			CALL CHIPS_REQ(100) ;custom code
			SIF RESULT
				BREAK
			CALL COLORMESSAGE("「Right on, now choose an appropriate setting you think will fit you the best.」", 0xD37CD0, 1, 0)
			{
			 CALL ASK_M("Children's Playground      :Max Bet= 200", KOMAFUDA:0 >= 100,
						"Ladies and Gentlemen's Club:Max Bet= 500", KOMAFUDA:0 >= 250,
						"Hardcore Gambling Den      :Max Bet=1000", KOMAFUDA:0 >= 500,
						"ULTIMATE SURVIVOR          :Max Bet= ???（TBD）", 0,
						"Cancel", 1)
			}
			LOCAL = RESULT
			IF RESULT == 4
				CALL COLORMESSAGE(@"「Fair nuff, holler at me again whenever you're feeling up to it.」", 0xD37CD0, 2, 0)
			ELSE
				CALL COLORMESSAGE(@"「Alright, I'll be shaking the jar so get set!」", 0xD37CD0, 1, 0)
				CALL COLORMESSAGE(@"「Game'll start as soon as we get enough people at the table!」", 0xD37CD0, 2, 0)
				RESULT = 0
				CALL 丁半博打_メイン(LOCAL)
				退店フラグ = RESULT
			ENDIF
		CASE 2
			CALL CHIPS_REQ(40) ;custom code
			SIF RESULT
				BREAK
			CALL COLORMESSAGE("「Right on, now choose an appropriate setting for you to go enjoy yourself at.」", 0xD37CD0, 1, 0)
			;custom code, enabled 2000 bet
			{
			 CALL ASK_M("Children's Playground      :Max Bet=  20", KOMAFUDA:0 >= 40,
						"Ladies and Gentlemen's Club:Max Bet= 200", KOMAFUDA:0 >= 400,
						"Hardcore Gambling Den      :Max Bet=2000", KOMAFUDA:0 >= 4000,
						"ULTIMATE SURVIVOR          :Max Bet= ???（TBD）", 0,
						"Cancel", 1)
			}
			LOCAL = RESULT
			LOCALS:0 '= "Right-o, have a good one with each other!", "Gotcha, better get your money's worth, then!", "My-my-my, we got ourselves a brave one, huh? Try your best not to go broke!", "...Well, I ain't stopping ya. Go get 'em!", "Huh, changed your mind already?"
			RESULT = 0
			CALL COLORMESSAGE(@"「%LOCALS:LOCAL%」", 0xD37CD0, 2, 0)
			SIF LOCAL < 4
				CALL チンチロリン_メイン(LOCAL)
			退店フラグ = RESULT
		CASE 8
			CALL 賭場_コマ札交換
		CASE 9
			CALL 賭場_台詞("へるぷ")
		CASEELSE
			CLEARLINE 1
			CONTINUE
	ENDSELECT
	SIF NEMUKE() >= 700
		退店フラグ = 2
	BREAK
LOOP 1
IF 退店フラグ
	CALL 賭場_台詞("退店", 退店フラグ)
	RETURN
ENDIF
RESTART

@CHIPS_REQ(ARG) ;custom code
IF KOMAFUDA:0 < ARG ;custom code fix
	CALL COLORMESSAGE(@"「Dear Customer, you can't play this game if you ain't got enough chips!」", 0xD37CD0, 1, 0)
	CALL COLORMESSAGE(@"「Go ahead and turn your cash in first, then come back.」", 0xD37CD0, 2, 0)
	PRINTFORMW ※This game requires at least {ARG} Chips to play.
	RETURN 1
ENDIF

;賭場システムメッセージ部分
;@CASINO_CHECK_EVENTをだいたい流用
@賭場_台詞(ARGS, ARG)
#DIM 賭場入店
#DIM 賭場退店
#DIM DYNAMIC 人物 ;custom code
#DIM メッセージ
#DIM ラッキー
#DIMS モブ
#DIMS 自称
#DIMS 台詞
#DIMS 表情
#DIM nPersonality ;custom code
;custom code - set to target in case there's kanako hanging around for example
;replace with a loop once more characters are added
IF !FLAG:デート相手
	SIF TOBA_PLACE(CFLAG:32:現在位置)
		人物 = 32
	SIF TOBA_PLACE(CFLAG:33:現在位置)
		人物 = 33
	SIF TOBA_PLACE(CFLAG:129:現在位置)
		人物 = 129
	SIF	TOBA_PLACE(CFLAG:138:現在位置)
		人物 = 138
	SIF TOBA_PLACE(CFLAG:140:現在位置)
		人物 = 140
ELSE
	人物 = FLAG:デート相手
ENDIF
表情 = 通常
メッセージ = 0
SELECTCASE ARGS
	CASE "入店中"
		;初回
		IF !FLAG:賭場訪問日
			SELECTCASE 人物
				;神奈子/諏訪子/久侘歌/魅須丸/龍
				CASE 32, 33, 129, 138, 140
					{
					台詞 = 「Well, well, well... Look who's here!」
						/「To think we'd have a %\@ 人物 == 138 ? Great Tengu # Goddess \@% bless us with her presence, it's a great honor to have you come all the way to visit us.」
						/「This is a social meeting place for both ladies and gentlemen alike.」
						/「If not for a moment, you can forget all your worldly affairs and simply enjoy yourself!」
					}
				;典 
				CASE 139
					{
					台詞 = 「My, my...」
						/「What do folks like the Kuda-Gitsune %HIM_HER(138)%self have in store for us, stepping in here?」
						/「This is a social meeting place for both ladies and gentlemen alike.」
						/「Spare us the trouble of the distasteful tricks, would you?」
					}
				CASEELSE
					;山頂/山麓住まい
					;addition custom code, duplicated characters
					IF GROUPMATCH(CSVCFLAG(NO:人物, GETNUM(CFLAG, "自宅位置")) / 100 , 7, 8)
						{
						台詞 = 「Glad to see you finally made it here. I welcome you.」
							/「This is a social meeting place for both ladies and gentlemen alike.」
							/「A perfect place to kick back and unwind, so to speak.」
							/「Well, have a good time! Try not to get too into it, though.」
						}
					ELSEIF !人物
						{
						台詞 = 「Hmm? You look new here...」
							/「Welcome to our humble gambling den of the forest!」
							/「You can call it a social meeting place for both ladies and gentlemen alike.」
							/「Well, now that you're here, go on ahead and take your time to enjoy yourself!」
						}
					ELSE
						{
						台詞 = 「Hmm? This must be the first time we've met here...」
							/「Welcome to our humble gambling den of the forest!」
							/「This is a social meeting place for both ladies and gentlemen alike, a place for everyone to have fun.」
							/「So let's not get into any wild ideas about carelessly using your abilities or anything like that.」
						}
					ENDIF
			ENDSELECT
			賭場入店 = 1
			賭場退店 = 0
			FLAG:賭場訪問日 = DAY
			メッセージ = 1
		;その日初めての入店
		ELSEIF DAY - FLAG:賭場訪問日
			SELECTCASE 人物
				;神奈子/諏訪子/久侘歌/魅須丸/龍
				CASE 32, 33, 129, 138, 140
					台詞 = 「Welcome!」/「Are you and your companion here for a breather?」/「By all means, have a great time!」
				;典
				CASE 139
					台詞 = 「Well well... A Kuda-Gitsune is snooping around in here.」/「Leaving %HIS_HER(138)% master's side to indulge in some *fun*, I see.」
				CASEELSE
					台詞 = 「Heya, come on in!」/「Have you grown fond of this place?」/「In any case, take your time and have fun.」
			ENDSELECT
			賭場入店 = 1
			賭場退店 = 0
			FLAG:賭場訪問日 = DAY
			メッセージ = 1
		;当日再来店
		ELSEIF 賭場入店 == 賭場退店
			SELECTCASE 人物
				;神奈子/諏訪子/久侘歌/魅須丸/龍
				CASE 32, 33, 129, 138, 140
					台詞 = 「Oh, you're back again?」/「Come on in, please, enjoy your stay to your heart's content.」
				;典
				CASE 139
					台詞 = 「You kept sneaking around like that...」/「Just what kind of mischief do you have in mind?」/「Please don't try anything strange.」
				CASEELSE
					台詞 = 「My oh my... I see you haven't had enough fun yet?」/「Go right ahead, indulge yourself as much as you want.」
			ENDSELECT
			賭場退店 ++
			メッセージ = 1
	;にぎやかし
		ELSEIF !RAND:3
			モブ = %TEXTR("Yamawaro/Kappa/Crow Tengu/Bakedanuki/Bakegitsune/Bakeneko/Youkai Rabbit/")%
			自称 = %TEXTR("わたし/私/あたい/あたし/")%
			SIF !RAND:4
				自称 = %TEXTR("ボク/僕/")%
			;custom code
			nPersonality = RAND:4 ;%SPLIT_G("normal:child:girly:tomboy")%
			SIF FLAG:口上色
				SETCOLOR GET_CN_WORD_COLOR(STR:(RAND:13 + 2050))
			;しょーもないネタは低確率
			IF !RAND:25
				;some kind of obscure jp meme https://dic.nicovideo.jp/a/%E3%82%B8%E3%83%A5%E3%83%BC%E3%82%B9%E9%A3%B2%E3%82%93%E3%81%A7%E3%82%93%E3%81%98%E3%82%83%E3%83%8D%E3%83%BC%E3%83%A8%E3%81%AF%E3%81%92%21%21
				PRINTFORMDL You spot a greatly perplexed %モブ% by the entrance...
				PRINTFORML 
				PRINTFORML 「Uuuhhh, my precious money... I blew it, I blew it all... Even the money I borrowed %TEXTR("from my friend/from that girl/from the shop/from the dealer/from the boss/")%...」
				PRINTFORMW 「I only have 200 yen to my name...」
				PRINTFORMDL ...Click! Pa-chink!
				PRINTFORML 「Only 80 yen left now... Oh, I'm sooo screwed...!」
				PRINTFORMDL ...Don't just spend it on juice, you damn baldy!!!
			ELSEIF RAND:2
				PRINTDATADL
					DATAFORM %CAPITALIZE(ARTICLE(モブ))% is making a scene over what appears to be a spectacular win...
					DATAFORM %CAPITALIZE(ARTICLE(モブ))% is jumping around and yelling after prevailing at a winner-take-all game of her life...
					DATAFORM %CAPITALIZE(ARTICLE(モブ))% seems very content with herself, sitting next to a huge pile of Chips by her side...
					DATAFORM %CAPITALIZE(ARTICLE(モブ))% is laughing heartily after making it big in a single decisive win...
				ENDDATA
				PRINTFORML 
				PRINTDATAL LOCAL
					DATAFORM 「%SPLIT_SINGLE(@"Oh dear me, what a thrill this is to win to this extent!:Ahaha, wowee! Look at me, I'm a huge winner! Feels good～:My my, who would've thought that winning a jackpot would feel so great?:Oh maaan, winning an entire mountain of cash is the greatest feeling there is!", nPersonality)%」\n「%SPLIT_SINGLE(@"It sure is tough to keep winning all the time, let me tell you～:Owie, it hurts! I can't stop laughing, it hurts!:Ahh, that is tough, carrying all this cash I've won is so hard!:Aww geez, I feel bad now, I won so much I feel like a villain!", nPersonality)%♪」
					DATAFORM 「%SPLIT_SINGLE(@"Look at that! Oh, I can't believe it!:Lookie, lookie!:Did you witness me yet? I know it's hard to believe～:How's that, huh?! Get a load of this!!!", nPersonality)%」\n「%SPLIT_SINGLE(@"All that effort finally paid off, and I made it happen!:I'm soooo lucky! I'm basically rich now!:Naturally a refined lady like me would have an impeccable luck to match, fufu～:This is all thanks to my incredible skills, I'm telling ya!", nPersonality)%」
					DATAFORM 「%SPLIT_SINGLE(@"I'm so sorry, but looks like this is my win once again.:See ya, losers! Bring more cash next time!:Fufu, I almost feel bad for you lot～:Aww man, sucks to be you!", nPersonality)%」\n「%SPLIT_SINGLE(@"I suppose it's truly my day today, with all those wins and all:I just can't stop winning, and I can't stop winning! Bring me another one!:Try your best next time when I'm not around, maybe then you'll win for once:It ain't my fault that I just keep winning all the time!", nPersonality)%♪」
					DATAFORM 「%SPLIT_SINGLE(@"That sure puts a smile on my face, hehehe...:What's that?! Did I win again? Ahyahyahya! No big surprise!:Mfufu, splendid, simply gorgeous～:Ahahahaha! Heeeell yeah, that feels GOOD!", nPersonality)%」\n「%SPLIT_SINGLE(@"I need some good drink, I've earned it!:Hey bartender! Gimme the strongest stuff you got! Yes, I'm old enough, shush!:I suppose that calls for some wine, go get it for me please～:Ooooi, someone bring me some booze!", nPersonality)%」\n「%SPLIT_SINGLE(@"Oh yeah, that's the stuff! I suppose you guys can have some too, go on!:I'm not sharing though, nuh-huh!:Slrrrrp... Haaah～ So this is what a win tastes like... Oh yes, I'm rubbing it in, how could you tell?:Lemme at least show some mercy to these losers, it's on the house!", nPersonality)%♪」
					DATAFORM 「%SPLIT_SINGLE(@"Another round?:Hey-hey, wanna play again?:Ooh, you dare challenge me?:Am I gonna go for another match?", nPersonality)%」\n「%SPLIT_SINGLE(@"Of course, why not?:Aww yiss! Your ass is grass!:Haven't you had enough yet? Very well, it's on you～:Sure, let's go! I'll take you on any time!", nPersonality)%」\n「%SPLIT_SINGLE(@"Something just tells me that I'm on top of my game today!:No way I'm gonna lose any time soon, watch this!:The luck is on my side, it's crystal clear!:I don't feel like I'm gonna lose now!", nPersonality)%」
					DATAFORM 「%SPLIT_SINGLE(@"Of course I didn't cheat, what are you saying?:You calling me a cheater?! ME?!:Oh, that was no sleight of hand, I assure you～:Did I cheat? Oi-oi, what's with the accusations?", nPersonality)%」\n「%SPLIT_SINGLE(@"I would've never done any of that sort, you know it.:You're just mad cuz you're bad, nuff said!:There's simply no need to cheat when it comes to beating you lot.:There ain't no way I'm doin' any of that, nope!", nPersonality)%」\n「%SPLIT_SINGLE(@"Now stop distracting me and hand over my cash:Shaddap and gimme my money! Hmph, serves you right:Now then, I believe you guys are yet to pay your dues, so go on, make my day:C'mon now, quit yappin' and pay up already you losers", nPersonality)%♪」
				ENDDATA
				IF !LOCAL && !RAND:5 && ラッキー != DAY
					WAIT
					ラッキー = DAY
					PRINTFORML 
					PRINTFORML 「%SPLIT_SINGLE(@"Hey, you there, yes you! How are you feeling today?:Yo, %PRINT_MALE("pops:miss", MASTER)%! 'Sup!:Mm～? Oh, what a splendid %PRINT_MALE("gentleman:lady", MASTER)% you are～ Do you mind if I take a moment of your time?:Oooi, %PRINT_MALE("dude:ma'am", MASTER)%! How's it going? Enjoying yourself yet?", nPersonality)%」
					PRINTFORMDL Suddenly the %モブ% approaches you with a conversation...
					PRINTFORML 「%SPLIT_SINGLE(@"I feel like I could take on the world right now... And I feel like sharing some of it with you, how about that?:Doing great? I see, I see～ Well, I'm about to bounce, so I'll leave it to you to make 'em cough up some of that dosh in my stead!:I'm feeling ve～eery generous right now, so why don't you have some fun? I'll help you out～:Y'know, I'm feeling real good right now! Here, lemme share some of my good fortune with you.", nPersonality)%」
					PRINTFORML 「%SPLIT_SINGLE(@"It's not much, but it's the gesture that matters, right? Hope it'll do you some good.:Here ya go, now go get 'em!:Don't worry, it's simply a little karmic investment for the day～:Here, keep it!", nPersonality)%」
					PRINTFORMDL You receive 100 Chips from the %モブ% you just met!
					KOMAFUDA:MASTER += 100
				ENDIF
