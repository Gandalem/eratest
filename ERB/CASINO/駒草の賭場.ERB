	ELSE
		CALL COLORMESSAGE(@"딜러가 %CHIN_PRIZE_TR:(強さ:胴元)%을 굴린다...", C_YELLOW, 1, 1)
		PRINTFORML %BAKUTO_NAME_TR:胴元%은(는) 지급한다 \@ 強さ:胴元 == 0 ? 두 배를 # 금액을 각 플레이어에 대한 \@ 걸었다.
		親継続:5 = 1
	ENDIF
	RESULT = 0
	TGT = !胴元 ? RAND(1, 5) # 胴元
