; Modular ERB: 駒草の賭場.ERB
;稼ぐ手段の紅魔カジノに対して雰囲気+ロールプレイ用な感じで差別化したいなあ
;ほとんどのコードをカジノから引っ張ってきてます

@賭場_導入
#DIM 退店フラグ
退店フラグ = 0
DRAWLINE
CALL 賭場_台詞("入店中")
DRAWLINE
PRINTFORML 
PRINTFORML ~코마쿠사 도박장~
PRINTFORML 　현재 보유 자산: %金額表示(MONEY), 13, RIGHT%
PRINTFORML 　현재 칩: %三桁区切(KOMAFUDA:MASTER), 13, RIGHT%
;qol custom code
PRINTFORML 　총 승리 수 : %金額表示(nGamblingDenProfit), 13, RIGHT%
PRINTFORML 
PRINTFORML [1] - 초한(짝수 확률)을 플레이한다.
PRINTFORML [2] - 시로(세 개의 주사위)를 플레이한다.
;PRINTFORML [3]おいちょかぶで遊ぶ-札表示のスクリプト組めたらやりたい
;PRINTFORML [4]ナンパする-お金で即セフレになるモブ子を湧かせる、とか
;PRINTFORML [5]酒を頼む-酔っ払うとダイス判定に極小メリット＆強烈なデバフをつける、とか
;PRINTFORML [6]おだいじん-モブ子も酔うとクリファン率上がる、とか
PRINTFORML 
PRINTFORML [8] - 칩 교환
PRINTFORML [9] - 설명
PRINTFORML [0] - 나가기
DO
INPUT
SELECTCASE RESULT
	CASE 0
		退店フラグ = 1
		BREAK
	CASE 1
		CALL CHIPS_REQ(100) ;custom code
		SIF RESULT
			BREAK
		CALL COLORMESSAGE("「좋아, 이제 당신에게 가장 잘 맞을 것 같은 적절한 설정을 골라주세요.」", 0xD37CD0, 1, 0)
		CALL ASK_M("아이들의 놀이터 : 최대 베팅액 = 200", KOMAFUDA:0 >= 100, "레이디스 앤 젠틀맨즈 클럽: 최대 베팅 = 500", KOMAFUDA:0 >= 250, "하드코어 도박장 :최대 베팅=1000", KOMAFUDA:0 >= 500, "궁극의 생존자 : 최대 베팅= ???(TBD)", 0, "취소", 1)
		LOCAL = RESULT
		IF RESULT == 4
			CALL COLORMESSAGE(@"「괜찮아, 기분 날 때 언제든지 다시 불러줘.」", 0xD37CD0, 2, 0)
		ELSE
			CALL COLORMESSAGE(@"「좋아, 병을 흔들 테니 준비해!」", 0xD37CD0, 1, 0)
			CALL COLORMESSAGE(@"「사람이 테이블에 충분히 모이면 게임을 시작할 거야!」", 0xD37CD0, 2, 0)
			RESULT = 0
			CALL 丁半博打_メイン(LOCAL)
			退店フラグ = RESULT
		ENDIF
	CASE 2
		CALL CHIPS_REQ(40) ;custom code
		SIF RESULT
			BREAK
		CALL COLORMESSAGE("「좋아, 이제 네가 즐기기에 적절한 설정을 골라.」", 0xD37CD0, 1, 0)
		;custom code, enabled 2000 bet
		CALL ASK_M("아이들의 놀이터 : 최대 베팅액 = 20", KOMAFUDA:0 >= 40, "레이디스 앤 젠틀맨즈 클럽: 최대 베팅액 = 200", KOMAFUDA:0 >= 400, "하드코어 도박판 :최대 베팅액=2000", KOMAFUDA:0 >= 4000, "궁극의 생존자 : 최대 베팅= ???(TBD)", 0, "취소", 1)
		LOCAL = RESULT
		LOCALS:0 '= "Right-o, have a good one with each other!", "Gotcha, better get your money's worth, then!", "My-my-my, we got ourselves a brave one, huh? Try your best not to go broke!", "...Well, I ain't stopping ya. Go get 'em!", "Huh, changed your mind already?"
		RESULT = 0
		CALL COLORMESSAGE(@"「%LOCALS:LOCAL%」", 0xD37CD0, 2, 0)
		SIF LOCAL < 4
			CALL チンチロリン_メイン(LOCAL)
		退店フラグ = RESULT
	CASE 8
		CALL 賭場_コマ札交換
	CASE 9
		CALL 賭場_台詞("へるぷ")
	CASEELSE
		CLEARLINE 1
		CONTINUE
ENDSELECT
SIF NEMUKE() >= 700
	退店フラグ = 2
BREAK
LOOP 1
IF 退店フラグ
	CALL 賭場_台詞("退店", 退店フラグ)
	RETURN
ENDIF
RESTART

@CHIPS_REQ(ARG) ;custom code
IF KOMAFUDA:0 < ARG ;custom code fix
	CALL COLORMESSAGE(@"「고객님께, 충분한 칩이 없으면 이 게임을 할 수 없습니다!」", 0xD37CD0, 1, 0)
	CALL COLORMESSAGE(@"「먼저 돈을 내고 돌아와라.」", 0xD37CD0, 2, 0)
	PRINTFORMW 이 게임을 플레이하려면 최소 {ARG} 칩이 필요하다.
	RETURN 1
ENDIF
;賭場システムメッセージ部分
;@CASINO_CHECK_EVENTをだいたい流用

@賭場_台詞(ARGS, ARG)
#DIM 賭場入店
#DIM 賭場退店
#DIM DYNAMIC 人物 ;custom code
#DIM メッセージ
#DIM ラッキー
#DIMS モブ
#DIMS 自称
#DIMS 台詞
#DIMS 表情
#DIM nPersonality ;custom code
;custom code - set to target in case there's kanako hanging around for example
;replace with a loop once more characters are added
IF !FLAG:デート相手
	SIF TOBA_PLACE(CFLAG:32:現在位置)
		人物 = 32
	SIF TOBA_PLACE(CFLAG:33:現在位置)
		人物 = 33
	SIF TOBA_PLACE(CFLAG:129:現在位置)
		人物 = 129
	SIF	TOBA_PLACE(CFLAG:138:現在位置)
	人物 = 138
	SIF TOBA_PLACE(CFLAG:140:現在位置)
		人物 = 140
ELSE
	人物 = FLAG:デート相手
ENDIF
表情 = 通常
メッセージ = 0
SELECTCASE ARGS
	CASE "入店中"
		;初回
		IF !FLAG:賭場訪問日
			SELECTCASE 人物
				;神奈子/諏訪子/久侘歌/魅須丸/龍
				CASE 32, 33, 129, 138, 140
					台詞 = 「Well, well, well... Look who's here!」 /「To think we'd have a %\@ 人物 == 138 ? Great Tengu # Goddess \@% bless us with her presence, it's a great honor to have you come all the way to visit us.」 /「This is a social meeting place for both ladies and gentlemen alike.」 /「If not for a moment, you can forget all your worldly affairs and simply enjoy yourself!」
					;典
				CASE 139
					台詞 = 「My, my...」 /「What do folks like the Kuda-Gitsune %HIM_HER(138)%self have in store for us, stepping in here?」 /「This is a social meeting place for both ladies and gentlemen alike.」 /「Spare us the trouble of the distasteful tricks, would you?」
				CASEELSE
					;山頂/山麓住まい
					;addition custom code, duplicated characters
					IF GROUPMATCH(CSVCFLAG(NO:人物, GETNUM(CFLAG, "自宅位置")) / 100 , 7, 8)
						台詞 = 「Glad to see you finally made it here. I welcome you.」 /「This is a social meeting place for both ladies and gentlemen alike.」 /「A perfect place to kick back and unwind, so to speak.」 /「Well, have a good time! Try not to get too into it, though.」
					ELSEIF !人物
						台詞 = 「Hmm? You look new here...」 /「Welcome to our humble gambling den of the forest!」 /「You can call it a social meeting place for both ladies and gentlemen alike.」 /「Well, now that you're here, go on ahead and take your time to enjoy yourself!」
					ELSE
						台詞 = 「Hmm? This must be the first time we've met here...」 /「Welcome to our humble gambling den of the forest!」 /「This is a social meeting place for both ladies and gentlemen alike, a place for everyone to have fun.」 /「So let's not get into any wild ideas about carelessly using your abilities or anything like that.」
					ENDIF
			ENDSELECT
			賭場入店 = 1
			賭場退店 = 0
			FLAG:賭場訪問日 = DAY
			メッセージ = 1
			;その日初めての入店
		ELSEIF DAY - FLAG:賭場訪問日
			SELECTCASE 人物
				;神奈子/諏訪子/久侘歌/魅須丸/龍
				CASE 32, 33, 129, 138, 140
					台詞 = 「Welcome!」/「Are you and your companion here for a breather?」/「By all means, have a great time!」
					;典
				CASE 139
					台詞 = 「Well well... A Kuda-Gitsune is snooping around in here.」/「Leaving %HIS_HER(138)% master's side to indulge in some *fun*, I see.」
				CASEELSE
					台詞 = 「Heya, come on in!」/「Have you grown fond of this place?」/「In any case, take your time and have fun.」
			ENDSELECT
			賭場入店 = 1
			賭場退店 = 0
			FLAG:賭場訪問日 = DAY
			メッセージ = 1
			;当日再来店
		ELSEIF 賭場入店 == 賭場退店
			SELECTCASE 人物
				;神奈子/諏訪子/久侘歌/魅須丸/龍
				CASE 32, 33, 129, 138, 140
					台詞 = 「Oh, you're back again?」/「Come on in, please, enjoy your stay to your heart's content.」
					;典
				CASE 139
					台詞 = 「You kept sneaking around like that...」/「Just what kind of mischief do you have in mind?」/「Please don't try anything strange.」
				CASEELSE
					台詞 = 「My oh my... I see you haven't had enough fun yet?」/「Go right ahead, indulge yourself as much as you want.」
			ENDSELECT
			賭場退店 ++
			メッセージ = 1
			;にぎやかし
		ELSEIF !RAND:3
			モブ = %TEXTR("Yamawaro/Kappa/Crow Tengu/Bakedanuki/Bakegitsune/Bakeneko/Youkai Rabbit/")%
			自称 = %TEXTR("わたし/私/あたい/あたし/")%
			SIF !RAND:4
				自称 = %TEXTR("ボク/僕/")%
			;custom code
			nPersonality = RAND:4 ;%SPLIT_G("normal:child:girly:tomboy")%
			SIF FLAG:口上色
				SETCOLOR GET_CN_WORD_COLOR(STR:(RAND:13 + 2050))
			;しょーもないネタは低確率
			IF !RAND:25
				;some kind of obscure jp meme https://dic.nicovideo.jp/a/%E3%82%B8%E3%83%A5%E3%83%BC%E3%82%B9%E9%A3%B2%E3%82%93%E3%81%A7%E3%82%93%E3%81%98%E3%82%83%E3%83%8D%E3%83%BC%E3%83%A8%E3%81%AF%E3%81%92%21%21
				PRINTFORMDL 당신은 입구에서 심하게 당황한 %モブ%을 발견한다...
				PRINTFORML 
				PRINTFORML 「우으음, 내 소중한 돈... 다 날렸어, 전부 날렸다고... 심지어 %TEXTR("친구에게 빌린 것/그 여자에게 빌린 것/가게에서 빌린 것/딜러에게 빌린 것/보스에게 빌린 것/")%의 돈까지...」
				PRINTFORMW 「내 이름으로 남은 건 겨우 200엔뿐이야...」
				PRINTFORMDL ...딸깍! 파-친크!
				PRINTFORML 「이제 80엔밖에 안 남았어... 아, 나 완전 망했어...!」
				PRINTFORMDL ...주스에만 쓰지 마, 이 빌어먹을 대머리!!!
			ELSEIF RAND:2
				PRINTDATADL
					DATAFORM %CAPITALIZE(ARTICLE(モブ))%는 장관으로 보이는 승리에 대해 소란을 피우고 있다...
					DATAFORM %CAPITALIZE(ARTICLE(モブ))%는 인생에서 한 번뿐인 올인 게임에서 이긴 후 뛰어다니며 소리를 지르고 있다...
					DATAFORM %CAPITALIZE(ARTICLE(モブ))%는 옆에 쌓여 있는 거대한 칩 더미를 보며 스스로 매우 만족하는 듯하다...
					DATAFORM %CAPITALIZE(ARTICLE(モブ))%는 단 한 번의 결정적인 승리로 큰돈을 벌고 나서 배를 잡고 웃고 있다...
				ENDDATA
				PRINTFORML 
				PRINTDATAL LOCAL
					DATAFORM 「%SPLIT_SINGLE(@"오 이런, 이렇게 많이 따다니 정말 짜릿하네!: 아하하, 와우! 나 좀 봐, 내가 대박이야! 기분 좋다～: 음~ 누가 잭팟을 터뜨리는 게 이렇게 기분 좋을 거라고 생각했겠어?: 오 마안, 현금 산더미를 따는 건 최고의 기분이야!", nPersonality)%」\n「%SPLIT_SINGLE(@"계속 이길 수 있는 건 정말 힘들다니까~ : 아얏, 아파! 웃음을 멈출 수가 없어, 너무 아프다! : 하아, 이게 쉽지 않네. 내가 번 이 모든 현금을 감당하는 게 너무 힘들어! : 아이고, 지금 기분이 나쁘네, 너무 많이 이겨서 악당이 된 것 같아!", nPersonality)%♪」
					DATAFORM 「%SPLIT_SINGLE(@"저것 좀 봐! 오, 믿을 수가 없어!:이리 와서 봐!: 벌써 내가 하는 걸 봤어? 믿기 힘들 거 알아~: 어때, 응?! 이거 좀 봐!!!", nPersonality)%」\n「%SPLIT_SINGLE(@"모든 노력이 드디어 결실을 맺었고, 내가 해냈어!:나 정말 운이 좋아! 이제 거의 부자야!:당신 같은 고상한 숙녀에게는 걸맞은 완벽한 행운이 따르는 게 당연하지, 후후～:이건 모두 나의 놀라운 실력 덕분이야, 내가 말해주는 거라고!", nPersonality)%」
					DATAFORM 「%SPLIT_SINGLE(@"정말 미안하지만 이번에도 내 승리인 것 같네.:잘 가라, 패배자들! 다음엔 현금 더 가져와!:후후, 너희들을 위해 거의 안타까워질 뻔했어～:아이고, 네 신세가 딱하겠구나!", nPersonality)%」\n「%SPLIT_SINGLE(@"난 오늘 정말 내 날인 것 같아, 이 모든 승리들 덕분에: 난 계속 이길 수 없어, 그리고 멈출 수가 없다고! 나한테 또 가져와!: 내가 없을 때 다음엔 최선을 다해봐, 그때는 한 번쯤 이기게 될지도 모르지: 내가 항상 이기는 건 내 잘못이 아니잖아!", nPersonality)%♪」
					DATAFORM 「%SPLIT_SINGLE(@"그거 정말 내 얼굴에 미소를 짓게 하는군, 헤헤헤...:뭐지?! 또 이겼나? 아햐하야! 별 놀랄 일 아니지!:므후후, 굉장해, 정말 멋져~:아하하하하! 크으, 기분 좋다!", nPersonality)%」\n「%SPLIT_SINGLE(@"좋은 술이 필요해, 내가 누릴 자격이 있어!:헤이 바텐더! 네가 가진 제일 센 걸 내놔! 응, 나 먹을 수 있어, 조용히 해!:와인을 마셔야겠어, 좀 가져다주렴～:오오이, 누가 술좀 가져다줘!", nPersonality)%」\n「%SPLIT_SINGLE(@"오오, 이게 바로 그거지! 너희들도 좀 마셔도 돼, 어서 받아가!: 난 안 나눠줄 거야, 흥!: 꿀꺽... 하아~ 이 맛이 승리의 맛인가... 아, 그래, 내가 우월함을 과시해 주지, 네가 어떻게 알겠어?: 적어도 이 패배자들에게 자비를 베풀어줘야지, 공짜야!", nPersonality)%♪」
					DATAFORM 「%SPLIT_SINGLE(@"또 한 판 할래?:헤이헤이, 다시 할래?:오우, 나에게 도전하는 거야?:또 경기를 하러 갈까?", nPersonality)%」\n「%SPLIT_SINGLE(@"물론이지, 왜 안 되니?:아유 좋아! 네 뒤통수는 풀이야!:이제 지긋지긋하니? 좋다, 네 차례야～:물론이지, 언제든 붙어주겠어!", nPersonality)%」\n「%SPLIT_SINGLE(@"오늘은 내가 최고라는 느낌이 들어!: 당분간은 절대 지지 않을 거야, 잘 봐!: 내 편에 운이 따르고, 아주 분명해!: 지금은 질 것 같지 않아!", nPersonality)%」
					DATAFORM 「%SPLIT_SINGLE(@"물론 나는 속이지 않았어, 뭐라고 하는 거야?:나를 부정하다고 부르는 건가?! 나라고?! 아아, 그건 손기술 같은 게 아니었어, 내가 보장해～:내가 부정했냐? 어이쿠, 무슨 고발이야?", nPersonality)%」\n「%SPLIT_SINGLE(@"난 절대 그런 짓은 안 해, 알잖아.:넌 그저 네가 못나서 화난 거지, 할 말은 없어!:너희들을 이기려면 속일 필요가 전혀 없단다.:절대 그런 짓 안 해, 절대로!", nPersonality)%」\n「%SPLIT_SINGLE(@"이제 날 방해하는 거 그만두고 내 돈을 내놔:닥치고 내 돈 가져와! 흥, 자초한 일이지:자, 그럼 너희들이 아직 빚을 못 갚았으니 가서 나를 즐겁게 해봐:이봐, 잔소리 그만하고 당장 돈이나 내, 이 패배자들아", nPersonality)%♪」
				ENDDATA
				IF !LOCAL && !RAND:5 && ラッキー != DAY
					WAIT
					ラッキー = DAY
					PRINTFORML 
					PRINTFORML 「%SPLIT_SINGLE(@"Hey, you there, yes you! How are you feeling today?:Yo, %PRINT_MALE("pops:miss", MASTER)%! 'Sup!:Mm～? Oh, what a splendid %PRINT_MALE("gentleman:lady", MASTER)% you are～ Do you mind if I take a moment of your time?:Oooi, %PRINT_MALE("dude:ma'am", MASTER)%! How's it going? Enjoying yourself yet?", nPersonality)%」
					PRINTFORMDL 갑자기 %モブ%가 당신에게 말을 건다...
					PRINTFORML 「%SPLIT_SINGLE(@"지금은 세상을 다 가진 기분이야... 그리고 그중 일부를 너와 나누고 싶은데, 어때?:잘 지내? 그렇구나, 그렇구나～ 음, 나 이제 가봐야 해서, 네가 대신 돈을 받아오도록 할게!:지금 아주 관대한 기분이거든, 그러니 재미있게 놀아. 내가 도와줄게～:있잖아, 지금 정말 기분 좋아! 자, 내 행운의 일부를 너와 나누자.", nPersonality)%」
					PRINTFORML 「%SPLIT_SINGLE(@"별거 아니지만, 마음이 중요하지? 도움이 됐으면 좋겠어.:자, 여기. 이제 가서 다 가져!: 걱정 마, 그냥 오늘을 위한 작은 업보 투자일 뿐이야~: 자, 받아가!", nPersonality)%」
					PRINTFORMDL 당신은 방금 만난 %モブ%에게서 100 칩을 받습니다!
					KOMAFUDA:MASTER += 100
				ENDIF
			ELSE
				PRINTDATADL
					DATAFORM 당신은 입구에서 매우 당황한 표정의 %モブ%을 발견한다...
					DATAFORM 당신은 공허한 눈으로 무언가를 반복해서 중얼거리는 %ARTICLE(モブ)%를 발견한다...
