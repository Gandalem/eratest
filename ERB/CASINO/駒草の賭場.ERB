@TOBA_DEALER_TWEET(L_FEED, 状況, NUM_A, NUM_B, SUB = 0)
;L_FEED：表示分類 BIT0 ONでウエイトあり BIT1 ONでCLEARLINE BIT2 ONで必ず表示
#DIM NUM_A
#DIM NUM_B
#DIM SUB
#DIM L_FEED
#DIM EFFECT
#DIM L_COUNT
#DIMS エフェクト = "", "顔絵_ざわ", "顔絵_ぐにゃあ"
#DIMS 状況
#DIMS 表情
#DIMS MESSAGE
#DIMS MESSAGE_PRINT, 50
#DIMS RESOURCE
EFFECT = 0
MESSAGE = %DEALER_TALK_STRINGS(状況, NUM_A, NUM_B, SUB)%
SIF MESSAGE == ""
	RETURN 0
表情 = %RESULTS%
LOCAL = LINECOUNT
;表示部分は@SP_TALKのカスタム
IF !顔絵付きメッセージ || STRFIND(状況, "煽り") > -1
	SIF FLAG:口上色
		SETCOLOR 0xD37CD0
	SPLIT MESSAGE, "/", MESSAGE_PRINT
	FOR L_COUNT, 0, RESULT
	PRINTFORML %MESSAGE_PRINT:L_COUNT%
	NEXT
	RESETCOLOR
	SIF GETBIT(L_FEED, 0)
		WAIT
ELSE
	キャラ画像表示サイズ比 = 100
	VARSET MESSAGE_PRINT
	SIF FLAG:マルチサイズ
		デフォルトキャラ画像横幅 = 180
	RESOURCE = %\@ 状況 == "勝負！" ? SAI_RESULT # 顔絵_はだけ_%表情%_MOB_95 \@%
	CALL IMAGE_SET(RESOURCE, 0, 0, キャラ画像表示サイズ比, 0)
	SIF EFFECT
		CALL IMAGE_SET(エフェクト:EFFECT, 0, 0, キャラ画像表示サイズ比, 1)
	MESSAGE = %SPTALK整形(MESSAGE)%
	SPLIT MESSAGE, "/", MESSAGE_PRINT
	FOR L_COUNT, 0, RESULT
	SIF L_COUNT != 0 || EFFECT
		CALL DUMMY_SET(0, 0, キャラ画像表示サイズ比, L_COUNT)
	TEMP_HTML:L_COUNT += @"<font color='#0xD37CD0'>%MESSAGE_PRINT:L_COUNT%</font>"
	NEXT
	CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
	IF GETBIT(L_FEED, 0)
		PRINTW 
	ELSE
		PRINTL
	ENDIF
ENDIF
SIF GETBIT(L_FEED, 1)
	CLEARLINE LINECOUNT - LOCAL
RETURN 1
;ツボ振りの呟きと表情を決める式中関数

@DEALER_TALK_STRINGS(状況, NUM_A, NUM_B, SUB)
#FUNCTIONS
#DIM NUM_A
#DIM NUM_B
#DIM BIAS
#DIM SUB
#DIM POS
#DIM 初回
#DIMS 賭け = "Even", "Odds"
#DIMS 状況
#DIMS 台詞
#DIMS 候補
#DIMS 呼称
呼称 = %\@ TALENT:MASTER:性別 == 2 ? fella # darling \@%
POS = NUM_A - NUM_B
RESULTS = 通常
台詞 =
SELECTCASE 状況
	;チンチロリン台詞
	;ツボ振り挨拶
	CASE "挨拶"
		STRDATA 台詞
			DATAFORM 「모든 플레이어들이...인 것 같네」/「보아하니 %BAKUTO_NAME_TR:5%과 %BAKUTO_NAME_TR:6%도 우리와 함께 하게 되겠군. \@ 初回 == DAY ? 계속하고 싶지 않아, 아가씨들?」/「다시 한번 함께 즐겁게 놀아보자고, 어때?」 # 처음 여기 오는 건가, 아가씨들?」/「오늘 많이 즐기도록 해, 알겠나?」\@
			DATAFORM 「좋아, 이제 시작할 수 있겠군.」/「\@ 初回 == DAY ? 내가 오늘 여러분의 겸손한 딜러 역할을 맡아서 잔을 흔들어 줄게.」/「어차피 여기 사람이 충분하지 않아 게임을 할 수가 없거든.」 # 또 네 딜러 역할을 해줄게... 나는 별로 유명하지 않으니 자기소개는 할 필요가 없을 것 같군.」/「아무래도 난 산의 주민 중 한 명일 뿐이니까.」/「여러분 만나서 반갑네.」 \@
			DATAFORM 「자, 얘들아, 게임할 준비 됐나?」/「시작하기 전에 이것만 분명히 해두지 - %SPLIT_G("set your feelings aside no matter the result:win or lose, no hard feelings:we bear no grudges here whether you win or lose")%. 알겠나?」/「중요한 건 우리 모두가 즐거움을 누리는 거야, 그게 중요하지!」
		ENDDATA
		初回 = DAY
		;ツボ振り直前
	CASE "スタート口上"
		SELECTCASE SUB
			CASE 0 ;showdown accepted
				STRDATA 候補
					DATAFORM 「그게 바로 정신이지!」
					DATAFORM 「이제 제대로 된 대화가 통하네!」
					DATAFORM 「좋아! 벌써부터 기대돼 미칠 지경이야!」
					DATAFORM 「%呼称%에게, 네가 나를 받아줄 거라고 확신했어!」
					DATAFORM 「%呼称%에게, 너는 그럴 수 있는 능력이 있다고 믿었어!」
