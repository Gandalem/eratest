@TOBA_RESULT_PRINT(TGT, BP, ARG = 0)
#DIM BP
#DIM NUM
#DIM TGT
#DIM COLOR
#DIMS STRINGS
COLOR = BP > 0 ? C_GREEN # C_D_RED
STRINGS = %BAKUTO_NAME_TR:TGT% \@ BP > 0 ? wins%" "% # loses \@%" "%
;custom code
;NUM = (26 + ARG) - STRLENSU(BAKUTO_NAME_TR:TGT)
;STRINGS = %STRINGS%%UNICODE(0x3000) * NUM%
STRINGS = %STRINGS, 26 + ARG, LEFT%
PRINTFORM %STRINGS%
CALL COLORMESSAGE(@"%\@ BP > 0 ? ＋ # － \@%{ABS(BP)}", COLOR, 1, 1)
RETURN
