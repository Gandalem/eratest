IF CH_COUNT:0 && CH_COUNT:1
	FOR L_COUNT, 0, 7
	IF CH_BET:L_COUNT == 結果
		CH_PROFIT:L_COUNT = (BET_POOL:(!結果) * ((10000 * 賭駒:L_COUNT) / BET_POOL:結果)) / 10000
