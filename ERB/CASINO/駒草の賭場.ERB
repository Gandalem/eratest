CALL THROW_CHINCHIRO_DICE(胴元, -1)
強さ:胴元 = RESULT
CLEARLINE LINECOUNT -LOCAL
;その場で勝ち負け確定判定
IF !INRANGE(強さ:胴元, 4, 7)
