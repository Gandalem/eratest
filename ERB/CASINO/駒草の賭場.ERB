		CH_PROFIT:L_COUNT = -(賭駒:L_COUNT)
	ENDIF
	KOMAFUDA:L_COUNT += CH_PROFIT:L_COUNT
	NEXT
	;全員同じ方に賭けて当たった
ELSEIF CH_BET:MASTER == 結果
	FOR L_COUNT, 0, 7
	CH_PROFIT:L_COUNT = (BET_POOL:2 * ((4500 * 賭駒:L_COUNT) / BET_POOL:2)) / 10000
	KOMAFUDA:L_COUNT += CH_PROFIT:L_COUNT
	NEXT
