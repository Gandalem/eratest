;デイリー23
FLAG_DAILY_EV23 = 0
FLAG_DAILY_EV23_販売員 = 0
;お出かけ06
GO_OUT_FLAG_06 = 0
;COMF432 銭湯
VARSET SENTO_CONSUMPTION, 0
VARSET SENTO_FLAG, 0
旧地獄温泉_ニュープラン_完成日 = 1

;-----------------------------------------------------------
;custom code, print ending with a 2hu with the most favor, keep going until one is reached
;harem ending can be technically handled at the dialogue side, or we can think of something later
;-----------------------------------------------------------
@BITE_THE_DUST_ENDING
#DIM DYNAMIC CHARA_ARRAY, キャラクタ数上限
#DIM CHARA_FAVOR_ARRAY, キャラクタ数上限

FOR LOCAL, 0, CHARANUM
	CHARA_ARRAY:LOCAL = LOCAL
	CHARA_FAVOR_ARRAY:LOCAL = MAX(CFLAG:LOCAL:好感度,1)
NEXT
ARRAYMSORT CHARA_FAVOR_ARRAY, CHARA_ARRAY

FOR LOCAL, CHARANUM-1, 0, -1
	SIF CFLAG:(CHARA_ARRAY:LOCAL):好感度 < 1000 ;don't set higher because they'll be eligible for a fall state, but at the same time don't pick complete randos
		CONTINUE
	SIF CFLAG:(CHARA_ARRAY:LOCAL):好感度 <= 0
		BREAK
	CALL KOJO_MESSAGE_SEND("ENDING",0,CHARA_ARRAY:LOCAL,2,0)
	IF RESULT
		BREAK
		PRINTL
		DRAWLINE
	ENDIF
NEXT
