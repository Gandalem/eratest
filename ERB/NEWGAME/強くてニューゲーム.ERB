@BITE_THE_DUST_CLEAR_FLAG
FOR LOCAL,0, VARSIZE("FLAG")
;範囲による指定
SELECTCASE LOCAL
	;パンツと実績
	CASE 700 TO 709
		CONTINUE
		;OPTION
	CASE 4 TO 7
		CONTINUE
	CASE 1001 TO 1099
		IF FLAGNAME:LOCAL != "出禁人数"
			CONTINUE
		ENDIF
	CASE IS >= 1500
		CONTINUE
	CASEELSE
		;名称による指定
		SELECTCASE FLAGNAME:LOCAL
			CASE "周回数", "なりきり"
				CONTINUE
			CASE "願掛け内容", "精力強化回数"
				CONTINUE
			CASE "重婚可能人数", "恋慕特典", "恋慕特典2", "恋人特典", "恋人特典2"
				CONTINUE
				;累計回数
			CASE "掃除中毒"
				CONTINUE
				;OPTION
			CASE "生理周期可視化", "察知モード", "Cスキマ自動仕様"
				CONTINUE
		ENDSELECT
ENDSELECT
FLAG:LOCAL = 0
NEXT
