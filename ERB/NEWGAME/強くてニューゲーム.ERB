@BITE_THE_DUST_BACKUP
;なりきり
IF FLAG:なりきり
	前回のなりきり出禁 = CFLAG:(FLAG:なりきり):出禁
ENDIF
;周回前の成長分を記録
前回の体力 = MAXBASE:MASTER:体力
前回の気力 = MAXBASE:MASTER:気力
前回の精力 = MAXBASE:MASTER:精力

;addition custom code, duplicated characters
前回の体力増加量 = MAX(0, MAXBASE:MASTER:体力 - CSVBASE(NO:(FLAG:なりきり), GETNUM(BASE, "体力")))
前回の気力増加量 = MAX(0, MAXBASE:MASTER:気力 - CSVBASE(NO:(FLAG:なりきり), GETNUM(BASE, "気力")))
前回の精力増加量 = MAX(0, MAXBASE:MASTER:精力 - 1000)

;リセット前のキャラ人数をLOCAL:6に控えておく。
