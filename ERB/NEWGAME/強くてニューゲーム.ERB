;custom code, this function lets you switch all character versions in a single menu
@Alternate_Dialogue_Toggles
#DIM C_ID
#DIMS DESCRIPTIONS, 6
REDRAW 0

$INPUT_LOOP
LINESTART = LINECOUNT
PRINTFORML Some characters have alternative dialogue options:
FOR C_ID,1,CHARANUM
	IF CFLAG:C_ID:口上実装状況 > 1 && C_ID != FLAG:なりきり
		RESULTS:1 = Default
		TRYCALLFORM M_KOJO_K{C_ID}_{CFLAG:C_ID:口上セレクタ}
		PRINTFORML [{C_ID, 3}] %CALLNAME:C_ID% - %RESULTS:1%
	ENDIF
NEXT
PRINTFORML \n[{0, 3}] Continue

INPUT
IF RESULT && CFLAG:RESULT:口上実装状況 > 1
	VARSET LOCALS
	C_ID = RESULT
	FOR LOCAL,0,3
		RESULTS:1 = Default
		RESULT = 0
		RESULTS:2 = 
		IF !LOCAL
			TRYCALLFORM M_KOJO_K{C_ID}
		ELSE
			TRYCALLFORM M_KOJO_K{C_ID}_{LOCAL}
		ENDIF
		IF RESULT
			LOCALS:(LOCAL + 1) = %RESULTS:1%
			DESCRIPTIONS:LOCAL = \@RESULTS:2 != ""? %RESULTS:2% # No description\@
		ENDIF
	NEXT
	LOCALS:0 = Change %CALLNAME:C_ID%'s dialogue?
	PRINTFORML %LOCALS:0%
	FOR LOCAL, 0, 4
		HTML_PRINT @"<button value='{LOCAL}' title='%HTML_ESCAPE(DESCRIPTIONS:LOCAL)%'>[{LOCAL}] - %LOCALS:(LOCAL + 1)%</button>"
		SIF LOCALS:(LOCAL + 2) == ""
			BREAK
	NEXT
	$INPUT_LOOP2
	INPUT
	SELECTCASE RESULT
		CASE 0 TO LOCAL - 1
		CASEELSE
			CLEARLINE 1
			GOTO INPUT_LOOP2
	ENDSELECT
	CFLAG:C_ID:口上セレクタ = RESULT
ELSEIF !RESULT
	RETURN 1
RETURN 0
[SKIPEND]
