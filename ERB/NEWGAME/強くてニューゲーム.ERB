@BITE_THE_DUST_SWEEP
VARSET 前回の体力
VARSET 前回の体力増加量
VARSET 前回の気力
VARSET 前回の気力増加量
VARSET 前回のキャラ人数
VARSET 前回のなりきり出禁
VARSET 前回のCFLAG
VARSET 前回のパンツ
;-----------------------------------------------------------
;同キャラ口上複数存在判定
;ARG=キャラナンバー
;現在同キャラ口上は最大で四つまで想定
;-----------------------------------------------------------

@KOJO_MULTIPLE(C_ID, ARG) ;custom code - arg to return the amount of dialogue options
#DIM C_ID
#DIM DYNAMIC 口上カウント
#DIM DYNAMIC 口上数
#DIM DYNAMIC 口上実装数
#DIMS DYNAMIC kojoNamesList, 4
#DIM DYNAMIC kojoIdList, 4
#DIM DYNAMIC vernier
#DIMS DESCRIPTIONS, DESCRIPTIONS_SIZE ;custom code
VARSET RESULTS
;同キャラ口上複数確認 and record the name of kojo
FOR 口上カウント,0,5
RESULT = 0
;addition custom code, duplicated characters
IF 口上カウント
	TRYCALLFORM M_KOJO_K{NO:C_ID}_{口上カウント}
ELSE
	TRYCALLFORM M_KOJO_K{NO:C_ID}
ENDIF
IF RESULT
	;custom code dialogue descriptions
	DESCRIPTIONS:vernier = \@RESULTS:2 != ""? %RESULTS:2% # No description available.\@
	SIF RESULTS:1 == ""
		RESULTS:1 = Default
	kojoNamesList:vernier = %CALLNAME:C_ID% %RESULTS:1% Dialogue
	kojoIdList:vernier = 口上カウント
	vernier ++
	IF !GETBIT(CFLAG:C_ID:口上実装状況,口上カウント)
		口上数 += 1
		口上実装数 += 1
		SETBIT CFLAG:C_ID:口上実装状況,口上カウント
	ELSEIF GETBIT(CFLAG:C_ID:口上実装状況,口上カウント)
		口上数 += 1 ;bugfix custom code
		口上実装数 += 1
	ENDIF
ENDIF
NEXT
;custom code
SIF ARG == 1 ;choice skip, show dialogue count
	RETURN 口上実装数
SIF ARG == 2 ;choice skip - keep the same
	RETURN 1
;-----------
IF !口上数
	SIF 口上実装数
		RETURN 1
	RETURN 0
ENDIF
IF 口上実装数 > 1
	;custom code, skip question when using the update menu
	SIF Ask_SwitchDialogue
		GOTO SKIPAHEAD
	RESULTS:2 =
	PRINTFORML %CALLNAME:C_ID%는 여러 대사가 있다.
	PRINTFORML 목록에서 선택할까?
	CALL ASK_YN("네", "그대로 유지")
	;口上選択
	IF !RESULT
		$SKIPAHEAD ;custom code, skip question when using the update menu
		LOCALS:0 = Select which dialog to use. (Hover over each option for a brief description of the dialogue.)
		;custom code dialogue descriptions
		;CALL CHOICE("Select which dialog to use.", kojoNamesList:0, kojoNamesList:1, kojoNamesList:2, kojoNamesList:3)
		PRINTFORML %LOCALS:0%
		CALL ASK_CHOICES_TITLE(kojoNamesList, DESCRIPTIONS, vernier)
		CFLAG:C_ID:口上セレクタ = kojoIdList:RESULT
		RETURN 2
	ELSE
		PRINTFORML 그대로 둔다.
		RETURN 1
	ENDIF
ELSE
	RETURN 2
ENDIF
