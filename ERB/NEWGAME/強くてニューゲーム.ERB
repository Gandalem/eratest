@BITE_THE_DUST_RESTORE
;リセット前のキャラ人数でFOR文を回す
FOR LOCAL, 1, 前回のキャラ人数
	;CSVファイルの存在判定
	IF !EXISTCSV(LOCAL)
		CONTINUE
	ENDIF
	IF GETCHARA (LOCAL) == -1
		IF BTD_CHARA == LOCAL && BTD_CHARA != 0
			;load our saved character
			CALL LOAD_CUSTOM_DATA(1000)
			MASTER = BTD_CHARA
			FLAG:なりきり = BTD_CHARA
			CONTINUE
		ELSE
			CALL ADDCHARA_INIT(LOCAL) ;custom code
		ENDIF
		;試しにCALL KOJO_MULTIPLEをFOR~NEXTループの外に出す
		;CALL KOJO_MULTIPLE(LOCAL)
	ENDIF
	;効率化追求のため引き継ぎフラグと同時に回す
	;ファイルチェックはすでにしてるんだからその中で回せば済む話でした（反省）
	FOR LOCAL:1,0,40
		;引き継ぎフラグのセット
		IF LOCAL:1 < 7 && GETBIT(TFLAG:(LOCAL + 500), LOCAL:1)
			SETBIT CFLAG:LOCAL:引き継ぎ, LOCAL:1
		ENDIF
		;パンツコレクションの引き継ぎ
		;eraNAS uses new pantsu collection system.
		;don't need this since we're keeping the PantyCollection DataTable
		;CFLAG:LOCAL:(LOCAL:1 + 100) = 前回のパンツ:LOCAL:(LOCAL:1)
	NEXT
	CFLAG:LOCAL:口上用引継ぎ枠 = 前回のCFLAG:LOCAL
	;キス未経験のリセット
	SIF EXP:LOCAL:キス経験 == 0
		 TALENT:LOCAL:キス未経験 = 1

	; - eraNAS custom code
	TARGET = LOCAL
	CALL CustomTraits(LOCAL) ;added
	CALL SetOmoStats(LOCAL)
	; -- end eraNAS custom code --
NEXT
