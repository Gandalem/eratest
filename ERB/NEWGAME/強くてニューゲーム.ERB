FOR LOCAL, 1, 前回のキャラ人数
;CSVファイルの存在判定
IF !EXISTCSV(LOCAL)
	CONTINUE
ENDIF
IF GETCHARA (LOCAL) == -1
	IF BTD_CHARA == LOCAL && BTD_CHARA != 0
		;load our saved character
		CALL LOAD_CUSTOM_DATA(1000)
		MASTER = BTD_CHARA
		FLAG:なりきり = BTD_CHARA
		CONTINUE
	ELSE
		CALL ADDCHARA_INIT(LOCAL) ;custom code
	ENDIF
