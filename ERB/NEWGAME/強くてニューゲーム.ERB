@強くてニューゲーム
ゲーム引き継ぎ処理中 = 1
FLAG:周回数 ++
CALL Add_Handle_Duplicate_Deletion(1, 1) ;addition custom code
CALLF KILL_ALL_MOBS() ;NAS custom,
CALL ADDCHARA_INIT(CSV_CHARANUM())
CALL BUFF_RESET
CALL BITE_THE_DUST_RESURRECT ; resurrect dead touhous
;custom code, call before stuff is completely reset
CALL BITE_THE_DUST_ENDING
CALL BITE_THE_DUST_BACKUP
CALL BITE_THE_DUST_CLEAR
