@NEWGAME_BONUS_APPLY
#DIM C_ID
C_ID = TOINT(ニューゲーム特典)
SELECTCASE ニューゲーム特典
	CASE "なし"
	CASE ""
		MONEY += (50000 + (1000000*FLAG:周回数))
	CASE @"%金額表示(50000)%"
		MONEY += (50000 + (1000000*FLAG:周回数))
	CASE "初期能力アップ"
		ABL:MASTER:清掃技能 = LIMIT(ABL:MASTER:清掃技能+1,0,MaxNonHLevel)
		ABL:MASTER:教養 = LIMIT(ABL:MASTER:教養+1,0,MaxNonHLevel)
		ABL:MASTER:料理技能 = LIMIT(ABL:MASTER:料理技能+1,0,MaxNonHLevel)
		ABL:MASTER:技巧 = LIMIT(ABL:MASTER:技巧+2,0,5)
		ABL:MASTER:話術技能 = LIMIT(ABL:MASTER:話術技能+3,0,MaxNonHLevel)
		CALL SET_MINIMUM_EXP_ALL(MASTER, 1) ;addition custom code
	CASE "スケベセット"
		ITEM:ミラダの石 += 1
		ITEM:ローター += 1
		ITEM:バイブ += 1 ;addition custom code
		ITEM:オナホール += 1 ;addition custom code
		ITEM:媚薬 += 5
		ITEM:ローション += 5 ;addition custom code
		ITEM:コンドーム += 20 ;addition custom code
		ITEM:EStimBox = 1
		ITEM:PadElectrode = 1
		SIF MAXBASE:MASTER:TSP < 4000
			MAXBASE:MASTER:TSP = LIMIT(MAXBASE:MASTER:TSP+700,0,4000)
		BASE:MASTER:TSP = MAXBASE:MASTER:TSP
		MONEY:1 = 1800
		ABL:MASTER:技巧 = LIMIT(ABL:MASTER:技巧+2,0,5)
	CASE "WhereaboutsSense"
		TALENT:MASTER:居場所察知 = 1
		SETBIT FLAG:面識ボーナス取得状況, 2
	CASE "NonHMaster"
		ABL:MASTER:料理技能 = 18
		TALENT:MASTER:伐採Lv = 18
		TALENT:MASTER:釣りLv = 18
		TALENT:MASTER:採集Lv = 18
		TALENT:MASTER:調合Lv = 18
	CASE "IntelMaster"
		ABL:MASTER:教養 = MaxNonHLevel
		ABL:MASTER:話術技能 = MaxNonHLevel
	CASE "HMaster"
		FOR LOCAL, 50,57
		SIF ABL:MASTER:LOCAL < 14
			ABL:MASTER:LOCAL = 14
		NEXT
		TALENT:MASTER:器用な指 = 1
		TALENT:MASTER:舌使い = 1
		IF HAS_VAGINA(MASTER)
			TALENT:MASTER:淫壺 = 1
			TALENT:MASTER:ポルチオ性感 = 1
		ENDIF
		TALENT:MASTER:尻穴狂い = 1
		TALENT:MASTER:淫乳 = 1
		TALENT:MASTER:LewdUrethra = 1
		TALENT:MASTER:自慰狂い = 1
		TALENT:MASTER:キス魔 = 1
		TALENT:MASTER:精愛味覚 = 1
		TALENT:MASTER:Ｃ感度 = 2
		TALENT:MASTER:Ｖ感度 = 2
		TALENT:MASTER:Ａ感度 = 2
		TALENT:MASTER:Ｂ感度 = 2
		TALENT:MASTER:Ｍ感度 = 2
		TALENT:MASTER:USens = 2
	CASE "FastLearner"
		TALENT:MASTER:習得速度 ++
	CASE "StarShip"
		ITEM:StarShip ++
	CASE "PrudeHarmonizer"
		CALLF AddBionic(MASTER,1,67)
	CASE "ESP"
		TALENT:MASTER:ESP = 1
		MAXBASE:MASTER:法力 = MAX(100,MAXBASE:MASTER:法力)
	CASEELSE
		CALL Add_NewGameBonus_Proc(ニューゲーム特典, C_ID) ;addition custom code
		SIF RESULT
			RETURN
		CFLAG:C_ID:好感度 = 500
		CFLAG:C_ID:信頼度 = 100
		IF CHECK_CHARA(C_ID, "神霊")
			TALENT:MASTER:神霊孕ませ = 1
		ELSEIF CHECK_CHARA(C_ID, "付喪神")
			TALENT:MASTER:付喪神孕ませ = 1
		ELSEIF CHECK_CHARA(C_ID, "蓬莱人")
			TALENT:MASTER:蓬莱孕ませ = 1
		ELSEIF CHECK_CHARA(C_ID, "幽霊")
			TALENT:MASTER:幽霊孕ませ = 1
		ELSEIF CHECK_CHARA(C_ID, "人形")
			TALENT:MASTER:人形孕ませ = 1
		ENDIF
ENDSELECT
