	CASE 金額表示(50000)
		RETURNF @"¥{50000 + (1000000*FLAG:周回数)} 선택 시작"
	CASE "初期能力アップ"
		RETURNF "능력이 향상되어 집안일과 여러 작업이 쉬워진다."
	CASE "スケベセット"
		RETURNF "기교와 능력치가 오르고, 기본 성인용품 세트와 관계를 맺기 쉽게 해 주는 특별 보너스 아이템을 받는다."
		;addition custom code
	CASE "なし"
		RETURNF "보너스 없음"
	CASE "【Red Thread】", "【Unmatched】", "【Mysterious Charm】", "【Almighty Impregnation】", "【Fast Learner】", "【Beautiful】"
		RETURNF @"%ニューゲーム特典%을(를) 획득하게 된다."
	CASE "Basic Combat Proficiency"
		RETURNF "처음부터 일정 수준의 전투 능력을 갖고 시작한다."
	CASE "WhereaboutsSense"
		RETURNF "모든 인물의 위치를 파악하는 능력을 갖고 시작한다."
	CASE "NonHMaster"
		RETURNF "낚시·요리·조합·채집·벌목을 레벨 6으로 시작한다."
	CASE "CombatMaster"
		RETURNF "전투 능력이 최대치가 된다."
	CASE "IntelMaster"
		RETURNF "지식과 화술이 최대치가 된다."
	CASE "HMaster"
		RETURNF "모든 성적 기교가 레벨 5인 음란한 몸으로 시작한다."
	CASE "FastLearner"
		RETURNF "더 빠른 습득 속도로 시작한다."
	CASE "StarShip"
		RETURNF "달과 마계로 이동할 수 있는 함선을 가지고 시작한다"
	CASE "PrudeHarmonizer"
		RETURNF "절제 조율기를 장착해 【절제】의 모든 효과를 무효화한 채 시작한다."
	CASE "ESP"
		RETURNF "탄막과 아이템 소환 같은 마법을 사용할 수 있다."
	CASEELSE
		RETURNF @"%CALLNAME:TOINT(ニューゲーム特典)%와의 호의와 신뢰가 증가된 상태로 시작한다. 그 종족은 임신시키기 더 쉬워질 것이다."
ENDSELECT
;-----------------------------------------------------------
;Addition custom code
;-----------------------------------------------------------

@Add_NewGameBonus(ARGS)
SELECTCASE ARGS
	CASE "【Red Thread】"
		PRINTFORML 데이트 중 파트너와의 [호감도]를 증가시킬 기회를 준다.
	CASE "【Unmatched】"
		PRINTFORML 사정 시 사정량이 두 배가 되며, STA 및 ENE 비용이 제거된다. 성기가 없으면 쓸모없다.
	CASE "【Mysterious Charm】"
		PRINTFORML 대부분의 명령을 실행하기 쉬우며, 효과에 보너스가 있고 호의 증가량이 더 많다.
		;CASE "【Almighty Impregnation】"
		;	PRINTFORML Makes it significantly easier to impregnate any race.
	CASE "Basic Combat Proficiency"
		PRINTFORM 시작한다 
		CALL PRINT_RANK(ABL:MASTER:42+6, @"MAX_20")
		PRINTFORML  {ABL:MASTER:42+6} 단막(彈幕), 
		CALL PRINT_RANK(ABL:MASTER:66+6, @"MAX_20")
		PRINTFORML  {ABL:MASTER:66+6} 사격과
		CALL PRINT_RANK(ABL:MASTER:67+6, @"MAX_20")
		PRINTFORML  {ABL:MASTER:67+6} 근접 전투 능력으로 시작한다.
	CASE "【Fast Learner】"
		PRINTFORML 성적 능력과 기교 자체를 키우기가 더 쉽다.
	CASE "【Beautiful】"
		PRINTFORML 새로운 캐릭터를 만났을 때와 쉬워진 특수 판정 체크 시 호의 보너스를 받는다.
	CASEELSE
		THROW Invalid Bonus: %ARGS%
ENDSELECT
PRINTFORML 확인?
CALL ASK_YN
IF !RESULT
	ニューゲーム特典 '= ARGS
	RETURN 1
ELSE
	RETURN 0
ENDIF

@Add_NewGameBonus_Proc(ARGS, ARG)
;note - make sure to return 1 for your option!!!
SELECTCASE ARGS
	CASE "【Red Thread】"
		SETBIT FLAG:好感度ボーナス取得状況, 8
		TALENT:MASTER:あかいと = 1
		RETURN 1
	CASE "【Unmatched】"
		TALENT:MASTER:絶倫 = 1
		IF HAS_PENIS(MASTER)
			MAXBASE:MASTER:精力 += 300
			MAXBASE:MASTER:勃起 *= 2
		ENDIF
		RETURN 1
	CASE "【Mysterious Charm】"
		SETBIT FLAG:陥落ボーナス取得状況, 3
		TALENT:MASTER:謎の魅力 = 1
		RETURN 1
		;CASE "【Almighty Impregnation】"
		;SETBIT FLAG:孕ませボーナス取得状況, 1
		;TALENT:MASTER:万能孕ませ = 1
		;RETURN 1
	CASE "Basic Combat Proficiency"
		ABL:MASTER:戦闘能力 += 6
		ABL:MASTER:Shooting += 6
		ABL:MASTER:Melee += 6
		CALL SET_MINIMUM_EXP_ALL(MASTER, 1)
		RETURN 1
	CASE "【Fast Learner】"
		;SETBIT FLAG:기술보너스취득상황, 6
		TALENT:MASTER:習得速度 = 1
		RETURN 1
	CASE "【Beautiful】"
		TALENT:MASTER:容姿 = 1
		RETURN 1
ENDSELECT
