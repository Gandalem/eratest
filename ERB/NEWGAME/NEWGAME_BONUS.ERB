@NEWGAME_BONUS_SELECT
#DIMS buttonText, 100
SETCOLOR 103,228,126
PRINTFORML 【뉴 게임 보너스】
RESETCOLOR
PRINTFORML 하나를 선택해 주세요. (설명을 보려면 하나를 클릭하세요)
buttonText:0 '= @"￥{50000 + (1000000*FLAG:周回数)}"
buttonText:1 '= "Increase initial Favor and Trust"
buttonText:2 '= "Increased Skills"
buttonText:3 '= "The Millennium Stone of Mirada that Monopolizes Lust"
;addition custom code - new bonuses (from KR version)
buttonText:4 '= "【Red Thread】"
buttonText:5 '= "【Unmatched】"
buttonText:6 '= "【Mysterious Charm】"
;pedy you stupid cunt this is meant to be a HARD reward to get.
;NAS Note: Actually is pretty easy now that the pregnancy rework to get. Still going to lock it off.
;buttonText:7 '= "【Almighty Impregnation】"
buttonText:8 '= "Basic Combat Proficiency"
;this too
;buttonText:9 '= "【Fast Learner】"
buttonText:10 '= "【Beautiful】"
buttonText:99 '= "None"
;buttonText:10 '= "【Unbreakable Soul】"
;buttonText:11 '= "【Broken Soul】"
SIF !FLAG:周回数
	buttonText:12 '= "【Whereabouts Sense】"
SIF FLAG:周回数 && ABL:MASTER:41 < 5 && ABL:MASTER:42 < 5 && ABL:MASTER:43 < 5 && ABL:MASTER:44 < 5 && ABL:MASTER:50 < 5 && ABL:MASTER:51 < 5 && ABL:MASTER:52 < 5 && ABL:MASTER:53 < 5
	buttonText:13 '= @"【%GET_TALENTNAME_TR(50,TALENT:MASTER:50+1)%】"
;buttonText:14 '= "【Providence】"
SIF !ITEM:StarShip
	buttonText:15 '= "Starship"
buttonText:16 '= "Prude Harmonizer"
buttonText:17 '= "【Youjutsu: Danmaku】"
IF FLAG:周回数
	buttonText:50 '= "Master of All Trades"
	buttonText:51 '= "Killing Machine"
	buttonText:52 '= "Full of Knowledge"
	buttonText:53 '= "Master of Marital Arts"
ENDIF
CALL ASK_BUTTONS(buttonText)
SELECTCASE RESULT
	CASE 0
		ニューゲーム特典 '= @"%金額表示(50000)%"
		LOCALS = ￥{50000 + (1000000*FLAG:周回数)}로 시작한다.
	CASE 1
		CALL NEWGAME_BONUS_CHARA
		IF !RESULT
			RESTART
		ENDIF
		LOCALS = %ニューゲーム特典%
	CASE 2
		ニューゲーム特典 '= "初期能力アップ"
		LOCALS = 증가한 스킬
		PRINTFORML 다음으로 시작한다:
		CALL PRINT_RANK(LIMIT(ABL:MASTER:清掃技能+1,0,MaxNonHLevel), @"MAX_20")
		PRINTFORML  {LIMIT(ABL:MASTER:清掃技能+1,0,MaxNonHLevel)} 청소
		CALL PRINT_RANK(LIMIT(ABL:MASTER:教養+1,0,MaxNonHLevel), @"MAX_20")
		PRINTFORML  {LIMIT(ABL:MASTER:教養+1,0,MaxNonHLevel)} 지식
		CALL PRINT_RANK(LIMIT(ABL:MASTER:料理技能+1,0,MaxNonHLevel), @"MAX_20")
		PRINTFORML  {LIMIT(ABL:MASTER:料理技能+1,0,MaxNonHLevel)} 요리
		CALL PRINT_RANK(LIMIT(ABL:MASTER:技巧+2,0,MaxNonHLevel), @"MAX_6")
		PRINTFORML  {LIMIT(ABL:MASTER:技巧+2,0,MaxNonHLevel)} 기교
		CALL PRINT_RANK(LIMIT(ABL:MASTER:話術技能+3,0,MaxNonHLevel), @"MAX_20")
		PRINTFORML  {LIMIT(ABL:MASTER:話術技能+3,0,MaxNonHLevel)} 말하기
	CASE 3
		ニューゲーム特典 '= "スケベセット"
		LOCALS = 음란한 것을 제공하는 자
	CASE 4 TO 10 ;addition custom code
		ニューゲーム特典 '= buttonText:RESULT
		CALL Add_NewGameBonus(buttonText:RESULT)
		SIF !RESULT
			RESTART
		LOCALS = %ニューゲーム特典%
	CASE 99 ;addition custom code
		ニューゲーム特典 '= "なし"
		LOCALS = 보너스 없음
		PRINTFORMW 이걸 선택하면 아무것도 얻을 수 없다. 정말로.
	CASE 12
		ニューゲーム特典 '= "WhereaboutsSense"
		LOCALS = 위치짐작으로 시작한다
	CASE 13
		IF FLAG:周回数 && ABL:MASTER:41 < 5 && ABL:MASTER:42 < 5 && ABL:MASTER:43 < 5 && ABL:MASTER:44 < 5 && ABL:MASTER:50 < 5 && ABL:MASTER:51 < 5 && ABL:MASTER:52 < 5 && ABL:MASTER:53 < 5
			ニューゲーム特典 '= "FastLearner"
			LOCALS = 상당히 빠른 습득속도로 시작한다.
		ELSE
			RESTART
		ENDIF
	CASE 15
		ニューゲーム特典 '= "StarShip"
		LOCALS = 성간 우주선으로 시작하며 달, 마카이 및 빠른 이동을 가능하게 한다.
	CASE 16
		ニューゲーム特典 '= "PrudeHarmonizer"
		LOCALS = 【Reserved】를 무효화하는 임플란트부터 시작한다.
	CASE 17
		ニューゲーム特典 '= "ESP"
		LOCALS = 처음부터 단막 마법을 사용할 수 있는 능력으로 시작한다.
	CASE 50
		ニューゲーム特典 '= "NonHMaster"
		LOCALS = 레벨 6의 동물, 요리, 제작, 식물로 시작한다.
	CASE 51
		ニューゲーム特典 '= "CombatMaster"
		LOCALS = 레벨 {MaxNonHLevel} 전투로 시작하며, 레벨 {MaxNonHLevel} 손가락 기술도 함께 사용한다.
	CASE 52
		ニューゲーム特典 '= "IntelMaster"
		LOCALS = Start with level {MaxNonHLevel} knowledge and speech
	CASE 53
		ニューゲーム特典 '= "HMaster"
		LOCALS = 모든 성적 기교에서 레벨 5로 시작한다.
ENDSELECT
PRINTFORMW %LOCALS%가 선택되었다.
RETURN
