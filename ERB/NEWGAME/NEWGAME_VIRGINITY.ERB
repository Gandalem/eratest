@VIRGIN_SET_APPLY
FOR LOCAL, 1, CHARANUM
IF 初期貞操:LOCAL:0
	CALL VIRGIN_SET_APPLY_PART(LOCAL, 初期貞操:LOCAL:0)
ELSE
	CALL VIRGIN_SET_APPLY_PART(LOCAL, 全員の貞操)
ENDIF
NEXT
;-----------------------------------------------------------
;-----------------------------------------------------------

@VIRGIN_SET_APPLY_PART(ARG, ARG:1)
SELECTCASE ARG:1
	CASE 0
	CASE 1
		CALL SET_VIRGIN(ARG:1)
		TALENT:ARG:SexKnow = -1
	CASE 2
		CALL SET_VIRGIN(ARG)
	CASE 3
		CALL SET_WELL_EXP(ARG)
	CASE 4
		CALL SET_YARIMAN(ARG)
	CASE 5
		CALL SET_VIRGIN(ARG)
		SIF TALENT:ARG:性別嗜好 == 1
			TALENT:ARG:性別嗜好 = 0
		ABL:ARG:欲望 = 3
		TALENT:ARG:ヤリマン = 1
		TALENT:ARG:貞操 = -1
	CASE 6
		CALL SET_FUTANARI(ARG)
		SIF 全員ふたなり化 != 1
			CALL SET_FUTANARI_SHAPE(ARG)
	CASE 7
		CALL SET_VIRGIN(ARG)
		CALL SET_FUTANARI(ARG)
		SIF 全員ふたなり化 != 1
			CALL SET_FUTANARI_SHAPE(ARG)
	CASEELSE
		THROW 貞操設定が不適切です
ENDSELECT
