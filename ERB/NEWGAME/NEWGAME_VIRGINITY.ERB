;-----------------------------------------------------------
;個別設定
;-----------------------------------------------------------

@SET_VIRGINITY
#DIM CHARA_ID
FOR CHARA_ID, 0, CHARANUM
SIF !IS_NAMED(CHARA_ID)
	CONTINUE
SIF TALENT:CHARA_ID:処女
	SETCOLOR C_PINK
SIF TALENT:CHARA_ID:ヤリマン
	SETCOLOR C_P_BLUE
LOCALS '= @"[{CHARA_ID, 3}] %SET_VIRGINITY_KEY(初期貞操:CHARA_ID:0)%%CALLNAME:CHARA_ID%"
PRINTFORMLC %LOCALS%
RESETCOLOR
NEXT
PRINTL
DRAWLINE
PRINTL [999] 설정 종료
DO
INPUT
CHARA_ID = RESULT
SELECTCASE CHARA_ID
	CASE 999
		PRINTW 개별 설정을 종료한다.
		RETURN
	CASEELSE
		IF !IS_NAMED(CHARA_ID)
			CLEARLINE 1
			CONTINUE
		ENDIF
		BREAK
ENDSELECT
LOOP 1
初期貞操:CHARA_ID:0 ++
SIF 初期貞操:CHARA_ID:0 >= 8
	初期貞操:CHARA_ID:0 = 0
SELECTCASE 初期貞操:CHARA_ID:0
	CASE 0
		PRINTFORMW %CALLNAME:CHARA_ID%의 능력을 초기 설정으로 되돌립니다.
	CASE 1
		PRINTFORMW %CALLNAME:CHARA_ID%를 처녀이자 무지로 만든다.
	CASE 2
		PRINTFORMW %CALLNAME:CHARA_ID%를 처녀로 만든다.
	CASE 3
		PRINTFORMW %CALLNAME:CHARA_ID%를 처녀가 아닌 상태로 만든다.
	CASE 4
		PRINTFORMW %CALLNAME:CHARA_ID%를 야리맨으로 만든다
	CASE 5
		PRINTFORMW %CALLNAME:CHARA_ID%를 처녀이면서 성적으로 만드는
	CASE 6
		PRINTFORMW %CALLNAME:CHARA_ID%를 여장하게 만든다
	CASE 7
		PRINTFORMW %CALLNAME:CHARA_ID%를 처녀이자 둘 다로 만든다
	CASEELSE
		THROW 貞操設定が不適切です
ENDSELECT
RESTART
;-----------------------------------------------------------
;設定略語
;-----------------------------------------------------------

@SET_VIRGINITY_KEY(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF ""
	CASE 1
		RETURNF "[無知]"
	CASE 2
		RETURNF "[処女]"
	CASE 3
		RETURNF "[熟練]"
	CASE 4
		RETURNF "[ヤリ]"
	CASE 5
		RETURNF "[ヤ処]"
	CASE 6
		RETURNF "[ふた]"
	CASE 7
		RETURNF "[双処]"
	CASEELSE
		THROW 貞操設定が不適切です
ENDSELECT
