@NEWGAME_OPTION
#DIMS choices, 100
;初期化
;甲斐性なし、農民
SETBIT FLAG:1000, 1
SETBIT FLAG:1000, 2
;TINKO
SIF !TALENT:MASTER:形状
	TALENT:MASTER:形状 = 3
;服
SIF !CFLAG:MASTER:基本服装セット
	CALL MASTER_CLOTHES_INIT
;
;SIF !ゲーム開始処理中
;	ニューゲーム特典 '= "なし"
;選択肢
VARSET choices
PRINTL
PRINTL
PRINTL 게임이 시작되기 전에 다양한 설정을 할 수 있다.
DRAWLINE
;あなた設定
SIF !FLAG:なりきり
	choices:0 '= @"자신을 다시 꾸미기"
SIF HAS_PENIS(MASTER)
	choices:1 '= @"당신의 성기는 현재 %TINKO_SIMPLE(MASTER)%이다."
choices:2 '= @"당신은 %MASTER_CLOTHES_NAME(CFLAG:MASTER:基本服装セット)%을 입고 있다."
IF FLAG:甲斐性無
	choices:3 '= @"당신은 고백할 담력이 없다."
ELSE
	choices:3 '= @"고백할 수 있다"
ENDIF
SIF FLAG:LUSTMODE
	choices:3 += "(Lust mode enabled)"
IF FLAG:地主
	choices:4 '= @"당신은 지주인 %CALLNAME:(FLAG:地主)%를 위해 일하는 농부이다."
ELSE
	choices:4 '= @"당신은 자유로운 %PRINT_MALE("man", MASTER)%이다"
ENDIF
SIF nStartingBackstory > 20
	choices:5 '= @"거주지: %GET_MAPNAME(MAIN_MAP)% %STR_TR(デフォルト初期位置 + (MAIN_MAP ? 8000 # 0) )%"
;------------------------------------------------------------------------------------------------------
;Custom code, Lunatic Survival option.
RESULTS =
TRYCALLF LS_NEW_GAME_OPTION_TEXT
choices:6 '= RESULTS
;------------------------------------------------------------------------------------------------------
;幻想郷
;custom code, commented out since it's replaced by EN QoL
;choices:10 '= @"Change who is or is not a virgin"
choices:11 '= @"모든 사람의 몸을 바꾸기"
IF FLAG:POSTAL == -1
	choices:12 '= @"환상향은 폭력이 없는 평화로운 장소이다."
ELSEIF !FLAG:POSTAL
	choices:12 '= @"이상한 곳은 평화로운 장소이지만, 누군가 총을 겨누면 준비된 자들이 있다."
ELSEIF FLAG:POSTAL == 1
	choices:12 '= @"이상향은 개방된 국가다."
ELSEIF FLAG:POSTAL == 2
	choices:12 '= @"전설의 마을은 강력한 무기를 보여주는 것을 부끄러워하지 않는다."
ELSEIF FLAG:POSTAL == 3
	choices:12 '= @"당신은 이제 이상향의 가장 수배된 존재다."
ELSEIF FLAG:POSTAL == 4
	choices:12 '= @"모두가 서로를 미워하고 그들과 당신이 죽기를 원한다."
ENDIF
SELECTCASE PermaDeath
	CASE -1
		choices:13 '= "All characters will resurrect the day after their death"
	CASE 0
		choices:13 '= "Gods, ghosts, and fairies can die, but they'll resurrect the day after"
	CASE 1
		choices:13 '= "Characters will never automatically resurrect. They must be resurrected by other means."
	CASE 2
		choices:13 '= "Dead is dead. If a character dies, they are permanently dead."
ENDSELECT
;特典
choices:20 '= NEWGAMEBONUS_TEXT()
IF ゲーム引き継ぎ処理中
	choices:21 '= 周回特典_表示()
ENDIF
CALL ASK_CHOICES(choices, 100, "Finished")
SELECTCASE RESULT
	CASE 0
		IF !FLAG:なりきり
			CALL CHAR_EDITOR_NAS(MASTER)
			CALL SET_MAINHOME
		ENDIF
	CASE 100
		CALL VIRGIN_SET_APPLY
		CALL SET_BODY_APPLY
		CALL NEWGAME_BONUS_APPLY
		CALL SET_APPLY_NOUMIN
		;CALL 周回特典_適用
		ITEM:安物食材 = 10
		RETURN
	CASE 1
		SIF HAS_PENIS(MASTER)
			CALL TINKO_DECIDE(MASTER)
	CASE 2
		CALL MASTER_CLOTHES
	CASE 3
		CALL KAISYONASI
	CASE 4
		CALL RESET_NOUMIN
		CALL SET_NOUMIN
	CASE 5
		CALL SET_MAINHOME
		;------------------------------------------------------------------------------------------------------
		;Custom code, Lunatic Survival.
		SELECTCASE MAIN_MAP
			;Disable Lunatic Survival if another map is picked.
			CASE 3
			CASEELSE
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletActive,0)
		ENDSELECT
	CASE 6
		CALL LS_NEW_GAME_OPTION
		;------------------------------------------------------------------------------------------------------
		;custom code, commented out since it's replaced by EN QoL
		;CASE 10
		;CALL VIRGIN_SET
	CASE 11
		CALL BODY_SET
	CASE 12
		CALL OPEN_CARY_SET
	CASE 13
		CALL PERMADEATH_SET
	CASE 20
		CALL NEWGAME_BONUS_SELECT
	CASE 21
		IF ゲーム引き継ぎ処理中
			CALL 周回特典
		ENDIF
ENDSELECT
RESTART
