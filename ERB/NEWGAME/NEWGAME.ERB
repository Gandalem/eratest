;FileName_SHOP_CUSTOM.ERB -------------------------- Rev1.00
;CALL		USER
;ARG		NONE
;RETURN		VOID
;COMMENT
;キャラを追加したときにいちいちここをいじる必要の無いように
;キャラクタ数上限はERHファイルで定義
;-----------------------------------------------------------

@ADD_ALL_CHARACTERS(ARG) ;custom arg to skip muiltiple dialogue choice
;addition custom code
;CALL ADD_SET_RELATION
;LOCAL:5 = !RESULT
;Custom Character Custom code
;needed for custom character checks
#DIM CHARA
LOCAL:5 = 1
TARGET = 0
REDRAW 0
FOR LOCAL,CHARANUM,キャラクタ数上限
SIF !EXISTCSV(LOCAL)
	BREAK
CALL ADDCHARA_INIT(LOCAL) ;custom code
SIF inCharaCreator && !DAY; character creator
	CONTINUE
CALL SET_MINIMUM_EXP_ALL(LOCAL)
;Custom Character Custom code
;Preventing null pointers
;- Mr Pops Alot
SIF CHARA >= CHARANUM
	CHARA = CHARANUM-1
IF !EXP:CHARA:キス経験
	TALENT:CHARA:キス未経験 = 1
ENDIF
CALL CustomTraits(LOCAL) ;added
CALL PREGNANCY_TYPES_NEWGAME_SET() ;custom code
CALL SetOmoStats(LOCAL)
;NAS: This is handled using the update function
CALL KOJO_MULTIPLE(LOCAL,1)
SIF LOCAL%10 == 0
	CALL ANIMATION_LOAD_NAS(LOCAL, 0, CSV_CHARANUM(), @"캐릭터 추가하기") ;nas loading
NEXT
;character creator
SIF inCharaCreator && !DAY
	RETURN
;do it again for relations
FOR LOCAL,0,キャラクタ数上限
SIF LOCAL:5
	CALL ADD_SET_RELATION_PROC(LOCAL)
;Unfair Mode Stuff
IF LOCAL < CHARANUM
	IF GETBIT(nUnfair,0) && LOCAL < CHARANUM
		CALL CHARACTER_DIALOG_STATUS(LOCAL)
		SIF STRFIND(RESULTS, "vinumsabbathi") > -1
			MAXBASE:LOCAL:TSP = 4000
		SIF STRFIND(RESULTS, "Mr Pops Alot") > -1
			TALENT:LOCAL:OmoGuardian = 4
		IF STRFIND(RESULTS, "Pedy") > -1
			TALENT:LOCAL:21 = 2
			ABL:LOCAL:Melee = MAX(ABL:LOCAL:Melee,UniversalRank("Extra"))
		ENDIF
	ENDIF
	IF GETBIT(nUnfair,1)
		;Family Names
		CALL RandomName(LOCAL, 5)
		IF BloodlineName:LOCAL:0 == ""
			BloodlineName:LOCAL:0 = %nameArray:LOCAL:na_LastName%
			;CALLNAME:(LOCAL) = %nameArray:(LOCAL):na_FirstName%
		ELSE
			nameArray:LOCAL:na_LastName = %BloodlineName:LOCAL:0%
			CALLNAME:(LOCAL) = %nameArray:(LOCAL):na_FirstName%
		ENDIF
		NAME:(LOCAL) = %NameChecker(LOCAL)%
		FOR LOCAL:1, 0, CHARANUM
		IF !CharaFamily:LOCAL:(LOCAL:1)
			CONTINUE
		ELSE
			SIF BloodlineName:(LOCAL:1):0 == ""
				BloodlineName:(LOCAL:1):0 = %BloodlineName:LOCAL:0%
			nameArray:(LOCAL:1):na_LastName = %BloodlineName:(LOCAL:1):0%
			CALLNAME:(LOCAL:1) = %nameArray:(LOCAL:1):na_FirstName%
			NAME:(LOCAL:1) = %NameChecker(LOCAL:1)%
		ENDIF
		NEXT
	ELSE
		;NAS: Set blood line name as last name if not set
		SIF STRLENS(nameArray:LOCAL:na_LastName) && !STRLENS(BloodlineName:LOCAL:0)
			BloodlineName:LOCAL:0 = %nameArray:LOCAL:na_LastName%
	ENDIF
ENDIF
NEXT
;legend of gensokyo
IF SaveIsEZB
	DELCHARA CHARANUM-1
	CALL LoG_MakeAllRivals
ENDIF
