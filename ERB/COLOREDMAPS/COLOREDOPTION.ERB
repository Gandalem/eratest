@DEFAULT_MAP_COLOR

;custom code: Devtest
IF DevTest || benchMarkStart
	RECOLOREDMAPS = 1
	ANIMATERECOLOREDMAPS = 0
	RETURN 1
ENDIF

PRINTFORML Select type of map (Can be changed in options later).
PRINTFORML [0] Colored map with animation
PRINTFORML [1] Colored map without animation
;PRINTFORML [2] Default map (Untranslated)

$INPUTLOOP
INPUT
IF RESULT == 0
	RECOLOREDMAPS = 1
	ANIMATERECOLOREDMAPS = 1000
ELSEIF RESULT == 1
	RECOLOREDMAPS = 1
	ANIMATERECOLOREDMAPS = 0
; ELSEIF RESULT == 2 ;custom code, disabled
; 	RECOLOREDMAPS = 0
; 	ANIMATERECOLOREDMAPS = 0
ELSE
	RESTART
ENDIF
