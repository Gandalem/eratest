; Modular ERB: COLOREDOPTION.ERB

@DEFAULT_MAP_COLOR
;custom code: Devtest
IF DevTest || benchMarkStart
	RECOLOREDMAPS = 1
	ANIMATERECOLOREDMAPS = 0
	RETURN 1
ENDIF
PRINTFORML 지도 유형을 선택한다(나중에 옵션에서 변경 가능).
PRINTFORML [0] 애니메이션이 있는 컬러 지도
PRINTFORML [1] 애니메이션이 없는 컬러 지도
;PRINTFORML [2] Default map (Untranslated)
$INPUTLOOP
INPUT
IF RESULT == 0
	RECOLOREDMAPS = 1
	ANIMATERECOLOREDMAPS = 1000
ELSEIF RESULT == 1
	RECOLOREDMAPS = 1
	ANIMATERECOLOREDMAPS = 0
	; ELSEIF RESULT == 2 ;custom code, disabled
	; 	RECOLOREDMAPS = 0
	; 	ANIMATERECOLOREDMAPS = 0
ELSE
	RESTART
ENDIF
