@DAILY_CONDITION_EV4
SIF RAND:7 > 0
	RETURN -1
CALL DAILY_EV4
RETURN 1

@DAILY_EV4
CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)
FOR LOCAL:10, 0, CHARANUM - 1
LOCAL = SHAFFLE_ARRAY:(LOCAL:10) + 1
IF ABL:LOCAL:親密 >= 5 && !CFLAG:LOCAL:神社在住
	CALL KOJO_MESSAGE_SEND("DAILY", 4, LOCAL)
	CFLAG:LOCAL:翌日来訪 = 1
	BREAK
ENDIF
NEXT

@DAILY_MESSAGE_4(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
CALL PRINT_FACE, ARG ;qol custom code
PRINTFORMDW 무작위 생각에 빠져 있던 %CALLNAME:ARG%은 어느 시점에 당신을 생각했었다는 것을 깨닫는다.
PRINTFORMDW %CALLNAME:ARG%이 내일 당신을 찾아오기로 결정한 것 같다.
PRINTL 
CALL SET_KOJO_COLOR()
