; Modular ERB: デイリーイベント/DAIRY_EV15 異常気象.ERB

@DAILY_CONDITION_EV15
SIF RAND:20 > 0 || FLAG:異常気象
	RETURN -1
CALL DAILY_EV15
RETURN 1

@DAILY_EV15
FLAG:異常気象 = 6 + RAND:2
TIME:5 = 0
WIND_VELOCITY = 0
SELECTCASE FLAG:異常気象
	CASE 6
		LOCALS = 소녀들이 치마를 들어 올리는 것에서 이상한 쾌감을 얻게 한다.
	CASE 7
		LOCALS = 팬티가 공중을 떠다녔다.
		;CASE 8
		;	LOCALS = a pink wind to blow through
ENDSELECT
PRINTFORMW 지구 온난화, 환경 오염, 난민, 대통령 선거, 팬데믹, 장시간 노동, 걸으면서 문자 보내기, 스위치 부족......
PRINTFORMW 이상 세계의 다양한 문제들로부터 그 영향을 받지 않을 수 없다.
CALL COLORMESSAGE(@"외부 세계의 사건들로 인해 %LOCALS%에 이상한 날씨가 생겼다.",C_PINK,2,1)
