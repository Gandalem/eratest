@DAILY_EV2
#DIM CHARA
PRINTFORML 당신은 즐거운 느낌으로 한밤중에 잠에서 깨어난다.
PRINTFORMW 당신의 사타구니가 꽤 따뜻하다...
PRINTFORML !!!! 당신은 습한 꿈을 꾸었다!
PRINTFORMW 당신은 그것을 좀 더 의미 있는 방식으로 보내지 않은 것을 깊이 후회한다...
PRINTL 
FLAG:71 = 0
TALENT:MASTER:120 = 0
BASE:MASTER:精力 -= 500
EXP:MASTER:射精経験 ++
IF RAND:10 == 0 && ITEM:ミラダの石 == 0
	PRINTFORML %BREAKENG(@"기온, 풍향, 습도, 기압, 요일, 월삭, 행성 배열 등의 경이로운 조합으로 불가능한 일이 일어났다.")%
	FONTBOLD
	PRINTFORM 당신의 정액이 결정화되어 형성한다. 
	CALL COLORMESSAGE("욕망을 독점하는 미라다의 돌", C_D_PINK, 0, 1)
	PRINTFORMW !
	FONTREGULAR
	CALL GET_ITEM("ミラダの石", 1, 1)
	RETURN 1
ENDIF
CALL FISHER_YATES_SHAFFLE(CHARANUM)
VARSET LOCAL
FOR LOCAL, 1, CHARANUM
CHARA = SHAFFLE_ARRAY:LOCAL
;対象があなた
SIF CHARA == MASTER
	CONTINUE
;でてこない
SIF CFLAG:CHARA:出禁
	CONTINUE
;拠点キャラではない
SIF !CFLAG:CHARA:神社在住
	CONTINUE
;同じエリア内に住んでいない
SIF MAP_AREASELECT(MAIN_MAP, CFLAG:MASTER:初期位置) != MAP_AREASELECT(MAIN_MAP, CFLAG:CHARA:初期位置)
	CONTINUE
LOCAL:1 = CHARA
BREAK
NEXT
SIF LOCAL:1 <= 0
	RETURN
CALL KOJO_MESSAGE_SEND("DAILY", 2, LOCAL:1)

