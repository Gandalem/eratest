@DAILY_CONDITION_EV31
;前日にお知らせ。
IF (DAY:2 == 3 && DAY:3 == 13)
	RETURN 1
	CALL DAILY_EV31
ELSE
	RETURN -1
ENDIF

@DAILY_EV31
CALL M_KOJO_COLOR_K62
IF MAIN_MAP == 4
