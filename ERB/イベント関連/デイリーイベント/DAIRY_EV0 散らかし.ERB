; Modular ERB: デイリーイベント/DAIRY_EV0 散らかし.ERB

@DAILY_CONDITION_EV0
SIF RAND:8 > 0
	RETURN -1
SIF DAY <= 30
	RETURN -1
SIF AVERAGE_YOGORE() > 800
	RETURN -1
CALL DAILY_EV0
RETURN 1

@DAILY_EV0
;addition custom code
IF TALENT:MASTER:FAIRY_FRIEND > 0
	IF RAND:10 < TALENT:MASTER:FAIRY_FRIEND
		PRINTFORML %BREAKENG(@"당신은 한밤중에 깨어나며, 섬세하게 조정된 감각이 요정들의 물결이 %GET_MAPNAME(MAIN_MAP)%에 다가오려 한다는 것을 알려준다.")%
		PRINTFORML 그들이 온 사방에 큰 엉망을 만들기 전에 막고 싶나요?
		CALL ASK_YN("네", "그냥 그들이 즐기도록 내버려 두자")
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 당신은 자신의 영향력을 사용하여 요정들에게 다른 곳으로 가도록 설득한다.
				PRINTFORMW 내일 그들의 어질러 놓은 것을 치를 필요가 없을 거라는 사실에 안심한 채, 당신은 재빨리 다시 잠이 든다.
				RETURN
			CASE 1
				PRINTFORML 당신은 몸을 돌려 다시 잠이 든다. 모든 사소한 일에 대해 걱정할 필요는 없다.
		ENDSELECT
	ENDIF
ENDIF
PRINTFORML 당신이 잠든 사이, 거대한 수의 요정들이 %GET_MAPNAME(MAIN_MAP)%에 도착한다!
IF RAND:10 < ABL:MASTER:戦闘能力 && AT_HOME(MASTER) == 1
	PRINTFORML 요정들이 %GET_MAPNAME(MAIN_MAP)% 주위를 날아다니며 난장판을 만든다.
	PRINTFORML 깨어나 밖에 나가자마자 모두 도망친다.
	FOR LOCAL,MINROOM(),MAXROOM
	IF RAND:10 <= ABL:MASTER:戦闘能力
		YOGORE:LOCAL = MIN(YOGORE:LOCAL + 1000 + RAND:4000, 6000)
	ENDIF
	NEXT
	;ブラックサンダーを10個以上所持
ELSEIF ITEM:120 >= 10 && AT_HOME(MASTER) == 1
	;最大9つ。あなたの分は残しておく
	PRINTFORML 깨어나 보니 요정들이 네 블랙 썬더를 먹고 있었다.
	PRINTFORML 너는 그들의 입을 닦아주고 단호하게 집으로 돌아가라고 말했다.
	CALL LOST_ITEM("ブラックサンダー", RAND:9 + 1, 1)
ELSE
	PRINTFORML 요정들이 %GET_MAPNAME(MAIN_MAP)% 주변을 날아다니며 난장판을 만든다.
	FOR LOCAL,MINROOM(),MAXROOM
	YOGORE:LOCAL = MIN(YOGORE:LOCAL + 1000 + RAND:4000, 6000)
	NEXT
ENDIF
PRINTW 
