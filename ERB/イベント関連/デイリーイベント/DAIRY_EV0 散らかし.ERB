@DAILY_CONDITION_EV0
SIF RAND:8 > 0
	RETURN -1
SIF DAY <= 30
	RETURN -1
SIF AVERAGE_YOGORE() > 800
	RETURN -1

CALL DAILY_EV0
RETURN 1

@DAILY_EV0
;addition custom code
IF TALENT:MASTER:FAIRY_FRIEND > 0
	IF RAND:10 < TALENT:MASTER:FAIRY_FRIEND
		PRINTFORML %BREAKENG(@"You wake up in the middle of the night, your finely tuned senses informing you that a surge of fairies is about to approach %GET_MAPNAME(MAIN_MAP)%.")%
		PRINTFORML Do you want to stop them before they make a huge mess everywhere?
		CALL ASK_YN("Yes", "Just let them have their fun")
		SELECTCASE RESULT
			CASE 0
				PRINTFORML You use your influence to convince the fairies to go somewhere else.
				PRINTFORMW Reassured in the knowledge that you won't have to clean up their mess tomorrow, you quickly go back to sleep.
				RETURN
			CASE 1
				PRINTFORML You turn around and go back to sleep. No need to fret over every little thing.
		ENDSELECT
    ENDIF
ENDIF

PRINTFORML As you sleep a massive surge of fairies arrive at %GET_MAPNAME(MAIN_MAP)%!
IF RAND:10 < ABL:MASTER:戦闘能力 && AT_HOME(MASTER) == 1
	PRINTFORML The fairies fly around %GET_MAPNAME(MAIN_MAP)% and make a mess.
	PRINTFORML As soon as you wake up and step out, they all flee.
	FOR LOCAL,MINROOM(),MAXROOM
		IF RAND:10 <= ABL:MASTER:戦闘能力
			YOGORE:LOCAL = MIN(YOGORE:LOCAL + 1000 + RAND:4000, 6000)
		ENDIF
	NEXT
;ブラックサンダーを10個以上所持
ELSEIF ITEM:120 >= 10 && AT_HOME(MASTER) == 1
	;最大9つ。あなたの分は残しておく
	PRINTFORML You awake to find the fairies munching on your Black Thunders.
	PRINTFORML You wipe their mouths and tell them sternly to return home.
	CALL LOST_ITEM("ブラックサンダー", RAND:9 + 1, 1)
ELSE
	PRINTFORML The fairies fly around %GET_MAPNAME(MAIN_MAP)% and make a mess.
	FOR LOCAL,MINROOM(),MAXROOM
		YOGORE:LOCAL = MIN(YOGORE:LOCAL + 1000 + RAND:4000, 6000)
	NEXT
ENDIF
PRINTW 