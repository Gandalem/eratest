; Modular ERB: デイリーイベント/DAIRY_EV20 生首さんいらっしゃい.ERB

@DAILY_CONDITION_EV20
SIF RAND:15 > 0
	RETURN -1
SIF CFLAG:[[蛮奇]]:神社在住
	RETURN -1
SIF CFLAG:[[蛮奇]]:出禁
	RETURN -1
SIF !TALENT:[[蛮奇]]:思慕 && ! TALENT:[[蛮奇]]:恋慕
	RETURN -1
CALL DAILY_EV20
RETURN 1

@DAILY_EV20
#DIM 来客数
PRINTFORML 깊은 밤, 창문에서 목소리가 들려온다.
PRINTFORMW 눈을 비비며 창문을 열자 떠다니는 잘린 머리를 보게 된다.
PRINTFORML ...It's %CALLNAME:[[蛮奇]]%'s.
PRINTFORML %HE_SHE([[蛮奇]],1)%은(는) %HE_SHE([[蛮奇]])%가 지나가는 것을 보고 들러보기로 결정했다고 말한다.
CALL ASK_YN(@"%HIM_HER([[蛮奇]])%가 들어온다",@"%HIM_HER([[蛮奇]])%를 보낸다")
IF RESULT
	PRINTFORMW 당신은 너무 졸려서 %HIM_HER([[蛮奇]])%를 보낸다. 
	RETURN
ENDIF
PRINTFORML 당신은 %HIM_HER([[蛮奇]])%을 초대하기로 결정한다.
来客数 = 1
IF ABL:[[蛮奇]]:親密 >= 10 && !RAND:3
	PRINTFORML %HIS_HER([[蛮奇]],1)%의 머리가 창문으로 떠다니며 들어온다... 하지만 그것은 하나만이 아니다.
	FOR LOCAL,2,ABL:73:親密 - 5
	SIF !RAND:2
		CONTINUE
	来客数 ++
	PRINTFORMW {来客数} 명의 머리들이 떠다니며 들어온다.
	SIF 来客数 >= 9
		BREAK
	NEXT
	SIF 来客数 == 1
		PRINTFORML 아니면, 다시 생각해보니 그냥 한 명뿐이다.
	SIF 来客数 >= 4
		PRINTFORMW 이렇게 많은 똑같은 얼굴들에게 둘러싸여 있다니, 조금 불편하다...
ENDIF
IF TIME:5 >= 4
	PRINTFORML %CALLNAME:[[蛮奇]]%이 비에 젖어 있으니, 당신은 %HIM_HER([[蛮奇]])%에게 수건을 준다.
	PRINTFORML %HIS_HER([[蛮奇]])%가 그것 위에서 머리를 굴리는 것을 보는 것은 꽤 재미있다.
ELSE
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 눈높이를 맞추기 위해 책상 위에 쿠션을 놓고 %HIM_HER([[蛮奇]])%가 그것에 앉게 한다.
			SIF 来客数 > 1
				PRINTFORML 줄지어 선 머리들이 극도로 음산해 보였다. 마치 처형 후 장식된 가시 위의 머리들 같았다.
		CASE 1
			PRINTFORML 당신은 %HIM_HER([[蛮奇]])%에게 차를 주지만, %HE_SHE([[蛮奇]])%가 그것을 힘들어해서 빨대도 넣어준다.
			PRINTFORML 잠깐, %HE_SHE([[蛮奇]])%가 마시는 그 차는 정확히 어디로 가는 걸까...?
		CASE 2
			PRINTFORML 당신은 %HIS_HER([[蛮奇]])%의 머리에 붙어 있던 나뭇잎을 제거한다.
	ENDSELECT
ENDIF
PRINTFORMW 
PRINTFORMW ...
PRINTFORMW ......
PRINTFORMW .........
IF RAND:100 < ABL:[[蛮奇]]:親密 * 3 + TALENT:[[蛮奇]]:恋慕 * 15
	PRINTFORM After chatting for a while, the friendly head\@ 来客数 > 1 ? s say# %" "%says\@ %HIS_HER([[蛮奇]])% body will come by tomorrow
	IF !PRIVATEROOM:(CFLAG:MASTER:初期位置 % 100) && TALENT:[[蛮奇]]:恋慕
		PRINTFORML 그리고 %COND_STR(@"s", 来客数 == 1)%에게 하룻밤 머물러 달라고 부탁했다.
		PRINTFORML , 그리고 손님 수 %COND_STR(@"s", 来客数 == 1)% 만큼 머무르도록 부탁한다.
	ELSE
		PRINTFORML .
	ENDIF
	CFLAG:[[蛮奇]]:翌日来訪 = 1
ELSE
	PRINTFORML After chatting for a while, the friendly head\@ 来客数 > 1 ? s fly# %" "%flies\@ away through the window.
	SIF !RAND:2
		CFLAG:[[蛮奇]]:翌日来訪 = 1
ENDIF
;システムメッセージつき好感度変化
;最後の引数だけ好感度が変化
CALL CHANGE_CFLAG(2,[[蛮奇]],50)
;システムメッセージつき信頼度変化
;最後の引数だけ信頼度が変化
CALL CHANGE_CFLAG(4,[[蛮奇]],20)
;睡眠時間減少
CFLAG:MASTER:就寝時間 += 60
CALL COLORMESSAGE("수면 시간이 한 시간 감소했다.",C_YELLOW,2)
