; Modular ERB: デイリーイベント/DAIRY_EV7 アルハラ.ERB

@DAILY_CONDITION_EV7
IF !RAND:15 && MAIN_MAP == 9
	;addition custom code
	CALL DAILY_EV7_EDIT
	;CALL DAILY_EV7
	RETURN 1
ELSE
	RETURN -1
ENDIF

@DAILY_EV7
#DIM 人数
#DIM YUGI
VARSET LOCAL
YUGI = !RAND:4
IF YUGI
	LOCALS = 유우기 그리고 다른 사람들
ELSE
	LOCALS = 오니
ENDIF
人数 = 1 + RAND:5
PRINTFORML 당신이 잠자리에 들려는 순간, 술 취한 오니 ${人数} 명이 비틀거리며 들어온다!
SIF YUGI
	PRINTFORML 유우기 또한 등장한다...
PRINTFORMW 그들은 여기에 머물며 계속 마실 작정인 것 같다...
PRINTFORML 
;他の選択肢は後で
;ASK_M("受け入れる","酒を渡して出て行ってもらう","ぶちのめす")
PRINTFORML 당신은 %LOCALS%를 강압적으로 초대한다.
PRINTFORML 그들은 자제를 보이지 않고 시작하기 전에 술과 간식을 펼친다.
LOCAL:1 = 1
FOR LOCAL,0,人数
LOCAL:1 += RAND:3
NEXT
SIF YUGI
	LOCAL:1 += RAND:3 + RAND:3
FOR LOCAL,0,LOCAL:1
PRINTFORMW ...
PRINTFORMW ......
PRINTFORML 당신은 마시도록 강요당한다.
SELECTCASE RAND:3
	CASE 0
		PRINTFORMW 놀라울 정도로 평범한 사케다.
		LOCAL:2 = 200
	CASE 1
		PRINTFORMW 상당히 강한 사케다.
		LOCAL:2 = 400
	CASE 2
		PRINTFORMW 이거 엄청나게 강하다!
		LOCAL:2 = 700
ENDSELECT
PRINTFORMW 
BASE:MASTER:酒気 += LOCAL:2
IF YUGI
	CALL CHANGE_CFLAG(2,64,3)
	CALL CHANGE_CFLAG(4,64,1)
ENDIF
IF BASE:MASTER:酒気 > MAXBASE:MASTER:酒気
	PRINTFORML 「크아아악!」
	PRINTFORML 네가 내뱉는다!
	YOGORE:(CFLAG:MASTER:初期位置) += 1500
	BASE:MASTER:気力 -= 500
	MAXBASE:MASTER:酒気 += 3
	PRINTFORMW \@ YUGI ? %LOCALS% # 오니 \@는 통제 불능으로 웃었다...
	IF BASE:MASTER:気力 < 0
		PRINTFORMW 당신은 쓰러진다!
		BASE:MASTER:気力 -= 1000
		LOCAL:3 ++
		BREAK
	ELSE
		BASE:MASTER:酒気 /= 2
	ENDIF
ELSEIF BASE:MASTER:酒気 > MAXBASE:MASTER:酒気 * 3 / 4
	PRINTFORMW 당신은 약간 몸이 안 좋은 것을 느끼기 시작한다.
ENDIF
NEXT
IF !LOCAL:3
	PRINTFORML 당신은 술에 의한 괴롭힘을 견뎌냈다!
	IF YUGI
		CFLAG:64:好感度 += 150
		CFLAG:64:信頼度 += 100
	ENDIF
	MAXBASE:MASTER:酒気 += 20
ENDIF
CFLAG:MASTER:徹夜 = 1
YOGORE:(CFLAG:MASTER:初期位置) += 1000
MAXBASE:MASTER:酒気 = LIMIT(MAXBASE:MASTER:酒気,1500,3000)
PRINTFORML 새벽이 밝으면 %LOCALS%는 떠난다.
PRINTFORML 그들은 당신에게 빈 병들의 많은 양과 %COND_STR(@" 그리고 구토의 악취", LOCAL:3)%를 남긴다.
PRINTW 
RETURN 1
