@DAILY_CONDITION_EV13
#DIM 対象

SIF LS_ACTIVE() != "" ;Custom code, disabled during Lunatic Survival.
	RETURN -1

SIF RAND:(10 - TALENT:MASTER:劣情察知)> 0
	RETURN -1
対象 = 0
CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)
FOR LOCAL:10, 0, CHARANUM - 1
	LOCAL = SHAFFLE_ARRAY:(LOCAL:10) + 1
	SIF !CFLAG:LOCAL:神社在住
		CONTINUE
	IF CFLAG:LOCAL:溜まってる度 >  700
		対象 = LOCAL
		BREAK
	ENDIF
NEXT
SIF !対象
	RETURN -1

CALL DAILY_EV13(対象)
RETURN 1


@DAILY_EV13(ARG)
PRINTFORMW You wake up in the middle of the night.
PRINTFORMW Falling back asleep seems impossible...
CALL ASK_YN("Go outside","Stay in the room")
IF RESULT
	PRINTFORM You 
	PRINTDATA
		DATAFORM spend some time arranging and appreciating your collection
		DATAFORM think deeply about beauty, goodness, and panties
		DATAFORM chat with a stain on the wall
	ENDDATA
	PRINTFORML  until you feel sleepy again...
	CALL COLORMESSAGE("With the mind stimulated, ENE and TSP has been temporarily increased",C_YELLOW,2,1)
	CALL BUFF_BASE(MASTER,BASE_気力,100)
	CALL BUFF_BASE(MASTER,BASE_TSP,100)
ELSEIF !RAND:4 || (!RAND:4 && ABL:ARG:親密 >= 7)
	PRINTFORMW You go for a walk, \@ CFLAG:MASTER:311 == CFLAG:ARG:311 ? and when you return to your room you hear a sound# and when you're about to return you hear a sound coming from %CALLNAME:ARG%'s room\@.
	CALL ONABARE(ARG)
	CFLAG:MASTER:徹夜 = 1
ELSEIF ITEM:兎符「開運大紋」
		PRINTL Huh? The Great Fortune Crest is...
		CALL ASK_YN("Activate it","Leave it")
		IF !RESULT
			ITEM:兎符「開運大紋」 --
			SETCOLOR COLOR ("YELLOW")
			PRINTFORMW Rabbit Sign『Great Fortune Crest』activates!
			RESETCOLOR
			PRINTFORMW You go for a walk, \@ CFLAG:MASTER:311 == CFLAG:ARG:311 ? and when you return to your room you hear a sound# and when you're about to return you hear a sound coming from %CALLNAME:ARG%'s room\@.
			CALL ONABARE(ARG)
			CFLAG:MASTER:徹夜 = 1
		ELSEIF !RAND:2
			GOTO OYATU
		ELSE
			GOTO NANIMONAI
		ENDIF
ELSEIF !RAND:2
	$OYATU
	PRINTFORML You feel a bit peckish, and decide to go to bed after eating something first.
	PRINTFORMW You scrounge through the kitchen cupboards and find a snack.
	PRINTFORMW It's not one you bought. But there's a chance someone bought it for you, so you take it.
	PRINTFORML 
	CALL COLORMESSAGE("Oh no it's about to expire! Won't someone eat it soon?!",C_YELLOW,2,2)
	PRINTFORML 
	PRINTFORML You say as you eat the snack.
	CALL BUFF_BASE(MASTER,BASE_気力,300)
	CALL COLORMESSAGE("Your ENE has increased temporarily after eating a delicious snack.",C_YELLOW,2,1)
	PRINTFORMW You brush your teeth again and go to bed in a good mood.
	CALL COLORMESSAGE(@"Wonder why %CALLNAME:ARG% is in a bad mood...",C_RED,2,1)
	TALENT:ARG:機嫌 = -1
ELSE
	$NANIMONAI
	PRINTFORMW Going outside isn't that interesting, you quietly go back to bed afterwards.
	CFLAG:MASTER:就寝時間 += 60
	CALL COLORMESSAGE("Hours of sleep decreased by one hour.",C_YELLOW,2)
ENDIF
