; Modular ERB: デイリーイベント/DAIRY_EV13 自宅でオナバレ.ERB

@DAILY_CONDITION_EV13
#DIM 対象
SIF LS_ACTIVE() != "" ;Custom code, disabled during Lunatic Survival.
	RETURN -1
SIF RAND:(10 - TALENT:MASTER:劣情察知)> 0
	RETURN -1
対象 = 0
CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)
FOR LOCAL:10, 0, CHARANUM - 1
LOCAL = SHAFFLE_ARRAY:(LOCAL:10) + 1
SIF !CFLAG:LOCAL:神社在住
	CONTINUE
IF CFLAG:LOCAL:溜まってる度 >  700
	対象 = LOCAL
	BREAK
ENDIF
NEXT
SIF !対象
	RETURN -1
CALL DAILY_EV13(対象)
RETURN 1

@DAILY_EV13(ARG)
PRINTFORMW 당신은 한밤중에 잠에서 깬다.
PRINTFORMW 다시 잠드는 것은 불가능해 보인다...
CALL ASK_YN("밖에 나가라","방에 머물러라")
IF RESULT
	PRINTFORM 당신은 
	PRINTDATA
		DATAFORM 당신의 컬렉션을 정리하고 감상하는 데 시간을 보내라.
		DATAFORM 아름다움, 선함, 그리고 팬티에 대해 깊이 생각해 봐라.
		DATAFORM 벽 위의 얼룩과 대화해라.
	ENDDATA
	PRINTFORML  다시 졸음이 올 때까지…
	CALL COLORMESSAGE("정신이 자극받아, ENE와 TSP가 일시적으로 증가했다.",C_YELLOW,2,1)
	CALL BUFF_BASE(MASTER,BASE_気力,100)
	CALL BUFF_BASE(MASTER,BASE_TSP,100)
ELSEIF !RAND:4 || (!RAND:4 && ABL:ARG:親密 >= 7)
	PRINTFORMW 당신은 산책을 하고, \@ CFLAG:MASTER:311 == CFLAG:ARG:311 ? 그리고 방으로 돌아왔을 때 소리를 듣는다 # 그리고 돌아가려 할 때 %CALLNAME:ARG%'의 방에서 나는 소리를 듣는다 \@.
	CALL ONABARE(ARG)
	CFLAG:MASTER:徹夜 = 1
ELSEIF ITEM:兎符「開運大紋」
	PRINTL 응? 대길 문양이...
	CALL ASK_YN("그것을 활성화한다.","그것을 두어라")
	IF !RESULT
		ITEM:兎符「開運大紋」 --
		SETCOLOR COLOR ("YELLOW")
		PRINTFORMW 토끼의 표식 『위대한 행운의 문장』이 활성화된다!
		RESETCOLOR
		PRINTFORMW 걸어 다니는데, \@ CFLAG:MASTER:311 == CFLAG:ARG:311 ? 그리고 방으로 돌아왔을 때 소리를 듣고 # 돌아서려 할 때 %CALLNAME:ARG%'의 방에서 들리는 소리를 듣는다 \@.
		CALL ONABARE(ARG)
		CFLAG:MASTER:徹夜 = 1
	ELSEIF !RAND:2
		GOTO OYATU
	ELSE
		GOTO NANIMONAI
	ENDIF
ELSEIF !RAND:2
	$OYATU
	PRINTFORML 약간 배가 고프다고 느끼고, 뭔가 먹은 후에 잠자리에 들기로 결정했다.
	PRINTFORMW 부엌 찬장을 뒤지다가 간식을 하나 발견한다.
	PRINTFORMW 그것은 네가 산 것이 아니다. 하지만 누군가가 너를 위해 사준 것일 수도 있으니, 그것을 가져간다.
	PRINTFORML 
	CALL COLORMESSAGE("아냐, 곧 만료되겠어! 누가 빨리 먹어주지 않을까?!",C_YELLOW,2,2)
	PRINTFORML 
	PRINTFORML 당신은 간식을 먹으면서 말한다.
	CALL BUFF_BASE(MASTER,BASE_気力,300)
	CALL COLORMESSAGE("당신의 ENE는 맛있는 간식을 먹은 후 일시적으로 증가했다.",C_YELLOW,2,1)
	PRINTFORMW 당신은 다시 이를 닦고 좋은 기분으로 잠자리에 든다.
	CALL COLORMESSAGE(@"왜 %CALLNAME:ARG%가 기분이 나쁜지 궁금하다...",C_RED,2,1)
	TALENT:ARG:機嫌 = -1
ELSE
	$NANIMONAI
	PRINTFORMW 밖에 나가는 건 그다지 흥미롭지 않아서, 당신은 조용히 다시 침대로 돌아간다.
	CFLAG:MASTER:就寝時間 += 60
	CALL COLORMESSAGE("수면 시간이 한 시간 감소했다.",C_YELLOW,2)
ENDIF
