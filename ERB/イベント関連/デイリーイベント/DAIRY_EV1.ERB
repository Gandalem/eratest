; Modular ERB: デイリーイベント/DAIRY_EV1.ERB

@DAIRY_CONDITION_EV1
;永遠亭住まいなら1/10、それ以外で1/30で発生
SIF MAIN_MAP == 4 && RAND:10 > 0
	RETURN -1
SIF MAIN_MAP != 4 && RAND:30 > 0
	RETURN -1
CALL DAIRY_EV1
RETURN 1

@DAIRY_EV1
;ここにイベント内容を書こう　最後はRETURN 1してね
IF MAIN_MAP != 4
	PRINTFORML 당신은 에이텐이로부터 약물 샘플을 받는다.
ELSE
	PRINTFORML 당신은 에린에게서 약물 샘플을 받는다.
ENDIF
CALL GET_ITEM("栄養ドリンク", 1, 2)
;set wait to not skip the message
WAIT
RETURN 1
