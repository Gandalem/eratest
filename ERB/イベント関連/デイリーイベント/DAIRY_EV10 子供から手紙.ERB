; Modular ERB: デイリーイベント/DAIRY_EV10 子供から手紙.ERB

@DAILY_CONDITION_EV10
#DIM YOME
#DIM CHILDNUM
SIF RAND:20 > 0
	RETURN -1
CALL PickRandGrownChild
YOME = RESULT
CHILDNUM = RESULT:1
VARSET RESULT
SIF YOME <= 0
	RETURN -1
CALL DAILY_EV10(YOME, CHILDNUM)
RETURN 1

@DAILY_EV10(ARG, ARG:1)
;PRINTFORMW %CALLNAME:ARG%との子供の%CHILDNAME:ARG:(ARG:1)%から手紙が来た
PRINTFORMW %CHILDNAME:ARG:(ARG:1)%에게서 편지가 도착한다.
LOCAL:1 = 0
FOR LOCAL,1,CHARANUM
SIF CFLAG:LOCAL:好感度 > CFLAG:ARG:好感度
	LOCAL:1 ++
NEXT
TARGET = ARG
;口上専用の手紙イベント分岐（なければ通常イベント）,存在しないならRESULT = 2
IF !RAND:2
	CALL KOJO_MESSAGE_SEND("CHILD", 0, TARGET, ARG:1, 0, "DAILY_口上手紙")
	SIF RESULT == 2
		GOTO TEGAMI
ELSE
	$TEGAMI
	IF LOCAL:1 >= 3
		CALL KOJO_MESSAGE_SEND("CHILD", 0, TARGET, ARG:1, 0, "DAILY_共通手紙", "すけこまし")
		;存在しないならRESULT = 2（以下同様）
		IF RESULT == 2
			PRINTFORMW 그것은 %CALLNAME:ARG%이/가 %HIM_HER(ARG)%스스로를 더 돌보는 데 집중해야 한다고 말한다.
		ENDIF
	ELSEIF !RAND:5
		CALL KOJO_MESSAGE_SEND("CHILD", 0, TARGET, ARG:1, 0, "DAILY_共通手紙", "金の無心")
		IF RESULT == 2
			PRINTFORMW 그것은 돈에 관한 것이다.
		ENDIF
		PRINTFORMW 당신은 \@ MONEY > 30000 ? %金額表示(30000)% # 당신의 모든 돈 \@을(를) 보내기로 결정한다.
		MONEY = MAX(MONEY - 30000,0)
	ELSE
		CALL KOJO_MESSAGE_SEND("CHILD", 0, TARGET, ARG:1, 0, "DAILY_共通手紙", "仕送り")
		IF RESULT == 2
			PRINTFORMW 당신과 %CALLNAME:ARG%가 준 어린 시절에 대한 감사를 %金額表示(10000)%와 함께 표현한다.
		ENDIF
		MONEY += 10000
	ENDIF
ENDIF
TARGET = TARGET:1
RETURN 1
