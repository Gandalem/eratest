; Modular ERB: デイリーイベント/DAIRY_EV27 半額セール.ERB

@DAILY_CONDITION_EV27
IF !FLAG:土産屋大安売り && !RAND:30
	CALL DAILY_EV27
	RETURN 1
ELSE
	RETURN -1
ENDIF

@DAILY_EV27
;この後にフラグリセットが入るので目印として+1100しておく
FLAG:土産屋大安売り = RAND:11 + 1100
SIF FLAG:土産屋大安売り % 100 == MAIN_MAP
	RESTART
IF FLAG:新聞購読
	PRINTFORML 분분마루에 따르면 %STR_TR(5000 + (FLAG:土産屋大安売り % 100) )% 근처 기념품 가게들이 굉장한 할인으로 판매를 시작했다고 한다.
	PRINTFORMW 모든 물건이 반값인 것 같다.
ENDIF
RETURN 1
