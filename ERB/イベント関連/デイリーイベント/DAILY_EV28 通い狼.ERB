SIF TALENT:[[影狼]]:育児中 || TALENT:[[影狼]]:妊娠
	RETURN -1
SIF MARK:[[影狼]]:反発刻印
	RETURN -1
;誰かと同居中だと駄目
SIF PRIVATEROOM:(CFLAG:MASTER:初期位置 % 100)
	RETURN -1
;一時滞在キャラがいると駄目
SIF FLAG:一時滞在
	RETURN -1
IF !GETBIT(FLAG_DAILY_EV28, 0)
	;初回は必ず発生
ELSE
	;this seemed like a really long interval between visits, only a 1/25 chance per day. So I shortened it a bit
	;LOCAL = 25 - CFLAG:[[影狼]]:1004
	LOCAL = 15 - CFLAG:[[影狼]]:1004
	SIF GETBIT(FLAG_DAILY_EV28, 1)
		LOCAL -= 2
	LOCAL = MAX(LOCAL, 5)
	SIF RAND:LOCAL > 0
		RETURN -1
ENDIF
;DAILY_EV28_発生回数 ++
CALL DAILY_EV28
RETURN 1

