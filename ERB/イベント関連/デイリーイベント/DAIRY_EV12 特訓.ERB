; Modular ERB: デイリーイベント/DAIRY_EV12 特訓.ERB

@DAILY_CONDITION_EV12
VARSET LOCAL
IF RAND:15 > 0
	RETURN -1
ELSE
	CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)
	FOR LOCAL:10, 0, CHARANUM - 1
	LOCAL = SHAFFLE_ARRAY:(LOCAL:10) + 1
	IF CFLAG:LOCAL:信頼度 >= 100 && CFLAG:LOCAL:神社在住
		LOCAL:1 = LOCAL
		BREAK
	ENDIF
	NEXT
	IF !LOCAL:1
		RETURN -1
	ELSE
		CALL DAILY_EV12(LOCAL:1)
		RETURN 1
	ENDIF
ENDIF

@DAILY_EV12(ARG)
#DIM 正解
#DIM 経験値
#DIM 制限時間
#DIM 倍率
#DIM FEINT
#DIM イカサマ
VARSET LOCAL
イカサマ = 0
制限時間 = 2000 - (ABL:ARG:戦闘能力 - ABL:MASTER:戦闘能力) * 100
CALL PRINT_FACE, ARG, "笑顔", "服", "", "" ;qol custom code
CALL KOJO_MESSAGE_SEND("DAILY", 12, ARG, 1)
CALL ASK_YN("수락","거절한다")
IF RESULT
	CALL KOJO_MESSAGE_SEND("DAILY", 12, ARG, 2)
ELSE
	正解 = RAND:4
	経験値 = MAX(RANK_TO_LEVEL(ABL:ARG:戦闘能力) * 5, UniversalRank("S"))
	SELECTCASE 0
		CASE IS <= 11
			;普通に
			LOCALS:0 = ↑
			LOCALS:1 = →
			LOCALS:2 = ←
			LOCALS:3 = ↓
			倍率 = 100
	ENDSELECT
	;戦闘能力が高いとフェイントかけてくる
	IF ABL:ARG:戦闘能力 > UniversalRank("B") && !RAND:3
		FEINT = 1
		制限時間 += 400
		倍率 += 80
	ELSE
		FEINT = 0
	ENDIF
	CALL FISHER_YATES_SHAFFLE(4)
	PRINTFORMW %CALLNAME:ARG%의 공격을 피하고 반대 방향으로 회피해라 (클릭하여 시작)
	CALL KOJO_MESSAGE_SEND("DAILY", 12, ARG, 3)
	PRINTFORM %CALLNAME:ARG%은 공격한다 ~에서 
	SETCOLOR C_YELLOW
	IF FEINT
		PRINTFORM %LOCALS:(RAND:4)%
		RESETCOLOR
		PRINTFORM  하지만 실제로는 %LOCALS:(3 - 正解)%에서 온 것이다.
	ELSE
		PRINTFORM %LOCALS:(3 - 正解)%
		RESETCOLOR
	ENDIF
	PRINTFORML !
	$LOOP_IKASAMA
	FOR LOCAL:10,0,4
	LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
	PRINTFORML [{LOCAL}] - 회피한다 %LOCALS:LOCAL%
	NEXT
	SIF !イカサマ && BASE:MASTER:TSP > 500
		PRINTFORML [{4}] - 시간 정지
	TINPUT 制限時間, -1, 1
	IF RESULT == 正解
		PRINTFORML 당신은 공격을 흘려보냈다!
		IF !イカサマ
			PRINTFORMW 그것은 두 분 모두에게 가치 있는 것이었다.
		ELSE
			PRINTFORMW 부정행위란 그것이 정말 좋은 연습은 아니었다는 것을 의미한다...
		ENDIF
		CALL KOJO_MESSAGE_SEND("DAILY", 12, ARG, 4, イカサマ)
		経験値 = 経験値 * 倍率 / 100
		;custom code
		CALL AddEXP("戦闘経験", MASTER, 経験値)
		CALL AddEXP("戦闘経験", ARG, 経験値 * 2)
		CALL CHANGE_CFLAG(2,ARG,経験値 * 2)
		CALL CHANGE_CFLAG(4,ARG,経験値 * 2)
	ELSEIF RESULT == 4 && !イカサマ && BASE:MASTER:TSP > 500
		イカサマ = 1
		倍率 /= 5
		PRINTFORMW 너는 시간 정지를 사용하여 공격을 간파한다!
		GOTO LOOP_IKASAMA
	ELSE
		PRINTFORML 놓쳤어!
		LOCALS:4 = 
		SELECTCASE RANK_TO_LEVEL(ABL:ARG:戦闘能力)
			CASE IS <= 1
				LOCALS:4 = 약간
			CASE 2,3
				LOCALS:4 = 약간
			CASEELSE
				LOCALS:4 = 터무니 없을 정도의 양
		ENDSELECT
		PRINTFORMW 당신은 %LOCALS:4%의 고통을 경험한다.
		CALL KOJO_MESSAGE_SEND("DAILY", 12, ARG, 5)
		;custom code
		CALL RECOVER(MASTER, -(400 * (1 + RANK_TO_LEVEL(ABL:ARG:戦闘能力))), "体力")
		CALL AddEXP("戦闘経験", ARG, 経験値)
		CALL CHANGE_CFLAG(2,ARG,経験値 / 2)
		CALL CHANGE_CFLAG(4,ARG,経験値 / 2)
	ENDIF
ENDIF
PRINTW 

@DAILY_MESSAGE_12(ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARGS:1, ARGS:2)
SELECTCASE ARG:1
	CASE 1
		PRINTFORMDL %CALLNAME:ARG%은(는) 새로운 기교를 연습하는 데 도움을 요청한다.
		SIF ABL:ARG:戦闘能力 >= UniversalRank("A")
			PRINTFORMDL 우리가 이야기하고 있는 %HIM_HER(ARG)%이기에, 이걸 망치면 꽤 크게 다칠 것이다...
	CASE 2
		PRINTFORMDL %CALLNAME:ARG%은(는) 실망한 듯 보인다...
ENDSELECT
CALL SET_KOJO_COLOR()
