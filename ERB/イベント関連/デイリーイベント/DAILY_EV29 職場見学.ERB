	CALL SPTALK, [[影狼]], "通常", 0, @"「%TEXTR("Hey Banki, we're hereー/I really like that hairstyle!/Hey, isn't Waggy's style really cute today?")%」", 1
	WAIT
ENDIF

IF FLAG_DAILY_EV29_DEBT > 0
	CALL SPTALK, [[蛮奇]], "通常", 0, @"「I hope you dummies actually brought some money today.」", 1
	WAIT
ELSEIF !RAND:10
	CALL SPTALK, [[蛮奇]], "通常", 0, @"「Geeze, you guys are coming after me like a Banki-seeking missile.」\「I even changed shifts...!」", 1
	WAIT
