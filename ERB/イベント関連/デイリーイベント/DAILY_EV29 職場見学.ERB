CALL SPTALK, [[蛮奇]], "通常", 0, @"「...Sigh」/「Whatever. Follow me.」/「I'll just seat you somewhere as far away from the other customers as possible.」", 1
WAIT
PRINTFORMDW Sekibanki leads you to a small booth tucked away in a corner of the restaurant.

CALL SPTALK, [[蛮奇]], "通常", 0, @"「So, what's your order?」", 1
WAIT
C_ID = 0
TOUCH = 0
$ORDER
;this whole event was in dire need of some fleshing out. A lot of design and coding went into it, but it had barely any actual dialogue
;so I took it upon myself to write some real scenes to go in this section
;I wanted to write two scenes each for banki, kagerou, and waggy, but only ended up with one waggy scene before running out of ideas
CALL ASK_M("The waitress's recommendation",1,"The same as Kagerou",1,"The same as Waggy",1,"I'll have a stewed rice porridge",1, "The Kagerou skinship special", TOUCH >= 0)
;CALL ASK_M("本日のおすすめ",1,"影狼と同じやつ",1,"わかさぎ姫と同じやつ",1,"この煮込み雑炊一つください",1, "パーッといく(%金額表示(30000)%)",MONEY >= 30000)
SELECTCASE RESULT
	CASE 0
		C_ID = [[蛮奇]]
		CALL SPTALK, [[蛮奇]], "通常", 0, @"「Huh.」/「It's your funeral, pal.」", 1
		WAIT
		SELECTCASE RAND:2
			CASE 0
				CALL SPTALK, [[蛮奇]], "通常", 0, @"「My recommendation is...」/「The deluxe, super-size-all-you-can-eat Natto special.」", 1
				WAIT
				CALL SPTALK, [[蛮奇]], "通常", 0, @"「...Our stock's about to go bad, so bossman wants it out the door ASAP.」", 1
				WAIT
				CALL SPTALK, [[蛮奇]], "笑顔", 0, @"「So, whaddaya say, chump?」", 1
				WAIT
				PRINTFORMDW You just give her a thumbs up in response.
