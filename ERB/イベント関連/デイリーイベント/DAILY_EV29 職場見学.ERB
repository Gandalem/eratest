@DAILY_EV29_0
CALL PRINT_IMAGE("別立ち_服_フード_笑顔_63")
PRINTFORMW 「Oh, you cameー」
CALL PRINT_FACE, [[わかさぎ姫]], "通常", "服", "", ""
PRINTFORMW 「It's nice to see you!」
;CALL PRINT_FACE, [[影狼]], "通常", "服", "", ""
PRINTFORML 「How do I look? My outfit's pretty human-esque, isn't it?」
CALL ASK_YN("Compared to the usual, at least","Hopefully we won't be found out")
CALL PRINT_IMAGE("別顔_服_フード_笑顔２_63")
PRINTFORMW 「I know, rightー? Well then, we're off to Banki's place!」
PRINTFORMDW .........
PRINTFORMDW ......
PRINTFORMDW ...
CALL PRINT_FACE, [[わかさぎ姫]], "通常", "服", "", ""
PRINTFORMW 「Oh, this is a really nice restaurant!」
CALL PRINT_IMAGE("別顔_服_フード_笑顔_63")
PRINTFORMW 「Hi, Banki-chan! A waitress's uniform really suits you, doesn't it?」
CALL PRINT_FACE, [[蛮奇]], "通常", "服", "", ""
PRINTFORMW 「Gehh...! Why the heck are you lot here...」
PRINTFORML 「%CALLNAME:MASTER%, is this your doing?」
PRINTFORML 「Why did you have to being those guys along too?」
IF TALENT:[[影狼]]:恋慕
	CALL ASK_M("We just wanted to see you, Sekibanki",1,"I can't turn down Kagerou's request",1,"I'll have a stewed rice porridge, please",1)
ELSE
	CALL ASK_M("We just wanted to see you, Sekibanki",1,"Kagerou asked me to",1,"I'll have a stewed rice porridge, please",1)
ENDIF
SELECTCASE RESULT
	CASE 0
		CALL SPTALK, [[蛮奇]], "通常", 0, @"「That doesn't explain why you all came here together.」", 1
		WAIT
		CALL SPTALK, [[蛮奇]], "通常", 0, @"「...Fine, whatever.」/「You'll just need to order something and eat it fast, so you can get out of here before someone notices.」", 1
		WAIT
		CALL CHANGE_CFLAG(2,[[蛮奇]],50)
		CALL CHANGE_CFLAG(4,[[蛮奇]],10)
	CASE 1
		IF TALENT:[[影狼]]:恋慕
			CALL PRINT_IMAGE("別顔_服_フード_発情２_63")
			PRINTFORML 「Sheesh, how can you say that kind of thing so easily, I swear...」
			CALL CHANGE_CFLAG(2,[[影狼]],100)
			CALL SPTALK, [[蛮奇]], "通常", 0, @"「Will you two please quit it with the annoying sappy crap?」", 1
			WAIT
		ELSE
			CALL SPTALK, [[蛮奇]], "怒り", 0, @"「Seriously?」/「Think about the circumstances here for a second.」", 1
			WAIT
			CALL SPTALK, [[蛮奇]], "通常", 0, @"「...Fine, whatever.」/「Just order something and eat it fast, so you can get out of here before someone notices.」", 1
			WAIT
		ENDIF
	CASE 2
		CALL SPTALK, [[蛮奇]], "通常", 0, @"「Sorry, we're out.」", 1
		WAIT
		PRINTFORMDW ...
		CALL SPTALK, [[蛮奇]], "通常", 0, @"「What? Don't give me that look like the world's gonna end.」/「You can't order when you're not even at a table yet, dummy.」", 1
		WAIT
		DAILY_EV29_NIKOMI ++
ENDSELECT

;inspiration struck, proper first-time event finally written!
PRINTFORMDW After a moment of hesitation, Sekibanki leads the three of you into the establishment.
PRINTFORMDL It's moderately busy, with about half of the tables occupied.
PRINTFORMDW %BREAKENG(@"There's a pleasant, but not overwhelming, amount of background noise, as dishes faintly clatter in the kitchen and customers converse with each other over their meals.")%
PRINTFORMDL For you this is a pretty banal sight. But Kagerou and Wakasagihime are both entranced.
PRINTFORMDW The two of them excitedly look every which way, trying to take in all the sights and smells...
CALL SPTALK, [[わかさぎ姫]], "笑顔", 0, @"「Oh my! There's so many people here already!」/「Humans must really like to dine in large groups, don't they?」", 1
WAIT
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Wow! Look at that dish!」/「Ohhhh... and that one!」/「Mmmmm, that one there smells delicious too!」", 1
WAIT
PRINTFORMDL Both of them are getting too distracted to properly follow behind Sekibanki... Kagerou in particular.
PRINTFORMDW She starts bending over to better inhale the scents of other patrons' meals as she passes, drawing a lot of shocked looks.
CALL SPTALK, [[蛮奇]], "怒り", 0, @"「Uhhh! Crap, I was worried this would turn out bad!」", 1
WAIT
PRINTFORMDL You and Sekibanki have to hurriedly intervene, forcefully herding the two along to forestall disaster.
PRINTFORMDW Sekibanki leads you all to a corner booth in the back of the restaurant, as far away from other customers as possible.
CALL SPTALK, [[蛮奇]], "通常", 0, @"「Okay... Catastrophe averted.」/「For now...」", 1
WAIT
CALL SPTALK, [[蛮奇]], "笑顔", 0, @"「Anyway! I'll be your waitress today.」", 1
WAIT
CALL SPTALK, [[蛮奇]], "通常", 0, @"「And I do mean that.」/「Seriously, don't try to call out to some other server. It'll be bad if we get found out.」", 1
WAIT
PRINTFORMDW Kagerou and Wakasagihime both nod earnestly.
CALL SPTALK, [[蛮奇]], "笑顔", 0, @"「Okay then! Since we're clear on that, here are some menus for you guys.」/「When you decide, let me know what you'd like to order.」", 1
WAIT
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Oh wow!」/「Look, there's pictures!」/「Something seems a little off about them, though...」", 1
WAIT
PRINTFORMDW You reach over and turn her menu right-side up.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Ooooh! It makes more sense now!」/「I see, so there's the names of the dishes too.」/「Hmmm... There's a bunch of options!」", 1
WAIT
PRINTFORMDW You reach over and flip the page for her.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Wait, there's multiple pages!?」/「Amazing!! Just how many types of food can there be in one restaurant!?」", 1
WAIT
PRINTFORMDW You glance over at Wakasagihime. It seems like she's been able to figure out the menu without your help.
CALL SPTALK, [[わかさぎ姫]], "笑顔", 0, @"「There certainly are a lot of choices!」/「Quite a few dishes seem like they won't suit my palate.」/「But there are still more than enough that look very tasty!」", 1
WAIT
PRINTFORMDL As she reads through the menu, Kagerou's tail wags so hard that there's little her cloak can do to conceal it.
PRINTFORMDW Fortunately it's unlikely anybody will notice. Sekibanki was wise to seat you away from the other customers.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Hmmmmm...」/「There's so much that looks good!」/「I think I want this one, and this, and this one too!」", 1
WAIT
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Oh, this one here must be what that customer from before was eating.」/「Better get that one too! I want to try it for myself!」", 1
WAIT
PRINTFORMDW Sekibanki looks taken aback as Kagerou rattles off all the meals she wants, and even Wakasagihime raises an eyebrow.
CALL SPTALK, [[わかさぎ姫]], "通常", 0, @"「Ummm... Kagerou-chan?」/「Even if this is you we're talking about, isn't that a little too much?」", 1
WAIT
CALL SPTALK, [[蛮奇]], "怒り", 0, @"「Yeah. Kagerou, you can't order the whole menu.」/「You're supposed to pick ONE thing, c'mon!」", 1
WAIT
PRINTFORMDW Kagerou looks up at Sekibanki in shock, then her face falls.
CALL SPTALK, [[影狼]], "怒り", 0, @"「...Just one?」/「But... but... There's so many I want to taste...」/「How can I pick just one...」", 1
WAIT
PRINTFORMDW You reach over and give the crestfallen wolf a reassuring pat on the shoulder.
CALL SPTALK, [[わかさぎ姫]], "通常", 0, @"「There there, Kagerou-chan.」/「Just think about it this way! This means you can look forward to coming here again!」", 1
WAIT
PRINTFORMDW You echo Wakasagihime's words. She can always try the other dishes she wants in future visits.
CALL SPTALK, [[蛮奇]], "通常", 0, @"「They're right.」/「Don't try to do it all in one go, pace yourself a little.」", 1
WAIT
PRINTFORMDW A moment later, Sekibanki's brow furrows.
CALL SPTALK, [[蛮奇]], "怒り", 0, @"「Geh——hey!」/「That means you guys plan to keep coming back here to bother me while I'm working!」/「Sigh... This is my life now...」", 1
WAIT
CALL SPTALK, [[影狼]], "通常", 0, @"「Just one then, huh?」/「Just one...」/「Hrrrrmmmm...」", 1
WAIT
PRINTFORMDW Some of her earlier enthusiasm returning, Kagerou stares at the menu intensely, as if the fate of the world were at stake.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Okay... Okay! I've got it!」/「This one right here, the tonkotsu ramen!」/「And with extra chashu pork!!」", 1
WAIT
CALL SPTALK, [[蛮奇]], "通常", 0, @"「I got it, I got it.」/「There's no need to yell, geeze...」", 1
WAIT
PRINTFORMDW Waksagihime giggles at Kagerou's intensity.
CALL SPTALK, [[わかさぎ姫]], "笑顔", 0, @"「For me, I'll get the eggplant agebitashi.」/「The picture makes it look wonderful!」", 1
WAIT
CALL SPTALK, [[蛮奇]], "通常", 0, @"「Alright, glad to see one of you wasn't born in a barn.」/「And you, %CALLNAME:MASTER%?」", 1
WAIT
PRINTFORMDW You just order a fairly ordinary sandwich.
CALL SPTALK, [[蛮奇]], "通常", 0, @"「Fine, fine. Got it down.」/「Okay, I'll go put your orders in with the kitchen.」/「Don't start a riot or anything while I'm gone!」", 1
WAIT
PRINTFORMDW Sekibanki leaves to put in your order and serve other tables, and the three of you make small talk in the meantime.
PRINTFORMDW ...Kagerou squirms impatiently the whole time, constantly licking her chops.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「I just can't wait!」/「I wonder what it'll taste like...」", 1
WAIT
PRINTFORMDW Surprisingly, it isn't long before Sekibanki returns, carrying your meals expertly balanced on a tray.
CALL SPTALK, [[蛮奇]], "通常", 0, @"「I told the chef to rush with these.」/「...As it might be dangerous to keep these customers waiting.」/「Anyway, here you go. Hope you like it.」", 1
WAIT
PRINTFORMDL She puts down a plate with your sandwich, and a dish with Wakasagihime's eggplant agebitashi.
PRINTFORMDL In front of Kagerou she plunks down a big, steaming bowl full of noodles in broth, carpeted atop with roast pork.
PRINTFORMDW It even comes with a chunk of pork femur as a sort of garnish, as if to prove that it really is a high-grade bone broth soup.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Ooh, they even included the bone!」/「So thoughtful!」", 1
WAIT
PRINTFORMDW Wakasagihime looks pleased with her meal as well.
CALL SPTALK, [[わかさぎ姫]], "笑顔", 0, @"「Thank you Sekibanki-chan, for the delicious food!」", 1
WAIT
CALL SPTALK, [[蛮奇]], "通常", 0, @"「Uhh... You're welcome...」", 1
WAIT
PRINTFORMDW You start in on your meals, and Sekibanki continues to hover close by, subtly shooing away anybody who tries to sit at the adjacent tables.
PRINTFORMDW Waksagihime takes delicate nibbles at her eggplant dish, people-watching and taking in the homely atmosphere of the restaurant.
PRINTFORMDW In contrast, Kagerou is one hundred percent focused on the food in front of her. She probably wouldn't notice if the place caught fire...
PRINTFORMDL You and Waksagihime make small talk as you eat your meals at a leisurely pace.
PRINTFORMDW Kagerou only occasionally joins in, as obsessed as she is with tearing into her food.
PRINTFORMDW .........
PRINTFORMDW ......
PRINTFORMDW ...
PRINTFORMDL A little while later, Kagerou is down to nothing but broth and the bone left in her bowl.
PRINTFORMDW You and Wakasagihime are also close to finishing up, if only because your meals were much smaller than hers.
PRINTFORMDW Grabbing the bowl in both hands, the wolfwoman raises it to her lips and gulps down the remaining broth.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Paaaahh～」/「Delicious♪」", 1
WAIT
CALL SPTALK, [[影狼]], "笑顔", 0, @"「And now, for the dessert!」/「Saving the bone for last is best, you know. It helps clean any bits of stuck food from your teeth!」", 1
WAIT
PRINTFORMDL Kagerou takes the chunk of leg bone from the now-empty bowl and starts chewing on it noisily.
PRINTFORMDW She gets really into it, cramming it inside her cheeks to get it back where her molars can properly bite into it.
PRINTFORMDL The crunching, grinding, snapping noises produced as she tears into the bone practically make you sick to your stomach.
PRINTFORMDW It's horrifying to watch a cute girl do something so vulgar!
PRINTFORMDW ...And she's starting to attract nervous glances from other patrons in the restaurant...
PRINTFORMDL You hurriedly tap Kagerou on the shoulder to get her attention. She's so engrossed in her bone that it takes several attempts...
PRINTFORMDW But eventually she emerges from her reverie, and as her eyes re-focus she realizes where she is.
CALL SPTALK, [[影狼]], "通常", 0, @"「...Ah.」", 1
WAIT
PRINTFORMDL Kagerou glances back and forth. At the horrified expression on your face, at Wakasagihime who's looking positively queasy...
PRINTFORMDW Even Sekibanki looks on-edge.
CALL SPTALK, [[蛮奇]], "怒り", 0, @"「I know you live in the woods, but your table manners really need some work.」/「This is a public venue, for cryin' out loud...」", 1
WAIT
PRINTFORMDW Kagerou sheepishly takes the bone out of her mouth and plunks it back in the bowl.
CALL SPTALK, [[影狼]], "通常", 0, @"「Sorry!」/「I, uhm, got a little carried away...」", 1
WAIT
CALL SPTALK, [[影狼]], "発情", 0, @"「But... It's just so tasty!」/「I... Mmmnm...」/「I don't want such a tasty bone to go to waste...」", 1
WAIT
PRINTFORMDW Perhaps this is another opportunity to educate Kagerou about how restaurants work.
PRINTFORMDW You gesture to Sekibanki, and ask her to bring a to-go box.
CALL SPTALK, [[蛮奇]], "通常", 0, @"「Oh, right. That's a good idea.」/「I'll bring one right over.」", 1
WAIT
CALL SPTALK, [[影狼]], "通常", 0, @"「Huh? Twogo box?」/「What's that?」", 1
WAIT
PRINTFORMDL Sekibanki returns a moment later with a sheet of pre-cut waxed paper, and starts folding it up into the to-go container.
PRINTFORMDW While she's doing that, you explain to Kagerou that this is how customers can take any leftover food home with them when they leave.
CALL SPTALK, [[影狼]], "笑顔", 0, @"「Oooh, I see I see!」/「So they call it a to-go box because you can take it when you go!」/「That's such a convenient invention!」", 1
WAIT
CALL SPTALK, [[影狼]], "通常", 0, @"「But...」/「For this to be a normal thing, is it really so common for humans not to finish their meals?」/「I don't really understand that...」", 1
WAIT
PRINTFORMDW Kagerou ponders this question for the ages as she carefully seals her bone into the to-go container.
CALL SPTALK, [[蛮奇]], "通常", 0, @"「Alright then.」/「It looks like you lot are about done, so it's time for the final step in the process.」/「I'll be back in a bit with the check.」", 1
WAIT
PRINTFORMDW Kagerou and Wakasagihime don't seem to understand what she means...
PRINTFORMDW .........
PRINTFORMDW ......
PRINTFORMDW ...
CALL BUFF_BASE(MASTER,BASE_体力,150,1)
CALL BUFF_BASE(MASTER,BASE_気力,150,1)
CALL BUFF_BASE([[影狼]],BASE_体力,150,1)
CALL BUFF_BASE([[影狼]],BASE_気力,150,1)
CALL BUFF_BASE([[わかさぎ姫]],BASE_体力,150,1)
CALL BUFF_BASE([[わかさぎ姫]],BASE_気力,150,1)
CALL PRINT_FACE, [[わかさぎ姫]], "通常", "服", "", ""
PRINTFORMW 「Mmm, it was delicious!」
PRINTFORMW 「Oh, wait... That's right, you have to pay with money at these places...」
CALL PRINT_FACE, [[わかさぎ姫]], "笑顔", "服", "", ""
PRINTFORMW 「And I, umm... I forgot to bring any!」
CALL PRINT_IMAGE("別顔_服_フード_笑顔２_63")
PRINTFORMW 「Me too!」
CALL IMAGE_SET(@"別顔_服_フード_通常_{[[影狼]]}", 0, 0, 100, 0, 0, "")
CALL IMAGE_SET(@"顔絵_服_通常_{[[わかさぎ姫]]}", 0, 0, 100, 0, 0, "", "デフォルト顔絵")
CALL SIMULTANEOUS_IMAGE_DISPLAY("左", 0, 1)
PRINTFORMDW They simultaneously turn to stare you...
CALL COLORMESSAGE(@"Cash on hand:%金額表示(MONEY)%",C_YELLOW,1)
CALL ASK_M(@"Pay the bill（%金額表示(10000)%）", MONEY >= 10000, "Turn to Banki",1)
SELECTCASE RESULT
	CASE 0
		MONEY -= 10000
	CASE 1
		CALL SPTALK, [[蛮奇]], "通常", 0, @"「What the heck are you looking at me for?」", 1
		WAIT
		IF MONEY >= 10000
			CALL SPTALK, [[蛮奇]], "怒り", 0, @"「I know you've got enough! Pay up!」", 1
			WAIT
			MONEY -= 10000
		ELSE
			CALL EV29_無銭飲食
		ENDIF
ENDSELECT

IF !FLAG_DAILY_EV29_DEBT
	CALL PRINT_FACE, [[わかさぎ姫]], "笑顔", "服", "", ""
	PRINTFORMW 「Thank youー!」
	CALL PRINT_FACE, [[影狼]], "笑顔", "服", "", ""
	PRINTFORMW 「I'll make it up to you next time!」
	CALL PRINT_FACE, [[蛮奇]], "通常", "服", "", ""
	PRINTFORMW 「Please don't come here again...」
	;通い狼に影響
	CFLAG:[[影狼]]:1004 += 3
	CFLAG:[[影狼]]:1006 ++
	FLAG_DAILY_EV29_PAID ++
	CALL CHANGE_CFLAG(2,[[影狼]],100)
	CALL CHANGE_CFLAG(4,[[影狼]],50)
	CALL CHANGE_CFLAG(2,[[わかさぎ姫]],100)
	CALL CHANGE_CFLAG(4,[[わかさぎ姫]],50)
	CALL CHANGE_CFLAG(2,[[蛮奇]],100)
	CALL CHANGE_CFLAG(4,[[蛮奇]],50)
ELSE
	CALL CHANGE_CFLAG(2,[[影狼]],50)
	CALL CHANGE_CFLAG(2,[[わかさぎ姫]],50)
ENDIF
