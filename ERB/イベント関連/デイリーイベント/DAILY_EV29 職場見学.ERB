				IF TALENT:[[影狼]]:思慕
					PRINTFORMDW 그녀는 유머로 넘기려 하지만, 당신은 카게로우의 표정에서 한 줄기의 아련함을 감지할 수 있다고 생각한다.
				ELSE
					PRINTFORMDW 카게로우가 상냥하게 당신의 갈비를 쿡 찌르고 세 사람은 함께 웃는다.
				ENDIF
			ELSE
				;shouldn't happen
			ENDIF
			PRINTFORMDW 그때, 세키반키가 두 개의 여분의 스푼을 들고 나타났다.
			CALL SPTALK, [[蛮奇]], "通常", 0, @"「이봐, 너희들은 필요할 거야...」/「크윽.」/「결국 쓸데없는 데 애썼나 봐.」", 1
			WAIT
			IF TALENT:[[影狼]]:恋慕 || TALENT:[[わかさぎ姫]]:恋慕
				CALL SPTALK, [[蛮奇]], "怒り", 0, @"「쯧.」/「너희 같은 커플들 보면 속이 안 좋아져.」", 1
				WAIT
				IF TALENT:[[蛮奇]]:恋慕
					CALL SPTALK, [[蛮奇]], "発情", 0, @"「...하지만 이게 내가 너희들이 나를 앞서 나가도록 허락한다는 뜻이라고 생각하지 마라...」", 1
					WAIT
				ENDIF
			ENDIF
		ELSE
			PRINTFORMDW 당신은 걸쭉한 죽을 한 숟가락 입으로 불어 식힌 후 한입 먹는다...
			PRINTFORMDW 솔직히 말해서... 정말 맛이 없다.
			PRINTFORMDW 뭐, 인생에는 더 나쁜 것들도 있겠지, 아마도...
		ENDIF
	CASE 4
		SELECTCASE TOUCH
			CASE 0
				PRINTFORMDL 테이블 밑에서, 당신은 카게로우의 손 위에 당신의 손을 올려놓는다.
				IF !TALENT:[[影狼]]:恋慕 || RAND:400 > CFLAG:[[影狼]]:溜まってる度
					PRINTFORMDW 카게로우는 잠시 %TEXTR("you a confused look for a moment/pretends not to react")%...
				ELSE
					PRINTFORMDW 카게로우는 %TEXTR("수줍게 당신을 바라보거나/다른 손으로 당신의 손 위에 올려놓고 꽉 잡아준다")%...
					CFLAG:[[影狼]]:溜まってる度 += 100
				ENDIF
				CALL SPTALK, [[蛮奇]], "通常", 0, @"「아직 결정할 시간이 좀 더 필요한 것 같아, 응?」", 1
				WAIT
				TOUCH = 1
			CASE 1
				PRINTFORMDL 당신은 은밀하게 카게로우의 무릎에 손을 가져간다...
				IF !TALENT:[[影狼]]:恋慕
					PRINTFORMDW 갑자기 발톱이 당신의 손등을 파고든다...
					TOUCH = -1
				ELSEIF RAND:600 > CFLAG:[[影狼]]:溜まってる度
					PRINTFORMDW 그녀는 당신의 손을 뿌리친다...
					TOUCH = -1
				ELSE
					CALL PRINT_FACE, [[影狼]], "通常", "服", "照れ"
					PRINTFORMDW 카게로우도 화답하며 당신의 무릎에 손을 올린다…
					CFLAG:[[影狼]]:溜まってる度 += 100
					CALL SPTALK, [[蛮奇]], "通常", 0, @"「Oi...」", 1
					WAIT
					TOUCH = 2
				ENDIF
			CASE 2
				PRINTFORMDW 당신은 카게로우의 안쪽 허벅지를 부드럽게 쓰다듬는다...
				CALL PRINT_FACE, [[影狼]], "発情", "服", "", ""
				PRINTFORMDW 카게로우가 호의를 갚는다...
				CALL SPTALK, [[蛮奇]], "怒り", 0, @"「제발 좀 해봐!」", 1
				WAIT
				TOUCH = -1
		ENDSELECT
		GOTO ORDER
ENDSELECT
