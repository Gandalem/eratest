; Modular ERB: デイリーイベント/DAIRY_EV21 Mercy_of _God.ERB

@DAILY_CONDITION_EV21
#DIM YOME
SIF !FLAG:子宝祈願
	RETURN -1
SIF FLAG:獲得パンツ種数 < 100
	RETURN -1
YOME = FLAG:子宝祈願
SIF RAND:30 > 0
	RETURN -1
SIF TALENT:YOME:妊娠
	RETURN -1
SIF !CHECK_CHARA(YOME, "幽霊") && !CHECK_CHARA(YOME, "人形") && !CHECK_CHARA(YOME, "蓬莱人") && !CHECK_CHARA(YOME, "神霊")
	RETURN -1
SIF CFLAG:YOME:子供人数 > 0
	RETURN -1
CALL DAILY_EV21(YOME)
RETURN 1

@DAILY_EV21(YOME)
#DIM YOME
PRINTFORMW %PantsuSama()%는 임신을 위해 고군분투하는 %CALLNAME:YOME%가 안쓰럽다...
CALL BUFF_BASE(MASTER,BASE_体力,1000)
CALL BUFF_BASE(MASTER,BASE_気力,1000)
CALL COLORMESSAGE(@"%CALLNAME:YOME%의 STA와 ENE가 일시적으로 많이 증가했다.",C_YELLOW,1,1)
CALL BUFF_BASE(MASTER,BASE_精力,500)
CALL COLORMESSAGE(@"당신의 활력(VIG)이 일시적으로 증가했습니다.",C_YELLOW,1,1)
IF !TALENT:MASTER:濃厚精液
	TALENT:MASTER:濃厚精液 = 1
	CLEARBIT TFLAG:一日一回,8
	CALL COLORMESSAGE(@"당신은 이제 【농후정액】을 가지고 있다.",C_YELLOW,1,1)
	BASE:MASTER:精力 = MAXBASE:MASTER:精力
ENDIF
PRINTW 
CFLAG:YOME:翌日来訪 = 1
CFLAG:YOME:子宝補正 ++
CALL Com_PregPrayer(YOME) ;com custom code
