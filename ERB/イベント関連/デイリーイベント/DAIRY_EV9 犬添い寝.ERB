; Modular ERB: デイリーイベント/DAIRY_EV9 犬添い寝.ERB

@DAILY_CONDITION_EV9
IF !RAND:20 && MAIN_MAP == 9
	CALL DAILY_EV9
	RETURN 1
ELSE
	RETURN -1
ENDIF

@DAILY_EV9
PRINTFORML 사토리의 개가 당신의 침대로 기어들어 왔다.
SELECTCASE DAY:2
	CASE 2
		PRINTFORML 잠 못 이루는 밤이다...
		CFLAG:MASTER:徹夜 = 1
	CASE 4
		PRINTFORML 따뜻하다...
		CALL RECOVER(MASTER,300,"体力")
		CALL RECOVER(MASTER,500,"気力")
	CASEELSE
		CALL RECOVER(MASTER,100,"体力")
		CALL RECOVER(MASTER,200,"気力")
ENDSELECT
PRINTW 
RETURN 1
