@DAILY_EV5
#DIM おっぱい神
QOL_ACCUMULATED_OPPAI = 0 ;qol custom code
;CASE 9は未完成だから
おっぱい神 = RAND:9
PRINTFORMW 잠이 들려고 할 때, 기적 같은 목소리를 듣는다.
PRINTFORML 
SETCOLOR C_AQUA
FONTBOLD
;微妙に変化させる
SELECTCASE おっぱい神
	CASE 0 TO 4
		PRINTFORMW ...나 들리니... ...나 들리니... %CALLNAME:MASTER%... %CALLNAME:MASTER%... 
		PRINTFORMW ...이제... 나는 직접... 당신의... 심장에 말한다... 나 들리니......
	CASE 5,6
		PRINTFORML ...들리니... ...들리니... %CALLNAME:MASTER%... %CALLNAME:MASTER%...
		PRINTFORMW ...이제... 나는 직접... 당신의... 심장에... 들리니...?
	CASE 7,8
		PRINTFORML ...나 들리니...... 나 들리니... %CALLNAME:MASTER%... %CALLNAME:MASTER%...
		PRINTFORMW ...이제... 나는 직접... 당신의... 심장에 말해... 들리니......?
	CASE 9
		PRINTFORML ...나 들려...? ...나 들려...? %CALLNAME:MASTER%... %CALLNAME:MASTER%...
		PRINTFORMW ...이제...... 나는 직접... 당신의... 심장에 말을 걸고 있어... 나 들려...?
ENDSELECT
PRINTFORML 
PRINTFORMW 큰 가슴 아니면 작은 가슴, 어느 쪽을 선호하느냐......
RESETCOLOR
FONTREGULAR
;CALL COLORMESSAGE("あなたは大きいおっぱいと小さいおっぱい、どちらが好きですか……","AQUA",1,1)
;qol custom code
LOCAL = CFLAG:MASTER:累計膣内精液 + CFLAG:MASTER:累計アナル精液 + CFLAG:MASTER:累計精飲
CALL ASK_M("큰 것들",1,"작은 것들",1,"가슴에는 순위가 없다",1,@"나는 후타나리 성기가 좋아 \@ LOCAL < 5000 ? %" "%너의 몸은 더 많은 정액을 받아들여야 한다, 내 아이... {LOCAL}/5000 #  \@",LOCAL >= 5000, "나에게 존재하는 신은 단 하나뿐이야... 그리고 그건 네가 아니야!", 1) ;qol custom code, option to ignore the question
IF RESULT == 4 ;qol custom code
	PRINTFORML 그렇게 무례한 응답은 그들을 흥분하게 만들고, 그들은 처벌을 내릴 준비를 하며 후 하고 불었다...
	PRINTFORMW 하지만 당신이 %PantsuSama()%'의 이름을 부르자, 그들은 황급히 물러난다. 괜찮았나...?
	RETURN 1
ENDIF
SELECTCASE おっぱい神
	CASE 0 TO 4
		IF RESULT == 3 && !おっぱい神
			CALL GOD_FUTANARI
		ELSE
			SETCOLOR C_AQUA
			FONTBOLD
			SIF RESULT == 3
				PRINTFORMW (잘못된 답변)
			PRINTFORMW 이 설문에 협조해 주셔서 감사합니다...... 보상이 여기 있습니다......
			RESETCOLOR
			FONTREGULAR
			PRINTFORML 키바안!
			PRINTFORMW %金額表示(1000)%이 당신의 계좌로 이체되었습니다!
			MONEY += 1000
		ENDIF
	CASE 5,6
		;巨乳の神
		SELECTCASE RESULT
			CASE 0
				CALL OPPAIANSWER(1,1)
			CASE 1
				CALL OPPAIANSWER(1,-1)
			CASE 2
				CALL OPPAIANSWER(1,0)
			CASE 3
				CALL OPPAIANSWER(1,2)
		ENDSELECT
	CASE 7,8
		;貧乳の神
		SELECTCASE RESULT
			CASE 0
				CALL OPPAIANSWER(-1,-1)
			CASE 1
				CALL OPPAIANSWER(-1,1)
			CASE 2
				CALL OPPAIANSWER(-1,0)
			CASE 3
				CALL OPPAIANSWER(-1,2)
		ENDSELECT
	CASE 9
		SELECTCASE RESULT
			CASE 0,1
				CALL OPPAIANSWER(2,-1)
			CASE 2
				CALL OPPAIANSWER(2,2)
		ENDSELECT
ENDSELECT
PRINTFORMW 
RETURN 1

@GOD_FUTANARI
CALL COLORMESSAGE("호호~ 내 본모습을 눈치챘군.",C_D_RED,2,1)
PRINTFORML 
PRINTFORMW 목소리가 평소보다 조금 더 강해진다...
CALL COLORMESSAGE("당신은 후타나리 페니스에 대한 큰 연모를 품고 있다.",C_D_RED,1,1)
CALL COLORMESSAGE("보상으로 소원을 하나 들어주겠다.",C_D_RED,1,1)
$LOOP
CALL ASK_M("필요 없다",1,"누군가에게 페니스를 주다",1,"누군가의 남성기를 단련시킨다",1,"후타나리 성기를 맛봐라",1,"팬티를 주세요",1)
SELECTCASE RESULT
	CASE 0
		CALL COLORMESSAGE("얼마나 지루한지... 이런 것을 어떻게 낭비할 수 있는지 이해가 가지 않는다.",C_D_RED,1,1)
		CALL COLORMESSAGE("뭐, 어쩔 수 없지...",C_D_RED,1,1)
	CASE 1
		PRINTFORML 누구?
		DRAWLINE
		FOR LOCAL,0,CHARANUM
		SIF TALENT:LOCAL:性別 == 1
			PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
		NEXT
		DRAWLINE
		PRINTFORML [999] 리턴
		INPUT
		IF INRANGE(RESULT,0,CHARANUM) && TALENT:RESULT:性別 == 1
			CALL COLORMESSAGE("그건 쉽네.",C_D_RED,1,1)
			PRINTFORMW %CALLNAME:RESULT%은 이제 후타나리이다.
			CALLF FUTAME(RESULT,RAND:6 + 1) ;Custom code, replaced and moved.
		ELSE
			GOTO LOOP
		ENDIF
	CASE 2
		PRINTFORML 누구의 것인가?
		DRAWLINE
		FOR LOCAL,1,CHARANUM
		SIF TALENT:LOCAL:性別 == 3 && MAXBASE:LOCAL:精力 < 1500
			PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
		NEXT
		PRINTL 
		DRAWLINE
		PRINTFORML [999] 반환
		INPUT
		IF INRANGE(RESULT,1,CHARANUM) && TALENT:RESULT:性別 == 3 && MAXBASE:RESULT:精力 < 1500
			PRINTFORMW %CALLNAME:RESULT%의 최대 정력이 증가한다.
			MAXBASE:RESULT:精力 += 100
			CALL COLORMESSAGE("간단한 임무다!",C_D_RED,1,1)
		ELSE
			GOTO LOOP
		ENDIF
	CASE 3
		CALL COLORMESSAGE("후후, 너에게 천상의 두둥이 거시기를 줄게.",C_D_RED,1,1)
		CALL COLORMESSAGE("네가 감당할 수 있다면 마음껏 맛보도록 해.",C_D_RED,1,1)
		PRINTFORML 갑자기 입안에 거대한 덩어리가 느껴진다.
		PRINTFORML 단단하지만 부드럽고 유연하며, 따뜻함으로 빛나고 마음을 평온하게 채운다.
		PRINTFORML 인간의 이해를 초월하는 기술로 그것을 섬기기 전까지 잠시 압도당한다.
		PRINTFORML 영원한 고통과 황홀 끝에 신성한 성기가 마침내 절정에 이른다.
		PRINTFORML 믿을 수 없을 정도로 풍부한 맛이 불가능한 양으로 목구멍을 타고 흘러내리고, 당신은 의식을 잃는다...
		CALL BUFF_BASE(MASTER,BASE_気力,2000)
		CALL BUFF_BASE(MASTER,BASE_体力,2000)
	CASE 4
		CALL COLORMESSAGE("나는 그런 것들을 가지고 있지 않다.",C_D_RED,2,1)
		GOTO LOOP
ENDSELECT
CALL COLORMESSAGE("잊지 마, 나는 모든 후타나리 거시기들의 구현이다.",C_D_RED,1,1)
PRINTFORML 신성한 현신이 떠난다...

@OPPAIANSWER(ARG,ARG:1)
IF ARG:1 == -1
	GOTO LackBelief
	;CALL COLORMESSAGE("滅びよ悪しき者！！！","RED",1,1)
	SETCOLOR C_RED
	FONTBOLD
	PRINTFORMW 너 같은 사악한 자여!!!
	RESETCOLOR
	FONTREGULAR
	PRINTFORML 심한 머리 부상을 입고, 당신은 의식을 잃는다...
	;BASE:MASTER:体力 -= 5000
	BASE:MASTER:体力 -= 1500
	;CALLF BroadDamage(MASTER,"head",5000,6,-1,"Smite")
ELSEIF ARG:1 == 2
	CALL COLORMESSAGE("에엣?! 방금 그게 뭐지...",C_AQUA,1,1)
	PRINTFORML 목소리가 침묵한다.
ELSEIF !ARG:1
	$LackBelief
	;これが正解の分岐を後で作る
	;PRINTFORML あなたは心底おっぱいを愛しているのですね……
	CALL COLORMESSAGE("네 고난이 많기를, 불신자여...",C_AQUA,1,1)
	PRINTFORML 목소리가 조용해진다.
ELSE
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORML 우리가 당신의 소원을 잊지 않았기에, \@ ARG < 0 ? 작은 # 큰 \@ 가슴은 항상 당신의 동맹이 될 것이다...
	PRINTFORML 당신에게는 \@ ARG < 0 ? 작은 # 큰 \@ 가슴에 대해 사용되지 않은 신성한 호의가 있다...
	RESETCOLOR
	FONTREGULAR
	CALL ASK_YN("가슴을 만지다","가슴 한 쌍을 축복한다")
	IF RESULT
		PRINTFORML 누구의 것인가?
		DRAWLINE
		SIF FLAG:並び替え
			CALL CHARASORT_EX
		FOR LOCAL:1, 0, EX_CHARANUM ;bugfix custom code, allow player as possible target
		IF FLAG:並び替え
			LOCAL = RESULT:(LOCAL:1)
			SIF LOCAL < 0
				CONTINUE
		ELSE
			LOCAL = LOCAL:1
			SIF LOCAL >= CHARANUM
				BREAK
		ENDIF
		SIF IS_MALE(LOCAL) ;custom code bug fix
			CONTINUE
		SIF CFLAG:LOCAL:出禁
			CONTINUE
		SIF TALENT:LOCAL:行きずり
			CONTINUE
		IF ARG > 0
			SIF TALENT:LOCAL:バストサイズ - CFLAG:LOCAL:乳ランクアップ >= 4 ;qol custom code, check for pregnancy
				CONTINUE
		ELSE
			SIF TALENT:LOCAL:バストサイズ - CFLAG:LOCAL:乳ランクアップ <= -3 ;qol custom code, check for pregnancy
				CONTINUE
		ENDIF
		SELECTCASE TALENT:LOCAL:バストサイズ
			CASE IS <= -3
				LOCALS = (Flat)
			CASE -2
				LOCALS = (Tiny)
			CASE -1
				LOCALS = (Small)
			CASE 0
				LOCALS = (Avg)
			CASE 1
				LOCALS = (Big)
			CASE 2
				LOCALS = (Huge)
			CASE 3
				LOCALS = (Giant)
			CASE IS >= 4
				LOCALS = (Myst.)
		ENDSELECT
		SIF CFLAG:LOCAL:乳ランクアップ ;qol custom code, check for pregnancy
			LOCALS = %LOCALS%(+)
		PRINTFORMLC [{LOCAL, 3}] %CALLNAME:LOCAL + LOCALS,15,LEFT%
		NEXT
		PRINTFORML 
		DRAWLINE
		PRINTFORML [999] 멈춰라
		$INPUT_LOOP ;custom code bug fix
		INPUT
		IF RESULT == 999 ;bugfix custom code, limit input to valid options
			RETURN
		ELSEIF RESULT < 0 || RESULT >= CHARANUM ;bugfix custom code, limit input to valid options
			CLEARLINE 1
			GOTO INPUT_LOOP
		ENDIF
		IF RESULT < CHARANUM && IS_MALE(RESULT) ;custom code bug fix
			CLEARLINE 1
			GOTO INPUT_LOOP
		ENDIF
		IF ARG > 0 && TALENT:RESULT:バストサイズ - CFLAG:RESULT:乳ランクアップ >= 4 ;bugfix custom code, prevent growth past maximum
			CLEARLINE 1
			GOTO INPUT_LOOP
		ENDIF
		IF ARG <= 0 && TALENT:RESULT:バストサイズ - CFLAG:RESULT:乳ランクアップ <= -3 ;bugfix custom code, prevent shrinking past minimum
			CLEARLINE 1
			GOTO INPUT_LOOP
		ENDIF
		SELECTCASE RESULT
			CASE 0 TO CHARANUM
				SETCOLOR C_AQUA
				FONTBOLD
				PRINTFORMW %CALLNAME:RESULT%의 가슴은 축복받았다...
				RESETCOLOR
				FONTREGULAR
				IF ARG > 0
					IF TALENT:RESULT:バストサイズ == 4 && CFLAG:RESULT:乳ランクアップ ;qol custom code, check for pregnancy
						CFLAG:RESULT:乳ランクアップ = 0
						PRINTFORMW 임신이 끝난 후에도 %CALLNAME:RESULT%의 가슴은 줄어들지 않는다!
					ELSE
						TALENT:RESULT:バストサイズ ++
						PRINTFORMW %CALLNAME:RESULT%의 가슴이 커진다!
					ENDIF
				ELSE
					IF TALENT:RESULT:バストサイズ == 4 && !CFLAG:RESULT:乳ランクアップ && QOL_PREGNANCY_BREAST_GROWTH_PERIOD(RESULT) ;qol custom code, check for pregnancy
						CFLAG:RESULT:乳ランクアップ = 1
						PRINTFORMW %CALLNAME:RESULT%의 가슴은 임신이 끝나면 줄 것이다!
					ELSE
						TALENT:RESULT:バストサイズ --
						PRINTFORMW %CALLNAME:RESULT%의 가슴이 줄어든다!
					ENDIF
				ENDIF
				CALL KOJO_MESSAGE_SEND("EVENT", 0, RESULT, ARG, 0, "BREAST_BLESSING") ;qol custom code
			CASEELSE
		ENDSELECT
	ELSE
		;揉ませてもらえる分岐は未完成
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORML 당신이 그들에 대한 연모를 키운 후에 내가 너에게 그것들을 만지게 해 주겠다...
		IF !TALENT:MASTER:器用な指
			PRINTFORMW 대신, 나는 당신이 더 뛰어난 기술로 가슴을 만질 수 있게 해주는 기교를 가르쳐 주겠다...
			RESETCOLOR
			FONTREGULAR
			PRINTFORMW %PARSE("You have")%【능숙한손가락】이 되다!
			TALENT:MASTER:器用な指 = 1
		ENDIF
		RESETCOLOR
		FONTREGULAR
	ENDIF
	PRINTFORML 가슴의 안락함에 감싸인 듯, 당신의 의식은 잠이 들면서 멀어진다...
ENDIF
