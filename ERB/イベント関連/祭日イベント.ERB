; Modular ERB: 祭日イベント.ERB
;-------------------------------------------------
;関数名:FESTIVAL
;概　要:行事を表す文字列を取得する関数
;引　数:なし
;-------------------------------------------------

@FESTIVAL
#FUNCTIONS
IF DAY:2 == 1
	SELECTCASE DAY:3
		CASE 1
			RETURNF "元日"
		CASE 3
			RETURNF "雛祭り"
		CASE 11
			RETURNF "母の日"
		CASE 13
			RETURNF "ホワイトデー前日"
		CASE 14
			RETURNF "ホワイトデー"
		CASE 25
			RETURNF "例大祭"
		CASE 28
			RETURNF "バニーの日"
	ENDSELECT
ELSEIF DAY:2 == 2
	SELECTCASE DAY:3
		CASE 7
			RETURNF "七夕"
		CASE 14
			RETURNF "お盆"
		CASE 28
			RETURNF "バニーの日"
	ENDSELECT
ELSEIF DAY:2 == 3
	SELECTCASE DAY:3
		CASE 1
			RETURNF "風神「二百十日」"
		CASE 15
			RETURNF "十五夜"
		CASE 27
			RETURNF "収穫祭"
		CASE 28
			RETURNF "バニーの日"
		CASE 30
			RETURNF "ハロウィン"
	ENDSELECT
ELSEIF DAY:2 == 4
	SELECTCASE DAY:3
		CASE 3
			RETURNF "節分"
		CASE 14
			RETURNF "バレンタインデー"
		CASE 24
			RETURNF "クリスマスイヴ"
		CASE 25
			RETURNF "クリスマス"
		CASE 28
			RETURNF "バニーの日"
		CASE 31
			RETURNF "大晦日"
	ENDSELECT
ENDIF
;特定の祭日の起床時メッセージ

@SEASONAL_MORNING
#DIM 生活時間補正, 5
SELECTCASE FESTIVAL()
	CASE "元日"
		SIF DAY != 1
			CALL NEWYEAR
	CASE "バレンタインデー"
		PRINTFORML 오늘 초콜릿을 받게 될지도 모르겠어...
	CASE "ホワイトデー前日"
		PRINTFORMW 호의를 갚을 준비를 하자.
	CASE "バニーの日"
		PRINTFORMW \@ DAY:2 == 4 ? 토끼 옷만 입고 추운 바람 속에 하루를 보내는 건 힘드네... # 모두 토끼 옷을 입어야 해. \@
	CASE "ホワイトデー"
		FOR LOCAL,1,CHARANUM
		SELECTCASE CFLAG:LOCAL:バレンタイン
			CASE 1
				PRINTFORML 당신은 %CALLNAME:LOCAL%으로부터 블랙 썬더를 받았다...
				PRINTFORMW 선물 고마워...?
			CASE 2
				PRINTFORML 당신은 %CALLNAME:LOCAL%으로부터 평범한 초콜릿을 받았다...
				PRINTFORMW 호의를 갚아주자!
			CASE 3
				PRINTFORML 당신은 %CALLNAME:LOCAL%으로부터 프리미엄 초콜릿을 받았다...
				PRINTFORMW 꼭 %HIM_HER(LOCAL)%에게 제대로 된 보상을 해 주어라!
			CASE 4
				PRINTFORML 당신은 %CALLNAME:LOCAL%에게서 수제 초콜릿을 받았다...
				PRINTFORMW %HIM_HER(LOCAL)%에게 후한 보답을 해 주도록 하라!
		ENDSELECT
		NEXT
	CASE "大晦日"
		PRINTL 이 날은 모든 사람이 밤을 새울 수 있다.
ENDSELECT

@SEASONAL(ARG)
VARSET LOCAL
;出会ったとき
SELECTCASE FESTIVAL()
	CASE "元日"
		PRINTL
		PRINTFORML 당신은 %CALLNAME:ARG%에게 새해 복을 빌어준다.
		CALL OTOSHIDAMA(ARG)
	CASE "バレンタインデー"
		SELECTCASE CFLAG:ARG:好感度
			CASE 1000 TO 3000
				PRINTFORMW 당신은 %CALLNAME:ARG%에게서 초콜릿을 받는다.
				PRINTW ...블랙 선더.
				ITEM:120 ++
				CFLAG:ARG:バレンタイン = 1
			CASE 3001 TO 5000
				PRINTFORMW 당신은 %CALLNAME:ARG%으로부터 초콜릿을 받는다.
				ITEM:121 ++
				CFLAG:ARG:バレンタイン = 2
			CASE IS > 5000
				IF EXP:ARG:愛情経験 < 100
					PRINTFORMW 당신은 %CALLNAME:ARG%에게서 비싼 초콜릿을 받았다.
					ITEM:122 ++
					CFLAG:ARG:バレンタイン = 3
				ELSE
					PRINTFORML 당신은 %CALLNAME:ARG%에게서 초콜릿을 받았다.
					PRINTW 수제란 말이야! 멋지다!
					ITEM:123 ++
					CFLAG:ARG:バレンタイン = 4
				ENDIF
		ENDSELECT
ENDSELECT

@FESTIVAL_MENU()
#FUNCTIONS
SELECTCASE DAY:2
	;春
	CASE 1
		SELECTCASE DAY:3
			CASE 1,2
				RETURNF "おせち料理"
		ENDSELECT
		;夏
	CASE 2
		;秋
	CASE 3
		;冬
	CASE 4
		SELECTCASE DAY:3
			CASE 3
				RETURNF "恵方巻"
			CASE 31
				RETURNF "年越し蕎麦"
		ENDSELECT
ENDSELECT

@NEWYEAR
#DIM YOME
#DIM ChildCount
#DIM CardCount
PRINTW 해피 뉴이어!
CardCount = 0
FOR YOME,1,CHARANUM
IF ABL:YOME:親密 >= 5 && !CFLAG:YOME:神社在住
	PRINTFORML 당신은 %CALLNAME:YOME%에게서 새해 카드를 받는다.
	CALL KOJO_MESSAGE_SEND("EVENT", 0, YOME, 0, 0, "NEWYEARCARD") ;qol custom code
	CardCount ++
ENDIF
SIF CFLAG:YOME:子供人数 - CFLAG:YOME:育児人数 <= 0
	CONTINUE
FOR ChildCount,1, MAXCHILD + 1
IF CHILDNAME:YOME:ChildCount != "" && CHILD_INDEPENDENT:YOME:ChildCount
	PRINTFORML 당신은 %CALLNAME:YOME%의 %SON_DAUGHTER_CHILD(YOME,,ChildCount)% %CHILDNAME:YOME:ChildCount%에게 새해 카드를 받는다.
	CALL KOJO_MESSAGE_SEND("EVENT", 0, YOME, ChildCount, 0, "NEWYEARCARD") ;qol custom code
	CardCount ++
ENDIF
NEXT
NEXT
IF CardCount > 0
	PRINTFORMW 총 {CardCount}장%COND_STR("s", CardCount > 1)%의 카드를 받았다!
ENDIF
PRINTFORML 자, 그럼 올해 당신의 결심은 무엇인가요?
PRINTL
PRINTLC [1] 자위 장려
PRINTLC [2] 동성애 홍보
PRINTLC [3] 여성의 구멍 풀기
PRINTL
PRINTL
PRINTLC [4] 개자식의 발달
PRINTLC [5] 가슴을 즐기다
PRINTLC [6] 많은 아이를 갖는 것
$LOOP
INPUT
SELECTCASE RESULT
	CASE 1
		LOCALS = 자위
	CASE 2
		LOCALS = 동성애
	CASE 3
		LOCALS = 성관계를 갖는 것
	CASE 4
		LOCALS = 항문 성교를 하다
	CASE 5
		LOCALS = 파이즈리
	CASE 6
		LOCALS = 아이가 만들고 있다
	CASEELSE
		GOTO LOOP
ENDSELECT
PRINTFORML 당신은 올해 %LOCALS%에 집중하기로 마음먹었다.
FLAG:抱負 = RESULT
;通年フラグをリセット
FOR LOCAL,0,CHARANUM
CFLAG:LOCAL:通年 = 0
NEXT

@OTOSHIDAMA(ARG)
SIF DAY <= 1
	RETURN
SIF !TALENT:ARG:幼稚 && !TALENT:ARG:育児中
	RETURN
IF TALENT:ARG:幼稚
	PRINTFORMW %CALLNAME:ARG%가 새해 선물로 당신을 귀찮게 한다!
ELSE
	PRINTFORMW %CALLNAME:ARG%은(는) 당신이 %SHOW_CHILDNAME(ARG)%에게 새해 선물을 주기를 원한다.
ENDIF
SELECTCASE MONEY
	CASE IS > 500000
		LOCAL = 10000
	CASE IS > 100000
		LOCAL = 5000
	CASE IS > 30000
		LOCAL = 3000
	CASE IS > 3000
		LOCAL = 1000
	CASEELSE
		LOCAL = 0
ENDSELECT
IF !LOCAL
	PRINTFORML 하지만 당신이 %CALLNAME:ARG%에게 빈 지갑을 보여주면, %HE_SHE(ARG)%은(는) \@ TALENT:ARG:幼稚 ? 하게 당신을 가엾게 바라본다 # 당신에게 솔직히 실망한 표정을 짓는다 \@.
	PRINTFORMW 당신의 마음이 상했다.
ELSE
	PRINTFORML %HE_SHE(ARG,1)%은(는) 당신으로부터 %金額表示(LOCAL)%을 받았다...
	PRINTFORML %HE_SHE(ARG,1)%은(는) 매우 행복해 보인다.
	MONEY -= LOCAL
	TALENT:ARG:機嫌 = 1
	CALL CHANGE_CFLAG(2,ARG,LOCAL/200)
	CALL CHANGE_CFLAG(4,ARG,LOCAL/200)
ENDIF
