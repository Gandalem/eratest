;モブ娘エンカウント率上昇

@MOB_BATTLE_ENCOUNT
#FUNCTION
#DIM 月の状態
IF FLAG:異常気象 == 8 && TCVAR:RANDOM_CHARANUM:発情
	RETURNF 1
ELSEIF TCVAR:RANDOM_CHARANUM:願掛け桃色の風
	RETURNF 1
ELSE
	月の状態 = MOON_WATCH(DAY:3)
	;満月
	IF 月の状態 == 9
		SELECTCASE FLAG:抱負
			CASE 6
				;抱負が子孫繁栄
				RETURNF 1
			CASE 9
				;子孫繁栄達成済み
				SIF RAND:5 == 0
					RETURNF 1
		ENDSELECT
		SIF RAND:10 == 0
			RETURNF 1
		;新月
	ELSEIF 月の状態 == 1 && RAND:3 == 0
		RETURNF 1
	ENDIF
ENDIF
RETURNF 0
