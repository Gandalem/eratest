; Modular ERB: お出かけイベント/GO_OUT_EV04_予定外の来訪.ERB

@GO_OUT_CONDITION_EV4
#DIM NUM
;OPTION設定次第で発生しない
SIF FLAG:交流来訪モード == 3
	RETURN 0
CALL FISHER_YATES_SHAFFLE(RANDOM_CHARANUM)
;ランダムで10人ピックアップ
FOR COUNT, 0, 10
NUM = SHAFFLE_ARRAY:COUNT
;OPTION設定次第で発生しない
SIF !CAN_VISIT(NUM) ;bugfix custom code, use CAN_VISIT
	CONTINUE
;出禁/拠点住まい/来訪不能キャラ、あなたを弾く
SIF CFLAG:NUM:出禁 || CFLAG:NUM:神社在住 || CFLAG:NUM:来訪不能 || !NUM
	CONTINUE
;訪問予定/仕事/宴会参加キャラを弾く
SIF CFLAG:NUM:拠点来訪 || 仕事日チェック(NUM) || CFLAG:NUM:宴会参加
	CONTINUE
;スキマにいない/活動時間外/衰弱中キャラを弾く
SIF CFLAG:NUM:現在位置 != SUKIMA() || !VISIT(NUM) || CFLAG:NUM:衰弱
	CONTINUE
;来訪フラグ.ERBから流用したキャラ別設定
SELECTCASE NUM
	CASE [[妹紅]], [[輝夜]]
		SIF CFLAG:NUM:好感度 <= 500
			CONTINUE
	CASE [[依姫]], [[豊姫]], [[サグメ]]
		SIF !TALENT:NUM:恋慕 && !TALENT:NUM:思慕
			CONTINUE
	CASE [[わかさぎ姫]]
		SIF !GETBIT(FLAG:プール, 3)
			CONTINUE
ENDSELECT
;ここまで通ったキャラを拠点に呼ぶ
CALL GO_OUT_EV4(NUM)
RETURN 1
NEXT
RETURN 0

@GO_OUT_EV4(ARG)
CFLAG:ARG:拠点来訪 = 1
CFLAG:ARG:現在位置 = ENTRANCE
CFLAG:ARG:最後に来訪した日 = DAY
;custom code
PRINTFORML 당신은 %HIS_HER(ARG)%의 %NAME_FROM_PLACE_THE(ENTRANCE)%로 가는 길에 멀리서 %PRINT_MALE("boy", ARG)%을 발견한다.
PRINTFORMW 【%CALLNAME:ARG%이 방문하기 위해 왔다】
PRINTFORML 
RETURN 1
