; Modular ERB: お出かけイベント/GO_OUT_EV03_抗鬱薬おじさん.ERB

@GO_OUT_CONDITION_EV3
IF !RAND:10 && (MAIN_MAP == 2 || CFLAG:MASTER:デート中 == 2)
	CALL GO_OUT_EV3
ELSE
	RETURN 0
ENDIF
RETURN 1

@GO_OUT_EV3
#DIM PAIR
PAIR = FLAG:デート相手
SETCOLOR C_L_GRAY
PRINTFORMDW 가는 길에 수상한 남성에게 접근당한다...!
PRINTFORML 
IF PAIR
	PRINTFORML 「여러분! 끼어들어서 죄송하지만 잠깐 얘기 좀 할 수 있을까요?」
ELSE
	PRINTFORML 「야, 너! 그래, 내가 너한테 말하는 거야! 잠시 얘기 좀 할 수 있을까?」
ENDIF
PRINTFORMW 「아, 너무 오래 걸리지는 않을 거야. 네가 들어주기만 하면 돼...」
PRINTFORMDL 그 남자는 길고 지저분한 머리카락과 콧수염을 기르고 있어 단정치 않다.
PRINTFORMDL 그의 표정만으로도 눈이 초점을 잃고 얼굴 위에서 이리저리 움직이는 모습은 당신에게 상당히 불안감을 느끼게 한다...
RESETCOLOR
CALL ASK_M("그를 무시하고 계속 나아간다", 1, "그를 끝까지 들어라", 1)
SETCOLOR C_L_GRAY
IF !RESULT
	PRINTFORMDL 응, 아니야, 너는 저런 지저분한 애 주변에 있을 필요 없어.
	PRINTFORML 「아악! 잠깐만요, 제발! 그냥 무시하지 말고, 이 사람 좀 도와줘～!」
	PRINTFORMDL 너%COND_STR(@" and %CALLNAME:PAIR%", PAIR)%은 뒤돌아보지 않고 계속 길을 갔다.
	PRINTFORMW
	RESETCOLOR
	RETURN 1
ENDIF
PRINTFORML 「아이고, 정말! 네가 괜찮은 사람일 거라고 알았어 \@ PAIR ? folk # one \@! 고마워! 정말 너무 고마워!」
PRINTFORML 「이제 어디서부터 시작해야 할지...」
SELECTCASE DAY:2
	CASE 1, 3
		PRINTFORMDW 남자는 이유도 없이 식은땀을 흘리며 입을 열기 시작했다.
	CASE 2
		PRINTFORMDW %BREAKENG(@"남자는 땀을 비 오듯 흘리며 말하기 시작했고, 그가 있는 아래에 물웅덩이가 생길 정도였는데, 그것은 날씨가 아무리 더웠어도 조금 이상하게 보였다...")%
	CASE 4
		PRINTFORMDW 혹독한 추위에도 불구하고, 남자는 얼굴을 타고 식은땀이 흘러내리며 말을 시작한다...
ENDSELECT
PRINTDW .........
PRINTDW ......
PRINTDW ...
IF CFLAG:MASTER:今日の運勢 / 100 + TFLAG:幸運補正 < 5
	PRINTFORML 「너%COND_STR(@"희", PAIR)%도 그것을 알아챘지, 그렇지? 요즘 일어나고 있는 모든 이상한 일들을...」
	PRINTFORML 「어떻게 이런 사건들이 이렇게 오랫동안 계속되고 있는 거지?!」
	PRINTFORML 「음, 그 이유를 말해줄게. 이건 분명한 징조라고, 알잖아?! 언젠가 이 세상은 끝날 거라고, 내가 말하는 거야!」
	PRINTFORML 「이 모든 것을 알고 나서 나는 더 불안할 수가 없어... 너무 초조해져!」
	PRINTFORMW 「...! ......!!!」
	PRINTFORMDL 그 남자는 자신의 미친 망상의산물과 편집증에 대해 끊임없이 지껄였다...
	PRINTFORMDL 충분히 들었기에, 당신은 %COND_STR(@" and %CALLNAME:PAIR%", PAIR)% 다른 곳으로 도망쳤다.
	PRINTFORMW 
	IF PAIR
		PRINTFORMDL 소중한 데이트가 수포로 돌아간 당신은 기운 없이 집으로 돌아간다.
		CALL RECOVER(MASTER, -300, "気力", "억울한 이야기")
		CALL RECOVER(PAIR, -300, "気力", "억울한 이야기")
		BASE:PAIR:ムード = BASE:PAIR:ムード / 3
	ELSE
		PRINTFORMDL 시간과 에너지를 낭비한 후, 모든 것에 지쳐 집으로 향한다...
		CALL RECOVER(MASTER, -300, "気力", "억울한 이야기")
	ENDIF
	PRINTFORMDL +60분
	TIME += 60
ELSE
	PRINTFORML 「너희들%COND_STR(@" guys", PAIR)%은 세상의 끝이 가까워졌다는 소문 들었지, 맞지?」
	PRINTFORMW 「응, 그런 가십들이 나한테 정말 큰 영향을 미쳤어...」
	PRINTFORML 「하지만 있잖아, 내가 잘 아는 마약상에게서 이 물건을 얻은 후에는 더 이상 신경 쓰지 않아!」
	PRINTFORML 「이게 받을 만한 평가를 해줘야겠어... 내 모든 걱정이 사라졌으니까!」
	PRINTFORML 「오 세상에, 믿을 수 있겠어?! 이걸로 나는 단 한순간도 세상의 끝을 두려워하지 않을 거야!」
	PRINTFORMDW 그 남자는 항우울제의 경이함에 대해 계속해서 말을 늘어놓았다...
	PRINTFORML 
	PRINTFORML 「진심이야 \@ PAIR ? 너희들 # %PRINT_MALE("lad", MASTER)% \@, 이건 끝내줘! 좀 비싸긴 하지만... 요즘 시대에는 꼭 필요한 거라니까, 내가 말했잖아!」
	PRINTFORMW 「음, 덕분에 네가 유용하게 생각할 만한 걸 한 잔 더 얻게 됐어...」
	PRINTFORMW 「좋아, 이제 뭘 해야 할지 알겠어! 내 말을 들어줘서 고마워. 뭐, 이 모든 걸 가져가도 돼!」
	PRINTFORMDL 남자는 잠약으로 가득 찬 더미를 네 얼굴에 밀어붙이고는 즉시 떠났다.
	CALL GET_ITEM("睡眠薬", 9, 2)
	IF PAIR
		PRINTFORMDL 자세히 살펴보니 다른 종류의 약도 섞여 있었다.
		CALL GET_ITEM("媚薬", 2, 2)
	ENDIF
	PRINTFORML 
	PRINTFORMDL 그걸 일단 정리하고, 당신은 이 게 안전한지 의문을 품으며 집으로 계속 향한다.
	CALL RECOVER(MASTER, -100, "気力", "지루한 이야기")
	SIF PAIR
		CALL RECOVER(PAIR, -100, "気力", "지루한 이야기")
	PRINTFORMDL +30분
	TIME += 30
ENDIF
PRINTFORMW 
RESETCOLOR
RETURN 1
