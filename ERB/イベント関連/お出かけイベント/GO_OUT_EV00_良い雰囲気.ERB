; Modular ERB: お出かけイベント/GO_OUT_EV00_良い雰囲気.ERB

@GO_OUT_CONDITION_EV0
#DIM PAIR
PAIR = FLAG:デート相手
SIF RAND:10 || GROUPMATCH(PAIR, 0, RANDOM_CHARANUM)
	RETURN 0
SIF !TALENT:PAIR:思慕 && !TALENT:PAIR:恋慕
	RETURN 0
SIF MARK:PAIR :反発刻印 || TALENT:PAIR :機嫌 < 0
	RETURN 0
CALL GO_OUT_EV0(PAIR)

@GO_OUT_EV0(ARG)
#DIM MULTIPLE
IF TALENT:ARG:幼稚
	PRINTFORMW 당신은 집으로 돌아가는 동안 %SPLIT_G("play tag with:race:give a piggyback ride to")% %CALLNAME:ARG%한다.
	CALL PRINT_FACE, ARG, "笑顔" ,,, "照れ"
	PRINTFORML %HE_SHE(TARGET,1)%은(는) %HIMSELF_HERSELF(TARGET)%을(를) 꽤 즐기고 있는 것 같다...
	MULTIPLE = 12
ELSEIF TALENT:ARG:恋人
	PRINTFORMW 당신은 %CALLNAME:ARG%와 팔짱을 끼고 집으로 계속 향한다.
	CALL PRINT_FACE, ARG, "笑顔",,, "照れ"
	PRINTFORML 그것은 전체 데이트를 훨씬 더 행복하게 만든다...
	MULTIPLE = 13
ELSEIF TALENT:ARG:恋慕
	PRINTFORMW 집에 가는 길에 %CALLNAME:ARG%와 손을 잡기로 결정한다.
	CALL PRINT_FACE, ARG, "笑顔",,, "照れ"
	PRINTFORML %HE_SHE(TARGET,1)%는 그것에 대해 매우 행복해 보인다...
	MULTIPLE = 12
ELSE
	PRINTFORMW 당신은 %CALLNAME:ARG%의 손을 잡고 집으로 향한다.
	CALL PRINT_FACE, ARG, "通常",,, "照れ"
	PRINTFORML 당신은 어쩐지 %HIM_HER(TARGET)%에게 더 가까워진 것 같은 기분이 든다...
	MULTIPLE = 11
ENDIF
PRINTFORMW 
BASE:ARG:ムード = MIN(BASE:ARG:ムード / 10 * MULTIPLE, MAXBASE:ARG:ムード)
SIF !TALENT:ARG:幼稚
	BASE:ARG:理性 = MAX(BASE:ARG:理性 - MULTIPLE * 5, 0)
RETURN 1
