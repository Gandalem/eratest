@SleepSoundly
#DIM 安眠補正
#DIM 枕 ;logging patch custom code
SIF FLAG:気絶中断
	RETURN 0
SIF CFLAG:MASTER:徹夜
	RETURN 0
SIF CFLAG:MASTER:お招き
	RETURN 0
;安眠枕の補正
IF ITEM:スイート安眠枕
	安眠補正 = MIN(RAND:(SQRT(FLAG:チュート文累計 + 1)), 40)
	枕 = 安眠補正 ;logging patch custom code
	SELECTCASE 安眠補正
		CASE IS > 30
			PRINTFORMW It might be due to the pillow, but you wake up extremely refreshed!
		CASE IS > 20
			PRINTFORMW It might be due to the pillow, but you wake up pretty rested...
	ENDSELECT
ELSE
	安眠補正 = 0
	枕 = 0 ;logging patch custom code
ENDIF
;ベッドの補正
;Furniture patch custom code, re-enabled
;addition custom code, added base bonus outside of rng
IF ITEM:キリのベッド
	SELECTCASE ITEM:キリのベッド
		CASE 1
			安眠補正 += 10 + RAND:11 + RAND:21
		CASE 2
			安眠補正 += 15 + RAND:16 + RAND:31
		CASE 3
			安眠補正 += 20 + RAND:21 + RAND:41
	ENDSELECT
	;logging patch custom code
	SELECTCASE 安眠補正 - 枕
		;bugfix custom code, reversed order
		CASE IS > 60
			PRINTFORMW You wake up fresh from your custom-made bed with the feeling that it's going to be another good day!
		CASE IS > 30
			PRINTFORMW Sleeping on a soft, custom-made bed is nothing short of extraordinary...
	ENDSELECT
ENDIF

RETURN 安眠補正