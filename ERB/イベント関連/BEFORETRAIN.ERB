	ELSE
		;ここはどこ、この子は誰状態 どうやったらこの分岐に来るかわからない…
		PRINTFORMW %BREAKENG(@"Baffled as to why you were sleeping in an unfamiliar place with %CALLNAME:TARGET% sleeping next to you, you \@ BEDROOM(CFLAG:MASTER:現在位置) ? slip out of the %BED_FUTON()% # sneak away from %HIM_HER(TARGET)% \@ and start preparing for the day.")%
	ENDIF
CASE 2
	;同棲相手起き
	PRINTFORMW You awake staring into %CALLNAME:TARGET%'s eyes.
	PRINTFORMW Exchanging morning greetings with %HIM_HER(TARGET)%, you \@ BEDROOM(CFLAG:MASTER:現在位置) ? slip out of the %BED_FUTON()% # get up\@ and start preparing for the new day.
CASE 3
	;同棲相手眠り
	PRINTFORMW You awaken to find %CALLNAME:TARGET% still sleeping peacefully next to you.
	PRINTFORMW Sneaking carefully to avoid waking %TNAME(TARGET)%, you get \@ BEDROOM(CFLAG:MASTER:現在位置) ? out of the %BED_FUTON()% # up \@ and start preparing for a new day.
ENDSELECT
PRINTFORML
SETCOLOR LOCAL:9
RETURN 1

