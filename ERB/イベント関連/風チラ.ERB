; Modular ERB: 風チラ.ERB

@WINDY_PANCHIRA
;デフォルトの確率は25%
LOCAL = 25
;時止め中だと発生しない
SIF FLAG:70
	RETURN 0
;あなた一人だけだと発生しない
SIF TARGET <= 0
	RETURN 0
;対象が睡眠中だと発生しない
SIF CFLAG:睡眠
	RETURN 0
;屋外（屋根の有無は問わない）でないと発生しない
SIF !OUTROOF(CFLAG:MASTER:現在位置) && INROOM(CFLAG:MASTER:現在位置)
	RETURN 0
;地底以外だと晴れか曇りでないと発生しない
SIF GET_MAPID(CFLAG:MASTER:現在位置) != 9 && !(TIME:5 >= 0 && TIME:5 <= 3)
	RETURN 0
;地底以外で台風、および吹雪だと発生しない
SIF GET_MAPID(CFLAG:MASTER:現在位置) != 9 && GROUPMATCH(FLAG:異常気象, 9, 10)
	RETURN 0
;会話、仕事を手伝う、自由行動に付き合う、休憩、掃除、戦闘訓練、待つのいずれかでないと発生しない
SIF !(SELECTCOM == 300 || SELECTCOM == 304 || SELECTCOM == 368 || SELECTCOM == 403 || SELECTCOM == 410 || SELECTCOM == 411 || SELECTCOM == 440)
	RETURN 0
;一部の自由行動では発生しない
IF SELECTCOM == 368
	SELECTCASE Activity_Type:TARGET
		CASE 2,3,7,11,13,15,16,18
			RETURN 0
	ENDSELECT
ENDIF
;一度発生したら5ターンのクールタイムあり
SIF FLAG:風チラCT > 0
	RETURN 0
;暴風以上だとパンツどころではないので発生しない
SIF WIND_VELOCITY >= 2
	RETURN 0
;妖怪の山（山頂）だと発生確率上昇
SIF GET_MAPID(CFLAG:MASTER:現在位置) == 8
	LOCAL += 10
;地底以外で強風だと発生確率上昇
SIF WIND_VELOCITY == 1 && GET_MAPID(CFLAG:MASTER:現在位置) != 9
	LOCAL += 10
$LOOP
IF RAND:2 == 0
	SIF EQUIP:TARGET:ズボン
		RETURN 0
	SIF !(EQUIP:TARGET:スカート || EQUIP:TARGET:ワンピース || EQUIP:TARGET:着物) || EQUIP:TARGET:0 == 0
		RETURN 0
	;着物だと発生確率低下
	SIF !(EQUIP:TARGET:スカート || EQUIP:TARGET:ワンピース) && EQUIP:TARGET:着物
		LOCAL -= 10
	;デート中だと発生確率低下
	SIF CHK_DATENOW(CFLAG:TARGET:デート中)
		LOCAL -= 10
	IF RAND:100 < LOCAL + CFLAG:TARGET:めくれ補正
		CALL PANCHIRA
	ELSE
		RETURN 0
	ENDIF
ELSE
	SIF EQUIP:MASTER:ズボン
		RETURN 0
	SIF !(EQUIP:MASTER:スカート || EQUIP:MASTER:ワンピース || EQUIP:MASTER:着物) || EQUIP:MASTER:0 == 0
		RETURN 0
	SIF !(EQUIP:MASTER:スカート || EQUIP:MASTER:ワンピース) && EQUIP:MASTER:着物
		LOCAL -= 10
	SIF CHK_DATENOW(CFLAG:TARGET:デート中)
		LOCAL -= 10
	IF RAND:100 < LOCAL
		CALL REV_PANCHIRA
	ELSE
		RETURN 0
	ENDIF
ENDIF
RETURN 1

@PANCHIRA
DRAWLINE
;custom code, sentence structure is completely different in the translation because lmao DIFFERENT LANGUAGES GUYS????
IF GET_MAPID(CFLAG:MASTER:現在位置) != 9 && WIND_VELOCITY == 1 ;not in underworld
	PRINTFORM 그 지역에서 상당히 활발했던 강한 바람이 갑자기 불어온다. 
	IF EQUIP:TARGET:スカート
		PRINTFORM 불어오는 바람이 %조사처리(CALLNAME:TARGET,"의")% %SHOW_BOTTOM(TARGET,1)%을 활짝 열게 한다.
	ELSEIF EQUIP:TARGET:着物 || EQUIP:TARGET:ワンピース
		PRINTFORM %SPLIT_G("bottom:hem")%를 %조사처리(CALLNAME:TARGET,"의")% %SHOW_TOP(TARGET, EQUIP:TARGET:着物 ? 1 # 2)%가 활짝 열어젖히고 있다.
	ELSE
		PRINTFORM 에러!
	ENDIF
	PRINTFORM  방금 %HE_SHE(TARGET)%이 잠시 동안 %HIS_HER(TARGET)%의 경계를 허물자!
ELSE
	PRINTFORM 갑작스러운 돌풍이 %조사처리(CALLNAME:TARGET,"를")%(를) 허를 찌른다. 
	IF EQUIP:TARGET:スカート
		PRINTFORM %SPLIT_G("lifts:pulls:knocks")% 위로 올라가라 %HIS_HER(TARGET)% %SHOW_BOTTOM(TARGET,1)%!
	ELSEIF EQUIP:TARGET:着物 || EQUIP:TARGET:ワンピース
		PRINTFORM %SPLIT_G("lifts:pulls:knocks")% up the %SPLIT_G("bottom:hem")% of %HIS_HER(TARGET)% %SHOW_TOP(TARGET, EQUIP:TARGET:着物 ? 1 # 2)%!
	ELSE
		PRINTFORM 오류!
	ENDIF
ENDIF
;end of first sentence
PRINTFORM <br>
PRINTFORM 바로 그 순간, 당신은 %HIS_HER(TARGET)%의 것을 명확하게 보게 됩니다. 
IF !EQUIP:TARGET:下半身下着２
	PRINTFORM 맨살의 하체 부위 
ELSE
	PRINTFORM %PANTS_DESCRIPTION_TR(TARGET)% 
ENDIF
PRINTFORM 이전에 %SPLIT_G("hidden under:hidden behind:covered by")% %HIS_HER(TARGET)% 
IF EQUIP:TARGET:スカート
	PRINTFORM %SHOW_BOTTOM(TARGET,1)%
ELSEIF EQUIP:TARGET:着物
	PRINTFORM %SHOW_TOP(TARGET,1)%
ELSEIF EQUIP:TARGET:ワンピース
	PRINTFORM %SHOW_TOP(TARGET,2)%
ELSE
	PRINTFORM 오류!
ENDIF
LOCALS = %" "%당신이 ~하고 있을 때
SELECTCASE SELECTCOM
	CASE 300 ;conversation
		PRINTFORM %LOCALS%가 대화를 하고 있다.
	CASE 304 ;help with work
		IF CFLAG:TARGET:350 == 46 ;play
			PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%와 함께 게임을 하고 있다.
		ELSE
			PRINTFORM %LOCALS% %HIM_HER(TARGET)%의 일에 %HIS_HER(TARGET)%을/를 돕는다
		ENDIF
	CASE 368 ;join in (idle activity)
		SELECTCASE Activity_Type:TARGET
			CASE 0 ;navelgazing
				PRINTFORM %LOCALS%는 %HIS_HER(TARGET)%의 사고 과정을 알아본다.
			CASE 1 ;playing
				PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%와 함께 게임을 하고 있다.
			CASE 4 ;cleaning
				PRINTFORM %LOCALS%가 %HIM_HER(TARGET)%의 청소를 돕는다.
			CASE 5 ;exercising
				PRINTFORM %LOCALS%는 %HIS_HER(TARGET)%의 운동에 참여한다.
			CASE 6 ;reading
				PRINTFORM %LOCALS%는 %HE_SHE(TARGET)%이 읽고 있던 책에 대해 묻는다.
			CASE 8 ;jamming (music)
				IF TFLAG:193 == -2 ;when you just listen
					SELECTCASE TALENT:TARGET:音楽知識
						CASE 1
							PRINTFORM %LOCALS%는 %HIS_HER(TARGET)%의 음악 공연을 듣고 있다.
						CASE 2
							PRINTFORM %LOCALS%가 %HIS_HER(TARGET)%의 노래를 듣고 있다.
						CASE 3
							PRINTFORM %LOCALS%는 %HIS_HER(TARGET)%의 춤을 감상한다.
					ENDSELECT
				ELSE
					SELECTCASE TALENT:TARGET:音楽知識
						CASE 1
							PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%와 함께 음악을 연주하고 있다.
						CASE 2
							PRINTFORM %LOCALS%가 %HIS_HER(TARGET)%의 노래에 동행한다.
						CASE 3
							PRINTFORM %LOCALS%가 %HIS_HER(TARGET)%의 춤에 동행한다.
					ENDSELECT
				ENDIF
			CASE 9 ;foraging
				PRINTFORM %LOCALS%가 %HIM_HER(TARGET)%를 먹이 활동하는 것을 돕는다
			CASE 10 ;fishing
				IF TFLAG:193 < 0 ;just look
					PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%가 낚시하는 것을 지켜본다
				ELSE
					PRINTFORM %LOCALS%는/은 %HIM_HER(TARGET)% 옆에서 낚시를 한다.
				ENDIF
			CASE 12 ;relaxing
				PRINTFORM %LOCALS%은(는) %HIM_HER(TARGET)%과 함께 휴식을 취한다.
			CASE 14 ;shopping
				PRINTFORM %LOCALS%가 %HIM_HER(TARGET)%을 쇼핑하는 것을 돕는다.
			CASE 17 ;snowman
				PRINTFORM %LOCALS%가 %HIM_HER(TARGET)%을 도와 눈사람을 만든다.
		ENDSELECT
	CASE 403 ;Rest
		PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%와 함께 잠시 숨을 돌린다.
	CASE 410 ;Cleaning
		IF TFLAG:193 ;when helping you
			PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%와 함께 청소한다.
		ELSE
			PRINTFORM %LOCALS%는 %HIM_HER(TARGET)% 앞에서 청소하고 있다.
		ENDIF
	CASE 411 ;Combat Training
		PRINTFORM %LOCALS%는 %HIM_HER(TARGET)%와 함께 훈련한다.
	CASE 440 ;Wait
		IF CHK_DATENOW(CFLAG:TARGET:デート中)
			PRINTFORM %LOCALS%은 데이트를 하며 함께 순간을 나눈다
		ELSE
			PRINTFORM %LOCALS% 당시 근처에
		ENDIF
ENDSELECT
PRINTFORM .
CALL PRINT_BREAK,,"wait:dc"
CALL KOJO_MESSAGE_SEND("PANCHIRA",0,TARGET)
CALL PANCHIRA_SOURCE
RETURN 1
;player gets rolled

@REV_PANCHIRA
DRAWLINE
IF GET_MAPID(CFLAG:MASTER:現在位置) != 9 && WIND_VELOCITY == 1
	PRINTFORM 그 지역에서 상당히 활발했던 강한 바람이 갑자기 불어온다. 
	IF EQUIP:MASTER:スカート
		PRINTFORM 당신의 %SHOW_BOTTOM(MASTER,1)%을 활짝 날리면서
	ELSEIF EQUIP:MASTER:着物 || EQUIP:MASTER:ワンピース
		PRINTFORM blowing the %SPLIT_G("bottom:hem")% of your %SHOW_TOP(MASTER, EQUIP:MASTER:着物 ? 1 # 2)% wide open
	ELSE
		PRINTFORM 오류!
	ENDIF
	PRINTFORM  방심하는 그 순간에 말이다!
ELSE
	PRINTFORM 장난기 가득한 돌풍이 갑자기 발밑에서 터져 나와 당신을 허를 끼치고 
	IF EQUIP:MASTER:スカート
		PRINTFORM 당신의 %SPLIT_G("lifting:pulling:knocking")% 위로 %SHOW_BOTTOM(MASTER,1)%!
	ELSEIF EQUIP:MASTER:着物 || EQUIP:MASTER:ワンピース
		PRINTFORM %SPLIT_G("lifting:pulling:knocking")% ~ 위로 %SPLIT_G("bottom:hem")% 당신의 %SHOW_TOP(MASTER, EQUIP:MASTER:着物 ? 1 # 2)%!
	ELSE
		PRINTFORM 오류!
	ENDIF
ENDIF
;end of first sentence, split into two to prevent run-in
PRINTFORM <br>
IF SELECTCOM == 368 && Activity_Type:TARGET == 10 && RAND:2 == 0 ;fishing
	PRINTFORM 다행히도 %조사처리(CALLNAME:TARGET,"는")% 당신의 부적절한 행동을 눈치채지 못한 것 같다. 왜냐하면 %HE_SHE(TARGET)%는 너무 바빴기 때문이다, 낚시를 하는 중이라...
	CALL PRINT_BREAK,,"wait:dc"
	FLAG:風チラCT = 6
	RETURN 0
ENDIF
PRINTFORM %CALLNAME:TARGET%
IF SELECTCOM == 440 ;wait
	IF CHK_DATENOW(CFLAG:TARGET:デート中)
		PRINTFORM 근처에 있는 사람을,
	ELSE
		PRINTFORM  실수로
	ENDIF
ENDIF
PRINTFORM  결국 당신의 모습을 언뜻 본다 
