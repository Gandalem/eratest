	PRINTFORM 드러난 하반신
ELSE
	PRINTFORM %PANTS_DESCRIPTION_TR(MASTER)%
ENDIF
PRINTFORM  완전히 드러나서
SELECTCASE SELECTCOM
	CASE 300 ;conversation
		PRINTFORM  당신이 대화를 나누고 있을 때
	CASE 304 ;help with work
		IF CFLAG:TARGET:350 == 46
			PRINTFORM  당신을 게임에 초대하고 나서
		ELSE
			PRINTFORM  %HE_SHE(TARGET)%이 당신으로부터 %HIS_HER(TARGET)%의 일을 도와받고 있는 동안
		ENDIF
	CASE 368 ;join in (idle activity)
		SELECTCASE Activity_Type:TARGET
			CASE 0 ;navelgazing
				PRINTFORM  %HE_SHE(TARGET)%이(가) %HIS_HER(TARGET)%의 생각에 몰두해 있을 동안
			CASE 1 ;playing
				PRINTFORM  %HE_SHE(TARGET)%이 당신과 게임을 하고 있을 때
			CASE 4 ;cleaning
				PRINTFORM  %HE_SHE(TARGET)%이 청소하는 것을 당신에게 도움 받으면서
			CASE 5 ;exercising
				PRINTFORM  당신들이 함께 운동하고 있을 때
			CASE 6 ;reading
				PRINTFORM  %HE_SHE(TARGET)%은 당신 앞에서 책을 읽고 있을 때
			CASE 8 ;jamming (music)
				IF TFLAG:193 == -2 ;when you just listen
					SELECTCASE TALENT:TARGET:音楽知識
						CASE 1
							PRINTFORM  %HE_SHE(TARGET)%이 바로 당신 앞에서 공연하고 있을 때
						CASE 2
							PRINTFORM  %HE_SHE(TARGET)%이 바로 앞에서 노래하고 있을 때
						CASE 3
							PRINTFORM  %HE_SHE(TARGET)%이 당신 바로 앞에서 춤을 추고 있을 때
					ENDSELECT
				ELSE
					SELECTCASE TALENT:TARGET:音楽知識
						CASE 1
							PRINTFORM  %HE_SHE(TARGET)%이 당신과 나란히 수행하는 동안
						CASE 2
							PRINTFORM  %HE_SHE(TARGET)%이 당신의 공연에 맞춰 노래하고 있을 때
						CASE 3
							PRINTFORM  %HE_SHE(TARGET)%이 당신의 공연에 맞춰 춤을 추고 있을 때
					ENDSELECT
				ENDIF
			CASE 9 ;foraging
				PRINTFORM  %HE_SHE(TARGET)%이 당신의 도움으로 먹이를 구하는 중일 때
			CASE 10 ;fishing
				IF TFLAG:193 < 0 ;just look
					PRINTFORM  당신이 바라보는 동안 %HE_SHE(TARGET)%은(는) 낚시를 하고 있었다.
				ELSE
					PRINTFORM  %HE_SHE(TARGET)%이 당신 옆에서 낚시를 하고 있는 동안
				ENDIF
			CASE 12 ;relaxing
				PRINTFORM  당신들이 함께 쉬고 있을 때
			CASE 14 ;shopping
				PRINTFORM  %HE_SHE(TARGET)%은 당신의 도움으로 쇼핑 경험을 즐기고 있는 동안
			CASE 17 ;snowman
				PRINTFORM  %HE_SHE(TARGET)%이 당신에게 눈사람을 만드는 것을 도와달라고 할 때
		ENDSELECT
	CASE 403 ;Rest
		PRINTFORM  %HE_SHE(TARGET)%이 당신과 함께 숨을 고르고 있을 때
	CASE 410 ;Cleaning
		IF TFLAG:193 ;when helping you
			PRINTFORM  너희가 함께 청소하고 있을 때
		ELSE
			PRINTFORM  %HE_SHE(TARGET)%은(는) 당신이 청소하는 것을 지켜보고 있을 때
		ENDIF
	CASE 411 ;Combat Training
		PRINTFORM  %HE_SHE(TARGET)%가 당신과 함께 훈련하는 동안
	CASE 440 ;Wait
		PRINTFORM  그녀의 눈앞에서 %HE_SHE(TARGET)%이 당신을 보고 있을 때
ENDSELECT
PRINTFORM ...
CALL PRINT_BREAK,,"wait:dc"
CALL KOJO_MESSAGE_SEND("REV_PANCHIRA",0,TARGET)
CALL REV_PANCHIRA_SOURCE
RETURN 1

