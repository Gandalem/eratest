;### びしょ濡れ判定用式中関数 ################
;ARG=キャラ番号

@SOAKED_OR_NOT(ARGS,ARG)
#FUNCTION
#DIM 必要膣充填率
#DIM 必要アナル充填率
#DIM 必要潤滑レベル
SIF ARG == 0
	ARG = TARGET
必要膣充填率 = 30
必要アナル充填率 = 30
必要潤滑レベル = PALAMLV:5
IF ARGS == "V_SEMINAL"
	IF 充填率(ARG,1) >= 必要膣充填率
		RETURNF 1
	ELSE
		RETURNF 0
	ENDIF
ELSEIF ARGS == "A_SEMINAL"
	IF 充填率(ARG,2) >= 必要アナル充填率
		RETURNF 1
	ELSE
		RETURNF 0
	ENDIF
ELSEIF ARGS == "SECRETIONAL"
	IF PALAM:ARG:潤滑 >= 必要潤滑レベル
		RETURNF 1
	ELSE
		RETURNF 0
	ENDIF
ENDIF
THROW 不正な文字列引数
