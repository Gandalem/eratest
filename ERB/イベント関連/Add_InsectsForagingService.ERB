;process the extra flags
;when starting the day

@EVENTTRAIN
SIF FLAG:蟲の採集サービス && !inTrain
	CALL IFS_GATHER
;ng reset

@NG_CUSTOM_RESET_VAR_2
FLAG:蟲の採集サービス = 0 ;reset Insect's Foraging Service contract, pr 106
