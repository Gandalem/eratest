; Modular ERB: 妊娠関連/OGAMITAOSHI.ERB

@CHK_HININ_LOVE(ARG)
#FUNCTION
LOCAL = 0
SIF TALENT:ARG:恋人
	LOCAL += 300
;愛情経験
LOCAL += EXP:ARG:愛情経験 / 2
;好感度
SELECTCASE CFLAG:ARG:好感度
	CASE 0 TO 499
		LOCAL -= 100
	CASE 500 TO 999
		LOCAL += 30
	CASE 1000 TO 2999
		LOCAL += 50
	CASEELSE
		LOCAL += CFLAG:ARG:好感度 / 30
ENDSELECT
LOCAL += ABL:ARG:親密 * 20
LOCAL += ABL:ARG:従順 * 7
LOCAL += ABL:ARG:奉仕精神 * 7
LOCAL += TCVAR:Common_Sense_Alteration_Status ;hypnosis patch
LOCAL += FLAG:催眠強度
LOCAL = LOCAL*CapacityStats:MASTER:5/100
RETURNF LOCAL

@CHK_HININ_REASON(ARG,ARGS)
#FUNCTION
#DIM 理性判定値
VARSET LOCAL
LOCAL:3 += GETPALAMLV(PALAM:欲情,15) * (10 + TALENT:ARG:快感応答 * 3)
LOCAL:3 += GETPALAMLV(PALAM:恭順,15) * (10 - TALENT:ARG:態度 * 3)
LOCAL:3 += GETPALAMLV(PALAM:好意,15) * 10
LOCAL:5 += ABL:ARG:膣射中毒 * 15
LOCAL:5 += ABL:ARG:欲望 * (10 + TALENT:ARG:快感応答 * 2)
LOCAL:5 += MARK:ARG:快楽刻印 * 10
LOCAL:5 += MARK:ARG:不埒刻印 * 10
LOCAL:5 += MARK:ARG:苦痛刻印 * 10
LOCAL:5 -= MARK:ARG:反発刻印 * 100
理性判定値 = 800 - LOCAL:3 * LOCAL:5 / 300
理性判定値 -= TCVAR:Common_Sense_Alteration_Status * 3 ;hypnosis patch
理性判定値 -= FLAG:催眠強度 * 3
SIF ESTRUS_CYCLE(ARG) == 150
	理性判定値 += 1000
IF TCVAR:ARG:発情 && TALENT:ARG:動物耳 && CFLAG:ARG:900 == 7
	理性判定値 -= 200
ELSEIF TCVAR:ARG:惚れ薬 || IsHeat(ARG)
	理性判定値 -= 50
ENDIF
SIF IsInsenceValid(ARG)
	理性判定値 -= 50
IF TALENT:ARG:ツンデレ
	IF TALENT:ARG:恋慕
		理性判定値 = 理性判定値 * 2 / 3
	ELSE
		理性判定値 = 理性判定値 * 3 / 2
	ENDIF
ENDIF
;信頼度
IF CFLAG:ARG:信頼度 < 100
	理性判定値 *= 5
ELSEIF CFLAG:ARG:信頼度 < 300
	理性判定値 *= 5 / 2
ELSEIF CFLAG:ARG:信頼度 < 500
	理性判定値 *= 5 / 3
ELSEIF CFLAG:ARG:信頼度 < 1000
	理性判定値 *= 5 / 4
ENDIF
;カウンターだとここで素質処理しておく
IF ARGS == "COUNTER"
	SIF TALENT:ARG:抵抗
		理性判定値 += 300
	IF TALENT:ARG:プライド == -1
		理性判定値  = 理性判定値 * 9 / 10
	ELSEIF TALENT:ARG:プライド == 1
		理性判定値 = 理性判定値 * 6 / 5
	ENDIF
	SIF OTOKOGIRAI(ARG)
		理性判定値 = 理性判定値 * 3 / 2
	SIF TALENT:ARG:貞操 == 1
		理性判定値 = 理性判定値 * 6 / 5
	SIF TALENT:MASTER:謎の魅力
		理性判定値 = 理性判定値 * 9 / 10
	SIF TALENT:MASTER:容姿 > 0 ;addition custom code
		理性判定値 = 理性判定値 * 4 / 5
	SIF TALENT:ARG:倒錯的
		理性判定値 = 理性判定値 * 9 / 10
	IF FuckReserved(ARG)
		SELECTCASE EXP:ARG:愛情経験
			CASE IS >= 500
				理性判定値 = 理性判定値 / 2
			CASE IS >= 300
				理性判定値 = 理性判定値 * 4 / 3
			CASE IS >= 100
				理性判定値 = 理性判定値 * 3 / 2
			CASEELSE
				理性判定値 *= 2
		ENDSELECT
	ENDIF
	IF TALENT:ARG:ツンデレ
		IF TALENT:ARG:恋慕
			理性判定値 = 理性判定値 * 2 / 3
		ELSE
			理性判定値 = 理性判定値 * 3 / 2
		ENDIF
	ENDIF
ENDIF
理性判定値 = 理性判定値*CapacityStats:ARG:5/100
理性判定値 = MAX(理性判定値,0)
RETURNF 理性判定値

@OGAMITAOSHI(ARG)
#DIM 理性判定値
#DIM 好意判定値
#DIM 好意表示
VARSET LOCAL
PRINTFORMW %CALLNAME:ARG%의 마음속에...
好意判定値 = CHK_HININ_LOVE(ARG)
CALL SHOW_LOVEPOWER(好意判定値)
WAIT
理性判定値 = CHK_HININ_REASON(ARG)
CALL SHOW_REASONWALL(理性判定値)
IF BASE:ARG:Hypno
	理性判定値 = 理性判定値 - BASE:ARG:Hypno
	CALL COLORMESSAGE(@"%CALLNAME:ARG%는 최면 상태에서 주의가 산만해진다...",C_PINK,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:MASTER:謎の魅力
	CALL COLORMESSAGE(@"%CALLNAME:ARG%느낌이 %HIS_HER(ARG)% 당신의 신비로운 매력으로부터 흔들리다...",C_PINK,1,1)
	理性判定値 = 理性判定値 * 9 / 10
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:MASTER:容姿 > 0 ;addition custom code
	CALL COLORMESSAGE(@"%CALLNAME:ARG%는 당신의 아름다움에 매료되었다...",C_PINK,1,1)
	理性判定値 = 理性判定値 * 4 / 5
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:プライド == -1
	理性判定値  = 理性判定値 * 9 / 10
ELSEIF TALENT:ARG:プライド == 1
	理性判定値 = 理性判定値 * 6 / 5
	CALL COLORMESSAGE(@"자존심 많은 %CALLNAME:ARG%은 %HIMSELF_HERSELF(ARG)%를 단타로 파는 것은 생각할 수 없는 일이라고 생각한다.",C_PINK,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:貞操 == 1
	理性判定値 = 理性判定値 * 6 / 5
	CALL COLORMESSAGE(@"덕스러운 %CALLNAME:ARG%은(는) 그런 결정 전에 깊이 생각해야 한다고 생각한다...",C_PINK,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF OTOKOGIRAI(ARG)
	理性判定値 = 理性判定値 * 3 / 2
	IF TALENT:ARG:性別嗜好 == 3
		CALL COLORMESSAGE(@"%CALLNAME:ARG%는 사람들을 전반적으로 좋아하지 않는다...",C_PINK,1,1)
	ELSEIF TALENT:ARG:性別嗜好 == 2 && IS_FEMALE(MASTER)
		CALL COLORMESSAGE(@"%CALLNAME:ARG%는 대체로 여자를 좋아하지 않는다...",C_PINK,1,1)
	ELSEIF TALENT:ARG:性別嗜好 == 1 && IS_MALE(MASTER)
		CALL COLORMESSAGE(@"%CALLNAME:ARG%는 대체로 남자를 좋아하지 않는다…",C_PINK,1,1)
	ENDIF
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:倒錯的
	CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 자신의 건강하지 못한 관계에 대해 %HIS_HER(ARG)%의 더 나은 판단과 대적하는 뒤틀린 매력을 느끼고 있다...",C_PINK,1,1)
	理性判定値 = 理性判定値 * 8 / 10
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF FuckReserved(ARG)
	SELECTCASE EXP:ARG:愛情経験
		CASE IS >= 500
			CALL COLORMESSAGE(@"%CALLNAME:ARG%은 당신에게 %HIM_HER(ARG)%를 위해서라면 뭐든지 해달라고 한다...!",C_PINK,1,1)
			理性判定値 = 理性判定値 / 2
		CASE IS >= 300
			CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 당신을 %HIS_HER(ARG)% 파트너로 생각하지만, 그 정도까지 갈 준비가 되어 있지 않다...",C_PINK,1,1)
			理性判定値 = 理性判定値 * 6 / 5
		CASE IS >= 100
			CALL COLORMESSAGE(@"%CALLNAME:ARG%는 가까운 파트너에게조차 특정한 거리를 유지하고 싶어 한다...",C_PINK,1,1)
			理性判定値 = 理性判定値 * 3 / 2
		CASEELSE
			CALL COLORMESSAGE(@"%CALLNAME:ARG%는 그런 다른 사람을 받아들일 준비가 되어 있지 않다...",C_PINK,1,1)
			理性判定値 *= 2
	ENDSELECT
	CALL SHOW_REASONWALL(理性判定値)
ELSEIF HasBionicPart(MASTER,82)
	CALL COLORMESSAGE(@"트로이의 영혼이 활성화한다...!",C_PINK,1,1)
	理性判定値 = 理性判定値 / 2
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:ツンデレ
	CALL COLORMESSAGE(@"츤데레 반응 체크...",C_YELLOW,1,1)
	IF TALENT:ARG:恋慕
		理性判定値 = 理性判定値 * 2 / 3
		CALL COLORMESSAGE(@"%CALLNAME:ARG%가 당신에게 아첨하고 있어!",C_PINK,1,1)
	ELSE
		理性判定値 = 理性判定値 * 3 / 2
		CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 적대감을 느끼며 움츠러든다.",C_PINK,1,1)
	ENDIF
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:Slave
	TIMES 理性判定値, 0.1
	CALL COLORMESSAGE(@"노예가 된 %CALLNAME:ARG%는 명령 불복종에 대한 처벌을 두려워한다.",C_YELLOW,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF ARG == 102
	TIMES 理性判定値, 0
	CALL COLORMESSAGE(@"배경 균형 이유",C_YELLOW,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
WAIT
IF CHK_HININ_LOVE(ARG) > 理性判定値
	$SUCCESS
	IF ESTRUS_CYCLE(ARG) < 1500
		PRINTFORMW 남들의 생각이 어떻든 신경 쓰지 말라는 말을 듣고, %CALLNAME:ARG%는 마침내 굴복한다.
		CFLAG:ARG:生解禁 = 1
		CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,4,0)
		CALL COLORMESSAGE(@"그녀는 이제 위험한 날을 제외하고 피임 없이 성관계에 동의한다!",C_YELLOW,2) ;custom code
	ELSE
		PRINTFORMW 당신이 %CALLNAME:ARG%에게 아이를 갖고 싶다고 말하면, %HE_SHE(ARG)%는 부끄러워하며 고개를 끄덕인다.
		CFLAG:ARG:生解禁 = 2
		CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,5,0)
		CALL COLORMESSAGE(@"그녀는 이제 당신과 아기를 만드는 것에 동의합니다!",C_YELLOW,2) ;custom code
	ENDIF
ELSE
	IF CHK_HININ_LOVE(ARG)-理性判定値 >= -200
		PRINTFORML %CALLNAME:ARG%는 그 문제에 대해 강하게 압박받지만 머뭇거리며 거절한다.
	ELSEIF CHK_HININ_LOVE(ARG)-理性判定値 >= -500
		PRINTFORML %CALLNAME:ARG%은 부드럽게 거절한다.
	ELSEIF CHK_HININ_LOVE(ARG)-理性判定値 >= -1000
		PRINTFORML %CALLNAME:ARG%은(는) 자신감 있게 아니라고 말한다.
	ELSE
		PRINTFORML %CALLNAME:ARG%은 그것을 생으로 하는 생각에 분노한 듯하다.
	ENDIF
	CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,2,0)
	;qol custom code, hint
	SIF CFLAG:ARG:ダメ出し
		CALL COLORMESSAGE(@"(%HIM_HER(ARG)%을 설득하려 노력할수록, 더 쉬워진다)",C_YELLOW, 1, 1)
	CALL ASK_YN(@"%HIS_HER(ARG)%은 존경심을 가질 것이다",@"다시 밀어붙인다\@ CFLAG:ARG:ダメ出し ? %" "%(설득 시도:{CFLAG:ARG:ダメ出し,2}) #  \@")
	IF RESULT == 0
		TCVAR:ARG:挿入拒絶 = 1
		RETURN -1
	ELSE
		;口のうまさと相手次第では粘ればどうにかなる
		LOCAL = (4 - TALENT:ARG:応答 - TALENT:ARG:度胸 - TALENT:ARG:態度) * (ABL:MASTER:話術技能 + 3 * CFLAG:ARG:ダメ出し)
		LOCAL:2 = 理性判定値 * (100 - LOCAL) / 100
		CALL SHOW_REASONWALL(LOCAL:2)
		IF CHK_HININ_LOVE(ARG) > LOCAL:2
			PRINTFORMW 당신은 빠른 말솜씨로 %CALLNAME:ARG%을 설득하는 데 성공했다.
			IF ESTRUS_CYCLE(ARG) < 1500
				CFLAG:ARG:生解禁 = 1
				CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,4,0)
				CALL COLORMESSAGE(@"그녀는 이제 위험한 날을 제외하고 피임 없이 성관계에 동의한다!",C_YELLOW,2) ;custom code
			ELSE
				CFLAG:ARG:生解禁 = 2
				CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,5,0)
				CALL COLORMESSAGE(@"그녀는 이제 당신과 아기를 만드는 것에 동의합니다!",C_YELLOW,2) ;custom code
			ENDIF
		ELSE
			CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,3,0)
			PRINTFORMW %CALLNAME:ARG%는 그녀의 모든 힘으로 너희 모두를 꾸짖는다...
			CFLAG:ARG:ダメ出し += 1
			CALL ENDUFUFU(ARG)
			CALL GET_ANGRY(ARG, MARK:ARG:反発刻印 + 1)
			TFLAG:106 = 0
			TCVAR:ARG:挿入拒絶 = 1
			RETURN -1
		ENDIF
	ENDIF
ENDIF

@SHOW_REASONWALL(理性判定値, UNIT = 100)
#DIM 理性判定値
#DIM UNIT
;custom code
PRINTFORM %"Reasoning barrier", 22, LEFT%: 
SETCOLOR 255,255,0
LOCAL = MAX(理性判定値 / UNIT,1)
;qol custom code, shorten display to it's numeric value if the option is enabled
IF FLAG:好意理性短縮
	PRINTFORML ★{理性判定値}
	RESETCOLOR
ELSE
	PRINTFORM %"★" * LOCAL%
	RESETCOLOR
	SIF 理性判定値 % UNIT > (UNIT / 2)
		PRINT ★
	PRINTFORML {理性判定値}
	PRINTW
ENDIF

@SHOW_LOVEPOWER(好意判定値, UNIT = 100, ARGS)
#DIM 好意判定値
#DIM 好意表示
#DIM UNIT
IF ARGS == ""
	PRINTFORM %"Your favor", 22, LEFT%: 
ELSE
	PRINTFORM %ARGS, 22, LEFT%: 
ENDIF
好意表示 = MAX(好意判定値 / UNIT,0)
;LOCALS:1 = %GETFONT()%
;SETFONT "Times New Roman"
LOCAL = GETCOLOR()
PRINTFORM %UNICODE(0x2764) * MAX((好意表示 / 10000 -1),0)%
RESETCOLOR
SETCOLOR 255,51,153
;qol custom code, shorten display to it's numeric value if the option is enabled
IF FLAG:好意理性短縮
	PRINTFORML %UNICODE(0x2764)% {好意判定値}
	SETCOLOR LOCAL
ELSE
	SIF 好意表示 >=10000
		PRINTFORM %UNICODE(0x2764) * (9999)%%UNICODE(0x2764)%
	PRINTFORM %UNICODE(0x2764) * (好意表示 % 10000)%
	SETCOLOR LOCAL
	SIF 好意判定値 % UNIT > (UNIT / 2)
		PRINTFORM %UNICODE(0x2764)%
	PRINTFORML {好意判定値}
ENDIF
SETFONT LOCALS:1
PRINTW
