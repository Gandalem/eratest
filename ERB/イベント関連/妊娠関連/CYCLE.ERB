; Modular ERB: 妊娠関連/CYCLE.ERB

@ESTRUS_CYCLE(ARG)
#FUNCTION
SELECTCASE CFLAG:(ARG:0):900
	;安全日
	CASE 1 TO 2
		LOCAL = 0
	CASE 3 TO 4
		LOCAL = 300
	CASE 5
		LOCAL = 500
	CASE 6
		LOCAL = 700
		;危険日
	CASE 7
		LOCAL = 1500
	CASE 8
		LOCAL = 1000
	CASE 9
		LOCAL = 600
	CASE 10
		LOCAL = 400
ENDSELECT
RETURNF LOCAL

@REAL_ESTRUS_CYCLE(ARG)
#FUNCTION
LOCAL = ESTRUS_CYCLE(ARG)
; SIF TCVAR:ARG:強制排卵
; 	LOCAL = MAX(LOCAL, LOCAL / 5 + 1000)
SIF TCVAR:ARG:強制排卵
	LOCAL += 1000
SIF TCVAR:ARG:FertilityMagicDid
	LOCAL += 1000
RETURNF LOCAL
;生理周期文字F関数
;翌日などの状態を参照できる

@ESTRUS_CATEGORY(C_ID, ADD_DAY)
#FUNCTIONS
#DIM C_ID     ;登録番号
#DIM ADD_DAY  ;何日後を参照するか、0なら今日
#DIM CHECK_DAY;実際に参照される日の周期
SIF ADD_DAY < 0
	ADD_DAY = -(ABS(ADD_DAY) % 10)
CHECK_DAY = (CFLAG:C_ID:生理周期 + ADD_DAY + 10) % 10
SIF !CHECK_DAY
	CHECK_DAY = 10
;eraNAS customs
SELECTCASE TCVAR:C_ID:FertilityMagicDid
	CASE 1
		SIF TCVAR:C_ID:強制排卵
			RETURNF "Double Ovulated"
		RETURNF "Ovucast"
	CASE 2
		SIF TCVAR:C_ID:強制排卵
			RETURNF "Double Ovulated"
		RETURNF "Egg Inserted"
ENDSELECT
;//////////
SIF TCVAR:C_ID:強制排卵
	RETURNF "排卵誘発剤効果発揮中"
SELECTCASE CHECK_DAY
	;安全日
	CASE 1 TO 2
		RETURNF "安全日"
	CASE 6
		RETURNF "危険日前日"
		;危険日
	CASE 7
		RETURNF "危険日"
	CASE 8
		RETURNF "排卵"
	CASEELSE
		RETURNF "非危険日"
ENDSELECT
;生理周期表示関数
;似たようなのが幾つもあったので全部ここで処理しちゃう

@NEW_CYCLE_PRINT(C_ID, ADD_DAY, OP)
#DIM  C_ID    ;登録番号
#DIM  ADD_DAY ;何日後を参照するか、0なら今日
#DIMS OP      ;オプション、現在「等幅」のみ
#DIMS 表示文  ;表示される内容
VARSET 表示文
IF CFLAG:C_ID:妊娠経過日数
	SETCOLOR C_PINK
	SELECTCASE CFLAG:C_ID:妊娠経過日数
		CASE IS >= 97
			表示文 '= CLIP_HEART("In Labor")
		CASE IS >= 70
			表示文 '= CLIP_HEART("Close to Birth")
		CASE IS >= 60
			表示文 '= CLIP_HEART("Lactating")
		CASE IS >= 30
			表示文 '= CLIP_HEART("Stable Period")
		CASE IS >= 20
			表示文 '= CLIP_HEART(@"\@ GROUPMATCH(TALENT:C_ID:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) ? 알을 품은 # 임신한 \@")
		CASEELSE
			表示文 '= CLIP_HEART("Fertilized")
	ENDSELECT
	; ELSEIF !ADD_DAY && TCVAR:C_ID:発情 ;qol custom code, moved down
	; 	SETCOLOR C_PINK
	; 	表示文 '= CLIP_HEART("In heat")
ELSEIF 임신가부(C_ID)
	表示文 '= ESTRUS_CATEGORY_STRING_TR(ESTRUS_CATEGORY(C_ID, ADD_DAY))
	SIF !STRLENS(表示文)
		RETURN
	SELECTCASE 表示文
		CASE "Dangerous Day", "Double Ovulated"
			SETCOLOR C_PINK
			表示文 '= CLIP_HEART(表示文)
		CASE "Ovulation", "Before Dangerous Day", "Ovulation Drug", "Ovucast", "Egg Inserted"
			SETCOLOR 0xEE60EE
		CASE "Safe Day"
			SETCOLOR C_AQUA
	ENDSELECT
	;qol custom code, show recovery stage
	SIF QOL_IS_IN_RECOVERY(C_ID)
		表示文 = In Recovery
ELSE
	表示文 '= ESTRUS_CATEGORY_STRING_TR(ESTRUS_CATEGORY(C_ID, ADD_DAY))
	SIF !STRLENS(表示文)
		RETURN
	SELECTCASE 表示文
		CASE "Dangerous Day", "Double Ovulated"
			SETCOLOR 0xc099a0
			表示文 '= CLIP_HEART(表示文)
		CASE "Ovulation", "Before Dangerous Day", "Ovulation Drug", "Ovucast", "Egg Inserted"
			SETCOLOR 0xe4d2d8
		CASE "Safe Day"
			SETCOLOR 0xe0ffff
	ENDSELECT
	表示文 = ？？？
ENDIF
;NAS: HTML printing
IF STRCOUNT(OP, "「HTML」")
	RESULTS '= MO_TALENT(表示文)
	;Custom code, just kind of ignoring this
ELSEIF STRCOUNT(OP, "「等幅」") && 0
	PRINTFORM %表示文, 20, LEFT%
ELSE
	IF !ADD_DAY && TCVAR:C_ID:発情 ;qol custom code
		CALL PRINT_STR, @"@HEX@{C_PINK}@%CLIP_HEART("In heat")%@ (%表示文%)  "
	ELSE
		PRINTFORM %表示文%  
	ENDIF
ENDIF
RESETCOLOR

@CYCLE_PRINT(ARG)
CALL NEW_CYCLE_PRINT(ARG)
RETURN
VARSET LOCAL
IF TALENT:ARG:妊娠
	SETCOLOR C_PINK
	CALL HEART
	PRINTFORM 임신{CFLAG:ARG:妊娠経過日数}일째
	CALL HEART
ELSEIF CFLAG:ARG:妊娠経過日数
	SETCOLOR C_PINK
	CALL HEART
	PRINTFORM 착상 완료
	CALL HEART
ELSEIF ESTRUS_CYCLE(ARG) == 150
	SETCOLOR C_PINK
	CALL HEART
	IF TCVAR:ARG:発情
		PRINTFORM 발정 중
	ELSE
		PRINTFORM 위험일
	ENDIF
	CALL HEART
ELSEIF ESTRUS_CYCLE(ARG) == 100
	SETCOLOR 0xEE60EE
	PRINTFORM 배란
ELSEIF ESTRUS_CYCLE(ARG) == 70
	SETCOLOR 0xEE60EE
	PRINTFORM 위험한 전날
ELSEIF ESTRUS_CYCLE(ARG) == 15
	SETCOLOR C_AQUA
	PRINTFORM 안전일
ENDIF
RESETCOLOR

@CYCLE_PRINT翌日(ARG)
CALL NEW_CYCLE_PRINT(ARG, 1)
RETURN
VARSET LOCAL
IF TALENT:ARG:妊娠
	SETCOLOR C_PINK
	CALL HEART
	PRINTFORM 임신
	CALL HEART
ELSEIF CFLAG:ARG:妊娠経過日数
	SETCOLOR C_PINK
	CALL HEART
	PRINTFORM 착상 완료
	CALL HEART
ELSEIF CFLAG:ARG:900 == 6
	SETCOLOR C_PINK
	CALL HEART
	IF TCVAR:ARG:発情
		PRINTFORM 발정 중
	ELSE
		PRINTFORM 위험일
	ENDIF
	CALL HEART
ELSEIF CFLAG:ARG:900 == 7
	SETCOLOR 0xEE60EE
	PRINTFORM 배란
ELSEIF CFLAG:ARG:900 == 5
	SETCOLOR 0xEE60EE
	PRINTFORM 위험한 전날
ELSEIF CFLAG:ARG:900 == 10 || CFLAG:ARG:900 == 1
	SETCOLOR C_AQUA
	PRINTFORM 안전일
ENDIF
RESETCOLOR
;@CYCLE_PRINT翌日()を表示崩れしないよう
;テキストを同じ幅で出力するようにしたもの

@PRINT_CYCLE_翌日(C_ID)
#DIM C_ID
#DIMS 表示文
CALL NEW_CYCLE_PRINT(C_ID, 1, "「等幅」")
RETURN
表示文 =
IF TALENT:C_ID:妊娠
	SETCOLOR C_PINK
	;表示文 = %CLIP_HEART("妊娠")%
	表示文 '= CLIP_HEART(@"「\@ GROUPMATCH(TALENT:C_ID:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) ? 난란화 # 임신 \@」")
ELSE
	SELECTCASE CFLAG:C_ID:生理周期
		CASE 6
			SETCOLOR C_PINK
			IF TCVAR:C_ID:発情
				表示文 = %CLIP_HEART("発情中")%
			ELSE
				表示文 = %CLIP_HEART("危険日")%
			ENDIF
		CASE 7
			SETCOLOR 0xEE60EE
			表示文 = 排卵
		CASE 5
			SETCOLOR 0xEE60EE
			表示文 = 危険日前日
		CASE 10, 1
			SETCOLOR C_AQUA
			表示文 = 安全日
	ENDSELECT
ENDIF
PRINTFORM %表示文, 10, LEFT%
RESETCOLOR
