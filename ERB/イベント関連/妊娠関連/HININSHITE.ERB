ENDIF
PRINTFORML %CALLNAME:ARG%은/는 그것이 %LOCALS%이기 때문에 피임에 대해 주장한다.
CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,1,0)
;addition custom code (third line below)
;NAS: fourth line
;pullout promise patch 5th line
$NASLoop
CALL ASK_M("포기해라",1, @"콘돔을 사용한다 ({ITEM:45} 남음%COND_STR(@"| Fake: {ITEM:1102} left",ITEM:1102)%)",ITEM:45||ITEM:1102, @"피임약({ITEM:49} 남음%COND_STR(@"| Fake: {ITEM:1103} left",ITEM:1103)%)을 건네라",ITEM:49||ITEM:1103, "그것을 생으로 해달라고 겸손하게 부탁한다.", !TCVAR:懇願, @"%HE_SHE(ARG)%는 구속되어야 하거나 패배한 무작위 공격자여야만 한다는 것을, 조건 없이 임신하게 될 것이라고 당당히 선언한다\@ !(TEQUIP:TARGET:縄 || TEQUIP:TARGET:拘束 || CFLAG:TARGET:負け犬) ? %" "%(Need to be restrained, or must be a random attacker who was defeated) #  \@", (TEQUIP:TARGET:縄 || TEQUIP:TARGET:拘束 || CFLAG:TARGET:負け犬), @"Tell that it's your first time and you want to do it raw\@ !IS_DOUTEI(MASTER) ? %" "%Player must be a Virgin♂#\@", IS_DOUTEI(MASTER), @"다른 무언가를 주어 속이는 것", 1, @"그것을 생으로 해달라고 겸손하게 부탁하며, 당신이 꺼낼 것이라는 약속을 한다 \@ CFLAG:PullOutPromiseDenied ? %" "%(%조사처리(CALLNAME:TARGET,"는")% 더 이상 당신을 신뢰하지 않는다...) #  \@", !CFLAG:PullOutPromiseDenied)
IF RESULT == 1
	CALL NAS_Put_On_Condom(MASTER) ; replace NAS stuff
	SIF RESULT == -1
		RETURN -1
	; ITEM:45 -= 1
	; PRINTL Put on a condom.
	; TEQUIP:MASTER:コンドーム = 1
ELSEIF RESULT == 2
	; ITEM:49 -= 1
	; TCVAR:ARG:ピル = 1
	; PRINTFORML %CALLNAME:ARG% takes the pill and swallows it.
	CALL Com_Use_Contraceptive(TARGET) ; replace NAS stuff
	SIF RESULT == -1
		RETURN -1
ELSEIF RESULT == 3
	TCVAR:ARG:懇願 = 1
	CALL OGAMITAOSHI(ARG)
	SIF RESULT == -1
		RETURN -1
ELSEIF RESULT == 4
	TCVAR:ARG:無理矢理 = 1
ELSEIF RESULT == 5 ;addition custom code
	CALL ADD_FudeOroshiRaw(ARG)
	SIF RESULT == -1
		RETURN -1
	;-----------------------------------
ELSEIF RESULT == 7 ;pullout promise patch
	CALL OGAMITAOSHI2(ARG)
	SIF RESULT == -1
		RETURN -1
ELSEIF RESULT == 6
	;NAS: Give a drug
	;todo: change this to show the entire drug list.
	CALL ASK_M("돌아가기", 1, "배란약", ITEM:排卵誘発剤 && HAS_VAGINA(ARG), "최음제", ITEM:42, @"%COND_STR("Diuretic",nPee)%", ITEM:42 && nPee, @"%COND_STR("Laxative",nScat)%", ITEM:314 && nScat, "연모 포션", ITEM:250, "발기제", ITEM:(HIN_ITEMS:5), "플루복사민", ITEM:(HIN_ITEMS:6), "이부프로펜", ITEM:(HIN_ITEMS:7), "가짜 항우울제", 1, "가짜 최음제", 1, "가짜 피임법", 1, "가짜 발기제", 1, "가짜 이부프로펜", 1, @"%COND_STR("Incontinence Drop", nPee && nScat)%", ITEM:1108 )
	LOCAL = RESULT-1
	SIF RESULT == 0
		GOTO NASLoop
	SIF (!TALENT:ARG:55 && TALENT:ARG:SexKnow < 5) || TALENT:ARG:SexKnow == -1
		GOTO NASDrugSuccess
	HIN_TRICK_ROLL:0 = 0
	HIN_TRICK_ROLL:1 = 0
	PRINTFORMW %ABL_TR(47)%확인 중... (60\% 가중치)
	Y = TALENT:MASTER:49
	CALL NAMED_ABLCHANGE(MASTER,49,Y,Y)
	T = TALENT:ARG:49
	CALL NAMED_ABLCHANGE(ARG,49,T,T)
	HIN_TRICK_ROLL:0 += (Y*10)*60/100
	HIN_TRICK_ROLL:1 += (T*10)*60/100
	PRINTFORMW %ABL_TR(43)% 확인 중... (20\% 가중치)
	Y = ABL:MASTER:43
	CALL NAMED_ABLCHANGE(MASTER,43,Y,Y)
	T = ABL:ARG:43
	CALL NAMED_ABLCHANGE(ARG,43,T,T)
	HIN_TRICK_ROLL:0 += (Y*10)*20/100
	HIN_TRICK_ROLL:1 += (T*10)*20/100
	PRINTFORMW %ABL_TR(41)% 확인 중...(20\% 비중)
	Y = ABL:MASTER:41
	CALL NAMED_ABLCHANGE(MASTER,41,Y,Y)
	T = ABL:ARG:41
	CALL NAMED_ABLCHANGE(ARG,41,T,T)
	HIN_TRICK_ROLL:0 += (Y*10)*20/100
	HIN_TRICK_ROLL:1 += (T*10)*20/100
	PRINTFORMW {HIN_TRICK_ROLL:0} 대 {HIN_TRICK_ROLL:1}
	IF HIN_TRICK_ROLL:0 > HIN_TRICK_ROLL:1
		HIN_PASS_CHANCE = 100
	ELSEIF HIN_TRICK_ROLL:0 < (HIN_TRICK_ROLL:1)
		HIN_PASS_CHANCE = (((200*100)/HIN_TRICK_ROLL:1)*(HIN_TRICK_ROLL:0-HIN_TRICK_ROLL:1))/100+100
		HIN_PASS_CHANCE = LIMIT(HIN_PASS_CHANCE,0,100)
	ENDIF
	PRINTFORMW 확률: {HIN_PASS_CHANCE}\%
	IF HIN_PASS_CHANCE > RAND:100
		$NASDrugSuccess
		PRINTFORML 당신은 성공적으로 %CALLNAME:ARG%에게 약을 먹게 한다.
		PRINTFORML 하지만 그것은 사실 %HIN_ITEM_STR:LOCAL%였다.
		CALL DrugStuffNoFluff(ARG,HIN_ITEMS:LOCAL)
		CFLAG:ARG:生解禁 = 2
		PRINTFORMW %CALLNAME:ARG%와 노상질 관계를 가질 수 있는 임시 허가를 받았다!
		cTempRawPerm:ARG:0 = 1
		RETURN 0
	ELSE
		$NASDrugFail
		PRINTFORML %CALLNAME:ARG%는 당신의 계략에 납득하지 못했다.
		CFLAG:ARG:ダメ出し += 1
		TCVAR:ARG:挿入拒絶 = 1
		RESULT = -1
		RETURN -1
	ENDIF
	;-----------------------------------
ELSE
	PRINTFORML Unfortunately %PARSE("you have")% to give up.
	RESULT = -1
	RETURN -1
ENDIF

@避妊要求(ARG)
SIF CFLAG:ARG:生解禁  == 2
	RETURN
SIF !임신가부(ARG)
	RETURN
SIF !HAS_PENIS(MASTER)
	RETURN
SIF TALENT:ARG:SexKnow == -1
	RETURN
SIF TFLAG:16
	RETURN
SIF TCVAR:ARG:無理矢理
	RETURN
SIF !SHIRAHU(ARG)
	RETURN
SIF TCVAR:ARG:挿入拒絶
	RETURN -1
;安全日
SIF !ESTRUS_CYCLE(ARG)
	RETURN
;外に出すから
SIF TCVAR:外に出すから ;pullout promise patch
	RETURN
IF !CFLAG:ARG:生解禁
	CALL HININSHITE(ARG)
ELSEIF ESTRUS_CYCLE(ARG) >= 1500
	CALL HININSHITE(ARG)
ENDIF
SIF RESULT == -1
	RETURN -1

@임신가부(ARG)
#FUNCTION
SIF TEQUIP:PLAYER:コンドーム || TCVAR:ARG:ピル
	RETURNF 0
SIF TALENT:ARG:幼稚 && !TALENT:ARG:初潮
	RETURNF 0
SIF ((CHECK_CHARA(ARG, "幽霊") || CHECK_CHARA(ARG, "人形") || CHECK_CHARA(ARG, "蓬莱人")) && !CFLAG:ARG:子供人数) || TALENT:ARG:妊娠
	RETURNF 0
RETURNF 1

@AUTO_CONTRACEPTION(ARG)
IF !FLAG:STABLEBYPASS && !TALENT:ARG:HYPERFERTILE ;qol custom code
	IF CFLAG:ARG:妊娠経過日数 <= 30 && TALENT:ARG:妊娠
		PRINTFORMW 안정기에 들어갈 때까지 기다리자.
		RETURN -1
	ENDIF
	IF CFLAG:ARG:妊娠経過日数 > 70 && TALENT:ARG:妊娠
		PRINTFORMW 아기에게 너무 위험해.
		RETURN -1
	ENDIF
ENDIF
IF !FLAG:CHILD_LIMIT_BYPASS && !TALENT:ARG:HYPERFERTILE ;qol custom code
	SIF !TALENT:ARG:育児中
		RETURN
	SIF !HAS_PENIS(MASTER)
		RETURN
	SIF TEQUIP:PLAYER:コンドーム || TCVAR:ARG:ピル
		RETURN
	;qol custom code, replaced
	SIF !QOL_IS_IN_RECOVERY(ARG)
		RETURN
	; SIF CFLAG:ARG:出産経過日 >= CHILD_就学
	; 	RETURN
	PRINTFORML %CALLNAME:ARG%가 이미 아이를 낳고 있으니, 더 이상 부담을 늘리지 말자.
	IF !SHIRAHU(ARG) ;bug fix
		CALL ASK_M("콘돔을 사용하라",ITEM:コンドーム,"그녀에게 알약을 먹인다",ITEM:ピル,"포기해라",1)
	ELSE
		CALL ASK_M("콘돔을 사용한다",ITEM:コンドーム,"알약을 건네라",ITEM:ピル,"포기해라",1)
	ENDIF
	SELECTCASE RESULT
		CASE 0
			ITEM:コンドーム --
			TEQUIP:PLAYER:コンドーム = 1
			PRINTL 콘돔을 착용한다.
			RETURN 1
		CASE 1
			ITEM:ピル --
			TCVAR:ARG:ピル = 1
			IF !SHIRAHU(ARG) ;bug fix
				PRINTFORML 당신은 조심스럽게 %CALLNAME:ARG%에게 알약을 삼키게 한다.
			ELSE
				PRINTFORML %CALLNAME:ARG%은(는) 약을 먹고 삼킨다.
			ENDIF
			RETURN 1
		CASE 2
			PRINTFORML 불행하게도, 포기해야 한다.
			RETURN -1
	ENDSELECT
ENDIF

