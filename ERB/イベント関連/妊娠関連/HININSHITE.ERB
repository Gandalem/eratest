	SIF TEQUIP:PLAYER:コンドーム || TCVAR:ARG:ピル
		RETURN
	;qol custom code, replaced
	SIF !QOL_IS_IN_RECOVERY(ARG)
		RETURN
	; SIF CFLAG:ARG:出産経過日 >= CHILD_就学
	; 	RETURN
	PRINTFORML As %CALLNAME:ARG% is already raising a child, let's not increase the burden any further.
	IF !SHIRAHU(ARG) ;bug fix
		CALL ASK_M("Use a condom",ITEM:コンドーム,"Feed her a pill",ITEM:ピル,"Give up",1)
	ELSE
		CALL ASK_M("Use a condom",ITEM:コンドーム,"Hand over a pill",ITEM:ピル,"Give up",1)
	ENDIF
	SELECTCASE RESULT
		CASE 0
			ITEM:コンドーム --
			TEQUIP:PLAYER:コンドーム = 1
			PRINTL Put on a condom.
			RETURN 1
		CASE 1
			ITEM:ピル --
			TCVAR:ARG:ピル = 1
