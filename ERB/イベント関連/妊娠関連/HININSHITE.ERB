	CALL LOST_VIRGIN_STOP(ARG)
	SIF RESULT == -1
		RETURN -2
ENDIF
CALL AUTO_CONTRACEPTION(ARG)
SIF RESULT == -1
	RETURN -1
CALL 避妊要求(ARG)
IF RESULT == -1
	RETURN -1
ENDIF
