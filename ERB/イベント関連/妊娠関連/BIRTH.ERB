@BIRTH(ARG)
#DIM CHILDNUM
#DIM DYNAMIC INITCHILDNUM
#DIM DYNAMIC CHILDCOUNT
CALL BIRTH_NAS(ARG); NAS: REPLACED
RETURN RESULT

	;Custom code, make sure pregnancy is at least 1, set variables.
CFLAG:ARG:WithChildCount = MAX(CFLAG:ARG:WithChildCount,1)
PregnancyProgress:ARG:0 = MAX(PregnancyProgress:ARG:0,101)
INITCHILDNUM = (CFLAG:ARG:子供人数+1) % MAXCHILD
CHILDCOUNT = CFLAG:ARG:子供人数
CFLAG:ARG:LatestChildCount = COUNT_BIRTH_MATES(ARG)
CFLAG:ARG:BirthEventsCount++
DRAWLINE
$LOOP
;妊娠消去、出産経験、性別の決定、誕生日決定
	;Custom code, reduce with child count and remove a pregnancy tracker once for each child.
CFLAG:ARG:WithChildCount -= 1
CALL REMOVE_PREGNANCY_PROGRESS(ARG)
EXP:ARG:出産経験 += 1
	;Moved.
CFLAG:ARG:子供人数 ++
CFLAG:MASTER:子供人数 ++
CFLAG:ARG:育児人数 ++
CFLAG:MASTER:育児人数 ++
Qol_Info_Count_Array:ARG:Qol_Count_Birth ++ ;qol custom code
CHILDNUM = CFLAG:ARG:子供人数 % MAXCHILD
SIF !CHILDNUM
	CHILDNUM = MAXCHILD
IF FLAG:子供の性別
	CHILD_SEX:ARG:CHILDNUM = FLAG:子供の性別
ELSE
	CHILD_SEX:ARG:CHILDNUM = RAND:2 + 1
ENDIF
CHILD_BIRTHDAY:ARG:CHILDNUM = DAY
CHILD_BIRTHDATE:ARG:CHILDNUM = (DAY / 124 + (DAY % 124 ? 1 # 0)) * 1000
CHILD_BIRTHDATE:ARG:CHILDNUM += DAY:2 * 100 + DAY:3
CHILD_WEATHER:ARG:CHILDNUM = %GET_WEATHER()%
	;Custom code, skip sending KOJO event here.
IF CFLAG:ARG:無自覚妊娠
	CHILD_LOVE:ARG:CHILDNUM = -100
ELSEIF TALENT:ARG:恋慕
	CHILD_LOVE:ARG:CHILDNUM = 300
ELSEIF TALENT:ARG:思慕
	CHILD_LOVE:ARG:CHILDNUM = 200
ELSE
	CHILD_LOVE:ARG:CHILDNUM = 100
ENDIF	

SIF !CFLAG:ARG:無自覚妊娠 && ITEM:私達だけが知る哀嘆 == 1
	CHILD_LOVE:ARG:CHILDNUM += 150

	;Custom code, loop again if there are more children to be born.
SIF CFLAG:ARG:WithChildCount && PregnancyProgress:ARG:0 > 100
	GOTO LOOP

	;Custom code, only send KOJO event once, differentiate live birth and hatching, and pass the number of the first child being born as ARG:1.
IF CFLAG:ARG:無自覚妊娠
	LOCAL:1 = 4
ELSEIF TALENT:ARG:恋慕
	LOCAL:1 = 1
ELSEIF TALENT:ARG:思慕
	LOCAL:1 = 2
ELSE
	LOCAL:1 = 3
ENDIF
IF TALENT:ARG:NESTING
	CALL KOJO_MESSAGE_SEND("EVENT",0,ARG,LOCAL:1,INITCHILDNUM,"HATCHING")
ELSE
	CALL KOJO_MESSAGE_SEND("EVENT",25,ARG,LOCAL:1,INITCHILDNUM)
ENDIF

	;Custom code, separate loop to name all children, set CHILDNUM according to LOCAL, account for pregnancy types.
FOR LOCAL,INITCHILDNUM,INITCHILDNUM+CFLAG:ARG:LatestChildCount
	CHILDNUM = LOCAL % MAXCHILD
	SIF !CHILDNUM
		CHILDNUM = MAXCHILD
	;あらかじめ自立先を決めちゃう（自立するときにもっかい決める）
	CALL 自立先選定(ARG, CHILDNUM)
	IF FLAG:EGGNANCY && GROUPMATCH(TALENT:ARG:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH)
		PRINTFORMW A short time after being laid, your child hatches safely from the egg.
	ELSE
		PRINTFORMW \@ TALENT:ARG:NESTING ? Your child hatches safely in %CALLNAME:ARG%'s care. # %CALLNAME:ARG% gives birth to your child safely. \@
	ENDIF
	PRINTFORMW \@ CHILD_SEX:ARG:CHILDNUM == 1 ? She resembles her mother %CALLNAME:ARG% # He resembles his father \@ a bit.
	PRINTFORMW %CALLNAME:ARG% holds the newborn baby, and gently cradles it as %HE_SHE(ARG)% breastfeeds %HIM_HER_CHILD(ARG,,CHILDNUM)%...
	IF TALENT:ARG:母性 == 0
		PRINTFORMW %CALLNAME:ARG%'s [Maternity] has awoken!
			;Moved.
		TALENT:ARG:母性 = 1
	ENDIF
	PRINTL ******************************************************************
	;bug fix custom code
	CHILDCOUNT++
	PRINTFORML %ORDINAL(CHILDCOUNT)% child\@ CHILDCOUNT > MAXCHILD ? %" "% (Overrides %ORDINAL(CHILDNUM)%) #\@　Mother: %NAME:ARG%　Father: %NAME:MASTER%
	PRINTFORML 　Sex: \@ CHILD_SEX:ARG:CHILDNUM == 1 ? ♀ # ♂ \@
	PRINTFORM Birthday: 
	PRINTFORML %PRINT_DATE_F(DAY)% 
	PRINTFORML  %FESTIVAL_TR()% -%GET_WEATHER_TR()%-
	;PRINTFORML 　身長：
	;PRINTFORML 　体重：
	;PRINTFORML 　種族：
	;PRINTFORML 髪の色：
	;PRINTFORML 目の色：
	PRINTL ******************************************************************
		;Moved.
	CALL CHILD_NAME(ARG, CHILDNUM)
NEXT

;育児中・母性追加
CFLAG:ARG:出産経過日 = 1 + FLAG:妊娠日程倍率
CFLAG:ARG:無自覚妊娠 = 0
CFLAG:ARG:身に覚え_母 = 0
CFLAG:ARG:身に覚え_父 = 0
CFLAG:ARG:妊娠自覚状態 = 0 

CFLAG:ARG:産休中 = 0
	;Custom code, set pregnancy or nesting progress to the next due child (if any) instead of zero.
IF GROUPMATCH(TALENT:ARG:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) && !FLAG:EGGNANCY
	TALENT:ARG:NESTING = PregnancyProgress:ARG:0
	CFLAG:ARG:妊娠経過日数 = 0
ELSE
	CFLAG:ARG:妊娠経過日数 = PregnancyProgress:ARG:0
	TALENT:ARG:NESTING = 0
		;Only unset pregnancy talent if progress is below 20.
	SIF CFLAG:ARG:妊娠経過日数 < 20
		TALENT:ARG:妊娠 = 0
ENDIF
EXP:ARG:愛情経験 += 10
;Custom Code
IF FLAG:甲斐性無 && !FLAG:LUSTMODE && !LS_RESTRICTION("Incompetent mode")
	PRINTFORML The realization that your \@ CFLAG:ARG:LatestChildCount > 1 ? children were # child was \@ just born hits you.
	CALL ASK_YN("A sense of responsibility boils up from inside","Anxiety for the future fills you with dread")
	IF !RESULT
		PRINTFORMW You are no longer incompetent.
			;Custom code, only set the flag if it's turned off.
		FLAG:甲斐性無 = 0
	ELSE
		PRINTFORMW If human nature was that easy to change, there would be no conflicts.
		PRINTFORMW As you are as unreliable as ever, %CALLNAME:ARG% is left to take care of raising the \@ CFLAG:ARG:LatestChildCount > 1 ? children # child \@.
	ENDIF
ENDIF

@CHILD_NAME(YOME, CHILDNUM, ChildFather)
#DIM YOME
#DIM ChildFather
#DIM CHILDNUM
#DIMS PROPOSED_NAME, MAXCHILD ;custom code
;bug fix
;CHILDNUM = EXP:YOME:出産経験 % MAXCHILD
;SIF !EXP:YOME:出産経験 % MAXCHILD
;	CHILDNUM = MAXCHILD
PROPOSED_NAME:0 = %ランダムキャラ_命名()%
;Custom code, disabled as it's untranslated
;IF CHILD_SEX:YOME:CHILDNUM == 1
;	PROPOSED_NAME:0 = %ランダムキャラ_命名(YOME)%
;ELSE
;	PROPOSED_NAME:0 = %男の子_命名(YOME, CHILDNUM)%
;ENDIF
$LOOP0
LOCALS:1 =
;auto name if it's not your child
IF ChildFather != MASTER && YOME != MASTER
	PRINTFORML This child isn't part of your family, so %CALLNAME:YOME% picked her own name instead.
	;western
	LOCALS:2 = %nameArray:YOME:na_LastName%
	IF nameArray:YOME:na_NameType == "Western"
		IF IS_MALE(CHILDNUM)
			CALL GENERATE_FIRST_NAME_KM()
			LOCALS:1 = %RESULTS%
		ELSE
			CALL GENERATE_FIRST_NAME_KF()
			LOCALS:1 = %RESULTS%
		ENDIF
	ELSE
		IF IS_MALE(CHILDNUM)
			CALL GENERATE_FIRST_NAME_JM()
			LOCALS:1 = %RESULTS%
		ELSE
			CALL GENERATE_FIRST_NAME_JF()
			LOCALS:1 = %RESULTS%
		ENDIF
	ENDIF
	SIF !STRLENS(LOCALS:1)
		GOTO LOOP0
	nameArray:CHILDNUM:na_FirstName '= LOCALS:1
	CALLNAME:CHILDNUM '= nameArray:LOCAL:na_FirstName
	NAME:CHILDNUM '= nameChecker(CHILDNUM)
	GOTO BYPASS
ENDIF




PRINTL Let's pick a name for the child.
PRINTFORML 
CALL ASK_M("Input directly",1,"Random list",1,"After the「hot wind that blows through Mexico」naturally, the name「Santana」!",YOME != ChildFather,"Too lazy, just keep it at「Baby」",1)

SELECTCASE RESULT
	CASE 0
		$LOOP1
		PRINTL Input the child's name please.
		INPUTS
		IF RESULTS == ""
			GOTO LOOP1
		ELSE
			PROPOSED_NAME:0 = %RESULTS%
			CALL CHK_CHILDNAME_DUPLICATION(PROPOSED_NAME:0)
			PRINTFORML Is %PROPOSED_NAME:0% fine?
			CALL ASK_YN
			IF RESULT
				GOTO LOOP1
			ELSE
				nameArray:CHILDNUM:na_FirstName = %PROPOSED_NAME:0%
			ENDIF
		ENDIF
	CASE 1
		$LOOP2
		FOR LOCAL,1,MAXCHILD
			IF nameArray:YOME:na_NameType == "Western"
				IF IS_MALE(CHILDNUM)
					CALL GENERATE_FIRST_NAME_KM()
					LOCALS:1 = %RESULTS%
				ELSE
					CALL GENERATE_FIRST_NAME_KF()
					LOCALS:1 = %RESULTS%
				ENDIF
			ELSE
				IF IS_MALE(CHILDNUM)
					CALL GENERATE_FIRST_NAME_JM()
					LOCALS:1 = %RESULTS%
				ELSE
					CALL GENERATE_FIRST_NAME_JF()
					LOCALS:1 = %RESULTS%
				ENDIF
			ENDIF
			PROPOSED_NAME:LOCAL = %RESULTS%
			;Custom code, disabled as it's untranslated
			;IF CHILD_SEX:YOME:CHILDNUM == 1
			;	PROPOSED_NAME:LOCAL = %ランダムキャラ_命名(YOME)%
			;ELSE
			;	PROPOSED_NAME:LOCAL = %男の子_命名(YOME, CHILDNUM)%
			;ENDIF
			PRINTFORML [{LOCAL}] - %PROPOSED_NAME:LOCAL%
		NEXT
		DRAWLINE
		PRINTFORML [99] - New list
		PRINTFORML [100] - Return
		$LOOP3
		INPUT
		SELECTCASE RESULT
			CASE 1 TO MAXCHILD - 1
				LOCAL = RESULT
				CALL CHK_CHILDNAME_DUPLICATION(PROPOSED_NAME:LOCAL)
				PRINTFORML Is %PROPOSED_NAME:LOCAL% fine?
				CALL ASK_YN
				IF RESULT
					GOTO LOOP0
				ELSE
					nameArray:CHILDNUM:na_FirstName = %PROPOSED_NAME:LOCAL%
				ENDIF
			CASE 99
				GOTO LOOP2
			CASE 100
				GOTO LOOP0
			CASEELSE
				GOTO LOOP3
		ENDSELECT
	CASE 2
		PRINTFORML The angry \@ PreggoWith:YOME:0 == MASTER ? %CALLNAME:YOME% # %CALLNAME:(PreggoWith:YOME:0)% \@ picks a name for %PARSE("you")%...
		nameArray:CHILDNUM:na_FirstName = %ランダムキャラ_命名()%
		;Custom code, disabled as it's untranslated
		;CHILDNAME:YOME:CHILDNUM = %PROPOSED_NAME:0%
	CASE 3
ENDSELECT
$BYPASS

PRINTFORML The child's name became %nameArray:CHILDNUM:na_FirstName%.
TALENT:YOME:育児中 = CHILDNUM
CALLNAME:CHILDNUM '= nameArray:CHILDNUM:na_FirstName
NAME:CHILDNUM '= nameChecker(CHILDNUM)
CALL ASK_DIARY(@"%PARSE("You",,,YOME)% gave birth to a baby %PRINT_MALE("boy",CHILDNUM)% named %nameArray:CHILDNUM:na_FirstName%.")
;----------------------------------------------------
;そのキャラに特定の年齢の子供がいたら返す関数
;----------------------------------------------------
@CHK_HAVE_CHILD(ARG,ARG:1,ARG:2)
#FUNCTION
#DIM 年齢
SIF !CFLAG:ARG:子供人数
	RETURNF 0

FOR LOCAL, 1, MAXCHILD + 1
	SIF CHILDNAME:ARG:LOCAL == ""
		CONTINUE
	年齢 = DAY - CHILD_BIRTHDAY:ARG:LOCAL
	SIF INRANGE(年齢,ARG:1,ARG:2-1)
		RETURNF LOCAL
NEXT

RETURNF 0
;----------------------------------------------------
;誕生日の子供がいるか返す関数
;eraTW4.570proto_bugfix_m05での仕様変更
;・REFを使用し、配列を書き換えるF関数にした（引数を全て渡さないとエラーになる）
;・仕様上、配列の想定最大要素数は10*キャラクタ数上限となる（＝RESULTの要素数を突破してエラーが出たので仕様変更）
;・BREAKやCONTINUEを使用して処理を効率化
;----------------------------------------------------
@CHILD_HAPPY_BIRTHDAY(CNT_BIRTHDAY, NAME_CHILD, AGE_CHILD)
#FUNCTION
#DIM CHARA
#DIM CHILDNUM
#DIM  REF CNT_BIRTHDAY
#DIMS REF NAME_CHILD
#DIM  REF AGE_CHILD
FOR CHARA, 1, CHARANUM
	SIF !CFLAG:CHARA:子供人数
		CONTINUE
	FOR CHILDNUM, 1, MIN(MAXCHILD + 1, CFLAG:CHARA:子供人数 + 1)
		;名無し≒未登録なら次のキャラへ
		SIF !STRLENS(CHILDNAME:CHARA:CHILDNUM)
			BREAK
		;誕生日以外はスキップ
		SIF (DAY - CHILD_BIRTHDAY:CHARA:CHILDNUM) % 124
			CONTINUE
		CNT_BIRTHDAY ++
		NAME_CHILD:CNT_BIRTHDAY = %CHILDNAME:CHARA:CHILDNUM%
		AGE_CHILD:CNT_BIRTHDAY = (DAY - CHILD_BIRTHDAY:CHARA:CHILDNUM) / 124
	NEXT
NEXT
RETURNF CNT_BIRTHDAY

;子供の名前被りチェック
@CHK_CHILDNAME_DUPLICATION(ARGS)
#DIM C_ID
FOR C_ID,1,CHARANUM
	;"FOR LOCAL,0,10"から修正
	FOR LOCAL,1, MAXCHILD + 1
		SIF CHILDNAME:C_ID:LOCAL == ARGS
			CALL COLORMESSAGE(@"%CALLNAME:C_ID% already has a child with that name.",C_YELLOW,1)
	NEXT
NEXT