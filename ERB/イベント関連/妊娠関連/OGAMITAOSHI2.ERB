; Modular ERB: 妊娠関連/OGAMITAOSHI2.ERB
;pullout promise patch

@CHK_HININ_LOVE2(ARG)
#FUNCTION
LOCAL = 0
SIF TALENT:ARG:恋人
	LOCAL += 500
;愛情経験
LOCAL += EXP:ARG:愛情経験 / 2
;好感度
SELECTCASE CFLAG:ARG:好感度
	CASE 0 TO 499
		LOCAL -= 100
	CASE 500 TO 999
		LOCAL += 50
	CASE 1000 TO 2999
		LOCAL += 80
	CASEELSE
		LOCAL += CFLAG:ARG:好感度 / 20
ENDSELECT
LOCAL += ABL:ARG:親密 * 25
LOCAL += ABL:ARG:従順 * 25
LOCAL += ABL:ARG:奉仕精神 * 10
RETURNF LOCAL

@CHK_HININ_REASON2(ARG,ARGS)
#FUNCTION
#DIM 理性判定値
VARSET LOCAL
LOCAL:3 += GETPALAMLV(PALAM:欲情,25) * (10 + TALENT:ARG:快感応答 * 4)
LOCAL:3 += GETPALAMLV(PALAM:恭順,25) * (10 - TALENT:ARG:態度 * 3)
LOCAL:3 += GETPALAMLV(PALAM:好意,25) * 10
LOCAL:5 += ABL:ARG:膣射中毒 * 30
LOCAL:5 += ABL:ARG:欲望 * (10 + TALENT:ARG:快感応答 * 3)
LOCAL:5 += MARK:ARG:快楽刻印 * 30
LOCAL:5 += MARK:ARG:不埒刻印 * 10
LOCAL:5 += MARK:ARG:苦痛刻印 * 10
LOCAL:5 -= MARK:ARG:反発刻印 * 100
理性判定値 = 800 - LOCAL:3 * LOCAL:5 / 300
SIF ESTRUS_CYCLE(ARG) == 150
	理性判定値 += 1000
IF TCVAR:ARG:発情 && TALENT:ARG:動物耳 && CFLAG:ARG:900 == 7
	理性判定値 -= 500
ELSEIF TCVAR:ARG:惚れ薬 || IsHeat(ARG)
	理性判定値 -= 200
ENDIF
SIF IsInsenceValid(ARG)
	理性判定値 -= 50
IF TALENT:ARG:ツンデレ
	IF TALENT:ARG:恋慕
		理性判定値 = 理性判定値 * 2 / 3
	ELSE
		理性判定値 = 理性判定値 * 3 / 2
	ENDIF
ENDIF
;信頼度
IF CFLAG:ARG:信頼度 < 100
	理性判定値 *= 4
ELSEIF CFLAG:ARG:信頼度 < 300
	理性判定値 *= 2
ELSEIF CFLAG:ARG:信頼度 < 500
	理性判定値 *= 5 / 3
ELSEIF CFLAG:ARG:信頼度 < 1000
	理性判定値 *= 6 / 5
ELSE
	理性判定値 *= 3 / 5
ENDIF
;カウンターだとここで素質処理しておく
IF ARGS == "COUNTER"
	SIF TALENT:ARG:抵抗
		理性判定値 += 200
	IF TALENT:ARG:プライド == -1
		理性判定値  = 理性判定値 * 9 / 10
	ELSEIF TALENT:ARG:プライド == 1
		理性判定値 = 理性判定値 * 6 / 5
	ENDIF
	SIF OTOKOGIRAI(ARG)
		理性判定値 = 理性判定値 * 3 / 2
	SIF TALENT:ARG:貞操 == 1
		理性判定値 = 理性判定値 * 6 / 5
	SIF TALENT:MASTER:謎の魅力
		理性判定値 = 理性判定値 * 2 / 5
	SIF TALENT:MASTER:容姿 > 0 ;addition custom code
		理性判定値 = 理性判定値 * 3 / 5
	SIF TALENT:ARG:倒錯的
		理性判定値 = 理性判定値 * 4 / 5
	IF TALENT:ARG:一線越えない
		SELECTCASE EXP:ARG:愛情経験
			CASE IS >= 500
				理性判定値 = 理性判定値 / 3
			CASE IS >= 300
				理性判定値 = 理性判定値 * 11 / 10
			CASE IS >= 100
				理性判定値 = 理性判定値 * 5 / 4
			CASEELSE
				理性判定値 = 理性判定値 * 3 / 2
		ENDSELECT
	ENDIF
	IF TALENT:ARG:ツンデレ
		IF TALENT:ARG:恋慕
			理性判定値 = 理性判定値 / 2
		ELSEIF TALENT:ARG:思慕
			理性判定値 = 理性判定値 * 2 / 3
		ELSE
			理性判定値 = 理性判定値 * 3 / 2
		ENDIF
	ENDIF
ENDIF
理性判定値 = MAX(理性判定値,0)
RETURNF 理性判定値

@OGAMITAOSHI2(ARG)
#DIM 理性判定値
#DIM 好意判定値
#DIM 好意表示
VARSET LOCAL
PRINTFORMW %CALLNAME:ARG%의 마음속에...
好意判定値 = CHK_HININ_LOVE(ARG)
CALL SHOW_LOVEPOWER(好意判定値)
WAIT
理性判定値 = CHK_HININ_REASON(ARG)
CALL SHOW_REASONWALL(理性判定値)
IF TALENT:MASTER:謎の魅力
	CALL COLORMESSAGE(@"%CALLNAME:ARG%느낌이 %HIS_HER(ARG)% 당신의 신비로운 매력으로부터 흔들리다...",C_PINK,1,1)
	理性判定値 = 理性判定値 * 2 / 5
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
;addition custom code
IF TALENT:MASTER:容姿 > 0
	CALL COLORMESSAGE(@"%CALLNAME:ARG%는 당신의 아름다움에 매료되었다...",C_PINK,1,1)
	理性判定値 = 理性判定値 * 3 / 5
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:プライド == -1
	理性判定値  = 理性判定値 * 9 / 10
ELSEIF TALENT:ARG:プライド == 1
	理性判定値 = 理性判定値 * 6 / 5
	CALL COLORMESSAGE(@"자존심 있는 %CALLNAME:ARG%은 단축 매도를 생각할 수 없다고 여긴다.",C_PINK,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:貞操 == 1
	理性判定値 = 理性判定値 * 6 / 5
	CALL COLORMESSAGE(@"덕스러운 %CALLNAME:ARG%은(는) 그런 결정 전에 깊이 생각해야 한다고 생각한다...",C_PINK,1,1)
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF OTOKOGIRAI(ARG)
	理性判定値 = 理性判定値 * 3 / 2
	IF TALENT:ARG:性別嗜好 == 3
		CALL COLORMESSAGE(@"%CALLNAME:ARG%는 사람들을 전반적으로 좋아하지 않는다...",C_PINK,1,1)
	ELSEIF TALENT:ARG:性別嗜好 == 1
		CALL COLORMESSAGE(@"%CALLNAME:ARG%는 대체로 남자를 좋아하지 않는다…",C_PINK,1,1)
	ENDIF
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:倒錯的
	CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 자신의 건강하지 못한 관계에 대해 %HIS_HER(ARG)%의 더 나은 판단과 대적하는 뒤틀린 매력을 느끼고 있다...",C_PINK,1,1)
	理性判定値 = 理性判定値 * 4 / 5
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:一線越えない
	SELECTCASE EXP:ARG:愛情経験
		CASE IS >= 500
			CALL COLORMESSAGE(@"%CALLNAME:ARG%은 당신이 자신의 말을 지킬 만한 신뢰할 수 있는 %PRINT_MALE("man", MASTER)%라고 확신한다.",C_PINK,1,1)
			理性判定値 = 理性判定値 / 3
		CASE IS >= 300
			CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 당신을 %HIS_HER(ARG)% 파트너로 생각하지만, 그 정도까지 갈 준비가 되어 있지 않다...",C_PINK,1,1)
			理性判定値 = 理性判定値 * 11 / 10
		CASE IS >= 100
			CALL COLORMESSAGE(@"%CALLNAME:ARG%는 가까운 파트너에게조차 특정한 거리를 유지하고 싶어 한다...",C_PINK,1,1)
			理性判定値 = 理性判定値 * 5 / 4
		CASEELSE
			CALL COLORMESSAGE(@"%CALLNAME:ARG%는 그런 다른 사람을 받아들일 준비가 되어 있지 않다...",C_PINK,1,1)
			理性判定値 = 理性判定値 * 3 / 2
	ENDSELECT
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
IF TALENT:ARG:ツンデレ
	CALL COLORMESSAGE(@"츤데레 반응 체크...",C_YELLOW,1,1)
	IF TALENT:ARG:恋慕
		理性判定値 = 理性判定値 * 2 / 3
		CALL COLORMESSAGE(@"%CALLNAME:ARG%가 당신에게 아첨하고 있어!",C_PINK,1,1)
	ELSE
		理性判定値 = 理性判定値 * 3 / 2
		CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 적대감을 느끼며 움츠러든다.",C_PINK,1,1)
	ENDIF
	CALL SHOW_REASONWALL(理性判定値)
ENDIF
WAIT
IF CHK_HININ_LOVE(ARG) > 理性判定値
	PRINTFORML 
	TCVAR:ARG:外に出すから = 1
	CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,12,0)
	CALL COLORMESSAGE(@"사정하지 않고 질 밖으로 빼기만 한다면 보호 장비 없이 성관계를 가질 수 있는 허가를 받았다!",C_GREEN,2,1)
ELSE
	CALL KOJO_MESSAGE_SEND("EVENT",18,TARGET,13,0)
	PRINTFORMW %BREAKENG(@"설득력 있는 주장에도 불구하고, %CALLNAME:ARG%은 당신의 제안을 거절하고 만약 %HIM_HER(ARG)%와 성관계를 원한다면 보호 장구를 사용하라고 요구한다...")%
	;custom - instead of getting angry, you simply get barred from doing this again when failed as a punishment
	;can't press on, you either get it or don't, the requirements are already lack as they are
	TCVAR:ARG:挿入拒絶 = 1
	RETURN -1
ENDIF
SIF TCVAR:ARG:外に出すから
	CALL COLORMESSAGE(@"결정적인 순간 전에 주의를 기울이고 제때 꺼내자!",C_YELLOW,2,1)
