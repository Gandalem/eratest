	;Custom code
	IF !nGlobalStableBypass && !TALENT:ARG:HYPERFERTILE ;qol custom code
		;CFLAG:産休タイプ=-1以外の仕事情報がCSV定義済キャラは産休に入る
		IF CFLAG:ARG:産休タイプ > -1 && CFLAG:ARG:産休中 == 0 && CSTR:ARG:3 != ""
			PRINTFORMW 아기를 위험에 빠뜨릴 수도 있어서, %HE_SHE(ARG)%은 그것이 끝날 때까지 모성 휴가를 가기로 결정했다...
			CFLAG:ARG:産休中 = 1
		ENDIF
	ENDIF
	;Custom code, egg laying.
ELSEIF (CFLAG:ARG:妊娠経過日数 == 60 || TALENT:ARG:NESTING == 60) && (!CFLAG:ARG:出産経過日 || CFLAG:ARG:出産経過日 >= CHILD_離乳)
	DRAWLINE
	IF TALENT:ARG:バストサイズ < 2
		TALENT:ARG:バストサイズ += 1
		PRINTFORMW %CALLNAME:ARG%의 가슴이 커졌다.
		CFLAG:ARG:乳ランクアップ ++
	ENDIF
	IF !TALENT:ARG:母乳体質
		PRINTFORMW %CALLNAME:ARG%가 수유를 시작했다.
		TALENT:ARG:母乳体質 = 1
	ENDIF
	SIF TALENT:ARG:NESTING
		RETURN
	PRINTFORML 멀리서도 %CALLNAME:ARG%가 임신 중인 것은 알 수 있다...
	IF !CFLAG:ARG:無自覚妊娠 && CFLAG:ARG:産休タイプ == 2
		PRINTFORML %HE_SHE(ARG,1)%은 비합리적으로 고집을 부리지 않기에 %HE_SHE(ARG)%는 일을 쉬기로 결정한다...
		CFLAG:ARG:産休中 = 1
	ELSEIF CFLAG:ARG:無自覚妊娠
		PRINTFORML %CALLNAME:ARG%는 임신 때문에 지쳐 있다, %HE_SHE(ARG)%는 그것을 모른 채로...
		IF CFLAG:ARG:産休タイプ == 1 || CFLAG:ARG:産休タイプ == 0
			PRINTFORMW %HE_SHE(ARG,1)%은(는) %HE_SHE(ARG)%의 임신을 깨닫고, 휴가를 내기로 결정한다...
			CFLAG:ARG:産休中 = 1
		ENDIF
		;自分を騙せずに妊娠していることを自覚する時期とする
		CFLAG:ARG:妊娠自覚状態 = 1
	ENDIF
	BASE:ARG:体力 -= 200
	MAXBASE:ARG:体力 -= 200
	BASE:ARG:気力 -= 200
	MAXBASE:ARG:気力 -= 200
ELSEIF CFLAG:ARG:妊娠経過日数 == 40
	DRAWLINE
	PRINTFORML %CALLNAME:ARG%의 배가 부어있는 것으로 보아 그녀는 분명 임신 상태이다...
	IF !CFLAG:ARG:無自覚妊娠 && CFLAG:ARG:産休タイプ == 1
		LOCALS:0 = 
		IF GROUPMATCH(ARG,96,91,35)
			LOCALS:0 = 천국에서 회의를 하다.
		ELSEIF GROUPMATCH(ARG,134,95,94,76,57,31,22,21,20)
			LOCALS:0 = %GET_JOBNAME_TR(ARG,1)%
		ELSEIF ARG == 17
			LOCALS:0 = 인형극을 진행한다.
		ELSE
			LOCALS:0 = 일하고 있다.
		ENDIF
		PRINTFORML 그녀의 몸에 부담을 주는 것을 피하기 위해 %CALLNAME:ARG%는 잠시 %LOCALS:0%를 중단하기로 결정했다...
		CFLAG:ARG:産休中 = 1
	ELSEIF CFLAG:ARG:無自覚妊娠
		PRINTFORML %CALLNAME:ARG%는 몸이 겪고 있는 변화를 여전히 받아들일 수 없다.
	ENDIF
	BASE:ARG:体力 -= 200
	MAXBASE:ARG:体力 -= 200
	BASE:ARG:気力 -= 200
	MAXBASE:ARG:気力 -= 200
ELSEIF CFLAG:ARG:妊娠経過日数 == 30
	DRAWLINE
	PRINTFORML %CALLNAME:ARG%의 배는 여전히 눈에 잘 띄지 않는다...
	;Custom code
	SIF !nGlobalStableBypass && !TALENT:ARG:HYPERFERTILE ;qol custom code
		PRINTFORMW %CALLNAME:ARG%의 몸은 임신의 안정기에 들어갔다.
	IF !CFLAG:ARG:無自覚妊娠 && CFLAG:ARG:産休タイプ == 0 ;qol custom code, handle 0 for 産休タイプ like everything else, following the original documentation
		LOCALS:1 = 
		IF ARG == 10 || ARG == 11
			LOCALS:1 = 훈련
		ELSEIF ARG == 87
			LOCALS:1 = %GET_JOBNAME_TR(ARG,1)%
		ELSE
			LOCALS:1 = %GET_JOBNAME_TR(ARG,1)%
		ENDIF
		PRINTFORML 그녀의 몸에 부담을 주지 않기 위해, %CALLNAME:ARG%는 잠시 %LOCALS:1%를 쉬기로 결정했다...
		CFLAG:ARG:産休中 = 1
	ELSEIF CFLAG:ARG:無自覚妊娠
		PRINTFORML %CALLNAME:ARG%는 약간의 신체적 불편함을 느끼지만 아직 임신을 눈치채지 못한다.
	ENDIF
	BASE:ARG:体力 -= 100
	MAXBASE:ARG:体力 -= 100
	BASE:ARG:気力 -= 100
	MAXBASE:ARG:気力 -= 100
ELSEIF CFLAG:ARG:妊娠経過日数 == 20
	DRAWLINE
	PRINTFORMW %PARSE("you",,,ARG)%에게 무슨 일이 일어났다...
	PRINTFORML %PARSE("Your",,,ARG)%의 몸이 지금 %BABYCONDSTR("a ",ARG,1)%%BABYPLNOUN("child",ARG)%를 품고 있다.
	PRINTFORMW %PARSE("You are",,,ARG)%는 이제 진정으로 「임신」했다!
	TALENT:ARG:妊娠 = 1
	IF TALENT:ARG:妊娠願望
		TALENT:ARG:妊娠願望 = 0
		PRINTFORMW 더 이상 %PARSE("You",,,ARG)%이 아니며 [%PARSE("Desire",,,ARG)% 임신]이다.
	ENDIF
	CALL CHANGE_N_STATUS(ARG)
	;自覚で分岐
	IF CFLAG:ARG:身に覚え_母 == 1 && !CFLAG:ARG:無自覚妊娠
		PRINTFORML %PARSE("You have",,,ARG)%이/가 %PARSE("your",5,,ARG)%의 몸에서 약간의 불편함을 느끼기 시작했다.
		;Custom code
		SIF !nGlobalStableBypass && !TALENT:ARG:HYPERFERTILE ;qol custom code
			PRINTFORML %PARSE("you've",5,,ARG)%이 안정기에 들어갈 때까지 무모한 행동은 피하는 것이 좋을 것이다...
		IF TALENT:ARG:恋慕
			PRINTFORMW %CALLNAME:ARG%은(는) 부끄러워 당신의 아이를 임신했다고 말한다.
			CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,1,0)
		ELSEIF TALENT:ARG:思慕
			PRINTFORMW %CALLNAME:ARG%는 당신에게 당신의 아이를 임신했다고 말하면서 긴장한다.
			CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,2,0)
			;CFLAG:ARG:妊娠経過日数 = 2
		ELSE
			PRINTFORMW %CALLNAME:ARG%는(은) 당신에게 자신의 아이를 임신했다고 말하면서 약간의 혼란과 당혹감을 보인다.
			CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,3,0)
			;CFLAG:ARG:妊娠経過日数 = 1
		ENDIF
		;36=お燐 を64=勇儀 に変更。勇儀には産休も設定
		;SIF ARG == 10 || ARG == 36
		IF ARG == 10 || ARG == 64
			PRINTFORMW %CALLNAME:ARG%은(는) 출산할 때까지 술을 끊기로 결정한다.
			SIF ARG == 64
				CFLAG:ARG:産休中 = 1
		ENDIF
		;自覚射精があるので妊娠していることはすぐに自覚する
		CFLAG:ARG:妊娠自覚状態 = 1
	ELSE
		PRINTFORMW 하지만, %CALLNAME:ARG%은(는) 자신의 몸 안에서 무슨 일이 일어나고 있는지 전혀 모른다...
		CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,4,0)
	ENDIF
ENDIF

@MasterPregnancy
#DIM C_ID
VARSET LOCAL
;妊娠オフなら飛ばす
SIF !nPreggo ; now global
	RETURN
;男なら飛ばす
SIF TALENT:MASTER:性別 == 2
	RETURN
;もう妊娠してたら飛ばす
SIF CFLAG:MASTER:妊娠経過日数
	RETURN
;キャラ順ランダマイズ
CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)
FOR LOCAL , 0 , CHARANUM - 1
C_ID = SHAFFLE_ARRAY:LOCAL + 1
SIF !nInsemination:MASTER:C_ID
	CONTINUE
SIF TALENT:C_ID:行きずり
	CONTINUE
;ここで妊娠判定、つくってないからコメントアウトしとく。
;TCVAR:種付け自覚があったらCFLAG:身に覚え_父 = 1しておいてね。
;CALL あなた妊娠判定(C_ID)
;↑ので妊娠したらループ中断
SIF CFLAG:MASTER:妊娠経過日数
	BREAK
CALL GET_CHILD(MASTER,C_ID)
NEXT
