		PRINTFORML %HE_SHE(ARG,1)% is not unreasonably stubborn, so %HE_SHE(ARG)% decides to take a break from work...
		CFLAG:ARG:産休中 = 1
	ELSEIF CFLAG:ARG:無自覚妊娠
		PRINTFORML %CALLNAME:ARG% is tired from the pregnancy %HE_SHE(ARG)% isn't aware of...
		IF CFLAG:ARG:産休タイプ == 1 || CFLAG:ARG:産休タイプ == 0
			PRINTFORMW %HE_SHE(ARG,1)% realizes %HE_SHE(ARG)%'s pregnant, and decides to take a break from work...
			CFLAG:ARG:産休中 = 1
		ENDIF
		;自分を騙せずに妊娠していることを自覚する時期とする
		CFLAG:ARG:妊娠自覚状態 = 1
	ENDIF
		
	BASE:ARG:体力 -= 200
	MAXBASE:ARG:体力 -= 200
	BASE:ARG:気力 -= 200
	MAXBASE:ARG:気力 -= 200	


ELSEIF CFLAG:ARG:妊娠経過日数 == 40
	DRAWLINE
	PRINTFORML The swelling of %CALLNAME:ARG%'s belly shows she's clearly pregnant...
	IF !CFLAG:ARG:無自覚妊娠 && CFLAG:ARG:産休タイプ == 1
		PRINTFORM To avoid burdening her body %CALLNAME:ARG% has decided to stop 
		IF GROUPMATCH(ARG,96,91,35)
			PRINTFORM having meetings in Heaven
		ELSEIF GROUPMATCH(ARG,134,95,94,76,57,31,22,21,20)
			PRINTFORM %GET_JOBNAME_TR(ARG,1)%
 		ELSEIF ARG == 17
			PRINTFORM hosting puppet shows
		ELSE
			PRINTFORM working
		ENDIF
		PRINTFORML  for a while...
		CFLAG:ARG:産休中 = 1
	ELSEIF CFLAG:ARG:無自覚妊娠
		PRINTFORML %CALLNAME:ARG% still cannot accept the changes her body is going through.
	ENDIF
	BASE:ARG:体力 -= 200
	MAXBASE:ARG:体力 -= 200
	BASE:ARG:気力 -= 200
	MAXBASE:ARG:気力 -= 200


ELSEIF CFLAG:ARG:妊娠経過日数 == 30
	DRAWLINE
	PRINTFORML The swelling of %CALLNAME:ARG%'s belly is still inconspicuous...
	;Custom code
	SIF !nGlobalStableBypass && !TALENT:ARG:HYPERFERTILE ;qol custom code
	PRINTFORMW %CALLNAME:ARG%'s body has entered the stable period of the pregnancy.
	IF !CFLAG:ARG:無自覚妊娠 && CFLAG:ARG:産休タイプ == 0 ;qol custom code, handle 0 for 産休タイプ like everything else, following the original documentation
		PRINTFORM To avoid burdening her body, %CALLNAME:ARG% decides to take a break from 
		IF ARG == 10 || ARG == 11
			PRINTFORM training
		ELSEIF ARG == 87
			PRINTFORM %GET_JOBNAME_TR(ARG,1)%
		ELSE
			PRINTFORM %GET_JOBNAME_TR(ARG,1)%
		ENDIF
		PRINTFORML  for a while...
		CFLAG:ARG:産休中 = 1
	ELSEIF CFLAG:ARG:無自覚妊娠
		PRINTFORML %CALLNAME:ARG% feels some physical discomfort, but hasn't noticed her pregnancy yet.
	ENDIF
	BASE:ARG:体力 -= 100
	MAXBASE:ARG:体力 -= 100
	BASE:ARG:気力 -= 100
	MAXBASE:ARG:気力 -= 100
ELSEIF CFLAG:ARG:妊娠経過日数 == 20
	DRAWLINE
	PRINTFORMW Something has happened to %PARSE("you",,,ARG)%...
	PRINTFORML %PARSE("Your",,,ARG)% body now carries %BABYCONDSTR("a ",ARG,1)%%BABYPLNOUN("child",ARG)%.
	PRINTFORMW %PARSE("You are",,,ARG)% now truly [Pregnant]!
	TALENT:ARG:妊娠 = 1
	IF TALENT:ARG:妊娠願望
		TALENT:ARG:妊娠願望 = 0
		PRINTFORMW %PARSE("You",,,ARG)% no longer [%PARSE("Desire",,,ARG)% Pregnancy]
	ENDIF
	CALL CHANGE_N_STATUS(ARG)

	;自覚で分岐
	IF CFLAG:ARG:身に覚え_母 == 1 && !CFLAG:ARG:無自覚妊娠
		PRINTFORML %PARSE("You have",,,ARG)% started feeling some discomfort with %PARSE("your",5,,ARG)% body.
		;Custom code
		SIF !nGlobalStableBypass && !TALENT:ARG:HYPERFERTILE ;qol custom code
			PRINTFORML It would be a good idea to avoid doing reckless things until %PARSE("you've",5,,ARG)% entered the stable period...
		IF TALENT:ARG:恋慕
			PRINTFORMW %CALLNAME:ARG% bashfully tells you she's carrying your unborn child.
			CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,1,0)
		ELSEIF TALENT:ARG:思慕
			PRINTFORMW %CALLNAME:ARG% is nervous as she tells you she's carrying your unborn child.
			CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,2,0)
			;CFLAG:ARG:妊娠経過日数 = 2
		ELSE
			PRINTFORMW %CALLNAME:ARG% shows some confusion and embarrassment as she tells you she's carrying your unborn child.
			CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,3,0)
			;CFLAG:ARG:妊娠経過日数 = 1
		ENDIF
		;36=お燐 を64=勇儀 に変更。勇儀には産休も設定
		;SIF ARG == 10 || ARG == 36
		IF ARG == 10 || ARG == 64
			PRINTFORMW %CALLNAME:ARG% decides to refrain from drinking until she's given birth...
			SIF ARG == 64
				CFLAG:ARG:産休中 = 1
		ENDIF
		;自覚射精があるので妊娠していることはすぐに自覚する
		CFLAG:ARG:妊娠自覚状態 = 1
	ELSE
		PRINTFORMW However, %CALLNAME:ARG% is oblivious to what's going on inside her body...
		CALL KOJO_MESSAGE_SEND("EVENT",24,ARG,4,0)
	ENDIF
ENDIF

@MasterPregnancy
#DIM C_ID
VARSET LOCAL
;妊娠オフなら飛ばす
SIF !nPreggo ; now global
	RETURN
;男なら飛ばす
SIF TALENT:MASTER:性別 == 2
	RETURN
;もう妊娠してたら飛ばす
SIF CFLAG:MASTER:妊娠経過日数
	RETURN
;キャラ順ランダマイズ
CALL FISHER_YATES_SHAFFLE(CHARANUM - 1)

FOR LOCAL , 0 , CHARANUM - 1
	C_ID = SHAFFLE_ARRAY:LOCAL + 1
	SIF !nInsemination:MASTER:C_ID
		CONTINUE
	SIF TALENT:C_ID:行きずり
		CONTINUE
	;ここで妊娠判定、つくってないからコメントアウトしとく。
	;TCVAR:種付け自覚があったらCFLAG:身に覚え_父 = 1しておいてね。
	;CALL あなた妊娠判定(C_ID)
	;↑ので妊娠したらループ中断
	SIF CFLAG:MASTER:妊娠経過日数
		BREAK
	
	CALL GET_CHILD(MASTER,C_ID)	
NEXT