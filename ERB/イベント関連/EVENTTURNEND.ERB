@RANK_POINT
VARSET LOCAL
;清潔度
LOCAL:2 = EX:MASTER:今日の掃除回数 / 10
PRINTFORML 쓰레기 청소 완료: {EX:MASTER:今日の掃除回数}
PRINTFORM 청소 보너스: %金額表示(LOCAL:2)%
IF DAY:2 == 4 && DAY:3 == 31
	PRINT (x2) 【봄맞이 대청소 보너스】
	LOCAL:2 *= 2
ENDIF
PRINTL
;拠点の主の好感度と信頼度が上昇
LOCAL:3 = MIN(10, EX:MASTER:今日の掃除回数 / 2000)
;can't clean or gain favorability with yourself
IF LOCAL:3 && 拠点_大家 != MASTER
	PRINTFORML 청소에 기울인 노력 덕분에 %CALLNAME:拠点_大家%의 당신에 대한 의견이 높아졌다.
	CFLAG:拠点_大家:好感度 += LOCAL:3 * 2
	CFLAG:拠点_大家:信頼度 += LOCAL:3
	IF LOCAL:3 / 3 > 0 && ITEM:安物食材 < 所持数制限 ;qol custom code
		LOCAL:10 = MIN(LOCAL:3 / 3, 所持数制限 - ITEM:安物食材)
		PRINTFORML 보너스로 {LOCAL:10} 값싼 식재료를 받는다.
		ITEM:安物食材 += LOCAL:10
	ENDIF
ENDIF
PRINTL  
;手伝い報酬
LOCAL:4 = TCVAR:MASTER:手伝った量
SIF LOCAL:4 > 0
	PRINTFORML 보조 보너스 %金額表示(LOCAL:4)%
MONEY += LOCAL:2 + LOCAL:4
;好感度上昇
IF FLAG:12 && MONEY:2 < CM_LIMIT
	LOCAL:5 = MAX(1,FLAG:12 / 100)
	LOCAL:5 = MIN(LOCAL:5, CM_LIMIT - MONEY:2)
	PRINTFORML 호의 증가 보너스 +{LOCAL:5} 카리스마
	MONEY:2 += LOCAL:5
	PRINTFORML 현재 카리스마: %三桁区切(MONEY:2)% 카리스마 한계: %三桁区切(CM_LIMIT)%
ENDIF
