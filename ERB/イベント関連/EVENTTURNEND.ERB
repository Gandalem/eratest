		PRINTFORMW You think about how nice it would be to \@ TALENT:LOCAL:風俗嬢 ? play with#see\@ %CALLNAME:LOCAL% again.
	ELSEIF RESULT == 2
		PRINTFORMW You completely forget about %CALLNAME:LOCAL% and the other's existence
		BREAK 
	ELSE
		$FORGET_MOB
		PRINTFORMW You completely forget about %CALLNAME:LOCAL%'s existence.
	ENDIF
	$FORGET_MOB2
	IF TALENT:LOCAL:行きずり == 2
		VARSET TCVAR:LOCAL:0, 0
		VARSET EX:LOCAL:0, 0
		VARSET TEQUIP:LOCAL:0, 0
		VARSET PALAM:LOCAL:0, 0
		CALL InitializeBeforeTrain(LOCAL)
		;SAVECHARA TOSTR(CFLAG:LOCAL:モブ子セーブスロット), CSTR:LOCAL:モブ子プロフィール１, LOCAL
		[IF DEBUG]
			PRINTFORMW Information about %CALLNAME:LOCAL% has been updated.
		[ENDIF]
	ENDIF
	CALL ADDCHARA_INIT(CSV_CHARANUM())
	COPYCHARA CHARANUM-1, LOCAL
	DELCHARA CHARANUM-1
NEXT
CALLF KILL_ALL_MOBS()

