@DATE_EVENT(ARG)
#DIM 珠不足
#DIM 経験不足
;qol custom replace
CALL DATE_EVENT_TR(ARG)
RETURN RESULT
VARSET LOCAL
;キャンセルフラグ（外部参照にて使用のこと 例:LOCAL@DATE_EVENT:99 = 1
LOCAL:99 = 0
;パラメータによる発生基礎値生成
LOCAL = MARK:ARG:不埒刻印 * 10 + MARK:ARG:快楽刻印 * 10
IF TALENT:ARG:恋慕
	LOCAL += MIN(ABL:ARG:親密 * 10, 100) + MIN(ABL:ARG:欲望 * 10,100) + MIN(ABL:ARG:奉仕精神 * 10,100)
	LOCAL += MIN(EXP:ARG:デート経験,100) + MIN(EXP:ARG:愛情経験,100)
ELSEIF TALENT:ARG:思慕
	LOCAL += MIN(ABL:ARG:親密 * 10, 50) + MIN(ABL:ARG:欲望 * 10,50) + MIN(ABL:ARG:奉仕精神 * 10,50)
	LOCAL += MIN(EXP:ARG:デート経験,50)
ENDIF
LOCAL += GETPALAMLV(PALAM:ARG:欲情,10) * 5 + GETPALAMLV(PALAM:ARG:好意,10) * 5 + GETPALAMLV(PALAM:ARG:恭順,10) * 5
;60
LOCAL += BASE:ARG:ムード / 50 + (1000 - BASE:ARG:理性) / 30
LOCAL += TALENT:ARG:度胸 * 10 + TALENT:ARG:性的興味 * 10 - TALENT:ARG:自制心 * 10 - TALENT:ARG:無関心 * 10
DEBUGPRINTFORML 【DATE_EVENT({ARG})} DateEvent_Checksum은 {LOCAL}이다.
;別れ際にプレゼント
CALL GIFT(ARG)
IF RESULT == 1
	;合意無し（キス成功してない）
ELSEIF !(CFLAG:ARG:1 & 1) && !(CFLAG:ARG:13 & 1)
	;成功判定
	IF (LOCAL > 220 + FuckReserved(ARG) * 30 + ABS(TALENT:ARG:キス未経験 * 20)) && CFLAG:ARG:合意判定 > 180 && (TALENT:ARG:思慕 || TALENT:ARG:恋慕)
		CALL KOJO_MESSAGE_SEND("SP_EVENT",1,ARG,0)
		;キャンセルフラグ
		IF !TCVAR:ARG:キスキャンセル
			CALL ADD_KISS(ARG)
			SETBIT CFLAG:ARG:デート後イベントフラグ , 0
		ENDIF
	ELSEIF !MARK:ARG:反発刻印
		CALL KOJO_MESSAGE_SEND("SP_EVENT",3,ARG,0)
	ENDIF
	;反発刻印消去処理
ELSEIF MARK:ARG:反発刻印 && LOCAL > 50
	;ABL:親密LVUP処理取り込み。解読が面倒だったので要所々々取り摘んで…
	FOR LOCAL,0,4
	珠不足 = 0
	経験不足 = 0
	SIF JUEL_DEMAND(9,LOCAL,0,ARG) == -2
		BREAK
	SIF JUEL_DEMAND(9,LOCAL,0,ARG) < 0
		CONTINUE
	;必要な宝珠を探す
	FOR LOCAL:1,0,100
	IF JUEL_DEMAND(9,LOCAL,LOCAL:1,ARG) > 0
		IF JUEL:(ARG):(LOCAL:1) < JUEL_DEMAND(9,LOCAL,LOCAL:1,ARG) / 2
			珠不足 ++
			BREAK
		ENDIF
	ENDIF
	NEXT
	SIF 珠不足
		CONTINUE
	;必要な経験を探す
	FOR LOCAL:1,0,100
	IF EXP_DEMAND(9,LOCAL,LOCAL:1,ARG) > 0
		IF EXP:(ARG):(LOCAL:1) < EXP_DEMAND(9,LOCAL,LOCAL:1,ARG) / 2
			経験不足 ++
			BREAK
		ENDIF
	ENDIF
	NEXT
	SIF 経験不足
		CONTINUE
	;ここまで来れたら反発刻印消去
	;要するにデートでいい雰囲気＋親密LVUP水準の1/2満たしたら反発消去
	MARK:ARG:反発刻印 --
	CALL KOJO_MESSAGE_SEND("SP_EVENT",3,ARG,(MARK:ARG:反発刻印 + 1))
	PRINTL
	IF MARK:ARG:反発刻印
		PRINTFORMW %CALLNAME:ARG%의 {MARK:ARG:反発刻印} 증오 마크가 낮아졌다!
	ELSE
		PRINTFORMW %CALLNAME:ARG%의 레벨 1 증오 낙인이 제거되었다!
	ENDIF
	BREAK
	NEXT
	;告白していない（MASTERに恋人が居ない）
ELSEIF !(CFLAG:ARG:1 & 4) && !(CFLAG:ARG:13 & 2) &&  !FLAG:告白禁止 && CAN_MAKE_恋人()
	;成功判定
	IF (LOCAL > 530 + FuckReserved(ARG) * 20)
		CALL Qol_ConfessionQuestion(ARG) ;qol custom code
		;贈り物イベント
	ELSEIF GIFT_DATE_CHECK(ARG)
		CALL GIFT_DATE_EVENT(ARG)
	ELSEIF GROUPMATCH(TALENT:ARG:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) && IS_FALLEN(ARG) && EGG_GIFT_DATE_CHECK(ARG)
		CALL EGG_GIFT_DATE_EVENT(ARG)
	ELSEIF !MARK:ARG:反発刻印
		CALL KOJO_MESSAGE_SEND("SP_EVENT",3,ARG,0)
	ENDIF
	;贈り物イベント
ELSEIF GIFT_DATE_CHECK(ARG)
	CALL GIFT_DATE_EVENT(ARG)
ELSEIF GROUPMATCH(TALENT:ARG:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) && IS_FALLEN(ARG) && EGG_GIFT_DATE_CHECK(ARG)
	CALL EGG_GIFT_DATE_EVENT(ARG)
ELSE
	CALL KOJO_MESSAGE_SEND("SP_EVENT",3,ARG,0)
ENDIF

@GIFT(ARG)
#DIM 好感度上昇値
#DIM プレゼント評価
;デート前好感度と現好感度を比較
好感度上昇値 = TCVAR:ARG:Date_Favorability_Gain ;qol custom code, use TCVAR to avoid Favorability cap
TCVAR:ARG:Date_Favorability_Gain = 0 ;qol custom code, reset value
IF DAY:2 == 4 && DAY:3 == 24 && ITEM:94 && TFLAG:デート前好感度
	PRINTFORML 크리스마스 선물을 건다?
	CALL ASK_YN
	IF !RESULT
		PRINTFORMW 당신은 %CALLNAME:ARG%에게 선물을 준다.
		ITEM:94 = 0
		IF TALENT:ARG:恋人
			PRINTFORMW %CALLNAME:ARG%의 얼굴이 금세 붉어진다.
			PRINTFORMW ...%CALLNAME:ARG%가 당신의 뺨에 입을 맞춘다.
			プレゼント評価 = 10
		ELSEIF TALENT:ARG:恋慕
			PRINTFORMW %CALLNAME:ARG%의 얼굴이 금세 붉어진다.
			PRINTFORMW %CALLNAME:ARG%는 그런 선물을 받게 되어 매우 기뻐한다.
			プレゼント評価 = 7
		ELSEIF TALENT:ARG:思慕
			PRINTFORML 비록 %CALLNAME:ARG%에게는 약간 놀라운 일이지만, %HE_SHE(ARG)%은 선물을 받게 되어 기쁘다.
			PRINTFORML 이렇게 %HIM_HER(ARG)%에게 직접 선물을 준 것은 %CALLNAME:ARG%이 당신을 향한 %HIS_HER(ARG)%의 감정에 대해 더 의식하게 만들었다.
			プレゼント評価 = 5
		ELSE
			PRINTFORMW %CALLNAME:ARG%는 그렇게 비싼 선물을 받아서 당황하지만, %HE_SHE(ARG)%는 불만족스러워 보이지 않는다.
			プレゼント評価 = 2
		ENDIF
		;CFLAG:ARG:2 += 好感度上昇値 * プレゼント評価 / 5
		;CFLAG:ARG:4 += 好感度上昇値 * プレゼント評価 / 10
		;custom code
		CALL CHANGE_CFLAG(2, ARG, 好感度上昇値 * プレゼント評価 / 5)
		CALL CHANGE_CFLAG(4, ARG, 好感度上昇値 * プレゼント評価 / 10)
		RETURN 1
	ELSE
		RETURN 0
	ENDIF
ELSE
	RETURN 0
ENDIF

@WITH_恋人(ARG)
#FUNCTION
;恋人の何人とARGが同じ場所に居るかを返す
VARSET LOCAL
SIF ARG == 0
	ARG = MASTER
FOR LOCAL,1,CHARANUM
SIF CFLAG:LOCAL:現在位置 == CFLAG:ARG:現在位置 && TALENT:LOCAL:恋人
	LOCAL:1 ++
NEXT
RETURNF LOCAL:1

@CAN_MAKE_恋人()
#FUNCTION
IF MORELOVER
	RETURNF 1
ELSEIF TALENT:MASTER:ポリアモリー
	RETURNF 1
ELSEIF INRANGECARRAY(TALENT:恋人, 1, CHARANUM, 1, CHARANUM) <= FLAG:追加恋人枠
	RETURNF 1
ELSE
	RETURNF 0
ENDIF
;===========================================
;キス経験やファーストキス処理などをまとめてやる関数
;===========================================

@ADD_KISS(ARG, ARG:1 = 1, ARG:2 = 0) ;custom code
IF TALENT:MASTER:キス未経験
	CALL SET_FIRSTKISS(MASTER, ARG, ARG:2 == 0 ? 1 # 0) ;custom code, mutual kiss returns 1, so it's set to outside of date (0), on date by default (1)
	CALL AddEXP("愛情経験", ARG, 10) ;custom code
ENDIF
IF TALENT:ARG:キス未経験
	CALL SET_FIRSTKISS(ARG, MASTER, ARG:2 == 0 ? 1 # 0) ;custom code
	CALL AddEXP("愛情経験", ARG, 10) ;custom code
ENDIF
CALL AddEXP("キス経験", ARG, ARG:1) ;custom code
CALL AddEXP("キス経験", MASTER, ARG:1) ;custom code
SETBIT CFLAG:ARG:既成事実 , 0
Qol_Info_Count_Array:ARG:Qol_Count_Kiss ++ ;qol custom code
SIF !SHIRAHU(ARG)
	Qol_Info_Count_Array:ARG:Qol_Count_UncKiss ++ ;qol custom code
