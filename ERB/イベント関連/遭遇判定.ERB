; Modular ERB: 遭遇判定.ERB

@遭遇判定
#DIM 基本遭遇率
#DIM 遭遇率
遭遇率 = 0
CVARSET CFLAG, GETNUM(CFLAG, "遭遇位置")
;出禁人数が多いほど遭遇率は高くなる（あんまり密にならないようにする）
;※従来は低いほど遭遇しやすかったけど分かりにくいんで直感的％に,全体的にやや上方修正
SELECTCASE (FLAG:出禁人数 * 100 / CHARANUM)
	CASE IS >= 60
		基本遭遇率 = 45
	CASE IS >= 45
		基本遭遇率 = 42
	CASE IS >= 30
		基本遭遇率 = 40
	CASE IS >= 15
		基本遭遇率 = 38
	CASE IS >= 10
		基本遭遇率 = 35
	CASEELSE
		基本遭遇率 = 33
ENDSELECT
;連動設定もあるのでこの処理は出禁キャラも行う
FOR LOCAL, 1, CHARANUM
;自宅在住キャラは遭遇しない
SIF CFLAG:LOCAL:神社在住
	CONTINUE
SIF TALENT:LOCAL:行きずり
	CONTINUE
IF !(CFLAG:LOCAL:拠点来訪 && CFLAG:LOCAL:宴会参加)
	遭遇率 = 基本遭遇率 + TALENT:LOCAL:思慕 * 3 + TALENT:LOCAL:恋慕 * 6 + CFLAG:LOCAL:依頼状況 * 6
	SIF 遭遇率 > RAND:100 || (SaveIsEZB && !LoG_RivalWins(LoG_RivalID(LOCAL)))
		CALL 遭遇フラグ決定(LOCAL)
ENDIF
NEXT
;全キャラ決定後、連動キャラを設定する
FOR LOCAL, 1, CHARANUM
VARSET RESULT
;addition custom code, for custom charadata movement
CALL KOJO_CHECK(LOCAL, "CHARADATA", "MOVE", 1)
IF RESULT == -1 ;do nothing
	VARSET RESULT
ELSEIF RESULT || RESULT:1 ;use these values
ELSE
	TRYCALLFORM CHARAMOVE_DATA_{NO:LOCAL}(1)
ENDIF
;依存連動
IF RESULT
	CFLAG:LOCAL:遭遇位置 = CFLAG:RESULT:遭遇位置
	;対等連動
ELSEIF RESULT:1
	;連動設定する
	;NAS: nonexistant characters
	SIF 連動キャラ設定(RESULT:1, RESULT:2, RESULT:3)  >= CHARANUM
		CONTINUE
	CFLAG:LOCAL:遭遇位置 = CFLAG:連動キャラ設定(RESULT:1, RESULT:2, RESULT:3):遭遇位置
ENDIF
NEXT
[IF_DEBUG]
PRINTL 【오늘의 위치】*디버깅 목적으로
FOR LOCAL, 1, CHARANUM
IF CFLAG:LOCAL:遭遇位置
	PRINTFORM %CALLNAME:LOCAL, 18, LEFT%%NAME_FROM_PLACE(CFLAG:LOCAL:遭遇位置)%
	VARSET RESULT
	;addition custom code, for custom charadata movement
	CALL KOJO_CHECK(LOCAL, "CHARADATA", "MOVE", 1)
	IF RESULT == -1 ;do nothing
		VARSET RESULT
	ELSEIF RESULT || RESULT:1 ;use these values
	ELSE
		TRYCALLFORM CHARAMOVE_DATA_{NO:LOCAL}(1)
	ENDIF
	IF RESULT
		PRINTFORM (%CALLNAME:RESULT%를 따라)
	ELSEIF RESULT:1
		PRINTFORM (%CALLNAME:(RESULT:1)%%COND_STR(@", %CALLNAME:(RESULT:2)%", RESULT:2)%%COND_STR(@", %CALLNAME:(RESULT:3)%", RESULT:3)%과 그룹화됨)
	ENDIF
	PRINTL 
ENDIF
NEXT
SIF !benchMarkStart
	WAIT
[ENDIF]
;-----------------------------------------------------------
;キャラの遭遇位置を設定する関数
;-----------------------------------------------------------

@遭遇フラグ決定(CHARA)
#DIM CHARA
#DIM P_ID
#DIM LPCOUNT
VARSET LOCAL
;LoG custom code
IF SaveIsEZB
	IF !LoG_RivalCanAppear(CHARA)
		CFLAG:CHARA:遭遇位置 = SUKIMA()
		RETURN
	ENDIF
	CALLF WakeUp(CHARA)
	; LOCAL = 2
	$RedoLoGRandRoom
	CFLAG:CHARA:遭遇位置 = RAND(MINROOM()+1,MAXROOM)
	SIF !STRLENS(STR_TR(CFLAG:CHARA:遭遇位置+8000))
		GOTO RedoLoGRandRoom
	SIF !MAP_CAN_MOVE_2(CFLAG:CHARA:遭遇位置,MASTER)
		GOTO RedoLoGRandRoom
	RETURN
ENDIF
;/////////////////
;最初に出現タイプを決定,他のタイプになったらその位置には出現しないように
;自宅位置：よく行く地域：その他＝１：２：１
WHILE !LOCAL
SELECTCASE RAND:1000
	CASE IS < 250
		;自宅位置はそのまま決定
		IF CFLAG:CHARA:自宅位置
			LOCAL = 1
			CFLAG:CHARA:遭遇位置 = CFLAG:CHARA:自宅位置
			RETURN
		ENDIF
	CASE IS < 750
		SIF CFLAG:CHARA:よく行く地域 >= 0 && CFLAG:CHARA:よく行く地域 != MAIN_MAP
			LOCAL = 2
	CASEELSE
		LOCAL = 3
ENDSELECT
WEND
LPCOUNT = 0
;遭遇位置の決定
WHILE 1
LPCOUNT ++
P_ID = RANDOM_ODEKAKE()
;よく行く地域に自宅しかない、よく行く地域しか行かない場合は無限ループになるので100で妥協する
IF LPCOUNT < 100
	;自宅位置はなるべく行かない
	IF P_ID == CFLAG:CHARA:自宅位置
		CONTINUE
		;よく行く地域の場合,よく行く地域以外には行かない
	ELSEIF LOCAL == 2
		SIF GET_MAPID(P_ID) != CFLAG:CHARA:よく行く地域
			CONTINUE
		;その他の地域の場合,よく行く地域にはなるべく行かない
	ELSE
		SIF GET_MAPID(P_ID) == CFLAG:CHARA:よく行く地域
			CONTINUE
	ENDIF
ENDIF
;出現場所かチェック
RESULT = 0
;addition custom code, for custom charadata movement
RESULT:1 = 0
CALL KOJO_CHECK(CHARA, "CHARADATA", "MOVE", 7, P_ID)
IF RESULT
	RESULT = RESULT:1
ELSE
	;addition custom code, duplicated characters
	TRYCALLFORM CHARAMOVE_DATA_{NO:CHARA}(7, P_ID)
ENDIF
SIF !RESULT && EXISTFUNCTION(@"CHARAMOVE_DATA_{NO:CHARA}") && LPCOUNT < 1000
	CONTINUE
CFLAG:CHARA:遭遇位置 = P_ID
BREAK
WEND
RETURN
;-----------------------------------------------------------
;キャラが他のキャラに依存した挙動をするのを設定する
;暫定3人まで。遭遇位置でのみ使用されている
;暫定恋慕と思慕のみ（遭遇率に影響があるので）
;同列なら小さい方が優先
;CHARA:1～3  この三人（二人）のうちもっとも評価が高いキャラに依存する
;-----------------------------------------------------------

@連動キャラ設定(CHARA:1, CHARA:2, CHARA:3)
#FUNCTION
#DIM CHARA, 4
;NAS: Non existent character fix
FOR LOCAL, 1, 4
SIF !CHARA:LOCAL || GETCHARA(CHARA:LOCAL) == -1
	BREAK
SIF TALENT:(CHARA:LOCAL):恋慕
	RETURNF CHARA:LOCAL
NEXT
FOR LOCAL, 1, 4
SIF !CHARA:LOCAL || GETCHARA(CHARA:LOCAL) == -1
	BREAK
SIF TALENT:(CHARA:LOCAL):思慕
	RETURNF CHARA:LOCAL
NEXT
;すべて無いならCHARA:1で決定
RETURNF CHARA:1
;-----------------------------------------------------------
;キャラの出現フラグを判定する関数
;=1拠点には来ない =2来る =3 住んでる
;-----------------------------------------------------------

@出現状態(ARG)
#FUNCTION
IF CFLAG:ARG:出禁 || TALENT:ARG:行きずり
	RETURNF 0
ELSEIF CFLAG:ARG:神社在住
	RETURNF 3
ELSEIF CFLAG:ARG:拠点来訪
	RETURNF 2
ELSEIF CFLAG:ARG:宴会参加
	RETURNF 2
ELSEIF !CHARA_HOLIDAY(ARG)
	RETURNF 1
ELSEIF CFLAG:ARG:お招き
	RETURNF 1
ELSEIF CFLAG:ARG:遭遇位置
	RETURNF 1
ELSE
	RETURNF 0
ENDIF
;-----------------------------------------------------------
;OPTIONから呼ばれるキャラの出現場所リスト
;-----------------------------------------------------------

@SHOW_APPEAR_LIST
#DIM LPCOUNT
#DIM LPCOUNT2
#DIM LPCOUNT3
#DIM P_ID
#DIM MAPID
#DIM メイン保管
メイン保管 = MAIN_MAP
MAIN_MAP = MAXHOME
LPCOUNT3 = 0
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LPCOUNT, 1, EX_CHARANUM
IF FLAG:並び替え
	LOCAL = RESULT:LPCOUNT
	SIF LOCAL < 0
		CONTINUE
ELSE
	LOCAL = LPCOUNT
	SIF LOCAL >= CHARANUM
		BREAK
ENDIF
SIF CFLAG:LOCAL:出禁 ;custom code, skip disabled characters
	CONTINUE
SIF TALENT:LOCAL:行きずり
	BREAK
LPCOUNT3 ++
SIF LPCOUNT3 % 10 == 1
	PRINTFORML 　　 %" ", 18, LEFT% MOVE SHY %SUBSTRING(nameArray:1:na_LastName, 0, 3)%Shr %SUBSTRING(MyouTempleName(), 0, 3)%%SUBSTRING(MyouTempleName(), STRLENS(MyouTempleName())-1, STRLENS(MyouTempleName()))%Tm HumVil %TOUPPER(SUBSTRING(nameArray:16:na_LastName, 0, 1))%DM&Lk BmbFst MagFst Higan MntFt MntTop Hell Moon Makai ＊홈 에어리어
PRINTFORM [{LOCAL,3 }] %CALLNAME:LOCAL, 18, LEFT% {CFLAG:LOCAL:移動率補正, 2} 　
IF CFLAG:LOCAL:移動節度 > 0
	PRINTFORM +{ABS(CFLAG:LOCAL:移動節度), 2, LEFT}　
ELSEIF CFLAG:LOCAL:移動節度 < 0
	PRINTFORM -{ABS(CFLAG:LOCAL:移動節度), 2, LEFT}　
ELSE
	PRINTFORM  0 　
ENDIF
FOR MAPID, 0, MAXHOME
IF MAPID == GET_MAPID(CFLAG:LOCAL:自宅位置) && CFLAG:LOCAL:自宅位置 && CFLAG:LOCAL:自宅位置 != 99
	PRINT 　☆　
ELSEIF MAPID == CFLAG:LOCAL:よく行く地域
	PRINT 　◎　
ELSE
	FOR LPCOUNT2, 1, 11
	P_ID = MAPID * 100 + LPCOUNT2 * 10
	;addition custom code, for custom charadata movement
	RESULT:1 = 0
	CALL KOJO_CHECK(LOCAL , "CHARADATA", "MOVE", 7 , P_ID)
	IF RESULT
		RESULT = RESULT:1
	ELSE
		TRYCALLFORM CHARAMOVE_DATA_{NO:LOCAL}(7, P_ID)
	ENDIF
	IF RESULT
		PRINT 　○　
		BREAK
	ELSEIF LPCOUNT2 == 9
		PRINT 　－　
		BREAK
	ENDIF
	NEXT
ENDIF
PRINT 　
NEXT
PRINTFORM ・%NAME_FROM_PLACE(CFLAG:LOCAL:自宅位置)%
PRINTL 
NEXT
MAIN_MAP = メイン保管
DRAWLINE
PRINTL 이 표는 모든 캐릭터가 등장할 수 있는 지역을 나열한다. 이름을 클릭해도 아무 일도 일어나지 않는다. 일부 캐릭터는 조건에 따라 다를 수 있다.
CALL COLORMESSAGE("LEGEND",C_YELLOW,1,1)
PRINTL 이동: 캐릭터가 홈 에어리어에 있을 때 장소 간 이동 빈도
PRINTL 수줍음: 홈 에어리어에 있을 때 사생활 고려 정도
PRINTL ☆:홈 에어리어　◎:자주 가는 지역　○:나타나는 지점　－:데드 존
PRINTFORML %SUBSTRING(nameArray:1:na_LastName, 0, 3)%Shr - %nameArray:1:na_LastName% 신사, %SUBSTRING(MyouTempleName(), 0, 3)%%SUBSTRING(MyouTempleName(), STRLENS(MyouTempleName())-1, STRLENS(MyouTempleName()))%Tm - %MyouTempleName()% 사원, HumVil - 인간 마을, %TOUPPER(SUBSTRING(nameArray:16:na_LastName, 0, 1))%DM&Lk - %nameArray:16:na_LastName% 악마 저택&호수,
PRINTL BmbFst - 대나무 숲, MagFst - 마법의 숲, Higan - 산즈 강&네더월드, MntFt - 요괴 산기슭
PRINTFORML MntTop - 요괴 산 정상&%nameArray:33:na_LastName% 신사, Hell - 지하세계, Moon - 꿈의 세계&달, Makai - 마카이
PRINTL [  0] [ 0] 귀환
