PRINTFORML 

@欲求不満素質補正(ARG,ARG:1)
#FUNCTION
LOCAL = ARG:1
SIF TALENT:ARG:自制心
	LOCAL /= 2
SIF TALENT:ARG:自己愛 < 0
	LOCAL /= 2
SIF TALENT:ARG:自己愛 > 0
	LOCAL = LOCAL * 5 / 4
SIF TALENT:ARG:幼稚 && !TALENT:ARG:初潮
	LOCAL /= 4
;Custom code
IF !nGlobalStableBypass && !TALENT:ARG:HYPERFERTILE
	SIF TALENT:ARG:妊娠
		LOCAL /= 4
	SIF TALENT:ARG:育児中
		LOCAL /= 2
ENDIF
SIF CFLAG:ARG:オナバレ
	LOCAL /= 4
RETURNF LOCAL
