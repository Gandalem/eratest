		自慰タイプ = 1
	ENDIF
	CALL KOJO_MESSAGE_SEND("EVENT",22,LOCAL,自慰タイプ,部位指定)
	SIF 自慰タイプ == 7
		CONTINUE
	EXP:LOCAL:自慰経験 += ABL:LOCAL:自慰中毒 * 2 + 1
	CALL COLORMESSAGE(@"자위경험 플러스 {ABL:LOCAL:自慰中毒 * 2 + 1}",C_PINK,1)
	SELECTCASE ABL:LOCAL:自慰中毒
		CASE 0 TO 2
			珠入手倍率 = 1
	ENDSELECT
	;快C
	CALL JUEL_UP_SPECIAL(LOCAL,"快Ｃ","Ｃ感覚",珠入手倍率,1)
	SIF 追加Ｖ自慰
		CALL JUEL_UP_SPECIAL(LOCAL,"快Ｖ","Ｖ感覚",珠入手倍率,1)
	SIF 追加Ａ自慰
		CALL JUEL_UP_SPECIAL(LOCAL,"快Ａ","Ａ感覚",珠入手倍率,1)
	SIF 追加Ｂ自慰
		CALL JUEL_UP_SPECIAL(LOCAL,"快Ｂ","Ｂ感覚",珠入手倍率,1)
	;恥情
	CALL JUEL_UP_SPECIAL(LOCAL,"恥情","自慰中毒",珠入手倍率 * 2,1)
	;欲情
	CALL JUEL_UP_SPECIAL(LOCAL,"欲情","欲望",珠入手倍率,1)
	CFLAG:LOCAL:溜まってる度 /= 4
	PRINTW 
ENDIF
;まず欲望で基礎値を決める
SELECTCASE ABL:LOCAL:欲望
	CASE 0 TO 2
		欲求不満度 = 10
	CASE 3 TO 5
		欲求不満度 = 20
	CASE 6 TO 10
		欲求不満度 = 30
	CASE 10 TO 15
		欲求不満度 = 50
	CASEELSE
		欲求不満度 = 80
ENDSELECT
欲求不満度 += ABL:LOCAL:自慰中毒 * 7 + (ABL:LOCAL:膣射中毒 + ABL:LOCAL:肛射中毒) * 3
欲求不満度 = 欲求不満素質補正(LOCAL,欲求不満度)
SELECTCASE 欲求不満度
	CASE IS > 400
		欲求不満度 = (欲求不満度 - 400) / 10 + 400
	CASE IS > 200
		欲求不満度 = (欲求不満度 - 200) / 4 + 200
	CASE IS > 100
		欲求不満度 = (欲求不満度 - 100) / 2 + 100
ENDSELECT
SIF 自慰タイプ
	欲求不満度 = 0
SIF TCVAR:LOCAL:今日会ったか
	欲求不満度 /= 2
SIF TALENT:LOCAL:妊娠
	欲求不満度 /= 5
SIF TALENT:LOCAL:育児中
	欲求不満度 /= 2
;溜まってる度は0~1000の間に
CFLAG:LOCAL:溜まってる度 = LIMIT(CFLAG:LOCAL:溜まってる度 + 欲求不満度, 0, 1000)
DEBUGPRINTFORML %CALLNAME:LOCAL%의 만족도: {満足度} 욕구 불만 상승치: {欲求不満度} 쌓여있는 정도: {CFLAG:LOCAL:溜まってる度}
NEXT

@DAILYEVENT
;デイリー最大数は イベント関連\デイリーイベント\DAILY_VARS.ERH で指定
#DIM EVENT_DAY,VARSIZE("eventDisabled")
#DIM DYNAMIC EV_COUNT
#DIM DYNAMIC CurEvent
VARSET EV_COUNT
CALL FISHER_YATES_SHAFFLE(VARSIZE("eventDisabled"))
;qol custom code
CALL QOL_DAILY_OPPAI_EVENT
IF RESULT > 0
	DRAWLINE
	EV_COUNT ++
	SIF EV_COUNT == nMaxEvents
		GOTO End
ENDIF
CALL FISHER_YATES_SHAFFLE(DAILY_EV_MAX)
ARRAYCOPY "SHAFFLE_ARRAY" , "EVENT_DAY"
DRAWLINE
;NAS: Always try to call wet dream and bedwetting events
IF !eventDisabled:901 && !DAILY_Lucid_Stats:0
	TRYCALLFORM DAILY_CONDITION_EV901
	IF RESULT > 0
		DRAWLINE
		EV_COUNT ++
		SIF EV_COUNT == nMaxEvents
			GOTO End
	ENDIF
ENDIF
IF !eventDisabled:2 && !DAILY_Lucid_Stats:0
	TRYCALLFORM DAILY_CONDITION_EV2_TR
	IF RESULT > 0
		DRAWLINE
		EV_COUNT ++
		SIF EV_COUNT == nMaxEvents
			GOTO End
	ENDIF
ENDIF
VARSET DAILY_Lucid_Stats
;========================================================
FOR LOCAL,0,VARSIZE("eventDisabled")
RESULT = 0
IF !INRANGE(EVENT_DAY:LOCAL,0,VARSIZE("EVENT_DAY"))
	CONTINUE
ENDIF
IF eventDisabled:(EVENT_DAY:LOCAL)
	CONTINUE
ELSEIF GROUPMATCH(EVENT_DAY:LOCAL,2,901)
	;already called.
	CONTINUE
ENDIF
TRYCALLFORM DAILY_CONDITION_EV{EVENT_DAY:LOCAL}
IF RESULT > 0
	DEBUGPRINTFORML 일일 이벤트 {EVENT_DAY:LOCAL}이 성공적으로 호출되었다.
	DRAWLINE
	EV_COUNT ++
	SIF EV_COUNT >= nMaxEvents
		BREAK
	;break after 5 events instead of one
ENDIF
SIF RESULT == -1
	DEBUGPRINTFORML 일일 이벤트 {EVENT_DAY:LOCAL}은(는) 요구하는 조건을 통과하지 못했다.
NEXT
$End
;addition custom code, make market event guaranteed (way too rare otherwise, has to compete with 30+ other events)
IF FLAG:市場の神 == 1 ;if didn't trigger
	TRYCALLFORM DAILY_CONDITION_EV33
	DRAWLINE
ENDIF
