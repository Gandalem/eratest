@うふふ中特殊イベント
#DIM 奪主導権確率
VARSET LOCAL
;あなた主導
IF CFLAG:TARGET:うふふ == 1 && CFLAG:溜まってる度 > 300 && !TCVAR:TARGET:無理矢理 && BASE:体力 >= 500 && BASE:気力 > 0 ;qol custom code, stamina/energy check
;攻守逆転
	IF SHIRAHU(TARGET) && TEQUIP:TARGET:体位 == 3
		;強気なほど確率が高い→分母は小さい
		;1/確率
		奪主導権確率 = 15
		奪主導権確率 -= TALENT:TARGET:度胸 * 2
		奪主導権確率 -= TALENT:TARGET:応答 * 2
		奪主導権確率 -= TALENT:TARGET:プライド * 2
		奪主導権確率 += TALENT:TARGET:自制心 * 3
		奪主導権確率 -= TALENT:TARGET:性的興味 * 3
		奪主導権確率 += TALENT:TARGET:羞恥心 * 2
		奪主導権確率 -= TALENT:TARGET:サド * 5
		奪主導権確率 += TALENT:TARGET:マゾ * 5

		;RANDに渡すので最低値は1
		SIF 奪主導権確率 < 1
			奪主導権確率 = 1
		IF !RAND(奪主導権確率)
			CFLAG:MASTER:うふふ = 2
			TFLAG:COMABLE管理 = 3
			FOR LOCAL,1,CHARANUM
				IF CFLAG:MASTER:現在位置 == CFLAG:LOCAL:現在位置
					CFLAG:LOCAL:うふふ = 2
					LOCAL:1 ++
				ENDIF
			NEXT
			PRINTFORML Suddenly, %CALLNAME:TARGET% \@ LOCAL:1 > 1 ? and the others take # takes \@ the initiative.
		ENDIF
	ENDIF
;相手主導
ELSEIF CFLAG:TARGET:うふふ == 2
	IF TARGET == RANDOM_CHARANUM && TALENT:TARGET:風俗嬢 && (BASE:気力 <= 0 || CFLAG:溜まってる度 <= 0)
		PRINTFORML %CALLNAME:TARGET% \@ BASE:気力 <= 0 ? looks a little tired # seems satisfied \@ and cedes the initiative.
		CFLAG:TARGET:うふふ = 1
		CFLAG:MASTER:うふふ = 1
	ELSEIF BASE:気力 <= 0
		PRINTFORML %CALLNAME:TARGET% says %HE_SHE(TARGET)% is too tired and lets you go.
		CALL 押し倒され終了("疲れた")
	ELSEIF TARGET > 0 && QOL_FRUSTRATION_ALL() <= 0 && !TCVAR:TARGET:好きにして ;qol custom code, check all characters
		LOCAL:10 = QOL_SEX_PARTICIPANTS() ;participant count
		PRINTFORML \@ LOCAL:10 > 1 ? Everyone # %CALLNAME:TARGET% \@ looks satisfied.
		CALL KIGEN_CHANGE(TARGET,100,1)
		BASE:怒り = 0
		CFLAG:不機嫌 = 0
		IF !FLAG:甲斐性無
			CALL ASK_M("Slip out", 1, "It's not over yet!", 1, "More please", ABL:サドっ気 >= 3)
			SELECTCASE RESULT
				CASE 0
					PRINTFORML \@ LOCAL:10 > 1 ? Everyone # %CALLNAME:TARGET% \@ lets you go.
					CALL 押し倒され終了("満足")
				CASE 1
					PRINTFORML You push %CALLNAME:TARGET%%COND_STR(" and the others", LOCAL:10 > 1)% down.
					CALL KOJO_MESSAGE_SEND("EVENT", 30, TARGET, 3)
					CFLAG:MASTER:うふふ = 1
					FOR LOCAL, 0, CHARANUM
						CFLAG:(TARGET:LOCAL):うふふ = 1
						IF INROOM(CFLAG:MASTER:現在位置) == 2
							CALL DATUI_SHOES(LOCAL,0)
							CALL DATUI_SHOES(MASTER,0)
						ENDIF
					NEXT
				CASE 2
					PRINTFORML %CALLNAME:TARGET% smiles from ear to ear, and whispers that %HE_SHE(TARGET)%%COND_STR(" and the others", LOCAL:10 > 1)%'ll continue until you break in that case.
					CALL KOJO_MESSAGE_SEND("EVENT", 30, TARGET, 4)
					TCVAR:TARGET:好きにして = 1
			ENDSELECT
		ELSE
			CALL ASK_M("Do nothing", 1, @"Give %HIM_HER(TARGET)% bedroom eyes", 1, "More please", ABL:サドっ気 >= 3 && ABL:MASTER:マゾっ気 >= 3)
			SELECTCASE RESULT
				CASE 0
					PRINTFORML %CALLNAME:TARGET% lets you go.
					CALL 押し倒され終了("満足")
				CASE 1
					IF ABL:サドっ気 >= 5 && RAND(2)
						PRINTFORML %CALLNAME:TARGET% orders you to beg, if you're serious about wanting something more.
						IF ABL:MASTER:マゾっ気 >= 3
							PRINTFORML Barely able to raise your voice above a whisper, you squeak out your request.
							PRINTFORML %CALLNAME:TARGET%'s whole body trembles with lust at your reply, and %HE_SHE(TARGET)% whispers that %HE_SHE(TARGET)%'ll keep going until you break.
							CALL KOJO_MESSAGE_SEND("EVENT", 30, TARGET, 4)
							TCVAR:TARGET:好きにして = 1
						ELSE
							PRINTFORML In the end, you can't bring yourself to say anything, and %HE_SHE(TARGET)% lets you go...
							CALL 押し倒され終了("満足")
						ENDIF
					ELSEIF ABL:サドっ気 >= 3 || (ABL:サドっ気 == 2 && RAND(6)) || (ABL:サドっ気 == 1 && RAND(2))
						PRINTFORML %CALLNAME:TARGET%'s sadistic side seems to be inflamed by your begging gaze.
						PRINTFORML Reaching the limits of %HIS_HER(TARGET)% self-control, %HE_SHE(TARGET)% looms over you, covering up your body with %HIS_HER(TARGET)% own...
						CALL KOJO_MESSAGE_SEND("EVENT", 30, TARGET, 4)
						TCVAR:TARGET:好きにして = 1
					ELSE
						PRINTFORML Not understanding the meaning of your expression, %CALLNAME:TARGET% lets you go.
						CALL 押し倒され終了("満足")
					ENDIF
				CASE 2
					PRINTFORML Barely able to raise your voice above a whisper, you squeak out your request.
					PRINTFORML %CALLNAME:TARGET% smiles from ear to ear, and whispers that %HE_SHE(TARGET)%'ll continue until you break in that case.
					CALL KOJO_MESSAGE_SEND("EVENT", 30, TARGET, 4)
					;qol custom code, apply to all
				FOR LOCAL, 1, GET_TARGETNUM() + 1
					SIF CFLAG:(TARGET:LOCAL):うふふ
						TCVAR:(TARGET:LOCAL):好きにして = 1
				NEXT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

@BATH_REMOVE_COND(ARG)
#FUNCTION
SIF FLAG:70
	RETURNF 0
SIF IS_SAMESEX(MASTER, ARG) || IS_CHILD(MASTER) ;addition custom code, allow same sex (futa/futa, girl/girl, male/male), allow shota pc
	RETURNF 0
SIF TALENT:ARG:羞恥心 < 0 && ABL:ARG:親密 >= 5
	RETURNF 0
SIF TALENT:ARG:SexKnow == -1 && ABL:ARG:親密 >= 5
	RETURNF 0
SIF CFLAG:ARG:うふふ
	RETURNF 0
SIF TCVAR:Common_Sense_Alteration_Status > 50 ;hypnosis patch
	RETURNF 0
SIF FLAG:催眠強度 > 50
	RETURNF 0
SIF CFLAG:ARG:ALLOW_BATH ;addition custom code, always allow bathing
	RETURNF 0
SIF LS_RESTRICTION("Kick out") ;Custom code, restrict kicking out during Lunatic Survival.
	RETURNF 0
SIF CFLAG:ARG:態度 < 2
	RETURNF 1
SIF CFLAG:ARG:既成事実 < 1
	RETURNF 1
;addition custom code, if you have pushed someone down they should be okay with bathing with you
SIF !(CFLAG:ARG:既成事実 & 合意_うふふ || TALENT:ARG:恋慕 || TALENT:ARG:セフレ)
	RETURNF 1

RETURNF 0
