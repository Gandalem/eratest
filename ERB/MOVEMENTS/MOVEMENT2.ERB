;-----------------------------------------------------------

@KITAKU(ARG)
#DIMS 帰宅理由
SIF LS_RESTRICTION("Character go home") ;Custom code, restrict characters going home during Lunatic Survival.
	RETURN
;午前3時～午前7時
IF INRANGE(TIME, 180, 420)
	帰宅理由 = dawn is breaking
	;午前7時～午後3時
ELSEIF INRANGE(TIME, 421, 899)
	帰宅理由 = the sun is high in the sky
	;午後3時～午後7時
ELSEIF INRANGE(TIME, 900, 1140)
	帰宅理由 = the sun is setting
	;午後7時～午前3時
ELSE
	帰宅理由 = it's gotten too late
ENDIF
IF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置 && !CFLAG:MASTER:睡眠 && CFLAG:ARG:現在位置 != CFLAG:ARG:初期位置
	CALL OneNightStay(ARG)
	SIF CFLAG:ARG:神社在住
		RETURN
	IF 睡眠時間(ARG)
		PRINTFORMW %CALLNAME:ARG%는 잠자리에 든다.
		;デート中
	ELSEIF CHK_DATENOW(CFLAG:(ARG):デート中)
		;うふふ中は非表示
		SIF !CFLAG:ARG:うふふ
			PRINTFORMW %CALLNAME:ARG%와의 데이트가 %帰宅理由% 때문에 끝난다.
		;自宅にいる時,お招き部屋にいる時はうふふしていない時
		IF CFLAG:ARG:現在位置 == CFLAG:ARG:自宅位置 || (CFLAG:ARG:現在位置 == OMANEKIBEYA() && !CFLAG:ARG:うふふ)
			;帰宅口上,3,玄関先で見送り
			CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 3)
			;通常のデート中
		ELSE
			;お誘い
			IF (TALENT:ARG:恋慕 || TALENT:ARG:セフレ == 2) && CFLAG:ARG:溜まってる度 >= (700 + TALENT:ARG:羞恥心 * 150) && !CFLAG:ARG:神社在住 && !TCVAR:ARG:連泊禁止 && CFLAG:(ARG):現在位置 != OMANEKIBEYA()
				PRINTFORML %CALLNAME:ARG%이 당신을 %HIS_HER(ARG)%의 방으로 초대한다.
				;帰宅口上,4,部屋に来ないかと誘う
				CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 4)
				CALL ASK_YN("Go","거절하다")
				IF !RESULT
					IF CFLAG:ARG:自宅位置
						PRINTFORML %PNAME(ARG)%의 초대를 받아, 당신은 %HIS_HER(ARG)%의 방으로 향한다...
						PRINTFORMW +{TIME_REQUIRED(CFLAG:ARG:現在位置 / 100, CFLAG:ARG:自宅位置 / 100)} 분
						TIME += TIME_REQUIRED(CFLAG:ARG:現在位置 / 100, CFLAG:ARG:自宅位置 / 100)
					ELSE
						PRINTFORML %PNAME(ARG)%의 초대로 당신은 %HIS_HER(ARG)% 방으로 향하고, 그곳에서 ...를 찾기까지 시간이 걸린다.
						PRINTFORMW +30분
						TIME += 30
					ENDIF
					;帰宅口上,5,誘われるまま行く
					SIF MOREDATE
						HouseInvitationStatus = 1
					CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 5, 0)
					CALL OMANEKI_ENTER(ARG)
					CALL TARGETSET_CHACK
				ELSE
					PRINTFORMW %PNAME(ARG,1)%은(는) 좀 외로워 보인다...
					;帰宅口上,6,誘いを断る
					CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 6)
					SIF (CFLAG:MASTER:現在位置 % 100) % 10 && CHK_DATENOW(CFLAG:MASTER:デート中) && FLAG:デート相手 == ARG && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
						CFLAG:MASTER:現在位置 = CFLAG:MASTER:デート中 * 100
				ENDIF
			ELSE
				;帰宅口上,2,デート中帰宅
				CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 2)
				SIF (CFLAG:MASTER:現在位置 % 100) % 10 && CHK_DATENOW(CFLAG:MASTER:デート中) && FLAG:デート相手 == ARG && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
					CFLAG:MASTER:現在位置 = CFLAG:MASTER:デート中 * 100
			ENDIF
		ENDIF
		;神社内にいるか自宅でもお招き部屋でもない場所
	ELSEIF AT_HOME(ARG) || (CFLAG:(ARG):現在位置 != CFLAG:(ARG):自宅位置 && CFLAG:(ARG):現在位置 != OMANEKIBEYA()) && CFLAG:ARG:行動 != 5
		;帰宅口上,1,通常帰宅
		CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 1)
		PRINTFORMW %CALLNAME:ARG%은(는) %帰宅理由% 때문에 집에 간다.
		CALL SET_TOGETHER(0,ARG,1)
		SIF (CFLAG:MASTER:現在位置 % 100) % 10 && CHK_DATENOW(CFLAG:MASTER:デート中) && FLAG:デート相手 == ARG && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
			CFLAG:MASTER:現在位置 = CFLAG:MASTER:デート中 * 100
	ENDIF
	IF CFLAG:(ARG):うふふ > 0 || CHK_DATENOW(CFLAG:(ARG):デート中)
		FOR LOCAL,1,CHARANUM
		;お招き中は継続
		SIF CFLAG:MASTER:お招き != LOCAL && CFLAG:LOCAL:うふふ
			CALL ENDUFUFU(LOCAL)
		;デートは消える
		CFLAG:LOCAL:デート中 = MAIN_MAP
		FLAG:デート相手 = MASTER
		TFLAG:デート前好感度 = 0
		NEXT
		SIF MOREDATE
			CALL REMOVE_FROM_GROUP_DATE(ARG)
		;お招きうふふ中は継続
		SIF !CFLAG:MASTER:お招き
			CFLAG:MASTER:うふふ = 0
		CFLAG:MASTER:同行 = 0
	ENDIF
ENDIF
CFLAG:ARG:同行 = 0
SIF TFLAG:PublicToyPlay == ARG
	TFLAG:PublicToyPlay = 0
IF !TCVAR:ARG:休憩中 && !CFLAG:ARG:お招き
	;拠点から帰るなら今日はもう来訪しない
	SIF IN_HOME(CFLAG:ARG:現在位置) && !CFLAG:MASTER:睡眠
		CFLAG:ARG:拠点来訪 = 0
	;活動時間外は自宅があれば寝るまで自宅にいる
	IF CFLAG:ARG:自宅位置 && !IN_HOME(CFLAG:ARG:自宅位置) && !睡眠時間(ARG)
		CFLAG:ARG:現在位置 = CFLAG:ARG:自宅位置
		;自宅がないか寝ると消える
	ELSE
		CFLAG:ARG:現在位置 = SUKIMA()
	ENDIF
ENDIF

@寝室から追い出し(ARG)
SIF !AT_HOME(MASTER)
	RETURN
SIF ARG == MASTER ; NAS: non ID 0 master
	RETURN
SIF CFLAG:ARG:現在位置 != CFLAG:MASTER:現在位置
	RETURN
;SIF !睡眠時間(ARG) ;addition custom code
;	RETURN
SIF CFLAG:ARG:現在位置 != CFLAG:ARG:初期位置
	RETURN
;custom code
;you are asleep, why should a touhou kick you out?
SIF !SHIRAHU(MASTER)
	RETURN
SIF !SHIRAHU(ARG)
	RETURN
;忍び込み中
SIF CFLAG:ARG:隠密中
	RETURN
SIF 寝室許可(ARG, 1)
	RETURN
SIF CFLAG:ARG:同行 ;if being led by
	RETURN
SIF CFLAG:ARG:出禁 ;if banned
	RETURN
SIF IsDead:ARG:0 ; if dead
	RETURN
SIF !睡眠時間(ARG) && !LOCK:(CFLAG:MASTER:現在位置) ;if not asleep and the room isn't locked
	RETURN
SIF LS_RESTRICTION("Kick out") ;Custom code, restrict kicking out during Lunatic Survival.
	RETURN
SIF IS_BABY(ARG) ;babies cannot kick you out
	RETURN
SIF CharaFamily:ARG:MASTER && TALENT:ARG:BornChild && CharaAge:ARG:0 < 15 ;not independent child
	RETURN
;なんのためのCLEARLINE？
;CLEARLINE 1
;addition custom code
SIF !睡眠時間(ARG)
	CALL COLORMESSAGE(@"【방 침입】",0x9696FA, 1, 0)
PRINTFORMW %PARSE("You're")%는 \@ 睡眠時間(ARG) ? 잠든 %" "% #  \@%CALLNAME:ARG%에게 쫓겨난다...
;おやすみ口上,7-1,部屋から追い出して寝た
IF 睡眠時間(ARG) ;addition custom code
	CALL KOJO_MESSAGE_SEND("EVENT", 3, ARG, 7, 1)
ELSE
	CALL KOJO_MESSAGE_SEND("EVENT",12,ARG,1,4)
ENDIF
;忍び込みOFF
CALL SET_SNEAK(0,ARG,2)
;イタズラOFF
CALL SET_PRANK(0,ARG,2)
;うふふリセット
CALL ENDUFUFU_ALL
;夜這い侵入成功フラグクリア
CLEARBIT CFLAG:ARG:夜這い, 8
;移動可能な場所へ移動
CALL GETOUT(MASTER)

@風呂から追い出し(ARG)
SETCOLOR 150,150,250
PRINTL 【목욕탕 침입】
RESETCOLOR
IF TALENT:ARG:羞恥心 < 0
	IF ABL:ARG:親密 < 5
		PRINTFORML %CALLNAME:ARG%차분하게 나가라고 말한다 왜냐하면 %HE_SHE(ARG)% 이미 그것을 사용하고 있다.
		CFLAG:ARG:好感度 -= (20 - ABL:ARG:親密 * 2)
		CFLAG:ARG:信頼度 -= (20 - ABL:ARG:親密 * 2)
		SOURCE:ARG:反感 += 300
		CFLAG:MASTER:現在位置 = KICKOUT()
		;ELSE
		;	PRINTFORML %CALLNAME:ARG%は平然として、一緒に入りたいのかと聞いてきた
	ENDIF
ELSE
	PRINTFORML %CALLNAME:ARG%이 당신이 들어오는 것을 알아차리면, %HE_SHE(ARG)%는 목청껏 비명을 지르며 욕조에서 뛰어내린다.
	CFLAG:ARG:好感度 -= (50 - ABL:ARG:親密 * 2)
	CFLAG:ARG:信頼度 -= (50 - ABL:ARG:親密 * 2)
	SOURCE:ARG:反感 += 1000
	BASE:ARG:怒り += (1500 - ABL:ARG:親密 * 100)
	CFLAG:ARG:現在位置 = KICKOUT()
	;キャラを動かしたのでTARGET再設定
ENDIF
CFLAG:ARG:好感度 = MAX(CFLAG:ARG:好感度,0)
CFLAG:ARG:信頼度 = MAX(CFLAG:ARG:信頼度,0)
CALL TARGETSET_CHACK
CFLAG:ARG:同室 = 0
RETURN 1

@お招き部屋処理(ARG)
SIF FLAG:時間停止 || !CFLAG:ARG:お招き || IsDead:ARG:0
	RETURN
;お招き部屋から出たら日常に戻る
;泊まる前か後かは連泊禁止フラグを参照してます
IF CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	CALL お招き部屋から出る(ARG)
	;翌日仕事に行く場合
ELSEIF 仕事中チェック(ARG) && TCVAR:ARG:連泊禁止 && CFLAG:ARG:うふふ != 1
	SIF !MOREDATE || (MOREDATE && CFLAG:MASTER:お招き == ARG) ;only kick from room if they own it
		CFLAG:MASTER:現在位置 = CFLAG:ARG:自宅位置
	IF CFLAG:ARG:うふふ
		PRINTFORMW %CALLNAME:ARG%의 작업이 곧 시작된다...
		CALL ENDUFUFU(LOCAL)
		PRINTFORMW %CALLNAME:ARG%은(는) 마지못해 떠난다...
	ELSE
		PRINTFORMW %CALLNAME:ARG%은(는) %HIS_HER(ARG)%의 업무가 시작되어 떠난다...
	ENDIF
	CALL お招き部屋から出る(ARG)
	;デート中
ELSEIF CHK_DATENOW(CFLAG:ARG:デート中)
	IF CFLAG:ARG:神社在住
		;住み込みキャラは睡眠時間になったらデート終了
		IF 睡眠時間(ARG)
			CFLAG:ARG:デート中 = MAIN_MAP
			FLAG:デート相手 = MASTER
			SIF MOREDATE
				CALL REMOVE_FROM_GROUP_DATE(ARG)
		ENDIF
	ELSE
		;デート中に帰る時間が来たらメッセージ＆デートだけ消す
		IF !VISIT(ARG)
			CALL KITAKU(ARG)
		ENDIF
	ENDIF
ENDIF

@お招き部屋から出る(ARG)
#DIM 出口
;遭遇フラグを自宅位置に設定（連動してると他のキャラが駆けつけてくるのは仕様）
CFLAG:ARG:遭遇位置 = CFLAG:ARG:自宅位置
;初期位置を元に戻す（参道の向こうや0もいるが99でもおｋ）
IF CFLAG:ARG:神社在住
	CFLAG:ARG:初期位置 = CFLAG:ARG:神社在住
ELSE
	CFLAG:ARG:初期位置 = SUKIMA()
ENDIF
;活動時間ならそのままデート。住み込みキャラは起きていればデート
;の予定だったがバランスブレイカーな気がする＆朝帰りは一人の方が雰囲気でるので住み込みキャラだけ
;活動前も配置するようになったので起床時間なら外に出るように
IF CFLAG:ARG:神社在住
	CFLAG:ARG:現在位置 = 97 + MAIN_MAP * 100
	CFLAG:ARG:デート中 = MAIN_MAP
	FLAG:デート相手 = MASTER
	TFLAG:デート前好感度 = 0
	SIF MOREDATE
		CALL REMOVE_FROM_GROUP_DATE(ARG)
ELSE
	IF !睡眠時間(ARG) && !CFLAG:ARG:睡眠
		;自宅位置に移動
		CFLAG:ARG:現在位置 = CFLAG:ARG:遭遇位置
		;泊まる前or住み込みキャラならデート継続,ワープ移動してたらダメ
		IF !TCVAR:ARG:連泊禁止 && CHK_DATENOW(CFLAG:ARG:デート中) && !AT_HOME(MASTER)
			CFLAG:ARG:デート中 = (CFLAG:ARG:自宅位置) / 100
			CFLAG:ARG:同行 = 60
		ENDIF
		;寝ている場合は見えないところに移動
		;住み込みキャラは識別するために現在位置97を使ってるので要注意（MOVEMENT2のSLEEPへ続く）
	ELSE
		CFLAG:ARG:現在位置 = SUKIMA()
		CFLAG:ARG:デート中 = MAIN_MAP
		FLAG:デート相手 = MASTER
		TFLAG:デート前好感度 = 0
		SIF MOREDATE
			CALL REMOVE_FROM_GROUP_DATE(ARG)
	ENDIF
ENDIF
;お招きフラグを消して日常に戻す
CFLAG:ARG:お招き = 0
IF !MOREDATE || (MOREDATE && CFLAG:MASTER:お招き == ARG) ; need to always runs this in case player turns off mod and characters get their initial place stuck forever
	LOCK:(OMANEKIBEYA()) = 0
	;GET EXIT
	IF CFLAG:(CFLAG:MASTER:お招き):自宅位置
		出口 = CFLAG:(CFLAG:MASTER:お招き):自宅位置
	ELSE
		DO
		LOCAL = RAND:9
		IF LOCAL == MAIN_MAP
			出口 = 0
		ELSE
			出口 = LOCAL * 100 + 10
		ENDIF
		LOOP !出口
	ENDIF
	;move player to exit
	CFLAG:MASTER:お招き = 0
	CFLAG:MASTER:デート中 = 出口 / 100
	CFLAG:MASTER:現在位置 = 出口
	CALL MOREDATES_HOUSE_EXIT(出口)
ENDIF

@OneNightStay(ARG)
#DIM YANUSHI
#DIM REQUIRED_DESIRE
YANUSHI = PRIVATEROOM:(CFLAG:MASTER:初期位置 % 100)
SIF CFLAG:ARG:溜まってる度 < 800
	RETURN
SIF CFLAG:ARG:現在位置 != CFLAG:MASTER:現在位置
	RETURN
;qol custom code
; SIF FLAG:一時滞在
; 	RETURN
SIF CFLAG:ARG:神社在住
	RETURN
SIF !AT_HOME(MASTER)
	RETURN
REQUIRED_DESIRE = 10
SIF TALENT:ARG:恋慕 || TALENT:ARG:セフレ
	REQUIRED_DESIRE -= 5
SIF TALENT:ARG:思慕
	REQUIRED_DESIRE -= 2
IF !(CFLAG:ARG:既成事実 & 合意_うふふ) ;bugfix custom code
	REQUIRED_DESIRE += FuckReserved(ARG) * 2
	REQUIRED_DESIRE += TALENT:ARG:貞操 * 2
ENDIF
SIF TALENT:ARG:ヤリマン
	REQUIRED_DESIRE = 0
SIF ABL:ARG:欲望 < REQUIRED_DESIRE
	RETURN
PRINTFORML %CALLNAME:ARG%은 오늘 밤 집에 가고 싶지 않다고 말한다...
;帰宅口上,7,今夜は帰りたくない
CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 7)
CALL ASK_YN(@"%HIM_HER(ARG)%이/가 머물게 해라",@"%HIM_HER(ARG)%을/를 가게 해라")
IF !RESULT
	IF !QOL_CAN_STAY_OVER(ARG) ; qol custom code
		PRINTFORMW 당신은 정말로 숙박을 제공하고 싶지만, %CALLNAME:YANUSHI%가 두렵다...
		GOTO REFUSAL
	ELSE
		;qol custom code, description
		LOCAL = 0
		LOCAL:1 = 0
		LOCAL:2 = 0
		LOCALS =
		DO
		LOCAL = FINDCHARA(CFLAG:初期位置, CFLAG:MASTER:初期位置, LOCAL + 1, CHARANUM - 1)
		SIF LOCAL == ARG
			CONTINUE
		IF LOCAL > 0
			LOCALS += @"%CALLNAME:LOCAL%、"
			LOCAL:1++
			LOCAL:2 = LOCAL
		ENDIF
		LOOP LOCAL > 0 && LOCAL < CHARANUM - 1
		IF LOCAL:1
			PRINTFORMDL 당신은 그것에 대해 %LIST_IN_STRING(LOCALS)%에게 물었고, 그리고 \@ LOCAL:1 > 1 ? 그들 모두 # %HE_SHE(LOCAL:2)% \@ 너희가 하룻밤 머무르는 것을 너그럽게 허락한다%COND_STR("s", LOCAL:1 == 1)% %CALLNAME:ARG%.
		ENDIF
	ENDIF
	; FLAG:一時滞在 = ARG
	; CFLAG:ARG:本来の初期位置 = CFLAG:ARG:初期位置
	; CFLAG:ARG:初期位置 = CFLAG:MASTER:初期位置
	; CFLAG:ARG:神社在住 = CFLAG:ARG:初期位置
	CALL QOL_STAYOVER(ARG) ;qol custom code
	PRINTFORMW %CALLNAME:ARG%는 %AT_IN_ON(CFLAG:MASTER:初期位置)%에서 하룻밤을 보낼 것이다.
	;帰宅口上,8,泊まっていくことになる
	CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 8)
ELSE
	$REFUSAL
	PRINTFORMW 당신은 정중하게 거절한다.
	;帰宅口上,9,断った
	CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 9)
ENDIF

@SET_OneNightStay()
