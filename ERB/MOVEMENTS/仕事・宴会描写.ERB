; Modular ERB: 仕事・宴会描写.ERB

@仕事情景描写(ARG)
;ARGはキャラ　キャラ別の情景描写にどうぞ。
;Custom code, replaced function
CALL JOB_DEPICTION(ARG)
RETURN
IF CFLAG:ARG:職種 == 48
	PRINTFORMW %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? %조사처리(CALLNAME:MASTER,"를")% 신경 쓰면서 # 바빠 보이며 \@ 연회의 준비를 하고 있다.
ELSEIF CFLAG:ARG:職種 == 50
	PRINTFORMW %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? %조사처리(CALLNAME:MASTER,"를")% 신경 쓰면서 # 묵묵히 \@ 연회 정리를 하고 있다.
ELSEIF CFLAG:ARG:職種 == 46
	PRINTFORMW %CALLNAME:ARG%는(은) \@ TALENT:ARG:恋慕 ? %조사처리(CALLNAME:MASTER,"에게")% 때때로 시선을 향하면서 #  \@놀고 있다.
ELSEIF CFLAG:ARG:職種 == 52
	SELECTCASE ARG
		;こっから女子会　※後々キャラ毎に個性持たせたいので分岐だけ作っておく
		CASE 4
			PRINTFORML %CALLNAME:ARG%은 여자들과 음란하게 담소를 나누고 있다.
		CASE 26
			PRINTFORML %CALLNAME:ARG%는 여자들과 음탕하게 담소를 나누고 있다.
		CASE 32
			PRINTFORML %CALLNAME:ARG%는 여자들과 음란하게 담소를 나누고 있다.
		CASE 55
			PRINTFORML %CALLNAME:ARG%는 여자들과 음란하게 담소를 나누고 있다.
		CASE 66
			PRINTFORML %CALLNAME:ARG%는 여자들과 음란하게 담소를 나누고 있다.
		CASE 72
			PRINTFORML %CALLNAME:ARG%는 여자들과 음란하게 담소하고 있다.
		CASE 102
			PRINTFORML %CALLNAME:ARG%는 여자들과 음란하게 담소를 나누고 있다.
		CASE 124
			PRINTFORML %CALLNAME:ARG%는 여자들과 음란하게 담소를 나누고 있다.
	ENDSELECT
	;女子会ここまで
ELSE
	SELECTCASE ARG
		CASE 30
			IF INRANGE(TIME, CLOCK_TO_TIME(9, 0), CLOCK_TO_TIME(11, 59))
				PRINTFORML %CALLNAME:ARG%은 조용히 %GET_JOBNAME(ARG)%을 진행하고 있다.
			ELSEIF INRANGE(TIME, CLOCK_TO_TIME(12, 0), CLOCK_TO_TIME(12, 59))
				PRINTFORML %CALLNAME:ARG%는 %GET_JOBNAME(ARG)%를 가지고 있다.
			ELSE
				PRINTFORML %CALLNAME:ARG%는 담담하게 %GET_JOBNAME(ARG)%을 진행하고 있다.
			ENDIF
		CASE 54
			PRINTFORMW %CALLNAME:ARG%는 책에서 얼굴도 들지 않는다...
		CASE 57
			PRINTFORMW %CALLNAME:ARG%은 느긋하게 %GET_JOBNAME(ARG)%을 하고 있다.
		CASE 67
			IF TIME >= 720 && TIME <= 780
				PRINTFORMW %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? %조사처리(CALLNAME:MASTER,"를")% 신경 쓰면서 #  \@아이들과%GET_JOBNAME(ARG)%을 하고 있다.
			ELSE
				PRINTFORMW %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? %조사처리(CALLNAME:MASTER,"를")% 신경 쓰면서 #  \@%GET_JOBNAME(ARG)%을 하고 있다.
			ENDIF
		CASE 70
			IF DAY % 7 == 3 || DAY % 7 == 4
				PRINTFORML %CALLNAME:ARG%은 책을 읽으면서 %GET_JOBNAME(ARG)%를 하고 있다.
			ELSE
				PRINTFORML %CALLNAME:ARG%는 내용물을 확인하며 정중하게 %GET_JOBNAME(ARG)%를 하고 있다.
			ENDIF
		CASEELSE
			PRINTFORML %CALLNAME:ARG%는 능숙하게 %GET_JOBNAME(ARG)%를 해내고 있다.
	ENDSELECT
ENDIF

@宴会描写(ARG)
;FLAG:宴会開催フラグを使って宴会種別で書き分けてもいいかも
IF TCVAR:ARG:泥酔 == 0
	IF CFLAG:ARG:職種 == 49 && TALENT:ARG:恋慕 == 1
		PRINTFORML %CALLNAME:ARG%은 때때로 %HIS_HER(ARG)%의 시선이 당신에게 머물도록 허용하며 연회를 즐긴다.
	ELSE
		PRINTFORML %CALLNAME:ARG%은(는) 연회를 즐긴다.
	ENDIF
ELSE
	IF TALENT:ARG:恋慕 == 1
		PRINTFORML %CALLNAME:ARG%은(는) 완전히 낭비되지만 가끔 당신을 바라본다.
	ELSE
		PRINTFORML %CALLNAME:ARG%는 완전히 낭비되었다.
	ENDIF
ENDIF
IF CFLAG:ARG:職種 == 51 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 8)
	PRINTFORML 　%HE_SHE(ARG)%는 한동안 계속 취해 있을 것 같다...
ELSEIF CFLAG:ARG:職種 == 51 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 6)
	PRINTFORML 　%HIM_HER(ARG)%이 술 깨는 데 시간이 좀 걸릴 거야...
ELSEIF CFLAG:ARG:職種 == 51
	PRINTFORML 　%HE_SHE(ARG)%가 술이 깨는 것 같다...
ELSEIF CFLAG:ARG:職種 == 49 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 6)
	IF TALENT:ARG:感情乏しい && RAND:4
	ELSEIF !RAND:10
		IF !RAND:2
			PRINTFORML 　%HIS_HER(ARG,1)%의 눈이 풀려있다.
			PRINTFORML 　술이 %HIM_HER(ARG)%에게 맞지 않는 것 같다.
			TALENT:ARG:15 = -1
		ELSE
			PRINTFORML 　%HE_SHE(ARG,1)%은 즐기고 있는 것 같다.
			PRINTFORML 　술이 잘 듣고 있는 것 같다.
			TALENT:ARG:15 = 1
		ENDIF
	ELSE
		IF TALENT:ARG:15 == -1
			PRINTFORML 　%HE_SHE(ARG,1)%은(는) %HIS_HER(ARG)%에서 홀로 %HIMSELF_HERSELF(ARG)%하고 있다...
		ELSEIF TALENT:ARG:15 == 1
			PRINTFORML 　%HE_SHE(ARG,1)%은 통제 불가능하게 웃고 있다...
		ELSE
			PRINTFORML 　%HE_SHE(ARG,1)%은 점점 더 취해간다...
		ENDIF
	ENDIF
ELSEIF CFLAG:ARG:職種 == 49 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 4)
	PRINTFORML 　%HE_SHE(ARG,1)%은(는) %HIMSELF_HERSELF(ARG)%를 더 즐기기 시작한다...
ELSEIF AlcoholAddict:ARG:0 == -5 || CFLAG:ARG:妊娠自覚状態 == 1
	IF BASE:ARG:仕事量 >= (MAXBASE:ARG:仕事量 / 3) * 2
		PRINTFORML 　%HE_SHE(ARG,1)%은 술을 마시지 않고 그저 수다를 친다...
	ELSEIF BASE:ARG:仕事量 >= (MAXBASE:ARG:仕事量 / 3)
		IF CFLAG:ARG:妊娠自覚状態 == 1
			PRINTFORML 　%HE_SHE(ARG,1)%은 술을 마시지 않고 %HIMSELF_HERSELF(ARG)%를 즐긴다...
		ELSEIF TALENT:ARG:酒耐性 == -2
			PRINTFORML 　평소처럼, %HE_SHE(ARG)%는 아무것도 마시지 않는다...
		ENDIF
	ELSEIF AlcoholAddict:ARG:0 == -5 || CFLAG:ARG:妊娠自覚状態 == 1
		PRINTFORML 　%HE_SHE(ARG,1)%은 술에 맞서 단호하게 선다.
	ENDIF
ELSEIF CFLAG:ARG:職種 == 49
	PRINTFORML 　%HE_SHE(ARG)%는 술을 더 마실 기분이 있는 것 같다...
ENDIF
