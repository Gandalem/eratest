; Modular ERB: 自由行動/FREE_ACT_12.ERB

@EXIST_FreeAct12
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct12(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "一緒にのんびりする")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_12(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;昼間に休憩できる場所または憩いスペースにいる時
		SIF !INRANGE(TIME, 600, 960)
			RETURN 0
		SIF !休憩可(現在地) && !憩いスペース(現在地)
			RETURN 0
		SIF メッセージ表示
			PRINTFORMW %조사처리(CALLNAME:CHARA,"는")% \@ CHAIN ? %CALLNAME:CHAIN%의 느긋한 휴식에 이끌려 함께 쉰다 # 잠시 숨을 돌리며 편히 쉰다 \@.
		RETURN 60 + RAND:30
	CASE "行動中"
		IF メッセージ表示
			PRINTFORMW %조사처리(CALLNAME:CHARA,"는")% %TEXTR("하품하고 있다/편히 쉬고 있다/아무것도 하지 않고 있다/한껏 느긋하게 보내고 있다")%.
		ENDIF
	CASE "完了"
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 휴식(%HIS_HER(CHARA)%)을 마친 것 같다.
	CASE "中断"
	CASE "付き合う"
		;自由行動に付き合ったとき用メッセージ
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"와")% %TEXTR(@"별일 없이 시간을 보낸다/한동안 느긋하게 빈둥거린다/잠시 편하게 쉰다")%.
	CASE "ソース"
		;付き合うコマンド選択時の入手ソース、時間係数は付き合った時間の1/10
		CALL RECOVER_PERMIL(MASTER, 150, "体力", 1)
		CALL RECOVER_PERMIL(MASTER, 250, "気力", 1)
		CALL RECOVER_PERMIL(TARGET, 200, "体力", 1)
		CALL RECOVER_PERMIL(TARGET, 300, "気力", 1)
		SOURCE:歓楽 = (100 + ((ABL:親密 + 好感度係数(TARGET)) * 10)) * 時間係数
		SOURCE:受動 = (50 + ((ABL:従順 + 好感度係数(TARGET)) * 5)) * 時間係数
ENDSELECT
