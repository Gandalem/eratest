; Modular ERB: 自由行動/FREE_ACT_8.ERB

@EXIST_FreeAct8
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct8(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		IF TALENT:ARG:音楽知識 == 1
			CALLF MAKE_STR(V_NAME, "セッションする")
		ELSE
			CALLF MAKE_STR(V_NAME, "伴奏する")
		ENDIF
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_8(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;［音楽知識］持ちのキャラが訓練できる場所にいる時
		SIF !TALENT:CHARA:音楽知識
			RETURN 0
		SIF !戦闘訓練可(現在地)
			RETURN 0
		SIF BASE:CHARA:気力 <= MAXBASE:CHARA:気力 / 2
			RETURN 0
		IF メッセージ表示
			IF CHAIN
				SELECTCASE TALENT:CHAIN:音楽知識
					CASE 1
						SELECTCASE TALENT:CHARA:音楽知識
							CASE 1
								PRINTFORMW %CALLNAME:CHARA%와 %CALLNAME:CHAIN%가 재즈 세션을 시작한다.
							CASE 2
								PRINTFORMW %CALLNAME:CHARA%는 %CALLNAME:CHAIN%의 공연에 보컬로 합류한다.
							CASE 3
								PRINTFORMW %CALLNAME:CHARA%가 %CALLNAME:CHAIN%의 공연에 춤으로 합류한다.
						ENDSELECT
					CASE 2
						SELECTCASE TALENT:CHARA:音楽知識
							CASE 1
								PRINTFORMW %CALLNAME:CHARA%가 %CALLNAME:CHAIN%의 공연에 맞춰 연주하기 시작한다.
							CASE 2
								PRINTFORMW %CALLNAME:CHARA%가 %CALLNAME:CHAIN%의 합창에 동참한다.
							CASE 3
								PRINTFORMW %CALLNAME:CHARA%는 %CALLNAME:CHAIN%의 음악에 맞춰 리듬을 타며 춤춘다.
						ENDSELECT
					CASE 3
						SELECTCASE TALENT:CHARA:音楽知識
							CASE 1
								PRINTFORMW %CALLNAME:CHARA%은(는) %CALLNAME:CHAIN%의 춤에 맞춰 연주를 시작한다.
							CASE 2
								PRINTFORMW %CALLNAME:CHARA%는 %CALLNAME:CHAIN%의 춤에 맞춰 노래하기 시작한다.
							CASE 3
								PRINTFORMW %CALLNAME:CHARA%은(는) %CALLNAME:CHAIN%와 함께 춤을 추기 시작한다.
						ENDSELECT
				ENDSELECT
			ELSE
				SELECTCASE TALENT:CHARA:音楽知識
					CASE 1
						PRINTFORMW %CALLNAME:CHARA%가 노래를 부르기 시작한다.
					CASE 2
						PRINTFORMW %CALLNAME:CHARA%가 노래하기 시작한다.
					CASE 3
						PRINTFORMW %CALLNAME:CHARA%가 춤을 추기 시작한다.
				ENDSELECT
			ENDIF
		ENDIF
		RETURN 60 + RAND:30
	CASE "行動中"
		IF メッセージ表示
			SELECTCASE TALENT:CHARA:音楽知識
				CASE 1
					PRINTFORMW %CALLNAME:CHARA%는 작은 음악 공연을 하고 있다.
				CASE 2
					PRINTFORMW %CALLNAME:CHARA%은 자유롭게 노래하고 있다.
				CASE 3
					PRINTFORMW %CALLNAME:CHARA%는 자유롭게 춤을 추고 있다.
			ENDSELECT
		ENDIF
	CASE "完了"
		SELECTCASE TALENT:CHARA:音楽知識
			CASE 1
				EXP:CHARA:演奏経験 += 1
				SIF メッセージ表示
					PRINTFORMW %CALLNAME:CHARA%는 공연 후 %HIM_HER(CHARA)%의 숨을 붙잡는다.
			CASE 2
				EXP:CHARA:歌唱経験 += 1
				SIF メッセージ表示
					PRINTFORMW %CALLNAME:CHARA%은(는) 노래를 부른 후 %HIM_HER(CHARA)% 숨을 몰아쉰다.
			CASE 3
				EXP:CHARA:舞踏経験 += 1
				SIF メッセージ表示
					PRINTFORMW %CALLNAME:CHARA%이/가 %HIS_HER(CHARA)%의 춤 후에 %HIM_HER(CHARA)%의 숨을 멎게 한다.
		ENDSELECT
	CASE "中断"
		SELECTCASE TALENT:CHARA:音楽知識
			CASE 1
				EXP:CHARA:演奏経験 += 1
			CASE 2
				EXP:CHARA:歌唱経験 += 1
			CASE 3
				EXP:CHARA:舞踏経験 += 1
		ENDSELECT
	CASE "行動中"
		;行動中の処理、地の文もここで
		IF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 %TEXTR(@"숨을 쉬거나/눈을 깜빡이거나/이상한 표정을 짓는다")%.
		ENDIF
	CASE "完了"
		;行動時間を使い切ったときの処理、地の文もここで
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%은(는) %HIS_HER(CHARA)% 활동을 마친 것 같다.
	CASE "中断"
		;中断したときの処理、地の文もここで
	CASE "付き合う"
		IF TFLAG:193 == -2
			SELECTCASE TALENT:TARGET:音楽知識
				CASE 1
					PRINTFORML 당신은 악기가 없어서 그냥 %조사처리(CALLNAME:TARGET,"의")% 공연을 듣는다...
				CASE 2
					PRINTFORML 너는 악기가 없어서 그냥 %조사처리(CALLNAME:TARGET,"의")% 노래를 듣는다...
				CASE 3
					PRINTFORML 악기가 없으니 %조사처리(CALLNAME:TARGET,"의")% 춤을 봐라...
			ENDSELECT
		ELSE
			SELECTCASE TALENT:TARGET:音楽知識
				CASE 1
					PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 재즈 세션에 합류한다.
					IF TFLAG:193 > 0
						PRINTFORML %TNAME(TARGET,1)%은 기운차게 연주한다...
					ELSEIF TFLAG:193 < 0
						PRINTFORML %TNAME(TARGET,1)%은 불편해 보인다...
					ELSE
						PRINTFORML %TNAME(TARGET,1)%이 꾸준히 연주한다...
					ENDIF
				CASE 2
					PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 노래를 들으며 플레이한다.
					IF TFLAG:193 > 0
						PRINTFORML %TNAME(TARGET,1)%은 기분 좋게 노래한다.
					ELSEIF TFLAG:193 < 0
						PRINTFORML %TNAME(TARGET,1)%은 불편해 보인다...
					ELSE
						PRINTFORML %TNAME(TARGET,1)%은 꾸준히 노래한다...
					ENDIF
				CASE 3
					PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 춤을 추기 위해 연주한다.
					IF TFLAG:193 > 0
						PRINTFORML %TNAME(TARGET,1)%은(는) 기분 좋게 춤을 춘다.
					ELSEIF TFLAG:193 < 0
						PRINTFORML %TNAME(TARGET,1)%이 불편해 보인다...
					ELSE
						PRINTFORML %TNAME(TARGET,1)%은 꾸준히 춤을 춘다...
					ENDIF
			ENDSELECT
		ENDIF
	CASE "ソース"
		IF !GROUPMATCH(1, MUSIC_ABLE(30), MUSIC_ABLE(31), MUSIC_ABLE(32), MUSIC_ABLE(33), MUSIC_ABLE(34), MUSIC_ABLE(35))
			;楽器が使えないと見てるだけ
			TFLAG:193 = -2
			DOWNBASE:MASTER:気力 += 20 * 時間係数
			DOWNBASE:TARGET:体力 += 10 * 時間係数
			DOWNBASE:TARGET:気力 += 20 * 時間係数
			SOURCE:歓楽 = (50 + ((ABL:親密 + ABL:MASTER:音楽技能) * 10)) * 時間係数
		ELSE
			DOWNBASE:MASTER:体力 += 40 * 時間係数
			DOWNBASE:MASTER:気力 += 40 * 時間係数
			DOWNBASE:TARGET:体力 += 20 * 時間係数
			DOWNBASE:TARGET:気力 += 20 * 時間係数
			SELECTCASE RAND:(10 + ABL:MASTER:音楽技能)
				CASE 0
					;失敗
					TFLAG:193 = -1
					SOURCE:歓楽 = (100 + ((ABL:親密 + ABL:MASTER:音楽技能) * 20)) * 時間係数
				CASE 1 TO 9
					;成功
					SOURCE:歓楽 = (150 + ((ABL:親密 + ABL:MASTER:音楽技能) * 50)) * 時間係数
					TFLAG:98 = 1
				CASEELSE
					;音楽技能があるとその確率で大成功
					TFLAG:193 = 1
					SOURCE:歓楽 = (200 + ((ABL:親密 + ABL:MASTER:音楽技能) * 80)) * 時間係数
					TFLAG:98 = 2
			ENDSELECT
			;その場にいる他のキャラにもソースが入る
			FOR LOCAL, 1, GET_TARGETNUM() + 1
			SIF TARGET:LOCAL == TARGET
				CONTINUE
			SIF !SHIRAHU(TARGET:LOCAL)
				CONTINUE
			SOURCE:(TARGET:LOCAL):歓楽 = ((150 + (50 * TFLAG:193)) + ((ABL:(TARGET:LOCAL):親密 + ABL:MASTER:音楽技能) * (50 + (30 * TFLAG:193)))) * 時間係数
			NEXT
			EXP:MASTER:演奏経験 ++
		ENDIF
ENDSELECT
