; Modular ERB: 自由行動/FREE_ACT_15_みんなにお説教たいむ.ERB

@EXIST_FreeAct15
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct15(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "様子をうかがう")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_15(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;屋外で発生
		SIF INROOM(現在地)
			RETURN 0
		;仕事予定の邪魔をしない
		SIF !CHARA_HOLIDAY(CHARA)
			RETURN 0
		;映姫様は常に起点
		SIF CHARA == 30
			GOTO START
		;小町/久侘歌以外の神霊と蓬莱人は対象外
		SIF CHECK_CHARA(CHARA, "蓬莱人") || (TALENT:CHARA:神霊 && !GROUPMATCH(CHARA, 76, 129))
			RETURN 0
		;映姫様がすでに説教中なら発生
		SIF Activity_Type:30 != 15 || 現在地 != CFLAG:30:現在位置 || !Activity_Duration:30
			RETURN 0
		$START
		IF メッセージ表示
			PRINTFORM %CALLNAME:CHARA% 
			IF CHARA == 30
				PRINTFORMW 은 %FA15_TARGET(0)%에게 설교를 시작한다.
			ELSE
				PRINTFORMW 은 \@ CHAIN ? %CALLNAME:CHAIN%의 설교에 합류한다 # 에이키의 설교에 휘말린다 \@...
			ENDIF
		ELSEIF CHARA == 30
			CALLF FA15_TARGET(0)
		ENDIF
		;自由行動にかける時間をRETURNする。小町のみ最低保障2時間
		IF CHARA == 30
			RETURN 60 + RAND:30
		ELSE
			LOCAL = 30 + RAND:60 + ((CHARA == 76) * 90)
			Activity_Duration:30 = MAX(Activity_Duration:30, LOCAL)
			RETURN LOCAL
		ENDIF
	CASE "行動中"
		;行動中の処理、地の文もここで。
		IF メッセージ表示
			IF CHARA == 30
				PRINTFORMW %CALLNAME:CHARA%은 %FA15_TARGET(1)%에게 %TEXTR("끝도 없이/장황하게/끊임없이/질릴 때까지/")% 설교한다...
			ELSEIF 現在地 != CFLAG:30:現在位置 || Activity_Type:30 != 15
				CALL FA15_RESET(CHARA)
			ELSE
				PRINTFORM %CALLNAME:CHARA%은 
				SELECTCASE CFLAG:CHARA:性格傾向
					;気弱系
					CASE 1
						PRINTFORM %TEXTR(@"눈물이 날 만큼/고개를 푹 숙인 채/훌쩍거리며/울먹이며")%
						;強気系
					CASE 2
						PRINTFORM %TEXTR(@"장난스럽게 혀를 내밀며/듣는 척하며/대부분 흘려들으며/거의 귀를 기울이지 않은 채")%
						;素直系
					CASE 3
						PRINTFORM %TEXTR(@"완전히 풀이 죽어/낙담한 채/기운이 빠진 채/모든 말에 성실히 고개를 끄덕이며/순종적으로 고개를 끄덕이며")%
						;真面目系
					CASE 4
						PRINTFORM %TEXTR(@"뉘우치며/미안해하며/반성하며/자신의 행동을 되돌아보며/진지하게 받아들이며")%
						;その他
					CASEELSE
						PRINTFORM %TEXTR(@"순종적으로/조용히/묵묵히")%
				ENDSELECT
				PRINTFORMW 에이키의 설교를 듣고 있다...
			ENDIF
		ELSEIF CHARA != 30 && 現在地 != CFLAG:30:現在位置
			CALL FA15_RESET(CHARA)
		ENDIF
	CASE "完了"
		;行動時間を使い切ったときの処理、地の文もここで
		IF メッセージ表示
			IF CHARA == 30
				PRINTFORMW 드디어, %CALLNAME:CHARA%가 %HIS_HER(CHARA)%의 강의를 마친 것 같다.
			ELSE
				PRINTDATAW
					DATAFORM 강의가 끝날 무렵, %CALLNAME:CHARA%은 \@ CFLAG:CHARA:性格傾向 == 2 ? 완전히 지쳐 보인다 # 안도의 한숨을 내쉰다 \@.
					DATAFORM %CALLNAME:CHARA% \@ CFLAG:CHARA:性格傾向 == 1 ? 강의가 끝난 후에도 여전히 눈물을 흘리고 있다 # 강의가 끝나자 작은 한숨을 내쉰다. \@
					DATAFORM 강의가 끝난 후, %CALLNAME:CHARA%은 \@ CFLAG:CHARA:性格傾向 == 4 ? 에이키에게 진심으로 감사한다 # 몹시 부끄럽고 당황한 기색이다 \@.
				ENDDATA
			ENDIF
		ENDIF
	CASE "中断"
		;中断メッセージはうふふ突入時等でも表示されてしまうので表示しない
		;説教する側がいなくなった場合の処理
		IF CHARA == 30
			FOR COUNT, 1, CHARANUM
			SIF Activity_Type:COUNT != 15
				CONTINUE
			CALL FA15_RESET(COUNT)
			NEXT
		ENDIF
	CASE "付き合う"
		;自由行動に付き合ったとき用メッセージ
		PRINTFORML 당신은 잠시 귀를 기울이고 강의를 캐주얼하게 듣는다.
		IF TFLAG:193
			PRINTFORML 에이키는 그 사실을 알아채고 너를 붙잡아 호되게 설교하기 시작한다!
		ELSE
			LOCALS = %\@ CHARA == 30 ? %FA15_TARGET(1)% # %CALLNAME:CHARA% \@%
			PRINTDATAL
				DATAFORM 당신은 그것이 언제 끝날지 전혀 모르는구나.
				DATAFORM 네가 그 대상이 아니어서 정말 다행이야.
				DATAFORM 가엾은 %LOCALS%에게 조금 안쓰럽게 느껴진다.
			ENDDATA
		ENDIF
	CASE "ソース"
		;付き合うコマンド選択時の入手ソース、時間係数は付き合った時間の1/10
		;ソースの基準よくわかんないので適当
		DOWNBASE:MASTER:気力 += 20 * 時間係数
		;15%でいっしょに説教されて入手ソース増/MASTER消費気力激増
		IF !RAND:6
			TFLAG:193 = 1
			SOURCE:30:歓楽 = (100 + ((ABL:30:親密 + 好感度係数(TARGET)) * 40)) * 時間係数
			SOURCE:30:征服 = (60 + (ABL:30:サドっ気 * 60)) * 時間係数
			IF TARGET != 30
				SOURCE:TARGET:受動 = (30 + ((ABL:従順 + 好感度係数(TARGET)) * 50)) * 時間係数
				SOURCE:TARGET:屈従 = (30 + ((ABL:従順 + 好感度係数(TARGET)) * 50)) * 時間係数
				DOWNBASE:TARGET:気力 += 10 * 時間係数
			ENDIF
			DOWNBASE:MASTER:気力 += 150 * 時間係数
		ELSE
			SOURCE:歓楽 = (50 + ((ABL:親密 + 好感度係数(TARGET)) * 30)) * 時間係数
			SOURCE:征服 = (20 + (ABL:サドっ気 * 50)) * 時間係数
			IF TARGET != 30
				SOURCE:TARGET:受動 = (20 + ((ABL:従順 + 好感度係数(TARGET)) * 20)) * 時間係数
				SOURCE:TARGET:屈従 = (20 + ((ABL:従順 + 好感度係数(TARGET)) * 20)) * 時間係数
				DOWNBASE:TARGET:気力 += 10 * 時間係数
			ENDIF
		ENDIF
ENDSELECT
;説教相手を表示する式中関数

@FA15_TARGET(ARG)
#FUNCTIONS
#DIM 累計
#DIMS モブ
#DIMS ネームド
;説教開始は仕様上常にモブキャラ
IF !ARG
	SELECTCASE GET_MAPID(CFLAG:30:現在位置)
		CASE 0
			モブ = 요괴
		CASE 1
			モブ = 참배객
		CASE 2
			モブ = %TEXTR("마을 소녀/마을 주민/")%
		CASE 3
			モブ = %TEXTR("요정 메이드/홉고블린/")%
		CASE 4
			モブ = 요괴 토끼
		CASE 5
			モブ = 둔갑 %TEXTR("고양이/너구리/여우/")%
		CASE 6
			モブ = %TEXTR("좀비 요정/사신/")%
		CASE 7
			モブ = 캇파
		CASE 8
			モブ = %TEXTR("신도/텐구/야마와로/")%
			SIF INRANGE(CFLAG:30:現在位置, 830, 850)
				モブ = 천인
		CASE 9
			モブ = 오니
		CASE 10
			モブ = %TEXTR("달토끼/월인/")%
	ENDSELECT
	LOCALS = %TEXTR("지나가던/근처의/우연히 마주친/그 지역의/구경하던/아무/")% %モブ%
	SIF !RAND:4 ;custom code, moved down here
		LOCALS += "―하필 제때 달아나지 못한 불운한 녀석"
	RETURNF LOCALS
	;映姫様と同じ場所にいて自由行動=15且つ行動時間中のキャラが説教され中
ELSE
	ネームド =
	累計 = 0
	FOR COUNT, 1, CHARANUM
	SIF COUNT == 30
		CONTINUE
	SIF CFLAG:30:現在位置 != CFLAG:COUNT:現在位置
		CONTINUE
	SIF Activity_Type:COUNT != 15 || !Activity_Duration:COUNT
		CONTINUE
	ネームド += @"%CALLNAME:COUNT%、"
	累計 ++
	NEXT
	SIF 累計
		RETURNF LIST_IN_STRING(ネームド)
	RETURNF モブ
ENDIF
;集合等での強制中断処理

@FA15_RESET(ARG)
Activity_Type:ARG = 0
Activity_Duration:ARG = 0
RETURN
