; Modular ERB: 自由行動/FREE_ACT_13.ERB

@EXIST_FreeAct13
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct13(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "晩酌に付き合う")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_13(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;酒飲めるキャラが夜間に憩いスペースにいる時
		SIF TALENT:CHARA:酒耐性 < 0
			RETURN 0
		SIF !INRANGE(TIME, 1200, 1440) && !INRANGE(TIME, 0, 120)
			RETURN 0
		SIF !憩いスペース(現在地)
			RETURN 0
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%은(는) \@ CHAIN ? %CALLNAME:CHAIN%에 합류한다 # 술을 좀 꺼내 하루를 마무리하기 시작한다 \@.
		RETURN 60 + RAND:30
	CASE "行動中"
		;ちょっとずつ酔う,酔いすぎるとSHIRAHUではなくなり中断されるので注意
		BASE:CHARA:酒気 += TIME_PROGRESS(TIME:1) * (RAND:3 + 1) * (4 - TALENT:CHARA:酒耐性)
		IF メッセージ表示
			PRINTFORMW %조사처리(CALLNAME:CHARA,"는")% %TEXTR("웃으며 술을 마시고 있다/술맛을 음미하고 있다/살짝 취기가 올랐다/편안히 술잔을 기울이고 있다")%.
		ENDIF
	CASE "完了"
		BASE:CHARA:酒気 += TIME_PROGRESS(TIME:1) * (RAND:3 + 1) * (4 - TALENT:CHARA:酒耐性)
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 %HIS_HER(CHARA)%의 음료를 마신 것 같다.
	CASE "中断"
		BASE:CHARA:酒気 += TIME_PROGRESS(TIME:1) * (RAND:3 + 1) * (4 - TALENT:CHARA:酒耐性)
	CASE "付き合う"
		;自由行動に付き合ったとき用メッセージ
		PRINTFORML 당신은 어느 저녁에 %조사처리(CALLNAME:TARGET,"와")% 함께 술을 마신다.
		SELECTCASE TALENT:TARGET:酒耐性
			CASE 0, 1
				PRINTFORML 따뜻한 사케를 마시며 즐거운 대화를 나눈다...
			CASE 2
				PRINTFORML 좋은 사케를 좀 마시면 취한다...
			CASEELSE
				PRINTFORML 정말 강하다...
		ENDSELECT
	CASE "ソース"
		;付き合うコマンド選択時の入手ソース、時間係数は付き合った時間の1/10
		;相手の酒耐性によって飲む酒が変わる,ソースも相手の酒耐性依存,なお酒耐性マイナスは晩酌しない
		DOWNBASE:MASTER:体力 += 20 * 時間係数
		DOWNBASE:MASTER:気力 += 10 * 時間係数
		CALL DRUNKEN(MASTER, MAX(50 + TALENT:TARGET:酒耐性, 51))
		SOURCE:歓楽 = (150 + ((ABL:親密 + TALENT:TARGET:酒耐性) * 50)) * 時間係数
		SOURCE:受動 = (100 + ((ABL:従順 + TALENT:TARGET:酒耐性) * 50)) * 時間係数
		SOURCE:征服 = (100 + ((ABL:サドっ気 + TALENT:TARGET:酒耐性) * 50)) * 時間係数
		TFLAG:98 = 1
ENDSELECT
