; Modular ERB: 自由行動/FREE_ACT_14.ERB

@EXIST_FreeAct14
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct14(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "買い物を手伝う")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_14(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;お店にいる時
		SIF !KAIDASHI_SHOP(現在地) && !FLOWER_SHOP(現在地) && !SAKE_SHOP(現在地) && !YASAI_SHOP(現在地)
			RETURN 0
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		SIF !INRANGE(TIME, 540, 1140)
			RETURN 0
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA% \@ CHAIN ? 합류한다 %CALLNAME:CHAIN% # 가져온다 %HIS_HER(CHARA)%의 쇼핑 바구니를 \@.
		RETURN 60 + RAND:30
	CASE "行動中"
		IF メッセージ表示
			PRINTFORMW %조사처리(CALLNAME:CHARA,"는")% %TEXTR("싼 물건을 찾고 있다/물건 하나를 집어 감정하고 있다/무엇을 살지 망설이고 있다/쇼핑을 하고 있다")%.
		ENDIF
	CASE "完了"
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 쇼핑을 마친 것 같다.
	CASE "中断"
	CASE "付き合う"
		;自由行動に付き合ったとき用メッセージ
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"와")% 함께 쇼핑을 한다.
		PRINTFORML %TNAME(TARGET,1)% %TEXTR(@"어떤 것을 사야 할지 궁금해한다... / 비슷한 제품군을 찾아보라고 말한다... / 당신에게 짐을 들게 한다...")%
	CASE "ソース"
		;付き合うコマンド選択時の入手ソース、時間係数は付き合った時間の1/10
		DOWNBASE:MASTER:体力 += 20 * 時間係数
		DOWNBASE:MASTER:気力 += 20 * 時間係数
		DOWNBASE:TARGET:体力 += 10 * 時間係数
		DOWNBASE:TARGET:気力 += 10 * 時間係数
		SOURCE:歓楽 = (200 + ((ABL:従順 + 好感度係数(TARGET))  * 50)) * 時間係数
		TFLAG:98 = 1
ENDSELECT
