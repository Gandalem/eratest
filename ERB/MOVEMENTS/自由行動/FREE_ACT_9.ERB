; Modular ERB: 自由行動/FREE_ACT_9.ERB

@EXIST_FreeAct9
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct9(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "採集を手伝う")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_9(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;採集Lv1以上のキャラが採集できる場所にいる時
		SIF TALENT:CHARA:採集Lv < 1
			RETURN 0
		SIF !GATHERING_SPOT(現在地)
			RETURN 0
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%은(는) \@ CHAIN ? %CALLNAME:CHAIN%의 채집을 돕기 시작한다 # 주변을 둘러보고 채집을 시작한다 \@.
		RETURN 60 + RAND:120
	CASE "行動中"
		IF メッセージ表示
			PRINTFORMW %조사처리(CALLNAME:CHARA,"는")% %TEXTR("주변을 살피고 있다/무언가를 발견한 듯하다/열심히 채집하고 있다/쓸 만한 재료를 찾아 둘러보고 있다")%.
		ENDIF
	CASE "完了"
		EXP:CHARA:採集経験 += 1
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 사냥을 마친 것 같다.
	CASE "中断"
		EXP:CHARA:採集経験 += 1
	CASE "付き合う"
		;自由行動に付き合ったとき用メッセージ
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"가")% 식량 찾기를 하는 것을 돕는다.
		PRINTFORML %TEXTR(@"%TNAME(TARGET,1)%희귀한 것을 찾고 있다.../찾는 것이 쉽지 않다.../쓸모 있는 것을 찾았다면, 그것을 %TNAME(TARGET)%에게 준다...")%
	CASE "ソース"
		;付き合うコマンド選択時の入手ソース、時間係数は付き合った時間の1/10
		DOWNBASE:MASTER:体力 += 20 * 時間係数
		DOWNBASE:MASTER:気力 += 40 * 時間係数
		DOWNBASE:TARGET:体力 += 10 * 時間係数
		DOWNBASE:TARGET:気力 += 20 * 時間係数
		SOURCE:歓楽 = (150 + ((ABL:親密 + TALENT:MASTER:採集Lv) * 50)) * 時間係数
		SOURCE:受動 = (100 + ((ABL:従順 + TALENT:MASTER:採集Lv) * 50)) * 時間係数
		TFLAG:98 = 1
		EXP:MASTER:採集経験 ++
ENDSELECT
