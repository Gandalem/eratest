; Modular ERB: 自由行動/FREE_ACT_11.ERB

@EXIST_FreeAct11
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct11(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "実験を手伝う")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;0だと30分か残り時間すべての小さい方
		CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_11(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;調合Lv1以上のキャラが調合できる場所（あなた私室以外）または自室にいる時
		SIF TALENT:CHARA:調合Lv < 1
			RETURN 0
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		;連鎖時はスキップ
		IF !CHAIN
			SIF PHARMACY_SPOT(現在地) != 2 && 現在地 != CFLAG:CHARA:神社在住
				RETURN 0
		ENDIF
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%은(는) \@ CHAIN ? %CALLNAME:CHAIN%을(를) 보조하기 시작한다 # 실험을 준비하기 시작한다 \@.
		RETURN 60 + RAND:30
	CASE "行動中"
		IF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA% %TEXTR("is adjusting some scientific instruments/is lining up tools for an experiment/is writing things down/is performing suspicious experiments")%.
		ENDIF
	CASE "完了"
		EXP:CHARA:調合経験 += 1
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 실험을 마친 것 같다.
	CASE "中断"
		EXP:CHARA:調合経験 += 1
	CASE "付き合う"
		;自由行動に付き合ったとき用メッセージ
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"가")% 실험을 하는 것을 돕는다.
		SELECTCASE RAND:3
			CASE 1
				PRINTFORML 당신은 %TNAME(TARGET)%이 정확히 무엇을 이루려 하는지 확신하지 못한다...
			CASE 2
				PRINTFORML 위험 물질을 다루느라 신경이 날카로워진다...
			CASEELSE
				PRINTFORML %TNAME(TARGET,1)%은(는) %HIS_HER(TARGET)%의 얼굴에 만족스러운 미소를 띠고 있다…
		ENDSELECT
	CASE "ソース"
		;付き合うコマンド選択時の入手ソース、時間係数は付き合った時間の1/10
		DOWNBASE:MASTER:体力 += 20 * 時間係数
		DOWNBASE:MASTER:気力 += 40 * 時間係数
		DOWNBASE:TARGET:体力 += 10 * 時間係数
		DOWNBASE:TARGET:気力 += 20 * 時間係数
		SOURCE:歓楽 = (150 + ((ABL:親密 + TALENT:MASTER:調合Lv) * 50)) * 時間係数
		SOURCE:受動 = (100 + ((ABL:従順 + TALENT:MASTER:調合Lv) * 50)) * 時間係数
		TFLAG:98 = 1
		EXP:MASTER:調合経験 ++
ENDSELECT
