; Modular ERB: 自由行動/FREE_ACT_17_雪だるま.ERB

@EXIST_FreeAct17
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct17(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
経過時間 = Activity_Duration:TARGET
SELECTCASE O_DATA
	;自由行動に付き合うコマンドの名称
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "一緒に雪作り")
	CASE "CHAIN"
		;他キャラに連鎖しない場合コメントアウトすること
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;未入力だと最大30分
		;	CALLF MAKE_INT(V_NAME, 0)
ENDSELECT

@自由行動内容_17(CHARA, ARGS, 時間係数, CHAIN=0)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
#DIMS 作品
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		;冬の屋外で訓練できる場所
		SIF !OUTROOF(現在地)
			RETURN 0
		SIF !戦闘訓練可(現在地)
			RETURN 0
		SIF DAY:2 != 4
			RETURN 0
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		;積もってないとダメ
		SIF YOGORE:現在地 < 500
			RETURN 0
		;吹雪,猛吹雪中はダメ
		SIF GROUPMATCH(天候, 10)
			RETURN 0
		SIF FLAG:異常気象 == 10
			RETURN 0
		;連鎖でない場合は先に作ってあったらダメ
		SIF !CHAIN && FA17_OBJ:(現在地 % 100)
			RETURN 0
		;ここから作成決定後の処理
		;連鎖でない場合、作成位置と作成者を記録
		IF !CHAIN
			CALL FA17_OBJNAME(CHARA, 現在地)
			FA17_OBJ:(現在地 % 100) = CHARA
			FA17_TYPE:(現在地 % 100) = RESULT:1
			作品 = %RESULTS%
		ELSE
			CALL FA17_OBJNAME(CHARA, 現在地)
		ENDIF
		IF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA% \@ CHAIN ? 에 합류하여 %CALLNAME:CHAIN%와 함께 도움을 주기 시작하고 %RESULTS% # 건설을 시작한다 %ARTICLE(RESULTS)% \@.
			FA17_EXIST:(現在地 % 100) += 10
		ENDIF
		RESULT = CHAIN ? 1 # RESULT
		RETURN RESULT
	CASE "行動中"
		;ちょっとだけ掃除される
		YOGORE:(現在地) = MAX(YOGORE:(現在地) -50 * TIME_PROGRESS(TIME:1) / 5, 0)
		IF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA% %TEXTR(@"is %SPLIT_G("gathering:collecting")% snow/is patting down the snow, making it harder/is shaping up the snow")%.
			FA17_EXIST:(現在地 % 100) += 10
		ENDIF
	CASE "完了"
		IF メッセージ表示
			CALL FA17_OBJNAME(FA17_OBJ:(現在地 % 100), 現在地) ;custom code
			PRINTFORMW %CALLNAME:CHARA% %SPLIT_G("appears happy to complete:seems satisfied to have completed")% 그 %RESULTS%.
			FA17_EXIST:(現在地 % 100) += 10
		ENDIF
		;作成完了のフラグ
		SIF FA17_OBJ:(現在地 % 100)
			FA17_OBJ:(現在地 % 100) += 1000
	CASE "中断"
		;中断メッセージはうふふ突入時等でも表示されてしまうので表示しない
	CASE "付き合う"
		CALL FA17_OBJNAME(FA17_OBJ:(現在地 % 100), 現在地) ;custom code
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"가")% %RESULTS%를 짓는 것을 도와준다.
	CASE "ソース"
		;遊びに付き合うと一緒
		DOWNBASE:MASTER:体力 += 40 * 時間係数
		DOWNBASE:MASTER:気力 += 40 * 時間係数
		DOWNBASE:TARGET:体力 += 20 * 時間係数
		DOWNBASE:TARGET:気力 += 20 * 時間係数
		SOURCE:歓楽 = (150 + ((ABL:親密 + 好感度係数(TARGET)) * 50)) * 時間係数
		SOURCE:受動 = (100 + ((ABL:従順 + 好感度係数(TARGET)) * 50)) * 時間係数
		SOURCE:征服 = (100 + (ABL:サドっ気 * 100)) * 時間係数
		TFLAG:98 = 1
ENDSELECT

@FA17_OBJNAME(CHARA, LOCATION) ;also used in ANOTHER_TALK.ERB
#DIM CHARA
#DIM 作成者
#DIM LOCATION ;custom code
RESULT:1 = 0 ;custom code
SIF !LOCATION ;custom code
	LOCATION = CFLAG:CHARA:現在位置
LOCAL = 30
作成者 = CHARA > 1000 ? CHARA % 1000 # CHARA
RESULTS:1 = on display
CALL KOJO_CHECK(作成者, "SNOWMAN",,LOCATION)
IF RESULT
	RETURN RESULT + RAND:30
ENDIF
SELECTCASE NO:作成者
	CASE [[瓔花]]
		RESULTS = super multistage snowman
		RESULTS:1 = %SPLIT_G("standing tall:towering above you")%
		LOCAL = 90
	CASE [[幽香]]
		RESULTS = ice flower
		LOCAL = 40
	CASE [[ぬえ]]
		RESULTS = snow alien
		RESULTS:1 = staring right at you ominously..
	CASE [[マミゾウ]]
		RESULTS = snow tanuki
		RESULTS:1 = with a single leaf placed on top
	CASE [[ミケ]]
		RESULTS = snow lucky cat
	CASE [[魅須丸]]
		RESULTS = yin-yang snowball
		RESULTS:1 = floating buoyantly
	CASE [[磨弓]], [[袿姫]]
		RESULTS = snow Haniwa
		RESULTS:1 = that are \@ NO:作成者 == [[磨弓]] ? standing in a line # moving around.. \@
		LOCAL = 40
	CASE [[里香]]
		RESULTS = snow tank
		RESULTS:1 = left in there
		LOCAL = 60
	CASEELSE
		;ウサミミ
		IF TALENT:作成者:動物耳 == 2
			RESULTS = snow rabbit
			;月人
		ELSEIF GET_TRIBENAME(作成者, GETNUM(TALENT, "人間")) == "月人"
			RESULTS = snow rabbit
			;教養3以上
			;addition custom code, duplicated characters
			;ELSEIF CSVABL(NO:作成者, GETNUM(ABL, "教養")) >= UniversalRank("B")
		ELSEIF ABL:作成者:教養 >= UniversalRank("B")
			RESULTS = snow rabbit
		ELSE
			RESULTS = snowman
			RESULTS:1 = standing there
		ENDIF
		SIF CHARA > 1000
			RESULTS = %\@ RESULTS == "snowman" ? huge # lovely \@% %RESULTS%
ENDSELECT
RETURN LOCAL + RAND:30
