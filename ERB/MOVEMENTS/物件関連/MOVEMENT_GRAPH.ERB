@GRAPH_WALK_ALL_PATHS
#DIM INTERIM_TIME
#DIM SOURCE_NODE
#DIM SOURCE_NODE_INDEX
#DIM DESTINATION_NODE
#DIM DESTINATION_NODE_INDEX
#DIM START_INDEX

VARSET GRAPH_DISTANCE, __INT_MAX__
VARSET GRAPH_PREVIOUS, -1
VARSET GRAPH_NEIGHBORS_MOVE, -1
VARSET GRAPH_NEIGHBORS_MOVE_INDEX, 0
VARSET GRAPH_NEIGHBORS_VISIBLE, -1
VARSET GRAPH_NEIGHBORS_VISIBLE_INDEX, 0
VARSET GRAPH_NEIGHBORS_VISIBLE_FROM, -1
VARSET GRAPH_NEIGHBORS_VISIBLE_FROM_INDEX, 0
START_INDEX = MAIN_MAP * 100

;get all valid edges
FOR SOURCE_NODE, MINROOM(), MAXROOM + 1
	SOURCE_NODE_INDEX = SOURCE_NODE % 100
	SIF STR:(8000 + SOURCE_NODE) == "" && SOURCE_NODE != MAXROOM
		CONTINUE

	FOR DESTINATION_NODE, MINROOM(), MAXROOM + 1
		SIF SOURCE_NODE == DESTINATION_NODE
			CONTINUE
		DESTINATION_NODE_INDEX = DESTINATION_NODE % 100
		SIF STR:(8000 + DESTINATION_NODE) == ""
			CONTINUE
		LOCAL = CAN_MOVE(SOURCE_NODE, DESTINATION_NODE)
		SIF GETBIT(LOCAL, 0)
			GRAPH_NEIGHBORS_MOVE:SOURCE_NODE_INDEX:(GRAPH_NEIGHBORS_MOVE_INDEX:SOURCE_NODE_INDEX++) = DESTINATION_NODE
		IF GETBIT(LOCAL, 1)
			GRAPH_NEIGHBORS_VISIBLE:SOURCE_NODE_INDEX:(GRAPH_NEIGHBORS_VISIBLE_INDEX:SOURCE_NODE_INDEX++) = DESTINATION_NODE
			GRAPH_NEIGHBORS_VISIBLE_FROM:DESTINATION_NODE_INDEX:(GRAPH_NEIGHBORS_VISIBLE_FROM_INDEX:DESTINATION_NODE_INDEX++) = SOURCE_NODE
		ENDIF
	NEXT
NEXT

FOR SOURCE_NODE, MINROOM(), MAXROOM + 1
	SIF STR:(8000 + SOURCE_NODE) == "" && SOURCE_NODE != MAXROOM
		CONTINUE
	CALL GRAPH_WALK_DIJKSTRA(SOURCE_NODE)
NEXT

;validate locations by checking if they can reach and be reached from the entrance
SETCOLOR C_YELLOW
FOR DESTINATION_NODE, MINROOM(), MAXROOM + 1
	SIF STR:(8000 + DESTINATION_NODE) == "" && DESTINATION_NODE != MAXROOM
		CONTINUE
	SIF DESTINATION_NODE == ENTRANCE
		CONTINUE
	IF GRAPH_DISTANCE:(ENTRANCE % 100):(DESTINATION_NODE % 100) == __INT_MAX__ && DESTINATION_NODE != MAXROOM
		PRINTFORML Location {DESTINATION_NODE} (%NAME_FROM_PLACE(DESTINATION_NODE)%) cannot be reached.
	ELSEIF GRAPH_DISTANCE:(DESTINATION_NODE % 100):(ENTRANCE % 100) == __INT_MAX__
		PRINTFORML Location {DESTINATION_NODE} (%NAME_FROM_PLACE(DESTINATION_NODE)%) cannot be escaped.
	ENDIF
NEXT
RESETCOLOR

;use dijkstra's algorithm to walk all possible paths from the source
@GRAPH_WALK_DIJKSTRA(SOURCE_NODE)
#DIM SOURCE_NODE
#DIM DYNAMIC QUEUE, GRAPH_NODE_MAX
#DIM DYNAMIC QUEUE_INDEX = 0
#DIM SOURCE_NODE_INDEX
#DIM CURRENT_NODE
#DIM CURRENT_NODE_INDEX
#DIM NEXT_NODE
#DIM NEXT_NODE_INDEX
#DIM NEXT_DISTANCE
SOURCE_NODE_INDEX = SOURCE_NODE % 100

QUEUE:0 = SOURCE_NODE
QUEUE_INDEX = 1
GRAPH_DISTANCE:SOURCE_NODE_INDEX:SOURCE_NODE_INDEX = 0

WHILE QUEUE_INDEX > 0
	CURRENT_NODE = QUEUE:0
	ARRAYREMOVE QUEUE, 0, 1
	QUEUE_INDEX--

	CURRENT_NODE_INDEX = CURRENT_NODE % 100
	NEXT_DISTANCE = GRAPH_DISTANCE:SOURCE_NODE_INDEX:CURRENT_NODE_INDEX + 1
	FOR LOCAL, 0, GRAPH_NEIGHBORS_MOVE_INDEX:CURRENT_NODE_INDEX
		NEXT_NODE = GRAPH_NEIGHBORS_MOVE:CURRENT_NODE_INDEX:LOCAL
		NEXT_NODE_INDEX = NEXT_NODE % 100
		SIF NEXT_DISTANCE >= GRAPH_DISTANCE:SOURCE_NODE_INDEX:NEXT_NODE_INDEX
			CONTINUE
		
		QUEUE:(QUEUE_INDEX++) = NEXT_NODE
		GRAPH_DISTANCE:SOURCE_NODE_INDEX:NEXT_NODE_INDEX = NEXT_DISTANCE
		GRAPH_PREVIOUS:SOURCE_NODE_INDEX:NEXT_NODE_INDEX = CURRENT_NODE
	NEXT
WEND

@MOVEMENT_DISTANCE(START_POSITION, END_POSITION)
#FUNCTION
#DIM START_POSITION
#DIM END_POSITION
LOCAL = GRAPH_DISTANCE:(START_POSITION % 100):(END_POSITION % 100)
IF LOCAL == __INT_MAX__
	RETURNF -1
ELSE
	RETURNF LOCAL
ENDIF

@MOVEMENT_NEXT_LOCATIONS(START_POSITION, END_POSITION)
#FUNCTION
#DIM START_POSITION
#DIM END_POSITION
#DIM CURRENT_LOCATION
VARSET RESULT, -1
SIF START_POSITION == END_POSITION
	RETURNF START_POSITION
CURRENT_LOCATION = END_POSITION
WHILE 1
	LOCAL = GRAPH_PREVIOUS:(START_POSITION % 100):(CURRENT_LOCATION % 100)
	IF LOCAL == -1
		RETURNF -1
	ELSE
		RESULT:(GRAPH_DISTANCE:(START_POSITION % 100):(CURRENT_LOCATION % 100) - 1) = CURRENT_LOCATION
		SIF LOCAL == START_POSITION
			BREAK
	ENDIF
	CURRENT_LOCATION = LOCAL
WEND
RETURNF RESULT

@MOVEMENT_NEAREST_VALID(ARG, MINIMUM_DISTANCE = 1)
#DIM DYNAMIC NODES, GRAPH_NODE_MAX
#DIM DYNAMIC DISTANCES, GRAPH_NODE_MAX = __INT_MAX__
#DIM CURRENT_LOCATION
#DIM MINIMUM_DISTANCE
CURRENT_LOCATION = CFLAG:ARG:現在位置 % 100
FOR LOCAL, MINROOM(), MAXROOM
	NODES:(LOCAL % 100) = LOCAL
	DISTANCES:(LOCAL % 100) = GRAPH_DISTANCE:CURRENT_LOCATION:(LOCAL % 100)
NEXT
ARRAYMSORT DISTANCES, NODES
FOR LOCAL, 1, GRAPH_NODE_MAX
	SIF DISTANCES:LOCAL < MINIMUM_DISTANCE
		CONTINUE
	CALL MOVEMENT_WILLING(ARG, NODES:LOCAL)
	SIF RESULT
		RETURN NODES:LOCAL
NEXT
RETURN ENTRANCE

@MOVEMENT_WILLING(ARG, LOCATION)
#DIM LOCATION
RESULT = 0
RESULT:1 = 0

IF ARG > 0
	CALL KOJO_CHECK(ARG, "CHARADATA", "MOVE", 4, LOCATION)
	IF RESULT
		RESULT = RESULT:1
	ELSE
		TRYCALLFORM CHARAMOVE_DATA_{NO:ARG}(4, LOCATION)
	ENDIF
ENDIF

SIF RESULT > -100 && MAP_CAN_MOVE(LOCATION, ARG)
	RETURN 1

@DEBUG_PRINT_GRAPH(SOURCE_NODE)
#FUNCTION
#DIM SOURCE_NODE
#DIM DESTINATION_NODE
#DIM SOURCE_NODE_INDEX
#DIM DESTINATION_NODE_INDEX
SOURCE_NODE_INDEX = SOURCE_NODE % 100

PRINTFORMDL Routing info for {SOURCE_NODE} (%NAME_FROM_PLACE(SOURCE_NODE)%):
PRINTFORMDL %" "*50%       Distance       Previous Node
FOR DESTINATION_NODE, MINROOM(), MAXROOM + 1
	DESTINATION_NODE_INDEX = DESTINATION_NODE % 100
	SIF STR:(8000 + DESTINATION_NODE) == ""
		CONTINUE
	PRINTFORMD {DESTINATION_NODE, 4, RIGHT}. %@"(%NAME_FROM_PLACE(DESTINATION_NODE)%)", 42, LEFT%: 
	IF GRAPH_DISTANCE:SOURCE_NODE_INDEX:DESTINATION_NODE_INDEX == __INT_MAX__
		PRINTFORMDL %"Unreachable", 15, RIGHT%%"Unreachable", 20, RIGHT%
	ELSE
		PRINTFORMDL {GRAPH_DISTANCE:SOURCE_NODE_INDEX:DESTINATION_NODE_INDEX, 15, RIGHT}{GRAPH_PREVIOUS:SOURCE_NODE_INDEX:DESTINATION_NODE_INDEX, 20, RIGHT}
	ENDIF
NEXT
