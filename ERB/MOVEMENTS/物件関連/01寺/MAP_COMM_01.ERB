; Modular ERB: 物件関連/01寺/MAP_COMM_01.ERB
;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------

@MAP_PLACENAME_1(ARG, ARG:1) ;custom code
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE P134蔵 ;qol custom code
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:MASTER + "의 방"
			ELSE
				RETURNF "창고"
			ENDIF
		CASE SUMIKOMI_ROOM
			;※このマップでは未実装
			IF FLAG:住み込みキャラ
				RETURNF CALLNAME:(FLAG:住み込みキャラ) + "의 방"
			ELSE
				RETURNF "빈방"
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			RETURNF ARG:1 ? STR:(ARG + 8000) # STR_TR(ARG + 8000) ;custom code
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "틈새 공간"
		CASE MAXROOM
			RETURNF "입구 너머"
		CASEELSE
			RETURNF "미지의 장소"
	ENDSELECT
ELSE
	RETURNF "길 너머"
ENDIF
;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するマップの番号と連動（TFLAG:マップ切り替え）
;ARG     場所ID
;--------------------------------------------------

@MAP_AREASELECT_1(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P140お地蔵通り
		RETURNF 1
		;命蓮寺
	CASE P101山門 TO P122梵鐘楼, P135廊下 TO P137マミゾウの棲家
		RETURNF 1
		;神霊廟
	CASEELSE
		RETURNF 2
ENDSELECT
;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------

@GETMAP_BUILDING_1(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
		;神霊廟
		CASE P123霊廟大門
			SELECTCASE Q_ID
				CASE P123霊廟大門 TO P134蔵, P138鐘楼, P139邪仙楼
					RETURNF 1
			ENDSELECT
	ENDSELECT
ELSEIF TFLAG:マップ切り替え == 2
	SELECTCASE P_ID
		;命蓮寺
		CASE P101山門
			SELECTCASE Q_ID
				CASE P101山門 TO P122梵鐘楼, P135廊下 TO P137マミゾウの棲家
					RETURNF 1
			ENDSELECT
	ENDSELECT
ENDIF
RETURNF 0
;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------

@MAP_CAN_MOVE_1(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
	;誰かが住んでないと入れない
	CASE P119離れ
		IF !PRIVATEROOM:(ARG % 100) && CFLAG:MASTER:初期位置 != ARG
			TFLAG:移動不能メッセージ = 999
			RETURNF 0
		ENDIF
ENDSELECT
RETURNF 1
;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------

@MAP_CANNOT_WORD_1(ARG)
RETURN
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW ※여기에 메시지를 넣는다. 행수+1의 CLEARLINE을 한다
		CLEARLINE 2
ENDSELECT
REUSELASTLINE
;-----------------------------------------
;拠点専用の情景描写
;WAITはかけないように
;-----------------------------------------

@MAP_UNIQUEMESSAGE_1
VARSET LOCAL
;addition custom code
LOCAL:90 = MAIN_MAP != 1 ? 墓地 # P121墓地
LOCAL:91 = MAIN_MAP != 1 ? 命蓮寺方丈 # P104講堂
LOCAL:92 = MAIN_MAP != 1 ? 神霊廟広場 # P129客間
LOCAL:93 = MAIN_MAP != 1 ? 命蓮寺境内 # P110縁側
SELECTCASE CFLAG:MASTER:現在位置
	CASE LOCAL:90 ;addition custom code
		CALL Add_Epitapth
		RETURN 1
	CASE LOCAL:91 ;addition custom code
		PRINTFORML 여기에 큰 물고기 종이 있다.
		RETURN 1
	CASE LOCAL:92 ;addition custom code
		PRINTFORML 여기에 나무로 조각된 곰이 있다.
		RETURN 1
	CASE LOCAL:93 ;addition custom code
		PRINTFORML 무(大根)가 처마에서 걸려있다.
		RETURN 1
	CASE P119離れ
		FOR LOCAL, 1, CHARANUM
		IF CFLAG:LOCAL:現在位置 == P112風呂
			LOCAL:1 = LOCAL
			LOCAL:2 ++
		ENDIF
		NEXT
		IF !LOCAL:2
			PRINTFORML 방을 나가지 않고 욕조 안을 들여다볼 수 있게 해주는 비밀 장치가 있다.
		ELSE
			PRINTFORML 장치 %CALLNAME:(LOCAL:1)%은(는) %COND_STR(@" 및 기타", LOCAL:2 > 1)%이 목욕하는 것을 볼 수 있다.
			PRINTFORML 실로 장관을 이루는 광경이다!
		ENDIF
		RETURN 1
	CASEELSE
ENDSELECT
;-----------------------------------------
;拠点の場所IDをお出かけマップ上の場所IDに置換する関数
;ARG      対象の場所ID（拠点マップ）
;RETURNF  差し替え場所ID（お出かけマップ）
;-----------------------------------------

@MAP_SEARCH_REPLACEMENT_1(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P140お地蔵通り
		RETURNF お地蔵通り
	CASE P101山門 TO P106裏庭, P119離れ, P120物置, P122梵鐘楼, P137マミゾウの棲家
		RETURNF 命蓮寺境内
	CASE P121墓地
		RETURNF 墓地
	CASE P123霊廟大門, P124霊廟広場, P138鐘楼, P139邪仙楼
		RETURNF 神霊廟広場
	CASE P125屠自古私室 TO P134蔵
		RETURNF 神霊廟道場
	CASEELSE
		RETURNF 命蓮寺方丈
ENDSELECT
RETURNF 0
