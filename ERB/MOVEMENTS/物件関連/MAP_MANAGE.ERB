;マップ内の採集可能地点を表示する関数

@ShowGatheringSpots(ARG)
#DIM cStart
#DIM cEnd
#DIM SpotID
#DIM Num
#DIM Wordcount
#DIM pCount
cStart = 1 + ARG * 100
cEnd = 99 + ARG * 100
Num = 0
pCount = 0
FOR LOCAL, cStart, cEND
SpotID = GATHERING_SPOT(LOCAL, 1)
IF SpotID
	pCount ++
	STRLENFORM %ForagePlaceName(SpotID)%
	Wordcount = RESULT:0
	Num += Wordcount
	IF Num > 110
		PRINTL
		PRINTFORM 　　　　　　　　
		Num = Wordcount
	ENDIF
	PRINTFORM %ForagePlaceName(SpotID)%
	SIF Num <= 106
		PRINTFORM 　　
ENDIF
NEXT
SIF !pCount
	PRINT 없음
PRINTFORML

