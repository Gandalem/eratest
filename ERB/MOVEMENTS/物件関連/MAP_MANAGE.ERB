ENDIF
IF GETBIT(nData,1)
	PRINTFORM 유독한 대기(보통)      
ENDIF
IF GETBIT(nData,2)
	PRINTFORM 유독한 대기 (심함)      
ENDIF
IF GETBIT(nData,3)
	PRINTFORM 독성 대기 (극심함)      
ENDIF
IF GETBIT(nData,4)
	PRINTFORM 극심한 온도 (더움)      
ENDIF
IF GETBIT(nData,5)
	PRINTFORM 극심한 온도(추위)      
ENDIF
IF GETBIT(nData,6)
	PRINTFORM 성간 여행 필요      
ENDIF
IF !nData
	PRINTFORM 인간에게 안전하다
ENDIF

@MapHabitability(ARG)
#FUNCTION
#DIM DYNAMIC nHabitData
SELECTCASE ARG
	CASE 5
		SETBIT nHabitData, 0
	CASE 10
		SETBIT nHabitData, 6
	CASE 11
		SELECTCASE K102_UPDATE:6
			CASE 3
				SETBIT nHabitData, 3
			CASE 2
				SETBIT nHabitData, 1
			CASEELSE
		ENDSELECT
ENDSELECT
RETURNF nHabitData
