; Modular ERB: 物件関連/03紅魔館/MAP_COMM_03.ERB
;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------

@MAP_PLACENAME_3(ARG, ARG:1) ;custom code
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE P304空き小屋
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:MASTER + "의 오두막"
			ELSE
				RETURNF "빈 오두막"
			ENDIF
		CASE SUMIKOMI_ROOM
			IF FLAG:住み込みキャラ
				RETURNF CALLNAME:(FLAG:住み込みキャラ) + "의 방"
			ELSE
				RETURNF "빈방"
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			RETURNF ARG:1 ? STR:(ARG + 8000) # STR_TR(ARG + 8000) ;custom code
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "틈새 공간"
		CASE MAXROOM
			RETURNF "안개 너머"
		CASEELSE
			RETURNF "미지의 장소"
	ENDSELECT
ELSE
	RETURNF "호수 너머"
ENDIF
;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するマップの番号と連動（TFLAG:マップ切り替え）
;ARG     場所ID
;--------------------------------------------------

@MAP_AREASELECT_3(ARG)
#FUNCTION
SELECTCASE ARG
	;紅魔館・一階＆地下
	CASE P301正門 TO P316一階トイレ, P328地下廊下 TO P333大浴場
		RETURNF 2
		;紅魔館・二階＆三階
	CASE P319二階廊下 TO P327小バルコニー
		RETURNF 3
		;廃洋館
	CASE P334廃洋館・入り口 TO P342リリカ私室
		RETURNF 4
		;霧の湖
	CASEELSE
		RETURNF 1
ENDSELECT
;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------

@GETMAP_BUILDING_3(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
		;紅魔館
		CASE P301正門
			SELECTCASE Q_ID
				CASE P301正門 TO P333大浴場
					RETURNF 1
			ENDSELECT
			;廃洋館
		CASE P334廃洋館・入り口
			SELECTCASE Q_ID
				CASE P334廃洋館・入り口 TO P342リリカ私室
					RETURNF 1
			ENDSELECT
	ENDSELECT
ELSEIF TFLAG:マップ切り替え == 2
	SELECTCASE P_ID
		;紅魔館・二階＆三階
		CASE P319二階廊下
			SELECTCASE Q_ID
				CASE P319二階廊下 TO P327小バルコニー
					RETURNF 1
			ENDSELECT
	ENDSELECT
ELSEIF TFLAG:マップ切り替え == 3
	SELECTCASE P_ID
		;紅魔館・一階＆地下
		CASE P309広間
			SELECTCASE Q_ID
				CASE P309広間 TO P316一階トイレ, P328地下廊下 TO P333大浴場
					RETURNF 1
			ENDSELECT
	ENDSELECT
ENDIF
RETURNF 0
;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------

@MAP_CAN_MOVE_3(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
	;湖底
	CASE P348霧の湖・湖底
		;水棲でないと入れない
		;Custom code: Oxygen Mask and Sky-Blue Magatama work too
		IF !TALENT:CHARA:水棲 && !ITEM:避水の玉 && !ITEM:空色の勾玉 && !ITEM:酸素マスク
			TFLAG:移動不能メッセージ = 1
			RETURNF 0
		ENDIF
		;誰かが住んでないと入れない
	CASE P304空き小屋;, P321空き部屋 ;addition custom code - allow access to vacant room when it's unoccupied (vacant hut is PC's default location so there's no need to tweak it)
		IF !PRIVATEROOM:(ARG % 100) && CFLAG:MASTER:初期位置 != ARG
			TFLAG:移動不能メッセージ = 999
			RETURNF 0
		ENDIF
ENDSELECT
RETURNF 1
;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------

@MAP_CANNOT_WORD_3(ARG)
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW 당신은 익사할 것이다.
		CLEARLINE 2
ENDSELECT
REUSELASTLINE
;-----------------------------------------
;拠点専用の情景描写
;WAITはかけないように
;-----------------------------------------

@MAP_UNIQUEMESSAGE_3
;addition custom code
LOCAL:90 = MAIN_MAP != 3 ? 地下室 # P328地下廊下
IF WITH_MOB() && MAIN_MAP == 3 ;addition custom code
	CALL MOB_MESSAGE_3
	RETURN 1
ELSEIF !FLAG:時間停止
	SELECTCASE CFLAG:MASTER:現在位置
		;custom code, readded
		CASE LOCAL:90 ;addition custom code
			PRINTFORML 지하실에서 비명이 들린다...
			RETURN 1
		CASE P329倉庫
			PRINTFORML 여기 고양이가 있다.
			RETURN 1
	ENDSELECT
ENDIF
;-----------------------------------------
;拠点の場所IDをお出かけマップ上の場所IDに置換する関数
;ARG      対象の場所ID（拠点マップ）
;RETURNF  差し替え場所ID（お出かけマップ）
;-----------------------------------------

@MAP_SEARCH_REPLACEMENT_3(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P343湖畔, P346大妖精の棲家 TO P348霧の湖・湖底
		RETURNF 霧の湖
	CASE P344レティのかまくら, P345チルノのかまくら
		RETURNF 氷のかまくら
	CASE P334廃洋館・入り口 TO P342リリカ私室
		RETURNF 廃洋館
	CASE P301正門 TO P308西テラス
		RETURNF 正門
	CASE P313厨房, P314食堂
		RETURNF 食堂
	CASE P310図書館 TO P312小悪魔私室
		RETURNF 大図書館
	CASE P328地下廊下 TO P333大浴場
		RETURNF 地下室
	CASEELSE
		RETURNF 広間
ENDSELECT
RETURNF 0
;--------------------------------------------------
;マップの紹介文
;--------------------------------------------------

@マップ紹介_3
;とりあえず5行
PRINTFORML %nameArray:16:na_LastName% 악마 저택과 미스티 호수를 중심으로, %nameArray:22:na_LastName% %PRINT_MALE("형제:자매",22)%이 사는 폐허가 포함되어 있다.
PRINTFORML 가장 큰 특징은 이곳에만 존재하는 카지노이다.
PRINTFORML 물이 사케를 빚거나 낚시하기 좋으며, 매우 편리한 장소다.
PRINTFORML 흡혈귀 저택답게 일부 거주자들이 밤에 활동을 시작하므로 알람을 조정해야 할 수도 있다.
PRINTFORML 일손을 도울 곳은 부족함이 없지만, 요정 직원들 덕분에 저택 내부는 놀라울 정도로 깨끗하다.
PRINTFORML 참고: 번역된 문자가 많다.
