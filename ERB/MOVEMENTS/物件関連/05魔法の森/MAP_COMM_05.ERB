; Modular ERB: 物件関連/05魔法の森/MAP_COMM_05.ERB
;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------

@MAP_PLACENAME_5(ARG, ARG:1) ;custom code
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE P515魔理沙宅・倉庫 ;qol custom code
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF "마리사의 집・" + CALLNAME:MASTER + "의 방"
			ELSE
				RETURNF "마리사의 집・창고"
			ENDIF
		CASE P536エレン宅・倉庫 ;qol custom code
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF "엘렌의 집・" + CALLNAME:MASTER + "의 방"
			ELSE
				RETURNF "엘렌의 집・창고"
			ENDIF
			;---------------------------------------------
		CASE P531人形の館・空き部屋
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF "인형관・" + CALLNAME:MASTER + "의 방"
			ELSE
				RETURNF "인형관・빈방"
			ENDIF
		CASE SUMIKOMI_ROOM
			;※このマップでは未実装
			IF FLAG:住み込みキャラ
				RETURNF CALLNAME:(FLAG:住み込みキャラ) + "의 방"
			ELSE
				RETURNF "빈방"
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			RETURNF ARG:1 ? STR:(ARG + 8000) # STR_TR(ARG + 8000) ;custom code
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "틈새 공간"
		CASE MAXROOM
			RETURNF "마법의 숲 바깥"
		CASEELSE
			RETURNF "알 수 없음"
	ENDSELECT
ELSE
	RETURNF "마법의 숲 바깥"
ENDIF
;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するマップの番号と連動（TFLAG:マップ切り替え）
;ARG     場所ID
;--------------------------------------------------

@MAP_AREASELECT_5(ARG)
#FUNCTION
SELECTCASE ARG
	;魔理沙宅
	CASE P510霧雨魔法店 TO P515魔理沙宅・倉庫
		RETURNF 3
		;人形の洋館
	CASE P521人形の館・アリスの部屋 TO P531人形の館・空き部屋
		RETURNF 2
		;ふわふわエレンの店
	CASE P534ふわふわエレン魔法の店 TO P537エレン宅・風呂
		RETURNF 4
		;魔法の森
	CASEELSE
		RETURNF 1
ENDSELECT
;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------

@GETMAP_BUILDING_5(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
		;魔理沙宅
		CASE P510霧雨魔法店
			SELECTCASE Q_ID
				CASE P510霧雨魔法店 TO P514魔理沙宅・風呂
					RETURNF 1
			ENDSELECT
			;人形の館
		CASE P525人形の館・リビング
			SELECTCASE Q_ID
				CASE P521人形の館・アリスの部屋 TO P531人形の館・空き部屋
					RETURNF 1
			ENDSELECT
			;エレン宅
		CASE P534ふわふわエレン魔法の店
			SELECTCASE Q_ID
				CASE P534ふわふわエレン魔法の店 TO P537エレン宅・風呂
					RETURNF 1
			ENDSELECT
	ENDSELECT
ENDIF
RETURNF 0
;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------

@MAP_CAN_MOVE_5(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
	;香霖堂,10時～18時
	CASE P502香霖堂
		IF !KOURINDOU_IS_WORKING_HOURS()
			TFLAG:移動不能メッセージ = 1
			RETURNF 0
		ENDIF
ENDSELECT
RETURNF 1
;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------

@MAP_CANNOT_WORD_5(ARG)
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW 영업시간 외입니다.
		CLEARLINE 2
ENDSELECT
REUSELASTLINE
;-----------------------------------------
;拠点専用の情景描写
;WAITはかけないように
;-----------------------------------------

@MAP_UNIQUEMESSAGE_5
;addition custom code
LOCAL:90 = MAIN_MAP != 5 ? 香霖堂 # P502香霖堂
LOCAL:91 = MAIN_MAP != 5 ? 森の入り口 # P503分かれ道
SELECTCASE CFLAG:MASTER:現在位置
	CASE LOCAL:90 ;addition custom code
		PRINTFORML 각종 물건들이 작은 선반 위에 단단하게 놓여 있다.
		PRINTFORML 당신은 그 모든 곳에 붙어 있는 "판매 불가"라는 표지를 발견한다...
	CASE LOCAL:91 ;addition custom code
		PRINTFORML 마리사의 집 뒤쪽과 우물이 보인다.
		;	CASE 520
		;		PRINTFORML Large garlands of flowers line the street, each labeled "housewarming party."
	CASE P524人形の館・研究室
		PRINTFORML 약병들과 인형들이 선반을 따라 늘어서 있다.
ENDSELECT
RETURN 1
;-----------------------------------------
;非自宅時に差し替える場所IDを返す関数
;ARG,対象ID
;RETURNF,差し替え済み対象ID
;-----------------------------------------

@MAP_SEARCH_REPLACEMENT_5(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P502香霖堂
		RETURNF 香霖堂
	CASE P540古木の大樹 TO P545慧ノ子の棲み処
		RETURNF 古木の大樹
	CASE P510霧雨魔法店 TO P515魔理沙宅・倉庫
		RETURNF 霧雨魔法店
	CASE P520人形の館前 TO P531人形の館・空き部屋
		RETURNF 人形の洋館
	CASE P506無縁塚
		RETURNF 無縁塚
	CASE P509再思の道
		RETURNF 再思の道
	CASEELSE
		RETURNF 森の入り口
ENDSELECT
RETURNF 0
;--------------------------------------------------
;マップの紹介文
;--------------------------------------------------

@マップ紹介_5
;とりあえず5行
PRINTFORML 이 지역은 %CALLNAME:11%의 집, 인형 제작자의 저택, 그리고 플러피 엘렌의 가게를 중심으로 한다.
PRINTFORML 여기에는 혼합 세트 없이 혼합할 수 있는 시설과 여러 채집 지점이 있다.
PRINTFORML 그중 「버섯 군락」은 이곳에 살 때만 접근할 수 있으며, 버섯을 좋아하는 이들에게 추천하는 장소이다.
PRINTFORML 청소해야 할 방은 많지만, 도와야 할 일은 그렇게 많지 않다.
PRINTFORML 또한 무엔즈카를 통해 경계의 길로 가는 지름길도 있다.
