; Modular ERB: 物件関連/10月/MAP_COMM_10.ERB
;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------

@MAP_PLACENAME_10(ARG, ARG:1) ;custom code
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE P1052ドレミー宅・倉庫 ;qol custom code
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF "도레미의 저택・" + CALLNAME:MASTER + "의 방"
			ELSE
				RETURNF "도레미의 저택・창고"
			ENDIF
		CASE P1033綿月亭・空き部屋, P1063純狐邸・空き部屋
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:(FLAG:住み込みキャラ) + "의 방"
			ELSE
				RETURNF "빈방"
			ENDIF
		CASE P1007空き家
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:MASTER + "의 집"
			ELSE
				RETURNF "빈집"
			ENDIF
		CASE SUMIKOMI_ROOM
			;※このマップでは未実装
			IF FLAG:住み込みキャラ
				RETURNF CALLNAME:(FLAG:住み込みキャラ) + "의 방"
			ELSE
				RETURNF "빈방"
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			RETURNF ARG:1 ? STR:(ARG + 8000) # STR_TR(ARG + 8000) ;custom code
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "틈새 공간"
		CASE MAXROOM
			RETURNF "꿈 너머"
		CASEELSE
			RETURNF "알 수 없음"
	ENDSELECT
ELSE
	RETURNF "달 너머"
ENDIF
;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するマップの番号と連動（TFLAG:マップ切り替え）
;ARG     場所ID
;--------------------------------------------------

@MAP_AREASELECT_10(ARG)
#FUNCTION
SELECTCASE ARG
	;綿月亭
	CASE P1020綿月亭・門 TO 1049
		RETURNF 2
		;ドレミー宅
	CASE P1050ドレミー宅・居間 TO 1059
		RETURNF 3
		;純狐邸
	CASE P1060純狐邸・玄関 TO P1072ヘカーティア私室
		RETURNF 4
		;月の世界
	CASEELSE
		RETURNF 1
ENDSELECT
;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------

@GETMAP_BUILDING_10(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
		;綿月亭
		CASE P1020綿月亭・門
			SELECTCASE Q_ID
				CASE P1020綿月亭・門 TO 1049
					RETURNF 1
			ENDSELECT
			;ドレミー宅
		CASE P1050ドレミー宅・居間
			SELECTCASE Q_ID
				CASE P1050ドレミー宅・居間 TO 1059
					RETURNF 1
			ENDSELECT
			;純狐邸
		CASE P1060純狐邸・玄関
			SELECTCASE Q_ID
				CASE P1060純狐邸・玄関 TO P1072ヘカーティア私室
					RETURNF 1
			ENDSELECT
	ENDSELECT
ENDIF
RETURNF 0
;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------

@MAP_CAN_MOVE_10(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
	CASE P1005サグメ宅・居間, P1006サグメ宅・寝室
		;除外
		SIF GROUPMATCH(CHARA, [[依姫]], [[豊姫]], [[サグメ]], [[永琳]])
			RETURNF 1
		;中からは動ける
		SIF INRANGE(CFLAG:CHARA:現在位置, P1005サグメ宅・居間, P1006サグメ宅・寝室)
			RETURNF 1
		;あなた
		IF CHARA == MASTER
			;同行か恋慕なら入れる（家主睡眠中も可
			IF CFLAG:[[サグメ]]:同行 || TALENT:[[サグメ]]:恋慕
				RETURNF 1
				;家主がいて起きてる
			ELSEIF INRANGE(CFLAG:[[サグメ]]:現在位置, P1005サグメ宅・居間, P1006サグメ宅・寝室) && SHIRAHU([[サグメ]])
				RETURNF 1
				;家主以外の誰かがいる,この人物は寝てたりしても良い
			ELSEIF IN_ROOM_NUMBER( P1005サグメ宅・居間) || IN_ROOM_NUMBER(P1006サグメ宅・寝室)
				RETURNF 1
			ELSE
				TFLAG:移動不能メッセージ = 999
				RETURNF 0
			ENDIF
			;部下
		ELSEIF GROUPMATCH(CHARA, [[レイセン]], [[清蘭]], [[鈴瑚]], [[鈴仙]])
			;誰かがいる,この人物は寝てたりしても良い
			IF IN_ROOM_NUMBER( P1005サグメ宅・居間) || IN_ROOM_NUMBER(P1006サグメ宅・寝室)
				RETURNF 1
			ELSE
				RETURNF 0
			ENDIF
			;それ以外は入れない
		ELSE
			RETURNF 0
		ENDIF
		;入り口から近いせいであまりにも人が来るので入室制限をする
	CASE P1050ドレミー宅・居間 TO 1059
		;除外
		SIF GROUPMATCH(CHARA, [[ドレミー]], [[菫子]], [[サグメ]])
			RETURNF 1
		;中からは動ける
		SIF INRANGE(CFLAG:CHARA:現在位置, P1050ドレミー宅・居間, 1059)
			RETURNF 1
		;あなたは関係なし
		SIF CHARA == MASTER
			RETURNF 1
		;家主がいて起きてる
		IF INRANGE(CFLAG:[[ドレミー]]:現在位置, P1050ドレミー宅・居間, 1059) && SHIRAHU([[ドレミー]])
			RETURNF 1
		ENDIF
		;それ以外は入れない
		RETURNF 0
	CASE P1031宝物庫
		;除外
		SIF GROUPMATCH(CHARA, [[依姫]], [[豊姫]], [[サグメ]], [[永琳]], [[青娥]])
			RETURNF 1
		;あなた
		IF CHARA == MASTER
			;信頼度1000以上
			IF CFLAG:[[依姫]]:信頼度 >= 1000 || CFLAG:[[豊姫]]:信頼度 >= 1000
				RETURNF 1
			ELSE
				TFLAG:移動不能メッセージ = 999
				RETURNF 0
			ENDIF
			;それ以外は入れない
		ELSE
			RETURNF 0
		ENDIF
		;誰かが住んでないと入れない
	CASE P1033綿月亭・空き部屋, P1063純狐邸・空き部屋, P1007空き家
		IF !PRIVATEROOM:(ARG % 100) && CFLAG:MASTER:初期位置 != ARG
			TFLAG:移動不能メッセージ = 999
			RETURNF 0
		ENDIF
ENDSELECT
RETURNF 1
;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------

@MAP_CANNOT_WORD_10(ARG)
RETURN
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW ※여기에 메시지를 넣는다. 행수+1의 CLEARLINE을 한다
		CLEARLINE 2
ENDSELECT
REUSELASTLINE
