; Modular ERB: 物件関連/MOB.ERB
;-------------------------------------------------
;モブのいるマップを返す
;ARG=MAPID
;-------------------------------------------------

@GET_EXISTMOB(ARG)
#FUNCTION
SIF GROUPMATCH(ARG, 3, 4, 9, 10)
	RETURNF 1
;-------------------------------------------------
;お出かけ時のモブ判定
;ARG=場所ID
;-------------------------------------------------

@DATE_HITOGOMI(ARG)
#FUNCTION
SIF !ARG
	ARG = CFLAG:MASTER:現在位置
IF IN_HOME(ARG)
	RETURNF 0
ELSE
	SIF ODEKAKEMAP_SETTING(ARG, "モブ")
		RETURNF 1
ENDIF
RETURNF 0
;-------------------------------------------------
;MASTERが在宅中かつモブと同じ位置にいるならMAIN_MAPを返す
;-------------------------------------------------

@WITH_MOB()
#FUNCTION
SIF AT_HOME(MASTER) && ROOMDATA:(CFLAG:MASTER:現在位置 % 100) & 場所_モブ
	RETURNF MAIN_MAP
;-------------------------------------------------
;モブの与える汚れ値（掃除値）
;ARG=MAPID
;-------------------------------------------------

@MOB_YOGORE(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 3
		RETURNF -3
	CASE 4
		SIF !GROUPMATCH(TIME:2,1,6,7)
			RETURNF 1
	CASE 9
		SIF !GROUPMATCH(TIME:2,1,6,7)
			RETURNF 2
	CASE 10
		;玉兎はプラスマイナスゼロ
ENDSELECT
;-------------------------------------------------
;モブの基本名
;ARG=MAPID
;-------------------------------------------------

@MOB_NAME(ARG)
#FUNCTIONS
SIF !ARG
	ARG = MAIN_MAP
SELECTCASE ARG
	CASE 3
		LOCALS = hobgoblin
	CASE 4
		LOCALS = youkai rabbit
	CASE 9
		LOCALS = %ANIMALNAME()%
	CASE 10
		LOCALS = moon rabbit
ENDSELECT
RETURNF LOCALS
;-------------------------------------------------
;お出かけ中のモブ名
;ARG=場所ID
;-------------------------------------------------

@DATE_HITOGOMI_SYUBETU(ARG)
#FUNCTIONS
VARSET LOCALS
SIF !ARG
	ARG = CFLAG:PLAYER:現在位置
SELECTCASE GET_MAPID(ARG)
	;モブの種類
	;月
	CASE 10
		IF ARG == 月の都
			LOCALS += "Lunarian"
		ELSE
			LOCALS += "Moon Rabbit"
		ENDIF
		;地底（街道と温泉では鬼も出てくる）
	CASE 9
		IF ARG != 地霊殿 && !RAND:3
			LOCALS += "Oni"
		ELSE
			LOCALS += "Youkai"
		ENDIF
		;妖怪の山山頂（守矢神社境内のみ希に人間）
	CASE 8
		IF ARG == 守矢神社境内 && !RAND:5
			LOCALS += "Human"
		ELSE
			LOCALS += "Youkai"
		ENDIF
		;妖怪の山山麓
	CASE 7
		;三途の川～冥界（死神、妖怪、希に人間）
	CASE 6
		IF !RAND:5
			LOCALS += "Human"
		ELSEIF !RAND:3
			LOCALS += "Youkai"
		ELSE
			LOCALS += "Shinigami"
		ENDIF
		;魔法の森
	CASE 5
		;迷いの竹林（妖怪ウサギ、希に人間(患者)）
	CASE 4
		IF RAND:5
			LOCALS += "Youkai Rabbit"
		ELSE
			LOCALS += "Human"
		ENDIF
		;紅魔館（お出かけ中のモブは全員少女なのでホフさんはお休み）
	CASE 3
		LOCALS += "Fairy Maid"
		;人間の里（基本人間、希に妖怪）
	CASE 2
		IF ARG == 寺子屋 ;addition custom code, when in school
			LOCALS += "child"
		ELSEIF RAND:5
			LOCALS += "Human"
		ELSE
			LOCALS += "Youkai"
		ENDIF
		;命蓮寺（人間と妖怪）
	CASE 1
		IF !RAND:2
			LOCALS += "Human"
		ELSE
			LOCALS += "Youkai"
		ENDIF
		;博麗神社
	CASE 0
ENDSELECT
LOCALS = young %LOCALS% girl
RETURNF LOCALS
;-------------------------------------------------
;まかないイベント処理
;-------------------------------------------------

@MAKANAI
#DIM 気力回復量
#DIM 体力回復量
VARSET LOCAL
IF DISH_NAME == "" && !TFLAG:まかない && TIME:2 == 3
	;食事できない人がいるかをチェック
	FOR LOCAL, 0, CHARANUM
	SIF TCVAR:LOCAL:空腹時刻 - TIME:1 > 0 && CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
		LOCAL:1 ++
	NEXT
	IF !LOCAL:1 && !RAND:5
		TFLAG:まかない = 1
		PRINTFORML %CAPITALIZE(ARTICLE(MOB_NAME()))%이 음식을 제공했다.
		PRINTFORML 먹을까?
		CALL ASK_YN
		IF RESULT
			PRINTFORML 당신은 정중하게 거절한다.
		ELSE
			SELECTCASE RAND:5
				CASE 0, 1
					PRINTFORML 괜찮았다.
					体力回復量 = 100
					気力回復量 = 300
				CASE 2, 3
					PRINTFORML 꽤 맛있다.
					体力回復量 = 150
					気力回復量 = 400
				CASE 4
					PRINTFORML 이거 맛있다!
					体力回復量 = 300
					気力回復量 = 500
			ENDSELECT
			PRINTFORMW 너%COND_STR(" and the others",GET_TARGETNUM())% 간식을 먹었다.
			TIME += 15
			FOR LOCAL, 0, CHARANUM
			IF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
				CALL RECOVER(LOCAL, 体力回復量, "体力")
				CALL RECOVER(LOCAL, 気力回復量, "気力")
				CALL 満腹度上昇(LOCAL, "軽食")
			ENDIF
			NEXT
		ENDIF
	ENDIF
ENDIF
