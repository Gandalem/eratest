@MOB_TURNENDEVENT_3
IF !FLAG:時間停止
	SIF LS_RESTRICTION("Map mob interrupt") ;Custom code, restrict interrupting sex during Lunatic Survival.
		RETURN 0
	CALL Add_SeedOfUnknownForm("mobsex") ;addition custom code - nue's special item lets you stay hidden
	SIF RESULT
		RETURN 0
	IF CFLAG:MASTER:うふふ
		PRINTFORML 호그불린들은 친절하게 %SPLIT_G("tell you that this is a public space and such behavior is not permitted:ask you to refrain from engaging in such actions in a public area")%했다.
		PRINTFORML 너는 그것에 대해 기분이 나쁘다.
		BASE:TARGET:ムード = 0
		CALL ENDUFUFU_ALL
	ELSEIF CFLAG:MASTER:現在位置 == P313厨房
		CALL MAKANAI
	ENDIF
ENDIF
