;-----------------------------------------------------------
;お出かけ先のマップ設定を返す関数
;ARG   対象の地点
;ARGS  判定文字引数
;-----------------------------------------------------------
@ODEKAKEMAP_SETTING(ARG, ARGS, ARG:1)
#FUNCTION
;お招き部屋とスキマはスルー,0もスルー
SIF GROUPMATCH(ARG, OMANEKIBEYA(), SUKIMA(), 0)
	RETURNF 0
;custom code - check for ON THE ROAD TO maps
SIF ARG == ROAD_TO(GET_MAPID(ARG))
	RETURNF 0
;MAIN_MAPを対象にしていた場合はエラーを吐く
IF GET_MAPID(ARG) == MAIN_MAP
	PRINTFORML Attempted to go to {ARG} %NAME_FROM_PLACE(ARG)% (map ID {GET_MAPID(ARG)}), same map as  {MAIN_MAP}
	PRINTFORML Returning to Entrance!
	RETURNF 0
ENDIF
;文字引数を省いた場合もエラー
SIF ARGS == ""
	THROW
SELECTCASE GET_MAPID(ARG)
	CASE 0
		RETURNF ODEKAKEMAP_SETTING_0(ARG, ARGS)
	CASE 1
		RETURNF ODEKAKEMAP_SETTING_1(ARG, ARGS)
	CASE 2
		RETURNF ODEKAKEMAP_SETTING_2(ARG, ARGS)
	CASE 3
		RETURNF ODEKAKEMAP_SETTING_3(ARG, ARGS)
	CASE 4
		RETURNF ODEKAKEMAP_SETTING_4(ARG, ARGS)
	CASE 5
		RETURNF ODEKAKEMAP_SETTING_5(ARG, ARGS)
	CASE 6
		RETURNF ODEKAKEMAP_SETTING_6(ARG, ARGS)
	CASE 7
		RETURNF ODEKAKEMAP_SETTING_7(ARG, ARGS)
	CASE 8
		RETURNF ODEKAKEMAP_SETTING_8(ARG, ARGS)
	CASE 9
		RETURNF ODEKAKEMAP_SETTING_9(ARG, ARGS)
	CASE 10
		RETURNF ODEKAKEMAP_SETTING_10(ARG, ARGS)
	CASE 11
		RETURNF ODEKAKEMAP_SETTING_11(ARG, ARGS)
	CASE 18
		;NAS: Lucid Dream
		RETURNF 0
	CASE 19
		;NAS: Player Housing
		RETURNF ODEKAKEMAP_SETTING_19(ARG, ARGS)
	CASEELSE
		SETCOLOR C_RED
		PRINTL
		PRINTFORML %"-"*89%
		PRINTFORML Invalid map specified for ODEKAKEMAP_SETTING
		PRINTFORML {ARG} IS NOT VALID
		PRINTFORML !REPORT THIS!
		PRINTFORML %"-"*89%
		RESETCOLOR
		THROW
