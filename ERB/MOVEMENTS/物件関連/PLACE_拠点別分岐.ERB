@NAME_FROM_PLACE(ARG, ARG:1) ;custom code, set ARG:1 to return original location name for backward compatibility
#FUNCTIONS
#DIM MAPID
#DIMS PNAME
PNAME = 
MAPID = GET_MAPID(ARG)
IF TFLAG:妄想中 == 1
	PNAME = Fantasy Realm
ELSEIF ARG == OMANEKIBEYA()
	;お招き部屋の名前処理
	RETURNF OMANEKI_PLACE()
