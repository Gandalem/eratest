	;物件マップ内の名前処理
	;custom code, add ARG:1
	SELECTCASE MAPID
		CASE 0
			PNAME = %MAP_PLACENAME_0(ARG, ARG:1)%
		CASE 1
			PNAME = %MAP_PLACENAME_1(ARG, ARG:1)%
		CASE 2
			PNAME = %MAP_PLACENAME_2(ARG, ARG:1)%
		CASE 3
			PNAME = %MAP_PLACENAME_3(ARG, ARG:1)%
		CASE 4
			PNAME = %MAP_PLACENAME_4(ARG, ARG:1)%
		CASE 5
			PNAME = %MAP_PLACENAME_5(ARG, ARG:1)%
		CASE 6
			PNAME = %MAP_PLACENAME_6(ARG, ARG:1)%
		CASE 7
			PNAME = %MAP_PLACENAME_7(ARG, ARG:1)%
		CASE 8
			PNAME = %MAP_PLACENAME_8(ARG, ARG:1)%
		CASE 9
			PNAME = %MAP_PLACENAME_9(ARG, ARG:1)%
		CASE 10
			PNAME = %MAP_PLACENAME_10(ARG, ARG:1)%
		CASE 11
			PNAME = %MAP_PLACENAME_11(ARG, ARG:1)%
		CASE 18
			PNAME = %LUCID_DREAM_LOCATION_NAME(DAILY_LUCID_STATS:3,ARG)%
		CASE 19
			PNAME = %MAP_PLACENAME_19(ARG, ARG:1)%
	ENDSELECT
ELSEIF ARG < 2000
	;おでかけマップの方
	;Custom code
	
	PNAME = % ARG:1 == 1 ? STR:(6000 + ARG / 10) # STR_TR(6000 + (ARG / 10))%
ELSE
	;道中他、その他範囲
	;Custom code
	PNAME = % ARG:1 == 1 ? STR:(ARG) # STR_TR(ARG)%
ENDIF
RETURNF PNAME

