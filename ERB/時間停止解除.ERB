			SELECTCASE ABL:LOCAL:2
				CASE 0 TO 2
					PRINTFORMW %CALLNAME:LOCAL%은 갑자기 %HIS_HER(LOCAL)%의 요도에 닥친 쾌감으로 작은 울음을 터뜨린다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,12,1)
				CASE 3 TO 5
					PRINTFORMW %CALLNAME:LOCAL%은 갑자기 자신의 %HIS_HER(LOCAL)% 방광에 정액이 들어온 것에 몸을 경직시킨다.
					PRINTFORMW %HE_SHE(LOCAL,1)%는 작은 비명을 지른다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,12,2)
					;Custom code, enables last case if sensitivity is > 7
				CASE 6 TO 7
					PRINTFORMW %CALLNAME:LOCAL%는 뜨거운 정액으로 가득 찬 %HIS_HER(LOCAL)%의 방광 감각을 견디지 못하는 것 같다.
					PRINTFORMW %HE_SHE(LOCAL,1)%가 신음한다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,12,2)
					;現在ロック中。はたしてこの反応は有りか否か？
				CASEELSE
					PRINTFORMW 갑자기 %CALLNAME:LOCAL%의 방광에 뜨거운 감각이 느껴진다.
					PRINTFORMW 하지만 %HIM_HER(LOCAL)%에게는 그저 적당한 자극일 뿐이다.
					PRINTFORMW %HE_SHE(LOCAL,1)%은 %HIS_HER(LOCAL)%의 얼굴이 즐거움으로 녹아내리는 것을 감추려 하지 않고 신음한다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,12,2)
			ENDSELECT
		ENDIF
		IF CFLAG:LOCAL:UnawareWetting == 2
			SETCOLOR 255,100,255
			PRINTL 【자각 없는 소변】
			RESETCOLOR
			IF ABL:LOCAL:PeeAddict < 3
				IF IsPadded(LOCAL)
					PRINTFORMW %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)%의 패드가 젖어 있음을 알아차린다.
					PRINTFORMW %HE_SHE(LOCAL)%은(는) %HIS_HER(LOCAL)% 기저귀에서 사고가 일어났다는 것을 눈치채지 못한 것 같다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,10,1)
				ELSE
					PRINTFORMW %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)% 속옷이 오줌으로 흥건하다는 것을 알아차린다.
					PRINTFORMW 통제할 수 없는 사고를 %HE_SHE(LOCAL)%가 쳤다는 사실에 당황한 %CALLNAME:LOCAL%은 울기 시작한다...
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,10,2)
				ENDIF
			ELSE
				IF IsPadded(LOCAL)
					PRINTFORMW %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)% 패드가 젖었음을 알아차린다.
					PRINTFORMW %CALLNAME:LOCAL%은(는) 홍조를 띠며 미소 짓고, 갓 젖은 패드를 분명 음미한다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,10,3)
				ELSE
					PRINTFORMW %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)%의 속옷이 오줌으로 흥건하다는 것을 알아차린다.
					PRINTFORMW %HE_SHE(LOCAL,1)%은(는) 이상하게 흥분한 기분을 느낀다...
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,10,4)
				ENDIF
			ENDIF
		ENDIF
		IF CFLAG:LOCAL:UnawareMessing == 2
			SETCOLOR 255,100,255
			PRINTL 【불안정한 방해】
			RESETCOLOR
			IF ABL:LOCAL:PeeAddict < 3
				IF IsPadded(LOCAL)
					PRINTFORMW %CALLNAME:LOCAL%이 %HIS_HER(LOCAL)%의 패딩에서 냄새가 나기 시작한 것을 알아차린다.
					PRINTFORMW %CALLNAME:LOCAL%은(는) 얼굴을 새빨갛게 만들며 %HE_SHE(LOCAL)%가 %HIS_HER(LOCAL)% 기저귀를 만져서 %HE_SHE(LOCAL)%가 %HIMSELF_HERSELF(LOCAL)%를 더럽혔다는 것을 알게 된다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,11,1)
				ELSE
					PRINTFORMW %CALLNAME:LOCAL%은(는) %PeeAndPoo(0, 1, "", "poop")%의 냄새로 아래쪽 속옷이 처진 것을 알아차린다.
					PRINTFORMW %HE_SHE(LOCAL)%가 통제할 수 없는 사고를 쳤다는 사실에 당황한 %CALLNAME:LOCAL%은 울기 시작한다...
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,11,2)
				ENDIF
			ELSE
				IF IsPadded(LOCAL)
					PRINTFORMW %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)% 패딩에서 악취가 나기 시작하는 것을 알아차린다.
					PRINTFORMW %CALLNAME:LOCAL%은(는) 홍당무처럼 빨개지며 미소 짓고, 새로 지저분해진 패딩을 분명 음미한다.
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,11,3)
				ELSE
					PRINTFORMW %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)%의 속옷이 %PeeAndPoo(0, 1, "", "poop")%의 향기로 인해 아래로 처진 것을 알아차린다.
					PRINTFORMW %HE_SHE(LOCAL,1)%은(는) 이상하게 흥분되는 기분을 느낀다...
					CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,11,4)
				ENDIF
			ENDIF
		ENDIF
		CALL KOJO_MESSAGE_SEND("EVENT",17,LOCAL,0,0)
	ENDIF
ENDIF
