;==========================================================================
;自動行送り（日本語対応）
;ATW comment: This function doesn't really work well
;==========================================================================
@FULLWIDTH_LB(strInput, strBreakLine = "\n", nLength = 0)
#FUNCTIONS
#DIM nLength
#DIMS strInput
#DIMS strBreakLine
#DIMS nMaking

nMaking '= REPLACE(strInput, @"(.\{1,{(nLength/2)-1}\})(.|$)", "$1$2\n")
RETURNF SUBSTRING(nMaking, 0, HTML_STRINGLEN(nMaking) - STRLENS(strBreakLine))

;prints a line in a plain color
@D_LINE
LOCAL = GETCOLOR()
RESETCOLOR
DRAWLINE
SETCOLOR LOCAL

;prints a line of text in a character's color
@CHARA_TEXT(ARG, ARGS, MODE = "l")
#DIMS MODE
LOCAL = GETCOLOR()
RESETCOLOR
SIF FLAG:口上色
    CALL SET_KOJO_COLOR(ARG)

CALL PRINT_SPECIAL(ARGS, MODE)
SETCOLOR LOCAL

;custom code, simplified and made reusable
@PRINT_SPECIAL(TEXT, MODE = "l")
#DIMS TEXT
#DIMS MODE
SELECTCASE TOLOWER(MODE)
    CASE "l"
        PRINTFORML %TEXT%
    CASE "w"
        PRINTFORMW %TEXT%
	CASE "str"
		CALL PRINT_STR, TEXT
	CASE "strl"
		CALL PRINT_STRL, TEXT
	CASE "strw"
		CALL PRINT_STRW, TEXT
    CASEELSE
        PRINTFORM %TEXT%
ENDSELECT
