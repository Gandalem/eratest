@MORELOVERDLC
#DIM TMP
#DIM DYNAMIC LOVERPEP
#DIM nLineCnt_Head 

IF MORELOVER == 1 || !GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, @"%PRINT_MALE("Men",MASTER)%'s Spouses")
	$ForceMoreLover
	IF GETBIT(CFLAG:MASTER:既成事実 , 2)
		CLEARBIT CFLAG:MASTER:既成事実, 2
	ENDIF
	FLAG:追加恋人枠 = CHARANUM
	;MORELOVER = 1
ELSE
	FOR TMP,1,CHARANUM
		IF TALENT:TMP:7 > 0
			LOVERPEP ++
		ENDIF
	NEXT
	SIF LOVERPEP <= GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, @"%PRINT_MALE("Men",MASTER)%'s Spouses")
		RETURN
	PRINTFORML Multiple lovers detected.
	PRINTFORML Please select the unwanted lover.
	DRAWLINE
	nLineCnt_Head = LINECOUNT
	REDRAW 0
	WHILE LOVERPEP > 1
		SIF LINECOUNT - nLineCnt_Head > 0
			CLEARLINE LINECOUNT - nLineCnt_Head
		FOR TMP,1,CHARANUM
			IF TALENT:TMP:7 > 0
				PRINTFORMLC [{TMP, 3}] %CALLNAME:TMP%
			ENDIF
		NEXT
		PRINTFORML
		DRAWLINE
		PRINTFORML [999] Remove all lovers
		INPUT
		TMP = RESULT
		
		SELECTCASE TMP
			CASE 999
				FOR TMP,1,CHARANUM
					IF TALENT:TMP:7 > 0
						TALENT:TMP:7 = 0
						LOVERPEP --
					ENDIF
				NEXT
				PRINTFORMW All lovers were removed.
				BREAK
			CASE 1 TO CHARANUM
				IF TALENT:TMP:7 > 0
					TALENT:TMP:7 = 0
					PRINTFORMW %CALLNAME:TMP% is no longer your lover.
					LOVERPEP --
				ENDIF
		CASEELSE
		ENDSELECT
	WEND
	IF LOVERPEP == 1
		SETBIT CFLAG:MASTER:既成事実, 2
	ELSE
		TALENT:0:7 = 0
		CLEARBIT CFLAG:MASTER:既成事実, 2
	ENDIF
	IF GETBIT(nReligions,0)
		IF !GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, @"%PRINT_MALE("Men",MASTER)%'s Spouses")
			GOTO ForceMoreLover
		ELSE
			FLAG:追加恋人枠 = GET_RELIGION_PRECEPT(TALENT:MASTER:Religion, @"%PRINT_MALE("Men",MASTER)%'s Spouses")-1
		ENDIF
	ELSE
	FLAG:追加恋人枠 = 0
	ENDIF
	;MORELOVER = 0
ENDIF

;-------------------------------
; Toggle for ability to use it anywhere
; @MORELOVERDLC is repurposed to check when the save is loaded
;- Mr Pops Alot
;-------------------------------
@MORELOVER_TOGGLE
MORELOVER = !MORELOVER
	
;-------------------------------
;Custom config section
;-------------------------------
@CUSTOM_OPTION_0
;PRINTFORML [  0] - More lovers：\@ MORELOVER ? Yes # No \@

@CUSTOM_OPTION_RESULT_0
CALL MORELOVERDLC