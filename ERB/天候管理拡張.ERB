					ENDIF
			ENDSELECT
		CASE 13,15
			TIME:5 = 14
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW 비가 미친 듯이 내리기 시작했다!
		CASEELSE
			TIME:5 = 14
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW 비가 미친 듯이 내리기 시작했다!
	ENDSELECT
ENDIF
;連続降水カウンター
SELECTCASE TIME:5
	CASE 5
		CONTINUOUS_RAINFALL += 1
	CASE 14
		CONTINUOUS_RAINFALL += 3
	CASE 3,6,7,10,11
		CONTINUOUS_RAINFALL = MAX(0, CONTINUOUS_RAINFALL - 1)
ENDSELECT
;(天候パッチ)熱界雷時の処理　ダウンバースト発生
IF ATMOSPHERIC_INSTABILITY <= 0 && CFLAG:MASTER:現在位置 != 天界 && RAND:4 == 0
	IF ATMOSPHERIC_INSTABILITY <= -2 && RAND:2 == 0
		SELECTCASE WIND_VELOCITY
			CASE 0
				WIND_VELOCITY = 2
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW 거센 바람이 불어온다!
				;ダウンバーストによる作物への影響
				IF FLAG:地主 > 0
					FLAG:畑仕事の成果 = MAX(0, FLAG:畑仕事の成果 - 30)
					IS_STORM_CROP_DAMAGE ++
				ENDIF
			CASE 1
				WIND_VELOCITY = 2
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW 바람이 더욱 세지고 있다!
				;ダウンバーストによる作物への影響
				IF FLAG:地主 > 0
					FLAG:畑仕事の成果 = MAX(0, FLAG:畑仕事の成果 - 30)
					IS_STORM_CROP_DAMAGE ++
				ENDIF
			CASEELSE
				WIND_VELOCITY = 2
		ENDSELECT
	ELSE
		SELECTCASE WIND_VELOCITY
			CASE 0
				WIND_VELOCITY = 1
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW 바람이 불기 시작했다!
			CASE 1
				WIND_VELOCITY = 1
			CASEELSE
				WIND_VELOCITY = 1
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW 아까보다 바람이 좀 사그라들었다.
		ENDSELECT
	ENDIF
	;強風である場合風がおさまる
ELSEIF CFLAG:MASTER:現在位置 != 天界 && WIND_VELOCITY != 0
	WIND_VELOCITY = 0
	SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
		PRINTW 바람이 잦아들었다.
ENDIF
;降雪・雪崩判定を解除
CONTINUOUS_SNOWFALL = 0
SNOW_COVERAGE = 0
POSSIBLITY_AVALANCHE = 0
