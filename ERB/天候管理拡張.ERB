TIME:7 = 0

IF CFLAG:MASTER:現在位置 != 天界
	SELECTCASE TIME:5
		CASE 5
			SELECTCASE RAND:3
				CASE 0,1
					TIME:5 = 14
					SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
						PRINTW The rain got even heavier!
				CASE 2
					IF ATMOSPHERIC_INSTABILITY <= 0
						TIME:5 = 15
						SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
							PRINTW A hailstorm is coming!
					ELSE
						TIME:5 = 13
						SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
							PRINTW It's hailing!
					ENDIF
			ENDSELECT
		CASE 14
			SELECTCASE RAND:4
				CASE 0
					TIME:5 = 5
					SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
						PRINTW The rain has subsided a bit.
				CASE 1
					IF ATMOSPHERIC_INSTABILITY <= 0
						TIME:5 = 15
						SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
							PRINTW A hailstorm is coming!
					ELSE
						TIME:5 = 13
						SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
							PRINTW It's hailing!
					ENDIF
			ENDSELECT
		CASE 13,15
			TIME:5 = 14
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW It started raining like crazy!
		CASEELSE
			TIME:5 = 14
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW It started raining like crazy!
	ENDSELECT
ENDIF

;連続降水カウンター
SELECTCASE TIME:5
	CASE 5
		CONTINUOUS_RAINFALL += 1
	CASE 14
		CONTINUOUS_RAINFALL += 3
	CASE 3,6,7,10,11
		CONTINUOUS_RAINFALL = MAX(0, CONTINUOUS_RAINFALL - 1)
ENDSELECT

;(天候パッチ)熱界雷時の処理　ダウンバースト発生
IF ATMOSPHERIC_INSTABILITY <= 0 && CFLAG:MASTER:現在位置 != 天界 && RAND:4 == 0
	IF ATMOSPHERIC_INSTABILITY <= -2 && RAND:2 == 0
		SELECTCASE WIND_VELOCITY
			CASE 0
				WIND_VELOCITY = 2
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW A fierce wind is on the loose!
				;ダウンバーストによる作物への影響
				IF FLAG:地主 > 0
					FLAG:畑仕事の成果 = MAX(0, FLAG:畑仕事の成果 - 30)
					IS_STORM_CROP_DAMAGE ++
				ENDIF
			CASE 1
				WIND_VELOCITY = 2
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW The wind is getting even stronger!
				;ダウンバーストによる作物への影響
				IF FLAG:地主 > 0
					FLAG:畑仕事の成果 = MAX(0, FLAG:畑仕事の成果 - 30)
					IS_STORM_CROP_DAMAGE ++
				ENDIF
			CASEELSE
				WIND_VELOCITY = 2
		ENDSELECT
	ELSE
		SELECTCASE WIND_VELOCITY
			CASE 0
				WIND_VELOCITY = 1
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW The wind is picking up!
			CASE 1
				WIND_VELOCITY = 1
			CASEELSE
				WIND_VELOCITY = 1
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW The wind has died down a bit from earlier.
		ENDSELECT
	ENDIF
;強風である場合風がおさまる
ELSEIF CFLAG:MASTER:現在位置 != 天界 && WIND_VELOCITY != 0
	WIND_VELOCITY = 0
	SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
		PRINTW The wind has died down.
ENDIF

;降雪・雪崩判定を解除
CONTINUOUS_SNOWFALL = 0
SNOW_COVERAGE = 0
POSSIBLITY_AVALANCHE = 0


