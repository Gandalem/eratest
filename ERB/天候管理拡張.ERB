ELSEIF CFLAG:MASTER:現在位置 == OMANEKIBEYA() && GROUPMATCH(CFLAG:MASTER:お招き, 36, 37, 38, 49, 60, 64, 83, 84)
	地底 = 1
ENDIF
TIME:7 = 0

IF CFLAG:MASTER:現在位置 != 天界
	SELECTCASE TIME:5
		CASE 3
			IF RAND:2 == 0
				TIME:5 = 5
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW It started pouring down!
			ELSE
				TIME:5 = 4
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW It's raining!
			ENDIF
		CASE 4,6,7
			IF RAND:2 != 0
				TIME:5 = 5
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW It started pouring down!
			ELSEIF RAND:2 == 0
				IF 豪雨フラグ == 1
					TIME:5 = 14
					SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
						PRINTW It started raining like crazy!
				ELSEIF 現在台風位置 == 2
					TIME:5 = 3
					SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
						PRINTW It stopped raining.
				ENDIF
			ELSE
				TIME:5 = 3
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW It stopped raining.
				;念のため相合い傘を解除
				FOR LOCAL,0,CHARANUM
					SIF TEQUIP:LOCAL:201
						TEQUIP:LOCAL:201 = 0
				NEXT
			ENDIF
		CASE 5,14
			IF TIME:5 != 14 && 豪雨フラグ == 1
				TIME:5 = 14
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW It started raining like crazy!
			ELSEIF RAND:2 != 0 && 現在台風位置 == 2
				TIME:5 = 3
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW It stopped raining.
			ELSEIF RAND:2 != 0
				IF TIME:5 == 14
					TIME:5 = 5
					SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
						PRINTW The rain has subsided a bit.
				ELSE
					TIME:5 = 4
					SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
						PRINTW The rain got weaker.
				ENDIF
			ENDIF
		CASE 13,15
			TIME:5 = 5
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW It started pouring down!
		CASEELSE
			TIME:5 = 4
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW It's raining!
	ENDSELECT
ENDIF

;連続降水カウンター
SELECTCASE TIME:5
	CASE 5
		CONTINUOUS_RAINFALL += 1
	CASE 14
		CONTINUOUS_RAINFALL += 3
ENDSELECT

;台風勢力5以上、寒気1かつ暖気5のとき颶風フラグオン
SIF IS_TYPHOON:1 >= 5 && POWER_COLD_AIR == 1 && POWER_WARM_AIR >= 5
	颶風フラグ = 1

IF CFLAG:MASTER:現在位置 != 天界
	SELECTCASE WIND_VELOCITY
		CASE 0
			IF 颶風フラグ == 1
				WIND_VELOCITY = 3
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW Suddenly the wind turned fierce!
			ELSE
				WIND_VELOCITY = 2
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW The wind picked up fast!
			ENDIF
		CASE 1
			WIND_VELOCITY = 2
			SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
				PRINTW The wind picked up dramatically!
			;台風直撃による作物への影響
			IF FLAG:地主 > 0
				IF IS_TYPHOON:2 == 2
					FLAG:畑仕事の成果 = MAX(0, FLAG:畑仕事の成果 - 30)
					IS_STORM_CROP_DAMAGE ++
				ENDIF
			ENDIF
		CASE 2
			IF 颶風フラグ == 1 && 現在台風位置 == 1
				WIND_VELOCITY = 3
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW A fierce gust of wind is picking up!
				;猛烈な風による作物への影響
				IF FLAG:地主 > 0
					FLAG:畑仕事の成果 = MAX(0, FLAG:畑仕事の成果 - 30)
					IS_STORM_CROP_DAMAGE ++
				ENDIF
			ENDIF
		CASE IS >= 3
			IF 現在台風位置 == 2
				WIND_VELOCITY = 2
				SIF !CFLAG:MASTER:うふふ && !地底 && !benchMarkStart
					PRINTW The wind has died down a bit from earlier.
			ENDIF
	ENDSELECT
ENDIF

;降雪・雪崩判定を解除
CONTINUOUS_SNOWFALL = 0
SNOW_COVERAGE = 0
POSSIBLITY_AVALANCHE = 0

