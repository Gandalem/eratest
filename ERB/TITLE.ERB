; Modular ERB: TITLE.ERB
;revからパクリ

@SYSTEM_TITLE
CALL NAS_TITLE_PRE
IF nLegacyTitleScreen
	CALL TITLE_NAS_LEGACY
ELSE
	CALL TITLE_NAS; replaced with eraNAS title screen
ENDIF
RETURN
LOADGLOBAL
RESULT = GLOBAL
SAVEGLOBAL
LOADGLOBAL
CLEARMEMORY ;debloat custom code
RESETBGCOLOR
;qol custom code, add warning if screen isn't wide enough
IF MAXWIDTH() < CHAR_PER_LINE
	CALL COLORMESSAGE("경고: 창 너비가 예상되는 줄 너비보다 작습니다. 요소들이 올바르게 배치되지 않을 수 있습니다.", C_YELLOW, 1)
	CALL COLORMESSAGE("이것을 고치려면 창 너비를 늘리거나 더 작은 글꼴을 사용해 주세요.", C_YELLOW, 1)
	PRINTL
ENDIF
;custom code, stop here if there are errors
[IF_DEBUG]
SIF LINECOUNT > 1
	WAIT
[ENDIF]
IF GAMEBASE_VERSION == 0
	WINDOW_TITLE = %GAMEBASE_TITLE% %ATWVersionName()%
ELSEIF GAMEBASE_VERSION < 0
	WINDOW_TITLE = %GAMEBASE_TITLE% 0.00
ENDIF
CLEARLINE 1
RESULT  = 1
LOCAL:2 = LINECOUNT
DO
REDRAW 0
CLEARLINE LINECOUNT - LOCAL:2
FOR LOCAL:0, 0, 35
HTML_PRINT "<p align='center'><img src='TW_title" + TOSTR(LOCAL:0, "000") + "'></p>"
NEXT
$START ;custom code - keep the loop to avoid crashes
ALIGNMENT CENTER
CUSTOMDRAWLINE ━
PRINTFORML %GAMEBASE_TITLE%
PRINTFORML %ATWVersionName()%
PRINTFORML %GAMEBASE_YEAR%
PRINTFORML
PRINTFORML 익명(AnonTW)은 PedyTW에서 포크된 빌드이다.
;	CALL HTMLPRINTL(@"%HTMLFONT(@"<b>%HTMLSTYLE(@"%GAMEBASE_TITLE%", 2)%</b>", "Courier New", )%")
;	CALL HTMLPRINTL(@"%HTMLFONT(@"<b>%eraTW_Version%</b>", "Courier New")%")
;	CALL HTMLPRINTL(@"%HTMLFONT(@"<b>(%GAMEBASE_YEAR%)</b>", "Courier New")%")
PRINTL
PRINTFORML %GAMEBASE_INFO%
CALL TITLETIPS ;addition custom code
CUSTOMDRAWLINE ━
PRINTFORML [0] 게임 시작
PRINTFORML [1] 계속하기
[IF_DEBUG]
;custom code: Dev Quicktest
PRINTFORML [99] 개발 빠른 테스트
PRINTFORML [3] 빠른 테스트 설정
[ENDIF]
ALIGNMENT LEFT
REDRAW 1
INPUT
CUSTOMDRAWLINE ━
SELECTCASE RESULT
	CASE 0
		RESETDATA
		$NEWGAME
		CALL Name_Array_Set ;additional call because we need it for master's name
		CALL ADDCHARA_INIT(0) ;custom code, init PC
		BEGIN FIRST
	CASE 1
		CALL LOAD_SAVE(0,1) ;Custom code for load-save menu
	CASE 99
		;custom code: Dev Quicktest
		RESETDATA
		DevTest = 1
		GOTO NEWGAME
	CASE 3
		;custom code: Fetish Options
		;SIF !FIRST_NAME_KM_ADDRESS
		;CALL CREATE_NAME_LIST
		;Move character initalization code for Quicktest settings to title screen
		CALL ADD_ALL_CHARACTERS()
		CALL Name_Array_Set
		CALL MAKE_ALL_CLASS_LIST
		CALL OPTION_MOD_QUICKTEST
ENDSELECT
GOTO START
LOOP RESULT
