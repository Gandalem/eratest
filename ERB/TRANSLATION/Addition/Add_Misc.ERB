@Add_Impregnated_Races_Count(INCLUDE_FROM_ACHIEVEMENTS=1)
#FUNCTION
#DIM Impregnations, 15
#DIM INCLUDE_FROM_ACHIEVEMENTS
VARSET Impregnations
;use functions from New AL.ERB
IF !AL_PROG:CharacterCheck
	CALLF AL_CHARACTER_CHECK
ENDIF
;convert bit array to variable array
FOR LOCAL,2,VARSIZE("Impregnations")
IF GETBIT(AL_PROG:PregnancyRaces, LOCAL)
	Impregnations:LOCAL = 1
ENDIF
NEXT
IF INCLUDE_FROM_ACHIEVEMENTS
	;check achievements manually since the new system doesn't use number IDs
	FOR LOCAL,2,VARSIZE("Impregnations")
	SELECTCASE LOCAL
		CASE 2
			LOCALS '= "임신종 미코"
		CASE 3
			LOCALS '= "임신종 요정"
		CASE 4
			LOCALS '= "임신종(種)의 신"
		CASE 5
			LOCALS '= "임신종-츠쿠모가미"
		CASE 6
			LOCALS '= "임신종 테็ง구"
		CASE 7
			LOCALS '= "임신종_후라이"
		CASE 8
			LOCALS '= "임신 요괴"
		CASE 9
			LOCALS '= "임신종 마법사"
		CASE 10
			LOCALS '= "임신종_고스트"
		CASE 11
			LOCALS '= "임신종 인형"
		CASE 12
			LOCALS '= "임신종 스침"
	ENDSELECT
	DT_SELECT "saveAchievements", @"defName = '%LOCALS%'"
	SIF DT_CELL_GET("saveAchievements", RESULT:1, "claimed", 1)
