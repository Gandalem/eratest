;toggle character specific tips which appear the morning after interacting with them

@Morning_Tips_Menu
#DIM nBannedCount
LINESTART = LINECOUNT
nBannedCount = 0
REDRAW 0
PRINTL 아침에 어떤 캐릭터가 개인 팁을 보여줄지 선택한다.
DRAWLINE
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 1, EX_CHARANUM
IF FLAG:並び替え
	LOCAL = RESULT:(LOCAL:1)
	SIF LOCAL < 0
		CONTINUE
ELSE
	LOCAL = LOCAL:1
	SIF LOCAL >= CHARANUM
		BREAK
ENDIF
IF !CFLAG:LOCAL:MORNING_TIPS
	CONTINUE
ELSEIF CFLAG:LOCAL:MORNING_TIPS_DISABLED
	SETCOLOR C_L_GRAY
	nBannedCount++
ENDIF
RESULT = 0
TRYCALLFORM M_KOJO_K{NO:LOCAL}
PRINTFORMLC [{LOCAL, 3}] %CALLNAME:LOCAL%
RESETCOLOR
NEXT
PRINTL 　
DRAWLINE
PRINTFORML [999] 완료 (비활성화: {nBannedCount}명) [998] 모두 활성화 [997] 모두 비활성화
$LOOP
INPUT
IF RESULT >= 1 && RESULT <= CHARANUM && CFLAG:RESULT:MORNING_TIPS != 0
	CFLAG:RESULT:MORNING_TIPS_DISABLED = !CFLAG:RESULT:MORNING_TIPS_DISABLED
	CLEARLINE LINECOUNT - LINESTART
	RESTART
ELSEIF RESULT == 999
	PRINTW 설정이 적용되었다.
ELSEIF RESULT == 998
	FOR LOCAL,1,CHARANUM
	CFLAG:LOCAL:MORNING_TIPS_DISABLED = 0
	NEXT
	CLEARLINE LINECOUNT - LINESTART
	RESTART
ELSEIF RESULT == 997
	FOR LOCAL,1,CHARANUM
	CFLAG:LOCAL:MORNING_TIPS_DISABLED = 1
	NEXT
	RESTART
ELSE
	GOTO LOOP
ENDIF

