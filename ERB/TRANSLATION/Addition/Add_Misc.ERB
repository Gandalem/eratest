;tsp slip out

@TSP_SLIP_OUT(ARG)
IF MAXBASE:MASTER:TSP >= 500 && BASE:MASTER:TSP >= 500
	PRINTFORML TSP를 사용해서 빠져나갈까?
	CALL ASK_YN
	IF !RESULT
		PRINTFORML 당신은 힘을 소모해 %CALLNAME:ARG%의 시간을 빠르게 흐르게 하고, 그 기력을 소진시킨다.
		BASE:MASTER:TSP -= 500
		BASE:ARG:気力 = 200
		RETURN 1
	ENDIF
ENDIF
;allow for the purchase of 4 additional fields (original code ny11)

@ADD_BuyMoreFields
#DIM nPrice = 30000, 80000, 200000, 500000, 1000000  ;increased the price because you get extra plots passively now
PRINTFORML 이것으로, 당신은 정원에 추가 필드를 심을 수 있다.
PRINTFORML 비용은 ¥{nPrice:nGardenPlots}가 들 것이다.
CALL ASK_YN("구매","신경 쓰지 마")
IF !RESULT
	IF MONEY >= (nPrice:nGardenPlots)
		MONEY -= (nPrice:nGardenPlots)
		nGardenPlots ++
		PRINTFORMW 당신이제 총 {Qol_GETUNELENGTH418()}개의 필드를 추가로 심을 수 있다.
	ELSE
		PRINTFORMW 돈이 충분하지 않다.
	ENDIF
ENDIF

@EVENTTRAIN ;when starting the day
IF !nGardenPlots ;move flags, one time
	nGardenPlots = 1
	SIF FLAG:畑拡張 && !FLAG:農民難易度
		nGardenPlots += FLAG:畑拡張
	FLAG:畑拡張 = 0
ENDIF
;Custom code, lets you avoid your food from getting _found_ in the first place, thus staying compatible with KOJO (original code Zergrush)

@Add_PreventFoodTheft
IF ABL:TARGET:戦闘能力 <= ABL:MASTER:戦闘能力
	PRINTFORMW 당신은 갑자기 자신의 %DISHNAME_TR(EX_DISH_NAME)%가 위험에 처한 것 같은 기분을 느낀다...
	LOCAL:50 = ABL:TARGET:戦闘能力 >= ABL:MASTER:戦闘能力 ? 100 # 50
	IF BASE:MASTER:TSP > LOCAL:50
		PRINTFORMW 시간을 멈추고 그것을 숨기다?
		CALL ASK_M("네", 1, "아니요", 1, "보온병의 보안 키패드를 믿는다!", ITEM:保温ジャー && GETBIT(nThermalJarMods, ThermalJar_StealProtectionUpgrade), "보온병을 잠그지 않고 둔다.", ITEM:保温ジャー && GETBIT(nThermalJarMods, ThermalJar_StealProtectionUpgrade))
		IF RESULT == 0
			PRINTFORMW 시간을 멈추고, 당신의 %DISHNAME_TR(EX_DISH_NAME)%를 숨긴 후 위험이 지나기를 기다렸다가 그것을 회수한다.
			LOCAL:51 = 3
			CALL RECOVER(MASTER,-LOCAL:50,"TSP")
			RETURN 1
		ELSEIF RESULT == 2 ;custom code from item mods
			RETURN 2
		ELSEIF RESULT == 3
			GOTO OPENSESAME
		ENDIF
	ELSE
		IF ITEM:保温ジャー && GETBIT(nThermalJarMods, ThermalJar_StealProtectionUpgrade)
			PRINTFORML 보온병을 열어 둘까요?
			CALL ASK_YN
			IF !RESULT
				$OPENSESAME
				PRINTFORMW 당신은 일부러 열 보온병을 풀어서 %조사처리(CALLNAME:TARGET,"가")% 훔쳐 가도록 내버려 두었다...
				RETURN 0
			ELSE
				RETURN 2
			ENDIF
		ENDIF
		PRINTFORMW 하지만 그것을 숨길 시간이 충분하지 않아!
	ENDIF
ENDIF
