@Add_Move_Job(ARG)
IF CAN_HELP_JOB(ARG) && !LS_RESTRICTION("Go out",ARG)
	PRINTFORML %CALLNAME:ARG%은(는) 당신이 같이 가고 싶은지 묻는다.
	CALL KOJO_MESSAGE_SEND("EVENT",13,ARG,97,0)
	CALL ASK_YN
	IF !RESULT
		;remove all "stragglers"
		FOR LOCAL, 1, GET_TARGETNUM() + 1
