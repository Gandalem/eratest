@ADD_HATEMARK_SUM
#FUNCTION
#DIM DYNAMIC nCounter
FOR LOCAL, 1, CHARANUM
	;first, check if there are any history marks and if their amount is greater than the current, add that to the counter
	IF MARK:LOCAL:反発取得履歴 > MARK:LOCAL:反発刻印
		nCounter += MARK:LOCAL:反発取得履歴
	ELSEIF MARK:LOCAL:反発刻印 > 0 ;check any current marks
		nCounter += MARK:LOCAL:反発刻印
	ELSEIF MARK:LOCAL:反発取得履歴 > 0 ;check history marks (removed ones basically)
		nCounter += MARK:LOCAL:反発取得履歴
	ENDIF
NEXT
RETURNF nCounter

