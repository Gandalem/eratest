@ADD_ACHIEVEMENTS_PRINT_CUSTOM_PAGE(PAGE)
#DIM PAGE

SELECTCASE PAGE
    CASE 1
        CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(1)
        CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(2)
        CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(3)
        CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(4)
        CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(5)
        CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(6)
		PRINTL
		FOR LOCAL, 10, 15
			CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(LOCAL)
			; removed, part of a removed achievement
			; SIF LOCAL == 10 && !ADD_ACHIEVEMENT_OBTAINFLAG:Achievement_SkillMaxed ;description too long
			; 	PRINTL
			SIF LOCAL == 14 && !ADD_ACHIEVEMENT_OBTAINFLAG:Achievement_TSPInsight ;description too long
				PRINTL
		NEXT
	CASE 2
		FOR LOCAL, 20, 25
			CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(LOCAL)
			SIF LOCAL == 21 && (!ADD_ACHIEVEMENT_OBTAINFLAG:Achievement_HateMarkApology || ADD_ACHIEVEMENT_TOGGLED:Achievement_HateMarkApology)
				PRINTL
			SIF LOCAL == 22 && (!ADD_ACHIEVEMENT_OBTAINFLAG:Achievement_HateMarkRedemption || ADD_ACHIEVEMENT_TOGGLED:Achievement_HateMarkRedemption)
				PRINTL
		NEXT
	CASE 3
		CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(30)
		CALL ADD_PRINT_CUSTOM_ACHIEVEMENT(31)
		
ENDSELECT

@ADD_PRINT_CUSTOM_ACHIEVEMENT(ACHIEVEMENT)
#DIM ACHIEVEMENT
#DIMS DYNAMIC HTML_TEXT
ADD_ACHIEVEMENT_MOUSEOVER =
TRYCCALLFORM ADD_ACHIEVEMENT_INFO{ACHIEVEMENT}
    IF !ADD_ACHIEVEMENT_LOCAL_OBTAINED:ACHIEVEMENT && !(ADD_ACHIEVEMENT_OBTAINABLE || ADD_ACHIEVEMENT_GLOBAL_OBTAINED:ACHIEVEMENT || ADD_ACHIEVEMENT_LOCAL_OBTAINED:ACHIEVEMENT)
		HTML_TEXT = <p align='left'><nonbutton title='%HTML_ESCAPE(ADD_ACHIEVEMENT_MOUSEOVER)%'>[{ACHIEVEMENT,3}] - Unlock Condition: %ADD_ACHIEVEMENT_REQUIREMENT% %ADD_ACHIEVEMENT_BONUS%</nonbutton>
		HTML_PRINT HTML_TEXT
    ELSE
    	IF ADD_ACHIEVEMENT_OBTAINED
			IF !ADD_ACHIEVEMENT_REMOVABLE
				SETCOLOR 100, 100, 100
				PRINTPLAINFORM [{ACHIEVEMENT,3}] - %ADD_ACHIEVEMENT_REQUIREMENT% Bonus【Completed】%ADD_ACHIEVEMENT_BONUS%
			ELSE
				IF !ADD_ACHIEVEMENT_OBTAINABLE
					SETCOLOR C_ORANGE
				ELSE
					SETCOLOR C_P_BLUE
				ENDIF
				PRINTFORM [{ACHIEVEMENT,3}] - %ADD_ACHIEVEMENT_REQUIREMENT% Bonus【Completed】%ADD_ACHIEVEMENT_BONUS%
			ENDIF
		ELSE
			SETCOLOR C_AQUA
			PRINTFORM [{ACHIEVEMENT,3}] - %ADD_ACHIEVEMENT_BONUS% Bonus
		ENDIF
		RESETCOLOR
		PRINTL
    ENDIF
CATCH
    DEBUGPRINTFORML No info for achievement index {ACHIEVEMENT} can be found.
ENDCATCH

@ADD_ACHIEVEMENTS_TOGGLE_ACHIEVEMENT(ACHIEVEMENT)
#DIM ACHIEVEMENT
TRYCCALLFORM ADD_ACHIEVEMENT_INFO{ACHIEVEMENT}
    IF !ADD_ACHIEVEMENT_OBTAINED && (ADD_ACHIEVEMENT_OBTAINABLE || ADD_ACHIEVEMENT_GLOBAL_OBTAINED:ACHIEVEMENT || ADD_ACHIEVEMENT_LOCAL_OBTAINED:ACHIEVEMENT)
        TRYCCALLFORM ADD_ACHIEVEMENT_TOGGLE{ACHIEVEMENT}
            ADD_ACHIEVEMENT_LOCAL_OBTAINED:ACHIEVEMENT = 1
        CATCH
        ENDCATCH
    ELSEIF ADD_ACHIEVEMENT_OBTAINED && ADD_ACHIEVEMENT_REMOVABLE
        TRYCALLFORM ADD_ACHIEVEMENT_TOGGLE{ACHIEVEMENT}
    ENDIF
CATCH
    DEBUGPRINTFORML No info for achievement index {ACHIEVEMENT} can be found.
ENDCATCH

