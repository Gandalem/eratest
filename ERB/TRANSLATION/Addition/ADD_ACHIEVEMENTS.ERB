@ADD_ACHIEVEMENT_TOGGLE22
ADD_ACHIEVEMENT_TOGGLED:Achievement_HateMarkRedemption = 1

@ADD_FORGIVEN_CHECK
#FUNCTION
#DIM DYNAMIC nChara
FOR LOCAL, 1, CHARANUM
;first, check if there are any history marks and if their amount is greater than the current, add that to the counter
IF MARK:LOCAL:反発取得履歴 == 3 && MARK:LOCAL:反発刻印 == 0
	RETURNF LOCAL
ENDIF
NEXT
RETURNF 0
;at the end of the turn

