@ADD_CALCULATE_MUSIC_COLLECTION
#DIM SCORE_NO			; 楽譜番号
#DIM SERIES_NO			; シリーズ番号
#DIM SERIES_SCORE_NO	; シリーズ内の楽譜番号
VARSET RESULT
RESULT:1 = 0
RESULT:2 = 0
FOR LOCAL, 0, 楽譜最大数
SCORE_NO = (楽譜名開始番号 + LOCAL)
SERIES_NO = GET_SERIES_NO(SCORE_NO)
SERIES_SCORE_NO = GET_SERIES_SCORE_NO(SCORE_NO)
IF SERIES_SCORE_NO == 0
	LOCAL:1 = EXEC_SCORES(楽譜処理モード：総数カウント, -1, SERIES_NO)	; 総数
	LOCAL:2 = EXEC_SCORES(楽譜処理モード：所持数カウント, -1, SERIES_NO); 所持数
	; 結果に加算
	RESULT:1 += LOCAL:1
	RESULT:2 += LOCAL:2
ENDIF
NEXT

@ADD_CALCULATE_FISH_COLLECTION
#DIM DYNAMIC 全種数
#DIM DYNAMIC 釣った種数
VARSET RESULT
FOR LOCAL, 1, 61
;魚が無名でない
IF FISH_NAME(LOCAL) != ""
	全種数 ++
	SIF FISH_EXP:(LOCAL)
		釣った種数 ++
ENDIF
NEXT
RESULT:1 += 全種数
RESULT:2 += 釣った種数

@ADD_CALCULATE_ALCOHOL_COLLECTION
#DIM DYNAMIC TOTAL_DRINKS
#DIM DYNAMIC DRINKS_COLLECTED
VARSET RESULT
ADD_ACHIEVEMENT_MOUSEOVER = Not yet consumed:\n
FOR LOCAL, 1, OBJ_ID_LAST
IF GET_INT(0, "酒データ", LOCAL, "酒気増加量") > 0
	TOTAL_DRINKS++
	IF BREWING_CONSUMED_DRINKS:LOCAL
		DRINKS_COLLECTED++
	ELSE
		ADD_ACHIEVEMENT_MOUSEOVER += @"%ITEMNAME_TR(GETNUM(ITEM, GET_STR(0, "酒データ", LOCAL, "名称")))%\n"
	ENDIF
ENDIF
NEXT
RESULT:1 += TOTAL_DRINKS
RESULT:2 += DRINKS_COLLECTED

