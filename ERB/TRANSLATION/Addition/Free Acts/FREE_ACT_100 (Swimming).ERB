; Modular ERB: Addition/Free Acts/FREE_ACT_100 (Swimming).ERB
;遊ぶ

@EXIST_FreeAct100
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct100(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
SELECTCASE O_DATA
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "SWIMMING")
	CASE "CHAIN"
		;他キャラに連鎖する場合コメントアウト外すこと
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;未入力だと最大30分
		;	CALLF MAKE_INT(V_NAME, 経過時間)
ENDSELECT

@自由行動内容_100(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		SIF !ADD_SWIMMING_AREA(現在地)
			RETURN 0
		SIF TEQUIP:CHARA:SWIMMING
			RETURN 0
		SIF !ADD_SWIMMING_CONSTITUTION(ADD_WEATHER_HARSHNESS(現在地),CHARA)
			RETURN 0
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA% \@ CHAIN ? 합류하여 수영을 시작한다 %CALLNAME:CHAIN% # %ADD_SWIMMING_DESCRIPTION(現在地)%에서 수영을 시작한다. \@.
		CALL ADD_START_SWIMMING(CHARA)
		RETURN 60 + RAND:60
	CASE "行動中"
		IF メッセージ表示
			PRINTFORMW %조사처리(CALLNAME:CHARA,"는")% %TEXTR(@"%ADD_SWIMMING_DESCRIPTION(現在地)% 근처에서 놀고 있다/느긋하게 헤엄치고 있다/숨을 오래 참아 보려 한다")%.
		ENDIF
	CASE "完了"
		EXP:CHARA:戦闘経験 += 1
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 수영에 질린 것 같다.
		CALL ADD_END_SWIMMING(CHARA)
	CASE "中断"
		EXP:CHARA:戦闘経験 += 1
		CALL ADD_END_SWIMMING(CHARA)
	CASE "付き合う"
		PRINTFORML 당신은 %CALLNAME:CHARA%와 함께 수영을 간다.
		IF TFLAG:193 > 0
			PRINTFORML 정말 즐거운 시간을 보냈다!
		ELSEIF TFLAG:193 < 0
			PRINTFORML 몸이 조금 무겁게 느껴진다...
		ENDIF
	CASE "ソース"
		DOWNBASE:MASTER:体力 += 40 * 時間係数
		DOWNBASE:MASTER:気力 += 40 * 時間係数
		DOWNBASE:TARGET:体力 += 20 * 時間係数
		DOWNBASE:TARGET:気力 += 20 * 時間係数
		SELECTCASE RAND:10
			CASE 1
				;10%で大成功
				TFLAG:193 = 1
				SOURCE:歓楽 = (200 + ((ABL:親密 + 好感度係数(TARGET)) * 80)) * 時間係数
				SOURCE:受動 = (120 + ((ABL:従順 + 好感度係数(TARGET)) * 80)) * 時間係数
				SOURCE:征服 = (120 + (ABL:サドっ気 * 120)) * 時間係数
				TFLAG:98 = 2
			CASE 2
				;10%で失敗
				TFLAG:193 = -1
				SOURCE:歓楽 = (100 + ((ABL:親密 + 好感度係数(TARGET)) * 30)) * 時間係数
				SOURCE:受動 = (50 + ((ABL:従順 + 好感度係数(TARGET)) * 20)) * 時間係数
				SOURCE:征服 = (50 + (ABL:サドっ気 * 50)) * 時間係数
			CASEELSE
				SOURCE:歓楽 = (150 + ((ABL:親密 + 好感度係数(TARGET)) * 50)) * 時間係数
				SOURCE:受動 = (100 + ((ABL:従順 + 好感度係数(TARGET)) * 50)) * 時間係数
				SOURCE:征服 = (100 + (ABL:サドっ気 * 100)) * 時間係数
				TFLAG:98 = 1
		ENDSELECT
ENDSELECT
