; Modular ERB: Addition/Free Acts/FREE_ACT_101 (Play with Children).ERB
;遊ぶ

@EXIST_FreeAct101
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@FreeAct101(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM 経過時間
SELECTCASE O_DATA
	CASE "名称"
		CALLF MAKE_STR(V_NAME, "PLAYING_WITH_CHILDREN")
	CASE "CHAIN"
		;他キャラに連鎖する場合コメントアウト外すこと
		CALLF MAKE_INT(V_NAME, 1)
	CASE "経過時間"
		;自由行動に付き合うコマンドでの経過時間
		;未入力だと最大30分
		CALLF MAKE_INT(V_NAME, 10)
ENDSELECT

@自由行動内容_101(CHARA, ARGS, 時間係数, CHAIN)
#DIM CHARA
#DIM CHAIN
#DIM 現在地
#DIM メッセージ表示
#DIM 時間係数
#DIM 経過時間
現在地 = CFLAG:CHARA:現在位置
メッセージ表示 = 現在地 == CFLAG:MASTER:現在位置 ? 1 # 0
SELECTCASE ARGS
	CASE "発生"
		SIF !メッセージ表示 ;can effectively only trigger if player is present, due to how children work
			RETURN 0
		SIF !IS_CHILD(CHARA, "mind") && !TALENT:CHARA:妖精 && CHARA != [[瓔花]] ;either child or fairy or Eika
			RETURN 0
		SIF BASE:CHARA:気力 <= 500
			RETURN 0
		SIF !自由行動内容_101_YOUNG_CHILDREN_NEARBY()
			RETURN 0
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA% \@ CHAIN ? %CALLNAME:CHAIN%와 함께 놀기 시작하며 %自由行動内容_101_DESC()%과 논다 # %自由行動内容_101_DESC()%과 노는 것을 한다 \@.
		RETURN 30 + RAND:30
	CASE "行動中"
		IF !自由行動内容_101_YOUNG_CHILDREN_NEARBY()
			CALL FA15_RESET(CHARA)
		ELSEIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%은(는) %自由行動内容_101_GAME()%와 함께 %自由行動内容_101_DESC()%이다.
		ENDIF
	CASE "完了"
		SIF メッセージ表示
			PRINTFORMW %CALLNAME:CHARA%는 연주를 멈춘다.
	CASE "中断"
	CASE "付き合う"
		PRINTFORML 당신은 %CALLNAME:CHARA%가 %自由行動内容_101_DESC()%을 가지고 노는 것을 함께 한다.
		IF TFLAG:193 > 0
			PRINTFORML 모두 즐거운 시간을 보냈다!
			CALL 自由行動内容_101_ADD_LOVE(2)
		ELSEIF TFLAG:193 < 0
			PRINTFORML 아이들이 그렇게 즐기고 있는 것 같지는 않네요...
		ELSE
			PRINTFORML 정말 재미있다.
			CALL 自由行動内容_101_ADD_LOVE(1)
		ENDIF
	CASE "ソース"
		DOWNBASE:MASTER:体力 += 20 * 時間係数
		DOWNBASE:MASTER:気力 += 20 * 時間係数
		DOWNBASE:TARGET:体力 += 10 * 時間係数
		DOWNBASE:TARGET:気力 += 10 * 時間係数
		SELECTCASE RAND:10
			CASE 1
				;10%で大成功
				TFLAG:193 = 1
				SOURCE:歓楽 = (200 + ((ABL:親密 + 好感度係数(TARGET)) * 80)) * 時間係数
				SOURCE:受動 = (120 + ((ABL:従順 + 好感度係数(TARGET)) * 80)) * 時間係数
				SOURCE:征服 = (120 + (ABL:サドっ気 * 120)) * 時間係数
				TFLAG:98 = 2
			CASE 2
				;10%で失敗
				TFLAG:193 = -1
				SOURCE:歓楽 = (100 + ((ABL:親密 + 好感度係数(TARGET)) * 30)) * 時間係数
				SOURCE:受動 = (50 + ((ABL:従順 + 好感度係数(TARGET)) * 20)) * 時間係数
				SOURCE:征服 = (50 + (ABL:サドっ気 * 50)) * 時間係数
			CASEELSE
				SOURCE:歓楽 = (150 + ((ABL:親密 + 好感度係数(TARGET)) * 50)) * 時間係数
				SOURCE:受動 = (100 + ((ABL:従順 + 好感度係数(TARGET)) * 50)) * 時間係数
				SOURCE:征服 = (100 + (ABL:サドっ気 * 100)) * 時間係数
				TFLAG:98 = 1
		ENDSELECT
ENDSELECT

@自由行動内容_101_DESC()
#FUNCTIONS
LOCALS =
LOCAL:1 = 0
FOR LOCAL, 0, nChildrenPresentCount
SIF !自由行動内容_101_CHILD_CAN_PLAY(nChildrenPresent:LOCAL)
	CONTINUE
LOCALS += @"%CHILDNAME:(nChildrenPresent:LOCAL % 1000):(nChildrenPresent:LOCAL / 1000)%、"
LOCAL:1 ++
SIF LOCAL:1 > 4 ;no more than four
	RETURNF "아이들"
NEXT
SIF !LOCAL:1
	RETURNF "아무도"
RETURNF LIST_IN_STRING(LOCALS)

@自由行動内容_101_YOUNG_CHILDREN_NEARBY()
#FUNCTION
LOCAL:1 = 0
FOR LOCAL, 0, nChildrenPresentCount
SIF 自由行動内容_101_CHILD_CAN_PLAY(nChildrenPresent:LOCAL)
	RETURNF 1
NEXT
RETURNF 0

@自由行動内容_101_CHILD_CAN_PLAY(CHILD_ID)
#FUNCTION
#DIM CHILD_ID
#DIM CHARA
#DIM CHILDNUM
CHARA = CHILD_ID % 1000
CHILDNUM = CHILD_ID / 1000
SIF !STRLENS(CHILDNAME:CHARA:CHILDNUM)
	RETURNF 0
SIF CHILD_INDEPENDENT:CHARA:CHILDNUM
	RETURNF 0
SIF (DAY - CHILD_BIRTHDAY:CHARA:CHILDNUM) < CHILD_語彙
	RETURNF 0
RETURNF 1

@自由行動内容_101_ADD_LOVE(POINTS)
#DIM CHARA
#DIM CHILDNUM
#DIM POINTS
FOR LOCAL, 0, nChildrenPresentCount
SIF !自由行動内容_101_CHILD_CAN_PLAY(nChildrenPresent:LOCAL)
	CONTINUE
CHARA = nChildrenPresent:LOCAL % 1000
CHILDNUM = nChildrenPresent:LOCAL / 1000
CHILD_LOVE:CHARA:CHILDNUM += POINTS
PRINTFORML 아이의 애정 +{POINTS}(%CHILDNAME:CHARA:CHILDNUM%, 총합: {CHILD_LOVE:CHARA:CHILDNUM})
NEXT
;different games, varying by TIME so all participants say the same thing

@自由行動内容_101_GAME()
#FUNCTIONS
LOCAL = TIME % 50 / 10
SELECTCASE LOCAL
	CASE 0
		RETURNF "술래잡기"
	CASE 1
		RETURNF "숨바꼭질"
	CASE 2
		RETURNF "노래 부르기"
	CASE 3
		RETURNF "벌레 찾기"
	CASE 4
		RETURNF "마구 뛰어다니기"
ENDSELECT
