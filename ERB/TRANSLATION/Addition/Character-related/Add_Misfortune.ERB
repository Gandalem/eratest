; Modular ERB: Addition/Character-related/Add_Misfortune.ERB

@UNIQUE_COM_厄を払う
IF nHinaMisfortuneGone > 0
	CALL SPTALK, [[雛]], "通常", 0, @"「사과하지만 당신에 대한 나의 힘을 여전히 느낄 수 있어요。」/「더 이상은 당신의 건강이나 운명에 어떤 방식으로든 위협이 될지도 몰라요。」/「음... %PRINT_PLUR("day", nHinaMisfortuneGone)%밖에 남지 않았다고 봐야겠네요.」/「그게 사라진 후에 다시 만나는 건 괜찮아요, 알겠죠?」", 1
	RETURN -1
ENDIF
IF FIRSTTIME("MisfortuneCollect", 0, [[雛]])
	PRINTFORMW 당신은 히나에게 최근 유난히 운이 나쁘다고 말하며, 그녀가 타인의 불행을 모으는 것을 전문으로 하는지 묻는다.
	IF TALENT:[[雛]]:恋慕
		CALL SPTALK, [[雛]], "通常", 0, @"「나 정말 그래! 하지만 왜 나한테 이런 걸 다 묻는 거야? 너도 무슨 고민이 있는 거야?」", 1
		WAIT
		PRINTFORMW 그녀는 상당히 놀란 듯 말한다.
		CALL SPTALK, [[雛]], "通常", 0, @"「무슨 일이야? 혹시 고민이 있다면 들어주고 싶어.」", 1
		WAIT
	ELSE
		CALL SPTALK, [[雛]], "Smug", 0, @"「그렇게 말할 수도 있겠네요.」", 1
		WAIT
		PRINTFORMW 그녀는 살짝 미소 지으며 말한다.
		CALL SPTALK, [[雛]], "通常", 0, @"「하지만 있잖아, 나는 보통 그런 종류의 일에 대해 사람들과 이야기할 기회가 없어. 어쨌든 그들이 나를 피하거든.」", 1
		WAIT
		PRINTFORMW 당신은 그녀에게 자신의 불운을 모아달라고 말한다.
		CALL SPTALK, [[雛]], "通常", 0, @"「불운의 신에게 어떠한 관심을 기울이는 것은 금기다, 모르나? 내가 직접 말해줬잖아, 안 그랬어?」/「만약 자신이 불운에 빠졌다고 생각한다면, 신사나 절에서 정화를 요청하는 것이 가장 좋다.」", 1
		WAIT
		PRINTFORMW 그녀를 설득하려고 한다...
		CALL SPTALK, [[雛]], "笑顔", 0, @"「오? 그렇게 절박한 거야?」", 1
		WAIT
		LOCALS '= "「But no matter how much misfortune I collect, there's always more.」/"
		LOCALS += "「However, it's true that misfortune is just the opposite side of fortune. One may say that I'm a holder of good fortune as well...」/"
		LOCALS += "「Well, I'll listen. What is it? I would like to hear about it if there's something troubling you.」"
		CALL SPTALK, [[雛]], "通常", 0, LOCALS, 1
		WAIT
	ENDIF
	PRINTFORMW 당신은 "계속 불운하기 지쳤어요!"라고 애원한다.
	IF TALENT:[[雛]]:恋慕
		CALL SPTALK, [[雛]], "HINA", 0, @"「음... 아, 불쌍한 것. 그렇다면, 내가 도와주마!」", 1
		PRINTFORMW 히나는 활짝 웃는다.
		PRINTFORMW 부디 그렇게 해 주세요!
		CALL SPTALK, [[雛]], "通常", 0, @"「음... 음흠... 응? 나에게 줄 게 아무것도 없어?」", 1
		PRINTFORMW 그녀는 고개를 기울이며 묻는다.
	ELSE
		CALL SPTALK, [[雛]], "通常", 0, @"「아, 내 능력을 행운을 위해 쓰려고 하는군?」/「좀 특이하긴 하지만 괜찮아, 해줄게. 그렇게 정중하게 부탁했으니... 공짜로 해줄지도 모르지.」", 1
		WAIT
		CALL SPTALK, [[雛]], "Smug", 0, @"「아니면 안 할지도 몰라! 어쨌든 일을 잘 해낸 것에 대한 대가는 뭔가 있어야 하지 않겠어, 응?」", 1
		WAIT
	ENDIF
	CALL 厄を払う_PAYMENT
	CALL SPTALK, [[雛]], "通常", 0, @"「자, 이제 그 일은 끝났으니 시작해 볼까요?」", 1
	PRINTFORMW 히나가 다가오며 말한다.
	CALL SPTALK, [[雛]], "通常", 0, @"「오 네네, 너에게 많은 불운이 드리워져 있음을 감지했어...」/「흠, 오 그래, 그것을 없애는 건 식은 죽일 일이지. 움직이지 않으면 돼...」", 1
	PRINTFORMW 히나는 빙글빙글 돌기 시작하고 그녀에게서 빨간 리본들이 떠나와 당신의 몸을 감싼다.
	CALL SPTALK, [[雛]], "笑顔", 0, @"「그냥 가만히 있어도 돼. 불행을 모으는 간단한 의식일 뿐이야.」", 1
	PRINTFORMW 히나는 상냥하게 미소 지으며 말한다.
	PRINTFORMW 그녀는 이어서 오른팔을 뻗는다.
	PRINTFORMW 두껍고 보라빛이 도는 푸른 구름이 갑자기 그녀의 손 주위에 형성되기 시작하며, 그것은 순식간에 당신 쪽으로 기어오기 시작한다.
	PRINTFORMW 그것은 빠르게 당신의 머리를 감싸고, 당신은 그 압력을 저항할 수 없게 된다. 한순간에 당신의 시야는 흐릿하고 초점이 없어진다.
	CALL SPTALK, [[雛]], "通常", 0, @"「쉬이, 쉬잇, 쉬잇. 걱정 마, 곧 모든 게 괜찮아질 거야. 그냥 침착해... 음음?」", 1
	WAIT
	PRINTFORMW 당신은 귀에서 윙 하는 소리를 들리기 시작한다. 심장이 더 빠르게 뛰고 가슴이 아파오기 시작한다.
	CALL SPTALK, [[雛]], "笑顔", 0, @"「걱정할 것 없어, %CALLNAME:MASTER%님.」/「내 주문일 뿐이야. 날 믿지 못한다면 지금 그만둬도 돼.」", 1
	WAIT
	PRINTFORMW 히나는 부드러운 목소리로 당신을 안심시킨다. 당신은 히나가 환상향에서 가장 좋은 사람 중 한 명이라는 것을 알기에 그녀를 믿기로 한다.
	CALL SPTALK, [[雛]], "笑顔", 0, @"「고마워.」", 1
	PRINTFORMW 히나는 명랑하게 말한다. 고개를 끄덕이자 그녀의 머리카락이 부드럽게 흩날렸다.
	CALL SPTALK, [[雛]], "通常", 0, @"「하지만 아주 간단한 주문이니까 문제없을 거야。」 / 「나는 당신의 모든 불운을 모아서 제거하고 정화할 것이다.」 / 「정화되면 모두 사라지니 걱정할 필요 없어...」", 1
	WAIT
	PRINTFORMW 하지만 몇 분 후에 모든 것이 어둠으로 변했다...
	FOR LOCAL, 0, 100
	PRINTFORML
	NEXT
	PRINTFORMW 당신은 조금 뒤에 도착했고, 예전과 같은 장소에서 히나 앞에 서 있는 자신을 발견한다. 그녀는 매우 명랑해 보인다.
	CALL SPTALK, [[雛]], "HINA", 0, @"「후후후! 그래, 아주 좋아. 누군가의 불운을 직접 수집한 지 오랜만이야!」", 1
	WAIT
	CALL SPTALK, [[雛]], "笑顔", 0, @"「드디어 끝났네. 꽤 고생했지만 해냈어.」/「모든 불행을 인형에 담아 강으로 흘려보낼 수도 있지만, 직접 하는 게 훨씬 빠르지.」", 1
	WAIT
	PRINTFORMW 히나는 즐겁게 웃으며 말한다. 그녀가 그렇게 표현하자면 그리 쉬운 일은 아니었던 모양이다...
	PRINTFORMW 하지만 이제 생각해보니... 세상의 무게가 어깨에서 떨어진 것처럼 몸이 가벼워진다.
	CALL SPTALK, [[雛]], "Smug", 0, @"「어쨌든, 끝났다! 불운의 저주가 너에게서 떠났으니, 이제...」", 1
	PRINTFORMW 히나는 잠시 멈추고 손을 당신에게 내민다. 당신은 그것을 호기심 어린 눈으로 바라본다.
	PRINTFORMW 아, 맞다, 지불...
	PRINTFORML 카리스마: %DIGIT_GROUP(MONEY:2)%
	IF ITEM:497 > 0 ;hina doll
		CALL ASK_YN("히나 인형으로 지불한다", "카리스마로 지불한다")
		IF !RESULT
			CALL SPTALK, [[雛]], "笑顔", 0, @"「아, 그래, 우리가 합의한 대로 이게 됐군.」", 1
			CALL COLORMESSAGE(@"%ITEMNAME_TR(497)%을 거래했다.", C_YELLOW, 2)
			ITEM:497 = MAX(ITEM:497 - 1, 0)
			WAIT
		ELSE
			GOTO CHARISMA
		ENDIF
	ELSE
		$CHARISMA
		PRINTFORMW 당신은 그녀에게 카리스마가 얼마의 가치가 있다고 생각하는지 묻는다.
		CALL SPTALK, [[雛]], "通常", 0, @"「음... 뭐, 당신을 불운한 운명에서 구해줬으니 나에게도 큰 도움이 되었지.」", 1
		WAIT
		PRINTFORMW 그녀는 이내 혼자 웃는다.
		CALL SPTALK, [[雛]], "笑顔", 0, @"「음, 이 정도는 받을 수 있을 거라고 생각하는데. 아니면 너무 무리한 요구인가?」", 1
		WAIT
		CALL SPTALK, [[雛]], "通常", 0, @"「내가 이해하기로는 카리스마는 상당히 변덕스럽다... 어느 날은 큰 가치가 있을 수 있고, 다음 날에는 아무것도 없을 수도 있다.」", 1
		CALL ASK_YN("협상을 시도한다.", "괜찮아")
		IF !RESULT
			LOCALS '= "「Hmm... I remember stumbling upon several shops where they take Charisma as payment, and 10 seems to be the norm.」/"
			LOCALS += "「I do believe that good service should be repaid accordingly, don't you agree?」/"
			LOCALS += "「So I think we should settle on 10... Yes, 10 seems fine to me. Is it for you?」"
			CALL SPTALK, [[雛]], "通常", 0, LOCALS, 1
			WAIT
			PRINTFORMW 히나를 설득하는 건 시간 낭비인 것 같다...
			PRINTFORMW 대신 돈을 지불하기로 결정한다.
			GOTO PAY
		ELSE
			$PAY
			CALL SPTALK, [[雛]], "笑顔", 0, @"「좋아, 멋지다! 그럼 카리스마 10 좀 부탁해!」", 1
			WAIT
			CALL PAY_MONEY_CM(10, 2)
		ENDIF
	ENDIF
	DOWNBASE:MASTER:体力 = 500
	TIME += 30
ELSE
	CALL SPTALK, [[雛]], "通常", 0, @"「오? 네 불행을 또 받아주길 바라는 거냐?」", 1
	WAIT
	CALL SPTALK, [[雛]], "HINA", 0, @"「좋아요. 괜찮으시다면 곧 시작하겠습니다.」", 1
	WAIT
	PRINTFORMW 히나는 당신의 대답을 기다리며 미소 짓는다.
	CALL ASK_YN("부디 해주세요", "오늘은 안 돼")
	IF RESULT
		CALL SPTALK, [[雛]], "通常", 0, @"「마음이 바뀌었군요? 괜찮아요.」/「다음에 다시 물어봐 주세요. 준비가 되시면 언제든 여기 있을게요.」", 1
		WAIT
		RETURN -1
	ENDIF
	PRINTFORMW 주변을 둘러보니 머리부터 발끝까지 주름진 빨간 리본이 가득한 것을 볼 수 있다.
	PRINTFORMW 히나는 당신 옆으로 다가와 양손으로 당신의 어깨를 잡고 한 번 흔든다.
	CALL SPTALK, [[雛]], "通常", 0, @"「네, 이거 좋네요... 이것을 마음껏 맛보게 해주세요.」", 1
	WAIT
	CALL SPTALK, [[雛]], "笑顔", 0, @"「걱정 마, 난 이걸 아주 잘 해. 실수할 방법 따윈 없어. 어쨌든 내 일이니까.」", 1
	WAIT
	PRINTFORMW %BREAKENG(@"순식간에 어깨의 긴장이 사라지는 것을 느낄 수 있다. 몸이 가벼워지며 마치 세상의 무게가 어깨에서 벗겨진 듯하다.")%
	CALL SPTALK, [[雛]], "通常", 0, @"「훌륭해... 오늘 수확에 매우 만족한다.」", 1
	WAIT
	SIF FIRSTTIME("MisfortuneCollect2")
		PRINTFORMW 이번엔 훨씬 빨라진 것 같네요. 히나는 당신을 다루는 데 더 익숙해진 모양이군요...
	TIME += 5
	DOWNBASE:MASTER:体力 = 100
	PRINTFORML
	IF ITEM:497 > 0 ;hina doll
		CALL ASK_YN("히나 인형으로 지불한다", "카리스마로 지불한다")
		IF !RESULT
			CALL SPTALK, [[雛]], "笑顔", 0, @"「아, 그래, 우리가 합의한 대로 이게 됐군.」", 1
			CALL COLORMESSAGE(@"%ITEMNAME_TR(497)%을 거래했다.", C_YELLOW, 2)
			ITEM:497 = MAX(ITEM:497 - 1, 0)
			WAIT
		ELSE
			GOTO CHARISMA2
		ENDIF
	ELSE
		$CHARISMA2
		CALL SPTALK, [[雛]], "笑顔", 0, @"「정말 고마워요!」", 1
		WAIT
		CALL PAY_MONEY_CM(10, 2)
	ENDIF
ENDIF
DOWNBASE:[[雛]]:気力 = 300
TALENT:[[雛]]:機嫌 = 1
PRINTFORML
CALL 厄を払う_FORTUNE
PRINTFORML
IF TALENT:[[雛]]:恋慕
	CALL SPTALK, [[雛]], "笑顔", 0, @"「후훗... 당신을 위해서라면 언제든지, %CALLNAME:MASTER%씨.」/「다시 운이 없다고 느껴지면 주저하지 말고 나에게 말해줘, 알겠지?」", 1
	PRINTFORMW 히나는 당신의 뺨에 부드러운 키스를 하기 전에 말한다...
ELSE
	CALL SPTALK, [[雛]], "通常", 0, @"「지금 따라와라. 나와 여기서 너무 오래 있으면 그동안의 모든 노력이 물거품이 될 거야, 알잖아?」", 1
	WAIT
	LOCALS '= SPLIT_G("Even if you see me again, pretend you didn't:Don't walk on the same road as me:Don't bring me up in a conversation:I may be a god, but I do not seek faith. Please do not worship me under any circumstances")
	CALL SPTALK, [[雛]], "通常", 0, "「" + LOCALS + "!」", 1
	PRINTFORMW 히나는 너를 배웅하며 엄격하게 말한다...
ENDIF
RETURN 1

@厄を払う_FORTUNE
SELECTCASE TFLAG:幸運補正
	CASE -5
		IF !RAND:10
			TFLAG:幸運補正 = 5
		ELSEIF !RAND:4
			TFLAG:幸運補正 = 3
		ELSEIF RAND:2
			TFLAG:幸運補正 = 1
		ELSE
			TFLAG:幸運補正 = 0
		ENDIF
	CASE -3
		IF !RAND:6
			TFLAG:幸運補正 = 3
		ELSEIF RAND:2
			TFLAG:幸運補正 = 1
		ELSE
			TFLAG:幸運補正 = 0
		ENDIF
	CASEELSE
		TFLAG:幸運補正 = RAND:2 ? 1 # 0
ENDSELECT
SIF CFLAG:MASTER:今日の運勢 < 500
	CFLAG:MASTER:今日の運勢 = 500
IF nHinaMisfortuneGone == 0
	PRINTFORMW 며칠 동안은 불행이 당신을 피할 것이다...
	nHinaMisfortuneGone = 3
ELSEIF nHinaMisfortuneGone > 0
	PRINTFORMW 뭔가 불운이 당신 주위에 모인 것 같다.
	PRINTFORMW ...하지만 히나의 마법이 당신을 나쁜 운으로부터 보호한다!
ENDIF

@厄を払う_PAYMENT
CALL SPTALK, [[雛]], "通常", 0, @"「돈으로는 안 돼. 난 그것을 쓸 곳이 없어.」", 1
WAIT
PRINTFORMW 그럼 카리스마는 어때...?
CALL SPTALK, [[雛]], "通常", 0, @"「카리스마???」", 1
PRINTFORMW 히나는 혼란스러운 듯 외친다.
PRINTFORMW 너는 그것을 그녀에게 설명한다.
CALL SPTALK, [[雛]], "通常", 0, @"「오호. 흥미롭게 들리네.」", 1
PRINTFORMW 히나는 흥미를 느끼는 듯하다. 그러고는 행복하게 미소 지으며 답한다.
CALL SPTALK, [[雛]], "笑顔", 0, @"「내가 더 카리스마가 있다면, 나는 더 인기 있을 거고, 내가 더 인기가 많다면 더 많은 사람들이 내 서비스를 이용할 거야。」/「세상에 만연한 불행이 줄어들 거고; 모두를 도울 수 있게 될 거야!」/「윈-윈 상황이지, 맞지?!」", 1
WAIT
PRINTFORMW 음... 알겠어.
CALL SPTALK, [[雛]], "笑顔", 0, @"「좋아! 그럼, 받아들일게!」", 1
PRINTFORMW 히나는 손뼉을 치며 기쁨에 웃었다.
PRINTFORMW 야호!
PRINTFORML
IF ITEM:497 > 0 ;hina doll
	CALL SPTALK, [[雛]], "通常", 0, @"「아, 잠깐만요. 저게 뭐지?」", 1
	PRINTFORMW 그녀는 네가 들고 있는 인형을 가리킨다.
	CALL SPTALK, [[雛]], "笑顔", 0, @"「아... 정말 사랑스러운 인형이네, 꼭 나를 닮았어...」", 1
	WAIT
ELSE
	PRINTFORMW 히나는 옷 아래에서 인형을 꺼낸다. 그것은 그녀와 매우 닮았다...
	CALL SPTALK, [[雛]], "笑顔", 0, @"「이것은 나가시비나, 혹은 간단히 히나 인형이다. 사랑스럽지 않니?」", 1
	WAIT
ENDIF
LOCALS '= "「Say, if you find any more of these, I can take them as payment for my services. You can find them at Genbu River pretty regularly.」/"
LOCALS += "「And if you decide to sell them... You will help me out a lot!」/"
LOCALS += "「I try to sell them myself, but no one is buying. It seems that people are just too afraid to approach me...」/"
LOCALS += "「Well, of course they are. And frankly, they should.」"
CALL SPTALK, [[雛]], "通常", 0, LOCALS, 1
WAIT
;------------------------------------------------------
;process the extra flags
;when starting the day

@EVENTTRAIN
#LATER
SIF nHinaMisfortuneGone > 0
	nHinaMisfortuneGone --
IF nHinaMisfortuneGone < 0 ;failsafe
	nHinaMisfortuneGone = 0
	PRINTFORMW 히나의 마법 효과가 만료되었다.
ENDIF
SIF (TFLAG:幸運補正 < 0 || CFLAG:MASTER:今日の運勢 < 500) && nHinaMisfortuneGone > 0
	CALL 厄を払う_FORTUNE

@NG_CUSTOM_RESET_VAR_0
nHinaMisfortuneGone = 0
