@Add_Duplicate_Character(CHARA, UNIQUE_NAME, UNIQUE_CALLNAME, PERSISTENT)
#DIM  CHARA
#DIMS UNIQUE_NAME
#DIMS UNIQUE_CALLNAME
#DIM  PERSISTENT
#DIM  NEW_CHARA

IF CFLAG:CHARA:IS_DUPLICATE
	PRINTFORMDL Cannot create duplicate of duplicate.
	RETURN -1
ELSEIF キャラクタ数上限 <= CHARANUM ;no more room
	PRINTFORMDL Cannot create duplicates over the character limit.
	RETURN -1
ENDIF

CFLAG:CHARA:MARKED_FOR_DELETION = 0 ;in case this was ever accidentally set

ADDCOPYCHARA CHARA
NEW_CHARA = CHARANUM - 1
CFLAG:NEW_CHARA:IS_DUPLICATE = 1
CFLAG:NEW_CHARA:DUPLICATE_CHARACTER = CHARA
CFLAG:NEW_CHARA:PERSISTENT_DUPLICATE = PERSISTENT
;no requests
CFLAG:NEW_CHARA:依頼状況 = 0
CFLAG:NEW_CHARA:依頼内容 = 0

;remove panties from collection (use main body instead)
FOR LOCAL,0,MAXPANTS
	CFLAG:NEW_CHARA:(LOCAL + パンツ管理) = 0
NEXT

CALLNAME:NEW_CHARA '= UNIQUE_CALLNAME
NAME:NEW_CHARA '= UNIQUE_NAME

RETURN NEW_CHARA

@Add_Remove_Duplicates_Of_Character(CHARA, INCLUDE_PERSISTENT = 0)
#DIM CHARA
#DIM INCLUDE_PERSISTENT

FOR LOCAL, 1, CHARANUM
	IF CFLAG:LOCAL:IS_DUPLICATE && CFLAG:LOCAL:DUPLICATE_CHARACTER == CHARA && (INCLUDE_PERSISTENT || !CFLAG:LOCAL:PERSISTENT_DUPLICATE)
		;this only marks them for deletion, actual deletion is handled later
		CFLAG:LOCAL:MARKED_FOR_DELETION = 1
		DEBUGPRINTFORML ({LOCAL}) %CALLNAME:LOCAL% marked for deletion.
	ENDIF
NEXT

@Add_Remove_All_Duplicates(INCLUDE_PERSISTENT = 0)
#DIM INCLUDE_PERSISTENT
FOR LOCAL, 1, CHARANUM
	IF CFLAG:LOCAL:IS_DUPLICATE && (INCLUDE_PERSISTENT || !CFLAG:LOCAL:PERSISTENT_DUPLICATE)
		;this only marks them for deletion, actual deletion is handled later
		CFLAG:LOCAL:MARKED_FOR_DELETION = 1
		DEBUGPRINTFORML ({LOCAL}) %CALLNAME:LOCAL% marked for deletion.
	ENDIF
NEXT

;handles the actual deletion of duplicated characters
@Add_Handle_Duplicate_Deletion(IMMEDIATE, INCLUDE_PERSISTENT)
#DIM IMMEDIATE
#DIM INCLUDE_PERSISTENT
DEBUGPRINTFORML Add_Handle_Duplicate_Deletion called.
FOR LOCAL, CHARANUM-1, 0, -1
	IF (IMMEDIATE && (CFLAG:LOCAL:IS_DUPLICATE && (INCLUDE_PERSISTENT || !CFLAG:LOCAL:PERSISTENT_DUPLICATE))) || (!IMMEDIATE && CFLAG:LOCAL:MARKED_FOR_DELETION)
		DEBUGPRINTFORML Deleting ({LOCAL}) %CALLNAME:LOCAL%.
		CALLF ClearAllHediffs(LOCAL)
		CALL ADD_TOUCH_CLEAR_CHARA(LOCAL)
		IF NO:LOCAL == 0
			BASE:MASTER:体力 = MAX(BASE:MASTER:体力 + BASE:LOCAL:体力, MAXBASE:MASTER:体力)
			BASE:MASTER:気力 = MAX(BASE:MASTER:気力 + BASE:LOCAL:気力, MAXBASE:MASTER:気力)
			BASE:MASTER:精力 = MAX(BASE:MASTER:精力 + BASE:LOCAL:精力, MAXBASE:MASTER:精力)
			PLAYER = 0
			ASSI = 0
		ENDIF
		DELCHARA LOCAL
	ENDIF
NEXT

;fallback cleanup event
@EVENTEND
#PRI
CALL Add_Handle_Duplicate_Deletion(1, 0)

;handles the actual deletion of duplicated characters
@EVENTCOMEND
#LATER
CALL Add_Handle_Duplicate_Deletion(0, 0)
		CALLF ClearAllHediffs(LOCAL)
;target can become invalid, clean it up here
CALL TARGETSET_CHACK

;returns the value of TFLAG:HandlingDuplicateCharacter if it's valid, otherwise returns CHARA
;not a #FUNCTION to enable TRYCALL mechanisms
@Add_Get_Duplicate_Id(CHARA)
#DIM CHARA
SIF TFLAG:HandlingDuplicateCharacter
	RETURN TFLAG:HandlingDuplicateCharacter
RETURN CHARA

@Add_Is_Duplicate_Of_Master(CHARA)
#FUNCTION
#DIM CHARA
SIF CHARA > 0 && CHARA < CHARANUM && NO:CHARA == MASTER
	RETURNF 1
RETURNF 0

@ADD_SHOW_PLAYER_BODIES
#DIM DIGITS
IF CMATCH(NO, MASTER) > 1
	LOCAL:1 = 1
	RESETCOLOR
	DIGITS = MAX(STRLENS(TOSTR(MAXBASE:MASTER:体力)), STRLENS(TOSTR(MAXBASE:MASTER:気力)), STRLENS(TOSTR(MAXBASE:MASTER:精力)))
	PRINTL
	PRINTFORMDL Active bodies:
	FOR LOCAL, 0, CHARANUM
		IF NO:LOCAL == MASTER
			IF LOCAL == PLAYER
				PRINTBUTTON "[★]", LOCAL + 100000
			ELSE
				PRINTBUTTON "[  ]", LOCAL + 100000
			ENDIF
			PRINTFORMD  %@"Body {LOCAL:1}", 9, RIGHT%
			PRINTFORMD  (STA: {BASE:LOCAL:体力, DIGITS, RIGHT} ENE: {BASE:LOCAL:気力, DIGITS, RIGHT}
			IF HAS_PENIS(LOCAL)
				PRINTFORMD  VIG: {BASE:LOCAL:精力, DIGITS, RIGHT}) CUM:
				IF BASE:LOCAL:射精 < MAXBASE:LOCAL:射精					
					PRINTFORMD {BASE:LOCAL:射精, 4, RIGHT}/{MAXBASE:LOCAL:射精, 4, RIGHT}
				ELSE
					SETCOLOR C_RED
					PRINTFORM !IMMINENT!
					RESETCOLOR
				ENDIF
			ENDIF
			PRINTL
			LOCAL:1++
		ENDIF
	NEXT
ENDIF
