; Modular ERB: Addition/Character-related/Add_DAILY_EV7.ERB
;DAILY_EV7 for Yuugi's dialogue special
;changes: disable yuugi if she's preggo, or disabled; add dialogue lines

@DAILY_EV7_EDIT
#DIM 人数
#DIM YUGI
VARSET LOCAL
YUGI = !RAND:4
SIF (TALENT:[[勇儀]]:妊娠 + TALENT:[[勇儀]]:育児中) || CFLAG:[[勇儀]]:出禁 || !CFLAG:[[勇儀]]:面識
	YUGI = 0
IF YUGI
	LOCALS '= @"유우기와 다른 이들"
ELSE
	LOCALS '= @"오니"
ENDIF
人数 = 1 + RAND:5
PRINTFORML 잠자리에 들려던 순간 \@ 人数 == 1 ? a # %NUM_COUNT(人数)% \@ 취한 오니가 들이닥치다%COND_STR("s", 人数 == 1)% 비틀거리며 들어온다!
IF YUGI
	PRINTFORML 유우기 또한 온다...
	CALL SPTALK, [[勇儀]], "笑顔", 0, @"「어이, 무슨 일이야 %MASTER_NAME([[勇儀]])%?! 우리가 들어갈게, 방해해서 미안!」", 1
ENDIF
PRINTFORMW ~인 것 같다 \@ 人数 == 1 && !YUGI ? 그녀는 여기에 머물며 계속 술을 마시려는 것 같다. # 그녀는 여기에 머물며 계속 마시려는 것 같다. \@ 의도하다%COND_STR("s", 人数 == 1 && !YUGI)% 여기 머물며 계속 마시려고 하는 것 같아...
PRINTFORML 
;他の選択肢は後で
;ASK_M("受け入れる","酒を渡して出て行ってもらう","ぶちのめす")
PRINTFORML %PARSE("You invite")% %LOCALS% 강요 하에
PRINTFORML \@ 人数 == 1 && !YUGI ? 그녀는 # 그들은 \@은 %COND_STR("s", 人数 == 1 && !YUGI)%의 제약 없이 술과 간식을 펼쳐놓고 시작한다.
SIF YUGI
	CALL SPTALK, [[勇儀]], "笑顔", 0, @"「에이~ 그렇게 까다롭게 굴지 마! 그냥 한 잔 하는 것뿐이야! / 지하에서 살 거면 적응해야지!」", 1
LOCAL:1 = 1
FOR LOCAL,0,人数
LOCAL:1 += RAND:3
NEXT
SIF YUGI
	LOCAL:1 += RAND:3 + RAND:3
FOR LOCAL,0,LOCAL:1
PRINTFORMW ...
PRINTFORMW ......
PRINTFORML %PARSE("You are")%마시도록 강요당했다.
SELECTCASE RAND:3
	CASE 0
		PRINTFORMW 의외로 평범한 술이다.
		LOCAL:2 = 200
	CASE 1
		PRINTFORMW 상당히 강한 사케다.
		LOCAL:2 = 400
	CASE 2
		PRINTFORMW 이건 정말 강하다!
		LOCAL:2 = 700
ENDSELECT
PRINTFORMW 
;added tolerance talent effect
SELECTCASE TALENT:MASTER:酒耐性
	CASE 3
		LOCAL:2 = MULTIPLY(LOCAL:2, 33)
	CASE 2
		LOCAL:2 = MULTIPLY(LOCAL:2, 50)
	CASE 1
		LOCAL:2 = MULTIPLY(LOCAL:2, 75)
	CASE -1
		LOCAL:2 = MULTIPLY(LOCAL:2, 150)
	CASE -2
		LOCAL:2 = MULTIPLY(LOCAL:2, 200)
ENDSELECT
IF TALENT:MASTER:酒耐性 > 1
	PRINTFORML 하지만 당신의 높아진 술내성이 일은 좀 도움이 된다...
ELSEIF TALENT:MASTER:酒耐性 < 0
	PRINTFORML 당신의 형편없는 술내성은 상황을 더 악화시키고 있을 뿐이다!
ENDIF
BASE:MASTER:酒気 += LOCAL:2
IF YUGI
	CALL SPTALK, [[勇儀]], "笑顔", 0, @"「%SPLIT_G("Drink, drink, drink:Send it, send it, send it:Down the hatch, let's gooooooooooo:Keep drinking till ya drop, hahaha:AHAHAHA")%!!!」", 1
	CALL CHANGE_CFLAG(2,[[勇儀]],3)
	CALL CHANGE_CFLAG(4,[[勇儀]],1)
ENDIF
IF BASE:MASTER:酒気 > MAXBASE:MASTER:酒気
	PRINTFORML 「쿠파아아!」
	PRINTFORML %PARSE("You breathe",1)%나가라!
	YOGORE:(CFLAG:MASTER:初期位置) += 1500
	BASE:MASTER:気力 -= 500
	MAXBASE:MASTER:酒気 += 3
	PRINTFORMW \@ YUGI ? %LOCALS% # 도깨비 \@이 %COND_STR("s", 人数 == 1 && !YUGI)% 제어 불가능하게 웃는다.
	IF BASE:MASTER:気力 < 0
		PRINTFORMW %PARSE("You collapse")%!
		IF YUGI
			CALL SPTALK, [[勇儀]], "笑顔", 0, @"「하하하, 너한테는 너무 강했지, 안 그래 %MASTER_NAME([[勇儀]])%?/ 아뿔싸, %HE_SHE(MASTER)%가 완전히 바닥났어! 뭐 어때, 누구나 그럴 수 있는 거지! 계속 힘내자, 다들!」", 1
			WAIT
		ENDIF
		BASE:MASTER:気力 -= 1000
		LOCAL:3 ++
		BREAK
	ELSE
		BASE:MASTER:酒気 /= 2
	ENDIF
ELSEIF BASE:MASTER:酒気 > MAXBASE:MASTER:酒気 * 3 / 4
	PRINTFORMW %PARSE("You start")%몸이 좀 안 좋은 것 같다...
	IF YUGI
		CALL SPTALK, [[勇儀]], "通常", 0, @"「이봐 이봐, 아직 토하지 마! / 이게 끝나기 전에 할 일이 더 있어! / 기운 내!」", 1
		WAIT
	ENDIF
ENDIF
NEXT
IF !LOCAL:3
	PRINTFORML %PARSE("You manage")%술의 괴롭힘을 견디기 위해서!
	IF YUGI
		CALL SPTALK, [[勇儀]], "笑顔", 0, @"「와, 해냈어 %MASTER_NAME([[勇儀]])%님! 감명받았어! 인간이 기절하지 않고 이만큼을 마실 줄이야, 정말 대단해!」", 1
		WAIT
		CALL CHANGE_CFLAG(2,[[勇儀]],150)
		CALL CHANGE_CFLAG(4,[[勇儀]],100)
	ENDIF
	MAXBASE:MASTER:酒気 += 20
ENDIF
CFLAG:MASTER:徹夜 = 1
YOGORE:(CFLAG:MASTER:初期位置) += 1000
MAXBASE:MASTER:酒気 = LIMIT(MAXBASE:MASTER:酒気,1500,3000)
PRINTFORML 동이 트면 %LOCALS% 떠난다%COND_STR("s", 人数 == 1 && !YUGI)%.
PRINTFORML \@ 人数 == 1 && !YUGI ? 그녀는 # 그들은 \@ 너에게 빈 병들로 가득 찬 컬렉션을 남긴다%COND_STR(@" 그리고 토사물 냄새", LOCAL:3)%.
SIF YUGI
	CALL SPTALK, [[勇儀]], "通常", 0, @"「음, 슬슬 가야겠어. 나중에 봐!」", 1
PRINTW 
RETURN 1
