; Modular ERB: Addition/Character-related/Add_COMF620 鈴奈庵.ERB
;貸本屋

@COM620_TR
#DIM CHARISMA
#DIM ItemId
#DIM nResult
#DIM DYNAMIC nTimeSpent
#DIM DYNAMIC nDouble
#DIM nCost = 3000, 10
gLineCount = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - gLineCount > 0
	CLEARLINE LINECOUNT - gLineCount
PRINTFORML 가용 \@ CHARISMA ? 카리스마 : CM%DIGIT_GROUP(MONEY:2)% # 돈 : %金額表示(MONEY)% \@
IF HostileAffinity(MASTER,70) >= 200 && GET_MAPID(CFLAG:MASTER:300) == 2
	LOCALS '= @"「제 가게를 나가주세요.」/「저희는 배회자, 약탈자, 요괴 또는 저희 마을에 적대적인 모든 이에게 서비스를 거부할 권리를 보유합니다.」"
	CALL COM620_SUZUSPEAK(LOCALS)
	RETURN 0
ENDIF
IF MONEY < nCost:0 && MONEY:1 < nCost:1
	LOCALS '= @"「안녕하세요, 스즈나안에 오신 것을 환영합니다!」/「빌리는 비용은\@ CHARISMA ? , 음... {nCost:1} 카리스마입니다! # %" "%%金額表示(nCost:0)%. \@」/「돈이 없는 것 같네요... 아쉽군요.」"
	CALL COM620_SUZUSPEAK(LOCALS)
	RETURN 0
ENDIF
IF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置 && ABL:[[小鈴]]:親密 >= 5
	LOCALS '= @"「오, 안녕, %CALLNAME:MASTER%! 여기 와줘서 언제나 기쁘네.」/「원하는 책을 골라줘, 내가 꼭 가져다 줄게.」"
	CALL COM620_SUZUSPEAK(LOCALS, "smile")
	LOCALS '= @"「언제나처럼 대여 비용은 \@ CHARISMA ? 음... {nCost:1} 카리스마! # 「%" "%%金額表示(nCost:0)%」이다. \@」"
	CALL COM620_SUZUSPEAK(LOCALS)
ELSE
	LOCALS '= @"「안녕하세요, 스즈나안에 오신 것을 환영합니다!」/「차용 비용은\@ CHARISMA ? , 음... {nCost:1} 카리스마입니다! # %" "%%金額表示(nCost:0)%. \@」"
	CALL COM620_SUZUSPEAK(LOCALS)
ENDIF
;make a list
FOR LOCAL, 1, BookTitles + 1
ItemId = LOCAL + 100
SIF ItemId == GETNUM(ITEM,  "妖魔本") && (CFLAG:[[小鈴]]:現在位置 != CFLAG:PLAYER:現在位置 || ABL:[[小鈴]]:親密 < 5) ;don't show demon book if not friends with suzu
	CONTINUE
IF ITEM:ItemId
	SETCOLOR C_YELLOW
ELSEIF GETBIT (FLAG:1011,LOCAL)
	SETCOLOR C_GRAY
ENDIF
PRINTFORM [{LOCAL, 3}] %ITEMNAME_TR(ItemId)%
IF ITEM:ItemId
	PRINTFORML %PARSE("You are")%은 이미 그것을 빌리고 있다.
ELSEIF GETBIT (FLAG:1011,LOCAL)
	PRINTL (임대됨)
ELSE
	PRINTL 　
ENDIF
RESETCOLOR
NEXT
PRINTL
SIF FLAG:貸本返却期限 > 0
	PRINTFORML [ 97] 모든 책을 반납한다.
SIF !ITEM:GETNUM(ITEM,  "妖魔本") && INRANGE(FLAG:貸本返却期限, 1, 8) ;if not demon book, and have a borrowed book on a non-extended period
	PRINTFORML [ 98] 기간을 익스텐드한다.
PRINTFORML [ 99] 책에 대하여
IF !CHARISMA
	PRINTFORML [100] 매력으로 지불한다
ELSE
	PRINTFORML [100] 돈으로 지불한다
ENDIF
DRAWLINE
PRINTL [  0] 나가기
INPUT
IF RESULT == 0
	LOCALS '= "「또 오세요!」"
	CALL COM620_SUZUSPEAK(LOCALS, "smile")
	TIME += nTimeSpent*30
	RETURN !nTimeSpent ? -1 # 1
ENDIF
nResult = RESULT
;check if trying to choose duplicate or many books at once
LOCAL:1 = 0
IF INRANGE(RESULT, 1, BookTitles)
	FOR LOCAL, 1, BookTitles + 1
	ItemId = LOCAL + 100
	IF (nResult+100) == ItemId && ITEM:ItemId
		;demon book unique line
		IF (nResult+100) == GETNUM(ITEM,  "妖魔本")
			LOCALS '= "「벌써 반납하시려고요?」/"
			LOCALS += "「악마의 책을 지니고 있으면 부담을 견디기 힘들 때도 있죠... 이해해요.」/"
			LOCALS += "「이리 주세요. 제가 잘 보관할게요.」/「반납한 뒤에는 언제나처럼 다른 책을 빌릴 수 있어요!」"
		ELSE
			LOCALS '= "「죄송하지만, 그 책은 이미 빌리고 계세요...」/"
			LOCALS += "「아, 그러니까 반납하시겠다는 뜻인가요?」/"
			LOCALS += "「그렇다면 지금 빌린 다른 책도 전부 반납하셔야 해요.」/"
			LOCALS += "「그래도 괜찮으세요?」"
		ENDIF
		CALL COM620_SUZUSPEAK(LOCALS)
		CALL ASK_YN
		IF !RESULT
			LOCALS '= @"「훌륭해! \@ BORROWED_BOOKS() > 1 ? 그들은 있는 것 같아 # 완벽한 상태인 것 같아.」 \@"
			LOCALS +=  "「이용해 주셔서 감사합니다! 곧바로 다른 책을 빌리셔도 돼요.」/"
			LOCALS +=  "「원하신다면 방금 반납한 책을 다시 빌리셔도 되고요!」"
			CALL COM620_SUZUSPEAK(LOCALS, "smile")
			WAIT
			;reset every book
			FOR LOCAL, 1,BookTitles + 1
			SIF ITEM:(100 + LOCAL)
				CLEARBIT FLAG:1011, LOCAL
			ITEM:(100 + LOCAL) = 0
			NEXT
			FLAG:貸本返却期限 = 0
		ELSE
			LOCALS '= "「아, 아니라고요? 어, 어어...」"
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
		ENDIF
		;go back to start once you return books (or don't)
		LOCAL:1 = 1
		BREAK
	ENDIF
	NEXT
	SIF LOCAL:1
		CONTINUE
	LOCAL:1 = 0
	FOR LOCAL, 1, BookTitles + 1
	ItemId = LOCAL + 100
	IF ITEM:ItemId
		IF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置 && ABL:[[小鈴]]:親密 >= 5
			;demon book unique line
			IF ITEM:GETNUM(ITEM,  "妖魔本")
				LOCALS '= "「죄송하지만 지금 악마의 책을 가지고 계셔서...」/"
				LOCALS += "「다른 책을 빌리기 전에 그 책부터 반드시 반납하셔야 해요.」"
				CALL COM620_SUZUSPEAK(LOCALS)
				CALL ASK_YN("그것을 돌려준다", "아직 그걸 돌려주지 마")
				IF !RESULT
					LOCALS '= "「좋아요, 이제 됐네요... 흠흠! 너무 오래 가지고 있으면 위험한 책이라, 돌려주셔서 다행이에요.」/"
					LOCALS += "「어떠셨어요? 도움이 됐으면 좋겠네요!」/"
					LOCALS += "「그럼 다음 책은...」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					;clear every book just in case
					FOR LOCAL, 1,BookTitles + 1
					SIF ITEM:(100 + LOCAL)
						CLEARBIT FLAG:1011, LOCAL
					ITEM:(100 + LOCAL) = 0
					NEXT
					FLAG:貸本返却期限 = 0
					IF GETBIT (FLAG:1011,nResult)
						GOTO RENTED
					ELSE
						GOTO BORROW
					ENDIF
				ELSE
					LOCALS '= "「네? 하지만...」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					LOCAL:1 = 1
					BREAK
				ENDIF
			ENDIF
			;trying to take many books at once
			LOCALS '= "「저기... 원래 한 번에 두 권 이상은 빌려 드리지 않지만, 당신이라면 믿을 수 있어요!」/"
			CALL COM620_SUZUSPEAK(LOCALS, "smile")
			WAIT
			SELECTCASE ABL:[[小鈴]]:親密
				CASE IS >= 10
					LOCALS '= "「모두 합해서 세 권까지 괜찮을 것 같아요... 책이 세 권이나! 생각만 해도 신나지 않나요?!」/"
				CASE IS >= 5
					LOCALS '= "「그러니 딱 한 권만 더 빌려 드릴게요... 합해서 두 권이에요! 하지만 다른 사람에게는 비밀이에요. 약속하는 거예요!」/"
			ENDSELECT
			IF BORROWED_BOOKS() >= 2 + (ABL:[[小鈴]]:親密 >= 10)
				LOCALS += "「그런데 말씀드리고 보니 이미 그만큼 빌리고 계시네요... 죄송해요!」"
				CALL COM620_SUZUSPEAK(LOCALS)
				WAIT
				LOCAL:1 = 1
				BREAK
			ENDIF
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
			LOCALS '= "「그리고 모든 책은 반납일이 같고, 대여료는 각각 따로 내셔야 해요.」/"
			LOCALS += "「같은 책을 두 권 빌릴 수도 없어요! 그래 봤자 별 도움도 안 되잖아요, 그렇죠?」/"
			LOCALS += "「괜찮으시겠어요?」"
			CALL COM620_SUZUSPEAK(LOCALS)
			CALL ASK_YN
			IF !RESULT
				IF GETBIT (FLAG:1011,nResult)
					GOTO RENTED
				ELSE
					GOTO BORROW
				ENDIF
			ENDIF
		ELSE
			LOCALS '= "「죄송하지만 책을 여러 권 한꺼번에 빌리실 수는 없어요...」"
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
			SIF ABL:[[小鈴]]:親密 >= 5
				PRINTW 아아, 코스즈가 여기 있었으면 좋을 텐데...
		ENDIF
		LOCAL:1 = 1
		BREAK
	ENDIF
	NEXT
	SIF LOCAL:1
		CONTINUE
ENDIF
;check selection
SELECTCASE RESULT
	CASE 100
		IF !CHARISMA
			LOCALS '=  "「카리스마로 지불한다고요????」/"
			LOCALS += @"「음... 그럼, {nCost:1} 카리스마...? 충분할 거라 생각해...」"
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
			IF MONEY:2 < nCost:1
				PRINTFORML 카리스마가 충분하지 않다!
				LOCALS '= "「아쉽네요...」"
				CALL COM620_SUZUSPEAK(LOCALS)
				WAIT
				CONTINUE
			ENDIF
		ELSE
			LOCALS '= "「아, 그러면 돈으로 내실 건가요?」"
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
		ENDIF
		CHARISMA = !CHARISMA
	CASE 99 ;explanation
		LOCALS '= "「빌린 책은 관련 행동을 할 때 자동으로 사용돼요.」/"
		LOCALS += "「내용을 더 잘 이해하는 데 도움이 될 거예요. 게다가 읽는 재미도 아주 좋고요!」/"
		LOCALS += "「한 번의 효과는 작지만, 쌓이다 보면 해결하려는 문제에 제법 든든한 보탬이 돼요.」"
		SIF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置
			LOCALS += "/「적어도 저는 그렇더라고요, 에헤헤～」"
		CALL COM620_SUZUSPEAK(LOCALS, "smile")
		WAIT
	CASE 98 ;extend
		SIF ITEM:GETNUM(ITEM,  "妖魔本") || FLAG:貸本返却期限 == 0 || FLAG:貸本返却期限 > 8
			CONTINUE
		CALL COM620_BOOKEXTEND(nCost, CHARISMA)
	CASE 97 ;return
		SIF !FLAG:貸本返却期限 ;bug failsafe, allow if it goes below 0 for whatever reason
			CONTINUE
		PRINTFORML 확인하시겠습니까?
		CALL ASK_YN
		IF !RESULT
			LOCALS '= "「어머, 책을 반납하시려고요? 아직 더 이용할 시간이 남았는데...」/"
			LOCALS += "「뭐, 알겠어요. 어디 한번 볼게요...」/"
			LOCALS += "「으음... 상태는 괜찮네요. 받아서 정리하고... 다 됐어요!」/"
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
			LOCALS '= "「이용해 주셔서 정말 감사합니다!」"
			CALL COM620_SUZUSPEAK(LOCALS, "smile")
			PRINTFORMW {BORROWED_BOOKS()} 권의 책을 반납했다.
			FOR LOCAL, 1,BookTitles + 1
			SIF ITEM:(100 + LOCAL)
				CLEARBIT FLAG:1011, LOCAL
			ITEM:(100 + LOCAL) = 0
			NEXT
			FLAG:貸本返却期限 = 0
		ENDIF
	CASEELSE
		SIF !INRANGE(nResult, 1, BookTitles)
			CONTINUE
		SIF nResult == (GETNUM(ITEM,  "妖魔本")-100) && (CFLAG:[[小鈴]]:現在位置 != CFLAG:PLAYER:現在位置 || ABL:[[小鈴]]:親密 < 5)
			CONTINUE
		IF GETBIT (FLAG:1011,RESULT)
			$RENTED
			LOCALS '= "「죄송하지만 지금은 다른 분이 빌려 가셨어요.」"
			CALL COM620_SUZUSPEAK(LOCALS)
			WAIT
			IF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置
				IF ABL:[[小鈴]]:親密 < 5
					LOCALS '= "「...하지만 정상 대여료의 세 배를 내신다면 제 개인 소장본을 빌려 드릴 수 있어요.」/"
					LOCALS += "「관심 있으신가요?」"
					CALL COM620_SUZUSPEAK(LOCALS)
					nDouble = 2
				ELSE
					LOCALS '= @"「아, 하지만 %CALLNAME:MASTER%…… 당신이 물어올 줄 알았기에 특별히 복사본을 남겨두었답니다.」"
					LOCALS +=  "「그리고, 저기, 추가 요금은 안 내셔도 돼요. 괜찮으시다면 기꺼이 제 책을 빌려 드릴게요.」"
					CALL COM620_SUZUSPEAK(LOCALS, "smile")
				ENDIF
				CALL ASK_YN
				IF RESULT
					IF ABL:[[小鈴]]:親密 < 5
						LOCALS '= "「좋아요.」/"
					ELSE
						LOCALS '= "「아... 알겠어요.」/"
					ENDIF
					LOCALS += "「내일 다시 와 주세요. 그때는 책이 돌아와 있을지도 몰라요!」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					CONTINUE
				ELSE
					GOTO BORROW
				ENDIF
			ELSE
				PRINTW 아아, 코스즈가 여기 있었으면 좋을 텐데...
			ENDIF
		ELSE
			$BORROW
			IF nResult == 6 ;picture story show, unused currently
				LOCALS '= "「아! 미리 알아 두셔야 할 게 있어요...」/"
				LOCALS += "「예쁘기는 하지만... 지금은 이 어린아이에게 쓸모가 없어요. 아직은요.」/"
				LOCALS += "「그래도 원하시나요?」"
				CALL COM620_SUZUSPEAK(LOCALS)
				CALL ASK_YN
				SIF RESULT
					CONTINUE
			ENDIF
			;add demon book - increases given sexual experience
			IF nResult == (GETNUM(ITEM,  "妖魔本")-100)
				LOCALS '= @"「오, 이것 말인가? 당신은 안목이 깊군요, %CALLNAME:MASTER%...」/"
				LOCALS +=  "「이 희귀한 책은 악마의 책이라고 해요. 같은 종류가 여럿 있지만, 이건 그중에서도 아주 특이한 물건이에요.」/"
				LOCALS +=  "「듣기로는 마주치는 여자마다, 그... 유혹하는 일을 평생의 과업으로 삼은 유명한 요괴가 썼대요.」/"
				LOCALS +=  "「그러니 그 방면의 비밀이 잔뜩 적혀 있을 거예요... 하지만 저는 읽지 못했어요.」"
				CALL COM620_SUZUSPEAK(LOCALS)
				WAIT
				LOCALS '= "「읽고 싶었던 건 아니에요! 그저... 비슷한 성향을 가진 사람만 이 책을 열 수 있는 모양이라서요.」"
				CALL COM620_SUZUSPEAK(LOCALS, "blush")
				WAIT
				LOCALS '= "「무슨 뜻을 담아 하는 말은 아니지만, 쓸모가 있다면 얼마든지 가져가셔도 돼요...」/"
				LOCALS += "「아, 죄송하지만 이 책은 추가 요금을 받아야 해요. 이해해 주실 거라 믿어요. 다른 조건도 똑같이 적용되고요!」/"
				LOCALS += "「정확히 얼마냐고요? 저기... 화내지 마세요. 평소 요금의 열 배예요. 대여 기간 연장도 안 되고요.」/"
				LOCALS += "「즉, 지금 가지고 계신 다른 책도 전부 반납하셔야 하고,/　악마의 책을 돌려주기 전까지는 추가로 빌릴 수 없어요.」/"
				LOCALS += "「네, 말도 안 되는 조건인 건 알아요. 하지만, 그게.../　원래는 이 책을 빌려 드리는 것 자체가 안 된다고요! 그러니까... 빌리든 말든 결정하세요!」"
				CALL COM620_SUZUSPEAK(LOCALS)
				CALL ASK_YN
				IF !RESULT
					LOCALS '= "「좋아요... 어디에 뒀더라. 아! 여기 있네요...」/「어머, 손에 닿자마자 책이 열렸어요...?」/「잠깐 볼게요. 이상하네, 저는 아직도 글자를 읽을 수 없어요...」/「네? 당신은 읽을 수 있다고요?! 게다가 효력을 내려면 그... 「행위」 중이어야 한다고요?! 그, 그, 그건...!」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					LOCALS '= "「아와와, 저기, 그러니까...! 그, 그럼 맡길게요!!!」"
					CALL COM620_SUZUSPEAK(LOCALS, "blush")
					WAIT
					nDouble = 9
				ELSE
					LOCALS '= "「그럴 만도 하죠.」/「괜히 기대하게 만들어서 죄송해요...」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					CONTINUE
				ENDIF
			ENDIF
			;price check (can be more than original price)
			IF !CHARISMA
				IF MONEY < nCost:0 + nCost:0*nDouble
					LOCALS '= "「죄송하지만... 돈이 부족하신 것 같아요.」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					CONTINUE
				ENDIF
				;MONEY -= nCost:0 + nCost:0*nDouble
				CALL PAY_MONEY_YEN(nCost:0 + nCost:0*nDouble, 1)
			ELSE
				IF MONEY:2 < nCost:1 + nCost:1*nDouble
					LOCALS '= "「죄송하지만... 카리스마가 부족하신 것 같아요.」"
					CALL COM620_SUZUSPEAK(LOCALS)
					WAIT
					CONTINUE
				ENDIF
				;MONEY:2 -= nCost:1 + nCost:1*nDouble
				CALL PAY_MONEY_CM(nCost:1 + nCost:1*nDouble, 1)
			ENDIF
			SETBIT FLAG:1011, nResult
			ITEM:(100 + nResult) = 1
			SIF FLAG:貸本返却期限 < 8
				FLAG:貸本返却期限 = 8
			TFLAG:193 = 1
			nTimeSpent = 1
			;PRINTFORML Paid \@ CHARISMA ? CM{nCost:1 + nCost:1*nDouble} # %金額表示(nCost:0 + nCost:0*nDouble)% \@.
			nDouble = 0
			PRINTFORML 빌린 것은 %ITEMNAME_TR(100 + nResult)%이다.
			LOCAL = BORROWED_BOOKS()
			SIF nResult != (GETNUM(ITEM,  "妖魔本")-100) && LOCAL >= 2
				PRINTFORML 당신은 총 {BORROWED_BOOKS()} 권의 책을 빌렸다.
			LOCALS '= "「정말 감사합니다!」/「대여 기간은 일주일이에요.」"
			CALL COM620_SUZUSPEAK(LOCALS, "smile")
			WAIT
			IF nResult == (GETNUM(ITEM,  "妖魔本")-100)
				SIF LOCAL - (ITEM:GETNUM(ITEM,  "妖魔本") > 0)
					PRINTFORMW 다른 모든 책을 반환했다.
				FOR LOCAL, 1,BookTitles + 1
				SIF LOCAL == (GETNUM(ITEM,  "妖魔本")-100) ;skip for demon book
					CONTINUE
				SIF ITEM:(100 + LOCAL)
					CLEARBIT FLAG:1011, LOCAL
				ITEM:(100 + LOCAL) = 0
				NEXT
				FLAG:貸本返却期限 = 8
				CONTINUE
			ENDIF
			SIF FLAG:貸本返却期限 >= 15 ;already extended period
				CONTINUE
			CALL ASK_YN("기간을 익스텐드하라", "진행한다")
			SIF !RESULT
				CALL COM620_BOOKEXTEND(nCost, CHARISMA)
			;since you can borrow more than one book in one sitting, we'll pass bits through a flag to check at the dialogue (otherwise we're limited to by item check which is fine, but it will also comment on stuff you already had earlier)
			SETBIT TFLAG:193, nResult
		ENDIF
ENDSELECT
LOOP 1

@COM620_BOOKEXTEND(nCost, CHARISMA)
#DIM REF nCost, 0
#DIM CHARISMA
IF INRANGE(FLAG:貸本返却期限, 1, 7) ;have to pay if not at the same day
	LOCALS '= "「아, 기간을 연장하시려고요? 가능하기는 하지만...」/"
	LOCALS += "「다음 일주일치 요금도 추가로 내셔야 해요. 그래도 괜찮으신가요?」"
	IF ABL:[[小鈴]]:親密 >= 5 && CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置
		LOCALS += "/「죄송해요. 평소라면 추가 요금 없이 그냥, 그... 연장해 드렸겠지만 저를 속이려 한 사람이 몇 명 있었거든요.」/"
		LOCALS += "「제가 너무 잘 봐주는 바람에 장사가 어려워졌다고 부모님께 호되게 혼났어요.」"
	ENDIF
ELSE
	IF ABL:[[小鈴]]:親密 < 5 || CFLAG:[[小鈴]]:現在位置 != CFLAG:PLAYER:現在位置
		LOCALS '= "「아, 기간을 연장하시려고요? 가능하기는 하지만...」/"
		LOCALS += "「다음 일주일치 요금도 추가로 내셔야 해요. 그래도 괜찮으신가요?」"
	ELSE
		LOCALS '= @"「아, 기간을 연다는 거야? 물론이지! 내 소박한 책들에 관심 가져줘서 정말 기쁘단다, %CALLNAME:MASTER%...」"
		LOCALS +=  "「추가 요금이요? 아, 아니요, 괜찮아요... 대신 기한 안에 꼭 반납해 주세요. 알겠죠?」"
	ENDIF
ENDIF
CALL COM620_SUZUSPEAK(LOCALS)
CALL ASK_YN
IF !RESULT
	IF INRANGE(FLAG:貸本返却期限, 1, 7) || ABL:[[小鈴]]:親密 < 5 || CFLAG:[[小鈴]]:現在位置 != CFLAG:PLAYER:現在位置
		IF !CHARISMA
			IF MONEY < nCost:0
				LOCALS '= "「죄송하지만... 돈이 부족하신 것 같아요.」"
				CALL COM620_SUZUSPEAK(LOCALS)
				WAIT
				RETURN
			ENDIF
			;MONEY -= nCost:0
			CALL PAY_MONEY_YEN(nCost:0, 1)
		ELSE
			IF MONEY:2 < nCost:1
				LOCALS '= "「죄송하지만... 카리스마가 부족하신 것 같아요.」"
				CALL COM620_SUZUSPEAK(LOCALS)
				WAIT
				RETURN
			ENDIF
			;MONEY:2 -= nCost:1
			CALL PAY_MONEY_CM(nCost:1, 1)
		ENDIF
		;PRINTFORMW Paid \@ CHARISMA ? CM{nCost:1} # %金額表示(nCost:0)% \@.
	ENDIF
	LOCALS '= "「정말 감사합니다! 요청하신 대로 대여 기간을 두 배로 늘렸어요.」/"
	LOCALS += "「즐겁게 읽으세요!」"
	CALL COM620_SUZUSPEAK(LOCALS, "smile")
	WAIT
	FLAG:貸本返却期限 = 15
ENDIF

@COM620_SUZUSPEAK(ARGS, ARGS:1 = "通常")
SIF ARGS:1 == "smile"
	ARGS:1 '= "笑顔"
SIF ARGS:1 == "blush"
	ARGS:1 '= "発情"
IF CFLAG:[[小鈴]]:現在位置 == CFLAG:PLAYER:現在位置
	CALL SPTALK, [[小鈴]], ARGS:1, 0, ARGS, 1
ELSE
	CALL SPTALK, 0, ARGS:1, 12, ARGS, 1
ENDIF
RESETCOLOR

@BORROWED_BOOKS()
#FUNCTION
LOCAL:2 = 0
FOR LOCAL, 1, BookTitles + 1
LOCAL:1 = LOCAL + 100
SIF ITEM:(LOCAL:1)
	LOCAL:2 ++
NEXT
RESULT = LOCAL:2
RETURNF LOCAL:2
