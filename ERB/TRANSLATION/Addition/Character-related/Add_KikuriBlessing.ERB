; Modular ERB: Addition/Character-related/Add_KikuriBlessing.ERB

@UNIQUE_COM_キクリの祝福
#DIM BlessingType
#DIM TMP
#DIM BlessingCount
CALL SET_KOJO_COLOR(152)
IF MARK:152:反発刻印
	PRINTFORMDL 키쿠리가 당신을 노려본다.
	PRINTFORMW 「말도 안 돼! 난 널 축복해주지 않아, 이 자식아!」
	RETURN -1
ENDIF
PRINTFORML 「축복이라니, 말씀이신가요? 물론이죠!」
PRINTFORMW 「So how big of a blessing would you like?」
$PICK_A_BLESSING
CALL ASK_M("작은 축복(\\10000)", MONEY >= 10000, "정규 축복(\\60000)", MONEY >= 60000, "디럭스 축복(\\250000)", MONEY >= 250000, "더 많은 정보", 1, "현재 축복", 1, "상관없어", 1)
SELECTCASE RESULT
	CASE 0
		BlessingType = 1
		PRINTFORML 「작은 것일 뿐이야, 응? 좋아.」
		PRINTFORMDW 키쿠리는 약간 실망한 듯 보인다.
		CALL KIKURI_DO_BLESSING(BlessingType)
	CASE 1
		BlessingType = 2
		PRINTFORMW 「레귤러? 좋은 선택이야! 내 고객들 대부분이 고르는 게 그거야.」
		CALL KIKURI_DO_BLESSING(BlessingType)
	CASE 2
		BlessingType = 3
		PRINTFORMDW 키쿠리의 눈이 커졌다.
		PRINTFORML 「우와... 이걸 사려는 사람이 많지 않네.」
		PRINTFORMW 「좋아, 내가 뭘 할 수 있는지 보여줄 시간이야!」
		CALL KIKURI_DO_BLESSING(BlessingType)
	CASE 3
		PRINTFORML 「그러니까 나는 결혼의 여신인 거지?」
		PRINTFORMW 「그건 내가 사람들의 관계를 축복해 줄 수 있다는 뜻이야. 너 같은 사람들이 말이야!」
		PRINTFORMDW 키쿠리는 너에게 미소를 지었다.
		PRINTFORML 「작동 방식은 이렇단다. 합리적인 비용을 나에게 지불하면, 내가 네가 선택한 사람과의 관계를 일정 시간 동안 강화해 주는 거야.」
		PRINTFORML 「축복에는 세 가지 등급이 있어. 소규모 축복은 \\10,000이고 하루 동안 지속돼.」
		PRINTFORMW 「일반 축복은 \\60,000이며 일주일 동안 지속되고. 그리고 디럭스 축복은 \\250,000으로 한 달 내내 지속된단다!」
		PRINTFORMW 「...야, 그런 표정 짓지 마! 옷을 맞추려면 주문 제작해야 하는데, 만만치 않거든!」
		GOTO PICK_A_BLESSING
	CASE 4
		PRINTFORML 「좋아, 내가 지금 당신의 관계에 축복을 내리고 있는 상대가 누구인지 알려줄게...」
		PRINTFORMDL 
		BlessingCount = 0
		FOR TMP,1,CHARANUM
		IF CFLAG:TMP:祝福の持続時間
			PRINTFORMD %CALLNAME:TMP%: {CFLAG:TMP:祝福の持続時間} \@ CFLAG:TMP:祝福の持続時間 > 1 ? 일 # 날 이내에 만료한다. \@
			IF CFLAG:TMP:触媒を与えた
				PRINTFORMDL  (강력한 축복)
			ELSE
				PRINTFORMDL 
			ENDIF
			BlessingCount ++
		ENDIF
		NEXT
		IF !BlessingCount
			PRINTFORML 「...사실 아무도 아니야.」
			PRINTFORMDL 키쿠리는 당신을 기대하며 바라본다.
			PRINTFORMW 「그럼 나한테 약간의 돈을 주면 그걸 고칠 수 있을까?」
		ELSE
			PRINTFORMDW 
		ENDIF
		GOTO PICK_A_BLESSING
	CASE 4
		PRINTFORML 「아아...」
		PRINTFORMDL 키쿠리가 입술을 삐죽거린다.
		PRINTFORMW 「언제 마음이 바뀌어도 돌아와 줘, 알겠지?」
		RESETCOLOR
		RETURN 1
ENDSELECT

@KIKURI_CALCULATE_TARGETS
#DIM BlessingTarget
#DIM TMP
#DIM DYNAMIC TargetCount
FOR TMP,1,CHARANUM
IF CFLAG:TMP:面識 && !CFLAG:TMP:祝福の持続時間 == TMP
	TargetCount ++
	BlessingTarget = TMP
ENDIF
NEXT
RETURN TargetCount, BlessingTarget, TMP

@KIKURI_PANTIES_CHECK(BlessingTarget)
#DIM BlessingTarget
#DIM TotalCount
#DIM UniqueCount
#DIM Dupes
VARSET LOCAL
CALL CHECK_COLLECTION(BlessingTarget)
TotalCount = RESULT:0
UniqueCount = RESULT:1
Dupes = TotalCount - UniqueCount
IF !UniqueCount
	PRINTFORMDL 불행하게도, 당신이 촉매로 사용할 만한 것이 없다.
	RETURN -1
ENDIF
PRINTFORML %CALLNAME:BlessingTarget%의 팬티 현재 수량: 총 {TotalCount,3} 개 고유한 것들: {UniqueCount,3} 개 중복된 것들: {Dupes}
SIF BlessingTarget == 152 && !IS_FALLEN(152)
	PRINTFORML 키쿠리에게 네가 훔친 팬티를 건네는 게 좋은 생각이 아닐 수도 있다는 느낌이 들기 때문이다...
LOCALS = 중복 제공하기
SIF Dupes < 1
	LOCALS = 중복 없는 팬티를 제공하라
CALL ASK_M("취소",1,@"%LOCALS%",TotalCount >= 1)
IF RESULT == 1
	CFLAG:BlessingTarget:(パンツ管理 + LOCAL) -= 1
	PRINTFORMDW 당신은 소유물에서 %CALLNAME:BlessingTarget%의 팬티 한 벌을 불러내 키쿠리에 %COND_STR(", making sure nobody else sees you do it", GET_TARGETNUM() > 1)% 건다.
	RETURN 1
ENDIF

@KIKURI_DO_BLESSING(BlessingType)
#DIM BlessingType
#DIM BlessingTarget
#DIM BlessingPrice
#DIM nLineCnt_Head
#DIM TMP
$BLESSING_SELECT
PRINTFORML 「어떤 사람과 관계를 더 돈다는 것인가?」
RESETCOLOR
DRAWLINE
nLineCnt_Head = LINECOUNT
REDRAW 0
FOR TMP,1,CHARANUM
SIF CFLAG:TMP:面識 && !CFLAG:TMP:祝福の持続時間
	PRINTFORMLC [{TMP, 3}] %CALLNAME:TMP%
NEXT
PRINTFORML
PRINTFORML [-1] 취소
INPUT
BlessingTarget = RESULT
CALL M_KOJO_COLOR_K152
$DO_BLESSING
IF BlessingTarget == -1
	$CANCEL
	PRINTFORMW 「마음 바꿨나 보네. 좋아...」
	RESETCOLOR
	RETURN -1
ELSEIF BlessingTarget < 0 || BlessingTarget >= CHARANUM
	PRINTFORMW 「어라... 누구지?」
	GOTO BLESSING_SELECT
ELSEIF BlessingTarget == 0
	PRINTFORMW 「자신과의 관계를 개선하고 싶다면, 나 말고 에린 씨가 필요해.」
ELSEIF !CFLAG:BlessingTarget:面識
	PRINTFORMW 「헤이, 네가 한 번도 본 적 없는 사람에게는 관계를 축복해 줄 수 없어!」
	GOTO BLESSING_SELECT
ELSEIF CFLAG:BlessingTarget:祝福の持続時間
	PRINTFORMW 「음... 이미 너의 그녀와의 관계에 축복을 걸고 있어.」
	GOTO BLESSING_SELECT
	GOTO BLESSING_SELECT
ELSEIF BlessingTarget == 152
	PRINTFORML 「M-M-M...」
	PRINTFORMW 「M-M-M-M-Me?!」
	PRINTFORMDW 키쿠리의 얼굴이 더 어두운 청동색으로 변한다. 만약 그녀가 인간이라면, 아마 진홍색이었을 것이다.
	PRINTFORMW 「저, 음... 그럴 수 있어요! 저희 관계를 축복해 줄게요. 잠시만 진정할 시간을 주세요.」
	PRINTFORML (믿을 수가 없어! 드디어 내가 결혼하게 된다니!)
	PRINTFORMW (콘짱에게 말하고 싶어 미치겠어!)
ELSEIF CFLAG:MASTER:現在位置 == CFLAG:BlessingTarget:現在位置
	PRINTFORML 「저기 저 사람이 바로 앞에 있는데, 정말 축복을 받고 싶어?」
	PRINTFORMW 「알겠어, 네가 그렇게 말한다면...」
ELSEIF BlessingTarget == 150
	PRINTFORML 「우와... 콘짱이 마음에 드는 거야?」
	PRINTFORMDW 키쿠리가 미소 짓는다.
	PRINTFORMW 「취향이 좋네! 그 점 때문에 반 할인을 해줄게.」
	BlessingPrice /= 2
ELSEIF BlessingTarget == 76
	PRINTFORML 「신(死神)을 노리다니, 흥미롭네?」
	PRINTFORMW 「그녀는 게으를지 몰라도, 당신을 보면 내 축복이 그녀의 심장을 밤낮없이 뛰게 할 테니까!」
ELSEIF BlessingTarget == 30
	PRINTFORML 「시키님을 좋아해?」
	PRINTFORMDW 키쿠리가 웃는다.
	PRINTFORML 「나는 그녀가 이미 결혼했다고 생각했어... 일과!」
	PRINTFORMW 「하지만 나에게는 문제가 되지 않아. 내가 너희 둘의 관계에 축복을 내리면, 그녀는 서명하는 모든 서류마다 수십 통의 연애편지를 쓸 테니까!」
ELSEIF BlessingTarget == 113
	PRINTFORML 「우와... 헤카티아님?!」
	PRINTFORMDW 키쿠리는 경외심 가득한 눈으로 당신을 바라본다.
	PRINTFORML 「지옥의 여신님의 마음을 얻으려고 시도하다니, 정말 자신감이 넘치는군요.」
	PRINTFORMW 「...제 사이즈로 티셔츠를 만들어달라고 부탁할 수 있나요? 항상 입어보고 싶었거든요...」
ELSEIF TALENT:BlessingTarget:恋人
	PRINTFORML 「오, 벌써 연인이 있는 거야?」
	PRINTFORML 「설마... 결혼할 계획이라니?!」
	PRINTFORMDW 키쿠리의 눈이 빛나며 흥분하여 주먹을 꽉 쥔다.
	PRINTFORML 「아, 내가 결혼식을 주관한 게 언제였는지 기억이 안 나네!」
	PRINTFORMW 「새 드레스를 만들어야겠어...」
	PRINTFORMDW 키쿠리는 잠시 동안 결혼식에 대해 계속 떠들다가 당신이 공손하게 기침을 한다.
	PRINTFORMDW 그녀는 말을 멈추고 살짝 홍당무처럼 빨개진다.
	PRINTFORML 「죄송해요, %CALLNAME:MASTER%-상. 그저... 저는 거의 제 일을 못 하는 결혼의 여신이니까요.」
	PRINTFORMW 「어쨌든, 추가 비용 없이 특별히 강력한 축복을 해줄게요!」
ELSEIF TALENT:BlessingTarget:恋慕
	PRINTFORML 「우와! 이 소녀는 당신을 연모하고 있군요!」
	PRINTFORMW 「혹시 여자들이 고백하는 걸 좋아하시는 %PRINT_MALE("guy", MASTER)% 같은 분이신가요? 헤헤, 귀엽네요...」
	PRINTFORMW 「좋아요! 두 분이 최고의 사랑스러운 데이트를 하게 해줄 축복을 만들어 줄 시간이에요!」
ELSEIF TALENT:BlessingTarget:思慕
	PRINTFORML 「이 소녀가 당신에게 감정을 느끼기 시작한 듯하군요.」
	PRINTFORMW 「걱정 마세요! 제 축복이 발동하면 그 감정들은 금세 본격적인 연모로 변할 거예요!」
ELSEIF TALENT:BlessingTarget:愛欲 || TALENT:BlessingTarget:セフレ == 1
	PRINTFORML 「너와 이 소녀는 그저 스윙일 뿐이다.」
	PRINTFORMDW 키쿠리는 조금 실망한 듯 보인다.
	PRINTFORML 「그럼 마음이 바뀌었단 말이냐?」
	PRINTFORMW 「걱정 마라. 나의 축복이 저 모든 욕망을 단번에 연모로 바꿔주마!」
ELSEIF ABL:BlessingTarget:親密 >= 5
	PRINTFORML 「너와 이 소녀는 지금 그저 친구일 뿐이야.」
	PRINTFORML 「더 바라는 것이 있는 거겠지, 응?」
	PRINTFORMW 「좋아 그럼, 가만히 있어 봐. 내가 마법을 부려 줄게!」
ELSE
	PRINTFORML 「너와 이 소녀는 서로 잘 모르는 것 같구나.」
	PRINTFORMW 「하지만 나의 축복이 그것을 고쳐줄 것이다!」
ENDIF
CALL ASK_M("나는 마음을 바꿨다", 1, @"%CALLNAME:BlessingTarget%와의 관계에 축복을 내린다.", 1)
IF RESULT
	PRINTFORML 「좋아, 촉매가 있다면 더욱 강력해질 거야. 소녀의 머리카락 한 가닥이나 그녀의 그림 같은 것들... 그런 거 말이야.」
	PRINTFORMW 「가지고 있니?」
	PRINTFORML 
	CALL KIKURI_PANTIES_CHECK(BlessingTarget)
	IF RESULT
		CALL SET_KOJO_COLOR(152)
		IF BlessingTarget == 152
			IF TALENT:152:恋人
				PRINTFORML 「어이쿠, 그거 내 팬티잖아!」
				PRINTFORMDW 키쿠리가 웃음을 터뜨린다.
				CALL HPH_PRINT, @"「너 정말 항상 그걸 가지고 다니는 거냐? 너 완전 변태잖아」", "W"
			ELSEIF IS_FALLEN(152)
				PRINTFORML 「잠깐만... 그거 내 팬티잖아!」
				PRINTFORMDW 키쿠리가 당신을 향해 눈살을 찌푸린다.
				PRINTFORMW 「축복은 해줄게... 하지만 끝나고는 네가 그걸 어디서 구했는지 이야기할 거야.」
			ELSE
				PRINTFORML 「잠깐만... 그거 내 팬티잖아!」
				PRINTFORMDW 키쿠리가 너를 날카롭게 노려본다.
				PRINTFORML 「그러니까 네가 그걸 훔친 거구나!」
				PRINTFORMW 「됐어. 그런 팬티 도둑 같은 변태랑은 거래 안 해!」
				CALL GET_ANGRY(152, 2)
				RETURN 1
			ENDIF
		ELSE
			PRINTFORML 「그녀의 팬티라고?」
			PRINTFORMDW 키쿠리가 당신을 향해 미간을 찌푸린다.
			PRINTFORMW 「훔친 건 아니지, 그렇지?」
		ENDIF
		CFLAG:BlessingTarget:触媒を与えた = 1
	ELSE
		CALL SET_KOJO_COLOR(152)
		PRINTFORML 「너 하나도 없어, 응?」
		PRINTFORMW 「괜찮아. 나는 여전히 \@ BlessingTarget == 152 ? 우리의 # 너의 \@ 관계를 축복할 수 있어. 다만 그게 그렇게 강하지 않을 뿐이야.」
	ENDIF
	PRINTFORMDL 
	PRINTFORMDW 키쿠리가 거울 밖으로 손을 내밀고 기대 어린 눈빛으로 너를 바라본다.
	PRINTFORMDW 너는 돈을 건넨다. 그녀는 돈을 센 뒤 기모노 주머니에 챙겨 넣는다.
	PRINTFORMW 「좋아, 그럼 시작할 시간이야. 두 손을 모으고 눈을 감은 다음, 나에게 절해.」
	PRINTFORMDW 너는 그렇게 하고, 공기 속에 기대감이 차오르는 것을 느낀다.
	PRINTFORMDW 키쿠리가 집중하자, 너는... 어쩐지 몸이 가벼워진 듯 느낀다. 마치 부드러운 산들바람이 어깨의 무게를 들어 올린 듯하다.
	PRINTFORMW 「이곳은 정화했어. 이제 축복을 내릴게……」
	PRINTFORMDW 그녀는 깊이 숨을 들이마신 뒤, 맑은 목소리를 종처럼 울려 평온한 공간에 메아리치게 한다.
	PRINTFORMW 「이 길한 날, %조사처리(CALLNAME:MASTER,"가")% 내 앞에 선 지금, 사랑의 여신 키쿠리가……」
	PRINTFORMW 「내가 \@ BlessingTarget == 152 ? 우리 # %HIM_HER(MASTER)%와 %CALLNAME:BlessingTarget%. \@ 사이의 관계에 축복을 내리노라.」
	PRINTFORMW 「\@ BlessingTarget == 152 ? 우리의 # 그들의 \@의 사랑이 산처럼 오래도록 변치 않고, 바다처럼 강하며, 불처럼 맹렬하고, 숲 깊은 곳에서 자라는 꽃처럼 온화하고 다정하기를.」
	PRINTFORMW 「\@ BlessingTarget == 152 ? 우리 # 그들이 \@see \@ BlessingTarget == 152 ? 우리의 # 그들의 \@의 사랑이 서로의 눈에 비친 모습을, %조사처리(CALLNAME:MASTER,"가")% 내 몸에 비친 %HIS_HER(MASTER)% 자신의 모습을 보는 것만큼이나 선명하게 보기를.」
	PRINTFORMW 「\@ BlessingTarget == 152 ? 우리 # 그들이 \@share every moment of \@ BlessingTarget == 152 ? 우리 # 그들의 \@lives, from now until the moment \@ BlessingTarget == 152 ? 우리 # 그들이 \@이 죽는 순간까지, 좋을 때나 나쁠 때나, 아플 때나 건강할 때나, 기쁠 때나 슬플 때나 함께 나누기를.」
	PRINTFORMW 「\@ BlessingTarget == 152 ? 우리 # 그들을 \@ 사이의 사랑의 유대가 영원히 끊어지지 않기를.」
	PRINTFORMW 「신들께서 \@ BlessingTarget == 152 ? 우리의 # 그들의 \@steps, and may \@ BlessingTarget == 152 ? 우리를 # 그들을 \@always find \@ BlessingTarget == 152 ? 우리 # 그들이 \@way back to one another, no matter where fate may guide \@ BlessingTarget == 152 ? 우리의 # 그들의 \@ 찾기를.」
	PRINTFORMW 「좋아, %CALLNAME:MASTER%, 이제 눈을 떠도 돼.」
	PRINTFORMDW 너는 눈을 뜨고 똑바로 선다. 세상이 새로운 빛으로 아른거리는 듯하다.
	PRINTFORMDW 언제나처럼 키쿠리에게 비친 네 모습을 볼 수 있다……
	PRINTFORMDW 하지만 이제는 %CALLNAME:BlessingTarget%이 네 곁에 서서 미소 지으며 네 손을 잡고 있는 모습이 보인다.
	IF BlessingTarget == 152
		PRINTFORMDW 그리고 당신은 비친 키쿠리에게서 자신을 볼 수 있다.
		PRINTFORMDW 그 반영들은 보이지 않을 만큼 작아질 때까지 계속된다. 당신은 어지러움을 느끼기 시작한다...
	ENDIF
	PRINTFORMDW 그러면 너와 %CALLNAME:BlessingTarget%의 반영이 흔들리며 사라지고, 평소의 네 모습으로 대체된다.
	PRINTFORMW 너는 자신과 %CALLNAME:BlessingTarget% 사이의 유대가 더욱 강해지는 것을 느낀다...
	PRINTFORMDL 
	PRINTFORMW 「후원해 주셔서 감사합니다!」
	PRINTFORMDW 키쿠리가 당신에게 빛을 비춘다.
	PRINTFORMW 「또 축복이 필요하다면 언제든 돌아와 주세요.」
	SELECTCASE BlessingType
		CASE 1
			CALL PAY_MONEY_YEN(10000, 1)
			CFLAG:BlessingTarget:祝福の持続時間 = 1
		CASE 2
			CALL PAY_MONEY_YEN(60000, 1)
			CFLAG:BlessingTarget:祝福の持続時間 = 7
		CASE 3
			CALL PAY_MONEY_YEN(250000, 1)
			CFLAG:BlessingTarget:祝福の持続時間 = 30
	ENDSELECT
ELSE
	GOTO CANCEL
ENDIF
;------------------------------------------------------
;process the extra flags
;when starting the day

@EVENTTRAIN
FOR LOCAL,1,CHARANUM
IF CFLAG:LOCAL:祝福の持続時間
	CFLAG:LOCAL:祝福の持続時間 -= 1
	IF !CFLAG:LOCAL:祝福の持続時間
		PRINTFORMDL 어쩐지, %CALLNAME:LOCAL%와 조금 덜 가까워진 기분이 들었다...
		CFLAG:LOCAL:触媒を与えた = 0
	ENDIF
ENDIF
NEXT
;ng reset

@NG_CUSTOM_RESET_VAR_7
FOR LOCAL,1,CHARANUM
CFLAG:LOCAL:触媒を与えた = 0
CFLAG:LOCAL:祝福の持続時間 = 0
NEXT
