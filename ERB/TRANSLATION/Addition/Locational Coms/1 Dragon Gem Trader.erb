
@TSC_1
#DIM ORB_PRICE
#DIM SALES

IF !ITEM:龍珠
	PRINTFORML You don't have any Dragon Gems to trade...
	RETURN
ENDIF

;売価はカリスマ取引レート×90×√話術Lvで決定
ORB_PRICE = CHARISMA_NOW() * 90
SELECTCASE ABL:MASTER:話術技能
	CASE 0
		TIMES ORB_PRICE, 1.0
	CASE 1
		TIMES ORB_PRICE, 1.2
	CASE 2
		TIMES ORB_PRICE, 1.4
	CASE 3
		TIMES ORB_PRICE, 1.7
	CASE 4
		TIMES ORB_PRICE, 2.0
	CASE 5
		TIMES ORB_PRICE, 2.2
	CASE 6
		TIMES ORB_PRICE, 2.4
	CASEELSE
		TIMES ORB_PRICE, 2.6
ENDSELECT

PRINTL 
PRINTFORML You spot a suspicious-looking figure right by the cave...
IF !TSC1_DragonGemTraderMet
	PRINTFORML 「Heyo, %PRINT_MALE("boyo:girlie", MASTER)%, you from here?」
	PRINTFORML 「Naw, no matter. Anyhow, I see you got that Dragon Gem on ya, right?」
	PRINTFORML 「No worries, I'm not some petty robber. Rather, I got a business proposition for ya!」
	PRINTFORML 「Y'see, I'm a collector of sorts. I need them Gems, and I'm willing to pay a pretty penny for each of 'em!」
	PRINTFORML 「But, uhh, the air's too thin in that cave for me, y'know? And you seem to be doin' just fine...」
	TSC1_DragonGemTraderMet = 1
ELSE
	PRINTDATAW
		DATAFORM 「I bet you don't know what to do with them Dragon Gems anyway, right? No worries, I'll relieve that load for ya.」\n「Not for free, of course. I'll pay ya a reasonable price, no worries.」
		DATAFORM 「Hmm? What do I need these for, anyway? Gee, I dunno, stare at 'em, caress 'em, lick 'em...」\n「Err, I mean... Yeah, well, whooo knows?」
		DATAFORM 「I wonder where you managed to get a hold of such beauty. Well, it still looks perfectly usable to me, in any case.」
		DATAFORM 「The fact that you even got one means it was attracted to you. Found you promising, and all.」\n「Man, looks sure can be deceiving for you hummies, eh?」
		DATAFORM 「Doesn't sound like someone's egging you on... or anything like that. So let's make a deal.」
		DATAFORM 「It's best to have many suppliers for rare earth elements. In the business we call it hedging.」
		DATAFORM 「I'm surprised you can even venture in that cave and get out unscathed.」\n「Gotta make it rewardin' for ya then, am I right?」
	ENDDATA
ENDIF
PRINTFORML 「I'm gonna buy each Gem for ¥{ORB_PRICE} a piece off of ya. How about it?」
PRINTL 
DRAWLINE
PRINTFORML Money:%金額表示(MONEY)%　　Current Charisma Rate:%金額表示(CHARISMA_NOW())%←→1CM
SETCOLOR 0x777777
PRINTFORML 　How many do you want to sell? (Input 1-{ITEM:龍珠} to choose, 0 to cancel)
RESETCOLOR
PRINTL   
PRINTBUTTON "[0] Cancel", 0
PRINT     
PRINTBUTTON "[1] 1", 1
PRINT     
IF ITEM:龍珠 >= 5
	PRINTBUTTON "[5] 5", 5
	PRINT     
ENDIF
IF ITEM:龍珠 >= 10
	PRINTBUTTON "[10] 10", 10
	PRINT    
ENDIF
$INPUT_LOOP01
INPUT
SELECTCASE RESULT
	CASE 0
		CLEARLINE 2
		PRINTFORMW 「Fine. My rate depends on how well the Charisma is doing in a given day, so come back when it looks good for ya.」
	CASE 1 TO ITEM:龍珠
		CLEARLINE 2
		SALES = RESULT
		PRINTFORMW 「Alright, then I'm buying %PRINT_PLUR("Dragon Gem", SALES)% for ¥{ORB_PRICE * SALES}.」
		CALL GET_MONEY_YEN(ORB_PRICE * SALES, 1)
		CALL LOST_ITEM("龍珠", SALES, 2)
		PRINTFORML 「Pleasure doin' business with ya, pal!」
		PRINTFORMW 「Feel free to swing by whenever you get more!」
	CASEELSE
		CLEARLINE 1
		GOTO INPUT_LOOP01
ENDSELECT

SIF !FLAG:70
	TIME += 5
TFLAG:102 = 0

@TSC_NAME1
#DIMS DYNAMIC COMNAME
COMNAME = Dragon Gem Trader
RESULTS = %COMNAME%

@TSC_ABLE1

IF CFLAG:MASTER:現在位置 != GET_MAP_REPLACEMENT(P855虹龍洞)
    RETURN 0
ENDIF
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 2

