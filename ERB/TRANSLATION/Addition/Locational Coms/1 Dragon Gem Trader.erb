; Modular ERB: Addition/Locational Coms/1 용의 보옥 Trader.erb

@TSC_1
#DIM ORB_PRICE
#DIM SALES
IF !ITEM:龍珠
	PRINTFORML 당신은 교환할 용의 구슬이 없습니다...
	RETURN
ENDIF
;売価はカリスマ取引レート×90×√話術Lvで決定
ORB_PRICE = CHARISMA_NOW() * 90
SELECTCASE ABL:MASTER:話術技能
	CASE 0
		TIMES ORB_PRICE, 1.0
	CASE 1
		TIMES ORB_PRICE, 1.2
	CASE 2
		TIMES ORB_PRICE, 1.4
	CASE 3
		TIMES ORB_PRICE, 1.7
	CASE 4
		TIMES ORB_PRICE, 2.0
	CASE 5
		TIMES ORB_PRICE, 2.2
	CASE 6
		TIMES ORB_PRICE, 2.4
	CASEELSE
		TIMES ORB_PRICE, 2.6
ENDSELECT
PRINTL 
PRINTFORML 동굴 바로 옆에서 수상해 보이는 체형을 발견한다...
IF !TSC1_DragonGemTraderMet
	PRINTFORML 「안녕, %PRINT_MALE("꼬맹이:아가씨", MASTER)%, 여기서 온 거야?」
	PRINTFORML 「아니, 상관없어. 어쨌든 네가 드래곤 보석을 가지고 있는 걸 봤지, 맞지?」
	PRINTFORML 「걱정 마, 난 사소한 도둑 같은 사람이 아니야. 오히려 너에게 사업 제안이 있어!」
	PRINTFORML 「있잖아, 나는 일종의 수집가거든. 나한테 그 보석들이 필요하고, 하나당 꽤 큰돈을 지불할 용의가 있어!」
	PRINTFORML 「하지만, 음, 그 동굴 안 공기가 나한테는 너무 희박하단 말이야, 알잖아? 그리고 너는 아주 잘 지내는 것 같고...」
	TSC1_DragonGemTraderMet = 1
ELSE
	PRINTDATAW
		DATAFORM 「당신은 어차피 저 드래곤 젬들로 뭘 해야 할지 모르잖아, 그치? 걱정 마, 내가 대신 처리해 줄게.」\n「물론 공짜는 아니야. 합리적인 가격을 지불할 테니 걱정 마.」
		DATAFORM 「음? 이걸 대체 뭐에 쓰려는 거지? 음, 모르겠네, 쳐다보거나, 만지작거리거나, 핥아보거나...」\n「저기, 그러니까... 응, 누가 알겠어?」
		DATAFORM 「어떻게 저런 아름다운 것을 구했는지 궁금하네. 아무튼 나한테는 여전히 완벽하게 쓸모가 있어 보여.」
		DATAFORM 「당신이 하나라도 얻었다는 건 그것이 당신에게 끌렸다는 뜻이야. 유망하다고 생각했을 뿐이지, 그게 다야.」\n「인간들에게는 보기만 해도 속을 수 있는 법이지, 그렇지 않아?」
		DATAFORM 「누군가 당신을 부추고 있는 것 같지는 않은데... 뭐 그런 거 말이야. 그럼 거래를 하자.」
		DATAFORM 「희토류 원소의 공급처는 여러 곳이 있는 게 제일 좋아. 사업에서는 그걸 헤징이라고 부르지.」
		DATAFORM 「그 동굴에 들어가서 다치지 않고 나올 수 있었다니 놀랍군.」\n「그러니 보상이 충분히 가치가 있게 만들어야겠어, 안 그래?」
	ENDDATA
ENDIF
PRINTFORML 「네가 파는 보석 하나에 ¥{ORB_PRICE}씩 사겠어. 어때?」
PRINTL 
DRAWLINE
PRINTFORML 돈:%金額表示(MONEY)% 현재 카리스마율:%金額表示(CHARISMA_NOW())%←→1CM
SETCOLOR 0x777777
PRINTFORML 　몇 개를 팔고 싶으신가요? (선택을 위해 {ITEM:龍珠}에 입력하세요, 취소는 0)
RESETCOLOR
PRINTL   
PRINTBUTTON "[0] 취소", 0
PRINT     
PRINTBUTTON "[1] 1", 1
PRINT     
IF ITEM:龍珠 >= 5
	PRINTBUTTON "[5] 5", 5
	PRINT     
ENDIF
IF ITEM:龍珠 >= 10
	PRINTBUTTON "[10] 10", 10
	PRINT    
ENDIF
$INPUT_LOOP01
INPUT
SELECTCASE RESULT
	CASE 0
		CLEARLINE 2
		PRINTFORMW 「좋아. 내 요금은 주어진 날에 카리스마가 얼마나 잘 작동하느냐에 달려 있으니, 상황이 좋아졌을 때 다시 와.」
	CASE 1 TO ITEM:龍珠
		CLEARLINE 2
		SALES = RESULT
		PRINTFORMW 「좋아, 그럼 나는 {ORB_PRICE * SALES}엔에 %PRINT_PLUR("용의 보옥", SALES)%을 살게.」
		CALL GET_MONEY_YEN(ORB_PRICE * SALES, 1)
		CALL LOST_ITEM("龍珠", SALES, 2)
		PRINTFORML 「너랑 사업하게 돼서 즐거워, 친구!」
		PRINTFORMW 「언제든지 더 필요할 때 들러도 괜찮아!」
	CASEELSE
		CLEARLINE 1
		GOTO INPUT_LOOP01
ENDSELECT
SIF !FLAG:70
	TIME += 5
TFLAG:102 = 0

@TSC_NAME1
#DIMS DYNAMIC COMNAME
COMNAME = 드래곤 보석 상인
RESULTS = %COMNAME%

@TSC_ABLE1
IF CFLAG:MASTER:現在位置 != GET_MAP_REPLACEMENT(P855虹龍洞)
	RETURN 0
ENDIF
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:うふふ == 2
	RETURN 0
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
RETURN 2
