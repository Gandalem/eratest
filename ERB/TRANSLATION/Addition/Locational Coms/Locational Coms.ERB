; Modular ERB: Addition/Locational Coms/Locational Coms.ERB
;ARG - 현재 위치

@LocationalComAble
LOCAL:1 = 0
FOR LOCAL,0,1000
TRYCALLFORM TSC_ABLE{LOCAL}()
IF RESULT == 2
	RESULT:1 = LOCAL
	LOCAL:1++
ENDIF
RESULT = 0
NEXT
RETURN LOCAL:1

@LocationalComMain
CALL LocationalComAble
IF RESULT == 1 ;if only one command is available at the spot, execute that right away
	TRYCALLFORM TSC_ABLE{RESULT:1}()
	IF RESULT == 2
		CALLFORM TSC_{RESULT:1}
		RETURN RESULT
	ENDIF
ENDIF
PRINTFORML 현재 위치에서 실행 가능한 명령어의 개수: {RESULT}
LOCAL:1 = 0
FOR LOCAL,0,1000
RESULT = 0
TRYCALLFORM TSC_ABLE{LOCAL}()
IF RESULT == 2
	CALLFORM TSC_NAME{LOCAL}
	PRINTFORMLC %RESULTS,16,RIGHT%[{LOCAL,3,RIGHT}]
	LOCAL:1 ++
ENDIF
IF LOCAL:1 % 3 == 0&&LOCAL:1 != 0
	LOCAL:1 = 0
	PRINTL
ENDIF
NEXT
PRINTL
DRAWLINE
PRINTFORML %"취소",16,RIGHT%[999]
$LOOP
INPUT
IF RESULT == 999
	RETURN -1
ELSE
	LOCAL = RESULT
	TRYCALLFORM TSC_ABLE{LOCAL}()
	IF RESULT == 2
		CALLFORM TSC_{LOCAL}
		RETURN RESULT
	ELSE
		GOTO LOOP
	ENDIF
ENDIF
