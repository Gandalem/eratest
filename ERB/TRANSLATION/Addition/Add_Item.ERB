; Modular ERB: Addition/Add_Item.ERB
;easy way to add custom usable item

@Add_UseItem(nItem, nTarget, nGiver = -1)
#DIM nItem
#DIM nTarget
#DIM nGiver; nas custom
SIF nGiver == -1
	nGiver = MASTER
;/////////////////////
;return values: 3 - item use is canceled, 1 - item is used, 2 - item is used and end of the day is triggered.
SELECTCASE nItem
	CASE 36 ;umbrella
		SIF nTarget != MASTER ;player only
			RETURN 3
		IF CFLAG:MASTER:うふふ
			PRINTFORMW 지금 그걸 써봤자 소용없다...
			RETURN 3
		ENDIF
		IF !GROUPMATCH(TIME:5, 4, 5, 6, 8, 9, 10, 12, 13, 14, 15)
			PRINTFORMW 날씨가 그것을 하기에는 충분하지 않지만...
			RETURN 3
		ENDIF
		IF nDontUseUmbrella
			PRINTFORMW 당신은 우산을 펼친다.
			nDontUseUmbrella = 0
		ELSE
			PRINTFORMW 당신은 우산을 접는다.
			nDontUseUmbrella = 1
			;sharing an umbrella disable
			TEQUIP:MASTER:201 = 0
			SIF TARGET
				TEQUIP:TARGET:201 = 0
		ENDIF
		ITEM:折り畳み傘 ++ ;add a copy because it'll be consumed
		RETURN 1
	CASE 252 ;sleep pill
		SIF nTarget != MASTER ;player only
			RETURN 3
		IF FLAG:70
			PRINTFORMW 타임 스톱 밖에서 사용하자.
			RETURN 3
		ENDIF
		IF CFLAG:MASTER:うふふ
			PRINTFORMW 지금 이걸 쓰는 건 꽤 나쁠 것 같다...
			RETURN 3
		ENDIF
		IF CFLAG:MASTER:現在位置 != CFLAG:MASTER:初期位置
			IF (CFLAG:MASTER:お招き || CFLAG:MASTER:添い寝中) ;allow usage when invited/sleeping together
			ELSE
				PRINTFORMW 집에 가져가는 게 좋겠어.
				RETURN 3
			ENDIF
		ENDIF
		IF DrugAddict:MASTER:0 > 0 && ITEM:睡眠薬 < DrugAddict:MASTER:0
			PRINTFORMW 너에게 영향을 주기 위해서는 이것보다 더 많은 용량이 필요하다... ({DrugAddict:MASTER:0} 알 최소)
			RETURN 3
		ENDIF
		PRINTFORMW 당신은 \@ DrugAddict:MASTER:0 >= 2 ? 수면제 한 알을 벌컥벌컥 삼킨다. # 수면제를 좀 먹는다. \@ 그리고 깊은 잠에 빠져들다...
		nSleepingPill_Taken = 1
		SIF DrugAddict:MASTER:0 > 0 ;one extra item is used when function ends
			ITEM:睡眠薬 -= DrugAddict:MASTER:0
		RETURN 2
	CASE 923
		;Girl's Egg.
		PRINTFORMDL 당신은 달걀을 깨고 노른자를 생으로 삼킨다.
		;Recovers half as much as a prepared snack.
		CALL RECOVER(MASTER,250,"体力", "생날 암탉의 알로 회복한다.")
		CALL RECOVER(MASTER,750,"気力", "원시 소녀의 알로 회복한다.")
		CALL RECOVER(MASTER,50,"精力", "생날 계란으로 회복한다.")
		WAIT
		RETURN 1
	CASE 924
		;Hyper Ovulation Drug.
		SIF nTarget == MASTER
			RETURN 3
		IF TALENT:nTarget:HYPERFERTILE
			PRINTFORMDW %CALLNAME:nTarget%는 이미 %GET_TALENTNAME_TR(GETNUM(TALENT, "HYPERFERTILE"), 1)%이다.
			RETURN 3
		ENDIF
		IF IS_MALE(nTarget)
			PRINTFORMDW 남성에게는 사용할 수 없다.
			;Can't use on male characters.
			RETURN 3
		ENDIF
		SELECTCASE TALENT:nTarget:PREGNANCY_TYPE
			CASE PREGNANCY_NORMAL, PREGNANCY_LITTERS
				TALENT:nTarget:HYPERFERTILE = 1
				PRINTFORMDW %CALLNAME:nTarget%는 이제 %GET_TALENTNAME_TR(GETNUM(TALENT, "HYPERFERTILE"), 1)%이다.
			CASEELSE
				PRINTFORMDW 그것은 %CALLNAME:nTarget%에게는 효과가 없을 것이다.
				RETURN 3
		ENDSELECT
		RETURN 1
	CASE 991 ;milk bottle
		SIF nTarget != MASTER ;player only (for now?)
			RETURN 3
		PRINTFORML 당신은 병을 열고 상쾌한 한 모금을 마신다.
		PRINTFORMW 너무 맛있어서 알아차리지 못하고 전부 다 마셔버린다!
		;300 units in the bottle, though it's busted af that way
		IF TIME:1 - EX:MASTER:前回の入浴時刻 < 90
			CALL RECOVER(MASTER,180 * 8,"体力", "막 목욕을 마치고")
			CALL RECOVER(MASTER,150 * 12,"気力", "방금 목욕을 마치고")
			CALL RECOVER(MASTER,500,"精力", "방금 목욕하고 나온")
		ELSE
			CALL RECOVER(MASTER,90 * 5,"体力", " ")
			CALL RECOVER(MASTER,120 * 8,"気力", " ")
			CALL RECOVER(MASTER,200,"精力", " ")
		ENDIF
		CALL 満腹度上昇(MASTER,"軽食")
		Qol_Info_Count_Array:MASTER:Qol_Count_MilkDrankBottle += 300
		;return a bottle
		SIF ITEM:瓶 < 99
			CALL GET_ITEM("瓶", 1, 1)
		RETURN 1
	CASE 995 ;Weather Report
		IF FLAG:異常気象
			PRINTFORMDW 이 이상 기후는 바꿀 수 없다.
			RETURN 3
		ELSEIF FORBIDDEN_CHANGE_WEATHER
			PRINTFORMDW 누군가의 힘이 이미 날씨에 영향을 미치고 있다.
			RETURN 3
		ENDIF
		PRINTFORMDL 어떤 종류의 날씨를 만들고 싶습니까?
		;from GET_WEATHER_TR
		SPLIT "Sunny/Fair/Overcast/Cloudy/Rain/Downpour/Drizzle/Foggy/Snowy/Snowstorm/Light Snowfall/Snow Grains/Sleet/Hail/Rainstorm/Hailstorm/Panties", "/", LOCALS
		LOCAL:11 = RESULT
		;modeled after ASK_M
		LOCAL:10 = CURRENTREDRAW()
		REDRAW 0
		FOR LOCAL, 0, LOCAL:11
		PRINTBUTTON @"{LOCAL, 2, RIGHT}[%LOCALS:LOCAL%]", LOCAL
		PRINTL
		NEXT
		PRINTBUTTON @"{-1}[Cancel]", -1
		PRINTL
		$WEATHER_INPUT_LOOP
		INPUT
		IF RESULT < 0 || RESULT >= LOCAL:11
			CLEARLINE 1
			GOTO WEATHER_INPUT_LOOP
		ENDIF
		REDRAW LOCAL:10
		SIF TIME:5 <= 15 ;normal weather types
			TIME:5 = RESULT
		PRINTFORMDL 「날씨 보고」다!
		SELECTCASE RESULT
			CASE 0, 1 ;sunny/fair
				PRINTFORMDL 하늘이 맑아졌고, \@ TIME:2 >= 5 && TIME:2 <= 7 ? 별들이 선명하게 보인다 # 태양이 밝게 빛난다 \@.
				;chance for rainbow
				IF INRANGE(TIME:5,4,7) && !RAND:7
					TIME:7 = 1
					PRINTFORMD 갑자기 \@ TIME:2 >= 5 && TIME:2 <= 7 ? 달 # 비 \@가 나타난다!
					;chance for diamond dust
				ELSEIF INRANGE(TIME:5,8,13) && !RAND:7
					TIME:7 = 2
					PRINTFORMD 다이아몬드 먼지가 보이게 된다!
				ENDIF
				PRINTL
			CASE 2 ;overcast
				PRINTFORMDW 날씨가 약간 흐려졌다.
			CASE 3 ;cloudy
				PRINTFORMDW 구름이 하늘 전체를 뒤덮고 있다.
			CASE 4 ;rain
				PRINTFORMDW 비가 온다!
			CASE 5 ;downpour
				PRINTFORMDW 비가 쏟아지기 시작했다!
			CASE 6 ;drizzle
				PRINTFORMDW 이슬비가 내리고 있다.
			CASE 7 ;foggy
				PRINTFORMDW 날씨가 안개처럼 흐려졌다.
			CASE 8 ;snowy
				PRINTFORMDW 눈이 내리고 있다!
			CASE 9 ;snowstorm
				PRINTFORMDW 눈이 내리고 있다! 눈보라다!
			CASE 10 ;light snowfall
				PRINTFORMDW 가볍게 눈이 내리고 있다.
			CASE 11 ;snow grains
				;doesn't happen naturally, but should work fine
				PRINTFORMDW 눈송이가 내리고 있다.
			CASE 12 ;sleet
				PRINTFORMDW 이슬비가 내린다!
			CASE 13 ;hail
				PRINTFORMDW 우박이 내린다!
			CASE 14 ;rainstorm
				PRINTFORMDW 이 비는 멈추지 않아! 폭우야!
			CASE 15 ;hailstorm
				PRINTFORMDW 우박이 내릴 것이다!
			CASE 16 ;panties, take actively worn panties from nearby regions and give them directly to the player, instead of using existing panty weather type
				PRINTFORMDW 갑자기 엄청난 양의 팬티들이 사방으로 날아다니기 시작한다.
				FOR LOCAL, 1, CHARANUM
				SIF CFLAG:LOCAL:現在位置 == SUKIMA() ;not out and about
					CONTINUE
				SIF TALENT:LOCAL:行きずり
					CONTINUE
				IF QOL_REVISED_DISTANCE(GET_MAPID(CFLAG:LOCAL:現在位置), CFLAG:MASTER:デート中) < (30 + WIND_VELOCITY * 10) ;within a certain distance, high winds increase range
					IF !CFLAG:LOCAL:ノーパン && EQUIP:LOCAL:下半身下着２ && CFLAG:LOCAL:344 == 0 && GET_INT(LOCAL, "下半身下着_ずらし可能", EQUIP:LOCAL:下半身下着２, "コレクション表示可能")
						SIF !PANTS_ALREADY_COLLECTED(LOCAL)
							SETCOLOR C_PINK
						PRINTFORML %CALLNAME:LOCAL%의 %PANTSNAME(EQUIP:LOCAL:下半身下着２,LOCAL)%가 당신의 주머니 속으로 날아들어간다.
						RESETCOLOR
						CALL PANTS_GET(LOCAL)
					ENDIF
				ENDIF
				NEXT
				PRINTFORMDW 갑작스러운 팬티 폭우가 잠잠해지며 팬티 이슬비로 바뀐다.
				FLAG:異常気象 = 7
				; CASE 17 ;frogs, not implemented
				;     PRINTFORMDL Countless frogs fall down from the sky!
				;     SIF !RAND:5
				;         PRINTFORMDL In the distance, you hear someone yell something about frogs on their 100000 yen pants.
		ENDSELECT
		;it might be desirable to let the player control wind speed too, but i do not see a use case for it right now, so for now it's always set to zero
		WIND_VELOCITY = 0
		FORBIDDEN_CHANGE_WEATHER = 1
		RETURN 1
	CASE 996 ;doppelganger draught
		SELECTCASE TEQUIP:MASTER:DOPPELGANGER_MAX
			CASE IS >= 4
				PRINTFORMDL 더 이상 마시는 것은 위험할 것이다.
				RETURN 3
			CASE IS >= 2
				PRINTFORMDL 더 강한 용량을 또 복용할 것인가(필요 수량 3)?
				CALL ASK_YN
				IF !RESULT
					PRINTFORMDL 당신은 도플갱어 영약을 더 마시고 의식이 한층 확장되는 것을 느낀다.
					ITEM:DOPPELGANGER_DRAUGHT -= 2
					TEQUIP:MASTER:DOPPELGANGER_MAX = 4
					RETURN 1
				ELSE
					RETURN 3
				ENDIF
			CASEELSE
				PRINTFORMDL 당신은 도플갱어 드래프트 한 병을 삼키고 의식이 늘어나는 것을 느낀다.
				TEQUIP:MASTER:DOPPELGANGER_MAX = 2
				RETURN 1
		ENDSELECT
		;----------------------------------
		;NAS CUSTOM CODE
		;----------------------------------
	CASE 41
		PRINTFORML \@ nTarget == MASTER ? 당신은 # %조사처리(CALLNAME:nTarget,"는")% \@ %ITEMNAME_TR(nItem)% 한 알을 삼킨다.
		PRINTFORML %조사처리(CALLNAME:nTarget,"의")% 볼이 발그레해지고, 입에서는 조용한 신음이 새어 나온다.
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 42
		PRINTFORML \@ nTarget == MASTER ? 당신은 # %조사처리(CALLNAME:nTarget,"는")% \@ %ITEMNAME_TR(nItem)% 한 알을 삼킨다.
		PRINTFORML 숨이 거칠어지기 시작하자 갑작스러운 요의에 눈물이 맺히고, %조사처리(CALLNAME:nTarget,"는")% 필사적으로 이를 참으려 한다.
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 51 TO 59
		PRINTFORML \@ nTarget == MASTER ? 당신은 # %조사처리(CALLNAME:nTarget,"는")% \@ %ITEMNAME_TR(nItem)%을 마신다.
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 101
		PRINTFORMW 두 소녀가 서로 싸우는 표지의 책을 꺼냈다.
		PRINTFORMW 「단막(彈幕)과 근접 전투 101」
		PRINTFORMW 그것은 즉시 당신의 주의를 사로잡는다. 훑어보면 싸워야 할 상대들과 전투에 도움이 될 기교들을 보여준다.
		PRINTFORML
		CALL COLORMESSAGE("효과",C_YELLOW,1,1)
		PRINTFORML 단막전에서 전투경험 +1을 얻는다
		WAIT
	CASE 108
		PRINTFORMW 소녀가 열매를 따는 그림이 표지에 있는 책을 꺼냈다.
		PRINTFORMW 「약초학자: 일본판」
		PRINTFORMW 좀 지루해 보이지만, 어쨌든 그것을 읽어본다. 훑어보니 이상한 요괴들의 대장간 위치와 먹어야 할 것/먹으면 안 되는 것들이 눈에 들어온다.
		PRINTFORML
		CALL COLORMESSAGE("효과",C_YELLOW,1,1)
		PRINTFORML 채집경험 +1을 얻었다.
		WAIT
	CASE 111
		PRINTFORMW 작은 소녀가 말린 옷을 입고 자신을 내보이는 표지의 책을 꺼내자, 멀리서는 또 다른 소녀가 자위하는 모습이 보인다.
		PRINTFORMW 「타락의 순환: 봄 20XX」
		PRINTFORMW 그것은 즉시 당신의 주의를 사로잡는다. 훑어보면 성적인 기교와 그것을 하는 방법에 대한 단계별 지침들이 나타난다.
		PRINTFORMW 단순히 이것들을 보는 것만으로도 매우 흥분한다.
		PRINTFORML
		CALL COLORMESSAGE("효과",C_YELLOW,1,1)
		PRINTFORML 무지한 캐릭터들에게 성에 대해 가르친다.
		WAIT
	CASE 112
		PRINTFORMW 당신은 단순히 볼드체 문구만 적힌 표지의 책을 꺼낸다.
		PRINTFORMW 「일반 셀프 케어 가이드」
		PRINTFORMW 지루하다. 그럼에도 불구하고 당신은 그것을 뒤적인다. 훑어보기만 해도 오르가즘, 알코올, 그리고 약물 중독에서 벗어날 수 있는 방법들을 보여준다.
		PRINTFORML
		CALL COLORMESSAGE("효과",C_YELLOW,1,1)
		PRINTFORML 오르가즘 부정 능력과 트라우마 손실의 패시브 습득량을 두 배로 늘린다.
		PRINTFORML 알코올 및 약물 중독의 패시브 감소량을 두 배로 늘린다.
		PRINTFORML 파괴되고 혼수상태인 캐릭터를 레벨 -3 트라우마로 초기화한다.
		WAIT
		IF CharaTrauma:nTarget:0 >= 4
			CharaTrauma:nTarget:0 = 3
			CharaTraumaExp:nTarget:0 = EXP_DEMAND_24(0,91,nTarget,,-5)-1
			CALLF SILENT_ENDURANCECHANGE(nTarget)
			CALL COLORMESSAGE(@"%CALLNAME:nTarget%당신의 %조사처리(CALLNAME:nTarget,"의")% 정신을 회복했다!",C_GREEN,2,1)
		ENDIF
	CASE 113
		PRINTFORMW 화장실 옆에서 소변을 참으려는 소녀의 표지가 그려진 책을 꺼냈다.
		PRINTFORMW 「며칠 동안 스스로를 붙잡기: (요)습관화를 위한 배변 훈련 안내서」
		PRINTFORMW 흥미로운 책 제목이다. 훑어보니 방광이 가득 찼다는 경고 신호와 소변을 참는 방법들이 보였다.
		PRINTFORML
		CALL COLORMESSAGE("효과",C_YELLOW,1,1)
		PRINTFORML 화장실에 갈 때 소변 참기 획득량이 두 배가 된다.
		PRINTFORML 소변이나 대변을 보고 싶어 할 때 소변 참기 획득량이 두 배가 된다.
		PRINTFORML 사고 발생 시 배변 훈련 퇴행량을 절반으로 줄인다.
		PRINTFORML 실금 캐릭터의 배변 훈련 능력을 레벨 -4로 초기화한다.
		PRINTFORML 실금에 대해 무지한 캐릭터들에게 필요할 때 보호구를 사용하도록 가르친다.
		WAIT
		IF PeeHold:nTarget:0 > -5 && PooHold:nTarget:0 > -5
		ELSE
			SIF PeeHold:nTarget:0 <= -5
				PeeHold:nTarget:0 = -4
			SIF PooHold:nTarget:0 <= -5
				PooHold:nTarget:0 = -4
			PeeHoldExp:nTarget:0 = EXP_DEMAND_20(0,91,nTarget,,-5)+1
			PooHoldExp:nTarget:0 = EXP_DEMAND_21(0,92,nTarget,,-5)+1
			CALLF SILENT_ENDURANCECHANGE(nTarget)
			CALLF ResetBladders(nTarget)
			CALL COLORMESSAGE(@"%CALLNAME:nTarget%화장실에 가고 싶을 때 배운다!",C_GREEN,2,1)
			PRINTFORM %CALLNAME:nTarget%의 배변 훈련 능력은 이제 레벨이 되었다.
			SETCOLOR C_YELLOW
			PRINTFORM {PeeHold:nTarget:0}【%GET_TALENTNAME_TR(1514, TALENT:nTarget:57)%】
			IF nScat
				RESETCOLOR
				PRINTFORM /
				SETCOLOR 0x6b4737
				PRINTFORML {PooHold:nTarget:0}【%GET_TALENTNAME_TR(1500, TALENT:nTarget:58)%】
			ENDIF
			RESETCOLOR
			WAIT
		ENDIF
		IF TALENT:nTarget:ContinenceIgnorant
			IF ABL:nTarget:43 >= UniversalRank("C")
				TALENT:nTarget:ContinenceIgnorant = 0
				CALL COLORMESSAGE(@"%PARSE("You have",,,nTarget)%필요할 때 방광 보호구를 사용법을 익혔다.",C_GREEN,2,1)
			ELSE
				PRINTFORMW %조사처리(CALLNAME:nTarget,"는")% 실금과 배변 훈련이라는 주제를 아직 잘 이해하지 못한 듯하다.
				PRINTFORMW 좀 더 아는 후에 %CALLNAME:nTarget%에게 가르쳐 보는 건 어떨까
			ENDIF
		ENDIF
	CASE 218
		PRINTFORML \@ nTarget == MASTER ? 당신은 # %조사처리(CALLNAME:nTarget,"는")% \@ %ITEMNAME_TR(nItem)%을 마신다.
		PRINTL 신선하다!
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 219
		PRINTFORML \@ nTarget == MASTER ? 당신은 # %조사처리(CALLNAME:nTarget,"는")% \@ %ITEMNAME_TR(nItem)%을 마신다.
		PRINTL 따뜻하고 활력이 넘친다!
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 220
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 221
		PRINTFORML \@ nTarget == MASTER ? 당신은 # %조사처리(CALLNAME:nTarget,"는")% \@ %ITEMNAME_TR(nItem)%을 마신다.
		PRINTL 새로고침 중이다!
		CALL DrugStuffNoFluff(nTarget,nItem)
		RETURN 1
	CASE 222
