		nCostSum -= GETBIT(nChainSawMods, ChainSaw_TreeSeeker) * nChainSawModsCost:3
		nCostSum -= GETBIT(nChainSawMods, ChainSaw_Flashlight) * nChainSawModsCost:4
		CALL SPTALK, [[にとり]], "笑顔", 0, @"「어떻게 바꾸고 싶으신가요?」", 1
		PRINTD 현재 상태: 
		CALL Add_ItemModList_チェーンソー
		PRINTL
		DRAWLINE
		IF !GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser)
			PRINTFORML [  1] - 미니팬&워터 디스펜서(¥{nChainSawModsCost:0}): 체인톱에 이동식 워터 디스펜서를 장착하여 갈증을 해소하고, 미니팬으로 피로를 물리친다.
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 미니 팬 & 물 디스펜서: 피로 감소
			RESETCOLOR
		ENDIF
		IF !GETBIT(nChainSawMods, ChainSaw_DualSaw)
			PRINTFORML [  2] - 더블 소드: (¥{nChainSawModsCost:1}): 두 배의 재미! 어떤 나무든 자르는 것이 식은 죽전이 된다.
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 더블 소드: 체인톱의 효과를 증가시킨다
			RESETCOLOR
		ENDIF
		IF !GETBIT(nChainSawMods, ChainSaw_KickBack)
			PRINTFORML [  3] - 반동 완화 장치: (¥{nChainSawModsCost:2}): 반동 가능성을 걱정하는 것이 지겹지 않은가? 이것을 설치하면 가장 큰 나무조차 문제 되지 않는다!
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 리턴 방지 장치: 더 큰 나무를 자르는 난이도를 줄여준다.
			RESETCOLOR
		ENDIF
		IF !GETBIT(nChainSawMods, ChainSaw_TreeSeeker)
			PRINTFORML [  4] [ 4] - 트리 시커: (¥{nChainSawModsCost:3}): 어떤 위치에서든 더 가치 있는 나무를 찾는 데 도움을 주는 멋진 레이더다!
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 나무 탐색자: 더 가치 있는 나무를 발견할 확률을 증가시킨다.
			RESETCOLOR
		ENDIF
		IF !GETBIT(nChainSawMods, ChainSaw_Flashlight)
			PRINTFORML [  5] [ 5] - 플래시라이트: (¥{nChainSawModsCost:4}): 완전한 어둠 속에서도 나무를 벨 수 있게 해주는 강력한 자가 충전식 손전등!
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 손전등: 어둠 속에서도 로그를 기록할 수 있게 해준다.
			RESETCOLOR
		ENDIF
		IF nItemMod == 0
			PRINTFORML [  6] 모두 추가한다 (총 ¥{nCostSum})
		ELSE
			PRINTL 　　　　더 이상 수정할 수 없다.
		ENDIF
		PRINTL [999] 신경 쓰지 마
		INPUT
		SELECTCASE RESULT
			CASE 999
				RETURN
			CASE 1
				IF !GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser) && MONEY >= nChainSawModsCost:0
					PRINTL 체인소 운용 시 피로도가 줄어든다!
					SETBIT nChainSawMods, ChainSaw_MiniFanDispenser, 0
					TIME += 15
					CALL PAY_MONEY_YEN(nChainSawModsCost:0, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 2
				IF !GETBIT(nChainSawMods, ChainSaw_DualSaw) && MONEY >= nChainSawModsCost:1
					PRINTL 나무를 베는 데 걸리는 시간과 노력이 줄어들었다!
					SETBIT nChainSawMods, ChainSaw_DualSaw
					TIME += 10
					CALL PAY_MONEY_YEN(nChainSawModsCost:1, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 3
				IF !GETBIT(nChainSawMods, ChainSaw_KickBack) && MONEY >= nChainSawModsCost:2
					PRINTL 더 큰 나무를 자를 때 난이도가 감소한다!
					SETBIT nChainSawMods, ChainSaw_KickBack
					TIME += 30
					CALL PAY_MONEY_YEN(nChainSawModsCost:2, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 4
				IF !GETBIT(nChainSawMods, ChainSaw_TreeSeeker) && MONEY >= nChainSawModsCost:3
					PRINTL 더 좋은 나무를 훨씬 쉽게 찾을 수 있게 된다!
					PRINTL 크기도 더 커져서 나올 것이다.
					PRINTL 어떤 이들은 심지어 스스로를 더 강하게 만드는 데 도움이 될 수도 있다고 한다...
					SETBIT nChainSawMods, ChainSaw_TreeSeeker
					TIME += 60
					CALL PAY_MONEY_YEN(nChainSawModsCost:3, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 5
				IF !GETBIT(nChainSawMods, ChainSaw_Flashlight) && MONEY >= nChainSawModsCost:4
					PRINTL 이제 밤에도 나무를 벨 수 있게 되었다!
					SETBIT nChainSawMods, ChainSaw_Flashlight
					TIME += 10
					CALL PAY_MONEY_YEN(nChainSawModsCost:4, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 6
				IF nItemMod == 0
					IF !GETBIT(nChainSawMods, ChainSaw_MiniFanDispenser) && MONEY >= nChainSawModsCost:0
						PRINTL 미니팬&워터 디스펜서가 설치되었다!
						PRINTL 체인톱을 작동할 때 피로도가 줄어든다!
						SETBIT nChainSawMods, ChainSaw_MiniFanDispenser, 0
						TIME += 15
						CALL PAY_MONEY_YEN(nChainSawModsCost:0, 2)
						PRINTL
					ENDIF
					IF !GETBIT(nChainSawMods, ChainSaw_DualSaw) && MONEY >= nChainSawModsCost:1
						PRINTL 더블 톱이 설치되었다!
						PRINTL 나무를 자르는 데 걸리는 시간과 노력이 줄어들 것이다!
						SETBIT nChainSawMods, ChainSaw_DualSaw
						TIME += 10
						CALL PAY_MONEY_YEN(nChainSawModsCost:1, 2)
						PRINTL
					ENDIF
					IF !GETBIT(nChainSawMods, ChainSaw_KickBack) && MONEY >= nChainSawModsCost:2
						PRINTL 회전 반경 감쇠기 설치 완료!
						PRINTL 더 큰 나무를 자를 때 난이도가 감소한다!
						SETBIT nChainSawMods, ChainSaw_KickBack
						TIME += 30
						CALL PAY_MONEY_YEN(nChainSawModsCost:2, 2)
						PRINTL
					ENDIF
					IF !GETBIT(nChainSawMods, ChainSaw_TreeSeeker) && MONEY >= nChainSawModsCost:3
						PRINTL 트리 시커가 설치되었다!
						PRINTL 그들은 크기도 더 커질 것이다.
						PRINTL 어떤 이들은 그것이 당신 자신을 더 잘 강하게 만드는 데 도움을 줄 수도 있다고 말한다...
						SETBIT nChainSawMods, ChainSaw_TreeSeeker
						TIME += 60
						CALL PAY_MONEY_YEN(nChainSawModsCost:3, 2)
						PRINTL
					ENDIF
					IF !GETBIT(nChainSawMods, ChainSaw_Flashlight) && MONEY >= nChainSawModsCost:4
						PRINTL 손전등 설치 완료!
						PRINTL 이제 밤에도 나무를 베게 된다!
						SETBIT nChainSawMods, ChainSaw_Flashlight
						TIME += 10
						CALL PAY_MONEY_YEN(nChainSawModsCost:4, 2)
						PRINTL
					ENDIF
				ELSE
					RETURN
				ENDIF
		ENDSELECT
		LOOP 1
	CASE GETNUM(ITEM, "釣り竿") ;fishing rod, from Korean version
		SIF !ITEM:釣り竿
			RETURN
		LOCAL:99 = LINECOUNT
		DO
		SIF LINECOUNT - LOCAL:99 > 0
			CLEARLINE LINECOUNT - LOCAL:99
		nItemMod = GETBIT(nFishingRodMods, FishingRod_Vibration) && GETBIT(nFishingRodMods, FishingRod_Multihook) && GETBIT(nFishingRodMods, FishingRod_Sonar) && GETBIT(nFishingRodMods, FishingRod_Harness)
		;set initial sum
		nCostSum = nFishingRodModsCost:0 + nFishingRodModsCost:1 + nFishingRodModsCost:2 + nFishingRodModsCost:3
		;see if other upgrades purchased
		nCostSum -= GETBIT(nFishingRodMods, FishingRod_Vibration) * nFishingRodModsCost:0
		nCostSum -= GETBIT(nFishingRodMods, FishingRod_Multihook) * nFishingRodModsCost:1
		nCostSum -= GETBIT(nFishingRodMods, FishingRod_Sonar) * nFishingRodModsCost:2
		nCostSum -= GETBIT(nFishingRodMods, FishingRod_Harness) * nFishingRodModsCost:3
		DRAWLINE
		CALL SPTALK, [[にとり]], "笑顔", 0, @"「어떻게 바꾸고 싶으신가요?」", 1
		PRINTD 현재 상태: 
		CALL Add_ItemModList_釣り竿
		PRINTL
		DRAWLINE
		IF !GETBIT (nFishingRodMods, FishingRod_Vibration)
			PRINTFORML [  1] - 조정된 진동(¥{nFishingRodModsCost:0}) : 주변에 움직이는 물고기를 자동으로 지시하여 잡을 확률을 증가시킨다.
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 조정된 진동: 낚시력을 약간 증가시킨다.
			RESETCOLOR
		ENDIF
		IF !GETBIT (nFishingRodMods, FishingRod_Multihook)
			PRINTFORML [  2] - 멀티훅 (¥{nFishingRodModsCost:1}): 갈고리 수를 늘려 낚시 확률을 증가시킨다
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 멀티훅: 낚시 능력을 적당히 증가시킨다
			RESETCOLOR
		ENDIF
		IF !GETBIT (nFishingRodMods, FishingRod_Sonar)
			PRINTFORML [  3] - 소나(Sonar) (¥{nFishingRodModsCost:2}): 멀리 있는 물고기의 소리를 감지하고 자동으로 자신을 이동시켜 그것을 잡는다.
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - 소나: 낚시력을 크게 증가시킨다.
			RESETCOLOR
		ENDIF
		IF CFLAG:[[わかさぎ姫]]:2 >= 3000 ;3000 favor check for wakasagihime
			IF !GETBIT (nFishingRodMods, FishingRod_Harness)
				PRINTFORML [  4] [ 4] - 미인공어용 하네스(¥{nFishingRodModsCost:3}): 와카사기히메가 제공한 재료로 만든 맞춤형 하네스
			ELSE
				SETCOLOR C_GRAY
				PRINTL [ X ] - 머메이드 피싱 하네스: 낚시력을 크게 증가시킨다
				RESETCOLOR
			ENDIF
		ELSE
			SETCOLOR C_GRAY
			PRINTL [ X ] - ??????: 어떤 인어의 호의를 얻는다면 어쩌면...
			RESETCOLOR
		ENDIF
		IF nItemMod == 0
			PRINTFORML [  5] 전부 추가한다 (총 ¥{nCostSum})
		ELSE
			PRINTL 　　　　더 이상 수정할 수 없다.
		ENDIF
		PRINTL [999] 신경 쓰지 마라
		INPUT
		SELECTCASE RESULT
			CASE 999
				RETURN
			CASE 1
				IF !GETBIT (nFishingRodMods, FishingRod_Vibration) && MONEY >= nFishingRodModsCost:0
					PRINTL 낚싯대에 진동이 추가되었다!
					SETBIT nFishingRodMods, 0
					TIME += 5
					CALL PAY_MONEY_YEN(nFishingRodModsCost:0, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 2
				IF !GETBIT (nFishingRodMods, FishingRod_Multihook) && MONEY >= nFishingRodModsCost:1
					PRINTL 여러 개의 갈고리가 추가되었다!
					SETBIT nFishingRodMods, 1
					TIME += 10
					CALL PAY_MONEY_YEN(nFishingRodModsCost:1, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 3
				IF !GETBIT (nFishingRodMods, FishingRod_Sonar) && MONEY >= nFishingRodModsCost:2
					PRINTL 소형 소나를 낚싯대에 부착했다!
					SETBIT nFishingRodMods, 2
					TIME += 15
					CALL PAY_MONEY_YEN(nFishingRodModsCost:2, 2)
				ELSE
					CONTINUE
				ENDIF
			CASE 4
				IF CFLAG:[[わかさぎ姫]]:2 >= 3000 ;favor check
					IF !GETBIT (nFishingRodMods, FishingRod_Harness) && MONEY >= nFishingRodModsCost:3
						CALL KOJO_MESSAGE_SEND("EVENT", 0, 93, 0, 0, "FISHINGHARNESS_BUY") ;custom code waggy
						PRINTL 낚싯대에 맞춤 제작된 낚시 하네스가 장착되었다!
						SETBIT nFishingRodMods, 3
						TIME += 20
						CALL PAY_MONEY_YEN(nFishingRodModsCost:3, 2)
					ELSE
						CONTINUE
					ENDIF
				ENDIF
			CASE 5
				IF nItemMod == 0
					IF !GETBIT (nFishingRodMods, FishingRod_Vibration) && MONEY >= nFishingRodModsCost:0
						PRINTL 낚싯대에 진동이 추가되었다!
						SETBIT nFishingRodMods, 0
						TIME += 5
						CALL PAY_MONEY_YEN(nFishingRodModsCost:0, 2)
						PRINTL
					ENDIF
					IF !GETBIT (nFishingRodMods, FishingRod_Multihook) && MONEY >= nFishingRodModsCost:1
						PRINTL 여러 개의 갈고리가 추가되었다!
						SETBIT nFishingRodMods, 1
						TIME += 10
						CALL PAY_MONEY_YEN(nFishingRodModsCost:1, 2)
						PRINTL
					ENDIF
					IF !GETBIT (nFishingRodMods, FishingRod_Sonar) && MONEY >= nFishingRodModsCost:2
						PRINTL 작은 소나 장치가 낚싯대에 부착되었다!
						SETBIT nFishingRodMods, 2
						TIME += 15
						CALL PAY_MONEY_YEN(nFishingRodModsCost:2, 2)
						PRINTL
					ENDIF
					IF CFLAG:[[わかさぎ姫]]:2 >= 3000 ;favor check
						IF !GETBIT (nFishingRodMods, FishingRod_Harness) && MONEY >= nFishingRodModsCost:3
							CALL KOJO_MESSAGE_SEND("EVENT", 0, 93, 0, 0, "FISHINGHARNESS_BUY") ;custom code waggy
							PRINTL 낚싯대에 맞춤 제작된 낚시 하네스가 장착되었습니다!
							SETBIT nFishingRodMods, 3
							TIME += 20
							CALL PAY_MONEY_YEN(nFishingRodModsCost:3, 2)
							PRINTL
						ENDIF
					ENDIF
				ENDIF
		ENDSELECT
		LOOP 1
ENDSELECT
