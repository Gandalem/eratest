#LOCALSIZE 1
#LOCALSSIZE 1

@下半身下着_ずらし可能98(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "ブリーフ")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "남성의")
		;NAS customs
	CASE "FullDesc"
		CALLF MAKE_STR(V_NAME, @"흰색 삼각팬티라고도 불리는 소년풍 브리프. 방광이 멀쩡한 사람이라면 누구나 무난하게 입을 수 있는 속옷이다. 소변기나 성관계 때 음경을 쉽게 꺼낼 수 있도록 앞쪽에 트임이 있다.")
	CASE "はける"
		SIF !RAND:(1 + (2 * 勝負下着判定(ARG)))
			CALLF MAKE_INT(V_NAME, 1)
	CASE "Unisex"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "urbworld/white/masculine/brief/washable/")
		;///////////////
	CASE "透ける"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "着せ替え可能"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "透ける(前)"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "透ける(後)"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "SHIFTABLE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@EXIST_下半身下着_ずらし可能40
#LOCALSIZE 1
#LOCALSSIZE 1

@下半身下着_ずらし可能40(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "玉パンツ")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "그녀의 클리토스와 보지를 끊임없이 비비는")
	CASE "透ける(前)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "透ける(後)"
		CALLF MAKE_INT(V_NAME, 0)
		;NAS customs
	CASE "FullDesc"
		CALLF MAKE_STR(V_NAME, @"구슬을 엮어 만든 팬티. 화려한 구슬이 성적 매력을 한껏 돋우며, 입은 사람이 움직일 때마다 흔들리고 소리를 내 존재감을 드러낸다.")
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "efun/black/feminine/panty/sex toy/plain/washable/")
		;/////////////////////
	CASE "はける"
		IF !FLAG:セクシーパンツ追加
			CALLF MAKE_INT(V_NAME, 0)
		ELSEIF HAS_PENIS(ARG)
			CALLF MAKE_INT(V_NAME, 0)
		ELSEIF TALENT:ARG:ヤリマン
			CALLF MAKE_INT(V_NAME, 1)
		ELSEIF TALENT:ARG:無知 && !(TALENT:ARG:小悪魔 || TALENT:ARG:淫乱)
			CALLF MAKE_INT(V_NAME, 0)
		ELSEIF !TALENT:ARG:愛欲 && !TALENT:ARG:淫乱 && !(TALENT:ARG:小悪魔 && TALENT:ARG:恋慕)
			CALLF MAKE_INT(V_NAME, 0)
		ELSEIF ABL:ARG:露出癖 < 10
			CALLF MAKE_INT(V_NAME, 0)
		ELSE
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "コレクション表示可能"
		IF !FLAG:セクシーパンツ追加
			CALLF MAKE_INT(V_NAME, 0)
		ELSEIF !(TALENT:ARG:恋慕 && !(TALENT:ARG:小悪魔 || TALENT:ARG:淫乱)) && !TALENT:ARG:無知 && !HAS_PENIS(ARG)
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "コレクション解禁条件"
		IF TALENT:ARG:ヤリマン
		ELSEIF TALENT:ARG:小悪魔 && !TALENT:ARG:恋慕 && !TALENT:ARG:愛欲 && !TALENT:ARG:淫乱
			CALLF MAKE_STR(V_NAME, "Req: Love/Lust")
		ELSEIF !TALENT:ARG:愛欲 && !TALENT:ARG:淫乱 && !(TALENT:ARG:小悪魔 && TALENT:ARG:恋慕)
			CALLF MAKE_STR(V_NAME, "Req: Lust")
		ELSEIF ABL:ARG:露出癖 < 10
			CALLF MAKE_STR(V_NAME, "Req: Exposure 10")
		ENDIF
	CASE "SHIFTABLE"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "STRING_FRONT"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "STRING_BACK"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@下半身下着_ずらし可能40_SOURCE(ARG)
SOURCE:ARG:液体 += TIME_PROGRESS(TIME:1) * 2
SOURCE:ARG:欲情 += TIME_PROGRESS(TIME:1) * 2
SOURCE:ARG:露出 += TIME_PROGRESS(TIME:1) * 2
