@EXIST_衣装セット99
#LOCALSIZE 1
#LOCALSSIZE 1

@衣装セット99(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "浴衣セット")
	CASE "基本衣装セット"
		CALLF MAKE_INT(V_NAME, 1)
		;こっから衣装設定系
	CASE "着物"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("着物", "浴衣"))
	CASE "靴"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "下駄"))
	CASE "靴下"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
ENDSELECT

