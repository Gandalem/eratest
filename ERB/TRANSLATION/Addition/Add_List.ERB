; Modular ERB: Addition/Add_List.ERB
;Functions for the convenient handling of lists.
;Lists have to be global DIM arrays. Their names are passed as strings with the final dimension argument omitted.

@LIST_SIZE(List,ArraySize=-1)
;Returns the number of successive non-empty entries in a one-dimensional string array.
#FUNCTION
#DIMS DYNAMIC List
#DIM DYNAMIC ArraySize
SIF ArraySize < 0
	ArraySize = VARSIZE(List)
FOR LOCAL,0,ArraySize
IF GETVARS(@"%List%:{LOCAL}") == ""
	RETURNF LOCAL
ENDIF
NEXT

@ADD_TO_LIST(List,Entry,Position=-1,Exclusive,ArraySize=-1)
;Adds a string entry to a given one-dimensional array at a given position.
;If the list is part of a two-dimensional array or greater, ArraySize must be provided.
;If the position is currently occupied, the current entry and all successive ones are shunted down the list to make room.
;If the array is too small to fit the last entry in the list, that entry is discarded.
;Omit Position or enter -1 to add to the end of the list. Lower negative numbers move it further up the list from the end.
;If Exclusive is 1, the entry will only be added if it does not already exist in the list.
;Returns the position of the entry if the entry was added, or -1 otherwise.
#FUNCTION
#DIMS DYNAMIC List
#DIMS DYNAMIC Entry
#DIM DYNAMIC Position
#DIM DYNAMIC Exclusive
#DIM DYNAMIC ArraySize
#DIM DYNAMIC ListSize
SIF ArraySize < 0
	ArraySize = VARSIZE(List)
IF Exclusive
	FOR LOCAL,0,ArraySize
	SIF GETVARS(@"%List%:{LOCAL}") == Entry
		RETURNF -1
	NEXT
ENDIF
ListSize = LIST_SIZE(List,ArraySize)
SIF Position < 0
	Position = MAX(ListSize+Position+1,0)
LOCAL = ListSize
WHILE LOCAL >= Position
SIF ArraySize > LOCAL+1
	SETVAR @"%List%:{LOCAL+1}",GETVARS(@"%List%:{LOCAL}")
SETVAR @"%List%:{LOCAL}",""
LOCAL--
WEND
IF ArraySize > Position
	SETVAR @"%List%:{Position}",Entry
	RETURNF Position
ENDIF
RETURNF -1

@REMOVE_FROM_LIST(List,Position=-1,ArraySize=-1)
;Removes a string entry from a given one-dimensional array at a given position.
;If the list is part of a two-dimensional array or greater, ArraySize must be provided.
;If there are other successive entries after it, they are all moved up the list to occupy the space left behind.
;Omit Position to remove the last entry.
#FUNCTION
#DIMS DYNAMIC List
#DIM DYNAMIC Position
#DIM DYNAMIC ArraySize
#DIM DYNAMIC ListSize
SIF ArraySize < 0
	ArraySize = VARSIZE(List)
ListSize = LIST_SIZE(List,ArraySize)
SIF Position < 0
	Position = MAX(ListSize-1,0)
FOR LOCAL,Position,ListSize
IF ArraySize > LOCAL+1
	SETVAR @"%List%:{LOCAL}",GETVARS(@"%List%:{LOCAL+1}")
	SETVAR @"%List%:{LOCAL+1}",""
ELSE
	SETVAR @"%List%:{LOCAL}",""
ENDIF
NEXT

@LIST_POSITION(List,Entry,ArraySize=-1)
;Returns the position of the first instance of a given entry in a one-dimensional string array, or -1 if none are found.
#FUNCTION
#DIMS DYNAMIC List
#DIMS DYNAMIC Entry
#DIM DYNAMIC ArraySize
SIF ArraySize < 0
	ArraySize = LIST_SIZE(List,ArraySize)
FOR LOCAL,0,ArraySize
SIF GETVARS(@"%List%:{LOCAL}") == Entry
	RETURNF LOCAL
NEXT
RETURNF -1

@LIST_SIZE_INT(List,ArraySize=-1,EmptyValue)
;Returns the number of successive entries not equal to the empty value in a one-dimensional integer array.
;For example, if a value if 0 is meaningful in the list, use an empty value of -1, ensuring the array has defaulted to -1.
#FUNCTION
#DIMS DYNAMIC List
#DIM DYNAMIC ArraySize
#DIM DYNAMIC EmptyValue
SIF ArraySize < 0
	ArraySize = VARSIZE(List)
FOR LOCAL,0,ArraySize
IF GETVAR(@"%List%:{LOCAL}") == EmptyValue
	RETURNF LOCAL
ENDIF
NEXT

