; Modular ERB: Addition/Add_RedThread.ERB
;from KR version

@Add_RedThread
DEBUGPRINTFORML ---------------------
DEBUGPRINTFORML 빨간 실 확인
DEBUGPRINTFORML ---------------------
IF TALENT:MASTER:あかいと && Add_RedThread_Chance(TARGET) && RELATION:TARGET:MASTER < 1000
	CALL COLORMESSAGE(@"운명의 빨간 실이 밝게 빛난다!",C_P_PURPLE, 1, 1)
	CALL COLORMESSAGE(@"%조사처리(CALLNAME:TARGET,"는")% 당신에게서 %HIS_HER(TARGET)% 운명의 부름을 느낀 것 같다...",C_PINK, 1)
	CALL COLORMESSAGE(@"(친밀도 증가!)",C_YELLOW, 2)
	SIF !RELATION:TARGET:MASTER
		RELATION:TARGET:MASTER = 100
	RELATION:TARGET:MASTER += 10
	SIF !RELATION:MASTER:TARGET
		RELATION:MASTER:TARGET = 100
	RELATION:MASTER:TARGET += 10
ENDIF

@Add_RedThread_Proc
SIF TARGET <= 0
	RETURN
SIF !SHIRAHU(TARGET)
	RETURN
IF FLAG:デート相手 == TARGET && CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	IF (IS_SELECTCOM("会話/スキンシップ/謝る/頭を撫でる/抱き付く/キスする/スカートをめくる/手を繋ぐ/寄り道する/食事に誘う/食材の買い出し/お弁当を食べる/甘味処へ誘う") || GROUPMATCH(TFLAG:50, 62, 63)) && TFLAG:193 == 1 ;critical success, on a date
		CALL Add_RedThread
	ELSEIF IS_SELECTCOM("釣りをする") && !RAND:20 ;fishing doesn't set tflag, so
		CALL Add_RedThread
	ENDIF
ENDIF
;check if the bonus was received for the old reward, unlock the replacement

@EVENTLOAD
SIF TALENT:MASTER:ポリアモリー && !TALENT:MASTER:あかいと
	CLEARBIT FLAG:好感度ボーナス取得状況, 8
;preserve bonus for reset characters
FOR LOCAL, 1, CHARANUM
SIF RELATION:MASTER:LOCAL
	RELATION:LOCAL:MASTER = RELATION:MASTER:LOCAL
NEXT

@Add_RedThread_Check
FOR LOCAL, 1, CHARANUM
IF RELATION:MASTER:LOCAL
	CALL COLORMESSAGE(@"친밀도 보너스를 다시 적용하려면 저장 후 불러오세요!",C_YELLOW, 2, 1)
	BREAK
ENDIF
NEXT

@Add_RedThread_Chance(ARG)
#FUNCTION
SELECTCASE RELATION:ARG:MASTER
	CASE IS < 150
		LOCAL = 10
	CASE IS < 200
		LOCAL = 15
	CASEELSE
		LOCAL = 20
ENDSELECT
RETURNF !RAND:LOCAL
