@ADD_CUSTOM_UNDERWEAR_CHECK
FOR LOCAL, 1, CHARANUM
    CALL ADD_CUSTOM_UNDERWEAR_CHECK_CHARA(LOCAL)
NEXT

@ADD_CUSTOM_UNDERWEAR_CHECK_CHARA(ARG)
VARSET CUSTOM_PANTY_EXISTS:ARG:0, 0
VARSET CUSTOM_PANTY_NAME:ARG:0, ""
VARSET CUSTOM_PANTY_DESCRIPTION:ARG:0, ""
VARSET CUSTOM_PANTY_OPTIONS:ARG:0, 0
VARSET CUSTOM_PANTY_DAILY_JUDGMENT:ARG:0, 0
VARSET CUSTOM_PANTY_MATCHING_BRA:ARG:0, 0
VARSET CUSTOM_PANTY_COLLECTION_DISPLAY:ARG:0, 0
VARSET CUSTOM_PANTY_COLLECTION_UNLOCK_TEXT:ARG:0, ""
VARSET CUSTOM_BRA_EXISTS:ARG:0, 0
VARSET CUSTOM_BRA_NAME:ARG:0, ""
VARSET CUSTOM_BRA_DAILY_JUDGMENT:ARG:0, 0
VARSET CUSTOM_BRA_FABRIC_THICKNESS:ARG:0, 0

CALL KOJO_CHECK(ARG, "PANTIES")


;custom panties
@ADD_CUSTOM_PANTY_DATA(ARG, O_DATA, V_NAME, CUSTOM_INDEX)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM  CUSTOM_INDEX
SIF !INRANGE(ARG,0,CHARANUM) || !CHARANUM
    RETURNF
SELECTCASE O_DATA
CASE "描写"
    IF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_STR(V_NAME, CUSTOM_PANTY_DESCRIPTION:ARG:CUSTOM_INDEX)
    ELSE
	    CALLF MAKE_STR(V_NAME, @"impossible to describe")
    ENDIF
CASE "透ける(前)"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 0))
CASE "透ける(後)"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 1))
CASE "はける"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, CUSTOM_PANTY_DAILY_JUDGMENT:ARG:CUSTOM_INDEX)
CASE "関連下着"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, CUSTOM_PANTY_MATCHING_BRA:ARG:CUSTOM_INDEX)
CASE "コレクション表示可能"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, CUSTOM_PANTY_COLLECTION_DISPLAY:ARG:CUSTOM_INDEX)
CASE "コレクション解禁条件"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX && STRLENS(CUSTOM_PANTY_COLLECTION_UNLOCK_TEXT:ARG:CUSTOM_INDEX)
	    CALLF MAKE_STR(V_NAME, CUSTOM_PANTY_COLLECTION_UNLOCK_TEXT:ARG:CUSTOM_INDEX)


;added attributes
CASE "SHIFTABLE"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 2))
CASE "PASTIES"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 3))
CASE "ZIPPABLE_FRONT"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 4))
CASE "ZIPPABLE_BACK"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 5))
CASE "HOLE_FRONT"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 6))
CASE "HOLE_BACK"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 7))
CASE "STRING_FRONT"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 8))
CASE "STRING_BACK"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 9))
CASE "NOTHING_FRONT"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 10))
CASE "NOTHING_BACK"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 11))
CASE "TIED"
    SIF CUSTOM_PANTY_EXISTS:ARG:CUSTOM_INDEX
	    CALLF MAKE_INT(V_NAME, GETBIT(CUSTOM_PANTY_OPTIONS:ARG:CUSTOM_INDEX, 12))
ENDSELECT

