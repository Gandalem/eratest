	SIF OUTCOME == 2
		RETURN
	IF OUTCOME == 0
		PRINTFORML 사소한 일로 여자들에게 화를 냈던 때들을 기억하며, 다시는 그런 일이 일어나지 않도록 다짐한다!
		PRINTFORML 무릎을 꿇고 %CALLNAME:ARG%에게 연신 사과하며, %HIS_HER(ARG)%의 동정심에 호소한다!
	ELSE
		PRINTFORML 당신은 집중하고, %CALLNAME:ARG%의 눈을 응시하며, 자신이 한 일이 정말로 화낼 가치가 없다고 단호한 목소리로 %HIM_HER(ARG)%에게 말한다.
		CALL PROCESS_HYPNOSIS_COMMAND(0, ARG)
		IF RESULT < 0
			PRINTFORML …유감스럽게도, 작동하지 않았다.
			RETURN 0
		ENDIF
	ENDIF
	PRINTFORML
	;気弱系
	IF CFLAG:ARG:性格傾向 == 1
		PRINTFORML %HE_SHE(ARG,1)%은 당황하며, %HIS_HER(ARG)% 얼굴이 귀까지 올라오는 홍조로 달아오르며 당신에게 일어나라고 재촉한다.
		PRINTFORML 당신은 %HE_SHE(ARG)%가 용서해 줄 때까지 거부했고, 잠시 후 %HE_SHE(ARG)%는 마침내 물러선다.
		;強気系
	ELSEIF CFLAG:ARG:性格傾向 == 2
		PRINTFORML %HE_SHE(ARG,1)%은 당신의 터무니없는 행동에 똑같이 불쾌해하는 듯했지만, %HE_SHE(ARG)%가 당신의 고집을 이길 수 없음을 깨닫고 결국 굴복한다.
		;素直系
	ELSEIF CFLAG:ARG:性格傾向 == 3
		PRINTFORML %HIS_HER(ARG,1)%의 눈이 커지며 당신이 그런 일을 할 거라고는 예상하지 못했다.
		PRINTFORML %HE_SHE(ARG,1)%은 농담으로 그것을 무마하며 결국 별일 아니었다고 인정한다.
		;真面目系
	ELSEIF CFLAG:ARG:性格傾向 == 4
		PRINTFORML %HE_SHE(ARG,1)%은(는) 당신을 일으켜 주면서, 이 정도의 사소한 일에 빌 가치가 없다고 말하기 전에 약간 꾸짖는다.
		;その他
	ELSEIF CFLAG:ARG:性格傾向 == 5
		PRINTFORML %BREAKENG(@"%HE_SHE(ARG,1)%처음에는 무슨 일이 일어나는지 이해하지 못하는 것 같지만, %HE_SHE(ARG)%가 당신이 얼마나 전념하고 진지한지를 보게 되면, %HE_SHE(ARG)%는 당신을 용서하기로 결정한다.")%
	ENDIF
	WAIT
	PRINTFORML
	PRINTFORML %CALLNAME:ARG%의 Lv1 증오의 낙인이 제거되었다!
	PRINTFORMW 휴... 위기는 모면했다!
	CALLF CALMME(ARG)
	IF OUTCOME == 0 ;custom code
		hmf_HeartFeltApologyUsed = 1
		TFLAG:反発刻印取得 = -1
