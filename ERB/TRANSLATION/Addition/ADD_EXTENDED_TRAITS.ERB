; Modular ERB: Addition/ADD_EXTENDED_TRAITS.ERB

@EVENTLOAD
#LATER
CALL ADD_EXTENDED_TRAITS_SET_ALL

@ADD_EXTENDED_TRAITS_SET_ALL
FOR LOCAL, 1, CHARANUM
TRYCALLFORM ADD_EXTENDED_TRAITS_SET_{NO:LOCAL}(LOCAL)
NEXT

@ADD_EXTENDED_TRAIT_力持ち(ARG, ARG:1)
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 0)
	RETURN
TALENT:ARG:力持ち = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 0

@ADD_EXTENDED_TRAIT_体型(ARG, ARG:1)
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 1)
	RETURN
SIF TALENT:ARG:体型 == CSVTALENT(NO:ARG, GETNUM(TALENT, "体型"))
	TALENT:ARG:体型 = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 1

@ADD_EXTENDED_TRAIT_バストサイズ(ARG, ARG:1)
