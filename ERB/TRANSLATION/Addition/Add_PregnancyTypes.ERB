@PREGNANCY_TYPE_OPTIONS
#DIM DYNAMIC STARTLINECOUNT,2
#DIM DYNAMIC MANUAL_CHARA_RESULT
#DIM CONST COLOR_NORMAL = 0x6A7783 ; Gray
#DIM CONST COLOR_LITTERS = 0x03B484 ; Green
#DIM CONST COLOR_EGG_LAYERS = 0xD55E00 ; Orange
#DIM CONST COLOR_CLUTCHERS = 0xF0E442 ; Yellow
	;Pregnancy type settings menu, accessible through new game or modded options.
STARTLINECOUNT:0 = LINECOUNT
$TOP
CLEARLINE LINECOUNT - STARTLINECOUNT:0
PRINTFORMDL
CALL D_LINE
PRINTFORMDL
PRINTFORMDL [0] Set character pregnancy types
PRINTFORMDL
PRINTFORMDL [1] Child support relief for litter and clutch characters: \@ FLAG:CHILD_SUPPORT_RELIEF ? ON # OFF \@
PRINTFORMDL [2] Special pregnancy types for mob characters: \@ FLAG:MOB_PREGNANCY_TYPES ? ON # OFF \@
PRINTFORMDL
PRINTFORMDL [3] Eggnancy: \@ FLAG:EGGNANCY ? ON # OFF \@
PRINTFORMDL [4] Chance for twins: {FLAG:TWINS_CHANCE}\%
PRINTFORMDL [5] Chance for triplets: {FLAG:TRIPLETS_CHANCE}\%
PRINTFORMDL
PRINTFORMDL [6] Explanation
PRINTFORMDL
PRINTFORMDL [7] Restore default settings
PRINTFORMDL [8] Disable all
PRINTFORMDL
PRINTFORMDL [9] Return
INPUT
SELECTCASE RESULT
	CASE 0
		STARTLINECOUNT:1 = LINECOUNT
		$MANUALSETTING
		CLEARLINE LINECOUNT - STARTLINECOUNT:1
		PRINTFORMDL
		SIF FLAG:並び替え
			CALL CHARASORT_EX
		FOR LOCAL:2, 1, EX_CHARANUM + 1
			IF FLAG:並び替え
				LOCAL:1 = RESULT:(LOCAL:2)
				SIF LOCAL:1 < 0
					CONTINUE
			ELSE
				LOCAL:1 = LOCAL:2
				SIF LOCAL:1 >= CHARANUM
					BREAK
			ENDIF
			SIF CFLAG:(LOCAL:1):出禁
				CONTINUE
			SIF !IS_FEMALE(LOCAL:1)
				CONTINUE
			SELECTCASE TALENT:(LOCAL:1):PREGNANCY_TYPE
				CASE PREGNANCY_LITTERS
					SETCOLOR COLOR_LITTERS
				CASE PREGNANCY_EGGS
					SETCOLOR COLOR_EGG_LAYERS
				CASE PREGNANCY_CLUTCH
					SETCOLOR COLOR_CLUTCHERS
				CASEELSE
					SETCOLOR COLOR_NORMAL
			ENDSELECT
			PRINTFORMLC [{LOCAL:1, 3}] %CALLNAME:(LOCAL:1)%
			RESETCOLOR
		NEXT
		PRINTFORML 
		DRAWLINE
		PRINTFORMD Legend: 
		CALL COLORMESSAGE("Normal   ", COLOR_NORMAL, 0)
		CALL COLORMESSAGE("Litters   ", COLOR_LITTERS, 0)
		CALL COLORMESSAGE("Egg Layers  ", COLOR_EGG_LAYERS, 0)
		CALL COLORMESSAGE("Clutch Layers", COLOR_CLUTCHERS, 0)
		PRINTL
		PRINTL
		PRINTBUTTON "[Normal for all]", 980
		PRINT   
		PRINTBUTTON "[Litters for all]", 981
		PRINT   
		PRINTBUTTON "[Eggs for all]", 982
		PRINT   
		PRINTBUTTON "[Clutches for all]", 983
		PRINTL
		PRINTBUTTON "[No litters]", 984
		PRINT   
		PRINTBUTTON "[No eggs]", 985
		PRINTL
		PRINTBUTTON "[Litters for normal]", 986
		PRINT   
		PRINTBUTTON "[Clutchers lay one egg at a time]", 987
		PRINT   
		PRINTBUTTON "[All egg layers lay clutches]", 988
		PRINTL
		PRINTBUTTON "[Reset all to default]", 989
		PRINTL
		PRINTL
		PRINTFORML [999] Return
		INPUT
		LOCAL:1 = RESULT
		SIF LOCAL:1 == 999
			GOTO TOP
		IF INRANGE(LOCAL:1,1,CHARANUM)
			MANUAL_CHARA_RESULT = LOCAL:1
			LOCAL:1 = 1
		ENDIF
		SELECTCASE LOCAL:1
			CASE 1
				IF !IS_FEMALE(MANUAL_CHARA_RESULT)
					PRINTFORMDW %CALLNAME:MANUAL_CHARA_RESULT% is not female.
					GOTO MANUALSETTING
				ENDIF
				CLEARLINE 1
				PRINTL 
				SELECTCASE TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE
					CASE PREGNANCY_NORMAL
						PRINTFORMDL %CALLNAME:MANUAL_CHARA_RESULT% currently has normal pregnancies.
					CASE PREGNANCY_LITTERS
						PRINTFORMDL %CALLNAME:MANUAL_CHARA_RESULT% currently has litters.
					CASE PREGNANCY_EGGS
						PRINTFORMDL %CALLNAME:MANUAL_CHARA_RESULT% currently lays eggs.
					CASE PREGNANCY_CLUTCH
						PRINTFORMDL %CALLNAME:MANUAL_CHARA_RESULT% currently lays clutches of eggs.
				ENDSELECT
				FOR LOCAL, 0, 4
					SIF TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE == LOCAL
						SETCOLOR 50,50,50
					PRINTFORM [\@ TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE == LOCAL ? X # {LOCAL} \@] 
					SELECTCASE LOCAL
						CASE PREGNANCY_NORMAL
							PRINTFORML Make her have normal pregnancies
						CASE PREGNANCY_LITTERS
							PRINTFORML Make her have litters
						CASE PREGNANCY_EGGS
							PRINTFORML Make her lay eggs
						CASE PREGNANCY_CLUTCH
							PRINTFORML Make her lay clutches of eggs
					ENDSELECT
					RESETCOLOR
				NEXT
				PRINTFORMDL
				PRINTFORMDL [4] Return
				$LOOP2
				INPUT
				SELECTCASE RESULT
					CASE 0
						TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE = PREGNANCY_NORMAL
						PRINTFORMDW %CALLNAME:MANUAL_CHARA_RESULT% will now have single live births, with a chance for twins or triplets.
					CASE 1
						TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE = PREGNANCY_LITTERS
						PRINTFORMDW %CALLNAME:MANUAL_CHARA_RESULT% will now have multiple live births from a single impregnation.
					CASE 2
						TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE = PREGNANCY_EGGS
						PRINTFORMDW %CALLNAME:MANUAL_CHARA_RESULT% will now lay eggs.
					CASE 3
						TALENT:MANUAL_CHARA_RESULT:PREGNANCY_TYPE = PREGNANCY_CLUTCH
						PRINTFORMDW %CALLNAME:MANUAL_CHARA_RESULT% will now lay multiple fertilized eggs at a time from a single impregnation.
					CASE 4
					CASEELSE
						GOTO LOOP2
				ENDSELECT
			CASE 980
				CVARSET TALENT, GETNUM(TALENT, "PREGNANCY_TYPE"), PREGNANCY_NORMAL
				PRINTFORMDW All special pregnancies have been disabled.
			CASE 981
				CVARSET TALENT, GETNUM(TALENT, "PREGNANCY_TYPE"), PREGNANCY_LITTERS
				PRINTFORMDW All characters will now have litters.
			CASE 982
				CVARSET TALENT, GETNUM(TALENT, "PREGNANCY_TYPE"), PREGNANCY_EGGS
				PRINTFORMDW All characters will now lay eggs.
			CASE 983
				CVARSET TALENT, GETNUM(TALENT, "PREGNANCY_TYPE"), PREGNANCY_CLUTCH
				PRINTFORMDW All characters will now lay clutches.
			CASE 984
				FOR LOCAL,1,CHARANUM
					SIF TALENT:LOCAL:PREGNANCY_TYPE == PREGNANCY_LITTERS
						TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_NORMAL
				NEXT
				PRINTFORMDW Litters have been disabled.
			CASE 985
				FOR LOCAL,1,CHARANUM
					SIF GROUPMATCH(TALENT:LOCAL:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH)
						TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_NORMAL
				NEXT
				PRINTFORMDW Eggs and clutches have been disabled.
			CASE 986
				FOR LOCAL,1,CHARANUM
					SIF TALENT:LOCAL:PREGNANCY_TYPE == PREGNANCY_NORMAL
						TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_LITTERS
				NEXT
				PRINTFORMDW All characters who don't lay eggs will now have litters.
			CASE 987
				FOR LOCAL,1,CHARANUM
					SIF TALENT:LOCAL:PREGNANCY_TYPE == PREGNANCY_CLUTCH
						TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_EGGS
				NEXT
				PRINTFORMDW Clutch layers will now lay single eggs.
			CASE 988
				FOR LOCAL,1,CHARANUM
					SIF TALENT:LOCAL:PREGNANCY_TYPE == PREGNANCY_EGGS
						TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_CLUTCH
				NEXT
				PRINTFORMDW Egg layers will now lay several eggs at a time.
			CASE 989
				FOR LOCAL,1,CHARANUM
					TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_CHARA_DEFAULT(LOCAL)
				NEXT
				PRINTFORMDW All characters have been set to their default pregnancy types.
			CASEELSE
		ENDSELECT
		GOTO MANUALSETTING
	CASE 1
		IF FLAG:CHILD_SUPPORT_RELIEF
			PRINTFORMDW Characters that normally birth multiple children will now demand full child support payments.
		ELSE
			PRINTFORMDW Characters that normally birth multiple children will now demand a third as much child support per child.
		ENDIF
		FLAG:CHILD_SUPPORT_RELIEF = !FLAG:CHILD_SUPPORT_RELIEF
	CASE 2
		IF FLAG:MOB_PREGNANCY_TYPES
			PRINTFORMDW Newly generated mob characters will only have normal pregnancies.
		ELSE
			PRINTFORMDW Newly generated mob characters will now have appropriate pregnancy types.
		ENDIF
		FLAG:MOB_PREGNANCY_TYPES = !FLAG:MOB_PREGNANCY_TYPES
	CASE 3
		IF FLAG:EGGNANCY
			PRINTFORMDW Egg layers will now lay fertilized eggs after conception.
		ELSE
			PRINTFORMDW Egg layers will now carry fertilized eggs inside their bellies.
		ENDIF
		FLAG:EGGNANCY = !FLAG:EGGNANCY
	CASE 4
		PRINTFORMDL Input a new probability for twins to be conceived (0-100). Currently {FLAG:TWINS_CHANCE}\%.
		CALL INPUT_RANGE(0, 100)
		FLAG:TWINS_CHANCE = RESULT
	CASE 5
		PRINTFORMDL Input a new probability for triplets to be conceived (0-100). Currently {FLAG:TRIPLETS_CHANCE}\%.
		CALL INPUT_RANGE(0, 100)
		FLAG:TRIPLETS_CHANCE = RESULT
	CASE 6
		PRINTFORMDL
		CALL D_LINE
		PRINTFORMDL
		PRINTFORMDL These settings control how a girl gives birth when impregnated. Each setting has differences in gameplay.
		PRINTFORMDL
		PRINTFORMDL Normal - The girl becomes pregnant, and eventually gives birth to a single child, with a chance for twins or triplets.
		PRINTFORMDL Litters - Like normal, but the girl conceives 2-6 children at once.
		PRINTFORMDL Eggs - The girl lays an egg shortly after conception, and cares for it until it hatches. She can be impregnated again during this time.
		PRINTFORMDL Clutches - Like eggs, but the girl lays 2-6 eggs at once.
		PRINTFORMDL
		PRINTFORMDL An egg or clutch layer might sometimes give the player unfertilized eggs after dates with a fall state.
		PRINTFORMDL
		PRINTFORMDL The child support relief setting makes litters, twins, etc count as one child together for child support payments.
		PRINTFORMDL
		PRINTFORMDL If the eggnancy setting is on, an egg or clutch layer keeps her eggs inside of her body and becomes visibly pregnant.
		PRINTFORMDL She then lays the eggs immediately before they hatch. She will still give unfertilized eggs.
		WAIT
	CASE 7
		PRINTL
		PRINTFORMDL Reset all special pregnancy types and settings to default? This will not erase existing unborn children.
		PRINTL
		CALL ASK_YN
		IF !RESULT
			CALL PREGNANCY_TYPES_NEWGAME_SET
			FLAG:CHILD_SUPPORT_RELIEF = 1
			FLAG:MOB_PREGNANCY_TYPES = 1
			FLAG:EGGNANCY = 0
			FLAG:TWINS_CHANCE = 10
			FLAG:TRIPLETS_CHANCE = 2
		ENDIF
	CASE 8
		PRINTL
		PRINTFORMDL Disable all special pregnancy types and settings? All characters will have normal pregnancies. This will not erase existing unborn children.
		PRINTL
		CALL ASK_YN
		IF !RESULT
			FOR LOCAL,1,CHARANUM
				TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_NORMAL
			NEXT
			FLAG:MOB_PREGNANCY_TYPES = 0
			FLAG:EGGNANCY = 0
			FLAG:TWINS_CHANCE = 0
			FLAG:TRIPLETS_CHANCE = 0
		ENDIF
	CASE 9
		CALL PREGNANCY_CONVERT_TYPES
		RETURN
	CASEELSE
		GOTO TOP
ENDSELECT
GOTO TOP

@CONCEPTION_COUNT(CharacterIndex,ProgressDay=1)
	;Determine how many children should be conceived from a single impregnation.
#FUNCTION
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ProgressDay
#DIM DYNAMIC ConceptionCount
SELECTCASE TALENT:CharacterIndex:PREGNANCY_TYPE
	CASE PREGNANCY_LITTERS
			;Has Litters.
		CFLAG:CharacterIndex:妊娠経過日数 = MAX(CFLAG:CharacterIndex:妊娠経過日数,ProgressDay)
			;Usually has 3-4, with a small chance to have up to 6 or down to 2.
		ConceptionCount += RAND:2+3
		IF !RAND:10
			ConceptionCount += RAND:2+1
		ELSEIF !RAND:10
			ConceptionCount -= 1
		ENDIF
	CASE PREGNANCY_EGGS
			;Egg Layer.
		IF FLAG:EGGNANCY
				;Eggnancies are treated as regular pregnancies to work with existing functions.
			CFLAG:CharacterIndex:妊娠経過日数 = MAX(CFLAG:CharacterIndex:妊娠経過日数,ProgressDay)
		ELSE
			TALENT:CharacterIndex:NESTING = MAX(TALENT:CharacterIndex:NESTING,ProgressDay)
		ENDIF
		ConceptionCount++
	CASE PREGNANCY_CLUTCH
			;Clutch Layer.
		IF FLAG:EGGNANCY
			CFLAG:CharacterIndex:妊娠経過日数 = MAX(CFLAG:CharacterIndex:妊娠経過日数,ProgressDay)
		ELSE
			TALENT:CharacterIndex:NESTING = MAX(TALENT:CharacterIndex:NESTING,ProgressDay)
		ENDIF
		ConceptionCount += RAND:2+3
		IF !RAND:10
			ConceptionCount += RAND:2+1
		ELSEIF !RAND:10
			ConceptionCount -= 1
		ENDIF
	CASEELSE
			;Normal.
		CFLAG:CharacterIndex:妊娠経過日数 = MAX(CFLAG:CharacterIndex:妊娠経過日数,ProgressDay)
		ConceptionCount++
		IF RAND:100 < FLAG:TRIPLETS_CHANCE
			ConceptionCount += 2
		ELSEIF RAND:100 < FLAG:TWINS_CHANCE
			ConceptionCount++
		ENDIF
ENDSELECT
SIF CFLAG:CharacterIndex:WithChildCount+ConceptionCount > MAXCHILD
	ConceptionCount = MAXCHILD-CFLAG:CharacterIndex:WithChildCount
CFLAG:CharacterIndex:WithChildCount = MIN(CFLAG:CharacterIndex:WithChildCount+ConceptionCount,MAXCHILD)
RETURNF ConceptionCount

@NESTING_MESSAGE
	;Display descriptions of fertilized eggs in the rooms of nesting girls.
#DIM DYNAMIC Children
#DIMS DYNAMIC eggs
FOR LOCAL,1,CHARANUM
		;Loop through all characters.
	IF CFLAG:LOCAL:初期位置 == CFLAG:MASTER:現在位置 && TALENT:LOCAL:NESTING
			;Find if the player is in their room and they're nesting.
		IF IS_HERE(LOCAL) && SHIRAHU(LOCAL) && !CFLAG:LOCAL:睡眠 && !CFLAG:LOCAL:うふふ && !TCVAR:LOCAL:泥酔 && !CFLAG:LOCAL:イタズラ && !CFLAG:LOCAL:添い寝中
				;If they're conscious and not having sex, drunk, being molested, or in bed with the player.
			Children = CFLAG:LOCAL:WithChildCount
			eggs '= PLNOUN("egg",Children)
			PRINTFORM %CALLNAME:LOCAL% 
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML %SPLIT_G("watches over:dotes on:tends to")% %HIS_HER(LOCAL)% %eggs%.
				CASE 1
					PRINTDATAL
						DATAFORM sits over %HIS_HER(LOCAL)% %eggs% to keep %PLNOUN("it",Children)% warm.
						DATAFORM keeps %HIS_HER(LOCAL)% %eggs% warm.
						DATAFORM cradles %HIS_HER(LOCAL)% %eggs% carefully.
					ENDDATA
			ENDSELECT
		ELSEIF Children > 1
			PRINTFORMDL %CALLNAME:LOCAL% has a nest of %NUM_COUNT(Children)% eggs here.
		ELSE
			PRINTFORMDL %CALLNAME:LOCAL%'s egg is being kept warm.
		ENDIF
	ENDIF
NEXT

@CHILD_SUPPORT_COST()
	;Loop through characters and calculate child support cost based on their pregnancy type.
	;The cost is 1000 per litter if child support relief is on, or 1000 per child if not.
	;The player will not be put into debt.
#FUNCTION
#DIM DYNAMIC Cost
#DIM DYNAMIC CheckBirthday
FOR LOCAL,1,CHARANUM
	CheckBirthday = 0
	SIF !CFLAG:LOCAL:子供人数
		CONTINUE
	FOR LOCAL:1,1,MIN(CFLAG:LOCAL:子供人数+1,MAXCHILD+1)
		SIF !CHILD_BIRTHDAY:LOCAL:(LOCAL:1)
			BREAK
		SIF CHILD_INDEPENDENT:LOCAL:(LOCAL:1)
			CONTINUE
		SIF FLAG:CHILD_SUPPORT_RELIEF && CHILD_BIRTHDAY:LOCAL:(LOCAL:1) == CheckBirthday
			CONTINUE
		CheckBirthday = CHILD_BIRTHDAY:LOCAL:(LOCAL:1)
		Cost += 1000 / (1 + (FLAG:甲斐性無 > 0 && !FLAG:LUSTMODE))
	NEXT
NEXT
RETURNF MIN(Cost,MONEY)

@EGG_GIFT_DATE_CHECK(CHARA)
	;Like GIFT_DATE_CHECK, but for eggs. Only called if no regular gift is given.
#FUNCTION
#DIM CHARA
#DIM 上限
#DIM 発生率
IF FESTIVAL() == ""
	上限 = 80
ELSE
	上限 = 100
ENDIF

SIF TALENT:CHARA:行きずり
	RETURNF 0
SIF DAY == CFLAG:CHARA:LatestEggGiftDay
		;No giving twice in one day.
	RETURNF 0
SIF MARK:CHARA:反発刻印 || TALENT:CHARA:機嫌 < 0 || CFLAG:CHARA:ブチギレ
	RETURNF 0
SIF BASE:CHARA:ムード < 1200
	RETURNF 0

	;Higher chance than regular gift.
発生率 = (ABL:CHARA:親密 - 4) * 6
発生率 += MIN(CFLAG:CHARA:好感度 / 10000, 10)
;----------------------------------------------------------------
SIF FESTIVAL() != ""
	TIMES 発生率, 1.5
SIF TALENT:CHARA:恋人
	TIMES 発生率, 1.5
SIF MIN(発生率, 上限) > RAND:100
	RETURNF 1
RETURNF 0

@EGG_GIFT_DATE_EVENT(CHARA)
	;Like GIFT_DATE_EVENT, but for eggs.
#DIM CHARA
#DIM EGG
#DIM RELATIONSHIP
#DIM CONST MAX_EGG = 6

PRINTL 
PRINTFORM On the way back home from the date, %CALLNAME:CHARA% 
SELECTCASE CFLAG:CHARA:性格傾向
CASE 1
	PRINTFORM looked all fidgety as she took something out of her pocket and held it out nervously to you...
CASE 2
	PRINTFORM took a look at your face and then took out something as if remembering about it, handing it over without any hesitation...
CASE 3
	PRINTFORM suddenly took out something and handed it over, saying it was meant for you...
CASE 4
	PRINTFORM took out a carton and politely presented it to you, saying that she had something she wanted you to have...
CASEELSE
	PRINTFORM took out something and presented it to you, saying that you should have it...
ENDSELECT
CALL PRINT_BREAK
PRINTW 

	;Give eggs that have been built up since the last egg gift, to a maximum of MAX_EGG.
EGG = DAY-CFLAG:CHARA:LatestEggGiftDay
SIF TALENT:CHARA:PREGNANCY_TYPE == PREGNANCY_CLUTCH
		;Clutch layers give three times as many, but still have the same maximum.
	TIMES EGG, 3
EGG = MIN(EGG,MAX_EGG)
CFLAG:CHARA:LatestEggGiftDay = DAY

RELATIONSHIP = 3
IF TALENT:CHARA:恋慕
	RELATIONSHIP = 1
ELSEIF TALENT:CHARA:愛欲
	RELATIONSHIP = 2
ENDIF
CALL KOJO_MESSAGE_SEND("EVENT", 0, CHARA, RELATIONSHIP, EGG, "EGG_GIFT")
ITEM:少女の卵 += EGG
PRINTFORMW Received \@ EGG > 1 ? %NUM_COUNT(EGG)% eggs # an egg \@ from %CALLNAME:CHARA%!

@CUSTOM_RESET_VAR_1(ARG)
	;Reset custom pregnancy variables when resetting characters.
CFLAG:ARG:WithChildCount = 0
CFLAG:ARG:BirthEventsCount = 0
CFLAG:ARG:LatestChildCount = 0
TALENT:ARG:NESTING = 0
FOR LOCAL,0,MAXCHILD
	PregnancyProgress:ARG:LOCAL = 0
NEXT
CVARSET TALENT, GETNUM(TALENT, "PREGNANCY_TYPE"), PREGNANCY_NORMAL

@UPDATE_SET_PREGNANCY_COUNTERS
	;Set the pregnancy progress array for all characters and the birth event count for all characters who have given birth, for older saves.
FOR LOCAL,1,CHARANUM
	PregnancyProgress:LOCAL:0 = MAX(CFLAG:LOCAL:妊娠経過日数,TALENT:LOCAL:NESTING)
	IF (CFLAG:LOCAL:妊娠経過日数 || TALENT:LOCAL:NESTING) && !CFLAG:LOCAL:WithChildCount
		FOR LOCAL:1,0,MAXCHILD
			SIF PregnancyProgress:LOCAL:(LOCAL:1)
				CFLAG:LOCAL:WithChildCount++
		NEXT
	ENDIF
	SIF !CFLAG:LOCAL:BirthEventsCount && CFLAG:LOCAL:子供人数
		CFLAG:LOCAL:BirthEventsCount = CFLAG:LOCAL:子供人数
NEXT

@ADD_PREGNANCY_PROGRESS(CharacterIndex,ConceptionCount,ProgressDay=1,Inseminator=-1)
	;Set a progress tracker for a new pregnancy or egg, so that they can be born at different times if applicable.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ConceptionCount
#DIM DYNAMIC Inseminator
#DIM DYNAMIC ProgressDay
#DIM DYNAMIC ProgressList,MAXCHILD
VARSET LOCAL
SIF Inseminator == -1; nas: other character can preggo too!
	Inseminator = MASTER
FOR LOCAL,0,ConceptionCount
	FOR LOCAL:1,0,MAXCHILD
		IF PregnancyProgress:CharacterIndex:(LOCAL:1) == 0
			PregnancyProgress:CharacterIndex:(LOCAL:1) = ProgressDay
			PreggoWith:CharacterIndex:(LOCAL:1) = Inseminator
			BREAK
		ENDIF
	NEXT
NEXT
	;Sort pregnancy progress in case a later pregnancy is added with a further progress.
FOR LOCAL,0,MAXCHILD
	SIF PregnancyProgress:CharacterIndex:LOCAL == 0
		BREAK
	ProgressList:LOCAL = PregnancyProgress:CharacterIndex:LOCAL
NEXT
ARRAYSORT ProgressList,BACK
FOR LOCAL,0,MAXCHILD
	SIF ProgressList:LOCAL == 0
		BREAK
	PregnancyProgress:CharacterIndex:LOCAL = ProgressList:LOCAL
NEXT

@PROGRESS_PREGNANCIES(CharacterIndex)
	;Progress all pregnancy trackers in sync with the vanilla one.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ProgressNumber
ProgressNumber = MAX(CFLAG:CharacterIndex:妊娠経過日数,TALENT:CharacterIndex:NESTING)
ProgressNumber -= PregnancyProgress:CharacterIndex:0
FOR LOCAL,0,MAXCHILD
	IF PregnancyProgress:CharacterIndex:LOCAL == 0
		BREAK
	ELSE
		PregnancyProgress:CharacterIndex:LOCAL += ProgressNumber
	ENDIF
NEXT

@REMOVE_PREGNANCY_PROGRESS(CharacterIndex)
	;Remove a pregnancy tracker for when the child is born.
#DIM DYNAMIC CharacterIndex
FOR LOCAL,0,MAXCHILD
	IF PregnancyProgress:CharacterIndex:LOCAL == 0
		BREAK
	ELSE
		IF LOCAL > 0
			PregnancyProgress:CharacterIndex:(LOCAL-1) = PregnancyProgress:CharacterIndex:LOCAL
			PreggoWith:CharacterIndex:(LOCAL-1) = PreggoWith:CharacterIndex:LOCAL
		ENDIF
		PregnancyProgress:CharacterIndex:LOCAL = 0
		PreggoWith:CharacterIndex:LOCAL = 0
	ENDIF
NEXT

@COUNT_BIRTH_MATES(CharacterIndex)
	;Count how many children will be born within a single birth event.
#FUNCTION
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ChildCount
FOR LOCAL,0,MAXCHILD
	IF PregnancyProgress:CharacterIndex:LOCAL == 0
		BREAK
	ELSE
		IF PregnancyProgress:CharacterIndex:LOCAL == PregnancyProgress:CharacterIndex:0
			ChildCount++
		ELSE
			BREAK
		ENDIF
	ENDIF
NEXT
RETURNF ChildCount

@ADD_WITH_CHILD(CharacterIndex,Quantity=1,ProgressDay=1)
	;Helper function to make a character pregnant or nesting with one or more additional children.
	;If Quantity is -1, decides based on pregnancy type.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC Quantity
#DIM DYNAMIC ProgressDay
SIF CFLAG:CharacterIndex:WithChildCount+Quantity > MAXCHILD
	Quantity = MAXCHILD-CFLAG:CharacterIndex:WithChildCount
SIF !Quantity
	RETURN
IF GROUPMATCH(TALENT:CharacterIndex:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) && !FLAG:EGGNANCY
	TALENT:CharacterIndex:NESTING = MAX(TALENT:CharacterIndex:NESTING,ProgressDay)
ELSE
	CFLAG:CharacterIndex:妊娠経過日数 = MAX(CFLAG:CharacterIndex:妊娠経過日数,ProgressDay)
ENDIF
IF Quantity < 0
	Quantity = CONCEPTION_COUNT(CharacterIndex,ProgressDay)
ELSE
	CFLAG:CharacterIndex:WithChildCount += Quantity
ENDIF
SIF !Quantity
	RETURN
CALL ADD_PREGNANCY_PROGRESS(CharacterIndex,Quantity,ProgressDay)
RETURN Quantity

@PREGNANCY_CONVERT_TYPES
FOR LOCAL, 1, CHARANUM
	IF !PREGNANCY_NESTER(LOCAL) && TALENT:LOCAL:NESTING > 0
		CFLAG:LOCAL:妊娠経過日数 = PregnancyProgress:LOCAL:0
		TALENT:LOCAL:NESTING = 0
	ELSEIF PREGNANCY_NESTER(LOCAL) && CFLAG:LOCAL:妊娠経過日数 > 0
		TALENT:LOCAL:NESTING = PregnancyProgress:LOCAL:0
		CFLAG:LOCAL:妊娠経過日数 = 0
	ENDIF
NEXT

@EVENTLOAD
#LATER
IF GET_VERSION_VALUE(SAVESTR:本体バージョン) < 4972
	FOR LOCAL, 0, CHARANUM
		SELECTCASE TALENT:LOCAL:PREGNANCY_TYPE
			CASE 4
				TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_NORMAL
				TALENT:LOCAL:HYPERFERTILE = 1
			CASE 5
				TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_LITTERS
				TALENT:LOCAL:HYPERFERTILE = 1
		ENDSELECT
	NEXT
ENDIF

CALL PREGNANCY_CONVERT_TYPES()

@PREGNANCY_TYPES_NEWGAME_SET()
FOR LOCAL,1,CHARANUM
	TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_CHARA_DEFAULT(LOCAL)
NEXT