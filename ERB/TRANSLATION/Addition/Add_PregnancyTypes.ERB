		PRINTFORM 그녀는 주머니에서 무언가를 꺼내며 초조하게 당신에게 내밀었고, 전체적으로 안절부절못하는 모습을 보였다...
	CASE 2
		PRINTFORM 당신의 얼굴을 바라보더니 무언가를 꺼내며 그것을 기억해낸 듯, 주저 없이 건넸다...
	CASE 3
		PRINTFORM 갑자기 무언가를 꺼내 건네며 당신을 위한 것이라고 말했다...
	CASE 4
		PRINTFORM 상자를 꺼내 조심스럽게 당신에게 건네며, 당신이 가졌으면 하는 것이 있다고 말했다...
	CASEELSE
		PRINTFORM 무언가를 꺼내 당신에게 건네며 갖는 것이 좋다고 말했다.
ENDSELECT
CALL PRINT_BREAK
PRINTW 
;Give eggs that have been built up since the last egg gift, to a maximum of MAX_EGG.
EGG = DAY-CFLAG:CHARA:LatestEggGiftDay
SIF TALENT:CHARA:PREGNANCY_TYPE == PREGNANCY_CLUTCH
	TIMES EGG, 3
EGG = MIN(EGG,MAX_EGG)
CFLAG:CHARA:LatestEggGiftDay = DAY
RELATIONSHIP = 3
IF TALENT:CHARA:恋慕
	RELATIONSHIP = 1
ELSEIF TALENT:CHARA:愛欲
	RELATIONSHIP = 2
ENDIF
CALL KOJO_MESSAGE_SEND("EVENT", 0, CHARA, RELATIONSHIP, EGG, "EGG_GIFT")
ITEM:少女の卵 += EGG
PRINTFORMW %CALLNAME:CHARA%로부터 \@ EGG > 1 ? %CALLNAME:CHARA%개의 알 # 알 하나 \@을 받았다!

@CUSTOM_RESET_VAR_1(ARG)
;Reset custom pregnancy variables when resetting characters.
CFLAG:ARG:WithChildCount = 0
CFLAG:ARG:BirthEventsCount = 0
CFLAG:ARG:LatestChildCount = 0
TALENT:ARG:NESTING = 0
FOR LOCAL,0,MAXCHILD
PregnancyProgress:ARG:LOCAL = 0
NEXT
CVARSET TALENT, GETNUM(TALENT, "PREGNANCY_TYPE"), PREGNANCY_NORMAL

@UPDATE_SET_PREGNANCY_COUNTERS
;Set the pregnancy progress array for all characters and the birth event count for all characters who have given birth, for older saves.
FOR LOCAL,1,CHARANUM
PregnancyProgress:LOCAL:0 = MAX(CFLAG:LOCAL:妊娠経過日数,TALENT:LOCAL:NESTING)
IF (CFLAG:LOCAL:妊娠経過日数 || TALENT:LOCAL:NESTING) && !CFLAG:LOCAL:WithChildCount
	FOR LOCAL:1,0,MAXCHILD
	SIF PregnancyProgress:LOCAL:(LOCAL:1)
		CFLAG:LOCAL:WithChildCount++
	NEXT
ENDIF
SIF !CFLAG:LOCAL:BirthEventsCount && CFLAG:LOCAL:子供人数
	CFLAG:LOCAL:BirthEventsCount = CFLAG:LOCAL:子供人数
NEXT

@ADD_PREGNANCY_PROGRESS(CharacterIndex,ConceptionCount,ProgressDay=1,Inseminator=-1)
;Set a progress tracker for a new pregnancy or egg, so that they can be born at different times if applicable.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ConceptionCount
#DIM DYNAMIC Inseminator
#DIM DYNAMIC ProgressDay
#DIM DYNAMIC ProgressList,MAXCHILD
VARSET LOCAL
SIF Inseminator == -1; nas: other character can preggo too!
	Inseminator = MASTER
FOR LOCAL,0,ConceptionCount
FOR LOCAL:1,0,MAXCHILD
IF PregnancyProgress:CharacterIndex:(LOCAL:1) == 0
	PregnancyProgress:CharacterIndex:(LOCAL:1) = ProgressDay
	PreggoWith:CharacterIndex:(LOCAL:1) = Inseminator
	BREAK
ENDIF
NEXT
NEXT
;Sort pregnancy progress in case a later pregnancy is added with a further progress.
FOR LOCAL,0,MAXCHILD
SIF PregnancyProgress:CharacterIndex:LOCAL == 0
	BREAK
ProgressList:LOCAL = PregnancyProgress:CharacterIndex:LOCAL
NEXT
ARRAYSORT ProgressList,BACK
FOR LOCAL,0,MAXCHILD
SIF ProgressList:LOCAL == 0
	BREAK
PregnancyProgress:CharacterIndex:LOCAL = ProgressList:LOCAL
NEXT

@PROGRESS_PREGNANCIES(CharacterIndex)
;Progress all pregnancy trackers in sync with the vanilla one.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ProgressNumber
ProgressNumber = MAX(CFLAG:CharacterIndex:妊娠経過日数,TALENT:CharacterIndex:NESTING)
ProgressNumber -= PregnancyProgress:CharacterIndex:0
FOR LOCAL,0,MAXCHILD
IF PregnancyProgress:CharacterIndex:LOCAL == 0
	BREAK
ELSE
	PregnancyProgress:CharacterIndex:LOCAL += ProgressNumber
ENDIF
NEXT

@REMOVE_PREGNANCY_PROGRESS(CharacterIndex)
;Remove a pregnancy tracker for when the child is born.
#DIM DYNAMIC CharacterIndex
FOR LOCAL,0,MAXCHILD
IF PregnancyProgress:CharacterIndex:LOCAL == 0
	BREAK
ELSE
	IF LOCAL > 0
		PregnancyProgress:CharacterIndex:(LOCAL-1) = PregnancyProgress:CharacterIndex:LOCAL
		PreggoWith:CharacterIndex:(LOCAL-1) = PreggoWith:CharacterIndex:LOCAL
	ENDIF
	PregnancyProgress:CharacterIndex:LOCAL = 0
	PreggoWith:CharacterIndex:LOCAL = 0
ENDIF
NEXT

@COUNT_BIRTH_MATES(CharacterIndex)
;Count how many children will be born within a single birth event.
#FUNCTION
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC ChildCount
FOR LOCAL,0,MAXCHILD
IF PregnancyProgress:CharacterIndex:LOCAL == 0
	BREAK
ELSE
	IF PregnancyProgress:CharacterIndex:LOCAL == PregnancyProgress:CharacterIndex:0
		ChildCount++
	ELSE
		BREAK
	ENDIF
ENDIF
NEXT
RETURNF ChildCount

@ADD_WITH_CHILD(CharacterIndex,Quantity=1,ProgressDay=1)
;Helper function to make a character pregnant or nesting with one or more additional children.
;If Quantity is -1, decides based on pregnancy type.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC Quantity
#DIM DYNAMIC ProgressDay
SIF CFLAG:CharacterIndex:WithChildCount+Quantity > MAXCHILD
	Quantity = MAXCHILD-CFLAG:CharacterIndex:WithChildCount
SIF !Quantity
	RETURN
IF GROUPMATCH(TALENT:CharacterIndex:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH) && !FLAG:EGGNANCY
	TALENT:CharacterIndex:NESTING = MAX(TALENT:CharacterIndex:NESTING,ProgressDay)
ELSE
	CFLAG:CharacterIndex:妊娠経過日数 = MAX(CFLAG:CharacterIndex:妊娠経過日数,ProgressDay)
ENDIF
IF Quantity < 0
	Quantity = CONCEPTION_COUNT(CharacterIndex,ProgressDay)
ELSE
	CFLAG:CharacterIndex:WithChildCount += Quantity
ENDIF
SIF !Quantity
	RETURN
CALL ADD_PREGNANCY_PROGRESS(CharacterIndex,Quantity,ProgressDay)
RETURN Quantity

@PREGNANCY_CONVERT_TYPES
FOR LOCAL, 1, CHARANUM
IF !PREGNANCY_NESTER(LOCAL) && TALENT:LOCAL:NESTING > 0
	CFLAG:LOCAL:妊娠経過日数 = PregnancyProgress:LOCAL:0
	TALENT:LOCAL:NESTING = 0
ELSEIF PREGNANCY_NESTER(LOCAL) && CFLAG:LOCAL:妊娠経過日数 > 0
	TALENT:LOCAL:NESTING = PregnancyProgress:LOCAL:0
	CFLAG:LOCAL:妊娠経過日数 = 0
ENDIF
NEXT

@EVENTLOAD
#LATER
IF GET_VERSION_VALUE(SAVESTR:本体バージョン) < 4972
	FOR LOCAL, 0, CHARANUM
	SELECTCASE TALENT:LOCAL:PREGNANCY_TYPE
		CASE 4
			TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_NORMAL
			TALENT:LOCAL:HYPERFERTILE = 1
		CASE 5
			TALENT:LOCAL:PREGNANCY_TYPE = PREGNANCY_LITTERS
			TALENT:LOCAL:HYPERFERTILE = 1
	ENDSELECT
	NEXT
ENDIF
CALL PREGNANCY_CONVERT_TYPES()

@PREGNANCY_TYPES_NEWGAME_SET()
