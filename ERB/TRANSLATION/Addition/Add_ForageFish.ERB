; Modular ERB: Addition/Add_ForageFish.ERB
;fish/forage on the way when taking detour

@Add_ForageFish
#DIM DYNAMIC nInitiative ;who suggests to do the act
#DIM DYNAMIC nType ;type of potential gathering
#DIM DYNAMIC nAct ;selected type, 1 - fishing, 2 - foraging
#DIM nPos ;remember initial position, then change current position for the purpose of correct fishing/foraging yields
#DIM nFlag, 3 ;remember flags
#DIM nTime ;remember time spent
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURN 0
DEBUGPRINTFORML ------------------------
DEBUGPRINTFORML 랜덤 체크
IF CFLAG:MASTER:今日の運勢 > 0 && RAND:(CFLAG:MASTER:今日の運勢) >= 400
	DEBUGPRINTFORML 마스터 승리했다.
	nInitiative = 1
ELSEIF CFLAG:TARGET:今日の運勢 > 0 && RAND:(CFLAG:TARGET:今日の運勢) >= 400
	DEBUGPRINTFORML 타겟이 승리한다.
	nInitiative = 2
ELSEIF nForageFishDebug
	DEBUGPRINTFORML 디버그 트리거, \@ nForageFishDebug == 1 ? 마스터 # 타겟 \@로 설정.
	nInitiative = nForageFishDebug == 1 ? 1 # 2
ELSE
	DEBUGPRINTFORML 실패, 마스터의 운세: {CFLAG:MASTER:今日の運勢}, 대상의 운세: {CFLAG:TARGET:今日の運勢}
	DEBUGPRINTFORML ------------------------
	RETURN 0
ENDIF
DEBUGPRINTFORML 가는 길에 자원을 모으며, nInitiative은(는) {nInitiative}
SIF ABL:TARGET:親密 >= 5 - TALENT:TARGET:釣りLv && ITEM:釣り竿 ;fishing
	SETBIT nType, 0
SIF ABL:TARGET:親密 >= 5 - TALENT:TARGET:採集Lv && (BASE:MASTER:気力 >= 650 && BASE:MASTER:体力 >= 680) ;foraging
	SETBIT nType, 1
DEBUGPRINTFORML nType - {nType}, bit0 - {GETBIT(nType, 0)}, bit1 - {GETBIT(nType, 1)}
SIF nType == 0
	RETURN 0
IF GETBIT(nType, 0) && GETBIT(nType, 1) ;if both type apply, use either random or the one with greatest skill
	IF nInitiative == 2
		IF !RAND:4 || TALENT:TARGET:釣りLv == TALENT:TARGET:採集Lv
			nAct = RAND:2 + 1
		ELSE
			nAct = TALENT:TARGET:釣りLv > TALENT:TARGET:採集Lv ? 1 # 2
		ENDIF
	ELSE
		IF !RAND:4 || TALENT:TARGET:釣りLv == TALENT:TARGET:採集Lv
			nAct = RAND:2 + 1
		ELSE
			nAct = TALENT:MASTER:釣りLv > TALENT:MASTER:採集Lv ? 1 # 2
		ENDIF
	ENDIF
ELSEIF GETBIT(nType, 0)
	nAct = 1
ELSEIF GETBIT(nType, 1)
	nAct = 2
ENDIF
SIF nAct == 1 && TARGET == [[わかさぎ姫]] && !(TALENT:[[わかさぎ姫]]:恋慕 || TALENT:[[わかさぎ姫]]:恋人) ;switch to foraging if waggy is not in love
	nAct = 2
SIF nForageFishActDebug
	nAct = nForageFishActDebug
DEBUGPRINTFORML nAct - {nAct}은(는) \@ nAct == 1 ? 낚시 # 먹이찾기 \@
SELECTCASE nInitiative
	CASE 1
		PRINTFORML \@ nAct == 1 ? 당신은 근처에 좋은 강을 발견했다... 잠시 거기서 낚시하기 좋을지도 모른다. # 이것은 재료를 모으기에 좋은 장소처럼 보인다... \@
	CASE 2
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 두 사람이 \@ nAct == 1 ? 낚시하러 가는 게 어때 # 채집을 하는 게 어때 \@ 하면서 둘이 있는 김에...
ENDSELECT
PRINTFORML 어떻게 생각해?
PRINTFORML (추가로 5~20분이 걸릴 수 있음)
CALL ASK_YN
SIF RESULT
	RETURN 0
PRINTFORML 당신은 가는 길에 %조사처리(CALLNAME:TARGET,"와")% 함께 \@ nAct == 1 ? 물고기를 잡는다 # 먹이를 찾는다 \@ 시도해 본다.
nPos = CFLAG:MASTER:現在位置 ;remember the position
nFlag:0 = TFLAG:192
nFlag:1 = TFLAG:193
nFlag:2 = TFLAG:194
nTime = TIME
DEBUGPRINTFORML 플래그 초기화:
DEBUGPRINTFORML CFLAG:MASTER:現在位置 - {CFLAG:MASTER:現在位置}
DEBUGPRINTFORML TFLAG:192 - {TFLAG:192}
DEBUGPRINTFORML TFLAG:193 - {TFLAG:193}
DEBUGPRINTFORML TFLAG:194 - {TFLAG:194}
DEBUGPRINTFORML nTime - {nTime}
DEBUGPRINTFORML 플래그 설정:
SELECTCASE nAct
	CASE 1
		;set positions
		SELECTCASE CFLAG:MASTER:現在位置
			CASE 0 TO 599 ;misty lake
				CFLAG:MASTER:現在位置 = 霧の湖
			CASE 600 TO 699
				CFLAG:MASTER:現在位置 = 三途の川
			CASE 700 TO 799
				CFLAG:MASTER:現在位置 = RAND:3 ? 玄武の沢 # 大蝦蟇の池
			CASE 800 TO 899
				CFLAG:MASTER:現在位置 = RAND:3 ? 山の湖 # 九天の滝
			CASE 900 TO 999
				CFLAG:MASTER:現在位置 = 地獄の深道
			CASEELSE
				CFLAG:MASTER:現在位置 = 玄武の沢
		ENDSELECT
		DEBUGPRINTFORML CFLAG:MASTER:現在位置 - {CFLAG:MASTER:現在位置}
		;call com and description
		SKIPDISP 1
		CALL COM621
		SKIPDISP 0
		CALL MESSAGE_COM621
		CALL COM_KOJO_CALL(TARGET, 621)
	CASE 2
		;set positions
		SELECTCASE CFLAG:MASTER:現在位置
			CASE 0 TO 99
				CFLAG:MASTER:現在位置 = 50
			CASE 100 TO 199
				CFLAG:MASTER:現在位置 = 墓地
			CASE 200 TO 399
				CFLAG:MASTER:現在位置 = 霧の湖
			CASE 400 TO 499
				CFLAG:MASTER:現在位置 = RAND:3 ? 斜角の竹林 # 無名の丘
			CASE 500 TO 599
				CFLAG:MASTER:現在位置 = RAND:3 ? 古木の大樹 # 無縁塚
			CASE 600 TO 699
				CFLAG:MASTER:現在位置 = RAND:3 ? 彼岸 # 630
			CASE 700 TO 799
				CFLAG:MASTER:現在位置 = RAND:3 ? 玄武の沢 # 大蝦蟇の池
			CASE 800 TO 899
				CFLAG:MASTER:現在位置 = RAND:3 ? 山の湖 # 絶景の丘
			CASE 900 TO 999
				CFLAG:MASTER:現在位置 = RAND:3 ? 地獄の深道 # 幻想風穴
			CASE 1000 TO 1099
				CFLAG:MASTER:現在位置 = RAND:3 ? 静かの海 # 桃林～砂浜
			CASEELSE
				CFLAG:MASTER:現在位置 = 50
		ENDSELECT
		DEBUGPRINTFORML CFLAG:MASTER:現在位置 - {CFLAG:MASTER:現在位置}
		;call com and description
		SKIPDISP 1
		CALL COM445
		SKIPDISP 0
		CALL MESSAGE_COM445
		CALL COM_KOJO_CALL(TARGET, 445)
ENDSELECT
DEBUGPRINTFORML TFLAG:192 - {TFLAG:192}
DEBUGPRINTFORML TFLAG:193 - {TFLAG:193}
DEBUGPRINTFORML TFLAG:194 - {TFLAG:194}
DEBUGPRINTFORML TIME - {TIME}
;set spent time to 1/10
IF nTime != TIME
	LOCAL = TIME - nTime ;get spent time
	DEBUGPRINTFORML 조정 전 소요 시간: {LOCAL}
	LOCAL = MAX(MULTIPLY(LOCAL, 10), 5)
	DEBUGPRINTFORML 이후에, {LOCAL}을 설정하고 시간을 {nTime}으로 맞춘다. {LOCAL}을 추가한다.
	TIME = nTime
	TIME += LOCAL
ENDIF
;reset values
CFLAG:MASTER:現在位置 = nPos
TFLAG:192 = nFlag:0
TFLAG:193 = nFlag:1
TFLAG:194 = nFlag:2
DEBUGPRINTFORML 플래그 초기화:
DEBUGPRINTFORML CFLAG:MASTER:現在位置 - {CFLAG:MASTER:現在位置}
DEBUGPRINTFORML TFLAG:192 - {TFLAG:192}
DEBUGPRINTFORML TFLAG:193 - {TFLAG:193}
DEBUGPRINTFORML TFLAG:194 - {TFLAG:194}
DEBUGPRINTFORML ------------------------
WAIT
RETURN 1
