; Modular ERB: Addition/Add_HypnosisRework.ERB

@催眠発動_TR

@PROCESS_HYPNOSIS_COMMAND(ARG, HYPNO_TARGET)
#DIM HYPNO_TARGET
#DIM 催眠タイプ
#DIM 催眠判定
#DIM 催眠結果
#DIM Strength
#DIM C_ID
#DIM CanTakePanties
催眠タイプ = ARG + 1
;NAS: Replaced
CALL PROCESS_YOUJUTSU_COMMAND(MASTER,HYPNO_TARGET,19,ARG)
RETURN RESULT
IF !DISPELLING_HYPNO(催眠タイプ)
	CALL CHECK_HYPNOSIS_COMMAND_SUCCESS(催眠タイプ, MASTER, HYPNO_TARGET)
	TCVAR:Hypno_Attempts++
	SIF RESULT == 99
		RETURN 99
ENDIF
催眠結果 = RESULT:0
Strength = RESULT:1
SIF nSpoilerMode
	PRINTFORMDL 명령의 강도는 {Strength}이다.
IF 催眠結果 > 0
	CALL 催眠発動の呪文(催眠結果)
	SELECTCASE 催眠タイプ
		CASE 1 ;Suppress Hostility
			TALENT:反発抑制 = 1
			IF 催眠判定 > 0
				TALENT:機嫌 = 1
				MARK:反発刻印 = 0
			ELSE
				SIF TALENT:機嫌 < 0
					TALENT:機嫌 = 0
				SIF MARK:反発刻印 > 0
					MARK:反発刻印 -= 1
			ENDIF
			BASE:怒り = 0
			CFLAG:不機嫌 = 0
			CFLAG:ブチギレ = 0
			TCVAR:挿入拒絶 = 0
			PALAM:反感 = 0
			PALAM:不快 = 0
			PALAM:抑鬱 = 0
		CASE 2 ;Fake Consent
			TALENT:合意誤認 = 1
			BASE:ムード = MAX(300 + 100 * 催眠判定, BASE:ムード)
			BASE:理性 = MIN(300 - 100 * 催眠判定, BASE:理性)
		CASE 3 ;Sexual Excitation/Inhibition
			IF TCVAR:発情 == 1
				TCVAR:発情 = 0
				BASE:ムード = MIN(200, BASE:ムード)
				BASE:理性 = MAX(400, BASE:理性)
				IF 催眠判定 > 0
					CFLAG:溜まってる度 = CFLAG:溜まってる度 / 3
					SIF PALAM:欲情 >= 30000
						PALAM:欲情 -= 30000
				ELSE
					CFLAG:溜まってる度 = CFLAG:溜まってる度 / 2
					SIF PALAM:欲情 >= 10000
						PALAM:欲情 -= 10000
				ENDIF
			ELSE
				TCVAR:発情 = 1
				BASE:ムード = MAX(MAXBASE:ムード * (2 + 催眠判定 * 2) / 4, BASE:ムード)
				BASE:理性 = MIN(250 * (2 - 催眠判定), BASE:理性)
				IF 催眠判定 > 0
					CFLAG:溜まってる度 = CFLAG:溜まってる度 * 3
					SIF PALAM:欲情 < 30000
						PALAM:欲情 += 30000
				ELSE
					CFLAG:溜まってる度 = CFLAG:溜まってる度 * 2
					SIF PALAM:欲情 < 10000
						PALAM:欲情 += 10000
				ENDIF
			ENDIF
		CASE 4
			IF TCVAR:Common_Sense_Alteration_Status
				TCVAR:Common_Sense_Alteration_Status = 0
				SIF !EQUIP:0 && TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense != 2
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(2, 0)
			ELSE
				SIF Strength < 0
					STRENGTH = 0
				TCVAR:Common_Sense_Alteration_Status = Strength + 催眠結果
				; IF TCVAR:Common_Sense_Alteration_Status
				; 	CFLAG:うふふ = 1
				; 	CFLAG:MASTER:うふふ = 1
				; ENDIF
			ENDIF
		CASE 5 ;Erogenous Zones
			TALENT:敏感な身体 = !TALENT:敏感な身体
		CASE 6
			SELECTCASE TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense
				CASE 0
					PRINTFORMDL %CALLNAME:HYPNO_TARGET%는 %HE_SHE(HYPNO_TARGET)%가 옷을 입고 있는 것에 혼란스러워하는 것 같다.
					PRINTFORMDW %HE_SHE(HYPNO_TARGET,1)%은/는 만족스러운 듯 빠르게 %HIS_HER(HYPNO_TARGET)%의 속옷만 남기고 벗으며 씨익 웃는다.
					FOR LOCAL,0,40
					EQUIP:HYPNO_TARGET:LOCAL = 0
					CFLAG:HYPNO_TARGET:(200 + LOCAL) = EQUIP:HYPNO_TARGET:LOCAL
					NEXT
					SIF !TCVAR:HYPNO_TARGET:本来の服装
						TCVAR:HYPNO_TARGET:本来の服装 = CFLAG:HYPNO_TARGET:基本服装セット
					CFLAG:HYPNO_TARGET:基本服装セット = 301
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 1
					CFLAG:Times_Made_Exhibitionist ++
				CASE 1
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(1, 0)
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 0
				CASE 2
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(2, 0)
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 1
					CFLAG:Times_Made_Exhibitionist ++
			ENDSELECT
		CASE 7
			SELECTCASE TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense
				CASE 0, 1
					CanTakePanties = 0
					IF EQUIP:HYPNO_TARGET:下半身下着２ && CFLAG:HYPNO_TARGET:ノーパン == 0
						CanTakePanties = 1
						LOCALS '= PANTSNAME(EQUIP:HYPNO_TARGET:下半身下着２, HYPNO_TARGET)
					ENDIF
					PRINTFORMDL %CALLNAME:HYPNO_TARGET%는 %HE_SHE(HYPNO_TARGET)%가 옷을 입고 있는 것에 혼란스러워 보인다.
					PRINTFORMDW %HE_SHE(HYPNO_TARGET,1)%은(는) %HIMSELF_HERSELF(HYPNO_TARGET)%를 재빨리 벗어버리고 만족스러운 듯 미소 짓는다.
					IF CanTakePanties
						SIF !PANTS_ALREADY_COLLECTED()
							SETCOLOR C_PINK
						PRINTFORM 당신은 %HIS_HER(HYPNO_TARGET)%에게 %LOCALS%를 받아도 괜찮겠습니까?
						IF !PANTS_ALREADY_COLLECTED()
							PRINTFORML  수집 목록에 없음
						ELSE
							PRINTFORML
						ENDIF
						RESETCOLOR
						CALL ASK_YN
						IF !RESULT
							PRINTFORML 당신은 %CALLNAME:HYPNO_TARGET%의 %LOCALS%를 집는다.
							CALL PANTS_GET(HYPNO_TARGET)
						ELSE
							CFLAG:HYPNO_TARGET:きょうのぱんつ = 0
						ENDIF
					ENDIF
					;Hack: move the clothes removal code down here because PANTS_ALREADY_COLLECTED and PANTS_GET won't work if the character isn't wearing panties
					FOR LOCAL,0,40
					EQUIP:HYPNO_TARGET:LOCAL = 0
					CFLAG:HYPNO_TARGET:(200 + LOCAL) = EQUIP:HYPNO_TARGET:LOCAL
					NEXT
					SIF !TCVAR:HYPNO_TARGET:本来の服装
						TCVAR:HYPNO_TARGET:本来の服装 = CFLAG:HYPNO_TARGET:基本服装セット
					CFLAG:HYPNO_TARGET:基本服装セット = 300
					CFLAG:HYPNO_TARGET:ノーパン = 1
					CFLAG:HYPNO_TARGET:きょうのブラ = 0
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 2
					CFLAG:Times_Made_Nudist ++
				CASE 2
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(2, 0)
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 0
			ENDSELECT
		CASE 8
			IF CFLAG:HYPNO_TARGET:行動
				BASE:ARG:仕事量 = 0
				CFLAG:ARG:行動 = 0
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%은(는) 오늘 %HE_SHE(HYPNO_TARGET)%가 조금 일찍 퇴근해도 괜찮다고 결정한다.
			ENDIF
			PRINTFORMDW %CALLNAME:HYPNO_TARGET%는 약간 혼란스러워 보이지만 너와 데이트하러 가는 것에 동의한다.
			FLAG:催眠デート相手 = HYPNO_TARGET
			CALLF DATEME(HYPNO_TARGET)
		CASE 9
			IF CFLAG:Hypno_Orgasm_Denial && (PALAM:快Ｃ >= PALAMLV:3 || PALAM:快Ｖ >= PALAMLV:3 || PALAM:快Ａ >= PALAMLV:3 || PALAM:快Ｂ >= PALAMLV:3 || PALAM:快Ｍ >= PALAMLV:3)
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%의 몸이 이완되고, %HE_SHE(HYPNO_TARGET)%은 안도하며 신음한다.
				CFLAG:Hypno_Orgasm_Denial = 0
			ELSEIF !CFLAG:Hypno_Orgasm_Denial && (PALAM:快Ｃ >= PALAMLV:3 || PALAM:快Ｖ >= PALAMLV:3 || PALAM:快Ａ >= PALAMLV:3 || PALAM:快Ｂ >= PALAMLV:3 || PALAM:快Ｍ >= PALAMLV:3)
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%의 몸이 긴장하고, %HE_SHE(HYPNO_TARGET)%은 좌절하며 신음한다.
				CFLAG:Hypno_Orgasm_Denial = 1
			ELSEIF CFLAG:Hypno_Orgasm_Denial
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%의 몸이 이완된다. %HE_SHE(HYPNO_TARGET,1)%는 혼란스러워 보인다...
				CFLAG:Hypno_Orgasm_Denial = 0
			ELSE
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%의 몸이 경직된다. %HE_SHE(HYPNO_TARGET,1)%는 혼란스러워 보인다...
				CFLAG:Hypno_Orgasm_Denial = 1
			ENDIF
		CASE 10
			CALL HYPNO_TALENT_REASSIGN
	ENDSELECT
ENDIF
PRINTL 
;Display images
IF 顔絵付きメッセージ
	RESULTS =
	キャラ画像表示サイズ比 = 100
	IF RESULT == 0
		CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "笑顔")
		SIF !RESULT
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "通常")
	ELSEIF RESULT == 1 || RESULT == 2
		CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "発情")
		SIF !RESULT
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "通常")
	ELSEIF RESULT == 2
		IF TCVAR:発情 == 1
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", "裸", "発情")
			SIF !RESULT
				CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "通常")
		ELSE
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "発情")
		ENDIF
	ENDIF
	SIF FLAG:マルチサイズ
		デフォルトキャラ画像横幅 = SPRITEHEIGHT(RESULTS)
	CALL IMAGE_SET(RESULTS, 0, 0, キャラ画像表示サイズ比, 0)
	CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
ENDIF
;#; PRINTFORMDL Sending message with type {催眠タイプ} and status {催眠結果}
CALL KOJO_MESSAGE_SEND("EVENT",666,HYPNO_TARGET,催眠タイプ,催眠結果)
IF RESULT > 0
	PRINTL 
ELSEIF 顔絵付きメッセージ
	PRINTW 
ENDIF
催眠判定 = 0
RETURN 催眠結果

@CHECK_HYPNOSIS_COMMAND_SUCCESS(催眠タイプ, HYPNOTIST, HYPNO_TARGET)
#DIM DYNAMIC 催眠タイプ
#DIM DYNAMIC 催眠判定
#DIM DYNAMIC 催眠結果
#DIM DYNAMIC C_ID
#DIM DYNAMIC HYPNOTIST
#DIM DYNAMIC HYPNO_TARGET
#DIM DYNAMIC HYPNOTIST_ROLL
#DIM DYNAMIC HYPNO_TARGET_ROLL
#DIM DYNAMIC HYPNOTIST_BONUS
#DIM DYNAMIC HYPNO_TARGET_BONUS
#DIM DYNAMIC HYPNOTIST_TOTAL_SCORE
#DIM DYNAMIC HYPNO_TARGET_TOTAL_SCORE
#DIM DYNAMIC HYPNOTIST_BASE_ROLL
#DIMS DYNAMIC EFFECTIVENESS_MULTIPLIER_TEXT
#DIMS DYNAMIC RESISTANCE_MULTIPLIER_TEXT
;NAS REPLACED WITH MAGIC SYSTEM IN
CALL CHECK_COMMAND_SUCCESS_YOUJUTSU_19(MASTER,TARGET,催眠タイプ)
RETURN RESULT,RESULT:1
;NAS edits, already covered by Youjutsu system
IF GROUPMATCH(催眠タイプ, 6, 7)
	BASE:HYPNOTIST:TSP -= 1000
ELSEIF 催眠タイプ == 10
	BASE:HYPNOTIST:TSP -= 2000
ELSE
	BASE:HYPNOTIST:TSP -= 500
ENDIF
催眠判定 = 0
IF !CFLAG:HYPNO_TARGET:睡眠
	;対抗
	$HYPNO_CHECK
	CALL HANDLE_SPECIAL_HYPNOSIS_CASES(催眠タイプ)
	IF RESULT == 99
		RESETCOLOR
		RETURN 99
	ENDIF
	;HYPNOTIST_ROLL = 1 + RAND:(MAX(1, (30 + TALENT:HYPNOTIST:催眠技能Lv*20)))
	[IF_DEBUG]
	; HYPNOTIST_ROLL += 9999
	[ENDIF]
	HYPNO_TARGET_ROLL = 1 + RAND:(MAX(1, ((100 - (ABL:HYPNO_TARGET:催眠奴隷*10)) + (10 * TCVAR:HYPNO_TARGET:Hypno_Attempts))))
	HYPNOTIST_BONUS = 0
	HYPNO_TARGET_BONUS = 0
	SIF TALENT:HYPNOTIST:禁断の知識
		HYPNOTIST_BONUS += 20
	SIF CFLAG:HYPNO_TARGET:うふふ
		HYPNOTIST_BONUS += 30
	SIF TALENT:HYPNO_TARGET:禁断の知識
		HYPNO_TARGET_BONUS += 20
	SIF TALENT:HYPNO_TARGET:淫乱
		HYPNO_TARGET_BONUS -= 20
	SIF TALENT:HYPNO_TARGET:服従
		HYPNO_TARGET_BONUS -= 20
	SIF TALENT:HYPNO_TARGET:妄信
		HYPNO_TARGET_BONUS -= 20
	SIF TALENT:HYPNO_TARGET:妄想の産物
		HYPNO_TARGET_BONUS -= 100
	SELECTCASE TALENT:HYPNO_TARGET:人間
		;仙人
		CASE 2
			HYPNO_TARGET_BONUS += 30
			;天人
		CASE 3
			HYPNO_TARGET_BONUS += 30
			;月人
		CASE 4
			HYPNO_TARGET_BONUS += 20
			;魔界人
		CASE 5
			HYPNO_TARGET_BONUS += 10
	ENDSELECT
	SIF TALENT:HYPNO_TARGET:妖怪
		HYPNO_TARGET_BONUS += 30
	SIF TALENT:HYPNO_TARGET:妖精
		HYPNO_TARGET_BONUS += 10
	SIF TALENT:HYPNO_TARGET:神霊
		HYPNO_TARGET_BONUS += 50
	SIF TALENT:HYPNO_TARGET:幽霊
		HYPNO_TARGET_BONUS += 30
	SIF TALENT:HYPNO_TARGET:付喪神
		HYPNO_TARGET_BONUS += 30
	SIF TALENT:HYPNO_TARGET:人形
		HYPNO_TARGET_BONUS += 30
	SELECTCASE TALENT:HYPNO_TARGET:追加種族
		;巫女
		CASE 1
			HYPNO_TARGET_BONUS += 20
			;蓬莱人
		CASE 4
			HYPNO_TARGET_BONUS += 20
	ENDSELECT
	HYPNOTIST_BONUS = MAX(0, HYPNOTIST_BONUS + (15 * BASE:HYPNOTIST:体力) / MAXBASE:HYPNOTIST:体力 + (25 * BASE:HYPNOTIST:気力) / MAXBASE:HYPNOTIST:気力 - (100 * BASE:HYPNOTIST:酒気) / MAXBASE:HYPNOTIST:酒気 + ABL:HYPNOTIST:技巧 * 15 + ABL:HYPNOTIST:教養 * 15)
	HYPNO_TARGET_BONUS = MAX(0, HYPNO_TARGET_BONUS + MARK:HYPNO_TARGET:反発刻印 * 30 + (50 * BASE:HYPNO_TARGET:体力) / MAXBASE:HYPNO_TARGET:体力 + (75 * BASE:HYPNO_TARGET:気力) / MAXBASE:HYPNO_TARGET:気力 - (75 * BASE:HYPNO_TARGET:ムード) / MAXBASE:HYPNO_TARGET:ムード + (100 * BASE:HYPNO_TARGET:理性) / MAXBASE:HYPNO_TARGET:理性 + (100 * BASE:HYPNO_TARGET:怒り) / MAXBASE:HYPNO_TARGET:怒り - (100 * BASE:HYPNO_TARGET:酒気) / MAXBASE:HYPNO_TARGET:酒気 - CFLAG:HYPNO_TARGET:信頼度 / 10 - ABL:HYPNO_TARGET:親密 * 3 - ABL:HYPNO_TARGET:従順 * 5 - ABL:HYPNO_TARGET:欲望 * 7 + MIN(ABL:HYPNO_TARGET:技巧, 10) * 10 + ABL:HYPNO_TARGET:教養 * 15)
	;This is so characters with higher levels of hypno resistance aren't always getting Critical Successes from the bonuses to their base resistance rolls
	HYPNOTIST_BASE_ROLL = HYPNO_TARGET_ROLL
	;added
	SELECTCASE TALENT:HYPNOTIST:催眠耐性
		CASE -2
			TIMES HYPNOTIST_ROLL , 0.50
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%/ 2
		CASE -1
			TIMES HYPNOTIST_ROLL , 0.75
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 3/4
		CASE 1
			TIMES HYPNOTIST_ROLL , 1.5
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 1.5
		CASE 2
			HYPNOTIST_ROLL *= 2
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 2
		CASE 3
			HYPNOTIST_ROLL *= 3
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 3
		CASE 4
			HYPNOTIST_ROLL *= 10
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 10
	ENDSELECT
	;added
	SELECTCASE TALENT:HYPNO_TARGET:催眠耐性
		CASE -2
			TIMES HYPNO_TARGET_ROLL , 0.50
			RESISTANCE_MULTIPLIER_TEXT = %" "%/ 2
		CASE -1
			TIMES HYPNO_TARGET_ROLL , 0.75
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 3/4
		CASE 1
			TIMES HYPNO_TARGET_ROLL , 1.5
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 1.5
		CASE 2
			HYPNO_TARGET_ROLL *= 2
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 2
		CASE 3
			HYPNO_TARGET_ROLL *= 3
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 3
		CASE 4
			HYPNO_TARGET_ROLL *= 10
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 10
	ENDSELECT
	;Special case: Sekibanki (has multiple heads, so randomize her resistance to represent you hitting more/fewer of them)
	IF HYPNO_TARGET == [[蛮奇]]
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 
			CASE 1
				TIMES HYPNO_TARGET_ROLL , 1.5
			CASE 2
				HYPNO_TARGET_ROLL *= 2
		ENDSELECT
	ENDIF
	;Special case: Hisami (becomes obsessed with you when fallen and already obsessed with Zanmu, so she becomes easy to hypnotize)
	SIF HYPNO_TARGET == [[日狭美]] && (FLAG:なりきり == [[残無]] || IS_FALLEN([[日狭美]]))
		TALENT:[[日狭美]]:催眠耐性 = -2
	HYPNOTIST_TOTAL_SCORE = HYPNOTIST_ROLL + HYPNOTIST_BONUS
	HYPNO_TARGET_TOTAL_SCORE = HYPNO_TARGET_ROLL + HYPNO_TARGET_BONUS
	SIF GETBIT(CFLAG:HYPNO_TARGET:既成事実,6)
		HYPNO_TARGET_TOTAL_SCORE = HYPNO_TARGET_TOTAL_SCORE / 2
	PRINTFORM %CALLNAME:HYPNOTIST%의 능력:
	;PRINTFORM 1D{30 + TALENT:HYPNOTIST:催眠技能Lv*20}%EFFECTIVENESS_MULTIPLIER_TEXT% + {HYPNOTIST_BONUS} = {HYPNOTIST_ROLL} + {HYPNOTIST_BONUS} =
	SIF HYPNOTIST_TOTAL_SCORE > HYPNO_TARGET_TOTAL_SCORE && (HYPNOTIST_ROLL >= 5 || HYPNO_TARGET_ROLL < 5)
		FONTBOLD
	PRINTFORM {HYPNOTIST_TOTAL_SCORE}
	FONTREGULAR
	IF HYPNOTIST_ROLL > 95
		FONTBOLD
		SETCOLOR C_AQUA
		PRINTL   치명적인 성공! 
		RESETCOLOR
		FONTREGULAR
		催眠判定 += 1
	ELSEIF HYPNOTIST_ROLL < 5
		FONTBOLD
		SETCOLOR 255,0,0
		PRINTL   치명적인 실패! 
		RESETCOLOR
		FONTREGULAR
		催眠判定 -= 1
	ELSE
		PRINTL 
	ENDIF
	IF 催眠判定 == 0
		PRINTFORM %CALLNAME:HYPNO_TARGET%의 저항력:
		PRINTFORM 1D{(100 - (ABL:HYPNO_TARGET:催眠奴隷*10)) + (10 * TCVAR:HYPNO_TARGET:Hypno_Attempts)}%RESISTANCE_MULTIPLIER_TEXT% + {HYPNO_TARGET_BONUS} = {HYPNO_TARGET_ROLL} + {HYPNO_TARGET_BONUS} = 
		SIF HYPNO_TARGET_TOTAL_SCORE > HYPNOTIST_TOTAL_SCORE && (HYPNO_TARGET_ROLL >= 5 || HYPNOTIST_ROLL < 5)
			FONTBOLD
		PRINTFORM {HYPNO_TARGET_TOTAL_SCORE}
	ENDIF
	FONTREGULAR
	IF HYPNOTIST_BASE_ROLL > 95
		IF 催眠判定 == 0
			FONTBOLD
			SETCOLOR C_AQUA
			PRINTL   치명적인 성공이다! 
			RESETCOLOR
			FONTREGULAR
			催眠判定 -= 1
		ENDIF
	ELSEIF HYPNOTIST_BASE_ROLL < 5
		IF 催眠判定 == 0
			FONTBOLD
			SETCOLOR 255,0,0
			PRINTL   치명적인 실패! 
			RESETCOLOR
			FONTREGULAR
			催眠判定 += 1
		ENDIF
	ELSE
		PRINTL 
	ENDIF
	IF 催眠判定 > 0
		IF 催眠判定 > 1
			PRINT 결과:
			FONTBOLD
			SETCOLOR C_AQUA
			PRINTW 더블 크리티컬 성공! 
			RESETCOLOR
			FONTREGULAR
			催眠判定 = 1
			催眠結果 = 3
			EXP:HYPNOTIST:催眠経験 += 5
			EXP:HYPNO_TARGET:催眠奴隷経験 += 5
			SOURCE:HYPNO_TARGET:欲情 += 3000
			SOURCE:HYPNO_TARGET:屈従 += 6000
			SOURCE:HYPNO_TARGET:恭順 += 1500
		ELSE
			PRINT 결과:
			FONTBOLD
			SETCOLOR C_AQUA
			PRINTW 치명적인 성공! 
			RESETCOLOR
			FONTREGULAR
			催眠判定 = 0
			催眠結果 = 2
			EXP:HYPNOTIST:催眠経験 += 3
