							GOTO NOTHING_HAPPENS
						ENDIF
					ENDIF

				CASE 10 ;Hypno Trait Alteration
					GOTO NOTHING_HAPPENS

			ENDSELECT
			PRINTFORMDL
			$SEIJA_SCENE_END
			PRINTFORML 「Okay, I think you've learned your lesson.」
			$SEIJA_SCENE_END_2
			IF TALENT:TARGET:恋慕 || TALENT:TARGET:愛欲 || TALENT:TARGET:セフレ
				PRINTFORMW 「But you'd better not try and pull that shit again. Got it?」
				PRINTFORMDW You nod.
				PRINTFORMW 「Good %PRINT_MALE("boy", MASTER)%.」
				PRINTFORMDW %CALLNAME:[[正邪]]% smirks and gives you a pat on the head.
			ELSE
				PRINTFORMW 「Later, loser!」
				PRINTFORMDW %CALLNAME:[[正邪]]% sneers, flips you off, and leaves.
				CALL RUNOFF(97)
			ENDIF
			SIF CFLAG:97:2 >= 20
				CALL CHANGE_CFLAG(2,97,MAX(CFLAG:97:2 / 20 * -1, -80) )
			SIF CFLAG:97:4 >= 5
				CALL CHANGE_CFLAG(4,97,MAX(CFLAG:97:4 /  5 * -1, -40) )
			EXP:MASTER:催眠経験 += 2
			EXP:97:催眠奴隷経験 += 1
			RETURN 99
		ENDIF
	CASE [[クラウンピース]] ;Clownpiece
		IF PERCENT(5)
			PRINTFORMDW While trying to hypnotize %CALLNAME:[[クラウンピース]]%, you accidentally stare into %HIS_HER(TARGET)% torch.
			PRINTFORMDW You jerk away from %HIM_HER(TARGET)% and clutch your head as a wild energy surges inside you.
			PRINTFORMDW %CALLNAME:[[クラウンピース]]% giggles innocently as you struggle to remain sane.
			IF PERCENT(25)
				PRINTFORMDW It doesn't work. The wild energy is just too strong.
				PRINTFORMDW Your vision goes blurry and your mind goes blank...
				PRINTFORML
				PRINTFORMDW ......
				PRINTFORMDW ...
				PRINTFORML
				PRINTFORMDW You come to your senses several hours later.
				PRINTFORMDW Your clothes are torn and stained with mud, and your body has a few cuts and bruises that weren't there before.
				PRINTFORMDW Just what did you do while you were insane...?
				TIME += 120
				CALL RECOVER(MASTER, -500, "体力", "Frenzied rampage")
				CALL RECOVER(MASTER, -500, "気力", "Frenzied rampage")
			ELSE
				PRINTFORMDW You grit your teeth and focus.
				PRINTFORMDW A few moments later, the energy surging inside you fades away.
			ENDIF
			RETURN 99
		ENDIF
ENDSELECT

