@催眠発動_TR

[SKIPSTART]
@催眠発動_TR
#DIM 催眠タイプ
#DIM 催眠結果

SIF NON_HYPNOTIZED_EYEWITNESSES() || !TARGET || FLAG:70 || BASE:MASTER:TSP < 500 || !SHIRAHU(TARGET)
	RETURN 1

[IF_DEBUG]
; TALENT:MASTER:催眠技能Lv = 6
[ENDIF]

PRINTL Select the type of hypnosis.
SIF !TARGET || FLAG:70 || BASE:MASTER:TSP < 500
	SETCOLOR C_L_GRAY
PRINTL [0] - Suppress Hostility (TSP500 - Applied immediately)
RESETCOLOR

;	SIF GET_TARGETNUM() > 1 || TALENT:合意誤認 || !TARGET
SIF TALENT:合意誤認 || !TARGET  || FLAG:70 || BASE:MASTER:TSP < 500
	SETCOLOR C_L_GRAY
PRINTL [1] - Fake Consent (TSP500 - Today only)
RESETCOLOR

;	SIF GET_TARGETNUM() > 1 || !TARGET
SIF !TARGET || FLAG:70 || BASE:MASTER:TSP < 500
	SETCOLOR C_L_GRAY
IF TCVAR:発情 == 1
	PRINTL [2] - Sexual Inhibition (TSP500 - Reversible)
ELSE
	PRINTL [2] - Sexual Excitation (TSP500 - Reversible)
ENDIF
RESETCOLOR

IF TCVAR:Common_Sense_Alteration_Status
	PRINTL [3] - Return Common Sense to Normal (No Consumption - Reversible)
ELSE
	SIF BASE:MASTER:TSP < 1000 || FLAG:70 
		SETCOLOR C_L_GRAY
	PRINTL [3] - Common Sense Modification (TSP500 - Reversible)
ENDIF
RESETCOLOR

SIF !TARGET || FLAG:70 || BASE:MASTER:TSP < 500
	SETCOLOR C_L_GRAY
IF TALENT:敏感な身体
	PRINTL [4] - Return Erogenous Zone Sensitivity to Normal (No consumption - Reversible)
ELSE
	PRINTL [4] - Make All Erogenous Zones Sensitive (TSP500 - Reversible)
ENDIF
RESETCOLOR

IF TCVAR:Exhibitionist_Nudist_Sense == 1
	PRINTL [5] - Return Exhibitionist Sense to Normal (No Consumption - Reversible)
ELSE
	SIF BASE:MASTER:TSP < 1000 || FLAG:70 
		SETCOLOR C_L_GRAY
	PRINTL [5] - Exhibitionist Sense Modification (TSP1000 - Reversible)
ENDIF
RESETCOLOR

IF TCVAR:Exhibitionist_Nudist_Sense == 2
	PRINTL [6] - Return Nudist Sense to Normal (No Consumption - Reversible)
ELSE
	SIF BASE:MASTER:TSP < 1000 || FLAG:70 
		SETCOLOR C_L_GRAY
	PRINTL [6] - Nudist Sense Modification (TSP1000 - Reversible)
ENDIF
RESETCOLOR

SIF BASE:MASTER:TSP < 1000 || FLAG:70 || FLAG:デート相手
	SETCOLOR C_L_GRAY
PRINTL [7] - Hypno-Date (TSP1000)
RESETCOLOR

IF CFLAG:Hypno_Orgasm_Denial
	PRINTL [8] - Disable Hypno-Orgasm Denial (No Consumption - Reversible)
ELSE
	SIF BASE:MASTER:TSP < 500 || FLAG:70 || TEQUIP:焦らしモード
		SETCOLOR C_L_GRAY
	PRINTL [8] - Hypno-Orgasm Denial (TSP500 - Reversible)
ENDIF
RESETCOLOR

SIF BASE:MASTER:TSP < 2000 || FLAG:70 || TALENT:MASTER:催眠技能Lv < 4
	SETCOLOR C_L_GRAY
IF TALENT:MASTER:催眠技能Lv < 4
	PRINTL [9] - Hypno Trait Alteration (Requires Hypnosis Lv4 or above)
ELSE
	PRINTL [9] - Hypno Trait Alteration (TSP2000)
ENDIF
RESETCOLOR

PRINTL [999] - Back

$HYPNO_SELECT
INPUT
IF CAN_EXECUTE_HYPNO_COMMAND(RESULT)
	CALL PROCESS_HYPNOSIS_COMMAND(RESULT, TARGET)
ELSEIF RESULT == 999
	催眠タイプ = 0
	催眠結果 = 0
	CALL KOJO_MESSAGE_SEND("EVENT",666,TARGET,催眠タイプ,催眠結果)
ELSE
	CLEARLINE 1
	GOTO HYPNO_SELECT
ENDIF

@CAN_EXECUTE_HYPNO_COMMAND(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0 ;Suppress Hostility
		RETURNF (TARGET && BASE:MASTER:TSP >= 500)

	CASE 1 ;Fake Consent
		RETURNF (TARGET && BASE:MASTER:TSP >= 500 && TALENT:合意誤認 == 0)

	CASE 2 ;Sexual Excitation
		RETURNF (TARGET && BASE:MASTER:TSP >= 500)

	CASE 3 ;Common Sense Modification
		RETURNF (TARGET && (BASE:MASTER:TSP >= 500 || TCVAR:TARGET:Common_Sense_Alteration_Status > 0))

	CASE 4 ;Make All Erogenous Zones Sensitive
		RETURNF (TARGET && (BASE:MASTER:TSP >= 500 || TALENT:敏感な身体))

	CASE 5 ;Exhibitionist Sense Modification
		RETURNF (TARGET && (BASE:MASTER:TSP >= 1000 || TCVAR:TARGET:Exhibitionist_Nudist_Sense == 1))

	CASE 6 ;Nudist Sense Modification
		RETURNF (TARGET && (BASE:MASTER:TSP >= 1000 || TCVAR:TARGET:Exhibitionist_Nudist_Sense == 2))

	CASE 7 ;Hypno-Date
		RETURNF (TARGET && BASE:MASTER:TSP >= 1000 && !FLAG:デート相手)

	CASE 8 ;Hypno-Orgasm Denial
		RETURNF (TARGET && (BASE:MASTER:TSP >= 500 || CFLAG:TARGET:Hypno_Orgasm_Denial) && !TEQUIP:焦らしモード)

	CASE 9 ;Hypno Trait Alteration
		RETURNF (TARGET && BASE:MASTER:TSP >= 2000 && TALENT:MASTER:催眠技能Lv >= 4)

	CASEELSE
		RETURNF 0

ENDSELECT
[SKIPEND]

@PROCESS_HYPNOSIS_COMMAND(ARG, HYPNO_TARGET)
#DIM HYPNO_TARGET
#DIM 催眠タイプ
#DIM 催眠判定
#DIM 催眠結果
#DIM Strength
#DIM C_ID
#DIM CanTakePanties

催眠タイプ = ARG + 1

;NAS: Replaced
CALL PROCESS_YOUJUTSU_COMMAND(MASTER,HYPNO_TARGET,19,ARG)
RETURN RESULT

IF !DISPELLING_HYPNO(催眠タイプ)
	CALL CHECK_HYPNOSIS_COMMAND_SUCCESS(催眠タイプ, MASTER, HYPNO_TARGET)
	TCVAR:Hypno_Attempts++
	SIF RESULT == 99
		RETURN 99
ENDIF

催眠結果 = RESULT:0
Strength = RESULT:1
SIF nSpoilerMode
	PRINTFORMDL Command strength is {Strength}

IF 催眠結果 > 0
	CALL 催眠発動の呪文(催眠結果)


	SELECTCASE 催眠タイプ
		CASE 1 ;Suppress Hostility
			TALENT:反発抑制 = 1

			IF 催眠判定 > 0
				TALENT:機嫌 = 1
				MARK:反発刻印 = 0
			ELSE
				SIF TALENT:機嫌 < 0
					TALENT:機嫌 = 0
				SIF MARK:反発刻印 > 0
					MARK:反発刻印 -= 1
			ENDIF
			BASE:怒り = 0
			CFLAG:不機嫌 = 0
			CFLAG:ブチギレ = 0
			TCVAR:挿入拒絶 = 0
			PALAM:反感 = 0
			PALAM:不快 = 0
			PALAM:抑鬱 = 0
		CASE 2 ;Fake Consent
			TALENT:合意誤認 = 1
			BASE:ムード = MAX(300 + 100 * 催眠判定, BASE:ムード)
			BASE:理性 = MIN(300 - 100 * 催眠判定, BASE:理性)

		CASE 3 ;Sexual Excitation/Inhibition
			IF TCVAR:発情 == 1
				TCVAR:発情 = 0
				BASE:ムード = MIN(200, BASE:ムード)
				BASE:理性 = MAX(400, BASE:理性)
				IF 催眠判定 > 0
					CFLAG:溜まってる度 = CFLAG:溜まってる度 / 3
					SIF PALAM:欲情 >= 30000
						PALAM:欲情 -= 30000
				ELSE
					CFLAG:溜まってる度 = CFLAG:溜まってる度 / 2
					SIF PALAM:欲情 >= 10000
						PALAM:欲情 -= 10000
				ENDIF
			ELSE
				TCVAR:発情 = 1
				BASE:ムード = MAX(MAXBASE:ムード * (2 + 催眠判定 * 2) / 4, BASE:ムード)
				BASE:理性 = MIN(250 * (2 - 催眠判定), BASE:理性)
				IF 催眠判定 > 0
					CFLAG:溜まってる度 = CFLAG:溜まってる度 * 3
					SIF PALAM:欲情 < 30000
						PALAM:欲情 += 30000
				ELSE
					CFLAG:溜まってる度 = CFLAG:溜まってる度 * 2
					SIF PALAM:欲情 < 10000
						PALAM:欲情 += 10000
				ENDIF
			ENDIF

		CASE 4
			IF TCVAR:Common_Sense_Alteration_Status
				TCVAR:Common_Sense_Alteration_Status = 0

				SIF !EQUIP:0 && TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense != 2
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(2, 0)
			ELSE
				SIF Strength < 0
					STRENGTH = 0
				TCVAR:Common_Sense_Alteration_Status = Strength + 催眠結果

				; IF TCVAR:Common_Sense_Alteration_Status
				; 	CFLAG:うふふ = 1
				; 	CFLAG:MASTER:うふふ = 1
				; ENDIF
			ENDIF

		CASE 5 ;Erogenous Zones
			TALENT:敏感な身体 = !TALENT:敏感な身体

		CASE 6
			SELECTCASE TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense
				CASE 0
					PRINTFORMDL %CALLNAME:HYPNO_TARGET% seems confused that %HE_SHE(HYPNO_TARGET)%'s wearing clothes.
					PRINTFORMDW %HE_SHE(HYPNO_TARGET,1)% quickly strips down to %HIS_HER(HYPNO_TARGET)% underwear and grins, satisfied.
					FOR LOCAL,0,40
						EQUIP:HYPNO_TARGET:LOCAL = 0
						CFLAG:HYPNO_TARGET:(200 + LOCAL) = EQUIP:HYPNO_TARGET:LOCAL
					NEXT
					SIF !TCVAR:HYPNO_TARGET:本来の服装
						TCVAR:HYPNO_TARGET:本来の服装 = CFLAG:HYPNO_TARGET:基本服装セット
					CFLAG:HYPNO_TARGET:基本服装セット = 301
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 1
					CFLAG:Times_Made_Exhibitionist ++

				CASE 1
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(1, 0)
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 0

				CASE 2
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(2, 0)
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 1
					CFLAG:Times_Made_Exhibitionist ++
			ENDSELECT

		CASE 7
			SELECTCASE TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense
				CASE 0, 1
					CanTakePanties = 0
					IF EQUIP:HYPNO_TARGET:下半身下着２ && CFLAG:HYPNO_TARGET:ノーパン == 0
						CanTakePanties = 1
						LOCALS '= PANTSNAME(EQUIP:HYPNO_TARGET:下半身下着２, HYPNO_TARGET)
					ENDIF
					PRINTFORMDL %CALLNAME:HYPNO_TARGET% seems confused that %HE_SHE(HYPNO_TARGET)%'s wearing clothes.
					PRINTFORMDW %HE_SHE(HYPNO_TARGET,1)% quickly undresses %HIMSELF_HERSELF(HYPNO_TARGET)% and grins, satisfied.
					IF CanTakePanties
						SIF !PANTS_ALREADY_COLLECTED()
							SETCOLOR C_PINK
						PRINTFORM Would you like to take %HIS_HER(HYPNO_TARGET)% %LOCALS%?
						IF !PANTS_ALREADY_COLLECTED()
							PRINTFORML  (Not in collection)
						ELSE
							PRINTFORML
						ENDIF
						RESETCOLOR
						CALL ASK_YN
						IF !RESULT
							PRINTFORML You pick up %CALLNAME:HYPNO_TARGET%'s %LOCALS%.
							CALL PANTS_GET(HYPNO_TARGET)
						ELSE
							CFLAG:HYPNO_TARGET:きょうのぱんつ = 0
						ENDIF
					ENDIF

					;Hack: move the clothes removal code down here because PANTS_ALREADY_COLLECTED and PANTS_GET won't work if the character isn't wearing panties
					FOR LOCAL,0,40
						EQUIP:HYPNO_TARGET:LOCAL = 0
						CFLAG:HYPNO_TARGET:(200 + LOCAL) = EQUIP:HYPNO_TARGET:LOCAL
					NEXT
					SIF !TCVAR:HYPNO_TARGET:本来の服装
						TCVAR:HYPNO_TARGET:本来の服装 = CFLAG:HYPNO_TARGET:基本服装セット
					CFLAG:HYPNO_TARGET:基本服装セット = 300
					CFLAG:HYPNO_TARGET:ノーパン = 1
					CFLAG:HYPNO_TARGET:きょうのブラ = 0
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 2
					CFLAG:Times_Made_Nudist ++

				CASE 2
					CALL EXHIBITIONIST_NUDIST_DISPELLED_TEXT(2, 0)
					TCVAR:HYPNO_TARGET:Exhibitionist_Nudist_Sense = 0
			ENDSELECT

		CASE 8
			IF CFLAG:HYPNO_TARGET:行動
				BASE:ARG:仕事量 = 0
				CFLAG:ARG:行動 = 0
				PRINTFORMDW %CALLNAME:HYPNO_TARGET% decides that it's fine if %HE_SHE(HYPNO_TARGET)% clocks out a little early today.
			ENDIF
			PRINTFORMDW %CALLNAME:HYPNO_TARGET% looks a little confused, but agrees to go on a date with you.
			FLAG:催眠デート相手 = HYPNO_TARGET
			CALLF DATEME(HYPNO_TARGET)

		CASE 9
			IF CFLAG:Hypno_Orgasm_Denial && (PALAM:快Ｃ >= PALAMLV:3 || PALAM:快Ｖ >= PALAMLV:3 || PALAM:快Ａ >= PALAMLV:3 || PALAM:快Ｂ >= PALAMLV:3 || PALAM:快Ｍ >= PALAMLV:3)
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%'s body relaxes, and %HE_SHE(HYPNO_TARGET)% moans in relief.
				CFLAG:Hypno_Orgasm_Denial = 0
			ELSEIF !CFLAG:Hypno_Orgasm_Denial && (PALAM:快Ｃ >= PALAMLV:3 || PALAM:快Ｖ >= PALAMLV:3 || PALAM:快Ａ >= PALAMLV:3 || PALAM:快Ｂ >= PALAMLV:3 || PALAM:快Ｍ >= PALAMLV:3)
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%'s body tenses up, and %HE_SHE(HYPNO_TARGET)% moans in frustration.
				CFLAG:Hypno_Orgasm_Denial = 1
			ELSEIF CFLAG:Hypno_Orgasm_Denial
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%'s body relaxes. %HE_SHE(HYPNO_TARGET,1)% seems confused...
				CFLAG:Hypno_Orgasm_Denial = 0
			ELSE
				PRINTFORMDW %CALLNAME:HYPNO_TARGET%'s body tenses up. %HE_SHE(HYPNO_TARGET,1)% seems confused...
				CFLAG:Hypno_Orgasm_Denial = 1
			ENDIF

		CASE 10
			CALL HYPNO_TALENT_REASSIGN
	ENDSELECT
ENDIF

PRINTL 

;Display images
IF 顔絵付きメッセージ
	RESULTS =
	キャラ画像表示サイズ比 = 100
	IF RESULT == 0
		CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "笑顔")
		SIF !RESULT
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "通常")
	ELSEIF RESULT == 1 || RESULT == 2
		CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "発情")
		SIF !RESULT
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "通常")
	ELSEIF RESULT == 2
		IF TCVAR:発情 == 1
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", "裸", "発情")
			SIF !RESULT
				CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "通常")
		ELSE
			CALL GET_BASE_RESOURCE(HYPNO_TARGET, "顔絵", , "発情")
		ENDIF
	ENDIF
	SIF FLAG:マルチサイズ
		デフォルトキャラ画像横幅 = SPRITEHEIGHT(RESULTS)
	CALL IMAGE_SET(RESULTS, 0, 0, キャラ画像表示サイズ比, 0)
	CALL SIMULTANEOUS_IMAGE_DISPLAY(0, 0, 1, -1)
ENDIF
;#; PRINTFORMDL Sending message with type {催眠タイプ} and status {催眠結果}
CALL KOJO_MESSAGE_SEND("EVENT",666,HYPNO_TARGET,催眠タイプ,催眠結果)
IF RESULT > 0
	PRINTL 
ELSEIF 顔絵付きメッセージ
	PRINTW 
ENDIF

催眠判定 = 0

RETURN 催眠結果

@CHECK_HYPNOSIS_COMMAND_SUCCESS(催眠タイプ, HYPNOTIST, HYPNO_TARGET)
#DIM DYNAMIC 催眠タイプ
#DIM DYNAMIC 催眠判定
#DIM DYNAMIC 催眠結果
#DIM DYNAMIC C_ID
#DIM DYNAMIC HYPNOTIST
#DIM DYNAMIC HYPNO_TARGET
#DIM DYNAMIC HYPNOTIST_ROLL
#DIM DYNAMIC HYPNO_TARGET_ROLL
#DIM DYNAMIC HYPNOTIST_BONUS
#DIM DYNAMIC HYPNO_TARGET_BONUS
#DIM DYNAMIC HYPNOTIST_TOTAL_SCORE
#DIM DYNAMIC HYPNO_TARGET_TOTAL_SCORE
#DIM DYNAMIC HYPNOTIST_BASE_ROLL
#DIMS DYNAMIC EFFECTIVENESS_MULTIPLIER_TEXT
#DIMS DYNAMIC RESISTANCE_MULTIPLIER_TEXT

;NAS REPLACED WITH MAGIC SYSTEM IN
CALL CHECK_COMMAND_SUCCESS_YOUJUTSU_19(MASTER,TARGET,催眠タイプ)
	RETURN RESULT,RESULT:1
;NAS edits, already covered by Youjutsu system

IF GROUPMATCH(催眠タイプ, 6, 7)
	BASE:HYPNOTIST:TSP -= 1000
ELSEIF 催眠タイプ == 10
	BASE:HYPNOTIST:TSP -= 2000
ELSE
	BASE:HYPNOTIST:TSP -= 500
ENDIF
催眠判定 = 0

IF !CFLAG:HYPNO_TARGET:睡眠
	;対抗
	$HYPNO_CHECK

	CALL HANDLE_SPECIAL_HYPNOSIS_CASES(催眠タイプ)
	IF RESULT == 99
		RESETCOLOR
		RETURN 99
	ENDIF

	;HYPNOTIST_ROLL = 1 + RAND:(MAX(1, (30 + TALENT:HYPNOTIST:催眠技能Lv*20)))
	[IF_DEBUG]
		; HYPNOTIST_ROLL += 9999
	[ENDIF]
	HYPNO_TARGET_ROLL = 1 + RAND:(MAX(1, ((100 - (ABL:HYPNO_TARGET:催眠奴隷*10)) + (10 * TCVAR:HYPNO_TARGET:Hypno_Attempts))))

	HYPNOTIST_BONUS = 0
	HYPNO_TARGET_BONUS = 0

	SIF TALENT:HYPNOTIST:禁断の知識
		HYPNOTIST_BONUS += 20
	SIF CFLAG:HYPNO_TARGET:うふふ
		HYPNOTIST_BONUS += 30

	SIF TALENT:HYPNO_TARGET:禁断の知識
		HYPNO_TARGET_BONUS += 20
	SIF TALENT:HYPNO_TARGET:淫乱
		HYPNO_TARGET_BONUS -= 20
	SIF TALENT:HYPNO_TARGET:服従
		HYPNO_TARGET_BONUS -= 20
	SIF TALENT:HYPNO_TARGET:妄信
		HYPNO_TARGET_BONUS -= 20
	SIF TALENT:HYPNO_TARGET:妄想の産物
		HYPNO_TARGET_BONUS -= 100

	SELECTCASE TALENT:HYPNO_TARGET:人間
						;仙人
		CASE 2
			HYPNO_TARGET_BONUS += 30
						;天人
		CASE 3
			HYPNO_TARGET_BONUS += 30
						;月人
		CASE 4
			HYPNO_TARGET_BONUS += 20
						;魔界人
		CASE 5
			HYPNO_TARGET_BONUS += 10
	ENDSELECT
	SIF TALENT:HYPNO_TARGET:妖怪
		HYPNO_TARGET_BONUS += 30
	SIF TALENT:HYPNO_TARGET:妖精
		HYPNO_TARGET_BONUS += 10
	SIF TALENT:HYPNO_TARGET:神霊
		HYPNO_TARGET_BONUS += 50
	SIF TALENT:HYPNO_TARGET:幽霊
		HYPNO_TARGET_BONUS += 30
	SIF TALENT:HYPNO_TARGET:付喪神
		HYPNO_TARGET_BONUS += 30
	SIF TALENT:HYPNO_TARGET:人形
		HYPNO_TARGET_BONUS += 30
	SELECTCASE TALENT:HYPNO_TARGET:追加種族
						;巫女
		CASE 1
			HYPNO_TARGET_BONUS += 20
						;蓬莱人
		CASE 4
			HYPNO_TARGET_BONUS += 20
	ENDSELECT

	HYPNOTIST_BONUS = MAX(0, HYPNOTIST_BONUS + (15 * BASE:HYPNOTIST:体力) / MAXBASE:HYPNOTIST:体力 + (25 * BASE:HYPNOTIST:気力) / MAXBASE:HYPNOTIST:気力 - (100 * BASE:HYPNOTIST:酒気) / MAXBASE:HYPNOTIST:酒気 + ABL:HYPNOTIST:技巧 * 15 + ABL:HYPNOTIST:教養 * 15)
	HYPNO_TARGET_BONUS = MAX(0, HYPNO_TARGET_BONUS + MARK:HYPNO_TARGET:反発刻印 * 30 + (50 * BASE:HYPNO_TARGET:体力) / MAXBASE:HYPNO_TARGET:体力 + (75 * BASE:HYPNO_TARGET:気力) / MAXBASE:HYPNO_TARGET:気力 - (75 * BASE:HYPNO_TARGET:ムード) / MAXBASE:HYPNO_TARGET:ムード + (100 * BASE:HYPNO_TARGET:理性) / MAXBASE:HYPNO_TARGET:理性 + (100 * BASE:HYPNO_TARGET:怒り) / MAXBASE:HYPNO_TARGET:怒り - (100 * BASE:HYPNO_TARGET:酒気) / MAXBASE:HYPNO_TARGET:酒気 - CFLAG:HYPNO_TARGET:信頼度 / 10 - ABL:HYPNO_TARGET:親密 * 3 - ABL:HYPNO_TARGET:従順 * 5 - ABL:HYPNO_TARGET:欲望 * 7 + MIN(ABL:HYPNO_TARGET:技巧, 10) * 10 + ABL:HYPNO_TARGET:教養 * 15)

		;This is so characters with higher levels of hypno resistance aren't always getting Critical Successes from the bonuses to their base resistance rolls
	HYPNOTIST_BASE_ROLL = HYPNO_TARGET_ROLL

							;added
	SELECTCASE TALENT:HYPNOTIST:催眠耐性
		CASE -2
			TIMES HYPNOTIST_ROLL , 0.50
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%/ 2
		CASE -1
			TIMES HYPNOTIST_ROLL , 0.75
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 3/4
		CASE 1
			TIMES HYPNOTIST_ROLL , 1.5
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 1.5
		CASE 2
			HYPNOTIST_ROLL *= 2
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 2
		CASE 3
			HYPNOTIST_ROLL *= 3
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 3
		CASE 4
			HYPNOTIST_ROLL *= 10
			EFFECTIVENESS_MULTIPLIER_TEXT = %" "%* 10
	ENDSELECT

					;added
	SELECTCASE TALENT:HYPNO_TARGET:催眠耐性
		CASE -2
			TIMES HYPNO_TARGET_ROLL , 0.50
			RESISTANCE_MULTIPLIER_TEXT = %" "%/ 2
		CASE -1
			TIMES HYPNO_TARGET_ROLL , 0.75
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 3/4
		CASE 1
			TIMES HYPNO_TARGET_ROLL , 1.5
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 1.5
		CASE 2
			HYPNO_TARGET_ROLL *= 2
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 2
		CASE 3
			HYPNO_TARGET_ROLL *= 3
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 3
		CASE 4
			HYPNO_TARGET_ROLL *= 10
			RESISTANCE_MULTIPLIER_TEXT = %" "%* 10
	ENDSELECT

		;Special case: Sekibanki (has multiple heads, so randomize her resistance to represent you hitting more/fewer of them)
	IF HYPNO_TARGET == [[蛮奇]]
		SELECTCASE RAND:3
			CASE 0
