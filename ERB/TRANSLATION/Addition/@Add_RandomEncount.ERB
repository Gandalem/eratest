			CALL SPTALK, 0, @"평상시: 나체", 21, @"「뭐라고?!」/「그래서 %HE_SHE(MASTER)%가 그 일에 좀 어색해 보였던 거구나, 응?」/「야생에서 그런 걸 자주 만나진 못하잖아, 그렇지?」", 1, TOSTR(色１, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 23, @"「\@ IS_CHILD(MASTER) ? 헤헤, 그럴 만하네, 결국 애잖아... # 그래, 특히 어른들 말이야. 뒤늦게 피는 거니?」\@", 1, TOSTR(色３, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 21, @"「아하하하!」", 1, TOSTR(色１, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 22, @"「헤헤, 헤헤, 헤헤!」", 1, TOSTR(色２, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 23, @"「흐뭇하네...」", 1, TOSTR(色３, "X")
			WAIT
			PRINTFORMW 모든 타누키들이 당신을 응시하며 소름 끼치게 깔깔 웃기 시작한다.
			CALL SPTALK, 0, @"평상시: 나체", 23, @"「음, 아마 %HE_SHE(MASTER)%이 이곳에 온 것은 바로 %HIS_HER(MASTER)%가 성숙해지는 길을 찾기 위해서였는지 모르겠군.」", 1, TOSTR(色３, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 21, @"「그래서 어떻게 생각해, %呼び名%? 우리 도움을 받고 싶니, 응~?」", 1, TOSTR(色１, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 22, @"「아무도 묻지도 않았잖아!」", 1, TOSTR(色２, "X")
			WAIT
			CALL SPTALK, 0, @"미소:나체", 23, @"「노오프!」", 1, TOSTR(色３, "X")
			WAIT
			PRINTFORMW 다른 두 너구리가 양쪽에서 당신을 붙잡고 있고, 첫 번째 너구리는 위에 앉아 당신이 한 치의 움직임도 못 하게 막는다!
			SETCOLOR 色１
		ENDIF
ENDSELECT
;caught prey event extra

@Add_Hunt_Ev(nLuck, strPrey, nPartner)
#DIM nLuck
#DIMS strPrey
#DIM nPartner
#DIM DYNAMIC nBake
PRINTFORMW 동물과 사냥꾼에게 연민을 느끼지만, %PRINT_MALE("남자라면 먹고 살아야지:그게 자연의 섭리다", MASTER)%.
PRINTFORMW 시간을 낭비하지 않고 재빨리 동물을 쓰러뜨리고 일에 착수한다.
SIF nPartner
	PRINTFORMW %CALLNAME:nPartner%은(는) 눈썹을 치켜든 채 당신을 가만히 응시하지만 아무 말도 하지 않는다.
IF nLuck > 7
	PRINTFORMW 평소보다 훨씬 더 격렬하게 비명을 지르더니 끝까지 저항하다가 마침내 조용해졌다.
	PRINTFORMW ...이상하다.
	nBake = 1
ENDIF
PRINTFORML
PRINTFORML 음~음~음!
PRINTFORML %CAPITALIZE(strPrey)% 스튜!
PRINTFORML %CAPITALIZE(strPrey)% 사시미!
PRINTFORML %CAPITALIZE(strPrey)% 가라아게!
PRINTFORML %CAPITALIZE(strPrey)% 스테이크!
PRINTFORMW 음~음~음!
PRINTFORML
PRINTFORMW 노래를 흥얼거리며 그것으로 만들 수 있는 요리를 상상하던 당신은 마침내 부정한 전리품을 받는다.
SELECTCASE strPrey
	CASE "tanuki"
		LOCAL = 7
	CASE "fox"
		LOCAL = 10
	CASE "rabbit"
		LOCAL = 13
	CASE "cat"
		LOCAL = 12
ENDSELECT
CALL GET_ITEM(ITEMNAME:702, (2 + SPOIL_ENHANCEMENT(LOCAL)), 2)
IF nBake
	PRINTFORMW 이 고기는 좀 이상하지만, 괜찮을 거겠지... 그렇지?
	CALL GET_ITEM(ITEMNAME:705, 1, 2)
ENDIF
PRINTFORMW +60분
TIME += 60
PRINTFORML
IF nPartner && nBake
	PRINTFORMW 어떤 이유에서인지 %CALLNAME:nPartner%는 그것에 대해 상당히 언짢은 듯하다. 보는 것이 그렇게 불쾌했나...?
	BASE:nPartner:ムード = BASE:nPartner:ムード / 3
ELSEIF nLuck < 4
	PRINTFORML ...하지만 떠나려 준비하는 순간, 등 뒤에 누군가 서 있다는 것을 깨달았다.
	PRINTFORMW 돌아보니 사냥꾼이 분노로 들끓으며 도둑맞은 먹이에 대해 정말 격분하고 있었다...!
	IF nPartner
		PRINTFORMW 정신 차려보니, %CALLNAME:nPartner%는 이미 온 데가 보이지 않았다!
		PRINTFORMW 저 작은...
	ENDIF
	IF nRyona
		LOCAL = FREE_MOB_SLOT()
		CALL SpawnMobEnemy(LOCAL,28)
		CALL KNIFE_FIGHT(LOCAL,MASTER)
	ENDIF
	IF isDead:LOCAL:0
		PRINTFORMW 기분이 들떠서, 당신\@ nPartner ? %" "%와 %CALLNAME:nPartner% #  \@ 돌아가 오늘 먹을 것이 생겼다니 행복해했다.
		PRINTFORMW 사냥꾼이 가엾게 느껴지지만, 그곳은 잔혹한 세계이고 약자는 강자에게 죽는다.
	ELSEIF BASE:LOCAL:0 <= 500
		PRINTFORMW %HE_SHE(LOCAL,1)%시도하지만 몸을 비틀며 비명을 지르고 피를 쏟는다.
		PRINTFORMW 당신은 발의 힘으로 죽어가는 사냥꾼을 짓밟아 %HIM_HER(LOCAL)%를 %HIS_HER(LOCAL)%의 고통에서 벗어나게 한다.
		CALL SET_HISTORY_DEATH(LOCAL,MASTER,9340)
		PRINTFORML
		PRINTFORMW 기분이 좋아서, 당신은 \@ nPartner ? %" "%그리고 %CALLNAME:nPartner%는 #  \@ 행복하게 오늘 먹을 것이 생겨 돌아간다.
		PRINTFORMW 당신은 사냥꾼이 가엾게 느껴지지만, 윤계는 잔혹한 세상이고 약자는 강자를 위해 죽는다.
	ELSEIF lcWarResult == CurrentBattle:Battle_PlayerSide
		;win, non lethal
		PRINTFORML 사냥꾼은 출구가 없음을 보고 당신에게 항복했다.
		PRINTFORML 사냥꾼은 당신에게 고기를 준다.
		PRINTFORMW 기분이 좋아진 당신은 \@ nPartner ? %" "%그리고 %CALLNAME:nPartner% #  \@ 집으로 돌아가며, 오늘 먹을 것이 생겨 행복해한다.
	ELSE
		PRINTFORML
		PRINTFORML 네 죄에 대해 머리를 얻어맞는다!
		PRINTFORML ...더 세게!
		CALL RECOVER(MASTER, -300, "体力")
		WAIT
		PRINTFORML 게다가 길게 꾸중을 듣기도 한다...
		CALL RECOVER(MASTER, -300, "気力")
		WAIT
		PRINTFORML 그리고 물론, 당신은 모든 고기를 돌려주도록 강요받았다...
		CALL LOST_ITEM(ITEMNAME:702, (2 + SPOIL_ENHANCEMENT(LOCAL)), 2)
		IF nBake
			PRINTFORML 하지만 그 이상한 고기 조각은 계속 가지고 있어야 한다. 또, 이상하네...
		ENDIF
		WAIT
		PRINTFORML 어쩌면 도둑질이 최선의 선택은 아니었을지도 모른다고 생각하며 집으로 힘겹게 걸어간다.
		PRINTFORMW +60분
		TIME += 60
	ENDIF
ELSE
	PRINTFORMW 기분이 좋아진 채 너는 \@ nPartner ? %" "%과 %CALLNAME:nPartner% #  \@이 오늘 먹을 것이 생겼다는 사실에 행복해하며 집으로 돌아온다.
ENDIF
