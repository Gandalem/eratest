@Add_Mob_DouteiExp(ARG, ARGS, LESBIAN, 店員)
#DIM LESBIAN
#DIM 店員
IF !IS_DOUTEI(ARG) && HAS_PENIS(ARG)
	EXP:ARG:Ｃ経験 += 20 + RAND:5 + 店員 * 30
	ABL:ARG:欲望 += RAND:3 + 店員 * 4
	ABL:ARG:Ｃ感覚 += 1 + 店員 * 3
	IF !RAND:5 && (TALENT:ARG:貞操 < 1 || 店員)
		TALENT:ARG:ヤリマン = 1
		ABL:ARG:Ｃ感覚 += RAND:2 + 2 + 店員 * 3
		EXP:ARG:Ｃ経験 += 50 + RAND:20 + 店員 * 30
	ENDIF
	EXP:ARG:挿入経験 = EXP:ARG:Ｃ経験
	EXP:ARG:射精経験 = (EXP:ARG:挿入経験 * 3 / 4 ) + RAND:((10  + 店員 * 60) * POWER(1 + TALENT:ARG:ヤリマン, 2))
	IF !RAND:15
		IF TALENT:ARG:人間
			CSTR:ARG:童貞喪失履歴 = %TEXTR("대수롭지 않게 버렸다/요정의 장난으로 잃었다/마을 인간에게 강간당했다/요괴에게 강간당했다/근처의 처녀 사냥꾼에게 잃었다/매춘부에게 잃었다")%
		ELSEIF ARGS == "鬼"
			CSTR:ARG:童貞喪失履歴 = %TEXTR("싸구려 독주를 너무 마시고 쓰러진 사이 잃었다/전투에서 패배한 뒤 잃었다/신계획 소속 매춘부에게 잃었다")%
		ELSE
			CSTR:ARG:童貞喪失履歴 = %TEXTR("상사에게 강요당했다/근처의 처녀 사냥꾼에게 잃었다/요괴 퇴치사에게 강간당했다/매춘부에게 잃었다")%
		ENDIF
	ELSEIF TALENT:ARG:倒錯的 && !RAND:10
		CSTR:ARG:童貞喪失履歴 = %TEXTR("여동생/언니")%에게 바쳤다
	ELSEIF !RAND:7 && !TALENT:ARG:人間
		CSTR:ARG:童貞喪失履歴 = 인간 마을에서 납치한 %TEXTR("소녀/여인/숙녀")%와 함께 버렸다
	ELSEIF TALENT:ARG:人妻 && !RAND:2
		CSTR:ARG:童貞喪失履歴 = 어느 순간 \@ !LESBIAN ? 호기심 많은 남편 # 호기심 많은 아내 \@에게 %TEXTR("사랑을 나누며/사랑 없이")% 바쳤다
	ELSEIF ARGS == "サキュバス"
		CSTR:ARG:童貞喪失履歴 = %TEXTR("난교 중 아무 망설임 없이 잃었다/성년이 되자마자 잃었다/눈에 띈 첫 인간을 그 자리에서 덮쳐 버렸다/우연히 만난 여자와 함께 버렸다/생면부지의 타인에게 바쳤다")%
	ELSE
		CSTR:ARG:童貞喪失履歴 = Gave it to %TEXTR(@"그녀의 남자친구/전 남자친구/직장 동료/아무런 혈연관계가 없는 누군가")%
	ENDIF
	SIF TALENT:ARG:人妻
		CSTR:ARG:童貞喪失履歴 = %REPLACE(@"%CSTR:ARG:童貞喪失履歴%","her boyfriend","her ex-boyfriend")%
	SIF 店員 && STRCOUNT(CSTR:ARG:童貞喪失履歴, "(Lost|raped|related|co-worker)") && RAND:2
		CSTR:ARG:童貞喪失履歴 = 첫 손님에게 %TEXTR("빼앗겼다/비싼 값에 팔았다/잃었다")%
	IF ARGS == "町娘"
		CSTR:ARG:童貞喪失履歴 = %REPLACE(@"%CSTR:ARG:童貞喪失履歴%","co-worker","classmate")%
	ENDIF
	IF LESBIAN == 1
		CSTR:ARG:童貞喪失履歴 = %REPLACE(@"%CSTR:ARG:童貞喪失履歴%","boyfriend","girlfriend")%
	ENDIF
ENDIF

