@DAILY_EV35
#DIM お尻神
;CASE 9は未完成だから
お尻神 = RAND:9
PRINTFORMW 잠이 들려고 할 무렵, 기적 같은 목소리를 듣는다.
PRINTFORML 
SETCOLOR C_AQUA
FONTBOLD
;微妙に変化させる
SELECTCASE お尻神
	CASE 0 TO 4
		PRINTFORMW ...내 목소리 들리니... ...내 목소리 들리니... %CALLNAME:MASTER%... %CALLNAME:MASTER%... 
		PRINTFORMW ...이제... 네 마음속에 직접 말하는 거야... 내 목소리 들리니......
	CASE 5,6
		PRINTFORML ...내 목소리 들려?... ...내 목소리 들려?... %CALLNAME:MASTER%... %CALLNAME:MASTER%...
		PRINTFORMW ...이제... 당신의... 심장에게 직접 말한다... 내 목소리 들려...?
	CASE 7,8
		PRINTFORML ...내 목소리 들리니...... 내 목소리 들리니... %조사처리(CALLNAME:MASTER,"는")%(는)... %조사처리(CALLNAME:MASTER,"는")%(는)...
		PRINTFORMW ...이제... 나는 직접... 당신의... 심장에 말하는 거야... 내 목소리 들리니......?
	CASE 9
		PRINTFORML ...나 들리니... ...나 들리니... %조사처리(CALLNAME:MASTER,"는")%(는)... %조사처리(CALLNAME:MASTER,"는")%(는)...
		PRINTFORMW ...이제...... 나는 직접 말한다... 너의... 심장에... 나 들리니......?
ENDSELECT
PRINTFORML 
PRINTFORMW 큰 엉덩이 아니면 작은 엉덩이, 어느 쪽을 선호하느냐......
RESETCOLOR
FONTREGULAR
;CALL COLORMESSAGE("あなたは大きいおっぱいと小さいおっぱい、どちらが好きですか……","AQUA",1,1)
;qol custom code
LOCAL = CFLAG:MASTER:累計膣内精液 + CFLAG:MASTER:累計アナル精液 + CFLAG:MASTER:累計精飲
CALL ASK_M("큰 것들",1,"작은 것들",1,"부츠는 순위가 없다",1,"나에게 존재하는 신은 오직 한 분뿐이다... 너 따위가 아니다!", 1) ;qol custom code, option to ignore the question
IF RESULT == 3 ;qol custom code
	PRINTFORML 그렇게 무례한 응답은 그들을 광란에 빠뜨리고, 그들은 벌을 내릴 준비를 하며 후하고 불어댄다...
	PRINTFORMW 하지만 %PantsuSama()%의 이름을 외치자, 그들은 황급히 물러난다. 괜찮았나...?
	RETURN 1
ENDIF
SELECTCASE お尻神
	CASE 0 TO 4
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORMW 설문에 협조해 주셔서 감사합니다...... 보상이 여기 있습니다......
		RESETCOLOR
		FONTREGULAR
		PRINTFORML 키바안!
		PRINTFORMW \\1000이 당신의 계정으로 전송되었다!
		MONEY += 1000
	CASE 5,6
		;巨乳の神
		SELECTCASE RESULT
			CASE 0
				CALL OSHIRIANSWER(1,1)
			CASE 1
				CALL OSHIRIANSWER(1,-1)
			CASE 2
				CALL OSHIRIANSWER(1,0)
			CASE 3
				CALL OSHIRIANSWER(1,2)
		ENDSELECT
	CASE 7,8
		;貧乳の神
		SELECTCASE RESULT
			CASE 0
				CALL OSHIRIANSWER(-1,-1)
			CASE 1
				CALL OSHIRIANSWER(-1,1)
			CASE 2
				CALL OSHIRIANSWER(-1,0)
			CASE 3
				CALL OSHIRIANSWER(-1,2)
		ENDSELECT
	CASE 9
		SELECTCASE RESULT
			CASE 0,1
				CALL OSHIRIANSWER(2,-1)
			CASE 2
				CALL OSHIRIANSWER(2,2)
		ENDSELECT
ENDSELECT
PRINTFORMW 
RETURN 1

@OSHIRIANSWER(ARG,ARG:1)
IF ARG:1 == -1
	;CALL COLORMESSAGE("滅びよ悪しき者！！！","RED",1,1)
	SETCOLOR C_RED
	FONTBOLD
	PRINTFORMW 너 같은 사악한 자 같으니!!!
	RESETCOLOR
	FONTREGULAR
	PRINTFORML 머리에 치명적인 일격을 맞은 후, 당신은 의식을 잃는다...
	BASE:MASTER:体力 -= 5000
ELSEIF ARG:1 == 2
	CALL COLORMESSAGE("에헤, 저건 뭐였지...",C_AQUA,1,1)
	PRINTFORML 목소리가 조용해진다.
ELSEIF !ARG:1
	;これが正解の分岐を後で作る
	;PRINTFORML あなたは心底おっぱいを愛しているのですね……
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORMW 믿음이 없는 자는...
	RESETCOLOR
	FONTREGULAR
	;CALL COLORMESSAGE("哀れなる信念なき者……","AQUA",1,1)
	PRINTFORML 목소리가 침묵한다.
ELSE
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORML 당신의 소원을 잊지 않고 있기에, \@ ARG < 0 ? 작은 # 큰 \@ 엉덩이들은 언제나 당신의 아군일 것이다...
	PRINTFORML 당신은 \@ ARG < 0 ? 작은 # 큰 \@ 엉덩이들을 위한 미사용 신성한 호의를 가지고 있다...
	RESETCOLOR
	FONTREGULAR
	CALL ASK_YN("엉덩이를 만지다","엉덩이에 축복을 내리다")
	IF RESULT
		PRINTFORML 누구의 것인가?
		DRAWLINE
		FOR LOCAL,0,CHARANUM
		SIF IS_MALE(LOCAL) ;custom code bug fix
			CONTINUE
		IF ARG > 0
			SIF TALENT:LOCAL:ヒップサイズ < 2
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
		ELSE
			SIF TALENT:LOCAL:ヒップサイズ > -2
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
		ENDIF
		NEXT
		PRINTFORML 
		DRAWLINE
		PRINTFORML [999] 정지
		$INPUT_LOOP ;custom code bug fix
		INPUT
		SIF RESULT < CHARANUM && IS_MALE(RESULT) ;custom code bug fix
			GOTO INPUT_LOOP
		SELECTCASE RESULT
			CASE 0 TO CHARANUM
				SETCOLOR C_AQUA
				FONTBOLD
				PRINTFORMW %CALLNAME:RESULT%의 뒤가 축복받았다...
				RESETCOLOR
				FONTREGULAR
				IF ARG > 0
					TALENT:RESULT:ヒップサイズ ++
					PRINTFORMW %CALLNAME:RESULT%의 엉덩이가 커졌다!
				ELSE
					TALENT:RESULT:ヒップサイズ --
					PRINTFORMW %CALLNAME:RESULT%의 엉덩이가 줄어든다!
				ENDIF
			CASEELSE
		ENDSELECT
	ELSE
		;揉ませてもらえる分岐は未完成
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORML 당신이 그들에 대한 연모를 키운 후에 내가 그들을 만지게 해 주겠다...
		IF !TALENT:MASTER:器用な指
			PRINTFORMW 대신, 더 뛰어난 기술로 엉덩이를 만질 수 있게 해주는 기교를 가르쳐 주겠다...
			RESETCOLOR
			FONTREGULAR
			PRINTFORMW 당신은 능숙한손가락이 되었다!
			TALENT:MASTER:器用な指 = 1
		ENDIF
		RESETCOLOR
		FONTREGULAR
	ENDIF
	PRINTFORML 엉덩이의 안락함에 싸인 듯, 당신의 의식은 잠들면서 멀어진다...
ENDIF
