SELECTCASE お尻神
	CASE 0 TO 4
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORMW Thank you for cooperating on this questionnaire...... Here is a reward......
		RESETCOLOR
		FONTREGULAR
		PRINTFORML Kyabaan!
		PRINTFORMW \\1000 is transferred to your account!
		MONEY += 1000
	CASE 5,6
	;巨乳の神
		SELECTCASE RESULT
			CASE 0
				CALL OSHIRIANSWER(1,1)
			CASE 1
				CALL OSHIRIANSWER(1,-1)
			CASE 2
				CALL OSHIRIANSWER(1,0)
			CASE 3
				CALL OSHIRIANSWER(1,2)
		ENDSELECT
	CASE 7,8
	;貧乳の神
		SELECTCASE RESULT
			CASE 0
				CALL OSHIRIANSWER(-1,-1)
			CASE 1
				CALL OSHIRIANSWER(-1,1)
			CASE 2
				CALL OSHIRIANSWER(-1,0)
			CASE 3
