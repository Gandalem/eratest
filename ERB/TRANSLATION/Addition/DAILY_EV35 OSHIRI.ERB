@OSHIRIANSWER(ARG,ARG:1)
IF ARG:1 == -1
	;CALL COLORMESSAGE("滅びよ悪しき者！！！","RED",1,1)
	SETCOLOR C_RED
	FONTBOLD
	PRINTFORMW Fall you evil one!!!
	RESETCOLOR
	FONTREGULAR
	PRINTFORML Following a terrible blow to the head, you lose consciousness...
	BASE:MASTER:体力 -= 5000
ELSEIF ARG:1 == 2
	CALL COLORMESSAGE("Ehh what was that...",C_AQUA,1,1)
	PRINTFORML The voice falls silent.
ELSEIF !ARG:1
		;これが正解の分岐を後で作る
		;PRINTFORML あなたは心底おっぱいを愛しているのですね……
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORMW One lacking belief...
	RESETCOLOR
	FONTREGULAR
			;CALL COLORMESSAGE("哀れなる信念なき者……","AQUA",1,1)
	PRINTFORML The voice falls silent.
ELSE
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORML As we have not forgotten your wishes, \@ ARG < 0 ? small# big\@ butts will always be your ally...
	PRINTFORML You have an unused divine favor for \@ ARG < 0 ? small# big\@ butts...
	RESETCOLOR
	FONTREGULAR
	CALL ASK_YN("Fondle a butt","Bless a butt")
	IF RESULT
		PRINTFORML Whose?
		DRAWLINE
		FOR LOCAL,0,CHARANUM
			SIF IS_MALE(LOCAL) ;custom code bug fix
				CONTINUE
			IF ARG > 0
				SIF TALENT:LOCAL:ヒップサイズ < 2
					PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
			ELSE
				SIF TALENT:LOCAL:ヒップサイズ > -2
					PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
			ENDIF
		NEXT
		PRINTFORML 
		DRAWLINE
		PRINTFORML [999] Stop
		$INPUT_LOOP ;custom code bug fix
		INPUT
		SIF RESULT < CHARANUM && IS_MALE(RESULT) ;custom code bug fix
			GOTO INPUT_LOOP
		SELECTCASE RESULT
			CASE 0 TO CHARANUM
				SETCOLOR C_AQUA
				FONTBOLD
				PRINTFORMW %CALLNAME:RESULT%'s butt is blessed...
				RESETCOLOR
				FONTREGULAR
				IF ARG > 0
					TALENT:RESULT:ヒップサイズ ++
					PRINTFORMW %CALLNAME:RESULT%'s butt became bigger!
				ELSE
					TALENT:RESULT:ヒップサイズ --
					PRINTFORMW %CALLNAME:RESULT%'s butt shrinks!
				ENDIF
			CASEELSE
		ENDSELECT
	ELSE
		;揉ませてもらえる分岐は未完成
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORML I will let you fondle them once your love for them has grown...
		IF !TALENT:MASTER:器用な指
			PRINTFORMW Instead, I will teach you a technique that will let you fondle butts with greater skill...
			RESETCOLOR
			FONTREGULAR
			PRINTFORMW You have become [Nimble-fingered]!
			TALENT:MASTER:器用な指 = 1
		ENDIF
		RESETCOLOR
		FONTREGULAR
	ENDIF
	PRINTFORML Seemingly wrapped in the comfort of butts, your consciousness wanders away as you fall asleep...
ENDIF
