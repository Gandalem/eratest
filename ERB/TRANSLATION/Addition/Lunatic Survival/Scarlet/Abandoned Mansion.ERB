@TA_LS_SCARLET_ABANDONED_MANSION_GARDEN_COMMAND_MOVE(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "door","entrance","inside","in","house","mansion","kitchen","backdoor"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEnteredMansion)
			CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Kitchen")
			GOTO SKIPWAIT
		ELSE
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLantern)
				PRINTFORMDL %BREAKENG(@"당신은 조심스럽게 잠금 해제된 문을 열고 저택 안을 들여다본다...")%
				PRINTL
				PRINTFORMDL %BREAKENG(@"안은 어둡고 문을 활짝 열어도 빛이 거의 들어오지 않는다. 당신은 등불을 들고 문턱을 넘어 주방을 비춘다.")%
				CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Kitchen")
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEnteredMansion,1)
			ELSEIF TALENT:MASTER:形状 == 4
				PRINTFORMDL %BREAKENG(@"당신은 조심스럽게 잠기지 않은 문을 열고 저택 안으로 발을 들인다. 부엌은 칠흑같이 어둡지만, 당신은 성기를 꺼내 희미하고 부드럽게 맥동하는 빛에 몸을 담근다.")%
				CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Kitchen")
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEnteredMansion,1)
			ELSE
				PRINTFORMDL 안이 너무 어두워서 아무것도 보이지 않는다. 빛의 근원이 필요하다.
			ENDIF
		ENDIF
	CASE "deeper"
		PRINTFORMDL 당신은 길을 잃지 않고 이 숲 더 깊이 들어갈 수 없다.
	CASE "approach","back","front","forest","trees","thicket"
		PRINTFORMDL 당신은 집의 앞으로 가기 위해 숲을 통과하여 돌아온다.
		CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Approach")
	CASE "barn"
		CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Barn")
		GOTO SKIPWAIT
	CASEELSE
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
$SKIPWAIT
RESULT = 1
RETURN RESULT

