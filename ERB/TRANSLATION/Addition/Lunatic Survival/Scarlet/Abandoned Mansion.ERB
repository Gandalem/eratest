					PRINTFORMDL %BREAKENG(@"You tip the \@ GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan) ? watering can and sprinkle # bucket and pour\@ phantom water over the weedy former garden...")%
					PRINTL
					PRINTFORMDL %BREAKENG(@"...And within seconds, vivacious green plants sprout up between the iron fences, instantly producing ripe red strawberries.")%
					CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMWater,-1)
					CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMWateredGarden,1)
