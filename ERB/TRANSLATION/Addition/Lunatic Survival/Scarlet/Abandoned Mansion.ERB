@TA_LS_SCARLET_ABANDONED_MANSION_SAFE(OpenMethod)
#DIM DYNAMIC OpenMethod
IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletTool),QBitLSScarletAMDevilBook)
	PRINTFORMDW The safe is empty.
	RETURN
ENDIF
IF !OpenMethod
	PRINTFORMDL The safe is sealed with a combination lock.
	PRINTL
	{
		CALL ASK_M(
			"Enter the code",1,
			"Use the kappa security kit to crack it",GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletTool),QBitLSScarletSecurityKit),
			"Leave it alone",1,
		)
	}
	PRINTL
	OpenMethod = RESULT+1
ENDIF
SELECTCASE OpenMethod
	CASE 1
		PRINTFORMDL Input the code to the safe.
		PRINTL
		PRINTFORMDL >
		INPUT
		PRINTL
		IF RESULT == 1574
			$OPEN
			PRINTFORMDW A metallic clunk sounds within the safe door and it gently swings open, granting you access to the inside.
			PRINTFORMDW The only thing in the safe is a single book, which you recognize as the devil's book that's supposed to be in Patchouli's possession.
			PRINTFORMDW ...As expected, your hands pass through it if you grip it too tightly. The book is a phantom of something that used to be here.
			PRINTFORMDW Opening it up, you find that the text inside is smeared across the page. You can't read it. It's little more than a heavy leather rectangle.
			PRINTL
			PRINTFORMDW With no reason to leave it behind, you take the phantom book with you.
			SIF RESULT != 1574
				PRINTFORMDW Before you close the safe, you slip the kappa security advertisement from the kit inside.
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMDevilBook,1)
		ELSE
			PRINTFORMDW Wrong code. The safe remains closed.
		ENDIF
	CASE 2
		PRINTFORMDW Taking out the kit you bought from Nitori, you carefully discern the combination by listening to the mechanism inside...
		PRINTL
		GOTO OPEN
ENDSELECT

