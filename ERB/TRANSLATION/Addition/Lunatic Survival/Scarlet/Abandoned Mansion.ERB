IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPuppy) && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
