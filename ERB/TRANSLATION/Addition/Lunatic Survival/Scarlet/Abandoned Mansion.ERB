@TA_LS_SCARLET_ABANDONED_MANSION_APPROACH_COMMAND_MOVE(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "door","entrance","inside","in","house","mansion","hallway","hall"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEnteredMansion)
			CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Main Hall")
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMCanHearMerlin,-1)
			GOTO SKIPWAIT
		ELSE
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLantern)
				PRINTFORMDL %BREAKENG(@"You carefully open the unlocked door and peer inside the mansion...")%
				PRINTL
				PRINTFORMDL %BREAKENG(@"It's dark inside and very little light comes in even with the door fully open. You hold out your lantern and step across the threshold, illuminating the front hall.")%
				CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Main Hall")
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEnteredMansion,1)
			ELSEIF TALENT:MASTER:形状 == 4
				PRINTFORMDL %BREAKENG(@"You carefully open the unlocked door and step inside the mansion. The front hall is pitch black, but you take out your dick, bathing it in a dim and softly pulsing light.")%
				CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Main Hall")
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEnteredMansion,1)
			ELSE
				PRINTFORMDL It's too dark to see anything inside. You need a source of light.
			ENDIF
		ENDIF
	CASE "forest","trees","thicket","garden","around"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLantern) || TALENT:MASTER:形状 == 4
			PRINTFORMDL %BREAKENG(@"Even with \@ GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLantern) ? the lantern # your glowing dick\@, it's difficult to see under the trees. You step carefully to avoid the twisting roots underfoot, sticking close to the mansion's exterior wall as you explore around the perimeter.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"Even with the scarlet light filtering through the tops of the trees, it's difficult to see in here. You step carefully to avoid the twisting roots underfoot, sticking close to the mansion's exterior wall as you explore around the perimeter.")%
		ENDIF
		PRINTL
		PRINTFORMDL %BREAKENG(@"At the rear of the house, you find a garden, or what's left of one. There's enough room here to move about.")%
		CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Garden")
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMCanHearMerlin,-1)
	CASE "balcony","up","tree"
		SIF CommandTarget == "tree" && !GROUPMATCH(FullCommand,"climb tree","climb up tree")
			GOTO FAIL
		CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Balcony")
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMCanHearMerlin,-1)
		GOTO SKIPWAIT
	CASE "lake","lakeside","back","out","away"
		PRINTFORMDW You head back towards the lakeside for the time being.
		RESULT = 2
		RETURN RESULT
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
$SKIPWAIT
RESULT = 1
RETURN RESULT

