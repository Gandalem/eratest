		PRINTL
		CALL PRINT_FACE(20,"発情","裸",,"照れ")
		PRINTFORMDL %BREAKENG(@"리리카는 거대한 나무의 그늘 속에, 붉은 달빛에서 벗어나 떠다닌다. 그녀 옆에서 키보드가 스스로 작동하며 레이라 프리즈리버의 왜곡된 목소리를 내고 있었다.")%
		PRINTFORMDL %BREAKENG(@"목적을 기억하고 있음에도 리리카의 얼굴은 붉게 상기되었고, 그녀의 보지는 강물처럼 액체를 흘리고 있었다. 광란에 반쯤 빠진 채, 그녀는 여동생의 추억을 들으며 게으른 손가락으로 스스로를 즐겼다.")%
	CASE "strawberry","strawberries"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateredGarden)
			PRINTL
			PRINTFORMDL %BREAKENG(@"딸기 식물들이 잡초 사이로 스며들고 있다. 당신의 손가락은 그 사이를 지나가지만, 그것들은 당신의 접촉에 반응한다.")%
			SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMStrawberries)
				PRINTFORMDL %BREAKENG(@"딸기 자체가 수확하기에 익었다.")%
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
