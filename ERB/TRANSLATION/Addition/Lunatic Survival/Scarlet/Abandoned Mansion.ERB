@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_FROM_SYNONYM(Command)
;Defines synonyms for Abandoned Mansion commands.
#FUNCTIONS
#DIMS DYNAMIC Command
RESULTS =
IF GROUPMATCH(Command,"look","check","observe","examine")
	RESULTS '= "look"
ELSEIF GROUPMATCH(Command,"move","go","goto","to","walk","fly","enter","explore")
	RESULTS '= "move"
ELSEIF GROUPMATCH(Command,"listen","hear")
	RESULTS '= "listen"
ELSEIF GROUPMATCH(Command,"get","take","obtain","acquire","grab")
	RESULTS '= "get"
ELSEIF GROUPMATCH(Command,"talk","speak","greet")
	RESULTS '= "talk"
ENDIF
SIF RESULTS == ""
	TRYCALLFORMF TA_LS_SCARLET_ABANDONED_MANSION_%FUNCTION_FORMAT(QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation))%_COMMAND_FROM_SYNONYM(Command)
RETURNF RESULTS

@TA_LS_SCARLET_ABANDONED_MANSION_TARGET_FROM_SYNONYM(Command)
;Defines synonyms for Abandoned Mansion targets.
;Most synonyms for single-room targets are defined within the room. This function covers general cases.
#FUNCTIONS
#DIMS DYNAMIC Command
IF GROUPMATCH(Command,"door","entrance")
	RESULTS '= "door"
ENDIF
RETURNF RESULTS

@LS_SCARLET_YELLOW(PrintString,ColorCondition,FailColor)
#DIMS DYNAMIC PrintString
#DIM DYNAMIC ColorCondition
#DIM DYNAMIC FailColor
#DIM DYNAMIC CurrentColor
;Prints the given string highlighted in yellow if the yellow paint can is open and the given condition is false.
;If FailColor is 0, prints in the default color when the condition is true. If it's -1, prints in the currently set color.
;Otherwise, prints in a given color.
CurrentColor = GETCOLOR()
IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMYellowPaint) && !ColorCondition
	SETCOLOR LSScarletYellowPaintColor
ELSE
	SELECTCASE FailColor
		CASE -1
		CASE 0
			RESETCOLOR
		CASEELSE
			SETCOLOR FailColor
	ENDSELECT
ENDIF
PRINTFORM %PrintString%
SETCOLOR CurrentColor

