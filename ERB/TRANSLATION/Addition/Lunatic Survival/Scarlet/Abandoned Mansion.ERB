			PRINTFORMDL %BREAKENG(@"The watering can is in your possession.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"It's a lightweight watering can made from thin metal. It's not too tall or wide, so it looks easy to carry around.")%
		ENDIF
	CASEELSE
		RESULT = -1
		RETURN RESULT
ENDSELECT
