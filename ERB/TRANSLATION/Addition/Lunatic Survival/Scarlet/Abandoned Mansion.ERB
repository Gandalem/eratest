@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_DRAW(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "armor","portrait","picture","porn","hentai","ero","supplies","paper","papers","something","sexy","sex","model","pinup","pin-up","mail","plate"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			PRINTFORMDL There's no need to draw anything anymore.
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetArmor)
			PRINTFORMDL You think about drawing something for the suit of armor, but you're not sure if you can capture it right...
			PRINTFORMDL Maybe he can steer you in the right direction if you let him watch.
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWritingSupplies)
			PRINTFORMDL You think about what to draw but don't have any ideas.
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_READ(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "diary"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDiary)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_USE(CommandTarget,FullCommand)
		ELSE
			GOTO FAIL
		ENDIF
	CASE "note"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSecretNote)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_USE(CommandTarget,FullCommand)
		ELSE
			GOTO FAIL
		ENDIF
	CASE "recipe"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_USE(CommandTarget,FullCommand)
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT

