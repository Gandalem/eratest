RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_PET(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "puppy","dog","aunn"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			PRINTFORMDL %BREAKENG(@"유령 강아지는 더 이상 없다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPuppy)
			PRINTL
			CALL PRINT_FACE(120,"笑顔","裸")
			PRINTFORMDL %BREAKENG(@"당신은 강아지를 쓰다듬고 그녀는 애정스럽게 미소 짓는다.")%
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_PLAY(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "puppy","dog","aunn"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPuppy)
			GOTO FAIL
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			PRINTFORMDW %BREAKENG(@"유령 강아지는 더 이상 없다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPaintbrush)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_LYRICAS_ROOM_COMMAND_THROW("paintbrush",FullCommand)
		ELSE
			GOTO FAIL
		ENDIF
	CASE "trumpet"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMTrumpet)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_USE(CommandTarget,FullCommand)
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT

