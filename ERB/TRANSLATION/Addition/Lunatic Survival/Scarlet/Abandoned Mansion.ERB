				CALL CHARA_TEXT(21,@"「음? ...내가 그랬지, 안 그래...」","w")
				CALL CHARA_TEXT(21,@"「...응, 맞아! 내가 이걸 키웠고, 우리는 케이크를 먹었지...」","w")
				CALL CHARA_TEXT(21,@"「우리의 형제애를 기념하며! 기억해, 우리 모두 대규모 오르기(orgie)를 했고, 음식도 난장판으로 만들었잖아~!」","w")
				PRINTL
				PRINTFORMDW 그건 통하지 않았다. 그녀는 성관계가 있었다는 생각에 갇혀 있다. 그녀는 다른 것을 잘못 기억하고 있을 것이다.
				PRINTFORMDW 하지만 이제 더 이상 생각할 수 없다. 왜냐하면 멀린이 사랑을 나누면서 당신의 몸에 딸기 주스를 흘리기 때문이다...
			CASE 4
				PRINTFORMDW 순수한 황홀감이 당신을 압도한다, 메를린이 당신의 몸을 마음대로 할 때...
		ENDSELECT
	ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPhotoOfLayla) && ONCE("LSScarletAMMerlinPhoto")
		$PHOTO
		PRINTL
		PRINTFORMDW 당신은 메를린에게 레이라의 사진을 보여주고 이것이 그녀의 진짜 \@ IS_MALE(MASTER) ? 형 # 여동생이라고 말했다. \@
		CALL CHARA_TEXT(21,@"「하하, 말도 안 돼, 내 여동생이 누군지 알아! 언제나처럼 장난치는 거 하자~!」","w")
		PRINTFORMDW 그녀에게 도달하려면 다른 무언가가 필요할 것이다. 멀린은 그것을 옆으로 밀어치고 당신과 원하는 대로 하게 만들며, 그 대상에게는 전혀 신경 쓰지 않는다...
	ELSE
		PRINTFORMDW 메를린이 당신의 몸을 제 마음대로 할 때 순수한 황홀감이 당신을 압도한다.
	ENDIF
	PRINTL
	IF HAS_PENIS(MASTER) || HAS_PENIS(21)
		CALL DIALOGUE_SEX(MASTER,21,0,0,1)
	ELSE
		CALL DIALOGUE_SEX(MASTER,21,2,3,-3,0,0,0,0)
		CALL DIALOGUE_SEX(MASTER,21,3,2,-2)
	ENDIF
	PRINTL
	PRINTFORMDW 정신을 차렸을 때, 멀린은 사라졌고 기쁨의 분위기도 함께 사라졌다.
	TIME += 30
	CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMCanHearMerlin,-1)
	PRINTL
	PRINTL
	CALL D_LINE
	PRINTL
	PRINTL
ELSE
	SIF !RAND:8
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMCanHearMerlin,1)
ENDIF
;------------------------------------------------------------------------------------------------------

