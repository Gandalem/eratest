	CASE "bookcase","bookshelf","book","books","shelf","shelves","cookbook"
		PRINTFORMDL %BREAKENG(@"선반에는 살림, 바느질, 요리, 음악 이론, 소설 쓰기, 동물 관리, 의학, 철학 등 다양한 주제의 책들이 가득했다.")%
		IF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			PRINTL
			PRINTFORMDL %BREAKENG(@"...?")%
			PRINTL
			PRINTFORMDL %BREAKENG(@"요리책에서 종이 조각 하나가 튀어나와 있다.")%
		ENDIF
	CASE "paper","bookmark"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			PRINTFORMDL %BREAKENG(@"레시피는 당신이 소지하고 있습니다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"책갈피처럼 튀어나와 있지만 좀 넓어 보인다. 거기에 무언가 쓰여 있다.")%
		ENDIF
	CASE "dresser","drawer","drawers"
		PRINTFORMDL %BREAKENG(@"많은 실용적인 옷들... 그리고 우스꽝스러워 보이는 공연 의상들도 있다. 대부분은 흑백이거나 탁한 색깔이다. 예상대로 속옷 서랍 역시 흑백색이었다.")%
	CASE "panties","underwear"
		PRINTFORMDL %BREAKENG(@"한쪽은 평범한 흰색 블라운으로 가득 차 있고... 다른 쪽은 레이스 장식의 검은 팬티로 가득 차 있다. 이것은 무엇일까? 이것이 여자의 이중성인가? 루나사 프리즈리버의 심장을 가르는 선명한 밤과 낮인가? 그녀는 어떤 경우에 어느 한쪽을 입을까? 질문은 많지만, 답을 찾으려고 그녀 쪽을 흘깃 쳐다볼 때, 당신에게 돌아오는 것은 당황스러운 시선뿐이다.")%
		CALL CHARA_TEXT(22,@"「어디를 보고 있는 거지?... 적어도 예의는 갖춰라.」","l")
	CASE "vanity"
		PRINTFORMDL %BREAKENG(@"거울이 갖춰진 소박하면서도 우아한 화장대지만, 볼 수 있는 미용 제품은 없다.")%
	CASE "self",TOLOWER(CALLNAME:MASTER)
		PRINTFORMDL %BREAKENG(@"당신은 한동안 거울 속 자신을 바라본다.")%
		IF TALENT:MASTER:容姿 > 0
			;Beautiful.
			PRINTFORMDL %BREAKENG(@"당신의 얼굴은 언제나처럼 아름답다.")%	
		ELSEIF TALENT:MASTER:容姿 < 0
			;Ugly.
			PRINTFORMDL %BREAKENG(@"당신의 얼굴는 언제나처럼 불운해 보인다.")%
		ENDIF
		SIF TALENT:MASTER:力持ち
			PRINTFORMDL %BREAKENG(@"당신은 자신의 강한 근육을 감탄한다.")%
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_LUNASAS_ROOM_COMMAND_GET(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "pillow","pillows"
		CALL CHARA_TEXT(22,@"「실례지만, 그건 필요 없지 않나요?」","l")
	CASE "book","books","shelf","shelves","cookbook"
		PRINTFORMDL %BREAKENG(@"이것들은 별로 유용해 보이지 않는다.")%
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			PRINTFORMDL %BREAKENG(@"하지만 요리책에서 책갈피처럼 종이 한 장이 튀어나와 있었다.")%
	CASE "paper","bookmark"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			PRINTFORMDL %BREAKENG(@"이미 레시피를 가지고 있다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"당신은 요리책에서 종이를 꺼내 그것을 살펴본다.")%
			PRINTFORMDL %BREAKENG(@"그것은 세월의 흔적이 느껴지는 초콜릿 케이크 레시피다. 조리법은 부엌에서 만들 수 있을 만큼 간단해 보인다.")%
			PRINTL
			CALL CHARA_TEXT(22,@"「그거? ...거기 두었던 것 같은데, 기억이 안 나네...」","l")
			PRINTFORMDL 그녀에게는 익숙한 듯하다. 레시피를 주머니에 넣는다.
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMRecipe,1)
		ENDIF
	CASE "panties","underwear"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLunasasPanties)
			CALL CHARA_TEXT(22,@"「거기 손 넣는 거 보이는데. 다시 너 밀어버리게 만들지 마.」","l")
		ELSE
			RESETCOLOR
			PRINTFORMDL %BREAKENG(@"당신은 더 자주 사용되는 한 쌍을 골라 주머니에 넣는다.")%
			CALL PANTS_GETTING(22,今日のぱんつ(22))
			CALL CHARA_TEXT(22,@"「뭐 하는 거야 거기서?」","l")
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMLunasasPanties,1)
		ENDIF
	CASE "vanity","mirror"
		PRINTFORMDL %BREAKENG(@"당신은 그렇게 자신을 많이 볼 필요가 없다.")%
	CASE "self",TOLOWER(CALLNAME:MASTER)
		PRINTFORMDL %BREAKENG(@"당신은 자신을 되찾기 위해 거울 안으로 손을 뻗으려 하지만, 손은 유리문에 막혔다.")%
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

