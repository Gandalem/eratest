@TA_LS_SCARLET_ABANDONED_MANSION_COUNTS_ROOM_COMMAND_TALK(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SETCOLOR LSScarletCountColor
SELECTCASE CommandTarget
	CASE "count","shadow","phantom","man","tailcoat","ghost","father","dad"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPhotoOfLayla)
			PRINTFORML 「What do you need of me?」
			CALL TA_LS_SCARLET_ABANDONED_MANSION_COUNT_QUESTIONS
			PRINTFORML 「I beg of you, bring us peace.」
		ELSE
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetCount)
				PRINTFORML 「Go away! Or ensnare you, this wicked devil may well!」
				PRINTFORM 「I must reclaim the truth... If can only remember 
				SETCOLOR LSScarletColor
				PRINTFORM what caused all of this
				SETCOLOR LSScarletCountColor
				PRINTFORML ...」
				PRINTFORMDW The shadow refuses to pay attention to you.
			ELSE
				PRINTFORMDW When you try to speak to the shadow, he rounds on you with a fierce movement and calls out in a loud, deep voice.
				PRINTFORMW 「No! Stop there and come no closer! Bedeviled, I am! You must not dare to see your father so!」
				PRINTL
				PRINTFORMDW You back up away from his sudden lunge and ask what means by "father."
				PRINTFORMW 「Are you not, now?! And here I have given you my everything! Ungrateful \@ IS_MALE(MASTER) ? son # daughter\@! Without title, whoever are you now?!」
				PRINTL
				IF IS_CHILD(MASTER)
					LOCALS '= IS_MALE(MASTER) ? "boy" # "girl"
				ELSE
					LOCALS '= IS_MALE(MASTER) ? "man" # "woman"
				ENDIF
				PRINTL
				{
					CALL ASK_M(
						@"I'm a \@ IS_MALE(MASTER) ? butler # maid\@",1,
						@"I'm a door-to-door sales%LOCALS%",1,
						"I'm a burglar",1,
						@"I'm %CALLNAME:MASTER%",1,
					)
				}
				PRINTL
				SELECTCASE RESULT
					CASE 0
						PRINTFORMW 「Of the mansion next door? Was there a mansion next door?! Blast it all, whatever is the matter?! Speak to me not of scarlet devils!」
					CASE 1,2
						PRINTFORMW 「A jester, too, no doubt! Yet what wealth has our home? You plainly see there is nothing left! Blast it all, whatever is the matter?!」
					CASE 3
						PRINTFORMW 「Indeed, and confidently so! Blessed is %HE_SHE(MASTER)% who remembers %HIS_HER(MASTER)% own name! Ahahahaha! Whatever is the matter?!」
				ENDSELECT
				PRINTFORMDW The shadow holds his head and rocks back and forth, as though in pain. When he rights himself, his hands are clenched tight with fury.
				PRINTL
				PRINTFORMW 「\@ IS_MALE(MASTER) ? Son # Daughter\@, dearest \@ IS_MALE(MASTER) ? son # daughter\@, I have missed you so, yet some foul curse has fallen upon me, and I shall not see you at this moment.」
				PRINTFORMW 「Never shall I look upon you with predator's eyes. Hear me, cursed phantoms, devils, or otherwise! A father's love is stronger than magic!」
				PRINTFORMW 「\@ IS_MALE(MASTER) ? Son # Daughter\@ of mine, I have no fury to you, nor feeling impure. Away! I must battle this demon, ahold of my own heart!」
				PRINTFORM 「I must reclaim the truth... If can only remember 
				SETCOLOR LSScarletColor
				PRINTFORM what caused all of this
				SETCOLOR LSScarletCountColor
				PRINTFORMW ...」
				PRINTFORMDW The shadow refuses to pay attention to you.
				PRINTL
				PRINTFORMDW The shadow turns around and pointedly ignores you, raving and rambling to himself.
			ENDIF
		ENDIF
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMMetCount,1)
	CASEELSE
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT

