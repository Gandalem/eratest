@TA_LS_SCARLET_ABANDONED_MANSION_BATHROOM_COMMAND_MOVE(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "hall","hallway","out","back"
		CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Main Hall")
	CASE "partition","bathtub","bath","tub","voice","forward","closer"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			PRINTFORMDW 리리카가 떠나서 지금 욕조에는 아무것도 없다.
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetLyrica)
			PRINTFORMDW 욕조 쪽으로 걸어가면, 다시 한번 붙잡혀 물속으로 강제로 끌려간다.
			PRINTL
			CALL PRINT_FACE(20,"発情","裸",,"照れ")
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
				CALL CHARA_TEXT(20,@"「아직도 기억나지 않아. 내가 생각하는 건 오직 \@ HAS_PENIS(MASTER) ? 거시기 # 여자 피부의 부드러움 \@뿐이야!」","w")
				CALL CHARA_TEXT(20,@"「\@ HAS_PENIS(MASTER) ? 레이라의 성기. 레이라의 성기. 레이라의 성기. 레이라의 성기! # 레이라의 피부. 레이라의 가슴. 레이라의 보지. 레이라의 입술! \@」","w")
				CALL CHARA_TEXT(20,@"「나, 나 그냥 네가 만족시켜주면 그걸 생각하는 걸 멈출 수 있을 것 같아...!」","w")
			ENDIF
			PRINTFORMDW 네 울음소리가 들리지 않자, 리리카는 당신이 질식하는 동안 그녀의 봉사에 강제로 빠지게 한다.
			PRINTL
			CALL DIALOGUE_SEX(MASTER,20,TOINT(SPLIT_G("1:2")),TOINT(SPLIT_G("0:3")),1,0,2,0,0)
			CALL DIALOGUE_SEX(MASTER,20,0,0,1,0,2)
			PRINTL
			PRINTFORMDW 당신이 욕조에서 다시 뱉어져 나오기에는 그녀는 또 사라져 버렸다. 그녀와 대화할 기회조차 얻지 못했다.
			TIME += 10
		ELSE
			PRINTFORMDW %BREAKENG(@"당신은 욕조를 보기 위해 칸 뒤로 살금살금 다가갔지만, 그것이 비어 있음을 알게 된다.")%
			PRINTFORMDW %BREAKENG(@"욕조는 매우 넓고 유령의 물로 가득 차 있다. 중앙 위에는 스스로 위아래로 움직이는 전자 키보드가 떠 있다. 악기의 음 대신, 키가 눌릴 때마다 소녀의 목소리가 나온다.")%
			PRINTL
			PRINTFORMDW %BREAKENG(@"아무도 실제로 여기 없어 \”노래하는\” 은 이 키보드뿐이다.")%
			PRINTL
			PRINTFORMDW 당신이 이것을 어떻게 할지 생각하는 동안, 뒤쪽에서 차가운 기운이 당신을 덮친다...
			PRINTFORMDW ...그리고 당신이 무언가를 하기 전에, 누군가가 당신을 욕조 가장자리 너머로 밀어붙인다.
			PRINTL
			PRINTFORMDW 몸이 물에 닿는 느낌은 없지만, 차가움이 온몸을 스치는 것은 느낀다. 마른 바닥에 부딪혀 뒤집히고 제자리에 붙는다.
