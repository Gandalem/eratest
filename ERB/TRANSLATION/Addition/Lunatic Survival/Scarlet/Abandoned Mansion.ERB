					CALL CHARA_TEXT(21,@"「According to the diary, some of these ones are my hand-me-downs, but I don't know which ones, isn't that a shame?」","l")
					CALL CHARA_TEXT(21,@"「Hmm, I feel a spiritual connection with... This one! This one is mine!」","l")
					PRINTFORMDL Merlin picks up a doll wearing a clashy, too-colorful outfit with one of its eyes missing and hugs it to her chest.
				ELSE
					CALL CHARA_TEXT(21,@"「I've never had a real puppy, but I went to the shrine and found one there. I guess the phantom ended up looking like her.」","l")	
					CALL CHARA_TEXT(21,@"「Isn't she adorable? I figured out that she loves chasing sticks. C'mere, girl～」","l")
					PRINTFORMDL Merlin pets and snuggles the puppy. She's not shy with her like she is with you...
				ENDIF
			CASE "Layla's Room"
				CALL CHARA_TEXT(21,@"「We don't clean this room anymore, but it's not like we're avoiding it. There's just no point because it'll never be used again.」","l")
			CASE "Count's Room"
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPhotoOfLayla)
					CALL CHARA_TEXT(21,@"「I didn't think a poltergeist of someone we've never met would be so considerate of us...」","l")
					CALL CHARA_TEXT(21,@"「It kind of makes me sad I never knew him. He seems like such a good guy!」","l")
				ELSE
					CALL CHARA_TEXT(21,@"「I tried talking with him once, but he just told me to go away. He got really angry and scary!」","l")
				ENDIF
			CASEELSE
				CALL CHARA_TEXT(21,@"「I dunno～!」","l")
		ENDSELECT
		WAIT
		GOTO LOOP
	CASE 2
		RETURN
ENDSELECT
WAIT
GOTO LOOP

@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND(Command,CommandTarget,FullCommand)
