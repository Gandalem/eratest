CALL LS_SCARLET_YELLOW("fountain",GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWater) || GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateredGarden))
