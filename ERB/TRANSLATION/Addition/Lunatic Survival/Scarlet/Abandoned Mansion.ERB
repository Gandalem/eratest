SETCOLOR LSScarletArmorColor
SELECTCASE CommandTarget
	CASE "armor","suit","plate","mail","guard","guardian","spur","spurs"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			PRINTFORMDL %BREAKENG(@"Let's give him some privacy.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"There's no way you could take him with you, even if you could wear him.")%
		ENDIF
	CASE "codpiece"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			PRINTFORMDL %BREAKENG(@"Let's give him some privacy.")%
		ELSE
			CALL TA_LS_SCARLET_ABANDONED_MANSION_STORAGE_ROOM_COMMAND_TOUCH(CommandTarget,FullCommand)
		ENDIF
	CASE "crates","boxes","crate","box","lid"
		$BLOCK
		CALL TA_LS_SCARLET_ABANDONED_MANSION_ARMOR_BLOCK
		SIF RESULT
			GOTO SUCCEED
		PRINTFORMDL %BREAKENG(@"You can't take an entire crate.")%
	CASE "grain","sack"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			GOTO BLOCK
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGrain)
			PRINTFORMDL %BREAKENG(@"One sack should be enough.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"You take one phantom sack of grain out of the crate.")%
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMGrain,1)
		ENDIF
	CASE "case","cases"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			GOTO BLOCK
		PRINTFORMDL %BREAKENG(@"You can't take the display cases with you.")%
	CASE "safe"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			GOTO BLOCK
		PRINTFORMDL %BREAKENG(@"You can't take the whole safe.")%
	CASE "droppings"
		PRINTFORMDL %BREAKENG(@"Let's not.")%
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
$SUCCEED
WAIT
RESULT = 1
RETURN RESULT

