#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "diary"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDiary)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_DIARY
		ELSE
			GOTO FAIL
		ENDIF
	CASE "note"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSecretNote)
			SETCOLOR LSScarletCountColor
			PRINTFORML %BREAKENG(@"우리 다섯이 사는 나의 유일한 집, 내 보물 중 이보다 더 위대한 것은 없다.")%
			PRINTFORML %BREAKENG(@"나는 아무리 넓은 곳을 떠돌고 심지어 일곱 바다까지 가더라도 나의 네 사랑하는 딸들에게는 언제나 돌아올 것을 맹세한다.")%
			SETCOLOR LSScarletColor
		ELSE
			GOTO FAIL
		ENDIF
	CASE "trumpet"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMTrumpet)
			PRINTFORMDW 당신은 유령 트럼펫을 불고 이윽고 멀린이 떠다니며 나타난다.
			CALL TA_LS_SCARLET_ABANDONED_MANSON_CALL_MERLIN
		ELSE
			GOTO FAIL
		ENDIF
	CASE "recipe"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			PRINTFORMDL %BREAKENG(@"초콜릿 케이크 레시피에 나열된 재료 중 부엌에는 계란, 우유, 그리고 딸기가 없다.")%
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSON_CALL_MERLIN
;Play the trumpet to get hints and other interactions from Merlin.
PRINTL
PRINTL
CALL D_LINE
PRINTL
PRINTL
CALL PRINT_FACE(21,"笑顔","服",,"照れ")
CALL CHARA_TEXT(21,@"「%SPLIT_G("I'm heeeeere～!♪:Reporting for duty～!:Did you want to see me?:I'm here, I'm here!:It's fun to play, right?:What's up, what's up?")%」","l")
$LOOP
PRINTL
CALL ASK_M( "무엇을 할까",1, "이 방",1, "그게 다다.",1, )
PRINTL
SELECTCASE RESULT
	CASE 0
		IF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWritingSupplies)
			CALL CHARA_TEXT(21,@"「도움이 될 거라고 생각하면 집에서 물건을 가져가도 괜찮아.」","l")
			CALL CHARA_TEXT(21,@"「레이라의 방에도 유용한 물건들이 있을지도 몰라...」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
			CALL CHARA_TEXT(21,@"「창고에 있는 갑옷에게 말을 걸어봤나요?」","l")
			CALL CHARA_TEXT(21,@"「그는 그 장소에 대해 너무 보호적이지만, 더 이상 지킬 것이 없구나...」","l")
			CALL CHARA_TEXT(21,@"「그가 더 원하는 것이 분명히 있을 거야.」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDevilBook) && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSecretNote)
			CALL CHARA_TEXT(21,@"「안전 비밀번호는 모르지만, 일기장에 그것을 찾을 단서가 있을지도 몰라.」","l")
			CALL CHARA_TEXT(21,@"「어디에 있든 아주 잘 숨겨져 있을 것이다...」","l")
			CALL CHARA_TEXT(21,@"「찾을 수 없다면 열 수 있는 다른 방법이 있을지도 모른다.」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDevilBook)
			CALL CHARA_TEXT(21,@"「금고 비밀번호… 음, 가지고 있는 것 중에 단서 같은 거 없어?」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPhotoOfLayla)
			CALL CHARA_TEXT(21,@"「우리 아빠에 대해서 말이야... 뭐, 그게 사실은 아닌 것 같아. 난 아빠를 전혀 몰랐어!」","l")
			CALL CHARA_TEXT(21,@"「우리는 일종의 우연으로 그를 일기에서 만들었고, 이제 그는 위층을 배회한다.」","l")
			CALL CHARA_TEXT(21,@"「그는 자신의 진짜 기억을 가지고 있지는 않지만, 자신에 대해 쓰인 것들은 알고 있다. 어쩌면 같은 일들에 반응할지도 모른다.」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetLyrica)
			CALL CHARA_TEXT(21,@"「리리카의 키보드가 들린다면, 그녀는 근처에 있을 것이다. 그냥 바로 가서 확인해라.」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
			CALL CHARA_TEXT(21,@"「리리카는 당신을 기억하려고 하기 때문에 올바른 기억을 찾을 수 없는 거야, 맞지? 그럼 레이라에 대해 상기시켜야 해!」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			CALL CHARA_TEXT(21,@"「리리카와 레이라가 예전에 어디서 이야기했는지 모르겠지만, 그녀가 적어뒀을 거야, 맞지?」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPuppy)
			CALL CHARA_TEXT(21,@"「리리카 방에 있는 강아지 봤어? 그녀가 예전에 키웠었다니 몰랐네! 정말 귀엽다!」","l")
			CALL CHARA_TEXT(21,@"「그녀는 수줍음이 많지만, 정말 정말 상냥해! 내가 그녀의 마음을 얻은 건 나에게 막 가져오라고 막대기를 던져준 덕분이야.」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			CALL CHARA_TEXT(21,@"「나도 라일라의 진짜 기억을 듣고 싶은 기분이야, 안 그래?」","l")
		ENDIF
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			PRINTL
		IF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetLunasa)
			CALL CHARA_TEXT(21,@"「루나사의 연주 소리가 너무 슬프다. 어떻게든 기분 좋게 해주고 싶지 않니?」","l")
		ELSEIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMRecipe)
			CALL CHARA_TEXT(21,@"「루나사의 방을 확인해 봤어? 그녀의 진짜 기억을 되찾는 단서가 있을 거야.」","l")
		ELSE
			CALL CHARA_TEXT(21,@"「우리는 루나사의 레이라에 대한 진짜 기억을 되살려야 하고, 그것은 그녀의 기억을 일깨울 만한 무언가를 보여준다는 것을 의미한다.」","l")
			CALL CHARA_TEXT(21,@"「이리 와봐, 일기장에 뭐라고 쓰여있어?」","l")
		ENDIF
	CASE 1
		SELECTCASE QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation)
			CASE "Approach"
				CALL PRINT_FACE(21,"笑顔","裸",,"照れ")
				CALL CHARA_TEXT(21,@"「여기 분수는 놀기에 재미있어! 옷을 벗고 한번 해봐!」","l")
				IF DAY:2 == 4
					CALL CHARA_TEXT(21,@"「흐음, 너무 추운가? 네 말이 맞아, 나 얼어 죽을 거야! 하하!」","l")
				ELSE
					PRINTFORMDL 눈치채기도 전에, 멀린이 당신을 분수 속으로 끌어들여 몸을 만지며 물놀이를 하게 만든다.
					TIME += 10
				ENDIF
			CASE "Garden"
				CALL CHARA_TEXT(21,@"「나는 여기에 정원을 가꾸곤 했지만, 지루해졌다.」","l")
				CALL CHARA_TEXT(21,@"「그것은 너무 일상적이라 식물들이 일어나서 말하는 게 없어 \"안녕\" 또는 \"물 고마워\"어떻게 계속할 수 있겠어?!」","l")
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMStrawberries)
					CALL CHARA_TEXT(21,@"「저 딸기들은 좀 향수를 불러일으키네.」","l")
				ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateredGarden)
					CALL CHARA_TEXT(21,@"「저 딸기들을 다 보니 따고 싶어지네만.」","l")
				ELSE
					CALL CHARA_TEXT(21,@"「잠시 동안은 정말 재미있었어. 여기 딸기 유령이 있을 거라고 생각해? 이번 한 번만 물을 줄 수 있을지도 몰라.」","l")
				ENDIF
			CASE "Barn"
				CALL CHARA_TEXT(21,@"「보아하니 중고 기억으로 폴터가이스트를 만들 수 있다니, 그래서 이곳에 살았던 가축들을 상상해 보았다.」","l")
				CALL CHARA_TEXT(21,@"「하지만 우리는 주로 요괴 동물을 보았기 때문에, 그들이 그런 형상을 갖게 된 것이다. 예쁘지 않니?」","l")
			CASE "Main Hall"
				CALL CHARA_TEXT(21,@"「우리는 그녀를 기억하려고 노력하면서 레이라에 대해 함께 적었던 곳이야.」","l")
				CALL CHARA_TEXT(21,@"「하지만 모든 것이 엉망이 되어버렸으니, 작동하지 않은 게 다행이야.」","l")
				CALL CHARA_TEXT(21,@"「우와, 이 저속한 이야기들 좀 봐... 헤이, 이것들 좀 해보겠어?」","l")
			CASE "Kitchen"
				CALL CHARA_TEXT(21,@"「우리는 레이라를 위해 식사와 간식을 만들면서 이곳에서 많은 시간을 보냈지만, 루나사만이 그것을 더 잘하게 되었다.」","l")
				CALL CHARA_TEXT(21,@"「그녀는 우리가 너무 많이 맛보는 것을 하고 잔소리하곤 했지, 하하~」","l")
			CASE "Bathroom"
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
					CALL PRINT_FACE(21,"笑顔","裸",,"照れ")
					CALL CHARA_TEXT(21,@"「같이 목욕하자!」","l")
					PRINTFORMDL 네가 무슨 말을 하기도 전에, 머린 너를 욕조 안으로 끌어당기고 온몸을 "씻긴다"...
					TIME += 10
				ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
					CALL CHARA_TEXT(21,@"「예전에 이야기했던 곳인가? 모르겠어... 일기장 확인해 봤어?」","l")
				ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetLyrica)
					CALL CHARA_TEXT(21,@"「그녀는 레이라를 기억하려고 노력하고 있지만 당신이 자신이라고 너무 확신해서 잘못된 음을 연주하고 있다.」","l")
					CALL CHARA_TEXT(21,@"「그녀에게 진짜를 상기시킬 방법은 없으신가요?」","l")
				ELSE
					CALL CHARA_TEXT(21,@"「그녀야... 네가 정말 가까이 다가가기 전까지는 모습을 드러내지 않을 거야.」","l")
					CALL CHARA_TEXT(21,@"「걱정 마, 너 해낼 수 있을 거야! 난 여기서 나 자신을 만지면서 지켜보고 있을게!」","l")
				ENDIF
			CASE "Parlor"
				CALL CHARA_TEXT(21,@"「맞아, 나도 이 조각상들 그렸어. 여기 예전에 이젤 같은 거 많이 있었거든.」","l")
				CALL CHARA_TEXT(21,@"「레이라는 그림도 그려보려 했지만, 자신이 그 분야에 소질이 없다는 사실이 싫었다. 재미있게 하는 게 중요한 거 아니야?!」","l")
				CALL CHARA_TEXT(21,@"「함께 했을 때가 더 재미있었는데...」","l")
			CASE "Storage Room"
				CALL CHARA_TEXT(21,@"「그가 어디서 왔는지는 확실치 않지만, 우리 아버지의 수집품 중 하나였던 것 같다.」","l")
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDrewHentaiForArmor)
					CALL CHARA_TEXT(21,@"「그는 예전에는 좀 움직이는 편이 아니었는데... 특히 지금 하는 일은 더더욱!」","l")
				ELSE
					CALL CHARA_TEXT(21,@"「그는 예전에는 움직이지도 않았지만... 어쩌면 여기서 그를 위해 해줄 수 있는 일이 있을지도 모른다.」","l")
				ENDIF
			CASE "Second Floor Hall"
				CALL CHARA_TEXT(21,@"「조용한 게 좀 외롭지 않아? 루나사에게 다시 놀자고 해보자.」","l")
				CALL CHARA_TEXT(21,@"「아니면 방금 트럼펫을 불었기 때문인가?」","l")
			CASE "Balcony"
				CALL CHARA_TEXT(21,@"「우리가 원할 때 언제든지 지붕 위를 날아다닐 수 있는데, 발코니에 별다른 의미가 있다고 생각했어?」","l")
				CALL CHARA_TEXT(21,@"「그건 틀렸어! 지붕이 경사져서 여기서 간식만 먹을 수 있어!」","l")
			CASE "Lunasa's Room"
				CALL CHARA_TEXT(21,@"「루나사, 네 방 좀 꾸며줄게~」","l")
				CALL CHARA_TEXT(22,@"「배려해 주셔서 감사하지만, 불필요한 행동은 하지 말아 주세요.」","l")
			CASE "Merlin's Room"
				CALL CHARA_TEXT(21,@"「나는 내 방에서 시간을 보내지 않기 때문에, 그냥 잠을 자고 물건을 보관하는 곳일 뿐이다.」","l")
				CALL CHARA_TEXT(21,@"「와, 여기 내가 완전히 잊고 지냈던 물건들이 있네...」","l")
			CASE "Lyrica's Room"
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPuppy)
					CALL CHARA_TEXT(21,@"「리리카의 방이 내 방보다 훨씬 좋네, 질투 난다! 나도 인형 좀 사야겠다.」","l")
					CALL CHARA_TEXT(21,@"「일기에 따르면 이 중 일부는 내가 물려받은 것들이지만, 어떤 것인지는 모르겠어. 그거 치정 아닌가?」","l")
					CALL CHARA_TEXT(21,@"「음, 영적인 연결을 느낀다... 이 아이와! 이 아이는 나의 것이다!」","l")
					PRINTFORMDL 머린은 눈 하나가 빠진, 너무 화려하고 색감이 과한 의상을 입은 인형을 집어 가슴에 품었다.
				ELSE
					CALL CHARA_TEXT(21,@"「나는 진짜 강아지를 키워본 적이 없는데, 신사에 갔다가 한 마리를 발견했어. 유령이 그녀처럼 보이게 된 것 같아.」","l")
					CALL CHARA_TEXT(21,@"「귀엽지 않아? 그녀가 나뭇가지 쫓는 걸 좋아한다는 걸 알아냈어. 이리 와, 아가씨~」","l")
					PRINTFORMDL 머린 강아지를 쓰다듬고 꼭 안는다. 그녀는 당신에게 그러는 것과는 달리 강아지에게 부끄러워하지 않는다...
				ENDIF
			CASE "Layla's Room"
				CALL CHARA_TEXT(21,@"「우리는 더 이상 이 방을 청소하지 않지만, 회피하는 건 아니야. 다시는 사용되지 않을 테니 의미가 없거든.」","l")
			CASE "Count's Room"
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPhotoOfLayla)
					CALL CHARA_TEXT(21,@"「우리가 한 번도 만난 적 없는 원혼이 우리에게 이렇게 배려심을 보일 거라고는 생각 못 했어...」","l")
					CALL CHARA_TEXT(21,@"「그를 알지 못했다는 게 좀 슬프네요. 정말 좋은 사람이었던 것 같은데!」","l")
				ELSE
					CALL CHARA_TEXT(21,@"「한 번 그와 말을 걸어봤는데, 그는 그냥 가라고만 했다. 정말 화를 내고 무서웠다!」","l")
				ENDIF
			CASEELSE
				CALL CHARA_TEXT(21,@"「모르겠어~!」","l")
		ENDSELECT
		WAIT
		GOTO LOOP
	CASE 2
		RETURN
ENDSELECT
WAIT
GOTO LOOP

@TA_LS_SCARLET_ABANDONED_MANSION_COMMAND(Command,CommandTarget,FullCommand)
;Splits up commands by location for organization's sake.
;If a location-specific command doesn't exist or returns 0, checks for a general command instead.
#DIMS DYNAMIC Command
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SETCOLOR LSScarletColor
RESULT = 0
TRYCALLFORM TA_LS_SCARLET_ABANDONED_MANSION_%FUNCTION_FORMAT(QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation))%_COMMAND_%FUNCTION_FORMAT(Command)%(CommandTarget,FullCommand)
SIF RESULT < 1
	TRYCALLFORM TA_LS_SCARLET_ABANDONED_MANSION_COMMAND_%FUNCTION_FORMAT(Command)%(CommandTarget,FullCommand)
RESETCOLOR
RETURN RESULT
;------------------------------------------------------------------------------------------------------

@TA_LS_SCARLET_ABANDONED_MANSION_APPROACH_INPUT_TEXT
