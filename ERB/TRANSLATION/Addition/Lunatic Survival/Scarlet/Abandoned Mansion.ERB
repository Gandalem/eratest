			CALL CHARA_TEXT(20,@"「내가 내는 소리는 이 세계에 존재하지 않아. 내 언니들처럼 사람들의 마음을 움직이는 음악은 연주할 수 없어.」","w")
			CALL CHARA_TEXT(20,@"「...하지만 소리를 상상할 수만 있다면, 나는 그것을 연주할 수 있어.」","w")
			;This is a stretch of Lyrica's "illusionary notes," which are probably just synth sounds.
