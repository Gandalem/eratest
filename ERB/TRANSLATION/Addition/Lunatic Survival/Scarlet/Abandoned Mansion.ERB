	CALL PRINT_FACE(20,"通常","裸",,"照れ")
	PRINTFORMDL 리리카는 욕조에 앉아 혼자 생각에 잠긴다. 그녀의 키보드에서는 다양한 인간들의 목소리가 부드럽게 섞여 재생된다.
ELSE
	PRINTL
	CALL CHARA_TEXT(20,@"「라하하하... 음음~♪」","l")
	PRINTFORMDL 너는 칸 뒤에서 작은 그림자가 움직이는 것을 보고 \@ IS_MET(20) ? 리리카 # 한 소녀 \@의 목소리가 노래하는 것을 듣는다.
ENDIF
PRINTL
PRINTFORMDL %BREAKENG(@"여기에 메인 홀로 가는 문이 있다.")%

@TA_LS_SCARLET_ABANDONED_MANSION_BATHROOM_COMMAND_LOOK(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "lyrica","prismriver","girl","poltergeist","phantom"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
			GOTO FAIL
		SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			GOTO FAIL
		PRINTL
		CALL PRINT_FACE(20,"通常","裸",,"照れ")
		PRINTFORMDL 리카의 얼굴은 욕망으로 붉어졌고, 그녀의 숨소리는 이상했다. 그녀는 목욕탕에 벌거벗은 채 누워 유두와 보지를 무심하게 쓰다듬었다.
		PRINTL
		CALL CHARA_TEXT(20,@"「...뭐야? 그렇게 보지 마.」","l")
	CASE "sink"
		PRINTFORMDL 싱크는 세라믹과 황동으로 만들어졌다. 아주 오래된 디자인이다.
	CASE "toilet"
		PRINTFORMDL 변기는 오래되었지만 작동하는 것 같다.
	CASE "partition"
		PRINTFORMDL 집의 다른 부분과는 다소 이질적인, 우키요에 디자인으로 그려진 일본식 칸막이다.
		PRINTFORMDL 아마 특별한 품격을 더하기 위한 것이었겠지만, 욕실에서는 다소 저렴해 보인다.
	CASE "bathtub","tub"
		PRINTFORMDL 욕조를 보려면 칸막이를 돌아다녀야 한다.
	CASE "shadow"
		SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetLyrica)
			GOTO FAIL
		SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
			GOTO FAIL
		SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			GOTO FAIL
		PRINTFORMDL %BREAKENG(@"그림자의 형상은 불분명하다. 여기서 그것을 식별할 수는 없지만 움직이는 것으로 보인다.")%
	CASE "keyboard"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			PRINTFORMDW 리리카는 사라졌고, 그녀의 키보드도 함께 사라졌다.
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
			PRINTFORMDL %BREAKENG(@"외부 세계의 일반적인 전자 키보드처럼 보인다. 그것은 물 위를 부드럽게 떠 있으며, 스스로 연주하는 듯하다.")%
			PRINTFORMDL %BREAKENG(@"그 음들은 마치 기억 더미 속에서 머무를 만한 올바른 것들을 찾으려는 듯, 단 한순간 지속되는 부드럽지만 혼란스러운 인간의 목소리들의 혼합이다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMetLyrica)
			PRINTFORMDL %BREAKENG(@"겉보기에는 일반적인 외계의 전자 키보드처럼 보인다. 그것은 물 위를 부드럽게 떠 있으며, 스스로 연주하는 것처럼 보인다.")%
			PRINTFORMDL %BREAKENG(@"그곳에서 들려오는 목소리가 리리카의 것임을 알아차리지만, 그녀는 어디에서도 보이지 않는다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"겉보기에는 외부 세계의 평범한 전자 키보드처럼 보인다. 그것은 물 위를 부드럽게 떠 있으며, 스스로 연주하는 듯하다.")%
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

