			CALL CHARA_TEXT(20,@"「그게 레이라였을 거라고 상상하기 시작했다. 너를 봤을 때 내가 찾던 사람을 찾았다는 걸 너무 강하게 느꼈고, 생각하는 것을 멈췄다.」","w")
			CALL CHARA_TEXT(20,@"「지금도 내가 제대로 생각하고 있지 않은 것 같은 기분이 들어...」","w")
