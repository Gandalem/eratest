@TA_LS_SCARLET_ABANDONED_MANSION_GARDEN_COMMAND_USE(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "can","water"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan) || GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWater)
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateredGarden)
					PRINTFORMDL %BREAKENG(@"이미 정원을 물 주었다.")%
				ELSE
					PRINTFORMDL %BREAKENG(@"당신은 \@ GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan) ? 물뿌리개를 기울여 뿌린다 # 양동이를 부어 \@ 잡초가 낀 옛 정원에 유령의 물을 붓는다...")%
					PRINTL
					PRINTFORMDL %BREAKENG(@"그리고 몇 초 만에 생기 넘치는 녹색 식물들이 철제 울타리 사이에 솟아나며, 즉시 잘 익은 빨간 딸기를 만들어낸다.")%
					CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMWater,-1)
					CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMWateredGarden,1)
				ENDIF
			ELSE
				PRINTFORMDL \@ GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan) ? 물조리개 # 양동이 \@.
			ENDIF
		ELSE
			PRINTFORMDL 그것에 물을 줄 것이 없다.
		ENDIF
	CASE "spade"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			PRINTFORMDL 이곳에서 더 파볼 만한 건 아무것도 없다.
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSpade)
			PRINTFORMDL 정원에서 무작위 지점을 파보지만 흙과 뿌리 외에는 아무것도 발견하지 못한다.
		ELSE
			GOTO FAIL
		ENDIF
	CASE "puppy","dog","aunn"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPuppy)
			GOTO FAIL
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			GOTO FAIL
		SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			GOTO FAIL
		PRINTFORMDW 너는 강아지를 정원에 두고 그녀가 땅을 따라 냄새 맡는 것을 지켜본다...
		PRINTL
		PRINTFORMDW 결국 그녀는 숲 깊숙한 안쪽의 한 지점에 매우 흥미를 느끼게 된다.
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSpade)
			PRINTFORMDW 당신은 삽을 꺼내 파기 시작한다...
			PRINTL
			PRINTFORMDW 당신은 화려하고 치밀한 빗을 파내게 된다. 그것은 검은색에 금 테두리가 둘러져 있으며, 아마 한때 많은 가치가 있었던 것 같다.
			PRINTFORMDW 하지만 이 빗은 그저 유령일 뿐이다. 살아있는 사람의 머리카락조차 빗을 수 없다.
			PRINTL
			CALL PRINT_FACE(120,"通常","裸")
			PRINTFORMDW 당신이 파 놓은 구멍에서 그것을 꺼내자, 강아지는 그것에 손을 대고 응시한다.
			PRINTFORMDW 그녀는 빗을 냄새 맡더니 당신의 눈을 바라본다...
			PRINTL
			CALL PRINT_FACE(120,"笑顔","裸")
			PRINTFORMDW 그리고 환한 미소를 지으며, 그녀는 애틋하게 당신에게 몸을 기대고 사라진다.
			PRINTL
			PRINTFORMDW ...?
			PRINTL
			PRINTFORMDW 그녀가 사라진 그곳에 유령 일기장이 있다.
			PRINTFORMDL %BREAKENG(@"You pick up the diary page%COND_STR(" 그리고 그것을 일기장에 넣는다",GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDiary))%.")%
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMComb,1)
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMPage3,1)
		ELSE
			PRINTFORMDL 불행하게도 파헤칠 것이 없고, 강아지는 더 이상 돕는 데 관심이 없는 것 같다.
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_GARDEN_COMMAND_TALK(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "lyrica","prismriver","girl","poltergeist","phantom","keyboard"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			GOTO FAIL
		PRINTL
		CALL PRINT_FACE(20,"笑顔","裸",,"照れ")
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			CALL CHARA_TEXT(20,@"「빗조차 폴터가 된 걸까? 결국 레이라의 기억이겠지.」","l")
			CALL CHARA_TEXT(20,@"「루나사가 지금 그것을 원할지는 의심되지만.」","w")
		ELSE
			CALL CHARA_TEXT(20,@"「이 목소리를 듣는 것이 얼마나 그리웠는지 몰랐다.」","l")
			PRINTL
			CALL ASK_M( "기억을 들어라",1, "그녀를 내버려 두어라",1, )
			PRINTL
			SELECTCASE RESULT
				CASE 0
					PRINTFORMDW 키보드에서 거친 목소리가 흘러나와 먼 과거의 그림을 그려낸다...
					PRINTL
					PRINTL
					SETCOLOR LSScarletLaylaColor
					CALL CHARA_TEXT(20,@"「당신을 보니 정원에서 파고 있네요. 이제 이것에도 흥미가 생긴 건가요?」","w")
					PRINTFORMW 「아니, 그런 건 없어. 그냥 빗을 찾고 있었을 뿐이야.」
					CALL CHARA_TEXT(20,@"「내가 맞춰볼게. 머린 네 빗을 뒷마당에 묻었니?」","w")
					PRINTFORMW 「헤헤, 멀린이 아니었어. 아주 오래전 작은 강아지였거든.」
					CALL CHARA_TEXT(20,@"「내가 가졌던 똑같은 강아지인가?」","w")
					PRINTFORMW 「네. 머린은 공을 던지고 다른 것들을 가지고 놀았고, 그녀는 그것들을 매우 좋아했다.」
					PRINTFORMW 「때로는 그 막대기들과 페인트붓과 신발과 양말, 그리고 그녀의 냄새가 나는 어떤 것이든 이곳에 파묻히곤 했다.」
					PRINTFORMW 「그리고 루나사는 그녀에게 많은 간식을 주었는데, 어느 날 사라진 아름다운 빗이 있었다. 그게 강아지가 가져간 것이라고 확신한다.」
					CALL CHARA_TEXT(20,@"「네가 그렇게 말하는 방식은 마치 내가 그녀가 사랑하지 않았던 유일한 사람인 것 같아...」","w")
					PRINTFORMW 「오, 너는 정말 질투했었구나. 그래서 내가 그것을 너에게 말해주지 않았던 거야.」
					PRINTL
					PRINTFORMW 「문제는 그녀가 어디에 묻었을지 전혀 모르겠다는 거야. 단 한 번 더 보고 싶었을 뿐인데...」
					CALL CHARA_TEXT(20,@"「또 개를 데려와서 냄새 맡게 할까?」","w")
					PRINTFORMW 「정말이지, 그러지 않기를 바라요. 그녀도 저를 별로 좋아하지 않았어요. 저는 더 이상 애완동물은 원하지 않아요.」
					PRINTL
					CALL CHARA_TEXT(20,@"「...하지만 집이 예전 같지 않다면, 너는 과연 무언가를 찾을 수 있을까?」","w")
					PRINTFORMW 「...알고 있어요. 그냥 혹시 그것도 넘어올 가능성이 있을까 해서요.」
					PRINTFORMW 「그냥 조금 추억하고 싶었을 뿐이에요...」
					PRINTL
					PRINTL
					PRINTFORMDW .........
					PRINTL
					CALL PRINT_FACE(20,"通常","裸",,"照れ")
					CALL CHARA_TEXT(20,@"「그것에선 목소리가 다르게 들렸지, 안 그래?」","w")
					CALL CHARA_TEXT(20,@"「...그녀가 어땠는지 기억하기 시작하는 것 같아.」","w")
					CALL CHARA_TEXT(20,@"「그녀는 늙은 여자가 되어서도 변하지 않았다. 나는 그녀가 원하지 않았던 것 같아.」","w")
					PRINTL
					CALL PRINT_FACE(20,"笑顔","裸",,"照れ")
					CALL CHARA_TEXT(20,@"「몸이 약해져 있고 식욕도 없을 때에도 그녀는 정원으로 들어가 오직 자신만이 기억하는 오래된 것들을 파냈다.」","w")
					CALL CHARA_TEXT(20,@"「그녀의 시간이 다할 때까지, 그녀는 가진 모든 것으로 시간을 거슬러 싸웠다. 그것이 그녀가 그런 종류의 소녀였다.」","w")
					PRINTL
					CALL ASK_M( "그녀는 열정적인 소녀였을 것이다",1, "마법으로 그녀의 생명을 연장할 수도 있었다.",1, "그녀가 놓는 데 어려움을 겪었던 것 같다.",1, )
					PRINTL
					SELECTCASE RESULT
						CASE 0
							CALL CHARA_TEXT(20,@"「그녀였다. 우리를 만들고 그녀가 세상을 떠날 때까지 매일을 즐겁게 만들어 준 것은 그녀의 연모였다.」","w")
							CALL CHARA_TEXT(20,@"「우리가 모든 소음을 만들어냈는데, 그녀가 죽고 나서는 집이 너무 조용하게 느껴졌어...」","w")
							CALL CHARA_TEXT(20,@"「우리의 존재 전체에서 머린 그렇게 절망해 보이는 것을 본 건 유일한 때였다. 그녀가 남긴 구멍으로부터 우리 모두가 사라질 거라고 생각했다.」","w")
							CALL CHARA_TEXT(20,@"「하지만 이제 우리는 우리가 음악을 연주할 때 그녀의 열정을 모두 기억하는 것 같다.」","w")
							CALL CHARA_TEXT(20,@"「그녀가 살아있을 때 우리는 밴드가 아니었지만, 우리가 함께 있다는 사실 자체가 그녀의 기억의 일부다.」","w")
							CALL CHARA_TEXT(20,@"「...혹은 그런 것 같은 거 말이지.」","w")
						CASE 1
							CALL CHARA_TEXT(20,@"「음... 그녀는 마법을 배우려 한 적이 없었지. 아마 두려웠거나, 아니면...」","w")
							CALL CHARA_TEXT(20,@"「그녀가 떠나야 할 때가 올 거라고 말했던 것 같은데. 하지만 그녀가 무슨 뜻이었는지는 모르겠어.」","w")
							CALL CHARA_TEXT(20,@"「그녀가 세상을 떠난 후 무언가를 하고 싶었던 게 있었을까...」","w")
						CASE 2
							CALL CHARA_TEXT(20,@"「그래서 뭐? 그녀는 우리에게 충성했고, 대부분의 사람이 누구에게라도 해주지 않을 만큼 우리를 위해 더 많이 해줬어. 우리는 그 부분에 전혀 개의치 않았거든.」","w")
							CALL CHARA_TEXT(20,@"「우리는 매일 그녀와 놀았고, 그녀를 돌보았으며, 그녀는 우리를 돌보았다. 그녀가 떠난 후, 우리는 목적을 잃었다.」","w")
							CALL CHARA_TEXT(20,@"「우리가 진짜 음악을 연주하는 법을 배운 건 그 후에야였다고 생각한다. 우리는 그녀를 위해 계속 해주고 있었던 것 같다.」","w")
							CALL CHARA_TEXT(20,@"「덕분에 결국 새로운 목적을 알아냈지만... 결국 우리는 그녀를 되돌리려고 노력하게 되었다.」","w")
							CALL CHARA_TEXT(20,@"「하하, 우리도 놓을 수 없었나 보다。」","w")
					ENDSELECT
			ENDSELECT
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT
;------------------------------------------------------------------------------------------------------

@TA_LS_SCARLET_ABANDONED_MANSION_BARN_INPUT_TEXT
PRINTFORMDL %BREAKENG(@"헛간 안은 쌓여 있는 건초 외에는 황량하다. 대부분의 공간은 가축들의 우리로 채워져 있고, 한쪽 구석은 철조망으로 구분된 가금류 구역이다. 지붕에 있는 작은 창문 하나가 붉은 달빛을 스며들게 한다.")%
IF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan)
	PRINTFORMD 빈 
	CALL LS_SCARLET_YELLOW("watering can",0)
	PRINTFORMDL  문 앞에 앉아 있다.
ENDIF
IF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMilk)
	PRINTL
	CALL PRINT_FACE(128,GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGaveCombToCow) ? "通常" # "怒り","裸")
	PRINTFORMDL %BREAKENG(@"A \@ GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGaveCombToCow) ? 소 # 머리가 헝클어진 못생긴 소 \@%COND_STR(" who looks like Urumi",IS_MET(128))% sits in one of the stalls, chewing on a piece of hay.")%
ENDIF
IF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEggs)
	PRINTL
	CALL PRINT_FACE(129,"怒り","裸")
	PRINTFORMDL %BREAKENG(@"Inside the closed-off area, a disgruntled chicken%COND_STR(" who looks like Kutaka",IS_MET(129))% sits over a pile of eggs in a nest.")%
ENDIF

@TA_LS_SCARLET_ABANDONED_MANSION_BARN_COMMAND_LOOK(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "moon","sky","up","window","ceiling","roof"
		PRINTFORMD 곡식 창고 지붕의 창을 통해서는 겨우 볼 수 있는 
		PRINTFORM 홍색 달이
		PRINTFORMDL  그 빛이 안쪽 모든 것을 붉게 물들인다.
	CASE "cow","urumi"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMilk)
			PRINTFORMDL %BREAKENG(@"유령 소는 더 이상 없다.")%
		ELSE
			CALL PRINT_FACE(128,"怒り","裸")
			IF IS_MET(128)
				LOCALS '= "우루미"
			ELSE
				LOCALS '= "가슴이 큰 소녀"
			ENDIF
			PRINTFORMDL %BREAKENG(@"비록 그녀가 %LOCALS%처럼 보이지만, 소의 눈에는 지성이 없다. 그녀는 달빛에 영향을 받지 않은 듯 단순한 동물처럼 당신을 노려보지만, 옷을 입고 있지 않다는 사실에도 전혀 신경 쓰지 않는다.")%
			PRINTL
			PRINTFORMDL %BREAKENG(@"그녀는 한 손으로 머리카락을 움켜쥐고 풀리지 않는 매듭들을 풀려고 애썼다. 그녀의 짜증 난 발구름과 코 고는 소리는 전혀 들리지 않았으며, 발밑의 흩어진 흙이나 건초도 건드리지 않았다.")%
		ENDIF
	CASE "chicken","kutaka"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEggs)
			PRINTFORMDL %BREAKENG(@"유령 닭은 더 이상 없다.")%
		ELSE
			CALL PRINT_FACE(129,"怒り","裸")
			IF IS_MET(129)
				LOCALS '= "쿠타카"
			ELSE
				LOCALS '= "날개 달린 소녀"
			ENDIF
			PRINTFORMDL %BREAKENG(@"그녀는 %LOCALS%처럼 보이지만, 닭의 눈에는 지성이 없다. 그녀는 달빛에 영향을 받지 않은 듯 단순한 동물처럼 너를 노려보지만, 옷을 입고 있지 않다는 사실은 개의치 않는 것 같다.")%
			PRINTL
			PRINTFORMDL %BREAKENG(@"그녀는 비참한 표정으로 배를 움켜쥐었고, 당신은 소와 달리 그녀의 빈 구석에는 먹을 것이 아무것도 없다는 것을 알아차린다. 그녀가 둥지 안에서 어떻게 움직이든 소리도 내지 않고 풀 한 포기도 건드리지 않는다.")%
		ENDIF
	CASE "floor","ground","down"
		PRINTFORMDL 헛간의 더러운 바닥에는 건초와 죽은 식물들이 흩어져 있다. 많은 동물들이 이곳에 살았다.
	CASE "hay","straw","fodder"
		PRINTFORMDL 건초가 가축들의 마구 근처에 쌓여 있고 그들에게 넣어져 있다. 모두에게 충분한 것 같다.
	CASE "stall","stalls"
		PRINTFORMDL 단순한 나무 칸막이가 개별 가축을 위해 헛간의 일부를 구획한다. 그것들은 많지 않다, \@ GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMilk) ? 하지만 하나만 점유되어 있다 # 그리고 모두 비어있다 \@.
	CASE "nest","egg","eggs","corner"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEggs)
			PRINTFORMDL 유령 닭의 둥지는 비어 있고 아무것도 건드리지 않은 채 놓여 있었는데, 마치 그 안에 아무것도 없었던 것처럼. 어쩌면 정말로 없었을지도 모른다.
		ELSE
			PRINTFORMDL 닭의 둥지는 깨끗하고 하얀 알들로 가득 차 있다. 닭 자신은 부드러운 뒤쪽을 그 알들 바로 위에 두고 경계하며 당신을 노려보고 있다. 그녀가 어떻게 자세를 바꿔도, 알들은 절대 깨지지 않는다.
		ENDIF
	CASE "can"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan)
			PRINTFORMDL %BREAKENG(@"물조리개는 당신의 소지품에 있습니다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"그것은 얇은 금속으로 만들어진 가벼운 물뿌리개이다. 너무 키가 크거나 넓지 않아 들고 다니기 쉬워 보인다.")%
		ENDIF
	CASEELSE
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_BARN_COMMAND_GET(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "milk"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMilk)
			PRINTFORMDL %BREAKENG(@"유령 소는 더 이상 없다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGaveCombToCow)
			CALL TA_LS_SCARLET_ABANDONED_MANSION_BARN_COMMAND_MILK("cow",FullCommand)
		ELSE
			PRINTFORMDL %BREAKENG(@"소는 코를 킁킁거리고 짜증스럽게 고개를 흔든다. 이런 상태에서 그녀에게 다가갈 수도 없고 우유를 짜낼 수도 없다.")%
		ENDIF
	CASE "eggs"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEggs)
			PRINTFORMDL %BREAKENG(@"당신은 이미 알을 가지고 있다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"암탉이 화를 내며 울고 팔을 퍼덕인다. 그녀가 이런 상태일 때는 다가갈 수 없다.")%
		ENDIF
	CASE "can"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWateringCan)
			PRINTFORMDL %BREAKENG(@"당신은 이미 물뿌리개를 가지고 있다.")%
		ELSE
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMWater)
				PRINTFORMDL %BREAKENG(@"빈 물조리개를 집어 편리하게 양동이에서 물을 옮긴다.")%
			ELSE
				PRINTFORMDL %BREAKENG(@"빈 물뿌리개를 집는다.")%
			ENDIF
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMWateringCan,1)
		ENDIF
	CASEELSE
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

