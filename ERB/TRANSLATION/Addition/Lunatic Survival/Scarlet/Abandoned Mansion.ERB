		PRINTL
		PRINTFORMDW Eventually, she becomes very interested in a spot far towards the back, within the forest.
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSpade)
			PRINTFORMDW You pull out the spade and start digging...
			PRINTL
			PRINTFORMDW You dig up an ornate fine-toothed comb. It's black with gold trim, and was probably once worth a lot.
			PRINTFORMDW This one, however, is just a phantom. It can't even comb a living person's hair.
			PRINTL
			CALL PRINT_FACE(120,"通常","裸")
			PRINTFORMDW As you pull it out of the hole you made, the puppy puts her hands on it, staring intently.
			PRINTFORMDW She sniffs the comb, then looks into your eyes...
			PRINTL
			CALL PRINT_FACE(120,"笑顔","裸")
			PRINTFORMDW ...And with a bright smile, she presses her body affectionately against yours and fades away.
			PRINTL
			PRINTFORMDW ...?
			PRINTL
			PRINTFORMDW In the spot where she disappeared, there's a phantom diary page.
			PRINTFORMDL %BREAKENG(@"You pick up the diary page%COND_STR(" and put it in the diary",GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMDiary))%.")%
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMComb,1)
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMPage3,1)
		ELSE
			PRINTFORMDL Unfortunately, you have nothing to dig with, and the puppy doesn't seem interested in helping further.
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_GARDEN_COMMAND_TALK(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "lyrica","prismriver","girl","poltergeist","phantom","keyboard"
		SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
			GOTO FAIL
		PRINTL
		CALL PRINT_FACE(20,"笑顔","裸",,"照れ")
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			CALL CHARA_TEXT(20,@"「Even the comb became a poltergeist? I guess it's a memory of Layla, after all.」","l")
			CALL CHARA_TEXT(20,@"「Though I doubt Lunasa would want it now.」","w")
		ELSE
			CALL CHARA_TEXT(20,@"「I never knew how much I missed hearing this voice.」","l")
			PRINTL
			{
				CALL ASK_M(
					"Listen to a memory",1,
					"Leave her alone",1,
				)
			}
			PRINTL
			SELECTCASE RESULT
				CASE 0
					PRINTFORMDW Scratchy voices come from the keyboard, drawing a picture of the distant past...
					PRINTL
					PRINTL
					SETCOLOR LSScarletLaylaColor
					CALL CHARA_TEXT(20,@"「Look at you, digging in the garden. Are you into it now, too?」","w")
					PRINTFORMW 「No, nothing like that. I was just looking for a comb.」
					CALL CHARA_TEXT(20,@"「Let me guess. Did Merlin bury your comb in the backyard?」","w")
					PRINTFORMW 「Hehe, it was not Merlin. It was a little puppy, years ago.」
					CALL CHARA_TEXT(20,@"「Is it the same puppy I had?」","w")
					PRINTFORMW 「Yes. Merlin would throw sticks and other things to play fetch, and she loved her quite a lot.」
					PRINTFORMW 「Sometimes, those sticks and paintbrushes and shoes and socks, and anything that smelled like her would end up buried out here.」
					PRINTFORMW 「And Lunasa gave her a lot of treats, and she had a beautiful comb that disappeared one day. I am certain it was the puppy that took it.」
					CALL CHARA_TEXT(20,@"「The way you said that, it sounds like I was the only one she didn't love...」","w")
					PRINTFORMW 「Oh, you were awfully jealous. That is why I never mentioned it to you.」
					PRINTL
					PRINTFORMW 「The trouble is, I have no idea where she would have buried it. I only wanted to look at it once more, but...」
					CALL CHARA_TEXT(20,@"「Shall we get another dog to sniff it out, then?」","w")
					PRINTFORMW 「Goodness, I hope not. She did not much like me, either. I do not want any more pets.」
					PRINTL
					CALL CHARA_TEXT(20,@"「...But if the house isn't where it used to be, are you ever going to find anything?」","w")
					PRINTFORMW 「...I know. I just thought, maybe there was a chance it came over, too.」
					PRINTFORMW 「I just wanted to reminisce a little bit...」
					PRINTL
					PRINTL
					PRINTFORMDW .........
					PRINTL
					CALL PRINT_FACE(20,"通常","裸",,"照れ")
					CALL CHARA_TEXT(20,@"「Her voice sounded different in that one, didn't it?」","w")
					CALL CHARA_TEXT(20,@"「...I think I'm starting to remember how she was.」","w")
					CALL CHARA_TEXT(20,@"「She never changed, even as an old woman. I don't think she wanted to.」","w")
					PRINTL
					CALL PRINT_FACE(20,"笑顔","裸",,"照れ")
					CALL CHARA_TEXT(20,@"「Even when her body was weak and she didn't have an appetite, she'd go into the garden and dig up old things that only she remembered.」","w")
					CALL CHARA_TEXT(20,@"「Until her time was up, she fought against time with everything she had. That's the kind of girl she was.」","w")
					PRINTL
					{
						CALL ASK_M(
							"She must have been a passionate girl",1,
							"Magic could have prolonged her life",1,
							"Sounds like she had trouble letting go",1,
						)
					}
					PRINTL
					SELECTCASE RESULT
						CASE 0
							CALL CHARA_TEXT(20,@"「She was. It was her love that created us, and made every day fun until she passed away.」","w")
							CALL CHARA_TEXT(20,@"「We were the ones who made all the noise, but after she died, the house felt so quiet...」","w")
							CALL CHARA_TEXT(20,@"「It was the only time in our whole existence I'd seen Merlin so depressed. I thought we would all fade away from the hole she left.」","w")
							CALL CHARA_TEXT(20,@"「But now, I think we all remember her passion when we play our music.」","w")
							CALL CHARA_TEXT(20,@"「Even though we weren't a band when she was alive, just the fact that we're together is part of her memory.」","w")
							CALL CHARA_TEXT(20,@"「...Or something like that.」","w")
						CASE 1
							CALL CHARA_TEXT(20,@"「Hmmm... She never tried to learn magic. Maybe she was afraid of it, or...」","w")
							CALL CHARA_TEXT(20,@"「I think she said there would come a time when she had to go. I don't know what she meant by that, though.」","w")
							CALL CHARA_TEXT(20,@"「I wonder if there was something she wanted to do after she passed on...」","w")
						CASE 2
							CALL CHARA_TEXT(20,@"「So what? She was loyal to us, and went farther for us than most would for anyone. We didn't mind that part of her at all.」","w")
							CALL CHARA_TEXT(20,@"「We played every day, and took care of her, and she took care of us. After she passed, we didn't have a purpose.」","w")
							CALL CHARA_TEXT(20,@"「It was only afterward that we learned to play music for real. I think we were carrying on for her sake.」","w")
							CALL CHARA_TEXT(20,@"「Thanks to that, we eventually figured out a new purpose... but in the end, we still wound up trying to bring her back.」","w")
							CALL CHARA_TEXT(20,@"「Haha, guess we couldn't let go either.」","w")
					ENDSELECT
			ENDSELECT
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT

