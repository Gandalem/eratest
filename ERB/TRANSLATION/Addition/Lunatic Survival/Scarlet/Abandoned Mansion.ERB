@TA_LS_SCARLET_ABANDONED_MANSION_BARN_COMMAND_USE(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "bucket"
		CALL TA_LS_SCARLET_ABANDONED_MANSION_BARN_COMMAND_MILK("cow",FullCommand)
	CASE "grain"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMEggs)
			PRINTFORMDW %BREAKENG(@"유령 닭은 더 이상 없다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGrain)
			PRINTFORMDW 당신은 약간의 힘줄을 섞어 그 유령 곡식을 소에게 주기 위해 자루에서 던진다.
			PRINTL
			CALL PRINT_FACE(129,"通常","裸")
			PRINTFORMDW 닭은 날아다니는 곡식을 보고 정신을 차린 뒤 조심스럽게 일어나 둥지 밖으로 발을 내딛는다.
			PRINTFORMDW 그녀는 손가락으로 땅을 쪼며 조금씩 집어 입안에 밀어 넣었다.
			PRINTL
			CALL PRINT_FACE(129,"笑顔","裸")
			PRINTFORMDW 결국 만족한 듯, 닭은 당신에게 다가와 미소를 지으며 큰 포옹을 건네고 가슴을 당신의 몸에 비볐다.
			PRINTFORMDW 그렇게 하면서 그녀의 몸은 완전히 사라질 때까지 희미해진다. 당신은 그녀가 남긴 유령 알들을 주운다.
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEggs,1)
		ELSE
			GOTO FAIL
		ENDIF
	CASE "comb"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMilk)
			PRINTFORMDW %BREAKENG(@"유령 소는 더 이상 없다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGaveCombToCow)
			PRINTFORMDW %BREAKENG(@"당신은 이미 빗을 소에게 주었다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMComb)
			PRINTFORMDW 그녀가 그것을 어떻게 해야 할지 확실히 모르지만, 당신은 그 빗을 불안해하는 소에게 건네고, 소는 호기심 어린 듯 그것을 살펴본다.
			PRINTFORMDW 소는 당신의 지시에 따라 머리에 그것을 빗어 약간 부드럽게 만들지만, 종종 엉킨 부분에 걸린다.
			PRINTFORMDW 결국 그녀는 당신이 앞으로 나아가 그녀를 만지는 것을 허락한다. 당신은 조심스럽고 부드럽게 그녀의 모든 매듭을 빗겨준다.
			PRINTL
			CALL PRINT_FACE(128,"笑顔","裸")
			PRINTFORMDW 할 일을 마쳤을 때, 소는 이제 비단처럼 부드러워진 머리카락을 손가락으로 쓸어 넘기며 안도감에 미소 짓는다.
			PRINTFORMDW 그녀는 당신을 끌어안고, 그리고 애정을 담아 몸을 당신에게 기대며 크고 잘 익은 유방을 드러낸다.
			PRINTFORMDW 이것이 당신의 기회일지도 모른다...
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMGaveCombToCow,1)
		ELSE
			GOTO FAIL
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT

@TA_LS_SCARLET_ABANDONED_MANSION_BARN_COMMAND_TOUCH(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "cow","now"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMMilk)
			PRINTFORMDW %BREAKENG(@"유령 소는 더 이상 없다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMGaveCombToCow)
			SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
				PRINTFORMDW 당신은 소를 만진다. 지금 그것을 한다.
