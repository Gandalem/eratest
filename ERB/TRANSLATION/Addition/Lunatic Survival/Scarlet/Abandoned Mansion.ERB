				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEnteredMansion,1)
			ELSEIF TALENT:MASTER:形状 == 4
				PRINTFORMDW %BREAKENG(@"당신은 조심스럽게 잠금 해제된 문을 열고 저택 안으로 들어선다. 위층 복도는 칠흑같이 어둡지만, 당신은 성기를 꺼내 희미하고 부드럽게 맥동하는 빛에 담는다.")%
				CALL SET_QUEST_STRING(LSScarletAlias,QSLSScarletAMLocation,"Second Floor Hall")
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMEnteredMansion,1)
			ELSE
				PRINTFORMDW 안이 너무 어두워서 아무것도 보이지 않는다. 빛의 근원이 필요하다.
			ENDIF
		ENDIF
