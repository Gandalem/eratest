@TA_LS_SCARLET_ABANDONED_MANSION_MERLINS_ROOM_COMMAND_LOOK(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SELECTCASE CommandTarget
	CASE "bed","sheet","sheets","cover","covers","pillow","pillows"
		PRINTFORMDL %BREAKENG(@"화려한 흰색, 노란색, 파란색 커버를 가진 평범한 베개부터 꽃이나 별 모양의 베개, 하트 모양의 프릴이 달린 분홍색 레이스 베개에 이르기까지 이국적인 다양한 장식용 베개가 침대를 덮고 있었다. 침대와 모든 장식물은 극도로 폭신했으며, 소녀가 최고의 호사 속에서 잠들 수 있는 작은 궁전처럼 꾸며져 있었다.")%
	CASE "mess","knicknacks","collectibles","stuff","things","figurine","figurines","book","books","card","cards"
		PRINTFORMDL %BREAKENG(@"개와 고양이 피규어들, 음식 얼룩이 묻은 페이지의 이야기책들, 그림 카드 묶음들, 먼 나라에서 가져온 기념품들, 그리고 그 외 잡동사니들이 모든 가용 표면에 어지럽게 놓여 있었다. 여기에는 분류하기에 너무 많은 것들이 있었지만, 어느 것도 특별히 유용한 것 같지는 않았다.")%
	CASE "bucket","pail","item","items","tool","tools"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
			PRINTFORMDL %BREAKENG(@"양동이와 그 유용한 내용물은 당신의 소유입니다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"A thick wooden pail sits in a corner, housing a number of seemingly forgotten hobby items. There are at least a dozen paintbrushes (but no intact palettes or easels),%COND_STR("오래된 흙으로 뒤덮인 정원용 삽," ,!GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSpade))% a bent and voiceless clarinet, and a jumble of tiny gears and springs from some ill-fated watchmaking venture, to name a few things.")%
		ENDIF
	CASE "paintbrush","paintbrushes","brush","brushes"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
			PRINTFORMDL %BREAKENG(@"양동이와 그 유용한 내용물은 당신의 소유다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"다양한 크기와 너비의 말총 브러시가 양동이 안의 상당한 공간을 차지하고 있다. 모두 많이 사용된 듯하다.")%
		ENDIF
	CASE "spade"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
			PRINTFORMDL %BREAKENG(@"양동이와 그 유용한 내용물은 당신의 소지품이다.")%
		ELSEIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMSpade)
			PRINTFORMDL %BREAKENG(@"정원용 삽이 당신의 소지품에 있다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"삽의 표면에는 굳은 옛 흙으로 채워진 많은 긁힌 자국들이 있다. 많이 사용되었음에 틀림없다.")%
		ENDIF
	CASE "clarinet"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
			PRINTFORMDL %BREAKENG(@"양동이와 그 유용한 내용물은 당신의 소지품이다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"이 아름답고 값비싸 보이는 클라리넷에 무슨 불행이 닥친 듯하다. 그것으로 불면 나오는 소리는 한심한 쌕쌕거리는 소리뿐이다.")%
		ENDIF
	CASE "gears","gear","spring","springs","watch"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMBucket)
			PRINTFORMDL %BREAKENG(@"양동이와 그 유용한 내용물은 당신의 소유이다.")%
		ELSE
			PRINTFORMDL %BREAKENG(@"양동이 바닥에는 작고 정교한 기계 부품들이 완전히 뒤죽박죽으로 널려 있고, 빈 회중시계 프레임 두 개도 있다. 설령 모든 부품을 가지고 있다 하더라도 그것들을 재조립하는 것은 불가능할 것이다.")%
		ENDIF
	CASE "dresser","drawer","drawers"
		PRINTFORMDL %BREAKENG(@"서랍장에는 주로 흰색과 연한 파란색의 화려한 유령 옷들이 가득하다. 많은 옷들이 평상복이라기보다는 의상처럼 보인다. 속옷 서랍 역시 비슷하게 화려하지만, 평범한 흰색들도 많이 있다.")%
	CASE "panties","underwear","spats"
		PRINTFORMDL %BREAKENG(@"평소 것 외에도 무늬가 있는 귀여운 분홍색 팬티 같은 것들, 살짝 비치는 하늘색 팬티, 그리고 여러 쌍의 스패츠 같은 것들이 있었다. 어쩌면 그녀는 보이시한 시기를 보냈을지도 모른다.")%
	CASE "clothes","clothing","outfit","outfits","costume","costumes"
		PRINTFORMDL %BREAKENG(@"매우 화려하고 지나쳐서 우스꽝해 보일 정도다. 그것들은 유령 옷이기 때문에 입을 수 없다.")%
	CASE "window","curtains","drapes"
		PRINTFORMDL %BREAKENG(@"다소 아이러니하게도, 커튼에는 햇살 무늬가 새겨져 있다. 진홍빛 달빛이 스며들어 방을 어슴푸레 비춘다.")%
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
WAIT
RESULT = 1
RETURN RESULT

