@TA_LS_SCARLET_ABANDONED_MANSION_BATHROOM_COMMAND_SUGGEST(CommandTarget,FullCommand)
#DIMS DYNAMIC CommandTarget
#DIMS DYNAMIC FullCommand
SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaRememberedLayla)
	GOTO FAIL
SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMLyricaLeftBathroom)
	GOTO FAIL
SELECTCASE CommandTarget
	CASE "garden","backyard","back"
		IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPage1)
			PRINTFORMDW 일기 중 한 페이지에 따르면, 원래 리리카는 정원에서 토라졌고 레이라는 그녀에게 가서 말을 걸었다.
			IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletAM),QBitLSScarletAMPage4)
				PRINTFORMDW 다른 페이지에는 레이라가 항상 리리카를 "예전처럼" 대했다고 적혀 있다. 그녀는 이 폴터가이스트인 리리카를 말했을까?
			ELSE
				PRINTFORMDW 만약 폴터가이스트 리리카가 원본과 비슷하다면, 같은 종류의 습관을 형성했을 수도 있을까?
			ENDIF
		ENDIF
		PRINTFORMDW 리리카는 당신의 추측을 생각하고 깨달음을 얻으며 입을 연다.
		PRINTL
		CALL PRINT_FACE(20,"笑顔","裸",,"照れ")
		CALL CHARA_TEXT(20,@"「맞아! 아, 밖에 볼 생각조차 못 했네!」","w")
		CALL CHARA_TEXT(20,@"「정말 오래전 일이지만, 거기서 만났던 것 같아. 당장 가서 확인해 봐야겠어!」","w")
		PRINTFORMDW 라이리카는 흥분하며 목욕탕에서 튀어나오고, 욕실 전체에 유령 같은 물보라를 일으킨다.
		PRINTFORMDW 옷을 입을 생각도 하지 않고 키보드를 들고 벽을 뚫어 집 뒤로 날아간다. 당신은 완전히 혼자 남는다.
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletAM,QBitLSScarletAMLyricaLeftBathroom,1)
	CASE "dick","penis","cock","dong","balls"
		SIF !HAS_PENIS(MASTER) && !HAS_PENIS(20)
			GOTO FAIL
		GOTO SEX
	CASE "sex","pussy","breasts","boobs","boobies","tits","love"
		$SEX
		CALL CHARA_TEXT(20,@"「맞아, 맞아. 마음이 맑아지면 더 잘 생각할 수 있을 거야!」","l")
		CALL CHARA_TEXT(20,@"「욕조에 올라타라. 오, 하지만 우리가 해야 할까? 나는 ~해야 한다고 생각한다...」","w")
	CASE "bathroom","bath","washroom","restroom","toilet","lavatory","here"
		CALL CHARA_TEXT(20,@"「음, 그렇긴 하지만 다른 곳을 생각하고 있었어...」","w")
	CASE "outside","out"
		CALL CHARA_TEXT(20,@"「밖에... 정확히 어디지?」","w")
	CASE "approach","front"
		CALL CHARA_TEXT(20,@"「나는 그렇게 생각하지 않아. 레이라는 도저히 안 되게 앞문으로 나가지 않았어.」","l")
		CALL CHARA_TEXT(20,@"「그녀는 이 장소를 사랑했고, 항상 집 근처에 머물고 싶어 했다...」","w")
	CASE "barn"
		CALL CHARA_TEXT(20,@"「가까워진 것 같은데, 하지만...」","w")
	CASE "hall","parlor","balcony"
		$PARLOR
		CALL CHARA_TEXT(20,@"「모두 그곳에서 이야기했다. 무엇이든 알아듣기에는 너무 시끄럽다...」","w")
	CASE "kitchen"
		CALL CHARA_TEXT(20,@"「그녀는 루나사와 함께 저 안에 더 많은 시간을 보냈던 것 같아. 나는 요리를 별로 하지 않았어...」","w")
	CASE "storage"
		$STORAGE
		CALL CHARA_TEXT(20,@"「나는 그 창고에 더 많은 도구를 찾기 위해서가 아니면 어떤 이유로도 간 적이 없다고 생각한다.」","w")
	CASE "merlin"
		$MERLIN
		CALL CHARA_TEXT(20,@"「머린의 방? 나랑 레이라가 거기서 대화했을 리 없어?」","w")
	CASE "lunasa"
		$LUNASA
		CALL CHARA_TEXT(20,@"루나사의 방? 왜 나와 레이라가 거기서 얘기했을까?","w")
	CASE "lyrica"
		$LYRICA
		CALL CHARA_TEXT(20,@"「그녀가 내 방에 별로 오지 않은 것 같아...」","w")
	CASE "layla"
		$LAYLA
		CALL CHARA_TEXT(20,@"「그녀의 방에는 별로 가지 않았다. 우리가 이야기를 나눴던 다른 장소가 있었던 것 같다...」","w")
	CASE "count"
		$COUNT
		CALL CHARA_TEXT(20,@"「거기에 들어간 적이 전혀 기억나지 않아...」","w")
	CASE "room"
		IF GROUPMATCH(1,STRFIND(FullCommand,"sun") > -1,STRFIND(FullCommand,"merlin") > -1)
			GOTO MERLIN
		ELSEIF GROUPMATCH(1,STRFIND(FullCommand,"moon") > -1,STRFIND(FullCommand,"lunasa") > -1)
			GOTO LUNASA
		ELSEIF GROUPMATCH(1,STRFIND(FullCommand,"star") > -1,STRFIND(FullCommand,"lyrica") > -1)
			GOTO LYRICA
		ELSEIF GROUPMATCH(1,STRFIND(FullCommand,"planet") > -1,STRFIND(FullCommand,"layla") > -1)
			GOTO LAYLA
		ELSEIF GROUPMATCH(1,STRFIND(FullCommand,"galaxy") > -1,STRFIND(FullCommand,"count") > -1,STRFIND(FullCommand,"master") > -1)
			GOTO COUNT
		ELSEIF STRFIND(FullCommand,"storage") > -1
			GOTO STORAGE
		ELSEIF STRFIND(FullCommand,"parlor") > -1
			GOTO PARLOR
		ENDIF
	CASEELSE
		$FAIL
		RESULT = -1
		RETURN RESULT
ENDSELECT
RESULT = 1
RETURN RESULT
