		ELSE
			CALL PRINT_FACE(120,"通常","裸")
			IF IS_MET(120)
				LOCALS '= "아운"
			ELSE
				LOCALS '= "뿔이 달린 소녀"
			ENDIF
			PRINTFORMDL %BREAKENG(@"그녀는 %LOCALS%처럼 보이지만, 강아지의 눈에는 지성이 없다. 그녀는 달빛에 영향을 받지 않은 듯 단순한 동물처럼 당신을 바라보지만, 옷을 입고 있지 않다는 사실에도 개의치 않는다.")%
			PRINTL
			PRINTFORMDL %BREAKENG(@"그녀는 앉아서 당신의 존재에 긴장한 듯 빠르게 꼬리를 흔든다. 당신이 가까이 오지 않는 한, 그녀는 당신에게 다가가지도 도망가지도 않는다.")%
		ENDIF
	CASE "self",TOLOWER(CALLNAME:MASTER)
		PRINTFORMDL %BREAKENG(@"당신은 한동안 거울 속 자신을 바라본다.")%
		IF TALENT:MASTER:容姿 > 0
			;Beautiful.
			PRINTFORMDL %BREAKENG(@"당신의 얼굴은 언제나처럼 아름답다.")%	
		ELSEIF TALENT:MASTER:容姿 < 0
