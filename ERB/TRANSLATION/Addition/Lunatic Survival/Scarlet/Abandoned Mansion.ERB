			ENDIF
		ELSE
			PRINTFORMDL %BREAKENG(@"지금 정원에는 잡초만 자란다. 휘고 녹슨 철제 울타리로 표시된 네모나고 평평한 땅만이 이 토지가 한때 가꾸어졌음을 알려준다.")%
		ENDIF
	CASE "lyrica","prismriver","girl","poltergeist","phantom","keyboard"
