		CALL CHARA_TEXT(66,"「음, 맛있다♪」","w")
		PRINTL
		CALL PRINT_FACE(26,"笑顔","裸",,"照れ")
		CALL CHARA_TEXT(26,@"「%HIM_HER(MASTER)%을 좀 더 맛볼까?」","w")
