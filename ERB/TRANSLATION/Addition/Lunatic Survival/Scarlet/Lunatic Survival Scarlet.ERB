			CALL CHARA_TEXT(59,@"「%SPLIT_G(@"아하하, 둘 다 정말 귀엽네!:서두르지 않아도 돼. 천천히, 정열적인 모습을 제대로 보여 줘...:으응... %CALLNAME:MASTER%, 보고 있어?:이제 슬슬 갈 것 같아...!")%」","w")
