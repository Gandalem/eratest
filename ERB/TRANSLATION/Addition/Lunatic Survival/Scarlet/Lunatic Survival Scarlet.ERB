		Foreplay = RESULT
		PRINTL
		SELECTCASE RESULT
			CASE 4
				GOTO DONTKNOW
			CASE 5
				GOTO LETMEGO
		ENDSELECT
		CALL CHARA_TEXT(59,@"「그리고 나서?」","w")
		PRINTL
		CALL ASK_M( @"당신은 나를 당신의 성기 위에 태울 것이다",HAS_PENIS(59) && HAS_VAGINA(MASTER) ? 1 # -1, @"당신은 \@ HAS_PENIS(MASTER) ? 나에게 내 거를 네 안에 넣게 하거나 # 내 보지를 네 것에 비비게 만들 것이다 \@",1, "모르겠어",1, "나를 가게 해줘",1, )
		Penetration = RESULT
		PRINTL
		SELECTCASE RESULT
