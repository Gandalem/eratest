CALL ASK_M( "바깥 모습을 보기 좋게 만들어라",1, @"%COND_STR("weeds and ",DAY:2 == 4)% 해충을 사냥한다",1, "침입하는 요정들을 섬멸하라",1, )
PRINTL
SELECTCASE RESULT
	CASE 0
		IF DAY:2 == 4
			PRINTFORMDW 당신은 %SPLIT_G("저택의 길에 쌓인 눈을 치우고 소금을 뿌린다:저택 뜰을 꾸밀 눈 악마를 만든다:저택 창문에 붙은 서리를 녹인다:뜰에 장식할 얼음 조각상을 만든다")%.
		ELSE
			PRINTFORMDW 당신은 %SPLIT_G("외벽을 따라 핀 꽃에 물을 준다:저택의 울타리를 다듬는다:저택 주변의 흙길을 쓸어 낸다:저택 외벽과 창문을 닦는다")%.
		ENDIF
		ExperienceType '= "清掃経験"
	CASE 1
		IF DAY:2 != 4 && !RAND:2
			PRINTFORMDW 당신은 %SPLIT_G("한동안 뜰의 잡초를 뽑는다:한동안 덤불 속을 뒤진다:양동이를 들고 저택 뜰의 잡초를 뽑는다:정원과 길에 침입자가 없는지 살핀다")%.
		ELSE
			PRINTFORMDW 당신은 %SPLIT_G("뜰을 샅샅이 뒤져 쥐구멍을 찾아낸 뒤 쫓아낸다:몰래 숨어든 요정들을 찾아 젖꼭지를 빨아 얌전히 만든다:저택 외벽에 붙은 벌레집과 새 둥지를 치운다")%.
		ENDIF
		ExperienceType '= "採集経験"
	CASE 2
		PRINTFORMDW 요정들은 호전적이며 당신에게 싸움을 신청한다. 당신은 힘으로 그들을 물리치며 시간을 보낸다.
		ExperienceType '= "戦闘経験"
ENDSELECT
IF IN_HOME(CFLAG:97:現在位置) == 1
	PRINTL
	CALL PRINT_FACE(97,"笑顔","服",,"照れ")
	CALL CHARA_TEXT(97,"「주인들에게 굴복하지 마라! 네 손으로 힘을 잡아라!」","w")
	PRINTL
	PRINTFORMDW 세이가 일부 요정들과 함께 대지에서 시위를 주도한다.
ENDIF
PRINTL
CALL AddEXPOrdered(ExperienceType,MASTER,LSScarletTaskExperienceGain)
CALL LS_SCARLET_ADD_PAY(ExperienceType,16)
TIME += RAND(15,20)
CALL LS_SCARLET_COMPLETE_SERVICE_TASK

@QUEST_LUNATIC_SURVIVAL_SCARLET_TUPAI_PLAYTIME
;Taking care of Remilia's pet chupacabra.
#DIMS DYNAMIC ExperienceType
#DIM DYNAMIC InstrumentType
PRINTFORMDW 당신은 모든 창문과 문이 닫혔는지 확인하고 투파이를 우리 밖으로 내보낸다. 그것은 나오자마자 응접실을 뛰어다니기 시작한다.
PRINTFORMDW 피가 묻은 스테이크를 펼쳐 놓으면, 그것은 그쪽으로 달려가 육즙을 빨아들인다.
PRINTL
SELECTCASE RAND:4
	CASE 0
		PRINTFORMDW 식사를 마친 후, 당신은 그것과 공놀이를 한다.
		PRINTFORMDW 그것은 당신의 손에서 떠나기 직전에 발톱으로 공을 잡고는, 그것을 가지고 달아난다...
		PRINTFORMDW 적어도 당신이 그것을 쫓으려고 할 때 재미있어하는 것 같다.
	CASE 1
		PRINTFORMDW 식사를 마친 후, 너는 그것에게 재주를 가르치려고 노력한다.
		PRINTFORMDW 지능이 높지만 그다지 말을 잘 듣지는 않는다... 금방 흥미를 잃는다.
		PRINTFORMDW 그래도 끝내 명령에 따라 %SPLIT_G("앞발을 내밀게:바닥을 구르게:원을 그리며 달리게:고개 숙여 인사하게:당신에게 오게:손뼉을 마주치게")% 만드는 데 성공한다.
	CASE 2
		PRINTFORMDW 식사 후, 당신은 길고 가는 목줄을 채우고 산책시킨다.
		PRINTFORMDW 안에서 그것은 요정 메이드들과 호그박스들에게 숨었다가 튀어나와 그들을 놀라 도망치게 한다.
		PRINTFORMDW 밖에서는 목줄이 허용하는 한 사방으로 달려나가 남는 에너지를 발산한다.
	CASE 3
		PRINTFORMDW 먹이를 먹은 후, 당신은 몇 가지 풍부하게 해주는 장난감을 시도한다.
		PRINTFORMDW 당신은 작고 피가 묻은 조각들을 보풀이 많은 공이나 미니어처 퍼즐 안에 숨기고 그것이 그것들에 도달하려고 애쓰는 것을 지켜본다.
		PRINTFORMDW 그것은 모든 도전을 빠르게 해결하고 당신은 계속해서 새로운 아이디어를 생각해내야 한다...
ENDSELECT
PRINTL
PRINTFORMDW 끝내도 여전히 에너지가 너무 넘쳐서 치우기 힘들다. 어쩌면 유용한 일을 시킬 수 있지 않을까?
$LOOP
PRINTL
CALL ASK_M( "단마쿠를 플레이한다",1, "해충을 사냥한다",1, "음악에 맞춰 춤을 춘다",1, )
PRINTL
SELECTCASE RESULT
	CASE 0
		PRINTFORMDW 투파이가 집을 지킬 수 있을지는 의문이지만, 총알을 피하는 것을 즐기는 것 같다.
		PRINTFORMDW 그것은 이리저리 날아다니며 모든 탄환을 장난스럽게 흘려보내면서 타고난 기술을 과시한다.
		PRINTFORMDW 그 움직임에서 배울 점이 있을지도 모른다...
		ExperienceType '= "戦闘経験"
	CASE 1
		PRINTFORMDW 당신은 아주 긴 목줄을 달고 투파이를 저택 정원 속 사냥에 데리고 나간다.
		PRINTFORMDW 네가 설치류의 굴을 가리키자, 그것이 안으로 파고들어 비명을 지르는 동물을 끌어낸다. 너는 그에게 피를 간식으로 준다.
		SIF TALENT:MASTER:採集Lv < 2
			PRINTFORMDW 불행하게도 당신은 굴을 찾는 데 그다지 능숙하지 않아서 별로 성과를 이루지 못한다...
		ExperienceType '= "採集経験"
	CASE 2
		PRINTFORMDL 무엇을 해야 할까...
		CALL ASK_M( "반환", 1, ITEMNAME_TR(30),MUSIC_ABLE(30), ITEMNAME_TR(32),MUSIC_ABLE(32), ITEMNAME_TR(33),MUSIC_ABLE(33), ITEMNAME_TR(34),MUSIC_ABLE(34), )
		SELECTCASE RESULT
			CASE 0
				GOTO LOOP
			CASE 1
				InstrumentType = 30
			CASE 2
				InstrumentType = 32
			CASE 3
				InstrumentType = 33
			CASE 4
				InstrumentType = 34
		ENDSELECT
		PRINTL
		PRINTFORMDW 당신은 투파이에게 음악 공연을 보여주고 그것에게 춤을 가르치려고 한다.
		SELECTCASE InstrumentType
			CASE 30
				PRINTFORMDW 키보드에 대해 다소 궁금해하며 가끔 키를 누른다.
			CASE 32
				PRINTFORMDW 기타 선율을 좋아하는 것 같지만, 알기 어렵다.
			CASE 33
				PRINTFORMDW 트럼펫은 그것을 흥분시키고, 당신이 더 빨리 연주할수록 그것은 더 빠르게 움직인다.
			CASE 34
				PRINTFORMDW 바이올린 소리가 그것을 매료시키는 듯했고, 당신이 연 동안 그것은 훨씬 더 온순해졌다.
		ENDSELECT
		ExperienceType '= "演奏経験"
ENDSELECT
IF IN_HOME(CFLAG:97:現在位置) == 1
	PRINTL
	CALL PRINT_FACE(97,"通常","服",,"照れ")
	CALL CHARA_TEXT(97,"「뱀파이어 애새끼의 애완동물하고 놀고 있나 보네? 내가 그걸 가져가 주지!」","w")
	PRINTL
	CALL PRINT_FACE(97,"笑顔","服",,"照れ")
	CALL CHARA_TEXT(97,"「웁스, 놓쳤어! 하하하하!」","w")
	PRINTL
	PRINTFORMDW 세이가 투파이를 풀어놓았고 당신과 사쿠야는 그것을 되찾아야 한다...
ENDIF
PRINTL
CALL AddEXPOrdered(ExperienceType,MASTER,LSScarletTaskExperienceGain)
CALL LS_SCARLET_ADD_PAY(ExperienceType,16)
TIME += RAND(35,70)
CALL LS_SCARLET_COMPLETE_SERVICE_TASK()

