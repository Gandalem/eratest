RESETCOLOR
SELECTCASE FairyIndex
	CASE 0
		SETCOLOR 0xDFDF14
	CASE 1
		SETCOLOR 0x5AE1E1
	CASE 2
		SETCOLOR 0x54EE54
ENDSELECT
SELECTCASE TOLOWER(Mode)
	CASE "l"
