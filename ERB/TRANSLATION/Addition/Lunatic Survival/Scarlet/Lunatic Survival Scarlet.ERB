DO
SIF !IS_FALLEN(CharacterIndex)
	RETURNF 0
SELECTCASE CharacterIndex
	CASE 15
		CharacterAlias '= "Sakuya"
		CharacterIndex = 16
	CASE 16
		CharacterAlias '= "Remilia"
		CharacterIndex = 50
	CASE 50
		CharacterAlias '= "Flandre"
		CharacterIndex = 54
	CASE 54
		CharacterAlias '= "Patchouli"
		CharacterIndex = 58
	CASE 58
		CharacterAlias '= "Meiling"
		CharacterIndex = 59
	CASE 59
		CharacterAlias '= "Koakuma"
		CharacterIndex = -1
ENDSELECT
SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletDependency),VAR_OR_DEFAULT(@"QBitLSScarlet%CharacterAlias%Dependency"))
	RETURNF 0
LOOP CharacterIndex != -1
RETURNF 1

