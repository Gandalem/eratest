			;If we're removing Wriggle and have the task to do so, complete it.
			IF IN_HOME(CFLAG:97:現在位置) == 1
				PRINTL
				CALL PRINT_FACE(97,"笑顔","服",,"照れ")
				CALL CHARA_TEXT(97,"「멋진 버그네, 내 거나 보고 싶어?」","w")
				PRINTL
				CALL PRINT_FACE(58,"怒り","服",,"照れ")
				CALL CHARA_TEXT(58,"「꺄아아악!」","w")
				PRINTL
				PRINTFORMDW 세이가 바퀴벌레 한 줌을 메이링에게 던지고, 메이링은 패닉에 빠져 위글을 놓는다.
				PRINTL
				CALL PRINT_FACE(27,"笑顔","服",,"照れ")
				CALL CHARA_TEXT(27,"「아하하, 나 자유다!」","w")
				PRINTL
				PRINTFORMDW 세이야와 위글은 함께 날아가고 메일링은 눈물 속에서 추격한다.
				PRINTL
			ENDIF
			CALL AddEXPOrdered("奉仕快楽経験",MASTER,LSScarletTaskExperienceGain)
			CALL LS_SCARLET_ADD_PAY("奉仕快楽経験")
