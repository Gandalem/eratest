		ENDSELECT
		ExperienceType '= "釣り経験"
	CASE 1
		PRINTFORMDW 너와 사쿠야, 그리고 레밀리아는 호숫가에서 진기한 것들을 사냥한다...
		SELECTCASE TALENT:MASTER:採集Lv
