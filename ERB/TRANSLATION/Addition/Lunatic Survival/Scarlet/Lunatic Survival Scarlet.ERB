@LS_SCARLET_NEW_COLLECTIBLES
;Returns true if there are new items in the panty, music, fish, or bug collections, and sets the RESULT array accordingly.
;Not a #FUNCTION so that ADD_CALCULATE_MUSIC_COLLECTION() can be used.
VARSET LOCAL
FOR LOCAL,1,CHARANUM
CALL CHECK_COLLECTION(LOCAL)
LOCAL:1 += RESULT:1
NEXT
FLAG:獲得パンツ種数 = LOCAL:1
LOCAL:1 -= QUEST_FLAG(LSScarletAlias,QLSScarletPantyCollection)
TRYCALL ADD_CALCULATE_MUSIC_COLLECTION
LOCAL:2 = RESULT:2-QUEST_FLAG(LSScarletAlias,QLSScarletMusicCollection)
FOR LOCAL,1,61
SIF FISH_NAME(LOCAL) != "" && FISH_EXP:(LOCAL)
	LOCAL:3++
NEXT
LOCAL:3 = LOCAL:3-QUEST_FLAG(LSScarletAlias,QLSScarletFishCollection)
FOR LOCAL,1,MAXMUSHI
SIF MUSHI_COLLECT:LOCAL
	LOCAL:4++
NEXT
LOCAL:4 = LOCAL:4-QUEST_FLAG(LSScarletAlias,QLSScarletBugCollection)
VARSET RESULT
FOR LOCAL,1,5
RESULT:LOCAL = LOCAL:LOCAL
IF LOCAL:LOCAL > 0
	RESULT = 1
ENDIF
NEXT
RETURN RESULT

