@LS_SCARLET_WAKASAGIHIME_SEIJA_MEETING
;Wakasagihime meets Seija.
SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeSeijaMeeting)
