@LS_SCARLET_FAVOR_TRADE(ItemIndex,FavorAmount,AllowQuantity=1,ItemAlias,RandomList)
;Processes a transaction for a specific item with the fairy maids and returns the quantity purchased.
;RandomList can take up to twenty random item indices in string format, separated by colons. Otherwise, uses ItemIndex.
;If ItemIndex is negative and RandomList is empty, processes the transaction without giving an item. Effects can be created elsewhere with RESULT.
#DIM DYNAMIC ItemIndex
#DIM DYNAMIC FavorAmount
#DIM DYNAMIC AllowQuantity
#DIMS DYNAMIC ItemAlias
#DIMS DYNAMIC RandomList
#DIM DYNAMIC CurrentFavor
#DIM DYNAMIC ItemQuantity
#DIM DYNAMIC RandomItemIndex
#DIM DYNAMIC RandomItemList,20
#DIM DYNAMIC RandomItemQuantityList,20
CurrentFavor = QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaidsFavor)
IF ItemAlias == ""
	PRINTFORMDL {FavorAmount} 호의를 얻어 %ITEMNAME_TR(ItemIndex)%을/를 얻는다?
ELSE
	PRINTFORMDL {FavorAmount} 호의로 %ItemAlias%를 얻는다?
ENDIF
PRINTFORMDL 현재 호의: %三桁区切(CurrentFavor)%
IF AllowQuantity
	PRINTFORMDL 원하는 숫자를 선택하거나 입력한다.
	PRINTL
	PRINTBUTTON "[없음] ",0
	PRINT [1]
	SIF CurrentFavor >= FavorAmount*2
		PRINT [2]
	SIF CurrentFavor >= FavorAmount*3
		PRINT [3]
	SIF CurrentFavor >= FavorAmount*4
		PRINT [4]
	SIF CurrentFavor >= FavorAmount*5
		PRINT [5]
	SIF CurrentFavor >= FavorAmount*10
		PRINT [10]
	SIF CurrentFavor >= FavorAmount*15
		PRINT [15]
	SIF CurrentFavor >= FavorAmount*20
		PRINT [20]
	$LOOP
	INPUT
	SIF RESULT*FavorAmount > CurrentFavor || RESULT < 0
		GOTO LOOP
ELSE
	PRINTL
	CALL ASK_YN()
	RESULT = !RESULT
ENDIF
SIF !RESULT
	RETURN 0
ItemQuantity = RESULT
FavorAmount = FavorAmount*ItemQuantity
CALL SUBTRACT_QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaidsFavor,FavorAmount)
PRINTL
IF RandomList == ""
	SIF ItemIndex > 0
		CALL GET_ITEM(ITEMNAME:ItemIndex,ItemQuantity,2)
	RETURN ItemQuantity
ELSE
	VARSET RandomItemList,-1
	FOR LOCAL:1,0,ItemQuantity
	RandomItemIndex = TOINT(SPLIT_G(RandomList))
	FOR LOCAL,0,20
	IF RandomItemList:LOCAL == RandomItemIndex || RandomItemList:LOCAL == -1
		RandomItemList:LOCAL = RandomItemIndex
		RandomItemQuantityList:LOCAL++
		BREAK
	ENDIF
	NEXT
	NEXT
	FOR LOCAL,0,20
	SIF RandomItemList:LOCAL < 0
		BREAK
	CALL GET_ITEM(ITEMNAME:(RandomItemList:LOCAL),RandomItemQuantityList:LOCAL,1)
	NEXT
	WAIT
ENDIF
RETURN ItemQuantity

