@LS_SCARLET_SAKUYA_INTERROGATION(Punishment)
;Sakuya shows up the morning after the contract is stolen to interrogate the player.
#DIM DYNAMIC Punishment
#DIM DYNAMIC Refused
SIF !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletDevilBook) || GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletSakuyaInterrogation)
	RETURN 0
CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletSameRoundEvent,5)
PRINTL
PRINTFORMDW 깨어나자 사타구니에 거대한 압박감이 느껴진다.
PRINTFORMDW 내려다보니 사쿠야가 침대 가장자리에 앉아 \@ HAS_PENIS(MASTER) ? 당신의 성기를 꺼내 귀두 바로 아래를 # 당신의 보지를 드러내 클리토리스를 \@ 문지르고 있다.
PRINTFORMDW 네가 정신을 차리는 것을 보자 그녀는 미소를 지으며 따뜻하게 인사한다.
PRINTL
CALL PRINT_FACE(15,"通常","服",,"照れ")
CALL CHARA_TEXT(15,@"「좋은 저녁이네요. 잘 주무셨나요?」","w")
IF Punishment
	IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletSakuyaFirstPunishment)
		PRINTFORMDW 예상대로, 그녀는 당신을 다시 벌하러 왔다. 하지만 어제 저택이 도난당했으니 분명 용서받을 수 있을 텐데...
	ELSE
		PRINTFORMDW 그녀는 네가 집안일을 끝내지 않은 것에 대해 벌을 주려 하는 건가? 하지만 어제 저택이 도둑맞았다는 걸 감안하면 말이야...
	ENDIF
	CALL CHARA_TEXT(15,@"「변명은 없어.」","w")
	PRINTFORMDW 사쿠야는 당신을 바로 제압한다. 평소라면 그녀의 눈이 약간 차가 보이지만, 오늘은 새하얀 뜨거운 불길로 타오르고 있었다.
	CALL CHARA_TEXT(15,@"「무슨 일이 있어도, 이 저택의 \@ IS_MALE(MASTER) ? 집사 # 하녀 \@가 일을 끝낼 것이다.」","w")
	CALL CHARA_TEXT(15,@"「그렇다고는 해도, 이번엔 단순히 벌을 받는 것만이 아니야...」","w")
ELSE
	PRINTFORMDW 기억하려고 노력한다. 너 어제 집안일 다 했잖아, 안 그래? 그럼 왜…
	CALL CHARA_TEXT(15,@"「흠? 나는 당연히 너를 벌하러 온 게 아니야. 네가 기대할 수 있는 만큼의 의무는 다했으니까. 도둑이 도망쳤다 하더라도...」","w")
ENDIF
PRINTL
CALL CHARA_TEXT(15,@"「이것은 심문이다. 내가 일어난 모든 것을 알고 싶고, 완전한 진실을 원한다. 그렇지 않다면...」","w")
PRINTL
CALL DIALOGUE_SEX(MASTER,15,0,1,-1,0,2,1)
PRINTL
PRINTFORMDW 당신은 머리가 베개 속으로 파묻히게 만드는 즉각적인 쾌락의 파도에 맞는다. 사정하지는 않지만 갑자기 정말로 하고 싶어진다.
CALL CHARA_TEXT(15,@"「...우리 둘 다 아주 오랫동안 여기에 있을 거야.」","w")
PRINTL
CALL CHARA_TEXT(15,@"「시계탑에서 뭐 하고 있었지? 네 임무 범위에는 그 구역이 포함되어 있지 않아.」","w")
$LOOP
PRINTL
CALL ASK_M( "계약을 훔치려고 한다",Refused ? -1 # 1, "탐색",1, "청소가 필요하다고 생각했다.",1, "지붕 문 자물쇠가 부서진 것을 발견하고 조사했다.",1, "휴식을 취하다",Refused && Punishment ? -1 # 1, "기계를 감상하며",1, "길을 잃었다",1, "대답을 거부한다",Refused ? -1 # 1, )
PRINTL
SELECTCASE RESULT
	CASE 0
		PRINTFORMDW 네가 자백하려고 노력해도 입이 열리지 않는다. 계약이 여전히 그것에 대해 말하는 것을 막고 있다.
		GOTO DAGAKOTOWARU
	CASE 1
		CALL CHARA_TEXT(15,@"「탐색이라니? 잠긴 문 뒤에서?」","w")
	CASE 2
		CALL CHARA_TEXT(15,@"「너, 지금 그랬니? 문이 잠겨 있었고 아무도 거기에 가라고 말하지 않았는데?」","w")
	CASE 3
		CALL CHARA_TEXT(15,@"「그리고 지붕 위에서 뭘 하고 있었지?」","w")
		Refused = 0
		$LOOP1
		PRINTL
		CALL ASK_M( "침입자의 흔적을 따라",1, "탐색",Refused && Punishment ? -1 # 1, "청소",Refused && Punishment ? -1 # 1, "휴식을 취하다",Refused && Punishment ? -1 # 1, "길을 잃었다",Refused ? -1 # 1, "대답을 거부한다",Refused ? -1 # 1, )
		PRINTL
		SELECTCASE RESULT
			CASE 0
				CALL CHARA_TEXT(15,@"「그러니까, 당신은 그녀를 뒤쫓았으면서도 그녀는 금고를 녹일 만큼의 시간을 가졌다는 거군요.」","w")
				CALL CHARA_TEXT(15,@"「그리고 그녀의 존재를 나에게 알리지 않고 그렇게 했다고 생각했나? 설령 이것이 사실이라 할지라도, 너는 부주의했다.」","w")
				PRINTFORMDW 사쿠야가 당신을 의심스럽게 바라본다...
			CASE 1
				IF Punishment
					CALL CHARA_TEXT(15,@"「맡겨진 임무를 완수하지 못하다니? 당신은 \@ IS_MALE(MASTER) ? 집사 # 하녀 \@로서 쓸모가 없지, 그렇지 않나? 하지만 난 그걸 믿지 않아.」","w")
					GOTO DAGAKOTOWARU1
				ELSE
					CALL CHARA_TEXT(15,@"「일이 끝나고 하는 게 그거인가? 저 저택에 대해 궁금한가?」","w")
					CALL CHARA_TEXT(15,@"「네 스케줄에 맞춰서 하면 상관없어.」","w")
				ENDIF
			CASE 2
				IF Punishment
					CALL CHARA_TEXT(15,@"「지붕을 청소한다고? 네가 할당된 임무조차 완수하지 못했는데, 나한테 그걸 믿으라고 기대하는 거야?」","w")
					GOTO DAGAKOTOWARU1
				ELSE
					CALL CHARA_TEXT(15,@"「지붕을 청소한다고? 그런 일 하라고 말한 적 없는데. 야근이라도 하고 있었던 거야?」","w")
					CALL CHARA_TEXT(15,@"「아니면 남에게 일을 떠넘기는 게으른 요정들 대신 네가 일한 건가?」","w")
				ENDIF
			CASE 3
				IF Punishment
					CALL CHARA_TEXT(15,@"「휴식이라니? 할당된 임무도 끝내지 못했는데?」","w")
					CALL CHARA_TEXT(15,@"「내가 그렇게 어리석어서 그걸 믿을 거라고 생각하나? 설령 사실이라 해도 너는 가치 없는 수치일 뿐이다.」","w")
					GOTO DAGAKOTOWARU1
				ELSE
					CALL CHARA_TEXT(15,@"「일이 끝난 후에 그런 짓을 하는 건가? 지붕으로 올라가는 거야?」","w")
					CALL CHARA_TEXT(15,@"「주인님께 봉사하는 데 좀 더 성실함을 보이고 싶군.」","w")
				ENDIF
			CASE 4
				CALL CHARA_TEXT(15,@"「지붕에 올라가려면 발코니에서 내려와야 했다. 너는 어디로 가고 있는지 알고 있었다.」","w")
				GOTO DAGAKOTOWARU1
			CASE 5
				CALL CHARA_TEXT(15,@"「당신은 이걸 진지하게 받아들이고 있지 않네요.」","w")
				$DAGAKOTOWARU1
				PRINTL
				CALL DIALOGUE_SEX(MASTER,15,0,1,-1,0,2,1)
				PRINTL
				PRINTFORMDW 너무 괴롭다. 당신은 필사적으로, 필사적으로 절정에 도달하고 싶어 한다. 다른 것을 생각할 수가 거의 없다.
				PRINTFORMDW 당신은 절정에 도달하고 싶어 한다. 당신은 반드시 절정에 도달해야만 한다. 당신은 무엇이든 해서 절정에 도달할 것이다.
				PRINTL
				CALL CHARA_TEXT(15,@"「다시 한번 말해라. 지붕에서 뭘 하고 있었지?」","w")
				Refused = 1
				GOTO LOOP1
		ENDSELECT
		PRINTL
		CALL CHARA_TEXT(15,@"「그렇게 자유로운 영혼이니 또 다른 질문이 있다.」","w")
		GOTO LAST
	CASE 4
		IF Punishment
			CALL CHARA_TEXT(15,@"「휴식이라니? 네가 할당된 임무조차 끝내지 못했는데 말이야?」","w")
			CALL CHARA_TEXT(15,@"「내가 그렇게 어리석어서 그걸 믿을 거라고 생각하는 거냐? 설령 사실이라 해도, 그건 너를 가치 없는 수치로 만들 뿐이다.」","w")
			GOTO DAGAKOTOWARU
		ELSE
			CALL CHARA_TEXT(15,@"「시계탑에서 말인가? 그런 곳에서 말이야?」","w")
			IF IS_MALE(MASTER)
				CALL CHARA_TEXT(15,@"「...호브고블린처럼 말이다. 인간의 머릿속에는 기계에 그렇게 끌리게 만드는 무언가가 있는 걸까?」","w")
			ELSE
				CALL CHARA_TEXT(15,@"「호그블린들이 가는 곳이군. 그들과 『재미』를 느낄 생각이었나?」","w")
			ENDIF
			CALL CHARA_TEXT(15,@"「그렇게 하루 일은 마쳤겠지... 하지만 그렇다고 해도 그 탑은 잠긴 문 뒤에 있다.」","w")
		ENDIF
	CASE 5
		IF IS_MALE(MASTER)
			CALL CHARA_TEXT(15,@"「호브고블린들처럼? 남자들의 두뇌에 기계에 그렇게 끌리게 만드는 무언가가 있는 건가?」","w")
		ELSE
			CALL CHARA_TEXT(15,@"「호그박스들이 하는 짓이지. 정말 그들에게 『즐거움』을 바라고 위로 올라갔는지 모르겠군?」","w")
		ENDIF
		CALL CHARA_TEXT(15,@"「당신의 욕정이 너무 강해서 잠긴 문을 지나 만족시키려 했습니까?」","w")
	CASE 6
		CALL CHARA_TEXT(15,@"「잃어버렸나? 잠긴 문 뒤에?」","w")
	CASE 7
		$DAGAKOTOWARU
		CALL CHARA_TEXT(15,@"「...아마 네가 상황을 충분히 이해하지 못하는 것 같다.」","w")
		PRINTL
		CALL DIALOGUE_SEX(MASTER,15,0,1,-1,0,2,1)
		PRINTL
		PRINTFORMDW 지금 와야 했는데... 오지 않았군. 온몸으로 퍼져나가는 압도적인 감각에 네 정신이 멍해진다.
		PRINTFORMDW 네 정신은 하얗게 변했지만, 동시에 그것을 온전히 인지하고 있었다. 고통스러웠다. 견딜 수 없었다. 놓으려고 해도 그럴 수 없었다.
		PRINTFORMDW 벌써는 감당할 수 없다. 너의 의지가 침식되고 있다. 사정해야 한다.
		PRINTL
		CALL CHARA_TEXT(15,@"「다시 묻겠다. 시계탑에서는 뭘 하고 있었지?」","w")
		Refused = 1
