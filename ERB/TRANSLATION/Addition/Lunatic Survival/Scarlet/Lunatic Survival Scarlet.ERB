@LS_SCARLET_PUSH_DOWN(CharacterIndex)
;Cancels push down if the player is carrying food that the character in question wants or uses Fairy Backup.
;If the character in question is Flandre, the player can fight her as well.
;If the character is Sakuya, the player can do a "cooking review" in the form of an Iron Chef contest.
;If the character is an intruder, the player can choose to have them removed from the mansion.
#DIM DYNAMIC CharacterIndex
SIF IS_HERE(93) && !IS_MET(93) ;If Wakasagihime is here and hasn't been introduced, force her introduction before anything else.
	CALL MEET_CHARACTER(93)
SIF !IS_MET(CharacterIndex) ;If the attacker's introduction hasn't played, force it.
	CALL MEET_CHARACTER(CharacterIndex)
CALL LS_SCARLET_REMILIA_SEXUAL_EDUCATION
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_FLANDRE_SEXUAL_EDUCATION
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_SAKUYA_FORCED_MASTURBATION
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_REMILIA_BELLY_RUB
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_REMILIA_TURNABOUT
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_MONSTER_FISHING
SIF RESULT
	GOTO SUCCEED
CALL QUEST_LUNATIC_SURVIVAL_SCARLET_REMILIA_SERVICE
SIF RESULT
	GOTO SUCCEED
CALL QUEST_LUNATIC_SURVIVAL_SCARLET_FLANDRE_PLAYTIME
SIF RESULT
	GOTO SUCCEED
IF IS_HERE(58) && SHIRAHU(58) && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletPatchouliDevilBookStudied) && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletMeilingCatchMarisa)
	CALL QUEST_LUNATIC_SURVIVAL_SCARLET_MEILING_CATCH_MARISA
	GOTO SUCCEED
ENDIF
CALL QUEST_LUNATIC_SURVIVAL_SCARLET_MEILING_RELIEF
IF RESULT
	GOTO SUCCEED
ELSEIF CharacterIndex == 93
	GOTO FAIL
ELSEIF IS_HERE(93) && IS_LS_SAFE(93)
	;Wakasagihime intervenes if someone tries to push the player down in her presence.
	PRINTL
	PRINTFORMDL %CALLNAME:CharacterIndex%는 %HIS_HER(CharacterIndex)%의 눈에 배고픈 기색이 있다...
	PRINTL
	CALL LS_INTERRUPT_MESSAGE(93,CharacterIndex,GET_TARGETNUM()-1)
	FOR LOCAL,1,GET_TARGETNUM()+1
	SIF !IS_LS_SAFE(TARGET:LOCAL) && LOCAL != 93
		CALL GETOUT(TARGET:LOCAL)
	NEXT
	CALL LS_SCARLET_FALSE_ESCAPE
	;Afterwards her Sexual Frustration increases and she will push the player down if it reaches 100% after her event line.
	CFLAG:93:溜まってる度 = MIN(CFLAG:93:溜まってる度+RAND(100,200),1000)
	SIF CFLAG:93:溜まってる度 > 999 && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeConfession)
		CALLF SET_VAR(@"nForcePushDown:93",1)
	GOTO SUCCEED
ELSEIF DISH_NAME == "" && !GROUPMATCH(CharacterIndex,15,50) && (!GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackup) || GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackedUp)) && QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletConquestEnd
	$FAIL
	;Nullify PALAMs to keep time spent consistent on repeated push downs.
	FOR LOCAL,1,GET_TARGETNUM()+1
	PALAM:(TARGET:LOCAL):快Ｃ = 0
	PALAM:(TARGET:LOCAL):快Ｖ = 0
	PALAM:(TARGET:LOCAL):快Ａ = 0
	PALAM:(TARGET:LOCAL):快Ｂ = 0
	PALAM:(TARGET:LOCAL):快Ｍ = 0
	PALAM:(TARGET:LOCAL):欲情 = 0
	NEXT
	RESULT = 0
	RETURN 0
ENDIF
PRINTL
PRINTFORMDL %CALLNAME:CharacterIndex%는 %HIS_HER(CharacterIndex)%의 눈에 배가 고픈 표정을 하고 있다...
PRINTL
CALL ASK_M( "몸을 내어라",1, @"%DISHNAME_TR(DISH_NAME)%을 제공한다",DISH_NAME != "" ? 1 # -1, "지원을 요청한다",(GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackup) && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackedUp)) ? 1 # -1, @"\@ CharacterIndex == 15 ? 요리 리뷰를 한다 # 그녀와 싸운다 \@",GROUPMATCH(CharacterIndex,15,50) ? 1 # -1, @"%HIM_HER(CharacterIndex)%에게 진정하라고 명령한다.",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) == QLSScarletConquestEnd ? 1 # -1, )
PRINTL
VARSET LOCAL
SELECTCASE RESULT
	CASE 0
		GOTO FAIL
	CASE 1
		CALL LS_PUSH_DOWN_FOOD_ESCAPE(CharacterIndex)
		SIF !RESULT
			GOTO FAIL
	CASE 2
		PRINTFORMDL 한 무리의 요정들이 간식과 음료가 담긴 쟁반을 들고 달려 들어왔다.
		CALL KOJO_MESSAGE_SEND("EVENT",0,CharacterIndex,0,0,"FAIRY_BACKUP_LS")
		IF !RESULT ;If there's no dialogue-specific text, fall back to a default.
			CALL SET_KOJO_COLOR(CharacterIndex)
			RESULT = 0
			TRYCALLFORM LS_SCARLET_K{CharacterIndex}_FAIRY_BACKUP
			RESETCOLOR
		ENDIF
		SIF !RESULT
			PRINTFORMDL 당신은 %CALLNAME:CharacterIndex%를 위해 간식을 몇 개 골라주며, %HIM_HER(CharacterIndex)%에게 멋진 마사지를 해준다...
		PRINTFORMDW \@ GET_TARGETNUM() > 1 ? 모두가 당신을 밀어내는 것을 잠시 잊고 호화로운 서비스를 즐긴다 # %CALLNAME:CharacterIndex%은(는). \@
		FOR LOCAL,1,GET_TARGETNUM()+1
		;Affect everyone in the room.
		PRINTL
		CALL RECOVER_ALL(TARGET:LOCAL,600,"Fairy care",20)
		PRINTL
		CALL CHANGE_CFLAG(2,TARGET:LOCAL,40)
		CALL CHANGE_CFLAG(4,TARGET:LOCAL,30)
		NEXT
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids,QBitLSScarletFairyMaidsFairyBackedUp,1)
	CASE 3
		IF CharacterIndex == 15
			LOCAL:5 = TARGET
			TARGET = 15
			FOR LOCAL,1,4
			$PICKJUDGE
			LOCAL:4 = TOINT(SPLIT_G(@"16:16:16:50:50:54:54:58:58:59:59%COND_STR(":11",IN_HOME(CFLAG:11:現在位置) == 1)%%COND_STR(":27",IN_HOME(CFLAG:27:現在位置) == 1)%%COND_STR(":51",IN_HOME(CFLAG:51:現在位置) == 1)%%COND_STR(":93",IN_HOME(CFLAG:93:現在位置) == 1 && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeMonsterFishing))%%COND_STR(":97",IN_HOME(CFLAG:97:現在位置) == 1)%"))
			SIF GROUPMATCH(LOCAL:4,LOCAL:1,LOCAL:2)
				GOTO PICKJUDGE
			LOCAL:LOCAL = LOCAL:4
			NEXT
			TRYCALL IRON_CHEF_CONTEST(4,LOCAL:1,LOCAL:2,LOCAL:3,10,80,98)
			TARGET = LOCAL:5
			TIME -= 80
			IF RESULTS:2 != "棄権"
				IF ABL:MASTER:料理技能 < ABL:15:料理技能
					IF ONCE("LSSakuyaCookingReview",1,-1)
						PRINTL
						CALL AddEXPOrdered("料理経験",MASTER,LSScarletTaskExperienceGain-2)
					ELSE
						PRINTFORMDW 오늘 밤 사쿠야랑 이미 검토했으니까 별로 배운 게 없다고 느끼는구나...
					ENDIF
				ELSEIF ABL:MASTER:料理技能 > ABL:15:料理技能
					IF ONCE("LSSakuyaCookingReview",1,-1)
						PRINTL
						CALL AddEXPOrdered("料理経験",15,LSScarletTaskExperienceGain-2)
					ENDIF
				ENDIF
				IF ONCE("LSSakuyaCookingReview",0,-1)
					PRINTL
					CALL CHANGE_CFLAG(2,15,10)
					CALL CHANGE_CFLAG(4,15,5)
				ENDIF
			ENDIF
			SIF RESULTS:2 != "勝利"
				GOTO FAIL
		ELSE
			SELECTCASE QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition)
				CASE 0
					PRINTFORMDW 다른 사람들과는 달리, 플랜더를 거부할 수 없을 것 같지 않다. 사실은 그 반대이다. 싸우도록 강요받고 있다.
					PRINTFORMDW 네가 자신을 방어할 준비를 하는 것을 보자, 플랜더의 악의적인 미소는 더욱 넓어진다...
				CASE 1
					PRINTFORMDW 지난번에는 통하지 않았다. 이번에도 그럴 것 같지 않다.
					PRINTFORMDW 그럼에도 불구하고, 다가오는 소녀에 맞서 자신을 방어하려 한다...
			ENDSELECT
			PRINTL
			CALL DANMAKU_BATTLE(50)
			PRINTL
			SELECTCASE RESULT
				CASE 0
					SELECTCASE QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition)
						CASE -1
							CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition,-2)
							PRINTFORMDW 플랜더는 다시 쓰러지지만, 이번에는 격추되면서 웃었다.
							CALL CHARA_TEXT(50,@"「아하하하, 전혀 예상 못 했어... 이봐, 다시 할까? 다시 하자!」","w")
							PRINTFORMDW 플랜더는 상당히 의욕적이지만, 조금 인내심을 갖고 좀 쉬어야 한다. 그녀는 방금 너무 무리했다.
							CALL CHARA_TEXT(50,@"「오카아아이, 조금만~」","w")
							PRINTFORMDW 적어도 그녀는 이제 당신의 제안을 따르고 있다.
						CASE -2
							PRINTFORMDW 플랑은 %SPLIT_G("연기에 휩싸여 쓰러지지만, 바닥에서 그을리면서도 계속 웃는다.:패자의 역할을 연기하듯 과장되게 쓰러진다.:패배한 채 바닥을 기며 눈물을 삼킨다. 대결에 너무 몰입한 모양이다...:또다시 완패하고, 당신은 안도의 한숨을 내쉰다.")%
							CALL CHARA_TEXT(50,@"「%SPLIT_G("아아, 내가 그렇게 지다니 믿을 수 없어!:아하하하, 져 버렸네...:아앙, 끝나고 야한 놀이 하고 싶었는데...:으으, 너무 강하잖아...")%」","w")
						CASEELSE
							CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition,-1)
							CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletDependency,QBitLSScarletFlandreDependency,1)
							PRINTFORMDW 플래드르가 마침내 쓰러진다. 그녀는 착지하여 비틀거리며 발을 딛고 서 있지만, 얼굴은 믿을 수 없다는 표정으로 굳어 있다가 결국 무더기처럼 쓰러진다.
							CALL CHARA_TEXT(50,@"「하하하... 하하하...!」","w")
							PRINTFORMDW 그녀는 땅에 쓰러져 어색한 팔다리 더미가 되어 정신없이 웃는다. 당신은 잠시 숨을 고른다...
							CALL CHARA_TEXT(50,@"「하인에게 지다니... 이상하지 않아...?」","w")
							PRINTFORMDW 숨을 고른 후, 플랜드를 향해 다가가 그녀를 부축해주겠다고 제안한다. 그녀는 조심스럽게 몸을 일으키지만 당신의 손을 놓지 않는다.
							PRINTL
							CALL CHARA_TEXT(50,@"「헤이, 어떻게 그렇게 강해진 거지? 말해줘.」","w")
							PRINTFORMDW 플랜더는 네가 그토록 많이 싸우면서 강해진 것을 만들어준 사람이다. 그런 말을 들으니 그녀의 얼굴에 환한 미소가 피어난다.
							PRINTFORMDW 평소에 보는 것보다 덜 소름 끼치는 미소다. 마치 아이의 애정처럼 부드럽고 순수하게 느껴진다.
							CALL CHARA_TEXT(50,@"「나 덕분에 그렇게 강해진 거야? 와...」","w")
							CALL CHARA_TEXT(50,@"「그럼 많이 플레이하면 더 강해지나요?」","w")
							PRINTFORMDW 플랜더가 당신에게 다가가 팔을 감싸 안고 몸을 밀착한다. 그녀의 눈에는 흥미로운 빛이 어른거린다.
							PRINTFORMDW 아마 싸운다면, 플랜더도 더 강해질 것이다.
							PRINTL
							CALL CHARA_TEXT(50,@"「더 많이 놀자.」","w")
							PRINTFORMDW 위험한 느낌이 다시 오고 있다.
							CALL CHARA_TEXT(50,@"「내가 더 강해져서 너를 이길 거고, 너도 더 강해질 거야. 그렇지?」","w")
							SIF HAS_PENIS(MASTER) || HAS_PENIS(50)
								CALL CHARA_TEXT(50,@"「그리고 우리는 섹스를 하고 아주 건강한 아기도 가질 거야... 나랑 그렇게 해줄 거지?」","w")
							PRINTFORMDW ...정말로, 어떻게 거절할 수 있겠어? 네가 그녀를 보게 되면 한 가지든 다른 방식으로 플랜더와 놀 테니까.
							PRINTFORMDW 플랜더는 웃으며 발끝으로 몸을 튀기더니 너를 꽉 껴안고 엄청난 압력을 네 몸에 가한다.
							CALL CHARA_TEXT(50,@"그럼 나는 ~할 것이다 ","")
							SETCOLOR LSScarletColor
							PRINTFORM ~에 따라
							RESETCOLOR
							CALL CHARA_TEXT(50,@" 이제부터 아주 재미있게 해줄게~","w")
					ENDSELECT
					FOR LOCAL,1,GET_TARGETNUM()+1
					CFLAG:(TARGET:LOCAL):ディレイ += 60
					NEXT
					LOCAL = 1
				CASEELSE
					SELECTCASE RESULT
						CASE 1
							PRINTFORMDW 승리에 가까워졌음에도 불구하고, 너는 완전히 패배했다. 플랜드르는 기뻐하며 크게 웃는다.
						CASE 2
							PRINTFORMDW 비록 그녀를 타격하는 데 성공했지만, 너는 여전히 패배했다. 플랜더가 축하하며 웃는다.
						CASEELSE
							PRINTFORMDW 너는 완전히 패배했고 재가 되어 남았다. 그녀에게는 상대조차 되지 않았다. 플랜더가 기분 좋게 흥얼거린다.
					ENDSELECT
					SELECTCASE QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition)
						CASE 0
							PRINTFORMDW 이 소녀의 힘은 당신이 기대할 수 있는 그 무엇을 넘어서 있다...
							CALL CHARA_TEXT(50,@"「캬하하하~! 꽤 약했지～?」","w")
							CALL CHARA_TEXT(50,@"「이봐, 일어나. 난 아직 하고 싶어...」","w")
							PRINTFORMDW 지금은 설 기분이 아니다. 거의 움직일 수가 없다.
							CALL CHARA_TEXT(50,@"「흠~... 음, 움직이지 않아도 난 오래도록 할 수 있는 게임을 알고 있어~」","w")
						CASE 1
							CALL CHARA_TEXT(50,@"「아하하, 저게 뭐야? 또 죽었네~!」","w")
							PRINTFORMDW 플랜더에 맞선 당신의 두 번째 전투는 첫 번째와 다를 바가 없었다. 플랜더는 쓰러진 당신의 몸을 향해 승리를 자축한다.
							CALL CHARA_TEXT(50,@"「이제 최고의 부분이 온다~...」","w")
						CASE 2
							CALL CHARA_TEXT(50,@"「내가 이겼어! 내가 이겼어! 나아아아아아아아아아아아!」","w")
							PRINTFORMDW 플랜더는 당신이 세 번째로 쓰러지자 주위를 뛰어다닌다. 그녀는 보상을 받으려는 듯 당신에게 달려와 당신이 일어나려 할 때 다가온다...
						CASEELSE
							IF ABL:MASTER:戦闘能力 < ABL:50:戦闘能力
								PRINTFORMDW 너는 다시 플랜드를 쓰러뜨리는 데 실패했다. 비록 빠르게 배우고 있지만, 그 교훈은 고통스럽다...
							ELSE
								PRINTFORMDW 너는 플랜더와 대등해 보였지만, 그녀가 결국 너를 이겼다. 고통스러운 패배다...
							ENDIF
							PRINTFORMDW 그리고 고통은 이제 막 시작된 것뿐이다.
					ENDSELECT
					CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletSameRoundEvent,50)
					LOCAL = 0
			ENDSELECT
			SIF QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition) > -1
				CALL ADD_QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition,1)
			IF ABL:MASTER:戦闘能力 < ABL:50:戦闘能力
				IF ONCE("LSDuelBonus",1,50)
					PRINTL
					CALL AddEXPOrdered("戦闘経験",MASTER,LSScarletTaskExperienceGain)
				ELSE
					PRINTFORMDW 너 오늘 밤 그녀랑 이미 싸웠잖아. 그래서 뭘 많이 배웠다는 느낌이 안 드네...
				ENDIF
			ELSEIF ABL:MASTER:戦闘能力 > ABL:50:戦闘能力
				IF ONCE("LSDuelBonus",1,50)
					PRINTL
					CALL AddEXPOrdered("戦闘経験",50,LSScarletTaskExperienceGain)
				ENDIF
			ENDIF
			IF ONCE("LSDuelBonus",0,50)
				PRINTL
				CALL CHANGE_CFLAG(2,50,30)
				CALL CHANGE_CFLAG(4,50,20)
			ENDIF
			SIF !LOCAL
				GOTO FAIL
		ENDIF
	CASE 4
ENDSELECT
$SUCCEED
FOR LOCAL,1,GET_TARGETNUM()+1
SIF !IS_LS_SAFE(TARGET:LOCAL) && TARGET:LOCAL != 93
	CFLAG:(TARGET:LOCAL):ディレイ += 60
NEXT
CALL LS_SCARLET_EJECT
RESULT = 1
RETURN RESULT

@LS_SCARLET_EJECT
;Gives the option to eject intruders from the mansion after push down escape or slip out.
#DIM DYNAMIC CheckTarget
#DIM DYNAMIC TargetIndex
#DIM DYNAMIC Ejected
SIF !IS_MET(58)
	RETURN
CALL TARGETSET_CHACK("「同室更新無し」") ;Refresh targets in case someone just arrived.
FOR CheckTarget,1,GET_TARGETNUM()+1
SIF !IS_LS_INTRUDER(TARGET:CheckTarget)
	CONTINUE
TargetIndex = TARGET:CheckTarget
$REMOVELOOP
PRINTL
