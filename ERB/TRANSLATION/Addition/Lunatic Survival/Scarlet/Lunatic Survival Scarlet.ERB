		CFLAG:MASTER:初期位置 = 304
		CFLAG:16:初期位置 = 326
		PRIVATEROOM:4 = MASTER
		PRIVATEROOM:26 = 16
		TIME:3 = 1200
	CASE QLSScarletConquestEnd
		FLAG:甲斐性無 = LS_LUST()
		CALLF SET_VAR("FLAG:LUSTMODE",1)
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletActive,1)
		TALENT:58:一線越えない = 0
