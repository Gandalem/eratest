@QUEST_LUNATIC_SURVIVAL_SCARLET_REWRITE_CONTRACT
;Putting the game in another end state or changing options after the ending.
SETCOLOR LSScarletColor
PRINTL
PRINTL
CALL D_LINE
PRINTL
PRINTL
PRINTFORMDL 당신은 하루에 단 한 번만 다른 엔드 스테이트로 변경할 수 있다.
PRINTL
CALL ASK_M( "계약 조건을 무효화한다.",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletFreedomEnd && ONCE("LSScarletChangeEndState",1,-1), "레밀리아의 하인이 되어라",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletServitudeEnd && ONCE("LSScarletChangeEndState",1,-1), "저택의 주인이 되어라",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletConquestEnd && ONCE("LSScarletChangeEndState",1,-1), "상세 내용을 확인한다.",1, @"욕망 모드 강도 변경하기 (현재 {QUEST_FLAG(LSScarletAlias,QLSScarletLust)}에서)",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletFreedomEnd, "완료",1, )
PRINTL
SELECTCASE RESULT
	CASE 0
		CALL LS_SCARLET_END_STATE(QLSScarletFreedomEnd)
		CALLF ONCE("LSScarletChangeEndState",0,-1)
	CASE 1
		CALL LS_SCARLET_END_STATE(QLSScarletServitudeEnd)
		CALLF ONCE("LSScarletChangeEndState",0,-1)
	CASE 2
		CALL LS_SCARLET_END_STATE(QLSScarletConquestEnd)
		CALLF ONCE("LSScarletChangeEndState",0,-1)
	CASE 3
		CALL LS_SCARLET_END_STATE_RULES
	CASE 4
		CALL ADD_QUEST_FLAG(LSScarletAlias,QLSScarletLust,1)
		SIF QUEST_FLAG(LSScarletAlias,QLSScarletLust) > 3
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletLust,0)
	CASE 5
		RETURN
ENDSELECT
