@QUEST_LUNATIC_SURVIVAL_SCARLET_PATCHOULI_MAGIC_CIRCLE
;Asking Patchouli for help with the magic circle on the tower door.
VARSET LOCAL
IF IS_HERE(16)
	PRINTFORMDW 레밀리아가 여기 있을 때는 이 이야기를 꺼내지 말아야 한다.
	RETURN
ENDIF
IF IS_HERE(15)
	PRINTFORMDW 사쿠야가 여기에 있을 때 이 일은 꺼내서는 안 된다.
	RETURN
ENDIF
PRINTFORMDW 당신이 패치울리에게 무언가를 대신 봐달라고 부탁하면, 그녀는 의심스럽게 당신을 흘겨본다.
PRINTL
CALL PRINT_FACE(54,"怒り","服")
SELECTCASE DAY % 7
	;Different threats for different days of the week.
	CASE 0
		;Sunday, Sun.
		CALL CHARA_TEXT(54,@"「몸의 일부를 보여주려 한다면, 네 눈을 햇빛으로 채워주지.」","w")
	CASE 1
		;Monday, Moon.
		CALL CHARA_TEXT(54,@"「만약 내게 신체 부위를 보여주려 한다면, 네 머리 위에 달을 떨어뜨릴 것이다.」","w")
	CASE 2
		;Tuesday, Fire.
		CALL CHARA_TEXT(54,@"「몸의 일부를 보여주려고 한다면 불태워 버리겠다.」","w")
	CASE 3
		;Wednesday, Water.
		CALL CHARA_TEXT(54,@"「만약 네가 나에게 신체 부위를 보여주려 한다면, 나는 너의 폐를 물로 채울 것이다.」","w")
	CASE 4
		;Thursday, Wood.
		CALL CHARA_TEXT(54,@"「만약 네가 나에게 신체 부위를 보여주려고 한다면, 책장을 너 위에 떨어뜨릴 것이다.」","w")
	CASE 5
		;Friday, Metal.
		CALL CHARA_TEXT(54,@"「만약 네가 내게 신체 부위를 보여주려 한다면, 나는 그것을 금속으로 주조해서 장식용으로 사용할 것이다.」","w")
	CASE 6
		;Saturday, Earth.
		CALL CHARA_TEXT(54,@"「만약 네가 내게 신체 부위를 보여주려고 한다면, 나는 너를 땅속에 가라앉힐 것이다.」","w")
ENDSELECT
PRINTFORMDW 그녀가 노려보며 날카롭게 쏘아붙이기 전에, 당신은 단지 마법과 관련된 무언스에 대해 궁금할 뿐이라고 안심시켜야 한다...
PRINTL
CALL PRINT_FACE(54,"通常","服")
CALL CHARA_TEXT(54,@"「그래서 뭘 원하는 거지?」","w")
PRINTFORMDW 당신이 마법진을 제시하면 패치울리는 그것을 한 번 보고 재빨리 대답한다.
PRINTL
CALL CHARA_TEXT(54,@"「그건 평범한 마법진이 아니다. 악마의 봉인이다. 그것을 만들기에 사용되지 않은 피를 가진 자들이 가까이 오는 것을 막는다.」","w")
CALL CHARA_TEXT(54,@"「레미가 요즘 이런 걸 그리고 있는 것 같아. 평소에는 이런 종류의 것에 관심 없는데, 아마 심심해서 그런 게 아닐까.」","w")
CALL CHARA_TEXT(54,@"「...통과하는 방법을 알고 싶나? 왜?」","w")
PRINTL
CALL ASK_M( "나는 시계탑에 들어가고 싶다",1, "나도 이런 걸 직접 만들고 싶다.",1, "그냥 궁금해서",1, )
PRINTL
SELECTCASE RESULT
	CASE 0
		CALL CHARA_TEXT(54,@"「코아쿠마가 그곳은 하인들이 자주 가는 인기 있는 장소라고 말해주었다. 아마 평화로울지도 모르겠다.」","w")
	CASE 1
		CALL CHARA_TEXT(54,@"「네가 생각하는 것보다 더 어려울 거다. 악마 마법은 나조차 쉽게 할 수 있는 게 아니니까.」","w")
	CASE 2
		CALL CHARA_TEXT(54,@"「…그렇게 말씀하시겠다면。」","w")
		PRINTFORMDW 파츄리의 표정은 의심스럽지만, 그녀는 그 점을 강요하지 않는다.
ENDSELECT
CALL CHARA_TEXT(54,@"「우선, 당신은 그 원에 접근할 수 있는 누군가의 도움이 필요하다.」","w")
CALL CHARA_TEXT(54,@"「당신은 그 사람을 이용해 자신의 피를 그것에 주입해야 하며, 그러면 통과할 수 있다.」","w")
CALL CHARA_TEXT(54,@"「하지만 그 과정은 네가 할 수 있는 일이 아니다. 그것을 시도하는 것 자체가 너의 수준을 넘어선다.」","w")
PRINTFORMDW 그렇다고 해도, 봉인을 통과하지 않고는 더 나아갈 수 없다. 당신은 조심스럽게 패치울리에게 해줄 말이 없는지 묻는다.
PRINTL
CALL CHARA_TEXT(54,@"「아니, 없어. 이런 것의 기초조차 가르치려면 밤을 새고도 남을 거야.」","w")
CALL CHARA_TEXT(54,@"「도서관에 그 주제에 대한 마법서가 있을 것이다. 그렇게 관심이 있다면, 코아쿠마에게 그것을 찾아달라고 해 보아라.」","w")
IF !IS_HERE(59)
	CALL CHARA_TEXT(54,@"「코아쿠마, 이리 와라.」","w")
	PRINTFORMDW 파초리가 이름을 중얼긴 지 얼마 지나지 않아, \@ IS_MET(59) ? 코아쿠마 # 누군가가 책장 뒤에서 걸어 나왔다. \@
	PRINTL
	CALL MOVE_CHARACTER(59)
ENDIF
CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletEvent,QBitLSScarletPatchouliMagicCircle,1)

