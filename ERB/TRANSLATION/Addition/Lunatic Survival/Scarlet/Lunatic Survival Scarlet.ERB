@LS_SCARLET_SELL_MATERIALS
;Selling materials to the kappa warehouse.
#DIM DYNAMIC ItemIndex
#DIM DYNAMIC ItemQuantity
PRINTL
PRINTL
CALL D_LINE
PRINTL
PRINTL
PRINTFORML 돈: %金額表示(MONEY)%
CALL D_LINE
LOCAL:1 = 999
FOR LOCAL:0 ,600, 700
IF LS_SCARLET_SELLABLE_ITEM(LOCAL:0)
	IF ITEM:(LOCAL:0)
		LOCALS:0 = [{LOCAL:0,3}] %ITEMNAME_TR(LOCAL:0), 32, LEFT%×{ITEM:(LOCAL:0),3}
		LOCAL:1 += STRLENS(LOCALS:0)
		SIF ITEM:(LOCAL:0) < 10
			LOCAL:1 ++
		IF LOCAL:1 > 90
			IF LOCAL:1 >= 999
			ELSE
				PRINTL
			ENDIF
			LOCAL:1 = 0
			PRINT
		ENDIF
		PRINTFORM %LOCALS%
		PRINT
	ENDIF
ENDIF
NEXT
PRINTL
PRINTL 　　[100] 반환
DRAWLINE
PRINTL
$INPUT_LOOP01
INPUT
ItemIndex = RESULT
IF ItemIndex == 100
ELSEIF !LS_SCARLET_SELLABLE_ITEM(ItemIndex)
	CLEARLINE 1
	GOTO INPUT_LOOP01
ENDIF
SELECTCASE ItemIndex
	CASE 100
		RETURN
	CASEELSE
		ItemQuantity = ITEM:(ItemIndex)
		CLEARLINE 1
		IF ItemQuantity
			PRINTFORMD %ITEMNAME_TR(ItemIndex)%는 개당 %金額表示(LS_SCARLET_ITEM_VALUE(ItemIndex))%와 교환하여 맡길 수 있다.
			SETCOLOR 0x777777
			PRINTFORML 　몇 개를 팔지 선택하세요. (1～{ItemIndex}을 입력하세요. 0은 취소합니다.)
			RESETCOLOR
			PRINTL
			PRINTBUTTON "[0] 취소", 0
			PRINT
			PRINTBUTTON "[1] 1", 1
			PRINT
			IF ItemQuantity >= 5
				PRINTBUTTON "[5] 5", 5
				PRINT
			ENDIF
			IF ItemQuantity >= 10
				PRINTBUTTON "[10] 10", 10
				PRINT
			ENDIF
			$INPUT_LOOP02
			INPUT
			SELECTCASE RESULT
				CASE 0
					RESTART
				CASE 1 TO ItemQuantity
					CLEARLINE 2
					ItemQuantity = RESULT
					PRINTFORMDW %NUM_COUNT(ItemQuantity)% %ITEMNAME_TR(ItemIndex)%를/을 %金額表示(LS_SCARLET_ITEM_VALUE(ItemIndex)*ItemQuantity)%로 교환했다.
					MONEY += (LS_SCARLET_ITEM_VALUE(ItemIndex)*ItemQuantity)
					ITEM:(ItemIndex) -= ItemQuantity
					RESTART
				CASEELSE
					CLEARLINE 1
					GOTO INPUT_LOOP02
			ENDSELECT
		ELSE
			CLEARLINE 1
			GOTO INPUT_LOOP01
		ENDIF
ENDSELECT
RESTART

@LS_SCARLET_SELLABLE_ITEM(ItemIndex)
;Returns true if the given item can be sold to the kappa warehouse.
#FUNCTION
#DIM DYNAMIC ItemIndex
SIF !INRANGE(ItemIndex,600,699) && !INRANGE(ItemIndex,351,383) && !INRANGE(ItemIndex,500,515) && !INRANGE(ItemIndex,711,712) && ItemIndex != 923 ;Materials, crops, potions, eggs.
	RETURNF 0
SELECTCASE ItemIndex
	CASE 501,502,610,638,644,645,660 TO 664,666,668,669
		RETURNF 0
	CASE 649 TO 659,670 TO 699
		RETURNF 0
	CASEELSE
		RETURNF 1
ENDSELECT

@LS_SCARLET_ITEM_VALUE(ItemIndex)
;Returns the sale price of an item sold to the kappa warehouse.
#FUNCTION
#DIM DYNAMIC ItemIndex
SIF ItemIndex == 361 ;Kappa will pay more for cucumbers.
	RETURNF (ITEMPRICE:ItemIndex)/2
RETURNF ITEMPRICE:ItemIndex/5

