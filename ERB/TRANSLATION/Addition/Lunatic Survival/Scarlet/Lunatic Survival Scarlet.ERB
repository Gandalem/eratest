	RETURN 0
SIF EQUIP:下半身下着２
	PantsName '= PANTSNAME(EQUIP:50:下半身下着２,50)
PRINTL
PRINTFORMDW 플랜더가 그녀의 신발로 당신을 짓밟으며, 당신이 \@ OUTROOF(CFLAG:MASTER:現在位置) ? 바닥 # 가에 등을 기댄 채 고정한다 \@.
PRINTFORMDW 당신은 스커트 자락과 그 아래의 \@ EQUIP:50:下半身下着２ ? %PantsName% # 대머리 보지 \@%COND_STR("과 성기",HAS_PENIS(50) && !EQUIP:50:下半身下着２)%를 넘어서 그녀가 미소 짓는 얼굴을 거의 볼 수 없다.
PRINTL
CALL PRINT_FACE(50,"通常","服",,"照れ")
CALL CHARA_TEXT(50,@"「음? 어디를 보고 있니? 밑바닥 하급 시종치고는 꽤 대담하네~」","l")
FORCEWAIT
CALL CHARA_TEXT(50,@"「내 \@ EQUIP:50:下半身下着２ ? 팬티 # 사적인 곳을 \@? 나도 뭔가 보고 싶단 말이야...」","w")
CALL CHARA_TEXT(50,@"「...하지만 이런 것들이 방해하고 있으니, 터뜨려 버리자%UNICODE(0x2764)%」","w")
PRINTL
PRINTFORMDW 플랜드르는 손가락을 넓게 펼친 뒤 주먹을 쥔다. 그러자 네 몸 주변의 옷이 한순간에 사라진다.
IF HAS_PENIS(MASTER)
	PRINTFORMDW 당신의 %TINKO(MASTER)%가 그녀 아래에서 서고 그녀는 당신의 얼굴을 보지 않는다.
	PRINTFORMDW 장난기가 그녀의 눈에 춤추고, 홍조가 그녀의 뺨으로 솟아오르며, 마치 비밀스러운 보물을 발견한 듯 그녀는 미소 짓는다.
	IF !HAS_PENIS(16) && !HAS_PENIS(50)
		IF IS_MALE(MASTER)
			CALL CHARA_TEXT(50,@"「우와! 그래서 남자들은 이런 걸 가지고 있구나~」","w")
		ELSE
			CALL CHARA_TEXT(50,@"「와! 왜 그걸 가지고 있어? 너 여자 아니었어?~」","w")
		ENDIF
	ELSEIF HAS_PENIS(50) && HAS_PENIS(50) && TALENT:16:形状 == TALENT:MASTER:形状 && TALENT:50:形状 == TALENT:MASTER:形状
		CALL CHARA_TEXT(50,@"「와! 내 거랑 여동생 거랑 똑같이 생겼네, 응?～」","w")
		TypeMatch = 3
	ELSEIF HAS_PENIS(16) && TALENT:16:形状 == TALENT:MASTER:形状
		CALL CHARA_TEXT(50,@"「우와! 내 여동생이랑 똑같이 생겼네, 응?～」","w")
		TypeMatch = 2
	ELSEIF HAS_PENIS(50) && TALENT:50:形状 == TALENT:MASTER:形状
		CALL CHARA_TEXT(50,@"「와! 꼭 내 거 같네, 응?～」","w")
		TypeMatch = 1
	ENDIF
	FOR LOCAL,0,2
	SELECTCASE LOCAL
		CASE 0
			CharacterIndex = 16
		CASE 1
			CharacterIndex = 50
	ENDSELECT
	IF HAS_PENIS(CharacterIndex)
		IF TALENT:MASTER:形状 > TALENT:CharacterIndex:形状
			BiggerThan:LOCAL = 1
		ELSE
			SmallerThan:LOCAL = 1
		ENDIF
		IF TALENT:MASTER:形状 == TALENT:CharacterIndex:形状 || (GROUPMATCH(TALENT:MASTER:形状,1,2) && GROUPMATCH(TALENT:CharacterIndex:形状,1,2)) || (GROUPMATCH(TALENT:MASTER:形状,3,4,5) && GROUPMATCH(TALENT:CharacterIndex:形状,3,4,5))
			BiggerThan:LOCAL = 0
			SmallerThan:LOCAL = 0
		ENDIF
	ENDIF
	NEXT
	SELECTCASE TALENT:MASTER:形状
		CASE 1,2
			;Immature, Pathetic.
			IF HAS_PENIS(50)
				IF GROUPMATCH(TALENT:50:形状,1,2)
					IF IS_CHILD(MASTER)
						CALL CHARA_TEXT(50,@"「너 그것을 보여줬니 \@ IS_MALE(MASTER) ? a # 다른 \@ 여자에게 보여준 적 있어? 헤헤하하!」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「다 자라도 커지지 않는 모양이군... 뭐, 됐어!」","w")
					ENDIF
				ELSE
					CALL CHARA_TEXT(50,@"「와! 나보다 훨씬 작네, 아하하하～ 전혀 예상 못 했어!」","w")
				ENDIF
			ELSEIF HAS_PENIS(16) && TALENT:16:形状 > 2
				CALL CHARA_TEXT(50,@"「와! 내 여동생보다 훨씬 작네, 아하하하~ 전혀 예상 못 했어!」","w")
			ELSE
				IF IS_CHILD(MASTER)
					CALL CHARA_TEXT(50,@"「어린애인데도 작동하나요?」","w")
				ELSE
					CALL CHARA_TEXT(50,@"「왜 짧아 보이는 거야? 다들 그런 거야?」","w")
				ENDIF
			ENDIF
		CASE 3
			;Robust.
			IF !TypeMatch
				IF HAS_PENIS(16) && HAS_PENIS(50)
					$SIZECOMPARISON
					IF BiggerThan:0 && BiggerThan:1
						CALL CHARA_TEXT(50,@"「와! 나랑 내 누나들보다 훨씬 크네!」","w")
					ELSEIF BiggerThan:0
						CALL CHARA_TEXT(50,@"「와! 언니보다 크네, 헤헤헤!」","w")
					ELSEIF BiggerThan:1
						CALL CHARA_TEXT(50,@"「와! 우리 언니 거처럼 크네...」","w")
					ELSEIF SmallerThan:0 && SmallerThan:1
						CALL CHARA_TEXT(50,@"「우와! 우리 것보다 훨씬 작네, 헤헤헤!」","w")
					ELSEIF SmallerThan:0
						CALL CHARA_TEXT(50,@"「와! 내 여동생 것보다도 작아, 헤헤헤!」","w")
					ELSEIF SmallerThan:1
						CALL CHARA_TEXT(50,@"「우와! 내 것보다 훨씬 작네, 헤헤헤!」","w")
					ELSEIF TALENT:16:形状 == 4 && TALENT:50:形状 == 4
						CALL CHARA_TEXT(50,@"「와! 저기, 왜 불이 안 들어오는 거야? 고장 난 건가?」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「와! 네 건 정말 평범해 보여서 그래, 나와 내 여동생들처럼 아니야.」","w")
					ENDIF
				ELSEIF HAS_PENIS(16) || HAS_PENIS(50)
					IF BiggerThan:0 || SmallerThan:0 || BiggerThan:1 || SmallerThan:1
						GOTO SIZECOMPARISON
					ENDIF
					IF HAS_PENIS(16)
						CALL CHARA_TEXT(50,@"「와! 네 건 정말 평범해 보여! 내 여동생 건 완전히 달라.」","w")
					ELSEIF HAS_PENIS(50)
						CALL CHARA_TEXT(50,@"「와! 당신 것 되게 정상적으로 보인다!」","w")
					ENDIF
				ELSE
					IF IS_CHILD(MASTER)
						CALL CHARA_TEXT(50,@"「나만 그렇게 느끼는 건가, 아니면 정말 크네? 헤헤헤헤!」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「그렇게 서 있는 모습이 정말 소름 끼친다…」","w")
					ENDIF
				ENDIF
			ENDIF
		CASE 4
			;Luminescent.
			SELECTCASE TypeMatch
				CASE 0
					IF HAS_PENIS(16) || HAS_PENIS(50)
						CALL CHARA_TEXT(50,@"「와! 야, 왜 빛나고 있어? 이상하네, 그렇지?」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「빛을 내네~ 그들이 그런 걸 하는 줄은 몰랐어...」","w")
					ENDIF
				CASE 1
					IF HAS_PENIS(16)
						CALL CHARA_TEXT(50,@"「내 누나 건 아예 불도 안 들어오잖아? 이상한 성기 가진 거 안쓰럽다~」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「아, 하지만 다른 색깔로 빛나네. 그거 좀 멋지다…」","w")
					ENDIF
				CASE 2
					IF HAS_PENIS(50)
						CALL CHARA_TEXT(50,@"「내 누나가 이상한 걸 가지고 있어 빛이 나거든. 너도 이상할 것 같아~」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「하지만 당신의 것은 그녀의 것과는 다른 색으로 빛난다.」","w")
					ENDIF
				CASE 3
					CALL CHARA_TEXT(50,@"「너의 것은 우리의 것과 다른 색으로 빛나는군. 그거 좀 멋지네...」","w")
			ENDSELECT
		CASE 5
			;Warty.
			SELECTCASE TypeMatch
				CASE 0
					IF HAS_PENIS(16) || HAS_PENIS(50)
						CALL CHARA_TEXT(50,@"「와! 이봐, 왜 저렇게 보이는 거지? 이상하지 않아?」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「우웩, 왜 저렇게 생겼어? 네 거 너무 이상해!」","w")
					ENDIF
				CASE 1
					IF HAS_PENIS(16)
						CALL CHARA_TEXT(50,@"「역시 내 여동생의 것이 이상한가 보네~」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「좀 단단해 보이네요, 그렇죠?」","w")
					ENDIF
				CASE 2
					IF HAS_PENIS(50)
						CALL CHARA_TEXT(50,@"「그렇게 있는 게 정상이야?」","w")
					ELSE
						CALL CHARA_TEXT(50,@"「좀 단단해 보이네, 그렇지?」","w")
					ENDIF
				CASE 3
					CALL CHARA_TEXT(50,@"「그 형상이 우리랑 좀 다르긴 하네.」","w")
			ENDSELECT
		CASE 6,10
			;Big, Ultra Big.
			SELECTCASE TypeMatch
				CASE 0
					IF HAS_PENIS(16) || HAS_PENIS(50)
						$SIZECOMPARISON1
						IF TALENT:MASTER:形状 == 6
							GOTO SIZECOMPARISON
						ELSEIF BiggerThan:0 && BiggerThan:1
							CALL CHARA_TEXT(50,@"「뭐, 뭐, 뭐야?! 엄청나잖아! 나랑 누나보다 훨씬 크다구!」","w")
						ELSEIF BiggerThan:0
							CALL CHARA_TEXT(50,@"「어떻게 저렇게 클 수 있지? 야, 너희 둘 다 어떻게 그렇게 크게 만들었어?」","w")
						ELSEIF BiggerThan:1
							CALL CHARA_TEXT(50,@"「내 여동생 우리 질투할걸, 헤헤헤하하!」","w")
						ELSE
							CALL CHARA_TEXT(50,@"「밖에서도 우리 사이즈라는 걸 알 수 있었어, 헤헤하하하!」","w")
						ENDIF
					ELSE
						CALL CHARA_TEXT(50,@"「아-아니, 전부 이렇게 크다고? 말도 안 돼...」","w")
					ENDIF
				CASE 1,2
					IF HAS_PENIS(16)
						IF TypeMatch == 1
							IF BiggerThan:0
								GOTO SIZECOMPARISON1
							ELSE
								CALL CHARA_TEXT(50,@"「내 여동생의 것이 여전히 더 크네...」","w")
							ENDIF
						ELSE
							IF BiggerThan:1
								GOTO SIZECOMPARISON1
							ELSE
								CALL CHARA_TEXT(50,@"「내 게 더 크다고!」","w")
							ENDIF
						ENDIF
					ELSE
						IF TALENT:MASTER:形状 == 6
							IF IS_CHILD(MASTER)
								CALL CHARA_TEXT(50,@"「어른이 되면 더 커질 거라고 생각해?」","w")
							ELSE
								CALL CHARA_TEXT(50,@"「하지만 당신에게는 더 작아 보이네요, 헤헤헤.」","w")
							ENDIF
						ELSE
							CALL CHARA_TEXT(50,@"「밖에서 봐도 알 수 있었어, 헤헤하하하!」","w")
						ENDIF
					ENDIF
				CASE 3
					GOTO SIZECOMPARISON1
			ENDSELECT
