@LS_SCARLET_PUSH_DOWN(CharacterIndex)
	;Cancels push down if the player is carrying food that the character in question wants or uses Fairy Backup.
	;If the character in question is Flandre, the player can fight her as well.
	;If the character is Sakuya, the player can do a "cooking review" in the form of an Iron Chef contest.
	;If the character is an intruder, the player can choose to have them removed from the mansion.
#DIM DYNAMIC CharacterIndex
SIF IS_HERE(93) && !IS_MET(93) ;If Wakasagihime is here and hasn't been introduced, force her introduction before anything else.
	CALL MEET_CHARACTER(93)
SIF !IS_MET(CharacterIndex) ;If the attacker's introduction hasn't played, force it.
	CALL MEET_CHARACTER(CharacterIndex)
CALL LS_SCARLET_REMILIA_SEXUAL_EDUCATION
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_FLANDRE_SEXUAL_EDUCATION
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_SAKUYA_FORCED_MASTURBATION
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_REMILIA_BELLY_RUB
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_REMILIA_TURNABOUT
SIF RESULT
	GOTO SUCCEED
CALL LS_SCARLET_MONSTER_FISHING
SIF RESULT
	GOTO SUCCEED
CALL QUEST_LUNATIC_SURVIVAL_SCARLET_REMILIA_SERVICE
SIF RESULT
	GOTO SUCCEED
CALL QUEST_LUNATIC_SURVIVAL_SCARLET_FLANDRE_PLAYTIME
SIF RESULT
	GOTO SUCCEED
IF IS_HERE(58) && SHIRAHU(58) && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletPatchouliDevilBookStudied) && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletMeilingCatchMarisa)
	CALL QUEST_LUNATIC_SURVIVAL_SCARLET_MEILING_CATCH_MARISA
	GOTO SUCCEED
ENDIF
CALL QUEST_LUNATIC_SURVIVAL_SCARLET_MEILING_RELIEF
IF RESULT
	GOTO SUCCEED
ELSEIF CharacterIndex == 93
	GOTO FAIL
ELSEIF IS_HERE(93) && IS_LS_SAFE(93)
		;Wakasagihime intervenes if someone tries to push the player down in her presence.
	PRINTL
	PRINTFORMDL %CALLNAME:CharacterIndex% has a hungry look in %HIS_HER(CharacterIndex)% eye...
	PRINTL
	CALL LS_INTERRUPT_MESSAGE(93,CharacterIndex,GET_TARGETNUM()-1)
	FOR LOCAL,1,GET_TARGETNUM()+1
		SIF !IS_LS_SAFE(TARGET:LOCAL) && LOCAL != 93
			CALL GETOUT(TARGET:LOCAL)
	NEXT
	CALL LS_SCARLET_FALSE_ESCAPE
		;Afterwards her Sexual Frustration increases and she will push the player down if it reaches 100% after her event line.
	CFLAG:93:溜まってる度 = MIN(CFLAG:93:溜まってる度+RAND(100,200),1000)
	SIF CFLAG:93:溜まってる度 > 999 && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeConfession)
		CALLF SET_VAR(@"nForcePushDown:93",1)
	GOTO SUCCEED
ELSEIF DISH_NAME == "" && !GROUPMATCH(CharacterIndex,15,50) && (!GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackup) || GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackedUp)) && QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletConquestEnd
	$FAIL
		;Nullify PALAMs to keep time spent consistent on repeated push downs.
	FOR LOCAL,1,GET_TARGETNUM()+1
		PALAM:(TARGET:LOCAL):快Ｃ = 0
		PALAM:(TARGET:LOCAL):快Ｖ = 0
		PALAM:(TARGET:LOCAL):快Ａ = 0
		PALAM:(TARGET:LOCAL):快Ｂ = 0
		PALAM:(TARGET:LOCAL):快Ｍ = 0
		PALAM:(TARGET:LOCAL):欲情 = 0
	NEXT
	RESULT = 0
	RETURN 0
ENDIF
PRINTL
PRINTFORMDL %CALLNAME:CharacterIndex% has a hungry look in %HIS_HER(CharacterIndex)% eye...
PRINTL
{
	CALL ASK_M(
		"Offer your body",1,
		@"Offer the %DISHNAME_TR(DISH_NAME)%",DISH_NAME != "" ? 1 # -1,
		"Call for backup",(GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackup) && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids),QBitLSScarletFairyMaidsFairyBackedUp)) ? 1 # -1,
		@"\@ CharacterIndex == 15 ? Do a cooking review # Fight her\@",GROUPMATCH(CharacterIndex,15,50) ? 1 # -1,
		@"Order %HIM_HER(CharacterIndex)% to calm down",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) == QLSScarletConquestEnd ? 1 # -1,
	)
}
PRINTL
VARSET LOCAL
SELECTCASE RESULT
	CASE 0
		GOTO FAIL
	CASE 1
		CALL LS_PUSH_DOWN_FOOD_ESCAPE(CharacterIndex)
		SIF !RESULT
			GOTO FAIL
	CASE 2
		PRINTFORMDL A group of fairies rushes in bearing trays of snacks and drinks.
		CALL KOJO_MESSAGE_SEND("EVENT",0,CharacterIndex,0,0,"FAIRY_BACKUP_LS")
		IF !RESULT ;If there's no dialogue-specific text, fall back to a default.
			CALL SET_KOJO_COLOR(CharacterIndex)
			RESULT = 0
			TRYCALLFORM LS_SCARLET_K{CharacterIndex}_FAIRY_BACKUP
			RESETCOLOR
		ENDIF
		SIF !RESULT
			PRINTFORMDL You pick out some treats for %CALLNAME:CharacterIndex% and give %HIM_HER(CharacterIndex)% a nice massage...
		PRINTFORMDW \@ GET_TARGETNUM() > 1 ? Everyone # %CALLNAME:CharacterIndex%\@ forgets about pushing you down for a while and enjoys the luxurious service.
		FOR LOCAL,1,GET_TARGETNUM()+1
				;Affect everyone in the room.
			PRINTL
			CALL RECOVER_ALL(TARGET:LOCAL,600,"Fairy care",20)
			PRINTL
			CALL CHANGE_CFLAG(2,TARGET:LOCAL,40)
			CALL CHANGE_CFLAG(4,TARGET:LOCAL,30)
		NEXT
		CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletFairyMaids,QBitLSScarletFairyMaidsFairyBackedUp,1)
	CASE 3
		IF CharacterIndex == 15
			LOCAL:5 = TARGET
			TARGET = 15
			FOR LOCAL,1,4
				$PICKJUDGE
				LOCAL:4 = TOINT(SPLIT_G(@"16:16:16:50:50:54:54:58:58:59:59%COND_STR(":11",IN_HOME(CFLAG:11:現在位置) == 1)%%COND_STR(":27",IN_HOME(CFLAG:27:現在位置) == 1)%%COND_STR(":51",IN_HOME(CFLAG:51:現在位置) == 1)%%COND_STR(":93",IN_HOME(CFLAG:93:現在位置) == 1 && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeMonsterFishing))%%COND_STR(":97",IN_HOME(CFLAG:97:現在位置) == 1)%"))
				SIF GROUPMATCH(LOCAL:4,LOCAL:1,LOCAL:2)
					GOTO PICKJUDGE
				LOCAL:LOCAL = LOCAL:4
			NEXT
			TRYCALL IRON_CHEF_CONTEST(4,LOCAL:1,LOCAL:2,LOCAL:3,10,80,98)
			TARGET = LOCAL:5
			TIME -= 80
			IF RESULTS:2 != "棄権"
				IF ABL:MASTER:料理技能 < ABL:15:料理技能
					IF ONCE("LSSakuyaCookingReview",1,-1)
						PRINTL
						CALL AddEXPOrdered("料理経験",MASTER,LSScarletTaskExperienceGain-2)
					ELSE
						PRINTFORMDW You've already reviewed with Sakuya tonight, so you don't feel like you learned much...
					ENDIF
				ELSEIF ABL:MASTER:料理技能 > ABL:15:料理技能
					IF ONCE("LSSakuyaCookingReview",1,-1)
						PRINTL
						CALL AddEXPOrdered("料理経験",15,LSScarletTaskExperienceGain-2)
					ENDIF
				ENDIF
				IF ONCE("LSSakuyaCookingReview",0,-1)
					PRINTL
					CALL CHANGE_CFLAG(2,15,10)
					CALL CHANGE_CFLAG(4,15,5)
				ENDIF
			ENDIF
			SIF RESULTS:2 != "勝利"
				GOTO FAIL
		ELSE
			SELECTCASE QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition)
				CASE 0
					PRINTFORMDW Unlike everyone else, you don't feel like you can't resist Flandre. In fact, it's the opposite. You're compelled to fight.
					PRINTFORMDW Seeing you get ready to defend yourself, Flandre's malicious grin only grows wider...
				CASE 1
					PRINTFORMDW Last time didn't work. This time seems unlikely, as well.
					PRINTFORMDW Still, you try to defend yourself against the oncoming girl...
			ENDSELECT
			PRINTL
			CALL DANMAKU_BATTLE(50)
			PRINTL
			SELECTCASE RESULT
				CASE 0
					SELECTCASE QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition)
						CASE -1
							CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition,-2)
							PRINTFORMDW Flandre falls again, and this time, she laughs as she's shot down.
							CALL CHARA_TEXT(50,@"「Ahahaha, I totally didn't expect that... Hey, can we go again? Let's go again!」","w")
							PRINTFORMDW Flandre's quite eager, but she should be patient and rest a bit. She only just wore herself out.
							CALL CHARA_TEXT(50,@"「Okaaaaay, just a little bit～」","w")
							PRINTFORMDW At least she's following your suggestions now.
						CASE -2
							PRINTFORMDW Flandre %SPLIT_G("goes down in smoke, but keeps laughing as she smolders on the ground.:falls dramatically, playing the loser's role.:chokes back tears as she crawls on the ground, defeated. She got really into the match...:is soundly defeated again, and you breathe a sigh of relief.")%
							CALL CHARA_TEXT(50,@"「%SPLIT_G("Aaah, I can't believe I lost like that!:Ahahaha, I lost...:Aww, I wanted to play sex after...:Ugh, too strong...")%」","w")
						CASEELSE
							CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition,-1)
							CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletDependency,QBitLSScarletFlandreDependency,1)
							PRINTFORMDW Flandre finally falls. She lands and staggers on her feet, her face frozen in disbelief, before she crumples in a heap.
							CALL CHARA_TEXT(50,@"「Hahaha... Hahaha...!」","w")
							PRINTFORMDW She laughs deliriously as she lies on the ground, a pile of awkward limbs. You take a moment to breathe out...
							CALL CHARA_TEXT(50,@"「I lost to a servant... Isn't that weird...?」","w")
							PRINTFORMDW After catching your breath, you approach Flandre and offer to help her up. She gingerly rises to her feet, but doesn't let go of your hand.
							PRINTL
							CALL CHARA_TEXT(50,@"「Hey, how are you so strong? Tell me.」","w")
							PRINTFORMDW Flandre is the one who made you strong by fighting so much. When you say that, she blooms into a broad smile.
							PRINTFORMDW It's a less creepy smile than you normally see on her. It feels soft and pure, like a child's affection.
							CALL CHARA_TEXT(50,@"「You got that strong because of me? Wow...」","w")
							CALL CHARA_TEXT(50,@"「So, if we play a lot, you'll get even stronger?」","w")
							PRINTFORMDW Flandre steps towards you, hugging your arm and pressing her body into you. There's a gleam of intrigue in her eyes.
							PRINTFORMDW Most likely, if you fight, Flandre will get stronger, too.
							PRINTL
							CALL CHARA_TEXT(50,@"「Let's play a lot more.」","w")
							PRINTFORMDW The feeling of danger is coming back.
							CALL CHARA_TEXT(50,@"「I'll get stronger and beat you, and you'll get stronger, too. Right?」","w")
							SIF HAS_PENIS(MASTER) || HAS_PENIS(50)
								CALL CHARA_TEXT(50,@"「And then we'll play sex, and we'll make really strong babies, too... You'll do that with me, right?」","w")
							PRINTFORMDW ...Indeed, how can you refuse? You'll play with Flandre whenever you see her, one way or another.
							PRINTFORMDW Flandre giggles, bounces on the balls of her feet, and hugs you tightly, putting an enormous amount of pressure on your body.
							CALL CHARA_TEXT(50,@"「Then, I'll be ","")
							SETCOLOR LSScarletColor
							PRINTFORM depending
							RESETCOLOR
							CALL CHARA_TEXT(50,@" on you to be lots and lots of fun from now on～」","w")
					ENDSELECT
					FOR LOCAL,1,GET_TARGETNUM()+1
						CFLAG:(TARGET:LOCAL):ディレイ += 60
					NEXT
					LOCAL = 1
				CASEELSE
					SELECTCASE RESULT
						CASE 1
							PRINTFORMDW Despite coming close to victory, you were soundly defeated. Flandre is thrilled and laughs out loud.
						CASE 2
							PRINTFORMDW Although you managed to hit her, you were still defeated. Flandre laughs in celebration.
						CASEELSE
							PRINTFORMDW You're completely defeated and reduced to a smoldering wreck. You stood no chance against her. Flandre hums pleasantly.
					ENDSELECT
					SELECTCASE QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition)
						CASE 0
							PRINTFORMDW This girl's power is beyond anything you could have expected...
							CALL CHARA_TEXT(50,@"「Kyahahaha～! You were pretty weak, weren't you～?」","w")
							CALL CHARA_TEXT(50,@"「Hey, get up. I still wanna play...」","w")
							PRINTFORMDW You're in no shape to stand right now. You can hardly move at all.
							CALL CHARA_TEXT(50,@"「Hmmm～... Well, even if you don't move, I know a game we can play for a long～ time～...」","w")
						CASE 1
							CALL CHARA_TEXT(50,@"「Ahaha, what's that? You died again～!」","w")
							PRINTFORMDW Your second battle against Flandre went no better than your first. Flandre gloats over her victory while approaching your fallen body.
							CALL CHARA_TEXT(50,@"「Now comes the best part～...」","w")
						CASE 2
							CALL CHARA_TEXT(50,@"「I win! I win! I wiiiiin!」","w")
							PRINTFORMDW Flandre jumps around as you're felled for the third time. She rushes over to you as you try to get up, eager to collect her reward...
						CASEELSE
							IF ABL:MASTER:戦闘能力 < ABL:50:戦闘能力
								PRINTFORMDW You've failed to defeat Flandre once more. Although you're learning quickly, the lesson is painful...
							ELSE
								PRINTFORMDW Although you're seemingly a match for Flandre, she defeated you anyway. It's a painful defeat...
							ENDIF
							PRINTFORMDW And the pain is only just getting started.
					ENDSELECT
					CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletSameRoundEvent,50)
					LOCAL = 0
			ENDSELECT
			SIF QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition) > -1
				CALL ADD_QUEST_FLAG(LSScarletAlias,QLSScarletFlandreCompetition,1)
			IF ABL:MASTER:戦闘能力 < ABL:50:戦闘能力
				IF ONCE("LSDuelBonus",1,50)
					PRINTL
					CALL AddEXPOrdered("戦闘経験",MASTER,LSScarletTaskExperienceGain)
				ELSE
					PRINTFORMDW You've already fought her tonight, so you don't feel like you learned much...
				ENDIF
			ELSEIF ABL:MASTER:戦闘能力 > ABL:50:戦闘能力
				IF ONCE("LSDuelBonus",1,50)
					PRINTL
					CALL AddEXPOrdered("戦闘経験",50,LSScarletTaskExperienceGain)
				ENDIF
			ENDIF
			IF ONCE("LSDuelBonus",0,50)
				PRINTL
				CALL CHANGE_CFLAG(2,50,30)
				CALL CHANGE_CFLAG(4,50,20)
			ENDIF
			SIF !LOCAL
				GOTO FAIL
		ENDIF
	CASE 4
ENDSELECT
$SUCCEED
FOR LOCAL,1,GET_TARGETNUM()+1
	SIF !IS_LS_SAFE(TARGET:LOCAL) && TARGET:LOCAL != 93
		CFLAG:(TARGET:LOCAL):ディレイ += 60
NEXT
CALL LS_SCARLET_EJECT
RESULT = 1
RETURN RESULT

@LS_SCARLET_EJECT
	;Gives the option to eject intruders from the mansion after push down escape or slip out.
#DIM DYNAMIC CheckTarget
#DIM DYNAMIC TargetIndex
#DIM DYNAMIC Ejected
SIF !IS_MET(58)
		;Can't call Meiling if you've never met her.
	RETURN
CALL TARGETSET_CHACK("「同室更新無し」") ;Refresh targets in case someone just arrived.
FOR CheckTarget,1,GET_TARGETNUM()+1
	SIF !IS_LS_INTRUDER(TARGET:CheckTarget)
		CONTINUE
	TargetIndex = TARGET:CheckTarget
	$REMOVELOOP
	PRINTL
	{
		CALL ASK_M(
			@"\@ IS_HERE(58) ? Request that Meiling # Call Meiling to\@ remove %CALLNAME:TargetIndex%",1,
			@"Let %HIM_HER(TargetIndex)% be",1,
			"Interrogate her",TargetIndex == 97 && (!GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletSeijaQuestioning) || GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletKoakumaGrimoire)) ? 1 # -1,
		)
	}
	SELECTCASE RESULT
		CASE 0
			IF IS_HERE(58)
				PRINTFORMDW Meiling %SPLIT_G(@"hauls the squealing %CALLNAME:TargetIndex% away:carries %CALLNAME:TargetIndex% off:drags %CALLNAME:TargetIndex% off:chases %CALLNAME:TargetIndex% off:throws %CALLNAME:TargetIndex% out:fights %CALLNAME:TargetIndex% off")%.
			ELSE
				PRINTFORMDW Meiling %SPLIT_G("quickly arrives:takes her time getting there:arrives with sleepy eyes:comes by:arrives:answers your summons:eventually gets there:comes")% and %SPLIT_G(@"hauls the squealing %CALLNAME:TargetIndex% away:carries %CALLNAME:TargetIndex% off:drags %CALLNAME:TargetIndex% off:chases %CALLNAME:TargetIndex% off:throws %CALLNAME:TargetIndex% out:fights %CALLNAME:TargetIndex% off")%.
			ENDIF
			Ejected = TargetIndex
			CALL RETURN_TO_BEDROOM(TargetIndex)
			PRINTL
			IF Ejected == 27 && QUEST_FLAG(LSScarletAlias,QLSScarletServiceTask) == 13 && !QUEST_FLAG(LSScarletAlias,QLSScarletServiceTaskStatus)
					;If we're removing Wriggle and have the task to do so, complete it.
				IF IN_HOME(CFLAG:97:現在位置) == 1
					PRINTL
					CALL PRINT_FACE(97,"笑顔","服",,"照れ")
					CALL CHARA_TEXT(97,"「Nice bug, wanna see mine?」","w")
					PRINTL
					CALL PRINT_FACE(58,"怒り","服",,"照れ")
					CALL CHARA_TEXT(58,"「Gyaaaaaaah!」","w")
					PRINTL
					PRINTFORMDW Seija tosses a fistful of cockroaches at Meiling, who lets go of Wriggle in a panic.
					PRINTL
					CALL PRINT_FACE(27,"笑顔","服",,"照れ")
					CALL CHARA_TEXT(27,"「Ahaha, I'm freeeee!」","w")
					PRINTL
					PRINTFORMDW Seija and Wriggle fly off together while Meiling gives chase with tears in her eyes.
					PRINTL
				ENDIF
				CALL AddEXPOrdered("奉仕快楽経験",MASTER,LSScarletTaskExperienceGain)
				CALL LS_SCARLET_ADD_PAY("奉仕快楽経験")
				CALL LS_SCARLET_COMPLETE_SERVICE_TASK
			ENDIF
			SIF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletMeilingStakeOutMeeting) && GROUPMATCH(Ejected,11,27,97)
					;If Seija and Marisa are running around, we start counting ejections.
				CALL ADD_QUEST_FLAG(LSScarletAlias,QLSScarletMeilingDependability,1)
			CALL CHANGE_CFLAG(2,58,20)
			CALL CHANGE_CFLAG(4,58,10)
			CheckTarget--
		CASE 1
			CALL CHANGE_CFLAG(2,TargetIndex,20)
			CALL CHANGE_CFLAG(4,TargetIndex,10)
		CASE 2
			CALL QUEST_LUNATIC_SURVIVAL_SCARLET_SEIJA_QUESTIONS
			GOTO REMOVELOOP
	ENDSELECT
NEXT
IF Ejected && !GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletDependency),QBitLSScarletMeilingDependency)
	IF QUEST_FLAG(LSScarletAlias,QLSScarletMeilingDependability) == 6
		CALL LS_SCARLET_MEILING_AMBUSH(Ejected)
	ELSEIF QUEST_FLAG(LSScarletAlias,QLSScarletMeilingDependability) > 8
		CALL LS_SCARLET_MEILING_ADVICE(Ejected)
	ENDIF
ENDIF

