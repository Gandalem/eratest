@LS_SCARLET_RESTRICTION(RestrictionQuery,RestrictionInt:0,RestrictionInt:1)
;Controls the restriction of various base game features.
#FUNCTION
#DIMS DYNAMIC RestrictionQuery
#DIM DYNAMIC RestrictionInt,2
SELECTCASE RestrictionQuery
	CASE "Birth control","Map mob interrupt","Size check","Moon override","Panties search","Kick out"
		LSResult = IN_HOME(CFLAG:MASTER:現在位置) == 1
	CASE "Visit","Banquet","Move in","Change clothes","Go out","Request"
		LSResult = !QUEST_FLAG(LSScarletAlias,QLSScarletEnd)
	CASE "Change home"
		LSResult = !QUEST_FLAG(LSScarletAlias,QLSScarletEnd)
		LSResults '= "계약 때문에 저택 밖으로 이사할 수 없다."
	CASE "Change room"
		IF QUEST_FLAG(LSScarletAlias,QLSScarletEnd) == QLSScarletConquestEnd
			LSResult = 1
			LSResults '= @"당신은 \@ IS_MALE(MASTER) ? 주인 # 여주인 \@의 침실에서 자야 한다."
		ELSEIF QUEST_FLAG(LSScarletAlias,QLSScarletEnd)
			LSResult = 0
		ELSE
			LSResult = 1
			LSResults '= "당신에게 배정된 방에서 자야 한다."
		ENDIF
	CASE "Change waking time"
		;Could maybe unlock this after an end, but it needs to work adequately with service tasks in Servitude End.
		LSResult = 1
		LSResults '= "달이 뜨면 일어나야 한다."
	CASE "Resume time print"
		LSResult = QUEST_FLAG(LSScarletAlias,QLSScarletSameRoundEvent) == 15
	CASE "Stable bypass","Child limit bypass"
		LSResult = !QUEST_FLAG(LSScarletAlias,QLSScarletEnd)
		LSResults '= "누구도 금욕하겠다는 생각조차 할 수 없다."
	CASE "Hire hobgoblins","Pass character","Mooch cooking","Move hips"
		LSResult = QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletConquestEnd
	CASE "Fairy maids","Incompetent mode","Fishing bribe","Logging hours","Sawmill hours","Furniture store hours","Logging advice print"
		LSResult = 1
	CASE "Lead around"
		LSResult = (RestrictionInt:0 == 54 && !QUEST_FLAG(LSScarletAlias,QLSScarletEnd)) || RestrictionInt:0 == 93
	CASE "Carry"
		SELECTCASE TARGET
			CASE 54
				;Patchouli.
				LSResult = !QUEST_FLAG(LSScarletAlias,QLSScarletEnd)
				LSResults '= "마력이 그녀를 옮기지 못하게 막는다."
			CASE 93
				;Wakasagihime.
				IF GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeMonsterFishing)
					LSResult = 1
					LSResults '= "시간이 멈춘 틈을 타 수조 밖으로 꺼내는 건 불가능해 보인다."
				ENDIF
		ENDSELECT
	CASE "Move"
		LSResult = LS_SCARLET_RESTRICT_LOCATION(RestrictionInt:0)
	CASE "Character movement"
		LSResult = RestrictionInt:0 == 93 && GETBIT(QUEST_FLAG(LSScarletAlias,QLSScarletEvent),QBitLSScarletWakasagihimeMonsterFishing)
	CASE "Character go home"
		LSResult = LS_LUNATIC_TIME()
	CASE "Character room cleanliness"
		LSResult = (LS_SCARLET_ROOM_IS_TARGET(CFLAG:(RestrictionInt:0):現在位置) && !IS_LS_INTRUDER(RestrictionInt:0)) || (CFLAG:(RestrictionInt:0):職種 == 40 && CFLAG:(RestrictionInt:0):行動 == 5) || (TALENT:(RestrictionInt:0):掃除係 && CFLAG:(RestrictionInt:0):神社在住 && BETWEENTIME(720,1080))
ENDSELECT
RETURNF LSResult

@LS_SCARLET_WORK(CharacterIndex)
;Assigns custom work schedules to Patchouli and Meiling.
#FUNCTION
#DIM DYNAMIC CharacterIndex
SELECTCASE CharacterIndex
	CASE 54
		;Patchouli reads in the library at all times.
		MAXBASE:CharacterIndex:仕事量 = 600 * 9
		IF TIME >= CLOCK_TO_TIME(12,0)
			TCVAR:CharacterIndex:仕事開始 = CLOCK_TO_TIME(19,0)
			TCVAR:CharacterIndex:仕事終了 = CLOCK_TO_TIME(23,59)
		ELSE
			TCVAR:CharacterIndex:仕事開始 = CLOCK_TO_TIME(0,1)
			TCVAR:CharacterIndex:仕事終了 = CLOCK_TO_TIME(6,0)
		ENDIF
		CFLAG:CharacterIndex:職場 = P310図書館
		CFLAG:CharacterIndex:職種 = JOB_教養
		TCVAR:CharacterIndex:給料 = 0
		TCVAR:CharacterIndex:手伝えない = 1
	CASE 58
		;Meiling stands guard every night for as long as the scarlet moon is out.
		MAXBASE:CharacterIndex:仕事量 = 600 * 6
		IF TIME >= CLOCK_TO_TIME(12,0)
			TCVAR:CharacterIndex:仕事開始 = CLOCK_TO_TIME(19,0)
			TCVAR:CharacterIndex:仕事終了 = CLOCK_TO_TIME(23,59)
		ELSE
			TCVAR:CharacterIndex:仕事開始 = CLOCK_TO_TIME(0,1)
			TCVAR:CharacterIndex:仕事終了 = CLOCK_TO_TIME(3,0)
		ENDIF
		CFLAG:CharacterIndex:職場 = P301正門
		CFLAG:CharacterIndex:職種 = JOB_戦闘
		TCVAR:CharacterIndex:給料 = 2
		TCVAR:CharacterIndex:手伝えない = 2
	CASEELSE
		RESULT = 0
		RETURNF RESULT
ENDSELECT
RESULT = 1
RETURNF RESULT

