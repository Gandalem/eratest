PRINTL
SELECTCASE RESULT
	CASE 0
		Destination = 313
	CASE 1
		Destination = 321
	CASE 2
		Destination = 326
	CASE 3
		Destination = 330
	CASE 4
		CALL QUEST_LUNATIC_SURVIVAL_SCARLET_AQUARIUM_RELOCATION
		RETURN
ENDSELECT
FOR LOCAL,1,CHARANUM
SIF IN_HOME(CFLAG:LOCAL:現在位置) == 1
	CFLAG:LOCAL:ディレイ += 5
NEXT
CALL MOVE_CHARACTER(MASTER,Destination)
TFLAG:マップ切り替え = MAP_AREASELECT(3,Destination)

