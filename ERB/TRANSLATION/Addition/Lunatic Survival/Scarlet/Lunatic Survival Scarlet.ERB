		CALL CHARA_TEXT(11,@"「응, 그게 원인이었어. 가장 이상한 건 계약서가 전혀 문제없었는데 말이야 -- 잉크가 그냥 스르륵 사라져 버렸지.」","w")
		CALL CHARA_TEXT(11,@"「실험을 좀 해봤는데, 뭘 써도 아무런 흔적조차 남기지 못했어. 저거 정말 소름 끼쳐%K11_ZE("daze")%.」","w")
		CALL CHARA_TEXT(54,@"「그래, 너는 그것에 대해 아무것도 할 수 없을 거야... 하지만 이것이 의미하는 바는 결국 우리가 그 먹물이 더 필요하다는 거야.」","w")
		CALL CHARA_TEXT(11,@"「어, 그러니까 다른 거래를 해볼 수 있을까요...? 정말로 말하는데, 나는 그 책을 본 적이 없어요.」","w")
		PRINTFORMDW 바로 대답하지 않고 패치우리는 눈을 감고 한 분 더 생각한다.
	ENDIF
	PRINTFORMDW 그러자 그녀가 손을 휘두르자 마리사를 묶고 있던 수갑이 풀리며 바닥으로 떨어졌다.
	CALL CHARA_TEXT(54,@"「네 레벨이라면 레미가 만든 어떤 봉인도 물리칠 수 있겠지. 어차피 지금은 너를 돌볼 여유가 없어.」","w")
	PRINTFORMDW 마리사가 벌떡 일어나 팔다리를 쭉 펴고 환호성을 질렀다.
	CALL CHARA_TEXT(11,@"「아, 패치! 자네가 최고야! 좋아, 내가 직접 그녀를 찾아내고 사건을 해결하겠어!」","w")
	CALL CHARA_TEXT(11,@"「만약 시자뿐이라면 레이무를 끌어들일 필요는 없다. 나중에 그 일로 그녀에게 자랑할 수 있으니, 히히.」","w")
	PRINTL
	CALL PRINT_FACE(54,"通常","服")
	CALL CHARA_TEXT(54,@"「안 돼. 집에 가, 마리사. 이건 우리만이 해결할 수 있는 일이야.」","w")
	PRINTFORMDW 파치불이 메일링에게 고개를 끄덕이자, 메일링이 앞으로 나서 마리사를 다시 자신의 어깨에 올려놓았다.
	CALL CHARA_TEXT(11,@"「우와아! 저기요, 잠깐만요! 제가 도울 수 있어요! 제가 저택을 순찰할게요! 정말로 이길 수 있어요!」","w")
	CALL CHARA_TEXT(54,@"「이런 문제는 폭력으로 해결할 수 있는 종류가 아니야. 지금 네가 여기에 있는 것만 문제만 일으킬 뿐이야.」","w")
	CALL CHARA_TEXT(54,@"「그냥 집에 가서 이 모든 걸 잊어버려. 책은 나중에 원래 있던 곳으로 돌려줄게.」","w")
	PRINTL
	PRINTFORMDW 자신이 배제당하고 있음을 깨닫자 마리사는 쓸모없이 다리를 찬다.
	CALL CHARA_TEXT(11,@"「아니, 아니, 잠깐만! 가기 전에 나한테 사정하게 해줘! %조사처리(CALLNAME:MASTER,"의")% 몸 좀 잠시 빌려줘%K11_ZE()%!」","w")
	PRINTL
	CALL PRINT_FACE(58,"笑顔","服",,"照れ")
	CALL CHARA_TEXT(58,@"「그럴 시간이 없어. 미안하지만 우리 같이 밖에 나갈 거야!」","w")
	PRINTL
	CALL PRINT_FACE(11,"性交","裸",,"照れ")
	CALL CHARA_TEXT(11,@"「적어도 나 옷부터 입게 해줘―!」","w")
	PRINTL
	PRINTFORMDW 마리사의 가련한 울음소리가 멀어져 갈 때, 파치울리는 손가락으로 관자놀이를 문지른다.
	CALL CHARA_TEXT(54,@"「그녀는 돌아올 거야. 그녀는 언제나 돌아와.」","w")
	PRINTFORMDW 세이야도 분명 돌아올 것이다. 파치풀이에게 메일링을 위해 그들을 막으려고 노력해 볼지 묻는다.
	CALL CHARA_TEXT(54,@"「그게 가장 좋겠어. 둘 다 그녀를 쉽게 빠져나갈 수 있으니, 네가 저택 안을 순찰해줘야 할 거야.」","w")
	CALL CHARA_TEXT(54,@"너희를 상대할 수는 없겠지만, 어쩌면 할 수도 있을 거야 ","")
	PRINTFORM 진정시키다
	CALL CHARA_TEXT(54,@" 그들을 다시 만난다면 다른 방법으로도 대처할 것이다.","w")
	CALL CHARA_TEXT(54,@"「가능하다면 세이가에게서 정보도 좀 얻어내라. 움직이려면 그녀의 계획에 대한 구체적인 내용을 알아야 할 테니까.」","w")
	CALL ASK_DIARY(@"세이자가 요정들과 호그박스들에게 물자를 공급하고 선동하는 배후였으며 저택을 몰래 돌아다녔다는 것을 알게 되었다. <br> 패치울리는 그녀의 계획을 알아내기 위해 찾아내고 심문하라고 나에게 요구한다.")
	CALL MOVE_CHARACTER(11,SUKIMA())
	CALL MOVE_CHARACTER(15,315)
	CALL MOVE_CHARACTER(16,315)
	CALL MOVE_CHARACTER(MASTER,310)
	TIME += 20
	IF !CFLAG:97:面識
		CALL MEET_CHARACTER(97,0)
		IF !CFLAG:97:口上セレクタ
			;Set up Seija's CFLAGs if using her default dialogue.
			CFLAG:97:1091 = TALENT:97:処女
			CFLAG:97:1092 = IS_FUTA(97)
		ENDIF
	ENDIF
	CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletEvent,QBitLSScarletContract,1)
	CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletEvent,QBitLSScarletMeilingStakeOutMeeting,1)
ENDIF
