@QUEST_LUNATIC_SURVIVAL_SCARLET_SECRET_PASSAGE
;Moving between floors via an old dumbwaiter.
#DIM DYNAMIC KitchenOccupied
#DIM DYNAMIC VacantRoomOccupied
#DIM DYNAMIC MasterBedroomOccupied
#DIM DYNAMIC ServantRoomOccupied
#DIM DYNAMIC Destination
FOR LOCAL,1,CHARANUM
SIF CFLAG:LOCAL:現在位置 == 313
	KitchenOccupied = 1
SIF CFLAG:LOCAL:現在位置 == 321
	VacantRoomOccupied = 1
SIF CFLAG:LOCAL:現在位置 == 326
	MasterBedroomOccupied = 1
SIF CFLAG:LOCAL:現在位置 == 330
	ServantRoomOccupied = 1
NEXT
