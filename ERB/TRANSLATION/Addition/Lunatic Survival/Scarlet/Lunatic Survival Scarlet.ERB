CALL CHARA_TEXT(15,@"「수족관은 인어 외에 무엇이 필요한지 알고 있나요?」","w")
PRINTFORMDW 해초와 조개껍데기, 그리고 자갈?
PRINTL
CALL PRINT_FACE(15,"笑顔","服",,"照れ")
CALL CHARA_TEXT(15,@"「맞아. 가서 가져와... 호수 바닥에서 말이야.」","w")
PRINTL
PRINTFORMDW .........
PRINTFORMDW ......
PRINTFORMDW ...
PRINTL
PRINTFORMDW 당신이 저택으로 돌아올 때쯤, 호그바블들은 응접실에 크고 튼튼한 유리 케이스를 조립하고 물을 채웠다.
PRINTFORMDW 그들은 %K93NICK()%이 안에서 지켜보는 동안, 작은 폐허 성과 같은 더 많은 장식을 바쁘게 그리고 있다.
PRINTFORMDW %HE_SHE(93)%는 당신을 보면 수줍게 손을 흔든 뒤 물 위로 헤엄쳐 올라와 유리 가장자리 너머를 엿본다.
PRINTL
CALL PRINT_FACE(93,"通常","服")
PRINTFORMDW %K93NICK()%은(는) 몇 초 동안 침묵하며 당신을 응시하다가 마침내 말할 담력을 모았다.
CALL CHARA_TEXT(93,@"「...고맙습니다, %K93_HONORIFIC(MASTER)% 씨.」","w")
CALL CHARA_TEXT(93,@"「이게 내 호수만큼 넓고 깊지는 않을지 몰라도, 나쁘진 않아.」","w")
CALL CHARA_TEXT(93,@"「주변에 하인들이 많고, 여기 자갈도 많고, 물도 좋다...」","w")
PRINTFORMDW %HE_SHE(93,1)%은(는) 멈추고 장난기 어린 미소를 지어 보였다.
CALL CHARA_TEXT(93,@"「벽에 걸려 있는 것보다는 확실히 낫지~」","w")
PRINTL
PRINTFORMDW 당신은 어항에 %HIM_HER(93)%를 가두고 있는 뚜껑이 없다고 지적하며, %HE_SHE(93)%가 미스티 레이크로 도망칠 계획이 있는지 묻는다.
CALL CHARA_TEXT(93,@"「나? 지금은 아니야, 나는 내가 어떤 위험에 처해 있다고 생각하지 않아.」","w")
CALL CHARA_TEXT(93,@"「이런 집에서 머무르는 건 매일 있는 일이 아니니, 잠시 시도해 봐야겠어?」","w")
CALL CHARA_TEXT(93,@"「하지만... 당신은 어쩌실 건가요, %K93_HONORIFIC(MASTER)%? 조만간 떠날 계획이라도 있으신가요?」","w")
PRINTL
PRINTFORMDW 진실을 말하려 하지만 다시 그 가슴 저미는 느낌이 밀려왔다. 결국 입에서는 아무 말도 나오지 않았다.
CALL CHARA_TEXT(93,@"「후우... 괜찮아, 말하고 싶지 않으면 말 안 해도 돼.」","w")
CALL CHARA_TEXT(93,@"「하지만 부디, 제가 도울 수 있는 일이 있다면 저에게 연락해 주세요.」","w")
CALL CHARA_TEXT(93,@"「약속인가?」","w")
PRINTL
CALL ASK_YN("약속","약속은 못 한다")
IF !RESULT
	PRINTFORMDW 당신은 조용히 고개를 끄덕이고, 그로 인해 %HIM_HER(93)%이 부드럽게 미소 지으며 %HIS_HER(93)% 자신의 고갯짓으로 응답한다.
ELSE
	PRINTFORMDW 당신은 고개를 저으며 어떤 약속도 지킬 수 없다고 말한다.
	CALL CHARA_TEXT(93,@"「분명 당신 나름의 이유가 있을 테지.」","w")
	CALL CHARA_TEXT(93,@"「죄송합니다, 어리석은 부탁이었습니다.」","w")
ENDIF
PRINTL
CALL CHARA_TEXT(93,@"「아, 그리고 마지막으로 하나 더...」","w")
PRINTFORMDW %K93NICK()%은(는) 당신이 떠나기도 전에 소리친다.
IF GETBIT(FLAG:プール,3)
	CALL CHARA_TEXT(93,@"「나에게 [미스터 버블]을 주기 위해 애썼지만, 돌아다닐 수 없을 것 같아...」","w")
ELSE
	CALL CHARA_TEXT(93,@"「집 안을 자유롭게 돌아다닐 수가 없어...」","w")
ENDIF
CALL CHARA_TEXT(93,@"「하지만 만약 내가 그 근처에 있고 네가 곤경에 처해 있다면... 최선을 다할게.」","w")
PRINTFORMDW %K93NICK()%은/는 당신에게 자제하는 미소와 손을 흔들어 보이며 %HE_SHE(93)%이/가 당신을 배웅한다. 이제 이 방에서는 안전할지도 모른다...
PRINTL
CALL CHANGE_CFLAG(2,93,100)
CALL CHANGE_CFLAG(4,93,50)
CALL JUEL_UP_SPECIAL_ORDERED(93,"好意","親密",10)
WAIT
TCVAR:93:今日会ったか = 1
IF GROUPMATCH(QUEST_FLAG(LSScarletAlias,QLSScarletServiceTask),11,14) && !QUEST_FLAG(LSScarletAlias,QLSScarletServiceTaskStatus)
	PRINTL
	CALL AddEXPOrdered("釣り経験",MASTER,LSScarletTaskExperienceGain)
	CALL LS_SCARLET_ADD_PAY("釣り経験",16,15,93)
	CALL LS_SCARLET_COMPLETE_SERVICE_TASK
ENDIF
CALL MOVE_CHARACTER(93,315)
