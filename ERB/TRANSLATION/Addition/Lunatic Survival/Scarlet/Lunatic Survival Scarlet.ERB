@LS_SCARLET_FLANDRE_SEXUAL_EDUCATION
;Flandre learns to play with her sister's new toy.
#DIMS DYNAMIC PantsName
#DIM DYNAMIC TypeMatch
#DIM DYNAMIC BiggerThan,2
#DIM DYNAMIC SmallerThan,2
#DIM DYNAMIC CharacterIndex
SIF !IS_HERE(50)
