@QUEST_LUNATIC_SURVIVAL_SCARLET_REWRITE_CONTRACT
	;Putting the game in another end state or changing options after the ending.
SETCOLOR LSScarletColor
PRINTL
PRINTL
CALL D_LINE
PRINTL
PRINTL
PRINTFORMDL You may change to another end state only once per day.
PRINTL
{
	CALL ASK_M(
		"Annul the contract's terms",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletFreedomEnd && ONCE("LSScarletChangeEndState",1,-1),
		"Become Remilia's servant",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletServitudeEnd && ONCE("LSScarletChangeEndState",1,-1),
		"Become the mansion's master",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletConquestEnd && ONCE("LSScarletChangeEndState",1,-1),
		"Check details",1,
		@"Change lust mode intensity (Currently {QUEST_FLAG(LSScarletAlias,QLSScarletLust)})",QUEST_FLAG(LSScarletAlias,QLSScarletEnd) != QLSScarletFreedomEnd,
		"Done",1,
	)
}
PRINTL
SELECTCASE RESULT
	CASE 0
		CALL LS_SCARLET_END_STATE(QLSScarletFreedomEnd)
		CALLF ONCE("LSScarletChangeEndState",0,-1)
	CASE 1
		CALL LS_SCARLET_END_STATE(QLSScarletServitudeEnd)
		CALLF ONCE("LSScarletChangeEndState",0,-1)
	CASE 2
		CALL LS_SCARLET_END_STATE(QLSScarletConquestEnd)
		CALLF ONCE("LSScarletChangeEndState",0,-1)
	CASE 3
		CALL LS_SCARLET_END_STATE_RULES
	CASE 4
		CALL ADD_QUEST_FLAG(LSScarletAlias,QLSScarletLust,1)
		SIF QUEST_FLAG(LSScarletAlias,QLSScarletLust) > 3
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletLust,0)
	CASE 5
		RETURN
ENDSELECT
RESTART

