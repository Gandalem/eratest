	CASE 1
		CALL LS_MAID_TEXT(@"「%SPLIT_G(@"이렇게 하면 기분 좋아?:내가 깨웠어? 미안해.:나 잘하고 있어?:잠깐만 힘 빼고 있어. 기분 좋게 해 줄게.:어떻게 움직이는 게 좋아?:이렇게 하는 게 좋아?:네 맛, 마음에 들어...:조금 있다가 먹게 해 줄 테니까, 내가 먼저 할게.")%」",1,"l")
	CASE 2
