@LS_FORCE_COMMAND
;Returns Surrender or Slip Out if the player is pushed down while the mode is active.
#DIM DYNAMIC CommandIndex
#DIM DYNAMIC AbleIndex
IF LS_ACTIVE() == ""
	RESULT = 0
	RETURN RESULT
ENDIF
IF CFLAG:MASTER:うふふ == 2
	CALLF SET_VAR("nForceCommandSkipAble",1)
	IF GROUPMATCH(TCVAR:TARGET:20,41,43,44) && TEQUIP:TARGET:0 & 4
		CALL CTRL_CLOTHES_SET(TARGET,"現在衣装の変更_全裸")
		CALL CLOTHES_SETTING_TRAIN(TARGET)
	ENDIF
	IF LAST_ROUND_CLIMAX(-2)
		CommandIndex = 850
	ELSE
		AbleIndex = 317
		WHILE 1
		CALLFORM COM_ABLE{AbleIndex}
		IF RESULT || AbleIndex == 361
			CommandIndex = AbleIndex
			BREAK
		ENDIF
		SELECTCASE AbleIndex
			CASE 317
				AbleIndex = 318
			CASE 318
				AbleIndex = 320
			CASE 320
				AbleIndex = 322
			CASE 322
				AbleIndex = 323
			CASE 323
				AbleIndex = 360
			CASEELSE
				AbleIndex = 361
		ENDSELECT
		WEND
	ENDIF
ENDIF
RESULT = 0
TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_FORCE_COMMAND
SELECTCASE RESULT
	CASE -2 ;Return -2 to cancel forcing entirely.
		CommandIndex = 0
	CASE 0
	CASEELSE
		CommandIndex = RESULT
ENDSELECT
RESULT = CommandIndex
RETURN RESULT

