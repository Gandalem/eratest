@LS_INTERRUPT_MESSAGE(CharacterIndex,AttackerIndex,PartnerCount)
;Prints a message for when a "safe" character interrupts sex.
;Falls back on a default message when there isn't one in the character's dialogue.
#DIM DYNAMIC CharacterIndex
#DIM AttackerIndex
#DIM DYNAMIC PartnerCount
CALL KOJO_MESSAGE_SEND("EVENT",0,CharacterIndex,PartnerCount,AttackerIndex,"INTERRUPT_LS")
SIF !RESULT
	PRINTFORMDL %CALLNAME:CharacterIndex%이 당신을 구하러 오고 당신의 %PLNOUN("attacker",PartnerCount)%를 쫓아낸다!
WAIT
PRINTL
CALL KOJO_MESSAGE_SEND("EVENT",0,AttackerIndex,PartnerCount,CharacterIndex,"INTERRUPTED_LS")
IF RESULT
	WAIT
	PRINTL
ENDIF

