@LS_VISIT(CharacterIndex,VisitDay,VisitLocation,Announce=1)
;Forces the given character to visit the map, starting at the given location, on the given day interval.
;If VisitDay is a negative number, visits at random with the positive form of the number being the percent chance.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC VisitDay
#DIM DYNAMIC VisitLocation
#DIM DYNAMIC Announce
SIF CFLAG:CharacterIndex:神社在住/100 == LS_MAP()
	RETURN
IF VisitDay < 0
	SIF RAND(1,101) > (VisitDay*-1)
		RETURN
ELSEIF VisitDay && (LS_DAY()-1) % VisitDay != (VisitDay-1)
	RETURN
ENDIF
CALL MOVE_CHARACTER(CharacterIndex,VisitLocation)
SIF !IS_LS_INTRUDER(CharacterIndex)
	CFLAG:CharacterIndex:ディレイ = 20
SIF Announce && TALENT:MASTER:居場所察知
	PRINTFORMW 【\@ IS_MET(CharacterIndex) ? %CALLNAME:CharacterIndex% # 누군가가 \@ \@ IS_LS_INTRUDER(CharacterIndex) ? 침입 중이다 # 방문했다 \@】

@LS_ENCOUNTER(CharacterIndex)
;Reroutes the encounter event if Lunatic Survival is active.
;If the given character's dialogue doesn't contain an alternate introduction, it will fall back on a default for that character.
;If neither exists, it will continue with the character's normal encounter event (if any).
#DIM DYNAMIC CharacterIndex
#DIMS DYNAMIC DialogueTag
#DIMS DYNAMIC LSMode
DialogueTag '= RESULTS
LSMode '= LS_ACTIVE()
RESULT = 0
IF LSMode == ""
	RESULTS '= DialogueTag
	RETURN 0
ENDIF
TRYCALLFORM M_KOJO%DialogueTag%_ENCOUNTER_LS_%FUNCTION_FORMAT(LSMode)%_K{CharacterIndex}
SIF !RESULT
	TRYCALLFORM LS_%FUNCTION_FORMAT(LSMode)%_ENCOUNTER_{CharacterIndex}
RESULTS '= DialogueTag
RETURN RESULT

@LS_EVENT(CharacterIndex,EventIndex,ARG,ARG:1,EventLabel,ARGS)
;Reroutes specific events if Lunatic Survival is active.
;If the given character's dialogue doesn't contain an alternate event, it will fall back on a default for that character.
;If neither exists, it will continue with the character's normal event (if any).
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC EventIndex
#DIMS DYNAMIC EventLabel
#DIMS DYNAMIC DialogueTag
#DIMS DYNAMIC LSMode
SIF !GROUPMATCH(EventIndex,1,6,10) && STRFIND(EventLabel,"IRON_CHEF") < 0
	RETURN RESULT
DialogueTag '= RESULTS
LSMode '= LS_ACTIVE()
RESULT = 0
IF LSMode == ""
	RESULTS '= DialogueTag
	RETURN 0
ENDIF
IF EventLabel == ""
	TRYCALLFORM M_KOJO%DialogueTag%_EVENT_LS_%FUNCTION_FORMAT(LSMode)%_K{CharacterIndex}_{EventIndex}(ARG,ARG:1)
	IF !RESULT
		TRYCALLFORM LS_%FUNCTION_FORMAT(LSMode)%_EVENT_K{CharacterIndex}_{EventIndex}(ARG,ARG:1)
	ENDIF
ELSE
	TRYCALLFORM M_KOJO%DialogueTag%_EVENT_LS_%FUNCTION_FORMAT(LSMode)%_K{CharacterIndex}_%EventLabel%(ARGS,ARG,ARG:1)
	IF !RESULT
		TRYCALLFORM LS_%FUNCTION_FORMAT(LSMode)%_EVENT_K{CharacterIndex}_%EventLabel%(ARGS,ARG,ARG:1)
	ENDIF
ENDIF
RESULTS '= DialogueTag
RETURN RESULT

@LS_PUSH_DOWN(CharacterIndex)
;Calls the currently active Lunatic Survival's push down function.
;This is called when a character would push the player down. If it returns 1, the normal push down is aborted without a message.
#DIM DYNAMIC CharacterIndex
SIF LS_ACTIVE() == ""
	RETURN 0
SIF !IN_HOME(CFLAG:MASTER:現在位置)
	RETURN 0
SIF IS_LS_SAFE(CharacterIndex)
	RETURN 1
IF LS_PROTECTED()
	RESULT = 1
	TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_PUSH_DOWN_SAFETY(CharacterIndex)
	SIF RESULT
		RETURN RESULT
ENDIF
RESULT = 0
TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_PUSH_DOWN(CharacterIndex)
LOCAL = RESULT
CALL TARGETSET_CHACK("「同室更新無し」")
CALLF SET_VAR("nRefreshStatus",1)
RETURN LOCAL

@LS_PUSH_DOWN_FOOD_ESCAPE(CharacterIndex)
;Feeds the currently held dish to a character trying to push the player down.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC AlcoholIndex
#DIM DYNAMIC AlcoholBonus
#DIM DYNAMIC HaveAlcohol
#DIM DYNAMIC CanServeAlcohol
SIF TCVAR:CharacterIndex:料理評価値 == 0
	CALL REVIEW_DISH(CharacterIndex,DISH_TASTE)
IF TCVAR:CharacterIndex:料理評価値 < 500
	PRINTFORMDL %CALLNAME:CharacterIndex%은 당신의 %DISHNAME_TR(DISH_NAME)%를 보고 %HIS_HER(CharacterIndex)%이 코를 찡그린다.
	CALL KOJO_MESSAGE_SEND("EVENT",0,CharacterIndex,0,0,"REJECT_FOOD_LS")
	IF !RESULT ;If there's no dialogue-specific text, fall back to a default.
		CALL SET_KOJO_COLOR(CharacterIndex)
		RESULT = 0
		TRYCALLFORM LS_SCARLET_K{CharacterIndex}_REJECT_FOOD
		RESETCOLOR
	ENDIF
	WAIT
	RETURN 0
ENDIF
PRINTFORMDL 당신은 \@ GET_TARGETNUM() > 1 ? 모두에게 # %CALLNAME:CharacterIndex% \@ your %DISHNAME_TR(DISH_NAME)% and \@ GET_TARGETNUM() > 1 ? 그들이 잊게 한다 # %HE_SHE(CharacterIndex)%이 잠시 동안 당신을 밀어붙이는 것을 잊는다 \@.
IF IS_ALC(ITEM:DISH_DRG_2)
	AlcoholIndex = ITEM:DISH_DRG_2
	WAIT
ELSE
	FOR LOCAL,0,1000
	IF IS_ALC(LOCAL)
		HaveAlcohol++
		BREAK
	ENDIF
	NEXT
	IF HaveAlcohol
		FOR LOCAL,1,GET_TARGETNUM()+1
		IF !TALENT:(TARGET:LOCAL):妊娠
			CanServeAlcohol = 1
			BREAK
		ENDIF
		NEXT
	ENDIF
	IF HaveAlcohol && CanServeAlcohol
		PRINTL
		PRINTFORMDL 식사와 함께 술을 제공하시겠습니까?
		PRINTL
		CALL ASK_YN
		PRINTL
		IF !RESULT
			PRINTL
			CALL D_LINE
			PRINTL
			PRINTL
			PRINTFORMDL 어떤 종류?
			PRINTL
			FOR LOCAL,0,1000
			IF ITEM:LOCAL && IS_ALC(LOCAL)
				PRINTFORMDL [{LOCAL}]  %ITEMNAME_TR(LOCAL)%
			ENDIF
			NEXT
			PRINTL
			PRINTFORMDL [0] 취소
			PRINTL
			$LOOP
			INPUT
			AlcoholIndex = RESULT
			SIF AlcoholIndex && !(ITEM:AlcoholIndex && IS_ALC(AlcoholIndex))
				GOTO LOOP
		ENDIF
	ELSEIF HaveAlcohol
		PRINTFORMDW \@ GET_TARGETNUM() > 1 ? 여기에 있는 모두가 # %CALLNAME:CharacterIndex%는 임신했으므로 술을 권하지 않는다. \@
	ELSE
		WAIT
	ENDIF
ENDIF
PRINTL
LOCAL:1 = TARGET
FOR LOCAL,1,GET_TARGETNUM()+1
;Share with everyone in the room.
IF AlcoholIndex && !TALENT:(TARGET:LOCAL):妊娠
	TARGET = TARGET:LOCAL
	AlcoholBonus = ALCOHOL_TASTE(AlcoholIndex)
	SIF AlcoholIndex == ITEM:DISH_DRG_2
		TIMES AlcoholBonus,2
ENDIF
CALL KOJO_MESSAGE_SEND("EVENT",0,TARGET:LOCAL,AlcoholIndex,AlcoholBonus,"ACCEPT_FOOD_LS")
IF !RESULT ;If there's no dialogue-specific text, fall back to a default.
	CALL SET_KOJO_COLOR(TARGET:LOCAL)
	RESULT = 0
	TRYCALLFORM LS_SCARLET_K{TARGET:LOCAL}_ACCEPT_FOOD
	RESETCOLOR
ENDIF
SIF RESULT
	WAIT
PRINTL
CFLAG:(TARGET:LOCAL):ディレイ += 80+(AlcoholBonus*LSAlcoholDelayMod)
CALL 食事(TARGET:LOCAL)
WAIT
PRINTL
IF AlcoholIndex
	PRINTL
	IF TALENT:(TARGET:LOCAL):妊娠
		PRINTFORMDW %CALLNAME:(TARGET:LOCAL)%은 임신으로 인해 음주를 거른다.
	ELSE
		PRINTFORMDL 당신은 %CALLNAME:(TARGET:LOCAL)%에게 %ITEMNAME_TR(AlcoholIndex)%를 대접한다.
		TFLAG:194 = AlcoholIndex
		CALL COM332_1
		PRINTL
		CALL CHANGE_CFLAG(4,TARGET:LOCAL,20+MAX(AlcoholBonus,AlcoholBonus ? 5 # 0))
	ENDIF
	PRINTL
ENDIF
NEXT
SIF AlcoholIndex
	ITEM:AlcoholIndex--
TARGET = LOCAL:1
WAIT
CALL RESET_DISH
RETURN 1

