@LS_TIME_STOP_BREAK(CharacterIndex)
;The given character attempts to break out of time stop.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC BreakThreshold
SIF CFLAG:CharacterIndex:ディレイ
	RETURN
SIF LSTimeStopBreak:CharacterIndex
	GOTO BREAK
;Modify the chance for certain characters to break out.
RESULT = 1
TRYCALLFORMF LS_%FUNCTION_FORMAT(LS_ACTIVE())%_TIME_STOP_BREAK_THRESHOLD(CharacterIndex)
BreakThreshold = RESULT
SELECTCASE RAND:LS_TIME_STOP_POWER()
	CASE IS <= BreakThreshold
		$BREAK
		PRINTL
		RESULT = 0
		TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_TIME_STOP_BREAK(CharacterIndex)
		SIF !RESULT
			CALL LS_TIME_STOP_BREAK_DEFAULT(CharacterIndex)
		LSTimeStopBreak:CharacterIndex = 0
	CASE BreakThreshold+1,BreakThreshold+2
		PRINTL
		RESULT = 0
		TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_TIME_STOP_SIGN
		SIF !RESULT
			CALL LS_TIME_STOP_SIGN_DEFAULT(CharacterIndex)
ENDSELECT

