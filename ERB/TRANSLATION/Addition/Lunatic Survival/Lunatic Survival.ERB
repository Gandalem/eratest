TRYCALLFORMF IS_LS_%FUNCTION_FORMAT(LS_ACTIVE())%_BOSS(CharacterIndex)
RETURNF RESULT

@IS_LS_SAFE(CharacterIndex)
;Returns true if the given character is marked "safe" in Lunatic Survival.
;These characters won't push down the player, and will interfere with other characters pushing the player down.
#FUNCTION
#DIM DYNAMIC CharacterIndex
RESULT = 0
TRYCALLFORMF IS_LS_%FUNCTION_FORMAT(LS_ACTIVE())%_SAFE(CharacterIndex)
RETURNF RESULT

@LS_ENABLE_ESSENTIAL_CHARACTERS
;Enables all disabled characters that are essential to the currently active Lunatic Survival.
#DIM DYNAMIC ReEnable
#DIM DYNAMIC ReEnabledCharacters,20
SIF LS_ACTIVE() == ""
	RETURN
FOR LOCAL,1,CHARANUM
IF IS_LS_ESSENTIAL(LOCAL) && !IS_ENABLED(LOCAL)
	ReEnable++
	CFLAG:LOCAL:出禁 = 0
	FOR LOCAL:1,0,20
	IF ReEnabledCharacters:(LOCAL:1) == 0
		ReEnabledCharacters:(LOCAL:1) = LOCAL
		BREAK
	ENDIF
	NEXT
ENDIF
NEXT
IF ReEnable
	PRINTL
	LOCALS:0 = 
	IF ReEnable > 1
		LOCALS:0 = 나 가지고 있다
	ELSE
		LOCALS:0 = 가지고 있다
	ENDIF
	PRINTFORMDL 다음 캐릭터 %LOCALS:0%가 광기 생존을 위해 재활성화되었다.
	FOR LOCAL,0,ReEnable
	PRINTFORMDL %CALLNAME:(ReEnabledCharacters:LOCAL)%
	NEXT
	WAIT
ENDIF

@LS_SETUP(NewGame)
;Set options according to Lunatic Survival's requirements.
#DIM DYNAMIC NewGame
SIF LS_ACTIVE() == ""
	RETURN
SIF NewGame && (ニューゲーム特典 == "" || ニューゲーム特典 == @"%金額表示(50000)%")
	MONEY -= 40000
TIME:3 = 1200
SIF 睡眠時間予測(TIME:3) < 240
	CFLAG:MASTER:就寝時間 -= 240
FLAG:甲斐性無 = 1
CALLF SET_VAR("FLAG:LUSTMODE",0)
CALLF SET_VAR("FLAG:STABLEBYPASS",1)
CALLF SET_VAR("FLAG:CHILD_LIMIT_BYPASS",1)
FLAG:水やり代行 = 0
FOR LOCAL,1,BookTitles+1
SIF ITEM:(100+LOCAL)
	CLEARBIT FLAG:1011, LOCAL
ITEM:(100+LOCAL) = 0
NEXT
FLAG:貸本返却期限 = 0
TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_SETUP
CALL LS_ENABLE_ESSENTIAL_CHARACTERS
TRYCALL IRAI_RESET_PROCESS
TRYCALL ADD_BANQUET_RESET_ALL
CALL LS_SAVE_CHARACTER_SCHEDULES
CALL LS_SET_CHARACTER_SCHEDULES
FOR LOCAL,1,CHARANUM
;Restore everyone's vigor if there are futanari.
BASE:LOCAL:精力 = MAXBASE:LOCAL:精力
NEXT

@LS_SAVE_CHARACTER_SCHEDULES
;Saves all characters' wake up and sleep times to an array.
FOR LOCAL,0,CHARANUM
;Change this check if there's ever a mode for the Hakurei Shrine.
SIF CFLAG:LOCAL:神社在住/100 != LS_MAP() && !IS_LS_ESSENTIAL(LOCAL)
	CONTINUE
LSSavedSchedule:LOCAL:0 = CFLAG:LOCAL:起床時間
LSSavedSchedule:LOCAL:1 = CFLAG:LOCAL:就寝時間
LSSavedSchedule:LOCAL:2 = CFLAG:LOCAL:来訪時間
LSSavedSchedule:LOCAL:3 = CFLAG:LOCAL:帰宅時間
NEXT

@LS_SET_CHARACTER_SCHEDULES
;Sets all characters to wake and sleep within the hours required by the mode.
FOR LOCAL,0,CHARANUM
SIF CFLAG:LOCAL:神社在住/100 != LS_MAP() && !IS_LS_ESSENTIAL(LOCAL)
	CONTINUE
;Characters wake up two hours before the player to give them time to wander.
CFLAG:LOCAL:起床時間 = CLOCK_TO_TIME(18,0)
CFLAG:LOCAL:就寝時間 = CLOCK_TO_TIME(12,0)
CFLAG:LOCAL:来訪時間 = CLOCK_TO_TIME(19,0)
CFLAG:LOCAL:帰宅時間 = CLOCK_TO_TIME(6,0)
CFLAG:LOCAL:生活時間補正 = 0
NEXT

@LS_RESTORE_CHARACTER_SCHEDULES
;Restores all characters' wake up and sleep times from the previously saved array.
FOR LOCAL,0,CHARANUM
SIF !LSSavedSchedule:LOCAL:0 && !LSSavedSchedule:LOCAL:1
	CONTINUE
CFLAG:LOCAL:起床時間 = LSSavedSchedule:LOCAL:0
CFLAG:LOCAL:就寝時間 = LSSavedSchedule:LOCAL:1
CFLAG:LOCAL:来訪時間 = LSSavedSchedule:LOCAL:2
CFLAG:LOCAL:帰宅時間 = LSSavedSchedule:LOCAL:3
NEXT

@LS_SANITY(DayEnd)
;Sets incompetent mode to vanilla intensity and nullifies the sexual frustration and heat of all non-boss non-safe characters on the map.
;Also reduces desire.
#DIM DYNAMIC DayEnd
SIF LS_ACTIVE() == ""
	RETURN
FLAG:甲斐性無 = IN_HOME(CFLAG:MASTER:現在位置) ? 1 # 0
LSLunaticToggle = 0
FOR LOCAL,1,CHARANUM
SIF !IN_HOME(CFLAG:LOCAL:現在位置)
	CONTINUE
SIF IS_LS_BOSS(LOCAL)
	CONTINUE
SIF IS_LS_SAFE(LOCAL)
	CONTINUE
CFLAG:LOCAL:溜まってる度 = 0
SIF FLAG:異常気象 != 8
	TCVAR:LOCAL:発情 = 0
NEXT
SIF !IN_HOME(CFLAG:MASTER:現在位置)
	RETURN
SIF DayEnd
	RETURN
TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_SANITY_MESSAGE

@LS_PROTECTED
;Returns true if there is a "safe" character in the current area.
#FUNCTION
#DIM DYNAMIC TargetCount
SIF LS_ACTIVE() == ""
	RETURNF 0
TargetCount = GET_TARGETNUM()
SIF !TargetCount
	RETURNF 0
FOR LOCAL,1,TargetCount+1
SIF IS_LS_SAFE(TARGET:LOCAL)
	RETURNF 1
NEXT
RETURNF 0

