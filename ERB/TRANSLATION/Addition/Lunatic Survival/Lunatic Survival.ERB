; Modular ERB: Addition/Lunatic Survival/Lunatic Survival.ERB

@LS_ACTIVE
#FUNCTIONS
;Returns which Lunatic Survival is active, if any.
;If another one is made, add it here.
IF QUEST_FLAG(LSScarletAlias,QLSScarletActive) == 1
	RESULTS '= "Scarlet"
ELSE
	RESULTS '= ""
ENDIF
RETURNF RESULTS

@LS_NEW_GAME_OPTION_TEXT
;Returns the option text for Lunatic Survival in the setup menu.
#FUNCTIONS
#DIMS DYNAMIC ChoiceColor
#DIMS DYNAMIC ChoiceText
SELECTCASE MAIN_MAP
	;If another Lunatic Survival is made, add it here.
	CASE 3
		SIF QUEST_FLAG(LSScarletAlias)
			ChoiceColor '= LSScarletColorString
		ChoiceText '= @"광기 생존 \@ QUEST_FLAG(LSScarletAlias) ? ON # OFF \@"
	CASEELSE
		ChoiceColor '= "#555555"
		ChoiceText '= "광기 생존 OFF (스칼렛 데빌 맨션 필요)"
ENDSELECT
IF !IS_MASTER(0)
	ChoiceColor '= "#555555"
	ChoiceText '= "광기 생존 꺼짐 (커스텀 캐릭터 필요함)"
ENDIF
RESULTS '= @"%COND_STR(@"<font color='%ChoiceColor%'>",ChoiceColor != "")%%ChoiceText%%COND_STR(@"</font>",ChoiceColor != "")%"
RETURNF RESULTS

@LS_NEW_GAME_OPTION
SIF !IS_MASTER(0)
	RETURN
$LOOP
SELECTCASE MAIN_MAP
	;If another Lunatic Survival is made, add it here.
	CASE 3
		IF !QUEST_FLAG(LSScarletAlias)
			CALL LS_DESCRIPTION("Scarlet")
			CALL ASK_M("광인 생존을 켠다",1,"광기 생존은 꺼 둡니다.",1,"상세 규칙",1)
		ELSE
			CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletActive,0)
			RETURN
		ENDIF
ENDSELECT
SELECTCASE RESULT
	CASE 0
		SELECTCASE MAIN_MAP
			CASE 3
				CALL SET_QUEST_FLAG(LSScarletAlias,QLSScarletActive,1)
		ENDSELECT
	CASE 1
	CASE 2
		TRYCALL LS_RULES
		WAIT
		GOTO LOOP
ENDSELECT
;------------------------------------------------------------------------------------------------------
;Functions below here don't need to reference specific modes.
;------------------------------------------------------------------------------------------------------

@LS_DESCRIPTION(SurvivalMode)
;Prints the description of the mode for the new game menu or mid-game start prompt.
#DIMS DYNAMIC SurvivalMode
#DIM DYNAMIC HaveSmellResistant
#DIM DYNAMIC HaveScruffy
PRINTL
CALL D_LINE
PRINTL
TRYCALLFORM LS_%FUNCTION_FORMAT(SurvivalMode)%_DESCRIPTION
PRINTL
SIF (TALENT:MASTER:ズボラ && TALENT:MASTER:汚臭耐性 > -1)
	HaveScruffy = TALENT:MASTER:ズボラ
HaveSmellResistant = MAX(TALENT:MASTER:汚臭耐性,0)
IF HaveScruffy || HaveSmellResistant
	SIF HaveScruffy
		PRINTFORM [%GET_TALENTNAME_TR(18,1)%] 
	SIF HaveScruffy && HaveSmellResistant
		PRINTFORM 그리고 
	SIF HaveSmellResistant
		PRINTFORM [%GET_TALENTNAME_TR(61,TALENT:MASTER:汚臭耐性)%] 
	PRINTFORML 당신의 노력만으로는 적절한 청소가 불가능할 것이다. 잔혹한 난이도를 원한다면 진행하라.
	PRINTL
ENDIF

@LS_RULES
;Prints detailed rules about the mode.
PRINTL
CALL D_LINE
PRINTL
PRINTFORMDL 해당 지역을 벗어나 집의 위치를 변경할 수 없다. 이는 모든 캐릭터에게 적용된다.
PRINTFORMDL 기상 시간은 오후 8시로 고정되며, 하루는 오전 6시에 끝난다. 이는 모든 캐릭터에게 적용된다.
PRINTFORMDL 특정 캐릭터는 비활성화될 수 없다.
PRINTFORMDL 캐릭터들은 연회를 열거나 요청을 하거나 이사를 요구하지 않으며, 특정 캐릭터들만 방문한다.
PRINTFORMDL 특정 캐릭터들은 옷을 갈아입지 않으며, 옷을 갈아입는 것과 관련된 이벤트는 비활성화된다.
PRINTFORMDL 무능력 모드가 높은 강도로 활성화되며 캐릭터들은 발정 상태에 빠진다.
PRINTFORMDL [자제심] 같은 특정 재능들이 일부 캐릭터들에게서 제거될 것이다.
PRINTFORMDL 새로운 게임을 시작할 때, %金額表示(50000)%의 신규 게임 보너스가 %金額表示(10000)%로 감소한다.
PRINTL
PRINTFORMDL 출산 조절, 구멍의 단단함, 처녀성, 안정된 시기 및 육아 관련 삽입 제한은 비활성화된다.
PRINTFORMDL 너를 감금하는 자들은 가능한 모든 상황에서 즉시 너를 아래로 밀어붙인다.
PRINTFORMDL 푸시다운 가드는 효과가 없다.
PRINTFORMDL 쾌락 증가는 증가할 것이다.
PRINTFORMDL 너는 아래로 눌린 동안 통제력을 갖지 못하며 소녀가 절정에 달할 때까지 자동으로 항복한다.
PRINTL
PRINTFORMDL 음식은 부패하는 데 두 배의 시간이 걸린다.
PRINTFORMDL 책들은 스킬을 올리는 데 더 효과적일 것이다.
PRINTL
PRINTFORMDL 당신은 매 밤 소량의 TSP로 시작할 것이다.
PRINTFORMDL 시간을 멈추는 능력은 유용하겠지만 믿을 수는 없을 것이다.
PRINTL
PRINTFORMDL 매일 밤 임무를 완료하지 않으면 다음 날 탈진으로 처벌받는다.
PRINTFORMDL 제약 사항을 해결하는 데 도움이 되는 유용한 아이템이나 다른 것들을 찾을 수 있다.
PRINTFORMDL 모드의 모든 기능과 제한은 탈출할 방법을 찾으면 비활성화된다.
PRINTL

@LS_RESET_CLOTHES
;Resets essential characters' clothing to their default to avoid dealing with the clothing system.
FOR LOCAL,0,CHARANUM
SIF !IS_LS_ESSENTIAL(LOCAL)
	CONTINUE
CFLAG:LOCAL:7 = 0
CALL SELECT_CLOTHES(LOCAL,"今日の衣装")
CALL CTRL_CLOTHES_SET(LOCAL,"現在衣装の変更_普段着")
CALL CTRL_CLOTHES_SET(LOCAL,"おきにいり衣装のリセット")
CFLAG:LOCAL:指定パンツ = 0
CALL CLOTHES_SETTING_TRAIN(LOCAL)
NEXT

@LS_MEMO_CHARACTER(AbortReturn)
