PRINTFORMDW %CALLNAME:CharacterIndex%%SPLIT_G(@"눈이 당신을 바라본다.: 손가락이 움찔거린다.: 날카롭게 숨을 들이마신다.: 슬로우 모션으로 움직이기 시작한다...: 당신에게 미소 짓는다.: 손이 당신의 \@ HAS_PENIS(MASTER) ? 성기 # 가슴 쪽으로 움직인다 \@.: 무언가를 속삭인다.: 웃기 시작한다.")%
LSTimeStopBreak:CharacterIndex = 1

@LS_SLIP_OUT
;Alternative processing for slipping out of push down.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC SpentTimeMinutes
#DIM DYNAMIC SpentTimeHours
SIF LS_ACTIVE() == ""
	RETURN 0
SIF !LAST_ROUND_CLIMAX(-2)
	RETURN 0
CharacterIndex = RESULT:1
SpentTimeMinutes = TIME_PROGRESS(UFUFU_START_TIME+UFUFU_START_DAY*1440)
SpentTimeHours = SpentTimeMinutes/60
SpentTimeMinutes -= SpentTimeHours*60
PRINTFORMDL 절정 동안 %CALLNAME:CharacterIndex%의 눈에서 광기가 약간 사라지고, %HE_SHE(CharacterIndex)%은 당신을 놓아준다.
SIF SpentTimeHours || SpentTimeMinutes
	PRINTFORMDL 당신은 %COND_STR(@"%NUM_COUNT(SpentTimeHours)% %PLURALIZER("hour",SpentTimeHours)%",SpentTimeHours)%%COND_STR(" and ",SpentTimeHours && SpentTimeMinutes)%%COND_STR(@"%NUM_COUNT(SpentTimeMinutes)% %PLURALIZER("minute",SpentTimeMinutes)%",SpentTimeMinutes)%을 위해 사용되었다.
FORCEWAIT
PRINTL
FOR LOCAL,1,GET_TARGETNUM()+1
;Just enough time to Serve Tea and leave.
CFLAG:(TARGET:LOCAL):ディレイ += 40
NEXT
TRYCALLFORM LS_%FUNCTION_FORMAT(LS_ACTIVE())%_SLIP_OUT
RETURN 2

