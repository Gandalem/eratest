#FUNCTION
#DIM DYNAMIC AbortReturn
SIF AbortReturn
	RETURNF 999
RESULT = 999
TRYCALLFORMF LS_%FUNCTION_FORMAT(LS_ACTIVE())%_MEMO_CHARACTER
