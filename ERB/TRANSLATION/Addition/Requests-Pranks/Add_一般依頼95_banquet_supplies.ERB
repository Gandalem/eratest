; Modular ERB: Addition/Requests-Pranks/Add_一般依頼95_banquet_supplies.ERB

@EXIST_一般依頼95
#LOCALSIZE 1
#LOCALSSIZE 1

@一般依頼95(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM  BANQUET_INDEX
#DIM  DESIRED_ITEM
IF CFLAG:ARG:依頼状況 > 1 && CFLAG:ARG:依頼状況 < 100
	DESIRED_ITEM = IRAI_SLOT_TO_ITEM(SEARCH_IRAI_SLOT(CFLAG:ARG:依頼内容))
ELSE
	DESIRED_ITEM = 0
ENDIF
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Banquet supplies")
	CASE "依頼内容表示"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
		IF BANQUET_INDEX < 0
			CALLF MAKE_STR(V_NAME, "")
		ELSE
			CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%의 연회를 위한 요청된 물품을 얻어라")
		ENDIF
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"연회는 더 커질 것이다")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, @"Deliver The Supplies")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(IRAI_一般95_ITEM(ARG), "調達"))
	CASE "依頼サブ"
		CALLF MAKE_INT(V_NAME, IRAI_一般95_QUANTITY(IRAI_一般95_ITEM(ARG)))
	CASE "依頼期限"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
		IF BANQUET_INDEX < 0
			CALLF MAKE_INT(V_NAME, 0)
		ELSE
			CALLF MAKE_INT(V_NAME, ADD_BANQUETS_START_DAY:BANQUET_INDEX - DAY)
		ENDIF
	CASE "依頼発生率"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼発生条件"
		;not triggered normally, done through Add_SPECIAL_REQUEST_CREATION instead
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼受託可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		SIF ITEM:DESIRED_ITEM >= IRAI_一般95_QUANTITY(DESIRED_ITEM)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼消滅条件"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
		IF BANQUET_INDEX < 0
			CALLF MAKE_INT(V_NAME, 1)
		ELSEIF ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) < 0
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "MEETINGPOINT_ALLOWED"
		SIF ITEM:DESIRED_ITEM >= IRAI_一般95_QUANTITY(DESIRED_ITEM)
			CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般95(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  SCALE_INCREASE
#DIM  BANQUET_INDEX
#DIM  DESIRED_ITEM
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
DESIRED_ITEM = IRAI_SLOT_TO_ITEM(SEARCH_IRAI_SLOT(IRAI_ID))
SELECTCASE SCENE
	CASE "依頼条件表示"
	CASE "依頼実行時"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(CLIENT_ID)
		IF BANQUET_INDEX < 0
			PRINTFORML 경고: 유효한 연회가 활성화되어 있지 않다. 요청이 취소되었다.
			RETURN IRAI_CONST_RESULT("実行して失敗")
		ENDIF
		PRINTFORMW 당신은 %ITEMNAME_TR(DESIRED_ITEM)%을%CALLNAME:CLIENT_ID%에게 전달한다.
		CALL LOST_ITEM(ITEMNAME:DESIRED_ITEM, IRAI_一般95_QUANTITY(DESIRED_ITEM), 2)
		PRINTFORM %CALLNAME:CLIENT_ID%에게 제때 배달해 주셔서 감사합니다.
		IF ADD_BANQUETS_INVITED:BANQUET_INDEX == 0
			ADD_BANQUETS_INVITED:BANQUET_INDEX = ADD_BANQUET_INVITE_INVITED
			PRINTFORML 또한 당신을 만찬에 초대한다.
		ELSE
			PRINTFORML .
		ENDIF
		ADD_BANQUETS_SCALE:BANQUET_INDEX += RAND:1500
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼実行時_MEETINGPOINT"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(CLIENT_ID)
		IF BANQUET_INDEX < 0
			PRINTFORML 경고: 유효한 연회가 활성화되어 있지 않다. 요청이 취소되었다.
			RETURN IRAI_CONST_RESULT("実行して失敗")
		ENDIF
		PRINTFORML 당신은 %ITEMNAME_TR(DESIRED_ITEM)%의 특급 배송을 %CALLNAME:CLIENT_ID%에게 설정했다.
		CALL LOST_ITEM(ITEMNAME:DESIRED_ITEM, IRAI_一般95_QUANTITY(DESIRED_ITEM), 2)
		IF ADD_BANQUETS_INVITED:BANQUET_INDEX == 0
			ADD_BANQUETS_INVITED:BANQUET_INDEX = ADD_BANQUET_INVITE_INVITED
			PRINTFORML 당신의 노력 덕분에, 아마 연회에 함께 참석해도 환영받을 겁니다.
		ELSE
			PRINTFORML 당신은 만찬을 기대하고 있다.
		ENDIF
		ADD_BANQUETS_SCALE:BANQUET_INDEX += RAND:1500
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		CALL CHANGE_CFLAG(2, CLIENT_ID, 50)
		CALL CHANGE_CFLAG(4, CLIENT_ID, 20)
		CALL KIGEN_CHANGE(CLIENT_ID, 50, 1)
		;reimbursed for 80% of store price
		CALL GET_MONEY_YEN(MULTIPLY(ITEMPRICE:DESIRED_ITEM, 80) * IRAI_一般95_QUANTITY(DESIRED_ITEM), 2)
	CASE "依頼失敗時"
		CALL CHANGE_CFLAG(2, CLIENT_ID, -20)
		CALL CHANGE_CFLAG(4, CLIENT_ID, -10)
		CALL KIGEN_CHANGE(CLIENT_ID, 50, -1)
ENDSELECT

@IRAI_一般95_ITEM(CHARA)
#FUNCTION
#DIM CHARA
IF TALENT:CHARA:酒耐性 == -2 ;nondrinker
	RETURNF GETNUM(ITEM, "甘酒") ;sweet sake
ELSEIF TALENT:CHARA:神霊 ;divine spirit
	RETURNF GETNUM(ITEM, "お神酒") ;sacred sake
ELSEIF CHECK_CHARA(CHARA, "鬼") ;oni
	RETURNF GETNUM(ITEM, "鬼殺し") ;strong sake
ELSE
	RETURNF GETNUM(ITEM, "清酒") ;regular sake
ENDIF

@IRAI_一般95_QUANTITY(DESIRED_ITEM)
#FUNCTION
#DIM DESIRED_ITEM
SELECTCASE DESIRED_ITEM
	CASE GETNUM(ITEM, "甘酒")
		RETURNF 20
	CASE GETNUM(ITEM, "お神酒")
		RETURNF 5
	CASE GETNUM(ITEM, "鬼殺し")
		RETURNF 5
	CASE GETNUM(ITEM, "清酒")
		RETURNF 10
ENDSELECT
