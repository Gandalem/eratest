@IRAI_固有72_INABA_MOANS(INABA_COLORS, INABA_COUNT, NUMBER_OF_MOANS, L_RATIO = 1, M_RATIO = 1, H_RATIO = 1)
#DIM REF INABA_COLORS
#DIM INABA_COUNT
#DIM NUMBER_OF_MOANS
#DIM L_RATIO
#DIM M_RATIO
#DIM H_RATIO
#DIM LAST_INABA
#DIM INABA
LAST_INABA = -1
REPEAT NUMBER_OF_MOANS
IF INABA_COUNT > 1
	WHILE 1
	INABA = RAND:INABA_COUNT
	IF INABA != LAST_INABA
		LAST_INABA = INABA
		BREAK
	ENDIF
	WEND
ELSE
	INABA = 0
ENDIF
SELECTCASE RAND:(L_RATIO + M_RATIO + H_RATIO)
	CASE IS < L_RATIO
		CALL COLORMESSAGE(@"「%MOAN("l")%...」", INABA_COLORS:INABA)
	CASE IS < L_RATIO + M_RATIO
		CALL COLORMESSAGE(@"「%MOAN("m")%...」", INABA_COLORS:INABA)
	CASEELSE
		CALL COLORMESSAGE(@"「%MOAN("h")%...」", INABA_COLORS:INABA)
ENDSELECT
REND
PRINTL
