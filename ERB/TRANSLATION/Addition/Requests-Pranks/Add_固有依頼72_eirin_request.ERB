; Modular ERB: Addition/Requests-Pranks/Add_固有依頼72_eirin_request.ERB
;if there's ever an Eirin request created in the original, adjust the id and merge this into that, if necessary

@固有依頼72(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM  DESIRED_ITEM
SELECTCASE ARG % 1000
	;ID101：Materials collecting
	CASE 101
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "Medicine Gathering")
			CASE "依頼内容表示"
				CALLF MAKE_STR(V_NAME, @"지정된 재료를 얻는다 %CALLNAME:[[永琳]]%을(를)")
			CASE "依頼報酬表示"
				CALLF MAKE_STR(V_NAME, @"%金額表示(2000)%")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, @"Deliver Materials")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(IRAI_固有72_ITEM(), "調達"))
			CASE "依頼サブ"
				CALLF MAKE_INT(V_NAME, 10)
			CASE "依頼期限"
				CALLF MAKE_INT(V_NAME, 5)
			CASE "依頼発生率"
				CALLF MAKE_INT(V_NAME, 10)
			CASE "依頼発生条件"
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼受託可能条件"
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼実行可能条件"
				DESIRED_ITEM = IRAI_SLOT_TO_ITEM(SEARCH_IRAI_SLOT(CFLAG:[[永琳]]:依頼内容))
				SIF ITEM:DESIRED_ITEM >= 10
					CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼消滅条件"
				SIF Add_Request_Should_Discard(ARG)
					CALLF MAKE_INT(V_NAME, 1)
		ENDSELECT
		;ID102：Rabbit sex
	CASE 102
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "Rabbit Stress Relief")
			CASE "依頼内容表示"
				CALLF MAKE_STR(V_NAME, @"에이테이의 토끼들의 갈증을 해주고 그들의 좌절감을 풀어주세요.")
			CASE "依頼報酬表示"
				CALLF MAKE_STR(V_NAME, @"%金額表示(10000)%")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, @"Take Care Of The Rabbits")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
			CASE "依頼サブ"
				CALLF MAKE_INT(V_NAME, 0)
			CASE "依頼期限"
				CALLF MAKE_INT(V_NAME, 0)
			CASE "依頼発生率"
				IF FLAG:異常気象 == 8 ;virtually guaranteed during pink wind
					CALLF MAKE_INT(V_NAME, 10000)
				ELSEIF DAY:3 == 28 ;more common on bunny day
					CALLF MAKE_INT(V_NAME, 3)
				ELSE
					CALLF MAKE_INT(V_NAME, 1)
				ENDIF
			CASE "依頼発生条件"
				IF !HAS_PENIS(MASTER)
				ELSEIF IS_DOUTEI(MASTER) ;no virgins to make this easier
				ELSEIF TALENT:MASTER:キス未経験
				ELSEIF CFLAG:[[永琳]]:信頼度 < 100
				ELSE
					CALLF MAKE_INT(V_NAME, 1)
				ENDIF
			CASE "依頼受託可能条件"
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼実行可能条件"
				SIF !FLAG:70
					CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼消滅条件"
				SIF Add_Request_Should_Discard(ARG)
					CALLF MAKE_INT(V_NAME, 1)
		ENDSELECT
ENDSELECT

@IRAI_固有72_SET_COLORS(INABA_COLORS)
#DIM REF INABA_COLORS
SIF INABA_COLORS:0
	RETURN
INABA_COLORS:0 = 0xFF7FBE ;the virgin
INABA_COLORS:1 = 0xFF00BE ;virgin's friend
INABA_COLORS:2 = 0xC627BE
INABA_COLORS:3 = 0xC62733
INABA_COLORS:4 = 0xDD7433
INABA_COLORS:5 = 0xDBA334
INABA_COLORS:6 = 0x55A334
INABA_COLORS:7 = 0x00C934
INABA_COLORS:8 = 0x00C9A7
INABA_COLORS:9 = 0x00745D

@IRAI_固有72(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  DESIRED_ITEM
#DIM  VALID_SCENARIOS, 20
#DIM  SELECTED_SCENARIO
#DIM  SCENARIO_COUNT
#DIM  INABA_COLORS, 20
#DIM  SCENE_COUNT
#DIM  SCENARIO_INDEX
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
	;for now, keep it simple, will expand request system later to enable easily setting a desired item and quantity, instead of it having to be a fixed item
	CASE "Medicine Gathering"
		SELECTCASE SCENE
			CASE "依頼条件表示"
			CASE "依頼実行時"
				DESIRED_ITEM = IRAI_SLOT_TO_ITEM(SEARCH_IRAI_SLOT(CFLAG:[[永琳]]:依頼内容))
				PRINTFORMW 당신은 에이린에게 %ITEMNAME_TR(DESIRED_ITEM)%을 전달한다.
				CALL LOST_ITEM(ITEMNAME:DESIRED_ITEM, 10, 2)
				RETURN IRAI_CONST_RESULT("実行して成功")
			CASE "依頼成功時"
				SOURCE:歓楽 += 1000
				PRINTFORML 에이린은 당신에게 재료를 가져다준 것에 대해 감사한다.
				CALL CHANGE_CFLAG(2, [[永琳]], 50)
				CALL CHANGE_CFLAG(4, [[永琳]], 20)
				CALL GET_MONEY_YEN(1000, 2)
			CASE "依頼失敗時"
				PRINTFORML 에이린은 당신이 그녀의 과제를 완수하지 못한 것에 실망한다.
				CALL CHANGE_CFLAG(2, [[永琳]], -5)
				CALL CHANGE_CFLAG(4, [[永琳]], -3)
		ENDSELECT
	CASE "Rabbit Stress Relief"
		SELECTCASE SCENE
			CASE "依頼条件表示"
			CASE "依頼実行時"
				VARSET VALID_SCENARIOS, -1
				CALL IRAI_固有72_SET_COLORS(INABA_COLORS)
				CALL SET_KOJO_COLOR([[永琳]])
				PRINTFORMDL 에이린은 당신을 에전의 넓은 방으로 안내한다.
				PRINTFORML 「이것을 해줘서 고맙구나. 토끼들이 요즘 정말 불안해했단다. 적절한 배출구가 없으니 임무에 집중하지 못하고 말이야.」
				PRINTFORML 「다행히 요괴인 너희에게 해결책은 아주 간단하단다.」
				PRINTFORML 「모두 피임약을 투여했고, 나는 너희가 모두를 처리할 만큼 충분히 오래 버틸 수 있도록 약을 준비했지.」
				PRINTFORMW 「너무 무리하지 않도록 조심하기만 하면 된단다. 너 자신의 건강도 고려하는 것이 중요하니까.」
				PRINTFORMDW 방에 들어서자, 토끼들이 불안하게 앉거나 누워 있는 모습이 보인다.
				CALL COLORMESSAGE(@"「아, %조사처리(CALLNAME:MASTER,"가")% 여기 있네!」", INABA_COLORS:1, 2)
				CALL COLORMESSAGE(@"「드디어!」", INABA_COLORS:2, 1)
				CALL COLORMESSAGE(@"「그냥 바로 시작하자.」", INABA_COLORS:5, 1)
				CALL COLORMESSAGE(@"「에헤헤, 이거 정말 재미있겠네.」", INABA_COLORS:1, 2)
				PRINTFORMDL 당신이 반응할 틈도 없이 요괴 토끼 무리가 당신에게 돌진하며 당신과 스스로를 빠르게 옷을 벗긴다.
				PRINTFORMDL 금세 방 안의 모든 사람이 완전히 알몸이 된다.
				CALL COLORMESSAGE(@"「자, 이제 다 준비가 되었어♪」", INABA_COLORS:2, 1)
				CALL COLORMESSAGE(@"「길고 긴 하루를 위해 준비해 주셨기를 바랍니다, %CALLNAME:MASTER%. 토끼의 교미가 무엇인지 보여드릴게요.」", INABA_COLORS:6, 1)
				PRINTFORMDW 당신은 각오를 다지고 소녀들에게 달려들어 그들이 모두 만족할 때까지 포기할 생각이 없다.
				VALID_SCENARIOS = 0, 1, 2, 3
				SCENARIO_COUNT = 4
				SIF IRAI_固有72_CHARACTER_VALID([[てゐ]])
					VALID_SCENARIOS:(SCENARIO_COUNT++) = 21
				;SIF IRAI_固有72_CHARACTER_VALID([[鈴仙]])
				;     VALID_SCENARIOS:(SCENARIO_COUNT++) = 22
				;SIF IRAI_固有72_CHARACTER_VALID([[輝夜]])
				;     VALID_SCENARIOS:(SCENARIO_COUNT++) = 23
				;SIF IRAI_固有72_CHARACTER_VALID([[永琳]])
				;     VALID_SCENARIOS:(SCENARIO_COUNT++) = 24
				; SIF GETBIT(FLAG_DAILY_EV23, 4)
				;     VALID_SCENARIOS:(SCENARIO_COUNT++) = 25
				;SIF IRAI_固有72_CHARACTER_VALID([[レイセン]])
				;     VALID_SCENARIOS:(SCENARIO_COUNT++) = 24
				SCENE_COUNT = 3 ;vary by max VIG or something?
				FOR LOCAL, 0, SCENE_COUNT
				IF LOCAL == 0 ;first scene is always a rabbit scene
					SCENARIO_INDEX = RAND:4
				ELSE
					SCENARIO_INDEX = RAND:SCENARIO_COUNT
				ENDIF
				SELECTED_SCENARIO = VALID_SCENARIOS:SCENARIO_INDEX
				CALL IRAI_固有72_INABA_SCENARIO(SELECTED_SCENARIO, INABA_COLORS)
				ARRAYREMOVE VALID_SCENARIOS, SCENARIO_INDEX, 1
				SCENARIO_COUNT--
				NEXT
				PRINTL
				PRINTFORMDL 결국 토끼들은 모두 완전히 만족한 채 잠이 들었다.
				PRINTFORMDL 당신의 노력에 자부심을 느끼며 자신을 정리하고 방을 나간다.
				;cap reduction to not leave the player empty
				BASE:MASTER:体力 = MAX(BASE:MASTER:体力-750, 750)
				BASE:MASTER:気力 = MAX(BASE:MASTER:気力-1000, 0)
				BASE:MASTER:精力 = 0
				BASE:MASTER:勃起 = 0
				nSexDone ++
				TIME += 175
				RETURN IRAI_CONST_RESULT("実行して成功")
			CASE "依頼成功時"
				SOURCE:歓楽 += 3000
				CALL SET_KOJO_COLOR([[永琳]])
				PRINTFORMDL %CALLNAME:[[永琳]]%은 토끼들을 처리해 준 것에 대해 감사하다고 말한다.
				PRINTFORML 「잘했어. 이걸 대신 처리해 줘서 고마워.」
				CALL CHANGE_CFLAG(2, [[永琳]], 75)
				CALL CHANGE_CFLAG(4, [[永琳]], 40)
				CALL GET_MONEY_YEN(10000, 2)
			CASE "依頼失敗時"
		ENDSELECT
ENDSELECT

@IRAI_固有72_CHARACTER_VALID(ARG)
#FUNCTION
RETURNF !CFLAG:ARG:出禁 && CFLAG:ARG:既成事実 & 合意_うふふ && !TALENT:ARG:処女 && IS_FEMALE(ARG)

@IRAI_固有72_INABA_SCENARIO(SCENARIO, INABA_COLORS)
#DIM SCENARIO
#DIM REF INABA_COLORS
#DIM INABA_COLORS_TEMP, 20
PRINTL
SELECTCASE SCENARIO
	CASE 0 ;reverse gangbang
		PRINTFORMDL 한 무리의 토끼들이 당신을 밀쳐 누르게 하고, 당신은 등을 대고 눕는다.
		PRINTFORMDL 그들 중 하나가 당신의 성기에 앉고, 다른 하나는 당신의 얼굴에 앉으며, 나머지 네 마리가 당신의 팔과 다리에 앉는다.
		CALL COLORMESSAGE("「너의 몸의 모든 부분으로 우리 자신을 기분 좋게 만들 거야.」", INABA_COLORS:3, 1)
		CALL COLORMESSAGE("「그냥 누워서 모든 일을 우리에게 맡기세요.」", INABA_COLORS:4, 1)
		PRINTFORMDL 그들의 욕정에 따르며, 소녀들이 온몸으로 당신을 문 채 조용히 누워있다.
		PRINTFORMDL 얼굴에 있는 한 명의 입술을 핥기 시작하자, 그녀는 그것만으로도 깜짝 놀라 몸을 일으켰다.
		CALL COLORMESSAGE(@"「%MOAN()%! 응, 계속해줘. 그 자리가 너무 좋아. %MOAN("m")%」", INABA_COLORS:5, 1)
		PRINTFORMDL %BREAKENG(@"점점 더 많은 소녀들이 당신 위로 쌓여들고, 가능한 모든 공간에 몸을 지탱하며 가슴과 팔, 다리 위에 자리 잡는다.")%
		CALL IRAI_固有72_INABA_MOANS(INABA_COLORS, 10, 5, 3, 2, 1)
		PRINTFORMDL %BREAKENG(@"너무 많은 이들이 당신 위에 쌓여 이제 겨우 움직일 수 있을 정도지만, 몸 전체에 그들의 온기를 느끼자 오래지 않아 사정하게 된다.")%
		CALL COLORMESSAGE(@"「계속해, 전부 안에 싸줘. 네 씨로 나를 가득 채워줘♪」", INABA_COLORS:2, 1)
		CALL IRAI_固有72_INABA_MOANS(INABA_COLORS, 10, 8, 0, 3, 2)
		PRINTFORMDL 토끼가 격렬하게 다가오고, 그녀의 황홀한 얼굴을 본 다른 이들 역시 한계까지 몰리며 동시에 오르가즘을 느낀다.
		PRINTFORMDW 그들이 회복하자마자 토끼들은 위치를 바꾸어 당신 위에서 계속 타기 시작했고, 단 한순간의 휴식도 허락하지 않았다...
	CASE 1 ;reverse lotus (exposure)
		;victim is rabbit #8
		PRINTFORMDL 토끼 중 하나를 집어 무릎 위에 앉히고, 다른 이들에게 앞부분을 드러낸다.
		CALL COLORMESSAGE(@"「에헤헤, 당신은 정말 따뜻하네요, %CALLNAME:MASTER%씨.」", INABA_COLORS:8, 1)
		CALL COLORMESSAGE(@"「하지만 이게 정말 네가 하고 싶은 전부니?」", INABA_COLORS:8, 1)
		PRINTFORMDL 그녀를 자랑하듯, 당신은 능숙하게 그녀의 귀여운 작은 가슴과 사랑스러운 클리토스를 쓰다듬고, 그녀의 입술에서 나지막한 신음이 새어 나온다.
		CALL COLORMESSAGE(@"「%MOAN("l")%... 다른 사람 앞에서 이걸 하는 게 너무 부끄럽다... %MOAN("l")%...」", INABA_COLORS:8, 1)
		PRINTFORMDL %BREAKENG("소녀가 부끄러워하는 것은 아랑곳하지 않고, 당신은 매끄러운 손길로 온몸을 훑는다. 다른 이들이 흥미진진하게 바라보는 가운데 흘러나오는 수치 어린 신음을 즐긴다.")%
		CALL COLORMESSAGE(@"「%MOAN("m")%... 그만해 주세요, %CALLNAME:MASTER%. %MOAN("m")%... 더는 못 견디겠어요... %MOAN("h")%...」", INABA_COLORS:8, 1)
		PRINTFORMDL %BREAKENG(@"그녀의 말을 따르는 듯 허리를 잡고 소녀를 부드럽게 들어 올린 후 당신의 발기된 %FSYN("penis")%. ")%
		CALL COLORMESSAGE(@"「에, 너는 뭐- %MOAN("h")%」", INABA_COLORS:8, 1)
		CALL COLORMESSAGE(@"「%MOAN("r",,4)%」", INABA_COLORS:8, 1)
		PRINTFORMDL 네가 계속해서 아래에서 토끼에게 격렬하게 삽입하는 동안, 너는 다른 이들에게 합류하라고 손짓한다.
		PRINTFORMDL 그들은 당신의 무릎 위의 소녀를 사방에서 핥고 문지르며 기쁘게 도와준다.
		PRINTFORMDL 당신이 아래에서 그 멤버를 토끼에게 격렬하게 박는 것을 계속하면서, 다른 이들에게 합류하라는 신호를 보낸다.
		CALL COLORMESSAGE(@"「%MOAN("h",,8)%」", INABA_COLORS:8, 1)
		PRINTFORMDW 네가 마침내 그녀를 놓아주자, 그녀는 더 이상 일어설 수 없어 바닥으로 쓰러진다...
	CASE 2 ;virgin (#0 and #1)
		VARSET INABA_COLORS_TEMP
		INABA_COLORS_TEMP:0 = INABA_COLORS:0
		INABA_COLORS_TEMP:1 = INABA_COLORS:1
		CALL COLORMESSAGE(@"「여기 와주세요, %CALLNAME:MASTER%.」", INABA_COLORS:1, 1)
		PRINTFORMDL 목소리가 나는 쪽을 바라보니, 더 큰 소녀의 무릎에 작은 소녀가 앉아 있는 것이 보인다.
		CALL COLORMESSAGE(@"「이 소녀는 아직 처녀야, 알잖아? 그녀는 오늘 당신이 자신의 첫 경험을 해 주길 바라고 있었어.」", INABA_COLORS:1, 1)
		PRINTFORMDL 그녀의 무릎에 있는 소녀는 당신이 그녀를 보는 순간 얼굴이 붉어진다.
		CALL COLORMESSAGE(@"「저, %STUTTER("제발")%... %STUTTER("안아")% 주세요.」", INABA_COLORS:0, 1)
		CALL COLORMESSAGE(@"「귀엽지 않아? 그녀에게 부드럽게 대해주도록 해, 알겠지?」", INABA_COLORS:1, 1)
		PRINTFORMDW %BREAKENG(@"이 작은 토끼에게 여성의 즐거움에 대해 모든 것을 가르쳐 줄 생각에 흥분하여, 당신은 그 토끼의 제안을 받아들이기로 결정한다.")%
		PRINTFORMDL 큰 토끼가 당신에게 그녀의 속을 잘 볼 수 있게 작은 소녀의 처녀의 슬릿을 벌려준다.
		CALL COLORMESSAGE(@"「%STUTTER("제발")% 그렇게 오래 쳐다보지 마세요...」", INABA_COLORS:0, 1)
		PRINTFORMDL 그녀는 두 손으로 얼굴을 가리며 말한다.
		PRINTFORMDL 당신은 조심스럽게 그녀의 음핵과 음순을 핥으며 순진한 처녀의 달콤한 신음을 즐긴다.
		CALL COLORMESSAGE(@"「%MOAN("l",,2)%.」", INABA_COLORS:0, 1)
		PRINTFORMDW 다른 토끼들은 당신 주위에 원을 만들었고, 친구의 첫 성 경험을 분명 즐기고 있었다.
		PRINTFORMDL 소녀가 충분히 젖었다고 판단한 당신은 자신의 음경을 그녀의 질 입구에 맞춘다.
		PRINTFORMDL 다른 소녀는 자신의 작은 친구의 다리를 넓게 벌리고 그녀의 귀에 격려하는 말을 속삭였다.
		PRINTFORMDL 당신은 경험 없는 틈 안으로 음경을 단숨에 깊숙이 밀어 넣는다.
