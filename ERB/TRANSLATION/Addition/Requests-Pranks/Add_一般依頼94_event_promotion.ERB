; Modular ERB: Addition/Requests-Pranks/Add_一般依頼94_event_promotion.ERB

@EXIST_一般依頼94
#LOCALSIZE 1
#LOCALSSIZE 1

@一般依頼94(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM  BANQUET_INDEX
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Concert Promotion")
	CASE "依頼内容表示"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
		IF BANQUET_INDEX < 0
			CALLF MAKE_STR(V_NAME, "")
		ELSE
			CALLF MAKE_STR(V_NAME, @"다음을 홍보해라 %GET_STR(0, "ADD_BANQUET", ADD_BANQUETS_UPCOMING:BANQUET_INDEX, "NAME")%")
		ENDIF
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"콘서트는 더 많은 사람들을 끌 것이다.")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, @"Promote %CALLNAME:ARG%'s Concert")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(IRAI_一般94_LOCATION(), "伝令（場所）"))
	CASE "依頼サブ"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼期限"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
		IF BANQUET_INDEX < 0
			CALLF MAKE_INT(V_NAME, 0)
		ELSE
			CALLF MAKE_INT(V_NAME, ADD_BANQUETS_START_DAY:BANQUET_INDEX - DAY)
		ENDIF
	CASE "依頼発生率"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼発生条件"
		;not triggered normally, done through Add_SPECIAL_REQUEST_CREATION instead
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼受託可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼消滅条件"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
		IF BANQUET_INDEX < 0
			CALLF MAKE_INT(V_NAME, 1)
		ELSEIF ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) < 0
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
ENDSELECT

@IRAI_一般94(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  SCALE_INCREASE
#DIM  BANQUET_INDEX
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
	CASE "依頼実行時"
		BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(CLIENT_ID)
		IF BANQUET_INDEX < 0
			PRINTFORML 경고: 유효한 연회가 활성화되어 있지 않다. 요청이 취소되었다.
			RETURN IRAI_CONST_RESULT("実行して失敗")
		ENDIF
		SCALE_INCREASE = RAND:(ABL:MASTER:話術技能 * 400)
		PRINTFORML 지나가는 사람들에게 말을 걸고 %GET_STR(0, "ADD_BANQUET", ADD_BANQUETS_UPCOMING:BANQUET_INDEX, "NAME")%의 다가오는 콘서트 홍보 전단지를 나눠준다.
		SELECTCASE SCALE_INCREASE
			CASE IS <= 200
				PRINTFORMW 불행하게도, 당신의 어색한 사람들 접근 시도는 별로 성과가 없다.
			CASE IS <= 600
				PRINTFORMW 너는 그저 몇몇 사람들을 콘서트에 참석하도록 설득하는 데 성공했을 뿐이다.
			CASE IS <= 1000
				PRINTFORMW 당신은 상당수의 사람들이 콘서트에 참석하도록 설득하는 데 성공한다.
			CASE IS <= 2000
				PRINTFORMW 당신의 노력 덕분에 많은 사람들이 다가오는 콘서트에 대해 들떠 있는 것 같다.
			CASEELSE
				PRINTFORML 당신의 은어(silver tongue)로 많은 사람들을 설득하여 콘서트에 오게 한다.
				PRINTFORMW 이것은 앞으로 몇 달 동안 기억될 이벤트가 될 것이다!
		ENDSELECT
		ADD_BANQUETS_SCALE:BANQUET_INDEX += SCALE_INCREASE
		TIME += 55
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		CALL CHANGE_CFLAG(2, TARGET, 50)
		CALL CHANGE_CFLAG(4, TARGET, 40)
		CALL KIGEN_CHANGE(TARGET, 50, 1)
	CASE "依頼失敗時"
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT

