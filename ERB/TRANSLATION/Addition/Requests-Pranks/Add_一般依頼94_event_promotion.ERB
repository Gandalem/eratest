@EXIST_一般依頼94
#LOCALSIZE 1
#LOCALSSIZE 1

@一般依頼94(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM  BANQUET_INDEX
SELECTCASE O_DATA
CASE "依頼名"
	CALLF MAKE_STR(V_NAME, "Concert Promotion")
CASE "依頼内容表示"
	BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
	IF BANQUET_INDEX < 0
		CALLF MAKE_STR(V_NAME, "")
	ELSE
		CALLF MAKE_STR(V_NAME, @"Help promote %GET_STR(0, "ADD_BANQUET", ADD_BANQUETS_UPCOMING:BANQUET_INDEX, "NAME")%")
	ENDIF
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"Concert will attract more people")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, @"Promote %CALLNAME:ARG%'s Concert")
CASE "依頼内容"
	CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(IRAI_一般94_LOCATION(), "伝令（場所）"))
CASE "依頼サブ"
	CALLF MAKE_INT(V_NAME, 0)
CASE "依頼期限"
	BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
	IF BANQUET_INDEX < 0
		CALLF MAKE_INT(V_NAME, 0)
	ELSE
		CALLF MAKE_INT(V_NAME, ADD_BANQUETS_START_DAY:BANQUET_INDEX - DAY)
	ENDIF
CASE "依頼発生率"
	CALLF MAKE_INT(V_NAME, 0)
CASE "依頼発生条件"
	;not triggered normally, done through Add_SPECIAL_REQUEST_CREATION instead
	CALLF MAKE_INT(V_NAME, 0)
CASE "依頼受託可能条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "依頼実行可能条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "依頼消滅条件"
	BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(ARG)
	IF BANQUET_INDEX < 0
		CALLF MAKE_INT(V_NAME, 1)
    ELSEIF ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) < 0
		CALLF MAKE_INT(V_NAME, 1)
	ENDIF
ENDSELECT

@IRAI_一般94(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  SCALE_INCREASE
#DIM  BANQUET_INDEX
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
CASE "依頼条件表示"
CASE "依頼実行時"
	BANQUET_INDEX = ADD_BANQUET_HOSTING_UPCOMING(CLIENT_ID)
	IF BANQUET_INDEX < 0
		PRINTFORML WARNING: No valid banquet active. Request canceled.
		RETURN IRAI_CONST_RESULT("実行して失敗")
	ENDIF

	SCALE_INCREASE = RAND:(ABL:MASTER:話術技能 * 400)
	PRINTFORML You talk to passersby and hand out flyers to promote %GET_STR(0, "ADD_BANQUET", ADD_BANQUETS_UPCOMING:BANQUET_INDEX, "NAME")%'s upcoming concert.
	
	SELECTCASE SCALE_INCREASE
		CASE IS <= 200
			PRINTFORMW Unfortunately, your awkward attempts to approach people accomplish little.
		CASE IS <= 600
			PRINTFORMW You only manage to convince a couple of people to think about attending the concert.
		CASE IS <= 1000
			PRINTFORMW You manage to convince a decent amount of people to attend the concert.
		CASE IS <= 2000
			PRINTFORMW Thanks to your efforts, quite a few people seem to have gotten excited about the upcoming concert.
		CASEELSE
			PRINTFORML With your silver tongue, you manage to convince a great many people to attend the concert.
			PRINTFORMW This will be an event that will be remembered for months to come!
	ENDSELECT

	ADD_BANQUETS_SCALE:BANQUET_INDEX += SCALE_INCREASE
	TIME += 55
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE "依頼成功時"
	CALL CHANGE_CFLAG(2, TARGET, 50)
	CALL CHANGE_CFLAG(4, TARGET, 40)
	CALL KIGEN_CHANGE(TARGET, 50, 1)
CASE "依頼失敗時"
	CALL CHANGE_CFLAG(2, TARGET, -10)
	CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT

