;gives chance to boost foraging/fishing/cleaning/logging/gardening, depending on title rank
@Add_Apply_Fairy_Title_Bonus(TASK)
#FUNCTION
#DIMS TASK

;NAS: now uses faction rep
SIF AverageRep(MASTER,8) < 1
    RETURNF 0
SIF GROUPMATCH((CFLAG:MASTER:現在位置 / 100),10,11) ;insufficient fairy presence on the moon (NAS: and makai)
    RETURNF 0
SIF RAND:100000 > AverageRep(MASTER,8)
    RETURNF 0
SIF FLAG:70
    RETURNF 0

SELECTCASE TASK
    CASE "foraging"
        PRINTFORML While you are foraging, a number of fairies join in.
        PRINTFORML Together, you end up having a much easier time.
        RETURNF (AverageRep(MASTER,8)/10000) * 2
    CASE "fishing"
        PRINTFORML While you are fishing, a handful of fairies join in.
        PRINTFORML Their presence stimulates the waters, making the fish easier to catch.
        RETURNF (AverageRep(MASTER,8)/10000)
    CASE "cleaning"
        PRINTFORML While you are cleaning, a bunch of fairies decide to join in.
        PRINTFORML They're mostly just playing around, but their help is still appreciated.
        RETURNF MAX(1, (AverageRep(MASTER,8)/10000) / 2)
    CASE "logging"
        PRINTFORML While you are working, a group of fairies start cheering you on.
        PRINTFORML Inspired by their cheers, you find the work to be easier than usual.
        RETURNF MAX(1, (AverageRep(MASTER,8)/10000) / 3)
    CASE "gardening"
        PRINTFORML As you work in the garden, a bunch of fairies start playing nearby.
        PRINTFORML Their presence stimulates the garden, and the plants look noticeably healthier.
        RETURNF 0 ;just a flavor message
    CASE "farming"
        PRINTFORML While you work the fields, some fairies play among the crops.
        PRINTFORML Thanks to their attunement with nature, today's tending is more successful.
        RETURNF MAX(1, TALENT:MASTER:FAIRY_FRIEND / 3)
    CASE "harvesting20"
