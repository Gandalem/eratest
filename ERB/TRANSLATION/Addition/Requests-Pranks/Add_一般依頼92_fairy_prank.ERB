;Basic procedure to add a new scenario:
;1. Add the target character to the VICTIM_WEIGHTS array in @IRAI_一般92_Select_Target, if it hasn't been added before
;2. Add the scenario id to @IRAI_一般92_Select_Scenario, with the appropriate conditions
;3. Add a function with the name @PRANK_SCENARIO_[scenario id](STATE) to Add_一般依頼92_fairy_prank_scenarios.ERB (see @PRANK_SCENARIO_clownpiece_madness for an example)
;   -The "prank" and "failure" state are mandatory and should be added to every scenario
;   -"success" and "punishment" are optional. These can be added to add specific dialogue when appropriate
;   -If the "success" and "punishment" states aren't set, dialogue for that character should be added to @IRAI_一般92_Success_Message and @IRAI_一般92_Punishment_Message, if none are present yet
;   -These functions allow dialogue to be used for multiple scenarios

@EXIST_一般依頼92
#LOCALSIZE 1
#LOCALSSIZE 1

@一般依頼92(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "依頼名"
	CALLF MAKE_STR(V_NAME, "Staking your life on a prank")
CASE "依頼内容表示"
    IF CFLAG:ARG:依頼状況 > 1
	    CALLF MAKE_STR(V_NAME, @"Go to %CALLNAME:IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:ARG:依頼内容))%'s home and pull off a great prank")
    ELSE
	    CALLF MAKE_STR(V_NAME, @"Pull off a great prank at the target's home")
    ENDIF
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"Experience in a random skill")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, @"Begin Prank On %CALLNAME:IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:ARG:依頼内容))%")
CASE "依頼内容"
	CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(IRAI_一般92_Select_Target(ARG), "prank"))
CASE "依頼サブ"
	CALLF MAKE_INT(V_NAME, 0)
CASE "依頼期限"
	CALLF MAKE_INT(V_NAME, 10)
CASE "依頼発生率"
    CALLF MAKE_INT(V_NAME, 30)
CASE "依頼発生条件"
    IF nRequestDisable:req_Pranks
    ELSE
        SIF TALENT:ARG:妖精
            CALLF MAKE_INT(V_NAME, 1)
    ENDIF
CASE "依頼受託可能条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "依頼実行可能条件"
    SIF !FLAG:70
	    CALLF MAKE_INT(V_NAME, 1)
CASE "依頼消滅条件"
	SIF nRequestDisable:req_Pranks || Add_Request_Should_Discard(ARG)
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般92(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  TARGET_ID
#DIM  PRANK_RESULT
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
TARGET_ID = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(IRAI_ID))
SELECTCASE SCENE
CASE "依頼条件表示"
CASE "依頼実行時"
    IF Add_Fairy_Prank_Evil_Shenanigans == -1
        CALL PrankTypeToggle
        PRINTW
    ENDIF

    DEBUGPRINTFORML IRAI_ID = {IRAI_ID}|CLIENT_ID = {CLIENT_ID} (%CALLNAME:CLIENT_ID%)| TARGET_ID = {TARGET_ID} (%CALLNAME:TARGET_ID%)
    Add_CULPRIT = CLIENT_ID
    Add_VICTIM = TARGET_ID
    VARSET Add_ACCOMPLICES
    Add_ACCOMPLICECOUNT = 0

    IF STRLENS(Add_Fairy_Prank_Debug_Scenario)
        SIF Add_SCENARIO == "kojo"
            CALL KOJO_MESSAGE_SEND("EVENT", 0, Add_VICTIM, 0, 0, "FAIRY_PRANK", "scenarios")
        Add_SCENARIO '= Add_Fairy_Prank_Debug_Scenario
    ELSE
        CALL KOJO_MESSAGE_SEND("EVENT", 0, Add_VICTIM, 0, 0, "FAIRY_PRANK", "scenarios")
        Add_SCENARIO '= IRAI_一般92_Select_Scenario(RESULT)
    ENDIF

    CALL IRAI_一般92_Find_Accomplices
    PRANK_RESULT = IRAI_一般92_Determine_Success()
    DEBUGPRINTFORML Prank scenario: '%Add_SCENARIO%' Result: {PRANK_RESULT}
    TIME += 25
    Add_Temp_Fairy_Prank_Resolution = -1
    SELECTCASE PRANK_RESULT
        CASE -1
            TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("failure")
            SIF !RESULT
                PRINTFORMW Error: Prank failure scenario for %Add_SCENARIO% is not implemented.
            Add_Temp_Fairy_Prank_Resolution = 1
            RETURN IRAI_CONST_RESULT("実行して失敗")
        CASE 0
            TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("prank")
            SIF !RESULT
                PRINTFORMW Error: Prank scenario for %Add_SCENARIO% is not implemented.
            PRINTW
            PRINTFORML Unfortunately, %CALLNAME:TARGET_ID% caught you running away.
            IF CLIENT_ID == 6 && !RAND:3 ;Luna is very clumsy
                PRINTFORML As you try to make your escape, you spot %CALLNAME:CLIENT_ID% falling to the ground after tripping over %SPLIT_G(@"a branch:a rock:%HIS_HER(CLIENT_ID)% own feet:nothing")%.
                PRINTFORML Do you want to go back and help %HIM_HER(CLIENT_ID)% back up?
                CALL ASK_YN
                SELECTCASE RESULT
                    CASE 0
                        IF RAND:40 < ((ABL:MASTER:戦闘能力+TALENT:MASTER:伐採Lv+TALENT:MASTER:釣りLv+TALENT:MASTER:採集Lv+TALENT:MASTER:調合Lv)/2)
                            PRINTFORML With your incredible talents, you manage to pick %CALLNAME:CLIENT_ID% up and escape before %CALLNAME:TARGET_ID% catches up to you.
                            PRINTFORML That right there is why you're the best.
                            CALL CHANGE_CFLAG(2, CLIENT_ID, 100)
                            CALL CHANGE_CFLAG(4, CLIENT_ID, 100)
                            Add_Temp_Fairy_Prank_Resolution = 4
                            Add_Fairy_Prank_Success++ ;add an extra point
                            CALL AddFame(MASTER,8,2000)
                            RETURN IRAI_CONST_RESULT("実行して成功")
                        ELSE
                            PRINTFORML %CALLNAME:CLIENT_ID% manages to flee thanks to your help, but unfortunately, you lose your own chance to escape.
                            CALL CHANGE_CFLAG(2, CLIENT_ID, 100)
                            CALL CHANGE_CFLAG(4, CLIENT_ID, 100)
                            Add_Temp_Fairy_Prank_Resolution = 5
                        ENDIF
                    CASE 1
                        PRINTFORML It's every man (and fairy) for themselves, and you leave %CALLNAME:CLIENT_ID% to %HIS_HER(CLIENT_ID)% tragic fate while you make your escape.
                        CALL CHANGE_CFLAG(2, CLIENT_ID, -5) ;she's mildly upset over being left behind, but not enough to consider it a betrayal
                        CALL CHANGE_CFLAG(4, CLIENT_ID, -2)
                        Add_Temp_Fairy_Prank_Resolution = 6
                        RETURN IRAI_CONST_RESULT("実行して成功")
                ENDSELECT
            ELSEIF ABL:MASTER:戦闘能力 > ABL:CLIENT_ID:戦闘能力
                PRINTFORML Throw %CALLNAME:CLIENT_ID% under the bus?
                CALL ASK_YN
                SELECTCASE RESULT
                CASE 0 ;i hope you enjoy your thirty pieces of silver
                    IF RAND:(ABL:MASTER:戦闘能力 - ABL:CLIENT_ID:戦闘能力 + 1)
                        PRINTFORML Deciding that your life is more valuable than %HIS_HERS(CLIENT_ID)%, you give %CALLNAME:CLIENT_ID% a powerful shove and make %HIM_HER(CLIENT_ID)% fall to the ground, giving you a means of escape.
                        PRINTFORML %HE_SHE(CLIENT_ID, 1)% sounds like %HE_SHE(CLIENT_ID)%'s pretty upset, but you consider it to be a necessary sacrifice for the greater good.
                        CALL CHANGE_CFLAG(2, CLIENT_ID, -500)
                        CALL CHANGE_CFLAG(4, CLIENT_ID, -200)
                        Add_Temp_Fairy_Prank_Resolution = 7
                    ELSE
                        PRINTFORML %CALLNAME:CLIENT_ID% sees through your attempt to throw %HIM_HER(CLIENT_ID)% to the wolves, and manages to trip you up, allowing %HIM_HER(CLIENT_ID)% to get away.
                        PRINTFORML There's no means of escape for you now.
                        CALL CHANGE_CFLAG(2, CLIENT_ID, -200)
                        CALL CHANGE_CFLAG(4, CLIENT_ID, -100)
                        Add_Temp_Fairy_Prank_Resolution = 8
                        TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("punishment")
                        SIF !RESULT
                            CALL IRAI_一般92_Punishment_Message
                    ENDIF
                    Add_Fairy_Prank_Betrayal++
                    CALL AddInfamy(MASTER,8,10000)
                    RETURN IRAI_CONST_RESULT("実行して失敗")
                CASE 1
                    IF RAND:30 < ((ABL:MASTER:戦闘能力+TALENT:MASTER:伐採Lv+TALENT:MASTER:釣りLv+TALENT:MASTER:採集Lv+TALENT:MASTER:調合Lv)/2)
                        PRINTFORML Using your many skills in creative ways, you manage to escape before %CALLNAME:TARGET_ID% catches up to you.
                        PRINTFORML You can consider this a perfectly executed operation.
                        CALL CHANGE_CFLAG(2, TARGET_ID, -20)
                        CALL CHANGE_CFLAG(4, TARGET_ID, -10)
                        CALL AddCombatInfamy(MASTER,TARGET_ID,20)
                        CALL AddCombatInfamy(CLIENT_ID,TARGET_ID,20)
                        Add_Temp_Fairy_Prank_Resolution = 2
                        RETURN IRAI_CONST_RESULT("実行して成功")
                    ENDIF
                ENDSELECT
            ENDIF
            SIF Add_Temp_Fairy_Prank_Resolution == -1 ;only set here if not set during escape
                Add_Temp_Fairy_Prank_Resolution = 3

            CALL AddCombatInfamy(MASTER,TARGET_ID,20)
            CALL AddCombatInfamy(CLIENT_ID,TARGET_ID,20)
            TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("punishment")
            SIF !RESULT
                CALL IRAI_一般92_Punishment_Message
        CASE 1
            TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("prank")
            SIF !RESULT
                PRINTFORMW Error: Prank scenario for %Add_SCENARIO% is not implemented.
            PRINTW
            TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("success")
            SIF !RESULT
                CALL IRAI_一般92_Success_Message
            PRINTW
            Add_Temp_Fairy_Prank_Resolution = 0
            TIME += 30
        CASEELSE
            PRINTFORMW Invalid result for prank. Please report. ({PRANK_RESULT})
    ENDSELECT
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE "依頼成功時"
    SIF !RAND:2
        EXP:MASTER:会話経験 += 5
    SIF !RAND:2
        EXP:MASTER:学習経験 += 5
    SIF !RAND:2
        EXP:MASTER:料理経験 += 5
    SIF !RAND:2
        EXP:MASTER:調合経験 += 5
	SOURCE:恭順 = 1500
	SOURCE:歓楽 = 1000
	CALL CHANGE_CFLAG(2, CLIENT_ID, 25)
	CALL CHANGE_CFLAG(4, CLIENT_ID, 20)
	CALL KIGEN_CHANGE(CLIENT_ID, 100, 2)
    Add_Fairy_Prank_Success++
    CALL AddFame(MASTER,8,2000)

    SELECTCASE Add_Temp_Fairy_Prank_Resolution
        CASE 0
            PRINTFORM %CALLNAME:CLIENT_ID% 
        CASE 2
            PRINTFORML %CALLNAME:CLIENT_ID% seems to be glad that both of you managed to get away.
            PRINTFORM %HE_SHE(CLIENT_ID, 1)% 
        CASE 3
            PRINTFORML %CALLNAME:CLIENT_ID% asks if you are okay, after %HE_SHE(CLIENT_ID)% lost sight of you during the escape.
            PRINTFORM %HE_SHE(CLIENT_ID, 1)% 
        CASE 4
            PRINTFORML %CALLNAME:CLIENT_ID% seems to be extremely grateful for you saving %HIM_HER(CLIENT_ID)%.
            PRINTFORM %HE_SHE(CLIENT_ID, 1)% 
        CASE 5
            PRINTFORML %BREAKENG(@"%CALLNAME:CLIENT_ID% seems to be extremely grateful for you saving %HIM_HER(CLIENT_ID)%, but also feels very guilty over leaving you behind.")%
            PRINTFORM %HE_SHE(CLIENT_ID, 1)% 
        CASE 6
            PRINTFORML %CALLNAME:CLIENT_ID% appears to be pretty upset over having been left behind, but it doesn't seem that %HE_SHE(CLIENT_ID)% blames you for it.
            PRINTFORM Regardless of what happened, %HE_SHE(CLIENT_ID)% 
    ENDSELECT

    PRINTFORM tells you how happy %HE_SHE(CLIENT_ID)% was to work on this prank with you, and 
    IF (TALENT:CLIENT_ID:恋慕 || TALENT:CLIENT_ID:思慕) && CFLAG:CLIENT_ID:溜まってる度 < 500
        PRINTFORMW gives you a gentle peck on the cheek.
    ELSEIF (CFLAG:CLIENT_ID:既成事実 & 合意_うふふ) && CFLAG:CLIENT_ID:溜まってる度 >= 500
        PRINTFORMW with a flushed look on %HIS_HER(CLIENT_ID)% face, asks if you'd like another reward.
        BASE:CLIENT_ID:ムード += 600
        CFLAG:CLIENT_ID:溜まってる度  += 300
        PALAM:CLIENT_ID:欲情 += 5000
    ELSE
        PRINTFORMW %SPLIT_G(@"gives you a high five:gives you a little applause:curtsies before you")%. 
    ENDIF
    ;CALL IRAI_一般92_Title_Progress()
CASE "依頼失敗時"
	CALL CHANGE_CFLAG(2, CLIENT_ID, -10)
	CALL CHANGE_CFLAG(4, CLIENT_ID, -5)
	CALL KIGEN_CHANGE(CLIENT_ID, 100, -1)
    SELECTCASE Add_Temp_Fairy_Prank_Resolution
        CASE 1
            PRINTFORMW %CALLNAME:CLIENT_ID% is disappointed over the prank's failure, and ends up blaming you for it.
        CASE 7
            PRINTFORMW Looks like %CALLNAME:CLIENT_ID% is extremely angry about you stabbing %HIM_HER(CLIENT_ID)% in the back.
        CASE 8
            PRINTFORMW %BREAKENG(@"Even though %HE_SHE(CLIENT_ID)% got the better of you, it looks like %CALLNAME:CLIENT_ID% is still extremely angry about your attempted betrayal.")%
    ENDSELECT

    ;CALL IRAI_一般92_Title_Progress
ENDSELECT

@IRAI_一般92_Select_Target(CULPRIT)
#FUNCTION
#DIM CULPRIT
#DIM VICTIM_WEIGHTS, キャラクタ数上限 ;potential targets and their weights

;set up defaults
VICTIM_WEIGHTS:1 = 1
VICTIM_WEIGHTS:15 = 1
VICTIM_WEIGHTS:17 = 1
VICTIM_WEIGHTS:26 = 1
VICTIM_WEIGHTS:30 = 1
VICTIM_WEIGHTS:60 = 1
VICTIM_WEIGHTS:64 = 1
VICTIM_WEIGHTS:68 = 1
VICTIM_WEIGHTS:71 = 1
VICTIM_WEIGHTS:72 = 1
VICTIM_WEIGHTS:80 = 2
VICTIM_WEIGHTS:99 = 1

CALLF IRAI_一般92_Adjust_Weights_Per_Culprit(CULPRIT, VICTIM_WEIGHTS)

;remove inaccessible characters from the list
FOR LOCAL, 1, CHARANUM - 1
    SIF CFLAG:LOCAL:出禁
        VICTIM_WEIGHTS:LOCAL = 0
    SIF VICTIM_WEIGHTS:LOCAL < 0 ;should never happen, but would fuck with ARRAY_HIT if it occurs
        THROW Victim weight for {LOCAL} is a negative value ({VICTIM_WEIGHTS:LOCAL})
NEXT

LOCAL = ARRAY_HIT(VICTIM_WEIGHTS, CHARANUM - 1)
IF LOCAL < 0
    PRINTFORML Warning: No valid targets available.
    PRINTFORML Defaulting to %CALLNAME:1%.
    ;not ideal, but shouldn't cause issues
    RETURNF 1
ENDIF
RETURNF LOCAL

@IRAI_一般92_Adjust_Weights_Per_Culprit(CULPRIT, VICTIM_WEIGHTS)
#FUNCTION
#DIM CULPRIT
#DIM REF VICTIM_WEIGHTS

;mostly targets close to their home get higher weights
SELECTCASE CULPRIT
    CASE 5
        VICTIM_WEIGHTS:1 = 3
        VICTIM_WEIGHTS:17 = 2
    CASE 6
        VICTIM_WEIGHTS:1 = 3
        VICTIM_WEIGHTS:17 = 2
    CASE 7
        VICTIM_WEIGHTS:1 = 3
        VICTIM_WEIGHTS:17 = 2
    CASE 13 ;no adjustments
    CASE 14
        VICTIM_WEIGHTS:15 = 3
    CASE 18 ;no adjustments
    CASE 19 ;no adjustments
    CASE 111
        VICTIM_WEIGHTS:99 = 5
    CASE 118
        VICTIM_WEIGHTS:68 = 0 ;doesn't start shit at home
ENDSELECT

@IRAI_一般92_Select_Scenario(CUSTOM_COUNT)
#FUNCTIONS
#DIM CUSTOM_COUNT
#DIMS VALID_SCENARIOS, 20 ;increase if needed
#DIM SCENARIO_INDEX

SCENARIO_INDEX = 0

SELECTCASE Add_CULPRIT
    CASE 5
        VALID_SCENARIOS:(SCENARIO_INDEX++) = sunny_light_bending
    CASE 14
        VALID_SCENARIOS:(SCENARIO_INDEX++) = cirno_freezing
    CASE 111
        VALID_SCENARIOS:(SCENARIO_INDEX++) = clownpiece_madness
ENDSELECT

SIF OUTROOF(CFLAG:MASTER:現在位置)
    VALID_SCENARIOS:(SCENARIO_INDEX++) = generic_pitfall

IF CUSTOM_COUNT
    FOR LOCAL, 0, RESULT ;allow adding it multiple times to keep the chance correct
        VALID_SCENARIOS:(SCENARIO_INDEX++) = kojo
    NEXT
    GOTO SKIPSCENARIOCHECK
ENDIF

SELECTCASE Add_VICTIM
    CASE 1
        SIF DAY:2 == 4
            VALID_SCENARIOS:(SCENARIO_INDEX++) = reimu_snowman
        VALID_SCENARIOS:(SCENARIO_INDEX++) = reimu_offerings
    CASE 15
        VALID_SCENARIOS:(SCENARIO_INDEX++) = sakuya_fairy_rebellion
        VALID_SCENARIOS:(SCENARIO_INDEX++) = sakuya_wine
    CASE 17
        VALID_SCENARIOS:(SCENARIO_INDEX++) = alice_doll_makeover
        VALID_SCENARIOS:(SCENARIO_INDEX++) = alice_doll_enlargement
    CASE 26
        VALID_SCENARIOS:(SCENARIO_INDEX++) = yukari_hag
        VALID_SCENARIOS:(SCENARIO_INDEX++) = yukari_wine
    CASE 30
        SIF Add_Fairy_Prank_Evil_Shenanigans
            VALID_SCENARIOS:(SCENARIO_INDEX++) = eiki_stamp_swap
        VALID_SCENARIOS:(SCENARIO_INDEX++) = eiki_trendy_hat
    CASE 60
        VALID_SCENARIOS:(SCENARIO_INDEX++) = parsee_bridge_waxing
    CASE 64
        VALID_SCENARIOS:(SCENARIO_INDEX++) = yuugi_concoction
    CASE 68
        VALID_SCENARIOS:(SCENARIO_INDEX++) = yuuka_scarecrow
    CASE 71
        IF Add_Fairy_Prank_Evil_Shenanigans
            VALID_SCENARIOS:(SCENARIO_INDEX++) = shinmyoumaru_shake
            VALID_SCENARIOS:(SCENARIO_INDEX++) = shinmyoumaru_spider
        ENDIF
        VALID_SCENARIOS:(SCENARIO_INDEX++) = shinmyoumaru_bowl
    CASE 72
        VALID_SCENARIOS:(SCENARIO_INDEX++) = eirin_chemicals
    CASE 80
        VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_ink
        VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_fairyfication
        VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_snack_theft
        SIF Add_Fairy_Prank_Evil_Shenanigans
            VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_ridicule
    CASE 99
        VALID_SCENARIOS:(SCENARIO_INDEX++) = toyohime_astronauts
ENDSELECT

$SKIPSCENARIOCHECK
SIF SCENARIO_INDEX == 0
    THROW No valid prank scenario for %CALLNAME:Add_VICTIM%

RETURNF VALID_SCENARIOS:(RAND:SCENARIO_INDEX)

@IRAI_一般92_Find_Accomplices()
#DIM NUM_TARGET
NUM_TARGET = GET_TARGETNUM()

FOR LOCAL, 1, NUM_TARGET + 1
    LOCAL:1 = TARGET:LOCAL
	SIF !SHIRAHU(LOCAL:1)
		CONTINUE
    SIF Add_VICTIM == LOCAL:1
        CONTINUE
    SIF Add_CULPRIT == LOCAL:1
        CONTINUE

    ;other fairies, Suwako, Nue, Tewi, Shinmyoumaru, Seija
    IF TALENT:(LOCAL:1):妖精 || GROUPMATCH(LOCAL:1, 33, 41, 53, 71, 97)
        PRINTFORML %CALLNAME:(LOCAL:1)% notices your scheming and decides to join in.
        Add_ACCOMPLICES:(Add_ACCOMPLICECOUNT++) = LOCAL:1
        SIF Add_ACCOMPLICECOUNT >= 3
            BREAK
    ENDIF
NEXT

@IRAI_一般92_Determine_Success()
#FUNCTION
#DIM ACCOMPLICESCORE
#DIM PRANK_RESULT
#DIM MAX_CHANCE
MAX_CHANCE = 25 + CFLAG:MASTER:今日の運勢 / 100
SELECTCASE RAND:MAX_CHANCE
    CASE 0 TO 1
        DEBUGPRINTFORML Crit fail
        RETURNF -1 ;crit fail
    CASE 2 TO 3
        DEBUGPRINTFORML Crit partial
        RETURNF 0 ;partial success
    CASE 4 TO (4+MAX_CHANCE / 15)
        DEBUGPRINTFORML Crit success
        RETURNF 1 ;crit success
    CASEELSE
        ACCOMPLICESCORE = 0
        FOR LOCAL, 0, Add_ACCOMPLICECOUNT
            SIF Add_ACCOMPLICES:LOCAL > 0
                ACCOMPLICESCORE++
        NEXT
        ;check player and fairy knowledge against victim's knowledge + combat, plus accomplices, plus random factor, plus bonus for sleeping victim
        ;possibly adjust difficulty based on prank?
        LOCAL:1 = ABL:MASTER:教養 + ABL:Add_CULPRIT:教養 + ACCOMPLICESCORE + (SHIRAHU(Add_VICTIM) != 1 ? 2 # 0) + RAND:6
        LOCAL:2 = (GetCombatAbility(Add_VICTIM) + ABL:Add_VICTIM:教養)

        DEBUGPRINTFORML Prank score: {LOCAL:1}
        DEBUGPRINTFORML Prank difficulty: {LOCAL:2}
        PRANK_RESULT = LOCAL:1 - LOCAL:2

        IF PRANK_RESULT > 0
            RETURNF 1
        ELSEIF PRANK_RESULT > -2
            RETURNF 0
        ELSE
            RETURNF -1
        ENDIF
ENDSELECT

@IRAI_一般92_Success_Message
SELECTCASE Add_VICTIM
