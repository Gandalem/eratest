			CALL Add_Forced_Cleaning(Add_VICTIM, 20)
			RETURN
		ELSEIF Add_Fairy_Prank_Evil_Shenanigans == 2 || AutoReviveCondition(MASTER)
			PRINTFORML 당신은 수술대 위에 고정되어 있고, %CALLNAME:Add_VICTIM%이 %CALLNAME:52%의 교양을 위해 당신을 세심하게 해부하고 있다.
			;PRINTFORML You revive soon afterwards, but it was still a rather painful experience.
			CALL SET_HISTORY_DEATH(MASTER,Add_VICTIM,"Surgery")
			DOWNBASE:MASTER:体力 += 400
			DOWNBASE:MASTER:気力 += 400
		ELSE
			PRINTFORML 너는 결국 %CALLNAME:Add_VICTIM%의 새로운 약들의 시험 대상이 된다.
			IF !RAND:2
				PRINTFORML 다행히 그들은 의도한 대로 작동한다.
			ELSE
				IF !RAND:2
					PRINTFORML 불행하게도 부작용이 좀 있었고, 평소보다 머리가 조금 더 많아졌다.
					PRINTFORML 그 추가적인 털을 다 밀면서 시간을 좀 잃는다. 
					TIME += 60
				ELSE
					PRINTFORML 불행하게도, %CALLNAME:72%는 수량을 잘못 계산해서 과다 복용했어...
					CALL SET_HISTORY_DEATH(MASTER,72,"OD")
				ENDIF
			ENDIF
			TIME += 180
			DOWNBASE:MASTER:体力 += 300
			DOWNBASE:MASTER:気力 += 300
		ENDIF
	CASE 80;akyuu
		IF !Add_Fairy_Prank_Evil_Shenanigans
			CALL Add_Punishment_Framework(Add_VICTIM, 10)
			SIF RESULT
				RETURN
			CALL Add_Forced_Cleaning(Add_VICTIM, 10)
			RETURN
		ENDIF
		SELECTCASE RAND:2
			CASE 0
				PRINTFORML %BREAKENG(@"당신은 \@ ABL:Add_VICTIM:Melee >= UniversalRank("S") ? %조사처리(CALLNAME:Add_VICTIM,"의")% 하인들 # %CALLNAME:Add_VICTIM% \@에게 끌려 히에다 저택 지하실로 내려간다. 그곳에서 꽁꽁 묶인 채 화려한 가발과 우스꽝스러운 모자, 사랑스러운 요정 드레스까지 갖춰 입고 %조사처리(CALLNAME:Add_VICTIM,"의")% 샌드백 신세가 된다.")%
				IF ABL:Add_VICTIM:Melee < UniversalRank("C")
					PRINTFORML %HIS_HER(Add_VICTIM, 1)%은 약한 주먹으로는 별로 아프지 않지만, 그래도 꽤 창피하다.
				ELSEIF Level_To_Rank(ABL:Add_VICTIM:Melee) < (Level_To_Rank(UniversalRank("S")) - TALENT:MASTER:痛覚)
					PRINTFORML %HE_SHE(Add_VICTIM, 1)%은(는) 그 가느다란 팔로 놀라울 정도로 강한 펀치를 날린다 %HIS_HERS(Add_VICTIM)%.
				ELSE
					PRINTFORML %HE_SHE(Add_VICTIM, 1)%은 온사람 같은 폭행을 당신의 몸에 가하며, 당신이 해왔던 모든 것을 후회하게 만든다.
				ENDIF
				CALLF BroadDamage(MASTER,"torso",ABL:Add_VICTIM:Melee * 100,6,Add_VICTIM,"fists")
				DOWNBASE:MASTER:体力 += ABL:Add_VICTIM:Melee * 100
				TIME += 120
			CASE 1
				PRINTFORML 당신은 감옥에서 몇 시간을 보내고 지나가는 사람들이 비웃기 위해 멈춰 선다.
				IF TALENT:MASTER:プライド
					PRINTFORML 그 수치심은 누군가가 상상할 수 있는 것보다 더 아프다.
					DOWNBASE:MASTER:気力 += 200
				ENDIF
				CALLF BroadDamage(MASTER,"crotch",200,2,Add_VICTIM,"pillory")
				DOWNBASE:MASTER:気力 += 200
				TIME += 180
		ENDSELECT
	CASE 99;toyohime
		CALL Add_Punishment_Framework(Add_VICTIM, 10)
		SIF RESULT
			RETURN
		SELECTCASE RAND:1
			CASE 0
				PRINTFORML 공공 광장 한복판에서, %CALLNAME:Add_VICTIM%은(는) 당신의 죄에 대한 속죄로 도게자 자세를 취하도록 강요한다.
				CALL ASK_YN("저항하다","항복")
				IF !RESULT
					PRINTFORML 중무장한 루나리안들에게 완전히 포위된 상황에서, 당신은 이것을 힘의 시험으로 삼고 저항하기 시작한다. 
					IF nRyona
						FOR (LOCAL:1), 0, 3
						CALL SpawnMobEnemy(RANDOM_CHARANUM,17)
						CALL KNIFE_FIGHT(MASTER,RANDOM_CHARANUM,1,1)
						NEXT
					ENDIF
				ELSE
					PRINTFORML 중무장한 루나리안들에게 완전히 포위된 상황에서, 당신은 복종하고 %CALLNAME:Add_VICTIM% 앞에 깊이 고개 숙이는 것 외에는 다른 선택지가 없음을 본다.
					IF TALENT:MASTER:プライド
						PRINTFORML 당신은 언젠가 반드시 대가를 치르게 될 것이라고 조용히 스스로에게 다짐한다.
						DOWNBASE:MASTER:気力 += 200
					ENDIF
					TIME += 60
				ENDIF
				;dignity -100
		ENDSELECT
	CASEELSE
		CALL Add_Punishment_Framework(Add_VICTIM, 10)
		SIF RESULT
			RETURN
		CALL Add_Forced_Cleaning(Add_VICTIM, 10)
		RETURN
ENDSELECT

