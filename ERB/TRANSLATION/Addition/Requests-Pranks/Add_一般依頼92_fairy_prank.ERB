                CFLAG:Add_VICTIM:ブチギレ = 1
        ENDSELECT
        RETURN
    CASE 71
    CASE 72
    CASE 80
        SELECTCASE RAND:3
            CASE 0
                PRINTFORML As you escape the premises, you hear a quiet sobbing in the distance.
                PRINTFORML You almost feel a little guilty.
            CASE 1
                PRINTFORML As you escape the premises, %CALLNAME:Add_VICTIM% spouts a litany of curses entirely unbefitting of such a dignified %PRINT_MALE("boy", Add_VICTIM)%.
                PRINTFORML You should probably sleep with one eye open tonight.
            CASE 2
                PRINTFORML As you escape the premises, You hear %CALLNAME:Add_VICTIM% yell something to %HIS_HER(Add_VICTIM)% servants about starting the fairy genocide, as they try to calm %HIM_HER(Add_VICTIM)% down.
                PRINTFORML That's not really your problem, though.
                FOR LOCAL, 1, CHARANUM - 1
                    IF TALENT:LOCAL:妖精
                        CALL AddInfamy(LOCAL,1,10000)
                    ENDIF
                NEXT
        ENDSELECT
        RETURN
    CASE 99
ENDSELECT
;generic
PRINTFORML You successfully escape before %CALLNAME:Add_VICTIM% realizes your involvement.

