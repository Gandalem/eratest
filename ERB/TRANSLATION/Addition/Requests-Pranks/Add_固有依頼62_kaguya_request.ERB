;if there's ever a Kaguya request created in the original, adjust the id and merge this into that, if necessary 
@固有依頼62(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE ARG % 1000
;ID101：Trial of Guts
CASE 101
    SELECTCASE O_DATA
    CASE "依頼名"
        CALLF MAKE_STR(V_NAME, "TRIAL_OF_GUTS")
    CASE "依頼内容表示"
        CALLF MAKE_STR(V_NAME, @"Travel to the Bamboo Forest of the Lost tonight and undertake Kaguya's Trial of Guts")
    CASE "依頼報酬表示"
        CALLF MAKE_STR(V_NAME, @"Courage")
    CASE "依頼実行コマンド名"
        CALLF MAKE_STR(V_NAME, @"Trial of Guts")
    CASE "依頼内容"
        CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA([[妹紅]], "討伐"))
    CASE "依頼サブ"
        CALLF MAKE_INT(V_NAME, 0)
    CASE "依頼期限"
        CALLF MAKE_INT(V_NAME, 0)
    CASE "依頼発生率"
        CALLF MAKE_INT(V_NAME, 20)
    CASE "依頼発生条件"
        SIF ABL:MASTER:戦闘能力 >= 4 && DAY:3 == 15
            CALLF MAKE_INT(V_NAME, 1)
    CASE "依頼受託可能条件"
        SIF INRANGE(TIME:0, 0, 240) || INRANGE(TIME:0, 1170, 1440)
            CALLF MAKE_INT(V_NAME, 1)
    CASE "依頼実行可能条件"
        SIF !FLAG:70
            CALLF MAKE_INT(V_NAME, 1)
    CASE "依頼消滅条件"
        SIF DAY:3 != 15
            CALLF MAKE_INT(V_NAME, 1)
	ENDSELECT
ENDSELECT

@IRAI_固有62(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  REQUEST_TARGET
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
CASE "TRIAL_OF_GUTS"
    REQUEST_TARGET = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(IRAI_ID))
	SELECTCASE SCENE
	CASE "依頼条件表示"
	CASE "依頼実行時"
        CALL SPECIAL_DANMAKU_CHALLENGE(REQUEST_TARGET, 250, 200)
        IF RESULT
            PRINTFORML You overcame Kaguya's trial of guts, and Mokou lies defeated on the ground.
            RETURN IRAI_CONST_RESULT("実行して成功")
        ELSE
            PRINTFORML Unfortunately, the trial of guts proved to be too much for you.
            PRINTFORML You slink off in disgrace.
            RETURN IRAI_CONST_RESULT("実行して失敗")
        ENDIF
	CASE "依頼成功時"
	CASE "依頼失敗時"
	ENDSELECT
ENDSELECT
