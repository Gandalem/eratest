        RETURN 1
    CASE "failure"
        PRINTFORML You wait until %CALLNAME:Add_VICTIM% enters the insect cage, before throwing a plush spider through the entrance.
        PRINTFORML A lot of loud noises can be heard from the cage, but it's not quite the reaction you expected.
        PRINTFORML You quickly look through the entrance, but all you see is cotton flying around, before feeling a tiny prick in your forehead.
        PRINTFORML It seems that %CALLNAME:Add_VICTIM% completely destroyed the spider toy in battle and accidentally hit you during %HIS_HER(Add_VICTIM)% struggle.
        CALLF BroadDamage(MASTER,"head",100,6,Add_VICTIM,"fists")
        DOWNBASE:MASTER:体力 += 10
        RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_eirin_chemicals(STATE)
#DIMS STATE
SELECTCASE STATE
    CASE "prank"
        PRINTFORML You sneak into the pharmacy, and spot some bottles filled with chemicals on the table.
        PRINTFORML As the bottles are really similar to each other, you decide to swap some labels around.
        PRINTFORML You and %CALLNAME:Add_CULPRIT% hide somewhere nearby, and watch while %CALLNAME:Add_VICTIM% enters and starts to prepare medicine.
        ;PRINTFORML %BREAKENG(@"The various chemicals erroneously mixed together end up exploding, leaving %CALLNAME:Add_VICTIM% with %SPLIT_G(@"soot on %HIS_HER(Add_VICTIM)% face:an explosion afro:a terrible smell permeating %HIM_HER(Add_VICTIM)%:slightly smouldering hair")%.")%
        PRINTFORML %BREAKENG(@"The various chemicals erroneously mixed together end up exploding, leaving %CALLNAME:Add_VICTIM% as a burning corpse...")%        
        CALL SET_HISTORY_DEATH(Add_VICTIM,Add_CULPRIT,"eirin_chemicals")
        CALLF BroadDamage(Add_VICTIM,"fullbody",1000,6,Add_VICTIM,"chemical explosion")
        CALLF BroadDamage(Add_VICTIM,"fullbody",500,1,Add_VICTIM,"chemical explosion")
        RETURN 1
    CASE "failure"
        PRINTFORML You sneak into the pharmacy, and spot some bottles filled with chemicals on the table.
        PRINTFORML As the bottles are really similar to each other, you decide to swap some labels around.
        ;PRINTFORML %BREAKENG(@"However, the overly excited %CALLNAME:Add_CULPRIT% bumps into you, making you drop some of the bottles, causing an explosion that leaves you with %SPLIT_G(@"soot on your face:an explosion afro:a terrible smell permeating your clothes:slightly smouldering hair")%.")%
        PRINTFORML %BREAKENG(@"However, the overly excited %CALLNAME:Add_CULPRIT% bumps into you, making you drop some of the bottles, causing an explosion that kills you and %CALLNAME:Add_CULPRIT%...")%
        ;PRINTFORML You decide to leave and clean yourself up.
        CALL SET_HISTORY_DEATH(Add_CULPRIT,Add_CULPRIT,"eirin_chemicals")
        CALL SET_HISTORY_DEATH(MASTER,Add_CULPRIT,"eirin_chemicals")
        CALLF BroadDamage(Add_CULPRIT,"fullbody",1000,6,Add_CULPRIT,"chemical explosion")
        CALLF BroadDamage(MASTER,"fullbody",1000,6,Add_CULPRIT,"chemical explosion")
        RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_akyuu_ink(STATE)
