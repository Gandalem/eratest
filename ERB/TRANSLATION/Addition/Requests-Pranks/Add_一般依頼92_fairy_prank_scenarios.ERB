		PRINTFORML %BREAKENG(@"%조사처리(CALLNAME:Add_VICTIM,"가")% 다시 작업하다가 병을 잘못 건드려 쓰고 있던 두루마리 위에 넘어뜨리고, 두루마리를 완전히 망쳐 버린다.")%
		RETURN 1
	CASE "failure"
		PRINTFORML 잉크병을 잡으려고 시도하자, 그것이 갑자기 폭발하여 당신과 %CALLNAME:Add_CULPRIT%를 내용물로 뒤덮었다.
		PRINTFORMW %CALLNAME:Add_VICTIM%는 두 사람이 아무 말 없이 떠나는 것을 보며 웃는다.
		CALL KIGEN_CHANGE(Add_VICTIM, 100, 1)
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_akyuu_fairyfication(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML %CALLNAME:Add_VICTIM%의 차에 약한 수면제를 넣은 후, 당신과 %CALLNAME:Add_CULPRIT%는 미리 준비해 둔 요정 의상으로 %HIM_HER(Add_VICTIM)%를 재빨리 옷을 입힌다.
		PRINTFORML %BREAKENG(@"마지막 손질로 당신은 %CALLNAME:Add_VICTIM% 앞에 거울을 세운다. 잠에서 깬 %조사처리(CALLNAME:Add_VICTIM,"는")% 새로 돋은 사랑스러운 날개와 장엄한 해바라기를 발견하고 크게 비명을 지른다.")%
		RETURN 1
	CASE "failure"
		PRINTFORML 당신은 %CALLNAME:Add_VICTIM%의 차에 경미한 수면제를 타서, 재빨리 %HIM_HER(Add_VICTIM)%와 옷 입기 놀이를 할 준비를 한다.
		PRINTFORML 불행하게도, %CALLNAME:Add_CULPRIT%가 의상을 가지러 간 사이, %CALLNAME:Add_VICTIM%이 깨어나 당신이 왜 %HIM_HER(Add_VICTIM)% 위에 서 있는지 묻는다.
		PRINTFORML 당신은 걱정하는 척하며 %HIM_HER(Add_VICTIM)%에게 %HE_SHE(Add_VICTIM)%가 갑자기 의식을 잃었다고 말하고, %HE_SHE(Add_VICTIM)%의 상태를 묻는다.
		PRINTFORML %HE_SHE(Add_VICTIM)%는 자신이 그저 조금 피곤한 것뿐이라고 말하지만, 당신의 염려에 감사하다고 한다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_akyuu_snack_theft(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 장난을 준비하던 당신은 그곳에 놓인 맛있는 푸딩을 발견한다.
		PRINTFORML 이 음식이 원래 계획보다 더 맛있을 것이라 판단한 당신과 %CALLNAME:Add_CULPRIT%는 그냥 그것을 들고 도망치기로 한다.
		RETURN 1
	CASE "failure"
		PRINTFORML 장난을 준비하는 동안, 당신은 그곳에 그냥 놓여 있는 맛있는 푸딩을 발견한다.
		PRINTFORML 이것이 원래 계획보다 더 맛있을 것이라고 판단한 당신과 %CALLNAME:Add_CULPRIT%는 그것을 훔치기로 결정한다.
		PRINTFORML 불행하게도, 푸딩을 한 입 베어 물었을 때 이미 상해 있었고, 결국 그것을 버리기로 한다.
		RETURN 1
	CASE "success"
		PRINTFORML %BREAKENG(@"당신은 무사히 달아나 조용한 곳을 찾는다. 그곳에서 \@ (Add_ACCOMPLICES:0 > 0) ? 공범들과 # %조사처리(CALLNAME:Add_CULPRIT,"와")% \@ 함께 %조사처리(CALLNAME:Add_VICTIM,"의")% 푸딩을 맛본다.")%
		PRINTFORML 맛있었다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_akyuu_ridicule(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 당신과 %CALLNAME:Add_CULPRIT%은 재빨리 대규모 요정 무리를 모았고, 그들은 즉시 %CALLNAME:Add_VICTIM%를 조롱하기 시작했다.
		PRINTFORM 그들은 %HIS_HER(Add_VICTIM)%의 멍청한 머리카락, %HIS_HER(Add_VICTIM)%의 우스꽝스러운 옷, %HIS_HER(Add_VICTIM)%의 얼굴, %HIS_HER(Add_VICTIM)%의 노파 냄새를 놀렸다.
		SIF TALENT:Add_VICTIM:処女
			PRINTFORM , %HIS_HER(Add_VICTIM)%의 처녀성
		SIF ABL:Add_VICTIM:戦闘能力 < 2
			PRINTFORM , %HIS_HER(Add_VICTIM)%의 약점
		SIF TALENT:Add_VICTIM:妊娠
			PRINTFORM , %HIS_HER(Add_VICTIM)%의 배가 불룩하다.
		SIF IsPadded(Add_VICTIM)
			PRINTFORM , %HIS_HER(Add_VICTIM)% 기저귀
		PRINTFORML 그리고 %HIS_HER(Add_VICTIM)%의 죽음은 필연적이었다.
		PRINTFORM 사방에서 괴롭힘을 당하던 %CALLNAME:Add_VICTIM%는 순식간에
		IF ABL:Add_VICTIM:42 < UniversalRank("A")
			PRINTFORML 울기 시작한다.
		ELSEIF ABL:Add_VICTIM:42 >= UniversalRank("A")
			PRINTFORML 분노로 인해 단막(弾幕)을 퍼붓는다.
			IF SHIRAHU(Add_VICTIM) && nRyona
				CALL KNIFE_FIGHT(Add_VICTIM,RANDOM_CHARANUM,1,1)
			ENDIF
		ENDIF
		PRINTFORML 이게 장난으로 치부될 수 있을지 확신은 없지만, 분명 성공했어.
		RETURN 1
	CASE "failure"
		PRINTFORML 당신과 %CALLNAME:Add_CULPRIT%는 서둘러 많은 요정 무리를 모으려고 시도한다.
		PRINTFORML 하지만 그들은 별로 흥미를 보이지 않고, %CALLNAME:Add_VICTIM%가 아무런 방해 없이 돌아다니는 동안 계속 장난을 친다.
		RETURN 1
ENDSELECT
RETURN 0

