@PRANK_SCENARIO_akyuu_fairyfication(STATE)
#DIMS STATE

SELECTCASE STATE
    CASE "prank"
        PRINTFORML After spiking %CALLNAME:Add_VICTIM%'s tea with a mild sleeping drug, you and %CALLNAME:Add_CULPRIT% quickly move to dress %HIM_HER(Add_VICTIM)% up in a fairy costume you prepared beforehand.
        PRINTFORML %BREAKENG(@"As the final touch, you place a mirror in front of %HIM_HER(Add_VICTIM)%, and when %CALLNAME:Add_VICTIM% wakes up, %HE_SHE(Add_VICTIM)% screams loudly as %HE_SHE(Add_VICTIM)% notices %HIS_HER(Add_VICTIM)% lovely new wings and magnificent sunflower.")%
