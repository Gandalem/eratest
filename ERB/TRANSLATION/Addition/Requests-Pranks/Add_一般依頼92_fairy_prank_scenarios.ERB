@PRANK_SCENARIO_akyuu_snack_theft(STATE)
#DIMS STATE

SELECTCASE STATE
    CASE "prank"
        PRINTFORML While preparing for your prank, you notice a delicious pudding just sitting there.
        PRINTFORML Figuring this will be tastier than your original plans, you and %CALLNAME:Add_CULPRIT% simply decide to abscond with it.
        RETURN 1
    CASE "failure"
        PRINTFORML While preparing for your prank, you notice a delicious pudding just sitting there.
        PRINTFORML Figuring this will be tastier than your original plans, you and %CALLNAME:Add_CULPRIT% simply decide to abscond with it.
        PRINTFORML Unfortunately, when you take a bite out of the pudding, you find that it had already spoiled, and decide to just throw it away.
        RETURN 1
    CASE "success"
        PRINTFORML %BREAKENG(@"You escape without issue, and find a quiet spot where you and \@ (Add_ACCOMPLICES:0 > 0) ? your accomplices # %CALLNAME:Add_CULPRIT% \@ can enjoy %CALLNAME:Add_VICTIM%'s pudding.")%
        PRINTFORML It was delicious.
        RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_akyuu_ridicule(STATE)
#DIMS STATE

SELECTCASE STATE
    CASE "prank"
        PRINTFORML You and %CALLNAME:Add_CULPRIT% quickly gather a large host of fairies, who promptly begin to ridicule %CALLNAME:Add_VICTIM%.
        PRINTFORM They make fun of %HIS_HER(Add_VICTIM)% dumb hair, %HIS_HER(Add_VICTIM)% silly clothes, %HIS_HER(Add_VICTIM)% face, %HIS_HER(Add_VICTIM)% old lady smell
        SIF TALENT:Add_VICTIM:処女
            PRINTFORM , %HIS_HER(Add_VICTIM)% virginity
        SIF ABL:Add_VICTIM:戦闘能力 < 2
            PRINTFORM , %HIS_HER(Add_VICTIM)% weakness
        SIF TALENT:Add_VICTIM:妊娠
            PRINTFORM , %HIS_HER(Add_VICTIM)% fat belly
        SIF IsPadded(Add_VICTIM)
            PRINTFORM , %HIS_HER(Add_VICTIM)% diapers
        PRINTFORML , and the inevitability of %HIS_HER(Add_VICTIM)% death.
        PRINTFORM Harassed from all sides, %CALLNAME:Add_VICTIM% quickly 
        IF ABL:Add_VICTIM:42 < UniversalRank("A")
            PRINTFORML starts crying.
        ELSEIF ABL:Add_VICTIM:42 >= UniversalRank("A")
            PRINTFORML launches a barrage of Danmaku in a fit of anger.
            IF SHIRAHU(Add_VICTIM) && nRyona
                CALL KNIFE_FIGHT(Add_VICTIM,RANDOM_CHARANUM,1,1)
            ENDIF
        ENDIF
        PRINTFORML You're not entirely sure if this should even count as a prank, but it sure was a success.
        RETURN 1
    CASE "failure"
        PRINTFORML You and %CALLNAME:Add_CULPRIT% quickly try to gather a large host of fairies.
        PRINTFORML However, they don't appear to be very interested, and continue playing around while %CALLNAME:Add_VICTIM% walks around unmolested.
        RETURN 1
ENDSELECT
RETURN 0

