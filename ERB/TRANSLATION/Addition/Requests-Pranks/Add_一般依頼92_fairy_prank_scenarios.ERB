@PRANK_SCENARIO_clownpiece_madness(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 불필요하게 복잡한 연출을 통해, 당신은 %CALLNAME:Add_VICTIM%이(가) %CALLNAME:Add_CULPRIT%의 횃불을 똑바로 보도록 만든다.
		PRINTFORML 뒤따르는 난동은 볼 만한 광경이다.
		IF SHIRAHU(Add_VICTIM) && nRyona
			CALL FISHER_YATES_SHAFFLE(CHARANUM)
			FOR (LOCAL:1), 0, CHARANUM
			LOCAL:2 = SHAFFLE_ARRAY:(LOCAL:1)
			SIF LOCAL:2 > CHARANUM
				CONTINUE
			SIF CFLAG:Add_VICTIM:現在位置 != CFLAG:(LOCAL:2):現在位置
				CONTINUE
			SIF Add_VICTIM == LOCAL:2
				CONTINUE
			SIF !SHIRAHU(LOCAL:2)
				CONTINUE
			SIF !SHIRAHU(Add_VICTIM)
				BREAK
			SIF TCVAR:(LOCAL:2):Grievous_Harm
				CONTINUE
			; SIF LOCAL:2 == MASTER || LOCAL:2 == Add_CULPRIT
			;     CONTINUE
			PRINTFORML %CALLNAME:Add_VICTIM%은(는) %GET_STR(Add_VICTIM, "Weapon", EQUIP:Add_VICTIM:Weapon, "FullName")%를 꺼내며 미친 듯이 행동한다...
			PRINTFORML %CALLNAME:Add_VICTIM%은(는) 그것을 %CALLNAME:(LOCAL:2)%에게 겨눈다...
			TCVAR:Add_VICTIM:InitiatedAttack = 1
			CALL KNIFE_FIGHT(Add_VICTIM,LOCAL:2,1,1)
			;CALL FACTION_ASSAIANS(Add_VICTIM,8)
			NEXT
		ELSE
			PRINTFORML %HE_SHE(Add_VICTIM, 1)%는 큰 실제 피해를 주지는 않지만 %CALLNAME:Add_VICTIM%은 %HIS_HER(Add_VICTIM)%의 존엄성을 회복하기 위해 열심히 노력해야 한다.
		ENDIF
		RETURN 1
	CASE "failure"
		PRINTFORML %CALLNAME:Add_CULPRIT%이 부주의하게 %HIS_HER(Add_CULPRIT)% 횃불을 휘두르자, 너는 그것을 정면으로 바라보게 된다.
		PRINTFORML %HE_SHE(Add_CULPRIT, 1)%이 당신이 실제 피해를 주는 것을 막아내지만, 당신은 %CALLNAME:Add_VICTIM%와 장난칠 기회를 놓친다.
		RETURN 1
		; CASE "success"
		;    RETURN 1
		; CASE "punishment"
		;    RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_sunny_light_bending(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML %BREAKENG(@"당신은 %조사처리(CALLNAME:Add_CULPRIT,"가")% 빛을 굴절시키는 능력을 능숙하게 유도해 %조사처리(CALLNAME:Add_VICTIM,"의")% 겉옷만 보이지 않게 만든다.")%
		PRINTFORML %BREAKENG(@"졸지에 속옷 차림으로 뛰어다니게 된 %조사처리(CALLNAME:Add_VICTIM,"는")% 경악한 구경꾼들의 시선을 단숨에 끈다. 자신의 꼴을 알아차린 %CALLNAME:Add_VICTIM%은(는) 황급히 보이지 않는 곳으로 달아난다.")%
		CALL 脱衣処理(Add_VICTIM, "半脱ぎ")
		RETURN 1
	CASE "failure"
		PRINTFORML %BREAKENG(@"당신은 %조사처리(CALLNAME:Add_CULPRIT,"에게")% 능력을 쓰게 해 보지만 자꾸 실수하는 바람에 %조사처리(CALLNAME:Add_VICTIM,"의")% 몸 여기저기가 나타났다 사라진다. 그러다 끝내 %CALLNAME:Add_VICTIM% 자체를 놓치고 만다.")%
		PRINTFORML 구경꾼들은 그것을 전형적인 요괴의 장난으로 치부하며 상황에 전혀 신경 쓰지 않는다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_cirno_freezing(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML %CALLNAME:Add_CULPRIT%의 능력을 이용해, 당신은 %CALLNAME:Add_VICTIM%가 소유한 여러 물건들을 얼리기로 결정한다.
		PRINTFORML 도구든; 가구든; 옷이든; 아니면 음식이라도, %HIS_HER(Add_CULPRIT)%의 빙결 광란 앞에서는 아무것도 안전하지 않다.
		PRINTFORML %BREAKENG(@"%CALLNAME:Add_VICTIM%도 새 장식을 당신만큼 사랑스러워하리라 확신한다. 하지만 점점 쌀쌀해지니 반응을 확인할 생각은 접고 자리를 뜬다.")%
		RETURN 1
	CASE "failure"
		PRINTFORML 당신은 %CALLNAME:Add_CULPRIT%에게 %CALLNAME:Add_VICTIM%의 물건들을 얼리도록 유도하지만, %HE_SHE(Add_CULPRIT)%는 금세 지쳐 떠난다.
		PRINTFORML 당신은 혼자서 더 이상 %CALLNAME:Add_VICTIM%를 놀릴 이유가 없다고 판단하고 함께 자리를 뜬다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_reimu_offerings(STATE)
#DIMS STATE
IF GROUPMATCH(STATE, "prank", "failure")
	PRINTFORML 당신과 %CALLNAME:Add_CULPRIT%는 주변에 널려 있는 나뭇잎, 금속 조각, 그리고 찾은 쓰레기로 제물 상자를 재빨리 채운다.
	PRINTFORML 당신은 그것을 거대한 동전 더미처럼 보이도록 전문가가 만든 종이죽 포장지로 전부 덮는다.
	PRINTFORML %CALLNAME:Add_CULPRIT%는 종을 울리고, 당신이 근처에 숨어 있는 사이, %CALLNAME:Add_VICTIM%가 제물 상자를 확인하러 도착한다.
	PRINTFORML %HE_SHE(Add_VICTIM,1)%은 흥분해서 비명을 지르며 돈을 잡으려 하지만 포장지를 찢는 %HE_SHE(Add_VICTIM)%를 통해 그것이 가짜라는 것을 깨닫는다.
ENDIF
SELECTCASE STATE
	CASE "prank"
		PRINTFORML %BREAKENG(@"%조사처리(CALLNAME:Add_VICTIM,"는")% 깊숙이 묻힌 무언가를 기대하며 쓰레기 더미를 뒤지지만, 찾아낸 것이라곤 실망뿐이다.")%
		RETURN 1
	CASE "failure"
		PRINTFORML %CALLNAME:Add_VICTIM%은 쓰레기 더미를 뒤지다가 고물 사이에 숨겨진 몇 개의 귀중한 동전을 발견한다.
		PRINTFORML %CALLNAME:Add_VICTIM%은(는) 쓰레기를 뒤지려 하고, 결국 쓰레기 더미 사이에 숨겨져 있던 귀중한 동전 몇 개를 찾아낸다.
		CALL KIGEN_CHANGE(Add_VICTIM, 100, 1)
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_reimu_snowman(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 당신은 창고에서 여분의 신사대 옷을 꺼내고, 당신과 %CALLNAME:Add_CULPRIT%은 재빨리 여러 개의 눈 %PRINT_MALE("men_:women", Add_VICTIM)%를 세운다.
		PRINTFORML 그들 각자는 %CALLNAME:Add_VICTIM%처럼 차려입고, 고헤이를 대신할 막대를 들었으며, 얼굴에는 화난 표정을 짓고 이상하게 커진 엉덩이를 하고 있다.
		PRINTFORML %BREAKENG(@"도착한 %조사처리(CALLNAME:Add_VICTIM,"가")% 당신의 작품을 목격하자마자 「이변」이 어쩌고 하며 소리치더니 아무 방향으로나 날아가 버린다.")%
		PRINTFORML ...결국 모든 것이 잘 될 거라고 확신한다.
		StateOfEmergency = 5
		RETURN 1
	CASE "failure"
		PRINTFORML 당신은 창고에서 여분의 신사마아이 복장을 꺼내고, 당신과 %CALLNAME:Add_CULPRIT%은 빠르게 여러 개의 눈을 세운다 %PRINT_MALE("men_:women", Add_VICTIM)%.
		PRINTFORML 불행하게도, %CALLNAME:Add_VICTIM%이 끝나기도 전에 도착하고 %HE_SHE(Add_VICTIM)%는 %HIS_HER(Add_VICTIM)%의 낡은 옷으로 무엇을 하는지 묻는다.
		PRINTFORML 당황한 당신은 %HIM_HER(Add_VICTIM)%에게 %CALLNAME:Add_CULPRIT%과 놀고 난 후에 세탁하려고 했다고 말한다.
		PRINTFORML %CALLNAME:Add_VICTIM%은 그 변명을 받아들이는 듯하지만, 당신이 옷을 돌려줄 때 %HIS_HER(Add_VICTIM)%의 옷이 티 없이 깨끗해야 한다고 말한다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_sakuya_fairy_rebellion(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 당신과 %CALLNAME:Add_CULPRIT%은 요정 메이드들을 주인의 "반란"으로 재빨리 부추긴다.
		PRINTFORML 요정 메이드들은 더 높은 임금과 자신이 더 많은 존중을 받을 자격이 있다고 소리치기 시작하며 사태를 엉망으로 만든다.
		;PRINTFORML %BREAKENG(@"As you hide in an inconspicuous spot, %CALLNAME:Add_VICTIM% arrives and quickly squashes the revolution in a predictably violent fashion, but the damage done by that time is quite extensive.")%
		PRINTFORML %BREAKENG(@"당신이 눈에 띄지 않는 곳에 숨자 %조사처리(CALLNAME:Add_VICTIM,"가")% 나타나, 예상대로 폭력적인 방식으로 혁명을 순식간에 진압한다...")%
		IF SHIRAHU(Add_VICTIM) && nRyona
			FOR (LOCAL:1), 0, 5
			CALL SpawnMobEnemy(FREE_MOB_SLOT(),33)
			CALL KNIFE_FIGHT(Add_VICTIM,FREE_MOB_SLOT(1),1,1)
			NEXT
		ENDIF
		IF SHIRAHU(Add_VICTIM)
			PRINTFORML %BREAKENG(@"%조사처리(CALLNAME:Add_VICTIM,"가")% 예상대로 폭력적인 방식으로 혁명을 순식간에 진압한다...")%
			PRINTFORML %BREAKENG(@"하지만 그때까지 발생한 피해는 상당히 광범위하다.")%
			RETURN 1
		ELSEIF !SHIRAHU(Add_VICTIM)
			PRINTFORML 혁명은 성공했고, %CALLNAME:Add_VICTIM%는 급히 끌려가서 \@ Add_Fairy_Prank_Evil_Shenanigans == 2 ? 안개 호수로 # 폴터가이스트 저택 뒤쪽에 놓인다 \@.
			IF Add_Fairy_Prank_Evil_Shenanigans == 2
				CALL SET_HISTORY_DEATH(MASTER,Add_VICTIM,"asphyxiation")
			ELSE
			ENDIF
			CFLAG:Add_VICTIM:300 = SUKIMA()
			RETURN 1
		ENDIF
	CASE "failure"
		PRINTFORML %BREAKENG(@"당신과 %조사처리(CALLNAME:Add_CULPRIT,"는")% 요정 메이드들을 선동하려 하지만, 무슨 말인지 알아듣지 못한 그들은 평소처럼 일을 계속한다.")%
		PRINTFORML 너는 %CALLNAME:Add_VICTIM%의 발소리가 들리자 재빨리 몸을 숨기기로 결정한다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_sakuya_wine(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 당신과 %CALLNAME:Add_CULPRIT%는 이색적인 술병을 찾으러 지하실로 내려간다.
		PRINTFORML 둘은 결국 괜찮은 키안티를 고르고, 아무도 눈치채기 전에 나가려고 한다.
		RETURN 1
	CASE "failure"
		PRINTFORML 당신은 문제없이 빠져나와 자신과 \@ (Add_ACCOMPLICES:0 > 0) ? 공범들 # %CALLNAME:Add_CULPRIT%가 와인을 즐길 수 있는 조용한 장소를 찾는다. \@
		PRINTFORML 그것을 입에 대자, 피가 섞여 있다는 것을 발견한다.
		IF TALENT:MASTER:吸血鬼
			PRINTFORML 맛있다!
		ELSE
			PRINTFORML 역겨워!
		ENDIF
		RETURN 1
	CASE "success"
		PRINTFORML 너는 문제없이 빠져나와, 너와 \@ (Add_ACCOMPLICES:0 > 0) ? 네 공범들 # %CALLNAME:Add_CULPRIT% \@ 이 와인을 즐길 수 있는 조용한 장소를 발견했다.
		PRINTFORML 그것은 훌륭한 빈티지였다.
		BASE:Add_VICTIM:酒気 += 500
		BASE:MASTER:酒気 += 500
		FOR LOCAL, 0, 3
		SIF Add_ACCOMPLICES:LOCAL > 0
			BASE:(Add_ACCOMPLICES:LOCAL):酒気 += 500
		NEXT
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_alice_doll_makeover(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 당신은 %CALLNAME:Add_VICTIM%의 집이 비어있음을 발견하고, 스스로 들어갈 것을 결정한다.
		PRINTFORML %BREAKENG(@"%조사처리(CALLNAME:Add_VICTIM,"의")% 인형들도 늘 입던 옷에 질렸을 거라 생각한 당신과 %조사처리(CALLNAME:Add_CULPRIT,"는")% 사랑스럽게 단장해 주기로 한다.")%
		PRINTFORML 곧 많은 인형들이 화려한 새 옷과 유행하는 헤어스타일, 대담한 메이크업으로 치장한다.
		PRINTFORML %CALLNAME:Add_VICTIM%의 발소리가 다가오는 것을 들었을 때, 당신은 재빨리 몸을 숨기기로 결정한다.
		RETURN 1
	CASE "failure"
		PRINTFORML %CALLNAME:Add_VICTIM%의 집이 비어 있는 것을 발견하고, 당신은 스스로 들어갈지 결정한다.
		PRINTFORML %CALLNAME:Add_VICTIM%의 인형들에게 화장을 해줄 준비를 하는 동안, 당신은 갑자기 다른 방에서 매우 조용한 소리를 듣는다.
		PRINTFORML 곧 그 작은 소리는 볼륨을 키우고, 당신은 그것이 다가오는 수많은 작은 발소리임을 알아챈다.
		PRINTFORML 당신은 %CALLNAME:Add_VICTIM%의 집이 비어 있는 것을 발견하고, 스스로 들어갈 것을 결정한다.
		IF nRyona
			FOR (LOCAL:1), 0, 3
			CALL SpawnMobEnemy(RANDOM_CHARANUM,36)
			CALL KNIFE_FIGHT(MASTER,RANDOM_CHARANUM,1,1)
			NEXT
		ENDIF
		;PRINTFORML Suddenly, the dolls around you start moving as well, and you decide to quickly flee through a window while you still can.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_alice_doll_enlargement(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 당신은 %CALLNAME:Add_VICTIM%의 집에 들어가 마법의 포션이 담긴 병들을 발견한다.
		IF Add_CULPRIT == 6
			PRINTFORML %CALLNAME:Add_CULPRIT%는 비틀거리다가 병들을 넘어뜨리고, 그 병들이 근처에 있던 인형들 위로 부서진다.
		ELSE
			PRINTFORML %BREAKENG(@"라벨은 없지만 %CALLNAME:Add_VICTIM%도 위험한 물건을 인형 곁에 두지는 않았을 것이다. 당신은 근처 인형 몇 개에 액체를 부어 보기로 한다.")%
		ENDIF
		PRINTFORML %BREAKENG(@"인형들이 갑자기 자라나 방 안을 거대한 꼭두각시들로 채우기 시작한다. 당신과 %조사처리(CALLNAME:Add_CULPRIT,"는")% 안에 갇히기 전에 달아난다.")%
		RETURN 1
	CASE "failure"
		PRINTFORML 당신은 %CALLNAME:Add_VICTIM%의 집으로 들어가 마법 공식이 담긴 병들을 발견하고, 즉시 인형들에게 던진다.
		PRINTFORML 방과 여러분을 감도는 약간 불쾌한 냄새 외에는 아무 일도 일어나지 않는다.
		PRINTFORML 당신은 냄새를 없애기 위해 떠나 자신과 옷을 씻기로 결정한다.
		RETURN 1
ENDSELECT
RETURN 0

@PRANK_SCENARIO_yukari_hag(STATE)
#DIMS STATE
SELECTCASE STATE
	CASE "prank"
		PRINTFORML 방 안을 엿보자, %CALLNAME:Add_VICTIM%이 조용히 낮잠을 즐기고 있는 것이 눈에 들어온다.
		PRINTFORML %BREAKENG("절호의 기회라 여긴 당신은 도구를 재빨리 펼치고, 한 번도 말한 적 없던 화장 솜씨를 발휘한다.")%
		PRINTFORML 너는 빠르게 %CALLNAME:Add_VICTIM%에게 사랑스러운 주름과 처진 피부, 약간의 변색, 그리고 완벽한 사마귀 몇 개를 더해 멋지게 꾸며준다.
		PRINTFORML %BREAKENG(@"%조사처리(CALLNAME:Add_CULPRIT,"가")% %CALLNAME:Add_VICTIM% 앞에 커다란 거울을 놓아, 눈을 뜨자마자 자신의 고귀한 몰골을 보게 한다.")%
		PRINTFORML %CALLNAME:Add_VICTIM%은 겉으로 아무런 반응을 보이지 않지만, 주변에서 조용한 울림이 느껴져 자리를 피하기로 한다.
		RETURN 1
	CASE "failure"
		PRINTFORML 당신이 방 안을 엿보니 %CALLNAME:Add_VICTIM%이 조용히 낮잠을 즐기고 있는 것을 알아차린다.
		PRINTFORML 이것을 완벽한 기회로 보고, 당신은 재빨리 앞에 화장 도구를 펼치지만, 당신이 끝내기도 전에 %CALLNAME:Add_VICTIM%이 잠에서 깬다.
