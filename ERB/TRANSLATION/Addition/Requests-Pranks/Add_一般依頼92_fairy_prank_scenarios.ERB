@PRANK_SCENARIO_clownpiece_madness(STATE)
#DIMS STATE
SELECTCASE STATE
    CASE "prank"
        PRINTFORML Through a needlessly elaborate setup, you manage to make %CALLNAME:Add_VICTIM% look directly at %CALLNAME:Add_CULPRIT%'s torch.
        PRINTFORML The ensuing rampage is quite the sight to behold.
        IF SHIRAHU(Add_VICTIM) && nRyona
            CALL FISHER_YATES_SHAFFLE(CHARANUM)
            FOR (LOCAL:1), 0, CHARANUM
                LOCAL:2 = SHAFFLE_ARRAY:(LOCAL:1)
                SIF LOCAL:2 > CHARANUM
                    CONTINUE
                SIF CFLAG:Add_VICTIM:現在位置 != CFLAG:(LOCAL:2):現在位置
                    CONTINUE
                SIF Add_VICTIM == LOCAL:2
                    CONTINUE
                SIF !SHIRAHU(LOCAL:2)
                    CONTINUE
                SIF !SHIRAHU(Add_VICTIM)
                    BREAK
                SIF TCVAR:(LOCAL:2):Grievous_Harm
                    CONTINUE
                ; SIF LOCAL:2 == MASTER || LOCAL:2 == Add_CULPRIT
                ;     CONTINUE

                PRINTFORML %CALLNAME:Add_VICTIM% acts crazy as she pulls out a %GET_STR(Add_VICTIM, "Weapon", EQUIP:Add_VICTIM:Weapon, "FullName")%...
                PRINTFORML %CALLNAME:Add_VICTIM% aims it right at %CALLNAME:(LOCAL:2)%...
                TCVAR:Add_VICTIM:InitiatedAttack = 1
                CALL KNIFE_FIGHT(Add_VICTIM,LOCAL:2,1,1)
                ;CALL FACTION_ASSAIANS(Add_VICTIM,8)
            NEXT
        ELSE
            PRINTFORML %HE_SHE(Add_VICTIM, 1)% doesn't cause too much actual damage, but %CALLNAME:Add_VICTIM% will need to work hard to recover %HIS_HER(Add_VICTIM)% dignity.
        ENDIF
        RETURN 1
    CASE "failure"
        PRINTFORML %CALLNAME:Add_CULPRIT% carelessly swings %HIS_HER(Add_CULPRIT)% torch around, and you end up looking straight at it.
        PRINTFORML %HE_SHE(Add_CULPRIT, 1)% manages to keep you from doing any real damage, but you lose your chance to mess with %CALLNAME:Add_VICTIM%.
        RETURN 1
    ; CASE "success"
    ;    RETURN 1
    ; CASE "punishment"
    ;    RETURN 1
ENDSELECT
RETURN 0

