; Modular ERB: Addition/Requests-Pranks/Add_一般依頼90_jamming_session.ERB

@EXIST_一般依頼90
#LOCALSIZE 1
#LOCALSSIZE 1

@一般依頼90(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Jamming Session")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%와 연습한다")
	CASE "依頼報酬表示"
		IF ABL:MASTER:音楽技能 > ABL:TARGET:音楽技能 ;target will not pay you if they're better than you
			CALLF MAKE_STR(V_NAME, @"%金額表示(2000)%")
		ELSE
			CALLF MAKE_STR(V_NAME, @"전문적인 지침")
		ENDIF
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, @"Practice With %CALLNAME:ARG%")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
	CASE "依頼サブ"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼期限"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼発生率"
		CALLF MAKE_INT(V_NAME, 30);fairly high weight since few people qualify
	CASE "依頼発生条件"
		IF !(ITEM:30 || ITEM:31 || ITEM:32 || ITEM:33 || ITEM:34)
		ELSEIF nRequestDisable:req_Music ;added for the disable musical instruction requests toggle
		ELSEIF TALENT:ARG:音楽知識
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "依頼受託可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼消滅条件"
		SIF nRequestDisable:req_Music || Add_Request_Should_Discard(ARG) ;added for the disable musical instruction requests toggle
			CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般90(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
	CASE "依頼実行時"
		PRINTFORMW 당신은 %조사처리(CALLNAME:TARGET,"와")% 연습하는 데 시간을 보낸다.
		PRINTFORML 
		LOCAL = MIN(ABL:MASTER:音楽技能 + ABL:TARGET:音楽技能, 12)
		TIME += 55
		TFLAG:193 = IRAI_一般90_Get_Result()
		SELECTCASE TFLAG:193
			CASE 3
				PRINTFORMW 너 충분히 주의를 기울이지 않아서, %조사처리(CALLNAME:TARGET,"가")% 너에게 꾸짖는다.
				RETURN IRAI_CONST_RESULT("実行して失敗")
			CASE 2
				PRINTFORMW 좋은 세션이었다.
				CALL IRAI_一般90_Add_Performance_Xp(MASTER, (ABL:MASTER:教養 + ABL:TARGET:教養) * 3)
				CALL IRAI_一般90_Add_Performance_Xp(TARGET, (ABL:MASTER:教養 + ABL:TARGET:教養) * 3)
			CASE 1
				PRINTFORMW 그것은 굉장한 세션이었다.
				CALL IRAI_一般90_Add_Performance_Xp(MASTER, (ABL:MASTER:教養 + ABL:TARGET:教養) * 5)
				CALL IRAI_一般90_Add_Performance_Xp(TARGET, (ABL:MASTER:教養 + ABL:TARGET:教養) * 5)
			CASE 0
				PRINTFORMW 그것은 정말 고무적인 세션이었다.
				CALL IRAI_一般90_Add_Performance_Xp(MASTER, (ABL:MASTER:教養 + ABL:TARGET:教養) * 10)
				CALL IRAI_一般90_Add_Performance_Xp(TARGET, (ABL:MASTER:教養 + ABL:TARGET:教養) * 10)
		ENDSELECT
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		SOURCE:恭順 = 1500
		SOURCE:歓楽 = 1000
		CALL CHANGE_CFLAG(2, TARGET, 25)
		CALL CHANGE_CFLAG(4, TARGET, 15)
		CALL KIGEN_CHANGE(TARGET, 100, 1)
		SIF ABL:MASTER:音楽技能 > ABL:TARGET:音楽技能 ;target will not pay you if they're better than you
			CALL GET_MONEY_YEN(2000, 2)
	CASE "依頼失敗時"
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT
;0=excellent,1=great,2=good,3=failure

@IRAI_一般90_Get_Result()
#FUNCTION
#DIM EXCELLENT_REQ
#DIM GREAT_REQ
#DIM GOOD_REQ
#DIM COMBINED_SKILL
COMBINED_SKILL = MIN(ABL:MASTER:音楽技能 + ABL:TARGET:音楽技能, 12) ;better chances of good results at higher music levels
EXCELLENT_REQ = 20 + COMBINED_SKILL / 2
GREAT_REQ = EXCELLENT_REQ + 20 + COMBINED_SKILL
GOOD_REQ = GREAT_REQ + 40 - COMBINED_SKILL / 2
SELECTCASE RAND:100
	CASE IS < EXCELLENT_REQ
		RETURNF 0
	CASE IS < GREAT_REQ
		RETURNF 1
	CASE IS < GOOD_REQ
		RETURNF 2
	CASEELSE
		RETURNF 3
ENDSELECT

@IRAI_一般90_Add_Performance_Xp(CHARA, XP)
#DIM CHARA
#DIM XP
SELECTCASE TALENT:CHARA:音楽知識
	CASE 0;highest
		IF EXP:CHARA:演奏経験 >= EXP:CHARA:歌唱経験 && EXP:CHARA:演奏経験 >= EXP:CHARA:舞踏経験
			EXP:CHARA:演奏経験 += XP
		ELSEIF EXP:CHARA:歌唱経験 >= EXP:CHARA:舞踏経験
			EXP:CHARA:歌唱経験 += XP
		ELSE
			EXP:CHARA:舞踏経験 += XP
		ENDIF
	CASE 1;music
		EXP:CHARA:演奏経験 += XP
	CASE 2;singing
		EXP:CHARA:歌唱経験 += XP
	CASE 3;dancing
		EXP:CHARA:舞踏経験 += XP
ENDSELECT
