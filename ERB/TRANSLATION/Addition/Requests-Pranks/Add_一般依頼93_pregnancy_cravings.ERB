; Modular ERB: Addition/Requests-Pranks/Add_一般依頼93_pregnancy_cravings.ERB

@EXIST_一般依頼93
#LOCALSIZE 1
#LOCALSSIZE 1

@一般依頼93(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Pregnancy Cravings")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, @"%CALLNAME:ARG%의 갈증을 채워라")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"재료 2개")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, @"Give Food To %CALLNAME:ARG%")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "food"))
	CASE "依頼サブ"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼期限"
		CALLF MAKE_INT(V_NAME, 5)
	CASE "依頼発生率"
		CALLF MAKE_INT(V_NAME, CFLAG:ARG:妊娠経過日数 / 2) ;increase weight by pregnancy stage
	CASE "依頼発生条件"
		;is pregnant and player can cook a little
		SIF ABL:MASTER:料理技能 > 0 && TALENT:ARG:妊娠
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
		;not if already carrying food
		SIF DISH_NAME == ""
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼実行可能条件"
		SIF DISH_NAME != ""
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼消滅条件"
		SIF Add_Request_Should_Discard(ARG) || !TALENT:ARG:妊娠
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼内容_USE_CUSTOM"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MEETINGPOINT_ALLOWED"
		SIF DISH_NAME != ""
			CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般93(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  REQUESTED_FOOD
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
	CASE "依頼実行時"
		REQUESTED_FOOD = IRAI_DATA:(SEARCH_IRAI_SLOT(IRAI_ID)) / 1000
		CALL FOOD_NAME(REQUESTED_FOOD)
		IF RESULTS != DISH_NAME
			PRINTFORML %CALLNAME:CLIENT_ID%은 음식을 거부하며 이것이 %HE_SHE(CLIENT_ID)%가 요청한 것이 아니라고 말했다.
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ENDIF
		PRINTFORML 당신은 %DISHNAME_TR(EX_DISH_NAME)%을 %CALLNAME:CLIENT_ID%에게 건네고, %HE_SHE(CLIENT_ID)%는 즉시 그것에 파고든다.
		CALL 食事(TARGET)
		CALL RESET_DISH
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼実行時_MEETINGPOINT"
		REQUESTED_FOOD = IRAI_DATA:(SEARCH_IRAI_SLOT(IRAI_ID)) / 1000
		CALL FOOD_NAME(REQUESTED_FOOD)
		IF RESULTS != DISH_NAME
			PRINTFORML 이것은 %CALLNAME:CLIENT_ID%가 요청한 음식이 아니었다.
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ENDIF
		REQUESTED_FOOD = IRAI_DATA:(SEARCH_IRAI_SLOT(IRAI_ID)) / 1000
		PRINTFORML 당신은 %DISHNAME_TR(DISH_NAME)%의 특수 배송을 %CALLNAME:CHARA%를 위해 준비했다.
		PRINTFORML 나중에 %HIM_HER(CHARA)%와 만나서 %HE_SHE(CHARA)%가 그것을 좋아했는지 확인해야 한다.
		CALL PAY_MONEY_YEN(500, 1)
		CALL RESET_DISH
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		IF CFLAG:TARGET:無自覚妊娠
			PRINTFORML %CALLNAME:CLIENT_ID%은(는) 당신의 도움에 대해 조금 스트레스가 풀렸다고 말하며 정중하게 감사 인사를 전했다.
		ELSEIF TALENT:TARGET:恋慕 || TALENT:TARGET:思慕
			PRINTFORML %CALLNAME:CLIENT_ID%은 음식을 대접한 것에 감사하며 당신에게 %COND_STR("wide ", TALENT:TARGET:恋慕)% 미소를 지어주었다.
		ELSE
			PRINTFORML %CALLNAME:CLIENT_ID%은 당신에게 정중하게 고개를 숙이며, %HE_SHE(CLIENT_ID)%는 당신의 아이의 어머니를 지지해 준 것에 대해 %HIS_HER(CLIENT_ID)% 감사를 표현한다.
		ENDIF
		SOURCE:恭順 = 2500
		SOURCE:歓楽 = 2000
		CALL CHANGE_CFLAG(2, TARGET, 50)
		CALL CHANGE_CFLAG(4, TARGET, 40)
		CALL KIGEN_CHANGE(TARGET, 100, 1)
		CALL GetRandMaterial(2, 5000)
	CASE "依頼失敗時"
		CALL CHANGE_CFLAG(2, TARGET, -30)
		CALL CHANGE_CFLAG(4, TARGET, -20)
ENDSELECT

@IRAI_一般_依頼内容_CUSTOM93(CHARA)
#DIM CHARA
#DIM DISH_NUM
#DIM DESIRED_DISH
CALL FISHER_YATES_SHAFFLE(400 + CHARANUM)
DESIRED_DISH = 0
FOR LOCAL, 0, 400 + CHARANUM + 1
DISH_NUM = SHAFFLE_ARRAY:LOCAL + 101
IF INRANGE(DISH_NUM, 400, 400 + CHARANUM) ;character dish, check if known
	SIF LEARNED_MENU:(DISH_NUM - 400) < 100
		CONTINUE
ENDIF
CALL DISHDATA(DISH_NUM, "", 1)
SIF !RESULT
	CONTINUE
DISH_BASEPOINT = MIN(300 + ((ABL:MASTER:料理技能 * 2 + DISH_RANK) * 20), 700)
CALL REVIEW_DISH(CHARA, DISH_TASTE) ;get food score
IF TCVAR:CHARA:料理評価値 >= 450 + 50 * ABL:MASTER:料理技能
	DESIRED_DISH = DISH_NUM
	BREAK
ENDIF
NEXT
CALL RESET_DISH
IF !DESIRED_DISH
	DESIRED_DISH = 101 ;default to Onigiri
ENDIF
RETURN MAKE_IRAI_DATA(DESIRED_DISH, "food")
;make a string containing all the requested foods so that we can show them easily in the cooking menu

@IRAI_一般_93_FOODS_IN_REQUESTS
#DIM REQUEST_ID
#DIM DISH_NUM
#DIM IRAI_NUM
#DIM CHK_SLOT
Add_Foods_Str = /
IRAI_NUM = COUNT_IRAI_SLOT()
FOR CHK_SLOT, 1, IRAI_NUM + 1
REQUEST_ID = IRAI_SLOT:CHK_SLOT % 1000
SIF !GROUPMATCH(REQUEST_ID, 18, 93)
	CONTINUE
SELECTCASE REQUEST_ID
	CASE 18
		CALL IRAI_一般18_依頼料理(IRAI_SLOT_TO_CLIENT(CHK_SLOT), CHK_SLOT)
		DISH_NUM = RESULT
	CASE 93
		DISH_NUM = IRAI_DATA:CHK_SLOT / 1000
ENDSELECT
Add_Foods_Str += @"{DISH_NUM}/"
NEXT
