@EXIST_ADD_BANQUET1
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
        CALLF MAKE_STR(V_NAME, "Reimu's spontaneous drinking party")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Drinking and chatting")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "CATEGORY"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 3)
    CASE "NOTIFY_PLAYER"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "HOST"
        CALLF MAKE_INT(V_NAME, [[霊夢]])
    CASE "HOST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[霊夢]]}/{[[る～こと]]}/{[[魔理沙]]}")
    CASE "GUEST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[萃香]]}")
    CASE "BANNED_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[正邪]]}")
    CASE "CONDITIONS"
        SIF CFLAG:1:出禁 == 0 && DAY%7 == 6 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 40
            CALLF MAKE_INT(V_NAME, 1)
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "DRINKING"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "MUSIC_PERFORMANCE"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "ALTERNATIVE_INDOOR_LOCATION"
        CALLF MAKE_INT(V_NAME, P9居間)
ENDSELECT

@ADD_BANQUET_PLANNING1
#DIM LOCATION
#DIM SCALE
#DIM START_TIME

SELECTCASE RAND:19
    CASE IS < 15
        LOCATION = P11庭
    CASE 15
        LOCATION = P2境内
    CASE 16
        LOCATION = P20本殿の裏
    CASE 17
        LOCATION = P21守矢神社分社
    CASEELSE
        LOCATION = P218小料理屋

ENDSELECT

SCALE = 1000 + RAND:1500
START_TIME = 1360 - (SCALE / 10)

CALL ADD_BANQUET_CREATE(1, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW It seems Reimu wants to host a banquet.
PRINTFORML 

CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START1

@ADD_BANQUET_FINISH1

@ADD_BANQUET_VISIT1(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(1))

@ADD_BANQUET_PROGRESS1(BANQUET_INDEX)
#DIM BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT1(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT1(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS1
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(1)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, BANQUET_SCALE > 2500 ? 12 # 7, BANQUET_SCALE > 2500 ? 12 # 7)

@ADD_BANQUET_WORKLOAD_PREPARATION1(ARG)
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(1))

@ADD_BANQUET_WORKLOAD_PARTICIPATION1(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK1
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(1))