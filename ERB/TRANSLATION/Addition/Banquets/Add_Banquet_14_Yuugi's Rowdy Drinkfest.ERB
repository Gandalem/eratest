; Modular ERB: Addition/Banquets/Add_Banquet_14_Yuugi's Rowdy Drinkfest.ERB

@EXIST_ADD_BANQUET14
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET14(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Yuugi's Rowdy Drinkfest")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Drinking and chatting")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[勇儀]])
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[勇儀]]}/{[[萃香]]}/{[[華扇]]}")
	CASE "GUEST_LIST"
		CALLF MAKE_STR(V_NAME, @"")
	CASE "BANNED_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[正邪]]}/{[[てゐ]]}") ;no notorious liars
	CASE "CONDITIONS"
		SIF CFLAG:[[勇儀]]:出禁 == 0 && DAY%7 == 4 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 20
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING14
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = P933酒場
SCALE = 500 + RAND:2500 ;unpredictable
START_TIME = CLOCK_TO_TIME(20, 0)
CALL ADD_BANQUET_CREATE(14, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
PRINTL 
PRINTFORMW 유우기가 올드 헬에서 파티를 계획하고 있는 것을 우연히 듣게 된다.
PRINTFORML 
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)
SIF !MARK:[[勇儀]]:反発刻印
	CALLF Add_SPECIAL_REQUEST_CREATION([[勇儀]], 95, 70, 1, 1)
SIF !MARK:[[萃香]]:反発刻印
	CALLF Add_SPECIAL_REQUEST_CREATION([[萃香]], 95, 70, 1, 1)
SIF !MARK:[[華扇]]:反発刻印
	CALLF Add_SPECIAL_REQUEST_CREATION([[華扇]], 95, 70, 1, 1)
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED

@ADD_BANQUET_START14

@ADD_BANQUET_FINISH14

@ADD_BANQUET_VISIT14(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(14))

@ADD_BANQUET_PROGRESS14(BANQUET_INDEX)
#DIM BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT14(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT14(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS14
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(14)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 25, BANQUET_SCALE > 2500 ? 6 # 3) ;heavily leaning towards underground dwellers

@ADD_BANQUET_WORKLOAD_PREPARATION14(ARG)
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(14))

@ADD_BANQUET_WORKLOAD_PARTICIPATION14(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK14
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(14))
