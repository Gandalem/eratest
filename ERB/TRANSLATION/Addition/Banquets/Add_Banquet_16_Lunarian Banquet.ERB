; Modular ERB: Addition/Banquets/Add_Banquet_16_Lunarian Banquet.ERB

@EXIST_ADD_BANQUET16
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET16(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Lunarian Banquet")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Drinking and chatting")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[豊姫]])
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[豊姫]]}/{[[依姫]]}")
	CASE "GUEST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[サグメ]]}")
	CASE "BANNED_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[正邪]]}")
	CASE "CONDITIONS"
		SIF CFLAG:[[豊姫]]:出禁 == 0 && DAY%7 == 6 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 10
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING16
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = P1035中庭
SCALE = 1500 + RAND:1500 ;relatively small event
START_TIME = CLOCK_TO_TIME(14, 0)
CALL ADD_BANQUET_CREATE(16, LOCATION, START_TIME, DAY+3, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
IF TALENT:[[豊姫]]:恋慕 || TALENT:[[依姫]]:恋慕 || TALENT:[[サグメ]]:恋慕
	ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
	PRINTL 
	PRINTFORMW 당신은 다가오는 루나리안 연회에 초대되었습니다.
	PRINTFORML 
	CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)
ENDIF
SIF !MARK:[[豊姫]]:反発刻印
	CALLF Add_SPECIAL_REQUEST_CREATION([[豊姫]], 95, 50, 1, 1)
SIF !MARK:[[依姫]]:反発刻印
	CALLF Add_SPECIAL_REQUEST_CREATION([[依姫]], 95, 50, 1, 1)

@ADD_BANQUET_START16

@ADD_BANQUET_FINISH16

@ADD_BANQUET_VISIT16(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(16))

@ADD_BANQUET_PROGRESS16(BANQUET_INDEX)
#DIM BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT16(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT16(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS16
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(16)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK16(ARG)
#DIM BANQUET_SCALE
#DIM VenueMap
#DIM LOCATION
BANQUET_SCALE = ADD_BANQUETS_SCALE:ADD_BANQUET_INDEX(16)
LOCATION = ADD_BANQUETS_LOCATION:ADD_BANQUET_INDEX(16)
VenueMap = GET_MAPID(LOCATION)
IF GROUPMATCH(ARG, [[クラウンピース]], [[純狐]], [[ヘカーティア]])
	RETURN 0
ELSEIF GET_MAPID(CFLAG:ARG:自宅位置) == VenueMap
	RETURN RAND:100 < 50
ELSEIF GROUPMATCH(ARG, [[永琳]], [[輝夜]], [[鈴仙]]) ;rarely
	RETURN RAND:100 < 10
ENDIF
RETURN 0

@ADD_BANQUET_WORKLOAD_PREPARATION16(ARG)
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(16))

@ADD_BANQUET_WORKLOAD_PARTICIPATION16(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK16
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(16))
