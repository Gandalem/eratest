; Modular ERB: Addition/Banquets/Add_Banquet_20_Gensokyo Book Club Meeting.ERB

@EXIST_ADD_BANQUET20
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET20(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Gensokyo Book Club Meeting")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "reading books")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "book club")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "club")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "HOST"
		CALLF MAKE_STR(V_NAME, @"{[[パチュリー]]}")
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[パチュリー]]}/{[[小悪魔]]}")
	CASE "GUEST_LIST"
		;fixed group
		CALLF MAKE_STR(V_NAME, @"{[[ルナ]]}/{[[さとり]]}/{[[小鈴]]}/{[[阿求]]}/{[[朱鷺子]]}")
	CASE "BANNED_LIST" ;unnecessary, as the group is fixed
	CASE "CONDITIONS"
		;happens every month
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING20
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
#DIM START_DAY
LOCATION = P310図書館
SCALE = 1
START_TIME = CLOCK_TO_TIME(10, 0)
;always held on the first wednesday of the month
LOCAL = ADD_BANQUET_NEXT_MONTHLY_DAY(3, 0)
IF LOCAL < 0
	DEBUGPRINTFORML 연회 20에 대한 ADD_BANQUET_NEXT_MONTHLY_DAY의 값이 유효하지 않음. DAY+1로 설정함.
	LOCAL = DAY + 1
ENDIF
CALL ADD_BANQUET_CREATE(20, LOCATION, START_TIME, LOCAL, 480, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
IF ABL:MASTER:教養 >= 3 && CFLAG:[[パチュリー]]:好感度 >= 1000 && !MARK:[[パチュリー]]:反発刻印
	ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
	PRINTL  
	PRINTFORMW 파츄리가 다음 북클럽 모임에 대해 알려준다.
	PRINTFORML 
	PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
ENDIF

@ADD_BANQUET_START20

@ADD_BANQUET_FINISH20

@ADD_BANQUET_VISIT20(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
#DIM BANQUET_INDEX
#DIM CURRENT_STATE
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(20)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX
IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
	PRINTFORML 
	PRINTFORML 독서 클럽 회원들이 자리에 앉아 읽기 시작한다.
	PRINTFORML 
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
	PRINTL  
	PRINTDW 독서 클럽의 모든 사람들은 이미 시작했다.
	PRINTL  
ENDIF

@ADD_BANQUET_PROGRESS20(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM BANQUET_ID
#DIM PRESENT
#DIM LAPSE
BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)
SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
	CASE ADD_BANQUET_STATE_IN_PROGRESS
		FOR LOCAL, 1, CHARANUM
		IF CFLAG:LOCAL:BANQUET == BANQUET_ID
			IF CFLAG:LOCAL:行動 == 5
				BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
				SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
					CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
				IF PRESENT
					IF TALENT:LOCAL:恋慕
						PRINTFORMDL %CALLNAME:LOCAL%은(는) 당신을 가끔 곁눈질하며 %HIS_HER(LOCAL)%의 책을 즐긴다.
					ELSE
						PRINTFORMDL %CALLNAME:LOCAL%은(는) %HIS_HER(LOCAL)%의 책을 즐긴다.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		NEXT
	CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT20(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION

@ADD_BANQUET_JOIN_TEXT20(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORMDL %CALLNAME:CHARA%가 도서관에 도착한다.
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORMDL %CALLNAME:CHARA%는 북클럽 모임을 위해 %NAME_FROM_PLACE_THE(LOCATION)%로 이동한다.
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS20
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(20)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK20(ARG)
RETURN 0

@ADD_BANQUET_WORKLOAD_PREPARATION20(ARG)
#DIM SCALE
#DIM BANQUET_INDEX
#DIM WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(20)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10
IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
	TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION20(ARG, SCALE)
#DIM SCALE
#DIM DURATION
DURATION = ADD_BANQUETS_DURATION:ADD_BANQUET_INDEX(20)
IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = RAND(DURATION * 10 / 2, DURATION * 10) ;members can leave early or stay around for the full duration, but stay at least for half the time
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
	TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK20
#DIM BANQUET_INDEX
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(20)
PRINTFORMDL 모두 조용히 읽고 있었다.
