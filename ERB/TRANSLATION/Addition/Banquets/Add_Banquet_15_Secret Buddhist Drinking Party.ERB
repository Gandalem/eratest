@EXIST_ADD_BANQUET15
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET15(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
    CASE "NAME"
        CALLF MAKE_STR(V_NAME, "Secret Buddhist Drinking Party")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Drinking and chatting")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "CATEGORY"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 3)
    CASE "HOST"
        CALLF MAKE_INT(V_NAME, [[一輪]])
    CASE "HOST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[一輪]]}/{[[ムラサ]]}/{[[響子]]}")
    CASE "GUEST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[ナズーリン]]}/{[[ぬえ]]}/{[[マミゾウ]]}/{[[星]]}") ;everyone who isn't byakuren
    CASE "BANNED_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[白蓮]]}") ;pretty much irrelevant, but feels appropriate
    CASE "CONDITIONS"
        SIF CFLAG:[[一輪]]:出禁 == 0 && !(DAY:2 == 4 && DAY:3 > 25) && !RAND:60
            CALLF MAKE_INT(V_NAME, 1)
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "DRINKING"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "MUSIC_PERFORMANCE"
        CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING15
#DIM LOCATION
#DIM SCALE
#DIM START_TIME

LOCATION = P121墓地

SCALE = 2500
START_TIME = CLOCK_TO_TIME(18, 0)

CALL ADD_BANQUET_CREATE(15, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

;never invited, must stumble upon it in the wild

@ADD_BANQUET_START15

@ADD_BANQUET_FINISH15

@ADD_BANQUET_VISIT15(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
;invited if found and not disliked
IF !MARK:[[一輪]]:反発刻印
    PRINTFORMDL You find the Myouren Temple trainees eating meat and drinking alcohol.
    PRINTFORMDL Thinking quickly, Ichirin tells you you're allowed to join them as long as you keep quiet to Byakuren.
    ADD_BANQUETS_INVITED:ADD_BANQUET_INDEX(15) = ADD_BANQUET_INVITE_INVITED
ENDIF

CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(15))

@ADD_BANQUET_PROGRESS15(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM PRESENT
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)
LOCATION = GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
;byakuren appears
IF CFLAG:[[白蓮]]:現在位置 == LOCATION
    IF CFLAG:[[白蓮]]:同行 ;bringing byakuren to the party
        PRINTFORMDL As you enter %NAME_FROM_PLACE_THE(LOCATION)%, you see the Myouren Temple trainees sitting around, eating meat and drinking alcohol.
        PRINTFORMDW Byakuren whallops all of them in quick succession, putting an end to their little party. 
    ELSEIF TALENT:[[ぬえ]]:恋慕 && BASE:[[ぬえ]]:酒気 < (MAXBASE:[[ぬえ]]:酒気 / 10) * 8
        CALL SET_KOJO_COLOR([[ぬえ]])
        PRINTFORMW 「Hey %MASTER_NAME([[ぬえ]])%, can you come with me for a bit?」
        PRINTFORMDL Before you can say anything in response, Nue grabs you by the arm and drags you away from the party.
        PRINTFORMDW As the two of you move away, you hear a loud noise coming from behind, as if someone has just been violently attacked, and you start running faster.
        PRINTFORML 「Ku-ku-ku... Looks like we got away just in time. Aren't you glad to be friends with this Nue-sama?」
        PRINTFORMW 「Hijiri should calm down in a little while, but it's better to avoid her for now.」
        RESETCOLOR
        CALL GETOUT(MASTER)
        CFLAG:[[ぬえ]]:現在位置 = CFLAG:MASTER:現在位置
		CALL TARGETSET_CHACK
    ELSEIF TALENT:[[マミゾウ]]:恋慕 && BASE:[[マミゾウ]]:酒気 < (MAXBASE:[[マミゾウ]]:酒気 / 10) * 8
        CALL SET_KOJO_COLOR([[マミゾウ]])
        PRINTFORMW 「Well, I think you've had enough for the day, %MASTER_NAME([[マミゾウ]])%.」
        PRINTFORMDL You don't feel like leaving yet, though, but Mamizou is very insistent that you leave right this instant.
        PRINTFORML 「Come on now. Ya gotta know your limits. That goes for humans as well as us youkai.」
        PRINTFORMDL As Mamizou pulls you up, the two of you quickly leave the party.
        PRINTFORMDL You hear a loud noise coming from behind, as if someone has just been violently attacked, but Mamizou tells you to pay it no mind.
        PRINTFORMW 「Hmm? Ya think we should check up on them? There's no need to worry about those girls. They can handle themselves just fine.」
        RESETCOLOR
        CALL GETOUT(MASTER)
        CFLAG:[[マミゾウ]]:現在位置 = CFLAG:MASTER:現在位置
		CALL TARGETSET_CHACK
    ELSEIF CFLAG:MASTER:現在位置 == LOCATION
        CALL COLORMESSAGE(@"☆Namusan!☆　", C_RED, 1, 1)
        PRINTFORMDL While enjoying the banquet, you're suddenly stuck on the back of your head with incredible force.
	    CALL RECOVER(MASTER, -MIN(MAXBASE:MASTER:体力 / 2, BASE:MASTER:体力 - 501),"体力", "Namusan'd")

        CALL PRINT_STRL, @"As you turn around, you see Byakuren, who, despite the smile on her face, appears to be very upset about finding her pupils @ITALIC@in flagrante delicto@."
        PRINTFORMDW Looks like the party's over.
    ENDIF

    FOR LOCAL, 1, CHARANUM
        IF CFLAG:LOCAL:BANQUET == 15 && CFLAG:LOCAL:現在位置 == LOCATION
            IF GROUPMATCH(LOCAL, [[ぬえ]], [[マミゾウ]]) && BASE:LOCAL:酒気 < (MAXBASE:LOCAL:酒気 / 10) * 8 ;slippery individuals
                CALL GETOUT(LOCAL)
            ELSE
                BASE:LOCAL:体力 -= 1000            
                TALENT:LOCAL:機嫌 = -1
            ENDIF
            CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
        ENDIF
    NEXT

    ADD_BANQUETS_STATUS:BANQUET_INDEX = ADD_BANQUET_STATE_CANCELLED
ENDIF

