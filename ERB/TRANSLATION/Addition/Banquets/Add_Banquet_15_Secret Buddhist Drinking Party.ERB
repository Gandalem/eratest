; Modular ERB: Addition/Banquets/Add_Banquet_15_Secret Buddhist Drinking Party.ERB

@EXIST_ADD_BANQUET15
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET15(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Secret Buddhist Drinking Party")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Drinking and chatting")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[一輪]])
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[一輪]]}/{[[ムラサ]]}/{[[響子]]}")
	CASE "GUEST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[ナズーリン]]}/{[[ぬえ]]}/{[[マミゾウ]]}/{[[星]]}") ;everyone who isn't byakuren
	CASE "BANNED_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[白蓮]]}") ;pretty much irrelevant, but feels appropriate
	CASE "CONDITIONS"
		SIF CFLAG:[[一輪]]:出禁 == 0 && !(DAY:2 == 4 && DAY:3 > 25) && !RAND:60
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING15
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = P121墓地
SCALE = 2500
START_TIME = CLOCK_TO_TIME(18, 0)
CALL ADD_BANQUET_CREATE(15, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
;never invited, must stumble upon it in the wild

@ADD_BANQUET_START15

@ADD_BANQUET_FINISH15

@ADD_BANQUET_VISIT15(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
;invited if found and not disliked
IF !MARK:[[一輪]]:反発刻印
	PRINTFORMDL 당신은 명련사 수련생들이 고기를 먹고 술을 마시는 것을 발견한다.
	PRINTFORMDL 이치린은 재빨리 생각하여, 백련에게 조용히 한다면 그들과 합류해도 된다고 말한다.
	ADD_BANQUETS_INVITED:ADD_BANQUET_INDEX(15) = ADD_BANQUET_INVITE_INVITED
ENDIF
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(15))

@ADD_BANQUET_PROGRESS15(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM PRESENT
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)
LOCATION = GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
;byakuren appears
IF CFLAG:[[白蓮]]:現在位置 == LOCATION
	IF CFLAG:[[白蓮]]:同行 ;bringing byakuren to the party
		PRINTFORMDL %NAME_FROM_PLACE_THE(LOCATION)%에 들어서자, 명련 사찰 수련생들이 모여 고기를 먹고 술을 마시는 것이 보인다.
		PRINTFORMDW 백련이 그들 모두를 연달아 강타하여 작은 파티를 끝낸다. 
	ELSEIF TALENT:[[ぬえ]]:恋慕 && BASE:[[ぬえ]]:酒気 < (MAXBASE:[[ぬえ]]:酒気 / 10) * 8
		CALL SET_KOJO_COLOR([[ぬえ]])
		PRINTFORMW 「헤이 %MASTER_NAME([[ぬえ]])%, 잠시 나랑 같이 가줄래?」
		PRINTFORMDL 응답할 말을 하기도 전에, 누에가 당신의 팔을 붙잡고 파티 장소에서 끌고 멀어진다.
		PRINTFORMDW 두 사람이 멀어지면서 뒤쪽에서 마치 누군가 폭력적으로 공격당한 것처럼 큰 소리가 들리고, 당신은 더 빨리 달리기 시작한다.
		PRINTFORML 「쿠 쿠 쿠... 우리가 제때 도망친 것 같네. 이 누에님과 친구라서 기쁘지 않아?」
		PRINTFORMW 「히지리는 곧 진정하겠지만, 지금은 그녀를 피하는 게 좋겠어.」
		RESETCOLOR
		CALL GETOUT(MASTER)
		CFLAG:[[ぬえ]]:現在位置 = CFLAG:MASTER:現在位置
		CALL TARGETSET_CHACK
	ELSEIF TALENT:[[マミゾウ]]:恋慕 && BASE:[[マミゾウ]]:酒気 < (MAXBASE:[[マミゾウ]]:酒気 / 10) * 8
		CALL SET_KOJO_COLOR([[マミゾウ]])
		PRINTFORMW 「음, 오늘 하루는 충분히 즐겼을 거라 생각해, %MASTER_NAME([[マミゾウ]])%.」
		PRINTFORMDL 아직 떠나기 싫겠지만, 마미조가 지금 당장 나가라고 아주 강력하게 주장한다.
		PRINTFORML 「자, 이제 그만해. 네 한계를 알아야지. 인간들에게도 요괴들한테도 마찬가지란다.」
		PRINTFORMDL 마미조가 당신을 일으키자, 두 사람은 서둘러 파티를 떠났다.
		PRINTFORMDL 뒤쪽에서 누군가 격렬하게 공격당한 듯 큰 소리가 들리지만, 마미조는 신경 쓰지 말라고 말한다.
		PRINTFORMW 「음? 우리가 그들을 확인해 봐야 할까? 저 여자애들에게 걱정할 필요 없어. 스스로 잘 처리할 수 있을 거야.」
		RESETCOLOR
		CALL GETOUT(MASTER)
		CFLAG:[[マミゾウ]]:現在位置 = CFLAG:MASTER:現在位置
		CALL TARGETSET_CHACK
	ELSEIF CFLAG:MASTER:現在位置 == LOCATION
		CALL COLORMESSAGE(@"나무산!　", C_RED, 1, 1)
		PRINTFORMDL 연회(banquet)를 즐기던 중, 믿을 수 없는 힘으로 갑자기 머리 뒤에 붙는다.
		CALL RECOVER(MASTER, -MIN(MAXBASE:MASTER:体力 / 2, BASE:MASTER:体力 - 501),"体力", "남산에 도착했다.")
		CALL PRINT_STRL, @"돌아보니 백련이 보였는데, 그녀는 얼굴에 미소를 띠고 있었지만 자신의 동공이 ITALIC현행범으로 발견된 것에 대해 매우 상심한 듯했다."
		PRINTFORMDW 파티는 끝난 것 같다.
	ENDIF
	FOR LOCAL, 1, CHARANUM
	IF CFLAG:LOCAL:BANQUET == 15 && CFLAG:LOCAL:現在位置 == LOCATION
		IF GROUPMATCH(LOCAL, [[ぬえ]], [[マミゾウ]]) && BASE:LOCAL:酒気 < (MAXBASE:LOCAL:酒気 / 10) * 8 ;slippery individuals
			CALL GETOUT(LOCAL)
		ELSE
			BASE:LOCAL:体力 -= 1000
			TALENT:LOCAL:機嫌 = -1
		ENDIF
		CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
	ENDIF
	NEXT
	ADD_BANQUETS_STATUS:BANQUET_INDEX = ADD_BANQUET_STATE_CANCELLED
ENDIF

