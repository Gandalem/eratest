; Modular ERB: Addition/Banquets/Add_Banquet_13_Yuukarin's Friendly Get-Together.ERB

@EXIST_ADD_BANQUET13
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET13(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Yuukarin's Friendly Get-Together")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Drinking and chatting")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[幽香]])
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[幽香]]}")
	CASE "GUEST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[美鈴]]}/{[[妖夢]]}") ;gardeners
	CASE "BANNED_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[正邪]]}/{[[映姫]]}")
	CASE "CONDITIONS"
		SIF CFLAG:[[幽香]]:出禁 == 0 && DAY%7 == 2 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 20
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING13
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = P462テラス
SCALE = 1000 + RAND:1500 ;relatively small event
START_TIME = CLOCK_TO_TIME(15, 0)
CALL ADD_BANQUET_CREATE(13, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
IF CFLAG:[[幽香]]:好感度 > 1500 || TALENT:MASTER:採集Lv >= 4 ;friend or good with plants
	ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
	PRINTL 
	PRINTFORMW 유우카가 계획 중인 작은 모임에 당신을 초대했다.
	PRINTFORML 
	CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)
ENDIF
SIF !MARK:[[幽香]]:反発刻印
	CALLF Add_SPECIAL_REQUEST_CREATION([[幽香]], 95, 80, 1, 1)

@ADD_BANQUET_START13

@ADD_BANQUET_FINISH13

@ADD_BANQUET_VISIT13(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(13))

@ADD_BANQUET_PROGRESS13(BANQUET_INDEX)
#DIM BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT13(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT13(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS13
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(13)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 15, BANQUET_SCALE > 2500 ? 10 # 5)

@ADD_BANQUET_WORKLOAD_PREPARATION13(ARG)
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(13))

@ADD_BANQUET_WORKLOAD_PARTICIPATION13(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK13
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(13))
