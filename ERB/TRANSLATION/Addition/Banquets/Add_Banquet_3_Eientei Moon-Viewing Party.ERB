; Modular ERB: Addition/Banquets/Add_Banquet_3_Eientei Moon-Viewing Party.ERB

@EXIST_ADD_BANQUET3
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET3(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "A moon-viewing party")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Drinking and chatting")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "NOTIFY_PLAYER"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[永琳]])
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[永琳]]}/{[[鈴仙]]}/{[[てゐ]]}/{[[メディスン]]}")
	CASE "GUEST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[輝夜]]}")
	CASE "BANNED_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[正邪]]}")
	CASE "CONDITIONS"
		SIF DAY:2 == 3 && DAY:3 >= 1 && DAY:3 < 15
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MOON_VIEWING"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING3
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = P409縁側
SCALE = 2000 + RAND:1000
START_TIME = 1140
CALL ADD_BANQUET_CREATE(3, LOCATION, START_TIME, DAY + (15 - DAY:3), (SCALE / 10) + 300, SCALE)
LOCAL = RESULT
SIF LOCAL < 0 ;couldn't create
	RETURN
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
IF MAIN_MAP == 4
	PRINTFORMW 당신은 에이린에게 달맞이에 초대받는다.
ELSE
	PRINTFORMW 에이텐이에게 달맞이 초대장을 받는다.
ENDIF
PRINTFORML 
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START3

@ADD_BANQUET_FINISH3

@ADD_BANQUET_VISIT3(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(3))

@ADD_BANQUET_PROGRESS3(BANQUET_INDEX)
#DIM BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT3(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT3(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS3
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(3)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 33, 9)

@ADD_BANQUET_WORKLOAD_PREPARATION3(ARG)
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(3))

@ADD_BANQUET_WORKLOAD_PARTICIPATION3(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK3
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(3))
