@EXIST_ADD_BANQUET21
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET21(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
        CALLF MAKE_STR(V_NAME, "Gensokyo Tennis Club Meeting")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Playing tennis")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "tennis club")
    CASE "CATEGORY"
        CALLF MAKE_STR(V_NAME, "sports")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 3)
    CASE "HOST"
    CASE "HOST_LIST"
    CASE "GUEST_LIST"
    CASE "BANNED_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[白蓮]]}")
    CASE "CONDITIONS"
        SIF !TENNIS_HATE
            ;happens every week
            CALLF MAKE_INT(V_NAME, 1)
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "TENNIS"
        CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING21
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
#DIM END_TIME

LOCATION = P201人里の門

SCALE = 1

;switches off between days and evenings (12:00-17:00 or 21:00-02:00)
START_TIME = DAY % 14 < 7 ? CLOCK_TO_TIME(12, 0) # CLOCK_TO_TIME(21, 0)

CALL ADD_BANQUET_CREATE(21, LOCATION, START_TIME, ADD_BANQUET_NEXT_DAY_OF_WEEK(4), 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

END_TIME = START_TIME + ADD_BANQUETS_DURATION:LOCAL
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED ;always listed in overview
ADD_BANQUET21_INVITE = 0
REPEAT 3
    LOCAL:1 = RAND_PERSON()
    SIF MARK:(LOCAL:1):反発刻印
        CONTINUE
    SIF !LOCAL:1
        CONTINUE
    SIF !ADD_BANQUET_SCHEDULE_CHECK(LOCAL:1, LOCAL)
        CONTINUE
    IF CFLAG:(LOCAL:1):好感度 > 1000
        ADD_BANQUET21_INVITE = LOCAL:1
        PRINTL  
        PRINTFORMW %CALLNAME:ADD_BANQUET21_INVITE% invites you to join %HIM_HER(ADD_BANQUET21_INVITE)% at the tennis club next time.
        PRINTFORML 

        PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
        PRINTFORMW Although it might get canceled because of the weather...
        BREAK
    ENDIF
REND

@ADD_BANQUET_START21
FOR LOCAL, 1, CHARANUM
    SIF CFLAG:LOCAL:BANQUET == 21
        CALL ADD_BANQUET_SET_OUTFIT21(LOCAL)
NEXT

@ADD_BANQUET_FINISH21
FOR LOCAL, 1, CHARANUM
    CALL ADD_BANQUET_RESET_OUTFIT21(LOCAL)
NEXT

@ADD_BANQUET_VISIT21(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
#DIM BANQUET_INDEX
#DIM CURRENT_STATE
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
    PRINTFORML 
    PRINTFORMDL The members of the tennis club quickly change into their tennis outfits and start playing. 
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
    PRINTL  
    PRINTDW The tennis club is already practicing.
ENDIF

SIF ADD_BANQUET21_INVITE && IS_HERE(ADD_BANQUET21_INVITE)
    PRINTFORMW %CALLNAME:ADD_BANQUET21_INVITE% waves at you, happy to see you here.
PRINTL  

@ADD_BANQUET_PROGRESS21(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM BANQUET_ID
#DIM PRESENT
#DIM LAPSE

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
    CASE ADD_BANQUET_STATE_IN_PROGRESS
        FOR LOCAL, 1, CHARANUM
            IF CFLAG:LOCAL:BANQUET == BANQUET_ID
                IF CFLAG:LOCAL:行動 == 5
                    BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
                    SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
                        CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
                    IF PRESENT
                        PRINTFORMDL %CALLNAME:LOCAL% has a good time at the tennis meeting.
                    ENDIF
                ENDIF
            ENDIF
        NEXT
    CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT21(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION

@ADD_BANQUET_JOIN_TEXT21(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
    PRINTFORMDL %CALLNAME:CHARA% enters the tennis court.
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
    PRINTFORMDL %CALLNAME:CHARA% enters the tennis court.
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
    PRINTFORMDL %CALLNAME:CHARA% moves over to %NAME_FROM_PLACE_THE(LOCATION)% for the tennis club meeting.
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS21
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK21(ARG)
#DIM START_TIME
START_TIME = ADD_BANQUETS_START_TIME:ADD_BANQUET_INDEX(21)

IF !ADD_BANQUET_SCHEDULE_CHECK(ARG, ADD_BANQUET_INDEX(21))
    DEBUGPRINTFORML %CALLNAME:ARG% skips tennis due to sleep schedule
    RETURN 0
ENDIF

SIF ADD_BANQUET21_INVITE == ARG ;invited player
    RETURN 1

IF START_TIME == CLOCK_TO_TIME(12, 0) ;daytime
    SIF TALENT:ARG:吸血鬼 ;no vampires
        RETURN 0
    IF GROUPMATCH(ARG, [[妖夢]], [[小鈴]], [[阿求]]) ;commonly join
        RETURN RAND:100 < 40
    ELSEIF GET_MAPID(CFLAG:ARG:初期位置) == 2 ;villagers join often
        RETURN RAND:100 < 10
    ELSEIF TALENT:ARG:妖怪 ;youkai are less likely to join if they're not villagers
        RETURN RAND:100 < 3
    ELSE ;everyone else (e.g. gods, fairies and the like)
        RETURN RAND:100 < 8
    ENDIF
ELSE ;evening
    IF GROUPMATCH(ARG, [[レミリア]], [[フラン]]) ;a refined sport for noblewomen
        RETURN RAND:100 < 40
    ELSEIF GET_MAPID(CFLAG:ARG:初期位置) == 2 ;villagers rarely join at this hour
        RETURN RAND:100 < 5
    ELSEIF TALENT:ARG:妖怪 ;youkai like to play at night
        RETURN RAND:100 < 10
    ELSE ;everyone else (e.g. gods, fairies and the like)
        RETURN RAND:100 < 3
    ENDIF
ENDIF

@ADD_BANQUET_WORKLOAD_PREPARATION21(ARG)
#DIM SCALE
#DIM BANQUET_INDEX
#DIM WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
    TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION21(ARG, SCALE)
#DIM SCALE

IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = 3000 ;stay for the full duration
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
    TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK21
#DIM BANQUET_INDEX
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
PRINTFORMDL Everyone is busily practicing or playing matches.

@ADD_BANQUET_SET_OUTFIT21(ARG)
#DIM PRESENT
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:ADD_BANQUET_INDEX(21))
IF !ADD_BANQUET21_WEARING_TENNIS_OUTFIT(ARG)
    CALL SET_EVENT_CLOTHES(ARG, OBJNAME_TO_ID(ARG, "GET", "衣装セット", "テニスウェアセット"))
    TCVAR:ARG:DRESSED_FOR_BANQUET = 21
    SIF PRESENT
        PRINTFORMDL %CALLNAME:ARG% changes into a tennis outfit.
ENDIF

@ADD_BANQUET_RESET_OUTFIT21(ARG)
IF ADD_BANQUET21_WEARING_TENNIS_OUTFIT(ARG) && TCVAR:ARG:EVENT_CLOTHING_SET
	SIF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
		PRINTFORMDL %CALLNAME:ARG% changes back into %HIS_HER(ARG)% normal clothes.
	CALL RESET_EVENT_CLOTHES(ARG)
ENDIF
TCVAR:ARG:DRESSED_FOR_BANQUET = 0

@ADD_BANQUET21_WEARING_TENNIS_OUTFIT(ARG)
#FUNCTION
RETURNF CURRENT_CLOTHES_SET(ARG) == OBJNAME_TO_ID(ARG, "GET", "衣装セット", "テニスウェアセット")
