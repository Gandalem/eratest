@EXIST_ADD_BANQUET23
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET23(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
        CALLF MAKE_STR(V_NAME, "Lunar Festival")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Pounding mochi and singing songs")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "lunar festival")
    CASE "CATEGORY"
        CALLF MAKE_STR(V_NAME, "festival")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 3)
    CASE "HOST"
        CALLF MAKE_INT(V_NAME, [[てゐ]])
    CASE "HOST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[てゐ]]}/{[[鈴仙]]}")
    CASE "GUEST_LIST"
    CASE "BANNED_LIST"
    CASE "CONDITIONS"
        ;happens every month except autumn due to eientei moon-viewing
        IF DAY:2 != 3
            SIF INRANGE(DAY:3,10,14)
                CALLF MAKE_INT(V_NAME, 1)
        ENDIF
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "ALTERNATIVE_INDOOR_LOCATION"
        CALLF MAKE_INT(V_NAME, P415広間)
ENDSELECT

@ADD_BANQUET_PLANNING23
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
#DIM END_TIME

LOCATION = P431兎の洞穴

SCALE = 2000
START_TIME = CLOCK_TO_TIME(19, 0)

CALL ADD_BANQUET_CREATE(23, LOCATION, START_TIME, DAY + 15 - DAY:3, 180, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN
;no invitation
@ADD_BANQUET_START23

@ADD_BANQUET_FINISH23
;tewi doesn't do cleanup
CFLAG:[[てゐ]]:BANQUET_ROLE = 1

@ADD_BANQUET_VISIT23(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
#DIM BANQUET_INDEX
#DIM CURRENT_STATE
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(23)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
    PRINTFORML 
    PRINTFORML The rabbits start their monthly festival.
    PRINTFORML 
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
    PRINTL  
    PRINTW The rabbits are already hard at work.
    PRINTL  
ENDIF

@ADD_BANQUET_PROGRESS23(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM BANQUET_ID
#DIM PRESENT
#DIM LAPSE
#DIM VERSE

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
    CASE ADD_BANQUET_STATE_IN_PROGRESS
        FOR LOCAL, 1, CHARANUM
            IF CFLAG:LOCAL:BANQUET == BANQUET_ID
                IF CFLAG:LOCAL:行動 == 5
                    BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
                    SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
                        CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
                ENDIF
            ENDIF
        NEXT
        IF PRESENT
            PRINTFORMDL You hear the rabbits sing as they pound mochi in perfect rhythm.
            SELECTCASE TIME % (20 + (TALENT:[[てゐ]]:恋慕 ? 10 # 0)) ;add another verse for tewi
                CASE 0 TO 9
                    VERSE = 1
                CASE 10 TO 19
                    VERSE = 2
                CASE 20 TO 29
                    VERSE = 3
            ENDSELECT

            SELECTCASE VERSE
                CASE 1
                    PRINTFORMDL 「The first strike is for Lord Daikoku～」
                    PRINTFORMDL 「The second strike is for Lord Daikoku～」
                    PRINTFORMDW 「And for all of the 180 children, we'll keep pounding mochi, ha! Let's pound mochi～」
                CASE 2
                    PRINTFORMDL 「The third strike is for Lady Kaguya～」
                    PRINTFORMDL 「The fourth strike is for Lady Eirin～」
                    PRINTFORMDW 「And for all of the eternal nobles seated on the moon, we'll keep pounding mochi, ha! Let's pound mochi～」
                CASE 3
                    PRINTFORMDL 「The fifth strike is for %CALLNAME:MASTER%～」
                    PRINTFORMDL 「The sixth strike is for %CALLNAME:MASTER%～」
                    IF CFLAG:MASTER:子供人数 == 0
                        PRINTFORMDW 「And for all of the rabbits who adore %HIM_HER(MASTER)%, we'll keep pounding mochi, ha! Let's pound mochi～」
                    ELSEIF CFLAG:MASTER:子供人数 == 1
                        PRINTFORMDW 「And for %HIS_HER(MASTER)% wonderful child, we'll keep pounding mochi, ha! Let's pound mochi～」
                    ELSE
                        PRINTFORMDW 「And for all of %HIS_HER(MASTER)% %NUM_COUNT(CFLAG:MASTER:子供人数)% children, we'll keep pounding mochi, ha! Let's pound mochi～」
                    ENDIF
            ENDSELECT
        ENDIF
    CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT23(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION

@ADD_BANQUET_JOIN_TEXT23(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
    PRINTFORML %CALLNAME:CHARA% moves over to %NAME_FROM_PLACE_THE(LOCATION)% for the monthly lunar festival.
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS23
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(23)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK23(ARG)
RETURN 0 ;fixed group

@ADD_BANQUET_WORKLOAD_PREPARATION23(ARG)
#DIM BANQUET_INDEX
#DIM WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(23)
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = WORKLOAD
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
    TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION23(ARG, SCALE)
#DIM SCALE
#DIM BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(23)

IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
    TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK23
PRINTFORMDL The rabbits are cheerily singing while pounding mochi.
