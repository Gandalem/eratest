; Modular ERB: Addition/Banquets/Add_Banquet_Performance.ERB

@Add_Banquet_Performance
#DIM CHARA
#DIM PERFORMANCE_SCORE
#DIM PERFORMANCE_LOCATION
SIF ADD_BANQUET_ALBUM_COUNT < 0
	CALLF Add_Banquet_Calculate_Albums
IF ABL:MASTER:音楽技能 < UniversalRank("B")
	PRINTL 현재 당신의 스킬 레벨을 고려하면, 여기서 공연하는 것은 좋은 생각이 아닐지도 모릅니다.
	PRINTL 정말로 계속 진행하시겠습니까?
	CALL ASK_YN
	SIF RESULT
		RETURN -1
ENDIF
PRINTL 파티를 활기차게 할 악기를 선택하라. 안 좋은 공연은 청중을 불편하게 만들 수 있음을 유의해야 한다.
TFLAG:使用楽器 = 0
CALL ASK_M( "반환", 1, ITEMNAME_TR(30), MUSIC_ABLE(30), ITEMNAME_TR(31), MUSIC_ABLE(31), ITEMNAME_TR(32), MUSIC_ABLE(32), ITEMNAME_TR(33), MUSIC_ABLE(33), ITEMNAME_TR(34), MUSIC_ABLE(34) )
TFLAG:使用楽器 = RESULT
SIF !TFLAG:使用楽器
	RETURN -1
DOWNBASE:MASTER:体力 = 300
DOWNBASE:MASTER:気力 = 300
TIME += 30
PERFORMANCE_SCORE = Add_Banquet_Performance_Score()
TFLAG:PreviousPerformances ++
PERFORMANCE_LOCATION = CFLAG:MASTER:現在位置
FOR LOCAL, 1, GET_TARGETNUM() + 1
SIF PERFORMANCE_LOCATION != CFLAG:MASTER:現在位置 ;if the player is moved from the venue, quit processing the others
	BREAK
CHARA = TARGET:LOCAL
SIF CFLAG:CHARA:現在位置 != CFLAG:MASTER:現在位置
	CONTINUE
SIF CFLAG:CHARA:行動 != 5
	CONTINUE
CALL Add_Banquet_Handle_Character(CHARA, PERFORMANCE_SCORE)
NEXT
RETURN 1

@Add_Banquet_Handle_Character(CHARA, PERFORMANCE_SCORE)
#DIM PERFORMANCE_SCORE
#DIM CHARA
#DIM REQUIREMENT
#DIM MAX_ENJOYMENT
#DIM ENJOYMENT
#DIM SCORE
#DIM JUDGMENT
REQUIREMENT = Add_Banquet_Character_Requirement(CHARA)
MAX_ENJOYMENT = Add_Banquet_Character_Enjoyment(CHARA, PERFORMANCE_SCORE)
IF MAX_ENJOYMENT <= 0
	ENJOYMENT = MAX_ENJOYMENT
ELSE
	ENJOYMENT = RAND:MAX_ENJOYMENT
ENDIF
SCORE = PERFORMANCE_SCORE - REQUIREMENT
JUDGMENT = Add_Banquet_Judgment(CHARA, SCORE, ENJOYMENT)
CALL Add_Banquet_Handle_Reward(CHARA, JUDGMENT)

@Add_Banquet_Handle_Reward(CHARA, JUDGMENT, ENJOYMENT)
#DIM CHARA
#DIM JUDGMENT
#DIM ENJOYMENT
#DIM CHARISMA_BASE
CHARISMA_BASE = MAX(ABL:CHARA:音楽技能 + 3, ABL:CHARA:戦闘能力, ABL:CHARA:教養)
SIF CHARA == [[レミリア]]
	CHARISMA_BASE *= 3
SELECTCASE JUDGMENT
	CASE ADD_BANQUET_JUDGMENT_TERRIBLE
		IF TALENT:CHARA:恋人
			PRINTFORML %CALLNAME:CHARA%은(는) %HIS_HER(CHARA)%의 연인의 끔찍한 공연에 크게 부끄러워하며 얼굴을 파묻는다.
		ELSE
			IF CHARA == [[紫]] && !RAND:20
				CALL CHARA_TEXT([[紫]], "「이건 정말 최악이다.」")
				CALL CHARA_TEXT([[紫]], "「저리 가라.」")
				PRINTFORMDL 유카리가 당신 바로 앞에 틈을 연다.
				CFLAG:MASTER:現在位置 = ADD_RANDOM_OUTDOOR_AREA()
				CFLAG:MASTER:デート中 = GET_MAPID(CFLAG:MASTER:現在位置)
				CALL COLORMESSAGE("!!! IT'S A TRAIN !!!",C_RED,2,1)
				PRINTL 
				PRINTW 기차가 당신의 얼굴을 정면으로 때리고 당신을 날려버린다...
				PRINTL 
				PRINTFORML 마침내 착륙했을 때, 당신은 자신을 %AT_IN_ON(CFLAG:MASTER:現在位置)%에서 발견한다.
				CALL RECOVER(MASTER,-(BASE:MASTER:体力 / 2),"体力", "기차")
			ELSE
				CALL SET_KOJO_COLOR(CHARA)
				PRINTFORML 「%TEXTR("조용히 해!/무대에서 내려가!/끔찍해!")%」
				RESETCOLOR
				IF nRyona
					CALL KNIFE_FIGHT(CHARA,MASTER,1,1)
				ELSE
					CALL Add_Banquet_Stone(CHARA, 2)
				ENDIF
				CALL CHANGE_CFLAG(2, CHARA, -50)
			ENDIF
		ENDIF
	CASE ADD_BANQUET_JUDGMENT_VERY_BAD
		IF TALENT:CHARA:恋人
			PRINTFORML %CALLNAME:CHARA% 파묻는다 %HIS_HER(CHARA)% 수치심에 얼굴을 파묻고 수치스러워하며 %HIS_HER(CHARA)% 연인의 형편없는 연기.
		ELSE
			CALL SET_KOJO_COLOR(CHARA)
			PRINTFORML 「%TEXTR("조용히 해!/무대에서 내려가!/끔찍해!")%」
			RESETCOLOR
			CALL Add_Banquet_Stone(CHARA, 1)
			CALL CHANGE_CFLAG(2, CHARA, -20)
		ENDIF
	CASE ADD_BANQUET_JUDGMENT_BAD
		IF TALENT:CHARA:恋人
			PRINTFORML %CALLNAME:CHARA%가 당신을 응원하려 하지만, %HE_SHE(CHARA)%는 당신의 활약에 감명받지 못한 듯하다.
		ELSE
			CALL SET_KOJO_COLOR(CHARA)
			PRINTFORML 「%TEXTR("조용히 해!/무대에서 내려가!/끔찍해!")%」
			RESETCOLOR
			PRINTFORML %CALLNAME:CHARA%가 당신에게 야유하기 시작한다.
			CALL CHANGE_CFLAG(2, CHARA, -10)
		ENDIF
	CASE ADD_BANQUET_JUDGMENT_MEH
		PRINTFORML %CALLNAME:CHARA%는 당신의 잊을 만한 공연에 만족하지 못하는 듯하다.
	CASE ADD_BANQUET_JUDGMENT_GOOD
		PRINTFORML %CALLNAME:CHARA%은(는) 당신의 공연을 꽤 즐기는 것 같다.
		IF Add_Banquet_Is_Musician(CHARA)
			CALL CHANGE_CFLAG(2, CHARA, 15)
			EXP:MASTER:演奏経験 += 2
			CHARISMA_BASE = MULTIPLY(CHARISMA_BASE, 150)
		ELSE
			CALL CHANGE_CFLAG(2, CHARA, 10)
			EXP:MASTER:演奏経験 += 1
		ENDIF
		LOCAL = RAND(1, CHARISMA_BASE+1)
		MONEY:2 += LOCAL
		PRINTFORML *카링*
		CALL COLORMESSAGE(@"{LOCAL} 카리스마의 제물이 날아온다!",C_YELLOW,1)
		CALL Add_Banquet_Handle_Reward_Item(CHARA, JUDGMENT)
		SOURCE:CHARA:歓楽 = (100 + ENJOYMENT + ((ABL:CHARA:親密 + 好感度係数(CHARA)) * 80))
		SOURCE:CHARA:欲情 = (60 + ENJOYMENT + ((ABL:CHARA:欲望 + 好感度係数(CHARA)) * 80))
	CASE ADD_BANQUET_JUDGMENT_GREAT
		PRINTFORML %CALLNAME:CHARA%는 당신의 연기에 꽤 감명받은 것 같다.
		IF Add_Banquet_Is_Musician(CHARA)
			CALL CHANGE_CFLAG(2, CHARA, 20)
			EXP:MASTER:演奏経験 += 3
			CHARISMA_BASE = MULTIPLY(CHARISMA_BASE, 150)
		ELSE
			CALL CHANGE_CFLAG(2, CHARA, 15)
			EXP:MASTER:演奏経験 += 2
		ENDIF
		SIF !RAND:2
			EXP:MASTER:演奏経験 += 1
		LOCAL = RAND(3, CHARISMA_BASE+3)
		MONEY:2 += LOCAL
		PRINTFORML 카링
		CALL COLORMESSAGE(@"{LOCAL} 카리스마의 제물이 날아온다!",C_YELLOW,1)
		CALL Add_Banquet_Handle_Reward_Item(CHARA, JUDGMENT)
		SOURCE:CHARA:歓楽 = (100 + ENJOYMENT + ((ABL:CHARA:親密 + 好感度係数(CHARA)) * 80))
		SOURCE:CHARA:欲情 = (60 + ENJOYMENT + ((ABL:CHARA:欲望 + 好感度係数(CHARA)) * 80))
		TIMES SOURCE:歓楽 , 1.50
		TIMES SOURCE:欲情 , 1.50
	CASE ADD_BANQUET_JUDGMENT_FANTASTIC
		PRINTFORML %CALLNAME:CHARA%는 당신의 공연을 보고 황홀해 보인다.
		IF Add_Banquet_Is_Musician(CHARA)
			CALL CHANGE_CFLAG(2, CHARA, 30)
			EXP:MASTER:演奏経験 += 6
			CHARISMA_BASE = MULTIPLY(CHARISMA_BASE, 150)
		ELSE
			CALL CHANGE_CFLAG(2, CHARA, 20)
			EXP:MASTER:演奏経験 += 4
		ENDIF
		LOCAL = RAND(5, CHARISMA_BASE+5)
		MONEY:2 += LOCAL
		PRINTFORML 카랑
		CALL COLORMESSAGE(@"{LOCAL} 카리스마의 제물이 날아온다!",C_YELLOW,1)
		CALL Add_Banquet_Handle_Reward_Item(CHARA, JUDGMENT)
		SOURCE:CHARA:歓楽 = (100 + ENJOYMENT + ((ABL:CHARA:親密 + 好感度係数(CHARA)) * 80))
		SOURCE:CHARA:欲情 = (60 + ENJOYMENT + ((ABL:CHARA:欲望 + 好感度係数(CHARA)) * 80))
		TIMES SOURCE:CHARA:歓楽 , 2.00
		TIMES SOURCE:CHARA:欲情 , 2.00
		BASE:CHARA:ムード += 200
		SOURCE:CHARA:液体 += 1000
		CFLAG:CHARA:溜まってる度 = MIN(CFLAG:CHARA:溜まってる度 + 150, 1000)
		SIF ((TALENT:CHARA:貞操 != 1 && TALENT:CHARA:自己愛 != -1) || TALENT:CHARA:恋慕 || TALENT:CHARA:愛欲) && EQUIP:CHARA:下半身下着２ && CFLAG:CHARA:ノーパン == 0 && CFLAG:CHARA:溜まってる度 >= 800
			CALL Add_Banquet_Panty(CHARA)
ENDSELECT

@Add_Banquet_Panty(CHARA)
#DIM CHARA
LOCALS '= PANTSNAME(EQUIP:CHARA:下半身下着２, CHARA)
CALL COLORMESSAGE(@"흥분하여 %CALLNAME:CHARA% 던진다 %HIS_HER(CHARA)% %LOCALS% 너에게 던진다! %CAPITALIZE(IT_THEY_PANTIES(LOCALS))% 편리하게 순간이동해%COND_STR("s", !PLURAL_PANTIES(LOCALS))% 당신의 컬렉션으로 바로!",C_YELLOW,1)
CALL PANTY_AWOL(CHARA, 0)
CALL PANTY_SPECIAL_GET(CHARA, EQUIP:CHARA:下半身下着２)
SIF !CFLAG:CHARA:(EQUIP:CHARA:下半身下着２ + パンツ管理)
	FLAG:700 ++
CFLAG:CHARA:(EQUIP:CHARA:下半身下着２ + パンツ管理) += 1
CFLAG:CHARA:ノーパン = 2
EQUIP:CHARA:下半身下着２ = 0

@Add_Banquet_Handle_Reward_Item(CHARA, JUDGMENT)
#DIM CHARA
#DIM JUDGMENT
#DIM CHANCE
#DIM CONST OMAKE,20 = 40,120,191,212,213,214,215,216,500,510,520,521,600,601,610,611,612,636,642,706
#DIM CHOSEN_OMAKE
SELECTCASE JUDGMENT
	CASE ADD_BANQUET_JUDGMENT_GOOD
		CHANCE = 9
	CASE ADD_BANQUET_JUDGMENT_GREAT
		CHANCE = 6
	CASE ADD_BANQUET_JUDGMENT_FANTASTIC
		CHANCE = 3
	CASEELSE
		RETURN
ENDSELECT
;maybe rework later to give better items for better judgment
IF !RAND:CHANCE
	LOCAL = 0
	DO
	SIF LOCAL++ >= 10 ;break the loop if all options are exhausted
		BREAK
	CHOSEN_OMAKE = OMAKE:(RAND:20)
	LOOP ITEM:CHOSEN_OMAKE >= 99
	IF ITEM:CHOSEN_OMAKE < 99
		CALL COLORMESSAGE(@"%CAPITALIZE(ARTICLE(ITEMNAME_TR(CHOSEN_OMAKE)))%가 날아온다!",C_YELLOW,1)
		ITEM:CHOSEN_OMAKE ++
	ENDIF
ENDIF

@Add_Banquet_Judgment(CHARA,SCORE, ENJOYMENT)
#FUNCTION
#DIM CHARA
#DIM SCORE
#DIM ENJOYMENT
#DIM JUDGMENT
SELECTCASE SCORE
	CASE IS < -30
		;instant death
		RETURNF ADD_BANQUET_JUDGMENT_TERRIBLE
	CASE IS < -25
		SELECTCASE ENJOYMENT
			CASE IS < 0
				JUDGMENT = ADD_BANQUET_JUDGMENT_TERRIBLE
			CASE IS < 10
				JUDGMENT = ADD_BANQUET_JUDGMENT_VERY_BAD
			CASE IS < 20
				JUDGMENT = ADD_BANQUET_JUDGMENT_BAD
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_MEH
		ENDSELECT
	CASE IS < -10
		SELECTCASE ENJOYMENT
			CASE IS < -10
				JUDGMENT = ADD_BANQUET_JUDGMENT_TERRIBLE
			CASE IS < 5
				JUDGMENT = ADD_BANQUET_JUDGMENT_VERY_BAD
			CASE IS < 10
				JUDGMENT = ADD_BANQUET_JUDGMENT_BAD
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_MEH
		ENDSELECT
	CASE IS < 0
		SELECTCASE ENJOYMENT
			CASE IS < -5
				JUDGMENT = ADD_BANQUET_JUDGMENT_VERY_BAD
			CASE IS < 10
				JUDGMENT = ADD_BANQUET_JUDGMENT_BAD
			CASE IS < 20
				JUDGMENT = ADD_BANQUET_JUDGMENT_MEH
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_GOOD
		ENDSELECT
	CASE IS < 20
		SELECTCASE ENJOYMENT
			CASE IS < 5
				JUDGMENT = ADD_BANQUET_JUDGMENT_BAD
			CASE IS < 15
				JUDGMENT = ADD_BANQUET_JUDGMENT_MEH
			CASE IS < 30
				JUDGMENT = ADD_BANQUET_JUDGMENT_GOOD
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_GREAT
		ENDSELECT
	CASE IS < 40
		SELECTCASE ENJOYMENT
			CASE IS < 10
				JUDGMENT = ADD_BANQUET_JUDGMENT_MEH
			CASE IS < 30
				JUDGMENT = ADD_BANQUET_JUDGMENT_GOOD
			CASE IS < 60
				JUDGMENT = ADD_BANQUET_JUDGMENT_GREAT
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_FANTASTIC
		ENDSELECT
	CASE IS < 60
		SELECTCASE ENJOYMENT
			CASE IS < 0
				JUDGMENT = ADD_BANQUET_JUDGMENT_MEH
			CASE IS < 20
				JUDGMENT = ADD_BANQUET_JUDGMENT_GOOD
			CASE IS < 50
				JUDGMENT = ADD_BANQUET_JUDGMENT_GREAT
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_FANTASTIC
		ENDSELECT
	CASEELSE
		SELECTCASE ENJOYMENT
			CASE IS < 10
				JUDGMENT = ADD_BANQUET_JUDGMENT_GOOD
			CASE IS < 40
				JUDGMENT = ADD_BANQUET_JUDGMENT_GREAT
			CASEELSE
				JUDGMENT = ADD_BANQUET_JUDGMENT_FANTASTIC
		ENDSELECT
ENDSELECT
IF BASE:CHARA:酒気 * 10 / MAXBASE:CHARA:酒気 > 8
	JUDGMENT = MAX(JUDGMENT, ADD_BANQUET_JUDGMENT_GOOD)
ELSEIF BASE:CHARA:酒気 * 10 / MAXBASE:CHARA:酒気 > 6
	JUDGMENT = MAX(JUDGMENT, ADD_BANQUET_JUDGMENT_GREAT)
ENDIF
RETURNF JUDGMENT

@Add_Banquet_Performance_Score
#FUNCTION
#DIM SCORE
SCORE = ADD_BANQUET_PERFORMANCE_BASELINE
SCORE -= TFLAG:PreviousPerformances * ADD_BANQUET_PERFORMANCE_REPEAT_PENALTY
SCORE += ABL:MASTER:音楽技能 * ADD_BANQUET_PERFORMANCE_MUSIC_SKILL_MODIFIER
SCORE += TALENT:MASTER:音楽知識 ? ADD_BANQUET_PERFORMANCE_MUSICALITY_MODIFIER # 0
SCORE += TALENT:MASTER:音感 * ADD_BANQUET_PERFORMANCE_SENSE_OF_SOUND_MODIFIER
SCORE += ADD_BANQUET_ALBUM_COUNT * ADD_BANQUET_PERFORMANCE_ALBUM_MODIFIER
SIF ITEM:演奏指南書
	SCORE += ADD_BANQUET_PERFORMANCE_BOOK_MODIFIER
DEBUGPRINTFORML 플레이어 퍼포먼스 점수: {SCORE}이다.
RETURNF SCORE

@Add_Banquet_Character_Requirement(CHARA)
#FUNCTION
#DIM CHARA
#DIM REQUIREMENT
REQUIREMENT = 0
IF Add_Banquet_Is_Musician(CHARA)
	REQUIREMENT += ABL:CHARA:音楽技能 * ADD_BANQUET_REQUIREMENT_MUSIC_MODIFIER
ELSE
	REQUIREMENT += ABL:CHARA:戦闘能力 * ADD_BANQUET_REQUIREMENT_COMBAT_MODIFIER
	REQUIREMENT += ABL:CHARA:教養 * ADD_BANQUET_REQUIREMENT_KNOWLEDGE_MODIFIER
ENDIF
REQUIREMENT -= TALENT:CHARA:恋慕 ? ADD_BANQUET_REQUIREMENT_LOVE_MODIFIER # 0
REQUIREMENT += MARK:CHARA:反発刻印 * ADD_BANQUET_REQUIREMENT_HATEMARK_MODIFIER
REQUIREMENT -= (BASE:CHARA:酒気 / 100) * ADD_BANQUET_REQUIREMENT_DRUNKENNESS_MODIFIER
DEBUGPRINTFORML %CALLNAME:CHARA%의 퍼포먼스 요구사항: {REQUIREMENT}이다.
RETURNF REQUIREMENT

@Add_Banquet_Character_Enjoyment(CHARA, PERFORMANCE_SCORE)
#FUNCTION
#DIM CHARA
#DIM PERFORMANCE_SCORE
#DIM ENJOYMENT
ENJOYMENT = PERFORMANCE_SCORE
IF Add_Banquet_Is_Musician(CHARA)
	ENJOYMENT -= (ABL:CHARA:音楽技能 * ADD_BANQUET_REQUIREMENT_MUSIC_MODIFIER) / 2
ELSE
	ENJOYMENT -= (ABL:CHARA:戦闘能力 * ADD_BANQUET_REQUIREMENT_COMBAT_MODIFIER) / 2
	ENJOYMENT -= (ABL:CHARA:教養 * ADD_BANQUET_REQUIREMENT_KNOWLEDGE_MODIFIER) / 2
ENDIF
IF TALENT:CHARA:恋人
	ENJOYMENT += ADD_BANQUET_REQUIREMENT_LOVER_MODIFIER
ELSEIF TALENT:CHARA:恋慕
	ENJOYMENT += ADD_BANQUET_REQUIREMENT_LOVE_MODIFIER
ENDIF
ENJOYMENT -= MARK:CHARA:反発刻印 * ADD_BANQUET_REQUIREMENT_HATEMARK_MODIFIER
ENJOYMENT += TALENT:CHARA:機嫌 * ADD_BANQUET_REQUIREMENT_MOOD_MODIFIER
SIF OTOKOGIRAI(CHARA)
	ENJOYMENT -= ADD_BANQUET_REQUIREMENT_GENDER_MODIFIER
ENJOYMENT += TALENT:CHARA:幼稚 * ADD_BANQUET_REQUIREMENT_CHILDLIKE_MODIFIER
DEBUGPRINTFORML %CALLNAME:CHARA%의 최대 즐거움: {ENJOYMENT}이다.
RETURNF ENJOYMENT

@Add_Banquet_Stone(ARG, WEIGHT)
#DIM WEIGHT
#DIM LISTENER_P
CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 너에게 \@ WEIGHT > 1 ? %" "%거대한 #  \@ 돌을 던진다.",C_YELLOW,1)
LISTENER_P = ABL:ARG:Shooting
IF RAND:(ABL:MASTER:Shooting * (2 + CFLAG:ARG:弾幕勝負勝利) + 1) > LISTENER_P
	CALL COLORMESSAGE(@"너는 그것을 화려하게 피했다!",C_YELLOW,1)
ELSE
	CALL RECOVER(MASTER, (LISTENER_P + 1) * (-100 * WEIGHT), "体力", @"%CALLNAME:ARG%의 \@ WEIGHT > 1 ? %" "%은 거대한 돌이다. #  \@ 돌")
	RETURN -1
ENDIF

@Add_Banquet_Calculate_Albums
#FUNCTION
ADD_BANQUET_ALBUM_COUNT = 0
FOR LOCAL, 0, 楽譜最大数/楽譜最大数（シリーズ毎）
LOCAL:1 = EXEC_SCORES(楽譜処理モード：総数カウント, -1, LOCAL)
LOCAL:2 = EXEC_SCORES(楽譜処理モード：所持数カウント, -1, LOCAL)
SIF LOCAL:1 == LOCAL:2 && LOCAL:1 > 0
	ADD_BANQUET_ALBUM_COUNT ++
NEXT
RETURNF ADD_BANQUET_ALBUM_COUNT

@Add_Banquet_Is_Musician(ARG)
#FUNCTION
RETURNF TALENT:ARG:音楽知識 || ARG == [[隠岐奈]]

@ADD_RANDOM_OUTDOOR_AREA(ON_SAME_MAP = 0)
#FUNCTION
#DIM VALID_LOCATIONS, 200
#DIM DYNAMIC LOCATION_COUNT
#DIM ON_SAME_MAP
VARSET VALID_LOCATIONS, -1
FOR LOCAL, 0, MAXHOME
SIF ON_SAME_MAP && LOCAL != GET_MAPID(CFLAG:MASTER:現在位置)
	CONTINUE
IF LOCAL == MAIN_MAP
	FOR LOCAL:1, MINROOM(), MAXROOM
	SIF !MAP_CAN_MOVE(LOCAL:1, MASTER)
		CONTINUE
	SIF INROOM(LOCAL:1)
		CONTINUE
	VALID_LOCATIONS:(LOCATION_COUNT++) = LOCAL:1
	NEXT
ELSE
	FOR LOCAL:1, 1, 10
	LOCAL:2 = LOCAL * 100 + LOCAL:1 * 10
	SIF NAME_FROM_PLACE(LOCAL:2) == ""
		CONTINUE
	SIF ODEKAKEMAP_SETTING(LOCAL:2, "屋内")
		CONTINUE
	VALID_LOCATIONS:(LOCATION_COUNT++) = LOCAL:2
	NEXT
ENDIF
NEXT
RETURNF VALID_LOCATIONS:(RAND:LOCATION_COUNT)
