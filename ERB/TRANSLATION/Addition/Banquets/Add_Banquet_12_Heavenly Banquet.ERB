	PRINTFORMDL 어제 그 재앙 같은 파티 이후로, 온몸이 너무 안 좋다.
	PRINTFORMDW 오늘은 아마 무리하지 않는 게 좋을 것이다.
	CALL BUFF_BASE(MASTER, BASE_体力, -MAXBASE:MASTER:体力 / 2)
	CALL BUFF_BASE(MASTER, BASE_気力, -MAXBASE:MASTER:気力 / 2)
	CALL BUFF_BASE(MASTER, BASE_精力, -MAXBASE:MASTER:精力 / 2)
	CALL BUFF_BASE(MASTER, BASE_TSP, -MAXBASE:MASTER:TSP / 2)
	CALL COLORMESSAGE(@"당신의 지구력(STA), 에너지(ENE), 활력(VIG), 그리고 기동력(TSP)은 하루 동안 절반으로 줄어듭니다. (최악의 만찬)",C_YELLOW,2,1)
	ADD_BANQUET12_BAD_EXPERIENCE = 1
	ADD_BANQUET12_DISASTER = 0
ELSEIF ADD_BANQUET12_DISASTER < 0
	PRINTFORMDL 어제 그 굉장한 파티 덕분에 에너지가 넘친다.
	PRINTFORMDW 오늘 온 세상을 다 상대할 수 있을 것만 같다.
	CALL BUFF_BASE(MASTER, BASE_体力, MAXBASE:MASTER:体力 / 5)
	CALL BUFF_BASE(MASTER, BASE_気力, MAXBASE:MASTER:気力 / 5)
	CALL BUFF_BASE(MASTER, BASE_精力, MAXBASE:MASTER:精力 / 5)
	CALL BUFF_BASE(MASTER, BASE_TSP, MAXBASE:MASTER:TSP / 5)
	CALL COLORMESSAGE(@"오늘 하루 동안 STA, ENE, VIG, TSP가 20\% 증가한다. (최고의 연회)",C_YELLOW,2,1)
	ADD_BANQUET12_DISASTER = 0
ENDIF
