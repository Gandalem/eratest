; Modular ERB: Addition/Banquets/Add_Banquet_12_Heavenly Banquet.ERB

@EXIST_ADD_BANQUET12
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET12(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Tenshi's Heavenly Banquet")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Enjoying heavenly food and drink")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "banquet")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "NOTIFY_PLAYER"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[天子]])
	CASE "HOST_LIST"
		IF ADD_BANQUET12_KASEN_HOST
			CALLF MAKE_STR(V_NAME, @"{[[天子]]}/{[[紫苑]]}/{[[華扇]]}")
		ELSE
			CALLF MAKE_STR(V_NAME, @"{[[天子]]}/{[[紫苑]]}")
		ENDIF
	CASE "GUEST_LIST"
	CASE "BANNED_LIST"
	CASE "CONDITIONS"
		SIF CFLAG:[[天子]]:出禁 == 0 && CFLAG:[[紫苑]]:出禁 == 0 && !RAND:62 ;roughly once every two months
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 1) ;though ultimately moot because tenshi will clear it up
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING12
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
DO
SELECTCASE RAND:5
	CASE 0
		LOCATION = P202中央広場
	CASE 1 ;tends to impose on hermits
		LOCATION = P131枯山水
	CASE 2
		LOCATION = P730仙人の屋敷・庭
	CASE 3
		LOCATION = P11庭
	CASE 4
		LOCATION = P343湖畔
ENDSELECT
LOOP FINDELEMENT(ADD_BANQUETS_LOCATION, LOCATION) >= 0
SCALE = 2000 + RAND:1000
START_TIME = CLOCK_TO_TIME(18, 0)
CALL ADD_BANQUET_CREATE(12, LOCATION, START_TIME, DAY+7, 240, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
ADD_BANQUET12_KASEN_HOST = CFLAG:[[華扇]]:出禁 == 0 ? !RAND:5 # 0
ADD_BANQUET12_QUALITY = ADD_BANQUET12_KASEN_HOST ? 75 # RAND:25
ADD_BANQUET12_DISASTER = 0
ADD_BANQUET12_PARTICIPATION_TIME = 0
ADD_BANQUET12_PREPARATION_STAGE = 0
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_NOT_INVITED
IF MARK:[[天子]]:反発刻印 ;hate
ELSEIF !CFLAG:[[天子]]:面識 ;unknown
ELSE
	IF RAND:1500 < CFLAG:[[天子]]:好感度 ;chance of invitation increases with how much she likes you
		PRINTL 
		CALL SET_KOJO_COLOR([[天子]])
		CALL PRINT_LETTER(@"축하한다 %CALLNAME:MASTER%/너는 네가 경험해 본 그 어떤 것보다 뛰어난 연회에 초대되는 영광을 받았다/다음 주 %ADD_BANQUET_LOCATION(LOCAL)%, 나는 심지어 너 같은 지상 거주자들도 천국의 맛을 즐길 수 있게 하는 나의 유명한 천상의 만찬 중 하나를 다시 열 것이다//놓치지 마라/%NAME:34%", , 40)
		RESETCOLOR
		PRINTL
		PRINTFORMDW 당신은 천신으로부터 연회 초대를 받는다.
		PRINTFORML 
		ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
		PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
		IF ABL:MASTER:教養 < UniversalRank("B") && !ADD_BANQUET12_BAD_EXPERIENCE ;not smart enough to recognize danger
			PRINTFORMDL 당신은 진정한 천자가 주최하는 연회에 초대받아 영광이다.
			PRINTFORMDW 이것은 잊을 수 없는 경험이 될 것이 확실하다.
		ELSE
			PRINTFORMDL 누가 주최하는지 보니 이 연회는 틀림없이 재앙으로 끝날 것이다...
			PRINTFORMDL 거절할 수 있는 변명을 생각해 볼 수도 있지만, 천시는 그것을 정말 싫어할지도 모른다.
			SIF ADD_BANQUET12_BAD_EXPERIENCE
				PRINTFORMDL 그래도 만약 참여하기로 결정한다면, 약간의 영리함으로 그것을 구출할 수도 있을 것이다.
			PRINTFORMDL 무엇을 하겠습니까?
			CALL ASK_YN("초대를 수락한다", "빠져나가려고 노력했다")
			IF !RESULT
				PRINTFORMDW 당신은 자신의 더 나은 판단에 반하여 천지의 초대를 받아들인다.
			ELSE
				;todo come up with excuses
				PRINTFORMDL 당신은 불행하게도 그녀의 정말 멋진 연회에 참석할 수 없다는 어떤 핑계를 대며 온다.
				IF !ABL:MASTER:話術技能 || !RAND:(ABL:MASTER:話術技能) ;failure
					PRINTFORMW 불행하게도 그녀는 그것을 믿지 않고 당신에게 꽤 화를 낸다.
					CALL CHANGE_CFLAG(2, [[天子]], -100)
					CALL CHANGE_CFLAG(4, [[天子]], -40)
				ELSE
					PRINTFORMDW 다행히 그녀는 당신을 믿는 것 같고, 더 이상 천상의 연회에 대해 걱정할 필요가 없다.
				ENDIF
				ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_REJECTED
			ENDIF
		ENDIF
		;todo trigger special requests to do menial labor
	ENDIF
ENDIF

@ADD_BANQUET_START12
ADD_BANQUET12_PARTICIPATION_TIME = 0

@ADD_BANQUET_FINISH12

@ADD_BANQUET_VISIT12(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
#DIM BANQUET_INDEX
#DIM CURRENT_STATE
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(12)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX
CALL SET_KOJO_COLOR([[天子]])
PRINTL
IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
	$TENSHI_SPEECH
	PRINTFORMDL 연회가 시작되자, 텐시가 짧은 연설을 한다.
	PRINTFORML 「오늘의 천상의 만찬에 오신 것을 환영합니다.」
	PRINTFORML 「물론 이것이 우리가 하늘에서 여는 진정한 만찬과 비교될 수는 없겠지만, 이곳 지구에서 할 수 있는 최선입니다.」
	PRINTFORML 「그러니 여러분 모두 즐기세요!」
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
	SELECTCASE ADD_BANQUETS_INVITED:BANQUET_INDEX
		CASE ADD_BANQUET_INVITE_REJECTED ;rejected
			PRINTFORML 「너 우리랑 함께 할 시간이 없을 줄 알았어.」
			PRINTFORML 「흥, 이제 와서 마음을 바꾸긴 너무 늦었지. 천국의 호사는 오늘 너에게서 사라질 거야.」
			PRINTFORMDW 아마 여기 머물지 않는 게 좋을 거야. 그녀는 이미 충분히 화가 났으니까.
		CASE ADD_BANQUET_INVITE_INVITED ;invited
			;time since arrival
			SELECTCASE ABS(ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX))
				CASE IS <= 10
					GOTO TENSHI_SPEECH
				CASE IS <= 60
					PRINTFORML 「늦었잖아!」
					PRINTFORML 「진정한 천상의 연회에 초대받은 것이 얼마나 영광스러운 일인지 모르겠나?」
					PRINTFORML 「다행히 너를 위해, 나는 관대한 주최자이니 이번 한 번은 네 무례함을 눈감아 주겠다.」
					CALL CHANGE_CFLAG(2, [[天子]], -10)
					CALL CHANGE_CFLAG(4, [[天子]], -5)
					PRINTFORMDW 천사는 네 지각에 조금 언짢아하지만, 금세 평소의 쾌활한 태도로 돌아온다.
				CASEELSE
					PRINTFORML 「너 말도 안 되게 늦었어!」
					PRINTFORML 「남의 감정 따위는 좀 고려해 줄 생각은 없어?」
					PRINTFORML 「뭐, 됐어. 그냥 앉아서 연회나 즐기라고.」
					CALL CHANGE_CFLAG(2, [[天子]], -30)
					CALL CHANGE_CFLAG(4, [[天子]], -20)
					PRINTFORMDW 센지는 당신의 늦은 도착에 꽤 언짢아한다.
			ENDSELECT
		CASEELSE
			PRINTFORML 「이 파티에는 초대 안 됐잖아!」
			IF PARTICIPANTS < 7 && !MARK:[[天子]]:反発刻印 && !CFLAG:[[天子]]:ブチギレ
				PRINTFORML 「음, 많은 사람들이 불운한 허약함 때문에 취소해야 했으니, 내가 이렇게 너그러운 주최자이니 상관없이 네가 참여하는 걸 허락하겠어.」
				PRINTFORML 「네 불행이 네 행운이 되었군. 아하하하하하하!」
				PRINTFORMDW 천지가 자리를 채우기 위해 네 침입을 눈감아주는 것 같다.
				ADD_BANQUETS_INVITED:BANQUET_INDEX = 1
			ELSE
				PRINTFORML 「여기서 나가라!」
				PRINTFORMDW 천사는 당신에게 꽤 화가 나 있다.
			ENDIF
	ENDSELECT
ENDIF
PRINTL
RESETCOLOR
IF ADD_BANQUETS_INVITED:BANQUET_INDEX > 0
	SELECTCASE PARTICIPANTS
		CASE 2
			PRINTFORMDW 당신이 오늘 유일한 진짜 손님인 것 같습니다.
		CASE 3
			IF ADD_BANQUET12_KASEN_HOST
				PRINTFORMDW 당신이 오늘 유일한 실제 손님인 것 같다.
			ELSE
				PRINTFORMDW 다른 사람은 딱 한 명만 나타난 것 같다.
			ENDIF
		CASE IS <= 5
			PRINTFORMDW 소수의 사람들만이 나타났다.
		CASE IS <= 10
			PRINTFORMDW 탄시가 꽤 많은 인파를 모은 것 같다.
		CASEELSE
	ENDSELECT
	PRINTL
	SELECTCASE ADD_BANQUET12_QUALITY
		CASE IS <= 20 ;disaster
			PRINTFORMDL 접시에 차려진 "음식"과 "음료"를 바라보자 공포감이 밀려왔다.
			PRINTFORMDL 도대체 저들은 이걸 어디서 구한 거지?
			IF PARTICIPANTS > 2 + ADD_BANQUET12_KASEN_HOST
				PRINTFORMD 다른 손님들이 연회 상태에 대해 중얼거리는 소리가 들린다.
			ELSE
				PRINTFORMD 당신은 단순히 연회장을 떠나는 것을 고려한다
			ENDIF
			PRINTFORMDL 군중 속에서 큰 목소리를 들을 때까지.
			CALL SET_KOJO_COLOR([[紫苑]])
			PRINTFORML 「와! 이거 맛있다!」
			PRINTFORML 「이런 호사라니!」
			PRINTFORML 「여기 있는 모든 사람들과 이 음식과 술을 즐길 수 있다니... 꿈만 같아!」
			PRINTFORML 「살아서 기쁘다!」
			PRINTFORML 「나를 살게 해준 삶에게 감사해!」
			PRINTFORML 「이름조차 모르는 식물들에게 고마워!」
			PRINTFORML 「이것을 위해 목숨을 바쳐 준 이들에게 고마워!」
			PRINTFORMDL 강한 죄책감이 밀려오지만, 가끔은 이것도 나쁘지 않다고 생각하게 된다.
			PRINTFORMDW 어쨌든 감사하는 것이 중요하다.
			RESETCOLOR
		CASE IS <= 50 ;mediocre
			PRINTFORMDL 음식과 음료는 맛없고 먹을 것 같지 않지만, 적어도 위험해 보이진 않는다.
			PRINTFORMDW 시온이 음식으로 허겁지겁 자신을 채우는 것이 보인다. 평소보다 훨씬 나은 것 같다.
		CASE IS <= 100 ;pretty decent
			PRINTFORMDL 오늘 음식과 음료는 꽤 좋아 보인다.
			PRINTFORMDW 당신은 시온이 행복한 표정으로 음식을 먹는 것을 본다. 이것이야말로 그녀가 오랫동안 먹어본 최고의 식사일 것이다.
		CASEELSE
			PRINTFORMDL 당신은 앞에 펼쳐진 화려한 음식과 음료를 바라보며, 내면에서 자존심이 차오르는 것을 느낀다.
			PRINTFORMDL 당신은 완전히 광적으로 음식을 먹고 있는 시온을 바라본다.
			PRINTFORMDW 그녀는 괜찮아질까?
	ENDSELECT
	IF !ADD_BANQUET12_KASEN_HOST && ADD_BANQUET12_QUALITY > 75 && PARTICIPANTS > 2
		PRINTFORML 모두 음식을 살피며 당신 쪽으로 눈길을 보내고 있다.
		PRINTFORML 그들은 모두 당신이 이 일의 진정한 책임자라는 것을 알고 있는 것 같다.
		FOR LOCAL, 1, CHARANUM
		IF CFLAG:LOCAL:BANQUET == 12 && !GROUPMATCH(LOCAL, [[天子]], [[紫苑]])
			CALL CHANGE_CFLAG(2, LOCAL, MIN((ADD_BANQUET12_QUALITY - 75), 50))
			CALL CHANGE_CFLAG(4, LOCAL, MIN((ADD_BANQUET12_QUALITY - 75) / 5, 20))
		ENDIF
		NEXT
	ENDIF
	IF !RAND:10 ;always a chance that shion's misfortune strikes
		DEBUGPRINTFORML 시온이 또 모든 것을 망쳤다.
		ADD_BANQUET12_DISASTER = 1
	ELSEIF ADD_BANQUET12_QUALITY < 20 ;unavoidable disaster
		ADD_BANQUET12_DISASTER = 1
	ELSEIF ADD_BANQUET12_QUALITY < 100 ;chance for disaster
		ADD_BANQUET12_DISASTER = ADD_BANQUET12_QUALITY < RAND:100
	ELSEIF ADD_BANQUET12_QUALITY > 100 ;chance for great success
		SIF RAND:100 < ADD_BANQUET12_QUALITY - 100
			ADD_BANQUET12_DISASTER = -1
	ENDIF
ENDIF

@ADD_BANQUET_PROGRESS12(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM BANQUET_ID
#DIM PRESENT
#DIM LAPSE
#DIM LOCATION
BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)
LOCATION = GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
SIF PRESENT
	ADD_BANQUET12_PARTICIPATION_TIME += LAPSE
SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
	CASE ADD_BANQUET_STATE_PREPARING
		IF PRESENT
			FOR LOCAL, 1, CHARANUM
			IF CFLAG:LOCAL:BANQUET == BANQUET_ID && CFLAG:LOCAL:BANQUET_ROLE > 1
				IF LOCAL == [[華扇]]
					PRINTFORML %CALLNAME:LOCAL%은(는) 성실하게 연회를 준비하고 있다.
				ELSEIF TALENT:LOCAL:恋慕
					PRINTFORML %CALLNAME:LOCAL%은(는) 연회 준비를 하면서 당신을 보며 미소 짓는다.
				ELSE
					PRINTFORML %CALLNAME:LOCAL%은(는) 다소 흐트러진 방식으로 만찬을 준비하고 있다.
				ENDIF
			ENDIF
			NEXT
		ENDIF
	CASE ADD_BANQUET_STATE_IN_PROGRESS
		FOR LOCAL, 1, CHARANUM
		IF CFLAG:LOCAL:BANQUET == BANQUET_ID && CFLAG:LOCAL:現在位置 == LOCATION
			CALL ADD_BANQUET_DRINKING(LOCAL, LAPSE)
			SIF PRESENT
				CALL ADD_BANQUET_DRINKING_DESCRIPTIONS(LOCAL)
			;TODO more unique descriptions?
		ENDIF
		NEXT
	CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT12(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT12(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS12
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(12)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK12(ARG)
IF ARG == [[チルノ]] ;the only one brave and/or stupid enough to join twice, joins fairly regularly
	RETURN !RAND:2
ENDIF
;otherwise, it's mostly the dumb ones who join
;RETURN RAND:100 < 3 - (ABL:ARG:教養 / 2)
RETURN RAND:100 < 8 - (ABL:ARG:教養 / 2) ;nas: more idiots join lol

@ADD_BANQUET_WORKLOAD_PREPARATION12(ARG)
#DIM SCALE
#DIM BANQUET_INDEX
#DIM WORKLOAD
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(12))

@ADD_BANQUET_WORKLOAD_PARTICIPATION12(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK12
#DIM BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(12)
PRINTFORMDL 천상의 만찬은 계속된다...
SELECTCASE ADD_BANQUET12_DISASTER
	CASE 1
		PRINTFORMD 술은 물처럼 계속 흘러나왔고, 모두가 간절하게 마셨다.
		SELECTCASE ADD_BANQUET12_QUALITY
			CASE IS < 50
				PRINTFORMDL 술의 마법에 자신들을 맡기면서.
			CASE IS < 100
				PRINTFORMDL .
			CASEELSE
				PRINTFORMDL 맛을 크게 즐긴다.
		ENDSELECT
	CASE 0
		PRINTFORMDL 사람들은 여유롭게 마시고 먹는다.
	CASE -1
		PRINTFORMDL 참석한 모든 이들이 멋진 음식과 음료를 즐기며 아주 좋은 기분인 것 같다.
ENDSELECT

@ADD_BANQUET_HELP_PREPARE12
#DIM BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(12)
PRINTFORMDL 당신은 천상의 만찬 준비를 돕는다.
SELECTCASE ADD_BANQUET12_PREPARATION_STAGE
	CASE 0
		PRINTFORMDL 천사가 연회용 잔과 접시를 차리라고 말한다.
		IF GETBIT(ADD_BANQUET12_TOOLS, 4)
			PRINTFORMDL 식기를 당신의 것으로 교체하시겠습니까?
			CALL ASK_YN
			IF !RESULT
				IF RAND:(ABL:MASTER:清掃技能)
					PRINTFORMDL 아무도 보지 않을 때, 깨지고 더러운 접시와 잔들을 재빨리 치고 손으로 그림을 그린 페리윙클이 그려진 로열 돌튼 제품으로 교체한다.
					PRINTFORMDL 연회는 벌써 훨씬 보기 좋아졌다.
					ADD_BANQUET12_QUALITY += 25
				ELSE
					PRINTFORMDL 불행하게도 식기를 바꾸러 움직이는 동안 천사가 다가와서, 당신은 계획을 포기해야 한다.
				ENDIF
			ELSE
				PRINTFORMDL 당신은 깨진 접시와 컵을 꺼내 세팅하기 시작한다.
			ENDIF
		ELSE
			PRINTFORMDL 당신은 깨진 접시와 컵을 꺼내 세팅하기 시작한다.
		ENDIF
		IF ABL:MASTER:清掃技能
			PRINTFORMDL 당신은 청소기능을 사용해 접시와 컵을 보기 좋게 닦는다.
			ADD_BANQUET12_QUALITY += MIN(ABL:MASTER:清掃技能 * 2, 10)
		ENDIF
	CASE 1
		IF !ADD_BANQUET12_KASEN_HOST
			PRINTFORMDL 천사는 잠시 외출해야 한다며 당신을 술병과 함께 혼자 남겨둔다.
			PRINTFORMDL 저급 사케를 직접 준비한 것으로 바꿔 드릴까요?
			CALL ASK_M(@"네 (요구량 청주 20개, {ITEM:清酒} 남음)",ITEM:清酒 >= 20, "아니오", 1)
			IF !RESULT
				IF RAND:(TALENT:MASTER:調合Lv)
					PRINTFORMDL 항아리에 있던 술을 버리고 자신의 것으로 빠르게 교체한다.
					PRINTFORMDL 비싸지만 적어도 오늘은 좋은 술이 보장된다.
					CALL LOST_ITEM("清酒", 20, 2)
					ADD_BANQUET12_QUALITY += 40
				ELSE
					PRINTFORMDL 술병을 들고 있는 동안, 당신은 시온이 끊임없이 당신 주위에 떠다니며 내용물을 바꿀 기회를 주지 않는 것을 발견한다.
				ENDIF
			ELSE
				PRINTFORMDL 당신은 센시의 술을 건드리지 않기로 결정했다.
			ENDIF
			IF GETBIT(ADD_BANQUET12_TOOLS, 1)
				PRINTFORMDW 당신은 빠르게 복제 사케 그릇에 술을 부어 품질을 높인다.
				ADD_BANQUET12_QUALITY += MIN(TALENT:MASTER:調合Lv * 3, 15)
			ENDIF
		ELSE
			PRINTFORMDL 당신은 가센이 술을 준비하는 것을 돕는다.
		ENDIF
	CASE 2
		IF !ADD_BANQUET12_KASEN_HOST
			PRINTFORMDL 당신은 천사의 명령에 따라 음식을 요리하기 시작한다.
			PRINTFORMDL 대신 몰래 자신의 채소를 사용하고 싶으신가요?
			CALL ASK_M(@"네 (양배추, 오이, 토마토, 양파, 가지, 당근 각 10개 필요)",ITEM:キャベツ >= 10 && ITEM:キュウリ >= 10 && ITEM:トマト >= 10 && ITEM:タマネギ >= 10 && ITEM:ナス >= 10 && ITEM:ニンジン >= 10, "아니오", 1)
			IF !RESULT
				PRINTFORMDL 당신은 천사와 시온이 가져온 채소들을 무시하고 대신 자신의 것을 사용한다.
				CALL LOST_ITEM("キャベツ", 10, 1)
				CALL LOST_ITEM("キュウリ", 10, 1)
				CALL LOST_ITEM("トマト", 10, 1)
				CALL LOST_ITEM("タマネギ", 10, 1)
				CALL LOST_ITEM("ナス", 10, 1)
				CALL LOST_ITEM("ニンジン", 10, 2)
				ADD_BANQUET12_QUALITY += 20
			ELSE
				PRINTFORMDL 너는 천사와 시온이 가져온 채소를 사용하기로 결정한다.
			ENDIF
		ELSE
			PRINTFORMDL 당신은 카센을 요리하는 것을 돕는다. 그녀가 가져온 고품질의 재료들은 그것들로 좋은 무언가를 만드는 것을 쉽게 만든다.
		ENDIF
		ADD_BANQUET12_QUALITY += MIN(ABL:MASTER:料理技能 * 2, 10)
		IF GETBIT(ADD_BANQUET12_TOOLS, 3)
			PRINTFORMDL 당신은 미나코의 특제 허브와 향신료를 음식에 아낌없이 뿌린다.
			PRINTFORMDL 음식의 품질과 상관없이, 적어도 그 냄새는 정말로 멋지다.
			ADD_BANQUET12_QUALITY += 5
		ENDIF
		WAIT
	CASEELSE
		PRINTFORMDW 당신은 분위기를 개선하기 위해 %NAME_FROM_PLACE_THE(GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX))% 주변의 장식을 세팅하는 것을 센시와 시온을 도와 진행한다.
		ADD_BANQUET12_QUALITY += RAND:(MAX(ABL:MASTER:音楽技能 + ABL:MASTER:教養,1))
ENDSELECT
ADD_BANQUET12_PREPARATION_STAGE++
DEBUGPRINTFORML 현재 천상 만찬 품질: {ADD_BANQUET12_QUALITY}이다.

@EVENTTRAIN
