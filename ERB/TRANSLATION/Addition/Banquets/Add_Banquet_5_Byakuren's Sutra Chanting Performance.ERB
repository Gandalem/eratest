; Modular ERB: Addition/Banquets/Add_Banquet_5_Byakuren's Sutra Chanting Performance.ERB

@EXIST_ADD_BANQUET5
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET5(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "An all-night sutra chanting performance")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Listening to sutras")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "sutra concert")
	CASE "CATEGORY"
		CALLF MAKE_STR(V_NAME, "performance")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "NOTIFY_PLAYER"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, [[白蓮]])
	CASE "HOST_LIST"
		CALLF MAKE_STR(V_NAME, @"{[[白蓮]]}/{[[一輪]]}/{[[星]]}/{[[響子]]}")
	CASE "GUEST_LIST"
		CALLF MAKE_STR(V_NAME, @"")
	CASE "BANNED_LIST"
		CALLF MAKE_STR(V_NAME, @"")
	CASE "CONDITIONS"
		SIF DAY:3 >= 8 && DAY:3 <= 10
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "KEEP_AWAKE"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "LISTEN_TO_MUSIC"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "PERFORMERS"
		CALLF MAKE_STR(V_NAME, @"{[[白蓮]]}")
ENDSELECT

@ADD_BANQUET_PLANNING5
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = P104講堂
;especially popular in summer amongst youkai
SCALE = 1000 + RAND:2000
SIF DAY:2 == 2
	SCALE += 1000
START_TIME = CLOCK_TO_TIME(23, 0)
CALL ADD_BANQUET_CREATE(5, LOCATION, START_TIME, DAY + (10 - DAY:3), 360, SCALE)
LOCAL = RESULT ;banquet_index
SIF LOCAL < 0 ;couldn't create
	RETURN
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW 비아쿠렌은 곧 또 다른 밤샘 경전 염불 공연을 열 것이다.
PRINTFORML 
PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%

@ADD_BANQUET_START5

@ADD_BANQUET_FINISH5

@ADD_BANQUET_VISIT5(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
#DIM BANQUET_INDEX
#DIM CURRENT_STATE
#DIM PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(5)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX
IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
	PRINTFORML 
	IF PARTICIPANTS >= 10
		PRINTW 백련이 경전 연주를 시작하고, 많은 군중들이 그녀의 노래에 간절히 귀 기울였다.
	ELSE
		PRINTW 백련이 경전 공연을 시작하자 소수의 참석자들이 그녀의 노래에 간절히 귀를 기울였다.
	ENDIF
	PRINTFORML 
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
	PRINTL  
	PRINTW 비아쿠렌은 이미 공연을 시작했다...
	PRINTL  
ENDIF

@ADD_BANQUET_PROGRESS5(BANQUET_INDEX)
#DIM BANQUET_INDEX
#DIM BANQUET_ID
#DIM PRESENT
#DIM LAPSE
BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)
SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
	CASE ADD_BANQUET_STATE_PREPARING
		IF PRESENT
			FOR LOCAL, 1, CHARANUM
			IF CFLAG:LOCAL:BANQUET == BANQUET_ID && CFLAG:LOCAL:BANQUET_ROLE > 1
				IF TALENT:LOCAL:恋慕
					PRINTFORML %CALLNAME:LOCAL%은(는) 경전 염송 공연을 준비하면서 당신을 생각한다.
				ELSE
					PRINTFORML %CALLNAME:LOCAL%는 경전 염불 공연을 위해 분주하게 준비하고 있다.
				ENDIF
			ENDIF
			NEXT
		ENDIF
	CASE ADD_BANQUET_STATE_IN_PROGRESS
		SIF PRESENT
			PRINTFORMDL 백련은 자신의 경전을 염송하며 완벽한 리듬을 유지한다. 
		FOR LOCAL, 1, CHARANUM
		IF CFLAG:LOCAL:BANQUET == BANQUET_ID
			IF CFLAG:LOCAL:行動 == 5
				BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
				SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
					CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
				IF PRESENT && CFLAG:LOCAL:職種 == 49
					SIF LOCAL == [[白蓮]]
						CONTINUE
					IF TALENT:LOCAL:妖怪
						IF TALENT:LOCAL:恋慕 && !RAND:5
							PRINTFORMDL %CALLNAME:LOCAL%은(는) 공연으로 인해 떨면서 당신에게 매달린다.
						ELSE
							PRINTFORMDL %CALLNAME:LOCAL%은(는) 공연을 들으며 떨고 몸을 떠는.
						ENDIF
					ELSE
						IF CFLAG:LOCAL:職種 == 49 && TALENT:LOCAL:恋慕 && !RAND:5
							PRINTFORML %CALLNAME:LOCAL%은(는) 졸다가 당신에게 기대어 잠든다.
						ELSE
							PRINTFORML %CALLNAME:LOCAL%는 %HE_SHE(LOCAL)%가 졸려고 하는 것 같다.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		NEXT
	CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT5(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%는 경전 암송 공연을 준비하기 시작한다.
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%는 (들) %NAME_FROM_PLACE_THE(LOCATION)%에 도착하여 경전 암송 공연 준비를 시작한다.
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORML %CALLNAME:CHARA%는 설화 염불 공연 준비를 시작하기 위해 %NAME_FROM_PLACE_THE(LOCATION)%로 이동한다.
ENDIF

@ADD_BANQUET_JOIN_TEXT5(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%는 자리에 앉아 경전 염불 공연을 듣기 시작한다.
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%는 비아쿠렌의 경전 염불 공연을 들으러 %NAME_FROM_PLACE_THE(LOCATION)%에 도착한다.
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORML %CALLNAME:CHARA%는 설법 공연에 참석하기 위해 %NAME_FROM_PLACE_THE(LOCATION)%로 이동한다.
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS5
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(5)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 8)

@ADD_BANQUET_WORKLOAD_PREPARATION5(ARG)
#DIM SCALE
#DIM BANQUET_INDEX
#DIM WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(5)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10
IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
	TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION5(ARG, SCALE)
#DIM SCALE
IF CFLAG:ARG:職種 != JOB_宴会参加
	IF CFLAG:ARG:BANQUET_ROLE > 1
		MAXBASE:ARG:仕事量 = 3600 ;hosts remain the full duration
	ELSE
		MAXBASE:ARG:仕事量 = LIMIT(RAND:4000, 600, 3600) ;stay as long as they can stand it
	ENDIF
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
	TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK5
#DIM BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(5)
PRINTFORMDL 비아쿠렌은 목탁 소리에 맞춰 단조로운 노래를 부른다.

@ADD_BANQUET_LISTEN_TEXT5
PRINTFORMDW 당신은 백련이 단조롭고 리듬감 있게 경전을 외우는 것을 듣는다.

@ADD_BANQUET_LISTEN_TOGETHER_TEXT5
PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"와")% 함께 백련의 공연을 듣는다.
IF TALENT:妖怪
	PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 얼굴을 타고 식은땀이 흘러내리는 것을 본다. %HE_SHE(TARGET)%는 불교 경전이 읽히는 소리에 집중해서 듣는다.
ELSE
	PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 공연 때문에 졸고 있는 것 같다.
ENDIF
