@EXIST_ADD_BANQUET4
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET4(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
        CALLF MAKE_STR(V_NAME, "A harvest festival")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Drinking and chatting")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "CATEGORY"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "NOTIFY_PLAYER"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "HOST"
        CALLF MAKE_INT(V_NAME, [[阿求]])
    CASE "HOST_LIST"
        LOCALS =
        FOR LOCAL,1,CHARANUM
            IF CFLAG:LOCAL:自宅位置 / 100 == 2
                SIF STRLENS(LOCALS)
                    LOCALS += "/"
                LOCALS += @"{LOCAL}"
            ENDIF
        NEXT
        CALLF MAKE_STR(V_NAME, LOCALS)
    CASE "GUEST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[静葉]]}/{[[穣子]]}")
    CASE "BANNED_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[正邪]]}")
    CASE "CONDITIONS"
        SIF DAY:2 == 3 && DAY:3 >= 16 && DAY:3 < 27
            CALLF MAKE_INT(V_NAME, 1)
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 0)
    CASE "DRINKING"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "MUSIC_PERFORMANCE"
        CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING4
#DIM LOCATION
#DIM SCALE
#DIM START_TIME

LOCATION = P202中央広場

SCALE = 2000 + RAND:3000
START_TIME = 540

CALL ADD_BANQUET_CREATE(4, LOCATION, START_TIME, DAY + (27 - DAY:3), (SCALE / 10) + 360, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW The season to hold harvest festivals has come.
PRINTFORML 

CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

