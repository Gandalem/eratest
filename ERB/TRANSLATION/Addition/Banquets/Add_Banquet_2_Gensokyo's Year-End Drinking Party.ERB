@EXIST_ADD_BANQUET2
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET2(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
        CALLF MAKE_STR(V_NAME, "Gensokyo's year-end drinking party")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Drinking and chatting")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "CATEGORY"
        CALLF MAKE_STR(V_NAME, "banquet")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "NOTIFY_PLAYER"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "HOST"
        CALLF MAKE_INT(V_NAME, [[霊夢]])
    CASE "HOST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[霊夢]]}/{[[る～こと]]}/{[[魔理沙]]}")
    CASE "GUEST_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[萃香]]}")
    CASE "BANNED_LIST"
        CALLF MAKE_STR(V_NAME, @"{[[正邪]]}")
    CASE "CONDITIONS"
        SIF DAY:2 == 4 && DAY:3 >= 25 && DAY:3 <= 30
            CALLF MAKE_INT(V_NAME, 1)
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 0)
    CASE "KEEP_AWAKE"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "DRINKING"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "MUSIC_PERFORMANCE"
        CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING2
#DIM SCALE
#DIM START_TIME

SCALE = 6000
START_TIME = 900

CALL ADD_BANQUET_CREATE(2, P9居間, START_TIME, DAY + (31 - DAY:3), 720, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW It's now the season for a year-end party.
PRINTFORML 

CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START2

@ADD_BANQUET_FINISH2

@ADD_BANQUET_VISIT2(PREVIOUS_STATE)
#DIM PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(2))

@ADD_BANQUET_PROGRESS2(BANQUET_INDEX)
#DIM BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT2(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT2(CHARA, LOCATION)
#DIM CHARA
#DIM LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS2
#DIM BANQUET_INDEX
#DIM BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(2)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 20, 20)

@ADD_BANQUET_WORKLOAD_PREPARATION2(ARG)
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(2))

@ADD_BANQUET_WORKLOAD_PARTICIPATION2(ARG, SCALE)
#DIM SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK2
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(2))