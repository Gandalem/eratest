; Modular ERB: Addition/Add_SeedOfUnknownForm.ERB
;process the effect of the lover item you receive from Nue
;concept: gives bonus to stealth when having sex outside, helps out in danmaku when dodging sometimes (gets distracted!), and can be used to disguise panties on you once per day
;won't work against Nue herself, Mamizou is quite familiar with it, and good fighters can sense illusions in danmaku

@Add_SeedOfUnknownForm(ARGS, ARG, ARG:1)
#DIM nInit
#DIM nDiff
#DIM PREV_DAY
SIF !ITEM:498 && ARGS != "dialogue" ;正体不明のタネ item is required
	RETURN 0
SELECTCASE ARGS
	CASE "init"
		;note that init is not cleared and is kept in memory
		nInit = BASE:MASTER:潜伏率
	CASE "proc"
		;get difference
		nDiff = ABS(nInit - BASE:MASTER:潜伏率)
		IF nInit > BASE:MASTER:潜伏率 ;stealth lowered
			BASE:MASTER:潜伏率 = nInit ;revert the value
			BASE:MASTER:潜伏率 -= MULTIPLY(nDiff, RAND(60, 81)) ;lower the stealth decrease by 20-40%
		ELSE
			BASE:MASTER:潜伏率 = nInit ;revert the value
			BASE:MASTER:潜伏率 += MULTIPLY(nDiff, RAND(130, 151)) ;increase the stealth increase by 30-50%
		ENDIF
		CALL COLORMESSAGE(@"미지의 형태의 씨앗이 당신을 숨겨주는 데 도움을 준다!",C_GREEN,1,1)
	CASE "danmaku"
		SIF !PERCENT(20)
			RETURN 0
		CALL COLORMESSAGE(@"미지의 형태의 씨앗이 당신이 회피하도록 돕기 위해 작동한다!",C_YELLOW,1,1)
		IF ARG == [[ぬえ]]
			CALL COLORMESSAGE(@"하지만 누에가 자신의 미지의 형태의 씨앗을 꿰뚫어 본다!",C_RED,1,1)
			RETURN 0
		ELSEIF ARG == [[マミゾウ]] && RAND:2
			CALL COLORMESSAGE(@"하지만 마미조는 %HE_SHE(ARG)%의 너무나 익숙한 속임수를 꿰뚫어 본다!",C_RED,1,1)
			RETURN 0
		ELSEIF ABL:ARG:戦闘能力 >= 5 && !RAND:3
			CALL COLORMESSAGE(@"하지만 %CALLNAME:ARG%은/는 %HIS_HER(ARG)%의 전투경험 덕분에 환상을 간파한다!",C_RED,1,1)
			RETURN 0
		ELSE
			SELECTCASE RAND:3
				CASE 0
					ARG:1 = MULTIPLY(ARG:1, 50)
					LOCALS '= @"반"
				CASE 1
					ARG:1 = MULTIPLY(ARG:1, 67)
					LOCALS '= @"세 번째"
				CASE 2
					ARG:1 = MULTIPLY(ARG:1, 75)
					LOCALS = 4분의 1
			ENDSELECT
			CALL COLORMESSAGE(@"%CALLNAME:ARG%은/는 미지의 형태의 씨앗 덕분에 %HIS_HER(ARG)%의 공격 %LOCALS%를 놓치며 주의가 산만해진다!",C_GREEN,1,1)
			RETURN ARG:1
		ENDIF
	CASE "panties"
		SIF TFLAG:SeedUsed
			RETURN 0
		CALL COLORMESSAGE("하지만, 당신은 미지의 형태의 씨앗을 사용하여 전리품을 위장한다!",C_GREEN,1,1)
		IF ARG == [[ぬえ]]
			CALL COLORMESSAGE("하지만 누에는 자신의 속임수에 넘어가지 않는다!",C_RED,2,1)
			RETURN 0
		ELSEIF ARG == [[マミゾウ]] && RAND:2
			CALL COLORMESSAGE(@"마미조우는 %HE_SHE(ARG)%가 너무나 익숙한 속임수를 간파하지만 의미심장하게 웃으며 당신이 넘어갈 수 있도록 해준다.",C_YELLOW,1,1)
		ELSE
			CALL COLORMESSAGE(@"%CALLNAME:ARG%는 매우 혼란스러워하지만 잠시 망설인 후 당신을 가게 해준다...",C_GREEN,1,1)
		ENDIF
		CALL COLORMESSAGE(@"%HE_SHE(ARG, 1)%은 아마 똑같은 속임수에 두 번 당하지 않을 것이다, 적어도 같은 날에는 말이다.",C_GREEN,2,1)
		TFLAG:SeedUsed = 1
		RETURN 1
	CASE "mobsex"
		SIF UFUFU_START_TIME == 0 && UFUFU_START_DAY == 0 ;kind of resets the message display above if you didn't initialize sex right away
			PREV_DAY = 0
		IF CFLAG:MASTER:うふふ
			IF PREV_DAY != DAY
				CALL COLORMESSAGE(@"%CAPITALIZE(MOB_NAME(GET_MAPID(CFLAG:MASTER:現在位置)))%들이 주변에 있지만... 미지의 형태의 씨앗이 당신을 숨겨주는 데 도움이 된다!",C_GREEN,1,1)
				PREV_DAY = DAY
			ENDIF
			RETURN 1
		ENDIF
	CASE "dialogue"
		;activate in 300,会話
		SIF TARGET != [[ぬえ]]
			RETURN 0
		SIF CFLAG:ブチギレ || MARK:反発刻印
			RETURN 0
		;SIF !( (TALENT:恋人 && TALENT:恋慕) || ABL:親密 < 15 )
		;	RETURN 0
		SIF CFLAG:1300 < 3 ;after knowing nue's form
			RETURN 0
		SIF ITEM:498 ;got the item
			RETURN 0
		PRINTFORMW 「헤이, %MASTERNAME:41%...」
		PRINTFORMDW 누에가 갑자기 당신의 소매를 잡아당기며 다소 망설이는 듯한 표정을 짓는다.
		PRINTFORMDW 그녀는 곁눈질하는 시선에서 벗어나 관심을 받고 싶어 하는 것 같다고 생각한다.
		PRINTFORMDW 당신은 미소를 지으며 고개를 끄덕이고, 그녀를 구석으로 데려가 부드럽게 쓰다듬기 시작한다.
		PRINTFORMW 「아, 잠시만, 그런 게 아니야... 그냥 너랑 얘기하고 싶었을 뿐이야, 오래 걸리지 않아.」
		PRINTFORMDW 당신은 혼란스러운 표정으로 그녀를 바라본다. 그녀는 확신하지 못하는 듯하지만 분명 결심을 다질 준비가 되어 보인다.
		PRINTFORMW 「있잖아, 생각해 봤는데... 네가 나에게 해준 모든 것에 제대로 감사하다고 말할 기회가 없었지, 그렇지?」
		PRINTFORMDW 이상하다. 당신은 함께 보낸 멋진 시간에 만족하고 있었는데, 이게 무슨 일이지?
		PRINTFORMDW 그녀의 말에 불안감이 밀려온다. 마치 어떤 작별 연설처럼 들린다...
		PRINTFORMW 「아니야, 걱정 마, 헤어지자는 건 아니야, 그런 거 말고... 오히려 그 반대라고 할까, 정말로.」
		PRINTFORMDW 누에는 팔에 있던 작은 초록색 뱀을 내려놓으며 당신에게 건넨다.
		PRINTFORMW 「%MASTERNAME:41%... 매우 중요한 것을 알려줄게.」
		PRINTFORMW 「전에 봤지? 우리가 처음 만났을 때. 나의 미지의 형태의 씨앗.」
		PRINTFORMW 「이것은 나의 능력의 일부이자, 나 자신의 일부야... 영원히 너와 함께 있길 바라.」
		PRINTFORMW 「내 진정한 모습을 알아봤으니, 그것을 가질 자격이 있다고 생각해.」
		PRINTFORMW 「그러니 여기, 가져가!」
		PRINTFORMDW 당신은 고개를 끄덕이며 그녀의 선물을 감사히 받는다.
		PRINTFORMDW 그것을 본 누에는 금세 기운을 차리고 행복하게 미소 짓는다.
		PRINTFORMW 「에헤헤～」
		PRINTFORMW 「이제 확실해졌어! 우리가 영원히 함께하기로 약속했잖아, 기억하지?」
		PRINTFORMDW 당신의 손에 있던 뱀이 갑자기 살아나 소매 밑으로 기어들어 간다!
		PRINTFORMDW 당신은 당황하며 그것을 잡으려고 하지만 항상 당신의 손아귀에서 빠져나간다!
		PRINTFORMW 「진정해, %MASTERNAME:41%... 그냥 두렴.」
		PRINTFORMW 「나를 믿어주지?」
		PRINTFORMDW 당신은 그녀의 눈을 바라보고 잠시 생각한 후, 누에를 믿기로 결정한다.
		PRINTFORMW 「다행이다...」
		PRINTFORMW 「이것은 나의 힘을 담고 있고, 너는... 그것을 사용할 수 있을 거야.」
		PRINTFORMW 「가끔 도움이 될지도 모르지, 누가 알겠어♪」
		PRINTFORMDW 누에는 몸을 기울이며 당신에게 기대온다.
		PRINTFORMW 「결국 모든 건 사람들을 속이는 것일 뿐이고, 너는 이젠 꽤 잘하고 있어.」
		PRINTFORMW 「나의 영광을 퍼뜨려줘, %MASTERNAME:41%♪ 분명 실망하지 않을 거야!」
		PRINTFORMDW 당신은 그녀를 다시 껴안고 머리를 쓰다듬어 준다.
		PRINTFORMW 「사랑해, %MASTERNAME:41%♪」
		CALL COLORMESSAGE("[미지 형상의 씨앗]을 받았다!",C_YELLOW,2,1)
		ITEM:498 ++
		RETURN 1
ENDSELECT
