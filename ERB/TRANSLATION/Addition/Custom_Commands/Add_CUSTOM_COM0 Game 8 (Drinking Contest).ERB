; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM0 Game 8 (Drinking Contest).ERB

@EXIST_ADD_GAME_INFO8
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO8(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Drinking Competition")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "술 마시기 경쟁")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 10)
	CASE "CHECKREQUIREMENTS"
		IF AlcoholAddict:ARG:0 <= -5 ;nondrinker
		ELSEIF BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 8 ;already drunk
		ELSEIF TALENT:ARG:妊娠 ;not during pregnancy
		ELSEIF TFLAG:酔い止め ;not while using turmeric
		ELSEIF ADD_BANQUET_ACTIVITY_ALLOWED("DRINKING")
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "VALIDBETS"
		LOCALS '= ADD_GAME_STANDARD_BETS()
		SIF MONEY > 20000
			LOCALS += "BIGMONEY/"
		SIF MONEY:2 > 200
			LOCALS += "BIGCHARISMA/"
		CALLF MAKE_STR(V_NAME, LOCALS)
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 120)
ENDSELECT

@ADD_GAME8
#DIM DRINKS, 10
#DIM REMAINING_PARTICIPANT_COUNT
#DIM REMAINING_PARTICIPANTS, ADD_GAME_MAXIMUM_PARTICIPANTS
#DIM CURRENT_ROUND
#DIM SURRENDERED, ADD_GAME_MAXIMUM_PARTICIPANTS ;the people who surrendered/collapsed in the current round
#DIM SURRENDERED_COUNT, ADD_GAME_MAXIMUM_PARTICIPANTS
#DIM CURRENT_CHARA
#DIM CHOSEN_DRINK
#DIM PLAYER_QUIT
PRINTFORML 당신은 다른 이들에게 술 대결에 도전한다.
PRINTFORML 매 라운드에서 모든 참가자는 무작위 음료로 채워진 트레이에서 한 잔을 고른다.
PRINTFORML 참가자들은 언제든지 포기할 수 있다.
PRINTFORML 승자는 다른 모든 이들이 포기하거나 쓰러졌을 때 결정된다.
PRINTFORML 당신이 혼합 스킬을 연마하면, 일부 음료를 미리 알아챌 수 있을지도 모른다.
REMAINING_PARTICIPANT_COUNT = ADD_GAME_PARTICIPANT_COUNT
PLAYER_QUIT = 0
ARRAYCOPY "ADD_GAME_PARTICIPANTS", "REMAINING_PARTICIPANTS"
WHILE 1
IF !ISSKIP()
	PRINTFORMW 다음 라운드다! 남은 참가자 수는 {REMAINING_PARTICIPANT_COUNT}명이다.
ENDIF
VARSET DRINKS
VARSET SURRENDERED, -1
SURRENDERED_COUNT = 0
CALL ADD_GAME8_RANDOM_DRINKS(DRINKS, REMAINING_PARTICIPANT_COUNT)
CALL FISHER_YATES_SHAFFLE(REMAINING_PARTICIPANT_COUNT)
FOR LOCAL, 0, REMAINING_PARTICIPANT_COUNT
SIF REMAINING_PARTICIPANT_COUNT - SURRENDERED_COUNT <= 1 ;no-one else left, end game
	GOTO ROUND_END
PRINTL
CURRENT_CHARA = REMAINING_PARTICIPANTS:(SHAFFLE_ARRAY:LOCAL)
IF CURRENT_CHARA == MASTER
	CALL ADD_GAME8_PLAYER_JUDGMENT
	PRINTFORML 어떤 음료를 선택하겠습니까?
	FOR	LOCAL:1, 0, REMAINING_PARTICIPANT_COUNT
	SIF !DRINKS:(LOCAL:1)
		CONTINUE
	PRINTFORML [{(LOCAL:1)+1, 2}] - 마신다 #{(LOCAL:1)+1} %COND_STR(@"(%ADD_GAME8_DRINK_NAME(DRINKS:(LOCAL:1))%)", RAND:60 < TALENT:MASTER:調合Lv)%
	NEXT
	PRINTFORML [-1] 포기한다
	DO
	INPUT
	SELECTCASE RESULT
		CASE -1
			BREAK
		CASEELSE
			SIF INRANGE(RESULT, 1, REMAINING_PARTICIPANT_COUNT) && DRINKS:(RESULT-1)
				BREAK
			REUSELASTLINE 잘못된 입력
			CONTINUE
	ENDSELECT
	LOOP 1
	IF RESULT == -1
		PRINTFORML 너는 앞서 있을 때 그만두기로 결정한다.
		SURRENDERED:(SURRENDERED_COUNT++) = MASTER
		PLAYER_QUIT = 1
	ELSE
		CHOSEN_DRINK = DRINKS:(RESULT-1)
		DRINKS:(RESULT-1) = 0
		PRINTFORML 당신은 음료를 집어 단숨에 마셨다.
		IF CHOSEN_DRINK == 1
			PRINTFORML 그것은 평범한 물이었다.
			PRINTFORMW 정말 시원하다!
			BASE:MASTER:酒気 = MAX(BASE:MASTER:酒気-200, 0)
		ELSE
			PRINTFORML It's %ITEMNAME_TR(GETNUM(ITEM, ALC_NAME(CHOSEN_DRINK)))%.
			LOCAL:2 = BASE:MASTER:酒気 ;previous drunkenness
			CALL ADD_GAME8_DRINK(MASTER, CHOSEN_DRINK)
			LOCAL:3 = BASE:MASTER:酒気 - LOCAL:2
			;player won't instantly collapse after crossing the danger threshold, but every round afterwards will induce increasing risk
			IF LOCAL:2 >= MAXBASE:MASTER:酒気 && RAND:2000 < (BASE:MASTER:酒気-MAXBASE:MASTER:酒気)
				PRINTFORMW 마지막 술은 당신에게 너무 강했고, 그 자리에서 쓰러진다.
				SURRENDERED:(SURRENDERED_COUNT++) = MASTER
				SKIPDISP 1 ;continue processing the rest of the game in silence
				CONTINUE
			ENDIF
			SELECTCASE LOCAL:3
				CASE IS <= 100
					PRINTFORMW 그것은 약한 음료라서 거의 알아차리지 못한다.
				CASE IS <= 250
					PRINTFORMW 그것은 순한 음료이며 쉽게 넘어간다.
				CASE IS <= 500
					PRINTFORMW 그것은 상당히 전형적인 음료이며 큰 문제 없이 넘어간다.
				CASE IS <= 750
					PRINTFORMW 그것은 상당히 강한 술이며 그 효과를 빠르게 느낀다.
				CASE IS <= 1000
					PRINTFORMW 그것은 매우 강한 술이다. 너는 이것들을 많이 마실 수 있을지 의심한다.
				CASEELSE
					PRINTFORMW 그건 너무 독한 술이라 거의 그 자리에서 쓰러질 지경이다.
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	WHILE 1
	LOCAL:1 = RAND:REMAINING_PARTICIPANT_COUNT
	SIF DRINKS:(LOCAL:1)
		BREAK
	WEND
	CHOSEN_DRINK = DRINKS:(LOCAL:1)
	DRINKS:(LOCAL:1) = 0
	PRINTFORM %CALLNAME:CURRENT_CHARA%이 음료를 집는다. 
	;Do later: different dialogue per personality/oni/alcoholism level
	PRINTFORML 그리고 그것을 단숨에 마신다.
	LOCAL:2 = BASE:CURRENT_CHARA:酒気 ;previous drunkenness
	IF CHOSEN_DRINK == 1
		BASE:CURRENT_CHARA:酒気 = MAX(BASE:CURRENT_CHARA:酒気-200, 0)
	ELSE
		CALL ADD_GAME8_DRINK(CURRENT_CHARA, CHOSEN_DRINK)
	ENDIF
	LOCAL:3 = BASE:CURRENT_CHARA:酒気 - LOCAL:2
	IF LOCAL:2 >= MAXBASE:CURRENT_CHARA:酒気 && RAND:2000 < (BASE:CURRENT_CHARA:酒気-MAXBASE:CURRENT_CHARA:酒気)
		PRINTFORML 마지막 술은 %CALLNAME:CURRENT_CHARA%에게 너무 버거웠고, %HE_SHE(CURRENT_CHARA)%는 여기서 멈춰야 한다.
		SURRENDERED:(SURRENDERED_COUNT++) = CURRENT_CHARA
		CONTINUE
	ENDIF
	CALL ADD_GAME8_ENEMY_JUDGMENT(CURRENT_CHARA)
ENDIF
NEXT
$ROUND_END
;process quitters
FOR LOCAL, 0, SURRENDERED_COUNT
LOCAL:1 = FINDELEMENT(REMAINING_PARTICIPANTS, SURRENDERED:LOCAL)
IF LOCAL:1 >= 0
	ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = SURRENDERED:LOCAL
	ARRAYREMOVE REMAINING_PARTICIPANTS, LOCAL:1, 1
	REMAINING_PARTICIPANT_COUNT--
ENDIF
NEXT
[IF_DEBUG]
NOSKIP
PRINTL
PRINTFORML 개요:
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
LOCAL:1 = ADD_GAME_PARTICIPANTS:LOCAL
PRINTFORML %CALLNAME:(LOCAL:1)%의 알코올 수치: {BASE:(LOCAL:1):酒気} 최대 술내성: {MAXBASE:(LOCAL:1):酒気}. %COND_STR("*Surrendered*", FINDELEMENT(ADD_GAME_LOSERS, LOCAL:1) >= 0)%
NEXT
ENDNOSKIP
[ENDIF]
;pick up winner
IF REMAINING_PARTICIPANT_COUNT == 1
	ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = REMAINING_PARTICIPANTS:0
	BREAK
ENDIF
WEND
$GAME_END
SKIPDISP 0
LOCAL:10 = ADD_GAME_WINNERS:0
PRINTFORMW 결국, %CALLNAME:(LOCAL:10)%이 마지막까지 살아남는다.
;cap everyone's drunkenness to max
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
LOCAL:1 = ADD_GAME_PARTICIPANTS:LOCAL
BASE:(LOCAL:1):酒気 = MIN(BASE:(LOCAL:1):酒気, MAXBASE:(LOCAL:1):酒気)
NEXT
IF LOCAL:10 > 0 && IS_FEMALE(LOCAL:10) && HAS_PENIS(MASTER) && !PLAYER_QUIT
	;check if winner will take advantage of wasted player
	IF !(CFLAG:(LOCAL:10):既成事実 & 合意_うふふ) ;must have given consent before
	ELSEIF TALENT:(LOCAL:10):貞操 == 1 || TALENT:(LOCAL:10):性的興味 == -1 ;not if virtuous or conservative
	ELSEIF RAND:4 ;Do later: modify by traits/horniness
		TARGET = LOCAL:10
		PRINTFORML 정신을 차렸을 때, 당신은 자신의 침대에서 담요를 덮고 누워있는 자신을 발견한다.
		PRINTFORML 이곳까지 데려다준 사람에게 감사해야겠지만, 아마 너무 자주 이런 일을 해서는 안 될 것이다.
		PRINTFORMW 하지만 당신의 고환이 이상하게 공허하다...
		CALL ADD_GAME8_MOLESTATION(LOCAL:10)
		MAXBASE:MASTER:酒気 = LIMIT(MAXBASE:MASTER:酒気-40,1500,3000)
		CALL ADD_GAME8_TALENT_CHECK(0)
		RETURN
	ENDIF
ENDIF
IF LOCAL:10 == MASTER
	BASE:MASTER:酒気 = MIN(BASE:MASTER:酒気, MAXBASE:MASTER:酒気-1) ;set to barely sober
	PRINTFORML 놀랍게도 네가 이겼다.
	PRINTFORMW 술을 마시는 것에 조금 더 익숙해진 것 같다.
	MAXBASE:MASTER:酒気 = LIMIT(MAXBASE:MASTER:酒気+20,1500,3000)
	CALL ADD_GAME8_TALENT_CHECK(1)
ELSEIF PLAYER_QUIT ;sensible
	BASE:MASTER:酒気 = MIN(BASE:MASTER:酒気, MAXBASE:MASTER:酒気-1) ;set to barely sober
	IF BASE:MASTER:酒気 < (MAXBASE:MASTER:酒気-1)
		PRINTFORML 돌아보니, 좀 더 버틸 수도 있었을 것 같은 기분이 든다.
		PRINTFORMW 그래도 스스로의 더러움 속에서 깨어나는 것보다는 일찍 그만두는 편이 낫다.
	ELSE
		PRINTFORML 좋은 노력을 했지만, 여기까지가 한계였다.
		PRINTFORMW 다음에는 더 나아질 수도 있을 것이다.
		IF !RAND:3
			PRINTFORMW 그런 도전을 겪고 나니, 술을 좀 더 잘 참게 된 것 같은 기분이 들었다.
			MAXBASE:MASTER:酒気 = LIMIT(MAXBASE:MASTER:酒気+20,1500,3000)
		ENDIF
		CALL ADD_GAME8_TALENT_CHECK(1)
	ENDIF
ELSE
	IF !RAND:2
		PRINTFORMW 그렇게 만취하고 나니, 술을 참는 게 조금 더 서툰 것 같다.
		MAXBASE:MASTER:酒気 = LIMIT(MAXBASE:MASTER:酒気-20,1500,3000)
	ENDIF
	CALL ADD_GAME8_TALENT_CHECK(0)
ENDIF

@ADD_GAME8_RANDOM_DRINKS(DRINKS, DRINK_COUNT)
#DIM REF DRINKS
#DIM DRINK_COUNT
#DIM DRINK_ID
#DIM SET_COUNT
VARSET DRINKS
SET_COUNT = 0
CALL FISHER_YATES_SHAFFLE(OBJ_ID_LAST)
FOR LOCAL, 0, OBJ_ID_LAST
SIF SET_COUNT >= DRINK_COUNT
	BREAK
DRINK_ID = SHAFFLE_ARRAY:LOCAL
IF DRINK_ID == 1 || GET_INT(0, "酒データ", DRINK_ID, "酒気増加量") > 0 ;normal water is also allowed
	DRINKS:(SET_COUNT++) = DRINK_ID
ENDIF
NEXT
[IF_DEBUG]
PRINTFORML 음료 목록:
FOR LOCAL, 0, DRINK_COUNT
PRINTFORM {LOCAL+1, 2}: {DRINKS:LOCAL, 2} 
LOCALS '= ADD_GAME8_DRINK_NAME(DRINKS:LOCAL)
IF STRLENS(LOCALS)
	PRINTFORML (%LOCALS%)
ELSE
	PRINTFORML 
ENDIF
NEXT
[ENDIF]

@ADD_GAME8_DRINK(CHARA, DRINK)
#DIM CHARA
#DIM DRINK
#DIM DRUNKENNESS_INCREASE
DRUNKENNESS_INCREASE = GET_INT(CHARA, "酒データ", DRINK, "酒気増加量")
IF DRINK != 50 ;overnight kushinada has its own handling
	IF TALENT:CHARA:酒耐性 == -1
		TIMES DRUNKENNESS_INCREASE, 1.2
	ELSEIF TALENT:CHARA:酒耐性 == 1
		TIMES DRUNKENNESS_INCREASE, 0.9
	ELSEIF TALENT:CHARA:酒耐性 == 2
		TIMES DRUNKENNESS_INCREASE, 0.75
	ELSEIF TALENT:CHARA:酒耐性 == 3
		TIMES DRUNKENNESS_INCREASE, 0.5
	ENDIF
ENDIF
BASE:CHARA:酒気 += DRUNKENNESS_INCREASE

@ADD_GAME8_MOLESTATION(CHARA)
#DIM CHARA
#DIM ROUNDS
ROUNDS = MAX(MIN(ABL:CHARA:欲望 / 2, 5) + CFLAG:CHARA:溜まってる度 / 200,1)
;due to the player having blacked out, focus on V Exp, expand on it later
CALL AddEXP("Ｖ性交経験", CHARA, ROUNDS)
CALL AddEXP("絶頂経験", CHARA, ROUNDS)
CALL AddEXP("精液経験", CHARA, ROUNDS)
CALL AddEXP("膣射経験", CHARA, ROUNDS)
CALL AddEXP("絶頂経験", MASTER, ROUNDS)
CALL AddEXP("射精経験", MASTER, ROUNDS)
CALL AddEXP("挿入経験", MASTER, ROUNDS*2)
CFLAG:CHARA:溜まってる度 = 0
CALL ADD_SAMEN_V(CHARA, ROUNDS * 300)
CALL SET_DOUTEILOSS_MASTER(@"%HE_SHE(MASTER)%은 술자리 경쟁에서 진 후 %CALLNAME:CHARA%에게 남성 성적 순결을 빼앗겼다.")
CALL SET_VIRGINLOSS_MASTER(@"그녀는 음주 대회에서 승리를 주장한 후 취해 있던 %조사처리(CALLNAME:MASTER,"에게")% 처녀성을 잃었다.", CHARA)

@ADD_GAME8_PLAYER_JUDGMENT
#DIM CHARA
#DIM DRUNKENNESS_PERCENTAGE
#DIM FUZZINESS_FACTOR
FUZZINESS_FACTOR = 40 - (ABL:MASTER:教養 * 2) ;get better at guessing with higher knowledge
IF FUZZINESS_FACTOR <= 0
	DEBUGPRINTFORML 그 누구도 이 가장 신성한 도전에 속일 수 없다.
	FUZZINESS_FACTOR = 100
ENDIF
DRUNKENNESS_PERCENTAGE = BASE:MASTER:酒気 * 100 / MAXBASE:MASTER:酒気
SIF DRUNKENNESS_PERCENTAGE > 0
	DRUNKENNESS_PERCENTAGE += (RAND:(MAX(FUZZINESS_FACTOR*2, 1)) - FUZZINESS_FACTOR) ;it can go either way
SELECTCASE DRUNKENNESS_PERCENTAGE
	CASE IS <= 15
		PRINTFORML 당신은 여전히 완전히 술이 깨어있는 기분이다.
	CASE IS <= 50
		PRINTFORML 당신은 알코올의 영향을 느끼기 시작한다.
	CASE IS <= 75
		PRINTFORML 이 시점에서는 알코올의 영향이 상당히 느껴진다. 아직 우위에 있을 때 멈추는 것이 현명할지도 모른다.
		PRINTFORML 만약 네가 그들을 막을 만큼 의식이 없다면, 어떤 여자들이 너에게 무슨 짓을 할지 누가 알겠나.
	CASE IS <= 150
		PRINTFORML 당신은 상당히 취한 기분이 든다. 계속하는 것은 현명하지 않을 것이다.
		PRINTFORML 만약 네가 그들을 막을 만큼 의식이 없다면 이 여자들이 너에게 무슨 짓을 할지 누가 알겠는가.
	CASE IS <= 200
		PRINTFORML 당신은 절대적인 한계에 가까워지고 있다. 아직 할 수 있을 때 정말로 그만두어야 한다.
		PRINTFORML 네가 그들을 막을 만큼 의식이 명료하지 않다면, 이 여자들이 너에게 무슨 짓을 할지 누가 알겠는가.
	CASEELSE
		PRINTFORML 아직 깨어있다는 게 놀랍지만, 지금은 절대로 더 가서는 안 된다.
ENDSELECT

@ADD_GAME8_ENEMY_JUDGMENT(CHARA)
#DIM CHARA
#DIM DRUNKENNESS_PERCENTAGE
#DIM FUZZINESS_FACTOR
FUZZINESS_FACTOR = 50 - (ABL:MASTER:教養 * 5) ;get better at guessing with higher knowledge
IF FUZZINESS_FACTOR <= 0
	DEBUGPRINTFORML 그 누구도 이 가장 신성한 도전에 속일 수 없다.
	FUZZINESS_FACTOR = 100
ENDIF
DRUNKENNESS_PERCENTAGE = BASE:CHARA:酒気 * 100 / MAXBASE:CHARA:酒気
DRUNKENNESS_PERCENTAGE += (RAND:(MAX(FUZZINESS_FACTOR*2, 1)) - FUZZINESS_FACTOR) ;it can go either way
SELECTCASE DRUNKENNESS_PERCENTAGE
	CASE IS <= 15
		PRINTFORML %CALLNAME:CHARA%는 여전히 완전히 정신이 깨어 보인다.
	CASE IS <= 50
		PRINTFORML %CALLNAME:CHARA%는 약간 취해 보인다.
	CASE IS <= 90
		PRINTFORML %CALLNAME:CHARA%의 얼굴이 상당히 붉어졌다.
	CASE IS <= 120
		PRINTFORML %CALLNAME:CHARA%은(는) %HIS_HER(CHARA)% 단어들을 상당히 더듬는다.
	CASE IS <= 160
		PRINTFORML %CALLNAME:CHARA%는 비틀거리고 %HIS_HER(CHARA)%의 말투가 알아들을 수 없게 변했다.
	CASE IS <= 200
		PRINTFORML %CALLNAME:CHARA%는 %HE_SHE(CHARA)%의 거의 의식이 없는 것처럼 보인다.
	CASEELSE
		PRINTFORML %CALLNAME:CHARA%는 %HE_SHE(CHARA)%가 완전히 취한 것 같지만 멈출 기미를 보이지 않는다.
ENDSELECT

@ADD_GAME8_TALENT_CHECK(POSITIVE)
#DIM POSITIVE
#DIM DYNAMIC SUCCESS
IF POSITIVE
	;nas custom code, use endurance system
	SELECTCASE AlcoholAddict:MASTER:0
		CASE -5
			SUCCESS = 1
		CASE -4
			SIF !RAND:2
				SUCCESS = 1
		CASE -3
			SIF !RAND:3
				SUCCESS = 1
		CASE -2
			SIF !RAND:4
				SUCCESS = 1
		CASE -1
			SIF !RAND:6
				SUCCESS = 1
		CASE 0
			SIF !RAND:8
				SUCCESS = 1
		CASE 1
			SIF !RAND:10
				SUCCESS = 1
		CASE 2
			SIF !RAND:12
				SUCCESS = 1
		CASE 3
			SIF !RAND:14
				SUCCESS = 1
		CASE 4
			SIF !RAND:16
				SUCCESS = 1
	ENDSELECT
	IF SUCCESS
		;TALENT:MASTER:酒耐性 ++
		AlcoholAddict:MASTER:0--
		DrinkingExp:MASTER:0 = EXP_DEMAND_22(0,91,MASTER)
		PRINTFORML 술내성이 증가하여 당신은 이제 【%GET_TALENTNAME_TR(GETNUM(TALENT, "酒耐性"), TALENT:MASTER:酒耐性)%】이다.
	ENDIF
ELSE
	SELECTCASE AlcoholAddict:MASTER:0
		CASE -4
			SIF !RAND:16
				SUCCESS = 1
		CASE -3
			SIF !RAND:14
				SUCCESS = 1
		CASE -2
			SIF !RAND:12
				SUCCESS = 1
		CASE -1
			SIF !RAND:10
				SUCCESS = 1
		CASE -1
			SIF !RAND:8
				SUCCESS = 1
		CASE 0
			SIF !RAND:6
				SUCCESS = 1
		CASE 1
			SIF !RAND:5
				SUCCESS = 1
		CASE 2
			SIF !RAND:4
				SUCCESS = 1
		CASE 3
			SIF !RAND:3
				SUCCESS = 1
		CASE 4
			SIF !RAND:2
				SUCCESS = 1
		CASE 5
			SUCCESS = 1
	ENDSELECT
	IF SUCCESS
		;TALENT:MASTER:酒耐性 --
		AlcoholAddict:MASTER:0--
		DrinkingExp:MASTER:0 = EXP_DEMAND_22(0,91,MASTER)
		PRINTFORML 그렇게 참담한 파티 이후, 당신의 술내성이 나빠졌다. 당신은 이제【%GET_TALENTNAME_TR(GETNUM(TALENT, "酒耐性"), TALENT:MASTER:酒耐性)%】이다.
	ENDIF
ENDIF
CALLF SILENT_ENDURANCECHANGE(MASTER)

