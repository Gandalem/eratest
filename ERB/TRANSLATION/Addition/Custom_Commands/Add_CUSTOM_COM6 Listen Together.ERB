@ADD_CUSTOM_COM6
#DIM BANQUET_INDEX
#DIM SCALE
IF MARK:反発刻印 >= 3
	PRINTFORML %CALLNAME:TARGET% doesn't want to join you.
	;---------------------------------
	SOURCE:反感 = 300
	BASE:MASTER:気力 -= 100
	RETURN -1
ENDIF

BANQUET_INDEX = ADD_ACTIVE_BANQUET_AT_LOCATION(CFLAG:MASTER:現在位置)
SIF BANQUET_INDEX < 0
	RETURN -1
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

DOWNBASE:気力 += 50
DOWNBASE:MASTER:気力 += 50

;favor increases with quality of concert
SOURCE:歓楽 = MAX(SCALE/3, 500)

;ABL:親密をみる
IF ABL:親密 <= 1
	SOURCE:歓楽 += (ABL:親密 * 30)
ELSEIF ABL:親密 <= 3
	SOURCE:歓楽 += 200 + (ABL:親密 * 30)
ELSEIF ABL:親密 <= 5
	SOURCE:歓楽 += 500 + (ABL:親密 * 30)
ELSEIF ABL:親密 <= 8
	SOURCE:歓楽 += 750 + (ABL:親密 * 50)
ELSEIF ABL:親密 <= 10
	SOURCE:歓楽 += 1000 + (ABL:親密 * 50)
ELSE
	SOURCE:歓楽 += 1600 + (ABL:親密 * 30)
ENDIF

SOURCE:歓楽 = LIMIT(SOURCE:歓楽,0,10000)

SOURCE:受動 = 100 + 150 * ABL:従順
SOURCE:征服 = 100 + 150 * ABL:サドっ気

TIME += 15
IF CHK_DATENOW(CFLAG:TARGET:デート中)
	EXP:MASTER:デート経験 ++
	EXP:TARGET:デート経験 ++
ENDIF

RETURN 1

@ADD_CUSTOM_COM_ABLE6
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF TFLAG:102 != 1
	RETURN 0
SIF !ADD_BANQUET_ACTIVITY_ALLOWED("LISTEN_TO_MUSIC")
	RETURN 0
SIF ADD_BANQUET_CHARA_STATE(TARGET) && ADD_BANQUET_IS_PERFORMER(TARGET, CFLAG:BANQUET)
	RETURN 0
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURN 0
SIF BASE:気力 <= 0 ;is tired
	RETURN 0
;停止中は不可
SIF FLAG:70
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM6
TRYCCALLFORM ADD_BANQUET_LISTEN_TOGETHER_TEXT{CFLAG:BANQUET}
CATCH
	PRINTFORMW You and %CALLNAME:TARGET% listen to the concert together.
ENDCATCH
