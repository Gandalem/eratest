; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM1 Go Swimming.ERB

@ADD_CUSTOM_COM1
IF !TEQUIP:MASTER:SWIMMING
	SIF FLAG:デート相手
		CALL ADD_START_SWIMMING(FLAG:デート相手)
	CALL ADD_START_SWIMMING(MASTER)
	CALL ADD_BYSTANDERS_JOIN_SWIMMING
ELSE
	FOR LOCAL, 0, CHARANUM
	SIF TEQUIP:LOCAL:SWIMMING && Activity_Type:LOCAL != 100
		CALL ADD_END_SWIMMING(LOCAL)
	NEXT
ENDIF
TIME += 5
RETURN 1

@ADD_CUSTOM_COM_ABLE1
SIF !TFLAG:100
	RETURN 0
SIF FLAG:70
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
;一括管理
SIF !ADD_SWIMMING_AREA(CFLAG:MASTER:現在位置)
	RETURN 0
;NAS: Non 0 MASTER
IF FLAG:デート相手 != MASTER ;if with a date, must target date
	SIF (!MOREDATE && TARGET != FLAG:デート相手) || (MOREDATE && !IS_IN_GROUP_DATE(TARGET))
		RETURN 0
	SIF BASE:気力 <= 0 ;date is tired
		RETURN 0
	SIF CFLAG:行動
		RETURN 0
	SIF !ADD_SWIMMING_CONSTITUTION(FLAG:デート相手)
		RETURN 0
ENDIF
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM1
IF TEQUIP:MASTER:SWIMMING
	PRINTFORML 너는 수영을 가기로 결정한다%COND_STR(@" with %CALLNAME:(FLAG:デート相手)%", FLAG:デート相手)%.
ELSE
	PRINTFORML 수영을 그만두고 평상복으로 갈아입는다.
ENDIF

@ADD_SWIMMING_DESCRIPTION(LOCATION)
#FUNCTIONS
#DIM LOCATION
SELECTCASE LOCATION
	CASE GET_MAP_REPLACEMENT(P343湖畔)
		RETURNF "lake"
	CASE GET_MAP_REPLACEMENT(P703玄武の沢)
		RETURNF "river"
	CASEELSE
		RETURNF "water"
ENDSELECT

@ADD_SWIMMING_AREA(LOCATION)
#FUNCTION
#DIM LOCATION
RETURNF GROUPMATCH(LOCATION, GET_MAP_REPLACEMENT(P343湖畔), GET_MAP_REPLACEMENT(P347霧の湖), GET_MAP_REPLACEMENT(P703玄武の沢), GET_MAP_REPLACEMENT(945), GET_MAP_REPLACEMENT(602), GET_MAP_REPLACEMENT(806), GET_MAP_REPLACEMENT(1015))

@ADD_RUNNING_WATER(LOCATION)
#FUNCTION
#DIM LOCATION
RETURNF GROUPMATCH(LOCATION,GET_MAP_REPLACEMENT(P703玄武の沢),GET_MAP_REPLACEMENT(945), GET_MAP_REPLACEMENT(602), GET_MAP_REPLACEMENT(1015))

@ADD_SWIMMING_DAMAGE(ARG)
#FUNCTION
SIF (GET_TRIBENAME(ARG, GETNUM(TALENT, "妖怪")) == "吸血鬼" || TALENT:ARG:吸血鬼) && ADD_RUNNING_WATER(CFLAG:ARG:現在位置)
	RETURNF 2
SIF (!ADD_SWIMMING_SEASON() && CFLAG:ARG:現在位置/100 != 9) && !TALENT:ARG:水棲 && !TALENT:ARG:氷精
	RETURNF 1
RETURNF 0

@ADD_SWIMMING_SEASON
#FUNCTION
SELECTCASE DAY:2
	CASE 1
		RETURNF DAY:3 > 15 ;second half of spring is warm enough
	CASE 2
		RETURNF 1
	CASE 3
		RETURNF DAY:3 < 15 ;second half of autumn is still warm enough
	CASE 4
		RETURNF 0 ;too cold for normal people
ENDSELECT

@ADD_START_SWIMMING(ARG)
IF !ADD_IN_SWIMWEAR(ARG)
	CALL ADD_SWIMMING_OUTFIT(ARG)
ENDIF
TEQUIP:ARG:SWIMMING = 1

@ADD_END_SWIMMING(ARG)
IF TCVAR:ARG:EVENT_CLOTHING_SET
	SIF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
		PRINTFORML %CALLNAME:ARG%은 원래의 %HIS_HER(ARG)% 평상복으로 돌아간다.
	CALL RESET_EVENT_CLOTHES(ARG)
ENDIF
TEQUIP:ARG:SWIMMING = 0

@ADD_SWIMMING_OUTFIT(ARG)
#DIM DYNAMIC WEIGHTS, 100
;skinny dipping? (do later)
#DIM BIKINI
#DIM MICRO_BIKINI
#DIM SCHOOL_SWIMSUIT
#DIM COMPETITION_SWIMSUIT
#DIM ONE_PIECE_SWIMSUIT
#DIM SLING_SWIMSUIT
#DIM SWIMMING_TRUNKS
#DIM SWIM_DIAP; nas customs
#DIM SELECTED_SWIMWEAR
#DIM DYNAMIC EROTICISM
IF !BIKINI ;only fetch ids once, since they're not character-dependent
	SWIMMING_TRUNKS = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "スイミングトランクスセット")
	BIKINI = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "ビキニセット")
	MICRO_BIKINI = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "マイクロビキニセット")
	SCHOOL_SWIMSUIT = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "スクール水着セット")
	COMPETITION_SWIMSUIT = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "競泳水着セット")
	ONE_PIECE_SWIMSUIT = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "ワンピース水着セット")
	SLING_SWIMSUIT = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "スリングショットセット")
	SWIM_DIAP = OBJNAME_TO_ID(ARG, "GET", "衣装セット", "Swim Diaper Set")
ENDIF
IF CANT_UNDIES(ARG)
	;skip those who can't wear undies
	SELECTED_SWIMWEAR = 100
ELSEIF (CanWearUnderwear(ARG, "Diaper")) && nOmutsu
	;NAS: incon 2hus wear swim diapers
	SELECTED_SWIMWEAR = SWIM_DIAP
ELSEIF IS_FEMALE(ARG)
	IF !TALENT:ARG:無知 || TALENT:ARG:小悪魔 ;not ignorant, or a temptress
		EROTICISM = MIN(ABL:ARG:露出癖, 30) ;exposure
		EROTICISM -= OTOKOGIRAI(ARG) ? 3 # 0 ;misandrist
		EROTICISM += TALENT:ARG:性的興味 * 2 ;conservative/curious
		EROTICISM += TALENT:ARG:目立ちたがり * 3 ;show-off
		EROTICISM += TALENT:ARG:セフレ ? 3 # 0 ;sex friend
		EROTICISM += TALENT:ARG:愛欲 * 5 ;lust
		EROTICISM -= TALENT:ARG:貞操 * 5 ;virtuous/unchaste
		EROTICISM += TALENT:ARG:小悪魔 * 10 ;seductress
		EROTICISM += TALENT:ARG:バストサイズ * 2 ;breast size
		EROTICISM += TALENT:ARG:ヒップサイズ * 2 ;butt size
		EROTICISM -= TALENT:ARG:羞恥心 * 6 ;shameless/shy
		SIF GET_TARGETNUM() > 1 && !TALENT:ARG:淫乱
			EROTICISM /= 2
		EROTICISM = MAX(EROTICISM, 0)
		SIF TALENT:ARG:無知 && !TALENT:ARG:小悪魔 ;ignorant, not a temptress
			EROTICISM = 0
	ENDIF
	WEIGHTS:BIKINI = 20
	WEIGHTS:MICRO_BIKINI = EROTICISM
	WEIGHTS:ONE_PIECE_SWIMSUIT = 10
	WEIGHTS:COMPETITION_SWIMSUIT = ABL:ARG:戦闘能力 * 2 * (CFLAG:ARG:性格傾向 == 4 ? 2 # 1) ;combat skill + serious personality
	IF (IS_CHILD(ARG, "mind") || IS_CHILD(ARG, "age")) && !TALENT:ARG:小悪魔 ;child's mindset
		WEIGHTS:MICRO_BIKINI /= 2
		WEIGHTS:SCHOOL_SWIMSUIT = 40
		IF TALENT:ARG:バストサイズ < 0
			WEIGHTS:SWIMMING_TRUNKS = 5
		ELSE
			WEIGHTS:SLING_SWIMSUIT = EROTICISM / 4
		ENDIF
	ELSEIF IS_CHILD(ARG, "body") && !TALENT:ARG:小悪魔 ;child's body
		WEIGHTS:SCHOOL_SWIMSUIT = 10
		WEIGHTS:ONE_PIECE_SWIMSUIT = 20
		IF TALENT:ARG:バストサイズ < 0
			WEIGHTS:SWIMMING_TRUNKS = 5
		ELSE
			WEIGHTS:SLING_SWIMSUIT = EROTICISM / 2
		ENDIF
	ELSE
		WEIGHTS:SCHOOL_SWIMSUIT = EROTICISM / 2 ;it's basically fetish wear to adults
		WEIGHTS:SLING_SWIMSUIT = EROTICISM
		SIF TALENT:ARG:バストサイズ < 0
			WEIGHTS:SWIMMING_TRUNKS = EROTICISM / 4
	ENDIF
	SELECTED_SWIMWEAR = ARRAY_HIT(WEIGHTS, 100)
ELSE
	SELECTED_SWIMWEAR = SWIMMING_TRUNKS
ENDIF
IF ARG == MASTER
	PRINTFORML 당신은 빠르게 수영복으로 갈아입는다.
ELSEIF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置 ;only show dialogue if present
	IF ABL:ARG:露出癖 < 5 || (GET_TARGETNUM() > 1 && ABL:ARG:露出癖 < 10)
		PRINTFORML %CALLNAME:ARG%는 근처 바위 뒤로 가서 %HIS_HER(ARG)% 수영복으로 갈아입는다.
		PRINTFORM %HE_SHE(ARG)%가 돌아왔을 때, 당신은 %HIM_HER(ARG)%가 입고 있는 것을 본다 
	ELSE
		PRINTFORML %CALLNAME:ARG%은(는) %HIS_HER(ARG)% 수영복으로 변신하며, \@ GET_TARGETNUM() > 1 ? 당신이 보고 있는 사람들 # 당신을 \@ 전혀 신경 쓰지 않는다 %HIM_HER(ARG)%.
		PRINTFORM 시간이 오래 걸리지 않아 %HE_SHE(ARG)%가 끝나고 당신은 %HIM_HER(ARG)%이 입고 있는 것을 본다. 
	ENDIF
	SELECTCASE SELECTED_SWIMWEAR
		CASE 0
			PRINTFORML 아무것도 없다.
		CASE SWIM_DIAP
			PRINTFORML 수영을 위한 기저귀.
		CASE BIKINI
			PRINTFORML %HIS_HER(ARG)%의 체형에 완벽하게 어울리는 귀여운 비키니.
		CASE MICRO_BIKINI
			PRINTFORM 대담한 마이크로 비키니가 
			SELECTCASE TALENT:ARG:バストサイズ
				CASE -3
					PRINTFORML %HIS_HER(ARG)%의 완벽하게 평평한 가슴에 깊이 비도덕적으로 보인다.
				CASE -3
					PRINTFORML %HIS_HER(ARG)%의 아주 작은 가슴에는 맞지 않는다.
				CASE -1
					PRINTFORML 날씬한 체형과 선명하게 대비된다.
				CASE 0
					PRINTFORML 그것은 %HIM_HER(ARG)%에게 성숙한 분위기를 준다.
				CASE 1
					PRINTFORML %HIS_HER(ARG)%의 가슴을 더욱 부각시킨다.
				CASE 2, 3, 4
					PRINTFORML %HIS_HER(ARG)%의 가슴을 겨우 감당할 수 있다.
			ENDSELECT
		CASE SCHOOL_SWIMSUIT
			PRINTFORML %HIS_HER(ARG)% 이름이 새겨진 스쿨 수영복을.
			SIF TALENT:ARG:バストサイズ > 0
				PRINTFORML 하지만 그것은 \@ TALENT:ARG:ヒップサイズ > 0 ? 가슴과 허리 # 가슴 \@ 주변이 상당히 조여 보이는 것 같았다.
			SIF TALENT:ARG:ヒップサイズ > 0 && TALENT:ARG:バストサイズ <= 0
				PRINTFORML 하지만 허리 부분이 다소 타이트해 보인다.
		CASE COMPETITION_SWIMSUIT
			PRINTFORML 활동적이고 편안한 수영복.
		CASE ONE_PIECE_SWIMSUIT
			PRINTFORML 귀여운 수영복.
		CASE SLING_SWIMSUIT
			PRINTFORM 에로틱한 슬링 수영복을, 
			SELECTCASE TALENT:ARG:バストサイズ
				CASE -2,-3
					PRINTFORML 그게 %HIM_HER(ARG)%에게 전혀 어울리지 않는다.
				CASE -1
					PRINTFORML 용감해 보이기보다 더 귀여워 보이는 쪽으로 끝나게 되는 것을 %HIM_HER(ARG)%은(는).
				CASE 0
					PRINTFORML 그것을 겨우 가리는 것.
				CASE 1
					PRINTFORML 상상할 여지를 거의 남기지 않는.
				CASE 2,3,4
					PRINTFORML 그것은 %HIS_HER(ARG)%의 거대한 가슴에 팽팽하게 당겨져 있다.
			ENDSELECT
		CASE SWIMMING_TRUNKS
			IF IS_MALE(ARG)
				PRINTFORML 단순한 수영복 반바지 
			ELSE
				PRINTFORML 남성용 수영복 한 벌 
			ENDIF
			SELECTCASE TALENT:ARG:ヒップサイズ
				CASE -3
					PRINTFORML 그 %HE_SHE(ARG)%이 계속 다시 끌어올려야 한다.
				CASE -2
					PRINTFORML 조금 너무 큰 것 같다.
				CASE -1
					PRINTFORML 거의 %HIM_HER(ARG)%의 무릎까지 오는 것.
				CASE 0
					PRINTFORML .
				CASE 1
					PRINTFORML 조금 너무 작아 보이는 것들이다.
				CASE 2
					PRINTFORML 그것보다 비키니 쇼츠에 더 가까운 것들.
				CASE 3
					PRINTFORML 그저 %HIS_HER(ARG)%의 거대한 뒤태를 겨우 가리는 것.
				CASE 4
					PRINTFORML 거의 %HIS_HER(ARG)%의 %HIP_TR(ARG)%를 전혀 가리지 않는.
			ENDSELECT
	ENDSELECT
ENDIF
CALL SET_EVENT_CLOTHES(ARG, SELECTED_SWIMWEAR)

@ADD_IN_SWIMWEAR(ARG)
#FUNCTION
RETURNF GET_INT(ARG, "衣装セット", CFLAG:ARG:基本服装セット, "SWIMWEAR")

@ADD_BYSTANDERS_JOIN_SWIMMING
FOR LOCAL, 1, GET_TARGETNUM() + 1
IF !TEQUIP:(TARGET:LOCAL):SWIMMING && ADD_SWIMMING_CONSTITUTION(TARGET:LOCAL) && !(MARK:(TARGET:LOCAL):反発刻印 >= 3 || CFLAG:(TARGET:LOCAL):ブチギレ) ; NAS: Hate 4 and 5
	CALL ADD_START_SWIMMING(TARGET:LOCAL)
ENDIF
NEXT

@ADD_WEATHER_HARSHNESS(LOCATION)
#FUNCTION
#DIM LOCATION
;based on COM411
SIF !OUTROOF(LOCATION) ;probably won't be relevant unless Remilia's pool is ever included
	RETURNF 0
SELECTCASE TIME:5
	CASE 4,6,8,10,12,13
		IF WIND_VELOCITY >= 1
			;(天候パッチ)強風時はヤバい天気
			RETURNF 2
		ELSE
			;悪天候
			RETURNF 1
		ENDIF
	CASE 5,9,14,15
		;ヤバい天気
		IF WIND_VELOCITY >= 1
			RETURNF 3
		ELSE
			RETURNF 2
		ENDIF
		;それ以外
	CASEELSE
		;(天候パッチ)強風時は悪天候
		SIF WIND_VELOCITY == 1
			RETURNF 1
		;(天候パッチ)暴風時はヤバい天気
		SIF WIND_VELOCITY >= 2
			RETURNF 2
ENDSELECT
RETURNF 0
;checks if character will join in, even in dangerous conditions

@ADD_SWIMMING_CONSTITUTION(WEATHER_HARSHNESS, CHARA)
#FUNCTION
#DIM WEATHER_HARSHNESS
#DIM CHARA
SIF !CHARA
	RETURNF 1 ;master can always join
SIF !BASE:CHARA:気力 ;no energy left
	RETURNF 0
LOCAL = ADD_SWIMMING_DAMAGE(CHARA)
IF LOCAL > 1 && MAXBASE:CHARA:体力 < 4000 ;vampires need a strong constitution to join in
	RETURNF 0
ELSEIF LOCAL == 1 && MAXBASE:CHARA:体力 < 2500 ;cold, not resistant, need good constitution to join in
	RETURNF 0
ENDIF
SELECTCASE WEATHER_HARSHNESS ;can join if they have a high constitution (determined by max STA)
	CASE 0
		RETURNF 1
	CASE 1
		SIF MAXBASE:CHARA:体力 >= 2000
			RETURNF 1
	CASE 2
		SIF MAXBASE:CHARA:体力 >= 3500
			RETURNF 1
	CASE 3
		SIF MAXBASE:CHARA:体力 >= 5000
			RETURNF 1
ENDSELECT
RETURNF 1
