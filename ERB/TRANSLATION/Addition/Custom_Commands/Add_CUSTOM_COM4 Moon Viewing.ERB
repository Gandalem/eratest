; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM4 Moon Viewing.ERB

@ADD_CUSTOM_COM4
;similar to standard conversation, but a bit stronger
IF MARK:反発刻印 >= 3
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 당신과 이야기하는 것에 전혀 관심이 없다.
	TFLAG:193 = -3 ;addition custom code
	;---------------------------------
	SOURCE:反感 = 300
	BASE:MASTER:気力 -= 100
	RETURN -1
ENDIF
SELECTCASE TFLAG:192
	;通常
	CASE 0
		LOCAL = RAND:100
		LOCAL:1 = MIN(90 + GET_SUCCESS_RATE() / 5, 99)
		;相手が泥酔中だと大成功にも失敗にもならない
		SIF TCVAR:泥酔
			LOCAL = 50
		IF LOCAL < 5
			;7％で大成功
			TFLAG:193 = 1
			TFLAG:98 = 1
			EXP:MASTER:会話経験 ++
			IF CHK_DATENOW(CFLAG:TARGET:デート中)
				EXP:MASTER:デート経験 ++
				EXP:TARGET:デート経験 ++
			ENDIF
			IF TALENT:恋慕 && TIME:5 < 3;love
				EXP:愛情経験 += 1
			ENDIF
		ELSEIF LOCAL >= LOCAL:1
			;10～1％で失敗
			TFLAG:193 = -1
			TFLAG:98 = -1
		ELSE
			;残りは成功
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
		;強制成功or大成功
	CASE 1
		IF RAND:100 <= 7
			TFLAG:193 = 1
			TFLAG:98 = 1
			EXP:MASTER:会話経験 ++
			IF CHK_DATENOW(CFLAG:TARGET:デート中)
				EXP:MASTER:デート経験 ++
				EXP:TARGET:デート経験 ++
			ENDIF
			IF TALENT:恋慕 && TIME:5 < 3;love
				EXP:愛情経験 += 1
			ENDIF
		ELSE
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
		;強制失敗
	CASE -1
		TFLAG:193 = -1
		TFLAG:98 = -1
		;コマンド終了
	CASE -2
		TFLAG:193 = -1
		RETURN 0
ENDSELECT
;先制発生時は失敗しない
SIF TCVAR:20
	TFLAG:193 = MAX(TFLAG:193,0)
IF CFLAG:TARGET:添い寝中
	DOWNBASE:MASTER:気力 += 10
	SOURCE:情愛 = 200
ELSE
	DOWNBASE:気力 += 20
	DOWNBASE:MASTER:気力 += 20
ENDIF
SIF ABL:教養 > ABL:MASTER:教養 + 3
	TFLAG:193 = -2
;固定で獲得するソース
SOURCE:歓楽 = 400
;ABL:親密をみる
IF ABL:親密 <= 1
	SOURCE:歓楽 += (ABL:親密 * 40)
ELSEIF ABL:親密 <= 3
	SOURCE:歓楽 += 200 + (ABL:親密 * 40)
ELSEIF ABL:親密 <= 5
	SOURCE:歓楽 += 500 + (ABL:親密 * 40)
ELSEIF ABL:親密 <= 8
	SOURCE:歓楽 += 750 + (ABL:親密 * 60)
ELSEIF ABL:親密 <= 10
	SOURCE:歓楽 += 1000 + (ABL:親密 * 60)
ELSE
	SOURCE:歓楽 += 1600 + (ABL:親密 * 40)
ENDIF
SOURCE:歓楽 = LIMIT(SOURCE:歓楽,0,15000)
SOURCE:受動 = 100 + 150 * ABL:従順
SOURCE:征服 = 100 + 150 * ABL:サドっ気
IF TFLAG:193 == -1 || TFLAG:193 == -2
	TIMES SOURCE:歓楽 , 0.10
	TIMES SOURCE:征服 , 0.50
	TIMES SOURCE:受動 , 0.50
ELSEIF TFLAG:193 == 0
	TIMES SOURCE:歓楽 , 1.00
	TIMES SOURCE:征服 , 1.00
	TIMES SOURCE:受動 , 1.00
ELSE
	TIMES SOURCE:歓楽 , 2.00
	TIMES SOURCE:征服 , 2.00
	TIMES SOURCE:受動 , 2.00
	TCVAR:301 += 50
ENDIF
SELECTCASE ABL:MASTER:話術技能
	CASE 0
		TIMES SOURCE:歓楽 , 0.40
		TIMES SOURCE:征服 , 0.40
		TIMES SOURCE:受動 , 0.40
	CASE 1
		TIMES SOURCE:歓楽 , 0.60
		TIMES SOURCE:征服 , 0.60
		TIMES SOURCE:受動 , 0.60
	CASE 2
		TIMES SOURCE:歓楽 , 0.80
		TIMES SOURCE:征服 , 0.80
		TIMES SOURCE:受動 , 0.80
	CASE 3
		TIMES SOURCE:歓楽 , 1.20
		TIMES SOURCE:征服 , 1.20
		TIMES SOURCE:受動 , 1.20
	CASE 4
		TIMES SOURCE:歓楽 , 1.40
		TIMES SOURCE:征服 , 1.40
		TIMES SOURCE:受動 , 1.40
	CASEELSE
		TIMES SOURCE:歓楽 , 1.70
		TIMES SOURCE:征服 , 1.70
		TIMES SOURCE:受動 , 1.70
ENDSELECT
TIME += 10
EXP:MASTER:会話経験 ++
IF CHK_DATENOW(CFLAG:TARGET:デート中)
	EXP:MASTER:デート経験 ++
	EXP:TARGET:デート経験 ++
ENDIF
IF TALENT:恋慕 && TIME:5 < 3;love
	EXP:愛情経験 += 1
ENDIF
;相手が泥酔中だと効果大幅低減
IF TCVAR:泥酔
	TIMES SOURCE:歓楽 , 0.50
	TIMES SOURCE:征服 , 0.50
	TIMES SOURCE:受動 , 0.50
ENDIF
IF TIME:5 >= 3 ;moon not visible
	TIMES SOURCE:歓楽 , 0.10
	TIMES SOURCE:征服 , 0.10
	TIMES SOURCE:受動 , 0.10
ENDIF
RETURN 1

@ADD_CUSTOM_COM_ABLE4
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF TFLAG:102 != 1
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
SIF !ADD_BANQUET_ACTIVITY_ALLOWED("MOON_VIEWING")
	RETURN 0
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURN 0
SIF BASE:気力 <= 0 ;is tired
	RETURN 0
;停止中は不可
SIF FLAG:70
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM4
PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"를")%/를 함께 달을 보러 초대한다.
IF TIME:5 >= 3 ;moon not visible
	PRINTFORML 하지만 지금 달이 보이지 않으니 좀 허무하다.
ELSEIF TALENT:恋慕
	PRINTFORML 사랑스러운 달을 함께 바라보며, 당신은 %조사처리(CALLNAME:TARGET,"에게")% 점점 가까워지는 것을 느낀다.
ELSE
	PRINTFORML 두 분은 달을 보며 가벼운 대화를 나눈다.
ENDIF
