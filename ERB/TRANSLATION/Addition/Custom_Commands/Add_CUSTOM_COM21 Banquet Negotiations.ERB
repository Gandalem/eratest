@ADD_CUSTOM_COM21
#DIM BANQUET_INDEX
#DIM SCALE
IF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P502香霖堂) && !GETBIT(ADD_BANQUET12_TOOLS, 3) && INRANGE(TIME, 600, 1080)
	PRINTFORMDL You enter the store. As you walk up to the storekeeper, he looks up from his book and greets you with some trepidation.
	CALL SPTALK, 0, "笑顔", 90, "「Hm? Oh, welcome! How may I help you?」", 1
	WAIT
	PRINTFORMDL You explain to Rinnosuke that you're looking for a high-quality set of tableware to enhance a dinner party.
	CALL SPTALK, 0, "笑顔", 90, "「Something fancy, right? Well, I believe there should be some around there.」", 1
	PRINTFORMDL He motions towards a large pile of merchandise sitting in the corner, which contains many different kinds of tableware.
	CALL SPTALK, 0, "笑顔", 90, "「Please excuse the mess. I haven't had the time to sort them out yet.」", 1
	PRINTFORMDL Seemingly satisfied with the amount of aid he's given, the half-youkai returns to his book.
	PRINTFORMDW With no other recourse, you begin sorting out the various goods.


	;cleaning check
	LOCAL = 5 - ABL:MASTER:清掃技能 
	IF LOCAL <= 0 || !RAND:LOCAL
		PRINTFORMDL After sifting through all the cups, the plates, bowls and the cutlery, you finally find enough of each for your purposes.
		PRINTFORMDW They're terribly mismatched and it's obvious that they belonged to different sets, but at least they're fancy.
		PRINTFORMDL You bring your haul up to the storekeeper, who begins a detailed explanation of the history of the various items.
		PRINTFORMDL Forced to sit through his lecture, he pays little attention to you as he continues his spiel.
		PRINTFORMDL You nod politely as he speaks, patiently waiting for him to finish.
		PRINTFORMDL His long, rambling story eventually coming to an end, though you do not retain any of the information.

		PRINTFORMDL At least this should make the banquets look a little better.
		PRINTFORMDL You purchase the set of Royal Doulton with hand-painted periwinkles.
		CALL LOST_MONEY_YEN(20000, 2) 
		SETBIT ADD_BANQUET12_TOOLS, 4
	ELSE
		PRINTFORMDL As you work your way through the various plates, bowls, and other goods, you steadily lose focus on your task.
		PRINTFORMDL Eventually, you find yourself forced to give up, unable to force yourself to continue this herculean task.
		CALL PRINT_STRW, @"Perhaps you should try some other time, or perhaps you should train your diligence in housework first."
	ENDIF

	TIME += 180
ELSE
	IF MARK:反発刻印 >= 3
		PRINTFORMDL %CALLNAME:TARGET% doesn't want to talk to you.
		RETURN -1
	ENDIF

	SELECTCASE TARGET
		CASE [[勇儀]]
			CALL SET_KOJO_COLOR([[勇儀]])
			PRINTFORMDW You ask Yuugi if she's willing to lend you her sake dish.
			
			PRINTFORML 「Whoa there, this dish is my %COND_STR("longest-lasting and second-", TALENT:[[勇儀]]:恋慕)%most trusted partner.」
			PRINTFORML 「I can't be separated from it even for an instant.」
			PRINTFORMW 「What do you even need it for?」

			PRINTFORML 「Fixing the awful sake from that bratty celestial's banquets, huh.」
			PRINTFORML 「Well, if you don't want to drink it, just be honest with her and tell her you don't want to join her party.」
			PRINTFORMW 「Pussying around like this just makes you look weak, y'know?」
			PRINTFORMDL You try to explain the delicate nature of the matter to Yuugi, but she looks at you with nothing but disinterest on her face.
			PRINTFORML 「Sounds like you're just making excuses to me.」
			PRINTFORML 「I'm not gonna give you my dish, but I could tell you a couple of my own tricks to make any sake taste better.」
			PRINTFORMDW Yuugi stands up straight, her imposing figure \@ TALENT:MASTER:体型 < 2 ? towering over # standing firm against \@ you.
			PRINTFORML 「Of course, I won't just hand 'em out for nothing.」
			PRINTFORML 「If you wanna know my secrets, you'll have to fight me for them.」

			PRINTFORMDL Accept Yuugi's challenge?
			CALL ASK_YN
			IF !RESULT
				SIF AT_HOME(MASTER) && !OUTROOF(CFLAG:MASTER:現在位置) && !戦闘訓練可(CFLAG:MASTER:現在位置)
					PRINTFORML You and Yuugi move to somewhere with enough space for a Danmaku battle.
				CALL SPECIAL_DANMAKU_CHALLENGE([[勇儀]],300,100)
				CALL SET_KOJO_COLOR([[勇儀]])
				IF RESULT
					;yuugi laugh
					PRINTFORML 「Ahahahaha!」
					PRINTFORML 「You sure gave me a good whalloping there.」
					PRINTFORMW 「Sure, I'll tell you what I know. You've more than earned it.」
				ELSE
					PRINTFORML 「That was pretty disappointing.」
					PRINTFORMW 「But you did have the balls to face me head-on, so that's good enough for me. I'll tell you what I know.」
				ENDIF
				PRINTFORML 「Now, there are three ways to make even lousy sake taste good.」
				PRINTFORML 「The first is by drinking with friends.」
				PRINTFORML 「The second is by drinking while watching a good fight.」
				PRINTFORML 「And lastly, the third way to improve your sake is through aesthetics.」
				PRINTFORMW 「As long as you make it look great, it'll taste great, too.」
				PRINTFORML 「I can't lend you my dish, but I can give you this one.」
				PRINTFORML 「It's a replica of my own dish that we sell as souvenirs here.」
				PRINTFORML 「There's no magic in it, but the craftsmanship is excellent, and drinking from it is sure to improve your mood.」
				PRINTFORML 「Go ahead, take it as a reward for the fight you gave me.」
				PRINTFORMDL This wasn't all what you hoped for, but perhaps you can make this work regardless.
				PRINTFORMDW You'll just need to source your oni magic from somewhere else...
				SETBIT ADD_BANQUET12_TOOLS, 0
				CALL COLORMESSAGE("You obtained a replica sake dish.",C_YELLOW,2,1)
			ELSE
				PRINTFORML 「Oh well. Come back when you're ready.」
				PRINTFORMW 「I'm always itching for a good fight.」
			ENDIF
			TIME += 15
		CASE [[針妙丸]]
			CALL SET_KOJO_COLOR([[針妙丸]])
			PRINTFORMDL You straightforwardly ask Shinmyoumaru if she can infuse your replica sake dish with some of her magic.
			PRINTFORML 「Well, the Mallet should be really compatible with an oni item, but it's really dangerous to use it like that!」
			PRINTFORMW 「The magic is unpredictable, and there's always a price to pay for using it.」

			IF ABL:MASTER:話術技能 < 5
				PRINTFORMDL You try to reason with the inchling, but you fail to present your argument in a convincing manner.
				PRINTFORML 「Sorry, but I really can't do it. It's not worth the risk.」
				PRINTFORMDW Perhaps you should practice your rhetorical skills before trying again. 
				TIME += 15
			ELSE
				PRINTFORMDL You try to reason with the inchling, arguing that since you're only using a little bit of magic, it shouldn't cause any real problems.
				PRINTFORMW 「Even if you say that, it's just too big of a risk. And Reimu would get really mad if she found out...」
				PRINTFORMDL "Why should only the oni have access to good sake?", you ask Shinmyoumaru.
				PRINTFORMDL "Doesn't everyone have a right to a good drink?"
				PRINTFORMDL "We're not doing anything bad, we're just bringing equality to the weak and thirsty."
				PRINTFORMDL You speak at length on how you're really standing up for those oppressed by the oni and their hoarding of magical artifacts.
				PRINTFORMDL As you continue to give your passionate speech, Shinmyoumaru gradually becomes more and more convinced.
				PRINTFORMDW It doesn't take long before she cheerfully agrees to your request.
				PRINTFORML 「You're right, it's time for us weaklings to rise up and take what we deserve!」
				PRINTFORMDL With a smug smile on her face, Shinmyoumaru swings her mallet around, imbuing your dish with a touch of magic.
				PRINTFORMW 「There, all done. It should work just like the real deal now.」
				PRINTFORMDL You hold the dish in your hand. You can feel magic emanating from it, just as Shinmyoumaru said.
				PRINTFORMDL You figure it's best to test it out first. You pour some cheap sake into the dish and move it around a little.
				PRINTFORMDL Shinmyoumaru looks on anxiously as you move it to your lips and take a sip of the sake.
				PRINTFORMDW It tastes quite good! The magic seems to be working.
				PRINTFORML 「Lemme try, too!」
				PRINTFORMDL You take a tiny cup and pour out some sake for Shinmyoumaru.
				PRINTFORMDL She has a bright smile on her face as she chugs it down in one go.
				PRINTFORML 「Whoa, that's awesome! Gimme more!」
				PRINTFORMDW You pour another cup for Shinmyoumaru and yourself, and the two of you toast to a successful strike against the strong. 
				PRINTFORMDL ...
				PRINTFORMDL The sake keeps flowing like water and the two of you keep guzzling it down without restraint.
				PRINTFORMDL Downing cup after cup, the two of you show no restraint as you lose yourselves in the magic of the alcohol.
				PRINTFORMDL By the time the sake runs dry, you're already too far gone to realize.
				PRINTFORMDW The Mallet's price came sooner than you expected... 

				BASE:MASTER:酒気 = MAXBASE:MASTER:酒気
				BASE:[[針妙丸]]:酒気 = MAXBASE:[[針妙丸]]:酒気

				CALL COLORMESSAGE("The replica sake dish has been imbued with the Miracle Mallet's magic.",C_YELLOW,2,1)
				SETBIT ADD_BANQUET12_TOOLS, 1
				TIME += 240
			ENDIF

		CASE [[穣子]]
			CALL SET_KOJO_COLOR([[穣子]])
			IF GETBIT(ADD_BANQUET12_TOOLS, 2)
				PRINTFORML 「Did you bring everything?」
				IF ITEM:キャベツ >= 10 && ITEM:カブ >= 10 && ITEM:ナス >= 10 && ITEM:ハクサイ >= 10
					PRINTFORMDL Hand over the requested items?
					CALL ASK_YN
					IF !RESULT
						PRINTFORML 「Excellent! Let's get right to work, then.」
						GOTO MINORIKO_TEACHINGS
					ENDIF
				ELSE
					PRINTFORMDL You should obtain 10 heads of cabbage, 10 turnips, 10 eggplants, and 10 bok choy before asking Minoriko for help.
				ENDIF
			ELSEIF CFLAG:[[穣子]]:好感度 < 500
				PRINTFORML 「Sorry, I don't have time to help you. I'm a busy goddess, I'm sure you understand.」
				PRINTFORMDW Minoriko brushes you off without even hearing you out. Perhaps you need to get closer to her first.
				TIME += 15
			ELSE
				PRINTFORML 「You want to learn how to prepare good food for a party?」
				PRINTFORML 「Well, you've made a smart decision coming to me for help. There's nobody who knows more about the bounty of the land than me.」
				PRINTFORML 「I'm \@ DAY:2 == 3 ? super # pretty \@ busy, but since it's you, I'll make some time to teach you everything you need to know.」

				SETBIT ADD_BANQUET12_TOOLS, 2
				PRINTFORML 「Bring me 10 heads of cabbage, 10 turnips, 10 eggplants, and 10 bok choy and I'll teach you all the best ways to prepare them.」
				
				IF ITEM:キャベツ >= 10 && ITEM:カブ >= 10 && ITEM:ナス >= 10 && ITEM:ハクサイ >= 10
					PRINTFORMDL Hand over the requested items?
					CALL ASK_YN
					IF !RESULT
						PRINTFORML 「You already brought everything? Excellent! Let's get right to work.」
						$MINORIKO_TEACHINGS
						PRINTFORMDW Minoriko takes you over to her home's kitchen.
						PRINTFORMDL She gives you a detailed explanation on how the produce is grown, how to harvest them, and how to spot good ones from bad.
						PRINTFORMDL She also teaches you a number of recipes suitable for hosting parties that are quick and easy to make.
						PRINTFORMDL Lastly, she teaches you some tricks to make good use of even the low-quality parts of the produce you'd otherwise discard.
						PRINTFORMDW It's all good advice, but you're not sure it'll really be enough to fix the Heavenly Banquets.
						PRINTFORML 「And that's all for now. Is there anything else you'd like to know?」
						PRINTFORMDL You ask her if she has any advice on how to work obscure weeds and other tasteless herbs into a decent meal.
						PRINTFORML 「Pardon? Why would you even want to eat those? Surely you wouldn't try to serve those to your guests, right?」
						PRINTFORMDL You start talking about the last Heavenly Banquet, and the various "foods" the Celestial and the Poverty God prepared.
						PRINTFORMDL As you continue your detailed description of events, Minoriko's face contorts into a painful grimace as she imagines the horrors you endured. 
						PRINTFORMW 「How awful. And given her character, I can't imagine you could convince her to give up on her "banquets".」
						PRINTFORML 「Listen, I normally wouldn't do this, but I do have a secret weapon for emergencies.」
						PRINTFORML 「It's my very own blend of herbs and spices that I developed over the centuries.」
						PRINTFORML 「I want you to have it. I think I can entrust it to you.」
						PRINTFORML 「I don't think it'll be able to ever make that girl's food taste good, but it should at least take the edge off.」
						PRINTFORMW 「Good luck, %CALLNAME:MASTER%. Know that this god's prayers are with you.」

						SETBIT ADD_BANQUET12_TOOLS, 3
						CALL COLORMESSAGE("You obtained Minoriko's secret blend of herbs and spices.",C_YELLOW,2,1)
						EXP:MASTER:料理経験 += 25
						TIME += 150
					ELSE
						TIME += 15
					ENDIF
				ELSE
					TIME += 15
				ENDIF
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

@ADD_CUSTOM_COM_ABLE21
SIF !TFLAG:100
	RETURN 0
SIF !ADD_BANQUET12_BAD_EXPERIENCE
	RETURN 0
SIF CFLAG:MASTER:うふふ
	RETURN 0
;停止中は不可
SIF FLAG:70
	RETURN 0
IF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(P502香霖堂) && !GETBIT(ADD_BANQUET12_TOOLS, 4) && INRANGE(TIME, 600, 1080)
	SIF MONEY < 20000
		RETURN 0
ELSEIF TARGET
	SELECTCASE TARGET
		CASE [[勇儀]]
			SIF GETBIT(ADD_BANQUET12_TOOLS, 0) ;already got it
				RETURN 0
		CASE [[針妙丸]]
			SIF GETBIT(ADD_BANQUET12_TOOLS, 1) ;already got it
				RETURN 0
			SIF !GETBIT(ADD_BANQUET12_TOOLS, 0) ;need dish from yuugi first
				RETURN 0
		CASE [[穣子]]
			SIF GETBIT(ADD_BANQUET12_TOOLS, 3) ;already got it
				RETURN 0
		CASEELSE
			RETURN 0
	ENDSELECT
ELSE
	RETURN 0
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM21
