; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM7 Request Meeting Point.ERB

@ADD_CUSTOM_COM7
#DIM REQUEST_CLIENT
#DIM REQUEST_TARGET
#DIM CHK_SLOT
FOR CHK_SLOT, 1, COUNT_IRAI_SLOT() + 1
REQUEST_CLIENT = IRAI_SLOT_TO_CLIENT(CHK_SLOT)
IF IRAI_CHARA_TO_PROGRESS(REQUEST_CLIENT) == "依頼中"
	IF GROUPMATCH(IRAI_SLOT_TO_TASKNAME(CHK_SLOT), "調達", "food")
		REQUEST_TARGET = REQUEST_CLIENT
	ELSE
		REQUEST_TARGET = IRAI_SLOT_TO_PERSON(CHK_SLOT)
	ENDIF
	SIF !REQUEST_TARGET
		CONTINUE
	SIF CFLAG:REQUEST_TARGET:自宅位置 ;has a home of their own
		CONTINUE
	SIF IS_HERE(REQUEST_TARGET) ;just talk to her
		CONTINUE
	CALL ADD_HANDLE_REQUEST_MEETING_POINT(REQUEST_TARGET, CHK_SLOT)
ENDIF
NEXT
RETURN 0

@ADD_HANDLE_REQUEST_MEETING_POINT(CHARA, CHK_SLOT)
#DIM CHARA
#DIM PREV_TARGET
#DIM CHK_SLOT
SIF !INT_DATA_IRAI(IRAI_SLOT:CHK_SLOT, "MEETINGPOINT_ALLOWED", IRAI_SLOT_TO_CLIENT(CHK_SLOT))
	RETURN
IF IRAI_SLOT_TO_TASKNAME(CHK_SLOT) == "food"
	PRINTFORMDL %EX_DISH_NAME%을 %CALLNAME:IRAI_SLOT_TO_CLIENT(CHK_SLOT)%에게 전달한다?
	CALL ASK_YN
	SIF RESULT
		RETURN
ENDIF
PRINTFORML ＜%REQUEST_NAMES_TR(STR_DATA_IRAI(IRAI_SLOT:CHK_SLOT, "依頼名", IRAI_SLOT_TO_CLIENT(CHK_SLOT)))%＞
PRINTFORMW 　→[%IRAI_SLOT_TO_ACTNAME(CHK_SLOT)%]
CALL IRAI_APPLY(CHK_SLOT, 1)

@ADD_CUSTOM_COM_ABLE7
#DIM REQUEST_CLIENT
#DIM REQUEST_TARGET
#DIM CHK_SLOT
SIF CFLAG:MASTER:現在位置 != GET_MAP_REPLACEMENT(P201人里の門)
	RETURN 0
SIF FLAG:時間停止
	RETURN 0
FOR CHK_SLOT, 1, COUNT_IRAI_SLOT() + 1
REQUEST_CLIENT = IRAI_SLOT_TO_CLIENT(CHK_SLOT)
SIF !REQUEST_CLIENT
	CONTINUE
IF IRAI_CHARA_TO_PROGRESS(REQUEST_CLIENT) == "依頼中"
	IF GROUPMATCH(IRAI_SLOT_TO_TASKNAME(CHK_SLOT), "調達", "food")
		REQUEST_TARGET = REQUEST_CLIENT
	ELSE
		REQUEST_TARGET = IRAI_SLOT_TO_PERSON(CHK_SLOT)
	ENDIF
	SIF !REQUEST_TARGET
		CONTINUE
	SIF TCVAR:REQUEST_TARGET:REQUEST_SUMMONS
		CONTINUE
	SIF IS_HERE(REQUEST_TARGET) ;is right there
		CONTINUE
	SIF !INT_DATA_IRAI(IRAI_SLOT:CHK_SLOT, "MEETINGPOINT_ALLOWED", IRAI_SLOT_TO_CLIENT(CHK_SLOT))
		CONTINUE
	IF IRAI_SLOT_TO_TASKNAME(CHK_SLOT) == "捜索（人物）"
		SIF !IRAI_EX:CHK_SLOT && ABL:REQUEST_TARGET:親密 < 10 ;high enough intimacy lets the player guess the target, otherwise they need to pray/dowse first
			CONTINUE
	ENDIF
	SIF CFLAG:REQUEST_TARGET:自宅位置 ;has a home of their own
		CONTINUE
	RETURN 1
ENDIF
NEXT
RETURN 0

@ADD_CUSTOM_MESSAGE_COM7

@ADD_CUSTOM_COM_PRINT7
SETCOLOR C_GREEN
PRINTFORMC %ADD_CUSTOM_TRAINNAME7()%[{Add_Custom_COM_To_Number(7)}]
RESETCOLOR

@ADD_CUSTOM_TRAINNAME7()
#FUNCTIONS
#DIM REQUEST_CLIENT
#DIM REQUEST_TARGET
#DIM CHK_SLOT
#DIM DYNAMIC PLURAL
VARSET LOCALS
FOR CHK_SLOT, 1, COUNT_IRAI_SLOT() + 1
REQUEST_CLIENT = IRAI_SLOT_TO_CLIENT(CHK_SLOT)
IF IRAI_CHARA_TO_PROGRESS(REQUEST_CLIENT) == "依頼中"
	IF GROUPMATCH(IRAI_SLOT_TO_TASKNAME(CHK_SLOT), "調達", "food")
		REQUEST_TARGET = REQUEST_CLIENT
	ELSE
		REQUEST_TARGET = IRAI_SLOT_TO_PERSON(CHK_SLOT)
	ENDIF
	SIF !REQUEST_TARGET
		CONTINUE
	SIF CFLAG:REQUEST_TARGET:自宅位置 ;has a home of their own
		CONTINUE
	IF LOCALS == IRAI_SLOT_TO_ACTNAME(CHK_SLOT) ;multiple of the same
		PLURAL = 1
	ELSEIF STRLENS(LOCALS) ;multiple types of requests to handle
		RETURNF "Meeting Point"
	ELSE
		LOCALS '= IRAI_SLOT_TO_ACTNAME(CHK_SLOT)
	ENDIF
ENDIF
NEXT
RETURNF ADD_REQUEST_PLURALIZER(LOCALS, PLURAL)

@ADD_REQUEST_PLURALIZER(REQUEST_ACT, IS_PLURAL)
#FUNCTIONS
#DIMS REQUEST_ACT
#DIM  IS_PLURAL
SIF GROUPMATCH(REQUEST_ACT, "Search", "Deliver The Supplies", "Ask About Overdue Book", "Challenge", "Deliver Fish", "Hand Over 5 Pieces Of Timber", "Deliver Provisions")
	RETURNF REQUEST_ACT
RETURNF PLURALIZER(REQUEST_ACT, IS_PLURAL ? 2 # 1)
