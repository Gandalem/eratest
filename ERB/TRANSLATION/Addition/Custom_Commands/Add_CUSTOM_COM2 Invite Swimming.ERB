@ADD_CUSTOM_COM2
SIF !TEQUIP:TARGET:SWIMMING
	CALL ADD_START_SWIMMING(TARGET)
CALL ADD_BYSTANDERS_JOIN_SWIMMING
TIME += 5
RETURN 1

@ADD_CUSTOM_COM_ABLE2
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF TFLAG:102 != 1
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
SIF !TEQUIP:MASTER:SWIMMING
	RETURN 0
SIF TEQUIP:SWIMMING
	RETURN 0
SIF MARK:反発刻印 == 3 || CFLAG:ブチギレ
	RETURN 0
SIF !ADD_SWIMMING_AREA(CFLAG:MASTER:現在位置)
	RETURN 0
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURN 0
SIF BASE:気力 <= 0 ;is tired
	RETURN 0
SIF CFLAG:行動
	RETURN 0
SIF !ADD_SWIMMING_CONSTITUTION(TARGET)
	RETURN 0
;停止中は不可
SIF FLAG:70
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM2
