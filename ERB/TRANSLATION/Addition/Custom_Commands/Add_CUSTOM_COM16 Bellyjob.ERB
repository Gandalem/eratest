; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM16 Bellyjob.ERB

@ADD_CUSTOM_COM16
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1
CSTR:PLAYER:10 += @"{TARGET}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:PLAYER:2 = 8
;強度
TCVAR:PLAYER:4 = 300
CSTR:TARGET:10 += @"{PLAYER}/"
;強度
TCVAR:TARGET:4 = 300
DOWNBASE:PLAYER:体力 += 20
DOWNBASE:PLAYER:気力 += 20
SOURCE:PLAYER:快Ｃ += 40
SIF CFLAG:妊娠経過日数 >= 30
	SOURCE:PLAYER:快Ｃ += CFLAG:妊娠経過日数
TIME += 5
RETURN 1

@ADD_CUSTOM_COM_ABLE16
SIF !TFLAG:100
	RETURN 0
SIF TFLAG:102 != 2
	RETURN 0
SIF !TARGET
	RETURN 0
SIF CFLAG:うふふ == 0
	RETURN 0
SIF !HAS_PENIS(PLAYER)
	RETURN 0
SIF !CHECK_CLO("belly_visible")
	RETURN 0
RETURN 1

@ADD_CUSTOM_CAN_COM16(ARG)
SKIPDISP ARG
IF FLAG:70
	PRINTL 강제 복부 수술
ELSE
	IF !TEQUIP:縄
		PRINTL 배리잡
		CALL QOL_COM_ORDER_STANDARD_CHECKS(20, QOL_COM_ORDER_SERVICE_FULL | QOL_COM_ORDER_DIRT_SOURCE_PENIS, TARGET)
		LOCAL = RESULT
		SKIPDISP 0
		RETURN LOCAL
	ENDIF
ENDIF
SKIPDISP 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM16
PRINTFORMD %ONGOING_NAME(MASTER)% 문지르다 당신의 %TINKO_TR(PLAYER,1,,TALENT:PLAYER:双槍)% 위에 %조사처리(CALLNAME:TARGET,"의")% 
IF CFLAG:妊娠経過日数 >= 80
	PRINTFORMDL 거대한 배.
	PRINTFORMDW %HE_SHE(TARGET)%이 곧 출산할 것이라는 사실은 더욱 흥미진진하게 만든다.
ELSEIF CFLAG:妊娠経過日数 >= 60
	PRINTFORMDL 배가 부풀어 올랐다.
	IF GROUPMATCH(TALENT:TARGET:PREGNANCY_TYPE, PREGNANCY_EGGS, PREGNANCY_CLUTCH)
		PRINTFORMDW 당신은 피부를 통해 %PLNOUN("outline",CFLAG:TARGET:WithChildCount)%의 %HIS_HER(TARGET)% %PLNOUN("egg",CFLAG:TARGET:WithChildCount)%을 느낄 수 있고, 그것이 당신을 더욱 흥분시킨다.
	ELSE
		PRINTFORMDW 당신은 피부를 통해 \@ CFLAG:TARGET:WithChildCount > 1 ? 많은 움직임 # 당신의 아이의 움직임을 \@ 느낄 수 있고, 그것이 당신을 더욱 흥분시켰다.
	ENDIF
ELSEIF CFLAG:妊娠経過日数 >= 40
	PRINTFORMDL 볼록해진 배.
	PRINTFORMDW 당신 자신의 %PLNOUN("child",CFLAG:TARGET:WithChildCount)% %PLVERB("is",CFLAG:TARGET:WithChildCount)%가 그 안에서 당신을 더욱 흥분시킨다는 것을 알면서.
ELSEIF CFLAG:妊娠経過日数 >= 30
	PRINTFORMDL 살짝 볼록해진 배.
	PRINTFORMDW 천천히 자라는 %HIM_HER(TARGET)%을 느끼는 것이 따뜻한 감정을 채운다.
ELSEIF 充填率(TARGET,1) >= 100
	PRINTFORMDL 정액으로 가득 찬 배.
ELSE
	PRINTFORMDW 배
ENDIF
