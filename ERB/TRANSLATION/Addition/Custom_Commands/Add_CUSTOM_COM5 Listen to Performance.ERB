@ADD_CUSTOM_COM5
DOWNBASE:MASTER:気力 += 50
SOURCE:歓楽 = 800
;ABL:親密をみる
IF ABL:親密 <= 1
	SOURCE:歓楽 += (ABL:親密 * 50)
ELSEIF ABL:親密 <= 3
	SOURCE:歓楽 += 200 + (ABL:親密 * 50)
ELSEIF ABL:親密 <= 5
	SOURCE:歓楽 += 500 + (ABL:親密 * 50)
ELSEIF ABL:親密 <= 8
	SOURCE:歓楽 += 750 + (ABL:親密 * 65)
ELSEIF ABL:親密 <= 10
	SOURCE:歓楽 += 1000 + (ABL:親密 * 65)
ELSE
	SOURCE:歓楽 += 1600 + (ABL:親密 * 50)
ENDIF

SOURCE:歓楽 = LIMIT(SOURCE:歓楽,0,8000)

SOURCE:受動 = 100 + 150 * ABL:従順
SOURCE:征服 = 100 + 150 * ABL:サドっ気

TIME += 15

RETURN 1

@ADD_CUSTOM_COM_ABLE5
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF TFLAG:102 != 1
	RETURN 0
SIF !ADD_BANQUET_ACTIVITY_ALLOWED("LISTEN_TO_MUSIC")
	RETURN 0
SIF !(ADD_BANQUET_CHARA_STATE(TARGET) && ADD_BANQUET_IS_PERFORMER(TARGET, CFLAG:BANQUET))
	RETURN 0
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURN 0
;停止中は不可
SIF FLAG:70
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM5
TRYCCALLFORM ADD_BANQUET_LISTEN_TEXT{CFLAG:BANQUET}
CATCH
	PRINTFORML You listen to %CALLNAME:TARGET% as %HE_SHE(TARGET)% performs.
	IF TALENT:恋慕
		PRINTFORMW You think you spot a smile on %HIS_HER(TARGET)% face, as %HE_SHE(TARGET)% confidently sings as loudly as %HE_SHE(TARGET)% can.
	ELSEIF TALENT:思慕
		PRINTFORMW %HE_SHE(TARGET,1)% seems to be glad to see you in the audience.
	ENDIF
ENDCATCH
