; Modular ERB: Addition/Custom_Commands/ADD_CUSTOM_COM0 Game 9 (Tennis Singles).ERB

@EXIST_ADD_GAME_INFO9
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO9(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Tennis (singles)")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "테니스 경기")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "CHECKREQUIREMENTS"
		IF !ADD_BANQUET_ACTIVITY_ALLOWED("TENNIS",1)
		ELSEIF CFLAG:MASTER:現在位置 != CFLAG:ARG:現在位置 ;don't take from surrounding areas
		ELSEIF !((ADD_BANQUET_CHARA_STATE(ARG) && CFLAG:ARG:BANQUET_ROLE >= ADD_BANQUET_ROLE_GUEST) || ARG == FLAG:デート相手)
		ELSE
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 30)
ENDSELECT

@ADD_GAME9
#DIM SKILL_VALUES, 2
#DIM TOTAL_SKILL
#DIM SKILL_DIFFERENCE
#DIM SCORE_DIFFERENCE
#DIM DARK_HORSE_VICTORY
#DIMS WINNER_NAME ;"you" if MASTER
#DIMS LOSER_NAME ;"you" if MASTER
CALL ADD_BANQUET_SET_OUTFIT21(MASTER)
CALL ADD_BANQUET_SET_OUTFIT21(TARGET)
SKILL_VALUES:0 = ABL:MASTER:戦闘能力 * 200
SKILL_VALUES:1 = ABL:TARGET:戦闘能力 * 200
TOTAL_SKILL = SUMARRAY(SKILL_VALUES)
SKILL_DIFFERENCE = SKILL_VALUES:0 - SKILL_VALUES:1
PRINTFORML 당신들 중 %NUM_COUNT(ADD_GAME_PARTICIPANT_COUNT)%이 테니스 한 라운드를 한다.
CALL ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)
WINNER_NAME '= ADD_GAME_WINNERS:0 == MASTER ? "you" # CALLNAME:(ADD_GAME_WINNERS:0)
LOSER_NAME '= ADD_GAME_LOSERS:0 == MASTER ? "you" # CALLNAME:(ADD_GAME_LOSERS:0)
DARK_HORSE_VICTORY = (SKILL_VALUES:0 > SKILL_VALUES:1 && ADD_GAME_WINNERS:0 != MASTER) || (SKILL_VALUES:0 < SKILL_VALUES:1 && ADD_GAME_WINNERS:0 == MASTER)
IF TOTAL_SKILL < 600
	LOCALS:0 = 
	IF ABS(SKILL_DIFFERENCE) <= 200
		LOCALS:0 = 어느 쪽이든 될 수 있었던 것
	ELSE
		LOCALS:0 = , 거기서 %WINNER_NAME%이 게임 대부분 동안 우위를 점했다.
	ENDIF
	PRINTFORML 당신의 아마추어다운 경기에 %LOCALS:0% 후, %WINNER_NAME%는 %COND_STR("surprisingly ", DARK_HORSE_VICTORY)%가 이겼다%COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)%.
ELSEIF ABS(SKILL_DIFFERENCE) >= 600
	IF DARK_HORSE_VICTORY
		PRINTFORML 스킬에 상당한 차이가 있었음에도 불구하고, %WINNER_NAME%은 멋진 역전승으로 %LOSER_NAME%을(를) 물리치고 %COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)%했다.
		SIF CFLAG:(ADD_GAME_LOSERS:0):今日の運勢 < 400
			PRINTFORML 아마 이것은 그저 \@ ADD_GAME_LOSERS:0 == MASTER ? 당신의 # %HIS_HER(ADD_GAME_LOSERS:0)% \@ 날이 아닐지도 모른다.
	ELSE
		PRINTFORML 예견대로, %WINNER_NAME%이 경기 내내 %COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)%를 지배하며 손쉽게 %LOSER_NAME%을 물리쳤다.
	ENDIF
ELSEIF TOTAL_SKILL <= 2000
	PRINTFORML 경기는 치열하고 양측 모두 최선을 다한다.
	IF ABS(SKILL_DIFFERENCE) <= 200
		PRINTFORML 두 분은 대등하지만 결국 %WINNER_NAME% 우위를 점하고 승리한다 %COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)%.
	ELSEIF DARK_HORSE_VICTORY
		PRINTFORML ~에도 불구하고 %LOSER_NAME% 이점을 가지고 있음에도 불구하고 %WINNER_NAME% 성공하다%COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)% ~을 물리치다 %LOSER_NAME%.
	ELSE
		PRINTFORML %CAPITALIZE(WINNER_NAME)%은 결국 %COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)%를 관리하며 %LOSER_NAME%에 결정적인 우위를 점하게 된다.
	ENDIF
ELSE
	PRINTFORML 두 명의 마스터 간의 이 놀라운 경기는 테니스 코트의 모든 사람들의 주의를 끌었다.
	PRINTFORML 당신이 한계까지 몰리는 치열한 공방 끝에, %WINNER_NAME%는 결국 결정적인 우위를 확보하고 %COND_STR("s", ADD_GAME_WINNERS:0 != MASTER)% 승리를 거머쥐었다.
	PRINTFORML 클럽 회원들은 이 놀라운 경기를 본 후 박수를 터뜨렸다.
ENDIF
;chance to proc red thread, somewhat better odds than through standard actions
SIF !RAND:3 && TARGET == FLAG:デート相手
	CALL Add_RedThread
