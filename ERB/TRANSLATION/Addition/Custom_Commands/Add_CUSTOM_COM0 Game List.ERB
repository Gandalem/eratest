@EXIST_ADD_GAME_INFO5
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO5(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Hanetsuki")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "한에츠키 게임")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "CHECKREQUIREMENTS"
		;valid during the first three days of the year
		SIF !INROOM(CFLAG:MASTER:現在位置) && DAY:2 == 1 && DAY:3 <= 3
			CALLF MAKE_INT(V_NAME, 2)
	CASE "VALIDBETS"
		LOCALS = HANETSUKI/
		SIF ADD_GAME_EROTIC_BETS_VALID()
			LOCALS += "HANETSUKI_LEWD/"
		CALLF MAKE_STR(V_NAME, LOCALS)
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 30)
ENDSELECT

@ADD_GAME5
#DIM BASE_TIMEOUT
#DIM ACTUAL_TIMEOUT
#DIM ROUNDS
#DIM CORRECT_OPTION
#DIM POINTS, 2
#DIM STRIKE
#DIM CHARA
#DIMS VALID_AREAS
#DIMS VALID_WORDS
#DIM TIME_REDUCTION
VARSET POINTS
ROUNDS = 11 ;uneven amount of rounds to ensure a victor
LOCALS:0 = ↑
LOCALS:1 = →
LOCALS:2 = ←
LOCALS:3 = ↓
CHARA = TARGET
VALID_WORDS = lascivious:erotic:lewd:raunchy:lecherous:suggestive:smutty:salacious
PRINTFORML 올바른 방향으로 움직여서 %CALLNAME:CHARA%의 공격을 반환한다.
FOR LOCAL, 0, ROUNDS
PRINTFORMW 라운드 {LOCAL+1}/{ROUNDS}번째!
BASE_TIMEOUT = 2000 + (ABL:MASTER:戦闘能力 * 100)
STRIKE = 0
WHILE 1
ACTUAL_TIMEOUT = BASE_TIMEOUT
TIME_REDUCTION = 0
IF ADD_GAME_SELECTED_BET == "HANETSUKI_LEWD" && TALENT:CHARA:2 != 2
	TIME_REDUCTION = 0
	IF STRLENS(ADD_CHECK_CLOTHES(CHARA, "TOP")) ;still fully clothed
		IF !RAND:10
			PRINTFORML %CALLNAME:CHARA%이(가) %HIS_HER(CHARA)%의 가슴을 조금 노출시키며 %ADD_CHECK_CLOTHES(CHARA, "TOP")%를 아래로 내린다.
			TIME_REDUCTION = 400
		ENDIF
	ELSEIF STRLENS(ADD_CHECK_CLOTHES(CHARA, "BOTTOM")) && STRLENS(ADD_CHECK_CLOTHES(CHARA, "BRA")) ;wearing bottoms and bra
		IF TALENT:CHARA:バストサイズ > 0 && !RAND:8
			PRINTFORML 당신은 ~에 정신을 빼앗겼다 %CALLNAME:CHARA%의 안에서 흔들리는 가슴 %HIS_HER(CHARA)% %ADD_CHECK_CLOTHES(CHARA, "BRA")%.
			TIME_REDUCTION = 600
		ELSEIF !RAND:10
			PRINTFORML %CALLNAME:CHARA% 끌어올린다 %HIS_HER(CHARA)% %ADD_CHECK_CLOTHES(CHARA, "BOTTOM")% 위로 올려서 노출시키다 %HIS_HER(CHARA)% 허벅지를 조금 드러내며.
			TIME_REDUCTION = 400
		ENDIF
	ELSEIF STRLENS(ADD_CHECK_CLOTHES(CHARA, "BRA")) && STRLENS(ADD_CHECK_CLOTHES(CHARA, "PANTIES")) ;only underwear
		IF TALENT:CHARA:バストサイズ > 0 && !RAND:8
			PRINTFORML 당신은 ~에 정신을 빼앗긴다 %CALLNAME:CHARA%의 안에서 흔들리는 가슴 %HIS_HER(CHARA)% %ADD_CHECK_CLOTHES(CHARA, "BRA")%.
			TIME_REDUCTION = 600
		ELSEIF !RAND:10
			PRINTFORML %CALLNAME:CHARA%이/가 %HIS_HER(CHARA)% 속옷만 입고 뛰어노는 것을 보면, 거의 셔틀을 놓칠 지경이다.
			TIME_REDUCTION = 400
		ENDIF
	ELSEIF STRLENS(ADD_CHECK_CLOTHES(CHARA, "BOTTOM")) ;bottoms, no bra
		IF TALENT:CHARA:バストサイズ > 0 && !RAND:5
			PRINTFORML 당신은 %CALLNAME:CHARA%의 흔들리는 가슴에 정신이 팔린다.
			TIME_REDUCTION = 800
		ELSEIF !RAND:10
			PRINTFORML %CALLNAME:CHARA% 끌어올린다 %HIS_HER(CHARA)% %ADD_CHECK_CLOTHES(CHARA, "BOTTOM")% 위로 올려서 노출시키다 %HIS_HER(CHARA)% 허벅지를 조금 드러내며.
			TIME_REDUCTION = 400
		ENDIF
	ELSEIF STRLENS(ADD_CHECK_CLOTHES(CHARA, "BRA")) ;still wearing bra, but no panties
		IF TALENT:CHARA:バストサイズ > 0 && !RAND:8
			PRINTFORML 당신은 %CALLNAME:CHARA%의 가슴이 %HIS_HER(CHARA)% %ADD_CHECK_CLOTHES(CHARA, "BRA")% 안에서 흔들리는 것에 정신을 빼앗겼다.
			TIME_REDUCTION = 600
		ELSEIF !RAND:10
			PRINTFORML %CALLNAME:CHARA%가 움직이는 동안, 당신은 %HIS_HER(CHARA)%의 금지된 구역을 언뜻 보게 되고, 거의 배구공을 놓칠 뻔한다.
			TIME_REDUCTION = 1000
		ENDIF
	ELSEIF STRLENS(ADD_CHECK_CLOTHES(CHARA, "PANTIES")) ;only wearing panties
		IF TALENT:CHARA:バストサイズ > 0 && !RAND:5
			PRINTFORML 당신은 %CALLNAME:CHARA%의 흔들리는 가슴에 정신을 빼앗겼다.
			TIME_REDUCTION = 800
		ELSEIF !RAND:8
			PRINTFORML %CALLNAME:CHARA%가 오직 %HIS_HER(CHARA)% 팬티만 입고 뛰어다니는 것을 보면, 공을 놓칠 뻔했다.
			TIME_REDUCTION = 600
		ENDIF
	ELSE
		IF TALENT:CHARA:バストサイズ > 0 && !RAND:5
			PRINTFORML 당신은 %CALLNAME:CHARA%의 흔들리는 가슴에 정신이 팔린다.
			TIME_REDUCTION = 800
		ELSEIF !RAND:8
			PRINTFORML %CALLNAME:CHARA%가 돌아다니는 모습을 보면서, 당신은 %HIS_HER(CHARA)%의 금지된 구역을 언뜻 보게 되고, 거의 셔틀을 놓칠 뻔한다.
			TIME_REDUCTION = 1000
		ENDIF
	ENDIF
	SIF TALENT:MASTER:自制心
		TIME_REDUCTION /= 2
	;round to 100 ms
	TIME_REDUCTION = TIME_REDUCTION / 100 * 100
	ACTUAL_TIMEOUT -= TIME_REDUCTION
	ACTUAL_TIMEOUT = MAX(ACTUAL_TIMEOUT, 500) ;cap at half a second
ENDIF
PRINTFORM 그것이 온다 
CORRECT_OPTION = RAND:5
IF CORRECT_OPTION == 4
	SETCOLOR C_YELLOW
	PRINTFORM 당신을 향해 곧바로
ELSE
	PRINTFORM ~로부터 
	SETCOLOR C_YELLOW
	PRINTFORM %LOCALS:(CORRECT_OPTION)%
ENDIF
RESETCOLOR
PRINTFORML !
CALL FISHER_YATES_SHAFFLE(4)
FOR LOCAL:10,0,4
LOCAL:2 = SHAFFLE_ARRAY:(LOCAL:10)
PRINTFORML [{LOCAL:2}] [LOCAL:2] - %LOCALS:(LOCAL:2)% 이동한다
NEXT
TINPUT ACTUAL_TIMEOUT, 4, 1, ""
IF RESULT == CORRECT_OPTION
	;check if opponent succeeds in returning it
	IF RAND:(20 + (ABL:CHARA:戦闘能力 * 4) - (STRIKE * 2)) > 5
		PRINTFORML %CALLNAME:CHARA%는 셔틀을 돌려내는 데 성공한다.
		BASE_TIMEOUT -= 100
		BASE_TIMEOUT = MAX(BASE_TIMEOUT, 500) ;cap at half a second
		TWAIT 100, 0
	ELSE
		PRINTFORML %CALLNAME:CHARA%는 셔틀을 반환하지 못했다.
		PRINTFORML 이 라운드에서 승리했다!
		POINTS:0 ++
		SELECTCASE ADD_GAME_SELECTED_BET
			CASE "HANETSUKI"
				SELECTCASE POINTS:0
					CASE 1 TO 3
						PRINTFORML 너는 ~에게 다가가 %CALLNAME:CHARA% 그리고 ~에 바보 같은 낙서를 한다 %HIS_HER(CHARA)% %SPLIT_G("face:cheek:forehead")% 잉크로
					CASE 4 TO 5
						PRINTFORML 당신은 %CALLNAME:CHARA%에게 다가가 잉크로 %HIS_HER(CHARA)%의 %SPLIT_G("face:cheek:forehead")%에 더 바보 같은 낙서를 한다.
						PRINTFORML %HIS_HER(CHARA, 1)%의 얼굴이 멋진 콜라주로 변하고 있다.
					CASE 6 TO 7
						PRINTFORML 너는 %CALLNAME:CHARA%에게 다가가 잉크로 %HIS_HER(CHARA)%의 %SPLIT_G("face:cheek:forehead")%에 더 바보 같은 낙서를 한다.
						PRINTFORML %HIS_HER(CHARA)% 얼굴에서 빈 곳을 찾기가 점점 어려워진다.
					CASE 8 TO 9
						PRINTFORML 당신은 %CALLNAME:CHARA%에게 다가가 먹을 이용해 %HIS_HER(CHARA)%의 %SPLIT_G("neck:shoulders")%에 우스꽝스러운 낙서를 한다.
						PRINTFORML %HIS_HER(CHARA)% 얼굴에 남은 공간이 얼마 없자, 당신은 대신 %HIS_HER(CHARA)%의 목과 어깨에 그림을 그리기로 결정한다.
					CASE 10
						PRINTFORML 당신은 %CALLNAME:CHARA%에게 다가가 먹으로 %HIS_HER(CHARA)%의 얼굴에 바보 같은 낙서를 그린다.
						PRINTFORML 빈 자리를 찾는 것을 포기하고, 당신은 기존의 낙서 위에 그냥 덧칠하기로 한다.
					CASE 11
						PRINTFORML 당신은 %CALLNAME:CHARA%에게 다가가 먹물로 %HIS_HER(CHARA)%의 얼굴 전체를 칠한다.
						PRINTFORML %HIS_HER(CHARA, 1)%의 얼굴은 이제 마치 진한 먹물 덩어리로 뒤덮인 것 같다.
				ENDSELECT
			CASE "HANETSUKI_LEWD"
				SELECTCASE POINTS:0
					CASE 1, 2
						VALID_AREAS = forehead:cheek:face
					CASE 3
						VALID_AREAS = collar:shoulders
						IF STRLENS(ADD_CHECK_CLOTHES(CHARA, "TOP"))
							PRINTFORM %CALLNAME:CHARA%이 %HIS_HER(CHARA)%의 %ADD_CHECK_CLOTHES(CHARA, "TOP")%를 내린다, 그리고 너는 
						ELSE
							PRINTFORM 당신 
						ENDIF
						PRINTFORML 무언가를 %SPLIT_G(VALID_WORDS)%에 적는다 %CALLNAME:CHARA%의 %SPLIT_G(VALID_AREAS)%.
					CASE 4
						VALID_AREAS = belly:arms:back
						IF STRLENS(ADD_CHECK_CLOTHES(CHARA, "TOP"))
							PRINTFORML {POINTS}번을 지고, %CALLNAME:CHARA%은 이제 %HIS_HER(CHARA)%를 벗어야 한다 %ADD_CHECK_CLOTHES(CHARA, "TOP")%.
							CALL ADD_REMOVE_CLOTHES(CHARA, "TOP")
						ENDIF
					CASE 5
						VALID_AREAS = collar:shoulders:belly:arms:back
					CASE 6
						VALID_AREAS = thighs:legs
						IF STRLENS(ADD_CHECK_CLOTHES(CHARA, "BOTTOM"))
							PRINTFORML {POINTS}번 지고 나서, %CALLNAME:CHARA%은 이제 %HIS_HER(CHARA)%(를) %ADD_CHECK_CLOTHES(CHARA, "BOTTOM")%해야 한다.
							CALL ADD_REMOVE_CLOTHES(CHARA, "BOTTOM")
						ENDIF
					CASE 7
						VALID_AREAS = belly:arms:back:thighs:legs
					CASE 8
						VALID_AREAS = breasts
						IF STRLENS(ADD_CHECK_CLOTHES(CHARA, "BRA"))
							PRINTFORML {POINTS}번 지고 나서, %CALLNAME:CHARA%은 이제 %HIS_HER(CHARA)%을 벗어야 한다 %ADD_CHECK_CLOTHES(CHARA, "BRA")%.
							CALL ADD_REMOVE_CLOTHES(CHARA, "BRA")
						ENDIF
					CASE 9
						VALID_AREAS = belly:arms:back:thighs:legs:breasts
					CASE 10
						VALID_AREAS = belly:arms:back:thighs:legs:breasts:butt
						IF STRLENS(ADD_CHECK_CLOTHES(CHARA, "PANTIES"))
							PRINTFORML {POINTS}번 지고 나서, %CALLNAME:CHARA%은 이제 %HIS_HER(CHARA)%을 벗어야 한다 %ADD_CHECK_CLOTHES(CHARA, "PANTIES")%.
							CALL ADD_REMOVE_CLOTHES(CHARA, "PANTIES")
						ENDIF
					CASE 11
						VALID_AREAS = belly:arms:back:thighs:legs:breasts:butt
				ENDSELECT
				SIF POINTS != 3 ;3 is a special case
					PRINTFORML 당신은 %SPLIT_G(VALID_WORDS)%을/를 %CALLNAME:CHARA%의 %SPLIT_G(VALID_AREAS)%에 쓴다.
		ENDSELECT
		WAIT
		BREAK
	ENDIF
	STRIKE ++
ELSE
	PRINTFORML 당신은 셔틀을 치지 못했다.
	POINTS:1 ++
	PRINTFORML %CALLNAME:CHARA%가 이번 라운드를 승리했다!
	SELECTCASE ADD_GAME_SELECTED_BET
		CASE "HANETSUKI"
			PRINTFORM %HE_SHE(CHARA, 1)%이 당신에게 다가와 먹물로 얼굴에 낙서를 한다.
			;switch by personality
			SELECTCASE CFLAG:CHARA:性格傾向
