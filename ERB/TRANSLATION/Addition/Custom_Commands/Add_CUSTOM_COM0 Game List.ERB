					VALID_AREAS = thighs:legs
					IF STRLENS(ADD_CHECK_CLOTHES(MASTER, "BOTTOM"))
						PRINTFORML {POINTS}번을 지고 나서, 당신은 이제 자신의 %ADD_CHECK_CLOTHES(MASTER, "BOTTOM")%를 벗어야 한다.
						CALL ADD_REMOVE_CLOTHES(MASTER, "BOTTOM")
					ENDIF
				CASE 7
					VALID_AREAS = belly:arms:back:chest:thighs:legs
				CASE 8
					VALID_AREAS = belly:arms:back:chest:thighs:legs:dick:cock:penis:butt:ass
					IF STRLENS(ADD_CHECK_CLOTHES(MASTER, "PANTIES"))
						PRINTFORML {POINTS}번을 잃었으니, 이제 당신은 %ADD_CHECK_CLOTHES(MASTER, "PANTIES")%를 벗어야 한다.
						CALL ADD_REMOVE_CLOTHES(MASTER, "PANTIES")
					ENDIF
				CASE 9, 10, 11
					VALID_AREAS = belly:arms:back:chest:thighs:legs:dick:cock:penis:butt:ass
			ENDSELECT
			PRINTFORML %CALLNAME:CHARA%이 당신의 %SPLIT_G(VALID_AREAS)%에 무언가를 %SPLIT_G(VALID_WORDS)% 적는다.
	ENDSELECT
	BREAK
ENDIF
WEND
NEXT
PRINTFORML 게임이 종료되었다.
IF POINTS:0 > POINTS:1
	PRINTFORML {POINTS:0} 포인트로 승리했다.
	ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = MASTER
	ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = CHARA
ELSE
	PRINTFORML {POINTS:1}점으로 %CALLNAME:CHARA%가 승리했다.
	ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = CHARA
	ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = MASTER
ENDIF
SELECTCASE ADD_GAME_SELECTED_BET
	CASE "HANETSUKI"
		IF POINTS:0 && POINTS:1
			PRINTFORML 두 분은 얼굴을 씻으러 가기로 결정한다.
		ELSEIF POINTS:0
			PRINTFORML %CALLNAME:CHARA%은(는) 약간 실망한 듯 %HE_SHE(CHARA)%가 완전히 박살 난 것을 보고 얼굴을 씻으러 간다.
		ELSE
			PRINTFORML 완전히 패배한 채, 당신은 세수를 하러 가지만 \@ CHARA == 57 && !TALENT:恋慕 ? %CALLNAME:CHARA%는 떠다니는 효토코 가면으로 당신을 바라본다 %HIM_HER(CHARA)% # %CALLNAME:CHARA%는 당신에게 미소 짓는다 \@.
		ENDIF
	CASE "HANETSUKI_LEWD"
		IF POINTS:0 && POINTS:1
			PRINTFORML 두 분은 모든 먹물을 씻어내기 위해 함께 목욕하기로 결정한다.
		ELSEIF POINTS:0
			PRINTFORML %CALLNAME:CHARA%은(는) %HE_SHE(CHARA)%가 그렇게 완전히 패배한 것에 약간 실망하며 목욕하러 간다.
		ELSE
			PRINTFORML 완전히 패배한 당신은 목욕을 하기로 결정하고, %CALLNAME:CHARA%는 \@ CHARA == 57 && !TALENT:恋慕 ? 무표정으로 홍조를 띤다 # 당신을 바라보며 심하게 홍조를 띤다 \@.
		ENDIF
		BASE:CHARA:ムード = MIN(BASE:CHARA:ムード + 400, MAXBASE:CHARA:ムード)
		CFLAG:CHARA:溜まってる度 = MIN(CFLAG:CHARA:溜まってる度 + 300, 1000)
		PALAM:CHARA:欲情 += 5000
		BASE:CHARA:理性 = MAX(BASE:CHARA:理性 - 300, 0)
ENDSELECT

