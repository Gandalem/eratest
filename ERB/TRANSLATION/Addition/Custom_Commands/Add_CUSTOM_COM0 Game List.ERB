					IF STRLENS(ADD_CHECK_CLOTHES(MASTER, "TOP"))
						PRINTFORML {POINTS}번 패배하여 이제 당신은 자신의 %ADD_CHECK_CLOTHES(MASTER, "TOP")%를 벗어야 한다.
						CALL ADD_REMOVE_CLOTHES(MASTER, "TOP")
