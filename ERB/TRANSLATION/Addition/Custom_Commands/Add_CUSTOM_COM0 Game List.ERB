#LOCALSSIZE 1

@ADD_GAME_INFO7(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Swimming competition")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "a swimming competition")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, ADD_GAME_MAXIMUM_PARTICIPANTS)
	CASE "CHECKREQUIREMENTS"
		SIF TEQUIP:MASTER:SWIMMING && TEQUIP:ARG:SWIMMING && ADD_SWIMMING_CONSTITUTION(ADD_WEATHER_HARSHNESS(CFLAG:MASTER:現在位置), ARG)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 30)
ENDSELECT

@ADD_GAME7
#DIM SKILL_VALUES, ADD_GAME_MAXIMUM_PARTICIPANTS
#DIM SORTED_SCORES, ADD_GAME_MAXIMUM_PARTICIPANTS
#DIM SORTED_CHARACTERS, ADD_GAME_MAXIMUM_PARTICIPANTS
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	SKILL_VALUES:LOCAL = ABL:(ADD_GAME_PARTICIPANTS:LOCAL):戦闘能力 * 100 + TALENT:(ADD_GAME_PARTICIPANTS:LOCAL):水棲 * 500
NEXT

PRINTFORML You challenge \@ ADD_GAME_PARTICIPANT_COUNT > 2 ? everyone # %CALLNAME:(ADD_GAME_PARTICIPANTS:1)% \@ to a swimming competition.

CALL ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)
ARRAYCOPY "ADD_GAME_SCORES", "SORTED_SCORES"
ARRAYCOPY "ADD_GAME_PARTICIPANTS", "SORTED_CHARACTERS"
ARRAYMSORT SORTED_SCORES, SORTED_CHARACTERS

PRINTFORML The results of the match are:
FOR LOCAL, ADD_GAME_PARTICIPANT_COUNT, 0, -1
	PRINTFORML {ADD_GAME_PARTICIPANT_COUNT - LOCAL + 1}. %CALLNAME:(SORTED_CHARACTERS:(LOCAL-1))%

	DOWNBASE:(SORTED_CHARACTERS:(LOCAL-1)):体力 = 200

	;max sta/ene boost
	MAXBASE:(SORTED_CHARACTERS:(LOCAL-1)):体力 += RAND:5
	MAXBASE:(SORTED_CHARACTERS:(LOCAL-1)):気力 += RAND:5
NEXT

@ADD_GAME_DEFAULT_CALCULATION()
#DIM SKILL_VALUES, ADD_GAME_MAXIMUM_PARTICIPANTS
VARSET SKILL_VALUES
CALL ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)

@ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)
#DIM REF SKILL_VALUES,
VARSET ADD_GAME_SCORES

FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	LOCAL:1 = CFLAG:(ADD_GAME_PARTICIPANTS:LOCAL):今日の運勢 + SKILL_VALUES:LOCAL
	SIF LOCAL:1 > 0
		ADD_GAME_SCORES:LOCAL = RAND:MAX(LOCAL:1,1)

	DEBUGPRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%'s score: {ADD_GAME_SCORES:LOCAL} ({LOCAL:1} max).
NEXT

LOCAL:1 = MAXARRAY(ADD_GAME_SCORES, 0, ADD_GAME_PARTICIPANT_COUNT) ;highest
DEBUGPRINTFORML Winning score: {LOCAL:1}.
;handle duplicate scores
WHILE FINDELEMENT(ADD_GAME_SCORES, LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT) != FINDLASTELEMENT(ADD_GAME_SCORES, LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT)
	;fifty percent chance of being labelled the loser
	ADD_GAME_SCORES:(FINDELEMENT(ADD_GAME_SCORES, LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT)) += (!RAND:2 ? 0 # -1)
WEND

FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	IF ADD_GAME_SCORES:LOCAL == LOCAL:1
		ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = ADD_GAME_PARTICIPANTS:LOCAL
	ELSE
 		ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = ADD_GAME_PARTICIPANTS:LOCAL
	ENDIF
NEXT

@ADD_GAME_STANDARD_BETS
