@EXIST_ADD_GAME_INFO3
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO3(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Hide and Seek")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "숨바꼭질 게임")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 10)
	CASE "CHECKREQUIREMENTS"
		SIF TALENT:ARG:幼稚 || TALENT:ARG:体型 < -1 || TALENT:ARG:妖精
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 30)
ENDSELECT

@ADD_GAME3
#DIM SKILL_VALUES, 10
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
SKILL_VALUES:LOCAL = ((TALENT:(ADD_GAME_PARTICIPANTS:LOCAL):伐採Lv + TALENT:(ADD_GAME_PARTICIPANTS:LOCAL):採集Lv) * 50) + TALENT:(ADD_GAME_PARTICIPANTS:LOCAL):妖精 * 300
NEXT
PRINTFORML 당신들 중 %NUM_COUNT(ADD_GAME_PARTICIPANT_COUNT)%명이 숨바꼭질을 한다.
CALL ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)
PRINTFORML 게임이 종료됨에 따라, %ADD_GAME_LIST_NAMES(ADD_GAME_WINNERS)%가 승자로 선언된다.

