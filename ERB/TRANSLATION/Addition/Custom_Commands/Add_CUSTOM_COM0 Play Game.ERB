;playing games with other characters, either as a pair, or in larger groups
;think stuff like cards, shogi, board games
;intended to function on its own and as a base for banquet/festival games
@ADD_CUSTOM_COM0
#DIM VALID_GAMES, OBJ_ID_LAST
#DIM VALID_GAME_COUNT
#DIM VALID_LOCAL_PLAYERS, キャラクタ数上限
#DIM PEOPLE_IN_ROOM
#DIM VALID_NEARBY_PLAYERS, キャラクタ数上限
#DIM PEOPLE_NEARBY
#DIMS VALID_BET_STRING
#DIMS BETS, 20
CALL ADD_GAME_INITALIZE_VARS

VARSET VALID_LOCAL_PLAYERS
VARSET VALID_NEARBY_PLAYERS
VARSET VALID_GAMES
VARSET BETS
PEOPLE_IN_ROOM = 0
PEOPLE_NEARBY = 0
VALID_GAME_COUNT = 0

;players in the same room
FOR LOCAL, 1, GET_TARGETNUM() + 1
	SIF !SHIRAHU(TARGET:LOCAL)
		CONTINUE
	SIF CFLAG:(TARGET:LOCAL):ブチギレ
		CONTINUE
	SIF TARGET:LOCAL == TARGET
		CONTINUE
	SIF TARGET:LOCAL == MASTER
		CONTINUE
	;not while working unless playing/banquet
	SIF CFLAG:(TARGET:LOCAL):行動 && !GROUPMATCH(CFLAG:(TARGET:LOCAL):職種, 49, 51)
		CONTINUE

	VALID_LOCAL_PLAYERS:(PEOPLE_IN_ROOM++) = TARGET:LOCAL
NEXT

;grab potential players in nearby rooms
CALL ADD_GAME_FIND_NEARBY(VALID_NEARBY_PLAYERS, PEOPLE_NEARBY)

DEBUGPRINTFORML {PEOPLE_IN_ROOM} players in the room.
DEBUGPRINTFORML {PEOPLE_NEARBY} additional players nearby.

FOR LOCAL, 1, ADD_GAME_MAX_ID
	SIF !GET_INT(TARGET, "ADD_GAME_INFO", LOCAL, "CHECKREQUIREMENTS")
		CONTINUE

	LOCAL:2 = 2 ;eligible players for this game
	FOR	LOCAL:1, 0, PEOPLE_IN_ROOM
		SIF GET_INT(VALID_LOCAL_PLAYERS:(LOCAL:1), "ADD_GAME_INFO", LOCAL, "CHECKREQUIREMENTS")
			LOCAL:2 ++
	NEXT
	FOR	LOCAL:1, 0, PEOPLE_NEARBY
		SIF GET_INT(VALID_NEARBY_PLAYERS:(LOCAL:1), "ADD_GAME_INFO", LOCAL, "CHECKREQUIREMENTS")
			LOCAL:2 ++
	NEXT
	
	SIF GET_INT(0, "ADD_GAME_INFO", LOCAL, "MINPLAYERS") > LOCAL:2
		CONTINUE
	VALID_GAMES:(VALID_GAME_COUNT++) = LOCAL
NEXT

PRINTFORML Which game should you play?
FOR LOCAL, 0, VALID_GAME_COUNT
	LOCAL:1 = GET_INT(0, "ADD_GAME_INFO", VALID_GAMES:LOCAL, "MINPLAYERS")
	LOCAL:2 = GET_INT(0, "ADD_GAME_INFO", VALID_GAMES:LOCAL, "MAXPLAYERS")
	SIF LOCAL:2 >= CHARANUM
		LOCAL:2 = CHARANUM
	PRINTFORML [{LOCAL}] - %GET_STR(0, "ADD_GAME_INFO", VALID_GAMES:LOCAL, "NAME")% (\@ LOCAL:1 == LOCAL:2 ? {LOCAL:1} # {LOCAL:1} to {LOCAL:2} \@ players)
NEXT

PRINTFORML 
PRINTFORML [-1] - Return
DO
	INPUT
	SELECTCASE RESULT
	CASE -1
		RETURN -1
	CASEELSE
		SIF RESULT >= 0 && RESULT < VALID_GAME_COUNT
			BREAK
		REUSELASTLINE Invalid input
		CONTINUE
	ENDSELECT
LOOP 1 

ADD_GAME_SELECTED_GAME = VALID_GAMES:RESULT
	
;master and target always join
ADD_GAME_PARTICIPANTS:0 = MASTER
ADD_GAME_PARTICIPANTS:1 = TARGET
ADD_GAME_PARTICIPANT_COUNT = 2

;first pick from players in room
CALL ADD_GAME_ADD_PLAYERS(VALID_LOCAL_PLAYERS, PEOPLE_IN_ROOM)
;now check people in nearby rooms
CALL ADD_GAME_ADD_PLAYERS(VALID_NEARBY_PLAYERS, PEOPLE_NEARBY)

;put together string of players for LIST_IN_STRING
LOCALS = 
FOR LOCAL, 1, ADD_GAME_PARTICIPANT_COUNT
	SIF ADD_GAME_PARTICIPANTS:LOCAL <= 0
		BREAK
	IF CFLAG:(ADD_GAME_PARTICIPANTS:LOCAL):現在位置 != CFLAG:MASTER:現在位置
		CFLAG:(ADD_GAME_PARTICIPANTS:LOCAL):現在位置 = CFLAG:MASTER:現在位置
		CFLAG:(ADD_GAME_PARTICIPANTS:LOCAL):同室 = 1
		PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)% comes in.
	ENDIF
	Activity_Duration:(ADD_GAME_PARTICIPANTS:LOCAL) = 0
	Activity_Type:(ADD_GAME_PARTICIPANTS:LOCAL) = 0
	LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%、"
NEXT

PRINTFORML You decided to play %GET_STR(0, "ADD_GAME_INFO", ADD_GAME_SELECTED_GAME, "DESCRIPTION")% with %LIST_IN_STRING(LOCALS)%.

VALID_BET_STRING = %GET_STR(0, "ADD_GAME_INFO", ADD_GAME_SELECTED_GAME, "VALIDBETS")%

IF STRLENS(VALID_BET_STRING)
	IF STRFIND(VALID_BET_STRING, "NONE") >= 0
		PRINTFORML Add a wager?
	ELSE
		PRINTFORML Which punishment do you want to choose?
	ENDIF
	SPLIT VALID_BET_STRING, "/", BETS

	FOR LOCAL, 0, 20
		SIF !STRLENS(BETS:LOCAL)
			BREAK
		PRINTFORML [{LOCAL}] - %ADD_GAME_BET_NAME(BETS:LOCAL)%
	NEXT
	DO
		INPUT
		SIF RESULT >= 0 && RESULT < LOCAL-1
			BREAK
		REUSELASTLINE Invalid input
		CONTINUE
	LOOP 1

	ADD_GAME_SELECTED_BET = %BETS:RESULT%
	PRINTFORML %ADD_GAME_BET_NAME(ADD_GAME_SELECTED_BET)% has been chosen.
ELSE
	ADD_GAME_SELECTED_BET = NONE
ENDIF

;NAS: Tutorials
CALL TUTORIAL_GAME_ENTRIES(ADD_GAME_SELECTED_GAME)

CALLFORM ADD_GAME{ADD_GAME_SELECTED_GAME}

IF ADD_GAME_SELECTED_BET != "NONE" && ADD_GAME_WINNER_COUNT
    CALL INTERACTIVE_TUTORIAL_GET(102,302,"Betting",2)
	CALLFORM ADD_GAME_BET_%ADD_GAME_SELECTED_BET%
ENDIF

TIME += GET_INT(0, "ADD_GAME_INFO", ADD_GAME_SELECTED_GAME, "DURATION")

DOWNBASE:MASTER:気力 = 300

FOR LOCAL, 1, ADD_GAME_PARTICIPANT_COUNT
	SOURCE:(ADD_GAME_PARTICIPANTS:LOCAL):歓楽 = 800
	SOURCE:(ADD_GAME_PARTICIPANTS:LOCAL):征服 = 300
	DOWNBASE:(ADD_GAME_PARTICIPANTS:LOCAL):気力 = 300
NEXT

FOR LOCAL, 0, ADD_GAME_WINNER_COUNT
	SIF ADD_GAME_WINNERS:LOCAL == MASTER
		CONTINUE
	TIMES SOURCE:(ADD_GAME_WINNERS:LOCAL):歓楽, 1.2
	TIMES SOURCE:(ADD_GAME_WINNERS:LOCAL):征服, 1.5
	;chance for happy state
	CALL KIGEN_CHANGE(ADD_GAME_WINNERS:LOCAL, 30, 1)
NEXT
FOR LOCAL, 0, ADD_GAME_LOSER_COUNT
	SIF ADD_GAME_LOSERS:LOCAL == MASTER
		CONTINUE

	SOURCE:(ADD_GAME_LOSERS:LOCAL):受動 = 200 + 100 * ABL:(ADD_GAME_LOSERS:LOCAL):従順
NEXT

WAIT
RETURN 1

@ADD_CUSTOM_COM_ABLE0
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF TFLAG:102 != 1
	RETURN 0
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURN 0
SIF CFLAG:MASTER:うふふ && !CFLAG:うふふ
	RETURN 0
SIF CFLAG:ブチギレ
	RETURN 0
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
;添い寝中
SIF CFLAG:添い寝中
	RETURN 0
;浴場
SIF BATHCHECK(CFLAG:MASTER:現在位置)
	RETURN 0
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
;停止中は不可
SIF FLAG:70 && !MAXBASE:TARGET:TSP
	RETURN 0
;not while working, unless the "work" is play/banquet
SIF CFLAG:行動 && !GROUPMATCH(CFLAG:職種, 49, 51)
	RETURN 0
SIF TFLAG:デート道中
	RETURN 0
SIF !ADD_GAME_VALID_GAMES()
	RETURN 0
RETURN 1

@ADD_GAME_ADD_PLAYERS(PLAYER_ARRAY, ARRAY_SIZE)
#DIM REF PLAYER_ARRAY,
#DIM ARRAY_SIZE
#DIM MAXIMUM_PLAYERS
MAXIMUM_PLAYERS = GET_INT(0, "ADD_GAME_INFO", ADD_GAME_SELECTED_GAME, "MAXPLAYERS")

IF ARRAY_SIZE > 0 && ADD_GAME_PARTICIPANT_COUNT < MAXIMUM_PLAYERS
	CALL FISHER_YATES_SHAFFLE(ARRAY_SIZE)
	FOR LOCAL, 0, ARRAY_SIZE
		SIF !GET_INT(PLAYER_ARRAY:(SHAFFLE_ARRAY:LOCAL), "ADD_GAME_INFO", ADD_GAME_SELECTED_GAME, "CHECKREQUIREMENTS")
			CONTINUE

		ADD_GAME_PARTICIPANTS:(ADD_GAME_PARTICIPANT_COUNT++) = PLAYER_ARRAY:(SHAFFLE_ARRAY:LOCAL)
		SIF ADD_GAME_PARTICIPANT_COUNT >= MAXIMUM_PLAYERS
			RETURN
	NEXT
ENDIF

@ADD_GAME_FIND_NEARBY(VALID_PLAYERS, PEOPLE_NEARBY)
#DIM 集合, キャラクタ数上限, 3 ;集合:X:Y
#DIM 人数                     ;同一マップにいる人数、移動できないキャラも表示され、人数に加算されている
#DIM REF VALID_PLAYERS,
#DIM REF PEOPLE_NEARBY
#DIM C_ID
SIF CFLAG:MASTER:現在位置 == OMANEKIBEYA()
	RETURN
SIF !AT_HOME(MASTER)
	RETURN
SIF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置
	RETURN
SIF PRIVATEROOM:(CFLAG:MASTER:現在位置 % 100)
	RETURN
CALL SYUGOS_GETDATA(人数, 集合)
CALL SYUGOS_COST(人数, 集合)

FOR LOCAL, 0, 人数
	C_ID = 集合:LOCAL:0
	SIF GETBIT(集合:LOCAL:1, 0)
		CONTINUE
	;移動回数が多いと除外
	SIF 集合:LOCAL:2 > 2
		CONTINUE
	SIF CFLAG:C_ID:ブチギレ
		CONTINUE
	SIF CFLAG:C_ID:行動
		CONTINUE
	DEBUGPRINTFORML %CALLNAME:C_ID% is {集合:LOCAL:2} rooms away.
	VALID_PLAYERS:(PEOPLE_NEARBY++) = C_ID
NEXT

@ADD_GAME_VALID_GAMES()
#FUNCTION
;NAS: Non 0 Master
SIF TARGET == MASTER
	RETURNF 0

FOR LOCAL, 1, ADD_GAME_MAX_ID
	SIF GET_INT(TARGET, "ADD_GAME_INFO", LOCAL, "CHECKREQUIREMENTS")
		RETURNF 1
NEXT
RETURNF 0

@ADD_GAME_INITALIZE_VARS()
ADD_GAME_PARTICIPANT_COUNT = 0
ADD_GAME_WINNER_COUNT = 0
ADD_GAME_LOSER_COUNT = 0
VARSET ADD_GAME_PARTICIPANTS, -1
VARSET ADD_GAME_WINNERS, -1
VARSET ADD_GAME_LOSERS, -1
ADD_GAME_SELECTED_GAME = 0
ADD_GAME_SELECTED_BET = 0

@ADD_REMOVE_CLOTHES(CHARA, TYPE)
#DIM  CHARA
#DIMS TYPE

SELECTCASE TYPE
	CASE "TOP"
		;remove innerwear for men alongside outerwear
		IF TALENT:CHARA:2 == 2
			EQUIP:CHARA:上半身下着１ = 0
		ENDIF
		EQUIP:CHARA:ボディースーツ = 0
		EQUIP:CHARA:ワンピース = 0
		EQUIP:CHARA:着物 = 0
		EQUIP:CHARA:レオタード = 0
		EQUIP:CHARA:上半身上着１ = 0
		EQUIP:CHARA:上半身上着２ = 0
	CASE "BOTTOM"
		CALL DATUI_BOTTOM_LATE(CHARA, 3)
	CASE "BRA"
		EQUIP:CHARA:上半身下着１ = 0
	CASE "PANTIES"
		CALL DATUI_BOTTOM_LATE(CHARA, 1)
ENDSELECT

@ADD_CHECK_CLOTHES(CHARA, TYPE)
#FUNCTIONS
#DIM  CHARA
#DIMS TYPE

SELECTCASE TYPE
	CASE "TOP"
		;men's t-shirt is not to be treated as underwear
		IF TALENT:CHARA:2 != 2 && SHOW_上半身下着(CHARA, 0) == SHOW_TOP(CHARA, 0)
			RETURNF SHOW_TOP(CHARA, 1)
		ELSEIF STRLENS(SHOW_TOP(CHARA, 1)) && SHOW_TOP(CHARA, 0) != SHOW_TOP(CHARA, 1)
			RETURNF @"%SHOW_TOP(CHARA, 0)% and %SHOW_TOP(CHARA, 1)%"
		ELSE
			RETURNF SHOW_TOP(CHARA, 0)
		ENDIF
	CASE "BOTTOM"
		IF SHOW_下半身下着(CHARA, 0) == SHOW_BOTTOM(CHARA, 0)
			RETURNF SHOW_BOTTOM(CHARA, 1)
		ELSE
			RETURNF SHOW_BOTTOM(CHARA, 0)
		ENDIF
	CASE "BRA"
		RETURNF SHOW_上半身下着(CHARA, 2)
	CASE "PANTIES"
		RETURNF SHOW_下半身下着(CHARA, 2)
ENDSELECT

@ADD_GAME_LIST_NAMES(MEMBERS)
#FUNCTIONS
#DIM REF MEMBERS
VARSET LOCALS

FOR LOCAL, 0, ADD_GAME_MAXIMUM_PARTICIPANTS
	SIF MEMBERS:LOCAL < 0
		BREAK
	LOCALS += @"%CALLNAME:(MEMBERS:LOCAL)%、"
NEXT
RETURNF LIST_IN_STRING(LOCALS)

@ADD_GAME_EROTIC_BETS_VALID()
#FUNCTION
SIF ADD_GAME_PARTICIPANTS:1 < 0 ;no participants
	RETURNF 0
FOR LOCAL, 1, ADD_GAME_PARTICIPANT_COUNT
	;needs consent and exposure 5 or higher
	SIF !(CFLAG:(ADD_GAME_PARTICIPANTS:LOCAL):既成事実 & 合意_うふふ) || ABL:(ADD_GAME_PARTICIPANTS:LOCAL):露出癖 < 5
		RETURNF 0
	;TODO later: all characters must accept all other characters' relationships?
NEXT
RETURNF 1