@ADD_CUSTOM_COM93
LOCAL:1 = 0
IF !CCOMRangBell
	LOCAL:1 = 1
	CCOMRangBell = 1
	PRINTFORMDL You see an old rusted bell attached to one of the piles at the very end of the Misty Lake's dock.
	PRINTFORMDW An equally aged cord hangs from it, begging to be rung.
	SIF DAY >= 60
		PRINTFORMDW ...Has it always been here?
	PRINTL
ENDIF
PRINTFORMDW You ring the rusted dock bell, causing a pleasant chime to ripple throughout the surface of the lake's water...
PRINTL
IF CFLAG:MASTER:現在位置 == CFLAG:93:現在位置 ;Wakasagihime is already there
	LOCAL = 1
ELSEIF !ADD_RINGBELL_IS_COMING_OUT()
	LOCAL = 2
	PRINTFORMDW But no one came.
ELSE
	LOCAL = 3
	PRINTFORMDW Someone is coming.
	CFLAG:[[わかさぎ姫]]:現在位置 = CFLAG:MASTER:現在位置
	CFLAG:[[わかさぎ姫]]:遭遇位置 = CFLAG:MASTER:現在位置
	TCVAR:[[わかさぎ姫]]:なるべく動かない = 1
	CFLAG:[[わかさぎ姫]]:ディレイ = 60 ;set a delay to prevent her from moving immediately
ENDIF
CALL KOJO_MESSAGE_SEND("EVENT", 0, TARGET, LOCAL, LOCAL:1, "RINGBELL")
;want to add your own dialogue to this? check the end of this file
TIME += 1
RETURN 1

