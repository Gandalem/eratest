;function for group date stuff, unsure if it should just go into MOREDATES.ERB instead
;but it's more visible here so it doesn't clash with another one in the future maybe
@ADD_CUSTOM_COM12
FLAG:デート相手 = TARGET
FOR LOCAL, 0, NumberOfDates
    IF Datees:LOCAL == TARGET
        TFLAG:デート前好感度 = DatesPrevLike:LOCAL
        BREAK
    ENDIF
NEXT
TIME += 5

@ADD_CUSTOM_COM_ABLE12
SIF !MOREDATE
    RETURN 0
SIF !TARGET
    RETURN 0
SIF !FLAG:デート相手 ;must be dating
    RETURN 0
SIF NumberOfDates < 2;must be in a group date
    RETURN 0
SIF !IS_IN_GROUP_DATE(TARGET) ;must be someone in the date
    RETURN 0
SIF CFLAG:MASTER:お招き ;can't switch focus while visiting a room
    RETURN 0

RETURN 1

@ADD_CUSTOM_MESSAGE_COM12
PRINTFORML You switch your focus to %CALLNAME:TARGET%.