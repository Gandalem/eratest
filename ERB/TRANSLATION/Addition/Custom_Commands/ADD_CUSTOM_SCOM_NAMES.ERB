@Add_Custom_COM_Name(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "Play A Game"
	CASE 1
		SIF TEQUIP:MASTER:SWIMMING
			RETURNF "Stop Swimming"
		RETURNF "Go Swimming"
	CASE 2
		RETURNF "Invite To Join Swimming"
	CASE 3
		RETURNF "Swim In The Water"
	CASE 4
		RETURNF "Moon Viewing"
	CASE 5
		RETURNF "Listen To Performance"
	CASE 6
		RETURNF @"Listen With %CALLNAME:TARGET%"
	CASE 7
		RETURNF @"Meeting Point"
	CASE 8
		RETURNF @"Cosplay"
	CASE 9
		SIF STRLENS(STR:0)
			RETURNF @"Continue %STR:0%"	
		RETURNF @"Continue Last Action"
	CASE 10
		RETURNF @"Invite To Join In"
	CASE 12
		RETURNF "Focus On Target"
	CASE 14
		RETURNF "Self-duplication"
	CASE 15
		RETURNF "Pull Out"
	CASE 16
		RETURNF "Bellyjob"
	CASE 17
		SIF TEQUIP:BALL_LICKING
			RETURNF "Stop Ball Sucking"
		RETURNF "Ball Sucking"
	CASE 18
		RETURNF "Commission"
	CASE 21
		RETURNF "Banquet Negotiations"
	CASE 93
		RETURNF "Ring Bell"
	CASE 94
		RESULTS '= "Quest Command"
		TRYCALLF QUEST_COMMAND
		RETURNF RESULTS
	CASE 228
		RETURNF "Armpitjob"
	CASEELSE
		SIF STRLENS(NAS_Custom_COM_Name(ARG))
			RETURNF NAS_Custom_COM_Name(ARG)
		RETURNF "Custom COM"
ENDSELECT

@Add_Custom_SCOM_Name(ARG)
#FUNCTIONS
#DIM SHORT
SELECTCASE ARG
;24
	CASE 0
		RETURNF "Simultaneous Insertion"
	CASE 1
		RETURNF "Simultaneous Anal Insertion"
	CASE 2
		RETURNF "Exposed Reverse Anal Lotus"
	CASE 3
		RETURNF "Exposed Spread Labia"
	CASE 5
		RETURNF "Reverse Spitroast"
	CASE 6
		RETURNF "Double Fingering"
	CASE 7
		LOCAL = ADD_LAST_V_POSE()
		IF LOCAL
			RETURNF @"%ADD_SEX_MODULE_POSE(LOCAL)% and Fingering"
        ENDIF
		RETURNF "V and Fingering"
	CASE 8
		LOCAL = ADD_LAST_V_POSE()
		SIF LOCAL
			RETURNF @"%ADD_SEX_MODULE_POSE(LOCAL)% and Double Fingering"
		RETURNF "V and Double Fingering"
	CASE 9
		RETURNF "Triple Paizuri"
	CASE 10
		RETURNF "Triple Fellatio"
	CASE 11
		RETURNF "Reverse Spitroast and Fingering"
	CASE 12
		RETURNF "Double Handjob"
	CASE 13
		RETURNF "Two Handjobs"
	CASE 14
		RETURNF "Spitroast"
	CASE 15
		RETURNF "Cum Outside"
	CASE 16
		RETURNF "Triple Stack"
	CASE 17
		RETURNF "Triple Penetration"
	CASE 18, 19
		RETURNF "Gangbang"
	CASE 20
		RETURNF "Double Bellyjob"
	CASEELSE
		RETURNF "Custom SCOM"
ENDSELECT
