; Modular ERB: Addition/Custom_Commands/ADD_CUSTOM_SCOM_NAMES.ERB

@Add_Custom_COM_Name(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "게임하기"
	CASE 1
		SIF TEQUIP:MASTER:SWIMMING
			RETURNF "수영 그만두기"
		RETURNF "수영하러 가기"
	CASE 2
		RETURNF "함께 수영하자고 권하기"
	CASE 3
		RETURNF "물속에서 헤엄치기"
	CASE 4
		RETURNF "달구경"
	CASE 5
		RETURNF "연주 감상"
	CASE 6
		RETURNF @"%조사처리(CALLNAME:TARGET,"의")% 목소리에 귀 기울인다"
	CASE 7
		RETURNF @"만남의 장소"
	CASE 8
		RETURNF @"코스프레"
	CASE 9
		SIF STRLENS(STR:0)
			RETURNF @"계속하기 %STR:0%"
		RETURNF @"마지막 행동을 계속한다"
	CASE 10
		RETURNF @"참여를 초대합니다"
	CASE 12
		RETURNF "대상에게 집중"
	CASE 14
		RETURNF "자기복제"
	CASE 15
		RETURNF "빼내기"
	CASE 16
		RETURNF "복부 성교"
	CASE 17
		SIF TEQUIP:BALL_LICKING
			RETURNF "고환 빨기 중단"
		RETURNF "고환 빨기"
	CASE 18
		RETURNF "의뢰"
	CASE 21
		RETURNF "연회 협상"
	CASE 93
		RETURNF "종 울리기"
	CASE 94
		RESULTS '= "의뢰 커맨드"
		TRYCALLF QUEST_COMMAND
		RETURNF RESULTS
	CASE 228
		RETURNF "겨드랑이 성교"
	CASEELSE
		SIF STRLENS(NAS_Custom_COM_Name(ARG))
			RETURNF NAS_Custom_COM_Name(ARG)
		RETURNF "사용자 정의 커맨드"
ENDSELECT

@Add_Custom_SCOM_Name(ARG)
#FUNCTIONS
#DIM SHORT
SELECTCASE ARG
	;24
	CASE 0
		RETURNF "동시 삽입"
	CASE 1
		RETURNF "동시 애널 삽입"
	CASE 2
		RETURNF "노출 역애널 좌위"
	CASE 3
		RETURNF "음순을 벌려 노출"
	CASE 5
		RETURNF "역방향 양면 삽입"
	CASE 6
		RETURNF "양손가락 삽입"
	CASE 7
		LOCAL = ADD_LAST_V_POSE()
		IF LOCAL
			RETURNF @"%ADD_SEX_MODULE_POSE(LOCAL)%와 손가락질"
		ENDIF
		RETURNF "질 삽입과 손가락 자극"
	CASE 8
		LOCAL = ADD_LAST_V_POSE()
		SIF LOCAL
			RETURNF @"%ADD_SEX_MODULE_POSE(LOCAL)%과 더블 핑거링"
		RETURNF "질 삽입과 양손가락 자극"
	CASE 9
		RETURNF "삼중 파이즈리"
	CASE 10
		RETURNF "삼중 펠라치오"
	CASE 11
		RETURNF "역방향 양면 삽입과 손가락 자극"
	CASE 12
		RETURNF "양손 자위"
	CASE 13
		RETURNF "두 사람 손 자위"
	CASE 14
		RETURNF "양면 삽입"
	CASE 15
		RETURNF "질외 사정"
	CASE 16
		RETURNF "삼단 포개기"
	CASE 17
		RETURNF "삼중 삽입"
	CASE 18, 19
		RETURNF "윤간"
	CASE 20
		RETURNF "이중 복부 성교"
	CASEELSE
		RETURNF "사용자 정의 성행위"
ENDSELECT
