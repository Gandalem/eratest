; Modular ERB: Addition/Custom_Commands/ADD_CUSTOM_SCOM_NAMES.ERB

@Add_Custom_COM_Name(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "Play A Game"
	CASE 1
		SIF TEQUIP:MASTER:SWIMMING
			RETURNF "Stop Swimming"
		RETURNF "Go Swimming"
	CASE 2
		RETURNF "Invite To Join Swimming"
	CASE 3
		RETURNF "Swim In The Water"
	CASE 4
		RETURNF "Moon Viewing"
	CASE 5
		RETURNF "Listen To Performance"
	CASE 6
		RETURNF @"%조사처리(CALLNAME:TARGET,"의")% 목소리에 귀 기울인다"
	CASE 7
		RETURNF @"만남의 장소"
	CASE 8
		RETURNF @"코스프레"
	CASE 9
		SIF STRLENS(STR:0)
			RETURNF @"계속하기 %STR:0%"
		RETURNF @"마지막 행동을 계속한다"
	CASE 10
		RETURNF @"참여를 초대합니다"
	CASE 12
		RETURNF "Focus On Target"
	CASE 14
		RETURNF "Self-duplication"
	CASE 15
		RETURNF "Pull Out"
	CASE 16
		RETURNF "Bellyjob"
	CASE 17
		SIF TEQUIP:BALL_LICKING
			RETURNF "Stop Ball Sucking"
		RETURNF "Ball Sucking"
	CASE 18
		RETURNF "Commission"
	CASE 21
		RETURNF "Banquet Negotiations"
	CASE 93
		RETURNF "Ring Bell"
	CASE 94
		RESULTS '= "Quest Command"
		TRYCALLF QUEST_COMMAND
		RETURNF RESULTS
	CASE 228
		RETURNF "Armpitjob"
	CASEELSE
		SIF STRLENS(NAS_Custom_COM_Name(ARG))
			RETURNF NAS_Custom_COM_Name(ARG)
		RETURNF "Custom COM"
ENDSELECT

@Add_Custom_SCOM_Name(ARG)
