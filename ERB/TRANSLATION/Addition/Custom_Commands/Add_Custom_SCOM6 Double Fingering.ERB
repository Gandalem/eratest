; Modular ERB: Addition/Custom_Commands/Add_Custom_SCOM6 Double Fingering.ERB
;Double Fingering

@ADD_CUSTOM_SCOM6
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手）
;二人目
LOCAL = MASTER_POSE(SET_V,SET_YUBI,1)
;行為者
TCVAR:116 = PLAYER
TCVAR:LOCAL:116 = PLAYER
TCVAR:PLAYER:108 = 1
;破瓜抑制
TFLAG:2 = 1
IF FLAG:70
	BASE:MASTER:TSP -= 60
ELSE
	;口上による強制失敗
	SIF TFLAG:192 == -1
		RETURN -1
ENDIF
CALL ADD_CUSTOM_SCOM6_TARGET(TARGET)
CALL ADD_CUSTOM_SCOM6_TARGET(LOCAL)
EXP:PLAYER:手淫経験 ++
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF HETEROSEX(TARGET,PLAYER)
	EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 3
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
ENDIF
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF HETEROSEX(TARGET,LOCAL)
	EXP:LOCAL:(50 + HETEROSEX(TARGET,LOCAL)) += 3
	EXP:TARGET:(50 + HETEROSEX(TARGET,LOCAL)) += 3
ENDIF
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF HETEROSEX(LOCAL,PLAYER)
	EXP:LOCAL:(50 + HETEROSEX(LOCAL,PLAYER)) += 3
	EXP:PLAYER:(50 + HETEROSEX(LOCAL,PLAYER)) += 3
ENDIF
TFLAG:194 = 0
LOCAL:1 = ADD_LESBIANISM_SCORE(TARGET, LOCAL)
IF LOCAL:1 > 0
	IF LOCAL:1 >= 8 && !RAND:3
		TFLAG:194 = 3 ;kiss
	ELSEIF LOCAL:1 >= 5 && !RAND:3
		TFLAG:194 = 2 ;breast grab
	ELSEIF LOCAL:1 >= 3 && !RAND:2
		TFLAG:194 = 1 ;handholding
	ENDIF
ENDIF
RETURN 1

@ADD_CUSTOM_SCOM6_TARGET(ARG)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70
	IF TALENT:ARG:処女 || TALENT:ARG:処女 == -1
		SOURCE:ARG:快Ｖ = 120
		SOURCE:ARG:苦痛 = 10
	ELSE
		SOURCE:ARG:快Ｖ = 60
		SOURCE:ARG:苦痛 = 5
	ENDIF
ELSE
	DOWNBASE:ARG:体力 += 30
	DOWNBASE:ARG:気力 += 80
	IF TALENT:ARG:処女 || TALENT:ARG:処女 == -1 ;com custom code, fix
		SOURCE:ARG:快Ｖ = 120
		SOURCE:ARG:苦痛 = 15
		SOURCE:ARG:露出 = 10
		SOURCE:ARG:逸脱 = 20
		SOURCE:ARG:反感 = 20
		;V経験が0の時はV経験を伴わない物に派生
		;Vの珠は入らないが、快Vが高いと慣らしてあるため処女喪失時に影響
	ELSE
		SOURCE:ARG:快Ｖ = 60
		SOURCE:ARG:苦痛 = 10
		SOURCE:ARG:露出 = 30
		SOURCE:ARG:逸脱 = 30
		SOURCE:ARG:反感 = 30
	ENDIF
ENDIF
SIF TALENT:PLAYER:器用な指
	SOURCE:ARG:快Ｖ += 20
SOURCE:ARG:快Ｖ += ABL:PLAYER:指 * 5
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
IF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	SOURCE:ARG:鬱屈 += 20
	;処女
	SIF TALENT:ARG:処女
		SOURCE:ARG:鬱屈 += 10
ENDIF
;Vへの苦痛
CALL PAIN_CHECK_V(ARG)
STAIN:ARG:6 |= STAIN:PLAYER:1
STAIN:PLAYER:1 |= STAIN:ARG:6
EXP:ARG:Ｖ経験 ++

@ADD_CUSTOM_SCOM_ABLE6
;指挿入れ実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF TFLAG:102 != 2
	RETURN 0
LOCAL = MASTER_POSE(SET_V,SET_YUBI,1)
;時間停止中はスキップ
IF !FLAG:70
	;馴れ合い強度2
	SIF (TCVAR:MASTER:馴れ合い < 2) && CFLAG:睡眠 == 0
		RETURN 0
	;着衣
	SIF TEQUIP:0 & 4
		RETURN 0
	;睡眠中
	SIF CFLAG:睡眠 && CFLAG:イタズラ < 2
		RETURN 0
	;仕事中
	SIF CFLAG:行動 == 5
		RETURN 0
	;デート中
	SIF CHK_DATENOW(CFLAG:デート中) && CFLAG:現在位置 != OMANEKIBEYA()
		RETURN 0
	;添い寝中
	SIF CFLAG:添い寝中
		RETURN 0
	SIF TEQUIP:50 >= 0
		RETURN 0
ENDIF
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF GETBIT (TCVAR:26,5)
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_SCOM6
#DIM DYNAMIC TARGET_TEXT
#DIM DYNAMIC OTHER_TEXT
LOCAL = MASTER_POSE(SET_V,SET_YUBI,1)
IF FLAG:70 == 1
	PRINTFORM 손가락으로 계속 만지면서 %CALLNAME:LOCAL%계속해서 손가락으로 「1」을 만지면서, 당신은 「2」를 「3」 옆에 정렬하고 그녀의 배 쪽으로 손을 뻗어 천천히 손가락을 넣는다. %CALLNAME:TARGET%옆에 %CALLNAME:LOCAL% 그리고 당신의 손을 향해 %ONGOING_G(TARGET)% 배에 손을 뻗어 그녀에게 천천히 손가락을 넣는다 
	IF TEQUIP:0 > 1
		PRINTFORM 그녀를 통해 
		IF PALAM:潤滑 > PALAMLV:3
			PRINT 흥건하게 젖은 
		ELSEIF PALAM:潤滑 > PALAMLV:1
			PRINT 약간 축축한 
		ENDIF
		PRINTFORM %SHOW_BOTTOM(TARGET)%
	ELSE
		PRINTFORM 노출된 보지
	ENDIF
	PRINTFORM ...
	CALL PRINT_BREAK
	PRINTFORM 시간이 멈췄다 
	IF IS_VIRGIN(TARGET)
		TARGET_TEXT = 1
	ELSEIF ABL:Ｖ感覚
		TARGET_TEXT = 2
	ELSE
		TARGET_TEXT = 3
	ENDIF
	IF IS_VIRGIN(LOCAL)
		OTHER_TEXT = 1
	ELSEIF ABL:LOCAL:Ｖ感覚
		OTHER_TEXT = 2
	ELSE
		OTHER_TEXT = 3
	ENDIF
	IF TARGET_TEXT == OTHER_TEXT
		SELECTCASE TARGET_TEXT
			CASE 1
				PRINTFORML 그들은 당신이 부드럽게 그들의 처녀막을 쓸어내릴 때 저항할 수 없다…
			CASE 2
				PRINTFORML 그들은 당신이 그들의 내장을 가지고 놀 때 저항할 수 없다.
			CASE 3
				PRINTFORML 그들의 틈이 탐욕스럽게 당신을 안으로 초대하며, 손가락 주위로 감긴다...
		ENDSELECT
	ELSE
		SELECTCASE TARGET_TEXT
			CASE 1
				PRINTFORM 당신은 %조사처리(CALLNAME:TARGET,"의")% 처녀막을 부드럽게 어루만진다.
			CASE 2
				PRINTFORM 너는 %조사처리(CALLNAME:TARGET,"를")%(를) 안에서 플레이한다
			CASE 3
				PRINTFORM 대략적으로 %조사처리(CALLNAME:TARGET,"의")% 갈망하는 슬릿 안으로 밀어 넣는다.
		ENDSELECT
		PRINTFORM , ~하는 동안 
		SELECTCASE TARGET_TEXT
			CASE 1
				PRINTFORM %CALLNAME:LOCAL%의 희생을 부드럽게 쓸어내리며...
			CASE 2
				PRINTFORM %CALLNAME:LOCAL%의 내부를 가지고 놀면서...
			CASE 3
				PRINTFORM %CALLNAME:LOCAL%의 갈라진 입이 탐욕스럽게 당신을 안으로 초대하며 손가락 주위로 감긴다...
		ENDSELECT
		CALL PRINT_BREAK
	ENDIF
ELSE
	PRINTFORM %CALLNAME:LOCAL%의 손가락을 계속 넣는 동안, 당신은 자신의 손을 %ONGOING_G(TARGET)%의 복부 쪽으로 뻗어 그녀에게 천천히 손가락을 삽입한다. 
	IF TEQUIP:0 > 1
		PRINTFORM 그녀를 통해 
		IF PALAM:潤滑 > PALAMLV:3
			PRINT 흥건하게 젖은 
		ELSEIF PALAM:潤滑 > PALAMLV:1
			PRINT 약간 축축한 
		ENDIF
		PRINTFORM %SHOW_BOTTOM(TARGET)%
	ELSE
		PRINTFORM 노출된 보지
	ENDIF
	PRINTFORM ...
	CALL PRINT_BREAK
	IF IS_VIRGIN(TARGET)
		TARGET_TEXT = 1
	ELSEIF ABL:Ｖ感覚 < 1
		TARGET_TEXT = 2
	ELSEIF ABL:Ｖ感覚 <= 4
		TARGET_TEXT = 3
	ELSE
		TARGET_TEXT = 4
	ENDIF
	IF IS_VIRGIN(LOCAL)
		OTHER_TEXT = 1
	ELSEIF ABL:LOCAL:Ｖ感覚 < 1
		OTHER_TEXT = 2
	ELSEIF ABL:LOCAL:Ｖ感覚 <= 4
		OTHER_TEXT = 3
	ELSE
		OTHER_TEXT = 4
	ENDIF
	IF TARGET_TEXT == OTHER_TEXT
		SELECTCASE TARGET_TEXT
			CASE 1
				PRINTFORML 그들의 허벅지가 당신의 팔을 감싸 안는다, 마치 당신의 손가락이 너무 깊숙이 들어가는 것을 막으려는 것처럼...
			CASE 2
				PRINTFORML 그들의 몸이 이물질의 삽입으로 뻣뻣해진다...
			CASE 3
				PRINTFORML 그들은 당신이 그들을 어루만질 때 뜨겁고 김 서린 신음 소리를 내뱉는다...
			CASE 4
				PRINTFORML 그들은 입을 벌린 채 침을 흘리며 더 많은 쾌감을 찾아 골반을 움직인다...
		ENDSELECT
	ELSE
		PRINTFORM %CALLNAME:TARGET%
		SELECTCASE TARGET_TEXT
			CASE 1
				PRINTFORM 허벅지가 당신의 팔 주위를 조인다. 마치 손가락이 너무 깊숙이 들어가는 것을 막으려는 것처럼.
			CASE 2
				PRINTFORM 그의 몸이 외부의 삽입으로 뻣뻣해진다.
			CASE 3
				PRINTFORM  당신이 그녀를 어루만지자 뜨겁고 김 나는 신음 소리를 내뱉는다.
			CASE 4
				PRINTFORM  그녀는 더 많은 쾌감을 찾으며 골반을 밀어내고, 입을 벌린 채 노골적으로 신음했다.
		ENDSELECT
		PRINTFORM , 반면에 %CALLNAME:LOCAL%은(는)
		SELECTCASE OTHER_TEXT
			CASE 1
				PRINTFORM 그녀의 허벅지가 당신의 팔을 감싸 안으며, 손가락이 너무 깊숙이 들어가는 것을 막으려는 듯했다.
			CASE 2
				PRINTFORM 그의 몸이 이물질의 삽입으로 굳는다...
			CASE 3
				PRINTFORM  당신이 그녀를 어루만지자 뜨겁고 김이 모락모락 나는 신음소리를 내뱉는다...
			CASE 4
				PRINTFORM  그녀는 더 많은 쾌감을 찾으며 골반을 밀어 넣었고, 입은 벌어진 채 노골적으로 신음했다.
		ENDSELECT
		CALL PRINT_BREAK
	ENDIF
	SELECTCASE TFLAG:194
		CASE 1
			PRINTFORML %조사처리(CALLNAME:TARGET,"와")% %CALLNAME:LOCAL%는 계속해서 그들을 기쁘게 하면서 서로를 붙잡고 있다.
		CASE 2
			PRINTFORML %CALLNAME:LOCAL%은(는) %조사처리(CALLNAME:TARGET,"의")% 가슴을 어루만지며 그녀에게 더욱 큰 쾌감을 주려 한다.
		CASE 3
			PRINTFORML %조사처리(CALLNAME:TARGET,"와")% %CALLNAME:LOCAL%이(가) 당신이 그들을 어루만지는 동안 열정적으로 키스한다.
	ENDSELECT
ENDIF

@ASSISTANT_KOJO_CUSTOM_SCOM6
LOCAL = MASTER_POSE(SET_V,SET_YUBI,1)
CALL KOJO_MESSAGE_SEND("COMMAND_ASSISTANT",-1,LOCAL,-1,-1)
