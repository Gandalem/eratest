@ADD_CUSTOM_SCOM12
CALL ADD_CUSTOM_SCOM_MODULE12
CALL ADD_SEX_MODULE_EXECUTE
RETURN 1

@ADD_CUSTOM_SCOM_ABLE12
#DIM DYNAMIC SUCCEED
CALL ADD_CUSTOM_SCOM_MODULE12
CALL ADD_SEX_MODULE_COM_ABLE
SIF !RESULT
	RETURN 0
;everyone needs moderate finger skill
FOR LOCAL, 0, 2
SIF ABL:(ADD_SEX_MODULE_CHARA:LOCAL):指 < 2
	RETURN 0
NEXT
RETURN 1

@ADD_CUSTOM_CAN_SCOM12(ARG)
SKIPDISP ARG
PRINTFORML 더블 수음
SKIPDISP 0
CALL ADD_CUSTOM_SCOM_MODULE12
CALL ADD_SEX_MODULE_CAN_COM(ARG)
RETURN RESULT

@ADD_CUSTOM_MESSAGE_SCOM12
#DIM CURRENT_CHARA
#DIM OTHER_CHARA
#DIM SKILL_DIFFERENCE
SKILL_DIFFERENCE = (ABL:(ADD_SEX_MODULE_CHARA:0):指 * 3 + ABL:(ADD_SEX_MODULE_CHARA:0):技巧) - (ABL:(ADD_SEX_MODULE_CHARA:1):指 * 3 + ABL:(ADD_SEX_MODULE_CHARA:1):技巧)
IF NOWEX:MASTER:射精
	PRINTFORMDL 사정에 가까워지자, %CALLNAME:(ADD_SEX_MODULE_CHARA:0)%와 %CALLNAME:(ADD_SEX_MODULE_CHARA:1)%는 움직임을 가속시키며 당신을 절벽으로 몰아붙인다.
ELSE
	IF TALENT:PLAYER:双槍
		IF ADD_PREV_SELECTED_SCOM == 12
			PRINTFORMDL 그리고 %CALLNAME:(ADD_SEX_MODULE_CHARA:0)%과 %CALLNAME:(ADD_SEX_MODULE_CHARA:1)%는 당신의 %TINKO_TR(PLAYER, 1)%를 함께 계속 어루만졌다.
		ELSE
			PRINTFORMDL %BREAKENG(@"%CALLNAME:(ADD_SEX_MODULE_CHARA:1)%이/가 당신의 %TINKO_TR(PLAYER, 1)% 중 하나를 계속 쓰다, %CALLNAME:(ADD_SEX_MODULE_CHARA:0)%은 나머지 하나를 움켜쥐고 그것을 쓰기 시작한다.")%
		ENDIF
		;both are skilled
		IF ABL:(ADD_SEX_MODULE_CHARA:0):技巧 > 5 && ABL:(ADD_SEX_MODULE_CHARA:0):指 > 3 && ABL:(ADD_SEX_MODULE_CHARA:1):技巧 > 5 && ABL:(ADD_SEX_MODULE_CHARA:1):指 > 3
			PRINTFORMDL 그들의 걸음에 능숙하게 맞춰, 그들의 애무는 당신의 %PLURALIZER(TINKO_TR(PLAYER))%에 엄청난 황홀감을 전한다.
			;one is more skilled
		ELSEIF SKILL_DIFFERENCE
			PRINTFORMDL %CALLNAME:(ADD_SEX_MODULE_CHARA:(SKILL_DIFFERENCE > 0 ? 1 # 0))%은(는) 더 숙련된 %CALLNAME:(ADD_SEX_MODULE_CHARA:(SKILL_DIFFERENCE > 0 ? 0 # 1))%를 따라가는 데 어려움을 겪으며, 당신의 %PLURALIZER(TINKO_TR(PLAYER))%에 불균형한 느낌을 가져온다.
			;equally unskilled
		ELSE
			PRINTFORMDL 둘 다 특별히 숙련된 편은 아니고, 함께 일하는 데 어려움을 겪고 있다는 것은 분명했다.
		ENDIF
	ELSE
		IF ADD_PREV_SELECTED_SCOM == 12
			PRINTFORMDL 그리고 %CALLNAME:(ADD_SEX_MODULE_CHARA:0)%와 %CALLNAME:(ADD_SEX_MODULE_CHARA:1)%가 당신의 %TINKO_TR(PLAYER, 1)%를 함께 계속 쓰다듬는다.
		ELSE
			PRINTFORMDL %BREAKENG(@"%CALLNAME:(ADD_SEX_MODULE_CHARA:0)%은(는) %CALLNAME:(ADD_SEX_MODULE_CHARA:1)%와 함께 당신의 %TINKO_TR(PLAYER, 1)%를 쓰기 시작한다.")%
		ENDIF
		;both are skilled
		IF ABL:(ADD_SEX_MODULE_CHARA:0):技巧 > 5 && ABL:(ADD_SEX_MODULE_CHARA:0):指 > 3 && ABL:(ADD_SEX_MODULE_CHARA:1):技巧 > 5 && ABL:(ADD_SEX_MODULE_CHARA:1):指 > 3
			PRINTFORMDL 그들의 기술은 분명하고, 당신의 %TINKO_TR(PLAYER)%에게 가능한 한 많은 쾌감을 주기 위해 열렬히 협력한다.
			;one is more skilled
		ELSEIF SKILL_DIFFERENCE
			PRINTFORMDL %CALLNAME:(ADD_SEX_MODULE_CHARA:(SKILL_DIFFERENCE > 0 ? 1 # 0))%은/는 %CALLNAME:(ADD_SEX_MODULE_CHARA:(SKILL_DIFFERENCE > 0 ? 0 # 1))%만큼 숙련되지 않았고, %HIS_HER(ADD_SEX_MODULE_CHARA:(SKILL_DIFFERENCE > 0 ? 0 # 1))%와 계속 부딪힌다.
			;equally unskilled
		ELSE
			PRINTFORMDL 둘 다 특별히 능숙하지 않고 계속 서로 부딪힌다.
		ENDIF
	ENDIF
	IF ABL:(ADD_SEX_MODULE_CHARA:0):指 > 4 && ABL:(ADD_SEX_MODULE_CHARA:0):技巧 > 7 && ABL:(ADD_SEX_MODULE_CHARA:1):指 && ABL:(ADD_SEX_MODULE_CHARA:1):技巧 > 7 && !RAND:4
		PRINTFORMDL 자유로운 손을 이용해 그들은 당신의 %FSYN("balls")%를 향해 뻗어 부드럽게 %SPLIT_G("rubbing:fondling:crumpling")%하기 시작한다...
	ELSEIF ABL:(ADD_SEX_MODULE_CHARA:0):指 > 4 && ABL:(ADD_SEX_MODULE_CHARA:0):技巧 > 7 && !RAND:4
		PRINTFORMDL %CALLNAME:(ADD_SEX_MODULE_CHARA:0)%은 당신의 %FSYN("balls")%을 동시에 %SPLIT_G("rub:fondle")%하기 위해 %HIS_HER(ADD_SEX_MODULE_CHARA:0)% 자유로운 손을 사용한다...
	ELSEIF ABL:(ADD_SEX_MODULE_CHARA:1):指 && ABL:(ADD_SEX_MODULE_CHARA:1):技巧 > 7 && !RAND:4
		PRINTFORMDL %CALLNAME:(ADD_SEX_MODULE_CHARA:1)%은(는) 당신의 %FSYN("balls")%를 동시에 %HIS_HER(ADD_SEX_MODULE_CHARA:1)% 자유로운 손으로 %SPLIT_G("rub:fondle")%한다...
	ENDIF
ENDIF

@ASSISTANT_KOJO_CUSTOM_SCOM12
FOR LOCAL, 0, ADD_SEX_MODULE_ACTION_COUNT
SIF ADD_SEX_MODULE_CHARA:LOCAL == TARGET
	CONTINUE
CALL KOJO_MESSAGE_SEND("COMMAND_ASSISTANT",-1,ADD_SEX_MODULE_CHARA:LOCAL,-1,-1)
NEXT

@ADD_CUSTOM_SCOM_SET12
#DIM DYNAMIC H0
#DIM DYNAMIC H1
H0 = ADD_MASTER_POSE_TR(PLAYER, SET_YUBI,SET_P)
H1 = ADD_MASTER_POSE_TR(PLAYER, SET_YUBI,SET_P, 1)
SIF H0 <= 0 || H1 <= 0 ;nothing valid in the current turn
	RETURN 0
SIF H0 == H1
	RETURN 0
ADD_SEX_MODULE_ACTOR:0 = PLAYER
ADD_SEX_MODULE_CHARA:0 = H0
ADD_SEX_MODULE_CHARA:1 = H1
RETURN 1

@ADD_CUSTOM_SCOM_MODULE12
CALL ADD_SEX_MODULE_START(12)
CALL ADD_SEX_MODULE_ADD_ACTION(SET_P, SET_YUBI,,0)
CALL ADD_SEX_MODULE_ADD_ACTION(SET_P, SET_YUBI,,1)
CALL ADD_SEX_MODULE_FINISH
