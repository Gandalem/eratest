	ENDSELECT
ELSE
	PRINTFORMDL 이용 가능한 의뢰 목록
	PRINTFORMDL
	FOR LOCAL,1,COMMISSION_MAX
	;Loop through every commission and check to see if the character can take it.
	RESULT = 0
	TRYCALLFORM COMMISSION_ABLE_{LOCAL}_K%CharacterID%
	IF RESULT && !COMMISSION_PROGRESS:LOCAL
		;Print the number and name of all valid commissions.
