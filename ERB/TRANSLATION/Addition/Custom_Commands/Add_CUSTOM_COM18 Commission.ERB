@COMMISSION_PURCHASE(Commission,Character,ARG)
;Checks if the player has all of the materials to pay the cost of a commission or resolution, and if so, removes the relevant items from the player's inventory.
;ARG = 1 to check the resolution cost instead of the initial cost.
#DIM DYNAMIC Commission
#DIM DYNAMIC Character
#DIMS DYNAMIC CharacterID
CharacterID '= @"{Character}"
;Check if the character is using an alternate dialogue, and if so, get its identifier.
IF CFLAG:Character:口上セレクタ
	RESULTS =
	TRYCALLFORM M_KOJO_K{Character}_{CFLAG:Character:口上セレクタ}
	CharacterID '= @"{Character}%RESULTS%"
ENDIF
LOCAL = 0
$TOP
LOCALS =
SIF ARG
	LOCALS = _RESOLUTION
LOCAL:1 = 0
WHILE 1
;Loop through function definitions for the commission's requirements until they run out.
RESULT = 0
TRYCALLFORM COMMISSION%LOCALS%_COST_{Commission}_K%CharacterID%(LOCAL:1)
LOCAL:2 = RESULT
LOCAL:3 = RESULT:1
IF !LOCAL:2
	;If there's no dialogue-specific cost in the slot, check the default.
	TRYCALLFORM COMMISSION%LOCALS%_COST_{Commission}(LOCAL:1)
	LOCAL:2 = RESULT
	LOCAL:3 = RESULT:1
ENDIF
SELECTCASE LOCAL:2
	CASE 0
		;No requirement.
		BREAK
	CASE -1
		;Nothing.
		;This is used by dialogues to remove default requirements, so we skip it and move on to the next loop.
	CASE -2
		;Rotor.
		SIF ITEM:0 < LOCAL:3
			RETURN 0
		SIF LOCAL
			ITEM:0 -= LOCAL:3
	CASE -3
		;Yen.
		SIF MONEY < LOCAL:3
			RETURN 0
		SIF LOCAL
			MONEY -= LOCAL:3
	CASE -4
		;Charisma.
		SIF MONEY:2 < LOCAL:3
			RETURN 0
		SIF LOCAL
			MONEY:2 -= LOCAL:3
	CASE -5
		;Lumber.
		LOCAL:4 = 0
		FOR LOCAL:5, 1, 13
		LOCAL:4 = MIN(LOCAL:4+LOG_SALES:(LOCAL:5),LOCAL:3)
		NEXT
		SIF LOCAL:4 < LOCAL:3
			RETURN 0
		IF LOCAL
			LOCAL:4 = 0
			FOR LOCAL:5, 1, 13
			LOCAL:6 = LOG_SALES:(LOCAL:5)
			LOG_SALES:(LOCAL:5) -= MIN(LOCAL:3-LOCAL:4,LOG_SALES:(LOCAL:5))
			LOCAL:4 = MIN(LOCAL:4+LOCAL:6,LOCAL:3)
			NEXT
		ENDIF
	CASEELSE
		;Any other item.
		SIF ITEM:(LOCAL:2) < LOCAL:3
			RETURN 0
		SIF LOCAL
			ITEM:(LOCAL:2) -= LOCAL:3
ENDSELECT
LOCAL:1++
WEND
IF !LOCAL
	;After checking all requirements, loop back to the top and start removing them.
	LOCAL = 1
	GOTO TOP
ENDIF
RETURN 1

@EVENTEND
#PRI
TRYCALL COMMISSION_ADVANCE

@COMMISSION_ADVANCE
;Progresses all active commissions, handles commission completion, and triggers events. Called at the end of each day.
#DIMS DYNAMIC CharacterID
FOR LOCAL,1,COMMISSION_MAX
;Loop through every commission.
SIF !COMMISSION_CHARACTER:LOCAL || !(COMMISSION_PROGRESS:LOCAL && COMMISSION_PROGRESS:LOCAL < 1000)
	CONTINUE
CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}"
;Check if the character is using an alternate dialogue, and if so, get its identifier.
IF CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ
	RESULTS =
	TRYCALLFORM M_KOJO_K{COMMISSION_CHARACTER:LOCAL}_{CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ}
	CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}_%RESULTS%"
ENDIF
;Advance the commission.
RESULT = 0
TRYCALLFORM COMMISSION_RATE_{LOCAL}_K%CharacterID%
LOCAL:1 = RESULT
IF !LOCAL:1
	TRYCALLFORM COMMISSION_RATE_{LOCAL}
	LOCAL:1 = RESULT
ENDIF
IF COMMISSION_PROGRESS:LOCAL < 0
	;If the commission is stalled, stop processing it here.
	COMMISSION_EXPECTED_PROGRESS:LOCAL += LOCAL:1*-1
	CONTINUE
ENDIF
COMMISSION_EXPECTED_PROGRESS:LOCAL += LOCAL:1
COMMISSION_PROGRESS:LOCAL += LOCAL:1
;Trigger any events.
CALL SET_KOJO_COLOR(COMMISSION_CHARACTER:LOCAL)
TRYCALLFORM COMMISSION_EVENT_{LOCAL}_K%CharacterID%
RESETCOLOR
IF COMMISSION_PROGRESS:LOCAL > 999
	;Check if the commission has been completed.
	TRYCALLFORM COMMISSION_COMPLETE_{LOCAL}_K%CharacterID%
ENDIF
NEXT

@COMMISSION_WORK_SITE(Location)
;Prints a description of the work being done if the player is at the relevant location.
#DIM DYNAMIC Location
#DIMS DYNAMIC CharacterID
FOR LOCAL,1,COMMISSION_MAX
;Loop through every commission.
SIF !COMMISSION_CHARACTER:LOCAL || !(COMMISSION_PROGRESS:LOCAL && COMMISSION_PROGRESS:LOCAL < 1000)
	CONTINUE
CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}"
;Check if the character is using an alternate dialogue, and if so, get its identifier.
IF CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ
	RESULTS =
	TRYCALLFORM M_KOJO_K{COMMISSION_CHARACTER:LOCAL}_{CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ}
	CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}_%RESULTS%"
ENDIF
;Run all work site functions for each commission and character.
CALL SET_KOJO_COLOR(COMMISSION_CHARACTER:LOCAL)
RESULT = 0
TRYCALLFORM COMMISSION_WORK_SITE_{LOCAL}_K%CharacterID%(Location)
RESETCOLOR
SIF RESULT
	RETURN 1
NEXT
RETURN 0

@COMMISSION_STALL(Commission)
;Stalls or unstalls a commission's progress.
#DIM DYNAMIC Commission
SIF COMMISSION_PROGRESS:Commission > 999
	COMMISSION_PROGRESS:Commission = 999
COMMISSION_PROGRESS:Commission *= -1

