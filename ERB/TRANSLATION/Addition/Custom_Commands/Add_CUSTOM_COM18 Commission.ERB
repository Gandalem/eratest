	ELSEIF COMMISSION_PROGRESS:Commission > COMMISSION_EXPECTED_PROGRESS:Commission
		CALL COLORMESSAGE(@"예정보다 일찍",C_GREEN,1)
	ELSEIF COMMISSION_PROGRESS:Commission < COMMISSION_EXPECTED_PROGRESS:Commission
		CALL COLORMESSAGE(@"일정이 지연됨",C_YELLOW,1)
