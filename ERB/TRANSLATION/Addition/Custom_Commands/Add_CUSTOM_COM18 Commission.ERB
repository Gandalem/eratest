#PRI
TRYCALL COMMISSION_ADVANCE

@COMMISSION_ADVANCE
	;Progresses all active commissions, handles commission completion, and triggers events. Called at the end of each day.
#DIMS DYNAMIC CharacterID
FOR LOCAL,1,COMMISSION_MAX
			;Loop through every commission.
	SIF !COMMISSION_CHARACTER:LOCAL || !(COMMISSION_PROGRESS:LOCAL && COMMISSION_PROGRESS:LOCAL < 1000)
			;Only process commissions in progress.
		CONTINUE
	CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}"
		;Check if the character is using an alternate dialogue, and if so, get its identifier.
	IF CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ
		RESULTS =
		TRYCALLFORM M_KOJO_K{COMMISSION_CHARACTER:LOCAL}_{CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ}
		CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}_%RESULTS%"
	ENDIF
		;Advance the commission.
	RESULT = 0
	TRYCALLFORM COMMISSION_RATE_{LOCAL}_K%CharacterID%
	LOCAL:1 = RESULT
	IF !LOCAL:1
		TRYCALLFORM COMMISSION_RATE_{LOCAL}
		LOCAL:1 = RESULT
	ENDIF
	IF COMMISSION_PROGRESS:LOCAL < 0
			;If the commission is stalled, stop processing it here.
		COMMISSION_EXPECTED_PROGRESS:LOCAL += LOCAL:1*-1
		CONTINUE
	ENDIF
	COMMISSION_EXPECTED_PROGRESS:LOCAL += LOCAL:1
	COMMISSION_PROGRESS:LOCAL += LOCAL:1
		;Trigger any events.
	CALL SET_KOJO_COLOR(COMMISSION_CHARACTER:LOCAL)
	TRYCALLFORM COMMISSION_EVENT_{LOCAL}_K%CharacterID%
	RESETCOLOR
	IF COMMISSION_PROGRESS:LOCAL > 999
			;Check if the commission has been completed.
		TRYCALLFORM COMMISSION_COMPLETE_{LOCAL}_K%CharacterID%
	ENDIF
NEXT

@COMMISSION_WORK_SITE(Location)
	;Prints a description of the work being done if the player is at the relevant location.
#DIM DYNAMIC Location
#DIMS DYNAMIC CharacterID
FOR LOCAL,1,COMMISSION_MAX
			;Loop through every commission.
	SIF !COMMISSION_CHARACTER:LOCAL || !(COMMISSION_PROGRESS:LOCAL && COMMISSION_PROGRESS:LOCAL < 1000)
			;Only process commissions in progress.
		CONTINUE
	CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}"
		;Check if the character is using an alternate dialogue, and if so, get its identifier.
	IF CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ
		RESULTS =
		TRYCALLFORM M_KOJO_K{COMMISSION_CHARACTER:LOCAL}_{CFLAG:(COMMISSION_CHARACTER:LOCAL):口上セレクタ}
		CharacterID '= @"{COMMISSION_CHARACTER:LOCAL}_%RESULTS%"
	ENDIF
		;Run all work site functions for each commission and character.
	CALL SET_KOJO_COLOR(COMMISSION_CHARACTER:LOCAL)
	RESULT = 0
	TRYCALLFORM COMMISSION_WORK_SITE_{LOCAL}_K%CharacterID%(Location)
	RESETCOLOR
	SIF RESULT
		RETURN 1
NEXT
RETURN 0

@COMMISSION_STALL(Commission)
	;Stalls or unstalls a commission's progress.
#DIM DYNAMIC Commission
SIF COMMISSION_PROGRESS:Commission > 999
		;If it was completed just before stalling, set its progress back so that it doesn't silently complete after unstalling.
	COMMISSION_PROGRESS:Commission = 999
COMMISSION_PROGRESS:Commission *= -1

