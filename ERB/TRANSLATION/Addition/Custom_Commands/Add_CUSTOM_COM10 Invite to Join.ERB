@ADD_CUSTOM_COM10
BASE:MASTER:潜伏率 -= RAND:10
CFLAG:TARGET:うふふ = 1
CFLAG:TARGET:LAST_SEX_DAY = DAY ;qol custom code

SETBIT CFLAG:TARGET:潜伏状態,0
TIME += 5

@ADD_CUSTOM_COM_ABLE10
SIF !TARGET
    RETURN 0
SIF FLAG:70
    RETURN 0
SIF CFLAG:うふふ != 0
    RETURN 0
SIF !GETBIT(FLAG:潜伏,0)
    RETURN 0
SIF !(CFLAG:既成事実 & 合意_うふふ)
	RETURN 0
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
SIF !TALENT:無知 && ABL:露出癖 - TALENT:羞恥心 < 3
    RETURN 0

RETURN 1

@ADD_CUSTOM_MESSAGE_COM10
PRINTFORML You covertly motion for %CALLNAME:TARGET% to join you.
PRINTFORMW %HE_SHE(TARGET,1)% slips away from the others and follows you %NAME_HIDING_PLACE(1)%.
