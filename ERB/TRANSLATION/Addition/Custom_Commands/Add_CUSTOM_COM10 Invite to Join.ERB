; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM10 Invite to Join.ERB

@ADD_CUSTOM_COM10
BASE:MASTER:潜伏率 -= RAND:10
CFLAG:TARGET:うふふ = 1
CFLAG:TARGET:LAST_SEX_DAY = DAY ;qol custom code
SETBIT CFLAG:TARGET:潜伏状態,0
TIME += 5

@ADD_CUSTOM_COM_ABLE10
SIF !TARGET
	RETURN 0
SIF FLAG:70
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !GETBIT(FLAG:潜伏,0)
	RETURN 0
SIF !(CFLAG:既成事実 & 合意_うふふ)
	RETURN 0
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
SIF !TALENT:無知 && ABL:露出癖 - TALENT:羞恥心 < 3
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM10
PRINTFORML 당신은 은밀하게 %조사처리(CALLNAME:TARGET,"에게")% 자신을 따라오라는 신호를 보낸다.
PRINTFORMW %HE_SHE(TARGET,1)%는 다른 이들로부터 빠져나와 당신을 %NAME_HIDING_PLACE(1)%로 따른다.
