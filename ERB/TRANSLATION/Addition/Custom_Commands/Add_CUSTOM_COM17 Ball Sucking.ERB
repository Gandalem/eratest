; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM17 Ball Sucking.ERB

@ADD_CUSTOM_COM17
IF TEQUIP:BALL_LICKING
	PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 네 공퇘지 핥는 것을 멈춘다.
	TEQUIP:BALL_LICKING = 0
	TEQUIP:BALL_LICKING_TARGET = 0
	RETURN -1
ENDIF
TEQUIP:BALL_LICKING = 1
TEQUIP:BALL_LICKING_TARGET = PLAYER
CALL ADD_SEX_ACTION_1_4(TARGET, 100)
TIME += 5
RETURN 1
;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------

@ADD_EQUIP_CUSTOM_COM17(ARG)
SELECTCASE SELECTCOM
	CASE 0, 6 TO 9, 11 TO 13, 19 TO 20, 47 TO 50, 60 TO 75, 79, 81 TO 85, 88, 90 TO 94, 100, 105, 120 TO 126, 130 TO 133, 140, 410
		PRINTL 볼 빨기 취소
		IF TEQUIP:BALL_LICKING
			TEQUIP:BALL_LICKING = 0
			TEQUIP:BALL_LICKING_TARGET = 0
		ENDIF
	CASEELSE
		;乳首吸い中
		PRINTL <공을 빨아들임>
		;-------------------------------------------------
		;ソース追加処理
		;-------------------------------------------------
		DOWNBASE:ARG:体力 += 5
		DOWNBASE:ARG:気力 += 20
		DOWNBASE:(TEQUIP:BALL_LICKING_TARGET):体力 += 5
		DOWNBASE:(TEQUIP:BALL_LICKING_TARGET):気力 += 10
		SOURCE:快Ｍ += 20
		SOURCE:露出 += 20
		SOURCE:不潔 += 30
		SOURCE:反感 += 50
		SOURCE:情愛 += 20
		SOURCE:(TEQUIP:BALL_LICKING_TARGET):快Ｃ += 40
		TCVAR:(TEQUIP:BALL_LICKING_TARGET):射精快感強度 += 200
		;-------------------------------------------------
		;汚れの処理
		;-------------------------------------------------
		;調教者が猫舌持ちの場合は、調教者に嗜虐快楽経験を追加
		SIF TALENT:PLAYER:猫舌
			EXP:PLAYER:嗜虐快楽経験 += 1
ENDSELECT
RETURN 1

@ADD_MESSAGE_EQUIP_CUSTOM_COM17
PRINTFORMD %ONGOING_NAME(TARGET)%이 당신의 %FSYN("balls")%를 전부 핥는다

