; Modular ERB: Addition/Custom_Commands/Add_CUSTOM_COM14 Split Body.ERB

@ADD_CUSTOM_COM14
#DIM DYNAMIC TOTAL_STA
#DIM COPIES
FOR LOCAL, 0, CHARANUM
SIF NO:LOCAL == MASTER
	TOTAL_STA += BASE:LOCAL:体力
NEXT
COPIES = CMATCH(NO, MASTER) - 1
PRINTFORMDL 몇 부를 원하나요? STA, ENE, 그리고 VIG는 모든 신체에 균등하게 분배될 겁니다.
CALL ASK_M("5개로 나눈다", COPIES == 4 ? -1 # TEQUIP:MASTER:DOPPELGANGER_MAX >= 4 || ITEM:THREEFOLD_BLESSING, "3개로 나눈다", COPIES == 2 ? -1 # TEQUIP:MASTER:DOPPELGANGER_MAX >= 2 || ITEM:THREEFOLD_BLESSING, "둘로 나눈다", COPIES == 1 ? -1 # TEQUIP:MASTER:DOPPELGANGER_MAX >= 1 || ITEM:THREEFOLD_BLESSING, "복사본을 해제한다", COPIES == 0 ? -1 # 1, "취소", 1)
SELECTCASE RESULT
	CASE 0
		IF TOTAL_STA < 5000
			PRINTFORMDL 당신의 몸들 사이에는 이 많은 몸들을 유지할 만큼 충분한 총 스태미나가 없다.
			RETURN -1
		ELSE
			CALL ADD_CUSTOM_COM14_SPLIT_PLAYER(4)
		ENDIF
	CASE 1
		IF TOTAL_STA < 3000
			PRINTFORMDL 당신의 몸들에 이 많은 몸들을 유지할 만큼 총 스태미나가 충분하지 않다.
			RETURN -1
		ELSE
			CALL ADD_CUSTOM_COM14_SPLIT_PLAYER(2)
		ENDIF
	CASE 2
		IF TOTAL_STA < 2000
			PRINTFORMDL 당신은 이 많은 몸들을 유지할 만큼 충분한 총 스태미나를 가지고 있지 않다.
			RETURN -1
		ELSE
			CALL ADD_CUSTOM_COM14_SPLIT_PLAYER(1)
		ENDIF
	CASE 3
		CALL ADD_CUSTOM_COM14_SPLIT_PLAYER(0)
	CASE 4
		RETURN -1
ENDSELECT
TIME += 5
RETURN 0

@ADD_CUSTOM_COM14_SPLIT_PLAYER(BODY_COUNT)
#DIM BODY_COUNT
#DIM COPIES
#DIM DYNAMIC TOTAL_STA
#DIM DYNAMIC TOTAL_ENE
#DIM DYNAMIC TOTAL_VIG
COPIES = CMATCH(NO, MASTER) - 1
FOR LOCAL, 0, CHARANUM
IF NO:LOCAL == MASTER
	TOTAL_STA += BASE:LOCAL:体力
	TOTAL_ENE += BASE:LOCAL:気力
	TOTAL_VIG += BASE:LOCAL:精力
ENDIF
NEXT
IF !COPIES
	PRINTFORMDL 당신은 자신을 {BODY_COUNT + 1}개의 몸으로 나눈다.
ELSE
	IF BODY_COUNT == 0
		PRINTFORMDL 당신은 당신의 복사본들을 해산시키고 남은 에너지를 회복한다.
	ELSE
		PRINTFORMDL 당신의 기존 복사본들을 해산시키고 자신을 {BODY_COUNT + 1}개로 나눈다.
	ENDIF
ENDIF
CALL Add_Remove_Duplicates_Of_Character(MASTER)
CALL Add_Handle_Duplicate_Deletion(0, 0)
FOR LOCAL, 0, BODY_COUNT
CALL Add_Duplicate_Character(MASTER, @"%NAME:MASTER% ({LOCAL+1})", @"%NAME:MASTER% ({LOCAL+1})")
NEXT
FOR LOCAL, 0, CHARANUM
IF NO:LOCAL == MASTER
	BASE:LOCAL:体力 = MAX(TOTAL_STA / (BODY_COUNT+1), 600) ;set a minimum
	BASE:LOCAL:気力 = TOTAL_ENE / (BODY_COUNT+1)
	BASE:LOCAL:精力 = TOTAL_VIG / (BODY_COUNT+1)
ENDIF
NEXT
CALL TARGETSET_CHACK

@ADD_CUSTOM_COM_ABLE14
SIF !TARGET
	RETURN 0
; SIF CFLAG:うふふ == 0
;     RETURN 0
SIF !TEQUIP:MASTER:DOPPELGANGER_MAX && !ITEM:THREEFOLD_BLESSING
	RETURN 0
RETURN 1

@ADD_CUSTOM_MESSAGE_COM14
