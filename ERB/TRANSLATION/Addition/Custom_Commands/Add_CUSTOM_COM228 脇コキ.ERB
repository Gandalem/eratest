;Armpit
TCVAR:PLAYER:2 = 14
;強度
TCVAR:PLAYER:4 = 500
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 70
	IF TALENT:197
		SOURCE:PLAYER:快Ｃ = 300
	ELSE
		SOURCE:PLAYER:快Ｃ = 150
	ENDIF
ELSE
	DOWNBASE:体力 += 10
	DOWNBASE:気力 += 100
	IF TALENT:197
		SOURCE:PLAYER:快Ｃ = 300
	ELSE
		SOURCE:PLAYER:快Ｃ = 150
	ENDIF
	SOURCE:加虐 = 1000
	SOURCE:征服 = 700
	SOURCE:性行動 = 800
	SOURCE:達成 = 700
	SOURCE:屈従 = 700
	SOURCE:逸脱 = 500
	SOURCE:反感 = 500
