FOR LOCAL, 0, NumberOfDates
Date = Datees:LOCAL
IF FLAG:守矢くじデート相手
	CALL COLORMESSAGE(@"　<Moriya Date With %CALLNAME:(FLAG:守矢くじデート相手)%>",C_YELLOW)
	; only show visiting for focused date
ELSEIF FLAG:催眠デート相手
	CALL COLORMESSAGE(@"　<Hypno-Date With %CALLNAME:(FLAG:催眠デート相手)%>",C_YELLOW)
