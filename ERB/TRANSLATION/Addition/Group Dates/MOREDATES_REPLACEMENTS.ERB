;don't display tired messages when in a private room
SIF INRANGE(TIME, CFLAG:(Date):就寝時間 - 60, CFLAG:(Date):就寝時間) && CFLAG:(Date):現在位置 != OMANEKIBEYA()
	CALL COLORMESSAGE(@"　<%CALLNAME:(Date)% 피곤해 보인다> ", C_D_ORANGE)
