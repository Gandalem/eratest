	FOR LOCAL, 0, CHARANUM
	CALLF FullHeal(LOCAL)
	NEXT
ELSE
	CALLF HESOYAM(ARG)
	FOR LOCAL,1, 24
	ArmorSet:ARG:LOCAL = 0
	CALLF ARMORSTATS(ARG,EQUIP:ARG:LOCAL,,,LOCAL)
	NEXT
	CALLF PANTY_REWORK_CHANGE(ARG,EQUIP:ARG:6)
ENDIF

