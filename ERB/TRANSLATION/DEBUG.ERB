;generates as many children as possible, may or may not work correctly in the first game year
;ADULT_RATIO indicates the percentage of children spawning as adults, nursing children will spawn with a random age

@POP_BOOM(ADULT_RATIO = 50, CHARA = -1)
#FUNCTION
#DIM ADULT_RATIO
#DIM CHARA
;derived from 自立先選定, but not an abomination
#DIM CONST VALID_AREAS = 神社境内, 神社本堂, 夢幻遺跡, 命蓮寺境内, 命蓮寺方丈, 神霊廟広場, 神霊廟道場, 広場, 商家町, 呑屋小道, 広間, 食堂, 大図書館, 斜角の竹林, 永遠亭, 夢幻館, 香霖堂, 中有の道, 三途の川, 彼岸, 白玉楼庭, 畜生界, 玄武の沢, 間欠泉地下センター, 九天の滝, 守矢神社境内, 守矢神社本殿, 旧地獄街道, 地霊殿, 灼熱地獄跡, 月の都, 玉兎の街
FOR LOCAL, 1, CHARANUM-1
SIF LOCAL == RANDOM_CHARANUM || !IS_FEMALE(LOCAL)
	CONTINUE
SIF CFLAG:LOCAL:出禁
	CONTINUE
SIF CHARA != -1 && CHARA != LOCAL
	CONTINUE
;generate child
FOR LOCAL:1, 1, MAXCHILD + 1
SIF CHILD_SEX:LOCAL:(LOCAL:1)
	CONTINUE
EXP:LOCAL:出産経験 += 1
CFLAG:LOCAL:子供人数 ++
CFLAG:MASTER:子供人数 += 1
CHILD_SEX:LOCAL:(LOCAL:1) = RAND:2 + 1
CHILD_WEATHER:LOCAL:(LOCAL:1) '= SPLIT_G("桃色の風:台風:猛吹雪:晴れ:快晴:薄曇:曇り:雨:大雨:霧雨:霧:雪:吹雪:細雪:霧雪:あられ:みぞれ:たしか晴れ:豪雨:ひょう")
CHILD_LOVE:LOCAL:(LOCAL:1) = RAND(-100, 700)
CHILDNAME:LOCAL:(LOCAL:1) '= ランダムキャラ_命名()
IF RAND:100 < ADULT_RATIO
	CHILD_BIRTHDAY:LOCAL:(LOCAL:1) = RAND(1, MAX(DAY - 125, 2))
	CHILD_INDEPENDENT:LOCAL:(LOCAL:1) = 1
	CHILD_AREA:LOCAL:(LOCAL:1) = VALID_AREAS:(RAND:32)
ELSE
	CHILD_INDEPENDENT:LOCAL:(LOCAL:1) = 0
	CHILD_BIRTHDAY:LOCAL:(LOCAL:1) = DAY - RAND:(CHILD_自立 - 1)
	TALENT:LOCAL:育児中 = LOCAL:1
	CFLAG:LOCAL:出産経過日 = DAY - CHILD_BIRTHDAY:LOCAL:(LOCAL:1)
	CFLAG:LOCAL:育児人数 ++
	CFLAG:MASTER:育児人数 += 1
ENDIF
CHILD_BIRTHDATE:LOCAL:(LOCAL:1) = (DAY / 124 + (DAY % 124 ? 1 # 0)) * 1000
CHILD_BIRTHDATE:LOCAL:(LOCAL:1) += DAY:2 * 100 + DAY:3
NEXT
NEXT
DEBUGPRINTFORML 복제 배양이 활성화되었다.
RETURNF 1

