;--------------------------------------------------------
;Makes it so you're now on a date with a character
;--------------------------------------------------------

@DATEME(ARG = -1)
#FUNCTION
SIF ARG == -1
	ARG = TARGET
SIF TARGET == FLAG:デート相手
	RETURNF
IF GET_MAPID(CFLAG:MASTER:現在位置) != MAIN_MAP
	CFLAG:MASTER:同行 = 360
	CFLAG:ARG:同行 = 360
	IF GETVAR("MOREDATE")
		FOR LOCAL, 0, GETVAR("NumberOfDates")
		SIF TARGET == GETVAR("Datees:LOCAL")
			RETURNF
		NEXT
		SETVAR "Datees:NumberOfDates",ARG
		SETVAR "DatesPrevLike:NumberOfDates",CFLAG:ARG:好感度
		SETVAR "NumberOfDates",GETVAR("NumberOfDates")+1
	ENDIF
	CFLAG:ARG:デート中 = CFLAG:MASTER:現在位置 / 100
	FLAG:デート相手 = ARG
	CFLAG:(FLAG:デート相手):来訪時間 = 0
	CFLAG:(FLAG:デート相手):帰宅時間 = 0
	CFLAG:(FLAG:デート相手):就寝時間 = 0
	CFLAG:(FLAG:デート相手):起床時間 = 0
	;メインマップ時は最大三時間まで
ELSE
	CFLAG:MASTER:同行 = 360
	CFLAG:ARG:同行 = 360
ENDIF
