;creates a new active request (if a slot is available) with a specified value for debugging purposes
;this does not perform any validation on the data
;task corresponds to 依頼内容

@Create_Request_With_IRAI_DATA(REQUEST_ID, REQUEST_TARGET, TASK, GIVER = -1)
#FUNCTION
#DIM REQUEST_ID
#DIM REQUEST_TARGET
#DIMS TASK
#DIM GIVER
#DIM IRAI_ID
#DIM CHK_SLOT
CHK_SLOT = SEARCH_IRAI_EMPTY()
SIF !CHK_SLOT
	RETURNF 0
IF GIVER == -1
	GIVER = TARGET
ENDIF
SIF !INRANGE(GIVER, 1, CHARANUM-2)
	RETURNF 0
IRAI_ID = MAKE_IRAI_ID(GIVER, REQUEST_ID)
IF TASK == ""
	SELECTCASE REQUEST_ID
		CASE 1, 3, 4, 5, 7, 15, 90, 91
			TASK = 作業
		CASE 2, 94
			TASK = 伝令（場所）
		CASE 6, 16
			TASK = その他
		CASE 7, 8
			TASK = 伝令（人物）
		CASE 9, 11
			TASK = 捜索（人物）
		CASE 10
			TASK = 捜索（場所）
		CASE 12
			TASK = 討伐
		CASE 13, 14, 95
			TASK = 調達
		CASE 17, 18, 93
			TASK = food
		CASE 92
			TASK = prank
	ENDSELECT
ENDIF
CFLAG:GIVER:依頼状況 = 2
CFLAG:GIVER:依頼内容 = IRAI_ID
IRAI_SLOT:CHK_SLOT     = IRAI_ID
IRAI_DATA:CHK_SLOT     = MAKE_IRAI_DATA(REQUEST_TARGET, TASK)
IRAI_SUB:CHK_SLOT      = INT_DATA_IRAI(IRAI_ID, "依頼サブ", GIVER)
IRAI_DEADLINE:CHK_SLOT = INT_DATA_IRAI(IRAI_ID, "依頼期限", GIVER) + DAY
RETURNF CHK_SLOT
