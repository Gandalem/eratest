;prints locations the player can go to, either one, or multiple
;if ARG:1 isn't specified it prints just one
;if ARG:1 is specified it prints all from ARG to ARG:1
@PRINT_DESTINATION(ARG, ARG:1 = -1)
IF ARG:1 == -1
	SIF CFLAG:MASTER:現在位置 == 100*MAIN_MAP+ARG ;highlight current location
		SETCOLOR C_AQUA
	SIF PlayerLandSelection == 1 && AvailableHousingAreas(1, 100*MAIN_MAP+ARG) ; NAS: Player land selection mode
		RETURN
	PRINTBUTTON @"{ARG}:%NAME_FROM_PLACE(8000+100*MAIN_MAP+ARG)% ",100*MAIN_MAP+ARG
	RESETCOLOR
ELSE
	FOR LOCAL, ARG, ARG:1+1
		SIF CFLAG:MASTER:現在位置 == 100*MAIN_MAP+LOCAL ;highlight current location
			SETCOLOR C_AQUA
		SIF PlayerLandSelection == 1 && AvailableHousingAreas(1, 100*MAIN_MAP+LOCAL) ; NAS: Player land selection mode
			CONTINUE
		PRINTBUTTON @"{LOCAL}:%NAME_FROM_PLACE(8000+100*MAIN_MAP+LOCAL)% ",100*MAIN_MAP+LOCAL
		RESETCOLOR
	NEXT
ENDIF