	FOR LOCAL, OBJ_ID_FIRST, OBJ_ID_LAST + 1
	SIF !STRLENS(GET_STR(0, CLASS_NAME, LOCAL, "名前"))
		CONTINUE
	PRINTFORML [{LOCAL, 3}] - %LISTING_TR(GET_STR(0, CLASS_NAME, LOCAL, "名前"))%
	NEXT
ENDIF

