					PRINTL
					PRINTL
				ELSEIF キャラ画像表示サイズ比 <= 75
					PRINTL
				ELSEIF キャラ画像表示サイズ比 >= 149
					CLEARLINE 1
				ENDIF
				SIF TALENT:C_ID:行きずり
					PRINTL
			ELSE
				SIF キャラ画像表示サイズ比 <= 75
					PRINTL
			ENDIF
		ENDIF
		CALL PRINT_STATE_CLOTH(C_ID)
		CALL PRINT_STATE_TALENT(C_ID)
		PRINTL
		;CALL PRINT_ABL_TR(C_ID)
		SIF !TALENT:C_ID:NonSentient
			CALL PRINT_ABL_MOD(C_ID)
		IF !TALENT:C_ID:NonSentient
			PRINTL
			CALL PRINT_ADDICT_MOD(C_ID)
		ENDIF
	CASE 1
		PRINTL
		CALL PRINT_STATE_EXP(C_ID)
		;PRINTL
		;現状マスターは妊娠しないはずだが将来の機能拡張を考えるとこれでいいのか？
		SIF (TALENT:C_ID:妊娠 || CFLAG:C_ID:子供人数 > 0)
			CALL 妊娠関連(C_ID)
		SIF (C_ID == MASTER) && (CFLAG:MASTER:子供人数 > 0)	;custom code
			CALL Qol_MC_CHILD
		CALL Endurance_Bars(C_ID)
		IF STRCOUNT(OP, "「調教中」")
			CALL PRINT_STATE_EX(C_ID)
		ELSEIF !(C_ID == MASTER)
			CALL PRINT_STATE_JUEL_TR(C_ID)
		ENDIF
		PRINTL
		IF C_ID == MASTER
			CALL 予定
		ELSE
			CALL パンツ収集状況(C_ID)
		ENDIF
		CALL YoujutsuSelfStudyQuestTrack(C_ID,"GET");NAS YOUJUTSU
		SIF C_ID != MASTER ;custom code
			CALL QOL_CHARA_SCORES(C_ID)
	CASE 2
		CALL PRINT_STATE_PERSONAL(C_ID)
		;CALL 肉体情報(C_ID)
		CALL SHOW_RELATION(C_ID)
		;NAS continence stuff
		SIF nPantyPunish
			CALL SHOW_PANTY_PRIVELEGE(C_ID)
		SIF nChastityPunish
			CALL SHOW_CHASTITY_PRIVILEGE(C_ID)
	CASE 3
		CALL PRINT_STATE_PREFERENCE(C_ID)
		CALL PRINT_STATE_GIFTDATA(C_ID, 15)
	CASE 4
		CALL SHOW_SIZE(C_ID)
		CALL NAS_BODY(C_ID)
		PRINTL
		CALL 肉体情報(C_ID)
	CASE 5
		IF C_ID == MASTER
			CALL SHOW_ALLITEM_INFO
		ELSE
			CALL 陥落条件表示(C_ID)
			CALL 浮気把握状況(C_ID)
			CALL PRINT_REP(C_ID)
			SIF nNecro
				CALL PRINT_DEATHS(C_ID)
		ENDIF
	CASE 6
		CALL EVALUATE_GIRLPOWER_NAS(C_ID,2)
	CASE 7
		CALL COMBAT_DESCRIPTION(C_ID)
	CASE 8
		CALL BODY_PART_HEALTH(C_ID, 2)
	CASE 9
		CALL RELIGION_DESCRIPTION(TALENT:C_ID:Religion)
	CASE 10
		CALL AllFactionList(C_ID, "ID", 0, "「Page Only」")
	CASE 11
		CALL KOJO_OPTION(C_ID)
	CASEELSE
		THROW 異常なPAGE {PAGE}
ENDSELECT
