@EXP_DEMAND_OF_LAST_CHECK(ARG,ARG:1,ARG:2,ARG:3,ARG:4)
#FUNCTION
IF ARG == -1 || ABL:(ARG:4):ARG == 0
	RETURNF 0
ELSE
	ABL:(ARG:4):ARG--
	LOCAL = EXP_DEMAND(ARG:1,ARG:2,ARG:3,ARG:4)
	ABL:(ARG:4):ARG++
	RETURNF LOCAL
ENDIF
