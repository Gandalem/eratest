				PRINT |
			ENDIF
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 47)
			PRINT |
			PRINTFORML
		ELSE
			;好感度
			CALL PRINT_RANK(CFLAG:C_ID:好感度, "MAX_1M")
			PRINTFORM {CFLAG:C_ID:好感度, 7}| 
