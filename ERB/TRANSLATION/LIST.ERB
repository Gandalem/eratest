;ARG  =Current xp
;ARG:1=Total xp required
;ARG:2=Bar progress (xp into current rank)
;ARG:3=Bar progress required (xp required from current until next rank)

@ABILITY_FORMAT_HTML(ARG, ARG:1, ARG:2, ARG:3)
#FUNCTIONS
IF !ARG:3;bar progress not set, default to calculate with total xp
	ARG:2 = ARG
	ARG:3 = ARG:1
ENDIF
IF GETPERCENT(ARG:2, ARG:3) > 100
	RETURNF @"{ARG}/{ARG:1} - %BW_BAR(ARG:2, ARG:3)% 100\%"
ELSEIF GETPERCENT(ARG:2, ARG:3) < 0 ;could become negative if characters have a higher rank than their experience level would indicate, such as Okina having Rank 4 Music but only 500 xp in the related skills
	RETURNF @"{ARG}/{ARG:1} - %BW_BAR(ARG:2, ARG:3)% 0\%"
ELSEIF ARG:1 < 1
	RETURNF @"N/A"
ELSE
	RETURNF @"{ARG}/{ARG:1} - %BW_BAR(ARG:2, ARG:3)% {GETPERCENT(ARG:2, ARG:3)}\%"
ENDIF
;calculate required progress until next skill and use that to determine the progress bar length
;ARGS: skill name
;ARG:1 skill experience id
;ARG:2 skill rank
;ARG:3 skill experience

@ABILITY_FORMAT_EXPERIENCE(ARGS, ARG:1, ARG:2, ARG:3)
#FUNCTIONS
LOCALS =
SELECTCASE ARG:1
	CASE GETNUM(EXP, "学習経験"), GETNUM(EXP, "戦闘経験"), GETNUM(EXP, "料理経験"), GETNUM(EXP, "伐採経験"), GETNUM(EXP, "釣り経験"), GETNUM(EXP, "採集経験"), GETNUM(EXP, "調合経験"), GETNUM(EXP, "会話経験"), GETNUM(EXP, "清掃経験"), GETNUM(EXP, "催眠経験"), GETNUM(EXP, "Shooting"), GETNUM(EXP, "Melee"), GETNUM(EXP, "Medical") ;added
		IF ARG:2 >= MaxNonHLevel
			LOCALS += @"    최대치 달성!"
		ELSE
			CALLF Qol_XpProgressToNextLevel(ARG:1, ARG:2, ARG:3)
			LOCALS += "경험:\n"
			LOCALS += @"    %ARGS%: %ABILITY_FORMAT_HTML(ARG:3, RESULT:2, RESULT:0, RESULT:1)%"
		ENDIF
	CASE GETNUM(EXP, "演奏経験"), GETNUM(EXP, "歌唱経験"), GETNUM(EXP, "舞踏経験")
		IF ARG:2 >= MaxNonHLevel
			LOCALS += @"    최대치 달성!"
		ELSE
			CALLF Qol_XpProgressToNextLevel(ARG:1, ARG:2, ARG:3)
			LOCALS += "특수 조건:\n"
			LOCALS += @"    %ARGS%: %ABILITY_FORMAT_HTML(ARG:3, RESULT:2, RESULT:0, RESULT:1)%"
		ENDIF
	CASEELSE
			LOCALS += @"경험치 표시 함수에 정의되지 않은 경우입니다: 인수=%ARGS%, 값1={ARG:1}, 값2={ARG:2}, 값3={ARG:3}"
ENDSELECT
RETURNF LOCALS

