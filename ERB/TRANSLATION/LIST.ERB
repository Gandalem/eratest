@EXP_SINCE_LAST(ARG,ARG:1,ARG:2,ARG:3)
#FUNCTION
RETURNF EXP:(ARG:3):(ARG:2) - EXP_DEMAND_OF_LAST(ARG,ARG:1,ARG:2,ARG:3)

@EXP_DEMAND_OF_LAST(ARG,ARG:1,ARG:2,ARG:3)
#FUNCTION
#DIM DYNAMIC ABL_INDEX = -1
SELECTCASE ARG
	CASE 2
		ABL_INDEX = GETNUM(ABL, "Ａ感覚")
	CASE 13
		ABL_INDEX = GETNUM(ABL, "奉仕精神")
	CASE 15
		ABL_INDEX = GETNUM(ABL, "マゾっ気")
	CASE 16
		ABL_INDEX = GETNUM(ABL, "サドっ気")
	CASE 17
		ABL_INDEX = GETNUM(ABL, "レズっ気")
	CASE 18
		ABL_INDEX = GETNUM(ABL, "ホモっ気")
	CASE 30
		ABL_INDEX = GETNUM(ABL, "自慰中毒")
	CASE 31
		ABL_INDEX = GETNUM(ABL, "精液中毒")
	CASE 32
		ABL_INDEX = GETNUM(ABL, "レズ中毒")
	CASE 33
		ABL_INDEX = GETNUM(ABL, "ゲイ中毒")
	CASE 34
		ABL_INDEX = GETNUM(ABL, "膣射中毒")
	CASE 35
		ABL_INDEX = GETNUM(ABL, "肛射中毒")
ENDSELECT
RETURNF EXP_DEMAND_OF_LAST_CHECK(ABL_INDEX, ARG,ARG:1,ARG:2,ARG:3)
;ARG = ABL index

@EXP_DEMAND_OF_LAST_CHECK(ARG,ARG:1,ARG:2,ARG:3,ARG:4)
#FUNCTION
IF ARG == -1 || ABL:(ARG:4):ARG == 0
	RETURNF 0
ELSE
	ABL:(ARG:4):ARG--
	LOCAL = EXP_DEMAND(ARG:1,ARG:2,ARG:3,ARG:4)
	ABL:(ARG:4):ARG++
	RETURNF LOCAL
ENDIF
