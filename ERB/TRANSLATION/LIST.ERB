;ARG  =Current xp
;ARG:1=Total xp required
;ARG:2=Bar progress (xp into current rank)
;ARG:3=Bar progress required (xp required from current until next rank)

@ABILITY_FORMAT_HTML(ARG, ARG:1, ARG:2, ARG:3)
#FUNCTIONS
IF !ARG:3;bar progress not set, default to calculate with total xp
	ARG:2 = ARG
	ARG:3 = ARG:1
ENDIF
IF GETPERCENT(ARG:2, ARG:3) > 100
	RETURNF @"{ARG}/{ARG:1} - %BW_BAR(ARG:2, ARG:3)% 100\%"
ELSEIF GETPERCENT(ARG:2, ARG:3) < 0 ;could become negative if characters have a higher rank than their experience level would indicate, such as Okina having Rank 4 Music but only 500 xp in the related skills
	RETURNF @"{ARG}/{ARG:1} - %BW_BAR(ARG:2, ARG:3)% 0\%"
ELSEIF ARG:1 < 1
	RETURNF @"N/A"
ELSE
	RETURNF @"{ARG}/{ARG:1} - %BW_BAR(ARG:2, ARG:3)% {GETPERCENT(ARG:2, ARG:3)}\%"
ENDIF
;calculate required progress until next skill and use that to determine the progress bar length
;ARGS: skill name
;ARG:1 skill experience id
;ARG:2 skill rank
;ARG:3 skill experience

@ABILITY_FORMAT_EXPERIENCE(ARGS, ARG:1, ARG:2, ARG:3)
#FUNCTIONS
LOCALS =
SELECTCASE ARG:1
	CASE GETNUM(EXP, "学習経験"), GETNUM(EXP, "戦闘経験"), GETNUM(EXP, "料理経験"), GETNUM(EXP, "伐採経験"), GETNUM(EXP, "釣り経験"), GETNUM(EXP, "採集経験"), GETNUM(EXP, "調合経験"), GETNUM(EXP, "会話経験"), GETNUM(EXP, "清掃経験"), GETNUM(EXP, "催眠経験"), GETNUM(EXP, "Shooting"), GETNUM(EXP, "Melee"), GETNUM(EXP, "Medical") ;added
		IF ARG:2 >= MaxNonHLevel
			LOCALS += @"    최대치 달성!"
		ELSE
			CALLF Qol_XpProgressToNextLevel(ARG:1, ARG:2, ARG:3)
			LOCALS += "Experience:\n"
			LOCALS += @"    %ARGS%: %ABILITY_FORMAT_HTML(ARG:3, RESULT:2, RESULT:0, RESULT:1)%"
		ENDIF
	CASE GETNUM(EXP, "演奏経験"), GETNUM(EXP, "歌唱経験"), GETNUM(EXP, "舞踏経験")
		IF ARG:2 >= MaxNonHLevel
			LOCALS += @"    최대치 달성!"
		ELSE
			CALLF Qol_XpProgressToNextLevel(ARG:1, ARG:2, ARG:3)
			LOCALS += "Special:\n"
			LOCALS += @"    %ARGS%: %ABILITY_FORMAT_HTML(ARG:3, RESULT:2, RESULT:0, RESULT:1)%"
		ENDIF
	CASEELSE
		LOCALS += @"@ABILITY_FORMAT_EXPERIENCE: ARGS = %ARGS%, ARG:1 = {ARG:1}, ARG:2 = {ARG:2}, ARG:3 = {ARG:3}에 대해 정의되지 않은 Case입니다."
ENDSELECT
RETURNF LOCALS

@CALC_RANK_FUNCTION(VAR_VALUE, RANK_SCALE)
#FUNCTION
#DIM      VAR_VALUE  ;評価対象数値
#DIMS     RANK_SCALE ;評価に使用する尺度の種類
#DIM RANK       ;評価ランク、数が小さいほど優秀
SELECTCASE RANK_SCALE
	CASE "MAX_50000"
		;好感度用
		SELECTCASE VAR_VALUE
			CASE IS >= 50000
				RANK = 0
			CASE IS >= 30000
				RANK = 1
			CASE IS >= 10000
				RANK = 2
			CASE IS >=  5000
				RANK = 3
			CASE IS >=  3000
				RANK = 4
			CASE IS >=  1500
				RANK = 5
			CASE IS >=  1000
				RANK = 6
			CASE IS >=   500
				RANK = 7
			CASE IS >=   100
				RANK = 8
			CASEELSE
				RANK = 9
		ENDSELECT
	CASE "MAX_1M"
		;new cap
		SELECTCASE VAR_VALUE
			CASE IS >= 1000000
				RANK = 0
			CASE IS >= 500000
				RANK = 1
			CASE IS >= 300000
				RANK = 2
			CASE IS >= 100000
				RANK = 3
			CASE IS >= 50000
				RANK = 4
			CASE IS >= 30000
				RANK = 5
			CASE IS >= 10000
				RANK = 6
			CASE IS >=  5000
				RANK = 7
			CASE IS >=  3000
				RANK = 8
			CASE IS >=  1500
				RANK = 9
			CASE IS >=  1000
				RANK = 10
			CASE IS >=   500
				RANK = 11
			CASE IS >=   100
				RANK = 12
			CASEELSE
				RANK = 13
		ENDSELECT
	CASE "MAX_20000"
		;信頼度用
		SELECTCASE VAR_VALUE
			CASE IS >= 500000
				RANK = 0
			CASE IS >= 300000
				RANK = 1
			CASE IS >= 100000
				RANK = 2
			CASE IS >= 50000
				RANK = 3
			CASE IS >= 20000
				RANK = 4
			CASE IS >= 10000
				RANK = 5
			CASE IS >=  3000
				RANK = 6
			CASE IS >=  1000
				RANK = 7
			CASE IS >=   500
				RANK = 8
			CASE IS >=   150
				RANK = 9
			CASE IS >=   100
				RANK = 10
			CASE IS >=    50
				RANK = 11
			CASE IS >=    10
				RANK = 12
			CASEELSE
				RANK = 13
		ENDSELECT
	CASE "MAX_1000"
		;Agreement
		SELECTCASE VAR_VALUE
			CASE IS >= 1000
				RANK = 0
			CASE IS >= 900
				RANK = 1
			CASE IS >= 800
				RANK = 2
			CASE IS >= 600
				RANK = 3
			CASE IS >= 500
				RANK = 4
			CASE IS >= 400
				RANK = 5
			CASE IS >= 300
				RANK = 6
			CASE IS >= 200
				RANK = 7
			CASE IS >= 150
				RANK = 8
			CASE IS >= 100
				RANK = 9
			CASE IS >= 75
				RANK = 10
			CASE IS >= 50
				RANK = 11
			CASE IS >= 0
				RANK = 12
			CASEELSE
				RANK = 13
		ENDSELECT
	CASE "MAX_99"
		;技術系以外のABL
		;数字が縦に並ぶと非常に見にくかったんで意図的にインデントずらしてます
		SELECTCASE VAR_VALUE
			CASE IS >= 500
				RANK = 0
			CASE IS >= 350
				RANK = 1
			CASE IS >= 250
				RANK = 2
			CASE IS >= 150
				RANK = 3
			CASE IS >= 99
				RANK = 4
			CASE IS >= 75
				RANK = 5
			CASE IS >= 50
				RANK = 6
			CASE IS >= 20
				RANK = 7
			CASE IS >= 10
				RANK = 8
			CASE IS >=  5
				RANK = 9
			CASE IS >=  3
				RANK = 10
			CASE IS >=  2
				RANK = 11
			CASE IS >=  1
				RANK = 12
			CASEELSE
				RANK = 13
		ENDSELECT
	CASE "MAX_5_SCALE"
		;技術系以外のABL
		;数字が縦に並ぶと非常に見にくかったんで意図的にインデントずらしてます
		SELECTCASE VAR_VALUE
			CASE IS >= 6
				RANK = 0
			CASE IS >= 5
				RANK = 1
			CASE IS >=  4
				RANK = 2
			CASE IS >=  3
				RANK = 3
			CASE IS >=  2
				RANK = 4
			CASE IS >=  1
				RANK = 5
			CASE IS >=  0
				RANK = 6
			CASE IS >=  -1
				RANK = 7
			CASE IS >=  -2
				RANK = 8
			CASE IS >=  -3
				RANK = 9
			CASE IS >=  -4
				RANK = 10
			CASEELSE
				RANK = 11
		ENDSELECT
	CASE "LEVEL_REWORK"
		GOTO MAX6_Rework
	CASE "MAX_6"
		;技能系ABL
		IF 0
			$MAX6_Rework
			SELECTCASE VAR_VALUE
				CASE IS >= 50
					RANK = 0
				CASE IS >= 40
					RANK = 1
				CASE IS >= 30
					RANK = 2
				CASE 20 TO 29
					RANK = 3
				CASE 17 TO 19
					RANK = 4
				CASEELSE
					RANK = MAX(21 - (VAR_VALUE), 0)
			ENDSELECT
		ELSE
			RANK = MAX(10 - (VAR_VALUE), 0)
		ENDIF
	CASE "MAX_CHESS"
		RANK = MAX(10 - (VAR_VALUE), 0)
	CASEELSE
		THROW 不明なRANK_SCALE %RANK_SCALE%
ENDSELECT
RETURNF RANK

@CALC_RANK_NUM_FUNCTION(VAR_VALUE, RANK_SCALE)
#FUNCTION
#DIM      VAR_VALUE  ;評価対象数値
#DIMS     RANK_SCALE ;評価に使用する尺度の種類
#DIM RANK_NUM
SELECTCASE RANK_SCALE
	CASE "MAX_50000"
		;好感度用
		RANK_NUM = 10
	CASE "MAX_1M"
		RANK_NUM = 10
	CASE "MAX_20000"
		;信頼度用
		RANK_NUM = 10
	CASE "MAX_99"
		;技術系以外のABL
		;数字が縦に並ぶと非常に見にくかったんで意図的にインデントずらしてます
		RANK_NUM = 10
	CASE "MAX_5_SCALE"
		;needed for endurance abilities
		RANK_NUM = 12
	CASE "MAX_1000"
		;Agreement
		RANK_NUM = 10
	CASE "MAX_6"
		;技能系ABL
		RANK_NUM = 9969
	CASE "LEVEL_REWORK"
		RANK_NUM = 7
	CASE "MAX_CHESS"
		;技能系ABL
		RANK_NUM = 9934
	CASEELSE
		THROW 不明なRANK_SCALE %RANK_SCALE%
ENDSELECT
RETURNF RANK_NUM

