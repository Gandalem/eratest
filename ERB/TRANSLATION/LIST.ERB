@SINGLE_CHARA_STATE_TR(C_ID,OP)
#DIMS    OP         ;実行オプション
#DIM     C_ID       ;登録番号
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "Clothes and ability", "Exp and Gems", "Personal Information", "Preferences", "Body Information", "Falling Conditions", "Scouter", "Combat", "Health", "Religion", "Faction"
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
CALL CHARA_STATE_TR(C_ID, PAGE, OP)
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
SELECTCASE LOCAL
	CASE 9
		SIF !nReligions
			CONTINUE
	CASE 10
		SIF !nFactions
			CONTINUE
ENDSELECT
;exception for player character
PRINTBUTTON C_ID == MASTER && LOCAL == 5 ? "Skill Acquisition" # DISP_NAME:LOCAL, LOCAL + 2
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML 
IF STRCOUNT(OP, "「最終確認」")
	PRINTBUTTON "[1] 이 캐릭터를 선택한다", 1
	PRINTFORM 　　　　　　　　　
	PRINTBUTTON "[0] 리턴한다.", 0
	PRINTFORML 
ELSE
	PRINTBUTTON "[0] 반환한다", 0
ENDIF
DO
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		SIF STRCOUNT(OP, "「最終確認」")
			RETURN C_ID
		GOTO RETRY
	CASE 2 TO VARSIZE("DISP_NAME")+2
		PAGE = RESULT-2
	CASE 98
		CFLAG:C_ID:差し替え適用 ++
		IF FLAG:立ち絵種類
			SIF CFLAG:C_ID:別顔有 < CFLAG:C_ID:差し替え適用
				CFLAG:C_ID:差し替え適用 = 0
		ELSE
			SIF CFLAG:C_ID:別立ち有 < CFLAG:C_ID:差し替え適用
				CFLAG:C_ID:差し替え適用 = 0
		ENDIF
		;表示・非表示の切替
	CASE 160 TO 169, 900, 904, 909, 175 ;custom code
		TFLAG:RESULT = !TFLAG:RESULT
	CASE 1880
		ProfileFilters:0 = !ProfileFilters:0
	CASE 画像切り替え
		IF !FLAG:画像表示
			FLAG:画像表示 = !FLAG:画像表示
			SIF FLAG:画像表示 && nStoreImageCount > 0 ;qol custom code, restore previous value if enabled
				FLAG:画像表示 = nStoreImageCount
			FLAG:立ち絵種類 = 0
			CFLAG:C_ID:差し替え適用 = 0 ;custom code
		ELSEIF !FLAG:立ち絵種類
			FLAG:立ち絵種類 = !FLAG:立ち絵種類
		ELSEIF FLAG:立ち絵種類
			SIF FLAG:画像表示 ;qol custom code, store previous value if it's going to be disabled
				nStoreImageCount = FLAG:画像表示
			FLAG:画像表示 = !FLAG:画像表示
		ENDIF
	CASE 9997 ;custom code
		CALL Qol_Info_ChildList(C_ID, 1)
		WAIT
	CASE 9998 ;custom code
		CALL Qol_MC_CHILD_LIST
		;switch to a mother's page when clicked
		IF INRANGE(RESULT, 10000, 11000)
			RESULT -= 10000
			IF EXISTCSV(NO:RESULT)
				PAGE = 0
				C_ID = RESULT
			ENDIF
		ENDIF
		BREAK
	CASE 9999 ;custom code
		qol_Relation_AscendingOrder = !qol_Relation_AscendingOrder
	CASE 3500 TO 3506 ;custom code: Falling Condition Tab Rework
		SFSR_PAGE = RESULT-3500
	CASE IS > 100000
		;NAS: hediff menu
		D = RESULT
		P = D/100000
		H = D - (P*100000)
		SIF !IsBionicPart(C_ID,P,H)
			CONTINUE
		TRYCALLFORM BIONIC_CONFIG_{DT_CELL_GET(@"Hediff", HediffGet(C_ID,P,H), "type", 1)}(C_ID)
	CASEELSE
		$RETRY
		REUSELASTLINE Invalid Input
		CONTINUE
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

