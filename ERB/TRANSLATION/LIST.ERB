@SORT_LIST_TR(SORT_TYPE, CHARA_LIST, CHARA_CNT)
#DIM      SORT_TYPE  ;ソート内容の指示
#DIM      MEMO_TYPE  ;今回のソート項目、CSVでの要素数
#DIMS     CHECK_VAR  ;チェック対象となる変数名
#DIMS     CHECK_TYPE ;比較演算子の種類
#DIM      NUM_LOOP   ;ループ回数
#DIM  REF CHARA_LIST ;キャラリストの内容配列
#DIM      CHARA_CNT  ;リストに含まれるキャラ数
#DIM	  EndingValue ; NAS stuff
;ソート項目の種別
#DIMS CONST DISP_MEMO = "体力", "気力", "ESP", "TSP", "Ｃ感", "Ｖ感", "Ａ感", "Ｂ感", "Ｍ感", "USens", "親密", "従順", "欲望", "技巧", "奉仕精神", "露出癖", "指技", "舌技", "胸技", "腰技", "膣技", "Ａ技", "Urethra", "マゾ", "サド", "精液", "苦痛", "快楽", "不埒", "反発", "時姦", "RegressionMark", "教養", "話術", "戦闘", "Shooting", "Melee", "清掃", "料理", "音楽", "伐採", "釣り", "採集", "調合", "好感", "信頼", "欲求", "DialogStatus", "Consc", "Sight", "Hearing", "Moving", "Manip", "Talking", "Breathing", "BloodFil", "BloodPump", "Fertility", "OrgasmDeny", "PeeHold", "PooHold", "AlcoholAddict", "DrugAddict", "EPL", "弾幕勝負勝利", "ムシバトル直接勝利", "HypnoResist", "COMBAT_AGGRESSIVENESS"
;ソート項目の各キャラ変数における位置
#DIM CONST MEMO_ID = 0,  1,  7, 8, 0,  1,  2,  3,  4, 5, 15, 16, 31, 9, 10, 11, 12, 13, 14, 50, 51, 52, 53, 54, 55, 56, 0,  1,  2,  3,  5, 10, 43, 41, 42, 66, 67, 40, 44, 45, 46, 47, 48, 49, 2,  4,340,997, 2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 1000, 1100, 1200, 1300, 1400, 1500, 930,932, 297, 298
;ソート項目の検索
MEMO_TYPE = 0
NUM_LOOP = SortListSize
MEMO_TYPE = SORT_TYPE%SortListSize
;auto sort
FOR LOCAL, 1000, 9999
IF LOCAL%SortListSize == 0
	;this is much easier to do than shitty guesswork
	EndingValue = LOCAL+SortListSize
	BREAK
ENDIF
NEXT
;PRINTFORMW {MEMO_TYPE} (size {NUM_LOOP})
SELECTCASE DISP_MEMO:MEMO_TYPE ;refer to CHARA_COMPARE for CHECK_VAR
	CASE "体力", "気力", "ESP", "TSP",
		CHECK_VAR '= "BASE"
	CASE "Ｃ感", "Ｖ感", "Ａ感", "Ｂ感", "Ｍ感", "親密", "従順", "欲望", "技巧", "USens", "奉仕精神", "露出癖"
		CHECK_VAR '= "ABL"
	CASE "指技", "舌技", "胸技", "腰技", "膣技", "Ａ技", "Urethra", "マゾ", "サド", "精液", "Pee", "Poo", "PeeDrink", "GeneralPoo", "DiaperAttraction", "Hypnosis", "ESP"
		CHECK_VAR '= "ABL"
	CASE "苦痛", "快楽", "不埒", "反発", "時姦", "RegressionMark"
		CHECK_VAR '= "MARK"
	CASE "教養", "話術", "戦闘", "清掃", "料理", "音楽", "Shooting", "Melee"
		CHECK_VAR '= "ABL"
	CASE "伐採", "釣り", "採集", "調合", "HypnoResist"
		CHECK_VAR '= "TALENT"
	CASE "好感", "信頼", "欲求"
		CHECK_VAR '= "CFLAG"
	CASE "DialogStatus"
		CHECK_VAR '= "DIALOG"
	CASE "OrgasmDeny", "PeeHold", "PooHold", "AlcoholAddict", "DrugAddict", "EPL"
		CHECK_VAR '= "ENDURANCE"
	CASE "Consc", "Sight", "Hearing", "Moving", "Manip", "Talking", "Breathing", "BloodFil", "BloodPump", "Fertility"
		CHECK_VAR '= "CAPIBILITITY"
	CASE "弾幕勝負勝利", "ムシバトル直接勝利"
		CHECK_VAR '= "CFLAG"
	CASE "COMBAT_AGGRESSIVENESS"
		CHECK_VAR '= "COMBAT_AGGRESSIVENESS"
	CASEELSE
		THROW 不正なDISP_MEMO:MEMO_TYPE %DISP_MEMO:MEMO_TYPE%、MEMO_TYPE {MEMO_TYPE}
ENDSELECT
IF SORT_TYPE < EndingValue
	CHECK_TYPE '= ">="
ELSEIF SORT_TYPE >= EndingValue
	CHECK_TYPE '= "<="
ENDIF
;ソート実処理
LOCAL:0 = 1
WHILE LOCAL:0 < CHARA_CNT
SIF !(LOCAL:0)
	LOCAL:0 ++
;PRINTW Okay, wait, so, what?
IF CHARA_COMPARE(CHECK_VAR, MEMO_ID:MEMO_TYPE, CHARA_LIST:(LOCAL:0 - 1), CHECK_TYPE, CHARA_LIST:(LOCAL:0))
	LOCAL:0 ++
ELSE
	SWAP CHARA_LIST:(LOCAL:0 - 1), CHARA_LIST:(LOCAL:0)
	LOCAL:0 --
ENDIF
WEND

