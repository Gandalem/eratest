	SIF GROUPMATCH(ARG, 42, 49, 56, 63)
		RETURNF "                "
	RETURNF "                  "
ELSEIF ARG == 22
	OUTPUT '= @"<nonbutton title='%ADDICTION_DESCRIPTION_HTML(C_ID,ARG)%'>"
	OUTPUT += @"%DISP_NAME:ARG, 10%："
	OUTPUT +=  PRINT_RANK_HTML(AlcoholAddict:C_ID:0, "MAX_5_SCALE")
	OUTPUT += @" {AlcoholAddict:C_ID:0, 3}"
	OUTPUT += @"</nonbutton>"
ELSEIF ARG == 23
	OUTPUT '= @"<nonbutton title='%ADDICTION_DESCRIPTION_HTML(C_ID,ARG)%'>"
	OUTPUT += @"%DISP_NAME:ARG, 10%："
	OUTPUT +=  PRINT_RANK_HTML(DrugAddict:C_ID:0, "MAX_5_SCALE")
	OUTPUT += @" {DrugAddict:C_ID:0, 3}"
	OUTPUT += @"</nonbutton>"
ELSE
	SIF !nPee && GROUPMATCH(ARG,3,14,15,16,17)
		RETURNF "                  "
	SIF !nScat && GROUPMATCH(ARG,16,17)
		RETURNF "                  "
	SIF !nOmutsu && ARG == 18
		RETURNF "                  "
	OUTPUT '= @"<nonbutton title='%ADDICTION_DESCRIPTION_HTML(C_ID,ARG)%'>"
	OUTPUT += @"%DISP_NAME:ARG, 10%："
	OUTPUT +=  PRINT_RANK_HTML(ABL:C_ID:(DISP_ID:ARG), "MAX_99")
	OUTPUT += @" {ABL:C_ID:(DISP_ID:ARG), 3}"
	OUTPUT += @"</nonbutton>"
ENDIF
[IF_DEBUG]
LOCALS += @"\n항목 ID: {ARG}"
[ENDIF]
RETURNF OUTPUT

