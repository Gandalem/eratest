; Modular ERB: LIST.ERB
;REGEX:
;=== JUEL
;ABILITY_FORMAT_HTML\(JUEL:C_ID:(\d+), JUEL_DEMAND_(\d+)\((\d+),\d+,C_ID\)\)
;ABILITY_FORMAT_HTML_JUEL($1, $3, $2, C_ID)
;=== EXP
;    (.+): %ABILITY_FORMAT_HTML\(EXP:C_ID:(.+).+, EXPLV:\(MAX\(ABL:C_ID:(.+) \+
;%ABILITY_FORMAT_EXPERIENCE("$1", GETNUM(EXP, "$2"), ABL:C_ID:$2, EXP:C_ID:$3)%"
;===

@SHOW_CHARA_LIST_TR(LIST_TYPE = "存在するキャラリスト", DISP_TYPE_STR = "体力気力", OP, FULL_NAME = 1)
#DIMS LIST_TYPE                     ;リストの種別
#DIMS LIST_TYPE_TR                  ;リストの種別
#DIMS DISP_TYPE_STR                 ;Ensures it can still be called like normal
#DIM  DISP_TYPE                      ;Handle the type as int, rather than string
#DIMS OP                            ;機能オプション
#DIM  GET_LIST = 1                  ;リスト更新フラグ
#DIM  L_ID                          ;リスト上の番号（ループカウンタ）、登録番号にあらず
#DIM  L_CLASS_ID                    ;リストのクラス内ID
#DIM  CHARA_LIST , キャラクタ数上限 ;リスト本体、登録番号にて記録
#DIM  CHARA_CNT                     ;リストに該当したキャラの数
#DIMS INPUT_STR                     ;入力内容の一時保持
#DIM  INPUT_INT                     ;入力内容をINT化したモノ
#DIM  NOW_GROUP = 1                 ;表示中のキャラグループ
#DIM  LAST_GROUP                    ;キャラグループ総数
#DIM  SORT_TYPE                     ;キャラリストのソートタイプ
#DIM  C_ID							;NAS Custom Code: Needed or else futa medicine and stuff will fail
;表示タイプの名称
#DIMS CONST DISP_NAME = "주요 능력치", "감각", "기교", "각인", "기술", "호감", "건강", "지구력", "승리 및 기타"
;表示項目の名称
#DIM CREDRAW
#DIM FIRST_LINE
#DIM FULL_NAME
;情報表示用
SELECTCASE DISP_TYPE_STR
	CASE "体力気力"
		DISP_TYPE = 0
	CASE "感度など"
		DISP_TYPE = 1
	CASE "性技"
		DISP_TYPE = 2
	CASE "刻印"
		DISP_TYPE = 3
	CASE "好感度"
		DISP_TYPE = 4
	CASE "Endurance"
		;custom
		DISP_TYPE = 5
ENDSELECT
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
LIST_TYPE_TR '= LISTING_TR(LIST_TYPE)
IF GET_LIST || ResetList
	CALLF MAKE_CHARA_LIST_TR(LIST_TYPE, L_CLASS_ID, CHARA_LIST, CHARA_CNT)
	GET_LIST = 0
	SORT_TYPE = -1
	ResetList = 0
ENDIF
DRAWLINE
;項目なし
IF CHARA_CNT <= 0
	PRINTFORML ＜해당 없음＞　%LIST_TYPE_TR%
	PRINTFORML
	DRAWLINE
	FOR LOCAL, 0, 40
	PRINTL
	NEXT
	;項目あり
ELSE
	;現在のタイプの総グループ数を更新
	LAST_GROUP = 1 + (CHARA_CNT - 1) / 40
	PRINTFORML ({CHARA_CNT}명, {NOW_GROUP}/{LAST_GROUP}에 해당) %LIST_TYPE_TR% 색깔이 있는 캐릭터는 대사가 있다.
	PRINTFORM
	CALL CHARA_BUTTON_TR(-1, , DISP_TYPE, SORT_TYPE, FULL_NAME)
	DRAWLINE
	FOR L_ID, (NOW_GROUP - 1) * 40, NOW_GROUP * 40
	IF INRANGE(L_ID, 0, CHARA_CNT - 1)
		CALL CHARA_BUTTON_TR(L_ID, CHARA_LIST:L_ID, DISP_TYPE, SORT_TYPE, FULL_NAME)
	ELSE
		PRINTL
	ENDIF
	NEXT
ENDIF
DRAWLINE
IF STRCOUNT(OP, "「情報固定」")
	PRINTFORM %" "*20%
ELSE
	PRINTBUTTON @"<- %DISP_NAME:((DISP_TYPE - 1 + VARSIZE("DISP_NAME")) % VARSIZE("DISP_NAME")), 20, LEFT%", 444
ENDIF
;modded to have infinite scroll
IF LAST_GROUP == 1
	SETCOLOR 0x606060
	PRINTFORM %"이전 페이지",15,LEFT%
	RESETCOLOR
ELSE
	PRINTBUTTON @"%"이전 페이지",15,LEFT%", 888
ENDIF
PRINTFORM
IF LAST_GROUP == 1
	SETCOLOR 0x606060
	PRINTFORM %"다음 페이지",15,LEFT%
	RESETCOLOR
ELSE
	PRINTBUTTON @"%"다음 페이지",15,LEFT%", 222
ENDIF
IF STRCOUNT(OP, "「情報固定」")
	PRINTFORM 　　　　　　　　　　　
ELSE
	PRINTBUTTON @"%DISP_NAME:((DISP_TYPE + 1 + VARSIZE("DISP_NAME")) % VARSIZE("DISP_NAME")), 20, LEFT% →", 666
ENDIF
PRINTFORML
PRINTFORML
PRINTBUTTON "[999] 리턴　", 999
PRINTFORM
SIF STRCOUNT(OP, "「条件変更」")
	PRINTBUTTON "[500] 목록 변경", 555
IF FLAG:画像表示
	PRINTFORM %" "*15%
	PRINTBUTTON "[777] 등장인물 목록 보기", 777
ENDIF
PRINTFORML
INPUT
C_ID = RESULT
SELECTCASE RESULT
	;先にシステム系を処理、222なら余裕あるっしょ（Kでは使えんわな）
	;modded to have infinite scroll + tweaked goto's to prevent crashing when entering incorrect values
	CASE 222, 888
		SIF LAST_GROUP == 1
			GOTO REPRINT
		NOW_GROUP = PAGE_HANDLE(RESULT, 888, NOW_GROUP, 1, LAST_GROUP)
		GOTO REPRINT
	CASE 444
		SIF STRCOUNT(OP, "「情報固定」")
			GOTO RETRY
		DISP_TYPE = (DISP_TYPE - 1 + VARSIZE("DISP_NAME")) % VARSIZE("DISP_NAME")
		GOTO REPRINT
	CASE 555
		SIF !STRCOUNT(OP, "「条件変更」")
			GOTO RETRY
		CALL CHANGE_LIST_TR(LIST_TYPE, OP)
		GET_LIST = 1
		NOW_GROUP = 1
		GOTO REPRINT
	CASE 666
		SIF STRCOUNT(OP, "「情報固定」")
			GOTO RETRY
		DISP_TYPE = (DISP_TYPE + 1 + VARSIZE("DISP_NAME")) % VARSIZE("DISP_NAME")
		GOTO REPRINT
	CASE 999
		;REFで配列作れば多キャラ選択も行けそう
		;受け渡しはともかくとして表示まわりがめんどいか
		GET_LIST = 1
		NOW_GROUP = 1
		RETURN 999
	CASE 1040 TO 1169 ;the max range after TO is DISP_MEMO-1*2?
		;PRINTFORMW {RESULT} Sort: {RESULT%SortListSize}
		SORT_TYPE = RESULT
		CALL SORT_LIST_TR(RESULT, CHARA_LIST, CHARA_CNT)
		GOTO REPRINT
	CASE 777
		SIF !FLAG:画像表示
			GOTO REPRINT
		CALL QOL_FULL_ROSTER
		GOTO REPRINT
	CASEELSE
		;キャラが選択された時
		IF !INRANGE(RESULT, MAX(0, (NOW_GROUP - 1) * 40), MIN(CHARA_CNT - 1, NOW_GROUP * 40))
			PRINTFORMW {RESULT}은 범위 밖에 있다!
			GOTO REPRINT
		ELSEIF L_CLASS_ID == -1 && !CHECK_CHARA(CHARA_LIST:RESULT, LIST_TYPE)
			PRINTFORMW {RESULT}는 리스트가 아니다!
			GOTO REPRINT
		ELSEIF L_CLASS_ID > 0 && !GET_INT(CHARA_LIST:RESULT, "キャラリスト", L_CLASS_ID, "判定")
			PRINTFORMW {RESULT}는 리스트에 없다!
			GOTO REPRINT
		ENDIF
		;ここだけDO-LOOPぬけます
ENDSELECT
$RETRY
IF STRCOUNT(OP, "「情報表示」")
	CALL LIST_CHARA_STATE_TR(CHARA_LIST, RESULT, CHARA_CNT, OP)
	SIF !RESULT
		GOTO REPRINT
	NOW_GROUP = 1
	GET_LIST = 1
	;一応RESULTが正になるのは「最終確認」のみだが念のために判定
	SIF STRCOUNT(OP, "「最終確認」")
		RETURN RESULT
ELSE
	NOW_GROUP = 1
	GET_LIST = 1
	PRINTFORMW {CHARA_LIST:C_ID}
	RETURN CHARA_LIST:C_ID
ENDIF
;##################################################

@MAKE_CHARA_LIST_TR(LIST_TYPE, L_ID, CHARA_LIST, CHARA_CNT)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS LIST_TYPE
#DIM C_ID
#DIM REF L_ID       ;リストのクラスID
#DIM REF CHARA_LIST ;キャラ一覧
#DIM REF CHARA_CNT  ;キャラカウンタ
VARSET CHARA_LIST
VARSET CHARA_CNT
L_ID = OBJNAME_TO_ID(0, "GET", "キャラリスト", LIST_TYPE)
SIF FLAG:並び替え
	CALLF CHARASORT_EX_TR
IF L_ID == -1
	FOR LOCAL, 0, EX_CHARANUM
	IF FLAG:並び替え
		C_ID = RESULT:LOCAL
		SIF C_ID == -1 ;replace check for 0 to include player character in the list
			CONTINUE
	ELSE
		C_ID = LOCAL
		SIF C_ID >= CHARANUM
			BREAK
	ENDIF
	SIF !CHECK_CHARA(C_ID, LIST_TYPE)
		CONTINUE
	CHARA_LIST:CHARA_CNT = C_ID
	CHARA_CNT ++
	NEXT
ELSE
	FOR LOCAL, 0, EX_CHARANUM
	IF FLAG:並び替え
		C_ID = RESULT:LOCAL
		SIF C_ID == -1
			CONTINUE
	ELSE
		C_ID = LOCAL
		SIF C_ID >= CHARANUM
			BREAK
	ENDIF
	SIF !GET_INT(C_ID, "キャラリスト", L_ID, "判定")
		CONTINUE
	CHARA_LIST:CHARA_CNT = C_ID
	CHARA_CNT ++
	NEXT
ENDIF
;###############################################

@SIMPLE_CHARA_LIST_TR(CHARA_LIST, CHARA_CNT, OP)
#DIM  REF CHARA_LIST ;リスト本体、登録番号にて記録
#DIM  REF CHARA_CNT  ;リストに該当したキャラの数
#DIMS OP
FOR LOCAL, 0, CHARA_CNT
PRINTFORML [{LOCAL, 3}] - %CALLNAME:(CHARA_LIST:LOCAL)%
NEXT
PRINTFORML
PRINTFORML [999] 돌아가다
DO
INPUT
SELECTCASE RESULT
	CASE 999
		RETURN 999
	CASEELSE
		SIF INRANGE(RESULT, 0, CHARA_CNT - 1)
			RETURN RESULT
		REUSELASTLINE 잘못된 입력
		CONTINUE
ENDSELECT
LOOP 1
;###############################################
;SORT_TYPE, <45 descending, >45 ascending
;BUTTON, which button it is, corresponds with DISP_MEMO
;starting value of a first button with modulo % should be equal to 0! update all button values accordingly afterward!
;main thing is the total amount of items in DISP_MEMO (aka headers for sorting, must be the same everywhere)
;you'll need to change the button modulo with it (%41) (41 is the amount of items), then see which nearest value of 1000%41 produces 0, that'll be the starting value of a button
;next you update the button result code where it's handled (min-max range)

@MAKE_SORT_BUTTON_TR(SORT_TYPE, BUTTON, isFaction = 0)
#DIM SORT_TYPE ;現在のソートタイプ
#DIM BUTTON    ;基本のボタン名
#DIM StartingValue
#DIM isFaction
#DIMS MSB_VAR
#DIMS CONST DISP_MEMO = "근력", "기력", "초능력", "TSP", "C감각", "V감각", "A감각", "B감각", "M감각", "요도 감각", "친밀", "순종", "애욕", "기교", "봉사정신", "노출벽", "손가락", "혀", "가슴", "허리", "질", "애널", "요도", "마조끼", "새드끼", "정액 추가", "고통각인", "쾌락각인", "괘씸각인", "반발각인", "강간", "퇴행", "교양", "화술기능", "전투능력", "사격", "근접전", "청소기능", "요리기능", "음악기능", "식물", "동물", "채집", "제작", "호감도", "신뢰", "성적 욕구불만", "대화％", "의식", "시야", "청각", "이동", "조작", "발화", "호흡", "혈액 여과", "혈액 순환", "생식력", "정신건강", "소변 참기", "대변 참기", "알코올", "약물", "EPL", "전투", "벌레배틀", "사이오닉 저항", "공격성"
#DIMS CONST DISP_FACTION = "등급", "명성", "악명", "관계", "세력", "위협", "칭호", "지도자", "부관", "간부", "고참 구성원", "구성원", "신입 구성원", "기술 수준", "재산", "신석기", "고대", "초기 중세", "후기 중세", "르네상스", "산업", "기계화", "미드월드", "우주 시대", "울트라", "아키텍", "하쿠레이 신사", "묘렌사", "인간 마을", "홍마관", "미혹의 죽림", "마법의 숲", "명계", "요괴의 산 기슭", "요괴의 산 정상", "구지옥", "달","마계", "우호 관계", "적대 관계"
;NAS: Faction sort goes here.
IF isFaction
	MSB_VAR '= "DISP_FACTION"
ELSE
	MSB_VAR '= "DISP_MEMO"
ENDIF
;auto sort
SortListSize = VARSIZE(MSB_VAR)
FOR LOCAL, 1000, 9999
IF LOCAL%SortListSize == 0
	;this is much easier to do than shitty guesswork
	StartingValue = LOCAL
	BREAK
ENDIF
NEXT
IF SORT_TYPE%SortListSize != BUTTON
	;LOCAL = 1032+BUTTON+24	;PRINT
	;BUTTON @"{LOCAL}", LOCAL
	PRINTBUTTON @"　%GETVARS(@"%MSB_VAR%:{BUTTON}")%", StartingValue+BUTTON
ELSEIF SORT_TYPE < StartingValue+SortListSize ;this is the sum of <button value> + total amount of items in DISP_MEMO
	PRINTBUTTON @"▼%GETVARS(@"%MSB_VAR%:{BUTTON}")%", StartingValue+BUTTON+SortListSize
ELSEIF SORT_TYPE >= StartingValue+SortListSize
	PRINTBUTTON @"▲%GETVARS(@"%MSB_VAR%:{BUTTON}")%", StartingValue+BUTTON
ENDIF
