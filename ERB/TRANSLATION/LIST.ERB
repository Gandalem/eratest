	CASE 15
		ABL_INDEX = GETNUM(ABL, "マゾっ気")
	CASE 16
		ABL_INDEX = GETNUM(ABL, "サドっ気")
	CASE 17
		ABL_INDEX = GETNUM(ABL, "レズっ気")
	CASE 18
		ABL_INDEX = GETNUM(ABL, "ホモっ気")
	CASE 30
		ABL_INDEX = GETNUM(ABL, "自慰中毒")
	CASE 31
		ABL_INDEX = GETNUM(ABL, "精液中毒")
	CASE 32
		ABL_INDEX = GETNUM(ABL, "レズ中毒")
	CASE 33
		ABL_INDEX = GETNUM(ABL, "ゲイ中毒")
	CASE 34
		ABL_INDEX = GETNUM(ABL, "膣射中毒")
	CASE 35
		ABL_INDEX = GETNUM(ABL, "肛射中毒")
ENDSELECT
