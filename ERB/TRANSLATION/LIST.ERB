@ABILITY_FORMAT_HTML_REQUIREMENTS(CHARA, ABL_INDEX)
#FUNCTIONS
#DIM CHARA
#DIM ABL_INDEX
#DIMS DYNAMIC SCENARIOS_JUEL, 4
#DIMS DYNAMIC SCENARIOS_EXP, 4
#DIM DYNAMIC SCENARIO_COUNT
#DIM DYNAMIC SCENARIO_PRINTED
#DIM SINGLE_TYPE
VARSET LOCALS
LOCALS '= @"다음 단계까지 진행도:"
IF JUEL_DEMAND(ABL_INDEX,LOCAL,0,CHARA) == -2
	LOCALS += @"\n특수:"
	SELECTCASE ABL_INDEX
		CASE 13
			LOCALS += @"\n %ABL_TR(GETNUM(ABL, "従順"))% 너무 낮다: {ABL:CHARA:従順}/{ABL:CHARA:奉仕精神 + 1}"
		CASE 15
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "欲望"))% 너무 낮음: {ABL:CHARA:欲望}/{ABL:CHARA:マゾっ気 + 1}"
		CASE 16
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "欲望"))% 너무 낮음: {ABL:CHARA:欲望}/{ABL:CHARA:サドっ気 + 1}"
		CASE 30
			IF ABL:CHARA:Ｃ感覚 < ABL:CHARA:自慰中毒 + 2
				LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "Ｃ感覚"))% 너무 낮음: {ABL:CHARA:Ｃ感覚}/{ABL:CHARA:自慰中毒 + 2}"
			ELSEIF ABL:CHARA:露出癖 < ABL:CHARA:自慰中毒 + 2
				LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "露出癖"))% 너무 낮음: {ABL:CHARA:露出癖}/{ABL:CHARA:自慰中毒 + 2}"
			ENDIF
		CASE 31
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "奉仕精神"))% 너무 낮음: {ABL:CHARA:奉仕精神}/{ABL:CHARA:精液中毒 + 1}"
		CASE 32
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "レズっ気"))% 너무 낮음: {ABL:CHARA:レズっ気}/{ABL:CHARA:レズ中毒 + 1}"
		CASE 33
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "ホモっ気"))% 너무 낮음: {ABL:CHARA:ホモっ気}/{ABL:CHARA:ゲイ中毒 + 1}"
		CASE 34
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "精液中毒"))% 너무 낮음: {ABL:CHARA:精液中毒}/{ABL:CHARA:膣射中毒 + 1}"
		CASE 35
			LOCALS += @"\n    %ABL_TR(GETNUM(ABL, "精液中毒"))% 너무 낮음: {ABL:CHARA:精液中毒}/{ABL:CHARA:肛射中毒 + 1}"
	ENDSELECT
	RETURNF LOCALS
ENDIF
FOR LOCAL, 0, 4
;blocked for special reason
SIF JUEL_DEMAND(ABL_INDEX,LOCAL,0,CHARA) == -2
	BREAK
SIF JUEL_DEMAND(ABL_INDEX,LOCAL,0,CHARA) < 0
	CONTINUE
FOR LOCAL:1,0,100
LOCAL:2 = JUEL_DEMAND(ABL_INDEX,LOCAL,LOCAL:1,CHARA)
SIF LOCAL:2
	SCENARIOS_JUEL:LOCAL += @"\n%PALAM_TR(PALAMNAME:(LOCAL:1))%: %ABILITY_FORMAT_HTML_JUEL(LOCAL:1, LOCAL, ABL_INDEX, CHARA)%"
NEXT
FOR LOCAL:1,0,100
LOCAL:2 = EXP_DEMAND(ABL_INDEX,LOCAL,LOCAL:1,CHARA)
SIF LOCAL:2
	SCENARIOS_EXP:LOCAL += @"\n%EXP_TR(LOCAL:1)%: %ABILITY_FORMAT_HTML_EXP(LOCAL:1, LOCAL, ABL_INDEX, CHARA)%"
NEXT
NEXT
FOR LOCAL, 0, 4
SIF SCENARIOS_JUEL:LOCAL != "" || SCENARIOS_EXP:LOCAL != ""
	SCENARIO_COUNT++
NEXT
SIF !SCENARIO_COUNT
	RETURNF ""
SINGLE_TYPE = MATCH(SCENARIOS_JUEL, "") == 4 || MATCH(SCENARIOS_EXP, "") == 4
SIF SCENARIO_COUNT > 1 && !SINGLE_TYPE ;indent if necessary
	LOCALS:1 '= @"    "
FOR LOCAL, 0, 4
SIF SCENARIOS_JUEL:LOCAL == "" && SCENARIOS_EXP:LOCAL == ""
	CONTINUE
SIF SCENARIO_PRINTED > 0
	LOCALS += @"\n또는" ;flip the indentation order if we only have one type
IF SCENARIOS_JUEL:LOCAL != ""
	SIF !SCENARIO_PRINTED || !SINGLE_TYPE
		LOCALS += @"\n%LOCALS:1% 보석들:"
	LOCALS += @"%REPLACE(SCENARIOS_JUEL:LOCAL, "\n", @"\n    %LOCALS:1%")%"
ENDIF
IF SCENARIOS_EXP:LOCAL != ""
	SIF !SCENARIO_PRINTED || !SINGLE_TYPE
		LOCALS += @"\n%LOCALS:1%경험:"
	LOCALS += @"%REPLACE(SCENARIOS_EXP:LOCAL, "\n", @"\n    %LOCALS:1%")%"
ENDIF
SCENARIO_PRINTED++
NEXT
RETURNF LOCALS
