			CASE IS >= 500
				RANK = 0
			CASE IS >= 350
				RANK = 1
			CASE IS >= 250
				RANK = 2
			CASE IS >= 150
				RANK = 3
			CASE IS >= 99
				RANK = 4
			CASE IS >= 75
				RANK = 5
			CASE IS >= 50
				RANK = 6
			CASE IS >= 20
				RANK = 7
			CASE IS >= 10
				RANK = 8
			CASE IS >=  5
				RANK = 9
			CASE IS >=  3
				RANK = 10
			CASE IS >=  2
				RANK = 11
			CASE IS >=  1
				RANK = 12
			CASEELSE
				RANK = 13
		ENDSELECT
	CASE "MAX_5_SCALE"
		;技術系以外のABL
		;数字が縦に並ぶと非常に見にくかったんで意図的にインデントずらしてます
		SELECTCASE VAR_VALUE
			CASE IS >= 6
				RANK = 0
			CASE IS >= 5
				RANK = 1
			CASE IS >=  4
				RANK = 2
			CASE IS >=  3
				RANK = 3
			CASE IS >=  2
				RANK = 4
			CASE IS >=  1
				RANK = 5
			CASE IS >=  0
				RANK = 6
			CASE IS >=  -1
				RANK = 7
			CASE IS >=  -2
				RANK = 8
			CASE IS >=  -3
				RANK = 9
			CASE IS >=  -4
				RANK = 10
			CASEELSE
				RANK = 11
		ENDSELECT
	CASE "LEVEL_REWORK"
		GOTO MAX6_Rework
	CASE "MAX_6"
		;技能系ABL
		IF 0
			$MAX6_Rework
			SELECTCASE VAR_VALUE
				CASE IS >= 50
					RANK = 0
				CASE IS >= 40
					RANK = 1
				CASE IS >= 30
					RANK = 2
				CASE 20 TO 29
					RANK = 3
				CASE 17 TO 19
					RANK = 4
				CASEELSE
					RANK = MAX(21 - (VAR_VALUE), 0)
			ENDSELECT
		ELSE
			RANK = MAX(10 - (VAR_VALUE), 0)
		ENDIF
	CASE "MAX_CHESS"
		RANK = MAX(10 - (VAR_VALUE), 0)
	CASEELSE
		THROW 不明なRANK_SCALE %RANK_SCALE%
ENDSELECT
RETURNF RANK

@CALC_RANK_NUM_FUNCTION(VAR_VALUE, RANK_SCALE)
#FUNCTION
#DIM      VAR_VALUE  ;評価対象数値
#DIMS     RANK_SCALE ;評価に使用する尺度の種類
#DIM RANK_NUM
SELECTCASE RANK_SCALE
	CASE "MAX_50000"
		;好感度用
		RANK_NUM = 10
	CASE "MAX_1M"
		RANK_NUM = 10
	CASE "MAX_20000"
		;信頼度用
		RANK_NUM = 10
	CASE "MAX_99"
		;技術系以外のABL
		;数字が縦に並ぶと非常に見にくかったんで意図的にインデントずらしてます
		RANK_NUM = 10
	CASE "MAX_5_SCALE"
		;needed for endurance abilities
		RANK_NUM = 12
	CASE "MAX_1000"
		;Agreement
		RANK_NUM = 10
	CASE "MAX_6"
		;技能系ABL
		RANK_NUM = 9969
	CASE "LEVEL_REWORK"
		RANK_NUM = 7
	CASE "MAX_CHESS"
		;技能系ABL
		RANK_NUM = 9934
	CASEELSE
		THROW 不明なRANK_SCALE %RANK_SCALE%
ENDSELECT
RETURNF RANK_NUM

