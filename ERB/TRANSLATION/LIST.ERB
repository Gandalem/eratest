@CHARA_BUTTON_TR(LABEL, C_ID, DISP_TYPE = 0, SORT_TYPE, FULL_NAME)
#DIM  LABEL
#DIM  C_ID
#DIM DISP_TYPE
#DIM SORT_TYPE
#DIMS 表示文
#DIM  表示ステータス番号
#DIM  CONST バー長さ = 10
;LABELが負数はありえないので表示内容のアナウンスに流用してます
#DIMS CONST DISP_NAME = "스태미나와 기력", "감각", "기교", "각인", "기술", "호감", "승리 및 기타", "LoG"
#DIMS CONST DISP_MEMO = "근력", "기력", "초능력", "TSP", "C감각", "V감각", "A감각", "B감각", "M감각", "요도 감각", "친밀", "순종", "애욕", "기교", "봉사정신", "노출벽", "손가락", "혀", "가슴", "허리", "질", "애널", "요도", "마조끼", "새드끼", "정액 추가", "고통각인", "쾌락각인", "괘씸각인", "반발각인", "강간", "퇴행", "교양", "화술기능", "전투능력", "사격", "근접전", "청소기능", "요리기능", "음악기능", "식물", "동물", "채집", "제작", "호감도", "신뢰", "성적 욕구불만", "대화％", "의식", "시야", "청각", "이동", "조작", "발화", "호흡", "혈액 여과", "혈액 순환", "생식력", "정신건강", "소변 참기", "대변 참기", "알코올", "약물", "EPL", "전투", "벌레배틀", "사이오닉 저항", "공격성",
#DIM FULL_NAME
IF LABEL >= 0
	;Temporary code, stopgap since the original flag used isn't set correctly
	TRYCALLFORM M_KOJO_K{NO:C_ID}
	SIF RESULT
		SETCOLOR 103,228,126
	SIF C_ID == MASTER
		SETCOLOR C_AQUA
	IF FULL_NAME
		PRINTFORM [{LABEL, 3}]
		RESETCOLOR
		CALLF NameChecker(C_ID,,1,,SaveIsEZB ? 2 # 0)
		PRINTFORM %" " * MAX((33-STRLENS(NameChecker(C_ID,,,,SaveIsEZB ? 2 # 0))),0)%
	ELSE
		PRINTFORM [{LABEL, 3}] %ALTNAME_OR_CALLNAME(C_ID), 14, LEFT%
	ENDIF
	RESETCOLOR
ENDIF
IF LABEL < 0
	PRINTFORM
ENDIF
SELECTCASE DISP_TYPE
	CASE 0 ;STA and ENE
		IF LABEL < 0
			IF FULL_NAME
				PRINTFORM %"　" * 19%
			ELSE
				PRINTFORM %"　" * 9%
			ENDIF
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 0)
			PRINTFORM %"　" * 10%
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 1)
			PRINTFORM %"　" * 10%
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 2)
			PRINTFORM %"　" * 10%
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 3)
		ELSE
			CALL Add_STAMINA_BAR(C_ID, 10, 2) ;custom code: replaced bars with one that shows true stamina
			CALL BASE_BAR(C_ID, "気力", 10, "青", "「種類表記無し」")
			IF HasAnyYoujutsu(C_ID)
				CALL BASE_BAR(C_ID, "法力", 10, "オレンジ", "「種類表記無し」")
			ELSE
				PRINTFORM %" " * 24%
			ENDIF
			IF MAXBASE:C_ID:TSP
				CALL BASE_BAR(C_ID, "TSP", 10, "水色", "「種類表記無し」")
			ELSE
			ENDIF
		ENDIF
		PRINTFORML
	CASE 1 ;Sense
		IF LABEL < 0
			PRINTFORM %" " * 8%Sense
			IF FULL_NAME
				PRINTFORM %" "*23%
			ELSE
				PRINTFORM %" "*5%
			ENDIF
			FOR LOCAL, 4, 16
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			NEXT
		ELSE
			FOR LOCAL, 0, 15
			SIF ABLNAME:LOCAL == ""
				CONTINUE
			CALL PRINT_RANK(ABL:C_ID:LOCAL, "MAX_99")
			PRINTFORM {ABL:C_ID:LOCAL, 4}|
			SIF LOCAL != 10
				PRINTFORM
			SIF LOCAL == 5
				PRINTFORM
			SIF LOCAL == 9
				PRINTFORM
			SIF LOCAL == 10
				PRINTFORM
			SIF LOCAL == 11
				PRINTFORM
			SIF LOCAL == 12
				PRINTFORM
			SIF LOCAL == 13
				PRINTFORM
			NEXT
		ENDIF
		PRINTFORML
	CASE 2 ;Technique
		IF LABEL < 0
			PRINTFORM %"　" * 3%기술
			IF FULL_NAME
				PRINTFORM %"　" * 11%
			ELSE
				PRINTFORM %"　" * 2%
			ENDIF
			FOR LOCAL, 16, 26
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			NEXT
		ELSE
			;超適当につき修正の余地あり
			FOR LOCAL, 50, 57
			SIF ABLNAME:LOCAL == ""
				CONTINUE
			CALL PRINT_RANK(ABL:C_ID:LOCAL, "MAX_20")
			PRINTFORM {ABL:C_ID:LOCAL, 4}|
			SIF LOCAL != 54
				PRINTFORM
			SIF LOCAL == 50
				PRINTFORM
			SIF LOCAL == 53
				PRINTFORM
			SIF LOCAL == 57
				PRINTFORM
			NEXT
			PRINTFORM
			CALL PRINT_RANK(ABL:C_ID:15, "MAX_99")
			PRINTFORM {ABL:C_ID:15, 4}|
			PRINTFORM
			CALL PRINT_RANK(ABL:C_ID:16, "MAX_99")
			PRINTFORM {ABL:C_ID:16, 4}|
			PRINTFORM
			CALL PRINT_RANK(ABL:C_ID:31, "MAX_99")
			PRINTFORM {ABL:C_ID:31, 4}|
		ENDIF
		PRINTFORML
	CASE 3 ;Marks
		IF LABEL < 0
			PRINTFORM %" " * 8% 표시
			IF FULL_NAME
				PRINTFORM %" " * 28%
			ELSE
				PRINTFORM %" " * 7%
			ENDIF
			FOR LOCAL, 26, 32
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			NEXT
		ELSE
			;超適当につき修正の余地あり
			FOR 表示ステータス番号, 0, 6
			IF MARKNAME:表示ステータス番号 == ""
				CONTINUE
			ELSEIF MARK:C_ID:表示ステータス番号 < 0
				PRINTFORM |
				CONTINUE
			ENDIF
			;反発刻印履歴は表示しないように
			SIF 表示ステータス番号 == 4
				CONTINUE
			IF 表示ステータス番号 == 3
				CALL COLOR_STAMP(MARK:C_ID:表示ステータス番号, 5, "×", C_RED)
			ELSE
				CALL COLOR_STAMP(MARK:C_ID:表示ステータス番号, 5, "★", 0xFFFF00)
			ENDIF
			PRINTFORM |
			NEXT
		ENDIF
		PRINTFORML
	CASE 4 ;skills
		IF LABEL < 0
			PRINTFORM %"　" * 4%스킬
			IF FULL_NAME
				PRINTFORM %"　" * 11%
			ELSE
				PRINTFORM %"　" * 2%
			ENDIF
			FOR LOCAL, 32, 44
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			NEXT
		ELSE
			COUNT = 43, 41, 42, 66, 67, 40, 44, 45
			;超適当につき修正の余地あり
			FOR LOCAL, 0, 8
			SIF ABLNAME:(COUNT:LOCAL) == ""
				CONTINUE
			SIF LOCAL == 0
				PRINTFORM
