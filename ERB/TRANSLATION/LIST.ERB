@SIMPLE_CHARA_LIST_TR(CHARA_LIST, CHARA_CNT, OP)
#DIM  REF CHARA_LIST ;リスト本体、登録番号にて記録
#DIM  REF CHARA_CNT  ;リストに該当したキャラの数
#DIMS OP
FOR LOCAL, 0, CHARA_CNT
PRINTFORML [{LOCAL, 3}] - %CALLNAME:(CHARA_LIST:LOCAL)%
NEXT
PRINTFORML 
PRINTFORML [999] 돌아가다
DO
INPUT
SELECTCASE RESULT
	CASE 999
		RETURN 999
	CASEELSE
		SIF INRANGE(RESULT, 0, CHARA_CNT - 1)
			RETURN RESULT
		REUSELASTLINE Invalid Input
		CONTINUE
ENDSELECT
LOOP 1
;###############################################
;SORT_TYPE, <45 descending, >45 ascending
;BUTTON, which button it is, corresponds with DISP_MEMO
;starting value of a first button with modulo % should be equal to 0! update all button values accordingly afterward!
;main thing is the total amount of items in DISP_MEMO (aka headers for sorting, must be the same everywhere)
;you'll need to change the button modulo with it (%41) (41 is the amount of items), then see which nearest value of 1000%41 produces 0, that'll be the starting value of a button
;next you update the button result code where it's handled (min-max range)

@MAKE_SORT_BUTTON_TR(SORT_TYPE, BUTTON, isFaction = 0)
#DIM SORT_TYPE ;現在のソートタイプ
#DIM BUTTON    ;基本のボタン名
#DIM StartingValue
#DIM isFaction
#DIMS MSB_VAR
#DIMS CONST DISP_MEMO = "STR", "기력", "ESP", "TSP", "C감각", "V감각", "A감각", "B감각", "M감각", "USens", "친밀", "순종", "애욕", "기교", "봉사정신", "노출벽", "손가락", "혀", "가슴", "허리", "질", "애널", "Urethra", "마조끼", "새드끼", "Semen Add.", "고통각인", "쾌락각인", "괘씸각인", "반발각인", "RAPE", "REGR", "교양", "화술기능", "전투능력", "Shooting", "Melee", "청소기능", "요리기능", "음악기능", "Plants", "Animals", "Foraging", "Crafting", "호감도", "Reliance", "S. Frustration", "Dialog％", "Consc.", "Sight", "Hearing", "Moving", "Manip.", "Talking", "Breathing", "Blood Fil.", "Blood Pump.", "Fertility", "Sanity", "Pee Hold", "Poo Hold", "Alcohol", "Drug", "EPL", "Combat", "벌레배틀", "Psi Resist", "Aggressive"
#DIMS CONST DISP_FACTION = "Rank", "Fame", "Infamy", "Relation", "Power", "Threat", "Title", "Leader", "Lieutenant", "Officer", "Sr. Member", "Member", "Jr. Member", "Technical Level", "Wealth", "Neolit", "Antiq", "EarlMe", "LateMe", "Rennis", "Indust", "Machin", "Mid", "Spacer", "Ultra", "Archo", "HakSh", "MyouT", "Villa", "SDM", "BFoTL", "FoM", "Nethe", "YMFot", "YMSum", "FHell", "Moon","Makai", "Friendly With", "Hostile With"
;NAS: Faction sort goes here.
IF isFaction
	MSB_VAR '= "DISP_FACTION"
ELSE
	MSB_VAR '= "DISP_MEMO"
ENDIF
;auto sort
SortListSize = VARSIZE(MSB_VAR)
FOR LOCAL, 1000, 9999
IF LOCAL%SortListSize == 0
	;this is much easier to do than shitty guesswork
	StartingValue = LOCAL
	BREAK
ENDIF
NEXT
IF SORT_TYPE%SortListSize != BUTTON
	;LOCAL = 1032+BUTTON+24	;PRINT
	;BUTTON @"{LOCAL}", LOCAL
	PRINTBUTTON @"　%GETVARS(@"%MSB_VAR%:{BUTTON}")%", StartingValue+BUTTON
ELSEIF SORT_TYPE < StartingValue+SortListSize ;this is the sum of <button value> + total amount of items in DISP_MEMO
	PRINTBUTTON @"▼%GETVARS(@"%MSB_VAR%:{BUTTON}")%", StartingValue+BUTTON+SortListSize
ELSEIF SORT_TYPE >= StartingValue+SortListSize
	PRINTBUTTON @"▲%GETVARS(@"%MSB_VAR%:{BUTTON}")%", StartingValue+BUTTON
ENDIF
;#####################################################

@CHARA_BUTTON_TR(LABEL, C_ID, DISP_TYPE = 0, SORT_TYPE, FULL_NAME)
#DIM  LABEL
#DIM  C_ID
#DIM DISP_TYPE
#DIM SORT_TYPE
#DIMS 表示文
#DIM  表示ステータス番号
#DIM  CONST バー長さ = 10
;LABELが負数はありえないので表示内容のアナウンスに流用してます
#DIMS CONST DISP_NAME = "STA and ENE", "Sense", "Technique", "Marks", "Skills", "Favor", "Victories&Etc", "LoG"
#DIMS CONST DISP_MEMO = "STR", "기력", "ESP", "TSP", "C감각", "V감각", "A감각", "B감각", "M감각", "USens", "친밀", "순종", "애욕", "기교", "봉사정신", "노출벽", "손가락", "혀", "가슴", "허리", "질", "애널", "Urethra", "마조끼", "새드끼", "Semen Add.", "고통각인", "쾌락각인", "괘씸각인", "반발각인", "RAPE", "REGR", "교양", "화술기능", "전투능력", "Shooting", "Melee", "청소기능", "요리기능", "음악기능", "Plants", "Animals", "Foraging", "Crafting", "호감도", "Reliance", "S. Frustration", "Dialog％", "Consc.", "Sight", "Hearing", "Moving", "Manip.", "Talking", "Breathing", "Blood Fil.", "Blood Pump.", "Fertility", "Sanity", "Pee Hold", "Poo Hold", "Alcohol", "Drug", "EPL", "Combat", "벌레배틀", "Psi Resist", "Aggressive",
#DIM FULL_NAME
IF LABEL >= 0
	;Temporary code, stopgap since the original flag used isn't set correctly
	TRYCALLFORM M_KOJO_K{NO:C_ID}
	SIF RESULT
		SETCOLOR 103,228,126
	SIF C_ID == MASTER
		SETCOLOR C_AQUA
	IF FULL_NAME
		PRINTFORM [{LABEL, 3}] 
		RESETCOLOR
		CALLF NameChecker(C_ID,,1,,SaveIsEZB ? 2 # 0)
		PRINTFORM %" " * MAX((33-STRLENS(NameChecker(C_ID,,,,SaveIsEZB ? 2 # 0))),0)%
	ELSE
		PRINTFORM [{LABEL, 3}] %ALTNAME_OR_CALLNAME(C_ID), 14, LEFT%	
	ENDIF
	RESETCOLOR
ENDIF
IF LABEL < 0
	PRINTFORM  
ENDIF
SELECTCASE DISP_TYPE
	CASE 0 ;STA and ENE
		IF LABEL < 0
			IF FULL_NAME
				PRINTFORM %"　" * 19%
			ELSE
				PRINTFORM %"　" * 9%
			ENDIF
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 0)
			PRINTFORM %"　" * 10%
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 1)
			PRINTFORM %"　" * 10%
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 2)
			PRINTFORM %"　" * 10%
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, 3)
		ELSE
			CALL Add_STAMINA_BAR(C_ID, 10, 2) ;custom code: replaced bars with one that shows true stamina
			CALL BASE_BAR(C_ID, "気力", 10, "青", "「種類表記無し」")
			IF HasAnyYoujutsu(C_ID)
				CALL BASE_BAR(C_ID, "法力", 10, "オレンジ", "「種類表記無し」")
			ELSE
				PRINTFORM %" " * 24%
			ENDIF
			IF MAXBASE:C_ID:TSP
				CALL BASE_BAR(C_ID, "TSP", 10, "水色", "「種類表記無し」")
			ELSE
			ENDIF
		ENDIF
		PRINTFORML 
	CASE 1 ;Sense
		IF LABEL < 0
			PRINTFORM %" " * 8%Sense
			IF FULL_NAME
				PRINTFORM %" "*23% 
			ELSE
				PRINTFORM %" "*5% 
			ENDIF
			FOR LOCAL, 4, 16
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			NEXT
		ELSE
			FOR LOCAL, 0, 15
			SIF ABLNAME:LOCAL == ""
				CONTINUE
			CALL PRINT_RANK(ABL:C_ID:LOCAL, "MAX_99")
			PRINTFORM {ABL:C_ID:LOCAL, 4}|
			SIF LOCAL != 10
				PRINTFORM  
			SIF LOCAL == 5
				PRINTFORM    
			SIF LOCAL == 9
				PRINTFORM     
			SIF LOCAL == 10
				PRINTFORM 
			SIF LOCAL == 11
				PRINTFORM     
			SIF LOCAL == 12
				PRINTFORM     
			SIF LOCAL == 13
				PRINTFORM    				
			NEXT
		ENDIF
		PRINTFORML 
	CASE 2 ;Technique
		IF LABEL < 0
			PRINTFORM %"　" * 3%기술
			IF FULL_NAME
				PRINTFORM %"　" * 11% 
			ELSE
				PRINTFORM %"　" * 2%
			ENDIF
			FOR LOCAL, 16, 26
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			NEXT
		ELSE
			;超適当につき修正の余地あり
			FOR LOCAL, 50, 57
			SIF ABLNAME:LOCAL == ""
				CONTINUE
			CALL PRINT_RANK(ABL:C_ID:LOCAL, "MAX_20")
			PRINTFORM {ABL:C_ID:LOCAL, 4}|
			SIF LOCAL != 54
				PRINTFORM  
			SIF LOCAL == 50
				PRINTFORM  
			SIF LOCAL == 53
				PRINTFORM  
