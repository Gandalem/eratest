				CONTINUE
			CALL PRINT_RANK(TALENT:C_ID:LOCAL, "MAX_6")
			PRINTFORM {TALENT:C_ID:LOCAL, 4}|
			SELECTCASE LOCAL
				CASE 46
					PRINTFORM    
				CASE 47
					PRINTFORM       
				CASE 48
					PRINTFORM   
			ENDSELECT
			NEXT
		ENDIF
		PRINTFORML 
	CASE 5 ;Favor
		IF LABEL < 0
			IF FULL_NAME
				PRINTFORM %"　" * 19% 
			ELSE
				PRINTFORM %"　" * 11% 
			ENDIF
			FOR LOCAL, 44, 46
			CALL MAKE_SORT_BUTTON_TR(SORT_TYPE, LOCAL)
			PRINT |
			SIF LOCAL == 45
				PRINTFORM 
			NEXT
			IF TALENT:MASTER:劣情察知
