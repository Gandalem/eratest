; Modular ERB: CONVERSATION.ERB
;what's done - a pleasant conversation, an awkward discussion etc.

@CONV_WHAT(ARGS)
#FUNCTIONS
#DIMS PARTS
#DIMS OUTPUT
IF CharaAge:TARGET:0 == 3 && TALENT:TARGET:BornChild
	RETURNF "an unintelligible grunting session"
ENDIF
SELECTCASE ARGS
	CASE "engage"
		IF TFLAG:193 == 1
			PARTS = a pleasant:
			PARTS = %PARTS%a nice:
			PARTS = %PARTS%an exciting:
			PARTS = %PARTS%an interesting:
			PARTS = %PARTS%an uplifting
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %PARTS%
			PARTS = conversation:
			PARTS = %PARTS%discussion
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %OUTPUT% %PARTS%
		ELSEIF TFLAG:193 == -1
			PARTS = a somewhat awkward:
			PARTS = %PARTS%a somewhat forced
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %PARTS%
			PARTS = conversation:
			PARTS = %PARTS%discussion
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %OUTPUT% %PARTS%
		ELSE
			PARTS = some idle chatter:
			PARTS = %PARTS%some small talk:
			PARTS = %PARTS%exchanging some pleasantries
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %PARTS%
		ENDIF
	CASE "has"
		IF TFLAG:193 == 1
			PARTS = a pleasant:
			PARTS = %PARTS%a nice:
			PARTS = %PARTS%an exciting:
			PARTS = %PARTS%an interesting:
			PARTS = %PARTS%an uplifting
		ELSEIF TFLAG:193 == -1
			PARTS = a somewhat awkward:
			PARTS = %PARTS%a somewhat forced
		ELSEIF TFLAG:193 == 0
			PARTS = a normal:
			PARTS = %PARTS%an ordinary:
			PARTS = %PARTS%a relaxed:
			PARTS = %PARTS%a trivial
		ELSE
			PARTS = a
		ENDIF
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %PARTS%
		PARTS = conversation:
		PARTS = %PARTS%discussion:
		PARTS = %PARTS%chitchat:
		PARTS = %PARTS%chatter
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %OUTPUT% %PARTS%
ENDSELECT
RETURNF OUTPUT
;partner-name, uses Favor
;returns title, name, or "his/her lover"/"player's lover"
;ARG the character in question
;ARG:1 makes the title-names begin with "The" instead of "the"
;ARG:2 makes it "PLAYER's lover" instead of "your lover" - kept for compatibility with third person branch
;ARG:3 removes the "the"
;ARG:4 removes the "lover"-part entirely

@PNAME(ARG,ARG:1 = 0, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0)
#FUNCTIONS
#DIM DYNAMIC LOVER
#DIM DYNAMIC TITLE
#DIM DYNAMIC ANAME
TITLE = 1000
SIF TALENT:ARG:恋慕
	LOVER += 300
SIF CFLAG:ARG:好感度 > 50
	ANAME += 500
SIF CFLAG:ARG:好感度 > 200
	ANAME += 100
SIF CFLAG:ARG:好感度 > 500
	ANAME += 100
TITLE -= ANAME
LOCAL = RAND:(LOVER+ANAME+TITLE)
IF LOCAL < LOVER && !ARG:4 && (TALENT:ARG:恋慕 || TALENT:ARG:恋人)
	IF ARG:2 == 1
		;Repeated code for compatibility
		SIF ARG:1
			RETURNF @"당신의 연인"
		RETURNF @"당신의 연인"
	ELSE
		SIF ARG:1
			RETURNF @"당신의 연인"
		RETURNF @"당신의 연인"
	ENDIF
ELSEIF LOCAL < LOVER+ANAME
	RETURNF CALLNAME:ARG
ELSE
	RETURNF TNAME(NO:ARG,ARG:1,ARG:3)
ENDIF

@CONVERSATION()
#DIMS PARTS
#DIMS OUTPUT
VARSET PARTS
VARSET OUTPUT
IF CFLAG:ブチギレ > 0
	IF TFLAG:193 == -2
		OUTPUT = You try to calm down %PNAME(TARGET)%
		PARTS = , but it comes out a bit forced:
		PARTS = %PARTS% but only barely manage to form words
		OUTPUT = %OUTPUT%%SPLIT_G(PARTS)%...
	ELSEIF TALENT:恋人
		OUTPUT = You try talking with %PNAME(TARGET)%
		PARTS = , but it's clear neither one of you is honest about your feelings:
		PARTS = %PARTS%, but you're too stubborn to listen to each other:
		PARTS = %PARTS%, and decide to put off the apology for later:
		PARTS = %PARTS%, asking how %HE_SHE(TARGET)%'s feeling:
		PARTS = %PARTS%, apologizing from the bottom of your heart
		OUTPUT = %OUTPUT%%SPLIT_G(PARTS)%...
	ELSE
		PARTS = You diffuse the situation by talking with %PNAME(TARGET)% about the weather:
		PARTS = %PARTS%You apologize to %PNAME(TARGET)%:
		PARTS = %PARTS%You ask %PNAME(TARGET)% for forgiveness:
		PARTS = %PARTS%You ask %PNAME(TARGET)% how %HE_SHE(TARGET)%'s feeling:
		PARTS = %PARTS%You have a one-sided conversation with %PNAME(TARGET)%
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %PARTS%...
	ENDIF
ELSEIF CFLAG:TARGET:20 > 0 && CFLAG:TARGET:350 == 49
	IF TFLAG:193 == -2
		OUTPUT = You try to talk with %PNAME(TARGET)% during the party
		PARTS = , but it comes out a bit forced:
		PARTS = %PARTS% but only barely manage to form words
	ELSEIF TALENT:恋慕
		OUTPUT = You and %PNAME(TARGET)% pour drinks for each other as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% smile as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% laugh as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% enjoy the relaxed atmosphere as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% talk about pretty audacious topics:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% have %CONV_WHAT("has")% over some drinks
		OUTPUT = %SPLIT_G(OUTPUT)%
	ELSEIF ABL:親密 >= 5
		OUTPUT = You and %PNAME(TARGET)% pour drinks for each other as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% enjoy yourselves as you talk:
		OUTPUT = %OUTPUT%%PNAME(TARGET,1)% cracks a smile as you tell a joke:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% enjoy the relaxed atmosphere as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% stand a little too close as you talk:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% have %CONV_WHAT("has")% over some drinks
		OUTPUT = %SPLIT_G(OUTPUT)%
	ELSE
		OUTPUT = You have %CONV_WHAT("has")% with %PNAME(TARGET)%:
		OUTPUT = %OUTPUT%You engage %PNAME(TARGET)% in %CONV_WHAT("engage")%:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% have %CONV_WHAT("has")%:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% have %CONV_WHAT("has")% over some drinks
		OUTPUT = %SPLIT_G(OUTPUT)%
		PARTS '= " during the banquet:"
		PARTS = %PARTS% while enjoying some drinks
	ENDIF
	PARTS = %SPLIT_G(PARTS)%
	OUTPUT = %OUTPUT%%PARTS%...
ELSEIF CFLAG:TARGET:添い寝中
	IF TFLAG:193 == -2
		OUTPUT = You try to make some bed talk with %PNAME(TARGET)%
		PARTS = , but it comes out a bit forced:
		PARTS = %PARTS% but only barely manage to form words
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %OUTPUT%%PARTS%...
	ELSE
		OUTPUT = You have %CONV_WHAT("has")% with %PNAME(TARGET)% while lying in bed:
		OUTPUT = %OUTPUT%You engage %PNAME(TARGET)% in %CONV_WHAT("engage")% while lying in bed:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% have %CONV_WHAT("has")% while lying in bed
		PARTS '= " hugging each other:"
		PARTS = %PARTS%, your fingers entangled:
		PARTS = %PARTS%, snuggled up against each other
		OUTPUT = %SPLIT_G(OUTPUT)%%SPLIT_G(PARTS)%...
	ENDIF
ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:TARGET:同行 && CFLAG:TARGET:現在位置 != OMANEKIBEYA()
	IF TFLAG:193 == -2
		OUTPUT = You try to have %CONV_WHAT("has")% with %PNAME(TARGET)% during the date:
		OUTPUT = %OUTPUT%You try to engage %PNAME(TARGET)% in %CONV_WHAT("engage")% during the date
	ELSE
		OUTPUT = You have %CONV_WHAT("has")% with %PNAME(TARGET)% during the date:
		OUTPUT = %OUTPUT%You engage %PNAME(TARGET)% in %CONV_WHAT("engage")% during the date:
		OUTPUT = %OUTPUT%You and %PNAME(TARGET)% have %CONV_WHAT("has")% during the date
	ENDIF
	IF TFLAG:193 != -2
		IF TALENT:恋慕
			PARTS = , flirting once in a while:
			PARTS = %PARTS% while holding hands:
			PARTS = %PARTS% while walking next to each other:
			PARTS = %PARTS% as you both smile:
			PARTS = %PARTS% while smiling at each other:
			PARTS = %PARTS%, blushing a little:
			PARTS = %PARTS%, feeling a little embarrassed
		ELSE
			PARTS = , %SPLIT_G("discussing:talking about")% the general topics:
			PARTS = %PARTS%, %SPLIT_G("discussing:talking about")% the world:
			PARTS = %PARTS%, discussing your current location:
			PARTS = %PARTS%, talking about your next destination
		ENDIF
	ENDIF
	OUTPUT = %SPLIT_G(OUTPUT)%%SPLIT_G(PARTS)%...
ELSEIF TALENT:恋慕
	IF TFLAG:193 == -2
		OUTPUT = You try to have %CONV_WHAT("has")% with %PNAME(TARGET)%:
		OUTPUT = %OUTPUT%You try to engage %PNAME(TARGET)% in %CONV_WHAT("engage")%
		OUTPUT = %SPLIT_G(OUTPUT)%...
	ELSE
		OUTPUT = %OUTPUT%You have %CONV_WHAT("has")% with %PNAME(TARGET)%:
		OUTPUT = %OUTPUT%You engage %PNAME(TARGET)% in %CONV_WHAT("engage")%:
		OUTPUT = You and %PNAME(TARGET)% have %CONV_WHAT("has")%
		PARTS = , your fingertips entangled:
		PARTS = %PARTS% \@ TIME >= 360 && TIME <= 1080 ? in the light of day # in the dead of night \@:
		PARTS = %PARTS%, while smiling at each other
		OUTPUT = %SPLIT_G(OUTPUT)%%SPLIT_G(PARTS)%...
	ENDIF
ELSE
	IF TFLAG:193 == -2
		OUTPUT = You try to have %CONV_WHAT("has")% with %PNAME(TARGET)%:
		OUTPUT = %OUTPUT%You try to engage %PNAME(TARGET)% in %CONV_WHAT("engage")%
		OUTPUT = %SPLIT_G(OUTPUT)%...
	ELSE
		OUTPUT = %OUTPUT%You have %CONV_WHAT("has")% with %PNAME(TARGET)%:
		OUTPUT = %OUTPUT%You engage %PNAME(TARGET)% in %CONV_WHAT("engage")%:
		OUTPUT = You and %PNAME(TARGET)% have %CONV_WHAT("has")%
		OUTPUT = %SPLIT_G(OUTPUT)%...
	ENDIF
ENDIF
PRINTFORML %OUTPUT%
;%CALLNAME:PLAYER% has a pleasant conversation with %CALLNAME:TARGET% while lying in bed.
;situation x mood what y
;while lying in bed, %CALLNAME:PLAYER% has a pleasant conversation with %CALLNAME:TARGET%
;x and y spend some time talking about various things
IF TCVAR:泥酔
	PARTS = You try talking with %TNAME(TARGET)%, but are too drunk to form words.
	PARTS = %PARTS%:You try to start a conversation with %TNAME(TARGET)%, but %HE_SHE(TARGET)% can't understand what you are saying.
	PRINTFORMW %SPLIT_G(PARTS)%
	RETURN 1
ENDIF
IF CFLAG:ブチギレ > 0 ;if she's pissed
	IF TALENT:恋慕
	ELSE
	ENDIF
ELSEIF CFLAG:TARGET:20 > 0 && CFLAG:TARGET:350 == 49 ;at party with target
	IF TALENT:恋慕
	ELSEIF ABL:親密 >= 5
	ELSE
	ENDIF
ELSEIF CFLAG:TARGET:添い寝中 ;lying in bed
ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:TARGET:同行 && CFLAG:TARGET:現在位置 != OMANEKIBEYA() ;on date
	IF TALENT:恋慕
	ELSE
	ENDIF
ELSEIF TALENT:恋慕 ;lover
ELSE
ENDIF
PRINTFORML
IF TFLAG:193 == 1;good outcome
	;NAS: Slight convert to religion
	; FOR L, 1, GET_TARGETNUM()+1
	; 	SIF TALENT:MASTER:Religion != TALENT:(TARGET:L):Religion
	; 	CALL changeCertainty(TARGET:L,-20)
	; 	CALL changeCertainty(TARGET:L,30,TALENT:MASTER:Religion)
	; NEXT
ELSEIF TFLAG:193 == 2;exceptional outcome
	;NAS: Can't really happen
	PRINTFORM 당신은 가지고 있다 
	PRINTDATA
		;		DATAFORM 新たな異変の
		DATAFORM 과장되게
		DATAFORM 가치 있고
		DATAFORM 뜻밖에도
		DATAFORM 흥미롭게
	ENDDATA
	PRINTFORML  %CALLNAME:TARGET%%COND_STR(@" and the others", GET_TARGETNUM() > 1)%와 흥미진진한 대화를 나눈다...
ELSEIF TFLAG:193 == -1
	PRINTFORML 전반적으로 상당히 어색한 대화였다...
ELSEIF TFLAG:193 == -2
	PRINTFORML 많이 말하지 않았네...
ENDIF
PRINTFORMW 
