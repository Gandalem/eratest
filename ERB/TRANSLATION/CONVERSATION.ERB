; Modular ERB: CONVERSATION.ERB
;what's done - a pleasant conversation, an awkward discussion etc.

@CONV_WHAT(ARGS)
#FUNCTIONS
#DIMS PARTS
#DIMS OUTPUT
IF CharaAge:TARGET:0 == 3 && TALENT:TARGET:BornChild
	RETURNF "알아들을 수 없는 끙끙거림"
ENDIF
SELECTCASE ARGS
	CASE "engage"
		IF TFLAG:193 == 1
			PARTS = 기분 좋은:
			PARTS = %PARTS%즐거운:
			PARTS = %PARTS%흥미로운:
			PARTS = %PARTS%활기찬:
			PARTS = %PARTS%마음이 따뜻해지는
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %PARTS%
			PARTS = 대화:
			PARTS = %PARTS%이야기
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %OUTPUT% %PARTS%
		ELSEIF TFLAG:193 == -1
			PARTS = 조금 어색한:
			PARTS = %PARTS%다소 억지스러운
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %PARTS%
			PARTS = 대화:
			PARTS = %PARTS%이야기
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %OUTPUT% %PARTS%
		ELSE
			PARTS = 가벼운 대화:
			PARTS = %PARTS%소소한 이야기:
			PARTS = %PARTS%인사치레
			PARTS = %SPLIT_G(PARTS)%
			OUTPUT = %PARTS%
		ENDIF
	CASE "has"
		IF TFLAG:193 == 1
			PARTS = 기분 좋은:
			PARTS = %PARTS%즐거운:
			PARTS = %PARTS%흥미로운:
			PARTS = %PARTS%활기찬:
			PARTS = %PARTS%마음이 따뜻해지는
		ELSEIF TFLAG:193 == -1
			PARTS = 조금 어색한:
			PARTS = %PARTS%다소 억지스러운
		ELSEIF TFLAG:193 == 0
			PARTS = 평범한:
			PARTS = %PARTS%일상적인:
			PARTS = %PARTS%편안한:
			PARTS = %PARTS%사소한
		ELSE
			PARTS = 짧은
		ENDIF
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %PARTS%
		PARTS = 대화:
		PARTS = %PARTS%이야기:
		PARTS = %PARTS%담소:
		PARTS = %PARTS%잡담
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %OUTPUT% %PARTS%
ENDSELECT
RETURNF OUTPUT
;partner-name, uses Favor
;returns title, name, or "his/her lover"/"player's lover"
;ARG the character in question
;ARG:1 makes the title-names begin with "The" instead of "the"
;ARG:2 makes it "PLAYER's lover" instead of "your lover" - kept for compatibility with third person branch
;ARG:3 removes the "the"
;ARG:4 removes the "lover"-part entirely

@PNAME(ARG,ARG:1 = 0, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0)
#FUNCTIONS
#DIM DYNAMIC LOVER
#DIM DYNAMIC TITLE
#DIM DYNAMIC ANAME
TITLE = 1000
SIF TALENT:ARG:恋慕
	LOVER += 300
SIF CFLAG:ARG:好感度 > 50
	ANAME += 500
SIF CFLAG:ARG:好感度 > 200
	ANAME += 100
SIF CFLAG:ARG:好感度 > 500
	ANAME += 100
TITLE -= ANAME
LOCAL = RAND:(LOVER+ANAME+TITLE)
IF LOCAL < LOVER && !ARG:4 && (TALENT:ARG:恋慕 || TALENT:ARG:恋人)
	IF ARG:2 == 1
		;Repeated code for compatibility
		SIF ARG:1
			RETURNF @"당신의 연인"
		RETURNF @"당신의 연인"
	ELSE
		SIF ARG:1
			RETURNF @"당신의 연인"
		RETURNF @"당신의 연인"
	ENDIF
ELSEIF LOCAL < LOVER+ANAME
	RETURNF CALLNAME:ARG
ELSE
	RETURNF TNAME(NO:ARG,ARG:1,ARG:3)
ENDIF

@CONVERSATION()
#DIMS PARTS
#DIMS OUTPUT
VARSET PARTS
VARSET OUTPUT
IF CFLAG:ブチギレ > 0
	IF TFLAG:193 == -2
		OUTPUT = %PNAME(TARGET)%에게 진정하라며 말을 건넨다
		PARTS = , 하지만 말투가 조금 억지스럽다:
		PARTS = %PARTS% 하지만 간신히 말 몇 마디를 꺼낼 뿐이다
		OUTPUT = %OUTPUT%%SPLIT_G(PARTS)%...
	ELSEIF TALENT:恋人
		OUTPUT = %PNAME(TARGET)%에게 말을 건넨다
		PARTS = , 하지만 둘 다 속마음을 솔직히 털어놓지 못한다:
		PARTS = %PARTS%, 하지만 서로 고집을 부려 상대의 말을 들으려 하지 않는다:
		PARTS = %PARTS%, 결국 사과는 다음으로 미루기로 한다:
		PARTS = %PARTS%, 기분이 어떤지 조심스레 묻는다:
		PARTS = %PARTS%, 진심을 담아 사과한다
		OUTPUT = %OUTPUT%%SPLIT_G(PARTS)%...
	ELSE
		PARTS = 날씨 이야기를 꺼내 %PNAME(TARGET)%와의 분위기를 누그러뜨린다:
		PARTS = %PARTS%%PNAME(TARGET)%에게 사과한다:
		PARTS = %PARTS%%PNAME(TARGET)%에게 용서를 구한다:
		PARTS = %PARTS%%PNAME(TARGET)%에게 기분이 어떤지 묻는다:
		PARTS = %PARTS%%PNAME(TARGET)%를 상대로 혼자서 이야기를 이어 간다
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %PARTS%...
	ENDIF
ELSEIF CFLAG:TARGET:20 > 0 && CFLAG:TARGET:350 == 49
	IF TFLAG:193 == -2
		OUTPUT = 연회 중 %PNAME(TARGET)%에게 말을 걸어 보지만
		PARTS = , 말투가 조금 억지스럽다:
		PARTS = %PARTS% 간신히 말 몇 마디를 꺼낼 뿐이다
	ELSEIF TALENT:恋慕
		OUTPUT = %PNAME(TARGET)%와 서로 술을 따라 주며 이야기를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 미소 지으며 이야기를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 웃음을 터뜨리며 이야기를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 편안한 분위기를 즐기며 이야기를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 제법 대담한 이야기를 나눈다:
		OUTPUT = %OUTPUT%술잔을 기울이며 %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다
		OUTPUT = %SPLIT_G(OUTPUT)%
	ELSEIF ABL:親密 >= 5
		OUTPUT = %PNAME(TARGET)%와 서로 술을 따라 주며 이야기를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 즐겁게 이야기를 나눈다:
		OUTPUT = %OUTPUT%농담을 건네자 %PNAME(TARGET)%가 살며시 웃는다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 편안한 분위기를 즐기며 이야기를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 평소보다 가까이 선 채 이야기를 나눈다:
		OUTPUT = %OUTPUT%술잔을 기울이며 %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다
		OUTPUT = %SPLIT_G(OUTPUT)%
	ELSE
		OUTPUT = %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 함께 %CONV_WHAT("has")%를 나눈다:
		OUTPUT = %OUTPUT%술잔을 기울이며 %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다
		OUTPUT = %SPLIT_G(OUTPUT)%
		PARTS '= " 연회 자리에서:"
		PARTS = %PARTS% 술잔을 기울이며
	ENDIF
	PARTS = %SPLIT_G(PARTS)%
	OUTPUT = %OUTPUT%%PARTS%...
ELSEIF CFLAG:TARGET:添い寝中
	IF TFLAG:193 == -2
		OUTPUT = 침대에 누운 채 %PNAME(TARGET)%에게 말을 걸어 보지만
		PARTS = , 말투가 조금 억지스럽다:
		PARTS = %PARTS% 간신히 말 몇 마디를 꺼낼 뿐이다
		PARTS = %SPLIT_G(PARTS)%
		OUTPUT = %OUTPUT%%PARTS%...
	ELSE
		OUTPUT = 침대에 누운 채 %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다:
		OUTPUT = %OUTPUT%침대에 누운 채 %PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나눈다:
		OUTPUT = %OUTPUT%침대에 누운 채 %PNAME(TARGET)%와 함께 %CONV_WHAT("has")%를 나눈다
		PARTS '= " 서로를 끌어안은 채:"
		PARTS = %PARTS%, 손가락을 맞잡은 채:
		PARTS = %PARTS%, 서로에게 바싹 기대어
		OUTPUT = %SPLIT_G(OUTPUT)%%SPLIT_G(PARTS)%...
	ENDIF
ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:TARGET:同行 && CFLAG:TARGET:現在位置 != OMANEKIBEYA()
	IF TFLAG:193 == -2
		OUTPUT = 데이트 중 %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나누려 해 본다:
		OUTPUT = %OUTPUT%데이트 중 %PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나누려 해 본다
	ELSE
		OUTPUT = 데이트 중 %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다:
		OUTPUT = %OUTPUT%데이트 중 %PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나눈다:
		OUTPUT = %OUTPUT%데이트 중 %PNAME(TARGET)%와 함께 %CONV_WHAT("has")%를 나눈다
	ENDIF
	IF TFLAG:193 != -2
		IF TALENT:恋慕
			PARTS = , 가끔 장난스럽게 추파를 던지며:
			PARTS = %PARTS% 손을 맞잡은 채:
			PARTS = %PARTS% 나란히 걸으며:
			PARTS = %PARTS% 둘이 함께 미소 지으며:
			PARTS = %PARTS% 서로를 바라보며 미소 지은 채:
			PARTS = %PARTS%, 살짝 얼굴을 붉히며:
			PARTS = %PARTS%, 조금 쑥스러워하면서
		ELSE
			PARTS = , 평범한 화제를 두고 이야기를 나누며:
			PARTS = %PARTS%, 세상 돌아가는 이야기를 나누며:
			PARTS = %PARTS%, 지금 있는 장소에 관해 이야기하며:
			PARTS = %PARTS%, 다음 목적지를 의논하며
		ENDIF
	ENDIF
	OUTPUT = %SPLIT_G(OUTPUT)%%SPLIT_G(PARTS)%...
ELSEIF TALENT:恋慕
	IF TFLAG:193 == -2
		OUTPUT = %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나누려 해 본다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나누려 해 본다
		OUTPUT = %SPLIT_G(OUTPUT)%...
	ELSE
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나눈다:
		OUTPUT = %PNAME(TARGET)%와 함께 %CONV_WHAT("has")%를 나눈다
		PARTS = , 손끝을 맞댄 채:
		PARTS = %PARTS% \@ TIME >= 360 && TIME <= 1080 ? 환한 낮에 # 깊은 밤에 \@:
		PARTS = %PARTS%, 서로를 바라보며 미소 지은 채
		OUTPUT = %SPLIT_G(OUTPUT)%%SPLIT_G(PARTS)%...
	ENDIF
ELSE
	IF TFLAG:193 == -2
		OUTPUT = %PNAME(TARGET)%와 %CONV_WHAT("has")%를 나누려 해 본다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나누려 해 본다
		OUTPUT = %SPLIT_G(OUTPUT)%...
	ELSE
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("has")%를 나눈다:
		OUTPUT = %OUTPUT%%PNAME(TARGET)%와 %CONV_WHAT("engage")%를 나눈다:
		OUTPUT = %PNAME(TARGET)%와 함께 %CONV_WHAT("has")%를 나눈다
		OUTPUT = %SPLIT_G(OUTPUT)%...
	ENDIF
ENDIF
PRINTFORML %OUTPUT%
;%CALLNAME:PLAYER% has a pleasant conversation with %CALLNAME:TARGET% while lying in bed.
;situation x mood what y
;while lying in bed, %CALLNAME:PLAYER% has a pleasant conversation with %CALLNAME:TARGET%
;x and y spend some time talking about various things
IF TCVAR:泥酔
	PARTS = 술에 너무 취해 제대로 말하지 못하면서도 %TNAME(TARGET)%에게 말을 걸어 본다.
	PARTS = %PARTS%:%TNAME(TARGET)%에게 대화를 청해 보지만, 상대는 당신이 무슨 말을 하는지 알아듣지 못한다.
	PRINTFORMW %SPLIT_G(PARTS)%
	RETURN 1
ENDIF
IF CFLAG:ブチギレ > 0 ;if she's pissed
	IF TALENT:恋慕
	ELSE
	ENDIF
ELSEIF CFLAG:TARGET:20 > 0 && CFLAG:TARGET:350 == 49 ;at party with target
	IF TALENT:恋慕
	ELSEIF ABL:親密 >= 5
	ELSE
	ENDIF
ELSEIF CFLAG:TARGET:添い寝中 ;lying in bed
ELSEIF CHK_DATENOW(CFLAG:TARGET:デート中) && CFLAG:TARGET:同行 && CFLAG:TARGET:現在位置 != OMANEKIBEYA() ;on date
	IF TALENT:恋慕
	ELSE
	ENDIF
ELSEIF TALENT:恋慕 ;lover
ELSE
ENDIF
PRINTFORML
IF TFLAG:193 == 1;good outcome
	;NAS: Slight convert to religion
	; FOR L, 1, GET_TARGETNUM()+1
	; 	SIF TALENT:MASTER:Religion != TALENT:(TARGET:L):Religion
	; 	CALL changeCertainty(TARGET:L,-20)
	; 	CALL changeCertainty(TARGET:L,30,TALENT:MASTER:Religion)
	; NEXT
ELSEIF TFLAG:193 == 2;exceptional outcome
	;NAS: Can't really happen
	PRINTFORM 당신은
	PRINTDATA
		;		DATAFORM 新たな異変の
		DATAFORM  유쾌하게
		DATAFORM  진솔하게
		DATAFORM  뜻밖에도
		DATAFORM  열정적으로
	ENDDATA
	PRINTFORML  %CALLNAME:TARGET%%COND_STR(@" 일행", GET_TARGETNUM() > 1)%와 대화를 나눈다...
ELSEIF TFLAG:193 == -1
	PRINTFORML 전반적으로 상당히 어색한 대화였다...
ELSEIF TFLAG:193 == -2
	PRINTFORML 많이 말하지 않았네...
ENDIF
PRINTFORMW 
