; Modular ERB: _Name_Array.ERB
;init

@EVENTFIRST
#PRI
CALL NAS_START_LOADING()
CALL Name_Array_Set

@EVENTLOAD
#PRI
CALL NAS_START_LOADING()
SIF !FIRST_NAME_KM_ADDRESS
	CALL CREATE_NAME_LIST
CALL Name_Array_Set
;set every other string but the name again when reloading (so there's no need to use Update every time a little thing changes)
FOR LOCAL, 0, CHARANUM
;fallback
SIF NO:LOCAL >= CSV_CHARANUM()
	CONTINUE
SIF LOCAL%10 == 0
	CALL ANIMATION_LOAD_NAS(LOCAL, 0, CHARANUM, @"설정 이름" ) ;nas loading
SIF CSVCSTR(NO:LOCAL, 2) != "" ;workplace, printed at PRINT_STATE_PERSONAL
	CSTR:LOCAL:職場 '= nameArray:LOCAL:na_WorkPlace
SIF CSVCSTR(NO:LOCAL, 3) != "" ;work info, printed at WORK_INFO
	CSTR:LOCAL:仕事情報 '= nameArray:LOCAL:na_WorkInfo
;SIF CSVCSTR(NO:LOCAL, 10) != "" ;title/ability/race, printed at PRINT_種族抽出 and PRINT_STATE_PERSONAL
;	CSTR:LOCAL:10 '= nameArray:LOCAL:na_Title
NAME:LOCAL = %NameChecker(LOCAL)%
NEXT
;cstr:10 is tricky because it overlaps with the same range used for building a string check for ejaculations
;therefore we check it directly from the array (like csvcstr would) with nameArray:ARG:na_Title
;additional profile lines are translated through erb in dialogue and CHARACTER_PROFILE.ERB
;CSTR:2, CSTR:3 can be safely overridden via dialogue, title can be typed manually in custom character profile function
;names are reset to array's default on update, so they won't stick (but who really changes character names anyway?)
;syntax: 0 - og name, 1 - og callname
;2 - translated name, 3 - translated callname
;4 - work place, 5 - work description, 6 - title (ability etc)
;(todo - add og names for everyone when needed)
;revised example for omogatari

@EVENTTRAIN
#PRI
CALL PlaceHolderFlag

@EVENTCOM
#PRI
CALL PlaceHolderFlag

@EVENTSHOP
#PRI
CALL PlaceHolderFlag

@PlaceHolderInit
#DIM nReplaced = 182, 183, 184, 185
#DIM nArray = 182, 183, 184, 185
;init reset on replaced characters
FOR LOCAL, 0, VARSIZE("nReplaced")
WHILE GETCHARA(nReplaced:LOCAL) != -1 && EXISTCSV(nReplaced:LOCAL) && NAME:(nReplaced:LOCAL) != nameArray:(nReplaced:LOCAL):na_Name
CALL ADDCHARA_INIT(NO:(nReplaced:LOCAL))
SWAPCHARA CHARANUM-1, nReplaced:LOCAL
DELCHARA CHARANUM-1
CALL ADDCHARA_INIT(NO:(nReplaced:LOCAL), 1) ;apply again to init strings
IF !EXP:(NO:(nReplaced:LOCAL)):キス経験
	TALENT:(NO:(nReplaced:LOCAL)):キス未経験 = 1
ELSE
	TALENT:(NO:(nReplaced:LOCAL)):キス未経験 = 0
ENDIF
WEND
NEXT
FOR LOCAL, 0, VARSIZE("nArray")
IF GETCHARA(nArray:LOCAL) != -1 && EXISTCSV(nArray:LOCAL)
	CALL ADDCHARA_INIT(NO:(nArray:LOCAL))
	SWAPCHARA CHARANUM-1, nArray:LOCAL
	DELCHARA CHARANUM-1
	CALL ADDCHARA_INIT(NO:(nArray:LOCAL), 1) ;apply again to init strings
ENDIF
NEXT

@PlaceHolderFlag
#DIM nArray = 182, 183, 184, 185
FOR LOCAL, 0, VARSIZE("nArray")
IF GETCHARA(nArray:LOCAL) != -1 && nArray:LOCAL < CHARANUM
	CFLAG:(nArray:LOCAL):出禁 = 2
ENDIF
NEXT

@Name_Array_Set
FOR LOCAL, 0, 2000
SIF LOCAL >= CHARANUM
	RETURN
SIF nameArray:LOCAL:na_Callname != "" && nameArray:LOCAL:na_FirstName != ""
	CONTINUE
IF LOCAL == 0 && CALLNAME:LOCAL != CSVNAME(0)
	nameArray:LOCAL:na_Name '= NAME:LOCAL
	nameArray:LOCAL:na_Callname '= CALLNAME:LOCAL
	nameArray:LOCAL:na_FirstName '= CALLNAME:LOCAL
ELSE
	CALL IndividualNameSet(LOCAL)
ENDIF
NEXT

@IndividualNameSet(ARG)
CALL IndividualNameGet(NO:ARG)
FOR LOCAL,0,VARSIZE("nameArray")
nameArray:ARG:LOCAL '= nameArrayTemp:LOCAL
NEXT

