@MARK_MESSAGE_TRAUMA(ARG)
IF TFLAG:TraumaMark == 0
	IF CharaTrauma:ARG:1 > TFLAG:TraumaMark && CharaTrauma:ARG:0 == 0
		PRINTFORML %CALLNAME:ARG%은(는) %HIS_HER(ARG)%의 정신적 트라우마에서 완전히 회복했다.
		PRINTFORMW %CALLNAME:ARG%은(는) 이제【안정】 상태이다.
	ENDIF
ELSEIF TFLAG:TraumaMark == 1
	IF CharaTrauma:ARG:1 > TFLAG:TraumaMark
		PRINTFORML %CALLNAME:ARG%에게 아직 약간의 이상이 남아있지만, %HE_SHE(ARG)%는 이제 대부분 안정된 상태이다...
	ELSE
		PRINTFORML %CALLNAME:ARG%은(는) 조금 이상함을 느끼기 시작한다...
	ENDIF
	PRINTFORMW %CALLNAME:ARG%는 이제【이상】이다.
ELSEIF TFLAG:TraumaMark == 2
	IF CharaTrauma:ARG:1 > TFLAG:TraumaMark
		PRINTFORML %CALLNAME:ARG%에게 안정감이 돌아온 듯하다...
	ELSE
		PRINTFORML 트라우마가 %CALLNAME:ARG%에게 매우 부정적인 영향을 미치기 시작했다...
	ENDIF
	PRINTFORMW %CALLNAME:ARG%는 이제【트라우마화】되었다.
ELSEIF TFLAG:TraumaMark == 3
	PRINTFORML %CALLNAME:ARG%의 정신이 부서진다...
	PRINTFORMW %CALLNAME:ARG%는 이제【정신 파괴】 상태이다.
ELSEIF TFLAG:TraumaMark == 4
	PRINTFORML %CALLNAME:ARG%의 육체와 정신이 완전히 붕괴했다...
	PRINTFORMW %CALLNAME:ARG%는 이제 【정신 파괴】 상태다.
	PRINTFORMW %CALLNAME:ARG%는 이제 【복종】을 가지게 되었다.
	MARK:ARG:3 = 0
	CALL QoL_Info_Write(ARG, Qol_Dates_MindBreak)
	TALENT:ARG:5 = 1
ELSEIF TFLAG:TraumaMark == 5
	PRINTFORML %CALLNAME:ARG%은(는) 더 이상의 트라우마를 감당하지 못하고 식물인간 상태로 쓰러졌다...
	PRINTFORMW %CALLNAME:ARG%은(는) 이제【혼수상태】이며 현재 식물 상태에 있다...
	CALL QoL_Info_Write(ARG, Qol_Dates_MindBreak)
	TALENT:ARG:5 = 1
	CFLAG:ARG:睡眠 = 1
ENDIF
