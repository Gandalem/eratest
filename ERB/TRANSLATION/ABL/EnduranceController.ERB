ENDSELECT
RETURNF 1

@ChangeEndurance(ARG,ARGS,nChange)
#FUNCTION
#DIM nChange
;global toggle
SIF !nEnduranceScaleStats
	RETURNF 0
;doesn't exist
SIF !EnduranceDB(ARGS)
	RETURNF -1
;individual toggled
SIF CharaDisableEndurance:EC_ID
	RETURNF -1

;talents
IF GROUPMATCH(EC_EXP_VAR,"PeeHold","PooHold")
	SIF TALENT:MASTER:358
		nChange *= 3
ENDIF

SETVAR @"%EC_EXP_VAR%:{ARG}:1", GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
SETVAR @"%EC_EXP_VAR%:{ARG}:0", LIMIT(GETVAR(@"%EC_EXP_VAR%:{ARG}:0") + nChange,EC_EXP:0,EC_EXP:1)
RETURNF nChange

;custom code for non-CSV exp
;Mr Pops Alot
@ShowEnduranceChange(ARG)
#DIM DYNAMIC nVal, 2
#DIM DYNAMIC nShow
#DIM DYNAMIC DIFFERENCE

FOR LOCAL:1,0,6
	VARSET nVal
	VARSET DIFFERENCE
    CALLF EnduranceDB(TOSTR(LOCAL:1))

    nVal = GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
    nVal:1 = GETVAR(@"%EC_EXP_VAR%:{ARG}:1")
    LOCALS:1 = %EC_NAME% Exp

	IF nVal != nVal:1
		DIFFERENCE = nVal - nVal:1
		nShow ++
		PRINTFORM %LOCALS:1% \@ DIFFERENCE >= 0 ? + # \@{DIFFERENCE}(%CALLNAME:ARG%)
		IF LOCAL:1 == 5
		;NAS TRAUMA
			SIF CharaTrauma:ARG:0+1 > (EXISTVAR("NAS_VERSION") ? 5 # 3)
				CONTINUE
			IF TFLAG:TraumaMark
				LOCAL = 1
				LOCAL:2 = 1
				PRINTFORM  Trauma Mark Lv{CharaTrauma:ARG:0} Gain: 
			ELSE
				LOCAL = EXP_DEMAND_24(0,0,0,0,(MIN(CharaTrauma:ARG:0+1,5)))
				LOCAL:2 = nVal
				PRINTFORM  Trauma Mark Lv{MIN(CharaTrauma:ARG:0+1,5)} Gain: 
			ENDIF
			CALL PRINTTHRESHOLDBAR(LOCAL:2, LOCAL:0, 54)
		ENDIF
		PRINTL
	ENDIF
NEXT
RETURN nShow

;ARG:1 is to FORCE set
@ResetTempEndurance(ARG, ARG:1 = 0)
#FUNCTION
#DIM isDisabled
{
	#DIMS AvaliableValues =
	"orgasmdeny", "peehold", "poohold",
	"alcoholaddict", "drugaddict", "charatrauma"
}

;global toggle
SIF !nEnduranceScaleStats
	RETURNF 0
FOR LOCAL,0,VARSIZE("AvaliableValues")
	isDisabled = 0

	;individual toggle
	SIF CharaDisableEndurance:ARG:(LOCAL) && !ARG:1
		isDisabled = 1

    CALLF EnduranceDB(AvaliableValues:LOCAL)
    IF isDisabled
        SETVAR @"%EC_EXP_VAR%:{ARG}:0", GETVAR(@"%EC_EXP_VAR%:{ARG}:1")
    ELSE
        SETVAR @"%EC_EXP_VAR%:{ARG}:1", GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
    ENDIF
NEXT

