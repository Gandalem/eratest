    EC_MAX:0     = -5
    EC_MAX:1     = 5
    EC_EXP:0     = -2000
    EC_EXP:1     = 2000
	EC_TALENT 	 = 1500
	EC_AUD		 = 21
CASE "alcoholaddict", "3"
