@ENDURANCE_DISABLE_MENU
#DIM nBannedCount
#DIM nSelection
#DIM C_ID
LINESTART = LINECOUNT
nSelection = 100
DO
nBannedCount = 0
REDRAW 0
CLEARLINE LINECOUNT - LINESTART
PRINTFORML 어떤 캐릭터의 \@ STRLENS(ENDURANCE_NAMES(nSelection)) ? %ENDURANCE_NAMES(nSelection)% # 지구력 \@ 능력치 획득 및 손실이 비활성화되어야 하는지 선택한다.
DRAWLINE
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 0, EX_CHARANUM
IF FLAG:並び替え
	LOCAL = RESULT:(LOCAL:1)
	SIF LOCAL < 0
		CONTINUE
ELSE
	LOCAL = LOCAL:1
	SIF LOCAL >= CHARANUM
		BREAK
ENDIF
IF INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
	IF CharaDisableEndurance:LOCAL:nSelection
		SETCOLOR C_L_GRAY
		nBannedCount++
	ENDIF
ENDIF
PRINTFORMLC [{LOCAL, 3}] %CALLNAME:LOCAL%\@ LOCAL == MASTER ? %" (당신)"% # \@
RESETCOLOR
NEXT
PRINTL 　
DRAWLINE
PRINTFORML [800] 캐릭터 메뉴
FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
IF STRLENS(ENDURANCE_NAMES(LOCAL))
	SIF nSelection == LOCAL
		SETCOLOR C_AQUA
	PRINTFORM [{LOCAL+900,3}] %ENDURANCE_NAMES(LOCAL)%　
	RESETCOLOR
ENDIF
NEXT
PRINTL
PRINTFORM [999] 종료 (비활성화됨: %PRINT_PLUR("Character", nBannedCount)%)
SIF INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
	PRINTFORM 　[998] 모두 활성화 [997] 모두 비활성화
PRINTL
$LOOP
INPUT
C_ID = RESULT
IF C_ID >= 0 && C_ID <= CHARANUM
	IF !INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
		DO
		PRINTFORML %CALLNAME:C_ID%의 어떤 지구력 스탯을 비활성화할지 선택한다.
		FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
		SIF STRLENS(ENDURANCE_NAMES(LOCAL))
			PRINTFORML [{LOCAL,3}] %ENDURANCE_NAMES(LOCAL),20,LEFT%: \@ CharaDisableEndurance:C_ID:LOCAL ? 비활성화됨 # 활성화됨 \@
		NEXT
		PRINTL
		PRINTFORML [997] - 모두 활성화
		PRINTFORML [998] - 모두 비활성화
		PRINTFORML [999] - 취소
		INPUT
		SELECTCASE RESULT
			CASE 997
				FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
				CharaDisableEndurance:C_ID:LOCAL = 0
				NEXT
			CASE 998
				FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
				CharaDisableEndurance:C_ID:LOCAL = 1
				NEXT
			CASE 999
				BREAK
			CASE 0 TO VARSIZE("CharaDisableEndurance")
				CharaDisableEndurance:C_ID:RESULT = !CharaDisableEndurance:C_ID:RESULT
		ENDSELECT
		LOOP 1
	ELSE
		CharaDisableEndurance:C_ID:nSelection = !CharaDisableEndurance:C_ID:nSelection
	ENDIF
ELSEIF RESULT == 800
	nSelection = 100
ELSEIF INRANGE(RESULT-900,0,VARSIZE("CharaDisableEndurance"))
	nSelection = RESULT-900
ELSEIF RESULT == 999
	PRINTW 설정이 적용되었다.
	RETURN
ELSEIF RESULT == 998 && INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
	FOR LOCAL,0,CHARANUM
	CharaDisableEndurance:LOCAL:nSelection = 0
	NEXT
ELSEIF RESULT == 997 && INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
	FOR LOCAL,0,CHARANUM
	CharaDisableEndurance:LOCAL:nSelection = 1
	NEXT
ELSE
ENDIF
LOOP 1

@ENDURANCE_NAMES(ARG)
#FUNCTIONS
CALLF EnduranceDB(TOSTR(ARG))
RETURNF EC_NAME

@SOURCE_TRAUMA(ARG, ARG:1)
#DIM DYNAMIC SENDT
SENDT = SOURCE:5
;inherit fear for terror
SOURCE:ARG:Terror += SOURCE:ARG:恐怖
;maso
SOURCE:ARG:Terror += (SOURCE:ARG:苦痛*(100-(ABL:ARG:15*25))/100)
SENDT = SOURCE:ARG:Terror
SENDT /= 1000
;相手主導
SIF ARG != MASTER && CFLAG:ARG:うふふ == 2
	TIMES SENDT, 0.50
;================================
;ABILITIES
;================================
;SENDT = ABL補正(SENDT,ABL:ARG:従順,1); commented, this makes NO sense
IF TCVAR:ARG:無理矢理
	;rape
	;set a flat 8x multipler and ignore obedience.
	;also adds 150 terror PALAMs
	TIMES SENDT , 8.00
	SENDT += 150
	GOTO SKIP_OBED
ENDIF
SELECTCASE ABL:ARG:従順
	CASE IS >= 20
		TIMES SENDT , 0.10
	CASE IS >= 10
		TIMES SENDT , 0.30
	CASE 9
		TIMES SENDT , 0.50
	CASE 8
		TIMES SENDT , 1.00
	CASE 7
		TIMES SENDT , 1.50
	CASE 6
		TIMES SENDT , 2.00
	CASE 5
		TIMES SENDT , 2.50
	CASE 4
		TIMES SENDT , 3.00
	CASE 3
		TIMES SENDT , 3.50
	CASE 2
		TIMES SENDT , 4.00
	CASE 1
		TIMES SENDT , 5.00
	CASEELSE
		TIMES SENDT , 6.00
ENDSELECT
;================================
;TALENTS
$SKIP_OBED
;================================
;GAIN
;==================
;Timid
SIF TALENT:ARG:度胸 < 0
	TIMES SENDT , 2.00
;Sexually Ignorant (and in Sex)
SIF (TALENT:ARG:SexKnow == -1 || TALENT:ARG:27) && CFLAG:ARG:うふふ
	TIMES SENDT , 1.40
;Shy
SIF TALENT:ARG: 33 > 0
	TIMES SENDT , 1.60
;Weakness
SIF TALENT:ARG:34 > 0
	TIMES SENDT , 2.50
;Wimp
SIF TALENT:ARG:40 > 0
	TIMES SENDT , 2.00
;Submits Easily
SIF TALENT:ARG:72 > 0
	TIMES SENDT , 3.00
;Child Like
SIF TALENT:ARG:151 > 0
	TIMES SENDT , 4.00
;==================
;LOSE
;==================
;Brave
SIF TALENT:ARG:度胸 > 0
	TIMES SENDT , 0.70
;Defiant
;Self Control
SIF TALENT:ARG:20 > 0
	TIMES SENDT , 0.8
;Aphat/Psycho
SIF TALENT:ARG:21 > 0
	TIMES SENDT , 0.5
;Emotionless
SIF TALENT:ARG:34 > 0
	TIMES SENDT , 0.5
;Tough
SIF TALENT:ARG:22
	TIMES SENDT , 0.5
;Insane
SIF TALENT:ARG:141 > 0
	TIMES SENDT , 0.3
;================================
;rape expansion FORCE MARK
SELECTCASE MARK:ARG:MARK_FORCE
	CASE 0
		TIMES LOCAL , 1.00
	CASE 1
		TIMES LOCAL , 0.90
	CASE 2
		TIMES LOCAL , 0.75
	CASE 3
		TIMES LOCAL , 0.50
	CASE 4
		TIMES LOCAL , 0.30
	CASEELSE
		TIMES LOCAL , 0.10
ENDSELECT
;randomization
SENDT = SENDT * RAND(80,110)/100
SIF DrugStats:ARG:FluvoxamineTime
	TIMES SENDT, 0.25
IF ARG:1
	OrgasmDenyExp:ARG:0 -= SENDT
ELSE
	IF SENDT > 0
		TIMES SENDT, 0.7
		SELECTCASE OrgasmDeny:ARG:0
			CASE -5
				TIMES SENDT, 2.0
			CASE -4
				TIMES SENDT, 1.75
			CASE -3
				TIMES SENDT, 1.5
			CASE -2
				TIMES SENDT, 1.3
			CASE -1
				TIMES SENDT, 1.1
			CASE 0
				TIMES SENDT, 1.0
			CASE 1
				TIMES SENDT, 0.9
			CASE 2
				TIMES SENDT, 0.8
			CASE 3
				TIMES SENDT, 0.7
			CASE 4
				TIMES SENDT, 0.5
			CASE 5
				TIMES SENDT, 0.3
		ENDSELECT
	ENDIF
	CharaTraumaExp:ARG:0 += SENDT
ENDIF
