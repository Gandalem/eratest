@ENDURANCE_DISABLE_MENU
#DIM nBannedCount
#DIM nSelection
#DIM C_ID

LINESTART = LINECOUNT
nSelection = 100
DO
nBannedCount = 0
REDRAW 0
CLEARLINE LINECOUNT - LINESTART
PRINTFORML Choose which characters's \@ STRLENS(ENDURANCE_NAMES(nSelection)) ? %ENDURANCE_NAMES(nSelection)% # endurance \@ stat gain and loss should be disabled.
DRAWLINE
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 0, EX_CHARANUM
	IF FLAG:並び替え
		LOCAL = RESULT:(LOCAL:1)
		SIF LOCAL < 0
			CONTINUE
	ELSE
		LOCAL = LOCAL:1
		SIF LOCAL >= CHARANUM
			BREAK
	ENDIF
	IF INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
		IF CharaDisableEndurance:LOCAL:nSelection
			SETCOLOR C_L_GRAY
			nBannedCount++
		ENDIF
	ENDIF
	PRINTFORMLC [{LOCAL, 3}] %CALLNAME:LOCAL%\@ LOCAL == MASTER ? %" (You)"% # \@
	RESETCOLOR
NEXT
PRINTL 　
DRAWLINE
PRINTFORML [800] Character Menu
FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
	IF STRLENS(ENDURANCE_NAMES(LOCAL))
	SIF nSelection == LOCAL
	SETCOLOR C_AQUA
	PRINTFORM [{LOCAL+900,3}] %ENDURANCE_NAMES(LOCAL)%　
	RESETCOLOR
	ENDIF
NEXT
PRINTL
PRINTFORM [999] Finish (Disabled: %PRINT_PLUR("Character", nBannedCount)%)
SIF INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
PRINTFORM 　[998] Enable All　[997] Disable All
PRINTL

$LOOP
INPUT
C_ID = RESULT
IF C_ID >= 0 && C_ID <= CHARANUM
	IF !INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
		DO
			PRINTFORML Select what endurance stats should be disabled for %CALLNAME:C_ID%
			FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
				SIF STRLENS(ENDURANCE_NAMES(LOCAL))
				PRINTFORML [{LOCAL,3}] %ENDURANCE_NAMES(LOCAL),20,LEFT%: \@ CharaDisableEndurance:C_ID:LOCAL ? Disabled # Enabled \@
			NEXT
			PRINTL
			PRINTFORML [997] - Enable All
			PRINTFORML [998] - Disable All
			PRINTFORML [999] - Cancel
			INPUT
			SELECTCASE RESULT
			CASE 997
				FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
					CharaDisableEndurance:C_ID:LOCAL = 0
				NEXT
			CASE 998
				FOR LOCAL,0,VARSIZE("CharaDisableEndurance")
					CharaDisableEndurance:C_ID:LOCAL = 1
				NEXT
			CASE 999
				BREAK
			CASE 0 TO VARSIZE("CharaDisableEndurance")
				CharaDisableEndurance:C_ID:RESULT = !CharaDisableEndurance:C_ID:RESULT
			ENDSELECT
		LOOP 1
	ELSE
		CharaDisableEndurance:C_ID:nSelection = !CharaDisableEndurance:C_ID:nSelection
	ENDIF
ELSEIF RESULT == 800
	nSelection = 100
ELSEIF INRANGE(RESULT-900,0,VARSIZE("CharaDisableEndurance"))
	nSelection = RESULT-900
ELSEIF RESULT == 999
	PRINTW Settings applied.
	RETURN
ELSEIF RESULT == 998 && INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
	FOR LOCAL,0,CHARANUM
		CharaDisableEndurance:LOCAL:nSelection = 0
	NEXT
ELSEIF RESULT == 997 && INRANGE(nSelection,0,VARSIZE("CharaDisableEndurance"))
	FOR LOCAL,0,CHARANUM
		CharaDisableEndurance:LOCAL:nSelection = 1
	NEXT
ELSE
ENDIF
LOOP 1

