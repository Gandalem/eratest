@SOURCE_TRAUMA(ARG, ARG:1)
#DIM DYNAMIC SENDT
SENDT = SOURCE:5


;inherit fear for terror
SOURCE:ARG:Terror += SOURCE:ARG:恐怖
;maso
SOURCE:ARG:Terror += (SOURCE:ARG:苦痛*(100-(ABL:ARG:15*25))/100)
SENDT = SOURCE:ARG:Terror
SENDT /= 1000
;相手主導
SIF ARG != MASTER && CFLAG:ARG:うふふ == 2
	TIMES SENDT, 0.50

;================================
;ABILITIES
;================================
;SENDT = ABL補正(SENDT,ABL:ARG:従順,1); commented, this makes NO sense

IF TCVAR:ARG:無理矢理
	;rape
	;set a flat 8x multipler and ignore obedience.
	;also adds 150 terror PALAMs
	TIMES SENDT , 8.00
	SENDT += 150
	GOTO SKIP_OBED
ENDIF

SELECTCASE ABL:ARG:従順
CASE IS >= 20
	TIMES SENDT , 0.10
CASE IS >= 10
	TIMES SENDT , 0.30
CASE 9
	TIMES SENDT , 0.50
CASE 8
	TIMES SENDT , 1.00
CASE 7
	TIMES SENDT , 1.50
CASE 6
	TIMES SENDT , 2.00
CASE 5
	TIMES SENDT , 2.50
CASE 4
	TIMES SENDT , 3.00
CASE 3
	TIMES SENDT , 3.50
CASE 2
	TIMES SENDT , 4.00
CASE 1
	TIMES SENDT , 5.00
CASEELSE
	TIMES SENDT , 6.00
ENDSELECT
;================================
;TALENTS
$SKIP_OBED
;================================
;GAIN
;==================
;Timid
SIF TALENT:ARG:度胸 < 0
	TIMES SENDT , 2.00
;Sexually Ignorant (and in Sex)
SIF (TALENT:ARG:SexKnow == -1 || TALENT:ARG:27) && CFLAG:ARG:うふふ
	TIMES SENDT , 1.40
;Shy
SIF TALENT:ARG: 33 > 0
	TIMES SENDT , 1.60
;Weakness
SIF TALENT:ARG:34 > 0
	TIMES SENDT , 2.50
;Wimp
SIF TALENT:ARG:40 > 0
	TIMES SENDT , 2.00
;Submits Easily
SIF TALENT:ARG:72 > 0
	TIMES SENDT , 3.00
;Child Like
SIF TALENT:ARG:151 > 0
	TIMES SENDT , 4.00
;==================
;LOSE
;==================
;Brave
SIF TALENT:ARG:度胸 > 0
	TIMES SENDT , 0.70
;Defiant
;Self Control
SIF TALENT:ARG:20 > 0
	TIMES SENDT , 0.8
;Aphat/Psycho
SIF TALENT:ARG:21 > 0
	TIMES SENDT , 0.5
;Emotionless
SIF TALENT:ARG:34 > 0
	TIMES SENDT , 0.5
;Tough
SIF TALENT:ARG:22
	TIMES SENDT , 0.5
;Insane
SIF TALENT:ARG:141 > 0
	TIMES SENDT , 0.3
;================================

;rape expansion FORCE MARK
SELECTCASE MARK:ARG:MARK_FORCE
	CASE 0
		TIMES LOCAL , 1.00
	CASE 1
		TIMES LOCAL , 0.90
	CASE 2
		TIMES LOCAL , 0.75
	CASE 3
		TIMES LOCAL , 0.50
	CASE 4
		TIMES LOCAL , 0.30
	CASEELSE
		TIMES LOCAL , 0.10
ENDSELECT

;randomization
SENDT = SENDT * RAND(80,110)/100

SIF DrugStats:ARG:FluvoxamineTime
	TIMES SENDT, 0.25

IF ARG:1
	OrgasmDenyExp:ARG:0 -= SENDT
ELSE
	IF SENDT > 0
	TIMES SENDT, 0.7
	SELECTCASE OrgasmDeny:ARG:0
	CASE -5
		TIMES SENDT, 2.0
	CASE -4
		TIMES SENDT, 1.75
	CASE -3
		TIMES SENDT, 1.5
	CASE -2
		TIMES SENDT, 1.3
	CASE -1
		TIMES SENDT, 1.1
	CASE 0
		TIMES SENDT, 1.0
	CASE 1
		TIMES SENDT, 0.9
	CASE 2
		TIMES SENDT, 0.8
	CASE 3
		TIMES SENDT, 0.7
	CASE 4
		TIMES SENDT, 0.5
	CASE 5
		TIMES SENDT, 0.3
	ENDSELECT
	ENDIF
	CharaTraumaExp:ARG:0 += SENDT
ENDIF

;==========================================================
;MARK_MESSAGE_TRAUMA
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Message for gaining TRAUMA
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;None
;==========================================================
; SELECTCASE ARG:0
; 	CASE 0
; 		RETURNF "Stable"
; 	CASE 1
; 		RETURNF "Abnormal"
; 	CASE 2
; 		RETURNF "Traumatized"
; 	CASE 3
; 		RETURNF "Mind Broken"
; 	CASE 4
; 		RETURNF "Spirit Broken"
; 	CASE 5
; 		RETURNF "Catatonic"
; ENDSELECT
@MARK_MESSAGE_TRAUMA(ARG)
IF TFLAG:TraumaMark == 0
	IF CharaTrauma:ARG:1 > TFLAG:TraumaMark && CharaTrauma:ARG:0 == 0
		PRINTFORML %CALLNAME:ARG% has fully recovered from %HIS_HER(ARG)% mental trauma.
		PRINTFORMW %CALLNAME:ARG% is now【Stable】.
	ENDIF
ELSEIF TFLAG:TraumaMark == 1
	IF CharaTrauma:ARG:1 > TFLAG:TraumaMark
		PRINTFORML While %CALLNAME:ARG% still has some abnormalities, %HE_SHE(ARG)% is now mostly stable...
	ELSE
		PRINTFORML %CALLNAME:ARG% is starting to feel a bit strange...
	ENDIF
	PRINTFORMW %CALLNAME:ARG% is now【Abnormal】.
ELSEIF TFLAG:TraumaMark == 2
	IF CharaTrauma:ARG:1 > TFLAG:TraumaMark
	PRINTFORML A resemblance of stability has returned to %CALLNAME:ARG%...
	ELSE
	PRINTFORML Trauma has started to affect %CALLNAME:ARG% very negatively...
	ENDIF
	PRINTFORMW %CALLNAME:ARG% is now【Traumatized】.
ELSEIF TFLAG:TraumaMark == 3
	PRINTFORML %CALLNAME:ARG%'s mind snaps...
	PRINTFORMW %CALLNAME:ARG% is now【Mind Broken】.
ELSEIF TFLAG:TraumaMark == 4
	PRINTFORML %CALLNAME:ARG%'s body and sanity has fully collapsed...
	PRINTFORMW %CALLNAME:ARG% is now【Spirit Broken】.
	PRINTFORMW %CALLNAME:ARG% now has【Submission】.
	MARK:ARG:3 = 0
	CALL QoL_Info_Write(ARG, Qol_Dates_MindBreak)
	TALENT:ARG:5 = 1
ELSEIF TFLAG:TraumaMark == 5
	PRINTFORML %CALLNAME:ARG% is unable to handle any more trauma and has collapsed into a vegetable...
	PRINTFORMW %CALLNAME:ARG% is now【Catatonic】and is now in a vegatative state...
	CALL QoL_Info_Write(ARG, Qol_Dates_MindBreak)
	TALENT:ARG:5 = 1
	CFLAG:ARG:睡眠 = 1
ENDIF

