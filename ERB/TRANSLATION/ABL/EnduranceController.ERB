@EnduranceDB(ARGS)
#FUNCTION
VARSET EC_NAME
VARSET EC_VAR
SELECTCASE TOLOWER(ARGS)
	CASE "orgasmdeny", "0"
		EC_NAME     '= "정신력"
		EC_VAR      '= "OrgasmDeny"
		EC_ID        = 0
		EC_EXP_VAR  '= "OrgasmDenyExp"
		EC_MAX:0     = -5
		EC_MAX:1     = 5
		EC_EXP:0     = -10000
		EC_EXP:1     = 10000
		EC_TALENT 	 = 1310
		EC_AUD		 = 19
	CASE "peehold", "1"
		SIF !nPee
			RETURNF 0
		EC_NAME     '= "소변 참기"
		EC_VAR      '= "PeeHold"
		EC_ID        = 1
		EC_EXP_VAR  '= "PeeHoldExp"
		EC_MAX:0     = -5
		EC_MAX:1     = 5
		EC_EXP:0     = -2000
		EC_EXP:1     = 2000
		EC_TALENT 	 = 1514
		EC_AUD		 = 20
	CASE "poohold", "2"
		SIF !nScat
			RETURNF 0
		EC_NAME     '= "대변 참기"
		EC_VAR      '= "PooHold"
		EC_ID        = 2
		EC_EXP_VAR  '= "PooHoldExp"
		EC_MAX:0     = -5
		EC_MAX:1     = 5
		EC_EXP:0     = -2000
		EC_EXP:1     = 2000
		EC_TALENT 	 = 1500
		EC_AUD		 = 21
	CASE "alcoholaddict", "3"
		EC_NAME     '= "알코올 중독"
		EC_VAR      '= "AlcoholAddict"
		EC_ID        = 3
		EC_EXP_VAR  '= "DrinkingExp"
		EC_MAX:0     = -5
		EC_MAX:1     = 5
		EC_EXP:0     = -2000
		EC_EXP:1     = 2000
		EC_AUD		 = 22
		EC_TALENT 	 = 121
	CASE "drugaddict", "4"
		EC_NAME     '= "약물 중독"
		EC_VAR      '= "DrugAddict"
		EC_ID        = 4
		EC_EXP_VAR  '= "DrugExp"
		EC_MAX:0     = -5
		EC_MAX:1     = 5
		EC_EXP:0     = -2000
		EC_EXP:1     = 2000
		EC_AUD		 = 23
		EC_TALENT 	 = 56
	CASE "charatrauma", "5"
		EC_NAME     '= "트라우마"
		EC_VAR      '= "CharaTrauma"
		EC_ID        = 5
		EC_EXP_VAR  '= "CharaTraumaExp"
		EC_MAX:0     = 0
		EC_MAX:1     = 5
		EC_EXP:0     = 0
		EC_EXP:1     = 5000
		EC_TALENT 	 = 1217
		EC_AUD		 = 24
		EC_COLORS:1  = C_RED
	CASEELSE
		RETURNF 0
ENDSELECT
RETURNF 1

@ChangeEndurance(ARG,ARGS,nChange)
#FUNCTION
#DIM nChange
;global toggle
SIF !nEnduranceScaleStats
	RETURNF 0
;doesn't exist
SIF !EnduranceDB(ARGS)
	RETURNF -1
;individual toggled
SIF CharaDisableEndurance:EC_ID
	RETURNF -1
;talents
IF GROUPMATCH(EC_EXP_VAR,"PeeHold","PooHold")
	SIF TALENT:MASTER:358
		nChange *= 3
ENDIF
SETVAR @"%EC_EXP_VAR%:{ARG}:1", GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
SETVAR @"%EC_EXP_VAR%:{ARG}:0", LIMIT(GETVAR(@"%EC_EXP_VAR%:{ARG}:0") + nChange,EC_EXP:0,EC_EXP:1)
RETURNF nChange
;custom code for non-CSV exp
;Mr Pops Alot

@ShowEnduranceChange(ARG)
#DIM DYNAMIC nVal, 2
#DIM DYNAMIC nShow
#DIM DYNAMIC DIFFERENCE
FOR LOCAL:1,0,6
VARSET nVal
VARSET DIFFERENCE
CALLF EnduranceDB(TOSTR(LOCAL:1))
nVal = GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
nVal:1 = GETVAR(@"%EC_EXP_VAR%:{ARG}:1")
LOCALS:1 = %EC_NAME%경험치
IF nVal != nVal:1
	DIFFERENCE = nVal - nVal:1
	nShow ++
	PRINTFORM %LOCALS:1% \@ DIFFERENCE >= 0 ? + # \@{DIFFERENCE}(%CALLNAME:ARG%)
	IF LOCAL:1 == 5
		;NAS TRAUMA
		SIF CharaTrauma:ARG:0+1 > (EXISTVAR("NAS_VERSION") ? 5 # 3)
			CONTINUE
		IF TFLAG:TraumaMark
			LOCAL = 1
			LOCAL:2 = 1
			PRINTFORM  트라우마 마크 레벨{CharaTrauma:ARG:0} 획득: 
		ELSE
			LOCAL = EXP_DEMAND_24(0,0,0,0,(MIN(CharaTrauma:ARG:0+1,5)))
			LOCAL:2 = nVal
			PRINTFORM  트라우마 마크 Lv{MIN(CharaTrauma:ARG:0+1,5)} 획득: 
		ENDIF
		CALL PRINTTHRESHOLDBAR(LOCAL:2, LOCAL:0, 54)
	ENDIF
	PRINTL
ENDIF
NEXT
RETURN nShow
;ARG:1 is to FORCE set

@ResetTempEndurance(ARG, ARG:1 = 0)
#FUNCTION
#DIM isDisabled
#DIMS AvaliableValues = "orgasmdeny", "peehold", "poohold", "alcoholaddict", "drugaddict", "charatrauma"
;global toggle
SIF !nEnduranceScaleStats
	RETURNF 0
FOR LOCAL,0,VARSIZE("AvaliableValues")
isDisabled = 0
;individual toggle
SIF CharaDisableEndurance:ARG:(LOCAL) && !ARG:1
	isDisabled = 1
CALLF EnduranceDB(AvaliableValues:LOCAL)
IF isDisabled
	SETVAR @"%EC_EXP_VAR%:{ARG}:0", GETVAR(@"%EC_EXP_VAR%:{ARG}:1")
ELSE
	SETVAR @"%EC_EXP_VAR%:{ARG}:1", GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
ENDIF
NEXT

@CUSTOM_OPTION_40
