    EC_MAX:0     = -5
    EC_MAX:1     = 5
    EC_EXP:0     = -2000
    EC_EXP:1     = 2000
	EC_AUD		 = 22
	EC_TALENT 	 = 121
CASE "drugaddict", "4"
    EC_NAME     '= "Drug Addiction"
