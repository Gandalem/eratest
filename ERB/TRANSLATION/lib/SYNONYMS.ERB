nOutput = RAND(nRange, nRange:1)
RETURNF CONJUGATOR(( nOutput > 0 ? strAdd + "에 " # "") + strType:(nOutput) + ":" + ARGS:1, 1)

@AFTERGLOW(ARG = -1, ARGS, ARGS:1)
