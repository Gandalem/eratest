; Modular ERB: lib/SYNONYMS.ERB
;Synonyms and related generators for repeated words
;------------------------------------------------------------
;Generator for semen
;ARG reserved for future use for checking chara talent
;ARG:1 for additional description
;ARG:2 for capitalization
;------------------------------------------------------------

@SEMEN(ARG = -1,ARG:1,ARG:2)
#FUNCTIONS
LOCALS =
IF ARG:1
	SELECTCASE RAND:26
		CASE 1 TO 5
			LOCALS += "따뜻한"
		CASE 6 TO 11
			LOCALS += "뜨거운"
		CASE 12 TO 16
			LOCALS += "끈적한"
		CASE 16 TO 19
			LOCALS += "걸쭉한"
		CASEELSE
			LOCALS += @"%SPLIT_G("비릿한:냄새나는:하얀:점성 높은:탁한:씁쓸한:짭짤한::::")%"
	ENDSELECT
	;putting a space
	SIF LOCALS != ""
		LOCALS += " "
	IF ARG >= 0
		SIF TALENT:ARG:濃厚精液 && !RAND:3
			LOCALS = %SPLIT_G("믿기 힘들 만큼 :아주 :엄청나게 :비정상적으로 :::")%%SPLIT_G("농후한 :정력 넘치는 :풍부한 :걸쭉한 :점성 높은 ")%
		SIF !TALENT:ARG:非童貞 && !RAND:3
			LOCALS = %SPLIT_G("순결한 ")%
	ENDIF
ENDIF
SELECTCASE RAND:13
	CASE 0 TO 4
		LOCALS += "정액"
	CASE 5 TO 9
		LOCALS += "정액"
	CASEELSE
		LOCALS += @"%SPLIT_G("정액:씨앗:정자:진액")%"
ENDSELECT
IF !ARG:2
	RETURNF LOCALS
ELSE
	RETURNF CAPITALIZE(LOCALS)
ENDIF
;--------------------------------------------------------
;Retarded hentai moan generator
;ARGS will determine how retarded we'll go, Light, Mild or Heavy (Random too)
;shortened versions can be used: l, m, h, r
;Capitalized by default, ARG = 1 to remove it, ARG = 2 to make everything BIG, ARG = 3 - capitalize (default), ARG = 4 - random capitalization, ARG = 5 capitalize every word
;ARG:1 is to set how many time to repeat it, only same mode is supported
;Default is Light
;--------------------------------------------------------

@MOAN(ARGS = "l", ARG = 3, ARG:1 = 0, ARGS:1 = "")
#FUNCTIONS
#DIMS DYNAMIC strMode
#DIMS DYNAMIC strOut
#DIM DYNAMIC nNameCount
#DIM DYNAMIC nHeartCount
#DIM DYNAMIC nInitCount
#DIMS DYNAMIC strFlag
VARSET LOCAL
SIF SPLIT_CHECK(ARGS:1, "name")
	nNameCount = RAND(1, 4)
SIF SPLIT_CHECK(ARGS:1, "heart")
	nHeartCount = RAND(1, 4)
nInitCount = nNameCount + nHeartCount
DO
strMode '= SPLIT_G(ARGS:0)
DO
strFlag '= SPLIT_G(MATCH_SPLIT(ARGS:1, "charname_"), "_")
LOOP strFlag == "charname"
SIF SPLIT_CHECK(ARGS:1, "const")
	strFlag += ":const"
SIF SPLIT_CHECK(ARGS:1, "HPH")
	strFlag += ":HPH"
IF strMode == "rand" || strMode == "r"
	IF RAND:10 >= 4
		strMode = l
	ELSEIF RAND:10 >= 6
		strMode = m
	ELSE
		strMode = h
	ENDIF
ENDIF
SELECTCASE strMode
	CASE "light", "l", ""
		LOCALS = %SPLIT_G("응:응:흣:아앙:하:하:하:하앗:아:아:아앗:아앙:아우:히익:후아:읏:음:하아:아앙:응:아앙:햐앙:아하:오오:히익:으음:야앙:안 돼")%
	CASE "mild", "m"
		LOCALS = %SPLIT_G("으응:아우응:흐아:으으응:흐응:아앙:으음:하아아:하앗:아아앗:아앙:아하앙:으으응:음:햐앙:응아:하히이:하헤에:아히:니야앙:후아:햐앙:아응:흐냐:야아앙:으응오오")%
	CASE "heavy", "h"
		SELECTCASE RAND:13
			CASE 0
				;aunh
				LOCALS = %"아"+"아"*RAND(1,5)+"우"*RAND:3+"응"*RAND:4+"흣"*RAND(1,5)%
			CASE 1
				;oohn
				LOCALS = %"오"+"오"*RAND(1,5)+"흐"*RAND(1,4)+"응"*RAND:4%
			CASE 2
				;uuongh
				LOCALS = %"우"+"우"*RAND(1,5)+"오"*RAND:3+"응"*RAND:4+"그"*RAND:2+"흣"*RAND(1,4)%
			CASE 3
				;hnah/hnya
				LOCALS = %"흐"+"응"*RAND:5+SPLIT_G("아"*RAND(3,7)+":"+"야"*RAND(1,4)+"아"*RAND(3,7))%
			CASE 4
				;nngah
				LOCALS = %"응"+"응"*RAND(2,6)+"그"*RAND:3+"아"*RAND:3+"흣"*RAND(1,3)%
			CASE 5
				;(n) + hyah/hiyahn/hahn
				LOCALS = %SPLIT_G("응흐:흐")+SPLIT_G("이:야:")+"아"*RAND(3,7)+"흣"*RAND(1,6)+"응"*RAND:4%
			CASE 6
				;mmnh
				LOCALS = %"음"+"음"*RAND(2,6)+"응"*RAND:4+"흣"*RAND:3%
			CASE 7
				;aahn
				LOCALS = %"아"+"아"*RAND(2,5)+"흣"*RAND:4+"응"*RAND:3%
			CASE 8
				;mmph
				LOCALS = %"음"+"음"*RAND(2,6)+"프"*RAND:3+"흐"*RAND(1,5)%
			CASE 9
				;hngh(i/u)
				LOCALS = %"흐"+"응"*RAND:5+"그"*RAND(1,3)+"흣"*RAND:4+SPLIT_G("우:이")*RAND(1,6)%
			CASE 10
				;h/ah(ii/ee)
				LOCALS = %SPLIT_G("하:아")+"아"*RAND:4+"흣"*RAND(1,3)+SPLIT_G("에:이")*RAND(2,4)%
			CASE 11
				;niyahn/eyahn
				LOCALS = %SPLIT_G("니:에")+"아"*RAND(2,8)+"흣"*RAND(1,3)+"응"*RAND(1,4)%
			CASE 12
				;ahyaa/ahyiii
				LOCALS = %SPLIT_G("아햐")+SPLIT_G("아:이")*RAND(3,7)%
		ENDSELECT
	CASEELSE
		RETURNF "MOAN 함수 오류! 제보해 주세요!"
ENDSELECT
IF nNameCount || nHeartCount
	strOut += LOCALS + (--ARG:1 > 0 ? RANDLIPS_NAMEHEART_INSERT(nNameCount, nHeartCount, strFlag) + " " # "")
	LOCAL = nInitCount
ELSE
	IF SPLIT_CHECK(ARGS:1, "dot")
		LOCALS:1 '=  "... "
		LOCAL:1 = 1
	ELSEIF SPLIT_CHECK(ARGS:1, "!")
		LOCALS:1 '=  "!!! "
		LOCAL:1 = 1
	ELSEIF SPLIT_CHECK(ARGS:1, "dot!")
		LOCALS:1 '=  "...! "
		LOCAL:1 = 1
	ELSEIF SPLIT_CHECK(ARGS:1, "rand")
		IF RAND:2
			LOCALS:1 '= SPLIT_G("...:!!!:...!") + " "
			LOCAL:1 = 0 ;reset cap status
			SIF LOCAL:2 ;if non-comma was used, set cap
				LOCAL:1 = 1
			LOCAL:2 = 1 ;note that non-comma mode was used previously
		ELSE
			LOCALS:1 '= ", "
			IF LOCAL:2 ;non-comma used, set cap; otherwise lower case
				LOCAL:1 = 1
			ELSE
				LOCAL:1 = 0
			ENDIF
			LOCAL:2 = 0 ;comma was used
		ENDIF
	ELSE
		LOCALS:1 '= ", "
	ENDIF
	strOut += (nInitCount || LOCAL:1 ? LOCALS # TOLOWER(LOCALS)) + (--ARG:1 > 0 ? LOCALS:1 # "")
	IF nInitCount
		LOCAL = nInitCount
		nInitCount = 0
	ENDIF
ENDIF
LOOP ARG:1 > 0
SIF (LOCAL || LOCAL:1) && ARG == 1 ;ignore low capitalization rule
	RETURNF UNCAPITALIZE(strOut)
RETURNF CAP_PROCESS(strOut, ARG)
;--------------------------------------------------------
;Generator for groans of pain
;--------------------------------------------------------

@GROAN(ARGS, ARG = 3, ARG:1 = 0)
#FUNCTIONS
#DIMS CONST strNgh = "으윽:아악:크윽:크르륵"
#DIMS CONST strGuh = "구윽:크윽:끄:카악:크아:우욱"
#DIMS CONST strAck = "악:아윽:오오:우웁:으윽"
#DIMS DYNAMIC strMode
#DIMS DYNAMIC strOut
DO
strMode '= SPLIT_G(ARGS:0)
SELECTCASE TOLOWER(strMode)
	CASE "ngh"
		LOCALS '= SPLIT_G(strNgh)
	CASE "guh"
		LOCALS '= SPLIT_G(strGuh)
	CASE "ack"
		LOCALS '= SPLIT_G(strAck)
	CASEELSE
		LOCALS '= SPLIT_G(strNgh + ":" + strGuh + ":" + strAck)
ENDSELECT
strOut += TOLOWER(LOCALS) + (--ARG:1 > 0 ? ", " # "")
LOOP ARG:1 > 0
RETURNF CAP_PROCESS(strOut, ARG)

@KISS(ARGS)
#FUNCTIONS
#DIMS CONST strKiss = "쪽:쪼옥:음마:츄:쭈욱"
