SIF ARG == -1
	ARG = TARGET
SIF ARG == MASTER && GROUPMATCH(ARGS:1, "", "s") ;adjust for YouMode
	ARGS:1 '= (THIRD_PERSON ? "s" # "")
SELECTCASE SPLIT_SINGLE(TOLOWER(ARGS:0))
	CASE "nofirst"
		nRange:0 = 1
