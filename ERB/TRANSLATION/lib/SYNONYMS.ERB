		nRange:1 = VARSIZE("strType")
ENDSELECT
strType:0 = 본능에 따르다
strType:1 = %SPLIT_G("빠져들다:즐기다:탐닉하다:좇다")%
strType:2 = %SPLIT_G("깊이 빠져들다:도취하다:헤어나오지 못하다:몸을 맡기다")%
strType:3 = %SPLIT_G("굴복하다:내맡기다:내어주다:빠져들다")%
