@CAN_COM9_TR(ARG)
SKIPDISP ARG
SIF TEQUIP:ビデオ撮影
	PRINT 공개 
SIF TEQUIP:シャワー
	PRINT 샤워 
IF TEQUIP:バイブ && TEQUIP:アナルバイブ
	PRINT 더블 바이브레이터 
ELSEIF TEQUIP:バイブ
	PRINT 진동기 
ELSEIF TEQUIP:アナルバイブ
	PRINT 애널 바이브레이터 
ENDIF
PRINTL 자위
;難易度上昇
;公開で+10、バイブで+5、アナルバイブで+5、シャワーで＋3
V = 33
SIF TEQUIP:ビデオ撮影
	V += 10
SIF TEQUIP:シャワー
	V += 3
SIF TEQUIP:バイブ
	V += 5
SIF TEQUIP:アナルバイブ
	V += 5
CALL QOL_COM_ORDER_STANDARD_CHECKS(V, QOL_COM_ORDER_EXPOSURE_FULL, TARGET)
LOCAL = RESULT
SKIPDISP 0
RETURN LOCAL

