@CAN_COM192_TR(ARG)
SKIPDISP ARG
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
IF FLAG:70 == 1 || CFLAG:イタズラ
ELSE
	;has unique requirements
	CALL QOL_COM_ORDER_STANDARD(TARGET)
	SIF ABL:TARGET:欲望
		CALL QOL_COM_ORDER_ELEMENT_ABL(TARGET, "欲望", 1)
	SIF ABL:TARGET:Ｖ感覚
		CALL QOL_COM_ORDER_ELEMENT_ABL(TARGET, "Ｖ感覚", 2)
	SIF ABL:TARGET:精液中毒
		CALL QOL_COM_ORDER_ELEMENT_ABL(TARGET, "精液中毒", 3)
	SIF MARK:TARGET:快楽刻印
		CALL QOL_COM_ORDER_ELEMENT_MARK(TARGET, "快楽刻印", 1)
	SIF GETPALAMLV(PALAM:TARGET:欲情,5)
		CALL QOL_COM_ORDER_ELEMENT_PALAM(TARGET, "欲情", 1, 5)
	SIF TALENT:TARGET:羞恥心 > 0
		CALL QOL_COM_ORDER_ELEMENT_TALENT(TARGET, "羞恥心", -1)
	SIF OTOKOGIRAI(TARGET)
		CALL QOL_COM_ORDER_ELEMENT_TALENT(TARGET, "性別嗜好", -12)
	SIF TALENT:TARGET:恋慕 && ASSIPLAY == 0
		CALL QOL_COM_ORDER_ELEMENT_TALENT(TARGET, "恋慕", 5)
	SIF TALENT:TARGET:愛欲 && ASSIPLAY == 0
		CALL QOL_COM_ORDER_ELEMENT_TALENT(TARGET, "愛欲", 5)
	IF CFLAG:TARGET:生解禁 == 2
		CALL QOL_COM_ORDER_ELEMENT(TARGET, "Babymaking Agreement", 5)
	ELSEIF SHIRAHU(TARGET)
		CALL QOL_COM_ORDER_ELEMENT(TARGET, "No Babymaking Agreement", -200)
	ENDIF
	SIF (TALENT:PLAYER:2 & 3) == 3
		CALL QOL_COM_ORDER_ELEMENT_TALENT(TARGET, "性別", 4, PLAYER)
	CALL QOL_COM_ORDER_CHECK(TARGET, 100)
	LOCAL = RESULT
	SKIPDISP 0
	RETURN LOCAL
	RETURN 1
ENDIF

