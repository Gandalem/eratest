@Com_Size_Check(ARGS, ARG)
#FUNCTION
;custom code: Replaced by Add_Size_Check
SIF LS_RESTRICTION("Size check") ;Custom code, restrict size restrictions during Lunatic Survival.
	RETURNF 0
RETURNF Add_Size_Check(ARGS, ARG, MASTER)
SIF ARG == -1
	ARG = TARGET
;for normal actions
SELECTCASE ARGS
	CASE "strict" ;at this stage, need either exp or forbidden knowledge
		RETURNF 挿入不可(ARG) == 1 && EXP:ARG:Ｖ経験 < 50 && !(TALENT:PLAYER:禁断の知識 || TALENT:ARG:禁断の知識)
	CASE "strictA"
		RETURNF 挿入不可(ARG) == 1 && EXP:ARG:Ａ経験 < 50 && !(TALENT:PLAYER:禁断の知識 || TALENT:ARG:禁断の知識)
	CASE "reg" ;need both exp and forbidden knowledge if difference is too big
		RETURNF 挿入不可(ARG) == 2 && ( !(TALENT:PLAYER:禁断の知識 || TALENT:ARG:禁断の知識) || EXP:ARG:Ｖ経験 < 50)
	CASE "regA"
		RETURNF 挿入不可(ARG) == 2 && ( !(TALENT:PLAYER:禁断の知識 || TALENT:ARG:禁断の知識) || EXP:ARG:Ａ経験 < 50)
	CASEELSE
		;for counter
		RETURNF 挿入不可(ARG) >= 2 && ( !(TALENT:PLAYER:禁断の知識 || TALENT:ARG:禁断の知識) || ( ARGS == "anal" ? EXP:ARG:Ａ経験 # EXP:ARG:Ｖ経験) < 50)
ENDSELECT

