@Com_Cook_Tsp_Check
#DIM TSP_TIME
SIF !FLAG:70
	RETURN 0
IF DISH_TIME <= 0
	IF DISH_TYPE == "主食"
		TSP_TIME = 400
	ELSE
		TSP_TIME = 200
	ENDIF
ELSE
	TSP_TIME = DISH_TIME*10
ENDIF
IF BASE:MASTER:TSP < TSP_TIME
	PRINTFORMW 요리하기에 충분한 TSP가 없다 ({TSP_TIME} 필요하다).
	RETURN -1
ELSE
	BASE:MASTER:TSP -= TSP_TIME
	RETURN 1
ENDIF

